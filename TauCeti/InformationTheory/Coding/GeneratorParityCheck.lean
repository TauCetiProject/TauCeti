module

public import TauCeti.InformationTheory.Coding.EuclideanDual
public import TauCeti.InformationTheory.Coding.RowOperations

/-!
# Generator matrices and parity-check matrices

The rows of a matrix generate a linear code, while the same matrix checks the Euclidean dual of
that code. This identifies the kernel presentation by a parity-check matrix with the orthogonal
complement of its row space and makes conversion between generator and parity-check matrices
literal: no transpose or choice of coordinates is needed.

For every finite-length code, a basis of its Euclidean dual therefore gives a full-row-rank
parity-check matrix. The number of its rows is the codimension of the original code.

The conventions follow Huffman and Pless, *Fundamentals of Error-Correcting Codes*,
Sections 1.2--1.4.

## Main results

* `Matrix.checkedBy_eq_euclideanDual_generatedBy` identifies a matrix kernel with the orthogonal
  complement of its row space.
* `LinearCode.isGeneratorMatrix_iff_isParityCheckMatrix_euclideanDual` converts generator matrices
  into parity-check matrices for the dual code.
* `LinearCode.isParityCheckMatrix_of_basis_euclideanDual`: a basis of the dual code gives a
  parity-check matrix, and `LinearCode.exists_isParityCheckMatrix` uses it to construct one with
  linearly independent rows.
-/

public section

noncomputable section

open Matrix

namespace TauCeti

variable {F ι ρ : Type*} [Field F] [Fintype ι]

/-- The code checked by a matrix is the Euclidean dual of the code generated by its rows. -/
@[simp]
theorem _root_.Matrix.checkedBy_eq_euclideanDual_generatedBy [Fintype ρ]
    (H : Matrix ρ ι F) :
    H.checkedBy = H.generatedBy.euclideanDual := by
  ext x
  rw [Matrix.mem_checkedBy_iff, Matrix.generatedBy_eq_span_rows,
    Submodule.mem_euclideanDual_span]
  simp only [Set.mem_range, forall_exists_index, forall_apply_eq_imp_iff]
  simp only [funext_iff, Matrix.mulVec_apply, Pi.zero_apply]

/-- Two matrices check the same code exactly when their rows span the same code. -/
theorem _root_.Matrix.checkedBy_eq_iff_generatedBy_eq {σ : Type*} [Fintype ρ] [Fintype σ]
    (H : Matrix ρ ι F) (H' : Matrix σ ι F) :
    H.checkedBy = H'.checkedBy ↔ H.generatedBy = H'.generatedBy := by
  rw [Matrix.checkedBy_eq_euclideanDual_generatedBy,
    Matrix.checkedBy_eq_euclideanDual_generatedBy]
  exact Submodule.euclideanDual_injective.eq_iff

namespace LinearCode

/-- A matrix generates `C` exactly when it checks the Euclidean dual of `C`. -/
theorem isGeneratorMatrix_iff_isParityCheckMatrix_euclideanDual
    {C : LinearCode F ι} {G : Matrix ρ ι F} [Fintype ρ] :
    C.IsGeneratorMatrix G ↔ IsParityCheckMatrix C.euclideanDual G := by
  rw [isGeneratorMatrix_def, isParityCheckMatrix_def,
    Matrix.checkedBy_eq_euclideanDual_generatedBy]
  exact (Submodule.euclideanDual_injective (K := F) (ι := ι)).eq_iff.symm

/-- A matrix checks `C` exactly when it generates the Euclidean dual of `C`. -/
theorem isParityCheckMatrix_iff_isGeneratorMatrix_euclideanDual
    {C : LinearCode F ι} {H : Matrix ρ ι F} [Fintype ρ] :
    C.IsParityCheckMatrix H ↔ IsGeneratorMatrix C.euclideanDual H := by
  simpa only [Submodule.euclideanDual_euclideanDual] using
    (isGeneratorMatrix_iff_isParityCheckMatrix_euclideanDual (C := C.euclideanDual) (G := H)).symm

/-- The matrix whose rows are the vectors of a basis of the Euclidean dual of `C` is a
parity-check matrix for `C`. -/
theorem isParityCheckMatrix_of_basis_euclideanDual {C : LinearCode F ι}
    (b : Module.Basis ρ F C.euclideanDual) :
    C.IsParityCheckMatrix (Matrix.of fun r ↦ (b r : ι → F)) :=
  have := Module.Finite.finite_basis b
  let _ := Fintype.ofFinite ρ
  isParityCheckMatrix_iff_isGeneratorMatrix_euclideanDual.mpr (isGeneratorMatrix_of_basis b)

/-- Every finite-length linear code has a parity-check matrix whose rows form a basis of the
Euclidean dual. Its row type has cardinality equal to the codimension of the code. -/
theorem exists_isParityCheckMatrix (C : LinearCode F ι) :
    ∃ H : Matrix (Fin (Fintype.card ι - Module.finrank F C)) ι F,
      C.IsParityCheckMatrix H ∧ LinearIndependent F H.row := by
  have hdim : Module.finrank F C.euclideanDual = Fintype.card ι - Module.finrank F C := by
    have := Submodule.finrank_add_finrank_euclideanDual C
    omega
  let b := Module.finBasisOfFinrankEq F C.euclideanDual hdim
  exact ⟨_, isParityCheckMatrix_of_basis_euclideanDual b, linearIndependent_row_of_basis b⟩

end LinearCode

end TauCeti
