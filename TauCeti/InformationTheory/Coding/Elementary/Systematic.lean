module

public import TauCeti.InformationTheory.Coding.Matrix

/-!
# A systematic two-coordinate code under coordinate exchange

The one-row generator `[1, a]` gives the code of pairs `(t, at)`. Its systematic
check matrix `[-a, 1]` cuts out the same code. Exchanging the two coordinates
changes these matrices to `[a, 1]` and `[1, -a]` while preserving the
generator/check identity. This concrete calculation exercises the matrix
presentation API under a nonidentity coordinate reindexing.

The standard systematic-matrix convention follows Huffman and Pless,
*Fundamentals of Error-Correcting Codes*, Sections 1.2–1.4.
-/

public section

namespace TauCeti
namespace TwoCoordinateCode

open Matrix

variable {F : Type*} [Field F]

/-- The systematic generator `[1, a]` on two labelled coordinates. -/
def generator (a : F) : Matrix (Fin 1) (Fin 1 ⊕ Fin 1) F :=
  fromCols (1 : Matrix (Fin 1) (Fin 1) F) (fun _ _ ↦ a)

/-- The columns of the two-coordinate generator. -/
theorem generator_def (a : F) : generator a =
    fromCols (1 : Matrix (Fin 1) (Fin 1) F) (fun _ _ ↦ a) := by
  unfold generator
  rfl

/-- The parity-check matrix `[-a, 1]` for the code generated by `[1, a]`. -/
def check (a : F) : Matrix (Fin 1) (Fin 1 ⊕ Fin 1) F :=
  fromCols (-(fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F)ᵀ)
    (1 : Matrix (Fin 1) (Fin 1) F)

/-- The columns of the two-coordinate parity check. -/
theorem check_def (a : F) : check a =
    fromCols (-(fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F)ᵀ)
      (1 : Matrix (Fin 1) (Fin 1) F) := by
  unfold check
  rfl

/-- The row space of the systematic generator `[1, a]`. -/
def code (a : F) : LinearCode F (Fin 1 ⊕ Fin 1) := (generator a).generatedBy

/-- The code is the row space of its displayed generator. -/
theorem code_def (a : F) : code a = (generator a).generatedBy := by
  unfold code
  rfl

/-- The displayed parity-check matrix cuts out exactly the generated code. -/
@[simp]
theorem checkedBy_check (a : F) : (check a).checkedBy = code a := by
  simpa only [generator, check, code] using
    (Matrix.generatedBy_one_fromCols_eq_checkedBy_fromCols_neg_transpose_one
      (fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F)).symm

/-- A pair belongs to the code precisely when its second entry is `a` times its first. -/
@[simp]
theorem mem_code_iff (a : F) (x : Fin 1 ⊕ Fin 1 → F) :
    x ∈ code a ↔ x (Sum.inr 0) = a * x (Sum.inl 0) := by
  rw [← checkedBy_check, Matrix.mem_checkedBy_iff]
  have hentry : (check a *ᵥ x) 0 = -(a * x (Sum.inl 0)) + x (Sum.inr 0) := by
    simp [check, Matrix.mulVec, dotProduct, Matrix.transpose]
  constructor
  · intro h
    have hzero := congrFun h 0
    rw [hentry, Pi.zero_apply, neg_add_eq_zero] at hzero
    exact hzero.symm
  · intro h
    have hz : (check a *ᵥ x) 0 = 0 := by
      rw [hentry, neg_add_eq_zero]
      exact h.symm
    funext i
    fin_cases i
    simpa using hz

/-- Coordinate exchange turns `[1, a]` into `[a, 1]`. -/
theorem generator_swap (a : F) :
    (generator a).submatrix id (Equiv.sumComm (Fin 1) (Fin 1)) =
      fromCols (fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F)
        (1 : Matrix (Fin 1) (Fin 1) F) := by
  ext r (i | i) <;>
    simp only [generator_def, Matrix.submatrix_apply, id_eq, Equiv.sumComm_apply,
      Sum.swap_inl, Sum.swap_inr]
  · exact (Matrix.fromCols_apply_inr (1 : Matrix (Fin 1) (Fin 1) F)
      (fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F) r i).trans
      (Matrix.fromCols_apply_inl (fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F)
        (1 : Matrix (Fin 1) (Fin 1) F) r i).symm
  · exact (Matrix.fromCols_apply_inl (1 : Matrix (Fin 1) (Fin 1) F)
      (fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F) r i).trans
      (Matrix.fromCols_apply_inr (fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F)
        (1 : Matrix (Fin 1) (Fin 1) F) r i).symm

/-- Coordinate exchange turns `[-a, 1]` into `[1, -a]`. -/
theorem check_swap (a : F) :
    (check a).submatrix id (Equiv.sumComm (Fin 1) (Fin 1)) =
      fromCols (1 : Matrix (Fin 1) (Fin 1) F)
        (-(fun _ _ ↦ a : Matrix (Fin 1) (Fin 1) F)ᵀ) := by
  ext r (i | i) <;> simp [check_def, Matrix.submatrix_apply, Equiv.sumComm_apply,
    Sum.swap]

/-- Exchanging the coordinates reverses which entry is the information symbol. -/
theorem mem_generatedBy_swap_iff (a : F) (x : Fin 1 ⊕ Fin 1 → F) :
    x ∈ ((generator a).submatrix id (Equiv.sumComm (Fin 1) (Fin 1))).generatedBy ↔
      x (Sum.inl 0) = a * x (Sum.inr 0) := by
  rw [Matrix.generatedBy_submatrix_equiv, Submodule.mem_map_equiv]
  simpa [code_def, LinearEquiv.funCongrLeft_symm, LinearEquiv.funCongrLeft_apply,
    LinearMap.funLeft_apply, Equiv.sumComm_apply, Sum.swap] using
    (mem_code_iff a ((LinearEquiv.funCongrLeft F F
      (Equiv.sumComm (Fin 1) (Fin 1))).symm x))

/-- The code is fixed by exchanging its coordinates exactly when `a² = 1`. -/
theorem code_eq_swap_iff (a : F) :
    code a = ((generator a).submatrix id (Equiv.sumComm (Fin 1) (Fin 1))).generatedBy ↔
      a * a = 1 := by
  constructor
  · intro h
    let x : Fin 1 ⊕ Fin 1 → F := fun i ↦ match i with
      | Sum.inl _ => 1
      | Sum.inr _ => a
    have hx : x ∈ code a := by simp [x]
    have hx' : x ∈
        ((generator a).submatrix id (Equiv.sumComm (Fin 1) (Fin 1))).generatedBy :=
      h ▸ hx
    simpa [x] using ((mem_generatedBy_swap_iff a x).mp hx').symm
  · intro h
    ext x
    simp only [mem_code_iff, mem_generatedBy_swap_iff]
    constructor
    · intro hx
      calc
        x (Sum.inl 0) = (a * a) * x (Sum.inl 0) := by rw [h]; simp
        _ = a * x (Sum.inr 0) := by rw [mul_assoc, ← hx]
    · intro hx
      calc
        x (Sum.inr 0) = (a * a) * x (Sum.inr 0) := by rw [h]; simp
        _ = a * x (Sum.inl 0) := by rw [mul_assoc, ← hx]

/-- At `a = 0`, the exchange really changes the code: it exchanges the two coordinate axes. -/
theorem code_zero_ne_swap :
    code (0 : F) ≠
      ((generator (0 : F)).submatrix id (Equiv.sumComm (Fin 1) (Fin 1))).generatedBy := by
  intro h
  have h' := (code_eq_swap_iff (0 : F)).mp h
  simp at h'

end TwoCoordinateCode
end TauCeti
