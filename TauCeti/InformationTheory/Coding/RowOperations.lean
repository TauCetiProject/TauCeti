module

public import TauCeti.Data.Matrix.DeleteRow
public import TauCeti.InformationTheory.Coding.Matrix

/-!
# Row operations on generator matrices

Left multiplication changes the rows of a generator matrix by linear combinations and therefore
cannot enlarge its generated code. If the left factor is invertible, this operation preserves the
code. This file records that fact through the exact image formula for the generated code, so it can
also be used for nonsquare coefficient matrices whose rows still span the whole coefficient space.

The second part treats deletion of a row. The matrix `Matrix.deleteRow G r` retains all rows of `G`
except row `r`; it generates the same code precisely when the deleted row is generated by those
remaining rows. In particular, every linearly dependent finite family of rows admits such a
deletion. Together these results justify row reduction of generator matrices without changing the
linear code they present.

## Main results

* `Matrix.generatedBy_mul_eq_map` describes the code generated after left multiplication.
* `Matrix.generatedBy_mul_eq_of_isUnit` proves invariance under invertible row operations.
* `Matrix.generatedBy_deleteRow_eq_iff` characterizes when deleting one row preserves the code.
* `Matrix.exists_deleteRow_generatedBy_eq_of_not_linearIndependent` finds a redundant row in a
  linearly dependent generator family.
-/

public section

noncomputable section

open Set

namespace TauCeti

variable {F ι ρ σ : Type*} [Field F]

section LeftMultiplication

variable [Fintype ρ] [Fintype σ]

/-- Left multiplication maps the row code through right multiplication by the original matrix. -/
theorem _root_.Matrix.generatedBy_mul_eq_map (A : Matrix σ ρ F) (G : Matrix ρ ι F) :
    (A * G).generatedBy = Submodule.map G.vecMulLinear A.generatedBy := by
  rw [Matrix.generatedBy_def, Matrix.generatedBy_def, ← LinearMap.range_comp]
  apply congrArg LinearMap.range
  apply LinearMap.ext
  intro a
  exact (Matrix.vecMul_vecMul a A G).symm

/-- Taking linear combinations of the rows of `G` cannot enlarge its generated code. -/
theorem _root_.Matrix.generatedBy_mul_le (A : Matrix σ ρ F) (G : Matrix ρ ι F) :
    (A * G).generatedBy ≤ G.generatedBy := by
  rw [Matrix.generatedBy_mul_eq_map, Matrix.generatedBy_def G]
  exact LinearMap.map_le_range (f := G.vecMulLinear) (p := A.generatedBy)

/-- A left factor whose rows span the whole coefficient space preserves the generated code. -/
theorem _root_.Matrix.generatedBy_mul_eq_of_generatedBy_eq_top (A : Matrix σ ρ F)
    (G : Matrix ρ ι F) (hA : A.generatedBy = ⊤) :
    (A * G).generatedBy = G.generatedBy := by
  rw [Matrix.generatedBy_mul_eq_map, hA, Submodule.map_top, Matrix.generatedBy_def]

/-- A surjective row operation preserves the generated code. -/
theorem _root_.Matrix.generatedBy_mul_eq_of_surjective (A : Matrix σ ρ F)
    (G : Matrix ρ ι F) (hA : Function.Surjective A.vecMul) :
    (A * G).generatedBy = G.generatedBy := by
  apply Matrix.generatedBy_mul_eq_of_generatedBy_eq_top
  rw [Matrix.generatedBy_def A]
  exact (LinearMap.range_eq_top (f := A.vecMulLinear)).mpr hA

end LeftMultiplication

section InvertibleLeftMultiplication

variable [Fintype ρ] [DecidableEq ρ]

/-- Invertible row operations preserve the code generated by a matrix. -/
theorem _root_.Matrix.generatedBy_mul_eq_of_isUnit (A : Matrix ρ ρ F) (G : Matrix ρ ι F)
    (hA : IsUnit A) :
    (A * G).generatedBy = G.generatedBy :=
  Matrix.generatedBy_mul_eq_of_surjective A G
    (Matrix.vecMul_surjective_iff_isUnit.mpr hA)

/-- An invertible row operation preserves the property of being a generator matrix for `C`. -/
theorem LinearCode.isGeneratorMatrix_mul_iff (C : LinearCode F ι) (A : Matrix ρ ρ F)
    (G : Matrix ρ ι F) (hA : IsUnit A) :
    C.IsGeneratorMatrix (A * G) ↔ C.IsGeneratorMatrix G := by
  rw [LinearCode.isGeneratorMatrix_def, LinearCode.isGeneratorMatrix_def,
    Matrix.generatedBy_mul_eq_of_isUnit A G hA]

/-- Applying an invertible row operation to a generator matrix gives another generator matrix. -/
theorem LinearCode.IsGeneratorMatrix.mul_left {C : LinearCode F ι} {G : Matrix ρ ι F}
    (hG : C.IsGeneratorMatrix G) (A : Matrix ρ ρ F) (hA : IsUnit A) :
    C.IsGeneratorMatrix (A * G) :=
  (LinearCode.isGeneratorMatrix_mul_iff C A G hA).mpr hG

end InvertibleLeftMultiplication

section ReindexRows

variable [Fintype ρ] [Fintype σ]

/-- Restricting or repeating rows along a map cannot enlarge the generated code. -/
theorem _root_.Matrix.generatedBy_submatrix_rows_le (G : Matrix ρ ι F) (f : σ → ρ) :
    (G.submatrix f id).generatedBy ≤ G.generatedBy := by
  rw [Matrix.generatedBy_le_iff]
  intro s
  exact G.row_mem_generatedBy (f s)

/-- Rows selected along `f` generate the original code exactly when they generate every original
row. -/
theorem _root_.Matrix.generatedBy_submatrix_rows_eq_iff (G : Matrix ρ ι F) (f : σ → ρ) :
    (G.submatrix f id).generatedBy = G.generatedBy ↔
      ∀ r, G.row r ∈ (G.submatrix f id).generatedBy := by
  constructor
  · intro h r
    rw [h]
    exact G.row_mem_generatedBy r
  · intro h
    exact le_antisymm (G.generatedBy_submatrix_rows_le f)
      (Matrix.generatedBy_le_iff.mpr h)

/-- Selecting rows along a surjective map, possibly with repetitions, preserves the generated
code. In particular, this applies to reindexing the rows along an equivalence. -/
theorem _root_.Matrix.generatedBy_submatrix_rows_eq_of_surjective (G : Matrix ρ ι F) (f : σ → ρ)
    (hf : Function.Surjective f) :
    (G.submatrix f id).generatedBy = G.generatedBy := by
  rw [Matrix.generatedBy_submatrix_rows_eq_iff]
  intro r
  obtain ⟨s, rfl⟩ := hf r
  exact (G.submatrix f id).row_mem_generatedBy s

end ReindexRows

section DeleteRow

variable [DecidableEq ρ] [Fintype ρ]

/-- Deleting a row cannot enlarge the generated code. -/
theorem _root_.Matrix.generatedBy_deleteRow_le (G : Matrix ρ ι F) (r : ρ) :
    (G.deleteRow r).generatedBy ≤ G.generatedBy := by
  have h : G.deleteRow r = G.submatrix Subtype.val id := by
    ext
    simp
  rw [h]
  exact G.generatedBy_submatrix_rows_le Subtype.val

/-- Deleting row `r` preserves the generated code exactly when that row is generated by the
remaining rows. -/
theorem _root_.Matrix.generatedBy_deleteRow_eq_iff (G : Matrix ρ ι F) (r : ρ) :
    (G.deleteRow r).generatedBy = G.generatedBy ↔
      G.row r ∈ (G.deleteRow r).generatedBy := by
  constructor
  · intro h
    rw [h]
    exact G.row_mem_generatedBy r
  · intro hr
    apply le_antisymm (G.generatedBy_deleteRow_le r)
    rw [Matrix.generatedBy_le_iff]
    intro s
    by_cases hsr : s = r
    · simpa [hsr] using hr
    · have h := (G.deleteRow r).row_mem_generatedBy ⟨s, hsr⟩
      simpa using h

/-- A row generated by all the other rows can be deleted without changing the generated code. -/
theorem _root_.Matrix.generatedBy_deleteRow_eq_of_row_mem (G : Matrix ρ ι F) (r : ρ)
    (hr : G.row r ∈ (G.deleteRow r).generatedBy) :
    (G.deleteRow r).generatedBy = G.generatedBy :=
  (G.generatedBy_deleteRow_eq_iff r).mpr hr

/-- Deleting a redundant row from a generator matrix leaves a generator matrix for the same code. -/
theorem LinearCode.IsGeneratorMatrix.deleteRow {C : LinearCode F ι} {G : Matrix ρ ι F}
    (hG : C.IsGeneratorMatrix G) (r : ρ)
    (hr : G.row r ∈ (G.deleteRow r).generatedBy) :
    C.IsGeneratorMatrix (G.deleteRow r) := by
  rw [LinearCode.isGeneratorMatrix_def, G.generatedBy_deleteRow_eq_of_row_mem r hr]
  exact (LinearCode.isGeneratorMatrix_def C G).mp hG

/-- A linearly dependent finite row family contains a row that can be deleted without changing
the generated code. -/
theorem _root_.Matrix.exists_deleteRow_generatedBy_eq_of_not_linearIndependent
    (G : Matrix ρ ι F) (hG : ¬LinearIndependent F G.row) :
    ∃ r, (G.deleteRow r).generatedBy = G.generatedBy := by
  rw [linearIndependent_iff_notMem_span] at hG
  push Not at hG
  obtain ⟨r, hr⟩ := hG
  refine ⟨r, G.generatedBy_deleteRow_eq_of_row_mem r ?_⟩
  rw [Matrix.generatedBy_eq_span_rows]
  refine Submodule.span_mono ?_ hr
  intro x hx
  obtain ⟨s, hs, rfl⟩ := hx
  have hsr : s ≠ r := by simpa using hs
  exact ⟨⟨s, hsr⟩, by simp⟩

end DeleteRow

end TauCeti
