module

public import Mathlib.Data.Matrix.ColumnRowPartitioned
public import Mathlib.LinearAlgebra.BilinearForm.Orthogonal
public import Mathlib.LinearAlgebra.Matrix.Rank

/-!
# Generator and parity-check matrices of linear codes

A linear code on a finite coordinate type `ι` over `R` is a submodule of `ι → R`. This file
develops the two matrix presentations of such a code.

* A matrix `G : Matrix ρ ι R` *generates* its row space `G.generatorCode`, the range of
  `G.vecMulLinear`; the rows of `G` are the images of the message vectors `a ↦ a ᵥ* G`.
* A matrix `H : Matrix σ ι R` *checks* the code `H.parityCheckCode`, the kernel of
  `H.mulVecLin`; a word `x` lies in it exactly when its syndrome `H *ᵥ x` vanishes.

Row indices carry no coordinate meaning: invertible row operations leave both codes unchanged,
surjective row reindexings leave the generated code unchanged, and the checked code depends only
on the row space. A coordinate equivalence `e : ι' ≃ ι` transports both codes along
`LinearEquiv.funCongrLeft`. The parity-check code of `H` is the orthogonal of the
generator code of `H` for the standard dot product, so a generator matrix of `C` is a
parity-check matrix of the Euclidean dual of `C`.

Over a field `K` the matrix rank computes the dimension of both codes, every code has a generator
matrix with `finrank K C` linearly independent rows and a parity-check matrix with
`Fintype.card ι - finrank K C` linearly independent rows, and dependent rows of a generator matrix
may be deleted. Over any commutative ring the systematic matrices `[I | A]` and `[-Aᵀ | I]`
present the same code, one as a generator matrix and the other as a parity-check matrix, also
after the coordinates are arranged by an equivalence `ι ≃ ρ ⊕ τ` singling out the information
coordinates `ρ`.

## Main declarations

* `Matrix.generatorCode`, `Matrix.parityCheckCode`: the codes generated and checked by a matrix.
* `Matrix.IsGeneratorMatrix`, `Matrix.IsParityCheckMatrix`: a matrix presents a given code.
* `Matrix.parityCheckCode_eq_orthogonal_generatorCode`: checking by `H` is orthogonality to the
  rows of `H`.
* `Matrix.rank_eq_finrank_generatorCode`, `Matrix.rank_add_finrank_parityCheckCode`: the rank
  formulae for the dimension of the two codes.
* `Submodule.exists_isGeneratorMatrix`, `Submodule.exists_isParityCheckMatrix`: full-rank
  presentations exist.
* `Matrix.IsGeneratorMatrix.card_eq_finrank`, `Matrix.IsParityCheckMatrix.card_add_finrank`:
  full-rank generator and parity-check matrices have `k` and `n - k` rows.
* `Matrix.generatorCode_fromCols_one`: `[I | A]` generates the code checked by `[-Aᵀ | I]`.
* `Matrix.exists_linearIndependent_generatorCode_submatrix`: deleting dependent rows.

## References

* W. C. Huffman and V. Pless, *Fundamentals of Error-Correcting Codes*, Cambridge University
  Press, 2003, §§1.2–1.4 (generator and parity-check matrices, systematic form, syndromes).
-/

public section

open LinearMap (BilinForm)
open Module Submodule

namespace Matrix

variable {R K : Type*} {ρ ρ' σ τ ι ι' : Type*}

section Semiring

variable [Semiring R] [Fintype ρ]

/-- The linear code generated by `G`: the row space of `G`, as the range of `G.vecMulLinear`. -/
def generatorCode (G : Matrix ρ ι R) : Submodule R (ι → R) :=
  LinearMap.range G.vecMulLinear

/-- `G` is a generator matrix of the code `C` when its row space is `C`. -/
def IsGeneratorMatrix (G : Matrix ρ ι R) (C : Submodule R (ι → R)) : Prop :=
  G.generatorCode = C

theorem isGeneratorMatrix_iff {G : Matrix ρ ι R} {C : Submodule R (ι → R)} :
    G.IsGeneratorMatrix C ↔ G.generatorCode = C :=
  Iff.rfl

theorem isGeneratorMatrix_generatorCode (G : Matrix ρ ι R) :
    G.IsGeneratorMatrix G.generatorCode :=
  Eq.refl _

theorem generatorCode_def (G : Matrix ρ ι R) :
    G.generatorCode = LinearMap.range G.vecMulLinear :=
  (rfl)

@[simp]
theorem mem_generatorCode {G : Matrix ρ ι R} {x : ι → R} :
    x ∈ G.generatorCode ↔ ∃ a : ρ → R, a ᵥ* G = x :=
  Iff.rfl

theorem vecMul_mem_generatorCode (G : Matrix ρ ι R) (a : ρ → R) : a ᵥ* G ∈ G.generatorCode :=
  mem_generatorCode.2 ⟨a, rfl⟩

/-- The code generated by `G` is the span of the rows of `G`. -/
theorem generatorCode_eq_span_row (G : Matrix ρ ι R) :
    G.generatorCode = span R (Set.range G.row) :=
  range_vecMulLinear G

theorem row_mem_generatorCode (G : Matrix ρ ι R) (i : ρ) : G.row i ∈ G.generatorCode := by
  rw [generatorCode_eq_span_row]
  exact subset_span ⟨i, rfl⟩

theorem generatorCode_le_iff {G : Matrix ρ ι R} {C : Submodule R (ι → R)} :
    G.generatorCode ≤ C ↔ ∀ i, G.row i ∈ C := by
  simp only [generatorCode_eq_span_row, span_le, Set.range_subset_iff, SetLike.mem_coe]

/-- Rows of `P * G` are combinations of rows of `G`. -/
theorem generatorCode_mul_le [Fintype ρ'] (P : Matrix ρ' ρ R) (G : Matrix ρ ι R) :
    (P * G).generatorCode ≤ G.generatorCode := by
  intro x hx
  obtain ⟨a, rfl⟩ := mem_generatorCode.1 hx
  exact mem_generatorCode.2 ⟨a ᵥ* P, vecMul_vecMul a P G⟩

/-- Invertible row operations do not change the generated code. -/
theorem generatorCode_mul_of_isUnit [DecidableEq ρ] {P : Matrix ρ ρ R} (hP : IsUnit P)
    (G : Matrix ρ ι R) : (P * G).generatorCode = G.generatorCode := by
  refine (generatorCode_mul_le P G).antisymm ?_
  obtain ⟨u, rfl⟩ := hP
  calc G.generatorCode = ((↑u⁻¹ : Matrix ρ ρ R) * ((u : Matrix ρ ρ R) * G)).generatorCode := by
        rw [← Matrix.mul_assoc, Units.inv_mul, Matrix.one_mul]
    _ ≤ ((u : Matrix ρ ρ R) * G).generatorCode := generatorCode_mul_le _ _

/-- Reindexing the rows along a surjection does not change the generated code. -/
theorem generatorCode_submatrix_of_surjective [Fintype ρ'] (G : Matrix ρ ι R) {f : ρ' → ρ}
    (hf : Function.Surjective f) : (G.submatrix f id).generatorCode = G.generatorCode := by
  simp only [generatorCode_eq_span_row]
  congr 1
  -- The rows of `G.submatrix f id` are `G.row ∘ f` by definition.
  exact hf.range_comp G.row

/-- The code generated by `G` with coordinates reindexed along `e` is the transport of the code
generated by `G`. -/
theorem generatorCode_submatrix_equiv (G : Matrix ρ ι R) (e : ι' ≃ ι) :
    (G.submatrix id e).generatorCode =
      G.generatorCode.map (LinearEquiv.funCongrLeft R R e).toLinearMap := by
  ext x
  rw [Submodule.mem_map_equiv, LinearEquiv.funCongrLeft_symm, mem_generatorCode,
    mem_generatorCode]
  refine exists_congr fun a ↦ ?_
  -- Reindexing the columns of `G` reindexes every generated word.
  have h : a ᵥ* G.submatrix id e = (a ᵥ* G) ∘ e := by
    simpa using submatrix_vecMul_equiv G a (Equiv.refl ρ) e
  have hx : LinearEquiv.funCongrLeft R R e.symm x = x ∘ e.symm :=
    funext fun _ ↦ LinearMap.funLeft_apply _ _ _ _ _
  rw [h, hx, Equiv.eq_comp_symm]

theorem IsGeneratorMatrix.mem_iff {G : Matrix ρ ι R} {C : Submodule R (ι → R)}
    (hG : G.IsGeneratorMatrix C) {x : ι → R} : x ∈ C ↔ ∃ a : ρ → R, a ᵥ* G = x := by
  rw [← hG, mem_generatorCode]

omit [Fintype ρ] in
/-- The rows of a systematic matrix `[I | A]` are linearly independent. -/
theorem linearIndependent_row_fromCols_one [Finite ρ] [DecidableEq ρ] (A : Matrix ρ τ R) :
    LinearIndependent R (fromCols (1 : Matrix ρ ρ R) A).row := by
  cases nonempty_fintype ρ
  rw [← vecMul_injective_iff]
  intro a b h
  simpa using congrArg (· ∘ Sum.inl) h

omit [Fintype ρ] in
/-- The rows of a systematic matrix `[B | I]` are linearly independent. -/
theorem linearIndependent_row_fromCols_one_right [Finite τ] [DecidableEq τ] (B : Matrix τ ρ R) :
    LinearIndependent R (fromCols B (1 : Matrix τ τ R)).row := by
  cases nonempty_fintype τ
  rw [← vecMul_injective_iff]
  intro a b h
  simpa using congrArg (· ∘ Sum.inr) h

end Semiring

section CommSemiring

variable [CommSemiring R] [Fintype ι]

/-- The linear code checked by `H`: the words with zero syndrome, as the kernel of
`H.mulVecLin`. -/
def parityCheckCode (H : Matrix σ ι R) : Submodule R (ι → R) :=
  LinearMap.ker H.mulVecLin

/-- `H` is a parity-check matrix of the code `C` when `C` is exactly the set of words with zero
syndrome `H *ᵥ x`. -/
def IsParityCheckMatrix (H : Matrix σ ι R) (C : Submodule R (ι → R)) : Prop :=
  H.parityCheckCode = C

theorem isParityCheckMatrix_iff {H : Matrix σ ι R} {C : Submodule R (ι → R)} :
    H.IsParityCheckMatrix C ↔ H.parityCheckCode = C :=
  Iff.rfl

theorem isParityCheckMatrix_parityCheckCode (H : Matrix σ ι R) :
    H.IsParityCheckMatrix H.parityCheckCode :=
  Eq.refl _

theorem parityCheckCode_def (H : Matrix σ ι R) :
    H.parityCheckCode = LinearMap.ker H.mulVecLin :=
  (rfl)

/-- The syndrome criterion: `x` lies in the code checked by `H` exactly when `H *ᵥ x = 0`. -/
@[simp]
theorem mem_parityCheckCode {H : Matrix σ ι R} {x : ι → R} :
    x ∈ H.parityCheckCode ↔ H *ᵥ x = 0 :=
  Iff.rfl

theorem IsParityCheckMatrix.mem_iff {H : Matrix σ ι R} {C : Submodule R (ι → R)}
    (hH : H.IsParityCheckMatrix C) {x : ι → R} : x ∈ C ↔ H *ᵥ x = 0 := by
  rw [← hH, mem_parityCheckCode]

/-- Left multiplication can only enlarge the checked code. -/
theorem parityCheckCode_le_mul [Fintype σ] (P : Matrix σ' σ R) (H : Matrix σ ι R) :
    H.parityCheckCode ≤ (P * H).parityCheckCode := by
  intro x hx
  rw [mem_parityCheckCode] at hx ⊢
  rw [← mulVec_mulVec, hx, mulVec_zero]

/-- Invertible row operations do not change the checked code. -/
theorem parityCheckCode_mul_of_isUnit [Fintype σ] [DecidableEq σ] {P : Matrix σ σ R}
    (hP : IsUnit P) (H : Matrix σ ι R) : (P * H).parityCheckCode = H.parityCheckCode := by
  refine le_antisymm ?_ (parityCheckCode_le_mul P H)
  obtain ⟨u, rfl⟩ := hP
  calc ((u : Matrix σ σ R) * H).parityCheckCode
      ≤ ((↑u⁻¹ : Matrix σ σ R) * ((u : Matrix σ σ R) * H)).parityCheckCode :=
        parityCheckCode_le_mul _ _
    _ = H.parityCheckCode := by rw [← Matrix.mul_assoc, Units.inv_mul, Matrix.one_mul]

/-- The code checked by `H` with coordinates reindexed along `e` is the transport of the code
checked by `H`. -/
theorem parityCheckCode_submatrix_equiv [Fintype ι'] (H : Matrix σ ι R) (e : ι' ≃ ι) :
    (H.submatrix id e).parityCheckCode =
      H.parityCheckCode.map (LinearEquiv.funCongrLeft R R e).toLinearMap := by
  ext x
  have hx : LinearEquiv.funCongrLeft R R e.symm x = x ∘ e.symm :=
    funext fun _ ↦ LinearMap.funLeft_apply _ _ _ _ _
  rw [Submodule.mem_map_equiv, LinearEquiv.funCongrLeft_symm, hx, mem_parityCheckCode,
    mem_parityCheckCode, submatrix_mulVec_equiv, Function.comp_id]

variable [Fintype σ]

/-- A word is checked by `H` exactly when it is orthogonal, for the dot product, to every word
generated by `H`. -/
theorem parityCheckCode_eq_orthogonal_generatorCode (H : Matrix σ ι R) :
    H.parityCheckCode = BilinForm.orthogonal (dotProductBilin R R) H.generatorCode := by
  ext x
  simp only [mem_parityCheckCode, BilinForm.mem_orthogonal_iff, mem_generatorCode,
    forall_exists_index, forall_apply_eq_imp_iff, dotProductBilin_apply_apply]
  simp_rw [← dotProduct_mulVec, dotProduct_comm _ (H *ᵥ x)]
  exact dotProduct_eq_zero_iff.symm

/-- The code checked by a matrix depends only on its row space. -/
theorem parityCheckCode_eq_of_generatorCode_eq [Fintype σ'] {H : Matrix σ ι R}
    {H' : Matrix σ' ι R} (h : H.generatorCode = H'.generatorCode) :
    H.parityCheckCode = H'.parityCheckCode := by
  rw [parityCheckCode_eq_orthogonal_generatorCode, parityCheckCode_eq_orthogonal_generatorCode, h]

/-- A generator matrix of `C` is a parity-check matrix of the Euclidean dual of `C`. -/
theorem IsGeneratorMatrix.isParityCheckMatrix_orthogonal {G : Matrix σ ι R}
    {C : Submodule R (ι → R)} (hG : G.IsGeneratorMatrix C) :
    G.IsParityCheckMatrix (BilinForm.orthogonal (dotProductBilin R R) C) := by
  rw [IsParityCheckMatrix, parityCheckCode_eq_orthogonal_generatorCode, hG]

end CommSemiring

section Systematic

variable [CommRing R]

/-- The systematic generator matrix `[I | A]` and the systematic parity-check matrix `[-Aᵀ | I]`
present the same code. -/
theorem generatorCode_fromCols_one [Fintype ρ] [Fintype τ] [DecidableEq ρ] [DecidableEq τ]
    (A : Matrix ρ τ R) :
    (fromCols (1 : Matrix ρ ρ R) A).generatorCode =
      (fromCols (-Aᵀ) (1 : Matrix τ τ R)).parityCheckCode := by
  ext x
  simp only [mem_generatorCode, mem_parityCheckCode, vecMul_fromCols, vecMul_one, fromCols_mulVec,
    one_mulVec, neg_mulVec, mulVec_transpose, neg_add_eq_zero]
  constructor
  · rintro ⟨a, rfl⟩
    simp
  · intro h
    refine ⟨x ∘ Sum.inl, ?_⟩
    ext (i | j)
    · rfl
    · exact congrFun h j

theorem isParityCheckMatrix_fromCols_neg_transpose_one [Fintype ρ] [Fintype τ] [DecidableEq ρ]
    [DecidableEq τ] (A : Matrix ρ τ R) :
    (fromCols (-Aᵀ) (1 : Matrix τ τ R)).IsParityCheckMatrix
      (fromCols (1 : Matrix ρ ρ R) A).generatorCode :=
  (generatorCode_fromCols_one A).symm

/-- Systematic form relative to an information set: if the coordinates are split as `ρ ⊕ τ` by
`e`, with the information coordinates `ρ`, then `[I | A]` and `[-Aᵀ | I]` with columns arranged by
`e` still present the same code. -/
theorem generatorCode_fromCols_one_submatrix [Fintype ι] [Fintype ρ] [Finite τ] [DecidableEq ρ]
    [DecidableEq τ] (A : Matrix ρ τ R) (e : ι ≃ ρ ⊕ τ) :
    ((fromCols (1 : Matrix ρ ρ R) A).submatrix id e).generatorCode =
      ((fromCols (-Aᵀ) (1 : Matrix τ τ R)).submatrix id e).parityCheckCode := by
  cases nonempty_fintype τ
  rw [generatorCode_submatrix_equiv, parityCheckCode_submatrix_equiv, generatorCode_fromCols_one]

end Systematic

section DivisionRing

theorem finrank_generatorCode_of_linearIndependent [DivisionRing K] [Fintype ρ]
    {G : Matrix ρ ι K} (hG : LinearIndependent K G.row) :
    finrank K G.generatorCode = Fintype.card ρ := by
  rw [generatorCode_eq_span_row, finrank_span_eq_card hG]

/-- A generator matrix with linearly independent rows has `finrank K C` rows. -/
theorem IsGeneratorMatrix.card_eq_finrank [DivisionRing K] [Fintype ρ] {G : Matrix ρ ι K}
    {C : Submodule K (ι → K)} (hG : G.IsGeneratorMatrix C) (hli : LinearIndependent K G.row) :
    Fintype.card ρ = finrank K C := by
  rw [← hG, finrank_generatorCode_of_linearIndependent hli]

/-- Deleting dependent rows: some linearly independent subfamily of the rows of `G` generates
the same code. -/
theorem exists_linearIndependent_generatorCode_submatrix [DivisionRing K] [Fintype ρ]
    (G : Matrix ρ ι K) :
    ∃ s : Finset ρ, LinearIndependent K (G.submatrix ((↑) : s → ρ) id).row ∧
      (G.submatrix ((↑) : s → ρ) id).generatorCode = G.generatorCode := by
  classical
  obtain ⟨b, -, -, hspan, hli⟩ :=
    exists_linearIndepOn_extension (linearIndepOn_empty K G.row) (Set.empty_subset Set.univ)
  refine ⟨b.toFinset, ?_, ?_⟩
  · -- `LinearIndepOn K G.row s` is by definition linear independence of the rows of the
    -- submatrix of `G` on the rows `s`.
    have : LinearIndepOn K G.row (b.toFinset : Set ρ) := by rwa [Set.coe_toFinset]
    exact this
  · refine (generatorCode_le_iff.2 fun i ↦ ?_).antisymm (generatorCode_le_iff.2 fun i ↦ ?_)
    · exact G.row_mem_generatorCode _
    · rw [generatorCode_eq_span_row]
      have hi := hspan ⟨i, Set.mem_univ i, rfl⟩
      refine span_mono ?_ hi
      rintro _ ⟨j, hj, rfl⟩
      exact ⟨⟨j, Set.mem_toFinset.2 hj⟩, rfl⟩

end DivisionRing

section Field

variable [Field K]

/-- The rank of a matrix is the dimension of the code it generates. -/
theorem rank_eq_finrank_generatorCode [Fintype ρ] [Fintype ι] (G : Matrix ρ ι K) :
    G.rank = finrank K G.generatorCode := by
  rw [rank_eq_finrank_span_row, generatorCode_eq_span_row]

/-- The rank of a check matrix and the dimension of the code it checks add up to the length. -/
theorem rank_add_finrank_parityCheckCode [Fintype ι] (H : Matrix σ ι K) :
    H.rank + finrank K H.parityCheckCode = Fintype.card ι := by
  rw [rank, parityCheckCode_def, LinearMap.finrank_range_add_finrank_ker,
    finrank_fintype_fun_eq_card]

/-- A parity-check matrix with linearly independent rows has `Fintype.card ι - finrank K C`
rows. -/
theorem IsParityCheckMatrix.card_add_finrank [Fintype σ] [Fintype ι] {H : Matrix σ ι K}
    {C : Submodule K (ι → K)} (hH : H.IsParityCheckMatrix C) (hli : LinearIndependent K H.row) :
    Fintype.card σ + finrank K C = Fintype.card ι := by
  rw [← hH, ← hli.rank_matrix, rank_add_finrank_parityCheckCode]

end Field

end Matrix

namespace Submodule

open Matrix

variable {K ι : Type*} [Field K]

/-- Every linear code has a generator matrix with `finrank K C` linearly independent rows. -/
theorem exists_isGeneratorMatrix [Finite ι] (C : Submodule K (ι → K)) :
    ∃ G : Matrix (Fin (finrank K C)) ι K, LinearIndependent K G.row ∧ G.IsGeneratorMatrix C := by
  let b := Module.finBasis K C
  refine ⟨Matrix.of fun i ↦ (b i : ι → K), b.linearIndependent.map' C.subtype C.ker_subtype, ?_⟩
  -- The rows of the matrix are the basis vectors, viewed as words.
  have hrow : Set.range (Matrix.of fun i ↦ (b i : ι → K)).row = C.subtype '' Set.range b := by
    rw [← Set.range_comp]
    rfl
  rw [IsGeneratorMatrix, generatorCode_eq_span_row, hrow, span_image, b.span_eq,
    Submodule.map_top, range_subtype]

/-- Every linear code has a parity-check matrix with `Fintype.card ι - finrank K C` linearly
independent rows. -/
theorem exists_isParityCheckMatrix [Fintype ι] (C : Submodule K (ι → K)) :
    ∃ H : Matrix (Fin (Fintype.card ι - finrank K C)) ι K,
      LinearIndependent K H.row ∧ H.IsParityCheckMatrix C := by
  classical
  have hdim : finrank K ((ι → K) ⧸ C) = finrank K (Fin (Fintype.card ι - finrank K C) → K) := by
    rw [C.finrank_quotient, finrank_fintype_fun_eq_card, finrank_fintype_fun_eq_card,
      Fintype.card_fin]
  let e := LinearEquiv.ofFinrankEq _ _ hdim
  let f : (ι → K) →ₗ[K] Fin (Fintype.card ι - finrank K C) → K := e.toLinearMap ∘ₗ C.mkQ
  have hf : Function.Surjective f := e.surjective.comp C.mkQ_surjective
  have hH : (LinearMap.toMatrix' f).mulVecLin = f := Matrix.toLin'_toMatrix' f
  refine ⟨LinearMap.toMatrix' f, ?_, ?_⟩
  · rw [linearIndependent_iff_card_eq_finrank_span, Set.finrank, ← rank_eq_finrank_span_row, rank,
      hH, LinearMap.range_eq_top.2 hf, finrank_top, finrank_fintype_fun_eq_card]
  · rw [IsParityCheckMatrix, parityCheckCode_def, hH, LinearEquiv.ker_comp, ker_mkQ]

end Submodule
