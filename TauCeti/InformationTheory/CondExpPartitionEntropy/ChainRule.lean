module

public import TauCeti.InformationTheory.CondExpPartitionEntropy
import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut
import TauCeti.Algebra.BigOperators.Group.Finset.Indicator
import TauCeti.Analysis.SpecialFunctions.Log.MulLog
import TauCeti.Data.Set.Prod
import TauCeti.MeasureTheory.MeasurableSpace.Sup

/-!
# The chain rule for conditional entropy given a sub-σ-algebra

Let `μ` be a finite measure on `X`, `m ≤ mX` a sub-σ-algebra, and `a : X → ι`, `b : X → κ` labels
into finite types, representing finite partitions `P` and `Q`, with the atoms of `a` measurable
and those of `b` null-measurable. The join `P ∨ Q` has the pair label `fun x ↦ (a x, b x)`, and
`σ(P)` is the σ-algebra `MeasurableSpace.comap a ⊤` generated by `a`. This file proves the
conditional chain rule

`H(P ∨ Q | m) = H(P | m) + H(Q | m ⊔ σ(P))`

for `TauCeti.condExpPartitionEntropy`.

The proof identifies the conditional probabilities given `m ⊔ σ(P)`: on the atom `a ⁻¹' {i}`, the
conditional probability of `b ⁻¹' {j}` is the ratio `μ[1_{Pᵢ ∩ Qⱼ} | m] / μ[1_{Pᵢ} | m]` of
conditional probabilities given `m`, read as `0` where the denominator vanishes. Every set
measurable for `m ⊔ σ(P)` has the form `⋃ i, Eᵢ ∩ a ⁻¹' {i}` with `Eᵢ` measurable for `m`
(`MeasurableSpace.exists_eq_iUnion_inter_of_measurableSet_sup_comap`), and the pull-out property
of conditional expectation checks the defining integrals on these sets.

## Main results

* `TauCeti.setIntegral_inter_condAtomRatio`: the ratio `μ[1_{Pᵢ ∩ Qⱼ} | m] / μ[1_{Pᵢ} | m]`
  integrates over `E ∩ a ⁻¹' {i}` to the mass of `E ∩ a ⁻¹' {i} ∩ b ⁻¹' {j}`.
* `TauCeti.condAtomProb_sup_comap_ae_eq`: the conditional probabilities given `m ⊔ σ(a)` are
  the ratios of conditional probabilities given `m`.
* `TauCeti.condExpPartitionEntropy_pair_eq_add`: the conditional chain rule
  `H(P ∨ Q | m) = H(P | m) + H(Q | m ⊔ σ(P))`.
* `TauCeti.condExpPartitionEntropy_le_pair` and `TauCeti.condExpPartitionEntropy_pair_le_add`:
  `H(P | m) ≤ H(P ∨ Q | m) ≤ H(P | m) + H(Q | m)`.
* `TauCeti.condExpPartitionEntropy_pair_self`: `H(P ∨ P | m) = H(P | m)`.

## References

* O. Sarig, *Lecture Notes on Ergodic Theory* (author notes dated 3 April 2023), Theorem 4.1 and
  Proposition 4.2, with natural logarithms.
-/

public section

open MeasureTheory Real Set Filter
open scoped ENNReal

namespace TauCeti

variable {X ι κ : Type*} {m mX : MeasurableSpace X} {μ : Measure X}

section Finite

variable [IsFiniteMeasure μ]

/-- The conditional probability of an atom of the join `P ∨ Q` is at most that of the atom of
`P` containing it. -/
theorem condAtomProb_pair_le {a : X → ι} {b : X → κ} {i : ι} (j : κ)
    (ha : NullMeasurableSet (a ⁻¹' {i}) μ) (hb : NullMeasurableSet (b ⁻¹' {j}) μ) :
    condAtomProb μ m (fun x ↦ (a x, b x)) (i, j) ≤ᵐ[μ] condAtomProb μ m a i := by
  rw [condAtomProb_def, condAtomProb_def, preimage_prodMk_singleton]
  refine condExp_mono ((integrable_const 1).indicator₀ (ha.inter hb))
    ((integrable_const 1).indicator₀ ha) (Eventually.of_forall fun x ↦ ?_)
  exact indicator_le_indicator_of_subset inter_subset_left (fun _ ↦ zero_le_one) x

/-- The conditional probabilities of the atoms of `P ∨ Q` inside the atom `a ⁻¹' {i}` of `P`
sum to the conditional probability of `a ⁻¹' {i}`. -/
theorem sum_condAtomProb_pair_ae_eq [Fintype κ] {a : X → ι} {b : X → κ} {i : ι}
    (ha : NullMeasurableSet (a ⁻¹' {i}) μ) (hb : ∀ j, NullMeasurableSet (b ⁻¹' {j}) μ) :
    ∑ j, condAtomProb μ m (fun x ↦ (a x, b x)) (i, j) =ᵐ[μ] condAtomProb μ m a i := by
  have hsum : ∑ j, (a ⁻¹' {i} ∩ b ⁻¹' {j}).indicator (1 : X → ℝ) =
      (a ⁻¹' {i}).indicator 1 := by
    ext x
    simp_rw [Finset.sum_apply, inter_comm (a ⁻¹' {i}), ← indicator_indicator]
    exact Finset.sum_indicator_preimage_singleton_apply b (fun _ ↦ (a ⁻¹' {i}).indicator 1) x
  simp_rw [condAtomProb_def, preimage_prodMk_singleton]
  refine (condExp_finsetSum (fun j _ ↦ (integrable_const 1).indicator₀ (ha.inter (hb j)))
    m).symm.trans (EventuallyEq.of_eq ?_)
  exact congrArg (fun f ↦ μ[f | m]) hsum

/-- The ratio of conditional probabilities on the atom `a ⁻¹' {i}`: `μ[1_{Pᵢ ∩ Qⱼ} | m]` divided
by `μ[1_{Pᵢ} | m]`, read as `0` where the denominator vanishes. -/
noncomputable def condAtomRatio (μ : Measure X) (m : MeasurableSpace X) (a : X → ι) (b : X → κ)
    (i : ι) (j : κ) : X → ℝ :=
  fun x ↦ condAtomProb μ m (fun y ↦ (a y, b y)) (i, j) x / condAtomProb μ m a i x

/-- Unfolding lemma for `TauCeti.condAtomRatio`. -/
theorem condAtomRatio_def (μ : Measure X) (m : MeasurableSpace X) (a : X → ι) (b : X → κ)
    (i : ι) (j : κ) :
    condAtomRatio μ m a b i j =
      fun x ↦ condAtomProb μ m (fun y ↦ (a y, b y)) (i, j) x / condAtomProb μ m a i x :=
  (rfl)

omit [IsFiniteMeasure μ] in
/-- The ratio of conditional probabilities is measurable for `m`. -/
theorem stronglyMeasurable_condAtomRatio (a : X → ι) (b : X → κ) (i : ι) (j : κ) :
    StronglyMeasurable[m] (condAtomRatio μ m a b i j) :=
  ((stronglyMeasurable_condAtomProb (μ := μ) _ _).measurable.div
    (stronglyMeasurable_condAtomProb (μ := μ) _ _).measurable).stronglyMeasurable

/-- The ratio of conditional probabilities lies in `[0, 1]` almost everywhere. -/
theorem condAtomRatio_mem_Icc {a : X → ι} {b : X → κ} {i : ι} (j : κ)
    (ha : NullMeasurableSet (a ⁻¹' {i}) μ) (hb : NullMeasurableSet (b ⁻¹' {j}) μ) :
    ∀ᵐ x ∂μ, condAtomRatio μ m a b i j x ∈ Icc (0 : ℝ) 1 := by
  filter_upwards [condAtomProb_pair_le (μ := μ) (m := m) j ha hb,
    condAtomProb_mem_Icc (μ := μ) (m := m) (fun x ↦ (a x, b x)) (i, j)] with x hle hr
  rw [condAtomRatio_def]
  exact ⟨div_nonneg hr.1 (hr.1.trans hle), div_le_one_of_le₀ hle (hr.1.trans hle)⟩

/-- Multiplying the ratio back by the conditional probability of `a ⁻¹' {i}` recovers the
conditional probability of the atom of the join, almost everywhere. -/
theorem condAtomRatio_mul_ae_eq {a : X → ι} {b : X → κ} {i : ι} (j : κ)
    (ha : NullMeasurableSet (a ⁻¹' {i}) μ) (hb : NullMeasurableSet (b ⁻¹' {j}) μ) :
    (fun x ↦ condAtomRatio μ m a b i j x * condAtomProb μ m a i x) =ᵐ[μ]
      condAtomProb μ m (fun x ↦ (a x, b x)) (i, j) := by
  filter_upwards [condAtomProb_pair_le (μ := μ) (m := m) j ha hb,
    condAtomProb_mem_Icc (μ := μ) (m := m) (fun x ↦ (a x, b x)) (i, j)] with x hle hr
  rw [condAtomRatio_def]
  by_cases hp : condAtomProb μ m a i x = 0
  · simp only [hp, mul_zero]
    exact (le_antisymm (hp ▸ hle) hr.1).symm
  · exact div_mul_cancel₀ _ hp

omit [IsFiniteMeasure μ] in
/-- Outside sub-σ-algebras the ratio is the junk value `0`. -/
theorem condAtomRatio_of_not_le (hm : ¬ m ≤ mX) (a : X → ι) (b : X → κ) (i : ι) (j : κ) :
    condAtomRatio μ m a b i j = 0 := by
  ext x
  simp [condAtomRatio_def, condAtomProb_def, condExp_of_not_le hm]

/-- The ratio of conditional probabilities is integrable. -/
theorem integrable_condAtomRatio {a : X → ι} {b : X → κ} {i : ι} (j : κ)
    (ha : NullMeasurableSet (a ⁻¹' {i}) μ) (hb : NullMeasurableSet (b ⁻¹' {j}) μ) :
    Integrable (condAtomRatio μ m a b i j) μ := by
  by_cases hm : m ≤ mX
  swap
  · rw [condAtomRatio_of_not_le hm]
    exact integrable_zero _ _ _
  refine Integrable.of_bound (C := 1)
    ((stronglyMeasurable_condAtomRatio a b i j).mono hm).aestronglyMeasurable ?_
  filter_upwards [condAtomRatio_mem_Icc (μ := μ) (m := m) j ha hb] with x hx
  rw [Real.norm_of_nonneg hx.1]
  exact hx.2

/-- For a sub-σ-algebra `m ≤ mX` and `E` measurable for `m`, the ratio
`μ[1_{Pᵢ ∩ Qⱼ} | m] / μ[1_{Pᵢ} | m]` integrates over `E ∩ a ⁻¹' {i}` to the mass of
`E ∩ a ⁻¹' {i} ∩ b ⁻¹' {j}`. -/
theorem setIntegral_inter_condAtomRatio (hm : m ≤ mX) {a : X → ι} {b : X → κ} {i : ι} (j : κ)
    (ha : MeasurableSet (a ⁻¹' {i})) (hb : NullMeasurableSet (b ⁻¹' {j}) μ) {E : Set X}
    (hE : MeasurableSet[m] E) :
    ∫ x in E ∩ a ⁻¹' {i}, condAtomRatio μ m a b i j x ∂μ =
      ∫ x in E ∩ a ⁻¹' {i}, (b ⁻¹' {j}).indicator 1 x ∂μ := by
  have hmulq : condAtomRatio μ m a b i j * (a ⁻¹' {i}).indicator (1 : X → ℝ) =
      (a ⁻¹' {i}).indicator (condAtomRatio μ m a b i j) := by
    ext x
    by_cases hx : x ∈ a ⁻¹' {i} <;> simp [hx]
  have hqA_int : Integrable (condAtomRatio μ m a b i j * (a ⁻¹' {i}).indicator (1 : X → ℝ)) μ :=
    hmulq ▸ (integrable_condAtomRatio j ha.nullMeasurableSet hb).indicator ha
  have hpull : μ[condAtomRatio μ m a b i j * (a ⁻¹' {i}).indicator (1 : X → ℝ) | m] =ᵐ[μ]
      condAtomRatio μ m a b i j * condAtomProb μ m a i := by
    rw [condAtomProb_def]
    exact condExp_mul_of_stronglyMeasurable_left (stronglyMeasurable_condAtomRatio a b i j)
      hqA_int ((integrable_const 1).indicator ha)
  have hABint : Integrable ((a ⁻¹' {i} ∩ b ⁻¹' {j}).indicator (1 : X → ℝ)) μ :=
    (integrable_const 1).indicator₀ (ha.nullMeasurableSet.inter hb)
  calc ∫ x in E ∩ a ⁻¹' {i}, condAtomRatio μ m a b i j x ∂μ
      = ∫ x in E, (condAtomRatio μ m a b i j * (a ⁻¹' {i}).indicator (1 : X → ℝ)) x ∂μ := by
        rw [hmulq, setIntegral_indicator ha]
    _ = ∫ x in E,
          μ[condAtomRatio μ m a b i j * (a ⁻¹' {i}).indicator (1 : X → ℝ) | m] x ∂μ :=
        (setIntegral_condExp hm hqA_int hE).symm
    _ = ∫ x in E, condAtomProb μ m (fun x ↦ (a x, b x)) (i, j) x ∂μ := by
        refine setIntegral_congr_ae (hm _ hE) ?_
        filter_upwards [hpull, condAtomRatio_mul_ae_eq (μ := μ) (m := m) j ha.nullMeasurableSet hb]
          with x hx hx' _
        rw [hx, Pi.mul_apply, hx']
    _ = ∫ x in E, (a ⁻¹' {i}).indicator ((b ⁻¹' {j}).indicator 1) x ∂μ := by
        rw [condAtomProb_def, preimage_prodMk_singleton, setIntegral_condExp hm hABint hE]
        refine setIntegral_congr_fun (hm _ hE) fun x _ ↦ ?_
        by_cases hx : x ∈ a ⁻¹' {i} <;> by_cases hx' : x ∈ b ⁻¹' {j} <;> simp_all
    _ = ∫ x in E ∩ a ⁻¹' {i}, (b ⁻¹' {j}).indicator 1 x ∂μ :=
        setIntegral_indicator ha

/-- **Conditional probabilities given `m ⊔ σ(P)`.** On the atom `a ⁻¹' {i}` the conditional
probability of `b ⁻¹' {j}` given `m ⊔ σ(a)` is the ratio
`μ[1_{Pᵢ ∩ Qⱼ} | m] / μ[1_{Pᵢ} | m]`. -/
theorem condAtomProb_sup_comap_ae_eq [Finite ι] {a : X → ι} {b : X → κ}
    (ha : ∀ i, MeasurableSet (a ⁻¹' {i})) (hb : ∀ j, NullMeasurableSet (b ⁻¹' {j}) μ) (j : κ) :
    condAtomProb μ (m ⊔ MeasurableSpace.comap a ⊤) b j =ᵐ[μ]
      fun x ↦ condAtomRatio μ m a b (a x) j x := by
  by_cases hm : m ≤ mX
  swap
  · -- Outside sub-σ-algebras both sides are the junk value `0`.
    have hm' : ¬ m ⊔ MeasurableSpace.comap a ⊤ ≤ mX := fun h ↦ hm (le_sup_left.trans h)
    refine EventuallyEq.of_eq ?_
    ext x
    simp [condAtomProb_def, condAtomRatio_def, condExp_of_not_le hm, condExp_of_not_le hm']
  cases nonempty_fintype ι
  have hm'X : m ⊔ MeasurableSpace.comap a ⊤ ≤ mX :=
    MeasurableSpace.sup_comap_le_of_measurableSet_preimage_singleton hm ha
  set g : X → ℝ := fun x ↦ condAtomRatio μ m a b (a x) j x with hg
  have hg_sum : g = ∑ i, (a ⁻¹' {i}).indicator (condAtomRatio μ m a b i j) := by
    ext x
    rw [Finset.sum_apply, Finset.sum_indicator_preimage_singleton_apply]
  have hgm : StronglyMeasurable[m ⊔ MeasurableSpace.comap a ⊤] g := by
    rw [hg_sum]
    refine Finset.stronglyMeasurable_sum _ fun i _ ↦ ?_
    exact ((stronglyMeasurable_condAtomRatio (μ := μ) (m := m) a b i j).mono
      le_sup_left).indicator (MeasurableSpace.measurableSet_preimage_singleton_sup_comap a i)
  have hg_int : Integrable g μ := by
    rw [hg_sum]
    exact integrable_finsetSum' _ fun i _ ↦
      (integrable_condAtomRatio (μ := μ) (m := m) j (ha i).nullMeasurableSet (hb j)).indicator
        (ha i)
  have hf_int : Integrable ((b ⁻¹' {j}).indicator (1 : X → ℝ)) μ :=
    (integrable_const 1).indicator₀ (hb j)
  rw [condAtomProb_def]
  refine (ae_eq_condExp_of_forall_setIntegral_eq hm'X hf_int
    (fun s _ _ ↦ hg_int.integrableOn) (fun s hs _ ↦ ?_) hgm.aestronglyMeasurable).symm
  obtain ⟨E, hE, rfl⟩ := MeasurableSpace.exists_eq_iUnion_inter_of_measurableSet_sup_comap hs
  have hEA : ∀ i, MeasurableSet (E i ∩ a ⁻¹' {i}) := fun i ↦ (hm _ (hE i)).inter (ha i)
  have hdisj : Pairwise (Function.onFun Disjoint fun i ↦ E i ∩ a ⁻¹' {i}) := by
    intro i i' hii'
    refine Set.disjoint_left.2 fun x hx hx' ↦ hii' ?_
    exact hx.2.symm.trans hx'.2
  rw [integral_iUnion_fintype hEA hdisj fun i ↦ hg_int.integrableOn,
    integral_iUnion_fintype hEA hdisj fun i ↦ hf_int.integrableOn]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [← setIntegral_inter_condAtomRatio hm j (ha i) (hb j) (hE i)]
  exact setIntegral_congr_fun (hEA i) fun x hx ↦ by simp [hg, show a x = i from hx.2]

/-- The function `1_{Pᵢ} · ∑ⱼ negMulLog (μ[1_{Pᵢ ∩ Qⱼ} | m] / μ[1_{Pᵢ} | m])` is integrable. -/
theorem integrable_indicator_sum_negMulLog_condAtomRatio [Fintype κ] {a : X → ι} {b : X → κ}
    {i : ι} (ha : NullMeasurableSet (a ⁻¹' {i}) μ) (hb : ∀ j, NullMeasurableSet (b ⁻¹' {j}) μ) :
    Integrable ((a ⁻¹' {i}).indicator fun x ↦ ∑ j, negMulLog (condAtomRatio μ m a b i j x))
      μ := by
  by_cases hm : m ≤ mX
  swap
  · simp [condAtomRatio_of_not_le hm]
  refine Integrable.indicator₀ ?_ ha
  refine integrable_finsetSum _ fun j _ ↦ Integrable.of_bound (C := 1) ?_ ?_
  · exact continuous_negMulLog.comp_aestronglyMeasurable
      ((stronglyMeasurable_condAtomRatio a b i j).mono hm).aestronglyMeasurable
  · filter_upwards [condAtomRatio_mem_Icc (μ := μ) (m := m) j ha (hb j)] with x hx
    rw [Real.norm_of_nonneg (negMulLog_nonneg hx.1 hx.2)]
    exact (negMulLog_le_one_sub_self hx.1).trans (by linarith [hx.1])

/-- The contribution of the atom `a ⁻¹' {i}` to `H(Q | m ⊔ σ(P))`:
`∫ 1_{Pᵢ} ∑ⱼ negMulLog (rᵢⱼ / pᵢ) = ∑ⱼ ∫ negMulLog rᵢⱼ - ∫ negMulLog pᵢ`, where
`pᵢ = μ[1_{Pᵢ} | m]` and `rᵢⱼ = μ[1_{Pᵢ ∩ Qⱼ} | m]`. -/
theorem integral_indicator_sum_negMulLog_condAtomRatio [Fintype κ] {a : X → ι} {b : X → κ}
    {i : ι} (ha : NullMeasurableSet (a ⁻¹' {i}) μ) (hb : ∀ j, NullMeasurableSet (b ⁻¹' {j}) μ) :
    ∫ x, (a ⁻¹' {i}).indicator (fun x ↦ ∑ j, negMulLog (condAtomRatio μ m a b i j x)) x ∂μ =
      ∑ j, ∫ x, negMulLog (condAtomProb μ m (fun x ↦ (a x, b x)) (i, j) x) ∂μ -
        ∫ x, negMulLog (condAtomProb μ m a i x) ∂μ := by
  by_cases hm : m ≤ mX
  swap
  · simp [condAtomRatio_of_not_le hm, condAtomProb_def, condExp_of_not_le hm]
  set φ : X → ℝ := fun x ↦ ∑ j, negMulLog (condAtomRatio μ m a b i j x) with hφ
  have hφm : StronglyMeasurable[m] φ := by
    refine (Finset.measurable_sum _ fun j _ ↦ ?_).stronglyMeasurable
    exact continuous_negMulLog.measurable.comp
      (stronglyMeasurable_condAtomRatio a b i j).measurable
  have hmul : (a ⁻¹' {i}).indicator φ = φ * (a ⁻¹' {i}).indicator 1 := by
    ext x
    by_cases hx : x ∈ a ⁻¹' {i} <;> simp [hx]
  have hpull : μ[φ * (a ⁻¹' {i}).indicator 1 | m] =ᵐ[μ] φ * condAtomProb μ m a i := by
    rw [condAtomProb_def]
    exact condExp_mul_of_stronglyMeasurable_left hφm
      (hmul ▸ integrable_indicator_sum_negMulLog_condAtomRatio ha hb)
      ((integrable_const 1).indicator₀ ha)
  have hpt : (φ * condAtomProb μ m a i) =ᵐ[μ] fun x ↦
      ∑ j, negMulLog (condAtomProb μ m (fun x ↦ (a x, b x)) (i, j) x) -
        negMulLog (condAtomProb μ m a i x) := by
    have hnn := ae_all_iff.2 fun j ↦
      condAtomProb_mem_Icc (μ := μ) (m := m) (fun x ↦ (a x, b x)) (i, j)
    filter_upwards [hnn, sum_condAtomProb_pair_ae_eq (μ := μ) (m := m) ha hb] with x hnn hsum
    rw [Pi.mul_apply, mul_comm, hφ]
    simp only [condAtomRatio_def]
    exact mul_sum_negMulLog_div (fun j ↦ (hnn j).1) (by simpa using hsum)
  rw [hmul, ← integral_condExp hm, integral_congr_ae (hpull.trans hpt),
    integral_sub (integrable_finsetSum _ fun j _ ↦ integrable_negMulLog_condAtomProb _ _)
      (integrable_negMulLog_condAtomProb _ _),
    integral_finsetSum _ fun j _ ↦ integrable_negMulLog_condAtomProb _ _]

/-- **Conditional chain rule.** For a finite measure, a sub-σ-algebra `m` and finite partitions
`P`, `Q` labelled by `a` and `b`, with the atoms of `a` measurable and those of `b`
null-measurable,
`H(P ∨ Q | m) = H(P | m) + H(Q | m ⊔ σ(P))`, where `P ∨ Q` is labelled by the pair `(a, b)` and
`σ(P) = MeasurableSpace.comap a ⊤`. -/
theorem condExpPartitionEntropy_pair_eq_add [Fintype ι] [Fintype κ] {a : X → ι}
    {b : X → κ} (ha : ∀ i, MeasurableSet (a ⁻¹' {i}))
    (hb : ∀ j, NullMeasurableSet (b ⁻¹' {j}) μ) :
    condExpPartitionEntropy μ m (fun x ↦ (a x, b x)) =
      condExpPartitionEntropy μ m a +
        condExpPartitionEntropy μ (m ⊔ MeasurableSpace.comap a ⊤) b := by
  -- `H(Q | m ⊔ σ(P)) = ∑ᵢ ∫ 1_{Pᵢ} ∑ⱼ negMulLog (rᵢⱼ / pᵢ)`.
  have h1 : condExpPartitionEntropy μ (m ⊔ MeasurableSpace.comap a ⊤) b =
      ∑ i, ∫ x, (a ⁻¹' {i}).indicator
        (fun x ↦ ∑ j, negMulLog (condAtomRatio μ m a b i j x)) x ∂μ := by
    rw [condExpPartitionEntropy_congr fun j ↦
      (condAtomProb_sup_comap_ae_eq (μ := μ) ha hb j).symm, ← integral_finsetSum _
      fun i _ ↦ integrable_indicator_sum_negMulLog_condAtomRatio (ha i).nullMeasurableSet hb]
    congr 1
    ext x
    rw [Finset.sum_indicator_preimage_singleton_apply a
      (fun i x ↦ ∑ j, negMulLog (condAtomRatio μ m a b i j x))]
  rw [h1, Finset.sum_congr rfl fun i _ ↦
      integral_indicator_sum_negMulLog_condAtomRatio (ha i).nullMeasurableSet hb,
    Finset.sum_sub_distrib, condExpPartitionEntropy_eq_sum, condExpPartitionEntropy_eq_sum,
    Fintype.sum_prod_type]
  ring

/-- Refining the partition does not decrease the conditional entropy: `H(P | m) ≤ H(P ∨ Q | m)`. -/
theorem condExpPartitionEntropy_le_pair [Fintype ι] [Fintype κ] {a : X → ι}
    {b : X → κ} (ha : ∀ i, MeasurableSet (a ⁻¹' {i}))
    (hb : ∀ j, NullMeasurableSet (b ⁻¹' {j}) μ) :
    condExpPartitionEntropy μ m a ≤ condExpPartitionEntropy μ m (fun x ↦ (a x, b x)) := by
  rw [condExpPartitionEntropy_pair_eq_add ha hb]
  exact le_add_of_nonneg_right (condExpPartitionEntropy_nonneg _ _)

/-- **Conditional subadditivity.** `H(P ∨ Q | m) ≤ H(P | m) + H(Q | m)`. -/
theorem condExpPartitionEntropy_pair_le_add [Fintype ι] [Fintype κ] {a : X → ι}
    {b : X → κ} (ha : ∀ i, MeasurableSet (a ⁻¹' {i}))
    (hb : ∀ j, NullMeasurableSet (b ⁻¹' {j}) μ) :
    condExpPartitionEntropy μ m (fun x ↦ (a x, b x)) ≤
      condExpPartitionEntropy μ m a + condExpPartitionEntropy μ m b := by
  rw [condExpPartitionEntropy_pair_eq_add ha hb]
  exact add_le_add_right (condExpPartitionEntropy_anti le_sup_left b) _

/-- Joining a partition with itself does not change its conditional entropy:
`H(P ∨ P | m) = H(P | m)`. -/
theorem condExpPartitionEntropy_pair_self [Fintype ι] {a : X → ι}
    (ha : ∀ i, MeasurableSet (a ⁻¹' {i})) :
    condExpPartitionEntropy μ m (fun x ↦ (a x, a x)) = condExpPartitionEntropy μ m a := by
  rw [condExpPartitionEntropy_pair_eq_add ha fun i ↦ (ha i).nullMeasurableSet,
    condExpPartitionEntropy_eq_zero_of_measurableSet (μ := μ) (m := m ⊔ MeasurableSpace.comap a ⊤)
      (MeasurableSpace.measurableSet_preimage_singleton_sup_comap a), add_zero]

end Finite

end TauCeti
