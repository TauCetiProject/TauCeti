module

public import TauCeti.InformationTheory.CondExpPartitionEntropy
public import TauCeti.InformationTheory.PartitionEntropy
import Mathlib.MeasureTheory.Function.FactorsThrough
import TauCeti.Analysis.SpecialFunctions.Log.MulLog
import TauCeti.MeasureTheory.Measure.Real

/-!
# Conditional entropy given the σ-algebra of a countable label

Let `b : X → κ` be a measurable label into a countable type and `m = MeasurableSpace.comap b _`
the σ-algebra it generates. Every `m`-measurable function factors through `b`, so the conditional
probability `TauCeti.condAtomProb μ m a i` is constant on each atom `b ⁻¹' {j}`; on an atom of
positive mass it is the elementary conditional probability
`μ(a ⁻¹' {i} ∩ b ⁻¹' {j}) / μ(b ⁻¹' {j})`, and atoms of mass zero form a null set. Hence the
conditional entropy `TauCeti.condExpPartitionEntropy μ m a` of a finite partition given `m` is the
double sum `∑ i, ∑' j, p_ij * log (p_j / p_ij)`, the conditional partition entropy
`TauCeti.conditionalPartitionEntropy μ a b`.

## Main results

* `TauCeti.condAtomProb_comap_eq`: the conditional probability on an atom of positive mass.
* `TauCeti.condExpPartitionEntropy_comap_eq_sum`: for a finite label `b`, the conditional entropy
  as a finite double sum.
* `TauCeti.ofReal_integral_negMulLog_condAtomProb_comap`: the contribution of one atom of `a`, as
  a sum over the atoms of a countable label `b`.
* `TauCeti.ofReal_condExpPartitionEntropy_comap_eq_conditionalPartitionEntropy` and
  `TauCeti.condExpPartitionEntropy_comap_eq_toReal_conditionalPartitionEntropy`: for a countable
  label `b`, agreement with `TauCeti.conditionalPartitionEntropy μ a b`.
-/

public section

open MeasureTheory Real Set Filter
open scoped ENNReal

namespace TauCeti

variable {X ι κ : Type*} {mX : MeasurableSpace X} {μ : Measure X} {b : X → κ}

/-- Given the σ-algebra generated by the label `b`, the conditional probability of an atom of
`a` is a function of `b`. -/
theorem factorsThrough_condAtomProb_comap [mκ : MeasurableSpace κ] (a : X → ι) (i : ι) :
    (condAtomProb μ (mκ.comap b) a i).FactorsThrough b :=
  (stronglyMeasurable_condAtomProb a i).factorsThrough

/-- On an atom `b ⁻¹' {b x}` of positive mass, the conditional probability of the atom
`a ⁻¹' {i}` given the σ-algebra generated by `b` is the elementary conditional probability
`μ(a ⁻¹' {i} ∩ b ⁻¹' {b x}) / μ(b ⁻¹' {b x})`. -/
theorem condAtomProb_comap_eq [mκ : MeasurableSpace κ] [MeasurableSingletonClass κ]
    [IsFiniteMeasure μ] (hb : Measurable b) {a : X → ι} {i : ι}
    (ha : NullMeasurableSet (a ⁻¹' {i}) μ) {x : X} (hx : μ.real (b ⁻¹' {b x}) ≠ 0) :
    condAtomProb μ (mκ.comap b) a i x =
      μ.real (a ⁻¹' {i} ∩ b ⁻¹' {b x}) / μ.real (b ⁻¹' {b x}) := by
  have hm : mκ.comap b ≤ mX := hb.comap_le
  have hs : MeasurableSet[mκ.comap b] (b ⁻¹' {b x}) := ⟨{b x}, measurableSet_singleton _, rfl⟩
  have hint := setIntegral_condAtomProb hm ((integrable_const (1 : ℝ)).indicator₀ ha) hs
  have hconst : EqOn (condAtomProb μ (mκ.comap b) a i) (fun _ ↦ condAtomProb μ (mκ.comap b) a i x)
      (b ⁻¹' {b x}) := fun y hy ↦ factorsThrough_condAtomProb_comap a i hy
  rw [setIntegral_congr_fun (hb (measurableSet_singleton _)) hconst, setIntegral_const,
    smul_eq_mul, inter_comm] at hint
  rw [← hint]
  field_simp

/-- On the σ-algebra generated by a countable label `b`, `ENNReal.ofReal` of the integral of
`negMulLog` of the conditional probability of the atom `a ⁻¹' {i}` is
`∑' j, ENNReal.ofReal (p_ij * log (p_j / p_ij))`, with `p_ij = μ(a ⁻¹' {i} ∩ b ⁻¹' {j})` and
`p_j = μ(b ⁻¹' {j})`. -/
theorem ofReal_integral_negMulLog_condAtomProb_comap [Countable κ] [mκ : MeasurableSpace κ]
    [MeasurableSingletonClass κ] [IsFiniteMeasure μ] (hb : Measurable b) {a : X → ι} {i : ι}
    (ha : NullMeasurableSet (a ⁻¹' {i}) μ) :
    ENNReal.ofReal (∫ x, negMulLog (condAtomProb μ (mκ.comap b) a i x) ∂μ) =
      ∑' j, ENNReal.ofReal (μ.real (a ⁻¹' {i} ∩ b ⁻¹' {j}) *
        log (μ.real (b ⁻¹' {j}) / μ.real (a ⁻¹' {i} ∩ b ⁻¹' {j}))) := by
  set G : κ → ℝ := fun j ↦ negMulLog (μ.real (a ⁻¹' {i} ∩ b ⁻¹' {j}) / μ.real (b ⁻¹' {j}))
  have hae : (fun x ↦ negMulLog (condAtomProb μ (mκ.comap b) a i x)) =ᵐ[μ] fun x ↦ G (b x) := by
    filter_upwards [ae_measureReal_preimage_ne_zero (μ := μ) (b := b)] with x hx
    rw [condAtomProb_comap_eq hb ha hx]
  have hG : ∀ j, 0 ≤ G j := fun j ↦ negMulLog_nonneg (div_nonneg measureReal_nonneg
    measureReal_nonneg) (div_le_one_of_le₀ (measureReal_mono inter_subset_right)
      measureReal_nonneg)
  rw [integral_congr_ae hae, ofReal_integral_eq_lintegral_ofReal
      ((integrable_negMulLog_condAtomProb a i).congr hae) (.of_forall fun x ↦ hG (b x)),
    ← lintegral_map (f := fun j ↦ ENNReal.ofReal (G j)) (measurable_of_countable _) hb,
    lintegral_countable']
  refine tsum_congr fun j ↦ ?_
  rw [Measure.map_apply hb (measurableSet_singleton _), ← ofReal_measureReal (measure_ne_top _ _),
    ← ENNReal.ofReal_mul (hG j), mul_comm, mul_negMulLog_div]

variable [Fintype ι]

/-- **Conditioning on a finite label.** For a finite measure, the conditional entropy of the
finite partition given by `a` given the σ-algebra generated by the measurable finite label `b` is
the finite double sum `∑ i, ∑ j, p_ij * log (p_j / p_ij)`, with `p_ij = μ(a ⁻¹' {i} ∩ b ⁻¹' {j})`
and `p_j = μ(b ⁻¹' {j})`. -/
theorem condExpPartitionEntropy_comap_eq_sum [Fintype κ] [mκ : MeasurableSpace κ]
    [MeasurableSingletonClass κ] [IsFiniteMeasure μ] (hb : Measurable b) {a : X → ι}
    (ha : ∀ i, NullMeasurableSet (a ⁻¹' {i}) μ) :
    condExpPartitionEntropy μ (mκ.comap b) a = ∑ i, ∑ j, μ.real (a ⁻¹' {i} ∩ b ⁻¹' {j}) *
      log (μ.real (b ⁻¹' {j}) / μ.real (a ⁻¹' {i} ∩ b ⁻¹' {j})) := by
  rw [condExpPartitionEntropy_eq_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  have hnn (j : κ) : 0 ≤ μ.real (a ⁻¹' {i} ∩ b ⁻¹' {j}) *
      log (μ.real (b ⁻¹' {j}) / μ.real (a ⁻¹' {i} ∩ b ⁻¹' {j})) :=
    mul_log_div_nonneg measureReal_nonneg (measureReal_mono inter_subset_right)
  have h := ofReal_integral_negMulLog_condAtomProb_comap hb (ha i)
  rw [tsum_fintype, ← ENNReal.ofReal_sum_of_nonneg fun j _ ↦ hnn j] at h
  exact (ENNReal.ofReal_eq_ofReal_iff (integral_negMulLog_condAtomProb_nonneg _ a i)
    (Finset.sum_nonneg fun j _ ↦ hnn j)).mp h

/-- **Agreement with the conditional partition entropy.** For a finite measure, a finite
partition with null-measurable atoms and a measurable countable label `b`, the conditional entropy
given the σ-algebra generated by `b` is `TauCeti.conditionalPartitionEntropy μ a b`. -/
theorem ofReal_condExpPartitionEntropy_comap_eq_conditionalPartitionEntropy [Countable κ]
    [mκ : MeasurableSpace κ] [MeasurableSingletonClass κ] [IsFiniteMeasure μ] (hb : Measurable b)
    {a : X → ι} (ha : ∀ i, NullMeasurableSet (a ⁻¹' {i}) μ) :
    ENNReal.ofReal (condExpPartitionEntropy μ (mκ.comap b) a) =
      conditionalPartitionEntropy μ a b := by
  rw [condExpPartitionEntropy_eq_sum, ENNReal.ofReal_sum_of_nonneg fun i _ ↦
      integral_negMulLog_condAtomProb_nonneg _ a i,
    conditionalPartitionEntropy_def, tsum_prod', tsum_fintype]
  exact Finset.sum_congr rfl fun i _ ↦ ofReal_integral_negMulLog_condAtomProb_comap hb (ha i)

/-- The real form of
`TauCeti.ofReal_condExpPartitionEntropy_comap_eq_conditionalPartitionEntropy`. -/
theorem condExpPartitionEntropy_comap_eq_toReal_conditionalPartitionEntropy [Countable κ]
    [mκ : MeasurableSpace κ] [MeasurableSingletonClass κ] [IsFiniteMeasure μ] (hb : Measurable b)
    {a : X → ι} (ha : ∀ i, NullMeasurableSet (a ⁻¹' {i}) μ) :
    condExpPartitionEntropy μ (mκ.comap b) a = (conditionalPartitionEntropy μ a b).toReal := by
  rw [← ofReal_condExpPartitionEntropy_comap_eq_conditionalPartitionEntropy hb ha,
    ENNReal.toReal_ofReal (condExpPartitionEntropy_nonneg _ a)]

end TauCeti
