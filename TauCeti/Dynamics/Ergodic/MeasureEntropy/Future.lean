module

public import TauCeti.Dynamics.Ergodic.MeasureEntropy.Basic
public import TauCeti.InformationTheory.CondExpPartitionEntropy.Filtration

/-!
# The entropy rate as a conditional entropy given the future

Let `T` be a measure-preserving map of a probability space and `a : X → ι` a measurable countable
label of finite entropy. The σ-algebra `TauCeti.futureMeasurableSpace T a n` is generated by
`a ∘ T, …, a ∘ T^[n]`, the first `n` steps of the future of the label. The future conditional
entropies `H(P | futureMeasurableSpace T a n)` decrease to the entropy rate `h_μ(T, P)`, so

`h_μ(T, P) = H(P | ⨆ j, σ(a ∘ T^[j + 1]))`.

The proof uses the chain rule `H(join_{n+1} a) = H(join_n a) + H(P | futureMeasurableSpace T a n)`,
so that `H(join_n a)` is the sum of the first `n` future conditional entropies, together with the
continuity of conditional entropy along increasing σ-algebras
(`TauCeti.condExpCountablePartitionEntropy_iSup_eq_iInf`).

## Main definitions

* `TauCeti.futureMeasurableSpace T a n`: the σ-algebra generated by `a ∘ T^[j + 1]`, `j < n`.
* `TauCeti.futureFiltration`: these σ-algebras as a filtration, for measurable `T` and `a`.

## Main results

* `TauCeti.countablePartitionEntropy_iteratedPartitionLabel_succ` and
  `TauCeti.countablePartitionEntropy_iteratedPartitionLabel_eq_sum`: the itinerary entropies are
  partial sums of the future conditional entropies.
* `TauCeti.conditionalPartitionEntropy_future_antitone` and
  `TauCeti.tendsto_condExpCountablePartitionEntropy_futureMeasurableSpace`: the future conditional
  entropies decrease to the entropy rate.
* `TauCeti.partitionEntropyRate_eq_condExpCountablePartitionEntropy_future`: the future formula
  `h_μ(T, P) = H(P | ⨆ j, σ(a ∘ T^[j + 1]))`, and
  `TauCeti.partitionEntropyRate_eq_ofReal_condExpPartitionEntropy_future` its form for finite
  labels and `TauCeti.condExpPartitionEntropy`.

## References

* O. Sarig, *Lecture Notes on Ergodic Theory* (author notes dated 3 April 2023), Theorem 4.2,
  p. 108, with natural logarithms.
-/

public section

open MeasureTheory Real Filter Topology
open scoped ENNReal

namespace TauCeti

variable {X ι : Type*} {mX : MeasurableSpace X} {μ : Measure X}

section Future

variable [MeasurableSpace ι]

/-- The σ-algebra generated by the first `n` steps of the future of the label `a` under `T`, that
is by `a ∘ T^[j + 1]` for `j < n`: the pullback of the length-`n` itinerary of `T x`. -/
@[instance_reducible]
def futureMeasurableSpace (T : X → X) (a : X → ι) (n : ℕ) : MeasurableSpace X :=
  MeasurableSpace.comap (fun x ↦ iteratedPartitionLabel T a n (T x)) inferInstance

theorem futureMeasurableSpace_def (T : X → X) (a : X → ι) (n : ℕ) :
    futureMeasurableSpace T a n =
      MeasurableSpace.comap (fun x ↦ iteratedPartitionLabel T a n (T x)) inferInstance :=
  (rfl)

/-- The future σ-algebra of length `n` is generated by the labels `a ∘ T^[j + 1]`, `j < n`. -/
theorem futureMeasurableSpace_eq_iSup (T : X → X) (a : X → ι) (n : ℕ) :
    futureMeasurableSpace T a n =
      ⨆ j : Fin n, MeasurableSpace.comap (a ∘ T^[(j : ℕ) + 1]) inferInstance := by
  rw [futureMeasurableSpace_def, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  refine iSup_congr fun j ↦ ?_
  rw [MeasurableSpace.comap_comp]
  congr 1
  funext x
  simp

/-- The future σ-algebras increase with their length. -/
theorem futureMeasurableSpace_mono (T : X → X) (a : X → ι) : Monotone (futureMeasurableSpace T a) :=
  fun m n hmn ↦ by
    simp only [futureMeasurableSpace_eq_iSup]
    exact iSup_le fun j ↦ le_iSup_of_le (Fin.castLE hmn j) le_rfl

/-- The union of the future σ-algebras is generated by the labels `a ∘ T^[j + 1]`, `j : ℕ`. -/
theorem iSup_futureMeasurableSpace (T : X → X) (a : X → ι) :
    ⨆ n, futureMeasurableSpace T a n =
      ⨆ j : ℕ, MeasurableSpace.comap (a ∘ T^[j + 1]) inferInstance := by
  simp only [futureMeasurableSpace_eq_iSup]
  refine le_antisymm (iSup_le fun n ↦ iSup_le fun j ↦ le_iSup_of_le (j : ℕ) le_rfl)
    (iSup_le fun j ↦ le_iSup_of_le (j + 1) (le_iSup_of_le (Fin.last j) le_rfl))

/-- For measurable `T` and `a`, the future σ-algebras are sub-σ-algebras of the ambient one. -/
theorem futureMeasurableSpace_le {T : X → X} (hT : Measurable T) {a : X → ι} (ha : Measurable a)
    (n : ℕ) : futureMeasurableSpace T a n ≤ mX :=
  ((measurable_iteratedPartitionLabel hT ha n).comp hT).comap_le

/-- The future σ-algebras of a measurable label under a measurable map, as a filtration. -/
def futureFiltration {T : X → X} (hT : Measurable T) {a : X → ι} (ha : Measurable a) :
    Filtration ℕ mX where
  seq := futureMeasurableSpace T a
  mono' := futureMeasurableSpace_mono T a
  le' := futureMeasurableSpace_le hT ha

@[simp]
theorem futureFiltration_apply {T : X → X} (hT : Measurable T) {a : X → ι} (ha : Measurable a)
    (n : ℕ) : futureFiltration hT ha n = futureMeasurableSpace T a n :=
  (rfl)

end Future

/-- An itinerary of length `n + 1` is the label followed by the length-`n` itinerary of `T x`. -/
theorem iteratedPartitionLabel_succ (T : X → X) (a : X → ι) (n : ℕ) (x : X) :
    iteratedPartitionLabel T a (n + 1) x = Fin.cons (a x) (iteratedPartitionLabel T a n (T x)) := by
  funext k
  refine Fin.cases ?_ (fun j ↦ ?_) k
  · simp
  · simp [Function.iterate_succ_apply]

section Measurable

variable [Countable ι] [MeasurableSpace ι] [MeasurableSingletonClass ι] {T : X → X} {a : X → ι}

/-- **Chain rule along the future.** For a measure-preserving map under a probability (or zero)
measure and a measurable countable label,
`H(join_{n+1} a) = H(join_n a) + H(a | join_n a ∘ T)`. -/
theorem countablePartitionEntropy_iteratedPartitionLabel_succ [IsZeroOrProbabilityMeasure μ]
    (hT : MeasurePreserving T μ μ) (ha : Measurable a) (n : ℕ) :
    countablePartitionEntropy μ (iteratedPartitionLabel T a (n + 1)) =
      countablePartitionEntropy μ (iteratedPartitionLabel T a n) +
        conditionalPartitionEntropy μ a (fun x ↦ iteratedPartitionLabel T a n (T x)) := by
  have hinj : Function.Injective fun p : ι × (Fin n → ι) ↦ (Fin.cons p.1 p.2 : Fin (n + 1) → ι) :=
    fun p q h ↦ Prod.ext (by simpa using congrFun h 0)
      (funext fun j ↦ by simpa using congrFun h j.succ)
  have hlabel : iteratedPartitionLabel T a (n + 1) =
      (fun p : ι × (Fin n → ι) ↦ (Fin.cons p.1 p.2 : Fin (n + 1) → ι)) ∘
        fun x ↦ (a x, iteratedPartitionLabel T a n (T x)) :=
    funext (iteratedPartitionLabel_succ T a n)
  rw [hlabel, countablePartitionEntropy_comp_of_injective _ hinj,
    countablePartitionEntropy_pair_eq_add ha]
  congr 1
  exact countablePartitionEntropy_comp_of_measurePreserving hT
    (measurable_iteratedPartitionLabel hT.measurable ha n)

/-- The itinerary entropies are the partial sums of the future conditional entropies:
`H(join_n a) = ∑_{k < n} H(a | join_k a ∘ T)`. -/
theorem countablePartitionEntropy_iteratedPartitionLabel_eq_sum [IsZeroOrProbabilityMeasure μ]
    (hT : MeasurePreserving T μ μ) (ha : Measurable a) (n : ℕ) :
    countablePartitionEntropy μ (iteratedPartitionLabel T a n) =
      ∑ k ∈ Finset.range n,
        conditionalPartitionEntropy μ a (fun x ↦ iteratedPartitionLabel T a k (T x)) := by
  induction n with
  | zero =>
    rw [iteratedPartitionLabel_zero, Finset.sum_range_zero]
    exact countablePartitionEntropy_const _
  | succ n ih =>
    rw [countablePartitionEntropy_iteratedPartitionLabel_succ hT ha, ih, Finset.sum_range_succ]

/-- The future conditional entropy of length `n` is the conditional entropy given the future
σ-algebra `TauCeti.futureMeasurableSpace T a n`. -/
theorem condExpCountablePartitionEntropy_futureMeasurableSpace [IsFiniteMeasure μ]
    (hT : Measurable T) (ha : Measurable a) (n : ℕ) :
    condExpCountablePartitionEntropy μ (futureMeasurableSpace T a n) a =
      conditionalPartitionEntropy μ a (fun x ↦ iteratedPartitionLabel T a n (T x)) :=
  condExpCountablePartitionEntropy_comap_eq_conditionalPartitionEntropy
    ((measurable_iteratedPartitionLabel hT ha n).comp hT)
    fun i ↦ (ha (measurableSet_singleton i)).nullMeasurableSet

/-- The future conditional entropies decrease with their length. -/
theorem conditionalPartitionEntropy_future_antitone [IsFiniteMeasure μ] (hT : Measurable T)
    (ha : Measurable a) :
    Antitone fun n ↦
      conditionalPartitionEntropy μ a (fun x ↦ iteratedPartitionLabel T a n (T x)) := by
  intro m n hmn
  simp only [← condExpCountablePartitionEntropy_futureMeasurableSpace hT ha]
  exact condExpCountablePartitionEntropy_anti (futureMeasurableSpace_mono T a hmn) a

variable [IsProbabilityMeasure μ]

/-- **The future formula, countable labels.** For a measure-preserving map of a probability space
and a measurable countable label of finite entropy, the entropy rate is the conditional entropy
given the whole future, `h_μ(T, P) = H(P | ⨆ n, futureMeasurableSpace T a n)`. -/
theorem partitionEntropyRate_eq_condExpCountablePartitionEntropy_iSup
    (hT : MeasurePreserving T μ μ) (ha : Measurable a) (hfin : countablePartitionEntropy μ a ≠ ∞) :
    partitionEntropyRate μ T a =
      condExpCountablePartitionEntropy μ (⨆ n, futureMeasurableSpace T a n) a := by
  set c : ℕ → ℝ≥0∞ := fun n ↦
    conditionalPartitionEntropy μ a (fun x ↦ iteratedPartitionLabel T a n (T x))
  have hlim : condExpCountablePartitionEntropy μ (⨆ n, futureMeasurableSpace T a n) a =
      ⨅ n, c n := by
    have := condExpCountablePartitionEntropy_iSup_eq_iInf (futureFiltration hT.measurable ha) hfin
    simpa only [futureFiltration_apply,
      condExpCountablePartitionEntropy_futureMeasurableSpace hT.measurable ha] using this
  have hanti : Antitone c := conditionalPartitionEntropy_future_antitone hT.measurable ha
  have hsum : ∀ n, countablePartitionEntropy μ (iteratedPartitionLabel T a n) =
      ∑ k ∈ Finset.range n, c k :=
    countablePartitionEntropy_iteratedPartitionLabel_eq_sum hT ha
  have hc_le : ∀ k, c k ≤ countablePartitionEntropy μ a := fun k ↦
    conditionalPartitionEntropy_le a ((measurable_iteratedPartitionLabel hT.measurable ha k).comp
      hT.measurable)
  rw [hlim]
  refine le_antisymm (le_iInf fun m ↦ ?_) (le_partitionEntropyRate_iff.mpr fun n hn ↦ ?_)
  · -- `H(join_n a) ≤ m * H(a) + n * c m` for `n ≥ m`; divide by `n` and let `n → ∞`.
    have hbound : ∀ n, m ≤ n → 0 < n →
        countablePartitionEntropy μ (iteratedPartitionLabel T a n) / n ≤
          m * countablePartitionEntropy μ a / n + c m := fun n hmn hn ↦ by
      have hn0 : (n : ℝ≥0∞) ≠ 0 := by exact_mod_cast hn.ne'
      rw [ENNReal.div_le_iff hn0 (ENNReal.natCast_ne_top n), add_mul,
        ENNReal.div_mul_cancel hn0 (ENNReal.natCast_ne_top n), hsum,
        ← Finset.sum_range_add_sum_Ico _ hmn, mul_comm (c m)]
      gcongr
      · calc ∑ k ∈ Finset.range m, c k ≤ ∑ _k ∈ Finset.range m, countablePartitionEntropy μ a :=
              Finset.sum_le_sum fun k _ ↦ hc_le k
          _ = m * countablePartitionEntropy μ a := by simp
      · calc ∑ k ∈ Finset.Ico m n, c k ≤ ∑ _k ∈ Finset.Ico m n, c m :=
              Finset.sum_le_sum fun k hk ↦ hanti (Finset.mem_Ico.mp hk).1
          _ = (n - m : ℕ) * c m := by simp
          _ ≤ n * c m := by gcongr; exact Nat.sub_le n m
    have htend : Tendsto (fun n : ℕ ↦ m * countablePartitionEntropy μ a / n + c m) atTop
        (𝓝 (c m)) := by
      have hC : (m : ℝ≥0∞) * countablePartitionEntropy μ a ≠ ∞ :=
        ENNReal.mul_ne_top (ENNReal.natCast_ne_top m) hfin
      have h0 : Tendsto (fun n : ℕ ↦ m * countablePartitionEntropy μ a / n) atTop (𝓝 0) := by
        simpa [div_eq_mul_inv] using
          ENNReal.Tendsto.const_mul ENNReal.tendsto_inv_nat_nhds_zero (Or.inr hC)
      simpa using h0.add_const (c m)
    exact le_of_tendsto_of_tendsto (tendsto_partitionEntropyRate hT ha) htend
      (eventually_atTop.mpr ⟨m + 1, fun n hn ↦ hbound n (by omega) (by omega)⟩)
  · have hn0 : (n : ℝ≥0∞) ≠ 0 := by exact_mod_cast hn.ne'
    rw [ENNReal.le_div_iff_mul_le (Or.inl hn0) (Or.inl (ENNReal.natCast_ne_top n)), hsum,
      mul_comm]
    calc (n : ℝ≥0∞) * ⨅ k, c k = ∑ _k ∈ Finset.range n, ⨅ k, c k := by simp
      _ ≤ ∑ k ∈ Finset.range n, c k := Finset.sum_le_sum fun k _ ↦ iInf_le c k

/-- **The future formula.** For a measure-preserving map of a probability space and a measurable
countable label of finite entropy, `h_μ(T, P) = H(P | ⨆ j, σ(a ∘ T^[j + 1]))`. -/
theorem partitionEntropyRate_eq_condExpCountablePartitionEntropy_future
    (hT : MeasurePreserving T μ μ) (ha : Measurable a) (hfin : countablePartitionEntropy μ a ≠ ∞) :
    partitionEntropyRate μ T a = condExpCountablePartitionEntropy μ
      (⨆ j : ℕ, MeasurableSpace.comap (a ∘ T^[j + 1]) inferInstance) a := by
  rw [← iSup_futureMeasurableSpace,
    partitionEntropyRate_eq_condExpCountablePartitionEntropy_iSup hT ha hfin]

/-- The future conditional entropies `H(a | join_n a ∘ T)` decrease to the entropy rate. -/
theorem tendsto_condExpCountablePartitionEntropy_futureMeasurableSpace
    (hT : MeasurePreserving T μ μ) (ha : Measurable a) (hfin : countablePartitionEntropy μ a ≠ ∞) :
    Tendsto (fun n ↦ condExpCountablePartitionEntropy μ (futureMeasurableSpace T a n) a) atTop
      (𝓝 (partitionEntropyRate μ T a)) := by
  rw [partitionEntropyRate_eq_condExpCountablePartitionEntropy_iSup hT ha hfin]
  exact tendsto_condExpCountablePartitionEntropy_iSup (futureFiltration hT.measurable ha) hfin

/-- The future conditional entropies `H(a | join_n a ∘ T)`, as conditional entropies of labels,
decrease to the entropy rate. -/
theorem tendsto_conditionalPartitionEntropy_future (hT : MeasurePreserving T μ μ)
    (ha : Measurable a) (hfin : countablePartitionEntropy μ a ≠ ∞) :
    Tendsto (fun n ↦
      conditionalPartitionEntropy μ a (fun x ↦ iteratedPartitionLabel T a n (T x))) atTop
      (𝓝 (partitionEntropyRate μ T a)) := by
  simpa only [condExpCountablePartitionEntropy_futureMeasurableSpace hT.measurable ha] using
    tendsto_condExpCountablePartitionEntropy_futureMeasurableSpace hT ha hfin

/-- **The future formula, finite labels.** For a measure-preserving map of a probability space and
a measurable finite label, `h_μ(T, P) = H(P | ⨆ j, σ(a ∘ T^[j + 1]))` with the real-valued
`TauCeti.condExpPartitionEntropy`. -/
theorem partitionEntropyRate_eq_ofReal_condExpPartitionEntropy_future [Fintype ι]
    (hT : MeasurePreserving T μ μ) (ha : Measurable a) :
    partitionEntropyRate μ T a = ENNReal.ofReal (condExpPartitionEntropy μ
      (⨆ j : ℕ, MeasurableSpace.comap (a ∘ T^[j + 1]) inferInstance) a) := by
  rw [partitionEntropyRate_eq_condExpCountablePartitionEntropy_future hT ha
    (countablePartitionEntropy_ne_top μ a), condExpCountablePartitionEntropy_eq_ofReal]

/-- The real form of `TauCeti.partitionEntropyRate_eq_ofReal_condExpPartitionEntropy_future`. -/
theorem toReal_partitionEntropyRate_eq_condExpPartitionEntropy_future [Fintype ι]
    (hT : MeasurePreserving T μ μ) (ha : Measurable a) :
    (partitionEntropyRate μ T a).toReal = condExpPartitionEntropy μ
      (⨆ j : ℕ, MeasurableSpace.comap (a ∘ T^[j + 1]) inferInstance) a := by
  rw [partitionEntropyRate_eq_ofReal_condExpPartitionEntropy_future hT ha,
    ENNReal.toReal_ofReal (condExpPartitionEntropy_nonneg _ a)]

end Measurable

end TauCeti
