module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.Dynamics.PeriodicPts.Defs

/-!
# Periodic points as cyclic sequences

Let `f : X → X` be a map, read as a partial map defined on a set `D ⊆ X`, and let `N ≥ 1`. A
**periodic chain** of `f` through `D` is a sequence `z : ℤ/N → X` with `z i ∈ D` and
`f (z i) = z (i + 1)` for every `i`. Such a sequence is the orbit of its value at `0`,
`z i = f^[i] (z 0)` (`TauCeti.apply_eq_iterate_val_apply_zero`), so evaluation at `0` identifies
the periodic chains with the points `x` with `f^[N] x = x` whose iterates `x, f x, …, f^[N-1] x`
all lie in `D` (`Function.periodicChainEquiv`). The least period of such a point need only
divide `N`.

Under this identification the cyclic shift `z ↦ z (· + 1)` of a chain becomes `f`: shifting a
chain moves its marked point one step along the same periodic orbit
(`Function.coe_periodicChainEquiv_eq_iff`). The classes of chains up to cyclic shifts are
therefore the periodic orbits of `f` through `D`, without a marked point.

These are the marked and unmarked periodic orbits of a map generated by a generating function,
whose critical configurations are periodic chains
(`TauCeti.CotangentBundle.exists_equiv_iterate_of_generating`).
-/

public section

variable {X : Type*} {f : X → X} {D : Set X} {N : ℕ}

namespace TauCeti

/-- A sequence on `ℤ/N` along which `f` steps forward takes the value `f^[n] (z 0)` at `n`. -/
theorem apply_natCast_eq_iterate_apply_zero {z : ZMod N → X} (hz : ∀ i, f (z i) = z (i + 1))
    (n : ℕ) : z n = f^[n] (z 0) := by
  induction n with
  | zero => simp
  | succ n ih => rw [Nat.cast_succ, ← hz, ih, Function.iterate_succ_apply']

/-- A sequence on `ℤ/N` along which `f` steps forward is the orbit of its value at `0`. -/
theorem apply_eq_iterate_val_apply_zero [NeZero N] {z : ZMod N → X}
    (hz : ∀ i, f (z i) = z (i + 1)) (i : ZMod N) : z i = f^[i.val] (z 0) := by
  rw [← apply_natCast_eq_iterate_apply_zero hz, ZMod.natCast_zmod_val]

end TauCeti

namespace Function

/-- At a point of period `N`, the iterate `f^[n]` depends only on the class of `n` modulo `N`. -/
theorem IsPeriodicPt.iterate_val_natCast_apply {x : X} (hx : IsPeriodicPt f N x) (n : ℕ) :
    f^[(n : ZMod N).val] x = f^[n] x := by
  rw [ZMod.val_natCast, hx.iterate_mod_apply]

/-- At a point of period `N`, the iterates indexed by `ℤ/N` step forward under `f`. -/
theorem IsPeriodicPt.iterate_val_add_one_apply [NeZero N] {x : X} (hx : IsPeriodicPt f N x)
    (i : ZMod N) : f^[(i + 1).val] x = f (f^[i.val] x) := by
  have hi : i + 1 = ((i.val + 1 : ℕ) : ZMod N) := by
    rw [Nat.cast_succ, ZMod.natCast_zmod_val]
  rw [hi, hx.iterate_val_natCast_apply, iterate_succ_apply']

open TauCeti

variable (f D N) [NeZero N]

/-- **Periodic chains are marked periodic points.** Evaluation at `0` identifies the sequences
`z : ℤ/N → X` with `z i ∈ D` and `f (z i) = z (i + 1)` with the points of period `N` of `f` whose
iterates `x, f x, …, f^[N-1] x` lie in `D`. The inverse sends `x` to `i ↦ f^[i] x`. -/
def periodicChainEquiv :
    {z : ZMod N → X // ∀ i, z i ∈ D ∧ f (z i) = z (i + 1)} ≃
      {x : X // (∀ k < N, f^[k] x ∈ D) ∧ IsPeriodicPt f N x} where
  toFun z := ⟨z.val 0, fun k _ ↦
      apply_natCast_eq_iterate_apply_zero (fun i ↦ (z.property i).2) k ▸ (z.property k).1, by
    -- The value at `N = 0` in `ℤ/N` is both `z 0` and `f^[N] (z 0)`.
    have h := apply_natCast_eq_iterate_apply_zero (fun i ↦ (z.property i).2) N
    rw [ZMod.natCast_self] at h
    exact h.symm⟩
  invFun x := ⟨fun i ↦ f^[i.val] x.val, fun i ↦
    ⟨x.property.1 _ (ZMod.val_lt i), (x.property.2.iterate_val_add_one_apply i).symm⟩⟩
  left_inv z := Subtype.ext <| funext fun i ↦
    (apply_eq_iterate_val_apply_zero (fun i ↦ (z.property i).2) i).symm
  right_inv x := Subtype.ext <| by simp [ZMod.val_zero]

variable {f D N}

/-- The marked point of a periodic chain is its value at `0`. -/
@[simp]
theorem coe_periodicChainEquiv (z : {z : ZMod N → X // ∀ i, z i ∈ D ∧ f (z i) = z (i + 1)}) :
    (periodicChainEquiv f D N z : X) = z.val 0 :=
  (rfl)

/-- The periodic chain of a marked periodic point `x` is its orbit `i ↦ f^[i] x`. -/
@[simp]
theorem coe_periodicChainEquiv_symm_apply
    (x : {x : X // (∀ k < N, f^[k] x ∈ D) ∧ IsPeriodicPt f N x}) (i : ZMod N) :
    ((periodicChainEquiv f D N).symm x : ZMod N → X) i = f^[i.val] x.val :=
  (rfl)

/-- **Shifting a periodic chain moves its marked point along the orbit.** The marked point of a
periodic chain `z'` is the image under `f` of the marked point of `z` exactly when `z'` is the
cyclic shift `i ↦ z (i + 1)` of `z`. -/
theorem coe_periodicChainEquiv_eq_iff
    {z z' : {z : ZMod N → X // ∀ i, z i ∈ D ∧ f (z i) = z (i + 1)}} :
    (periodicChainEquiv f D N z' : X) = f (periodicChainEquiv f D N z) ↔
      z'.val = fun i ↦ z.val (i + 1) := by
  simp only [coe_periodicChainEquiv]
  constructor
  · -- Both `z'` and the shift of `z` are chains, and they agree at `0`.
    intro h
    funext i
    have hshift := apply_eq_iterate_val_apply_zero (z := fun i ↦ z.val (i + 1))
      (fun i ↦ (z.property (i + 1)).2) i
    rw [zero_add] at hshift
    rw [hshift, apply_eq_iterate_val_apply_zero (fun i ↦ (z'.property i).2) i, h, (z.property 0).2,
        zero_add]
  · intro h
    rw [h]
    exact (z.property 0).2.symm

end Function
