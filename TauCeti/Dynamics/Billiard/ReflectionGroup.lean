/-!
# Reflection groups of side directions

For a family `D` of unit directions, the *reflection group* `TauCeti.Billiard.reflectionGroup D`
is the subgroup of the real linear isometries `ℂ ≃ₗᵢ[ℝ] ℂ` generated by the side reflections
`σ_d(v) = d² · conj v`, `d ∈ D`. For a polygonal billiard table, `D` is the set of directions of
its sides, and the table is rational when this group is finite.

The side reflection `σ_d` is the reflection `TauCeti.Complex.conjReflection (d²)`
(`TauCeti.Billiard.sideReflection_eq_conjReflection_sq`), so the general facts about groups of
linear isometries of the plane in `TauCeti.Analysis.Complex.LinearIsometryGroup` apply: the
rotations of the reflection group form its rotation subgroup `TauCeti.Complex.rotationSubgroup`,
and a finite group of isometries containing a reflection is dihedral
(`TauCeti.Complex.nonempty_mulEquiv_dihedralGroup`). A reflection `v ↦ b · conj v` lies in the
reflection group exactly when the rotation by `b d₀⁻²` does, for any `d₀ ∈ D`
(`TauCeti.Billiard.conjReflection_mem_reflectionGroup_iff`).

For the reflection group of `D`, the rotation subgroup is generated by the rotations through twice
the angles between directions of `D`, the squares `(d e⁻¹)²`
(`TauCeti.Billiard.rotationSubgroup_reflectionGroup`), because a product of two reflections
`σ_d σ_e` is the rotation by `(d e⁻¹)²`. When `D` contains two directions that are not parallel
(`d ≠ ±e`), that rotation is not the identity, so a finite reflection group is dihedral of order
`2N` with `N ≥ 2` (`TauCeti.Billiard.exists_mulEquiv_dihedralGroup_reflectionGroup`). Rotating
every direction by `a` conjugates the reflection group by the rotation `a`
(`TauCeti.Billiard.reflectionGroup_image_mul`).

A finite reflection group with a rotation subgroup of order `N` consists of the `N` rotations and
the reflections in `N` lines through `0` at angles `π/N` apart, spanned by `d₀ e^{ikπ/N}` for any
`d₀ ∈ D` (`TauCeti.Billiard.conjReflection_mem_reflectionGroup_iff_exists`); every direction of
`D` spans one of these lines (`TauCeti.Billiard.exists_eq_mul_exp_or_eq_neg_of_mem`).

For directions `exp(kθ)`, `k ∈ s` with `0, 1 ∈ s`, the squares of the quotients are the powers
of `exp(2θ)`, which generates the rotation subgroup
(`TauCeti.Billiard.rotationSubgroup_reflectionGroup_exp`); the reflection group then has order
twice the order of `exp(2θ)` (`TauCeti.Billiard.natCard_reflectionGroup_exp`).

## References

* H. Masur, S. Tabachnikov, *Rational billiards and flat structures*, Handbook of Dynamical
  Systems 1A (2002), Section 1.
-/

public section

noncomputable section

open Complex ComplexConjugate Set TauCeti.Complex

namespace TauCeti.Billiard

/-! ### The reflection group of a family of directions -/

/-- **The reflection group** of a family `D` of unit directions: the group of real linear
isometries of `ℂ` generated by the side reflections `σ_d`, `d ∈ D`. For the family of side
directions of a polygonal billiard table, the table is rational when this group is finite. -/
def reflectionGroup (D : Set Circle) : Subgroup (ℂ ≃ₗᵢ[ℝ] ℂ) :=
  Subgroup.closure (sideReflection '' D)

/-- The reflection group of `D` is the subgroup generated by the side reflections `σ_d`,
`d ∈ D`. -/
theorem reflectionGroup_def (D : Set Circle) :
    reflectionGroup D = Subgroup.closure (sideReflection '' D) :=
  (rfl)

@[simp]
theorem reflectionGroup_empty : reflectionGroup ∅ = ⊥ := by
  rw [reflectionGroup_def, image_empty, Subgroup.closure_empty]

variable {D : Set Circle}

theorem sideReflection_mem_reflectionGroup {d : Circle} (hd : d ∈ D) :
    sideReflection d ∈ reflectionGroup D := by
  rw [reflectionGroup_def]
  exact Subgroup.subset_closure (mem_image_of_mem _ hd)

/-- For `d ∈ D`, the reflection group of `D` contains the reflection `v ↦ d² conj v`, which is
the side reflection `σ_d`. -/
theorem conjReflection_sq_mem_reflectionGroup {d : Circle} (hd : d ∈ D) :
    conjReflection (d ^ 2) ∈ reflectionGroup D :=
  sideReflection_eq_conjReflection_sq d ▸ sideReflection_mem_reflectionGroup hd

/-- The reflection group of `D` is the smallest group of isometries containing the side
reflections `σ_d`, `d ∈ D`. -/
theorem reflectionGroup_le_iff {H : Subgroup (ℂ ≃ₗᵢ[ℝ] ℂ)} :
    reflectionGroup D ≤ H ↔ ∀ d ∈ D, sideReflection d ∈ H := by
  simp only [reflectionGroup_def, Subgroup.closure_le, subset_def, forall_mem_image,
    SetLike.mem_coe]

theorem reflectionGroup_mono {D' : Set Circle} (h : D ⊆ D') :
    reflectionGroup D ≤ reflectionGroup D' := by
  rw [reflectionGroup_def, reflectionGroup_def]
  exact Subgroup.closure_mono (image_mono h)

/-- **The reflections of the reflection group.** For any `d₀ ∈ D`, the reflection
`v ↦ b conj v` lies in the reflection group of `D` exactly when the rotation by `b (d₀²)⁻¹`
does. -/
theorem conjReflection_mem_reflectionGroup_iff {d₀ b : Circle} (hd₀ : d₀ ∈ D) :
    conjReflection b ∈ reflectionGroup D ↔ b * (d₀ ^ 2)⁻¹ ∈ rotationSubgroup (reflectionGroup D) :=
  conjReflection_mem_iff (conjReflection_sq_mem_reflectionGroup hd₀)

/-- **The rotation subgroup of a reflection group** is generated by the rotations through twice
the angles between the directions, the squares `(d e⁻¹)²`: `σ_d σ_e` is the rotation by
`(d e⁻¹)²`. -/
theorem rotationSubgroup_reflectionGroup :
    rotationSubgroup (reflectionGroup D) =
      Subgroup.closure {c | ∃ d ∈ D, ∃ e ∈ D, c = (d * e⁻¹) ^ 2} := by
  rw [reflectionGroup_def, show sideReflection = conjReflection ∘ (· ^ 2) from
    funext sideReflection_eq_conjReflection_sq, image_comp,
    rotationSubgroup_closure_image_conjReflection]
  simp only [exists_mem_image, mul_pow, inv_pow]

/-- A reflection group containing two non-parallel directions has a nontrivial rotation subgroup;
when it is finite, of order at least `2`. -/
theorem two_le_natCard_rotationSubgroup_reflectionGroup [Finite (reflectionGroup D)]
    {d e : Circle} (hd : d ∈ D) (he : e ∈ D) (hde : d ≠ e) (hde' : d ≠ -e) :
    2 ≤ Nat.card (rotationSubgroup (reflectionGroup D)) := by
  have hmem : (d * e⁻¹) ^ 2 ∈ rotationSubgroup (reflectionGroup D) := by
    rw [rotationSubgroup_reflectionGroup]
    exact Subgroup.subset_closure ⟨d, hd, e, he, rfl⟩
  have : Nontrivial (rotationSubgroup (reflectionGroup D)) :=
    ⟨⟨⟨_, hmem⟩, 1, fun h => Circle.sq_mul_inv_ne_one hde hde' (congrArg Subtype.val h)⟩⟩
  exact Finite.one_lt_card_iff_nontrivial.2 this

/-- **A finite reflection group is dihedral.** If the reflection group of `D` is finite and `D`
contains two directions that are not parallel, it is isomorphic to the dihedral group of order
`2N` for some `N ≥ 2`. -/
theorem exists_mulEquiv_dihedralGroup_reflectionGroup [Finite (reflectionGroup D)] {d e : Circle}
    (hd : d ∈ D) (he : e ∈ D) (hde : d ≠ e) (hde' : d ≠ -e) :
    ∃ N, 2 ≤ N ∧ Nonempty (reflectionGroup D ≃* DihedralGroup N) :=
  ⟨_, two_le_natCard_rotationSubgroup_reflectionGroup hd he hde hde',
    nonempty_mulEquiv_dihedralGroup (conjReflection_sq_mem_reflectionGroup hd)⟩

/-- **Rotating the directions conjugates the reflection group.** Rotating every direction of `D`
by `a`, as a similarity `z ↦ a z + c` does to the sides of a table, conjugates the reflection
group by the rotation `v ↦ a v`. -/
theorem reflectionGroup_image_mul (a : Circle) (D : Set Circle) :
    reflectionGroup ((a * ·) '' D) =
      (reflectionGroup D).map (MulAut.conj (rotation a)).toMonoidHom := by
  rw [reflectionGroup_def, reflectionGroup_def, MonoidHom.map_closure, image_image, image_image]
  congr 1
  refine image_congr fun d _ => ?_
  simp [sideReflection_eq_conjReflection_sq, ← map_inv, mul_pow, sq a, mul_right_comm a a]

/-! ### Directions `exp(kθ)` -/

/-- For directions `exp(kθ)`, `k ∈ s`, with `0, 1 ∈ s`, the rotation subgroup of the reflection
group is generated by `exp(2θ)`. -/
theorem rotationSubgroup_reflectionGroup_exp (θ : ℝ) {s : Set ℤ} (h0 : 0 ∈ s) (h1 : 1 ∈ s) :
    rotationSubgroup (reflectionGroup ((fun k : ℤ => Circle.exp (k * θ)) '' s)) =
      Subgroup.zpowers (Circle.exp (2 * θ)) := by
  rw [rotationSubgroup_reflectionGroup]
  refine le_antisymm ((Subgroup.closure_le _).2 ?_) (Subgroup.zpowers_le.2 ?_)
  · rintro c ⟨_, ⟨j, -, rfl⟩, _, ⟨k, -, rfl⟩, rfl⟩
    rw [Circle.sq_exp_mul_inv]
    exact Subgroup.zpow_mem_zpowers _ _
  · refine Subgroup.subset_closure ⟨_, mem_image_of_mem _ h1, _, mem_image_of_mem _ h0, ?_⟩
    rw [Circle.sq_exp_mul_inv]
    simp

/-- For directions `exp(kθ)`, `k ∈ s`, with `0, 1 ∈ s`, the reflection group has order twice
the order of `exp(2θ)`. (When `exp(2θ)` has infinite order, both sides are `0`.) -/
theorem natCard_reflectionGroup_exp (θ : ℝ) {s : Set ℤ} (h0 : 0 ∈ s) (h1 : 1 ∈ s) :
    Nat.card (reflectionGroup ((fun k : ℤ => Circle.exp (k * θ)) '' s)) =
      2 * orderOf (Circle.exp (2 * θ)) := by
  rw [natCard_eq_two_mul_natCard_rotationSubgroup
    (conjReflection_sq_mem_reflectionGroup (mem_image_of_mem _ h0)),
    rotationSubgroup_reflectionGroup_exp θ h0 h1, Nat.card_zpowers]

/-- **The reflections of a finite reflection group.** If the reflection group of `D` is finite,
with a rotation subgroup of order `N`, and `d₀ ∈ D`, then its reflections are the reflections in
the `N` lines through `0` spanned by `d₀ e^{ikπ/N}`, `k ∈ ℤ`, at angles `π/N` apart: the
reflection `v ↦ b · conj v` lies in it exactly when `b = (d₀ e^{ikπ/N})²` for some `k`. This is
`TauCeti.Complex.conjReflection_mem_iff_exists_exp` for the reflection `σ_{d₀}`. -/
theorem conjReflection_mem_reflectionGroup_iff_exists [Finite (reflectionGroup D)] {d₀ b : Circle}
    (hd₀ : d₀ ∈ D) :
    conjReflection b ∈ reflectionGroup D ↔ ∃ k : ℤ, b =
      (d₀ * Circle.exp (k * Real.pi / Nat.card (rotationSubgroup (reflectionGroup D)))) ^ 2 := by
  have : Finite (rotationSubgroup (reflectionGroup D)) :=
    finite_iff_finite_rotationSubgroup.1 inferInstance
  have hsq : ∀ k : ℤ,
      Circle.exp (k * Real.pi / Nat.card (rotationSubgroup (reflectionGroup D))) ^ 2 =
        Circle.exp (k * (2 * Real.pi / Nat.card (rotationSubgroup (reflectionGroup D)))) :=
    fun k => by
      rw [← Circle.exp_natCast_mul]
      congr 1
      push_cast
      ring
  rw [conjReflection_mem_iff_exists_exp (conjReflection_sq_mem_reflectionGroup hd₀)]
  exact exists_congr fun k => by rw [mul_pow, hsq]

/-- **The side directions of a finite reflection group lie on its lines.** If the reflection group
of `D` is finite, with a rotation subgroup of order `N`, then every direction `d ∈ D` is
`±d₀ e^{ikπ/N}` for some `k ∈ ℤ`, for any `d₀ ∈ D`: the line spanned by `d` is one of the `N`
lines of `TauCeti.Billiard.conjReflection_mem_reflectionGroup_iff_exists`. -/
theorem exists_eq_mul_exp_or_eq_neg_of_mem [Finite (reflectionGroup D)] {d₀ d : Circle}
    (hd₀ : d₀ ∈ D) (hd : d ∈ D) :
    ∃ k : ℤ, d = d₀ * Circle.exp (k * Real.pi / Nat.card (rotationSubgroup (reflectionGroup D))) ∨
      d = -(d₀ * Circle.exp (k * Real.pi / Nat.card (rotationSubgroup (reflectionGroup D)))) := by
  obtain ⟨k, hk⟩ := (conjReflection_mem_reflectionGroup_iff_exists hd₀).1
    (conjReflection_sq_mem_reflectionGroup hd)
  refine ⟨k, ?_⟩
  set e := d₀ * Circle.exp (k * Real.pi / Nat.card (rotationSubgroup (reflectionGroup D)))
  have h1 : (d * e⁻¹) ^ 2 = 1 := by rw [mul_pow, hk, inv_pow, mul_inv_cancel]
  rcases (Circle.sq_eq_one_iff _).1 h1 with h | h
  · exact Or.inl (mul_inv_eq_one.1 h)
  · exact Or.inr (by rw [← neg_one_mul, ← h, inv_mul_cancel_right])

end TauCeti.Billiard
