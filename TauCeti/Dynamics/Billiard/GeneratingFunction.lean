/-!
# The generating function of the billiard map

Let `χ` be an arclength parametrization of the boundary of a strictly convex billiard table
(`TauCeti.StrictConvexBilliardTable`), with period `L`, and let `B(s, v) = (t, w)` be its
next-collision map on the strip `ℝ × (-1, 1)`: a ball leaving `χ(s)` with unit velocity `u` of
tangential component `v` next hits the boundary at `χ(t)`, `t ∈ (s, s + L)`, and `w = ⟪u, χ'(t)⟫`.

The billiard map is generated by minus the chord length,

`S(s, t) = -‖χ(t) - χ(s)‖`

(`TauCeti.StrictConvexBilliardTable.generatingFunction`), in the sense of generating functions of
symplectic maps of the cotangent bundle `T*ℝ` with the canonical covector `v` at `s`: the state
`(s, v)` is sent to `(t, w)` exactly when

`v = ∂_s S(s, t)` and `w = -∂_t S(s, t)`,

for `t` in the window `(s, s + L)`. Indeed, wherever `χ(t) ≠ χ(s)`, the partial derivatives are
`∂_s S = ⟪χ'(s), u⟫` and `∂_t S = -⟪χ'(t), u⟫`, where `u` is the unit vector along the chord from
`χ(s)` to `χ(t)` (`TauCeti.StrictConvexBilliardTable.chordDir`). The chord to the next collision
point is along the outgoing velocity of the state, and conversely every chord of the window is the
chord of the state at `χ(s)` with its tangential component. `S` is invariant under translating
both arguments by `L`.

The *twist condition* holds: the mixed partial derivative is

`∂_t ∂_s S = ∂_s ∂_t S = ω(χ'(s), u) ω(χ'(t), u) / ‖χ(t) - χ(s)‖ < 0`,

where `ω` is the area form of the orientation. Its sign comes from the strict convexity of the
table and the non-tangency of every chord: the chord points into the table at `χ(s)` and out of it
at `χ(t)`. At the next collision point of the state `(s, v)` it is
`-√(1 - v²) √(1 - w²) / ℓ`, where `ℓ` is the length of the chord.

Consequently, for fixed `s`, the map `t ↦ ∂_s S(s, t)` is strictly decreasing from the window
`(s, s + L)` onto `(-1, 1)`, and the next collision parameter `v ↦ t` is its inverse. So `v ↦ t`
is a strictly decreasing bijection of `(-1, 1)` onto `(s, s + L)`, continuous, and differentiable
with negative derivative

`∂t/∂v = -ℓ / (√(1 - v²) √(1 - w²))`

(`TauCeti.StrictConvexBilliardTable.hasDerivAt_nextParam`). Only the unit-speed derivative of `χ`
is used; the joint smoothness of the billiard map is a separate matter.

## Main definitions

* `TauCeti.StrictConvexBilliardTable.generatingFunction`: minus the chord length
  `S(s, t) = -‖χ(t) - χ(s)‖`.
* `TauCeti.StrictConvexBilliardTable.chordDir`: the unit vector along the chord from `χ(s)` to
  `χ(t)`.

## Main results

* `TauCeti.StrictConvexBilliardTable.generatingFunction_eq_billiardGeneratingFunction`: `S` is the
  generating function `TauCeti.billiardGeneratingFunction` of the parametrization, in curried form.
* `TauCeti.StrictConvexBilliardTable.generatingFunction_add_period`: `S(s + L, t + L) = S(s, t)`.
* `TauCeti.StrictConvexBilliardTable.hasDerivAt_generatingFunction_left`,
  `TauCeti.StrictConvexBilliardTable.hasDerivAt_generatingFunction_right`: the partial derivatives
  of `S`.
* `TauCeti.StrictConvexBilliardTable.deriv_generatingFunction_left_nextParam`,
  `TauCeti.StrictConvexBilliardTable.deriv_generatingFunction_right_nextParam`:
  `v = ∂_s S(s, t)` and `w = -∂_t S(s, t)` at the next collision.
* `TauCeti.StrictConvexBilliardTable.nextParam_eq_iff_deriv_generatingFunction_left_eq`: for `t` in
  the window `(s, s + L)`, `t` is the next collision parameter of `(s, v)` exactly when
  `v = ∂_s S(s, t)`.
* `TauCeti.StrictConvexBilliardTable.hasDerivAt_deriv_generatingFunction_left`,
  `TauCeti.StrictConvexBilliardTable.hasDerivAt_deriv_generatingFunction_right`: the mixed partial
  derivatives of `S`, in either order.
* `TauCeti.StrictConvexBilliardTable.deriv_deriv_generatingFunction_left_neg`,
  `TauCeti.StrictConvexBilliardTable.deriv_deriv_generatingFunction_right_neg`: the twist
  condition `∂_t ∂_s S = ∂_s ∂_t S < 0`.
* `TauCeti.StrictConvexBilliardTable.strictAntiOn_nextParam`,
  `TauCeti.StrictConvexBilliardTable.image_nextParam_Ioo`,
  `TauCeti.StrictConvexBilliardTable.continuousOn_nextParam`: for fixed `s`, the next collision
  parameter is a strictly decreasing continuous bijection of `(-1, 1)` onto `(s, s + L)`.
* `TauCeti.StrictConvexBilliardTable.hasDerivAt_nextParam`,
  `TauCeti.StrictConvexBilliardTable.deriv_nextParam_neg`: its derivative, which is negative.

## References

* Ana Cannas da Silva, *Lectures on Symplectic Geometry*, Lecture Notes in Mathematics 1764,
  Springer, 2001, Section 5.2 (the generating function of the billiard map).
* Serge Tabachnikov, *Geometry and Billiards*, Student Mathematical Library 30, American
  Mathematical Society, 2005, Chapter 3 (the chord length as generating function, and the twist
  condition).
-/

public section

noncomputable section

open Function Set Filter Topology Module
open scoped RealInnerProductSpace

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [Fact (finrank ℝ E = 2)]

namespace StrictConvexBilliardTable

variable {o : Orientation ℝ E (Fin 2)} (χ : StrictConvexBilliardTable o)

/-! ### The chord direction -/

/-- The unit vector `(χ(t) - χ(s)) / ‖χ(t) - χ(s)‖` along the chord from `χ(s)` to `χ(t)`. It is
`0` when the two boundary points coincide. -/
def chordDir (s t : ℝ) : E :=
  NormedSpace.normalize (χ t - χ s)

theorem chordDir_def (s t : ℝ) : χ.chordDir s t = NormedSpace.normalize (χ t - χ s) :=
  (rfl)

/-- The chord direction written out: `(χ(t) - χ(s))` scaled by `‖χ(t) - χ(s)‖⁻¹`. -/
theorem chordDir_eq_inv_norm_smul (s t : ℝ) : χ.chordDir s t = ‖χ t - χ s‖⁻¹ • (χ t - χ s) := by
  rw [chordDir_def, NormedSpace.normalize]

/-- The chord direction vanishes exactly when the two boundary points coincide. -/
@[simp]
theorem chordDir_eq_zero_iff {s t : ℝ} : χ.chordDir s t = 0 ↔ χ t = χ s := by
  rw [chordDir_def, NormedSpace.normalize_eq_zero_iff, sub_eq_zero]

/-- Reversing a chord reverses its direction. -/
theorem chordDir_swap (s t : ℝ) : χ.chordDir t s = -χ.chordDir s t := by
  rw [chordDir_def, chordDir_def, ← neg_sub, NormedSpace.normalize_neg]

@[simp]
theorem chordDir_add_period (s t : ℝ) :
    χ.chordDir (s + χ.period) (t + χ.period) = χ.chordDir s t := by
  simp [chordDir_def, χ.periodic s, χ.periodic t]

theorem norm_chordDir {s t : ℝ} (h : χ t ≠ χ s) : ‖χ.chordDir s t‖ = 1 :=
  NormedSpace.norm_normalize (sub_ne_zero.2 h)

/-- The chord direction is differentiable, jointly in both endpoints, at every chord between
distinct boundary points. -/
theorem differentiableAt_chordDir {p : ℝ × ℝ} (h : χ p.2 ≠ χ p.1) :
    DifferentiableAt ℝ (fun q : ℝ × ℝ ↦ χ.chordDir q.1 q.2) p := by
  have hd : DifferentiableAt ℝ (fun q : ℝ × ℝ ↦ χ q.2 - χ q.1) p :=
    ((χ.differentiableAt p.2).comp p differentiableAt_snd).sub
      ((χ.differentiableAt p.1).comp p differentiableAt_fst)
  have hne : χ p.2 - χ p.1 ≠ 0 := sub_ne_zero.2 h
  simp only [chordDir_eq_inv_norm_smul]
  exact ((hd.norm ℝ hne).inv (norm_ne_zero_iff.2 hne)).smul hd

/-- The chord from `χ(s)` to the next collision point of the state `(s, v)` is along its outgoing
velocity. -/
theorem chordDir_nextParam {s v : ℝ} (hv : v ∈ Ioo (-1) 1) :
    χ.chordDir s (χ.nextParam s v) = χ.outgoingDir s v := by
  have hℓ : 0 < ‖χ (χ.nextParam s v) - χ s‖ :=
    norm_pos_iff.2 (sub_ne_zero.2 (χ.apply_nextParam_ne hv))
  rw [chordDir_def, χ.sub_eq_norm_smul_outgoingDir hv, NormedSpace.normalize_smul_of_pos hℓ,
    NormedSpace.normalize_eq_self_of_norm_eq_one (χ.norm_outgoingDir ⟨hv.1.le, hv.2.le⟩)]

/-- A chord between distinct boundary points leaves `χ(s)` into the table: `0 < ω(χ'(s), u)`. -/
theorem areaForm_deriv_chordDir_pos {s t : ℝ} (h : χ t ≠ χ s) :
    0 < o.areaForm (deriv χ s) (χ.chordDir s t) := by
  rw [chordDir_def, NormedSpace.normalize, map_smul, smul_eq_mul]
  exact mul_pos (inv_pos.2 (norm_pos_iff.2 (sub_ne_zero.2 h))) (χ.areaForm_pos _ _ h)

/-- A chord between distinct boundary points arrives at `χ(t)` from inside the table:
`ω(χ'(t), u) < 0`. -/
theorem areaForm_deriv_chordDir_neg {s t : ℝ} (h : χ t ≠ χ s) :
    o.areaForm (deriv χ t) (χ.chordDir s t) < 0 := by
  rw [← neg_neg (χ.chordDir s t), ← chordDir_swap, map_neg, neg_lt_zero]
  exact χ.areaForm_deriv_chordDir_pos h.symm

/-- No chord is tangent to the boundary at its start: its tangential component `⟪χ'(s), u⟫` lies
in `(-1, 1)`. (For coincident endpoints the chord direction is `0`.) -/
theorem inner_deriv_chordDir_mem_Ioo (s t : ℝ) : ⟪deriv χ s, χ.chordDir s t⟫ ∈ Ioo (-1) 1 := by
  by_cases h : χ t = χ s
  · simp [χ.chordDir_eq_zero_iff.2 h]
  exact o.inner_mem_Ioo_of_areaForm_ne_zero (χ.norm_deriv s) (χ.norm_chordDir h)
    (χ.areaForm_deriv_chordDir_pos h).ne'

/-- The chord between distinct boundary points is the outgoing velocity of the state at `χ(s)`
whose tangential component is that of the chord. -/
theorem outgoingDir_inner_deriv_chordDir {s t : ℝ} (h : χ t ≠ χ s) :
    χ.outgoingDir s ⟪deriv χ s, χ.chordDir s t⟫ = χ.chordDir s t := by
  set T := deriv χ s
  set u := χ.chordDir s t
  have hT : ‖T‖ = 1 := χ.norm_deriv s
  have hω : √(1 - ⟪T, u⟫ ^ 2) = o.areaForm T u := by
    rw [o.sqrt_one_sub_inner_sq_eq_abs_areaForm hT (χ.norm_chordDir h),
      abs_of_pos (χ.areaForm_deriv_chordDir_pos h)]
  -- Decompose `u` in the orthonormal basis `T, J T`.
  refine ext_inner_right ℝ fun y ↦ ?_
  have hdec := o.inner_mul_inner_add_areaForm_mul_areaForm T u y
  rw [hT, one_pow, one_mul] at hdec
  rw [outgoingDir_def, hω, inner_add_left, real_inner_smul_left, real_inner_smul_left,
    o.inner_rightAngleRotation_left, hdec]

/-- The tangential component of the chord to the next collision point of the state `(s, v)` is
`v`. -/
theorem inner_deriv_chordDir_nextParam {s v : ℝ} (hv : v ∈ Ioo (-1) 1) :
    ⟪deriv χ s, χ.chordDir s (χ.nextParam s v)⟫ = v := by
  rw [χ.chordDir_nextParam hv, inner_deriv_outgoingDir]

/-- Every boundary point `χ(t)` with `t ∈ (s, s + L)` is the next collision point of the state at
`χ(s)` with the tangential component of the chord. -/
theorem nextParam_inner_deriv_chordDir {s t : ℝ} (ht : t ∈ Ioo s (s + χ.period)) :
    χ.nextParam s ⟪deriv χ s, χ.chordDir s t⟫ = t := by
  have h := χ.apply_ne_of_mem_Ioo ht
  refine (χ.eq_nextParam_of_areaForm_eq_zero (χ.inner_deriv_chordDir_mem_Ioo s t) ht ?_).symm
  rw [χ.outgoingDir_inner_deriv_chordDir h, chordDir_def, NormedSpace.normalize, map_smul,
    LinearMap.smul_apply, o.areaForm_apply_self, smul_zero]

/-! ### The generating function and its first derivatives -/

/-- The generating function `S(s, t) = -‖χ(t) - χ(s)‖` of the billiard map: minus the length of
the chord from `χ(s)` to `χ(t)`. It generates the next-collision map on the window
`s < t < s + L`, where `χ(t) ≠ χ(s)`. -/
def generatingFunction (s t : ℝ) : ℝ :=
  -‖χ t - χ s‖

theorem generatingFunction_def (s t : ℝ) : χ.generatingFunction s t = -‖χ t - χ s‖ :=
  (rfl)

/-- The generating function of the table is the billiard generating function of its
parametrization, `TauCeti.billiardGeneratingFunction`, in curried form. -/
theorem generatingFunction_eq_billiardGeneratingFunction (s t : ℝ) :
    χ.generatingFunction s t = billiardGeneratingFunction χ (s, t) := by
  rw [generatingFunction_def, billiardGeneratingFunction_apply]

/-- The generating function is invariant under translating both arguments by the period. -/
@[simp]
theorem generatingFunction_add_period (s t : ℝ) :
    χ.generatingFunction (s + χ.period) (t + χ.period) = χ.generatingFunction s t := by
  simp [generatingFunction_def, χ.periodic s, χ.periodic t]

/-- The generating function is symmetric: a chord and its reverse have the same length. -/
theorem generatingFunction_swap (s t : ℝ) :
    χ.generatingFunction t s = χ.generatingFunction s t := by
  rw [generatingFunction_def, generatingFunction_def, ← neg_sub, norm_neg]

/-- **The derivative of the generating function in its first argument**:
`∂_s S(s, t) = ⟪χ'(s), u⟫` for the unit vector `u` along the chord, wherever `χ(t) ≠ χ(s)`. -/
theorem hasDerivAt_generatingFunction_left {s t : ℝ} (h : χ t ≠ χ s) :
    HasDerivAt (fun s' ↦ χ.generatingFunction s' t) ⟪deriv χ s, χ.chordDir s t⟫ s := by
  have hd := (hasFDerivAt_norm_of_ne (sub_ne_zero.2 h)).comp_hasDerivAt s
    ((χ.differentiableAt s).hasDerivAt.const_sub (χ t))
  convert hd.neg using 1
  · funext s'
    simp [generatingFunction_def]
  · simp [chordDir_def, NormedSpace.normalize, real_inner_smul_right, real_inner_comm,
      inner_sub_right]
    ring

/-- **The derivative of the generating function in its second argument**:
`∂_t S(s, t) = -⟪χ'(t), u⟫` for the unit vector `u` along the chord, wherever `χ(t) ≠ χ(s)`. -/
theorem hasDerivAt_generatingFunction_right {s t : ℝ} (h : χ t ≠ χ s) :
    HasDerivAt (χ.generatingFunction s) (-⟪deriv χ t, χ.chordDir s t⟫) t := by
  have hd := (hasFDerivAt_norm_of_ne (sub_ne_zero.2 h)).comp_hasDerivAt t
    ((χ.differentiableAt t).hasDerivAt.sub_const (χ s))
  convert hd.neg using 1
  · funext t'
    simp [generatingFunction_def]
  · simp [chordDir_def, NormedSpace.normalize, real_inner_smul_right, real_inner_comm,
      inner_sub_right]

/-- **The generating function recovers the initial state**: at the next collision point
`t` of the state `(s, v)`, `∂_s S(s, t) = v`. -/
theorem deriv_generatingFunction_left_nextParam {s v : ℝ} (hv : v ∈ Ioo (-1) 1) :
    deriv (fun s' ↦ χ.generatingFunction s' (χ.nextParam s v)) s = v := by
  rw [(χ.hasDerivAt_generatingFunction_left (χ.apply_nextParam_ne hv)).deriv,
    χ.inner_deriv_chordDir_nextParam hv]

/-- **The generating function recovers the next state**: at the next collision point `t` of the
state `(s, v)`, with next tangential component `w`, `∂_t S(s, t) = -w`. -/
theorem deriv_generatingFunction_right_nextParam {s v : ℝ} (hv : v ∈ Ioo (-1) 1) :
    deriv (χ.generatingFunction s) (χ.nextParam s v) = -χ.nextTangential s v := by
  rw [(χ.hasDerivAt_generatingFunction_right (χ.apply_nextParam_ne hv)).deriv,
    χ.chordDir_nextParam hv, nextTangential_def, real_inner_comm]

/-- **The generating function generates the next-collision map.** For a tangential component
`v ∈ (-1, 1)` and a parameter `t` in the window `(s, s + L)`, `t` is the next collision parameter of
the state `(s, v)` exactly when `v = ∂_s S(s, t)`. -/
theorem nextParam_eq_iff_deriv_generatingFunction_left_eq {s v t : ℝ} (hv : v ∈ Ioo (-1) 1)
    (ht : t ∈ Ioo s (s + χ.period)) :
    χ.nextParam s v = t ↔ deriv (fun s' ↦ χ.generatingFunction s' t) s = v := by
  rw [(χ.hasDerivAt_generatingFunction_left (χ.apply_ne_of_mem_Ioo ht)).deriv]
  constructor
  · rintro rfl
    exact χ.inner_deriv_chordDir_nextParam hv
  · rintro rfl
    exact χ.nextParam_inner_deriv_chordDir ht

/-! ### The twist condition -/

/-- The derivative in `t` of the inner product of a fixed vector `a` with the chord direction:
`d/dt ⟪a, u⟫ = ω(a, u) ω(χ'(t), u) / ‖χ(t) - χ(s)‖`, wherever `χ(t) ≠ χ(s)`. -/
theorem hasDerivAt_inner_chordDir (a : E) {s t : ℝ} (h : χ t ≠ χ s) :
    HasDerivAt (fun t' ↦ ⟪a, χ.chordDir s t'⟫)
      (‖χ t - χ s‖⁻¹ *
        (o.areaForm a (χ.chordDir s t) * o.areaForm (deriv χ t) (χ.chordDir s t))) t := by
  have hd0 : χ t - χ s ≠ 0 := sub_ne_zero.2 h
  have hn : ‖χ t - χ s‖ ≠ 0 := norm_ne_zero_iff.2 hd0
  have hc : HasDerivAt (fun t' ↦ χ t' - χ s) (deriv χ t) t :=
    (χ.differentiableAt t).hasDerivAt.sub_const _
  -- Differentiate `‖χ(t) - χ(s)‖⁻¹ * ⟪a, χ(t) - χ(s)⟫` by the product rule.
  have hnorm : HasDerivAt (fun t' ↦ ‖χ t' - χ s‖)
      ((‖χ t - χ s‖⁻¹ • innerSL ℝ (χ t - χ s)) (deriv χ t)) t :=
    (hasFDerivAt_norm_of_ne hd0).comp_hasDerivAt t hc
  have hinv := hnorm.inv hn
  have hin := (innerSL ℝ a).hasFDerivAt.comp_hasDerivAt t hc
  convert hinv.mul hin using 1
  · funext t'
    simp [chordDir_def, NormedSpace.normalize, real_inner_smul_right]
  · -- The derivative is `(⟪a, χ'(t)⟫ - ⟪d, a⟫ ⟪d, χ'(t)⟫ / ‖d‖²) / ‖d‖` for `d = χ(t) - χ(s)`,
    -- which is the claimed expression by `⟪d, a⟫ ⟪d, b⟫ + ω(d, a) ω(d, b) = ‖d‖² ⟪a, b⟫`.
    have key := o.inner_mul_inner_add_areaForm_mul_areaForm (χ t - χ s) a (deriv χ t)
    rw [o.areaForm_swap a, o.areaForm_swap (deriv χ t), chordDir_def, NormedSpace.normalize]
    simp only [comp_apply, Pi.inv_apply, _root_.smul_apply, innerSL_apply_apply, smul_eq_mul]
    generalize χ t - χ s = d at key hn ⊢
    rw [real_inner_comm a d] at key
    simp only [map_smul, LinearMap.smul_apply, smul_eq_mul, mul_neg, neg_mul, neg_neg]
    field_simp
    linear_combination key

/-- The mixed partial derivative of the generating function, of either order, at a chord between
distinct boundary points: `ω(χ'(s), u) ω(χ'(t), u) / ‖χ(t) - χ(s)‖`, which is negative. -/
private theorem inv_norm_mul_areaForm_mul_areaForm_neg {s t : ℝ} (h : χ t ≠ χ s) :
    ‖χ t - χ s‖⁻¹ *
      (o.areaForm (deriv χ s) (χ.chordDir s t) * o.areaForm (deriv χ t) (χ.chordDir s t)) < 0 :=
  mul_neg_of_pos_of_neg (inv_pos.2 (norm_pos_iff.2 (sub_ne_zero.2 h)))
    (mul_neg_of_pos_of_neg (χ.areaForm_deriv_chordDir_pos h) (χ.areaForm_deriv_chordDir_neg h))

/-- **The mixed partial derivative `∂_t ∂_s S`** of the generating function at a chord between
distinct boundary points is `ω(χ'(s), u) ω(χ'(t), u) / ‖χ(t) - χ(s)‖`. -/
theorem hasDerivAt_deriv_generatingFunction_left {s t : ℝ} (h : χ t ≠ χ s) :
    HasDerivAt (fun t' ↦ deriv (fun s' ↦ χ.generatingFunction s' t') s)
      (‖χ t - χ s‖⁻¹ *
        (o.areaForm (deriv χ s) (χ.chordDir s t) * o.areaForm (deriv χ t) (χ.chordDir s t))) t := by
  refine (χ.hasDerivAt_inner_chordDir (deriv χ s) h).congr_of_eventuallyEq ?_
  filter_upwards [χ.continuous.continuousAt.eventually_ne h] with t' ht'
  exact (χ.hasDerivAt_generatingFunction_left ht').deriv

/-- **The mixed partial derivative `∂_s ∂_t S`** of the generating function at a chord between
distinct boundary points is `ω(χ'(s), u) ω(χ'(t), u) / ‖χ(t) - χ(s)‖`. -/
theorem hasDerivAt_deriv_generatingFunction_right {s t : ℝ} (h : χ t ≠ χ s) :
    HasDerivAt (fun s' ↦ deriv (χ.generatingFunction s') t)
      (‖χ t - χ s‖⁻¹ *
        (o.areaForm (deriv χ s) (χ.chordDir s t) * o.areaForm (deriv χ t) (χ.chordDir s t))) s := by
  -- `∂_t S(s', t) = -⟪χ'(t), u(s', t)⟫ = ⟪χ'(t), u(t, s')⟫`: the reversed chord, varying its end.
  refine ((χ.hasDerivAt_inner_chordDir (deriv χ t) h.symm).congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards [χ.continuous.continuousAt.eventually_ne h.symm] with s' hs'
    rw [(χ.hasDerivAt_generatingFunction_right hs'.symm).deriv, chordDir_swap, inner_neg_right,
      neg_neg]
  · rw [chordDir_swap, map_neg, map_neg, ← neg_sub, norm_neg]
    ring

/-- **The twist condition**: the mixed partial derivative `∂_t ∂_s S` of the generating function is
negative at every chord between distinct boundary points. -/
theorem deriv_deriv_generatingFunction_left_neg {s t : ℝ} (h : χ t ≠ χ s) :
    deriv (fun t' ↦ deriv (fun s' ↦ χ.generatingFunction s' t') s) t < 0 := by
  rw [(χ.hasDerivAt_deriv_generatingFunction_left h).deriv]
  exact χ.inv_norm_mul_areaForm_mul_areaForm_neg h

/-- **The twist condition**: the mixed partial derivative `∂_s ∂_t S` of the generating function is
negative at every chord between distinct boundary points. -/
theorem deriv_deriv_generatingFunction_right_neg {s t : ℝ} (h : χ t ≠ χ s) :
    deriv (fun s' ↦ deriv (χ.generatingFunction s') t) s < 0 := by
  rw [(χ.hasDerivAt_deriv_generatingFunction_right h).deriv]
  exact χ.inv_norm_mul_areaForm_mul_areaForm_neg h

/-- **The twist at a billiard chord.** At the next collision point `t` of the state `(s, v)`, with
next tangential component `w` and chord length `ℓ`, the mixed partial derivative of the generating
function is `∂_t ∂_s S(s, t) = -√(1 - v²) √(1 - w²) / ℓ`. -/
theorem hasDerivAt_deriv_generatingFunction_left_nextParam {s v : ℝ} (hv : v ∈ Ioo (-1) 1) :
    HasDerivAt (fun t' ↦ deriv (fun s' ↦ χ.generatingFunction s' t') s)
      (-(√(1 - v ^ 2) * √(1 - χ.nextTangential s v ^ 2) / ‖χ (χ.nextParam s v) - χ s‖))
      (χ.nextParam s v) := by
  convert χ.hasDerivAt_deriv_generatingFunction_left (χ.apply_nextParam_ne hv) using 1
  rw [χ.chordDir_nextParam hv, areaForm_deriv_outgoingDir,
    χ.areaForm_deriv_nextParam_outgoingDir hv]
  ring

/-! ### The next collision parameter as a function of the tangential component -/

/-- For fixed `s`, the derivative `∂_s S(s, t)` is strictly decreasing in `t` on the window
`(s, s + L)`. -/
theorem strictAntiOn_deriv_generatingFunction_left (s : ℝ) :
    StrictAntiOn (fun t ↦ deriv (fun s' ↦ χ.generatingFunction s' t) s)
      (Ioo s (s + χ.period)) := by
  refine strictAntiOn_of_deriv_neg (convex_Ioo _ _) (fun t ht ↦ ?_) fun t ht ↦ ?_
  · exact (χ.hasDerivAt_deriv_generatingFunction_left
      (χ.apply_ne_of_mem_Ioo ht)).continuousAt.continuousWithinAt
  · rw [interior_Ioo] at ht
    exact χ.deriv_deriv_generatingFunction_left_neg (χ.apply_ne_of_mem_Ioo ht)

/-- For fixed `s`, the next collision parameter is strictly decreasing in the tangential component
`v ∈ (-1, 1)`: the more the ball is aimed backwards, the further along the boundary it lands. -/
theorem strictAntiOn_nextParam (s : ℝ) : StrictAntiOn (χ.nextParam s) (Ioo (-1) 1) := by
  intro v hv w hw hvw
  by_contra! hle
  have h := (χ.strictAntiOn_deriv_generatingFunction_left s).antitoneOn (χ.nextParam_mem_Ioo hv)
    (χ.nextParam_mem_Ioo hw) hle
  rw [χ.deriv_generatingFunction_left_nextParam hv,
    χ.deriv_generatingFunction_left_nextParam hw] at h
  linarith

/-- For fixed `s`, every parameter of the window `(s, s + L)` is the next collision parameter of
some tangential component `v ∈ (-1, 1)`. -/
theorem image_nextParam_Ioo (s : ℝ) : χ.nextParam s '' Ioo (-1) 1 = Ioo s (s + χ.period) := by
  refine Subset.antisymm ?_ fun t ht ↦ ?_
  · rintro _ ⟨v, hv, rfl⟩
    exact χ.nextParam_mem_Ioo hv
  exact ⟨_, χ.inner_deriv_chordDir_mem_Ioo s t, χ.nextParam_inner_deriv_chordDir ht⟩

/-- For fixed `s`, the next collision parameter depends continuously on the tangential component. -/
theorem continuousOn_nextParam (s : ℝ) : ContinuousOn (χ.nextParam s) (Ioo (-1) 1) := by
  intro v hv
  have ht := χ.nextParam_mem_Ioo (s := s) hv
  -- `-nextParam s` is strictly increasing and maps `(-1, 1)` onto an open interval.
  have hc : ContinuousAt (fun w ↦ -χ.nextParam s w) v := by
    refine (χ.strictAntiOn_nextParam s).neg.continuousAt_of_image_mem_nhds
      (Ioo_mem_nhds hv.1 hv.2) (mem_of_superset (Ioo_mem_nhds (neg_lt_neg ht.2)
        (neg_lt_neg ht.1)) fun y hy ↦ ?_)
    obtain ⟨w, hw, hwy⟩ : -y ∈ χ.nextParam s '' Ioo (-1) 1 := by
      rw [χ.image_nextParam_Ioo]
      exact ⟨by linarith [hy.2], by linarith [hy.1]⟩
    exact ⟨w, hw, by simp [hwy]⟩
  have hc' : ContinuousAt (χ.nextParam s) v := by simpa using hc.neg
  exact hc'.continuousWithinAt

/-- The quotient `ℓ / (√(1 - v²) √(1 - w²))` of the chord length by the sines of the angles of the
chord with the boundary at the state `(s, v)` and at its next collision is positive. -/
private theorem norm_div_sqrt_mul_sqrt_pos {s v : ℝ} (hv : v ∈ Ioo (-1) 1) :
    0 < ‖χ (χ.nextParam s v) - χ s‖ / (√(1 - v ^ 2) * √(1 - χ.nextTangential s v ^ 2)) :=
  div_pos (norm_pos_iff.2 (sub_ne_zero.2 (χ.apply_nextParam_ne hv)))
    (mul_pos (Real.sqrt_one_sub_sq_pos hv) (Real.sqrt_one_sub_sq_pos (χ.nextTangential_mem_Ioo hv)))

/-- **The derivative of the next collision parameter.** For fixed `s`, the next collision
parameter `t` of the state `(s, v)` is differentiable in `v`, with derivative
`∂t/∂v = -ℓ / (√(1 - v²) √(1 - w²))`, where `w` is the next tangential component and `ℓ` the
length of the chord. It is the inverse of the mixed partial derivative of the generating
function. -/
theorem hasDerivAt_nextParam {s v : ℝ} (hv : v ∈ Ioo (-1) 1) :
    HasDerivAt (χ.nextParam s)
      (-(‖χ (χ.nextParam s v) - χ s‖ / (√(1 - v ^ 2) * √(1 - χ.nextTangential s v ^ 2)))) v := by
  -- `v ↦ t` is a continuous local inverse of `t ↦ ∂_s S(s, t)`.
  convert (χ.hasDerivAt_deriv_generatingFunction_left_nextParam hv).of_local_left_inverse
    ((χ.continuousOn_nextParam s).continuousAt (Ioo_mem_nhds hv.1 hv.2))
    (neg_lt_zero.2 (by rw [← inv_div]; exact inv_pos.2 (χ.norm_div_sqrt_mul_sqrt_pos hv))).ne ?_
    using 1
  · rw [inv_neg, inv_div]
  · filter_upwards [Ioo_mem_nhds hv.1 hv.2] with w hw
    exact χ.deriv_generatingFunction_left_nextParam hw

/-- For fixed `s`, the next collision parameter has negative derivative in the tangential
component: `∂t/∂v < 0`. -/
theorem deriv_nextParam_neg {s v : ℝ} (hv : v ∈ Ioo (-1) 1) : deriv (χ.nextParam s) v < 0 := by
  rw [(χ.hasDerivAt_nextParam hv).deriv]
  exact neg_lt_zero.2 (χ.norm_div_sqrt_mul_sqrt_pos hv)

end StrictConvexBilliardTable

end TauCeti
