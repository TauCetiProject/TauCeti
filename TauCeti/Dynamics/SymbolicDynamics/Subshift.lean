module

public import Mathlib.MeasureTheory.Constructions.Cylinders
public import Mathlib.MeasureTheory.Group.Action
public import Mathlib.Topology.Algebra.ConstMulAction
public import Mathlib.Topology.Constructions

/-!
# Subshifts over a group action on an index set

Let a group `Γ` act on an index set `I` and let `S` be a topological space, the alphabet. A
configuration is a function `ω : I → S`, and `Γ` moves configurations by
`(g • ω) i = ω (g⁻¹ • i)`. A *subshift* (`TauCeti.Subshift Γ I S`) is a set of configurations that
is closed for the product topology and invariant under this action.

Mathlib's `SymbolicDynamics.FullShift.MulSubshift S Γ` is the case `I = Γ`, with `Γ` acting on
itself by left multiplication: there `g • ω` is `SymbolicDynamics.FullShift.mulShift g⁻¹ ω`. The
present notion allows an index set with several orbits, such as the edges of a periodic graph
under its translations, which is what configuration spaces of statistical mechanics need.

A subshift is used as the type of its configurations, with the subspace topology, the trace of the
product σ-algebra, and the restricted action, which is by homeomorphisms and measurable maps
(`ContinuousConstSMul`, `MeasurableConstSMul`). For `Λ ⊆ I` we define the *exterior* σ-algebra
`TauCeti.Subshift.exterior X Λ`, the trace on `X` of the σ-algebra generated by the coordinates
outside `Λ` (Mathlib's `MeasureTheory.cylinderEvents Λᶜ`). These are the σ-algebras on which the
kernels of a specification are measurable.
-/

public section

open MeasureTheory Set
open scoped Pointwise

namespace TauCeti

/-- A subshift: a set of configurations `I → S`, closed for the product topology and invariant
under the action `(g • ω) i = ω (g⁻¹ • i)` of `Γ` induced by an action on the index set `I`.
Mathlib's `SymbolicDynamics.FullShift.MulSubshift` is the case `I = Γ`; here `I` may have several
orbits. -/
structure Subshift (Γ I S : Type*) [Group Γ] [MulAction Γ I] [TopologicalSpace S] where
  /-- The configurations. -/
  carrier : Set (I → S)
  /-- The set of configurations is closed for the product topology. -/
  isClosed : IsClosed carrier
  /-- The set of configurations is invariant under the action. -/
  smul_mem' : ∀ (g : Γ) {ω : I → S}, ω ∈ carrier → (fun i => ω (g⁻¹ • i)) ∈ carrier

namespace Subshift

variable {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S]

instance : SetLike (Subshift Γ I S) (I → S) where
  coe := carrier
  coe_injective X Y h := by cases X; cases Y; congr

@[simp]
theorem mem_carrier {X : Subshift Γ I S} {ω : I → S} : ω ∈ X.carrier ↔ ω ∈ X :=
  Iff.rfl

@[simp]
theorem mem_mk {s : Set (I → S)} {hs : IsClosed s}
    {h : ∀ (g : Γ) {ω : I → S}, ω ∈ s → (fun i => ω (g⁻¹ • i)) ∈ s} {ω : I → S} :
    ω ∈ (⟨s, hs, h⟩ : Subshift Γ I S) ↔ ω ∈ s :=
  Iff.rfl

@[simp]
theorem coe_mk {s : Set (I → S)} {hs : IsClosed s}
    {h : ∀ (g : Γ) {ω : I → S}, ω ∈ s → (fun i => ω (g⁻¹ • i)) ∈ s} :
    ((⟨s, hs, h⟩ : Subshift Γ I S) : Set (I → S)) = s :=
  rfl

/-- A subshift is invariant under the action: the field `Subshift.smul_mem'`, stated for membership
in the subshift. -/
theorem smul_mem (X : Subshift Γ I S) (g : Γ) {ω : I → S} (h : ω ∈ X) :
    (fun i => ω (g⁻¹ • i)) ∈ X :=
  X.smul_mem' g h

@[ext]
theorem ext {X Y : Subshift Γ I S} (h : ∀ ω, ω ∈ X ↔ ω ∈ Y) : X = Y :=
  SetLike.ext h

/-- The set of configurations of a subshift is closed. -/
theorem isClosed_coe (X : Subshift Γ I S) : IsClosed (X : Set (I → S)) :=
  X.isClosed

/-- The full shift: all configurations. -/
instance : Top (Subshift Γ I S) :=
  ⟨{ carrier := univ
     isClosed := isClosed_univ
     smul_mem' := fun _ _ _ => mem_univ _ }⟩

@[simp]
theorem mem_top (ω : I → S) : ω ∈ (⊤ : Subshift Γ I S) :=
  mem_univ ω

@[simp]
theorem coe_top : ((⊤ : Subshift Γ I S) : Set (I → S)) = univ :=
  rfl

variable (X : Subshift Γ I S)

/-- `Γ` acts on a subshift by `(g • ω) i = ω (g⁻¹ • i)`. -/
instance : SMul Γ X where
  smul g ω := ⟨fun i => ω.val (g⁻¹ • i), X.smul_mem g ω.property⟩

/-- The action of `Γ` on a subshift is the restriction of Mathlib's `arrowAction`. -/
instance : MulAction Γ X :=
  letI := arrowAction (G := Γ) (A := I) (B := S)
  Subtype.val_injective.mulAction Subtype.val fun _ _ => rfl

variable {X}

@[simp]
theorem coe_smul (g : Γ) (ω : X) : ((g • ω : X) : I → S) = fun i => (ω : I → S) (g⁻¹ • i) :=
  rfl

theorem smul_apply (g : Γ) (ω : X) (i : I) : (g • ω : X).val i = ω.val (g⁻¹ • i) :=
  rfl

/-- Each `ω ↦ g • ω` is continuous, hence a homeomorphism of the subshift. -/
instance : ContinuousConstSMul Γ X where
  continuous_const_smul g := continuous_induced_rng.2 <| continuous_pi fun i =>
    (continuous_apply (g⁻¹ • i)).comp continuous_subtypeVal

variable [MeasurableSpace S]

/-- Each `ω ↦ g • ω` is measurable for the trace of the product σ-algebra: every coordinate of
`g • ω` is a coordinate of `ω`. -/
instance : MeasurableConstSMul Γ X where
  measurable_const_smul g :=
    (Measurable.of_eval (f := fun (ω : X) i => ω.val (g⁻¹ • i)) fun i =>
      (measurable_pi_apply (g⁻¹ • i)).comp measurable_subtypeVal).subtype_mk

variable (X) in
/-- The exterior σ-algebra `𝓕_{Λᶜ}` on a subshift: the trace of the σ-algebra generated by the
coordinates outside `Λ`. -/
@[instance_reducible]
def exterior (Λ : Set I) : MeasurableSpace X :=
  MeasurableSpace.comap Subtype.val (cylinderEvents (X := fun _ : I => S) Λᶜ)

theorem exterior_def (Λ : Set I) :
    X.exterior Λ = MeasurableSpace.comap Subtype.val (cylinderEvents (X := fun _ : I => S) Λᶜ) := by
  rfl

/-- The exterior σ-algebra of any set is coarser than the trace of the product σ-algebra. -/
theorem exterior_le (Λ : Set I) : X.exterior Λ ≤ Subtype.instMeasurableSpace :=
  MeasurableSpace.comap_mono cylinderEvents_le_pi

/-- The exterior σ-algebras decrease as the set grows. -/
theorem exterior_anti {Λ Δ : Set I} (h : Λ ⊆ Δ) : X.exterior Δ ≤ X.exterior Λ :=
  MeasurableSpace.comap_mono (cylinderEvents_mono (compl_subset_compl.2 h))

/-- The exterior σ-algebra of the empty set is the trace of the product σ-algebra. -/
@[simp]
theorem exterior_empty : X.exterior ∅ = Subtype.instMeasurableSpace := by
  rw [exterior_def, compl_empty, cylinderEvents_univ]
  rfl

/-- A coordinate outside `Λ` is measurable for the exterior σ-algebra of `Λ`. -/
theorem measurable_apply_exterior {Λ : Set I} {i : I} (hi : i ∉ Λ) :
    Measurable[X.exterior Λ] fun ω : X => ω.val i :=
  (measurable_cylinderEvent_apply hi).comp (comap_measurable _)

/-- A map into a subshift is measurable for the exterior σ-algebra of `Λ` as soon as each of its
coordinates outside `Λ` is measurable. -/
theorem measurable_exterior_iff {α : Type*} {mα : MeasurableSpace α} {Λ : Set I} {f : α → X} :
    Measurable[mα, X.exterior Λ] f ↔ ∀ i ∉ Λ, Measurable fun a => (f a).val i := by
  rw [exterior_def, measurable_comap_iff, measurable_cylinderEvents_iff]
  exact forall₂_congr fun _ _ => Iff.rfl

/-- The action moves the exterior σ-algebra of `Λ` to that of `g • Λ`: an event depending only on
the coordinates outside `Λ` is moved by `g` to one depending only on the coordinates outside
`g • Λ`. -/
theorem measurable_const_smul_exterior (g : Γ) (Λ : Set I) :
    Measurable[X.exterior Λ, X.exterior (g • Λ)] fun ω : X => g • ω :=
  measurable_exterior_iff.2 fun _ hi =>
    measurable_apply_exterior fun h => hi (Set.mem_smul_set_iff_inv_smul_mem.2 h)

end Subshift

end TauCeti
