/-!
# Words of accelerated branches, delays, renewal counting, and semigroup freeness

A *word* is a finite list `u = [a₁, …, a_m]` of letters `a = (A, j)` of the accelerated branches
`F_a` on the ordered simplex. Words act *chronologically*: the first letter acts first, so
`F_u = F_{a_m} ∘ ⋯ ∘ F_{a₁}`, and the *delay* of `u` at `w` is the sum of the delays
`τ_a = log q_a` collected along the orbit,
`T_u (w) = τ_{a₁} (w) + τ_{a₂} (F_{a₁} w) + ⋯ + τ_{a_m} (F_{a_{m-1}} ⋯ F_{a₁} w)`.
Homogeneously, `T_u (w) = log ((γ_u y)_n / y_n)` for the linear map
`γ_u = γ_{a_m} ⋯ γ_{a₁}` of the accelerated generators and any `y` in the ordered cone over `w`,
so `T_u` measures the growth of the last coordinate along the orbit of the semigroup.

The *renewal count* `N (w, r)` is the number of words, the empty word included, whose delay at
`w` is at most `r`. Since every delay is at least `log (3 / 2)` and a letter with large `A` has a
large delay, only finitely many words contribute for each `r`. Splitting the nonempty words by
their first letter gives the renewal equation
`N (w, r) = 1{r ≥ 0} + ∑_a N (F_a w, r - τ_a (w))`, which is the starting point for the
asymptotic count of the orbit through the transfer operators `L_s f = ∑_a q_a^{-s} f ∘ F_a`.
We also prove freeness of both the unaccelerated linear semigroup (for `1 ≤ d`) and the
accelerated semigroup `wordMove` (for every `d : ℕ`), identifying `Set.range wordMove` with the
submonoid generated by `accelMove` and rewriting `N (simplexChart y, r)` directly over those
linear maps.

## Main definitions

* `TauCeti.wordMap u x`: the map `F_u` of the word `u`, read chronologically.
* `TauCeti.wordDelay u x`: the delay `T_u (w)`.
* `TauCeti.wordMove u`: the linear map `γ_u = γ_{a_m} ⋯ γ_{a₁}` of `ℝ^{d+2}`.
* `TauCeti.unaccelWordMove js`: the chronological linear map of an unaccelerated word in
  `Fin (d + 1)`.
* `TauCeti.wordCount d x r`: the renewal count `N (w, r)`.
* `TauCeti.expandWord u`: expansion of an accelerated word into its unaccelerated word.

## Main results

* `TauCeti.wordMap_append`, `TauCeti.wordDelay_append`, `TauCeti.wordMove_append`: the
  concatenation rules `F_{u ++ v} = F_v ∘ F_u`, `T_{u ++ v} (w) = T_u (w) + T_v (F_u w)` and
  `γ_{u ++ v} = γ_v γ_u`.
* `TauCeti.contDiffOn_wordMap`, `TauCeti.contDiffOn_wordDelay`: smoothness on `orderedSimplex d`.
* `TauCeti.wordMove_of_mem_orderedCone`, `TauCeti.wordDelay_simplexChart`,
  `TauCeti.wordCount_simplexChart_smul`: the homogeneous identity
  `γ_u y = y_n e^{T_u (w)} (F_u (w), 1)`, `T_u (w) = log ((γ_u y)_n / y_n)`, and scale invariance.
* `TauCeti.length_mul_log_le_wordDelay`, `TauCeti.fst_add_three_le_two_mul_exp_wordDelay`: on the
  simplex `T_u (w) ≥ |u| log (3 / 2)`, and every letter `(A, j)` of `u` has
  `A + 3 ≤ 2 e^{T_u (w)}`.
* `TauCeti.finite_setOf_wordDelay_le`: only finitely many words have delay at most `r`.
* `TauCeti.wordCount_mono`, `TauCeti.continuousWithinAt_wordCount_Ici`,
  `TauCeti.measurable_wordCount`, `TauCeti.wordCount_eq_zero_of_neg`, `TauCeti.wordCount_eq_one`,
  `TauCeti.wordCount_eq_sum_indicator`: properties of `N (w, ·)`.
* `TauCeti.mem_support_wordCount_branchMap_iff`, `TauCeti.finite_support_wordCount_branchMap`,
  `TauCeti.wordCount_eq_add_finsum`, `TauCeti.wordCount_eq_add_tsum`: the renewal equation, a
  finite sum at each `r`.
* `TauCeti.unaccelWordMove_injective`, `TauCeti.expandWord_injective`,
  `TauCeti.wordMove_injective`, `TauCeti.range_wordMove`, `TauCeti.wordCount_simplexChart_eq`:
  semigroup freeness and the homogeneous renewal count formula.

## References

* A. Gamburd, M. Magee, R. Ronan, *An asymptotic formula for integer points on Markoff–Hurwitz
  varieties*, Ann. of Math. 190 (2019), (1.7), (4.1), p. 756 and footnote 5.
-/

public section

open Set Filter Topology
open scoped ContDiff

namespace TauCeti

variable {d : ℕ}

/-! ### Word maps, delays, and linear moves -/

/-- The map `F_u` of a word read chronologically: the first letter acts first,
`F_{a :: u} = F_u ∘ F_a`, and the empty word acts as the identity. -/
noncomputable def wordMap : List (ℕ × Fin d) → (Fin d → ℝ) → Fin d → ℝ
  | [], x => x
  | a :: u, x => wordMap u (branchMap a x)

@[simp]
theorem wordMap_nil (x : Fin d → ℝ) : wordMap [] x = x :=
  (rfl)

@[simp]
theorem wordMap_cons (a : ℕ × Fin d) (u : List (ℕ × Fin d)) (x : Fin d → ℝ) :
    wordMap (a :: u) x = wordMap u (branchMap a x) :=
  (rfl)

theorem wordMap_singleton (a : ℕ × Fin d) (x : Fin d → ℝ) :
    wordMap [a] x = branchMap a x :=
  (rfl)

/-- Concatenation of words composes their maps chronologically: `F_{u ++ v} = F_v ∘ F_u`. -/
@[simp]
theorem wordMap_append (u v : List (ℕ × Fin d)) (x : Fin d → ℝ) :
    wordMap (u ++ v) x = wordMap v (wordMap u x) := by
  induction u generalizing x with
  | nil => simp
  | cons a u ih => simp [ih]

/-- Every word map sends the ordered simplex into itself. -/
theorem wordMap_mem_orderedSimplex (u : List (ℕ × Fin d)) {x : Fin d → ℝ}
    (hx : x ∈ orderedSimplex d) : wordMap u x ∈ orderedSimplex d := by
  induction u generalizing x with
  | nil => exact hx
  | cons a _ ih => exact ih (branchMap_mem_orderedSimplex a hx)

/-- Every word map sends the ordered simplex into itself. -/
theorem mapsTo_wordMap (u : List (ℕ × Fin d)) :
    MapsTo (wordMap u) (orderedSimplex d) (orderedSimplex d) :=
  fun _ hx => wordMap_mem_orderedSimplex u hx

/-- Every word map is smooth on `orderedSimplex d`. -/
theorem contDiffOn_wordMap (u : List (ℕ × Fin d)) (n : WithTop ℕ∞) :
    ContDiffOn ℝ n (wordMap u) (orderedSimplex d) := by
  induction u with
  | nil => exact contDiffOn_id
  | cons a u ih =>
    exact ih.comp (contDiffOn_branchMap a) (mapsTo_branchMap a)

/-- The delay `T_u (w)` of a word read chronologically: the empty word has delay `0`, and
`T_{a :: u} (w) = log q_a (w) + T_u (F_a w)`. -/
noncomputable def wordDelay : List (ℕ × Fin d) → (Fin d → ℝ) → ℝ
  | [], _ => 0
  | a :: u, x => Real.log (branchDenom a x) + wordDelay u (branchMap a x)

@[simp]
theorem wordDelay_nil (x : Fin d → ℝ) : wordDelay [] x = 0 :=
  (rfl)

@[simp]
theorem wordDelay_cons (a : ℕ × Fin d) (u : List (ℕ × Fin d)) (x : Fin d → ℝ) :
    wordDelay (a :: u) x = Real.log (branchDenom a x) + wordDelay u (branchMap a x) :=
  (rfl)

theorem wordDelay_singleton (a : ℕ × Fin d) (x : Fin d → ℝ) :
    wordDelay [a] x = Real.log (branchDenom a x) := by
  simp

/-- The delay of a concatenation: `T_{u ++ v} (w) = T_u (w) + T_v (F_u w)`. -/
@[simp]
theorem wordDelay_append (u v : List (ℕ × Fin d)) (x : Fin d → ℝ) :
    wordDelay (u ++ v) x = wordDelay u x + wordDelay v (wordMap u x) := by
  induction u generalizing x with
  | nil => simp
  | cons a u ih => simp [ih, add_assoc]

/-- Every word delay is smooth on `orderedSimplex d`. -/
theorem contDiffOn_wordDelay (u : List (ℕ × Fin d)) (n : WithTop ℕ∞) :
    ContDiffOn ℝ n (wordDelay u) (orderedSimplex d) := by
  induction u with
  | nil => exact contDiffOn_const
  | cons a u ih =>
    have hcons : wordDelay (a :: u) = fun x => branchDelay a x + wordDelay u (branchMap a x) := by
      ext x; simp [branchDelay_def]
    rw [hcons]
    exact (contDiffOn_branchDelay a).add (ih.comp (contDiffOn_branchMap a) (mapsTo_branchMap a))

/-- On the simplex every letter contributes a delay of at least `log (3 / 2)`, so
`T_u (w) ≥ |u| log (3 / 2)`. -/
theorem length_mul_log_le_wordDelay (u : List (ℕ × Fin d)) {x : Fin d → ℝ}
    (hx : x ∈ orderedSimplex d) : u.length * Real.log (3 / 2) ≤ wordDelay u x := by
  induction u generalizing x with
  | nil => simp
  | cons a u ih =>
    have h₁ := log_three_halves_le_log_branchDenom a (le_one_half_of_mem_orderedSimplex hx a.2)
    have h₂ := ih (branchMap_mem_orderedSimplex a hx)
    simp only [wordDelay_cons, List.length_cons, Nat.cast_succ]
    linarith

/-- Delays are nonnegative on the simplex. -/
theorem wordDelay_nonneg (u : List (ℕ × Fin d)) {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    0 ≤ wordDelay u x :=
  (mul_nonneg u.length.cast_nonneg (Real.log_nonneg (by norm_num))).trans
    (length_mul_log_le_wordDelay u hx)

/-- Every nonempty word has delay at least `log (3 / 2)` on `orderedSimplex d`. -/
theorem log_three_halves_le_wordDelay_of_ne_nil {u : List (ℕ × Fin d)} (hu : u ≠ [])
    {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    Real.log (3 / 2) ≤ wordDelay u x := by
  have hlen : (1 : ℝ) ≤ (u.length : ℝ) := by exact_mod_cast List.length_pos_iff.2 hu
  have hlog : 0 ≤ Real.log (3 / 2) := (Real.log_pos (by norm_num)).le
  calc Real.log (3 / 2)
      = 1 * Real.log (3 / 2) := (one_mul _).symm
    _ ≤ (u.length : ℝ) * Real.log (3 / 2) := mul_le_mul_of_nonneg_right hlen hlog
    _ ≤ wordDelay u x := length_mul_log_le_wordDelay u hx

/-- Every nonempty word has strictly positive delay on `orderedSimplex d`. -/
theorem wordDelay_pos_of_ne_nil {u : List (ℕ × Fin d)} (hu : u ≠ [])
    {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    0 < wordDelay u x :=
  (Real.log_pos (by norm_num)).trans_le (log_three_halves_le_wordDelay_of_ne_nil hu hx)

/-- Every letter `(A, j)` occurring in `u` satisfies `log ((A + 3) / 2) ≤ T_u (w)` on
`orderedSimplex d`. -/
theorem log_le_wordDelay_of_mem {u : List (ℕ × Fin d)} {a : ℕ × Fin d} (ha : a ∈ u)
    {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    Real.log (((a.1 : ℝ) + 3) / 2) ≤ wordDelay u x := by
  induction u generalizing x with
  | nil => simp at ha
  | cons b v ih =>
    rw [wordDelay_cons, ← branchDelay_def]
    rcases List.mem_cons.1 ha with rfl | hv
    · linarith [log_le_branchDelay a hx, wordDelay_nonneg v (branchMap_mem_orderedSimplex a hx)]
    · linarith [(branchDelay_pos b hx).le, ih hv (branchMap_mem_orderedSimplex b hx)]

/-- On the simplex every letter `(A, j)` of a word `u` satisfies `A + 3 ≤ 2 e^{T_u (w)}`: its
own delay is at least `log ((A + 3) / 2)`, and the other delays are nonnegative. -/
theorem fst_add_three_le_two_mul_exp_wordDelay {u : List (ℕ × Fin d)} {a : ℕ × Fin d}
    (ha : a ∈ u) {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    (a.1 : ℝ) + 3 ≤ 2 * Real.exp (wordDelay u x) := by
  induction u generalizing x with
  | nil => simp at ha
  | cons b u ih =>
    have hb := wordDelay_nonneg u (branchMap_mem_orderedSimplex b hx)
    have hq := branchDenom_pos_of_mem_orderedSimplex b hx
    rw [wordDelay_cons, Real.exp_add, Real.exp_log hq]
    rcases List.mem_cons.mp ha with rfl | ha
    · have h := add_three_div_two_le_branchDenom a (le_one_half_of_mem_orderedSimplex hx a.2)
      have := le_mul_of_one_le_right hq.le (Real.one_le_exp hb)
      linarith
    · have h := ih ha (branchMap_mem_orderedSimplex b hx)
      have := le_mul_of_one_le_left (Real.exp_pos (wordDelay u (branchMap b x))).le
        (one_le_branchDenom b ((le_one_half_of_mem_orderedSimplex hx b.2).trans (by norm_num)))
      linarith

/-! ### The homogeneous meaning of the delay -/

/-- The linear map `γ_u = γ_{a_m} ⋯ γ_{a₁}` of the word `u = [a₁, …, a_m]`, where the letter
`a = (A, j)` stands for the accelerated generator `γ_{n-1}^A γ_j`: the empty word gives the
identity, and `γ_{a :: u} = γ_u γ_{n-1}^A γ_j`. -/
noncomputable def wordMove : List (ℕ × Fin d) → Module.End ℝ (Fin (d + 2) → ℝ)
  | [] => 1
  | a :: u => wordMove u * (linearMove (Fin.last d) ^ a.1 * linearMove a.2.castSucc)

/-- The chronological linear move of an unaccelerated word in `Fin (d + 1)`. -/
noncomputable def unaccelWordMove : List (Fin (d + 1)) → Module.End ℝ (Fin (d + 2) → ℝ)
  | [] => 1
  | j :: js => unaccelWordMove js * linearMove j

@[simp]
theorem wordMove_nil : wordMove ([] : List (ℕ × Fin d)) = 1 :=
  (rfl)

@[simp]
theorem wordMove_cons (a : ℕ × Fin d) (u : List (ℕ × Fin d)) :
    wordMove (a :: u) = wordMove u * (linearMove (Fin.last d) ^ a.1 * linearMove a.2.castSucc) :=
  (rfl)

theorem wordMove_singleton (a : ℕ × Fin d) : wordMove [a] = accelMove a := by
  rw [wordMove_cons, wordMove_nil, one_mul, accelMove_def, Module.End.mul_eq_comp]

@[simp]
theorem unaccelWordMove_nil : unaccelWordMove ([] : List (Fin (d + 1))) = 1 :=
  (rfl)

@[simp]
theorem unaccelWordMove_cons (j : Fin (d + 1)) (js : List (Fin (d + 1))) :
    unaccelWordMove (j :: js) = unaccelWordMove js * linearMove j :=
  (rfl)

theorem unaccelWordMove_singleton (j : Fin (d + 1)) :
    unaccelWordMove [j] = linearMove j := by
  simp

/-- Concatenation of words multiplies their linear maps in reverse order:
`γ_{u ++ v} = γ_v γ_u`. -/
@[simp]
theorem wordMove_append (u v : List (ℕ × Fin d)) :
    wordMove (u ++ v) = wordMove v * wordMove u := by
  induction u with
  | nil => simp
  | cons a u ih => simp [ih, mul_assoc]

/-- Concatenation law for unaccelerated linear word moves. -/
@[simp]
theorem unaccelWordMove_append (js₁ js₂ : List (Fin (d + 1))) :
    unaccelWordMove (js₁ ++ js₂) = unaccelWordMove js₂ * unaccelWordMove js₁ := by
  induction js₁ with
  | nil => simp
  | cons j js₁ ih => simp [ih, mul_assoc]

/-- Every unaccelerated linear word move preserves `orderedCone d`. -/
theorem unaccelWordMove_mapsTo_orderedCone (js : List (Fin (d + 1))) :
    MapsTo (unaccelWordMove js) (orderedCone d) (orderedCone d) := by
  induction js with
  | nil => exact mapsTo_id _
  | cons j _ ih => exact ih.comp (linearMove_mapsTo_orderedCone j)

/-- **The homogeneous identity** for words in chart coordinates:
`γ_u (w, 1) = e^{T_u (w)} (F_u (w), 1)` on the simplex. -/
theorem wordMove_simplexLift (u : List (ℕ × Fin d)) {x : Fin d → ℝ}
    (hx : x ∈ orderedSimplex d) :
    wordMove u (simplexLift x) = Real.exp (wordDelay u x) • simplexLift (wordMap u x) := by
  induction u generalizing x with
  | nil => simp
  | cons a u ih =>
    have hq := branchDenom_pos_of_mem_orderedSimplex a hx
    simp [linearMove_last_pow_linearMove_simplexLift a hq.ne',
      ih (branchMap_mem_orderedSimplex a hx), smul_smul, Real.exp_add, Real.exp_log hq]

/-- **The homogeneous identity** for words on the ordered cone: for `y ∈ H_n` over `w`,
`γ_u y = y_n e^{T_u (w)} (F_u (w), 1)`. -/
theorem wordMove_of_mem_orderedCone (u : List (ℕ × Fin d)) {y : Fin (d + 2) → ℝ}
    (hy : y ∈ orderedCone d) :
    wordMove u y = (y (Fin.last _) * Real.exp (wordDelay u (simplexChart y))) •
      simplexLift (wordMap u (simplexChart y)) := by
  conv_lhs => rw [← last_smul_simplexLift_simplexChart hy]
  rw [map_smul, wordMove_simplexLift u (simplexChart_mem_orderedSimplex hy), smul_smul]

/-- The last coordinate of `γ_u y` on `orderedCone d` equals `y_n exp(T_u(simplexChart y))`. -/
theorem wordMove_last_eq (u : List (ℕ × Fin d)) {y : Fin (d + 2) → ℝ}
    (hy : y ∈ orderedCone d) :
    wordMove u y (Fin.last (d + 1)) =
      y (Fin.last (d + 1)) * Real.exp (wordDelay u (simplexChart y)) := by
  rw [wordMove_of_mem_orderedCone u hy]
  simp

/-- The linear map of every word maps the ordered cone into itself. -/
theorem wordMove_mem_orderedCone (u : List (ℕ × Fin d)) {y : Fin (d + 2) → ℝ}
    (hy : y ∈ orderedCone d) : wordMove u y ∈ orderedCone d := by
  rw [wordMove_of_mem_orderedCone u hy]
  exact smul_mem_orderedCone
    (simplexLift_mem_orderedCone
      (wordMap_mem_orderedSimplex u (simplexChart_mem_orderedSimplex hy)))
    (mul_pos (pos_last_of_mem_orderedCone hy) (Real.exp_pos _))

/-- Every accelerated linear word move preserves `orderedCone d`. -/
theorem wordMove_mapsTo_orderedCone (u : List (ℕ × Fin d)) :
    MapsTo (wordMove u) (orderedCone d) (orderedCone d) :=
  fun _ hy => wordMove_mem_orderedCone u hy

/-- The word map `F_u` is the projective action of `γ_u` on the ordered cone. -/
theorem simplexChart_wordMove (u : List (ℕ × Fin d)) {y : Fin (d + 2) → ℝ}
    (hy : y ∈ orderedCone d) : simplexChart (wordMove u y) = wordMap u (simplexChart y) := by
  rw [wordMove_of_mem_orderedCone u hy,
    simplexChart_smul _ (mul_pos (pos_last_of_mem_orderedCone hy) (Real.exp_pos _)).ne',
    simplexChart_simplexLift]

/-- The delay of a word is the logarithmic growth of the last coordinate along the orbit:
`T_u (w) = log ((γ_u y)_n / y_n)` for every `y` in the ordered cone over `w`. -/
theorem wordDelay_simplexChart (u : List (ℕ × Fin d)) {y : Fin (d + 2) → ℝ}
    (hy : y ∈ orderedCone d) :
    wordDelay u (simplexChart y) = Real.log (wordMove u y (Fin.last _) / y (Fin.last _)) := by
  rw [wordMove_of_mem_orderedCone u hy]
  simp [(pos_last_of_mem_orderedCone hy).ne']

/-! ### The renewal count -/

/-- The renewal count `N (w, r)`: the number of words, the empty word included, whose delay at
`w` is at most `r`. On the simplex only finitely many words contribute
(`TauCeti.finite_setOf_wordDelay_le`). -/
noncomputable def wordCount (d : ℕ) (x : Fin d → ℝ) (r : ℝ) : ℕ :=
  {u : List (ℕ × Fin d) | wordDelay u x ≤ r}.ncard

theorem wordCount_def (d : ℕ) (x : Fin d → ℝ) (r : ℝ) :
    wordCount d x r = {u : List (ℕ × Fin d) | wordDelay u x ≤ r}.ncard :=
  (rfl)

/-- Scale invariance of the renewal count under nonzero scaling of a homogeneous vector. -/
theorem wordCount_simplexChart_smul {c : ℝ} (hc : c ≠ 0) (y : Fin (d + 2) → ℝ) (r : ℝ) :
    wordCount d (simplexChart (c • y)) r = wordCount d (simplexChart y) r := by
  rw [simplexChart_smul y hc]

/-- Only finitely many letters `(A, j)` have `A + 3 ≤ c`. -/
private theorem finite_setOf_fst_add_three_le (c : ℝ) :
    {a : ℕ × Fin d | (a.1 : ℝ) + 3 ≤ c}.Finite :=
  ((finite_Iic ⌊c⌋₊).prod finite_univ).subset fun a ha =>
    ⟨Nat.le_floor (by linarith [show (a.1 : ℝ) + 3 ≤ c from ha]), mem_univ _⟩

/-- On the simplex only finitely many words have delay at most `r`: such a word has length at
most `r / log (3 / 2)`, and each of its letters `(A, j)` has `A + 3 ≤ 2 e^r`. -/
theorem finite_setOf_wordDelay_le {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) (r : ℝ) :
    {u : List (ℕ × Fin d) | wordDelay u x ≤ r}.Finite := by
  set T := {a : ℕ × Fin d | (a.1 : ℝ) + 3 ≤ 2 * Real.exp r}
  have : Finite T := (finite_setOf_fst_add_three_le _).to_subtype
  refine ((List.finite_length_le T ⌊r / Real.log (3 / 2)⌋₊).image
    (List.map Subtype.val)).subset fun u (hu : wordDelay u x ≤ r) => ?_
  have hT : ∀ a ∈ u, a ∈ T := fun a ha =>
    (fst_add_three_le_two_mul_exp_wordDelay ha hx).trans (by gcongr)
  lift u to List T using hT
  refine ⟨u, mem_ofPred.mpr ?_, rfl⟩
  have hlen := length_mul_log_le_wordDelay (u.map Subtype.val) hx
  rw [List.length_map] at hlen
  exact Nat.le_floor ((le_div_iff₀ (Real.log_pos (by norm_num))).mpr (hlen.trans hu))

/-- The renewal count vanishes at negative times. -/
theorem wordCount_eq_zero_of_neg {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) {r : ℝ}
    (hr : r < 0) : wordCount d x r = 0 := by
  rw [wordCount_def, ncard_eq_zero (finite_setOf_wordDelay_le hx r)]
  exact eq_empty_of_forall_notMem fun u (hu : wordDelay u x ≤ r) =>
    (wordDelay_nonneg u hx).not_gt (hu.trans_lt hr)

/-- Before the first delay only the empty word counts: `N (w, r) = 1` for
`0 ≤ r < log (3 / 2)`. -/
theorem wordCount_eq_one {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) {r : ℝ} (h₀ : 0 ≤ r)
    (hr : r < Real.log (3 / 2)) : wordCount d x r = 1 := by
  rw [wordCount_def, ncard_eq_one]
  refine ⟨[], eq_singleton_iff_unique_mem.mpr ⟨by simpa using h₀, fun u hu => ?_⟩⟩
  cases u with
  | nil => rfl
  | cons a u =>
    have h := length_mul_log_le_wordDelay (a :: u) hx
    simp only [mem_ofPred_eq] at hu
    simp only [List.length_cons, Nat.cast_succ] at h
    nlinarith [u.length.cast_nonneg (α := ℝ)]

/-- At `r = 0`, `wordCount d x 0 = 1` on `orderedSimplex d`. -/
@[simp]
theorem wordCount_zero {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    wordCount d x 0 = 1 :=
  wordCount_eq_one hx le_rfl (Real.log_pos (by norm_num))

/-- The renewal count is nondecreasing in time. -/
theorem wordCount_mono {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    Monotone (wordCount d x) := fun r _ h =>
  ncard_le_ncard (fun _ (hu : _ ≤ r) => hu.trans h) (finite_setOf_wordDelay_le hx _)

/-- Below any cutoff `R`, `wordCount d x r` is a finite sum of indicators of `[T_u (w), ∞)`. -/
theorem wordCount_eq_sum_indicator {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d)
    {R r : ℝ} (hr : r ≤ R) :
    wordCount d x r =
      ∑ u ∈ (finite_setOf_wordDelay_le hx R).toFinset, if wordDelay u x ≤ r then 1 else 0 := by
  classical
  rw [wordCount_def, Set.ncard_eq_toFinset_card _ (finite_setOf_wordDelay_le hx r),
    ← Finset.card_filter]
  congr 1; ext u
  simp only [Set.Finite.mem_toFinset, mem_ofPred_eq, Finset.mem_filter]
  exact ⟨fun h => ⟨h.trans hr, h⟩, fun h => h.2⟩

/-- The renewal count `r ↦ wordCount d x r` is locally constant on the right at every `r : ℝ`. -/
theorem eventually_wordCount_eq_of_Ici {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) (r : ℝ) :
    ∃ δ > 0, ∀ r' ∈ Ico r (r + δ), wordCount d x r' = wordCount d x r := by
  let S : Set (List (ℕ × Fin d)) := {u | r < wordDelay u x ∧ wordDelay u x ≤ r + 1}
  have hSfin : S.Finite := (finite_setOf_wordDelay_le hx (r + 1)).subset fun _ hu => hu.2
  have hgap : ∃ δ > 0, ∀ u, r < wordDelay u x → r + δ ≤ wordDelay u x := by
    by_cases hS : S.Nonempty
    · classical
      let T : Finset ℝ := hSfin.toFinset.image fun u => wordDelay u x
      have hT : T.Nonempty := by
        rcases hS with ⟨u, hu⟩
        exact ⟨_, Finset.mem_image_of_mem _ (hSfin.mem_toFinset.2 hu)⟩
      have hm_gt : r < T.min' hT := by
        rcases Finset.mem_image.1 (Finset.min'_mem T hT) with ⟨u, hu, hmu⟩
        exact hmu ▸ (hSfin.mem_toFinset.1 hu).1
      refine ⟨min 1 (T.min' hT - r), lt_min zero_lt_one (sub_pos.2 hm_gt), fun u hu => ?_⟩
      by_cases h1 : wordDelay u x ≤ r + 1
      · have := Finset.min'_le T _ (Finset.mem_image_of_mem _ (hSfin.mem_toFinset.2 ⟨hu, h1⟩))
        linarith [min_le_right 1 (T.min' hT - r)]
      · linarith [min_le_left 1 (T.min' hT - r)]
    · rw [Set.not_nonempty_iff_eq_empty] at hS
      refine ⟨1, zero_lt_one, fun u hu => by_contra fun h => ?_⟩
      have hmem : u ∈ S := ⟨hu, le_of_not_ge h⟩
      rw [hS] at hmem
      exact hmem
  rcases hgap with ⟨δ, hδ, hno⟩
  refine ⟨δ, hδ, fun r' hr' => ?_⟩
  rw [wordCount_def, wordCount_def]
  congr 1; ext u
  simp only [mem_ofPred_eq]
  exact ⟨fun hu => by_contra fun hlt => by linarith [hno u (not_le.1 hlt), hr'.2],
    fun hu => hu.trans hr'.1⟩

/-- The renewal count is right-continuous in time: it is locally constant to the right of each
`r`, since only finitely many delays lie in `(r, r + 1]`. -/
theorem continuousWithinAt_wordCount_Ici {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) (r : ℝ) :
    ContinuousWithinAt (wordCount d x) (Ici r) r := by
  rcases eventually_wordCount_eq_of_Ici hx r with ⟨δ, hδ, hconst⟩
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Ico_mem_nhdsGE (lt_add_of_pos_right r hδ)] with t ht
  exact (hconst t ht).symm

/-- The real-valued renewal count `r ↦ (wordCount d x r : ℝ)` is right-continuous at every
`r : ℝ`. -/
theorem continuousWithinAt_wordCount_Ici_real {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d)
    (r : ℝ) :
    ContinuousWithinAt (fun t => (wordCount d x t : ℝ)) (Ici r) r := by
  rcases eventually_wordCount_eq_of_Ici hx r with ⟨δ, hδ, hconst⟩
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Ico_mem_nhdsGE (lt_add_of_pos_right r hδ)] with t ht
  exact congrArg Nat.cast (hconst t ht).symm

/-- The renewal count is a measurable function of time. -/
theorem measurable_wordCount {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    Measurable (wordCount d x) :=
  (wordCount_mono hx).measurable

/-- The real-valued renewal count `r ↦ (wordCount d x r : ℝ)` is Borel measurable on `ℝ`. -/
theorem measurable_wordCount_real {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    Measurable fun r => (wordCount d x r : ℝ) :=
  (Nat.mono_cast.comp (wordCount_mono hx)).measurable

/-- Exact membership criterion for the support of the renewal sum at `(x, r)`. -/
theorem mem_support_wordCount_branchMap_iff {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d)
    (r : ℝ) (a : ℕ × Fin d) :
    a ∈ Function.support (fun a : ℕ × Fin d =>
      wordCount d (branchMap a x) (r - Real.log (branchDenom a x))) ↔
      Real.log (branchDenom a x) ≤ r := by
  simp only [Function.mem_support, ne_eq]
  refine ⟨fun hne => ?_, fun ha => ?_⟩
  · rw [wordCount_def] at hne
    obtain ⟨v, hv⟩ := Set.nonempty_of_ncard_ne_zero hne
    rw [mem_ofPred_eq] at hv
    linarith [wordDelay_nonneg v (branchMap_mem_orderedSimplex a hx)]
  · rw [wordCount_def]
    have hnil : ([] : List (ℕ × Fin d)) ∈
        {v | wordDelay v (branchMap a x) ≤ r - Real.log (branchDenom a x)} := by
      simp [sub_nonneg.2 ha]
    exact Set.ncard_ne_zero_of_mem hnil
      (finite_setOf_wordDelay_le (branchMap_mem_orderedSimplex a hx) _)

/-- A letter `a` contributes to the renewal equation at time `r` only if `A + 3 ≤ 2 e^r`. -/
private theorem fst_add_three_le_of_wordCount_ne_zero {x : Fin d → ℝ}
    (hx : x ∈ orderedSimplex d) {r : ℝ} {a : ℕ × Fin d}
    (h : wordCount d (branchMap a x) (r - Real.log (branchDenom a x)) ≠ 0) :
    (a.1 : ℝ) + 3 ≤ 2 * Real.exp r := by
  obtain ⟨u, hu⟩ := nonempty_of_ncard_ne_zero h
  have hu' : wordDelay (a :: u) x ≤ r := by
    simp only [mem_ofPred_eq] at hu
    rw [wordDelay_cons]
    linarith
  exact (fst_add_three_le_two_mul_exp_wordDelay (u := a :: u) (by simp) hx).trans (by gcongr)

/-- At each time only finitely many letters contribute to the renewal equation. -/
theorem finite_support_wordCount_branchMap {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d)
    (r : ℝ) :
    (Function.support fun a : ℕ × Fin d =>
      wordCount d (branchMap a x) (r - Real.log (branchDenom a x))).Finite :=
  (finite_setOf_fst_add_three_le (2 * Real.exp r)).subset fun _ ha =>
    fst_add_three_le_of_wordCount_ne_zero hx ha

/-- **The renewal equation** `N (w, r) = 1{r ≥ 0} + ∑_a N (F_a w, r - τ_a (w))` on the simplex:
the empty word counts exactly when `r ≥ 0`, and a nonempty word `a :: u` counts exactly when `u`
counts at `F_a w` with the delay `τ_a (w)` subtracted. The sum is finite
(`TauCeti.finite_support_wordCount_branchMap`). -/
theorem wordCount_eq_add_finsum {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) (r : ℝ) :
    wordCount d x r = (if 0 ≤ r then 1 else 0) +
      ∑ᶠ a : ℕ × Fin d, wordCount d (branchMap a x) (r - Real.log (branchDenom a x)) := by
  set T := {a : ℕ × Fin d | (a.1 : ℝ) + 3 ≤ 2 * Real.exp r}
  have hT : T.Finite := finite_setOf_fst_add_three_le _
  set S : ℕ × Fin d → Set (List (ℕ × Fin d)) := fun a =>
    {u | wordDelay u (branchMap a x) ≤ r - Real.log (branchDenom a x)}
  have hS : ∀ a, (S a).Finite := fun a =>
    finite_setOf_wordDelay_le (branchMap_mem_orderedSimplex a hx) _
  have hdecomp : {u : List (ℕ × Fin d) | wordDelay u x ≤ r} =
      {u | u = [] ∧ 0 ≤ r} ∪ ⋃ a ∈ T, List.cons a '' S a := by
    ext u
    cases u with
    | nil => simp
    | cons a u =>
      simp only [mem_ofPred_eq, wordDelay_cons, mem_union, reduceCtorEq, false_and, false_or,
        mem_iUnion, mem_image, List.cons.injEq, exists_prop, S]
      refine ⟨fun h => ⟨a, ?_, u, by linarith, rfl, rfl⟩, ?_⟩
      · refine (fst_add_three_le_two_mul_exp_wordDelay (u := a :: u) (by simp) hx).trans ?_
        rw [wordDelay_cons]
        gcongr
      · rintro ⟨b, -, v, hv, rfl, rfl⟩
        linarith
  have hdisj : Disjoint {u : List (ℕ × Fin d) | u = [] ∧ 0 ≤ r} (⋃ a ∈ T, List.cons a '' S a) := by
    rw [disjoint_left]
    rintro _ ⟨rfl, -⟩ h
    simp at h
  have hpair : T.PairwiseDisjoint fun a => List.cons a '' S a := by
    intro a _ b _ hab
    rw [Function.onFun, disjoint_left]
    rintro _ ⟨u, -, rfl⟩ ⟨v, -, h⟩
    exact hab (List.cons.inj h).1.symm
  rw [wordCount_def, hdecomp, ncard_union_eq hdisj ((finite_singleton []).subset fun _ hu => hu.1)
    (hT.biUnion fun a _ => (hS a).image _),
    hT.ncard_biUnion (fun a _ => (hS a).image _) hpair]
  congr 1
  · split_ifs with h <;> simp [h]
  · simp only [ncard_image_of_injective _ List.cons_injective]
    rw [← finsum_mem_univ fun a => wordCount d (branchMap a x) (r - Real.log (branchDenom a x))]
    exact finsum_mem_inter_support_eq' _ T univ fun a ha =>
      ⟨fun _ => mem_univ _, fun _ => fst_add_three_le_of_wordCount_ne_zero hx ha⟩

private theorem hasSum_wordCount_branchMap {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d)
    (r : ℝ) :
    HasSum
      (fun a : ℕ × Fin d => (wordCount d (branchMap a x) (r - Real.log (branchDenom a x)) : ℝ))
      (∑ a ∈ (finite_support_wordCount_branchMap hx r).toFinset,
        (wordCount d (branchMap a x) (r - Real.log (branchDenom a x)) : ℝ)) :=
  hasSum_sum_of_ne_finset_zero fun a ha => by
    simp [by_contra fun hne => ha ((finite_support_wordCount_branchMap hx r).mem_toFinset.2 hne)]

/-- The real-valued terms of the renewal sum are summable (in fact finitely supported). -/
theorem summable_wordCount_branchMap {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) (r : ℝ) :
    Summable fun a : ℕ × Fin d =>
      (wordCount d (branchMap a x) (r - Real.log (branchDenom a x)) : ℝ) :=
  (hasSum_wordCount_branchMap hx r).summable

/-- Real-valued `tsum` form of the renewal equation:
`(N (w, r) : ℝ) = 1{r ≥ 0} + ∑' a, (N (F_a w, r - τ_a (w)) : ℝ)`. -/
theorem wordCount_eq_add_tsum {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) (r : ℝ) :
    (wordCount d x r : ℝ) =
      (if 0 ≤ r then (1 : ℝ) else 0) +
        ∑' a : ℕ × Fin d,
          (wordCount d (branchMap a x) (r - Real.log (branchDenom a x)) : ℝ) := by
  have hnat := wordCount_eq_add_finsum hx r
  rw [finsum_eq_sum _ (finite_support_wordCount_branchMap hx r)] at hnat
  rw [(hasSum_wordCount_branchMap hx r).tsum_eq, ← Nat.cast_sum, hnat]
  split_ifs <;> simp

/-! ### Freeness of the unaccelerated and accelerated semigroups -/

/-- Strictly positive, strictly increasing vectors in the hyperplane `coneSpan d`. -/
private def IsStrictOrderedCone {d : ℕ} (y : Fin (d + 2) → ℝ) : Prop :=
  (∀ k, 0 < y k) ∧ StrictMono y ∧ y ∈ coneSpan d

private theorem isStrictOrderedCone_snoc_sum {d : ℕ} (hd : 1 ≤ d) {f : Fin (d + 1) → ℝ}
    (hfpos : ∀ i, 0 < f i) (hfmono : StrictMono f) :
    IsStrictOrderedCone (Fin.snoc (α := fun _ => ℝ) f (∑ i, f i)) := by
  have : Nontrivial (Fin (d + 1)) := Fin.nontrivial_iff_two_le.2 (by omega)
  refine ⟨Fin.lastCases (by simpa using Finset.sum_pos (fun i _ => hfpos i) Finset.univ_nonempty)
      (fun i => by simpa using hfpos i),
    Fin.strictMono_snoc hfmono fun i => ?_, by simp⟩
  obtain ⟨j, hj⟩ := exists_ne i
  exact Finset.single_lt_sum hj (Finset.mem_univ i) (Finset.mem_univ j) (hfpos j)
    fun k _ _ => (hfpos k).le

/-- A canonical witness in `IsStrictOrderedCone` for `1 ≤ d`: `(1, 2, …, d + 1, ∑ (i + 1))`. -/
private def strictOrderedConePoint (d : ℕ) : Fin (d + 2) → ℝ :=
  Fin.snoc (α := fun _ => ℝ) (fun i : Fin (d + 1) => (i.val : ℝ) + 1)
    (∑ i : Fin (d + 1), ((i.val : ℝ) + 1))

private theorem strictOrderedConePoint_mem {d : ℕ} (hd : 1 ≤ d) :
    IsStrictOrderedCone (strictOrderedConePoint d) :=
  isStrictOrderedCone_snoc_sum hd (fun _ => by positivity)
    (fun _ _ h => by have : (_ : ℝ) < _ := Nat.cast_lt.2 h; linarith)

private theorem linearMove_preserves_strict {d : ℕ} (hd : 1 ≤ d) (j : Fin (d + 1))
    {y : Fin (d + 2) → ℝ} (hy : IsStrictOrderedCone y) :
    IsStrictOrderedCone (linearMove j y) := by
  rw [linearMove_eq_snoc_sum]
  exact isStrictOrderedCone_snoc_sum hd (fun _ => hy.1 _)
    (fun _ _ h => hy.2.1 ((Fin.strictMono_succAbove _) h))

private theorem unaccelWordMove_preserves_strict {d : ℕ} (hd : 1 ≤ d) (js : List (Fin (d + 1)))
    {y : Fin (d + 2) → ℝ} (hy : IsStrictOrderedCone y) :
    IsStrictOrderedCone (unaccelWordMove js y) := by
  induction js generalizing y with
  | nil => exact hy
  | cons j _ ih => exact ih (linearMove_preserves_strict hd j hy)

private theorem linearMove_last_gt {d : ℕ} (j : Fin (d + 1)) {y : Fin (d + 2) → ℝ}
    (hy : IsStrictOrderedCone y) :
    y (Fin.last (d + 1)) < linearMove j y (Fin.last (d + 1)) := by
  rw [linearMove_last_of_mem_coneSpan j hy.2.2]
  linarith [hy.2.1 (Fin.castSucc_lt_last j)]

private theorem unaccelWordMove_last_ge {d : ℕ} (hd : 1 ≤ d) (js : List (Fin (d + 1)))
    {y : Fin (d + 2) → ℝ} (hy : IsStrictOrderedCone y) :
    y (Fin.last (d + 1)) ≤ unaccelWordMove js y (Fin.last (d + 1)) := by
  induction js generalizing y with
  | nil => exact le_rfl
  | cons j _ ih =>
    exact (linearMove_last_gt j hy).le.trans (ih (linearMove_preserves_strict hd j hy))

private theorem unaccelWordMove_append_singleton {d : ℕ} (l : List (Fin (d + 1)))
    (j : Fin (d + 1)) (y : Fin (d + 2) → ℝ) :
    unaccelWordMove (l ++ [j]) y = linearMove j (unaccelWordMove l y) := by
  rw [unaccelWordMove_append, mul_apply_eq_comp, unaccelWordMove_singleton]

private theorem unaccelWordMove_snoc_ne_self {d : ℕ} (hd : 1 ≤ d) (l : List (Fin (d + 1)))
    (j : Fin (d + 1)) {y : Fin (d + 2) → ℝ} (hy : IsStrictOrderedCone y) :
    unaccelWordMove (l ++ [j]) y ≠ y := fun hEq => by
  rw [unaccelWordMove_append_singleton] at hEq
  have hlt := linearMove_last_gt j (unaccelWordMove_preserves_strict hd l hy)
  have hge := unaccelWordMove_last_ge hd l hy
  linarith [congrFun hEq (Fin.last (d + 1))]

/-- On strictly ordered cone vectors, `linearMove j y` uniquely determines both `j` and `y`. -/
private theorem linearMove_inj_strict {d : ℕ} {j₁ j₂ : Fin (d + 1)}
    {y₁ y₂ : Fin (d + 2) → ℝ} (hy₁ : IsStrictOrderedCone y₁) (hy₂ : IsStrictOrderedCone y₂)
    (heq : linearMove j₁ y₁ = linearMove j₂ y₂) :
    j₁ = j₂ ∧ y₁ = y₂ := by
  have hlast : y₁ (Fin.last (d + 1)) = y₂ (Fin.last (d + 1)) := by
    simpa [linearMove_penultimate] using congrFun heq (Fin.last d).castSucc
  have hdel : y₁ j₁.castSucc = y₂ j₂.castSucc := by
    have htop := congrFun heq (Fin.last (d + 1))
    rw [linearMove_last_of_mem_coneSpan j₁ hy₁.2.2,
      linearMove_last_of_mem_coneSpan j₂ hy₂.2.2] at htop
    linarith
  have hnotlt : ∀ {a b : Fin (d + 1)} {u v : Fin (d + 2) → ℝ},
      IsStrictOrderedCone u → IsStrictOrderedCone v →
      linearMove a u = linearMove b v → u a.castSucc = v b.castSucc → ¬ a < b := by
    intro a b u v hu hv hab huv hlt
    have hcoord := congrFun hab a.castSucc
    rw [linearMove_apply_castSucc, linearMove_apply_castSucc,
      Fin.succAbove_of_le_castSucc a.castSucc a le_rfl,
      Fin.succAbove_of_castSucc_lt b.castSucc a (Fin.castSucc_lt_castSucc_iff.2 hlt)] at hcoord
    linarith [hu.2.1 (Fin.castSucc_lt_succ (i := a)), hv.2.1 (Fin.castSucc_lt_castSucc_iff.2 hlt)]
  have hj : j₁ = j₂ := le_antisymm
    (not_lt.1 (hnotlt hy₂ hy₁ heq.symm hdel.symm)) (not_lt.1 (hnotlt hy₁ hy₂ heq hdel))
  subst hj
  refine ⟨rfl, funext fun k => ?_⟩
  by_cases hk : k = j₁.castSucc
  · rw [hk, hdel]
  · rcases Fin.exists_succAbove_eq hk with ⟨i, rfl⟩
    simpa [linearMove_apply_castSucc] using congrFun heq i.castSucc

private theorem unaccelWordMove_apply_injective {d : ℕ} (hd : 1 ≤ d) {y : Fin (d + 2) → ℝ}
    (hy : IsStrictOrderedCone y) :
    Function.Injective fun js : List (Fin (d + 1)) => unaccelWordMove js y := by
  intro js₁
  refine List.reverseRecOn js₁ ?_ ?_
  · intro js₂ hEq
    refine List.reverseRecOn js₂ (fun _ => rfl) (fun l₂ j₂ _ hEq => ?_) hEq
    exact absurd hEq.symm (unaccelWordMove_snoc_ne_self hd l₂ j₂ hy)
  · intro l₁ j₁ ih js₂ hEq
    refine List.reverseRecOn js₂
      (fun hEq => absurd hEq (unaccelWordMove_snoc_ne_self hd l₁ j₁ hy))
      (fun l₂ j₂ _ hEq => ?_) hEq
    dsimp only at hEq
    simp only [unaccelWordMove_append_singleton] at hEq
    rcases linearMove_inj_strict (unaccelWordMove_preserves_strict hd l₁ hy)
      (unaccelWordMove_preserves_strict hd l₂ hy) hEq with ⟨hj, hl⟩
    rw [ih hl, hj]

/-- For `1 ≤ d`, distinct unaccelerated words induce distinct linear maps on `Fin (d + 2) → ℝ`
(freeness of the unaccelerated semigroup). -/
theorem unaccelWordMove_injective {d : ℕ} (hd : 1 ≤ d) :
    Function.Injective (unaccelWordMove (d := d)) := fun _ _ hEq =>
  unaccelWordMove_apply_injective hd (strictOrderedConePoint_mem hd) (by dsimp only; rw [hEq])

/-- Expansion of an accelerated word into its underlying unaccelerated word in `Fin (d + 1)`. -/
def expandWord : List (ℕ × Fin d) → List (Fin (d + 1))
  | [] => []
  | a :: u => a.2.castSucc :: List.replicate a.1 (Fin.last d) ++ expandWord u

@[simp]
theorem expandWord_nil : expandWord ([] : List (ℕ × Fin d)) = [] :=
  (rfl)

@[simp]
theorem expandWord_cons (a : ℕ × Fin d) (u : List (ℕ × Fin d)) :
    expandWord (a :: u) = a.2.castSucc :: List.replicate a.1 (Fin.last d) ++ expandWord u :=
  (rfl)

theorem expandWord_singleton (a : ℕ × Fin d) :
    expandWord [a] = a.2.castSucc :: List.replicate a.1 (Fin.last d) := by simp

/-- Expanding a concatenation of accelerated words concatenates their expansions. -/
@[simp]
theorem expandWord_append (u v : List (ℕ × Fin d)) :
    expandWord (u ++ v) = expandWord u ++ expandWord v := by
  induction u with
  | nil => simp
  | cons a u ih => simp [ih, List.append_assoc]

private theorem unaccelWordMove_replicate (A : ℕ) (j : Fin (d + 1)) :
    unaccelWordMove (List.replicate A j) = linearMove j ^ A := by
  induction A with
  | zero => simp
  | succ A ih => rw [List.replicate_succ, unaccelWordMove_cons, ih, pow_succ]

private theorem unaccelWordMove_expandWord_singleton (a : ℕ × Fin d) :
    unaccelWordMove (expandWord [a]) = accelMove a := by
  rw [expandWord_singleton, unaccelWordMove_cons, unaccelWordMove_replicate, accelMove_def,
    Module.End.mul_eq_comp]

/-- Expanding an accelerated word preserves its linear move. -/
theorem unaccelWordMove_expandWord (u : List (ℕ × Fin d)) :
    unaccelWordMove (expandWord u) = wordMove u := by
  induction u with
  | nil => rfl
  | cons a u ih =>
    have hcons : expandWord (a :: u) = expandWord ([a] ++ u) := rfl
    rw [hcons, expandWord_append, unaccelWordMove_append, unaccelWordMove_expandWord_singleton, ih,
      wordMove_cons, accelMove_def]
    simp only [Module.End.mul_eq_comp]

private theorem expandWord_ne_last_cons (u : List (ℕ × Fin d)) (t : List (Fin (d + 1))) :
    expandWord u ≠ Fin.last d :: t := by
  cases u with
  | nil => simp
  | cons a u =>
    simp only [expandWord_cons, List.cons_append, ne_eq, List.cons.injEq, not_and]
    exact fun h => absurd h (Fin.castSucc_ne_last a.2)

private theorem replicate_append_expandWord_inj {A₁ A₂ : ℕ} {v₁ v₂ : List (ℕ × Fin d)}
    (h : List.replicate A₁ (Fin.last d) ++ expandWord v₁ =
      List.replicate A₂ (Fin.last d) ++ expandWord v₂) :
    A₁ = A₂ ∧ expandWord v₁ = expandWord v₂ := by
  induction A₁ generalizing A₂ with
  | zero =>
    cases A₂ with
    | zero => simpa using h
    | succ A₂ =>
      simp only [List.replicate_zero, List.nil_append, List.replicate_succ, List.cons_append] at h
      exact absurd h (expandWord_ne_last_cons v₁ _)
  | succ A₁ ih =>
    cases A₂ with
    | zero =>
      simp only [List.replicate_zero, List.nil_append, List.replicate_succ, List.cons_append] at h
      exact absurd h.symm (expandWord_ne_last_cons v₂ _)
    | succ A₂ =>
      simp only [List.replicate_succ, List.cons_append, List.cons.injEq, true_and] at h
      exact (ih h).imp_left (congrArg Nat.succ)

/-- The expansion from accelerated words to unaccelerated words is injective. -/
theorem expandWord_injective : Function.Injective (expandWord (d := d)) := by
  intro u₁
  induction u₁ with
  | nil => rintro (_ | ⟨_, _⟩) h <;> simp at h ⊢
  | cons a₁ v₁ ih =>
    rintro (_ | ⟨a₂, v₂⟩) h
    · simp at h
    · simp only [expandWord_cons, List.cons_append, List.cons.injEq] at h
      rcases replicate_append_expandWord_inj h.2 with ⟨hA, hv⟩
      rw [Prod.ext hA (Fin.castSucc_injective d h.1), ih hv]

/-- Distinct accelerated words induce distinct linear maps on `Fin (d + 2) → ℝ` for every `d : ℕ`
(freeness of the accelerated semigroup). -/
theorem wordMove_injective (d : ℕ) : Function.Injective (wordMove (d := d)) := by
  cases d with
  | zero =>
    rintro (_ | ⟨a, _⟩) (_ | ⟨b, _⟩) _
    · rfl
    · exact Fin.elim0 b.2
    · exact Fin.elim0 a.2
    · exact Fin.elim0 a.2
  | succ d =>
    intro u₁ u₂ h
    exact expandWord_injective <| unaccelWordMove_injective (Nat.succ_pos d) <| by
      rw [unaccelWordMove_expandWord, unaccelWordMove_expandWord, h]

/-- The range of `wordMove` is the submonoid of endomorphisms generated by `accelMove`. -/
theorem range_wordMove (d : ℕ) :
    Set.range (wordMove (d := d)) =
      (Submonoid.closure (Set.range (accelMove (d := d))) :
        Set ((Fin (d + 2) → ℝ) →ₗ[ℝ] (Fin (d + 2) → ℝ))) := by
  ext T
  refine ⟨?_, fun hT => ?_⟩
  · rintro ⟨u, rfl⟩
    induction u with
    | nil => exact Submonoid.one_mem _
    | cons a u ih =>
      rw [wordMove_cons]
      exact Submonoid.mul_mem _ ih
        (Submonoid.subset_closure ⟨a, by rw [accelMove_def, Module.End.mul_eq_comp]⟩)
  · induction hT using Submonoid.closure_induction with
    | mem _ ha =>
      rcases ha with ⟨a, rfl⟩
      exact ⟨[a], wordMove_singleton a⟩
    | one => exact ⟨[], wordMove_nil⟩
    | mul _ _ _ _ hu hv =>
      rcases hu with ⟨u, rfl⟩
      rcases hv with ⟨v, rfl⟩
      exact ⟨v ++ u, wordMove_append v u⟩

/-- Homogeneous description of the renewal count on `orderedCone d`:
`wordCount d (simplexChart y) r` counts the linear maps in the submonoid generated by `accelMove`
whose last coordinate at `y` is at most `exp r * y (Fin.last (d + 1))`. -/
theorem wordCount_simplexChart_eq {y : Fin (d + 2) → ℝ} (hy : y ∈ orderedCone d) (r : ℝ) :
    wordCount d (simplexChart y) r =
      {T ∈ (Submonoid.closure (Set.range (accelMove (d := d))) :
          Set ((Fin (d + 2) → ℝ) →ₗ[ℝ] (Fin (d + 2) → ℝ))) |
        T y (Fin.last (d + 1)) ≤ Real.exp r * y (Fin.last (d + 1))}.ncard := by
  have hypos := pos_last_of_mem_orderedCone hy
  have himg :
      (wordMove (d := d)) '' {u : List (ℕ × Fin d) | wordDelay u (simplexChart y) ≤ r} =
        {T ∈ (Submonoid.closure (Set.range (accelMove (d := d))) :
            Set ((Fin (d + 2) → ℝ) →ₗ[ℝ] (Fin (d + 2) → ℝ))) |
          T y (Fin.last (d + 1)) ≤ Real.exp r * y (Fin.last (d + 1))} := by
    ext T
    simp only [mem_image, mem_ofPred_eq, ← range_wordMove d, Set.mem_range]
    refine ⟨?_, ?_⟩
    · rintro ⟨u, hu, rfl⟩
      refine ⟨⟨u, rfl⟩, ?_⟩
      rw [wordMove_last_eq u hy, mul_comm (Real.exp r)]
      exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 hu) hypos.le
    · rintro ⟨⟨u, rfl⟩, hT⟩
      refine ⟨u, ?_, rfl⟩
      rw [wordMove_last_eq u hy, mul_comm (Real.exp r)] at hT
      exact Real.exp_le_exp.1 (le_of_mul_le_mul_left hT hypos)
  rw [wordCount_def, ← Set.ncard_image_of_injective _ (wordMove_injective d), himg]

end TauCeti
