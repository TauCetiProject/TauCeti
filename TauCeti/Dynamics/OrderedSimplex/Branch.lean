/-!
# Accelerated branches on the ordered simplex

For `n = d + 2` and `1 ≤ j ≤ n - 1`, the linear map
`γ_j (y) = (y₁, …, y_{j-1}, y_{j+1}, …, y_n, ∑_{k ≠ j} y_k)` deletes the `j`-th coordinate and
appends the sum of the others. For a letter `a = (A, j)` with `A ∈ ℕ` and `1 ≤ j ≤ n - 2`, the
accelerated element `γ_{n-1}^A γ_j` (apply `γ_j`, then `γ_{n-1}` `A` times) maps the ordered cone
`H_n` into itself, and on the ordered projective simplex it acts by the *branch*
`F_a (w) = (w₁, …, w_{j-1}, w_{j+1}, …, w_{n-1}) / q_a (w)` in chart coordinates, where
`q_a (w) = 1 + (A + 1) (1 - w_j)` is the last homogeneous coordinate of
`γ_{n-1}^A γ_j (w, 1)`. The branches with their *delays* `log q_a` are the inverse branches of
the projective dynamics whose transfer operators `L_s f = ∑_a q_a^{-s} f ∘ F_a` count the orbit
of a point under the semigroup generated by the accelerated elements.

In Lean a letter is `a : ℕ × Fin d`, the pair `(A, j - 1)`, and `γ_j` is `linearMove` at the index
`j - 1 : Fin (d + 1)`, so that `γ_{n-1}` is `linearMove (Fin.last d)`.

## Main definitions

* `TauCeti.branchDenom a x`: the denominator `q_a (w) = 1 + (A + 1) (1 - w_j)`.
* `TauCeti.branchMap a x`: the branch `F_a` in chart coordinates.
* `TauCeti.linearMove j`: the linear map `γ_{j+1}` of `ℝ^{d+2}`.

## Main results

* `TauCeti.linearMove_last_pow_linearMove_simplexLift`,
  `TauCeti.linearMove_last_pow_linearMove_of_mem_orderedCone`: the homogeneous identity
  `γ_{n-1}^A γ_j y = y_n q_a (w) (F_a (w), 1)`, which identifies `F_a` as the projective action
  of `γ_{n-1}^A γ_j` and `q_a` as the growth factor of the last coordinate.
* `TauCeti.branchMap_mem_orderedSimplex`, `TauCeti.mapsTo_branchMap`: each branch maps the ordered
  simplex into itself.
* `TauCeti.add_three_div_two_le_branchDenom`, `TauCeti.branchDenom_le_add_two`,
  `TauCeti.log_three_halves_le_log_branchDenom`: on the simplex `(A + 3) / 2 ≤ q_a ≤ A + 2`, so
  every delay is at least `log (3 / 2)`.
* `TauCeti.hasFDerivAt_log_branchDenom`, `TauCeti.norm_fderiv_log_branchDenom_lt_two`: the delay
  depends only on `w_j`, with `|∂ log q_a / ∂ w_j| = (A + 1) / q_a < 2` on the simplex, uniformly
  in the letter.
* `TauCeti.contDiffAt_branchMap`: each branch is smooth wherever its denominator is nonzero, in
  particular on a neighbourhood of the simplex.

## References

* A. Gamburd, M. Magee, R. Ronan, *An asymptotic formula for integer points on Markoff–Hurwitz
  varieties*, Ann. of Math. 190 (2019), Lemma 33 and (4.5)–(4.6).
-/

public section

open Set

namespace TauCeti

variable {d : ℕ}

/-! ### Denominators and branches -/

/-- The denominator `q_a (w) = 1 + (A + 1) (1 - w_j)` of the accelerated branch `a = (A, j)`, the
last homogeneous coordinate of `γ_{n-1}^A γ_j (w, 1)`. -/
def branchDenom (a : ℕ × Fin d) (x : Fin d → ℝ) : ℝ :=
  1 + ((a.1 : ℝ) + 1) * (1 - x a.2)

theorem branchDenom_def (a : ℕ × Fin d) (x : Fin d → ℝ) :
    branchDenom a x = 1 + ((a.1 : ℝ) + 1) * (1 - x a.2) :=
  (rfl)

/-- The accelerated branch `F_a` in chart coordinates: delete `w_j` from `(w₁, …, w_{d+1})` and
divide by `q_a (w)`. The image point of the simplex is
`(w₁, …, w_{j-1}, w_{j+1}, …, w_{d+1}, 1 + A (1 - w_j)) / q_a (w)`, whose last coordinate is not
a chart coordinate. -/
noncomputable def branchMap (a : ℕ × Fin d) (x : Fin d → ℝ) : Fin d → ℝ :=
  fun i => simplexPoint x (a.2.castSucc.succAbove i) / branchDenom a x

@[simp]
theorem branchMap_apply (a : ℕ × Fin d) (x : Fin d → ℝ) (i : Fin d) :
    branchMap a x i = simplexPoint x (a.2.castSucc.succAbove i) / branchDenom a x :=
  (rfl)

/-- The coordinates of the full point that survive the deletion of `w_j` sum to `1 - w_j`. -/
private theorem sum_simplexPoint_succAbove (x : Fin d → ℝ) (j : Fin d) :
    ∑ i, simplexPoint x (j.castSucc.succAbove i) = 1 - x j := by
  have := Fin.sum_univ_succAbove (simplexPoint x) j.castSucc
  rw [sum_simplexPoint, simplexPoint_castSucc] at this
  linarith

/-- The chart coordinates of `F_a (w)` sum to `(1 - w_j) / q_a (w)`. -/
theorem sum_branchMap (a : ℕ × Fin d) (x : Fin d → ℝ) :
    ∑ i, branchMap a x i = (1 - x a.2) / branchDenom a x := by
  simp only [branchMap_apply, ← Finset.sum_div, sum_simplexPoint_succAbove]

/-- The last coordinate of the image of a branch is `(1 + A (1 - w_j)) / q_a (w)`. -/
theorem simplexPoint_branchMap_last (a : ℕ × Fin d) {x : Fin d → ℝ}
    (hx : branchDenom a x ≠ 0) :
    simplexPoint (branchMap a x) (Fin.last d) = (1 + a.1 * (1 - x a.2)) / branchDenom a x := by
  rw [simplexPoint_last, sum_branchMap]
  field_simp
  rw [branchDenom_def]
  ring

/-- The denominator `q_a (w)` is at least `1` whenever `w_j ≤ 1`. -/
theorem one_le_branchDenom (a : ℕ × Fin d) {x : Fin d → ℝ} (hx : x a.2 ≤ 1) :
    1 ≤ branchDenom a x := by
  rw [branchDenom_def]
  have : 0 ≤ ((a.1 : ℝ) + 1) * (1 - x a.2) := mul_nonneg (by positivity) (by linarith)
  linarith

/-- The denominator `q_a (w)` is positive whenever `w_j ≤ 1`, in particular on the simplex. -/
theorem branchDenom_pos (a : ℕ × Fin d) {x : Fin d → ℝ} (hx : x a.2 ≤ 1) :
    0 < branchDenom a x :=
  one_pos.trans_le (one_le_branchDenom a hx)

/-- The denominator `q_a (w)` is positive on the ordered simplex. -/
theorem branchDenom_pos_of_mem_orderedSimplex (a : ℕ × Fin d) {x : Fin d → ℝ}
    (hx : x ∈ orderedSimplex d) : 0 < branchDenom a x :=
  branchDenom_pos a ((le_one_half_of_mem_orderedSimplex hx a.2).trans (by norm_num))

/-- The lower bound `(A + 3) / 2 ≤ q_a (w)`, valid on the simplex where `w_j ≤ 1 / 2`. -/
theorem add_three_div_two_le_branchDenom (a : ℕ × Fin d) {x : Fin d → ℝ}
    (hx : x a.2 ≤ 1 / 2) : ((a.1 : ℝ) + 3) / 2 ≤ branchDenom a x := by
  rw [branchDenom_def]
  nlinarith [(a.1.cast_nonneg : (0 : ℝ) ≤ a.1)]

/-- The upper bound `q_a (w) ≤ A + 2`, valid on the simplex where `0 ≤ w_j`. -/
theorem branchDenom_le_add_two (a : ℕ × Fin d) {x : Fin d → ℝ} (hx : 0 ≤ x a.2) :
    branchDenom a x ≤ a.1 + 2 := by
  rw [branchDenom_def]
  nlinarith [(a.1.cast_nonneg : (0 : ℝ) ≤ a.1)]

/-- Every delay `τ_a = log q_a` is at least `log (3 / 2)` on the simplex. -/
theorem log_three_halves_le_log_branchDenom (a : ℕ × Fin d) {x : Fin d → ℝ}
    (hx : x a.2 ≤ 1 / 2) : Real.log (3 / 2) ≤ Real.log (branchDenom a x) := by
  have h := add_three_div_two_le_branchDenom a hx
  refine Real.log_le_log (by norm_num) (le_trans ?_ h)
  linarith [(a.1.cast_nonneg : (0 : ℝ) ≤ a.1)]

/-- Each branch maps the ordered simplex into itself: deleting a coordinate keeps the remaining
ones ordered, and the appended coordinate `1 + A (1 - w_j)` is at least `1 ≥ w_{d+1}`. -/
theorem branchMap_mem_orderedSimplex (a : ℕ × Fin d) {x : Fin d → ℝ}
    (hx : x ∈ orderedSimplex d) : branchMap a x ∈ orderedSimplex d := by
  obtain ⟨h0, hmono⟩ := mem_orderedSimplex_iff_simplexPoint.mp hx
  have hq := branchDenom_pos_of_mem_orderedSimplex a hx
  refine mem_orderedSimplex_iff.mpr ⟨fun i => div_nonneg (h0 _) hq.le, fun i j hij => ?_,
    fun i => ?_⟩
  · exact div_le_div_of_nonneg_right
      (hmono ((Fin.strictMono_succAbove _).monotone hij)) hq.le
  · rw [← simplexPoint_last, simplexPoint_branchMap_last a hq.ne', branchMap_apply]
    refine div_le_div_of_nonneg_right ((simplexPoint_le_one hx _).trans ?_) hq.le
    have : 0 ≤ (a.1 : ℝ) * (1 - x a.2) :=
      mul_nonneg a.1.cast_nonneg (by linarith [le_one_half_of_mem_orderedSimplex hx a.2])
    linarith

/-- Each branch maps the ordered simplex into itself. -/
theorem mapsTo_branchMap (a : ℕ × Fin d) :
    MapsTo (branchMap a) (orderedSimplex d) (orderedSimplex d) :=
  fun _ hx => branchMap_mem_orderedSimplex a hx

/-! ### Smoothness and the logarithmic derivative -/

private theorem branchDenom_eq (a : ℕ × Fin d) :
    branchDenom a = fun y => 1 + ((a.1 : ℝ) + 1) * (1 - y a.2) :=
  funext (branchDenom_def a)

/-- The denominator `q_a` is an affine, hence smooth, function of the chart coordinates. -/
@[fun_prop]
theorem contDiff_branchDenom (a : ℕ × Fin d) {n : WithTop ℕ∞} :
    ContDiff ℝ n (branchDenom a) := by
  rw [branchDenom_eq]
  fun_prop

/-- Each branch is smooth at every point where its denominator does not vanish, in particular on
the open neighbourhood `{q_a > 0}` of the simplex. -/
theorem contDiffAt_branchMap (a : ℕ × Fin d) {x : Fin d → ℝ} (hx : branchDenom a x ≠ 0)
    {n : WithTop ℕ∞} : ContDiffAt ℝ n (branchMap a) x := by
  rw [contDiffAt_pi]
  intro i
  have h : (fun y => branchMap a y i) =
      fun y => simplexPoint y (a.2.castSucc.succAbove i) / branchDenom a y :=
    funext fun y => branchMap_apply a y i
  rw [h]
  exact ((contDiff_simplexPoint_apply _).contDiffAt).div
    (contDiff_branchDenom a).contDiffAt hx

/-- Each branch is smooth on the ordered simplex. -/
theorem contDiffOn_branchMap (a : ℕ × Fin d) {n : WithTop ℕ∞} :
    ContDiffOn ℝ n (branchMap a) (orderedSimplex d) := fun _ hx =>
  (contDiffAt_branchMap a (branchDenom_pos_of_mem_orderedSimplex a hx).ne').contDiffWithinAt

/-- The denominator `q_a` depends only on `w_j`, with partial derivative `-(A + 1)`. -/
theorem hasFDerivAt_branchDenom (a : ℕ × Fin d) (x : Fin d → ℝ) :
    HasFDerivAt (branchDenom a)
      (-((a.1 : ℝ) + 1) • (ContinuousLinearMap.proj a.2 : (Fin d → ℝ) →L[ℝ] ℝ)) x := by
  rw [branchDenom_eq]
  refine ((((ContinuousLinearMap.proj a.2 : (Fin d → ℝ) →L[ℝ] ℝ).hasFDerivAt
    (x := x)).const_sub 1).const_mul ((a.1 : ℝ) + 1)).const_add 1 |>.congr_fderiv ?_
  ext v
  simp only [smul_neg, neg_apply, smul_apply, ContinuousLinearMap.proj_apply, smul_eq_mul,
    neg_add_rev]
  ring

/-- The delay `log q_a` depends only on `w_j`, with partial derivative `-(A + 1) / q_a`. -/
theorem hasFDerivAt_log_branchDenom (a : ℕ × Fin d) {x : Fin d → ℝ}
    (hx : branchDenom a x ≠ 0) :
    HasFDerivAt (fun y => Real.log (branchDenom a y))
      (-(((a.1 : ℝ) + 1) / branchDenom a x) •
        (ContinuousLinearMap.proj a.2 : (Fin d → ℝ) →L[ℝ] ℝ)) x := by
  refine ((hasFDerivAt_branchDenom a x).log hx).congr_fderiv ?_
  rw [smul_smul]
  congr 1
  field_simp

/-- The logarithmic derivative of a denominator is bounded on the simplex:
`‖D log q_a‖ = (A + 1) / q_a ≤ 2 (A + 1) / (A + 3)`. -/
theorem norm_fderiv_log_branchDenom_le (a : ℕ × Fin d) {x : Fin d → ℝ} (hx : x a.2 ≤ 1 / 2) :
    ‖fderiv ℝ (fun y => Real.log (branchDenom a y)) x‖ ≤
      2 * ((a.1 : ℝ) + 1) / ((a.1 : ℝ) + 3) := by
  have hA : (0 : ℝ) ≤ a.1 := a.1.cast_nonneg
  have hle := add_three_div_two_le_branchDenom a hx
  have hq : 0 < branchDenom a x := by linarith [hA]
  rw [(hasFDerivAt_log_branchDenom a hq.ne').fderiv]
  refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun v => ?_
  have hv : ‖v a.2‖ ≤ ‖v‖ := norm_le_pi_norm v a.2
  have hc : ((a.1 : ℝ) + 1) / branchDenom a x ≤ 2 * ((a.1 : ℝ) + 1) / ((a.1 : ℝ) + 3) := by
    rw [div_le_div_iff₀ hq (by positivity)]
    nlinarith [hA]
  simp only [smul_apply, ContinuousLinearMap.proj_apply, norm_smul,
    norm_neg, Real.norm_of_nonneg (div_nonneg (by positivity : (0 : ℝ) ≤ a.1 + 1) hq.le)]
  exact mul_le_mul hc hv (norm_nonneg _) (by positivity)

/-- The logarithmic derivative of a denominator has norm less than `2` on the simplex, uniformly in
the letter. -/
theorem norm_fderiv_log_branchDenom_lt_two (a : ℕ × Fin d) {x : Fin d → ℝ}
    (hx : x a.2 ≤ 1 / 2) : ‖fderiv ℝ (fun y => Real.log (branchDenom a y)) x‖ < 2 := by
  refine (norm_fderiv_log_branchDenom_le a hx).trans_lt ?_
  rw [div_lt_iff₀ (by positivity)]
  linarith

/-! ### The linear moves and the homogeneous identity -/

/-- The linear map `γ_{j+1}` of `ℝ^{d+2}`: delete the coordinate at index `j` and append the sum
of the other coordinates, `γ_{j+1} (y) = (y₁, …, y_j, y_{j+2}, …, y_{d+2}, ∑_{k ≠ j+1} y_k)`. -/
noncomputable def linearMove (j : Fin (d + 1)) :
    (Fin (d + 2) → ℝ) →ₗ[ℝ] (Fin (d + 2) → ℝ) where
  toFun y := Fin.snoc (fun i => y (j.castSucc.succAbove i)) (∑ k, y k - y j.castSucc)
  map_add' y z := by
    ext i
    induction i using Fin.lastCases with
    | last => simp only [Fin.snoc_last, Pi.add_apply, Finset.sum_add_distrib]; ring
    | cast i => simp
  map_smul' c y := by
    ext i
    induction i using Fin.lastCases with
    | last => simp [Finset.mul_sum, mul_sub]
    | cast i => simp

@[simp]
theorem linearMove_apply_castSucc (j : Fin (d + 1)) (y : Fin (d + 2) → ℝ) (i : Fin (d + 1)) :
    linearMove j y i.castSucc = y (j.castSucc.succAbove i) := by
  simp [linearMove]

@[simp]
theorem linearMove_apply_last (j : Fin (d + 1)) (y : Fin (d + 2) → ℝ) :
    linearMove j y (Fin.last _) = ∑ k, y k - y j.castSucc := by
  simp [linearMove]

/-- `γ_{n-1}` replaces the last two coordinates `(p, q)` by `(q, ∑ u + q)`, where `u` collects
the first `d` coordinates. -/
theorem linearMove_last_snoc_snoc (u : Fin d → ℝ) (p q : ℝ) :
    linearMove (Fin.last d) (Fin.snoc (Fin.snoc u p : Fin (d + 1) → ℝ) q) =
      Fin.snoc (Fin.snoc u q : Fin (d + 1) → ℝ) (∑ i, u i + q) := by
  ext i
  induction i using Fin.lastCases with
  | last =>
    simp only [linearMove_apply_last, Fin.sum_univ_castSucc, Fin.snoc_castSucc, Fin.snoc_last]
    ring
  | cast i => induction i using Fin.lastCases with
    | last => simp
    | cast i => simp

/-- On vectors `(u, p, q)` whose last two coordinates differ by the sum `S` of the first `d`,
`p = q - S`, `γ_{n-1}` acts on the last two coordinates as the translation by `S`: its `A`-th power
sends `(u, p, q)` to `(u, q + (A - 1) S, q + A S)`. -/
theorem linearMove_last_pow_snoc_snoc (u : Fin d → ℝ) {p : ℝ} (q : ℝ) (hp : p = q - ∑ i, u i)
    (A : ℕ) :
    (linearMove (Fin.last d) ^ A) (Fin.snoc (Fin.snoc u p : Fin (d + 1) → ℝ) q) =
      Fin.snoc (Fin.snoc u (q + ((A : ℝ) - 1) * ∑ i, u i) : Fin (d + 1) → ℝ)
        (q + A * ∑ i, u i) := by
  subst hp
  induction A with
  | zero => simp [sub_eq_add_neg]
  | succ A ih =>
    rw [pow_succ', mul_apply_eq_comp, ih, linearMove_last_snoc_snoc]
    have h1 : ∑ i, u i + (q + A * ∑ i, u i) = q + ((A + 1 : ℕ) : ℝ) * ∑ i, u i := by
      push_cast; ring
    have h2 : q + (A : ℝ) * ∑ i, u i = q + (((A + 1 : ℕ) : ℝ) - 1) * ∑ i, u i := by
      push_cast; ring
    rw [h1, h2]

/-- The image of the lift `(w, 1)` under `γ_j` for `j ≤ n - 2`. -/
private theorem linearMove_castSucc_simplexLift (x : Fin d → ℝ) (j : Fin d) :
    linearMove j.castSucc (simplexLift x) =
      Fin.snoc (Fin.snoc (fun i => simplexPoint x (j.castSucc.succAbove i)) 1 :
        Fin (d + 1) → ℝ) (2 - x j) := by
  ext i
  induction i using Fin.lastCases with
  | last =>
    rw [linearMove_apply_last, Fin.sum_univ_castSucc]
    simp only [simplexLift_castSucc, simplexLift_last, sum_simplexPoint, simplexPoint_castSucc,
      Fin.snoc_last]
    ring
  | cast i => induction i using Fin.lastCases with
    | last =>
      have : j.castSucc.castSucc.succAbove (Fin.last d) = Fin.last (d + 1) := by
        rw [Fin.succAbove_of_le_castSucc _ _ (Fin.castSucc_le_castSucc_iff.mpr
          (Fin.castSucc_lt_last j).le), Fin.succ_last]
      simp [this]
    | cast i => simp

/-- **The homogeneous identity** in chart coordinates: `γ_{n-1}^A γ_j (w, 1) = q_a (w) (F_a (w), 1)`
for the letter `a = (A, j)`, wherever `q_a (w) ≠ 0`. -/
theorem linearMove_last_pow_linearMove_simplexLift (a : ℕ × Fin d) {x : Fin d → ℝ}
    (hx : branchDenom a x ≠ 0) :
    (linearMove (Fin.last d) ^ a.1) (linearMove a.2.castSucc (simplexLift x)) =
      branchDenom a x • simplexLift (branchMap a x) := by
  have hsum := sum_simplexPoint_succAbove x a.2
  have hp : (1 : ℝ) = 2 - x a.2 - ∑ i, simplexPoint x (a.2.castSucc.succAbove i) := by
    rw [hsum]; ring
  rw [linearMove_castSucc_simplexLift, linearMove_last_pow_snoc_snoc _ _ hp, hsum]
  ext i
  induction i using Fin.lastCases with
  | last =>
    simp only [Fin.snoc_last, branchDenom_def, Pi.smul_apply, simplexLift_last, smul_eq_mul,
      mul_one]
    ring
  | cast i => induction i using Fin.lastCases with
    | last =>
      simp only [Fin.snoc_castSucc, Fin.snoc_last, Pi.smul_apply, simplexLift_castSucc,
        smul_eq_mul]
      rw [simplexPoint_branchMap_last a hx, mul_div_cancel₀ _ hx]
      ring
    | cast i => simp [mul_div_cancel₀ _ hx]

/-- **The homogeneous identity** on the ordered cone: for `y ∈ H_n` over `w`,
`γ_{n-1}^A γ_j y = y_n q_a (w) (F_a (w), 1)`. So `F_a` is the projective action of
`γ_{n-1}^A γ_j`, and the last coordinate grows by the factor `q_a (w)`. -/
theorem linearMove_last_pow_linearMove_of_mem_orderedCone (a : ℕ × Fin d)
    {y : Fin (d + 2) → ℝ} (hy : y ∈ orderedCone d) :
    (linearMove (Fin.last d) ^ a.1) (linearMove a.2.castSucc y) =
      (y (Fin.last _) * branchDenom a (simplexChart y)) •
        simplexLift (branchMap a (simplexChart y)) := by
  have hq := branchDenom_pos_of_mem_orderedSimplex a (simplexChart_mem_orderedSimplex hy)
  conv_lhs => rw [← last_smul_simplexLift_simplexChart hy]
  rw [map_smul, map_smul, linearMove_last_pow_linearMove_simplexLift a hq.ne', smul_smul]

/-- The accelerated element `γ_{n-1}^A γ_j` maps the ordered cone into itself. -/
theorem linearMove_last_pow_linearMove_mem_orderedCone (a : ℕ × Fin d) {y : Fin (d + 2) → ℝ}
    (hy : y ∈ orderedCone d) :
    (linearMove (Fin.last d) ^ a.1) (linearMove a.2.castSucc y) ∈ orderedCone d := by
  have hx := simplexChart_mem_orderedSimplex hy
  have hq := branchDenom_pos_of_mem_orderedSimplex a hx
  rw [linearMove_last_pow_linearMove_of_mem_orderedCone a hy]
  exact smul_mem_orderedCone (simplexLift_mem_orderedCone (branchMap_mem_orderedSimplex a hx))
    (mul_pos (pos_last_of_mem_orderedCone hy) hq)

end TauCeti
