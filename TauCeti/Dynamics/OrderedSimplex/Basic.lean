/-!
# The ordered projective simplex

For `n = d + 2 ≥ 2`, the *ordered cone* `H_n ⊆ ℝⁿ` consists of the nonzero `y` with
`0 ≤ y₁ ≤ ⋯ ≤ y_n` and `y₁ + ⋯ + y_{n-1} = y_n`, and the *ordered projective simplex*
`Δ_n = H_n / ℝ_{>0}` is the set of `w = (w₁, …, w_{n-1})` with `0 ≤ w₁ ≤ ⋯ ≤ w_{n-1}` and
`∑ wᵢ = 1`. Its linear span is the hyperplane `coneSpan d = {y | y₁ + ⋯ + y_{n-1} = y_n}`, of
dimension `d + 1` with basis `e_j + e_n`. Following Gamburd, Magee and Ronan, the semigroup
generated by the linear maps `γ_j (y) = (y₁, …, y_{j-1}, y_{j+1}, …, y_n, ∑_{k ≠ j} y_k)` acts on
`H_n`, and its accelerated branches act on `Δ_n`.

We work in the chart `x = (w₁, …, w_d) ∈ ℝ^d`, with `w_{d+1} = 1 - ∑ xᵢ` recovered from the sum
relation: `orderedSimplex d` is the chart image of `Δ_n`. Its dimension is `d`, so it has nonempty
interior in `ℝ^d` and derivatives within it are unique; this is the domain on which the transfer
operators of the accelerated branches act on `C¹` functions.

## Main definitions

* `TauCeti.orderedSimplex d`: the chart image of `Δ_{d+2}` in `Fin d → ℝ`.
* `TauCeti.simplexPoint x`: the point `(w₁, …, w_{d+1})` of `Δ_{d+2}` with chart coordinates `x`.
* `TauCeti.orderedCone d`: the cone `H_{d+2}` in `Fin (d + 2) → ℝ`.
* `TauCeti.coneSpan d`, `TauCeti.coneSpanBasis d`: the hyperplane spanned by `H_{d+2}` and its
  basis `e_j + e_n`.
* `TauCeti.simplexChart y`: the normalisation `y ↦ (y₁ / y_n, …, y_d / y_n)` of `H_{d+2}`.
* `TauCeti.simplexLift x`: the point `(w, 1)` of `H_{d+2}` over `x`.

## Main results

* `TauCeti.mem_orderedSimplex_iff_simplexPoint`: `x` lies in the chart exactly when the full
  point `w` has nonnegative nondecreasing coordinates.
* `TauCeti.isCompact_orderedSimplex`, `TauCeti.convex_orderedSimplex`,
  `TauCeti.interior_orderedSimplex_nonempty`, `TauCeti.uniqueDiffOn_orderedSimplex`: the chart is
  a compact convex body.
* `TauCeti.le_one_half_of_mem_orderedSimplex`, `TauCeti.inv_succ_le_one_sub_sum`: every chart
  coordinate is at most `1 / 2`, and the last coordinate `w_{d+1}` is at least `1 / (d + 1)`.
* `TauCeti.pos_last_of_mem_orderedCone`, `TauCeti.simplexChart_eq_simplexChart_iff`,
  `TauCeti.last_smul_simplexLift_simplexChart`, `TauCeti.image_simplexChart_orderedCone`: the
  normalisation identifies the positive rays of `H_{d+2}` with the points of the chart.
* `TauCeti.finrank_coneSpan`, `TauCeti.span_orderedCone_eq_coneSpan`: the linear span of
  `H_{d+2}` is the `(d + 1)`-dimensional hyperplane `coneSpan d`.

## References

* A. Gamburd, M. Magee, R. Ronan, *An asymptotic formula for integer points on Markoff–Hurwitz
  varieties*, Ann. of Math. 190 (2019), (1.5), §4.1 and §5.1.
-/

public section

open Set

namespace TauCeti

variable {d : ℕ}

/-! ### The chart -/

/-- The ordered projective simplex `Δ_{d+2}` in chart coordinates: the points `x : Fin d → ℝ`
with `0 ≤ x₀ ≤ ⋯ ≤ x_{d-1} ≤ 1 - ∑ xᵢ`. Here `x i = w_{i+1}` and the last coordinate
`w_{d+1} = 1 - ∑ xᵢ` is determined by the sum relation `∑ wᵢ = 1`. -/
def orderedSimplex (d : ℕ) : Set (Fin d → ℝ) :=
  {x | (∀ i, 0 ≤ x i) ∧ Monotone x ∧ ∀ i, x i ≤ 1 - ∑ k, x k}

theorem mem_orderedSimplex_iff {x : Fin d → ℝ} :
    x ∈ orderedSimplex d ↔ (∀ i, 0 ≤ x i) ∧ Monotone x ∧ ∀ i, x i ≤ 1 - ∑ k, x k :=
  Iff.rfl

/-- The point `w = (w₁, …, w_{d+1})` of the simplex with chart coordinates `x`: the chart
coordinates followed by `w_{d+1} = 1 - ∑ xᵢ`. -/
def simplexPoint (x : Fin d → ℝ) : Fin (d + 1) → ℝ :=
  Fin.snoc x (1 - ∑ k, x k)

@[simp]
theorem simplexPoint_castSucc (x : Fin d → ℝ) (i : Fin d) : simplexPoint x i.castSucc = x i :=
  Fin.snoc_castSucc ..

@[simp]
theorem simplexPoint_last (x : Fin d → ℝ) : simplexPoint x (Fin.last d) = 1 - ∑ k, x k :=
  Fin.snoc_last ..

@[simp]
theorem sum_simplexPoint (x : Fin d → ℝ) : ∑ i, simplexPoint x i = 1 := by
  simp [Fin.sum_univ_castSucc]

/-- Each coordinate of the full point is an affine, hence smooth, function of the chart
coordinates. -/
@[fun_prop]
theorem contDiff_simplexPoint_apply (k : Fin (d + 1)) {n : WithTop ℕ∞} :
    ContDiff ℝ n fun x : Fin d → ℝ => simplexPoint x k := by
  induction k using Fin.lastCases with
  | last => simp only [simplexPoint_last]; fun_prop
  | cast i => simp only [simplexPoint_castSucc]; fun_prop

/-- On the ordered simplex the last coordinate `w_{d+1} = 1 - ∑ xᵢ` is at least `1 / (d + 1)`:
it dominates the `d` chart coordinates, and all `d + 1` coordinates sum to `1`. This uses only the
upper bounds `xᵢ ≤ w_{d+1}`. -/
theorem inv_succ_le_one_sub_sum {x : Fin d → ℝ} (hx : ∀ i, x i ≤ 1 - ∑ k, x k) :
    ((d : ℝ) + 1)⁻¹ ≤ 1 - ∑ k, x k := by
  have hsum := Finset.sum_le_sum fun k (_ : k ∈ Finset.univ) => hx k
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at hsum
  rw [inv_le_iff_one_le_mul₀ (by positivity)]
  linarith

/-- Appending a coordinate that bounds all previous coordinates preserves monotonicity. -/
theorem monotone_snoc {n : ℕ} {α : Type*} [Preorder α] {f : Fin n → α} {a : α}
    (hf : Monotone f) (ha : ∀ i, f i ≤ a) :
    Monotone (Fin.snoc (α := fun _ => α) f a) := by
  cases n with
  | zero => rw [Fin.monotone_iff_le_succ]; exact fun i => Fin.elim0 i
  | succ m =>
    rw [← Fin.insertNth_last']
    exact Fin.insertNth_last_monotone hf a (ha (Fin.last m))

/-- Appending a coordinate strictly above all previous coordinates preserves strict
monotonicity. -/
theorem strictMono_snoc {n : ℕ} {α : Type*} [Preorder α] {f : Fin n → α} {a : α}
    (hf : StrictMono f) (ha : ∀ i, f i < a) :
    StrictMono (Fin.snoc (α := fun _ => α) f a) := by
  cases n with
  | zero => rw [Fin.strictMono_iff_lt_succ]; exact fun i => Fin.elim0 i
  | succ m =>
    rw [← Fin.insertNth_last']
    exact Fin.strictMono_insertNth_last hf a (ha (Fin.last m))

/-- A chart point lies in the ordered simplex exactly when its full point `w` has nonnegative
nondecreasing coordinates. -/
theorem mem_orderedSimplex_iff_simplexPoint {x : Fin d → ℝ} :
    x ∈ orderedSimplex d ↔ (∀ i, 0 ≤ simplexPoint x i) ∧ Monotone (simplexPoint x) := by
  refine ⟨fun ⟨h0, hmono, hlast⟩ => ⟨fun i => ?_, monotone_snoc hmono hlast⟩,
    fun ⟨h0, hmono⟩ => ⟨fun i => by simpa using h0 i.castSucc, fun i j hij => ?_, fun i => ?_⟩⟩
  · have hpos : (0 : ℝ) < ((d : ℝ) + 1)⁻¹ := by positivity
    refine Fin.lastCases ?_ (fun i => ?_) i
    · simpa using hpos.le.trans (inv_succ_le_one_sub_sum hlast)
    · simpa using h0 i
  · simpa using hmono (Fin.castSucc_le_castSucc_iff.mpr hij)
  · simpa using hmono (Fin.le_last i.castSucc)

/-- The coordinates of the full point of a chart point of the ordered simplex are at most `1`. -/
theorem simplexPoint_le_one {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) (i : Fin (d + 1)) :
    simplexPoint x i ≤ 1 := by
  have h0 := (mem_orderedSimplex_iff_simplexPoint.mp hx).1
  rw [← sum_simplexPoint x]
  exact Finset.single_le_sum (fun k _ => h0 k) (Finset.mem_univ i)

/-- Every chart coordinate of the ordered simplex is at most `1 / 2`: it is at most the last
coordinate `w_{d+1}`, and the two have sum at most `1`. -/
theorem le_one_half_of_mem_orderedSimplex {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d)
    (i : Fin d) : x i ≤ 1 / 2 := by
  have : x i ≤ ∑ k, x k :=
    Finset.single_le_sum (fun k _ => hx.1 k) (Finset.mem_univ i)
  linarith [hx.2.2 i]

/-- The ordered simplex lies in the cube `[0, 1 / 2]^d`. -/
theorem orderedSimplex_subset_Icc : orderedSimplex d ⊆ Icc 0 (fun _ => 1 / 2) :=
  fun _ hx => ⟨hx.1, le_one_half_of_mem_orderedSimplex hx⟩

/-- The ordered simplex is convex: it is cut out by linear inequalities. -/
theorem convex_orderedSimplex (d : ℕ) : Convex ℝ (orderedSimplex d) := by
  intro x hx y hy a b ha hb hab
  refine ⟨fun i => ?_, fun i j hij => ?_, fun i => ?_⟩
  · simpa using add_nonneg (mul_nonneg ha (hx.1 i)) (mul_nonneg hb (hy.1 i))
  · simpa using add_le_add (mul_le_mul_of_nonneg_left (hx.2.1 hij) ha)
      (mul_le_mul_of_nonneg_left (hy.2.1 hij) hb)
  · have hxi := mul_le_mul_of_nonneg_left (hx.2.2 i) ha
    have hyi := mul_le_mul_of_nonneg_left (hy.2.2 i) hb
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_add_distrib,
      ← Finset.mul_sum]
    linear_combination hxi + hyi + hab

/-- The ordered simplex is closed: it is cut out by non-strict inequalities. -/
theorem isClosed_orderedSimplex (d : ℕ) : IsClosed (orderedSimplex d) := by
  have hsum : Continuous fun x : Fin d → ℝ => 1 - ∑ k, x k := by fun_prop
  simp only [orderedSimplex, ofPred_and, ofPred_forall]
  exact (isClosed_iInter fun i => isClosed_le continuous_const (continuous_apply i)).inter
    (isClosed_monotone.inter (isClosed_iInter fun i => isClosed_le (continuous_apply i) hsum))

/-- The ordered simplex is compact. -/
theorem isCompact_orderedSimplex (d : ℕ) : IsCompact (orderedSimplex d) :=
  isCompact_Icc.of_isClosed_subset (isClosed_orderedSimplex d) orderedSimplex_subset_Icc

/-- A chart point with positive, strictly increasing coordinates, all below the last coordinate
`1 - ∑ xᵢ`, is an interior point of the ordered simplex. -/
theorem mem_interior_orderedSimplex {x : Fin d → ℝ} (h0 : ∀ i, 0 < x i) (hmono : StrictMono x)
    (hlast : ∀ i, x i < 1 - ∑ k, x k) : x ∈ interior (orderedSimplex d) := by
  let U : Set (Fin d → ℝ) := {y | (∀ i, 0 < y i) ∧ (∀ i j, i < j → y i < y j) ∧
    ∀ i, y i < 1 - ∑ k, y k}
  have hU : IsOpen U := by
    have hsum : Continuous fun y : Fin d → ℝ => 1 - ∑ k, y k := by fun_prop
    simp only [U, ofPred_and, ofPred_forall]
    exact (isOpen_iInter_of_finite fun i => isOpen_lt continuous_const (continuous_apply i)).inter
      ((isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
        isOpen_iInter_of_finite fun _ => isOpen_lt (continuous_apply i) (continuous_apply j)).inter
        (isOpen_iInter_of_finite fun i => isOpen_lt (continuous_apply i) hsum))
  refine interior_maximal (s := orderedSimplex d) (t := U) (fun y hy => ?_) hU
    ⟨h0, fun i j hij => hmono hij, hlast⟩
  obtain ⟨hy0, hymono, hylast⟩ := hy
  exact ⟨fun i => (hy0 i).le, StrictMono.monotone fun i j hij => hymono i j hij,
    fun i => (hylast i).le⟩

/-- The ordered simplex has nonempty interior in `ℝ^d`: the point `wᵢ = 2 i / (n (n - 1))`,
`n = d + 2`, is an interior point. -/
theorem interior_orderedSimplex_nonempty (d : ℕ) : (interior (orderedSimplex d)).Nonempty := by
  have hpos : (0 : ℝ) < (d + 1) * (d + 2) := by positivity
  set x : Fin d → ℝ := fun i => 2 * ((i : ℝ) + 1) / ((d + 1) * (d + 2)) with hx
  have hsum : 1 - ∑ k, x k = 2 * ((d : ℝ) + 1) / ((d + 1) * (d + 2)) := by
    have hgauss (n : ℕ) : ∑ i : Fin n, 2 * ((i : ℝ) + 1) = n * (n + 1) := by
      induction n with
      | zero => simp
      | succ n ih =>
        rw [Fin.sum_univ_castSucc]
        simp only [Fin.val_castSucc, Fin.val_last, ih]
        push_cast
        ring
    rw [hx, ← Finset.sum_div, hgauss]
    field_simp
    ring
  refine ⟨x, mem_interior_orderedSimplex (fun i => by positivity) (fun i j hij => ?_)
    (fun i => ?_)⟩
  · exact div_lt_div_of_pos_right (by simp [Fin.lt_def.mp hij]) hpos
  · rw [hsum]
    exact div_lt_div_of_pos_right (by simp) hpos

/-- Derivatives within the ordered simplex are unique. -/
theorem uniqueDiffOn_orderedSimplex (d : ℕ) : UniqueDiffOn ℝ (orderedSimplex d) :=
  uniqueDiffOn_convex (convex_orderedSimplex d) (interior_orderedSimplex_nonempty d)

/-! ### The ordered cone and its normalisation -/

/-- The ordered cone `H_{d+2}`: the nonzero `y : Fin (d + 2) → ℝ` with nonnegative nondecreasing
coordinates whose first `d + 1` coordinates sum to the last. -/
def orderedCone (d : ℕ) : Set (Fin (d + 2) → ℝ) :=
  {y | y ≠ 0 ∧ (∀ i, 0 ≤ y i) ∧ Monotone y ∧ ∑ i : Fin (d + 1), y i.castSucc = y (Fin.last _)}

theorem mem_orderedCone_iff {y : Fin (d + 2) → ℝ} :
    y ∈ orderedCone d ↔ y ≠ 0 ∧ (∀ i, 0 ≤ y i) ∧ Monotone y ∧
      ∑ i : Fin (d + 1), y i.castSucc = y (Fin.last _) :=
  Iff.rfl

/-- Every point of the ordered cone has positive last coordinate. -/
theorem pos_last_of_mem_orderedCone {y : Fin (d + 2) → ℝ} (hy : y ∈ orderedCone d) :
    0 < y (Fin.last _) := by
  refine (hy.2.1 _).lt_of_ne fun h => hy.1 (funext fun i => ?_)
  rw [Pi.zero_apply]
  exact le_antisymm ((hy.2.2.1 (Fin.le_last i)).trans h.ge) (hy.2.1 i)

/-- The ordered cone is stable under positive scaling. -/
theorem smul_mem_orderedCone {y : Fin (d + 2) → ℝ} (hy : y ∈ orderedCone d) {c : ℝ}
    (hc : 0 < c) : c • y ∈ orderedCone d := by
  refine ⟨smul_ne_zero hc.ne' hy.1, fun i => mul_nonneg hc.le (hy.2.1 i),
    fun i j hij => mul_le_mul_of_nonneg_left (hy.2.2.1 hij) hc.le, ?_⟩
  simp [← Finset.mul_sum, hy.2.2.2]

/-- Appending the coordinate sum of a nonzero, nonnegative, monotone vector in `ℝ^{d+1}` yields a
point of `orderedCone d`. -/
theorem snoc_sum_mem_orderedCone {f : Fin (d + 1) → ℝ} (hne : f ≠ 0) (h0 : ∀ i, 0 ≤ f i)
    (hmono : Monotone f) :
    Fin.snoc (α := fun _ => ℝ) f (∑ i, f i) ∈ orderedCone d := by
  refine ⟨fun h => hne (funext fun i => by simpa using congrFun h i.castSucc),
    Fin.lastCases (by simpa using Finset.sum_nonneg fun i _ => h0 i)
      (fun i => by simpa using h0 i),
    monotone_snoc hmono fun i => Finset.single_le_sum (fun m _ => h0 m) (Finset.mem_univ i),
    by simp⟩

/-- The normalisation `y ↦ (y₁ / y_n, …, y_d / y_n)` of the ordered cone, in chart
coordinates. -/
noncomputable def simplexChart (y : Fin (d + 2) → ℝ) : Fin d → ℝ :=
  fun i => y i.castSucc.castSucc / y (Fin.last _)

@[simp]
theorem simplexChart_apply (y : Fin (d + 2) → ℝ) (i : Fin d) :
    simplexChart y i = y i.castSucc.castSucc / y (Fin.last _) :=
  (rfl)

/-- On the ordered cone, the full point of the normalisation is `(y₁ / y_n, …, y_{d+1} / y_n)`. -/
theorem simplexPoint_simplexChart {y : Fin (d + 2) → ℝ} (hy : y ∈ orderedCone d)
    (i : Fin (d + 1)) : simplexPoint (simplexChart y) i = y i.castSucc / y (Fin.last _) := by
  have hn := (pos_last_of_mem_orderedCone hy).ne'
  refine Fin.lastCases ?_ (fun i => by simp) i
  have hsum := hy.2.2.2
  rw [Fin.sum_univ_castSucc] at hsum
  simp only [simplexPoint_last, simplexChart_apply, ← Finset.sum_div]
  field_simp
  linarith

/-- The normalisation is invariant under nonzero scaling. -/
@[simp]
theorem simplexChart_smul (y : Fin (d + 2) → ℝ) {c : ℝ} (hc : c ≠ 0) :
    simplexChart (c • y) = simplexChart y := by
  ext i
  simp [mul_div_mul_left _ _ hc]

/-- The normalisation maps the ordered cone into the ordered simplex. -/
theorem simplexChart_mem_orderedSimplex {y : Fin (d + 2) → ℝ} (hy : y ∈ orderedCone d) :
    simplexChart y ∈ orderedSimplex d := by
  have hn := pos_last_of_mem_orderedCone hy
  refine mem_orderedSimplex_iff_simplexPoint.mpr ⟨fun i => ?_, fun i j hij => ?_⟩
  · rw [simplexPoint_simplexChart hy]
    exact div_nonneg (hy.2.1 _) hn.le
  · rw [simplexPoint_simplexChart hy, simplexPoint_simplexChart hy]
    exact div_le_div_of_nonneg_right (hy.2.2.1 (Fin.castSucc_le_castSucc_iff.mpr hij)) hn.le

/-- The point `(w, 1)` of the ordered cone over the chart point `x`. -/
def simplexLift (x : Fin d → ℝ) : Fin (d + 2) → ℝ :=
  Fin.snoc (simplexPoint x) 1

@[simp]
theorem simplexLift_castSucc (x : Fin d → ℝ) (i : Fin (d + 1)) :
    simplexLift x i.castSucc = simplexPoint x i :=
  Fin.snoc_castSucc ..

@[simp]
theorem simplexLift_last (x : Fin d → ℝ) : simplexLift x (Fin.last _) = 1 :=
  Fin.snoc_last ..

@[simp]
theorem simplexChart_simplexLift (x : Fin d → ℝ) : simplexChart (simplexLift x) = x := by
  ext i
  simp

/-- The lift `(w, 1)` of a point of the ordered simplex lies in the ordered cone. -/
theorem simplexLift_mem_orderedCone {x : Fin d → ℝ} (hx : x ∈ orderedSimplex d) :
    simplexLift x ∈ orderedCone d := by
  obtain ⟨h0, hmono⟩ := mem_orderedSimplex_iff_simplexPoint.mp hx
  have hle := simplexPoint_le_one hx
  refine ⟨fun h => by simpa using congrFun h (Fin.last _), fun i => ?_, ?_, by simp⟩
  · exact Fin.lastCases (by simp) (fun i => by simpa using h0 i) i
  · rw [Fin.monotone_iff_le_succ]
    intro i
    refine Fin.lastCases ?_ (fun i => ?_) i
    · simpa [Fin.succ_last] using hle (Fin.last d)
    · rw [Fin.succ_castSucc, simplexLift_castSucc, simplexLift_castSucc]
      exact hmono (Fin.castSucc_le_succ i)

/-- Scaling the lift of the normalisation by the last coordinate recovers a point of the
ordered cone. -/
theorem last_smul_simplexLift_simplexChart {y : Fin (d + 2) → ℝ} (hy : y ∈ orderedCone d) :
    y (Fin.last _) • simplexLift (simplexChart y) = y := by
  have hn := (pos_last_of_mem_orderedCone hy).ne'
  ext i
  refine Fin.lastCases (by simp) (fun i => ?_) i
  simp [simplexPoint_simplexChart hy, mul_div_cancel₀ _ hn]

/-- Two points of the ordered cone have the same normalisation exactly when they lie on the same
positive ray. -/
theorem simplexChart_eq_simplexChart_iff {y y' : Fin (d + 2) → ℝ} (hy : y ∈ orderedCone d)
    (hy' : y' ∈ orderedCone d) :
    simplexChart y = simplexChart y' ↔ ∃ c : ℝ, 0 < c ∧ y' = c • y := by
  refine ⟨fun h => ?_, ?_⟩
  · have hn := pos_last_of_mem_orderedCone hy
    refine ⟨y' (Fin.last _) / y (Fin.last _), div_pos (pos_last_of_mem_orderedCone hy') hn, ?_⟩
    calc y' = y' (Fin.last _) • simplexLift (simplexChart y') :=
          (last_smul_simplexLift_simplexChart hy').symm
      _ = (y' (Fin.last _) / y (Fin.last _)) • (y (Fin.last _) • simplexLift (simplexChart y)) := by
          rw [h, smul_smul, div_mul_cancel₀ _ hn.ne']
      _ = _ := by rw [last_smul_simplexLift_simplexChart hy]
  · rintro ⟨c, hc, rfl⟩
    exact (simplexChart_smul y hc.ne').symm

/-- The normalisation maps the ordered cone onto the ordered simplex. -/
theorem image_simplexChart_orderedCone (d : ℕ) :
    simplexChart '' orderedCone d = orderedSimplex d := by
  refine Subset.antisymm ?_ fun x hx => ⟨simplexLift x, simplexLift_mem_orderedCone hx, by simp⟩
  rintro _ ⟨y, hy, rfl⟩
  exact simplexChart_mem_orderedSimplex hy

/-! ### Basis and linear span of the ordered cone -/

/-- The hyperplane `{y : Fin (d + 2) → ℝ | ∑ i : Fin (d + 1), y i.castSucc = y (Fin.last (d + 1))}`
spanned by `orderedCone d`. -/
def coneSpan (d : ℕ) : Submodule ℝ (Fin (d + 2) → ℝ) where
  carrier := {y | ∑ i : Fin (d + 1), y i.castSucc = y (Fin.last (d + 1))}
  add_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq, Pi.add_apply, Finset.sum_add_distrib] at hx hy ⊢; linarith
  zero_mem' := by simp
  smul_mem' c {x} hx := by
    simp only [Set.mem_ofPred_eq, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum] at hx ⊢; rw [hx]

/-- Membership in `coneSpan d`. -/
@[simp]
theorem mem_coneSpan_iff {y : Fin (d + 2) → ℝ} :
    y ∈ coneSpan d ↔ ∑ i : Fin (d + 1), y i.castSucc = y (Fin.last (d + 1)) :=
  (Iff.rfl)

/-- Every point of `orderedCone d` lies in `coneSpan d`. -/
theorem orderedCone_subset_coneSpan (d : ℕ) :
    orderedCone d ⊆ (coneSpan d : Set (Fin (d + 2) → ℝ)) :=
  fun _ hy => hy.2.2.2

/-- The vectors `e_j + e_n` (`j : Fin (d + 1)`) form a basis of `coneSpan d`. -/
noncomputable def coneSpanBasis (d : ℕ) : Module.Basis (Fin (d + 1)) ℝ (coneSpan d) := by
  classical
  refine Module.Basis.ofEquivFun
    { toFun := fun y i => (y : Fin (d + 2) → ℝ) i.castSucc
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      invFun := fun c => ⟨Fin.snoc c (∑ i, c i), by simp⟩
      left_inv := fun y => Subtype.ext <| funext <|
        Fin.lastCases (by simp only [Fin.snoc_last]; exact y.property) (fun _ => by simp)
      right_inv := fun c => funext fun _ => by simp }

/-- The `j`-th coordinate of `y ∈ coneSpan d` in `coneSpanBasis d` is `y j`. -/
@[simp]
theorem coneSpanBasis_repr_apply (d : ℕ) (y : coneSpan d) (j : Fin (d + 1)) :
    (coneSpanBasis d).repr y j = (y : Fin (d + 2) → ℝ) j.castSucc := by
  classical
  simp [coneSpanBasis]

private theorem coe_coneSpanBasis_eq_snoc (d : ℕ) (j : Fin (d + 1)) :
    (coneSpanBasis d j : Fin (d + 2) → ℝ) =
      Fin.snoc (α := fun _ => ℝ) (Pi.single j (1 : ℝ)) 1 := by
  classical
  simp [coneSpanBasis, Module.Basis.coe_ofEquivFun]

/-- The `j`-th basis vector of `coneSpanBasis d` is `e_j + e_n`. -/
@[simp]
theorem coe_coneSpanBasis (d : ℕ) (j : Fin (d + 1)) :
    (coneSpanBasis d j : Fin (d + 2) → ℝ) =
      Pi.single j.castSucc 1 + Pi.single (Fin.last (d + 1)) 1 := by
  classical
  rw [coe_coneSpanBasis_eq_snoc]
  ext i
  refine Fin.lastCases (by simp) (fun k => ?_) i
  simp only [Pi.add_apply, Fin.snoc_castSucc,
    Pi.single_eq_of_ne (Fin.castSucc_lt_last k).ne, add_zero]
  by_cases h : k = j
  · subst h; simp
  · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne (fun h' => h (Fin.castSucc_inj.1 h'))]

/-- The dimension of `coneSpan d` is `d + 1`. -/
theorem finrank_coneSpan (d : ℕ) : Module.finrank ℝ (coneSpan d) = d + 1 := by
  rw [Module.finrank_eq_card_basis (coneSpanBasis d), Fintype.card_fin]

private def stepConeVec (d : ℕ) (k : Fin (d + 1)) : Fin (d + 2) → ℝ :=
  Fin.snoc (α := fun _ => ℝ) (fun i : Fin (d + 1) => if k ≤ i then (1 : ℝ) else 0)
    (∑ i : Fin (d + 1), if k ≤ i then (1 : ℝ) else 0)

private theorem stepConeVec_mem_orderedCone (d : ℕ) (k : Fin (d + 1)) :
    stepConeVec d k ∈ orderedCone d :=
  snoc_sum_mem_orderedCone
    (fun h => by simpa [Fin.le_last] using congrFun h (Fin.last d))
    (fun m => by split_ifs <;> norm_num)
    fun i j hij => by
      split_ifs with h1 h2
      · exact le_rfl
      · exact absurd (h1.trans hij) h2
      · norm_num
      · exact le_rfl

private theorem stepConeVec_last_eq (d : ℕ) :
    (coneSpanBasis d (Fin.last d) : Fin (d + 2) → ℝ) = stepConeVec d (Fin.last d) := by
  classical
  rw [coe_coneSpanBasis_eq_snoc]
  ext i
  refine Fin.lastCases ?_ (fun m => ?_) i
  · simp only [stepConeVec, Fin.snoc_last]
    rw [Finset.sum_eq_single (Fin.last d) (fun b _ hb => by
      simp [not_le.2 (lt_of_le_of_ne (Fin.le_last b) hb)]) (by simp)]
    simp
  · simp only [stepConeVec, Fin.snoc_castSucc, Pi.single_apply, Fin.last_le_iff]

private theorem stepConeVec_sub_eq (d : ℕ) (k : Fin d) :
    (coneSpanBasis d k.castSucc : Fin (d + 2) → ℝ) =
      stepConeVec d k.castSucc - stepConeVec d k.succ := by
  classical
  have hstep : ∀ m : Fin (d + 1),
      (if k.castSucc ≤ m then (1 : ℝ) else 0) - (if k.succ ≤ m then (1 : ℝ) else 0) =
        (Pi.single k.castSucc (1 : ℝ) : Fin (d + 1) → ℝ) m := fun m => by
    simp only [Pi.single_apply]
    by_cases hmk : m = k.castSucc
    · subst hmk; simp [not_le.2 k.castSucc_lt_succ]
    · by_cases hkb : k.castSucc ≤ m
      · have hsucc : k.succ ≤ m := by
          rw [Fin.le_iff_val_le_val] at hkb ⊢
          have : m.val ≠ k.val := fun h => hmk (Fin.ext h)
          simp only [Fin.val_succ, Fin.val_castSucc] at hkb ⊢; omega
        simp [hmk, hkb, hsucc]
      · have hnot : ¬ k.succ ≤ m := fun h => hkb (k.castSucc_lt_succ.le.trans h)
        simp [hmk, hkb, hnot]
  rw [coe_coneSpanBasis_eq_snoc]
  ext i
  refine Fin.lastCases ?_ (fun m => by simp [stepConeVec, hstep]) i
  simp only [stepConeVec, Fin.snoc_last, Pi.sub_apply, ← Finset.sum_sub_distrib, hstep]
  simp

private theorem coneSpanBasis_mem_span_orderedCone (d : ℕ) (j : Fin (d + 1)) :
    (coneSpanBasis d j : Fin (d + 2) → ℝ) ∈ Submodule.span ℝ (orderedCone d) :=
  Fin.lastCases (stepConeVec_last_eq d ▸ Submodule.subset_span (stepConeVec_mem_orderedCone d _))
    (fun k => stepConeVec_sub_eq d k ▸ Submodule.sub_mem _
      (Submodule.subset_span (stepConeVec_mem_orderedCone d k.castSucc))
      (Submodule.subset_span (stepConeVec_mem_orderedCone d k.succ))) j

/-- The linear span of `orderedCone d` equals the hyperplane `coneSpan d`. -/
theorem span_orderedCone_eq_coneSpan (d : ℕ) :
    Submodule.span ℝ (orderedCone d) = coneSpan d := by
  refine le_antisymm (Submodule.span_le.2 (orderedCone_subset_coneSpan d)) fun y hy => ?_
  have hval : y = ∑ j : Fin (d + 1),
      (coneSpanBasis d).repr ⟨y, hy⟩ j • (coneSpanBasis d j : Fin (d + 2) → ℝ) := by
    simpa using congrArg Subtype.val ((coneSpanBasis d).sum_repr ⟨y, hy⟩).symm
  rw [hval]
  exact Submodule.sum_mem _ fun j _ =>
    Submodule.smul_mem _ _ (coneSpanBasis_mem_span_orderedCone d j)

end TauCeti
