module

public import TauCeti.ModelTheory.ModelExistence.Presentation
public import Mathlib.ModelTheory.Satisfiability

/-!
# Finiteness and the omitted types in a first-order presentation

Over the empty language, finiteness is the countable disjunction of the first-order sentences
asserting each exact finite cardinality. Every finite set has a canonical Morley expansion
satisfying the first-order presentation with the name of this disjunction asserted.
First-order compactness nevertheless gives an infinite model of the same theory. In that model
the disjunction's name holds and all its component names fail: the model realizes exactly the
obstruction type that the presentation requires us to omit.

This example follows D. Marker, *Lectures on Infinitary Model Theory*, Cambridge University
Press, 2016, Chapter 1. The compactness step uses Mathlib's first-order satisfiability API.
-/

public section

universe w

open FirstOrder FirstOrder.Language

namespace TauCeti.FinitenessPresentation

/-- The first-order pure-equality sentence asserting that there are exactly `n` elements. -/
def exactCard (n : ℕ) : Language.empty.Sentence :=
  Sentence.cardGe Language.empty n ⊓ (Sentence.cardGe Language.empty (n + 1)).not

/-- The exact-size sentence uses the two consecutive Mathlib cardinality bounds. -/
theorem exactCard_def (n : ℕ) :
    exactCard n =
      Sentence.cardGe Language.empty n ⊓ (Sentence.cardGe Language.empty (n + 1)).not := (rfl)

/-- Exact finite cardinality means cardinality at least `n` and less than `n + 1`. -/
@[simp]
theorem realize_exactCard_iff (n : ℕ) (M : Type w) [Language.empty.Structure M] :
    M ⊨ exactCard n ↔ (n : Cardinal) ≤ Cardinal.mk M ∧ Cardinal.mk M < n + 1 := by
  simp [exactCard]

/-- Finiteness as the disjunction of the exact finite cardinalities, including zero. -/
def finitenessSentence : Language.empty.Sentenceω :=
  .iSup fun n => (exactCard n).toOmega

/-- The finiteness sentence is the disjunction of all exact finite cardinalities. -/
theorem finitenessSentence_def :
    finitenessSentence = .iSup (fun n => (exactCard n).toOmega) := (rfl)

/-- The component-closed fragment generated by the finiteness sentence. -/
def finitenessFragment : Fragment Language.empty :=
  Fragment.ofSentence finitenessSentence

/-- The fragment is generated by the single finiteness sentence. -/
theorem finitenessFragment_def :
    finitenessFragment = Fragment.ofSentence finitenessSentence := (rfl)

/-- The generating sentence belongs to its fragment. -/
theorem finitenessSentence_mem :
    (⟨0, finitenessSentence⟩ : Σ n, Language.empty.BoundedFormulaω Empty n) ∈
      finitenessFragment :=
  Fragment.mem_ofSentence finitenessSentence

/-- The finiteness fragment is countable. -/
theorem countable_finitenessFragment :
    (finitenessFragment : Set (Σ n, Language.empty.BoundedFormulaω Empty n)).Countable :=
  Fragment.ofSentence_countable finitenessSentence

/-- The exact-size disjuncts belong to the generated fragment. -/
theorem exactCard_mem (n : ℕ) :
    (⟨0, (exactCard n).toOmega⟩ : Σ n, Language.empty.BoundedFormulaω Empty n) ∈
      finitenessFragment :=
  finitenessFragment.iSup_mem finitenessSentence_mem n

/-- The disjunction of exact finite cardinalities characterizes finite carriers. -/
@[simp]
theorem realize_finitenessSentence_iff (M : Type w) [Language.empty.Structure M] :
    SentenceInf.Realize finitenessSentence M ↔ Finite M := by
  simp only [finitenessSentence, SentenceInf.realize_iSup, Sentence.realize_toInf,
    realize_exactCard_iff]
  constructor
  · rintro ⟨n, _, hlt⟩
    exact Cardinal.lt_aleph0_iff_finite.1
      (hlt.trans (by simpa only [Nat.cast_add, Nat.cast_one] using
        (Cardinal.natCast_lt_aleph0 (n := n + 1))))
  · intro hfin
    let := Fintype.ofFinite M
    refine ⟨Fintype.card M, ?_, ?_⟩
    · simp [Cardinal.mk_fintype]
    · simp [Cardinal.mk_fintype]

/-- The first-order Morley theory with the name of finiteness asserted. -/
def finitenessTheory : (morleyize Language.empty finitenessFragment).Theory :=
  insert (morleyAtom finitenessFragment finitenessSentence finitenessSentence_mem).alls
    (morleyTheory finitenessFragment)

/-- The first-order theory is the Morley theory together with the asserted root name. -/
theorem finitenessTheory_def :
    finitenessTheory =
      insert (morleyAtom finitenessFragment finitenessSentence finitenessSentence_mem).alls
        (morleyTheory finitenessFragment) := (rfl)

/-- Membership in the first-order presentation with its root name asserted. -/
@[simp]
theorem mem_finitenessTheory_iff {σ : (morleyize Language.empty finitenessFragment).Sentence} :
    σ ∈ finitenessTheory ↔
      σ = (morleyAtom finitenessFragment finitenessSentence finitenessSentence_mem).alls ∨
        σ ∈ morleyTheory finitenessFragment :=
  Set.mem_insert_iff

/-- The asserted first-order theory is countable. -/
theorem countable_finitenessTheory : finitenessTheory.Countable :=
  (countable_morleyTheory (A := finitenessFragment) countable_finitenessFragment).insert _

/-- Every finite carrier's canonical expansion satisfies the asserted first-order theory. -/
theorem finite_morleyExpansion_model (M : Type w) [Language.empty.Structure M] [Finite M] :
    let := morleyExpansion
      (finitenessFragment : Set (Σ n, Language.empty.BoundedFormulaω Empty n)) M
    M ⊨ finitenessTheory := by
  let := morleyExpansion
    (finitenessFragment : Set (Σ n, Language.empty.BoundedFormulaω Empty n)) M
  refine Theory.model_insert_iff.2 ⟨?_, morleyTheory_model finitenessFragment⟩
  rw [Sentence.realize_alls]
  intro a
  simpa only [realize_morleyAtom, morleyExpansion_relMap_morleyRel,
    SentenceInf.realize_def, FormulaInf.realize_def, Subsingleton.elim a default] using
    (realize_finitenessSentence_iff M).2 (inferInstance : Finite M)

/-- The explicit type attached to the root disjunction. It asserts finiteness's name and
negates the name of every exact-size disjunct. -/
def finitenessType : Set ((morleyize Language.empty finitenessFragment).BoundedFormula Empty 0) :=
  morleySupType finitenessFragment (fun n => (exactCard n).toOmega) finitenessSentence_mem

/-- The root type is precisely the generic disjunction obstruction type. -/
theorem finitenessType_def :
    finitenessType =
      morleySupType finitenessFragment (fun n => (exactCard n).toOmega)
        (by simpa only [finitenessSentence_def] using finitenessSentence_mem) := (rfl)

/-- The members of the root obstruction type. -/
@[simp]
theorem mem_finitenessType_iff
    {ψ : (morleyize Language.empty finitenessFragment).BoundedFormula Empty 0} :
    ψ ∈ finitenessType ↔
      ψ = morleyAtom finitenessFragment finitenessSentence finitenessSentence_mem ∨
        ∃ n, (morleyAtom finitenessFragment (exactCard n).toOmega (exactCard_mem n)).not = ψ :=
  mem_morleySupType finitenessFragment finitenessSentence_mem

/-- This is one of the obstruction types of the generated fragment. -/
theorem finitenessType_mem_morleyTypes :
    (⟨0, finitenessType⟩ : Σ n,
      Set ((morleyize Language.empty finitenessFragment).BoundedFormula Empty n)) ∈
        morleyTypes finitenessFragment :=
  morleySupType_mem_morleyTypes finitenessFragment _ finitenessSentence_mem

/-- The root obstruction type is countable. -/
theorem countable_finitenessType : finitenessType.Countable :=
  countable_of_mem_morleyTypes finitenessFragment finitenessType_mem_morleyTypes

/-- The presentation has only countably many obstruction types. -/
theorem countable_finitenessMorleyTypes : (morleyTypes finitenessFragment).Countable :=
  countable_morleyTypes (A := finitenessFragment) countable_finitenessFragment

private def boundedTheory (n : ℕ) : (morleyize Language.empty finitenessFragment).Theory :=
  finitenessTheory ∪ Sentence.cardGe (morleyize Language.empty finitenessFragment) '' Set.Iic n

private theorem boundedTheory_isSatisfiable (n : ℕ) : (boundedTheory n).IsSatisfiable := by
  let := Language.emptyStructure (M := Fin (n + 1))
  let := morleyExpansion
    (finitenessFragment : Set (Σ n, Language.empty.BoundedFormulaω Empty n)) (Fin (n + 1))
  have h : Fin (n + 1) ⊨ boundedTheory n := by
    refine Theory.model_union_iff.2 ⟨finite_morleyExpansion_model _, ⟨?_⟩⟩
    rintro σ ⟨k, hk, rfl⟩
    rw [Sentence.realize_cardGe, Cardinal.mk_fin, Nat.cast_le]
    exact hk.trans (Nat.le_succ n)
  let := h
  exact Theory.Model.isSatisfiable (Fin (n + 1))

/-- Compactness gives an infinite model of the asserted first-order presentation, although
its canonical finite models have arbitrarily large finite cardinality. -/
theorem finitenessTheory_union_infiniteTheory_isSatisfiable :
    (finitenessTheory ∪
      (morleyize Language.empty finitenessFragment).infiniteTheory).IsSatisfiable := by
  have hu : (⋃ n, boundedTheory n) =
      finitenessTheory ∪ (morleyize Language.empty finitenessFragment).infiniteTheory := by
    ext σ
    simp only [boundedTheory, Set.mem_iUnion, Set.mem_union, Set.mem_image, Set.mem_Iic,
      infiniteTheory, Set.mem_range]
    constructor
    · rintro ⟨n, h | ⟨k, _, rfl⟩⟩
      · exact Or.inl h
      · exact Or.inr ⟨k, rfl⟩
    · rintro (h | ⟨k, rfl⟩)
      · exact ⟨0, Or.inl h⟩
      · exact ⟨k, Or.inr ⟨k, le_rfl, rfl⟩⟩
  rw [← hu, Theory.isSatisfiable_directed_union_iff]
  · exact boundedTheory_isSatisfiable
  · apply Monotone.directed_le
    intro n m hnm
    exact Set.union_subset_union_right _ (Set.image_mono (Set.Iic_subset_Iic.2 hnm))

/-- Every infinite model of the asserted theory realizes the root obstruction type at the
unique empty tuple. Thus it cannot satisfy the omission requirement of the presentation. -/
theorem realizes_finitenessType (M : Type w)
    [S : (morleyize Language.empty finitenessFragment).Structure M] [Infinite M]
    (hM : M ⊨ finitenessTheory) :
    ∀ ψ ∈ finitenessType, ψ.Realize Empty.elim (Fin.elim0 : Fin 0 → M) := by
  let := (lhomMorleyize
    (finitenessFragment : Set (Σ n, Language.empty.BoundedFormulaω Empty n))).reduct M
  obtain ⟨hroot, hT⟩ := Theory.model_insert_iff.1 hM
  rw [Sentence.realize_alls] at hroot
  intro ψ hψ
  rcases mem_finitenessType_iff.1 hψ with
    rfl | ⟨n, rfl⟩
  · exact hroot _
  · rw [BoundedFormula.realize_not]
    intro hn
    have hn' := (realize_morleyAtom_toOmega_of_model_morleyTheory
      finitenessFragment hT (exactCard n) (exactCard_mem n) Fin.elim0).1 hn
    have hcard : M ⊨ exactCard n := by
      simpa only [Sentence.Realize, Formula.Realize,
        Subsingleton.elim (Empty.elim : Empty → M) default,
        Subsingleton.elim (Fin.elim0 : Fin 0 → M) default] using hn'
    have hlt := ((realize_exactCard_iff n M).1 hcard).2
    exact (not_lt_of_ge (Cardinal.aleph0_le_mk M))
      (hlt.trans (by simpa only [Nat.cast_add, Nat.cast_one] using
        (Cardinal.natCast_lt_aleph0 (n := n + 1))))

/-- An infinite nonempty model of the asserted first-order presentation exists and realizes
its explicit disjunction obstruction type. The omitted types are therefore essential. -/
theorem exists_infinite_model_realizing_finitenessType :
    ∃ M : Theory.ModelType.{0, 0, 0} finitenessTheory, Infinite M ∧
      ∀ ψ ∈ finitenessType, ψ.Realize Empty.elim (Fin.elim0 : Fin 0 → M) := by
  obtain ⟨M⟩ := finitenessTheory_union_infiniteTheory_isSatisfiable
  have hM : M ⊨ finitenessTheory := M.is_model.mono Set.subset_union_left
  have hInf : M ⊨ (morleyize Language.empty finitenessFragment).infiniteTheory :=
    M.is_model.mono Set.subset_union_right
  let := (model_infiniteTheory_iff _).1 hInf
  let := hM
  let N := Theory.ModelType.of finitenessTheory M
  have hN : Infinite N := by
    simpa only [N, Theory.ModelType.coe_of] using (inferInstance : Infinite M)
  let := hN
  exact ⟨N, hN, realizes_finitenessType N N.is_model⟩

end TauCeti.FinitenessPresentation
