module

import TauCeti.ModelTheory.ModelExistence.LowenheimSkolem
import TauCeti.ModelTheory.Order
import Mathlib.ModelTheory.Order
import Mathlib.SetTheory.Cardinal.Rat
import Mathlib.SetTheory.Cardinal.Regular

/-!
# Regression example: countable substructures of an uncountable dense linear order

The lexicographic product `ω₁ ×ₗ ℚ` of `ω₁` copies of `ℚ` is a dense linear order without
endpoints of cardinality `ℵ₁`. Let `A` be the fragment generated by the dense-linear-order axioms,
read as `L_{ω₁ω}` sentences. Every countable subset `X` of `ω₁ ×ₗ ℚ` lies in a countable nonempty
substructure `N`, nonempty even when `X` is empty, whose inclusion is elementary for `A`; so `N` is
again a dense linear order without endpoints. The order structure is placed on `ω₁ ×ₗ ℚ` only; `N`
carries the structure induced from it.
-/

open FirstOrder FirstOrder.Language Cardinal
open scoped Ordinal

-- `ω₁ ×ₗ ℚ` is a dense linear order without endpoints of cardinality `ℵ₁`, and each countable
-- subset lies in a countable nonempty substructure, elementary for the fragment generated by the
-- dense-linear-order axioms, which is again a dense linear order without endpoints.
example :
    letI := orderStructure ((ω₁ : Ordinal.{0}).ToType ×ₗ ℚ)
    #((ω₁ : Ordinal.{0}).ToType ×ₗ ℚ) = ℵ₁ ∧
    ((ω₁ : Ordinal.{0}).ToType ×ₗ ℚ) ⊨ Language.order.dlo ∧
    ∀ X : Set ((ω₁ : Ordinal.{0}).ToType ×ₗ ℚ), X.Countable →
      ∃ N : Language.order.Substructure ((ω₁ : Ordinal.{0}).ToType ×ₗ ℚ), X ⊆ N ∧ Countable N ∧
        Nonempty N ∧
        AElementary (Fragment.ofTheory (BoundedFormula.toOmega '' Language.order.dlo))
          N.subtype ∧ N ⊨ Language.order.dlo := by
  have : Nonempty (ω₁ : Ordinal.{0}).ToType :=
    Ordinal.nonempty_toType_iff.mpr (Ordinal.omega_pos 1).ne'
  let := orderStructure ((ω₁ : Ordinal.{0}).ToType ×ₗ ℚ)
  refine ⟨by simp [Cardinal.mk_congr toLex.symm, mul_aleph0_eq], inferInstance, fun X hX => ?_⟩
  -- a chosen point keeps the substructure nonempty when `X` is empty
  let m : (ω₁ : Ordinal.{0}).ToType ×ₗ ℚ := toLex (Classical.arbitrary _, 0)
  have hdlo : Language.order.dlo.Countable := by
    simp only [Language.dlo, Language.linearOrderTheory, Language.partialOrderTheory,
      Language.preorderTheory]
    exact (Set.toFinite _).countable
  obtain ⟨N, hXN, hN, hc⟩ := exists_countable_aElementary_substructure
    (Fragment.ofTheory (BoundedFormula.toOmega '' Language.order.dlo))
    (Fragment.ofTheory_countable (hdlo.image _)) (hX.insert m)
  refine ⟨N, (Set.subset_insert m X).trans hXN, hc, ⟨⟨m, hXN (Set.mem_insert m X)⟩⟩, hN, ?_⟩
  -- the axioms, as `L_{ω₁ω}` sentences of the fragment, pass down to `N`
  rw [← Theoryω.model_image_toOmega_iff, ← hN.theoryω_model_iff fun _ => Fragment.mem_ofTheory,
    Theoryω.model_image_toOmega_iff]
  infer_instance
