/-!
# Regression examples: fragment types and arity slices

These examples compute fragment types and arity slices of small fragments from a downstream
module, through public statements only:

* the type of a tuple relative to the top fragment is its complete infinitary type, relative to
  the bottom fragment it is empty, and the arity slices of `⊤` and `⊥` are everything and nothing;
* **the fragment of `∀ x, R x`.** For a unary relation symbol `R` of any language, the fragment
  generated by `∀ x, R x` has arity slice `{∀ x, R x}` at `0` and `{R x₀}` at `1`, and no other
  members: the body of a quantifier lies one arity up;
* **the fragment of `x₀ < x₁`.** In the language `{<}` with one binary relation symbol, the
  fragment generated by the atomic formula `x₀ < x₁` at arity `2` is that formula alone, since an
  atomic formula has no components. In `(ℚ, <)` the type of `(0, 1)` relative to it is
  `{x₀ < x₁}`, and that of `(1, 0)` is empty;
* **preserving fragment types needs fragment elementarity.** The inclusion `(ℤ, <) ↪ (ℚ, <)` is an
  embedding, but relative to any fragment containing the density sentence, that sentence lies in
  the type of the empty tuple of `ℚ` and not in that of `ℤ`; so the inclusion is not elementary
  for such a fragment.

The fragment types follow D. Marker, *Lectures on Infinitary Model Theory*, Cambridge University
Press, 2016, Chapter 1.
-/

public section

namespace TauCeti

open FirstOrder FirstOrder.Language

universe u v w

section Checks

variable {L : Language.{u, v}} {M : Type w} [L.Structure M] {n : ℕ}

-- Relative to the top fragment, the type of a tuple is its complete infinitary type.
example (a : Fin n → M) : fragmentType (⊤ : Fragment L) M a = infinitaryType M a := by
  simp

-- Relative to the bottom fragment, the type of every tuple is empty.
example (a : Fin n → M) : fragmentType (⊥ : Fragment L) M a = ∅ := by
  simp

-- The arity slices of the top fragment are all formulas, and those of the bottom fragment are
-- empty.
example : (⊤ : Fragment L).slice n = Set.univ ∧ (⊥ : Fragment L).slice n = ∅ := by
  simp

-- The fragment type is the set of members of the arity slice that are true of the tuple.
example (A : Fragment L) (a : Fin n → M) :
    fragmentType A M a = {φ ∈ A.slice n | φ.Realize Empty.elim a} := by
  ext
  simp

end Checks

namespace UniversalRelationExample

variable {L : Language.{u, v}} (R : L.Relations 1)

/-- The atomic formula `R x₀`, in one bound position. -/
def relAtom : L.BoundedFormulaω Empty 1 :=
  .rel R ![Term.var (Sum.inr 0)]

/-- The sentence `∀ x, R x`. -/
def allRel : L.Sentenceω :=
  (relAtom R).all

/-- The fragment generated by `∀ x, R x` consists of that sentence and its body `R x₀`. -/
theorem coe_ofSentence_allRel :
    (Fragment.ofSentence (allRel R) : Set (Σ n, L.BoundedFormulaω Empty n)) =
      {⟨0, allRel R⟩, ⟨1, relAtom R⟩} := by
  refine Set.Subset.antisymm (fun p hp => ?_) ?_
  · rw [Fragment.ofSentence_def, SetLike.mem_coe, Fragment.mem_generated] at hp
    induction hp with
    | base h => exact Or.inl h
    | all_body _ ih =>
      rcases ih with h | h <;> obtain ⟨rfl, h⟩ := Sigma.mk.inj_iff.1 h <;> cases eq_of_heq h
      exact Or.inr rfl
    | imp_left _ ih | imp_right _ ih | iInf_comp _ _ ih | iSup_comp _ _ ih =>
      rcases ih with h | h <;> obtain ⟨rfl, h⟩ := Sigma.mk.inj_iff.1 h <;> cases eq_of_heq h
  · rintro p (rfl | rfl)
    · exact Fragment.mem_ofSentence _
    · exact (Fragment.ofSentence _).all_mem (Fragment.mem_ofSentence (allRel R))

/-- At arity `0`, the fragment of `∀ x, R x` contains only that sentence. -/
theorem slice_ofSentence_allRel_zero :
    (Fragment.ofSentence (allRel R)).slice 0 = {allRel R} := by
  ext φ
  rw [Fragment.mem_slice, ← SetLike.mem_coe, coe_ofSentence_allRel]
  simp [relAtom, allRel]

/-- At arity `1`, the fragment of `∀ x, R x` contains only the body `R x₀`: the body of a
quantifier lies one arity up. -/
theorem slice_ofSentence_allRel_one :
    (Fragment.ofSentence (allRel R)).slice 1 = {relAtom R} := by
  ext φ
  rw [Fragment.mem_slice, ← SetLike.mem_coe, coe_ofSentence_allRel]
  simp [relAtom, allRel]

/-- At every arity above `1`, the fragment of `∀ x, R x` has no members. -/
theorem slice_ofSentence_allRel_of_two_le {n : ℕ} (hn : 2 ≤ n) :
    (Fragment.ofSentence (allRel R)).slice n = ∅ := by
  refine Set.eq_empty_of_forall_notMem fun φ hφ => ?_
  rw [Fragment.mem_slice, ← SetLike.mem_coe, coe_ofSentence_allRel] at hφ
  rcases hφ with h | h <;> have := congrArg Sigma.fst h <;> simp at this <;> omega

end UniversalRelationExample

namespace StrictOrderExample

/-- The relation symbols of the language `{<}`. -/
inductive Rel : ℕ → Type
  | lt : Rel 2

/-- The language `{<}`, with one binary relation symbol and no function symbols. -/
abbrev lang : Language.{0, 0} :=
  ⟨fun _ => Empty, Rel⟩

/-- A type with a strict order interprets the symbol `<` as its order. -/
instance {M : Type*} [LT M] : lang.Structure M where
  funMap f := Empty.elim f
  RelMap
    | .lt, x => x 0 < x 1

/-- The symbol `<` is interpreted as the strict order. -/
@[simp]
theorem relMap_lt {M : Type*} [LT M] (x : Fin 2 → M) :
    Structure.RelMap (L := lang) Rel.lt x ↔ x 0 < x 1 :=
  Iff.rfl

/-- The atomic formula `xᵢ < xⱼ` in the bound positions `i` and `j`. -/
def ltAt {n : ℕ} (i j : Fin n) : lang.BoundedFormulaω Empty n :=
  .rel Rel.lt ![Term.var (Sum.inr i), Term.var (Sum.inr j)]

/-- A tuple satisfies `xᵢ < xⱼ` exactly when its `i`-th entry is below its `j`-th. -/
@[simp]
theorem realize_ltAt {M : Type*} [LT M] {n : ℕ} (i j : Fin n) (v : Empty → M) (xs : Fin n → M) :
    (ltAt i j).Realize v xs ↔ xs i < xs j := by
  simp [ltAt]

/-- The formula `xᵢ < xⱼ` is atomic. -/
theorem isAtomic_ltAt {n : ℕ} (i j : Fin n) : (ltAt i j).IsAtomic :=
  .rel _ _

/-! ### The fragment of `x₀ < x₁` -/

/-- The fragment generated by the formula `x₀ < x₁` at arity `2`. -/
def ltFragment : Fragment lang :=
  Fragment.generated {⟨2, ltAt 0 1⟩}

/-- The fragment of `x₀ < x₁` is that formula alone: an atomic formula has no components. -/
theorem coe_ltFragment :
    (ltFragment : Set (Σ n, lang.BoundedFormulaω Empty n)) = {⟨2, ltAt 0 1⟩} :=
  Fragment.coe_generated_singleton_of_isAtomic (isAtomic_ltAt 0 1)

/-- At arity `2`, the fragment of `x₀ < x₁` is `{x₀ < x₁}`. -/
theorem slice_ltFragment_two : ltFragment.slice 2 = {ltAt 0 1} := by
  ext φ
  rw [Fragment.mem_slice, ← SetLike.mem_coe, coe_ltFragment]
  simp

/-- At every arity other than `2`, the fragment of `x₀ < x₁` has no members. -/
theorem slice_ltFragment_of_ne_two {n : ℕ} (hn : n ≠ 2) : ltFragment.slice n = ∅ := by
  refine Set.eq_empty_of_forall_notMem fun φ hφ => hn ?_
  rw [Fragment.mem_slice, ← SetLike.mem_coe, coe_ltFragment] at hφ
  exact congrArg Sigma.fst hφ

/-- In `(ℚ, <)`, the type of `(0, 1)` relative to the fragment of `x₀ < x₁` is `{x₀ < x₁}`. -/
theorem fragmentType_ltFragment_zero_one :
    fragmentType ltFragment ℚ ![0, 1] = {ltAt 0 1} := by
  rw [fragmentType_eq_inter, slice_ltFragment_two]
  exact Set.singleton_inter_of_mem (by simp)

/-- In `(ℚ, <)`, the type of `(1, 0)` relative to the fragment of `x₀ < x₁` is empty. -/
theorem fragmentType_ltFragment_one_zero : fragmentType ltFragment ℚ ![1, 0] = ∅ := by
  rw [fragmentType_eq_inter, slice_ltFragment_two]
  exact Set.singleton_inter_of_notMem (by simp)

/-! ### Density: fragment types need fragment elementarity -/

/-- The inclusion `(ℤ, <) ↪ (ℚ, <)`, an embedding of `{<}`-structures. -/
def intEmbedding : ℤ ↪[lang] ℚ where
  toFun := (↑)
  inj' := Int.cast_strictMono.injective
  map_fun' f := Empty.elim f
  map_rel'
    | .lt, _ => Int.cast_lt

/-- The density sentence `∀ x y, x < y → ∃ z, x < z ∧ z < y`. -/
def densitySentence : lang.Sentenceω :=
  ((ltAt 0 1).imp (ltAt 0 2 ⊓ ltAt 2 1).ex).all.all

/-- The density sentence holds exactly when between any two elements lies a third. -/
theorem realize_densitySentence_iff {M : Type*} [LT M] (a : Fin 0 → M) :
    densitySentence.Realize Empty.elim a ↔ ∀ x y : M, x < y → ∃ z, x < z ∧ z < y := by
  simp [densitySentence, Fin.snoc]

/-- The density sentence lies in the type of the empty tuple of `ℚ` relative to every fragment
containing it. -/
theorem densitySentence_mem_fragmentType_rat {A : Fragment lang}
    (hA : (⟨0, densitySentence⟩ : Σ n, lang.BoundedFormulaω Empty n) ∈ A) (a : Fin 0 → ℚ) :
    densitySentence ∈ fragmentType A ℚ a :=
  mem_fragmentType.2 ⟨hA, (realize_densitySentence_iff a).2 fun _ _ h => exists_between h⟩

/-- The density sentence does not lie in the type of the empty tuple of `ℤ` relative to any
fragment: nothing lies strictly between `0` and `1`. -/
theorem densitySentence_notMem_fragmentType_int (A : Fragment lang) (a : Fin 0 → ℤ) :
    densitySentence ∉ fragmentType A ℤ a := fun h => by
  obtain ⟨z, h₀, h₁⟩ := (realize_densitySentence_iff a).1 (mem_fragmentType.1 h).2 0 1 one_pos
  omega

/-- The inclusion `(ℤ, <) ↪ (ℚ, <)` changes the type of the empty tuple relative to every fragment
containing the density sentence. -/
theorem fragmentType_intEmbedding_comp_ne {A : Fragment lang}
    (hA : (⟨0, densitySentence⟩ : Σ n, lang.BoundedFormulaω Empty n) ∈ A) (a : Fin 0 → ℤ) :
    fragmentType A ℚ (intEmbedding ∘ a) ≠ fragmentType A ℤ a :=
  fun h => densitySentence_notMem_fragmentType_int A a
    (h ▸ densitySentence_mem_fragmentType_rat hA (intEmbedding ∘ a))

/-- The inclusion `(ℤ, <) ↪ (ℚ, <)` is an embedding but is not elementary for any fragment
containing the density sentence, so the preservation of fragment types along `A`-elementary
embeddings (`AElementary.fragmentType_comp`) does not extend to all embeddings. -/
theorem not_aElementary_intEmbedding {A : Fragment lang}
    (hA : (⟨0, densitySentence⟩ : Σ n, lang.BoundedFormulaω Empty n) ∈ A) :
    ¬AElementary A intEmbedding := fun h =>
  fragmentType_intEmbedding_comp_ne hA Fin.elim0 (h.fragmentType_comp Fin.elim0)

-- In particular the inclusion is not elementary for the fragment generated by the density
-- sentence.
example : ¬AElementary (Fragment.ofSentence densitySentence) intEmbedding :=
  not_aElementary_intEmbedding (Fragment.mem_ofSentence _)

end StrictOrderExample

end TauCeti
