module

import TauCeti.ModelTheory.ModelExistence.LowenheimSkolem

/-!
# Regression examples: downward Löwenheim–Skolem for fragments

These examples exercise the witness hull from a downstream module, through public statements
only:

* the empty structure has an `A`-elementary substructure: no nonemptiness hypothesis and no dummy
  element are needed;
* with countably many function symbols, the fragment generated by one sentence and a countable
  seed give a countable substructure, elementary for that fragment, in which the sentence holds
  exactly when it holds in the ambient structure.
-/

universe u v w

open FirstOrder FirstOrder.Language

-- The empty structure, over the empty language, has an `A`-elementary substructure.
example (A : Fragment Language.empty) :
    letI := Language.emptyStructure (M := Empty)
    ∃ N : Language.empty.Substructure Empty, AElementary A N.subtype := by
  let := Language.emptyStructure (M := Empty)
  obtain ⟨N, -, hN, -⟩ := exists_aElementary_substructure A (∅ : Set Empty)
  exact ⟨N, hN⟩

-- A countable substructure, elementary for the fragment `Fragment.ofSentence φ`, preserving `φ`.
example {L : Language.{u, v}} [Countable (Σ n, L.Functions n)] {M : Type w} [L.Structure M]
    (φ : L.Sentenceω) {X : Set M} (hX : X.Countable) :
    ∃ N : L.Substructure M, X ⊆ N ∧ Countable N ∧
      (SentenceInf.Realize φ M ↔ SentenceInf.Realize φ N) := by
  obtain ⟨N, hXN, hN, hc⟩ := exists_countable_aElementary_substructure
    (Fragment.ofSentence φ) (Fragment.ofSentence_countable φ) hX
  exact ⟨N, hXN, hc, hN.realize_sentenceInf_iff (Fragment.mem_ofSentence φ)⟩
