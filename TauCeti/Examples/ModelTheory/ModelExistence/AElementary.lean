module

import TauCeti.ModelTheory.ModelExistence.AElementary

/-!
# Regression examples: elementarity relative to a fragment

These examples exercise `A`-elementarity from a downstream module, through public statements
only:

* every embedding is elementary for the bottom fragment, which has no members;
* `A`-elementarity is a genuine condition: in the empty language, the inclusion of a one-element
  set into a two-element set is not elementary for the fragment generated by the sentence
  `∀ x y, x = y`, which holds in the first set but not in the second.
-/

universe u v w w'

open FirstOrder FirstOrder.Language

-- Every embedding is elementary for the bottom fragment.
example {L : Language.{u, v}} {M : Type w} {N : Type w'} [L.Structure M] [L.Structure N]
    (f : N ↪[L] M) : AElementary ⊥ f :=
  aElementary_iff.2 fun _ hφ _ => (Fragment.notMem_bot _ hφ).elim

-- The inclusion of `Fin 1` into `Fin 2` is not elementary for the fragment of `∀ x y, x = y`.
example :
    letI := Language.emptyStructure (M := Fin 1)
    letI := Language.emptyStructure (M := Fin 2)
    ¬ AElementary (Fragment.ofSentence (BoundedFormulaInf.equal (L := Language.empty) (ι := ℕ)
        (Term.var (Sum.inr 0)) (Term.var (Sum.inr 1))).all.all)
      (StrongHomClass.toEmbedding (Fin.castSuccEmb : Fin 1 ↪ Fin 2)) := by
  let := Language.emptyStructure (M := Fin 1)
  let := Language.emptyStructure (M := Fin 2)
  intro h
  have := h.realize_sentenceInf_iff (Fragment.mem_ofSentence _)
  simp only [SentenceInf.realize_def, FormulaInf.realize_def, BoundedFormulaInf.realize_all,
    BoundedFormulaInf.realize_equal, Term.realize_var] at this
  -- `∀ x y, x = y` holds in `Fin 1` but fails at `0 ≠ 1` in `Fin 2`
  have h0 := this.2 fun x y => Subsingleton.elim _ _
  exact absurd (h0 0 1) (by simp [Fin.snoc])
