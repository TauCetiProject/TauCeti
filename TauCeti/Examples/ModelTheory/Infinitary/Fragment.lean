module

import TauCeti.ModelTheory.Infinitary.Fragment
import Mathlib.Analysis.Real.Cardinality

/-!
# Regression examples: fragments of `L_{ω₁ω}`

These examples exercise fragments from a downstream module, through public statements only:

* a countable fragment over an uncountable language: with a unary relation symbol `R_r` for every
  real `r`, the fragment generated by the sentence `⋁ₙ ∃ x, R_n x` is countable, although the
  language has uncountably many relation symbols;
* the generated fragment contains the components of its generators: each disjunct `∃ x, R_n x`
  belongs to it.
-/

open FirstOrder FirstOrder.Language

-- The language with a unary relation symbol `R_r` for every real `r` has uncountably many
-- relation symbols, yet the fragment generated by `⋁ₙ ∃ x, R_n x` is countable.
example :
    let L : Language := ⟨fun _ => Empty, fun _ => ℝ⟩
    let φ : L.Sentenceω := .iSup fun n : ℕ =>
      (BoundedFormulaInf.rel (l := 1) (n : ℝ) fun _ : Fin 1 => Term.var (Sum.inr 0)).ex
    Uncountable (L.Relations 1) ∧
      ((Fragment.ofSentence φ : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable :=
  ⟨inferInstanceAs (Uncountable ℝ), Fragment.ofSentence_countable _⟩

-- Each disjunct `∃ x, R_n x` of the generating sentence belongs to the fragment.
example (n : ℕ) :
    let L : Language := ⟨fun _ => Empty, fun _ => ℝ⟩
    let ψ : ℕ → L.BoundedFormulaω Empty 0 := fun n =>
      (BoundedFormulaInf.rel (l := 1) (n : ℝ) fun _ : Fin 1 => Term.var (Sum.inr 0)).ex
    (⟨0, ψ n⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ Fragment.ofSentence (.iSup ψ) :=
  Fragment.mem_toSet.1 ((Fragment.ofSentence _).iSup_mem
    (Fragment.mem_toSet.2 (Fragment.mem_ofSentence _)) n)
