module

import TauCeti.ModelTheory.Infinitary.FirstOrderImage
import TauCeti.ModelTheory.ModelExistence.FragmentType
import Mathlib.Analysis.Real.Cardinality

/-!
# Regression examples: fragments of `L_{ω₁ω}`

These examples exercise fragments and their transport along language homomorphisms from a
downstream module, through public statements only:

* a countable fragment over an uncountable language: with a unary relation symbol `R_r` for every
  real `r`, the fragment generated by the sentence `⋁ₙ ∃ x, R_n x` is countable, although the
  language has uncountably many relation symbols;
* component membership and symbol exclusion: each disjunct `∃ x, R_n x` belongs to that fragment,
  its occurring relation symbols are exactly `{⟨1, (n : ℝ)⟩ | n : ℕ}`, and for `r ∉ ℕ` no member
  mentions `R_r` (in particular `R_r(x₀)` lies outside both the generated fragment and the negation
  closure);
* symbol-bounded fragments as images of `⊤` from a countable symbol sublanguage;
* transport of fragments, formation closures, the first-order image, `A`-elementarity, and fragment
  types along language homomorphisms and equivalences.
-/

open FirstOrder FirstOrder.Language

-- The language with a unary relation symbol `R_r` for every real `r` has uncountably many
-- relation symbols, yet the fragment generated by `⋁ₙ ∃ x, R_n x` is countable.
example :
    let L : Language := ⟨fun _ => Empty, fun _ => ℝ⟩
    let φ : L.Sentenceω := .iSup fun n : ℕ =>
      (BoundedFormulaInf.rel (l := 1) (n : ℝ) fun _ : Fin 1 => Term.var (Sum.inr 0)).ex
    Uncountable (L.Relations 1) ∧
      ((Fragment.ofSentence φ : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable :=
  ⟨inferInstanceAs (Uncountable ℝ), Fragment.ofSentence_countable _⟩

-- Each disjunct `∃ x, R_n x` of the generating sentence belongs to the fragment.
example (n : ℕ) :
    let L : Language := ⟨fun _ => Empty, fun _ => ℝ⟩
    let ψ : ℕ → L.BoundedFormulaω Empty 0 := fun n =>
      (BoundedFormulaInf.rel (l := 1) (n : ℝ) fun _ : Fin 1 => Term.var (Sum.inr 0)).ex
    (⟨0, ψ n⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ Fragment.ofSentence (.iSup ψ) :=
  (Fragment.ofSentence _).iSup_mem (Fragment.mem_ofSentence _) n

-- The occurring relation symbols of the fragment generated by `⋁ₙ ∃ x, R_n x` are exactly the
-- natural-indexed ones; for `r ∉ Set.range ((↑) : ℕ → ℝ)`, no member of the fragment mentions
-- `R_r`, and `R_r(x₀)` belongs neither to `Fragment.ofSentence φ` nor to the negation closure of
-- `{⟨0, φ⟩}`.
example (r : ℝ) (hr : r ∉ Set.range ((↑) : ℕ → ℝ)) :
    let L : Language := ⟨fun _ => Empty, fun _ => ℝ⟩
    let φ : L.Sentenceω := .iSup fun n : ℕ =>
      (BoundedFormulaInf.rel (l := 1) (n : ℝ) fun _ : Fin 1 => Term.var (Sum.inr 0)).ex
    let Rr : L.BoundedFormulaω Empty 1 :=
      BoundedFormulaInf.rel (l := 1) r fun _ : Fin 1 => Term.var (Sum.inr 0)
    (Fragment.ofSentence φ).relationsIn =
        Set.range (fun n : ℕ => (⟨1, (n : ℝ)⟩ : Σ k, L.Relations k)) ∧
      (∀ p ∈ Fragment.ofSentence φ, (⟨1, r⟩ : Σ k, L.Relations k) ∉ p.2.relationsIn) ∧
      (⟨1, Rr⟩ : Σ n, L.BoundedFormulaω Empty n) ∉ Fragment.ofSentence φ ∧
      (⟨1, Rr⟩ : Σ n, L.BoundedFormulaω Empty n) ∉
        Fragment.negationClosure {(⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n)} := by
  intro L φ Rr
  have hrel : (Fragment.ofSentence φ).relationsIn =
      Set.range (fun n : ℕ => (⟨1, (n : ℝ)⟩ : Σ k, L.Relations k)) := by
    ext s
    simp [φ]
  have hnotMem : (⟨1, r⟩ : Σ k, L.Relations k) ∉ (Fragment.ofSentence φ).relationsIn := by
    rw [hrel]
    rintro ⟨n, hn⟩
    exact hr ⟨n, by simpa using (Sigma.mk.inj_iff.1 hn).2⟩
  refine ⟨hrel, fun p hp hs => hnotMem (Fragment.relationsIn_subset_of_mem hp hs),
    fun hRr => hnotMem (Fragment.relationsIn_subset_of_mem hRr (by simp [Rr])), ?_⟩
  intro hRr
  have hneg : (Fragment.negationClosure {(⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n)}).relationsIn =
      (Fragment.ofSentence φ).relationsIn := by
    simp
  exact hnotMem (hneg ▸ Fragment.relationsIn_subset_of_mem hRr (by simp [Rr]))

-- Every fragment factors through the symbol sublanguage of its occurring symbols: `A` lies inside
-- the image of `⊤` from `symbSublang A.functionsIn A.relationsIn`.
example {L : Language} (A : Fragment L) :
    A ≤ (⊤ : Fragment (symbSublang A.functionsIn A.relationsIn)).map
      (symbSublangIncl A.functionsIn A.relationsIn) := by
  rw [Fragment.map_top_symbSublangIncl]
  exact Fragment.le_ofSymbols_iff.2 ⟨subset_rfl, subset_rfl⟩

-- The fragment of a sentence is the least fragment containing it, and as a one-element set of
-- sentences it generates the same fragment.
example {L : Language} (φ : L.Sentenceω) (A : Fragment L)
    (hA : (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) :
    Fragment.ofTheory {φ} ≤ A := by
  rw [Fragment.ofTheory_singleton]
  exact Fragment.ofSentence_le_iff.2 hA

-- A language equivalence induces an order isomorphism on fragments that preserves the first-order
-- image and commutes with formation closure.
example {L L' : Language} (e : L ≃ᴸ L') (S : Set (Σ n, L.BoundedFormulaω Empty n)) :
    e.fragmentOrderIso (Fragment.firstOrder L) = Fragment.firstOrder L' ∧
      e.fragmentOrderIso (Fragment.formationClosure S) =
        Fragment.formationClosure ((fun p : Σ n, L.BoundedFormulaω Empty n =>
          (⟨p.1, e.toLHom.onBoundedFormulaInf p.2⟩ : Σ n, L'.BoundedFormulaω Empty n)) '' S) := by
  simp [e.map_formationClosure]

-- Along any expansion by a language homomorphism (with no injectivity hypothesis), fragment
-- elementarity and fragment types transport between the base fragment and its image.
example {L L' : Language} (g : L →ᴸ L') (A : Fragment L) {M N : Type*}
    [L.Structure M] [L.Structure N] [L'.Structure M] [L'.Structure N]
    [g.IsExpansionOn M] [g.IsExpansionOn N] (f : N ↪[L] M) (f' : N ↪[L'] M) (hf : ⇑f' = ⇑f)
    {n : ℕ} (a : Fin n → N) :
    (AElementary (A.map g) f' ↔ AElementary A f) ∧
      fragmentType (A.map g) M (f' ∘ a) = g.onBoundedFormulaInf '' fragmentType A M (f ∘ a) := by
  rw [hf]
  exact ⟨aElementary_map_iff hf, g.fragmentType_map A (f ∘ a)⟩
