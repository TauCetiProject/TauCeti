module

public import TauCeti.InformationTheory.CondExpPartitionEntropy.CountableLabel
public import TauCeti.Examples.Dynamics.Ergodic.MeasureEntropy.Basic

/-!
# Worked examples: conditional entropy given the σ-algebra of a label

For two independent fair bits, the first bit conditioned on the σ-algebra generated by the second
has conditional entropy `log 2`, the value of `TauCeti.conditionalPartitionEntropy`, while the
first bit conditioned on the σ-algebra it generates itself has conditional entropy `0`.
-/

public section

open MeasureTheory Real TauCeti TauCeti.MeasureEntropyExamples
open scoped ENNReal

namespace TauCeti.CondExpCountableLabelExamples

/-- For independent fair bits, the conditional entropy of the first given the second is
`log 2`. -/
example : condExpPartitionEntropy twoBits (MeasurableSpace.comap Prod.snd inferInstance)
    Prod.fst = log 2 := by
  rw [condExpPartitionEntropy_comap_eq_sum measurable_snd
    fun i ↦ (measurable_fst (measurableSet_singleton i)).nullMeasurableSet]
  simp only [twoBits_real_cell, twoBits_real_snd, Fintype.sum_bool]
  norm_num
  ring

/-- Conditioning the first bit on the σ-algebra it generates gives `0`. -/
example : condExpPartitionEntropy twoBits (MeasurableSpace.comap Prod.fst inferInstance)
    Prod.fst = 0 :=
  condExpPartitionEntropy_eq_zero_of_measurableSet fun i ↦
    ⟨{i}, measurableSet_singleton i, rfl⟩

end TauCeti.CondExpCountableLabelExamples
