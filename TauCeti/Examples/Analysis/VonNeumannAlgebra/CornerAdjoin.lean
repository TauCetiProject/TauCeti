module

public import Mathlib.Analysis.InnerProductSpace.PiL2
public import TauCeti.Analysis.VonNeumannAlgebra.Corner

/-!
# Counterexample to corner generation without multiplicative closure

`VonNeumannAlgebra.adjoin_image_compression` shows that for a self-adjoint **multiplicatively
closed** set `s` of bounded operators on `H` and a closed subspace `U` with
`U.starProjection ∈ adjoin s ∨ U.starProjection ∈ (adjoin s).commutant`, the compressed set
`(·.compression U.subtypeL) '' s` generates the corner `(adjoin s).corner U hU`.

When `U.starProjection ∈ (adjoin s).commutant`, neither self-adjointness nor multiplicative closure
is needed (`VonNeumannAlgebra.adjoin_image_compression_of_mem_commutant`). However, when
`U.starProjection ∈ adjoin s`, multiplicative closure is indispensable.

On `ℂ³ = EuclideanSpace ℂ (Fin 3)`, let `generatingSet = {E₀₂, E₂₀, E₁₂, E₂₁}` consist of the four
off-diagonal matrix units coupling coordinates `0, 1` to coordinate `2`, and let `cornerSubspace` be
the two-dimensional coordinate plane `(ℂ ∙ e₂)ᗮ = span {e₀, e₁}`:

* `generatingSet` is self-adjoint (`star_generatingSet_subset`) and generates all of `B(ℂ³)` as a
  von Neumann algebra (`adjoin_generatingSet_eq_top`), because products of two generators recover
  all remaining matrix units `Eᵢⱼ`;
* the orthogonal projection onto `cornerSubspace` therefore belongs to `adjoin generatingSet`, and
  the corner `(adjoin generatingSet).corner cornerSubspace _` is `⊤ = B(ℂ²)` on `cornerSubspace`,
  which is strictly larger than `⊥ = ℂ • 1` (`corner_adjoin_generatingSet_ne_bot`);
* yet every operator in `generatingSet` compresses to `0` on `cornerSubspace`
  (`compression_eq_zero_of_mem_generatingSet`), so the compressed set generates only the scalar
  algebra `⊥` (`adjoin_image_compression_generatingSet_eq_bot`), strictly smaller than the corner
  (`adjoin_image_compression_generatingSet_ne_corner`).
-/

public section

noncomputable section

open scoped InnerProductSpace Pointwise
open ContinuousLinearMap Submodule

namespace TauCeti.CornerAdjoinExample

/-- Ambient three-dimensional complex Hilbert space `ℂ³`. -/
abbrev H : Type := EuclideanSpace ℂ (Fin 3)

/-- Standard orthonormal basis vectors of `ℂ³`. -/
def basisVec (i : Fin 3) : H := EuclideanSpace.single i 1

/-- Standard matrix units `|eᵢ⟩⟨eⱼ|` on `ℂ³`. -/
def matrixUnit (i j : Fin 3) : H →L[ℂ] H :=
  InnerProductSpace.rankOne ℂ (basisVec i) (basisVec j)

/-- The self-adjoint (but not multiplicatively closed) generating set `{E₀₂, E₂₀, E₁₂, E₂₁}`. -/
def generatingSet : Set (H →L[ℂ] H) :=
  {matrixUnit 0 2, matrixUnit 2 0, matrixUnit 1 2, matrixUnit 2 1}

/-- The two-dimensional subspace `(ℂ ∙ e₂)ᗮ` spanned by `e₀` and `e₁`. -/
def cornerSubspace : Submodule ℂ H := (ℂ ∙ basisVec 2)ᗮ

/-- Orthonormality of the standard basis vectors `basisVec i`. -/
@[simp]
theorem inner_basisVec (i j : Fin 3) :
    ⟪basisVec i, basisVec j⟫_ℂ = if i = j then 1 else 0 := by
  simp [basisVec, EuclideanSpace.inner_single_left, PiLp.single_apply]

/-- The adjoint of `matrixUnit i j` is `matrixUnit j i`. -/
@[simp]
theorem star_matrixUnit (i j : Fin 3) :
    star (matrixUnit i j) = matrixUnit j i := by
  simp [matrixUnit, ContinuousLinearMap.star_eq_adjoint]

/-- Multiplication rule `Eᵢⱼ Eₖₗ = δⱼₖ Eᵢₗ` for the standard matrix units on `ℂ³`. -/
@[simp]
theorem matrixUnit_mul_matrixUnit (i j k l : Fin 3) :
    matrixUnit i j * matrixUnit k l = if j = k then matrixUnit i l else 0 := by
  rw [matrixUnit, matrixUnit, ContinuousLinearMap.mul_def,
    InnerProductSpace.rankOne_comp_rankOne, inner_basisVec]
  split_ifs <;> simp [matrixUnit]

/-- `generatingSet` is closed under adjoints. -/
theorem star_generatingSet_subset : star generatingSet ⊆ generatingSet := by
  intro x hx
  rw [Set.mem_star] at hx
  rcases hx with h | h | h | h
  all_goals
    have h' := congrArg star h
    rw [star_star, star_matrixUnit] at h'
    subst h'
    simp [generatingSet]

/-- Every matrix unit `Eᵢⱼ` on `ℂ³` lies in the von Neumann algebra generated by
`generatingSet`. -/
theorem matrixUnit_mem_adjoin (i j : Fin 3) :
    matrixUnit i j ∈ VonNeumannAlgebra.adjoin generatingSet := by
  have h02 : matrixUnit 0 2 ∈ VonNeumannAlgebra.adjoin generatingSet :=
    VonNeumannAlgebra.subset_adjoin _ (by simp [generatingSet])
  have h20 : matrixUnit 2 0 ∈ VonNeumannAlgebra.adjoin generatingSet :=
    VonNeumannAlgebra.subset_adjoin _ (by simp [generatingSet])
  have h12 : matrixUnit 1 2 ∈ VonNeumannAlgebra.adjoin generatingSet :=
    VonNeumannAlgebra.subset_adjoin _ (by simp [generatingSet])
  have h21 : matrixUnit 2 1 ∈ VonNeumannAlgebra.adjoin generatingSet :=
    VonNeumannAlgebra.subset_adjoin _ (by simp [generatingSet])
  fin_cases i <;> fin_cases j
  · simpa using mul_mem h02 h20
  · simpa using mul_mem h02 h21
  · exact h02
  · simpa using mul_mem h12 h20
  · simpa using mul_mem h12 h21
  · exact h12
  · exact h20
  · exact h21
  · simpa using mul_mem h20 h02

/-- `generatingSet` generates all of `B(ℂ³)` as a von Neumann algebra. -/
theorem adjoin_generatingSet_eq_top :
    VonNeumannAlgebra.adjoin generatingSet = ⊤ := by
  refine eq_top_iff.mpr fun T _ ↦ ?_
  have hv (w : H) : w = ∑ j : Fin 3, ⟪basisVec j, w⟫_ℂ • basisVec j := by
    ext m
    simp [basisVec, EuclideanSpace.inner_single_left, Pi.single_apply]
  have hT : T = ∑ i : Fin 3, ∑ j : Fin 3, ⟪basisVec i, T (basisVec j)⟫_ℂ • matrixUnit i j := by
    refine ContinuousLinearMap.ext fun v ↦ ?_
    calc
      T v = T (∑ j : Fin 3, ⟪basisVec j, v⟫_ℂ • basisVec j) := congrArg T (hv v)
      _ = ∑ j : Fin 3, ⟪basisVec j, v⟫_ℂ • T (basisVec j) := by simp [map_sum, map_smul]
      _ = ∑ j : Fin 3, ⟪basisVec j, v⟫_ℂ •
            ∑ i : Fin 3, ⟪basisVec i, T (basisVec j)⟫_ℂ • basisVec i :=
            Finset.sum_congr rfl fun j _ ↦ by rw [← hv (T (basisVec j))]
      _ = (∑ i : Fin 3, ∑ j : Fin 3, ⟪basisVec i, T (basisVec j)⟫_ℂ • matrixUnit i j) v := by
            rw [Finset.sum_comm]
            simp [sum_apply, smul_apply, Finset.smul_sum, matrixUnit,
              InnerProductSpace.rankOne_apply, smul_smul, mul_comm]
  rw [hT]
  exact sum_mem fun i _ ↦ sum_mem fun j _ ↦
    SMulMemClass.smul_mem _ (matrixUnit_mem_adjoin i j)

/-- The orthogonal projection onto `cornerSubspace` belongs to `adjoin generatingSet`. -/
theorem starProjection_cornerSubspace_mem_adjoin :
    cornerSubspace.starProjection ∈ VonNeumannAlgebra.adjoin generatingSet := by
  rw [adjoin_generatingSet_eq_top]
  exact VonNeumannAlgebra.mem_top

/-- Every generator in `generatingSet` compresses to `0` on `cornerSubspace = (ℂ ∙ e₂)ᗮ`. -/
theorem compression_eq_zero_of_mem_generatingSet {x : H →L[ℂ] H} (hx : x ∈ generatingSet) :
    ContinuousLinearMap.compression (F := cornerSubspace) x cornerSubspace.subtypeL = 0 := by
  refine ContinuousLinearMap.ext fun v ↦ ext_inner_left ℂ fun u ↦ ?_
  have hu : ⟪(u : H), basisVec 2⟫_ℂ = 0 :=
    Submodule.inner_left_of_mem_orthogonal (Submodule.mem_span_singleton_self (basisVec 2)) u.2
  have hv : ⟪basisVec 2, (v : H)⟫_ℂ = 0 :=
    Submodule.inner_right_of_mem_orthogonal (Submodule.mem_span_singleton_self (basisVec 2)) v.2
  rw [inner_compression_apply, zero_apply, inner_zero_right]
  rcases hx with rfl | rfl | rfl | rfl
  · simp [matrixUnit, hv]
  · simp [matrixUnit, inner_smul_right, hu]
  · simp [matrixUnit, hv]
  · simp [matrixUnit, inner_smul_right, hu]

/-- The compressed generators generate only the scalar von Neumann algebra `⊥` on
`cornerSubspace`. -/
theorem adjoin_image_compression_generatingSet_eq_bot :
    VonNeumannAlgebra.adjoin ((·.compression cornerSubspace.subtypeL) '' generatingSet) =
      (⊥ : VonNeumannAlgebra cornerSubspace) := by
  refine le_bot_iff.mp (VonNeumannAlgebra.adjoin_le_iff.mpr ?_)
  rintro _ ⟨x, hx, rfl⟩
  dsimp only
  rw [compression_eq_zero_of_mem_generatingSet hx]
  exact zero_mem _

/-- The corner `(adjoin generatingSet).corner cornerSubspace _` is strictly larger than `⊥`. -/
theorem corner_adjoin_generatingSet_ne_bot :
    (VonNeumannAlgebra.adjoin generatingSet).corner cornerSubspace
      (.inl starProjection_cornerSubspace_mem_adjoin) ≠ ⊥ := by
  have he0 : basisVec 0 ∈ cornerSubspace := by
    rw [cornerSubspace, Submodule.mem_orthogonal_singleton_iff_inner_left]
    simp
  have he1 : basisVec 1 ∈ cornerSubspace := by
    rw [cornerSubspace, Submodule.mem_orthogonal_singleton_iff_inner_left]
    simp
  let u0 : cornerSubspace := ⟨basisVec 0, he0⟩
  let u1 : cornerSubspace := ⟨basisVec 1, he1⟩
  intro hbot
  have hmem : (matrixUnit 0 1).compression cornerSubspace.subtypeL ∈
      (⊥ : VonNeumannAlgebra cornerSubspace) := by
    rw [← hbot]
    exact VonNeumannAlgebra.compression_mem_corner _ (matrixUnit_mem_adjoin 0 1)
  rw [VonNeumannAlgebra.mem_bot] at hmem
  obtain ⟨c, hc⟩ := hmem
  have h1 : ⟪u0, ((matrixUnit 0 1).compression cornerSubspace.subtypeL) u1⟫_ℂ = 1 := by
    rw [inner_compression_apply, cornerSubspace.coe_subtypeL, Submodule.coe_subtype, matrixUnit,
      InnerProductSpace.inner_right_rankOne_apply]
    simp [u0, u1, basisVec]
  have h0 : ⟪u0, (algebraMap ℂ (cornerSubspace →L[ℂ] cornerSubspace) c) u1⟫_ℂ = 0 := by
    rw [Algebra.algebraMap_eq_smul_one, smul_apply, one_apply_eq_self, Submodule.coe_inner,
      Submodule.coe_smul_of_tower, inner_smul_right]
    simp [u0, u1]
  rw [hc] at h0
  exact one_ne_zero (h1.symm.trans h0)

/-- **Counterexample to corner generation without multiplicative closure:** `generatingSet` is
self-adjoint and `cornerSubspace.starProjection ∈ adjoin generatingSet`, yet
`(·.compression cornerSubspace.subtypeL) '' generatingSet` does not generate
`(adjoin generatingSet).corner cornerSubspace _`. -/
theorem adjoin_image_compression_generatingSet_ne_corner :
    VonNeumannAlgebra.adjoin ((·.compression cornerSubspace.subtypeL) '' generatingSet) ≠
      (VonNeumannAlgebra.adjoin generatingSet).corner cornerSubspace
        (.inl starProjection_cornerSubspace_mem_adjoin) := by
  rw [adjoin_image_compression_generatingSet_eq_bot]
  exact corner_adjoin_generatingSet_ne_bot.symm

end TauCeti.CornerAdjoinExample
