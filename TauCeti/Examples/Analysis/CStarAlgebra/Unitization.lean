/-!
# Concrete examples on maximal ideals of `C([0, 1], ℂ)` and left-action unitizations

This file records three concrete phenomena for commutative C⋆-algebras and their unitizations:

1. **Non-closed principal ideal in `C([0, 1], ℂ)`:** the coordinate function `coord : t ↦ t`
   generates an algebraic ideal whose uniform closure is the maximal ideal
   `maximalIdealZero = {f ∈ C([0, 1], ℂ) | f 0 = 0}` (kernel of evaluation at `0`). Its continuous
   functional calculus square root `CFC.sqrt coord` (`t ↦ √t`) lies in `maximalIdealZero`, fails to
   belong to `Ideal.span {coord}` because any continuous cofactor `g` would satisfy
   `g t = (√t)⁻¹` for `t > 0`, and is approximated in uniform norm at rate `1 / n` by
   `coord * truncInvSqrt n`, where `truncInvSqrt n t = n / max 1 (n * √t)` equals `min n (√t)⁻¹`
   for `t > 0`.
2. **Nonunital vs already-unital left-action norms:** on the nonunital algebra `C₀((0, 1], ℂ)`,
   `coordIoc : t ↦ t` vanishes at infinity (`t → 0⁺`), `C₀((0, 1], ℂ)` has no two-sided identity,
   and `1 - coordIoc` in `Unitization ℂ C₀((0, 1], ℂ)` has both minimal unitization norm and
   left-action operator norm equal to `1`. By contrast, on the already-unital algebra
   `C([0, 1], ℂ)`, the element `(1 : Unitization ℂ C([0, 1], ℂ)) - (1 : C([0, 1], ℂ))` still has
   unitization norm `1`, whereas its left action `1 • id + L_{-1}` vanishes identically.
3. **Zero C⋆-algebra `C(Empty, ℂ)`:** `Unitization.LeftAction ℂ C(Empty, ℂ)` is a subsingleton and
   every scalar `z : ℂ` acts as `0` on `C(Empty, ℂ)`, while `‖(Unitization.inl z)‖ = ‖z‖` in
   `Unitization ℂ C(Empty, ℂ)`.
-/

public section

noncomputable section

open ContinuousLinearMap Filter Topology
open scoped ComplexOrder ZeroAtInfty

namespace TauCeti.UnitizationExample

/-! ### 1. The maximal ideal at `0` in `C([0, 1], ℂ)` and `t ↦ √t` -/

/-- The coordinate function `t ↦ t` in `C(unitInterval, ℂ)`. -/
def coord : C(unitInterval, ℂ) where
  toFun t := ((t : ℝ) : ℂ)
  continuous_toFun := Complex.continuous_ofReal.comp continuous_subtypeVal

/-- The square-root coordinate function `t ↦ √t` in `C(unitInterval, ℂ)`. -/
def sqrtCoord : C(unitInterval, ℂ) where
  toFun t := ((Real.sqrt (t : ℝ) : ℝ) : ℂ)
  continuous_toFun :=
    Complex.continuous_ofReal.comp (Real.continuous_sqrt.comp continuous_subtypeVal)

@[simp]
theorem coord_apply (t : unitInterval) : coord t = ((t : ℝ) : ℂ) := (rfl)

@[simp]
theorem sqrtCoord_apply (t : unitInterval) : sqrtCoord t = ((Real.sqrt (t : ℝ) : ℝ) : ℂ) := (rfl)

theorem coord_nonneg : 0 ≤ coord :=
  fun t ↦ by simpa [Complex.le_def] using t.property.1

theorem sqrtCoord_nonneg : 0 ≤ sqrtCoord :=
  fun _ ↦ by simp [Complex.le_def]

@[simp]
theorem sqrtCoord_mul_self : sqrtCoord * sqrtCoord = coord := by
  ext t
  simp [← Complex.ofReal_mul, Real.mul_self_sqrt t.property.1]

/-- In `C(unitInterval, ℂ)`, the C⋆-algebraic square root `CFC.sqrt coord` is `t ↦ √t`. -/
@[simp]
theorem cfc_sqrt_coord : CFC.sqrt coord = sqrtCoord :=
  CFC.sqrt_unique sqrtCoord_mul_self sqrtCoord_nonneg

/-- The maximal ideal `{f ∈ C(unitInterval, ℂ) | f 0 = 0}`, defined as the kernel of evaluation at
`0 : unitInterval`. -/
def maximalIdealZero : Ideal C(unitInterval, ℂ) :=
  RingHom.ker (ContinuousMap.evalStarAlgHom ℂ ℂ (0 : unitInterval))

@[simp]
theorem mem_maximalIdealZero_iff (f : C(unitInterval, ℂ)) :
    f ∈ maximalIdealZero ↔ f 0 = 0 := by
  simp [maximalIdealZero]

theorem maximalIdealZero_eq_idealOfSet :
    maximalIdealZero = ContinuousMap.idealOfSet ℂ ({(0 : unitInterval)}ᶜ : Set unitInterval) :=
  ContinuousMap.ker_evalStarAlgHom_eq_idealOfSet ℂ ℂ (0 : unitInterval)

/-- The kernel of evaluation at `0` is a maximal ideal of `C(unitInterval, ℂ)`. -/
theorem isMaximal_maximalIdealZero : maximalIdealZero.IsMaximal := by
  rw [maximalIdealZero_eq_idealOfSet]
  infer_instance

/-- The uniform closure of the principal ideal generated by `coord` is the maximal ideal at `0`. -/
theorem closure_span_coord_eq_maximalIdealZero :
    (Ideal.span ({coord} : Set C(unitInterval, ℂ))).closure = maximalIdealZero := by
  rw [ContinuousMap.closure_span_singleton_eq_idealOfSet, maximalIdealZero_eq_idealOfSet]
  refine congrArg (ContinuousMap.idealOfSet ℂ) (Set.ext fun t ↦ ?_)
  simp only [Set.mem_ofPred_eq, coord_apply, ne_eq, Complex.ofReal_eq_zero,
    Set.mem_compl_iff, Set.mem_singleton_iff]
  exact not_congr ⟨fun h ↦ Subtype.ext h, fun h ↦ by simp [h]⟩

theorem sqrtCoord_mem_maximalIdealZero : sqrtCoord ∈ maximalIdealZero := by
  simp

/-- Any factorization `coord * g = sqrtCoord` forces `g t = (√t)⁻¹` on `(0, 1]`. -/
theorem apply_eq_inv_sqrt_of_coord_mul_eq_sqrtCoord {g : C(unitInterval, ℂ)}
    (hg : coord * g = sqrtCoord) {t : unitInterval} (ht : 0 < (t : ℝ)) :
    g t = (((Real.sqrt (t : ℝ))⁻¹ : ℝ) : ℂ) := by
  have hgt : ((t : ℝ) : ℂ) * g t = ((Real.sqrt (t : ℝ) : ℝ) : ℂ) := by
    simpa using congrArg (fun f : C(unitInterval, ℂ) ↦ f t) hg
  have hs : Real.sqrt (t : ℝ) ≠ 0 := (Real.sqrt_pos.mpr ht).ne'
  have hprod : ((t : ℝ) : ℂ) * (((Real.sqrt (t : ℝ))⁻¹ : ℝ) : ℂ) =
      ((Real.sqrt (t : ℝ) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul]
    congr 1
    calc
      (t : ℝ) * (Real.sqrt (t : ℝ))⁻¹
        = Real.sqrt (t : ℝ) * Real.sqrt (t : ℝ) * (Real.sqrt (t : ℝ))⁻¹ := by
          rw [Real.mul_self_sqrt ht.le]
      _ = Real.sqrt (t : ℝ) := by rw [mul_assoc, mul_inv_cancel₀ hs, mul_one]
  exact mul_left_cancel₀ (Complex.ofReal_ne_zero.mpr ht.ne') (hgt.trans hprod.symm)

/-- The function `t ↦ √t` does not belong to the algebraic principal ideal `Ideal.span {coord}`. -/
theorem sqrtCoord_notMem_span_coord :
    sqrtCoord ∉ Ideal.span ({coord} : Set C(unitInterval, ℂ)) := by
  intro hmem
  obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hmem
  rw [mul_comm] at hg
  set M : ℝ := max 1 (‖g‖ + 1)
  have hM1 : 1 ≤ M := le_max_left _ _
  have hMpos : 0 < M := zero_lt_one.trans_le hM1
  have ht_mem : M⁻¹ ^ 2 ∈ Set.Icc (0 : ℝ) 1 :=
    ⟨by positivity, sq_le_one_iff₀ (by positivity) |>.mpr (inv_le_one_of_one_le₀ hM1)⟩
  have ht_pos : 0 < ((⟨M⁻¹ ^ 2, ht_mem⟩ : unitInterval) : ℝ) := by
    simp only [inv_pos, hMpos, sq_pos_of_pos]
  have hgt := apply_eq_inv_sqrt_of_coord_mul_eq_sqrtCoord hg ht_pos
  have hsqrt : (Real.sqrt ((⟨M⁻¹ ^ 2, ht_mem⟩ : unitInterval) : ℝ))⁻¹ = M := by
    simp only [Real.sqrt_sq (inv_nonneg.mpr hMpos.le), inv_inv]
  have hnorm : M = ‖g ⟨M⁻¹ ^ 2, ht_mem⟩‖ := by
    rw [hgt, hsqrt, Complex.norm_real, Real.norm_of_nonneg hMpos.le]
  linarith [le_max_right 1 (‖g‖ + 1), hnorm, g.norm_coe_le_norm ⟨M⁻¹ ^ 2, ht_mem⟩]

/-- The principal ideal `Ideal.span {coord}` is strictly contained in its closure
`maximalIdealZero`, so `Ideal.span {coord}` is not closed in `C(unitInterval, ℂ)`. -/
theorem span_coord_lt_maximalIdealZero :
    Ideal.span ({coord} : Set C(unitInterval, ℂ)) < maximalIdealZero := by
  refine IsConcreteLE.lt_iff_le_and_exists.mpr ⟨Ideal.span_le.mpr ?_, sqrtCoord,
    sqrtCoord_mem_maximalIdealZero, sqrtCoord_notMem_span_coord⟩
  rintro f rfl
  simp

/-- Continuous truncation `t ↦ n / max 1 (n * √t)` of `(√t)⁻¹` on `[0, 1]`. Writing the formula as
`n / max 1 (n * √t)` avoids Lean's junk value `(0 : ℝ)⁻¹ = 0` at `t = 0` while agreeing with
`min n (√t)⁻¹` for every `t > 0`. -/
def truncInvSqrt (n : ℕ) : C(unitInterval, ℂ) where
  toFun t := (((n : ℝ) / max 1 ((n : ℝ) * Real.sqrt (t : ℝ)) : ℝ) : ℂ)
  continuous_toFun := by
    refine Complex.continuous_ofReal.comp (Continuous.div continuous_const ?_ fun _ ↦ ?_)
    · exact continuous_const.max
        (continuous_const.mul (Real.continuous_sqrt.comp continuous_subtypeVal))
    · exact (zero_lt_one.trans_le (le_max_left 1 _)).ne'

@[simp]
theorem truncInvSqrt_apply (n : ℕ) (t : unitInterval) :
    truncInvSqrt n t = (((n : ℝ) / max 1 ((n : ℝ) * Real.sqrt (t : ℝ)) : ℝ) : ℂ) := (rfl)

/-- For `t > 0`, `truncInvSqrt n t` coincides with `min n (√t)⁻¹`. -/
theorem truncInvSqrt_apply_of_pos (n : ℕ) {t : unitInterval} (ht : 0 < (t : ℝ)) :
    truncInvSqrt n t = ((min (n : ℝ) (Real.sqrt (t : ℝ))⁻¹ : ℝ) : ℂ) := by
  simp only [truncInvSqrt_apply, Complex.ofReal_inj]
  have hs : 0 < Real.sqrt (t : ℝ) := Real.sqrt_pos.mpr ht
  rcases eq_or_ne n 0 with rfl | hn
  · simp [le_of_lt (inv_pos.mpr hs)]
  · have hn_pos : 0 < (n : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
    rcases le_total 1 ((n : ℝ) * Real.sqrt (t : ℝ)) with h | h
    · rw [max_eq_right h, min_eq_right ((inv_le_iff_one_le_mul₀ hs).mpr h)]
      field_simp [hn_pos.ne', hs.ne']
    · have hle : (n : ℝ) ≤ (Real.sqrt (t : ℝ))⁻¹ := by
        rw [← one_div, le_div_iff₀ hs]
        exact h
      rw [max_eq_left h, div_one, min_eq_left hle]

/-- Uniform error bound `‖coord * truncInvSqrt n - sqrtCoord‖ ≤ 1 / n` for `n ≥ 1`. -/
theorem norm_coord_mul_truncInvSqrt_sub_sqrtCoord_le {n : ℕ} (hn : 1 ≤ n) :
    ‖coord * truncInvSqrt n - sqrtCoord‖ ≤ 1 / (n : ℝ) := by
  have hn_pos : 0 < (n : ℝ) := Nat.cast_pos.mpr hn
  refine (ContinuousMap.norm_le _ (by positivity)).mpr fun t ↦ ?_
  set s : ℝ := Real.sqrt (t : ℝ) with hs_def
  have hs_nonneg : 0 ≤ s := Real.sqrt_nonneg _
  have hs_sq : s * s = (t : ℝ) := Real.mul_self_sqrt t.property.1
  have hval : (coord * truncInvSqrt n - sqrtCoord) t =
      (((s * s * ((n : ℝ) / max 1 ((n : ℝ) * s)) - s) : ℝ) : ℂ) := by
    rw [ContinuousMap.sub_apply, ContinuousMap.mul_apply, coord_apply, truncInvSqrt_apply,
      sqrtCoord_apply, ← hs_def, ← hs_sq]
    push_cast
    ring
  rw [hval, Complex.norm_real, Real.norm_eq_abs]
  rcases le_or_gt 1 ((n : ℝ) * s) with h | h
  · have hs_ne : s ≠ 0 := fun hs0 ↦ by linarith [mul_eq_zero_of_right (n : ℝ) hs0]
    rw [max_eq_right h]
    have hzero : s * s * ((n : ℝ) / ((n : ℝ) * s)) - s = 0 := by field_simp [hs_ne]; ring
    rw [hzero, abs_zero]
    positivity
  · rw [max_eq_left h.le, div_one]
    have hns : 0 ≤ 1 - (n : ℝ) * s := sub_nonneg.mpr h.le
    have hrew : s * s * (n : ℝ) - s = -(s * (1 - (n : ℝ) * s)) := by ring
    rw [hrew, abs_neg, abs_of_nonneg (mul_nonneg hs_nonneg hns)]
    have hle_s : s * (1 - (n : ℝ) * s) ≤ s * 1 :=
      mul_le_mul_of_nonneg_left (sub_le_self 1 (by positivity)) hs_nonneg
    have hs_bound : s ≤ 1 / (n : ℝ) := by
      rw [le_div_iff₀' hn_pos]
      exact h.le
    linarith

/-- Explicit uniform convergence `coord * truncInvSqrt n → sqrtCoord` in `C(unitInterval, ℂ)`. -/
theorem tendsto_coord_mul_truncInvSqrt :
    Tendsto (fun n : ℕ ↦ coord * truncInvSqrt n) atTop (𝓝 sqrtCoord) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero' (g := fun n : ℕ ↦ (1 : ℝ) / (n : ℝ))
    (Eventually.of_forall fun _ ↦ norm_nonneg _) ?_
    ((tendsto_const_nhds (x := (1 : ℝ))).div_atTop tendsto_natCast_atTop_atTop)
  filter_upwards [eventually_ge_atTop 1] with n hn
  exact norm_coord_mul_truncInvSqrt_sub_sqrtCoord_le hn

/-! ### 2. Nonunital `C₀((0, 1], ℂ)` vs already-unital `C([0, 1], ℂ)` -/

/-- The coordinate function `t ↦ t` in `C₀(Set.Ioc (0 : ℝ) 1, ℂ)`, vanishing as `t → 0⁺`. -/
def coordIoc : C₀(Set.Ioc (0 : ℝ) 1, ℂ) where
  toFun x := ((x : ℝ) : ℂ)
  continuous_toFun := Complex.continuous_ofReal.comp continuous_subtypeVal
  zero_at_infty' := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    let K : Set (Set.Ioc (0 : ℝ) 1) := Subtype.val ⁻¹' Set.Icc (ε / 2) 1
    have hsub : Set.Icc (ε / 2) 1 ⊆ Set.Ioc (0 : ℝ) 1 :=
      fun t ht ↦ ⟨(half_pos hε).trans_le ht.1, ht.2⟩
    have hK : IsCompact K := by
      rw [Subtype.isCompact_iff, Set.image_preimage_eq_inter_range, Subtype.range_coe,
        Set.inter_eq_left.mpr hsub]
      exact isCompact_Icc
    filter_upwards [Filter.mem_cocompact.mpr ⟨K, hK, Set.Subset.rfl⟩] with x hx
    have hxlt : (x : ℝ) < ε / 2 := by
      by_contra hge
      exact hx ⟨not_lt.mp hge, x.property.2⟩
    rw [dist_zero_right, Complex.norm_real, Real.norm_of_nonneg x.property.1.le]
    linarith

@[simp]
theorem coordIoc_apply (x : Set.Ioc (0 : ℝ) 1) : coordIoc x = ((x : ℝ) : ℂ) := (rfl)

/-- The nonunital C⋆-algebra `C₀(Set.Ioc (0 : ℝ) 1, ℂ)` has no two-sided multiplicative identity. -/
theorem no_identity_Ioc :
    ¬ ∃ e : C₀(Set.Ioc (0 : ℝ) 1, ℂ), ∀ b, e * b = b ∧ b * e = b := by
  rintro ⟨e, he⟩
  have he1 (x : Set.Ioc (0 : ℝ) 1) : e x = 1 := by
    have hx : e x * ((x : ℝ) : ℂ) = 1 * ((x : ℝ) : ℂ) := by
      simpa using congrArg (fun f : C₀(Set.Ioc (0 : ℝ) 1, ℂ) ↦ f x) (he coordIoc).1
    exact mul_right_cancel₀ (Complex.ofReal_ne_zero.mpr x.property.1.ne') hx
  have : NoncompactSpace (Set.Ioc (0 : ℝ) 1) :=
    not_compactSpace_iff.mp (mt isCompact_iff_compactSpace.mpr (by simp))
  exact one_ne_zero (tendsto_nhds_unique (tendsto_const_nhds.congr fun x ↦ (he1 x).symm)
    (zero_at_infty e))

/-- On `C₀(Set.Ioc (0 : ℝ) 1, ℂ)`, the operator `1 • id + L_{-coordIoc}` has norm `1` because
`1 - t → 1` as `t → 0⁺`. -/
theorem norm_lift_Lmul_one_sub_coordIoc :
    ‖Unitization.lift (NonUnitalAlgHom.Lmul ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ))
      ((1 : Unitization ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ)) -
        (coordIoc : Unitization ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ)))‖ = 1 := by
  set u : Unitization ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ) :=
    1 - (coordIoc : Unitization ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ))
  set T := Unitization.lift (NonUnitalAlgHom.Lmul ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ)) u
  refine le_antisymm ?_ ?_
  · refine opNorm_le_bound T zero_le_one fun f ↦ ?_
    rw [one_mul, ← ZeroAtInftyContinuousMap.norm_toBCF_eq_norm]
    refine BoundedContinuousFunction.norm_le (norm_nonneg f) |>.mpr fun x ↦ ?_
    have hfx : (T f) x = (((1 - (x : ℝ)) : ℝ) : ℂ) * f x := by
      simp [T, u, Algebra.algebraMap_eq_smul_one]
      ring
    have h1x : |1 - (x : ℝ)| ≤ 1 :=
      abs_le.mpr ⟨by linarith [x.property.2], by linarith [x.property.1]⟩
    calc
      ‖(T f).toBCF x‖ = |1 - (x : ℝ)| * ‖f x‖ := by
        rw [ZeroAtInftyContinuousMap.toBCF_apply, hfx, norm_mul, Complex.norm_real,
          Real.norm_eq_abs]
      _ ≤ 1 * ‖f‖ :=
        mul_le_mul h1x (BoundedContinuousFunction.norm_coe_le_norm f.toBCF x) (norm_nonneg _)
          zero_le_one
      _ = ‖f‖ := one_mul _
  · exact (by simp [u] : (1 : ℝ) ≤ ‖u.fst‖).trans
      (Unitization.norm_fst_le_norm_lift_Lmul no_identity_Ioc u)

/-- Consequently, `1 - coordIoc` also has minimal unitization norm `1` in
`Unitization ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ)`. -/
theorem norm_one_sub_coordIoc :
    ‖(1 : Unitization ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ)) -
      (coordIoc : Unitization ℂ C₀(Set.Ioc (0 : ℝ) 1, ℂ))‖ = 1 := by
  rw [← Unitization.norm_lift_Lmul no_identity_Ioc, norm_lift_Lmul_one_sub_coordIoc]

/-- By contrast, on the already-unital C⋆-algebra `C(unitInterval, ℂ)`, the nonzero element
`(1 : Unitization ℂ C(unitInterval, ℂ)) - (1 : C(unitInterval, ℂ))` acts as `0` by left
multiplication, while its minimal unitization norm remains `1`. -/
theorem unitInterval_leftAction_collapse :
    Unitization.lift (NonUnitalAlgHom.Lmul ℂ C(unitInterval, ℂ))
        ((1 : Unitization ℂ C(unitInterval, ℂ)) - (1 : C(unitInterval, ℂ))) = 0 ∧
      ‖(1 : Unitization ℂ C(unitInterval, ℂ)) - (1 : C(unitInterval, ℂ))‖ = 1 := by
  have hker :
      Unitization.lift (NonUnitalAlgHom.Lmul ℂ C(unitInterval, ℂ))
        ((1 : Unitization ℂ C(unitInterval, ℂ)) - (1 : C(unitInterval, ℂ))) = 0 := by
    rw [← RingHom.mem_ker, Unitization.mem_ker_lift_Lmul_iff]
    simp
  refine ⟨hker, ?_⟩
  have hfst : ‖((1 : Unitization ℂ C(unitInterval, ℂ)) - (1 : C(unitInterval, ℂ))).fst‖ = 1 := by
    simp
  have hop := hker
  rw [Unitization.lift_apply, NonUnitalAlgHom.toAlgHom_apply, NonUnitalAlgHom.coe_Lmul] at hop
  rw [Unitization.norm_eq_sup, hfst, hop, norm_zero, max_eq_left zero_le_one]

/-! ### 3. Zero C⋆-algebra `C(Empty, ℂ)` -/

/-- On the zero C⋆-algebra `C(Empty, ℂ)`, `Unitization.LeftAction ℂ C(Empty, ℂ)` collapses to a
subsingleton and every scalar `z : ℂ` acts as `0`, whereas `Unitization ℂ C(Empty, ℂ)` preserves
`‖z‖`. -/
theorem empty_unitization_contrast (z : ℂ) :
    Subsingleton (Unitization.LeftAction ℂ C(Empty, ℂ)) ∧
      Unitization.lift (NonUnitalAlgHom.Lmul ℂ C(Empty, ℂ)) (Unitization.inl z) = 0 ∧
      ‖(Unitization.inl z : Unitization ℂ C(Empty, ℂ))‖ = ‖z‖ :=
  ⟨inferInstance, Unitization.lift_Lmul_eq_zero_of_subsingleton _, by simp⟩

end TauCeti.UnitizationExample
