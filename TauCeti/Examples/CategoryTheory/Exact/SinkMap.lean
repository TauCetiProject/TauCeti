module

public import Mathlib.RingTheory.ZMod.LocalRing
public import TauCeti.Algebra.Category.FGModuleCat.AlmostSplit.Basic
import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import TauCeti.Data.ZMod.LocalRing

/-!
# The sink map of `ℤ/p²ℤ`

For a prime `p`, the ring `ℤ/p²ℤ` is local with maximal ideal `pℤ/p²ℤ`, which is therefore its
Jacobson radical. So the sink map of the indecomposable projective module `ℤ/p²ℤ` over itself is
the inclusion `pℤ/p²ℤ ⟶ ℤ/p²ℤ`: it is right almost split in the finitely generated `ℤ/p²ℤ`-modules
by `FGModuleCat.isRightAlmostSplit_ofHom_subtype_jacobson`, and right minimal since it is a
monomorphism. This complements the almost-split sequence `0 ⟶ ℤ/pℤ ⟶ ℤ/p²ℤ ⟶ ℤ/pℤ ⟶ 0` of
`TauCeti.isAlmostSplit_zmod`, which ends at the other indecomposable module `ℤ/pℤ`.
-/

public section

open CategoryTheory

namespace TauCeti

/-- **The sink map of `ℤ/p²ℤ` is the inclusion `pℤ/p²ℤ ⟶ ℤ/p²ℤ`.** For a prime `p`, the inclusion
of the ideal generated by `p` into `ℤ/p²ℤ` is right almost split and right minimal in the finitely
generated `ℤ/p²ℤ`-modules. -/
theorem isRightAlmostSplit_and_minimal_ofHom_subtype_span_zmod (p : ℕ) [Fact p.Prime] :
    IsRightAlmostSplit (FGModuleCat.ofHom (Ideal.span {(p : ZMod (p ^ 2))}).subtype) ∧
      ∀ φ, φ ≫ FGModuleCat.ofHom (Ideal.span {(p : ZMod (p ^ 2))}).subtype =
        FGModuleCat.ofHom (Ideal.span {(p : ZMod (p ^ 2))}).subtype → IsIso φ := by
  have hJ : Module.jacobson (ZMod (p ^ 2)) (ZMod (p ^ 2)) = Ideal.span {(p : ZMod (p ^ 2))} :=
    (IsLocalRing.ringJacobson_eq_maximalIdeal _).trans (ZMod.maximalIdeal_prime_pow_eq_span p 2)
  have : IsLocalRing (Module.End (ZMod (p ^ 2)) (ZMod (p ^ 2))) :=
    (RingEquiv.moduleEndSelf (ZMod (p ^ 2))).isLocalRing
  have key := FGModuleCat.isRightAlmostSplit_ofHom_subtype_jacobson (ZMod (p ^ 2)) (ZMod (p ^ 2))
  rw [hJ] at key
  refine ⟨key, fun φ hφ ↦ ?_⟩
  -- The inclusion is a monomorphism, so `φ` is the identity.
  have : Mono (FGModuleCat.ofHom (Ideal.span {(p : ZMod (p ^ 2))}).subtype) :=
    ConcreteCategory.mono_of_injective _ Subtype.val_injective
  rw [(cancel_mono _).mp (hφ.trans (Category.id_comp _).symm)]
  infer_instance

end TauCeti
