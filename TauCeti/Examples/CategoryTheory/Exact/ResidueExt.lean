module

public import TauCeti.Algebra.Category.FGModuleCat.Residue.Ext
public import TauCeti.Data.ZMod.LocalRing
public import TauCeti.Data.ZMod.Nilpotent
import TauCeti.RingTheory.LocalRing.ResidueField.Quotient

/-!
# Self-extensions of `ℤ/pℤ` over `ℤ/p²ℤ`

For prime `p` and `R = ℤ/p²ℤ`, the maximal ideal of `R` is generated by `p`, which is nonzero of
square zero. The general computation `TauCeti.residueExt1Equiv` in
`TauCeti/Algebra/Category/FGModuleCat/Residue/Ext.lean` therefore identifies the group of Yoneda
self-extensions `Ext¹_R(ℤ/pℤ, ℤ/pℤ)` of the residue field with `ℤ/pℤ`, generated by the class of
the residue sequence `0 ⟶ ℤ/pℤ ⟶ ℤ/p²ℤ ⟶ ℤ/pℤ ⟶ 0`.

The general computation rests on `Extension.homQuotientEquivExt1OfIsProjective`, whose
surjectivity half is `Extension.exists_mk_pushout_eq_of_isProjective`; that the residue sequence
does not split is also part of `isAlmostSplit_residueSequence`. The connecting map comes from the
Hom–Ext exact sequence of Iyama, Nakaoka and Palu, *Auslander–Reiten theory in extriangulated
categories*, Fact 1.20(1), applied to the abelian exact structure on finitely generated modules.
-/

public section

namespace TauCeti

open CategoryTheory ExactStructure _root_.IsLocalRing

/-- For prime `p`, the Yoneda self-extension group of the residue field of `ℤ/p²ℤ` is additively
isomorphic to `ℤ/pℤ`. -/
noncomputable def zmodResidueExt1AddEquiv (p : ℕ) [Fact p.Prime] :
    ZMod p ≃+ (ExactStructure.abelian (FGModuleCat (ZMod (p ^ 2)))).Ext1
      (residueFG (ZMod (p ^ 2))) (residueFG (ZMod (p ^ 2))) :=
  (residueFieldAlgEquivOfSurjective
      (ψ := (ZMod.castHom (dvd_pow_self p two_ne_zero) (ZMod p)).toIntAlgHom)
      (ZMod.castHom_surjective (dvd_pow_self p two_ne_zero))).symm.toAddEquiv.trans
    (residueExt1Equiv (ZMod.maximalIdeal_prime_pow_eq_span p 2)
      (ZMod.natCast_self_mul_self_eq_zero p) (ZMod.natCast_self_sq_ne_zero p)).toAddEquiv

/-- The image of `1` is the class of the almost-split residue sequence. -/
@[simp]
theorem zmodResidueExt1AddEquiv_one (p : ℕ) [Fact p.Prime] :
    zmodResidueExt1AddEquiv p 1 = Ext1.mk (residueExtension
      (ZMod.maximalIdeal_prime_pow_eq_span p 2)
      (ZMod.natCast_self_mul_self_eq_zero p) (ZMod.natCast_self_sq_ne_zero p)) :=
  (congrArg (residueExt1Equiv _ _ _) (map_one (residueFieldAlgEquivOfSurjective
    (ψ := (ZMod.castHom (dvd_pow_self p two_ne_zero) (ZMod p)).toIntAlgHom)
    (ZMod.castHom_surjective (dvd_pow_self p two_ne_zero))).symm)).trans
    (residueExt1Equiv_one _ _ _)

/-- The image of the class of a natural number `n` is `n` times the class of the almost-split
residue sequence. -/
@[simp]
theorem zmodResidueExt1AddEquiv_natCast (p : ℕ) [Fact p.Prime] (n : ℕ) :
    zmodResidueExt1AddEquiv p n = n • Ext1.mk (residueExtension
      (ZMod.maximalIdeal_prime_pow_eq_span p 2)
      (ZMod.natCast_self_mul_self_eq_zero p) (ZMod.natCast_self_sq_ne_zero p)) := by
  rw [← nsmul_one, map_nsmul, zmodResidueExt1AddEquiv_one]

end TauCeti
