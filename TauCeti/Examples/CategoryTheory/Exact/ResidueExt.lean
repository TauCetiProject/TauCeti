module

public import TauCeti.CategoryTheory.Exact.YonedaExt.BaerSum
public import TauCeti.Data.ZMod.Nilpotent
public import TauCeti.Examples.CategoryTheory.Exact.AlmostSplit
import TauCeti.Algebra.Category.FGModuleCat.Projective
import TauCeti.CategoryTheory.Exact.YonedaExt.Projective

/-!
# Self-extensions over local rings with principal square-zero maximal ideal

If the maximal ideal of a commutative local ring `R` is generated by a nonzero square-zero
element, then the residue sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0` generates the Yoneda extension module
`Ext¹_R(R/𝔪, R/𝔪)`. Sending `1` to this sequence gives an `R`-linear equivalence from `R/𝔪`.
For `R = ℤ/p²ℤ` this identifies the group of self-extensions with `ℤ/pℤ`.

The connecting map is cobase change of the residue sequence. It is surjective since the
middle term is free. The residue sequence is nonsplit and the maximal ideal kills the residue
field, so the annihilator of the class is the maximal ideal.
The connecting map comes from the Hom–Ext exact sequence of Iyama, Nakaoka and Palu,
*Auslander–Reiten theory in extriangulated categories*, Fact 1.20(1), applied to the abelian
exact structure on finitely generated modules.
-/

public section

namespace TauCeti

open CategoryTheory ExactStructure _root_.IsLocalRing

universe u

section LocalRing

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] {ε : R}
variable (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) (hε₀ : ε ≠ 0)

private theorem smul_mk_residueExtension_eq_zero_iff (r : R) :
    r • Ext1.mk (residueExtension hm hε hε₀) = 0 ↔ r ∈ maximalIdeal R := by
  let e := residueExtension hm hε hε₀
  have hS : e.shortComplex.IsAlmostSplit := by
    rw [residueExtension_shortComplex]
    exact isAlmostSplit_residueSequence hm hε hε₀
  have hn := ((e.isAlmostSplit_iff_ext1_pushout).mp hS).1
  constructor
  · intro h
    exact (mem_maximalIdeal r).mpr fun hu ↦ hn (hu.smul_eq_zero.mp h)
  · intro hr
    have h : r • 𝟙 (residueFG R) = 0 := by
      have hr' : r ∈ Module.annihilator R (R ⧸ maximalIdeal R) := by
        rwa [Ideal.annihilator_quotient]
      exact FGModuleCat.hom_ext (LinearMap.ext fun x ↦ by
        simpa [FGModuleCat.hom_hom_smul, ModuleCat.hom_zero] using
          Module.mem_annihilator.mp hr' x)
    rw [Ext1.smul_eq_pushout, h, Ext1.pushout_zero]

private theorem surjective_smul_mk_residueExtension :
    Function.Surjective (fun r : R ↦ r • Ext1.mk (residueExtension hm hε hε₀)) := by
  intro ξ
  let e := residueExtension hm hε hε₀
  have hobj : e.obj = FGModuleCat.of R R :=
    congrArg ShortComplex.X₂ (residueExtension_shortComplex hm hε hε₀)
  have he : (ExactStructure.abelian _).isProjective e.obj := by
    rw [hobj]
    exact (abelian_isProjective_iff _).mpr (FGModuleCat.projective_of_free R _)
  obtain ⟨v, hv⟩ := e.exists_mk_pushout_eq_of_isProjective he ξ
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (v.hom.hom 1)
  have hv' : r • 𝟙 (residueFG R) = v := by
    apply FGModuleCat.hom_ext
    refine Submodule.linearMap_qext _ (LinearMap.ext_ring ?_)
    simpa [FGModuleCat.hom_hom_smul, Algebra.smul_def] using hr
  refine ⟨r, ?_⟩
  dsimp only
  rw [Ext1.smul_eq_pushout, hv']
  exact hv

/-- Multiples of the residue sequence identify the residue field with its Yoneda
self-extension module over a local ring with nonzero principal square-zero maximal ideal. -/
noncomputable def residueExt1Equiv :
    (R ⧸ maximalIdeal R) ≃ₗ[R]
      (ExactStructure.abelian (FGModuleCat.{u} R)).Ext1 (residueFG R) (residueFG R) :=
  let f := LinearMap.toSpanSingleton R _ (Ext1.mk (residueExtension hm hε hε₀))
  (Submodule.quotEquivOfEq _ f.ker (by
    ext r
    exact (smul_mk_residueExtension_eq_zero_iff hm hε hε₀ r).symm)) ≪≫ₗ
      f.quotKerEquivOfSurjective (surjective_smul_mk_residueExtension hm hε hε₀)

/-- The class of a scalar is sent to the corresponding multiple of the residue extension. -/
@[simp]
theorem residueExt1Equiv_mk (r : R) :
    residueExt1Equiv hm hε hε₀ (Ideal.Quotient.mk _ r) =
      r • Ext1.mk (residueExtension hm hε hε₀) :=
  (rfl)

/-- The residue sequence corresponds to `1` in the residue field. -/
@[simp]
theorem residueExt1Equiv_one :
    residueExt1Equiv hm hε hε₀ 1 = Ext1.mk (residueExtension hm hε hε₀) := by
  rw [← map_one (Ideal.Quotient.mk (maximalIdeal R)), residueExt1Equiv_mk, one_smul]

end LocalRing

section ZMod

/-- The Yoneda self-extension group of the residue field of `ℤ/p²ℤ` is additively
isomorphic to `ℤ/pℤ`. -/
noncomputable def zmodResidueExt1AddEquiv (p : ℕ) [Fact p.Prime] :
    ZMod p ≃+ (ExactStructure.abelian (FGModuleCat (ZMod (p ^ 2)))).Ext1
      (residueFG (ZMod (p ^ 2))) (residueFG (ZMod (p ^ 2))) :=
  let h := ZMod.castHom_surjective (dvd_pow_self p two_ne_zero)
  let reduction := (Ideal.quotEquivOfEq (IsLocalRing.ker_eq_maximalIdeal _ h).symm).trans
    (RingHom.quotientKerEquivOfSurjective h)
  reduction.symm.toAddEquiv.trans
    (residueExt1Equiv (ZMod.maximalIdeal_prime_pow_eq_span p 2)
      (by rw [← sq]; exact ZMod.natCast_pow_eq_zero_of_le p le_rfl)
      (ZMod.natCast_self_pow_ne_zero (Fact.out : p.Prime).one_lt one_lt_two)).toAddEquiv

/-- The image of `1` is the class of the almost-split residue sequence. -/
@[simp]
theorem zmodResidueExt1AddEquiv_one (p : ℕ) [Fact p.Prime] :
    zmodResidueExt1AddEquiv p 1 = Ext1.mk (residueExtension
      (ZMod.maximalIdeal_prime_pow_eq_span p 2)
      (by rw [← sq]; exact ZMod.natCast_pow_eq_zero_of_le p le_rfl)
      (ZMod.natCast_self_pow_ne_zero (Fact.out : p.Prime).one_lt one_lt_two)) := by
  have reduction_one {S T : Type} [Ring S] [Ring T] (e : S ≃+* T) :
      e.symm.toAddEquiv 1 = 1 := map_one e.symm
  simp only [zmodResidueExt1AddEquiv, AddEquiv.trans_apply, reduction_one]
  have hclass := residueExt1Equiv_one (ZMod.maximalIdeal_prime_pow_eq_span p 2)
    (by rw [← sq]; exact ZMod.natCast_pow_eq_zero_of_le p le_rfl)
    (ZMod.natCast_self_pow_ne_zero (Fact.out : p.Prime).one_lt one_lt_two)
  exact hclass

end ZMod

end TauCeti
