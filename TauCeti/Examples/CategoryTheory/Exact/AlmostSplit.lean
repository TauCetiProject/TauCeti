module

public import Mathlib.RingTheory.DualNumber
public import Mathlib.RingTheory.ZMod.LocalRing
public import TauCeti.Algebra.Category.FGModuleCat.Residue.Basic
public import TauCeti.Data.ZMod.LocalRing
public import TauCeti.Data.ZMod.Nilpotent

/-!
# Almost-split conflations of finitely generated modules over `ℤ/p²ℤ` and `k[ε]`

If the maximal ideal of a commutative local ring `R` is principal and generated by a nonzero
element `ε` of square zero (so that `R` is Noetherian), the sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0`,
whose first map is multiplication by `ε`, is almost split in `FGModuleCat R`, by
`TauCeti.isAlmostSplit_residueSequence` in
`TauCeti/Algebra/Category/FGModuleCat/Residue/Basic.lean`. This exercises the extension-class
criterion `TauCeti.ExactStructure.Extension.isAlmostSplit_iff_ext1_pushout`.

The hypotheses hold for `ℤ/p²ℤ` with `p` prime and `ε = p`, giving `0 ⟶ ℤ/pℤ ⟶ ℤ/p²ℤ ⟶ ℤ/pℤ ⟶ 0`,
and for the dual numbers `k[ε]` over a field `k`, giving `0 ⟶ k ⟶ k[ε] ⟶ k ⟶ 0`.
-/

public section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace TauCeti

section Examples

/-- **`0 ⟶ ℤ/pℤ ⟶ ℤ/p²ℤ ⟶ ℤ/pℤ ⟶ 0` is almost split** in the finitely generated `ℤ/p²ℤ`-modules,
with `ℤ/pℤ` the residue field of `ℤ/p²ℤ` and first map multiplication by `p`. -/
theorem isAlmostSplit_zmod (p : ℕ) [Fact p.Prime] :
    (residueSequence (ZMod.maximalIdeal_prime_pow_eq_span p 2)
      (ZMod.natCast_self_mul_self_eq_zero p)).IsAlmostSplit :=
  isAlmostSplit_residueSequence _ _ (ZMod.natCast_self_sq_ne_zero p)

/-- **`0 ⟶ k ⟶ k[ε] ⟶ k ⟶ 0` is almost split** in the finitely generated `k[ε]`-modules, with `k`
the residue field of the dual numbers and first map multiplication by `ε`. -/
theorem isAlmostSplit_dualNumber (k : Type u) [Field k] :
    (residueSequence (R := DualNumber k) DualNumber.maximalIdeal_eq_span_singleton_eps
      DualNumber.eps_mul_eps).IsAlmostSplit :=
  isAlmostSplit_residueSequence _ _ (TrivSqZeroExt.inr_injective.ne one_ne_zero)

end Examples

end TauCeti
