/-!
# Almost-split conflations of finitely generated modules over `ℤ/4ℤ` and `k[ε]`

If the maximal ideal of a commutative Noetherian local ring `R` is principal and generated by a
nonzero element `ε` of square zero, the sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0`, whose first map is
multiplication by `ε`, is almost split in `FGModuleCat R`. This exercises the extension-class
criterion `TauCeti.ExactStructure.Extension.isAlmostSplit_iff_ext1_pushout`.

The hypotheses hold for `ℤ/4ℤ` with `ε = 2`, giving `0 ⟶ ℤ/2ℤ ⟶ ℤ/4ℤ ⟶ ℤ/2ℤ ⟶ 0`, and for the dual
numbers `k[ε]` over a field `k`, giving `0 ⟶ k ⟶ k[ε] ⟶ k ⟶ 0`.
-/

public section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace TauCeti

section Residue

variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- Two linear maps out of the residue field agree when they agree at `1`. -/
private theorem residue_linearMap_ext {N : Type*} [AddCommGroup N] [Module R N]
    {r s : (R ⧸ maximalIdeal R) →ₗ[R] N} (h : r 1 = s 1) : r = s :=
  Submodule.linearMap_qext _ (LinearMap.ext_ring h)

variable {ε : R}

/-- A linear map from `R` to its residue field sends an element of the maximal ideal to `0`, so
not to `1`. -/
private theorem linearMap_apply_ne_one (hε : ε ∈ maximalIdeal R)
    (r : R →ₗ[R] R ⧸ maximalIdeal R) : r ε ≠ 1 := by
  obtain ⟨y, hy⟩ := Submodule.mkQ_surjective (maximalIdeal R) (r 1)
  have h₁ : r ε = Submodule.mkQ (maximalIdeal R) (ε * y) := by
    rw [← smul_eq_mul, map_smul, hy, ← map_smul, smul_eq_mul, mul_one]
  rw [h₁, Submodule.mkQ_apply,
    (Submodule.Quotient.mk_eq_zero _).mpr (Ideal.mul_mem_right y _ hε)]
  have := Ideal.Quotient.nontrivial_iff.mpr (maximalIdeal.isMaximal R).ne_top
  exact zero_ne_one

private theorem exists_smul_eq_of_mem_smul_top {N : Type*} [AddCommGroup N] [Module R N] {x : N}
    (hm : maximalIdeal R = .span {ε}) (hx : x ∈ maximalIdeal R • (⊤ : Submodule R N)) :
    ∃ n : N, ε • n = x := by
  rw [hm, Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists] at hx
  obtain ⟨n, -, hn⟩ := hx
  exact ⟨n, hn⟩

/-- Multiplication by a generator `ε` of the maximal ideal with `ε * ε = 0`, as a map from the
residue field to the ring. -/
noncomputable def residueMul (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) :
    (R ⧸ maximalIdeal R) →ₗ[R] R :=
  (maximalIdeal R).liftQ (LinearMap.toSpanSingleton R R ε) fun x hx ↦ by
    rw [hm, Ideal.mem_span_singleton] at hx
    obtain ⟨y, rfl⟩ := hx
    simp [mul_comm ε y, mul_assoc, hε]

/-- `residueMul` sends the class of `y` to `y * ε`. -/
@[simp]
theorem residueMul_mk (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) (y : R) :
    residueMul hm hε (Ideal.Quotient.mk _ y) = y * ε :=
  Submodule.liftQ_apply _ (LinearMap.toSpanSingleton R R ε) y

/-- `residueMul` sends `1` to `ε`. -/
@[simp]
theorem residueMul_one (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) :
    residueMul hm hε 1 = ε :=
  (residueMul_mk hm hε 1).trans (one_mul ε)

private theorem residueMul_injective (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0)
    (hε₀ : ε ≠ 0) : Function.Injective (residueMul hm hε) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [residueMul_mk] at hx
  refine Ideal.Quotient.eq_zero_iff_mem.mpr ((mem_maximalIdeal y).mpr fun hy ↦ hε₀ ?_)
  exact (hy.mul_right_eq_zero).mp hx

/-- Multiplication by `ε` and the quotient map form an exact pair, since `𝔪 = (ε)`. -/
theorem exact_residueMul (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) :
    Function.Exact (residueMul hm hε) (Submodule.mkQ (maximalIdeal R)) := by
  intro x
  have hx : x ∈ maximalIdeal R ↔ ∃ y, y * ε = x := by rw [hm, Ideal.mem_span_singleton']
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hx]
  refine ⟨fun ⟨y, hy⟩ ↦ ⟨Ideal.Quotient.mk _ y, by rw [residueMul_mk, hy]⟩, ?_⟩
  rintro ⟨y, rfl⟩
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨y, (residueMul_mk hm hε y).symm⟩

variable [IsNoetherianRing R]

/-- The residue field of a commutative local ring, as a finitely generated module. -/
abbrev residueFG (R : Type u) [CommRing R] [IsLocalRing R] : FGModuleCat.{u} R :=
  FGModuleCat.of R (R ⧸ maximalIdeal R)

instance : IsLocalRing (End (residueFG R)) := by
  have : IsSimpleModule R (R ⧸ maximalIdeal R) :=
    isSimpleModule_iff_isCoatom.mpr Ideal.IsMaximal.out
  have : IsLocalRing (Module.End R (R ⧸ maximalIdeal R)) :=
    .of_isUnit_or_isUnit_one_sub_self fun a ↦ (LinearMap.bijective_or_eq_zero a).elim
      (fun h ↦ .inl ((Module.End.isUnit_iff a).mpr h)) fun h ↦ .inr (by simp [h])
  have : IsLocalRing (Module.End R (residueFG R).obj) :=
    ‹IsLocalRing (Module.End R (R ⧸ maximalIdeal R))›
  have : IsLocalRing (End ((ObjectProperty.ι _).obj (residueFG R))) :=
    (ModuleCat.endRingEquiv (residueFG R).obj).symm.isLocalRing
  exact ((ObjectProperty.fullyFaithfulι _).ringEquivEnd (residueFG R)).symm.isLocalRing

/-- The sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0` of finitely generated modules, whose first map is
multiplication by a generator `ε` of the maximal ideal with `ε * ε = 0` and whose second map is the
quotient map. -/
noncomputable abbrev residueSequence (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) :
    ShortComplex (FGModuleCat.{u} R) :=
  .mk (X₁ := residueFG R) (X₂ := FGModuleCat.of R R) (X₃ := residueFG R)
    (FGModuleCat.ofHom (residueMul hm hε)) (FGModuleCat.ofHom (Submodule.mkQ (maximalIdeal R)))
    (FGModuleCat.hom_ext (LinearMap.ext (exact_residueMul hm hε).apply_apply_eq_zero))

private theorem shortExact_residueSequence (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0)
    (hε₀ : ε ≠ 0) : (residueSequence hm hε).ShortExact := by
  refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
  · rw [← ShortComplex.exact_map_iff_of_faithful _ (forget₂ (FGModuleCat.{u} R) (ModuleCat.{u} R)),
      ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
    exact exact_residueMul hm hε
  · exact ConcreteCategory.mono_of_injective _ (residueMul_injective hm hε hε₀)
  · exact ConcreteCategory.epi_of_surjective _ (Submodule.mkQ_surjective _)

/-- **The sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0` is almost split in `FGModuleCat R`** when `𝔪` is
generated by a nonzero element `ε` with `ε * ε = 0`. -/
theorem isAlmostSplit_residueSequence (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0)
    (hε₀ : ε ≠ 0) : (residueSequence hm hε).IsAlmostSplit := by
  let e : (ExactStructure.abelian (FGModuleCat.{u} R)).Extension (residueFG R) (residueFG R) :=
    ⟨_, (residueSequence hm hε).f, (residueSequence hm hε).g, (residueSequence hm hε).zero,
      (ExactStructure.abelian_conflation _).mpr (shortExact_residueSequence hm hε hε₀)⟩
  refine e.isAlmostSplit_iff_ext1_pushout.mpr ⟨fun h ↦ ?_, fun W v hv ↦
    (ExactStructure.Ext1.mk_pushout_eq_zero_iff e v).mpr ?_⟩
  · -- A retraction of multiplication by `ε` would send `ε ∈ 𝔪` to `1`, but `𝔪` kills `R/𝔪`.
    have := (ExactStructure.Ext1.mk_eq_zero_iff_isSplitMono e).mp h
    let r : R →ₗ[R] R ⧸ maximalIdeal R := (retraction e.f).hom.hom
    have hr : r (residueMul hm hε 1) = 1 := congr($(IsSplitMono.id e.f).hom.hom 1)
    rw [residueMul_one] at hr
    exact linearMap_apply_ne_one (by rw [hm]; exact Ideal.mem_span_singleton_self ε) r hr
  · -- If `v 1 ∉ 𝔪 W`, a linear map to the residue field retracts `v`.
    have hn : v.hom.hom 1 ∈ maximalIdeal R • (⊤ : Submodule R W.obj) := by
      by_contra hn
      obtain ⟨r, hr⟩ := IsLocalRing.exists_linearMap_quotient_eq_one hn
      exact hv (IsSplitMono.mk' ⟨FGModuleCat.ofHom r, FGModuleCat.hom_ext
        (residue_linearMap_ext hr)⟩)
    obtain ⟨n, hn⟩ := exists_smul_eq_of_mem_smul_top hm hn
    refine ⟨FGModuleCat.ofHom (LinearMap.toSpanSingleton R W n), FGModuleCat.hom_ext
      (residue_linearMap_ext ?_)⟩
    -- Composition in `FGModuleCat` is composition of the underlying linear maps.
    have h : LinearMap.toSpanSingleton R W n (residueMul hm hε 1) = v.hom.hom 1 := by
      rw [residueMul_one, LinearMap.toSpanSingleton_apply, hn]
    exact h

end Residue

section Examples

local instance : IsLocalRing (ZMod 4) := inferInstanceAs (IsLocalRing (ZMod (2 ^ 2)))

/-- The maximal ideal of `ℤ/4ℤ` is generated by `2`. -/
theorem maximalIdeal_zmod_four : maximalIdeal (ZMod 4) = .span {2} := by
  ext x
  simp only [mem_maximalIdeal, mem_nonunits_iff, Ideal.mem_span_singleton, isUnit_iff_exists_inv,
    dvd_def]
  revert x
  decide

/-- **`0 ⟶ ℤ/2ℤ ⟶ ℤ/4ℤ ⟶ ℤ/2ℤ ⟶ 0` is almost split** in the finitely generated `ℤ/4ℤ`-modules,
with `ℤ/2ℤ` the residue field of `ℤ/4ℤ` and first map multiplication by `2`. -/
theorem isAlmostSplit_zmod_four :
    (residueSequence maximalIdeal_zmod_four (by decide)).IsAlmostSplit :=
  isAlmostSplit_residueSequence _ _ (by decide)

local instance (k : Type u) [Field k] : IsNoetherianRing (DualNumber k) :=
  IsNoetherianRing.of_finite k _

/-- **`0 ⟶ k ⟶ k[ε] ⟶ k ⟶ 0` is almost split** in the finitely generated `k[ε]`-modules, with `k`
the residue field of the dual numbers and first map multiplication by `ε`. -/
theorem isAlmostSplit_dualNumber (k : Type u) [Field k] :
    (residueSequence (R := DualNumber k) DualNumber.maximalIdeal_eq_span_singleton_eps
      DualNumber.eps_mul_eps).IsAlmostSplit :=
  isAlmostSplit_residueSequence _ _ (TrivSqZeroExt.inr_injective.ne one_ne_zero)

end Examples

end TauCeti
