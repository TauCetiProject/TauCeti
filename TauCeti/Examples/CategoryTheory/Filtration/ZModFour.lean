module

public import Mathlib.Data.ZMod.Basic
public import TauCeti.Algebra.Category.ModuleCat.Filtration.Graded
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import TauCeti.Algebra.Category.ModuleCat.Int

/-!
# Check: graded pieces do not determine a finitely filtered object

The filtration `F^0 = ℤ/4`, `F^1 = 2ℤ/4`, `F^2 = 0` of `ℤ/4` (`zmodFourFiltration`) is finite,
with `gr^0 ≅ gr^1 ≅ ℤ/2` (`nonempty_gr_zero_zmodFour_iso`, `nonempty_gr_one_zmodFour_iso`).
The module `ℤ/2 ⊕ ℤ/2`, filtered by its first summand (`kleinFiltration`), is also finitely
filtered and has the same graded pieces in every degree (`nonempty_gr_iso`), but is not isomorphic
to `ℤ/4` (`not_nonempty_iso`): in `ℤ/4` the element `1` has `2 • 1 ≠ 0`.

Both filtrations are `ℤ`-modules with steps `M` in degrees `p ≤ 0`, a submodule `N` in degree
`1` and `0` in degrees `p ≥ 2` (`threeStep N`). The graded pieces are computed through their
cardinalities (`CategoryTheory.FilteredObject.card_step_eq_card_mul_card_gr`): both modules have
four elements and `N` two, so `gr^0` and `gr^1` have two elements and the others one, and
`ℤ`-modules of the same prime order are isomorphic (`ModuleCat.nonempty_iso_of_card_eq_prime`).
-/

public section

open CategoryTheory FilteredObject

namespace TauCeti.Examples.ZModFourFiltration

variable {M : Type} [AddCommGroup M]

/-- The steps `F^p = M` for `p ≤ 0`, `F^1 = N` and `F^p = 0` for `p ≥ 2`. -/
def threeStep (N : Submodule ℤ M) (p : ℤ) : Submodule ℤ M :=
  if p ≤ 0 then ⊤ else if p = 1 then N else ⊥

/-- The steps `threeStep N` decrease. -/
theorem antitone_threeStep (N : Submodule ℤ M) : Antitone (threeStep N) := fun p q hpq ↦ by
  unfold threeStep
  split_ifs <;> first | exact le_top | exact bot_le | exact le_rfl | omega

/-- The cardinality of the step `F^p`, when `|M| = 4` and `|N| = 2`. -/
private theorem card_threeStep {N : Submodule ℤ M} (hM : Nat.card M = 4) (hN : Nat.card N = 2)
    (p : ℤ) : Nat.card (threeStep N p) = if p ≤ 0 then 4 else if p = 1 then 2 else 1 := by
  unfold threeStep
  split_ifs
  · rw [Nat.card_congr Submodule.topEquiv.toEquiv, hM]
  · exact hN
  · exact Nat.card_unique

/-- The cardinality of `gr^p`, when `|M| = 4` and `|N| = 2`: two for `p ∈ {0, 1}`, one
otherwise. -/
private theorem card_gr_threeStep {N : Submodule ℤ M} (hM : Nat.card M = 4)
    (hN : Nat.card N = 2) (p : ℤ) :
    Nat.card ((gr (C := ModuleCat ℤ) p).obj (ofAntitone _ (antitone_threeStep N))) =
      if p = 0 ∨ p = 1 then 2 else 1 := by
  have h := card_step_eq_card_mul_card_gr _ (antitone_threeStep N) p
  rw [card_threeStep hM hN, card_threeStep hM hN] at h
  split_ifs at h ⊢ <;> omega

/-- `2ℤ/4`, the submodule of `ℤ/4` generated by `2`. -/
abbrev twoZModFour : Submodule ℤ (ZMod 4) :=
  (AddSubgroup.zmultiples (2 : ZMod 4)).toIntSubmodule

/-- The filtration `F^0 = ℤ/4`, `F^1 = 2ℤ/4`, `F^2 = 0` of `ℤ/4`. -/
noncomputable abbrev zmodFourFiltration : FilteredObject (ModuleCat ℤ) ℤᵒᵖ :=
  ofAntitone _ (antitone_threeStep twoZModFour)

/-- `ℤ/2 ⊕ ℤ/2`, filtered by its first summand: `F^0 = ℤ/2 ⊕ ℤ/2`, `F^1 = ℤ/2 ⊕ 0`,
`F^2 = 0`. -/
noncomputable abbrev kleinFiltration : FilteredObject (ModuleCat ℤ) ℤᵒᵖ :=
  ofAntitone _ (antitone_threeStep (LinearMap.range (LinearMap.inl ℤ (ZMod 2) (ZMod 2))))

/-- `2ℤ/4` has two elements. -/
private theorem card_twoZModFour : Nat.card twoZModFour = 2 := by
  -- `AddSubgroup.toIntSubmodule` keeps the carrier, so the two subtypes are the same type, and
  -- Mathlib computes the cardinality of `zmultiples` as an additive order.
  change Nat.card (AddSubgroup.zmultiples (2 : ZMod 4)) = 2
  rw [Nat.card_zmultiples, ← Nat.cast_ofNat (R := ZMod 4) (n := 2),
    ZMod.addOrderOf_coe _ (by norm_num)]
  rfl

/-- The first summand of `ℤ/2 ⊕ ℤ/2` has two elements. -/
private theorem card_inl : Nat.card (LinearMap.range (LinearMap.inl ℤ (ZMod 2) (ZMod 2))) = 2 := by
  rw [← Nat.card_congr (LinearEquiv.ofInjective _ LinearMap.inl_injective).toEquiv,
    Nat.card_zmod]

private theorem card_zmodFour_gr (p : ℤ) :
    Nat.card ((gr (C := ModuleCat ℤ) p).obj zmodFourFiltration) =
      if p = 0 ∨ p = 1 then 2 else 1 :=
  card_gr_threeStep (by simp) card_twoZModFour p

private theorem card_klein_gr (p : ℤ) :
    Nat.card ((gr (C := ModuleCat ℤ) p).obj kleinFiltration) =
      if p = 0 ∨ p = 1 then 2 else 1 :=
  card_gr_threeStep (by simp) card_inl p

/-- The filtration with steps `threeStep N` is finite: `F^0 = M` and `F^2 = 0`. -/
theorem isFinite_threeStep (N : Submodule ℤ M) : (ofAntitone _ (antitone_threeStep N)).IsFinite :=
  IsFinite.mk (a := 0) (b := 2) (by simp [threeStep, step_ofSubmodules])
    (by simp [threeStep, step_ofSubmodules])

/-- The filtration `F^0 = ℤ/4`, `F^1 = 2ℤ/4`, `F^2 = 0` of `ℤ/4` is finite. -/
theorem isFinite_zmodFourFiltration : zmodFourFiltration.IsFinite :=
  isFinite_threeStep _

/-- The filtration of `ℤ/2 ⊕ ℤ/2` by its first summand is finite. -/
theorem isFinite_kleinFiltration : kleinFiltration.IsFinite :=
  isFinite_threeStep _

/-- `gr^0 ≅ ℤ/2` for the filtration of `ℤ/4`. -/
theorem nonempty_gr_zero_zmodFour_iso :
    Nonempty ((gr 0).obj zmodFourFiltration ≅ ModuleCat.of ℤ (ZMod 2)) :=
  ModuleCat.nonempty_iso_of_card_eq_prime Nat.prime_two (by simpa using card_zmodFour_gr 0)
    (by simp)

/-- `gr^1 ≅ ℤ/2` for the filtration of `ℤ/4`. -/
theorem nonempty_gr_one_zmodFour_iso :
    Nonempty ((gr 1).obj zmodFourFiltration ≅ ModuleCat.of ℤ (ZMod 2)) :=
  ModuleCat.nonempty_iso_of_card_eq_prime Nat.prime_two (by simpa using card_zmodFour_gr 1)
    (by simp)

/-- The filtrations of `ℤ/4` and of `ℤ/2 ⊕ ℤ/2` have isomorphic graded pieces in every degree. -/
theorem nonempty_gr_iso (p : ℤ) :
    Nonempty ((gr p).obj zmodFourFiltration ≅ (gr p).obj kleinFiltration) := by
  have h₁ := card_zmodFour_gr p
  have h₂ := card_klein_gr p
  split_ifs at h₁ h₂
  · exact ModuleCat.nonempty_iso_of_card_eq_prime Nat.prime_two h₁ h₂
  · have := (Nat.card_eq_one_iff_unique.1 h₁).1
    have := (Nat.card_eq_one_iff_unique.1 h₂).1
    exact ⟨(LinearEquiv.ofSubsingleton ((gr (C := ModuleCat ℤ) p).obj zmodFourFiltration)
      ((gr (C := ModuleCat ℤ) p).obj kleinFiltration)).toModuleIso⟩

/-- **The graded pieces do not determine the object**: `ℤ/4` and `ℤ/2 ⊕ ℤ/2` are not isomorphic,
although their filtrations have isomorphic graded pieces (`nonempty_gr_iso`). -/
theorem not_nonempty_iso : ¬ Nonempty (zmodFourFiltration.X ≅ kleinFiltration.X) := by
  rintro ⟨e⟩
  -- The underlying objects of `ofSubmodules` filtrations are `ModuleCat.of ℤ (ZMod 4)` and
  -- `ModuleCat.of ℤ (ZMod 2 × ZMod 2)` by definition, so `e` is a linear equivalence between them.
  let f : ZMod 4 ≃ₗ[ℤ] ZMod 2 × ZMod 2 := e.toLinearEquiv
  -- `ℤ/2 ⊕ ℤ/2` has characteristic two, so `2 • f 1 = f 1 + f 1 = 0`.
  have h : f ((2 : ℤ) • 1) = 0 := by
    rw [map_zsmul, two_zsmul]
    exact CharTwo.add_self_eq_zero _
  rw [LinearEquiv.map_eq_zero_iff] at h
  exact absurd h (by decide)

end TauCeti.Examples.ZModFourFiltration
