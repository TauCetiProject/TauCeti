/-!
# Sharpness of the Harada–Sai bound for length two

Let `R` be a commutative local ring whose maximal ideal is generated by a nonzero
square-zero element `ε`. The only finitely generated indecomposable modules, up to isomorphism,
are `R` and its residue field. They have lengths two and one, so the Harada–Sai bound gives
`rad³ = 0` in `mod R`. The composite of the quotient map with multiplication by `ε`
is a nonzero element of `rad²(R, R)`.

The calculation applies to both the dual numbers over a field and `ℤ/p²ℤ` for prime `p`.
In particular, both realize the exponent `2 ^ 2 - 1` in the Harada–Sai bound.

## References

* I. Assem, D. Simson, A. Skowroński, *Elements of the Representation Theory of Associative
  Algebras, Vol. 1*, Cambridge University Press (2006), Lemma IV.5.2 (the Harada–Sai bound)
  and Theorem V.3.5 (the corresponding classification for connected basic Nakayama algebras).
-/

public section

open CategoryTheory CategoryTheory.Limits _root_.IsLocalRing

namespace TauCeti

universe u

variable {R : Type u} [CommRing R] [IsLocalRing R] {ε : R}

private theorem isArtinianRing_of_maximalIdeal_eq_span
    (hm : maximalIdeal R = Ideal.span {ε}) (hε : ε * ε = 0) : IsArtinianRing R := by
  have := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, by rw [sq, hε]⟩
  refine (isArtinianRing_iff_isNilpotent_maximalIdeal R).mpr ⟨2, ?_⟩
  rw [hm, Ideal.span_singleton_pow, sq, hε, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]

/-- If the maximal ideal is generated by a nonzero square-zero element, the regular module has
composition length two. -/
theorem length_self_eq_two_of_maximalIdeal_eq_span
    (hm : maximalIdeal R = Ideal.span {ε}) (hε : ε * ε = 0) (hε₀ : ε ≠ 0) :
    Module.length R R = 2 := by
  have := isArtinianRing_of_maximalIdeal_eq_span hm hε
  have h := length_eq_add_of_shortExact (isAlmostSplit_residueSequence hm hε hε₀).shortExact
  simpa [FGModuleCat.length_eq, Ideal.length_quotient_eq_one, one_add_one_eq_two] using h

/-- Over a local ring with maximal ideal generated by a nonzero square-zero element, the
indecomposable finitely generated modules are the regular module and the residue field. -/
theorem indecomposable_iff_nonempty_iso_regular_or_residueFG
    (hm : maximalIdeal R = Ideal.span {ε}) (hε : ε * ε = 0) (hε₀ : ε ≠ 0)
    (M : FGModuleCat.{u} R) :
    Indecomposable M ↔ Nonempty (M ≅ FGModuleCat.of R R) ∨ Nonempty (M ≅ residueFG R) := by
  have := isArtinianRing_of_maximalIdeal_eq_span hm hε
  constructor
  · intro hM
    have : Nontrivial M := not_subsingleton_iff_nontrivial.mp
      (mt FGModuleCat.isZero_iff_subsingleton.mpr hM.1)
    have := (IsKrullSchmidt.indecomposable_iff_isLocalRing_end M).mp hM
    have htop := Submodule.top_ne_ideal_smul_of_le_jacobson_annihilator (M := M)
      ((ringJacobson_eq_maximalIdeal R).ge.trans Ideal.ringJacobson_le_jacobson)
    obtain ⟨x, hx⟩ := not_forall.mp
      (fun h ↦ htop ((Submodule.eq_top_iff'.2 h).symm))
    obtain ⟨q, hq⟩ := IsLocalRing.exists_linearMap_quotient_eq_one (R := R) hx
    by_cases hs : IsSplitEpi (FGModuleCat.ofHom q)
    · have := hs.isIso_of_isLocalRing_end
      exact Or.inr ⟨asIso (FGModuleCat.ofHom q)⟩
    obtain ⟨f, hf⟩ := (isAlmostSplit_residueSequence hm hε hε₀).isRightAlmostSplit_g.factors
      M (FGModuleCat.ofHom q) hs
    -- A lift of a vector whose residue is 1 maps to a unit in the regular module.
    have hfx : Ideal.Quotient.mk (maximalIdeal R) (f.hom.hom x) = 1 := by
      have heval := congrArg (fun a ↦ a.hom.hom x) hf
      rw [FGModuleCat.hom_hom_comp, LinearMap.comp_apply,
        FGModuleCat.hom_hom_ofHom (Submodule.mkQ (maximalIdeal R)), FGModuleCat.hom_hom_ofHom q,
        Submodule.mkQ_apply, Ideal.Quotient.mk_eq_mk] at heval
      exact heval.trans hq
    have hu : IsUnit (f.hom.hom x) := notMem_maximalIdeal.mp fun h ↦
      zero_ne_one ((Ideal.Quotient.eq_zero_iff_mem.mpr h).symm.trans hfx)
    obtain ⟨a, ha⟩ := hu
    have hsurj : Function.Surjective f.hom.hom := fun r ↦
      ⟨(r * ↑a⁻¹) • x, by rw [map_smul, ← ha, smul_eq_mul, mul_assoc]; simp⟩
    obtain ⟨s, hsection⟩ := Module.projective_lifting_property f.hom.hom
      (LinearMap.id : R →ₗ[R] R) hsurj
    have hf' : IsSplitEpi f := by
      refine IsSplitEpi.mk' ⟨FGModuleCat.ofHom s, FGModuleCat.hom_ext ?_⟩
      rw [FGModuleCat.hom_hom_comp, FGModuleCat.hom_hom_ofHom s, FGModuleCat.hom_hom_id]
      exact hsection
    have := hf'.isIso_of_isLocalRing_end
    exact Or.inl ⟨asIso f⟩
  · rintro (h | h) <;> obtain ⟨e⟩ := h <;>
      exact (IsKrullSchmidt.indecomposable_iff_isLocalRing_end M).mpr
        e.endRingEquiv.symm.isLocalRing

/-- In the category of finitely generated modules over a local ring with maximal ideal generated
by a nonzero square-zero element, the categorical radical has nilpotency index three. -/
theorem jacobsonRadicalIdeal_pow_three_eq_bot_and_sq_ne_bot
    (hm : maximalIdeal R = Ideal.span {ε}) (hε : ε * ε = 0) (hε₀ : ε ≠ 0) :
    jacobsonRadicalIdeal (FGModuleCat.{u} R) ^ 3 = ⊥ ∧
      jacobsonRadicalIdeal (FGModuleCat.{u} R) ^ 2 ≠ ⊥ := by
  have hlength := length_self_eq_two_of_maximalIdeal_eq_span hm hε hε₀
  have := isArtinianRing_of_maximalIdeal_eq_span hm hε
  constructor
  · refine FGModuleCat.jacobsonRadicalIdeal_pow_eq_bot_of_length_le (b := 2) fun M hM ↦ ?_
    rcases (indecomposable_iff_nonempty_iso_regular_or_residueFG hm hε hε₀ M).mp
      ((FGModuleCat.indecomposable_obj_iff M).mp hM) with h | h
    · obtain ⟨e⟩ := h
      exact ((FGModuleCat.isoToLinearEquiv e).length_eq.trans hlength).le
    · obtain ⟨e⟩ := h
      rw [(FGModuleCat.isoToLinearEquiv e).length_eq, Ideal.length_quotient_eq_one]
      exact one_le_two
  · intro h
    let S := residueSequence hm hε
    have hS : S.IsAlmostSplit := isAlmostSplit_residueSequence hm hε hε₀
    have hmem := comp_mem_jacobsonRadicalSq
      (mem_jacobsonRadical_iff_not_isSplitEpi.mpr hS.isRightAlmostSplit_g.not_isSplitEpi)
      (mem_jacobsonRadical_iff_not_isSplitMono.mpr hS.isLeftAlmostSplit_f.not_isSplitMono)
    rw [← jacobsonRadicalIdeal_sq_hom, h, MorphismIdeal.mem_bot] at hmem
    have heval := congrArg (fun a ↦ a.hom.hom (1 : R)) hmem
    exact hε₀ (by simpa [S] using heval)

/-- For the dual numbers over a field, the categorical radical has nilpotency index three. -/
theorem jacobsonRadicalIdeal_pow_three_eq_bot_and_sq_ne_bot_dualNumber (k : Type u) [Field k] :
    jacobsonRadicalIdeal (FGModuleCat.{u} (DualNumber k)) ^ 3 = ⊥ ∧
      jacobsonRadicalIdeal (FGModuleCat.{u} (DualNumber k)) ^ 2 ≠ ⊥ :=
  jacobsonRadicalIdeal_pow_three_eq_bot_and_sq_ne_bot DualNumber.maximalIdeal_eq_span_singleton_eps
    DualNumber.eps_mul_eps (TrivSqZeroExt.inr_injective.ne one_ne_zero)

/-- For `ℤ/p²ℤ` with `p` prime, the categorical radical has nilpotency index three. -/
theorem jacobsonRadicalIdeal_pow_three_eq_bot_and_sq_ne_bot_zmod (p : ℕ) [Fact p.Prime] :
    jacobsonRadicalIdeal (FGModuleCat.{0} (ZMod (p ^ 2))) ^ 3 = ⊥ ∧
      jacobsonRadicalIdeal (FGModuleCat.{0} (ZMod (p ^ 2))) ^ 2 ≠ ⊥ :=
  jacobsonRadicalIdeal_pow_three_eq_bot_and_sq_ne_bot (ZMod.maximalIdeal_prime_pow_eq_span p 2)
    (by rw [← sq]; exact ZMod.natCast_pow_eq_zero_of_le p le_rfl)
    (ZMod.natCast_self_pow_ne_zero (Fact.out : p.Prime).one_lt one_lt_two)

end TauCeti
