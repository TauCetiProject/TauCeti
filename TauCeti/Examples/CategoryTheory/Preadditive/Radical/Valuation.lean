module

public import TauCeti.CategoryTheory.Preadditive.Radical.Valuation
public import TauCeti.Examples.CategoryTheory.Exact.AlmostSplit
-- Non-public: the scaling of morphisms, the `k`-linear structure over a field, the local
-- endomorphism ring of `R` over itself, the irreducibility of the maps of an almost-split sequence,
-- the Noetherian criterion, the maximal ideal of `ℤ/p²ℤ` and the nonvanishing of `p` in `ℤ/p²ℤ`
-- are used only inside proofs and examples.
import TauCeti.Algebra.Category.FGModuleCat.Basic
import TauCeti.Algebra.Category.FGModuleCat.End
