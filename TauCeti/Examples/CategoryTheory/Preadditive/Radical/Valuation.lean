import TauCeti.RingTheory.LocalRing.MaximalIdeal.Generator

/-!
# The valuations of the arrows between `ℤ/pℤ` and `ℤ/p²ℤ`

Let `R` be a commutative local ring whose maximal ideal `𝔪` is generated by a nonzero element `ε`
with `ε * ε = 0` (so `R` is Noetherian), and write `S = R/𝔪` for the residue field. Both arrows
`S ⟶ R` (multiplication by `ε`) and `R ⟶ S` (the quotient map) of the almost-split sequence
`0 ⟶ S ⟶ R ⟶ S ⟶ 0` (`TauCeti/Examples/CategoryTheory/Exact/AlmostSplit.lean`) are irreducible
in `FGModuleCat R`, and every morphism `S ⟶ R` or `R ⟶ S` is a scalar multiple of the
corresponding one. So both spaces of irreducible morphisms are generated by one class over each
residue division ring, and both arrows of the valued Auslander-Reiten quiver carry the valuation
`(1, 1)` (`TauCeti.irreducibleMorphismValuation_eq_one_one_of_forall_sub_smul_mem`), whichever
ring `S` acting linearly on `FGModuleCat R` the spaces of irreducible morphisms are formed over.

For `R = ℤ/p²ℤ` with `p` prime and `ε = p`: **both arrows between `ℤ/pℤ` and `ℤ/p²ℤ` have
valuation `(1, 1)`**, with `ℤ/pℤ` the residue field of `ℤ/p²ℤ`. The dual numbers `k[ε]` over a
field `k` give the same answer for the arrows between `k` and `k[ε]`, in particular over `k`.

## Main results

* `TauCeti.irreducibleMorphismValuation_residueFG_self` and
  `TauCeti.irreducibleMorphismValuation_self_residueFG`: the two valuations are `(1, 1)`.
* `TauCeti.irreducibleMorphismValuation_zmod_residueFG_self` and
  `TauCeti.irreducibleMorphismValuation_zmod_self_residueFG`: the case of `ℤ/p²ℤ`.
* `TauCeti.irreducibleMorphismValuation_dualNumber_residueFG_self` and
  `TauCeti.irreducibleMorphismValuation_dualNumber_self_residueFG`: the case of `k[ε]`.

## References

* M. Auslander, I. Reiten, S. O. Smalø, *Representation Theory of Artin Algebras*, Cambridge
  University Press (1995), Section VII.1, for the valuation of an arrow of the Auslander-Reiten
  quiver.
-/

public section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace TauCeti

section Residue

variable {R : Type u} [CommRing R] [IsLocalRing R] {ε : R}
variable (S : Type*) [Ring S] [Linear S (FGModuleCat.{u} R)]

/-- **The arrow `R/𝔪 ⟶ R` has valuation `(1, 1)`** when the maximal ideal is generated by a
nonzero element of square zero, over any ring `S` acting linearly on `FGModuleCat R`. -/
theorem irreducibleMorphismValuation_residueFG_self (hm : maximalIdeal R = .span {ε})
    (hε : ε * ε = 0) (hε₀ : ε ≠ 0) :
    irreducibleMorphismValuation S (residueFG R) (FGModuleCat.of R R) = (1, 1) := by
  have := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, by rw [sq, hε]⟩
  have hS := isAlmostSplit_residueSequence hm hε hε₀
  refine irreducibleMorphismValuation_eq_one_one_of_forall_sub_smul_mem S (A := R)
    (f := (residueSequence hm hε).f) ?_ fun u _ => ?_
  · simpa using hS.isIrreducibleMorphism_f_comp hS.not_isZero_X₂ (𝟙 _)
  · obtain ⟨y, rfl⟩ := exists_eq_smul_residueSequence_f hm hε hε₀ u
    exact ⟨y, by simp⟩

/-- **The arrow `R ⟶ R/𝔪` has valuation `(1, 1)`** when the maximal ideal is generated by a
nonzero element of square zero, over any ring `S` acting linearly on `FGModuleCat R`. -/
theorem irreducibleMorphismValuation_self_residueFG (hm : maximalIdeal R = .span {ε})
    (hε : ε * ε = 0) (hε₀ : ε ≠ 0) :
    irreducibleMorphismValuation S (FGModuleCat.of R R) (residueFG R) = (1, 1) := by
  have := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, by rw [sq, hε]⟩
  have hS := isAlmostSplit_residueSequence hm hε hε₀
  refine irreducibleMorphismValuation_eq_one_one_of_forall_sub_smul_mem S (A := R)
    (f := (residueSequence hm hε).g) ?_ fun u _ => ?_
  · simpa using hS.isIrreducibleMorphism_comp_g hS.not_isZero_X₂ (𝟙 _)
  · -- A morphism out of `R` is determined by the image of `1`, the class of some `y`.
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (u.hom.hom 1)
    obtain rfl : u = y • (residueSequence hm hε).g :=
      FGModuleCat.hom_ext (LinearMap.ext_ring (by simpa [FGModuleCat.hom_hom_smul,
        Algebra.smul_def] using hy.symm))
    exact ⟨y, by simp⟩

end Residue

section ZMod

variable (p : ℕ) [Fact p.Prime] (S : Type*) [Ring S] [Linear S (FGModuleCat.{0} (ZMod (p ^ 2)))]

/-- **The arrow `ℤ/pℤ ⟶ ℤ/p²ℤ` has valuation `(1, 1)`** in the finitely generated `ℤ/p²ℤ`-modules,
with `ℤ/pℤ` the residue field of `ℤ/p²ℤ`, over any ring `S` acting linearly on them. -/
theorem irreducibleMorphismValuation_zmod_residueFG_self :
    irreducibleMorphismValuation S (residueFG (ZMod (p ^ 2)))
      (FGModuleCat.of _ (ZMod (p ^ 2))) = (1, 1) :=
  irreducibleMorphismValuation_residueFG_self S (ZMod.maximalIdeal_prime_pow_eq_span p 2)
    (by rw [← sq]; exact ZMod.natCast_pow_eq_zero_of_le p le_rfl)
    (ZMod.natCast_self_pow_ne_zero (Fact.out : p.Prime).one_lt one_lt_two)

/-- **The arrow `ℤ/p²ℤ ⟶ ℤ/pℤ` has valuation `(1, 1)`** in the finitely generated `ℤ/p²ℤ`-modules,
with `ℤ/pℤ` the residue field of `ℤ/p²ℤ`, over any ring `S` acting linearly on them. -/
theorem irreducibleMorphismValuation_zmod_self_residueFG :
    irreducibleMorphismValuation S (FGModuleCat.of _ (ZMod (p ^ 2)))
      (residueFG (ZMod (p ^ 2))) = (1, 1) :=
  irreducibleMorphismValuation_self_residueFG S (ZMod.maximalIdeal_prime_pow_eq_span p 2)
    (by rw [← sq]; exact ZMod.natCast_pow_eq_zero_of_le p le_rfl)
    (ZMod.natCast_self_pow_ne_zero (Fact.out : p.Prime).one_lt one_lt_two)

end ZMod

section DualNumber

variable (k : Type u) [Field k] (S : Type*) [Ring S] [Linear S (FGModuleCat.{u} (DualNumber k))]

/-- **The arrow `k ⟶ k[ε]` has valuation `(1, 1)`** in the finitely generated `k[ε]`-modules, with
`k` the residue field of the dual numbers, over any ring `S` acting linearly on them, such as `k`
itself. -/
theorem irreducibleMorphismValuation_dualNumber_residueFG_self :
    irreducibleMorphismValuation S (residueFG (DualNumber k))
      (FGModuleCat.of _ (DualNumber k)) = (1, 1) :=
  irreducibleMorphismValuation_residueFG_self S DualNumber.maximalIdeal_eq_span_singleton_eps
    DualNumber.eps_mul_eps (TrivSqZeroExt.inr_injective.ne one_ne_zero)

/-- **The arrow `k[ε] ⟶ k` has valuation `(1, 1)`** in the finitely generated `k[ε]`-modules, with
`k` the residue field of the dual numbers, over any ring `S` acting linearly on them, such as `k`
itself. -/
theorem irreducibleMorphismValuation_dualNumber_self_residueFG :
    irreducibleMorphismValuation S (FGModuleCat.of _ (DualNumber k))
      (residueFG (DualNumber k)) = (1, 1) :=
  irreducibleMorphismValuation_self_residueFG S DualNumber.maximalIdeal_eq_span_singleton_eps
    DualNumber.eps_mul_eps (TrivSqZeroExt.inr_injective.ne one_ne_zero)

/-- Over the field `k` itself, acting through `ModuleCat.linearOverField`, both arrows between
`k` and `k[ε]` have valuation `(1, 1)`. -/
example : irreducibleMorphismValuation k (residueFG (DualNumber k))
      (FGModuleCat.of _ (DualNumber k)) = (1, 1) ∧
    irreducibleMorphismValuation k (FGModuleCat.of _ (DualNumber k))
      (residueFG (DualNumber k)) = (1, 1) :=
  ⟨irreducibleMorphismValuation_dualNumber_residueFG_self k k,
    irreducibleMorphismValuation_dualNumber_self_residueFG k k⟩

end DualNumber

end TauCeti
