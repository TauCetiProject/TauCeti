module

import Mathlib.Data.Fintype.Perm
import Mathlib.Data.Fintype.Powerset
import TauCeti.ModelTheory.RelationalConfiguration.Isomorphism
import TauCeti.MeasureTheory.Group.Arithmetic
import TauCeti.ModelTheory.RelationalConfiguration.Topology
import TauCeti.SetTheory.Descriptive.BorelAction

/-!
# Regression examples: Borel `S∞`-spaces

These examples exercise the Borel σ-algebra on permutation groups and the API of Borel actions:

* on `Equiv.Perm ℕ` the stabilizer of `0` and the set of permutations sending `0` to `1` are
  measurable, and the trivial σ-algebra contains neither;
* on `Equiv.Perm (Fin 3)` all `64` sets are measurable, whereas the σ-algebra generated by the
  evaluation at `0` does not separate the identity from the transposition of `1` and `2`;
* `ℕ` with the evaluation action is a Borel `S∞`-space with a single orbit;
* a standard Borel space with the trivial action is one, and its orbit relation is equality;
* the logic action on relational configurations on `ℕ` is a Borel `S∞`-space whose orbit relation
  is isomorphism, and so is its restriction to an invariant Borel set;
* an equivariant measurable injection between Borel `S∞`-spaces has an invariant Borel range and
  is a Borel reduction of the orbit relations.
-/

open MeasureTheory TauCeti

-- The stabilizer of `0` and the set `{σ | σ 0 = 1}` are measurable: they are preimages of points
-- under the measurable evaluation at `0`.
example : MeasurableSet {σ : Equiv.Perm ℕ | σ 0 = 0} :=
  Equiv.Perm.measurable_apply 0 (measurableSet_singleton 0)

example : MeasurableSet {σ : Equiv.Perm ℕ | σ 0 = 1} :=
  Equiv.Perm.measurable_apply 0 (measurableSet_singleton 1)

-- The trivial σ-algebra contains neither: the identity fixes `0`, the transposition of `0` and
-- `1` does not, and it sends `0` to `1`.
example : ¬ MeasurableSet[⊥] {σ : Equiv.Perm ℕ | σ 0 = 0} := by
  rw [MeasurableSpace.measurableSet_bot_iff]
  rintro (h | h)
  · exact (Set.eq_empty_iff_forall_notMem.1 h) 1 rfl
  · have : Equiv.swap 0 1 ∈ {σ : Equiv.Perm ℕ | σ 0 = 0} := h ▸ Set.mem_univ _
    simp at this

example : ¬ MeasurableSet[⊥] {σ : Equiv.Perm ℕ | σ 0 = 1} := by
  rw [MeasurableSpace.measurableSet_bot_iff]
  rintro (h | h)
  · exact (Set.eq_empty_iff_forall_notMem.1 h) (Equiv.swap 0 1) (by simp)
  · have : (1 : Equiv.Perm ℕ) ∈ {σ : Equiv.Perm ℕ | σ 0 = 1} := h ▸ Set.mem_univ _
    simp at this

-- On the discrete group `Equiv.Perm (Fin 3)` of order `6` all `2 ^ 6 = 64` sets are measurable.
example : Fintype.card (Set (Equiv.Perm (Fin 3))) = 64 := by
  simp [Fintype.card_set, Fintype.card_perm, Nat.factorial]

-- The permutation groups of `ℕ` and `Fin 3` are standard Borel, by Mathlib's
-- `standardBorel_of_polish`.
example : StandardBorelSpace (Equiv.Perm ℕ) := inferInstance

example : StandardBorelSpace (Equiv.Perm (Fin 3)) := inferInstance

example (s : Set (Equiv.Perm (Fin 3))) : MeasurableSet s :=
  .of_discrete

-- The σ-algebra generated by the evaluation at `0` has the atoms `{σ | σ 0 = j}`, and it does not
-- separate the identity from the transposition of `1` and `2`.
example (j : Fin 3) :
    MeasurableSet[MeasurableSpace.comap (fun σ : Equiv.Perm (Fin 3) => σ 0) ⊤]
      {σ | σ 0 = j} :=
  ⟨{j}, MeasurableSpace.measurableSet_top, rfl⟩

example (s : Set (Equiv.Perm (Fin 3)))
    (hs : MeasurableSet[MeasurableSpace.comap (fun σ : Equiv.Perm (Fin 3) => σ 0) ⊤] s) :
    (1 ∈ s ↔ Equiv.swap 1 2 ∈ s) := by
  obtain ⟨t, -, rfl⟩ := hs
  simp [Equiv.swap_apply_of_ne_of_ne]

-- `ℕ` with the evaluation action is a Borel `S∞`-space with a single orbit.
example : StandardBorelSpace ℕ := inferInstance

example : MeasurableSMul₂ (Equiv.Perm ℕ) ℕ := inferInstance

example : MulAction.IsPretransitive (Equiv.Perm ℕ) ℕ := inferInstance

-- A standard Borel space with the trivial action is a Borel `S∞`-space, and its orbit relation is
-- equality.
section Trivial

variable {X : Type*} [MeasurableSpace X] [StandardBorelSpace X]

example :
    letI : MulAction (Equiv.Perm ℕ) X := MulAction.compHom X (1 : Equiv.Perm ℕ →* Function.End X)
    MeasurableSMul₂ (Equiv.Perm ℕ) X := by
  let : MulAction (Equiv.Perm ℕ) X := MulAction.compHom X (1 : Equiv.Perm ℕ →* Function.End X)
  have h (g : Equiv.Perm ℕ) (x : X) : g • x = x := by simp [MulAction.compHom_smul_def]
  exact ⟨by simpa only [Function.uncurry_def, h] using measurable_snd⟩

example :
    letI : MulAction (Equiv.Perm ℕ) X := MulAction.compHom X (1 : Equiv.Perm ℕ →* Function.End X)
    MulAction.orbitRel (Equiv.Perm ℕ) X = ⊥ := by
  let : MulAction (Equiv.Perm ℕ) X := MulAction.compHom X (1 : Equiv.Perm ℕ →* Function.End X)
  have h (g : Equiv.Perm ℕ) (x : X) : g • x = x := by simp [MulAction.compHom_smul_def]
  ext x y
  simp [MulAction.orbitRel_apply, MulAction.mem_orbit_iff, h, eq_comm]

end Trivial

-- The logic action on configurations on `ℕ` in a countable relational vocabulary is a Borel
-- `S∞`-space, and its orbit relation is isomorphism.
section Logic

variable (L : FirstOrder.Language) [∀ n, Countable (L.Relations n)] [L.IsRelational]

example : StandardBorelSpace (RelationalConfiguration L ℕ) := inferInstance

example : MeasurableSMul₂ (Equiv.Perm ℕ) (RelationalConfiguration L ℕ) := inferInstance

example : RelationalConfiguration.isoSetoid L ℕ =
    MulAction.orbitRel (Equiv.Perm ℕ) (RelationalConfiguration L ℕ) :=
  RelationalConfiguration.isoSetoid_eq_orbitRel

-- An invariant Borel set of configurations is again a Borel `S∞`-space.
example (p : SubMulAction (Equiv.Perm ℕ) (RelationalConfiguration L ℕ))
    (hp : MeasurableSet (p : Set (RelationalConfiguration L ℕ))) :
    StandardBorelSpace p ∧ MeasurableSMul₂ (Equiv.Perm ℕ) p :=
  ⟨hp.standardBorel, inferInstance⟩

end Logic

-- An equivariant measurable injection between Borel `S∞`-spaces has an invariant Borel range, by
-- Lusin–Souslin, and is a Borel reduction of the orbit relations.
section Injection

variable {X Y : Type*} [MeasurableSpace X] [StandardBorelSpace X] [MulAction (Equiv.Perm ℕ) X]
  [MeasurableSpace Y] [StandardBorelSpace Y] [MulAction (Equiv.Perm ℕ) Y]

example (f : X →[Equiv.Perm ℕ] Y) (hmeas : Measurable f) (hinj : Function.Injective f) :
    MeasurableSet (f.range : Set Y) := by
  simpa using (hmeas.measurableEmbedding hinj).measurableSet_range

example (f : X →[Equiv.Perm ℕ] Y) (hmeas : Measurable f) (hinj : Function.Injective f) :
    (MulAction.orbitRel (Equiv.Perm ℕ) X).BorelReducible (MulAction.orbitRel (Equiv.Perm ℕ) Y) :=
  borelReducible_orbitRel hmeas hinj

end Injection
