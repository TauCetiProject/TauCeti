module

public import Mathlib.Algebra.Field.Rat
public import TauCeti.LinearAlgebra.Determinant.Projective.Basic
public import TauCeti.RingTheory.Idempotents.Primitive.Basic
public import TauCeti.RingTheory.Idempotents.Projective

/-!
# Checks: the determinant of an endomorphism of a projective module of non-constant rank

Over `A = ℚ × ℚ`, the ideal `M = A e` generated by the idempotent `e = (1, 0)` is projective of
rank `1` at one point of `Spec A` and `0` at the other, and it is not free. Multiplication by `2`
on `M` has projective determinant `(2, 1)`: with the free module `A`, the projection `x ↦ x e`
onto `M` and the inclusion of `M`, the completed endomorphism of `A` is multiplication by
`2 e + (1 - e) = (2, 1)`. Mathlib's `LinearMap.det`, which is `1` on modules without a finite
basis, gives `1` instead.
-/

public section

open TauCeti

namespace TauCeti.ProjectiveDetCheck

/-- The idempotent `e = (1, 0)` of `ℚ × ℚ`. -/
abbrev e : ℚ × ℚ := (1, 0)

/-- `e = (1, 0)` is idempotent. -/
theorem isIdempotentElem_e : IsIdempotentElem e := by
  simp [IsIdempotentElem, e]

/-- The projective module `M = A e` over `A = ℚ × ℚ`. -/
abbrev M : Type := (Ideal.span {e} : Ideal (ℚ × ℚ))

instance instProjectiveM : Module.Projective (ℚ × ℚ) M :=
  isIdempotentElem_e.projective_span_singleton

/-- `M = A e` is not free: `(0, 1)` kills every element of `M`. -/
theorem not_free : ¬ Module.Free (ℚ × ℚ) M := by
  intro hfree
  let b := Module.Free.chooseBasis (ℚ × ℚ) M
  have hne : Nonempty (Module.Free.ChooseBasisIndex (ℚ × ℚ) M) := by
    by_contra h
    rw [not_nonempty_iff] at h
    have h0 : spanSingletonGenerator e = 0 :=
      b.ext_elem fun i => (IsEmpty.false i).elim
    simpa [e] using congrArg Subtype.val h0
  obtain ⟨i⟩ := hne
  have hkill : ((0, 1) : ℚ × ℚ) • b i = 0 := by
    obtain ⟨r, hr⟩ := exists_smul_spanSingletonGenerator (b i)
    rw [← hr, smul_smul]
    ext <;> simp [e]
  have := congrArg (fun x => b.repr x i) hkill
  simp at this

/-- Multiplication by `2` on `M`. -/
noncomputable abbrev u : Module.End (ℚ × ℚ) M := (2 : ℚ × ℚ) • LinearMap.id

-- **The projective determinant of multiplication by `2` on `M` is `(2, 1)`**, computed through
-- the free module `A` with the projection `x ↦ x e` and the inclusion of `M`.
example : LinearMap.projectiveDet u = ((2, 1) : ℚ × ℚ) := by
  let π : (ℚ × ℚ) →ₗ[ℚ × ℚ] M := LinearMap.toSpanSingleton (ℚ × ℚ) M (spanSingletonGenerator e)
  let σ : M →ₗ[ℚ × ℚ] (ℚ × ℚ) := (Ideal.span {e}).subtype
  have h : π ∘ₗ σ = LinearMap.id :=
    LinearMap.ext (smul_spanSingletonGenerator isIdempotentElem_e)
  rw [LinearMap.projectiveDet_eq_det_of_comp_eq_id π σ h, LinearMap.det_ring]
  simp only [π, σ, e]
  ext <;> norm_num

-- **Mathlib's `LinearMap.det` of the same endomorphism is `1`**, since `M` is not free.
example : LinearMap.det u = 1 := by
  by_contra h
  exact not_free (LinearMap.free_of_det_ne_one h)

end TauCeti.ProjectiveDetCheck
