module

public import TauCeti.Examples.RingTheory.Idempotents.Projective
public import TauCeti.LinearAlgebra.Determinant.Projective.Basic

/-!
# Checks: the determinant of an endomorphism of a projective module of non-constant rank

Over `A = ℚ × ℚ`, the ideal `M = A e` generated by the idempotent `e = (1, 0)` is projective of
rank `1` at one point of `Spec A` and `0` at the other, and it is not free
(`TauCeti.ProjectiveIdealCheck`). Multiplication by `2` on `M` has projective determinant `(2, 1)`:
with the free module `A`, the projection `x ↦ x e` onto `M` and the inclusion of `M`, the
completed endomorphism of `A` is multiplication by `2 e + (1 - e) = (2, 1)`. Mathlib's
`LinearMap.det`, which is `1` on modules without a finite basis, gives `1` instead.
-/

public section

open TauCeti TauCeti.ProjectiveIdealCheck

namespace TauCeti.ProjectiveDetCheck

/-- Multiplication by `2` on `M`. -/
noncomputable abbrev u : Module.End (ℚ × ℚ) M := (2 : ℚ × ℚ) • LinearMap.id

-- **The projective determinant of multiplication by `2` on `M` is `(2, 1)`**, computed through
-- the free module `A` with the projection `x ↦ x e` and the inclusion of `M`.
example : LinearMap.projectiveDet u = ((2, 1) : ℚ × ℚ) := by
  rw [LinearMap.projectiveDet_eq_det_of_comp_eq_id _ _ toSpanSingleton_comp_subtype,
    LinearMap.det_ring]
  simp only [e]
  ext <;> norm_num

-- **Mathlib's `LinearMap.det` of the same endomorphism is `1`**, since `M` is not free.
example : LinearMap.det u = 1 := by
  by_contra h
  exact not_free (LinearMap.free_of_det_ne_one h)

end TauCeti.ProjectiveDetCheck
