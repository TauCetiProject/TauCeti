/-!
# Projective images and invariant lines of determinant kernels: examples

These examples separate the projective quotient `GL(2, K) → PGL(2, K)` and the invariant-line
predicate `MonoidHom.HasInvariantLine` from nearby notions.

* For the trivial representation on `K²` the projective image is trivial and the determinant
  kernel preserves a coordinate line. The zero subspace does not count as a line: its dimension is
  `0`.
* The cyclic group generated by `diag(2, 1)` over `ℚ`, included in `GL(2, ℚ)`, has nontrivial
  projective image and preserves the first coordinate line. Being commutative, this group is its
  own centre, so quotienting by the centre of the image rather than by the scalar matrices of the
  ambient `GL(2, ℚ)` would wrongly make the projective image trivial.
* Over any field of characteristic `7`, such as an algebraic closure of `𝔽₇`, the quaternion
  matrices `i = [[0, 1], [-1, 0]]` and `j = [[2, 3], [3, -2]]` satisfy `i ^ 2 = j ^ 2 = -1` and
  `i * j = -(j * i)`. They have determinant one, they fix no common line, so the determinant kernel
  of the group they generate fixes no line, and their classes and that of `i * j` are three
  distinct commuting involutions of `PGL(2, K)`, the nontrivial elements of a Klein four group.
-/

public section

open Matrix MonoidHom

open scoped MatrixGroups

namespace TauCeti.InvariantLineExamples

/-! ### The trivial representation -/

section Trivial

variable {G : Type*} [Group G] {K : Type*} [Field K]

/-- The trivial representation has trivial projective image. -/
example : (1 : G →* GL (Fin 2) K).projectiveImage = ⊥ :=
  projectiveImage_one

/-- The determinant kernel of the trivial representation preserves a line. -/
example :
    ((1 : G →* GL (Fin 2) K).comp
      (GeneralLinearGroup.det.comp (1 : G →* GL (Fin 2) K)).ker.subtype).HasInvariantLine :=
  hasInvariantLine_one.comp _

/-- The zero subspace has dimension `0`, so it is not a line. -/
example : Module.finrank K (⊥ : Submodule K (Fin 2 → K)) ≠ 1 := by
  simp

end Trivial

/-! ### The cyclic group generated by `diag(2, 1)` over `ℚ` -/

section Diagonal

/-- The diagonal matrix `diag(2, 1)` in `GL(2, ℚ)`. -/
def diagTwoOne : GL (Fin 2) ℚ :=
  diagGL ![Units.mk0 2 two_ne_zero, 1]

/-- The inclusion into `GL(2, ℚ)` of the cyclic group generated by `diag(2, 1)`. -/
def diagTwoOneRep : Subgroup.zpowers diagTwoOne →* GL (Fin 2) ℚ :=
  (Subgroup.zpowers diagTwoOne).subtype

/-- The powers of `diag(2, 1)` are the diagonal matrices `diag(2 ^ k, 1)`. -/
theorem diagTwoOne_zpow (k : ℤ) :
    diagTwoOne ^ k = diagGL (![Units.mk0 2 two_ne_zero, 1] ^ k) := by
  rw [diagTwoOne, map_zpow]

/-- The projective image of the cyclic group generated by `diag(2, 1)` is nontrivial: `diag(2, 1)`
is not scalar. -/
theorem projectiveImage_diagTwoOneRep_ne_bot : diagTwoOneRep.projectiveImage ≠ ⊥ := by
  rw [Ne, projectiveImage_eq_bot_iff]
  intro h
  obtain ⟨u, hu⟩ := h ⟨diagTwoOne, Subgroup.mem_zpowers _⟩
  simp only [diagTwoOneRep, Subgroup.subtype_apply] at hu
  have h₀ := congrArg (fun A : GL (Fin 2) ℚ ↦ (A : Matrix (Fin 2) (Fin 2) ℚ) 0 0) hu
  have h₁ := congrArg (fun A : GL (Fin 2) ℚ ↦ (A : Matrix (Fin 2) (Fin 2) ℚ) 1 1) hu
  simp only [GeneralLinearGroup.coe_scalar, scalar_apply, diagonal_apply_eq, diagTwoOne,
    diagGL_coe] at h₀ h₁
  norm_num [h₀] at h₁

/-- The cyclic group generated by `diag(2, 1)` preserves the first coordinate line. -/
theorem hasInvariantLine_diagTwoOneRep : diagTwoOneRep.HasInvariantLine := by
  refine hasInvariantLine_iff_exists_mulVec_eq_smul.2 ⟨Pi.single 0 1, by simp, ?_⟩
  rintro ⟨g, hg⟩
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hg
  refine ⟨((![Units.mk0 2 two_ne_zero, 1] ^ k : Fin 2 → ℚˣ) 0 : ℚ), ?_⟩
  simp only [diagTwoOneRep, Subgroup.subtype_apply, diagTwoOne_zpow, diagGL_coe,
    diagonal_mulVec_single, ← Pi.single_smul, smul_eq_mul, mul_one]

/-- The cyclic group generated by `diag(2, 1)` is its own centre. -/
example : Subgroup.center (Subgroup.zpowers diagTwoOne) = ⊤ :=
  Subgroup.center_eq_top

end Diagonal

/-! ### Quaternion matrices in characteristic `7` -/

section Quaternion

variable (K : Type*) [Field K]

/-- The quaternion matrix `i = [[0, 1], [-1, 0]]`, with inverse `-i`. -/
def quatI : GL (Fin 2) K :=
  ⟨!![0, 1; -1, 0], !![0, -1; 1, 0], by simp [one_fin_two], by simp [one_fin_two]⟩

variable {K} in
/-- The quaternion matrix `i` squares to `-1`. -/
theorem quatI_sq : (quatI K : Matrix (Fin 2) (Fin 2) K) ^ 2 = -1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [quatI, sq, Matrix.mul_apply, Fin.sum_univ_two]

variable {K} in
/-- The quaternion matrix `i` has determinant one. -/
theorem det_quatI : GeneralLinearGroup.det (quatI K) = 1 := by
  ext
  simp [quatI, det_fin_two_of]

variable {K} in
/-- The quaternion matrix `i` is traceless. -/
theorem trace_quatI : (quatI K : Matrix (Fin 2) (Fin 2) K).trace = 0 := by
  simp [quatI, trace_fin_two_of]

variable [CharP K 7]

private theorem seven_eq_zero : (7 : K) = 0 :=
  CharP.ofNat_eq_zero (R := K) (p := 7)

private theorem two_ne_zero_of_charP_seven : (2 : K) ≠ 0 := by
  simpa using (NeZero.of_not_dvd K (p := 7) (n := 2) (by norm_num)).out

/-- In characteristic `7`, `j = [[2, 3], [3, -2]]` squares to `-1`, since
`2 ^ 2 + 3 ^ 2 = 13 = -1`. -/
theorem quatJ_mat_mul_self : !![(2 : K), 3; 3, -2] * !![2, 3; 3, -2] = -1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [one_fin_two, mul_comm] <;>
    linear_combination 2 * seven_eq_zero K

/-- The quaternion matrix `j = [[2, 3], [3, -2]]` in characteristic `7`, with inverse `-j`. -/
def quatJ : GL (Fin 2) K :=
  ⟨!![2, 3; 3, -2], -!![2, 3; 3, -2], by rw [mul_neg, quatJ_mat_mul_self, neg_neg],
    by rw [neg_mul, quatJ_mat_mul_self, neg_neg]⟩

variable {K}

/-- The quaternion matrix `j` squares to `-1`. -/
theorem quatJ_sq : (quatJ K : Matrix (Fin 2) (Fin 2) K) ^ 2 = -1 :=
  (sq _).trans (quatJ_mat_mul_self K)

/-- The quaternion matrices `i` and `j` anticommute. -/
theorem quatI_mul_quatJ :
    (quatI K : Matrix (Fin 2) (Fin 2) K) * quatJ K =
      -((quatJ K : Matrix (Fin 2) (Fin 2) K) * quatI K) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [quatI, quatJ, Matrix.mul_apply, Fin.sum_univ_two]

/-- The quaternion matrix `j` has determinant one. -/
theorem det_quatJ : GeneralLinearGroup.det (quatJ K) = 1 := by
  ext
  simp only [GeneralLinearGroup.val_det_apply, quatJ, det_fin_two_of, Units.val_one]
  linear_combination (-2 : K) * seven_eq_zero K

/-- The inclusion into `GL(2, K)` of the group generated by the quaternion matrices `i` and `j`. -/
def quatRep : Subgroup.closure {quatI K, quatJ K} →* GL (Fin 2) K :=
  (Subgroup.closure {quatI K, quatJ K}).subtype

/-- `i` and `j` have no common eigenline, even over an algebraically closed field of
characteristic `7`. -/
theorem not_hasInvariantLine_quatRep : ¬ (quatRep (K := K)).HasInvariantLine :=
  not_hasInvariantLine_of_mul_eq_neg_mul (two_ne_zero_of_charP_seven K)
    (g := ⟨quatI K, Subgroup.subset_closure (by simp)⟩)
    (h := ⟨quatJ K, Subgroup.subset_closure (by simp)⟩) quatI_mul_quatJ

/-- The determinant kernel of the quaternion representation fixes no line: `i` and `j` have
determinant one and anticommute. -/
theorem not_hasInvariantLine_quatRep_comp_ker_det :
    ¬ ((quatRep (K := K)).comp
      (GeneralLinearGroup.det.comp (quatRep (K := K))).ker.subtype).HasInvariantLine :=
  not_hasInvariantLine_of_mul_eq_neg_mul (two_ne_zero_of_charP_seven K)
    (g := ⟨⟨quatI K, Subgroup.subset_closure (by simp)⟩, det_quatI⟩)
    (h := ⟨⟨quatJ K, Subgroup.subset_closure (by simp)⟩, det_quatJ⟩) quatI_mul_quatJ

/-- The quaternion matrix `j` is traceless. -/
theorem trace_quatJ : (quatJ K : Matrix (Fin 2) (Fin 2) K).trace = 0 := by
  simp [quatJ, trace_fin_two_of]

/-- The product `i * j` is traceless. -/
theorem trace_quatI_mul_quatJ :
    ((quatI K * quatJ K : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K).trace = 0 := by
  simp [quatI, quatJ, trace_fin_two_of]

/-- The classes of `i`, `j` and `i * j` in `PGL(2, K)` are involutions, the classes of `i` and `j`
are distinct, and they commute: these three classes are the nontrivial elements of a Klein four
group. -/
theorem quaternion_classes_kleinFour :
    orderOf (ProjGenLinGroup.mk (quatI K)) = 2 ∧ orderOf (ProjGenLinGroup.mk (quatJ K)) = 2 ∧
      orderOf (ProjGenLinGroup.mk (quatI K * quatJ K)) = 2 ∧
      ProjGenLinGroup.mk (quatI K) ≠ ProjGenLinGroup.mk (quatJ K) ∧
      Commute (ProjGenLinGroup.mk (quatI K)) (ProjGenLinGroup.mk (quatJ K)) := by
  have h2 := two_ne_zero_of_charP_seven K
  have hI := (ProjGenLinGroup.orderOf_mk_eq_two_iff_trace_eq_zero h2).2 trace_quatI
  have hJ := (ProjGenLinGroup.orderOf_mk_eq_two_iff_trace_eq_zero h2).2 trace_quatJ
  have hIJ := (ProjGenLinGroup.orderOf_mk_eq_two_iff_trace_eq_zero h2).2 trace_quatI_mul_quatJ
  have hIJ' := orderOf_eq_prime_iff.1 hIJ
  rw [map_mul] at hIJ'
  refine ⟨hI, hJ, hIJ, fun h ↦ ?_, ?_⟩
  · -- Equal classes `x = y` would give `x * y = y ^ 2 = 1`.
    exact hIJ'.2 (by rw [h, ← sq, (orderOf_eq_prime_iff.1 hJ).1])
  · -- `(x * y) ^ 2 = 1` gives `x * y = (x * y)⁻¹ = y⁻¹ * x⁻¹ = y * x`.
    have hinv {z : PGL(2, K)} (hz : orderOf z = 2) : z⁻¹ = z :=
      inv_eq_of_mul_eq_one_right (by rw [← sq, (orderOf_eq_prime_iff.1 hz).1])
    have h := inv_eq_of_mul_eq_one_right ((sq _).symm.trans hIJ'.1)
    rw [_root_.mul_inv_rev, hinv hI, hinv hJ] at h
    exact h.symm

end Quaternion

end TauCeti.InvariantLineExamples
