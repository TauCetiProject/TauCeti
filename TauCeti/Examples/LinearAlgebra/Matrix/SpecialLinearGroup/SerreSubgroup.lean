module

public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.SerreSubgroup
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Transvection.FinTwo

/-!
# Serre's relative elementary subgroup at level `2` over `ℤ`

Serre's relative elementary subgroup `Eˢ(ℤ, 2ℤ)` is the normal closure in `SL₂(ℤ)` of the upper
transvections with even parameter. It contains

```text
[[3, -2], [2, -1]] = e₀₁(1) e₁₀(2) e₀₁(-1),
```

a conjugate of the lower transvection `e₁₀(2)`. This matrix is not a product of the bare level-`2`
transvections `e₀₁(2a)` and `e₁₀(2b)`: every such product has diagonal entries congruent to `1`
modulo `4` and even off-diagonal entries, while the upper-left entry `3` is not. So the normal
closure is strictly larger than the subgroup generated by the level-`2` transvections.
-/

public section

open Matrix (SpecialLinearGroup)
open Matrix.SpecialLinearGroup

namespace TauCeti.SerreElementarySubgroupExamples

/-- The matrices of `SL₂(ℤ)` with diagonal entries congruent to `1` modulo `4` and even
off-diagonal entries form a subgroup. -/
private def diagOneModFour : Subgroup (SpecialLinearGroup (Fin 2) ℤ) where
  carrier := {g | (g : Matrix (Fin 2) (Fin 2) ℤ) 0 0 ≡ 1 [ZMOD 4] ∧
    (g : Matrix (Fin 2) (Fin 2) ℤ) 1 1 ≡ 1 [ZMOD 4] ∧
    2 ∣ (g : Matrix (Fin 2) (Fin 2) ℤ) 0 1 ∧ 2 ∣ (g : Matrix (Fin 2) (Fin 2) ℤ) 1 0}
  one_mem' := by simp [Int.ModEq.refl]
  mul_mem' := by
    rintro g h ⟨hg₀, hg₁, hg₂, hg₃⟩ ⟨hh₀, hh₁, hh₂, hh₃⟩
    -- a product of two even entries is divisible by `4`
    have hfour {x y : ℤ} (hx : 2 ∣ x) (hy : 2 ∣ y) : x * y ≡ 0 [ZMOD 4] :=
      Int.modEq_zero_iff_dvd.2 (by simpa using mul_dvd_mul hx hy)
    simp only [Set.mem_ofPred_eq, coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
    refine ⟨?_, ?_, ?_, ?_⟩
    · simpa using (hg₀.mul hh₀).add (hfour hg₂ hh₃)
    · simpa using (hfour hg₃ hh₂).add (hg₁.mul hh₁)
    · exact dvd_add (dvd_mul_of_dvd_right hh₂ _) (dvd_mul_of_dvd_left hg₂ _)
    · exact dvd_add (dvd_mul_of_dvd_left hg₃ _) (dvd_mul_of_dvd_right hh₃ _)
  inv_mem' := by
    rintro g ⟨hg₀, hg₁, hg₂, hg₃⟩
    simp only [Set.mem_ofPred_eq, coe_inv]
    simpa [Matrix.adjugate_fin_two] using ⟨hg₁, hg₀, hg₂, hg₃⟩

/-- The matrix `[[3, -2], [2, -1]]` is the conjugate `e₀₁(1) e₁₀(2) e₀₁(-1)` of the lower
transvection `e₁₀(2)`. -/
theorem coe_conj_transvection :
    ((transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (1 : ℤ) *
        transvection (one_ne_zero : (1 : Fin 2) ≠ 0) 2 *
          transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (-1) :
        SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) = !![3, -2; 2, -1] := by
  simp only [coe_mul, coe_transvection_zero_one, coe_transvection_one_zero]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

/-- The conjugate `e₀₁(1) e₁₀(2) e₀₁(-1) = [[3, -2], [2, -1]]` lies in Serre's relative
elementary subgroup at level `2`. -/
theorem conj_transvection_mem_serreElementarySubgroup :
    transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (1 : ℤ) *
        transvection (one_ne_zero : (1 : Fin 2) ≠ 0) 2 *
          transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (-1) ∈
      (Ideal.span {(2 : ℤ)}).serreElementarySubgroup := by
  rw [← transvection_inv]
  exact (Ideal.normal_serreElementarySubgroup _).conj_mem _
    (Ideal.transvection_one_zero_mem_serreElementarySubgroup (Ideal.mem_span_singleton_self 2)) _

/-- The same conjugate is not a product of the bare level-`2` transvections: its upper-left entry
`3` is not congruent to `1` modulo `4`. -/
theorem conj_transvection_notMem_closure :
    transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (1 : ℤ) *
        transvection (one_ne_zero : (1 : Fin 2) ≠ 0) 2 *
          transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (-1) ∉
      Subgroup.closure
        (transvection (zero_ne_one : (0 : Fin 2) ≠ 1) '' (Ideal.span {(2 : ℤ)} : Set ℤ) ∪
          transvection (one_ne_zero : (1 : Fin 2) ≠ 0) '' (Ideal.span {(2 : ℤ)} : Set ℤ)) := by
  have hle : Subgroup.closure
      (transvection (zero_ne_one : (0 : Fin 2) ≠ 1) '' (Ideal.span {(2 : ℤ)} : Set ℤ) ∪
        transvection (one_ne_zero : (1 : Fin 2) ≠ 0) '' (Ideal.span {(2 : ℤ)} : Set ℤ)) ≤
      diagOneModFour := by
    rw [Subgroup.closure_le]
    rintro _ (⟨t, ht, rfl⟩ | ⟨t, ht, rfl⟩) <;>
      simp [diagOneModFour, Int.ModEq.refl, Ideal.mem_span_singleton.1 ht]
  intro hmem
  have h00 := (hle hmem).1
  rw [coe_conj_transvection] at h00
  exact absurd h00 (by decide)

/-- At the zero level, Serre's relative elementary subgroup is trivial. -/
example : (⊥ : Ideal ℤ).serreElementarySubgroup = ⊥ :=
  Ideal.serreElementarySubgroup_bot

end TauCeti.SerreElementarySubgroupExamples
