module

public import Mathlib.Algebra.Ring.Rat
public import TauCeti.LinearAlgebra.Trace.Projective

/-!
# The trace of a projective module that is not free

Over `R = ℚ × ℚ`, the ideal `M = R ∙ (1, 0)` generated by the idempotent `e = (1, 0)` is a direct
summand of `R`, hence finite projective, but it is not free: `(0, 1)` is a nonzero scalar killing
`M`. The identity of `M` has projective trace `e`, the locally constant rank of `M`, which is `1`
on the first factor of `Spec R` and `0` on the second. Mathlib's `LinearMap.trace` vanishes on `M`,
because `M` has no finite basis, so it is not the trace of a finite projective module.

On the free module `R²`, by contrast, the projective trace of a matrix is the sum of its diagonal
entries.
-/

public section

open Module

namespace LinearMap

/-- Multiplication by `(1, 0)` splits the inclusion of the ideal it generates in `ℚ × ℚ`. -/
private theorem toSpanSingleton_comp_subtype_span_one_zero :
    toSpanSingleton _ _ ⟨((1 : ℚ), (0 : ℚ)), Ideal.subset_span rfl⟩ ∘ₗ
      (Ideal.span {((1 : ℚ), (0 : ℚ))}).subtype = LinearMap.id := by
  ext ⟨m, hm⟩ <;>
  · obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hm
    simp

/-- The ideal generated by the idempotent `(1, 0)` of `ℚ × ℚ` is a direct summand of `ℚ × ℚ`,
hence projective. -/
instance : Module.Projective (ℚ × ℚ) (Ideal.span {((1 : ℚ), (0 : ℚ))}) :=
  .of_split _ _ toSpanSingleton_comp_subtype_span_one_zero

/-- On the projective, nonfree ideal `ℚ × 0` of `ℚ × ℚ`, the identity has projective trace
`(1, 0)`, while Mathlib's `LinearMap.trace` is `0`. -/
theorem projectiveTrace_nonfree :
    projectiveTrace (ℚ × ℚ) (Ideal.span {((1 : ℚ), (0 : ℚ))}) LinearMap.id = (1, 0) ∧
      LinearMap.trace (ℚ × ℚ) (Ideal.span {((1 : ℚ), (0 : ℚ))}) LinearMap.id = 0 := by
  set I := Ideal.span {((1 : ℚ), (0 : ℚ))}
  have he : ((1 : ℚ), (0 : ℚ)) ∈ I := Ideal.subset_span rfl
  constructor
  · -- `id_I = s ∘ i` for the inclusion `i : I → ℚ × ℚ` and `s = (· • e)`, so its trace is that
    -- of `i ∘ s` on `ℚ × ℚ`, which is `(i ∘ s) 1 = e`.
    rw [← toSpanSingleton_comp_subtype_span_one_zero, projectiveTrace_cyclic,
      projectiveTrace_self_apply]
    simp
  · -- `I` is not free: `(0, 1)` kills `I` but a nonzero free module is faithful.
    have hnf : ¬ Module.Free (ℚ × ℚ) I := by
      intro _
      have : Nontrivial I := ⟨⟨⟨_, he⟩, 0, by simp [Subtype.ext_iff]⟩⟩
      have h := eq_of_smul_eq_smul (α := I) (m₁ := ((0 : ℚ), (1 : ℚ))) (m₂ := 0) fun m ↦ by
        obtain ⟨m, hm⟩ := m
        obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hm
        ext <;> simp
      simp [Prod.ext_iff] at h
    -- Mathlib's trace is defined to be `0` on modules without a finite basis, and it has no
    -- lemma for that branch, so we unfold it.
    classical
    rw [LinearMap.trace, dite_eq_right fun ⟨s, ⟨b⟩⟩ ↦ hnf (.of_basis b), LinearMap.zero_apply]

/-- On `R²`, the trace of the endomorphism with matrix `!![a, b; c, d]` is `a + d`. -/
example {R : Type*} [CommRing R] (a b c d : R) :
    projectiveTrace R (Fin 2 → R) (Matrix.toLin' !![a, b; c, d]) = a + d := by
  rw [projectiveTrace_eq_trace, Matrix.trace_toLin'_eq, Matrix.trace_fin_two_of]

end LinearMap
