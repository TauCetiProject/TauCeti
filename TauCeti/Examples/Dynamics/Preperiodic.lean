module

public import Mathlib.Algebra.Order.Ring.Int
public import Mathlib.Tactic.Linarith
public import TauCeti.Dynamics.PeriodicPts.Preperiodic

/-!
# Checks for forward orbits and preperiodic points

* Under `n ↦ n + 1` on `ℕ`, the forward orbit of `0` is all of `ℕ`
  (`TauCeti.Examples.Preperiodic.forwardOrbit_nat_add_one_zero`).
* Under `n ↦ n + 1` on `ℤ`, `1` is not in the forward orbit of `2`
  (`TauCeti.Examples.Preperiodic.one_notMem_forwardOrbit_int_add_one_two`): the forward orbit is not
  the orbit of the `ℤ`-action generated by the map.
* Under `z ↦ z² - 1` on `ℤ` (Silverman, *Lecture notes on arithmetic dynamics*, Example 2):
  - the forward orbit of `1` is `{1, 0, -1}` (`TauCeti.Examples.Preperiodic.forwardOrbit_one`);
  - `1` is preperiodic but not periodic (`TauCeti.Examples.Preperiodic.isPreperiodicPt_one` and
    `TauCeti.Examples.Preperiodic.one_notMem_periodicPts`);
  - `2` is wandering, since its iterates increase strictly
    (`TauCeti.Examples.Preperiodic.not_isPreperiodicPt_two`).
-/

open Set Function

public section

namespace TauCeti.Examples.Preperiodic

/-- Under `n ↦ n + 1` on `ℕ`, the forward orbit of `0` is all of `ℕ`. -/
theorem forwardOrbit_nat_add_one_zero : forwardOrbit (· + 1 : ℕ → ℕ) 0 = univ :=
  eq_univ_of_forall fun n ↦ mem_forwardOrbit.2 ⟨n, by simp⟩

/-- Under `n ↦ n + 1` on `ℤ`, `1` is not in the forward orbit of `2`. -/
theorem one_notMem_forwardOrbit_int_add_one_two : (1 : ℤ) ∉ forwardOrbit (· + 1 : ℤ → ℤ) 2 := by
  rintro hmem
  obtain ⟨n, hn⟩ := mem_forwardOrbit.1 hmem
  simp only [add_right_iterate_apply, nsmul_eq_mul, mul_one] at hn
  omega

/-- The quadratic map `z ↦ z² - 1` on `ℤ`. -/
def sqSubOne (z : ℤ) : ℤ := z ^ 2 - 1

theorem sqSubOne_apply (z : ℤ) : sqSubOne z = z ^ 2 - 1 := (rfl)

theorem mapsTo_sqSubOne : MapsTo sqSubOne {0, -1} {0, -1} := by
  rintro z (rfl | rfl) <;> simp [sqSubOne_apply]

/-- Under `z ↦ z² - 1` on `ℤ`, the forward orbit of `1` is `{1, 0, -1}`. -/
theorem forwardOrbit_one : forwardOrbit sqSubOne 1 = {1, 0, -1} := by
  refine (MapsTo.forwardOrbit_subset_iff ?_).2 (mem_insert _ _) |>.antisymm ?_
  · rintro z (rfl | rfl | rfl) <;> simp [sqSubOne_apply]
  · refine insert_subset (self_mem_forwardOrbit _ _) (insert_subset ?_ ?_)
    · exact mem_forwardOrbit.2 ⟨1, by simp [sqSubOne_apply]⟩
    · exact singleton_subset_iff.2 (mem_forwardOrbit.2 ⟨2, by simp [sqSubOne_apply]⟩)

/-- Under `z ↦ z² - 1` on `ℤ`, the point `1` is preperiodic. -/
theorem isPreperiodicPt_one : IsPreperiodicPt sqSubOne 1 :=
  isPreperiodicPt_of_iterate_add_eq (m := 1) (n := 2) two_pos (by simp [sqSubOne_apply])

/-- Under `z ↦ z² - 1` on `ℤ`, the point `1` is not periodic: every later iterate is `0` or
`-1`. -/
theorem one_notMem_periodicPts : (1 : ℤ) ∉ periodicPts sqSubOne := by
  intro h
  obtain ⟨n, hn, hper⟩ := mem_periodicPts.1 h
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn.ne'
  have hmem := mapsTo_sqSubOne.iterate k (show sqSubOne 1 ∈ ({0, -1} : Set ℤ) by
    simp [sqSubOne_apply])
  rw [← iterate_succ_apply, hper.eq] at hmem
  simp at hmem

theorem two_le_iterate_sqSubOne_two (n : ℕ) : 2 ≤ sqSubOne^[n] 2 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [iterate_succ_apply', sqSubOne_apply]
    nlinarith

/-- Under `z ↦ z² - 1` on `ℤ`, the point `2` is not preperiodic: its iterates increase
strictly. -/
theorem not_isPreperiodicPt_two : ¬IsPreperiodicPt sqSubOne 2 := by
  refine isPreperiodicPt_iff_not_injective.not_left.2 (StrictMono.injective ?_)
  refine strictMono_nat_of_lt_succ fun n ↦ ?_
  have := two_le_iterate_sqSubOne_two n
  rw [iterate_succ_apply', sqSubOne_apply]
  nlinarith

end TauCeti.Examples.Preperiodic
