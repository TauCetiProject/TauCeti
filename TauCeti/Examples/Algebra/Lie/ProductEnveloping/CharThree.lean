module

public import TauCeti.Algebra.Lie.Abelian
public import TauCeti.Algebra.Lie.Sl2.Associative
public import TauCeti.Algebra.Lie.Sl2.Center
public import TauCeti.Algebra.Lie.Sl2.Embedding
public import TauCeti.Algebra.Lie.UniversalEnveloping.Product.Center
public import TauCeti.Algebra.Polynomial.Derivative

/-!
# The product-centre Check in characteristic three

Over a field `K` of characteristic three, the cube `e³` of the raising element of `sl₂` is central
in `U(sl₂)`: `[h, e³] = 6e³ = 0` and `[f, e³] = -(3e²h + 6e²) = 0`. It is not a polynomial in
`Ω = h² + 2h + 4fe`: in the representation of `sl₂` on `K[x]` by `e = x`, `h = 2x d/dx` and
`f = -x d²/dx²`, the element `Ω` acts by `0` while `e³` acts by multiplication by `x³`. So in
`U(K × sl₂)` the central element `1 ⊗ e³` does not lie in the subalgebra generated by `t ⊗ 1` and
`1 ⊗ Ω`, which in characteristic zero is the whole centre
(`TauCeti.Examples.ProductEnveloping.exists_algEquiv_center_prod_slTwo`). Thus the
characteristic-zero description of the centre of `U(K × sl₂)` fails in characteristic three.
-/

public section

open scoped TensorProduct Polynomial
open TauCeti TauCeti.UniversalEnvelopingAlgebra Polynomial

namespace TauCeti.Examples.ProductEnvelopingCharThree

attribute [local instance 100] LieRing.ofAssociativeRing

variable (K : Type) [Field K]

local notation "ZK" => AbelianLieAlgebra K
local notation "sl₂" => LieAlgebra.SpecialLinear.sl (Fin 2) K
local notation "U" => _root_.UniversalEnvelopingAlgebra
local notation "ιU" => _root_.UniversalEnvelopingAlgebra.ι K

-- The coordinate `t` on the abelian Lie algebra `K`.
local notation "t" => (LinearEquiv.symm (AbelianLieAlgebra.equiv K K) 1 : ZK)

/-! ### `e³` is central in characteristic three -/

local notation "E" => ιU (slFinTwoBasis K 0)
local notation "F" => ιU (slFinTwoBasis K 1)
local notation "H" => ιU (slFinTwoBasis K 2)

/-- **`e³` is central in `U(sl₂)` in characteristic three.** -/
theorem pow_three_ι_mem_center [CharP K 3] : E ^ 3 ∈ Subalgebra.center K (U K sl₂) := by
  have h3 : (3 : U K sl₂) = 0 := by
    have h : (3 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 3
    rw [← map_ofNat (algebraMap K (U K sl₂)) 3, h, map_zero]
  have hef : E * F - F * E = H := Sl2.ι_e_mul_ι_f_sub_mul K (lie_slFinTwoBasis_zero_one K)
  have hhe : H * E - E * H = 2 • E :=
    Sl2.ι_h_mul_ι_e_sub_mul K (by rw [lie_slFinTwoBasis_two_zero, ofNat_smul_eq_nsmul])
  have hF : F * E ^ 3 = E ^ 3 * F := by
    rw [Sl2.f_mul_e_pow_succ hef hhe 2]
    simp [nsmul_eq_mul, h3]
  have hH : H * E ^ 3 = E ^ 3 * H := by
    rw [Sl2.h_mul_e_pow hhe 3, Nat.cast_ofNat, h3, mul_zero, add_zero]
  rw [mem_center_iff_forall_lie_ι]
  intro x
  rw [← (slFinTwoBasis K).sum_repr x, map_sum, lie_sum, Fin.sum_univ_three]
  simp only [map_smul, lie_smul]
  simp only [LieRing.of_associative_ring_bracket, ← pow_succ, ← pow_succ', hF, hH, sub_self,
    smul_zero, add_zero]

/-! ### `e³` is not a polynomial in `Ω` -/

/-- The representation of `U(sl₂)` on `K[x]` with `e = x`, `h = 2x d/dx`, `f = -x d²/dx²`. -/
noncomputable def weylRep [NeZero (2 : K)] : U K sl₂ →ₐ[K] Module.End K K[X] :=
  _root_.UniversalEnvelopingAlgebra.lift K
    ((Sl2.isSl2Triple_of_weyl
      (by simpa only [map_ofNat] using ((isUnit_iff_ne_zero.mpr (two_ne_zero : (2 : K) ≠ 0)).map
        (algebraMap K (Module.End K K[X]))).isRegular.left)
      (derivative_mul_mulLeft_X (R := K))).toLieHom K)

/-- The values of `weylRep` on the standard basis `e, f, h`. -/
theorem weylRep_ι [NeZero (2 : K)] (i : Fin 3) :
    weylRep K (ιU (slFinTwoBasis K i)) =
      ![(LinearMap.mulLeft K X : Module.End K K[X]),
        -(LinearMap.mulLeft K X * derivative * derivative),
        2 * (LinearMap.mulLeft K X * derivative)] i := by
  rw [weylRep, _root_.UniversalEnvelopingAlgebra.lift_ι_apply, IsSl2Triple.toLieHom_slFinTwoBasis]

/-- `weylRep` sends `e` to multiplication by `x`. -/
theorem weylRep_ι_zero [NeZero (2 : K)] :
    weylRep K (ιU (slFinTwoBasis K 0)) = LinearMap.mulLeft K X :=
  weylRep_ι K 0

/-- `weylRep` sends `f` to `-x d²/dx²`. -/
theorem weylRep_ι_one [NeZero (2 : K)] :
    weylRep K (ιU (slFinTwoBasis K 1)) = -(LinearMap.mulLeft K X * derivative * derivative) :=
  weylRep_ι K 1

/-- `weylRep` sends `h` to `2x d/dx`. -/
theorem weylRep_ι_two [NeZero (2 : K)] :
    weylRep K (ιU (slFinTwoBasis K 2)) = 2 * (LinearMap.mulLeft K X * derivative) :=
  weylRep_ι K 2

/-- `Ω` acts by zero on `K[x]`. -/
theorem weylRep_slTwoOmega [NeZero (2 : K)] : weylRep K (slTwoOmega K) = 0 := by
  rw [slTwoOmega_def]
  simp only [map_add, map_mul, weylRep_ι_zero, weylRep_ι_one, weylRep_ι_two,
    Algebra.smul_def, map_ofNat]
  exact Sl2.weyl_sq_add_two_mul_add_four_mul_eq_zero derivative_mul_mulLeft_X

/-- `e³` acts on `K[x]` by multiplication by `x³`, which is not a scalar. -/
theorem weylRep_pow_three_notMem_bot [NeZero (2 : K)] :
    weylRep K (E ^ 3) ∉ (⊥ : Subalgebra K (Module.End K K[X])) := by
  intro hmem
  obtain ⟨c, hc⟩ := Algebra.mem_bot.mp hmem
  have h1 := congrArg (fun φ : Module.End K K[X] ↦ φ 1) hc
  rw [map_pow, weylRep_ι_zero] at h1
  simp only [Module.algebraMap_end_apply] at h1
  have hX : (LinearMap.mulLeft K X ^ 3) (1 : K[X]) = X ^ 3 := by
    simp [pow_succ, mul_apply_eq_comp, mul_assoc]
  rw [hX, Algebra.smul_def, mul_one, Polynomial.algebraMap_eq, eq_comm] at h1
  have := congrArg natDegree h1
  simp at this

section CharThree

variable [CharP K 3]

local instance : NeZero (2 : K) := NeZero.of_not_dvd K (by decide : ¬3 ∣ 2)

/-- In characteristic three, `e³` is not in the subalgebra generated by `Ω`. -/
theorem pow_three_ι_notMem_adjoin_slTwoOmega : E ^ 3 ∉ Algebra.adjoin K {slTwoOmega K} := by
  intro hmem
  have hle : Algebra.adjoin K {slTwoOmega K} ≤ (⊥ : Subalgebra K (Module.End K K[X])).comap
      (weylRep K) := by
    rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    simp [weylRep_slTwoOmega]
  exact weylRep_pow_three_notMem_bot K (hle hmem)

/-! ### The centre of `U(K × sl₂)` in characteristic three -/

/-- **In characteristic three, `1 ⊗ e³` is central in `U(K × sl₂)`.** -/
theorem map_inr_pow_three_ι_mem_center :
    map K (LieHom.inr K ZK sl₂) (E ^ 3) ∈ Subalgebra.center K (U K (ZK × sl₂)) := by
  have h := ((productCenterEquiv K ZK sl₂).symm
    (1 ⊗ₜ[K] ⟨E ^ 3, pow_three_ι_mem_center K⟩)).property
  simpa [productCenterEquiv_symm_tmul] using h

/-- **In characteristic three, `1 ⊗ e³` is not in `K[t] ⊗ K[Ω]`**: it does not lie in the
subalgebra of `U(K × sl₂)` generated by `t` and `1 ⊗ Ω`, which in characteristic zero is the
whole centre. -/
theorem map_inr_pow_three_ι_notMem_adjoin :
    map K (LieHom.inr K ZK sl₂) (E ^ 3) ∉ Algebra.adjoin K
      {ιU ((t, 0) : ZK × sl₂), map K (LieHom.inr K ZK sl₂) (slTwoOmega K)} := by
  let φ := (weylRep K).comp (map K (LieHom.snd K ZK sl₂))
  have hφ (x : U K sl₂) : φ (map K (LieHom.inr K ZK sl₂) x) = weylRep K x := by
    have : (map K (LieHom.snd K ZK sl₂)).comp (map K (LieHom.inr K ZK sl₂)) = AlgHom.id K _ := by
      rw [← map_comp, LieHom.snd_comp_inr, map_id]
    simp only [φ, AlgHom.comp_apply]
    rw [← AlgHom.comp_apply (map K _), this, AlgHom.id_apply]
  intro hmem
  have hle : Algebra.adjoin K
      {ιU ((t, 0) : ZK × sl₂), map K (LieHom.inr K ZK sl₂) (slTwoOmega K)} ≤
      (⊥ : Subalgebra K (Module.End K K[X])).comap φ := by
    rw [Algebra.adjoin_le_iff]
    rintro _ (rfl | rfl)
    · simp [φ]
    · simp [hφ, weylRep_slTwoOmega]
  have := hle hmem
  rw [Subalgebra.mem_comap, hφ] at this
  exact weylRep_pow_three_notMem_bot K this

end CharThree

end TauCeti.Examples.ProductEnvelopingCharThree
