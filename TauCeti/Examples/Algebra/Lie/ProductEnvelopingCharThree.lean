module

public import TauCeti.Algebra.Lie.Abelian
public import TauCeti.Algebra.Lie.Sl2.Center
public import TauCeti.Algebra.Lie.Sl2.Embedding
public import TauCeti.Algebra.Lie.UniversalEnveloping.Product.Center
public import TauCeti.Algebra.Lie.UniversalEnveloping.PBW.Domain
public import Mathlib.Algebra.Polynomial.Derivative

/-!
# The product-centre Check in characteristic three

Over a field `K` of characteristic three, the cube `e³` of the raising element of `sl₂` is central
in `U(sl₂)`: `[h, e³] = 6e³ = 0` and `[f, e³] = -(3e²h + 6e²) = 0`. It is not a polynomial in
`Ω = h² + 2h + 4fe`: in the representation of `sl₂` on `K[x]` by `e = x`, `h = 2x d/dx` and
`f = -x d²/dx²`, the element `Ω` acts by `0` while `e³` acts by multiplication by `x³`. So in
`U(K × sl₂)` the central element `1 ⊗ e³` does not lie in the subalgebra generated by `t ⊗ 1` and
`1 ⊗ Ω`, which in characteristic zero is the whole centre
(`TauCeti.Examples.ProductEnveloping.exists_algEquiv_center_prod_slTwo`).

This is the characteristic-three Check of LieHighestWeight §9.3.
-/

public section

open scoped TensorProduct Polynomial
open TauCeti TauCeti.UniversalEnvelopingAlgebra Polynomial

namespace TauCeti.Examples.ProductEnvelopingCharThree

attribute [local instance 100] LieRing.ofAssociativeRing

variable (K : Type) [Field K]

local notation "ZK" => AbelianLieAlgebra K
local notation "sl₂" => LieAlgebra.SpecialLinear.sl (Fin 2) K
local notation "U" => _root_.UniversalEnvelopingAlgebra
local notation "ιU" => _root_.UniversalEnvelopingAlgebra.ι K

-- The coordinate `t` on the abelian Lie algebra `K`.
local notation "t" => (LinearEquiv.symm (AbelianLieAlgebra.equiv K K) 1 : ZK)

/-! ### The Weyl-algebra representation of `sl₂` on `K[x]` -/

/-- Multiplication by `x` on `K[x]`. -/
noncomputable def mulX : Module.End K K[X] := LinearMap.mulLeft K X

/-- The derivative on `K[x]`. -/
noncomputable def der : Module.End K K[X] := derivative

/-- The Weyl relation `d x = x d + 1` on `K[x]`. -/
theorem der_mul_mulX : der K * mulX K = mulX K * der K + 1 := by
  refine LinearMap.ext fun p ↦ ?_
  simp [der, mulX, derivative_mul, add_comm]

/-- In a ring with `d m = m d + 1`, the elements `h = 2 m d`, `e = m`, `f = -m d²` satisfy the
`sl₂` relations. -/
theorem weyl_sl2_relations {A : Type*} [Ring A] {m d : A} (hdm : d * m = m * d + 1) :
    ⁅m, -(m * d * d)⁆ = 2 * (m * d) ∧ ⁅2 * (m * d), m⁆ = 2 • m ∧
      ⁅2 * (m * d), -(m * d * d)⁆ = -(2 • -(m * d * d)) := by
  have h (x : A) : d * (m * x) = m * (d * x) + x := by
    rw [← mul_assoc, hdm, add_mul, one_mul, mul_assoc]
  refine ⟨?_, ?_, ?_⟩ <;>
  · simp only [Ring.lie_def, mul_assoc, h, hdm, mul_add, add_mul, mul_neg, neg_mul, mul_one,
      two_mul, two_nsmul]
    abel

/-- The `sl₂` triple `h = 2x d/dx`, `e = x`, `f = -x d²/dx²` acting on `K[x]`. -/
theorem isSl2Triple_weyl [NeZero (2 : K)] :
    IsSl2Triple (2 * (mulX K * der K)) (mulX K) (-(mulX K * der K * der K)) := by
  obtain ⟨h1, h2, h3⟩ := weyl_sl2_relations (der_mul_mulX K)
  refine ⟨fun h ↦ ?_, h1, h2, h3⟩
  have := congrArg (fun φ : Module.End K K[X] ↦ φ X) h
  simp only [mulX, der, mul_apply_eq_comp, LinearMap.mulLeft_apply, derivative_X,
    LinearMap.zero_apply] at this
  have h2 : (2 : Module.End K K[X]) X = C 2 * X := by
    rw [show (2 : Module.End K K[X]) = (2 : K) • 1 by simp [two_smul, one_add_one_eq_two]]
    simp [Polynomial.smul_eq_C_mul]
  simp [h2, NeZero.ne] at this

/-! ### `e³` is central in characteristic three -/

local notation "E" => ιU (slFinTwoBasis K 0)
local notation "F" => ιU (slFinTwoBasis K 1)
local notation "H" => ιU (slFinTwoBasis K 2)

/-- The relation `f e = e f - h` in `U(sl₂)`, multiplied on the right. -/
theorem ι_F_mul_E_mul (x : U K sl₂) : F * (E * x) = E * (F * x) - H * x := by
  have := (ιU : sl₂ →ₗ⁅K⁆ U K sl₂).map_lie (slFinTwoBasis K 0) (slFinTwoBasis K 1)
  rw [lie_slFinTwoBasis_zero_one, LieRing.of_associative_ring_bracket] at this
  rw [← mul_assoc, ← mul_assoc, this]
  noncomm_ring

/-- The relation `f e = e f - h` in `U(sl₂)`. -/
theorem ι_F_mul_E : F * E = E * F - H := by
  simpa using ι_F_mul_E_mul K 1

/-- The relation `h e = e h + 2e` in `U(sl₂)`, multiplied on the right. -/
theorem ι_H_mul_E (x : U K sl₂) : H * (E * x) = E * (H * x) + 2 * (E * x) := by
  have := (ιU : sl₂ →ₗ⁅K⁆ U K sl₂).map_lie (slFinTwoBasis K 2) (slFinTwoBasis K 0)
  rw [lie_slFinTwoBasis_two_zero, LieRing.of_associative_ring_bracket, map_smul,
    Algebra.smul_def, map_ofNat] at this
  rw [← mul_assoc, ← mul_assoc, ← mul_assoc 2, this]
  noncomm_ring

/-- The relation `h e = e h + 2e` in `U(sl₂)`. -/
theorem ι_H_mul_E' : H * E = E * H + 2 * E := by
  simpa using ι_H_mul_E K 1

/-- **`e³` is central in `U(sl₂)` in characteristic three.** -/
theorem pow_three_ι_mem_center [CharP K 3] : E ^ 3 ∈ Subalgebra.center K (U K sl₂) := by
  have h3 : (3 : U K sl₂) = 0 := by
    have h : (3 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 3
    rw [← map_ofNat (algebraMap K (U K sl₂)) 3, h, map_zero]
  rw [mem_center_iff_forall_lie_ι]
  intro x
  rw [← (slFinTwoBasis K).sum_repr x, map_sum, lie_sum, Fin.sum_univ_three]
  simp only [map_smul, lie_smul]
  have hE : ⁅E ^ 3, E⁆ = 0 := by
    rw [LieRing.of_associative_ring_bracket]; noncomm_ring
  have hF : ⁅E ^ 3, F⁆ = 3 * (E * (E * H) + 2 * (E * E)) := by
    simp only [LieRing.of_associative_ring_bracket, pow_succ, pow_zero, one_mul, mul_assoc,
      ι_F_mul_E_mul, ι_H_mul_E, ι_F_mul_E, ι_H_mul_E', mul_sub, mul_add]
    noncomm_ring
  have hH : ⁅E ^ 3, H⁆ = 3 * (-(2 * (E * (E * E)))) := by
    simp only [LieRing.of_associative_ring_bracket, pow_succ, pow_zero, one_mul, mul_assoc,
      ι_H_mul_E, ι_H_mul_E', mul_add]
    noncomm_ring
  rw [hE, hF, hH, h3]
  simp

/-! ### `e³` is not a polynomial in `Ω` -/

/-- `2 ≠ 0` in characteristic three. -/
theorem neZero_two_of_charP_three [CharP K 3] : NeZero (2 : K) := by
  refine ⟨fun h ↦ ?_⟩
  have h3 : (3 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 3
  have : (1 : K) = 0 := by linear_combination h3 - h
  exact one_ne_zero this

/-- The representation of `U(sl₂)` on `K[x]` with `e = x`, `h = 2x d/dx`, `f = -x d²/dx²`. -/
noncomputable def weylRep [NeZero (2 : K)] : U K sl₂ →ₐ[K] Module.End K K[X] :=
  _root_.UniversalEnvelopingAlgebra.lift K ((isSl2Triple_weyl K).toLieHom K)

/-- The values of `weylRep` on the standard basis `e, f, h`. -/
theorem weylRep_ι [NeZero (2 : K)] (i : Fin 3) :
    weylRep K (ιU (slFinTwoBasis K i)) =
      ![mulX K, -(mulX K * der K * der K), 2 * (mulX K * der K)] i := by
  rw [weylRep, _root_.UniversalEnvelopingAlgebra.lift_ι_apply, IsSl2Triple.toLieHom_slFinTwoBasis]

/-- `Ω` acts by zero on `K[x]`. -/
theorem weylRep_slTwoOmega [NeZero (2 : K)] : weylRep K (slTwoOmega K) = 0 := by
  have hdm := der_mul_mulX K
  have h (x : Module.End K K[X]) : der K * (mulX K * x) = mulX K * (der K * x) + x := by
    rw [← mul_assoc, hdm, add_mul, one_mul, mul_assoc]
  have h2 : (2 : Module.End K K[X]) = (2 : K) • 1 := by
    rw [two_smul, one_add_one_eq_two]
  rw [slTwoOmega_def]
  simp only [map_add, map_mul, map_smul, weylRep_ι, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, h2, smul_mul_assoc, mul_smul_comm,
    one_mul, mul_assoc, smul_smul]
  rw [← neg_one_smul K (mulX K * (der K * der K)), smul_mul_assoc, mul_assoc, mul_assoc, hdm]
  simp only [mul_add, h, mul_one, smul_add, smul_smul]
  module

/-- `e³` acts on `K[x]` by multiplication by `x³`, which is not a scalar. -/
theorem weylRep_pow_three_notMem_bot [NeZero (2 : K)] :
    weylRep K (E ^ 3) ∉ (⊥ : Subalgebra K (Module.End K K[X])) := by
  intro hmem
  obtain ⟨c, hc⟩ := Algebra.mem_bot.mp hmem
  have h1 := congrArg (fun φ : Module.End K K[X] ↦ φ 1) hc
  rw [map_pow, weylRep_ι] at h1
  simp only [Matrix.cons_val_zero, Module.algebraMap_end_apply] at h1
  have hX : (mulX K ^ 3) 1 = X ^ 3 := by
    simp [mulX, pow_succ, mul_apply_eq_comp, mul_assoc]
  rw [hX, Algebra.smul_def, mul_one, Polynomial.algebraMap_eq, eq_comm] at h1
  have := congrArg natDegree h1
  simp at this

/-- In characteristic three, `e³` is not in the subalgebra generated by `Ω`. -/
theorem pow_three_ι_notMem_adjoin_slTwoOmega [CharP K 3] :
    E ^ 3 ∉ Algebra.adjoin K {slTwoOmega K} := by
  have := neZero_two_of_charP_three K
  intro hmem
  have hle : Algebra.adjoin K {slTwoOmega K} ≤ (⊥ : Subalgebra K (Module.End K K[X])).comap
      (weylRep K) := by
    rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    simp [weylRep_slTwoOmega]
  exact weylRep_pow_three_notMem_bot K (hle hmem)

/-! ### The centre of `U(K × sl₂)` in characteristic three -/

/-- **In characteristic three, `1 ⊗ e³` is central in `U(K × sl₂)`.** -/
theorem map_inr_pow_three_ι_mem_center [CharP K 3] :
    map K (LieHom.inr K ZK sl₂) (E ^ 3) ∈ Subalgebra.center K (U K (ZK × sl₂)) := by
  have h := ((productCenterEquiv K ZK sl₂).symm
    (1 ⊗ₜ[K] ⟨E ^ 3, pow_three_ι_mem_center K⟩)).property
  simpa [productCenterEquiv_symm_tmul] using h

/-- **In characteristic three, `1 ⊗ e³` is not in `K[t] ⊗ K[Ω]`**: it does not lie in the
subalgebra of `U(K × sl₂)` generated by `t` and `1 ⊗ Ω`, which in characteristic zero is the
whole centre. -/
theorem map_inr_pow_three_ι_notMem_adjoin [CharP K 3] :
    map K (LieHom.inr K ZK sl₂) (E ^ 3) ∉ Algebra.adjoin K
      {ιU ((t, 0) : ZK × sl₂), map K (LieHom.inr K ZK sl₂) (slTwoOmega K)} := by
  have := neZero_two_of_charP_three K
  let φ := (weylRep K).comp (map K (LieHom.snd K ZK sl₂))
  have hφ (x : U K sl₂) : φ (map K (LieHom.inr K ZK sl₂) x) = weylRep K x := by
    have : (map K (LieHom.snd K ZK sl₂)).comp (map K (LieHom.inr K ZK sl₂)) = AlgHom.id K _ := by
      rw [← map_comp]
      convert map_id (R := K) (L := sl₂)
      exact LieHom.ext fun _ ↦ rfl
    simp only [φ, AlgHom.comp_apply]
    rw [← AlgHom.comp_apply (map K _), this, AlgHom.id_apply]
  intro hmem
  have hle : Algebra.adjoin K
      {ιU ((t, 0) : ZK × sl₂), map K (LieHom.inr K ZK sl₂) (slTwoOmega K)} ≤
      (⊥ : Subalgebra K (Module.End K K[X])).comap φ := by
    rw [Algebra.adjoin_le_iff]
    rintro _ (rfl | rfl)
    · simp [φ]
    · simp [hφ, weylRep_slTwoOmega]
  have := hle hmem
  rw [Subalgebra.mem_comap, hφ] at this
  exact weylRep_pow_three_notMem_bot K this

end TauCeti.Examples.ProductEnvelopingCharThree
