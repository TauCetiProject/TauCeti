/-!
# A closure ideal over a non-fraction field need not be a Hopf ideal

For a Hopf `O`-algebra `B` and an ideal `I` of `K ⊗_O B`, the ideal `I^♮ = B ∩ I` of
`TauCeti.SchematicClosure.closureIdeal` makes sense for any algebra `K` over any ring `O`. It is
a Hopf ideal when `K` is the fraction field of `O` and the tensor square of `B ⧸ I^♮` is
torsion-free over `O`, e.g. over a Dedekind domain
(`TauCeti.SchematicClosure.closureIdeal_isHopfIdeal`), but not in general. This file records the
standard counterexample: over `O = ℤ`, with `B = ℤ[x, y]` the coordinate ring of the
additive group `𝔾ₐ²` and `K = ℚ(√2)`, the line `y = √2 x` is cut out by the Hopf ideal
`I = (y − √2 x)` of `K ⊗_ℤ B`. The closure `I^♮` contains `y² − 2x²`, and it is killed both by
the `K`-point `(1, √2)` of the line and by its Galois conjugate `(1, −√2)`. Their sum `(2, 0)`
does not kill `y² − 2x²`, so `I^♮` is not a Hopf ideal of `B`.

The argument works for any commutative ring `K` with an element `s`, `s * s = 2`, and a ring
endomorphism `σ` with `σ s = -s` (if `8 = 0` in `K`, then `8 ∈ I^♮` and the counit already
fails). The Check takes `K = QuadraticAlgebra ℚ 2 0`, `s = ω` and `σ` the conjugation.

When moreover `1` and `s` are linearly independent over `ℤ`, `I^♮` is exactly `(y² − 2x²)`, the
ideal of the union of the line and its conjugate. Divide by `y² − 2x²`, monic in `y`: the
remainder `r₀(x) + r₁(x) y` vanishes on the line, so `r₀(t) + s t r₁(t) = 0` in `K[t]`, and
comparing coefficients gives `r₀ = r₁ = 0`.

## Main declarations

* `TauCeti.AdditiveGroup.ClosureNotHopf.lineHopfIdeal`: the Hopf ideal `(y − s x)` of
  `K ⊗_ℤ ℤ[x, y]`.
* `TauCeti.AdditiveGroup.ClosureNotHopf.not_exists_hopfIdeal_closureIdeal_lineHopfIdeal`: its
  closure ideal in `ℤ[x, y]` is not the ideal of any Hopf ideal.
* `TauCeti.AdditiveGroup.ClosureNotHopf.not_exists_hopfIdeal_closureIdeal_sqrtTwo`: the Check
  for `ℤ ⊂ ℚ(√2)`.
* `TauCeti.AdditiveGroup.ClosureNotHopf.closureIdeal_lineHopfIdeal_eq`,
  `TauCeti.AdditiveGroup.ClosureNotHopf.closureIdeal_sqrtTwo`: the closure ideal is `(y² − 2x²)`.
-/

public section

open SymmetricAlgebra WithConv TensorProduct

namespace TauCeti.AdditiveGroup.ClosureNotHopf

universe u

/-- The coordinate ring `ℤ[x, y]` of the additive group `𝔾ₐ²` over `ℤ`. -/
abbrev PlaneCoordinateRing : Type := SymmetricAlgebra ℤ (Fin 2 → ℤ)

/-- The first coordinate `x` of `𝔾ₐ²`. -/
noncomputable abbrev planeX : PlaneCoordinateRing := ι ℤ _ (Pi.single 0 1)

/-- The second coordinate `y` of `𝔾ₐ²`. -/
noncomputable abbrev planeY : PlaneCoordinateRing := ι ℤ _ (Pi.single 1 1)

variable {K : Type u} [CommRing K]

/-- The equation `y − s x` of the line `y = s x`, in `K ⊗_ℤ ℤ[x, y]`. -/
noncomputable def lineEquation (s : K) : K ⊗[ℤ] PlaneCoordinateRing :=
  (1 : K) ⊗ₜ planeY - s ⊗ₜ planeX

/-- The defining formula of `lineEquation`. -/
theorem lineEquation_def (s : K) : lineEquation s = (1 : K) ⊗ₜ planeY - s ⊗ₜ planeX := by
  rw [lineEquation]

/-- The equation `y − s x` of the line is primitive. -/
theorem isPrimitiveElem_lineEquation (s : K) :
    Bialgebra.IsPrimitiveElem K (lineEquation s) := by
  have h : lineEquation s = (1 : K) ⊗ₜ planeY - s • ((1 : K) ⊗ₜ[ℤ] planeX) := by
    rw [lineEquation, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  rw [h]
  exact (isPrimitiveElem_ι _).one_tmul.sub ((isPrimitiveElem_ι _).one_tmul.smul s)

/-- The Hopf ideal `(y − s x)` of `K ⊗_ℤ ℤ[x, y]`: the line `y = s x` is a subgroup of `𝔾ₐ²`. -/
noncomputable def lineHopfIdeal (s : K) : HopfIdeal K (K ⊗[ℤ] PlaneCoordinateRing) :=
  HopfIdeal.ofPrimitive (isPrimitiveElem_lineEquation s)

/-- The ideal underlying `lineHopfIdeal s` is the ideal generated by `y − s x`. -/
@[simp]
theorem lineHopfIdeal_toIdeal (s : K) :
    (lineHopfIdeal s).toIdeal = Ideal.span {lineEquation s} :=
  HopfIdeal.ofPrimitive_toIdeal _

/-- The point `(x, y) ↦ (1, s)` of `𝔾ₐ²` with values in `K`. -/
noncomputable def linePoint (s : K) : PlaneCoordinateRing →ₐ[ℤ] K :=
  SymmetricAlgebra.lift
    ((LinearMap.proj 0 : (Fin 2 → ℤ) →ₗ[ℤ] ℤ).smulRight (1 : K) +
      (LinearMap.proj 1 : (Fin 2 → ℤ) →ₗ[ℤ] ℤ).smulRight s)

/-- The point `(1, s)` sends `ι v` to `v 0 + v 1 • s`. -/
theorem linePoint_ι (s : K) (v : Fin 2 → ℤ) : linePoint s (ι ℤ _ v) = v 0 + v 1 • s := by
  simp [linePoint]

/-- The point `(1, s)` has `x`-coordinate `1`. -/
@[simp]
theorem linePoint_planeX (s : K) : linePoint s planeX = 1 := by
  simp [linePoint]

/-- The point `(1, s)` has `y`-coordinate `s`. -/
@[simp]
theorem linePoint_planeY (s : K) : linePoint s planeY = s := by
  simp [linePoint]

/-- `y² − 2x²` lies in the closure of the line `y = s x` when `s * s = 2`. -/
theorem mem_closureIdeal_lineHopfIdeal {s : K} (hs : s * s = 2) :
    planeY * planeY - 2 * (planeX * planeX) ∈
      SchematicClosure.closureIdeal K (lineHopfIdeal s).toIdeal := by
  rw [SchematicClosure.closureIdeal_def, Ideal.mem_comap, lineHopfIdeal_toIdeal,
    Ideal.mem_span_singleton']
  let ι₂ := Algebra.TensorProduct.includeRight (R := ℤ) (A := K) (B := PlaneCoordinateRing)
  let a := algebraMap K (K ⊗[ℤ] PlaneCoordinateRing) s
  have hc : a * a = 2 := by
    rw [← map_mul, hs, map_ofNat]
  have hl : lineEquation s = ι₂ planeY - a * ι₂ planeX := by
    simp [ι₂, a, lineEquation, Algebra.TensorProduct.algebraMap_apply]
  refine ⟨ι₂ planeY + a * ι₂ planeX, ?_⟩
  simp only [hl, map_sub, map_mul, map_ofNat]
  linear_combination (-(ι₂ planeX * ι₂ planeX)) * hc

/-- A point of `𝔾ₐ²` with values in a commutative `K`-algebra `L` that lies on the line
`y = s x` kills the closure of the line. -/
theorem map_eq_zero_of_mem_closureIdeal {L : Type*} [CommRing L] [Algebra K L] (s : K)
    (φ : PlaneCoordinateRing →ₐ[ℤ] L) (hφ : φ planeY = s • φ planeX) {a : PlaneCoordinateRing}
    (ha : a ∈ SchematicClosure.closureIdeal K (lineHopfIdeal s).toIdeal) :
    φ a = 0 := by
  rw [SchematicClosure.mem_closureIdeal, lineHopfIdeal_toIdeal, Ideal.mem_span_singleton'] at ha
  obtain ⟨c, hc⟩ := ha
  let Φ : K ⊗[ℤ] PlaneCoordinateRing →ₐ[K] L :=
    Algebra.TensorProduct.lift (Algebra.ofId K L) φ fun _ _ ↦ Commute.all _ _
  have h := congrArg Φ hc
  simpa [Φ, lineEquation, hφ, Algebra.ofId_apply, Algebra.smul_def] using h.symm

/-- The point `(1, s)` kills the closure of the line `y = s x`. -/
theorem linePoint_eq_zero_of_mem_closureIdeal (s : K) {a : PlaneCoordinateRing}
    (ha : a ∈ SchematicClosure.closureIdeal K (lineHopfIdeal s).toIdeal) :
    linePoint s a = 0 :=
  map_eq_zero_of_mem_closureIdeal s (linePoint s) (by simp) ha

/-- A ring endomorphism `σ` of `K` carries the point `(1, s)` to `(1, σ s)`. -/
theorem comp_linePoint (s : K) (σ : K →+* K) :
    (σ.toIntAlgHom).comp (linePoint s) = linePoint (σ s) := by
  refine SymmetricAlgebra.algHom_ext (LinearMap.ext fun v ↦ ?_)
  simp [linePoint]

/-- **The closure of a line need not be a Hopf ideal.** If `K` contains `s` with `s * s = 2` and
has a ring endomorphism `σ` with `σ s = -s`, the closure ideal in `ℤ[x, y]` of the Hopf ideal
`(y − s x)` of `K ⊗_ℤ ℤ[x, y]` is not a Hopf ideal: it is killed by the points `(1, s)` and
`(1, -s)` but not by their sum `(2, 0)`, unless `8 = 0` in `K`, when it contains `8`. -/
theorem not_exists_hopfIdeal_closureIdeal_lineHopfIdeal {s : K} (hs : s * s = 2)
    (σ : K →+* K) (hσ : σ s = -s) :
    ¬∃ J : HopfIdeal ℤ PlaneCoordinateRing,
      J.toIdeal = SchematicClosure.closureIdeal K (lineHopfIdeal s).toIdeal := by
  rintro ⟨J, hJ⟩
  by_cases h8 : (8 : K) = 0
  · -- If `8 = 0` in `K`, then `1 ⊗ 8 = 8 ⊗ 1 = 0` in `K ⊗_ℤ ℤ[x, y]`, so `8 ∈ I^♮`, but the
    -- counit of `8` is `8 ≠ 0`.
    have h : ((8 : ℕ) : PlaneCoordinateRing) ∈ J := by
      rw [← HopfIdeal.mem_toIdeal, hJ, SchematicClosure.mem_closureIdeal,
        ← Algebra.TensorProduct.natCast_def', Algebra.TensorProduct.natCast_def]
      simp [h8]
    have := J.counit_eq_zero h
    rw [Bialgebra.counit_natCast] at this
    norm_num at this
  let H := CommHopfAlgCat.of ℤ PlaneCoordinateRing
  let A := CommAlgCat.of ℤ K
  have hmem : ∀ t : K, (∀ a ∈ J, linePoint t a = 0) →
      (toConv (linePoint t) : HopfAlgebra.points (R := ℤ) (H := H) A) ∈
        CommHopfAlgCat.quotientPointsSubgroup H J A := fun t ht ↦
    (CommHopfAlgCat.mem_quotientPointsSubgroup_iff H J A _).mpr ht
  have hP : ∀ a ∈ J, linePoint s a = 0 := fun a ha ↦
    linePoint_eq_zero_of_mem_closureIdeal s (hJ ▸ (HopfIdeal.mem_toIdeal.mpr ha))
  have hQ : ∀ a ∈ J, linePoint (-s) a = 0 := fun a ha ↦ by
    rw [← hσ, ← comp_linePoint, AlgHom.comp_apply, hP a ha, map_zero]
  have hmul := mul_mem (hmem s hP) (hmem (-s) hQ)
  have hq : planeY * planeY - 2 * (planeX * planeX) ∈ J := by
    rw [← HopfIdeal.mem_toIdeal, hJ]
    exact mem_closureIdeal_lineHopfIdeal hs
  -- The points of `H` with values in `A` are by definition the convolution monoid of
  -- `ℤ`-algebra maps `ℤ[x, y] → K`, so the subgroup membership reads as a value of their product.
  have h : (toConv (linePoint s) * toConv (linePoint (-s)) :
      WithConv (PlaneCoordinateRing →ₐ[ℤ] K)).ofConv
        (planeY * planeY - 2 * (planeX * planeX)) = 0 :=
    (CommHopfAlgCat.mem_quotientPointsSubgroup_iff H J A _).mp hmul _ hq
  simp only [map_sub, map_mul, map_ofNat, convMul_apply_ι, linePoint_planeX,
    linePoint_planeY] at h
  norm_num at h
  exact h8 h

open QuadraticAlgebra in
/-- **Check: over `ℤ ⊂ ℚ(√2)` the closure of the line `y = √2 x` is not a Hopf ideal.** With
`ℚ(√2) = QuadraticAlgebra ℚ 2 0`, `√2 = ω` and the Galois conjugation `star`, the closure ideal
in `ℤ[x, y]` of the Hopf ideal `(y − √2 x)` of `ℚ(√2) ⊗_ℤ ℤ[x, y]` is not a Hopf ideal. -/
theorem not_exists_hopfIdeal_closureIdeal_sqrtTwo :
    ¬∃ J : HopfIdeal ℤ PlaneCoordinateRing,
      J.toIdeal = SchematicClosure.closureIdeal (QuadraticAlgebra ℚ 2 0)
        (lineHopfIdeal (ω : QuadraticAlgebra ℚ 2 0)).toIdeal :=
  not_exists_hopfIdeal_closureIdeal_lineHopfIdeal (by ext <;> simp) (starRingEnd _)
    (by ext <;> simp [starRingEnd_apply])

/-! ### The closure ideal is `(y² − 2x²)` -/

section Equation

open Polynomial

/-- The comparison `ℤ[x, y] ≃ ℤ[X][Y]`, `x ↦ X`, `y ↦ Y`. -/
private noncomputable def polyPolyEquiv : PlaneCoordinateRing ≃ₐ[ℤ] ℤ[X][X] :=
  (SymmetricAlgebra.equivMvPolynomial (Pi.basisFun ℤ (Fin 2))).trans
    (Bivariate.equivMvPolynomial ℤ).symm

/-- `polyPolyEquiv` sends `x` to `X`. -/
private theorem polyPolyEquiv_planeX : polyPolyEquiv planeX = C X := by
  rw [polyPolyEquiv, AlgEquiv.trans_apply, planeX, ← Pi.basisFun_apply,
    equivMvPolynomial_ι_apply, Bivariate.equivMvPolynomial_symm_X_0]

/-- `polyPolyEquiv` sends `y` to `Y`. -/
private theorem polyPolyEquiv_planeY : polyPolyEquiv planeY = X := by
  rw [polyPolyEquiv, AlgEquiv.trans_apply, planeY, ← Pi.basisFun_apply,
    equivMvPolynomial_ι_apply, Bivariate.equivMvPolynomial_symm_X_1]

/-- `polyPolyEquiv` sends `y² − 2x²` to the monic polynomial `Y² − 2X²` in `Y`. -/
private theorem polyPolyEquiv_lineClosureEquation :
    polyPolyEquiv (planeY * planeY - 2 * (planeX * planeX)) = X ^ 2 - C (2 * X ^ 2) := by
  simp [polyPolyEquiv_planeX, polyPolyEquiv_planeY, sq, C_mul, map_ofNat]

/-- Restriction of polynomials in `x`, `y` to the line `y = s x`, as polynomials in `x`. -/
private noncomputable def restrictLine (s : K) : ℤ[X][X] →+* K[X] :=
  eval₂RingHom (mapRingHom (Int.castRingHom K)) (C s * X)

/-- `Y² − 2X²` vanishes on the line `y = s x` when `s * s = 2`. -/
private theorem restrictLine_lineClosureEquation {s : K} (hs : s * s = 2) :
    restrictLine s (X ^ 2 - C (2 * X ^ 2)) = 0 := by
  have hC : C s * C s = (2 : K[X]) := by rw [← C_mul, hs, map_ofNat]
  simp [restrictLine, eval₂_pow]
  linear_combination (X ^ 2 : K[X]) * hC

/-- If `1` and `s` are `ℤ`-linearly independent in `K`, then `f₀ + s x f₁ = 0` in `K[x]` for
integer polynomials `f₀`, `f₁` only when both vanish. -/
private theorem eq_zero_of_map_add_mul_eq_zero {s : K}
    (hs : ∀ m n : ℤ, (m : K) + n * s = 0 → m = 0 ∧ n = 0) {f₀ f₁ : ℤ[X]}
    (h : f₀.map (Int.castRingHom K) + C s * (f₁.map (Int.castRingHom K) * X) = 0) :
    f₀ = 0 ∧ f₁ = 0 := by
  have hc (n : ℕ) : (f₀.coeff (n + 1) : K) + f₁.coeff n * s = 0 := by
    simpa [coeff_C_mul, coeff_mul_X, mul_comm] using congrArg (·.coeff (n + 1)) h
  have h0 : (f₀.coeff 0 : K) + (0 : ℤ) * s = 0 := by
    simpa [coeff_C_mul] using congrArg (·.coeff 0) h
  constructor <;> ext n
  · cases n with
    | zero => simpa using (hs _ _ h0).1
    | succ n => simpa using (hs _ _ (hc n)).1
  · simpa using (hs _ _ (hc n)).2

/-- **The closure of the line `y = s x` is `(y² − 2x²)`.** If `s * s = 2` and `1`, `s` are
`ℤ`-linearly independent in `K`, the closure ideal in `ℤ[x, y]` of the Hopf ideal `(y − s x)` of
`K ⊗_ℤ ℤ[x, y]` is generated by `y² − 2x²`. -/
theorem closureIdeal_lineHopfIdeal_eq {s : K} (hs : s * s = 2)
    (hind : ∀ m n : ℤ, (m : K) + n * s = 0 → m = 0 ∧ n = 0) :
    SchematicClosure.closureIdeal K (lineHopfIdeal s).toIdeal =
      Ideal.span {planeY * planeY - 2 * (planeX * planeX)} := by
  refine le_antisymm (fun a ha ↦ ?_) ?_
  · set p := polyPolyEquiv a with hp
    set g : ℤ[X][X] := X ^ 2 - C (2 * X ^ 2) with hg_def
    have hg : g.Monic := monic_X_pow_sub_C _ two_ne_zero
    have hr := modByMonic_add_div p g
    have hdeg : (p %ₘ g).degree ≤ 1 := by
      have h := degree_modByMonic_lt p hg
      rw [hg_def, degree_X_pow_sub_C (by norm_num)] at h
      exact Order.le_of_lt_succ h
    have hlin := eq_X_add_C_of_degree_le_one hdeg
    have hz : restrictLine s (p %ₘ g) = 0 := by
      -- `ℤ[x, y] → K[x]`, `x ↦ x`, `y ↦ s x`. `RingHom.toIntAlgHom` and `RingHom.comp` apply
      -- definitionally, but `simp` cannot unfold them: the `ℤ`-algebra instances on `ℤ[x, y]`
      -- differ.
      let φ := ((restrictLine s).comp polyPolyEquiv.toRingHom).toIntAlgHom
      have hφ : φ planeY = s • φ planeX := by
        change restrictLine s (polyPolyEquiv planeY) = s • restrictLine s (polyPolyEquiv planeX)
        simp [polyPolyEquiv_planeX, polyPolyEquiv_planeY, restrictLine, smul_eq_C_mul]
      have h1 : restrictLine s p = 0 := map_eq_zero_of_mem_closureIdeal s φ hφ ha
      rw [← hr, map_add, map_mul, restrictLine_lineClosureEquation hs, zero_mul, add_zero] at h1
      exact h1
    obtain ⟨h0, h1⟩ := eq_zero_of_map_add_mul_eq_zero (f₀ := (p %ₘ g).coeff 0)
      (f₁ := (p %ₘ g).coeff 1) hind (by rw [← hz, hlin]; simp [restrictLine]; ring)
    have hr0 : p %ₘ g = 0 := by rw [hlin, h0, h1]; simp
    have hg' : polyPolyEquiv.symm g = planeY * planeY - 2 * (planeX * planeX) := by
      rw [AlgEquiv.symm_apply_eq, polyPolyEquiv_lineClosureEquation]
    rw [← polyPolyEquiv.symm_apply_apply a, ← hp, ← hr, hr0, zero_add, map_mul, hg']
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact mem_closureIdeal_lineHopfIdeal hs

open QuadraticAlgebra in
/-- **Check: over `ℤ ⊂ ℚ(√2)` the closure of the line `y = √2 x` is `(y² − 2x²)`.** -/
theorem closureIdeal_sqrtTwo :
    SchematicClosure.closureIdeal (QuadraticAlgebra ℚ 2 0)
        (lineHopfIdeal (ω : QuadraticAlgebra ℚ 2 0)).toIdeal =
      Ideal.span {planeY * planeY - 2 * (planeX * planeX)} := by
  refine closureIdeal_lineHopfIdeal_eq (by ext <;> simp) fun m n h ↦ ?_
  have hre : (m : ℚ) = 0 := by simpa using congrArg QuadraticAlgebra.re h
  have him : (n : ℚ) = 0 := by simpa using congrArg QuadraticAlgebra.im h
  exact ⟨by exact_mod_cast hre, by exact_mod_cast him⟩

end Equation

end TauCeti.AdditiveGroup.ClosureNotHopf
