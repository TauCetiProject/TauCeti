module

public import Mathlib.Algebra.QuadraticAlgebra.Basic
public import Mathlib.RingTheory.HopfAlgebra.Primitive
public import TauCeti.Algebra.AlgebraicGroup.AdditiveGroup.Basic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Points.Basic
public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.SchematicClosure

/-!
# A closure ideal over a non-fraction field need not be a Hopf ideal

The ideal `I^♮ = A ∩ I` of `TauCeti.SchematicClosure.closureIdeal` makes sense for any algebra
`K` over any ring `O`. It is a Hopf ideal when `K` is the fraction field of `O`
(`TauCeti.SchematicClosure.closureIdeal_isHopfIdeal`), but not in general. This file records the
counterexample of the roadmap: over `O = ℤ`, with `B = ℤ[x, y]` the coordinate ring of the
additive group `𝔾ₐ²` and `K = ℚ(√2)`, the line `y = √2 x` is cut out by the Hopf ideal
`I = (y − √2 x)` of `K ⊗_ℤ B`. The closure `I^♮` contains `y² − 2x²`, and it is killed both by
the `K`-point `(1, √2)` of the line and by its Galois conjugate `(1, −√2)`. Their sum `(2, 0)`
does not kill `y² − 2x²`, so `I^♮` is not a Hopf ideal of `B`.

The argument works for any commutative ring `K` with an element `s`, `s * s = 2`, and a ring
endomorphism `σ` with `σ s = -s` (if `8 = 0` in `K`, then `8 ∈ I^♮` and the counit already
fails). The Check takes `K = QuadraticAlgebra ℚ 2 0`, `s = ω` and `σ` the conjugation.

## Main declarations

* `TauCeti.AdditiveGroup.ClosureNotHopf.lineHopfIdeal`: the Hopf ideal `(y − s x)` of
  `K ⊗_ℤ ℤ[x, y]`.
* `TauCeti.AdditiveGroup.ClosureNotHopf.not_exists_hopfIdeal_closureIdeal_lineHopfIdeal`: its
  closure ideal in `ℤ[x, y]` is not the ideal of any Hopf ideal.
* `TauCeti.AdditiveGroup.ClosureNotHopf.not_exists_hopfIdeal_closureIdeal_sqrtTwo`: the Check
  for `ℤ ⊂ ℚ(√2)`.
-/

public section

open SymmetricAlgebra WithConv TensorProduct

namespace TauCeti.AdditiveGroup.ClosureNotHopf

universe u

/-- The coordinate ring `ℤ[x, y]` of the additive group `𝔾ₐ²` over `ℤ`. -/
abbrev PlaneCoordinateRing : Type := SymmetricAlgebra ℤ (Fin 2 → ℤ)

/-- The first coordinate `x` of `𝔾ₐ²`. -/
noncomputable abbrev planeX : PlaneCoordinateRing := ι ℤ _ (Pi.single 0 1)

/-- The second coordinate `y` of `𝔾ₐ²`. -/
noncomputable abbrev planeY : PlaneCoordinateRing := ι ℤ _ (Pi.single 1 1)

variable {K : Type u} [CommRing K]

/-- The equation `y − s x` of the line `y = s x`, in `K ⊗_ℤ ℤ[x, y]`. -/
noncomputable def lineEquation (s : K) : K ⊗[ℤ] PlaneCoordinateRing :=
  (1 : K) ⊗ₜ planeY - s ⊗ₜ planeX

/-- The defining formula of `lineEquation`. -/
theorem lineEquation_def (s : K) : lineEquation s = (1 : K) ⊗ₜ planeY - s ⊗ₜ planeX := by
  rw [lineEquation]

/-- A coordinate `1 ⊗ ι v` of the base change `K ⊗_ℤ Sym(ℤ²)` is primitive. -/
theorem isPrimitiveElem_one_tmul_ι (v : Fin 2 → ℤ) :
    Bialgebra.IsPrimitiveElem K ((1 : K) ⊗ₜ[ℤ] ι ℤ (Fin 2 → ℤ) v) := by
  rw [Bialgebra.isPrimitiveElem_iff_comul_eq_tmul_add_tmul,
    TauCeti.Coalgebra.baseChange_comul_tmul, SymmetricAlgebra.comul_ι]
  simp [TensorProduct.tmul_add, Algebra.TensorProduct.one_def, add_comm]

/-- The equation `y − s x` of the line is primitive. -/
theorem isPrimitiveElem_lineEquation (s : K) :
    Bialgebra.IsPrimitiveElem K (lineEquation s) := by
  have h : lineEquation s = (1 : K) ⊗ₜ planeY - s • ((1 : K) ⊗ₜ[ℤ] planeX) := by
    rw [lineEquation, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  rw [h]
  exact (isPrimitiveElem_one_tmul_ι _).sub ((isPrimitiveElem_one_tmul_ι _).smul s)

/-- The Hopf ideal `(y − s x)` of `K ⊗_ℤ ℤ[x, y]`: the line `y = s x` is a subgroup of `𝔾ₐ²`. -/
noncomputable def lineHopfIdeal (s : K) : HopfIdeal K (K ⊗[ℤ] PlaneCoordinateRing) :=
  HopfIdeal.ofSpan {lineEquation s}
    (fun x hx => by
      rw [Set.mem_singleton_iff.mp hx, (isPrimitiveElem_lineEquation s).comul_eq_tmul_add_tmul]
      refine add_mem (Ideal.mem_sup_right ?_) (Ideal.mem_sup_left ?_)
      · exact Ideal.tmul_mem_rightTensorIdeal _ _ _ (Ideal.subset_span (Set.mem_singleton _))
      · exact Ideal.tmul_mem_leftTensorIdeal _ _ (Ideal.subset_span (Set.mem_singleton _)) _)
    (fun x hx => by
      rw [Set.mem_singleton_iff.mp hx, (isPrimitiveElem_lineEquation s).counit_eq_zero])
    (fun x hx => by
      rw [Set.mem_singleton_iff.mp hx, (isPrimitiveElem_lineEquation s).antipode_eq_neg]
      exact neg_mem (Ideal.subset_span (Set.mem_singleton _)))

/-- The ideal underlying `lineHopfIdeal s` is the ideal generated by `y − s x`. -/
theorem lineHopfIdeal_toIdeal (s : K) :
    (lineHopfIdeal s).toIdeal = Ideal.span {lineEquation s} :=
  HopfIdeal.ofSpan_toIdeal _ _ _ _

/-- The point `(x, y) ↦ (1, s)` of `𝔾ₐ²` with values in `K`. -/
noncomputable def linePoint (s : K) : PlaneCoordinateRing →ₐ[ℤ] K :=
  SymmetricAlgebra.lift
    ((LinearMap.proj 0 : (Fin 2 → ℤ) →ₗ[ℤ] ℤ).smulRight (1 : K) +
      (LinearMap.proj 1 : (Fin 2 → ℤ) →ₗ[ℤ] ℤ).smulRight s)

/-- The point `(1, s)` sends `ι v` to `v 0 + v 1 • s`. -/
theorem linePoint_ι (s : K) (v : Fin 2 → ℤ) : linePoint s (ι ℤ _ v) = v 0 + v 1 • s := by
  simp [linePoint]

/-- The point `(1, s)` has `x`-coordinate `1`. -/
@[simp]
theorem linePoint_planeX (s : K) : linePoint s planeX = 1 := by
  simp [linePoint]

/-- The point `(1, s)` has `y`-coordinate `s`. -/
@[simp]
theorem linePoint_planeY (s : K) : linePoint s planeY = s := by
  simp [linePoint]

/-- `y² − 2x²` lies in the closure of the line `y = s x` when `s * s = 2`. -/
theorem mem_closureIdeal_lineHopfIdeal {s : K} (hs : s * s = 2) :
    planeY * planeY - 2 * (planeX * planeX) ∈
      SchematicClosure.closureIdeal K (lineHopfIdeal s).toIdeal := by
  rw [SchematicClosure.mem_closureIdeal, lineHopfIdeal_toIdeal, Ideal.mem_span_singleton']
  refine ⟨(1 : K) ⊗ₜ planeY + s ⊗ₜ planeX, ?_⟩
  have hc : algebraMap K (K ⊗[ℤ] PlaneCoordinateRing) s * algebraMap K _ s = 2 := by
    rw [← map_mul, hs, map_ofNat]
  have hx : s ⊗ₜ[ℤ] planeX = algebraMap K (K ⊗[ℤ] PlaneCoordinateRing) s * (1 ⊗ₜ planeX) := by
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
      one_mul, Algebra.algebraMap_self, RingHom.id_apply]
  have hr : ∀ b : PlaneCoordinateRing,
      (1 : K) ⊗ₜ[ℤ] b = Algebra.TensorProduct.includeRight (R := ℤ) (A := K) b := fun _ ↦ rfl
  rw [lineEquation, hx, hr planeY, hr planeX, hr, map_sub, map_mul, map_mul, map_mul, map_ofNat]
  linear_combination
    (-(Algebra.TensorProduct.includeRight (R := ℤ) (A := K) planeX *
      Algebra.TensorProduct.includeRight (R := ℤ) (A := K) planeX)) * hc

/-- The point `(1, s)` kills the closure of the line `y = s x`. -/
theorem linePoint_eq_zero_of_mem_closureIdeal (s : K) {a : PlaneCoordinateRing}
    (ha : a ∈ SchematicClosure.closureIdeal K (lineHopfIdeal s).toIdeal) :
    linePoint s a = 0 := by
  rw [SchematicClosure.mem_closureIdeal, lineHopfIdeal_toIdeal, Ideal.mem_span_singleton'] at ha
  obtain ⟨c, hc⟩ := ha
  let Φ : K ⊗[ℤ] PlaneCoordinateRing →ₐ[K] K :=
    Algebra.TensorProduct.lift (Algebra.ofId K K) (linePoint s) fun _ _ ↦ Commute.all _ _
  have h := congrArg Φ hc
  simpa [Φ, lineEquation] using h.symm

/-- A ring endomorphism `σ` of `K` carries the point `(1, s)` to `(1, σ s)`. -/
theorem comp_linePoint (s : K) (σ : K →+* K) :
    (σ.toIntAlgHom).comp (linePoint s) = linePoint (σ s) := by
  refine SymmetricAlgebra.algHom_ext (LinearMap.ext fun v ↦ ?_)
  simp [linePoint]

/-- **The closure of a line need not be a Hopf ideal.** If `K` contains `s` with `s * s = 2` and
has a ring endomorphism `σ` with `σ s = -s`, the closure ideal in `ℤ[x, y]` of the Hopf ideal
`(y − s x)` of `K ⊗_ℤ ℤ[x, y]` is not a Hopf ideal: it is killed by the points `(1, s)` and
`(1, -s)` but not by their sum `(2, 0)`, unless `8 = 0` in `K`, when it contains `8`. -/
theorem not_exists_hopfIdeal_closureIdeal_lineHopfIdeal {s : K} (hs : s * s = 2)
    (σ : K →+* K) (hσ : σ s = -s) :
    ¬∃ J : HopfIdeal ℤ PlaneCoordinateRing,
      J.toIdeal = SchematicClosure.closureIdeal K (lineHopfIdeal s).toIdeal := by
  rintro ⟨J, hJ⟩
  by_cases h8 : (8 : K) = 0
  · -- If `8 = 0` in `K`, then `8 ∈ I^♮`, but the counit of `8` is `8 ≠ 0`.
    have h : ((8 : ℕ) : PlaneCoordinateRing) ∈ J := by
      have h0 : (8 : K ⊗[ℤ] PlaneCoordinateRing) = 0 := by
        rw [← map_ofNat (algebraMap K (K ⊗[ℤ] PlaneCoordinateRing)) 8, h8, map_zero]
      rw [← HopfIdeal.mem_toIdeal, hJ, SchematicClosure.mem_closureIdeal, ← nsmul_one,
        TensorProduct.tmul_smul, ← Algebra.TensorProduct.one_def, nsmul_eq_mul, mul_one,
        Nat.cast_ofNat, h0]
      exact zero_mem _
    have := J.counit_eq_zero h
    rw [Bialgebra.counit_natCast] at this
    norm_num at this
  let H := CommHopfAlgCat.of ℤ PlaneCoordinateRing
  let A := CommAlgCat.of ℤ K
  have hmem : ∀ t : K, (∀ a ∈ J, linePoint t a = 0) →
      (toConv (linePoint t) : HopfAlgebra.points (R := ℤ) (H := H) A) ∈
        CommHopfAlgCat.quotientPointsSubgroup H J A := fun t ht ↦
    (CommHopfAlgCat.mem_quotientPointsSubgroup_iff H J A _).mpr ht
  have hP : ∀ a ∈ J, linePoint s a = 0 := fun a ha ↦
    linePoint_eq_zero_of_mem_closureIdeal s (hJ ▸ (HopfIdeal.mem_toIdeal.mpr ha))
  have hQ : ∀ a ∈ J, linePoint (-s) a = 0 := fun a ha ↦ by
    rw [← hσ, ← comp_linePoint, AlgHom.comp_apply, hP a ha, map_zero]
  have hmul := mul_mem (hmem s hP) (hmem (-s) hQ)
  have hq : planeY * planeY - 2 * (planeX * planeX) ∈ J := by
    rw [← HopfIdeal.mem_toIdeal, hJ]
    exact mem_closureIdeal_lineHopfIdeal hs
  have h := (CommHopfAlgCat.mem_quotientPointsSubgroup_iff H J A _).mp hmul _ hq
  have hι : ∀ v : Fin 2 → ℤ,
      (toConv (linePoint s) * toConv (linePoint (-s)) :
        WithConv (PlaneCoordinateRing →ₐ[ℤ] K)).ofConv (ι ℤ _ v) =
        linePoint s (ι ℤ _ v) + linePoint (-s) (ι ℤ _ v) := fun v ↦ by
    rw [← toAdd_pointsMulEquiv_apply, map_mul, toAdd_mul, LinearMap.add_apply,
      toAdd_pointsMulEquiv_apply, toAdd_pointsMulEquiv_apply, ofConv_toConv, ofConv_toConv]
  change (toConv (linePoint s) * toConv (linePoint (-s)) :
    WithConv (PlaneCoordinateRing →ₐ[ℤ] K)).ofConv _ = 0 at h
  rw [map_sub, map_mul, map_mul, map_mul, map_ofNat, hι, hι] at h
  simp only [linePoint_planeY, linePoint_planeX] at h
  norm_num at h
  exact h8 h

open QuadraticAlgebra in
/-- **Check: over `ℤ ⊂ ℚ(√2)` the closure of the line `y = √2 x` is not a Hopf ideal.** With
`ℚ(√2) = QuadraticAlgebra ℚ 2 0`, `√2 = ω` and the Galois conjugation `star`, the closure ideal
in `ℤ[x, y]` of the Hopf ideal `(y − √2 x)` of `ℚ(√2) ⊗_ℤ ℤ[x, y]` is not a Hopf ideal. -/
theorem not_exists_hopfIdeal_closureIdeal_sqrtTwo :
    ¬∃ J : HopfIdeal ℤ PlaneCoordinateRing,
      J.toIdeal = SchematicClosure.closureIdeal (QuadraticAlgebra ℚ 2 0)
        (lineHopfIdeal (ω : QuadraticAlgebra ℚ 2 0)).toIdeal :=
  not_exists_hopfIdeal_closureIdeal_lineHopfIdeal (by ext <;> simp) (starRingEnd _)
    (by ext <;> simp [starRingEnd_apply])

end TauCeti.AdditiveGroup.ClosureNotHopf
