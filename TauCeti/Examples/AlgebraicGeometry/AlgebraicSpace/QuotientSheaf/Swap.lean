module

public import TauCeti.AlgebraicGeometry.AlgebraicSpace.QuotientSheaf
public import TauCeti.AlgebraicGeometry.Sites.Fpqc
public import TauCeti.CategoryTheory.Sites.QuotientSheaf.Generated

/-!
# The quotient sheaf of the swap relation on `S ⊔ S`

Let `S` be a scheme and `U = S ⊔ S`, with the automorphism `swap = (coprod.braiding S S).hom`
exchanging the two copies. The pre-relation `(𝟙, swap) : U ⇉ U` relates each point of `U` to its
image under `swap`.
It is not an equivalence relation (it is not reflexive): `R = U`, and the image of
`(𝟙, swap) : R ⟶ U ×_S U` misses the diagonal points, so the criterion of Stacks, Lemma 39.20.3
(03C5) does not apply. Its quotient sheaf is still `h_S`: two points of `U` with the same image in
`S` lie, locally, in the same copy or in different copies, and are then equal or exchanged by
`swap` (`TauCeti.QuotientSheafSwapExample.relSieve_mem`).

## Main results

* `TauCeti.QuotientSheafSwapExample.quotientSheafIso`: `(S ⊔ S)/(𝟙, swap) ≅ h_S`.
* `TauCeti.QuotientSheafSwapExample.π_quotientSheafIso_hom`: the projection onto the quotient
  sheaf followed by this isomorphism is the fold map `codiag S`.
-/

public section

open CategoryTheory Limits AlgebraicGeometry TauCeti.CategoryTheory

universe u

namespace TauCeti.QuotientSheafSwapExample

variable (S : Scheme.{u})

/-- A morphism in the sieve generated by the coprojections of `S ⊔ S` factors through one of
them. -/
private theorem exists_of_mem_generate {T : Scheme.{u}} {g : T ⟶ S ⨿ S}
    (hg : Sieve.ofArrows (coprodOpenCover.{u, 0} S S).X (coprodOpenCover.{u, 0} S S).f g) :
    (∃ c : T ⟶ S, g = c ≫ coprod.inl) ∨ ∃ c : T ⟶ S, g = c ≫ coprod.inr := by
  obtain ⟨i, c, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hg
  rcases i with ⟨⟨⟩⟩ | ⟨⟨⟩⟩
  · exact Or.inl ⟨c, rfl⟩
  · exact Or.inr ⟨c, rfl⟩

/-- Two points of `S ⊔ S` with the same image in `S` are, locally, equal or exchanged by
`swap`. -/
theorem relSieve_mem {T : Scheme.{u}} (a b : T ⟶ S ⨿ S)
    (hab : a ≫ codiag S = b ≫ codiag S) :
    quotientSheaf.relSieve (𝟙 _) (coprod.braiding S S).hom a b ∈ Scheme.fppfTopology T := by
  have hcov := Scheme.zariskiTopology_le_fppfTopology _
    (coprodOpenCover.{u, 0} S S).mem_grothendieckTopology
  refine Scheme.fppfTopology.transitive (Scheme.fppfTopology.pullback_stable a hcov) _
    fun T' g hg ↦ ?_
  rw [quotientSheaf.pullback_relSieve]
  refine Scheme.fppfTopology.superset_covering ?_
    (Scheme.fppfTopology.pullback_stable (g ≫ b) hcov)
  intro T'' h hh
  have hab' : (h ≫ g ≫ a) ≫ codiag S = (h ≫ g ≫ b) ≫ codiag S := by
    simp only [Category.assoc, hab]
  -- Locally `a` and `b` each land in one copy of `S`, and `hab'` says that their components
  -- there agree. If the copies are the same, `a` and `b` agree; otherwise `swap` sends `b` to `a`.
  -- `simp` closes all four cases.
  obtain ⟨c, hc⟩ | ⟨c, hc⟩ := exists_of_mem_generate S hg <;>
    obtain ⟨d, hd⟩ | ⟨d, hd⟩ := exists_of_mem_generate S hh <;>
    rw [hc, hd] at hab' <;>
    simp only [Category.assoc, coprod.inl_desc, coprod.inr_desc, Category.comp_id] at hab' <;>
    simp [hc, hd, ← hab']

/-- **The quotient sheaf of the swap relation.** For `U = S ⊔ S` and the pre-relation
`(𝟙, swap)`, the quotient sheaf `U/R` is `h_S`, through the fold map. -/
noncomputable def quotientSheafIso :
    TauCeti.AlgebraicGeometry.Spaces.quotientSheaf (𝟙 (S ⨿ S)) (coprod.braiding S S).hom ≅
      Scheme.fppfTopology.uliftYoneda.{u + 1}.obj S :=
  quotientSheaf.isoOfRelSieveMem.{u + 1} (by ext <;> simp)
    (Sheaf.isLocallySurjective_uliftYoneda_map_of_mem (by
      refine Scheme.fppfTopology.superset_covering ?_ (Scheme.fppfTopology.top_mem S)
      intro T g _
      exact ⟨_, g ≫ coprod.inl, codiag S, ⟨⟩, by simp⟩))
    (fun _ a b hab ↦ relSieve_mem S a b hab)

/-- The projection onto the quotient sheaf of the swap relation, followed by
`quotientSheafIso S`, is the map induced by the fold map. -/
@[reassoc (attr := simp)]
theorem π_quotientSheafIso_hom :
    quotientSheaf.π Scheme.fppfTopology (𝟙 (S ⨿ S)) (coprod.braiding S S).hom ≫
        (quotientSheafIso S).hom =
      Scheme.fppfTopology.uliftYoneda.{u + 1}.map (codiag S) :=
  quotientSheaf.π_isoOfRelSieveMem_hom _ _ _

end TauCeti.QuotientSheafSwapExample
