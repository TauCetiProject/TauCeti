module

public import TauCeti.AlgebraicGeometry.AlgebraicSpace.QuotientSheaf
public import TauCeti.CategoryTheory.Sites.QuotientSheaf.Generated

/-!
# The quotient sheaf of the swap relation on `S ⊔ S`

Let `S` be a scheme and `U = S ⊔ S`, with the automorphism `swap : U ⟶ U` exchanging the two
copies. The pre-relation `(𝟙, swap) : U ⇉ U` relates each point of `U` to its image under `swap`.
It is not an equivalence relation (it is not reflexive), and `R = U ⟶ U ×_S U` misses the
diagonal points, so the criterion of Stacks, Lemma 39.20.3 (03C5) does not apply. Its quotient
sheaf is still `h_S`: two points of `U` with the same image in `S` lie, Zariski-locally, in the
same copy or in different copies, and are then equal or exchanged by `swap`
(`TauCeti.QuotientSheafSwapExample.relSieve_mem`). This is the §1.5 Check "for `U = Spec k ⊔ Spec k`
and the swap relation, `U/R ≅ h_{Spec k}`" of SchemeAndStackFoundations, for any scheme `S`.

## Main results

* `TauCeti.QuotientSheafSwapExample.quotientSheafIso`: `(S ⊔ S)/(𝟙, swap) ≅ h_S`.
* `TauCeti.QuotientSheafSwapExample.π_quotientSheafIso_hom`: the projection onto the quotient
  sheaf followed by this isomorphism is the fold map.
-/

public section

open CategoryTheory Limits AlgebraicGeometry TauCeti.CategoryTheory

universe u

namespace TauCeti.QuotientSheafSwapExample

variable (S : Scheme.{u})

/-- The automorphism of `S ⊔ S` exchanging the two copies. -/
noncomputable abbrev swap : S ⨿ S ⟶ S ⨿ S := coprod.desc coprod.inr coprod.inl

/-- The fold map `S ⊔ S ⟶ S`. -/
noncomputable abbrev fold : S ⨿ S ⟶ S := coprod.desc (𝟙 S) (𝟙 S)

/-- The fold map is invariant under `swap`. -/
theorem swap_fold : swap S ≫ fold S = 𝟙 _ ≫ fold S := by
  ext <;> simp

/-- The sieve on `S ⊔ S` generated by its two coprojections is an fppf covering. -/
theorem generate_coprod_mem :
    Sieve.ofArrows (coprodOpenCover.{u, 0} S S).X (coprodOpenCover.{u, 0} S S).f ∈
      Scheme.fppfTopology (S ⨿ S) :=
  Precoverage.generate_mem_toGrothendieck
    (Scheme.zariskiPrecoverage_le_fppfPrecoverage _ (coprodOpenCover.{u, 0} S S).mem₀)

/-- A morphism in the sieve generated by the coprojections of `S ⊔ S` factors through one of
them. -/
theorem exists_of_mem_generate {T : Scheme.{u}} {g : T ⟶ S ⨿ S}
    (hg : Sieve.ofArrows (coprodOpenCover.{u, 0} S S).X (coprodOpenCover.{u, 0} S S).f g) :
    (∃ c : T ⟶ S, g = c ≫ coprod.inl) ∨ ∃ c : T ⟶ S, g = c ≫ coprod.inr := by
  obtain ⟨i, c, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hg
  rcases i with ⟨⟨⟩⟩ | ⟨⟨⟩⟩
  · exact Or.inl ⟨c, rfl⟩
  · exact Or.inr ⟨c, rfl⟩

/-- Two points of `S ⊔ S` with the same image in `S` are, Zariski-locally, equal or exchanged by
`swap`. -/
theorem relSieve_mem {T : Scheme.{u}} (a b : T ⟶ S ⨿ S) (hab : a ≫ fold S = b ≫ fold S) :
    quotientSheaf.relSieve (𝟙 _) (swap S) a b ∈ Scheme.fppfTopology T := by
  refine Scheme.fppfTopology.transitive
    (Scheme.fppfTopology.pullback_stable a (generate_coprod_mem S)) _ fun T' g hg ↦ ?_
  refine Scheme.fppfTopology.superset_covering ?_
    (Scheme.fppfTopology.pullback_stable (g ≫ b) (generate_coprod_mem S))
  intro T'' h hh
  have hab' : (h ≫ g ≫ a) ≫ fold S = (h ≫ g ≫ b) ≫ fold S := by
    simp only [Category.assoc, hab]
  rw [Sieve.pullback_apply, quotientSheaf.mem_relSieve]
  rcases exists_of_mem_generate S hg with ⟨c, hc⟩ | ⟨c, hc⟩ <;>
    rcases exists_of_mem_generate S hh with ⟨d, hd⟩ | ⟨d, hd⟩ <;>
    rw [hc, hd] at hab' <;>
    simp only [Category.assoc, coprod.inl_desc, coprod.inr_desc, Category.comp_id] at hab' <;>
    simp only [Category.assoc, hc, hd, Category.comp_id, ← hab']
  · exact Or.inl trivial
  · exact Or.inr (Or.inl ⟨h ≫ c ≫ coprod.inr, by simp, rfl⟩)
  · exact Or.inr (Or.inl ⟨h ≫ c ≫ coprod.inl, by simp, rfl⟩)
  · exact Or.inl trivial

/-- **The quotient sheaf of the swap relation.** For `U = S ⊔ S` and the pre-relation
`(𝟙, swap)`, the quotient sheaf `U/R` is `h_S`, through the fold map. -/
noncomputable def quotientSheafIso :
    TauCeti.AlgebraicGeometry.Spaces.quotientSheaf (𝟙 (S ⨿ S)) (swap S) ≅
      Scheme.fppfTopology.uliftYoneda.{u + 1}.obj S :=
  quotientSheaf.isoOfRelSieveMem.{u + 1} (swap_fold S)
    (Sheaf.isLocallySurjective_uliftYoneda_map_of_mem (by
      refine Scheme.fppfTopology.superset_covering ?_ (Scheme.fppfTopology.top_mem S)
      intro T g _
      exact ⟨_, g ≫ coprod.inl, fold S, ⟨⟩, by simp⟩))
    (fun _ a b hab ↦ relSieve_mem S a b hab)

/-- The projection onto the quotient sheaf of the swap relation, followed by
`quotientSheafIso S`, is the map induced by the fold map. -/
@[reassoc (attr := simp)]
theorem π_quotientSheafIso_hom :
    quotientSheaf.π Scheme.fppfTopology (𝟙 (S ⨿ S)) (swap S) ≫ (quotientSheafIso S).hom =
      Scheme.fppfTopology.uliftYoneda.{u + 1}.map (fold S) :=
  quotientSheaf.π_isoOfRelSieveMem_hom _ _ _

end TauCeti.QuotientSheafSwapExample
