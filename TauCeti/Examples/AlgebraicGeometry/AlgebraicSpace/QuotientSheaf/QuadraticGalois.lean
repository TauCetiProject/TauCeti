module

public import TauCeti.AlgebraicGeometry.AlgebraicSpace.QuotientSheaf.Torsor
public import TauCeti.Examples.AlgebraicGeometry.AlgebraicSpace.QuotientSheaf.FieldExtension

/-!
# The quotient sheaf of the relation generated by a quadratic Galois automorphism

Let `L / K` be a quadratic Galois extension and `σ` the nontrivial element of `Gal(L / K)`, so that
`specComap L Gal(L/K) σ` is the nontrivial automorphism of `Spec L` over `Spec K`. The pre-relation
`(𝟙, σ) : Spec L ⇉ Spec L` generates the kernel pair of `Spec L ⟶ Spec K`, and its quotient sheaf
is `h_{Spec K}` (`TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.torsorIso`). So the quotient sheaf
has a section over `Spec K` lying over the identity of `Spec K`, although `Spec L` has no `K`-point
over `Spec K`; the presheaf quotient `T ↦ U(T)/R(T)` has no such section and is not an fppf sheaf.

## Main results

* `TauCeti.QuotientSheafQuadraticGaloisExample.quotientSheafIso`: `Spec L/(𝟙, σ) ≅ h_{Spec K}`.
* `TauCeti.QuotientSheafQuadraticGaloisExample.exists_section`: the quotient sheaf has a section
  over `Spec K` lying over the identity.
* `TauCeti.QuotientSheafQuadraticGaloisExample.not_isSheaf`: the presheaf quotient of `(𝟙, σ)` is
  not an fppf sheaf, since `Spec L` has no `K`-point over `Spec K`
  (`TauCeti.QuotientSheafFieldExtensionExample.not_exists_comp_eq_id`).
-/

public section

open CategoryTheory Limits Opposite AlgebraicGeometry TauCeti.CategoryTheory
  TauCeti.AlgebraicGeometry TauCeti.AffineInvariantQuotient

universe u

namespace TauCeti.QuotientSheafQuadraticGaloisExample

variable {K L : Type u} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]

/-- In a quadratic Galois extension, every element of the Galois group is `1` or the nontrivial
element `σ`. -/
theorem eq_one_or_eq (hL : Module.finrank K L = 2) {σ : Gal(L/K)} (hσ : σ ≠ 1) (g : Gal(L/K)) :
    g = 1 ∨ g = σ ∨ g = σ⁻¹ := by
  have hcard : Nat.card Gal(L/K) = 2 := by
    rw [IsGalois.card_aut_eq_finrank, hL]
  obtain ⟨y, -, hy⟩ := (Nat.card_eq_two_iff' (1 : Gal(L/K))).1 hcard
  by_cases hg : g = 1
  · exact Or.inl hg
  · exact Or.inr (Or.inl ((hy g hg).trans (hy σ hσ).symm))

/-- **The quotient sheaf of a quadratic Galois automorphism.** For `L / K` quadratic Galois with
nontrivial automorphism `σ`, the quotient sheaf of the pre-relation `(𝟙, σ)` on `Spec L` is
`h_{Spec K}`. -/
noncomputable def quotientSheafIso (hL : Module.finrank K L = 2) {σ : Gal(L/K)} (hσ : σ ≠ 1) :
    Spaces.quotientSheaf (𝟙 (Spec (.of L))) (specComap L Gal(L/K) σ) ≅
      Scheme.fppfTopology.uliftYoneda.{u + 1}.obj (Spec (.of K)) :=
  Spaces.quotientSheaf.torsorIso σ (eq_one_or_eq hL hσ)

/-- The quotient sheaf of `(𝟙, σ)` has a section over `Spec K` lying over the identity of
`Spec K`: the image of the identity under the inverse of `quotientSheafIso`. -/
theorem exists_section (hL : Module.finrank K L = 2) {σ : Gal(L/K)} (hσ : σ ≠ 1) :
    ∃ x : (Spaces.quotientSheaf (𝟙 (Spec (.of L))) (specComap L Gal(L/K) σ)).obj.obj
        (op (Spec (.of K))),
      ConcreteCategory.hom ((quotientSheafIso hL hσ).hom.hom.app _) x =
        Scheme.fppfTopology.uliftYonedaEquiv (𝟙 _) :=
  ⟨Scheme.fppfTopology.uliftYonedaEquiv (quotientSheafIso hL hσ).inv, by
    rw [← GrothendieckTopology.uliftYonedaEquiv_comp, Iso.inv_hom_id]⟩

/-- **The presheaf quotient is not a sheaf.** For `L / K` quadratic Galois with nontrivial
automorphism `σ`, the presheaf quotient of the pre-relation `(𝟙, σ)` on `Spec L` is not an fppf
sheaf: otherwise it would be its sheafification, the quotient sheaf, which is `h_{Spec K}`, and
`Spec L` would have a `K`-point over `Spec K`. -/
theorem not_isSheaf (hL : Module.finrank K L = 2) {σ : Gal(L/K)} (hσ : σ ≠ 1) :
    ¬ Presheaf.IsSheaf Scheme.fppfTopology
      (quotientPresheaf (𝟙 (Spec (.of L))) (specComap L Gal(L/K) σ) ⋙
        uliftFunctor.{u + 1}) := by
  intro hP
  have := (quotientSheafIso hL hσ).isIso_hom
  rw [quotientSheafIso, Spaces.quotientSheaf.torsorIso_hom] at this
  exact QuotientSheafFieldExtensionExample.not_exists_comp_eq_id (K := K)
    (by rw [← Module.finrank_eq_rank, hL]; norm_num)
    (quotientSheaf.exists_comp_eq_id_of_isSheaf.{u + 1} (by simp) hP)

end TauCeti.QuotientSheafQuadraticGaloisExample
