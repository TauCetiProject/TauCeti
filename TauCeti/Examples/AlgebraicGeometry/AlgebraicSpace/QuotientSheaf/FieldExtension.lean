module

public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import TauCeti.AlgebraicGeometry.AlgebraicSpace.QuotientSheaf.Represented

/-!
# The presheaf quotient of a field extension is not a sheaf

Let `L / K` be a finite field extension of degree greater than one, and `q : Spec L ⟶ Spec K` the
induced morphism, an fppf covering. The quotient sheaf of the kernel pair
`R = Spec L ×_{Spec K} Spec L ⇉ Spec L` is `h_{Spec K}`
(`TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.kernelPairIso`, Stacks, Lemma 39.20.3 (03C5)), so
it has a section over `Spec K` lying over the identity of `Spec K`. The presheaf quotient
`T ↦ U(T)/R(T)` has no such section: it would be the class of a morphism `Spec K ⟶ Spec L` over
`Spec K`, that is of a `K`-algebra map `L →ₐ[K] K`, which is injective and so forces
`[L : K] ≤ 1`. Hence the presheaf quotient is not an fppf sheaf.

For `L / K` quadratic Galois with nontrivial automorphism `σ`, `R` is the equivalence relation
generated by `σ`: `Spec L` has no `K`-point over `K`, but the quotient sheaf of the relation
generated by `σ` has one. The statement here needs no Galois hypothesis.

## Main results

* `TauCeti.QuotientSheafFieldExtensionExample.not_exists_comp_eq_id`: `Spec L` has no
  `K`-point over `Spec K`.
* `TauCeti.QuotientSheafFieldExtensionExample.exists_section`: the quotient sheaf has a section
  over `Spec K` lying over the identity.
* `TauCeti.QuotientSheafFieldExtensionExample.not_isSheaf`: the presheaf quotient is not an fppf
  sheaf, by `TauCeti.CategoryTheory.quotientSheaf.exists_comp_eq_id_of_isSheaf`.
-/

public section

open CategoryTheory Limits Opposite AlgebraicGeometry TauCeti.CategoryTheory
  TauCeti.AlgebraicGeometry

universe u

namespace TauCeti.QuotientSheafFieldExtensionExample

variable (K L : Type u) [Field K] [Field L] [Algebra K L]

/-- The morphism `Spec L ⟶ Spec K` of a field extension. -/
noncomputable abbrev q : Spec (.of L) ⟶ Spec (.of K) :=
  Spec.map (CommRingCat.ofHom (algebraMap K L))

instance surjective_q : Surjective (q K L) :=
  ((flat_and_surjective_SpecMap_iff _).mpr
    (RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance)).2

instance locallyOfFinitePresentation_q [FiniteDimensional K L] :
    LocallyOfFinitePresentation (q K L) := by
  have := Algebra.FinitePresentation.of_finiteType.mp (inferInstance : Algebra.FiniteType K L)
  exact locallyOfFinitePresentation_SpecMap_algebraMap K L

variable {K L}

/-- **`Spec L` has no `K`-point over `Spec K`** for an extension of degree greater than one: a
section `Spec K ⟶ Spec L` of `q` is `Spec` of a `K`-algebra map `L ⟶ K`, which is injective. -/
theorem not_exists_comp_eq_id (hL : 1 < Module.rank K L) :
    ¬ ∃ a : Spec (.of K) ⟶ Spec (.of L), a ≫ q K L = 𝟙 _ := by
  rintro ⟨a, ha⟩
  obtain ⟨φ, rfl⟩ := Spec.map_surjective a
  have hφ : CommRingCat.ofHom (algebraMap K L) ≫ φ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, ha, Spec.map_id]
  have hk (k : K) : φ.hom (algebraMap K L k) = k := by
    simpa using congrArg (fun f ↦ f.hom k) hφ
  let ψ : L →ₗ[K] K :=
    { toFun := φ.hom
      map_add' := map_add φ.hom
      map_smul' := fun k x ↦ by simp [Algebra.smul_def, hk] }
  exact ((LinearMap.rank_le_of_injective ψ φ.hom.injective).trans_eq
    (Module.rank_self K)).not_gt hL

variable [FiniteDimensional K L]

/-- The quotient sheaf of the kernel pair of `Spec L ⟶ Spec K` has a section over `Spec K` lying
over the identity of `Spec K`, the image of the identity under the inverse of `h_{Spec K} ≅ U/R`.
-/
theorem exists_section :
    ∃ x : (Spaces.quotientSheaf (pullback.snd (q K L) (q K L))
        (pullback.fst (q K L) (q K L))).obj.obj (op (Spec (.of K))),
      ConcreteCategory.hom ((Spaces.quotientSheaf.kernelPairIso (q K L)).hom.hom.app _) x =
        Scheme.fppfTopology.uliftYonedaEquiv (𝟙 _) :=
  ⟨Scheme.fppfTopology.uliftYonedaEquiv (Spaces.quotientSheaf.kernelPairIso (q K L)).inv, by
    rw [← GrothendieckTopology.uliftYonedaEquiv_comp, Iso.inv_hom_id]⟩

/-- **The presheaf quotient is not a sheaf.** For a finite extension `L / K` of degree greater
than one, the presheaf quotient of the kernel pair of `Spec L ⟶ Spec K` is not an fppf sheaf:
otherwise it would be its sheafification, the quotient sheaf, which is `h_{Spec K}` and has the
identity of `Spec K` as a section. -/
theorem not_isSheaf (hL : 1 < Module.finrank K L) :
    ¬ Presheaf.IsSheaf Scheme.fppfTopology
      (quotientPresheaf (pullback.snd (q K L) (q K L)) (pullback.fst (q K L) (q K L)) ⋙
        uliftFunctor.{u + 1}) := fun hP ↦
  not_exists_comp_eq_id (by rw [← Module.finrank_eq_rank]; exact_mod_cast hL)
    (quotientSheaf.exists_comp_eq_id_of_isSheaf.{u + 1} pullback.condition hP)

end TauCeti.QuotientSheafFieldExtensionExample
