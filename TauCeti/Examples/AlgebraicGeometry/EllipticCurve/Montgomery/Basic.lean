/-!
# Examples of the monic Montgomery model

The monic model `y'² = x'³ + AB x'² + B² x'` of `B y² = x³ + A x² + x` has discriminant
`16 B⁶ (A² - 4)`: it is elliptic for `(A, B) = (0, 1)` over `ℚ`, and singular both for
`(A, B) = (2, 1)`, where `(-1, 0)` is a singular point, and for `B = 0`. The coefficients of
`model 3 2` are `(0, 6, 0, 4, 0)`, and `model 3 2 = model (-3) (-2)`. Over `𝔽₇` the Montgomery
point `(1, 1)` of `2 y² = x³ + x` corresponds to the point `(2, 4)` of `model 0 2`; at `B = 0`
the correspondence of `equation_model_iff` fails.

The curve `y² = x³ + x`, the model with `(A, B) = (0, 1)`, is the running example for scalar
multiples and detection. Over `𝔽₇` its native group has `8` elements and is cyclic, generated by
`(3, 3)`; the order of `(3, 3)` is computed with the doubling formula rather than with the group
law. Over `𝔽₅` it has `4` elements, every point is its own negative, so the group is not cyclic
and the projective `x`-coordinate is injective on it.

## References

* P. L. Montgomery, *Speeding the Pollard and elliptic curve methods of factorization*,
  Math. Comp. 48 (1987), 243–264, §10.3.1: the curve `B y² = x³ + A x² + x`.
-/

public section

namespace TauCeti.Montgomery

open WeierstrassCurve

/-! ### Discriminants, coefficients and the Montgomery equation -/

-- `(A, B) = (0, 1)` over `ℚ`: the discriminant is `16 · 1 · (0 - 4) = -64`.
example : (model (0 : ℚ) 1).Δ = -64 := by
  norm_num

example : (model (0 : ℚ) 1).IsElliptic :=
  isElliptic_model_iff_ne_zero.mpr ⟨two_ne_zero, one_ne_zero, by norm_num⟩

-- `(A, B) = (2, 1)` and `(A, B) = (0, 0)` give singular models.
example : (model (2 : ℚ) 1).Δ = 0 ∧ (model (0 : ℚ) 0).Δ = 0 := by
  norm_num

-- The cubic `x (x + 1)²` has the singular point `(-1, 0)`: by `nonsingular_model_iff`, the
-- singular point `(-1, 0)` of `y² = x³ + 2 x² + x` goes to a singular point of `model 2 1`.
example : (model (2 : ℚ) 1).toAffine.Equation (-1) 0 ∧
    ¬ (model (2 : ℚ) 1).toAffine.Nonsingular (-1) 0 := by
  have h := nonsingular_model_iff (A := (2 : ℚ)) one_ne_zero (-1) 0
  have e := equation_model_iff (A := (2 : ℚ)) one_ne_zero (-1) 0
  norm_num at h e
  exact ⟨e, h⟩

-- The coefficients of `model 3 2` are `(0, 6, 0, 4, 0)`, not the `(0, 3, 0, 1, 0)` of
-- `y² = x³ + 3 x² + x`.
example : (model (3 : ℚ) 2).a₁ = 0 ∧ (model (3 : ℚ) 2).a₂ = 6 ∧ (model (3 : ℚ) 2).a₃ = 0 ∧
    (model (3 : ℚ) 2).a₄ = 4 ∧ (model (3 : ℚ) 2).a₆ = 0 := by
  norm_num

-- Being singular, `model 2 1` is not elliptic.
example : ¬ (model (2 : ℚ) 1).IsElliptic := by
  rw [isElliptic_model_iff_ne_zero]
  norm_num

-- The model only depends on `(A, B)` up to the simultaneous sign change.
example : model (3 : ℚ) 2 = model (-3) (-2) :=
  (model_eq_model_iff_of_ne_zero two_ne_zero).mpr (.inr ⟨rfl, rfl⟩)

-- At `B = 0` every `(x, y)` goes to `(0, 0)`, which lies on the model, while `(1, 0)` does not
-- satisfy the Montgomery equation `0 = 1 + 0 + 1` over `ℚ`.
example : (model (0 : ℚ) 0).toAffine.Equation (0 * 1) (0 ^ 2 * 0) ∧
    ¬ (0 : ℚ) * 0 ^ 2 = 1 ^ 3 + 0 * 1 ^ 2 + 1 := by
  refine ⟨?_, by norm_num⟩
  rw [Affine.equation_iff]
  norm_num

/-! ### Point counts over prime fields -/

-- Over `𝔽_p` the native points of `y² = x³ + x` are infinity and the affine solutions.
private theorem card_point_model_zero_one (p : ℕ) [Fact p.Prime]
    [(model (0 : ZMod p) 1).IsElliptic] :
    Nat.card (model (0 : ZMod p) 1).toAffine.Point =
      Fintype.card {xy : ZMod p × ZMod p // xy.2 ^ 2 = xy.1 ^ 3 + xy.1} + 1 := by
  rw [← pointCount_eq_card_point, pointCount_def,
    Nat.card_congr (Equiv.subtypeEquivRight
      (q := fun xy : ZMod p × ZMod p ↦ xy.2 ^ 2 = xy.1 ^ 3 + xy.1)
      fun xy ↦ by rw [Affine.equation_iff]; simp),
    Nat.card_eq_fintype_card]

/-! ### The running example `y² = x³ + x` over `𝔽₇` -/

section Seven

local instance : Fact (Nat.Prime 7) := ⟨by decide⟩

-- Over `𝔽₇`, the Montgomery point `(1, 1)` of `2 y² = x³ + x` goes to the point `(2, 4)`.
example : (model (0 : ZMod 7) 2).toAffine.Equation 2 4 := by
  have h := (equation_model_iff (A := (0 : ZMod 7)) (B := 2) (by decide) 1 1).mpr (by decide)
  norm_num at h
  exact h

local instance : (model (0 : ZMod 7) 1).IsElliptic :=
  isElliptic_model_iff_ne_zero.mpr ⟨by decide, by decide, by decide⟩

-- The native group has `8` elements: infinity and the seven affine solutions `(0, 0)`,
-- `(1, ±3)`, `(3, ±3)` and `(5, ±2)`.
private theorem card_point_seven : Nat.card (model (0 : ZMod 7) 1).toAffine.Point = 8 := by
  rw [card_point_model_zero_one]
  decide

example : Nat.card (model (0 : ZMod 7) 1).toAffine.Point = 8 :=
  card_point_seven

private theorem nonsingular_three_three : (model (0 : ZMod 7) 1).toAffine.Nonsingular 3 3 := by
  simp only [Affine.nonsingular_iff, Affine.equation_iff, model_a₁, model_a₂, model_a₃,
    model_a₄, model_a₆]
  decide

private noncomputable def generatorSeven : (model (0 : ZMod 7) 1).toAffine.Point :=
  .some 3 3 nonsingular_three_three

-- Doubling `(3, 1)` twice with `(N, D) = (2, 4)` gives `(0, 2)`, which does not represent
-- infinity, so `[4](3, 3) ≠ 0`.
private theorem four_nsmul_generatorSeven_ne_zero : (4 : ℕ) • generatorSeven ≠ 0 := by
  have hD : (4 : ZMod 7) ≠ 0 := by decide
  have hND : 4 * (2 : ZMod 7) = (0 + 2) * 4 := by decide
  obtain ⟨h₁, h₂⟩ := double_coordinates one_ne_zero hD hND generatorSeven
  have h₄ := (double_coordinates_of_cross_eq_zero one_ne_zero hD hND h₁ h₂).2
  intro h
  rw [← two_nsmul, ← two_nsmul, ← mul_nsmul, h, coordinates_zero] at h₄
  simp only [generatorSeven, coordinates_some, Pair.cross_def, double_x, double_z] at h₄
  revert h₄
  decide

-- The point `(3, 3)` has order `8`.
private theorem addOrderOf_generatorSeven : addOrderOf generatorSeven = 8 :=
  addOrderOf_eq_prime_pow (p := 2) (n := 2) four_nsmul_generatorSeven_ne_zero
    (by rw [show 2 ^ (2 + 1) = 8 from rfl, ← card_point_seven]; exact card_nsmul_eq_zero')

example : addOrderOf generatorSeven = 8 :=
  addOrderOf_generatorSeven

-- The multiples of `(3, 3)` exhaust the native group over `𝔽₇`.
example : AddSubgroup.zmultiples generatorSeven = ⊤ := by
  have : Finite (model (0 : ZMod 7) 1).toAffine.Point :=
    Nat.finite_of_card_ne_zero (by rw [card_point_seven]; decide)
  exact AddSubgroup.eq_top_of_card_eq _ <| by
    rw [Nat.card_zmultiples, addOrderOf_generatorSeven, card_point_seven]

-- The native group over `𝔽₇` is cyclic, generated by `(3, 3)`.
example : IsAddCyclic (model (0 : ZMod 7) 1).toAffine.Point := by
  have : Finite (model (0 : ZMod 7) 1).toAffine.Point :=
    Nat.finite_of_card_ne_zero (by rw [card_point_seven]; decide)
  exact isAddCyclic_of_addOrderOf_eq_card generatorSeven
    (by rw [addOrderOf_generatorSeven, card_point_seven])

end Seven

/-! ### The running example `y² = x³ + x` over `𝔽₅` -/

section Five

local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

local instance : (model (0 : ZMod 5) 1).IsElliptic :=
  isElliptic_model_iff_ne_zero.mpr ⟨by decide, by decide, by decide⟩

-- The native group has `4` elements: `model 0 1` is `WorkedExamples.curveX3AddX`, whose
-- point count is `WorkedExamples.pointCount_curveX3AddX`.
private theorem card_point_five : Nat.card (model (0 : ZMod 5) 1).toAffine.Point = 4 := by
  have h : model (0 : ZMod 5) 1 = WorkedExamples.curveX3AddX := by
    ext <;> simp
  rw [← pointCount_eq_card_point, h]
  exact WorkedExamples.pointCount_curveX3AddX

example : Nat.card (model (0 : ZMod 5) 1).toAffine.Point = 4 :=
  card_point_five

-- Every affine point has `y = 0`, so every native point is its own negative.
private theorem neg_eq_self_five (P : (model (0 : ZMod 5) 1).toAffine.Point) : -P = P := by
  rcases P with _ | ⟨x, y, h⟩
  · simp [← Affine.Point.zero_def]
  have hy : y = 0 := by
    have e := (Affine.equation_iff ..).mp h.1
    simp only [model_a₁, model_a₂, model_a₃, model_a₄, model_a₆] at e
    clear h
    revert x y
    decide
  subst hy
  simp [Affine.Point.neg_some, Affine.negY]

-- The native group over `𝔽₅` has exponent `2` and `4` elements, so it is `(ℤ/2)²` and not cyclic.
example : ¬ IsAddCyclic (model (0 : ZMod 5) 1).toAffine.Point := by
  intro _
  obtain ⟨g, hg⟩ := IsAddCyclic.exists_ofOrder_eq_natCard
    (α := (model (0 : ZMod 5) 1).toAffine.Point)
  have h₂ : addOrderOf g ∣ 2 :=
    addOrderOf_dvd_of_nsmul_eq_zero (by
      rw [two_nsmul]
      nth_rewrite 1 [← neg_eq_self_five g]
      exact neg_add_cancel g)
  rw [hg, card_point_five] at h₂
  norm_num at h₂

-- Every fibre of the projective `x`-coordinate has at most one point: `(1 : 0)`, `(0 : 1)`,
-- `(2 : 1)` and `(3 : 1)` each come from exactly one native point, the others from none.
example : Function.Injective (projectiveX (0 : ZMod 5) (one_ne_zero : (1 : ZMod 5) ≠ 0)) :=
  fun _ Q h ↦ ((projectiveX_eq_projectiveX_iff _).mp h).elim id
    fun h ↦ h.trans (neg_eq_self_five Q)

end Five

end TauCeti.Montgomery
