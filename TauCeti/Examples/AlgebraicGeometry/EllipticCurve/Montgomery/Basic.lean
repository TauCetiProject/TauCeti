module

public import TauCeti.AlgebraicGeometry.EllipticCurve.Montgomery.Basic
import TauCeti.AlgebraicGeometry.EllipticCurve.PointCount
import Mathlib.Algebra.Field.ZMod
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Examples of the monic Montgomery model

Over `ℚ`, the model with `(A, B) = (0, 1)` has discriminant `16 · 1 · (0 - 4) = -64` and is
elliptic, while `(A, B) = (2, 1)` and `(A, B) = (0, 0)` have discriminant `0`; for `(2, 1)` the
cubic is `x (x + 1)²` and `(-1, 0)` is a singular point. The coefficients of `model 3 2` are
`(0, 6, 0, 4, 0)`, and `model 3 2 = model (-3) (-2)`.

The running examples are `y² = x³ + x` over `𝔽₇` and over `𝔽₅`. Over `𝔽₇` the native group has
eight elements and is cyclic, generated by `(3, 3)`: twice `(3, 3)` is `(1, 4)`, and twice `(1, 4)`
is the distinguished point of order two `(0, 0)`. Over `𝔽₅` it has four elements, infinity and the
three affine points `(0, 0)`, `(2, 0)`, `(3, 0)` of order two, so it is not cyclic.

The substitution `(x, y) ↦ (B x, B² y)` sends the point `(1, 1)` of `2 y² = x³ + x` over `𝔽₇`
to the point `(2, 4)` of `model 0 2`. At `B = 0` the substitution sends everything to `(0, 0)`,
which lies on the degenerate model even when the source point does not lie on the Montgomery
curve. It sends the singular point `(-1, 0)` of `y² = x³ + 2 x² + x` to a singular point of
`model 2 1`.
-/

public section

namespace TauCeti.Montgomery

open WeierstrassCurve

local instance basicPrimeFive : Fact (Nat.Prime 5) := ⟨by decide⟩
local instance basicPrimeSeven : Fact (Nat.Prime 7) := ⟨by decide⟩

/-! ### Discriminants and coefficients over `ℚ` -/

-- `(A, B) = (0, 1)`: the discriminant is `-64`, not `+64`, and the model is elliptic.
example : (model (0 : ℚ) 1).Δ = -64 := by
  rw [model_Δ]
  norm_num

example : (model (0 : ℚ) 1).IsElliptic :=
  isElliptic_model_iff_ne_zero.mpr ⟨two_ne_zero, one_ne_zero, by norm_num⟩

-- `(A, B) = (2, 1)`: the discriminant vanishes and `(-1, 0)` is a singular point of the model.
example : (model (2 : ℚ) 1).Δ = 0 := by
  rw [model_Δ]
  norm_num

example : ¬ (model (2 : ℚ) 1).IsElliptic := by
  rw [isElliptic_model_iff_ne_zero]
  norm_num

example : (model (2 : ℚ) 1).toAffine.Equation (-1) 0 ∧
    ¬ (model (2 : ℚ) 1).toAffine.Nonsingular (-1) 0 := by
  simp only [Affine.nonsingular_iff, Affine.equation_iff, model_a₁, model_a₂, model_a₃,
    model_a₄, model_a₆]
  norm_num

-- `(A, B) = (0, 0)`: the discriminant vanishes because `B = 0`.
example : (model (0 : ℚ) 0).Δ = 0 := by
  rw [model_Δ]
  norm_num

-- The coefficients of `model 3 2` are `(0, 6, 0, 4, 0)`; the naive `x' = x` would give `a₂ = 3`.
example : model (3 : ℚ) 2 = ⟨0, 6, 0, 4, 0⟩ := by
  ext <;> norm_num

example : model (3 : ℚ) 2 = model (-3) (-2) :=
  (model_eq_model_iff_of_ne_zero two_ne_zero).mpr (.inr ⟨rfl, rfl⟩)

/-! ### The running example over `𝔽₇` -/

private theorem card_point_seven : Nat.card (model (0 : ZMod 7) 1).toAffine.Point = 8 := by
  have : (model (0 : ZMod 7) 1).IsElliptic :=
    isElliptic_model_iff_ne_zero.mpr ⟨by decide, one_ne_zero, by decide⟩
  rw [← pointCount_eq_card_point, pointCount_def, Nat.card_congr (Equiv.subtypeEquivRight
    (q := fun P : ZMod 7 × ZMod 7 ↦ P.2 ^ 2 = P.1 ^ 3 + P.1) fun P ↦ by
      rw [Affine.equation_iff]; simp), Nat.card_eq_fintype_card]
  decide

-- Over `𝔽₇` with `(A, B) = (0, 1)` the native group has eight elements.
example : Nat.card (model (0 : ZMod 7) 1).toAffine.Point = 8 := card_point_seven

private theorem nonsingular_three_three : (model (0 : ZMod 7) 1).toAffine.Nonsingular 3 3 := by
  simp only [Affine.nonsingular_iff, Affine.equation_iff, model_a₁, model_a₂, model_a₃,
    model_a₄, model_a₆]
  decide

private theorem nonsingular_one_four : (model (0 : ZMod 7) 1).toAffine.Nonsingular 1 4 := by
  simp only [Affine.nonsingular_iff, Affine.equation_iff, model_a₁, model_a₂, model_a₃,
    model_a₄, model_a₆]
  decide

private theorem two_nsmul_three_three :
    (2 : ℕ) • (Affine.Point.some 3 3 nonsingular_three_three) = .some 1 4 nonsingular_one_four := by
  have hy : (3 : ZMod 7) ≠ (model (0 : ZMod 7) 1).toAffine.negY 3 3 := by
    simp only [Affine.negY, model_a₁, model_a₃]
    decide
  have hslope : (model (0 : ZMod 7) 1).toAffine.slope 3 3 3 3 = 0 := by
    rw [Affine.slope_of_Y_ne rfl hy]
    simp only [model_a₁, model_a₂, model_a₄]
    rw [div_eq_zero_iff]
    left
    decide
  rw [two_nsmul, Affine.Point.add_self_of_Y_ne hy, Affine.Point.some.injEq, hslope]
  simp only [Affine.addY, Affine.negAddY, Affine.addX, Affine.negY, model_a₁, model_a₂, model_a₃]
  decide

private theorem addOrderOf_three_three :
    addOrderOf (Affine.Point.some 3 3 nonsingular_three_three) = 8 := by
  have h4 : (4 : ℕ) • (Affine.Point.some 3 3 nonsingular_three_three) =
      twoTorsionPoint 0 one_ne_zero := by
    rw [show (4 : ℕ) = 2 * 2 from rfl, mul_nsmul, two_nsmul_three_three, two_nsmul,
      add_self_eq_twoTorsionPoint_iff one_ne_zero]
  refine addOrderOf_eq_prime_pow (p := 2) (n := 2) ?_ ?_
  · rw [show 2 ^ 2 = 4 from rfl, h4]
    exact twoTorsionPoint_ne_zero 0 one_ne_zero
  · rw [show 2 ^ (2 + 1) = 4 * 2 from rfl, mul_nsmul, h4, two_nsmul, twoTorsionPoint_add_self]

-- The point `(3, 3)` has order eight and generates the native group, which is therefore cyclic.
example : addOrderOf (Affine.Point.some 3 3 nonsingular_three_three) = 8 := addOrderOf_three_three

private theorem finite_point_seven : Finite (model (0 : ZMod 7) 1).toAffine.Point :=
  Nat.finite_of_card_ne_zero (by rw [card_point_seven]; decide)

example : AddSubgroup.zmultiples (Affine.Point.some 3 3 nonsingular_three_three) = ⊤ := by
  have := finite_point_seven
  exact AddSubgroup.eq_top_of_card_eq _ <| by
    rw [Nat.card_zmultiples, addOrderOf_three_three, card_point_seven]

example : IsAddCyclic (model (0 : ZMod 7) 1).toAffine.Point := by
  have := finite_point_seven
  exact isAddCyclic_of_addOrderOf_eq_card _ (addOrderOf_three_three.trans card_point_seven.symm)

/-! ### The running example over `𝔽₅` -/

private theorem card_point_five : Nat.card (model (0 : ZMod 5) 1).toAffine.Point = 4 := by
  have : (model (0 : ZMod 5) 1).IsElliptic :=
    isElliptic_model_iff_ne_zero.mpr ⟨by decide, one_ne_zero, by decide⟩
  rw [← pointCount_eq_card_point, pointCount_def, Nat.card_congr (Equiv.subtypeEquivRight
    (q := fun P : ZMod 5 × ZMod 5 ↦ P.2 ^ 2 = P.1 ^ 3 + P.1) fun P ↦ by
      rw [Affine.equation_iff]; simp), Nat.card_eq_fintype_card]
  decide

-- Over `𝔽₅` with `(A, B) = (0, 1)` the native group has four elements.
example : Nat.card (model (0 : ZMod 5) 1).toAffine.Point = 4 := card_point_five

private theorem add_self_five (P : (model (0 : ZMod 5) 1).toAffine.Point) : P + P = 0 := by
  rcases P with _ | ⟨x, y, h⟩
  · exact add_zero _
  · refine Affine.Point.add_self_of_Y_eq ?_
    have hy : ∀ x y : ZMod 5, y ^ 2 = x ^ 3 + x → y = 0 := by decide
    have e : y ^ 2 = x ^ 3 + x := by simpa [Affine.equation_iff] using h.1
    simp [Affine.negY, hy x y e]

-- Every native point over `𝔽₅` is killed by `2`, so the group of order four is `(ℤ/2)²`.
example (P : (model (0 : ZMod 5) 1).toAffine.Point) : P + P = 0 := add_self_five P

example : ¬ IsAddCyclic (model (0 : ZMod 5) 1).toAffine.Point := by
  intro hcyc
  have : Finite (model (0 : ZMod 5) 1).toAffine.Point :=
    Nat.finite_of_card_ne_zero (by rw [card_point_five]; decide)
  obtain ⟨g, hg⟩ :=
    IsAddCyclic.exists_ofOrder_eq_natCard (α := (model (0 : ZMod 5) 1).toAffine.Point)
  have h2 : addOrderOf g ∣ 2 := addOrderOf_dvd_of_nsmul_eq_zero (by rw [two_nsmul, add_self_five])
  rw [hg, card_point_five] at h2
  exact absurd h2 (by decide)

/-! ### The Montgomery equation and the monic model -/

-- Over `𝔽₇` with `(A, B) = (0, 2)`: `(1, 1)` lies on `2 y² = x³ + x` and goes to `(2, 4)`.
example : (model (0 : ZMod 7) 2).toAffine.Equation 2 4 := by
  have h := (equation_model_iff (A := (0 : ZMod 7)) (B := 2) (by decide) 1 1).mpr (by decide)
  norm_num at h
  exact h

-- The correspondence fails at `B = 0`: the substitution sends `(1, 0)` to `(0, 0)`, which lies on
-- the model, although `(1, 0)` does not satisfy `0 · y² = x³ + x`.
example : ¬ ((model (0 : ℚ) 0).toAffine.Equation (0 * 1) (0 ^ 2 * 0) ↔
    (0 : ℚ) * 0 ^ 2 = 1 ^ 3 + 0 * 1 ^ 2 + 1) := by
  simp only [Affine.equation_iff, model_a₁, model_a₂, model_a₃, model_a₄, model_a₆]
  norm_num

-- The singular point `(-1, 0)` of `y² = x³ + 2 x² + x` goes to a singular point of `model 2 1`.
example : ¬ (model (2 : ℚ) 1).toAffine.Nonsingular (1 * -1) (1 ^ 2 * 0) := by
  rw [nonsingular_model_iff one_ne_zero]
  norm_num

end TauCeti.Montgomery
