module

public import TauCeti.AlgebraicGeometry.EllipticCurve.Montgomery.Double
public import TauCeti.AlgebraicGeometry.EllipticCurve.PointCount
public import Mathlib.Algebra.Field.ZMod
import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.Frobenius.WorkedExamples

/-!
# Examples of the monic Montgomery model

The discriminant `16 B⁶ (A² - 4)` of `model A B` is `-64` at `(A, B) = (0, 1)`, and vanishes at
`(2, 1)`, where the cubic is `x (x + 1)²` with the singular point `(-1, 0)`, and at `(0, 0)`.
The coefficients of `model 3 2` are `(0, 6, 0, 4, 0)`: the substitution `x' = B x`, `y' = B² y`
cannot be replaced by `x' = x`, which would give `y² = x³ + 3 x² + x`. Over `𝔽₇` the point
`(2, 2)` of `2 y² = x³ + 3 x² + x` lies on `model 3 2` after the substitution, but not on that
naive curve.

The comparison with the Montgomery equation needs `B ≠ 0`: at `B = 0` every point is sent to
`(0, 0)`, which lies on the model. It also reflects singularity: the singular point `(-1, 0)` of
`y² = x³ + 2 x² + x` goes to a singular point of `model 2 1`.

The running examples are the curve `y² = x³ + x`, the model with `(A, B) = (0, 1)`. Over `𝔽₇` its
native group has `8` elements and is cyclic, generated by `(3, 3)`: two Montgomery doublings
of `(3 : 1)` reach `(0 : 2)`, the projective `x`-coordinate of the distinguished point of order
two, so `[4](3, 3) = (0, 0)`. Over `𝔽₅` it has `4` elements, all killed by `2` because every
affine solution has `y = 0`: its three affine points `(0, 0)`, `(2, 0)`, `(3, 0)` have order two,
and the group is not cyclic.
-/

public section

namespace TauCeti.Montgomery

open WeierstrassCurve

local instance basicPrimeFive : Fact (Nat.Prime 5) := ⟨by decide⟩
local instance basicPrimeSeven : Fact (Nat.Prime 7) := ⟨by decide⟩

/-! ### Discriminants and coefficients -/

-- A sign error in `A² - 4` would give `+64`.
example : (model (0 : ℚ) 1).Δ = -64 := by
  norm_num [model_Δ]

example : (model (0 : ℚ) 1).IsElliptic :=
  isElliptic_model_iff_ne_zero.mpr ⟨two_ne_zero, one_ne_zero, by norm_num⟩

example : (model (2 : ℚ) 1).Δ = 0 := by
  norm_num [model_Δ]

-- The cubic of `model 2 1` is `x (x + 1)²`, singular at `x = -1`.
example : (model (2 : ℚ) 1).toAffine.Equation (-1) 0 ∧
    ¬ (model (2 : ℚ) 1).toAffine.Nonsingular (-1) 0 := by
  simp only [Affine.nonsingular_iff, Affine.equation_iff, model_a₁, model_a₂, model_a₃, model_a₄,
    model_a₆]
  norm_num

example : (model (0 : ℚ) 0).Δ = 0 := by
  simp [model_Δ]

example : ¬ (model (0 : ℚ) 0).IsElliptic := by
  simp [isElliptic_model_iff_ne_zero]

example : model (3 : ℚ) 2 = ⟨0, 6, 0, 4, 0⟩ := by
  ext <;> norm_num

-- `(2, 2)` lies on `2 y² = x³ + 3 x² + x` over `𝔽₇`; it goes to `(4, 1)` on `model 3 2`.
example : (model (3 : ZMod 7) 2).toAffine.Equation 4 1 := by
  have h := (equation_model_iff (A := (3 : ZMod 7)) (B := 2) (by decide) 2 2).mpr (by decide)
  rwa [show (2 : ZMod 7) * 2 = 4 by decide, show (2 : ZMod 7) ^ 2 * 2 = 1 by decide] at h

-- Without the substitution `(2, 2)` is not a point of `y² = x³ + 3 x² + x`.
example : ¬ (⟨0, 3, 0, 1, 0⟩ : WeierstrassCurve (ZMod 7)).toAffine.Equation 2 2 := by
  rw [Affine.equation_iff]
  decide

/-! ### The Montgomery equation -/

-- Over `𝔽₇` with `(A, B) = (0, 2)`, the point `(1, 1)` of `2 y² = x³ + x` goes to `(2, 4)`.
example : (model (0 : ZMod 7) 2).toAffine.Equation 2 4 := by
  have h := (equation_model_iff (A := (0 : ZMod 7)) (B := 2) (by decide) 1 1).mpr (by decide)
  rwa [show (2 : ZMod 7) * 1 = 2 by decide, show (2 : ZMod 7) ^ 2 * 1 = 4 by decide] at h

-- At `B = 0` every point goes to `(0, 0)`, which lies on the model ...
example (x y : ℚ) : (model (0 : ℚ) 0).toAffine.Equation (0 * x) (0 ^ 2 * y) := by
  simp [Affine.equation_iff]

-- ... although `(1, 0)` does not satisfy the Montgomery equation `0 · y² = x³ + x`.
example : ¬ (0 : ℚ) * 0 ^ 2 = 1 ^ 3 + 0 * 1 ^ 2 + 1 := by
  norm_num

-- The singular point `(-1, 0)` of `y² = x³ + 2 x² + x` goes to a singular point of `model 2 1`.
example : ¬ (model (2 : ℚ) 1).toAffine.Nonsingular (1 * -1) (1 ^ 2 * 0) := by
  rw [nonsingular_model_iff one_ne_zero]
  norm_num

/-! ### The running examples -/

/-- The native points of `y² = x³ + x` over `𝔽_p` are counted by the affine solutions of that
equation, plus the point at infinity. -/
private theorem card_point_model_zero_one (p : ℕ) [Fact p.Prime]
    [(model (0 : ZMod p) 1).IsElliptic] :
    Nat.card (model (0 : ZMod p) 1).toAffine.Point =
      Fintype.card {xy : ZMod p × ZMod p // xy.2 ^ 2 = xy.1 ^ 3 + xy.1} + 1 := by
  rw [← pointCount_eq_card_point, pointCount_def,
    Nat.card_congr (Equiv.subtypeEquivRight
      (q := fun xy : ZMod p × ZMod p ↦ xy.2 ^ 2 = xy.1 ^ 3 + xy.1)
      fun xy ↦ by rw [Affine.equation_iff]; simp), Nat.card_eq_fintype_card]

section Seven

private instance isElliptic_model_seven : (model (0 : ZMod 7) 1).IsElliptic :=
  isElliptic_model_iff_ne_zero.mpr ⟨by decide, by decide, by decide⟩

private theorem card_point_seven : Nat.card (model (0 : ZMod 7) 1).toAffine.Point = 8 := by
  rw [card_point_model_zero_one]
  decide

private theorem nonsingular_three_three : (model (0 : ZMod 7) 1).toAffine.Nonsingular 3 3 := by
  simp only [Affine.nonsingular_iff, Affine.equation_iff, model_a₁, model_a₂, model_a₃, model_a₄,
    model_a₆]
  decide

/-- The point `(3, 3)` of `y² = x³ + x` over `𝔽₇`. -/
private noncomputable def pointSeven : (model (0 : ZMod 7) 1).toAffine.Point :=
  .some 3 3 nonsingular_three_three

private theorem coordinates_pointSeven : coordinates 0 1 pointSeven = ⟨3, 1⟩ :=
  coordinates_some _ _ _

-- Two doublings of `(3 : 1)` with `(N, D) = (2, 4)` give `(4 : 4)` and then `(0 : 2)`.
private theorem four_nsmul_pointSeven :
    (4 : ℕ) • pointSeven = twoTorsionPoint 0 one_ne_zero := by
  have h₁ := double_coordinates (N := (2 : ZMod 7)) (D := 4) one_ne_zero (by decide)
    (by decide) pointSeven
  obtain ⟨-, h₂⟩ := double_coordinates_of_cross_eq_zero (N := (2 : ZMod 7)) (D := 4) one_ne_zero
    (by decide) (by decide) h₁.1 h₁.2
  have e : double (2 : ZMod 7) 4 (double 2 4 ⟨3, 1⟩) = ⟨0, 2⟩ := by
    ext <;> simp only [double_x, double_z] <;> decide
  rw [coordinates_pointSeven, e, Pair.cross_def, zero_mul, zero_sub, neg_eq_zero,
    mul_eq_zero, or_iff_left (by decide), coordinates_x_eq_zero_iff one_ne_zero] at h₂
  rw [← h₂, show (4 : ℕ) = 2 * 2 from rfl, mul_nsmul, two_nsmul, two_nsmul]

private theorem addOrderOf_pointSeven : addOrderOf pointSeven = 8 :=
  addOrderOf_eq_prime_pow (p := 2) (n := 2)
    (by rw [show 2 ^ 2 = 4 from rfl, four_nsmul_pointSeven]; exact twoTorsionPoint_ne_zero _ _)
    (by rw [show 2 ^ (2 + 1) = 4 * 2 from rfl, mul_nsmul, four_nsmul_pointSeven, two_nsmul,
      twoTorsionPoint_add_self])

-- Over `𝔽₇` the native group has `8` elements.
example : Nat.card (model (0 : ZMod 7) 1).toAffine.Point = 8 :=
  card_point_seven

-- It is cyclic, generated by `(3, 3)`.
example : addOrderOf pointSeven = Nat.card (model (0 : ZMod 7) 1).toAffine.Point := by
  rw [addOrderOf_pointSeven, card_point_seven]

example : IsAddCyclic (model (0 : ZMod 7) 1).toAffine.Point :=
  have : Finite (model (0 : ZMod 7) 1).toAffine.Point :=
    Nat.finite_of_card_ne_zero (by rw [card_point_seven]; decide)
  isAddCyclic_of_addOrderOf_eq_card pointSeven (by rw [addOrderOf_pointSeven, card_point_seven])

end Seven

section Five

private instance isElliptic_model_five : (model (0 : ZMod 5) 1).IsElliptic :=
  isElliptic_model_iff_ne_zero.mpr ⟨by decide, by decide, by decide⟩

-- Over `𝔽₅` the model is the curve `y² = x³ + x` whose points are counted in
-- `TauCeti.WorkedExamples.pointCount_curveX3AddX`.
private theorem card_point_five : Nat.card (model (0 : ZMod 5) 1).toAffine.Point = 4 := by
  have h : model (0 : ZMod 5) 1 = WorkedExamples.curveX3AddX := by
    ext <;> simp
  rw [← pointCount_eq_card_point, h, WorkedExamples.pointCount_curveX3AddX]

-- Every affine solution over `𝔽₅` has `y = 0`, so every native point is killed by `2`.
private theorem two_nsmul_point_five (Q : (model (0 : ZMod 5) 1).toAffine.Point) :
    (2 : ℕ) • Q = 0 := by
  rcases Q with _ | ⟨x, y, h⟩
  · exact nsmul_zero 2
  · have key : ∀ x y : ZMod 5, y ^ 2 = x ^ 3 + x → y = -y := by decide
    rw [two_nsmul]
    refine Affine.Point.add_self_of_Y_eq ?_
    have e := (Affine.equation_iff ..).mp h.1
    simp only [model_a₁, model_a₂, model_a₃, model_a₄, model_a₆] at e
    simp only [Affine.negY, model_a₁, model_a₃, zero_mul, sub_zero]
    exact key x y (by linear_combination e)

-- Over `𝔽₅` the native group has `4` elements.
example : Nat.card (model (0 : ZMod 5) 1).toAffine.Point = 4 :=
  card_point_five

-- Each of its nonzero points has order two.
example (Q : (model (0 : ZMod 5) 1).toAffine.Point) (hQ : Q ≠ 0) : addOrderOf Q = 2 :=
  addOrderOf_eq_prime (two_nsmul_point_five Q) hQ

-- So it is not cyclic.
example : ¬ IsAddCyclic (model (0 : ZMod 5) 1).toAffine.Point := by
  intro
  have : Finite (model (0 : ZMod 5) 1).toAffine.Point :=
    Nat.finite_of_card_ne_zero (by rw [card_point_five]; decide)
  obtain ⟨g, hg⟩ := IsAddCyclic.exists_generator (α := (model (0 : ZMod 5) 1).toAffine.Point)
  have h₄ : addOrderOf g = 4 := by
    rw [addOrderOf_eq_card_of_forall_mem_zmultiples hg, card_point_five]
  have h₂ : addOrderOf g ∣ 2 := addOrderOf_dvd_of_nsmul_eq_zero (two_nsmul_point_five g)
  rw [h₄] at h₂
  exact absurd h₂ (by decide)

end Five

end TauCeti.Montgomery
