module

public import TauCeti.AlgebraicGeometry.Grassmannian.Map

import Mathlib.LinearAlgebra.Basis.Prod
import TauCeti.RingTheory.Grassmannian.Chart.Basic
import TauCeti.LinearAlgebra.TensorProduct.Kernel
import TauCeti.Algebra.DualNumber.Basic

/-!
# A square-zero point outside an upper incidence image

For the inclusion of the first summand `R → R²`, the graph line generated by `e₁ + a e₂`
is in the upper incidence image exactly when `a = 0`. With zero endomorphisms every such
line is stable. Taking `a = ε` in the dual numbers gives a stable line which reduces to an
image point but is outside the scheme-theoretic image over the nonreduced test algebra.
-/

public section

universe u

open Module Module.Grassmannian TensorProduct CategoryTheory AlgebraicGeometry

namespace TauCeti.Grassmannian.UpperIncidenceExamples

variable (R : Type u) [CommRing R]

private noncomputable def planeBasis : Basis (Fin 1 ⊕ Fin 1) R (R × R) :=
  (Basis.singleton (Fin 1) R).prod (Basis.singleton (Fin 1) R)

/-- The quotient by the first coordinate line, as a rank-one quotient point. -/
noncomputable def firstLine : G(1, R × R; R) :=
  ofSurjective (LinearMap.snd R R R) (LinearMap.snd_surjective (R := R) (M := R) (M₂ := R))
    (fun p ↦ by
      have := p.nontrivial
      exact congrFun (Module.rankAtStalk_self (R := R)) p)

/-- The fixed quotient kernel is the range of the first summand inclusion. -/
theorem firstLine_toSubmodule :
    (firstLine R).toSubmodule = LinearMap.range (LinearMap.inl R R R) := by
  rw [firstLine, toSubmodule_ofSurjective]
  exact LinearMap.ker_snd R R R

variable {R} {A : Type u} [CommRing A] [Algebra R A]

/-- The graph line generated by the vector `e₁ + a e₂`. -/
noncomputable def graphPoint (a : A) : G(1, A ⊗[R] (R × R); A) :=
  ((chartBasisEquiv (planeBasis R) A).symm (Matrix.of fun _ _ ↦ -a)).val

/-- The graph point has its expected spanning vector over every test algebra. -/
theorem graphPoint_toSubmodule (a : A) :
    (graphPoint (R := R) a).toSubmodule =
      Submodule.span A {(1 : A) ⊗ₜ[R] (1, 0) + a • (1 : A) ⊗ₜ[R] (0, 1)} := by
  rw [graphPoint, toSubmodule_chartBasisEquiv_symm]
  simp [Set.range_unique, chartGraphVector_def, planeBasis, Basis.prod_apply]
  congr 2
  module

/-- Upper containment detects the graph parameter itself, including nilpotent parameters. -/
theorem graphPoint_le_firstLine_iff (a : A) :
    (graphPoint (R := R) a).toSubmodule ≤ ((firstLine R).baseChange A).toSubmodule ↔ a = 0 := by
  rw [graphPoint_toSubmodule, Submodule.span_le, Set.singleton_subset_iff,
    toSubmodule_baseChange]
  have hP : (firstLine R).toSubmodule = LinearMap.ker (LinearMap.snd R R R) := by
    rw [firstLine, toSubmodule_ofSurjective]
  rw [hP, ← LinearMap.ker_baseChange_of_surjective A _ LinearMap.snd_surjective,
    SetLike.mem_coe, LinearMap.mem_ker]
  constructor
  · intro h
    have := congrArg (AlgebraTensorModule.rid R A A) h
    simpa using this
  · rintro rfl
    simp

/-- These graph points are stable for the zero endomorphism. -/
theorem graphPoint_stable_zero (a : A) :
    (graphPoint (R := R) a).toSubmodule ∈
      Module.End.invtSubmodule ((0 : Module.End R (R × R)).baseChange A) :=
  (stableLocus_eq_bot_iff _ _).mp (stableLocus_zero _)

/-- Graph points commute with coefficient maps. -/
@[simp]
theorem map_graphPoint {B : Type u} [CommRing B] [Algebra R B] (f : A →ₐ[R] B) (a : A) :
    map f (graphPoint (R := R) a) = graphPoint (f a) := by
  simp [graphPoint, map_chartBasisEquiv_symm, Matrix.map]

/-- The dual-number graph is outside the incidence image although its reduction belongs to it. -/
theorem dualNumber_graph_upper_incidence [Nontrivial R] :
    ¬ (graphPoint (R := R) (DualNumber.eps : DualNumber R)).toSubmodule ≤
      ((firstLine R).baseChange (DualNumber R)).toSubmodule ∧
    (map (TrivSqZeroExt.fstHom R R R)
      (graphPoint (R := R) (DualNumber.eps : DualNumber R))).toSubmodule ≤
        ((firstLine R).baseChange R).toSubmodule := by
  rw [graphPoint_le_firstLine_iff, map_graphPoint, graphPoint_le_firstLine_iff]
  exact ⟨DualNumber.eps_ne_zero, by simp⟩

/-- With zero endomorphisms the square-zero graph has no lift along the stable injection
closed immersion, although its reduction satisfies upper containment. -/
example [Nontrivial R] :
    ¬∃ c : Spec (.of (DualNumber R)) ⟶ (schemeStableLocus 0 (0 : Module.End R R)).subscheme,
      c ≫ (LinearMap.inl R R R).grassmannianStableMap LinearMap.inl_injective
          (firstLine R) (firstLine_toSubmodule R) 0 0 0 (by simp) =
        (schemeStableLocusHomEquiv 1 (0 : Module.End R (R × R)) (DualNumber R)
          ⟨graphPoint (R := R) (DualNumber.eps : DualNumber R), graphPoint_stable_zero _⟩).val := by
  rw [LinearMap.exists_comp_grassmannianStableMap_eq_iff]
  exact (dualNumber_graph_upper_incidence (R := R)).1

end TauCeti.Grassmannian.UpperIncidenceExamples
