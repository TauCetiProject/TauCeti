/-!
# Checks: modifications

These examples test the two halves of `TauCeti.AlgebraicGeometry.IsModification` (properness and
being an isomorphism over a dense open with dense preimage) on affine schemes over a field `k`.

* **A finite modification that is not an isomorphism.** `Spec k[x, y]/(x², xy) → Spec k[y]` is
  finite (generated by `1, x`) and an isomorphism over `D(y)`, where `x = 0`, whose preimage is
  dense; so it is a modification, but not an isomorphism (`x ≠ 0`). Its target is the normal
  integral line, so `IsModification.isIso_of_isFinite` needs its reducedness hypothesis on the
  source.
* **Properness without birationality.** The absolute Frobenius of `𝔸¹_{𝔽_p}` is finite, hence
  proper, but it is an isomorphism over no nonempty open, so it is not a modification.
* **Birationality without properness.** The inclusion `𝔾_m → 𝔸¹` is an isomorphism over the dense
  open `D(x)`, whose preimage is everything, but it is not proper: its image `D(x)` is not closed.

Here `k[x, y]/(x², xy)` is written `k[y][X]/(X², X·y)`, and `𝔾_m` is `Spec k[x]_x`.
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry TauCeti.AlgebraicGeometry Polynomial

namespace TauCeti.Examples.ModificationChecks

/-- The basic open `D(x)` of the line is dense. -/
private theorem dense_basicOpen_X (k : Type) [Field k] :
    Dense (PrimeSpectrum.basicOpen (X : k[X]) : Set (PrimeSpectrum k[X])) :=
  PrimeSpectrum.dense_basicOpen_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero X_ne_zero)

/-! ### A finite modification that is not an isomorphism -/

section Thick

variable (k : Type) [Field k]

/-- The ideal `(x², xy)` of `k[y][x]`. -/
abbrev thickIdeal : Ideal k[X][X] := Ideal.span {X ^ 2, X * C X}

/-- The ring `k[x, y]/(x², xy)`, written `k[y][x]/(x², xy)`. A `def` with a single ring structure,
the commutative quotient ring. -/
@[expose] def Thick : Type := k[X][X] ⧸ thickIdeal k

instance : CommRing (Thick k) := Ideal.Quotient.commRing _

instance : Algebra k[X] (Thick k) := Ideal.Quotient.algebra _

/-- The quotient map `k[y][x] → k[x, y]/(x², xy)`. -/
@[expose] def thickMk : k[X][X] →+* Thick k := Ideal.Quotient.mk _

-- `Thick k` is by definition the quotient ring `k[y][x] ⧸ (x², xy)`, with its quotient algebra
-- structure; the lemmas below cross from `Thick k` to that quotient only through `thickMk_def`.
private theorem thickMk_def : thickMk k = Ideal.Quotient.mk (thickIdeal k) :=
  rfl

private theorem thickMk_surjective : Function.Surjective (thickMk k) :=
  Ideal.Quotient.mk_surjective

private theorem thickMk_eq_zero_iff {q : k[X][X]} : thickMk k q = 0 ↔ q ∈ thickIdeal k :=
  Ideal.Quotient.eq_zero_iff_mem

/-- The structure map `k[y] → k[x, y]/(x², xy)`. -/
abbrev thickAlg : k[X] →+* Thick k := algebraMap k[X] (Thick k)

private theorem thickAlg_apply (r : k[X]) : thickAlg k r = thickMk k (C r) := by
  rw [thickMk_def, ← Polynomial.algebraMap_eq]
  exact (Ideal.Quotient.mk_algebraMap _ _ _).symm

/-- The projection `Spec k[x, y]/(x², xy) → Spec k[y]`. -/
abbrev thickToLine : Spec (.of (Thick k)) ⟶ Spec (.of k[X]) :=
  Spec.map (CommRingCat.ofHom (thickAlg k))

/-- Setting `x = 0`: the map `k[x, y]/(x², xy) → k[y]`. -/
private def thickEval : Thick k →+* k[X] :=
  Ideal.Quotient.lift _ (evalRingHom 0) fun a ha => RingHom.mem_ker.1 <| by
    refine (Ideal.span_le.2 ?_ : thickIdeal k ≤ RingHom.ker (evalRingHom 0)) ha
    simp [Set.insert_subset_iff]

private theorem thickEval_mk (q : k[X][X]) : thickEval k (thickMk k q) = q.eval 0 := by
  rw [thickMk_def, thickEval]
  exact Ideal.Quotient.lift_mk _ _ _

private theorem thickEval_thickAlg (r : k[X]) : thickEval k (thickAlg k r) = r := by
  rw [thickAlg_apply, thickEval_mk, eval_C]

/-- Setting `y = 0` and `x = ε`: the map `k[x, y]/(x², xy) → k[ε]`. -/
private def thickDual : Thick k →+* DualNumber k :=
  Ideal.Quotient.lift _ (eval₂RingHom ((TrivSqZeroExt.inlHom k k).comp (evalRingHom 0))
    DualNumber.eps) fun a ha => RingHom.mem_ker.1 <| by
    refine (Ideal.span_le.2 ?_ : thickIdeal k ≤ RingHom.ker _) ha
    simp [Set.insert_subset_iff, sq, DualNumber.eps_mul_eps]

private theorem thickDual_mk (q : k[X][X]) : thickDual k (thickMk k q) =
    q.eval₂ ((TrivSqZeroExt.inlHom k k).comp (evalRingHom 0)) DualNumber.eps := by
  rw [thickMk_def, thickDual]
  exact Ideal.Quotient.lift_mk _ _ _

/-- The class of `x` is not zero. -/
private theorem mk_X_ne_zero : thickMk k X ≠ 0 := fun h => by
  have := congrArg (fun b => (thickDual k b).snd) h
  simp [thickDual_mk] at this

/-- An element killed by setting `x = 0` is a multiple of `x`, hence nilpotent. -/
private theorem isNilpotent_of_thickEval_eq_zero (b : Thick k) (hb : thickEval k b = 0) :
    IsNilpotent b := by
  obtain ⟨q, rfl⟩ := thickMk_surjective k b
  have h0 : q.coeff 0 = 0 := by
    rwa [thickEval_mk, ← coeff_zero_eq_eval_zero] at hb
  refine ⟨2, ?_⟩
  rw [← X_mul_divX_add q, h0, C_0, add_zero, ← map_pow, thickMk_eq_zero_iff, mul_pow]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))

instance : IrreducibleSpace (PrimeSpectrum (Thick k)) := by
  have : nilradical (Thick k) = RingHom.ker (thickEval k) :=
    le_antisymm (fun b hb => by
      obtain ⟨n, hn⟩ := mem_nilradical.1 hb
      exact (show IsNilpotent (thickEval k b) from ⟨n, by rw [← map_pow, hn, map_zero]⟩).eq_zero)
      fun b hb => isNilpotent_of_thickEval_eq_zero k b hb
  rw [PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical, this]
  exact RingHom.ker_isPrime _

instance : IsFinite (thickToLine k) := by
  have hle : Ideal.span {(X : k[X][X]) ^ 2} ≤ thickIdeal k := Ideal.span_mono (by simp)
  have : Module.Finite k[X] (k[X][X] ⧸ Ideal.span {(X : k[X][X]) ^ 2}) :=
    (monic_X_pow 2).finite_quotient
  have : Module.Finite k[X] (Thick k) := Module.Finite.of_surjective
    (Ideal.Quotient.factorₐ k[X] hle).toLinearMap (Ideal.Quotient.factor_surjective hle)
  rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom, thickAlg, RingHom.finite_algebraMap]
  infer_instance

/-- The image of `y` is not nilpotent, since setting `x = 0` sends it to `y`. -/
private theorem not_isNilpotent_thickAlg_X : ¬ IsNilpotent (thickAlg k X) := fun ⟨n, hn⟩ => by
  have := congrArg (thickEval k) hn
  rw [map_pow, thickEval_thickAlg, map_zero] at this
  exact X_ne_zero (pow_eq_zero_iff'.1 this).1

/-- After inverting `y`, the map `k[y] → k[x, y]/(x², xy)` is bijective: `x = 0` there. -/
private theorem bijective_awayMap :
    Function.Bijective (Localization.awayMap (P := Thick k) (thickAlg k) X) := by
  refine ⟨Localization.awayMap_injective_iff.2 fun a ha => ⟨0, ?_⟩,
    Localization.awayMap_surjective_iff.2 fun b => ?_⟩
  · rw [pow_zero, one_mul, ← thickEval_thickAlg k a, ha, map_zero]
  · obtain ⟨q, rfl⟩ := thickMk_surjective k b
    -- Multiplying by `y` kills the multiple `x · q.divX` of `x`, since `x * y = 0`.
    have hq : C X * q = X * C X * q.divX + C (X * q.coeff 0) := by
      conv_lhs => rw [← X_mul_divX_add q]
      rw [C_mul]
      ring
    have hx : thickMk k (X * C X) = 0 := (thickMk_eq_zero_iff k).2 (Ideal.subset_span (by simp))
    refine ⟨X * q.coeff 0, 1, ?_⟩
    rw [pow_one, thickAlg_apply, thickAlg_apply, ← map_mul, hq, map_add,
      map_mul (thickMk k) (X * C X), hx, zero_mul, zero_add]

-- `Spec k[x, y]/(x², xy) → Spec k[y]` is a finite modification of the normal integral line that
-- is not an isomorphism; its source is not reduced.
example : IsModification (thickToLine k) ∧ IsFinite (thickToLine k) ∧
    ¬ IsIso (thickToLine k) ∧ IsIntegral (Spec (.of k[X])) ∧ IsNormalScheme (Spec (.of k[X])) ∧
    ¬ IsReduced (Spec (.of (Thick k))) := by
  have hiso : IsIso (thickToLine k ∣_ PrimeSpectrum.basicOpen (X : k[X])) :=
    (isIso_SpecMap_morphismRestrict_basicOpen_iff _ _).2 (bijective_awayMap k)
  have hmod : IsModification (thickToLine k) :=
    { exists_isIso_morphismRestrict := ⟨_, dense_basicOpen_X k,
        PrimeSpectrum.isOpen_basicOpen.dense <| (TopologicalSpace.Opens.ne_bot_iff_nonempty _).1 <|
          by
            rw [Ne, PrimeSpectrum.basicOpen_eq_bot_iff, CommRingCat.hom_ofHom]
            exact not_isNilpotent_thickAlg_X k,
        hiso⟩ }
  refine ⟨hmod, inferInstance, fun h => ?_, inferInstance,
    (isNormalScheme_Spec_iff _).2 inferInstance, fun h => ?_⟩
  · obtain ⟨r, hr⟩ := (isIso_SpecMap_iff.1 h).2 (thickMk k X)
    have h0 := congrArg (thickEval k) hr
    simp only [CommRingCat.hom_ofHom, thickEval_thickAlg] at h0
    rw [h0] at hr
    rw [thickEval_mk, eval_X, map_zero] at hr
    exact mk_X_ne_zero k hr.symm
  · rw [affine_isReduced_iff] at h
    exact mk_X_ne_zero k (IsReduced.eq_zero _ ⟨2, by
      rw [← map_pow, thickMk_eq_zero_iff]
      exact Ideal.subset_span (by simp)⟩)

end Thick

/-! ### `𝔾_m → 𝔸¹` is birational but not proper -/

section Gm

variable (k : Type) [Field k]

/-- The inclusion `𝔾_m = Spec k[x]_x → 𝔸¹ = Spec k[x]`. -/
abbrev gmToLine : Spec (.of (Localization.Away (X : k[X]))) ⟶ Spec (.of k[X]) :=
  Spec.map (CommRingCat.ofHom (algebraMap k[X] (Localization.Away (X : k[X]))))

private theorem gmToLine_preimage :
    gmToLine k ⁻¹ᵁ PrimeSpectrum.basicOpen (X : k[X]) = ⊤ :=
  (PrimeSpectrum.basicOpen_eq_top_iff _).2 (IsLocalization.Away.algebraMap_isUnit _)

instance : IsIso (gmToLine k ∣_ PrimeSpectrum.basicOpen (X : k[X])) :=
  isIso_SpecMap_morphismRestrict_basicOpen_of_injective (S := Localization.Away (X : k[X])) X
    Function.injective_id

-- `𝔾_m → 𝔸¹` is an isomorphism over the dense open `D(x)`, whose preimage is everything, so it is
-- birational over `𝔸¹`.
example : Dense (PrimeSpectrum.basicOpen (X : k[X]) : Set (PrimeSpectrum k[X])) ∧
    gmToLine k ⁻¹ᵁ PrimeSpectrum.basicOpen (X : k[X]) = ⊤ ∧
    IsIso (gmToLine k ∣_ PrimeSpectrum.basicOpen (X : k[X])) ∧
    Scheme.BirationalOver (gmToLine k) (𝟙 _) := by
  have hd := dense_basicOpen_X k
  refine ⟨hd, gmToLine_preimage k, inferInstance, ?_⟩
  have h := (gmToLine k).birationalOver_of_isIso_morphismRestrict (𝟙 _) _ hd (by
    rw [gmToLine_preimage]
    simp)
  simpa using h

-- `𝔾_m → 𝔸¹` is not proper, so it is not a modification: its image `D(x)` is open, nonempty and
-- not everything, so it is not closed in the connected line.
example : ¬ IsProper (gmToLine k) := by
  intro _
  have hc := (gmToLine k).isClosedMap.isClosed_range
  have hr : Set.range (gmToLine k) =
      (PrimeSpectrum.basicOpen (X : k[X]) : Set (PrimeSpectrum k[X])) :=
    PrimeSpectrum.localization_away_comap_range _ _
  rw [hr] at hc
  rcases isClopen_iff.mp ⟨hc, PrimeSpectrum.isOpen_basicOpen⟩ with h | h
  · exact (dense_basicOpen_X k).nonempty.ne_empty h
  · have hp : (Ideal.span {(X : k[X])}).IsPrime := (Ideal.span_singleton_prime X_ne_zero).2 prime_X
    have : (⟨_, hp⟩ : PrimeSpectrum k[X]) ∈ (PrimeSpectrum.basicOpen (X : k[X]) : Set _) :=
      h ▸ Set.mem_univ _
    exact this (Ideal.subset_span rfl)

end Gm

/-! ### Frobenius of `𝔸¹_{𝔽_p}` is proper but not birational -/

section Frobenius

variable (p : ℕ) [Fact p.Prime]

/-- The affine line `𝔸¹_{𝔽_p} = Spec 𝔽_p[x]`. -/
abbrev lineFp : Scheme := Spec (.of (ZMod p)[X])

/-- The absolute Frobenius of `𝔸¹_{𝔽_p}`. -/
abbrev frobLine : lineFp p ⟶ lineFp p :=
  (lineFp p).frobenius p (Scheme.natCast_spec_eq_zero _)

instance : IsFinite (frobLine p) :=
  have : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap (ZMod p) (ZMod p)[X]))) :=
    HasRingHomProperty.Spec_iff.mpr (RingHom.finiteType_algebraMap.mpr inferInstance)
  Scheme.isFinite_frobenius (Spec.map (CommRingCat.ofHom (algebraMap (ZMod p) (ZMod p)[X]))) _

/-- In a localization of a copy `A` of `𝔽_p[x]` away from a nonzero `g`, the variable `x` is not a
`p`-th power: comparing degrees in `r ^ p = x * g ^ (n * p)` gives `p ∣ 1`. -/
private theorem pow_ne_X {A : Type} [CommRing A] (e : A ≃+* (ZMod p)[X]) {g : A} (hg : g ≠ 0)
    {S : Type} [CommRing S] [Algebra A S] [IsLocalization.Away g S] (s : S) :
    s ^ p ≠ algebraMap A S (e.symm X) := by
  intro hs
  have : IsDomain A := e.toMulEquiv.isDomain
  obtain ⟨⟨r, _, n, rfl⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers g) s
  rw [← IsLocalization.mk'_pow, IsLocalization.mk'_eq_iff_eq_mul, ← map_mul,
    (IsLocalization.injective S (powers_le_nonZeroDivisors_of_noZeroDivisors hg)).eq_iff] at hs
  have he := congrArg e hs
  simp only [map_pow, map_mul, RingEquiv.apply_symm_apply, SubmonoidClass.coe_pow] at he
  have hg' : e g ≠ 0 := (map_ne_zero_iff e e.injective).2 hg
  have hdeg := congrArg natDegree he
  rw [natDegree_pow, natDegree_mul X_ne_zero (pow_ne_zero _ (pow_ne_zero _ hg')), natDegree_X,
    natDegree_pow, natDegree_pow] at hdeg
  have : p ∣ 1 := (Nat.dvd_add_left (dvd_mul_right p _)).1 (hdeg ▸ dvd_mul_right p _)
  exact (Fact.out : p.Prime).one_lt.ne' (Nat.dvd_one.mp this)

/-- The Frobenius of `𝔸¹_{𝔽_p}` is an isomorphism over no nonempty open. -/
private theorem not_isIso_frobLine_restrict (U : (lineFp p).Opens)
    (hU : (U : Set (lineFp p)).Nonempty) : ¬ IsIso (frobLine p ∣_ U) := by
  intro h
  obtain ⟨x, hx⟩ := hU
  obtain ⟨_, ⟨g, rfl⟩, hxg, hgU⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens hx
  have hg : g ≠ 0 := by
    rintro rfl
    rw [PrimeSpectrum.basicOpen_zero] at hxg
    exact hxg
  set g' := (Scheme.ΓSpecIso (.of (ZMod p)[X])).inv g
  rw [← basicOpen_eq_of_affine] at hgU
  have h' : IsIso (frobLine p ∣_ (lineFp p).basicOpen g') :=
    IsZariskiLocalAtTarget.restrict_of_le (MorphismProperty.isomorphisms _) h hgU
  have hA := (isAffineOpen_top (lineFp p)).basicOpen g'
  have := (isAffineOpen_top (lineFp p)).isLocalization_basicOpen g'
  rw [isIso_morphismRestrict_iff_isIso_app _ hA] at h'
  let e : Γ(lineFp p, ⊤) ≃+* (ZMod p)[X] :=
    (Scheme.ΓSpecIso (.of (ZMod p)[X])).commRingCatIsoToRingEquiv
  have hg' : g' ≠ 0 := fun h0 => hg (by
    simpa [g'] using congrArg (Scheme.ΓSpecIso (.of (ZMod p)[X])).hom.hom h0)
  obtain ⟨s, hs⟩ := ((Scheme.isIso_frobenius_app_iff _ _).1 h').2
    (algebraMap Γ(lineFp p, ⊤) Γ(lineFp p, (lineFp p).basicOpen g') (e.symm X))
  exact pow_ne_X p e hg' s hs

-- The Frobenius of `𝔸¹_{𝔽_p}` is proper, an isomorphism over no nonempty open, and not a
-- modification.
example : IsProper (frobLine p) ∧
    (∀ U : (lineFp p).Opens, (U : Set (lineFp p)).Nonempty → ¬ IsIso (frobLine p ∣_ U)) ∧
    ¬ IsModification (frobLine p) := by
  refine ⟨inferInstance, not_isIso_frobLine_restrict p, fun h => ?_⟩
  obtain ⟨U, hU, -, hiso⟩ := h.exists_isIso_morphismRestrict
  exact not_isIso_frobLine_restrict p U hU.nonempty hiso

end Frobenius

end TauCeti.Examples.ModificationChecks
