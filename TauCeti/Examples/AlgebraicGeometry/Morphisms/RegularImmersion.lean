module

public import Mathlib.RingTheory.DualNumber
public import TauCeti.AlgebraicGeometry.Morphisms.RegularImmersion
import TauCeti.Algebra.Regular.SMul

/-!
# Examples: regular immersions

* The identity of a scheme is a regular immersion of codimension zero, and an immersion with
  empty source is a regular immersion of every codimension.
* The residue point `Spec K ⟶ Spec K[ε]` of the dual numbers over a field is a closed immersion
  that is not a regular immersion of codimension one: its ideal is `(ε)`, and `ε` is a zero
  divisor (Fulton, *Intersection Theory*, Appendix B.7). Indeed `Spec K[ε]` has a single point,
  so every open neighbourhood of it is the whole scheme; a generator of the ideal there lies in
  `(ε)`, so its square vanishes, and if it were a nonzerodivisor it would be zero, while `ε` is a
  nonzero element of the ideal.
-/

public section

open AlgebraicGeometry CategoryTheory

namespace TauCeti.RegularImmersionExample

universe u

-- The identity is a regular immersion of codimension zero.
example (X : Scheme.{u}) : Scheme.Hom.IsRegularImmersion (𝟙 X) 0 :=
  Scheme.Hom.isRegularImmersion_zero_of_isIso _

-- An immersion with empty source is a regular immersion of every codimension.
example {X Y : Scheme.{u}} [IsEmpty X] (i : X ⟶ Y) [IsImmersion i] (d : ℕ) :
    i.IsRegularImmersion d :=
  Scheme.Hom.isRegularImmersion_of_isEmpty i d

variable (K : Type u) [Field K]

/-- The residue point `Spec K ⟶ Spec K[ε]` of the dual numbers, the spectrum of the quotient map
`K[ε] ⟶ K` killing `ε`. -/
noncomputable def residuePoint : Spec (.of K) ⟶ Spec (.of (DualNumber K)) :=
  Spec.map (CommRingCat.ofHom (TrivSqZeroExt.fstHom K K K).toRingHom)

instance : IsClosedImmersion (residuePoint K) :=
  IsClosedImmersion.spec_of_surjective _ fun a ↦ ⟨TrivSqZeroExt.inl a, rfl⟩

/-- `Spec K[ε]` has a single point, since `K[ε]` is a local ring whose maximal ideal is nil. -/
theorem subsingleton_spec_dualNumber : Subsingleton (Spec (.of (DualNumber K))) := by
  refine ⟨fun p q ↦ ?_⟩
  -- Every prime contains the nilpotent `ε`-line, which is the maximal ideal.
  have key (r : PrimeSpectrum (DualNumber K)) :
      r.asIdeal = RingHom.ker (TrivSqZeroExt.fstHom K K K).toRingHom := by
    refine le_antisymm (fun x hx ↦ ?_) fun x hx ↦ ?_
    · by_contra h
      have hu : IsUnit x := (TrivSqZeroExt.isUnit_iff_isUnit_fst).2 (isUnit_iff_ne_zero.2 h)
      exact r.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx hu)
    · have hx' : x.fst = 0 := hx
      have hsq : x * x = 0 := TrivSqZeroExt.ext (by simp [hx']) (by simp [hx'])
      exact r.isPrime.mem_of_pow_mem 2 (by rw [pow_two, hsq]; exact r.asIdeal.zero_mem)
  exact PrimeSpectrum.ext ((key p).trans (key q).symm)

/-- **The residue point of the dual numbers is not a regular immersion of codimension one**: its
ideal `(ε)` is not generated by a nonzerodivisor near the point, as `ε` is a zero divisor. -/
theorem not_isRegularImmersion_residuePoint : ¬ (residuePoint K).IsRegularImmersion 1 := by
  have hsub := subsingleton_spec_dualNumber K
  rw [Scheme.Hom.isRegularImmersion_iff_of_isClosedImmersion]
  intro h
  let y : Spec (.of K) := ⟨⊥, Ideal.isPrime_bot⟩
  obtain ⟨⟨U, hU⟩, hyU, rs, hlen, hreg, hI⟩ :=
    Scheme.IdealSheafData.isLocallyRegular_iff.mp h (residuePoint K y)
      ((residuePoint K).range_subset_ker_support ⟨y, rfl⟩)
  obtain rfl : U = ⊤ := top_le_iff.mp fun z _ ↦ Subsingleton.elim (residuePoint K y) z ▸ hyU
  obtain ⟨a, rfl⟩ : ∃ a, rs = [a] := List.length_eq_one_iff.mp hlen
  have ha : IsSMulRegular _ a := ((RingTheory.Sequence.isRegular_cons_iff _ a []).mp hreg).1
  -- Transport to `K[ε]` along `Γ(Spec K[ε], ⊤) ≅ K[ε]`.
  let e := (Scheme.ΓSpecIso (.of (DualNumber K))).commRingCatIsoToRingEquiv
  have hker (s) : s ∈ (residuePoint K).ker.ideal ⟨⊤, hU⟩ ↔ (e s).fst = 0 := by
    rw [Scheme.Hom.ker_apply, RingHom.mem_ker]
    have := congr($(Scheme.ΓSpecIso_naturality
      (CommRingCat.ofHom (TrivSqZeroExt.fstHom K K K).toRingHom)).hom s)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    constructor
    · intro h0
      refine this.symm.trans ?_
      erw [h0, map_zero]
    · intro h0
      apply (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of K)).hom).1
      erw [this, map_zero]
      exact h0
  have ha0 : (e a).fst = 0 := (hker a).mp (hI ▸ Ideal.subset_span (by simp))
  -- `e a` squares to zero, and is a nonzerodivisor, so it vanishes.
  have hsq : e a * e a = 0 := TrivSqZeroExt.ext (by simp [ha0]) (by simp [ha0])
  have hea : e a = 0 :=
    (TauCeti.isSMulRegular_map_iff e a).mpr ha (by
      change e a * e a = e a * 0
      rw [hsq, mul_zero])
  -- But `ε` is a nonzero element of the ideal, which is generated by `a = 0`.
  have hε : e.symm DualNumber.eps ∈ (residuePoint K).ker.ideal ⟨⊤, hU⟩ :=
    (hker _).mpr (by simp)
  rw [hI, Ideal.ofList_cons, Ideal.ofList_nil, sup_bot_eq, (map_eq_zero_iff e e.injective).mp hea,
    Ideal.span_singleton_eq_bot.mpr rfl, Ideal.mem_bot, map_eq_zero_iff _ e.symm.injective] at hε
  simpa using congrArg TrivSqZeroExt.snd hε

end TauCeti.RegularImmersionExample
