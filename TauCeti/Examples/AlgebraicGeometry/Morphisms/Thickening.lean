module

public import Mathlib.Algebra.Polynomial.RingDivision
public import Mathlib.Algebra.TrivSqZeroExt.Ideal
public import Mathlib.RingTheory.Ideal.Quotient.PowTransition
public import TauCeti.AlgebraicGeometry.Morphisms.Thickening

/-!
# Examples of thickenings

For a field `k`, these examples test the two thickening predicates on closed points:

* `Spec k ⟶ Spec k[ε]`, for the dual numbers `k[ε] = TrivSqZeroExt k k`, is a first-order
  thickening;
* `Spec k ⟶ Spec k[x] ⧸ (x³)` is a thickening but not a first-order one, since `x² ≠ 0`;
* the origin `Spec k ⟶ 𝔸¹_k = Spec k[x]` is a closed immersion but not a thickening, since `x` is
  not nilpotent;
* identities are first-order thickenings.

## References

* [Stacks Project, Definition 37.2.1](https://stacks.math.columbia.edu/tag/04EX).
-/

public section

universe u

open CategoryTheory AlgebraicGeometry Polynomial TauCeti.AlgebraicGeometry

variable (k : Type u) [Field k]

/-- `Spec k ⟶ Spec k[ε]` is a first-order thickening: the kernel of `k[ε] → k` is `k ε`, and
`ε² = 0`. -/
example : IsFirstOrderThickening
    (Spec.map (CommRingCat.ofHom (TrivSqZeroExt.fstHom k k k).toRingHom)) := by
  refine (IsFirstOrderThickening.SpecMap_iff _ TrivSqZeroExt.fst_surjective).2 ?_
  exact (pow_two _).symm.trans (TrivSqZeroExt.kerIdeal_sq k k)

/-- The kernel of `k[x] ⧸ (x³) → k[x] ⧸ (x)` is generated by the class of `x`. -/
private theorem ker_factor_span_X_pow_three :
    RingHom.ker (Ideal.Quotient.factor
      (Ideal.span_singleton_le_span_singleton.2 (dvd_pow_self (X : k[X]) three_ne_zero))) =
      Ideal.span {Ideal.Quotient.mk _ X} := by
  rw [Ideal.Quotient.factor_ker, Ideal.map_span, Set.image_singleton]

/-- `Spec k ⟶ Spec k[x] ⧸ (x³)` is a thickening: the class of `x` is nilpotent. -/
theorem TauCeti.AlgebraicGeometry.isThickening_cube : IsThickening
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor
      (Ideal.span_singleton_le_span_singleton.2 (dvd_pow_self (X : k[X]) three_ne_zero))))) := by
  rw [IsThickening.SpecMap_iff _ (Ideal.Quotient.factor_surjective
      (Ideal.span_singleton_le_span_singleton.2 (dvd_pow_self (X : k[X]) three_ne_zero))),
    CommRingCat.hom_ofHom, ker_factor_span_X_pow_three]
  -- The class of `x` is nilpotent, since `x³ = 0` in `k[x] ⧸ (x³)`.
  have hx : IsNilpotent (Ideal.Quotient.mk (Ideal.span {(X : k[X]) ^ 3}) X) :=
    ⟨3, by simp [← map_pow]⟩
  simpa [Ideal.span_le, mem_nilradical] using hx

/-- `Spec k ⟶ Spec k[x] ⧸ (x³)` is not a first-order thickening: the class of `x²` is nonzero,
as `x³` does not divide `x²`. -/
theorem TauCeti.AlgebraicGeometry.not_isFirstOrderThickening_cube : ¬ IsFirstOrderThickening
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor
      (Ideal.span_singleton_le_span_singleton.2 (dvd_pow_self (X : k[X]) three_ne_zero))))) := by
  rw [IsFirstOrderThickening.SpecMap_iff _ (Ideal.Quotient.factor_surjective
      (Ideal.span_singleton_le_span_singleton.2 (dvd_pow_self (X : k[X]) three_ne_zero))),
    CommRingCat.hom_ofHom, ker_factor_span_X_pow_three]
  -- The class of `x²` is nonzero, since `x³` does not divide `x²`.
  have hx : ¬ (X : k[X]) ^ 3 ∣ X * X := by
    rw [← pow_two, pow_dvd_pow_iff X_ne_zero not_isUnit_X]
    omega
  simpa [Ideal.span_singleton_mul_span_singleton, ← map_mul, Ideal.Quotient.eq_zero_iff_mem,
    Ideal.mem_span_singleton] using hx

/-- The origin `Spec k ⟶ 𝔸¹_k` is a closed immersion that is not a thickening: `x` is not
nilpotent in `k[x]`. -/
theorem TauCeti.AlgebraicGeometry.not_isThickening_origin : ¬ IsThickening
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(X : k[X])})))) := by
  rw [IsThickening.SpecMap_iff _ Ideal.Quotient.mk_surjective, CommRingCat.hom_ofHom, Ideal.mk_ker]
  -- `x` is not nilpotent in the domain `k[x]`.
  simp

/-- Identities are first-order thickenings. -/
example (X : Scheme.{u}) : IsFirstOrderThickening (𝟙 X) := inferInstance
