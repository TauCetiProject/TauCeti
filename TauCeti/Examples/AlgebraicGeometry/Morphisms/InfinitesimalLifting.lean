module

public import Mathlib.Algebra.TrivSqZeroExt.Ideal
public import Mathlib.AlgebraicGeometry.Morphisms.FormallyUnramified
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import TauCeti.AlgebraicGeometry.Morphisms.FormallySmooth.AffineSpace
public import TauCeti.RingTheory.MvPolynomial.Ideal

/-!
# Examples for thickenings and the infinitesimal lifting properties

For a commutative ring `k` (nontrivial where the statement needs it, e.g. a field):

* **A thickening of no finite order.** For `A = k[x₁, x₂, …] ⧸ (x₁, x₂², x₃³, …)`, the closed
  immersion `Spec k ⟶ Spec A` with every `x_n ↦ 0` is a thickening, but its ideal `I` is not
  nilpotent: `x_{m+1}^m` is a nonzero element of `I^m` for every `m`. A definition of thickenings
  asking for a nilpotent ideal would reject it.
* **Affine spaces are formally smooth.** For a scheme `S`, `𝔸(σ; S) ⟶ S` is formally smooth: it is
  the base change of `Spec ℤ[x_i, i ∈ σ] ⟶ Spec ℤ`, and a lift across a square-zero thickening
  amounts to lifting the coordinates. For `σ` empty it is an isomorphism, hence formally étale.
* **A closed point of the line is not formally smooth.** The origin `Spec k ⟶ 𝔸¹_k` is not formally
  smooth: the test map `Spec k[ε] ⟶ 𝔸¹_k` with coordinate `ε` would need to factor through the
  origin, forcing `ε = 0`; formally, the ideal `(x)` of the origin is not idempotent.
* **Formal unramifiedness.** The origin `Spec k ⟶ 𝔸¹_k` is formally unramified, as is every closed
  immersion, while `𝔸¹_k ⟶ Spec k` is not: the `k`-algebra maps `k[x] → k[ε]` with `x ↦ 0` and
  `x ↦ ε` are distinct lifts of the same map `k[x] → k`.

The thickenings of finite order are in
`TauCeti/Examples/AlgebraicGeometry/Morphisms/Thickening.lean`.

## References

* [Stacks Project, Example 10.32.2](https://stacks.math.columbia.edu/tag/0EGG), the ideal
  `(x₁, x₂, …)` of `k[x₁, x₂, …] ⧸ (x₁, x₂², x₃³, …)`, locally nilpotent but not nilpotent.
* [Stacks Project, Definition 37.11.1](https://stacks.math.columbia.edu/tag/02H0),
  [Definition 37.6.1](https://stacks.math.columbia.edu/tag/02H8) and
  [Definition 37.8.1](https://stacks.math.columbia.edu/tag/02HG), formally smooth, formally
  unramified and formally étale morphisms.
-/

public section

universe u

open CategoryTheory Limits AlgebraicGeometry TauCeti.AlgebraicGeometry

namespace TauCeti.InfinitesimalLiftingExamples

variable (k : Type u) [CommRing k]

/-! ### A thickening of no finite order -/

section InfiniteOrder

open MvPolynomial

/-- The ideal `(x₁, x₂², x₃³, …)` of `k[x₁, x₂, …]`; the variable `X n` stands for `x_{n+1}`. -/
noncomputable abbrev powIdeal : Ideal (MvPolynomial ℕ k) :=
  Ideal.span (Set.range fun n ↦ X n ^ (n + 1))

/-- The ring `A = k[x₁, x₂, …] ⧸ (x₁, x₂², x₃³, …)`. -/
abbrev A : Type u := MvPolynomial ℕ k ⧸ powIdeal k

/-- The map `A → k` sending every `x_n` to `0`. -/
noncomputable def evalZero : A k →+* k :=
  Ideal.Quotient.lift _ (eval 0) fun _ hp ↦
    (Ideal.span_le (I := RingHom.ker (eval 0))).mpr (by rintro _ ⟨n, rfl⟩; simp) hp

/-- `A → k` evaluates a representative at `0`. -/
theorem evalZero_mk (p : MvPolynomial ℕ k) : evalZero k (Ideal.Quotient.mk _ p) = eval 0 p := by
  simp [evalZero]

/-- `A → k` is surjective. -/
theorem evalZero_surjective : Function.Surjective (evalZero k) :=
  fun c ↦ ⟨Ideal.Quotient.mk _ (C c), by simp [evalZero_mk]⟩

/-- The class of `x_{n+1}` in `A` is nilpotent. -/
theorem isNilpotent_mk_X (n : ℕ) : IsNilpotent (Ideal.Quotient.mk (powIdeal k) (X n)) :=
  ⟨n + 1, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact Ideal.subset_span ⟨n, rfl⟩⟩

/-- `Spec k ⟶ Spec A` is a thickening: the kernel of `A → k` is generated by the nilpotent classes
of the variables. -/
theorem isThickening_evalZero : IsThickening (Spec.map (CommRingCat.ofHom (evalZero k))) := by
  rw [IsThickening.SpecMap_iff _ (evalZero_surjective k), CommRingCat.hom_ofHom]
  intro a ha
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hp : p ∈ idealOfVars ℕ k := by
    simpa [evalZero_mk, eval_zero, ← ker_constantCoeff] using ha
  have hle : idealOfVars ℕ k ≤ (nilradical (A k)).comap (Ideal.Quotient.mk _) := by
    rw [Ideal.span_le]
    rintro _ ⟨n, rfl⟩
    exact isNilpotent_mk_X k n
  exact hle hp

/-- The class of `x_{m+1}^m` is nonzero in `A`: the monomial ideal `(x₁, x₂², x₃³, …)` contains no
monomial `x_{m+1}^m`. -/
theorem mk_X_pow_ne_zero [Nontrivial k] (m : ℕ) :
    Ideal.Quotient.mk (powIdeal k) (X m ^ m) ≠ 0 := by
  rw [Ne, Ideal.Quotient.eq_zero_iff_mem]
  have hgen : (Set.range fun n ↦ (X n ^ (n + 1) : MvPolynomial ℕ k)) =
      (fun s ↦ monomial s 1) '' Set.range fun n ↦ Finsupp.single n (n + 1) := by
    ext
    simp [X_pow_eq_monomial]
  rw [powIdeal, hgen, X_pow_eq_monomial, mem_ideal_span_monomial_image]
  intro h
  obtain ⟨_, ⟨n, rfl⟩, hn⟩ := h (Finsupp.single m m) (by simp)
  have := Finsupp.le_def.mp hn n
  by_cases hnm : n = m
  · subst hnm
    simp at this
  · simp [Ne.symm hnm] at this

/-- `x_{m+1}^m` lies in the `m`-th power of the kernel of `A → k`. -/
theorem mk_X_pow_mem_ker_pow (m : ℕ) :
    Ideal.Quotient.mk (powIdeal k) (X m ^ m) ∈ RingHom.ker (evalZero k) ^ m := by
  rw [map_pow]
  exact Ideal.pow_mem_pow (by simp [evalZero_mk]) m

/-- **A thickening of no finite order.** The kernel of `A → k` is not nilpotent, although
`Spec k ⟶ Spec A` is a thickening. -/
theorem not_isNilpotent_ker_evalZero [Nontrivial k] :
    ¬ IsNilpotent (RingHom.ker (evalZero k)) := by
  rintro ⟨m, hm⟩
  exact mk_X_pow_ne_zero k m (by simpa [hm] using mk_X_pow_mem_ker_pow k m)

end InfiniteOrder

/-! ### Affine spaces -/

/-- **Affine space is formally smooth**: `𝔸(σ; S) ⟶ S` is the base change of
`Spec ℤ[x_i, i ∈ σ] ⟶ Spec ℤ`, which is formally smooth (the instance
`TauCeti.AlgebraicGeometry.FormallySmooth.affineSpace`). -/
theorem formallySmooth_affineSpace (σ : Type u) (S : Scheme.{u}) :
    FormallySmooth (𝔸(σ; S) ↘ S) :=
  inferInstance

/-- **Affine space of dimension `0` is formally étale**: for `σ` empty, `𝔸(σ; S) ⟶ S` is an
isomorphism, so lifts across square-zero thickenings exist and are unique. -/
theorem formallyEtale_affineSpace_of_isEmpty (σ : Type u) [IsEmpty σ] (S : Scheme.{u}) :
    FormallyEtale (𝔸(σ; S) ↘ S) :=
  inferInstance

/-! ### The origin of the affine line -/

open Polynomial

/-- **The origin of `𝔸¹_k` is not formally smooth.** The kernel `(x)` of `k[x] → k[x] ⧸ (x)` is not
idempotent, since `x ∉ (x²)`. -/
theorem not_formallySmooth_origin [Nontrivial k] : ¬ FormallySmooth
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(X : k[X])})))) := by
  rw [formallySmooth_SpecMap_iff, CommRingCat.hom_ofHom, ← Ideal.Quotient.algebraMap_eq,
    RingHom.formallySmooth_algebraMap,
    Algebra.FormallySmooth.iff_of_surjective Ideal.Quotient.mk_surjective]
  intro h
  have hX : (X : k[X]) ∈ Ideal.span {(X : k[X])} := Ideal.mem_span_singleton_self _
  rw [Ideal.Quotient.algebraMap_eq, Ideal.mk_ker] at h
  rw [← h.eq, Ideal.span_singleton_mul_span_singleton, Ideal.mem_span_singleton] at hX
  obtain ⟨p, hp⟩ := hX
  simpa [mul_assoc, coeff_X_mul] using congr(($hp).coeff 1)

/-- **The origin of `𝔸¹_k` is formally unramified**, as is every closed immersion. -/
theorem formallyUnramified_origin : FormallyUnramified
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(X : k[X])})))) := by
  rw [HasRingHomProperty.Spec_iff (P := @FormallyUnramified), CommRingCat.hom_ofHom,
    ← Ideal.Quotient.algebraMap_eq, RingHom.formallyUnramified_algebraMap]
  infer_instance

/-- **`𝔸¹_k ⟶ Spec k` is not formally unramified.** The `k`-algebra maps `k[x] → k[ε]` with
`x ↦ 0` and `x ↦ ε` agree modulo the square-zero ideal `(ε)` but are distinct. -/
theorem not_formallyUnramified_affineLine [Nontrivial k] :
    ¬ FormallyUnramified (Spec.algebraMap k k[X]) := by
  rw [Spec.algebraMap, HasRingHomProperty.Spec_iff (P := @FormallyUnramified),
    CommRingCat.hom_ofHom, RingHom.formallyUnramified_algebraMap]
  intro h
  let I := TrivSqZeroExt.kerIdeal k k
  have hI : I ^ 2 = ⊥ := TrivSqZeroExt.kerIdeal_sq k k
  have heq := Algebra.FormallyUnramified.comp_injective (R := k) (A := k[X]) I hI
    (a₁ := aeval 0) (a₂ := aeval (TrivSqZeroExt.inr 1)) (by
      refine Polynomial.algHom_ext ?_
      simp only [AlgHom.comp_apply, aeval_X, Ideal.Quotient.mkₐ_eq_mk]
      refine (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr ?_
      simp [I, TrivSqZeroExt.mem_kerIdeal_iff_inr])
  have := congr(TrivSqZeroExt.snd ($heq X))
  simp at this

end TauCeti.InfinitesimalLiftingExamples
