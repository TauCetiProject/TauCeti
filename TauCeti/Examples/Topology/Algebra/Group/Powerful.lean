module

import Mathlib.Data.Nat.Choose.Dvd
import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.Topology.Instances.ZMod
import TauCeti.Topology.Algebra.Group.Heisenberg.Basic
import TauCeti.Topology.Algebra.Group.Powerful

/-!
# Regression examples: groups that are not powerful

These examples check from a downstream module that `TauCeti.IsPowerful` rejects the two finite
groups that distinguish it from weaker conditions:

* the dihedral group of order eight has its commutator subgroup inside the subgroup generated by
  its squares, as every group does, but not inside its fourth powers, which are all trivial; so it
  is not powerful at `2`, and asking for squares at `p = 2` would give the wrong predicate;
* for an odd prime `p`, the Heisenberg group over `ZMod p` has exponent `p` and a nontrivial
  commutator subgroup, so it is not powerful at `p`.
-/

open TauCeti

section Dihedral

variable [TopologicalSpace (DihedralGroup 4)] [DiscreteTopology (DihedralGroup 4)]

-- The dihedral group of order eight satisfies the square condition, but is not powerful at `2`.
example : commutator (DihedralGroup 4) ≤ closedPowerSubgroup 2 (DihedralGroup 4) ∧
    ¬ IsPowerful 2 (DihedralGroup 4) := by
  refine ⟨commutator_le_closedPowerSubgroup_two, fun h ↦ ?_⟩
  have hpow : closedPowerSubgroup 4 (DihedralGroup 4) ≤ ⊥ :=
    (closedPowerSubgroup_le_iff (isClosed_discrete _)).mpr fun g ↦ by
      have := Monoid.pow_exponent_eq_one g
      rwa [DihedralGroup.exponent, show lcm 4 2 = 4 by decide, ← Subgroup.mem_bot] at this
  have hbot := le_bot_iff.mp ((isPowerful_two_iff.mp h).trans hpow)
  exact DihedralGroup.not_commutative (by decide) (by decide) ((commutator_eq_bot_iff _).mp hbot)

end Dihedral

section Heisenberg

variable {p : ℕ} [Fact p.Prime]

-- For an odd prime `p`, the Heisenberg group over `ZMod p` is not powerful.
example (hp : p ≠ 2) : ¬ IsPowerful p (HeisenbergGroup (ZMod p)) := by
  intro h
  have hprime : p.Prime := Fact.out
  have hpow : closedPowerSubgroup p (HeisenbergGroup (ZMod p)) ≤ ⊥ :=
    (closedPowerSubgroup_le_iff (isClosed_discrete _)).mpr fun a ↦ by
      have hchoose : (p.choose 2 : ZMod p) = 0 :=
        (ZMod.natCast_eq_zero_iff _ _).mpr
          (hprime.dvd_choose_self two_ne_zero (lt_of_le_of_ne hprime.two_le (Ne.symm hp)))
      rw [Subgroup.mem_bot, HeisenbergGroup.pow_eq]
      ext <;> simp [nsmul_eq_mul, hchoose]
  have hbot := le_bot_iff.mp (((isPowerful_iff_of_ne_two hp).mp h).trans hpow)
  rw [HeisenbergGroup.commutator_eq_zAxis] at hbot
  have hz : (⟨0, 0, 1⟩ : HeisenbergGroup (ZMod p)) ∈ HeisenbergGroup.zAxis :=
    HeisenbergGroup.mem_zAxis_iff.mpr ⟨rfl, rfl⟩
  rw [hbot, Subgroup.mem_bot] at hz
  exact one_ne_zero (congrArg HeisenbergGroup.z hz)

end Heisenberg
