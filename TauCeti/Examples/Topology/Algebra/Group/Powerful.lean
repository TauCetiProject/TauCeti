module

public import Mathlib.GroupTheory.SpecificGroups.Dihedral
public import Mathlib.Topology.Instances.ZMod
public import TauCeti.Topology.Algebra.Group.Heisenberg.Basic
public import TauCeti.Topology.Algebra.Group.Powerful
import TauCeti.GroupTheory.SpecificGroups.Dihedral.Basic

/-!
# Regression examples: groups that are not powerful

These examples check from a downstream module that `TauCeti.IsPowerful` rejects the two finite
groups that distinguish it from weaker conditions:

* whenever `4 ∣ n`, the dihedral group `DihedralGroup n` has its commutator subgroup inside the
  subgroup generated by its squares, as every group does, but not inside its fourth powers; in
  particular `DihedralGroup 4` is not powerful at `2`, showing why asking for squares at `p = 2`
  would give the wrong predicate (`TauCeti.not_isPowerful_two_dihedralGroup`);
* for every prime `p`, the Heisenberg group over `ZMod p` has trivial `p`-th powers (or fourth
  powers at `p = 2`) and a nontrivial commutator subgroup, so it is not powerful at `p`
  (`TauCeti.not_isPowerful_heisenbergGroup_zmod`).

## Main results

* `TauCeti.not_isPowerful_two_dihedralGroup`: `DihedralGroup n` is not powerful at `2` when
  `4 ∣ n`.
* `TauCeti.not_isPowerful_heisenbergGroup_zmod`: `HeisenbergGroup (ZMod p)` is not powerful at `p`
  for every prime `p`.
-/

public section

namespace TauCeti

open Subgroup

/-- Whenever `4 ∣ n`, `DihedralGroup n` is not powerful at `p = 2`: every fourth power is a
rotation by a multiple of `4`, whereas `r 2 ∈ [D_n, D_n]`. Together with
`TauCeti.commutator_le_closedPowerSubgroup_two`, this shows why the fourth-power condition at
`p = 2` is strictly stronger than `[G, G] ≤ G²`. -/
theorem not_isPowerful_two_dihedralGroup {n : ℕ} (hn : 4 ∣ n)
    [TopologicalSpace (DihedralGroup n)] [DiscreteTopology (DihedralGroup n)] :
    ¬ IsPowerful 2 (DihedralGroup n) := fun hpow ↦ by
  let K : Subgroup (DihedralGroup n) :=
    { carrier := {g | ∃ i : ZMod n, g = DihedralGroup.r (4 * i)}
      mul_mem' := by rintro _ _ ⟨i, rfl⟩ ⟨j, rfl⟩; exact ⟨i + j, by simp [mul_add]⟩
      one_mem' := ⟨0, by simp⟩
      inv_mem' := by rintro _ ⟨i, rfl⟩; exact ⟨-i, by simp [mul_neg]⟩ }
  have h4le : closedPowerSubgroup 4 (DihedralGroup n) ≤ K :=
    (closedPowerSubgroup_le_iff (isClosed_discrete _)).mpr <| by
      rintro (i | i)
      · exact ⟨i, by rw [DihedralGroup.r_pow, Nat.cast_ofNat, mul_comm]⟩
      · have h4 : (4 : ℕ) = 2 * 2 := by decide
        exact ⟨0, by rw [h4, pow_mul]; simp [sq]⟩
  have hr2 : DihedralGroup.r (2 : ZMod n) ∈ K :=
    Subgroup.zpowers_le.mp <|
      commutator_dihedralGroup_eq_zpowers n ▸ (isPowerful_two_iff.mp hpow).trans h4le
  obtain ⟨i, hi⟩ := hr2
  have h := congrArg (ZMod.castHom hn (ZMod 4)) (DihedralGroup.r.inj hi)
  have h4z : (4 : ZMod 4) = 0 := by decide
  rw [map_ofNat, map_mul, map_ofNat, h4z, zero_mul] at h
  exact (by decide : (2 : ZMod 4) ≠ 0) h

/-- For every prime `p`, the finite Heisenberg group `HeisenbergGroup (ZMod p)` is not powerful
for `p`: every `p`-th power (or fourth power when `p = 2`) is trivial, while `(0, 0, 1)` lies in
the commutator subgroup. -/
theorem not_isPowerful_heisenbergGroup_zmod (p : ℕ) [hp : Fact p.Prime] :
    ¬ IsPowerful p (HeisenbergGroup (ZMod p)) := fun hpow ↦ by
  set e : ℕ := if p = 2 then 4 else p
  have hpe : p ∣ e := by
    dsimp only [e]
    rw [← pow_ite_eq_ite_four p]
    exact dvd_pow_self p (by split_ifs <;> omega)
  have hpe2 : p ∣ e.choose 2 := dvd_choose_two_ite_four hp.out
  have hzero : ∀ (m : ℕ) (r : ZMod p), p ∣ m → m • r = 0 := fun m r ⟨c, hc⟩ ↦ by
    rw [hc, nsmul_eq_mul, Nat.cast_mul, ZMod.natCast_self, zero_mul, zero_mul]
  have hbot : closedPowerSubgroup e (HeisenbergGroup (ZMod p)) = ⊥ :=
    le_bot_iff.mp ((closedPowerSubgroup_le_iff (isClosed_discrete _)).mpr fun a ↦ mem_bot.mpr <| by
      rw [HeisenbergGroup.pow_eq]; ext <;> simp [hzero e _ hpe, hzero (e.choose 2) _ hpe2])
  have hcomm : HeisenbergGroup.zAxis ≤ (⊥ : Subgroup (HeisenbergGroup (ZMod p))) := by
    rw [← HeisenbergGroup.commutator_eq_zAxis, ← hbot]
    exact isPowerful_iff.mp hpow
  have hz : (⟨0, 0, 1⟩ : HeisenbergGroup (ZMod p)) ∈ (⊥ : Subgroup _) :=
    hcomm (HeisenbergGroup.mem_zAxis_iff.mpr ⟨rfl, rfl⟩)
  exact one_ne_zero (congrArg HeisenbergGroup.z (mem_bot.mp hz))

section Dihedral

variable [TopologicalSpace (DihedralGroup 4)] [DiscreteTopology (DihedralGroup 4)]

-- The dihedral group of order eight satisfies the square condition, but is not powerful at `2`.
example : commutator (DihedralGroup 4) ≤ closedPowerSubgroup 2 (DihedralGroup 4) ∧
    ¬ IsPowerful 2 (DihedralGroup 4) :=
  ⟨commutator_le_closedPowerSubgroup_two, not_isPowerful_two_dihedralGroup (by decide)⟩

end Dihedral

section Heisenberg

variable {p : ℕ} [Fact p.Prime]

-- For every prime `p`, the Heisenberg group over `ZMod p` is not powerful.
example : ¬ IsPowerful p (HeisenbergGroup (ZMod p)) :=
  not_isPowerful_heisenbergGroup_zmod p

end Heisenberg

end TauCeti
