/-!
# Examples of smooth representations

For an open subgroup `U` of a topological group, the permutation representation on `A[G ⧸ U]` is
smooth and, for nontrivial `A`, its basis vector at the base coset has stabilizer `U`. Every
representation of a discrete group is smooth, and so is every trivial representation. The left
regular representations of the nondiscrete groups `ℚ₂` and `ℤ_p` (written multiplicatively) have no
nonzero smooth vector, and an infinite product `∏_n ℤ[ℤ_p ⧸ p^n ℤ_p]` is not smooth.

For the additive group `ℤ_[p]` of `p`-adic integers, written multiplicatively as
`Multiplicative ℤ_[p]`, the left regular representation on `ℤ[ℤ_[p]]` is not smooth and its only
smooth vector is `0`, while for `U = p ^ n ℤ_[p]` the permutation representation `ℤ[ℤ_[p] ⧸ U]` is
smooth and `U` fixes every vector. Finally, on `S₃` equipped with a non-group topology generated by
the point stabilizer of `2`, vectors with open stabilizer are not stable under `S₃`-translation.
-/

public section

open Filter Set Topology Representation TauCeti
open scoped MonoidAlgebra

namespace TauCeti

section BasicExamples

variable {A G V : Type*} [CommRing A] [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [AddCommGroup V] [Module A V]

example (U : OpenSubgroup G) : IsSmooth (ofMulAction A G (G ⧸ (U : Subgroup G))) :=
  inferInstance

example [Nontrivial A] (U : OpenSubgroup G) :
    (ofMulAction A G (G ⧸ (U : Subgroup G))).stabilizer
      (MonoidAlgebra.single (QuotientGroup.mk 1) 1) = U := by
  rw [stabilizer_ofMulAction_single _ one_ne_zero, MulAction.stabilizer_quotient]

example : IsSmooth (trivial A G V) := inferInstance

example [DiscreteTopology G] (ρ : Representation A G V) : ρ.smoothVectors = ⊤ := by simp

example : (leftRegular ℤ (Multiplicative ℚ_[2])).smoothVectors = ⊥ := by
  refine smoothVectors_leftRegular_eq_bot fun h ↦ ?_
  -- `Multiplicative ℚ_[2]` carries the topology of `ℚ_[2]` by definition, so `h` is
  -- discreteness of `ℚ_[2]` itself.
  have : DiscreteTopology ℚ_[2] := h
  exact (NormedField.nhdsNE_neBot (0 : ℚ_[2])).ne (discreteTopology_iff_nhds_ne.1 this 0)

end BasicExamples

section PadicGroup

variable (p : ℕ) [Fact p.Prime]

example :
    let H : ℕ → Subgroup (Multiplicative ℤ_[p]) :=
      fun n ↦ ((TauCeti.FiniteQuotientTower.padicTower p).ker n).toSubgroup
    ¬ (Representation.pi fun n ↦
        ofMulAction ℤ (Multiplicative ℤ_[p]) (Multiplicative ℤ_[p] ⧸ H n)).IsSmooth ∧
      (fun n ↦ MonoidAlgebra.single ((1 : Multiplicative ℤ_[p]) : Multiplicative ℤ_[p] ⧸ H n) 1) ∉
        (Representation.pi fun n ↦
          ofMulAction ℤ (Multiplicative ℤ_[p]) (Multiplicative ℤ_[p] ⧸ H n)).smoothVectors := by
  intro H
  have hnotOpen : ¬ IsOpen (((⨅ n, H n : Subgroup (Multiplicative ℤ_[p])) :
      Set (Multiplicative ℤ_[p]))) := by
    rw [(TauCeti.FiniteQuotientTower.padicTower p).iInf_ker_eq_bot]
    simpa using PadicInt.not_isOpen_singleton_one_multiplicative (p := p)
  exact ⟨not_isSmooth_pi_ofMulAction_quotient hnotOpen,
    notMem_smoothVectors_pi_ofMulAction_quotient hnotOpen⟩

end PadicGroup

-- Give `S₃` the topology generated by `H₀ = stabilizer (Perm (Fin 3)) 2`. In `ℚ[S₃ ⧸ H₀]`, the
-- basis vector at the identity coset has open stabilizer `H₀`, whereas its translate by `swap 1 2`
-- has stabilizer `stabilizer (Perm (Fin 3)) 1`, which is not open.
section BadTopologyS3

open Equiv

/-- The non-group topology on `Perm (Fin 3)` generated by the point stabilizer of `2`. -/
local instance permFin3BadTopologicalSpace : TopologicalSpace (Perm (Fin 3)) :=
  TopologicalSpace.generateFrom
    {(MulAction.stabilizer (Perm (Fin 3)) (2 : Fin 3) : Set (Perm (Fin 3)))}

example :
    let H₀ := MulAction.stabilizer (Perm (Fin 3)) (2 : Fin 3)
    let ρ := ofMulAction ℚ (Perm (Fin 3)) (Perm (Fin 3) ⧸ H₀)
    let e₀ : ℚ[Perm (Fin 3) ⧸ H₀] :=
      MonoidAlgebra.single ((1 : Perm (Fin 3)) : Perm (Fin 3) ⧸ H₀) 1
    IsOpen ((ρ.stabilizer e₀ : Subgroup (Perm (Fin 3))) : Set (Perm (Fin 3))) ∧
      ¬ IsOpen ((ρ.stabilizer (ρ (swap 1 2) e₀) : Subgroup (Perm (Fin 3))) :
        Set (Perm (Fin 3))) := by
  intro H₀ ρ e₀
  have he₀ : ρ.stabilizer e₀ = H₀ := by
    simp [e₀, ρ, stabilizer_ofMulAction_single _ (one_ne_zero' ℚ)]
  refine ⟨?_, fun hopen ↦ ?_⟩
  · rw [he₀]
    exact TopologicalSpace.isOpen_generateFrom_of_mem rfl
  · have hstab :
        ρ.stabilizer (ρ (swap 1 2) e₀) = MulAction.stabilizer (Perm (Fin 3)) (1 : Fin 3) := by
      rw [Representation.stabilizer_conj, he₀]
      simpa [H₀] using
        (MulAction.stabilizer_smul_eq_stabilizer_map_conj (swap (1 : Fin 3) 2) (2 : Fin 3)).symm
    have h02 : swap (0 : Fin 3) 2 ∈ ρ.stabilizer (ρ (swap 1 2) e₀) := by
      rw [hstab, MulAction.mem_stabilizer_iff]
      decide
    have hnot02 : swap (0 : Fin 3) 2 ∉ (H₀ : Set (Perm (Fin 3))) := by
      rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff]
      decide
    have hnhds : ((ρ.stabilizer (ρ (swap 1 2) e₀) : Subgroup (Perm (Fin 3))) :
        Set (Perm (Fin 3))) ∈ 𝓝 (swap (0 : Fin 3) 2) :=
      hopen.mem_nhds h02
    have htop : 𝓝 (swap (0 : Fin 3) 2) = ⊤ := by
      rw [TopologicalSpace.nhds_generateFrom, eq_top_iff]
      exact le_iInf₂ fun _ ⟨ha, hs⟩ ↦ (hnot02 (Set.mem_singleton_iff.mp hs ▸ ha)).elim
    rw [htop, Filter.mem_top] at hnhds
    have h12 : swap (1 : Fin 3) 2 ∈ ρ.stabilizer (ρ (swap 1 2) e₀) :=
      Set.eq_univ_iff_forall.mp hnhds (swap 1 2)
    rw [hstab, MulAction.mem_stabilizer_iff] at h12
    exact absurd h12 (by decide)

end BadTopologyS3

/-! ### The left regular representation of `ℤ_[p]` -/

section PadicInt

variable (p : ℕ) [Fact p.Prime]

/-- The left regular representation of `ℤ_[p]` on `ℤ[ℤ_[p]]` is not smooth. -/
theorem not_isSmooth_leftRegular_padicInt :
    ¬IsSmooth (leftRegular ℤ (Multiplicative ℤ_[p])) := by
  rw [leftRegular, isSmooth_ofMulAction_iff]
  exact fun h ↦ PadicInt.not_isOpen_singleton_one_multiplicative (by simpa using h 1)

/-- The only smooth vector of the left regular representation of `ℤ_[p]` on `ℤ[ℤ_[p]]` is `0`. -/
theorem smoothVectors_leftRegular_padicInt_eq_bot :
    (leftRegular ℤ (Multiplicative ℤ_[p])).smoothVectors = ⊥ :=
  smoothVectors_leftRegular_eq_bot fun _ ↦
    PadicInt.not_isOpen_singleton_one_multiplicative (p := p) (isOpen_discrete _)

/-! ### Permutation representations on `ℤ_[p] ⧸ p ^ n ℤ_[p]` -/

/-- The permutation representation `ℤ[ℤ_[p] ⧸ p ^ n ℤ_[p]]` is smooth. -/
example (n : ℕ) :
    IsSmooth (ofMulAction ℤ (Multiplicative ℤ_[p])
      (Multiplicative ℤ_[p] ⧸ (padicIntLevel p n).toSubgroup)) :=
  inferInstance

/-- Every vector of `ℤ[ℤ_[p] ⧸ p ^ n ℤ_[p]]` is fixed by `p ^ n ℤ_[p]`: the subgroup is normal,
so it acts trivially on the coset permutation representation. -/
example (n : ℕ) (f : ℤ[Multiplicative ℤ_[p] ⧸ (padicIntLevel p n).toSubgroup])
    (u : Multiplicative ℤ_[p]) (hu : u ∈ (padicIntLevel p n).toSubgroup) :
    ofMulAction ℤ (Multiplicative ℤ_[p]) _ u f = f :=
  le_stabilizer_of_isTrivial_comp_subtype (ofMulAction ℤ (Multiplicative ℤ_[p]) _)
    (padicIntLevel p n).toSubgroup f hu

end PadicInt

end TauCeti
