/-!
# Regression examples: compact open subgroups, smooth vectors, and counterexamples

These downstream examples exercise the API of `TauCeti.Topology.Algebra.Group.OpenSubgroup.Compact`
and `TauCeti.RepresentationTheory.Smooth.Basic` on concrete `p`-adic, real, and finite groups:

* `ℚ_[p]` and `ℤ_[p]` satisfy van Dantzig's compact-open-subgroup basis property automatically via
  typeclass synthesis, and the translation stabilizer of the clopen unit ball `ℤ_[p] ⊆ ℚ_[p]` is
  `ℤ_[p]` itself;
* in the discrete symmetric group `S₃ = Equiv.Perm (Fin 3)`, the clopen subset
  `C = {1, swap 0 1, swap 0 2}` contains `1` and is compact and open, is not a subgroup, and has
  left-translation stabilizer `{1} = ⊥`, showing that `IsCompact.isOpen_stabilizer_of_isOpen`
  genuinely shrinks a non-subgroup clopen neighbourhood to a subgroup;
* in `ℝ`, the open interval `(-1, 1)` contains no open additive subgroup, so local compactness
  without total disconnectedness does not give van Dantzig's conclusion
  (`¬ NonarchimedeanAddGroup ℝ`);
* for the non-discrete profinite group `Multiplicative ℤ_[p]`, the left regular representation
  `ℤ[Multiplicative ℤ_[p]]` has `(leftRegular ℤ (Multiplicative ℤ_[p])).smoothVectors = ⊥` and is
  not smooth;
* for each congruence open subgroup `U_n = p^n ℤ_[p]` of `Multiplicative ℤ_[p]`, the coset
  permutation representation `ℤ[Multiplicative ℤ_[p] ⧸ U_n]` is smooth and every element of `U_n`
  fixes every vector;
* the countable product `∏_n ℤ[Multiplicative ℤ_[p] ⧸ U_n]` of smooth representations is *not*
  smooth: the tuple of coset basepoints has stabilizer `⋂_n U_n = {1}`, which is not open;
* equipping `S₃` with the non-group topology generated by the single subgroup `⟨swap 0 1⟩` gives a
  representation `ℚ[S₃ ⧸ ⟨swap 0 1⟩]` in which the basepoint has open stabilizer `⟨swap 0 1⟩` while
  its `swap 1 2`-translate has non-open stabilizer `⟨swap 0 2⟩`, demonstrating that separate
  continuity of multiplication is essential for `smoothVectors` to be `G`-invariant.
-/

public section

noncomputable section

open Filter Metric Representation Set Topology
open scoped MonoidAlgebra Pointwise

namespace TauCeti.Examples.Smooth

section PadicChecks

variable (p : ℕ) [Fact p.Prime]

/-- Typeclass synthesis furnishes van Dantzig's compact open additive subgroup basis on `ℚ_[p]`. -/
theorem padic_nhds_zero_hasBasis_isCompact_openAddSubgroup :
    (𝓝 (0 : ℚ_[p])).HasBasis
      (fun H : OpenAddSubgroup ℚ_[p] ↦ IsCompact (H : Set ℚ_[p]))
      (fun H ↦ (H : Set ℚ_[p])) :=
  TauCeti.IsTopologicalAddGroup.nhds_zero_hasBasis_isCompact_openAddSubgroup ℚ_[p]

/-- Every `ℚ_[p]` is a nonarchimedean additive topological group. -/
theorem padic_nonarchimedeanAddGroup : NonarchimedeanAddGroup ℚ_[p] :=
  TauCeti.IsTopologicalAddGroup.nonarchimedeanAddGroup_of_weaklyLocallyCompactSpace

/-- `ℤ_[p]` bundled as an open additive subgroup of `ℚ_[p]`. -/
def padicIntOpenAddSubgroup : OpenAddSubgroup ℚ_[p] where
  carrier := {y : ℚ_[p] | ‖y‖ ≤ 1}
  add_mem' {a b} ha hb := (IsUltrametricDist.norm_add_le_max a b).trans (max_le ha hb)
  zero_mem' := by simp
  neg_mem' {a} ha := by simpa using ha
  isOpen' := by
    simpa only [Metric.closedBall, dist_eq_norm_sub, sub_zero] using
      IsUltrametricDist.isOpen_closedBall (0 : ℚ_[p]) one_ne_zero

/-- The translation stabilizer of `ℤ_[p] ⊆ ℚ_[p]` is `ℤ_[p]` itself. -/
theorem stabilizer_padicIntOpenAddSubgroup :
    AddAction.stabilizer ℚ_[p] ((padicIntOpenAddSubgroup p).toAddSubgroup : Set ℚ_[p]) =
      (padicIntOpenAddSubgroup p).toAddSubgroup :=
  (padicIntOpenAddSubgroup p).toAddSubgroup.stabilizer_coe

/-- The congruence open subgroup `p^n ℤ_[p]` viewed inside `Multiplicative ℤ_[p]`. -/
def padicCongruenceOpenSubgroup (n : ℕ) : OpenSubgroup (Multiplicative ℤ_[p]) :=
  ⟨(Ideal.span {(p : ℤ_[p]) ^ n}).toAddSubgroup.toSubgroup, by
    have hopen : IsOpen ((Ideal.span {(p : ℤ_[p]) ^ n} : Ideal ℤ_[p]) : Set ℤ_[p]) := by
      have hball : ((Ideal.span {(p : ℤ_[p]) ^ n} : Ideal ℤ_[p]) : Set ℤ_[p]) =
          Metric.closedBall (0 : ℤ_[p]) ((p : ℝ) ^ (-n : ℤ)) := by
        ext x
        rw [SetLike.mem_coe, Metric.mem_closedBall, dist_zero_right,
          PadicInt.norm_le_pow_iff_mem_span_pow]
      rw [hball]
      exact IsUltrametricDist.isOpen_closedBall (0 : ℤ_[p])
        (zpow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero))
    -- `Multiplicative ℤ_[p]` carries the topology of `ℤ_[p]` pulled back along `toAdd`.
    exact hopen.preimage continuous_id⟩

/-- The profinite group `Multiplicative ℤ_[p]` is not discrete. -/
theorem not_discreteTopology_multiplicative_padicInt :
    ¬ DiscreteTopology (Multiplicative ℤ_[p]) := by
  intro hdisc
  have hfin : Finite (Multiplicative ℤ_[p]) := finite_of_compact_of_discrete
  have hfin' : Finite ℤ_[p] := Finite.of_equiv _ Multiplicative.toAdd
  have hinf : Infinite ℤ_[p] := Infinite.of_injective (Nat.cast : ℕ → ℤ_[p]) Nat.cast_injective
  exact not_finite ℤ_[p]

/-- The left regular representation `ℤ[Multiplicative ℤ_[p]]` has no nonzero smooth vectors. -/
theorem smoothVectors_leftRegular_padicInt_eq_bot :
    (Representation.leftRegular ℤ (Multiplicative ℤ_[p])).smoothVectors = ⊥ :=
  Representation.smoothVectors_leftRegular_eq_bot
    (not_discreteTopology_multiplicative_padicInt p)

/-- In particular, `ℤ[Multiplicative ℤ_[p]]` is not smooth. -/
theorem not_isSmooth_leftRegular_padicInt :
    ¬ (Representation.leftRegular ℤ (Multiplicative ℤ_[p])).IsSmooth := by
  rw [Representation.isSmooth_leftRegular_iff_discreteTopology]
  exact not_discreteTopology_multiplicative_padicInt p

-- Each coset permutation representation `ℤ[Multiplicative ℤ_[p] ⧸ p^n ℤ_[p]]` is smooth.
example (n : ℕ) :
    (Representation.ofMulAction ℤ (Multiplicative ℤ_[p])
      (Multiplicative ℤ_[p] ⧸ (padicCongruenceOpenSubgroup p n).toSubgroup)).IsSmooth :=
  inferInstance

/-- Every element of `p^n ℤ_[p]` fixes every vector of `ℤ[Multiplicative ℤ_[p] ⧸ p^n ℤ_[p]]`. -/
theorem padicCongruence_quotient_apply_of_mem (n : ℕ) {g : Multiplicative ℤ_[p]}
    (hg : g ∈ padicCongruenceOpenSubgroup p n)
    (f : MonoidAlgebra ℤ
      (Multiplicative ℤ_[p] ⧸ (padicCongruenceOpenSubgroup p n).toSubgroup)) :
    Representation.ofMulAction ℤ (Multiplicative ℤ_[p])
      (Multiplicative ℤ_[p] ⧸ (padicCongruenceOpenSubgroup p n).toSubgroup) g f = f :=
  Representation.ofMulAction_quotient_apply_of_mem hg f

-- An arbitrary direct sum of these smooth coset representations is smooth.
example :
    (Representation.directSum fun n : ℕ ↦
      Representation.ofMulAction ℤ (Multiplicative ℤ_[p])
        (Multiplicative ℤ_[p] ⧸ (padicCongruenceOpenSubgroup p n).toSubgroup)).IsSmooth :=
  inferInstance

/-- The countable product `∏_n ℤ[Multiplicative ℤ_[p] ⧸ p^n ℤ_[p]]` of smooth representations is
not smooth: the family of trivial-coset basis vectors has trivial (hence non-open) stabilizer. -/
theorem not_isSmooth_pi_padicCongruence :
    let ρ : ∀ n : ℕ, Representation ℤ (Multiplicative ℤ_[p])
        (MonoidAlgebra ℤ
          (Multiplicative ℤ_[p] ⧸ (padicCongruenceOpenSubgroup p n).toSubgroup)) :=
      fun n ↦ Representation.ofMulAction ℤ (Multiplicative ℤ_[p]) _
    let v₀ : ∀ n : ℕ, MonoidAlgebra ℤ
        (Multiplicative ℤ_[p] ⧸ (padicCongruenceOpenSubgroup p n).toSubgroup) :=
      fun _ ↦ MonoidAlgebra.single 1 1
    v₀ ∉ (Representation.pi ρ).smoothVectors ∧ ¬ (Representation.pi ρ).IsSmooth := by
  intro ρ v₀
  have hstab : (Representation.pi ρ).stabilizer v₀ = ⊥ := by
    rw [Representation.stabilizer_pi, eq_bot_iff]
    intro g hg
    rw [Subgroup.mem_iInf] at hg
    rw [Subgroup.mem_bot]
    apply Multiplicative.toAdd.injective
    rw [toAdd_one]
    by_contra hne
    have hpos : 0 < ‖Multiplicative.toAdd g‖ := norm_pos_iff.mpr hne
    obtain ⟨n, hn⟩ := PadicInt.exists_pow_neg_lt p hpos
    have hgn : g ∈ (padicCongruenceOpenSubgroup p n).toSubgroup := by
      have hgn' := hg n
      rwa [Representation.stabilizer_ofMulAction_single _ one_ne_zero,
        ← QuotientGroup.mk_one, MulAction.stabilizer_quotient] at hgn'
    have hle : ‖Multiplicative.toAdd g‖ ≤ (p : ℝ) ^ (-n : ℤ) :=
      (PadicInt.norm_le_pow_iff_mem_span_pow (Multiplicative.toAdd g) n).mpr hgn
    exact not_lt_of_ge hle hn
  have hnot_open : ¬ IsOpen ((Representation.pi ρ).stabilizer v₀ : Set (Multiplicative ℤ_[p])) := by
    rw [hstab, Subgroup.coe_bot]
    intro hopen
    exact not_discreteTopology_multiplicative_padicInt p
      (discreteTopology_iff_isOpen_singleton_one.mpr hopen)
  refine ⟨by simpa [Representation.mem_smoothVectors] using hnot_open, fun hsmooth ↦ ?_⟩
  exact hnot_open (hsmooth.isOpen_stabilizer v₀)

end PadicChecks

section RealAndDiscreteChecks

/-- In `ℝ`, the open interval `(-1, 1)` contains no open additive subgroup. -/
theorem real_not_exists_openAddSubgroup_subset_Ioo :
    ¬ ∃ H : OpenAddSubgroup ℝ, (H : Set ℝ) ⊆ Set.Ioo (-1 : ℝ) 1 := by
  rintro ⟨H, hH⟩
  have hclopen : IsClopen (H : Set ℝ) := ⟨H.isClosed, H.isOpen⟩
  have huniv : (H : Set ℝ) = Set.univ := hclopen.eq_univ ⟨(0 : ℝ), H.zero_mem⟩
  have h1 : (1 : ℝ) ∈ Set.Ioo (-1 : ℝ) 1 := hH (huniv ▸ Set.mem_univ (1 : ℝ))
  exact lt_irrefl (1 : ℝ) h1.2

/-- Local compactness and the Hausdorff property do not imply `NonarchimedeanAddGroup` without
total disconnectedness: `ℝ` is not nonarchimedean. -/
theorem real_not_nonarchimedeanAddGroup : ¬ NonarchimedeanAddGroup ℝ := by
  intro hna
  obtain ⟨H, hH⟩ := NonarchimedeanAddGroup.is_nonarchimedean (Set.Ioo (-1 : ℝ) 1)
    (isOpen_Ioo.mem_nhds ⟨by norm_num, by norm_num⟩)
  exact real_not_exists_openAddSubgroup_subset_Ioo ⟨H, hH⟩

/-- In discrete `S₃ = Equiv.Perm (Fin 3)`, the clopen compact subset `C = {1, swap 0 1, swap 0 2}`
contains `1` and is not a subgroup, and its left-translation stabilizer is `{1} = ⊥`. -/
theorem perm3_clopen_stabilizer_eq_bot :
    let _ : TopologicalSpace (Equiv.Perm (Fin 3)) := ⊥
    let _ : DiscreteTopology (Equiv.Perm (Fin 3)) := ⟨rfl⟩
    let C : Set (Equiv.Perm (Fin 3)) := {1, Equiv.swap 0 1, Equiv.swap 0 2}
    IsCompact C ∧ IsOpen C ∧ (1 : Equiv.Perm (Fin 3)) ∈ C ∧
      Equiv.swap 0 1 * Equiv.swap 0 2 ∉ C ∧
      MulAction.stabilizer (Equiv.Perm (Fin 3)) C = ⊥ := by
  intro _ _ C
  have h1C : (1 : Equiv.Perm (Fin 3)) ∈ C := by simp [C]
  refine ⟨Set.toFinite C |>.isCompact, isOpen_discrete C, h1C, ?_, ?_⟩
  · intro hmem
    rcases hmem with h1 | h01 | h02
    · have := Equiv.Perm.ext_iff.mp h1 1; revert this; decide
    · have := Equiv.Perm.ext_iff.mp h01 2; revert this; decide
    · have := Equiv.Perm.ext_iff.mp h02 1; revert this; decide
  · rw [eq_bot_iff]
    intro g hg
    have hg1 : g ∈ C := TauCeti.stabilizer_set_subset_of_one_mem h1C hg
    rw [MulAction.mem_stabilizer_iff] at hg
    rcases hg1 with rfl | rfl | rfl
    · exact Subgroup.one_mem ⊥
    · exfalso
      have hmem : (Equiv.swap 0 1 : Equiv.Perm (Fin 3)) • Equiv.swap 0 2 ∈
          (Equiv.swap 0 1 : Equiv.Perm (Fin 3)) • C :=
        Set.smul_mem_smul_set (by simp [C])
      rw [hg, smul_eq_mul] at hmem
      rcases hmem with h1 | h01 | h02
      · have := Equiv.Perm.ext_iff.mp h1 1; revert this; decide
      · have := Equiv.Perm.ext_iff.mp h01 2; revert this; decide
      · have := Equiv.Perm.ext_iff.mp h02 1; revert this; decide
    · exfalso
      have hmem : (Equiv.swap 0 2 : Equiv.Perm (Fin 3)) • Equiv.swap 0 1 ∈
          (Equiv.swap 0 2 : Equiv.Perm (Fin 3)) • C :=
        Set.smul_mem_smul_set (by simp [C])
      rw [hg, smul_eq_mul] at hmem
      rcases hmem with h1 | h01 | h02
      · have := Equiv.Perm.ext_iff.mp h1 2; revert this; decide
      · have := Equiv.Perm.ext_iff.mp h01 2; revert this; decide
      · have := Equiv.Perm.ext_iff.mp h02 1; revert this; decide

/-- Without `SeparatelyContinuousMul`, the set of vectors with open stabilizer need not be
`G`-invariant: on `S₃` equipped with the topology generated by `{⟨swap 0 1⟩}`, the basepoint of
`ℚ[S₃ ⧸ ⟨swap 0 1⟩]` has open stabilizer `⟨swap 0 1⟩`, whereas its `swap 1 2`-translate has
stabilizer `⟨swap 0 2⟩`, which is not open. -/
theorem perm3_open_stabilizer_not_invariant_without_separatelyContinuousMul :
    let G := Equiv.Perm (Fin 3)
    let H : Subgroup G := Subgroup.zpowers (Equiv.swap 0 1)
    let τ : TopologicalSpace G := TopologicalSpace.generateFrom {(H : Set G)}
    let ρ : Representation ℚ G (MonoidAlgebra ℚ (G ⧸ H)) := Representation.ofMulAction ℚ G (G ⧸ H)
    let v : MonoidAlgebra ℚ (G ⧸ H) := MonoidAlgebra.single ((1 : G) : G ⧸ H) 1
    @IsOpen G τ (ρ.stabilizer v : Set G) ∧
      ¬ @IsOpen G τ (ρ.stabilizer (ρ (Equiv.swap 1 2) v) : Set G) := by
  intro G H τ ρ v
  have hstab_v : ρ.stabilizer v = H := by
    rw [Representation.stabilizer_ofMulAction_single _ one_ne_zero, MulAction.stabilizer_quotient]
  have hopen_v : @IsOpen G τ (ρ.stabilizer v : Set G) := by
    rw [hstab_v]
    exact TopologicalSpace.isOpen_generateFrom_of_mem (Set.mem_singleton _)
  refine ⟨hopen_v, fun hopen_gv ↦ ?_⟩
  have h1_in_H_of_open : ∀ U : Set G, @IsOpen G τ U → (1 : G) ∈ U → Equiv.swap 0 1 ∈ U := by
    intro U hU
    induction hU with
    | basic s hs =>
      intro _
      rw [Set.mem_singleton_iff.mp hs]
      exact Subgroup.mem_zpowers (Equiv.swap 0 1)
    | univ => intro _; trivial
    | inter s t _ _ ihs iht =>
      exact fun ⟨h1s, h1t⟩ ↦ ⟨ihs h1s, iht h1t⟩
    | sUnion S _ ih =>
      rintro ⟨s, hsS, h1s⟩
      exact Set.mem_sUnion.mpr ⟨s, hsS, ih s hsS h1s⟩
  have hmem : Equiv.swap 0 1 ∈ ρ.stabilizer (ρ (Equiv.swap 1 2) v) :=
    h1_in_H_of_open _ hopen_gv (Subgroup.one_mem _)
  rw [ρ.stabilizer_conj, hstab_v, Subgroup.mem_map] at hmem
  obtain ⟨h, hh, hconj⟩ := hmem
  rw [Subgroup.mem_zpowers_iff] at hh
  obtain ⟨k, rfl⟩ := hh
  rcases Int.even_or_odd k with ⟨m, rfl⟩ | ⟨m, rfl⟩
  · have hpow : (Equiv.swap 0 1 : G) ^ (m + m) = 1 := by
      rw [← two_mul, zpow_mul, zpow_two, Equiv.swap_mul_self, one_zpow]
    rw [hpow] at hconj
    have := Equiv.Perm.ext_iff.mp hconj 0
    revert this; decide
  · have hpow : (Equiv.swap 0 1 : G) ^ (2 * m + 1) = Equiv.swap 0 1 := by
      rw [zpow_add, zpow_one, zpow_mul, zpow_two, Equiv.swap_mul_self, one_zpow, one_mul]
    rw [hpow] at hconj
    have := Equiv.Perm.ext_iff.mp hconj 1
    revert this; decide

end RealAndDiscreteChecks

end TauCeti.Examples.Smooth
