module

public import Mathlib.Algebra.Field.ZMod
public import Mathlib.RepresentationTheory.Maschke
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Borel
public import TauCeti.RepresentationTheory.Augmentation.Semisimple
public import TauCeti.RepresentationTheory.ClassicalGroups.Standard
public import TauCeti.RepresentationTheory.Subrepresentation.Semisimple

/-!
# Checks for semisimplicity under restriction

* For `H = G`, restriction to `H` changes nothing, so it preserves and reflects semisimplicity.
* In characteristic `p`, the regular representation of the cyclic group of order `p` restricts
  semisimply to the trivial subgroup but is not semisimple: ascent along a subgroup needs the
  index to be invertible.
* The standard representation of `GL₂(𝔽₂)` (a group isomorphic to `S₃`) restricted to the Borel
  subgroup of upper-triangular matrices, of order two and generated by the transvection
  `!![1, 1; 0, 1]`, is a nontrivial unipotent extension of the trivial line by itself, so it is
  not semisimple.
-/

public section

open Representation

namespace TauCeti.SemisimpleRestrictionChecks

/-- For `H = G`, restriction preserves and reflects semisimplicity. -/
example {k G V : Type*} [Field k] [Group G] [AddCommGroup V] [Module k V]
    (ρ : Representation k G V) :
    IsSemisimpleRepresentation (ρ.comp (⊤ : Subgroup G).subtype) ↔
      IsSemisimpleRepresentation ρ :=
  MonoidHom.isSemisimpleRepresentation_comp_surjective_iff _
    (fun g ↦ ⟨⟨g, Subgroup.mem_top g⟩, rfl⟩) ρ

section Cyclic

variable (p : ℕ) [Fact p.Prime]

/-- Every representation of the trivial subgroup is semisimple, by Maschke's theorem. -/
example : IsSemisimpleRepresentation
    ((leftRegular (ZMod p) (Multiplicative (ZMod p))).comp
      (⊥ : Subgroup (Multiplicative (ZMod p))).subtype) := by
  have : NeZero (Nat.card (⊥ : Subgroup (Multiplicative (ZMod p))) : ZMod p) := by
    rw [Subgroup.card_bot, Nat.cast_one]
    infer_instance
  infer_instance

/-- The regular representation of the cyclic group of order `p` over `𝔽_p` is not semisimple. -/
example : ¬ (leftRegular (ZMod p) (Multiplicative (ZMod p))).IsSemisimpleRepresentation :=
  not_isSemisimpleRepresentation_leftRegular (by
    rw [Nat.card_eq_fintype_card, Fintype.card_multiplicative, ZMod.card, ZMod.natCast_self])

end Cyclic

section GL2

/-- The standard representation of `GL₂(𝔽₂)` restricted to the Borel subgroup, a subgroup of order
two generated by a transvection, is not semisimple. -/
example : ¬ IsSemisimpleRepresentation
    ((stdRep (ZMod 2) 2).comp (GL2Borel (ZMod 2)).subtype) := by
  have h10 (g : GL2Borel (ZMod 2)) : (g : GL (Fin 2) (ZMod 2)) 1 0 = 0 :=
    GL2Borel.apply_one_zero g
  -- The diagonal entries of an element of the Borel subgroup of `GL₂(𝔽₂)` are units, hence `1`.
  have hdiag (g : GL2Borel (ZMod 2)) (i : Fin 2) :
      (g : GL (Fin 2) (ZMod 2)) i i = 1 := by
    fin_cases i
    · simpa using (GL2Borel.diag_fst_val g).symm.trans (congrArg Units.val (Subsingleton.elim _ 1))
    · simpa using (GL2Borel.diag_snd_val g).symm.trans (congrArg Units.val (Subsingleton.elim _ 1))
  have happ (g : GL2Borel (ZMod 2)) (v : Fin 2 → ZMod 2) (i : Fin 2) :
      (stdRep (ZMod 2) 2).comp (GL2Borel (ZMod 2)).subtype g v i =
        ∑ j, (g : GL (Fin 2) (ZMod 2)) i j * v j := by
    rw [MonoidHom.comp_apply, stdRep_apply_apply]
    simp [Matrix.mulVec, dotProduct]
  -- The line `{v | v 1 = 0}` spanned by `e₀` is a subrepresentation.
  let W : Subrepresentation ((stdRep (ZMod 2) 2).comp (GL2Borel (ZMod 2)).subtype) :=
    ⟨LinearMap.ker (LinearMap.proj 1), fun g v hv ↦ by
      simp only [LinearMap.mem_ker, LinearMap.proj_apply] at hv ⊢
      rw [happ, Fin.sum_univ_two, h10, hdiag, hv]
      ring⟩
  refine not_isSemisimpleRepresentation_of_apply_ne W (fun g w hw ↦ ?_) (fun g v ↦ ?_)
    (g := ⟨GL2Borel.mk 1 1 1, GL2Borel.mk_mem 1 1 1⟩) (v := Pi.single 1 1) ?_
  · have hw : w 1 = 0 := LinearMap.mem_ker.1 hw
    funext i
    rw [happ, Fin.sum_univ_two, hw]
    fin_cases i
    · simp [hdiag]
    · simp [h10, hw]
  · rw [LinearMap.mem_ker, LinearMap.proj_apply, Pi.sub_apply, happ, Fin.sum_univ_two, h10,
      hdiag]
    ring
  · intro h
    have := congrFun h 0
    rw [happ, Fin.sum_univ_two] at this
    simp [GL2Borel.coe_mk] at this

end GL2

end TauCeti.SemisimpleRestrictionChecks
