import TauCeti.RingTheory.Idempotents.Projective

/-!
# The Nakayama module of the first column of the upper triangular algebra

For the upper triangular matrix algebra `T₂(k)`, the two column ideals are the left ideals
generated by the diagonal matrix units. The first column is simple projective. Its Nakayama
module is the second column, and right multiplication by the upper off-diagonal matrix unit
embeds the first column into the second as an injective envelope.

The pairing for the Nakayama isomorphism evaluates an algebra-valued functional at the first
diagonal matrix unit, multiplies the resulting row by the second column, and takes the
upper off-diagonal entry.

* `firstColumnNakayamaEquiv` identifies the second column with the Nakayama module.
* `isInjectiveEnvelope_firstColumnInclusion` identifies the envelope map.
* `length_secondColumn` computes the composition length of the envelope.

## References

* M. Auslander, I. Reiten, S. O. Smalø, *Representation Theory of Artin Algebras*,
  Cambridge University Press (1995), Propositions II.4.3 and II.4.6.
-/

public section

namespace TauCeti.UpperTriangularTwo

universe u

local notation "T₂[" k "]" => Matrix.blockTriangularSubalgebra k k (id : Fin 2 → Fin 2)

section MatrixUnits

variable (k : Type u) [CommSemiring k]

/-- The diagonal matrix unit at index `i` in the upper triangular algebra. -/
def diagonalUnit (i : Fin 2) : T₂[k] :=
  ⟨Matrix.single i i 1, Matrix.blockTriangular_single le_rfl _⟩

/-- The underlying matrix of the diagonal matrix unit. -/
@[simp]
theorem coe_diagonalUnit (i : Fin 2) :
    (diagonalUnit k i : Matrix (Fin 2) (Fin 2) k) = Matrix.single i i 1 := (rfl)

/-- The diagonal matrix units are idempotent. -/
theorem isIdempotentElem_diagonalUnit (i : Fin 2) : IsIdempotentElem (diagonalUnit k i) :=
  Subtype.ext (by simp [Matrix.single_mul_single_same])

/-- Each column ideal is a projective module over the upper triangular algebra. -/
instance instProjectiveColumn (i : Fin 2) :
    Module.Projective T₂[k] (Ideal.span {diagonalUnit k i} : Ideal T₂[k]) :=
  (isIdempotentElem_diagonalUnit k i).projective_span_singleton

end MatrixUnits

variable (k : Type u) [Field k]

local notation "T₂" => T₂[k]

local notation "P" => fun i : Fin 2 ↦ (Ideal.span {diagonalUnit k i} : Ideal (T₂))

private def upperUnit : T₂ :=
  ⟨Matrix.single 0 1 1, Matrix.blockTriangular_single (by decide : (0 : Fin 2) ≤ 1) _⟩

private abbrev entry (x : T₂) (i j : Fin 2) : k :=
  (x : Matrix (Fin 2) (Fin 2) k) i j

private theorem entry_upperUnit (i j : Fin 2) :
    entry k (upperUnit k) i j = if 0 = i ∧ 1 = j then 1 else 0 :=
  Matrix.single_apply 0 1 1 i j

@[local simp] private theorem entry_diagonalUnit (i a j : Fin 2) :
    entry k (diagonalUnit k i) a j = if i = a ∧ i = j then 1 else 0 :=
  Matrix.single_apply i i 1 a j

@[local simp] private theorem entry_add (x y : T₂) (i j : Fin 2) :
    entry k (x + y) i j = entry k x i j + entry k y i j := (rfl)

@[local simp] private theorem entry_smul (c : k) (x : T₂) (i j : Fin 2) :
    entry k (c • x) i j = c * entry k x i j := (rfl)

@[local simp] private theorem entry_zero (i j : Fin 2) :
    entry k (0 : T₂) i j = 0 := (rfl)

private theorem entry_lower (a : T₂) : entry k a 1 0 = 0 :=
  a.property (by decide)

private theorem entry_mul (a b : T₂) (i j : Fin 2) :
    entry k (a * b) i j = entry k a i 0 * entry k b 0 j + entry k a i 1 * entry k b 1 j :=
  Matrix.mul_apply.trans (Fin.sum_univ_two _)

private theorem column_zero (i : Fin 2) (x : P i) (a j : Fin 2) (h : j ≠ i) :
    entry k (x : T₂) a j = 0 := by
  have hfix := (mem_span_singleton_iff_mul_eq_self (isIdempotentElem_diagonalUnit k i)).1 x.property
  calc
    _ = entry k ((x : T₂) * diagonalUnit k i) a j := congrArg (fun z ↦ entry k z a j) hfix.symm
    _ = 0 := by simp [entry_mul, Ne.symm h]

private theorem secondColumn_ext {x y : P 1}
    (h₀ : entry k (x : T₂) 0 1 = entry k (y : T₂) 0 1)
    (h₁ : entry k (x : T₂) 1 1 = entry k (y : T₂) 1 1) : x = y := by
  refine Subtype.ext (Subtype.ext (Matrix.ext fun i j ↦ ?_))
  fin_cases i <;> fin_cases j <;> first | exact h₀ | exact h₁ |
    simp [column_zero k 1 _ _ 0 (by decide)]

private theorem firstColumn_ext {x y : P 0}
    (h : entry k (x : T₂) 0 0 = entry k (y : T₂) 0 0) : x = y := by
  refine Subtype.ext (Subtype.ext (Matrix.ext fun i j ↦ ?_))
  fin_cases i <;> fin_cases j <;> first | exact h |
    simp [entry_lower, column_zero k 0 _ _ 1 (by decide)]

private theorem upperUnit_mem_secondColumn : upperUnit k ∈ P 1 :=
  (mem_span_singleton_iff_mul_eq_self (isIdempotentElem_diagonalUnit k 1)).2
    (Subtype.ext (by simp [upperUnit, Matrix.single_mul_single_same]))

private def upperColumn : P 1 :=
  ⟨upperUnit k, upperUnit_mem_secondColumn k⟩

/-- Right multiplication by the upper off-diagonal matrix unit embeds the first column ideal
into the second column ideal. -/
def firstColumnInclusion : (P 0) →ₗ[T₂] (P 1) :=
  ((LinearMap.mulRight (T₂) (upperUnit k)).comp (P 0).subtype).codRestrict (P 1)
    fun x ↦ (P 1).mul_mem_left (x : T₂) (upperUnit_mem_secondColumn k)

/-- The inclusion moves the first entry of the first column to the upper off-diagonal entry. -/
@[simp]
theorem coe_firstColumnInclusion_apply (x : P 0) :
    (((firstColumnInclusion k x : P 1) : T₂) : Matrix (Fin 2) (Fin 2) k) =
      Matrix.single 0 1 (((x : T₂) : Matrix (Fin 2) (Fin 2) k) 0 0) := by
  refine Matrix.ext fun i j ↦ ?_
  -- Use the entries of the product in the upper triangular subalgebra.
  change entry k ((firstColumnInclusion k x : P 1) : T₂) i j = _
  have h : (firstColumnInclusion k x : T₂) = (x : T₂) * upperUnit k := (rfl)
  rw [h]
  fin_cases i <;> fin_cases j <;> simp [entry_mul, entry_upperUnit, entry_lower]

private theorem entry_firstColumnInclusion (x : P 0) (i j : Fin 2) :
    entry k (firstColumnInclusion k x : T₂) i j =
      Matrix.single 0 1 (entry k (x : T₂) 0 0) i j :=
  congrArg (fun M : Matrix (Fin 2) (Fin 2) k ↦ M i j) (coe_firstColumnInclusion_apply k x)

local notation "D" => Module.Dual (T₂) (P 0)
local notation "ν" => MatlisDual k k D

private abbrev firstGenerator : P 0 := spanSingletonGenerator (diagonalUnit k 0)
private abbrev secondGenerator : P 1 := spanSingletonGenerator (diagonalUnit k 1)

private abbrev diagonalFunctional : D := (P 0).subtype
private abbrev upperFunctional : D := (P 1).subtype.comp (firstColumnInclusion k)

private theorem eval_firstGenerator_lower (f : D) :
    entry k (f (firstGenerator k)) 1 1 = 0 := by
  have h := congrArg f (smul_spanSingletonGenerator (isIdempotentElem_diagonalUnit k 0)
    (firstGenerator k))
  simp only [map_smul, coe_spanSingletonGenerator, smul_eq_mul] at h
  simpa [entry_mul] using congrArg (fun z ↦ entry k z 1 1) h.symm

private theorem dual_decomposition (f : D) :
    f = entry k (f (firstGenerator k)) 0 0 • diagonalFunctional k +
      entry k (f (firstGenerator k)) 0 1 • upperFunctional k := by
  apply LinearMap.ext
  intro x
  obtain ⟨a, rfl⟩ := exists_smul_spanSingletonGenerator x
  rw [map_smul, map_smul]
  congr 1
  simp only [LinearMap.add_apply, LinearMap.smul_apply, LinearMap.comp_apply,
    Submodule.subtype_apply, coe_spanSingletonGenerator]
  refine Subtype.ext (Matrix.ext fun i j ↦ ?_)
  -- All four entries can be compared in the subalgebra using the row formula.
  change entry k _ i j = entry k _ i j
  fin_cases i <;> fin_cases j <;>
    simp [entry_firstColumnInclusion, entry_lower, eval_firstGenerator_lower]

private def firstColumnNakayamaMap : (P 1) →ₗ[T₂] ν where
  toFun x := (MatlisDual.equivLinearMap k k D).symm
    { toFun := fun f ↦ entry k (f (firstGenerator k) * (x : T₂)) 0 1
      map_add' _ _ := by simp [add_mul]
      map_smul' _ _ := by simp }
  map_add' x y := by
    ext f
    simp [mul_add]
  map_smul' a x := by
    ext f
    simp [MatlisDual.smul_apply, smul_eq_mul, mul_assoc]

private theorem firstColumnNakayamaMap_apply (x : P 1) (f : D) :
    MatlisDual.equivLinearMap k k D (firstColumnNakayamaMap k x) f =
      entry k (f (firstGenerator k) * (x : T₂)) 0 1 := by
  simp [firstColumnNakayamaMap]

private theorem firstColumnNakayamaMap_diagonal (x : P 1) :
    MatlisDual.equivLinearMap k k D (firstColumnNakayamaMap k x) (diagonalFunctional k) =
      entry k (x : T₂) 0 1 := by
  simp [firstColumnNakayamaMap_apply, entry_mul]

private theorem firstColumnNakayamaMap_upper (x : P 1) :
    MatlisDual.equivLinearMap k k D (firstColumnNakayamaMap k x) (upperFunctional k) =
      entry k (x : T₂) 1 1 := by
  simp [firstColumnNakayamaMap_apply, entry_mul, entry_firstColumnInclusion]

private theorem firstColumnNakayamaMap_bijective :
    Function.Bijective (firstColumnNakayamaMap k) := by
  constructor
  · intro x y h
    apply secondColumn_ext k
    · simpa only [firstColumnNakayamaMap_diagonal] using
        congrArg (fun ξ ↦ MatlisDual.equivLinearMap k k D ξ (diagonalFunctional k)) h
    · simpa only [firstColumnNakayamaMap_upper] using
        congrArg (fun ξ ↦ MatlisDual.equivLinearMap k k D ξ (upperFunctional k)) h
  · intro ξ
    let F := MatlisDual.equivLinearMap k k D ξ
    refine ⟨F (diagonalFunctional k) • upperColumn k + F (upperFunctional k) • secondGenerator k,
      MatlisDual.ext fun f ↦ ?_⟩
    rw [dual_decomposition k f]
    simp [firstColumnNakayamaMap_diagonal, firstColumnNakayamaMap_upper, upperColumn,
      entry_upperUnit, F, mul_comm]

/-- The Nakayama module of the first column ideal is the second column ideal. -/
noncomputable def firstColumnNakayamaEquiv : (P 1) ≃ₗ[T₂] ν :=
  LinearEquiv.ofBijective (firstColumnNakayamaMap k) (firstColumnNakayamaMap_bijective k)

/-- The Nakayama isomorphism pairs the value of a functional at the first diagonal matrix unit
with the second column by taking the upper off-diagonal entry of their product. -/
theorem firstColumnNakayamaEquiv_apply (x : P 1) (f : D) :
    MatlisDual.equivLinearMap k k D (firstColumnNakayamaEquiv k x) f =
      (((f (spanSingletonGenerator (diagonalUnit k 0)) * (x : T₂)) : T₂) :
        Matrix (Fin 2) (Fin 2) k) 0 1 :=
  firstColumnNakayamaMap_apply k x f

/-- The first column ideal is a simple module. -/
theorem isSimpleModule_firstColumn : IsSimpleModule T₂ (P 0) := by
  have hgen : firstGenerator k ≠ 0 := by
    intro h
    simpa using congrArg (fun x : P 0 ↦ entry k (x : T₂) 0 0) h
  refine isSimpleModule_iff_toSpanSingleton_surjective.mpr ⟨nontrivial_of_ne _ _ hgen, ?_⟩
  intro x hx y
  have hx₀ : entry k (x : T₂) 0 0 ≠ 0 := fun h ↦ hx (firstColumn_ext k (by simpa using h))
  refine ⟨(entry k (y : T₂) 0 0 / entry k (x : T₂) 0 0) • diagonalUnit k 0,
    firstColumn_ext k ?_⟩
  -- The action on a column ideal is multiplication in the upper triangular algebra.
  change entry k ((_ : T₂) * (x : T₂)) 0 0 = _
  simp [entry_mul, div_mul_cancel₀ _ hx₀]

private theorem firstColumnInclusion_injective : Function.Injective (firstColumnInclusion k) := by
  intro x y h
  apply firstColumn_ext k
  simpa [entry_firstColumnInclusion] using congrArg (fun z : P 1 ↦ entry k (z : T₂) 0 1) h

/-- The image of the first-column inclusion consists of the second columns with zero bottom
entry. -/
theorem mem_range_firstColumnInclusion_iff (x : P 1) :
    x ∈ LinearMap.range (firstColumnInclusion k) ↔
      (((x : T₂) : Matrix (Fin 2) (Fin 2) k) 1 1) = 0 := by
  constructor
  · rintro ⟨y, rfl⟩
    exact (entry_firstColumnInclusion k y 1 1).trans (by simp)
  · intro hx
    refine ⟨entry k (x : T₂) 0 1 • firstGenerator k, secondColumn_ext k ?_ ?_⟩
    · simp [entry_firstColumnInclusion]
    · simpa [entry_firstColumnInclusion] using hx.symm

private theorem isEssential_range_firstColumnInclusion :
    IsEssential (LinearMap.range (firstColumnInclusion k)) := by
  refine isEssential_iff_forall_exists_smul.mpr fun x hx ↦ ?_
  by_cases h : entry k (x : T₂) 1 1 = 0
  · refine ⟨1, ?_, by simpa⟩
    simpa only [one_smul] using (mem_range_firstColumnInclusion_iff k x).2 h
  · refine ⟨upperUnit k, (mem_range_firstColumnInclusion_iff k _).2 ?_, ?_⟩
    · exact (entry_mul k (upperUnit k) (x : T₂) 1 1).trans (by simp [entry_upperUnit])
    · intro hz
      apply h
      have hz₀ := congrArg (fun z : P 1 ↦ entry k (z : T₂) 0 1) hz
      simpa [entry_mul, entry_upperUnit] using hz₀

/-- Right multiplication by the upper off-diagonal matrix unit is an injective envelope of
the simple first column. -/
theorem isInjectiveEnvelope_firstColumnInclusion :
    IsInjectiveEnvelope (R := T₂) (M := P 0) (Q := P 1) (firstColumnInclusion k) := by
  refine ⟨?_, firstColumnInclusion_injective k, isEssential_range_firstColumnInclusion k⟩
  exact Module.Baer.injective (Module.Baer.of_equiv (firstColumnNakayamaEquiv k).symm
    (Module.Baer.of_injective inferInstance))

private def secondColumnCoords : (P 1) →ₗ[k] k × k where
  toFun x := (entry k (x : T₂) 0 1, entry k (x : T₂) 1 1)
  map_add' _ _ := (rfl)
  map_smul' _ _ := (rfl)

/-- The projective-injective second column has composition length two over the upper
triangular algebra. -/
theorem length_secondColumn : Module.length T₂ (P 1) = 2 := by
  apply le_antisymm
  · -- Restricting scalars gives the upper bound from the two column coordinates.
    have h : Module.length T₂ (P 1) ≤ Module.length k (P 1) := by
      rw [← WithBot.coe_le_coe, Module.coe_length T₂ (P 1), Module.coe_length k (P 1)]
      exact Order.krullDim_le_of_orderEmbedding
        (Submodule.restrictScalarsEmbedding (R := T₂) (M := P 1) k)
    refine h.trans ((Module.length_le_of_injective (secondColumnCoords k) fun _ _ e ↦
      secondColumn_ext k (congrArg Prod.fst e) (congrArg Prod.snd e)).trans ?_)
    simp [Module.length_prod, Module.length_eq_one, one_add_one_eq_two]
  · -- The image of the first column gives a strict chain of length two.
    let N : Submodule T₂ (P 1) := LinearMap.range (firstColumnInclusion k)
    have hb : ⊥ < N := bot_lt_iff_ne_bot.mpr fun h ↦ by
      have hz : firstColumnInclusion k (firstGenerator k) ∈ N :=
        LinearMap.mem_range_self _ _
      rw [h, Submodule.mem_bot] at hz
      have hentry := congrArg (fun z : P 1 ↦ entry k (z : T₂) 0 1) hz
      simp [entry_firstColumnInclusion] at hentry
    have ht : N < ⊤ := lt_top_iff_ne_top.mpr fun h ↦ by
      have hmem : secondGenerator k ∈ N := h ▸ Submodule.mem_top
      have hz := (mem_range_firstColumnInclusion_iff k _).1 hmem
      simp at hz
    let start : LTSeries (Submodule T₂ (P 1)) := RelSeries.singleton _ ⊥
    let middle : LTSeries (Submodule T₂ (P 1)) := start.snoc N hb
    have hlast : middle.last = N := RelSeries.last_snoc start N hb
    let series : LTSeries (Submodule T₂ (P 1)) := middle.snoc ⊤ (by
      rw [hlast]
      exact ht)
    have hlen : series.length = 2 := (rfl)
    have hs := Order.LTSeries.length_le_krullDim series
    rw [hlen, ← Module.coe_length T₂ (P 1)] at hs
    exact WithBot.coe_le_coe.mp hs

end TauCeti.UpperTriangularTwo
