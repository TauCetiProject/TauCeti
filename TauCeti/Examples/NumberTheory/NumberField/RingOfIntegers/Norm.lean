module

public import TauCeti.NumberTheory.NumberField.Quadratic.EmbeddingBound
public import TauCeti.NumberTheory.NumberField.Quadratic.Model
public import TauCeti.NumberTheory.NumberField.RingOfIntegers.Norm
public import TauCeti.RingTheory.NormTrace.Prod
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.NormNum.RealSqrt
import Mathlib.Tactic.Ring

/-!
# Norms, embeddings and prime-power divisibility

In the actual ring of integers of `ℚ(i)`, the integral coordinates `(2, 2)` describe `2(1+i)`,
whose norm is `8`. Divisibility by the scalar `2` gives divisibility of its norm by `2²`.
The element `1+i` has norm `2`, so membership in the prime ideal generated by `1+i` cannot
replace scalar divisibility by `2` in that statement.

In `ℚ(√2)`, `1+√2` and `3(1+√2)` have negative integral norms `-1` and `-9`, and their embedding
moduli have products `1` and `9`. In `ℚ(√−5)`, `2+√−5` has norm `9` and every complex embedding
has modulus `3`, giving the sharp common-bound estimate `9 ≤ 3²`.

The zero-scalar case and the split algebra `ℚ × ℚ` distinguish the endpoint and domain
hypotheses of the norm API. The prime-power logarithmic examples retain exponents rather than
only the squarefree product of the primes.
-/

public section

open scoped NumberField

local instance TauCeti.NormDivisibilityExamples.instFactNotIsSquareNegOne :
    Fact (¬ IsSquare (-1 : ℤ)) :=
  ⟨not_isSquare_of_neg (by norm_num)⟩

local instance TauCeti.NormDivisibilityExamples.instFactNotIsSquareTwo :
    Fact (¬ IsSquare (2 : ℤ)) :=
  ⟨Int.prime_two.not_isSquare⟩

local instance TauCeti.NormDivisibilityExamples.instFactNotIsSquareNegFive :
    Fact (¬ IsSquare (-5 : ℤ)) :=
  ⟨not_isSquare_of_neg (by norm_num)⟩

namespace TauCeti.NormDivisibilityExamples

/-! ### Scalar divisibility and the Gaussian prime above two -/

/-- The integral norms of `2(1+i)` and `1+i` are `8` and `2`, using the ring-of-integers
comparison with the integral quadratic model. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    Algebra.norm ℤ (e.symm ⟨2, 2⟩) = 8 ∧ Algebra.norm ℤ (e.symm ⟨1, 1⟩) = 2 := by
  norm_num [QuadraticAlgebra.norm_ringOfIntegersEquiv_symm]

/-- The scalar `2` divides the algebraic integer `2(1+i)`, with quotient `1+i`. -/
private theorem gaussian_scalar_divides :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    (2 : 𝓞 (QuadraticAlgebra ℚ ((-1 : ℤ) : ℚ) 0)) ∣ e.symm ⟨2, 2⟩ := by
  have hdvd : (2 : QuadraticAlgebra ℤ (-1) 0) ∣ ⟨2, 2⟩ := ⟨⟨1, 1⟩, rfl⟩
  simpa only [map_ofNat] using map_dvd
    (QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)).symm
    hdvd

/-- The scalar-divisibility theorem supplies the full degree-two factor `2²` in the integral
norm, rather than a single factor `2`. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    (2 : ℤ) ^ (2 * 1) ∣ Algebra.norm ℤ (e.symm ⟨2, 2⟩) := by
  have h := NumberField.RingOfIntegers.pow_finrank_mul_dvd_norm (m := 2) (e := 1)
    (by simpa only [pow_one, Int.cast_ofNat, Nat.cast_ofNat] using gaussian_scalar_divides)
  rw [QuadraticAlgebra.finrank_eq_two] at h
  exact h

/-- The principal ideal generated by `1+i` has absolute norm `2`. -/
private theorem gaussian_prime_ideal_absNorm :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    Ideal.absNorm (Ideal.span {e.symm ⟨1, 1⟩}) = 2 := by
  norm_num [Ideal.absNorm_span_singleton, QuadraticAlgebra.norm_ringOfIntegersEquiv_symm]

/-- The ideal generated by `1+i` is prime, as its absolute norm is the rational prime `2`. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    (Ideal.span {e.symm ⟨1, 1⟩}).IsPrime := by
  apply Ideal.isPrime_of_irreducible_absNorm
  simpa only [gaussian_prime_ideal_absNorm] using (Nat.irreducible_iff_nat_prime 2).2 Nat.prime_two

/-- The factorization `2 = (1+i)(1-i)` puts `2` in the ideal generated by `1+i`. -/
private theorem gaussian_one_add_i_divides_two :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    e.symm ⟨1, 1⟩ ∣ (2 : 𝓞 (QuadraticAlgebra ℚ ((-1 : ℤ) : ℚ) 0)) := by
  have hdvd : (⟨1, 1⟩ : QuadraticAlgebra ℤ (-1) 0) ∣ 2 := ⟨⟨1, -1⟩, rfl⟩
  simpa only [map_ofNat] using map_dvd
    (QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)).symm
    hdvd

/-- The generator and the scalar `2` lie in the prime ideal `(1+i)`, but the generator's norm
is not divisible by `4`. Prime-ideal membership does not give scalar norm divisibility. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    e.symm ⟨1, 1⟩ ∈ Ideal.span {e.symm ⟨1, 1⟩} ∧
      (2 : 𝓞 (QuadraticAlgebra ℚ ((-1 : ℤ) : ℚ) 0)) ∈ Ideal.span {e.symm ⟨1, 1⟩} ∧
      ¬ (4 : ℤ) ∣ Algebra.norm ℤ (e.symm ⟨1, 1⟩) := by
  refine ⟨Ideal.subset_span rfl,
    Ideal.mem_span_singleton.2 gaussian_one_add_i_divides_two, ?_⟩
  norm_num [QuadraticAlgebra.norm_ringOfIntegersEquiv_symm]

/-! ### The zero scalar and a non-domain algebra -/

/-- For a positive exponent, divisibility by the zero scalar forces the algebraic integer to
vanish; the degree-two norm divisibility theorem still applies. -/
example (e : ℕ) (he : 0 < e)
    (a : 𝓞 (QuadraticAlgebra ℚ ((-1 : ℤ) : ℚ) 0)) (h : (0 : _) ^ e ∣ a) :
    a = 0 ∧ (0 : ℤ) ^ (2 * e) ∣ Algebra.norm ℤ a := by
  have hn := NumberField.RingOfIntegers.pow_finrank_mul_dvd_norm (m := 0) (e := e)
    (by simpa only [Int.cast_zero] using h)
  rw [QuadraticAlgebra.finrank_eq_two] at hn
  exact ⟨by simpa only [zero_pow he.ne', zero_dvd_iff] using h, hn⟩

/-- The split algebra has a nonzero element of zero norm, so the nonvanishing theorem needs
a domain hypothesis on the algebra. -/
example :
    ((1 : ℚ), (0 : ℚ)) ≠ 0 ∧ Algebra.norm ℚ ((1 : ℚ), (0 : ℚ)) = 0 := by
  norm_num [TauCeti.Algebra.norm_prod]

/-! ### Prime-power divisors and logarithms -/

/-- The exponent-sensitive logarithmic lower bound for `12 = 2² · 3` follows from the general
prime-power divisor theorem. -/
example :
    2 * Real.log 2 + Real.log 3 ≤ Real.log 12 := by
  simpa using Int.sum_mul_log_le_log_abs (P := {2, 3})
    (fun p ↦ if p = 2 then 2 else 1) (by norm_num : (12 : ℤ) ≠ 0) (by norm_num)

/-- The coprime prime powers `4` and `3` combine into the divisor `12`; the higher power `8`
does not divide `12`. -/
example :
    (4 : ℤ) ∣ 12 ∧ (3 : ℤ) ∣ 12 ∧ (4 : ℤ) * 3 ∣ 12 ∧ ¬ (8 : ℤ) ∣ 12 := by
  refine ⟨by norm_num, by norm_num, ?_, by norm_num⟩
  have hc : IsCoprime (4 : ℤ) 3 := ⟨1, -1, by norm_num⟩
  exact hc.mul_dvd (by norm_num) (by norm_num)

/-- The exponent-sensitive lower bound is an equality for `12 = 2² · 3`. -/
example :
    2 * Real.log 2 + Real.log 3 = Real.log 12 := by
  have h12 : (12 : ℝ) = 2 ^ 2 * 3 := by norm_num
  rw [h12, Real.log_mul (by norm_num) (by norm_num), Real.log_pow]
  norm_num

/-- The empty prime family contributes zero, with product divisor `1`. -/
example : 0 ≤ Real.log 12 := by
  simpa using Int.sum_mul_log_le_log_abs (P := ∅) (fun _ ↦ 0)
    (by norm_num : (12 : ℤ) ≠ 0) (by simp)

/-- A logarithmic inequality can hold even when the corresponding prime power does not divide
the integer, so the divisor theorem has no converse. -/
example :
    ¬ (8 : ℤ) ∣ 12 ∧ 3 * Real.log 2 ≤ Real.log 12 := by
  refine ⟨by norm_num, ?_⟩
  simpa only [Real.log_pow, Nat.cast_ofNat] using
    Real.log_le_log (by norm_num : 0 < (2 : ℝ) ^ 3) (by norm_num : (2 : ℝ) ^ 3 ≤ 12)

/-! ### Embedding moduli in quadratic fields -/

/-- The product of the moduli of the complex conjugates of `1+i` is its absolute integral
norm, namely `2`. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    ∏ σ : QuadraticAlgebra ℚ ((-1 : ℤ) : ℚ) 0 →+* ℂ, ‖σ (e.symm ⟨1, 1⟩)‖ = 2 := by
  dsimp only
  rw [NumberField.prod_norm_embedding_eq_abs_norm, ← Algebra.coe_norm_int]
  norm_num [QuadraticAlgebra.norm_ringOfIntegersEquiv_symm]

/-- The distinguished complex embedding sends `1+i` to a number of modulus `√2`. -/
private theorem gaussian_distinguished_embedding_norm :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    ‖QuadraticAlgebra.complexEmbedding (by norm_num : ((-1 : ℤ) : ℚ) ≤ 0)
      (e.symm ⟨1, 1⟩)‖ = Real.sqrt 2 := by
  dsimp only
  rw [QuadraticAlgebra.complexEmbedding_ringOfIntegersEquiv_symm]
  norm_num [Complex.norm_def, Complex.normSq_apply]

/-- In `ℚ(√2)`, `1+√2` has norm `-1`, while `3(1+√2)` has norm `-9`, divisible by `3²`. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := 2) Int.prime_two.squarefree
      (by norm_num)
    Algebra.norm ℤ (e.symm ⟨1, 1⟩) = -1 ∧ Algebra.norm ℤ (e.symm ⟨3, 3⟩) = -9 ∧
      (3 : ℤ) ^ 2 ∣ Algebra.norm ℤ (e.symm ⟨3, 3⟩) := by
  norm_num [QuadraticAlgebra.norm_ringOfIntegersEquiv_symm]

/-- The embedding-moduli products of `1+√2` and `3(1+√2)` are `1` and `9`, the absolute
values of their negative integral norms. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := 2) Int.prime_two.squarefree
      (by norm_num)
    (∏ σ : QuadraticAlgebra ℚ ((2 : ℤ) : ℚ) 0 →+* ℂ, ‖σ (e.symm ⟨1, 1⟩)‖ = 1) ∧
      ∏ σ : QuadraticAlgebra ℚ ((2 : ℤ) : ℚ) 0 →+* ℂ, ‖σ (e.symm ⟨3, 3⟩)‖ = 9 := by
  dsimp only
  constructor
  all_goals rw [NumberField.prod_norm_embedding_eq_abs_norm, ← Algebra.coe_norm_int]
  all_goals norm_num [QuadraticAlgebra.norm_ringOfIntegersEquiv_symm]

/-- The two real embeddings of `3(1+√2)` have moduli `3(1+√2)` and `3(√2-1)`. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := 2) Int.prime_two.squarefree
      (by norm_num)
    ‖QuadraticAlgebra.sqrtEmbedding ((2 : ℤ) : ℚ) (e.symm ⟨3, 3⟩)‖ =
        3 * (1 + Real.sqrt 2) ∧
      ‖QuadraticAlgebra.negSqrtEmbedding ((2 : ℤ) : ℚ) (e.symm ⟨3, 3⟩)‖ =
        3 * (Real.sqrt 2 - 1) := by
  dsimp only
  constructor
  · rw [← Complex.abs_re_eq_norm.mpr (QuadraticAlgebra.im_sqrtEmbedding
      (by norm_num : (0 : ℚ) ≤ ((2 : ℤ) : ℚ)) _)]
    norm_num [QuadraticAlgebra.ringOfIntegersEquiv_symm_apply_coe,
      QuadraticAlgebra.sqrtEmbedding_apply,
      QuadraticAlgebra.sqrtRadicand_of_nonneg (by norm_num : (0 : ℚ) ≤ 2)]
    rw [abs_of_nonneg (by linarith [Real.sqrt_nonneg (2 : ℝ)])]
    ring
  · rw [← Complex.abs_re_eq_norm.mpr (QuadraticAlgebra.im_negSqrtEmbedding
      (by norm_num : (0 : ℚ) ≤ ((2 : ℤ) : ℚ)) _)]
    norm_num [QuadraticAlgebra.ringOfIntegersEquiv_symm_apply_coe,
      QuadraticAlgebra.negSqrtEmbedding_apply,
      QuadraticAlgebra.sqrtRadicand_of_nonneg (by norm_num : (0 : ℚ) ≤ 2)]
    rw [abs_of_nonpos (by linarith [Real.one_lt_sqrt_two])]
    ring

private theorem prime_neg_five : Prime (-5 : ℤ) :=
  Int.prime_iff_natAbs_prime.mpr Nat.prime_five

/-- In `ℚ(√−5)`, the algebraic integer `2+√−5` has integral norm `9`. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -5)
      prime_neg_five.squarefree
      (by norm_num)
    Algebra.norm ℤ (e.symm ⟨2, 1⟩) = 9 := by
  norm_num [QuadraticAlgebra.norm_ringOfIntegersEquiv_symm]

/-- The distinguished complex embedding sends `2+√−5` to a complex number of modulus `3`. -/
private theorem sqrt_neg_five_distinguished_embedding_norm :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -5)
      prime_neg_five.squarefree
      (by norm_num)
    ‖QuadraticAlgebra.complexEmbedding (by norm_num : ((-5 : ℤ) : ℚ) ≤ 0)
      (e.symm ⟨2, 1⟩)‖ = 3 := by
  dsimp only
  rw [QuadraticAlgebra.complexEmbedding_ringOfIntegersEquiv_symm]
  norm_num [Complex.norm_def, Complex.normSq_apply,
    Real.mul_self_sqrt (by norm_num : 0 ≤ (5 : ℝ))]

/-- Every complex embedding of `ℚ(√−5)` sends the algebraic integer `2+√−5` to a number of
modulus `3`. -/
private theorem norm_integral_two_add_sqrt_neg_five
    (σ : QuadraticAlgebra ℚ ((-5 : ℤ) : ℚ) 0 →+* ℂ) :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -5)
      prime_neg_five.squarefree
      (by norm_num)
    ‖σ (e.symm ⟨2, 1⟩)‖ = 3 := by
  exact (QuadraticAlgebra.norm_ringHom_eq_norm_complexEmbedding (by norm_num) σ _).trans
    sqrt_neg_five_distinguished_embedding_norm

/-- Every complex embedding of `ℚ(i)` sends the algebraic integer `1+i` to a number of
modulus `√2`. -/
example
    (σ : QuadraticAlgebra ℚ ((-1 : ℤ) : ℚ) 0 →+* ℂ) :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -1) isUnit_neg_one.squarefree
      (by norm_num)
    ‖σ (e.symm ⟨1, 1⟩)‖ = Real.sqrt 2 := by
  exact (QuadraticAlgebra.norm_ringHom_eq_norm_complexEmbedding (by norm_num) σ _).trans
    gaussian_distinguished_embedding_norm

/-- The common embedding bound `3` yields the sharp degree-two upper bound `3²` on the
absolute integral norm of `2+√−5`. -/
example :
    let e := QuadraticAlgebra.ringOfIntegersEquiv (d := -5)
      prime_neg_five.squarefree
      (by norm_num)
    |(Algebra.norm ℤ (e.symm ⟨2, 1⟩) : ℝ)| ≤ 3 ^ (2 : ℕ) := by
  have h := NumberField.RingOfIntegers.abs_norm_le_pow (C := 3)
    ((QuadraticAlgebra.ringOfIntegersEquiv (d := -5)
      prime_neg_five.squarefree
      (by norm_num)).symm ⟨2, 1⟩)
    (fun σ ↦ (norm_integral_two_add_sqrt_neg_five σ).le)
  rw [QuadraticAlgebra.finrank_eq_two] at h
  exact h

end TauCeti.NormDivisibilityExamples
