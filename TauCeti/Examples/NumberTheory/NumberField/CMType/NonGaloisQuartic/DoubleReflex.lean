/-!
# The double reflex of a non-Galois quartic CM type

The type on `ℚ(a)` selects the generator images `a` and `b`. On its reflex field
`ℚ(a + b)`, the inverse-coset type selects `a + b` and `a - b`. In fact, if `σ` is
an automorphism of `ℂ`, its restriction belongs to the second type exactly when the
restriction of `σ⁻¹` belongs to the first. Their compositum `ℚ(a,b)` is the normal closure,
with Galois group the dihedral group of order eight. The second type trace sends `a + b` to
`2a`, and its values generate precisely the original embedded field.

## References

* J. S. Milne, *Complex Multiplication*, §1, Examples 1.19 and 1.28.
-/

public section

open Polynomial IntermediateField Complex

namespace TauCeti.NonGaloisQuarticCMType

/-- The normal closure of `ℚ(a)` in `ℂ` is generated by the two upper-half-plane roots. -/
theorem normalClosure_E : normalClosure ℚ E ℂ = E ⊔ ℚ⟮b⟯ := by
  refine le_antisymm (normalClosure_le_iff.mpr fun f ↦ ?_)
    (sup_le (le_normalClosure E) (adjoin_simple_le_iff.mpr (ιb.fieldRange_le_normalClosure
      ⟨gen, ιb_gen⟩)))
  rw [AlgHom.fieldRange_eq_map, ← adjoin_adjoinSimple_gen_eq_top (F := ℚ) a,
    adjoin_map, Set.image_singleton, adjoin_simple_le_iff]
  have ha : a ∈ E ⊔ ℚ⟮b⟯ :=
    (le_sup_left : E ≤ E ⊔ ℚ⟮b⟯) (mem_adjoin_simple_self ℚ a)
  have hb : b ∈ E ⊔ ℚ⟮b⟯ :=
    (le_sup_right : ℚ⟮b⟯ ≤ E ⊔ ℚ⟮b⟯) (mem_adjoin_simple_self ℚ b)
  have hf := apply_gen_mem (f : E →+* ℂ)
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, AlgHom.coe_toRingHom] at hf
  rcases hf with h | h | h | h <;> rw [h]
  · exact ha
  · exact neg_mem ha
  · exact hb
  · exact neg_mem hb

/-- Adjoining the missing root doubles the degree of the original quartic field. -/
theorem finrank_normalClosure_E : Module.finrank ℚ (normalClosure ℚ E ℂ) = 8 := by
  have hb : b ^ 2 ∈ E := b_sq.symm ▸ add_mem (by norm_num) sqrt_two_mem_E
  rw [normalClosure_E, E.finrank_sup_adjoin_simple_eq_mul_two hb b_notMem_E, finrank_E]

/-- The Galois group on the four conjugates of `a` has label `4T3`, the dihedral group
of order eight acting on the vertices of a square. -/
theorem hasGaloisLabel_minpoly_a :
    HasGaloisLabel (minpoly ℚ a) (⟨2, by simp⟩ : TransitiveGroupIndex 4) := by
  have hi := minpoly.irreducible isIntegral_a
  have hd : (minpoly ℚ a).natDegree = 4 := (adjoin.finrank isIntegral_a).symm.trans finrank_E
  rw [hasGaloisLabel_iff_natCard_gal hi.separable hi hd
    (fun G _ ↦ transitiveGroupLabel_four_iff_natCard_eq_of_two_le _ (by decide) G),
    natCard_referenceSubgroup_four_two]
  rw [Polynomial.Gal.card_of_separable hi.separable,
    (splittingFieldEquivNormalClosure isIntegral_a (IsAlgClosed.splits _)).toLinearEquiv.finrank_eq,
    finrank_normalClosure_E]

/-- The compositum of the embedded field and its reflex field is the normal closure. -/
theorem sup_E_Estar : E ⊔ Estar = normalClosure ℚ E ℂ := by
  rw [normalClosure_E]
  have ha := mem_adjoin_simple_self ℚ a
  have hb := mem_adjoin_simple_self ℚ b
  have hs := mem_adjoin_simple_self ℚ (a + b)
  refine le_antisymm (sup_le le_sup_left (adjoin_simple_le_iff.mpr ?_))
    (sup_le le_sup_left (adjoin_simple_le_iff.mpr ?_))
  · exact add_mem ((le_sup_left : E ≤ E ⊔ ℚ⟮b⟯) ha) ((le_sup_right : ℚ⟮b⟯ ≤ E ⊔ ℚ⟮b⟯) hb)
  · simpa using sub_mem ((le_sup_right : Estar ≤ E ⊔ Estar) hs) ((le_sup_left : E ≤ E ⊔ Estar) ha)

/-- The generator `a + b` of the first reflex field. -/
noncomputable abbrev genStar : Estar := AdjoinSimple.gen ℚ (a + b)

private theorem sum_sq_roots : a ^ 2 + b ^ 2 = -6 := by
  rw [a_sq, b_sq]
  ring

private theorem reflex_quartic_factor (z : ℂ) :
    z ^ 4 + 12 * z ^ 2 + 8 =
      (z - (a + b)) * (z + (a + b)) * (z - (a - b)) * (z + (a - b)) := by
  have hs : (a + b) ^ 4 + 12 * (a + b) ^ 2 + 8 = 0 := by simpa using aeval_a_add_b
  linear_combination hs + (2 * z ^ 2 - 2 * (a + b) ^ 2) * sum_sq_roots

/-- The embedding of the reflex field sending `a + b` to `a - b`. -/
noncomputable def ιSub : Estar →ₐ[ℚ] ℂ :=
  (adjoin.powerBasis isIntegral_a_add_b).lift (a - b) (by
    rw [adjoin.powerBasis_gen, minpoly_gen, minpoly_a_add_b]
    simpa using reflex_quartic_factor (a - b))

@[simp]
theorem ιSub_genStar : ιSub genStar = a - b := PowerBasis.lift_gen _ _ _

/-- Every embedding of the reflex field sends its generator to one of `±(a + b), ±(a - b)`. -/
theorem apply_genStar_mem (ψ : Estar →+* ℂ) :
    ψ genStar ∈ ({a + b, -(a + b), a - b, -(a - b)} : Set ℂ) := by
  have hz : ψ genStar ^ 4 + 12 * ψ genStar ^ 2 + 8 = 0 := by
    have he := aeval_algHom_apply ψ.toRatAlgHom genStar (minpoly ℚ (a + b))
    rw [aeval_gen_minpoly, map_zero, minpoly_a_add_b] at he
    simpa using he
  rw [reflex_quartic_factor] at hz
  simpa only [Set.mem_insert_iff, Set.mem_singleton_iff, mul_eq_zero, sub_eq_zero,
    add_eq_zero_iff_eq_neg, or_assoc] using hz

private theorem im_sub_pos : 0 < (a - b).im := by
  rw [sub_im, a_im, b_im, sub_pos]
  rw [Real.sqrt_lt_sqrt_iff_of_pos (by positivity)]
  linarith [Real.sqrt_pos.2 (by norm_num : (0 : ℝ) < 2)]

/-- The reflex CM type on `ℚ(a + b)`, selecting the two upper-half-plane images of `a + b`. -/
noncomputable def Φstar : CMType Estar where
  carrier := {ψ | 0 < (ψ genStar).im}
  star_mem_iff' ψ := by
    simp only [Set.mem_ofPred_eq, RingHom.star_apply, Complex.star_def, conj_im, neg_pos, not_lt]
    have hs : 0 < (a + b).im := add_pos a_im_pos b_im_pos
    have hd := im_sub_pos
    have h := apply_genStar_mem ψ
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h
    rcases h with h | h | h | h <;> simp only [h, neg_im] <;>
      constructor <;> intro hi <;> linarith

/-- The two selected images of the generator of the reflex field. -/
@[simp]
theorem mem_Φstar_iff {ψ : Estar →+* ℂ} :
    ψ ∈ Φstar ↔ ψ genStar = a + b ∨ ψ genStar = a - b := by
  rw [← CMType.mem_carrier]
  simp only [Φstar, Set.mem_ofPred_eq]
  have hs : 0 < (a + b).im := add_pos a_im_pos b_im_pos
  have hd := im_sub_pos
  refine ⟨fun h ↦ ?_, fun h ↦ h.elim (fun e ↦ e.symm ▸ hs) (fun e ↦ e.symm ▸ hd)⟩
  have hroot := apply_genStar_mem ψ
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hroot
  rcases hroot with e | e | e | e
  · exact Or.inl e
  · rw [e, neg_im] at h
    linarith
  · exact Or.inr e
  · rw [e, neg_im] at h
    linarith

/-- Restriction gives inverse membership for the two CM types. This describes the inverse
cosets independently of the choice of a normal closure or of a lift of an embedding. -/
theorem comp_mem_Φstar_iff (σ : ℂ ≃+* ℂ) :
    (σ : ℂ →+* ℂ).comp (Estar.val : Estar →+* ℂ) ∈ Φstar ↔
      (σ.symm : ℂ →+* ℂ).comp (E.val : E →+* ℂ) ∈ Φ := by
  -- The quadratic with roots σ(a), σ(b), evaluated at a, detects both selected cosets.
  have hs := congrArg σ sum_sq_roots
  simp only [map_add, map_pow, map_neg, map_ofNat] at hs
  have h : (σ (a + b) - (a + b)) * (σ (a + b) - (a - b)) =
      2 * ((a - σ a) * (a - σ b)) := by
    rw [map_add]
    linear_combination hs - sum_sq_roots
  simp only [mem_Φstar_iff, mem_Φ_iff, RingHom.comp_apply, AlgHom.coe_toRingHom, coe_val,
    AdjoinSimple.coe_gen, RingEquiv.coe_toRingHom, RingEquiv.symm_apply_eq]
  simpa only [mul_eq_zero, sub_eq_zero, OfNat.ofNat_ne_zero, false_or] using
    (congrArg (· = 0) h).to_iff

/-- In any common overfield, the restrictions of the inverse cosets for `Φ` are exactly
the embeddings in `Φstar`. In particular this applies inside the finite Galois closure. -/
theorem comp_inclusion_mem_Φstar_iff {L : IntermediateField ℚ ℂ} (hE : E ≤ L)
    (hStar : Estar ≤ L) (σ : Gal(L/ℚ)) :
    ((L.val.comp σ.toAlgHom).comp (inclusion hStar) : Estar →+* ℂ) ∈ Φstar ↔
      ((L.val.comp σ.symm.toAlgHom).comp (inclusion hE) : E →+* ℂ) ∈ Φ := by
  obtain ⟨τ, hτ⟩ := σ.toRingEquiv.exists_ringEquiv_apply_algebraMap (Ω := ℂ)
  have h₁ : (τ : ℂ →+* ℂ).comp (Estar.val : Estar →+* ℂ) =
      (L.val.comp σ.toAlgHom).comp (inclusion hStar) :=
    RingHom.ext fun x ↦ hτ (inclusion hStar x)
  have h₂ : (τ.symm : ℂ →+* ℂ).comp (E.val : E →+* ℂ) =
      (L.val.comp σ.symm.toAlgHom).comp (inclusion hE) := by
    ext x
    apply τ.injective
    simpa using (hτ (σ.symm (inclusion hE x))).symm
  rw [← h₁, ← h₂, comp_mem_Φstar_iff]

/-- The reflex type consists of the inclusion and the embedding sending the generator to
`a - b`. -/
theorem coe_Φstar :
    (Φstar : Set (Estar →+* ℂ)) = {(Estar.val : Estar →+* ℂ), (ιSub : Estar →+* ℂ)} := by
  ext ψ
  have ext_gen {f g : Estar →+* ℂ} (h : f genStar = g genStar) : f = g :=
    (RingHom.equivRatAlgHom Estar ℂ).injective <|
      (adjoin.powerBasis isIntegral_a_add_b).algHom_ext h
  rw [SetLike.mem_coe, mem_Φstar_iff, Set.mem_insert_iff, Set.mem_singleton_iff]
  exact ⟨Or.imp (fun h ↦ ext_gen (by simpa using h)) (fun h ↦ ext_gen (by simpa using h)),
    Or.imp (fun h ↦ by simp [h]) (fun h ↦ by simp [h])⟩

/-- The reflex type trace is the sum of its two embeddings. -/
@[simp]
theorem typeTrace_Φstar (x : Estar) : Φstar.typeTrace x = x + ιSub x := by
  have hne : (Estar.val : Estar →+* ℂ) ≠ ιSub := by
    intro e
    have he : a + b = a - b := by simpa using RingHom.congr_fun e genStar
    have hz : b = 0 := by linear_combination he / 2
    exact b_im_pos.ne' (by rw [hz, zero_im])
  rw [CMType.typeTrace_apply, coe_Φstar, finsum_mem_pair hne]
  rfl

/-- The type trace of the reflex generator is twice the original generator. -/
theorem typeTrace_Φstar_genStar : Φstar.typeTrace genStar = 2 * a := by
  simp only [typeTrace_Φstar, AdjoinSimple.coe_gen, ιSub_genStar]
  ring

/-- The double reflex field is the original embedded field `ℚ(a)`. -/
theorem reflexField_Φstar : Φstar.reflexField = E := by
  refine le_antisymm (fun z hz ↦ ?_) (adjoin_simple_le_iff.mpr ?_)
  · -- An automorphism fixing a preserves inverse membership, so fixes all type traces.
    suffices z ∈ Set.range (algebraMap E ℂ) by
      obtain ⟨x, rfl⟩ := this
      exact x.property
    refine (TauCeti.IsAlgClosed.mem_range_algebraMap_iff_fixed z).2 fun σ ↦ ?_
    apply (mem_fixingSubgroup_iff Φstar.reflexField (σ.restrictScalars ℚ)).1 _ z hz
    apply (Φstar.mem_fixingSubgroup_reflexField_iff (σ.restrictScalars ℚ)).2
    intro ψ
    obtain ⟨τ, hτ⟩ := Estar.exists_ringEquiv_apply_eq_of_isAlgebraic ψ
    have e : (τ : ℂ →+* ℂ).comp (Estar.val : Estar →+* ℂ) = ψ := RingHom.ext hτ
    rw [← e]
    have he : (σ.toRingEquiv.symm : ℂ →+* ℂ).comp (E.val : E →+* ℂ) = E.val :=
      RingHom.ext fun x ↦ σ.symm.commutes x
    rw [comp_mem_Φstar_iff τ, ← AlgEquiv.toRingEquiv_toRingHom,
      AlgEquiv.toRingEquiv_restrictScalars]
    simpa only [RingEquiv.symm_trans, RingEquiv.toRingHom_trans, RingHom.comp_assoc, he] using
      comp_mem_Φstar_iff (τ.trans σ.toRingEquiv)
  · have hm := Φstar.typeTrace_mem_reflexField genStar
    rw [typeTrace_Φstar_genStar] at hm
    have h := div_mem hm (by norm_num : (2 : ℂ) ∈ Φstar.reflexField)
    convert h using 1
    ring

end TauCeti.NonGaloisQuarticCMType
