/-!
# Eisenstein Newton polygons over `ℚ_[p]`

Concrete Newton polygons of Eisenstein and cyclotomic polynomials over `ℚ_[p]`, with respect to
the real `p`-adic additive valuation `TauCeti.padicRealValuation p` normalised by `v(p) = 1`:

* `X ^ p - p` is pure of slope `-1 / p` with multiplicity `p`. So in a field extension `L` of
  `ℚ_[p]` containing a `p`-th root of `p`, with a valuation `w` extending `v`, every `e` for which
  `e • w` takes integer values on `L` is divisible by `p`. If `[L : ℚ_[p]] = p` and `e • w` is the
  integral normalisation of `w`, so that `e` is the ramification index, then `e = p`: the
  extension is totally ramified.
* The shifted cyclotomic polynomial `Φ_p(X + 1) = ∑_{i < p} (p choose i + 1) X ^ i` is Eisenstein,
  so it is pure of slope `-1 / (p - 1)` with multiplicity `p - 1`. Dividing by its constant
  coefficient `p` gives the constant-one polynomial `p⁻¹ Φ_p(X + 1)` with the same slopes.
* By contrast, `Φ_p = 1 + X + ⋯ + X ^ (p - 1)` has all its coefficients of valuation zero, so its
  Newton polygon is flat: it has the slope `0` with multiplicity `p - 1`.

## References

* N. Koblitz, *p-adic Numbers, p-adic Analysis, and Zeta-Functions*, second edition,
  Graduate Texts in Mathematics 58, Springer, 1984, Chapter IV §3.
* J. Neukirch, *Algebraic Number Theory*, Grundlehren 322, Springer, 1999, Chapter II, §§6–7.
-/

public section

open Polynomial TauCeti

namespace TauCeti.NewtonPolygonEisensteinExample

variable {p : ℕ} [Fact p.Prime]

/-! ### `X ^ p - p` -/

section XPowSubP

/-- Over `ℚ_[p]`, `X ^ p - p` is pure of slope `-1 / p` with multiplicity `p`. -/
theorem newtonSlopes_X_pow_sub_C :
    (X ^ p - C (p : ℚ_[p])).newtonSlopes (padicRealValuation p) =
      Multiset.replicate p (-(p : ℝ)⁻¹) := by
  have hp : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  have hdeg : (X ^ p - C (p : ℚ_[p])).natDegree = p := natDegree_X_pow_sub_C (p : ℚ_[p])
  have heis := newtonSlopes_eq_replicate_of_eisenstein (f := X ^ p - C (p : ℚ_[p]))
    (v := padicRealValuation p)
    (by rw [(monic_X_pow_sub_C _ hp).leadingCoeff, AddValuation.map_one])
    (by simp [coeff_X_pow, hp.symm]) fun n hn0 hnd => by
      rw [hdeg] at hnd
      simp [coeff_X_pow, hnd.ne, hn0.ne']
  rwa [hdeg] at heis

variable {L : Type*} [Field L] [Algebra ℚ_[p] L] {w : AddValuation L (WithTop ℝ)}

/-- **`X ^ p - p` forces ramification.** Let `w` on a field extension `L` of `ℚ_[p]` restrict to
`padicRealValuation p`, and let `e • w` take integer values on the nonzero elements of `L`. If `L`
contains a `p`-th root of `p`, then `p ∣ e`. -/
theorem dvd_of_pow_eq (hw : ∀ x, w (algebraMap ℚ_[p] L x) = padicRealValuation p x) {e : ℕ}
    (hL : ∀ y : L, y ≠ 0 → ∃ n : ℤ, w y = ((n / e : ℝ) : WithTop ℝ)) {α : L}
    (hα : α ^ p = algebraMap ℚ_[p] L p) : p ∣ e := by
  have hp : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  have hα₀ : α ≠ 0 := by
    rintro rfl
    rw [zero_pow hp, eq_comm, map_eq_zero_iff _ (algebraMap ℚ_[p] L).injective] at hα
    exact hp (by exact_mod_cast hα)
  have hden : (-(p : ℚ)⁻¹).den = p := by
    rw [Rat.den_neg_eq_den, Rat.inv_natCast_den_of_pos (Nat.pos_of_ne_zero hp)]
  rw [← hden]
  refine den_dvd_of_forall_mem_newtonSlopes_eq hw hL
    (X_pow_sub_C_ne_zero (Nat.pos_of_ne_zero hp) (p : ℚ_[p])) (fun m hm => ?_) hα₀ (by simp [hα])
  rw [newtonSlopes_X_pow_sub_C] at hm
  rw [Multiset.eq_of_mem_replicate hm]
  push_cast
  ring

/-- **The degree-`p` extension generated by a `p`-th root of `p` is totally ramified.** Let `w` on
a field extension `L` of `ℚ_[p]` of degree `p` restrict to `padicRealValuation p`, and let `e • w`
be the integral normalisation of `w`: it takes integer values on the nonzero elements of `L`, and
some `ϖ` has `w ϖ = 1 / e`. If `L` contains a `p`-th root of `p`, then the ramification index `e`
is `p`. -/
theorem eq_of_pow_eq_of_finrank_eq (hw : ∀ x, w (algebraMap ℚ_[p] L x) = padicRealValuation p x)
    (hfin : Module.finrank ℚ_[p] L = p) {e : ℕ}
    (hL : ∀ y : L, y ≠ 0 → ∃ n : ℤ, w y = ((n / e : ℝ) : WithTop ℝ)) {ϖ : L}
    (hϖ : w ϖ = (((e : ℝ)⁻¹ : ℝ) : WithTop ℝ)) {α : L} (hα : α ^ p = algebraMap ℚ_[p] L p) :
    e = p := by
  have hp : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  have : Module.Finite ℚ_[p] L := Module.finite_of_finrank_pos (by omega)
  have hle : e ≤ p := hfin ▸ AddValuation.le_finrank_of_map_eq_inv_natCast
    (fun _ hx => exists_int_padicRealValuation hx) hw hϖ
  -- `e ≠ 0`, since otherwise every nonzero element, including `p`, would have valuation zero
  have he : e ≠ 0 := by
    rintro rfl
    obtain ⟨n, hn⟩ := hL (algebraMap ℚ_[p] L p)
      ((_root_.map_ne_zero _).mpr (Nat.cast_ne_zero.mpr hp))
    rw [hw, padicRealValuation_p, Nat.cast_zero, div_zero] at hn
    exact one_ne_zero (WithTop.coe_eq_coe.mp hn)
  exact le_antisymm hle (Nat.le_of_dvd (Nat.pos_of_ne_zero he) (dvd_of_pow_eq hw hL hα))

end XPowSubP

/-! ### Cyclotomic polynomials -/

section Cyclotomic

/-- Over `ℚ_[p]`, the shifted cyclotomic polynomial `Φ_p(X + 1)` is pure of slope `-1 / (p - 1)`
with multiplicity `p - 1`. -/
theorem newtonSlopes_cyclotomic_comp_X_add_one :
    ((cyclotomic p ℚ_[p]).comp (X + 1)).newtonSlopes (padicRealValuation p) =
      Multiset.replicate (p - 1) (-((p - 1 : ℕ) : ℝ)⁻¹) := by
  have hdeg : ((cyclotomic p ℚ_[p]).comp (X + 1)).natDegree = p - 1 := by
    rw [natDegree_cyclotomic_comp_X_add_one, Nat.totient_prime Fact.out]
  have heis := newtonSlopes_eq_replicate_of_eisenstein
    (f := (cyclotomic p ℚ_[p]).comp (X + 1)) (v := padicRealValuation p)
    (by rw [(monic_cyclotomic_comp_X_add_one p).leadingCoeff, AddValuation.map_one])
    (by rw [coeff_cyclotomic_prime_comp_X_add_one, Nat.choose_one_right, padicRealValuation_p])
    fun n hn0 hnd => by
      rw [hdeg] at hnd
      rw [coeff_cyclotomic_prime_comp_X_add_one]
      exact one_le_padicRealValuation_natCast
        (Nat.Prime.dvd_choose_self Fact.out (by omega) (by omega))
  rwa [hdeg] at heis

/-- The polynomial `p⁻¹ Φ_p(X + 1)`, obtained from `Φ_p(X + 1)` by dividing by its constant
coefficient `p`, has constant coefficient one. -/
theorem coeff_zero_C_inv_mul_cyclotomic_comp_X_add_one :
    (C (p : ℚ_[p])⁻¹ * (cyclotomic p ℚ_[p]).comp (X + 1)).coeff 0 = 1 := by
  rw [coeff_C_mul, coeff_cyclotomic_prime_comp_X_add_one, Nat.choose_one_right]
  exact inv_mul_cancel₀ (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero)

/-- Over `ℚ_[p]`, the constant-one polynomial `p⁻¹ Φ_p(X + 1)` is pure of slope `-1 / (p - 1)`
with multiplicity `p - 1`. -/
theorem newtonSlopes_C_inv_mul_cyclotomic_comp_X_add_one :
    (C (p : ℚ_[p])⁻¹ * (cyclotomic p ℚ_[p]).comp (X + 1)).newtonSlopes (padicRealValuation p) =
      Multiset.replicate (p - 1) (-((p - 1 : ℕ) : ℝ)⁻¹) := by
  rw [newtonSlopes_C_mul _ _ ((padicRealValuation p).ne_top_iff.mpr
    (inv_ne_zero (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero))),
    newtonSlopes_cyclotomic_comp_X_add_one]

/-- Over `ℚ_[p]`, the cyclotomic polynomial `Φ_p` has a flat Newton polygon: its only slope is
`0`, with multiplicity `p - 1`. -/
theorem newtonSlopes_cyclotomic :
    (cyclotomic p ℚ_[p]).newtonSlopes (padicRealValuation p) = Multiset.replicate (p - 1) 0 := by
  set v := padicRealValuation p
  have hp := (Fact.out : p.Prime).one_lt
  have hcoeff (n : ℕ) : (cyclotomic p ℚ_[p]).coeff n = if n < p then 1 else 0 := by
    rw [cyclotomic_prime, finsetSum_coeff]
    simp only [coeff_X_pow, Finset.sum_ite_eq, Finset.mem_range]
  have hc0 : (cyclotomic p ℚ_[p]).coeff 0 = 1 := by simp [hcoeff, hp.pos]
  have htr : (cyclotomic p ℚ_[p]).natTrailingDegree = 0 :=
    natTrailingDegree_eq_zero_of_constantCoeff_ne_zero (by simp [hc0])
  have hdeg : (cyclotomic p ℚ_[p]).natDegree = p - 1 := by
    rw [natDegree_cyclotomic, Nat.totient_prime Fact.out]
  have htrv : v (cyclotomic p ℚ_[p]).trailingCoeff = 0 := by
    rw [trailingCoeff, htr, hc0, AddValuation.map_one]
  have hldv : v (cyclotomic p ℚ_[p]).leadingCoeff = 0 := by
    rw [(cyclotomic.monic p ℚ_[p]).leadingCoeff, AddValuation.map_one]
  refine Multiset.eq_replicate.mpr ⟨?_, (forall_mem_newtonSlopes_eq_iff (by simp [htrv])
    (by simp [hldv])).mpr ⟨by simp [htrv, hldv], fun n => ?_⟩⟩
  · rw [card_newtonSlopes _ _ fun _ => v.top_iff.mp, hdeg, htr, Nat.sub_zero]
  · rw [htrv, hcoeff]
    split_ifs <;> simp

end Cyclotomic

end TauCeti.NewtonPolygonEisensteinExample
