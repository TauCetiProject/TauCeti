module

public import Mathlib.Analysis.Matrix.Normed
public import TauCeti.NumberTheory.Height.Arakelov.IntMatrix

/-!
# Integral kernels against the Bombieri–Vaaler bound

For an integer matrix `A` with `p` independent rows and `n` columns, Bombieri and Vaaler bound
small integral solutions of `A x = 0` by the quotient `√det (A Aᵀ) / g`, where `g` is the gcd of
the maximal minors of `A`. The integral kernel has a `ℤ`-basis whose product of sup norms is at
most `k! / 2 ^ (k - 1)` times this quotient, where `k = n - p`
(`Matrix.exists_basis_ker_mulVecLin_prod_norm_le`). The quotient depends only on the rational row
space of `A`. Siegel's classical bound `(n · max 1 ‖A‖) ^ (p / k)` (Mathlib's
`Int.Matrix.exists_ne_zero_int_vec_norm_le`) depends on the entries of `A`. This file computes
both bounds, and the integral kernel itself, on two examples where `k = 1`. In each one the
kernel is a line `ℤ ∙ v`, so its only bases are `v` and `-v`.

* **Rescaling a row.** The rows `(1, 1)` and `(2, 2)` have Gram determinants `2` and `8` and minor
  gcds `1` and `2`, so both quotients are `√2`. Both integral kernels are generated by `(1, -1)`,
  of sup norm `1 ≤ √2`.
* **A unimodular shear.** The matrix `A` with rows `(1, 0, -1)` and `(0, 1, -1)` has Gram
  determinant `3` and minor gcd `1`, so its quotient is `√3`. The shear `U` with rows `(1, 1)` and
  `(0, 1)` gives `U A`, with rows `(1, 1, -2)` and `(0, 1, -1)`, and the same quotient `√3`. Both
  integral kernels are generated by `(1, 1, 1)`, of sup norm `1 ≤ √3`. Siegel's bound moves from
  `(3 · 1) ^ 2 = 9` for `A` to `(3 · 2) ^ 2 = 36` for `U A`. In the names below, `diff` refers to
  `A`, whose rows compute the differences `x 0 - x 2` and `x 1 - x 2`, and `shear_mul_diff` to
  `U A`.

## Main results

* `TauCeti.IntegralKernelExample.ker_mulVecLin_one_one` and
  `TauCeti.IntegralKernelExample.ker_mulVecLin_two_two`: both kernels are `ℤ ∙ (1, -1)`.
* `TauCeti.IntegralKernelExample.sqrt_det_div_minorGcd_one_one` and
  `TauCeti.IntegralKernelExample.sqrt_det_div_minorGcd_two_two`: both quotients are `√2`.
* `TauCeti.IntegralKernelExample.ker_mulVecLin_diff` and
  `TauCeti.IntegralKernelExample.ker_mulVecLin_shear_mul_diff`: both kernels are `ℤ ∙ (1, 1, 1)`.
* `TauCeti.IntegralKernelExample.sqrt_det_div_minorGcd_diff` and
  `TauCeti.IntegralKernelExample.sqrt_det_div_minorGcd_shear_mul_diff`: both quotients are `√3`.
* `TauCeti.IntegralKernelExample.norm_one_neg_one_le_sqrt_det_div_minorGcd_two_two` and
  `TauCeti.IntegralKernelExample.norm_one_one_one_le_sqrt_det_div_minorGcd_shear_mul_diff`: the
  generators meet the bound.
* `TauCeti.IntegralKernelExample.card_mul_max_one_norm_diff_rpow` and
  `TauCeti.IntegralKernelExample.card_mul_max_one_norm_shear_mul_diff_rpow`: Siegel's bounds `9`
  and `36`.

## References

* E. Bombieri and J. Vaaler, *On Siegel's lemma*, Invent. Math. **73** (1983), 11–32,
  Theorems 1 and 2.
-/

public section

open Matrix

namespace TauCeti.IntegralKernelExample

/-! ### Rescaling a row -/

/-- The row `(1, 1)` has minor gcd `1`. -/
theorem minorGcd_one_one : minorGcd !![(1 : ℤ), 1] = 1 :=
  Int.eq_one_of_dvd_one (minorGcd_nonneg _)
    (by
      convert minorGcd_dvd !![(1 : ℤ), 1] ⟨fun _ ↦ 0, fun _ _ _ ↦ Subsingleton.elim _ _⟩ using 1
      decide)

/-- The row `(1, 1)` has Gram determinant `2`. -/
theorem det_one_one : (!![(1 : ℤ), 1] * !![(1 : ℤ), 1]ᵀ).det = 2 := by
  simp [det_unique, vecMul, dotProduct, Fin.sum_univ_two]

/-- The integral kernel of the row `(1, 1)` is the line through `(1, -1)`. -/
theorem ker_mulVecLin_one_one :
    LinearMap.ker (!![(1 : ℤ), 1]).mulVecLin = ℤ ∙ ![1, -1] := by
  ext x
  rw [LinearMap.mem_ker, mulVecLin_apply, Submodule.mem_span_singleton]
  constructor
  · intro h
    have h0 := congrFun h 0
    simp [mulVec, dotProduct, Fin.sum_univ_two] at h0
    refine ⟨x 0, funext fun i ↦ ?_⟩
    fin_cases i
    · simp
    · simp
      omega
  · rintro ⟨a, rfl⟩
    ext i
    fin_cases i
    simp [mulVec, dotProduct, Fin.sum_univ_two]

/-- The integral kernel of the row `(2, 2)` is the line through `(1, -1)`, as for `(1, 1)`. -/
theorem ker_mulVecLin_two_two :
    LinearMap.ker (!![(2 : ℤ), 2]).mulVecLin = ℤ ∙ ![1, -1] := by
  rw [← ker_mulVecLin_one_one]
  ext x
  simp only [LinearMap.mem_ker, mulVecLin_apply, funext_iff, Fin.forall_fin_one]
  simp [mulVec, dotProduct, Fin.sum_univ_two]
  omega

/-- The Bombieri–Vaaler quotient of the row `(1, 1)` is `√2`. -/
theorem sqrt_det_div_minorGcd_one_one :
    √((!![(1 : ℤ), 1] * !![(1 : ℤ), 1]ᵀ).det : ℝ) / ((minorGcd !![(1 : ℤ), 1] : ℤ) : ℝ) = √2 := by
  rw [det_one_one, minorGcd_one_one]
  norm_num

/-- The Bombieri–Vaaler quotient of the row `(2, 2)` is `√2`, as for `(1, 1)`: rescaling the row
by `2` multiplies the square root of the Gram determinant and the minor gcd by `2`. -/
theorem sqrt_det_div_minorGcd_two_two :
    √((!![(2 : ℤ), 2] * !![(2 : ℤ), 2]ᵀ).det : ℝ) / ((minorGcd !![(2 : ℤ), 2] : ℤ) : ℝ) = √2 := by
  have h : !![(2 : ℤ)] * !![(1 : ℤ), 1] = !![2, 2] := by simp
  rw [← h, sqrt_det_div_minorGcd_mul_left (by simp), sqrt_det_div_minorGcd_one_one]

/-- The generator `(1, -1)` of both kernels has sup norm `1`. -/
theorem norm_one_neg_one : ‖(![1, -1] : Fin 2 → ℤ)‖ = 1 := by
  refine le_antisymm ((pi_norm_le_iff_of_nonneg zero_le_one).2 fun i ↦ ?_) ?_
  · fin_cases i <;> simp
  · simpa using norm_le_pi_norm (![1, -1] : Fin 2 → ℤ) 0

/-- The generator `(1, -1)` of the kernel of the row `(2, 2)` meets the Bombieri–Vaaler bound. -/
theorem norm_one_neg_one_le_sqrt_det_div_minorGcd_two_two :
    ‖(![1, -1] : Fin 2 → ℤ)‖ ≤
      √((!![(2 : ℤ), 2] * !![(2 : ℤ), 2]ᵀ).det : ℝ) / ((minorGcd !![(2 : ℤ), 2] : ℤ) : ℝ) := by
  rw [norm_one_neg_one, sqrt_det_div_minorGcd_two_two]
  exact Real.one_le_sqrt.2 one_le_two

/-! ### A unimodular shear -/

/-- The matrix with rows `(1, 0, -1)` and `(0, 1, -1)` has minor gcd `1`. -/
theorem minorGcd_diff : minorGcd !![(1 : ℤ), 0, -1; 0, 1, -1] = 1 :=
  Int.eq_one_of_dvd_one (minorGcd_nonneg _)
    (by simpa [det_fin_two] using minorGcd_dvd !![(1 : ℤ), 0, -1; 0, 1, -1] ⟨![0, 1], by decide⟩)

/-- The matrix with rows `(1, 0, -1)` and `(0, 1, -1)` has Gram determinant `3`. -/
theorem det_diff :
    (!![(1 : ℤ), 0, -1; 0, 1, -1] * !![(1 : ℤ), 0, -1; 0, 1, -1]ᵀ).det = 3 := by
  simp [det_fin_two, vecMul, dotProduct, Fin.sum_univ_three]

/-- The integral kernel of the matrix with rows `(1, 0, -1)` and `(0, 1, -1)` is the line through
`(1, 1, 1)`. -/
theorem ker_mulVecLin_diff :
    LinearMap.ker (!![(1 : ℤ), 0, -1; 0, 1, -1]).mulVecLin = ℤ ∙ ![1, 1, 1] := by
  ext x
  rw [LinearMap.mem_ker, mulVecLin_apply, Submodule.mem_span_singleton]
  constructor
  · intro h
    have h0 := congrFun h 0
    have h1 := congrFun h 1
    simp only [mulVec, dotProduct, Fin.sum_univ_three] at h0 h1
    refine ⟨x 0, funext fun i ↦ ?_⟩
    fin_cases i <;> simp at h0 h1 ⊢ <;> omega
  · rintro ⟨a, rfl⟩
    ext i
    fin_cases i <;> simp [mulVec, dotProduct, Fin.sum_univ_three]

/-- The shear with rows `(1, 1)` and `(0, 1)` sends the matrix with rows `(1, 0, -1)` and
`(0, 1, -1)` to the matrix with rows `(1, 1, -2)` and `(0, 1, -1)`. -/
theorem shear_mul_diff :
    !![(1 : ℤ), 1; 0, 1] * !![(1 : ℤ), 0, -1; 0, 1, -1] = !![1, 1, -2; 0, 1, -1] := by
  simp

/-- The integral kernel of the matrix with rows `(1, 1, -2)` and `(0, 1, -1)` is the line through
`(1, 1, 1)`, as for the matrix with rows `(1, 0, -1)` and `(0, 1, -1)`. -/
theorem ker_mulVecLin_shear_mul_diff :
    LinearMap.ker (!![(1 : ℤ), 1, -2; 0, 1, -1]).mulVecLin = ℤ ∙ ![1, 1, 1] := by
  rw [← ker_mulVecLin_diff]
  ext x
  simp only [LinearMap.mem_ker, mulVecLin_apply, funext_iff, Fin.forall_fin_two]
  simp [mulVec, dotProduct, Fin.sum_univ_three]
  omega

/-- The Bombieri–Vaaler quotient of the matrix with rows `(1, 0, -1)` and `(0, 1, -1)` is `√3`. -/
theorem sqrt_det_div_minorGcd_diff :
    √((!![(1 : ℤ), 0, -1; 0, 1, -1] * !![(1 : ℤ), 0, -1; 0, 1, -1]ᵀ).det : ℝ) /
      ((minorGcd !![(1 : ℤ), 0, -1; 0, 1, -1] : ℤ) : ℝ) = √3 := by
  rw [det_diff, minorGcd_diff]
  norm_num

/-- The Bombieri–Vaaler quotient of the matrix with rows `(1, 1, -2)` and `(0, 1, -1)` is `√3`,
unchanged by the shear. -/
theorem sqrt_det_div_minorGcd_shear_mul_diff :
    √((!![(1 : ℤ), 1, -2; 0, 1, -1] * !![(1 : ℤ), 1, -2; 0, 1, -1]ᵀ).det : ℝ) /
      ((minorGcd !![(1 : ℤ), 1, -2; 0, 1, -1] : ℤ) : ℝ) = √3 := by
  rw [← shear_mul_diff, sqrt_det_div_minorGcd_mul_left (by simp [det_fin_two]),
    sqrt_det_div_minorGcd_diff]

/-- The generator `(1, 1, 1)` of both kernels has sup norm `1`. -/
theorem norm_one_one_one : ‖(![1, 1, 1] : Fin 3 → ℤ)‖ = 1 := by
  refine le_antisymm ((pi_norm_le_iff_of_nonneg zero_le_one).2 fun i ↦ ?_) ?_
  · fin_cases i <;> simp
  · simpa using norm_le_pi_norm (![1, 1, 1] : Fin 3 → ℤ) 0

/-- The generator `(1, 1, 1)` of the kernel of the sheared matrix with rows `(1, 1, -2)` and
`(0, 1, -1)` meets the Bombieri–Vaaler bound. -/
theorem norm_one_one_one_le_sqrt_det_div_minorGcd_shear_mul_diff :
    ‖(![1, 1, 1] : Fin 3 → ℤ)‖ ≤
      √((!![(1 : ℤ), 1, -2; 0, 1, -1] * !![(1 : ℤ), 1, -2; 0, 1, -1]ᵀ).det : ℝ) /
        ((minorGcd !![(1 : ℤ), 1, -2; 0, 1, -1] : ℤ) : ℝ) := by
  rw [norm_one_one_one, sqrt_det_div_minorGcd_shear_mul_diff]
  exact Real.one_le_sqrt.2 (by norm_num)

section Siegel

attribute [local instance] Matrix.seminormedAddCommGroup

/-- The matrix with rows `(1, 0, -1)` and `(0, 1, -1)` has largest entry `1` in absolute value. -/
theorem norm_diff : ‖!![(1 : ℤ), 0, -1; 0, 1, -1]‖ = 1 :=
  le_antisymm ((norm_le_iff zero_le_one).2 fun i j ↦ by fin_cases i <;> fin_cases j <;> simp)
    (by simpa using norm_entry_le_entrywise_sup_norm !![(1 : ℤ), 0, -1; 0, 1, -1] (i := 0) (j := 0))

/-- The matrix with rows `(1, 1, -2)` and `(0, 1, -1)` has largest entry `2` in absolute value. -/
theorem norm_shear_mul_diff : ‖!![(1 : ℤ), 1, -2; 0, 1, -1]‖ = 2 :=
  le_antisymm ((norm_le_iff zero_le_two).2 fun i j ↦ by
      fin_cases i <;> fin_cases j <;> norm_num [Int.norm_eq_abs])
    (by simpa [Int.norm_eq_abs] using
      norm_entry_le_entrywise_sup_norm !![(1 : ℤ), 1, -2; 0, 1, -1] (i := 0) (j := 2))

/-- Siegel's bound `(n · max 1 ‖A‖) ^ (p / (n - p))` of `Int.Matrix.exists_ne_zero_int_vec_norm_le`
for the matrix with rows `(1, 0, -1)` and `(0, 1, -1)` is `9`. -/
theorem card_mul_max_one_norm_diff_rpow :
    ((Fintype.card (Fin 3) : ℝ) * max 1 ‖!![(1 : ℤ), 0, -1; 0, 1, -1]‖) ^
      ((Fintype.card (Fin 2) : ℝ) / (Fintype.card (Fin 3) - Fintype.card (Fin 2))) = 9 := by
  rw [norm_diff]
  norm_num [Real.rpow_two]

/-- Siegel's bound for the matrix with rows `(1, 1, -2)` and `(0, 1, -1)` is `36`: the shear moves
it, while it leaves the Bombieri–Vaaler quotient and the integral kernel unchanged. -/
theorem card_mul_max_one_norm_shear_mul_diff_rpow :
    ((Fintype.card (Fin 3) : ℝ) * max 1 ‖!![(1 : ℤ), 1, -2; 0, 1, -1]‖) ^
      ((Fintype.card (Fin 2) : ℝ) / (Fintype.card (Fin 3) - Fintype.card (Fin 2))) = 36 := by
  rw [norm_shear_mul_diff]
  norm_num [Real.rpow_two]

end Siegel

end TauCeti.IntegralKernelExample
