module

import TauCeti.Algebra.Module.ZLattice.Scaling
import TauCeti.NumberTheory.Height.Arakelov.Subspace.Covolume

/-!
# Worked example: subspace height and integral-lattice covolume over `ℚ`

For the rational line `W = ℚ ∙ ![1, 2]` in `ℚ²`, this file checks Schmidt's covolume identity
(`Submodule.covolume_intLattice` and `Submodule.covolume_integerLattice`) and compares the
saturated integral lattice with an unsaturated sublattice of index `2`:

* the line `W` has absolute Euclidean height `√5`;
* both `W.intLattice` (in `W.realSpan`) and `W.integerLattice` (in `W.euclideanSpan`) are generated
  by `(1, 2)` in a `1`-dimensional Euclidean span and have covolume `√5`;
* the index-`2` sublattice `(2 : ℝ) • W.integerLattice` generated by `2 • (1, 2)` spans the same
  line over `ℝ` (`W.subspaceHeight` is unchanged) while its covolume doubles to `2 * √5`.

## References

* W. M. Schmidt, *On heights of algebraic subspaces and diophantine approximations*, Ann. of Math.
  **85** (1967), 430–472, §3, Theorem 1.
-/

noncomputable section

open MeasureTheory Module NumberField NumberField.InfinitePlace Submodule

open scoped Classical Pointwise in
example :
    (ℚ ∙ ![(1 : ℚ), 2]).subspaceHeight = √5 ∧
      ZLattice.covolume (ℚ ∙ ![(1 : ℚ), 2]).intLattice = √5 ∧
      ZLattice.covolume (ℚ ∙ ![(1 : ℚ), 2]).integerLattice = √5 ∧
      ZLattice.covolume ((2 : ℝ) • (ℚ ∙ ![(1 : ℚ), 2]).integerLattice) = 2 * √5 := by
  set W : Submodule ℚ (Fin 2 → ℚ) := ℚ ∙ ![(1 : ℚ), 2]
  have hv : ![(1 : ℚ), 2] ≠ 0 := by simp
  have hcast : ![(1 : ℚ), 2] = ((↑) : ℤ → ℚ) ∘ ![1, 2] := by
    ext i
    fin_cases i <;> simp
  have hH : W.subspaceHeight = √5 := by
    rw [subspaceHeight_span_singleton hv, hcast,
      TauCeti.height2_intCast_eq_sqrt_of_gcd_eq_one (by decide)]
    norm_num [Fin.sum_univ_two]
  have hcov_int : ZLattice.covolume W.intLattice = √5 := W.covolume_intLattice.trans hH
  have hcov : ZLattice.covolume W.integerLattice = √5 :=
    W.covolume_intLattice_eq_covolume_integerLattice.symm.trans hcov_int
  have hdim : finrank ℝ W.euclideanSpan = 1 := by
    rw [W.finrank_euclideanSpan, finrank_self, one_mul, finrank_span_singleton hv]
  refine ⟨hH, hcov_int, hcov, ?_⟩
  rw [ZLattice.covolume_smul W.integerLattice volume, hdim, pow_one, hcov]
  norm_num

end
