module

import TauCeti.NumberTheory.Cyclotomic.Tower

/-!
# Checks: finite levels of `ℚ(μ_{2^∞})`

Every element of the field `ℚ(μ_{2^∞})` generated by the `2`-power roots of unity already lies
in a finite level `ℚ(μ_{2^n})`.
-/

namespace TauCeti.Examples.CyclotomicTower

open IntermediateField

variable {Ω : Type*} [Field Ω] [Algebra ℚ Ω]

/-- Every element of `ℚ(μ_{2^∞})` lies in a finite level `ℚ(μ_{2^n})`. -/
example {z : Ω} (hz : z ∈ cyclotomicTower 2 ℚ Ω) :
    ∃ n : ℕ, z ∈ adjoin ℚ {x : Ω | x ^ 2 ^ n = 1} :=
  mem_cyclotomicTower_iff.1 hz

end TauCeti.Examples.CyclotomicTower
