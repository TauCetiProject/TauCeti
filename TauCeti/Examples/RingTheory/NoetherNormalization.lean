/-!
# Examples and sharpness tests for linear Noether normalization

`TauCeti.exists_linear_normalization` constructs, for any nontrivial `k`-algebra `A` over an
infinite field `k` with a finite generating tuple `x : Fin n → A`, an integer `d ≤ n` and a matrix
`C : Matrix (Fin d) (Fin n) k` such that `y i = ∑ j, C i j • x j` is algebraically independent over
`k`, `A` is module-finite over `k[y]`, and `ringKrullDim A = d`. This file tests both the positive
behaviour of linear Noether normalization (algebraic and scheme-theoretic) and the necessity of its
hypotheses.

1. *Polynomial ring*: for `A = MvPolynomial (Fin n) k` with `x = X`, the identity matrix `C = 1`
   normalizes `A` in dimension `n`, whereas any matrix with a zero row fails algebraic independence.
2. *Zero-dimensional presentation and non-flat base change*: for `A = k` generated by `x = ![0]`,
   every linear normalization must have `d = 0`. Over `R = ℤ`, `![2 * Polynomial.X]` is
   algebraically independent in `ℤ[X]`, yet its base change to `(ZMod 2) ⊗[ℤ] ℤ[X]` vanishes,
   showing that `[Module.Flat R K]` in `AlgebraicIndependent.one_tmul` cannot be omitted.
3. *Nonreduced thickened line*: for `A = DualNumber k[X] = k[t, ε]/(ε²)` over any field `k` with
   `x = ![inl X, ε]`, `A` is nonreduced, the coordinate projection `C = !![1, 0]` (`y = ![inl X]`)
   linearly normalizes `A` in dimension `1` and induces a finite surjective morphism
   `Spec A ⟶ 𝔸¹_k`, while `C = !![0, 1]` (`y = ![ε]`) fails algebraic independence because `ε² = 0`.
4. *Necessity of `[Infinite k]`*: over `𝔽₂ = ZMod 2`, the coordinate ring
   `A = 𝔽₂[X₀, X₁]/(X₀ X₁ (X₀ + X₁))` of the union of all three lines through the origin in
   `𝔸²_{𝔽₂}` is nontrivial and generated by `x = ![x₀, x₁]`, yet admits **no** linear Noether
   normalization `(d, C)` over `𝔽₂`: every nonzero linear form `c₀ x₀ + c₁ x₁` with `c₀, c₁ ∈ 𝔽₂`
   vanishes on one of the three lines `X₀ = 0`, `X₁ = 0`, or `X₀ + X₁ = 0`, whereas the nonlinear
   quadratic parameter `z = x₀² + x₀ x₁ + x₁²` does normalize `A`.

## References

* [Stacks Project, Tag 00OW](https://stacks.math.columbia.edu/tag/00OW)
* J. S. Milne, *Algebraic Geometry*, v6.10, Remark 2.47
-/

public section

namespace TauCeti.Examples.NoetherNormalization

open CategoryTheory _root_.AlgebraicGeometry MvPolynomial DualNumber TrivSqZeroExt
open scoped Polynomial TensorProduct

section BasicExamples

/-- In the polynomial ring `MvPolynomial (Fin n) k` over a field `k` with standard coordinate
generators `X`, the identity matrix `1 : Matrix (Fin n) (Fin n) k` is a linear Noether
normalization, and `ringKrullDim (MvPolynomial (Fin n) k) = n`. -/
theorem mvPolynomial_identity_normalization (k : Type*) [Field k] (n : ℕ) :
    let y : Fin n → MvPolynomial (Fin n) k :=
      fun i ↦ ∑ j, (1 : Matrix (Fin n) (Fin n) k) i j • X j
    AlgebraicIndependent k y ∧
      (aeval y : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k).Finite ∧
      ringKrullDim (MvPolynomial (Fin n) k) = (n : WithBot ℕ∞) := by
  have hy : (fun i : Fin n ↦ ∑ j, (1 : Matrix (Fin n) (Fin n) k) i j •
      (X j : MvPolynomial (Fin n) k)) = X := by
    funext i
    simp [Matrix.one_apply]
  have haeval : aeval (R := k) (X : Fin n → MvPolynomial (Fin n) k) =
      AlgHom.id k (MvPolynomial (Fin n) k) := by
    ext i
    simp
  have hfin : (aeval (R := k) (X : Fin n → MvPolynomial (Fin n) k)).Finite := by
    rw [haeval]
    exact AlgHom.Finite.id k (MvPolynomial (Fin n) k)
  dsimp only
  rw [hy]
  exact ⟨algebraicIndependent_X (Fin n) k, hfin, by simp⟩

/-- If a matrix `C : Matrix m n R` over a nontrivial commutative ring `R` has a zero row, then
`y i = ∑ j, C i j • x j` cannot be algebraically independent over `R` in any `R`-algebra `A`. -/
theorem not_algebraicIndependent_of_row_eq_zero {R A m n : Type*} [CommRing R] [Nontrivial R]
    [CommRing A] [Algebra R A] [Fintype n] {C : Matrix m n R} {x : n → A} {i₀ : m}
    (hi₀ : C i₀ = 0) :
    ¬ AlgebraicIndependent R (fun i ↦ ∑ j, C i j • x j) := fun hind ↦
  hind.linearIndependent_row_of_sum_smul.ne_zero i₀ hi₀

/-- The ground field `k` is generated as a `k`-algebra by the single generator `![0] : Fin 1 → k`,
and any linear normalization `(d, C)` of `(k, ![0])` must have target dimension `d = 0`. -/
theorem zero_point_presentation (k : Type*) [Field k] :
    Algebra.adjoin k (Set.range (![0] : Fin 1 → k)) = ⊤ ∧
      ∀ (d : ℕ) (C : Matrix (Fin d) (Fin 1) k),
        AlgebraicIndependent k (fun i ↦ ∑ j, C i j • (![0] : Fin 1 → k) j) → d = 0 := by
  refine ⟨eq_top_iff.mpr fun c _ ↦ by simp, fun d _ hind ↦ ?_⟩
  have := hind.isEmpty_of_isAlgebraic
  by_contra hd
  exact IsEmpty.false (⟨0, Nat.pos_of_ne_zero hd⟩ : Fin d)

/-- **Sharpness of `[Module.Flat R K]` in `AlgebraicIndependent.one_tmul`.** The singleton tuple
`![2 * Polynomial.X] : Fin 1 → ℤ[X]` is algebraically independent over `ℤ`, whereas after base
change along the non-flat `ℤ`-algebra `ZMod 2` the induced tuple in `ZMod 2 ⊗[ℤ] ℤ[X]` is zero and
hence not algebraically independent over `ZMod 2`. -/
theorem not_algebraicIndependent_one_tmul_zmod_two :
    let y : Fin 1 → ℤ[X] := ![2 * Polynomial.X]
    AlgebraicIndependent ℤ y ∧
      ¬ AlgebraicIndependent (ZMod 2) (fun i ↦ (1 ⊗ₜ[ℤ] y i : ZMod 2 ⊗[ℤ] ℤ[X])) := by
  set y : Fin 1 → ℤ[X] := ![2 * Polynomial.X]
  have haeval : aeval (R := ℤ) y =
      (Polynomial.aeval (2 * Polynomial.X : ℤ[X])).comp (uniqueAlgEquiv ℤ (Fin 1)).toAlgHom := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    simp [y, uniqueAlgEquiv]
  refine ⟨?_, fun hind ↦ ?_⟩
  · rw [AlgebraicIndependent, haeval, AlgHom.coe_comp]
    refine Function.Injective.comp (fun p q hpq ↦ sub_eq_zero.mp ?_)
      (uniqueAlgEquiv ℤ (Fin 1)).injective
    have hcomp : (p - q).comp (2 * Polynomial.X : ℤ[X]) = 0 := by
      rw [Polynomial.comp_eq_aeval, map_sub]
      exact sub_eq_zero.mpr hpq
    refine (Polynomial.comp_eq_zero_iff.mp hcomp).resolve_right ?_
    rintro ⟨_, hdeg⟩
    have hc := congr_arg (fun f : ℤ[X] ↦ f.coeff 1) hdeg
    simp at hc
  · have hzero : aeval (R := ZMod 2)
        (fun i ↦ (1 ⊗ₜ[ℤ] y i : ZMod 2 ⊗[ℤ] ℤ[X])) (X 0) = 0 := by
      have htwo : (2 * Polynomial.X : ℤ[X]) = (2 : ℤ) • Polynomial.X := by simp [two_mul, two_smul]
      have hchar : ((2 : ℤ) • (1 : ZMod 2)) = 0 := by decide
      simp only [aeval_X, y, Matrix.cons_val_zero, htwo, ← TensorProduct.smul_tmul, hchar,
        TensorProduct.zero_tmul]
    exact X_ne_zero (R := ZMod 2) (0 : Fin 1) (hind.eq_zero_of_aeval_eq_zero _ hzero)

end BasicExamples

section NonreducedThickenedLine

universe u

variable (k : Type u) [Field k]

/-- The generating tuple `(t, ε)` of the nonreduced `k`-algebra `DualNumber k[X] = k[t, ε]/(ε²)`. -/
noncomputable abbrev thickenedLineGen : Fin 2 → DualNumber k[X] :=
  ![inl Polynomial.X, ε]

/-- The dual-number algebra `DualNumber k[X]` is not reduced. -/
theorem not_isReduced_dualNumber_polynomial : ¬ IsReduced (DualNumber k[X]) := by
  intro ⟨hred⟩
  have heps : (ε : DualNumber k[X]) = 0 := hred ε ⟨2, eps_pow_two⟩
  exact one_ne_zero (α := k[X]) (by simpa using congr_arg snd heps)

/-- `DualNumber k[X]` is generated as a `k`-algebra by `![inl X, ε]`. -/
theorem adjoin_thickenedLineGen :
    Algebra.adjoin k (Set.range (thickenedLineGen k)) = ⊤ := by
  rw [eq_top_iff]
  intro z _
  set S : Subalgebra k (DualNumber k[X]) := Algebra.adjoin k (Set.range (thickenedLineGen k))
  have hX : (inl Polynomial.X : DualNumber k[X]) ∈ S :=
    Algebra.subset_adjoin ⟨0, by simp [thickenedLineGen]⟩
  have heps : (ε : DualNumber k[X]) ∈ S :=
    Algebra.subset_adjoin ⟨1, by simp [thickenedLineGen]⟩
  have hinl : ∀ p : k[X], (inl p : DualNumber k[X]) ∈ S := fun p ↦ by
    induction p using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [inl_add]
      exact S.add_mem hp hq
    | monomial m c =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.smul_eq_C_mul, inl_smul, ← inl_pow]
      exact S.smul_mem (S.pow_mem hX m) c
  have hz : z = inl (fst z) + inl (snd z) * ε := by
    ext <;> simp
  rw [hz]
  exact S.add_mem (hinl (fst z)) (S.mul_mem (hinl (snd z)) heps)

private lemma module_finite_dualNumber_polynomial : Module.Finite k[X] (DualNumber k[X]) := by
  classical
  refine ⟨⟨{1, ε}, eq_top_iff.mpr fun z _ ↦ ?_⟩⟩
  have hz : z = fst z • (1 : DualNumber k[X]) + snd z • (ε : DualNumber k[X]) := by
    ext <;> simp
  rw [hz]
  exact Submodule.add_mem _
    (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
    (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))

/-- On the nonreduced thickened line `DualNumber k[X]`, the first coordinate projection
`C = !![1, 0]` (`y = ![inl X]`) is a linear Noether normalization, whereas the second coordinate
projection `C = !![0, 1]` (`y = ![ε]`) fails algebraic independence over `k`. -/
theorem thickenedLine_projections :
    let x := thickenedLineGen k
    let y₁ : Fin 1 → DualNumber k[X] := fun i ↦ ∑ j, !![(1 : k), 0] i j • x j
    let y₂ : Fin 1 → DualNumber k[X] := fun i ↦ ∑ j, !![(0 : k), 1] i j • x j
    AlgebraicIndependent k y₁ ∧
      (aeval y₁ : MvPolynomial (Fin 1) k →ₐ[k] DualNumber k[X]).Finite ∧
      ¬ AlgebraicIndependent k y₂ := by
  have hy₁ : (fun i : Fin 1 ↦ ∑ j, !![(1 : k), 0] i j • thickenedLineGen k j) =
      ![inl Polynomial.X] := by
    funext i
    fin_cases i
    simp [thickenedLineGen, Fin.sum_univ_two]
  have hy₂ : (fun i : Fin 1 ↦ ∑ j, !![(0 : k), 1] i j • thickenedLineGen k j) = ![ε] := by
    funext i
    fin_cases i
    simp [thickenedLineGen, Fin.sum_univ_two]
  dsimp only
  rw [hy₁, hy₂]
  have hfst : (fstHom k k[X] k[X]).comp (aeval (R := k) (![inl Polynomial.X] :
      Fin 1 → DualNumber k[X])) = (uniqueAlgEquiv k (Fin 1)).toAlgHom := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    simp [uniqueAlgEquiv]
  have hind₁ : AlgebraicIndependent k (![inl Polynomial.X] : Fin 1 → DualNumber k[X]) := by
    refine Function.Injective.of_comp (f := fstHom k k[X] k[X]) ?_
    simpa [← AlgHom.coe_comp, hfst] using (uniqueAlgEquiv k (Fin 1)).injective
  have hinl : aeval (R := k) (![inl Polynomial.X] : Fin 1 → DualNumber k[X]) =
      (inlAlgHom k k[X] k[X]).comp (uniqueAlgEquiv k (Fin 1)).toAlgHom := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    simp [uniqueAlgEquiv]
  have hfin_inl : (inlAlgHom k k[X] k[X]).toRingHom.Finite :=
    RingHom.finite_algebraMap.mpr (module_finite_dualNumber_polynomial k)
  have hfin₁ : (aeval (R := k) (![inl Polynomial.X] : Fin 1 → DualNumber k[X])).Finite := by
    rw [AlgHom.Finite, hinl, AlgHom.toRingHom_eq_coe, AlgHom.comp_toRingHom]
    exact RingHom.Finite.comp hfin_inl (uniqueAlgEquiv k (Fin 1)).toRingEquiv.finite
  refine ⟨hind₁, hfin₁, fun hind₂ ↦ ?_⟩
  have hzero : aeval (R := k) (![ε] : Fin 1 → DualNumber k[X]) (X 0 ^ 2) = 0 := by
    simp [eps_pow_two]
  exact pow_ne_zero 2 (X_ne_zero (R := k) (0 : Fin 1)) (hind₂.eq_zero_of_aeval_eq_zero _ hzero)

/-- Scheme-theoretically, the presentation `thickenedLineGen k ∘ ULift.down` embeds
`Spec (DualNumber k[X])` as a closed subscheme of `𝔸²_k`, and the first coordinate projection
`C = !![1, 0]` restricts to a finite surjective morphism onto `𝔸¹_k`. -/
theorem thickenedLine_scheme_projection :
    let x : ULift.{u} (Fin 2) → DualNumber k[X] := thickenedLineGen k ∘ ULift.down
    let C : Matrix (ULift.{u} (Fin 1)) (ULift.{u} (Fin 2)) k :=
      (!![(1 : k), 0]).submatrix ULift.down ULift.down
    let ι := AffineSpace.homOfTuple k x
    let π := ι ≫ AffineSpace.linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv)
    IsClosedImmersion ι ∧ IsFinite π ∧ Surjective π := by
  have hx : Algebra.adjoin k (Set.range (thickenedLineGen k ∘ ULift.down :
      ULift.{u} (Fin 2) → DualNumber k[X])) = ⊤ := by
    rw [Set.range_comp, ULift.down_surjective.range_eq, Set.image_univ]
    exact adjoin_thickenedLineGen k
  obtain ⟨hind₁, hfin₁, -⟩ := thickenedLine_projections k
  set y₀ : Fin 1 → DualNumber k[X] := fun i ↦ ∑ j, !![(1 : k), 0] i j • thickenedLineGen k j
  let C : Matrix (ULift.{u} (Fin 1)) (ULift.{u} (Fin 2)) k :=
    (!![(1 : k), 0]).submatrix ULift.down ULift.down
  set y : ULift.{u} (Fin 1) → DualNumber k[X] :=
    fun i ↦ ∑ j, C i j • (thickenedLineGen k ∘ ULift.down) j
  have hy : y = y₀ ∘ Equiv.ulift := by
    funext i
    simpa [y, y₀, C] using Equiv.ulift.sum_comp
      fun j ↦ !![(1 : k), 0] i.down j • thickenedLineGen k j
  have hind : AlgebraicIndependent k y :=
    (algebraicIndependent_equiv' Equiv.ulift hy.symm).mpr hind₁
  have haeval : aeval (R := k) y =
      (aeval (R := k) y₀).comp (renameEquiv k Equiv.ulift).toAlgHom := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [hy]
  have hfin : (aeval (R := k) y).Finite := by
    rw [AlgHom.Finite, haeval, AlgHom.toRingHom_eq_coe, AlgHom.comp_toRingHom]
    exact RingHom.Finite.comp hfin₁ (renameEquiv k Equiv.ulift).toRingEquiv.finite
  refine ⟨AffineSpace.isClosedImmersion_homOfTuple_of_adjoin_eq_top hx, ?_, ?_⟩
  · dsimp only
    rw [AffineSpace.homOfTuple_linearMap]
    exact AffineSpace.isFinite_homOfTuple_iff.mpr hfin
  · dsimp only
    rw [AffineSpace.homOfTuple_linearMap]
    exact AffineSpace.surjective_homOfTuple_of_algebraicIndependent_of_isIntegral hind
      hfin.to_isIntegral

end NonreducedThickenedLine

section FiniteFieldCounterexample

/-- The cubic polynomial `X 0 * X 1 * (X 0 + X 1)` defining the union of the three lines through the
origin in `𝔸²_{𝔽₂}`. -/
noncomputable abbrev threeLinesPoly : MvPolynomial (Fin 2) (ZMod 2) :=
  X 0 * X 1 * (X 0 + X 1)

/-- The coordinate ring `𝔽₂[X₀, X₁]/(X₀ X₁ (X₀ + X₁))` of the three lines through the origin in
`𝔸²_{𝔽₂}`. -/
noncomputable abbrev ThreeLinesF2 : Type :=
  MvPolynomial (Fin 2) (ZMod 2) ⧸ Ideal.span {threeLinesPoly}

/-- The coordinate generators `![x₀, x₁]` of `ThreeLinesF2`. -/
noncomputable abbrev threeLinesGen : Fin 2 → ThreeLinesF2 :=
  ![Ideal.Quotient.mk (Ideal.span {threeLinesPoly}) (X 0),
    Ideal.Quotient.mk (Ideal.span {threeLinesPoly}) (X 1)]

private noncomputable def threeLinesProj (v : Fin 2 → (ZMod 2)[X])
    (hv : v 0 * v 1 * (v 0 + v 1) = 0) : ThreeLinesF2 →ₐ[ZMod 2] (ZMod 2)[X] :=
  Ideal.Quotient.liftₐ (Ideal.span {threeLinesPoly}) (aeval v) fun p hp ↦ by
    rw [Ideal.mem_span_singleton] at hp
    obtain ⟨q, rfl⟩ := hp
    simp [threeLinesPoly, hv]

@[simp]
private lemma threeLinesProj_mk (v : Fin 2 → (ZMod 2)[X]) (hv : v 0 * v 1 * (v 0 + v 1) = 0)
    (p : MvPolynomial (Fin 2) (ZMod 2)) :
    threeLinesProj v hv (Ideal.Quotient.mk (Ideal.span {threeLinesPoly}) p) = aeval v p :=
  Ideal.Quotient.lift_mk _ _ _

private lemma not_isIntegral_of_proj_eq_zero {ι : Type*} {y : ι → ThreeLinesF2}
    (hint : (aeval (R := ZMod 2) y).toRingHom.IsIntegral)
    (φ : ThreeLinesF2 →ₐ[ZMod 2] (ZMod 2)[X]) (hy : ∀ i, φ (y i) = 0)
    {a : ThreeLinesF2} (ha : φ a = Polynomial.X) : False := by
  obtain ⟨P, hP_monic, hP_eval⟩ := hint a
  have hcomp : φ.toRingHom.comp (aeval (R := ZMod 2) y).toRingHom =
      Polynomial.C.comp (MvPolynomial.eval 0) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp
    · intro i
      simp [hy i]
  set q : (ZMod 2)[X] := P.map (MvPolynomial.eval 0)
  have hq0 : q = 0 := by
    calc
      q = Polynomial.eval₂ Polynomial.C Polynomial.X q := (Polynomial.eval₂_C_X (p := q)).symm
      _ = Polynomial.eval₂ (Polynomial.C.comp (MvPolynomial.eval 0)) (φ a) P := by
        rw [← ha, Polynomial.eval₂_map]
      _ = φ (Polynomial.eval₂ (aeval (R := ZMod 2) y).toRingHom a P) := by
        rw [← hcomp]
        exact (Polynomial.hom_eval₂ P (aeval (R := ZMod 2) y).toRingHom φ.toRingHom a).symm
      _ = 0 := by rw [hP_eval, map_zero]
  exact (hP_monic.map (MvPolynomial.eval 0)).ne_zero hq0

private lemma not_linear_normalization_dim_zero_or_one {d : ℕ} (hd : d ≤ 1)
    (C : Matrix (Fin d) (Fin 2) (ZMod 2))
    (hind : AlgebraicIndependent (ZMod 2) (fun i ↦ ∑ j, C i j • threeLinesGen j))
    (hfin : (aeval (fun i ↦ ∑ j, C i j • threeLinesGen j) :
      MvPolynomial (Fin d) (ZMod 2) →ₐ[ZMod 2] ThreeLinesF2).Finite) : False := by
  set y : Fin d → ThreeLinesF2 := fun i ↦ ∑ j, C i j • threeLinesGen j
  let φ₁ := threeLinesProj ![0, Polynomial.X] (by simp)
  let φ₂ := threeLinesProj ![Polynomial.X, 0] (by simp)
  let φ₃ := threeLinesProj ![Polynomial.X, Polynomial.X] (by simp [CharTwo.add_self_eq_zero])
  have hφ₁x1 : φ₁ (threeLinesGen 1) = Polynomial.X := by simp [φ₁, threeLinesGen]
  have hφ₂x0 : φ₂ (threeLinesGen 0) = Polynomial.X := by simp [φ₂, threeLinesGen]
  have hφ₃x0 : φ₃ (threeLinesGen 0) = Polynomial.X := by simp [φ₃, threeLinesGen]
  obtain rfl | rfl : d = 0 ∨ d = 1 := by omega
  · exact not_isIntegral_of_proj_eq_zero hfin.to_isIntegral φ₁ (fun i ↦ Fin.elim0 i) hφ₁x1
  · have hy0 : y 0 = C 0 0 • threeLinesGen 0 + C 0 1 • threeLinesGen 1 := Fin.sum_univ_two _
    have hc : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide
    rcases hc (C 0 0) with hc₀ | hc₀ <;> rcases hc (C 0 1) with hc₁ | hc₁
    · have h0 : aeval (R := ZMod 2) y (X 0) = 0 := by simp [hy0, hc₀, hc₁]
      exact X_ne_zero (R := ZMod 2) (0 : Fin 1) (hind.eq_zero_of_aeval_eq_zero _ h0)
    · exact not_isIntegral_of_proj_eq_zero hfin.to_isIntegral φ₂
        (fun i ↦ by fin_cases i; simp [hy0, hc₀, hc₁, φ₂]) hφ₂x0
    · exact not_isIntegral_of_proj_eq_zero hfin.to_isIntegral φ₁
        (fun i ↦ by fin_cases i; simp [hy0, hc₀, hc₁, φ₁]) hφ₁x1
    · exact not_isIntegral_of_proj_eq_zero hfin.to_isIntegral φ₃
        (fun i ↦ by fin_cases i; simp [hy0, hc₀, hc₁, φ₃, CharTwo.add_self_eq_zero]) hφ₃x0

private lemma not_algebraicIndependent_dim_two (C : Matrix (Fin 2) (Fin 2) (ZMod 2)) :
    ¬ AlgebraicIndependent (ZMod 2) (fun i ↦ ∑ j, C i j • threeLinesGen j) := by
  intro hind
  set y : Fin 2 → ThreeLinesF2 := fun i ↦ ∑ j, C i j • threeLinesGen j
  have hli := hind.linearIndependent_row_of_sum_smul
  have hspan : Submodule.span (ZMod 2) (Set.range C.row) = ⊤ :=
    hli.span_eq_top_of_card_eq_finrank (by simp [Module.finrank_fintype_fun_eq_card])
  have hlin : ∀ b : Fin 2 → ZMod 2, ∃ L : MvPolynomial (Fin 2) (ZMod 2),
      aeval y L = ∑ j, b j • threeLinesGen j := fun b ↦ by
    have hb : b ∈ Submodule.span (ZMod 2) (Set.range C.row) := hspan.symm ▸ trivial
    obtain ⟨u, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun (ZMod 2)).mp hb
    refine ⟨∑ i, MvPolynomial.C (u i) * X i, ?_⟩
    simp only [map_sum, map_mul, aeval_C, aeval_X, ← Algebra.smul_def, y, Finset.sum_apply,
      Pi.smul_apply, Matrix.row_apply, Finset.smul_sum, Finset.sum_smul, smul_smul]
    exact Finset.sum_comm
  obtain ⟨L₀, hL₀⟩ := hlin ![1, 0]
  obtain ⟨L₁, hL₁⟩ := hlin ![0, 1]
  rw [Fin.sum_univ_two] at hL₀ hL₁
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, one_smul,
    zero_smul, add_zero, zero_add] at hL₀ hL₁
  let φ₁ := threeLinesProj ![0, Polynomial.X] (by simp)
  let φ₂ := threeLinesProj ![Polynomial.X, 0] (by simp)
  have hL₀_ne : L₀ ≠ 0 := fun h ↦ Polynomial.X_ne_zero (R := ZMod 2) <| by
    have := congr_arg φ₂ hL₀
    simpa [h, φ₂] using this.symm
  have hL₁_ne : L₁ ≠ 0 := fun h ↦ Polynomial.X_ne_zero (R := ZMod 2) <| by
    have := congr_arg φ₁ hL₁
    simpa [h, φ₁] using this.symm
  have hsum_ne : L₀ + L₁ ≠ 0 := fun h ↦ Polynomial.X_ne_zero (R := ZMod 2) <| by
    have hmap : φ₁ (aeval y (L₀ + L₁)) = Polynomial.X := by
      simp [map_add, hL₀, hL₁, φ₁]
    simpa [h] using hmap.symm
  have hprod_ne : L₀ * L₁ * (L₀ + L₁) ≠ 0 :=
    mul_ne_zero (mul_ne_zero hL₀_ne hL₁_ne) hsum_ne
  have hrel : threeLinesGen 0 * threeLinesGen 1 * (threeLinesGen 0 + threeLinesGen 1) = 0 := by
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, ← map_add,
      ← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  have hzero : aeval y (L₀ * L₁ * (L₀ + L₁)) = 0 := by
    rw [map_mul, map_mul, map_add, hL₀, hL₁]
    exact hrel
  exact hprod_ne (hind.eq_zero_of_aeval_eq_zero _ hzero)

/-- `ThreeLinesF2 = 𝔽₂[X₀, X₁]/(X₀ X₁ (X₀ + X₁))` is nontrivial and generated as an `𝔽₂`-algebra
by `threeLinesGen = ![x₀, x₁]`. -/
theorem threeLinesF2_nontrivial_and_adjoin :
    Nontrivial ThreeLinesF2 ∧ Algebra.adjoin (ZMod 2) (Set.range threeLinesGen) = ⊤ := by
  let φ₁ := threeLinesProj ![0, Polynomial.X] (by simp)
  have hnontriv : Nontrivial ThreeLinesF2 :=
    ⟨⟨0, threeLinesGen 1, fun h ↦ Polynomial.X_ne_zero (R := ZMod 2) <| by
      simpa [φ₁] using (congr_arg φ₁ h).symm⟩⟩
  have haeval : aeval (R := ZMod 2) threeLinesGen =
      Ideal.Quotient.mkₐ (ZMod 2) (Ideal.span {threeLinesPoly}) := by
    ext j
    fin_cases j <;> simp
  have hadj : Algebra.adjoin (ZMod 2) (Set.range threeLinesGen) = ⊤ := by
    rw [← aeval_range, haeval, AlgHom.range_eq_top]
    exact Ideal.Quotient.mk_surjective
  exact ⟨hnontriv, hadj⟩

/-- **Sharpness of `[Infinite k]` in `TauCeti.exists_linear_normalization`.** Over the finite field
`𝔽₂ = ZMod 2`, the nontrivial `𝔽₂`-algebra `ThreeLinesF2 = 𝔽₂[X₀, X₁]/(X₀ X₁ (X₀ + X₁))` with
coordinate generators `threeLinesGen` admits no `(d, C)` such that
`y i = ∑ j, C i j • threeLinesGen j` is algebraically independent over `𝔽₂` and `ThreeLinesF2` is
module-finite over `𝔽₂[y]`. -/
theorem not_exists_linear_normalization_threeLinesF2 :
    ¬ ∃ (d : ℕ) (C : Matrix (Fin d) (Fin 2) (ZMod 2)),
      let y : Fin d → ThreeLinesF2 := fun i ↦ ∑ j, C i j • threeLinesGen j
      AlgebraicIndependent (ZMod 2) y ∧
        (aeval y : MvPolynomial (Fin d) (ZMod 2) →ₐ[ZMod 2] ThreeLinesF2).Finite := by
  rintro ⟨d, C, hind, hfin⟩
  have hd_le : d ≤ 2 := by
    simpa using hind.card_le_of_sum_smul
  obtain hd1 | rfl : d ≤ 1 ∨ d = 2 := by omega
  · exact not_linear_normalization_dim_zero_or_one hd1 C hind hfin
  · exact not_algebraicIndependent_dim_two C hind

private lemma algebraicIndependent_quadratic_threeLinesF2 :
    let z : ThreeLinesF2 :=
      threeLinesGen 0 ^ 2 + threeLinesGen 0 * threeLinesGen 1 + threeLinesGen 1 ^ 2
    AlgebraicIndependent (ZMod 2) ![z] := by
  set x₀ := threeLinesGen 0
  set x₁ := threeLinesGen 1
  set z : ThreeLinesF2 := x₀ ^ 2 + x₀ * x₁ + x₁ ^ 2
  let φ₁ := threeLinesProj ![0, Polynomial.X] (by simp)
  have hφ₁z : φ₁.comp (aeval (R := ZMod 2) ![z]) =
      (Polynomial.aeval (Polynomial.X ^ 2 : (ZMod 2)[X])).comp
        (uniqueAlgEquiv (ZMod 2) (Fin 1)).toAlgHom := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    simp [z, x₀, x₁, φ₁, uniqueAlgEquiv]
  have hinj : Function.Injective (φ₁.comp (aeval (R := ZMod 2) ![z])) := by
    rw [hφ₁z, AlgHom.coe_comp]
    refine Function.Injective.comp (fun p q hpq ↦ sub_eq_zero.mp ?_)
      (uniqueAlgEquiv (ZMod 2) (Fin 1)).injective
    have hcomp : (p - q).comp (Polynomial.X ^ 2 : (ZMod 2)[X]) = 0 := by
      rw [Polynomial.comp_eq_aeval, map_sub]
      exact sub_eq_zero.mpr hpq
    refine (Polynomial.comp_eq_zero_iff.mp hcomp).resolve_right ?_
    rintro ⟨_, hdeg⟩
    have := congr_arg Polynomial.natDegree hdeg
    simp at this
  exact Function.Injective.of_comp (f := φ₁) hinj

/-- Although `ThreeLinesF2` admits no *linear* Noether normalization in its coordinate generators
over `𝔽₂`, the quadratic element `z = x₀² + x₀ x₁ + x₁²` is algebraically independent over `𝔽₂`
and `ThreeLinesF2` is module-finite over `𝔽₂[z]`. -/
theorem nonlinear_normalization_threeLinesF2 :
    let z : ThreeLinesF2 :=
      threeLinesGen 0 ^ 2 + threeLinesGen 0 * threeLinesGen 1 + threeLinesGen 1 ^ 2
    AlgebraicIndependent (ZMod 2) ![z] ∧
      (aeval ![z] : MvPolynomial (Fin 1) (ZMod 2) →ₐ[ZMod 2] ThreeLinesF2).Finite := by
  refine ⟨algebraicIndependent_quadratic_threeLinesF2, ?_⟩
  set x₀ := threeLinesGen 0
  set x₁ := threeLinesGen 1
  set z : ThreeLinesF2 := x₀ ^ 2 + x₀ * x₁ + x₁ ^ 2
  have hrel : x₀ * x₁ * (x₀ + x₁) = 0 := by
    simp only [x₀, x₁, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one,
      ← map_add, ← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  set B : Subalgebra (ZMod 2) ThreeLinesF2 := (aeval (R := ZMod 2) ![z]).range
  have hzB : z ∈ B := ⟨X 0, by simp⟩
  -- Both coordinate generators satisfy the monic cubic `u³ - z * u = 0` over `B`.
  have hint_elem : ∀ u : ThreeLinesF2, u ^ 3 - z * u = 0 → IsIntegral B u := fun u hu ↦ by
    refine ⟨Polynomial.X ^ 3 - Polynomial.C (⟨z, hzB⟩ : B) * Polynomial.X, ?_, ?_⟩
    · refine Polynomial.monic_X_pow_sub ?_
      exact (Polynomial.degree_C_mul_X_le _).trans_lt (by decide)
    · simpa [sub_eq_add_neg] using hu
  have hint₀ : IsIntegral B x₀ := hint_elem x₀ (by linear_combination -hrel)
  have hint₁ : IsIntegral B x₁ := hint_elem x₁ (by linear_combination -hrel)
  have hft : Algebra.FiniteType B ThreeLinesF2 := by
    have : Algebra.FiniteType (ZMod 2) ThreeLinesF2 :=
      .of_surjective (Ideal.Quotient.mkₐ (ZMod 2) _) Ideal.Quotient.mk_surjective
    exact .of_restrictScalars_finiteType (ZMod 2) B ThreeLinesF2
  have htop : (⊤ : Subalgebra (ZMod 2) ThreeLinesF2) ≤
      (integralClosure B ThreeLinesF2).restrictScalars (ZMod 2) := by
    rw [← threeLinesF2_nontrivial_and_adjoin.2, Algebra.adjoin_le_iff, Set.range_subset_iff]
    intro j
    fin_cases j
    · exact hint₀
    · exact hint₁
  have : Algebra.IsIntegral B ThreeLinesF2 := ⟨fun _ ↦ htop trivial⟩
  have hfinB : (algebraMap B ThreeLinesF2).Finite :=
    RingHom.finite_algebraMap.mpr (Algebra.IsIntegral.finite (R := B) (A := ThreeLinesF2))
  have hsurj : Function.Surjective (aeval (R := ZMod 2) ![z]).rangeRestrict :=
    fun ⟨_, a, ha⟩ ↦ ⟨a, Subtype.ext ha⟩
  have hfactor : aeval (R := ZMod 2) ![z] = B.val.comp (aeval (R := ZMod 2) ![z]).rangeRestrict :=
    rfl
  rw [AlgHom.Finite, hfactor, AlgHom.toRingHom_eq_coe, AlgHom.comp_toRingHom]
  exact RingHom.Finite.comp hfinB (RingHom.Finite.of_surjective _ hsurj)

end FiniteFieldCounterexample

end TauCeti.Examples.NoetherNormalization
