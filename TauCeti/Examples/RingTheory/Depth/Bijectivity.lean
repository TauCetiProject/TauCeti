module

public import TauCeti.RingTheory.Depth.Bijectivity
public import TauCeti.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Regular.Flat

/-!
# Sharpness of the depth-two bijectivity criterion

For an arbitrary field `k`, the inclusion `(x, y) → k[x, y]` becomes bijective at every prime
other than `(x, y)`, while its source has local depth exactly one at `(x, y)`. It is not
surjective. The final example checks the entire prime-local alternative with the weaker bound
one, including the associated-prime condition on the codomain.

## References

* Stacks Project, Lemma 15.24.13 (Tag 0AV8), for the criterion whose bound is tested.
-/

public section

universe u

namespace LinearMap.BijectiveOfDepth

open scoped Pointwise

variable (field : Type u) [Field field]

/-- The affine plane's polynomial ring over a field. -/
private abbrev Plane := MvPolynomial (Fin 2) field

/-- The maximal ideal generated by the plane's two coordinates. -/
private noncomputable abbrev origin : Ideal (Plane field) :=
  MvPolynomial.idealOfVars (Fin 2) field

/-- The inclusion of the origin ideal misses the constant polynomial one. -/
private theorem inclusion_not_surjective :
    ¬ Function.Surjective (origin field).subtype := by
  intro surjective
  obtain ⟨element, equality⟩ := surjective 1
  have one_mem : (1 : Plane field) ∈ origin field := equality ▸ element.property
  exact (Ideal.IsMaximal.ne_top (inferInstance : (origin field).IsMaximal))
    (Ideal.eq_top_of_isUnit_mem _ one_mem isUnit_one)

/-- Away from the origin, the origin ideal becomes the entire localized ring. -/
private theorem inclusion_localized_bijective
    (prime : Ideal (Plane field)) [prime.IsPrime] (different : prime ≠ origin field) :
    Function.Bijective (LocalizedModule.map prime.primeCompl (origin field).subtype) := by
  refine ⟨LocalizedModule.map_injective prime.primeCompl _ Subtype.val_injective, ?_⟩
  have not_le : ¬ origin field ≤ prime := by
    intro subset
    exact different ((Ideal.IsMaximal.eq_of_le (inferInstance : (origin field).IsMaximal)
      Ideal.IsPrime.ne_top' subset).symm)
  obtain ⟨scalar, in_origin, outside⟩ := Set.not_subset.mp not_le
  intro element
  induction element using LocalizedModule.induction_on with
  | h numerator denominator =>
    refine ⟨LocalizedModule.mk ⟨scalar * numerator,
      (origin field).mul_mem_right numerator in_origin⟩
      (⟨scalar, outside⟩ * denominator), ?_⟩
    rw [LocalizedModule.map_mk]
    exact LocalizedModule.mk_cancel_common_left ⟨scalar, outside⟩ denominator numerator

/-- The two coordinate variables form a weakly regular sequence. -/
private theorem variables_weakly_regular :
    RingTheory.Sequence.IsWeaklyRegular (Plane field)
      [MvPolynomial.X (R := field) (0 : Fin 2), MvPolynomial.X 1] := by
  rw [RingTheory.Sequence.isWeaklyRegular_cons_iff,
    RingTheory.Sequence.isWeaklyRegular_singleton_iff]
  refine ⟨MvPolynomial.isRegular_X.isSMulRegular, ?_⟩
  have scalar_ideal :
      (MvPolynomial.X (0 : Fin 2) : Plane field) • (⊤ : Ideal (Plane field)) =
        Ideal.span {MvPolynomial.X (0 : Fin 2)} := by
    rw [← Submodule.ideal_span_singleton_smul]
    simp
  have quotient_regular :
      IsSMulRegular (QuotSMulTop (MvPolynomial.X (0 : Fin 2)) (Plane field))
        (MvPolynomial.X (1 : Fin 2)) ↔
      IsSMulRegular (Plane field ⧸
        (Ideal.span {MvPolynomial.X (0 : Fin 2)} : Ideal (Plane field)))
        (MvPolynomial.X (1 : Fin 2)) :=
    (Submodule.quotEquivOfEq _ _ scalar_ideal).isSMulRegular_congr _
  apply quotient_regular.mpr
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  have prime : (Ideal.span {MvPolynomial.X (0 : Fin 2)} : Ideal (Plane field)).IsPrime := by
    simpa only [Set.image_singleton] using
      MvPolynomial.span_X_image_isPrime (R := field) ({0} : Set (Fin 2))
  have outside : (MvPolynomial.X (1 : Fin 2) : Plane field) ∉
      (Ideal.span {MvPolynomial.X (0 : Fin 2)} : Ideal (Plane field)) := by
    classical
    rw [← Set.image_singleton, MvPolynomial.span_X_image_eq_ker_aeval_ite_mem, RingHom.mem_ker]
    simp
  intro polynomial member
  exact (prime.mul_mem_iff_mem_or_mem.mp member).resolve_left outside

/-- The ambient polynomial ring has depth at least two at the origin. -/
private theorem ambient_depth_at_origin :
    2 ≤ IsLocalRing.depth
      (ModuleCat.of (Localization.AtPrime (origin field))
        (LocalizedModule (origin field).primeCompl (Plane field))) := by
  let localRing := Localization.AtPrime (origin field)
  let equivalence :
      LocalizedModule (origin field).primeCompl (Plane field) ≃ₗ[localRing] localRing :=
    (IsLocalizedModule.iso (origin field).primeCompl
      (Algebra.linearMap (Plane field) localRing)).extendScalarsOfIsLocalization
      (origin field).primeCompl localRing
  rw [IsLocalRing.depth_eq_of_linearEquiv equivalence,
    IsLocalRing.depth_eq_sSup_length_isRegular]
  have variables_mem : ∀ scalar ∈
      [MvPolynomial.X (R := field) (0 : Fin 2), MvPolynomial.X 1], scalar ∈ origin field := by
    intro scalar member
    rcases List.mem_cons.mp member with rfl | member
    · exact Ideal.subset_span ⟨0, rfl⟩
    · simp only [List.mem_singleton] at member
      subst scalar
      exact Ideal.subset_span ⟨1, rfl⟩
  have regular := (variables_weakly_regular field).isRegular_of_isLocalization_of_mem
    localRing (origin field) variables_mem
  refine le_sSup ⟨_, regular, ?_, by simp⟩
  intro scalar member
  obtain ⟨original, original_mem, rfl⟩ := List.mem_map.mp member
  exact (IsLocalization.AtPrime.to_map_mem_maximal_iff localRing (origin field) original).mpr
    (variables_mem original original_mem)

/-- The origin ideal, as a module, has depth exactly one at the origin. -/
private theorem inclusion_source_depth_one :
    IsLocalRing.depth
      (ModuleCat.of (Localization.AtPrime (origin field))
        (LocalizedModule (origin field).primeCompl (origin field))) = 1 := by
  let localRing := Localization.AtPrime (origin field)
  let localizedInclusion : LocalizedModule (origin field).primeCompl (origin field) →ₗ[localRing]
      LocalizedModule (origin field).primeCompl (Plane field) :=
    LocalizedModule.map (origin field).primeCompl (origin field).subtype
  let localizedQuotient : LocalizedModule (origin field).primeCompl (Plane field) →ₗ[localRing]
      LocalizedModule (origin field).primeCompl (Plane field ⧸ origin field) :=
    LocalizedModule.map (origin field).primeCompl (origin field).mkQ
  have exactness : Function.Exact localizedInclusion localizedQuotient :=
    LocalizedModule.map_exact (origin field).primeCompl _ _
      (LinearMap.exact_subtype_mkQ (origin field))
  -- The quotient by the origin ideal is a simple module and has depth zero locally.
  have quotient_associated : origin field ∈
      associatedPrimes (Plane field) (Plane field ⧸ origin field) := by
    rw [AssociatedPrimes.mem_iff]
    rw [isAssociatedPrime_iff_exists_injective_linearMap]
    exact ⟨inferInstance, LinearMap.id, Function.injective_id⟩
  have quotient_depth :=
    (IsLocalRing.depth_localizedModule_eq_zero_iff_mem_associatedPrimes_of_addCommGroup
      (Plane field) (Plane field ⧸ origin field) (origin field)).mpr quotient_associated
  have inclusion_injective : Function.Injective localizedInclusion :=
    LocalizedModule.map_injective (origin field).primeCompl (origin field).subtype
      Subtype.val_injective
  have quotient_surjective : Function.Surjective localizedQuotient :=
    LocalizedModule.map_surjective (origin field).primeCompl (origin field).mkQ
      (origin field).mkQ_surjective
  have lower := IsLocalRing.depth_min_snd_trd_add_one_le_fst_of_exact (R := localRing)
    (M := LocalizedModule (origin field).primeCompl (origin field))
    (N := LocalizedModule (origin field).primeCompl (Plane field))
    (Q := LocalizedModule (origin field).primeCompl (Plane field ⧸ origin field))
    localizedInclusion localizedQuotient exactness inclusion_injective quotient_surjective
  have upper := IsLocalRing.depth_min_snd_fst_sub_one_le_trd_of_exact (R := localRing)
    (M := LocalizedModule (origin field).primeCompl (origin field))
    (N := LocalizedModule (origin field).primeCompl (Plane field))
    (Q := LocalizedModule (origin field).primeCompl (Plane field ⧸ origin field))
    localizedInclusion localizedQuotient exactness inclusion_injective quotient_surjective
  rw [quotient_depth, zero_add] at lower
  rw [quotient_depth, min_le_iff] at upper
  -- The ambient depth bound and depth-zero quotient give the lower bound one.
  have one_le_two : (1 : ℕ∞) ≤ 2 := by decide
  have ambient_one : 1 ≤ IsLocalRing.depth
      (ModuleCat.of localRing (LocalizedModule (origin field).primeCompl (Plane field))) :=
    one_le_two.trans (ambient_depth_at_origin field)
  rw [min_eq_right ambient_one] at lower
  -- The reverse inequality rules out source depth greater than one.
  apply le_antisymm _ lower
  rcases upper with impossible | source_bound
  · have contradiction := (ambient_depth_at_origin field).trans impossible
    simp at contradiction
  · exact tsub_eq_zero_iff_le.mp (le_antisymm source_bound zero_le)

/-- The inclusion `(x, y) → k[x, y]` is bijective after localization away from the origin,
has source depth one at the origin, and is not surjective. -/
theorem _root_.LinearMap.bijective_of_depth.test_maximal_ideal :
    let ideal : Ideal (MvPolynomial (Fin 2) field) :=
      MvPolynomial.idealOfVars (Fin 2) field
    letI : ideal.IsPrime := MvPolynomial.isPrime_idealOfVars (Fin 2) field
    (∀ (prime : Ideal (MvPolynomial (Fin 2) field)) [prime.IsPrime], prime ≠ ideal →
      Function.Bijective (LocalizedModule.map prime.primeCompl ideal.subtype)) ∧
    IsLocalRing.depth
      (ModuleCat.of (Localization.AtPrime ideal)
        (LocalizedModule ideal.primeCompl ideal)) = 1 ∧
    ¬ Function.Surjective ideal.subtype :=
  ⟨inclusion_localized_bijective field, inclusion_source_depth_one field,
    inclusion_not_surjective field⟩

/-- Replacing two by one in the depth alternative does not imply bijectivity, even for the
inclusion of a finite ideal into a polynomial ring over a field. -/
private theorem bound_one_counterexample :
    (∀ (prime : Ideal (Plane field)) [prime.IsPrime],
      Function.Bijective (LocalizedModule.map prime.primeCompl (origin field).subtype) ∨
        1 ≤ IsLocalRing.depth
          (ModuleCat.of (Localization.AtPrime prime)
            (LocalizedModule prime.primeCompl (origin field))) ∧
          prime ∉ associatedPrimes (Plane field) (Plane field)) ∧
    ¬ Function.Bijective (origin field).subtype := by
  constructor
  · intro prime prime_isPrime
    by_cases equal : prime = origin field
    · subst prime
      right
      constructor
      · rw [inclusion_source_depth_one]
      · intro associated
        have depth_zero :=
          (IsLocalRing.depth_localizedModule_eq_zero_iff_mem_associatedPrimes_of_addCommGroup
            (Plane field) (Plane field) (origin field)).mpr associated
        have depth_two := ambient_depth_at_origin field
        simp [depth_zero] at depth_two
    · exact Or.inl (inclusion_localized_bijective field prime equal)
  · exact fun bijective ↦ inclusion_not_surjective field bijective.2

/-- The origin-ideal inclusion satisfies every bound-one local alternative but is not bijective. -/
theorem _root_.LinearMap.bijective_of_depth.test_maximal_ideal_bound_one :
    let ideal : Ideal (MvPolynomial (Fin 2) field) :=
      MvPolynomial.idealOfVars (Fin 2) field
    letI : ideal.IsPrime := MvPolynomial.isPrime_idealOfVars (Fin 2) field
    (∀ (prime : Ideal (MvPolynomial (Fin 2) field)) [prime.IsPrime],
      Function.Bijective (LocalizedModule.map prime.primeCompl ideal.subtype) ∨
        1 ≤ IsLocalRing.depth
          (ModuleCat.of (Localization.AtPrime prime)
            (LocalizedModule prime.primeCompl ideal)) ∧
          prime ∉ associatedPrimes (MvPolynomial (Fin 2) field)
            (MvPolynomial (Fin 2) field)) ∧
    ¬ Function.Bijective ideal.subtype := by
  simpa only [Plane, origin] using bound_one_counterexample field

end LinearMap.BijectiveOfDepth
