module

public import Mathlib.Algebra.CharP.Subring
public import TauCeti.RingTheory.Perfectoid.PrimitiveUntilt.Basic
public import TauCeti.RingTheory.Perfectoid.UniformTilt.Gauge
public import TauCeti.RingTheory.Perfectoid.Padic
public import TauCeti.NumberTheory.Padics.Complex.Basic

import TauCeti.RingTheory.Huber.Pair.Complete
import TauCeti.RingTheory.Huber.Perfect

/-!
# Checks for the untilt along an ideal of `𝕎 R⁺`

These checks take for `(R, R⁺)` the tilt `ℂ_p♭` of `ℂ_p` with its power-bounded subring, a
perfect complete Hausdorff Tate ring of characteristic `p`.

* Compatibility: `p` is primitive, so the untilt along `(p)` is a complete Hausdorff Tate ring
  into which `𝕎 R⁺ ⧸ (p)` embeds.
* Degenerate case: the untilt along the unit ideal is the zero ring.
* Computation: for every ideal `J`, the class of `[ϖ]` of a pseudouniformiser `ϖ ∈ R⁺` is a
  pseudouniformiser of the untilt, which is `(𝕎 R⁺ ⧸ J)[1/[ϖ]]`.
* Computation: Fontaine's map `θ_J` on `𝕎 R⁺ [1/[ϖ]]` has kernel generated by `J`, and `ϖ♯` is
  a pseudouniformiser of the untilt.
* Recovery: the untilt along `(p)` is `R⁺[1/ϖ]`, by an isomorphism sending `x♯` to `x`, and
  `A⁺ ⧸ (ϖ♯)` is `R⁺ ⧸ (ϖ)` through the zeroth Witt coordinate.
* Computation: along `(p)`, `ϖ♯ ∣ x♯` in `A⁺` exactly when `ϖ ∣ x` in `R⁺`.
* Compatibility: the untilt along the primitive ideal `(p)` is a perfectoid Tate ring.
-/

public section

open Ideal TauCeti.Huber TauCeti.Perfectoid
open WittVector (teichmuller)

namespace TauCeti.Examples.PrimitiveUntilt

variable (p : ℕ) [Fact p.Prime]

/-- `p` is topologically nilpotent in `ℂ_[p]`. -/
scoped instance instFactIsTopologicallyNilpotentPadicComplex :
    Fact (IsTopologicallyNilpotent (p : ℂ_[p])) :=
  ⟨tendsto_pow_atTop_nhds_zero_of_norm_lt_one (PadicComplex.norm_p_lt_one p)⟩

/-- Compatible `p`-power roots of a pseudouniformiser in `ℂ_[p]`. -/
private noncomputable def parameter : PseudoUniformizerRoots p ℂ_[p] :=
  Classical.choice (nonempty_pseudoUniformizerRoots_of_isAlgClosed (PadicComplex.norm_p_lt_one p))

/-- `ℂ_p♭` is a Tate ring. -/
scoped instance instIsTateRingUniformTiltPadicComplex : IsTateRing (uniformTilt p ℂ_[p]) :=
  uniformTilt.isTateRing_of_sharp (ϖ := (parameter p).toTilt)
    (by simpa using (parameter p).isPseudoUniformizer_root_zero)

/-- `ℂ_p♭` is uniform. -/
scoped instance instIsUniformUniformTiltPadicComplex : IsUniform (uniformTilt p ℂ_[p]) :=
  IsUniform.of_perfectRing p

/-- The Huber pair `(ℂ_p♭, ℂ_p♭°)`. -/
noncomputable abbrev pair : Pair (uniformTilt p ℂ_[p]) := Pair.powerBounded _

/-- The integral pseudouniformiser `ϖ ∈ ℂ_p♭°`. -/
noncomputable def varpi : (pair p).plus :=
  ⟨(parameter p).toTilt, by
    rw [Pair.powerBounded_plus, mem_powerBoundedSubring]
    exact IsPowerBounded.of_isTopologicallyNilpotent <|
      (uniformTilt.isTopologicallyNilpotent_iff_coeff_zero (p := p) (B := ℂ_[p])
        (x := (parameter p).toTilt)).mpr <| by
        simpa using (parameter p).isPseudoUniformizer_root_zero.isTopologicallyNilpotent⟩

/-- The zeroth coordinate of `varpi p` in `ℂ_[p]` is a pseudouniformiser. -/
theorem isPseudoUniformizer_coeff_zero_varpi :
    IsPseudoUniformizer (uniformTilt.coeff p ℂ_[p] 0 (varpi p : uniformTilt p ℂ_[p])) := by
  simpa [varpi] using (parameter p).isPseudoUniformizer_root_zero

/-- `varpi p` is a pseudouniformiser of `ℂ_p♭`. -/
theorem isPseudoUniformizer_varpi :
    IsPseudoUniformizer (varpi p : uniformTilt p ℂ_[p]) := by
  rw [isPseudoUniformizer_iff, uniformTilt.isUnit_iff_coeff_zero,
    uniformTilt.isTopologicallyNilpotent_iff_coeff_zero]
  exact isPseudoUniformizer_iff.mp (isPseudoUniformizer_coeff_zero_varpi p)

/-- The mixed-characteristic primitive element `ξ = p - [ϖ] ∈ 𝕎(ℂ_p♭°)`. -/
noncomputable def xi : WittVector p (pair p).plus :=
  (p : WittVector p (pair p).plus) - teichmuller p (varpi p)

/-- Defining formula `xi p = p - [varpi p]`. -/
theorem xi_eq : xi p = (p : WittVector p (pair p).plus) - teichmuller p (varpi p) := by
  simp only [xi]

/-- The zeroth Witt coordinate of `xi p` is `-varpi p`. -/
theorem coeff_zero_xi : (xi p).coeff 0 = -varpi p := by
  simp [xi, WittVector.sub_coeff_zero, WittVector.coeff_p_zero]

/-- `xi p = p - [ϖ]` is primitive in `𝕎(ℂ_p♭°)`. -/
theorem isPrimitive_xi : (xi p).IsPrimitive := by
  have hϖ := isPseudoUniformizer_varpi p
  have hAdic : IsAdic (span {varpi p}) :=
    (pair p).plus.isAdic_span_singleton_of_isOpen_of_isBounded
      (pair p).isRingOfIntegralElements.isOpen (pair p).isRingOfIntegralElements.isBounded
      hϖ (varpi p).property
  have := (pair p).isRingOfIntegralElements.isAdicComplete_span_singleton (varpi p) hϖ
  have hξ : xi p = (p : WittVector p (pair p).plus) + teichmuller p (varpi p) * (-1) := by
    simp [xi, sub_eq_add_neg]
  rw [hξ]
  exact WittVector.isPrimitive_p_add_teichmuller_mul_of_isAdic hAdic
    (mem_span_singleton_self (varpi p)) (-1)

/-- The untilt of `(ℂ_p♭, ℂ_p♭°)` along `ξ = p - [ϖ]` is nontrivial. -/
theorem nontrivial_untilt_xi :
    Nontrivial (untilt p (pair p) (span {xi p})) := by
  rw [nontrivial_iff]
  refine ⟨1, 0, fun h10 ↦ ?_⟩
  have hq : (1 : WittVector p (pair p).plus ⧸ span {xi p}) = 0 :=
    untilt.algebraMap_injective (isPrimitive_xi p) (by simpa using h10)
  have hmem : (1 : WittVector p (pair p).plus) ∈ span {xi p} := by
    rwa [← Ideal.Quotient.eq_zero_iff_mem, map_one]
  obtain ⟨c, hc⟩ := mem_span_singleton.mp hmem
  have h0 := congrArg (WittVector.constantCoeff (p := p) (R := (pair p).plus)) hc
  simp only [map_one, map_mul, WittVector.constantCoeff_apply, xi,
    WittVector.sub_coeff_zero, WittVector.coeff_p_zero, WittVector.teichmuller_coeff_zero,
    zero_sub] at h0
  have hmul : ((-(c.coeff 0) : (pair p).plus) : uniformTilt p ℂ_[p]) *
      (varpi p : uniformTilt p ℂ_[p]) = 1 := by
    have hsub := congrArg Subtype.val h0
    simp only [OneMemClass.coe_one, Subring.coe_mul, Subring.coe_neg] at hsub
    rw [Subring.coe_neg]
    linear_combination -hsub
  have hnil : IsTopologicallyNilpotent (1 : uniformTilt p ℂ_[p]) := by
    rw [← hmul]
    exact ((pair p).isRingOfIntegralElements.isPowerBounded_of_mem
      (-(c.coeff 0)).property).isTopologicallyNilpotent_mul
      (isPseudoUniformizer_varpi p).isTopologicallyNilpotent
  obtain ⟨n, hn⟩ := hnil.exists_pow_mem_of_mem_nhds (isOpen_ne.mem_nhds zero_ne_one)
  exact hn (one_pow n)

/-- Along `ξ = p - [ϖ]`, `untilt.sharp (varpi p) = p`. -/
theorem sharp_varpi :
    untilt.sharp p (pair p) (span {xi p}) (varpi p : uniformTilt p ℂ_[p]) = p :=
  untilt.sharp_eq_natCast (mem_span_singleton_self (xi p))

-- Compatibility: the untilt along the primitive ideal `(p)` is complete and Hausdorff.
example : CompleteSpace (untilt p (pair p) (Ideal.span {(p : WittVector p (pair p).plus)})) :=
  untilt.completeSpace WittVector.isPrimitive_p

example : T2Space (untilt p (pair p) (Ideal.span {(p : WittVector p (pair p).plus)})) :=
  untilt.t2Space WittVector.isPrimitive_p

-- Compatibility: `𝕎 R⁺ ⧸ (p)` embeds into the untilt along `(p)`.
example : Function.Injective
    (algebraMap (WittVector p (pair p).plus ⧸ Ideal.span {(p : WittVector p (pair p).plus)})
      (untilt p (pair p) (Ideal.span {(p : WittVector p (pair p).plus)}))) :=
  untilt.algebraMap_injective WittVector.isPrimitive_p

-- Degenerate case: the untilt along the unit ideal is the zero ring.
example : Subsingleton (untilt p (pair p) ⊤) := by
  refine IsLocalization.subsingleton
    (M := (untiltDenominators p (pair p)).map (Ideal.Quotient.mk ⊤)) ?_
  exact ⟨1, one_mem _, Ideal.Quotient.eq_zero_iff_mem.mpr Submodule.mem_top⟩

-- Computation: the class of `[ϖ]` is a pseudouniformiser, and the untilt is `(𝕎 R⁺ ⧸ J)[1/[ϖ]]`.
example (J : Ideal (WittVector p (pair p).plus)) (ϖ : (pair p).plus)
    (hϖ : IsPseudoUniformizer (ϖ : uniformTilt p ℂ_[p])) :
    IsPseudoUniformizer (algebraMap _ (untilt p (pair p) J)
      (Ideal.Quotient.mk J (WittVector.teichmuller p ϖ))) ∧
    IsLocalization.Away (Ideal.Quotient.mk J (WittVector.teichmuller p ϖ)) (untilt p (pair p) J) :=
  ⟨untilt.isPseudoUniformizer_algebraMap hϖ, untilt.isLocalizationAway hϖ⟩

-- Computation: `θ_J` has kernel generated by `J`, and `ϖ♯` is a pseudouniformiser.
example (J : Ideal (WittVector p (pair p).plus)) (ϖ : (pair p).plus)
    (hϖ : IsPseudoUniformizer (ϖ : uniformTilt p ℂ_[p])) :
    RingHom.ker (untilt.theta J hϖ (Localization.Away (WittVector.teichmuller p ϖ))) =
      J.map (algebraMap _ (Localization.Away (WittVector.teichmuller p ϖ))) ∧
    IsPseudoUniformizer (untilt.sharp p (pair p) J ϖ) :=
  ⟨untilt.ker_theta J hϖ _, untilt.isPseudoUniformizer_sharp hϖ⟩

-- Recovery: the untilt along `(p)` is `R⁺[1/ϖ]`, by an isomorphism sending `x♯` to `x`.
example (ϖ : (pair p).plus) (hϖ : IsPseudoUniformizer (ϖ : uniformTilt p ℂ_[p]))
    (x : (pair p).plus) :
    untilt.spanPEquiv hϖ (Localization.Away ϖ) (untilt.sharpPlus p (pair p) _ x) =
      algebraMap _ (Localization.Away ϖ) x :=
  untilt.spanPEquiv_sharpPlus hϖ _ x

-- Recovery: along `(p)`, `A⁺ ⧸ (ϖ♯) ≃ R⁺ ⧸ (ϖ)` is induced by the zeroth Witt coordinate.
example (ϖ : (pair p).plus) (a : WittVector p (pair p).plus) :
    untilt.quotientSharpEquiv WittVector.isPrimitive_p (ϖ := ϖ) (by simp)
        (Ideal.Quotient.mk _ ⟨algebraMap _ _ a, untilt.algebraMap_mem_untiltPlus _ a⟩) =
      Ideal.Quotient.mk _ (a.coeff 0) :=
  untilt.quotientSharpEquiv_mk _ _ a

-- Computation: along `(p)`, `ϖ♯ ∣ x♯` in `A⁺` exactly when `ϖ ∣ x` in `R⁺`.
example (ϖ x : (pair p).plus) :
    (⟨untilt.sharp p (pair p) _ ϖ, untilt.sharp_mem_untiltPlus ϖ⟩ :
        untiltPlus p (pair p) (Ideal.span {(p : WittVector p (pair p).plus)})) ∣
      ⟨untilt.sharp p (pair p) _ x, untilt.sharp_mem_untiltPlus x⟩ ↔ ϖ ∣ x := by
  simpa [untilt.algebraMap_apply] using untilt.sharp_dvd_algebraMap_iff WittVector.isPrimitive_p
    (ϖ := ϖ) (by simp) (WittVector.teichmuller p x)

-- Compatibility: the untilt along the primitive ideal `(p)` is a perfectoid Tate ring.
example :
    haveI := untilt.completeSpace (P := pair p) WittVector.isPrimitive_p
    haveI := untilt.t2Space (P := pair p) WittVector.isPrimitive_p
    IsPerfectoidTateRing p (untilt p (pair p) (Ideal.span {(p : WittVector p (pair p).plus)})) :=
  untilt.isPerfectoidTateRing WittVector.isPrimitive_p

end TauCeti.Examples.PrimitiveUntilt
