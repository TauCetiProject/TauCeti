module

public import TauCeti.RingTheory.Henselization.DirectLimit

/-!
# Checks for henselization and directed colimits

An infinite system of polynomial rings has transition maps that kill the variable at every
strict step. Its ideal generated by five survives in the direct limit and remains proper.
The henselization comparison applies to this noninjective system, with its stage, inverse and
ideal formulas. The zero-ideal and zero-ring cases are checked separately.
-/

public section

open Polynomial Ring.DirectLimit
open TauCeti.Henselization

namespace TauCeti.Examples.HenselizationDirectLimit

noncomputable section

/-- A polynomial survives only until the next strict transition, where it is evaluated at zero. -/
private def transition (i j : ℕ) (_ : i ≤ j) : ℤ[X] →+* ℤ[X] :=
  if i = j then RingHom.id _ else C.comp (evalRingHom 0)

private theorem transition_C (i j : ℕ) (hij : i ≤ j) (n : ℤ) :
    transition i j hij (C n) = C n := by
  simp [transition]

private instance : DirectedSystem (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) where
  map_self _ _ := by simp [transition]
  map_map k j i hij hjk p := by
    by_cases h : i = j
    · subst j
      simp [transition]
    by_cases h' : j = k
    · subst k
      simp [transition]
    have hik : i ≠ k := by omega
    simp [transition, h, h', hik]

private abbrev stageIdeal (_ : ℕ) : Ideal ℤ[X] := Ideal.span {5}

private theorem compatible (i j : ℕ) (hij : i ≤ j) :
    stageIdeal i ≤ (stageIdeal j).comap (transition i j hij) := by
  rw [Ideal.span_le]
  intro p hp
  obtain rfl := Set.mem_singleton_iff.mp hp
  have h5 : transition i j hij 5 = 5 := by simpa using transition_C i j hij 5
  apply Ideal.mem_comap.mpr
  rw [h5]
  exact Ideal.subset_span (by simp)

/-- There is an infinite directed system preserving the ideal generated by five whose
transition maps are not injective. This is a noninjective input to the henselization comparison. -/
theorem exists_noninjective_directedSystem :
    ∃ f : ∀ i j : ℕ, i ≤ j → ℤ[X] →+* ℤ[X],
      DirectedSystem (fun _ : ℕ ↦ ℤ[X]) (f · · ·) ∧
      (∀ i j (hij : i ≤ j), (Ideal.span {5}).map (f i j hij) ≤ Ideal.span {5}) ∧
      ¬ Function.Injective (f 0 1 (by decide)) := by
  refine ⟨transition, inferInstance, ?_, ?_⟩
  · intro i j hij
    exact Ideal.map_le_iff_le_comap.mpr (compatible i j hij)
  · intro h
    exact X_ne_zero (h (by simp [transition] : transition 0 1 (by decide) X =
      transition 0 1 (by decide) 0))

private noncomputable def evaluation :
    Ring.DirectLimit (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) →+* ℤ :=
  Ring.DirectLimit.lift _ _ _ (fun _ ↦ evalRingHom 0) fun i j hij p ↦ by
    simp only [transition]
    split_ifs <;> simp

-- The system is genuinely noninjective: X is nonzero at a stage and dies at the next one.
example : (X : ℤ[X]) ≠ 0 ∧
    of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) 0 X = 0 := by
  refine ⟨X_ne_zero, ?_⟩
  have ht : transition 0 1 (by decide) X = 0 := by simp [transition]
  rw [← of_f (G := fun _ : ℕ ↦ ℤ[X]) (f := (transition · · ·)) (by decide : 0 ≤ 1) X,
    ht, map_zero]

-- The colimit ideal is nonzero: it contains the image of five, which evaluation detects.
example : (⨆ i, (stageIdeal i).map
    (of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) i)) ≠ ⊥ := by
  intro h
  have hm : of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) 0 5 ∈
      ⨆ i, (stageIdeal i).map (of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) i) :=
    Ideal.mem_iSup_of_mem 0 (Ideal.mem_map_of_mem _ (Ideal.subset_span (by simp)))
  rw [h, Ideal.mem_bot] at hm
  have := congrArg evaluation hm
  norm_num [evaluation] at this

-- Evaluation carries the colimit ideal exactly to (5), so it is proper as well.
example : (⨆ i, (stageIdeal i).map
    (of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) i)) ≠ ⊤ := by
  intro h
  have he : (⨆ i, (stageIdeal i).map
      (of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) i)).map evaluation = Ideal.span {5} := by
    simp [Ideal.map_iSup, stageIdeal, Ideal.map_span, evaluation]
  rw [h, Ideal.map_top] at he
  have : (1 : ℤ) ∈ Ideal.span {(5 : ℤ)} := he ▸ Submodule.mem_top
  norm_num [Ideal.mem_span_singleton] at this

-- The forward stage formula works on all elements of a stage henselization, not just scalars.
example (i : ℕ) (x : algebra (stageIdeal i)) :
    directLimitEquiv transition stageIdeal compatible
      (of (fun i ↦ algebra (stageIdeal i))
        (directLimitTransition transition stageIdeal compatible · · ·) i x) =
      map (of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) i)
        (le_iSup (fun j ↦ (stageIdeal j).map
          (of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) j)) i) x := by
  simp

-- The inverse formula is usable from an importing module without unfolding the equivalence.
example (i : ℕ) :
    (directLimitEquiv transition stageIdeal compatible).symm
      (algebraMap _ _ (of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) i 5)) =
      of (fun i ↦ algebra (stageIdeal i))
        (directLimitTransition transition stageIdeal compatible · · ·) i
          (algebraMap ℤ[X] (algebra (stageIdeal i)) 5) := by
  simp

-- The same comparison also identifies the defining ideals, not just the underlying rings.
example :
    (⨆ i, (extended (stageIdeal i)).map
      (of (fun i ↦ algebra (stageIdeal i))
        (directLimitTransition transition stageIdeal compatible · · ·) i)).map
      (directLimitEquiv transition stageIdeal compatible).toRingHom =
    extended (⨆ i, (stageIdeal i).map
      (of (fun _ : ℕ ↦ ℤ[X]) (transition · · ·) i)) := by
  simp

-- Zero ideals remain zero, for arbitrary transition maps, including noninjective ones.
example {ι : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
    (R : ι → Type*) [∀ i, CommRing (R i)] (f : ∀ i j, i ≤ j → R i →+* R j)
    [DirectedSystem R (f · · ·)] :
    Nonempty (Ring.DirectLimit (fun _ : ι ↦ algebra (⊥ : Ideal (R _)))
        (directLimitTransition f (fun _ ↦ ⊥) (fun _ _ _ ↦ bot_le) · · ·) ≃+*
      algebra (⊥ : Ideal (Ring.DirectLimit R (f · · ·)))) := by
  have h : (⨆ i, (⊥ : Ideal (R i)).map (of R (f · · ·) i)) = ⊥ := by simp
  rw [← h]
  exact ⟨directLimitEquiv f (fun _ ↦ ⊥) (fun _ _ _ ↦ bot_le)⟩

private instance : DirectedSystem (fun _ : ℕ ↦ ZMod 1)
    (fun _ _ _ ↦ RingHom.id (ZMod 1)) where
  map_self _ _ := rfl
  map_map _ _ _ _ _ _ := rfl

-- The zero ring is allowed, even when the defining ideal is the unit ideal.
example :
    Nonempty (Ring.DirectLimit (fun _ : ℕ ↦ algebra (⊤ : Ideal (ZMod 1)))
        (directLimitTransition (fun _ _ _ ↦ RingHom.id (ZMod 1))
          (fun _ ↦ ⊤) (fun _ _ _ ↦ le_top) · · ·) ≃+*
      algebra (⨆ i : ℕ, (⊤ : Ideal (ZMod 1)).map
        (of (fun _ : ℕ ↦ ZMod 1) (fun _ _ _ ↦ RingHom.id (ZMod 1)) i))) :=
  ⟨directLimitEquiv (fun _ _ _ ↦ RingHom.id (ZMod 1))
    (fun _ ↦ ⊤) (fun _ _ _ ↦ le_top)⟩

end

end TauCeti.Examples.HenselizationDirectLimit
