/-!
# Tests for unramified, tamely and totally ramified extensions of a discrete valuation ring

For a height-one prime `v` of `ℤ` containing a prime number `p`, the localization
`ℤ_(v) = Localization.AtPrime v.asIdeal` is `ℤ_(p)`: a discrete valuation ring with fraction field
`ℚ` and uniformizer `p`. These tests compute the ramification of two quadratic fields with respect
to it, in the sense of `TauCeti.Algebra.IsUnramifiedWRT`, `TauCeti.Algebra.IsTamelyRamifiedWRT`
and `TauCeti.Algebra.IsTotallyRamifiedWRT` (Stacks, Definition 15.113.7).

* `ℚ(i)` is not tamely ramified with respect to `ℤ_(2)`. Here `1 + i` is a root of the Eisenstein
  polynomial `X² - 2X + 2`, so `ℤ_(2)[1 + i]` is a discrete valuation ring, hence the integral
  closure of `ℤ_(2)` in `ℚ(i)`, and its maximal ideal has ramification index `2`, which vanishes in
  the residue field `𝔽₂`.
* `ℚ(ζ₃)` is tamely and totally ramified with respect to `ℤ_(3)`, with ramification index `2`:
  it is generated by `2ζ₃ + 1`, a square root of the uniformizer `-3`, and `2` is invertible
  in `𝔽₃`.
* `ℚ(i)` is unramified with respect to `ℤ_(5)`, and the integral closure of `ℤ_(5)` in it has
  exactly two maximal ideals. The integral closure is the image of the étale algebra
  `ℤ_(5)[x] ⧸ (x² + 1)`, whose discriminant `-4` is a unit; its maximal ideals are the kernels of
  the two reductions `x ↦ 2` and `x ↦ -2` to `𝔽₅`, since `x² + 1 ≡ (x - 2) (x + 2)` modulo `5`.
-/

public section

open IntermediateField IsDedekindDomain IsLocalRing Polynomial
open scoped TensorProduct

namespace TauCeti.Examples.TamelyRamifiedWRT

variable (v : HeightOneSpectrum ℤ) {L : Type*} [Field L] [Algebra ℚ L]
  [Algebra (Localization.AtPrime v.asIdeal) L] [IsScalarTower (Localization.AtPrime v.asIdeal) ℚ L]

/-- An integer outside `v` is a unit of `ℤ_(v)`. -/
private theorem isUnit_intCast_of_notMem {n : ℤ} (hn : n ∉ v.asIdeal) :
    IsUnit (n : Localization.AtPrime v.asIdeal) := by
  simpa using (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime v.asIdeal)
    v.asIdeal n).mpr hn

/-- If `v` contains `m`, it does not contain `m - 1`. -/
private theorem sub_one_notMem {m : ℤ} (hm : m ∈ v.asIdeal) : m - 1 ∉ v.asIdeal := fun h ↦
  v.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (by simpa using v.asIdeal.sub_mem hm h))

/-- Over a local ring `A`, a map `φ` from `A[x] ⧸ (x² + 1)` to the residue field of `A` sending
`x` to the residue of `c` sends `z` to the residue of `re z + c im z`. -/
private theorem apply_eq_residue {A : Type*} [CommRing A] [IsLocalRing A] {c : A}
    (φ : QuadraticAlgebra A (-1) 0 →ₐ[A] ResidueField A)
    (hφ : φ QuadraticAlgebra.omega = residue A c) (z : QuadraticAlgebra A (-1) 0) :
    φ z = residue A (z.re + z.im * c) := by
  conv_lhs => rw [← QuadraticAlgebra.re_smul_add_im_smul z]
  simp [Algebra.smul_def, hφ]

/-- Over a local ring `A`, let `φ` map `A[x] ⧸ (x² + 1)` to the residue field of `A`, sending `x`
to the residue of `c`. Every maximal ideal containing `x - c` is the kernel of `φ`. -/
private theorem eq_ker_of_omega_sub_mem {A : Type*} [CommRing A] [IsLocalRing A] {c : A}
    (φ : QuadraticAlgebra A (-1) 0 →ₐ[A] ResidueField A)
    (hφ : φ QuadraticAlgebra.omega = residue A c)
    (M : Ideal (QuadraticAlgebra A (-1) 0)) [M.IsMaximal]
    (hM : QuadraticAlgebra.omega - algebraMap A _ c ∈ M) : M = RingHom.ker φ := by
  refine (φ.ker_isMaximal_residueField.eq_of_le (Ideal.IsMaximal.ne_top ‹_›)
    fun z hz ↦ ?_).symm
  -- Write `z = (re z + c im z) + im z (x - c)`; the first term lies in `𝔪_A`, which `M` contains.
  have hcomap : M.comap (algebraMap A _) = maximalIdeal A :=
    IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under A M)
  have hmem : z.re + z.im * c ∈ M.comap (algebraMap A _) := by
    rw [hcomap, ← residue_eq_zero_iff, ← apply_eq_residue φ hφ]
    exact hz
  have hz : z = algebraMap A _ (z.re + z.im * c) +
      z.im • (QuadraticAlgebra.omega - algebraMap A _ c) := by
    conv_lhs => rw [← QuadraticAlgebra.re_smul_add_im_smul z]
    simp only [Algebra.smul_def, map_add, map_mul, mul_one]
    ring
  rw [hz, Algebra.smul_def]
  exact add_mem hmem (M.mul_mem_left _ hM)

/-- Over a local ring `A`, if `c² + 1` lies in the maximal ideal and `2c` is a unit, then
`A[x] ⧸ (x² + 1)` has exactly two maximal ideals: the kernels of the reductions `x ↦ c` and
`x ↦ -c` to the residue field, since `x² + 1 ≡ (x - c) (x + c)`. -/
private theorem ncard_setOf_isMaximal_quadraticAlgebra {A : Type*} [CommRing A] [IsLocalRing A]
    {c : A} (hc : c * c + 1 ∈ maximalIdeal A) (h2c : IsUnit (2 * c)) :
    {M : Ideal (QuadraticAlgebra A (-1) 0) | M.IsMaximal}.ncard = 2 := by
  have hroot (d : A) (hd : d * d + 1 ∈ maximalIdeal A) :
      residue A d * residue A d = (-1 : A) • 1 + (0 : A) • residue A d := by
    simpa [eq_neg_iff_add_eq_zero] using (residue_eq_zero_iff (d * d + 1)).mpr hd
  set φ : QuadraticAlgebra A (-1) 0 →ₐ[A] ResidueField A := QuadraticAlgebra.lift ⟨_, hroot c hc⟩
  set φ' : QuadraticAlgebra A (-1) 0 →ₐ[A] ResidueField A :=
    QuadraticAlgebra.lift ⟨_, hroot (-c) (by rwa [neg_mul_neg])⟩
  have hφ : φ QuadraticAlgebra.omega = residue A c := by simp [φ]
  have hφ' : φ' QuadraticAlgebra.omega = residue A (-c) := by simp [φ']
  rw [Set.ncard_eq_two]
  refine ⟨RingHom.ker φ, RingHom.ker φ', fun h ↦ ?_, Set.ext fun M ↦ ⟨fun hM ↦ ?_, ?_⟩⟩
  · -- `x - c` lies in the first kernel but not in the second, as `2c` is a unit.
    have hx : QuadraticAlgebra.omega - algebraMap A _ c ∈ RingHom.ker φ := by
      simp [apply_eq_residue φ hφ]
    rw [h, RingHom.mem_ker, apply_eq_residue φ' hφ', residue_eq_zero_iff] at hx
    refine (mem_maximalIdeal _).mp ?_ h2c
    rw [show 2 * c = -(-c + -c) by ring]
    exact neg_mem (by simpa using hx)
  · -- `(x - c) (x + c) = -(c² + 1)` lies in every maximal ideal.
    have hM : M.IsMaximal := hM
    have hprod : (QuadraticAlgebra.omega - algebraMap A _ c) *
        (QuadraticAlgebra.omega - algebraMap A _ (-c)) =
          algebraMap A (QuadraticAlgebra A (-1) 0) (-(c * c + 1)) := by
      ext
      · simp [QuadraticAlgebra.re_one]
        ring
      · simp [QuadraticAlgebra.im_one]
    have hmem : (QuadraticAlgebra.omega - algebraMap A _ c) *
        (QuadraticAlgebra.omega - algebraMap A _ (-c)) ∈ M := by
      rw [hprod, ← Ideal.mem_comap, ← Ideal.under_def,
        IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under A M)]
      exact neg_mem hc
    rcases hM.isPrime.mem_or_mem hmem with hx | hx
    · exact Or.inl (eq_ker_of_omega_sub_mem φ hφ M hx)
    · exact Or.inr (eq_ker_of_omega_sub_mem φ' hφ' M hx)
  · rintro (rfl | rfl)
    · exact φ.ker_isMaximal_residueField
    · exact φ'.ker_isMaximal_residueField

/-- In a field `L` over `ℚ`, a square root `i` of `-1` is not rational, so `1` and `i` are
linearly independent over every subring `A` of `ℚ`. -/
private theorem linearIndependent_one_of_sq_eq_neg_one (A : Type*) [CommRing A]
    [Algebra A ℚ] [IsFractionRing A ℚ] [Algebra A L] [IsScalarTower A ℚ L] {i : L}
    (hi : i ^ 2 = -1) : LinearIndependent A ![1, i] := by
  rw [LinearIndependent.pair_iff]
  intro s t hst
  rw [Algebra.smul_def, Algebra.smul_def, mul_one, IsScalarTower.algebraMap_apply A ℚ L s,
    IsScalarTower.algebraMap_apply A ℚ L t] at hst
  have ht : algebraMap A ℚ t = 0 := by
    by_contra ht
    -- Otherwise `i` would be rational.
    have hi' : algebraMap ℚ L (-algebraMap A ℚ s / algebraMap A ℚ t) = i := by
      rw [map_div₀, map_neg, div_eq_iff ((_root_.map_ne_zero _).mpr ht)]
      linear_combination -hst
    have hq : (-algebraMap A ℚ s / algebraMap A ℚ t) ^ 2 = -1 :=
      (algebraMap ℚ L).injective (by rw [map_pow, hi', hi, map_neg, map_one])
    nlinarith [sq_nonneg (-algebraMap A ℚ s / algebraMap A ℚ t)]
  have hs : algebraMap A ℚ s = 0 := by
    rw [ht, map_zero, zero_mul, add_zero] at hst
    exact (map_eq_zero_iff _ (algebraMap ℚ L).injective).mp hst
  exact ⟨IsFractionRing.injective A ℚ (by rw [hs, map_zero]),
    IsFractionRing.injective A ℚ (by rw [ht, map_zero])⟩

/-- *test_gaussian_two*: `ℚ(i)` is not tamely ramified with respect to `A = ℤ_(2)`. The integral
closure of `A` in `ℚ(i)` is `A[1 + i]`, a discrete valuation ring whose maximal ideal has
ramification index `2` over `A`, and `2` vanishes in the residue field of `A`. -/
theorem test_gaussian_two (hv : (2 : ℤ) ∈ v.asIdeal) {i : L} (hi : i ^ 2 = -1)
    (hgen : ℚ⟮i⟯ = ⊤) :
    IsIntegralClosure (Algebra.adjoin (Localization.AtPrime v.asIdeal) {1 + i})
        (Localization.AtPrime v.asIdeal) L ∧
      IsDiscreteValuationRing (Algebra.adjoin (Localization.AtPrime v.asIdeal) {1 + i}) ∧
      (∀ (P : Ideal (Algebra.adjoin (Localization.AtPrime v.asIdeal) {1 + i})) [P.IsMaximal],
        P.ramificationIdx (Localization.AtPrime v.asIdeal) = 2) ∧
      ¬ Algebra.IsTamelyRamifiedWRT (Localization.AtPrime v.asIdeal) L := by
  set A := Localization.AtPrime v.asIdeal
  set B := Algebra.adjoin A {1 + i}
  have h2 : Irreducible (2 : A) := by
    simpa using v.irreducible_natCast_localizationAtPrime Nat.prime_two (by exact_mod_cast hv)
  -- `1 + i` is a root of the Eisenstein polynomial `X² - 2X + 2`, and it generates `B`.
  set f : A[X] := X ^ 2 + C (-2) * X + C 2 with hfdef
  have hf : f.IsEisensteinAt (maximalIdeal A) :=
    isEisensteinAt_X_pow_add_C_mul_X_add_C_of_irreducible
      (neg_mem ((mem_maximalIdeal _).mpr h2.not_isUnit)) h2 le_rfl
  have hmo : f.Monic := by rw [hfdef]; monicity!
  have hdeg : f.natDegree = 2 := by rw [hfdef]; compute_degree!
  have hroot : aeval (1 + i) f = 0 := by
    simp only [hfdef, map_add, map_mul, map_pow, aeval_X, map_neg, map_ofNat]
    linear_combination hi
  set β : B := ⟨1 + i, Algebra.self_mem_adjoin_singleton A _⟩
  have hx : aeval β f = 0 := Subtype.ext ((Subalgebra.aeval_coe B β f).symm.trans hroot)
  have hadj : Algebra.adjoin A {β} = ⊤ := by
    apply Subalgebra.map_injective (f := B.val) Subtype.val_injective
    rw [AlgHom.map_adjoin, Set.image_singleton, Algebra.map_top, Subalgebra.range_val]
    simp [β, B]
  have := FaithfulSMul.trans A ℚ L
  have := hf.isDiscreteValuationRing_of_adjoin_eq_top hmo hx hadj
  have : Algebra.IsIntegral A B :=
    have := Algebra.finite_adjoin_simple_of_isIntegral (R := A) (x := 1 + i) ⟨f, hmo, hroot⟩
    inferInstance
  have : IsFractionRing B L := by
    refine TauCeti.IntermediateField.isFractionRing_algebra_adjoin_of_adjoin_eq_top (K := ℚ) ?_
    rw [eq_top_iff, ← hgen, adjoin_simple_le_iff]
    simpa using sub_mem (mem_adjoin_simple_self ℚ (1 + i)) (one_mem ℚ⟮1 + i⟯)
  have he (P : Ideal B) [P.IsMaximal] : P.ramificationIdx A = 2 :=
    hdeg ▸ hf.ramificationIdx_eq_natDegree hmo hx hadj P
  refine ⟨inferInstance, inferInstance, he, fun h ↦ ?_⟩
  -- The ramification index `2` is the uniformizer of `A`, so it vanishes in the residue field.
  have : (maximalIdeal B).LiesOver (maximalIdeal A) :=
    ⟨(IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under A (maximalIdeal B))).symm⟩
  have := ((Algebra.isTamelyRamifiedWRT_iff_of_isIntegralClosure B).mp h (maximalIdeal B)).2
  rw [he, ← map_natCast (Ideal.Quotient.mk _), Nat.cast_ofNat,
    Ideal.Quotient.eq_zero_iff_mem.mpr ((mem_maximalIdeal _).mpr h2.not_isUnit)] at this
  exact not_isUnit_zero this

/-- *test_cyclotomic_three*: `ℚ(ζ₃)` is tamely and totally ramified with respect to `A = ℤ_(3)`,
and the maximal ideal of the integral closure of `A` in `ℚ(ζ₃)` has ramification index `2`. -/
theorem test_cyclotomic_three (hv : (3 : ℤ) ∈ v.asIdeal) {ζ : L} (hζ : IsPrimitiveRoot ζ 3)
    (hgen : ℚ⟮ζ⟯ = ⊤) :
    Algebra.IsTamelyRamifiedWRT (Localization.AtPrime v.asIdeal) L ∧
      Algebra.IsTotallyRamifiedWRT (Localization.AtPrime v.asIdeal) L ∧
      ∀ (P : Ideal (integralClosure (Localization.AtPrime v.asIdeal) L)) [P.IsMaximal],
        P.ramificationIdx (Localization.AtPrime v.asIdeal) = 2 := by
  set A := Localization.AtPrime v.asIdeal
  -- `α = 2ζ + 1` is a square root of the uniformizer `-3`, and it generates `L`.
  have hπ : Irreducible (-3 : A) := (show Associated (3 : A) (-3) from ⟨-1, by simp⟩).irreducible
    (by simpa using
      v.irreducible_natCast_localizationAtPrime Nat.prime_three (by exact_mod_cast hv))
  have hζ₃ : 1 + ζ + ζ ^ 2 = 0 := by
    simpa [Finset.sum_range_succ] using hζ.geom_sum_eq_zero (by norm_num)
  have hα : (2 * ζ + 1) ^ 2 = algebraMap A L (-3) := by
    rw [map_neg, map_ofNat]
    linear_combination 4 * hζ₃
  have hgen' : ℚ⟮2 * ζ + 1⟯ = ⊤ := by
    rw [eq_top_iff, ← hgen, adjoin_simple_le_iff]
    have h : algebraMap ℚ L (1 / 2) * (2 * ζ + 1 - 1) ∈ ℚ⟮2 * ζ + 1⟯ :=
      mul_mem (IntermediateField.algebraMap_mem _ _)
        (sub_mem (mem_adjoin_simple_self ℚ _) (one_mem _))
    have hζ : algebraMap ℚ L (1 / 2) * (2 * ζ + 1 - 1) = ζ := by
      have := charZero_of_injective_algebraMap (algebraMap ℚ L).injective
      simp
    rwa [hζ] at h
  have h2 : IsUnit ((2 : ℕ) : A ⧸ maximalIdeal A) := by
    have := (isUnit_intCast_of_notMem v (sub_one_notMem v hv)).map
      (Ideal.Quotient.mk (maximalIdeal A))
    norm_num at this ⊢
    exact this
  exact ⟨(IsDiscreteValuationRing.isTamelyRamifiedWRT_iff_of_pow_eq_of_irreducible (K := ℚ) hπ
      two_ne_zero hα hgen').mpr h2,
    IsDiscreteValuationRing.isTotallyRamifiedWRT_of_pow_eq_of_irreducible (K := ℚ) hπ
      two_ne_zero hα hgen',
    fun P _ ↦ IsDiscreteValuationRing.ramificationIdx_eq_of_pow_eq_of_irreducible (K := ℚ) hπ
      two_ne_zero hα hgen' P⟩

/-- *test_gaussian_five*: `ℚ(i)` is unramified with respect to `A = ℤ_(5)`, and the integral closure
of `A` in `ℚ(i)` has exactly two maximal ideals. -/
theorem test_gaussian_five (hv : (5 : ℤ) ∈ v.asIdeal) {i : L} (hi : i ^ 2 = -1)
    (hgen : ℚ⟮i⟯ = ⊤) :
    Algebra.IsUnramifiedWRT (Localization.AtPrime v.asIdeal) L ∧
      {P : Ideal (integralClosure (Localization.AtPrime v.asIdeal) L) | P.IsMaximal}.ncard =
        2 := by
  set A := Localization.AtPrime v.asIdeal
  have h4 : IsUnit (4 : A) := by simpa using isUnit_intCast_of_notMem v (sub_one_notMem v hv)
  -- `A[x] ⧸ (x² + 1)` is étale over `A`: its discriminant is `-4`.
  have : Algebra.Etale A (QuadraticAlgebra A (-1) 0) :=
    QuadraticAlgebra.etale_iff_isUnit_discr.mpr <| by
      simpa [QuadraticAlgebra.discr_def] using h4.neg
  -- The generic fibre of `A[x] ⧸ (x² + 1)` maps onto `L = ℚ(i)` by `x ↦ i`.
  have hii : i * i = (-1 : A) • (1 : L) + (0 : A) • i := by simp [← sq, hi]
  set ψ : QuadraticAlgebra A (-1) 0 →ₐ[A] L := QuadraticAlgebra.lift ⟨i, hii⟩
  set χ : ℚ ⊗[A] QuadraticAlgebra A (-1) 0 →ₐ[ℚ] L :=
    Algebra.TensorProduct.lift (Algebra.ofId ℚ L) ψ fun _ _ ↦ .all _ _
  have hχ : Function.Surjective χ := by
    have hint : IsIntegral ℚ i := ⟨X ^ 2 + 1, monic_X_pow_add_C _ two_ne_zero, by simp [hi]⟩
    rw [← AlgHom.range_eq_top, eq_top_iff, ← IntermediateField.top_toSubalgebra, ← hgen,
      adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic, Algebra.adjoin_le_iff,
      Set.singleton_subset_iff]
    exact ⟨1 ⊗ₜ QuadraticAlgebra.omega, by simp [χ, ψ]⟩
  refine ⟨AlgHom.isUnramifiedWRT_of_surjective χ hχ, ?_⟩
  -- The integral closure of `A` in `L` is the image of `A[x] ⧸ (x² + 1)`, which maps injectively
  -- to `L`, so it has the two maximal ideals over `x ↦ 2` and `x ↦ -2`.
  have hrange : integralClosure A L = ψ.range := by
    rw [AlgHom.integralClosure_eq_range_of_surjective χ hχ]
    congr 1
    ext
    simp [χ, ψ]
  have hψ : Function.Injective ψ :=
    (QuadraticAlgebra.lift_injective_iff hii).mpr (linearIndependent_one_of_sq_eq_neg_one A hi)
  let e : QuadraticAlgebra A (-1) 0 ≃ₐ[A] integralClosure A L :=
    (AlgEquiv.ofInjective ψ hψ).trans (Subalgebra.equivOfEq _ _ hrange.symm)
  rw [Set.ncard_congr (t := {M : Ideal (QuadraticAlgebra A (-1) 0) | M.IsMaximal})
    (fun P _ ↦ P.comap e)
    (fun _ hP ↦ (Ideal.isMaximal_comap_iff_of_bijective _ e.bijective).mpr hP)
    (fun _ _ _ _ h ↦ Ideal.comap_injective_of_surjective _ e.surjective h)
    (fun M (hM : M.IsMaximal) ↦ ⟨M.map e,
      (Ideal.isMaximal_map_iff_of_bijective _ e.bijective).mpr hM,
      Ideal.comap_map_of_bijective _ e.bijective⟩)]
  refine ncard_setOf_isMaximal_quadraticAlgebra (c := 2) ?_
    (by rw [show (2 : A) * 2 = 4 by ring]; exact h4)
  have h5 := (IsLocalization.AtPrime.to_map_mem_maximal_iff A v.asIdeal 5).mpr hv
  rw [map_ofNat] at h5
  rwa [show (2 : A) * 2 + 1 = 5 by ring]

end TauCeti.Examples.TamelyRamifiedWRT
