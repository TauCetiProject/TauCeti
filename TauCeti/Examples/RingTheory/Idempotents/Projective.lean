module

public import Mathlib.Algebra.Ring.Rat
public import TauCeti.RingTheory.Idempotents.Projective

/-!
# Checks: a projective principal idempotent ideal that is not free

Over `A = ℚ × ℚ`, the ideal `M = A e` generated by the idempotent `e = (1, 0)` is projective, since
multiplication by `e` splits its inclusion in `A`, but it is not free: `(0, 1)` is a nonzero
scalar killing `M`. Its rank is `1` at one point of `Spec A` and `0` at the other.

This module is the shared fixture of the Checks for the projective trace and the projective
determinant on modules that are not free.
-/

public section

namespace TauCeti.ProjectiveIdealCheck

/-- The idempotent `e = (1, 0)` of `ℚ × ℚ`. -/
abbrev e : ℚ × ℚ := (1, 0)

/-- `e = (1, 0)` is idempotent. -/
theorem isIdempotentElem_e : IsIdempotentElem e := by
  simp [IsIdempotentElem, e]

/-- The projective module `M = A e` over `A = ℚ × ℚ`. -/
abbrev M : Type := (Ideal.span {e} : Ideal (ℚ × ℚ))

instance instProjectiveM : Module.Projective (ℚ × ℚ) M :=
  isIdempotentElem_e.projective_span_singleton

/-- Multiplication by `e` splits the inclusion of `M` in `ℚ × ℚ`. -/
theorem toSpanSingleton_comp_subtype :
    LinearMap.toSpanSingleton (ℚ × ℚ) M (spanSingletonGenerator e) ∘ₗ (Ideal.span {e}).subtype =
      LinearMap.id :=
  LinearMap.ext (smul_spanSingletonGenerator isIdempotentElem_e)

/-- `M = A e` is not free: `(0, 1)` kills `M`, but a nonzero free module is faithful. -/
theorem not_free : ¬ Module.Free (ℚ × ℚ) M := by
  intro _
  have : Nontrivial M := ⟨⟨spanSingletonGenerator e, 0, by simp [Subtype.ext_iff, e]⟩⟩
  have h := eq_of_smul_eq_smul (α := M) (m₁ := ((0, 1) : ℚ × ℚ)) (m₂ := 0) fun m ↦ by
    obtain ⟨r, rfl⟩ := exists_smul_spanSingletonGenerator m
    rw [smul_smul]
    ext <;> simp [e]
  simp [Prod.ext_iff] at h

end TauCeti.ProjectiveIdealCheck
