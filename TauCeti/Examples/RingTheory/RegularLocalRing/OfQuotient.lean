module

public import Mathlib.RingTheory.Ideal.Quotient.Noetherian
public import TauCeti.RingTheory.RegularLocalRing.Basic
public import TauCeti.RingTheory.RegularLocalRing.OfQuotient
public import TauCeti.RingTheory.RegularLocalRing.PowerSeries

/-!
# Tests: a regular quotient by a nonzerodivisor is needed for regularity

`TauCeti.IsRegularLocalRing.of_quotient_nonZeroDivisor` (Stacks, Lemma 10.106.7 (00NU)) says
that a Noetherian local ring `R` with a nonzerodivisor `x ∈ 𝔪_R` such that `R ⧸ (x)` is a
regular local ring is itself a regular local ring. The regularity hypothesis on the quotient
cannot be dropped.

Let `k` be a field and `R = k⟦x, y⟧ ⧸ (y² - x³)`, the complete local ring of the cusp. Then `R`
is a Noetherian local ring and `x` is a nonunit nonzerodivisor of `R`. The quotient `R ⧸ (x)` is
`k⟦y⟧ ⧸ (y²)`, the ring of dual numbers over `k` (that is, `k[y] ⧸ (y²)`), which is not a domain
and so is not regular. And `R` is not regular: the cusp equation is a nonzero element of the
square of the maximal ideal of the regular local ring `k⟦x, y⟧` (Stacks, Lemma 10.106.3 (00NQ)).

As in the other power series checks, `k⟦x, y⟧` is `k⟦y⟧⟦x⟧`, with `x = X` and `y = C X`. Setting
`x = 0` is then the constant coefficient map `k⟦y⟧⟦x⟧ → k⟦y⟧`, and `x` is a prime element.

## References

* [Stacks Project, Lemma 10.106.7](https://stacks.math.columbia.edu/tag/00NU).
* [Stacks Project, Lemma 10.106.3](https://stacks.math.columbia.edu/tag/00NQ).
-/

public section

open IsLocalRing Ideal PowerSeries

namespace TauCeti

noncomputable section Cusp

variable (k : Type*) [Field k]

/-- The cusp equation `y² - x³` in `k⟦y⟧⟦x⟧`, with `x = X` and `y = C X`. -/
private abbrev cusp : k⟦X⟧⟦X⟧ := C (X : k⟦X⟧) ^ 2 - X ^ 3

/-- The complete local ring `k⟦x, y⟧ ⧸ (y² - x³)` of the cusp. -/
private abbrev CuspRing := k⟦X⟧⟦X⟧ ⧸ span {cusp k}

/-- The image of `x` in the cusp ring. -/
private abbrev cuspX : CuspRing k := Ideal.Quotient.mk _ X

/-- Setting `x = 0` and reducing modulo `y²`: the map `k⟦y⟧⟦x⟧ → k⟦y⟧ ⧸ (y²)`. -/
private abbrev toDualNumbers : k⟦X⟧⟦X⟧ →+* k⟦X⟧ ⧸ span {(X : k⟦X⟧) ^ 2} :=
  (Ideal.Quotient.mk _).comp constantCoeff

private theorem constantCoeff_cusp : constantCoeff (cusp k) = X ^ 2 := by
  simp [cusp]

private theorem cusp_ne_zero : cusp k ≠ 0 := fun h ↦
  pow_ne_zero 2 X_ne_zero ((constantCoeff_cusp k).symm.trans (by rw [h, map_zero]))

private theorem cusp_mem_maximalIdeal_sq : cusp k ∈ maximalIdeal k⟦X⟧⟦X⟧ ^ 2 := by
  have hm := TauCeti.PowerSeries.maximalIdeal_eq_span_C_X (R := k⟦X⟧) irreducible_X
  have hx : (X : k⟦X⟧⟦X⟧) ∈ maximalIdeal k⟦X⟧⟦X⟧ := hm ▸ subset_span (by simp)
  have hy : C (X : k⟦X⟧) ∈ maximalIdeal k⟦X⟧⟦X⟧ := hm ▸ subset_span (by simp)
  refine sub_mem (pow_mem_pow hy 2) ?_
  rw [pow_succ]
  exact mul_mem_right _ _ (pow_mem_pow hx 2)

private theorem cusp_mem_maximalIdeal : cusp k ∈ maximalIdeal k⟦X⟧⟦X⟧ :=
  pow_le_self two_ne_zero (cusp_mem_maximalIdeal_sq k)

/-- The kernel of `x ↦ 0, y² ↦ 0` is generated by the cusp equation and `x`: the ideal `(y²)` of
`k⟦y⟧` is the image of `(y² - x³)` under `x ↦ 0`, whose kernel is `(x)`. -/
private theorem ker_toDualNumbers : RingHom.ker (toDualNumbers k) = span {cusp k} ⊔ span {X} := by
  rw [← RingHom.comap_ker, mk_ker, ← constantCoeff_cusp, ← Set.image_singleton, ← map_span,
    comap_map_of_surjective _ (constantCoeff_surj (R := k⟦X⟧)), ← RingHom.ker_eq_comap_bot,
    TauCeti.PowerSeries.ker_constantCoeff]

private theorem toDualNumbers_surjective : Function.Surjective (toDualNumbers k) :=
  Ideal.Quotient.mk_surjective.comp constantCoeff_surj

/-- `R ⧸ (x) ≅ k⟦y⟧ ⧸ (y²)`. -/
private def quotientCuspXEquiv :
    CuspRing k ⧸ span {cuspX k} ≃+* k⟦X⟧ ⧸ span {(X : k⟦X⟧) ^ 2} :=
  (quotEquivOfEq (by rw [map_span, Set.image_singleton])).trans <|
    (DoubleQuot.quotQuotEquivQuotSup _ _).trans <|
      (quotEquivOfEq (ker_toDualNumbers k).symm).trans <|
        RingHom.quotientKerEquivOfSurjective (toDualNumbers_surjective k)

/-- The cusp ring is a local ring. -/
private theorem isLocalRing_cuspRing : IsLocalRing (CuspRing k) :=
  have : Nontrivial (CuspRing k) := Ideal.Quotient.nontrivial_iff.mpr fun h ↦
    (mem_maximalIdeal _).mp (cusp_mem_maximalIdeal k) (span_singleton_eq_top.mp h)
  .of_surjective' _ Ideal.Quotient.mk_surjective

/-- `x` is not a unit of the cusp ring, since otherwise `R ⧸ (x) ≅ k⟦y⟧ ⧸ (y²)` would be zero. -/
private theorem cuspX_mem_nonunits : cuspX k ∈ nonunits (CuspRing k) := fun h ↦ by
  have : Nontrivial (k⟦X⟧ ⧸ span {(X : k⟦X⟧) ^ 2}) :=
    Ideal.Quotient.nontrivial_iff.mpr fun hX ↦ by
      simpa using (span_singleton_eq_top.mp hX).map (constantCoeff (R := k))
  exact not_subsingleton _ ((quotientCuspXEquiv k).toEquiv.subsingleton_congr.mp
    (Ideal.Quotient.subsingleton_iff.mpr (span_singleton_eq_top.mpr h)))

/-- `x` is a nonzerodivisor of the cusp ring: if `g x ∈ (y² - x³)`, then `x` divides the
cofactor, since `x` is prime and does not divide `y² - x³`. -/
private theorem cuspX_mem_nonZeroDivisors : cuspX k ∈ nonZeroDivisors (CuspRing k) := by
  refine mem_nonZeroDivisors_iff_right.mpr fun r hr ↦ ?_
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective r
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, mem_span_singleton'] at hr
  obtain ⟨h, hh⟩ := hr
  have hX : ¬ (X : k⟦X⟧⟦X⟧) ∣ cusp k := by
    rw [X_dvd_iff, constantCoeff_cusp]
    exact pow_ne_zero 2 X_ne_zero
  obtain ⟨h', rfl⟩ := (prime_X.dvd_or_dvd ⟨g, by rw [mul_comm, hh, mul_comm]⟩).resolve_left hX
  rw [Ideal.Quotient.eq_zero_iff_mem, mem_span_singleton']
  exact ⟨h', mul_left_cancel₀ X_ne_zero (by rw [← mul_assoc, hh, mul_comm])⟩

/-- `R ⧸ (x) ≅ k⟦y⟧ ⧸ (y²)` is not a regular local ring: a regular local ring is a domain, but
`y` is a nonzero nilpotent of `k⟦y⟧ ⧸ (y²)`. -/
private theorem not_isRegularLocalRing_quotient_cuspX :
    ¬ IsRegularLocalRing (CuspRing k ⧸ span {cuspX k}) := fun _ ↦ by
  have :=
    IsRegularLocalRing.of_ringEquiv (R := CuspRing k ⧸ span {cuspX k}) (quotientCuspXEquiv k)
  have hX : Ideal.Quotient.mk (span {(X : k⟦X⟧) ^ 2}) X ≠ 0 := by
    rw [Ne, Ideal.Quotient.eq_zero_iff_mem, mem_span_singleton, X_pow_dvd_iff]
    exact fun h ↦ by simpa using h 1 (by decide)
  refine hX (pow_eq_zero_iff (n := 2) two_ne_zero |>.mp ?_)
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact mem_span_singleton_self _

/-- The cusp ring is not a regular local ring: the cusp equation is a nonzero element of the
square of the maximal ideal of the regular local ring `k⟦x, y⟧`. -/
private theorem not_isRegularLocalRing_cuspRing : ¬ IsRegularLocalRing (CuspRing k) := fun h ↦
  (IsRegularLocalRing.quotient_span_singleton_iff (cusp_mem_maximalIdeal k) (cusp_ne_zero k)).mp h
    (cusp_mem_maximalIdeal_sq k)

/-- *test_cusp_quotient*: for a field `k`, the cusp ring `R = k⟦x, y⟧ ⧸ (y² - x³)` is a
Noetherian local ring in which `x` is a nonunit nonzerodivisor, and `R ⧸ (x) ≅ k⟦y⟧ ⧸ (y²)`.
Neither `R ⧸ (x)` nor `R` is a regular local ring, so the hypothesis that `R ⧸ (x)` is regular
cannot be dropped from `TauCeti.IsRegularLocalRing.of_quotient_nonZeroDivisor`. Here
`k⟦x, y⟧ = k⟦y⟧⟦x⟧`, with `x = X` and `y = C X`. -/
theorem IsRegularLocalRing.of_quotient_nonZeroDivisor.test_cusp_quotient :
    let R := k⟦X⟧⟦X⟧ ⧸ span {C (X : k⟦X⟧) ^ 2 - X ^ 3}
    let x : R := Ideal.Quotient.mk _ X
    IsNoetherianRing R ∧ IsLocalRing R ∧ x ∈ nonunits R ∧ x ∈ nonZeroDivisors R ∧
      Nonempty (R ⧸ span {x} ≃+* k⟦X⟧ ⧸ span {(X : k⟦X⟧) ^ 2}) ∧
      ¬ IsRegularLocalRing (R ⧸ span {x}) ∧ ¬ IsRegularLocalRing R :=
  ⟨inferInstanceAs (IsNoetherianRing (CuspRing k)), isLocalRing_cuspRing k,
    cuspX_mem_nonunits k, cuspX_mem_nonZeroDivisors k, ⟨quotientCuspXEquiv k⟩,
    not_isRegularLocalRing_quotient_cuspX k, not_isRegularLocalRing_cuspRing k⟩

end Cusp

end TauCeti
