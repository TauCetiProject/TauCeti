module

public import Mathlib.Algebra.Field.Rat
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.LinearCombination
import TauCeti.LinearAlgebra.Determinant.Basic
public import TauCeti.RingTheory.CubicRing.IndexForm

/-!
# Checks for the index form of a based cubic ring

The split cubic ring `ℤ³ = Fin 3 → ℤ` has the basis `⟨1, e₀, e₁⟩`, where `e₀, e₁` are the first
two coordinate idempotents. Its index form is `x y² - x² y`, and the subring generated by
`e₀ + 2 e₁ = (1, 2, 0)` has index `2 = |I(1, 2)|`, while `e₀` generates a subring of infinite index,
matching `I(1, 0) = 0`. Replacing `b 1, b 2` by `2 • b 1, 2 • b 2` multiplies the index form by
`2`, not by the factor `8` of the untwisted substitution, so the determinant twist in the change of
basis is necessary. Negating `b 1` and `b 2` negates the index form.
-/

public section

open Module

namespace TauCeti.IndexFormChecks

/-- The coordinates of `v = c • 1 + p • e₀ + q • e₁` in `ℤ³` are `(c, p, q)`. -/
def splitEquiv : (Fin 3 → ℤ) ≃ₗ[ℤ] (Fin 3 → ℤ) where
  toFun v := ![v 2, v 0 - v 2, v 1 - v 2]
  invFun w := ![w 0 + w 1, w 0 + w 2, w 0]
  map_add' v w := by funext i; fin_cases i <;> simp <;> ring
  map_smul' r v := by funext i; fin_cases i <;> simp <;> ring
  left_inv v := by funext i; fin_cases i <;> simp
  right_inv w := by funext i; fin_cases i <;> simp

/-- The basis `⟨1, e₀, e₁⟩` of the split cubic ring `ℤ³`. -/
noncomputable def splitBasis : Basis (Fin 3) ℤ (Fin 3 → ℤ) := Basis.ofEquivFun splitEquiv

/-- The first vector of `splitBasis` is `1`. -/
theorem splitBasis_zero : splitBasis 0 = 1 := by
  funext i; fin_cases i <;> simp [splitBasis, splitEquiv]

/-- The second vector of `splitBasis` is the idempotent `e₀`. -/
theorem splitBasis_one : splitBasis 1 = ![1, 0, 0] := by
  funext i; fin_cases i <;> simp [splitBasis, splitEquiv]

/-- The third vector of `splitBasis` is the idempotent `e₁`. -/
theorem splitBasis_two : splitBasis 2 = ![0, 1, 0] := by
  funext i; fin_cases i <;> simp [splitBasis, splitEquiv]

/-- The coordinates of `v` in `splitBasis` are `(v 2, v 0 - v 2, v 1 - v 2)`. -/
theorem splitBasis_repr (v : Fin 3 → ℤ) (i : Fin 3) :
    splitBasis.repr v i = ![v 2, v 0 - v 2, v 1 - v 2] i := by
  simp [splitBasis, splitEquiv]

/-- The index form of `⟨1, e₀, e₁⟩` in `ℤ³` is `x y² - x² y`. -/
example : splitBasis.indexForm = ⟨0, -1, 1, 0⟩ := by
  ext <;> simp [splitBasis.det_vecCons_one splitBasis_zero, splitBasis_one, splitBasis_two,
    splitBasis_repr, sq]

/-- The subring of `ℤ³` generated by `(1, 2, 0) = e₀ + 2 e₁` has index `|I(1, 2)| = 2`. -/
example :
    (Subring.closure {(![1, 2, 0] : Fin 3 → ℤ)}).toAddSubgroup.index = 2 := by
  rw [splitBasis.index_closure_eq_natAbs_indexForm splitBasis_zero]
  simp [splitBasis.det_vecCons_one splitBasis_zero, splitBasis_one, splitBasis_two,
    splitBasis_repr, sq]

/-- The subring of `ℤ³` generated by the idempotent `e₀` has infinite index, recorded as index `0`,
matching `I(1, 0) = 0`. -/
example :
    (Subring.closure {(![1, 0, 0] : Fin 3 → ℤ)}).toAddSubgroup.index = 0 := by
  rw [splitBasis.index_closure_eq_natAbs_indexForm splitBasis_zero]
  simp [splitBasis.det_vecCons_one splitBasis_zero, splitBasis_one, splitBasis_two,
    splitBasis_repr, sq]

/-- **The determinant twist is necessary.** Over `ℚ`, fixing `1` and replacing `b 1, b 2` by
`2 • b 1, 2 • b 2` multiplies the index form by `2`, whereas the untwisted substitution
`(x, y) ↦ (2 x, 2 y)` multiplies a binary cubic form by `8`. -/
example {A : Type*} [CommRing A] [Algebra ℚ A] (b b' : Basis (Fin 3) ℚ A) (hb : b 0 = 1)
    (hb' : b' 0 = 1) (h₁ : b' 1 = (2 : ℚ) • b 1) (h₂ : b' 2 = (2 : ℚ) • b 2) (x y : ℚ) :
    b'.indexForm.a * x ^ 3 + b'.indexForm.b * x ^ 2 * y + b'.indexForm.c * x * y ^ 2 +
        b'.indexForm.d * y ^ 3 =
      2 * (b.indexForm.a * x ^ 3 + b.indexForm.b * x ^ 2 * y + b.indexForm.c * x * y ^ 2 +
        b.indexForm.d * y ^ 3) := by
  have hc := b.det_mul_indexForm_eq_indexForm hb b' x y
  rw [b.det_eq_of_apply_zero_eq_one hb hb'] at hc
  simp [h₁, h₂] at hc ⊢
  linear_combination hc / 4

/-- Negating `b 1` and `b 2` negates the index form. -/
example {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] (b b' : Basis (Fin 3) R A)
    (hb : b 0 = 1) (hb' : b' 0 = 1) (h₁ : b' 1 = -b 1) (h₂ : b' 2 = -b 2) :
    b'.indexForm = ⟨-b.indexForm.a, -b.indexForm.b, -b.indexForm.c, -b.indexForm.d⟩ := by
  have hdet : b'.det = b.det := Basis.det_eq_det_of_det_eq_one <| by
    rw [b.det_eq_of_apply_zero_eq_one hb hb', h₁, h₂]
    simp
  ext <;> simp [hdet, b.det_vecCons_one hb, h₁, h₂, sq] <;> ring

end TauCeti.IndexFormChecks
