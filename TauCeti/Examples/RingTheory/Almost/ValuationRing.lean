module

import TauCeti.RingTheory.Almost.ValuationRing
import TauCeti.NumberTheory.Padics.Complex.MaximalIdeal
import Mathlib.NumberTheory.Padics.RingHoms

/-!
# Examples of the basic setup of a valuation ring

These examples test `TauCeti.Almost.BasicSetup.ofValuationRing`:

* for an arbitrary valuation domain with non-finitely-generated maximal ideal `m`, the setup is
  neither the classical nor the zero setup, `V ⧸ m` is almost zero while `V ⧸ (ε)` is not for
  every `ε ∈ m`, and conditions (A) and (B) hold;
* for `V = 𝓞_ℂ_[p]`, the residue field is almost zero, `V ⧸ (p)` is not, and multiplication
  `m ⊗[V] m → m` is bijective;
* the hypothesis that `m` is not finitely generated fails for a field, whose maximal ideal is
  zero, and for `ℤ_[p]`, whose maximal ideal `(p)` is principal.

## References

* O. Gabber, L. Ramero, *Almost ring theory*, Lecture Notes in Mathematics 1800, §2.1.
* P. Scholze, *Perfectoid spaces*, Publ. Math. IHÉS 116 (2012), §4.
-/

open IsLocalRing TauCeti.Almost TauCeti.Almost.BasicSetup

/-! ### An arbitrary valuation domain with non-finitely-generated maximal ideal -/

section General

variable {V : Type*} [CommRing V] [IsDomain V] [ValuationRing V] (h : ¬ (maximalIdeal V).FG)

-- The setup is neither classical (`m ≠ V`) nor zero (`m ≠ 0`, since `0` is finitely generated).
example : ofValuationRing h ≠ classical V ∧ ofValuationRing h ≠ zero V := by
  refine ⟨fun he ↦ (maximalIdeal.isMaximal V).ne_top ?_, fun he ↦ h ?_⟩
  · simpa using congrArg BasicSetup.ideal he
  · rw [← ofValuationRing_ideal h, he, zero_ideal]
    exact Submodule.fg_bot

-- The residue field `V ⧸ m` is almost zero, while `V ⧸ (ε)` is not for any `ε ∈ m`, including
-- `ε = 0`.
example : (ofValuationRing h).IsAlmostZero (ResidueField V) :=
  ofValuationRing_isAlmostZero_residueField h

example {ε : V} (hε : ε ∈ maximalIdeal V) :
    ¬ (ofValuationRing h).IsAlmostZero (V ⧸ Ideal.span {ε}) := by
  rw [ofValuationRing_isAlmostZero_quotient_span_singleton_iff]
  exact (mem_maximalIdeal ε).mp hε

example : ¬ (ofValuationRing h).IsAlmostZero (V ⧸ Ideal.span {(0 : V)}) := by
  rw [ofValuationRing_isAlmostZero_quotient_span_singleton_iff]
  exact not_isUnit_zero

-- Conditions (A) and (B).
example : (ofValuationRing h).PowersGenerate :=
  (isFilteredPrincipal_of_preValuationRing _).powersGenerate

end General

/-! ### The integers of `ℂ_p` -/

section PadicComplex

variable (p : ℕ) [Fact p.Prime]

-- The ideal of the setup of `𝓞_ℂ_[p]` is its maximal ideal.
example : (ofValuationRing (TauCeti.PadicComplexInt.not_fg_maximalIdeal p)).ideal =
    maximalIdeal 𝓞_ℂ_[p] :=
  ofValuationRing_ideal _

-- The residue field of `𝓞_ℂ_[p]` is almost zero.
example : (ofValuationRing (TauCeti.PadicComplexInt.not_fg_maximalIdeal p)).IsAlmostZero
    (ResidueField 𝓞_ℂ_[p]) :=
  ofValuationRing_isAlmostZero_residueField _

-- `𝓞_ℂ_[p] ⧸ (p)` is not almost zero, because `p` is not a unit.
example : ¬ (ofValuationRing (TauCeti.PadicComplexInt.not_fg_maximalIdeal p)).IsAlmostZero
    (𝓞_ℂ_[p] ⧸ Ideal.span {(p : 𝓞_ℂ_[p])}) := by
  rw [ofValuationRing_isAlmostZero_quotient_span_singleton_iff]
  have hp : (1 : NNReal) < p := by exact_mod_cast (Fact.out : p.Prime).one_lt
  have hpv : Valued.v ((p : 𝓞_ℂ_[p]) : ℂ_[p]) < 1 := by
    rw [SubringClass.coe_natCast, PadicComplex.valuation_p]
    exact (div_lt_one (zero_lt_one.trans hp)).mpr hp
  exact (mem_maximalIdeal _).mp
    ((Valuation.mem_maximalIdeal_iff (v := (PadicComplex.valued p).v)).mpr hpv)

-- Multiplication `m ⊗ m → m` is bijective for `𝓞_ℂ_[p]`.
example : Function.Bijective
    (ofValuationRing (TauCeti.PadicComplexInt.not_fg_maximalIdeal p)).tildeToIdeal :=
  ofValuationRing_tildeToIdeal_bijective _

end PadicComplex

/-! ### Valuation rings to which the construction does not apply -/

-- A field has zero, hence finitely generated, maximal ideal.
example (K : Type*) [Field K] : (maximalIdeal K).FG := by
  rw [maximalIdeal_eq_bot]
  exact Submodule.fg_bot

-- The maximal ideal of `ℤ_[p]` is principal, generated by `p`.
example (p : ℕ) [Fact p.Prime] : (maximalIdeal ℤ_[p]).FG := by
  rw [PadicInt.maximalIdeal_eq_span_p]
  exact Submodule.fg_span_singleton _
