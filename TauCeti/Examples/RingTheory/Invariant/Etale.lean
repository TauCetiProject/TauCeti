module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.Ring.Action.Subobjects
public import TauCeti.RingTheory.Invariant.Etale
import TauCeti.Algebra.Group.Subgroup.ZPowers
import TauCeti.RingTheory.Invariant.Basic

/-!
# Tests: the quotient of the plane by `±1` is étale away from the origin

Let `k` be a commutative ring in which `2` is invertible, and let the involution
`σ : f(x, y) ↦ f(-x, -y)` act on `k[x, y]`. Its invariant ring is `k[x², xy, y²]`. The
displacements of `x` and `y` are `-2x` and `-2y`, so the inertia group of a prime `q` of `k[x, y]`
is trivial unless `q` contains both `x` and `y`. Hence `k[x, y]` is étale over its invariants at
every prime not containing `(x, y)`: the cone `Spec k[x², xy, y²]` has a double cover by the plane
that is étale away from the vertex. On the other hand `x` is not invariant, so the action is
nontrivial. Over a field, this is the standard double cover of the punctured spectrum of the
normal, non-regular two-dimensional local ring `k[x², xy, y²]_(x², xy, y²)` that does not extend
to a finite étale cover of the whole spectrum.
-/

public section

open MvPolynomial

namespace TauCeti.Examples.InvariantEtale

variable {k : Type*} [CommRing k]

/-- The involution `f(x, y) ↦ f(-x, -y)` of `k[x, y]`. -/
noncomputable abbrev negVars : MvPolynomial (Fin 2) k ≃ₐ[k] MvPolynomial (Fin 2) k :=
  AlgEquiv.ofAlgHom (aeval fun i ↦ -X i) (aeval fun i ↦ -X i) (by ext; simp) (by ext; simp)

/-- `σ` negates each variable. -/
theorem negVars_X (i : Fin 2) : negVars (k := k) (X i) = -X i := by
  simp [negVars]

/-- `σ` is an involution. -/
theorem negVars_mul_self : negVars (k := k) * negVars = 1 :=
  AlgEquiv.coe_toAlgHom_injective <| MvPolynomial.algHom_ext fun i ↦ by simp

/-- The group `{1, σ}` generated by `σ`. -/
noncomputable abbrev G (k : Type*) [CommRing k] := Subgroup.zpowers (negVars (k := k))

/-- The group generated by `σ` is `{1, σ}`. -/
theorem mem_G {g : MvPolynomial (Fin 2) k ≃ₐ[k] MvPolynomial (Fin 2) k} (hg : g ∈ G k) :
    g = 1 ∨ g = negVars :=
  (Subgroup.mem_zpowers_iff_of_sq_eq_one (by rw [sq, negVars_mul_self])).mp hg

instance : Finite (G k) :=
  Set.Finite.to_subtype <| (Set.toFinite {1, negVars}).subset fun _ hg ↦ mem_G hg

/-- The variable `x` is not invariant, so `{1, σ}` acts nontrivially. -/
example [Invertible (2 : k)] [Nontrivial k] :
    X 0 ∉ FixedPoints.subring (MvPolynomial (Fin 2) k) (G k) := by
  intro h
  have h1 := congrArg (eval fun _ ↦ (1 : k)) (h ⟨negVars, Subgroup.mem_zpowers _⟩)
  rw [Subgroup.mk_smul, AlgEquiv.smul_def, negVars_X, map_neg, eval_X] at h1
  have : (2 : k) = 0 := by linear_combination -h1
  exact two_ne_zero this

/-- **`k[x, y]` is étale over `k[x², xy, y²]` away from the origin.** At a prime `q` of `k[x, y]`
not containing both `x` and `y`, the inertia group of `{1, σ}` is trivial, so `k[x, y]` is étale
over its invariants at `q`. -/
example [Invertible (2 : k)] (q : Ideal (MvPolynomial (Fin 2) k)) [q.IsPrime]
    (hq : X 0 ∉ q ∨ X 1 ∉ q) :
    Algebra.IsEtaleAt (FixedPoints.subring (MvPolynomial (Fin 2) k) (G k)) q := by
  refine q.isEtaleAt_of_inertia_eq_bot (G := G k)
    ((Subgroup.eq_bot_iff_forall _).mpr fun g hg ↦ ?_)
  rcases mem_G g.2 with h | h
  · exact Subtype.ext h
  -- The displacement of `X i` under `σ` is `-2 X i`, and `2` is a unit.
  have hX (i : Fin 2) : X i ∈ q := by
    have := (Ideal.mem_inertia (G := G k)).mp hg (X i)
    rw [Subgroup.smul_def, h, AlgEquiv.smul_def, negVars_X,
      show -X i - X i = -C 2 * (X i : MvPolynomial (Fin 2) k) by simp [map_ofNat]; ring] at this
    have hu : IsUnit (-C 2 : MvPolynomial (Fin 2) k) :=
      ((isUnit_of_invertible (2 : k)).map C).neg
    exact (Ideal.unit_mul_mem_iff_mem q hu).mp this
  rcases hq with hq | hq <;> exact (hq (hX _)).elim

end TauCeti.Examples.InvariantEtale
