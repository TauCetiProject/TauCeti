module

public import Mathlib.Algebra.Algebra.Prod
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import TauCeti.RingTheory.CongruenceModule

/-!
# Checks for congruence modules of augmented algebras

* For the identity augmentation of `O`, the congruence ideal is `⊤` and the congruence module
  `Ψ(O)` vanishes.
* For an ideal `I` of `O`, let `A = O ×_{O ⧸ I} O` be the algebra of pairs `(a, b)` with
  `a ≡ b mod I`, augmented by the first coordinate. Its congruence ideal is `I + Ann(I)`. When `I`
  is generated by a nonzerodivisor `π`, this is `(π)` and `Ψ(A) ≃ O ⧸ (π)`: the two branches of
  the node are congruent modulo `π`.
-/

public section

open Submodule

open scoped nonZeroDivisors

namespace TauCeti.CongruenceModuleChecks

variable {O : Type*} [CommRing O]

/-- For the identity augmentation, `η = ⊤`. -/
theorem congruenceIdeal_id : (AlgHom.id O O).congruenceIdeal = ⊤ := by
  refine eq_top_iff.2 fun x _ => (AlgHom.mem_congruenceIdeal _).2 ⟨x, fun b hb => ?_, rfl⟩
  simp [show b = 0 from hb]

/-- For the identity augmentation, `Ψ(O) = 0`. -/
example : Subsingleton ((AlgHom.id O O).congruenceModule O) :=
  have := Submodule.Quotient.subsingleton_iff.2 (congruenceIdeal_id (O := O))
  (AlgHom.id O O).congruenceModuleSelfEquiv.toEquiv.subsingleton

/-- The nodal algebra `O ×_{O ⧸ I} O` of pairs congruent modulo `I`. -/
def nodal (I : Ideal O) : Subalgebra O (O × O) :=
  AlgHom.equalizer ((Ideal.Quotient.mkₐ O I).comp (AlgHom.fst O O O))
    ((Ideal.Quotient.mkₐ O I).comp (AlgHom.snd O O O))

/-- Membership in the nodal algebra is congruence of the coordinates modulo `I`. -/
theorem mem_nodal {I : Ideal O} {x : O × O} : x ∈ nodal I ↔ x.1 - x.2 ∈ I := by
  simp [nodal, AlgHom.mem_equalizer, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq]

/-- The augmentation of the nodal algebra given by the first coordinate. -/
def nodalAug (I : Ideal O) : nodal I →ₐ[O] O :=
  (AlgHom.fst O O O).comp (nodal I).val

/-- The congruence ideal of the nodal algebra is `I + Ann(I)`. -/
theorem congruenceIdeal_nodalAug (I : Ideal O) :
    (nodalAug I).congruenceIdeal = I ⊔ I.annihilator := by
  ext x
  rw [AlgHom.mem_congruenceIdeal, Submodule.mem_sup]
  constructor
  · rintro ⟨⟨⟨a, b⟩, hab⟩, h, rfl⟩
    refine ⟨a - b, (mem_nodal).1 hab, b, Submodule.mem_annihilator.2 fun c hc => ?_,
      sub_add_cancel a b⟩
    have hc' : ((0, c) : O × O) ∈ nodal I := (mem_nodal).2 (by simpa using I.neg_mem hc)
    have := congrArg (fun y : nodal I => (y : O × O).2) (h ⟨(0, c), hc'⟩ rfl)
    simpa [mul_comm] using this
  · rintro ⟨i, hi, y, hy, rfl⟩
    refine ⟨⟨(i + y, y), (mem_nodal).2 (by simpa using hi)⟩, fun ⟨⟨c, d⟩, hcd⟩ hb => ?_, rfl⟩
    have hc : c = 0 := hb
    have hd : d ∈ I := by simpa [hc] using I.neg_mem ((mem_nodal).1 hcd)
    ext
    · simp [hc]
    · simpa [mul_comm] using Submodule.mem_annihilator.1 hy d hd

/-- For a nonzerodivisor `π`, the nodal algebra over `(π)` has congruence ideal `(π)`. -/
theorem congruenceIdeal_nodalAug_span {π : O} (hπ : π ∈ O⁰) :
    (nodalAug (Ideal.span {π})).congruenceIdeal = Ideal.span {π} := by
  rw [congruenceIdeal_nodalAug, sup_eq_left]
  intro y hy
  have := Submodule.mem_annihilator.1 hy π (Ideal.mem_span_singleton_self π)
  rw [smul_eq_mul] at this
  rw [mem_nonZeroDivisors_iff_right.1 hπ y this]
  exact zero_mem _

/-- For a nonzerodivisor `π`, the congruence module of the nodal algebra over `(π)` is
`O ⧸ (π)`. -/
example {π : O} (hπ : π ∈ O⁰) :
    Nonempty ((nodalAug (Ideal.span {π})).congruenceModule (nodal (Ideal.span {π})) ≃ₗ[O]
      O ⧸ Ideal.span {π}) :=
  ⟨(nodalAug (Ideal.span {π})).congruenceModuleSelfEquiv.trans
    (Submodule.quotEquivOfEq _ _ (congruenceIdeal_nodalAug_span hπ))⟩

end TauCeti.CongruenceModuleChecks
