module

public import TauCeti.RingTheory.Henselian.Approximation.Jacobian
public import Mathlib.Algebra.Field.ZMod
import Mathlib.Tactic.NormNum

/-!
# Computations with Elkik's presentation Jacobian ideal

These importing examples distinguish empty and zero presentations from a unit equation,
compute the derivative ideal of a hypersurface, and exhibit strict growth under reduction
of coefficients. The non-zero-divisor `X^2 - 1` over `ZMod 2` has vanishing derivative
and zero Elkik ideal.
-/

public section

open MvPolynomial

namespace TauCeti.Examples.ElkikJacobian

/-- `elkik_test_no_equations`: A presentation without relations has unit Elkik ideal. -/
example :
    elkikJacobianIdeal (fun e : Empty => (nomatch e : MvPolynomial Unit ℤ)) = ⊤ := by
  simp

/-- `elkik_test_zero_equation`: The zero equation has unit ideal because its annihilator is the
entire ring. -/
example :
    elkikJacobianIdeal (fun _ : Unit => (0 : MvPolynomial Unit ℤ)) = ⊤ := by
  rw [elkikJacobianIdeal_unique]
  simp [Submodule.annihilator_bot]

/-- `elkik_test_unit_ideal`: The inconsistent unit equation has zero Elkik ideal. -/
example :
    elkikJacobianIdeal (fun _ : Unit => (1 : MvPolynomial Unit ℤ)) = ⊥ := by
  rw [elkikJacobianIdeal_unique_of_mem_nonZeroDivisors _ (by simp)]
  simp

/-- `elkik_test_etale_equation`: The quadratic equation has its usual derivative ideal over the
integers. -/
example :
    elkikJacobianIdeal (fun _ : Unit => (X () ^ 2 - C 7 : MvPolynomial Unit ℤ)) =
      Ideal.span {2 * X ()} := by
  have hf : (X () ^ 2 - C 7 : MvPolynomial Unit ℤ) ≠ 0 := by
    intro h
    have he := congrArg (eval fun _ : Unit => (0 : ℤ)) h
    norm_num [map_ofNat] at he
  rw [elkikJacobianIdeal_unique_of_mem_nonZeroDivisors _
    (mem_nonZeroDivisors_iff_ne_zero.mpr hf)]
  simp only [map_sub, pderiv_C]
  simp

/-- `elkik_test_derivative_valuation`: The derivative ideal of `X^n - 1`, evaluated at `1`, is
generated by `n`. -/
example (n : ℕ) (hn : n ≠ 0) :
    Ideal.map (eval fun _ : Unit => (1 : ℤ))
      (elkikJacobianIdeal (fun _ : Unit => (X () ^ n - 1 : MvPolynomial Unit ℤ))) =
        Ideal.span {(n : ℤ)} := by
  have hf : (X () ^ n - 1 : MvPolynomial Unit ℤ) ≠ 0 := by
    intro h
    have he := congrArg (eval fun _ : Unit => (0 : ℤ)) h
    simp [hn] at he
  rw [elkikJacobianIdeal_unique_of_mem_nonZeroDivisors _
    (mem_nonZeroDivisors_iff_ne_zero.mpr hf), Ideal.map_span]
  simp

/-- `elkik_test_characteristic_two`: In characteristic two, the double-root equation has zero
Elkik ideal. -/
example :
    elkikJacobianIdeal
      (fun _ : Unit => (X () ^ 2 - 1 : MvPolynomial Unit (ZMod 2))) = ⊥ := by
  have hf : (X () ^ 2 - 1 : MvPolynomial Unit (ZMod 2)) ≠ 0 := by
    intro h
    have he := congrArg (eval fun _ : Unit => (0 : ZMod 2)) h
    norm_num at he
  rw [elkikJacobianIdeal_unique_of_mem_nonZeroDivisors _
    (mem_nonZeroDivisors_iff_ne_zero.mpr hf)]
  have htwo : (2 : MvPolynomial Unit (ZMod 2)) = 0 := by
    simpa only [map_ofNat, map_zero] using
      congrArg (C : ZMod 2 →+* MvPolynomial Unit (ZMod 2)) (by decide : (2 : ZMod 2) = 0)
  simp [htwo]

/-- `elkik_test_baseChange_strict`: Reduction modulo two can enlarge Elkik's ideal strictly: the
equation `2 = 0` changes from a regular constant equation to the zero equation. -/
example :
    Ideal.map (MvPolynomial.map (Int.castRingHom (ZMod 2)))
      (elkikJacobianIdeal (fun _ : Unit => (C 2 : MvPolynomial Unit ℤ))) <
        elkikJacobianIdeal (fun _ : Unit =>
          MvPolynomial.map (Int.castRingHom (ZMod 2)) (C 2 : MvPolynomial Unit ℤ)) := by
  have hf : (C 2 : MvPolynomial Unit ℤ) ∈ nonZeroDivisors (MvPolynomial Unit ℤ) := by
    apply mem_nonZeroDivisors_iff_ne_zero.mpr
    exact (C_ne_zero.mpr (by decide : (2 : ℤ) ≠ 0))
  rw [elkikJacobianIdeal_unique_of_mem_nonZeroDivisors _ hf]
  simp only [pderiv_C, Set.range_const, Ideal.span_singleton_zero, Ideal.map_bot,
    map_C]
  have htwo : Int.castRingHom (ZMod 2) (2 : ℤ) = 0 := by decide
  rw [htwo, map_zero, elkikJacobianIdeal_unique]
  simp [Submodule.annihilator_bot]

/-- Two independent coordinate equations give a full-size identity Jacobian minor. -/
example : elkikJacobianIdeal (fun i : Fin 2 => (X i : MvPolynomial (Fin 2) ℤ)) = ⊤ := by
  let f : Fin 2 → MvPolynomial (Fin 2) ℤ := X
  let s : Finset (Fin 2) := Finset.univ
  have hm : Matrix.of (fun i j : s => pderiv (j : Fin 2) (f i)) = 1 := by
    ext i j
    simp only [f, pderiv_X, Matrix.of_apply, Matrix.one_apply,
      Pi.single_apply, Subtype.ext_iff]
  have hminor : (1 : MvPolynomial (Fin 2) ℤ) ∈ jacobianMinorsIdeal f s := by
    simpa only [hm, Matrix.det_one] using
      det_mem_jacobianMinorsIdeal f s (fun j => j.val)
  have hs : f '' (s : Set (Fin 2)) = Set.range f := by simp [s]
  have hcolon : (1 : MvPolynomial (Fin 2) ℤ) ∈
      (Ideal.span (f '' (s : Set (Fin 2)))).colon (Ideal.span (Set.range f)) := by
    rw [hs, Submodule.colon_eq_top_iff_le.mpr le_rfl]
    trivial
  apply (Ideal.eq_top_iff_one _).mpr
  simpa only [mul_one] using mul_mem_elkikJacobianIdeal f s hminor hcolon

/-- Singleton minor ideals simplify with the caller's equality decision. -/
example {R σ ι : Type*} [CommRing R] [DecidableEq σ]
    (f : σ → MvPolynomial ι R) (a : σ) :
    jacobianMinorsIdeal f {a} = Ideal.span (Set.range fun i => pderiv i (f a)) := by
  simp

/-- Coefficient change simplifies with the caller's equality decision. -/
example {R S σ ι : Type*} [CommRing R] [CommRing S] [DecidableEq σ]
    (g : R →+* S) (f : σ → MvPolynomial ι R) (s : Finset σ) :
    Ideal.map (MvPolynomial.map g) (jacobianMinorsIdeal f s) =
      jacobianMinorsIdeal (fun j => MvPolynomial.map g (f j)) s := by
  simp

/-- The one-equation API preserves an arbitrary caller equality decision on the equations. -/
example {R σ ι : Type*} [CommRing R] [DecidableEq σ] [Unique σ]
    (f : σ → MvPolynomial ι R) :
    elkikJacobianIdeal f = (Ideal.span {f default}).annihilator ⊔
      Ideal.span (Set.range fun i => pderiv i (f default)) :=
  elkikJacobianIdeal_unique f

end TauCeti.Examples.ElkikJacobian
