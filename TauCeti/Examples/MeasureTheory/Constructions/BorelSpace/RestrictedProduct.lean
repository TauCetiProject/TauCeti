module

public import TauCeti.MeasureTheory.Constructions.BorelSpace.RestrictedProduct
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Topology.Instances.ZMod

/-!
# Singletons, open boxes, and stage-coset σ-algebras in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`

In the countable restricted product `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]` of discrete groups `ZMod 4`
relative to the index-2 open subgroup `2ℤ/4 = {0, 2}`, the singleton `{0}` separates three natural
families of subsets on a restricted product:

* `{0}` is neither open (`TauCeti.not_isOpen_singleton_zero_zmod4`) nor equal to any coordinate box
  cofinitely equal to `2ℤ/4` (`TauCeti.not_exists_eventually_eq_box_singleton_zero_zmod4`);
* `{0}` is the countable intersection of the open cofinitely-`2ℤ/4` boxes imposing `x k = 0` for
  `k < n` (`TauCeti.singleton_zero_eq_iInter_openBox_zmod4`), and is therefore Borel measurable
  (`TauCeti.measurableSet_singleton_zero_zmod4`);
* `{0}` does not belong to the σ-algebra generated by all cofinite principal stages and their
  additive cosets (`TauCeti.not_measurableSet_singleton_zero_generateFrom_cosets_zmod4`), because
  the constant sequence `(2, 2, …)` lies in every principal stage, showing why coordinate boxes
  rather than principal-stage cosets are required to generate the Borel σ-algebra.

## References

* D. Ramakrishnan and R. J. Valenza, *Fourier Analysis on Number Fields*, Chapter 5.
* J. Tate, *Fourier analysis in number fields and Hecke's zeta-functions*, §3.3.
* A. Weil, *Basic Number Theory*.
-/

public section

open Filter MeasureTheory Set Topology
open scoped RestrictedProduct

namespace TauCeti

local notation "twoZMod4" => AddSubgroup.zmultiples (2 : ZMod 4)

/-- In `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`, the singleton `{0}` is the countable intersection of the open
cofinitely-`2ℤ/4` boxes imposing `x k = 0` for `k < n` and `x k ∈ 2ℤ/4` for `k ≥ n`. -/
theorem singleton_zero_eq_iInter_openBox_zmod4 :
    ({(0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])} :
        Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) =
      ⋂ n : ℕ, RestrictedProduct.box
        (fun k ↦ if k < n then ({0} : Set (ZMod 4)) else (twoZMod4 : Set (ZMod 4))) := by
  ext x
  simp only [mem_singleton_iff, mem_iInter, RestrictedProduct.mem_box]
  refine ⟨fun hx n k ↦ ?_, fun hx ↦ ?_⟩
  · subst hx
    split_ifs
    · exact mem_singleton 0
    · exact zero_mem twoZMod4
  · ext k
    simpa using hx (k + 1) k

private theorem approx_mem_openBoxes_zmod4 (n : ℕ) :
    (RestrictedProduct.box
        (fun k ↦ if k < n then ({0} : Set (ZMod 4)) else (twoZMod4 : Set (ZMod 4))) :
      Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) ∈
        RestrictedProduct.openBoxes (fun _ : ℕ ↦ ZMod 4)
          (fun _ : ℕ ↦ (twoZMod4 : Set (ZMod 4))) := by
  refine RestrictedProduct.box_mem_openBoxes (fun _ ↦ isOpen_discrete _) ?_
  refine mem_cofinite.mpr ((Finset.range n).finite_toSet.subset fun k hk ↦ ?_)
  rw [Finset.mem_coe, Finset.mem_range]
  by_contra hnot
  exact hk (by simp [hnot])

/-- The singleton `{0}` in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]` is Borel measurable. -/
theorem measurableSet_singleton_zero_zmod4 :
    MeasurableSet ({(0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])} :
      Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) := by
  rw [singleton_zero_eq_iInter_openBox_zmod4]
  exact MeasurableSet.iInter fun n ↦
    (RestrictedProduct.isOpen_of_mem_openBoxes (approx_mem_openBoxes_zmod4 n)).measurableSet

/-- The singleton `{0}` in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]` is not equal to any coordinate box `box C`
whose factors satisfy `C k = 2ℤ/4` for cofinitely many `k`. -/
theorem not_exists_eventually_eq_box_singleton_zero_zmod4 :
    ¬ ∃ C : ℕ → Set (ZMod 4),
      (∀ᶠ k in cofinite, C k = (twoZMod4 : Set (ZMod 4))) ∧
        ({(0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])} :
          Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) = RestrictedProduct.box C := by
  rintro ⟨C, hC, heq⟩
  obtain ⟨k, hk⟩ := (hC.frequently).exists
  have h0C : ∀ j, (0 : ZMod 4) ∈ C j := fun j ↦ by
    have hj := RestrictedProduct.mem_box.mp (heq ▸ mem_singleton _) j
    rwa [RestrictedProduct.zero_apply] at hj
  let z : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))] :=
    RestrictedProduct.single (fun _ ↦ twoZMod4) k (2 : ZMod 4)
  have hzC : z ∈ RestrictedProduct.box C := RestrictedProduct.mem_box.mpr fun j ↦ by
    rcases eq_or_ne j k with rfl | hjk
    · rw [hk, RestrictedProduct.single_eq_same]
      exact AddSubgroup.mem_zmultiples (2 : ZMod 4)
    · rw [RestrictedProduct.single_eq_of_ne _ _ hjk]
      exact h0C j
  have hz0 : z = 0 := mem_singleton_iff.mp (heq.symm ▸ hzC)
  have h20 : (2 : ZMod 4) = 0 := by
    simpa [z, RestrictedProduct.single_eq_same] using congr_arg (· k) hz0
  exact absurd h20 (by decide)

/-- The singleton `{0}` is not open in `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`. -/
theorem not_isOpen_singleton_zero_zmod4 :
    ¬ IsOpen ({(0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])} :
      Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) := by
  intro hopen
  obtain ⟨C, h0C, -, hCA, hsub⟩ :=
    RestrictedProduct.exists_open_box_subset_of_isOpen
      (.of_forall fun _ ↦ isOpen_discrete _) (mem_singleton _) hopen
  refine not_exists_eventually_eq_box_singleton_zero_zmod4 ⟨C, hCA, ?_⟩
  exact Subset.antisymm (singleton_subset_iff.mpr (RestrictedProduct.mem_box.mpr h0C)) hsub

/-- In `Πʳ _ : ℕ, [ZMod 4, 2ℤ/4]`, the Borel set `{0}` does not belong to the σ-algebra generated
by all cofinite principal stages `range (inclusion _ _ hS)` (`cofinite ≤ 𝓟 S`) and their additive
cosets: the constant sequence `(2, 2, …)` lies in every principal stage, so `0` and `(2, 2, …)`
are inseparable by that σ-algebra. -/
theorem not_measurableSet_singleton_zero_generateFrom_cosets_zmod4 :
    ¬ @MeasurableSet (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])
      (MeasurableSpace.generateFrom
        {s | ∃ (S : Set ℕ) (hS : cofinite ≤ 𝓟 S)
          (g : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))]),
          s = (g + ·) '' range (RestrictedProduct.inclusion _ _ hS)})
      {0} := by
  let c₂ : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))] :=
    RestrictedProduct.mk (fun _ ↦ (2 : ZMod 4))
      (.of_forall fun _ ↦ AddSubgroup.mem_zmultiples (2 : ZMod 4))
  have hc₂_add : c₂ + c₂ = 0 := by
    ext k
    simp only [RestrictedProduct.add_apply, RestrictedProduct.zero_apply,
      RestrictedProduct.mk_apply, c₂]
    decide
  intro h0
  have hmem : (0 : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))]) ∈
      ({0} : Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) ↔
      c₂ ∈ ({0} : Set (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])) := by
    refine @MeasurableSpace.generateFrom_induction
      (Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))])
      {s | ∃ (S : Set ℕ) (hS : cofinite ≤ 𝓟 S)
        (g : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))]),
        s = (g + ·) '' range (RestrictedProduct.inclusion _ _ hS)}
      (fun t _ ↦ 0 ∈ t ↔ c₂ ∈ t)
      ?_ Iff.rfl (fun _ _ ih ↦ not_congr ih)
      (fun _ _ ih ↦ by simp only [mem_iUnion]; exact exists_congr ih)
      {0} h0
    rintro _ ⟨S, hS, g, rfl⟩ _
    have hshift : ∀ x : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))],
        x ∈ (g + ·) '' range (RestrictedProduct.inclusion _ _ hS) →
        x + c₂ ∈ (g + ·) '' range (RestrictedProduct.inclusion _ _ hS) := by
      rintro _ ⟨_, ⟨z, rfl⟩, rfl⟩
      let z' : Πʳ _ : ℕ, [ZMod 4, (twoZMod4 : Set (ZMod 4))]_[𝓟 S] :=
        RestrictedProduct.mk (fun k ↦ z k + 2)
          (z.2.mono fun _ hk ↦ add_mem hk (AddSubgroup.mem_zmultiples 2))
      refine ⟨_, ⟨z', rfl⟩, ?_⟩
      ext k
      simp [z', c₂, add_assoc]
    exact ⟨fun h ↦ zero_add c₂ ▸ hshift 0 h, fun h ↦ hc₂_add ▸ hshift c₂ h⟩
  have hc₂ : c₂ = 0 := mem_singleton_iff.mp (hmem.mp (mem_singleton 0))
  have h20 : (2 : ZMod 4) = 0 := by
    simpa [c₂] using congr_arg (· 0) hc₂
  exact absurd h20 (by decide)

end TauCeti
