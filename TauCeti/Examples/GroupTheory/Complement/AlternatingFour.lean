module

public import TauCeti.GroupTheory.SpecificGroups.Alternating.KleinFour
public import TauCeti.GroupTheory.Complement.Sylow
public import TauCeti.GroupTheory.Complement.Invariant.Internal
import Mathlib.GroupTheory.Perm.Cycle.Concrete

/-!
# Concrete complements, crossed projections, and invariant complements in `A₄` and `S₄`

This file instantiates the complement, crossed-projection, Sylow-detection, and
invariant-complement theory on the concrete permutation groups `alternatingGroup (Fin 4)` and
`Equiv.Perm (Fin 4)` over the Klein four-group `alternatingGroup.kleinFour (Fin 4)`.

Using the `3`-cycle `threeCycle012 = (0 1 2)` fixing `3` and the three double transpositions
`doubleSwap0123 = (0 1)(2 3)`, `doubleSwap0213 = (0 2)(1 3)`, and `doubleSwap0312 = (0 3)(1 2)`,
we check:

* the point stabilizer `MulAction.stabilizer (alternatingGroup (Fin 4)) (3 : Fin 4)` is generated
  by `(0 1 2)`, complements `V₄` in `A₄`, and restricts to the trivial local complement `⊥` inside
  `V₄`;
* left conjugation `(0 1 2) • (0 1)(2 3) = (0 3)(1 2)` differs from `(0 1 2)⁻¹ * (0 1)(2 3) *
  (0 1 2) = (0 2)(1 3)`, and the crossed projection along `⟨(0 1 2)⟩` sends
  `(0 1 2) * (0 1)(2 3)` to `(0 3)(1 2)` and fails to be multiplicative;
* the four complements `Stab(0), Stab(1), Stab(2), Stab(3)` are obtained from `⟨(0 1 2)⟩` by
  conjugating by `(0 3)(1 2)`, `(0 2)(1 3)`, `(0 1)(2 3)`, and `1`, and their crossed projections
  differ by the corresponding principal crossed maps;
* `V₄` is the unique Sylow `2`-subgroup of `A₄`, so `IsPGroup.exists_isComplement'_iff_sylow`
  detects complements of `V₄` from the trivial local complement `⊥` in `V₄`;
* under conjugation by `⟨(0 1 2)⟩` (`q = 3 ≠ 2 = p`), `Subgroup.exists_invariant_complement` and
  `Subgroup.exists_invariant_local_complement` produce `⟨(0 1 2)⟩` as the unique invariant global
  complement in `A₄` and local complement in `S₄`, whereas the other three point stabilizers are
  not normalized by `(0 1 2)`;
* inside `S₄`, the `2`-subgroup `⟨(0 1)⟩` (`q = 2 = p`, outside the `p ≠ q` hypothesis of
  `Subgroup.exists_invariant_local_complement`) still normalizes `⟨(0 1 2)⟩`, inverting its
  generator.
-/

public section

open Equiv Equiv.Perm
open scoped IsMulCommutative Pointwise

namespace TauCeti.Examples.AlternatingFour

private instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

private instance : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩

private instance : IsMulCommutative (alternatingGroup.kleinFour (Fin 4)) :=
  isMulCommutative_kleinFour (Nat.card_fin 4).le

/-- The `3`-cycle `(0 1 2)` in `alternatingGroup (Fin 4)`, which fixes `3`. -/
def threeCycle012 : alternatingGroup (Fin 4) :=
  ⟨[0, 1, 2].formPerm, mem_alternatingGroup.mpr (by decide)⟩

/-- The double transposition `(0 1)(2 3)` in `alternatingGroup.kleinFour (Fin 4)`. -/
def doubleSwap0123 : alternatingGroup.kleinFour (Fin 4) :=
  ⟨⟨swap 0 1 * swap 2 3, mem_alternatingGroup.mpr (by decide)⟩,
    (mem_kleinFour_iff_sq_eq_one (Nat.card_fin 4).le).mpr (by decide)⟩

/-- The double transposition `(0 2)(1 3)` in `alternatingGroup.kleinFour (Fin 4)`. -/
def doubleSwap0213 : alternatingGroup.kleinFour (Fin 4) :=
  ⟨⟨swap 0 2 * swap 1 3, mem_alternatingGroup.mpr (by decide)⟩,
    (mem_kleinFour_iff_sq_eq_one (Nat.card_fin 4).le).mpr (by decide)⟩

/-- The double transposition `(0 3)(1 2)` in `alternatingGroup.kleinFour (Fin 4)`. -/
def doubleSwap0312 : alternatingGroup.kleinFour (Fin 4) :=
  ⟨⟨swap 0 3 * swap 1 2, mem_alternatingGroup.mpr (by decide)⟩,
    (mem_kleinFour_iff_sq_eq_one (Nat.card_fin 4).le).mpr (by decide)⟩

/-! ### Stabilizer of `3`, complement in `A₄`, and restriction to `V₄` -/

/-- The stabilizer of `3` in `alternatingGroup (Fin 4)` is the cyclic subgroup generated by
`(0 1 2)`. -/
theorem stabilizer_three_eq_zpowers :
    MulAction.stabilizer (alternatingGroup (Fin 4)) (3 : Fin 4) =
      Subgroup.zpowers threeCycle012 := by
  symm
  refine Subgroup.eq_of_le_of_card_ge ?_ ?_
  · rw [Subgroup.zpowers_le, MulAction.mem_stabilizer_iff]
    decide
  · have hord : orderOf threeCycle012 = 3 := by
      rw [← orderOf_injective (alternatingGroup (Fin 4)).subtype
        (alternatingGroup (Fin 4)).subtype_injective threeCycle012]
      exact orderOf_eq_prime (by decide : ([0, 1, 2].formPerm : Perm (Fin 4)) ^ 3 = 1) (by decide)
    rw [Nat.card_zpowers, hord,
      card_stabilizer_alternatingGroup_of_card_eq_four (Nat.card_fin 4) (3 : Fin 4)]

/-- `⟨(0 1 2)⟩` is a global complement of `V₄` in `A₄`. -/
theorem isComplement'_kleinFour_zpowers_threeCycle012 :
    (alternatingGroup.kleinFour (Fin 4)).IsComplement' (Subgroup.zpowers threeCycle012) := by
  rw [← stabilizer_three_eq_zpowers]
  exact isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)

-- Restricting the global complement `⟨(0 1 2)⟩` to `H = V₄` gives the local complement `⊥`.
example :
    (Subgroup.zpowers threeCycle012 ⊓ alternatingGroup.kleinFour (Fin 4)) = ⊥ ∧
      (alternatingGroup.kleinFour (Fin 4)).IsLocalComplement ⊥
        (alternatingGroup.kleinFour (Fin 4)) := by
  have hinf : Subgroup.zpowers threeCycle012 ⊓ alternatingGroup.kleinFour (Fin 4) = ⊥ :=
    isComplement'_kleinFour_zpowers_threeCycle012.symm.disjoint.eq_bot
  exact ⟨hinf, hinf ▸ isComplement'_kleinFour_zpowers_threeCycle012.isLocalComplement_inf le_rfl⟩

/-! ### Conjugation convention, crossed projection, zero locus, and `V₄`-conjugacy -/

section CrossedProjection

attribute [local instance] Subgroup.conjugationAction

-- Left conjugation `g • n = g * n * g⁻¹` sends `(0 1)(2 3)` under `(0 1 2)` to `(0 3)(1 2)`,
-- whereas `g⁻¹ * n * g` gives the distinct element `(0 2)(1 3)`.
example :
    threeCycle012 • doubleSwap0123 = doubleSwap0312 ∧
      (threeCycle012 : alternatingGroup (Fin 4))⁻¹ * doubleSwap0123 * threeCycle012 =
        doubleSwap0213 ∧
      doubleSwap0312 ≠ doubleSwap0213 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [← Subtype.coe_inj, Subgroup.coe_conjugationAction_smul, ← Subtype.coe_inj]
    decide
  · exact Subtype.ext (by decide :
      (threeCycle012 : Perm (Fin 4))⁻¹ * (doubleSwap0123 : Perm (Fin 4)) *
        (threeCycle012 : Perm (Fin 4)) = doubleSwap0213)
  · intro hEq
    exact (by decide : (doubleSwap0312 : Perm (Fin 4)) ≠ doubleSwap0213)
      (congrArg (fun v : alternatingGroup.kleinFour (Fin 4) => (v : Perm (Fin 4))) hEq)

-- Along `Stab(3) = ⟨(0 1 2)⟩`, the crossed projection sends `(0 1 2) * (0 1)(2 3)` to `(0 3)(1 2)`.
example :
    (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)).crossedProjection
      (threeCycle012 * doubleSwap0123) = doubleSwap0312 := by
  rw [crossedProjection_isComplement'_kleinFour_stabilizer_eq_iff (Nat.card_fin 4)]
  decide

-- The crossed projection along `Stab(3)` is not a group homomorphism.
example :
    (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)).crossedProjection
      (threeCycle012 * doubleSwap0123) ≠
      (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)).crossedProjection
        threeCycle012 *
      (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)).crossedProjection
        doubleSwap0123 := by
  intro hEq
  have lhs : (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)).crossedProjection
      (threeCycle012 * doubleSwap0123) = doubleSwap0312 := by
    rw [crossedProjection_isComplement'_kleinFour_stabilizer_eq_iff (Nat.card_fin 4)]
    decide
  have rhs1 : (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)).crossedProjection
      threeCycle012 = 1 :=
    (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)).crossedProjection_eq_one_iff
      threeCycle012 |>.mpr (by rw [MulAction.mem_stabilizer_iff]; decide)
  rw [lhs, rhs1, one_mul, Subgroup.IsComplement'.crossedProjection_coe] at hEq
  exact (by decide : (doubleSwap0312 : Perm (Fin 4)) ≠ doubleSwap0123)
    (congrArg (fun v : alternatingGroup.kleinFour (Fin 4) => (v : Perm (Fin 4))) hEq)

-- The zero locus of the normalized additive crossed map for `3` recovers `⟨(0 1 2)⟩`.
example :
    groupCohomology.zeroLocus (kleinFourCrossedProjectionEquiv (Nat.card_fin 4) (3 : Fin 4)).2.1 =
      Subgroup.zpowers threeCycle012 := by
  rw [zeroLocus_kleinFourCrossedProjectionEquiv_apply (Nat.card_fin 4) (3 : Fin 4),
    stabilizer_three_eq_zpowers]

-- Conjugating `⟨(0 1 2)⟩ = Stab(3)` by `(0 3)(1 2)`, `(0 2)(1 3)`, `(0 1)(2 3)` produces
-- `Stab(0)`, `Stab(1)`, `Stab(2)`.
example :
    MulAut.conj (doubleSwap0312 : alternatingGroup (Fin 4)) • Subgroup.zpowers threeCycle012 =
        MulAction.stabilizer (alternatingGroup (Fin 4)) (0 : Fin 4) ∧
      MulAut.conj (doubleSwap0213 : alternatingGroup (Fin 4)) • Subgroup.zpowers threeCycle012 =
        MulAction.stabilizer (alternatingGroup (Fin 4)) (1 : Fin 4) ∧
      MulAut.conj (doubleSwap0123 : alternatingGroup (Fin 4)) • Subgroup.zpowers threeCycle012 =
        MulAction.stabilizer (alternatingGroup (Fin 4)) (2 : Fin 4) := by
  have hconj (v : alternatingGroup.kleinFour (Fin 4)) :
      MulAut.conj (v : alternatingGroup (Fin 4)) • Subgroup.zpowers threeCycle012 =
        MulAction.stabilizer (alternatingGroup (Fin 4)) (v • (3 : Fin 4)) := by
    rw [← stabilizer_three_eq_zpowers, Subgroup.smul_def,
      MulAction.stabilizer_smul_eq_stabilizer_map_conj, MulEquiv.toMonoidHom_eq_coe,
      map_conj_eq_conj_smul]
  refine ⟨?_, ?_, ?_⟩
  · simpa only [(by decide : doubleSwap0312 • (3 : Fin 4) = 0)] using hconj doubleSwap0312
  · simpa only [(by decide : doubleSwap0213 • (3 : Fin 4) = 1)] using hconj doubleSwap0213
  · simpa only [(by decide : doubleSwap0123 • (3 : Fin 4) = 2)] using hconj doubleSwap0123

-- The crossed projection along `Stab(0)` differs from that along `Stab(3)` by the principal
-- crossed map attached to `doubleSwap0312`.
example (g : alternatingGroup (Fin 4)) :
    (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (0 : Fin 4)).crossedProjection g =
      (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) (3 : Fin 4)).crossedProjection g *
        (g • doubleSwap0312 / doubleSwap0312) := by
  have hv : doubleSwap0312 • (3 : Fin 4) = 0 := by decide
  simpa only [hv] using
    crossedProjection_isComplement'_kleinFour_stabilizer_smul (Nat.card_fin 4) (3 : Fin 4)
      doubleSwap0312 g

end CrossedProjection

/-! ### Sylow detection and invariant complements in `A₄` and `S₄` -/

-- Sylow detection (`IsPGroup.exists_isComplement'_iff_sylow`) produces a global complement of
-- `V₄` in `A₄` from the trivial local complement `⊥` inside the unique `P : Sylow 2 A₄`.
example (P : Sylow 2 (alternatingGroup (Fin 4))) :
    (∃ D : Subgroup (alternatingGroup (Fin 4)),
      (alternatingGroup.kleinFour (Fin 4)).IsComplement' D) ∧
    (alternatingGroup.kleinFour (Fin 4)).IsLocalComplement ⊥ P := by
  have hP : (P : Subgroup (alternatingGroup (Fin 4))) = alternatingGroup.kleinFour (Fin 4) :=
    alternatingGroup.two_sylow_eq_kleinFour_of_card_eq_four (Nat.card_fin 4) P
  have hloc : (alternatingGroup.kleinFour (Fin 4)).IsLocalComplement ⊥ P := by
    simp [hP]
  exact ⟨((isPGroup_two_kleinFour (Nat.card_fin 4).le).exists_isComplement'_iff_sylow P).mpr
    ⟨⊥, hloc⟩, hloc⟩

-- External invariant complement (`Subgroup.exists_invariant_complement`): under the conjugation
-- action of `A = ⟨(0 1 2)⟩` (`q = 3 ≠ 2 = p`), `V₄` admits an `A`-invariant complement in `A₄`,
-- and `⟨(0 1 2)⟩` itself is the unique such complement, whereas `Stab(0)`, `Stab(1)`, `Stab(2)`
-- are not `A`-invariant.
example :
    (∃ D : Subgroup (alternatingGroup (Fin 4)),
      (alternatingGroup.kleinFour (Fin 4)).IsComplement' D ∧
        Subgroup.zpowers threeCycle012 ≤ Subgroup.normalizer D) ∧
    (∀ D : Subgroup (alternatingGroup (Fin 4)),
      (alternatingGroup.kleinFour (Fin 4)).IsComplement' D ∧
          Subgroup.zpowers threeCycle012 ≤ Subgroup.normalizer D ↔
        D = Subgroup.zpowers threeCycle012) ∧
    ¬ Subgroup.zpowers threeCycle012 ≤
        Subgroup.normalizer (MulAction.stabilizer (alternatingGroup (Fin 4)) (0 : Fin 4)) ∧
    ¬ Subgroup.zpowers threeCycle012 ≤
        Subgroup.normalizer (MulAction.stabilizer (alternatingGroup (Fin 4)) (1 : Fin 4)) ∧
    ¬ Subgroup.zpowers threeCycle012 ≤
        Subgroup.normalizer (MulAction.stabilizer (alternatingGroup (Fin 4)) (2 : Fin 4)) := by
  let A := Subgroup.zpowers threeCycle012
  let P : Sylow 2 (alternatingGroup (Fin 4)) := default
  have hP : (P : Subgroup (alternatingGroup (Fin 4))) = alternatingGroup.kleinFour (Fin 4) :=
    alternatingGroup.two_sylow_eq_kleinFour_of_card_eq_four (Nat.card_fin 4) P
  let _ : MulDistribMulAction A (alternatingGroup (Fin 4)) :=
    MulDistribMulAction.compHom (alternatingGroup (Fin 4)) (MulAut.conj.comp A.subtype)
  have hA3 : Nat.card A = 3 := by
    dsimp only [A]
    rw [← stabilizer_three_eq_zpowers]
    exact card_stabilizer_alternatingGroup_of_card_eq_four (Nat.card_fin 4) (3 : Fin 4)
  have hex : ∃ D : Subgroup (alternatingGroup (Fin 4)),
      (alternatingGroup.kleinFour (Fin 4)).IsComplement' D ∧ A ≤ Subgroup.normalizer D := by
    obtain ⟨D, hD, hinv⟩ := Subgroup.exists_invariant_complement
      (W := alternatingGroup (Fin 4)) (A := A) (p := 2) (q := 3)
      (alternatingGroup.kleinFour (Fin 4))
      (isPGroup_two_kleinFour (Nat.card_fin 4).le)
      (IsPGroup.of_card (p := 3) (n := 1) hA3)
      (by decide)
      (fun a n hn => (inferInstance : (alternatingGroup.kleinFour (Fin 4)).Normal).conj_mem n hn
        a.1)
      P
      ⟨⊥, by simp [hP]⟩
    exact ⟨D, hD, Subgroup.le_normalizer_iff.mpr fun a ha d hd => hinv ⟨a, ha⟩ d hd⟩
  have huniq (D : Subgroup (alternatingGroup (Fin 4))) :
      (alternatingGroup.kleinFour (Fin 4)).IsComplement' D ∧
          Subgroup.zpowers threeCycle012 ≤ Subgroup.normalizer D ↔
        D = Subgroup.zpowers threeCycle012 := by
    rw [← stabilizer_three_eq_zpowers]
    exact isComplement'_kleinFour_and_stabilizer_le_normalizer_iff (Nat.card_fin 4) (3 : Fin 4)
  refine ⟨hex, huniq, ?_, ?_, ?_⟩ <;>
  · intro hnorm
    have hEq := (huniq _).mp ⟨isComplement'_kleinFour_stabilizer (Nat.card_fin 4) _, hnorm⟩
    rw [← stabilizer_three_eq_zpowers] at hEq
    have hidx := (existsUnique_stabilizer_eq_of_isComplement'_kleinFour (Nat.card_fin 4)
      (isComplement'_kleinFour_stabilizer (Nat.card_fin 4) _)).unique rfl hEq
    revert hidx
    decide

-- Internal invariant local complement (`Subgroup.exists_invariant_local_complement`) inside
-- `S₄ = Equiv.Perm (Fin 4)`: with `W = A₄`, `N = V₄`, and `A = ⟨(0 1 2)⟩`, there exists an
-- `A`-normalized local complement of `V₄` in `A₄`, and it is uniquely `⟨(0 1 2)⟩`.
example :
    let N : Subgroup (Perm (Fin 4)) :=
      (alternatingGroup.kleinFour (Fin 4)).map (alternatingGroup (Fin 4)).subtype
    let A : Subgroup (Perm (Fin 4)) := Subgroup.zpowers ([0, 1, 2].formPerm : Perm (Fin 4))
    (∃ D : Subgroup (Perm (Fin 4)),
      N.IsLocalComplement D (alternatingGroup (Fin 4)) ∧ A ≤ Subgroup.normalizer D) ∧
    (∀ D : Subgroup (Perm (Fin 4)),
      N.IsLocalComplement D (alternatingGroup (Fin 4)) ∧ A ≤ Subgroup.normalizer D ↔ D = A) := by
  intro N A
  let P : Sylow 2 (alternatingGroup (Fin 4)) := default
  have hP : P.toSubgroup = alternatingGroup.kleinFour (Fin 4) :=
    alternatingGroup.two_sylow_eq_kleinFour_of_card_eq_four (Nat.card_fin 4) P
  have hNW : N ≤ alternatingGroup (Fin 4) := Subgroup.map_subtype_le _
  have hA_map : (Subgroup.zpowers threeCycle012).map (alternatingGroup (Fin 4)).subtype = A := by
    rw [MonoidHom.map_zpowers]
    rfl
  have hA_eq : A = MulAction.stabilizer (Perm (Fin 4)) (3 : Fin 4) ⊓ alternatingGroup (Fin 4) := by
    rw [← hA_map, ← stabilizer_three_eq_zpowers, ← MulAction.stabilizer_subgroupOf,
      Subgroup.subgroupOf_map_subtype]
  have hA3 : Nat.card A = 3 := by
    rw [← hA_map, Subgroup.card_map_of_injective (alternatingGroup (Fin 4)).subtype_injective,
      ← stabilizer_three_eq_zpowers,
      card_stabilizer_alternatingGroup_of_card_eq_four (Nat.card_fin 4) (3 : Fin 4)]
  have hAW : A ≤ Subgroup.normalizer (alternatingGroup (Fin 4)) := by
    rw [Subgroup.normalizer_eq_top_iff.mpr inferInstance]
    exact le_top
  have hAN : A ≤ Subgroup.normalizer N := by
    rw [Subgroup.normalizer_eq_top_iff.mpr inferInstance]
    exact le_top
  have hN_p : IsPGroup 2 N :=
    (isPGroup_two_kleinFour (Nat.card_fin 4).le).of_equiv
      ((alternatingGroup.kleinFour (Fin 4)).equivMapOfInjective (alternatingGroup (Fin 4)).subtype
        (alternatingGroup (Fin 4)).subtype_injective)
  refine ⟨Subgroup.exists_invariant_local_complement (alternatingGroup (Fin 4)) hNW hAW hAN
    hN_p (IsPGroup.of_card (p := 3) (n := 1) hA3) (by decide) P
    ⟨⊥, by simp [N, hP]⟩, fun D => ?_⟩
  simpa only [N, hA_eq] using
    isLocalComplement_map_subtype_kleinFour_and_le_normalizer_iff (Nat.card_fin 4) (3 : Fin 4)
      (K := D)

-- In `S₄`, the `2`-subgroup `⟨(0 1)⟩` (`q = 2 = p`) still normalizes the local complement
-- `⟨(0 1 2)⟩`, conjugating `(0 1 2)` to its inverse `(0 2 1)`.
example :
    swap (0 : Fin 4) 1 * [0, 1, 2].formPerm * (swap (0 : Fin 4) 1)⁻¹ =
      ([0, 1, 2].formPerm : Perm (Fin 4))⁻¹ ∧
    Subgroup.zpowers (swap (0 : Fin 4) 1) ≤
      Subgroup.normalizer (Subgroup.zpowers ([0, 1, 2].formPerm : Perm (Fin 4))) := by
  refine ⟨by decide, ?_⟩
  rw [Subgroup.zpowers_le, Subgroup.mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers,
    MonoidHom.coe_ofClass, MulAut.conj_apply,
    (by decide : swap (0 : Fin 4) 1 * [0, 1, 2].formPerm * (swap (0 : Fin 4) 1)⁻¹ =
      ([0, 1, 2].formPerm : Perm (Fin 4))⁻¹),
    Subgroup.zpowers_inv]

end TauCeti.Examples.AlternatingFour
