module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.Sylow
public import TauCeti.Algebra.Group.Subgroup.ZPowers
public import TauCeti.GroupTheory.Complement.Prod

/-!
# Sharpness of the invariant-complement theorem

`Subgroup.exists_invariant_complement` says: if a finite `q`-group `A` acts by automorphisms on a
finite group `W`, `N` is an abelian normal `p`-subgroup of `W` with `p ≠ q`, `N` is stable under
`A`, and `N` has a local complement in a Sylow `p`-subgroup of `W`, then `N` has an `A`-stable
complement in `W`. This file shows on two small examples that neither `p ≠ q` nor the stability of
`N` can be dropped.

Write `V₄ = Multiplicative (ZMod 2 × ZMod 2)` with generators `x = ofAdd (1, 0)` and
`y = ofAdd (0, 1)`, and `N = ⟨x⟩`.

* **`p = q`.** The transvection `x ↦ x`, `y ↦ x * y` is an automorphism of order `2` of `V₄`
  fixing `N`, so `A = ⟨transvection⟩` is a `2`-group and `N` is a normal `2`-subgroup of the
  `2`-group `V₄`, complemented by `⟨y⟩`. The complements of `N` are exactly `⟨y⟩` and
  `⟨x * y⟩`, and the transvection swaps them, so no complement of `N` is `A`-stable.
* **Stability of `N`.** In `V₄ × C₃`, let `A` be generated by the automorphism of order `3`
  acting on `V₄` by `x ↦ y ↦ x * y ↦ x` and trivially on `C₃`. Then `A` is a `3`-group,
  `N × 1` is a normal `2`-subgroup complemented by `⟨y⟩ × 1` inside the Sylow `2`-subgroup
  `V₄ × 1`, and `⟨y⟩ × C₃` is a complement of `N × 1`; but `N × 1` is not `A`-stable, and no
  complement of `N × 1` is `A`-stable, because every orbit of `A` on the non-identity elements
  of `V₄ × 1` passes through `(x, 1)`.

## Main results

* `TauCeti.Examples.InvariantComplement.isComplement'_zpowers_kleinX_iff`: the complements of
  `⟨x⟩` in `V₄` are `⟨y⟩` and `⟨x * y⟩`.
* `TauCeti.Examples.InvariantComplement.map_transvection_zpowers_kleinY`,
  `TauCeti.Examples.InvariantComplement.not_exists_invariant_complement_transvection`: the
  transvection carries `⟨y⟩` to `⟨x * y⟩`, and no complement of `⟨x⟩` in `V₄` is stable under it.
* `TauCeti.Examples.InvariantComplement.exists_isPGroup_and_not_exists_invariant_complement`:
  all hypotheses of the invariant-complement theorem except `p ≠ q` can hold while its conclusion
  fails.
* `TauCeti.Examples.InvariantComplement.not_forall_smul_mem_prod_zpowers_kleinX`,
  `TauCeti.Examples.InvariantComplement.not_exists_invariant_complement_rotationProd`:
  `⟨x⟩ × 1` is not stable under the rotation, and no complement of it in `V₄ × C₃` is.
* `TauCeti.Examples.InvariantComplement.exists_not_stable_and_not_exists_invariant_complement`:
  all hypotheses of the invariant-complement theorem except the stability of `N` can hold while
  its conclusion fails.

## References

* W. Gaschütz, *Zur Erweiterungstheorie der endlichen Gruppen*, J. reine angew. Math. 190
  (1952), 93–107.
* B. Sambale, *On the converse of Gaschütz' complement theorem*, arXiv:2303.00254, Section 1.
-/

public section

namespace TauCeti.Examples.InvariantComplement

open Multiplicative Subgroup

/-! ### The Klein four-group `(ZMod 2)²` -/

/-- The generator `x = ofAdd (1, 0)` of the Klein four-group
`Multiplicative (ZMod 2 × ZMod 2)`. -/
def kleinX : Multiplicative (ZMod 2 × ZMod 2) := ofAdd (1, 0)

/-- The generator `y = ofAdd (0, 1)` of the Klein four-group
`Multiplicative (ZMod 2 × ZMod 2)`. -/
def kleinY : Multiplicative (ZMod 2 × ZMod 2) := ofAdd (0, 1)

theorem kleinX_def : kleinX = ofAdd (1, 0) := (rfl)

theorem kleinY_def : kleinY = ofAdd (0, 1) := (rfl)

theorem kleinX_sq : kleinX ^ 2 = 1 := by decide

theorem kleinY_sq : kleinY ^ 2 = 1 := by decide

theorem kleinX_mul_kleinY_sq : (kleinX * kleinY) ^ 2 = 1 := by decide

/-- The subgroup `⟨x⟩` of `V₄` is `{1, x}`. -/
theorem mem_zpowers_kleinX_iff {v : Multiplicative (ZMod 2 × ZMod 2)} :
    v ∈ zpowers kleinX ↔ v = 1 ∨ v = kleinX :=
  mem_zpowers_iff_of_sq_eq_one kleinX_sq

/-- The subgroup `⟨y⟩` of `V₄` is `{1, y}`. -/
theorem mem_zpowers_kleinY_iff {v : Multiplicative (ZMod 2 × ZMod 2)} :
    v ∈ zpowers kleinY ↔ v = 1 ∨ v = kleinY :=
  mem_zpowers_iff_of_sq_eq_one kleinY_sq

/-- The subgroup `⟨x * y⟩` of `V₄` is `{1, x * y}`. -/
theorem mem_zpowers_kleinX_mul_kleinY_iff {v : Multiplicative (ZMod 2 × ZMod 2)} :
    v ∈ zpowers (kleinX * kleinY) ↔ v = 1 ∨ v = kleinX * kleinY :=
  mem_zpowers_iff_of_sq_eq_one kleinX_mul_kleinY_sq

/-- A complement of `⟨x⟩` in `V₄` contains `y` or `x * y`: write `y = n * d` with `n ∈ {1, x}` and
`d` in the complement. -/
theorem kleinY_mem_or_kleinX_mul_kleinY_mem {D : Subgroup (Multiplicative (ZMod 2 × ZMod 2))}
    (hD : (zpowers kleinX).IsComplement' D) : kleinY ∈ D ∨ kleinX * kleinY ∈ D := by
  obtain ⟨n, hn, d, hd, hnd⟩ := mem_sup.mp (hD.sup_eq_top ▸ mem_top kleinY)
  obtain rfl : d = n⁻¹ * kleinY := eq_inv_mul_of_mul_eq hnd
  rcases mem_zpowers_kleinX_iff.mp hn with rfl | rfl
  · left
    simpa using hd
  · right
    rwa [show kleinX⁻¹ * kleinY = kleinX * kleinY by decide] at hd

theorem isComplement'_zpowers_kleinX_zpowers_kleinY :
    (zpowers kleinX).IsComplement' (zpowers kleinY) := by
  refine isComplement'_of_disjoint_and_mul_eq_univ ?_ ?_
  · rw [disjoint_iff_inf_le]
    intro v ⟨hx, hy⟩
    rcases mem_zpowers_kleinX_iff.mp hx with rfl | rfl
    · exact one_mem _
    · exact absurd (mem_zpowers_kleinY_iff.mp hy) (by decide)
  · ext v
    simp only [Set.mem_mul, SetLike.mem_coe, mem_zpowers_kleinX_iff, mem_zpowers_kleinY_iff,
      Set.mem_univ, iff_true]
    revert v
    decide

/-! ### The transvection and the complements of `⟨x⟩` -/

/-- The transvection `(a, b) ↦ (a + b, b)` of `V₄`, which fixes `x` and sends `y` to `x * y`. -/
def transvection : MulAut (Multiplicative (ZMod 2 × ZMod 2)) where
  toFun v := ofAdd ((toAdd v).1 + (toAdd v).2, (toAdd v).2)
  invFun v := ofAdd ((toAdd v).1 + (toAdd v).2, (toAdd v).2)
  left_inv := by decide
  right_inv := by decide
  map_mul' := by decide

theorem transvection_apply (v : Multiplicative (ZMod 2 × ZMod 2)) :
    transvection v = ofAdd ((toAdd v).1 + (toAdd v).2, (toAdd v).2) := (rfl)

@[simp]
theorem transvection_kleinX : transvection kleinX = kleinX := by decide

@[simp]
theorem transvection_kleinY : transvection kleinY = kleinX * kleinY := by decide

@[simp]
theorem transvection_kleinX_mul_kleinY : transvection (kleinX * kleinY) = kleinY := by decide

/-- **The transvection carries the complement `⟨y⟩` of `⟨x⟩` to `⟨x * y⟩`.** -/
theorem map_transvection_zpowers_kleinY :
    (zpowers kleinY).map transvection.toMonoidHom = zpowers (kleinX * kleinY) := by
  rw [MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, transvection_kleinY]

/-- `⟨x * y⟩` is a complement of `⟨x⟩` in `V₄`: transport the complement `⟨y⟩` along the
transvection, which fixes `⟨x⟩`. -/
theorem isComplement'_zpowers_kleinX_zpowers_kleinX_mul_kleinY :
    (zpowers kleinX).IsComplement' (zpowers (kleinX * kleinY)) := by
  have h := (isLocalComplement_top_iff.mpr isComplement'_zpowers_kleinX_zpowers_kleinY).map
    (f := transvection.toMonoidHom) transvection.injective
  rwa [map_transvection_zpowers_kleinY, MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom,
    transvection_kleinX, map_top_of_surjective _ transvection.surjective,
    isLocalComplement_top_iff] at h

/-- **The complements of `⟨x⟩` in `V₄`.** They are exactly `⟨y⟩` and `⟨x * y⟩`. -/
theorem isComplement'_zpowers_kleinX_iff {D : Subgroup (Multiplicative (ZMod 2 × ZMod 2))} :
    (zpowers kleinX).IsComplement' D ↔ D = zpowers kleinY ∨ D = zpowers (kleinX * kleinY) := by
  constructor
  · intro hD
    rcases kleinY_mem_or_kleinX_mul_kleinY_mem hD with h | h
    · exact .inl (isComplement'_zpowers_kleinX_zpowers_kleinY.eq_of_le hD.disjoint
        (zpowers_le.mpr h)).symm
    · exact .inr (isComplement'_zpowers_kleinX_zpowers_kleinX_mul_kleinY.eq_of_le hD.disjoint
        (zpowers_le.mpr h)).symm
  · rintro (rfl | rfl)
    · exact isComplement'_zpowers_kleinX_zpowers_kleinY
    · exact isComplement'_zpowers_kleinX_zpowers_kleinX_mul_kleinY

/-! ### `p = q`: the transvection of `V₄` -/

theorem orderOf_transvection : orderOf transvection = 2 := by
  refine orderOf_eq_prime ?_ ?_
  · refine MulEquiv.ext fun v => ?_
    rw [pow_two, MulAut.mul_apply, MulAut.one_apply]
    revert v
    decide
  · intro h
    have := congrArg (· kleinY) h
    revert this
    decide

/-- The group generated by the transvection is a `2`-group. -/
theorem isPGroup_zpowers_transvection : IsPGroup 2 (zpowers transvection) :=
  IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, orderOf_transvection, pow_one])

theorem smul_mem_zpowers_kleinX (a : zpowers transvection) {v : Multiplicative (ZMod 2 × ZMod 2)}
    (hv : v ∈ zpowers kleinX) : a • v ∈ zpowers kleinX := by
  obtain ⟨_, k, rfl⟩ := a
  have ha : transvection ^ k ∈
      MulAction.stabilizer (MulAut (Multiplicative (ZMod 2 × ZMod 2))) kleinX :=
    zpow_mem (MulAction.mem_stabilizer_iff.mpr transvection_kleinX) k
  rcases mem_zpowers_kleinX_iff.mp hv with rfl | rfl
  · rw [smul_one]
    exact one_mem _
  · rw [Subgroup.smul_def, MulAction.mem_stabilizer_iff.mp ha]
    exact mem_zpowers kleinX

/-- **No transvection-stable complement.** No complement of `⟨x⟩` in `V₄` is stable under the
group generated by the transvection: the transvection exchanges `⟨y⟩` and `⟨x * y⟩`. -/
theorem not_exists_invariant_complement_transvection :
    ¬ ∃ D : Subgroup (Multiplicative (ZMod 2 × ZMod 2)), (zpowers kleinX).IsComplement' D ∧
      ∀ a : zpowers transvection, ∀ d ∈ D, a • d ∈ D := by
  rintro ⟨D, hD, hA⟩
  have hτ (d : Multiplicative (ZMod 2 × ZMod 2)) (hd : d ∈ D) : transvection d ∈ D := by
    simpa [Subgroup.smul_def, MulAut.smul_def] using hA ⟨transvection, mem_zpowers _⟩ d hd
  have hx : kleinX ∈ D := by
    rcases kleinY_mem_or_kleinX_mul_kleinY_mem hD with h | h
    · convert D.mul_mem (hτ _ h) h using 1
      decide
    · convert D.mul_mem h (hτ _ h) using 1
      decide
  have hne : kleinX ≠ 1 := by decide
  exact hne (hD.disjoint.le_bot ⟨mem_zpowers kleinX, hx⟩)

/-- The whole group `V₄` as its own Sylow `2`-subgroup. -/
def sylowTop : Sylow 2 (Multiplicative (ZMod 2 × ZMod 2)) :=
  IsPGroup.toSylow (P := ⊤) (IsPGroup.of_card (n := 2) (by simp [Nat.card_eq_fintype_card]))
    (by simp)

@[simp]
theorem coe_sylowTop : (sylowTop : Subgroup (Multiplicative (ZMod 2 × ZMod 2))) = ⊤ :=
  IsPGroup.toSylow_coe _ _

/-- **The hypothesis `p ≠ q` is needed.** There are a finite `2`-group `A` acting by automorphisms
on a finite group `W`, an abelian normal `2`-subgroup `N` of `W` stable under `A` and a Sylow
`2`-subgroup `P` of `W` in which `N` has a local complement, such that no complement of `N` in
`W` is `A`-stable. -/
theorem exists_isPGroup_and_not_exists_invariant_complement :
    ∃ (W A : Type) (_ : Group W) (_ : Group A) (_ : Finite W) (_ : Finite A)
      (_ : MulDistribMulAction A W) (N : Subgroup W) (_ : N.Normal) (_ : IsMulCommutative N)
      (P : Sylow 2 W),
      IsPGroup 2 N ∧ IsPGroup 2 A ∧ (∀ a : A, ∀ n ∈ N, a • n ∈ N) ∧
      (∃ K : Subgroup W, N.IsLocalComplement K P) ∧
      ¬ ∃ D : Subgroup W, N.IsComplement' D ∧ ∀ a : A, ∀ d ∈ D, a • d ∈ D :=
  ⟨_, zpowers transvection, _, _, inferInstance, inferInstance, inferInstance, zpowers kleinX,
    inferInstance, inferInstance, sylowTop,
    sylowTop.isPGroup.to_le (coe_sylowTop ▸ le_top), isPGroup_zpowers_transvection,
    smul_mem_zpowers_kleinX, ⟨zpowers kleinY, by
      rw [coe_sylowTop]
      exact isLocalComplement_top_iff.mpr isComplement'_zpowers_kleinX_zpowers_kleinY⟩,
    not_exists_invariant_complement_transvection⟩

/-! ### Stability of `N`: the rotation of `V₄` inside `V₄ × C₃` -/

/-- The automorphism `(a, b) ↦ (b, a + b)` of `V₄` of order `3`, which permutes the non-identity
elements cyclically: `x ↦ y ↦ x * y ↦ x`. -/
def rotation : MulAut (Multiplicative (ZMod 2 × ZMod 2)) where
  toFun v := ofAdd ((toAdd v).2, (toAdd v).1 + (toAdd v).2)
  invFun v := ofAdd ((toAdd v).1 + (toAdd v).2, (toAdd v).1)
  left_inv := by decide
  right_inv := by decide
  map_mul' := by decide

theorem rotation_apply (v : Multiplicative (ZMod 2 × ZMod 2)) :
    rotation v = ofAdd ((toAdd v).2, (toAdd v).1 + (toAdd v).2) := (rfl)

@[simp]
theorem rotation_kleinX : rotation kleinX = kleinY := by decide

@[simp]
theorem rotation_kleinY : rotation kleinY = kleinX * kleinY := by decide

@[simp]
theorem rotation_kleinX_mul_kleinY : rotation (kleinX * kleinY) = kleinX := by decide

/-- The automorphism of `V₄ × C₃` acting by `rotation` on `V₄` and trivially on `C₃`. -/
def rotationProd : MulAut (Multiplicative (ZMod 2 × ZMod 2) × Multiplicative (ZMod 3)) :=
  rotation.prodCongr (MulEquiv.refl _)

@[simp]
theorem rotationProd_apply (w : Multiplicative (ZMod 2 × ZMod 2) × Multiplicative (ZMod 3)) :
    rotationProd w = (rotation w.1, w.2) := (rfl)

theorem orderOf_rotationProd : orderOf rotationProd = 3 := by
  refine orderOf_eq_prime ?_ ?_
  · refine MulEquiv.ext fun w => ?_
    rw [pow_three, MulAut.mul_apply, MulAut.mul_apply, MulAut.one_apply]
    obtain ⟨v, c⟩ := w
    simp only [rotationProd_apply, Prod.mk.injEq, and_true]
    revert v
    decide
  · intro h
    have := congrArg (· ((kleinX, 1) : Multiplicative (ZMod 2 × ZMod 2) ×
      Multiplicative (ZMod 3))) h
    revert this
    decide

/-- The group generated by `rotationProd` is a `3`-group. -/
theorem isPGroup_zpowers_rotationProd : IsPGroup 3 (zpowers rotationProd) :=
  IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, orderOf_rotationProd, pow_one])

/-- The subgroup `V₄ × 1` is a `2`-subgroup of index `3` of `V₄ × C₃`, hence a Sylow
`2`-subgroup. -/
def sylowProd : Sylow 2 (Multiplicative (ZMod 2 × ZMod 2) × Multiplicative (ZMod 3)) :=
  IsPGroup.toSylow (P := (⊤ : Subgroup (Multiplicative (ZMod 2 × ZMod 2))).prod ⊥)
    (IsPGroup.of_card (n := 2) (by
      simp [Nat.card_congr (prodEquiv _ _).toEquiv, Nat.card_eq_fintype_card]))
    (by
      rw [index_prod, index_top, index_bot]
      simp)

@[simp]
theorem coe_sylowProd :
    (sylowProd : Subgroup (Multiplicative (ZMod 2 × ZMod 2) × Multiplicative (ZMod 3))) =
      (⊤ : Subgroup (Multiplicative (ZMod 2 × ZMod 2))).prod ⊥ :=
  IsPGroup.toSylow_coe _ _

/-- `⟨x⟩ × 1` has the local complement `⟨y⟩ × 1` in the Sylow `2`-subgroup `V₄ × 1`. -/
theorem isLocalComplement_prod_zpowers_kleinY :
    ((zpowers kleinX).prod (⊥ : Subgroup (Multiplicative (ZMod 3)))).IsLocalComplement
      ((zpowers kleinY).prod ⊥) ((⊤ : Subgroup (Multiplicative (ZMod 2 × ZMod 2))).prod ⊥) :=
  (isLocalComplement_top_iff.mpr isComplement'_zpowers_kleinX_zpowers_kleinY).prod
    (isLocalComplement_bot_self ⊥)

/-- `⟨x⟩ × 1` has the complement `⟨y⟩ × C₃` in `V₄ × C₃`. -/
theorem isComplement'_prod_zpowers_kleinY :
    ((zpowers kleinX).prod (⊥ : Subgroup (Multiplicative (ZMod 3)))).IsComplement'
      ((zpowers kleinY).prod ⊤) :=
  isComplement'_zpowers_kleinX_zpowers_kleinY.prod isComplement'_bot_top

/-- `⟨x⟩ × 1` is not stable under the group generated by `rotationProd`, which sends `(x, 1)` to
`(y, 1)`. -/
theorem not_forall_smul_mem_prod_zpowers_kleinX :
    ¬ ∀ a : zpowers rotationProd,
      ∀ n ∈ (zpowers kleinX).prod (⊥ : Subgroup (Multiplicative (ZMod 3))),
        a • n ∈ (zpowers kleinX).prod (⊥ : Subgroup (Multiplicative (ZMod 3))) := by
  intro h
  have := h ⟨rotationProd, mem_zpowers _⟩ (kleinX, 1)
    (mem_prod.mpr ⟨mem_zpowers kleinX, mem_bot.mpr rfl⟩)
  rw [Subgroup.smul_def, MulAut.smul_def, rotationProd_apply, rotation_kleinX, mem_prod,
    mem_zpowers_kleinX_iff] at this
  exact absurd this.1 (by decide)

/-- **No rotation-stable complement.** No complement of `⟨x⟩ × 1` in `V₄ × C₃` is stable under the
group generated by `rotationProd`: such a complement contains `(y, 1)` or `(x * y, 1)`, whose
orbit under the rotation passes through `(x, 1)`. -/
theorem not_exists_invariant_complement_rotationProd :
    ¬ ∃ D : Subgroup (Multiplicative (ZMod 2 × ZMod 2) × Multiplicative (ZMod 3)),
      ((zpowers kleinX).prod (⊥ : Subgroup (Multiplicative (ZMod 3)))).IsComplement' D ∧
      ∀ a : zpowers rotationProd, ∀ d ∈ D, a • d ∈ D := by
  rintro ⟨D, hD, hA⟩
  have hρ (d : Multiplicative (ZMod 2 × ZMod 2) × Multiplicative (ZMod 3)) (hd : d ∈ D) :
      rotationProd d ∈ D := by
    simpa [Subgroup.smul_def, MulAut.smul_def] using hA ⟨rotationProd, mem_zpowers _⟩ d hd
  obtain ⟨⟨n, m⟩, hnm, d, hd, hnd⟩ := mem_sup.mp (hD.sup_eq_top ▸ mem_top (kleinY, 1))
  obtain ⟨hn, hm⟩ := mem_prod.mp hnm
  obtain rfl : m = 1 := mem_bot.mp hm
  obtain rfl : d = (n, 1)⁻¹ * (kleinY, 1) := eq_inv_mul_of_mul_eq hnd
  have hx : ((kleinX, 1) : Multiplicative (ZMod 2 × ZMod 2) × Multiplicative (ZMod 3)) ∈ D := by
    rcases mem_zpowers_kleinX_iff.mp hn with rfl | rfl
    · convert hρ _ (hρ _ hd) using 1
      decide
    · convert hρ _ hd using 1
      decide
  have hne : ((kleinX, 1) : Multiplicative (ZMod 2 × ZMod 2) × Multiplicative (ZMod 3)) ≠ 1 := by
    decide
  exact hne (hD.disjoint.le_bot ⟨mem_prod.mpr ⟨mem_zpowers kleinX, mem_bot.mpr rfl⟩, hx⟩)

/-- **Stability of `N` is needed.** There are a finite `3`-group `A` acting by automorphisms on a
finite group `W`, an abelian normal `2`-subgroup `N` of `W` with a complement in `W` and a local
complement in a Sylow `2`-subgroup `P`, such that `N` is not `A`-stable and no complement of `N`
in `W` is `A`-stable. -/
theorem exists_not_stable_and_not_exists_invariant_complement :
    ∃ (W A : Type) (_ : Group W) (_ : Group A) (_ : Finite W) (_ : Finite A)
      (_ : MulDistribMulAction A W) (N : Subgroup W) (_ : N.Normal) (_ : IsMulCommutative N)
      (P : Sylow 2 W),
      IsPGroup 2 N ∧ IsPGroup 3 A ∧ (∃ K : Subgroup W, N.IsLocalComplement K P) ∧
      (∃ D : Subgroup W, N.IsComplement' D) ∧ ¬ (∀ a : A, ∀ n ∈ N, a • n ∈ N) ∧
      ¬ ∃ D : Subgroup W, N.IsComplement' D ∧ ∀ a : A, ∀ d ∈ D, a • d ∈ D :=
  ⟨_, zpowers rotationProd, _, _, inferInstance, inferInstance, inferInstance,
    (zpowers kleinX).prod ⊥, inferInstance, inferInstance, sylowProd,
    sylowProd.isPGroup.to_le (by rw [coe_sylowProd]; exact prod_mono le_top le_rfl),
    isPGroup_zpowers_rotationProd,
    ⟨_, by rw [coe_sylowProd]; exact isLocalComplement_prod_zpowers_kleinY⟩,
    ⟨_, isComplement'_prod_zpowers_kleinY⟩,
    not_forall_smul_mem_prod_zpowers_kleinX,
    not_exists_invariant_complement_rotationProd⟩

end TauCeti.Examples.InvariantComplement
