module

public import TauCeti.GroupTheory.SpecificGroups.Alternating.Complement

/-!
# Complements and non-abelian crossed projections for `A₄` in `S₄`

The alternating subgroup `A₄` of `S₄ = Equiv.Perm (Fin 4)` is a non-abelian normal subgroup of
order `12` and index `2` (`TauCeti.Examples.SymmetricFour.not_isMulCommutative_alternatingGroup`),
so the abelian `1`-cocycle API (`groupCohomology.IsMulCocycle₁`, `Subgroup.crossedProjectionEquiv`)
does not apply to the extension `A₄ → S₄ → S₄ ⧸ A₄`. This file instantiates the non-abelian
crossed-projection dictionary on `A₄ ≤ S₄`:

* **Classification and counts.** On four points every odd involution is a transposition
  (`TauCeti.Examples.SymmetricFour.sign_eq_neg_one_and_sq_eq_one_iff_isSwap`), so `A₄` has
  precisely six complements in `S₄` (generated by the six transpositions), the quotient extension
  `A₄ → S₄ → S₄ ⧸ A₄` has six splittings, and there are six normalized multiplicative crossed
  homomorphisms `S₄ → A₄`.
* **Factor order in the crossed identity.** For any complement `D` of `A₄` in `S₄`, the crossed
  projection `c : S₄ → A₄` satisfies `c (g * k) = g • c k * c g`. At the non-commuting three-cycles
  `g = (0 1 2)` and `k = (0 1 3)` in `A₄`, the reversed product `c g * (g • c k)` is `(0 1)(2 3)`
  whereas `c (g * k) = (g • c k) * c g` is `(0 2)(1 3)`
  (`TauCeti.Examples.SymmetricFour.crossedProjection_mul_ne_mul_smul`). The same non-commutativity
  appears on odd inputs `g = (0 2)`, `k = (0 3)` along `⟨(0 1)⟩`
  (`TauCeti.Examples.SymmetricFour.crossedProjection_swap_mul_swap_ne_mul_smul`).
* **Non-abelian `A₄`-conjugation.** Conjugating `⟨(0 1)⟩` by `a = (0 1 2) ∈ A₄` yields `⟨(1 2)⟩`
  and transforms the crossed projection by `c' x = x • a * c x * a⁻¹`
  (`TauCeti.Examples.SymmetricFour.crossedProjection_zpowers_swap_one_two`), while the abelian
  principal-twist formula `c x * (x • a / a)` fails at `x = (0 1 3)`
  (`TauCeti.Examples.SymmetricFour.crossedProjection_zpowers_swap_one_two_ne_mul_principal`).
-/

public section

open Equiv
open scoped IsMulCommutative Pointwise

namespace TauCeti.Examples.SymmetricFour

attribute [local instance] Subgroup.conjugationAction

/-! ### Non-commutativity of `A₄` and classification of complements -/

/-- **`A₄` is not commutative.** -/
theorem not_isMulCommutative_alternatingGroup :
    ¬ IsMulCommutative (alternatingGroup (Fin 4)) := by
  rw [alternatingGroup.isMulCommutative_iff_card_le_three, Nat.card_eq_fintype_card,
    Fintype.card_fin]
  decide

/-- On four points, the odd involutions of `S₄` are precisely the transpositions: a product of
disjoint transpositions of `Fin 4` is even. -/
theorem sign_eq_neg_one_and_sq_eq_one_iff_isSwap (t : Perm (Fin 4)) :
    (Perm.sign t = -1 ∧ t ^ 2 = 1) ↔ t.IsSwap := by
  rw [← Perm.card_support_eq_two]
  revert t
  decide

/-- There are six odd involutions in `S₄`, the six transpositions. -/
theorem card_odd_involution :
    Nat.card {t : Perm (Fin 4) // Perm.sign t = -1 ∧ t ^ 2 = 1} = 6 := by
  rw [Nat.card_eq_fintype_card]
  decide

/-- **The complements of `A₄` in `S₄` are the subgroups generated by the six transpositions.** -/
theorem isComplement'_alternatingGroup_iff_exists_isSwap (D : Subgroup (Perm (Fin 4))) :
    (alternatingGroup (Fin 4)).IsComplement' D ↔
      ∃ t : Perm (Fin 4), t.IsSwap ∧ Subgroup.zpowers t = D := by
  rw [isComplement'_alternatingGroup_iff]
  refine exists_congr fun t => ?_
  rw [← and_assoc, sign_eq_neg_one_and_sq_eq_one_iff_isSwap]

/-- **`A₄` has exactly six complements in `S₄`.** -/
theorem card_isComplement'_alternatingGroup :
    Nat.card {D : Subgroup (Perm (Fin 4)) // (alternatingGroup (Fin 4)).IsComplement' D} = 6 := by
  rw [← Nat.card_congr (alternatingGroupComplementEquiv (Fin 4)), card_odd_involution]

/-- **The quotient extension `A₄ → S₄ → S₄ ⧸ A₄` has exactly six splittings.** -/
theorem card_splitting_quotientExtension :
    Nat.card (alternatingGroup (Fin 4)).quotientExtension.Splitting = 6 := by
  rw [Nat.card_congr (alternatingGroup (Fin 4)).quotientSplittingEquiv,
    card_isComplement'_alternatingGroup]

/-- **There are exactly six normalized multiplicative crossed homomorphisms `S₄ → A₄`.** -/
theorem card_normalized_isMulCrossedHom :
    Nat.card {c : Perm (Fin 4) → alternatingGroup (Fin 4) //
      IsMulCrossedHom c ∧ ∀ n : alternatingGroup (Fin 4), c n = n} = 6 := by
  rw [← Nat.card_congr (Subgroup.mulCrossedHomEquiv (alternatingGroup (Fin 4))),
    card_isComplement'_alternatingGroup]

/-! ### Factor order and non-multiplicativity of crossed projections onto `A₄` -/

/-- The three-cycle `(0 1 2)` as an element of `A₄`. -/
def threeCycleZeroOneTwo : alternatingGroup (Fin 4) :=
  ⟨[(0 : Fin 4), 1, 2].formPerm, Perm.mem_alternatingGroup.mpr (by decide)⟩

/-- The underlying permutation of `threeCycleZeroOneTwo` is `[(0 : Fin 4), 1, 2].formPerm`. -/
@[simp]
theorem coe_threeCycleZeroOneTwo :
    (threeCycleZeroOneTwo : Perm (Fin 4)) = [(0 : Fin 4), 1, 2].formPerm := (rfl)

/-- The three-cycle `(0 1 3)` as an element of `A₄`. -/
def threeCycleZeroOneThree : alternatingGroup (Fin 4) :=
  ⟨[(0 : Fin 4), 1, 3].formPerm, Perm.mem_alternatingGroup.mpr (by decide)⟩

/-- The underlying permutation of `threeCycleZeroOneThree` is `[(0 : Fin 4), 1, 3].formPerm`. -/
@[simp]
theorem coe_threeCycleZeroOneThree :
    (threeCycleZeroOneThree : Perm (Fin 4)) = [(0 : Fin 4), 1, 3].formPerm := (rfl)

/-- **No crossed projection `S₄ → A₄` is a group homomorphism.** -/
theorem not_crossedProjection_map_mul {D : Subgroup (Perm (Fin 4))}
    (hD : (alternatingGroup (Fin 4)).IsComplement' D) :
    ¬ ∀ g k : Perm (Fin 4),
      hD.crossedProjection (g * k) = hD.crossedProjection g * hD.crossedProjection k := by
  rw [crossedProjection_alternatingGroup_map_mul_iff, Fintype.card_fin]
  decide

/-- **Factor order in the non-abelian crossed identity.** For any complement `D` of `A₄` in `S₄`,
at `g = (0 1 2)` and `k = (0 1 3)` the crossed projection `c` satisfies
`c (g * k) = (g • c k) * c g`, which is distinct from the reversed product `c g * (g • c k)`. -/
theorem crossedProjection_mul_ne_mul_smul {D : Subgroup (Perm (Fin 4))}
    (hD : (alternatingGroup (Fin 4)).IsComplement' D) :
    hD.crossedProjection ([(0 : Fin 4), 1, 2].formPerm * [(0 : Fin 4), 1, 3].formPerm) ≠
      hD.crossedProjection [(0 : Fin 4), 1, 2].formPerm *
        ([(0 : Fin 4), 1, 2].formPerm • hD.crossedProjection [(0 : Fin 4), 1, 3].formPerm) := by
  rw [hD.isMulCrossedHom_crossedProjection.map_mul]
  have hg : hD.crossedProjection [(0 : Fin 4), 1, 2].formPerm = threeCycleZeroOneTwo :=
    hD.crossedProjection_coe threeCycleZeroOneTwo
  have hk : hD.crossedProjection [(0 : Fin 4), 1, 3].formPerm = threeCycleZeroOneThree :=
    hD.crossedProjection_coe threeCycleZeroOneThree
  rw [hg, hk]
  intro h
  have hval := congrArg Subtype.val h
  simp only [Subgroup.coe_mul, Subgroup.coe_conjugationAction_smul, coe_threeCycleZeroOneTwo,
    coe_threeCycleZeroOneThree] at hval
  revert hval
  decide

section SwapComplement

/-- The transposition `(0 1)` of `Fin 4` is a swap. -/
theorem isSwap_swap_zero_one : (swap (0 : Fin 4) 1).IsSwap :=
  ⟨0, 1, by decide, rfl⟩

/-- The transposition `(1 2)` of `Fin 4` is a swap. -/
theorem isSwap_swap_one_two : (swap (1 : Fin 4) 2).IsSwap :=
  ⟨1, 2, by decide, rfl⟩

/-- The subgroup `⟨(0 1)⟩` is a complement of `A₄` in `S₄`. -/
theorem isComplement'_zpowers_swap_zero_one :
    (alternatingGroup (Fin 4)).IsComplement' (Subgroup.zpowers (swap (0 : Fin 4) 1)) :=
  isSwap_swap_zero_one.isComplement'_alternatingGroup_zpowers

/-- The subgroup `⟨(1 2)⟩` is a complement of `A₄` in `S₄`. -/
theorem isComplement'_zpowers_swap_one_two :
    (alternatingGroup (Fin 4)).IsComplement' (Subgroup.zpowers (swap (1 : Fin 4) 2)) :=
  isSwap_swap_one_two.isComplement'_alternatingGroup_zpowers

/-- Along `⟨(0 1)⟩`, the crossed projection sends the odd permutation `(0 2)` to `(0 1 2)`. -/
theorem coe_crossedProjection_swap_zero_two :
    (isComplement'_zpowers_swap_zero_one.crossedProjection (swap 0 2) : Perm (Fin 4)) =
      [(0 : Fin 4), 1, 2].formPerm := by
  rw [coe_crossedProjection_alternatingGroup_of_isSwap isComplement'_zpowers_swap_zero_one
    isSwap_swap_zero_one (Subgroup.mem_zpowers _) (swap 0 2),
    Perm.parityRetract_of_sign_eq_neg_one isSwap_swap_zero_one (by decide)]
  decide

/-- Along `⟨(0 1)⟩`, the crossed projection sends the odd permutation `(0 3)` to `(0 1 3)`. -/
theorem coe_crossedProjection_swap_zero_three :
    (isComplement'_zpowers_swap_zero_one.crossedProjection (swap 0 3) : Perm (Fin 4)) =
      [(0 : Fin 4), 1, 3].formPerm := by
  rw [coe_crossedProjection_alternatingGroup_of_isSwap isComplement'_zpowers_swap_zero_one
    isSwap_swap_zero_one (Subgroup.mem_zpowers _) (swap 0 3),
    Perm.parityRetract_of_sign_eq_neg_one isSwap_swap_zero_one (by decide)]
  decide

/-- **Factor order on odd inputs.** Along `⟨(0 1)⟩`, at the odd permutations `g = (0 2)` and
`k = (0 3)`, `c (g * k) = (0 3 2)` equals `(g • c k) * c g`, whereas `c g * (g • c k) = (0 1 3)`. -/
theorem crossedProjection_swap_mul_swap_ne_mul_smul :
    isComplement'_zpowers_swap_zero_one.crossedProjection (swap 0 2 * swap 0 3) ≠
      isComplement'_zpowers_swap_zero_one.crossedProjection (swap 0 2) *
        (swap (0 : Fin 4) 2 •
          isComplement'_zpowers_swap_zero_one.crossedProjection (swap 0 3)) := by
  intro h
  have hval := congrArg Subtype.val h
  have heven : swap (0 : Fin 4) 2 * swap 0 3 ∈ alternatingGroup (Fin 4) :=
    Perm.mem_alternatingGroup.mpr (by decide)
  have hprod : isComplement'_zpowers_swap_zero_one.crossedProjection (swap 0 2 * swap 0 3) =
      ⟨swap 0 2 * swap 0 3, heven⟩ :=
    isComplement'_zpowers_swap_zero_one.crossedProjection_coe ⟨swap 0 2 * swap 0 3, heven⟩
  rw [hprod, Subgroup.coe_mul, Subgroup.coe_conjugationAction_smul,
    coe_crossedProjection_swap_zero_two, coe_crossedProjection_swap_zero_three] at hval
  dsimp only at hval
  revert hval
  decide

/-! ### Non-abelian `A₄`-conjugation vs. failure of the abelian principal-twist formula -/

/-- **Conjugating `⟨(0 1)⟩` by `(0 1 2) ∈ A₄` gives `⟨(1 2)⟩`.** -/
theorem conj_threeCycleZeroOneTwo_smul_zpowers :
    MulAut.conj (threeCycleZeroOneTwo : Perm (Fin 4)) • Subgroup.zpowers (swap (0 : Fin 4) 1) =
      Subgroup.zpowers (swap (1 : Fin 4) 2) := by
  refine eq_zpowers_of_isComplement'_alternatingGroup
    (isComplement'_zpowers_swap_zero_one.conj_smul _) ?_ (by decide)
  rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, MulAut.smul_def, MulAut.conj_inv_apply,
    coe_threeCycleZeroOneTwo]
  have hinv : [(0 : Fin 4), 1, 2].formPerm⁻¹ * swap 1 2 * [(0 : Fin 4), 1, 2].formPerm =
      swap 0 1 := by decide
  rw [hinv]
  exact Subgroup.mem_zpowers _

/-- **Non-abelian `A₄`-conjugation of crossed projections.** The crossed projection `c'` along
`⟨(1 2)⟩` is related to the crossed projection `c` along `⟨(0 1)⟩` by
`c' x = x • a * c x * a⁻¹` for `a = (0 1 2) ∈ A₄`. -/
theorem crossedProjection_zpowers_swap_one_two (x : Perm (Fin 4)) :
    isComplement'_zpowers_swap_one_two.crossedProjection x =
      x • threeCycleZeroOneTwo *
        isComplement'_zpowers_swap_zero_one.crossedProjection x * threeCycleZeroOneTwo⁻¹ :=
  (isComplement'_zpowers_swap_zero_one.eq_conj_smul_iff_crossedProjection_eq_mul_inv
    isComplement'_zpowers_swap_one_two threeCycleZeroOneTwo).mp
    conj_threeCycleZeroOneTwo_smul_zpowers.symm x

/-- **The abelian principal-twist formula fails for non-abelian `A₄`.** Although `⟨(1 2)⟩` is the
conjugate of `⟨(0 1)⟩` by `a = (0 1 2) ∈ A₄`, at `x = (0 1 3)` the crossed projection along
`⟨(1 2)⟩` does not equal `c x * (x • a / a)`. -/
theorem crossedProjection_zpowers_swap_one_two_ne_mul_principal :
    isComplement'_zpowers_swap_one_two.crossedProjection [(0 : Fin 4), 1, 3].formPerm ≠
      isComplement'_zpowers_swap_zero_one.crossedProjection [(0 : Fin 4), 1, 3].formPerm *
        ([(0 : Fin 4), 1, 3].formPerm • threeCycleZeroOneTwo / threeCycleZeroOneTwo) := by
  have h1 : isComplement'_zpowers_swap_one_two.crossedProjection [(0 : Fin 4), 1, 3].formPerm =
      threeCycleZeroOneThree :=
    isComplement'_zpowers_swap_one_two.crossedProjection_coe threeCycleZeroOneThree
  have h0 : isComplement'_zpowers_swap_zero_one.crossedProjection [(0 : Fin 4), 1, 3].formPerm =
      threeCycleZeroOneThree :=
    isComplement'_zpowers_swap_zero_one.crossedProjection_coe threeCycleZeroOneThree
  rw [h1, h0]
  intro h
  have hval := congrArg Subtype.val h
  simp only [Subgroup.coe_mul, div_eq_mul_inv, Subgroup.coe_inv,
    Subgroup.coe_conjugationAction_smul, coe_threeCycleZeroOneTwo,
    coe_threeCycleZeroOneThree] at hval
  revert hval
  decide

end SwapComplement

end TauCeti.Examples.SymmetricFour
