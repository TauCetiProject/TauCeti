module

public import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.ZModThree
import Mathlib.GroupTheory.Perm.Cycle.Type

/-!
# Baer's counterexample to Gaschütz's splitting theorem

This module formalizes **Baer's central product `SL(2, 3) ∗ C₄`** (`BaerGroup`), proving that the
commutativity assumption `[IsMulCommutative N]` cannot be omitted from either Gaschütz's splitting
theorem (`Subgroup.IsLocalComplement.exists_isComplement'_of_coprime_index`) or Sylow complement
detection (`IsPGroup.exists_isComplement'_iff_sylow`).  (For the non-splitting of
`SL(2, ZMod 3)` over its centre `{±1}` inside its Sylow `2`-subgroup, see
`TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.ZModThree`.)

Identifying `-1 : SL(2, ZMod 3)` with the unique involution `Multiplicative.ofAdd 2` of
`Multiplicative (ZMod 4)` produces a finite solvable group `BaerGroup` of order `48`.  The image
`baerKernel` of `Q₈ × 1` is a normal `2`-subgroup of order `8` isomorphic to `QuaternionGroup 2`
and coincides with the derived subgroup `commutator BaerGroup`.  Inside the Sylow `2`-subgroup
`baerSylow` (the image of `Q₈ × C₄`, of order `16` and index `3` coprime to `8`), `baerKernel`
admits the order-`2` local complement `baerLocalComplement` generated by the image of
`(sl2ZModThreeI, Multiplicative.ofAdd 1)`, yet `baerKernel` has no global complement in `BaerGroup`.

## Main definitions

* `TauCeti.Examples.BaerCounterexample.baerCentralSubgroup`: the central subgroup of order `2` in
  `SL(2, ZMod 3) × Multiplicative (ZMod 4)` generated by `(-1, Multiplicative.ofAdd 2)`.
* `TauCeti.Examples.BaerCounterexample.BaerGroup`: the central product `SL(2, 3) ∗ C₄` of order
  `48`.
* `TauCeti.Examples.BaerCounterexample.baerKernel`: the normal quaternion `2`-subgroup of order `8`
  in `BaerGroup`, with `baerKernelMulEquiv : QuaternionGroup 2 ≃* baerKernel`.
* `TauCeti.Examples.BaerCounterexample.baerSylow`: the Sylow `2`-subgroup of order `16` and index
  `3` in `BaerGroup`.
* `TauCeti.Examples.BaerCounterexample.baerLocalComplement`: the cyclic subgroup of order `2` that
  complements `baerKernel` locally inside `baerSylow`.

## Main results

* `TauCeti.Examples.BaerCounterexample.commutator_baerGroup`: the derived subgroup of `BaerGroup`
  is `baerKernel`.
* `TauCeti.Examples.BaerCounterexample.isLocalComplement_baerKernel`: `baerLocalComplement` is a
  local complement of `baerKernel` in `baerSylow`.
* `TauCeti.Examples.BaerCounterexample.not_exists_isComplement'_baerKernel`: `baerKernel` has no
  global complement in `BaerGroup`.
* `TauCeti.Examples.BaerCounterexample.exists_nonabelian_counterexample_gaschutz`: there exists a
  finite solvable group with a non-abelian normal `2`-subgroup that splits locally in a Sylow
  `2`-subgroup of coprime index yet admits no global complement.

## References

* W. Gaschütz, *Zur Erweiterungstheorie der endlichen Gruppen*, J. reine angew. Math. 190
  (1952), 93–107.
* B. Sambale, *On the converse of Gaschütz' complement theorem*, arXiv:2303.00254, Section 1.
-/

public section

open Matrix
open scoped IsMulCommutative MatrixGroups commutatorElement

namespace TauCeti.Examples.BaerCounterexample

/-! ### Baer's central product `SL(2, 3) ∗ C₄` of order `48` -/

/-- The diagonal central involution `(-1, Multiplicative.ofAdd 2)` of
`SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
def baerCentralGen : SL(2, ZMod 3) × Multiplicative (ZMod 4) :=
  (-1, Multiplicative.ofAdd 2)

@[simp]
theorem baerCentralGen_fst : baerCentralGen.1 = -1 := (rfl)

@[simp]
theorem baerCentralGen_snd : baerCentralGen.2 = Multiplicative.ofAdd 2 := (rfl)

@[simp]
theorem baerCentralGen_ne_one : baerCentralGen ≠ 1 := by
  intro h
  have hsnd : (Multiplicative.ofAdd (2 : ZMod 4)) = 1 := congrArg Prod.snd h
  revert hsnd
  decide

@[simp]
theorem baerCentralGen_sq : baerCentralGen ^ 2 = 1 := by
  rw [sq, Prod.mk_mul_mk, ← sq, ← sq]
  apply Prod.ext
  · exact neg_one_sq
  · decide

@[simp]
theorem orderOf_baerCentralGen : orderOf baerCentralGen = 2 :=
  orderOf_eq_prime baerCentralGen_sq baerCentralGen_ne_one

/-- `baerCentralGen` belongs to the centre of `SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
theorem baerCentralGen_mem_center :
    baerCentralGen ∈ Subgroup.center (SL(2, ZMod 3) × Multiplicative (ZMod 4)) := by
  rw [Subgroup.mem_center_iff]
  rintro ⟨g, z⟩
  apply Prod.ext
  · simp [baerCentralGen]
  · exact mul_comm z _

/-- The central subgroup `{1, (-1, Multiplicative.ofAdd 2)}` of order `2` in
`SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
def baerCentralSubgroup : Subgroup (SL(2, ZMod 3) × Multiplicative (ZMod 4)) :=
  Subgroup.zpowers baerCentralGen

/-- Unfolding lemma for `baerCentralSubgroup`. -/
theorem baerCentralSubgroup_def :
    baerCentralSubgroup = Subgroup.zpowers baerCentralGen := (rfl)

@[simp]
theorem mem_baerCentralSubgroup_iff {x : SL(2, ZMod 3) × Multiplicative (ZMod 4)} :
    x ∈ baerCentralSubgroup ↔ x = 1 ∨ x = baerCentralGen :=
  Subgroup.mem_zpowers_iff_of_sq_eq_one baerCentralGen_sq

/-- `baerCentralSubgroup` is normal in `SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
instance baerCentralSubgroup_normal : baerCentralSubgroup.Normal :=
  Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr baerCentralGen_mem_center)

/-- `baerCentralSubgroup` has cardinality `2`. -/
theorem card_baerCentralSubgroup : Nat.card baerCentralSubgroup = 2 := by
  rw [baerCentralSubgroup, Nat.card_zpowers, orderOf_baerCentralGen]

/-- **Baer's central product `SL(2, 3) ∗ C₄`**, obtained as the quotient of
`SL(2, ZMod 3) × Multiplicative (ZMod 4)` by `baerCentralSubgroup`. -/
abbrev BaerGroup : Type :=
  (SL(2, ZMod 3) × Multiplicative (ZMod 4)) ⧸ baerCentralSubgroup

/-- `BaerGroup` has cardinality `48`. -/
@[simp]
theorem card_baerGroup : Nat.card BaerGroup = 48 := by
  have h := baerCentralSubgroup.card_mul_index
  have hprod : Nat.card (SL(2, ZMod 3) × Multiplicative (ZMod 4)) = 96 := by
    rw [Nat.card_prod, card_specialLinearGroup_fin_two_zmod_three, Nat.card_eq_fintype_card,
      Fintype.card_multiplicative, ZMod.card]
  rw [Subgroup.index, card_baerCentralSubgroup, hprod] at h
  unfold BaerGroup
  omega

/-! ### The normal quaternion subgroup `baerKernel ≅ Q₈` -/

/-- The faithful embedding `QuaternionGroup 2 →* BaerGroup` along the first factor. -/
def baerKernelHom : QuaternionGroup 2 →* BaerGroup :=
  (QuotientGroup.mk' baerCentralSubgroup).comp
    ((MonoidHom.inl SL(2, ZMod 3) (Multiplicative (ZMod 4))).comp sl2ZModThreeQuaternionHom)

@[simp]
theorem baerKernelHom_apply (q : QuaternionGroup 2) :
    baerKernelHom q = ((sl2ZModThreeQuaternionHom q, (1 : Multiplicative (ZMod 4))) : BaerGroup) :=
  (rfl)

/-- `baerKernelHom` embeds `QuaternionGroup 2` injectively into `BaerGroup`. -/
theorem baerKernelHom_injective : Function.Injective baerKernelHom := by
  rw [injective_iff_map_eq_one]
  intro q hq
  rw [baerKernelHom_apply, QuotientGroup.eq_one_iff, mem_baerCentralSubgroup_iff] at hq
  rcases hq with h1 | hgen
  · exact sl2ZModThreeQuaternionHom_injective (by simpa using congrArg Prod.fst h1)
  · exfalso
    have hsnd : (1 : Multiplicative (ZMod 4)) = Multiplicative.ofAdd 2 := congrArg Prod.snd hgen
    revert hsnd
    decide

/-- The quaternion subgroup of order `8` in `BaerGroup`, image of `Q₈ × 1`. -/
def baerKernel : Subgroup BaerGroup :=
  baerKernelHom.range

/-- Unfolding lemma for `baerKernel`. -/
theorem baerKernel_def : baerKernel = baerKernelHom.range := (rfl)

@[simp]
theorem range_baerKernelHom : baerKernelHom.range = baerKernel := (rfl)

/-- An element of `BaerGroup` lies in `baerKernel` if and only if it is in the image of
`baerKernelHom`. -/
theorem mem_baerKernel_iff {g : BaerGroup} :
    g ∈ baerKernel ↔ ∃ q : QuaternionGroup 2, baerKernelHom q = g := Iff.rfl

/-- Every value of `baerKernelHom` lies in `baerKernel`. -/
theorem baerKernelHom_mem_baerKernel (q : QuaternionGroup 2) : baerKernelHom q ∈ baerKernel :=
  ⟨q, rfl⟩

/-- `baerKernel` is isomorphic to `QuaternionGroup 2`. -/
noncomputable def baerKernelMulEquiv : QuaternionGroup 2 ≃* baerKernel :=
  MonoidHom.ofInjective baerKernelHom_injective

@[simp]
theorem coe_baerKernelMulEquiv (q : QuaternionGroup 2) :
    (baerKernelMulEquiv q : BaerGroup) = baerKernelHom q := (rfl)

/-- `baerKernel` coincides with the image of `sl2ZModThreeQuaternionSubgroup × ⊥` under
`QuotientGroup.mk' baerCentralSubgroup`. -/
theorem baerKernel_eq_map :
    baerKernel =
      (sl2ZModThreeQuaternionSubgroup.prod ⊥).map (QuotientGroup.mk' baerCentralSubgroup) := by
  ext g
  simp only [baerKernel, sl2ZModThreeQuaternionSubgroup_def, MonoidHom.mem_range, Subgroup.mem_map,
    Subgroup.mem_prod, Subgroup.mem_bot, Prod.exists, baerKernelHom_apply, QuotientGroup.mk'_apply]
  constructor
  · rintro ⟨q, rfl⟩
    exact ⟨sl2ZModThreeQuaternionHom q, 1, ⟨⟨q, rfl⟩, rfl⟩, rfl⟩
  · rintro ⟨x, _, ⟨⟨q, rfl⟩, rfl⟩, rfl⟩
    exact ⟨q, rfl⟩

/-- A coset `(x : BaerGroup)` lies in `baerKernel` if and only if `x.1` lies in
`TauCeti.sl2ZModThreeQuaternionSubgroup` and `x.2 ^ 2 = 1`. -/
@[simp]
theorem mk_mem_baerKernel_iff {x : SL(2, ZMod 3) × Multiplicative (ZMod 4)} :
    (x : BaerGroup) ∈ baerKernel ↔ x.1 ∈ sl2ZModThreeQuaternionSubgroup ∧ x.2 ^ 2 = 1 := by
  rcases x with ⟨A, z⟩
  simp only [baerKernel_eq_map, Subgroup.mem_map, Subgroup.mem_prod, Subgroup.mem_bot, Prod.exists,
    QuotientGroup.mk'_apply]
  constructor
  · rintro ⟨y, w, ⟨hy, rfl⟩, heq⟩
    have hrel : (y, (1 : Multiplicative (ZMod 4)))⁻¹ * (A, z) ∈ baerCentralSubgroup :=
      QuotientGroup.eq.mp heq
    rcases mem_baerCentralSubgroup_iff.mp hrel with h1 | hgen
    · have hA : A = y := (inv_mul_eq_one.mp (congrArg Prod.fst h1)).symm
      have hz : z = 1 := by simpa using congrArg Prod.snd h1
      exact ⟨hA ▸ hy, by simp [hz]⟩
    · have hA : A = -y := by
        have hfst : y⁻¹ * A = -1 := congrArg Prod.fst hgen
        calc A = y * (y⁻¹ * A) := by simp
          _ = y * (-1) := by rw [hfst]
          _ = -y := by simp
      have hz : z = Multiplicative.ofAdd 2 := by simpa using congrArg Prod.snd hgen
      refine ⟨hA ▸ ?_, by rw [hz]; decide⟩
      simpa only [neg_one_mul] using mul_mem neg_one_mem_sl2ZModThreeQuaternionSubgroup hy
  · rintro ⟨hA, hz2⟩
    have hz_cases : z = 1 ∨ z = Multiplicative.ofAdd 2 :=
      (by clear * -; decide : ∀ w : Multiplicative (ZMod 4),
        w ^ 2 = 1 → w = 1 ∨ w = Multiplicative.ofAdd 2) z hz2
    rcases hz_cases with rfl | rfl
    · exact ⟨A, 1, ⟨hA, rfl⟩, rfl⟩
    · refine ⟨-A, 1, ⟨?_, rfl⟩, ?_⟩
      · simpa only [neg_one_mul] using mul_mem neg_one_mem_sl2ZModThreeQuaternionSubgroup hA
      · apply QuotientGroup.eq.mpr
        rw [mem_baerCentralSubgroup_iff]
        right
        apply Prod.ext
        · simp [baerCentralGen]
        · simp [baerCentralGen]

/-- `baerKernel` is normal in `BaerGroup`. -/
instance baerKernel_normal : baerKernel.Normal := by
  rw [baerKernel_eq_map]
  infer_instance

/-- `baerKernel` has cardinality `8`. -/
@[simp]
theorem card_baerKernel : Nat.card baerKernel = 8 := by
  rw [← Nat.card_congr baerKernelMulEquiv.toEquiv, nat_card_quaternionGroup]

/-- `baerKernel` is a `2`-group. -/
theorem isPGroup_two_baerKernel : IsPGroup 2 baerKernel :=
  IsPGroup.of_card (n := 3) card_baerKernel

/-- `baerKernel` is non-abelian. -/
theorem not_isMulCommutative_baerKernel : ¬ IsMulCommutative baerKernel := by
  intro hcomm
  have hQ : IsMulCommutative (QuaternionGroup 2) :=
    ⟨⟨fun p q => baerKernelMulEquiv.injective (by rw [map_mul, map_mul, mul_comm])⟩⟩
  have h2 := isMulCommutative_quaternionGroup_iff.mp hQ
  omega

/-- The derived subgroup of `BaerGroup` is `baerKernel`. -/
theorem commutator_baerGroup : commutator BaerGroup = baerKernel := by
  rw [← map_commutator_of_surjective (QuotientGroup.mk'_surjective baerCentralSubgroup),
    commutator_def, ← Subgroup.top_prod_top, Subgroup.commutator_prod_prod,
    ← commutator_def, ← commutator_def, commutator_specialLinearGroup_fin_two_zmod_three,
    commutator_eq_bot, baerKernel_eq_map]

/-- Every commutator in `BaerGroup` lies in `baerKernel`. -/
theorem commutatorElement_mem_baerKernel (g₁ g₂ : BaerGroup) : ⁅g₁, g₂⁆ ∈ baerKernel :=
  commutator_baerGroup ▸
    Subgroup.commutator_mem_commutator (Subgroup.mem_top g₁) (Subgroup.mem_top g₂)

/-! ### The Sylow `2`-subgroup `baerSylow` and the local complement `baerLocalComplement` -/

/-- The subgroup `Q₈ ∗ C₄` of order `16` and index `3` in `BaerGroup`, defined as the image of
`sl2ZModThreeQuaternionSubgroup × ⊤`. -/
def baerSylowSubgroup : Subgroup BaerGroup :=
  (sl2ZModThreeQuaternionSubgroup.prod ⊤).map (QuotientGroup.mk' baerCentralSubgroup)

/-- Unfolding lemma for `baerSylowSubgroup`. -/
theorem baerSylowSubgroup_def :
    baerSylowSubgroup =
      (sl2ZModThreeQuaternionSubgroup.prod ⊤).map (QuotientGroup.mk' baerCentralSubgroup) := (rfl)

/-- `baerCentralSubgroup` is contained in `sl2ZModThreeQuaternionSubgroup × ⊤`. -/
theorem baerCentralSubgroup_le_prod :
    baerCentralSubgroup ≤ sl2ZModThreeQuaternionSubgroup.prod ⊤ :=
  Subgroup.zpowers_le.mpr ⟨neg_one_mem_sl2ZModThreeQuaternionSubgroup, Subgroup.mem_top _⟩

@[simp]
theorem comap_baerSylowSubgroup :
    baerSylowSubgroup.comap (QuotientGroup.mk' baerCentralSubgroup) =
      sl2ZModThreeQuaternionSubgroup.prod ⊤ :=
  Subgroup.comap_map_eq_self
    ((QuotientGroup.ker_mk' baerCentralSubgroup).symm ▸ baerCentralSubgroup_le_prod)

/-- An element of `BaerGroup` lies in `baerSylowSubgroup` if and only if it is represented by a pair
whose first coordinate lies in `TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
theorem mem_baerSylowSubgroup_iff {g : BaerGroup} :
    g ∈ baerSylowSubgroup ↔
      ∃ x ∈ sl2ZModThreeQuaternionSubgroup, ∃ z : Multiplicative (ZMod 4),
        ((x, z) : BaerGroup) = g := by
  simp only [baerSylowSubgroup, Subgroup.mem_map, Subgroup.mem_prod, Subgroup.mem_top, and_true,
    Prod.exists, QuotientGroup.mk'_apply]
  exact ⟨fun ⟨a, b, ha, h⟩ => ⟨a, ha, b, h⟩, fun ⟨a, ha, b, h⟩ => ⟨a, b, ha, h⟩⟩

/-- A coset `(x : BaerGroup)` lies in `baerSylowSubgroup` if and only if `x.1` lies in
`TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
@[simp]
theorem mk_mem_baerSylowSubgroup_iff {x : SL(2, ZMod 3) × Multiplicative (ZMod 4)} :
    (x : BaerGroup) ∈ baerSylowSubgroup ↔ x.1 ∈ sl2ZModThreeQuaternionSubgroup := by
  change x ∈ baerSylowSubgroup.comap (QuotientGroup.mk' baerCentralSubgroup) ↔ _
  rw [comap_baerSylowSubgroup, Subgroup.mem_prod]
  simp

/-- `baerSylowSubgroup` has index `3` in `BaerGroup`. -/
@[simp]
theorem index_baerSylowSubgroup : baerSylowSubgroup.index = 3 := by
  rw [← baerSylowSubgroup.index_comap_of_surjective
      (QuotientGroup.mk'_surjective baerCentralSubgroup),
    comap_baerSylowSubgroup, Subgroup.index_prod, index_sl2ZModThreeQuaternionSubgroup,
    Subgroup.index_top, mul_one]

/-- `baerSylowSubgroup` has cardinality `16`. -/
@[simp]
theorem card_baerSylowSubgroup : Nat.card baerSylowSubgroup = 16 := by
  have h := baerSylowSubgroup.card_mul_index
  rw [index_baerSylowSubgroup, card_baerGroup] at h
  omega

/-- `baerSylowSubgroup` is a `2`-group. -/
theorem isPGroup_two_baerSylowSubgroup : IsPGroup 2 baerSylowSubgroup :=
  IsPGroup.of_card (n := 4) card_baerSylowSubgroup

/-- `baerSylowSubgroup` packaged as a Sylow `2`-subgroup of `BaerGroup`. -/
def baerSylow : Sylow 2 BaerGroup :=
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  isPGroup_two_baerSylowSubgroup.toSylow (by rw [index_baerSylowSubgroup]; decide)

@[simp]
theorem coe_baerSylow : (baerSylow : Subgroup BaerGroup) = baerSylowSubgroup := (rfl)

/-- The index of `baerSylow` is coprime to `Nat.card baerKernel`. -/
theorem coprime_index_baerSylow_card_baerKernel :
    Nat.Coprime (baerSylow : Subgroup BaerGroup).index (Nat.card baerKernel) := by
  rw [coe_baerSylow, index_baerSylowSubgroup, card_baerKernel]
  decide

/-- The involution in `BaerGroup` represented by `(sl2ZModThreeI, Multiplicative.ofAdd 1)`, whose
square `(-1, Multiplicative.ofAdd 2)` is killed in the central quotient. -/
def baerLocalComplementGen : BaerGroup :=
  ((sl2ZModThreeI, Multiplicative.ofAdd (1 : ZMod 4)) : BaerGroup)

/-- Unfolding lemma for `baerLocalComplementGen`. -/
theorem baerLocalComplementGen_def :
    baerLocalComplementGen = ((sl2ZModThreeI, Multiplicative.ofAdd (1 : ZMod 4)) : BaerGroup) :=
  (rfl)

@[simp]
theorem baerLocalComplementGen_ne_one : baerLocalComplementGen ≠ 1 := by
  rw [baerLocalComplementGen_def, ne_eq, QuotientGroup.eq_one_iff, mem_baerCentralSubgroup_iff]
  rintro (h1 | hgen)
  · have hsnd : Multiplicative.ofAdd (1 : ZMod 4) = 1 := congrArg Prod.snd h1
    revert hsnd; decide
  · have hsnd : Multiplicative.ofAdd (1 : ZMod 4) = Multiplicative.ofAdd 2 :=
      congrArg Prod.snd hgen
    revert hsnd; decide

@[simp]
theorem baerLocalComplementGen_sq : baerLocalComplementGen ^ 2 = 1 := by
  rw [baerLocalComplementGen_def, ← QuotientGroup.mk_pow, sq, Prod.mk_mul_mk, ← sq, ← sq,
    sl2ZModThreeI_sq, QuotientGroup.eq_one_iff, mem_baerCentralSubgroup_iff]
  exact Or.inr (Prod.ext rfl (by decide))

@[simp]
theorem orderOf_baerLocalComplementGen : orderOf baerLocalComplementGen = 2 :=
  orderOf_eq_prime baerLocalComplementGen_sq baerLocalComplementGen_ne_one

/-- The order-`2` cyclic subgroup of `BaerGroup` generated by `baerLocalComplementGen`. -/
def baerLocalComplement : Subgroup BaerGroup :=
  Subgroup.zpowers baerLocalComplementGen

/-- Unfolding lemma for `baerLocalComplement`. -/
theorem baerLocalComplement_def :
    baerLocalComplement = Subgroup.zpowers baerLocalComplementGen := (rfl)

@[simp]
theorem mem_baerLocalComplement_iff {g : BaerGroup} :
    g ∈ baerLocalComplement ↔ g = 1 ∨ g = baerLocalComplementGen :=
  Subgroup.mem_zpowers_iff_of_sq_eq_one baerLocalComplementGen_sq

/-- `baerLocalComplement` has cardinality `2`. -/
theorem card_baerLocalComplement : Nat.card baerLocalComplement = 2 := by
  rw [baerLocalComplement, Nat.card_zpowers, orderOf_baerLocalComplementGen]

/-- `baerKernel` and `baerLocalComplement` intersect trivially. -/
theorem baerKernel_inf_baerLocalComplement : baerKernel ⊓ baerLocalComplement = ⊥ := by
  rw [eq_bot_iff]
  intro g hg
  rcases Subgroup.mem_inf.mp hg with ⟨hker, hloc⟩
  rw [mem_baerLocalComplement_iff] at hloc
  rcases hloc with rfl | rfl
  · exact Subgroup.mem_bot.mpr rfl
  · exfalso
    rw [baerLocalComplementGen_def, mk_mem_baerKernel_iff] at hker
    have hsnd : (Multiplicative.ofAdd (1 : ZMod 4)) ^ 2 = 1 := hker.2
    revert hsnd
    decide

/-- `baerKernel` and `baerLocalComplement` generate `baerSylowSubgroup`. -/
theorem baerKernel_sup_baerLocalComplement :
    baerKernel ⊔ baerLocalComplement = baerSylowSubgroup := by
  refine le_antisymm (sup_le ?_ ?_) ?_
  · rw [baerKernel_eq_map, baerSylowSubgroup]
    exact Subgroup.map_mono (Subgroup.prod_mono le_rfl bot_le)
  · rw [baerLocalComplement, Subgroup.zpowers_le, baerLocalComplementGen_def,
      mk_mem_baerSylowSubgroup_iff]
    exact sl2ZModThreeI_mem_sl2ZModThreeQuaternionSubgroup
  · intro g hg
    obtain ⟨x, hx, z, rfl⟩ := mem_baerSylowSubgroup_iff.mp hg
    have hx_mem : ((x, (1 : Multiplicative (ZMod 4))) : BaerGroup) ∈
        baerKernel ⊔ baerLocalComplement :=
      Subgroup.mem_sup_left (mk_mem_baerKernel_iff.mpr ⟨hx, one_pow 2⟩)
    have hIinv_mem : ((sl2ZModThreeI⁻¹, (1 : Multiplicative (ZMod 4))) : BaerGroup) ∈
        baerKernel ⊔ baerLocalComplement :=
      Subgroup.mem_sup_left (mk_mem_baerKernel_iff.mpr
        ⟨sl2ZModThreeQuaternionSubgroup.inv_mem sl2ZModThreeI_mem_sl2ZModThreeQuaternionSubgroup,
          one_pow 2⟩)
    have hgen_mem : (((1 : SL(2, ZMod 3)), Multiplicative.ofAdd (1 : ZMod 4)) : BaerGroup) ∈
        baerKernel ⊔ baerLocalComplement := by
      have hmul : (((1 : SL(2, ZMod 3)), Multiplicative.ofAdd (1 : ZMod 4)) : BaerGroup) =
          ((sl2ZModThreeI⁻¹, (1 : Multiplicative (ZMod 4))) : BaerGroup) *
            baerLocalComplementGen := by
        rw [baerLocalComplementGen_def, ← QuotientGroup.mk_mul, Prod.mk_mul_mk, inv_mul_cancel,
          one_mul]
      rw [hmul]
      exact mul_mem hIinv_mem (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))
    have hz_pow : (Multiplicative.ofAdd (1 : ZMod 4)) ^ (Multiplicative.toAdd z).val = z :=
      (by clear * -; decide : ∀ w : Multiplicative (ZMod 4),
        (Multiplicative.ofAdd 1) ^ (Multiplicative.toAdd w).val = w) z
    have h1z : (((1 : SL(2, ZMod 3)), z) : BaerGroup) =
        (((1 : SL(2, ZMod 3)), Multiplicative.ofAdd (1 : ZMod 4)) : BaerGroup) ^
          (Multiplicative.toAdd z).val := by
      rw [← QuotientGroup.mk_pow, Prod.pow_mk, one_pow, hz_pow]
    have hz_mem : (((1 : SL(2, ZMod 3)), z) : BaerGroup) ∈ baerKernel ⊔ baerLocalComplement :=
      h1z ▸ pow_mem hgen_mem _
    have hsplit : ((x, z) : BaerGroup) =
        ((x, (1 : Multiplicative (ZMod 4))) : BaerGroup) *
          (((1 : SL(2, ZMod 3)), z) : BaerGroup) := by
      rw [← QuotientGroup.mk_mul, Prod.mk_mul_mk, mul_one, one_mul]
    rw [hsplit]
    exact mul_mem hx_mem hz_mem

/-- `baerLocalComplement` is a local complement of `baerKernel` inside the Sylow `2`-subgroup
`baerSylow`. -/
theorem isLocalComplement_baerKernel :
    baerKernel.IsLocalComplement baerLocalComplement baerSylow :=
  ⟨baerKernel_inf_baerLocalComplement, baerKernel_sup_baerLocalComplement⟩

/-! ### Absence of a global complement in `BaerGroup` -/

/-- Two cosets `(x : BaerGroup)` and `(y : BaerGroup)` commute in `BaerGroup` if and only if
their first coordinates commute in `SL(2, ZMod 3)`. -/
theorem commute_mk_baerGroup_iff {x y : SL(2, ZMod 3) × Multiplicative (ZMod 4)} :
    Commute (x : BaerGroup) (y : BaerGroup) ↔ Commute x.1 y.1 := by
  rcases x with ⟨A, z⟩
  rcases y with ⟨B, w⟩
  rw [← commutatorElement_eq_one_iff_commute, ← commutatorElement_eq_one_iff_commute]
  change QuotientGroup.mk' baerCentralSubgroup ⁅(A, z), (B, w)⁆ = 1 ↔ _
  have hprod : ⁅(A, z), (B, w)⁆ = (⁅A, B⁆, 1) := by
    apply Prod.ext
    · rfl
    · exact commutatorElement_eq_one_iff_mul_comm.mpr (mul_comm z w)
  rw [hprod, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, mem_baerCentralSubgroup_iff]
  refine ⟨?_, fun h => Or.inl (Prod.ext h rfl)⟩
  rintro (h1 | hgen)
  · exact congrArg Prod.fst h1
  · exfalso
    have hsnd : (1 : Multiplicative (ZMod 4)) = Multiplicative.ofAdd 2 := congrArg Prod.snd hgen
    revert hsnd; decide

/-- Any involution in `BaerGroup` outside `baerKernel` lifts only to pairs `(A, z)` whose first
coordinate is a non-central element of `TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
private theorem mem_quaternion_and_ne_pm_one_of_sq_eq_one {A : SL(2, ZMod 3)}
    {z : Multiplicative (ZMod 4)} (hsq : ((A, z) : BaerGroup) ^ 2 = 1)
    (hnot : ((A, z) : BaerGroup) ∉ baerKernel) :
    A ∈ sl2ZModThreeQuaternionSubgroup ∧ A ≠ 1 ∧ A ≠ -1 := by
  rw [← QuotientGroup.mk_pow, sq, Prod.mk_mul_mk, ← sq, ← sq, QuotientGroup.eq_one_iff,
    mem_baerCentralSubgroup_iff] at hsq
  rcases hsq with h1 | hgen
  · exfalso
    have hA2 : A ^ 2 = 1 := congrArg Prod.fst h1
    have hA : A ∈ sl2ZModThreeQuaternionSubgroup :=
      mem_sl2ZModThreeQuaternionSubgroup_iff.mpr
        (by rw [(by decide : 4 = 2 * 2), pow_mul, hA2, one_pow])
    exact hnot (mk_mem_baerKernel_iff.mpr ⟨hA, congrArg Prod.snd h1⟩)
  · have hA2 : A ^ 2 = -1 := congrArg Prod.fst hgen
    have hneg_ne : (-1 : SL(2, ZMod 3)) ≠ 1 := by decide
    refine ⟨mem_sl2ZModThreeQuaternionSubgroup_iff.mpr
      (by rw [(by decide : 4 = 2 * 2), pow_mul, hA2, neg_one_sq]), ?_, ?_⟩
    · rintro rfl
      exact hneg_ne (by simpa using hA2.symm)
    · rintro rfl
      exact hneg_ne (by simpa using hA2.symm)

/-- **Baer's counterexample.** Despite admitting a local complement in the Sylow `2`-subgroup
`baerSylow` of coprime index `3`, the normal quaternion `2`-subgroup `baerKernel` has no global
complement in `BaerGroup`. -/
theorem not_exists_isComplement'_baerKernel :
    ¬ ∃ D : Subgroup BaerGroup, baerKernel.IsComplement' D := by
  rintro ⟨D, hD⟩
  have hcardD : Nat.card D = 6 := by
    have h := hD.card_mul_card
    rw [card_baerKernel, card_baerGroup] at h
    omega
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' (G := D) 2 (by rw [hcardD]; decide)
  obtain ⟨t, ht⟩ := exists_prime_orderOf_dvd_card' (G := D) 3 (by rw [hcardD]; decide)
  have hdisj : baerKernel ⊓ D = ⊥ := disjoint_iff.mp hD.disjoint
  have hu_ord : orderOf (u : BaerGroup) = 2 := (Subgroup.orderOf_coe u).trans hu
  have ht_ord : orderOf (t : BaerGroup) = 3 := (Subgroup.orderOf_coe t).trans ht
  have hu_notMem : (u : BaerGroup) ∉ baerKernel := by
    intro huK
    have hu1 : (u : BaerGroup) = 1 := Subgroup.mem_bot.mp (hdisj ▸ ⟨huK, u.2⟩)
    rw [hu1, orderOf_one] at hu_ord
    omega
  have ht_notMem : (t : BaerGroup) ∉ baerSylowSubgroup := by
    intro htS
    have hordS : orderOf (⟨t, htS⟩ : baerSylowSubgroup) = 3 :=
      (Subgroup.orderOf_mk (t : BaerGroup) htS).trans ht_ord
    have hdvd := orderOf_dvd_natCard (x := (⟨t, htS⟩ : baerSylowSubgroup))
    rw [hordS, card_baerSylowSubgroup] at hdvd
    omega
  have hcomm_tu : Commute (t : BaerGroup) (u : BaerGroup) := by
    apply commutatorElement_eq_one_iff_commute.mp
    have hmemD : ⁅(t : BaerGroup), (u : BaerGroup)⁆ ∈ D :=
      D.commutator_le_self (Subgroup.commutator_mem_commutator t.2 u.2)
    exact Subgroup.mem_bot.mp (hdisj ▸ ⟨commutatorElement_mem_baerKernel t u, hmemD⟩)
  obtain ⟨⟨A, z⟩, hu_eq⟩ := QuotientGroup.mk_surjective (u : BaerGroup)
  obtain ⟨⟨B, w⟩, ht_eq⟩ := QuotientGroup.mk_surjective (t : BaerGroup)
  have hu_sq : ((A, z) : BaerGroup) ^ 2 = 1 :=
    (congrArg (· ^ 2) hu_eq).trans
      ((congrArg ((u : BaerGroup) ^ ·) hu_ord).symm.trans (pow_orderOf_eq_one (u : BaerGroup)))
  obtain ⟨hAQ, hA1, hAneg⟩ :=
    mem_quaternion_and_ne_pm_one_of_sq_eq_one hu_sq (hu_eq.symm ▸ hu_notMem)
  have hcomm_BA : Commute B A :=
    commute_mk_baerGroup_iff.mp (ht_eq.symm ▸ hu_eq.symm ▸ hcomm_tu)
  have hBQ : B ∈ sl2ZModThreeQuaternionSubgroup :=
    mem_sl2ZModThreeQuaternionSubgroup_of_commute hAQ hA1 hAneg hcomm_BA
  exact ht_notMem (ht_eq ▸ mk_mem_baerSylowSubgroup_iff.mpr hBQ)

/-- **Non-abelian sharpness of Gaschütz's splitting theorem and Sylow complement detection.** There
exists a finite solvable group `G` with a non-abelian normal `2`-subgroup `N` that has a local
complement in a Sylow `2`-subgroup `P` of index coprime to `|N|`, yet admits no global complement in
`G`. -/
theorem exists_nonabelian_counterexample_gaschutz :
    ∃ (G : Type) (_ : Group G) (_ : Finite G) (_ : Group.IsSolvable G)
      (N : Subgroup G) (_ : N.Normal) (P : Sylow 2 G) (K : Subgroup G),
      IsPGroup 2 N ∧ ¬ IsMulCommutative N ∧
        Nat.Coprime (P : Subgroup G).index (Nat.card N) ∧
        N.IsLocalComplement K P ∧ ¬ ∃ D : Subgroup G, N.IsComplement' D :=
  ⟨BaerGroup, inferInstance, inferInstance, inferInstance, baerKernel, inferInstance, baerSylow,
    baerLocalComplement, isPGroup_two_baerKernel, not_isMulCommutative_baerKernel,
    coprime_index_baerSylow_card_baerKernel, isLocalComplement_baerKernel,
    not_exists_isComplement'_baerKernel⟩

end TauCeti.Examples.BaerCounterexample
