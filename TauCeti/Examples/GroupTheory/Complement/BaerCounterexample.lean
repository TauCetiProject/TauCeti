/-!
# Non-splitting extension classes and Baer's counterexample to Gaschütz's theorem

This file illustrates the splitting criteria of
`TauCeti.GroupTheory.GroupExtension.Quotient.Cohomology`, `TauCeti.GroupTheory.Complement.Gaschutz`,
and `TauCeti.GroupTheory.Complement.Sylow` on explicit extensions and constructs Baer's non-abelian
counterexample to Gaschütz's splitting theorem.

## Cohomological extension classes

Through `Subgroup.exists_complement_iff_cohomologyClass_eq_zero`, the quotient extension class in
`H²(G ⧸ N, N)` vanishes for the rotation subgroup of `DihedralGroup n` at every `n`
(`TauCeti.cohomologyClass_dihedralRotations_eq_zero`, including `D₈` at `n = 4` and `V₄` at
`n = 2`), whereas it is nonzero for the rotation subgroup of `QuaternionGroup (2 ^ k)` at every
`k` (`TauCeti.cohomologyClass_quaternionRotations_ne_zero`, including `Q₈` at `k = 1` and `C₄` at
`k = 0`) and for the central subgroup `{±1}` in `QuaternionGroup (2 ^ k)` (`k ≠ 0`) and in
`SL(2, ZMod 3)` (`TauCeti.cohomologyClass_center_quaternionGroup_ne_zero`,
`TauCeti.cohomologyClass_center_sl2_zmod_three_ne_zero`).

## Baer's central-product counterexample

`TauCeti.BaerCentralProduct` is the central product `(SL(2, ZMod 3) × C₄) ⧸ ⟨(-1, 2)⟩` of order
`48`. The natural homomorphism from `SL(2, ZMod 3)` embeds the quaternion subgroup `Q₈` as a
normal `2`-subgroup `TauCeti.baerQuaternionSubgroup` inside the unique Sylow `2`-subgroup
`TauCeti.baerSylowTwo` of order `16` and index `3` (coprime to `|Q₈| = 8`). The order-two subgroup
`TauCeti.baerLocalComplement` generated by the image of `(I, 1)` is a local complement of
`TauCeti.baerQuaternionSubgroup` inside `TauCeti.baerSylowSubgroup`
(`TauCeti.isLocalComplement_baerQuaternionSubgroup`), yet `TauCeti.baerQuaternionSubgroup` has no
complement in `TauCeti.BaerCentralProduct`
(`TauCeti.not_exists_isComplement'_baerQuaternionSubgroup`). This shows
(`TauCeti.exists_nonabelian_counterexample_gaschutz`) that the commutativity assumption
`[IsMulCommutative N]` in `Subgroup.IsLocalComplement.exists_isComplement'_of_coprime_index` and
`IsPGroup.exists_isComplement'_iff_sylow` cannot be dropped.

## References

* R. Baer, *Verallgemeinerung eines Satzes von L. Hall*, Abh. Math. Sem. Univ. Hamburg 29 (1966),
  135–149.
* B. Sambale, *On the converse of Gaschütz' complement theorem*, arXiv:2303.00254, Section 1.
-/

public section

open scoped IsMulCommutative MatrixGroups

namespace TauCeti

/-! ## Cohomological extension classes -/

section ExtensionClasses

attribute [local instance] Subgroup.quotientConjugationAction

/-- The quotient extension class of the cyclic rotation subgroup in `DihedralGroup n` vanishes in
`H²` at every `n : ℕ` (including `D₈` at `n = 4` and `V₄` at `n = 2`), reflecting the semidirect
decomposition `DihedralGroup n = C_n ⋊ C₂`. -/
theorem cohomologyClass_dihedralRotations_eq_zero (n : ℕ)
    (σ : (dihedralRotations n).quotientExtension.Section) (hσ : σ 1 = 1) :
    (GroupExtension.factorSet σ hσ
      (dihedralRotations n).quotientExtension_inducesAction).cohomologyClass = 0 :=
  ((dihedralRotations n).exists_complement_iff_cohomologyClass_eq_zero σ hσ).mp
    ⟨_, isComplement'_dihedralRotations_zpowers_sr 0⟩

/-- The quotient extension class of the cyclic rotation subgroup in `QuaternionGroup (2 ^ k)` is
nonzero in `H²` at every `k : ℕ` (including `C₄` at `k = 0` and `Q₈` at `k = 1`). -/
theorem cohomologyClass_quaternionRotations_ne_zero (k : ℕ)
    (σ : (quaternionRotations (2 ^ k)).quotientExtension.Section) (hσ : σ 1 = 1) :
    (GroupExtension.factorSet σ hσ
      (quaternionRotations (2 ^ k)).quotientExtension_inducesAction).cohomologyClass ≠ 0 :=
  mt ((quaternionRotations (2 ^ k)).exists_complement_iff_cohomologyClass_eq_zero σ hσ).mpr
    (not_exists_isComplement'_quaternionRotations k)

/-- For `k ≠ 0`, the central quotient extension of `QuaternionGroup (2 ^ k)` by its order-two
centre has nonzero class in `H²` (in particular for `Q₈` at `k = 1`, where the quotient is `V₄`). -/
theorem cohomologyClass_center_quaternionGroup_ne_zero {k : ℕ} (hk : k ≠ 0)
    (σ : (Subgroup.center (QuaternionGroup (2 ^ k))).quotientExtension.Section) (hσ : σ 1 = 1) :
    (GroupExtension.factorSet σ hσ
      (Subgroup.center (QuaternionGroup (2 ^ k))).quotientExtension_inducesAction).cohomologyClass ≠
        0 :=
  mt ((Subgroup.center (QuaternionGroup (2 ^ k))).exists_complement_iff_cohomologyClass_eq_zero
    σ hσ).mpr (not_exists_isComplement'_center_quaternionGroup hk)

/-- The central extension `1 → {±1} → SL(2, ZMod 3) → PSL(2, ZMod 3) → 1` has nonzero cohomology
class in `H²`. -/
theorem cohomologyClass_center_sl2_zmod_three_ne_zero
    (σ : (Subgroup.center SL(2, ZMod 3)).quotientExtension.Section) (hσ : σ 1 = 1) :
    (GroupExtension.factorSet σ hσ
      (Subgroup.center SL(2, ZMod 3)).quotientExtension_inducesAction).cohomologyClass ≠ 0 :=
  mt ((Subgroup.center SL(2, ZMod 3)).exists_complement_iff_cohomologyClass_eq_zero σ hσ).mpr
    not_exists_isComplement'_center_sl2_zmod_three

end ExtensionClasses

/-! ## Baer's central product of `SL(2, ZMod 3)` and `C₄` -/

/-- The diagonal central involution `(-1, 2)` in `SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
def baerCentralGen : SL(2, ZMod 3) × Multiplicative (ZMod 4) :=
  (-1, Multiplicative.ofAdd 2)

/-- `TauCeti.baerCentralGen` squares to `1`. -/
@[simp]
theorem baerCentralGen_sq : baerCentralGen ^ 2 = 1 :=
  Prod.ext neg_one_sq (by decide)

/-- `TauCeti.baerCentralGen` is distinct from `1`. -/
theorem baerCentralGen_ne_one : baerCentralGen ≠ 1 :=
  fun h => sl2_zmod_three_neg_one_ne_one (congrArg Prod.fst h)

/-- `TauCeti.baerCentralGen` has order `2`. -/
@[simp]
theorem orderOf_baerCentralGen : orderOf baerCentralGen = 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact orderOf_eq_prime baerCentralGen_sq baerCentralGen_ne_one

/-- `TauCeti.baerCentralGen` is central in `SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
theorem baerCentralGen_mem_center :
    baerCentralGen ∈ Subgroup.center (SL(2, ZMod 3) × Multiplicative (ZMod 4)) :=
  Subgroup.mem_center_iff.mpr fun ⟨_, c⟩ => Prod.ext (by simp [baerCentralGen]) (mul_comm c _)

/-- The central subgroup of order two generated by `(-1, 2)` in
`SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
def baerCentralKernel : Subgroup (SL(2, ZMod 3) × Multiplicative (ZMod 4)) :=
  Subgroup.zpowers baerCentralGen

/-- `TauCeti.baerCentralKernel` is normal, as a central subgroup. -/
instance baerCentralKernel_normal : baerCentralKernel.Normal :=
  Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr baerCentralGen_mem_center)

/-- `TauCeti.baerCentralKernel` consists of `1` and `TauCeti.baerCentralGen`. -/
@[simp]
theorem mem_baerCentralKernel_iff {x : SL(2, ZMod 3) × Multiplicative (ZMod 4)} :
    x ∈ baerCentralKernel ↔ x = 1 ∨ x = baerCentralGen :=
  Subgroup.mem_zpowers_iff_of_sq_eq_one baerCentralGen_sq

/-- `TauCeti.baerCentralKernel` has cardinality `2`. -/
theorem natCard_baerCentralKernel : Nat.card baerCentralKernel = 2 := by
  rw [baerCentralKernel, Nat.card_zpowers, orderOf_baerCentralGen]

/-- **Baer's central product** `(SL(2, ZMod 3) × C₄) ⧸ ⟨(-1, 2)⟩`, a finite group of order `48`. -/
abbrev BaerCentralProduct : Type :=
  (SL(2, ZMod 3) × Multiplicative (ZMod 4)) ⧸ baerCentralKernel

/-- `TauCeti.BaerCentralProduct` has cardinality `48`. -/
@[simp]
theorem natCard_baerCentralProduct : Nat.card BaerCentralProduct = 48 := by
  have h := Subgroup.card_eq_card_quotient_mul_card_subgroup baerCentralKernel
  have hprod : Nat.card (SL(2, ZMod 3) × Multiplicative (ZMod 4)) = 96 := by
    rw [Nat.card_prod, natCard_sl2_zmod_three, Nat.card_eq_fintype_card,
      Fintype.card_multiplicative, ZMod.card]
  rw [hprod, natCard_baerCentralKernel] at h
  change 96 = Nat.card BaerCentralProduct * 2 at h
  omega

/-- The canonical embedding of `SL(2, ZMod 3)` into `TauCeti.BaerCentralProduct`. -/
def baerLeftHom : SL(2, ZMod 3) →* BaerCentralProduct :=
  (QuotientGroup.mk' baerCentralKernel).comp (MonoidHom.inl _ _)

/-- `TauCeti.baerLeftHom` sends `g` to the class of `(g, 1)` in `TauCeti.BaerCentralProduct`. -/
@[simp]
theorem baerLeftHom_apply (g : SL(2, ZMod 3)) :
    baerLeftHom g = QuotientGroup.mk (g, 1) :=
  (rfl)

/-- `TauCeti.baerLeftHom` is injective. -/
theorem baerLeftHom_injective : Function.Injective baerLeftHom := by
  rw [injective_iff_map_eq_one]
  intro g hg
  rw [baerLeftHom_apply, QuotientGroup.eq_one_iff, mem_baerCentralKernel_iff] at hg
  rcases hg with h1 | h2
  · exact congrArg Prod.fst h1
  · have hsnd : (1 : Multiplicative (ZMod 4)) = Multiplicative.ofAdd 2 := congrArg Prod.snd h2
    exact absurd hsnd (by decide)

/-- The normal quaternion subgroup `Q₈` inside `TauCeti.BaerCentralProduct`, embedded via
`TauCeti.baerLeftHom`. -/
def baerQuaternionSubgroup : Subgroup BaerCentralProduct :=
  sl2ZModThreeQuaternionSubgroup.map baerLeftHom

/-- Membership in `TauCeti.baerQuaternionSubgroup` is being the image under `TauCeti.baerLeftHom`
of an element of `TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
theorem mem_baerQuaternionSubgroup_iff {x : BaerCentralProduct} :
    x ∈ baerQuaternionSubgroup ↔
      ∃ q ∈ sl2ZModThreeQuaternionSubgroup, baerLeftHom q = x :=
  Iff.rfl

private theorem baerQuaternionSubgroup_eq_map_prod_bot :
    baerQuaternionSubgroup =
      (sl2ZModThreeQuaternionSubgroup.prod ⊥).map (QuotientGroup.mk' baerCentralKernel) := by
  rw [baerQuaternionSubgroup, baerLeftHom, ← Subgroup.map_map]
  congr 1
  ext ⟨g, c⟩
  simp only [Subgroup.mem_map, MonoidHom.inl_apply, Prod.mk.injEq, Subgroup.mem_prod,
    Subgroup.mem_bot]
  exact ⟨fun ⟨_, hx, hgx, h1c⟩ => ⟨hgx ▸ hx, h1c.symm⟩, fun ⟨hg, hc⟩ => ⟨g, hg, rfl, hc.symm⟩⟩

/-- `TauCeti.baerQuaternionSubgroup` is normal in `TauCeti.BaerCentralProduct`. -/
instance baerQuaternionSubgroup_normal : baerQuaternionSubgroup.Normal := by
  rw [baerQuaternionSubgroup_eq_map_prod_bot]
  exact Subgroup.Normal.map inferInstance _ (QuotientGroup.mk'_surjective _)

/-- `TauCeti.baerQuaternionSubgroup` is isomorphic to `QuaternionGroup 2` (`Q₈`). -/
noncomputable def baerQuaternionEquiv : QuaternionGroup 2 ≃* baerQuaternionSubgroup :=
  sl2ZModThreeQuaternionEquiv.trans
    (sl2ZModThreeQuaternionSubgroup.equivMapOfInjective baerLeftHom baerLeftHom_injective)

/-- `TauCeti.baerQuaternionSubgroup` has cardinality `8`. -/
@[simp]
theorem natCard_baerQuaternionSubgroup : Nat.card baerQuaternionSubgroup = 8 := by
  rw [Nat.card_congr baerQuaternionEquiv.symm.toEquiv, natCard_quaternionGroup]

/-- `TauCeti.baerQuaternionSubgroup` is a `2`-group. -/
theorem isPGroup_baerQuaternionSubgroup : IsPGroup 2 baerQuaternionSubgroup :=
  IsPGroup.of_card (show Nat.card baerQuaternionSubgroup = 2 ^ 3 by
    rw [natCard_baerQuaternionSubgroup]; rfl)

/-- `TauCeti.baerQuaternionSubgroup` is not commutative. -/
theorem not_isMulCommutative_baerQuaternionSubgroup :
    ¬ IsMulCommutative baerQuaternionSubgroup := by
  intro h
  have : IsMulCommutative (QuaternionGroup 2) :=
    ⟨⟨fun x y => baerQuaternionEquiv.injective (by rw [map_mul, map_mul, mul_comm'])⟩⟩
  exact not_isMulCommutative_quaternionGroup (by decide) this

private theorem mk_ofAdd_two_eq_baerLeftHom_neg (g : SL(2, ZMod 3)) :
    (QuotientGroup.mk (g, Multiplicative.ofAdd 2) : BaerCentralProduct) = baerLeftHom (-g) := by
  rw [baerLeftHom_apply, QuotientGroup.eq, mem_baerCentralKernel_iff]
  refine Or.inr (Prod.ext ?_ ?_)
  · simp [baerCentralGen]
  · change (Multiplicative.ofAdd (2 : ZMod 4))⁻¹ * 1 = Multiplicative.ofAdd 2
    decide

private theorem snd_eq_of_mk_mem_baerQuaternionSubgroup {g : SL(2, ZMod 3)}
    {c : Multiplicative (ZMod 4)}
    (h : (QuotientGroup.mk (g, c) : BaerCentralProduct) ∈ baerQuaternionSubgroup) :
    c = 1 ∨ c = Multiplicative.ofAdd 2 := by
  obtain ⟨q, -, hq⟩ := h
  rw [baerLeftHom_apply, QuotientGroup.eq, mem_baerCentralKernel_iff] at hq
  rcases hq with h1 | h2
  · exact Or.inl (by simpa using congrArg Prod.snd h1)
  · exact Or.inr (by simpa [baerCentralGen] using congrArg Prod.snd h2)

/-! ### The unique Sylow `2`-subgroup and its local complement -/

/-- The normal subgroup `(Q₈ × C₄) ⧸ ⟨(-1, 2)⟩` of order `16` and index `3` in
`TauCeti.BaerCentralProduct`. -/
def baerSylowSubgroup : Subgroup BaerCentralProduct :=
  (sl2ZModThreeQuaternionSubgroup.prod ⊤).map (QuotientGroup.mk' baerCentralKernel)

/-- `TauCeti.baerSylowSubgroup` is normal in `TauCeti.BaerCentralProduct`. -/
instance baerSylowSubgroup_normal : baerSylowSubgroup.Normal :=
  Subgroup.Normal.map inferInstance _ (QuotientGroup.mk'_surjective _)

/-- `TauCeti.baerQuaternionSubgroup` is contained in `TauCeti.baerSylowSubgroup`. -/
theorem baerQuaternionSubgroup_le_baerSylowSubgroup :
    baerQuaternionSubgroup ≤ baerSylowSubgroup := by
  rw [baerQuaternionSubgroup_eq_map_prod_bot]
  exact Subgroup.map_mono (Subgroup.prod_mono le_rfl bot_le)

private theorem comap_mk'_baerSylowSubgroup :
    baerSylowSubgroup.comap (QuotientGroup.mk' baerCentralKernel) =
      sl2ZModThreeQuaternionSubgroup.prod ⊤ := by
  refine Subgroup.comap_map_eq_self ?_
  rw [QuotientGroup.ker_mk', baerCentralKernel, Subgroup.zpowers_le, Subgroup.mem_prod]
  exact ⟨neg_one_mem_sl2ZModThreeQuaternionSubgroup, Subgroup.mem_top _⟩

/-- A coset `[(g, c)]` belongs to `TauCeti.baerSylowSubgroup` if and only if `g` belongs to
`TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
@[simp]
theorem mk_mem_baerSylowSubgroup_iff {g : SL(2, ZMod 3)} {c : Multiplicative (ZMod 4)} :
    (QuotientGroup.mk (g, c) : BaerCentralProduct) ∈ baerSylowSubgroup ↔
      g ∈ sl2ZModThreeQuaternionSubgroup := by
  change (g, c) ∈ baerSylowSubgroup.comap (QuotientGroup.mk' baerCentralKernel) ↔ _
  rw [comap_mk'_baerSylowSubgroup, Subgroup.mem_prod]
  simp

/-- `TauCeti.baerSylowSubgroup` has index `3` in `TauCeti.BaerCentralProduct`. -/
@[simp]
theorem index_baerSylowSubgroup : baerSylowSubgroup.index = 3 := by
  rw [← baerSylowSubgroup.index_comap_of_surjective (QuotientGroup.mk'_surjective _),
    comap_mk'_baerSylowSubgroup]
  let P0 := sl2ZModThreeQuaternionSubgroup.prod (⊤ : Subgroup (Multiplicative (ZMod 4)))
  have h := P0.card_mul_index
  have hsub : Nat.card P0 = 32 := by
    have heq := Nat.card_congr
      (Subgroup.prodEquiv sl2ZModThreeQuaternionSubgroup
        (⊤ : Subgroup (Multiplicative (ZMod 4)))).toEquiv
    rw [heq, Nat.card_prod, natCard_sl2ZModThreeQuaternionSubgroup, Subgroup.card_top,
      Nat.card_eq_fintype_card, Fintype.card_multiplicative, ZMod.card]
  have hprod : Nat.card (SL(2, ZMod 3) × Multiplicative (ZMod 4)) = 96 := by
    rw [Nat.card_prod, natCard_sl2_zmod_three, Nat.card_eq_fintype_card,
      Fintype.card_multiplicative, ZMod.card]
  rw [hsub, hprod] at h
  dsimp only [P0] at h
  omega

/-- `TauCeti.baerSylowSubgroup` has cardinality `16`. -/
@[simp]
theorem natCard_baerSylowSubgroup : Nat.card baerSylowSubgroup = 16 := by
  have h := baerSylowSubgroup.card_mul_index
  rw [index_baerSylowSubgroup, natCard_baerCentralProduct] at h
  omega

/-- `TauCeti.baerSylowSubgroup` is a `2`-group. -/
theorem isPGroup_baerSylowSubgroup : IsPGroup 2 baerSylowSubgroup :=
  IsPGroup.of_card (show Nat.card baerSylowSubgroup = 2 ^ 4 by
    rw [natCard_baerSylowSubgroup]; rfl)

/-- `TauCeti.baerSylowSubgroup` packaged as the Sylow `2`-subgroup of
`TauCeti.BaerCentralProduct`. -/
def baerSylowTwo : Sylow 2 BaerCentralProduct :=
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  isPGroup_baerSylowSubgroup.toSylow (by rw [index_baerSylowSubgroup]; decide)

/-- The underlying subgroup of `TauCeti.baerSylowTwo` is `TauCeti.baerSylowSubgroup`. -/
@[simp]
theorem coe_baerSylowTwo : (baerSylowTwo : Subgroup BaerCentralProduct) = baerSylowSubgroup := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact IsPGroup.toSylow_coe _ _

/-- `TauCeti.BaerCentralProduct` has a unique Sylow `2`-subgroup. -/
noncomputable instance instUniqueSylowTwoBaerCentralProduct :
    Unique (Sylow 2 BaerCentralProduct) :=
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  baerSylowTwo.unique_of_normal (coe_baerSylowTwo.symm ▸ baerSylowSubgroup_normal)

/-- The involution `[(I, 1)]` in `TauCeti.BaerCentralProduct`: `I ^ 2 = -1` cancels against
`1 + 1 = 2` in `baerCentralKernel`. -/
def baerLocalGen : BaerCentralProduct :=
  QuotientGroup.mk (sl2ZModThreeI, Multiplicative.ofAdd 1)

/-- `TauCeti.baerLocalGen` squares to `1`. -/
@[simp]
theorem baerLocalGen_sq : baerLocalGen ^ 2 = 1 := by
  rw [baerLocalGen, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, mem_baerCentralKernel_iff]
  exact Or.inr (Prod.ext sl2ZModThreeI_sq (by decide))

/-- `TauCeti.baerLocalGen` does not belong to `TauCeti.baerQuaternionSubgroup`. -/
theorem baerLocalGen_notMem_baerQuaternionSubgroup :
    baerLocalGen ∉ baerQuaternionSubgroup := by
  intro h
  rcases snd_eq_of_mk_mem_baerQuaternionSubgroup h with h1 | h2
  · exact absurd h1 (by decide)
  · exact absurd h2 (by decide)

/-- `TauCeti.baerLocalGen` has exact order `2`. -/
@[simp]
theorem orderOf_baerLocalGen : orderOf baerLocalGen = 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine orderOf_eq_prime baerLocalGen_sq fun h => baerLocalGen_notMem_baerQuaternionSubgroup ?_
  rw [h]
  exact one_mem _

/-- The order-two subgroup generated by `TauCeti.baerLocalGen`, a local complement of
`TauCeti.baerQuaternionSubgroup` in `TauCeti.baerSylowSubgroup`. -/
def baerLocalComplement : Subgroup BaerCentralProduct :=
  Subgroup.zpowers baerLocalGen

/-- `TauCeti.baerLocalComplement` has cardinality `2`. -/
@[simp]
theorem natCard_baerLocalComplement : Nat.card baerLocalComplement = 2 := by
  rw [baerLocalComplement, Nat.card_zpowers, orderOf_baerLocalGen]

/-- `TauCeti.baerLocalComplement` lies inside `TauCeti.baerSylowSubgroup`. -/
theorem baerLocalComplement_le_baerSylowSubgroup :
    baerLocalComplement ≤ baerSylowSubgroup := by
  rw [baerLocalComplement, Subgroup.zpowers_le, baerLocalGen, mk_mem_baerSylowSubgroup_iff]
  exact sl2ZModThreeI_mem_quaternionSubgroup

/-- **Local splitting in the Sylow `2`-subgroup.** `TauCeti.baerLocalComplement` complements
`TauCeti.baerQuaternionSubgroup` inside `TauCeti.baerSylowSubgroup`. -/
theorem isLocalComplement_baerQuaternionSubgroup :
    baerQuaternionSubgroup.IsLocalComplement baerLocalComplement baerSylowSubgroup := by
  rw [Subgroup.isLocalComplement_iff_isComplement'_subgroupOf
    baerQuaternionSubgroup_le_baerSylowSubgroup baerLocalComplement_le_baerSylowSubgroup]
  refine Subgroup.isComplement'_of_card_mul_and_disjoint ?_ ?_
  · have h1 := Nat.card_congr (baerQuaternionSubgroup.subgroupOfEquivOfLe
      baerQuaternionSubgroup_le_baerSylowSubgroup).toEquiv
    have h2 := Nat.card_congr (baerLocalComplement.subgroupOfEquivOfLe
      baerLocalComplement_le_baerSylowSubgroup).toEquiv
    rw [h1, h2, natCard_baerQuaternionSubgroup, natCard_baerLocalComplement,
      natCard_baerSylowSubgroup]
  · rw [Subgroup.disjoint_def]
    rintro ⟨x, hxS⟩ hxQ hxK
    rw [Subgroup.mem_subgroupOf] at hxQ hxK
    rcases (Subgroup.mem_zpowers_iff_of_sq_eq_one baerLocalGen_sq).mp hxK with rfl | rfl
    · rfl
    · exact absurd hxQ baerLocalGen_notMem_baerQuaternionSubgroup

/-! ### Absence of a global complement -/

private theorem lift_involution_notMem_baerQuaternionSubgroup {w : BaerCentralProduct}
    (hwS : w ∈ baerSylowSubgroup) (hw2 : w ^ 2 = 1) (hwQ : w ∉ baerQuaternionSubgroup) :
    ∃ (q : SL(2, ZMod 3)) (c : Multiplicative (ZMod 4)),
      w = QuotientGroup.mk (q, c) ∧ q ∈ sl2ZModThreeQuaternionSubgroup ∧ q ≠ 1 ∧ q ≠ -1 := by
  obtain ⟨⟨q, c⟩, rfl⟩ := QuotientGroup.mk_surjective w
  have hq : q ∈ sl2ZModThreeQuaternionSubgroup := mk_mem_baerSylowSubgroup_iff.mp hwS
  have hc0 : c ≠ 1 := by
    rintro rfl
    exact hwQ ⟨q, hq, rfl⟩
  have hc2' : c ≠ Multiplicative.ofAdd 2 := by
    rintro rfl
    rw [mk_ofAdd_two_eq_baerLeftHom_neg] at hwQ
    exact hwQ ⟨-q, by simpa using mul_mem neg_one_mem_sl2ZModThreeQuaternionSubgroup hq, rfl⟩
  have hc2 : c ^ 2 = Multiplicative.ofAdd 2 :=
    (by decide : ∀ d : Multiplicative (ZMod 4),
      d ≠ 1 → d ≠ Multiplicative.ofAdd 2 → d ^ 2 = Multiplicative.ofAdd 2) c hc0 hc2'
  have hpow : (q, c) ^ 2 = (q ^ 2, Multiplicative.ofAdd 2) := Prod.ext rfl hc2
  rw [← QuotientGroup.mk_pow, hpow, QuotientGroup.eq_one_iff, mem_baerCentralKernel_iff] at hw2
  have hq2 : q ^ 2 = -1 := by
    rcases hw2 with h1 | h2
    · have hsnd : Multiplicative.ofAdd (2 : ZMod 4) = 1 := congrArg Prod.snd h1
      exact absurd hsnd (by decide)
    · exact congrArg Prod.fst h2
  refine ⟨q, c, rfl, hq, ?_, ?_⟩ <;> rintro rfl <;>
    exact sl2_zmod_three_neg_one_ne_one (by simpa using hq2.symm)

private theorem conj_ne_of_notMem_baerSylowSubgroup {u : BaerCentralProduct}
    (huS : u ∉ baerSylowSubgroup) {q : SL(2, ZMod 3)} {c : Multiplicative (ZMod 4)}
    (hq : q ∈ sl2ZModThreeQuaternionSubgroup) (hq1 : q ≠ 1) (hqneg : q ≠ -1) :
    u * QuotientGroup.mk (q, c) * u⁻¹ ≠ QuotientGroup.mk (q, c) := by
  obtain ⟨⟨g, d⟩, rfl⟩ := QuotientGroup.mk_surjective u
  have hg : g ∉ sl2ZModThreeQuaternionSubgroup := mt mk_mem_baerSylowSubgroup_iff.mpr huS
  intro hconj_eq
  have hrel : ((g * q * g⁻¹)⁻¹ * q, (1 : Multiplicative (ZMod 4))) ∈ baerCentralKernel := by
    rw [← QuotientGroup.mk_inv (N := baerCentralKernel),
      ← QuotientGroup.mk_mul (N := baerCentralKernel),
      ← QuotientGroup.mk_mul (N := baerCentralKernel), QuotientGroup.eq] at hconj_eq
    simpa [mul_comm d c] using hconj_eq
  rcases mem_baerCentralKernel_iff.mp hrel with h1 | h2
  · exact (conj_ne_and_ne_neg_of_notMem_sl2ZModThreeQuaternionSubgroup hg hq hq1 hqneg).1
      (inv_mul_eq_one.mp (congrArg Prod.fst h1))
  · have hsnd : (1 : Multiplicative (ZMod 4)) = Multiplicative.ofAdd 2 := congrArg Prod.snd h2
    exact absurd hsnd (by decide)

/-- **Failure of global splitting in `TauCeti.BaerCentralProduct`.** Despite admitting a local
complement in the Sylow `2`-subgroup of index `3`, `TauCeti.baerQuaternionSubgroup` has no
complement in `TauCeti.BaerCentralProduct`. -/
theorem not_exists_isComplement'_baerQuaternionSubgroup :
    ¬ ∃ D : Subgroup BaerCentralProduct, baerQuaternionSubgroup.IsComplement' D := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rintro ⟨D, hD⟩
  have hcardD : Nat.card D = 6 := by
    have h := hD.card_mul_card
    rw [natCard_baerQuaternionSubgroup, natCard_baerCentralProduct] at h
    omega
  have hcardM : Nat.card (D ⊓ baerSylowSubgroup : Subgroup BaerCentralProduct) = 2 := by
    have h := (hD.isLocalComplement_inf baerQuaternionSubgroup_le_baerSylowSubgroup).card_mul_card
    rw [natCard_baerQuaternionSubgroup, natCard_baerSylowSubgroup] at h
    omega
  obtain ⟨w, hw_eq⟩ :=
    (D ⊓ baerSylowSubgroup).isCyclic_iff_exists_zpowers_eq.mp (isCyclic_of_prime_card hcardM)
  have hord : orderOf w = 2 := by rw [← Nat.card_zpowers, hw_eq]; exact hcardM
  have hwM : w ∈ D ⊓ baerSylowSubgroup := hw_eq ▸ Subgroup.mem_zpowers w
  have hw1 : w ≠ 1 := by rintro rfl; simp at hord
  have hwQ : w ∉ baerQuaternionSubgroup :=
    fun hQ => hw1 (Subgroup.disjoint_def.mp hD.disjoint hQ hwM.1)
  obtain ⟨q, c, rfl, hq, hq1, hqneg⟩ :=
    lift_involution_notMem_baerQuaternionSubgroup hwM.2
      (orderOf_dvd_iff_pow_eq_one.mp hord.dvd) hwQ
  have hnot_le : ¬ D ≤ baerSylowSubgroup := fun hle => by
    rw [inf_eq_left.mpr hle, hcardD] at hcardM; omega
  obtain ⟨u, huD, huS⟩ := Set.not_subset.mp hnot_le
  let w0 : BaerCentralProduct := QuotientGroup.mk (q, c)
  have hconj_mem : u * w0 * u⁻¹ ∈ Subgroup.zpowers w0 :=
    hw_eq.symm ▸ ⟨D.mul_mem (D.mul_mem huD hwM.1) (D.inv_mem huD),
      baerSylowSubgroup_normal.conj_mem _ hwM.2 _⟩
  rcases (Subgroup.mem_zpowers_iff_of_orderOf_eq_two hord).mp hconj_mem with h1 | h2
  · refine hw1 ?_
    calc w0 = u⁻¹ * (u * w0 * u⁻¹) * u := by group
      _ = 1 := by rw [h1]; group
  · exact conj_ne_of_notMem_baerSylowSubgroup huS hq hq1 hqneg h2

/-- **Baer's non-abelian counterexample to Gaschütz's splitting theorem and Sylow complement
detection.** There exists a finite group `G` of order `48`, a normal non-abelian `2`-subgroup
`N ≃* Q₈`, and a Sylow `2`-subgroup `P` of index `3` (coprime to `|N| = 8`) such that `N` admits a
local complement in `P` yet has no global complement in `G`. -/
theorem exists_nonabelian_counterexample_gaschutz :
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    ∃ (G : Type) (_ : Group G) (_ : Finite G) (N : Subgroup G) (_ : N.Normal)
      (P : Sylow 2 G) (K : Subgroup G),
      Nat.card G = 48 ∧
      Nonempty (QuaternionGroup 2 ≃* N) ∧
      ¬ IsMulCommutative N ∧
      IsPGroup 2 N ∧
      Nat.Coprime (P : Subgroup G).index (Nat.card N) ∧
      N.IsLocalComplement K P ∧
      ¬ ∃ D : Subgroup G, N.IsComplement' D := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine ⟨BaerCentralProduct, inferInstance, inferInstance, baerQuaternionSubgroup,
    inferInstance, baerSylowTwo, baerLocalComplement, natCard_baerCentralProduct,
    ⟨baerQuaternionEquiv⟩, not_isMulCommutative_baerQuaternionSubgroup,
    isPGroup_baerQuaternionSubgroup, ?_, ?_, not_exists_isComplement'_baerQuaternionSubgroup⟩
  · rw [coe_baerSylowTwo, index_baerSylowSubgroup, natCard_baerQuaternionSubgroup]
    decide
  · rw [coe_baerSylowTwo]
    exact isLocalComplement_baerQuaternionSubgroup

end TauCeti
