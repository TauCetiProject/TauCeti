import TauCeti.GroupTheory.SpecificGroups.Quaternion.Basic

/-!
# Baer's non-abelian counterexample to Gaschütz's splitting theorem

This file constructs Baer's central-product counterexample showing that the commutativity assumption
`[IsMulCommutative N]` in Gaschütz's splitting theorem (`TauCeti.GroupTheory.Complement.Gaschutz`)
and Sylow complement detection (`TauCeti.GroupTheory.Complement.Sylow`) cannot be dropped.

`TauCeti.BaerCentralProduct` is the central product `(SL(2, ZMod 3) × C₄) ⧸ ⟨(-1, 2)⟩` of order
`48`, presented abstractly via the quotient map `TauCeti.baerQuotientHom`, the canonical left and
right factor embeddings `TauCeti.baerLeftHom` and `TauCeti.baerRightHom`, and the central-product
identification `TauCeti.baerLeftHom_neg_one`.

`TauCeti.baerLeftHom` embeds the quaternion subgroup `Q₈` of `SL(2, ZMod 3)` as a normal
`2`-subgroup `TauCeti.baerQuaternionSubgroup` inside the unique Sylow `2`-subgroup
`TauCeti.baerSylowTwo` of order `16` and index `3` (coprime to `|Q₈| = 8`). The order-two subgroup
`TauCeti.baerLocalComplement` generated by `TauCeti.baerLocalGen` (`[(I, 1)]`) is a local complement
of `TauCeti.baerQuaternionSubgroup` inside `TauCeti.baerSylowSubgroup`
(`TauCeti.isLocalComplement_baerQuaternionSubgroup`), yet `TauCeti.baerQuaternionSubgroup` has no
complement in `TauCeti.BaerCentralProduct`
(`TauCeti.not_exists_isComplement'_baerQuaternionSubgroup`). This yields
`TauCeti.exists_not_isMulCommutative_and_isLocalComplement_and_not_exists_isComplement'`.

## Main definitions

* `TauCeti.BaerCentralProduct`: Baer's central product `(SL(2, ZMod 3) × C₄) ⧸ ⟨(-1, 2)⟩` of order
  `48`, with quotient projection `TauCeti.baerQuotientHom` and injective factor maps
  `TauCeti.baerLeftHom` and `TauCeti.baerRightHom`.
* `TauCeti.baerQuaternionSubgroup`, `TauCeti.baerQuaternionEquiv`: the normal `Q₈` subgroup of
  order `8` embedded via `baerLeftHom` and its isomorphism with `QuaternionGroup 2`.
* `TauCeti.baerSylowSubgroup`, `TauCeti.baerSylowTwo`: the unique Sylow `2`-subgroup of order `16`
  and index `3`.
* `TauCeti.baerLocalGen`, `TauCeti.baerLocalComplement`: the involution `[(I, 1)]` and the
  order-two subgroup it generates.

## Main results

* `TauCeti.baerLeftHom_injective`, `TauCeti.baerRightHom_injective`, `TauCeti.baerLeftHom_neg_one`:
  injectivity of both canonical factor maps and the central-product identification
  `baerLeftHom (-1) = baerRightHom (Multiplicative.ofAdd 2)`.
* `TauCeti.isLocalComplement_baerQuaternionSubgroup`: `baerLocalComplement` locally complements
  `baerQuaternionSubgroup` inside `baerSylowSubgroup`.
* `TauCeti.not_exists_isComplement'_baerQuaternionSubgroup`: `baerQuaternionSubgroup` has no global
  complement in `BaerCentralProduct`.
* `TauCeti.exists_not_isMulCommutative_and_isLocalComplement_and_not_exists_isComplement'`:
  existential witness that local Sylow splitting at coprime index does not imply global splitting
  for non-abelian normal `p`-subgroups.

## References

* R. Baer, *Verallgemeinerung eines Satzes von L. Hall*, Abh. Math. Sem. Univ. Hamburg 29 (1966),
  135–149.
* B. Sambale, *On the converse of Gaschütz' complement theorem*, arXiv:2303.00254, Section 1.
-/

public section

open scoped IsMulCommutative MatrixGroups

namespace TauCeti

/-! ## Baer's central product of `SL(2, ZMod 3)` and `C₄` -/

/-- The diagonal central involution `(-1, 2)` in `SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
def baerCentralGen : SL(2, ZMod 3) × Multiplicative (ZMod 4) :=
  (-1, Multiplicative.ofAdd 2)

/-- `TauCeti.baerCentralGen` is the pair `(-1, Multiplicative.ofAdd 2)`. -/
theorem baerCentralGen_def :
    baerCentralGen = (-1, Multiplicative.ofAdd 2) :=
  (rfl)

/-- The first coordinate of `TauCeti.baerCentralGen` is `-1`. -/
@[simp]
theorem fst_baerCentralGen : baerCentralGen.1 = -1 :=
  (rfl)

/-- The second coordinate of `TauCeti.baerCentralGen` is `Multiplicative.ofAdd 2`. -/
@[simp]
theorem snd_baerCentralGen : baerCentralGen.2 = Multiplicative.ofAdd 2 :=
  (rfl)

/-- `TauCeti.baerCentralGen` squares to `1`. -/
@[simp]
theorem baerCentralGen_sq : baerCentralGen ^ 2 = 1 :=
  Prod.ext neg_one_sq (by decide)

/-- `TauCeti.baerCentralGen` is distinct from `1`. -/
theorem baerCentralGen_ne_one : baerCentralGen ≠ 1 :=
  fun h => sl2_zmod_three_neg_one_ne_one (congrArg Prod.fst h)

/-- `TauCeti.baerCentralGen` has order `2`. -/
@[simp]
theorem orderOf_baerCentralGen : orderOf baerCentralGen = 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact orderOf_eq_prime baerCentralGen_sq baerCentralGen_ne_one

/-- `TauCeti.baerCentralGen` is central in `SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
theorem baerCentralGen_mem_center :
    baerCentralGen ∈ Subgroup.center (SL(2, ZMod 3) × Multiplicative (ZMod 4)) :=
  Subgroup.mem_center_iff.mpr fun ⟨_, c⟩ => Prod.ext (by simp) (mul_comm c _)

/-- The central subgroup of order two generated by `(-1, 2)` in
`SL(2, ZMod 3) × Multiplicative (ZMod 4)`. -/
def baerCentralKernel : Subgroup (SL(2, ZMod 3) × Multiplicative (ZMod 4)) :=
  Subgroup.zpowers baerCentralGen

/-- `TauCeti.baerCentralKernel` is `Subgroup.zpowers baerCentralGen`. -/
theorem baerCentralKernel_def :
    baerCentralKernel = Subgroup.zpowers baerCentralGen :=
  (rfl)

/-- `TauCeti.baerCentralKernel` is normal, as a central subgroup. -/
instance baerCentralKernel_normal : baerCentralKernel.Normal :=
  Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr baerCentralGen_mem_center)

/-- `TauCeti.baerCentralGen` belongs to `TauCeti.baerCentralKernel`. -/
@[simp]
theorem baerCentralGen_mem_baerCentralKernel : baerCentralGen ∈ baerCentralKernel :=
  Subgroup.mem_zpowers _

/-- `TauCeti.baerCentralKernel` consists of `1` and `TauCeti.baerCentralGen`. Use this
characterization explicitly; `TauCeti.baerCentralGen_mem_baerCentralKernel` is the `@[simp]`
membership lemma without expanding the carrier coercion `↥baerCentralKernel`. -/
theorem mem_baerCentralKernel_iff {x : SL(2, ZMod 3) × Multiplicative (ZMod 4)} :
    x ∈ baerCentralKernel ↔ x = 1 ∨ x = baerCentralGen :=
  Subgroup.mem_zpowers_iff_of_sq_eq_one baerCentralGen_sq

/-- `TauCeti.baerCentralKernel` has cardinality `2`. -/
@[simp]
theorem natCard_baerCentralKernel : Nat.card baerCentralKernel = 2 := by
  rw [baerCentralKernel, Nat.card_zpowers, orderOf_baerCentralGen]

/-- **Baer's central product** `(SL(2, ZMod 3) × C₄) ⧸ ⟨(-1, 2)⟩`, a finite group of order `48`. -/
def BaerCentralProduct : Type :=
  (SL(2, ZMod 3) × Multiplicative (ZMod 4)) ⧸ baerCentralKernel

instance instGroupBaerCentralProduct : Group BaerCentralProduct :=
  inferInstanceAs (Group ((SL(2, ZMod 3) × Multiplicative (ZMod 4)) ⧸ baerCentralKernel))

instance instFiniteBaerCentralProduct : Finite BaerCentralProduct :=
  inferInstanceAs (Finite ((SL(2, ZMod 3) × Multiplicative (ZMod 4)) ⧸ baerCentralKernel))

/-- The canonical quotient homomorphism from `SL(2, ZMod 3) × Multiplicative (ZMod 4)` onto
`TauCeti.BaerCentralProduct`. -/
def baerQuotientHom : SL(2, ZMod 3) × Multiplicative (ZMod 4) →* BaerCentralProduct :=
  QuotientGroup.mk' baerCentralKernel

/-- `TauCeti.baerQuotientHom` is surjective. -/
theorem baerQuotientHom_surjective : Function.Surjective baerQuotientHom :=
  QuotientGroup.mk'_surjective baerCentralKernel

/-- The kernel of `TauCeti.baerQuotientHom` is `TauCeti.baerCentralKernel`. -/
@[simp]
theorem ker_baerQuotientHom : baerQuotientHom.ker = baerCentralKernel :=
  QuotientGroup.ker_mk' baerCentralKernel

/-- `TauCeti.BaerCentralProduct` has cardinality `48`. -/
@[simp]
theorem natCard_baerCentralProduct : Nat.card BaerCentralProduct = 48 := by
  have h := Subgroup.card_ker_mul_card_of_surjective baerQuotientHom_surjective
  have hprod : Nat.card (SL(2, ZMod 3) × Multiplicative (ZMod 4)) = 96 := by
    rw [Nat.card_prod, natCard_sl2_zmod_three, Nat.card_eq_fintype_card,
      Fintype.card_multiplicative, ZMod.card]
  rw [ker_baerQuotientHom, natCard_baerCentralKernel, hprod] at h
  omega

/-- The canonical embedding of `SL(2, ZMod 3)` into `TauCeti.BaerCentralProduct`. -/
def baerLeftHom : SL(2, ZMod 3) →* BaerCentralProduct :=
  baerQuotientHom.comp (MonoidHom.inl _ _)

-- Not `@[simp]`: keeping `baerLeftHom` and `baerRightHom` unexpanded preserves the left-hand side
-- of `baerLeftHom_mem_baerQuaternionSubgroup_iff` and keeps element expressions on the factor maps.
/-- `TauCeti.baerLeftHom` sends `g` to `baerQuotientHom (g, 1)`. -/
theorem baerLeftHom_apply (g : SL(2, ZMod 3)) :
    baerLeftHom g = baerQuotientHom (g, 1) :=
  (rfl)

/-- `TauCeti.baerLeftHom` is injective. -/
theorem baerLeftHom_injective : Function.Injective baerLeftHom := by
  rw [injective_iff_map_eq_one]
  intro g hg
  rw [baerLeftHom_apply, ← MonoidHom.mem_ker, ker_baerQuotientHom, mem_baerCentralKernel_iff] at hg
  rcases hg with h1 | h2
  · exact congrArg Prod.fst h1
  · have hsnd : (1 : Multiplicative (ZMod 4)) = Multiplicative.ofAdd 2 := congrArg Prod.snd h2
    exact absurd hsnd (by decide)

/-- The canonical central embedding of `Multiplicative (ZMod 4)` into
`TauCeti.BaerCentralProduct`. -/
def baerRightHom : Multiplicative (ZMod 4) →* BaerCentralProduct :=
  baerQuotientHom.comp (MonoidHom.inr _ _)

/-- `TauCeti.baerRightHom` sends `c` to `baerQuotientHom (1, c)`. -/
theorem baerRightHom_apply (c : Multiplicative (ZMod 4)) :
    baerRightHom c = baerQuotientHom (1, c) :=
  (rfl)

/-- `TauCeti.baerRightHom` is injective. -/
theorem baerRightHom_injective : Function.Injective baerRightHom := by
  rw [injective_iff_map_eq_one]
  intro c hc
  rw [baerRightHom_apply, ← MonoidHom.mem_ker, ker_baerQuotientHom, mem_baerCentralKernel_iff] at hc
  rcases hc with h1 | h2
  · exact congrArg Prod.snd h1
  · exact absurd (congrArg Prod.fst h2).symm sl2_zmod_three_neg_one_ne_one

/-- `TauCeti.baerQuotientHom` factors on pairs as the product of `TauCeti.baerLeftHom` and
`TauCeti.baerRightHom`. -/
theorem baerQuotientHom_mk (g : SL(2, ZMod 3)) (c : Multiplicative (ZMod 4)) :
    baerQuotientHom (g, c) = baerLeftHom g * baerRightHom c := by
  rw [baerLeftHom_apply, baerRightHom_apply, ← map_mul]
  simp

/-- Every element in the image of `TauCeti.baerRightHom` is central in
`TauCeti.BaerCentralProduct`. -/
theorem baerRightHom_mem_center (c : Multiplicative (ZMod 4)) :
    baerRightHom c ∈ Subgroup.center BaerCentralProduct := by
  rw [Subgroup.mem_center_iff]
  intro x
  obtain ⟨⟨g, d⟩, rfl⟩ := baerQuotientHom_surjective x
  rw [baerRightHom_apply, ← map_mul, ← map_mul]
  exact congrArg baerQuotientHom (Prod.ext (by simp) (mul_comm d c))

/-- **Central-product identification in `TauCeti.BaerCentralProduct`.** The central involution `-1`
of `SL(2, ZMod 3)` agrees with the involution `Multiplicative.ofAdd 2` of `C₄`. -/
theorem baerLeftHom_neg_one :
    baerLeftHom (-1) = baerRightHom (Multiplicative.ofAdd 2) := by
  rw [baerLeftHom_apply, baerRightHom_apply, MonoidHom.eq_iff, ker_baerQuotientHom,
    mem_baerCentralKernel_iff]
  refine Or.inr (Prod.ext ?_ ?_)
  · simp
  · simp only [Prod.snd_mul, Prod.snd_inv, snd_baerCentralGen]
    decide

/-- The normal quaternion subgroup `Q₈` inside `TauCeti.BaerCentralProduct`, embedded via
`TauCeti.baerLeftHom`. -/
def baerQuaternionSubgroup : Subgroup BaerCentralProduct :=
  sl2ZModThreeQuaternionSubgroup.map baerLeftHom

/-- `TauCeti.baerQuaternionSubgroup` is the image of `TauCeti.sl2ZModThreeQuaternionSubgroup` under
`TauCeti.baerLeftHom`. -/
theorem baerQuaternionSubgroup_def :
    baerQuaternionSubgroup = sl2ZModThreeQuaternionSubgroup.map baerLeftHom :=
  (rfl)

/-- Membership in `TauCeti.baerQuaternionSubgroup` is being the image under `TauCeti.baerLeftHom`
of an element of `TauCeti.sl2ZModThreeQuaternionSubgroup`. Use this characterization explicitly;
`TauCeti.baerLeftHom_mem_baerQuaternionSubgroup_iff` is the `@[simp]` lemma on `baerLeftHom`
elements without expanding the carrier coercion `↥baerQuaternionSubgroup`. -/
theorem mem_baerQuaternionSubgroup_iff {x : BaerCentralProduct} :
    x ∈ baerQuaternionSubgroup ↔
      ∃ q ∈ sl2ZModThreeQuaternionSubgroup, baerLeftHom q = x :=
  Iff.rfl

/-- `TauCeti.baerLeftHom g` belongs to `TauCeti.baerQuaternionSubgroup` if and only if `g` belongs
to `TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
@[simp]
theorem baerLeftHom_mem_baerQuaternionSubgroup_iff {g : SL(2, ZMod 3)} :
    baerLeftHom g ∈ baerQuaternionSubgroup ↔ g ∈ sl2ZModThreeQuaternionSubgroup :=
  ⟨fun h => by
    obtain ⟨q, hq, hqg⟩ := mem_baerQuaternionSubgroup_iff.mp h
    exact baerLeftHom_injective hqg ▸ hq,
    fun hg => mem_baerQuaternionSubgroup_iff.mpr ⟨g, hg, rfl⟩⟩

private theorem baerQuaternionSubgroup_eq_map_prod_bot :
    baerQuaternionSubgroup =
      (sl2ZModThreeQuaternionSubgroup.prod ⊥).map baerQuotientHom := by
  rw [baerQuaternionSubgroup, baerLeftHom, ← Subgroup.map_map]
  congr 1
  ext ⟨g, c⟩
  simp only [Subgroup.mem_map, MonoidHom.inl_apply, Prod.mk.injEq, Subgroup.mem_prod,
    Subgroup.mem_bot]
  exact ⟨fun ⟨_, hx, hgx, h1c⟩ => ⟨hgx ▸ hx, h1c.symm⟩, fun ⟨hg, hc⟩ => ⟨g, hg, rfl, hc.symm⟩⟩

/-- `TauCeti.baerQuaternionSubgroup` is normal in `TauCeti.BaerCentralProduct`. -/
instance baerQuaternionSubgroup_normal : baerQuaternionSubgroup.Normal := by
  rw [baerQuaternionSubgroup_eq_map_prod_bot]
  exact Subgroup.Normal.map inferInstance _ baerQuotientHom_surjective

/-- `TauCeti.baerQuaternionSubgroup` is isomorphic to `QuaternionGroup 2` (`Q₈`). -/
noncomputable def baerQuaternionEquiv : QuaternionGroup 2 ≃* baerQuaternionSubgroup :=
  sl2ZModThreeQuaternionEquiv.trans
    (sl2ZModThreeQuaternionSubgroup.equivMapOfInjective baerLeftHom baerLeftHom_injective)

/-- Coercing `TauCeti.baerQuaternionEquiv x` to `TauCeti.BaerCentralProduct` evaluates
`baerLeftHom (sl2ZModThreeQuaternionHom x)`. -/
@[simp]
theorem coe_baerQuaternionEquiv (x : QuaternionGroup 2) :
    (baerQuaternionEquiv x : BaerCentralProduct) = baerLeftHom (sl2ZModThreeQuaternionHom x) :=
  congrArg baerLeftHom (coe_sl2ZModThreeQuaternionEquiv x)

/-- `TauCeti.baerQuaternionSubgroup` has cardinality `8`. -/
@[simp]
theorem natCard_baerQuaternionSubgroup : Nat.card baerQuaternionSubgroup = 8 := by
  rw [Nat.card_congr baerQuaternionEquiv.symm.toEquiv, natCard_quaternionGroup]

/-- `TauCeti.baerQuaternionSubgroup` is a `2`-group. -/
theorem isPGroup_baerQuaternionSubgroup : IsPGroup 2 baerQuaternionSubgroup :=
  (isPGroup_quaternionGroup_two_pow 1).of_equiv baerQuaternionEquiv

/-- `TauCeti.baerQuaternionSubgroup` is not commutative. -/
theorem not_isMulCommutative_baerQuaternionSubgroup :
    ¬ IsMulCommutative baerQuaternionSubgroup :=
  fun _ => not_isMulCommutative_quaternionGroup (by decide)
    baerQuaternionEquiv.symm.surjective.isMulCommutative

private theorem snd_eq_of_baerQuotientHom_mem_baerQuaternionSubgroup {g : SL(2, ZMod 3)}
    {c : Multiplicative (ZMod 4)}
    (h : baerQuotientHom (g, c) ∈ baerQuaternionSubgroup) :
    c = 1 ∨ c = Multiplicative.ofAdd 2 := by
  obtain ⟨q, -, hq⟩ := mem_baerQuaternionSubgroup_iff.mp h
  rw [baerLeftHom_apply, MonoidHom.eq_iff, ker_baerQuotientHom, mem_baerCentralKernel_iff] at hq
  rcases hq with h1 | h2
  · left
    have hsnd : c⁻¹ * 1 = 1 := congrArg Prod.snd h1
    simpa using hsnd
  · right
    have hsnd : c⁻¹ * 1 = Multiplicative.ofAdd 2 := congrArg Prod.snd h2
    rw [mul_one, inv_eq_iff_eq_inv] at hsnd
    exact hsnd.trans (by decide)

/-! ### The unique Sylow `2`-subgroup and its local complement -/

/-- The normal subgroup `(Q₈ × C₄) ⧸ ⟨(-1, 2)⟩` of order `16` and index `3` in
`TauCeti.BaerCentralProduct`. -/
def baerSylowSubgroup : Subgroup BaerCentralProduct :=
  (sl2ZModThreeQuaternionSubgroup.prod ⊤).map baerQuotientHom

/-- `TauCeti.baerSylowSubgroup` is normal in `TauCeti.BaerCentralProduct`. -/
instance baerSylowSubgroup_normal : baerSylowSubgroup.Normal :=
  Subgroup.Normal.map inferInstance _ baerQuotientHom_surjective

/-- `TauCeti.baerQuaternionSubgroup` is contained in `TauCeti.baerSylowSubgroup`. -/
theorem baerQuaternionSubgroup_le_baerSylowSubgroup :
    baerQuaternionSubgroup ≤ baerSylowSubgroup := by
  rw [baerQuaternionSubgroup_eq_map_prod_bot]
  exact Subgroup.map_mono (Subgroup.prod_mono le_rfl bot_le)

private theorem comap_baerQuotientHom_baerSylowSubgroup :
    baerSylowSubgroup.comap baerQuotientHom =
      sl2ZModThreeQuaternionSubgroup.prod ⊤ := by
  refine Subgroup.comap_map_eq_self ?_
  rw [ker_baerQuotientHom, baerCentralKernel, Subgroup.zpowers_le, Subgroup.mem_prod]
  exact ⟨neg_one_mem_sl2ZModThreeQuaternionSubgroup, Subgroup.mem_top _⟩

/-- A pair `(g, c)` maps into `TauCeti.baerSylowSubgroup` under `TauCeti.baerQuotientHom` if and
only if `g` belongs to `TauCeti.sl2ZModThreeQuaternionSubgroup`. -/
@[simp]
theorem baerQuotientHom_mem_baerSylowSubgroup_iff {g : SL(2, ZMod 3)}
    {c : Multiplicative (ZMod 4)} :
    baerQuotientHom (g, c) ∈ baerSylowSubgroup ↔
      g ∈ sl2ZModThreeQuaternionSubgroup := by
  rw [← Subgroup.mem_comap, comap_baerQuotientHom_baerSylowSubgroup, Subgroup.mem_prod]
  simp

/-- `TauCeti.baerSylowSubgroup` has index `3` in `TauCeti.BaerCentralProduct`. -/
@[simp]
theorem index_baerSylowSubgroup : baerSylowSubgroup.index = 3 := by
  rw [← baerSylowSubgroup.index_comap_of_surjective baerQuotientHom_surjective,
    comap_baerQuotientHom_baerSylowSubgroup]
  simp

/-- `TauCeti.baerSylowSubgroup` has cardinality `16`. -/
@[simp]
theorem natCard_baerSylowSubgroup : Nat.card baerSylowSubgroup = 16 := by
  have h := baerSylowSubgroup.card_mul_index
  rw [index_baerSylowSubgroup, natCard_baerCentralProduct] at h
  omega

/-- `TauCeti.baerSylowSubgroup` is a `2`-group. -/
theorem isPGroup_baerSylowSubgroup : IsPGroup 2 baerSylowSubgroup := by
  have hcard : Nat.card baerSylowSubgroup = 2 ^ 4 := by
    rw [natCard_baerSylowSubgroup]
    decide
  exact IsPGroup.of_card hcard

/-- `TauCeti.baerSylowSubgroup` packaged as the Sylow `2`-subgroup of
`TauCeti.BaerCentralProduct`. -/
def baerSylowTwo : Sylow 2 BaerCentralProduct :=
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  isPGroup_baerSylowSubgroup.toSylow (by rw [index_baerSylowSubgroup]; decide)

/-- The underlying subgroup of `TauCeti.baerSylowTwo` is `TauCeti.baerSylowSubgroup`. -/
@[simp]
theorem coe_baerSylowTwo : (baerSylowTwo : Subgroup BaerCentralProduct) = baerSylowSubgroup := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact IsPGroup.toSylow_coe _ _

/-- `TauCeti.BaerCentralProduct` has a unique Sylow `2`-subgroup. -/
noncomputable instance instUniqueSylowTwoBaerCentralProduct :
    Unique (Sylow 2 BaerCentralProduct) :=
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  baerSylowTwo.unique_of_normal (coe_baerSylowTwo.symm ▸ baerSylowSubgroup_normal)

/-- The involution `[(I, 1)]` in `TauCeti.BaerCentralProduct`: `I ^ 2 = -1` cancels against
`1 + 1 = 2` via `TauCeti.baerLeftHom_neg_one`. -/
def baerLocalGen : BaerCentralProduct :=
  baerLeftHom sl2ZModThreeI * baerRightHom (Multiplicative.ofAdd 1)

/-- `TauCeti.baerLocalGen` is
`baerLeftHom sl2ZModThreeI * baerRightHom (Multiplicative.ofAdd 1)`. -/
theorem baerLocalGen_def :
    baerLocalGen = baerLeftHom sl2ZModThreeI * baerRightHom (Multiplicative.ofAdd 1) :=
  (rfl)

/-- `TauCeti.baerLocalGen` squares to `1`. -/
@[simp]
theorem baerLocalGen_sq : baerLocalGen ^ 2 = 1 := by
  rw [baerLocalGen, ← baerQuotientHom_mk, ← map_pow, ← MonoidHom.mem_ker, ker_baerQuotientHom,
    mem_baerCentralKernel_iff]
  exact Or.inr (Prod.ext sl2ZModThreeI_sq (by decide))

/-- `TauCeti.baerLocalGen` does not belong to `TauCeti.baerQuaternionSubgroup`. -/
theorem baerLocalGen_notMem_baerQuaternionSubgroup :
    baerLocalGen ∉ baerQuaternionSubgroup := by
  rw [baerLocalGen, ← baerQuotientHom_mk]
  intro h
  rcases snd_eq_of_baerQuotientHom_mem_baerQuaternionSubgroup h with h1 | h2
  · exact absurd h1 (by decide)
  · exact absurd h2 (by decide)

/-- `TauCeti.baerLocalGen` has exact order `2`. -/
@[simp]
theorem orderOf_baerLocalGen : orderOf baerLocalGen = 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine orderOf_eq_prime baerLocalGen_sq fun h => baerLocalGen_notMem_baerQuaternionSubgroup ?_
  rw [h]
  exact one_mem _

/-- The order-two subgroup generated by `TauCeti.baerLocalGen`, a local complement of
`TauCeti.baerQuaternionSubgroup` in `TauCeti.baerSylowSubgroup`. -/
def baerLocalComplement : Subgroup BaerCentralProduct :=
  Subgroup.zpowers baerLocalGen

/-- `TauCeti.baerLocalComplement` is `Subgroup.zpowers baerLocalGen`. -/
theorem baerLocalComplement_def :
    baerLocalComplement = Subgroup.zpowers baerLocalGen :=
  (rfl)

/-- `TauCeti.baerLocalGen` belongs to `TauCeti.baerLocalComplement`. -/
@[simp]
theorem baerLocalGen_mem_baerLocalComplement : baerLocalGen ∈ baerLocalComplement :=
  Subgroup.mem_zpowers _

/-- `TauCeti.baerLocalComplement` consists of `1` and `TauCeti.baerLocalGen`. Use this
characterization explicitly; `TauCeti.baerLocalGen_mem_baerLocalComplement` is the `@[simp]`
membership lemma without expanding the carrier coercion `↥baerLocalComplement`. -/
theorem mem_baerLocalComplement_iff {x : BaerCentralProduct} :
    x ∈ baerLocalComplement ↔ x = 1 ∨ x = baerLocalGen :=
  Subgroup.mem_zpowers_iff_of_sq_eq_one baerLocalGen_sq

/-- `TauCeti.baerLocalComplement` has cardinality `2`. -/
@[simp]
theorem natCard_baerLocalComplement : Nat.card baerLocalComplement = 2 := by
  rw [baerLocalComplement, Nat.card_zpowers, orderOf_baerLocalGen]

/-- `TauCeti.baerLocalComplement` lies inside `TauCeti.baerSylowSubgroup`. -/
theorem baerLocalComplement_le_baerSylowSubgroup :
    baerLocalComplement ≤ baerSylowSubgroup := by
  rw [baerLocalComplement, Subgroup.zpowers_le, baerLocalGen, ← baerQuotientHom_mk,
    baerQuotientHom_mem_baerSylowSubgroup_iff]
  exact sl2ZModThreeI_mem_sl2ZModThreeQuaternionSubgroup

/-- **Local splitting in the Sylow `2`-subgroup.** `TauCeti.baerLocalComplement` complements
`TauCeti.baerQuaternionSubgroup` inside `TauCeti.baerSylowSubgroup`. -/
theorem isLocalComplement_baerQuaternionSubgroup :
    baerQuaternionSubgroup.IsLocalComplement baerLocalComplement baerSylowSubgroup := by
  rw [Subgroup.isLocalComplement_iff_isComplement'_subgroupOf
    baerQuaternionSubgroup_le_baerSylowSubgroup baerLocalComplement_le_baerSylowSubgroup]
  refine Subgroup.isComplement'_of_card_mul_and_disjoint ?_ ?_
  · have h1 := Nat.card_congr (baerQuaternionSubgroup.subgroupOfEquivOfLe
      baerQuaternionSubgroup_le_baerSylowSubgroup).toEquiv
    have h2 := Nat.card_congr (baerLocalComplement.subgroupOfEquivOfLe
      baerLocalComplement_le_baerSylowSubgroup).toEquiv
    rw [h1, h2, natCard_baerQuaternionSubgroup, natCard_baerLocalComplement,
      natCard_baerSylowSubgroup]
  · rw [Subgroup.disjoint_def]
    rintro ⟨x, hxS⟩ hxQ hxK
    rw [Subgroup.mem_subgroupOf] at hxQ hxK
    rcases mem_baerLocalComplement_iff.mp hxK with rfl | rfl
    · rfl
    · exact absurd hxQ baerLocalGen_notMem_baerQuaternionSubgroup

/-! ### Absence of a global complement -/

private theorem lift_involution_notMem_baerQuaternionSubgroup {w : BaerCentralProduct}
    (hwS : w ∈ baerSylowSubgroup) (hw2 : w ^ 2 = 1) (hwQ : w ∉ baerQuaternionSubgroup) :
    ∃ (q : SL(2, ZMod 3)) (c : Multiplicative (ZMod 4)),
      w = baerQuotientHom (q, c) ∧ q ∈ sl2ZModThreeQuaternionSubgroup ∧ q ≠ 1 ∧ q ≠ -1 := by
  obtain ⟨⟨q, c⟩, rfl⟩ := baerQuotientHom_surjective w
  have hq : q ∈ sl2ZModThreeQuaternionSubgroup := baerQuotientHom_mem_baerSylowSubgroup_iff.mp hwS
  have hc0 : c ≠ 1 := by
    rintro rfl
    rw [baerQuotientHom_mk, map_one, mul_one] at hwQ
    exact hwQ (mem_baerQuaternionSubgroup_iff.mpr ⟨q, hq, rfl⟩)
  have hc2' : c ≠ Multiplicative.ofAdd 2 := by
    rintro rfl
    rw [baerQuotientHom_mk, ← baerLeftHom_neg_one, ← map_mul, mul_neg_one] at hwQ
    exact hwQ (mem_baerQuaternionSubgroup_iff.mpr
      ⟨-q, by simpa using mul_mem neg_one_mem_sl2ZModThreeQuaternionSubgroup hq, rfl⟩)
  have hc2 : c ^ 2 = Multiplicative.ofAdd 2 :=
    (by decide : ∀ d : Multiplicative (ZMod 4),
      d ≠ 1 → d ≠ Multiplicative.ofAdd 2 → d ^ 2 = Multiplicative.ofAdd 2) c hc0 hc2'
  have hpow : (q, c) ^ 2 = (q ^ 2, Multiplicative.ofAdd 2) := Prod.ext rfl hc2
  rw [← map_pow, hpow, ← MonoidHom.mem_ker, ker_baerQuotientHom, mem_baerCentralKernel_iff] at hw2
  have hq2 : q ^ 2 = -1 := by
    rcases hw2 with h1 | h2
    · have hsnd : Multiplicative.ofAdd (2 : ZMod 4) = 1 := congrArg Prod.snd h1
      exact absurd hsnd (by decide)
    · exact congrArg Prod.fst h2
  refine ⟨q, c, rfl, hq, ?_, ?_⟩ <;> rintro rfl <;>
    exact sl2_zmod_three_neg_one_ne_one (by simpa using hq2.symm)

private theorem conj_ne_of_notMem_baerSylowSubgroup {u : BaerCentralProduct}
    (huS : u ∉ baerSylowSubgroup) {q : SL(2, ZMod 3)} {c : Multiplicative (ZMod 4)}
    (hq : q ∈ sl2ZModThreeQuaternionSubgroup) (hq1 : q ≠ 1) (hqneg : q ≠ -1) :
    u * baerQuotientHom (q, c) * u⁻¹ ≠ baerQuotientHom (q, c) := by
  obtain ⟨⟨g, d⟩, rfl⟩ := baerQuotientHom_surjective u
  have hg : g ∉ sl2ZModThreeQuaternionSubgroup :=
    mt baerQuotientHom_mem_baerSylowSubgroup_iff.mpr huS
  intro hconj_eq
  have hrel : ((g * q * g⁻¹)⁻¹ * q, (1 : Multiplicative (ZMod 4))) ∈ baerCentralKernel := by
    have hsymm := hconj_eq.symm
    rw [← map_inv, ← map_mul, ← map_mul, MonoidHom.eq_iff, ker_baerQuotientHom] at hsymm
    simpa [mul_comm d c] using hsymm
  rcases mem_baerCentralKernel_iff.mp hrel with h1 | h2
  · exact (conj_ne_and_ne_neg_of_notMem_sl2ZModThreeQuaternionSubgroup hg hq hq1 hqneg).1
      (inv_mul_eq_one.mp (congrArg Prod.fst h1))
  · have hsnd : (1 : Multiplicative (ZMod 4)) = Multiplicative.ofAdd 2 := congrArg Prod.snd h2
    exact absurd hsnd (by decide)

/-- **Failure of global splitting in `TauCeti.BaerCentralProduct`.** Despite admitting a local
complement in the Sylow `2`-subgroup of index `3`, `TauCeti.baerQuaternionSubgroup` has no
complement in `TauCeti.BaerCentralProduct`. -/
theorem not_exists_isComplement'_baerQuaternionSubgroup :
    ¬ ∃ D : Subgroup BaerCentralProduct, baerQuaternionSubgroup.IsComplement' D := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rintro ⟨D, hD⟩
  have hcardD : Nat.card D = 6 := by
    have h := hD.card_mul_card
    rw [natCard_baerQuaternionSubgroup, natCard_baerCentralProduct] at h
    omega
  have hcardM : Nat.card (D ⊓ baerSylowSubgroup : Subgroup BaerCentralProduct) = 2 := by
    have h := (hD.isLocalComplement_inf baerQuaternionSubgroup_le_baerSylowSubgroup).card_mul_card
    rw [natCard_baerQuaternionSubgroup, natCard_baerSylowSubgroup] at h
    omega
  obtain ⟨w, hw_eq⟩ :=
    (D ⊓ baerSylowSubgroup).isCyclic_iff_exists_zpowers_eq.mp (isCyclic_of_prime_card hcardM)
  have hord : orderOf w = 2 := by rw [← Nat.card_zpowers, hw_eq]; exact hcardM
  have hwM : w ∈ D ⊓ baerSylowSubgroup := hw_eq ▸ Subgroup.mem_zpowers w
  have hw1 : w ≠ 1 := by rintro rfl; simp at hord
  have hwQ : w ∉ baerQuaternionSubgroup :=
    fun hQ => hw1 (Subgroup.disjoint_def.mp hD.disjoint hQ hwM.1)
  obtain ⟨q, c, rfl, hq, hq1, hqneg⟩ :=
    lift_involution_notMem_baerQuaternionSubgroup hwM.2
      (orderOf_dvd_iff_pow_eq_one.mp hord.dvd) hwQ
  have hnot_le : ¬ D ≤ baerSylowSubgroup := fun hle => by
    rw [inf_eq_left.mpr hle, hcardD] at hcardM; omega
  obtain ⟨u, huD, huS⟩ := Set.not_subset.mp hnot_le
  let w0 : BaerCentralProduct := baerQuotientHom (q, c)
  have hconj_mem : u * w0 * u⁻¹ ∈ Subgroup.zpowers w0 :=
    hw_eq.symm ▸ ⟨D.mul_mem (D.mul_mem huD hwM.1) (D.inv_mem huD),
      baerSylowSubgroup_normal.conj_mem _ hwM.2 _⟩
  rcases (Subgroup.mem_zpowers_iff_of_orderOf_eq_two hord).mp hconj_mem with h1 | h2
  · refine hw1 ?_
    calc w0 = u⁻¹ * (u * w0 * u⁻¹) * u := by group
      _ = 1 := by rw [h1]; group
  · exact conj_ne_of_notMem_baerSylowSubgroup huS hq hq1 hqneg h2

/-- **Baer's non-abelian counterexample to Gaschütz's splitting theorem and Sylow complement
detection.** There exists a finite group `G` of order `48`, a normal non-abelian `2`-subgroup
`N ≃* Q₈`, and a Sylow `2`-subgroup `P` of index `3` (coprime to `|N| = 8`) such that `N` admits a
local complement in `P` yet has no global complement in `G`. -/
theorem exists_not_isMulCommutative_and_isLocalComplement_and_not_exists_isComplement' :
    ∃ (G : Type) (_ : Group G) (_ : Finite G) (N : Subgroup G) (_ : N.Normal)
      (P : Sylow 2 G) (K : Subgroup G),
      Nat.card G = 48 ∧
      Nonempty (QuaternionGroup 2 ≃* N) ∧
      ¬ IsMulCommutative N ∧
      IsPGroup 2 N ∧
      Nat.Coprime (P : Subgroup G).index (Nat.card N) ∧
      N.IsLocalComplement K P ∧
      ¬ ∃ D : Subgroup G, N.IsComplement' D := by
  refine ⟨BaerCentralProduct, inferInstance, inferInstance, baerQuaternionSubgroup,
    inferInstance, baerSylowTwo, baerLocalComplement, natCard_baerCentralProduct,
    ⟨baerQuaternionEquiv⟩, not_isMulCommutative_baerQuaternionSubgroup,
    isPGroup_baerQuaternionSubgroup, ?_, ?_, not_exists_isComplement'_baerQuaternionSubgroup⟩
  · rw [coe_baerSylowTwo, index_baerSylowSubgroup, natCard_baerQuaternionSubgroup]
    decide
  · rw [coe_baerSylowTwo]
    exact isLocalComplement_baerQuaternionSubgroup

end TauCeti
