module

public import TauCeti.GroupTheory.Coset.Recognition
import Mathlib.Data.Fin.VecNotation
import Mathlib.GroupTheory.Perm.Sign
import Mathlib.Tactic.FinCases

/-!
# A certified centralizer in the symmetric group on three letters

The subgroup generated by the transposition `(0 1)` has a three-row coset table in `S₃`.
The two nonidentity representatives fail to commute with `(0 1)`, so the table recognizes
this subgroup as the whole centralizer. The subgroup containment and separation checks
are performed in the actual permutation group. Removing the deductions is rejected.
-/

public section

namespace TauCeti.Examples.CosetRecognition

open Equiv

/-- The two adjacent transpositions generating `S₃`. -/
def generators (i : Fin 2) : Perm (Fin 3) := swap i.castSucc i.succ

/-- A table for the cosets of the subgroup generated by the first transposition.
Its representatives are `1`, `b`, and `ab`, with multiplication acting on the left. -/
def table : CosetTable 2 3 where
  act := ![![0, 2, 1], ![1, 0, 2]]
  word := ![[], [1], [0, 1]]

/-- The two involution relations and the braid relation. -/
def relators : List (List (Fin 2)) := [[0, 0], [1, 1], [1, 0, 1, 0, 1, 0]]

/-- The word specifying the candidate centralizer generator. -/
def subgroupWords : List (List (Fin 2)) := [[0]]

/-- Deductions completing the three-row table from the subgroup word and the relators. -/
def certificate : List (Fin 3 × List (Fin 2)) :=
  [(0, [0]), (1, [0, 0]), (0, [1, 1]), (2, [1, 0, 1, 0, 1, 0])]

/-- The table's deduction certificate checks. -/
theorem check_table : table.check relators subgroupWords certificate = true := by decide

/-- The same table without deductions does not certify coverage. -/
theorem reject_empty_certificate : table.check relators subgroupWords [] = false := by decide

private theorem generates : Subgroup.closure (Set.range generators) = ⊤ :=
  Subgroup.closure_eq_top_of_mclosure_eq_top (Perm.mclosure_swap_castSucc_succ 2)

private theorem relations_hold : ∀ r ∈ relators, (r.map generators).prod = 1 := by
  intro r hr
  simp only [relators, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl <;> decide

private theorem subgroup_words_mem : ∀ r ∈ subgroupWords,
    (r.map generators).prod ∈ Subgroup.zpowers (swap 0 1 : Perm (Fin 3)) := by
  intro r hr
  simp only [subgroupWords, List.mem_singleton] at hr
  subst r
  simp [generators]

/-- The certificate and the separation tests identify the actual centralizer. -/
theorem zpowers_swap_eq_centralizer :
    Subgroup.zpowers (swap 0 1 : Perm (Fin 3)) =
      Subgroup.centralizer {swap 0 1} := by
  apply table.eq_centralizer_of_check generates check_table relations_hold subgroup_words_mem
    (x := swap 0 1)
  · exact fun h hh ↦ Subgroup.mem_centralizer_singleton_iff.mp
      ((Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr rfl)) hh)
  · intro i hi
    fin_cases i
    · exact Subgroup.one_mem _
    · have h : ¬ ((table.word 1).map generators).prod * swap 0 1 =
          swap 0 1 * ((table.word 1).map generators).prod := by decide
      exact (h hi).elim
    · have h : ¬ ((table.word 2).map generators).prod * swap 0 1 =
          swap 0 1 * ((table.word 2).map generators).prod := by decide
      exact (h hi).elim

/-- Distinctness of the table's cosets certifies that this centralizer has index three. -/
theorem index_centralizer_swap :
    (Subgroup.centralizer {(swap 0 1 : Perm (Fin 3))}).index = 3 := by
  rw [← zpowers_swap_eq_centralizer]
  apply table.index_eq_of_check generates check_table relations_hold subgroup_words_mem
  intro i j hij
  have hmem : (((table.word i).map generators).prod)⁻¹ *
      ((table.word j).map generators).prod ∈ Subgroup.zpowers (swap 0 1 : Perm (Fin 3)) := by
    apply QuotientGroup.eq.mp
    simpa [CosetTable.point_def, MulAction.Quotient.smul_mk] using hij
  rw [zpowers_swap_eq_centralizer, Subgroup.mem_centralizer_singleton_iff] at hmem
  fin_cases i <;> fin_cases j <;> first | rfl | exact False.elim (by revert hmem; decide)

end TauCeti.Examples.CosetRecognition
