module

public import TauCeti.GroupTheory.GroupAction.Stabilizer.Membership
public import Mathlib.GroupTheory.Perm.Fin

/-!
# A certified membership test for a transposition subgroup

One point and two transversal elements suffice to sift the subgroup of `Sym(3)` generated by
`(0 1)`. The finite checks certify both acceptance of that transposition and rejection of
`(1 2)`. An incomplete transversal rejects a genuine member, illustrating why a failed sift
without certified completeness cannot prove nonmembership.
-/

namespace TauCeti.Examples.StabilizerMembership

private abbrev swap : Equiv.Perm (Fin 3) := Equiv.swap 0 1

private def transversals (_ : ℕ) : List (Equiv.Perm (Fin 3)) := [1, swap]

private theorem mem_transversals (i : ℕ) (r : Equiv.Perm (Fin 3))
    (hr : r ∈ transversals i) : r ∈ Subgroup.zpowers swap := by
  simp only [transversals, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl
  · exact one_mem _
  · exact Subgroup.mem_zpowers _

private theorem generators : Subgroup.zpowers swap ≤ Subgroup.closure {g | g ∈ [swap]} :=
  Subgroup.zpowers_le.mpr (Subgroup.subset_closure (by simp))

private theorem transversal_check :
    transversalCheck (fun _ ↦ (0 : Fin 3)) transversals 1 = true := by
  decide +kernel

private theorem generator_check :
    [swap].all (sift (fun _ ↦ (0 : Fin 3)) transversals 0 1 1) = true := by
  decide +kernel

private theorem multiplication_check :
    ∀ i < 1, siftCheck (fun _ ↦ (0 : Fin 3)) transversals 1 i = true := by
  intro i hi
  have : i = 0 := by omega
  subst i
  decide +kernel

/-- Every permutation of three points is in the transposition subgroup exactly when the
certified one-level sift accepts it. -/
private theorem sift_iff (g : Equiv.Perm (Fin 3)) :
    sift (fun _ ↦ (0 : Fin 3)) transversals 0 1 1 g = true ↔ g ∈ Subgroup.zpowers swap :=
  Subgroup.sift_eq_true_iff_mem_of_siftCheck (fun i _ ↦ mem_transversals i)
    generators transversal_check generator_check multiplication_check g

example : swap ∈ Subgroup.zpowers swap :=
  (sift_iff swap).mp (by decide +kernel)

/-- The certified sift separates two different transpositions in `Sym(3)`. -/
public theorem swap_notMem_zpowers_swap :
    Equiv.swap (1 : Fin 3) 2 ∉ Subgroup.zpowers (Equiv.swap (0 : Fin 3) 1) := by
  rw [← sift_iff]
  decide +kernel

example : sift (fun _ ↦ (0 : Fin 3)) (fun _ ↦ [1]) 0 1 1 swap = false := by
  decide +kernel

end TauCeti.Examples.StabilizerMembership
