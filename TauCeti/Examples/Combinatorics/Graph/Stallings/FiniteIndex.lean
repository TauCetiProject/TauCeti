/-!
# Index and rank computations with subgroup graphs of free groups

Over a nonempty alphabet, the kernel of the homomorphism from the free group to `ℤ/2` sending
every basis element to `1` has index two, and its subgroup graph is complete with two vertices.
Over a finite nonempty alphabet `α` the Schreier index formula then gives it rank `2 |α| - 1`;
on two letters the rank is three. For distinct basis elements `a` and `b`, the subgroup
generated by `a` and `b a b⁻¹` has infinite index, and its subgroup graph is not complete.

Folding the bouquet of the words `a²` and `b` gives a graph with two vertices: a cycle of two
edges labelled `a` through the base vertex, and a loop labelled `b` at the base vertex. Hence
the subgroup generated by `a²` and `b` has rank two, three edges minus two vertices plus one.
No edge labelled `b` leaves the second vertex, so the graph is not complete and the subgroup
has infinite index, although the graph is finite.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*,
  Section 6, Lemma 6.1; Section 8, Lemma 8.2, Proposition 8.3 and Corollary 8.4.
-/

public section

namespace TauCeti.Examples.StallingsFiniteIndex

open FreeGroup TauCeti.StallingsGraph

variable {α : Type*}

/-- Over a nonempty alphabet, the kernel of the homomorphism to `ℤ/2` sending every basis
element to `1` has index two. -/
theorem index_ker_lift_const_zmod_two [Nonempty α] :
    (lift fun _ : α => Multiplicative.ofAdd (1 : ZMod 2)).ker.index = 2 := by
  obtain ⟨a⟩ := ‹Nonempty α›
  have hsurj : Function.Surjective (lift fun _ : α => Multiplicative.ofAdd (1 : ZMod 2)) :=
    fun x => ⟨of a ^ x.toAdd.val, by simp [← ofAdd_nsmul]⟩
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top,
    Nat.card_congr Multiplicative.toAdd, Nat.card_zmod]

/-- The subgroup graph of the kernel of the homomorphism to `ℤ/2` sending every basis element
to `1` is complete. -/
theorem isComplete_subgroupGraph_ker_lift_const_zmod_two :
    (lift fun _ : α => Multiplicative.ofAdd (1 : ZMod 2)).ker.subgroupGraph.IsComplete :=
  Subgroup.subgroupGraph_isComplete _

/-- Over a nonempty alphabet, the subgroup graph of the kernel of the homomorphism to `ℤ/2`
sending every basis element to `1` has two vertices. -/
theorem natCard_subgroupGraph_ker_lift_const_zmod_two [Nonempty α] :
    Nat.card (lift fun _ : α => Multiplicative.ofAdd (1 : ZMod 2)).ker.subgroupGraph.graph.V =
      2 := by
  rw [← Subgroup.index_eq_natCard_subgroupGraph, index_ker_lift_const_zmod_two]

/-- Over a finite nonempty alphabet `α`, the kernel of the homomorphism to `ℤ/2` sending every
basis element to `1` has rank `2 |α| - 1`, by the Schreier index formula. -/
theorem rank_ker_lift_const_zmod_two [Finite α] [Nonempty α] :
    (Group.rank (lift fun _ : α => Multiplicative.ofAdd (1 : ZMod 2)).ker : ℤ) =
      2 * Nat.card α - 1 := by
  have h := Subgroup.rank_sub_one_eq_index_mul_natCard_sub_one
    (lift fun _ : α => Multiplicative.ofAdd (1 : ZMod 2)).ker
  rw [index_ker_lift_const_zmod_two] at h
  linear_combination h

/-- The kernel of the homomorphism from the free group on two generators to `ℤ/2` sending both
generators to `1` has rank three. -/
theorem rank_ker_lift_const_zmod_two_fin_two :
    Group.rank (lift fun _ : Fin 2 => Multiplicative.ofAdd (1 : ZMod 2)).ker = 3 := by
  have h := rank_ker_lift_const_zmod_two (α := Fin 2)
  rw [Nat.card_fin] at h
  omega

/-- For distinct basis elements `a` and `b`, the subgroup generated by `a` and `b a b⁻¹` has
infinite index: it lies in the kernel of the exponent sum of `b`. -/
theorem index_closure_pair_conj_eq_zero {a b : α} (hab : a ≠ b) :
    (Subgroup.closure {of a, of b * of a * (of b)⁻¹}).index = 0 := by
  classical
  let ψ : FreeGroup α →* Multiplicative ℤ :=
    lift fun x => if x = b then Multiplicative.ofAdd 1 else 1
  have hsurj : Function.Surjective ψ := fun x => ⟨of b ^ x.toAdd, by simp [ψ, ← ofAdd_zsmul]⟩
  have hker : ψ.ker.index = 0 := by
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top,
      Nat.card_eq_zero_of_infinite]
  refine Nat.eq_zero_of_zero_dvd (hker ▸ Subgroup.index_dvd_of_le ((Subgroup.closure_le _).mpr ?_))
  rintro g (rfl | rfl) <;> simp [ψ, hab]

/-- For distinct basis elements `a` and `b`, the subgroup graph of the subgroup generated by
`a` and `b a b⁻¹` is not complete. -/
theorem not_isComplete_subgroupGraph_closure_pair_conj {a b : α} (hab : a ≠ b) :
    ¬(Subgroup.closure {of a, of b * of a * (of b)⁻¹}).subgroupGraph.IsComplete := by
  let ws := [[(a, true)], [(b, true), (a, true), (b, false)]]
  have hH : (stallingsGraph ws).subgroup (stallingsGraph ws).base =
      Subgroup.closure {of a, of b * of a * (of b)⁻¹} := by
    rw [subgroup_stallingsGraph]
    congr 1
    ext g
    simp [ws, FreeGroup.of, inv_mk, invRev, eq_comm]
  obtain ⟨f⟩ := nonempty_iso_subgroupGraph (stallingsGraph_isFolded ws) (stallingsGraph_isCore ws)
  intro h
  have := (f.isComplete_iff.mpr (hH ▸ h)).finiteIndex_subgroup
  exact Subgroup.finiteIndex_iff.mp (hH ▸ this) (index_closure_pair_conj_eq_zero hab)

/-! ### The subgroup generated by `a²` and `b` -/

/-- The graph with a cycle of two edges labelled `a` through the base vertex and a loop
labelled `b` at the base vertex. -/
private abbrev sqLoop (a b : α) : StallingsGraph α :=
  ofDigraph (0 : Fin 2) ![0, 1, 0] ![1, 0, 0] ![a, a, b]

private theorem sqLoop_isFolded {a b : α} (hab : a ≠ b) : (sqLoop a b).IsFolded := by
  rw [ofDigraph_isFolded_iff]
  constructor <;> intro i j <;> fin_cases i <;> fin_cases j <;> simp [hab, hab.symm]

private theorem sqLoop_isCore (a b : α) : (sqLoop a b).graph.IsCore (0 : Fin 2) := by
  apply ofDigraph_isCore
  · intro v
    fin_cases v
    · exact ((sqLoop a b).graph.exists_path_darts_eq [] rfl).nonempty
    · exact ((sqLoop a b).graph.exists_path_darts_eq [(0, true)] rfl).nonempty
  · intro i
    fin_cases i <;>
      exact (sqLoop a b).graph.mem_coreDarts_of_isChain _
        (l := [(0, true), (1, true), (2, true)]) rfl (by simp) (by simp)

/-- For distinct basis elements `a` and `b`, folding the bouquet of the words `a²` and `b`
gives two vertices joined by a cycle of two edges labelled `a`, with a loop labelled `b` at
the base vertex. -/
theorem nonempty_iso_stallingsGraph_sq_b {a b : α} (hab : a ≠ b) :
    Nonempty (Iso (stallingsGraph [[(a, true), (a, true)], [(b, true)]])
      (ofDigraph (0 : Fin 2) ![0, 1, 0] ![1, 0, 0] ![a, a, b])) := by
  refine nonempty_iso_stallingsGraph_ofDigraph (sqLoop_isFolded hab) (sqLoop_isCore a b) ?_
    ![1, of a] (one_mem _) ?_
  · simp only [List.forall_mem_cons, List.not_mem_nil, false_imp_iff, implies_true, and_true]
    exact ⟨(sqLoop a b).mk_map_label_mem_subgroup [(0, true), (1, true)] rfl,
      (sqLoop a b).mk_map_label_mem_subgroup [(2, true)] rfl⟩
  · intro i
    fin_cases i
    · simp
    · exact Subgroup.subset_closure ⟨[(a, true), (a, true)], by simp, by simp [FreeGroup.of]⟩
    · exact Subgroup.subset_closure ⟨[(b, true)], by simp, by simp [FreeGroup.of]⟩

/-- The graph of `a²` and `b` accepts the subgroup generated by `a²` and `b`. -/
private theorem subgroup_sqLoop {a b : α} (hab : a ≠ b) :
    (sqLoop a b).subgroup (sqLoop a b).base = Subgroup.closure {of a ^ 2, of b} := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_sq_b hab
  rw [← f.subgroup_eq, subgroup_stallingsGraph]
  congr 1
  ext g
  simp [FreeGroup.of, pow_two, eq_comm]

/-- For distinct basis elements `a` and `b`, the Stallings graph of the words `a²` and `b` has
two vertices. -/
theorem natCard_vertex_stallingsGraph_sq_b {a b : α} (hab : a ≠ b) :
    Nat.card (stallingsGraph [[(a, true), (a, true)], [(b, true)]]).graph.V = 2 := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_sq_b hab
  simpa using Nat.card_congr f.vertexEquiv

/-- For distinct basis elements `a` and `b`, the subgroup generated by `a²` and `b` has rank
two. -/
theorem rank_closure_sq_b {a b : α} (hab : a ≠ b) :
    Group.rank (Subgroup.closure {of a ^ 2, of b}) = 2 := by
  have h := (sqLoop a b).rank_subgroup_add_card (sqLoop a b).base (sqLoop_isFolded hab)
    (sqLoop a b).isOrientation_setOf_label_snd (sqLoop_isCore a b).connected
  -- The positive darts are the three edges traversed forwards; the count is a computation.
  have h3 : Nat.card {e : (sqLoop a b).graph.E | ((sqLoop a b).label e).2 = true} = 3 := by
    rw [Nat.card_eq_fintype_card]
    rfl
  rw [Subgroup.rank_congr (subgroup_sqLoop hab), h3, Nat.card_fin] at h
  omega

/-- For distinct basis elements `a` and `b`, the subgroup graph of the subgroup generated by
`a²` and `b` is not complete: no edge labelled `b` leaves its vertex other than the base
vertex. -/
theorem not_isComplete_subgroupGraph_closure_sq_b {a b : α} (hab : a ≠ b) :
    ¬(Subgroup.closure {of a ^ 2, of b}).subgroupGraph.IsComplete := by
  obtain ⟨f⟩ := nonempty_iso_subgroupGraph (sqLoop_isFolded hab) (sqLoop_isCore a b)
  intro h
  rw [subgroup_sqLoop hab] at f
  obtain ⟨⟨i, s⟩, hs, hl⟩ := (f.isComplete_iff.mpr h).exists_dart (1 : Fin 2) (b, true)
  fin_cases i <;> cases s <;> simp_all

/-- For distinct basis elements `a` and `b`, the subgroup generated by `a²` and `b` has
infinite index, although its Stallings graph is finite. -/
theorem index_closure_sq_b_eq_zero {a b : α} (hab : a ≠ b) :
    (Subgroup.closure {of a ^ 2, of b}).index = 0 := by
  by_contra h
  have : (Subgroup.closure {of a ^ 2, of b}).FiniteIndex := ⟨h⟩
  exact not_isComplete_subgroupGraph_closure_sq_b hab (Subgroup.subgroupGraph_isComplete _)

end TauCeti.Examples.StallingsFiniteIndex
