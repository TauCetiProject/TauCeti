module

public import TauCeti.Combinatorics.Graph.Stallings.Intersection
public import TauCeti.Combinatorics.Graph.Stallings.OfDigraph
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.Data.Fin.VecNotation
import TauCeti.Algebra.Group.Subgroup.ZPowers
import Mathlib.Tactic.FinCases

/-!
# Intersections of subgroups of free groups through product graphs

The product of two folded labelled graphs accepts the intersection of their subgroups, and
its based core is the subgroup graph of the intersection. Three examples:

* `⟨a²⟩ ∩ ⟨a³⟩ = ⟨a⁶⟩`, as in any group (`Subgroup.zpowers_pow_inf_zpowers_pow_of_coprime`),
  so the core of the product of the subgroup graphs of `⟨a²⟩` and `⟨a³⟩`, two cycles labelled
  `a`, is the cycle of length six labelled `a`.
* For distinct letters `a` and `b`, `⟨a, b a b⁻¹⟩ ∩ ⟨b⟩ = 1`.
* Foldedness cannot be dropped. The rose with one petal labelled `a` and the cycle of length
  three whose edges read `a`, `b`, `b⁻¹` both accept `⟨a⟩` at their base vertices, but the
  cycle is not folded, and for `a ≠ b` their product accepts only the identity at the pair of
  base vertices.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*,
  Section 9, Definition 9.1, Lemma 9.3, Proposition 9.4 and Corollary 9.5.
-/

public section

namespace TauCeti.Examples.StallingsIntersection

open FreeGroup TauCeti.StallingsGraph

variable {α : Type*}

/-! ### The rose with one petal -/

/-- The rose with one petal labelled `a`. -/
abbrev petal (a : α) : StallingsGraph α :=
  ofDigraph () (fun _ : Unit => ()) (fun _ => ()) fun _ => a

/-- The rose with one petal is folded. -/
theorem petal_isFolded (a : α) : (petal a).IsFolded :=
  (ofDigraph_isFolded_iff _ _ _ _).mpr ⟨fun _ _ _ _ => rfl, fun _ _ _ _ => rfl⟩

/-- The rose with one petal labelled `a` accepts the cyclic subgroup generated by `a`. -/
theorem petal_subgroup (a : α) : (petal a).subgroup () = Subgroup.zpowers (of a) := by
  refine le_antisymm ((petal a).subgroup_le_of_forall_dart (fun _ => 1)
    (O := {e | e.2 = true}) ?_ ?_ (one_mem _))
    (Subgroup.zpowers_le.mpr ((petal a).mk_map_label_mem_subgroup [((), true)] rfl))
  · rintro ⟨_, _ | _⟩ <;> simp
  · rintro ⟨_, s⟩ (rfl : s = true)
    simp [FreeGroup.of]

/-! ### Cyclic subgroups generated by powers of a letter -/

/-- The cycle of length six labelled `a`. -/
private abbrev hexagon (a : α) : StallingsGraph α :=
  ofDigraph (0 : Fin 6) id (· + 1) fun _ => a

private theorem hexagon_isFolded (a : α) : (hexagon a).IsFolded :=
  (ofDigraph_isFolded_iff _ _ _ _).mpr ⟨fun _ _ h _ => h, fun _ _ h _ => add_right_cancel h⟩

/-- The loop going once around the hexagon. -/
private abbrev hexagonLoop : List (Fin 6 × Bool) :=
  [(0, true), (1, true), (2, true), (3, true), (4, true), (5, true)]

private theorem hexagon_isCore (a : α) : (hexagon a).graph.IsCore 0 := by
  refine ofDigraph_isCore _ _ _ _ (fun v => ?_) fun i => ?_
  · exact ((hexagon a).graph.exists_path_darts_eq (hexagonLoop.take v)
      (by fin_cases v <;> rfl)).nonempty
  · exact (hexagon a).graph.mem_coreDarts_of_isChain _ (l := hexagonLoop) rfl (by simp)
      (by fin_cases i <;> simp)

private theorem hexagon_subgroup (a : α) :
    (hexagon a).subgroup 0 = Subgroup.zpowers (of a ^ 6) := by
  refine le_antisymm ((hexagon a).subgroup_le_of_forall_dart (fun i => of a ^ (i : ℕ))
    (O := {e | e.2 = true}) ?_ ?_ (by simp)) (Subgroup.zpowers_le.mpr ?_)
  · rintro ⟨_, _ | _⟩ <;> simp
  · rintro ⟨i, s⟩ (rfl : s = true)
    fin_cases i <;> simp [← FreeGroup.of.eq_1, SerreGraph.tgt_def, ← pow_succ, ← sq]
  · simpa [FreeGroup.of, pow_succ, FreeGroup.mul_mk] using
      (hexagon a).mk_map_label_mem_subgroup hexagonLoop rfl

/-- The core of the product of the subgroup graphs of `⟨a²⟩` and `⟨a³⟩` is the cycle of length
six labelled `a`. -/
theorem nonempty_iso_core_prod_subgroupGraph_zpowers_sq_cube (a : α) :
    Nonempty (Iso ((Subgroup.zpowers (of a ^ 2)).subgroupGraph.prod
        (Subgroup.zpowers (of a ^ 3)).subgroupGraph).core
      (ofDigraph (0 : Fin 6) id (· + 1) fun _ => a)) := by
  obtain ⟨f⟩ := Subgroup.nonempty_iso_core_prod_subgroupGraph (Subgroup.zpowers (of a ^ 2))
    (Subgroup.zpowers (of a ^ 3))
  obtain ⟨g⟩ := nonempty_iso_subgroupGraph (hexagon_isFolded a) (hexagon_isCore a)
  rw [Subgroup.zpowers_pow_inf_zpowers_pow_of_coprime _ (by decide : Nat.Coprime 2 3)] at f
  rw [ofDigraph_base, hexagon_subgroup] at g
  exact ⟨f.trans g.symm⟩

/-! ### A subgroup meeting a cyclic subgroup trivially -/

/-- The graph with a loop labelled `a` at the base vertex, an edge labelled `b` to a second
vertex, and a loop labelled `a` there. -/
private abbrev conjGraph (a b : α) : StallingsGraph α :=
  ofDigraph (0 : Fin 2) ![0, 0, 1] ![0, 1, 1] ![a, b, a]

private theorem conjGraph_isFolded {a b : α} (hab : a ≠ b) : (conjGraph a b).IsFolded := by
  rw [ofDigraph_isFolded_iff]
  constructor <;> intro i j <;> fin_cases i <;> fin_cases j <;> simp [hab, hab.symm]

private theorem closure_le_conjGraph (a b : α) :
    Subgroup.closure {of a, of b * of a * (of b)⁻¹} ≤ (conjGraph a b).subgroup 0 := by
  rw [Subgroup.closure_le]
  rintro _ (rfl | rfl)
  · exact (conjGraph a b).mk_map_label_mem_subgroup [(0, true)] rfl
  · convert (conjGraph a b).mk_map_label_mem_subgroup [(1, true), (2, true), (1, false)] rfl
      using 1
    simp [FreeGroup.of, FreeGroup.inv_mk, FreeGroup.invRev]

/-- For distinct letters `a` and `b`, the subgroup generated by `a` and `b a b⁻¹` meets the
cyclic subgroup generated by `b` trivially. -/
theorem closure_pair_conj_inf_zpowers_eq_bot {a b : α} (hab : a ≠ b) :
    Subgroup.closure {of a, of b * of a * (of b)⁻¹} ⊓ Subgroup.zpowers (of b) = ⊥ := by
  refine eq_bot_iff.mpr ((inf_le_inf (closure_le_conjGraph a b) (petal_subgroup b).ge).trans ?_)
  rw [← prod_subgroup (conjGraph_isFolded hab) (petal_isFolded b) 0 ()]
  refine ((conjGraph a b).prod (petal b)).subgroup_le_of_forall_dart (fun v => ![1, of b] v.1)
    (O := {e | e.1.1.2 = true}) ?_ ?_ (one_mem _)
  · rintro ⟨⟨⟨_, _ | _⟩, _⟩, _⟩
    exacts [Or.inr rfl, Or.inl rfl]
  · intro e he
    simp only [prod_src, prod_tgt, prod_label]
    obtain ⟨⟨⟨i, s⟩, u, t⟩, hl⟩ := e
    obtain rfl : s = true := he
    -- The labels of the two factors, unfolded from `ofDigraph`.
    replace hl : (![a, b, a] i, true) = (b, t) := hl
    fin_cases i <;> simp_all [← FreeGroup.of.eq_1, SerreGraph.tgt_def]

/-! ### Foldedness is necessary -/

/-- The cycle of length three whose edges, read from the base vertex `0`, carry the letters
`a`, `b` and `b⁻¹`: an edge labelled `a` from `0` to `1`, an edge labelled `b` from `1` to
`2`, and an edge labelled `b` from `0` to `2`. -/
abbrev unfoldedCycle (a b : α) : StallingsGraph α :=
  ofDigraph (0 : Fin 3) ![0, 1, 0] ![1, 2, 2] ![a, b, b]

/-- The cycle reading `a b b⁻¹` accepts the cyclic subgroup generated by `a` at its base
vertex. -/
theorem unfoldedCycle_subgroup (a b : α) :
    (unfoldedCycle a b).subgroup 0 = Subgroup.zpowers (of a) := by
  refine le_antisymm ((unfoldedCycle a b).subgroup_le_of_forall_dart ![1, 1, of b]
    (O := {e | e.2 = true}) ?_ ?_ (one_mem _)) (Subgroup.zpowers_le.mpr ?_)
  · rintro ⟨_, _ | _⟩ <;> simp
  · rintro ⟨i, s⟩ (rfl : s = true)
    fin_cases i <;> simp [← FreeGroup.of.eq_1, SerreGraph.tgt_def]
  · convert (unfoldedCycle a b).mk_map_label_mem_subgroup (a := 0)
      [(0, true), (1, true), (2, false)] rfl using 1
    rw [← mul_inv_cancel_right (of a) (of b)]
    simp [FreeGroup.of, FreeGroup.inv_mk, FreeGroup.invRev]

/-- The cycle reading `a b b⁻¹` is not folded: two edges labelled `b` end at the vertex `2`. -/
theorem unfoldedCycle_not_isFolded (a b : α) : ¬(unfoldedCycle a b).IsFolded := fun h =>
  absurd (((ofDigraph_isFolded_iff _ _ _ _).mp h).2 1 2 rfl rfl) (by decide)

/-- For distinct letters `a` and `b`, the product of the rose with one petal labelled `a` and
the cycle reading `a b b⁻¹` accepts only the identity at the pair of base vertices. -/
theorem petal_prod_unfoldedCycle_subgroup {a b : α} (hab : a ≠ b) :
    ((petal a).prod (unfoldedCycle a b)).subgroup ((), 0) = ⊥ := by
  refine eq_bot_iff.mpr (((petal a).prod (unfoldedCycle a b)).subgroup_le_of_forall_dart
    (fun v => ![1, of a, 1] v.2) (O := {e | e.1.2.2 = true}) ?_ ?_ (one_mem _))
  · rintro ⟨⟨_, _, _ | _⟩, _⟩
    exacts [Or.inr rfl, Or.inl rfl]
  · intro e he
    simp only [prod_src, prod_tgt, prod_label]
    obtain ⟨⟨⟨u, s⟩, i, t⟩, hl⟩ := e
    obtain rfl : t = true := he
    -- The labels of the two factors, unfolded from `ofDigraph`.
    replace hl : (a, s) = (![a, b, b] i, true) := hl
    fin_cases i <;> simp_all [← FreeGroup.of.eq_1, SerreGraph.tgt_def]

/-- For distinct letters `a` and `b`, the product of the rose with one petal labelled `a` and
the cycle reading `a b b⁻¹` does not accept the intersection of the subgroups accepted by the
two factors: the equality `StallingsGraph.prod_subgroup` fails without foldedness. -/
theorem petal_prod_unfoldedCycle_subgroup_ne_inf {a b : α} (hab : a ≠ b) :
    ((petal a).prod (unfoldedCycle a b)).subgroup ((), 0) ≠
      (petal a).subgroup () ⊓ (unfoldedCycle a b).subgroup 0 := by
  rw [petal_prod_unfoldedCycle_subgroup hab, petal_subgroup, unfoldedCycle_subgroup, inf_idem]
  exact fun h => of_ne_one a (Subgroup.zpowers_eq_bot.mp h.symm)

end TauCeti.Examples.StallingsIntersection
