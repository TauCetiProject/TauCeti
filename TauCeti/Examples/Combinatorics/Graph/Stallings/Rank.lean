module

public import TauCeti.Combinatorics.Graph.Stallings.Construction.Examples

/-!
# Ranks of subgroups of free groups read off their Stallings graphs

The rank of the subgroup accepted by a finite connected folded graph is the number of edges
minus the number of vertices plus one. This file computes it for four graphs.

* The Stallings graph of `[a b, a c]`, for `b ≠ c`, has two vertices and three edges, so the
  subgroup generated by `a b` and `a c` has rank `3 - 2 + 1 = 2`.
* The Stallings graph of `[a², a³]` is a single loop, so the subgroup generated by `a²` and
  `a³` has rank `1 - 1 + 1 = 1`: the rank is not the length of the generating list.
* The Stallings graph of `[a², a b, a b⁻¹]`, for `a ≠ b`, has two vertices and four edges, an
  `a`-edge and a `b`-edge in each direction, so the subgroup generated by these words has rank
  `4 - 2 + 1 = 3`.
* The graph with one vertex and no edges accepts a subgroup of rank `0 - 1 + 1 = 0`, the
  trivial subgroup.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*,
  Section 8, Lemma 8.2.
-/

public section

namespace TauCeti.Examples.StallingsRank

open FreeGroup TauCeti.StallingsGraph

variable {α : Type*} (a b c : α)

/-- The rank of the subgroup generated by a list of words, read off a graph drawn with vertices
`V` and edges `ι` that is isomorphic to the Stallings graph of the list: it is `#ι + 1 - #V`. -/
private theorem rank_closure_add_natCard {ws : List (List (α × Bool))} {s : Set (FreeGroup α)}
    [Finite s] (hs : {g | ∃ w ∈ ws, mk w = g} = s) {V ι : Type*} {base : V} {src tgt : ι → V}
    {label : ι → α} (f : Iso (stallingsGraph ws) (ofDigraph base src tgt label)) :
    Group.rank (Subgroup.closure s) + Nat.card V = Nat.card ι + 1 := by
  subst hs
  rw [← Subgroup.rank_congr (subgroup_stallingsGraph ws)]
  have h := rank_subgroup_add_card _ (stallingsGraph ws).base (stallingsGraph_isFolded ws)
    (isOrientation_setOf_label_snd _) (stallingsGraph_connected ws)
  -- The isomorphism preserves labels, so it matches the positive darts with the drawn edges.
  let g : {e : ι × Bool // e.2 = true} ≃ ι :=
    { toFun e := e.1.1
      invFun i := ⟨(i, true), rfl⟩
      left_inv := fun e => Subtype.ext (Prod.ext rfl e.2.symm)
      right_inv := fun _ => rfl }
  have hE : Nat.card {e | ((stallingsGraph ws).label e).2 = true} = Nat.card ι :=
    Nat.card_congr ((f.dartEquiv.subtypeEquiv fun e => by
      rw [Set.mem_ofPred_eq, ← f.map_label e]).trans g)
  have hV : Nat.card (stallingsGraph ws).graph.V = Nat.card V := Nat.card_congr f.vertexEquiv
  omega

/-- The rank of the subgroup generated by `a b` and `a c`, for `b ≠ c`, is two. -/
theorem rank_closure_ab_ac (hbc : b ≠ c) :
    Group.rank (Subgroup.closure {of a * of b, of a * of c}) = 2 := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_ab_ac a b c hbc
  have h := rank_closure_add_natCard (s := {of a * of b, of a * of c})
    (by ext; simp [FreeGroup.of, mul_mk, eq_comm]) f
  simp only [Nat.card_eq_fintype_card, Fintype.card_fin] at h
  omega

/-- The rank of the subgroup generated by `a²` and `a³` is one, although it is given by two
generators. -/
theorem rank_closure_sq_cube : Group.rank (Subgroup.closure {of a ^ 2, of a ^ 3}) = 1 := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_sq_cube a
  have h := rank_closure_add_natCard (s := {of a ^ 2, of a ^ 3})
    (by ext; simp [FreeGroup.of, mul_mk, pow_succ, eq_comm]) f
  simp only [Nat.card_unique] at h
  omega

/-! ### The words `a²`, `a b` and `a b⁻¹` -/

/-- The graph with an `a`-edge and a `b`-edge from the base vertex to a second vertex, and an
`a`-edge and a `b`-edge back. -/
private abbrev evenGraph : StallingsGraph α :=
  ofDigraph (0 : Fin 2) ![0, 1, 0, 1] ![1, 0, 1, 0] ![a, a, b, b]

private theorem evenGraph_isFolded (hab : a ≠ b) : (evenGraph a b).IsFolded := by
  rw [ofDigraph_isFolded_iff]
  constructor <;> intro i j <;> fin_cases i <;> fin_cases j <;> simp [hab, hab.symm]

private theorem evenGraph_isCore : (evenGraph a b).graph.IsCore (0 : Fin 2) := by
  apply ofDigraph_isCore
  · intro v
    fin_cases v
    · exact ((evenGraph a b).graph.exists_path_darts_eq [] rfl).nonempty
    · exact ((evenGraph a b).graph.exists_path_darts_eq [(0, true)] rfl).nonempty
  · intro i
    fin_cases i
    · exact (evenGraph a b).graph.mem_coreDarts_of_isChain _ (l := [(0, true), (1, true)]) rfl
        (by simp) (by simp)
    · exact (evenGraph a b).graph.mem_coreDarts_of_isChain _ (l := [(0, true), (1, true)]) rfl
        (by simp) (by simp)
    · exact (evenGraph a b).graph.mem_coreDarts_of_isChain _ (l := [(2, true), (1, true)]) rfl
        (by simp) (by simp)
    · exact (evenGraph a b).graph.mem_coreDarts_of_isChain _ (l := [(0, true), (3, true)]) rfl
        (by simp) (by simp)

/-- The Stallings graph of the words `a²`, `a b` and `a b⁻¹`, for `a ≠ b`, has two vertices and
four edges: an `a`-edge and a `b`-edge from the base vertex to the other vertex, and an
`a`-edge and a `b`-edge back. -/
theorem nonempty_iso_stallingsGraph_sq_ab_ab_inv (hab : a ≠ b) :
    Nonempty (Iso (stallingsGraph
        [[(a, true), (a, true)], [(a, true), (b, true)], [(a, true), (b, false)]])
      (ofDigraph (0 : Fin 2) ![0, 1, 0, 1] ![1, 0, 1, 0] ![a, a, b, b])) := by
  refine nonempty_iso_stallingsGraph_ofDigraph (evenGraph_isFolded a b hab)
    (evenGraph_isCore a b) ?_ ![1, of a] (one_mem _) ?_
  · simp only [List.forall_mem_cons, List.not_mem_nil, false_imp_iff, implies_true, and_true]
    exact ⟨(evenGraph a b).mk_map_label_mem_subgroup [(0, true), (1, true)] rfl,
      (evenGraph a b).mk_map_label_mem_subgroup [(0, true), (3, true)] rfl,
      (evenGraph a b).mk_map_label_mem_subgroup [(0, true), (2, false)] rfl⟩
  · intro i
    fin_cases i
    · simp
    · apply Subgroup.subset_closure
      simp [FreeGroup.of, FreeGroup.mul_mk]
    · rw [← Subgroup.inv_mem_iff]
      apply Subgroup.subset_closure
      simp [FreeGroup.of, FreeGroup.mul_mk, inv_mk, invRev]
    · apply Subgroup.subset_closure
      simp [FreeGroup.of, FreeGroup.mul_mk]

/-- The rank of the subgroup generated by `a²`, `a b` and `a b⁻¹`, for `a ≠ b`, is three. -/
theorem rank_closure_sq_ab_ab_inv (hab : a ≠ b) :
    Group.rank (Subgroup.closure {of a ^ 2, of a * of b, of a * (of b)⁻¹}) = 3 := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_sq_ab_ab_inv a b hab
  have h := rank_closure_add_natCard (s := {of a ^ 2, of a * of b, of a * (of b)⁻¹})
    (by ext; simp [FreeGroup.of, mul_mk, inv_mk, invRev, pow_two, eq_comm]) f
  simp only [Nat.card_eq_fintype_card, Fintype.card_fin] at h
  omega

/-! ### The graph with one vertex and no edges -/

/-- The graph with one vertex and no edges. -/
private abbrev edgeless : StallingsGraph α := ofDigraph () Empty.elim Empty.elim Empty.elim

/-- The graph with one vertex and no edges accepts a subgroup of rank zero. -/
theorem rank_subgroup_ofDigraph_empty :
    Group.rank ((ofDigraph () Empty.elim Empty.elim Empty.elim : StallingsGraph α).subgroup ()) =
      0 := by
  have hS : (edgeless : StallingsGraph α).IsFolded :=
    (ofDigraph_isFolded_iff _ _ _ _).mpr ⟨fun i => i.elim, fun i => i.elim⟩
  have hc : (edgeless : StallingsGraph α).graph.Connected :=
    (SerreGraph.connected_iff _).mpr ⟨⟨()⟩, SerreGraph.preconnected_of_forall_nonempty_path _ ()
      fun _ => ((edgeless : StallingsGraph α).graph.exists_path_darts_eq [] rfl).nonempty⟩
  simpa using rank_subgroup_add_card _ () hS (isOrientation_setOf_label_snd _) hc

/-- The graph with one vertex and no edges accepts the trivial subgroup. -/
theorem subgroup_ofDigraph_empty_eq_bot :
    (ofDigraph () Empty.elim Empty.elim Empty.elim : StallingsGraph α).subgroup () = ⊥ := by
  have := Group.rank_eq_zero_iff.mp (rank_subgroup_ofDigraph_empty (α := α))
  exact Subgroup.eq_bot_of_subsingleton _

end TauCeti.Examples.StallingsRank
