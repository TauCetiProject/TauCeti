module

public import TauCeti.Combinatorics.Graph.Serre.Cycle.Examples
public import TauCeti.Combinatorics.Graph.Serre.Parallel
public import TauCeti.GroupTheory.GraphOfGroups.Rank

/-!
# Fundamental groups and cycle modules of parallel edges and of the segment

For the graph `SerreGraph.parallelGraph α` of parallel edges indexed by `α`, joining the two
vertices `false` and `true`, this file computes the rank of the fundamental group and of the cycle
modules, and the fundamental cycles relative to a single edge.

When `α` has `n` elements, `0 < n`, every spanning tree leaves `n - 1` positive darts outside
it, so the reduced path group at either vertex, free on these darts, has rank `n - 1`; so does the
presentation of the fundamental group relative to any spanning tree. Relative to any orientation
the integral and binary cycle modules also have rank `n - 1`. Each single dart is a spanning
forest of any set of darts containing it, and the fundamental cycle of another dart in the same
direction traverses that dart forward and the forest dart backward. Two distinct darts never form
a spanning forest, although their simple support, a single edge, is acyclic.

For two edges (the double edge) all these ranks are one: the fundamental group is infinite cyclic,
generated by the tree loop of the one positive dart outside a spanning tree, and the binary
fundamental cycle is the vector `(1, 1)`. The two one-dart paths along different edges forget to
different walks. For three edges (the theta graph) the ranks are two, and the three simple cycles,
signed, sum to zero. The segment, a tree, has a unique reduced path between its two vertices,
trivial fundamental group in both presentations, and no cycles.

## References

* J.-P. Serre, *Trees*, Chapter I, §§2.2–3.1.
* A. Hatcher, *Algebraic Topology*, §1.A, Proposition 1A.2.
* I. Kapovich, A. Myasnikov, *Stallings foldings and subgroups of free groups*, §8, Lemma 8.2.
* R. Diestel, *Graph Theory*, §1.9 (cycle spaces and fundamental cycles).
-/

public section

namespace TauCeti.Examples.SerreParallel

open TauCeti.SerreGraph

universe w

variable {α : Type w}

/-! ### Fundamental groups -/

/-- Every spanning tree of `n` parallel edges leaves `n - 1` positive darts outside it, for any
orientation: these darts index the free basis of the reduced path group. -/
theorem card_diff_darts_parallelGraph_add_one [Finite α] (T : (parallelGraph α).SpanningTree)
    {O : Set (parallelGraph α).E} (hO : (parallelGraph α).IsOrientation O) :
    Nat.card ↥(O \ T.darts) + 1 = Nat.card α := by
  have h := T.card_diff_add_card hO
  have hV : Nat.card (parallelGraph α).V = 2 := Nat.card_eq_fintype_card.trans rfl
  rw [hV, Nat.card_eq_of_bijective _ hO.bijective_toGeomEdge,
    Nat.card_congr (parallelGraphGeomEdgeEquiv α)] at h
  omega

/-- The reduced path group of `n` parallel edges, `0 < n`, has rank `n - 1`. -/
theorem rank_pathGroup_parallelGraph_add_one [Nonempty α] (v : (parallelGraph α).V)
    [Group.FG (PathGroup (parallelGraph α) v)] :
    Group.rank (PathGroup (parallelGraph α) v) + 1 = Nat.card α := by
  have h := (parallelGraph_connected_iff.mpr ‹Nonempty α›).rank_pathGroup_add_card v
  have hV : Nat.card (parallelGraph α).V = 2 := Nat.card_eq_fintype_card.trans rfl
  rw [hV, Nat.card_congr (parallelGraphGeomEdgeEquiv α)] at h
  omega

/-- Relative to any spanning tree, the presentation of the fundamental group of `n` parallel
edges has rank `n - 1`. -/
theorem rank_graphPresentation_parallelGraph_add_one (T : (parallelGraph α).SpanningTree)
    [Group.FG ((parallelGraph α).GraphPresentation T.darts)] :
    Group.rank ((parallelGraph α).GraphPresentation T.darts) + 1 = Nat.card α := by
  have : Nonempty α := parallelGraph_connected_iff.mp ((nonempty_spanningTree_iff _).mp ⟨T⟩)
  have : Group.FG (PathGroup (parallelGraph α) false) :=
    Group.fg_of_surjective (f := (T.pathGroupEquivGraphPresentation false).symm.toMonoidHom)
      (MulEquiv.surjective _)
  rw [← Group.rank_congr (T.pathGroupEquivGraphPresentation false)]
  exact rank_pathGroup_parallelGraph_add_one false

/-- For the double edge, the positive dart outside a spanning tree is unique: it gives the one
free generator. -/
example (T : (parallelGraph (Fin 2)).SpanningTree) {O : Set (parallelGraph (Fin 2)).E}
    (hO : (parallelGraph (Fin 2)).IsOrientation O) : Nat.card ↥(O \ T.darts) = 1 := by
  simpa using card_diff_darts_parallelGraph_add_one T hO

/-- The double edge has infinite cyclic fundamental group. -/
example (v : (parallelGraph (Fin 2)).V) :
    Nonempty (PathGroup (parallelGraph (Fin 2)) v ≃* Multiplicative ℤ) := by
  obtain ⟨T⟩ := (parallelGraph (Fin 2)).exists_spanningTree (parallelGraph_connected_iff.mpr ⟨0⟩)
  obtain ⟨O, hO⟩ := (parallelGraph (Fin 2)).exists_isOrientation
  have h := card_diff_darts_parallelGraph_add_one T hO
  rw [Nat.card_eq_fintype_card (α := Fin 2), Fintype.card_fin] at h
  obtain ⟨_, ⟨e⟩⟩ := Nat.card_eq_one_iff_unique.mp (by omega : Nat.card ↥(O \ T.darts) = 1)
  have : Unique ↥(O \ T.darts) := { default := e, uniq := fun _ => Subsingleton.elim _ _ }
  exact ⟨(T.pathGroupEquivFreeGroup v hO).trans FreeGroup.mulEquivIntOfUnique⟩

/-- The double edge has fundamental group of rank one, in the path presentation. -/
example (v : (parallelGraph (Fin 2)).V) :
    haveI := (parallelGraph_connected_iff.mpr ⟨0⟩).fg_pathGroup v
    Group.rank (PathGroup (parallelGraph (Fin 2)) v) = 1 := by
  have := (parallelGraph_connected_iff.mpr ⟨0⟩).fg_pathGroup v
  simpa using rank_pathGroup_parallelGraph_add_one (α := Fin 2) v

/-- Relative to either of its spanning trees, the presentation of the fundamental group of the
double edge has rank one. -/
example (T : (parallelGraph (Fin 2)).SpanningTree)
    [Group.FG ((parallelGraph (Fin 2)).GraphPresentation T.darts)] :
    Group.rank ((parallelGraph (Fin 2)).GraphPresentation T.darts) = 1 := by
  simpa using rank_graphPresentation_parallelGraph_add_one T

/-- The theta graph has fundamental group of rank two, in the path presentation. -/
example (v : (parallelGraph (Fin 3)).V) :
    haveI := (parallelGraph_connected_iff.mpr ⟨0⟩).fg_pathGroup v
    Group.rank (PathGroup (parallelGraph (Fin 3)) v) = 2 := by
  have := (parallelGraph_connected_iff.mpr ⟨0⟩).fg_pathGroup v
  simpa using rank_pathGroup_parallelGraph_add_one (α := Fin 3) v

/-- The presentation of the fundamental group of the theta graph relative to any of its spanning
trees is finitely generated, being isomorphic to the reduced path group. -/
example (T : (parallelGraph (Fin 3)).SpanningTree) :
    Group.FG ((parallelGraph (Fin 3)).GraphPresentation T.darts) := by
  have := (parallelGraph_connected_iff (α := Fin 3)).mpr ⟨0⟩ |>.fg_pathGroup false
  exact Group.fg_of_surjective (f := (T.pathGroupEquivGraphPresentation false).toMonoidHom)
    (MulEquiv.surjective _)

/-- The theta graph has fundamental group of rank two, in the presentation relative to any of its
spanning trees. -/
example (T : (parallelGraph (Fin 3)).SpanningTree)
    [Group.FG ((parallelGraph (Fin 3)).GraphPresentation T.darts)] :
    Group.rank ((parallelGraph (Fin 3)).GraphPresentation T.darts) = 2 := by
  simpa using rank_graphPresentation_parallelGraph_add_one T

/-- The one-dart paths along the two edges of the double edge forget to different walks: parallel
edges remain distinct in the underlying multigraph. -/
example : Path.toWalk (parallelGraph (Fin 2)) (parallelDart 0).toPath ≠
    Path.toWalk (parallelGraph (Fin 2)) (parallelDart 1).toPath := by
  intro h
  have := congrArg Graph.Walk.edges h
  simp [Graph.IsLink.toWalk_eq_cons] at this

/-! ### Cycle modules -/

/-- Any single dart is a spanning forest of every set of darts containing it: all darts join the
two vertices. -/
theorem isSpanningForest_parallelGraph_singleton {O : Set (parallelGraph α).E}
    {e : (parallelGraph α).E} (he : e ∈ O) : (parallelGraph α).IsSpanningForest O {e} :=
  isSpanningForest_singleton he (fun h => Bool.not_ne_self _ h.symm) fun f _ _ => by
    simp only [← edgeEnds_edge, parallelGraph_edgeEnds]

/-- Relative to any orientation, the cycle modules of `n` parallel edges, `0 < n`, have rank
`n - 1` over any coefficient ring with the strong rank condition. -/
theorem finrank_ker_incidenceBoundary_parallelGraph_add_one (R : Type*) [Ring R]
    [StrongRankCondition R] [Finite α] [Nonempty α] {O : Set (parallelGraph α).E}
    (hO : (parallelGraph α).IsOrientation O) :
    Module.finrank R ((parallelGraph α).incidenceBoundary O R).ker + 1 = Nat.card α := by
  obtain ⟨a⟩ := ‹Nonempty α›
  obtain ⟨e, he⟩ : ∃ e, e ∈ O := (hO.mem_or_rev_mem (a, false)).elim (⟨_, ·⟩) (⟨_, ·⟩)
  rw [(isSpanningForest_parallelGraph_singleton he).finrank_ker_incidenceBoundary,
    Nat.card_coe_set_eq, Set.ncard_sdiff_singleton_add_one he, ← Nat.card_coe_set_eq,
    Nat.card_eq_of_bijective _ hO.bijective_toGeomEdge,
    Nat.card_congr (parallelGraphGeomEdgeEquiv α)]

/-- Relative to the single dart `e`, the fundamental cycle of another dart in the same direction
traverses it forward and `e` backward. -/
theorem cycleBasis_parallelGraph_singleton (R : Type*) [Ring R] {O : Set (parallelGraph α).E}
    {e : (parallelGraph α).E} (he : e ∈ O) (f : ↥(O \ {e})) (hf : f.val.2 = e.2) :
    ((isSpanningForest_parallelGraph_singleton he).cycleBasis R f).val =
      Finsupp.single ⟨f.val, f.property.1⟩ 1 - Finsupp.single ⟨e, he⟩ 1 :=
  (isSpanningForest_parallelGraph_singleton he).cycleBasis_of_parallel f rfl hf
    (congrArg (!·) hf)

/-- Two distinct darts never form a spanning forest: they join the same two vertices. -/
theorem not_isSpanningForest_parallelGraph_pair {O : Set (parallelGraph α).E}
    {e f : (parallelGraph α).E} (hef : e ≠ f) : ¬(parallelGraph α).IsSpanningForest O {e, f} :=
  fun h => hef <| h.endpoints_injOn (Set.mem_insert _ _) (Set.mem_insert_of_mem _ rfl) <| by
    simp only [← edgeEnds_edge, parallelGraph_edgeEnds]

/-- Taking both edges of the double edge as a forest is forbidden. -/
example (O : Set (parallelGraph (Fin 2)).E) :
    ¬(parallelGraph (Fin 2)).IsSpanningForest O {(0, false), (1, false)} :=
  not_isSpanningForest_parallelGraph_pair (by decide)

/-- The simple support of the two edges of the double edge is a single edge, hence acyclic. -/
example : ((parallelGraph (Fin 2)).supportGraph {(0, false), (1, false)}).IsAcyclic := by
  have h : (parallelGraph (Fin 2)).supportGraph {(0, false), (1, false)} =
      (parallelGraph (Fin 2)).supportGraph {(0, false)} := by
    ext x y
    simp
  exact h ▸ (isSpanningForest_parallelGraph_singleton (Set.mem_singleton (0, false))).isAcyclic

/-- The two vertices of the double edge are adjacent in the simple support of the darts leaving
`false`. -/
example : ((parallelGraph (Fin 2)).supportGraph {e | e.2 = false}).Adj false true :=
  supportGraph_adj_src_tgt (Γ := parallelGraph (Fin 2)) (e := (0, false)) rfl Bool.false_ne_true

/-- The double edge has integral cycle rank one, for any orientation. -/
example {O : Set (parallelGraph (Fin 2)).E} (hO : (parallelGraph (Fin 2)).IsOrientation O) :
    Module.finrank ℤ ((parallelGraph (Fin 2)).cycleLattice O) = 1 := by
  rw [cycleLattice_def]
  simpa using finrank_ker_incidenceBoundary_parallelGraph_add_one ℤ hO

/-- The double edge has binary cycle rank one, for any orientation. -/
example {O : Set (parallelGraph (Fin 2)).E} (hO : (parallelGraph (Fin 2)).IsOrientation O) :
    Module.finrank (ZMod 2) ((parallelGraph (Fin 2)).modTwoCycleSpace O) = 1 := by
  rw [modTwoCycleSpace_def]
  simpa using finrank_ker_incidenceBoundary_parallelGraph_add_one (ZMod 2) hO

/-- With the edge `0` as spanning forest of the darts leaving `false`, the integral fundamental
cycle of the edge `1` is `e₁ - e₀`. -/
example : ((isSpanningForest_parallelGraph_singleton (O := {e | e.2 = false})
    (e := ((0 : Fin 2), false)) rfl).cycleBasis ℤ ⟨(1, false), rfl, by decide⟩).val =
      Finsupp.single ⟨(1, false), rfl⟩ 1 - Finsupp.single ⟨(0, false), rfl⟩ 1 :=
  cycleBasis_parallelGraph_singleton ℤ _ _ rfl

/-- Reduced modulo two, the fundamental cycle of the double edge is `(1, 1)`. -/
example : ((isSpanningForest_parallelGraph_singleton (O := {e | e.2 = false})
    (e := ((0 : Fin 2), false)) rfl).cycleBasis (ZMod 2) ⟨(1, false), rfl, by decide⟩).val =
      Finsupp.single ⟨(1, false), rfl⟩ 1 + Finsupp.single ⟨(0, false), rfl⟩ 1 := by
  rw [cycleBasis_parallelGraph_singleton (ZMod 2) _ _ rfl, sub_eq_add_neg, ← Finsupp.single_neg]
  rfl

/-- The theta graph has integral cycle rank two, for any orientation. -/
example {O : Set (parallelGraph (Fin 3)).E} (hO : (parallelGraph (Fin 3)).IsOrientation O) :
    Module.finrank ℤ ((parallelGraph (Fin 3)).cycleLattice O) = 2 := by
  rw [cycleLattice_def]
  simpa using finrank_ker_incidenceBoundary_parallelGraph_add_one ℤ hO

/-- The theta graph has binary cycle rank two, for any orientation. -/
example {O : Set (parallelGraph (Fin 3)).E} (hO : (parallelGraph (Fin 3)).IsOrientation O) :
    Module.finrank (ZMod 2) ((parallelGraph (Fin 3)).modTwoCycleSpace O) = 2 := by
  rw [modTwoCycleSpace_def]
  simpa using finrank_ker_incidenceBoundary_parallelGraph_add_one (ZMod 2) hO

/-- The signed chain `e_j - e_i` of the theta graph is a cycle; for `i ≠ j` it is the simple cycle
through the edges `i` and `j`. -/
example (R : Type*) [Ring R] (i j : Fin 3) :
    Finsupp.single (⟨(j, false), rfl⟩ : ↥{e : (parallelGraph (Fin 3)).E | e.2 = false}) (1 : R) -
      Finsupp.single ⟨(i, false), rfl⟩ 1 ∈
        ((parallelGraph (Fin 3)).incidenceBoundary {e | e.2 = false} R).ker :=
  single_sub_single_mem_ker_incidenceBoundary R rfl rfl

/-- The three simple cycles of the theta graph are dependent over any nontrivial ring: signed,
they sum to zero. -/
example (R : Type*) [Ring R] [Nontrivial R] :
    ¬LinearIndependent R ![
      Finsupp.single (⟨(1, false), rfl⟩ : ↥{e : (parallelGraph (Fin 3)).E | e.2 = false})
        (1 : R) - Finsupp.single ⟨(0, false), rfl⟩ 1,
      Finsupp.single ⟨(2, false), rfl⟩ 1 - Finsupp.single ⟨(1, false), rfl⟩ 1,
      Finsupp.single ⟨(0, false), rfl⟩ 1 - Finsupp.single ⟨(2, false), rfl⟩ 1] := by
  intro h
  refine one_ne_zero (Fintype.linearIndependent_iff.mp h (fun _ => 1) ?_ 0)
  simp only [Fin.sum_univ_three, one_smul, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
  abel

/-! ### The segment -/

/-- A path in the segment from the vertex `false` to the vertex `true` is reduced exactly when it
is the dart `false`. -/
theorem isReduced_segment_iff_eq_toPath {p : segment.Path false true} :
    Path.IsReduced segment p ↔ p = (segment.dart false).toPath := by
  refine ⟨fun hp => segment_isTree.isAcyclic.eq_of_isReduced hp (Path.isReduced_toPath _ _), ?_⟩
  rintro rfl
  exact Path.isReduced_toPath _ _

/-- The segment has trivial reduced path groups. -/
example (v : segment.V) : Subsingleton (PathGroup segment v) :=
  segment_isTree.isAcyclic.subsingleton_pathGroup v

/-- Relative to its spanning tree, the segment has trivial presentation. -/
example (T : segment.SpanningTree) : Subsingleton (segment.GraphPresentation T.darts) :=
  segment_isTree.isAcyclic.subsingleton_graphPresentation T

/-- The segment has integral cycle rank zero, for either choice of orientation. -/
example (b : segment.E) : Module.finrank ℤ (segment.cycleLattice {b}) = 0 := by
  rw [cycleLattice_def, ker_incidenceBoundary_segment]
  exact Module.finrank_eq_zero_of_subsingleton _ _

end TauCeti.Examples.SerreParallel
