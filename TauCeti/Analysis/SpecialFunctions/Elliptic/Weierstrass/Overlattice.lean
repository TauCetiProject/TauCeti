module

public import Mathlib.Analysis.SpecialFunctions.Elliptic.Weierstrass
import TauCeti.Algebra.Module.ZLattice.Basic
import TauCeti.Analysis.Complex.UpperHalfPlane.PeriodPair
import TauCeti.Analysis.SpecialFunctions.Elliptic.Period.Pair
import TauCeti.Topology.Algebra.InfiniteSum.Basic

/-!
# The Weierstrass function of the lattice `Λ ∪ (Λ - u)`

Let `Λ` be a lattice, `u ∉ Λ`, and let `M` be a period pair whose lattice consists of the `x` with
`x ∈ Λ` or `x + u ∈ Λ`, that is, `Λ_M = Λ ∪ (Λ - u)`. Then `u` has order two modulo `Λ`, and
`Λ_M = Λ + ℤ u` is the target of the isogeny of degree two with kernel generated by `u`. Splitting
the lattice sums over the two disjoint cosets `Λ` and `Λ - u` gives
`℘_M(z) = ℘_Λ(z) + ℘_Λ(z + u) - ℘_Λ(u)` and `℘'_M(z) = ℘'_Λ(z) + ℘'_Λ(z + u)`.

Conversely, for every `u` with `2 u ∈ Λ` such a period pair exists
(`PeriodPair.exists_mem_lattice_iff_of_two_mul_mem`).

## Main results

* `PeriodPair.exists_mem_lattice_iff_of_two_mul_mem`: the lattice `Λ ∪ (Λ - u) = Λ + ℤ u` exists.
* `PeriodPair.two_mul_mem_lattice_of_mem_iff`: `u` has order two modulo `Λ`.
* `PeriodPair.weierstrassP_eq_add_sub_of_mem_iff`: `℘_M(z) = ℘_Λ(z) + ℘_Λ(z + u) - ℘_Λ(u)`.
* `PeriodPair.derivWeierstrassP_eq_add_of_mem_iff`: `℘'_M(z) = ℘'_Λ(z) + ℘'_Λ(z + u)`.
* `PeriodPair.deriv_derivWeierstrassP_eq_add_of_mem_iff`: `℘''_M(z) = ℘''_Λ(z) + ℘''_Λ(z + u)`
  off the lattice of `M`.
-/

public section

open scoped Pointwise

namespace PeriodPair

variable {L M : PeriodPair} {u : ℂ}

/-- **The lattice `Λ + ℤ u`.** If `2 u ∈ Λ`, then `Λ + ℤ u = Λ ∪ (Λ - u)` is the lattice of a period
pair: it lies between `Λ` and `Λ / 2`. -/
theorem exists_mem_lattice_iff_of_two_mul_mem (L : PeriodPair) {u : ℂ} (hu : 2 * u ∈ L.lattice) :
    ∃ M : PeriodPair, ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice := by
  set Λ := L.lattice ⊔ Submodule.span ℤ {u}
  have hmem (x : ℂ) : x ∈ Λ ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice := by
    simp only [Λ, Submodule.mem_sup, Submodule.mem_span_singleton]
    constructor
    · rintro ⟨l, hl, _, ⟨n, rfl⟩, rfl⟩
      -- `n u` lies in `Λ` for even `n`, and `(n + 1) u` for odd `n`
      obtain ⟨k, rfl | rfl⟩ := Int.even_or_odd' n
      · refine .inl (add_mem hl ?_)
        convert L.lattice.smul_mem k hu using 1
        simp only [zsmul_eq_mul]
        push_cast
        ring
      · refine .inr ?_
        convert add_mem hl (L.lattice.smul_mem (k + 1) hu) using 1
        simp only [zsmul_eq_mul]
        push_cast
        ring
    · rintro (h | h)
      · exact ⟨x, h, 0, ⟨0, zero_smul ℤ u⟩, add_zero x⟩
      · exact ⟨x + u, h, -u, ⟨-1, by simp⟩, add_neg_cancel_right x u⟩
  -- `Λ` lies in the lattice `Λ / 2` of `2⁻¹ • L`
  let c : ℂˣ := Units.mk0 2⁻¹ (by norm_num)
  have hle : (Λ : Set ℂ) ⊆ ((c • L).lattice : Set ℂ) := fun x hx ↦ by
    have h2x : 2 * x ∈ L.lattice := by
      rcases (hmem x).mp hx with h | h
      · simpa [two_mul] using add_mem h h
      · convert sub_mem (add_mem h h) hu using 1
        ring
    convert (L.mul_mem_lattice_smul_iff c).mpr h2x using 1
    simp [c]
  have : DiscreteTopology Λ := DiscreteTopology.of_subset (inferInstance : DiscreteTopology
    (c • L).lattice) hle
  have : IsZLattice ℝ Λ := IsZLattice.of_le (L₁ := L.lattice) le_sup_left
  obtain ⟨M, hM⟩ := Λ.exists_periodPair_lattice_eq_of_isZLattice
  exact ⟨M, fun x ↦ by rw [hM, hmem]⟩

/-- If the lattice of `M` is `Λ ∪ (Λ - u)`, then `u` has order two modulo `Λ`: `-u ∈ Λ_M`, so
`-2 u ∈ Λ_M`, and `-2 u + u = -u ∉ Λ`. -/
theorem two_mul_mem_lattice_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) : 2 * u ∈ L.lattice := by
  have hneg : -u ∈ M.lattice := (hM _).mpr (Or.inr (by simp))
  rcases (hM _).mp (add_mem hneg hneg) with h | h
  · simpa [two_mul] using neg_mem h
  · exact absurd (by simpa using neg_mem h) hu

/-- A sum over the lattice `Λ ∪ (Λ - u)` of `M` is the sum over `Λ` plus the sum over the coset
`Λ - u = -u + Λ`: the case `g = -u` of `TauCeti.hasSum_union_leftAddCoset`. -/
private lemma hasSum_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) {f : ℂ → ℂ} {a b : ℂ}
    (ha : HasSum (fun l : L.lattice ↦ f l) a) (hb : HasSum (fun l : L.lattice ↦ f (l - u)) b) :
    HasSum (fun l : M.lattice ↦ f l) (a + b) := by
  let Λ := L.lattice.toAddSubgroup
  have hset : (M.lattice : Set ℂ) = (Λ : Set ℂ) ∪ (-u +ᵥ (Λ : Set ℂ)) := by
    ext x
    rw [Set.mem_union, mem_leftAddCoset_iff, neg_neg, add_comm, SetLike.mem_coe, SetLike.mem_coe,
      SetLike.mem_coe, Submodule.mem_toAddSubgroup, Submodule.mem_toAddSubgroup, hM]
  -- the subtypes of `L.lattice` and of `Λ`, and of `M.lattice` as a submodule and of its carrier
  -- set, are the same types
  have := TauCeti.hasSum_union_leftAddCoset (s := Λ) (g := -u) (neg_mem_iff.not.mpr hu) ha
    (hb.congr_fun fun l ↦ congr_arg f (neg_add_eq_sub u l))
  rwa [← hset] at this

/-- **`℘` of the lattice `Λ ∪ (Λ - u)`**: if `u ∉ Λ` and the lattice of `M` consists of the `x`
with `x ∈ Λ` or `x + u ∈ Λ`, then `℘_M(z) = ℘_Λ(z) + ℘_Λ(z + u) - ℘_Λ(u)`. This is the case of the
isogeny of degree two from `Λ` to `Λ + ℤ u`, for `u` a point of order two. -/
theorem weierstrassP_eq_add_sub_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) (z : ℂ) :
    ℘[M] z = ℘[L] z + ℘[L] (z + u) - ℘[L] u := by
  refine (M.hasSum_weierstrassP z).unique ?_
  rw [add_sub_assoc]
  refine hasSum_of_mem_iff hu hM (f := fun x ↦ 1 / (z - x) ^ 2 - 1 / x ^ 2)
    (L.hasSum_weierstrassP z) ?_
  refine ((L.hasSum_weierstrassP (z + u)).sub (L.hasSum_weierstrassP u)).congr_fun fun l ↦ ?_
  ring

/-- **`℘'` of the lattice `Λ ∪ (Λ - u)`**: if `u ∉ Λ` and the lattice of `M` consists of the `x`
with `x ∈ Λ` or `x + u ∈ Λ`, then `℘'_M(z) = ℘'_Λ(z) + ℘'_Λ(z + u)`. -/
theorem derivWeierstrassP_eq_add_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) (z : ℂ) :
    ℘'[M] z = ℘'[L] z + ℘'[L] (z + u) := by
  refine (M.hasSum_derivWeierstrassP z).unique ?_
  refine hasSum_of_mem_iff hu hM (f := fun x ↦ -2 / (z - x) ^ 3)
    (L.hasSum_derivWeierstrassP z) ?_
  refine (L.hasSum_derivWeierstrassP (z + u)).congr_fun fun l ↦ ?_
  ring

/-- **`℘''` of the lattice `Λ ∪ (Λ - u)`**: if `u ∉ Λ` and the lattice of `M` consists of the `x`
with `x ∈ Λ` or `x + u ∈ Λ`, then `℘''_M(z) = ℘''_Λ(z) + ℘''_Λ(z + u)` off the lattice of `M`. -/
theorem deriv_derivWeierstrassP_eq_add_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) {z : ℂ}
    (hz : z ∉ M.lattice) :
    deriv ℘'[M] z = deriv ℘'[L] z + deriv ℘'[L] (z + u) := by
  rw [hM, not_or] at hz
  have h : ℘'[M] = fun w ↦ ℘'[L] w + ℘'[L] (w + u) :=
    funext (derivWeierstrassP_eq_add_of_mem_iff hu hM)
  have h₁ := (L.analyticOnNhd_derivWeierstrassP z hz.1).differentiableAt
  have h₂ : DifferentiableAt ℂ (fun w ↦ ℘'[L] (w + u)) z :=
    differentiableAt_comp_add_const.mpr (L.analyticOnNhd_derivWeierstrassP _ hz.2).differentiableAt
  rw [h, deriv_fun_add h₁ h₂, deriv_comp_add_const]

end PeriodPair
