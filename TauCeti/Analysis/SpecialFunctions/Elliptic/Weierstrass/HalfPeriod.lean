module

public import TauCeti.Analysis.SpecialFunctions.Elliptic.Torsion
public import TauCeti.Analysis.SpecialFunctions.Elliptic.Weierstrass.Overlattice

/-!
# The Weierstrass function at the points of order two

Let `Λ` be a lattice with Weierstrass function `℘`. A point of order two of `ℂ / Λ` is a `u ∉ Λ`
with `2 u ∈ Λ`. There `℘'(u) = 0`, so `e = ℘(u)` is a root of the cubic `4 X³ - g₂ X - g₃`, and
the values at the three points of order two are its three distinct roots `e₁, e₂, e₃`. Hence
`e₁ + e₂ + e₃ = 0` and `℘''(u₁) = 2 (e₁ - e₂) (e₁ - e₃)`.

This file studies the scale-invariant number
`s_Λ(u) = 288 ℘(u)² / ℘''(u) - 64` (`PeriodPair.scaledDiscr`)
at a point `u` of order two. It satisfies `s_Λ(u) ℘''(u)³ = 8 Δ(Λ)`, with `Δ = g₂³ - 27 g₃²` the
discriminant, so `s_Λ(u) = Δ(Λ)` when `Λ` is scaled so that `℘''(u) = 2`. Over the three points of
order two, these numbers have sum `-48` and product `-2¹²`. If `u₁`, `u₂` are points of order two
that differ modulo `Λ`, the lattice `Λ' = Λ + ℤ u₁` (the target of the isogeny of degree two with
kernel generated by `u₁`) satisfies `s_Λ(u₁) s_{Λ'}(u₂) = 2¹²`. The last relation rests on the
formulas for `℘_{Λ'}` and its derivatives in
`TauCeti.Analysis.SpecialFunctions.Elliptic.Weierstrass.Overlattice`.

The sum and product are those of the roots of Weber's cubic `(X + 16)³ - j X`. For a lattice with
complex multiplication, these identities together with the isogeny relation, applied along the
chain of isogenies of degree two through a distinguished point of order two, are the inputs to the
argument that the discriminant `Δ(Λ)`, scaled so that `℘''(u) = 2` at that point, is a unit at
every prime.

## Main definitions

* `PeriodPair.scaledDiscr`: the number `s_Λ(u) = 288 ℘(u)² / ℘''(u) - 64`.

## Main results

* `PeriodPair.g₂_eq_four_mul_weierstrassP_sq_add`: `g₂ = 4 (e₁² + e₁ e₂ + e₂²)`.
* `PeriodPair.weierstrassP_add_add_eq_zero`: `e₁ + e₂ + e₃ = 0`.
* `PeriodPair.deriv_derivWeierstrassP_eq_mul`: `℘''(u₁) = 2 (e₁ - e₂) (e₁ - e₃)`.
* `PeriodPair.deriv_derivWeierstrassP_ne_zero`: `℘''(u) ≠ 0` at a point of order two, and
  `PeriodPair.scaledDiscr_mul_pow_three_eq_eight_mul_Δ`: `s_Λ(u) ℘''(u)³ = 8 Δ(Λ)` there.
* `PeriodPair.scaledDiscr_smul`: `s_{cΛ}(c u) = s_Λ(u)`, and `PeriodPair.scaledDiscr_add_coe`:
  `s_Λ(u + l) = s_Λ(u)` for `l ∈ Λ`.
* `PeriodPair.scaledDiscr_add_add_eq`, `PeriodPair.scaledDiscr_mul_mul_eq`: over the three points
  of order two, the sum is `-48` and the product is `-2¹²`.
* `PeriodPair.scaledDiscr_mul_scaledDiscr_eq`: `s_Λ(u₁) s_{Λ'}(c u₂) = 2¹²` for
  `Λ' = c (Λ + ℤ u₁)` and points `u₁`, `u₂` of order two that differ modulo `Λ`.

## References

* J. H. Silverman, *The Arithmetic of Elliptic Curves*, 2nd ed., Graduate Texts in Mathematics
  106, Springer, 2009, §VI.3.
* B. J. Birch, *Weber's class invariants*, Mathematika 16 (1969), 283–294.
* D. S. Kubert and S. Lang, *Modular Units*, Grundlehren der mathematischen Wissenschaften 244,
  Springer, 1981.
* The scaled discriminant and the statements of its sum, product and isogeny relations follow the
  prior formalization in `Lib/CM/GoodReduction` of the folder `grh` of
  https://github.com/lsernau/grh-lean at commit 72fead102f663d5c7a407964a13dc0cf9d977207
  (`PeriodPair.scaledDisc`, `PeriodPair.IsOrderTwo.scaledDisc_sum_prod`,
  `PeriodPair.IsOrderTwo.scaledDisc_mul_of_isogeny`).
-/

public noncomputable section

namespace PeriodPair

variable (L : PeriodPair) {u u₁ u₂ u₃ : ℂ}

/-! ### The values of `℘` at the points of order two -/

/-- At a point of order two, `℘` is a root of the cubic `4 X³ - g₂ X - g₃`. -/
theorem weierstrassP_cubic_eq_zero (hu : u ∉ L.lattice) (h2u : 2 * u ∈ L.lattice) :
    4 * ℘[L] u ^ 3 - L.g₂ * ℘[L] u - L.g₃ = 0 := by
  rw [← L.derivWeierstrassP_sq u hu, (L.derivWeierstrassP_eq_zero_iff u).mpr h2u]
  ring

/-- If `u₂` is a point of order two and `u₁ ∉ Λ` differs from `u₂` modulo `Λ`, then
`℘(u₁) ≠ ℘(u₂)`. -/
theorem weierstrassP_ne_of_sub_notMem (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (h2u₂ : 2 * u₂ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) : ℘[L] u₁ ≠ ℘[L] u₂ := by
  rw [Ne, L.weierstrassP_eq_weierstrassP_iff hu₁ hu₂, not_or]
  refine ⟨h₁₂, fun h ↦ h₁₂ ?_⟩
  simpa [two_mul, sub_eq_add_neg, add_assoc] using sub_mem h h2u₂

/-- If `u₁` has order two and `u₂ - u₁ ∉ Λ`, then `u₂ + u₁ ∉ Λ`: modulo `Λ`, `u₂ + u₁` is
`u₂ - u₁`. For `u₁`, `u₂` points of order two that differ modulo `Λ`, `u₂ + u₁` is the third
point of order two. -/
theorem add_notMem_lattice_of_sub_notMem (h2u₁ : 2 * u₁ ∈ L.lattice)
    (h₂₁ : u₂ - u₁ ∉ L.lattice) : u₂ + u₁ ∉ L.lattice := fun h ↦
  h₂₁ (by simpa [two_mul, sub_add_eq_sub_sub] using sub_mem h h2u₁)

/-- At two points of order two that differ modulo `Λ`, the values `e₁ = ℘(u₁)`, `e₂ = ℘(u₂)`
satisfy `g₂ = 4 (e₁² + e₁ e₂ + e₂²)`: this is the divided difference of `4 X³ - g₂ X - g₃` at its
roots `e₁ ≠ e₂`. -/
theorem g₂_eq_four_mul_weierstrassP_sq_add (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) :
    L.g₂ = 4 * (℘[L] u₁ ^ 2 + ℘[L] u₁ * ℘[L] u₂ + ℘[L] u₂ ^ 2) := by
  have h : (℘[L] u₁ - ℘[L] u₂) * (4 * (℘[L] u₁ ^ 2 + ℘[L] u₁ * ℘[L] u₂ + ℘[L] u₂ ^ 2) - L.g₂) =
      0 := by
    linear_combination L.weierstrassP_cubic_eq_zero hu₁ h2u₁ - L.weierstrassP_cubic_eq_zero hu₂ h2u₂
  exact (sub_eq_zero.mp ((mul_eq_zero.mp h).resolve_left
    (sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₂ h2u₂ h₁₂)))).symm

/-- **The values of `℘` at the three points of order two sum to zero**: they are the three roots
of `4 X³ - g₂ X - g₃`, which has no quadratic term. -/
theorem weierstrassP_add_add_eq_zero (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) : ℘[L] u₁ + ℘[L] u₂ + ℘[L] u₃ = 0 := by
  have n₂₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₂ hu₃ h2u₃ h₂₃)
  have h : (℘[L] u₂ - ℘[L] u₃) * (4 * (℘[L] u₁ + ℘[L] u₂ + ℘[L] u₃)) = 0 := by
    linear_combination L.g₂_eq_four_mul_weierstrassP_sq_add hu₁ hu₃ h2u₁ h2u₃ h₁₃ -
      L.g₂_eq_four_mul_weierstrassP_sq_add hu₁ hu₂ h2u₁ h2u₂ h₁₂
  simpa using (mul_eq_zero.mp h).resolve_left n₂₃

/-- **`℘''` at a point of order two**: `℘''(u₁) = 2 (e₁ - e₂) (e₁ - e₃)` with `eᵢ = ℘(uᵢ)` the
values at the three points of order two. -/
theorem deriv_derivWeierstrassP_eq_mul (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    deriv ℘'[L] u₁ = 2 * (℘[L] u₁ - ℘[L] u₂) * (℘[L] u₁ - ℘[L] u₃) := by
  rw [L.deriv_derivWeierstrassP hu₁]
  linear_combination (-1 / 2 : ℂ) * L.g₂_eq_four_mul_weierstrassP_sq_add hu₁ hu₂ h2u₁ h2u₂ h₁₂ +
    2 * (℘[L] u₁ - ℘[L] u₂) * L.weierstrassP_add_add_eq_zero hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃

/-- **`℘''` does not vanish at a point of order two**: there `(℘(u), ℘'(u) / 2) = (℘(u), 0)` is a
nonsingular point of the Weierstrass curve, so its `x`-partial `3 ℘(u)² - g₂ / 4 = ℘''(u) / 2` is
nonzero. -/
theorem deriv_derivWeierstrassP_ne_zero (hu : u ∉ L.lattice) (h2u : 2 * u ∈ L.lattice) :
    deriv ℘'[L] u ≠ 0 := by
  have h := ((WeierstrassCurve.Affine.nonsingular_iff' _ _).mp (L.nonsingular_weierstrassP hu)).2
  simp only [weierstrassCurve_a₁, weierstrassCurve_a₂, weierstrassCurve_a₃, weierstrassCurve_a₄,
    (L.derivWeierstrassP_eq_zero_iff u).mpr h2u] at h
  rw [L.deriv_derivWeierstrassP hu]
  intro h0
  apply h.resolve_right (by norm_num)
  linear_combination -h0 / 2

/-! ### The scaled discriminant at a point -/

/-- The number `s_Λ(u) = 288 ℘(u)² / ℘''(u) - 64`. At a point `u` of order two it equals
`8 Δ(Λ) / ℘''(u)³` (`PeriodPair.scaledDiscr_eq_Δ_div`), so it is unchanged by rescaling the
lattice, and it is the discriminant `Δ(Λ) = g₂³ - 27 g₃²` when `℘''(u) = 2`. -/
def scaledDiscr (u : ℂ) : ℂ :=
  288 * ℘[L] u ^ 2 / deriv ℘'[L] u - 64

lemma scaledDiscr_def (u : ℂ) : L.scaledDiscr u = 288 * ℘[L] u ^ 2 / deriv ℘'[L] u - 64 :=
  (rfl)

/-- `s_Λ` depends only on the lattice, not on the chosen basis. -/
lemma scaledDiscr_eq_of_lattice_eq {L L' : PeriodPair} (h : L.lattice = L'.lattice) :
    L.scaledDiscr = L'.scaledDiscr := by
  ext u
  rw [scaledDiscr, scaledDiscr, weierstrassP_eq_of_lattice_eq h,
    derivWeierstrassP_eq_of_lattice_eq h]

/-- `s_Λ` is periodic: `s_Λ(u + l) = s_Λ(u)` for `l ∈ Λ`. -/
@[simp]
lemma scaledDiscr_add_coe (u : ℂ) (l : L.lattice) : L.scaledDiscr (u + l) = L.scaledDiscr u := by
  rw [scaledDiscr, scaledDiscr, weierstrassP_add_coe, ← deriv_comp_add_const,
    (L.periodic_derivWeierstrassP l).funext]

/-- **`s_Λ` is invariant under rescaling**: `s_{c Λ}(c u) = s_Λ(u)`. -/
@[simp]
theorem scaledDiscr_smul (c : ℂˣ) (u : ℂ) : (c • L).scaledDiscr (c * u) = L.scaledDiscr u := by
  rw [scaledDiscr, scaledDiscr, weierstrassP_smul, deriv_derivWeierstrassP_smul, div_pow,
    ← pow_mul, ← mul_div_assoc, div_div_div_cancel_right₀ (pow_ne_zero _ c.ne_zero)]

/-- **`s_Λ(u) ℘''(u)³ = 8 Δ(Λ)`** at a point `u` of order two, where `Δ(Λ) = g₂³ - 27 g₃²` is the
discriminant of the Weierstrass curve of `Λ`. -/
theorem scaledDiscr_mul_pow_three_eq_eight_mul_Δ (hu : u ∉ L.lattice) (h2u : 2 * u ∈ L.lattice) :
    L.scaledDiscr u * deriv ℘'[L] u ^ 3 = 8 * L.weierstrassCurve.Δ := by
  have hD := L.deriv_derivWeierstrassP_ne_zero hu h2u
  -- write `g₃` through `℘(u)` and `g₂`, then `g₂` through `℘(u)` and `℘''(u) = 6 ℘(u)² - g₂ / 2`
  have hg₃ : L.g₃ = 4 * ℘[L] u ^ 3 - L.g₂ * ℘[L] u := by
    linear_combination -L.weierstrassP_cubic_eq_zero hu h2u
  have hg₂ : L.g₂ = 12 * ℘[L] u ^ 2 - 2 * deriv ℘'[L] u := by
    linear_combination 2 * L.deriv_derivWeierstrassP hu
  rw [weierstrassCurve_Δ, hg₃, hg₂, scaledDiscr]
  field_simp
  ring

/-- At a point `u` of order two, `s_Λ(u) = 8 Δ(Λ) / ℘''(u)³`. -/
theorem scaledDiscr_eq_Δ_div (hu : u ∉ L.lattice) (h2u : 2 * u ∈ L.lattice) :
    L.scaledDiscr u = 8 * L.weierstrassCurve.Δ / deriv ℘'[L] u ^ 3 := by
  rw [eq_div_iff (pow_ne_zero 3 (L.deriv_derivWeierstrassP_ne_zero hu h2u)),
    L.scaledDiscr_mul_pow_three_eq_eight_mul_Δ hu h2u]

/-! ### Sum and product over the three points of order two -/

/-- `s_Λ(u₁)` in terms of the values `eᵢ = ℘(uᵢ)` at the three points of order two. -/
private lemma scaledDiscr_eq_of_three (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    L.scaledDiscr u₁ =
      144 * ℘[L] u₁ ^ 2 / ((℘[L] u₁ - ℘[L] u₂) * (℘[L] u₁ - ℘[L] u₃)) - 64 := by
  rw [scaledDiscr, L.deriv_derivWeierstrassP_eq_mul hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃,
    mul_assoc, ← div_div]
  ring

/-- The sum and the product of `s_Λ` over the three points of order two, computed together from
the values `eᵢ = ℘(uᵢ)` with `e₃ = -e₁ - e₂`. -/
private lemma scaledDiscr_add_add_eq_and_mul_mul_eq (hu₁ : u₁ ∉ L.lattice)
    (hu₂ : u₂ ∉ L.lattice) (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice)
    (h2u₂ : 2 * u₂ ∈ L.lattice) (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice)
    (h₁₃ : u₁ - u₃ ∉ L.lattice) (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    L.scaledDiscr u₁ + L.scaledDiscr u₂ + L.scaledDiscr u₃ = -48 ∧
      L.scaledDiscr u₁ * L.scaledDiscr u₂ * L.scaledDiscr u₃ = -2 ^ 12 := by
  have h₂₁ := sub_mem_comm_iff.not.mp h₁₂
  have h₃₁ := sub_mem_comm_iff.not.mp h₁₃
  have h₃₂ := sub_mem_comm_iff.not.mp h₂₃
  have n₁₂ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₂ h2u₂ h₁₂)
  have n₁₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₃ h2u₃ h₁₃)
  have n₂₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₂ hu₃ h2u₃ h₂₃)
  have n₂₁ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₂ hu₁ h2u₁ h₂₁)
  have n₃₁ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₃ hu₁ h2u₁ h₃₁)
  have n₃₂ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₃ hu₂ h2u₂ h₃₂)
  have he₃ : ℘[L] u₃ = -℘[L] u₁ - ℘[L] u₂ := by
    linear_combination L.weierstrassP_add_add_eq_zero hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃
  rw [L.scaledDiscr_eq_of_three hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃,
    L.scaledDiscr_eq_of_three hu₂ hu₁ hu₃ h2u₂ h2u₁ h2u₃ h₂₁ h₂₃ h₁₃,
    L.scaledDiscr_eq_of_three hu₃ hu₁ hu₂ h2u₃ h2u₁ h2u₂ h₃₁ h₃₂ h₁₂, he₃]
  rw [he₃] at n₁₃ n₂₃ n₃₁ n₃₂
  constructor <;> field_simp <;> ring

/-- **The sum of `s_Λ` over the three points of order two is `-48`.** -/
theorem scaledDiscr_add_add_eq (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    L.scaledDiscr u₁ + L.scaledDiscr u₂ + L.scaledDiscr u₃ = -48 :=
  (L.scaledDiscr_add_add_eq_and_mul_mul_eq hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃).1

/-- **The product of `s_Λ` over the three points of order two is `-2¹²`.** -/
theorem scaledDiscr_mul_mul_eq (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    L.scaledDiscr u₁ * L.scaledDiscr u₂ * L.scaledDiscr u₃ = -2 ^ 12 :=
  (L.scaledDiscr_add_add_eq_and_mul_mul_eq hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃).2

/-! ### The isogeny relation -/

section Isogeny

variable {L} {M : PeriodPair}

/-- `s_Λ(u₁) s_M(u₂) = 2¹²` when the lattice of `M` is `Λ ∪ (Λ - u₁)`: the case `c = 1` of
`PeriodPair.scaledDiscr_mul_scaledDiscr_eq`. -/
private lemma scaledDiscr_mul_scaledDiscr_eq_of_mem_iff (hu₁ : u₁ ∉ L.lattice)
    (hu₂ : u₂ ∉ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u₁ ∈ L.lattice) :
    L.scaledDiscr u₁ * M.scaledDiscr u₂ = 2 ^ 12 := by
  have h2u₁ := two_mul_mem_lattice_of_mem_iff hu₁ hM
  -- the third point of order two is `u₃ = u₂ + u₁`
  have h₂₁ : u₂ - u₁ ∉ L.lattice := sub_mem_comm_iff.not.mp h₁₂
  have hu₃ := L.add_notMem_lattice_of_sub_notMem h2u₁ h₂₁
  have h2u₃ : 2 * (u₂ + u₁) ∈ L.lattice := by simpa [mul_add] using add_mem h2u₂ h2u₁
  have h₁₃ : u₁ - (u₂ + u₁) ∉ L.lattice := by simpa using hu₂
  have h₂₃ : u₂ - (u₂ + u₁) ∉ L.lattice := by simpa using hu₁
  have hu₂M : u₂ ∉ M.lattice := by
    rw [hM, not_or]
    exact ⟨hu₂, hu₃⟩
  have n₁₂ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₂ h2u₂ h₁₂)
  have n₁₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₃ h2u₃ h₁₃)
  have n₂₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₂ hu₃ h2u₃ h₂₃)
  have he₃ : ℘[L] (u₂ + u₁) = -℘[L] u₁ - ℘[L] u₂ := by
    linear_combination L.weierstrassP_add_add_eq_zero hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃
  rw [L.scaledDiscr_eq_of_three hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃, scaledDiscr,
    weierstrassP_eq_add_sub_of_mem_iff hu₁ hM,
    deriv_derivWeierstrassP_eq_add_of_mem_iff hu₁ hM hu₂M,
    L.deriv_derivWeierstrassP_eq_mul hu₂ hu₁ hu₃ h2u₂ h2u₁ h2u₃ h₂₁ h₂₃ h₁₃,
    L.deriv_derivWeierstrassP_eq_mul hu₃ hu₁ hu₂ h2u₃ h2u₁ h2u₂ (sub_mem_comm_iff.not.mp h₁₃)
      (sub_mem_comm_iff.not.mp h₂₃) h₁₂, he₃]
  rw [he₃] at n₁₃ n₂₃
  -- the denominators `e₁ - e₃ = 2 e₁ + e₂` and `e₂ - e₃ = e₁ + 2 e₂`
  have n : 2 * ℘[L] u₁ + ℘[L] u₂ ≠ 0 := fun h ↦ n₁₃ (by linear_combination h)
  have n' : ℘[L] u₁ + 2 * ℘[L] u₂ ≠ 0 := fun h ↦ n₂₃ (by linear_combination h)
  -- the denominator `℘''_M(u₂) = ℘''_Λ(u₂) + ℘''_Λ(u₂ + u₁)` is `2 (e₁ + 2 e₂)²`
  have hden : 2 * (℘[L] u₂ - ℘[L] u₁) * (℘[L] u₂ - (-℘[L] u₁ - ℘[L] u₂)) +
      2 * (-℘[L] u₁ - ℘[L] u₂ - ℘[L] u₁) * (-℘[L] u₁ - ℘[L] u₂ - ℘[L] u₂) =
      2 * (℘[L] u₁ + 2 * ℘[L] u₂) ^ 2 := by
    ring
  have h₁₃' : ℘[L] u₁ - (-℘[L] u₁ - ℘[L] u₂) = 2 * ℘[L] u₁ + ℘[L] u₂ := by ring
  rw [h₁₃', hden]
  -- `s_Λ(u₁) = 16 (e₁ + 2 e₂)² / ((e₁ - e₂) (2 e₁ + e₂))` and its inverse times `2¹²` is `s_M(u₂)`;
  -- `field_simp` leaves the factor `(e₁ + 2 e₂)⁻²` uncleared, so clear the denominators by hand
  rw [div_sub' (mul_ne_zero n₁₂ n), div_sub' (mul_ne_zero two_ne_zero (pow_ne_zero 2 n')),
    div_mul_div_comm, div_eq_iff (mul_ne_zero (mul_ne_zero n₁₂ n)
      (mul_ne_zero two_ne_zero (pow_ne_zero 2 n')))]
  ring

/-- **The isogeny relation**: let `u₁`, `u₂` be points of order two of `ℂ / Λ` that differ modulo
`Λ`, and let `Λ'` be the lattice `c (Λ + ℤ u₁)`, that is, `c x ∈ Λ'` exactly when `x ∈ Λ` or
`x + u₁ ∈ Λ`. Then `s_Λ(u₁) s_{Λ'}(c u₂) = 2¹²`. -/
theorem scaledDiscr_mul_scaledDiscr_eq {L' : PeriodPair} (c : ℂˣ) (hu₁ : u₁ ∉ L.lattice)
    (hu₂ : u₂ ∉ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice)
    (hL' : ∀ x, (c : ℂ) * x ∈ L'.lattice ↔ x ∈ L.lattice ∨ x + u₁ ∈ L.lattice) :
    L.scaledDiscr u₁ * L'.scaledDiscr (c * u₂) = 2 ^ 12 := by
  have hM : ∀ x, x ∈ (c⁻¹ • L').lattice ↔ x ∈ L.lattice ∨ x + u₁ ∈ L.lattice := fun x ↦ by
    rw [← hL', ← L'.mul_mem_lattice_smul_iff c⁻¹, Units.val_inv_eq_inv_val,
      inv_mul_cancel_left₀ c.ne_zero]
  rw [← L'.scaledDiscr_smul c⁻¹, Units.val_inv_eq_inv_val, inv_mul_cancel_left₀ c.ne_zero]
  exact scaledDiscr_mul_scaledDiscr_eq_of_mem_iff hu₁ hu₂ h2u₂ h₁₂ hM

end Isogeny

end PeriodPair
