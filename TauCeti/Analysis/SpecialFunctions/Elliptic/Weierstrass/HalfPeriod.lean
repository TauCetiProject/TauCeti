module

public import TauCeti.Analysis.SpecialFunctions.Elliptic.Torsion

/-!
# The Weierstrass function at the points of order two

Let `Λ` be a lattice with Weierstrass function `℘`. A point of order two of `ℂ / Λ` is a `u ∉ Λ`
with `2 u ∈ Λ`. There `℘'(u) = 0`, so `e = ℘(u)` is a root of the cubic `4 X³ - g₂ X - g₃`, and
the values at the three points of order two are its three distinct roots `e₁, e₂, e₃`. Hence
`e₁ + e₂ + e₃ = 0` and `℘''(u₁) = 2 (e₁ - e₂) (e₁ - e₃)`.

This file studies the scale-invariant number
`s_Λ(u) = 288 ℘(u)² / ℘''(u) - 64` (`PeriodPair.scaledDisc`)
at a point `u` of order two. It satisfies `s_Λ(u) ℘''(u)³ = 8 Δ(Λ)`, with `Δ = g₂³ - 27 g₃²` the
discriminant, so `s_Λ(u) = Δ(Λ)` when `Λ` is scaled so that `℘''(u) = 2`. Over the three points of
order two, these numbers have sum `-48` and product `-2¹²`. If `u₁ ≠ u₂` are points of order two,
the lattice `Λ' = Λ + ℤ u₁` (the target of the isogeny of degree two with kernel generated by
`u₁`) satisfies `s_Λ(u₁) s_{Λ'}(u₂) = 2¹²`. The last relation rests on the formulas
`℘_{Λ'}(z) = ℘_Λ(z) + ℘_Λ(z + u₁) - ℘_Λ(u₁)` and `℘'_{Λ'}(z) = ℘'_Λ(z) + ℘'_Λ(z + u₁)`, obtained by
splitting the lattice sums over `Λ' = Λ ∪ (Λ - u₁)`.

Their sum and product are those of the roots of Weber's cubic `(X + 16)³ - j X`. Along a closed
chain of isogenies of degree two, as for lattices with complex multiplication, the isogeny relation
bounds their valuations; this is how one shows that the discriminant `Δ(Λ)` of such a lattice,
scaled so that `℘''(u) = 2` at a suitable point `u` of order two, is a unit at every prime.

## Main definitions

* `PeriodPair.scaledDisc`: the number `s_Λ(u) = 288 ℘(u)² / ℘''(u) - 64`.

## Main results

* `PeriodPair.g₂_eq_four_mul_weierstrassP_sq_add`: `g₂ = 4 (e₁² + e₁ e₂ + e₂²)`.
* `PeriodPair.weierstrassP_add_add_eq_zero`: `e₁ + e₂ + e₃ = 0`.
* `PeriodPair.deriv_derivWeierstrassP_eq_mul`: `℘''(u₁) = 2 (e₁ - e₂) (e₁ - e₃)`.
* `PeriodPair.scaledDisc_mul_pow_three`: `s_Λ(u) ℘''(u)³ = 8 Δ(Λ)` at a point of order two, and
  `PeriodPair.deriv_derivWeierstrassP_ne_zero`: `℘''(u) ≠ 0` there.
* `PeriodPair.scaledDisc_smul`: `s_{cΛ}(c u) = s_Λ(u)`.
* `PeriodPair.scaledDisc_add_add_eq`, `PeriodPair.scaledDisc_mul_mul_eq`: over the three points
  of order two, the sum is `-48` and the product is `-2¹²`.
* `PeriodPair.weierstrassP_eq_of_mem_iff`, `PeriodPair.derivWeierstrassP_eq_of_mem_iff`: `℘` and
  `℘'` of the lattice `Λ ∪ (Λ - u)`.
* `PeriodPair.scaledDisc_mul_scaledDisc_eq`: `s_Λ(u₁) s_{Λ'}(c u₂) = 2¹²` for
  `Λ' = c (Λ + ℤ u₁)`.

## References

* J. H. Silverman, *The Arithmetic of Elliptic Curves*, 2nd ed., Graduate Texts in Mathematics
  106, Springer, 2009, §VI.3.
* B. J. Birch, *Weber's class invariants*, Mathematika 16 (1969), 283–294.
* D. S. Kubert and S. Lang, *Modular Units*, Grundlehren der mathematischen Wissenschaften 244,
  Springer, 1981.
-/

public noncomputable section

namespace PeriodPair

variable (L : PeriodPair) {u u₁ u₂ u₃ : ℂ}

/-! ### The values of `℘` at the points of order two -/

/-- At a point of order two, `℘` is a root of the cubic `4 X³ - g₂ X - g₃`. -/
theorem weierstrassP_cubic_eq_zero (hu : u ∉ L.lattice) (h2u : 2 * u ∈ L.lattice) :
    4 * ℘[L] u ^ 3 - L.g₂ * ℘[L] u - L.g₃ = 0 := by
  rw [← L.derivWeierstrassP_sq u hu, (L.derivWeierstrassP_eq_zero_iff u).mpr h2u]
  ring

/-- Two points of order two that differ modulo `Λ` have different values of `℘`. -/
theorem weierstrassP_ne_of_sub_notMem (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (h2u₂ : 2 * u₂ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) : ℘[L] u₁ ≠ ℘[L] u₂ := by
  rw [Ne, L.weierstrassP_eq_weierstrassP_iff hu₁ hu₂, not_or]
  refine ⟨h₁₂, fun h ↦ h₁₂ ?_⟩
  simpa [two_mul, sub_eq_add_neg, add_assoc] using sub_mem h h2u₂

/-- At two points of order two that differ modulo `Λ`, the values `e₁ = ℘(u₁)`, `e₂ = ℘(u₂)`
satisfy `g₂ = 4 (e₁² + e₁ e₂ + e₂²)`: this is the divided difference of `4 X³ - g₂ X - g₃` at its
roots `e₁ ≠ e₂`. -/
theorem g₂_eq_four_mul_weierstrassP_sq_add (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) :
    L.g₂ = 4 * (℘[L] u₁ ^ 2 + ℘[L] u₁ * ℘[L] u₂ + ℘[L] u₂ ^ 2) := by
  have h : (℘[L] u₁ - ℘[L] u₂) * (4 * (℘[L] u₁ ^ 2 + ℘[L] u₁ * ℘[L] u₂ + ℘[L] u₂ ^ 2) - L.g₂) =
      0 := by
    linear_combination L.weierstrassP_cubic_eq_zero hu₁ h2u₁ - L.weierstrassP_cubic_eq_zero hu₂ h2u₂
  exact (sub_eq_zero.mp ((mul_eq_zero.mp h).resolve_left
    (sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₂ h2u₂ h₁₂)))).symm

/-- **The values of `℘` at the three points of order two sum to zero**: they are the three roots
of `4 X³ - g₂ X - g₃`, which has no quadratic term. -/
theorem weierstrassP_add_add_eq_zero (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) : ℘[L] u₁ + ℘[L] u₂ + ℘[L] u₃ = 0 := by
  have n₂₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₂ hu₃ h2u₃ h₂₃)
  have h : (℘[L] u₂ - ℘[L] u₃) * (4 * (℘[L] u₁ + ℘[L] u₂ + ℘[L] u₃)) = 0 := by
    linear_combination L.g₂_eq_four_mul_weierstrassP_sq_add hu₁ hu₃ h2u₁ h2u₃ h₁₃ -
      L.g₂_eq_four_mul_weierstrassP_sq_add hu₁ hu₂ h2u₁ h2u₂ h₁₂
  simpa using (mul_eq_zero.mp h).resolve_left n₂₃

/-- **`℘''` at a point of order two**: `℘''(u₁) = 2 (e₁ - e₂) (e₁ - e₃)` with `eᵢ = ℘(uᵢ)` the
values at the three points of order two. -/
theorem deriv_derivWeierstrassP_eq_mul (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    deriv ℘'[L] u₁ = 2 * (℘[L] u₁ - ℘[L] u₂) * (℘[L] u₁ - ℘[L] u₃) := by
  rw [L.deriv_derivWeierstrassP hu₁]
  linear_combination (-1 / 2 : ℂ) * L.g₂_eq_four_mul_weierstrassP_sq_add hu₁ hu₂ h2u₁ h2u₂ h₁₂ +
    2 * (℘[L] u₁ - ℘[L] u₂) * L.weierstrassP_add_add_eq_zero hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃

/-! ### The scaled discriminant at a point -/

/-- The number `s_Λ(u) = 288 ℘(u)² / ℘''(u) - 64`. At a point `u` of order two it equals
`8 Δ(Λ) / ℘''(u)³` (`PeriodPair.scaledDisc_eq_Δ_div`), so it is unchanged by rescaling the
lattice, and it is the discriminant `Δ(Λ) = g₂³ - 27 g₃²` when `℘''(u) = 2`. -/
def scaledDisc (u : ℂ) : ℂ :=
  288 * ℘[L] u ^ 2 / deriv ℘'[L] u - 64

lemma scaledDisc_def (u : ℂ) : L.scaledDisc u = 288 * ℘[L] u ^ 2 / deriv ℘'[L] u - 64 :=
  (rfl)

/-- `s_Λ` depends only on the lattice, not on the chosen basis. -/
lemma scaledDisc_eq_of_lattice_eq {L L' : PeriodPair} (h : L.lattice = L'.lattice) :
    L.scaledDisc = L'.scaledDisc := by
  ext u
  rw [scaledDisc, scaledDisc, weierstrassP_eq_of_lattice_eq h, derivWeierstrassP_eq_of_lattice_eq h]

/-- `℘''(c z; c Λ) = c⁻⁴ ℘''(z; Λ)`. -/
lemma deriv_derivWeierstrassP_smul (c : ℂˣ) (z : ℂ) :
    deriv ℘'[c • L] (c * z) = deriv ℘'[L] z / (c : ℂ) ^ 4 := by
  have h : ℘'[c • L] = fun w ↦ ℘'[L] ((c : ℂ)⁻¹ * w) / (c : ℂ) ^ 3 := by
    ext w
    rw [← derivWeierstrassP_smul, mul_inv_cancel_left₀ c.ne_zero]
  rw [h, deriv_div_const, deriv_comp_mul_left, smul_eq_mul, inv_mul_cancel_left₀ c.ne_zero]
  field_simp

/-- **`s_Λ` is invariant under rescaling**: `s_{c Λ}(c u) = s_Λ(u)`. -/
@[simp]
theorem scaledDisc_smul (c : ℂˣ) (u : ℂ) : (c • L).scaledDisc (c * u) = L.scaledDisc u := by
  rw [scaledDisc, scaledDisc, weierstrassP_smul, deriv_derivWeierstrassP_smul]
  by_cases h : deriv ℘'[L] u = 0
  · simp [h]
  · field_simp

/-- **`s_Λ(u) ℘''(u)³ = 8 Δ(Λ)`** at a point `u` of order two, where `Δ(Λ) = g₂³ - 27 g₃²` is the
discriminant of the Weierstrass curve of `Λ`. -/
theorem scaledDisc_mul_pow_three (hu : u ∉ L.lattice) (h2u : 2 * u ∈ L.lattice) :
    L.scaledDisc u * deriv ℘'[L] u ^ 3 = 8 * L.weierstrassCurve.Δ := by
  have c := L.weierstrassP_cubic_eq_zero hu h2u
  have hg₃ : L.g₃ = 4 * ℘[L] u ^ 3 - L.g₂ * ℘[L] u := by linear_combination -c
  rw [weierstrassCurve_Δ, hg₃, scaledDisc, L.deriv_derivWeierstrassP hu]
  -- write `g₂` through `D = ℘''(u) = 6 ℘(u)² - g₂ / 2`
  obtain ⟨D, hD⟩ : ∃ D, D = 6 * ℘[L] u ^ 2 - L.g₂ / 2 := ⟨_, rfl⟩
  have hg₂ : L.g₂ = 12 * ℘[L] u ^ 2 - 2 * D := by linear_combination 2 * hD
  rw [← hD, hg₂]
  by_cases h : D = 0
  · rw [h]
    ring
  · field_simp
    ring

/-- **`℘''` does not vanish at a point of order two**: the cubic `4 X³ - g₂ X - g₃` has simple
roots, as its discriminant `16 Δ(Λ)` is nonzero. -/
theorem deriv_derivWeierstrassP_ne_zero (hu : u ∉ L.lattice) (h2u : 2 * u ∈ L.lattice) :
    deriv ℘'[L] u ≠ 0 := by
  intro h
  have := L.scaledDisc_mul_pow_three hu h2u
  rw [h, zero_pow three_ne_zero, mul_zero, eq_comm, mul_eq_zero] at this
  exact L.weierstrassCurve_Δ_ne_zero (this.resolve_left (by norm_num))

/-- At a point `u` of order two, `s_Λ(u) = 8 Δ(Λ) / ℘''(u)³`. -/
theorem scaledDisc_eq_Δ_div (hu : u ∉ L.lattice) (h2u : 2 * u ∈ L.lattice) :
    L.scaledDisc u = 8 * L.weierstrassCurve.Δ / deriv ℘'[L] u ^ 3 := by
  rw [eq_div_iff (pow_ne_zero 3 (L.deriv_derivWeierstrassP_ne_zero hu h2u)),
    L.scaledDisc_mul_pow_three hu h2u]

/-! ### Sum and product over the three points of order two -/

/-- `s_Λ(u₁)` in terms of the values `eᵢ = ℘(uᵢ)` at the three points of order two. -/
private lemma scaledDisc_eq_of_three (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    L.scaledDisc u₁ =
      144 * ℘[L] u₁ ^ 2 / ((℘[L] u₁ - ℘[L] u₂) * (℘[L] u₁ - ℘[L] u₃)) - 64 := by
  rw [scaledDisc, L.deriv_derivWeierstrassP_eq_mul hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃,
    mul_assoc, ← div_div]
  ring

/-- **The sum of `s_Λ` over the three points of order two is `-48`.** -/
theorem scaledDisc_add_add_eq (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    L.scaledDisc u₁ + L.scaledDisc u₂ + L.scaledDisc u₃ = -48 := by
  have n₁₂ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₂ h2u₂ h₁₂)
  have n₁₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₃ h2u₃ h₁₃)
  have n₂₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₂ hu₃ h2u₃ h₂₃)
  have n₂₁ := sub_ne_zero.mpr (Ne.symm (sub_eq_zero.not.mp n₁₂))
  have n₃₁ := sub_ne_zero.mpr (Ne.symm (sub_eq_zero.not.mp n₁₃))
  have n₃₂ := sub_ne_zero.mpr (Ne.symm (sub_eq_zero.not.mp n₂₃))
  rw [L.scaledDisc_eq_of_three hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃,
    L.scaledDisc_eq_of_three hu₂ hu₁ hu₃ h2u₂ h2u₁ h2u₃ (sub_mem_comm_iff.not.mp h₁₂) h₂₃ h₁₃,
    L.scaledDisc_eq_of_three hu₃ hu₁ hu₂ h2u₃ h2u₁ h2u₂ (sub_mem_comm_iff.not.mp h₁₃)
      (sub_mem_comm_iff.not.mp h₂₃) h₁₂]
  field_simp
  ring

/-- **The product of `s_Λ` over the three points of order two is `-2¹²`.** -/
theorem scaledDisc_mul_mul_eq (hu₁ : u₁ ∉ L.lattice) (hu₂ : u₂ ∉ L.lattice)
    (hu₃ : u₃ ∉ L.lattice) (h2u₁ : 2 * u₁ ∈ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice)
    (h2u₃ : 2 * u₃ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice) (h₁₃ : u₁ - u₃ ∉ L.lattice)
    (h₂₃ : u₂ - u₃ ∉ L.lattice) :
    L.scaledDisc u₁ * L.scaledDisc u₂ * L.scaledDisc u₃ = -2 ^ 12 := by
  have hs := L.weierstrassP_add_add_eq_zero hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃
  have n₁₂ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₂ h2u₂ h₁₂)
  have n₁₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₃ h2u₃ h₁₃)
  have n₂₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₂ hu₃ h2u₃ h₂₃)
  have n₂₁ := sub_ne_zero.mpr (Ne.symm (sub_eq_zero.not.mp n₁₂))
  have n₃₁ := sub_ne_zero.mpr (Ne.symm (sub_eq_zero.not.mp n₁₃))
  have n₃₂ := sub_ne_zero.mpr (Ne.symm (sub_eq_zero.not.mp n₂₃))
  rw [L.scaledDisc_eq_of_three hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃,
    L.scaledDisc_eq_of_three hu₂ hu₁ hu₃ h2u₂ h2u₁ h2u₃ (sub_mem_comm_iff.not.mp h₁₂) h₂₃ h₁₃,
    L.scaledDisc_eq_of_three hu₃ hu₁ hu₂ h2u₃ h2u₁ h2u₂ (sub_mem_comm_iff.not.mp h₁₃)
      (sub_mem_comm_iff.not.mp h₂₃) h₁₂]
  have he₃ : ℘[L] u₃ = -℘[L] u₁ - ℘[L] u₂ := by linear_combination hs
  rw [he₃] at n₁₃ n₂₃ n₃₁ n₃₂ ⊢
  field_simp
  ring

/-! ### The lattice `Λ ∪ (Λ - u)` -/

section Overlattice

variable {L} {M : PeriodPair}

/-- A sum over the lattice `Λ ∪ (Λ - u)` of `M` is the sum over `Λ` plus the sum over the coset
`Λ - u`. -/
private lemma hasSum_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) {f : ℂ → ℂ} {a b : ℂ}
    (ha : HasSum (fun l : L.lattice ↦ f l) a) (hb : HasSum (fun l : L.lattice ↦ f (l - u)) b) :
    HasSum (fun l : M.lattice ↦ f l) (a + b) := by
  let S : Set ℂ := {x | x + u ∈ L.lattice}
  have hdisj : Disjoint (L.lattice : Set ℂ) S :=
    Set.disjoint_left.mpr fun x hx hxu ↦ hu (by simpa [S] using sub_mem hxu hx)
  let e : L.lattice ≃ S :=
    { toFun l := ⟨l - u, by simp [S]⟩
      invFun x := ⟨x + u, x.property⟩
      left_inv l := by ext; simp
      right_inv x := by ext; simp }
  have hb' : HasSum (f ∘ (↑) : S → ℂ) b := by
    rw [← e.hasSum_iff]
    exact hb
  have hset : (M.lattice : Set ℂ) = (L.lattice : Set ℂ) ∪ S := by
    ext x
    exact hM x
  have := (ha : HasSum (f ∘ (↑) : ↥(L.lattice : Set ℂ) → ℂ) a).add_disjoint hdisj hb'
  rw [← hset] at this
  exact this

/-- **`℘` of the lattice `Λ ∪ (Λ - u)`**: if the lattice of `M` consists of the `x` with `x ∈ Λ` or
`x + u ∈ Λ`, then `℘_M(z) = ℘_Λ(z) + ℘_Λ(z + u) - ℘_Λ(u)`. This is the case of the isogeny of
degree two from `Λ` to `Λ + ℤ u`, for `u` a point of order two. -/
theorem weierstrassP_eq_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) (z : ℂ) :
    ℘[M] z = ℘[L] z + ℘[L] (z + u) - ℘[L] u := by
  refine (M.hasSum_weierstrassP z).unique ?_
  rw [add_sub_assoc]
  refine hasSum_of_mem_iff hu hM (f := fun x ↦ 1 / (z - x) ^ 2 - 1 / x ^ 2)
    (L.hasSum_weierstrassP z) ?_
  refine ((L.hasSum_weierstrassP (z + u)).sub (L.hasSum_weierstrassP u)).congr_fun fun l ↦ ?_
  ring

/-- **`℘'` of the lattice `Λ ∪ (Λ - u)`**: if the lattice of `M` consists of the `x` with `x ∈ Λ` or
`x + u ∈ Λ`, then `℘'_M(z) = ℘'_Λ(z) + ℘'_Λ(z + u)`. -/
theorem derivWeierstrassP_eq_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) (z : ℂ) :
    ℘'[M] z = ℘'[L] z + ℘'[L] (z + u) := by
  refine (M.hasSum_derivWeierstrassP z).unique ?_
  refine hasSum_of_mem_iff hu hM (f := fun x ↦ -2 / (z - x) ^ 3)
    (L.hasSum_derivWeierstrassP z) ?_
  refine (L.hasSum_derivWeierstrassP (z + u)).congr_fun fun l ↦ ?_
  ring

/-- **`℘''` of the lattice `Λ ∪ (Λ - u)`**: `℘''_M(z) = ℘''_Λ(z) + ℘''_Λ(z + u)` off the lattice
of `M`. -/
theorem deriv_derivWeierstrassP_eq_of_mem_iff (hu : u ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u ∈ L.lattice) {z : ℂ}
    (hz : z ∉ M.lattice) :
    deriv ℘'[M] z = deriv ℘'[L] z + deriv ℘'[L] (z + u) := by
  rw [hM, not_or] at hz
  have h : ℘'[M] = fun w ↦ ℘'[L] w + ℘'[L] (w + u) := funext (derivWeierstrassP_eq_of_mem_iff hu hM)
  have h₁ := (L.analyticOnNhd_derivWeierstrassP z hz.1).differentiableAt
  have h₂ : DifferentiableAt ℂ (fun w ↦ ℘'[L] (w + u)) z :=
    differentiableAt_comp_add_const.mpr (L.analyticOnNhd_derivWeierstrassP _ hz.2).differentiableAt
  rw [h, deriv_fun_add h₁ h₂, deriv_comp_add_const]

/-- `s_M(u₂) s_Λ(u₁) = 2¹²` when the lattice of `M` is `Λ ∪ (Λ - u₁)`: the case `c = 1` of
`PeriodPair.scaledDisc_mul_scaledDisc_eq`. -/
private lemma scaledDisc_mul_scaledDisc_eq_of_mem_iff (hu₁ : u₁ ∉ L.lattice)
    (hu₂ : u₂ ∉ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice)
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + u₁ ∈ L.lattice) :
    L.scaledDisc u₁ * M.scaledDisc u₂ = 2 ^ 12 := by
  -- `u₁` has order two, since `-u₁ ∈ M` gives `-2 u₁ ∈ M`
  have h2u₁ : 2 * u₁ ∈ L.lattice := by
    have hneg : -u₁ ∈ M.lattice := (hM _).mpr (Or.inr (by simp))
    rcases (hM _).mp (add_mem hneg hneg) with h | h
    · simpa [two_mul] using neg_mem h
    · exact absurd (by simpa using neg_mem h) hu₁
  -- the third point of order two is `u₃ = u₂ + u₁`
  have h₂₁ : u₂ - u₁ ∉ L.lattice := sub_mem_comm_iff.not.mp h₁₂
  have h2u₃ : 2 * (u₂ + u₁) ∈ L.lattice := by simpa [mul_add] using add_mem h2u₂ h2u₁
  have hu₃ : u₂ + u₁ ∉ L.lattice := fun h ↦ h₂₁ (by
    simpa [two_mul, sub_add_eq_sub_sub] using sub_mem h h2u₁)
  have h₁₃ : u₁ - (u₂ + u₁) ∉ L.lattice := by simpa using hu₂
  have h₂₃ : u₂ - (u₂ + u₁) ∉ L.lattice := by simpa using hu₁
  have hu₂M : u₂ ∉ M.lattice := by
    rw [hM, not_or]
    exact ⟨hu₂, hu₃⟩
  have hs := L.weierstrassP_add_add_eq_zero hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃
  have n₁₂ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₂ h2u₂ h₁₂)
  have n₁₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₁ hu₃ h2u₃ h₁₃)
  have n₂₃ := sub_ne_zero.mpr (L.weierstrassP_ne_of_sub_notMem hu₂ hu₃ h2u₃ h₂₃)
  rw [L.scaledDisc_eq_of_three hu₁ hu₂ hu₃ h2u₁ h2u₂ h2u₃ h₁₂ h₁₃ h₂₃, scaledDisc,
    weierstrassP_eq_of_mem_iff hu₁ hM, deriv_derivWeierstrassP_eq_of_mem_iff hu₁ hM hu₂M,
    L.deriv_derivWeierstrassP_eq_mul hu₂ hu₁ hu₃ h2u₂ h2u₁ h2u₃ h₂₁ h₂₃ h₁₃,
    L.deriv_derivWeierstrassP_eq_mul hu₃ hu₁ hu₂ h2u₃ h2u₁ h2u₂ (sub_mem_comm_iff.not.mp h₁₃)
      (sub_mem_comm_iff.not.mp h₂₃) h₁₂]
  have he₃ : ℘[L] (u₂ + u₁) = -℘[L] u₁ - ℘[L] u₂ := by linear_combination hs
  rw [he₃] at n₁₃ n₂₃ ⊢
  have n : 2 * ℘[L] u₁ + ℘[L] u₂ ≠ 0 := fun h ↦ n₁₃ (by linear_combination h)
  have n' : ℘[L] u₁ + 2 * ℘[L] u₂ ≠ 0 := fun h ↦ n₂₃ (by linear_combination h)
  have hden : 2 * (℘[L] u₂ - ℘[L] u₁) * (℘[L] u₂ - (-℘[L] u₁ - ℘[L] u₂)) +
      2 * (-℘[L] u₁ - ℘[L] u₂ - ℘[L] u₁) * (-℘[L] u₁ - ℘[L] u₂ - ℘[L] u₂) =
      2 * (℘[L] u₁ + 2 * ℘[L] u₂) ^ 2 := by
    ring
  rw [show ℘[L] u₁ - (-℘[L] u₁ - ℘[L] u₂) = 2 * ℘[L] u₁ + ℘[L] u₂ by ring, hden]
  -- `s_Λ(u₁) = 16 (e₁ + 2 e₂)² / ((e₁ - e₂) (2 e₁ + e₂))` and its inverse times `2¹²` is `s_M(u₂)`
  rw [div_sub' (mul_ne_zero n₁₂ n), div_sub' (mul_ne_zero two_ne_zero (pow_ne_zero 2 n')),
    div_mul_div_comm, div_eq_iff (mul_ne_zero (mul_ne_zero n₁₂ n)
      (mul_ne_zero two_ne_zero (pow_ne_zero 2 n')))]
  ring

/-- **The isogeny relation**: let `u₁`, `u₂` be points of order two of `ℂ / Λ` that differ modulo
`Λ`, and let `Λ'` be the lattice `c (Λ + ℤ u₁)`, that is, `c x ∈ Λ'` exactly when `x ∈ Λ` or
`x + u₁ ∈ Λ`. Then `s_Λ(u₁) s_{Λ'}(c u₂) = 2¹²`. -/
theorem scaledDisc_mul_scaledDisc_eq {L' : PeriodPair} (c : ℂˣ) (hu₁ : u₁ ∉ L.lattice)
    (hu₂ : u₂ ∉ L.lattice) (h2u₂ : 2 * u₂ ∈ L.lattice) (h₁₂ : u₁ - u₂ ∉ L.lattice)
    (hL' : ∀ x, (c : ℂ) * x ∈ L'.lattice ↔ x ∈ L.lattice ∨ x + u₁ ∈ L.lattice) :
    L.scaledDisc u₁ * L'.scaledDisc (c * u₂) = 2 ^ 12 := by
  have hM : ∀ x, x ∈ (c⁻¹ • L').lattice ↔ x ∈ L.lattice ∨ x + u₁ ∈ L.lattice := fun x ↦ by
    rw [← hL', ← L'.mul_mem_lattice_smul_iff c⁻¹, Units.val_inv_eq_inv_val,
      inv_mul_cancel_left₀ c.ne_zero]
  rw [← L'.scaledDisc_smul c⁻¹, Units.val_inv_eq_inv_val, inv_mul_cancel_left₀ c.ne_zero]
  exact scaledDisc_mul_scaledDisc_eq_of_mem_iff hu₁ hu₂ h2u₂ h₁₂ hM

end Overlattice

end PeriodPair
