/-!
# The discriminant of a CM lattice is a unit at every prime

Let `d ≡ 7 mod 8` be squarefree, `ω = (1 + √-d) / 2`, and let `Λ` be a lattice stable under `ω`,
with its CM point `t` (`PeriodPair.IsCMPoint`): the point of order two killed by neither `ω` nor
`conj(ω)`, unique modulo `Λ`. For `b = ω` or `b = conj(ω)` the three points of order two are
`b t`, `(1 - b) t` and `t`, and the numbers `s_Λ(u) = 288 ℘(u)² / ℘''(u) - 64`
(`PeriodPair.scaledDiscr`) at them have sum `-48` and product `-2¹²`.

The isogeny of degree two with kernel generated by `b t` leads to the lattice `Λ' = Λ + ℤ b t`,
which is again stable under `ω`, and whose CM point `t'` satisfies `(1 - b) t' ≡ t` modulo `Λ'`.
So `s_Λ(b t) s_{Λ'}((1 - b) t') = 2¹²` and `s_{Λ'}(b t') s_{Λ'}(t') = -s_Λ(b t)`. The lattice `Λ`
is recovered from `Λ'` as `2 Λ' + (1 - b) Λ'`, so this step is a permutation of the finitely many
homothety classes of lattices stable under `ω` (their multiplier ring is the order
`ℤ[ω]` of discriminant `-d`, and the classes correspond to its proper form classes). Along the
cycles of this permutation, a norm above one would be replaced by its square root at each step;
hence, for every ring homomorphism `ι` from `ℂ` into an ultrametric ring with multiplicative
norm, such as `ℂ_[p]`, the three numbers `ι (s_Λ(u))` are integral. Multiplying the second
relation over all classes gives `∏ s(t) = (-1)^h`, `h` the number of classes, so `ι (s_Λ(t))`
is a unit.

For a CM lattice `(Λ, t, a₁)`, normalised by `℘''(t) = 2` and `a₁² = 12 ℘(t)`, the number `s_Λ(t)`
is the discriminant `a₁⁴ - 64`. Hence `‖ι (a₁⁴ - 64)‖ = 1` and `‖ι a₁‖ ≤ 1`.

## Main results

* `PeriodPair.IsCMPoint.scaledDiscr_add_add_eq`, `PeriodPair.IsCMPoint.scaledDiscr_mul_mul_eq`:
  the sum and product of `s_Λ` at `b t`, `(1 - b) t`, `t`.
* `PeriodPair.IsCMPoint.cmOmega_mul_mem_of_mem_iff`: `Λ + ℤ b t` is stable under `ω`.
* `PeriodPair.IsCMPoint.mem_iff_of_mem_iff`: `Λ = 2 Λ' + (1 - b) Λ'`.
* `PeriodPair.IsCMPoint.scaledDiscr_mul_scaledDiscr_eq_of_mem_iff`,
  `PeriodPair.IsCMPoint.scaledDiscr_mul_scaledDiscr_eq_neg_of_mem_iff`: the two relations along
  the isogeny.
* `PeriodPair.prod_scaledDiscr_eq_neg_one_pow`: the product of `s(t)` over the homothety classes
  of lattices stable under `ω` is `(-1)^h`.
* `PeriodPair.IsCMPoint.norm_map_scaledDiscr_mul_le_one`,
  `PeriodPair.IsCMPoint.norm_map_scaledDiscr_eq_one`: integrality, and the unit property at `t`.
* `PeriodPair.IsCMLattice.norm_map_pow_four_sub_sixty_four_eq_one`,
  `PeriodPair.IsCMLattice.norm_map_le_one`: `‖ι (a₁⁴ - 64)‖ = 1` and `‖ι a₁‖ ≤ 1`.

## References

* D. S. Kubert and S. Lang, *Modular Units*, Grundlehren der mathematischen Wissenschaften 244,
  Springer, 1981.
* B. J. Birch, *Weber's class invariants*, Mathematika 16 (1969), 283–294.
* The argument follows `Lib/CM/GoodReduction` of the folder `grh` of
  https://github.com/lsernau/grh-lean at commit 72fead102f663d5c7a407964a13dc0cf9d977207
  (Apache 2.0, Copyright 2026 Anthropic PBC), declarations `New.CMLattice.scaledDisc_two_isogeny`,
  `New.CMLattice.norm_scaledDisc_le_one`, `New.CMLattice.prod_scaledDisc_t` and
  `New.CMLattice.norm_disc_eq_one`. There the chain of isogenies runs over a family of CM lattices
  indexed by the ideal class group; here it runs over the homothety classes of lattices, and the
  permutation property comes from recovering `Λ` from `Λ + ℤ b t`.
-/

public section

open TauCeti

namespace PeriodPair

variable {L M : PeriodPair} {d : ℕ} {t t' a₁ b : ℂ}

/-! ### The two multipliers `ω` and `conj(ω)` -/

/-- If `b` is `ω` or `conj(ω)`, so is `1 - b`. -/
private theorem one_sub_eq_cmOmega_or_eq_conj
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) :
    1 - b = cmOmega d ∨ 1 - b = (starRingEnd ℂ) (cmOmega d) := by
  have h := cmOmega_add_conj (d := d)
  rcases hb with rfl | rfl
  · exact .inr (by linear_combination -h)
  · exact .inl (by linear_combination -h)

/-- For `d ≡ 7 mod 8` and `b = ω` or `conj(ω)`, `b (1 - b) = (d + 1) / 4` is even, so it kills every
half-period. -/
private theorem mul_one_sub_mul_mem (hd : d % 8 = 7)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) {z : ℂ} (hz : 2 * z ∈ L.lattice) :
    b * (1 - b) * z ∈ L.lattice := by
  have hbb : b * (1 - b) = cmOmega d * (starRingEnd ℂ) (cmOmega d) := by
    have h := cmOmega_add_conj (d := d)
    rcases hb with rfl | rfl
    · linear_combination (-cmOmega d) * h
    · linear_combination (-(starRingEnd ℂ) (cmOmega d)) * h
  obtain ⟨k, hk⟩ : ∃ k : ℕ, d + 1 = 8 * k := ⟨(d + 1) / 8, by omega⟩
  have hk' : ((d : ℂ) + 1) = 8 * k := by exact_mod_cast hk
  convert L.lattice.smul_mem (k : ℤ) hz using 1
  rw [hbb, cmOmega_mul_conj, hk', zsmul_eq_mul]
  push_cast
  ring

namespace IsCMPoint

variable (h : L.IsCMPoint d t)
include h

/-- A lattice with a CM point is stable under `b = ω` and `b = conj(ω)`. -/
private theorem mul_mem (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) {l : ℂ}
    (hl : l ∈ L.lattice) : b * l ∈ L.lattice := by
  rcases hb with rfl | rfl
  exacts [h.cmOmega_mul_mem hl, h.conj_cmOmega_mul_mem hl]

/-- `b t ∉ Λ` for `b = ω` and `b = conj(ω)`. -/
private theorem mul_notMem (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) :
    b * t ∉ L.lattice := by
  rcases hb with rfl | rfl
  exacts [h.cmOmega_mul_notMem, h.conj_cmOmega_mul_notMem]

/-- `b t` is a half-period. -/
private theorem two_mul_mul_mem (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) :
    2 * (b * t) ∈ L.lattice := by
  rw [mul_left_comm]
  exact h.mul_mem hb h.two_mul_mem

/-! ### The three points of order two -/

/-- The three points of order two `b t`, `(1 - b) t`, `t` of a lattice with CM point `t`, and their
sum and product of `s_Λ`. -/
private theorem scaledDiscr_add_add_eq_and_mul_mul_eq
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) :
    L.scaledDiscr (b * t) + L.scaledDiscr ((1 - b) * t) + L.scaledDiscr t = -48 ∧
      L.scaledDiscr (b * t) * L.scaledDiscr ((1 - b) * t) * L.scaledDiscr t = -2 ^ 12 := by
  have hb' := one_sub_eq_cmOmega_or_eq_conj hb
  have hu₁ := h.mul_notMem hb
  have hu₂ := h.mul_notMem hb'
  have h2u₁ := h.two_mul_mul_mem hb
  have h2u₂ := h.two_mul_mul_mem hb'
  -- `b t - (1 - b) t = 2 (b t) - t`
  have h₁₂ : b * t - (1 - b) * t ∉ L.lattice := fun hm ↦ h.notMem <| by
    convert sub_mem h2u₁ hm using 1
    ring
  have h₁₃ : b * t - t ∉ L.lattice := fun hm ↦ hu₂ <| by
    convert neg_mem hm using 1
    ring
  have h₂₃ : (1 - b) * t - t ∉ L.lattice := fun hm ↦ hu₁ <| by
    convert neg_mem hm using 1
    ring
  exact ⟨L.scaledDiscr_add_add_eq hu₁ hu₂ h.notMem h2u₁ h2u₂ h.two_mul_mem h₁₂ h₁₃ h₂₃,
    L.scaledDiscr_mul_mul_eq hu₁ hu₂ h.notMem h2u₁ h2u₂ h.two_mul_mem h₁₂ h₁₃ h₂₃⟩

/-- **The sum of `s_Λ` at the three points of order two of a lattice with CM point `t`**, for
`b = ω` or `conj(ω)`: `s_Λ(b t) + s_Λ((1 - b) t) + s_Λ(t) = -48`. -/
theorem scaledDiscr_add_add_eq (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) :
    L.scaledDiscr (b * t) + L.scaledDiscr ((1 - b) * t) + L.scaledDiscr t = -48 :=
  (h.scaledDiscr_add_add_eq_and_mul_mul_eq hb).1

/-- **The product of `s_Λ` at the three points of order two of a lattice with CM point `t`**, for
`b = ω` or `conj(ω)`: `s_Λ(b t) s_Λ((1 - b) t) s_Λ(t) = -2¹²`. -/
theorem scaledDiscr_mul_mul_eq (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) :
    L.scaledDiscr (b * t) * L.scaledDiscr ((1 - b) * t) * L.scaledDiscr t = -2 ^ 12 :=
  (h.scaledDiscr_add_add_eq_and_mul_mul_eq hb).2

/-- For `d ≡ 7 mod 8` and `b = ω` or `conj(ω)`, multiplication by `b` sends a half-period `x` into
`Λ` or into `b t + Λ`: it is `b x ∈ Λ` or `b (x - t) ∈ Λ`. -/
theorem mul_mem_or_mul_sub_mem (hd : d % 8 = 7)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) {x : ℂ} (hx : 2 * x ∈ L.lattice) :
    b * x ∈ L.lattice ∨ b * (x - t) ∈ L.lattice := by
  have hbt := mul_one_sub_mul_mem hd hb h.two_mul_mem
  have h₃ : t - b * t ∉ L.lattice := fun hm ↦ h.mul_notMem (one_sub_eq_cmOmega_or_eq_conj hb) <| by
    convert hm using 1
    ring
  rcases L.mem_lattice_or_sub_mem_lattice_of_two_mul_mem hx h.two_mul_mem (h.two_mul_mul_mem hb)
    h.notMem (h.mul_notMem hb) h₃ with h₀ | h₁ | h₂ | h₃
  · exact .inl (h.mul_mem hb h₀)
  · exact .inr (h.mul_mem hb h₁)
  · refine .inr ?_
    convert sub_mem (h.mul_mem hb h₂) hbt using 1
    ring
  · refine .inl ?_
    convert add_mem (h.mul_mem hb h₃) hbt using 1
    ring

/-! ### The isogeny of degree two with kernel generated by `b t` -/

/-- **The lattice `Λ + ℤ b t` is stable under `ω`**, for `d ≡ 7 mod 8` and `b = ω` or `conj(ω)`:
here the lattice of `M` is `Λ ∪ (Λ - b t)`. -/
theorem cmOmega_mul_mem_of_mem_iff (hd : d % 8 = 7)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d))
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + b * t ∈ L.lattice) {l : ℂ}
    (hl : l ∈ M.lattice) : cmOmega d * l ∈ M.lattice := by
  have hLM {x : ℂ} (hx : x ∈ L.lattice) : x ∈ M.lattice := (hM x).mpr (.inl hx)
  -- `ω (b t)` lies in `Λ ∪ (Λ - b t)`
  have hωbt : cmOmega d * (b * t) ∈ M.lattice := by
    rcases hb with rfl | rfl
    · refine (hM _).mpr (.inr ?_)
      convert sub_mem (h.two_mul_mul_mem (.inl rfl))
        (mul_one_sub_mul_mem hd (.inl rfl) h.two_mul_mem) using 1
      ring
    · refine hLM ?_
      convert mul_one_sub_mul_mem hd (.inr rfl) h.two_mul_mem using 1
      rw [show 1 - (starRingEnd ℂ) (cmOmega d) = cmOmega d by
        linear_combination -cmOmega_add_conj (d := d)]
      ring
  rcases (hM l).mp hl with hl | hl
  · exact hLM (h.cmOmega_mul_mem hl)
  · convert sub_mem (hLM (h.cmOmega_mul_mem hl)) hωbt using 1
    ring

/-- **Recovering `Λ` from `Λ' = Λ + ℤ b t`**: for `d ≡ 7 mod 8` and `b = ω` or `conj(ω)`, the
lattice `Λ` is `2 Λ' + (1 - b) Λ'`, the image of the dual isogeny. -/
theorem mem_iff_of_mem_iff (hd : d % 8 = 7)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d))
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + b * t ∈ L.lattice) (z : ℂ) :
    z ∈ L.lattice ↔ ∃ m ∈ M.lattice, ∃ m' ∈ M.lattice, 2 * m + (1 - b) * m' = z := by
  have hb' := one_sub_eq_cmOmega_or_eq_conj hb
  have hbt := mul_one_sub_mul_mem hd hb h.two_mul_mem
  constructor
  · intro hz
    -- `z = 2 (b (z / 2)) + (1 - b) z`, and `b (z / 2) ∈ Λ ∪ (Λ - b t)`
    have hz2 : 2 * (z / 2) ∈ L.lattice := by rwa [mul_div_cancel₀ _ two_ne_zero]
    refine ⟨b * (z / 2), (hM _).mpr ?_, z, (hM z).mpr (.inl hz), by ring⟩
    rcases h.mul_mem_or_mul_sub_mem hd hb hz2 with h₀ | h₁
    · exact .inl h₀
    · refine .inr ?_
      convert add_mem h₁ (h.two_mul_mul_mem hb) using 1
      ring
  · rintro ⟨m, hm, m', hm', rfl⟩
    refine add_mem ?_ ?_
    · rcases (hM m).mp hm with hm | hm
      · simpa [two_mul] using add_mem hm hm
      · convert sub_mem (add_mem hm hm) (h.two_mul_mul_mem hb) using 1
        ring
    · rcases (hM m').mp hm' with hm' | hm'
      · exact h.mul_mem hb' hm'
      · convert sub_mem (h.mul_mem hb' hm') hbt using 1
        ring

/-- On `Λ' = Λ + ℤ b t` with CM point `t'`, the point `t` of `Λ` is `(1 - b) t'` up to a kernel
element: `(1 - b) (t - t') ∈ Λ'`. -/
private theorem one_sub_mul_sub_mem_of_mem_iff (hd : d % 8 = 7)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d))
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + b * t ∈ L.lattice) (h' : M.IsCMPoint d t') :
    (1 - b) * (t - t') ∈ M.lattice := by
  have hb' := one_sub_eq_cmOmega_or_eq_conj hb
  -- `(1 - b) t` and `(1 - b) t + b t = t` lie outside `Λ`
  have hnot : (1 - b) * t ∉ M.lattice := by
    rw [hM, not_or]
    refine ⟨h.mul_notMem hb', fun hm ↦ h.notMem ?_⟩
    convert hm using 1
    ring
  exact (h'.mul_mem_or_mul_sub_mem hd hb' ((hM _).mpr (.inl h.two_mul_mem))).resolve_left hnot

/-- **The first relation along the isogeny of degree two**: for `d ≡ 7 mod 8`, `b = ω` or
`conj(ω)`, and `Λ' = Λ + ℤ b t` with CM point `t'`, `s_Λ(b t) s_{Λ'}((1 - b) t') = 2¹²`. -/
theorem scaledDiscr_mul_scaledDiscr_eq_of_mem_iff (hd : d % 8 = 7)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d))
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + b * t ∈ L.lattice) (h' : M.IsCMPoint d t') :
    L.scaledDiscr (b * t) * M.scaledDiscr ((1 - b) * t') = 2 ^ 12 := by
  have hb' := one_sub_eq_cmOmega_or_eq_conj hb
  have h₁₂ : b * t - (1 - b) * t ∉ L.lattice := fun hm ↦ h.notMem <| by
    convert sub_mem (h.two_mul_mul_mem hb) hm using 1
    ring
  have hrel := scaledDiscr_mul_scaledDiscr_eq (L' := M) 1 (h.mul_notMem hb) (h.mul_notMem hb')
    (h.two_mul_mul_mem hb') h₁₂ (by simpa using hM)
  -- move `(1 - b) t` to `(1 - b) t'` by the kernel element `(1 - b) (t - t')`
  have hshift : (1 - b) * t = (1 - b) * t' +
      ((⟨_, h.one_sub_mul_sub_mem_of_mem_iff hd hb hM h'⟩ : M.lattice) : ℂ) := by
    simp only
    ring
  rwa [Units.val_one, one_mul, hshift, scaledDiscr_add_coe] at hrel

/-- **The second relation along the isogeny of degree two**: for `d ≡ 7 mod 8`, `b = ω` or
`conj(ω)`, and `Λ' = Λ + ℤ b t` with CM point `t'`, `s_{Λ'}(b t') s_{Λ'}(t') = -s_Λ(b t)`. -/
theorem scaledDiscr_mul_scaledDiscr_eq_neg_of_mem_iff (hd : d % 8 = 7)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d))
    (hM : ∀ x, x ∈ M.lattice ↔ x ∈ L.lattice ∨ x + b * t ∈ L.lattice) (h' : M.IsCMPoint d t') :
    M.scaledDiscr (b * t') * M.scaledDiscr t' = -L.scaledDiscr (b * t) := by
  have hdual := h.scaledDiscr_mul_scaledDiscr_eq_of_mem_iff hd hb hM h'
  have hprod := h'.scaledDiscr_mul_mul_eq hb
  have hne : M.scaledDiscr ((1 - b) * t') ≠ 0 :=
    right_ne_zero_of_mul (hdual.trans_ne (by norm_num))
  refine mul_right_cancel₀ hne ?_
  linear_combination hprod + hdual

end IsCMPoint

/-! ### Dependence on the homothety class -/

/-- **`s_Λ` at multiples of the CM point depends only on the homothety class.** For `d ≡ 7 mod 8`,
if `Λ₁` and `Λ₂` are homothetic with CM points `t₁` and `t₂`, and `Λ₂` is stable under `b`, then
`s_{Λ₂}(b t₂) = s_{Λ₁}(b t₁)`. -/
theorem IsCMPoint.scaledDiscr_mul_eq_of_homothetic (hd : d % 8 = 7) {L₁ L₂ : PeriodPair}
    {t₁ t₂ : ℂ} (h₁ : L₁.IsCMPoint d t₁) (h₂ : L₂.IsCMPoint d t₂) (hL : L₁.Homothetic L₂)
    (hb : ∀ l ∈ L₂.lattice, b * l ∈ L₂.lattice) :
    L₂.scaledDiscr (b * t₂) = L₁.scaledDiscr (b * t₁) := by
  obtain ⟨c, hc⟩ := homothetic_def.mp hL
  -- `c t₁` is a CM point of `Λ₂`, so it is `t₂` modulo `Λ₂`
  have hct : L₂.IsCMPoint d (c * t₁) := (h₁.smul c).of_lattice_eq hc.symm
  have hsub := hb _ (h₂.sub_mem_lattice hd hct)
  have hshift : b * t₂ = c * (b * t₁) + ((⟨_, hsub⟩ : L₂.lattice) : ℂ) := by
    simp only
    ring
  rw [hshift, scaledDiscr_add_coe, scaledDiscr_eq_of_lattice_eq hc, scaledDiscr_smul]

/-- The homothety class of `Λ' = Λ + ℤ b t` determines that of `Λ`, as `Λ = 2 Λ' + (1 - b) Λ'`. -/
private theorem IsCMPoint.homothetic_of_homothetic_of_mem_iff (hd : d % 8 = 7)
    {L₁ L₂ M₁ M₂ : PeriodPair} {t₁ t₂ : ℂ} (h₁ : L₁.IsCMPoint d t₁) (h₂ : L₂.IsCMPoint d t₂)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d))
    (hM₁ : ∀ x, x ∈ M₁.lattice ↔ x ∈ L₁.lattice ∨ x + b * t₁ ∈ L₁.lattice)
    (hM₂ : ∀ x, x ∈ M₂.lattice ↔ x ∈ L₂.lattice ∨ x + b * t₂ ∈ L₂.lattice)
    (hM : M₁.Homothetic M₂) : L₁.Homothetic L₂ := by
  obtain ⟨c, hc⟩ := homothetic_def.mp hM
  have hc0 : (c : ℂ) ≠ 0 := c.ne_zero
  have hmem (N : PeriodPair) (z : ℂ) : z ∈ (c • N).lattice ↔ (c : ℂ)⁻¹ * z ∈ N.lattice := by
    rw [← N.mul_mem_lattice_smul_iff c, mul_inv_cancel_left₀ hc0]
  refine homothetic_def.mpr ⟨c, Submodule.ext fun z ↦ ?_⟩
  rw [hmem, h₂.mem_iff_of_mem_iff hd hb hM₂, h₁.mem_iff_of_mem_iff hd hb hM₁, hc]
  constructor
  · rintro ⟨m, hm, m', hm', rfl⟩
    rw [hmem] at hm hm'
    exact ⟨_, hm, _, hm', by ring⟩
  · rintro ⟨m, hm, m', hm', hz⟩
    refine ⟨c * m, (M₁.mul_mem_lattice_smul_iff c).mpr hm, c * m',
      (M₁.mul_mem_lattice_smul_iff c).mpr hm', ?_⟩
    rw [← mul_inv_cancel_left₀ hc0 z, ← hz]
    ring

/-! ### The chain of isogenies on the homothety classes -/

section Chain

variable (hd : d % 8 = 7) (hsq : Squarefree d) {hD : (-d : ℤ) % 4 = 0 ∨ (-d : ℤ) % 4 = 1}
include hd hsq

omit hsq in
/-- The homothety classes of lattices stable under `ω` are finitely many: they are the classes with
multiplier ring the order of discriminant `-d`, which correspond to its proper form classes. -/
private theorem finite_homothetyClass :
    Finite {x : PeriodPairHomothetyClass // x.leftOrder =
      QuadraticOrder.complexOrder (-d) (by simp) hD} :=
  have : NeZero d := ⟨by omega⟩
  Finite.of_equiv _ (BinaryQuadraticForm.cmHomothetyClassEquivPosDefProperClass d hD).symm

omit hsq in
/-- A representative of each homothety class with multiplier ring `ℤ[ω]`, with a CM point. -/
private theorem exists_family : ∃ (L : {x : PeriodPairHomothetyClass // x.leftOrder =
      QuadraticOrder.complexOrder (-d) (by simp) hD} → PeriodPair) (t : _ → ℂ),
    (∀ x, PeriodPairHomothetyClass.mk (L x) = x.val) ∧ ∀ x, (L x).IsCMPoint d (t x) := by
  have hrep (x : PeriodPairHomothetyClass) : ∃ L, PeriodPairHomothetyClass.mk L = x :=
    PeriodPairHomothetyClass.ind (fun L ↦ ⟨L, rfl⟩) x
  choose L hL using fun x : {x : PeriodPairHomothetyClass // x.leftOrder =
    QuadraticOrder.complexOrder (-d) (by simp) hD} ↦ hrep x.val
  have hω (x : _) : ∀ l ∈ (L x).lattice, cmOmega d * l ∈ (L x).lattice := fun _ ↦
    cmOmega_mul_mem_of_leftOrder_eq (by omega)
      (by rw [← PeriodPairHomothetyClass.leftOrder_mk, hL x]; exact x.property)
  choose t ht using fun x ↦ (L x).exists_isCMPoint (hω x)
  exact ⟨L, t, hL, ht⟩

/-- **The chain of isogenies of degree two is a permutation of the homothety classes.** For a
family of representatives `Λ_x` with CM points `t_x`, there is a permutation `σ` with
`s(b t_x) s((1 - b) t_{σ x}) = 2¹²` and `s(b t_{σ x}) s(t_{σ x}) = -s(b t_x)`. -/
private theorem exists_perm (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d))
    (L : {x : PeriodPairHomothetyClass // x.leftOrder =
      QuadraticOrder.complexOrder (-d) (by simp) hD} → PeriodPair)
    (hL : ∀ x, PeriodPairHomothetyClass.mk (L x) = x.val) (t : _ → ℂ)
    (ht : ∀ x, (L x).IsCMPoint d (t x)) :
    ∃ σ : Equiv.Perm _, ∀ x,
      (L x).scaledDiscr (b * t x) * (L (σ x)).scaledDiscr ((1 - b) * t (σ x)) = 2 ^ 12 ∧
      (L (σ x)).scaledDiscr (b * t (σ x)) * (L (σ x)).scaledDiscr (t (σ x)) =
        -(L x).scaledDiscr (b * t x) := by
  have := finite_homothetyClass hd (hD := hD)
  have hb' := one_sub_eq_cmOmega_or_eq_conj hb
  choose M hM using fun x ↦ (L x).exists_mem_lattice_iff_of_two_mul_mem
    ((ht x).two_mul_mul_mem hb)
  have hMω (x : _) : ∀ l ∈ (M x).lattice, cmOmega d * l ∈ (M x).lattice := fun _ ↦
    (ht x).cmOmega_mul_mem_of_mem_iff hd hb (hM x)
  choose t' ht' using fun x ↦ (M x).exists_isCMPoint (hMω x)
  -- the class of `Λ_x + ℤ b t_x`
  let f : _ → {x : PeriodPairHomothetyClass // x.leftOrder =
      QuadraticOrder.complexOrder (-d) (by simp) hD} := fun x ↦
    ⟨PeriodPairHomothetyClass.mk (M x), by
      rw [PeriodPairHomothetyClass.leftOrder_mk]
      exact leftOrder_eq_complexOrder_of_cmOmega_mul_mem hsq (hMω x) hD⟩
  have hf : Function.Injective f := fun x y hxy ↦ by
    have hxy' := PeriodPairHomothetyClass.mk_eq_mk_iff.mp (congrArg Subtype.val hxy)
    refine Subtype.ext ?_
    rw [← hL x, ← hL y, PeriodPairHomothetyClass.mk_eq_mk_iff]
    exact (ht x).homothetic_of_homothetic_of_mem_iff hd (ht y) hb (hM x) (hM y) hxy'
  refine ⟨Equiv.ofBijective f (Finite.injective_iff_bijective.mp hf), fun x ↦ ?_⟩
  -- the representative of the class `f x` is homothetic to `Λ_x + ℤ b t_x`
  have hσ : (M x).Homothetic (L (f x)) :=
    PeriodPairHomothetyClass.mk_eq_mk_iff.mp (hL (f x)).symm
  simp only [Equiv.ofBijective_apply]
  rw [(ht' x).scaledDiscr_mul_eq_of_homothetic hd (ht (f x)) hσ fun _ ↦ (ht (f x)).mul_mem hb',
    (ht' x).scaledDiscr_mul_eq_of_homothetic hd (ht (f x)) hσ fun _ ↦ (ht (f x)).mul_mem hb]
  have h₀ := (ht' x).scaledDiscr_mul_eq_of_homothetic hd (ht (f x)) hσ (b := 1) fun _ ↦ by
    simp
  simp only [one_mul] at h₀
  rw [h₀]
  exact ⟨(ht x).scaledDiscr_mul_scaledDiscr_eq_of_mem_iff hd hb (hM x) (ht' x),
    (ht x).scaledDiscr_mul_scaledDiscr_eq_neg_of_mem_iff hd hb (hM x) (ht' x)⟩

/-- **The product of the numbers `s(t)` over the homothety classes.** For `d ≡ 7 mod 8` squarefree
and representatives `Λ_x` with CM points `t_x` of the homothety classes of lattices whose
multiplier ring is the order `ℤ[ω]` of discriminant `-d`, `∏ₓ s_{Λ_x}(t_x) = (-1)^h`, where `h` is
the number of these classes. -/
theorem prod_scaledDiscr_eq_neg_one_pow
    (L : {x : PeriodPairHomothetyClass // x.leftOrder =
      QuadraticOrder.complexOrder (-d) (by simp) hD} → PeriodPair)
    (hL : ∀ x, PeriodPairHomothetyClass.mk (L x) = x.val) (t : _ → ℂ)
    (ht : ∀ x, (L x).IsCMPoint d (t x)) :
    ∏ᶠ x, (L x).scaledDiscr (t x) = (-1) ^ Nat.card {x : PeriodPairHomothetyClass //
      x.leftOrder = QuadraticOrder.complexOrder (-d) (by simp) hD} := by
  have := finite_homothetyClass hd (hD := hD)
  have := Fintype.ofFinite {x : PeriodPairHomothetyClass //
    x.leftOrder = QuadraticOrder.complexOrder (-d) (neg_nonpos.mpr (Nat.cast_nonneg _)) hD}
  obtain ⟨σ, hσ⟩ := exists_perm hd hsq (.inl rfl) L hL t ht
  rw [finprod_eq_prod_of_fintype, Nat.card_eq_fintype_card]
  -- multiply `s(ω t_{σ x}) s(t_{σ x}) = -s(ω t_x)` over all classes; the `s(ω t_x)` cancel
  set s := fun x ↦ (L x).scaledDiscr (cmOmega d * t x)
  have hne : ∏ x, s x ≠ 0 := Finset.prod_ne_zero_iff.mpr fun x _ ↦
    left_ne_zero_of_mul ((hσ x).1.trans_ne (by norm_num))
  refine mul_left_cancel₀ hne ?_
  calc (∏ x, s x) * ∏ x, (L x).scaledDiscr (t x)
      = ∏ x, s (σ x) * (L (σ x)).scaledDiscr (t (σ x)) := by
        rw [← Finset.prod_mul_distrib]
        exact (Equiv.prod_comp σ fun x ↦ s x * (L x).scaledDiscr (t x)).symm
    _ = (∏ x, s x) * (-1) ^ Fintype.card _ := by
        simp only [s, fun x ↦ (hσ x).2, Finset.prod_neg, mul_comm, Finset.card_univ]

section Integral

variable {R : Type*} [SeminormedRing R] [NormOneClass R] [NormMulClass R] [IsUltrametricDist R]

/-- **The numbers `s_Λ(b t)` are integral at every prime.** For `d ≡ 7 mod 8` squarefree, a lattice
`Λ` with CM point `t`, `b = ω` or `conj(ω)`, and a ring homomorphism `ι` from `ℂ` into an
ultrametric ring with multiplicative norm (such as `ℂ_[p]`), `‖ι (s_Λ(b t))‖ ≤ 1`. -/
theorem IsCMPoint.norm_map_scaledDiscr_mul_le_one (h : L.IsCMPoint d t)
    (hb : b = cmOmega d ∨ b = (starRingEnd ℂ) (cmOmega d)) (ι : ℂ →+* R) :
    ‖ι (L.scaledDiscr (b * t))‖ ≤ 1 := by
  have hD : (-d : ℤ) % 4 = 0 ∨ (-d : ℤ) % 4 = 1 := .inr (by omega)
  have := finite_homothetyClass hd (hD := hD)
  obtain ⟨Lr, tr, hLr, htr⟩ := exists_family hd (hD := hD)
  obtain ⟨σ, hσ⟩ := exists_perm hd hsq hb Lr hLr tr htr
  have h48 : ‖ι (-48)‖ ≤ 1 := by
    rw [map_neg, norm_neg, map_ofNat]
    exact_mod_cast IsUltrametricDist.norm_natCast_le_one R 48
  have h2 : ‖ι (2 ^ 12)‖ ≤ 1 := by
    rw [map_pow, map_ofNat, norm_pow]
    exact pow_le_one₀ (norm_nonneg _) (by exact_mod_cast IsUltrametricDist.norm_natCast_le_one R 2)
  have hcycle := IsUltrametricDist.norm_le_one_of_perm σ
    (s := fun x ↦ ι ((Lr x).scaledDiscr (b * tr x)))
    (s' := fun x ↦ ι ((Lr x).scaledDiscr ((1 - b) * tr x)))
    (s₀ := fun x ↦ ι ((Lr x).scaledDiscr (tr x)))
    (fun x ↦ by simpa only [← map_add, (htr x).scaledDiscr_add_add_eq hb] using h48)
    (fun x ↦ by simpa only [← map_mul, (hσ x).1] using h2)
    (fun x ↦ by simp only [← map_mul, (hσ x).2, map_neg, norm_neg])
  -- `Λ` is homothetic to the representative of its class
  have hx : (PeriodPairHomothetyClass.mk L).leftOrder =
      QuadraticOrder.complexOrder (-d) (by simp) hD := by
    rw [PeriodPairHomothetyClass.leftOrder_mk]
    exact leftOrder_eq_complexOrder_of_cmOmega_mul_mem hsq (fun _ ↦ h.cmOmega_mul_mem) hD
  have hhom : (Lr ⟨_, hx⟩).Homothetic L :=
    PeriodPairHomothetyClass.mk_eq_mk_iff.mp (hLr ⟨_, hx⟩)
  rw [(htr _).scaledDiscr_mul_eq_of_homothetic hd h hhom fun _ ↦ h.mul_mem hb]
  exact hcycle _

/-- **`s_Λ(t)` is integral at every prime**, for `d ≡ 7 mod 8` squarefree and a lattice `Λ` with CM
point `t`: `s_Λ(t) = -48 - s_Λ(ω t) - s_Λ(conj(ω) t)`. -/
theorem IsCMPoint.norm_map_scaledDiscr_le_one (h : L.IsCMPoint d t) (ι : ℂ →+* R) :
    ‖ι (L.scaledDiscr t)‖ ≤ 1 := by
  have hω : cmOmega d = cmOmega d ∨ cmOmega d = (starRingEnd ℂ) (cmOmega d) := .inl rfl
  have h48 : ‖ι (-48)‖ ≤ 1 := by
    rw [map_neg, norm_neg, map_ofNat]
    exact_mod_cast IsUltrametricDist.norm_natCast_le_one R 48
  rw [eq_sub_of_add_eq' (h.scaledDiscr_add_add_eq hω), ← sub_sub, map_sub, map_sub,
    sub_eq_add_neg, sub_eq_add_neg]
  refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ((IsUltrametricDist.norm_add_le_max
    _ _).trans (max_le h48 ?_)) ?_) <;> rw [norm_neg]
  exacts [h.norm_map_scaledDiscr_mul_le_one hd hsq hω ι,
    h.norm_map_scaledDiscr_mul_le_one hd hsq (one_sub_eq_cmOmega_or_eq_conj hω) ι]

end Integral

/-- **`s_Λ(t)` is a unit at every prime.** For `d ≡ 7 mod 8` squarefree, a lattice `Λ` with CM
point `t`, and a ring homomorphism `ι` from `ℂ` into an ultrametric commutative ring with
multiplicative norm and `‖1‖ = 1` (such as `ℂ_[p]`), `‖ι (s_Λ(t))‖ = 1`. -/
theorem IsCMPoint.norm_map_scaledDiscr_eq_one {R : Type*} [SeminormedCommRing R] [NormOneClass R]
    [NormMulClass R] [IsUltrametricDist R] (h : L.IsCMPoint d t) (ι : ℂ →+* R) :
    ‖ι (L.scaledDiscr t)‖ = 1 := by
  have hD : (-d : ℤ) % 4 = 0 ∨ (-d : ℤ) % 4 = 1 := .inr (by omega)
  have := finite_homothetyClass hd (hD := hD)
  have := Fintype.ofFinite {x : PeriodPairHomothetyClass //
    x.leftOrder = QuadraticOrder.complexOrder (-d) (neg_nonpos.mpr (Nat.cast_nonneg _)) hD}
  obtain ⟨Lr, tr, hLr, htr⟩ := exists_family hd (hD := hD)
  have hprod := prod_scaledDiscr_eq_neg_one_pow hd hsq Lr hLr tr htr
  rw [finprod_eq_prod_of_fintype] at hprod
  have hle (x : _) : ‖ι ((Lr x).scaledDiscr (tr x))‖ ≤ 1 :=
    (htr x).norm_map_scaledDiscr_le_one hd hsq ι
  have hnorm : ∏ x, ‖ι ((Lr x).scaledDiscr (tr x))‖ = 1 := by
    rw [← norm_prod, ← map_prod, hprod, map_pow, map_neg, map_one, norm_pow, norm_neg, norm_one,
      one_pow]
  -- `Λ` is homothetic to the representative of its class `x₀`
  have hx : (PeriodPairHomothetyClass.mk L).leftOrder =
      QuadraticOrder.complexOrder (-d) (by simp) hD := by
    rw [PeriodPairHomothetyClass.leftOrder_mk]
    exact leftOrder_eq_complexOrder_of_cmOmega_mul_mem hsq (fun _ ↦ h.cmOmega_mul_mem) hD
  have hhom : (Lr ⟨_, hx⟩).Homothetic L :=
    PeriodPairHomothetyClass.mk_eq_mk_iff.mp (hLr ⟨_, hx⟩)
  have hs := (htr ⟨_, hx⟩).scaledDiscr_mul_eq_of_homothetic hd h hhom (b := 1) fun _ ↦ by
    simp
  simp only [one_mul] at hs
  rw [hs]
  -- a product of numbers in `[0, 1]` equal to `1` has every factor equal to `1`
  classical
  refine le_antisymm (hle _) ?_
  rw [← hnorm, ← Finset.mul_prod_erase _ _ (Finset.mem_univ ⟨_, hx⟩)]
  exact mul_le_of_le_one_right (norm_nonneg _)
    (Finset.prod_le_one₀ (fun _ _ ↦ norm_nonneg _) fun x _ ↦ hle x)

end Chain

/-! ### The discriminant `a₁⁴ - 64` of a CM lattice -/

/-- For a normalised pointed lattice `(Λ, t, a₁)`, the number `s_Λ(t)` is the discriminant
`a₁⁴ - 64`: here `℘''(t) = 2` and `a₁² = 12 ℘(t)`. -/
theorem IsNormalizedPointed.scaledDiscr_eq (h : L.IsNormalizedPointed t a₁) :
    L.scaledDiscr t = a₁ ^ 4 - 64 := by
  rw [scaledDiscr_def, L.deriv_derivWeierstrassP h.notMem, h.g₂_eq]
  linear_combination -(a₁ ^ 2 + 12 * ℘[L] t) * h.a₁_sq

variable {R : Type*} [SeminormedCommRing R] [NormOneClass R] [NormMulClass R]
  [IsUltrametricDist R]

/-- **The discriminant of a CM lattice is a unit at every prime.** For `d ≡ 7 mod 8` squarefree, a
CM lattice `(Λ, t, a₁)` and a ring homomorphism `ι` from `ℂ` into an ultrametric commutative ring
with multiplicative norm and `‖1‖ = 1` (such as `ℂ_[p]`), `‖ι a₁ ^ 4 - 64‖ = 1`. -/
theorem IsCMLattice.norm_map_pow_four_sub_sixty_four_eq_one (hd : d % 8 = 7) (hsq : Squarefree d)
    (h : L.IsCMLattice d t a₁) (ι : ℂ →+* R) : ‖ι a₁ ^ 4 - 64‖ = 1 := by
  rw [← map_pow, ← map_ofNat ι 64, ← map_sub, ← h.isNormalizedPointed.scaledDiscr_eq]
  exact h.isCMPoint.norm_map_scaledDiscr_eq_one hd hsq ι

/-- **The coefficient `a₁` of a CM lattice is integral at every prime**: `a₁⁴` is the sum of the
unit `a₁⁴ - 64` and the integer `64`. -/
theorem IsCMLattice.norm_map_le_one (hd : d % 8 = 7) (hsq : Squarefree d)
    (h : L.IsCMLattice d t a₁) (ι : ℂ →+* R) : ‖ι a₁‖ ≤ 1 := by
  have h4 : ‖ι a₁‖ ^ 4 ≤ 1 := by
    rw [← norm_pow, ← sub_add_cancel (ι a₁ ^ 4) 64]
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
    · exact (h.norm_map_pow_four_sub_sixty_four_eq_one hd hsq ι).le
    · exact_mod_cast IsUltrametricDist.norm_natCast_le_one R 64
  exact (pow_le_one_iff_of_nonneg (norm_nonneg _) four_ne_zero).mp h4

end PeriodPair
