/-!
# Zeros of the Fresnel integrals at the origin and on the symmetry rays

The Fresnel integrals `C(z) = ∫₀^z cos(πt²/2) dt` and `S(z) = ∫₀^z sin(πt²/2) dt` have a simple
and a triple zero at `0`. Away from `0` neither function vanishes on the eight rays
`ph z ∈ (π/4)ℤ` (DLMF §7.13(iii)). These rays are the mirror lines of the reflections in the
group of order `8` generated by `z ↦ iz` and `z ↦ conj z`, which maps the zero sets of `C` and `S`
to themselves; so every nonzero zero lies in one of the eight open sectors between the rays.

## Main results

* `TauCeti.analyticOrderAt_fresnelC_zero`, `TauCeti.analyticOrderAt_fresnelS_zero`: `C` has a
  simple zero and `S` a triple zero at `0`.
* `TauCeti.integral_cos_pi_mul_sq_div_two_pos`, `TauCeti.integral_sin_pi_mul_sq_div_two_pos`:
  the real Fresnel integrals `∫₀ˣ cos(πt²/2) dt` and `∫₀ˣ sin(πt²/2) dt` are positive for `x > 0`.
* `TauCeti.fresnelC_ne_zero_of_arg_eq`, `TauCeti.fresnelS_ne_zero_of_arg_eq`: for `z ≠ 0` with
  `ph z = kπ/4`, `k ∈ ℤ`, `C(z) ≠ 0` and `S(z) ≠ 0`.

## Implementation notes

On a ray `z = rω` with `r > 0` and `ω⁸ = 1`, the integrand `cos(πω²t²/2)` of `C` is `cos(πt²/2)`
when `ω² = ±1` and `cosh(πt²/2)` when `ω² = ±i`, and similarly for `S`. The second case is
plainly nonzero. The first reduces to the positivity of the real Fresnel integrals on `(0, ∞)`:
`C(x) > 0` and `S(x) > 0` for `x > 0`.

That positivity is proved by monotone comparison functions on `[1, ∞)`. Integrating by parts
twice, the functions
`C(x) − sin(πx²/2)/(πx) + (cos(πx²/2) − 1)/(π²x³)` and `S(x) − (1 − cos(πx²/2))/(πx)` have the
nonnegative derivatives `3(1 − cos(πx²/2))/(π²x⁴)` and `(1 − cos(πx²/2))/(πx²)`. Hence
`C(x) ≥ C(1) − 2/π − 1/π²` and `S(x) ≥ S(1) − 1/π` for `x ≥ 1`, and the Taylor bounds
`cos y ≥ 1 − y²/2` and `sin y ≥ y − y³/6` give `C(1) ≥ 1 − π²/40` and `S(1) ≥ π/6 − π³/336`,
which exceed these thresholds. On `(0, 1]` both integrands are positive.

## References

* [DLMF] *NIST Digital Library of Mathematical Functions*, §7.13(iii),
  <https://dlmf.nist.gov/7.13>.
-/

public section

noncomputable section

open Complex Set MeasureTheory intervalIntegral

open scoped Real

namespace TauCeti

/-! ### The zeros at the origin -/

/-- `C` has a simple zero at `0`. -/
theorem analyticOrderAt_fresnelC_zero : analyticOrderAt fresnelC 0 = 1 :=
  (differentiable_fresnelC.analyticAt 0).analyticOrderAt_eq_one_of_zero_deriv_ne_zero
    fresnelC_zero (by simp)

/-- `sin(πz²/2)` has a double zero at `0`. -/
private theorem analyticOrderAt_sin_pi_mul_sq_div_two :
    analyticOrderAt (fun z : ℂ => Complex.sin (π * z ^ 2 / 2)) 0 = 2 := by
  have hsin : analyticOrderAt Complex.sin 0 = 1 :=
    (Complex.differentiable_sin.analyticAt 0).analyticOrderAt_eq_one_of_zero_deriv_ne_zero
      (by simp) (by simp)
  have hsq : analyticOrderAt (fun z : ℂ => π * z ^ 2 / 2 - π * 0 ^ 2 / 2) 0 = 2 :=
    (AnalyticAt.analyticOrderAt_eq_natCast (by fun_prop)).2
      ⟨fun _ => (π : ℂ) / 2, analyticAt_const, by simp [Real.pi_ne_zero],
        Filter.Eventually.of_forall fun z => by simp only [sub_zero, smul_eq_mul]; ring⟩
  rw [← Function.comp_def Complex.sin,
    (Complex.differentiable_sin.analyticAt _).analyticOrderAt_comp (by fun_prop), hsq]
  simp [hsin]

/-- `S` has a triple zero at `0`. -/
theorem analyticOrderAt_fresnelS_zero : analyticOrderAt fresnelS 0 = 3 :=
  (analyticOrderAt_deriv_eq_iff (differentiable_fresnelS.analyticAt 0) fresnelS_zero
    (n := 2)).2 (by simpa using analyticOrderAt_sin_pi_mul_sq_div_two)

/-! ### Positivity of the real Fresnel integrals -/

/-- `πt²/2` has derivative `πx` at `x`. -/
private theorem hasDerivAt_pi_mul_sq_div_two (x : ℝ) :
    HasDerivAt (fun t : ℝ => π * t ^ 2 / 2) (π * x) x := by
  convert ((hasDerivAt_pow 2 x).const_mul π).div_const 2 using 1
  ring

/-- For continuous `f`, the real integral `∫₀ˣ f(πt²/2) dt` has derivative `f(πx²/2)`. -/
private theorem hasDerivAt_integral_comp_pi_mul_sq_div_two {f : ℝ → ℝ} (hf : Continuous f)
    (x : ℝ) :
    HasDerivAt (fun x : ℝ => ∫ t in (0 : ℝ)..x, f (π * t ^ 2 / 2)) (f (π * x ^ 2 / 2)) x :=
  ((hf.comp (by fun_prop : Continuous fun t : ℝ => π * t ^ 2 / 2)).integral_hasStrictDerivAt
    0 x).hasDerivAt

/-- The comparison function `C(x) − sin(πx²/2)/(πx) + (cos(πx²/2) − 1)/(π²x³)` has derivative
`3(1 − cos(πx²/2))/(π²x⁴) ≥ 0` for `x ≠ 0`, so it is monotone on `[1, ∞)`. -/
private theorem monotoneOn_fresnelC_comparison :
    MonotoneOn (fun x : ℝ => (∫ t in (0 : ℝ)..x, Real.cos (π * t ^ 2 / 2)) -
        Real.sin (π * x ^ 2 / 2) / (π * x) + (Real.cos (π * x ^ 2 / 2) - 1) / (π ^ 2 * x ^ 3))
      (Ici 1) := by
  refine monotoneOn_of_hasDerivAt_nonneg (convex_Ici 1)
    (f' := fun x => 3 * (1 - Real.cos (π * x ^ 2 / 2)) / (π ^ 2 * x ^ 4)) (fun x hx => ?_)
    fun x _ => div_nonneg (by linarith [Real.cos_le_one (π * x ^ 2 / 2)]) (by positivity)
  have hx0 : x ≠ 0 := (zero_lt_one.trans_le hx).ne'
  have hφ := hasDerivAt_pi_mul_sq_div_two x
  have h1 := hφ.sin.div ((hasDerivAt_id x).const_mul π) (mul_ne_zero Real.pi_ne_zero hx0)
  have h2 := (hφ.cos.sub_const 1).div ((hasDerivAt_pow 3 x).const_mul (π ^ 2))
    (mul_ne_zero (pow_ne_zero 2 Real.pi_ne_zero) (pow_ne_zero 3 hx0))
  convert ((hasDerivAt_integral_comp_pi_mul_sq_div_two Real.continuous_cos x).sub h1).add h2
    using 1
  · funext y
    simp only [Pi.add_apply, Pi.sub_apply, Pi.div_apply, id]
  · simp only [id]
    field_simp
    ring

/-- The comparison function `S(x) − (1 − cos(πx²/2))/(πx)` has derivative
`(1 − cos(πx²/2))/(πx²) ≥ 0` for `x ≠ 0`, so it is monotone on `[1, ∞)`. -/
private theorem monotoneOn_fresnelS_comparison :
    MonotoneOn (fun x : ℝ => (∫ t in (0 : ℝ)..x, Real.sin (π * t ^ 2 / 2)) -
        (1 - Real.cos (π * x ^ 2 / 2)) / (π * x)) (Ici 1) := by
  refine monotoneOn_of_hasDerivAt_nonneg (convex_Ici 1)
    (f' := fun x => (1 - Real.cos (π * x ^ 2 / 2)) / (π * x ^ 2)) (fun x hx => ?_)
    fun x _ => div_nonneg (by linarith [Real.cos_le_one (π * x ^ 2 / 2)]) (by positivity)
  have hx0 : x ≠ 0 := (zero_lt_one.trans_le hx).ne'
  have h1 := ((hasDerivAt_pi_mul_sq_div_two x).cos.const_sub 1).div
    ((hasDerivAt_id x).const_mul π) (mul_ne_zero Real.pi_ne_zero hx0)
  convert (hasDerivAt_integral_comp_pi_mul_sq_div_two Real.continuous_sin x).sub h1 using 1
  · funext y
    simp only [Pi.sub_apply, Pi.div_apply, id]
  · simp only [id]
    field_simp
    ring

/-- `C(1) ≥ 1 − π²/40`, from `cos y ≥ 1 − y²/2`. -/
private theorem one_sub_pi_sq_div_forty_le_integral_cos :
    1 - π ^ 2 / 40 ≤ ∫ t in (0 : ℝ)..1, Real.cos (π * t ^ 2 / 2) := by
  have h : ∫ t in (0 : ℝ)..1, (1 - π ^ 2 / 8 * t ^ 4) = 1 - π ^ 2 / 40 := by
    rw [integral_sub (Continuous.intervalIntegrable (by fun_prop) _ _)
      (Continuous.intervalIntegrable (by fun_prop) _ _), intervalIntegral.integral_const_mul,
      integral_pow, integral_one]
    ring
  rw [← h]
  refine integral_mono_on zero_le_one (Continuous.intervalIntegrable (by fun_prop) _ _)
    (Continuous.intervalIntegrable (by fun_prop) _ _) fun t _ => ?_
  have := Real.one_sub_sq_div_two_le_cos (x := π * t ^ 2 / 2)
  linarith [show (π * t ^ 2 / 2) ^ 2 / 2 = π ^ 2 / 8 * t ^ 4 by ring]

/-- `S(1) ≥ π/6 − π³/336`, from `sin y ≥ y − y³/6` for `y ≥ 0`. -/
private theorem pi_div_six_sub_le_integral_sin :
    π / 6 - π ^ 3 / 336 ≤ ∫ t in (0 : ℝ)..1, Real.sin (π * t ^ 2 / 2) := by
  have h : ∫ t in (0 : ℝ)..1, (π / 2 * t ^ 2 - π ^ 3 / 48 * t ^ 6) = π / 6 - π ^ 3 / 336 := by
    rw [integral_sub (Continuous.intervalIntegrable (by fun_prop) _ _)
      (Continuous.intervalIntegrable (by fun_prop) _ _), intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul, integral_pow, integral_pow]
    ring
  rw [← h]
  refine integral_mono_on zero_le_one (Continuous.intervalIntegrable (by fun_prop) _ _)
    (Continuous.intervalIntegrable (by fun_prop) _ _) fun t _ => ?_
  have := Real.sin_ge_sub_cube (x := π * t ^ 2 / 2) (by positivity)
  linarith [show π * t ^ 2 / 2 - (π * t ^ 2 / 2) ^ 3 / 6 = π / 2 * t ^ 2 - π ^ 3 / 48 * t ^ 6 by
    ring]

/-- The real Fresnel integral `∫₀ˣ cos(πt²/2) dt` is positive for `x > 0`. -/
theorem integral_cos_pi_mul_sq_div_two_pos {x : ℝ} (hx : 0 < x) :
    0 < ∫ t in (0 : ℝ)..x, Real.cos (π * t ^ 2 / 2) := by
  rcases le_or_gt x 1 with hx1 | hx1
  · refine intervalIntegral_pos_of_pos_on
      (Continuous.intervalIntegrable (by fun_prop) _ _) (fun t ht => ?_) hx
    have ht1 : t ^ 2 < 1 := by nlinarith [ht.1, ht.2]
    exact Real.cos_pos_of_mem_Ioo ⟨by nlinarith [Real.pi_pos, sq_nonneg t],
      by nlinarith [Real.pi_pos]⟩
  · -- The comparison function takes the value `C(1) − 1/π − 1/π²` at `1`.
    have hmono : (∫ t in (0 : ℝ)..1, Real.cos (π * t ^ 2 / 2)) - 1 / π - 1 / π ^ 2 ≤
        (∫ t in (0 : ℝ)..x, Real.cos (π * t ^ 2 / 2)) - Real.sin (π * x ^ 2 / 2) / (π * x) +
          (Real.cos (π * x ^ 2 / 2) - 1) / (π ^ 2 * x ^ 3) := by
      convert monotoneOn_fresnelC_comparison (mem_Ici.2 le_rfl) (mem_Ici.2 hx1.le) hx1.le
        using 1
      simp only [one_pow, mul_one, Real.sin_pi_div_two, Real.cos_pi_div_two]
      ring
    have hC1 := one_sub_pi_sq_div_forty_le_integral_cos
    -- Bound the two boundary terms at `x`.
    have hsin : -(1 / π) ≤ Real.sin (π * x ^ 2 / 2) / (π * x) := by
      rw [neg_le, ← neg_div, div_le_div_iff₀ (by positivity) Real.pi_pos]
      nlinarith [Real.neg_one_le_sin (π * x ^ 2 / 2), Real.pi_pos]
    have hcos : (Real.cos (π * x ^ 2 / 2) - 1) / (π ^ 2 * x ^ 3) ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg (by linarith [Real.cos_le_one (π * x ^ 2 / 2)])
        (by positivity)
    -- Numerical check `1 − π²/40 − 2/π − 1/π² > 0`.
    have hπ1 : π ^ 2 < 9.8697 := by nlinarith [Real.pi_lt_d4, Real.pi_pos]
    have hπ2 : 1 / π < 0.31833 := by
      rw [div_lt_iff₀ Real.pi_pos]; nlinarith [Real.pi_gt_d4]
    have hπ3 : 1 / π ^ 2 < 0.10133 := by
      rw [div_lt_iff₀ (by positivity)]; nlinarith [Real.pi_gt_d4]
    linarith

/-- The real Fresnel integral `∫₀ˣ sin(πt²/2) dt` is positive for `x > 0`. -/
theorem integral_sin_pi_mul_sq_div_two_pos {x : ℝ} (hx : 0 < x) :
    0 < ∫ t in (0 : ℝ)..x, Real.sin (π * t ^ 2 / 2) := by
  rcases le_or_gt x 1 with hx1 | hx1
  · refine intervalIntegral_pos_of_pos_on
      (Continuous.intervalIntegrable (by fun_prop) _ _) (fun t ht => ?_) hx
    have ht1 : t ^ 2 < 1 := by nlinarith [ht.1, ht.2]
    exact Real.sin_pos_of_pos_of_lt_pi (by have := ht.1; positivity)
      (by nlinarith [Real.pi_pos])
  · -- The comparison function takes the value `S(1) − 1/π` at `1`.
    have hmono : (∫ t in (0 : ℝ)..1, Real.sin (π * t ^ 2 / 2)) - 1 / π ≤
        (∫ t in (0 : ℝ)..x, Real.sin (π * t ^ 2 / 2)) -
          (1 - Real.cos (π * x ^ 2 / 2)) / (π * x) := by
      convert monotoneOn_fresnelS_comparison (mem_Ici.2 le_rfl) (mem_Ici.2 hx1.le) hx1.le
        using 1
      simp only [one_pow, mul_one, Real.cos_pi_div_two]
      ring
    have hS1 := pi_div_six_sub_le_integral_sin
    have hcos : 0 ≤ (1 - Real.cos (π * x ^ 2 / 2)) / (π * x) :=
      div_nonneg (by linarith [Real.cos_le_one (π * x ^ 2 / 2)]) (by positivity)
    -- Numerical check `π/6 − π³/336 > 1/π`.
    have hπ1 : π ^ 3 < 31.26 := calc
      π ^ 3 < 3.15 ^ 3 := pow_lt_pow_left₀ Real.pi_lt_d2 Real.pi_pos.le (by norm_num)
      _ < 31.26 := by norm_num
    have hπ2 : 1 / π < 0.3185 := by
      rw [div_lt_iff₀ Real.pi_pos]; nlinarith [Real.pi_gt_d2]
    linarith [Real.pi_gt_d2]

/-! ### The zeros on the rays `ph z ∈ (π/4)ℤ` -/

/-- Pulling a direction `ω` out of the segment integral `∫₀¹ rω F(π(srω)²/2) ds`. -/
private theorem integral_ofReal_mul_mul_comp (F : ℂ → ℂ) (r : ℝ) (ω : ℂ) :
    ∫ s in (0 : ℝ)..1, (r * ω) * F (π * ((s : ℂ) * (r * ω)) ^ 2 / 2) =
      ω * ∫ s in (0 : ℝ)..1, (r : ℂ) * F (ω ^ 2 * (π * ((s : ℂ) * r) ^ 2 / 2)) := by
  rw [← intervalIntegral.integral_const_mul]
  congr 1
  funext s
  rw [show (π : ℂ) * ((s : ℂ) * (r * ω)) ^ 2 / 2 = ω ^ 2 * (π * ((s : ℂ) * r) ^ 2 / 2) by ring]
  ring

/-- The segment integral `∫₀¹ r f(π(sr)²/2) ds` of a real function `f`, viewed in `ℂ`. -/
private theorem integral_ofReal_mul_comp {f : ℝ → ℝ} {F : ℂ → ℂ}
    (hF : ∀ y : ℝ, F y = f y) (r : ℝ) :
    ∫ s in (0 : ℝ)..1, (r : ℂ) * F (π * ((s : ℂ) * r) ^ 2 / 2) =
      ((∫ s in (0 : ℝ)..1, r * f (π * (s * r) ^ 2 / 2) : ℝ) : ℂ) := by
  rw [← integral_ofReal]
  congr 1
  funext s
  rw [ofReal_mul, ← hF]
  push_cast
  ring

/-- The segment integral `∫₀¹ r f(π(sr)²/2) ds` is the real integral `∫₀ʳ f(πt²/2) dt`. -/
private theorem integral_mul_comp_eq (f : ℝ → ℝ) (r : ℝ) :
    ∫ s in (0 : ℝ)..1, r * f (π * (s * r) ^ 2 / 2) = ∫ t in (0 : ℝ)..r, f (π * t ^ 2 / 2) := by
  rw [intervalIntegral.integral_const_mul,
    mul_integral_comp_mul_right (f := fun t => f (π * t ^ 2 / 2)), zero_mul, one_mul]

/-- On a ray through a direction `ω` with `ω² = ±1` or `ω² = ±i`, `C` does not vanish away from
`0`. -/
private theorem fresnelC_ofReal_mul_ne_zero {r : ℝ} (hr : 0 < r) {ω : ℂ} (hω : ω ≠ 0)
    (hω2 : ω ^ 2 = 1 ∨ ω ^ 2 = -1 ∨ ω ^ 2 = I ∨ ω ^ 2 = -I) :
    fresnelC (r * ω) ≠ 0 := by
  rw [fresnelC_def, integral_ofReal_mul_mul_comp]
  refine mul_ne_zero hω ?_
  have hcos : (∀ w : ℂ, Complex.cos (ω ^ 2 * w) = Complex.cos w) ∨
      ∀ w : ℂ, Complex.cos (ω ^ 2 * w) = Complex.cosh w := by
    rcases hω2 with h | h | h | h <;> simp only [h]
    · simp
    · simp
    · exact Or.inr fun w => by rw [mul_comm, cos_mul_I]
    · exact Or.inr fun w => by rw [neg_mul, cos_neg, mul_comm, cos_mul_I]
  rcases hcos with h | h
  · simp_rw [h]
    rw [integral_ofReal_mul_comp (f := Real.cos) (fun y => (ofReal_cos y).symm),
      integral_mul_comp_eq, ofReal_ne_zero]
    exact (integral_cos_pi_mul_sq_div_two_pos hr).ne'
  · simp_rw [h]
    rw [integral_ofReal_mul_comp (f := Real.cosh) (fun y => (ofReal_cosh y).symm), ofReal_ne_zero]
    exact (intervalIntegral_pos_of_pos_on (Continuous.intervalIntegrable (by fun_prop) _ _)
      (fun s _ => mul_pos hr (Real.cosh_pos _)) zero_lt_one).ne'

/-- On a ray through a direction `ω` with `ω² = ±1` or `ω² = ±i`, `S` does not vanish away from
`0`. -/
private theorem fresnelS_ofReal_mul_ne_zero {r : ℝ} (hr : 0 < r) {ω : ℂ} (hω : ω ≠ 0)
    (hω2 : ω ^ 2 = 1 ∨ ω ^ 2 = -1 ∨ ω ^ 2 = I ∨ ω ^ 2 = -I) :
    fresnelS (r * ω) ≠ 0 := by
  rw [fresnelS_def, integral_ofReal_mul_mul_comp]
  refine mul_ne_zero hω ?_
  have hω2' : ω ^ 2 ≠ 0 := pow_ne_zero 2 hω
  have hsin : (∀ w : ℂ, Complex.sin (ω ^ 2 * w) = ω ^ 2 * Complex.sin w) ∨
      ∀ w : ℂ, Complex.sin (ω ^ 2 * w) = ω ^ 2 * Complex.sinh w := by
    rcases hω2 with h | h | h | h <;> simp only [h]
    · simp
    · simp
    · exact Or.inr fun w => by rw [mul_comm, sin_mul_I, mul_comm]
    · exact Or.inr fun w => by rw [neg_mul, sin_neg, mul_comm, sin_mul_I]; ring
  rcases hsin with h | h
  · simp_rw [h, mul_left_comm (r : ℂ)]
    rw [intervalIntegral.integral_const_mul,
      integral_ofReal_mul_comp (f := Real.sin) (fun y => (ofReal_sin y).symm),
      integral_mul_comp_eq]
    exact mul_ne_zero hω2' (ofReal_ne_zero.2 (integral_sin_pi_mul_sq_div_two_pos hr).ne')
  · simp_rw [h, mul_left_comm (r : ℂ)]
    rw [intervalIntegral.integral_const_mul,
      integral_ofReal_mul_comp (f := Real.sinh) (fun y => (ofReal_sinh y).symm)]
    refine mul_ne_zero hω2' (ofReal_ne_zero.2 (intervalIntegral_pos_of_pos_on
      (Continuous.intervalIntegrable (by fun_prop) _ _)
      (fun s hs => mul_pos hr (Real.sinh_pos_iff.2 ?_)) zero_lt_one).ne')
    have := hs.1
    positivity

/-- If `ph z = kπ/4` with `k ∈ ℤ`, then the direction `ω = e^{i ph z}` satisfies
`ω² ∈ {1, −1, i, −i}`. -/
private theorem exp_arg_mul_I_sq_mem {z : ℂ} {k : ℤ} (h : arg z = k * (π / 4)) :
    cexp (arg z * I) ^ 2 = 1 ∨ cexp (arg z * I) ^ 2 = -1 ∨ cexp (arg z * I) ^ 2 = I ∨
      cexp (arg z * I) ^ 2 = -I := by
  rw [← Complex.exp_natCast_mul, h, show ((2 : ℕ) : ℂ) * (((k * (π / 4) : ℝ)) * I) =
      k * (π / 2 * I) by push_cast; ring, Complex.exp_intCast_mul, exp_pi_div_two_mul_I]
  clear h
  induction k using Int.induction_on with
  | zero => simp
  | succ n ih =>
    rw [zpow_add_one₀ I_ne_zero]
    rcases ih with h | h | h | h <;> simp [h]
  | pred n ih =>
    rw [zpow_sub_one₀ I_ne_zero, inv_I]
    rcases ih with h | h | h | h <;> simp [h]

/-- **DLMF §7.13(iii)**: `C` does not vanish on the rays `ph z ∈ (π/4)ℤ` away from `0`. -/
theorem fresnelC_ne_zero_of_arg_eq {z : ℂ} (hz : z ≠ 0) {k : ℤ} (h : arg z = k * (π / 4)) :
    fresnelC z ≠ 0 := by
  rw [← norm_mul_exp_arg_mul_I z]
  exact fresnelC_ofReal_mul_ne_zero (norm_pos_iff.2 hz) (Complex.exp_ne_zero _)
    (exp_arg_mul_I_sq_mem h)

/-- **DLMF §7.13(iii)**: `S` does not vanish on the rays `ph z ∈ (π/4)ℤ` away from `0`. -/
theorem fresnelS_ne_zero_of_arg_eq {z : ℂ} (hz : z ≠ 0) {k : ℤ} (h : arg z = k * (π / 4)) :
    fresnelS z ≠ 0 := by
  rw [← norm_mul_exp_arg_mul_I z]
  exact fresnelS_ofReal_mul_ne_zero (norm_pos_iff.2 hz) (Complex.exp_ne_zero _)
    (exp_arg_mul_I_sq_mem h)

end TauCeti
