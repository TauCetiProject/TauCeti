/-! ### Numerator polynomials `expPartialSumPoly` -/

/-- The integer polynomial sequence `p_k ∈ ℤ[X]` forming the numerators of the Buckholtz
coefficients `d_k(z) = (-1)^k z p_k(z) / (1 - z)^{2k + 1}` (DLMF 8.11.18–8.11.19):
`p_0 = 1` and `p_{k+1}(X) = (1 + 2k X) p_k(X) + X (1 - X) p_k'(X)`. -/
def expPartialSumPoly : ℕ → ℤ[X]
  | 0 => 1
  | k + 1 =>
      (1 + C (2 * (k : ℤ)) * X) * expPartialSumPoly k +
        X * (1 - X) * (expPartialSumPoly k).derivative

/-- `p_0(X) = 1`. -/
@[simp]
theorem expPartialSumPoly_zero : expPartialSumPoly 0 = 1 := by
  rw [expPartialSumPoly]

/-- Defining recurrence `p_{k+1}(X) = (1 + 2k X) p_k(X) + X (1 - X) p_k'(X)`. -/
theorem expPartialSumPoly_succ (k : ℕ) :
    expPartialSumPoly (k + 1) =
      (1 + C (2 * (k : ℤ)) * X) * expPartialSumPoly k +
        X * (1 - X) * (expPartialSumPoly k).derivative := by
  rw [expPartialSumPoly]

/-- `p_1(X) = 1`. -/
@[simp]
theorem expPartialSumPoly_one : expPartialSumPoly 1 = 1 := by
  simp [expPartialSumPoly_succ]

/-- `p_2(X) = 1 + 2 X`. -/
theorem expPartialSumPoly_two : expPartialSumPoly 2 = 1 + 2 * X := by
  rw [expPartialSumPoly_succ, expPartialSumPoly_one]
  simp only [Nat.cast_one, mul_one, C_ofNat, derivative_one, mul_zero, add_zero]

/-- `p_3(X) = 1 + 8 X + 6 X²`. -/
theorem expPartialSumPoly_three : expPartialSumPoly 3 = 1 + 8 * X + 6 * X ^ 2 := by
  rw [expPartialSumPoly_succ, expPartialSumPoly_two]
  simp only [Nat.cast_ofNat, C_mul, C_ofNat, derivative_add, derivative_one, derivative_mul,
    derivative_ofNat, zero_mul, zero_add, derivative_X, mul_one]
  ring

/-- `p_4(X) = 1 + 22 X + 58 X² + 24 X³`. -/
theorem expPartialSumPoly_four :
    expPartialSumPoly 4 = 1 + 22 * X + 58 * X ^ 2 + 24 * X ^ 3 := by
  rw [expPartialSumPoly_succ, expPartialSumPoly_three]
  simp only [Nat.cast_ofNat, C_mul, C_ofNat, derivative_add, derivative_one, derivative_mul,
    derivative_ofNat, zero_mul, zero_add, derivative_X, derivative_X_pow, Nat.add_one_sub_one,
    pow_one, mul_one]
  ring

/-- Evaluating `p_k` at `0` gives `1` for every `k`. -/
@[simp]
theorem eval_zero_expPartialSumPoly (k : ℕ) : (expPartialSumPoly k).eval 0 = 1 := by
  induction k with
  | zero => simp
  | succ k ih => simp [expPartialSumPoly_succ, ih]

/-- Evaluating `p_k` at `1` gives the odd double factorial `(2k - 1)‼`. -/
@[simp]
theorem eval_one_expPartialSumPoly (k : ℕ) :
    (expPartialSumPoly k).eval 1 = ((2 * k - 1)‼ : ℤ) := by
  induction k with
  | zero => simp
  | succ k ih =>
    have hsub : 2 * (k + 1) - 1 = 2 * k + 1 := by omega
    rw [expPartialSumPoly_succ, hsub, Nat.doubleFactorial_add_one (2 * k)]
    simp only [eval_add, eval_sub, eval_mul, eval_one, eval_C, eval_X, sub_self, mul_zero,
      zero_mul, add_zero, mul_one, ih, Nat.cast_mul, Nat.cast_add, Nat.cast_ofNat]
    ring

/-- Over any commutative ring, `aeval 0 (p_k) = 1`. -/
@[simp]
theorem aeval_zero_expPartialSumPoly {R : Type*} [CommRing R] (k : ℕ) :
    aeval (0 : R) (expPartialSumPoly k) = 1 := by
  induction k with
  | zero => simp
  | succ k ih => simp [expPartialSumPoly_succ, ih]

/-- Over any commutative ring, `aeval 1 (p_k) = (2k - 1)‼`. -/
@[simp]
theorem aeval_one_expPartialSumPoly {R : Type*} [CommRing R] (k : ℕ) :
    aeval (1 : R) (expPartialSumPoly k) = ((2 * k - 1)‼ : R) := by
  induction k with
  | zero => simp
  | succ k ih =>
    have hsub : 2 * (k + 1) - 1 = 2 * k + 1 := by omega
    rw [expPartialSumPoly_succ, hsub, Nat.doubleFactorial_add_one (2 * k)]
    simp only [map_add, map_sub, map_mul, map_one, map_ofNat, map_natCast, aeval_X, sub_self,
      mul_zero, zero_mul, add_zero, mul_one, ih, Nat.cast_mul, Nat.cast_add, Nat.cast_ofNat]
    ring

/-- Every `p_k` has constant coefficient `1`. -/
@[simp]
theorem coeff_expPartialSumPoly_zero_right (k : ℕ) : (expPartialSumPoly k).coeff 0 = 1 := by
  rw [coeff_zero_eq_eval_zero, eval_zero_expPartialSumPoly]

/-- Combinatorial recurrence for the coefficients of `p_k`:
`[X^{j+1}] p_{k+1} = (j + 2) [X^{j+1}] p_k + (2k - j) [X^j] p_k`. -/
theorem coeff_expPartialSumPoly_succ_succ (k j : ℕ) :
    (expPartialSumPoly (k + 1)).coeff (j + 1) =
      ((j : ℤ) + 2) * (expPartialSumPoly k).coeff (j + 1) +
        (2 * (k : ℤ) - (j : ℤ)) * (expPartialSumPoly k).coeff j := by
  have hexp : expPartialSumPoly (k + 1) =
      expPartialSumPoly k + C (2 * (k : ℤ)) * (X * expPartialSumPoly k) +
        X * (expPartialSumPoly k).derivative - X ^ 2 * (expPartialSumPoly k).derivative := by
    rw [expPartialSumPoly_succ]; ring
  rw [hexp]
  cases j with
  | zero =>
    have hsq0 : (X ^ 2 * (expPartialSumPoly k).derivative).coeff 1 = 0 := by
      simp [coeff_X_pow_mul']
    simp only [coeff_sub, coeff_add, coeff_C_mul, coeff_X_mul, hsq0, sub_zero, coeff_derivative,
      Nat.cast_zero, zero_add, mul_one]
    ring
  | succ m =>
    have hsq : (X ^ 2 * (expPartialSumPoly k).derivative).coeff (m + 2) =
        (expPartialSumPoly k).derivative.coeff m := by
      simp [pow_two, mul_assoc]
    simp only [coeff_sub, coeff_add, coeff_C_mul, coeff_X_mul, hsq, coeff_derivative,
      Nat.cast_add, Nat.cast_one]
    ring

/-- Above degree `k - 1`, all positive-index coefficients of `p_k` vanish. -/
theorem coeff_expPartialSumPoly_eq_zero {k j : ℕ} (hj0 : 0 < j) (hkj : k ≤ j) :
    (expPartialSumPoly k).coeff j = 0 := by
  induction k generalizing j with
  | zero =>
    simp [coeff_one, hj0.ne']
  | succ k ih =>
    rcases Nat.exists_eq_add_one.mpr hj0 with ⟨m, rfl⟩
    rw [coeff_expPartialSumPoly_succ_succ]
    have h1 : (expPartialSumPoly k).coeff (m + 1) = 0 := ih (Nat.succ_pos m) (by omega)
    rcases eq_or_ne m 0 with rfl | hm
    · have hk0 : k = 0 := by omega
      rw [h1, hk0]
      simp
    · have h2 : (expPartialSumPoly k).coeff m = 0 := ih (Nat.pos_of_ne_zero hm) (by omega)
      simp [h1, h2]

/-- The top coefficient `[X^{k - 1}] p_k` is `k!` for every `k : ℕ` (including `k = 0`, where
`0 - 1 = 0` and `0! = 1`). -/
theorem coeff_expPartialSumPoly_pred (k : ℕ) :
    (expPartialSumPoly k).coeff (k - 1) = (k ! : ℤ) := by
  induction k with
  | zero => simp
  | succ k ih =>
    simp only [Nat.add_sub_cancel]
    rcases k with _ | m
    · simp
    · rw [coeff_expPartialSumPoly_succ_succ (m + 1) m,
        coeff_expPartialSumPoly_eq_zero (Nat.succ_pos m) le_rfl]
      simp only [Nat.add_sub_cancel] at ih
      rw [ih, Nat.factorial_succ (m + 1)]
      push_cast
      ring

/-- `p_k` has degree `k - 1` for every `k : ℕ`. -/
@[simp]
theorem natDegree_expPartialSumPoly (k : ℕ) : (expPartialSumPoly k).natDegree = k - 1 := by
  refine le_antisymm (natDegree_le_iff_coeff_eq_zero.mpr fun j hj => ?_)
    (le_natDegree_of_ne_zero ?_)
  · exact coeff_expPartialSumPoly_eq_zero (by omega) (by omega)
  · rw [coeff_expPartialSumPoly_pred]
    exact Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero k)

/-- `p_k` has leading coefficient `k!` for every `k : ℕ`. -/
@[simp]
theorem leadingCoeff_expPartialSumPoly (k : ℕ) :
    (expPartialSumPoly k).leadingCoeff = (k ! : ℤ) := by
  rw [leadingCoeff, natDegree_expPartialSumPoly, coeff_expPartialSumPoly_pred]

/-- Every coefficient of `p_k` is nonnegative. -/
theorem coeff_expPartialSumPoly_nonneg (k j : ℕ) : 0 ≤ (expPartialSumPoly k).coeff j := by
  induction k generalizing j with
  | zero =>
    rw [expPartialSumPoly_zero, coeff_one]
    split_ifs <;> omega
  | succ k ih =>
    cases j with
    | zero => simp
    | succ m =>
      rcases le_or_gt (k + 1) (m + 1) with hle | hlt
      · rw [coeff_expPartialSumPoly_eq_zero (Nat.succ_pos m) hle]
      · rw [coeff_expPartialSumPoly_succ_succ]
        have hpos1 : (0 : ℤ) ≤ (m : ℤ) + 2 := by positivity
        have hpos2 : (0 : ℤ) ≤ 2 * (k : ℤ) - (m : ℤ) := by omega
        exact add_nonneg (mul_nonneg hpos1 (ih (m + 1))) (mul_nonneg hpos2 (ih m))

/-- Every coefficient `[X^j] p_k` in the range `0 ≤ j ≤ k - 1` is strictly positive. -/
theorem coeff_expPartialSumPoly_pos {k j : ℕ} (hjk : j ≤ k - 1) :
    0 < (expPartialSumPoly k).coeff j := by
  induction k generalizing j with
  | zero =>
    obtain rfl : j = 0 := by omega
    simp
  | succ k ih =>
    cases j with
    | zero => simp
    | succ m =>
      rw [coeff_expPartialSumPoly_succ_succ]
      have hterm1 : 0 ≤ ((m : ℤ) + 2) * (expPartialSumPoly k).coeff (m + 1) :=
        mul_nonneg (by positivity) (coeff_expPartialSumPoly_nonneg k (m + 1))
      have hterm2 : 0 < (2 * (k : ℤ) - (m : ℤ)) * (expPartialSumPoly k).coeff m :=
        mul_pos (by omega) (ih (by omega))
      linarith

/-- On `[0, ∞)` in any ordered commutative ring, `1 ≤ aeval x (p_k)`. -/
theorem one_le_aeval_expPartialSumPoly {R : Type*} [CommRing R] [PartialOrder R]
    [IsOrderedRing R] (k : ℕ) {x : R} (hx : 0 ≤ x) :
    1 ≤ aeval x (expPartialSumPoly k) := by
  rw [aeval_eq_sum_range, Finset.sum_range_succ']
  simp only [coeff_expPartialSumPoly_zero_right, pow_zero, one_smul]
  refine le_add_of_nonneg_left (Finset.sum_nonneg fun i _ => ?_)
  lift (expPartialSumPoly k).coeff (i + 1) to ℕ using coeff_expPartialSumPoly_nonneg k (i + 1)
    with c
  rw [natCast_zsmul, nsmul_eq_mul]
  exact mul_nonneg (Nat.cast_nonneg c) (pow_nonneg hx (i + 1))

/-- On `[0, ∞)` in any nontrivial ordered commutative ring, `0 < aeval x (p_k)`. -/
theorem aeval_expPartialSumPoly_pos {R : Type*} [CommRing R] [PartialOrder R]
    [IsOrderedRing R] [Nontrivial R] (k : ℕ) {x : R} (hx : 0 ≤ x) :
    0 < aeval x (expPartialSumPoly k) :=
  zero_lt_one.trans_le (one_le_aeval_expPartialSumPoly k hx)

/-- Monotonicity of `aeval · (p_k)` on `[0, ∞)` in any ordered commutative ring. -/
theorem aeval_expPartialSumPoly_mono {R : Type*} [CommRing R] [PartialOrder R]
    [IsOrderedRing R] (k : ℕ) {x y : R} (hx : 0 ≤ x) (hxy : x ≤ y) :
    aeval x (expPartialSumPoly k) ≤ aeval y (expPartialSumPoly k) := by
  rw [aeval_eq_sum_range, aeval_eq_sum_range]
  refine Finset.sum_le_sum fun i _ => ?_
  lift (expPartialSumPoly k).coeff i to ℕ using coeff_expPartialSumPoly_nonneg k i with c
  rw [natCast_zsmul, natCast_zsmul, nsmul_eq_mul, nsmul_eq_mul]
  exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hx hxy i) (Nat.cast_nonneg c)

/-- Reflecting `X ↦ -X` turns `p_k` into the polynomial sequence `A_k` of DLMF 8.20.4–8.20.5:
`A_{k+1}(X) = (1 - 2k X) A_k(X) + X (X + 1) A_k'(X)`. -/
theorem comp_neg_X_expPartialSumPoly_succ (k : ℕ) :
    (expPartialSumPoly (k + 1)).comp (-X) =
      (1 - C (2 * (k : ℤ)) * X) * (expPartialSumPoly k).comp (-X) +
        X * (X + 1) * ((expPartialSumPoly k).comp (-X)).derivative := by
  rw [expPartialSumPoly_succ, derivative_comp]
  simp only [add_comp, mul_comp, sub_comp, one_comp, C_comp, X_comp, derivative_neg, derivative_X]
  ring

/-! ### Rational coefficients `expPartialSumCoeff` (DLMF 8.11.19) -/

/-- The rational coefficient functions `d_k` of DLMF 8.11.18–8.11.19 over any field:
`d_k(z) = (-1)^k z p_k(z) / (1 - z)^{2k + 1}`. At the pole `z = 1` this takes the field division
value `0`. -/
def expPartialSumCoeff {𝕜 : Type*} [Field 𝕜] (k : ℕ) (z : 𝕜) : 𝕜 :=
  (-1) ^ k * z * aeval z (expPartialSumPoly k) / (1 - z) ^ (2 * k + 1)

/-- DLMF 8.11.19 base value: `d_0(z) = z / (1 - z)`. -/
@[simp]
theorem expPartialSumCoeff_zero {𝕜 : Type*} [Field 𝕜] (z : 𝕜) :
    expPartialSumCoeff 0 z = z / (1 - z) := by
  simp [expPartialSumCoeff]

/-- Explicit form `d_1(z) = -z / (1 - z)³`. -/
theorem expPartialSumCoeff_one {𝕜 : Type*} [Field 𝕜] (z : 𝕜) :
    expPartialSumCoeff 1 z = -z / (1 - z) ^ 3 := by
  simp [expPartialSumCoeff]

/-- Explicit form `d_2(z) = (z + 2 z²) / (1 - z)⁵`. -/
theorem expPartialSumCoeff_two {𝕜 : Type*} [Field 𝕜] (z : 𝕜) :
    expPartialSumCoeff 2 z = (z + 2 * z ^ 2) / (1 - z) ^ 5 := by
  rw [expPartialSumCoeff, expPartialSumPoly_two]
  simp only [even_two, Even.neg_pow, one_pow, one_mul, map_add, map_one, map_mul, map_ofNat,
    aeval_X]
  ring

/-- Explicit form `d_3(z) = -(z + 8 z² + 6 z³) / (1 - z)⁷`. -/
theorem expPartialSumCoeff_three {𝕜 : Type*} [Field 𝕜] (z : 𝕜) :
    expPartialSumCoeff 3 z = -(z + 8 * z ^ 2 + 6 * z ^ 3) / (1 - z) ^ 7 := by
  rw [expPartialSumCoeff, expPartialSumPoly_three]
  have hpow : (-1 : 𝕜) ^ 3 = -1 := by ring
  rw [hpow]
  simp only [map_add, map_one, map_mul, map_ofNat, map_pow, aeval_X]
  ring

/-- Explicit form `d_4(z) = (z + 22 z² + 58 z³ + 24 z⁴) / (1 - z)⁹`. -/
theorem expPartialSumCoeff_four {𝕜 : Type*} [Field 𝕜] (z : 𝕜) :
    expPartialSumCoeff 4 z = (z + 22 * z ^ 2 + 58 * z ^ 3 + 24 * z ^ 4) / (1 - z) ^ 9 := by
  rw [expPartialSumCoeff, expPartialSumPoly_four]
  have hpow : (-1 : 𝕜) ^ 4 = 1 := by ring
  rw [hpow]
  simp only [one_mul, map_add, map_one, map_mul, map_ofNat, map_pow, aeval_X]
  ring

/-- Every `d_k` vanishes at `0`. -/
@[simp]
theorem expPartialSumCoeff_zero_right {𝕜 : Type*} [Field 𝕜] (k : ℕ) :
    expPartialSumCoeff k (0 : 𝕜) = 0 := by
  simp [expPartialSumCoeff]

/-- At the pole `1`, `d_k(1) = 0` by field division by zero. -/
@[simp]
theorem expPartialSumCoeff_one_right {𝕜 : Type*} [Field 𝕜] (k : ℕ) :
    expPartialSumCoeff k (1 : 𝕜) = 0 := by
  simp [expPartialSumCoeff]

/-- Compatibility of `expPartialSumCoeff` with the coercion `ℝ → ℂ`. -/
@[simp, norm_cast]
theorem ofReal_expPartialSumCoeff (k : ℕ) (x : ℝ) :
    ((expPartialSumCoeff k x : ℝ) : ℂ) = expPartialSumCoeff k (x : ℂ) := by
  rw [expPartialSumCoeff, expPartialSumCoeff]
  have haeval : ((aeval x (expPartialSumPoly k) : ℝ) : ℂ) =
      aeval (x : ℂ) (expPartialSumPoly k) := by
    rw [aeval_eq_sum_range, aeval_eq_sum_range]
    push_cast
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [zsmul_eq_mul]
  push_cast
  rw [haeval]

/-- Derivative of `d_k` away from `z = 1`:
`d_k'(z) = (-1)^k p_{k+1}(z) / (1 - z)^{2k + 2}`. -/
theorem hasDerivAt_expPartialSumCoeff {𝕜 : Type*} [NontriviallyNormedField 𝕜] (k : ℕ) {z : 𝕜}
    (hz : z ≠ 1) :
    HasDerivAt (expPartialSumCoeff k)
      ((-1) ^ k * aeval z (expPartialSumPoly (k + 1)) / (1 - z) ^ (2 * k + 2)) z := by
  have h1z : (1 - z : 𝕜) ≠ 0 := sub_ne_zero.mpr hz.symm
  have hnum : HasDerivAt (fun w : 𝕜 => (-1) ^ k * w * aeval w (expPartialSumPoly k))
      (((-1) ^ k * 1) * aeval z (expPartialSumPoly k) +
        ((-1) ^ k * z) * aeval z (expPartialSumPoly k).derivative) z :=
    ((hasDerivAt_id z).const_mul ((-1 : 𝕜) ^ k)).mul ((expPartialSumPoly k).hasDerivAt_aeval z)
  have hden := ((hasDerivAt_id z).const_sub (1 : 𝕜)).fun_pow (2 * k + 1)
  have hdiv := hnum.div hden (pow_ne_zero (2 * k + 1) h1z)
  refine hdiv.congr_deriv ?_
  rw [expPartialSumPoly_succ]
  simp only [id_eq, Nat.add_sub_cancel, map_add, map_mul, map_sub, map_one, map_ofNat, map_natCast,
    aeval_X, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one]
  field_simp [h1z]
  ring

/-- **DLMF 8.11.19**: `d_{k+1}(z) = -(z / (1 - z)) d_k'(z)` for every `z : 𝕜` (including `z = 1`,
where both sides vanish via division by zero). -/
theorem expPartialSumCoeff_succ_eq_neg_div_mul_deriv {𝕜 : Type*} [NontriviallyNormedField 𝕜]
    (k : ℕ) (z : 𝕜) :
    expPartialSumCoeff (k + 1) z = -(z / (1 - z)) * deriv (expPartialSumCoeff k) z := by
  rcases eq_or_ne z 1 with rfl | hz
  · simp
  · have h1z : (1 - z : 𝕜) ≠ 0 := sub_ne_zero.mpr hz.symm
    rw [(hasDerivAt_expPartialSumCoeff k hz).deriv, expPartialSumCoeff]
    field_simp [h1z]
    ring

/-- Uniqueness of the DLMF 8.11.19 differential recurrence: any sequence `d : ℕ → 𝕜 → 𝕜` satisfying
`d 0 z = z / (1 - z)` and `d (k + 1) z = -(z / (1 - z)) * deriv (d k) z` away from `1` coincides
with `expPartialSumCoeff` away from `1`. -/
theorem eq_expPartialSumCoeff_of_recurrence {𝕜 : Type*} [NontriviallyNormedField 𝕜]
    {d : ℕ → 𝕜 → 𝕜} (hd0 : ∀ z ≠ 1, d 0 z = z / (1 - z))
    (hd : ∀ k, ∀ z ≠ 1, d (k + 1) z = -(z / (1 - z)) * deriv (d k) z)
    (k : ℕ) {z : 𝕜} (hz : z ≠ 1) :
    d k z = expPartialSumCoeff k z := by
  induction k generalizing z with
  | zero => rw [hd0 z hz, expPartialSumCoeff_zero]
  | succ k ih =>
    have heq : d k =ᶠ[𝓝 z] expPartialSumCoeff k := by
      filter_upwards [isOpen_ne.mem_nhds hz] with w hw
      exact ih hw
    rw [hd k z hz, heq.deriv_eq, ← expPartialSumCoeff_succ_eq_neg_div_mul_deriv]

/-- On `[0, 1]`, `(-1)^k d_k(x) ≥ 0` (at `x = 1`, `d_k(1) = 0`). -/
theorem neg_one_pow_mul_expPartialSumCoeff_nonneg (k : ℕ) {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1) :
    0 ≤ (-1) ^ k * expPartialSumCoeff k x := by
  rcases eq_or_lt_of_le hx1 with rfl | hlt
  · simp
  · rw [expPartialSumCoeff]
    have hsign : (-1 : ℝ) ^ k * ((-1 : ℝ) ^ k * x * aeval x (expPartialSumPoly k) /
        (1 - x) ^ (2 * k + 1)) =
        x * aeval x (expPartialSumPoly k) / (1 - x) ^ (2 * k + 1) := by
      rw [← mul_div_assoc, ← mul_assoc, ← mul_assoc, ← pow_add, ← two_mul]
      simp
    rw [hsign]
    exact div_nonneg (mul_nonneg hx0 (aeval_expPartialSumPoly_pos k hx0).le)
      (pow_nonneg (sub_nonneg.mpr hlt.le) _)

/-- On `(0, 1)`, `(-1)^k d_k(x) > 0`. -/
theorem neg_one_pow_mul_expPartialSumCoeff_pos (k : ℕ) {x : ℝ} (hx0 : 0 < x) (hx1 : x < 1) :
    0 < (-1) ^ k * expPartialSumCoeff k x := by
  rw [expPartialSumCoeff]
  have hsign : (-1 : ℝ) ^ k * ((-1 : ℝ) ^ k * x * aeval x (expPartialSumPoly k) /
      (1 - x) ^ (2 * k + 1)) =
      x * aeval x (expPartialSumPoly k) / (1 - x) ^ (2 * k + 1) := by
    rw [← mul_div_assoc, ← mul_assoc, ← mul_assoc, ← pow_add, ← two_mul]
    simp
  rw [hsign]
  exact div_pos (mul_pos hx0 (aeval_expPartialSumPoly_pos k hx0.le))
    (pow_pos (sub_pos.mpr hx1) _)

/-- On `[0, 1)`, `(-1)^k d_k` is monotone increasing. -/
theorem neg_one_pow_mul_expPartialSumCoeff_mono (k : ℕ) {x y : ℝ} (hx0 : 0 ≤ x) (hxy : x ≤ y)
    (hy1 : y < 1) :
    (-1) ^ k * expPartialSumCoeff k x ≤ (-1) ^ k * expPartialSumCoeff k y := by
  have hsign (t : ℝ) : (-1 : ℝ) ^ k * expPartialSumCoeff k t =
      t * aeval t (expPartialSumPoly k) / (1 - t) ^ (2 * k + 1) := by
    rw [expPartialSumCoeff, ← mul_div_assoc, ← mul_assoc, ← mul_assoc, ← pow_add, ← two_mul]
    simp
  rw [hsign x, hsign y]
  have hy0 : 0 ≤ y := hx0.trans hxy
  have hnum : x * aeval x (expPartialSumPoly k) ≤ y * aeval y (expPartialSumPoly k) :=
    mul_le_mul hxy (aeval_expPartialSumPoly_mono k hx0 hxy)
      (aeval_expPartialSumPoly_pos k hx0).le hy0
  have hden_pos : 0 < (1 - y) ^ (2 * k + 1) := pow_pos (sub_pos.mpr hy1) _
  have hden_le : (1 - y) ^ (2 * k + 1) ≤ (1 - x) ^ (2 * k + 1) :=
    pow_le_pow_left₀ (sub_pos.mpr hy1).le (by linarith) _
  exact div_le_div₀ (mul_nonneg hy0 (aeval_expPartialSumPoly_pos k hy0).le) hnum hden_pos hden_le

private theorem norm_z_mul_aeval_expPartialSumPoly_le (k : ℕ) (w : ℂ) :
    ‖w * aeval w (expPartialSumPoly k)‖ ≤
      ∑ i ∈ Finset.range ((expPartialSumPoly k).natDegree + 1),
        ((expPartialSumPoly k).coeff i : ℝ) * ‖w‖ ^ (i + 1) := by
  rw [norm_mul, aeval_eq_sum_range]
  calc
    ‖w‖ * ‖∑ i ∈ Finset.range ((expPartialSumPoly k).natDegree + 1),
        (expPartialSumPoly k).coeff i • w ^ i‖
      ≤ ‖w‖ * ∑ i ∈ Finset.range ((expPartialSumPoly k).natDegree + 1),
          ‖(expPartialSumPoly k).coeff i • w ^ i‖ :=
        mul_le_mul_of_nonneg_left (norm_sum_le _ _) (norm_nonneg w)
    _ = ∑ i ∈ Finset.range ((expPartialSumPoly k).natDegree + 1),
          ((expPartialSumPoly k).coeff i : ℝ) * ‖w‖ ^ (i + 1) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        have hc : 0 ≤ (expPartialSumPoly k).coeff i := coeff_expPartialSumPoly_nonneg k i
        rw [zsmul_eq_mul, norm_mul, norm_pow, Complex.norm_intCast,
          abs_of_nonneg (by exact_mod_cast hc), pow_succ]
        ring

private theorem sum_coeff_expPartialSumPoly_eq_doubleFactorial (k : ℕ) :
    ∑ i ∈ Finset.range ((expPartialSumPoly k).natDegree + 1),
      ((expPartialSumPoly k).coeff i : ℝ) = ((2 * k - 1)‼ : ℝ) := by
  have h := aeval_one_expPartialSumPoly (R := ℝ) k
  rw [aeval_eq_sum_range] at h
  simpa [zsmul_eq_mul] using h

/-- Uniform norm bound on `d_k(w)` in the closed left half-plane wedge
`Re w ≤ 0 ∧ |Im w| ≤ M * (1 - Re w)`. -/
theorem norm_expPartialSumCoeff_le_of_re_nonpos (k : ℕ) {M : ℝ} {w : ℂ} (hw_re : w.re ≤ 0)
    (hw_im : |w.im| ≤ M * (1 - w.re)) :
    ‖expPartialSumCoeff k w‖ ≤ ((2 * k - 1)‼ : ℝ) * (1 + M) ^ (2 * k + 1) := by
  have : 1 ≤ 1 - w.re := by linarith
  have hM : 0 ≤ M := by
    have : 0 ≤ M * (1 - w.re) := (abs_nonneg w.im).trans hw_im
    nlinarith
  have hnorm1 : 1 - w.re ≤ ‖1 - w‖ := by
    have : (1 - w).re = 1 - w.re := by simp
    linarith [this ▸ Complex.re_le_norm (1 - w)]
  have hnormw : ‖w‖ ≤ (1 + M) * ‖1 - w‖ := by
    calc
      ‖w‖ ≤ |w.re| + |w.im| := Complex.norm_le_abs_re_add_abs_im w
      _ ≤ (1 - w.re) + M * (1 - w.re) := by rw [abs_of_nonpos hw_re]; linarith
      _ = (1 + M) * (1 - w.re) := by ring
      _ ≤ (1 + M) * ‖1 - w‖ := mul_le_mul_of_nonneg_left hnorm1 (by linarith)
  have hden_pos : 0 < ‖1 - w‖ ^ (2 * k + 1) := pow_pos (by linarith) _
  rw [expPartialSumCoeff, norm_div, mul_assoc, norm_mul, norm_pow, norm_pow, norm_neg, norm_one,
    one_pow, one_mul, div_le_iff₀ hden_pos]
  calc
    ‖w * aeval w (expPartialSumPoly k)‖
      ≤ ∑ i ∈ Finset.range ((expPartialSumPoly k).natDegree + 1),
          ((expPartialSumPoly k).coeff i : ℝ) * ‖w‖ ^ (i + 1) :=
        norm_z_mul_aeval_expPartialSumPoly_le k w
    _ ≤ ∑ i ∈ Finset.range ((expPartialSumPoly k).natDegree + 1),
          ((expPartialSumPoly k).coeff i : ℝ) *
            ((1 + M) ^ (2 * k + 1) * ‖1 - w‖ ^ (2 * k + 1)) := by
        refine Finset.sum_le_sum fun i hi => mul_le_mul_of_nonneg_left ?_
          (by exact_mod_cast coeff_expPartialSumPoly_nonneg k i)
        rw [Finset.mem_range, natDegree_expPartialSumPoly] at hi
        calc
          ‖w‖ ^ (i + 1) ≤ ((1 + M) * ‖1 - w‖) ^ (i + 1) :=
            pow_le_pow_left₀ (norm_nonneg w) hnormw _
          _ ≤ ((1 + M) * ‖1 - w‖) ^ (2 * k + 1) :=
            pow_le_pow_right₀ (by nlinarith) (by omega)
          _ = (1 + M) ^ (2 * k + 1) * ‖1 - w‖ ^ (2 * k + 1) := mul_pow _ _ _
    _ = ((2 * k - 1)‼ : ℝ) * (1 + M) ^ (2 * k + 1) * ‖1 - w‖ ^ (2 * k + 1) := by
        rw [← Finset.sum_mul, sum_coeff_expPartialSumPoly_eq_doubleFactorial, mul_assoc]

/-- Uniform norm bound on `d_k(w)` across the complex wedge
`{w : ℂ | Re w ≤ 1 - δ ∧ |Im w| ≤ M * (1 - Re w)}` (`δ > 0`). -/
theorem norm_expPartialSumCoeff_le_of_re_le (k : ℕ) {δ M : ℝ} (hδ : 0 < δ) {w : ℂ}
    (hw_re : w.re ≤ 1 - δ) (hw_im : |w.im| ≤ M * (1 - w.re)) :
    ‖expPartialSumCoeff k w‖ ≤
      ((2 * k - 1)‼ : ℝ) * (1 + M) ^ (2 * k + 1) * max 1 ((δ ^ (2 * k + 1))⁻¹) := by
  rcases le_or_gt w.re 0 with hre0 | hre0
  · refine (norm_expPartialSumCoeff_le_of_re_nonpos k hre0 hw_im).trans
      (le_mul_of_one_le_right ?_ (le_max_left 1 _))
    have hM : 0 ≤ M := by
      have : 0 ≤ M * (1 - w.re) := (abs_nonneg w.im).trans hw_im
      have : 1 ≤ 1 - w.re := by linarith
      nlinarith
    positivity
  · have : δ ≤ 1 - w.re := by linarith
    have hM : 0 ≤ M := by
      have : 0 ≤ M * (1 - w.re) := (abs_nonneg w.im).trans hw_im
      nlinarith
    have hnorm1 : δ ≤ ‖1 - w‖ := by
      have : (1 - w).re = 1 - w.re := by simp
      linarith [this ▸ Complex.re_le_norm (1 - w)]
    have hnormw : ‖w‖ ≤ 1 + M := by
      calc
        ‖w‖ ≤ |w.re| + |w.im| := Complex.norm_le_abs_re_add_abs_im w
        _ ≤ w.re + M * (1 - w.re) := by rw [abs_of_pos hre0]; linarith
        _ ≤ 1 + M * 1 := by nlinarith
        _ = 1 + M := by ring
    rw [expPartialSumCoeff, norm_div, mul_assoc, norm_mul, norm_pow, norm_pow, norm_neg, norm_one,
      one_pow, one_mul]
    calc
      ‖w * aeval w (expPartialSumPoly k)‖ / ‖1 - w‖ ^ (2 * k + 1)
        ≤ (∑ i ∈ Finset.range ((expPartialSumPoly k).natDegree + 1),
            ((expPartialSumPoly k).coeff i : ℝ) * (1 + M) ^ (2 * k + 1)) /
            δ ^ (2 * k + 1) := by
          refine div_le_div₀ (Finset.sum_nonneg fun i _ => mul_nonneg
            (by exact_mod_cast coeff_expPartialSumPoly_nonneg k i) (by positivity)) ?_
            (pow_pos hδ _) (pow_le_pow_left₀ hδ.le hnorm1 _)
          refine (norm_z_mul_aeval_expPartialSumPoly_le k w).trans (Finset.sum_le_sum fun i hi =>
            mul_le_mul_of_nonneg_left ?_ (by exact_mod_cast coeff_expPartialSumPoly_nonneg k i))
          rw [Finset.mem_range, natDegree_expPartialSumPoly] at hi
          exact (pow_le_pow_left₀ (norm_nonneg w) hnormw _).trans
            (pow_le_pow_right₀ (by linarith) (by omega))
      _ = ((2 * k - 1)‼ : ℝ) * (1 + M) ^ (2 * k + 1) * (δ ^ (2 * k + 1))⁻¹ := by
          rw [← Finset.sum_mul, sum_coeff_expPartialSumPoly_eq_doubleFactorial, div_eq_mul_inv]
      _ ≤ ((2 * k - 1)‼ : ℝ) * (1 + M) ^ (2 * k + 1) * max 1 ((δ ^ (2 * k + 1))⁻¹) :=
          mul_le_mul_of_nonneg_left (le_max_right 1 _) (by positivity)

/-- On `(-∞, 0]`, `|d_k(x)| ≤ (2k - 1)‼`. -/
theorem abs_expPartialSumCoeff_le_of_nonpos (k : ℕ) {x : ℝ} (hx : x ≤ 0) :
    |expPartialSumCoeff k x| ≤ ((2 * k - 1)‼ : ℝ) := by
  have h := norm_expPartialSumCoeff_le_of_re_nonpos k (M := 0) (w := (x : ℂ))
    (by simpa using hx) (by simp)
  rw [← ofReal_expPartialSumCoeff, Complex.norm_real, Real.norm_eq_abs] at h
  simpa using h

/-- Uniform bound on `|d_k(x)|` across the entire real half-line `x ≤ 1 - δ` (`δ > 0`). -/
theorem abs_expPartialSumCoeff_le (k : ℕ) {δ x : ℝ} (hδ : 0 < δ) (hx : x ≤ 1 - δ) :
    |expPartialSumCoeff k x| ≤ ((2 * k - 1)‼ : ℝ) * max 1 ((δ ^ (2 * k + 1))⁻¹) := by
  have h := norm_expPartialSumCoeff_le_of_re_le k (M := 0) hδ (w := (x : ℂ))
    (by simpa using hx) (by simp)
  rw [← ofReal_expPartialSumCoeff, Complex.norm_real, Real.norm_eq_abs] at h
  simpa using h

end TauCeti

/-! ### Exact Taylor remainder and `m`-fold integration-by-parts identities -/

namespace Complex

open TauCeti

private theorem integral_one_sub_pow_mul_cexp_step (n : ℕ) (z : ℂ) :
    ∫ s in (0 : ℝ)..1, (1 - (s : ℂ)) ^ n * cexp (z * s) =
      1 / ((n : ℂ) + 1) +
        z / ((n : ℂ) + 1) * ∫ s in (0 : ℝ)..1, (1 - (s : ℂ)) ^ (n + 1) * cexp (z * s) := by
  let u : ℝ → ℂ := fun s => -((1 - (s : ℂ)) ^ (n + 1)) / ((n : ℂ) + 1)
  let u' : ℝ → ℂ := fun s => (1 - (s : ℂ)) ^ n
  let v : ℝ → ℂ := fun s => cexp (z * s)
  let v' : ℝ → ℂ := fun s => z * cexp (z * s)
  have hn1 : ((n : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
  have hu : ∀ s, HasDerivAt u (u' s) s := fun s => by
    have h1 : HasDerivAt (fun t : ℝ => 1 - (t : ℂ)) (-1) s := by
      simpa using (Complex.ofRealCLM.hasDerivAt (x := s)).const_sub 1
    refine ((h1.fun_pow (n + 1)).neg.div_const ((n : ℂ) + 1)).congr_deriv ?_
    dsimp only [u']
    simp only [Nat.add_sub_cancel]
    push_cast
    field_simp [hn1]
  have hv : ∀ s, HasDerivAt v (v' s) s := fun s => by
    have h1 : HasDerivAt (fun t : ℝ => z * (t : ℂ)) z s := by
      simpa using (Complex.ofRealCLM.hasDerivAt (x := s)).const_mul z
    simpa [v, v', mul_comm] using h1.cexp
  have hibp := intervalIntegral.integral_mul_deriv_eq_deriv_mul_of_hasDerivAt
    (a := (0 : ℝ)) (b := 1)
    (fun s _ => (hu s).continuousAt.continuousWithinAt)
    (fun s _ => (hv s).continuousAt.continuousWithinAt)
    (fun s _ => hu s) (fun s _ => hv s)
    (by dsimp only [u']; exact (by fun_prop : Continuous _).continuousOn.intervalIntegrable)
    (by dsimp only [v']; exact (by fun_prop : Continuous _).continuousOn.intervalIntegrable)
  have hrew : ∫ s in (0 : ℝ)..1, u s * v' s =
      -(z / ((n : ℂ) + 1)) * ∫ s in (0 : ℝ)..1, (1 - (s : ℂ)) ^ (n + 1) * cexp (z * s) := by
    rw [← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr fun s _ => ?_
    dsimp only [u, v']
    ring
  have hbnd : u 1 * v 1 - u 0 * v 0 = 1 / ((n : ℂ) + 1) := by
    dsimp only [u, v]
    simp [zero_pow (Nat.succ_ne_zero n), neg_div]
  dsimp only [u', v] at hibp
  rw [hrew, hbnd] at hibp
  linear_combination hibp

/-- Exact integral remainder for the partial sums of `Complex.exp` at any order `n` and `z ∈ ℂ`:
`e^z - ∑_{k ≤ n} z^k / k! = z^{n + 1} / n! * ∫₀¹ (1 - s)^n e^{z s} ds`. -/
theorem exp_sub_sum_range_succ_eq_integral (n : ℕ) (z : ℂ) :
    exp z - ∑ k ∈ Finset.range (n + 1), z ^ k / (k ! : ℂ) =
      z ^ (n + 1) / (n ! : ℂ) * ∫ s in (0 : ℝ)..1, (1 - (s : ℂ)) ^ n * exp (z * s) := by
  induction n with
  | zero =>
    rw [Nat.zero_add, Finset.sum_range_one]
    simp only [pow_zero, pow_one, Nat.factorial_zero, Nat.cast_one, div_one, one_mul]
    rcases eq_or_ne z 0 with rfl | hz
    · simp
    · have hderiv : ∀ s ∈ uIcc (0 : ℝ) 1,
          HasDerivAt (fun t : ℝ => cexp (z * t) / z) (cexp (z * s)) s := fun s _ => by
        have h1 : HasDerivAt (fun t : ℝ => z * (t : ℂ)) z s := by
          simpa using (Complex.ofRealCLM.hasDerivAt (x := s)).const_mul z
        simpa [mul_div_cancel_right₀ _ hz] using h1.cexp.div_const z
      have hint : IntervalIntegrable (fun s : ℝ => cexp (z * s)) volume 0 1 :=
        (Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)).continuousOn
          |>.intervalIntegrable
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
      simp only [ofReal_one, mul_one, ofReal_zero, mul_zero, exp_zero]
      field_simp [hz]
  | succ n ih =>
    have hn1 : ((n : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
    have hnfac : (n ! : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
    rw [Finset.sum_range_succ, ← sub_sub, ih, integral_one_sub_pow_mul_cexp_step,
      Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
    field_simp [hn1, hnfac]
    ring

private def expKernel (n : ℕ) (w : ℂ) (s : ℝ) : ℂ :=
  (n : ℂ) * (1 - w * (1 - (s : ℂ))) * (1 - (s : ℂ)) ^ (n - 1) * cexp ((n : ℂ) * w * s)

private theorem one_sub_mul_one_sub_re_pos {w : ℂ} (hw : w.re < 1) {s : ℝ} (hs0 : 0 ≤ s)
    (hs1 : s ≤ 1) :
    0 < (1 - w * (1 - (s : ℂ))).re := by
  have hre : (1 - w * (1 - (s : ℂ))).re = 1 - w.re * (1 - s) := by simp
  rw [hre]
  rcases le_or_gt w.re 0 with _ | _ <;> nlinarith

private theorem mul_one_sub_ne_one {w : ℂ} (hw : w.re < 1) {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    w * (1 - (s : ℂ)) ≠ 1 := by
  intro h
  have hpos := one_sub_mul_one_sub_re_pos hw hs0 hs1
  rw [h, sub_self, zero_re] at hpos
  exact lt_irrefl 0 hpos

private theorem hasDerivAt_neg_one_sub_pow_mul_cexp {n : ℕ} (hn : n ≠ 0) (w : ℂ) (s : ℝ) :
    HasDerivAt (fun t : ℝ => -((1 - (t : ℂ)) ^ n * cexp ((n : ℂ) * w * t)))
      (expKernel n w s) s := by
  rcases Nat.exists_eq_add_one.mpr (Nat.pos_of_ne_zero hn) with ⟨m, rfl⟩
  have h1a : HasDerivAt (fun t : ℝ => 1 - (t : ℂ)) (-1) s := by
    simpa using (Complex.ofRealCLM.hasDerivAt (x := s)).const_sub 1
  have h1 := h1a.fun_pow (m + 1)
  have h2 : HasDerivAt (fun t : ℝ => cexp (((m + 1 : ℕ) : ℂ) * w * t))
      (cexp (((m + 1 : ℕ) : ℂ) * w * s) * (((m + 1 : ℕ) : ℂ) * w)) s := by
    have hlin : HasDerivAt (fun t : ℝ => ((m + 1 : ℕ) : ℂ) * w * (t : ℂ))
        (((m + 1 : ℕ) : ℂ) * w) s := by
      simpa using (Complex.ofRealCLM.hasDerivAt (x := s)).const_mul (((m + 1 : ℕ) : ℂ) * w)
    exact hlin.cexp
  refine (h1.mul h2).neg.congr_deriv ?_
  dsimp only [expKernel]
  simp only [Nat.add_sub_cancel, pow_succ]
  push_cast
  ring

private theorem continuous_expKernel (n : ℕ) (w : ℂ) : Continuous (expKernel n w) := by
  unfold expKernel
  fun_prop

private theorem integral_expKernel {n : ℕ} (hn : n ≠ 0) (w : ℂ) :
    ∫ s in (0 : ℝ)..1, expKernel n w s = 1 := by
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun s _ => hasDerivAt_neg_one_sub_pow_mul_cexp hn w s)
    (continuous_expKernel n w).continuousOn.intervalIntegrable]
  simp [zero_pow hn]

private theorem integral_expPartialSumCoeff_mul_expKernel_zero {n : ℕ} (hn : n ≠ 0) {w : ℂ}
    (hw : w.re < 1) :
    ∫ s in (0 : ℝ)..1, expPartialSumCoeff 0 (w * (1 - (s : ℂ))) * expKernel n w s =
      ∫ s in (0 : ℝ)..1, (n : ℂ) * w * (1 - (s : ℂ)) ^ n * cexp ((n : ℂ) * w * s) := by
  refine intervalIntegral.integral_congr fun s hs => ?_
  rw [Set.uIcc_of_le zero_le_one] at hs
  have hne : 1 - w * (1 - (s : ℂ)) ≠ 0 :=
    sub_ne_zero.mpr (mul_one_sub_ne_one hw hs.1 hs.2).symm
  rcases Nat.exists_eq_add_one.mpr (Nat.pos_of_ne_zero hn) with ⟨m, rfl⟩
  rw [expPartialSumCoeff_zero]
  dsimp only [expKernel]
  simp only [Nat.add_sub_cancel, pow_succ]
  push_cast
  field_simp [hne]

private theorem continuousOn_deriv_expPartialSumCoeff_mul_one_sub {w : ℂ} (hw : w.re < 1)
    (k : ℕ) :
    ContinuousOn (fun s : ℝ =>
      ((-1 : ℂ) ^ k * aeval (w * (1 - (s : ℂ))) (expPartialSumPoly (k + 1)) /
        (1 - w * (1 - (s : ℂ))) ^ (2 * k + 2)) * (-w)) (uIcc 0 1) := by
  rw [Set.uIcc_of_le zero_le_one]
  have hpoly : Continuous fun s : ℝ =>
      (-1 : ℂ) ^ k * aeval (w * (1 - (s : ℂ))) (expPartialSumPoly (k + 1)) := by
    have : Continuous fun z : ℂ => aeval z (expPartialSumPoly (k + 1)) := by
      simp_rw [aeval_eq_sum_range, zsmul_eq_mul]; fun_prop
    exact continuous_const.mul (this.comp (continuous_const.mul
      (continuous_const.sub Complex.continuous_ofReal)))
  refine (hpoly.continuousOn.div ?_ fun s (hs : s ∈ Icc (0 : ℝ) 1) =>
    pow_ne_zero _ (sub_ne_zero.mpr (mul_one_sub_ne_one hw hs.1 hs.2).symm)).mul continuousOn_const
  exact (continuous_const.sub (continuous_const.mul
    (continuous_const.sub Complex.continuous_ofReal))).pow (2 * k + 2) |>.continuousOn

private theorem integral_deriv_expPartialSumCoeff_mul_neg_pow_cexp {n : ℕ} (hn : n ≠ 0)
    {w : ℂ} (hw : w.re < 1) (k : ℕ) :
    ∫ s in (0 : ℝ)..1,
      (((-1 : ℂ) ^ k * aeval (w * (1 - (s : ℂ))) (expPartialSumPoly (k + 1)) /
          (1 - w * (1 - (s : ℂ))) ^ (2 * k + 2)) * (-w)) *
        -((1 - (s : ℂ)) ^ n * cexp ((n : ℂ) * w * s)) =
      -((n : ℂ))⁻¹ * ∫ s in (0 : ℝ)..1,
        expPartialSumCoeff (k + 1) (w * (1 - (s : ℂ))) * expKernel n w s := by
  let g : ℝ → ℂ := fun s => w * (1 - (s : ℂ))
  rw [← intervalIntegral.integral_const_mul]
  refine intervalIntegral.integral_congr fun s hs => ?_
  rw [Set.uIcc_of_le zero_le_one] at hs
  have h1g : 1 - g s ≠ 0 := sub_ne_zero.mpr (mul_one_sub_ne_one hw hs.1 hs.2).symm
  rcases Nat.exists_eq_add_one.mpr (Nat.pos_of_ne_zero hn) with ⟨m, rfl⟩
  have hnc : ((m : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero m
  dsimp only [expKernel]
  rw [show w * (1 - (s : ℂ)) = g s from rfl, expPartialSumCoeff,
    show 2 * (k + 1) + 1 = (2 * k + 2) + 1 by omega]
  simp only [Nat.add_sub_cancel, pow_succ]
  push_cast
  field_simp [h1g, hnc]
  dsimp only [g]
  ring

private theorem integral_expPartialSumCoeff_mul_expKernel_succ {n : ℕ} (hn : n ≠ 0) {w : ℂ}
    (hw : w.re < 1) (k : ℕ) :
    ∫ s in (0 : ℝ)..1, expPartialSumCoeff k (w * (1 - (s : ℂ))) * expKernel n w s =
      expPartialSumCoeff k w + ((n : ℂ))⁻¹ *
        ∫ s in (0 : ℝ)..1, expPartialSumCoeff (k + 1) (w * (1 - (s : ℂ))) * expKernel n w s := by
  let g : ℝ → ℂ := fun s => w * (1 - (s : ℂ))
  let u : ℝ → ℂ := fun s => expPartialSumCoeff k (g s)
  let u' : ℝ → ℂ := fun s =>
    ((-1) ^ k * aeval (g s) (expPartialSumPoly (k + 1)) / (1 - g s) ^ (2 * k + 2)) * (-w)
  let v : ℝ → ℂ := fun s => -((1 - (s : ℂ)) ^ n * cexp ((n : ℂ) * w * s))
  have hg_ne : ∀ s ∈ Icc (0 : ℝ) 1, g s ≠ 1 := fun s hs => mul_one_sub_ne_one hw hs.1 hs.2
  have hu : ∀ s ∈ Icc (0 : ℝ) 1, HasDerivAt u (u' s) s := fun s hs => by
    have hg : HasDerivAt g (-w) s := by
      simpa [g] using ((Complex.ofRealCLM.hasDerivAt (x := s)).const_sub 1).const_mul w
    exact (hasDerivAt_expPartialSumCoeff k (hg_ne s hs)).comp s hg
  have hv : ∀ s, HasDerivAt v (expKernel n w s) s := hasDerivAt_neg_one_sub_pow_mul_cexp hn w
  have hu'_cont : ContinuousOn u' (uIcc 0 1) :=
    continuousOn_deriv_expPartialSumCoeff_mul_one_sub hw k
  have hu_cont : ContinuousOn u (uIcc 0 1) := by
    rw [Set.uIcc_of_le zero_le_one]
    exact fun s hs => (hu s hs).continuousAt.continuousWithinAt
  have hv_cont : ContinuousOn v (uIcc 0 1) := fun s _ => (hv s).continuousAt.continuousWithinAt
  have hint1 : IntervalIntegrable (fun s => u' s * v s) volume 0 1 :=
    (hu'_cont.mul hv_cont).intervalIntegrable
  have hint2 : IntervalIntegrable (fun s => u s * expKernel n w s) volume 0 1 :=
    (hu_cont.mul (continuous_expKernel n w).continuousOn).intervalIntegrable
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := (0 : ℝ)) (b := 1)
    (f := fun s => u s * v s) (f' := fun s => u' s * v s + u s * expKernel n w s)
    (fun s hs => by
      rw [Set.uIcc_of_le zero_le_one] at hs
      exact (hu s hs).mul (hv s))
    (hint1.add hint2)
  rw [intervalIntegral.integral_add hint1 hint2] at hftc
  have hbnd : u 1 * v 1 - u 0 * v 0 = expPartialSumCoeff k w := by
    dsimp only [u, v, g]; simp [zero_pow hn]
  have hterm : ∫ s in (0 : ℝ)..1, u' s * v s =
      -((n : ℂ))⁻¹ *
        ∫ s in (0 : ℝ)..1, expPartialSumCoeff (k + 1) (g s) * expKernel n w s :=
    integral_deriv_expPartialSumCoeff_mul_neg_pow_cexp hn hw k
  rw [hbnd, hterm] at hftc
  linear_combination hftc

/-- Exact `m`-fold integration-by-parts expansion of `∫₀¹ n w (1 - s)^n e^{n w s} ds` on the open
half-plane `Re w < 1`. -/
theorem integral_mul_one_sub_pow_mul_exp_eq_sum_add_integral {n : ℕ} (hn : n ≠ 0) {w : ℂ}
    (hw : w.re < 1) (m : ℕ) :
    ∫ s in (0 : ℝ)..1, (n : ℂ) * w * (1 - (s : ℂ)) ^ n * exp ((n : ℂ) * w * s) =
      ∑ k ∈ Finset.range m, expPartialSumCoeff k w / (n : ℂ) ^ k +
        ((n : ℂ) ^ m)⁻¹ * ∫ s in (0 : ℝ)..1, expPartialSumCoeff m (w * (1 - (s : ℂ))) *
          ((n : ℂ) * (1 - w * (1 - (s : ℂ))) * (1 - (s : ℂ)) ^ (n - 1) *
            exp ((n : ℂ) * w * s)) := by
  have hind : ∀ l : ℕ,
      ∫ s in (0 : ℝ)..1, expPartialSumCoeff 0 (w * (1 - (s : ℂ))) * expKernel n w s =
        ∑ k ∈ Finset.range l, expPartialSumCoeff k w / (n : ℂ) ^ k +
          ((n : ℂ) ^ l)⁻¹ *
            ∫ s in (0 : ℝ)..1, expPartialSumCoeff l (w * (1 - (s : ℂ))) * expKernel n w s := by
    intro l
    induction l with
    | zero => simp
    | succ l ih =>
      rw [ih, integral_expPartialSumCoeff_mul_expKernel_succ hn hw l, Finset.sum_range_succ,
        pow_succ, mul_inv]
      ring
  rw [← integral_expPartialSumCoeff_mul_expKernel_zero hn hw, hind m]
  rfl

/-- Exact `m`-term expansion with integral remainder for `e^{n w} - ∑_{k ≤ n} (n w)^k / k!` on the
open half-plane `Re w < 1`. -/
theorem exp_mul_sub_sum_range_succ_eq_sum_add_integral {n : ℕ} (hn : n ≠ 0) {w : ℂ}
    (hw : w.re < 1) (m : ℕ) :
    exp ((n : ℂ) * w) - ∑ k ∈ Finset.range (n + 1), ((n : ℂ) * w) ^ k / (k ! : ℂ) =
      (((n : ℂ) * w) ^ n / (n ! : ℂ)) *
        (∑ k ∈ Finset.range m, expPartialSumCoeff k w / (n : ℂ) ^ k +
          ((n : ℂ) ^ m)⁻¹ * ∫ s in (0 : ℝ)..1, expPartialSumCoeff m (w * (1 - (s : ℂ))) *
            ((n : ℂ) * (1 - w * (1 - (s : ℂ))) * (1 - (s : ℂ)) ^ (n - 1) *
              exp ((n : ℂ) * w * s))) := by
  rw [exp_sub_sum_range_succ_eq_integral n ((n : ℂ) * w),
    ← integral_mul_one_sub_pow_mul_exp_eq_sum_add_integral hn hw m]
  have hpull : (((n : ℂ) * w) ^ (n + 1) / (n ! : ℂ)) *
      ∫ s in (0 : ℝ)..1, (1 - (s : ℂ)) ^ n * exp ((n : ℂ) * w * s) =
      (((n : ℂ) * w) ^ n / (n ! : ℂ)) *
        ∫ s in (0 : ℝ)..1, (n : ℂ) * w * (1 - (s : ℂ)) ^ n * exp ((n : ℂ) * w * s) := by
    rw [pow_succ, mul_div_right_comm, mul_assoc, ← intervalIntegral.integral_const_mul]
    congr 1
    exact intervalIntegral.integral_congr fun s _ => by ring
  exact hpull

end Complex

namespace Real

/-- Exact integral remainder for the partial sums of `Real.exp` at any order `n` and `x ∈ ℝ`:
`e^x - ∑_{k ≤ n} x^k / k! = x^{n + 1} / n! * ∫₀¹ (1 - s)^n e^{x s} ds`. -/
theorem exp_sub_sum_range_succ_eq_integral (n : ℕ) (x : ℝ) :
    Real.exp x - ∑ k ∈ Finset.range (n + 1), x ^ k / (k ! : ℝ) =
      x ^ (n + 1) / (n ! : ℝ) * ∫ s in (0 : ℝ)..1, (1 - s) ^ n * Real.exp (x * s) := by
  have h := Complex.exp_sub_sum_range_succ_eq_integral n (x : ℂ)
  have hint : (∫ s in (0 : ℝ)..1, (1 - (s : ℂ)) ^ n * Complex.exp ((x : ℂ) * s)) =
      ((∫ s in (0 : ℝ)..1, (1 - s) ^ n * Real.exp (x * s) : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun s _ => ?_
    push_cast
    rfl
  rw [hint] at h
  exact Complex.ofReal_inj.mp (by push_cast; simpa using h)

end Real

namespace TauCeti

/-! ### Uniform remainder bounds, enveloping inequalities, and DLMF 8.11.18 -/

/-- Exact `m`-fold integration-by-parts expansion of `∫₀¹ n x (1 - s)^n e^{n x s} ds` for real
`x < 1`. -/
theorem integral_mul_one_sub_pow_mul_exp_eq_sum_add_integral {n : ℕ} (hn : n ≠ 0) {x : ℝ}
    (hx : x < 1) (m : ℕ) :
    ∫ s in (0 : ℝ)..1, (n : ℝ) * x * (1 - s) ^ n * Real.exp ((n : ℝ) * x * s) =
      ∑ k ∈ Finset.range m, expPartialSumCoeff k x / (n : ℝ) ^ k +
        ((n : ℝ) ^ m)⁻¹ * ∫ s in (0 : ℝ)..1, expPartialSumCoeff m (x * (1 - s)) *
          ((n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) *
            Real.exp ((n : ℝ) * x * s)) := by
  have h := Complex.integral_mul_one_sub_pow_mul_exp_eq_sum_add_integral hn
    (w := (x : ℂ)) (by simpa using hx) m
  have hintL : (∫ s in (0 : ℝ)..1,
      (n : ℂ) * (x : ℂ) * (1 - (s : ℂ)) ^ n * Complex.exp ((n : ℂ) * (x : ℂ) * s)) =
      ((∫ s in (0 : ℝ)..1, (n : ℝ) * x * (1 - s) ^ n * Real.exp ((n : ℝ) * x * s) : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun s _ => ?_
    push_cast; rfl
  have hintR : (∫ s in (0 : ℝ)..1, expPartialSumCoeff m ((x : ℂ) * (1 - (s : ℂ))) *
      ((n : ℂ) * (1 - (x : ℂ) * (1 - (s : ℂ))) * (1 - (s : ℂ)) ^ (n - 1) *
        Complex.exp ((n : ℂ) * (x : ℂ) * s))) =
      ((∫ s in (0 : ℝ)..1, expPartialSumCoeff m (x * (1 - s)) *
        ((n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) *
          Real.exp ((n : ℝ) * x * s)) : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun s _ => ?_
    push_cast; rfl
  rw [hintL, hintR] at h
  exact Complex.ofReal_inj.mp (by push_cast; simpa using h)

/-- Exact `m`-term expansion with integral remainder for `e^{n x} - ∑_{k ≤ n} (n x)^k / k!` for
real `x < 1`. -/
theorem exp_mul_sub_sum_range_succ_eq_sum_add_integral {n : ℕ} (hn : n ≠ 0) {x : ℝ} (hx : x < 1)
    (m : ℕ) :
    Real.exp ((n : ℝ) * x) - ∑ k ∈ Finset.range (n + 1), ((n : ℝ) * x) ^ k / (k ! : ℝ) =
      (((n : ℝ) * x) ^ n / (n ! : ℝ)) *
        (∑ k ∈ Finset.range m, expPartialSumCoeff k x / (n : ℝ) ^ k +
          ((n : ℝ) ^ m)⁻¹ * ∫ s in (0 : ℝ)..1, expPartialSumCoeff m (x * (1 - s)) *
            ((n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) *
              Real.exp ((n : ℝ) * x * s))) := by
  rw [Real.exp_sub_sum_range_succ_eq_integral n ((n : ℝ) * x),
    ← integral_mul_one_sub_pow_mul_exp_eq_sum_add_integral hn hx m]
  rw [pow_succ, mul_div_right_comm, mul_assoc, ← intervalIntegral.integral_const_mul]
  congr 1
  exact intervalIntegral.integral_congr fun s _ => by ring

private theorem integral_real_expKernel {n : ℕ} (hn : n ≠ 0) (x : ℝ) :
    ∫ s in (0 : ℝ)..1,
      (n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * x * s) = 1 := by
  have h := Complex.integral_expKernel hn (x : ℂ)
  have hint : (∫ s in (0 : ℝ)..1, Complex.expKernel n (x : ℂ) s) =
      ((∫ s in (0 : ℝ)..1,
        (n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * x * s) : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun s _ => ?_
    dsimp only [Complex.expKernel]
    push_cast; rfl
  rw [hint] at h
  exact Complex.ofReal_inj.mp (by simpa using h)

private theorem real_expKernel_nonneg (n : ℕ) {x : ℝ} (hx : x < 1) {s : ℝ} (hs0 : 0 ≤ s)
    (hs1 : s ≤ 1) :
    0 ≤ (n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * x * s) := by
  have h1x : 0 ≤ 1 - x * (1 - s) := by
    rcases le_or_gt x 0 with _ | _ <;> nlinarith
  exact mul_nonneg
    (mul_nonneg (mul_nonneg (Nat.cast_nonneg n) h1x) (pow_nonneg (by linarith) _))
    (Real.exp_pos _).le

end TauCeti

namespace Complex

open TauCeti

private theorem abs_im_mul_one_sub_le {M : ℝ} {w : ℂ} (hw_re : w.re < 1)
    (hw_im : |w.im| ≤ M * (1 - w.re)) {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    |(w * (1 - (s : ℂ))).im| ≤ M * (1 - (w * (1 - (s : ℂ))).re) := by
  have hM : 0 ≤ M := by
    have : 0 ≤ M * (1 - w.re) := (abs_nonneg w.im).trans hw_im
    nlinarith
  have him : (w * (1 - (s : ℂ))).im = w.im * (1 - s) := by simp
  have hre : (w * (1 - (s : ℂ))).re = w.re * (1 - s) := by simp
  rw [him, hre, abs_mul, abs_of_nonneg (show (0 : ℝ) ≤ 1 - s by linarith)]
  calc
    |w.im| * (1 - s) ≤ (M * (1 - w.re)) * (1 - s) :=
      mul_le_mul_of_nonneg_right hw_im (by linarith)
    _ = M * (1 - s - w.re * (1 - s)) := by ring
    _ ≤ M * (1 - w.re * (1 - s)) := by nlinarith

private theorem norm_one_sub_mul_one_sub_le {M : ℝ} {w : ℂ} (hw_re : w.re < 1)
    (hw_im : |w.im| ≤ M * (1 - w.re)) {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    ‖1 - w * (1 - (s : ℂ))‖ ≤ (1 + M) * (1 - w.re * (1 - s)) := by
  have hs_im := abs_im_mul_one_sub_le hw_re hw_im hs0 hs1
  have hre_pos : 0 ≤ 1 - w.re * (1 - s) := by
    rcases le_or_gt w.re 0 with _ | _ <;> nlinarith
  have hre_eq : (1 - w * (1 - (s : ℂ))).re = 1 - w.re * (1 - s) := by simp
  have him_eq : |(1 - w * (1 - (s : ℂ))).im| = |w.im| * (1 - s) := by
    simp [abs_mul, abs_of_nonneg (show (0 : ℝ) ≤ 1 - s by linarith)]
  calc
    ‖1 - w * (1 - (s : ℂ))‖
      ≤ |(1 - w * (1 - (s : ℂ))).re| + |(1 - w * (1 - (s : ℂ))).im| :=
        Complex.norm_le_abs_re_add_abs_im _
    _ = (1 - w.re * (1 - s)) + |w.im| * (1 - s) := by
        rw [hre_eq, abs_of_nonneg hre_pos, him_eq]
    _ ≤ (1 - w.re * (1 - s)) + M * (1 - w.re * (1 - s)) := by
        have : |w.im| * (1 - s) ≤ M * (1 - w.re * (1 - s)) := by
          simpa [show (w * (1 - (s : ℂ))).im = w.im * (1 - s) by simp,
            show (w * (1 - (s : ℂ))).re = w.re * (1 - s) by simp,
            abs_mul, abs_of_nonneg (show (0 : ℝ) ≤ 1 - s by linarith)] using hs_im
        linarith
    _ = (1 + M) * (1 - w.re * (1 - s)) := by ring

private theorem norm_coeff_mul_expKernel_le (n m : ℕ) {δ M : ℝ} (hδ : 0 < δ) {w : ℂ}
    (hw_re : w.re ≤ 1 - δ) (hw_im : |w.im| ≤ M * (1 - w.re)) {s : ℝ} (hs0 : 0 ≤ s)
    (hs1 : s ≤ 1) :
    ‖expPartialSumCoeff m (w * (1 - (s : ℂ))) *
        ((n : ℂ) * (1 - w * (1 - (s : ℂ))) * (1 - (s : ℂ)) ^ (n - 1) *
          cexp ((n : ℂ) * w * s))‖ ≤
      ((2 * m - 1)‼ : ℝ) * (1 + M) ^ (2 * m + 2) * max 1 ((δ ^ (2 * m + 1))⁻¹) *
        ((n : ℝ) * (1 - w.re * (1 - s)) * (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * w.re * s)) := by
  have hw_lt : w.re < 1 := by linarith
  have hM : 0 ≤ M := by
    have : 0 ≤ M * (1 - w.re) := (abs_nonneg w.im).trans hw_im
    nlinarith
  have hs_im := abs_im_mul_one_sub_le hw_lt hw_im hs0 hs1
  have hcoeff : ‖expPartialSumCoeff m (w * (1 - (s : ℂ)))‖ ≤
      ((2 * m - 1)‼ : ℝ) * (1 + M) ^ (2 * m + 1) * max 1 ((δ ^ (2 * m + 1))⁻¹) := by
    rcases le_or_gt w.re 0 with hre0 | hre0
    · have hs_re : (w * (1 - (s : ℂ))).re ≤ 0 := by simp; nlinarith
      exact (norm_expPartialSumCoeff_le_of_re_nonpos m hs_re hs_im).trans
        (le_mul_of_one_le_right (by positivity) (le_max_left 1 _))
    · have hs_re : (w * (1 - (s : ℂ))).re ≤ 1 - δ := by simp; nlinarith
      exact norm_expPartialSumCoeff_le_of_re_le m hδ hs_re hs_im
  have h1w := norm_one_sub_mul_one_sub_le hw_lt hw_im hs0 hs1
  have h1s : ‖(1 - (s : ℂ)) ^ (n - 1)‖ = (1 - s) ^ (n - 1) := by
    rw [norm_pow, show (1 - (s : ℂ)) = ((1 - s : ℝ) : ℂ) by push_cast; rfl,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith)]
  have hexp : ‖cexp ((n : ℂ) * w * s)‖ = Real.exp ((n : ℝ) * w.re * s) := by
    rw [Complex.norm_exp]; congr 1; simp [mul_assoc]
  rw [norm_mul, norm_mul, norm_mul, norm_mul, Complex.norm_natCast, h1s, hexp]
  calc
    ‖expPartialSumCoeff m (w * (1 - (s : ℂ)))‖ *
        ((n : ℝ) * ‖1 - w * (1 - (s : ℂ))‖ * (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * w.re * s))
      ≤ (((2 * m - 1)‼ : ℝ) * (1 + M) ^ (2 * m + 1) * max 1 ((δ ^ (2 * m + 1))⁻¹)) *
          ((n : ℝ) * ((1 + M) * (1 - w.re * (1 - s))) * (1 - s) ^ (n - 1) *
            Real.exp ((n : ℝ) * w.re * s)) := by
        refine mul_le_mul hcoeff ?_ (by positivity) (by positivity)
        have hfac : 0 ≤ (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * w.re * s) :=
          mul_nonneg (pow_nonneg (by linarith) _) (Real.exp_pos _).le
        simpa [mul_assoc] using mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right h1w hfac) (Nat.cast_nonneg n)
    _ = ((2 * m - 1)‼ : ℝ) * (1 + M) ^ (2 * m + 2) * max 1 ((δ ^ (2 * m + 1))⁻¹) *
          ((n : ℝ) * (1 - w.re * (1 - s)) * (1 - s) ^ (n - 1) *
            Real.exp ((n : ℝ) * w.re * s)) := by
        rw [show 2 * m + 2 = (2 * m + 1) + 1 by omega, pow_succ]; ring

/-- Explicit uniform remainder bound for `∑_{k ≤ n} (n w)^k / k!` on the complex wedge
`{w : ℂ | Re w ≤ 1 - δ ∧ |Im w| ≤ M * (1 - Re w)}` (`δ > 0`, `n ≠ 0`). -/
theorem norm_sum_range_succ_div_factorial_sub_le {n : ℕ} (hn : n ≠ 0) (m : ℕ) {δ M : ℝ}
    (hδ : 0 < δ) {w : ℂ} (hw_re : w.re ≤ 1 - δ) (hw_im : |w.im| ≤ M * (1 - w.re)) :
    ‖(∑ k ∈ Finset.range (n + 1), ((n : ℂ) * w) ^ k / (k ! : ℂ)) -
        (exp ((n : ℂ) * w) - (((n : ℂ) * w) ^ n / (n ! : ℂ)) *
          ∑ k ∈ Finset.range m, expPartialSumCoeff k w / (n : ℂ) ^ k)‖ ≤
      ‖((n : ℂ) * w) ^ n / (n ! : ℂ)‖ *
        (((2 * m - 1)‼ : ℝ) * (1 + M) ^ (2 * m + 2) * max 1 ((δ ^ (2 * m + 1))⁻¹)) /
          (n : ℝ) ^ m := by
  have hw_lt : w.re < 1 := by linarith
  have hrew : (∑ k ∈ Finset.range (n + 1), ((n : ℂ) * w) ^ k / (k ! : ℂ)) -
      (exp ((n : ℂ) * w) - (((n : ℂ) * w) ^ n / (n ! : ℂ)) *
        ∑ k ∈ Finset.range m, expPartialSumCoeff k w / (n : ℂ) ^ k) =
      -((((n : ℂ) * w) ^ n / (n ! : ℂ)) * (((n : ℂ) ^ m)⁻¹ *
        ∫ s in (0 : ℝ)..1, expPartialSumCoeff m (w * (1 - (s : ℂ))) *
          ((n : ℂ) * (1 - w * (1 - (s : ℂ))) * (1 - (s : ℂ)) ^ (n - 1) *
            exp ((n : ℂ) * w * s)))) := by
    linear_combination -exp_mul_sub_sum_range_succ_eq_sum_add_integral hn hw_lt m
  rw [hrew, norm_neg, norm_mul, norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  let C : ℝ := ((2 * m - 1)‼ : ℝ) * (1 + M) ^ (2 * m + 2) * max 1 ((δ ^ (2 * m + 1))⁻¹)
  let g : ℝ → ℝ := fun s =>
    C * ((n : ℝ) * (1 - w.re * (1 - s)) * (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * w.re * s))
  have hg_int : IntervalIntegrable g volume 0 1 := by
    dsimp only [g]; exact (by fun_prop : Continuous _).continuousOn.intervalIntegrable
  have hint_le : ‖∫ s in (0 : ℝ)..1, expPartialSumCoeff m (w * (1 - (s : ℂ))) *
      ((n : ℂ) * (1 - w * (1 - (s : ℂ))) * (1 - (s : ℂ)) ^ (n - 1) *
        exp ((n : ℂ) * w * s))‖ ≤ C := by
    calc
      ‖∫ s in (0 : ℝ)..1, _‖ ≤ ∫ s in (0 : ℝ)..1, g s :=
        intervalIntegral.norm_integral_le_of_norm_le zero_le_one
          (Eventually.of_forall fun s hs =>
            norm_coeff_mul_expKernel_le n m hδ hw_re hw_im hs.1.le hs.2) hg_int
      _ = C := by
        dsimp only [g]
        rw [intervalIntegral.integral_const_mul, TauCeti.integral_real_expKernel hn w.re, mul_one]
  rw [mul_div_assoc]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  rw [div_eq_inv_mul]
  exact mul_le_mul_of_nonneg_left hint_le (by positivity)

/-- Uniform Buckholtz expansion of `∑_{k ≤ n} (n w)^k / k!` on the complex wedge
`{w : ℂ | Re w ≤ 1 - δ ∧ |Im w| ≤ M * (1 - Re w)}` (`δ > 0`). -/
theorem isBigO_sum_range_succ_div_factorial_sub {δ : ℝ} (hδ : 0 < δ) (M : ℝ) (m : ℕ) :
    (fun q : ℕ × ℂ =>
      (∑ k ∈ Finset.range (q.1 + 1), ((q.1 : ℂ) * q.2) ^ k / (k ! : ℂ)) -
        (exp ((q.1 : ℂ) * q.2) - (((q.1 : ℂ) * q.2) ^ q.1 / (q.1 ! : ℂ)) *
          ∑ k ∈ Finset.range m, expPartialSumCoeff k q.2 / (q.1 : ℂ) ^ k))
      =O[atTop ×ˢ 𝓟 {w : ℂ | w.re ≤ 1 - δ ∧ |w.im| ≤ M * (1 - w.re)}]
        fun q : ℕ × ℂ => (((q.1 : ℂ) * q.2) ^ q.1 / (q.1 ! : ℂ)) / (q.1 : ℂ) ^ m := by
  rcases lt_or_ge M 0 with hM | _
  · have hempty : {w : ℂ | w.re ≤ 1 - δ ∧ |w.im| ≤ M * (1 - w.re)} = ∅ := by
      rw [Set.eq_empty_iff_forall_notMem]
      rintro w ⟨hw_re, hw_im⟩
      have : M * (1 - w.re) < 0 := mul_neg_of_neg_of_pos hM (by linarith)
      linarith [abs_nonneg w.im]
    rw [hempty, principal_empty, prod_bot]
    exact isBigO_bot _ _
  · refine IsBigO.of_bound
      (((2 * m - 1)‼ : ℝ) * (1 + M) ^ (2 * m + 2) * max 1 ((δ ^ (2 * m + 1))⁻¹)) ?_
    filter_upwards [prod_mem_prod (eventually_ne_atTop 0) (mem_principal_self _)] with q hq
    have hrhs : ‖(((q.1 : ℂ) * q.2) ^ q.1 / (q.1 ! : ℂ)) / (q.1 : ℂ) ^ m‖ =
        ‖((q.1 : ℂ) * q.2) ^ q.1 / (q.1 ! : ℂ)‖ / (q.1 : ℝ) ^ m := by
      rw [norm_div, norm_pow, Complex.norm_natCast]
    rw [hrhs]
    refine (norm_sum_range_succ_div_factorial_sub_le hq.1 m hδ hq.2.1 hq.2.2).trans_eq ?_
    ring

end Complex

namespace TauCeti

/-- Explicit uniform remainder bound for `∑_{k ≤ n} (n x)^k / k!` across the entire real half-line
`x ≤ 1 - δ` (`δ > 0`, `n ≠ 0`). -/
theorem abs_sum_range_succ_div_factorial_sub_le {n : ℕ} (hn : n ≠ 0) (m : ℕ) {δ x : ℝ}
    (hδ : 0 < δ) (hx : x ≤ 1 - δ) :
    |(∑ k ∈ Finset.range (n + 1), ((n : ℝ) * x) ^ k / (k ! : ℝ)) -
        (Real.exp ((n : ℝ) * x) - (((n : ℝ) * x) ^ n / (n ! : ℝ)) *
          ∑ k ∈ Finset.range m, expPartialSumCoeff k x / (n : ℝ) ^ k)| ≤
      |((n : ℝ) * x) ^ n / (n ! : ℝ)| *
        (((2 * m - 1)‼ : ℝ) * max 1 ((δ ^ (2 * m + 1))⁻¹)) / (n : ℝ) ^ m := by
  have h := Complex.norm_sum_range_succ_div_factorial_sub_le hn m hδ (M := 0) (w := (x : ℂ))
    (by simpa using hx) (by simp)
  have hcastL : ((∑ k ∈ Finset.range (n + 1), ((n : ℂ) * (x : ℂ)) ^ k / (k ! : ℂ)) -
      (Complex.exp ((n : ℂ) * (x : ℂ)) - (((n : ℂ) * (x : ℂ)) ^ n / (n ! : ℂ)) *
        ∑ k ∈ Finset.range m, expPartialSumCoeff k (x : ℂ) / (n : ℂ) ^ k)) =
      (((∑ k ∈ Finset.range (n + 1), ((n : ℝ) * x) ^ k / (k ! : ℝ)) -
        (Real.exp ((n : ℝ) * x) - (((n : ℝ) * x) ^ n / (n ! : ℝ)) *
          ∑ k ∈ Finset.range m, expPartialSumCoeff k x / (n : ℝ) ^ k) : ℝ) : ℂ) := by
    push_cast; rfl
  have hcastR : ‖((n : ℂ) * (x : ℂ)) ^ n / (n ! : ℂ)‖ = |((n : ℝ) * x) ^ n / (n ! : ℝ)| := by
    rw [show ((n : ℂ) * (x : ℂ)) ^ n / (n ! : ℂ) =
      ((((n : ℝ) * x) ^ n / (n ! : ℝ) : ℝ) : ℂ) by push_cast; rfl,
      Complex.norm_real, Real.norm_eq_abs]
  rw [hcastL, Complex.norm_real, Real.norm_eq_abs, hcastR] at h
  simpa using h

/-- Explicit uniform remainder bound for the normalized integral
`∫₀¹ n x (1 - s)^n e^{n x s} ds` across `x ≤ 1 - δ` (`δ > 0`, `n ≠ 0`). -/
theorem abs_integral_mul_one_sub_pow_mul_exp_sub_sum_le {n : ℕ} (hn : n ≠ 0) (m : ℕ) {δ x : ℝ}
    (hδ : 0 < δ) (hx : x ≤ 1 - δ) :
    |(∫ s in (0 : ℝ)..1, (n : ℝ) * x * (1 - s) ^ n * Real.exp ((n : ℝ) * x * s)) -
        ∑ k ∈ Finset.range m, expPartialSumCoeff k x / (n : ℝ) ^ k| ≤
      ((2 * m - 1)‼ : ℝ) * max 1 ((δ ^ (2 * m + 1))⁻¹) / (n : ℝ) ^ m := by
  have hx_lt : x < 1 := by linarith
  rw [integral_mul_one_sub_pow_mul_exp_eq_sum_add_integral hn hx_lt m, add_sub_cancel_left,
    abs_mul, abs_inv, abs_pow, Nat.abs_cast, div_eq_inv_mul]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  let C : ℝ := ((2 * m - 1)‼ : ℝ) * max 1 ((δ ^ (2 * m + 1))⁻¹)
  let g : ℝ → ℝ := fun s =>
    C * ((n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * x * s))
  have hg_int : IntervalIntegrable g volume 0 1 := by
    dsimp only [g]; exact (by fun_prop : Continuous _).continuousOn.intervalIntegrable
  rw [← Real.norm_eq_abs]
  calc
    ‖∫ s in (0 : ℝ)..1, _‖ ≤ ∫ s in (0 : ℝ)..1, g s :=
      intervalIntegral.norm_integral_le_of_norm_le zero_le_one
        (Eventually.of_forall fun s hs => by
          have h := Complex.norm_coeff_mul_expKernel_le n m hδ (M := 0) (w := (x : ℂ))
            (by simpa using hx) (by simp) hs.1.le hs.2
          have hcast : expPartialSumCoeff m ((x : ℂ) * (1 - (s : ℂ))) *
              ((n : ℂ) * (1 - (x : ℂ) * (1 - (s : ℂ))) * (1 - (s : ℂ)) ^ (n - 1) *
                Complex.exp ((n : ℂ) * (x : ℂ) * s)) =
              ((expPartialSumCoeff m (x * (1 - s)) *
                ((n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) *
                  Real.exp ((n : ℝ) * x * s)) : ℝ) : ℂ) := by
            push_cast; rfl
          rw [hcast, Complex.norm_real] at h
          simpa [g, C] using h) hg_int
    _ = C := by
      dsimp only [g]
      rw [intervalIntegral.integral_const_mul, integral_real_expKernel hn x, mul_one]

/-- **DLMF 8.11.18**: uniform asymptotic expansion of the exponential partial sums
`∑_{k ≤ n} (n x)^k / k!` across `x ≤ 1 - δ` (`δ > 0`) to arbitrary order `m`. -/
theorem isBigO_sum_range_succ_div_factorial_sub {δ : ℝ} (hδ : 0 < δ) (m : ℕ) :
    (fun q : ℕ × ℝ =>
      (∑ k ∈ Finset.range (q.1 + 1), ((q.1 : ℝ) * q.2) ^ k / (k ! : ℝ)) -
        (Real.exp ((q.1 : ℝ) * q.2) - (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) *
          ∑ k ∈ Finset.range m, expPartialSumCoeff k q.2 / (q.1 : ℝ) ^ k))
      =O[atTop ×ˢ 𝓟 (Iic (1 - δ))]
        fun q : ℕ × ℝ => (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) / (q.1 : ℝ) ^ m := by
  refine IsBigO.of_bound (((2 * m - 1)‼ : ℝ) * max 1 ((δ ^ (2 * m + 1))⁻¹)) ?_
  filter_upwards [prod_mem_prod (eventually_ne_atTop 0) (mem_principal_self (Iic (1 - δ)))]
    with q hq
  have hrhs : ‖(((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) / (q.1 : ℝ) ^ m‖ =
      |((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)| / (q.1 : ℝ) ^ m := by
    have hpow : |(q.1 : ℝ) ^ m| = (q.1 : ℝ) ^ m := abs_of_nonneg (by positivity)
    rw [Real.norm_eq_abs, abs_div, hpow]
  rw [Real.norm_eq_abs, hrhs]
  refine (abs_sum_range_succ_div_factorial_sub_le hq.1 m hδ hq.2).trans_eq ?_
  ring

/-- **DLMF 8.11.18** in normalized quotient form, uniformly on `x ≤ 1 - δ` (`δ > 0`). -/
theorem isBigO_div_exp_sub_sum_range_succ_sub {δ : ℝ} (hδ : 0 < δ) (m : ℕ) :
    (fun q : ℕ × ℝ =>
      (Real.exp ((q.1 : ℝ) * q.2) -
          ∑ k ∈ Finset.range (q.1 + 1), ((q.1 : ℝ) * q.2) ^ k / (k ! : ℝ)) /
        (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) -
        ∑ k ∈ Finset.range m, expPartialSumCoeff k q.2 / (q.1 : ℝ) ^ k)
      =O[atTop ×ˢ 𝓟 (Iic (1 - δ))] fun q : ℕ × ℝ => ((q.1 : ℝ) ^ m)⁻¹ := by
  refine IsBigO.of_bound (((2 * m - 1)‼ : ℝ) * max 1 ((δ ^ (2 * m + 1))⁻¹)) ?_
  filter_upwards [prod_mem_prod (eventually_ne_atTop 0) (mem_principal_self (Iic (1 - δ)))]
    with q hq
  simp only [Real.norm_eq_abs, abs_inv, abs_pow, Nat.abs_cast]
  rcases eq_or_ne q.2 0 with hx0 | hx0
  · have hzero : (Real.exp ((q.1 : ℝ) * q.2) -
          ∑ k ∈ Finset.range (q.1 + 1), ((q.1 : ℝ) * q.2) ^ k / (k ! : ℝ)) /
        (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) -
        ∑ k ∈ Finset.range m, expPartialSumCoeff k q.2 / (q.1 : ℝ) ^ k = 0 := by
      simp [hx0, zero_pow hq.1]
    rw [hzero, abs_zero]
    positivity
  · have hpref : ((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ) ≠ 0 :=
      div_ne_zero (pow_ne_zero _ (mul_ne_zero (Nat.cast_ne_zero.mpr hq.1) hx0))
        (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero q.1))
    have hquot : (Real.exp ((q.1 : ℝ) * q.2) -
          ∑ k ∈ Finset.range (q.1 + 1), ((q.1 : ℝ) * q.2) ^ k / (k ! : ℝ)) /
        (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) =
        ∫ s in (0 : ℝ)..1, (q.1 : ℝ) * q.2 * (1 - s) ^ q.1 * Real.exp ((q.1 : ℝ) * q.2 * s) := by
      have hpow : ((q.1 : ℝ) * q.2) ^ (q.1 + 1) / (q.1 ! : ℝ) =
          (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) * ((q.1 : ℝ) * q.2) := by
        rw [pow_succ]; ring
      rw [Real.exp_sub_sum_range_succ_eq_integral q.1 ((q.1 : ℝ) * q.2), hpow,
        mul_assoc, mul_div_cancel_left₀ _ hpref, ← intervalIntegral.integral_const_mul]
      exact intervalIntegral.integral_congr fun s _ => by ring
    rw [hquot]
    simpa [div_eq_mul_inv] using abs_integral_mul_one_sub_pow_mul_exp_sub_sum_le hq.1 m hδ hq.2

/-- **DLMF 8.11.18–8.11.19** stated directly in terms of any sequence `d : ℕ → ℝ → ℝ` satisfying
the differential recurrence `d 0 x = x / (1 - x)` and `d (k + 1) x = -(x / (1 - x)) * deriv (d k) x`
for `x ≠ 1`. -/
theorem isBigO_sum_range_succ_div_factorial_sub_of_recurrence {d : ℕ → ℝ → ℝ}
    (hd0 : ∀ x ≠ 1, d 0 x = x / (1 - x))
    (hd : ∀ k, ∀ x ≠ 1, d (k + 1) x = -(x / (1 - x)) * deriv (d k) x)
    {δ : ℝ} (hδ : 0 < δ) (m : ℕ) :
    (fun q : ℕ × ℝ =>
      (∑ k ∈ Finset.range (q.1 + 1), ((q.1 : ℝ) * q.2) ^ k / (k ! : ℝ)) -
        (Real.exp ((q.1 : ℝ) * q.2) - (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) *
          ∑ k ∈ Finset.range m, d k q.2 / (q.1 : ℝ) ^ k))
      =O[atTop ×ˢ 𝓟 (Iic (1 - δ))]
        fun q : ℕ × ℝ => (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) / (q.1 : ℝ) ^ m := by
  refine (isBigO_sum_range_succ_div_factorial_sub hδ m).congr' ?_ EventuallyEq.rfl
  filter_upwards [prod_mem_prod Filter.univ_mem (mem_principal_self (Iic (1 - δ)))] with q hq
  have hq2 : q.2 ≤ 1 - δ := hq.2
  have hne : q.2 ≠ 1 := by linarith
  have hsum : ∑ k ∈ Finset.range m, expPartialSumCoeff k q.2 / (q.1 : ℝ) ^ k =
      ∑ k ∈ Finset.range m, d k q.2 / (q.1 : ℝ) ^ k :=
    Finset.sum_congr rfl fun k _ => by rw [eq_expPartialSumCoeff_of_recurrence hd0 hd k hne]
  rw [hsum]

/-- Enveloping lower bound on `[0, 1)`: the `m`-th normalized remainder has sign `(-1)^m`. -/
theorem neg_one_pow_mul_integral_sub_sum_nonneg {n : ℕ} (hn : n ≠ 0) (m : ℕ) {x : ℝ}
    (hx0 : 0 ≤ x) (hx1 : x < 1) :
    0 ≤ (-1) ^ m *
      ((∫ s in (0 : ℝ)..1, (n : ℝ) * x * (1 - s) ^ n * Real.exp ((n : ℝ) * x * s)) -
        ∑ k ∈ Finset.range m, expPartialSumCoeff k x / (n : ℝ) ^ k) := by
  rw [integral_mul_one_sub_pow_mul_exp_eq_sum_add_integral hn hx1 m, add_sub_cancel_left,
    ← mul_assoc, mul_comm ((-1 : ℝ) ^ m), mul_assoc, ← intervalIntegral.integral_const_mul]
  refine mul_nonneg (by positivity) (intervalIntegral.integral_nonneg zero_le_one fun s hs => ?_)
  rw [← mul_assoc]
  exact mul_nonneg
    (neg_one_pow_mul_expPartialSumCoeff_nonneg m
      (mul_nonneg hx0 (by linarith [hs.2])) (by nlinarith [hs.1, hs.2]))
    (real_expKernel_nonneg n hx1 hs.1 hs.2)

/-- Enveloping upper bound on `[0, 1)`: the `m`-th normalized remainder is bounded in magnitude by
the first neglected term `(-1)^m d_m(x) / n^m`. -/
theorem neg_one_pow_mul_integral_sub_sum_le {n : ℕ} (hn : n ≠ 0) (m : ℕ) {x : ℝ} (hx0 : 0 ≤ x)
    (hx1 : x < 1) :
    (-1) ^ m *
      ((∫ s in (0 : ℝ)..1, (n : ℝ) * x * (1 - s) ^ n * Real.exp ((n : ℝ) * x * s)) -
        ∑ k ∈ Finset.range m, expPartialSumCoeff k x / (n : ℝ) ^ k) ≤
      (-1) ^ m * expPartialSumCoeff m x / (n : ℝ) ^ m := by
  rw [integral_mul_one_sub_pow_mul_exp_eq_sum_add_integral hn hx1 m, add_sub_cancel_left,
    ← mul_assoc, mul_comm ((-1 : ℝ) ^ m), mul_assoc, ← intervalIntegral.integral_const_mul,
    div_eq_inv_mul]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  let K : ℝ → ℝ := fun s =>
    (n : ℝ) * (1 - x * (1 - s)) * (1 - s) ^ (n - 1) * Real.exp ((n : ℝ) * x * s)
  have hK_int : IntervalIntegrable K volume 0 1 := by
    dsimp only [K]; exact (by fun_prop : Continuous _).continuousOn.intervalIntegrable
  have hL_int : IntervalIntegrable
      (fun s => (-1 : ℝ) ^ m * (expPartialSumCoeff m (x * (1 - s)) * K s)) volume 0 1 := by
    dsimp only [K]
    have hc : ContinuousOn (fun s : ℝ => expPartialSumCoeff m (x * (1 - s))) (uIcc 0 1) := by
      rw [Set.uIcc_of_le zero_le_one]
      intro s hs
      have hne : x * (1 - s) ≠ 1 := by nlinarith [hs.1, hs.2]
      have hf : ContinuousAt (expPartialSumCoeff m) (x * (1 - s)) :=
        (hasDerivAt_expPartialSumCoeff m hne).continuousAt
      have hg : ContinuousAt (fun t : ℝ => x * (1 - t)) s := by fun_prop
      exact (hf.comp (f := fun t : ℝ => x * (1 - t)) hg).continuousWithinAt
    exact (continuousOn_const.mul (hc.mul (by fun_prop : Continuous _).continuousOn))
      |>.intervalIntegrable
  calc
    ∫ s in (0 : ℝ)..1, (-1 : ℝ) ^ m * (expPartialSumCoeff m (x * (1 - s)) * K s)
      ≤ ∫ s in (0 : ℝ)..1, ((-1 : ℝ) ^ m * expPartialSumCoeff m x) * K s := by
        refine intervalIntegral.integral_mono_on zero_le_one hL_int (hK_int.const_mul _)
          fun s hs => ?_
        rw [← mul_assoc]
        exact mul_le_mul_of_nonneg_right
          (neg_one_pow_mul_expPartialSumCoeff_mono m (mul_nonneg hx0 (by linarith [hs.2]))
            (by nlinarith [hs.1]) hx1)
          (real_expKernel_nonneg n hx1 hs.1 hs.2)
    _ = (-1) ^ m * expPartialSumCoeff m x := by
        rw [intervalIntegral.integral_const_mul, integral_real_expKernel hn x, mul_one]

/-- Pointwise limit `(e^{n x} - ∑_{k ≤ n} (n x)^k / k!) / ((n x)^n / n!) → x / (1 - x)` as
`n → ∞` for every `x < 1` (including `x = 0`, where both sides vanish). -/
theorem tendsto_div_exp_sub_sum_range_succ_atTop {x : ℝ} (hx : x < 1) :
    Tendsto (fun n : ℕ =>
      (Real.exp ((n : ℝ) * x) - ∑ k ∈ Finset.range (n + 1), ((n : ℝ) * x) ^ k / (k ! : ℝ)) /
        (((n : ℝ) * x) ^ n / (n ! : ℝ)))
      atTop (𝓝 (x / (1 - x))) := by
  have hbig : (fun n : ℕ =>
      (Real.exp ((n : ℝ) * x) - ∑ k ∈ Finset.range (n + 1), ((n : ℝ) * x) ^ k / (k ! : ℝ)) /
        (((n : ℝ) * x) ^ n / (n ! : ℝ)) - (x / (1 - x)))
      =O[atTop] fun n : ℕ => ((n : ℝ) ^ 1)⁻¹ := by
    have ht : Tendsto (fun n : ℕ => (n, x)) atTop (atTop ×ˢ 𝓟 (Iic (1 - (1 - x)))) :=
      tendsto_id.prodMk (tendsto_principal.mpr (Eventually.of_forall fun _ => by simp))
    simpa [Function.comp_def] using
      (isBigO_div_exp_sub_sum_range_succ_sub (δ := 1 - x) (sub_pos.mpr hx) 1).comp_tendsto ht
  have h0 : Tendsto (fun n : ℕ => ((n : ℝ) ^ 1)⁻¹) atTop (𝓝 0) := by
    simpa [Function.comp_def] using tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
  simpa using (hbig.trans_tendsto h0).add_const (x / (1 - x))

/-- Leading asymptotic equivalence
`e^{n x} - ∑_{k ≤ n} (n x)^k / k! ~ ((n x)^n / n!) * (x / (1 - x))` as `n → ∞` for every `x < 1`
(at `x = 0`, both sides vanish for `n ≥ 1`). -/
theorem exp_mul_sub_sum_range_succ_isEquivalent {x : ℝ} (hx : x < 1) :
    (fun n : ℕ =>
      Real.exp ((n : ℝ) * x) - ∑ k ∈ Finset.range (n + 1), ((n : ℝ) * x) ^ k / (k ! : ℝ))
      ~[atTop] fun n : ℕ => (((n : ℝ) * x) ^ n / (n ! : ℝ)) * (x / (1 - x)) := by
  rw [IsEquivalent]
  have hbig : (fun n : ℕ =>
      (Real.exp ((n : ℝ) * x) - ∑ k ∈ Finset.range (n + 1), ((n : ℝ) * x) ^ k / (k ! : ℝ)) -
        (((n : ℝ) * x) ^ n / (n ! : ℝ)) * (x / (1 - x)))
      =O[atTop] fun n : ℕ => (((n : ℝ) * x) ^ n / (n ! : ℝ)) / (n : ℝ) := by
    have ht : Tendsto (fun n : ℕ => (n, x)) atTop (atTop ×ˢ 𝓟 (Iic (1 - (1 - x)))) :=
      tendsto_id.prodMk (tendsto_principal.mpr (Eventually.of_forall fun _ => by simp))
    have h := (isBigO_sum_range_succ_div_factorial_sub (δ := 1 - x) (sub_pos.mpr hx) 1).neg_left
      |>.comp_tendsto ht
    refine h.congr' ?_ (Eventually.of_forall fun n => by simp)
    filter_upwards with n
    simp only [Function.comp_apply, Finset.range_one, Finset.sum_singleton, expPartialSumCoeff_zero,
      pow_zero, div_one]
    ring
  rcases eq_or_ne x 0 with rfl | hx0
  · refine IsLittleO.congr' (isLittleO_zero _ _) ?_ EventuallyEq.rfl
    filter_upwards [eventually_ne_atTop 0] with n _
    simp [Finset.sum_range_succ']
  · have hx1 : x / (1 - x) ≠ 0 := div_ne_zero hx0 (sub_ne_zero.mpr hx.ne')
    refine hbig.trans_isLittleO ?_
    have hinv : (fun n : ℕ => ((n : ℝ))⁻¹) =o[atTop] fun _ : ℕ => x / (1 - x) :=
      (isLittleO_const_iff hx1).mpr
        (by simpa [Function.comp_def] using tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop)
    refine ((isBigO_refl (fun n : ℕ => ((n : ℝ) * x) ^ n / (n ! : ℝ)) atTop).mul_isLittleO
      hinv).congr' (Eventually.of_forall fun n => by ring)
      EventuallyEq.rfl

/-- Uniform asymptotic expansion of `TauCeti.regularizedGamma (n + 1) (n * x)` across `[0, 1 - δ]`
(`δ > 0`) to arbitrary order `m`. -/
theorem isBigO_regularizedGamma_natCast_add_one_mul_sub {δ : ℝ} (hδ : 0 < δ) (m : ℕ) :
    (fun q : ℕ × ℝ =>
      regularizedGamma ((q.1 : ℝ) + 1) ((q.1 : ℝ) * q.2) -
        Real.exp (-((q.1 : ℝ) * q.2)) * (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) *
          ∑ k ∈ Finset.range m, expPartialSumCoeff k q.2 / (q.1 : ℝ) ^ k)
      =O[atTop ×ˢ 𝓟 (Icc 0 (1 - δ))]
        fun q : ℕ × ℝ =>
          Real.exp (-((q.1 : ℝ) * q.2)) * (((q.1 : ℝ) * q.2) ^ q.1 / (q.1 ! : ℝ)) /
            (q.1 : ℝ) ^ m := by
  have hmono : (atTop : Filter ℕ) ×ˢ 𝓟 (Icc (0 : ℝ) (1 - δ)) ≤
      (atTop : Filter ℕ) ×ˢ 𝓟 (Iic (1 - δ)) :=
    prod_mono_right _ (principal_mono.mpr Icc_subset_Iic_self)
  have hbase := ((isBigO_sum_range_succ_div_factorial_sub hδ m).mono hmono).neg_left
  refine ((isBigO_refl (fun q : ℕ × ℝ => Real.exp (-((q.1 : ℝ) * q.2))) _).mul hbase).congr'
    ?_ (Eventually.of_forall fun q => by ring)
  filter_upwards [prod_mem_prod Filter.univ_mem (mem_principal_self (Icc 0 (1 - δ)))] with q hq
  have hnx : 0 ≤ (q.1 : ℝ) * q.2 := mul_nonneg (Nat.cast_nonneg q.1) hq.2.1
  have herlang : regularizedGamma ((q.1 : ℝ) + 1) ((q.1 : ℝ) * q.2) =
      Real.exp (-((q.1 : ℝ) * q.2)) *
        (Real.exp ((q.1 : ℝ) * q.2) -
          ∑ k ∈ Finset.range (q.1 + 1), ((q.1 : ℝ) * q.2) ^ k / (k ! : ℝ)) := by
    have hcast : ((q.1 : ℝ) + 1) = ((q.1 + 1 : ℕ) : ℝ) := by push_cast; rfl
    rw [hcast, regularizedGamma_natCast (Nat.succ_ne_zero q.1) hnx]
    have hexp : Real.exp (-((q.1 : ℝ) * q.2)) * Real.exp ((q.1 : ℝ) * q.2) = 1 := by
      rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
    linear_combination -hexp
  rw [herlang]
  ring

/-- Leading asymptotic equivalence for `TauCeti.regularizedGamma (n + 1) (n * x)` as `n → ∞` for
every `x ∈ [0, 1)` (at `x = 0`, both sides vanish). -/
theorem regularizedGamma_natCast_add_one_mul_isEquivalent {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) :
    (fun n : ℕ => regularizedGamma ((n : ℝ) + 1) ((n : ℝ) * x))
      ~[atTop]
        fun n : ℕ =>
          Real.exp (-((n : ℝ) * x)) * (((n : ℝ) * x) ^ n / (n ! : ℝ)) * (x / (1 - x)) := by
  have heq : (fun n : ℕ => Real.exp (-((n : ℝ) * x)) *
      (Real.exp ((n : ℝ) * x) - ∑ k ∈ Finset.range (n + 1), ((n : ℝ) * x) ^ k / (k ! : ℝ)))
      ~[atTop]
      fun n : ℕ => Real.exp (-((n : ℝ) * x)) *
        ((((n : ℝ) * x) ^ n / (n ! : ℝ)) * (x / (1 - x))) :=
    (IsEquivalent.refl (u := fun n : ℕ => Real.exp (-((n : ℝ) * x)))).mul
      (exp_mul_sub_sum_range_succ_isEquivalent hx1)
  refine (heq.congr_left ?_).congr_right (Eventually.of_forall fun n => by ring)
  filter_upwards with n
  have hcast : ((n : ℝ) + 1) = ((n + 1 : ℕ) : ℝ) := by push_cast; rfl
  rw [hcast, regularizedGamma_natCast (Nat.succ_ne_zero n) (mul_nonneg (Nat.cast_nonneg n) hx0)]
  have hexp : Real.exp (-((n : ℝ) * x)) * Real.exp ((n : ℝ) * x) = 1 := by
    rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
  linear_combination hexp

end TauCeti

