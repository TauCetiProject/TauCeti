module

public import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Integral
public import Mathlib.Analysis.SpecialFunctions.ContinuousFunctionalCalculus.Rpow.Basic
public import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import TauCeti.Analysis.SpecialFunctions.Beta.Basic

/-!
# The resolvent integral of real powers between `0` and `1`

For `0 < σ < 1` and a nonnegative element `a` of a complete normed algebra with a continuous
functional calculus, such as a positive operator on a Hilbert space,

`a ^ σ = (sin (π σ) / π) ∫₀^∞ t ^ (-σ) a (1 + t a)⁻¹ dt`

as a Bochner integral in the algebra (`CFC.rpow_eq_integral_cfc_div_one_add_mul`), with the
integrand integrable (`CFC.integrableOn_rpow_neg_smul_cfc_div_one_add_mul`). Here
`a (1 + t a)⁻¹` is the element `cfc (fun x ↦ x / (1 + t x)) a`, which multiplied by `1 + t a` on
either side gives `a` (`CFC.one_add_smul_mul_cfc_div_one_add_mul`,
`CFC.cfc_div_one_add_mul_mul_one_add_smul`). The scalar case is the Mellin transform
`∫₀^∞ t ^ (-σ) x / (1 + t x) dt = π / sin (π σ) * x ^ σ`
(`TauCeti.integral_rpow_neg_mul_div_one_add_mul`), and the functional calculus commutes with the
integral (`cfc_setIntegral`).

The element `a` need not be invertible. When `a = A⁻¹` is the inverse of a positive unbounded
operator `A`, the integrand is `t ^ (-σ) (A + t)⁻¹`, so this formula writes the power `A ^ (-σ)`
as an integral of the resolvent of `A` along the negative real axis: it is the contour integral
of `λ ^ (-σ) (A - λ)⁻¹` around the spectrum, collapsed onto the cut. Mathlib's
`CFC.exists_measure_rpow_eq_integral_cfc_rpowIntegrand₁₀` is a related representation of the
negative powers `a ^ p`, `-1 < p < 0`, of a strictly positive `a`, with the integrand
`t ^ p (t + a)⁻¹` and an unspecified multiple of Lebesgue measure.

## References

* A. V. Balakrishnan, *Fractional powers of closed operators and the semigroups generated by
  them*, Pacific J. Math. 10 (1960), 419–437.
* A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*,
  Chapter 2, §2.6.
-/

public section

open MeasureTheory Set

namespace CFC

variable {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [PartialOrder A]
  [NonnegSpectrumClass ℝ A] {a : A} {σ : ℝ}

/-- The integrand `(t, x) ↦ t ^ (-σ) x / (1 + t x)` is continuous for `t > 0` and `x` in the
spectrum of a nonnegative element. -/
private theorem continuousOn_rpow_neg_mul_div_one_add_mul (ha : 0 ≤ a) :
    ContinuousOn (Function.uncurry fun t x : ℝ ↦ t ^ (-σ) * (x / (1 + t * x)))
      (Ioi 0 ×ˢ spectrum ℝ a) := by
  rintro ⟨t, x⟩ ⟨ht, hx⟩
  have ht : 0 < t := ht
  have hx : 0 ≤ x := spectrum_nonneg_of_nonneg ha hx
  refine ContinuousAt.continuousWithinAt ?_
  refine (continuousAt_fst.rpow_const (Or.inl ht.ne')).mul
    (continuousAt_snd.div (continuousAt_const.add (continuousAt_fst.mul continuousAt_snd)) ?_)
  dsimp only
  positivity

/-- On the spectrum of a nonnegative element, the integrand `t ^ (-σ) x / (1 + t x)` is
dominated by its value at the largest spectral value. -/
private theorem norm_rpow_neg_mul_div_one_add_mul_le [CompleteSpace A] (ha : 0 ≤ a) {t : ℝ}
    (ht : 0 < t) {x : ℝ} (hx : x ∈ spectrum ℝ a) :
    ‖t ^ (-σ) * (x / (1 + t * x))‖ ≤
      t ^ (-σ) * (sSup (spectrum ℝ a) / (1 + t * sSup (spectrum ℝ a))) := by
  have hx0 : 0 ≤ x := spectrum_nonneg_of_nonneg ha hx
  have hxr : x ≤ sSup (spectrum ℝ a) := le_csSup (spectrum.isCompact ℝ a).bddAbove hx
  rw [Real.norm_of_nonneg (by positivity)]
  gcongr t ^ (-σ) * ?_
  rw [div_le_div_iff₀ (by positivity) (by nlinarith)]
  nlinarith

/-- The function `x ↦ x / (1 + t x)` is continuous on the spectrum of a nonnegative element, for
`t ≥ 0`. -/
private theorem continuousOn_div_one_add_mul (ha : 0 ≤ a) {t : ℝ} (ht : 0 ≤ t) :
    ContinuousOn (fun x : ℝ ↦ x / (1 + t * x)) (spectrum ℝ a) :=
  continuousOn_id.div (by fun_prop) fun x hx ↦
    (by have := spectrum_nonneg_of_nonneg ha hx; positivity)

variable [StarRing A] [StarOrderedRing A] [ContinuousFunctionalCalculus ℝ A IsSelfAdjoint]

/-- For a nonnegative element `a` and `t ≥ 0`, the element `cfc (fun x ↦ x / (1 + t x)) a` is
`(1 + t a)⁻¹ a`: multiplied on the left by `1 + t a` it gives `a`. -/
theorem one_add_smul_mul_cfc_div_one_add_mul (ha : 0 ≤ a) {t : ℝ} (ht : 0 ≤ t) :
    (1 + t • a) * cfc (fun x : ℝ ↦ x / (1 + t * x)) a = a := by
  have hc := continuousOn_div_one_add_mul ha ht
  have := cfc_congr (a := a) (f := fun x : ℝ ↦ x / (1 + t * x) + t * (x * (x / (1 + t * x))))
    (g := fun x ↦ x) fun x hx ↦ by
      have : 0 < 1 + t * x := by have := spectrum_nonneg_of_nonneg ha hx; positivity
      linear_combination div_mul_cancel₀ x this.ne'
  rwa [cfc_add a _ (fun x ↦ t * (x * (x / (1 + t * x)))) hc
    (continuousOn_const.mul (continuousOn_id.mul hc)),
    cfc_const_mul t (fun x ↦ x * (x / (1 + t * x))) a (continuousOn_id.mul hc),
    cfc_mul (fun x : ℝ ↦ x) _ a continuousOn_id hc,
    cfc_id' ℝ a, ← smul_mul_assoc, ← one_add_mul] at this

/-- For a nonnegative element `a` and `t ≥ 0`, the element `cfc (fun x ↦ x / (1 + t x)) a` is
`a (1 + t a)⁻¹`: multiplied on the right by `1 + t a` it gives `a`. -/
theorem cfc_div_one_add_mul_mul_one_add_smul (ha : 0 ≤ a) {t : ℝ} (ht : 0 ≤ t) :
    cfc (fun x : ℝ ↦ x / (1 + t * x)) a * (1 + t • a) = a := by
  have hc : Commute (cfc (fun x : ℝ ↦ x / (1 + t * x)) a) a := by
    simpa only [cfc_id' ℝ a] using cfc_commute_cfc (fun x : ℝ ↦ x / (1 + t * x)) (fun x ↦ x) a
  rw [((Commute.one_right _).add_right (hc.smul_right t)).eq,
    one_add_smul_mul_cfc_div_one_add_mul ha ht]

/-- For a nonnegative element `a` and `0 < σ < 1`, the integrand `t ^ (-σ) a (1 + t a)⁻¹` of the
resolvent integral of `a ^ σ` is integrable on `(0, ∞)`. -/
theorem integrableOn_rpow_neg_smul_cfc_div_one_add_mul [CompleteSpace A] (ha : 0 ≤ a) (hσ : 0 < σ)
    (hσ1 : σ < 1) :
    IntegrableOn (fun t : ℝ ↦ t ^ (-σ) • cfc (fun x : ℝ ↦ x / (1 + t * x)) a) (Ioi 0) := by
  have hint := integrableOn_cfc measurableSet_Ioi _ _ a
    (continuousOn_rpow_neg_mul_div_one_add_mul ha)
    (ae_restrict_of_forall_mem measurableSet_Ioi fun t ht _ hx ↦
      norm_rpow_neg_mul_div_one_add_mul_le ha ht hx)
    (TauCeti.integrableOn_rpow_neg_mul_div_one_add_mul σ _ hσ hσ1
      (Real.sSup_nonneg fun _ hx ↦ spectrum_nonneg_of_nonneg ha hx)).2
    ha.isSelfAdjoint
  exact hint.congr_fun (fun t (ht : 0 < t) ↦
    cfc_const_mul _ _ a (continuousOn_div_one_add_mul ha ht.le)) measurableSet_Ioi

/-- **The resolvent integral of a real power.** For a nonnegative element `a` and `0 < σ < 1`,

`a ^ σ = (sin (π σ) / π) ∫₀^∞ t ^ (-σ) a (1 + t a)⁻¹ dt`,

where `a (1 + t a)⁻¹ = cfc (fun x ↦ x / (1 + t x)) a`. -/
theorem rpow_eq_integral_cfc_div_one_add_mul [CompleteSpace A] (ha : 0 ≤ a) (hσ : 0 < σ)
    (hσ1 : σ < 1) :
    a ^ σ = (Real.sin (Real.pi * σ) / Real.pi) •
      ∫ t in Ioi (0 : ℝ), t ^ (-σ) • cfc (fun x : ℝ ↦ x / (1 + t * x)) a := by
  have hsin : 0 < Real.sin (Real.pi * σ) :=
    Real.sin_pos_of_pos_of_lt_pi (by positivity) (by nlinarith [Real.pi_pos])
  -- The functional calculus commutes with the integral over `t`.
  have key := cfc_setIntegral measurableSet_Ioi (fun t x : ℝ ↦ t ^ (-σ) * (x / (1 + t * x))) _ a
    (continuousOn_rpow_neg_mul_div_one_add_mul ha)
    (ae_restrict_of_forall_mem measurableSet_Ioi fun t ht _ hx ↦
      norm_rpow_neg_mul_div_one_add_mul_le ha ht hx)
    (TauCeti.integrableOn_rpow_neg_mul_div_one_add_mul σ _ hσ hσ1
      (Real.sSup_nonneg fun _ hx ↦ spectrum_nonneg_of_nonneg ha hx)).2
    ha.isSelfAdjoint
  -- On the spectrum, the scalar integral is `π / sin (π σ) * x ^ σ`.
  rw [cfc_congr (g := fun x : ℝ ↦ Real.pi / Real.sin (Real.pi * σ) * x ^ σ)
    (fun x hx ↦ TauCeti.integral_rpow_neg_mul_div_one_add_mul σ x hσ hσ1
      (spectrum_nonneg_of_nonneg ha hx)),
    cfc_const_mul _ _ a (Real.continuous_rpow_const hσ.le).continuousOn,
    ← rpow_eq_cfc_real ha] at key
  have hint : ∫ t in Ioi (0 : ℝ), t ^ (-σ) • cfc (fun x : ℝ ↦ x / (1 + t * x)) a =
      ∫ t in Ioi (0 : ℝ), cfc (fun x : ℝ ↦ t ^ (-σ) * (x / (1 + t * x))) a :=
    setIntegral_congr_fun measurableSet_Ioi fun t (ht : 0 < t) ↦
      (cfc_const_mul _ _ a (continuousOn_div_one_add_mul ha ht.le)).symm
  rw [hint, ← key, smul_smul, div_mul_div_cancel₀ Real.pi_ne_zero, div_self hsin.ne', one_smul]

end CFC
