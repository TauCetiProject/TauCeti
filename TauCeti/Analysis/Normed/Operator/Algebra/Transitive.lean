module

public import Mathlib.Analysis.LocallyConvex.SeparatingDual
import Mathlib.Algebra.Module.Submodule.Lattice

/-!
# Transitive operator algebras

A unital algebra of continuous linear operators is transitive if every nonzero vector has a
dense orbit. This is equivalent to having no nonzero proper closed invariant scalar subspace.
The orbit is already a scalar subspace. Its closure lies in a closed invariant subspace
exactly when that subspace contains the generating vector. These facts allow an
invariant-subspace problem to be rephrased as a failure of transitivity, as in
compact-commutation arguments.

No completeness hypothesis is needed. The full continuous-operator algebra is transitive
whenever the continuous dual separates points, in particular for real or complex normed spaces.

## References

* J. B. Conway, *A Course in Functional Analysis*, Chapter VI.
* V. I. Lomonosov, *Invariant subspaces for the family of operators which commute with
  a completely continuous operator*, Functional Analysis and Its Applications 7 (1973),
  213--214.
-/

public section

namespace Subalgebra

section TopologicalModule

variable {𝕜 E : Type*} [CommRing 𝕜] [TopologicalSpace 𝕜]
  [AddCommGroup E] [TopologicalSpace E] [Module 𝕜 E]
  [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E]

/-- The scalar subspace `A x` generated by applying operators in `A` to `x`.
Since `A` is a linear subspace and evaluation at `x` is linear, this image is already a
subspace; because `A` is unital, it contains `x`. -/
noncomputable def operatorOrbit (A : Subalgebra 𝕜 (E →L[𝕜] E)) (x : E) : Submodule 𝕜 E :=
  A.toSubmodule.map ((ContinuousLinearMap.coeLM 𝕜).flip x)

/-- Membership in an operator orbit is witnessed by a single operator in the algebra. -/
@[simp]
theorem mem_operatorOrbit (A : Subalgebra 𝕜 (E →L[𝕜] E)) (x y : E) :
    y ∈ A.operatorOrbit x ↔ ∃ a : A, (a : E →L[𝕜] E) x = y := by
  simp [operatorOrbit, Submodule.mem_map, Subtype.exists]

/-- The underlying set of an operator orbit is the range of evaluation on the algebra. -/
@[simp]
theorem coe_operatorOrbit (A : Subalgebra 𝕜 (E →L[𝕜] E)) (x : E) :
    (A.operatorOrbit x : Set E) = Set.range (fun a : A ↦ (a : E →L[𝕜] E) x) := by
  ext y
  exact A.mem_operatorOrbit x y

/-- The zero vector has zero operator orbit. -/
@[simp]
theorem operatorOrbit_zero (A : Subalgebra 𝕜 (E →L[𝕜] E)) : A.operatorOrbit 0 = ⊥ := by
  ext y
  simp [mem_operatorOrbit, eq_comm]

/-- An operator orbit contains its generating vector. -/
-- Simplify before coe_operatorOrbit rewrites the submodule to a range.
@[simp↓]
theorem self_mem_operatorOrbit (A : Subalgebra 𝕜 (E →L[𝕜] E)) (x : E) :
    x ∈ A.operatorOrbit x := by
  exact (A.mem_operatorOrbit x x).mpr ⟨1, by simp⟩

/-- Operator orbits are invariant under all operators in the algebra. -/
theorem operatorOrbit_mem_invtSubmodule (A : Subalgebra 𝕜 (E →L[𝕜] E))
    (x : E) (a : A) :
    A.operatorOrbit x ∈ Module.End.invtSubmodule (a : E →L[𝕜] E).toLinearMap := by
  rw [Module.End.mem_invtSubmodule_iff_forall_mem_of_mem]
  intro y hy
  obtain ⟨b, rfl⟩ := (A.mem_operatorOrbit x y).mp hy
  exact (A.mem_operatorOrbit x _).mpr ⟨a * b, by simp⟩

/-- The closure of an operator orbit lies in a closed invariant subspace exactly when
that subspace contains the generating vector. -/
theorem operatorOrbit_topologicalClosure_le_iff (A : Subalgebra 𝕜 (E →L[𝕜] E))
    (x : E) (S : Submodule 𝕜 E) (hS : IsClosed (S : Set E))
    (hinv : ∀ a : A, S ∈ Module.End.invtSubmodule (a : E →L[𝕜] E).toLinearMap) :
    (A.operatorOrbit x).topologicalClosure ≤ S ↔ x ∈ S := by
  constructor
  · intro h
    exact h ((A.operatorOrbit x).le_topologicalClosure (A.self_mem_operatorOrbit x))
  · intro hx
    apply Submodule.topologicalClosure_minimal _ _ hS
    intro y hy
    obtain ⟨a, rfl⟩ := (A.mem_operatorOrbit x y).mp hy
    exact (Module.End.mem_invtSubmodule_iff_forall_mem_of_mem _).mp (hinv a) x hx

/-- A unital operator algebra is transitive when every nonzero vector has a dense orbit. -/
def IsTransitive (A : Subalgebra 𝕜 (E →L[𝕜] E)) : Prop :=
  ∀ x : E, x ≠ 0 → DenseRange (fun a : A ↦ (a : E →L[𝕜] E) x)

/-- Transitivity means that evaluation at each nonzero vector has dense range. -/
theorem isTransitive_iff (A : Subalgebra 𝕜 (E →L[𝕜] E)) :
    A.IsTransitive ↔ ∀ x : E, x ≠ 0 →
      DenseRange (fun a : A ↦ (a : E →L[𝕜] E) x) := (Iff.rfl)

/-- Transitivity is equivalent to density of every nonzero vector's operator orbit. -/
theorem isTransitive_iff_dense_operatorOrbit (A : Subalgebra 𝕜 (E →L[𝕜] E)) :
    A.IsTransitive ↔ ∀ x : E, x ≠ 0 → Dense (A.operatorOrbit x : Set E) := by
  simp only [isTransitive_iff, coe_operatorOrbit, DenseRange]

/-- Transitivity is equivalent to every nonzero vector having orbit closure equal to the
whole scalar space. -/
theorem isTransitive_iff_operatorOrbit_topologicalClosure (A : Subalgebra 𝕜 (E →L[𝕜] E)) :
    A.IsTransitive ↔ ∀ x : E, x ≠ 0 → (A.operatorOrbit x).topologicalClosure = ⊤ := by
  simp only [isTransitive_iff_dense_operatorOrbit,
    Submodule.dense_iff_topologicalClosure_eq_top]

/-- A unital operator algebra is transitive exactly when every closed invariant scalar
subspace is zero or the whole space. This includes the zero space. -/
theorem isTransitive_iff_forall_closed_invariant (A : Subalgebra 𝕜 (E →L[𝕜] E)) :
    A.IsTransitive ↔ ∀ S : Submodule 𝕜 E, IsClosed (S : Set E) →
      (∀ a : A, S ∈ Module.End.invtSubmodule (a : E →L[𝕜] E).toLinearMap) →
      S = ⊥ ∨ S = ⊤ := by
  rw [A.isTransitive_iff_operatorOrbit_topologicalClosure]
  constructor
  · intro h S hS hinv
    by_cases hbot : S = ⊥
    · exact Or.inl hbot
    · obtain ⟨x, hx, hx0⟩ := S.ne_bot_iff.mp hbot
      have hle := (A.operatorOrbit_topologicalClosure_le_iff x S hS hinv).mpr hx
      rw [h x hx0] at hle
      exact Or.inr (top_le_iff.mp hle)
  · intro h x hx
    have hinv (a : A) : (A.operatorOrbit x).topologicalClosure ∈
        Module.End.invtSubmodule (a : E →L[𝕜] E).toLinearMap :=
      Submodule.topologicalClosure_mem_invtSubmodule (A.operatorOrbit_mem_invtSubmodule x a)
    rcases h _ (A.operatorOrbit x).isClosed_topologicalClosure hinv with hbot | htop
    · have hxmem := (A.operatorOrbit x).le_topologicalClosure (A.self_mem_operatorOrbit x)
      rw [hbot, Submodule.mem_bot] at hxmem
      exact (hx hxmem).elim
    · exact htop

/-- Enlarging a transitive operator algebra preserves transitivity. -/
theorem IsTransitive.mono {A B : Subalgebra 𝕜 (E →L[𝕜] E)} (hA : A.IsTransitive)
    (hAB : A ≤ B) : B.IsTransitive := by
  intro x hx
  apply (hA x hx).mono
  rintro _ ⟨a, rfl⟩
  exact ⟨⟨a, hAB a.property⟩, rfl⟩

end TopologicalModule

variable {𝕜 E : Type*} [Field 𝕜] [TopologicalSpace 𝕜] [IsTopologicalRing 𝕜]
  [AddCommGroup E] [TopologicalSpace E] [Module 𝕜 E]
  [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E] [SeparatingDual 𝕜 E]

/-- Every nonzero vector is cyclic for the full continuous-operator algebra when the
continuous dual separates points. -/
theorem isTransitive_top :
    (⊤ : Subalgebra 𝕜 (E →L[𝕜] E)).IsTransitive := by
  intro x hx
  apply Function.Surjective.denseRange
  intro y
  obtain ⟨φ, hφ⟩ := SeparatingDual.exists_eq_one (R := 𝕜) hx
  exact ⟨⟨φ.smulRight y, by trivial⟩, by simp [hφ]⟩

end Subalgebra
