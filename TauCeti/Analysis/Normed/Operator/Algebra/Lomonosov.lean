/-!
# Lomonosov's invariant-subspace theorem

**Lomonosov's lemma** (`Subalgebra.IsTransitive.exists_apply_apply_eq_self`): if `A` is a
transitive unital algebra of continuous linear operators on a real or complex normed space and
`K` is a nonzero compact operator, then some `a ∈ A` and some nonzero `x` satisfy `a (K x) = x`.
Thus `a * K` is a compact operator with eigenvalue `1`, and its `1`-eigenspace is a nonzero
finite-dimensional subspace.

Two invariant-subspace theorems follow, each by a case split on whether a certain algebra is
transitive. If it is not, `Subalgebra.isTransitive_iff_forall_closed_invariant` directly supplies
a nonzero proper closed subspace invariant under the whole algebra. If it is, the lemma applies.

* `IsCompactOperator.exists_invariantSubspace_of_commute`: on an infinite-dimensional real or
  complex normed space, every operator commuting with a nonzero compact operator has a nonzero
  proper closed invariant subspace. The algebra is the one generated by the operator; when it is
  transitive, the `1`-eigenspace of `a * K` is the required subspace.
* `IsCompactOperator.exists_hyperinvariantSubspace_of_commute`: on a complex normed space, a
  nonscalar operator `T` commuting with a nonzero compact operator has a nonzero proper closed
  *hyperinvariant* subspace, one invariant under every operator commuting with `T`. The algebra
  is the commutant of `T`. When it is transitive, the restriction of `T` to the
  finite-dimensional `1`-eigenspace of `a * K` has an eigenvalue `μ`, and the full eigenspace
  `ker (T - μ)` of `T` in `E` is the required subspace. In particular every nonscalar compact
  operator has one (`IsCompactOperator.exists_hyperinvariantSubspace`).

No completeness of the space is needed: Schauder's theorem
(`TauCeti.schauderFixedPoint_closedConvex_continuousOn`) and the finite dimensionality of
nonzero eigenspaces of compact operators (`IsCompactOperator.finiteDimensional_eigenspace`)
both hold on normed spaces.

## Proof of the lemma

Choose `x₀` with `K x₀ ≠ 0` and a closed ball `B = closedBall x₀ ρ` on which `‖K x‖` stays
above `‖K x₀‖ / 2`. The closure `S` of `K '' B` is compact and avoids `0`, so by transitivity it
is covered by finitely many open sets `{y | a y ∈ ball x₀ ρ}`, `a ∈ A`. Averaging the `a (K x)`
with a partition of unity on `S` subordinate to this cover defines a continuous map of `B` into
itself whose image has compact closure. Its Schauder fixed point `x` is nonzero, and the
corresponding real combination of the chosen `a` lies in `A` and sends `K x` to `x`.

## References

* V. I. Lomonosov, *Invariant subspaces for the family of operators which commute with a
  completely continuous operator*, Functional Analysis and Its Applications 7 (1973), 213--214.
* J. B. Conway, *A Course in Functional Analysis*, second edition, Chapter VI.
-/

public section

open Metric Set Module End

namespace Subalgebra

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- The fixed-point step of Lomonosov's lemma: if finitely many operators `f i` send every point
of a compact set `S ⊇ K '' closedBall x₀ ρ` into `ball x₀ ρ`, then some `x` in the closed ball is
a real combination of the vectors `f i (K x)`. -/
private theorem exists_eq_sum_smul_apply_apply {ι : Type*} [Fintype ι] (f : ι → E →L[𝕜] E)
    {K : E →L[𝕜] E} (hK : Continuous K) {S : Set E} (hS : IsCompact S) {x₀ : E} {ρ : ℝ}
    (hρ : 0 ≤ ρ) (hKS : MapsTo K (closedBall x₀ ρ) S) (hcover : S ⊆ ⋃ i, f i ⁻¹' ball x₀ ρ) :
    ∃ x ∈ closedBall x₀ ρ, ∃ c : ι → ℝ, ∑ i, (c i : 𝕜) • f i (K x) = x := by
  let _ : NormedSpace ℝ E := NormedSpace.restrictScalars ℝ 𝕜 E
  have : IsScalarTower ℝ 𝕜 E := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  -- A partition of unity `w` on `S` subordinate to the cover averages the `f i` into a
  -- continuous self-map `Ψ` of the closed ball.
  obtain ⟨w, hw⟩ := PartitionOfUnity.exists_isSubordinate hS.isClosed
    (fun i ↦ f i ⁻¹' ball x₀ ρ) (fun i ↦ isOpen_ball.preimage (f i).continuous) hcover
  set Ψ : E → E := fun x ↦ ∑ᶠ i, w i (K x) • f i (K x)
  have hΨc : ContinuousOn Ψ (closedBall x₀ ρ) :=
    ((w.continuous_finsum_smul fun i _ _ ↦ (f i).continuous.continuousAt).comp hK).continuousOn
  have hΨB : MapsTo Ψ (closedBall x₀ ρ) (closedBall x₀ ρ) := fun x hx ↦
    w.finsum_smul_mem_convex (g := fun i y ↦ f i y) (hKS hx)
      (fun i hi ↦ ball_subset_closedBall (hw i (subset_tsupport _ hi))) (convex_closedBall x₀ ρ)
  -- The image of `Ψ` lies in the compact image of `[0, 1]^ι × S` under `F`.
  set F : (ι → ℝ) × E → E := fun p ↦ ∑ i, p.1 i • f i p.2
  have hΨK : IsCompact (closure (Ψ '' closedBall x₀ ρ)) := by
    have hcpt : IsCompact (F '' (univ.pi (fun _ : ι ↦ Icc (0 : ℝ) 1) ×ˢ S)) :=
      ((isCompact_univ_pi fun _ ↦ isCompact_Icc).prod hS).image (by fun_prop)
    refine hcpt.of_isClosed_subset isClosed_closure (closure_minimal ?_ hcpt.isClosed)
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨(fun i ↦ w i (K x), K x), ⟨fun i _ ↦ ⟨w.nonneg i _, w.le_one i _⟩, hKS hx⟩,
      (finsum_eq_sum_of_fintype _).symm⟩
  obtain ⟨x, hxB, hfix⟩ := TauCeti.schauderFixedPoint_closedConvex_continuousOn isClosed_closedBall
    (convex_closedBall x₀ ρ) (nonempty_closedBall.2 hρ) hΨc hΨB hΨK
  refine ⟨x, hxB, fun i ↦ w i (K x), ?_⟩
  calc ∑ i, (w i (K x) : 𝕜) • f i (K x) = Ψ x := by
        simp only [Ψ, finsum_eq_sum_of_fintype, RCLike.real_smul_eq_coe_smul (K := 𝕜)]
    _ = x := hfix

/-- **Lomonosov's lemma**: for a transitive unital algebra `A` of continuous linear operators on a
real or complex normed space and a nonzero compact operator `K`, some `a ∈ A` and some nonzero `x`
satisfy `a (K x) = x`. Thus `1` is an eigenvalue of the compact operator `a * K`. -/
theorem IsTransitive.exists_apply_apply_eq_self {A : Subalgebra 𝕜 (E →L[𝕜] E)}
    (hA : A.IsTransitive) {K : E →L[𝕜] E} (hK : IsCompactOperator K) (hK0 : K ≠ 0) :
    ∃ a ∈ A, ∃ x : E, x ≠ 0 ∧ a (K x) = x := by
  -- Choose a closed ball `B` on which `‖K x‖` is bounded below by `δ > 0`.
  obtain ⟨x₀, hx₀⟩ : ∃ x₀, K x₀ ≠ 0 := by
    by_contra! h
    exact hK0 (ContinuousLinearMap.ext h)
  set δ := ‖K x₀‖ / 2 with hδ
  have hδ0 : 0 < δ := half_pos (norm_pos_iff.2 hx₀)
  obtain ⟨ρ, hρ0, hlow⟩ := nhds_basis_closedBall.eventually_iff.1
    ((K.continuous.norm.tendsto x₀).eventually (lt_mem_nhds (half_lt_self (norm_pos_iff.2 hx₀))))
  -- The closure `S` of `K '' B` is compact and bounded away from `0`.
  set S := closure (K '' closedBall x₀ ρ)
  have hScpt : IsCompact S :=
    (hK.isCompact_closure_image_closedBall (‖x₀‖ + ρ)).of_isClosed_subset isClosed_closure
      (closure_mono (image_mono (closedBall_subset_closedBall' (by simp [add_comm]))))
  have hSlow : ∀ y ∈ S, δ ≤ ‖y‖ :=
    fun y hy ↦ closure_minimal (by rintro _ ⟨x, hx, rfl⟩; exact (hlow hx).le)
      (isClosed_le continuous_const continuous_norm) hy
  -- By transitivity and compactness, finitely many `a ∈ A`, indexed by `t`, send each point of
  -- `S` into `ball x₀ ρ`.
  have hcover : S ⊆ ⋃ a : A, (a : E →L[𝕜] E) ⁻¹' ball x₀ ρ := by
    intro y hy
    have hy0 : y ≠ 0 := by
      rintro rfl
      linarith [hSlow 0 hy, norm_zero (E := E)]
    obtain ⟨a, ha⟩ := (A.isTransitive_iff.1 hA y hy0).exists_dist_lt x₀ hρ0
    exact mem_iUnion.2 ⟨a, by rwa [mem_preimage, mem_ball, dist_comm]⟩
  obtain ⟨t, ht⟩ := hScpt.elim_finite_subcover (fun a : A ↦ (a : E →L[𝕜] E) ⁻¹' ball x₀ ρ)
    (fun a ↦ isOpen_ball.preimage (a : E →L[𝕜] E).continuous) hcover
  -- The fixed-point step gives `x` and a real combination `a` of the chosen operators.
  obtain ⟨x, hxB, c, hc⟩ := exists_eq_sum_smul_apply_apply (fun i : t ↦ ((i : A) : E →L[𝕜] E))
    K.continuous hScpt hρ0.le (fun x hx ↦ subset_closure (mem_image_of_mem K hx))
    (fun y hy ↦ by
      obtain ⟨a, ha, hya⟩ := mem_iUnion₂.1 (ht hy)
      exact mem_iUnion.2 ⟨⟨a, ha⟩, hya⟩)
  refine ⟨∑ i : t, (c i : 𝕜) • ((i : A) : E →L[𝕜] E),
    A.sum_mem fun i _ ↦ A.smul_mem (i : A).2 _, x, ?_, ?_⟩
  · rintro rfl
    have h := hlow hxB
    rw [map_zero, norm_zero] at h
    linarith
  · simpa only [FunLike.coe_sum, Finset.sum_apply, FunLike.coe_smul, Pi.smul_apply] using hc

end Subalgebra

namespace IsCompactOperator

section RCLike

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- The eigenspace step shared by Lomonosov's invariant-subspace theorems: if `A` is transitive,
`K` is a nonzero compact operator and `T` commutes with `K` and with every element of `A`, then
for some `a ∈ A` the `1`-eigenspace of `a * K` is a nonzero finite-dimensional `T`-invariant
subspace. -/
private theorem exists_eigenspace_mul_ne_bot {A : Subalgebra 𝕜 (E →L[𝕜] E)} (hA : A.IsTransitive)
    {K T : E →L[𝕜] E} (hK : IsCompactOperator K) (hK0 : K ≠ 0) (hTK : Commute T K)
    (hTA : ∀ a ∈ A, Commute T a) :
    ∃ a ∈ A, eigenspace (a * K).toLinearMap 1 ≠ ⊥ ∧
      FiniteDimensional 𝕜 (eigenspace (a * K).toLinearMap 1) ∧
      eigenspace (a * K).toLinearMap 1 ∈ invtSubmodule T.toLinearMap := by
  obtain ⟨a, ha, x, hx0, hx⟩ := hA.exists_apply_apply_eq_self hK hK0
  refine ⟨a, ha, (Submodule.ne_bot_iff _).2 ⟨x, mem_eigenspace_iff.2 (by simpa using hx), hx0⟩,
    (hK.clm_comp a).finiteDimensional_eigenspace one_ne_zero, ?_⟩
  rw [mem_invtSubmodule_iff_mapsTo]
  exact mapsTo_genEigenspace_of_comm
    (((hTA a ha).mul_right hTK).symm.map ContinuousLinearMap.toLinearMapRingHom) 1 1

/-- **Lomonosov's invariant-subspace theorem** for a single operator: on an infinite-dimensional
real or complex normed space, an operator `T` commuting with a nonzero compact operator `K` has a
nonzero proper closed invariant subspace. -/
theorem exists_invariantSubspace_of_commute {K T : E →L[𝕜] E} (hK : IsCompactOperator K)
    (hK0 : K ≠ 0) (hTK : Commute T K) (hE : ¬FiniteDimensional 𝕜 E) :
    ∃ M : Submodule 𝕜 E, IsClosed (M : Set E) ∧ M ≠ ⊥ ∧ M ≠ ⊤ ∧
      M ∈ invtSubmodule T.toLinearMap := by
  by_cases hA : (Algebra.adjoin 𝕜 {T}).IsTransitive
  · -- The `1`-eigenspace of `a * K` is nonzero and invariant, and it is proper because it is
    -- finite dimensional.
    obtain ⟨a, -, hne, hfin, hinv⟩ := exists_eigenspace_mul_ne_bot hA hK hK0 hTK
      fun _ ha ↦ Algebra.commute_of_mem_adjoin_self ha
    refine ⟨_, ContinuousLinearMap.isClosed_eigenspace _ _, hne, fun htop ↦ ?_, hinv⟩
    rw [htop] at hfin
    exact hE Submodule.topEquiv.finiteDimensional
  · rw [Subalgebra.isTransitive_iff_forall_closed_invariant] at hA
    push Not at hA
    obtain ⟨M, hMc, hinv, hbot, htop⟩ := hA
    exact ⟨M, hMc, hbot, htop, hinv ⟨T, Algebra.self_mem_adjoin_singleton 𝕜 T⟩⟩

end RCLike

section Complex

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- **Lomonosov's theorem**: a nonscalar operator `T` on a complex normed space commuting with a
nonzero compact operator `K` has a nonzero proper closed hyperinvariant subspace, that is, a
subspace invariant under every operator commuting with `T`. -/
theorem exists_hyperinvariantSubspace_of_commute {K T : E →L[ℂ] E} (hK : IsCompactOperator K)
    (hK0 : K ≠ 0) (hTK : Commute T K) (hT : ∀ c : ℂ, T ≠ c • 1) :
    ∃ M : Submodule ℂ E, IsClosed (M : Set E) ∧ M ≠ ⊥ ∧ M ≠ ⊤ ∧
      ∀ S : E →L[ℂ] E, Commute S T → M ∈ invtSubmodule S.toLinearMap := by
  have hmem (S : E →L[ℂ] E) : S ∈ Subalgebra.centralizer ℂ {T} ↔ Commute S T := by
    simp [Subalgebra.mem_centralizer_iff, Commute, SemiconjBy, eq_comm]
  by_cases hA : (Subalgebra.centralizer ℂ {T}).IsTransitive
  · -- `T` leaves invariant a nonzero finite-dimensional subspace `V`, so it has an eigenvalue `μ`
    -- there; the `μ`-eigenspace of `T` is the required subspace.
    obtain ⟨a, -, hne, hfin, hinv⟩ := exists_eigenspace_mul_ne_bot hA hK hK0 hTK
      fun S hS ↦ ((hmem S).1 hS).symm
    set V := eigenspace (a * K).toLinearMap 1
    have : Nontrivial V := Submodule.nontrivial_iff_ne_bot.2 hne
    obtain ⟨μ, hμ⟩ :=
      exists_eigenvalue (T.toLinearMap.restrict ((mem_invtSubmodule_iff_mapsTo _).1 hinv))
    obtain ⟨v, hv⟩ := hμ.exists_hasEigenvector
    have hv0 : (v : E) ≠ 0 := fun h ↦ hv.2 (Subtype.ext h)
    have hTv : T v = μ • (v : E) := congrArg Subtype.val (mem_eigenspace_iff.1 hv.1)
    refine ⟨eigenspace T.toLinearMap μ, ContinuousLinearMap.isClosed_eigenspace _ _, ?_, ?_,
      fun S hS ↦ ?_⟩
    · exact (Submodule.ne_bot_iff _).2 ⟨v, mem_eigenspace_iff.2 hTv, hv0⟩
    · intro htop
      refine hT μ (ContinuousLinearMap.ext fun y ↦ ?_)
      have hy : y ∈ eigenspace T.toLinearMap μ := htop ▸ Submodule.mem_top
      simpa using mem_eigenspace_iff.1 hy
    · rw [mem_invtSubmodule_iff_mapsTo]
      exact mapsTo_genEigenspace_of_comm (hS.symm.map ContinuousLinearMap.toLinearMapRingHom) μ 1
  · rw [Subalgebra.isTransitive_iff_forall_closed_invariant] at hA
    push Not at hA
    obtain ⟨M, hMc, hinv, hbot, htop⟩ := hA
    exact ⟨M, hMc, hbot, htop, fun S hS ↦ hinv ⟨S, (hmem S).2 hS⟩⟩

/-- **Lomonosov's theorem for compact operators**: every nonscalar compact operator on a complex
normed space has a nonzero proper closed hyperinvariant subspace. This strengthens the
Aronszajn–Smith invariant-subspace theorem for compact operators. -/
theorem exists_hyperinvariantSubspace {T : E →L[ℂ] E} (hT : IsCompactOperator T)
    (hTs : ∀ c : ℂ, T ≠ c • 1) :
    ∃ M : Submodule ℂ E, IsClosed (M : Set E) ∧ M ≠ ⊥ ∧ M ≠ ⊤ ∧
      ∀ S : E →L[ℂ] E, Commute S T → M ∈ invtSubmodule S.toLinearMap :=
  hT.exists_hyperinvariantSubspace_of_commute (fun h ↦ hTs 0 (by simp [h])) (.refl T) hTs

end Complex

end IsCompactOperator
