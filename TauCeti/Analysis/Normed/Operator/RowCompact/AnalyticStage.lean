module

public import TauCeti.Analysis.Normed.Operator.RowCompact
public import TauCeti.NumberTheory.Padics.Distribution.AnalyticStage

/-!
# Raising the level of analytic stages is compact

The analytic stage `LA_h(E) = C₀(ZMod (pʰ) × ℕ, E)` records a function on `ℤ_p` that is analytic
on each disc `a + pʰℤ_p` by its coefficients `c(a, n)` in the disc coordinate `w`. Raising the
level to `h + 1` (`TauCeti.AnalyticStage.transition`) re-expands each of these series on the `p`
smaller discs, in the coordinate `v` with `w = b + p v`. A series in `w` converging on the unit
disc is restricted at radius `‖p‖⁻¹ > 1` in `v`, so the coefficient of `vʲ` has norm at most
`‖p‖ʲ ‖c‖` (`TauCeti.AnalyticStage.norm_transition_apply_le`). This is an improvement of radius,
and it makes the transition compact.

With scalar coefficients, `E = R`, the transition is a map between model spaces whose row of
index `(a', j)` is bounded by `‖p‖ʲ ‖1‖`
(`TauCeti.AnalyticStage.norm_matrixCoeff_transition_le`). These bounds tend to zero, so the
transition is row compact (`TauCeti.AnalyticStage.isRowCompact_transition`), and so are the
multi-level transitions `LA_h(R) → LA_k(R)` with `h < k`
(`TauCeti.AnalyticStage.isRowCompact_transitionLE`).

With coefficients in a Banach module `E` over `R`, truncating the coefficients of `vʲ` at
`j < N` approximates the transition within `‖p‖ᴺ`. If `E` is a finitely generated `R`-module,
these truncations have finite rank, so the transition is completely continuous
(`TauCeti.AnalyticStage.isCompletelyContinuous_transition`). Evaluation
`LA_h(E) → C(ℤ_p, E)` factors through the transition, so it is completely continuous as well.
Over Tate scalars finite generation is also necessary, for evaluation and for every transition
`LA_h(E) → LA_k(E)` with `h < k`
(`TauCeti.AnalyticStage.isCompletelyContinuous_eval_iff`,
`TauCeti.AnalyticStage.isCompletelyContinuous_transition_iff`,
`TauCeti.AnalyticStage.isCompletelyContinuous_transitionLE_iff`). Indeed, sending `e ∈ E` to
the constant function `e` on the disc of `0`, evaluating, and taking the value at `0` is the
identity of `E`. So complete continuity of evaluation makes the identity of `E` completely
continuous, and `E` is finitely generated by the identity criterion
`ContinuousLinearMap.isCompletelyContinuous_id_iff`. Thus an infinite-dimensional Banach space
of coefficients is excluded: its constant functions keep its identity operator.

## Main results

* `TauCeti.AnalyticStage.isRowCompact_transition`,
  `TauCeti.AnalyticStage.isRowCompact_transitionLE`: with scalar coefficients, raising the level
  is row compact.
* `TauCeti.AnalyticStage.isCompletelyContinuous_transition`: raising the level is completely
  continuous for finitely generated coefficients.
* `TauCeti.AnalyticStage.isCompletelyContinuous_transition_iff`,
  `TauCeti.AnalyticStage.isCompletelyContinuous_transitionLE_iff`,
  `TauCeti.AnalyticStage.isCompletelyContinuous_eval_iff`: over Tate scalars, raising the level
  and evaluation are completely continuous exactly for finitely generated coefficients.

## References

* J.-P. Serre, *Endomorphismes complètement continus des espaces de Banach p-adiques*,
  Publ. Math. IHÉS **12** (1962), 69–85, §§2–3.
* P. Colmez, *Fonctions d'une variable p-adique*, Astérisque 330 (2010), §I.4.
-/

public section

open Filter Topology ZeroAtInftyContinuousMap
open scoped ZeroAtInfty

variable {p : ℕ} [hp : Fact p.Prime]

namespace TauCeti

namespace AnalyticStage

variable {h k : ℕ} {R E : Type*} [NormedAddCommGroup E] [Module ℤ_[p] E] [IsBoundedSMul ℤ_[p] E]
  [IsUltrametricDist E] [CompleteSpace E]

section Ring

variable [Ring R] [Module R E] [ContinuousConstSMul R E] [SMulCommClass ℤ_[p] R E]

/-- **Raising the level is completely continuous for finitely generated coefficients.** The
coordinate projections onto the coefficients of `vʲ` with `j < N` have finite rank and
approximate the transition within `‖p‖ᴺ`. -/
theorem isCompletelyContinuous_transition [Module.Finite R E] :
    (transition (p := p) (h := h) (E := E) R).IsCompletelyContinuous := by
  refine ContinuousLinearMap.isCompletelyContinuous_iff.2 fun ε hε ↦ ?_
  obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one hε (PadicInt.norm_p_lt_one (p := p))
  let s : Finset (ZMod (p ^ (h + 1)) × ℕ) := Finset.univ ×ˢ Finset.range N
  refine ⟨(indicatorCLM R (s : Set _)).comp (transition R),
    (isFiniteRank_indicatorCLM s).comp_right _, fun c ↦ (norm_le (by positivity)).2 fun i ↦ ?_⟩
  rw [coe_sub, Pi.sub_apply, ContinuousLinearMap.comp_apply, coe_indicatorCLM]
  by_cases hi : i ∈ (s : Set (ZMod (p ^ (h + 1)) × ℕ))
  · rw [Set.indicator_of_mem hi, sub_self, norm_zero]
    positivity
  · have hNi : N ≤ i.2 := by simpa [s] using hi
    rw [Set.indicator_of_notMem hi, sub_zero]
    calc ‖transition R c i‖ ≤ ‖(p : ℤ_[p])‖ ^ i.2 * ‖c‖ := norm_transition_apply_le R c i.1 i.2
      _ ≤ ‖(p : ℤ_[p])‖ ^ N * ‖c‖ := by
          gcongr ?_ * _
          exact pow_le_pow_of_le_one (norm_nonneg _) PadicInt.norm_p_lt_one.le hNi
      _ ≤ ε * ‖c‖ := by gcongr

end Ring

section Tate

variable [SeminormedRing R] [Module R E] [IsBoundedSMul R E] [SMulCommClass ℤ_[p] R E]

/-- Evaluation at `0` of the constant function `e` on the disc of `0`, whose coefficient vector
is `single (0, 0) e`, is `e`. -/
private theorem eval_single_zero (e : E) :
    eval R (single ((0 : ZMod (p ^ h)), 0) e) 0 = e := by
  have h0 := eval_natCast_val_add_mul (p := p) R (single ((0 : ZMod (p ^ h)), 0) e) 0 0
  simp only [ZMod.val_zero, Nat.cast_zero, mul_zero, add_zero] at h0
  rw [h0, tsum_eq_single 0 fun n hn ↦ by simp [zero_pow hn]]
  simp

variable [NormedRing.IsTate R]

/-- Over Tate scalars, evaluation `LA_h(E) → C(ℤ_p, E)` is completely continuous exactly when `E`
is a finitely generated `R`-module. -/
theorem isCompletelyContinuous_eval_iff :
    (eval R : AnalyticStage p h E →L[R] C(ℤ_[p], E)).IsCompletelyContinuous ↔
      Module.Finite R E := by
  refine ⟨fun hT ↦ ?_, fun _ ↦ ?_⟩
  · have hid : (ContinuousMap.evalCLM R 0).comp
        ((eval (p := p) (h := h) R).comp (singleCLM R (0, 0))) = ContinuousLinearMap.id R E := by
      ext e
      simpa using eval_single_zero (p := p) (R := R) e
    rw [← ContinuousLinearMap.isCompletelyContinuous_id_iff, ← hid]
    exact (hT.comp_clm _).clm_comp _
  · rw [← eval_comp_transition]
    exact isCompletelyContinuous_transition.clm_comp _

/-- Over Tate scalars, raising the level `LA_h(E) → LA_{h+1}(E)` is completely continuous exactly
when `E` is a finitely generated `R`-module. -/
theorem isCompletelyContinuous_transition_iff :
    (transition R : AnalyticStage p h E →L[R] AnalyticStage p (h + 1) E).IsCompletelyContinuous ↔
      Module.Finite R E := by
  refine ⟨fun hT ↦ (isCompletelyContinuous_eval_iff (p := p) (h := h)).1 ?_,
    fun _ ↦ isCompletelyContinuous_transition⟩
  rw [← eval_comp_transition]
  exact hT.clm_comp _

/-- Over Tate scalars, raising the level `LA_h(E) → LA_k(E)` with `h < k` is completely continuous
exactly when `E` is a finitely generated `R`-module. -/
theorem isCompletelyContinuous_transitionLE_iff (hhk : h < k) :
    (transitionLE R hhk.le : AnalyticStage p h E →L[R] AnalyticStage p k E).IsCompletelyContinuous ↔
      Module.Finite R E := by
  refine ⟨fun hT ↦ (isCompletelyContinuous_eval_iff (p := p) (h := h)).1 ?_, fun _ ↦ ?_⟩
  · rw [← eval_comp_transitionLE R hhk.le]
    exact hT.clm_comp _
  · rw [← transitionLE_comp_transition R hhk]
    exact isCompletelyContinuous_transition.clm_comp _

end Tate

section Scalar

variable [NormedRing R] [Module ℤ_[p] R] [IsBoundedSMul ℤ_[p] R] [SMulCommClass ℤ_[p] R R]
  [IsUltrametricDist R] [CompleteSpace R]

/-- With scalar coefficients, the row of index `(a', j)` of the matrix of the transition is bounded
by `‖p‖ʲ ‖1‖`. -/
theorem norm_matrixCoeff_transition_le (i : ZMod (p ^ (h + 1)) × ℕ) (j : ZMod (p ^ h) × ℕ) :
    ‖(transition R : AnalyticStage p h R →L[R] AnalyticStage p (h + 1) R).matrixCoeff i j‖ ≤
      ‖(p : ℤ_[p])‖ ^ i.2 * ‖(1 : R)‖ := by
  rw [ContinuousLinearMap.matrixCoeff_apply, ← norm_single j (1 : R)]
  exact norm_transition_apply_le R _ i.1 i.2

/-- **Raising the level is row compact.** With scalar coefficients, the transition
`LA_h(R) → LA_{h+1}(R)` is a row-compact map between model spaces. -/
theorem isRowCompact_transition :
    (transition R : AnalyticStage p h R →L[R] AnalyticStage p (h + 1) R).IsRowCompact :=
  ContinuousLinearMap.isRowCompact_of_norm_matrixCoeff_le (tendsto_norm_pow_mul_cofinite _)
    norm_matrixCoeff_transition_le

/-- With scalar coefficients in an ultrametric Tate ring, raising the level
`LA_h(R) → LA_k(R)` with `h < k` is row compact. -/
theorem isRowCompact_transitionLE {R : Type*} [NormedCommRing R] [NormedRing.IsTate R]
    [Module ℤ_[p] R] [IsBoundedSMul ℤ_[p] R] [SMulCommClass ℤ_[p] R R] [IsUltrametricDist R]
    [CompleteSpace R] (hhk : h < k) :
    (transitionLE R hhk.le : AnalyticStage p h R →L[R] AnalyticStage p k R).IsRowCompact := by
  rw [← transitionLE_comp_transition R hhk]
  exact isRowCompact_transition.clm_comp _

end Scalar

end AnalyticStage

end TauCeti
