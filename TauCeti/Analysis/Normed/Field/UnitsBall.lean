module

public import TauCeti.Analysis.Normed.Field.RootsOfUnity

/-!
# Units near one in an ultrametric normed field

In an ultrametric normed field `K`, the units at distance less than `r` from one form a subgroup
of `Kˣ` whenever `0 < r ≤ 1`. Such units have norm one, so the ultrametric inequality applied to
`u v - 1 = u (v - 1) + (u - 1)` and to `u⁻¹ - 1 = -u⁻¹ (u - 1)` keeps products and inverses
within distance `r` of one.

If a prime `p` has norm less than one and `r ^ (p - 1) ≤ ‖p‖`, this subgroup is torsion free,
since by `IsOfFinOrder.eq_one_of_norm_sub_one_pow_lt` it contains no root of unity other than
one. Over `ℚ_[p]` and its extensions, where `‖p‖ = p⁻¹`, the largest such radius is
`p ^ (-1 / (p - 1))`: at `p = 2` the root of unity `-1` lies at distance exactly `1 / 2` from one,
so the open ball cannot be replaced by the closed one. A group generated by elements this close
to one is therefore torsion free; this is how congruence conditions at one prime force neatness
(see Milne, *Introduction to Shimura varieties*, §3, Proposition 3.5).

For a nonarchimedean local field the analogous statement on the unit filtration is
`TauCeti.disjoint_rootsOfUnity_unitFiltration`, measured by the discrete normalized valuation.
The norm form here needs no discreteness, so it applies over an algebraic closure of `ℚ_[p]` and
over `ℂ_[p]`, where the eigenvalues of `p`-adic matrices live.

## Main definitions

* `TauCeti.unitsBallSubgroup K hr₀ hr₁`: the subgroup of units `u` with `‖u - 1‖ < r`.

## Main results

* `TauCeti.mem_unitsBallSubgroup`: membership is the distance condition.
* `TauCeti.isMulTorsionFree_unitsBallSubgroup`: if `‖p‖ < 1` and `r ^ (p - 1) ≤ ‖p‖`, the
  subgroup is torsion free.
-/

public section

namespace TauCeti

variable (K : Type*) [NormedField K] [IsUltrametricDist K]

/-- The units of an ultrametric normed field at distance less than `r` from one, a subgroup of
`Kˣ` for `0 < r ≤ 1`. -/
def unitsBallSubgroup {r : ℝ} (hr₀ : 0 < r) (hr₁ : r ≤ 1) : Subgroup Kˣ where
  carrier := {u | ‖(u : K) - 1‖ < r}
  mul_mem' {u v} hu hv := by
    simpa using norm_mul_sub_one_lt hr₁ hu hv
  one_mem' := by simpa using hr₀
  inv_mem' {u} hu := by
    simpa [norm_inv_sub_one_eq (hu.trans_le hr₁)] using hu

variable {K}

/-- A unit lies in `unitsBallSubgroup K hr₀ hr₁` exactly when its distance from one is less
than `r`. -/
@[simp]
theorem mem_unitsBallSubgroup {r : ℝ} {hr₀ : 0 < r} {hr₁ : r ≤ 1} {u : Kˣ} :
    u ∈ unitsBallSubgroup K hr₀ hr₁ ↔ ‖(u : K) - 1‖ < r :=
  Iff.rfl

/-- **Units near one are torsion free.** If a prime `p` has norm less than one and
`r ^ (p - 1) ≤ ‖p‖`, the units within distance `r` of one form a torsion-free group. -/
theorem isMulTorsionFree_unitsBallSubgroup {p : ℕ} (hp : p.Prime) (hpK : ‖(p : K)‖ < 1)
    {r : ℝ} (hr₀ : 0 < r) (hr₁ : r ≤ 1) (hr : r ^ (p - 1) ≤ ‖(p : K)‖) :
    IsMulTorsionFree (unitsBallSubgroup K hr₀ hr₁) := by
  refine .of_not_isOfFinOrder fun u hu₁ hu ↦ hu₁ ?_
  have hfin : IsOfFinOrder ((u : Kˣ) : K) :=
    Units.isOfFinOrder_val.2 ((unitsBallSubgroup K hr₀ hr₁).subtype.isOfFinOrder hu)
  have hdist : ‖((u : Kˣ) : K) - 1‖ ^ (p - 1) < ‖(p : K)‖ :=
    (pow_lt_pow_left₀ (mem_unitsBallSubgroup.1 u.property) (norm_nonneg _)
      (Nat.sub_ne_zero_of_lt hp.one_lt)).trans_le hr
  exact Subtype.ext (Units.ext (hfin.eq_one_of_norm_sub_one_pow_lt hp hpK hdist))

end TauCeti
