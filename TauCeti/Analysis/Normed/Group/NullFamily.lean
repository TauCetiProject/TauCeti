module

public import Mathlib.Analysis.Normed.Group.Ultra
public import TauCeti.Topology.Order.OrderClosed

/-!
# Norm estimates for null families in ultrametric groups

A family tending to one along the cofinite filter in a seminormed group, or to zero in a
seminormed additive group, is bounded. On a nonempty index type its largest norm is attained,
including when every term has norm zero. This turns the non-strict ultrametric bound for infinite
products and sums into two useful sharp statements.

For a family `f` with sum `a` in a seminormed ultrametric additive group,
`HasSum.norm_lt_of_forall_norm_lt` shows that if every term has norm strictly less than a positive
bound `B`, then `‖a‖ < B`. The strict bound includes empty families and families whose terms all
have norm zero. The result `HasSum.norm_eq_of_forall_norm_lt` says that if one term has norm
strictly larger than every other term, then `a` has exactly the norm of that dominant term. Both
estimates apply to every `HasSum` limit without completeness or Hausdorff assumptions. Following
Mathlib's ultrametric norm estimates, every result is stated for multiplicative groups and
products, with the additive version generated by `to_additive`.

Mathlib supplies the finite-product estimate
`IsUltrametricDist.norm_prod_le_of_forall_le_of_nonneg` and the term-removal identity
`hasProd_ite_div_hasProd`. The results here extend finite-product bounds to strict bounds and
dominant-term equalities for `HasProd` limits.
-/

public section

open Filter
open scoped Topology

variable {ι E : Type*}

section SeminormedGroup

variable [SeminormedGroup E]

/-- A family on a nonempty index type tending to one along the cofinite filter has a term whose
norm dominates the norms of all its terms. -/
@[to_additive Filter.Tendsto.exists_forall_norm_le /-- A family on a nonempty index type tending
to zero along the cofinite filter has a term whose norm dominates the norms of all its terms. -/]
theorem Filter.Tendsto.exists_forall_norm_le' [Nonempty ι] {f : ι → E}
    (hf : Tendsto f cofinite (𝓝 1)) : ∃ i, ∀ j, ‖f j‖ ≤ ‖f i‖ := by
  obtain ⟨i⟩ := ‹Nonempty ι›
  have hnorm : Tendsto (fun i ↦ ‖f i‖) cofinite (𝓝 0) := by
    simpa only [norm_one'] using hf.norm'
  exact hnorm.exists_forall_le_of_le (a := i) (norm_nonneg' _)

/-- A family on a nonempty index type tending to one along the cofinite filter attains the
supremum of the norms of its terms. -/
@[to_additive Filter.Tendsto.exists_norm_eq_ciSup /-- A family on a nonempty index type tending
to zero along the cofinite filter attains the supremum of the norms of its terms. -/]
theorem Filter.Tendsto.exists_norm_eq_ciSup' [Nonempty ι] {f : ι → E}
    (hf : Tendsto f cofinite (𝓝 1)) : ∃ i, ‖f i‖ = ⨆ j, ‖f j‖ := by
  obtain ⟨i, hi⟩ := hf.exists_forall_norm_le'
  exact ⟨i, le_antisymm (le_ciSup hf.norm'.bddAbove_range_of_cofinite i) (ciSup_le hi)⟩

end SeminormedGroup

section SeminormedCommGroup

variable [SeminormedCommGroup E] [IsUltrametricDist E] {f : ι → E} {a : E}

/-- In an ultrametric group, any product of a family whose terms all have norm strictly less than
a positive bound `B` also has norm strictly less than `B`.

This includes empty families and families whose terms all have norm zero. -/
@[to_additive /-- In an ultrametric additive group, any sum of a family whose terms all have norm
strictly less than a positive bound `B` also has norm strictly less than `B`.

This includes empty families and families whose terms all have norm zero. -/]
theorem HasProd.norm_lt_of_forall_norm_lt (hf : HasProd f a) {B : ℝ} (hB : 0 < B)
    (h : ∀ i, ‖f i‖ < B) : ‖a‖ < B := by
  -- a nonnegative bound `C < B` on all the terms: `0` if there are none, else the largest norm
  obtain ⟨C, hC₀, hCB, hC⟩ : ∃ C, 0 ≤ C ∧ C < B ∧ ∀ i, ‖f i‖ ≤ C := by
    cases isEmpty_or_nonempty ι
    · exact ⟨0, le_rfl, hB, isEmptyElim⟩
    · obtain ⟨i, hi⟩ := hf.multipliable.tendsto_cofinite_one.exists_forall_norm_le'
      exact ⟨‖f i‖, norm_nonneg' _, h i, hi⟩
  exact (le_of_tendsto' hf.norm' fun s ↦
    IsUltrametricDist.norm_prod_le_of_forall_le_of_nonneg hC₀ fun i _ ↦ hC i).trans_lt hCB

/-- In an ultrametric group, any product of a family with a unique dominant term has the same norm
as that term. Every other term must have strictly smaller norm than the distinguished term. -/
@[to_additive /-- In an ultrametric additive group, any sum of a family with a unique dominant term
has the same norm as that term. Every other term must have strictly smaller norm than the
distinguished term. -/]
theorem HasProd.norm_eq_of_forall_norm_lt (hf : HasProd f a) (i : ι)
    (hi : ∀ j, j ≠ i → ‖f j‖ < ‖f i‖) : ‖a‖ = ‖f i‖ := by
  classical
  rcases (norm_nonneg' (f i)).eq_or_lt with hfi | hfi
  · -- every term has norm zero, hence so does the product
    have hle (j : ι) : ‖f j‖ ≤ 0 := by
      rcases eq_or_ne j i with rfl | hji
      exacts [hfi.ge, (hi j hji).le.trans_eq hfi.symm]
    rw [← hfi]
    exact (le_of_tendsto' hf.norm' fun s ↦
      IsUltrametricDist.norm_prod_le_of_forall_le_of_nonneg le_rfl fun j _ ↦ hle j).antisymm
        (norm_nonneg' _)
  · -- removing the dominant term leaves a product of strictly smaller norm
    have hlt : ‖a / f i‖ < ‖f i‖ :=
      (hasProd_ite_div_hasProd hf i).norm_lt_of_forall_norm_lt hfi fun j ↦ by
        split_ifs with hji
        exacts [norm_one'.trans_lt hfi, hi j hji]
    calc
      ‖a‖ = ‖a / f i * f i‖ := by rw [div_mul_cancel]
      _ = ‖f i‖ := by
        rw [IsUltrametricDist.norm_mul_eq_max_of_norm_ne_norm hlt.ne, max_eq_right hlt.le]

end SeminormedCommGroup
