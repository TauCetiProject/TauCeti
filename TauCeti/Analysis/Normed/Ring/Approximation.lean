/-!
# Generating an ideal by successive approximation

In a complete normed ring, let `F` be a finite subset and `S` a set. If every element `y` of
`S` can be approximated by a combination of `F` up to an error of at most `ε ‖y‖`, for a fixed
`ε < 1`, with coefficients bounded in terms of `‖y‖` and with the error again in `S`, then `S` lies
in the left ideal generated by `F` (`TauCeti.subset_idealSpan_of_approx`). Iterating the
approximation on the errors gives convergent coefficient series. Taking for `S` a left ideal
containing `F`, whose errors automatically stay in `S`, this is how Gröbner-type arguments prove
that ideals of complete normed rings are finitely generated, as in Kedlaya's proof that rings of
restricted power series over a Euclidean normed ring are noetherian. Taking for `S` a set that is
not an ideal is how Kedlaya obtains Euclidean division from a division whose remainder is either of
smaller degree or smaller by a uniform factor.

When the norm is ultrametric, the bound `‖b x‖ * ‖x‖ ≤ ‖y‖` on the coefficients of a single
approximation survives the iteration: every approximated `y` is exactly a combination
`∑ x ∈ F, a x * x` with `‖a x‖ * ‖x‖ ≤ ‖y‖` (`TauCeti.exists_eq_sum_mul_of_approx`). This gives
strict generating systems of ideals of Tate algebras.

## References

* K. S. Kedlaya, *Noetherian properties of Fargues–Fontaine curves*, IMRN 2016, no. 8,
  2544–2567; arXiv:1410.5160v3, Proposition 2.9 and Lemma 3.9.
-/

public section

open Filter Topology

/-- Iterating the approximation on the errors writes `y` as a combination of `F` whose
coefficients are convergent series with geometrically decreasing terms. -/
private theorem exists_eq_sum_tsum_of_approx {A : Type*} [NormedRing A] [CompleteSpace A]
    {S : Set A} {F : Finset A} {ε : ℝ} (hε1 : ε < 1)
    (happrox : ∀ y ∈ S, ∃ b : A → A, (∀ x ∈ F, ‖b x‖ * ‖x‖ ≤ ‖y‖) ∧
      y - ∑ x ∈ F, b x * x ∈ S ∧ ‖y - ∑ x ∈ F, b x * x‖ ≤ ε * ‖y‖) {y : A} (hy : y ∈ S) :
    ∃ b : ℕ → A → A, (∀ n, ∀ x ∈ F, ‖b n x‖ * ‖x‖ ≤ max ε 0 ^ n * ‖y‖) ∧
      y = ∑ x ∈ F, (∑' n, b n x) * x := by
  choose! b hb using happrox
  -- A negative `ε` only makes the approximation better, so we work with `ε' = max ε 0`.
  set ε' := max ε 0
  have hε'0 : 0 ≤ ε' := le_max_right ε 0
  have hε'1 : ε' < 1 := max_lt hε1 one_pos
  -- Iterating the approximation gives remainders `s n ∈ S` with `‖s n‖ ≤ ε'ⁿ ‖y‖`.
  let s : ℕ → A := fun n ↦ Nat.rec y (fun _ y' ↦ y' - ∑ x ∈ F, b y' x * x) n
  have hs_succ (n : ℕ) : s (n + 1) = s n - ∑ x ∈ F, b (s n) x * x := rfl
  have hsS (n : ℕ) : s n ∈ S := by
    induction n with
    | zero => exact hy
    | succ n ih => exact hs_succ n ▸ (hb (s n) ih).2.1
  have hs (n : ℕ) : ‖s n‖ ≤ ε' ^ n * ‖y‖ := by
    induction n with
    | zero => simp [s]
    | succ n ih =>
      rw [hs_succ, pow_succ', mul_assoc]
      exact (hb (s n) (hsS n)).2.2.trans <|
        mul_le_mul (le_max_left ε 0) ih (norm_nonneg _) hε'0
  have hbs (n : ℕ) (x : A) (hx : x ∈ F) : ‖b (s n) x‖ * ‖x‖ ≤ ε' ^ n * ‖y‖ :=
    ((hb (s n) (hsS n)).1 x hx).trans (hs n)
  refine ⟨fun n ↦ b (s n), hbs, ?_⟩
  -- For `x ≠ 0` in `F` the coefficients of `x` are summable, by comparison with a geometric
  -- series.
  have hhas : HasSum (fun n ↦ ∑ x ∈ F, b (s n) x * x) (∑ x ∈ F, (∑' n, b (s n) x) * x) := by
    refine hasSum_sum fun x hx ↦ ?_
    rcases eq_or_ne x 0 with rfl | hx0
    · simp
    have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx0
    refine (Summable.of_norm_bounded
      (((summable_geometric_of_lt_one hε'0 hε'1).mul_right ‖y‖).div_const ‖x‖) fun n ↦ ?_).hasSum
        |>.mul_right x
    rw [le_div_iff₀ hxpos]
    exact hbs n x hx
  -- The partial sums are `y - s N`, which tend to `y`.
  have hpartial : Tendsto (fun N ↦ ∑ n ∈ Finset.range N, ∑ x ∈ F, b (s n) x * x) atTop (𝓝 y) := by
    have hterm (n : ℕ) : ∑ x ∈ F, b (s n) x * x = s n - s (n + 1) := by
      rw [hs_succ, sub_sub_cancel]
    have h0 : s 0 = y := rfl
    have hs0 : Tendsto s atTop (𝓝 0) := squeeze_zero_norm hs (by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hε'0 hε'1).mul_const ‖y‖)
    simp_rw [hterm, Finset.sum_range_sub', h0]
    simpa using hs0.const_sub y
  exact tendsto_nhds_unique hpartial hhas.tendsto_sum_nat

/-- **Successive approximation along a set.** In a complete normed ring, let `F` be a finite
subset and `ε < 1`. If every `y ∈ S` is within `ε ‖y‖` of a combination
`∑ x ∈ F, b x * x` with `‖b x‖ * ‖x‖ ≤ ‖y‖` whose error again lies in `S`, then `S` lies in the
left ideal generated by `F`. -/
theorem TauCeti.subset_idealSpan_of_approx {A : Type*} [NormedRing A] [CompleteSpace A]
    {S : Set A} {F : Finset A} {ε : ℝ} (hε1 : ε < 1)
    (happrox : ∀ y ∈ S, ∃ b : A → A, (∀ x ∈ F, ‖b x‖ * ‖x‖ ≤ ‖y‖) ∧
      y - ∑ x ∈ F, b x * x ∈ S ∧ ‖y - ∑ x ∈ F, b x * x‖ ≤ ε * ‖y‖) :
    S ⊆ (Ideal.span (F : Set A) : Set A) := by
  intro y hy
  obtain ⟨b, -, hy⟩ := exists_eq_sum_tsum_of_approx hε1 happrox hy
  rw [SetLike.mem_coe, hy]
  exact _root_.sum_mem fun x hx ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span hx)

/-- **Strict successive approximation along a set.** In a complete ultrametric normed ring, under
the hypotheses of `TauCeti.subset_idealSpan_of_approx`, every `y ∈ S` is a combination
`∑ x ∈ F, a x * x` with `‖a x‖ * ‖x‖ ≤ ‖y‖`: the bound on the coefficients of a single
approximation step survives the iteration. -/
theorem TauCeti.exists_eq_sum_mul_of_approx {A : Type*} [NormedRing A] [IsUltrametricDist A]
    [CompleteSpace A] {S : Set A} {F : Finset A} {ε : ℝ} (hε1 : ε < 1)
    (happrox : ∀ y ∈ S, ∃ b : A → A, (∀ x ∈ F, ‖b x‖ * ‖x‖ ≤ ‖y‖) ∧
      y - ∑ x ∈ F, b x * x ∈ S ∧ ‖y - ∑ x ∈ F, b x * x‖ ≤ ε * ‖y‖) {y : A} (hy : y ∈ S) :
    ∃ a : A → A, y = ∑ x ∈ F, a x * x ∧ ∀ x ∈ F, ‖a x‖ * ‖x‖ ≤ ‖y‖ := by
  obtain ⟨b, hb, hy⟩ := exists_eq_sum_tsum_of_approx hε1 happrox hy
  refine ⟨fun x ↦ ∑' n, b n x, hy, fun x hx ↦ ?_⟩
  rcases eq_or_ne x 0 with rfl | hx0
  · simp
  have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx0
  rw [← le_div_iff₀ hxpos]
  refine IsUltrametricDist.norm_tsum_le_of_forall_le fun n ↦ (le_div_iff₀ hxpos).2 ?_
  exact (hb n x hx).trans <| mul_le_of_le_one_left (norm_nonneg y) <|
    pow_le_one₀ (le_max_right ε 0) (max_le hε1.le zero_le_one)
