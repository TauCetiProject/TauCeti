/-!
# Generating an ideal by successive approximation

In a complete normed ring, a finite subset `F` of a left ideal `H` generates `H` as soon
as every element `y` of `H` can be approximated by a combination of `F` up to an error of at most
`ε ‖y‖`, for a fixed `ε < 1`, with coefficients bounded in terms of `‖y‖`
(`Ideal.le_span_of_approx`). Iterating the approximation on the errors gives convergent
coefficient series. This is how Gröbner-type arguments prove that ideals of complete normed rings
are finitely generated, as in Kedlaya's proof that rings of restricted power series over a
Euclidean normed ring are noetherian.

The iteration only needs the errors to stay in the set being approximated, which need not be an
ideal (`TauCeti.subset_idealSpan_of_approx`). This is how Kedlaya obtains Euclidean division from a
division whose remainder is either of smaller degree or smaller by a uniform factor.

## References

* K. S. Kedlaya, *Noetherian properties of Fargues–Fontaine curves*, IMRN 2016, no. 8,
  2544–2567; arXiv:1410.5160v3, Proposition 2.9 and Lemma 3.9.
-/

public section

open Filter Topology

/-- **Successive approximation along a set.** In a complete normed ring, let `F` be a finite
subset and `0 ≤ ε < 1`. If every `y ∈ S` is within `ε ‖y‖` of a combination
`∑ x ∈ F, b x * x` with `‖b x‖ * ‖x‖ ≤ ‖y‖` whose error again lies in `S`, then `S` lies in the
left ideal generated by `F`. -/
theorem TauCeti.subset_idealSpan_of_approx {A : Type*} [NormedRing A] [CompleteSpace A]
    {S : Set A} {F : Finset A} {ε : ℝ} (hε0 : 0 ≤ ε) (hε1 : ε < 1)
    (happrox : ∀ y ∈ S, ∃ b : A → A, (∀ x ∈ F, ‖b x‖ * ‖x‖ ≤ ‖y‖) ∧
      y - ∑ x ∈ F, b x * x ∈ S ∧ ‖y - ∑ x ∈ F, b x * x‖ ≤ ε * ‖y‖) :
    S ⊆ (Ideal.span (F : Set A) : Set A) := by
  intro y hy
  choose! b hb using happrox
  -- Iterating the approximation gives remainders `s n ∈ S` with `‖s n‖ ≤ εⁿ ‖y‖`.
  let s : ℕ → A := fun n ↦ Nat.rec y (fun _ y' ↦ y' - ∑ x ∈ F, b y' x * x) n
  have hs_succ (n : ℕ) : s (n + 1) = s n - ∑ x ∈ F, b (s n) x * x := rfl
  have hsS (n : ℕ) : s n ∈ S := by
    induction n with
    | zero => exact hy
    | succ n ih => exact hs_succ n ▸ (hb (s n) ih).2.1
  have hs (n : ℕ) : ‖s n‖ ≤ ε ^ n * ‖y‖ := by
    induction n with
    | zero => simp [s]
    | succ n ih =>
      rw [hs_succ, pow_succ, mul_comm (ε ^ n) ε, mul_assoc]
      exact (hb (s n) (hsS n)).2.2.trans (mul_le_mul_of_nonneg_left ih hε0)
  -- For `x ≠ 0` in `F` the coefficients of `x` are summable, by comparison with a geometric
  -- series.
  have hhas : HasSum (fun n ↦ ∑ x ∈ F, b (s n) x * x) (∑ x ∈ F, (∑' n, b (s n) x) * x) := by
    refine hasSum_sum fun x hx ↦ ?_
    rcases eq_or_ne x 0 with rfl | hx0
    · simp
    have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx0
    refine (Summable.of_norm_bounded
      (((summable_geometric_of_lt_one hε0 hε1).mul_right ‖y‖).div_const ‖x‖) fun n ↦ ?_).hasSum
        |>.mul_right x
    rw [le_div_iff₀ hxpos]
    exact ((hb (s n) (hsS n)).1 x hx).trans (hs n)
  -- The partial sums are `y - s N`, which tend to `y`.
  have hpartial : Tendsto (fun N ↦ ∑ n ∈ Finset.range N, ∑ x ∈ F, b (s n) x * x) atTop (𝓝 y) := by
    have hterm (n : ℕ) : ∑ x ∈ F, b (s n) x * x = s n - s (n + 1) := by
      rw [hs_succ, sub_sub_cancel]
    have h0 : s 0 = y := rfl
    have hs0 : Tendsto s atTop (𝓝 0) := squeeze_zero_norm hs (by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hε0 hε1).mul_const ‖y‖)
    simp_rw [hterm, Finset.sum_range_sub', h0]
    simpa using hs0.const_sub y
  rw [SetLike.mem_coe, tendsto_nhds_unique hpartial hhas.tendsto_sum_nat]
  exact _root_.sum_mem fun x hx ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span hx)

/-- **Successive approximation.** In a complete normed ring, let `F` be a finite subset of a
left ideal `H`, and `0 ≤ ε < 1`. If every `y ∈ H` is within `ε ‖y‖` of a
combination `∑ x ∈ F, b x * x` with `‖b x‖ * ‖x‖ ≤ ‖y‖`, then `F` generates `H`. -/
theorem Ideal.le_span_of_approx {A : Type*} [NormedRing A] [CompleteSpace A]
    {H : Ideal A} {F : Finset A} (hFH : ∀ x ∈ F, x ∈ H) {ε : ℝ} (hε0 : 0 ≤ ε)
    (hε1 : ε < 1) (happrox : ∀ y ∈ H, ∃ b : A → A,
      (∀ x ∈ F, ‖b x‖ * ‖x‖ ≤ ‖y‖) ∧ ‖y - ∑ x ∈ F, b x * x‖ ≤ ε * ‖y‖) :
    H ≤ Ideal.span F :=
  TauCeti.subset_idealSpan_of_approx hε0 hε1 fun y hy ↦ (happrox y hy).imp fun _ hb ↦
    ⟨hb.1, H.sub_mem hy (H.sum_mem fun x hx ↦ H.mul_mem_left _ (hFH x hx)), hb.2⟩
