/-!
# Finite strict generating systems of normed submodules

Let `N` be a submodule of a normed module `M` over a seminormed ring `A`. A finite set `F` of
nonzero elements of `N` generates `N` *strictly* when every `y ∈ N` is a combination
`∑ x ∈ F, a x • x` with `‖a x‖ * ‖x‖ ≤ ‖y‖`, so that no cancellation between the terms is needed
to represent `y`.

Because `F` is finite and consists of nonzero elements, the coefficients `a x` of such a
representation are bounded by `(∑ x ∈ F, ‖x‖⁻¹) * ‖y‖`. The linear-combination map `(F → A) → N`
therefore has uniformly norm-bounded lifts, making it an open quotient map onto `N` with its
subspace topology (`TauCeti.isOpenMap_of_exists_norm_le`). Consequently:

* the subspace topology on `N` is the module topology over `A`
  (`Submodule.isModuleTopology_of_exists_finset_eq_sum_smul`);
* any linear map into `M` (or into a quotient `M ⧸ N` with exact quotient-norm representatives)
  whose range (or range preimage) has a finite strict generating system admits uniformly
  norm-bounded preimages on its range
  (`LinearMap.exists_preimage_norm_le_of_exists_finset_eq_sum_smul`,
  `LinearMap.exists_preimage_norm_le_quotient_of_exists_finset_eq_sum_smul`);
* when `A` is complete, `N` is complete (`Submodule.completeSpace_of_exists_finset_eq_sum_smul`)
  and hence closed in `M` (`Submodule.isClosed_of_exists_finset_eq_sum_smul`).

When the norm of `A` is multiplicative and ultrametric, the action of `A` on `M` multiplies norms,
and the norm of every nonzero element of `N` is the norm of a unit of `A`, each generator can be
divided by such a unit. This gives a strict generating system of elements of norm one, with
coefficients bounded by `‖y‖` (`Submodule.exists_finset_norm_eq_one_of_exists_finset_eq_sum_smul`).
For ideals and submodules of finite free modules over a Tate algebra at unit polyradius the units
used for this normalisation can be chosen to be nonzero constants, whose norms are all the values
of the Gauss norm.
-/

public section

open Topology

namespace Submodule

section OpenQuotient

variable {A M : Type*} [SeminormedRing A] [NormedAddCommGroup M] [Module A M] [IsBoundedSMul A M]

/-- The linear-combination map from `F → A` onto a submodule strictly generated by `F` has
uniformly bounded lifts, hence is an open quotient map onto `N` with its subspace topology. -/
private theorem exists_isOpenQuotientMap_of_exists_finset_eq_sum_smul {N : Submodule A M}
    (hN : ∃ F : Finset M, (∀ x ∈ F, x ∈ N ∧ x ≠ 0) ∧
      ∀ y ∈ N, ∃ a : M → A, y = ∑ x ∈ F, a x • x ∧ ∀ x ∈ F, ‖a x‖ * ‖x‖ ≤ ‖y‖) :
    ∃ (F : Finset M) (Φ : (F → A) →ₗ[A] N), IsOpenQuotientMap Φ := by
  obtain ⟨F, hFN, hF⟩ := hN
  let Φ : (F → A) →ₗ[A] N := Fintype.linearCombination A fun x : F ↦ ⟨x.1, (hFN x.1 x.2).1⟩
  let K : ℝ := ∑ x ∈ F, ‖x‖⁻¹
  have hK : 0 ≤ K := Finset.sum_nonneg fun x _ ↦ inv_nonneg.mpr (norm_nonneg x)
  have hlift (y : N) : ∃ b : F → A, Φ b = y ∧ ‖b‖ ≤ K * ‖y‖ := by
    obtain ⟨a, hy, ha⟩ := hF y.1 y.2
    refine ⟨fun x ↦ a x.1, Subtype.ext ?_, ?_⟩
    · simp only [Φ, Fintype.linearCombination_apply, Submodule.coe_sum, SetLike.val_smul,
        Finset.univ_eq_attach]
      rw [Finset.sum_attach F fun x ↦ a x • x, ← hy]
    · refine (pi_norm_le_iff_of_nonneg (mul_nonneg hK (norm_nonneg y))).mpr fun x ↦ ?_
      have hxpos : 0 < ‖x.1‖ := norm_pos_iff.mpr (hFN x.1 x.2).2
      have hax : ‖a x.1‖ ≤ ‖x.1‖⁻¹ * ‖y‖ := by
        rw [← div_eq_inv_mul, le_div_iff₀ hxpos]
        exact ha x.1 x.2
      exact hax.trans (mul_le_mul_of_nonneg_right
        (Finset.single_le_sum (fun z _ ↦ inv_nonneg.mpr (norm_nonneg z)) x.2) (norm_nonneg y))
  have hsurj : Function.Surjective Φ := fun y ↦ ⟨(hlift y).choose, (hlift y).choose_spec.1⟩
  refine ⟨F, Φ, hsurj, IsModuleTopology.continuous_of_linearMap Φ,
    TauCeti.isOpenMap_of_exists_norm_le Φ.toAddMonoidHom hlift⟩

/-- **Subspace module topology from strict generators.** If a submodule `N` of a normed module `M`
over a seminormed ring `A` has a finite strict generating system, its subspace topology is the
module topology over `A`. Neither completeness nor commutativity of `A` is needed. -/
theorem isModuleTopology_of_exists_finset_eq_sum_smul {N : Submodule A M}
    (hN : ∃ F : Finset M, (∀ x ∈ F, x ∈ N ∧ x ≠ 0) ∧
      ∀ y ∈ N, ∃ a : M → A, y = ∑ x ∈ F, a x • x ∧ ∀ x ∈ F, ‖a x‖ * ‖x‖ ≤ ‖y‖) :
    IsModuleTopology A N := by
  obtain ⟨F, Φ, hquot⟩ := exists_isOpenQuotientMap_of_exists_finset_eq_sum_smul hN
  exact ⟨hquot.isQuotientMap.eq_coinduced.trans
    (ModuleTopology.eq_coinduced_of_surjective hquot.surjective).symm⟩

omit [IsBoundedSMul A M] in
/-- **Uniformly bounded preimages from strict generators of the range.** If the range of a linear
map `f : M₀ →ₗ[A] M` from a seminormed `A`-module into a normed `A`-module has a finite strict
generating system, there is `C > 0` such that every `z ∈ LinearMap.range f` has a preimage `x : M₀`
with `‖x‖ ≤ C * ‖z‖`. Neither continuity of `f` nor completeness of `A` or `M₀` is needed. -/
theorem _root_.LinearMap.exists_preimage_norm_le_of_exists_finset_eq_sum_smul
    {M₀ : Type*} [SeminormedAddCommGroup M₀] [Module A M₀] [IsBoundedSMul A M₀] (f : M₀ →ₗ[A] M)
    (hr : ∃ F : Finset M, (∀ y ∈ F, y ∈ LinearMap.range f ∧ y ≠ 0) ∧
      ∀ z ∈ LinearMap.range f, ∃ a : M → A, z = ∑ y ∈ F, a y • y ∧ ∀ y ∈ F, ‖a y‖ * ‖y‖ ≤ ‖z‖) :
    ∃ C : ℝ, 0 < C ∧ ∀ z ∈ LinearMap.range f, ∃ x : M₀, f x = z ∧ ‖x‖ ≤ C * ‖z‖ := by
  obtain ⟨F, hFr, hF⟩ := hr
  choose! u hu using fun y (hy : y ∈ F) ↦ (hFr y hy).1
  refine ⟨1 + ∑ y ∈ F, ‖u y‖ / ‖y‖,
    add_pos_of_pos_of_nonneg one_pos
      (Finset.sum_nonneg fun _ _ ↦ div_nonneg (norm_nonneg _) (norm_nonneg _)),
    fun z hz ↦ ?_⟩
  obtain ⟨a, hza, ha⟩ := hF z hz
  refine ⟨∑ y ∈ F, a y • u y, ?_, ?_⟩
  · rw [map_sum, hza]
    exact Finset.sum_congr rfl fun y hy ↦ by rw [map_smul, hu y hy]
  · calc ‖∑ y ∈ F, a y • u y‖
        ≤ (∑ y ∈ F, ‖u y‖ / ‖y‖) * ‖z‖ :=
          TauCeti.norm_sum_smul_le_sum_div_mul (fun y hy ↦ norm_pos_iff.mpr (hFr y hy).2) ha
      _ ≤ (1 + ∑ y ∈ F, ‖u y‖ / ‖y‖) * ‖z‖ :=
          mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one) (norm_nonneg z)

omit [IsBoundedSMul A M] in
/-- **Uniformly bounded preimages into a quotient from strict generators and exact
representatives.** Let `N` be a submodule of a normed `A`-module `M`, and `f : M₀ →ₗ[A] M ⧸ N` a
linear map from a seminormed `A`-module `M₀`. If every class in `LinearMap.range f` has a
representative in `M` attaining its quotient norm, and `(LinearMap.range f).comap N.mkQ ≤ M` admits
a finite strict generating system, then `f` has uniformly norm-bounded preimages on its range. -/
theorem _root_.LinearMap.exists_preimage_norm_le_quotient_of_exists_finset_eq_sum_smul
    {M₀ : Type*} [SeminormedAddCommGroup M₀] [Module A M₀] [IsBoundedSMul A M₀]
    {N : Submodule A M} (f : M₀ →ₗ[A] (M ⧸ N))
    (hrep : ∀ q ∈ LinearMap.range f, ∃ w : M, Submodule.Quotient.mk w = q ∧ ‖w‖ = ‖q‖)
    (hr : ∃ F : Finset M, (∀ y ∈ F, y ∈ (LinearMap.range f).comap N.mkQ ∧ y ≠ 0) ∧
      ∀ z ∈ (LinearMap.range f).comap N.mkQ,
        ∃ a : M → A, z = ∑ y ∈ F, a y • y ∧ ∀ y ∈ F, ‖a y‖ * ‖y‖ ≤ ‖z‖) :
    ∃ C : ℝ, 0 < C ∧ ∀ q ∈ LinearMap.range f, ∃ x : M₀, f x = q ∧ ‖x‖ ≤ C * ‖q‖ := by
  obtain ⟨F, hFr, hF⟩ := hr
  choose! u hu using fun y (hy : y ∈ F) ↦
    LinearMap.mem_range.mp (Submodule.mem_comap.mp (hFr y hy).1)
  refine ⟨1 + ∑ y ∈ F, ‖u y‖ / ‖y‖,
    add_pos_of_pos_of_nonneg one_pos
      (Finset.sum_nonneg fun _ _ ↦ div_nonneg (norm_nonneg _) (norm_nonneg _)),
    fun q hq ↦ ?_⟩
  obtain ⟨w, hwq, hwnorm⟩ := hrep q hq
  have hw : w ∈ (LinearMap.range f).comap N.mkQ := by
    simpa [Submodule.mem_comap, Submodule.mkQ_apply, hwq] using hq
  obtain ⟨a, hwa, ha⟩ := hF w hw
  refine ⟨∑ y ∈ F, a y • u y, ?_, ?_⟩
  · rw [map_sum, ← hwq, ← N.mkQ_apply, hwa, map_sum]
    exact Finset.sum_congr rfl fun y hy ↦ by rw [map_smul, hu y hy, map_smul]
  · rw [← hwnorm]
    calc ‖∑ y ∈ F, a y • u y‖
        ≤ (∑ y ∈ F, ‖u y‖ / ‖y‖) * ‖w‖ :=
          TauCeti.norm_sum_smul_le_sum_div_mul (fun y hy ↦ norm_pos_iff.mpr (hFr y hy).2) ha
      _ ≤ (1 + ∑ y ∈ F, ‖u y‖ / ‖y‖) * ‖w‖ :=
          mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one) (norm_nonneg w)

/-- **Completeness from strict generators.** Over a complete seminormed ring, every submodule of a
normed module admitting a finite strict generating system is complete in the induced norm. -/
theorem completeSpace_of_exists_finset_eq_sum_smul [CompleteSpace A] {N : Submodule A M}
    (hN : ∃ F : Finset M, (∀ x ∈ F, x ∈ N ∧ x ≠ 0) ∧
      ∀ y ∈ N, ∃ a : M → A, y = ∑ x ∈ F, a x • x ∧ ∀ x ∈ F, ‖a x‖ * ‖x‖ ≤ ‖y‖) :
    CompleteSpace N := by
  obtain ⟨F, Φ, hquot⟩ := exists_isOpenQuotientMap_of_exists_finset_eq_sum_smul hN
  exact hquot.completeSpace

/-- **Closedness from strict generators.** Over a complete seminormed ring, every submodule of a
normed module admitting a finite strict generating system is closed. -/
theorem isClosed_of_exists_finset_eq_sum_smul [CompleteSpace A] {N : Submodule A M}
    (hN : ∃ F : Finset M, (∀ x ∈ F, x ∈ N ∧ x ≠ 0) ∧
      ∀ y ∈ N, ∃ a : M → A, y = ∑ x ∈ F, a x • x ∧ ∀ x ∈ F, ‖a x‖ * ‖x‖ ≤ ‖y‖) :
    IsClosed (N : Set M) :=
  (completeSpace_coe_iff_isComplete.mp (N.completeSpace_of_exists_finset_eq_sum_smul hN)).isClosed

end OpenQuotient

section Normalise

variable {A M : Type*} [NormedRing A] [NormMulClass A] [NormOneClass A] [IsUltrametricDist A]
  [SeminormedAddCommGroup M] [Module A M] [NormSMulClass A M]

/-- **Normalising a strict generating system.** Let `N` be a submodule of a normed module over
a ring with a multiplicative ultrametric norm, such that the norm of every nonzero element of `N`
is the norm of a unit. If finitely many nonzero elements `x` of `N` generate it strictly, with each
`y ∈ N` a combination `∑ x, a x • x` with `‖a x‖ * ‖x‖ ≤ ‖y‖`, then finitely many elements of `N`
of norm one generate it with coefficients `‖a x‖ ≤ ‖y‖`. -/
theorem exists_finset_norm_eq_one_of_exists_finset_eq_sum_smul {N : Submodule A M}
    (hunit : ∀ x ∈ N, x ≠ 0 → ∃ u : A, IsUnit u ∧ ‖u‖ = ‖x‖)
    (hN : ∃ F : Finset M, (∀ x ∈ F, x ∈ N ∧ x ≠ 0) ∧
      ∀ y ∈ N, ∃ a : M → A, y = ∑ x ∈ F, a x • x ∧ ∀ x ∈ F, ‖a x‖ * ‖x‖ ≤ ‖y‖) :
    ∃ F : Finset M, (∀ x ∈ F, x ∈ N ∧ ‖x‖ = 1) ∧
      ∀ y ∈ N, ∃ a : M → A, y = ∑ x ∈ F, a x • x ∧ ∀ x ∈ F, ‖a x‖ ≤ ‖y‖ := by
  classical
  obtain ⟨F, hFN, hF⟩ := hN
  have hunit' (x) (hx : x ∈ F) : ∃ u : Aˣ, ‖(u : A)‖ = ‖x‖ := by
    obtain ⟨u, hu, hux⟩ := hunit x (hFN x hx).1 (hFN x hx).2
    exact ⟨hu.unit, hux⟩
  choose! u hu using hunit'
  -- Dividing each generator `x` by the unit `u x`, of the same norm, normalises it to norm one.
  let g x := (↑(u x)⁻¹ : A) • x
  refine ⟨F.image g, ?_, fun y hy ↦ ?_⟩
  · simp only [Finset.mem_image, forall_exists_index, and_imp]
    rintro _ x hx rfl
    refine ⟨N.smul_mem _ (hFN x hx).1, ?_⟩
    simp only [g]
    rw [norm_smul, ← hu x hx, ← norm_mul, Units.inv_mul, norm_one]
  obtain ⟨a, rfl, ha⟩ := hF y hy
  refine ⟨fun z ↦ ∑ x ∈ F with g x = z, a x * u x, ?_, fun z _ ↦ ?_⟩
  · simp only [Finset.sum_smul]
    calc ∑ x ∈ F, a x • x = ∑ x ∈ F, (a x * u x) • g x :=
          Finset.sum_congr rfl fun x _ ↦ by
            simp only [g]
            rw [mul_smul, ← mul_smul (u x : A), Units.mul_inv, one_smul]
      _ = ∑ z ∈ F.image g, ∑ x ∈ F with g x = z, (a x * u x) • g x :=
          (Finset.sum_fiberwise_of_maps_to (fun x hx ↦ Finset.mem_image_of_mem g hx) _).symm
      _ = ∑ z ∈ F.image g, ∑ x ∈ F with g x = z, (a x * u x) • z :=
          Finset.sum_congr rfl fun z _ ↦ Finset.sum_congr rfl fun x hx ↦ by
            rw [(Finset.mem_filter.mp hx).2]
  · refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (norm_nonneg _) fun x hx ↦ ?_
    rw [norm_mul, hu x (Finset.mem_filter.mp hx).1]
    exact ha x (Finset.mem_filter.mp hx).1

end Normalise

end Submodule
