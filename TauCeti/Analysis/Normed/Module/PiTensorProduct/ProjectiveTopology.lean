module

public import TauCeti.Analysis.Normed.Module.PiTensorProduct.ProjectiveSeminorm
public import Mathlib.Analysis.LocallyConvex.WithSeminorms

/-!
# The projective topology on a tensor product

Given a defining family of seminorms on each member of a finite family of modules, this file
equips their algebraic tensor product with the projective topology.  A basic seminorm is the
projective seminorm associated to one finite supremum of defining seminorms in each factor.
Allowing these finite suprema makes the construction independent of directedness assumptions on
the supplied families.

The main results give the two estimates used by the universal property:

* `ProjectiveTensorProduct.continuous_lift` makes the tensor lift of a multilinear map continuous
  from a product-seminorm bound;
* `ProjectiveTensorProduct.continuous_map` makes the tensor product of seminorm-bounded linear maps
  continuous.

The construction is not completed or Hausdorffified here.  It is the seminorm-generated
topological module whose separated completion is the completed projective tensor product.

The seminorm estimates build on Mathlib's `PiTensorProduct` universal property and on
`PiTensorProduct.projectiveSeminorm`.  The passage from seminorm families to a topology uses
`WithSeminorms`.
-/

public section

open scoped TensorProduct

namespace TauCeti

variable {ι 𝕜 : Type*} [NormedField 𝕜]
variable {E : ι → Type*} [∀ i, AddCommGroup (E i)] [∀ i, Module 𝕜 (E i)]
variable {σ : ι → Type*}

/-- The algebraic tensor product carrying the projective topology generated by `p`.

This wrapper distinguishes the projective topology from other topologies on the same underlying
algebraic tensor product. -/
structure ProjectiveTensorProduct (p : ∀ i, SeminormFamily 𝕜 (E i) (σ i)) where
  /-- The underlying element of the algebraic tensor product. -/
  toPiTensorProduct : ⨂[𝕜] i, E i

namespace ProjectiveTensorProduct

variable (p : ∀ i, SeminormFamily 𝕜 (E i) (σ i))

/-- Forget the wrapper carrying the projective topology. -/
def toPiTensorProductEquiv : ProjectiveTensorProduct p ≃ ⨂[𝕜] i, E i where
  toFun := toPiTensorProduct
  invFun := fun x => ⟨x⟩
  left_inv := fun x => by cases x; rfl
  right_inv := fun _ => rfl

instance instAddCommGroup : AddCommGroup (ProjectiveTensorProduct p) :=
  (toPiTensorProductEquiv p).addCommGroup

/-- Forget the projective topology and retain the additive structure. -/
def toPiTensorProductAddEquiv : ProjectiveTensorProduct p ≃+ ⨂[𝕜] i, E i where
  toEquiv := toPiTensorProductEquiv p
  map_add' := fun _ _ => rfl

instance instModule : Module 𝕜 (ProjectiveTensorProduct p) :=
  (toPiTensorProductAddEquiv p).module 𝕜

/-- The projective tensor product is linearly equivalent to its underlying algebraic tensor
product after forgetting topology. -/
def toPiTensorProductLinearEquiv : ProjectiveTensorProduct p ≃ₗ[𝕜] ⨂[𝕜] i, E i where
  toAddEquiv := toPiTensorProductAddEquiv p
  map_smul' := fun _ _ => rfl

@[simp]
theorem toPiTensorProductLinearEquiv_apply (x : ProjectiveTensorProduct p) :
    toPiTensorProductLinearEquiv p x = x.toPiTensorProduct := by
  exact AddEquiv.linearEquiv_apply (R := 𝕜) (toPiTensorProductAddEquiv p) x

@[simp]
theorem toPiTensorProductLinearEquiv_symm_apply (x : ⨂[𝕜] i, E i) :
    (toPiTensorProductLinearEquiv p).symm x = ⟨x⟩ := by
  exact AddEquiv.linearEquiv_symm_apply (R := 𝕜) (toPiTensorProductAddEquiv p) x

/-- Two projective tensors are equal when their underlying algebraic tensors are equal. -/
@[ext]
theorem ext {x y : ProjectiveTensorProduct p}
    (h : x.toPiTensorProduct = y.toPiTensorProduct) : x = y :=
  (toPiTensorProductEquiv p).injective h

/-- The canonical pure-tensor multilinear map into the projective tensor product. -/
def tprod : MultilinearMap 𝕜 E (ProjectiveTensorProduct p) :=
  (toPiTensorProductLinearEquiv p).symm.toLinearMap.compMultilinearMap
    (PiTensorProduct.tprod 𝕜)

@[simp]
theorem tprod_apply (x : ∀ i, E i) :
    tprod p x = ⟨⨂ₜ[𝕜] i, x i⟩ := by
  apply ext p
  rfl

variable {F : Type*} [AddCommGroup F] [Module 𝕜 F]

/-- The algebraic lift of a multilinear map from the projective tensor product. -/
def lift (f : MultilinearMap 𝕜 E F) : ProjectiveTensorProduct p →ₗ[𝕜] F :=
  (PiTensorProduct.lift f).comp (toPiTensorProductLinearEquiv p).toLinearMap

@[simp]
theorem lift_tprod (f : MultilinearMap 𝕜 E F) (x : ∀ i, E i) :
    lift p f ⟨⨂ₜ[𝕜] i, x i⟩ = f x := by
  simp [lift]

/-- A linear map out of the projective tensor product is determined by its values on pure
tensors. -/
theorem lift_unique (f : MultilinearMap 𝕜 E F) (g : ProjectiveTensorProduct p →ₗ[𝕜] F)
    (h : ∀ x, g (tprod p x) = f x) : g = lift p f := by
  apply LinearMap.ext
  rintro ⟨x⟩
  have hg : g.comp (toPiTensorProductLinearEquiv p).symm.toLinearMap =
      PiTensorProduct.lift f := by
    apply PiTensorProduct.ext
    ext y
    simpa [tprod] using h y
  exact LinearMap.congr_fun hg x

/-- Linear maps from a projective tensor product are equal when they agree on pure tensors. -/
@[ext]
theorem linearMap_ext {f g : ProjectiveTensorProduct p →ₗ[𝕜] F}
    (h : ∀ x, f (tprod p x) = g (tprod p x)) : f = g := by
  apply LinearMap.ext
  rintro ⟨x⟩
  have hfg : f.comp (toPiTensorProductLinearEquiv p).symm.toLinearMap =
      g.comp (toPiTensorProductLinearEquiv p).symm.toLinearMap := by
    apply PiTensorProduct.ext
    ext y
    simpa [tprod] using h y
  exact LinearMap.congr_fun hfg x

variable [Fintype ι]

/-- The projective seminorm family.  Its indices choose a finite collection of defining
seminorms in every tensor factor. -/
noncomputable def seminormFamily :
    SeminormFamily 𝕜 (ProjectiveTensorProduct p) (∀ i, Finset (σ i)) :=
  fun s => (PiTensorProduct.projectiveSeminormOf fun i => (s i).sup (p i)).comp
    (toPiTensorProductLinearEquiv p).toLinearMap

/-- Evaluation of a member of the projective seminorm family on the underlying algebraic
tensor. -/
@[simp]
theorem seminormFamily_apply (s : ∀ i, Finset (σ i)) (x : ProjectiveTensorProduct p) :
    seminormFamily p s x =
      PiTensorProduct.projectiveSeminormOf (fun i => (s i).sup (p i)) x.toPiTensorProduct := by
  rfl

/-- The topology generated by the projective seminorm family. -/
noncomputable instance instTopologicalSpace : TopologicalSpace (ProjectiveTensorProduct p) :=
  (seminormFamily p).moduleFilterBasis.topology

/-- The topology on the projective tensor product is induced by its projective seminorm family. -/
theorem withSeminorms : WithSeminorms (seminormFamily p) :=
  ⟨rfl⟩

noncomputable instance instIsTopologicalAddGroup :
    IsTopologicalAddGroup (ProjectiveTensorProduct p) :=
  (withSeminorms p).isTopologicalAddGroup

noncomputable instance instContinuousSMul : ContinuousSMul 𝕜 (ProjectiveTensorProduct p) :=
  (withSeminorms p).continuousSMul

noncomputable instance instPolynormableSpace : PolynormableSpace 𝕜 (ProjectiveTensorProduct p) :=
  (withSeminorms p).toPolynormableSpace

noncomputable instance instFirstCountableTopology {𝕜 : Type*} [NontriviallyNormedField 𝕜]
    {E : ι → Type*} [∀ i, AddCommGroup (E i)] [∀ i, Module 𝕜 (E i)]
    (p : ∀ i, SeminormFamily 𝕜 (E i) (σ i)) [∀ i, Countable (σ i)] :
    FirstCountableTopology (ProjectiveTensorProduct p) := by
  let _ : Countable (∀ i, Finset (σ i)) := inferInstance
  exact @WithSeminorms.firstCountableTopology 𝕜 _ (∀ i, Finset (σ i)) _ _ _ _
    (seminormFamily p) _ (withSeminorms p)

/-- The projective seminorm of a pure tensor is bounded by the product of the selected factor
seminorms. -/
theorem seminormFamily_tprod_le (s : ∀ i, Finset (σ i)) (x : ∀ i, E i) :
    seminormFamily p s (tprod p x) ≤ ∏ i, (s i).sup (p i) (x i) := by
  simpa using
    PiTensorProduct.projectiveSeminormOf_tprod_le (fun i => (s i).sup (p i)) x

/-- A product-seminorm estimate for every target seminorm makes the tensor lift continuous.
The selected finite families and the bound may depend on the target seminorm. -/
theorem continuous_lift {τ : Type*} [TopologicalSpace F]
    (q : SeminormFamily 𝕜 F τ) (hq : WithSeminorms q)
    (f : MultilinearMap 𝕜 E F)
    (hf : ∀ j, ∃ (s : ∀ i, Finset (σ i)) (C : NNReal),
      ∀ (x : ∀ i, E i), q j (f x) ≤ (C : ℝ) * ∏ i, (s i).sup (p i) (x i)) :
    Continuous (lift p f) := by
  apply WithSeminorms.continuous_of_isBounded (withSeminorms p) hq
  intro j
  obtain ⟨s, C, hC⟩ := hf j
  refine ⟨{s}, C, ?_⟩
  rw [Finset.sup_singleton]
  intro x
  simpa [seminormFamily, lift, NNReal.smul_def] using
    PiTensorProduct.seminorm_lift_le (fun i => (s i).sup (p i)) (q j) f C.coe_nonneg hC
      x.toPiTensorProduct

variable {G : ι → Type*} [∀ i, AddCommGroup (G i)] [∀ i, Module 𝕜 (G i)]
variable {τ : ι → Type*} (q : ∀ i, SeminormFamily 𝕜 (G i) (τ i))

/-- Tensor a family of linear maps between projective tensor products. -/
def map (f : ∀ i, E i →ₗ[𝕜] G i) :
    ProjectiveTensorProduct p →ₗ[𝕜] ProjectiveTensorProduct q :=
  (toPiTensorProductLinearEquiv q).symm.toLinearMap.comp
    ((PiTensorProduct.map f).comp (toPiTensorProductLinearEquiv p).toLinearMap)

omit [Fintype ι] in
@[simp]
theorem map_tprod (f : ∀ i, E i →ₗ[𝕜] G i) (x : ∀ i, E i) :
    map p q f ⟨⨂ₜ[𝕜] i, x i⟩ = tprod q (fun i => f i (x i)) := by
  apply ext q
  simp [map, tprod]

omit [Fintype ι] in
/-- Tensoring the identity maps gives the identity on the projective tensor product. -/
@[simp]
theorem map_id :
    map p p (fun _ => LinearMap.id) = LinearMap.id := by
  apply linearMap_ext p
  intro x
  simp only [tprod_apply, map_tprod, LinearMap.id_apply]

variable {H : ι → Type*} [∀ i, AddCommGroup (H i)] [∀ i, Module 𝕜 (H i)]
variable {υ : ι → Type*} (r : ∀ i, SeminormFamily 𝕜 (H i) (υ i))

omit [Fintype ι] in
/-- Tensoring a pointwise composite is the composite of the tensor maps. -/
theorem map_comp (f : ∀ i, E i →ₗ[𝕜] G i) (g : ∀ i, G i →ₗ[𝕜] H i) :
    map p r (fun i => (g i).comp (f i)) = (map q r g).comp (map p q f) := by
  apply linearMap_ext p
  intro x
  simp only [tprod_apply, map_tprod, LinearMap.comp_apply]

/-- Tensoring maps bounded with respect to the defining seminorm families gives a continuous
linear map for the projective topologies. -/
theorem continuous_map (f : ∀ i, E i →ₗ[𝕜] G i)
    (hf : ∀ i, Seminorm.IsBounded (p i) (q i) (f i)) :
    Continuous (map p q f) := by
  apply WithSeminorms.continuous_of_isBounded (withSeminorms p) (withSeminorms q)
  intro t
  choose C s hs using fun i => Seminorm.isBounded_sup (hf i) (t i)
  refine ⟨{s}, ∏ i, C i, ?_⟩
  rw [Finset.sup_singleton]
  intro x
  simpa [seminormFamily, map, NNReal.smul_def] using
    PiTensorProduct.projectiveSeminormOf_map_le
      (fun i => (s i).sup (p i)) (fun i => (t i).sup (q i)) f
      (fun i => (C i).coe_nonneg) (fun i y => hs i y) x.toPiTensorProduct

end ProjectiveTensorProduct

end TauCeti
