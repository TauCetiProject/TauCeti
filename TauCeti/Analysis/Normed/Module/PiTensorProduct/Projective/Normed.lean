module

public import TauCeti.Analysis.Normed.Module.PiTensorProduct.UniversalProperty
public import TauCeti.Topology.Algebra.LinearMapCompletion

/-!
# Comparison with normed projective tensor products

For seminormed factors, using the norm as the sole defining seminorm gives exactly the
projective tensor topology of Mathlib's `PiTensorProduct`. The identity on algebraic tensors is
therefore a continuous linear equivalence, and extends to an equivalence of separated
completions. No completeness or separation of the factors is needed.

The equivalences preserve pure tensors and the continuous universal properties. Thus the
locally convex construction can be used for normed factors without changing either the
completed tensor space or the map induced by a continuous multilinear map.

The normed tensor product and its universal property are Mathlib's
`PiTensorProduct.projectiveSeminorm` and `PiTensorProduct.liftEquiv`; the locally convex
construction is `ProjectiveTensorProduct`.

## References

* H. Jarchow, *Locally Convex Spaces*, Chapter 15, for the projective tensor topology.
* R. A. Ryan, *Introduction to Tensor Products of Banach Spaces*, §2.1.
-/

public section

open scoped TensorProduct
open UniformSpace

namespace TauCeti

variable {ι 𝕜 : Type*} [Fintype ι] [NormedField 𝕜]
variable {E : ι → Type*} [∀ i, SeminormedAddCommGroup (E i)] [∀ i, NormedSpace 𝕜 (E i)]

namespace ProjectiveTensorProduct

/-- Every defining projective seminorm for the singleton norm families is bounded by the
projective tensor norm. -/
theorem seminormFamily_norm_le (s : ι → Finset Unit)
    (x : ProjectiveTensorProduct (fun i (_ : Unit) => normSeminorm 𝕜 (E i))) :
    seminormFamily (fun i (_ : Unit) => normSeminorm 𝕜 (E i)) s x ≤
      ‖x.toPiTensorProduct‖ := by
  have h : ∀ i, (s i).sup (fun _ : Unit => normSeminorm 𝕜 (E i)) ≤ normSeminorm 𝕜 (E i) :=
    fun _ => Finset.sup_le fun _ _ => le_rfl
  simpa only [seminormFamily_apply, PiTensorProduct.projectiveSeminormOf_normSeminorm,
    coe_normSeminorm] using PiTensorProduct.projectiveSeminormOf_mono h x.toPiTensorProduct

/-- The projective topology generated by the factor norms agrees with the topology of
Mathlib's normed projective tensor product. The underlying map forgets only the wrapper. -/
noncomputable def normEquiv :
    ProjectiveTensorProduct (fun i (_ : Unit) => normSeminorm 𝕜 (E i)) ≃L[𝕜]
      ⨂[𝕜] i, E i where
  toLinearEquiv := toPiTensorProductLinearEquiv _
  continuous_toFun := by
    apply WithSeminorms.continuous_normedSpace_rng _ (withSeminorms _)
    refine ⟨{fun _ => Finset.univ}, 1, ?_⟩
    intro x
    simp
  continuous_invFun := by
    refine WithSeminorms.continuous_of_isBounded
      (norm_withSeminorms 𝕜 (⨂[𝕜] i, E i)) (withSeminorms _)
      (toPiTensorProductLinearEquiv _).symm.toLinearMap ?_
    intro s
    refine ⟨{()}, 1, fun x => ?_⟩
    simpa using seminormFamily_norm_le s
      ((toPiTensorProductLinearEquiv (fun i (_ : Unit) => normSeminorm 𝕜 (E i))).symm x)

/-- The norm comparison forgets the projective-topology wrapper. -/
@[simp]
theorem normEquiv_apply
    (x : ProjectiveTensorProduct (fun i (_ : Unit) => normSeminorm 𝕜 (E i))) :
    normEquiv x = x.toPiTensorProduct := by
  exact toPiTensorProductLinearEquiv_apply _ x

/-- The inverse norm comparison equips an algebraic tensor with its projective topology. -/
@[simp]
theorem normEquiv_symm_apply (x : ⨂[𝕜] i, E i) :
    normEquiv.symm x = (⟨x⟩ : ProjectiveTensorProduct
      (fun i (_ : Unit) => normSeminorm 𝕜 (E i))) := by
  exact toPiTensorProductLinearEquiv_symm_apply _ x

end ProjectiveTensorProduct

namespace CompletedProjectiveTensorProduct

/-- Completing the norm comparison identifies the locally convex completed projective tensor
product with the completion of Mathlib's normed projective tensor product. -/
noncomputable def normEquiv :
    CompletedProjectiveTensorProduct (fun i (_ : Unit) => normSeminorm 𝕜 (E i)) ≃L[𝕜]
      Completion (⨂[𝕜] i, E i) :=
  ProjectiveTensorProduct.normEquiv.completion

/-- The completed comparison extends the identity on underlying algebraic tensors. -/
@[simp]
theorem normEquiv_coe
    (x : ProjectiveTensorProduct (fun i (_ : Unit) => normSeminorm 𝕜 (E i))) :
    normEquiv (x : CompletedProjectiveTensorProduct
      (fun i (_ : Unit) => normSeminorm 𝕜 (E i))) =
        (x.toPiTensorProduct : Completion (⨂[𝕜] i, E i)) := by
  simp [normEquiv]

/-- The inverse completed comparison is also the identity on algebraic tensors. -/
@[simp]
theorem normEquiv_symm_coe (x : ⨂[𝕜] i, E i) :
    normEquiv.symm (x : Completion (⨂[𝕜] i, E i)) =
      ((⟨x⟩ : ProjectiveTensorProduct (fun i (_ : Unit) => normSeminorm 𝕜 (E i))) :
        CompletedProjectiveTensorProduct (fun i (_ : Unit) => normSeminorm 𝕜 (E i))) := by
  apply normEquiv.injective
  simp

end CompletedProjectiveTensorProduct

end TauCeti

namespace TauCeti.CompletedProjectiveTensorProduct

variable {ι 𝕜 : Type*} [Fintype ι] [NontriviallyNormedField 𝕜]
variable {E : ι → Type*} [∀ i, SeminormedAddCommGroup (E i)] [∀ i, NormedSpace 𝕜 (E i)]
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F] [CompleteSpace F]

/-- Under the norm comparison, the locally convex completed lift is the completion of
Mathlib's bounded multilinear lift. -/
theorem liftEquiv_norm (f : ContinuousMultilinearMap 𝕜 E F) :
    liftEquiv (fun i (_ : Unit) => normSeminorm 𝕜 (E i))
        (fun i => norm_withSeminorms 𝕜 (E i))
        (fun _ : Unit => normSeminorm 𝕜 F) (norm_withSeminorms 𝕜 F) f =
      (PiTensorProduct.liftEquiv 𝕜 E F f).fromCompletion.comp
        normEquiv.toContinuousLinearMap := by
  apply continuousLinearMap_ext
  intro x
  simp

end TauCeti.CompletedProjectiveTensorProduct
