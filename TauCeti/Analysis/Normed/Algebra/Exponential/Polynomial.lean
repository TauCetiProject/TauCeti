module

public import Mathlib.Analysis.Normed.Algebra.Exponential
public import Mathlib.Analysis.RCLike.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-!
# The exponential is a polynomial in finite dimension

In a finite-dimensional normed algebra over `ℝ` or `ℂ`, the subalgebra generated by an element `x`
is a finite-dimensional subspace, hence closed, so it is closed under the exponential
(`NormedSpace.exp_mem`). So `exp x` is a polynomial in `x` (`TauCeti.exists_aeval_eq_exp`).
For an operator on a finite-dimensional complex space, combining this with the spectral mapping
theorem for polynomials identifies the spectrum of `exp x` with the exponentials of the eigenvalues
of `x` (`ContinuousLinearMap.spectrum_exp`).

## Main results

* `TauCeti.exists_aeval_eq_exp`: in a finite-dimensional normed algebra over `ℝ` or `ℂ`, `exp x`
  is a polynomial in `x`.
-/

public section

open Polynomial NormedSpace

namespace TauCeti

variable {𝔸 : Type*} [NormedRing 𝔸]

/-- **The exponential is a polynomial in finite dimension.** In a finite-dimensional normed algebra
over `ℝ` or `ℂ`, `exp x = P(x)` for some polynomial `P` with coefficients in the scalar field. -/
theorem exists_aeval_eq_exp {𝕜 : Type*} [RCLike 𝕜] [NormedAlgebra 𝕜 𝔸] [FiniteDimensional 𝕜 𝔸]
    (x : 𝔸) : ∃ P : 𝕜[X], aeval x P = exp x := by
  let +nondep : NormedAlgebra ℚ 𝔸 := .restrictScalars ℚ 𝕜 _
  have hclosed : IsClosed ((Algebra.adjoin 𝕜 {x} : Subalgebra 𝕜 𝔸) : Set 𝔸) :=
    (Subalgebra.toSubmodule (Algebra.adjoin 𝕜 {x})).closed_of_finiteDimensional
  have hmem : exp x ∈ Algebra.adjoin 𝕜 {x} :=
    exp_mem (R := 𝕜) hclosed (Algebra.self_mem_adjoin_singleton 𝕜 x)
  rwa [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at hmem

end TauCeti
