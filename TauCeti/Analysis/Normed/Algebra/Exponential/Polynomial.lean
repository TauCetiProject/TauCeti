/-!
# Polynomials and the exponential of an element of a normed algebra

This file compares the exponential of an element `x` of a normed algebra with polynomials in `x`.

In a finite-dimensional normed algebra over `ℝ` or `ℂ`, the subalgebra generated by `x` is a
finite-dimensional subspace, hence closed, and it contains the partial sums of the exponential
series. So `exp x` is a polynomial in `x` (`TauCeti.exists_aeval_eq_exp`). Combined with the
spectral mapping theorem for polynomials, this identifies the spectrum of `exp x` with the
exponentials of the eigenvalues of `x`.

If `x e = y e` and `y` commutes with `e`, then `x ^ n e = y ^ n e` for every `n`, so polynomials in
`x` and in `y`, and also their exponentials, agree after right multiplication by `e`
(`TauCeti.aeval_mul_eq_aeval_mul_of_mul_eq`, `TauCeti.exp_mul_eq_exp_mul_of_mul_eq`). For an
idempotent `e` this says that two operators agreeing on the range of `e`, one of which preserves
it, have the same polynomials and exponentials there.

## Main results

* `TauCeti.commute_aeval`: an element commutes with every polynomial in it.
* `TauCeti.aeval_mul_eq_aeval_mul_of_mul_eq`, `TauCeti.exp_mul_eq_exp_mul_of_mul_eq`: agreement of
  polynomials and exponentials after right multiplication.
* `TauCeti.exists_aeval_eq_exp`: in a finite-dimensional normed algebra over `ℝ` or `ℂ`, `exp x`
  is a polynomial in `x`.
-/

public section

open Polynomial NormedSpace Filter

namespace TauCeti

section Algebra

variable {R A : Type*} [CommSemiring R] [Semiring A] [Algebra R A]

/-- An element commutes with every polynomial in it. -/
theorem commute_aeval (x : A) (p : R[X]) : Commute x (aeval x p) := by
  simpa [Commute, SemiconjBy] using congrArg (aeval x) (mul_comm X p)

/-- If `x e = y e` and `y` commutes with `e`, then `x ^ n * e = y ^ n * e`. -/
theorem pow_mul_eq_pow_mul_of_mul_eq {M : Type*} [Monoid M] {x y e : M} (hxy : x * e = y * e)
    (hy : Commute y e) (n : ℕ) : x ^ n * e = y ^ n * e := by
  induction n with
  | zero => simp
  | succ n ih =>
    calc x ^ (n + 1) * e = x * (x ^ n * e) := by rw [pow_succ', mul_assoc]
      _ = x * e * y ^ n := by rw [ih, (hy.pow_left n).eq, mul_assoc]
      _ = y ^ (n + 1) * e := by
        rw [hxy, mul_assoc, ← (hy.pow_left n).eq, ← mul_assoc, ← pow_succ']

/-- If `x e = y e` and `y` commutes with `e`, then every polynomial takes the same value at `x` and
at `y` after right multiplication by `e`. -/
theorem aeval_mul_eq_aeval_mul_of_mul_eq {x y e : A} (hxy : x * e = y * e) (hy : Commute y e)
    (p : R[X]) : aeval x p * e = aeval y p * e := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add, map_add, add_mul, add_mul, hp, hq]
  | monomial n a =>
    rw [aeval_monomial, aeval_monomial, mul_assoc, mul_assoc,
      pow_mul_eq_pow_mul_of_mul_eq hxy hy n]

end Algebra

section Normed

variable {𝔸 : Type*} [NormedRing 𝔸]

/-- If `x e = y e` and `y` commutes with `e`, then `exp x * e = exp y * e`: the two exponential
series agree term by term after right multiplication by `e`. -/
theorem exp_mul_eq_exp_mul_of_mul_eq [NormedAlgebra ℚ 𝔸] [CompleteSpace 𝔸] {x y e : 𝔸}
    (hxy : x * e = y * e) (hy : Commute y e) : exp x * e = exp y * e := by
  have hx := (exp_series_hasSum_exp' (𝕂 := ℚ) x).mul_right e
  have hy' := (exp_series_hasSum_exp' (𝕂 := ℚ) y).mul_right e
  simp only [smul_mul_assoc, pow_mul_eq_pow_mul_of_mul_eq hxy hy] at hx
  simp only [smul_mul_assoc] at hy'
  exact hx.unique hy'

/-- **The exponential is a polynomial in finite dimension.** In a finite-dimensional normed algebra
over `ℝ` or `ℂ`, the exponential of `x` lies in the subalgebra generated by `x`, which is closed. -/
theorem exists_aeval_eq_exp {𝕜 : Type*} [RCLike 𝕜] [NormedAlgebra 𝕜 𝔸] [FiniteDimensional 𝕜 𝔸]
    (x : 𝔸) : ∃ P : 𝕜[X], aeval x P = exp x := by
  have := FiniteDimensional.complete 𝕜 𝔸
  have hclosed : IsClosed ((Algebra.adjoin 𝕜 {x} : Subalgebra 𝕜 𝔸) : Set 𝔸) :=
    (Subalgebra.toSubmodule (Algebra.adjoin 𝕜 {x})).closed_of_finiteDimensional
  have hmem : exp x ∈ Algebra.adjoin 𝕜 {x} :=
    hclosed.mem_of_tendsto (exp_series_hasSum_exp' (𝕂 := 𝕜) x).tendsto_sum_nat
      (Eventually.of_forall fun n ↦ Subalgebra.sum_mem _ fun k _ ↦
        Subalgebra.smul_mem _ (Subalgebra.pow_mem _ (Algebra.self_mem_adjoin_singleton 𝕜 x) k) _)
  rwa [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at hmem

end Normed

end TauCeti
