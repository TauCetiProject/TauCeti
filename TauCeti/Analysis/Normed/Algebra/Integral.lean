module

public import Mathlib.Analysis.Normed.Unbundled.RingSeminorm
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

/-!
# Bounded powers of integral elements

A ring seminorm bounded under multiplication by base scalars is bounded on
every finitely generated submodule. In particular, the powers of an integral element are
bounded, since they lie in the finite module generated by that element.
-/

public section

namespace RingSeminorm

variable {R B : Type*} [CommRing R] [Ring B] [Algebra R B]

/-- A ring seminorm which does not increase under base scalars is bounded on
every finitely generated submodule. -/
theorem exists_bound_of_fg (N : RingSeminorm B)
    (hsmul : ∀ (r : R) b, N (r • b) ≤ N b) (M : Submodule R B) (hM : M.FG) :
    ∃ K : ℝ, ∀ b ∈ M, N b ≤ K := by
  classical
  obtain ⟨s, hs⟩ := hM
  refine ⟨∑ b ∈ s, N b, fun b hb ↦ ?_⟩
  rw [← hs] at hb
  obtain ⟨c, -, rfl⟩ := Submodule.mem_span_finset.mp hb
  exact (Finset.map_sum_le_sum N s (fun b ↦ c b • b)).trans
    (Finset.sum_le_sum fun b _ ↦ hsmul (c b) b)

/-- The powers of an integral element have bounded seminorm whenever base scalar
multiplication does not increase the seminorm. -/
theorem exists_bound_pow_of_isIntegral (N : RingSeminorm B)
    (hsmul : ∀ (r : R) b, N (r • b) ≤ N b) {y : B} (hy : IsIntegral R y) :
    ∃ K : ℝ, ∀ n : ℕ, N (y ^ n) ≤ K := by
  obtain ⟨K, hK⟩ := N.exists_bound_of_fg hsmul _ hy.fg_adjoin_singleton
  exact ⟨K, fun n ↦ hK _ ((Algebra.adjoin R {y}).pow_mem (Algebra.subset_adjoin rfl) n)⟩

end RingSeminorm
