module

public import Mathlib.Algebra.Star.TransferInstance
public import Mathlib.Analysis.LocallyConvex.WithSeminorms
public import TauCeti.Analysis.InnerProductSpace.Amplification
public import TauCeti.Analysis.LocallyConvex.StrongOperatorTopology
public import TauCeti.Analysis.LocallyConvex.WeakOperatorTopology

/-!
# The strong-star operator topology

The strong-star (strong-*) topology on bounded operators `E →L[𝕜] F` between Hilbert spaces is
the coarsest topology making both `A ↦ A x` and `A ↦ A† y` continuous for all `x : E` and `y : F`:
a net `Aᵢ` converges strong-star to `A` exactly when `Aᵢ → A` and `Aᵢ† → A†` in the strong operator
topology (`TauCeti.ContinuousLinearMapStrongStar.tendsto_iff_forall_tendsto`). It is generated by
the seminorms `A ↦ ‖A x‖` and `A ↦ ‖A† y‖`.

As for Mathlib's weak operator topology `E →WOT[𝕜] F`, the topology lives on a type copy,
`TauCeti.ContinuousLinearMapStrongStar 𝕜 E F`, so that it cannot be confused with the norm
topology. The copy is a Hausdorff locally convex topological vector space (`withSeminorms`).
Unlike the strong operator topology, it makes the adjoint continuous
(`continuous_adjoint`, `instContinuousStar`); multiplication of operators is separately
continuous, and so is taking a matrix entry of an operator on a finite Hilbert sum
`PiLp 2 (fun _ : ι => H)` (`continuous_piLpEntry`).

The strong-star topology is coarser than the norm topology and finer than the strong operator
topology on Mathlib's pointwise-convergence copy `E →Lₚₜ[𝕜] F`, hence than the weak operator
topology. On normal operators the comparison with the strong operator topology is an equality
(`isInducing_restrict_toPointwiseConvergenceCLM_of_isStarNormal`): if normal operators `Aᵢ`
converge strongly to a normal operator `A`, then `Aᵢ† → A†` strongly as well
(`ContinuousLinearMap.tendsto_adjoint_apply_of_isStarNormal`). In particular strong and
strong-star convergence agree for nets of self-adjoint or of unitary operators with a limit of
the same kind, and a set of operators whose strong operator closure consists of normal operators
has the same strong-star closure (`closure_image_ofCLM_eq_of_isStarNormal`).

## Implementation notes

The type copy follows Mathlib's `ContinuousLinearMapWOT` and uses Tau Ceti's
`TauCeti.ContinuousLinearMapUltrastrong` and `TauCeti.ContinuousLinearMapUltraweak`
as implementation templates.

The algebraic structure of the type copy is transported from `E →L[𝕜] F` along
`ContinuousLinearMapStrongStar.equiv`, and the definitions are exposed so that this transport, and
the agreement of the uniform structure with the topology, hold by definition for downstream
files. The seminorms are not exposed; they are used through `seminormFamily_inl` and
`seminormFamily_inr`.

## References

* J. Dixmier, *Von Neumann Algebras*, North-Holland, 1981, Part I, Chapter 3, §1.
* M. Takesaki, *Theory of Operator Algebras I*, Springer, 1979, Chapter II, §2.
-/

@[expose] public section

open Filter Topology
open scoped InnerProduct InnerProductSpace

namespace TauCeti

/-- The type copy of `E →L[𝕜] F` endowed with the strong-star operator topology: the coarsest
topology for which `A ↦ A x` and `A ↦ A† y` are continuous for all `x : E` and `y : F`. -/
@[ext]
structure ContinuousLinearMapStrongStar (𝕜 E F : Type*) [RCLike 𝕜]
    [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
    where
  /-- Regard a bounded operator as an element of the strong-star copy. -/
  ofCLM ::
  /-- The bounded operator underlying an element of the strong-star copy. -/
  toCLM : E →L[𝕜] F

namespace ContinuousLinearMapStrongStar

variable {𝕜 E F : Type*} [RCLike 𝕜]
  [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]

/-! ### Algebraic structure, copied from `E →L[𝕜] F` -/

section Algebra

/-- The equivalence between the strong-star copy and `E →L[𝕜] F`. -/
@[simps]
def equiv : ContinuousLinearMapStrongStar 𝕜 E F ≃ (E →L[𝕜] F) where
  toFun := toCLM
  invFun := ofCLM
  left_inv _ := rfl
  right_inv _ := rfl

theorem toCLM_injective :
    Function.Injective (toCLM : ContinuousLinearMapStrongStar 𝕜 E F → E →L[𝕜] F) :=
  equiv.injective

theorem ofCLM_injective :
    Function.Injective (ofCLM : (E →L[𝕜] F) → ContinuousLinearMapStrongStar 𝕜 E F) :=
  equiv.symm.injective

instance instAddCommGroup : AddCommGroup (ContinuousLinearMapStrongStar 𝕜 E F) :=
  equiv.addCommGroup

/-- The additive equivalence between the strong-star copy and `E →L[𝕜] F`. -/
@[implicit_reducible, simps!]
def addEquiv : ContinuousLinearMapStrongStar 𝕜 E F ≃+ (E →L[𝕜] F) where
  __ := equiv
  map_add' _ _ := rfl

instance instSMul {S : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F] [ContinuousConstSMul S F] :
    SMul S (ContinuousLinearMapStrongStar 𝕜 E F) :=
  equiv.smul S

instance instModule {S : Type*} [Semiring S] [Module S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] : Module S (ContinuousLinearMapStrongStar 𝕜 E F) :=
  addEquiv.module S

instance instIsScalarTower {S T : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] [DistribSMul T F] [SMulCommClass 𝕜 T F] [ContinuousConstSMul T F]
    [SMul S T] [IsScalarTower S T F] : IsScalarTower S T (ContinuousLinearMapStrongStar 𝕜 E F) :=
  equiv.isScalarTower S T

instance instRing : Ring (ContinuousLinearMapStrongStar 𝕜 E E) :=
  equiv.ring

@[simp] theorem toCLM_zero : (0 : ContinuousLinearMapStrongStar 𝕜 E F).toCLM = 0 := rfl

@[simp] theorem toCLM_add (A B : ContinuousLinearMapStrongStar 𝕜 E F) :
    (A + B).toCLM = A.toCLM + B.toCLM := rfl

@[simp] theorem toCLM_neg (A : ContinuousLinearMapStrongStar 𝕜 E F) : (-A).toCLM = -A.toCLM :=
  rfl

@[simp] theorem toCLM_sub (A B : ContinuousLinearMapStrongStar 𝕜 E F) :
    (A - B).toCLM = A.toCLM - B.toCLM := rfl

@[simp] theorem toCLM_smul {S : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] (c : S) (A : ContinuousLinearMapStrongStar 𝕜 E F) :
    (c • A).toCLM = c • A.toCLM := rfl

@[simp] theorem toCLM_one : (1 : ContinuousLinearMapStrongStar 𝕜 E E).toCLM = 1 := rfl

@[simp] theorem toCLM_mul (A B : ContinuousLinearMapStrongStar 𝕜 E E) :
    (A * B).toCLM = A.toCLM * B.toCLM := rfl

@[simp] theorem ofCLM_toCLM (A : ContinuousLinearMapStrongStar 𝕜 E F) : ofCLM A.toCLM = A := rfl

@[simp] theorem ofCLM_zero : ofCLM (0 : E →L[𝕜] F) = 0 := rfl

@[simp] theorem ofCLM_add (x y : E →L[𝕜] F) : ofCLM (x + y) = ofCLM x + ofCLM y := rfl

@[simp] theorem ofCLM_neg (x : E →L[𝕜] F) : ofCLM (-x) = -ofCLM x := rfl

@[simp] theorem ofCLM_sub (x y : E →L[𝕜] F) : ofCLM (x - y) = ofCLM x - ofCLM y := rfl

@[simp] theorem ofCLM_smul {S : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] (c : S) (x : E →L[𝕜] F) : ofCLM (c • x) = c • ofCLM x := rfl

@[simp] theorem ofCLM_one : ofCLM (1 : E →L[𝕜] E) = 1 := rfl

@[simp] theorem ofCLM_mul (x y : E →L[𝕜] E) : ofCLM (x * y) = ofCLM x * ofCLM y := rfl

/-- The linear equivalence between the strong-star copy and `E →L[𝕜] F`. -/
@[simps!]
def linearEquiv (S : Type*) [Semiring S] [Module S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] : ContinuousLinearMapStrongStar 𝕜 E F ≃ₗ[S] (E →L[𝕜] F) :=
  (addEquiv (𝕜 := 𝕜) (E := E) (F := F)).linearEquiv S

@[simp] theorem linearEquiv_symm_apply (S : Type*) [Semiring S] [Module S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] (A : E →L[𝕜] F) : (linearEquiv (E := E) S).symm A = ofCLM A :=
  rfl

variable [CompleteSpace E]

noncomputable instance instStarRing : StarRing (ContinuousLinearMapStrongStar 𝕜 E E) :=
  equiv.starRing

instance instStarModule {S : Type*} [Star S] [DistribSMul S E] [SMulCommClass 𝕜 S E]
    [ContinuousConstSMul S E] [StarModule S (E →L[𝕜] E)] :
    StarModule S (ContinuousLinearMapStrongStar 𝕜 E E) :=
  equiv.starModule S

@[simp] theorem toCLM_star (A : ContinuousLinearMapStrongStar 𝕜 E E) :
    (star A).toCLM = star A.toCLM := rfl

@[simp] theorem ofCLM_star (x : E →L[𝕜] E) : ofCLM (star x) = star (ofCLM x) := rfl

@[simp] theorem isSelfAdjoint_ofCLM_iff {x : E →L[𝕜] E} :
    IsSelfAdjoint (ofCLM x) ↔ IsSelfAdjoint x :=
  ofCLM_injective.eq_iff

end Algebra

/-! ### The topology -/

section Topology

variable [CompleteSpace E] [CompleteSpace F]

variable (𝕜 E F) in
/-- The additive map inducing the strong-star topology: an operator `A` is sent to the pair of
functions `(x ↦ A x, y ↦ A† y)`. -/
noncomputable def inducingFn :
    ContinuousLinearMapStrongStar 𝕜 E F →+ (E → F) × (F → E) where
  toFun A := (A.toCLM, ⇑(A.toCLM†))
  map_zero' := by ext <;> simp
  map_add' A B := by ext <;> simp

@[simp]
theorem inducingFn_apply (A : ContinuousLinearMapStrongStar 𝕜 E F) :
    inducingFn 𝕜 E F A = (⇑A.toCLM, ⇑(A.toCLM†)) :=
  rfl

/-- The strong-star topology is the coarsest topology for which `A ↦ A x` and `A ↦ A† y` are
continuous for all `x : E` and `y : F`. -/
noncomputable instance instTopologicalSpace :
    TopologicalSpace (ContinuousLinearMapStrongStar 𝕜 E F) :=
  .induced (inducingFn 𝕜 E F) inferInstance

theorem isInducing_inducingFn : IsInducing (inducingFn 𝕜 E F) := ⟨rfl⟩

theorem isEmbedding_inducingFn : IsEmbedding (inducingFn 𝕜 E F) :=
  Function.Injective.isEmbedding_induced fun _ _ hAB ↦
    ContinuousLinearMapStrongStar.ext <| ContinuousLinearMap.ext <| congr_fun congr($hAB.1)

@[fun_prop]
theorem continuous_toCLM_apply (x : E) :
    Continuous fun A : ContinuousLinearMapStrongStar 𝕜 E F ↦ A.toCLM x :=
  (continuous_apply x).comp
    (continuous_fst.comp (continuous_induced_dom (f := inducingFn 𝕜 E F)))

@[fun_prop]
theorem continuous_adjoint_apply (y : F) :
    Continuous fun A : ContinuousLinearMapStrongStar 𝕜 E F ↦ (A.toCLM†) y :=
  (continuous_apply y).comp
    (continuous_snd.comp (continuous_induced_dom (f := inducingFn 𝕜 E F)))

theorem continuous_of_continuous_apply {α : Type*} [TopologicalSpace α]
    {g : α → ContinuousLinearMapStrongStar 𝕜 E F}
    (h₁ : ∀ x : E, Continuous fun a ↦ (g a).toCLM x)
    (h₂ : ∀ y : F, Continuous fun a ↦ ((g a).toCLM†) y) : Continuous g :=
  continuous_induced_rng.2 ((continuous_pi h₁).prodMk (continuous_pi h₂))

/-- **The strong-star criterion.** A net `Aᵢ` converges strong-star to `A` exactly when
`Aᵢ x → A x` and `Aᵢ† y → A† y` for all vectors `x` and `y`. -/
theorem tendsto_iff_forall_tendsto {α : Type*} {l : Filter α}
    {f : α → ContinuousLinearMapStrongStar 𝕜 E F} {A : ContinuousLinearMapStrongStar 𝕜 E F} :
    Tendsto f l (𝓝 A) ↔ (∀ x : E, Tendsto (fun a ↦ (f a).toCLM x) l (𝓝 (A.toCLM x))) ∧
      ∀ y : F, Tendsto (fun a ↦ ((f a).toCLM†) y) l (𝓝 ((A.toCLM†) y)) := by
  simp only [isInducing_inducingFn.tendsto_nhds_iff, Function.comp_def, inducingFn_apply,
    nhds_prod_eq, tendsto_prod_iff', tendsto_pi_nhds]

instance instT3Space : T3Space (ContinuousLinearMapStrongStar 𝕜 E F) :=
  isEmbedding_inducingFn.t3Space

instance instIsTopologicalAddGroup : IsTopologicalAddGroup (ContinuousLinearMapStrongStar 𝕜 E F)
    where
  toContinuousAdd := .induced (inducingFn 𝕜 E F)
  toContinuousNeg := .induced (inducingFn 𝕜 E F)

instance instContinuousSMul : ContinuousSMul 𝕜 (ContinuousLinearMapStrongStar 𝕜 E F) where
  continuous_smul := by
    refine continuous_of_continuous_apply (fun x ↦ ?_) fun y ↦ ?_
    · simp only [toCLM_smul, FunLike.coe_smul, Pi.smul_apply]
      fun_prop
    · simp only [toCLM_smul, map_smulₛₗ, FunLike.coe_smul, Pi.smul_apply]
      exact (RCLike.continuous_conj.comp continuous_fst).smul
        ((continuous_adjoint_apply y).comp continuous_snd)

noncomputable instance instUniformSpace : UniformSpace (ContinuousLinearMapStrongStar 𝕜 E F) :=
  .comap (inducingFn 𝕜 E F) inferInstance

instance instIsUniformAddGroup : IsUniformAddGroup (ContinuousLinearMapStrongStar 𝕜 E F) :=
  .comap (inducingFn 𝕜 E F)

end Topology

/-! ### The strong-star seminorms -/

section Seminorms

variable [CompleteSpace E] [CompleteSpace F]

variable (𝕜 E F) in
/-- The family of seminorms inducing the strong-star topology: `A ↦ ‖A x‖` for `x : E` and
`A ↦ ‖A† y‖` for `y : F`. -/
@[no_expose] noncomputable def seminormFamily :
    SeminormFamily 𝕜 (ContinuousLinearMapStrongStar 𝕜 E F) (E ⊕ F)
  | .inl x =>
    { toFun A := ‖A.toCLM x‖
      map_zero' := by simp
      add_le' A B := by simpa using norm_add_le _ _
      neg' A := by simp
      smul' c A := by simp [norm_smul] }
  | .inr y =>
    { toFun A := ‖(A.toCLM†) y‖
      map_zero' := by simp
      add_le' A B := by simpa using norm_add_le _ _
      neg' A := by simp
      smul' c A := by simp [map_smulₛₗ, norm_smul] }

@[simp]
theorem seminormFamily_inl (x : E) (A : ContinuousLinearMapStrongStar 𝕜 E F) :
    seminormFamily 𝕜 E F (.inl x) A = ‖A.toCLM x‖ :=
  (rfl)

@[simp]
theorem seminormFamily_inr (y : F) (A : ContinuousLinearMapStrongStar 𝕜 E F) :
    seminormFamily 𝕜 E F (.inr y) A = ‖(A.toCLM†) y‖ :=
  (rfl)

/-- The strong-star topology is the topology of the seminorms `A ↦ ‖A x‖` and `A ↦ ‖A† y‖`. -/
theorem withSeminorms : WithSeminorms (seminormFamily 𝕜 E F) := by
  refine (seminormFamily 𝕜 E F).withSeminorms_iff_nhds_eq_iInf.2 ?_
  rw [isInducing_inducingFn.nhds_eq_comap, map_zero, Prod.zero_eq_mk, nhds_prod_eq,
    Filter.prod_eq_inf, nhds_pi, nhds_pi, Filter.pi, Filter.pi, iInf_sum, comap_inf]
  simp only [comap_iInf, comap_comap, Pi.zero_apply]
  -- Each coordinate neighbourhood filter `𝓝 0` is the pullback of `𝓝 0` along the norm, and
  -- the seminorms are by definition the norms of the coordinates.
  congr 1 <;> refine iInf_congr fun x ↦ ?_ <;> rw [← comap_norm_nhds_zero, comap_comap] <;> rfl

instance instLocallyConvexSpace [Module ℝ (ContinuousLinearMapStrongStar 𝕜 E F)]
    [IsScalarTower ℝ 𝕜 (ContinuousLinearMapStrongStar 𝕜 E F)] :
    LocallyConvexSpace ℝ (ContinuousLinearMapStrongStar 𝕜 E F) :=
  withSeminorms.toLocallyConvexSpace

end Seminorms

/-! ### Continuity of the adjoint and of multiplication -/

section Adjoint

variable [CompleteSpace E] [CompleteSpace F]

/-- The adjoint is continuous from the strong-star copy of `E →L[𝕜] F` to that of
`F →L[𝕜] E`. -/
@[fun_prop]
theorem continuous_adjoint :
    Continuous fun A : ContinuousLinearMapStrongStar 𝕜 E F ↦ ofCLM (A.toCLM†) :=
  continuous_of_continuous_apply continuous_adjoint_apply fun x ↦ by
    simpa using continuous_toCLM_apply x

end Adjoint

/-! ### Matrix entries of operators on a finite Hilbert sum -/

section PiLp

variable {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
  [Fintype ι] [DecidableEq ι]

/-- Taking the `(i, j)` matrix entry of an operator on the Hilbert sum `PiLp 2 (fun _ : ι => H)`
is continuous for the strong-star topologies. -/
theorem continuous_piLpEntry (i j : ι) :
    Continuous fun Y : ContinuousLinearMapStrongStar 𝕜 (PiLp 2 (fun _ : ι => H))
      (PiLp 2 (fun _ : ι => H)) => ofCLM (Y.toCLM.piLpEntry i j) := by
  refine continuous_of_continuous_apply (fun v => ?_) fun v => ?_
  · simpa only [ContinuousLinearMap.piLpEntry_apply, PiLp.proj_apply, Function.comp_def] using
      (PiLp.proj 2 (𝕜 := 𝕜) (fun _ : ι => H) i).continuous.comp
        (continuous_toCLM_apply (PiLp.single 2 (β := fun _ : ι => H) j v))
  · -- The adjoint of the `(i, j)` entry is the `(j, i)` entry of the adjoint.
    refine ((PiLp.proj 2 (𝕜 := 𝕜) (fun _ : ι => H) j).continuous.comp
      (continuous_adjoint_apply (PiLp.single 2 (β := fun _ : ι => H) i v))).congr fun Y => ?_
    simp [← ContinuousLinearMap.star_eq_adjoint, ← ContinuousLinearMap.piLpEntry_star]

end PiLp

section Ring

variable [CompleteSpace E]

/-- The adjoint is strong-star continuous. -/
instance instContinuousStar : ContinuousStar (ContinuousLinearMapStrongStar 𝕜 E E) where
  continuous_star := (continuous_adjoint (F := E)).congr fun A ↦ by
    ext1
    simp [ContinuousLinearMap.star_eq_adjoint]

/-- Multiplication of operators is separately strong-star continuous. -/
instance instIsSemitopologicalRing : IsSemitopologicalRing (ContinuousLinearMapStrongStar 𝕜 E E)
    where
  continuous_const_mul {A} := continuous_of_continuous_apply
    (fun x ↦ A.toCLM.continuous.comp (continuous_toCLM_apply x))
    (fun y ↦ by
      simpa [ContinuousLinearMap.mul_def, ContinuousLinearMap.adjoint_comp] using
        continuous_adjoint_apply ((A.toCLM†) y))
  continuous_mul_const {A} := continuous_of_continuous_apply
    (fun x ↦ continuous_toCLM_apply (A.toCLM x))
    (fun y ↦ by
      simpa [ContinuousLinearMap.mul_def, ContinuousLinearMap.adjoint_comp, Function.comp_def]
        using (A.toCLM†).continuous.comp (continuous_adjoint_apply y))

end Ring

/-! ### Comparison with the norm, strong and weak operator topologies -/

section Comparison

variable [CompleteSpace E] [CompleteSpace F]

/-- The strong-star topology is coarser than the norm topology. -/
@[fun_prop]
theorem continuous_ofCLM :
    Continuous (ofCLM : (E →L[𝕜] F) → ContinuousLinearMapStrongStar 𝕜 E F) :=
  continuous_of_continuous_apply (fun x ↦ continuous_eval_const x) fun y ↦
    (continuous_eval_const y).comp (ContinuousLinearMap.adjoint (𝕜 := 𝕜) (E := E)
      (F := F)).continuous

/-- The strong-star topology is finer than the strong operator topology. -/
@[fun_prop]
theorem continuous_toPointwiseConvergenceCLM :
    Continuous fun A : ContinuousLinearMapStrongStar 𝕜 E F ↦
      ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E F A.toCLM :=
  -- Evaluation of `toPointwiseConvergenceCLM … T` is definitionally evaluation of `T`.
  PointwiseConvergenceCLM.continuous_of_continuous_eval continuous_toCLM_apply

/-- The strong-star topology is finer than the weak operator topology. -/
@[fun_prop]
theorem continuous_toWOT :
    Continuous fun A : ContinuousLinearMapStrongStar 𝕜 E F ↦
      ContinuousLinearMapWOT.ofCLM A.toCLM :=
  ContinuousLinearMapWOT.continuous_ofPointwiseConvergenceCLM.comp
    continuous_toPointwiseConvergenceCLM

/-- A set of operators which is closed in the weak operator topology is closed in the strong-star
topology. -/
theorem isClosed_image_ofCLM_of_isClosed_image_wot {s : Set (E →L[𝕜] F)}
    (hs : IsClosed (ContinuousLinearMapWOT.ofCLM '' s)) : IsClosed (ofCLM '' s) := by
  -- The preimage is along the continuous identity to the weak operator copy.
  convert hs.preimage continuous_toWOT using 1
  ext A
  rw [Set.mem_preimage, ContinuousLinearMapWOT.ofCLM_injective.mem_set_image]
  exact ⟨by rintro ⟨x, hx, rfl⟩; exact hx, fun hA ↦ ⟨A.toCLM, hA, rfl⟩⟩

end Comparison

section Normal

variable [CompleteSpace E]

/-- **Agreement with the strong operator topology on normal operators.** For a net of normal
operators and a normal limit, strong-star convergence is equivalent to strong convergence. -/
theorem tendsto_iff_tendsto_toPointwiseConvergenceCLM_of_isStarNormal {α : Type*}
    {l : Filter α} {f : α → ContinuousLinearMapStrongStar 𝕜 E E}
    {A : ContinuousLinearMapStrongStar 𝕜 E E} (hf : ∀ᶠ a in l, IsStarNormal (f a).toCLM)
    (hA : IsStarNormal A.toCLM) :
    Tendsto f l (𝓝 A) ↔
      Tendsto (fun a ↦ ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E E
        (f a).toCLM) l (𝓝 (ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E E
          A.toCLM)) := by
  refine ⟨fun h ↦ (continuous_toPointwiseConvergenceCLM.tendsto A).comp h, fun h ↦ ?_⟩
  rw [PointwiseConvergenceCLM.tendsto_iff_forall_tendsto] at h
  simp only [ContinuousLinearMap.toPointwiseConvergenceCLM_apply] at h
  exact tendsto_iff_forall_tendsto.2
    ⟨h, ContinuousLinearMap.tendsto_adjoint_apply_of_isStarNormal hf hA h⟩

/-- **Agreement with the strong operator topology on normal operators.** On a set of normal
operators, the strong-star topology is the subspace topology of the strong operator topology. -/
theorem isInducing_restrict_toPointwiseConvergenceCLM_of_isStarNormal
    {s : Set (ContinuousLinearMapStrongStar 𝕜 E E)} (hs : ∀ A ∈ s, IsStarNormal A.toCLM) :
    IsInducing (s.domRestrict fun A : ContinuousLinearMapStrongStar 𝕜 E E ↦
      ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E E A.toCLM) := by
  refine isInducing_iff_nhds.2 fun A ↦ le_antisymm
    ((continuous_toPointwiseConvergenceCLM.comp continuous_subtypeVal).tendsto A).le_comap ?_
  rw [nhds_subtype, ← tendsto_iff_comap]
  exact (tendsto_iff_tendsto_toPointwiseConvergenceCLM_of_isStarNormal
    (Eventually.of_forall fun B : s ↦ hs B B.property) (hs A A.property)).2 tendsto_comap

/-- **Agreement of closures on normal operators.** A normal operator lies in the strong-star
closure of a set of normal operators exactly when it lies in its strong operator closure. -/
theorem mem_closure_iff_of_isStarNormal {s : Set (ContinuousLinearMapStrongStar 𝕜 E E)}
    {A : ContinuousLinearMapStrongStar 𝕜 E E} (hs : ∀ B ∈ s, IsStarNormal B.toCLM)
    (hA : IsStarNormal A.toCLM) :
    A ∈ closure s ↔ ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E E A.toCLM ∈
      closure ((fun B : ContinuousLinearMapStrongStar 𝕜 E E ↦
        ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E E B.toCLM) '' s) := by
  -- Pass to the subspace `insert A s`, on which the two topologies agree.
  have hi := isInducing_restrict_toPointwiseConvergenceCLM_of_isStarNormal
    (Set.forall_mem_insert.2 ⟨hA, hs⟩)
  have h := congrArg (⟨A, Set.mem_insert A s⟩ ∈ ·)
    ((IsInducing.subtypeVal.closure_eq_preimage_closure_image (Subtype.val ⁻¹' s)).symm.trans
      (hi.closure_eq_preimage_closure_image _))
  simp only [Set.mem_preimage, Subtype.image_preimage_coe,
    Set.inter_eq_right.2 (Set.subset_insert A s), Set.image_domRestrict,
    Set.inter_eq_left.2 (Set.subset_insert A s),
    Set.domRestrict_apply] at h
  exact Iff.of_eq h

/-- **Agreement of closures on normal operators.** If the strong operator closure of a set `s` of
operators is a set `t` of normal operators, then `t` is also the strong-star closure of `s`. -/
theorem closure_image_ofCLM_eq_of_isStarNormal {s t : Set (E →L[𝕜] E)}
    (ht : ∀ x ∈ t, IsStarNormal x)
    (h : closure (ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E E '' s) =
      ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E E '' t) :
    closure (ofCLM '' s) = ofCLM '' t := by
  -- `s` lies in its strong closure `t`, so it consists of normal operators as well.
  have hs' : ∀ B ∈ ofCLM '' s, IsStarNormal B.toCLM := by
    rintro _ ⟨b, hb, rfl⟩
    exact ht b (ContinuousLinearMap.toPointwiseConvergenceCLM_injective.mem_set_image.mp
      (h ▸ subset_closure ⟨b, hb, rfl⟩))
  ext A
  obtain ⟨x, rfl⟩ : ∃ x, ofCLM x = A := ⟨A.toCLM, ofCLM_toCLM A⟩
  rw [ofCLM_injective.mem_set_image]
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · have := mem_closure_image continuous_toPointwiseConvergenceCLM.continuousAt hx
    rw [Set.image_image, h] at this
    exact ContinuousLinearMap.toPointwiseConvergenceCLM_injective.mem_set_image.mp this
  · rw [mem_closure_iff_of_isStarNormal hs' (ht x hx), Set.image_image, h]
    exact ⟨x, hx, rfl⟩

end Normal

