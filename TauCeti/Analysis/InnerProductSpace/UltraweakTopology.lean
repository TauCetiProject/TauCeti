/-!
# The ultraweak operator topology

The ultraweak (σ-weak) topology on bounded operators `E →L[𝕜] F` between inner product spaces is
generated by the functionals `T ↦ ∑ₙ ⟪ηₙ, T ξₙ⟫`, one for each pair of square-summable sequences
`ξ ∈ ℓ²(ℕ, E)` and `η ∈ ℓ²(ℕ, F)`. These are the matrix coefficients `⟪η, (⊕ₙ T) ξ⟫` of the
ampliation `⊕ₙ T` on `ℓ²(ℕ, E)`, so the ultraweak topology is the weak operator topology
transported along the ampliation. A net `Tᵢ` converges ultraweakly to `T` exactly when
`∑ₙ ⟪ηₙ, Tᵢ ξₙ⟫ → ∑ₙ ⟪ηₙ, T ξₙ⟫` for all such `ξ` and `η`
(`TauCeti.ContinuousLinearMapUltraweak.tendsto_iff_forall_tsum_inner_apply_tendsto`).

The topology lives on the type copy `TauCeti.ContinuousLinearMapUltraweak 𝕜 E F`, in the manner of
Mathlib's `E →WOT[𝕜] F`. The copy is a Hausdorff locally convex topological vector space, with the
seminorms `‖⟪η, (⊕ T) ξ⟫‖` (`withSeminorms`). On operators of a Hilbert space the adjoint is
ultraweakly continuous and multiplication is separately continuous, so commutants are ultraweakly
closed (`isClosed_image_ofCLM_centralizer`).

The ultraweak topology sits between the others: it is coarser than the ultrastrong topology of
`TauCeti.ContinuousLinearMapUltrastrong` and finer than the weak operator topology
(`continuous_ofUltrastrong`, `continuous_toWOT`). On norm-bounded sets it agrees with the weak
operator topology (`isInducing_restrict_toWOT`): for a uniformly bounded net, weak operator and
ultraweak convergence are equivalent, and every closed norm ball of operators into a Hilbert space
is ultraweakly compact (`isCompact_image_ofCLM_closedBall`).

When `F` is complete, Riesz representation on `ℓ²(ℕ, F)` turns the ultrastrong dual factorization
into a single matrix coefficient `A ↦ ⟪η, (⊕ₙ A) ξ⟫ = ∑ₙ ⟪ηₙ, A ξₙ⟫`
(`ContinuousLinearMapUltrastrong.exists_tsum_inner_apply_eq`). Every ultrastrongly continuous
linear functional is therefore ultraweakly continuous, the two topologies have the same continuous
linear functionals (`ContinuousLinearMapUltraweak.exists_tsum_inner_apply_eq`), and any convex set
of operators has the same ultrastrong and ultraweak closures
(`Convex.ultrastrong_ofCLM_mem_closure_image_iff`).

## Implementation notes

As for the ultrastrong copy, the algebraic structure is transported from `E →L[𝕜] F` along
`ContinuousLinearMapUltraweak.equiv` and the definitions are exposed, so that the transport and
the agreement of the uniform structure with the topology hold by definition downstream.
The seminorms are not exposed; they are used through `seminorm_apply` and `seminormFamily_apply`.

## References

* J. Dixmier, *Von Neumann Algebras*, North-Holland, 1981, Part I, Chapter 3, §§1, 3.
* M. Takesaki, *Theory of Operator Algebras I*, Springer, 1979, Chapter II, §2.
-/

@[expose] public section

open Filter Topology
open scoped lp ENNReal InnerProduct InnerProductSpace

namespace TauCeti

/-- The type copy of `E →L[𝕜] F` endowed with the ultraweak operator topology: the coarsest
topology for which the matrix coefficient `T ↦ ⟪η, (⊕ₙ T) ξ⟫ = ∑ₙ ⟪ηₙ, T ξₙ⟫` is continuous for all
`ξ ∈ ℓ²(ℕ, E)` and `η ∈ ℓ²(ℕ, F)`. -/
@[ext]
structure ContinuousLinearMapUltraweak (𝕜 E F : Type*) [RCLike 𝕜]
    [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
    where
  /-- Regard a bounded operator as an element of the ultraweak copy. -/
  ofCLM ::
  /-- The bounded operator underlying an element of the ultraweak copy. -/
  toCLM : E →L[𝕜] F

namespace ContinuousLinearMapUltraweak

variable {𝕜 E F : Type*} [RCLike 𝕜]
  [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]

/-! ### Algebraic structure, copied from `E →L[𝕜] F` -/

section Algebra

/-- The equivalence between the ultraweak copy and `E →L[𝕜] F`. -/
@[simps]
def equiv : ContinuousLinearMapUltraweak 𝕜 E F ≃ (E →L[𝕜] F) where
  toFun := toCLM
  invFun := ofCLM
  left_inv _ := rfl
  right_inv _ := rfl

theorem toCLM_injective :
    Function.Injective (toCLM : ContinuousLinearMapUltraweak 𝕜 E F → E →L[𝕜] F) :=
  equiv.injective

theorem ofCLM_injective :
    Function.Injective (ofCLM : (E →L[𝕜] F) → ContinuousLinearMapUltraweak 𝕜 E F) :=
  equiv.symm.injective

theorem ofCLM_surjective :
    Function.Surjective (ofCLM : (E →L[𝕜] F) → ContinuousLinearMapUltraweak 𝕜 E F) :=
  equiv.symm.surjective

instance instAddCommGroup : AddCommGroup (ContinuousLinearMapUltraweak 𝕜 E F) :=
  equiv.addCommGroup

/-- The additive equivalence between the ultraweak copy and `E →L[𝕜] F`. -/
@[implicit_reducible, simps!]
def addEquiv : ContinuousLinearMapUltraweak 𝕜 E F ≃+ (E →L[𝕜] F) where
  __ := equiv
  map_add' _ _ := rfl

instance instSMul {S : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F] [ContinuousConstSMul S F] :
    SMul S (ContinuousLinearMapUltraweak 𝕜 E F) :=
  equiv.smul S

instance instModule {S : Type*} [Semiring S] [Module S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] : Module S (ContinuousLinearMapUltraweak 𝕜 E F) :=
  addEquiv.module S

instance instIsScalarTower {S T : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] [DistribSMul T F] [SMulCommClass 𝕜 T F] [ContinuousConstSMul T F]
    [SMul S T] [IsScalarTower S T F] : IsScalarTower S T (ContinuousLinearMapUltraweak 𝕜 E F) :=
  equiv.isScalarTower S T

instance instRing : Ring (ContinuousLinearMapUltraweak 𝕜 E E) :=
  equiv.ring

@[simp] theorem toCLM_zero : (0 : ContinuousLinearMapUltraweak 𝕜 E F).toCLM = 0 := rfl

@[simp] theorem toCLM_add (A B : ContinuousLinearMapUltraweak 𝕜 E F) :
    (A + B).toCLM = A.toCLM + B.toCLM := rfl

@[simp] theorem toCLM_neg (A : ContinuousLinearMapUltraweak 𝕜 E F) : (-A).toCLM = -A.toCLM :=
  rfl

@[simp] theorem toCLM_sub (A B : ContinuousLinearMapUltraweak 𝕜 E F) :
    (A - B).toCLM = A.toCLM - B.toCLM := rfl

@[simp] theorem toCLM_smul {S : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] (c : S) (A : ContinuousLinearMapUltraweak 𝕜 E F) :
    (c • A).toCLM = c • A.toCLM := rfl

@[simp] theorem toCLM_one : (1 : ContinuousLinearMapUltraweak 𝕜 E E).toCLM = 1 := rfl

@[simp] theorem toCLM_mul (A B : ContinuousLinearMapUltraweak 𝕜 E E) :
    (A * B).toCLM = A.toCLM * B.toCLM := rfl

@[simp] theorem ofCLM_mul (A B : E →L[𝕜] E) :
    ofCLM (A * B) = (ofCLM A : ContinuousLinearMapUltraweak 𝕜 E E) * ofCLM B := rfl

/-- The linear equivalence between the ultraweak copy and `E →L[𝕜] F`. -/
@[simps!]
def linearEquiv (S : Type*) [Semiring S] [Module S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] : ContinuousLinearMapUltraweak 𝕜 E F ≃ₗ[S] (E →L[𝕜] F) :=
  (addEquiv (𝕜 := 𝕜) (E := E) (F := F)).linearEquiv S

variable [CompleteSpace E]

noncomputable instance instStarRing : StarRing (ContinuousLinearMapUltraweak 𝕜 E E) :=
  equiv.starRing

instance instStarModule : StarModule 𝕜 (ContinuousLinearMapUltraweak 𝕜 E E) :=
  equiv.starModule 𝕜

@[simp] theorem toCLM_star (A : ContinuousLinearMapUltraweak 𝕜 E E) :
    (star A).toCLM = star A.toCLM := rfl

@[simp] theorem ofCLM_star (A : E →L[𝕜] E) :
    ofCLM (star A) = star (ofCLM A : ContinuousLinearMapUltraweak 𝕜 E E) := rfl

end Algebra

/-! ### The topology -/

section Topology

variable (𝕜 E F) in
/-- The linear map inducing the ultraweak topology: an operator `A` is sent to its matrix
coefficients `(ξ, η) ↦ ⟪η, (⊕ₙ A) ξ⟫` on `ℓ²(ℕ, E) × ℓ²(ℕ, F)`. -/
noncomputable def inducingFn :
    ContinuousLinearMapUltraweak 𝕜 E F →ₗ[𝕜] (ℓ²(ℕ, E) × ℓ²(ℕ, F) → 𝕜) where
  toFun A p := ⟪p.2, lp.ampliation ℕ 2 A.toCLM p.1⟫_𝕜
  map_add' A B := by ext p; simp [inner_add_right]
  map_smul' c A := by ext p; simp [inner_smul_right]

@[simp]
theorem inducingFn_apply (A : ContinuousLinearMapUltraweak 𝕜 E F) (ξ : ℓ²(ℕ, E))
    (η : ℓ²(ℕ, F)) : inducingFn 𝕜 E F A (ξ, η) = ⟪η, lp.ampliation ℕ 2 A.toCLM ξ⟫_𝕜 :=
  rfl

/-- The ultraweak topology is the coarsest topology for which `A ↦ ⟪η, (⊕ₙ A) ξ⟫` is continuous
for all `ξ ∈ ℓ²(ℕ, E)` and `η ∈ ℓ²(ℕ, F)`. -/
noncomputable instance instTopologicalSpace :
    TopologicalSpace (ContinuousLinearMapUltraweak 𝕜 E F) :=
  .induced (inducingFn 𝕜 E F) Pi.topologicalSpace

theorem isInducing_inducingFn : IsInducing (inducingFn 𝕜 E F) := ⟨rfl⟩

theorem isEmbedding_inducingFn : IsEmbedding (inducingFn 𝕜 E F) := by
  classical
  refine Function.Injective.isEmbedding_induced fun A B hAB ↦ ?_
  ext x
  refine ext_inner_left 𝕜 fun y ↦ ?_
  simpa [lp.inner_single_left] using congr_fun hAB (lp.single 2 0 x, lp.single 2 0 y)

@[fun_prop]
theorem continuous_inner_ampliation_apply (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)) :
    Continuous fun A : ContinuousLinearMapUltraweak 𝕜 E F ↦ ⟪η, lp.ampliation ℕ 2 A.toCLM ξ⟫_𝕜 :=
  (continuous_apply (ξ, η)).comp (continuous_induced_dom (f := inducingFn 𝕜 E F))

theorem continuous_of_continuous_inner_ampliation_apply {α : Type*} [TopologicalSpace α]
    {g : α → ContinuousLinearMapUltraweak 𝕜 E F}
    (h : ∀ (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)),
      Continuous fun a ↦ ⟪η, lp.ampliation ℕ 2 (g a).toCLM ξ⟫_𝕜) : Continuous g :=
  continuous_induced_rng.2 (continuous_pi fun p ↦ h p.1 p.2)

/-- A net converges ultraweakly exactly when every matrix coefficient of its ampliations
converges. -/
theorem tendsto_iff_forall_inner_ampliation_apply_tendsto {α : Type*} {l : Filter α}
    {f : α → ContinuousLinearMapUltraweak 𝕜 E F} {A : ContinuousLinearMapUltraweak 𝕜 E F} :
    Tendsto f l (𝓝 A) ↔ ∀ (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)),
      Tendsto (fun a ↦ ⟪η, lp.ampliation ℕ 2 (f a).toCLM ξ⟫_𝕜) l
        (𝓝 ⟪η, lp.ampliation ℕ 2 A.toCLM ξ⟫_𝕜) := by
  simp only [isInducing_inducingFn.tendsto_nhds_iff, tendsto_pi_nhds, Prod.forall,
    Function.comp_apply, inducingFn_apply]

/-- **The ultraweak criterion.** A net `Tᵢ` converges ultraweakly to `T` exactly when
`∑ₙ ⟪ηₙ, Tᵢ ξₙ⟫ → ∑ₙ ⟪ηₙ, T ξₙ⟫` for all square-summable sequences `ξ` and `η`. -/
theorem tendsto_iff_forall_tsum_inner_apply_tendsto {α : Type*} {l : Filter α}
    {f : α → ContinuousLinearMapUltraweak 𝕜 E F} {A : ContinuousLinearMapUltraweak 𝕜 E F} :
    Tendsto f l (𝓝 A) ↔ ∀ (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)),
      Tendsto (fun a ↦ ∑' n, ⟪η n, (f a).toCLM (ξ n)⟫_𝕜) l
        (𝓝 (∑' n, ⟪η n, A.toCLM (ξ n)⟫_𝕜)) := by
  simp only [tendsto_iff_forall_inner_ampliation_apply_tendsto, lp.inner_ampliation_apply]

instance instT3Space : T3Space (ContinuousLinearMapUltraweak 𝕜 E F) :=
  isEmbedding_inducingFn.t3Space

instance instIsTopologicalAddGroup : IsTopologicalAddGroup (ContinuousLinearMapUltraweak 𝕜 E F)
    where
  toContinuousAdd := .induced (inducingFn 𝕜 E F)
  toContinuousNeg := .induced (inducingFn 𝕜 E F)

instance instContinuousSMul : ContinuousSMul 𝕜 (ContinuousLinearMapUltraweak 𝕜 E F) :=
  .induced (inducingFn 𝕜 E F)

noncomputable instance instUniformSpace : UniformSpace (ContinuousLinearMapUltraweak 𝕜 E F) :=
  .comap (inducingFn 𝕜 E F) inferInstance

instance instIsUniformAddGroup : IsUniformAddGroup (ContinuousLinearMapUltraweak 𝕜 E F) :=
  .comap (inducingFn 𝕜 E F)

end Topology

/-! ### The ultraweak seminorms -/

section Seminorms

/-- The ultraweak seminorm `A ↦ ‖⟪η, (⊕ₙ A) ξ⟫‖ = ‖∑ₙ ⟪ηₙ, A ξₙ⟫‖` attached to
`ξ ∈ ℓ²(ℕ, E)` and `η ∈ ℓ²(ℕ, F)`. -/
@[no_expose] noncomputable def seminorm (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)) :
    Seminorm 𝕜 (ContinuousLinearMapUltraweak 𝕜 E F) where
  toFun A := ‖⟪η, lp.ampliation ℕ 2 A.toCLM ξ⟫_𝕜‖
  map_zero' := by simp
  add_le' A B := by simpa [inner_add_right] using norm_add_le _ _
  neg' A := by simp
  smul' r A := by simp [inner_smul_right]

@[simp]
theorem seminorm_apply (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)) (A : ContinuousLinearMapUltraweak 𝕜 E F) :
    seminorm ξ η A = ‖⟪η, lp.ampliation ℕ 2 A.toCLM ξ⟫_𝕜‖ :=
  (rfl)

variable (𝕜 E F) in
/-- The family of seminorms inducing the ultraweak topology. -/
@[no_expose] noncomputable def seminormFamily :
    SeminormFamily 𝕜 (ContinuousLinearMapUltraweak 𝕜 E F) (ℓ²(ℕ, E) × ℓ²(ℕ, F)) :=
  fun p ↦ seminorm p.1 p.2

@[simp]
theorem seminormFamily_apply (p : ℓ²(ℕ, E) × ℓ²(ℕ, F)) :
    seminormFamily 𝕜 E F p = seminorm p.1 p.2 :=
  (rfl)

theorem withSeminorms : WithSeminorms (seminormFamily 𝕜 E F) :=
  let e : ℓ²(ℕ, E) × ℓ²(ℕ, F) ≃ (Σ _ : ℓ²(ℕ, E) × ℓ²(ℕ, F), Unit) := .symm <| .sigmaUnique _ _
  isInducing_inducingFn.withSeminorms (withSeminorms_pi fun _ ↦ norm_withSeminorms 𝕜 𝕜)
    |>.congr_equiv e

instance instLocallyConvexSpace [Module ℝ (ContinuousLinearMapUltraweak 𝕜 E F)]
    [IsScalarTower ℝ 𝕜 (ContinuousLinearMapUltraweak 𝕜 E F)] :
    LocallyConvexSpace ℝ (ContinuousLinearMapUltraweak 𝕜 E F) :=
  withSeminorms.toLocallyConvexSpace

end Seminorms

/-! ### Continuity of the adjoint and of multiplication -/

section Hilbert

variable [CompleteSpace E]

/-- The adjoint is ultraweakly continuous. -/
instance instContinuousStar : ContinuousStar (ContinuousLinearMapUltraweak 𝕜 E E) where
  continuous_star := continuous_of_continuous_inner_ampliation_apply fun ξ η ↦ by
    refine (continuous_star.comp (continuous_inner_ampliation_apply (𝕜 := 𝕜) η ξ)).congr
      fun A ↦ ?_
    simpa [ContinuousLinearMap.star_eq_adjoint] using
      (ContinuousLinearMap.adjoint_inner_right (lp.ampliation ℕ 2 A.toCLM) η ξ).symm

/-- Multiplication of operators is separately ultraweakly continuous. -/
instance instIsSemitopologicalRing : IsSemitopologicalRing (ContinuousLinearMapUltraweak 𝕜 E E)
    where
  continuous_const_mul {A} := continuous_of_continuous_inner_ampliation_apply fun ξ η ↦ by
    refine (continuous_inner_ampliation_apply ξ (((lp.ampliation ℕ 2 A.toCLM)†) η)).congr
      fun B ↦ ?_
    rw [ContinuousLinearMap.adjoint_inner_left]
    simp
  continuous_mul_const {A} := continuous_of_continuous_inner_ampliation_apply fun ξ η ↦ by
    simpa using continuous_inner_ampliation_apply (lp.ampliation ℕ 2 A.toCLM ξ) η

/-- The commutant of any set of operators on a Hilbert space is closed in the ultraweak operator
topology. -/
theorem isClosed_image_ofCLM_centralizer (s : Set (E →L[𝕜] E)) :
    IsClosed (ofCLM '' s.centralizer : Set (ContinuousLinearMapUltraweak 𝕜 E E)) := by
  have h : (ofCLM '' s.centralizer : Set (ContinuousLinearMapUltraweak 𝕜 E E)) =
      (ofCLM '' s).centralizer := by
    ext T
    obtain ⟨T, rfl⟩ := ofCLM_surjective T
    rw [ofCLM_injective.mem_set_image]
    simp only [Set.mem_centralizer_iff, Set.forall_mem_image, ← ofCLM_mul, ofCLM_injective.eq_iff]
  rw [h]
  exact Set.isClosed_centralizer _

end Hilbert

/-! ### Comparison with the norm, ultrastrong and weak operator topologies -/

section Comparison

/-- The ultraweak topology is coarser than the ultrastrong topology. -/
@[fun_prop]
theorem continuous_ofUltrastrong :
    Continuous fun A : ContinuousLinearMapUltrastrong 𝕜 E F ↦ ofCLM (F := F) A.toCLM :=
  continuous_of_continuous_inner_ampliation_apply fun ξ _ ↦
    continuous_const.inner (ContinuousLinearMapUltrastrong.continuous_ampliation_apply ξ)

/-- The ultraweak topology is coarser than the norm topology. -/
@[fun_prop]
theorem continuous_ofCLM :
    Continuous (ofCLM : (E →L[𝕜] F) → ContinuousLinearMapUltraweak 𝕜 E F) :=
  continuous_ofUltrastrong.comp ContinuousLinearMapUltrastrong.continuous_ofCLM

variable [CompleteSpace F]

/-- The ultraweak topology is finer than the weak operator topology. -/
@[fun_prop]
theorem continuous_toWOT :
    Continuous fun A : ContinuousLinearMapUltraweak 𝕜 E F ↦
      ContinuousLinearMapWOT.ofCLM A.toCLM := by
  classical
  refine ContinuousLinearMapWOT.continuous_iff.2 fun x y ↦ ?_
  refine (continuous_inner_ampliation_apply (lp.single 2 0 x) (lp.single 2 0 y)).congr
    fun A ↦ ?_
  simp [lp.inner_single_left]

/-- **Bounded-set agreement with the weak operator topology.** For a net of operators that is
eventually bounded in norm, ultraweak convergence is equivalent to weak operator convergence. -/
theorem tendsto_iff_tendsto_toWOT_of_eventually_norm_le {α : Type*} {l : Filter α}
    {f : α → ContinuousLinearMapUltraweak 𝕜 E F} {A : ContinuousLinearMapUltraweak 𝕜 E F}
    {C : ℝ} (hC : ∀ᶠ a in l, ‖(f a).toCLM‖ ≤ C) :
    Tendsto f l (𝓝 A) ↔ Tendsto (fun a ↦ ContinuousLinearMapWOT.ofCLM (f a).toCLM) l
      (𝓝 (ContinuousLinearMapWOT.ofCLM A.toCLM)) := by
  classical
  refine ⟨fun h ↦ (continuous_toWOT.tendsto A).comp h, fun h ↦ ?_⟩
  rw [ContinuousLinearMapWOT.tendsto_iff_forall_inner_apply_tendsto] at h
  rw [tendsto_iff_forall_inner_ampliation_apply_tendsto]
  intro ξ η
  -- Apply the coordinate-vector density argument to the functionals `⟪η, (⊕ Tₐ) ·⟫`.
  refine lp.tendsto_apply_of_tendsto_apply_single (E := fun _ : ℕ ↦ E) (p := 2) (f := fun a ↦
      innerSL 𝕜 η ∘L lp.ampliation ℕ 2 (f a).toCLM) (g := innerSL 𝕜 η ∘L lp.ampliation ℕ 2 A.toCLM)
    ENNReal.ofNat_ne_top (C := ‖η‖ * C) ?_ (fun n x ↦ ?_) ξ
  · filter_upwards [hC] with a ha
    refine (ContinuousLinearMap.opNorm_comp_le _ _).trans ?_
    rw [innerSL_apply_norm]
    gcongr
    exact (lp.norm_ampliation_le _).trans ha
  · simpa [lp.inner_single_right] using h x (η n)

/-- **Bounded-set agreement with the weak operator topology.** On a norm-bounded set of
operators, the ultraweak topology is the subspace topology of the weak operator topology. -/
theorem isInducing_restrict_toWOT {s : Set (ContinuousLinearMapUltraweak 𝕜 E F)} {C : ℝ}
    (hs : ∀ A ∈ s, ‖A.toCLM‖ ≤ C) :
    IsInducing (s.domRestrict fun A : ContinuousLinearMapUltraweak 𝕜 E F ↦
      ContinuousLinearMapWOT.ofCLM A.toCLM) := by
  refine isInducing_iff_nhds.2 fun A ↦ le_antisymm
    ((continuous_toWOT.comp continuous_subtype_val).tendsto A).le_comap ?_
  rw [nhds_subtype, ← tendsto_iff_comap]
  exact (tendsto_iff_tendsto_toWOT_of_eventually_norm_le
    (Eventually.of_forall fun B : s ↦ hs B B.2)).2 tendsto_comap

/-- **Ultraweak compactness of operator balls.** Every closed norm ball of bounded operators from
an inner product space to a Hilbert space is compact in the ultraweak operator topology. -/
theorem isCompact_image_ofCLM_closedBall (A : E →L[𝕜] F) (r : ℝ) :
    IsCompact (ofCLM '' Metric.closedBall A r : Set (ContinuousLinearMapUltraweak 𝕜 E F)) := by
  set s : Set (ContinuousLinearMapUltraweak 𝕜 E F) := ofCLM '' Metric.closedBall A r
  have hs : ∀ B ∈ s, ‖B.toCLM‖ ≤ r + ‖A‖ := by
    rintro _ ⟨T, hT, rfl⟩
    rw [Metric.mem_closedBall, dist_eq_norm] at hT
    calc ‖T‖ = ‖T - A + A‖ := by rw [sub_add_cancel]
      _ ≤ ‖T - A‖ + ‖A‖ := norm_add_le _ _
      _ ≤ r + ‖A‖ := by gcongr
  rw [isCompact_iff_compactSpace, ← isCompact_univ_iff,
    (isInducing_restrict_toWOT hs).isCompact_iff, Set.image_univ, Set.range_domRestrict]
  simpa only [s, Set.image_image] using ContinuousLinearMapWOT.isCompact_image_ofCLM_closedBall A r

/-- A norm-bounded set of operators from an inner product space to a Hilbert space has compact
closure in the ultraweak operator topology. -/
theorem isCompact_closure_image_ofCLM_of_isBounded {s : Set (E →L[𝕜] F)}
    (hs : Bornology.IsBounded s) :
    IsCompact (closure (ofCLM '' s : Set (ContinuousLinearMapUltraweak 𝕜 E F))) := by
  obtain ⟨r, hr⟩ := hs.subset_closedBall 0
  exact (isCompact_image_ofCLM_closedBall (0 : E →L[𝕜] F) r).closure_of_subset (Set.image_mono hr)

end Comparison

end ContinuousLinearMapUltraweak

namespace ContinuousLinearMapUltrastrong

variable {𝕜 E F : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace F]

/-- **Ultrastrongly continuous functionals into a Hilbert space.** Every ultrastrongly continuous
linear functional on `E →L[𝕜] F` is a single ampliation matrix coefficient
`A ↦ ⟪η, (⊕ₙ A) ξ⟫`. -/
theorem exists_inner_ampliation_apply_eq
    (φ : StrongDual 𝕜 (ContinuousLinearMapUltrastrong 𝕜 E F)) :
    ∃ (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)),
      ∀ A : ContinuousLinearMapUltrastrong 𝕜 E F, φ A = ⟪η, lp.ampliation ℕ 2 A.toCLM ξ⟫_𝕜 := by
  obtain ⟨ξ, G, hG⟩ := exists_strongDual_ampliation_apply_eq φ
  exact ⟨ξ, (InnerProductSpace.toDual 𝕜 ℓ²(ℕ, F)).symm G, fun A ↦ by simp [hG A]⟩

/-- **Series form of ultrastrongly continuous functionals.** Every ultrastrongly continuous linear
functional on `E →L[𝕜] F` has the form `A ↦ ∑ₙ ⟪ηₙ, A ξₙ⟫` for square-summable sequences
`ξ ∈ ℓ²(ℕ, E)` and `η ∈ ℓ²(ℕ, F)`. -/
theorem exists_tsum_inner_apply_eq (φ : StrongDual 𝕜 (ContinuousLinearMapUltrastrong 𝕜 E F)) :
    ∃ (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)),
      ∀ A : ContinuousLinearMapUltrastrong 𝕜 E F, φ A = ∑' n, ⟪η n, A.toCLM (ξ n)⟫_𝕜 := by
  obtain ⟨ξ, η, h⟩ := exists_inner_ampliation_apply_eq φ
  exact ⟨ξ, η, fun A ↦ by simp [h A, lp.inner_eq_tsum]⟩

end ContinuousLinearMapUltrastrong

namespace ContinuousLinearMapUltraweak

variable {𝕜 E F : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
  [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace F]

/-! ### Continuous linear functionals and convex closures -/

/-- Every linear functional on operators which is continuous for the ultrastrong topology is
continuous for the ultraweak topology. -/
theorem continuous_strongDual_apply_ultrastrong_ofCLM
    (φ : StrongDual 𝕜 (ContinuousLinearMapUltrastrong 𝕜 E F)) :
    Continuous fun A : ContinuousLinearMapUltraweak 𝕜 E F ↦
      φ (ContinuousLinearMapUltrastrong.ofCLM A.toCLM) := by
  obtain ⟨ξ, η, h⟩ := ContinuousLinearMapUltrastrong.exists_inner_ampliation_apply_eq φ
  simpa only [h] using continuous_inner_ampliation_apply ξ η

/-- **Continuous functionals in the ultraweak operator topology.** Every ultraweakly continuous
linear functional on `E →L[𝕜] F` is a single ampliation matrix coefficient
`A ↦ ⟪η, (⊕ₙ A) ξ⟫`. -/
theorem exists_inner_ampliation_apply_eq (φ : StrongDual 𝕜 (ContinuousLinearMapUltraweak 𝕜 E F)) :
    ∃ (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)),
      ∀ A : ContinuousLinearMapUltraweak 𝕜 E F, φ A = ⟪η, lp.ampliation ℕ 2 A.toCLM ξ⟫_𝕜 := by
  -- Precompose `φ` with the continuous identity map from the ultrastrong to the ultraweak copy.
  let ι : ContinuousLinearMapUltrastrong 𝕜 E F →L[𝕜] ContinuousLinearMapUltraweak 𝕜 E F :=
    ⟨(linearEquiv 𝕜).symm.toLinearMap ∘ₗ
      (ContinuousLinearMapUltrastrong.linearEquiv 𝕜).toLinearMap, continuous_ofUltrastrong⟩
  obtain ⟨ξ, η, h⟩ := ContinuousLinearMapUltrastrong.exists_inner_ampliation_apply_eq (φ.comp ι)
  exact ⟨ξ, η, fun A ↦ h (ContinuousLinearMapUltrastrong.ofCLM A.toCLM)⟩

/-- **Series form of ultraweakly continuous functionals.** Every ultraweakly continuous linear
functional on `E →L[𝕜] F` has the form `A ↦ ∑ₙ ⟪ηₙ, A ξₙ⟫` for square-summable sequences
`ξ ∈ ℓ²(ℕ, E)` and `η ∈ ℓ²(ℕ, F)`. -/
theorem exists_tsum_inner_apply_eq (φ : StrongDual 𝕜 (ContinuousLinearMapUltraweak 𝕜 E F)) :
    ∃ (ξ : ℓ²(ℕ, E)) (η : ℓ²(ℕ, F)),
      ∀ A : ContinuousLinearMapUltraweak 𝕜 E F, φ A = ∑' n, ⟪η n, A.toCLM (ξ n)⟫_𝕜 := by
  obtain ⟨ξ, η, h⟩ := exists_inner_ampliation_apply_eq φ
  exact ⟨ξ, η, fun A ↦ by simp [h A, lp.inner_eq_tsum]⟩

variable [NormedSpace ℝ F] [IsScalarTower ℝ 𝕜 F]

/-- For a convex set of operators into a Hilbert space, the ultrastrong and ultraweak closures
contain the same operators. -/
theorem _root_.Convex.ultrastrong_ofCLM_mem_closure_image_iff {s : Set (E →L[𝕜] F)}
    (hs : Convex ℝ s) {T : E →L[𝕜] F} :
    ContinuousLinearMapUltrastrong.ofCLM T ∈
        closure (ContinuousLinearMapUltrastrong.ofCLM '' s) ↔
      ofCLM T ∈ closure (ofCLM '' s) := by
  refine ⟨fun h ↦ map_mem_closure
    (f := fun A : ContinuousLinearMapUltrastrong 𝕜 E F ↦ ofCLM A.toCLM)
    continuous_ofUltrastrong h ?_, fun h ↦ ?_⟩
  · rintro _ ⟨a, ha, rfl⟩
    exact ⟨a, ha, rfl⟩
  · -- `e` is the identity on underlying operators, from the ultraweak to the ultrastrong copy.
    let e : ContinuousLinearMapUltraweak 𝕜 E F →ₗ[𝕜] ContinuousLinearMapUltrastrong 𝕜 E F :=
      (ContinuousLinearMapUltrastrong.linearEquiv 𝕜).symm.toLinearMap ∘ₗ
        (linearEquiv 𝕜).toLinearMap
    have he (a : E →L[𝕜] F) : e (ofCLM a) = ContinuousLinearMapUltrastrong.ofCLM a := rfl
    have hconv : Convex ℝ (ofCLM '' s) := hs.linear_image (linearEquiv ℝ).symm.toLinearMap
    have himage : e '' (ofCLM '' s) = ContinuousLinearMapUltrastrong.ofCLM '' s := by
      simp only [Set.image_image, he]
    exact himage ▸ he T ▸ e.image_closure_of_convex hconv
      (fun f ↦ continuous_strongDual_apply_ultrastrong_ofCLM f) ⟨_, h, rfl⟩

end ContinuousLinearMapUltraweak

end TauCeti
