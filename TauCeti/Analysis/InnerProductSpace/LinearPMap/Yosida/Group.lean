module

public import TauCeti.Analysis.InnerProductSpace.LinearPMap.Yosida.Basic
public import TauCeti.Analysis.Semigroups.Group.Unitary
public import Mathlib.Analysis.CStarAlgebra.Exponential

/-!
# Unitary groups of symmetric Yosida approximants

Each symmetric imaginary-shift Yosida approximant of a self-adjoint partial operator
generates a bounded strongly continuous unitary group.

## Provenance

Adapted from `ForTauCeti/Analysis/InnerProductSpace/LinearPMap/YosidaApproximation.lean`
in the Kitware DKPS formalization, Jon Crall and Claude Opus 5, Apache-2.0. That source
adapts Spectra `YosidaHille/Approximation/{Helpers,Defs}.lean`, copyright 2026 Spectra
Formalization Project, Adam Bornemann, Apache-2.0. Here the accepted signed-real Yosida
approximation and native strongly continuous group are used directly.
-/

public section

noncomputable section

open Complex NormedSpace
open scoped InnerProductSpace

namespace IsSelfAdjoint

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable {A : H →ₗ.[ℂ] H} (hA : IsSelfAdjoint A) (r : ℝ)

private def phase (t : ℝ) : selfAdjoint (H →L[ℂ] H) :=
  ⟨(t : ℂ) • A.symmetricYosidaApproximation r, by
    rw [selfAdjoint.mem_iff, star_smul,
      (hA.isSelfAdjoint_symmetricYosidaApproximation r).star_eq,
      Complex.star_def, Complex.conj_ofReal]⟩

private def flow (t : ℝ) : H →L[ℂ] H := selfAdjoint.expUnitary (phase hA r t)

private theorem flow_zero : flow hA r 0 = 1 := by
  have h : phase hA r 0 = 0 := by ext; simp [phase]
  simp [flow, h]

private theorem flow_add (s t : ℝ) : flow hA r (s + t) = flow hA r s * flow hA r t := by
  have hcomm : Commute ((phase hA r s : selfAdjoint (H →L[ℂ] H)) : H →L[ℂ] H)
      ((phase hA r t : selfAdjoint (H →L[ℂ] H)) : H →L[ℂ] H) := by
    change ((s : ℂ) • A.symmetricYosidaApproximation r) *
      ((t : ℂ) • A.symmetricYosidaApproximation r) =
      ((t : ℂ) • A.symmetricYosidaApproximation r) *
      ((s : ℂ) • A.symmetricYosidaApproximation r)
    rw [smul_mul_smul_comm, smul_mul_smul_comm, mul_comm ((s : ℂ)) ((t : ℂ))]
  have hsum : phase hA r (s + t) = phase hA r s + phase hA r t := by
    ext
    simp [phase, Complex.ofReal_add, add_smul]
  change ((selfAdjoint.expUnitary (phase hA r (s + t))) : H →L[ℂ] H) = _
  rw [hsum, hcomm.expUnitary_add]
  rfl

private theorem flow_inner (t : ℝ) (x y : H) :
    ⟪flow hA r t x, flow hA r t y⟫_ℂ = ⟪x, y⟫_ℂ := by
  have hstar : (flow hA r t).adjoint * flow hA r t = 1 := by
    have := Unitary.coe_star_mul_self (selfAdjoint.expUnitary (phase hA r t))
    rwa [ContinuousLinearMap.star_eq_adjoint] at this
  calc ⟪flow hA r t x, flow hA r t y⟫_ℂ
      = ⟪(flow hA r t).adjoint (flow hA r t x), y⟫_ℂ := by
        rw [ContinuousLinearMap.adjoint_inner_left]
    _ = ⟪((flow hA r t).adjoint * flow hA r t) x, y⟫_ℂ := rfl
    _ = ⟪x, y⟫_ℂ := by rw [hstar]; rfl

private theorem flow_continuous (x : H) : Continuous fun t : ℝ => flow hA r t x := by
  have hc : Continuous fun t : ℝ => phase hA r t := by
    exact (Complex.continuous_ofReal.smul continuous_const).subtype_mk _
  have hu := selfAdjoint.continuous_expUnitary.comp hc
  exact (continuous_subtype_val.comp hu).clm_apply continuous_const

/-- The unitary C₀-group generated by the symmetric Yosida approximation at shift `r`. -/
noncomputable def symmetricYosidaGroup : TauCeti.Semigroups.StronglyContinuousGroup H where
  toFun t := (flow hA r t).restrictScalars ℝ
  map_zero' := by ext x; simp [flow_zero]
  map_add' s t := by
    ext x
    change flow hA r (s + t) x = flow hA r s (flow hA r t x)
    rw [flow_add, mul_apply_eq_comp]
  continuousAt_zero' x := (flow_continuous hA r x).continuousAt

/-- The group acts by exponentiating `it` times the symmetric approximation. -/
theorem symmetricYosidaGroup_apply (t : ℝ) (x : H) :
    hA.symmetricYosidaGroup r t x =
      (NormedSpace.exp (I • ((t : ℂ) • A.symmetricYosidaApproximation r))) x := by
  change flow hA r t x = _
  rfl

/-- Every operator in the symmetric Yosida group is unitary. -/
theorem symmetricYosidaGroup_isUnitary :
    TauCeti.Semigroups.StronglyContinuousGroup.IsUnitary (hA.symmetricYosidaGroup r) := by
  apply TauCeti.Semigroups.StronglyContinuousGroup.IsUnitary.intro
  intro t x y
  change ⟪(hA.symmetricYosidaGroup r).toFun t x,
    (hA.symmetricYosidaGroup r).toFun t y⟫_ℂ = _
  change ⟪flow hA r t x, flow hA r t y⟫_ℂ = _
  exact flow_inner hA r t x y

end IsSelfAdjoint
