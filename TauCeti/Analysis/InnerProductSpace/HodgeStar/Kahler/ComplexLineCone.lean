namespace TauCeti.AlmostComplexStructure

/-! ### The cone of complex lines -/

section Module

variable {V W : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]

/-- The **cone of complex lines** of an almost complex structure `J`: the convex cone in `⋀² V`
generated by the two-vectors `v ∧ J v`. Its elements are the finite sums `∑ᵢ vᵢ ∧ J vᵢ`
(`mem_complexLineCone_iff`), the positive `(1,1)` two-vectors of `J`. No inner product is
involved. -/
def complexLineCone (J : AlmostComplexStructure V) : PointedCone ℝ (⋀[ℝ]^2 V) :=
  PointedCone.hull ℝ (Set.range fun v ↦ ιMulti ℝ 2 ![v, J v])

/-- Each complex line `v ∧ J v` lies in the cone of complex lines. -/
@[simp]
theorem ιMulti_mem_complexLineCone (J : AlmostComplexStructure V) (v : V) :
    ιMulti ℝ 2 ![v, J v] ∈ J.complexLineCone :=
  PointedCone.subset_hull ⟨v, rfl⟩

/-- The cone of complex lines is the smallest pointed cone containing every complex line. -/
theorem complexLineCone_le_iff {J : AlmostComplexStructure V} {C : PointedCone ℝ (⋀[ℝ]^2 V)} :
    J.complexLineCone ≤ C ↔ ∀ v, ιMulti ℝ 2 ![v, J v] ∈ C := by
  rw [complexLineCone, PointedCone.hull, Submodule.span_le, Set.range_subset_iff]
  rfl

/-- A nonnegative multiple of a complex line is a complex line:
`c (v ∧ J v) = (√c v) ∧ J (√c v)` for `c ≥ 0`. -/
theorem smul_ιMulti_eq_ιMulti (J : AlmostComplexStructure V) {c : ℝ} (hc : 0 ≤ c) (v : V) :
    c • ιMulti ℝ 2 ![v, J v] = ιMulti ℝ 2 ![√c • v, J (√c • v)] := by
  rw [apply_smul, ιMulti_two_smul_left, ιMulti_two_smul_right, smul_smul,
    Real.mul_self_sqrt hc]

/-- **The elements of the cone of complex lines** are exactly the finite sums `∑ᵢ vᵢ ∧ J vᵢ`. -/
theorem mem_complexLineCone_iff {J : AlmostComplexStructure V} {η : ⋀[ℝ]^2 V} :
    η ∈ J.complexLineCone ↔ ∃ (n : ℕ) (v : Fin n → V), η = ∑ i, ιMulti ℝ 2 ![v i, J (v i)] := by
  refine ⟨fun h ↦ ?_, fun ⟨n, v, hη⟩ ↦ hη ▸
    Submodule.sum_mem _ fun i _ ↦ J.ιMulti_mem_complexLineCone (v i)⟩
  induction h using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨w, rfl⟩ := hx
    exact ⟨1, fun _ ↦ w, by simp⟩
  | zero => exact ⟨0, Fin.elim0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨n, v, rfl⟩ := hx
    obtain ⟨n', v', rfl⟩ := hy
    exact ⟨n + n', Fin.append v v', by simp [Fin.sum_univ_add]⟩
  | smul c x _ hx =>
    obtain ⟨n, v, rfl⟩ := hx
    refine ⟨n, fun i ↦ √(c : ℝ) • v i, ?_⟩
    rw [← Nonneg.coe_smul, Finset.smul_sum]
    exact Finset.sum_congr rfl fun i _ ↦ J.smul_ιMulti_eq_ιMulti c.2 (v i)

/-- **The complex lines are `J`-invariant**: every element `η` of the cone of complex lines
satisfies `D_J η = 0`, that is, it is a `(1,1)` two-vector. -/
theorem lieMap_eq_zero_of_mem_complexLineCone {J : AlmostComplexStructure V} {η : ⋀[ℝ]^2 V}
    (hη : η ∈ J.complexLineCone) : lieMap 2 J.toLinearMap η = 0 := by
  obtain ⟨n, v, rfl⟩ := mem_complexLineCone_iff.1 hη
  rw [map_sum]
  exact Finset.sum_eq_zero fun i _ ↦ lieMap_ιMulti_apply J (v i)

/-- **Naturality of the cone of complex lines**: a complex-linear map `f`, `f ∘ J = J' ∘ f`,
carries complex lines of `J` to complex lines of `J'`, so `⋀² f` maps the cone of `J` into the
cone of `J'`. -/
theorem map_complexLineCone_le {J : AlmostComplexStructure V} {J' : AlmostComplexStructure W}
    {f : V →ₗ[ℝ] W} (hf : IsComplexLinearMap J J' f) :
    J.complexLineCone.map (exteriorPower.map 2 f) ≤ J'.complexLineCone := by
  have hf' := (isComplexLinearMap_iff_apply J J' f).1 hf
  rintro _ ⟨η, hη, rfl⟩
  obtain ⟨n, v, rfl⟩ := mem_complexLineCone_iff.1 hη
  simp only [LinearMap.coe_restrictScalars, map_sum, map_apply_ιMulti]
  refine Submodule.sum_mem _ fun i _ ↦ ?_
  have h : f ∘ ![v i, J (v i)] = ![f (v i), J' (f (v i))] := by
    ext j
    fin_cases j <;> simp [hf']
  rw [h]
  exact J'.ιMulti_mem_complexLineCone _

/-- For a surjective complex-linear map `f`, `⋀² f` maps the cone of complex lines of `J` onto
the cone of complex lines of `J'`. In particular a complex-linear isomorphism, such as a change of
the metric preserving the complex structure, identifies the two cones. -/
theorem map_complexLineCone {J : AlmostComplexStructure V} {J' : AlmostComplexStructure W}
    {f : V →ₗ[ℝ] W} (hf : IsComplexLinearMap J J' f) (hsurj : Function.Surjective f) :
    J.complexLineCone.map (exteriorPower.map 2 f) = J'.complexLineCone := by
  refine le_antisymm (map_complexLineCone_le hf) (complexLineCone_le_iff.2 fun w ↦ ?_)
  obtain ⟨v, rfl⟩ := hsurj w
  refine ⟨ιMulti ℝ 2 ![v, J v], J.ιMulti_mem_complexLineCone v, ?_⟩
  rw [LinearMap.coe_restrictScalars, map_apply_ιMulti,
    ← (isComplexLinearMap_iff_apply J J' f).1 hf v]
  congr 1
  ext j
  fin_cases j <;> rfl

end Module

/-! ### Pairing with forms that are positive on complex lines -/

section Inner

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
  {J : AlmostComplexStructure V}

/-- **Forms that are nonnegative on complex lines pair nonnegatively with the cone**: if
`Ω(v, J v) ≥ 0` for every `v`, then `⟪Ω, κ⟫ ≥ 0` for every `κ` in the cone of complex lines. -/
theorem inner_nonneg_of_mem_complexLineCone {Ω κ : ⋀[ℝ]^2 V}
    (hΩ : ∀ v, 0 ≤ ⟪Ω, ιMulti ℝ 2 ![v, J v]⟫) (hκ : κ ∈ J.complexLineCone) : 0 ≤ ⟪Ω, κ⟫ := by
  obtain ⟨n, v, rfl⟩ := mem_complexLineCone_iff.1 hκ
  rw [inner_sum]
  exact Finset.sum_nonneg fun i _ ↦ hΩ (v i)

/-- **A taming form controls the norm on the cone of complex lines**: if `Ω(v, J v) ≥ c₀ ‖v‖²`
with `c₀ ≥ 0` and `‖J v‖ ≤ K ‖v‖` for every `v`, then `c₀ ‖κ‖ ≤ K ⟪Ω, κ⟫` for every `κ` in the
cone. For an orthogonal `J` one can take `K = 1`. -/
theorem mul_norm_le_mul_inner_of_mem_complexLineCone {Ω κ : ⋀[ℝ]^2 V} {c₀ K : ℝ}
    (hc₀ : 0 ≤ c₀) (hΩ : ∀ v, c₀ * ‖v‖ ^ 2 ≤ ⟪Ω, ιMulti ℝ 2 ![v, J v]⟫)
    (hK : ∀ v, ‖J v‖ ≤ K * ‖v‖) (hκ : κ ∈ J.complexLineCone) : c₀ * ‖κ‖ ≤ K * ⟪Ω, κ⟫ := by
  obtain ⟨n, v, rfl⟩ := mem_complexLineCone_iff.1 hκ
  -- Each line satisfies `c₀ ‖v ∧ J v‖ ≤ c₀ ‖v‖ ‖J v‖ ≤ K c₀ ‖v‖² ≤ K Ω(v, J v)`.
  have hline (w : V) : c₀ * ‖ιMulti ℝ 2 ![w, J w]‖ ≤ K * ⟪Ω, ιMulti ℝ 2 ![w, J w]⟫ := by
    rcases eq_or_ne w 0 with rfl | hw
    · have h0 : ιMulti ℝ 2 ![(0 : V), 0] = 0 := by
        simpa using ιMulti_two_smul_left (0 : V) 0 (0 : ℝ)
      simp [h0]
    have hK₀ : 0 ≤ K := nonneg_of_mul_nonneg_left ((norm_nonneg _).trans (hK w))
      (norm_pos_iff.2 hw)
    calc c₀ * ‖ιMulti ℝ 2 ![w, J w]‖ ≤ c₀ * (‖w‖ * (K * ‖w‖)) :=
          mul_le_mul_of_nonneg_left ((norm_ιMulti_two_le _ _).trans
            (mul_le_mul_of_nonneg_left (hK w) (norm_nonneg w))) hc₀
      _ = K * (c₀ * ‖w‖ ^ 2) := by ring
      _ ≤ K * ⟪Ω, ιMulti ℝ 2 ![w, J w]⟫ := mul_le_mul_of_nonneg_left (hΩ w) hK₀
  rw [inner_sum, Finset.mul_sum]
  exact (mul_le_mul_of_nonneg_left (norm_sum_le _ _) hc₀).trans
    (by rw [Finset.mul_sum]; exact Finset.sum_le_sum fun i _ ↦ hline (v i))

/-- **For an orthogonal almost complex structure the cone of complex lines is the cone of positive
`(1,1)`-forms.** Complex lines are positive, and conversely a positive `(1,1)`-form is the
nonnegative combination `(1 / 2) ∑ᵢ μᵢ bᵢ ∧ J bᵢ` of complex lines through an orthonormal
eigenbasis. -/
theorem complexLineCone_eq_positiveCone (hJ : ∀ v w, ⟪J v, J w⟫ = ⟪v, w⟫) :
    J.complexLineCone = J.positiveCone := by
  refine le_antisymm (complexLineCone_le_iff.2 (ιMulti_mem_positiveCone hJ)) fun κ hκ ↦ ?_
  obtain ⟨b, μ, hμ, rfl⟩ := exists_eq_smul_sum_of_mem_positiveCone hJ hκ
  rw [Finset.smul_sum]
  refine Submodule.sum_mem _ fun i _ ↦ ?_
  rw [smul_smul, J.smul_ιMulti_eq_ιMulti (mul_nonneg (by norm_num) (hμ i))]
  exact J.ιMulti_mem_complexLineCone _

/-! ### Changing the almost complex structure -/

/-- **A positive `(1,1)`-form is close to the cone of a nearby almost complex structure.** Let `J`
be orthogonal and `J'` an arbitrary almost complex structure with `‖J' v - J v‖ ≤ ε ‖v‖` for every
`v`. Every positive `(1,1)`-form `κ` of `J` is at distance at most `ε ⟪ω, κ⟫` from the cone of
complex lines of `J'`, where `ω` is the Kähler two-vector of `J`: writing
`κ = (1 / 2) ∑ᵢ μᵢ bᵢ ∧ J bᵢ` in an orthonormal eigenbasis, the two-vector
`(1 / 2) ∑ᵢ μᵢ bᵢ ∧ J' bᵢ` lies in the cone of `J'`. -/
theorem infDist_complexLineCone_le_of_mem_positiveCone (hJ : ∀ v w, ⟪J v, J w⟫ = ⟪v, w⟫)
    {J' : AlmostComplexStructure V} {ε : ℝ} (hε : ∀ v, ‖J' v - J v‖ ≤ ε * ‖v‖) {κ : ⋀[ℝ]^2 V}
    (hκ : κ ∈ J.positiveCone) :
    infDist κ (J'.complexLineCone : Set (⋀[ℝ]^2 V)) ≤ ε * ⟪J.kahlerForm, κ⟫ := by
  obtain ⟨b, μ, hμ, rfl⟩ := exists_eq_smul_sum_of_mem_positiveCone hJ hκ
  have hκ' : (2⁻¹ : ℝ) • ∑ i, μ i • ιMulti ℝ 2 ![b i, J' (b i)] ∈ J'.complexLineCone := by
    rw [Finset.smul_sum]
    refine Submodule.sum_mem _ fun i _ ↦ ?_
    rw [smul_smul, J'.smul_ιMulti_eq_ιMulti (mul_nonneg (by norm_num) (hμ i))]
    exact J'.ιMulti_mem_complexLineCone _
  -- Each unit complex line `bᵢ ∧ J bᵢ` moves by `‖bᵢ ∧ (J bᵢ - J' bᵢ)‖ ≤ ε` and pairs with `ω`
  -- to `1`.
  have hline (i) : ‖ιMulti ℝ 2 ![b i, J (b i)] - ιMulti ℝ 2 ![b i, J' (b i)]‖ ≤ ε := by
    rw [← ιMulti_two_sub_right]
    refine (norm_ιMulti_two_le _ _).trans ?_
    rw [b.norm_eq_one, one_mul, norm_sub_rev]
    simpa [b.norm_eq_one] using hε (b i)
  have hω (i) : ⟪J.kahlerForm, ιMulti ℝ 2 ![b i, J (b i)]⟫ = 1 := by
    rw [inner_kahlerForm_ιMulti hJ, hJ, real_inner_self_eq_norm_sq, b.norm_eq_one, one_pow]
  calc infDist ((2⁻¹ : ℝ) • ∑ i, μ i • ιMulti ℝ 2 ![b i, J (b i)])
        (J'.complexLineCone : Set (⋀[ℝ]^2 V))
      ≤ dist ((2⁻¹ : ℝ) • ∑ i, μ i • ιMulti ℝ 2 ![b i, J (b i)])
          ((2⁻¹ : ℝ) • ∑ i, μ i • ιMulti ℝ 2 ![b i, J' (b i)]) :=
        infDist_le_dist_of_mem hκ'
    _ = 2⁻¹ * ‖∑ i, μ i • (ιMulti ℝ 2 ![b i, J (b i)] - ιMulti ℝ 2 ![b i, J' (b i)])‖ := by
        rw [dist_eq_norm, ← smul_sub, ← Finset.sum_sub_distrib, norm_smul,
          Real.norm_of_nonneg (by norm_num)]
        simp only [smul_sub]
    _ ≤ 2⁻¹ * ∑ i, μ i * ε := by
        gcongr
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ ↦ ?_)
        rw [norm_smul, Real.norm_of_nonneg (hμ i)]
        exact mul_le_mul_of_nonneg_left (hline i) (hμ i)
    _ = ε * ⟪J.kahlerForm, (2⁻¹ : ℝ) • ∑ i, μ i • ιMulti ℝ 2 ![b i, J (b i)]⟫ := by
        simp only [real_inner_smul_right, inner_sum, hω, mul_one, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ ↦ ?_
        ring

/-- **Lipschitz dependence of the positive cone on the almost complex structure.** Let `J` be
orthogonal and `J'` an arbitrary almost complex structure with `‖J' v - J v‖ ≤ ε ‖v‖` for every
`v`, `ε ≥ 0`. Then every two-vector `η` satisfies

`dist(η, cone(J')) ≤ dist(η, positiveCone(J)) + ε ‖ω‖ (‖η‖ + dist(η, positiveCone(J)))`,

where `ω` is the Kähler two-vector of `J`, of norm `√(dim V / 2)`. -/
theorem infDist_complexLineCone_le (hJ : ∀ v w, ⟪J v, J w⟫ = ⟪v, w⟫)
    {J' : AlmostComplexStructure V} {ε : ℝ} (hε₀ : 0 ≤ ε) (hε : ∀ v, ‖J' v - J v‖ ≤ ε * ‖v‖)
    (η : ⋀[ℝ]^2 V) :
    infDist η (J'.complexLineCone : Set (⋀[ℝ]^2 V)) ≤
      infDist η (J.positiveCone : Set (⋀[ℝ]^2 V)) +
        ε * ‖J.kahlerForm‖ * (‖η‖ + infDist η (J.positiveCone : Set (⋀[ℝ]^2 V))) := by
  obtain ⟨κ, hκ, hd⟩ := (isClosed_positiveCone J).exists_infDist_eq_dist
    ⟨0, zero_mem J.positiveCone⟩ η
  rw [hd]
  have hκη : ‖κ‖ ≤ ‖η‖ + dist η κ := by
    rw [dist_comm, dist_eq_norm]
    exact norm_le_norm_add_norm_sub' κ η |>.trans_eq (by rw [norm_sub_rev])
  calc infDist η (J'.complexLineCone : Set (⋀[ℝ]^2 V))
      ≤ infDist κ (J'.complexLineCone : Set (⋀[ℝ]^2 V)) + dist η κ :=
        infDist_le_infDist_add_dist
    _ ≤ ε * ⟪J.kahlerForm, κ⟫ + dist η κ := by
        gcongr
        exact infDist_complexLineCone_le_of_mem_positiveCone hJ hε hκ
    _ ≤ ε * (‖J.kahlerForm‖ * (‖η‖ + dist η κ)) + dist η κ := by
        gcongr
        exact (real_inner_le_norm _ _).trans
          (mul_le_mul_of_nonneg_left hκη (norm_nonneg _))
    _ = dist η κ + ε * ‖J.kahlerForm‖ * (‖η‖ + dist η κ) := by ring

/-- **Lipschitz dependence of the positive cone on an orthogonal almost complex structure**: for
orthogonal `J` and `J'` with `‖J' v - J v‖ ≤ ε ‖v‖`, `ε ≥ 0`,

`dist(η, positiveCone(J')) ≤ dist(η, positiveCone(J)) + ε ‖ω‖ (‖η‖ + dist(η, positiveCone(J)))`.
-/
theorem infDist_positiveCone_le_infDist_positiveCone_add (hJ : ∀ v w, ⟪J v, J w⟫ = ⟪v, w⟫)
    {J' : AlmostComplexStructure V} (hJ' : ∀ v w, ⟪J' v, J' w⟫ = ⟪v, w⟫) {ε : ℝ} (hε₀ : 0 ≤ ε)
    (hε : ∀ v, ‖J' v - J v‖ ≤ ε * ‖v‖) (η : ⋀[ℝ]^2 V) :
    infDist η (J'.positiveCone : Set (⋀[ℝ]^2 V)) ≤
      infDist η (J.positiveCone : Set (⋀[ℝ]^2 V)) +
        ε * ‖J.kahlerForm‖ * (‖η‖ + infDist η (J.positiveCone : Set (⋀[ℝ]^2 V))) := by
  rw [← complexLineCone_eq_positiveCone hJ']
  exact infDist_complexLineCone_le hJ hε₀ hε η

/-- **The integrated cone defect under a change of almost complex structure.** Let `J x` be
orthogonal and `J' x` arbitrary almost complex structures, depending on a point `x`, with
`‖J' x v - J x v‖ ≤ ε ‖v‖`, `ε ≥ 0`. For a field `ξ` of two-vectors whose norm and whose distance to
the positive cones of `J x` are integrable,

`∫ dist(ξ, cone(J')) ≤ (1 + ε ‖ω‖) ∫ dist(ξ, positiveCone(J)) + ε ‖ω‖ ∫ ‖ξ‖`,

with `‖ω‖ = √(dim V / 2)`. The last term is `ε ‖ω‖` times the mass of the current that `ξ`
represents. -/
theorem integral_infDist_complexLineCone_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {J J' : X → AlmostComplexStructure V} (hJ : ∀ x v w, ⟪J x v, J x w⟫ = ⟪v, w⟫) {ε : ℝ}
    (hε₀ : 0 ≤ ε) (hε : ∀ x v, ‖J' x v - J x v‖ ≤ ε * ‖v‖) {ξ : X → ⋀[ℝ]^2 V}
    (hd : Integrable (fun x ↦ infDist (ξ x) ((J x).positiveCone : Set (⋀[ℝ]^2 V))) μ)
    (hξ : Integrable (fun x ↦ ‖ξ x‖) μ) :
    ∫ x, infDist (ξ x) ((J' x).complexLineCone : Set (⋀[ℝ]^2 V)) ∂μ ≤
      (1 + ε * √(finrank ℝ V / 2)) *
          ∫ x, infDist (ξ x) ((J x).positiveCone : Set (⋀[ℝ]^2 V)) ∂μ +
        ε * √(finrank ℝ V / 2) * ∫ x, ‖ξ x‖ ∂μ := by
  have hω (x : X) : ‖(J x).kahlerForm‖ = √(finrank ℝ V / 2) := by
    rw [← norm_kahlerForm_sq (hJ x), Real.sqrt_sq (norm_nonneg _)]
  rw [← integral_const_mul, ← integral_const_mul, ← integral_add (hd.const_mul _)
    (hξ.const_mul _)]
  refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun x ↦ infDist_nonneg)
    ((hd.const_mul _).add (hξ.const_mul _)) (Filter.Eventually.of_forall fun x ↦ ?_)
  have h := infDist_complexLineCone_le (hJ x) hε₀ (hε x) (ξ x)
  rw [hω] at h
  linarith

end Inner

end TauCeti.AlmostComplexStructure
