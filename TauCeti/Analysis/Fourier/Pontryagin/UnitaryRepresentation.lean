/-!
# Matrix coefficients of unitary representations of discrete abelian groups

Let `ρ` be a unitary representation of a discrete abelian group `G` on a complex Hilbert space
`H`, and let `ξ ∈ H`. The diagonal matrix coefficient `g ↦ ⟪ξ, ρ(g) ξ⟫` is the
Fourier–Stieltjes transform of a finite positive measure on the Pontryagin dual of `G`.

The operators `ρ(g)` are commuting unitaries, so they generate a unital commutative C⋆-subalgebra
`B` of `H →L[ℂ] H`. The positive vector functional `a ↦ ⟪ξ, a ξ⟫` is nonnegative on
`star a * a`, hence is integration against a finite measure on the character space of `B`. A
character `ω` of `B` sends each unitary `ρ(g)` into the unit circle, so `g ↦ ω(ρ(g))` is a
character of `G`, and this assignment is continuous. The image of the measure on the dual group
is the required measure.

This is the cyclic form of the spectral theorem for unitary representations of a discrete
abelian group (the discrete case of the Stone–Naimark–Ambrose–Godement theorem).

## Main declarations

* `MonoidHom.exists_pontryaginMeasureTransform_eq_inner`: a diagonal matrix coefficient of a
  unitary representation of a discrete abelian group is the Fourier–Stieltjes transform of a
  finite measure on the dual group.

## References

* W. Rudin, *Fourier Analysis on Groups*, Interscience (1962), §1.4.
* G. B. Folland, *A Course in Abstract Harmonic Analysis*, 2nd ed., CRC Press (2016), §4.4.
-/

public section

noncomputable section

open MeasureTheory WeakDual ComplexOrder
open scoped InnerProductSpace

namespace TauCeti.UnitaryRepresentation

variable {G : Type*} [CommGroup G]
  {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The closed star subalgebra generated by the operators of a unitary representation. -/
private abbrev generatedAlgebra (ρ : G →* unitary (H →L[ℂ] H)) : StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ (Set.range fun g ↦ (ρ g : H →L[ℂ] H))).topologicalClosure

private lemma isMulCommutative_adjoin (ρ : G →* unitary (H →L[ℂ] H)) :
    IsMulCommutative (StarAlgebra.adjoin ℂ (Set.range fun g ↦ (ρ g : H →L[ℂ] H))) := by
  refine CStarAlgebra.isMulCommutative_adjoin (by rintro _ ⟨g, rfl⟩; infer_instance) ?_
  rintro _ ⟨g, rfl⟩ _ ⟨h, rfl⟩ -
  exact congrArg Subtype.val (by rw [← map_mul, ← map_mul, mul_comm] : ρ g * ρ h = ρ h * ρ g)

private instance (ρ : G →* unitary (H →L[ℂ] H)) : IsMulCommutative (generatedAlgebra ρ) :=
  have := isMulCommutative_adjoin ρ
  StarSubalgebra.isMulCommutative_topologicalClosure _

private instance (ρ : G →* unitary (H →L[ℂ] H)) :
    IsClosed (generatedAlgebra ρ : Set (H →L[ℂ] H)) :=
  StarSubalgebra.isClosed_topologicalClosure _

open scoped IsMulCommutative in
private noncomputable instance (ρ : G →* unitary (H →L[ℂ] H)) :
    CommCStarAlgebra (generatedAlgebra ρ) where

/-- The operator `ρ(g)`, as an element of the algebra generated by the representation. -/
private def generator (ρ : G →* unitary (H →L[ℂ] H)) (g : G) : generatedAlgebra ρ :=
  ⟨ρ g, StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨g, rfl⟩)⟩

private lemma generator_mem_unitary (ρ : G →* unitary (H →L[ℂ] H)) (g : G) :
    generator ρ g ∈ unitary (generatedAlgebra ρ) := by
  rw [Unitary.mem_iff]
  constructor <;> apply Subtype.ext
  · exact Unitary.star_mul_self_of_mem (ρ g).2
  · exact Unitary.mul_star_self_of_mem (ρ g).2

private lemma generator_mul (ρ : G →* unitary (H →L[ℂ] H)) (g h : G) :
    generator ρ (g * h) = generator ρ g * generator ρ h :=
  Subtype.ext (by simp [generator])

private lemma generator_one (ρ : G →* unitary (H →L[ℂ] H)) : generator ρ 1 = 1 :=
  Subtype.ext (by simp [generator])

/-- A character of the generated algebra sends each unitary generator into the unit circle. -/
private def characterValue (ρ : G →* unitary (H →L[ℂ] H))
    (ω : characterSpace ℂ (generatedAlgebra ρ)) (g : G) : Circle :=
  ⟨ω (generator ρ g), mem_sphere_zero_iff_norm.mpr <| by
    simpa using spectrum.subset_circle_of_unitary (generator_mem_unitary ρ g)
      (CharacterSpace.apply_mem_spectrum ω _)⟩

private lemma coe_characterValue (ρ : G →* unitary (H →L[ℂ] H))
    (ω : characterSpace ℂ (generatedAlgebra ρ)) (g : G) :
    (characterValue ρ ω g : ℂ) = ω (generator ρ g) :=
  rfl

/-- A character of the generated algebra restricts to a character of `G`. -/
private def dualOfCharacter (ρ : G →* unitary (H →L[ℂ] H))
    (ω : characterSpace ℂ (generatedAlgebra ρ)) : G →* Circle where
  toFun := characterValue ρ ω
  map_one' := Circle.ext (by rw [coe_characterValue, Circle.coe_one, generator_one, map_one])
  map_mul' g h := Circle.ext (by
    rw [coe_characterValue, Circle.coe_mul, coe_characterValue, coe_characterValue,
      generator_mul, map_mul])

private lemma coe_dualOfCharacter_apply (ρ : G →* unitary (H →L[ℂ] H))
    (ω : characterSpace ℂ (generatedAlgebra ρ)) (g : G) :
    (dualOfCharacter ρ ω g : ℂ) = ω (generator ρ g) :=
  rfl

end TauCeti.UnitaryRepresentation

open TauCeti.UnitaryRepresentation

variable {G : Type*} [AddCommGroup G] [TopologicalSpace G] [DiscreteTopology G]
  [MeasurableSpace (PontryaginDual (Multiplicative G))]
  [BorelSpace (PontryaginDual (Multiplicative G))]
  {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- **Spectral theorem for unitary representations of discrete abelian groups**, cyclic form.
For a unitary representation `ρ` of a discrete abelian group `G` and a vector `ξ`, the matrix
coefficient `g ↦ ⟪ξ, ρ(g) ξ⟫` is the Fourier–Stieltjes transform of a finite measure on the
Pontryagin dual of `G`. -/
theorem MonoidHom.exists_pontryaginMeasureTransform_eq_inner
    (ρ : Multiplicative G →* unitary (H →L[ℂ] H)) (ξ : H) :
    ∃ μ : FiniteMeasure (PontryaginDual (Multiplicative G)),
      ∀ g, μ.pontryaginMeasureTransform g =
        ⟪ξ, (ρ (Multiplicative.ofAdd g) : H →L[ℂ] H) ξ⟫_ℂ := by
  set B := generatedAlgebra ρ
  -- The positive vector functional of `ξ` on the generated algebra.
  let f : B →ₗ[ℂ] ℂ :=
    { toFun a := ⟪ξ, (a : H →L[ℂ] H) ξ⟫_ℂ
      map_add' a b := by simp [inner_add_right]
      map_smul' c a := by simp [inner_smul_right] }
  have hf (a : B) : 0 ≤ f (star a * a) := by
    -- `f (star a * a) = ⟪ξ, a† (a ξ)⟫ = ‖a ξ‖ ^ 2`.
    simp only [f, LinearMap.coe_mk, AddHom.coe_mk, MulMemClass.coe_mul, StarMemClass.coe_star,
      ContinuousLinearMap.star_eq_adjoint, mul_apply_eq_comp,
      ContinuousLinearMap.adjoint_inner_right, inner_self_eq_norm_sq_to_K]
    rw [← RCLike.ofReal_pow]
    exact RCLike.ofReal_nonneg.mpr (sq_nonneg _)
  borelize ↥(characterSpace ℂ B)
  obtain ⟨μ, hμ, hrep⟩ := f.exists_isFiniteMeasure_integral_characterSpace_eq hf
  -- Each character of `B` restricts to a continuous character of `G`, continuously in `ω`.
  let θ : characterSpace ℂ B → PontryaginDual (Multiplicative G) := fun ω ↦
    ⟨dualOfCharacter ρ ω, continuous_of_discreteTopology⟩
  have hθ : Continuous θ := ContinuousMonoidHom.continuous_of_continuous_uncurry _ <|
    continuous_prod_of_discrete_right.mpr fun g ↦
      ((gelfandTransform ℂ B (generator ρ g)).continuous).subtype_mk _
  let μf : FiniteMeasure (characterSpace ℂ B) := ⟨μ, hμ⟩
  refine ⟨μf.map θ, fun g ↦ ?_⟩
  rw [FiniteMeasure.pontryaginMeasureTransform_apply, FiniteMeasure.toMeasure_map,
    integral_map hθ.aemeasurable
      (TauCeti.PontryaginDual.continuous_coe_eval_const _).aestronglyMeasurable]
  -- Both sides are the integral of `ω ↦ ω (ρ g)` against `μ`.
  have hθg (ω : characterSpace ℂ B) :
      (θ ω (Multiplicative.ofAdd g) : ℂ) = ω (generator ρ (Multiplicative.ofAdd g)) :=
    coe_dualOfCharacter_apply ρ ω _
  have hfg : f (generator ρ (Multiplicative.ofAdd g)) =
      ⟪ξ, (ρ (Multiplicative.ofAdd g) : H →L[ℂ] H) ξ⟫_ℂ := by
    simp only [f, LinearMap.coe_mk, AddHom.coe_mk, generator]
  simp_rw [hθg]
  simp only [μf, FiniteMeasure.toMeasure_mk]
  rw [← hrep, hfg]
