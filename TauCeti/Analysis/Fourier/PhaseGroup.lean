module

public import TauCeti.Analysis.Fourier.L2Multiplier
public import TauCeti.Analysis.Semigroups.Group.Unitary

/-!
# Unitary groups generated by real Fourier multipliers

Let `E` be a finite-dimensional real inner product space, `F` a complex Hilbert space and
`ω : E → ℝ` a continuous real function, the *phase* or *dispersion relation*. The operator
`ω(D)` with Fourier symbol `ω` is self-adjoint, and the unitary group `exp(itω(D))` it generates
is the Fourier multiplier on `L²(E, F)` with the unimodular symbol

`ξ ↦ exp(i t ω(ξ))`.

The free dispersive equations are of this form: the Schrödinger propagator `exp(itΔ)` has the
phase `ξ ↦ -4π² ‖ξ‖²`, the symbol of the Laplacian in Mathlib's normalization of the Fourier
transform, and the half-wave propagators `exp(±it√(-Δ))` have the phases `ξ ↦ ±2π ‖ξ‖`.

This file constructs `exp(itω(D))` as an `L²` Fourier multiplier
(`MeasureTheory.Lp.fourierMultiplierCLM`) and proves the laws that make it a strongly continuous
unitary group:

* `exp(i0ω(D)) = 1` and `exp(i(s + t)ω(D)) = exp(isω(D)) exp(itω(D))`;
* each operator preserves the `L²` norm and the inner product, and its adjoint is the operator at
  time `-t`;
* `t ↦ exp(itω(D)) f` is continuous for every `f ∈ L²`;
* each operator commutes with every `L²` Fourier multiplier.

Reversing time reverses the phase: `exp(i(-t)ω(D)) = exp(it(-ω)(D))`
(`TauCeti.phasePropagator_neg`).

## Main declarations

* `TauCeti.phaseSymbol`: the symbol `exp(i t ω(ξ))`.
* `TauCeti.phasePropagator`: the operator `exp(itω(D))` on `L²(E, F)`.
* `TauCeti.fourier_phasePropagator`, `TauCeti.coeFn_fourier_phasePropagator`: its action on the
  Fourier side.
* `TauCeti.phasePropagator_zero`, `TauCeti.phasePropagator_add`: the group law.
* `TauCeti.norm_phasePropagator_apply`, `TauCeti.inner_phasePropagator_apply`,
  `TauCeti.adjoint_phasePropagator`: unitarity.
* `TauCeti.continuous_phasePropagator_apply`: strong continuity.
* `TauCeti.phaseGroup`, `TauCeti.isUnitary_phaseGroup`: the unitary C₀-group.

## References

* T. Tao, *Nonlinear Dispersive Equations: Local and Global Analysis*, CBMS Regional Conference
  Series in Mathematics 106, AMS, 2006, Section 2.1.
-/

public section

noncomputable section

open scoped ENNReal FourierTransform ComplexInnerProductSpace Topology
open MeasureTheory Filter Complex

namespace TauCeti

section Symbol

variable {E : Type*} [TopologicalSpace E] (ω : C(E, ℝ))

/-- The symbol `ξ ↦ exp(i t ω(ξ))` of the operator `exp(itω(D))` generated by the Fourier
multiplier with real symbol `ω`. -/
def phaseSymbol (t : ℝ) (ξ : E) : ℂ :=
  cexp (((t * ω ξ : ℝ) : ℂ) * I)

theorem phaseSymbol_apply (t : ℝ) (ξ : E) :
    phaseSymbol ω t ξ = cexp (((t * ω ξ : ℝ) : ℂ) * I) :=
  (rfl)

/-- The phase symbol is unimodular. -/
@[simp]
theorem norm_phaseSymbol (t : ℝ) (ξ : E) : ‖phaseSymbol ω t ξ‖ = 1 :=
  norm_exp_ofReal_mul_I _

@[simp]
theorem phaseSymbol_zero (ξ : E) : phaseSymbol ω 0 ξ = 1 := by
  simp [phaseSymbol_apply]

theorem phaseSymbol_add (s t : ℝ) (ξ : E) :
    phaseSymbol ω (s + t) ξ = phaseSymbol ω s ξ * phaseSymbol ω t ξ := by
  simp only [phaseSymbol_apply, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem star_phaseSymbol (t : ℝ) (ξ : E) :
    star (phaseSymbol ω t ξ) = phaseSymbol ω (-t) ξ := by
  rw [phaseSymbol_apply, phaseSymbol_apply, Complex.star_def, ← Complex.exp_conj, map_mul,
    Complex.conj_ofReal, Complex.conj_I]
  congr 1
  push_cast
  ring

/-- Reversing time reverses the phase. -/
theorem phaseSymbol_neg (t : ℝ) (ξ : E) : phaseSymbol ω (-t) ξ = phaseSymbol (-ω) t ξ := by
  simp [phaseSymbol_apply]

/-- The phase symbol is jointly continuous in time and frequency. -/
theorem continuous_phaseSymbol_uncurry : Continuous fun p : ℝ × E ↦ phaseSymbol ω p.1 p.2 := by
  unfold phaseSymbol
  fun_prop

theorem continuous_phaseSymbol (t : ℝ) : Continuous (phaseSymbol ω t) :=
  (continuous_phaseSymbol_uncurry ω).comp (Continuous.prodMk_right t)

end Symbol

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E]
  {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F] (ω : C(E, ℝ))

/-- The phase symbol is essentially bounded. -/
theorem memLp_phaseSymbol (t : ℝ) : MemLp (phaseSymbol ω t) ∞ volume :=
  memLp_top_of_bound (continuous_phaseSymbol ω t).aestronglyMeasurable 1
    (Eventually.of_forall fun ξ ↦ (norm_phaseSymbol ω t ξ).le)

/-- The `L^∞` class of the phase symbol has norm at most `1`. -/
theorem norm_toLp_phaseSymbol_le (t : ℝ) : ‖(memLp_phaseSymbol ω t).toLp _‖ ≤ 1 := by
  rw [Lp.norm_toLp, eLpNorm_exponent_top]
  · exact ENNReal.toReal_le_of_le_ofReal zero_le_one
      (eLpNormEssSup_le_of_ae_bound (Eventually.of_forall fun ξ ↦ (norm_phaseSymbol ω t ξ).le))
  · exact (memLp_phaseSymbol ω t).aestronglyMeasurable

variable (F) in
/-- The unitary operator `exp(itω(D))` on `L²(E, F)`: the Fourier multiplier with symbol
`exp(i t ω(ξ))`. -/
def phasePropagator (t : ℝ) : Lp F 2 (volume : Measure E) →L[ℂ] Lp F 2 (volume : Measure E) :=
  Lp.fourierMultiplierCLM F ((memLp_phaseSymbol ω t).toLp _)

theorem phasePropagator_def (t : ℝ) :
    phasePropagator F ω t = Lp.fourierMultiplierCLM F ((memLp_phaseSymbol ω t).toLp _) :=
  (rfl)

/-- On the Fourier side, `exp(itω(D))` is multiplication by `exp(i t ω(ξ))`. -/
theorem fourier_phasePropagator (t : ℝ) (f : Lp F 2 (volume : Measure E)) :
    𝓕 (phasePropagator F ω t f) =
      ((memLp_phaseSymbol ω t).toLp _ • 𝓕 f : Lp F 2 (volume : Measure E)) :=
  Lp.fourier_fourierMultiplierCLM _ f

/-- On the Fourier side, `exp(itω(D))` is pointwise multiplication by `exp(i t ω(ξ))`, almost
everywhere. -/
theorem coeFn_fourier_phasePropagator (t : ℝ) (f : Lp F 2 (volume : Measure E)) :
    𝓕 (phasePropagator F ω t f) =ᵐ[volume] fun ξ ↦ phaseSymbol ω t ξ • 𝓕 f ξ := by
  rw [fourier_phasePropagator]
  filter_upwards [Lp.coeFn_lpSMul (r := 2) ((memLp_phaseSymbol ω t).toLp _) (𝓕 f),
    (memLp_phaseSymbol ω t).coeFn_toLp] with ξ h₁ h₂
  rw [h₁, Pi.smul_apply', h₂]

/-- `exp(i0ω(D))` is the identity. -/
@[simp]
theorem phasePropagator_zero :
    phasePropagator F ω 0 = ContinuousLinearMap.id ℂ (Lp F 2 (volume : Measure E)) := by
  rw [phasePropagator_def, Lp.fourierMultiplierCLM_of_ae_eq_const (c := 1) ?_, one_smul]
  filter_upwards [(memLp_phaseSymbol ω 0).coeFn_toLp] with ξ h
  simp [h]

/-- **The group law** `exp(i(s + t)ω(D)) = exp(isω(D)) exp(itω(D))`. -/
theorem phasePropagator_add (s t : ℝ) :
    phasePropagator F ω (s + t) = phasePropagator F ω s ∘L phasePropagator F ω t := by
  rw [phasePropagator_def, phasePropagator_def, phasePropagator_def,
    Lp.fourierMultiplierCLM_compL_fourierMultiplierCLM]
  congr 1
  apply Lp.ext
  filter_upwards [(memLp_phaseSymbol ω (s + t)).coeFn_toLp, (memLp_phaseSymbol ω s).coeFn_toLp,
    (memLp_phaseSymbol ω t).coeFn_toLp,
    Lp.coeFn_lpSMul (r := ∞) ((memLp_phaseSymbol ω s).toLp _)
      ((memLp_phaseSymbol ω t).toLp _)] with ξ h₁ h₂ h₃ h₄
  rw [h₄, Pi.smul_apply', h₂, h₃, h₁, smul_eq_mul, phaseSymbol_add]

theorem phasePropagator_add_apply (s t : ℝ) (f : Lp F 2 (volume : Measure E)) :
    phasePropagator F ω (s + t) f = phasePropagator F ω s (phasePropagator F ω t f) := by
  rw [phasePropagator_add, ContinuousLinearMap.comp_apply]

@[simp]
theorem phasePropagator_neg_apply_phasePropagator_apply (t : ℝ)
    (f : Lp F 2 (volume : Measure E)) :
    phasePropagator F ω (-t) (phasePropagator F ω t f) = f := by
  rw [← phasePropagator_add_apply, neg_add_cancel, phasePropagator_zero,
    ContinuousLinearMap.id_apply]

@[simp]
theorem phasePropagator_apply_phasePropagator_neg_apply (t : ℝ)
    (f : Lp F 2 (volume : Measure E)) :
    phasePropagator F ω t (phasePropagator F ω (-t) f) = f := by
  simpa using phasePropagator_neg_apply_phasePropagator_apply ω (-t) f

/-- Reversing time reverses the phase: `exp(i(-t)ω(D)) = exp(it(-ω)(D))`. -/
theorem phasePropagator_neg (t : ℝ) : phasePropagator F ω (-t) = phasePropagator F (-ω) t := by
  rw [phasePropagator_def, phasePropagator_def]
  congr 1
  apply Lp.ext
  filter_upwards [(memLp_phaseSymbol ω (-t)).coeFn_toLp,
    (memLp_phaseSymbol (-ω) t).coeFn_toLp] with ξ h₁ h₂
  rw [h₁, h₂, phaseSymbol_neg]

/-- `exp(itω(D))` has operator norm at most one. -/
theorem norm_phasePropagator_le (t : ℝ) : ‖phasePropagator (E := E) F ω t‖ ≤ 1 :=
  (Lp.norm_fourierMultiplierCLM_le _).trans (norm_toLp_phaseSymbol_le ω t)

/-- **Conservation of the `L²` norm**: `‖exp(itω(D)) f‖ = ‖f‖`. -/
@[simp]
theorem norm_phasePropagator_apply (t : ℝ) (f : Lp F 2 (volume : Measure E)) :
    ‖phasePropagator F ω t f‖ = ‖f‖ := by
  refine le_antisymm ?_ ?_
  · exact ((phasePropagator F ω t).le_opNorm f).trans
      (mul_le_of_le_one_left (norm_nonneg f) (norm_phasePropagator_le ω t))
  · conv_lhs => rw [← phasePropagator_neg_apply_phasePropagator_apply ω t f]
    exact ((phasePropagator F ω (-t)).le_opNorm _).trans
      (mul_le_of_le_one_left (norm_nonneg _) (norm_phasePropagator_le ω (-t)))

/-- The adjoint of `exp(itω(D))` is `exp(i(-t)ω(D))`. -/
theorem adjoint_phasePropagator (t : ℝ) :
    ContinuousLinearMap.adjoint (phasePropagator (E := E) F ω t) = phasePropagator F ω (-t) := by
  rw [phasePropagator_def, phasePropagator_def, Lp.adjoint_fourierMultiplierCLM]
  congr 1
  apply Lp.ext
  filter_upwards [Lp.coeFn_star ((memLp_phaseSymbol ω t).toLp _),
    (memLp_phaseSymbol ω t).coeFn_toLp, (memLp_phaseSymbol ω (-t)).coeFn_toLp] with ξ h₁ h₂ h₃
  rw [h₁, Pi.star_apply, h₂, h₃, star_phaseSymbol]

/-- `exp(itω(D))` preserves the `L²` inner product. -/
@[simp]
theorem inner_phasePropagator_apply (t : ℝ) (f g : Lp F 2 (volume : Measure E)) :
    ⟪phasePropagator F ω t f, phasePropagator F ω t g⟫ = ⟪f, g⟫ := by
  rw [← ContinuousLinearMap.adjoint_inner_right, adjoint_phasePropagator,
    phasePropagator_neg_apply_phasePropagator_apply]

/-- `exp(itω(D))` commutes with every `L²` Fourier multiplier. -/
theorem phasePropagator_comp_fourierMultiplierCLM (t : ℝ) (m : Lp ℂ ∞ (volume : Measure E)) :
    phasePropagator F ω t ∘L Lp.fourierMultiplierCLM F m =
      Lp.fourierMultiplierCLM F m ∘L phasePropagator F ω t := by
  rw [phasePropagator_def, Lp.fourierMultiplierCLM_compL_fourierMultiplierCLM,
    Lp.fourierMultiplierCLM_compL_fourierMultiplierCLM]
  congr 1
  apply Lp.ext
  filter_upwards [Lp.coeFn_lpSMul (r := ∞) ((memLp_phaseSymbol ω t).toLp _) m,
    Lp.coeFn_lpSMul (r := ∞) m ((memLp_phaseSymbol ω t).toLp _)] with ξ h₁ h₂
  rw [h₁, h₂, Pi.smul_apply', Pi.smul_apply', smul_eq_mul, smul_eq_mul, mul_comm]

/-- **Strong continuity**: `t ↦ exp(itω(D)) f` is continuous for every `f ∈ L²`. -/
theorem continuous_phasePropagator_apply (f : Lp F 2 (volume : Measure E)) :
    Continuous fun t ↦ phasePropagator F ω t f := by
  -- Pass to sequences, so that the almost-everywhere representatives of the symbols are chosen
  -- for countably many times only.
  refine continuous_iff_seqContinuous.2 fun τ t hτ ↦ ?_
  refine Lp.tendsto_fourierMultiplierCLM_apply (C := 1)
    (Eventually.of_forall fun n ↦ norm_toLp_phaseSymbol_le ω (τ n)) ?_ f
  filter_upwards [ae_all_iff.2 fun n ↦ (memLp_phaseSymbol ω (τ n)).coeFn_toLp,
    (memLp_phaseSymbol ω t).coeFn_toLp] with ξ h₁ h₂
  simp only [h₁, h₂]
  exact (((continuous_phaseSymbol_uncurry ω).comp (Continuous.prodMk_left ξ)).tendsto t).comp hτ

variable (E F) in
/-- The operators `t ↦ exp(itω(D))` as a strongly continuous one-parameter group on
`L²(E, F)`. -/
def phaseGroup : Semigroups.StronglyContinuousGroup (Lp F 2 (volume : Measure E)) where
  toFun t := (phasePropagator F ω t).restrictScalars ℝ
  map_zero' := by
    ext1 f
    simp
  map_add' s t := by
    ext1 f
    simp [phasePropagator_add_apply]
  continuousAt_zero' f := (continuous_phasePropagator_apply ω f).continuousAt

@[simp]
theorem phaseGroup_apply (t : ℝ) (f : Lp F 2 (volume : Measure E)) :
    phaseGroup E F ω t f = phasePropagator F ω t f :=
  (rfl)

/-- The group generated by a real Fourier multiplier is unitary. -/
theorem isUnitary_phaseGroup : (phaseGroup E F ω).IsUnitary :=
  Semigroups.StronglyContinuousGroup.IsUnitary.intro fun t f g ↦
    inner_phasePropagator_apply ω t f g

end TauCeti
