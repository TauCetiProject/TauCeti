/-!
# Block boundary Hardy space and matrix symbols

For a finite block size `r`, the `r`-block boundary Hardy space `TauCeti.BlockHardySpace r` is the
Hilbert direct sum `PiLp 2 (fun _ : Fin r ↦ HardySpace)` of `r` copies of scalar `HardySpace`.
Under the coordinatewise linear isometry `MeasureTheory.Lp.piLpEquiv` on normalized circle `L²`,
this carrier identifies unitarily with the closed nonnegative-mode subspace
`TauCeti.blockHardySubmodule r` of `Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle)` —
equivalently, the vector-valued `L²` functions whose negative Fourier coefficients vanish — while
its orthogonal complement `(blockHardySubmodule r)ᗮ` identifies unitarily with
`PiLp 2 (fun _ : Fin r ↦ ↥hardySubmoduleᗮ)`. Combining coordinatewise `hardyBasis.repr` with
`lp.piLpEquiv` further identifies `BlockHardySpace r` isometrically with the vector-valued sequence
space `lp (fun _ : ℕ ↦ EuclideanSpace ℂ (Fin r)) 2`.

This file also introduces the operator-normed matrix symbol space `TauCeti.BlockSymbol r`
(`Lp (EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin r)) ∞ haarAddCircle`) together with its
continuous scalar matrix-entry extraction (`TauCeti.blockSymbolEntry`) and insertion
(`TauCeti.blockSymbolSingle`), relating scalar entrywise Fourier coefficients, constant and
continuous symbols, and conjugation to the operator-valued Fourier coefficients and Hilbert-space
adjoint.

## References

* A. Böttcher and B. Silbermann, *Analysis of Toeplitz Operators*, second edition, §2.9.
* J. B. Conway, *A Course in Functional Analysis*, second edition.
* E. Park, *Toeplitz operators*.
-/

public section

noncomputable section

open MeasureTheory Submodule
open scoped ENNReal InnerProductSpace

namespace TauCeti

/-- The `r`-block boundary Hardy Hilbert space, modeled as the `L²` product of `r` copies of scalar
`HardySpace`. -/
abbrev BlockHardySpace (r : ℕ) := PiLp 2 (fun _ : Fin r ↦ HardySpace)

/-- The vector-valued Fourier mode on the unit circle concentrated in coordinate `i : Fin r` at
frequency `n : ℤ`. -/
def blockFourierMode (r : ℕ) (n : ℤ) (i : Fin r) :
    Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1)) :=
  (Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1))).symm
    (PiLp.single 2 i (fourierBasis (T := 1) n))

/-- Coordinatewise evaluation of `blockFourierMode` under `Lp.piLpEquiv`. -/
@[simp]
theorem piLpEquiv_blockFourierMode (r : ℕ) (n : ℤ) (i j : Fin r) :
    Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1))
      (blockFourierMode r n i) j = if j = i then fourierBasis (T := 1) n else 0 := by
  simp [blockFourierMode, PiLp.single_apply]

/-- The closed subspace of vector-valued circle `L²` generated by the nonnegative vector Fourier
modes. -/
def blockHardySubmodule (r : ℕ) :
    Submodule ℂ (Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) :=
  (Submodule.span ℂ
    (Set.range fun p : ℕ × Fin r ↦ blockFourierMode r (p.1 : ℤ) p.2)).topologicalClosure

/-- `blockHardySubmodule r` is the closed span of the nonnegative vector Fourier modes. -/
theorem blockHardySubmodule_def (r : ℕ) :
    blockHardySubmodule r =
      (Submodule.span ℂ
        (Set.range fun p : ℕ × Fin r ↦ blockFourierMode r (p.1 : ℤ) p.2)).topologicalClosure :=
  (rfl)

/-- The block Hardy submodule is closed in vector-valued circle `L²`. -/
theorem isClosed_blockHardySubmodule (r : ℕ) :
    IsClosed (blockHardySubmodule r :
      Set (Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1)))) :=
  Submodule.isClosed_topologicalClosure _

instance (r : ℕ) : CompleteSpace ↥(blockHardySubmodule r) :=
  (isClosed_blockHardySubmodule r).completeSpace_coe

/-- Every nonnegative vector Fourier mode belongs to `blockHardySubmodule r`. -/
theorem blockFourierMode_mem_blockHardySubmodule (r : ℕ) (n : ℕ) (i : Fin r) :
    blockFourierMode r (n : ℤ) i ∈ blockHardySubmodule r :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨(n, i), rfl⟩)

private def coordIncl (r : ℕ) (i : Fin r) :
    Lp ℂ 2 (AddCircle.haarAddCircle (T := 1)) →L[ℂ]
      Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1)) :=
  (Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ)
      (AddCircle.haarAddCircle (T := 1))).symm.toLinearIsometry.toContinuousLinearMap ∘L
    (PiLp.continuousLinearEquiv 2 ℂ
      (fun _ : Fin r ↦ Lp ℂ 2 (AddCircle.haarAddCircle (T := 1)))).symm.toContinuousLinearMap ∘L
    ContinuousLinearMap.single ℂ
      (fun _ : Fin r ↦ Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) i

private theorem eq_sum_coordIncl {r : ℕ}
    (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) :
    f = ∑ i : Fin r, coordIncl r i
      (Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) f i) := by
  apply (Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1))).injective
  rw [map_sum]; ext j : 1
  simp [coordIncl, LinearIsometryEquiv.apply_symm_apply, WithLp.ofLp_sum, Finset.sum_apply,
    Pi.single_apply]

private theorem coordIncl_mem_of_mem_topologicalClosure {r : ℕ} (i : Fin r)
    {s : Set (Lp ℂ 2 (AddCircle.haarAddCircle (T := 1)))}
    {M : Submodule ℂ (Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1)))}
    (hM : IsClosed (SetLike.coe M)) (hs : ∀ g ∈ s, coordIncl r i g ∈ M)
    {g : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))}
    (hg : g ∈ (Submodule.span ℂ s).topologicalClosure) :
    coordIncl r i g ∈ M :=
  Submodule.topologicalClosure_minimal _ (t := M.comap (coordIncl r i).toLinearMap)
    (Submodule.span_le.mpr fun x hx ↦ hs x hx) (hM.preimage (coordIncl r i).continuous) hg

/-- A vector-valued `L²` function belongs to `blockHardySubmodule r` if and only if each scalar
coordinate function belongs to `hardySubmodule`. -/
theorem mem_blockHardySubmodule_iff_piLpEquiv {r : ℕ}
    (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) :
    f ∈ blockHardySubmodule r ↔
      ∀ i : Fin r,
        Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) f i ∈
          hardySubmodule := by
  set e := Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1))
  constructor
  · intro hf i
    let proj_i := PiLp.proj 2 (fun _ : Fin r ↦ Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) i ∘L
      e.toLinearIsometry.toContinuousLinearMap
    refine Submodule.topologicalClosure_minimal _ (t := hardySubmodule.comap proj_i.toLinearMap) ?_
      (isClosed_hardySubmodule.preimage proj_i.continuous) hf
    rw [Submodule.span_le]; rintro _ ⟨⟨n, j⟩, rfl⟩
    simp only [SetLike.mem_coe, Submodule.mem_comap, ContinuousLinearMap.coe_coe, proj_i,
      ContinuousLinearMap.comp_apply, LinearIsometry.coe_toContinuousLinearMap,
      LinearIsometryEquiv.coe_toLinearIsometry, PiLp.proj_apply, e, piLpEquiv_blockFourierMode]
    split_ifs
    · exact fourierBasis_mem_hardySubmodule n
    · exact hardySubmodule.zero_mem
  · intro hf; rw [eq_sum_coordIncl f]
    refine (blockHardySubmodule r).sum_mem fun i _ ↦
      coordIncl_mem_of_mem_topologicalClosure i (isClosed_blockHardySubmodule r) ?_
        (hardySubmodule_def ▸ hf i)
    rintro _ ⟨n, rfl⟩; exact blockFourierMode_mem_blockHardySubmodule r n i

/-- A vector-valued circle `L²` function lies in `blockHardySubmodule r` if and only if all of its
negative Fourier coefficients vanish. -/
theorem mem_blockHardySubmodule_iff {r : ℕ}
    (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) :
    f ∈ blockHardySubmodule r ↔ ∀ n : ℤ, n < 0 → fourierCoeff f n = 0 := by
  rw [mem_blockHardySubmodule_iff_piLpEquiv]
  simp_rw [mem_hardySubmodule_iff, PiLp.ext_iff, PiLp.zero_apply, fourierCoeff_piLp_apply]
  exact ⟨fun h n hn i ↦ h i n hn, fun h i n hn ↦ h n hn i⟩

/-- The span of all vector Fourier modes is dense in vector-valued circle `L²`. -/
theorem dense_span_blockFourierMode (r : ℕ) :
    Dense (Submodule.span ℂ
      (Set.range fun p : ℤ × Fin r ↦ blockFourierMode r p.1 p.2) :
        Set (Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1)))) := by
  rw [Submodule.dense_iff_topologicalClosure_eq_top, eq_top_iff]; intro f _
  rw [eq_sum_coordIncl f]
  refine Submodule.sum_mem _ fun i _ ↦ coordIncl_mem_of_mem_topologicalClosure i
    (Submodule.isClosed_topologicalClosure _) ?_
    ((fourierBasis (T := 1)).dense_span.symm ▸ Submodule.mem_top)
  rintro _ ⟨n, rfl⟩
  exact Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨(n, i), rfl⟩)

/-- Multiplying a vector trigonometric polynomial by a sufficiently high scalar Fourier mode moves
it into `blockHardySubmodule r`. -/
theorem eventually_fourierLp_smul_mem_blockHardySubmodule {r : ℕ}
    {g : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))}
    (hg : g ∈ Submodule.span ℂ (Set.range fun p : ℤ × Fin r ↦ blockFourierMode r p.1 p.2)) :
    ∀ᶠ N : ℤ in Filter.atTop,
      (fourierLp (T := 1) ∞ N • g :
        Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) ∈
          blockHardySubmodule r := by
  have hcoord (i : Fin r) :
      Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) g i ∈
        Submodule.span ℂ (Set.range (fourierBasis (T := 1))) := by
    induction hg using Submodule.span_induction with
    | mem _ hx =>
      obtain ⟨⟨n, j⟩, rfl⟩ := hx; rw [piLpEquiv_blockFourierMode]
      split_ifs with hij
      · exact Submodule.subset_span ⟨n, rfl⟩
      · exact Submodule.zero_mem _
    | zero => simp
    | add _ _ _ _ hx hy => rw [map_add, PiLp.add_apply]; exact Submodule.add_mem _ hx hy
    | smul c _ _ hx => rw [map_smul, PiLp.smul_apply]; exact Submodule.smul_mem _ c hx
  filter_upwards [Filter.eventually_all.mpr fun i ↦
    eventually_fourierLp_smul_mem_hardySubmodule (hcoord i)] with N hN
  exact (mem_blockHardySubmodule_iff_piLpEquiv _).mpr fun i ↦ by
    rw [Lp.piLpEquiv_lpSMul]; exact hN i

/-- The canonical unitary equivalence between the closed nonnegative-mode subspace
`blockHardySubmodule r` of vector-valued circle `L²` and `BlockHardySpace r`. -/
def blockHardyEquiv (r : ℕ) : ↥(blockHardySubmodule r) ≃ₗᵢ[ℂ] BlockHardySpace r :=
  Lp.subspacePiLpEquiv (blockHardySubmodule r) (fun _ ↦ hardySubmodule) fun f ↦
    mem_blockHardySubmodule_iff_piLpEquiv f

/-- Coordinatewise evaluation of `blockHardyEquiv r` in circle `L²`. -/
@[simp]
theorem coe_blockHardyEquiv_apply {r : ℕ} (f : ↥(blockHardySubmodule r)) (i : Fin r) :
    (blockHardyEquiv r f i : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) =
      Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) f.1 i := by
  rw [blockHardyEquiv]; exact Lp.coe_subspacePiLpEquiv_apply _ _ _ f i

/-- Coordinatewise evaluation of `(blockHardyEquiv r).symm` under `Lp.piLpEquiv`. -/
@[simp]
theorem piLpEquiv_coe_blockHardyEquiv_symm {r : ℕ} (g : BlockHardySpace r) (i : Fin r) :
    Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1))
      ((blockHardyEquiv r).symm g :
        Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) i =
      (g i : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) := by
  rw [blockHardyEquiv]; exact Lp.piLpEquiv_coe_subspacePiLpEquiv_symm _ _ _ g i

/-- A block Hardy vector concentrated in coordinate `j` embeds into ambient vector `L²` as a single
coordinate under `Lp.piLpEquiv`. -/
theorem coe_blockHardyEquiv_symm_single {r : ℕ} (j : Fin r) (h : HardySpace) :
    ((blockHardyEquiv r).symm (PiLp.single 2 j h) :
      Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) =
      (Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1))).symm
        (PiLp.single 2 j (h : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1)))) := by
  rw [blockHardyEquiv]
  exact Lp.coe_subspacePiLpEquiv_symm_single (blockHardySubmodule r) (fun _ ↦ hardySubmodule) _ j h

/-- Orthogonal projection onto `blockHardySubmodule r` acts coordinatewise as scalar Hardy
projection. -/
@[simp]
theorem blockHardyEquiv_orthogonalProjectionOnto {r : ℕ}
    (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) (i : Fin r) :
    blockHardyEquiv r ((blockHardySubmodule r).orthogonalProjectionOnto f) i =
      hardySubmodule.orthogonalProjectionOnto
        (Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) f i) := by
  set e := Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1))
  let p : BlockHardySpace r := WithLp.toLp 2 fun j ↦ hardySubmodule.orthogonalProjectionOnto (e f j)
  suffices h : (blockHardySubmodule r).orthogonalProjectionOnto f = (blockHardyEquiv r).symm p by
    rw [h, LinearIsometryEquiv.apply_symm_apply, PiLp.toLp_apply]
  refine ext_inner_left ℂ fun w ↦ ?_
  rw [Submodule.inner_orthogonalProjectionOnto_eq_of_mem_left,
    ← (blockHardySubmodule r).subtypeₗᵢ.inner_map_map, Submodule.coe_subtypeₗᵢ,
    Submodule.subtype_apply, Submodule.subtype_apply, ← e.inner_map_map, PiLp.inner_apply,
    ← e.inner_map_map, PiLp.inner_apply]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [piLpEquiv_coe_blockHardyEquiv_symm]
  exact (Submodule.inner_orthogonalProjectionOnto_eq_of_mem_left
    ⟨e w.1 j, (mem_blockHardySubmodule_iff_piLpEquiv w.1).mp w.2 j⟩ (e f j)).symm

/-- Ambient `starProjection` onto `blockHardySubmodule r` acts coordinatewise as
`hardySubmodule.starProjection`. -/
theorem piLpEquiv_blockHardySubmodule_starProjection {r : ℕ}
    (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) (i : Fin r) :
    Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1))
       ((blockHardySubmodule r).starProjection f) i =
        hardySubmodule.starProjection
          (Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) f i) := by
  rw [← Submodule.coe_orthogonalProjectionOnto_apply,
    ← Submodule.coe_orthogonalProjectionOnto_apply,
    ← coe_blockHardyEquiv_apply, blockHardyEquiv_orthogonalProjectionOnto]

/-- A vector-valued `L²` function lies in `(blockHardySubmodule r)ᗮ` if and only if each scalar
coordinate lies in `hardySubmoduleᗮ`. -/
theorem mem_blockHardySubmodule_orthogonal_iff_piLpEquiv {r : ℕ}
    (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) :
    f ∈ (blockHardySubmodule r)ᗮ ↔
      ∀ i : Fin r,
        Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) f i ∈
          hardySubmoduleᗮ := by
  rw [← Submodule.orthogonalProjectionOnto_eq_zero_iff, ← (blockHardyEquiv r).map_eq_zero_iff,
    PiLp.ext_iff]
  exact forall_congr' fun i ↦ by
    rw [PiLp.zero_apply, blockHardyEquiv_orthogonalProjectionOnto,
      Submodule.orthogonalProjectionOnto_eq_zero_iff]

/-- The orthogonal complement `(blockHardySubmodule r)ᗮ` consists of the vector-valued `L²`
functions whose nonnegative Fourier coefficients vanish. -/
theorem mem_blockHardySubmodule_orthogonal_iff {r : ℕ}
    (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) :
    f ∈ (blockHardySubmodule r)ᗮ ↔ ∀ n : ℕ, fourierCoeff f (n : ℤ) = 0 := by
  rw [mem_blockHardySubmodule_orthogonal_iff_piLpEquiv]
  simp_rw [mem_hardySubmodule_orthogonal_iff, PiLp.ext_iff, PiLp.zero_apply,
    fourierCoeff_piLp_apply]
  exact ⟨fun h n i ↦ h i n, fun h i n ↦ h n i⟩

/-- Unitary identification of the actual orthogonal complement `↥(blockHardySubmodule r)ᗮ` with the
`L²` product of scalar `↥hardySubmoduleᗮ` spaces. -/
def blockHardyOrthogonalEquiv (r : ℕ) :
    ↥(blockHardySubmodule r)ᗮ ≃ₗᵢ[ℂ] PiLp 2 (fun _ : Fin r ↦ ↥hardySubmoduleᗮ) :=
  Lp.subspacePiLpEquiv (blockHardySubmodule r)ᗮ (fun _ ↦ hardySubmoduleᗮ) fun f ↦
    mem_blockHardySubmodule_orthogonal_iff_piLpEquiv f

/-- Coordinatewise evaluation of `blockHardyOrthogonalEquiv r` in circle `L²`. -/
@[simp]
theorem coe_blockHardyOrthogonalEquiv_apply {r : ℕ} (f : ↥(blockHardySubmodule r)ᗮ) (i : Fin r) :
    (blockHardyOrthogonalEquiv r f i : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) =
      Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) f.1 i := by
  rw [blockHardyOrthogonalEquiv]; exact Lp.coe_subspacePiLpEquiv_apply _ _ _ f i

/-- Orthogonal projection onto `(blockHardySubmodule r)ᗮ` acts coordinatewise as orthogonal
projection onto `hardySubmoduleᗮ`. -/
@[simp]
theorem blockHardyOrthogonalEquiv_orthogonalProjectionOnto {r : ℕ}
    (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1))) (i : Fin r) :
    blockHardyOrthogonalEquiv r ((blockHardySubmodule r)ᗮ.orthogonalProjectionOnto f) i =
      hardySubmoduleᗮ.orthogonalProjectionOnto
        (Lp.piLpEquiv 2 ℂ (fun _ : Fin r ↦ ℂ) (AddCircle.haarAddCircle (T := 1)) f i) := by
  apply Subtype.ext
  rw [coe_blockHardyOrthogonalEquiv_apply, Submodule.coe_orthogonalProjectionOnto_apply,
    Submodule.coe_orthogonalProjectionOnto_apply, Submodule.starProjection_orthogonal_val,
    Submodule.starProjection_orthogonal_val, map_sub, PiLp.sub_apply,
    piLpEquiv_blockHardySubmodule_starProjection]

/-- Isometric Fourier-sequence representation of `BlockHardySpace r` in the vector-valued `ℓ²`
carrier `lp (fun _ : ℕ ↦ EuclideanSpace ℂ (Fin r)) 2`. -/
def blockHardyRepr (r : ℕ) :
    BlockHardySpace r ≃ₗᵢ[ℂ] lp (fun _ : ℕ ↦ EuclideanSpace ℂ (Fin r)) 2 :=
  (LinearIsometryEquiv.piLpCongrRight 2 fun _ : Fin r ↦ hardyBasis.repr).trans
    (lp.piLpEquiv 2 ℂ (fun _ : ℕ ↦ fun _ : Fin r ↦ ℂ)).symm

/-- Coordinatewise evaluation of `blockHardyRepr r`. -/
@[simp]
theorem blockHardyRepr_apply {r : ℕ} (f : BlockHardySpace r) (n : ℕ) (i : Fin r) :
    blockHardyRepr r f n i = hardyBasis.repr (f i) n := by simp [blockHardyRepr]

/-- Coordinatewise evaluation of `(blockHardyRepr r).symm`. -/
@[simp]
theorem blockHardyRepr_symm_apply {r : ℕ}
    (c : lp (fun _ : ℕ ↦ EuclideanSpace ℂ (Fin r)) 2) (i : Fin r) :
    (blockHardyRepr r).symm c i =
      hardyBasis.repr.symm (lp.piLpEquiv 2 ℂ (fun _ : ℕ ↦ fun _ : Fin r ↦ ℂ) c i) := by
  simp [blockHardyRepr]

/-- Under `blockHardyEquiv r`, the sequence representation `blockHardyRepr r` sends a vector Hardy
function to its sequence of nonnegative vector Fourier coefficients. -/
theorem blockHardyRepr_blockHardyEquiv_eq_fourierCoeff {r : ℕ}
    (f : ↥(blockHardySubmodule r)) (n : ℕ) :
    blockHardyRepr r (blockHardyEquiv r f) n =
      fourierCoeff (f : Lp (EuclideanSpace ℂ (Fin r)) 2 (AddCircle.haarAddCircle (T := 1)))
        (n : ℤ) := by
  ext i
  rw [blockHardyRepr_apply, hardyBasis_repr, coe_blockHardyEquiv_apply,
    fourierCoeff_piLp_apply]

/-- The `(ℕ × Fin r)`-indexed Fourier Hilbert basis of `BlockHardySpace r`. -/
def blockHardyBasis (r : ℕ) : HilbertBasis (ℕ × Fin r) ℂ (BlockHardySpace r) :=
  HilbertBasis.mkOfOrthogonalEqBot
    (v := fun p : ℕ × Fin r ↦ PiLp.single 2 p.2 (hardyBasis p.1))
    (by
      rw [orthonormal_iff_ite]; rintro ⟨m, i⟩ ⟨n, j⟩
      rw [PiLp.inner_apply, Finset.sum_eq_single i (fun k _ hki ↦ by simp [hki]) (by simp)]
      by_cases hij : i = j
      · subst hij; simp [orthonormal_iff_ite.mp hardyBasis.orthonormal m n]
      · simp [hij])
    (by
      refine le_antisymm (fun x hx ↦ ?_) bot_le
      ext i : 1; apply hardyBasis.repr.injective; ext n
      simp only [PiLp.zero_apply, map_zero, lp.coeFn_zero, Pi.zero_apply,
        HilbertBasis.repr_apply_apply]
      have hmem := (Submodule.mem_orthogonal _ _).mp hx
        (PiLp.single 2 i (hardyBasis n)) (Submodule.subset_span ⟨(n, i), rfl⟩)
      rw [PiLp.inner_apply, Finset.sum_eq_single i (fun k _ hki ↦ by simp [hki]) (by simp)] at hmem
      simpa using hmem)

/-- Evaluation of `blockHardyBasis r` at `(n, i)` as `PiLp.single 2 i (hardyBasis n)`. -/
@[simp]
theorem blockHardyBasis_apply (r : ℕ) (p : ℕ × Fin r) :
    blockHardyBasis r p = PiLp.single 2 p.2 (hardyBasis p.1) :=
  congrFun (HilbertBasis.coe_mkOfOrthogonalEqBot _ _) p

/-- In `blockHardyBasis r`, matrix elements of any operator `T` on `BlockHardySpace r` are the
Hardy-basis matrix elements of its `piLpEntry` blocks. -/
theorem inner_blockHardyBasis_apply {r : ℕ} (T : BlockHardySpace r →L[ℂ] BlockHardySpace r)
    (m n : ℕ) (i j : Fin r) :
    ⟪blockHardyBasis r (m, i), T (blockHardyBasis r (n, j))⟫_ℂ =
      ⟪hardyBasis m, T.piLpEntry i j (hardyBasis n)⟫_ℂ := by
  rw [blockHardyBasis_apply, blockHardyBasis_apply, PiLp.inner_apply,
    Finset.sum_eq_single i (fun k _ hki ↦ by simp [hki]) (by simp)]
  simp

/-! ### Operator-normed matrix symbols on the unit circle -/

/-- Essentially bounded `(r × r)`-block symbols on the unit circle, modeled as
`Lp (EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin r)) ∞ haarAddCircle` with the operator
norm on fibres. -/
abbrev BlockSymbol (r : ℕ) :=
  Lp (EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin r)) ∞
    (AddCircle.haarAddCircle (T := 1))

/-- Extract the `(i, j)` scalar `L∞` entry of a block symbol `A : BlockSymbol r`. -/
def blockSymbolEntry (r : ℕ) (i j : Fin r) :
    BlockSymbol r →L[ℂ] Lp ℂ ∞ (AddCircle.haarAddCircle (T := 1)) :=
  (EuclideanSpace.proj i ∘L
    ContinuousLinearMap.apply ℂ (EuclideanSpace ℂ (Fin r)) (EuclideanSpace.single j 1)).compLpL ∞
    (AddCircle.haarAddCircle (T := 1))

/-- Insert a scalar `L∞` symbol into the `(i, j)` entry of a block symbol via
`Matrix.toEuclideanCLM (Matrix.single i j 1)`. -/
def blockSymbolSingle (r : ℕ) (i j : Fin r) :
    Lp ℂ ∞ (AddCircle.haarAddCircle (T := 1)) →L[ℂ] BlockSymbol r :=
  (ContinuousLinearMap.toSpanSingleton ℂ
    (Matrix.toEuclideanCLM (n := Fin r) (𝕜 := ℂ) (Matrix.single i j 1))).compLpL ∞
    (AddCircle.haarAddCircle (T := 1))

/-- Almost-everywhere evaluation of the `(i, j)` scalar entry of a block symbol. -/
theorem blockSymbolEntry_ae {r : ℕ} (i j : Fin r) (A : BlockSymbol r) :
    blockSymbolEntry r i j A =ᵐ[AddCircle.haarAddCircle (T := 1)]
      fun x ↦ A x (EuclideanSpace.single j 1) i := by
  rw [blockSymbolEntry]
  filter_upwards [(EuclideanSpace.proj i ∘L
    ContinuousLinearMap.apply ℂ (EuclideanSpace ℂ (Fin r))
      (EuclideanSpace.single j 1)).coeFn_compLpL A] with x hx
  simp only [hx, ContinuousLinearMap.comp_apply, ContinuousLinearMap.apply_apply,
    PiLp.proj_apply]

/-- Almost-everywhere evaluation of a single-entry block symbol. -/
theorem blockSymbolSingle_ae {r : ℕ} (i j : Fin r)
    (a : Lp ℂ ∞ (AddCircle.haarAddCircle (T := 1))) :
    blockSymbolSingle r i j a =ᵐ[AddCircle.haarAddCircle (T := 1)]
      fun x ↦ Matrix.toEuclideanCLM (n := Fin r) (𝕜 := ℂ) (Matrix.single i j (a x)) := by
  rw [blockSymbolSingle]
  filter_upwards [(ContinuousLinearMap.toSpanSingleton ℂ
    (Matrix.toEuclideanCLM (n := Fin r) (𝕜 := ℂ) (Matrix.single i j 1))).coeFn_compLpL a]
    with x hx
  rw [hx, ContinuousLinearMap.toSpanSingleton_apply, ← map_smul, Matrix.smul_single, smul_eq_mul,
    mul_one]

/-- Extracting the `(i, j)` entry of `blockSymbolSingle r k l a` recovers `a` at `(k, l)` and `0`
elsewhere. -/
@[simp]
theorem blockSymbolEntry_blockSymbolSingle {r : ℕ} (i j k l : Fin r)
    (a : Lp ℂ ∞ (AddCircle.haarAddCircle (T := 1))) :
    blockSymbolEntry r i j (blockSymbolSingle r k l a) =
      if i = k ∧ j = l then a else 0 := Lp.ext <| by
  by_cases h : i = k ∧ j = l
  · rcases h with ⟨rfl, rfl⟩; simp only [and_self, ↓reduceIte]
    filter_upwards [blockSymbolEntry_ae i j (blockSymbolSingle r i j a),
      blockSymbolSingle_ae i j a] with x h₁ h₂
    simp [h₁, h₂, EuclideanSpace.single]
  · rw [ite_eq_right h]
    have hkl : ¬(k = i ∧ l = j) := fun ⟨hki, hlj⟩ ↦ h ⟨hki.symm, hlj.symm⟩
    filter_upwards [blockSymbolEntry_ae i j (blockSymbolSingle r k l a),
      blockSymbolSingle_ae k l a,
      Lp.coeFn_zero ℂ ∞ (AddCircle.haarAddCircle (T := 1))] with x h₁ h₂ h₀
    rw [h₁, h₂, h₀]
    simp [EuclideanSpace.single, hkl]

/-- Extracting the `(i, j)` scalar entry of a matrix of scalar `L∞` symbols assembled via
`blockSymbolSingle` recovers the `(i, j)` symbol. -/
theorem blockSymbolEntry_sum_blockSymbolSingle {r : ℕ}
    (a : Fin r → Fin r → Lp ℂ ∞ (AddCircle.haarAddCircle (T := 1))) (i j : Fin r) :
    blockSymbolEntry r i j (∑ k : Fin r, ∑ l : Fin r, blockSymbolSingle r k l (a k l)) =
      a i j := by
  have hmap (f : Fin r → BlockSymbol r) :
      blockSymbolEntry r i j (∑ x, f x) = ∑ x, blockSymbolEntry r i j (f x) :=
    map_sum (blockSymbolEntry r i j).toLinearMap.toAddMonoidHom f Finset.univ
  simp_rw [hmap, blockSymbolEntry_blockSymbolSingle, and_comm (a := i = _), ite_and]
  simp

/-- Every block symbol is the finite sum of its scalar matrix entries along the matrix units. -/
theorem eq_sum_blockSymbolSingle {r : ℕ} (A : BlockSymbol r) :
    A = ∑ i : Fin r, ∑ j : Fin r, blockSymbolSingle r i j (blockSymbolEntry r i j A) := Lp.ext <| by
  have hsum_inner (i : Fin r) :
      (∑ j : Fin r, blockSymbolSingle r i j (blockSymbolEntry r i j A))
        =ᵐ[AddCircle.haarAddCircle (T := 1)]
          fun x ↦ ∑ j : Fin r,
            Matrix.toEuclideanCLM (n := Fin r) (𝕜 := ℂ)
              (Matrix.single i j (A x (EuclideanSpace.single j 1) i)) := by
    filter_upwards [Lp.coeFn_fun_finsetSum Finset.univ
      (fun j ↦ blockSymbolSingle r i j (blockSymbolEntry r i j A)),
      ae_all_iff.mpr fun j ↦ (blockSymbolSingle_ae i j (blockSymbolEntry r i j A)).and
        (blockSymbolEntry_ae i j A)] with x hsum hj
    exact hsum.trans <| Finset.sum_congr rfl fun j _ ↦ by rw [(hj j).1, (hj j).2]
  filter_upwards [Lp.coeFn_fun_finsetSum Finset.univ
    (fun i ↦ ∑ j : Fin r, blockSymbolSingle r i j (blockSymbolEntry r i j A)),
    ae_all_iff.mpr hsum_inner] with x hsum hi
  rw [hsum, Finset.sum_congr rfl fun i _ ↦ hi i]
  set X := (Matrix.toEuclideanCLM (n := Fin r) (𝕜 := ℂ)).symm (A x)
  have hAX : A x = Matrix.toEuclideanCLM (n := Fin r) (𝕜 := ℂ) X :=
    ((Matrix.toEuclideanCLM (n := Fin r) (𝕜 := ℂ)).apply_symm_apply (A x)).symm
  have hX (i j : Fin r) : A x (EuclideanSpace.single j 1) i = X i j := by
    simp [hAX, EuclideanSpace.single]
  simp_rw [hX, ← map_sum, ← Matrix.matrix_eq_sum_single X, hAX]

/-- The `(i, j)` scalar entry of a constant matrix symbol is the corresponding constant scalar
symbol. -/
@[simp]
theorem blockSymbolEntry_const {r : ℕ}
    (M : EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin r)) (i j : Fin r) :
    blockSymbolEntry r i j (Lp.const ∞ (AddCircle.haarAddCircle (T := 1)) M) =
      Lp.const ∞ (AddCircle.haarAddCircle (T := 1)) (M (EuclideanSpace.single j 1) i) := by
  apply Lp.ext
  filter_upwards [blockSymbolEntry_ae i j (Lp.const ∞ (AddCircle.haarAddCircle (T := 1)) M),
    Lp.coeFn_const ∞ (AddCircle.haarAddCircle (T := 1)) M,
    Lp.coeFn_const ∞ (AddCircle.haarAddCircle (T := 1))
      (M (EuclideanSpace.single j 1) i)] with x h₁ h₂ h₃
  simp only [h₁, h₂, h₃, Function.const_apply]

/-- The `(i, j)` scalar entry of a scalar symbol tensor the identity matrix is `a` on the diagonal
and `0` off the diagonal. -/
theorem blockSymbolEntry_smul_const_one {r : ℕ}
    (a : Lp ℂ ∞ (AddCircle.haarAddCircle (T := 1))) (i j : Fin r) :
    blockSymbolEntry r i j
      (a • Lp.const ∞ (AddCircle.haarAddCircle (T := 1))
        (1 : EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin r)) : BlockSymbol r) =
      if i = j then a else 0 := by
  let oneSym : BlockSymbol r := Lp.const ∞ (AddCircle.haarAddCircle (T := 1)) 1
  have hone := Lp.coeFn_const ∞ (AddCircle.haarAddCircle (T := 1))
    (1 : EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin r))
  by_cases hij : i = j
  · subst hij; rw [ite_eq_left rfl]; apply Lp.ext
    filter_upwards [blockSymbolEntry_ae i i (a • oneSym), Lp.coeFn_lpSMul (r := ∞) a oneSym,
      hone] with x h₁ h₂ h₃
    rw [h₁, h₂, Pi.smul_apply', h₃]; simp [EuclideanSpace.single]
  · rw [ite_eq_right hij]; apply Lp.ext
    filter_upwards [blockSymbolEntry_ae i j (a • oneSym), Lp.coeFn_lpSMul (r := ∞) a oneSym,
      hone, Lp.coeFn_zero ℂ ∞ (AddCircle.haarAddCircle (T := 1))] with x h₁ h₂ h₃ h₀
    rw [h₁, h₂, Pi.smul_apply', h₃, h₀]; simp [EuclideanSpace.single, hij]

/-- Extracting the `(i, j)` scalar entry commutes with `ContinuousMap.toLp ∞`. -/
@[simp]
theorem blockSymbolEntry_toLp {r : ℕ}
    (F : C(UnitAddCircle, EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin r)))
    (i j : Fin r) :
    blockSymbolEntry r i j (ContinuousMap.toLp ∞ (AddCircle.haarAddCircle (T := 1)) ℂ F) =
      ContinuousMap.toLp ∞ (AddCircle.haarAddCircle (T := 1)) ℂ
        ⟨fun x ↦ F x (EuclideanSpace.single j 1) i, by fun_prop⟩ := by
  apply Lp.ext
  filter_upwards [blockSymbolEntry_ae i j
      (ContinuousMap.toLp ∞ (AddCircle.haarAddCircle (T := 1)) ℂ F),
    ContinuousMap.coeFn_toLp (p := ∞) (𝕜 := ℂ) (AddCircle.haarAddCircle (T := 1)) F,
    ContinuousMap.coeFn_toLp (p := ∞) (𝕜 := ℂ) (AddCircle.haarAddCircle (T := 1))
      ⟨fun x ↦ F x (EuclideanSpace.single j 1) i, by fun_prop⟩] with x h₁ h₂ h₃
  rw [h₁, h₂, h₃]; simp

/-- Taking the `(i, j)` scalar entry of the adjoint symbol `star A` gives the conjugate of the
`(j, i)` scalar entry of `A`. -/
@[simp]
theorem blockSymbolEntry_star {r : ℕ} (A : BlockSymbol r) (i j : Fin r) :
    blockSymbolEntry r i j (star A) = star (blockSymbolEntry r j i A) := Lp.ext <| by
  filter_upwards [blockSymbolEntry_ae i j (star A), Lp.coeFn_star A,
    Lp.coeFn_star (blockSymbolEntry r j i A), blockSymbolEntry_ae j i A] with x h₁ h₂ h₃ h₄
  rw [h₁, h₂, h₃, Pi.star_apply, Pi.star_apply, h₄, ContinuousLinearMap.star_eq_adjoint]
  have hinner := ContinuousLinearMap.adjoint_inner_right (A x)
    (EuclideanSpace.single i (1 : ℂ)) (EuclideanSpace.single j (1 : ℂ))
  simpa [EuclideanSpace.inner_single_left, EuclideanSpace.inner_single_right, RCLike.star_def]
    using hinner

/-- The `(i, j)` scalar Fourier coefficient of `A` equals the `(i, j)` matrix entry of the
operator-valued Fourier coefficient `fourierCoeff A n`. -/
theorem fourierCoeff_blockSymbolEntry {r : ℕ} (A : BlockSymbol r) (i j : Fin r) (n : ℤ) :
    fourierCoeff (blockSymbolEntry r i j A) n =
      fourierCoeff A n (EuclideanSpace.single j 1) i := by
  let entry : (EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin r)) →L[ℂ] ℂ :=
    EuclideanSpace.proj i ∘L
      ContinuousLinearMap.apply ℂ (EuclideanSpace ℂ (Fin r)) (EuclideanSpace.single j 1)
  have hae : blockSymbolEntry r i j A =ᵐ[AddCircle.haarAddCircle (T := 1)]
      fun x ↦ entry (A x) :=
    (blockSymbolEntry_ae i j A).mono fun x hx ↦ by simp [hx, entry]
  rw [fourierCoeff_congr_ae hae, entry.fourierCoeff_comp ((Lp.memLp A).integrable le_top) n]
  simp [entry]

/-- Matrix-element form of `fourierCoeff_blockSymbolEntry` in the standard basis of
`EuclideanSpace ℂ (Fin r)`. -/
theorem inner_single_fourierCoeff_blockSymbol {r : ℕ} (A : BlockSymbol r) (i j : Fin r) (n : ℤ) :
    ⟪EuclideanSpace.single i (1 : ℂ), fourierCoeff A n (EuclideanSpace.single j (1 : ℂ))⟫_ℂ =
      fourierCoeff (blockSymbolEntry r i j A) n := by
  rw [fourierCoeff_blockSymbolEntry, EuclideanSpace.inner_single_left, map_one, one_mul]

/-- The `n`-th operator-valued Fourier coefficient of `star A` is the Hilbert-space adjoint of the
`(-n)`-th Fourier coefficient of `A`. -/
@[simp]
theorem fourierCoeff_star_blockSymbol {r : ℕ} (A : BlockSymbol r) (n : ℤ) :
    fourierCoeff (star A : BlockSymbol r) n =
      ContinuousLinearMap.adjoint (fourierCoeff A (-n)) := by
  refine ContinuousLinearMap.ext fun v ↦ PiLp.ext fun i ↦ ?_
  conv_lhs => rw [← (EuclideanSpace.basisFun (Fin r) ℂ).sum_repr v]
  conv_rhs => rw [← (EuclideanSpace.basisFun (Fin r) ℂ).sum_repr v]
  simp only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply, map_sum,
    WithLp.ofLp_sum, Finset.sum_apply]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [map_smul, map_smul, PiLp.smul_apply, PiLp.smul_apply, smul_eq_mul, smul_eq_mul]
  congr 1
  have hinner := ContinuousLinearMap.adjoint_inner_right (fourierCoeff A (-n))
    (EuclideanSpace.single i (1 : ℂ)) (EuclideanSpace.single j (1 : ℂ))
  rw [← fourierCoeff_blockSymbolEntry, blockSymbolEntry_star, fourierCoeff_star,
    ← inner_single_fourierCoeff_blockSymbol, inner_conj_symm]
  simpa [EuclideanSpace.inner_single_left] using hinner.symm

end TauCeti
