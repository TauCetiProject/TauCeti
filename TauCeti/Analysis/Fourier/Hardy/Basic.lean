public import TauCeti.Analysis.Fourier.AddCircle
public import TauCeti.Analysis.InnerProductSpace.HilbertBasis.Basic
public import TauCeti.MeasureTheory.Function.Lp.Multiplication

/-!
# The boundary Hardy Hilbert space

The boundary Hardy space is the closed complex subspace of the native `L²` space on
`UnitAddCircle` generated by the nonnegative Fourier modes. Its elements are exactly the
functions with vanishing negative Fourier coefficients. The nonnegative modes form a Hilbert
basis, whose representation identifies the space isometrically with native `lp` sequences.
The ambient orthogonal projection and complementary negative modes provide the boundary
decomposition used to compress multiplication operators to Hardy space. Multiplication by a
sufficiently high Fourier mode moves every trigonometric polynomial into Hardy space
(`TauCeti.eventually_fourierLp_smul_mem_hardySubmodule`).

The conventions are those of Conway, *A Course in Functional Analysis*, second edition:
normalized Haar measure and the modes `exp (2πint)`. The formal construction uses Mathlib's
`fourierBasis` and `HilbertBasis.mkOfOrthogonalEqBot`.
-/

public section

noncomputable section

open MeasureTheory Submodule
open scoped ENNReal InnerProductSpace

namespace TauCeti

/-- The closed subspace of circle `L²` generated by the nonnegative Fourier modes. -/
def hardySubmodule : Submodule ℂ (Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) :=
  (Submodule.span ℂ (Set.range (fun n : ℕ => (fourierBasis (T := 1)) (n : ℤ)))).topologicalClosure

/-- The boundary Hardy space, with the norm and inner product inherited from circle `L²`. -/
abbrev HardySpace := ↥hardySubmodule

/-- The Hardy submodule is the closed span of the nonnegative Fourier modes. -/
theorem hardySubmodule_def : hardySubmodule =
    (Submodule.span ℂ (Set.range (fun n : ℕ =>
      fourierBasis (T := 1) (n : ℤ)))).topologicalClosure :=
  (rfl)

/-- The boundary Hardy subspace is closed in native circle `L²`. -/
theorem isClosed_hardySubmodule : IsClosed (hardySubmodule :
    Set (Lp ℂ 2 (AddCircle.haarAddCircle (T := 1)))) :=
  Submodule.isClosed_topologicalClosure _

/-- Boundary Hardy space is a Hilbert space. -/
instance : CompleteSpace HardySpace :=
  isClosed_hardySubmodule.completeSpace_coe

/-- Every nonnegative Fourier mode belongs to the boundary Hardy space. -/
theorem fourierBasis_mem_hardySubmodule (n : ℕ) :
    fourierBasis (T := 1) (n : ℤ) ∈ hardySubmodule :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨n, rfl⟩)

/-- Multiplying a trigonometric polynomial by a sufficiently high Fourier mode lands in Hardy
space. -/
theorem eventually_fourierLp_smul_mem_hardySubmodule
    {g : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))}
    (hg : g ∈ Submodule.span ℂ (Set.range (fourierBasis (T := 1)))) :
    ∀ᶠ N : ℤ in Filter.atTop,
      (fourierLp (T := 1) ∞ N • g : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) ∈
        hardySubmodule := by
  simp only [← Lp.multiplicationOperator_apply]
  induction hg using Submodule.span_induction with
  | mem _ hx =>
    obtain ⟨m, rfl⟩ := hx
    filter_upwards [Filter.eventually_ge_atTop (-m)] with N hN
    obtain ⟨k, hk⟩ := Int.eq_ofNat_of_zero_le (by omega : 0 ≤ N + m)
    rw [Lp.multiplicationOperator_apply, fourierLp_smul_fourierBasis, hk]
    exact fourierBasis_mem_hardySubmodule k
  | zero => exact Filter.Eventually.of_forall fun N ↦ by simp
  | add _ _ _ _ hx hy =>
    filter_upwards [hx, hy] with N hx hy
    rw [map_add]
    exact add_mem hx hy
  | smul c _ _ hx =>
    filter_upwards [hx] with N hx
    rw [map_smul]
    exact Submodule.smul_mem _ c hx

/-- A circle `L²` function is in the Hardy space exactly when its negative coefficients vanish. -/
theorem mem_hardySubmodule_iff (f : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) :
    f ∈ hardySubmodule ↔ ∀ n : ℤ, n < 0 → fourierCoeff f n = 0 := by
  constructor
  · intro hf n hn
    let c := innerSL ℂ (fourierBasis (T := 1) n)
    have hle : hardySubmodule ≤ c.ker := by
      apply Submodule.topologicalClosure_minimal
      · apply Submodule.span_le.mpr
        rintro _ ⟨k, rfl⟩
        have hnk : n ≠ (k : ℤ) := by omega
        exact orthonormal_iff_ite.mp (fourierBasis (T := 1)).orthonormal n (k : ℤ)
          |>.trans (ite_eq_right hnk)
      · exact c.isClosed_ker
    simpa only [LinearMap.mem_ker, c, ContinuousLinearMap.coe_coe, innerSL_apply_apply,
      ← HilbertBasis.repr_apply_apply, fourierBasis_repr] using hle hf
  · intro hf
    apply isClosed_hardySubmodule.mem_of_tendsto
      ((fourierBasis (T := 1)).hasSum_repr f)
    apply Filter.Eventually.of_forall
    intro s
    apply hardySubmodule.sum_mem
    intro n _
    by_cases hn : 0 ≤ n
    · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hn
      exact hardySubmodule.smul_mem _ (fourierBasis_mem_hardySubmodule k)
    · simp [fourierBasis_repr, hf n (by omega)]

/-- The nonnegative Fourier modes, viewed in their closed span. -/
private def hardyMode (n : ℕ) : HardySpace :=
  ⟨fourierBasis (T := 1) (n : ℤ), fourierBasis_mem_hardySubmodule n⟩

/-- The ambient `L²` representative of a Hardy mode is the corresponding Fourier basis vector. -/
private theorem coe_hardyMode (n : ℕ) :
    (hardyMode n : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) =
      fourierBasis (T := 1) (n : ℤ) :=
  (rfl)

/-- The Hardy modes form an orthonormal family. -/
private theorem orthonormal_hardyMode : Orthonormal ℂ hardyMode := by
  apply (hardySubmodule.subtypeₗᵢ.orthonormal_comp_iff).mp
  exact (fourierBasis (T := 1)).orthonormal.comp (fun n : ℕ => (n : ℤ)) Int.ofNat_injective

/-- The natural-number-indexed Fourier Hilbert basis of boundary Hardy space. -/
def hardyBasis : HilbertBasis ℕ ℂ HardySpace :=
  HilbertBasis.mkOfOrthogonalEqBot orthonormal_hardyMode (by
    apply le_antisymm _ bot_le
    intro x hx
    apply Subtype.ext
    simp only [Submodule.coe_zero]
    apply (fourierBasis (T := 1)).repr.injective
    rw [map_zero]
    apply lp.ext
    funext n
    simp only [lp.coeFn_zero, Pi.zero_apply, fourierBasis_repr]
    by_cases hn : 0 ≤ n
    · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hn
      rw [← fourierBasis_repr, HilbertBasis.repr_apply_apply]
      exact (Submodule.mem_orthogonal _ _).mp hx (hardyMode k)
        (Submodule.subset_span ⟨k, rfl⟩)
    · exact (mem_hardySubmodule_iff x.val).mp x.property n (by omega))

/-- The basis vector indexed by `n` is the nonnegative Fourier mode `n`. -/
private theorem hardyBasis_apply (n : ℕ) : hardyBasis n = hardyMode n := by
  exact congrFun (HilbertBasis.coe_mkOfOrthogonalEqBot _ _) n

/-- Hardy basis vectors are precisely the nonnegative ambient Fourier modes. -/
@[simp]
theorem coe_hardyBasis (n : ℕ) :
    (hardyBasis n : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) =
      fourierBasis (T := 1) (n : ℤ) := by
  rw [hardyBasis_apply, coe_hardyMode]

/-- Hardy coordinates are the ordinary nonnegative Fourier coefficients. -/
theorem hardyBasis_repr (f : HardySpace) (n : ℕ) :
    hardyBasis.repr f n = fourierCoeff (f : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1)))
      (n : ℤ) := by
  rw [HilbertBasis.repr_apply_apply, ← hardySubmodule.subtypeₗᵢ.inner_map_map]
  simp only [Submodule.coe_subtypeₗᵢ, Submodule.subtype_apply, coe_hardyBasis,
    ← HilbertBasis.repr_apply_apply, fourierBasis_repr]

/-- Hardy functions have no negative Fourier coefficients. -/
theorem HardySpace.fourierCoeff_eq_zero (f : HardySpace) {n : ℤ} (hn : n < 0) :
    fourierCoeff (f : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) n = 0 :=
  (mem_hardySubmodule_iff _).mp f.property n hn

/-- Each Hardy coefficient is bounded by the norm of the Hardy function. -/
theorem HardySpace.norm_fourierCoeff_le (x : HardySpace) (n : ℕ) :
    ‖fourierCoeff (x : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) n‖ ≤ ‖x‖ := by
  rw [← hardyBasis_repr, ← hardyBasis.repr.norm_map x]
  exact lp.norm_apply_le_norm two_ne_zero _ n

/-- Projection retains every nonnegative Fourier coefficient. -/
theorem hardyBasis_repr_orthogonalProjectionOnto
    (f : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) (n : ℕ) :
    hardyBasis.repr (hardySubmodule.orthogonalProjectionOnto f) n =
      fourierCoeff f (n : ℤ) := by
  rw [HilbertBasis.repr_apply_apply,
    Submodule.inner_orthogonalProjectionOnto_eq_of_mem_left, coe_hardyBasis,
    ← HilbertBasis.repr_apply_apply, fourierBasis_repr]

/-- Orthogonal Hardy projection deletes precisely the negative Fourier coefficients. -/
@[simp]
theorem fourierCoeff_hardySubmodule_starProjection
    (f : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) (n : ℤ) :
    fourierCoeff (hardySubmodule.starProjection f) n =
        if 0 ≤ n then fourierCoeff f n else 0 := by
  rw [← Submodule.coe_orthogonalProjectionOnto_apply]
  split_ifs with hn
  · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hn
    rw [← hardyBasis_repr, hardyBasis_repr_orthogonalProjectionOnto]
  · exact HardySpace.fourierCoeff_eq_zero _ (by omega)

/-- The orthogonal complement of Hardy space consists of functions with only negative modes. -/
theorem mem_hardySubmodule_orthogonal_iff
    (f : Lp ℂ 2 (AddCircle.haarAddCircle (T := 1))) :
    f ∈ hardySubmoduleᗮ ↔ ∀ n : ℕ, fourierCoeff f (n : ℤ) = 0 := by
  constructor
  · intro hf n
    rw [← fourierBasis_repr, HilbertBasis.repr_apply_apply]
    exact hardySubmodule.inner_right_of_mem_orthogonal
      (fourierBasis_mem_hardySubmodule n) hf
  · intro hf
    apply (Submodule.mem_orthogonal _ _).mpr
    intro x hx
    apply inner_eq_zero_symm.mp
    apply hardyBasis.inner_eq_zero_of_forall_inner_eq_zero (y := x) _ hx
    intro n
    rw [coe_hardyBasis, inner_eq_zero_symm, ← HilbertBasis.repr_apply_apply,
      fourierBasis_repr, hf n]

/-- The negative Fourier modes span exactly the orthogonal complement of Hardy space.
Together with `Submodule.isCompl_orthogonal`, this gives the orthogonal splitting of circle `L²`
into its nonnegative and negative modes. -/
theorem hardySubmodule_orthogonal_eq :
    hardySubmoduleᗮ =
      (Submodule.span ℂ (Set.range (fun n : ℕ =>
        fourierBasis (T := 1) (-(n : ℤ) - 1)))).topologicalClosure := by
  apply le_antisymm
  · intro f hf
    apply (Submodule.isClosed_topologicalClosure _).mem_of_tendsto
      ((fourierBasis (T := 1)).hasSum_repr f)
    apply Filter.Eventually.of_forall
    intro s
    apply Submodule.sum_mem
    intro n _
    by_cases hn : n < 0
    · have hnonneg : 0 ≤ -n - 1 := by omega
      obtain ⟨k, hk⟩ := Int.eq_ofNat_of_zero_le hnonneg
      have heq : n = -(k : ℤ) - 1 := by omega
      rw [heq]
      exact Submodule.smul_mem _ _
        (Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨k, rfl⟩))
    · have hnonneg : 0 ≤ n := by omega
      obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hnonneg
      simp [fourierBasis_repr, (mem_hardySubmodule_orthogonal_iff f).mp hf k]
  · apply Submodule.topologicalClosure_minimal
    · apply Submodule.span_le.mpr
      rintro _ ⟨k, rfl⟩
      apply (mem_hardySubmodule_orthogonal_iff _).mpr
      intro n
      rw [← fourierBasis_repr, HilbertBasis.repr_apply_apply]
      have hne : (n : ℤ) ≠ -(k : ℤ) - 1 := by omega
      exact (orthonormal_iff_ite.mp (fourierBasis (T := 1)).orthonormal _ _).trans
        (ite_eq_right hne)
    · exact hardySubmodule.isClosed_orthogonal

end TauCeti
