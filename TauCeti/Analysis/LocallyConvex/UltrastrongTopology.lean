/-!
# The ultrastrong operator topology

The ultrastrong (σ-strong) topology on bounded operators `E →L[𝕜] F` is generated by the
seminorms `T ↦ (∑ₙ ‖T ξₙ‖²)^(1/2)`, one for each square-summable sequence `ξ ∈ ℓ²(ℕ, E)`.
Equivalently, it is the topology making the ampliation `T ↦ ⊕ₙ T` on `ℓ²(ℕ, E)` continuous into
the strong operator topology there, and this is how it is defined here: a net `Tᵢ` converges
ultrastrongly to `T` exactly when `(⊕ Tᵢ) ξ → (⊕ T) ξ` in `ℓ²(ℕ, F)` for every `ξ`
(`TauCeti.ContinuousLinearMapUltrastrong.tendsto_iff_forall_ampliation_apply_tendsto`, and in
coordinates `tendsto_iff_forall_tsum_norm_sub_sq_tendsto_zero`).

As for Mathlib's weak operator topology `E →WOT[𝕜] F`, the topology lives on a type copy,
`TauCeti.ContinuousLinearMapUltrastrong 𝕜 E F`, so that it cannot be confused with the norm
topology. The copy is a Hausdorff locally convex topological vector space, with the seminorms
`‖(⊕ T) ξ‖` (`withSeminorms`); multiplication of operators on it is separately continuous.

The ultrastrong topology is coarser than the norm topology and finer than the strong operator
topology on Mathlib's pointwise-convergence copy `E →Lₚₜ[𝕜] F`. On norm-bounded sets the latter
comparison is an equality (`isInducing_restrict_toPointwiseConvergenceCLM`): for a uniformly
bounded net, strong and ultrastrong convergence agree. This is the bounded-set agreement used to
pass between the two topologies in von Neumann algebra theory.

The definition needs no inner product: `E` and `F` are arbitrary normed spaces.

## Implementation notes

The type copy follows Mathlib's `ContinuousLinearMapWOT`: its algebraic structure is transported
from `E →L[𝕜] F` along `ContinuousLinearMapUltrastrong.equiv`, and the definitions are exposed so
that this transport, and the agreement of the uniform structure with the topology, hold by
definition for downstream files.

## References

* J. Dixmier, *Von Neumann Algebras*, North-Holland, 1981, Part I, Chapter 3, §1.
* M. Takesaki, *Theory of Operator Algebras I*, Springer, 1979, Chapter II, §2.
-/

@[expose] public section

open Filter Topology
open scoped lp ENNReal

namespace TauCeti

/-- The type copy of `E →L[𝕜] F` endowed with the ultrastrong operator topology: the coarsest
topology for which `T ↦ (⊕ₙ T) ξ` is continuous into `ℓ²(ℕ, F)` for every `ξ ∈ ℓ²(ℕ, E)`. -/
@[ext]
structure ContinuousLinearMapUltrastrong (𝕜 E F : Type*) [NontriviallyNormedField 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E] [NormedAddCommGroup F] [NormedSpace 𝕜 F] where
  /-- Regard a bounded operator as an element of the ultrastrong copy. -/
  ofCLM ::
  /-- The bounded operator underlying an element of the ultrastrong copy. -/
  toCLM : E →L[𝕜] F

namespace ContinuousLinearMapUltrastrong

variable {𝕜 E F : Type*} [NontriviallyNormedField 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E] [NormedAddCommGroup F] [NormedSpace 𝕜 F]

/-! ### Algebraic structure, copied from `E →L[𝕜] F` -/

section Algebra

/-- The equivalence between the ultrastrong copy and `E →L[𝕜] F`. -/
@[simps]
def equiv : ContinuousLinearMapUltrastrong 𝕜 E F ≃ (E →L[𝕜] F) where
  toFun := toCLM
  invFun := ofCLM
  left_inv _ := rfl
  right_inv _ := rfl

theorem toCLM_injective :
    Function.Injective (toCLM : ContinuousLinearMapUltrastrong 𝕜 E F → E →L[𝕜] F) :=
  equiv.injective

instance instAddCommGroup : AddCommGroup (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  equiv.addCommGroup

/-- The additive equivalence between the ultrastrong copy and `E →L[𝕜] F`. -/
@[implicit_reducible, simps!]
def addEquiv : ContinuousLinearMapUltrastrong 𝕜 E F ≃+ (E →L[𝕜] F) where
  __ := equiv
  map_add' _ _ := rfl

instance instSMul {S : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F] [ContinuousConstSMul S F] :
    SMul S (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  equiv.smul S

instance instModule {S : Type*} [Semiring S] [Module S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] : Module S (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  addEquiv.module S

instance instIsScalarTower {S T : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] [DistribSMul T F] [SMulCommClass 𝕜 T F] [ContinuousConstSMul T F]
    [SMul S T] [IsScalarTower S T F] : IsScalarTower S T (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  equiv.isScalarTower S T

instance instRing : Ring (ContinuousLinearMapUltrastrong 𝕜 E E) :=
  equiv.ring

@[simp] theorem toCLM_zero : (0 : ContinuousLinearMapUltrastrong 𝕜 E F).toCLM = 0 := rfl

@[simp] theorem toCLM_add (A B : ContinuousLinearMapUltrastrong 𝕜 E F) :
    (A + B).toCLM = A.toCLM + B.toCLM := rfl

@[simp] theorem toCLM_neg (A : ContinuousLinearMapUltrastrong 𝕜 E F) : (-A).toCLM = -A.toCLM :=
  rfl

@[simp] theorem toCLM_sub (A B : ContinuousLinearMapUltrastrong 𝕜 E F) :
    (A - B).toCLM = A.toCLM - B.toCLM := rfl

@[simp] theorem toCLM_smul {S : Type*} [DistribSMul S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] (c : S) (A : ContinuousLinearMapUltrastrong 𝕜 E F) :
    (c • A).toCLM = c • A.toCLM := rfl

@[simp] theorem toCLM_one : (1 : ContinuousLinearMapUltrastrong 𝕜 E E).toCLM = 1 := rfl

@[simp] theorem toCLM_mul (A B : ContinuousLinearMapUltrastrong 𝕜 E E) :
    (A * B).toCLM = A.toCLM * B.toCLM := rfl

/-- The linear equivalence between the ultrastrong copy and `E →L[𝕜] F`. -/
@[simps!]
def linearEquiv (S : Type*) [Semiring S] [Module S F] [SMulCommClass 𝕜 S F]
    [ContinuousConstSMul S F] : ContinuousLinearMapUltrastrong 𝕜 E F ≃ₗ[S] (E →L[𝕜] F) :=
  (addEquiv (𝕜 := 𝕜) (E := E) (F := F)).linearEquiv S

end Algebra

/-! ### The topology -/

section Topology

variable (𝕜 E F) in
/-- The linear map inducing the ultrastrong topology: an operator `A` is sent to the function
`ξ ↦ (⊕ₙ A) ξ` from `ℓ²(ℕ, E)` to `ℓ²(ℕ, F)`. -/
noncomputable def inducingFn :
    ContinuousLinearMapUltrastrong 𝕜 E F →ₗ[𝕜] (ℓ²(ℕ, E) → ℓ²(ℕ, F)) where
  toFun A ξ := lp.ampliation ℕ 2 A.toCLM ξ
  map_add' A B := by ext ξ : 1; simp
  map_smul' c A := by ext ξ : 1; simp

@[simp]
theorem inducingFn_apply (A : ContinuousLinearMapUltrastrong 𝕜 E F) (ξ : ℓ²(ℕ, E)) :
    inducingFn 𝕜 E F A ξ = lp.ampliation ℕ 2 A.toCLM ξ :=
  rfl

/-- The ultrastrong topology is the coarsest topology for which `A ↦ (⊕ₙ A) ξ` is continuous
for every `ξ ∈ ℓ²(ℕ, E)`. -/
noncomputable instance instTopologicalSpace :
    TopologicalSpace (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  .induced (inducingFn 𝕜 E F) Pi.topologicalSpace

theorem isInducing_inducingFn : IsInducing (inducingFn 𝕜 E F) := ⟨rfl⟩

theorem isEmbedding_inducingFn : IsEmbedding (inducingFn 𝕜 E F) := by
  classical
  refine Function.Injective.isEmbedding_induced fun A B hAB ↦ ?_
  ext x
  simpa using congr($hAB (lp.single 2 0 x) 0)

@[fun_prop]
theorem continuous_ampliation_apply (ξ : ℓ²(ℕ, E)) :
    Continuous fun A : ContinuousLinearMapUltrastrong 𝕜 E F ↦ lp.ampliation ℕ 2 A.toCLM ξ :=
  (continuous_apply ξ).comp continuous_induced_dom

theorem continuous_of_continuous_ampliation_apply {α : Type*} [TopologicalSpace α]
    {g : α → ContinuousLinearMapUltrastrong 𝕜 E F}
    (h : ∀ ξ : ℓ²(ℕ, E), Continuous fun a ↦ lp.ampliation ℕ 2 (g a).toCLM ξ) : Continuous g :=
  continuous_induced_rng.2 (continuous_pi h)

/-- A net converges ultrastrongly exactly when its ampliations converge at every vector of
`ℓ²(ℕ, E)`. -/
theorem tendsto_iff_forall_ampliation_apply_tendsto {α : Type*} {l : Filter α}
    {f : α → ContinuousLinearMapUltrastrong 𝕜 E F} {A : ContinuousLinearMapUltrastrong 𝕜 E F} :
    Tendsto f l (𝓝 A) ↔ ∀ ξ : ℓ²(ℕ, E),
      Tendsto (fun a ↦ lp.ampliation ℕ 2 (f a).toCLM ξ) l (𝓝 (lp.ampliation ℕ 2 A.toCLM ξ)) := by
  simp [isInducing_inducingFn.tendsto_nhds_iff, tendsto_pi_nhds]

/-- **The ultrastrong seminorm criterion.** A net `Tᵢ` converges ultrastrongly to `T` exactly when
`∑ₙ ‖Tᵢ ξₙ - T ξₙ‖² → 0` for every square-summable sequence `ξ`. -/
theorem tendsto_iff_forall_tsum_norm_sub_sq_tendsto_zero {α : Type*} {l : Filter α}
    {f : α → ContinuousLinearMapUltrastrong 𝕜 E F} {A : ContinuousLinearMapUltrastrong 𝕜 E F} :
    Tendsto f l (𝓝 A) ↔ ∀ ξ : ℓ²(ℕ, E),
      Tendsto (fun a ↦ ∑' n, ‖(f a).toCLM (ξ n) - A.toCLM (ξ n)‖ ^ 2) l (𝓝 0) := by
  have hsq (v : ℓ²(ℕ, F)) : ‖v‖ ^ 2 = ∑' n, ‖v n‖ ^ 2 := by
    simpa using lp.norm_rpow_eq_tsum (p := 2) (by simp) v
  rw [tendsto_iff_forall_ampliation_apply_tendsto]
  refine forall_congr' fun ξ ↦ ?_
  have key (a : α) : ∑' n, ‖(f a).toCLM (ξ n) - A.toCLM (ξ n)‖ ^ 2 =
      ‖lp.ampliation ℕ 2 (f a).toCLM ξ - lp.ampliation ℕ 2 A.toCLM ξ‖ ^ 2 := by
    rw [hsq]
    simp
  simp_rw [key]
  rw [tendsto_iff_norm_sub_tendsto_zero]
  -- A nonnegative function tends to zero exactly when its square does.
  refine ⟨fun h ↦ by simpa using h.pow 2, fun h ↦ ?_⟩
  simpa [Real.sqrt_sq, norm_nonneg] using h.sqrt

instance instT3Space : T3Space (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  isEmbedding_inducingFn.t3Space

instance instIsTopologicalAddGroup : IsTopologicalAddGroup (ContinuousLinearMapUltrastrong 𝕜 E F)
    where
  toContinuousAdd := .induced (inducingFn 𝕜 E F)
  toContinuousNeg := .induced (inducingFn 𝕜 E F)

instance instContinuousSMul : ContinuousSMul 𝕜 (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  .induced (inducingFn 𝕜 E F)

noncomputable instance instUniformSpace : UniformSpace (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  .comap (inducingFn 𝕜 E F) inferInstance

instance instIsUniformAddGroup : IsUniformAddGroup (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  .comap (inducingFn 𝕜 E F)

end Topology

/-! ### The ultrastrong seminorms -/

section Seminorms

/-- The ultrastrong seminorm `A ↦ ‖(⊕ₙ A) ξ‖ = (∑ₙ ‖A ξₙ‖²)^(1/2)` attached to `ξ ∈ ℓ²(ℕ, E)`. -/
noncomputable def seminorm (ξ : ℓ²(ℕ, E)) : Seminorm 𝕜 (ContinuousLinearMapUltrastrong 𝕜 E F) where
  toFun A := ‖lp.ampliation ℕ 2 A.toCLM ξ‖
  map_zero' := by simp
  add_le' A B := by simpa using norm_add_le _ _
  neg' A := by simp
  smul' r A := by simp [norm_smul]

@[simp]
theorem seminorm_apply (ξ : ℓ²(ℕ, E)) (A : ContinuousLinearMapUltrastrong 𝕜 E F) :
    seminorm ξ A = ‖lp.ampliation ℕ 2 A.toCLM ξ‖ :=
  rfl

variable (𝕜 E F) in
/-- The family of seminorms inducing the ultrastrong topology. -/
noncomputable def seminormFamily :
    SeminormFamily 𝕜 (ContinuousLinearMapUltrastrong 𝕜 E F) ℓ²(ℕ, E) :=
  seminorm

@[simp]
theorem seminormFamily_apply (ξ : ℓ²(ℕ, E)) : seminormFamily 𝕜 E F ξ = seminorm ξ :=
  rfl

theorem withSeminorms : WithSeminorms (seminormFamily 𝕜 E F) :=
  let e : ℓ²(ℕ, E) ≃ (Σ _ : ℓ²(ℕ, E), Unit) := .symm <| .sigmaUnique _ _
  isInducing_inducingFn.withSeminorms
    (withSeminorms_pi fun _ ↦ norm_withSeminorms 𝕜 ℓ²(ℕ, F)) |>.congr_equiv e

instance instLocallyConvexSpace [NormedSpace ℝ 𝕜] [Module ℝ (ContinuousLinearMapUltrastrong 𝕜 E F)]
    [IsScalarTower ℝ 𝕜 (ContinuousLinearMapUltrastrong 𝕜 E F)] :
    LocallyConvexSpace ℝ (ContinuousLinearMapUltrastrong 𝕜 E F) :=
  withSeminorms.toLocallyConvexSpace

end Seminorms

/-! ### Separate continuity of multiplication -/

instance instIsSemitopologicalRing : IsSemitopologicalRing (ContinuousLinearMapUltrastrong 𝕜 E E)
    where
  continuous_const_mul {A} := continuous_of_continuous_ampliation_apply fun ξ ↦ by
    simpa [Function.comp_def] using
      (lp.ampliation ℕ 2 A.toCLM).continuous.comp (continuous_ampliation_apply ξ)
  continuous_mul_const {A} := continuous_of_continuous_ampliation_apply fun ξ ↦ by
    simpa using continuous_ampliation_apply (lp.ampliation ℕ 2 A.toCLM ξ)

/-! ### Comparison with the norm and strong operator topologies -/

section Comparison

/-- The ultrastrong topology is coarser than the norm topology. -/
@[fun_prop]
theorem continuous_ofCLM :
    Continuous (ofCLM : (E →L[𝕜] F) → ContinuousLinearMapUltrastrong 𝕜 E F) :=
  continuous_of_continuous_ampliation_apply fun ξ ↦
    (continuous_eval_const ξ).comp (lp.ampliation ℕ 2).continuous

/-- The ultrastrong topology is finer than the strong operator topology. -/
@[fun_prop]
theorem continuous_toPointwiseConvergenceCLM :
    Continuous fun A : ContinuousLinearMapUltrastrong 𝕜 E F ↦
      ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E F A.toCLM := by
  classical
  have h (x : E) : Continuous fun A : ContinuousLinearMapUltrastrong 𝕜 E F ↦ A.toCLM x := by
    refine ((lp.evalCLM 𝕜 (fun _ : ℕ ↦ F) 2 0).continuous.comp
      (continuous_ampliation_apply (𝕜 := 𝕜) (F := F) (lp.single 2 0 x))).congr fun A ↦ ?_
    simp
  -- Evaluation of `toPointwiseConvergenceCLM … T` is definitionally evaluation of `T`.
  exact PointwiseConvergenceCLM.continuous_of_continuous_eval h

/-- **Bounded-set agreement with the strong operator topology.** For a net of operators that is
eventually bounded in norm, ultrastrong convergence is equivalent to strong convergence. -/
theorem tendsto_iff_tendsto_toPointwiseConvergenceCLM_of_eventually_norm_le {α : Type*}
    {l : Filter α} {f : α → ContinuousLinearMapUltrastrong 𝕜 E F}
    {A : ContinuousLinearMapUltrastrong 𝕜 E F} {C : ℝ} (hC : ∀ᶠ a in l, ‖(f a).toCLM‖ ≤ C) :
    Tendsto f l (𝓝 A) ↔
      Tendsto (fun a ↦ ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E F
        (f a).toCLM) l (𝓝 (ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E F
          A.toCLM)) := by
  classical
  refine ⟨fun h ↦ (continuous_toPointwiseConvergenceCLM.tendsto A).comp h, fun h ↦ ?_⟩
  rw [PointwiseConvergenceCLM.tendsto_iff_forall_tendsto] at h
  -- Evaluation of `toPointwiseConvergenceCLM … T` is definitionally evaluation of `T`.
  replace h : ∀ x, Tendsto (fun a ↦ (f a).toCLM x) l (𝓝 (A.toCLM x)) := h
  rw [tendsto_iff_forall_ampliation_apply_tendsto]
  refine lp.tendsto_apply_of_tendsto_apply_single ENNReal.ofNat_ne_top
    (hC.mono fun a ha ↦ (lp.norm_ampliation_le _).trans ha) fun n x ↦ ?_
  simpa [Function.comp_def] using
    ((lp.singleContinuousLinearMap 𝕜 (fun _ : ℕ ↦ F) 2 n).continuous.tendsto _).comp (h x)

/-- **Bounded-set agreement with the strong operator topology.** On a norm-bounded set of
operators, the ultrastrong topology is the subspace topology of the strong operator topology. -/
theorem isInducing_restrict_toPointwiseConvergenceCLM
    {s : Set (ContinuousLinearMapUltrastrong 𝕜 E F)} {C : ℝ} (hs : ∀ A ∈ s, ‖A.toCLM‖ ≤ C) :
    IsInducing (s.domRestrict fun A : ContinuousLinearMapUltrastrong 𝕜 E F ↦
      ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) E F A.toCLM) := by
  refine isInducing_iff_nhds.2 fun A ↦ le_antisymm
    ((continuous_toPointwiseConvergenceCLM.comp continuous_subtype_val).tendsto A).le_comap ?_
  rw [nhds_subtype, ← tendsto_iff_comap]
  exact (tendsto_iff_tendsto_toPointwiseConvergenceCLM_of_eventually_norm_le
    (Eventually.of_forall fun B : s ↦ hs B B.2)).2 tendsto_comap

end Comparison

end ContinuousLinearMapUltrastrong

end TauCeti
