module

public import Mathlib.Analysis.Calculus.FDeriv.Analytic
public import TauCeti.Analysis.Analytic.IntervalIntegral
import Mathlib.Analysis.Calculus.Deriv.Add
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus

/-!
# Hadamard's lemma for analytic functions

A function `f` analytic at `c` can be written near `c` as `f z - f c = G z (z - c)`, where
`G z = ∫ t in 0..1, fderiv 𝕜 f (c + t • (z - c))` is the average of the derivative of `f` along
the segment from `c` to `z`. The averaged derivative `G` is again analytic at `c`, by
`AnalyticAt.intervalIntegral_comp`, and `G c` is the derivative of `f` at `c`
(`AnalyticAt.exists_analyticAt_eventually_sub_eq`).

In finite dimensions, expanding `z - c` in a basis turns this into the statement that `f - f c`
lies in the ideal of analytic germs at `c` generated by the affine coordinates vanishing at `c`.
This is the analytic counterpart of the smooth factorization `ContDiff.sub_eq_hadamardFactor_apply`
in `TauCeti.Analysis.Calculus.Hadamard`.
-/

public section

open Filter Set
open scoped Topology

variable {𝕜 E F : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  [NormedAddCommGroup F] [NormedSpace 𝕜 F] [CompleteSpace F]

/-- **Hadamard's lemma** for analytic functions: a function `f` analytic at `c` satisfies
`f z - f c = G z (z - c)` near `c` for a map `G` into continuous linear maps which is analytic
at `c`, with `G c = fderiv 𝕜 f c`. -/
theorem AnalyticAt.exists_analyticAt_eventually_sub_eq {f : E → F} {c : E}
    (hf : AnalyticAt 𝕜 f c) :
    ∃ G : E → E →L[𝕜] F, AnalyticAt 𝕜 G c ∧ G c = fderiv 𝕜 f c ∧
      ∀ᶠ z in 𝓝 c, f z - f c = G z (z - c) := by
  let : NormedSpace ℝ F := .restrictScalars ℝ 𝕜 F
  have : IsScalarTower ℝ 𝕜 F := .restrictScalars ℝ 𝕜 F
  -- `L t` is the homothety of ratio `t`, so `G` is the average of `fderiv 𝕜 f` along segments.
  set L : ℝ → E →L[𝕜] E := fun t ↦ (t : 𝕜) • ContinuousLinearMap.id 𝕜 E with hL
  have hLapply (t : ℝ) (v : E) : L t v = (t : 𝕜) • v := by simp [hL]
  have hLc : Continuous L := by
    rw [hL]
    fun_prop
  -- For `t ∈ [0, 1]`, scaling by `t` does not increase norms.
  have hsmul (t : ℝ) (ht : t ∈ Icc (0 : ℝ) 1) (v : E) : ‖(t : 𝕜) • v‖ ≤ ‖v‖ := by
    simpa [norm_smul, abs_of_nonneg ht.1] using mul_le_of_le_one_left (norm_nonneg v) ht.2
  have hL1 : ∀ t ∈ Icc (0 : ℝ) 1, ‖L t‖ ≤ 1 := fun t ht ↦
    (L t).opNorm_le_bound zero_le_one fun w ↦ by simpa [hLapply] using hsmul t ht w
  refine ⟨fun z ↦ ∫ t in (0 : ℝ)..1, fderiv 𝕜 f (c + L t (z - c)),
    hf.fderiv.intervalIntegral_comp hLc.continuousOn hL1, by simp [hLapply], ?_⟩
  -- On a ball about `c` where `f` is analytic, apply the fundamental theorem of calculus to
  -- `s ↦ f (c + s • (z - c))` on the unit interval.
  obtain ⟨ρ, hρ, hball⟩ := Metric.eventually_nhds_iff_ball.1 hf.eventually_analyticAt
  filter_upwards [Metric.ball_mem_nhds c hρ] with z hz
  have hmem (t : ℝ) (ht : t ∈ Icc (0 : ℝ) 1) : c + (t : 𝕜) • (z - c) ∈ Metric.ball c ρ := by
    rw [Metric.mem_ball, dist_eq_norm] at hz ⊢
    simpa using (hsmul t ht (z - c)).trans_lt hz
  have hcont : ContinuousOn (fun t : ℝ ↦ fderiv 𝕜 f (c + (t : 𝕜) • (z - c))) (Icc 0 1) :=
    fun t ht ↦ ((hball _ (hmem t ht)).fderiv.continuousAt.comp
      (f := fun t : ℝ ↦ c + (t : 𝕜) • (z - c)) (by fun_prop)).continuousWithinAt
  simp only [hLapply]
  rw [ContinuousLinearMap.intervalIntegral_apply (hcont.intervalIntegrable_of_Icc zero_le_one)]
  have hderiv : ∀ t ∈ Icc (0 : ℝ) 1, HasDerivAt (fun s : 𝕜 ↦ f (c + s • (z - c)))
      (fderiv 𝕜 f (c + (0 + t • (1 : 𝕜)) • (z - c)) (z - c)) (0 + t • (1 : 𝕜)) := by
    intro t ht
    rw [show (0 + t • (1 : 𝕜)) = (t : 𝕜) by simp [RCLike.real_smul_eq_coe_mul]]
    simpa [Function.comp_def] using
      (hball _ (hmem t ht)).differentiableAt.hasFDerivAt.comp_hasDerivAt (t : 𝕜)
        ((HasDerivAt.smul_const (hasDerivAt_id (t : 𝕜)) (z - c)).const_add c)
  have hFTC := intervalIntegral.integral_unitInterval_deriv_eq_sub
    (f := fun s : 𝕜 ↦ f (c + s • (z - c)))
    (f' := fun s ↦ fderiv 𝕜 f (c + s • (z - c)) (z - c)) (z₀ := 0) (z₁ := 1)
    (by simpa [RCLike.real_smul_eq_coe_mul] using
      hcont.clm_apply (continuousOn_const (c := z - c))) hderiv
  simpa [RCLike.real_smul_eq_coe_mul] using hFTC.symm
