/-!
# Semigroups with opposite generators are mutually inverse

Two C₀-semigroups whose generators are negatives of one another have mutually inverse operators
at equal nonnegative times.  The proof differentiates the product orbit `t ↦ S t (T t x)` on the
dense generator domain of `T`, where the derivative vanishes because the generators cancel, and
then extends the resulting identity by continuity.  No group structure is assumed.

These inverse identities are exactly the hypotheses of the gluing construction
`TauCeti.Semigroups.StronglyContinuousSemigroup.toGroupOfInverse`, so together they produce the
C₀-group generated by an operator whose positive and negative multiples both generate
semigroups; Stone's theorem uses this with the contraction semigroups generated by `iH` and
`-iH`.

## Main results

* `TauCeti.Semigroups.StronglyContinuousSemigroup.apply_apply_eq_of_generator_eq_neg` and
  `TauCeti.Semigroups.StronglyContinuousSemigroup.apply_apply_eq_of_generator_eq_neg_rev`: the
  equal-time operators of `S` and `T` are two-sided inverses.
* `TauCeti.Semigroups.StronglyContinuousSemigroup.comp_eq_id_of_generator_eq_neg` and
  `TauCeti.Semigroups.StronglyContinuousSemigroup.comp_eq_id_of_generator_eq_neg_rev`: the same
  identities as operator equations.

## References

Engel--Nagel, *One-Parameter Semigroups for Linear Evolution Equations*, Section II.3.11;
Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*,
Section 1.6.
-/

public section

noncomputable section

open scoped NNReal Topology

namespace TauCeti.Semigroups

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

namespace StronglyContinuousSemigroup

open Filter Set

omit [CompleteSpace X] in
private theorem tendsto_generator_diff_quotient {T : StronglyContinuousSemigroup X} {y a : X}
    (hy : y ∈ T.generator.domain) (hTa : T.generator ⟨y, hy⟩ = a) (s : ℝ) :
    Tendsto (fun u : ℝ => (u - s)⁻¹ • (T.realOperator (u - s) y - y)) (𝓝[>] s) (𝓝 a) := by
  have hyT : y ∈ T.domain := by rwa [T.generator_domain] at hy
  have hshift : Tendsto (fun u : ℝ => u - s) (𝓝[>] s) (𝓝[>] 0) := by
    rw [tendsto_nhdsWithin_iff]
    refine ⟨?_, ?_⟩
    · have h : Tendsto (fun u : ℝ => u - s) (𝓝 s) (𝓝 (s - s)) :=
        (continuous_id.sub continuous_const).tendsto s
      simpa using h.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with u hu
      exact Set.mem_Ioi.mpr (sub_pos.mpr (Set.mem_Ioi.mp hu))
  simpa [Function.comp_def, one_div, hTa] using (T.generator_tendsto ⟨y, hyT⟩).comp hshift

omit [CompleteSpace X] in
private theorem slope_productOrbit_eq {S T : StronglyContinuousSemigroup X} {x : X}
    {s u : ℝ} (hs : 0 ≤ s) (hu : s ≤ u) :
    slope (fun v : ℝ => S.realOperator v (T.realOperator v x)) s u =
      S.realOperator u
          ((u - s)⁻¹ • (T.realOperator (u - s) (T.realOperator s x) - T.realOperator s x))
        + slope (fun v : ℝ => S.realOperator v (T.realOperator s x)) s u := by
  have hus : 0 ≤ u - s := sub_nonneg.mpr hu
  have hTu : T.realOperator u x = T.realOperator (u - s) (T.realOperator s x) := by
    rw [← ContinuousLinearMap.comp_apply, ← T.realOperator_add (u - s) s hus hs, sub_add_cancel]
  simp only [slope_def_module, hTu, map_smul, map_sub, smul_sub]
  abel

omit [CompleteSpace X] in
private theorem tendsto_slope_realOperator (S : StronglyContinuousSemigroup X) (x : S.domain)
    {s : ℝ} (hs : 0 ≤ s) :
    Tendsto (slope (fun u : ℝ => S.realOperator u (x : X)) s) (𝓝[>] s)
      (𝓝 (S.realOperator s (S.generator ⟨x, by
        rw [S.generator_domain]
        exact x.property⟩))) := by
  have hderiv := S.realOperator_hasDerivWithinAt_map_generator x hs
  rw [hasDerivWithinAt_iff_tendsto_slope, Set.Ici_sdiff_left] at hderiv
  exact hderiv

private theorem hasDerivWithinAt_productOrbit_of_tendsto
    {S T : StronglyContinuousSemigroup X} {x y a : X} {s : ℝ} (hs : 0 ≤ s)
    (hy : T.realOperator s x = y)
    (hquot : Tendsto (fun u : ℝ =>
      (u - s)⁻¹ • (T.realOperator (u - s) y - y)) (𝓝[>] s) (𝓝 (-a)))
    (hslope : Tendsto (slope (fun u : ℝ => S.realOperator u y) s)
      (𝓝[>] s) (𝓝 (S.realOperator s a))) :
    HasDerivWithinAt (fun u : ℝ => S.realOperator u (T.realOperator u x)) 0 (Set.Ici s) s := by
  have htime : Tendsto (fun u : ℝ => u) (𝓝[>] s) (𝓝 s) :=
    tendsto_id.mono_left nhdsWithin_le_nhds
  have hterm1 : Tendsto (fun u : ℝ => S.realOperator u
      ((u - s)⁻¹ • (T.realOperator (u - s) y - y)))
      (𝓝[>] s) (𝓝 (S.realOperator s (-a))) :=
    S.tendsto_realOperator_apply htime
      (eventually_nhdsWithin_of_forall fun u hu => hs.trans hu.le) hs hquot
  rw [hasDerivWithinAt_iff_tendsto_slope, Set.Ici_sdiff_left]
  have hsum := hterm1.add hslope
  simp only [map_neg, neg_add_cancel] at hsum
  exact hsum.congr' (by
    filter_upwards [self_mem_nhdsWithin] with u hu
    simpa only [hy] using
      (slope_productOrbit_eq (S := S) (T := T) (x := x) hs hu.le).symm)

private theorem hasDerivWithinAt_productOrbit {S T : StronglyContinuousSemigroup X}
    (hgen : T.generator = -S.generator) {x : X} (hx : x ∈ T.domain) {s : ℝ}
    (hs : 0 ≤ s) :
    HasDerivWithinAt (fun u : ℝ => S.realOperator u (T.realOperator u x)) 0 (Set.Ici s) s := by
  have hdom : T.domain = S.domain := by
    calc
      T.domain = T.generator.domain := T.generator_domain.symm
      _ = (-S.generator).domain := congrArg LinearPMap.domain hgen
      _ = S.generator.domain := by rw [LinearPMap.neg_domain]
      _ = S.domain := S.generator_domain
  set y : X := T.realOperator s x with hy
  have hyT : y ∈ T.domain := T.realOperator_mem_domain hs hx
  have hyS : y ∈ S.domain := hdom ▸ hyT
  have hyT' : y ∈ T.generator.domain := by rw [T.generator_domain]; exact hyT
  have hyS' : y ∈ S.generator.domain := by rw [S.generator_domain]; exact hyS
  have hyNegS : y ∈ (-S.generator).domain := by
    rw [LinearPMap.neg_domain]
    exact hyS'
  set a : X := S.generator ⟨y, hyS'⟩
  have hTa : T.generator ⟨y, hyT'⟩ = -a := by
    have h := @(LinearPMap.ext_iff.mp hgen).2 y hyT' hyNegS
    simpa only [LinearPMap.neg_apply, a] using h
  have hquot : Tendsto
      (fun u : ℝ => (u - s)⁻¹ • (T.realOperator (u - s) y - y))
      (𝓝[>] s) (𝓝 (-a)) := tendsto_generator_diff_quotient hyT' hTa s
  have hslope : Tendsto (slope (fun u : ℝ => S.realOperator u y) s)
      (𝓝[>] s) (𝓝 (S.realOperator s a)) := by
    simpa only [a] using tendsto_slope_realOperator S ⟨y, hyS⟩ hs
  exact hasDerivWithinAt_productOrbit_of_tendsto hs hy hquot hslope

private theorem realOperator_apply_apply_eq_of_generator_eq_neg_of_mem_domain
    {S T : StronglyContinuousSemigroup X} (hgen : T.generator = -S.generator)
    {t : ℝ} (ht : 0 ≤ t) {x : X} (hx : x ∈ T.domain) :
    S.realOperator t (T.realOperator t x) = x := by
  have hcont : ContinuousOn (fun u : ℝ => S.realOperator u (T.realOperator u x))
      (Set.Icc 0 t) :=
    S.continuousOn_realOperator_apply continuous_id.continuousOn
      (fun u hu => hu.1) ((T.realOperator_continuousOn_Ici x).mono fun u hu => hu.1)
  have hderiv : ∀ u ∈ Set.Ico (0 : ℝ) t,
      HasDerivWithinAt (fun v : ℝ => S.realOperator v (T.realOperator v x)) 0
        (Set.Ici u) u :=
    fun _ hu => hasDerivWithinAt_productOrbit hgen hx hu.1
  have heq := constant_of_has_deriv_right_zero hcont hderiv t (Set.right_mem_Icc.mpr ht)
  simpa only [S.realOperator_zero_apply, T.realOperator_zero_apply] using heq

/-- Equal-time operators of semigroups with opposite generators are left inverses. -/
theorem apply_apply_eq_of_generator_eq_neg {S T : StronglyContinuousSemigroup X}
    (hgen : T.generator = -S.generator) (t : ℝ≥0) (x : X) :
    S t (T t x) = x := by
  have hop : (S t).comp (T t) = ContinuousLinearMap.id ℝ X := by
    refine ContinuousLinearMap.ext_on (R₁ := ℝ) (s := (T.domain : Set X)) ?_ ?_
    · rw [Submodule.span_eq]
      exact T.dense_domain
    · intro y hy
      simpa only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply,
        S.realOperator_coe, T.realOperator_coe] using
        realOperator_apply_apply_eq_of_generator_eq_neg_of_mem_domain hgen t.coe_nonneg hy
  exact DFunLike.congr_fun hop x

/-- Equal-time operators of semigroups with opposite generators are right inverses. -/
theorem apply_apply_eq_of_generator_eq_neg_rev {S T : StronglyContinuousSemigroup X}
    (hgen : T.generator = -S.generator) (t : ℝ≥0) (x : X) :
    T t (S t x) = x := by
  apply apply_apply_eq_of_generator_eq_neg (S := T) (T := S) (t := t) (x := x)
  rw [hgen, neg_neg]

/-- Equal-time operators of semigroups with opposite generators compose to the identity. -/
theorem comp_eq_id_of_generator_eq_neg {S T : StronglyContinuousSemigroup X}
    (hgen : T.generator = -S.generator) (t : ℝ≥0) :
    (S t).comp (T t) = ContinuousLinearMap.id ℝ X :=
  ContinuousLinearMap.ext fun x => apply_apply_eq_of_generator_eq_neg hgen t x

/-- Equal-time operators of semigroups with opposite generators compose to the identity, in the
other order. -/
theorem comp_eq_id_of_generator_eq_neg_rev {S T : StronglyContinuousSemigroup X}
    (hgen : T.generator = -S.generator) (t : ℝ≥0) :
    (T t).comp (S t) = ContinuousLinearMap.id ℝ X :=
  ContinuousLinearMap.ext fun x => apply_apply_eq_of_generator_eq_neg_rev hgen t x

end StronglyContinuousSemigroup

end TauCeti.Semigroups

end
