module

public import TauCeti.Analysis.InnerProductSpace.Variational.Spectrum
public import TauCeti.Analysis.Semigroups.Generation.LumerPhillips
import TauCeti.Analysis.Semigroups.CauchyProblem.Uniqueness
import TauCeti.Analysis.Semigroups.Dissipative.Hilbert
import TauCeti.LinearAlgebra.LinearPMap.Basic

/-!
# Contraction semigroups generated by coercive forms

Let `B` be a bounded coercive bilinear form on a real Hilbert space `V`, and let `J : V →L[ℝ] H`
be a continuous linear map with dense range into a real Hilbert space `H`, such as the inclusion
`H¹₀(Ω) → L²(Ω)`. The **operator associated with the form** is the unbounded operator `𝒜` on `H`
whose graph consists of the pairs `(J u, h)` with

`B u v = ⟪h, J v⟫` for every `v : V`.

For the energy form of a divergence-form operator `L` this is `L` with its Dirichlet boundary
condition, acting on the weak solutions `u ∈ H¹₀(Ω)` of `L u = h` with `h ∈ L²(Ω)`. Its domain is
the range of the solution operator `S = IsCoercive.formSolutionOperator`, and `𝒜` is the inverse
of `S`; dense range of `J` makes `S` injective.

This file shows that `-𝒜` generates a strongly continuous contraction semigroup on `H`
(`IsCoercive.formSemigroup`, with generator `IsCoercive.formGenerator`), the semigroup
`e^{-t𝒜}` that solves the abstract parabolic problem `u' + 𝒜 u = 0`. Neither symmetry of `B` nor
compactness of `J` is needed. By the Lumer–Phillips theorem it suffices to check that
`-𝒜 = -S⁻¹` is densely defined and m-dissipative:

* **Dissipativity.** For `x = S h`, `⟪-𝒜 x, x⟫ = -⟪h, S h⟫ = -B u u ≤ 0`, where `u` solves the
  variational equation for `h`.
* **The range condition.** `x - (-𝒜) x = S h + h`, and `I + S` is invertible because
  `⟪(I + S) h, h⟫ ≥ ‖h‖²`.
* **Density of the domain.** If `g` is orthogonal to the range of `S`, then
  `B u u = ⟪g, S g⟫ = 0` for the solution `u` of the equation for `g`, so `u = 0`, hence `g` is
  orthogonal to the range of `J`, and `g = 0`.

A vector `J u` with `B u v = κ ⟪J u, J v⟫` for every `v` is an eigenvector of the generator for
the eigenvalue `-κ`, so the semigroup multiplies it by `exp (-κ t)`
(`IsCoercive.formSemigroup_apply_of_forall_apply_eq_smul_inner`). Along an orthonormal basis of
such eigenvectors the semigroup is therefore the diagonal operator
`f ↦ ∑ᵢ exp (-κᵢ t) ⟪eᵢ, f⟫ eᵢ` (`IsCoercive.hasSum_formSemigroup_apply`).

## Main declarations

* `IsCoercive.formGenerator`: the generator `-S⁻¹`, with domain the range of `S`
  (`IsCoercive.formGenerator_domain`). Its graph is described variationally by
  `IsCoercive.mem_formGenerator_domain_iff` (the domain) and
  `IsCoercive.formGenerator_apply_eq_neg_iff` (the action on the domain), and `S` is its
  resolvent at `0` (`IsCoercive.isResolventAt_formGenerator_zero`).
* `IsCoercive.isMDissipative_formGenerator`, `IsCoercive.dense_formGenerator_domain`: the
  hypotheses of the Lumer–Phillips theorem.
* `IsCoercive.formSemigroup`: the contraction semigroup, with
  `IsCoercive.formSemigroup_generator` and `IsCoercive.formSemigroup_generator_apply`.
* `IsCoercive.formSemigroup_apply_of_forall_apply_eq_smul_inner`,
  `IsCoercive.hasSum_formSemigroup_apply`: the action on eigenvectors and the eigenfunction
  expansion.

## References

* J.-L. Lions, *Équations différentielles opérationnelles et problèmes aux limites*, Springer,
  1961, Chapter III.
* T. Kato, *Perturbation Theory for Linear Operators*, Chapter VI, §2 (the operator associated
  with a form).
* K.-J. Engel and R. Nagel, *One-Parameter Semigroups for Linear Evolution Equations*,
  Theorem II.3.15 (Lumer–Phillips).
-/

public section

noncomputable section

open TauCeti.Semigroups
open scoped InnerProductSpace NNReal

namespace IsCoercive

variable {V H : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] {B : V →L[ℝ] V →L[ℝ] ℝ}

/-! ### The generator -/

/-- The **generator of the semigroup of a coercive form** `B` along `J : V →L[ℝ] H`: the negative
of the operator associated with the form, `-S⁻¹` for the solution operator
`S = hB.formSolutionOperator J`. Its domain consists of the vectors `J u` for solutions `u` of a
variational equation `B u v = ⟪h, J v⟫` (`IsCoercive.mem_formGenerator_domain_iff`), and when `J`
has dense range it sends such a `J u` to `-h` (`IsCoercive.formGenerator_apply_eq_neg_iff`). -/
def formGenerator (hB : IsCoercive B) (J : V →L[ℝ] H) : H →ₗ.[ℝ] H :=
  -((hB.formSolutionOperator J : H →ₗ[ℝ] H).toPMap ⊤).inverse

variable (hB : IsCoercive B) {J : V →L[ℝ] H}

/-- The generator is minus the inverse of the solution operator. -/
theorem formGenerator_def (J : V →L[ℝ] H) :
    hB.formGenerator J = -((hB.formSolutionOperator J : H →ₗ[ℝ] H).toPMap ⊤).inverse :=
  (rfl)

/-- The domain of the generator is the range of the solution operator. -/
theorem formGenerator_domain (J : V →L[ℝ] H) :
    (hB.formGenerator J).domain = LinearMap.range (hB.formSolutionOperator J : H →ₗ[ℝ] H) := by
  rw [formGenerator_def, LinearPMap.neg_domain, LinearPMap.inverse_domain]
  ext x
  simp only [LinearMap.mem_range, LinearPMap.toFun_eq_coe]
  exact ⟨fun ⟨y, hy⟩ => ⟨y, (LinearMap.toPMap_apply _ ⊤ y).symm.trans hy⟩,
    fun ⟨y, hy⟩ => ⟨⟨y, Submodule.mem_top⟩, (LinearMap.toPMap_apply _ ⊤ _).trans hy⟩⟩

/-- The solution operator takes its values in the domain of the generator. -/
theorem formSolutionOperator_mem_formGenerator_domain (h : H) :
    hB.formSolutionOperator J h ∈ (hB.formGenerator J).domain := by
  rw [formGenerator_domain]
  exact LinearMap.mem_range_self _ h

/-- A vector `J u` lies in the domain of the generator as soon as `u` solves a variational
equation `B u v = ⟪h, J v⟫`. -/
theorem apply_mem_formGenerator_domain {u : V} {h : H} (hu : ∀ v, B u v = ⟪h, J v⟫_ℝ) :
    J u ∈ (hB.formGenerator J).domain := by
  rw [hB.eq_formSolutionMap J hu, ← formSolutionOperator_apply]
  exact hB.formSolutionOperator_mem_formGenerator_domain h

/-- **The domain of the generator.** A vector `x` lies in the domain of the generator exactly when
`x = J u` for a solution `u` of some variational equation `B u v = ⟪h, J v⟫`. -/
theorem mem_formGenerator_domain_iff {x : H} :
    x ∈ (hB.formGenerator J).domain ↔ ∃ (u : V) (h : H), J u = x ∧ ∀ v, B u v = ⟪h, J v⟫_ℝ := by
  refine ⟨fun hx => ?_, fun ⟨u, h, hJu, hu⟩ => hJu ▸ hB.apply_mem_formGenerator_domain hu⟩
  rw [formGenerator_domain] at hx
  obtain ⟨h, rfl⟩ := hx
  exact ⟨hB.formSolutionMap J h, h, by simp, hB.apply_formSolutionMap J h⟩

/-- **The generator inverts the solution operator**: it sends `S h` to `-h`. -/
theorem formGenerator_apply_formSolutionOperator (hJ : DenseRange J) (h : H)
    (hx : hB.formSolutionOperator J h ∈ (hB.formGenerator J).domain) :
    hB.formGenerator J ⟨hB.formSolutionOperator J h, hx⟩ = -h := by
  have hxy : ((hB.formSolutionOperator J : H →ₗ[ℝ] H).toPMap ⊤) ⟨h, Submodule.mem_top⟩ =
      hB.formSolutionOperator J h := by
    simp
  have hy : hB.formSolutionOperator J h ∈
      ((hB.formSolutionOperator J : H →ₗ[ℝ] H).toPMap ⊤).inverse.domain := by
    rw [LinearPMap.inverse_domain]
    exact ⟨⟨h, Submodule.mem_top⟩, hxy⟩
  rw [LinearPMap.congr_fun (hB.formGenerator_def J) hx hy, LinearPMap.neg_apply, neg_inj]
  exact LinearPMap.inverse_apply_eq (y := ⟨_, hy⟩)
    (by simp [LinearMap.ker_eq_bot, hB.formSolutionOperator_injective hJ]) hxy

/-- **The action of the generator.** On its domain, the generator sends `x` to `-h` exactly when
`x = J u` for a solution `u` of the variational equation `B u v = ⟪h, J v⟫`. Together with
`IsCoercive.mem_formGenerator_domain_iff` this describes the graph of the generator. -/
theorem formGenerator_apply_eq_neg_iff (hJ : DenseRange J) (x : (hB.formGenerator J).domain)
    (h : H) :
    hB.formGenerator J x = -h ↔ ∃ u : V, J u = x ∧ ∀ v, B u v = ⟪h, J v⟫_ℝ := by
  obtain ⟨x, hx⟩ := x
  obtain ⟨g, hg⟩ := (hB.formGenerator_domain J ▸ hx :
    x ∈ LinearMap.range (hB.formSolutionOperator J : H →ₗ[ℝ] H))
  rw [ContinuousLinearMap.coe_coe] at hg
  subst hg
  rw [hB.formGenerator_apply_formSolutionOperator hJ g hx, neg_inj]
  constructor
  · rintro rfl
    exact ⟨hB.formSolutionMap J g, by simp, hB.apply_formSolutionMap J g⟩
  · rintro ⟨u, hJu, hu⟩
    have hJu' : hB.formSolutionOperator J h = hB.formSolutionOperator J g := by
      simpa [← hB.eq_formSolutionMap J hu] using hJu
    exact (hB.formSolutionOperator_injective hJ hJu').symm

/-- On its domain, the generator sends `x` to `h` exactly when `x = J u` for a solution `u` of
the variational equation `B u v = ⟪-h, J v⟫`. -/
theorem formGenerator_apply_eq_iff (hJ : DenseRange J) (x : (hB.formGenerator J).domain) (h : H) :
    hB.formGenerator J x = h ↔ ∃ u : V, J u = x ∧ ∀ v, B u v = ⟪-h, J v⟫_ℝ := by
  rw [← hB.formGenerator_apply_eq_neg_iff hJ, neg_neg]

/-- The generator sends `J u` to `-h` for a solution `u` of `B u v = ⟪h, J v⟫`. -/
theorem formGenerator_apply_eq_neg (hJ : DenseRange J) {u : V} {h : H}
    (hu : ∀ v, B u v = ⟪h, J v⟫_ℝ) :
    hB.formGenerator J ⟨J u, hB.apply_mem_formGenerator_domain hu⟩ = -h :=
  (hB.formGenerator_apply_eq_neg_iff hJ _ h).2 ⟨u, rfl, hu⟩

/-- Every element of the domain of the generator is `J u` for the solution `u` of the variational
equation whose right-hand side is minus the generator. -/
theorem exists_apply_eq_forall_apply_eq_inner (hJ : DenseRange J)
    (x : (hB.formGenerator J).domain) :
    ∃ u : V, J u = x ∧ ∀ v, B u v = ⟪-hB.formGenerator J x, J v⟫_ℝ :=
  (hB.formGenerator_apply_eq_neg_iff hJ x _).1 (neg_neg _).symm

/-- **The solution operator inverts the generator**: `S (𝒜' x) = -x` on the domain of the
generator `𝒜'`. -/
theorem formSolutionOperator_formGenerator (hJ : DenseRange J)
    (x : (hB.formGenerator J).domain) :
    hB.formSolutionOperator J (hB.formGenerator J x) = -(x : H) := by
  obtain ⟨u, hJu, hu⟩ := hB.exists_apply_eq_forall_apply_eq_inner hJ x
  calc hB.formSolutionOperator J (hB.formGenerator J x)
      = -hB.formSolutionOperator J (-hB.formGenerator J x) := by rw [map_neg, neg_neg]
    _ = -(x : H) := by rw [formSolutionOperator_apply, ← hB.eq_formSolutionMap J hu, hJu]

/-- **The solution operator is the resolvent of the generator at `0`**: it inverts
`0 • I - 𝒜' = -𝒜'` when `J` has dense range. -/
theorem isResolventAt_formGenerator_zero (hJ : DenseRange J) :
    LinearPMap.IsResolventAt (hB.formGenerator J) 0 (hB.formSolutionOperator J) where
  mem_domain := hB.formSolutionOperator_mem_formGenerator_domain
  smul_sub_apply h := by
    rw [zero_smul, zero_sub, hB.formGenerator_apply_formSolutionOperator hJ, neg_neg]
  apply_smul_sub x := by
    rw [zero_smul, zero_sub, map_neg, hB.formSolutionOperator_formGenerator hJ, neg_neg]

/-- The resolvent of the generator at `0` is the solution operator. -/
theorem resolvent_formGenerator_zero (hJ : DenseRange J) :
    (hB.formGenerator J).resolvent 0 = hB.formSolutionOperator J :=
  LinearPMap.resolvent_eq_of_isResolventAt (hB.isResolventAt_formGenerator_zero hJ)

/-! ### The hypotheses of the Lumer–Phillips theorem -/

/-- When `J` has dense range, the generator is dissipative: `⟪𝒜' x, x⟫ ≤ 0` for every `x` in the
domain of the generator `𝒜'`. -/
theorem isDissipative_formGenerator (hJ : DenseRange J) :
    IsDissipative (hB.formGenerator J) := by
  rw [isDissipative_iff_real_inner_nonpos]
  intro x
  obtain ⟨u, hJu, hu⟩ := hB.exists_apply_eq_forall_apply_eq_inner hJ x
  have h := hu u
  rw [hJu, inner_neg_left] at h
  linarith [hB.apply_self_nonneg u]

/-- The range condition of the Lumer–Phillips theorem at `1`: when `J` has dense range,
`x ↦ x - 𝒜' x` maps the domain of the generator `𝒜'` onto `H`. -/
theorem one_smul_sub_formGenerator_surjective [CompleteSpace H] (hJ : DenseRange J) :
    Function.Surjective fun x : (hB.formGenerator J).domain =>
      (1 : ℝ) • (x : H) - hB.formGenerator J x := by
  intro g
  obtain ⟨h, rfl⟩ :=
    (ContinuousLinearMap.isUnit_iff_bijective.1 (hB.isUnit_one_add_formSolutionOperator J)).2 g
  refine ⟨⟨_, hB.formSolutionOperator_mem_formGenerator_domain h⟩, ?_⟩
  simp only [one_smul, hB.formGenerator_apply_formSolutionOperator hJ, sub_neg_eq_add, add_comm,
    add_apply, one_apply_eq_self]

/-- When `J` has dense range, the generator is m-dissipative. -/
theorem isMDissipative_formGenerator [CompleteSpace H] (hJ : DenseRange J) :
    IsMDissipative (hB.formGenerator J) :=
  (hB.isDissipative_formGenerator hJ).isMDissipative one_pos
    (hB.one_smul_sub_formGenerator_surjective hJ)

/-- When `J` has dense range, the domain of the generator is dense in `H`. -/
theorem dense_formGenerator_domain [CompleteSpace H] (hJ : DenseRange J) :
    Dense ((hB.formGenerator J).domain : Set H) := by
  rw [formGenerator_domain, LinearMap.coe_range, ContinuousLinearMap.coe_coe]
  exact hB.denseRange_formSolutionOperator hJ

/-! ### The semigroup -/

/-- The **contraction semigroup of a coercive form** `B` along a map `J : V →L[ℝ] H` of dense
range: the semigroup `e^{-t𝒜}` whose generator is minus the operator associated with the form
(`IsCoercive.formSemigroup_generator`), given by the Lumer–Phillips theorem. -/
def formSemigroup [CompleteSpace H] (hJ : DenseRange J) :
    ContractionSemigroup H :=
  (hB.isMDissipative_formGenerator hJ).yosidaLimitSemigroup (hB.dense_formGenerator_domain hJ)

/-- The generator of the semigroup of a coercive form is minus the associated operator. -/
@[simp]
theorem formSemigroup_generator [CompleteSpace H] (hJ : DenseRange J) :
    (hB.formSemigroup hJ).toStronglyContinuousSemigroup.generator = hB.formGenerator J :=
  (hB.isMDissipative_formGenerator hJ).yosidaLimitSemigroup_generator
    (hB.dense_formGenerator_domain hJ)

/-- The generator of the semigroup of a coercive form agrees with `IsCoercive.formGenerator` at
every point of their common domain. -/
theorem formSemigroup_generator_apply [CompleteSpace H] (hJ : DenseRange J)
    (x : (hB.formSemigroup hJ).toStronglyContinuousSemigroup.generator.domain)
    (hx : (x : H) ∈ (hB.formGenerator J).domain) :
    (hB.formSemigroup hJ).toStronglyContinuousSemigroup.generator x =
      hB.formGenerator J ⟨x, hx⟩ :=
  LinearPMap.congr_fun (hB.formSemigroup_generator hJ) x.2 hx

/-- **The semigroup on an eigenvector.** If `B u v = κ ⟪J u, J v⟫` for every `v`, then the
semigroup multiplies `J u` by `exp (-κ t)`. -/
theorem formSemigroup_apply_of_forall_apply_eq_smul_inner [CompleteSpace H] (hJ : DenseRange J)
    {u : V} {κ : ℝ} (hu : ∀ v, B u v = κ * ⟪J u, J v⟫_ℝ) (t : ℝ≥0) :
    hB.formSemigroup hJ t (J u) = Real.exp (-(κ * t)) • J u := by
  have hu' : ∀ v, B u v = ⟪κ • J u, J v⟫_ℝ := fun v => by rw [hu, real_inner_smul_left]
  set S := (hB.formSemigroup hJ).toStronglyContinuousSemigroup
  have hdom : J u ∈ S.generator.domain := by
    rw [hB.formSemigroup_generator hJ]
    exact hB.apply_mem_formGenerator_domain hu'
  have hgen : S.generator ⟨J u, hdom⟩ = (-κ) • J u := by
    rw [hB.formSemigroup_generator_apply hJ _ (hB.apply_mem_formGenerator_domain hu'),
      hB.formGenerator_apply_eq_neg hJ hu', neg_smul]
  have h := S.apply_eq_exp_smul_of_generator_eq_smul ⟨J u, hdom⟩ hgen t
  rw [neg_mul] at h
  exact h

/-- **The eigenfunction expansion of the semigroup.** Along an orthonormal basis `eᵢ = J uᵢ` of
`H` with `B uᵢ v = κᵢ ⟪eᵢ, J v⟫` for every `v`, the semigroup is the diagonal operator
`e^{-t𝒜} f = ∑ᵢ exp (-κᵢ t) ⟪eᵢ, f⟫ eᵢ`. -/
theorem hasSum_formSemigroup_apply [CompleteSpace H] (hJ : DenseRange J) {ι : Type*}
    (e : HilbertBasis ι ℝ H) {κ : ι → ℝ} {u : ι → V} (hue : ∀ i, J (u i) = e i)
    (hu : ∀ i v, B (u i) v = κ i * ⟪J (u i), J v⟫_ℝ) (t : ℝ≥0) (f : H) :
    HasSum (fun i => Real.exp (-(κ i * t)) • e.repr f i • e i) (hB.formSemigroup hJ t f) :=
  (hB.formSemigroup hJ t).hasSum_smul_repr_of_apply_eq_smul e _ (fun i => by
    rw [← hue i, hB.formSemigroup_apply_of_forall_apply_eq_smul_inner hJ (hu i) t]) f

end IsCoercive
