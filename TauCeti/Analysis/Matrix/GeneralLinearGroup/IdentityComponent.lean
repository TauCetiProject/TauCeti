public import TauCeti.Analysis.Normed.Algebra.Exponential.IdentityComponent
import TauCeti.Analysis.Matrix.Normed

/-!
# The identity component of the general linear group over a Banach algebra

Let `A` be a real Banach algebra, for instance a complex one, possibly noncommutative, and let
`GL n A` be the invertible `n × n` matrices over `A` with the entrywise topology. The matrix
algebra `Matrix n n A` is again a Banach algebra for the `L∞` operator norm, whose topology is the
entrywise one, so the description of the identity component of the unit group of a Banach algebra
applies to `GL n A`:

* `GL n A` is locally path connected, so the identity component `GLₙ(A)₀` is the path component
  of `1` (`pathComponent_eq_connectedComponent`);
* `GLₙ(A)₀` is generated by the invertible matrices `g` with `‖g - 1‖ < 1` for the `L∞` operator
  norm of `Matrix.Norms.Operator`;
* `GLₙ(A)₀` consists of the finite products of exponentials of matrices;
* a surjective continuous ring homomorphism `f : A →+* B` of real Banach algebras, applied to
  the entries, maps `GLₙ(A)₀` onto `GLₙ(B)₀`.

The last statement is the lifting property of identity components along surjections used to
compare algebraic `K₁` of a Banach algebra with the stable group of components of its general
linear groups. Generation of `GLₙ(A)₀` by the ball about `1` holds for any Banach algebra norm
on `Matrix n n A` inducing the entrywise topology, by
`TauCeti.closure_setOf_norm_sub_one_lt_eq_connectedComponentOfOne`.

## Main results

* `Matrix.GeneralLinearGroup.instLocallyPathConnectedSpace`: `GL n A` is locally path connected.
* `Matrix.GeneralLinearGroup.closure_setOf_norm_sub_one_lt_eq_connectedComponentOfOne`: the
  ball about `1` for the `L∞` operator norm generates the identity component of `GL n A`.
* `Matrix.GeneralLinearGroup.mem_connectedComponentOfOne_iff_exists_prod_exp`: the identity
  component of `GL n A` consists of the finite products of exponentials.
* `RingHom.map_connectedComponentOfOne_GL_eq_of_surjective`: a surjective continuous ring
  homomorphism maps the identity component of `GL n A` onto that of `GL n B`.

## References

* G. Horváth and T. Kania, *Twisting exponential spectra*, Lemma 2.2.
-/

public section

open NormedSpace

namespace Matrix.GeneralLinearGroup

variable {n : Type*} [Fintype n] [DecidableEq n] {A : Type*}

/-- The general linear group over a complete normed ring which is a real normed space, for
instance over a real or complex Banach algebra, is locally path connected for the entrywise
topology. Hence its identity component is the path component of `1`. -/
instance instLocallyPathConnectedSpace [NormedRing A] [NormedSpace ℝ A] [CompleteSpace A] :
    LocallyPathConnectedSpace (GL n A) := by
  -- The operator-norm topology is the entrywise one by `rfl`
  -- (`Matrix.linftyOpTopologicalSpace_eq`), so the unit-group instance applies once it is
  -- stated for the operator-norm topology.
  open scoped Matrix.Norms.Operator in
  exact @Units.instLocallyPathConnectedSpace _ _ PseudoMetricSpace.toUniformSpace.toTopologicalSpace
    _ _

open scoped Matrix.Norms.Operator in
/-- **The invertible matrices within distance one of `1` for the `L∞` operator norm generate the
identity component of the general linear group over a Banach algebra.** -/
theorem closure_setOf_norm_sub_one_lt_eq_connectedComponentOfOne [NormedRing A] [NormedSpace ℝ A]
    [CompleteSpace A] :
    Subgroup.closure {g : GL n A | ‖(g : Matrix n n A) - 1‖ < 1} =
      Subgroup.connectedComponentOfOne (GL n A) :=
  -- The statement uses the operator norm for the ball and the entrywise topology for the
  -- identity component; these agree by `rfl` (`Matrix.linftyOpTopologicalSpace_eq`).
  TauCeti.closure_setOf_norm_sub_one_lt_eq_connectedComponentOfOne

variable [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]

/-- **The identity component of the general linear group over a Banach algebra consists of the
finite products of exponentials of matrices.** -/
theorem mem_connectedComponentOfOne_iff_exists_prod_exp {g : GL n A} :
    g ∈ Subgroup.connectedComponentOfOne (GL n A) ↔
      ∃ l : List (Matrix n n A), (l.map exp).prod = g := by
  -- The operator-norm topology is the entrywise one by `rfl`
  -- (`Matrix.linftyOpTopologicalSpace_eq`), so the unit-group result applies as is.
  open scoped Matrix.Norms.Operator in exact TauCeti.mem_connectedComponentOfOne_iff_exists_prod_exp

end Matrix.GeneralLinearGroup

namespace RingHom

variable {n : Type*} [Fintype n] [DecidableEq n] {A B : Type*} [NormedRing A] [NormedAlgebra ℝ A]
  [CompleteSpace A] [NormedRing B] [NormedAlgebra ℝ B] [CompleteSpace B]

/-- **A surjective continuous ring homomorphism of Banach algebras maps the identity component of
`GL n A` onto that of `GL n B`.** -/
theorem map_connectedComponentOfOne_GL_eq_of_surjective (f : A →+* B) (hf : Continuous f)
    (hsurj : Function.Surjective f) :
    (Subgroup.connectedComponentOfOne (GL n A)).map
        (Units.map (f.mapMatrix (m := n) : Matrix n n A →* Matrix n n B)) =
      Subgroup.connectedComponentOfOne (GL n B) := by
  -- The operator-norm topologies are the entrywise ones by `rfl`
  -- (`Matrix.linftyOpTopologicalSpace_eq`), so the unit-group result applies as is.
  open scoped Matrix.Norms.Operator in
  exact (f.mapMatrix (m := n)).map_connectedComponentOfOne_units_eq_of_surjective
    (continuous_id.matrix_map hf)
    fun M ↦ ⟨M.map (Function.surjInv hsurj), by ext; simp [Function.surjInv_eq hsurj]⟩

end RingHom
