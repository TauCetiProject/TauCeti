/-!
# Möbius extensions of Euclidean conformal maps

On the one-point compactification of a real Euclidean space, the Möbius group is the subgroup of
homeomorphisms generated by the extended similarities and inversions. In dimension at least
three, Liouville's theorem (`TauCeti.exists_eq_smul_linearIsometry_add_or_inversion_of_conformalAt`)
extends a `C³` conformal map on a connected open set to an element of this group. The extension
is unique: in the finite chart, a finite composition of the generators is real analytic off a
finite set, and the identity theorem on the complement determines the entire homeomorphism.
Thus germs of Euclidean conformal transitions give unique global transformations of the
compactified model, including transitions whose extension has a pole outside the germ.

## References

* D. E. Blair, *Inversion Theory and Conformal Mapping*, Student Mathematical Library 9,
  American Mathematical Society, 2000.
-/

public noncomputable section

open Filter Set Topology
open scoped ContDiff

namespace OnePoint

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The similarity `x ↦ r • A x + a`, extended to fix infinity. -/
def similarity (r : ℝ) (hr : r ≠ 0) (A : E ≃ₗᵢ[ℝ] E) (a : E) : OnePoint E ≃ₜ OnePoint E :=
  (A.toHomeomorph.trans <|
    (Homeomorph.smulOfNeZero r hr).trans (Homeomorph.addRight a)).onePointCongr

/-- Extended similarities fix infinity. -/
@[simp] theorem similarity_infty (r : ℝ) (hr : r ≠ 0) (A : E ≃ₗᵢ[ℝ] E) (a : E) :
    similarity r hr A a OnePoint.infty = OnePoint.infty :=
  (rfl)

/-- Extended similarities act by their affine formula on finite points. -/
@[simp] theorem similarity_coe (r : ℝ) (hr : r ≠ 0) (A : E ≃ₗᵢ[ℝ] E) (a x : E) :
    similarity r hr A a (x : OnePoint E) = ↑(r • A x + a) :=
  (rfl)

/-- The inverse similarity fixes infinity. -/
@[simp] theorem similarity_symm_infty (r : ℝ) (hr : r ≠ 0) (A : E ≃ₗᵢ[ℝ] E) (a : E) :
    (similarity r hr A a).symm OnePoint.infty = OnePoint.infty := by
  rw [Homeomorph.symm_apply_eq, similarity_infty]

/-- The inverse similarity on finite points. -/
@[simp] theorem similarity_symm_coe (r : ℝ) (hr : r ≠ 0) (A : E ≃ₗᵢ[ℝ] E) (a x : E) :
    (similarity r hr A a).symm (x : OnePoint E) = ↑(r⁻¹ • A.symm (x - a)) := by
  rw [Homeomorph.symm_apply_eq, similarity_coe, coe_eq_coe]
  simp [smul_smul, hr]

section Group

variable (E) [ProperSpace E]

/-- The real Möbius group of `OnePoint E`, generated by similarities and inversions in unit
spheres. Inversions of other nonzero radii are obtained by composing with similarities. -/
def moebiusGroup : Subgroup (OnePoint E ≃ₜ OnePoint E) :=
  Subgroup.closure ({g | ∃ (r : ℝ) (hr : r ≠ 0) (A : E ≃ₗᵢ[ℝ] E) (a : E),
    g = similarity r hr A a} ∪ range fun c : E ↦ inversion c 1 one_ne_zero)

variable {E}

/-- The Möbius group is the smallest subgroup containing the extended similarities and the
inversions in unit spheres. -/
theorem moebiusGroup_le_iff {G : Subgroup (OnePoint E ≃ₜ OnePoint E)} :
    moebiusGroup E ≤ G ↔
      (∀ (r : ℝ) (hr : r ≠ 0) (A : E ≃ₗᵢ[ℝ] E) (a : E), similarity r hr A a ∈ G) ∧
      ∀ c : E, inversion c 1 one_ne_zero ∈ G := by
  rw [moebiusGroup, Subgroup.closure_le, union_subset_iff, range_subset_iff]
  exact and_congr_left' ⟨fun h r hr A a ↦ h ⟨r, hr, A, a, rfl⟩,
    fun h _ ⟨r, hr, A, a, hg⟩ ↦ hg ▸ h r hr A a⟩

/-- Extended similarities belong to the Möbius group. -/
theorem similarity_mem_moebiusGroup (r : ℝ) (hr : r ≠ 0) (A : E ≃ₗᵢ[ℝ] E) (a : E) :
    similarity r hr A a ∈ moebiusGroup E :=
  Subgroup.subset_closure (Or.inl ⟨r, hr, A, a, rfl⟩)

/-- Inversion in a unit sphere belongs to the Möbius group. -/
theorem inversion_one_mem_moebiusGroup (c : E) : inversion c 1 one_ne_zero ∈ moebiusGroup E :=
  Subgroup.subset_closure (Or.inr (mem_range_self c))

end Group

/-- An analytic finite-coordinate formula exists at all but finitely many finite points. -/
private def HasFiniteAnalyticCharts (g : OnePoint E ≃ₜ OnePoint E) : Prop :=
  ∃ s : Set E, s.Finite ∧ ∀ x ∉ s, ∃ f : E → E, AnalyticAt ℝ f x ∧
    (fun y : E ↦ g (y : OnePoint E)) =ᶠ[𝓝 x] fun y ↦ (f y : OnePoint E)

private theorem HasFiniteAnalyticCharts.mul {g h : OnePoint E ≃ₜ OnePoint E}
    (hg : HasFiniteAnalyticCharts g) (hh : HasFiniteAnalyticCharts h) :
    HasFiniteAnalyticCharts (g * h) := by
  obtain ⟨s, hs, hgs⟩ := hg
  obtain ⟨t, ht, hht⟩ := hh
  -- Besides the exceptions of `h`, discard the preimages of the exceptions of `g`.
  let u := (fun x : E ↦ h (x : OnePoint E)) ⁻¹' (((↑) : E → OnePoint E) '' s)
  have hu : u.Finite := (hs.image _).preimage (h.injective.comp coe_injective).injOn
  refine ⟨t ∪ u, ht.union hu, fun x hx ↦ ?_⟩
  obtain ⟨f, hf, hef⟩ := hht x (fun hxt ↦ hx (Or.inl hxt))
  have hfx : f x ∉ s := by
    intro hfs
    have he : h (x : OnePoint E) = (f x : OnePoint E) := hef.self_of_nhds
    exact hx (Or.inr (mem_preimage.2 (he.symm ▸ mem_image_of_mem some hfs)))
  obtain ⟨k, hk, hek⟩ := hgs (f x) hfx
  refine ⟨k ∘ f, hk.comp hf, ?_⟩
  filter_upwards [hef, hf.continuousAt.eventually hek] with z hz hz'
  rw [Homeomorph.mul_apply, hz, Function.comp_apply, hz']

private theorem hasFiniteAnalyticCharts_of_mem_moebiusGroup [ProperSpace E]
    {g : OnePoint E ≃ₜ OnePoint E} (hg : g ∈ moebiusGroup E) : HasFiniteAnalyticCharts g := by
  suffices HasFiniteAnalyticCharts g ∧ HasFiniteAnalyticCharts g⁻¹ from this.1
  induction hg using Subgroup.closure_induction with
  | mem k hk =>
    rcases hk with ⟨r, hr, A, a, rfl⟩ | ⟨c, rfl⟩
    · constructor
      · refine ⟨∅, finite_empty, fun x _ ↦ ⟨fun y ↦ r • A y + a, ?_, ?_⟩⟩
        · exact (analyticAt_const.smul
            (A.toContinuousLinearEquiv.toContinuousLinearMap.analyticAt x)).add analyticAt_const
        · exact Eventually.of_forall fun y ↦ similarity_coe r hr A a y
      · refine ⟨∅, finite_empty, fun x _ ↦ ⟨fun y ↦ r⁻¹ • A.symm (y - a), ?_, ?_⟩⟩
        · have hd : AnalyticAt ℝ (fun y : E ↦ y - a) x := analyticAt_id.sub analyticAt_const
          exact analyticAt_const.smul
            ((A.symm.toContinuousLinearEquiv.toContinuousLinearMap.analyticAt (x - a)).comp
              (f := fun y ↦ y - a) hd)
        · exact Eventually.of_forall fun y ↦ similarity_symm_coe r hr A a y
    · have hi : HasFiniteAnalyticCharts (inversion c 1 one_ne_zero) := by
        refine ⟨{c}, finite_singleton _, fun x hx ↦
          ⟨EuclideanGeometry.inversion c 1, ?_, ?_⟩⟩
        · exact (EuclideanGeometry.contDiffAt_inversion (R := 1) hx :
            ContDiffAt ℝ ω (EuclideanGeometry.inversion c 1) x).analyticAt
        · filter_upwards [isOpen_compl_singleton.mem_nhds hx] with y hy
          exact inversion_coe c 1 one_ne_zero hy
      have hinv : (inversion c 1 one_ne_zero)⁻¹ = inversion c 1 one_ne_zero :=
        inversion_symm c 1 one_ne_zero
      exact ⟨hi, hinv.symm ▸ hi⟩
  | one =>
    have hi : HasFiniteAnalyticCharts (1 : OnePoint E ≃ₜ OnePoint E) :=
      ⟨∅, finite_empty, fun _ _ ↦ ⟨id, analyticAt_id, EventuallyEq.rfl⟩⟩
    exact ⟨hi, by simpa only [inv_one] using hi⟩
  | mul g h _ _ hg hh => exact ⟨hg.1.mul hh.1, by simpa only [mul_inv_rev] using hh.2.mul hg.2⟩
  | inv g _ hg => exact ⟨hg.2, by simpa only [inv_inv] using hg.1⟩

private theorem HasFiniteAnalyticCharts.exists_analyticOnNhd
    {g : OnePoint E ≃ₜ OnePoint E} (hg : HasFiniteAnalyticCharts g) :
    ∃ (s : Set E) (f : E → E), s.Finite ∧ AnalyticOnNhd ℝ f sᶜ ∧
      EqOn (fun x : E ↦ g (x : OnePoint E)) (fun x ↦ (f x : OnePoint E)) sᶜ := by
  obtain ⟨s, hs, h⟩ := hg
  refine ⟨s, fun x ↦ (g (x : OnePoint E)).elim 0 id, hs, ?_, ?_⟩
  · intro x hx
    obtain ⟨f, hf, he⟩ := h x hx
    refine hf.congr ?_
    filter_upwards [he] with y hy
    simp [hy]
  · intro x hx
    obtain ⟨f, _, he⟩ := h x hx
    simp [he.self_of_nhds]

/-- Two real Möbius transformations that agree on a nonempty open set in the finite chart agree
on the entire compactification. -/
theorem eq_of_mem_moebiusGroup_of_eqOn [ProperSpace E]
    (hE : 1 < Module.rank ℝ E) {g h : OnePoint E ≃ₜ OnePoint E}
    (hg : g ∈ moebiusGroup E) (hh : h ∈ moebiusGroup E) {U : Set E}
    (hU : IsOpen U) (hne : U.Nonempty)
    (he : EqOn (fun x : E ↦ g (x : OnePoint E)) (fun x : E ↦ h (x : OnePoint E)) U) : g = h := by
  have : Nontrivial E := (rank_pos_iff_nontrivial (R := ℝ)).1 (zero_lt_one.trans hE)
  obtain ⟨s, f, hs, hf, hgf⟩ :=
    (hasFiniteAnalyticCharts_of_mem_moebiusGroup hg).exists_analyticOnNhd
  obtain ⟨t, k, ht, hk, hhk⟩ :=
    (hasFiniteAnalyticCharts_of_mem_moebiusGroup hh).exists_analyticOnNhd
  let V := (s ∪ t)ᶜ
  have hV : IsOpen V := (hs.union ht).isClosed.isOpen_compl
  have hd : Dense V := (hs.union ht).countable.dense_compl ℝ
  obtain ⟨x, hx, hxV⟩ := hd.inter_open_nonempty _ hU hne
  have hconn : IsPreconnected V :=
    ((hs.union ht).countable.isConnected_compl_of_one_lt_rank hE).isPreconnected
  have hsV : V ⊆ sᶜ := compl_subset_compl.mpr subset_union_left
  have htV : V ⊆ tᶜ := compl_subset_compl.mpr subset_union_right
  -- Use the identity theorem on the common finite chart and then density at the omitted points.
  have hfk : EqOn f k V := (hf.mono hsV).eqOn_of_preconnected_of_eventuallyEq (hk.mono htV)
    hconn hxV (by
      filter_upwards [(hU.inter hV).mem_nhds ⟨hx, hxV⟩] with y hy
      exact coe_injective ((hgf (hsV hy.2)).symm.trans ((he hy.1).trans (hhk (htV hy.2)))))
  have heq : V ⊆ {y : E | g (y : OnePoint E) = h (y : OnePoint E)} :=
    fun y hy ↦ (hgf (hsV hy)).trans ((congrArg some (hfk hy)).trans (hhk (htV hy)).symm)
  have hc := closure_minimal heq
    (isClosed_eq (g.continuous.comp continuous_coe) (h.continuous.comp continuous_coe))
  have hfin : (fun x : E ↦ g (x : OnePoint E)) = fun x : E ↦ h (x : OnePoint E) :=
    funext fun y ↦ hc (hd y)
  exact Homeomorph.ext (funext_iff.1 (denseRange_coe.equalizer g.continuous h.continuous hfin))

/-- A real Möbius transformation is determined by its germ at any point, including infinity. -/
theorem eq_of_mem_moebiusGroup_of_eventuallyEq [ProperSpace E]
    (hE : 1 < Module.rank ℝ E) {g h : OnePoint E ≃ₜ OnePoint E}
    (hg : g ∈ moebiusGroup E) (hh : h ∈ moebiusGroup E) {p : OnePoint E}
    (he : (g : OnePoint E → OnePoint E) =ᶠ[𝓝 p] h) : g = h := by
  have : Nontrivial E := (rank_pos_iff_nontrivial (R := ℝ)).1 (zero_lt_one.trans hE)
  obtain ⟨W, hW, hWo, hp⟩ := mem_nhds_iff.1 he
  refine eq_of_mem_moebiusGroup_of_eqOn hE hg hh (hWo.preimage continuous_coe) ?_ (fun _ hx ↦ hW hx)
  have hd : Dense (range ((↑) : E → OnePoint E)) := denseRange_coe
  obtain ⟨_, hx, ⟨x, rfl⟩⟩ := hd.inter_open_nonempty W hWo ⟨p, hp⟩
  exact ⟨x, hx⟩

/-- **Compactified Liouville theorem.** A `C³` conformal map on a connected open subset of a
Euclidean space of dimension at least three is the restriction of a unique real Möbius
transformation. The extension agrees with the given map everywhere on the open set. -/
theorem existsUnique_moebius_extension [FiniteDimensional ℝ E]
    (hE : 3 ≤ Module.finrank ℝ E) {f : E → E} {U : Set E}
    (hU : IsOpen U) (hconn : IsConnected U) (hf : ContDiffOn ℝ 3 f U)
    (hconf : ∀ x ∈ U, ConformalAt f x) :
    ∃! g : moebiusGroup E, ∀ x ∈ U, (g : OnePoint E ≃ₜ OnePoint E) (x : OnePoint E) =
      (f x : OnePoint E) := by
  obtain ⟨r, A, a, hr, hcase⟩ :=
    TauCeti.exists_eq_smul_linearIsometry_add_or_inversion_of_conformalAt hE rfl hf hU hconn hconf
  let B := LinearIsometryEquiv.ofSurjective A
    ((LinearMap.injective_iff_surjective_of_finrank_eq_finrank rfl).mp A.injective)
  have hB : ⇑B = A := LinearIsometryEquiv.coe_ofSurjective _ _
  let s := similarity r hr.ne' B a
  have hs : s ∈ moebiusGroup E := similarity_mem_moebiusGroup r hr.ne' B a
  have hex : ∃ g : moebiusGroup E, ∀ x ∈ U, (g : OnePoint E ≃ₜ OnePoint E) (x : OnePoint E) =
      (f x : OnePoint E) := by
    rcases hcase with h | ⟨b, hb, h⟩
    · exact ⟨⟨s, hs⟩, fun x hx ↦ by simp [s, hB, h x hx]⟩
    · refine ⟨⟨s * inversion b 1 one_ne_zero, mul_mem hs (inversion_one_mem_moebiusGroup b)⟩,
        fun x hx ↦ ?_⟩
      have hxb : x ≠ b := fun he ↦ hb (he ▸ hx)
      simp [Homeomorph.mul_apply, inversion_coe b 1 one_ne_zero hxb, s, hB, h x hx]
  obtain ⟨g, hg⟩ := hex
  refine ⟨g, hg, fun k hk ↦ Subtype.ext ?_⟩
  have hdim : 1 < Module.finrank ℝ E := by omega
  exact eq_of_mem_moebiusGroup_of_eqOn (by exact_mod_cast Module.lt_rank_of_lt_finrank hdim)
    k.property g.property hU hconn.nonempty fun x hx ↦ (hk x hx).trans (hg x hx).symm

end OnePoint
