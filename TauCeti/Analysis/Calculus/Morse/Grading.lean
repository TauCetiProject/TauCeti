module

public import TauCeti.Analysis.Calculus.Morse.Boundary.Basic

/-!
# The Morse-index grading of the mod-two boundary

This file decomposes the mod-two Morse chains by Morse index. The homogeneous chains in degree
`n` are finitely supported functions on the nondegenerate critical points of index `n`. They
include into the total Morse chain module by extension by zero and are recovered by restriction.

The trajectory-counting boundary restricts from degree `n + 1` to degree `n`. Its inclusion into
the total chain module agrees with the total boundary. This is the grading needed to package the
Morse boundary as a chain complex once compactification and gluing prove that consecutive
boundaries compose to zero.

## Main declarations

* `TauCeti.MorseChainPiece`: mod-two Morse chains homogeneous of a fixed Morse index.
* `TauCeti.morseChainInclusion` and `TauCeti.morseChainProjection`: extension by zero and
  restriction between homogeneous and total chains.
* `TauCeti.morseBoundaryAt`: the trajectory-counting boundary from index `n + 1` to index `n`.
* `TauCeti.morseChainInclusion_morseBoundaryAt`: the restricted and total boundaries agree.

## Reference

M. Audin and M. Damian, *Morse Theory and Floer Homology*, Springer Universitext, 2014,
Chapter 4 (the graded Morse complex).
-/

public section

open Set
open scoped Gradient NNReal

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  {f : E → ℝ} {K : ℝ≥0}

/-- Mod-two Morse chains generated by the nondegenerate critical points of index `n`. -/
abbrev MorseChainPiece (f : E → ℝ) (n : ℕ) :=
  {p : MorseCriticalPoint f // morseIndex f p = n} →₀ ZMod 2

/-- Include chains of Morse index `n` into all Morse chains by extending their coefficients by
zero away from index `n`. -/
noncomputable def morseChainInclusion (n : ℕ) : MorseChainPiece f n →ₗ[ZMod 2] MorseChain f :=
  Finsupp.lmapDomain (ZMod 2) (ZMod 2) Subtype.val

/-- The coefficient of an included homogeneous chain is unchanged in its degree and zero in all
other degrees. -/
@[simp]
theorem morseChainInclusion_apply (n : ℕ) (c : MorseChainPiece f n) (p : MorseCriticalPoint f) :
    morseChainInclusion n c p =
      if hp : morseIndex f p = n then c ⟨p, hp⟩ else 0 := by
  -- On a subtype, `mapDomain Subtype.val` is Mathlib's extension by zero.
  have h : Finsupp.mapDomain Subtype.val c = c.extendDomain :=
    ((Finsupp.extendDomain_eq_embDomain_subtype c).trans (Finsupp.embDomain_eq_mapDomain _ c)).symm
  rw [morseChainInclusion, Finsupp.lmapDomain_apply, h, Finsupp.extendDomain_apply]

/-- Restrict a total Morse chain to the critical points of index `n`. -/
noncomputable def morseChainProjection (n : ℕ) : MorseChain f →ₗ[ZMod 2] MorseChainPiece f n :=
  Finsupp.lsubtypeDomain (R := ZMod 2) (M := ZMod 2)
    {p : MorseCriticalPoint f | morseIndex f p = n}

/-- Restriction reads the original coefficient at each critical point of the chosen index. -/
@[simp]
theorem morseChainProjection_apply (n : ℕ) (c : MorseChain f)
    (p : {p : MorseCriticalPoint f // morseIndex f p = n}) :
    morseChainProjection n c p = c p := by
  -- `lsubtypeDomain` presents the same subtype through membership in a set; expose its predicate
  -- form so that Mathlib's application lemma matches.
  change Finsupp.subtypeDomain (fun p : MorseCriticalPoint f ↦ morseIndex f p = n) c p = c p
  exact Finsupp.subtypeDomain_apply

/-- Restricting an included homogeneous chain recovers that chain. -/
@[simp]
theorem morseChainProjection_morseChainInclusion (n : ℕ) (c : MorseChainPiece f n) :
    morseChainProjection n (morseChainInclusion n c) = c := by
  ext p
  simp [p.property]

/-- Inclusion of a homogeneous Morse chain is injective. -/
theorem morseChainInclusion_injective (n : ℕ) :
    Function.Injective (morseChainInclusion (f := f) n) :=
  Function.LeftInverse.injective (morseChainProjection_morseChainInclusion (f := f) n)

/-- Including a homogeneous generator gives the corresponding generator in the total Morse chain
module. -/
@[simp]
theorem morseChainInclusion_single (n : ℕ)
    (p : {p : MorseCriticalPoint f // morseIndex f p = n}) (a : ZMod 2) :
    morseChainInclusion n (Finsupp.single p a) = Finsupp.single p.1 a :=
  Finsupp.mapDomain_single

section Boundary

variable [FiniteDimensional ℝ E]

variable (hfs : ContDiff ℝ 2 f) (hf : LipschitzWith K (∇ f))
  (hM : HasNondegenerateCriticalPointsOn f univ)
  (hcompact : ∀ c : ℝ, IsCompact {z | f z ≤ c})
  (htr : IsMorseSmale f hf)

/-- The total boundary of a chain concentrated in index `n + 1` has zero coefficient outside
index `n`. -/
theorem morseBoundary_morseChainInclusion_apply_eq_zero_of_morseIndex_ne (n : ℕ)
    (c : MorseChainPiece f (n + 1)) (q : MorseCriticalPoint f) (hq : morseIndex f q ≠ n) :
    morseBoundary hfs hf hM hcompact htr (morseChainInclusion (n + 1) c) q = 0 := by
  classical
  rw [morseBoundary_apply, Finsupp.sum]
  apply Finset.sum_eq_zero
  intro p _
  by_cases hp : morseIndex f p = n + 1
  · rw [morseBoundaryCoeff_eq_zero_of_morseIndex_ne_add_one hfs hf hM hcompact htr p q
      (by omega), mul_zero]
  · rw [morseChainInclusion_apply, dite_eq_right hp, zero_mul]

/-- The Morse boundary restricted from critical points of index `n + 1` to critical points of
index `n`. -/
noncomputable def morseBoundaryAt (n : ℕ) :
    MorseChainPiece f (n + 1) →ₗ[ZMod 2] MorseChainPiece f n :=
  (morseChainProjection n).comp
    ((morseBoundary hfs hf hM hcompact htr).comp (morseChainInclusion (n + 1)))

/-- A coefficient of the restricted boundary is the corresponding coefficient of the total
boundary. -/
@[simp]
theorem morseBoundaryAt_apply (n : ℕ) (c : MorseChainPiece f (n + 1))
    (q : {q : MorseCriticalPoint f // morseIndex f q = n}) :
    morseBoundaryAt hfs hf hM hcompact htr n c q =
      morseBoundary hfs hf hM hcompact htr (morseChainInclusion (n + 1) c) q := by
  simp [morseBoundaryAt]

/-- Inclusion into the total Morse chains intertwines the restricted boundary with the total
trajectory-counting boundary. -/
theorem morseChainInclusion_morseBoundaryAt (n : ℕ) (c : MorseChainPiece f (n + 1)) :
    morseChainInclusion n (morseBoundaryAt hfs hf hM hcompact htr n c) =
      morseBoundary hfs hf hM hcompact htr (morseChainInclusion (n + 1) c) := by
  ext q
  by_cases hq : morseIndex f q = n
  · simp [hq]
  · rw [morseChainInclusion_apply, dite_eq_right hq,
      morseBoundary_morseChainInclusion_apply_eq_zero_of_morseIndex_ne
        hfs hf hM hcompact htr n c q hq]

end Boundary

end TauCeti

end
