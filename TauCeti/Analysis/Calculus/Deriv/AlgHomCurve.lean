module

public import Mathlib.Analysis.Calculus.Deriv.Add
public import Mathlib.Analysis.Calculus.Deriv.Inv
public import Mathlib.Analysis.Calculus.Deriv.Mul
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Derivation.Basic

/-!
# Derivatives of coordinate functions along a curve of characters

Let `A` be a commutative algebra over a commutative semiring `k`, let `𝕜` be a nontrivially
normed field which is a `k`-algebra, and let `p : 𝕜 → (A →ₐ[k] 𝕜)` be a curve of `𝕜`-valued
characters of `A`. When `A` is the coordinate ring of an affine variety over `k`, `p` is a curve of
`𝕜`-points, and each `a : A` gives the coordinate function `t ↦ p t a` of the curve.

For a derivation `D` of `A` and a fixed parameter `t`, this file shows that the derivative test
"the coordinate function of `a` has derivative `p t (D a)` at `t`" can be checked on generators:
if it holds for every generator, it holds for every element of the subalgebra they generate
(`Derivation.hasDerivAt_apply_of_mem_adjoin`), and it passes from an element to its ring inverse
(`Derivation.hasDerivAt_apply_ringInverse`).

Applied at every `t` of the domain, these say that `p` is an integral curve of the vector field
`D` as soon as the generator identity holds at every `t`. For the coordinate ring of `GLₙ`,
generated by the matrix entries and the inverse determinant, this reduces the comparison of an
invariant vector field with the derivative of a matrix exponential to the matrix entries.
-/

public section

namespace Derivation

variable {k A 𝕜 : Type*} [CommSemiring k] [CommSemiring A] [Algebra k A]
  [NontriviallyNormedField 𝕜] [Algebra k 𝕜] (D : Derivation k A A) (p : 𝕜 → A →ₐ[k] 𝕜) {t : 𝕜}

/-- **The derivative test along a curve of characters is checked on generators.** Let `D` be a
derivation of `A` and `p` a curve of characters. If at `t` the coordinate function `u ↦ p u a` of
every element `a` of `s` has derivative `p t (D a)`, then so does the coordinate function of every
element of the subalgebra generated by `s`. -/
theorem hasDerivAt_apply_of_mem_adjoin {s : Set A}
    (hs : ∀ a ∈ s, HasDerivAt (fun u ↦ p u a) (p t (D a)) t) {a : A}
    (ha : a ∈ Algebra.adjoin k s) :
    HasDerivAt (fun u ↦ p u a) (p t (D a)) t := by
  induction ha using Algebra.adjoin_induction with
  | mem a ha => exact hs a ha
  | algebraMap r => simpa only [AlgHom.commutes, map_algebraMap, map_zero] using
      hasDerivAt_const t (algebraMap k 𝕜 r)
  | add a b _ _ ha hb => simpa only [map_add] using HasDerivAt.fun_add ha hb
  | mul a b _ _ ha hb =>
    -- Leibniz: `D (a * b) = a • D b + b • D a`, against the product rule for `p u a * p u b`.
    simp only [leibniz, map_add, map_mul, smul_eq_mul]
    convert ha.fun_mul hb using 1
    ring

/-- The coordinate function of `Ring.inverse a` has derivative `p t (D (Ring.inverse a))` at `t`
if that of `a` has derivative `p t (D a)` at `t`. For a non-unit `a` both sides are `0`. -/
theorem hasDerivAt_apply_ringInverse {a : A} (h : HasDerivAt (fun u ↦ p u a) (p t (D a)) t) :
    HasDerivAt (fun u ↦ p u (Ring.inverse a)) (p t (D (Ring.inverse a))) t := by
  by_cases ha : IsUnit a
  swap
  · simpa only [Ring.inverse_non_unit a ha, map_zero] using hasDerivAt_const t (0 : 𝕜)
  obtain ⟨a, rfl⟩ := ha
  have hne : p t a ≠ 0 := (a.map (p t).toMonoidHom).ne_zero
  -- Applying `p t` to the Leibniz rule `0 = D (a * a⁻¹) = a • D a⁻¹ + a⁻¹ • D a` determines
  -- `p t (D a⁻¹)`, which is the derivative `-(p t (D a)) / (p t a) ^ 2` of `(p u a)⁻¹`.
  have hD := congrArg (p t) (D.leibniz (a : A) ↑a⁻¹)
  simp only [Units.mul_inv, D.map_one_eq_zero, map_zero, map_add, map_mul, smul_eq_mul,
    map_units_inv (p t)] at hD
  have hderiv : p t (D ↑a⁻¹) = -p t (D a) / p t a ^ 2 := by
    rw [eq_div_iff (pow_ne_zero 2 hne)]
    linear_combination (-p t a) * hD - p t (D a) * mul_inv_cancel₀ hne
  rw [Ring.inverse_unit, hderiv]
  simpa only [map_units_inv] using h.fun_inv hne

end Derivation
