/-!
# Coordinate functions along a curve of characters

Let `A` be an algebra over a nontrivially normed field `𝕜`, and let
`p : 𝕜 → (A →ₐ[𝕜] 𝕜)` be a curve of `𝕜`-valued characters of `A`. When `A` is the coordinate ring
of an affine variety, `p` is a curve of `𝕜`-points, and each `a : A` gives the coordinate function
`t ↦ p t a` of the curve. This file shows that regularity of these coordinate functions can be
checked on generators of `A`:

* if the coordinate function of every generator is analytic at `t`, so is that of every element
  of the subalgebra they generate (`TauCeti.analyticAt_apply_of_mem_adjoin`), and the same holds
  for the inverse of a unit (`TauCeti.analyticAt_apply_ringInverse`);
* for a derivation `D` of `A`, if the coordinate function of every generator `a` has derivative
  `p t (D a)` at `t`, so has that of every element of the subalgebra they generate
  (`Derivation.hasDerivAt_apply_of_mem_adjoin`), and the same holds for the inverse of a unit
  (`Derivation.hasDerivAt_apply_ringInverse`).

The second statement says that `p` is an integral curve of the vector field `D` as soon as this
holds on generators; the derivation statements need `A` commutative. For the coordinate ring of
`GLₙ`, generated by the matrix entries and the inverse determinant, it reduces the comparison of
an invariant vector field with the derivative of a matrix exponential to the matrix entries.
-/

public section

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜]

namespace TauCeti

variable [Semiring A] [Algebra 𝕜 A] (p : 𝕜 → A →ₐ[𝕜] 𝕜) {t : 𝕜}

/-- **Analyticity of coordinate functions is checked on generators.** If, along a curve `p` of
characters, the coordinate function `u ↦ p u a` of every element `a` of `s` is analytic at `t`,
then so is the coordinate function of every element of the subalgebra generated by `s`. -/
theorem analyticAt_apply_of_mem_adjoin {s : Set A}
    (hs : ∀ a ∈ s, AnalyticAt 𝕜 (fun u ↦ p u a) t) {a : A} (ha : a ∈ Algebra.adjoin 𝕜 s) :
    AnalyticAt 𝕜 (fun u ↦ p u a) t := by
  induction ha using Algebra.adjoin_induction with
  | mem a ha => exact hs a ha
  | algebraMap r => simpa only [AlgHom.commutes, Algebra.algebraMap_self_apply] using
      analyticAt_const
  | add a b _ _ ha hb => simpa only [map_add] using ha.fun_add hb
  | mul a b _ _ ha hb => simpa only [map_mul] using ha.fun_mul hb

/-- The coordinate function of the inverse of a unit is analytic wherever that of the unit is. -/
theorem analyticAt_apply_ringInverse {a : A} (ha : IsUnit a)
    (h : AnalyticAt 𝕜 (fun u ↦ p u a) t) :
    AnalyticAt 𝕜 (fun u ↦ p u (Ring.inverse a)) t := by
  obtain ⟨a, rfl⟩ := ha
  simpa only [Ring.inverse_unit, map_units_inv] using h.fun_inv ((a.map (p t).toMonoidHom).ne_zero)

end TauCeti

namespace Derivation

section CommSemiring

variable [CommSemiring A] [Algebra 𝕜 A] (D : Derivation 𝕜 A A) (p : 𝕜 → A →ₐ[𝕜] 𝕜) {t : 𝕜}

/-- **Integral curves of a derivation are detected on generators.** Let `D` be a derivation of
`A` and `p` a curve of characters. If the coordinate function `u ↦ p u a` of every element `a` of
`s` has derivative `p t (D a)` at `t`, then so does the coordinate function of every element of
the subalgebra generated by `s`. -/
theorem hasDerivAt_apply_of_mem_adjoin {s : Set A}
    (hs : ∀ a ∈ s, HasDerivAt (fun u ↦ p u a) (p t (D a)) t) {a : A}
    (ha : a ∈ Algebra.adjoin 𝕜 s) :
    HasDerivAt (fun u ↦ p u a) (p t (D a)) t := by
  induction ha using Algebra.adjoin_induction with
  | mem a ha => exact hs a ha
  | algebraMap r => simpa only [AlgHom.commutes, Algebra.algebraMap_self_apply, map_algebraMap,
      map_zero] using hasDerivAt_const t r
  | add a b _ _ ha hb => simpa only [map_add] using HasDerivAt.fun_add ha hb
  | mul a b _ _ ha hb =>
    -- Leibniz: `D (a * b) = a • D b + b • D a`, against the product rule for `p u a * p u b`.
    have h := ha.fun_mul hb
    rw [leibniz, map_add, smul_eq_mul, smul_eq_mul, map_mul, map_mul, add_comm,
      mul_comm (p t b)]
    simpa only [map_mul] using h

/-- The coordinate function of the inverse of a unit `a` has derivative `p t (D a⁻¹)` at `t` if
that of `a` has derivative `p t (D a)` at `t`. -/
theorem hasDerivAt_apply_ringInverse {a : A} (ha : IsUnit a)
    (h : HasDerivAt (fun u ↦ p u a) (p t (D a)) t) :
    HasDerivAt (fun u ↦ p u (Ring.inverse a)) (p t (D (Ring.inverse a))) t := by
  obtain ⟨a, rfl⟩ := ha
  have hne : p t a ≠ 0 := (a.map (p t).toMonoidHom).ne_zero
  -- Applying `p t` to the Leibniz rule `0 = D (a * a⁻¹) = a • D a⁻¹ + a⁻¹ • D a` determines
  -- `p t (D a⁻¹)`, which is the derivative `-(p t (D a)) / (p t a) ^ 2` of `(p u a)⁻¹`.
  have hD := congrArg (p t) (D.leibniz (a : A) ↑a⁻¹)
  rw [Units.mul_inv, D.map_one_eq_zero, map_zero, map_add, smul_eq_mul, smul_eq_mul, map_mul,
    map_mul, map_units_inv (p t)] at hD
  have hderiv : p t (D ↑a⁻¹) = -p t (D a) / p t a ^ 2 := by
    rw [eq_div_iff (pow_ne_zero 2 hne)]
    linear_combination (-p t a) * hD - p t (D a) * mul_inv_cancel₀ hne
  rw [Ring.inverse_unit, hderiv]
  simpa only [map_units_inv] using h.fun_inv hne

end CommSemiring

end Derivation
