/-!
# The displacement isotopy of a map close to the identity

Let `h : E → E` be a map of a real Banach space whose displacement `u = h - id` is Lipschitz with
constant `c < 1`; for a `C¹` map this says that `‖Dh - 1‖ ≤ c` everywhere, so `h` is `C¹`-close to
the identity. For a function `ρ` of a real parameter `τ` with `|ρ τ| ≤ 1`, the
**displacement isotopy** is

`h_τ z = z + ρ(τ) • (h z - z)` (`TauCeti.displacementIsotopy`).

It is the identity where `ρ τ = 0`, it is `h` where `ρ τ = 1`, and it fixes every fixed point of
`h`. For a cutoff `ρ` that vanishes before a parameter window and equals `1` after it, it moves
the identity to `h` across that window. This is how an endpoint map of a flow box which is close
to the identity, such as the transition map of a modified vector field across a regular slab, is
realized by an actual isotopy, so that the modification can be spread over the slab.

**Slices.** Each slice `h_τ` approximates the identity with constant `|ρ τ| c < 1`, so it is a
homeomorphism of `E` (`TauCeti.displacementIsotopyHomeomorph`, by Mathlib's
`ApproximatesLinearOn.toHomeomorph`). Its inverse is `(1 - c)⁻¹`-Lipschitz
(`TauCeti.lipschitzWith_displacementIsotopyHomeomorph_symm`). When `h` is `C^n`, `1 ≤ n`, the
differential `1 + ρ τ • (Dh - 1)` of `h_τ` is invertible, since `‖ρ τ • (Dh - 1)‖ ≤ c < 1`, so the
inverse is `C^n` too and `h_τ` is a `C^n` diffeomorphism (`TauCeti.displacementIsotopyDiffeomorph`).

**The whole isotopy.** The time-preserving map `(τ, z) ↦ (τ, h_τ z)` of `ℝ × E` is a homeomorphism
for continuous `ρ` (`TauCeti.displacementIsotopyTotalHomeomorph`). Its differential is block
triangular with invertible diagonal blocks, so when `h` and `ρ` are `C^n` its inverse is `C^n`:
the inverses `h_τ⁻¹ y` depend jointly `C^n` on `(τ, y)`
(`TauCeti.contDiff_displacementIsotopyHomeomorph_symm_uncurry`).

**The generator.** The isotopy is the flow of the time-dependent vector field

`Z_τ = ρ'(τ) • (h - id) ∘ h_τ⁻¹` (`TauCeti.displacementIsotopyGenerator`):

`d/dτ h_τ z = Z_τ (h_τ z)` (`TauCeti.hasDerivAt_displacementIsotopy_generator`). When `h` is `C^n`
and `ρ` is `C^(n+1)`, the generator is jointly `C^n` in `(τ, y)`
(`TauCeti.contDiff_displacementIsotopyGenerator`). It vanishes at the fixed points of `h`, so its
support at each time lies in the set moved by `h`, and it vanishes at the times where `ρ' = 0`. Its
size and its Lipschitz constant are controlled by those of the displacement:
`‖Z_τ y‖ ≤ |ρ'(τ)| C` when `‖h z - z‖ ≤ C` everywhere
(`TauCeti.norm_displacementIsotopyGenerator_le`), and `Z_τ` is
`|ρ'(τ)| c (1 - c)⁻¹`-Lipschitz (`TauCeti.lipschitzWith_displacementIsotopyGenerator`). So a map
which is `C¹`-close to the identity is generated by a `C¹`-small time-dependent vector field.

## Main declarations

* `TauCeti.displacementIsotopy`: the isotopy `h_τ z = z + ρ(τ) • (h z - z)`.
* `TauCeti.displacementIsotopyHomeomorph`, `TauCeti.displacementIsotopyDiffeomorph`: its slices
  as homeomorphisms and as `C^n` diffeomorphisms.
* `TauCeti.displacementIsotopyTotalHomeomorph`: the map `(τ, z) ↦ (τ, h_τ z)` of `ℝ × E`.
* `TauCeti.contDiff_displacementIsotopyHomeomorph_symm_uncurry`: joint `C^n` regularity of the
  inverses.
* `TauCeti.displacementIsotopyGenerator`: the generator `Z_τ = ρ'(τ) • (h - id) ∘ h_τ⁻¹`, with
  `TauCeti.hasDerivAt_displacementIsotopy_generator` and
  `TauCeti.contDiff_displacementIsotopyGenerator`.
-/

public section

noncomputable section

open Set Function Filter
open scoped NNReal Manifold ContDiff Topology

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- **The displacement isotopy** `h_τ z = z + ρ(τ) • (h z - z)` of a map `h : E → E` along a real
function `ρ`: at the parameter `τ` it moves every point the fraction `ρ τ` of the way from `z` to
`h z`. -/
def displacementIsotopy (h : E → E) (ρ : ℝ → ℝ) (τ : ℝ) (z : E) : E :=
  z + ρ τ • (h z - z)

section Basic

variable {h : E → E} {ρ : ℝ → ℝ} {τ : ℝ} {z : E}

theorem displacementIsotopy_apply (h : E → E) (ρ : ℝ → ℝ) (τ : ℝ) (z : E) :
    displacementIsotopy h ρ τ z = z + ρ τ • (h z - z) :=
  (rfl)

/-- The point `h_τ z` is the point of the segment from `z` to `h z` with parameter `ρ τ`. -/
theorem displacementIsotopy_eq_lineMap (h : E → E) (ρ : ℝ → ℝ) (τ : ℝ) (z : E) :
    displacementIsotopy h ρ τ z = AffineMap.lineMap z (h z) (ρ τ) := by
  rw [displacementIsotopy_apply, AffineMap.lineMap_apply_module', add_comm]

/-- Where `ρ τ = 0` the displacement isotopy is the identity. -/
theorem displacementIsotopy_of_eq_zero (hτ : ρ τ = 0) : displacementIsotopy h ρ τ = id := by
  funext z
  simp [displacementIsotopy_apply, hτ]

/-- Where `ρ τ = 1` the displacement isotopy is `h`. -/
theorem displacementIsotopy_of_eq_one (hτ : ρ τ = 1) : displacementIsotopy h ρ τ = h := by
  funext z
  simp [displacementIsotopy_apply, hτ]

/-- The displacement isotopy fixes every fixed point of `h`. -/
theorem displacementIsotopy_apply_of_apply_eq (hz : h z = z) :
    displacementIsotopy h ρ τ z = z := by
  simp [displacementIsotopy_apply, hz]

/-- The parameter derivative of the displacement isotopy at a point is `ρ' • (h z - z)`. -/
theorem hasDerivAt_displacementIsotopy {ρ' : ℝ} (hρ : HasDerivAt ρ ρ' τ) (z : E) :
    HasDerivAt (fun τ ↦ displacementIsotopy h ρ τ z) (ρ' • (h z - z)) τ := by
  exact (hρ.smul_const (h z - z)).const_add z

/-- The differential of a slice of the displacement isotopy is `1 + ρ τ • (h' - 1)`. -/
theorem hasFDerivAt_displacementIsotopy {h' : E →L[ℝ] E} (hh : HasFDerivAt h h' z) :
    HasFDerivAt (displacementIsotopy h ρ τ)
      (ContinuousLinearMap.id ℝ E + ρ τ • (h' - ContinuousLinearMap.id ℝ E)) z :=
  (hasFDerivAt_id z).add ((hh.sub (hasFDerivAt_id z)).const_smul (ρ τ))

/-- Each slice of the displacement isotopy is `C^n` when `h` is. -/
theorem contDiff_displacementIsotopy_slice {n : WithTop ℕ∞} (hh : ContDiff ℝ n h) (τ : ℝ) :
    ContDiff ℝ n (displacementIsotopy h ρ τ) :=
  contDiff_id.add (contDiff_const.smul (hh.sub contDiff_id))

/-- The displacement isotopy is jointly `C^n` in the parameter and the point. -/
theorem contDiff_displacementIsotopy {n : WithTop ℕ∞} (hh : ContDiff ℝ n h)
    (hρ : ContDiff ℝ n ρ) : ContDiff ℝ n fun p : ℝ × E ↦ displacementIsotopy h ρ p.1 p.2 :=
  contDiff_snd.add ((hρ.comp contDiff_fst).smul ((hh.comp contDiff_snd).sub contDiff_snd))

end Basic

/-! ### The slices as homeomorphisms -/

section Homeomorph

variable [CompleteSpace E] {h : E → E} {ρ : ℝ → ℝ} {c : ℝ≥0}

omit [CompleteSpace E] in
/-- A slice of the displacement isotopy approximates the identity with constant `|ρ τ| c` when the
displacement `h - id` is `c`-Lipschitz. -/
theorem approximatesLinearOn_displacementIsotopy (hu : LipschitzWith c fun z ↦ h z - z)
    (τ : ℝ) :
    ApproximatesLinearOn (displacementIsotopy h ρ τ)
      ((ContinuousLinearEquiv.refl ℝ E : E ≃L[ℝ] E) : E →L[ℝ] E) univ (‖ρ τ‖₊ * c) := by
  intro x _ y _
  have hxy : displacementIsotopy h ρ τ x - displacementIsotopy h ρ τ y - (x - y) =
      ρ τ • ((h x - x) - (h y - y)) := by
    simp only [displacementIsotopy_apply, smul_sub]
    abel
  rw [ContinuousLinearEquiv.coe_refl, ContinuousLinearMap.id_apply, hxy, norm_smul,
    NNReal.coe_mul, coe_nnNorm, mul_assoc]
  gcongr
  exact hu.norm_sub_le x y

omit [CompleteSpace E] in
/-- The constant `|ρ τ| c` of the approximation is below the threshold of Mathlib's inverse
function theorem for the identity. -/
private theorem subsingleton_or_lt_inv (hc : c < 1) {s : ℝ} (hs : |s| ≤ 1) :
    Subsingleton E ∨
      ‖s‖₊ * c < ‖(((ContinuousLinearEquiv.refl ℝ E).symm : E ≃L[ℝ] E) : E →L[ℝ] E)‖₊⁻¹ := by
  rcases subsingleton_or_nontrivial E with hE | hE
  · exact Or.inl hE
  · right
    have hs' : ‖s‖₊ ≤ 1 := by
      rw [← NNReal.coe_le_coe, coe_nnNorm, Real.norm_eq_abs, NNReal.coe_one]
      exact hs
    rw [ContinuousLinearEquiv.refl_symm, ContinuousLinearEquiv.coe_refl,
      ContinuousLinearMap.nnNorm_id, inv_one]
    calc ‖s‖₊ * c ≤ 1 * c := by gcongr
      _ < 1 := by rwa [one_mul]

/-- **A slice of the displacement isotopy is a homeomorphism** of `E` when the displacement
`h - id` is `c`-Lipschitz with `c < 1` and `|ρ τ| ≤ 1`. -/
def displacementIsotopyHomeomorph (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1) (τ : ℝ)
    (hτ : |ρ τ| ≤ 1) : E ≃ₜ E :=
  ApproximatesLinearOn.toHomeomorph (displacementIsotopy h ρ τ)
    (approximatesLinearOn_displacementIsotopy hu τ) (subsingleton_or_lt_inv hc hτ)

@[simp]
theorem coe_displacementIsotopyHomeomorph (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (τ : ℝ) (hτ : |ρ τ| ≤ 1) :
    ⇑(displacementIsotopyHomeomorph hu hc τ hτ) = displacementIsotopy h ρ τ :=
  (rfl)

/-- The inverse of a slice moves `y` back by the displacement at its preimage:
`h_τ⁻¹ y = y - ρ(τ) • (h w - w)` for `w = h_τ⁻¹ y`. -/
theorem displacementIsotopyHomeomorph_symm_apply (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (τ : ℝ) (hτ : |ρ τ| ≤ 1) (y : E) :
    (displacementIsotopyHomeomorph hu hc τ hτ).symm y =
      y - ρ τ • (h ((displacementIsotopyHomeomorph hu hc τ hτ).symm y) -
        (displacementIsotopyHomeomorph hu hc τ hτ).symm y) := by
  set w := (displacementIsotopyHomeomorph hu hc τ hτ).symm y
  have hw : displacementIsotopy h ρ τ w = y :=
    (displacementIsotopyHomeomorph hu hc τ hτ).apply_symm_apply y
  rw [← hw, displacementIsotopy_apply, add_sub_cancel_right]

/-- The inverse of a slice fixes every fixed point of `h`. -/
theorem displacementIsotopyHomeomorph_symm_apply_of_apply_eq
    (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1) (τ : ℝ) (hτ : |ρ τ| ≤ 1) {y : E}
    (hy : h y = y) : (displacementIsotopyHomeomorph hu hc τ hτ).symm y = y := by
  rw [Homeomorph.symm_apply_eq, coe_displacementIsotopyHomeomorph,
    displacementIsotopy_apply_of_apply_eq hy]

omit [CompleteSpace E] in
/-- The absorption estimate behind the inverse: a slice moves points apart by at least the
factor `1 - c`, up to a change of the parameter which costs `|ρ τ - ρ τ'|` times the
displacement. -/
private theorem one_sub_mul_norm_sub_le (hu : LipschitzWith c fun z ↦ h z - z)
    {τ τ' : ℝ} (hτ : |ρ τ| ≤ 1) (w w' : E) :
    (1 - c) * ‖w - w'‖ ≤ ‖displacementIsotopy h ρ τ w - displacementIsotopy h ρ τ' w'‖ +
      |ρ τ - ρ τ'| * ‖h w' - w'‖ := by
  have hsplit : w - w' = (displacementIsotopy h ρ τ w - displacementIsotopy h ρ τ' w') -
      ρ τ • ((h w - w) - (h w' - w')) - (ρ τ - ρ τ') • (h w' - w') := by
    simp only [displacementIsotopy_apply, smul_sub, sub_smul]
    abel
  have hlip : ‖ρ τ • ((h w - w) - (h w' - w'))‖ ≤ c * ‖w - w'‖ := by
    rw [norm_smul, Real.norm_eq_abs]
    calc |ρ τ| * ‖(h w - w) - (h w' - w')‖ ≤ 1 * (c * ‖w - w'‖) :=
          mul_le_mul hτ (hu.norm_sub_le w w') (norm_nonneg _) zero_le_one
      _ = c * ‖w - w'‖ := one_mul _
  have hle : ‖w - w'‖ ≤ ‖displacementIsotopy h ρ τ w - displacementIsotopy h ρ τ' w'‖ +
      c * ‖w - w'‖ + |ρ τ - ρ τ'| * ‖h w' - w'‖ := by
    calc ‖w - w'‖ ≤ ‖displacementIsotopy h ρ τ w - displacementIsotopy h ρ τ' w'‖ +
          ‖ρ τ • ((h w - w) - (h w' - w'))‖ + ‖(ρ τ - ρ τ') • (h w' - w')‖ := by
          rw [hsplit]
          exact (norm_sub_le _ _).trans (add_le_add_left (norm_sub_le _ _) _)
      _ ≤ _ := by
          rw [norm_smul (ρ τ - ρ τ'), Real.norm_eq_abs]
          gcongr
  linarith

/-- **The inverse of a slice is `(1 - c)⁻¹`-Lipschitz.** -/
theorem lipschitzWith_displacementIsotopyHomeomorph_symm (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (τ : ℝ) (hτ : |ρ τ| ≤ 1) :
    LipschitzWith (1 - c)⁻¹ (displacementIsotopyHomeomorph hu hc τ hτ).symm := by
  refine LipschitzWith.of_dist_le_mul fun y y' ↦ ?_
  set e := displacementIsotopyHomeomorph hu hc τ hτ
  have hc' : (0 : ℝ) < 1 - c := sub_pos.2 (by exact_mod_cast hc)
  have key := one_sub_mul_norm_sub_le (τ' := τ) hu hτ (e.symm y) (e.symm y')
  rw [sub_self, abs_zero, zero_mul, add_zero, ← coe_displacementIsotopyHomeomorph hu hc τ hτ,
    e.apply_symm_apply, e.apply_symm_apply] at key
  rw [dist_eq_norm, dist_eq_norm, NNReal.coe_inv, NNReal.coe_sub hc.le, NNReal.coe_one,
    ← div_eq_inv_mul, le_div_iff₀ hc', mul_comm]
  exact key

end Homeomorph

/-! ### Diffeomorphisms -/

section Diffeomorph

variable [CompleteSpace E] {h : E → E} {ρ : ℝ → ℝ} {c : ℝ≥0} {n : WithTop ℕ∞}

/-- The differential `1 + ρ τ • (Dh z - 1)` of a slice of the displacement isotopy, invertible
since `‖ρ τ • (Dh z - 1)‖ ≤ c < 1`. -/
private def slopeEquiv (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1) (hh : Differentiable ℝ h)
    (s : ℝ) (hs : |s| ≤ 1) (z : E) : E ≃L[ℝ] E :=
  ContinuousLinearEquiv.unitsEquiv ℝ E
    (Units.oneSub (-(s • (fderiv ℝ h z - ContinuousLinearMap.id ℝ E))) (by
      have hD : fderiv ℝ (fun z ↦ h z - z) z = fderiv ℝ h z - ContinuousLinearMap.id ℝ E :=
        ((hh z).hasFDerivAt.sub (hasFDerivAt_id z)).fderiv
      rw [norm_neg, norm_smul, Real.norm_eq_abs, ← hD]
      calc |s| * ‖fderiv ℝ (fun z ↦ h z - z) z‖ ≤ 1 * c :=
            mul_le_mul hs (norm_fderiv_le_of_lipschitz ℝ hu) (norm_nonneg _) zero_le_one
        _ < 1 := by rw [one_mul]; exact_mod_cast hc))

private theorem coe_slopeEquiv (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (hh : Differentiable ℝ h) (s : ℝ) (hs : |s| ≤ 1) (z : E) :
    (slopeEquiv hu hc hh s hs z : E →L[ℝ] E) =
      ContinuousLinearMap.id ℝ E + s • (fderiv ℝ h z - ContinuousLinearMap.id ℝ E) := by
  ext v
  simp [slopeEquiv, Units.oneSub, sub_eq_add_neg]

private theorem slopeEquiv_apply (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (hh : Differentiable ℝ h) (s : ℝ) (hs : |s| ≤ 1) (z v : E) :
    slopeEquiv hu hc hh s hs z v = v + s • (fderiv ℝ h z v - v) := by
  rw [← ContinuousLinearEquiv.coe_coe, coe_slopeEquiv]
  simp

/-- **The inverse of a slice is `C^n`** when `h` is `C^n`, `1 ≤ n`. -/
theorem contDiff_displacementIsotopyHomeomorph_symm (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (τ : ℝ) (hτ : |ρ τ| ≤ 1) (hh : ContDiff ℝ n h) (hn : 1 ≤ n) :
    ContDiff ℝ n (displacementIsotopyHomeomorph hu hc τ hτ).symm := by
  have hd : Differentiable ℝ h := hh.differentiable (zero_lt_one.trans_le hn).ne'
  refine (displacementIsotopyHomeomorph hu hc τ hτ).contDiff_symm
    (f₀' := slopeEquiv hu hc hd (ρ τ) hτ) (fun z ↦ ?_) ?_
  · rw [coe_slopeEquiv, coe_displacementIsotopyHomeomorph]
    exact hasFDerivAt_displacementIsotopy (hd z).hasFDerivAt
  · exact contDiff_displacementIsotopy_slice hh τ

/-- **A slice of the displacement isotopy as a `C^n` diffeomorphism** of `E`, when `h` is `C^n`
with `1 ≤ n` and its displacement `h - id` is `c`-Lipschitz with `c < 1`. -/
def displacementIsotopyDiffeomorph (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1) (τ : ℝ)
    (hτ : |ρ τ| ≤ 1) (hh : ContDiff ℝ n h) (hn : 1 ≤ n) :
    E ≃ₘ^n⟮𝓘(ℝ, E), 𝓘(ℝ, E)⟯ E where
  toEquiv := (displacementIsotopyHomeomorph hu hc τ hτ).toEquiv
  contMDiff_toFun := contMDiff_iff_contDiff.2 <| contDiff_displacementIsotopy_slice hh τ
  contMDiff_invFun := contMDiff_iff_contDiff.2 <|
    contDiff_displacementIsotopyHomeomorph_symm hu hc τ hτ hh hn

@[simp]
theorem coe_displacementIsotopyDiffeomorph (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (τ : ℝ) (hτ : |ρ τ| ≤ 1) (hh : ContDiff ℝ n h) (hn : 1 ≤ n) :
    ⇑(displacementIsotopyDiffeomorph hu hc τ hτ hh hn) = displacementIsotopy h ρ τ :=
  (rfl)

@[simp]
theorem displacementIsotopyDiffeomorph_symm_apply (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (τ : ℝ) (hτ : |ρ τ| ≤ 1) (hh : ContDiff ℝ n h) (hn : 1 ≤ n) (y : E) :
    (displacementIsotopyDiffeomorph hu hc τ hτ hh hn).symm y =
      (displacementIsotopyHomeomorph hu hc τ hτ).symm y :=
  (rfl)

end Diffeomorph

/-! ### The whole isotopy -/

section Total

variable [CompleteSpace E] {h : E → E} {ρ : ℝ → ℝ} {c : ℝ≥0} {n : WithTop ℕ∞}

/-- The inverses of the slices depend continuously on the parameter and the point. -/
private theorem continuous_displacementIsotopyHomeomorph_symm
    (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1)
    (hρc : Continuous ρ) :
    Continuous fun p : ℝ × E ↦ (displacementIsotopyHomeomorph hu hc p.1 (hρ p.1)).symm p.2 := by
  set ψ := fun p : ℝ × E ↦ (displacementIsotopyHomeomorph hu hc p.1 (hρ p.1)).symm p.2
  have hc' : (0 : ℝ) < 1 - c := sub_pos.2 (by exact_mod_cast hc)
  have hψ : ∀ p, displacementIsotopy h ρ p.1 (ψ p) = p.2 := fun p ↦
    (displacementIsotopyHomeomorph hu hc p.1 (hρ p.1)).apply_symm_apply p.2
  -- `(1 - c) ‖ψ p - ψ p₀‖ ≤ ‖p.2 - p₀.2‖ + |ρ p.1 - ρ p₀.1| ‖h (ψ p₀) - ψ p₀‖`, whose right side
  -- tends to zero at `p₀`.
  refine continuous_iff_continuousAt.2 fun p₀ ↦ ?_
  rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
  have hbound : ∀ p : ℝ × E, ‖ψ p - ψ p₀‖ ≤
      (1 - (c : ℝ))⁻¹ * (‖p.2 - p₀.2‖ + |ρ p.1 - ρ p₀.1| * ‖h (ψ p₀) - ψ p₀‖) := fun p ↦ by
    have key := one_sub_mul_norm_sub_le hu (hρ p.1) (τ' := p₀.1) (ψ p) (ψ p₀)
    rw [hψ, hψ] at key
    rw [← div_eq_inv_mul, le_div_iff₀ hc', mul_comm]
    exact key
  refine squeeze_zero (fun _ ↦ norm_nonneg _) hbound ?_
  have hcont : Continuous fun p : ℝ × E ↦
      (1 - (c : ℝ))⁻¹ * (‖p.2 - p₀.2‖ + |ρ p.1 - ρ p₀.1| * ‖h (ψ p₀) - ψ p₀‖) := by
    fun_prop
  simpa using hcont.tendsto p₀

/-- **The total map of the displacement isotopy**, `(τ, z) ↦ (τ, h_τ z)`, as a homeomorphism of
`ℝ × E`, for continuous `ρ` with `|ρ| ≤ 1`, when the displacement `h - id` is `c`-Lipschitz with
`c < 1`. -/
def displacementIsotopyTotalHomeomorph (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (hρ : ∀ τ, |ρ τ| ≤ 1) (hρc : Continuous ρ) : (ℝ × E) ≃ₜ (ℝ × E) where
  toFun p := (p.1, displacementIsotopy h ρ p.1 p.2)
  invFun p := (p.1, (displacementIsotopyHomeomorph hu hc p.1 (hρ p.1)).symm p.2)
  left_inv p := by
    ext
    · rfl
    · exact (displacementIsotopyHomeomorph hu hc p.1 (hρ p.1)).symm_apply_apply p.2
  right_inv p := by
    ext
    · rfl
    · exact (displacementIsotopyHomeomorph hu hc p.1 (hρ p.1)).apply_symm_apply p.2
  continuous_toFun := by
    have hh : Continuous h :=
      (hu.continuous.add continuous_id).congr fun z ↦ sub_add_cancel (h z) z
    exact continuous_fst.prodMk (continuous_snd.add ((hρc.comp continuous_fst).smul
      ((hh.comp continuous_snd).sub continuous_snd)))
  continuous_invFun := continuous_fst.prodMk
    (continuous_displacementIsotopyHomeomorph_symm hu hc hρ hρc)

@[simp]
theorem displacementIsotopyTotalHomeomorph_apply (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (hρc : Continuous ρ) (p : ℝ × E) :
    displacementIsotopyTotalHomeomorph hu hc hρ hρc p = (p.1, displacementIsotopy h ρ p.1 p.2) :=
  (rfl)

@[simp]
theorem displacementIsotopyTotalHomeomorph_symm_apply (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (hρc : Continuous ρ) (p : ℝ × E) :
    (displacementIsotopyTotalHomeomorph hu hc hρ hρc).symm p =
      (p.1, (displacementIsotopyHomeomorph hu hc p.1 (hρ p.1)).symm p.2) :=
  (rfl)

/-- The differential of the total map is block triangular,
`(a, v) ↦ (a, (1 + ρ τ • (Dh z - 1)) v + a ρ'(τ) • (h z - z))`. -/
private theorem hasFDerivAt_displacementIsotopyTotal (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (hh : Differentiable ℝ h) (hρd : Differentiable ℝ ρ)
    (p : ℝ × E) :
    HasFDerivAt (fun p : ℝ × E ↦ (p.1, displacementIsotopy h ρ p.1 p.2))
      (((ContinuousLinearEquiv.refl ℝ ℝ).skewProd (slopeEquiv hu hc hh (ρ p.1) (hρ p.1) p.2)
        (ContinuousLinearMap.toSpanSingleton ℝ (deriv ρ p.1 • (h p.2 - p.2))) :
          (ℝ × E) ≃L[ℝ] ℝ × E) : ℝ × E →L[ℝ] ℝ × E) p := by
  have hρp : HasFDerivAt (fun q : ℝ × E ↦ ρ q.1)
      ((ContinuousLinearMap.toSpanSingleton ℝ (deriv ρ p.1)).comp
        (ContinuousLinearMap.fst ℝ ℝ E)) p :=
    (hρd p.1).hasDerivAt.hasFDerivAt.comp p hasFDerivAt_fst
  have hhp : HasFDerivAt (fun q : ℝ × E ↦ h q.2 - q.2)
      ((fderiv ℝ h p.2 - ContinuousLinearMap.id ℝ E).comp (ContinuousLinearMap.snd ℝ ℝ E)) p :=
    ((hh p.2).hasFDerivAt.sub (hasFDerivAt_id p.2)).comp p hasFDerivAt_snd
  refine (hasFDerivAt_fst.prodMk (hasFDerivAt_snd.add (hρp.smul hhp))).congr_fderiv
    (ContinuousLinearMap.ext fun q ↦ Prod.ext rfl ?_)
  simp [slopeEquiv_apply, smul_smul]
  abel

/-- **The inverse of the total map is `C^n`** when `h` and `ρ` are `C^n`, `1 ≤ n`. -/
theorem contDiff_displacementIsotopyTotalHomeomorph_symm (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (hh : ContDiff ℝ n h) (hρn : ContDiff ℝ n ρ)
    (hn : 1 ≤ n) :
    ContDiff ℝ n (displacementIsotopyTotalHomeomorph hu hc hρ hρn.continuous).symm := by
  have hd : Differentiable ℝ h := hh.differentiable (zero_lt_one.trans_le hn).ne'
  have hρd : Differentiable ℝ ρ := hρn.differentiable (zero_lt_one.trans_le hn).ne'
  refine (displacementIsotopyTotalHomeomorph hu hc hρ hρn.continuous).contDiff_symm
    (f₀' := fun p ↦ (ContinuousLinearEquiv.refl ℝ ℝ).skewProd
      (slopeEquiv hu hc hd (ρ p.1) (hρ p.1) p.2)
      (ContinuousLinearMap.toSpanSingleton ℝ (deriv ρ p.1 • (h p.2 - p.2)))) (fun p ↦ ?_) ?_
  · exact hasFDerivAt_displacementIsotopyTotal hu hc hρ hd hρd p
  · exact contDiff_fst.prodMk (contDiff_displacementIsotopy hh hρn)

/-- **The inverses of the slices of the displacement isotopy depend jointly `C^n` on the parameter
and the point**, when `h` and `ρ` are `C^n`, `1 ≤ n`. -/
theorem contDiff_displacementIsotopyHomeomorph_symm_uncurry (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (hh : ContDiff ℝ n h) (hρn : ContDiff ℝ n ρ)
    (hn : 1 ≤ n) :
    ContDiff ℝ n fun p : ℝ × E ↦ (displacementIsotopyHomeomorph hu hc p.1 (hρ p.1)).symm p.2 :=
  contDiff_snd.comp (contDiff_displacementIsotopyTotalHomeomorph_symm hu hc hρ hh hρn hn)

end Total

/-! ### The generator -/

section Generator

variable [CompleteSpace E] {h : E → E} {ρ : ℝ → ℝ} {c : ℝ≥0} {n : WithTop ℕ∞}

/-- **The generator of the displacement isotopy**, the time-dependent vector field
`Z_τ y = ρ'(τ) • (h w - w)` with `w = h_τ⁻¹ y`: the isotopy is its flow
(`TauCeti.hasDerivAt_displacementIsotopy_generator`). -/
def displacementIsotopyGenerator (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (hρ : ∀ τ, |ρ τ| ≤ 1) (τ : ℝ) (y : E) : E :=
  deriv ρ τ • (h ((displacementIsotopyHomeomorph hu hc τ (hρ τ)).symm y) -
    (displacementIsotopyHomeomorph hu hc τ (hρ τ)).symm y)

theorem displacementIsotopyGenerator_apply (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (hρ : ∀ τ, |ρ τ| ≤ 1) (τ : ℝ) (y : E) :
    displacementIsotopyGenerator hu hc hρ τ y =
      deriv ρ τ • (h ((displacementIsotopyHomeomorph hu hc τ (hρ τ)).symm y) -
        (displacementIsotopyHomeomorph hu hc τ (hρ τ)).symm y) :=
  (rfl)

/-- Along the isotopy the generator is the parameter derivative: `Z_τ (h_τ z) = ρ'(τ) • (h z - z)`.
-/
@[simp]
theorem displacementIsotopyGenerator_displacementIsotopy (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (τ : ℝ) (z : E) :
    displacementIsotopyGenerator hu hc hρ τ (displacementIsotopy h ρ τ z) =
      deriv ρ τ • (h z - z) := by
  rw [displacementIsotopyGenerator_apply, ← coe_displacementIsotopyHomeomorph hu hc τ (hρ τ),
    Homeomorph.symm_apply_apply]

/-- **The displacement isotopy is the flow of its generator**: `d/dτ h_τ z = Z_τ (h_τ z)`. -/
theorem hasDerivAt_displacementIsotopy_generator (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) {τ : ℝ} (hρd : DifferentiableAt ℝ ρ τ) (z : E) :
    HasDerivAt (fun τ ↦ displacementIsotopy h ρ τ z)
      (displacementIsotopyGenerator hu hc hρ τ (displacementIsotopy h ρ τ z)) τ := by
  rw [displacementIsotopyGenerator_displacementIsotopy]
  exact hasDerivAt_displacementIsotopy hρd.hasDerivAt z

/-- **The generator is jointly `C^n`** in the parameter and the point when `h` is `C^n` and `ρ` is
`C^(n+1)`, `1 ≤ n`. -/
theorem contDiff_displacementIsotopyGenerator (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (hρ : ∀ τ, |ρ τ| ≤ 1) (hh : ContDiff ℝ n h) (hρn : ContDiff ℝ (n + 1) ρ) (hn : 1 ≤ n) :
    ContDiff ℝ n fun p : ℝ × E ↦ displacementIsotopyGenerator hu hc hρ p.1 p.2 := by
  have hψ := contDiff_displacementIsotopyHomeomorph_symm_uncurry hu hc hρ hh
    (hρn.of_le le_self_add) hn
  exact (hρn.deriv'.comp contDiff_fst).smul ((hh.comp hψ).sub hψ)

/-- The generator vanishes at the fixed points of `h`. -/
theorem displacementIsotopyGenerator_apply_of_apply_eq (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (τ : ℝ) {y : E} (hy : h y = y) :
    displacementIsotopyGenerator hu hc hρ τ y = 0 := by
  rw [displacementIsotopyGenerator_apply,
    displacementIsotopyHomeomorph_symm_apply_of_apply_eq hu hc τ (hρ τ) hy, hy, sub_self,
    smul_zero]

/-- At each time the generator is supported in the set of points moved by `h`. -/
theorem support_displacementIsotopyGenerator_subset (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (τ : ℝ) :
    support (displacementIsotopyGenerator hu hc hρ τ) ⊆ support fun z ↦ h z - z := by
  intro y hy
  rw [mem_support] at hy ⊢
  exact sub_ne_zero.2 fun hy' ↦ hy (displacementIsotopyGenerator_apply_of_apply_eq hu hc hρ τ hy')

/-- The generator vanishes at the times where `ρ' = 0`. -/
theorem displacementIsotopyGenerator_of_deriv_eq_zero (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) {τ : ℝ} (hτ : deriv ρ τ = 0) :
    displacementIsotopyGenerator hu hc hρ τ = 0 := by
  funext y
  rw [displacementIsotopyGenerator_apply, hτ, zero_smul, Pi.zero_apply]

/-- **Size of the generator**: if the displacement is bounded by `C`, then
`‖Z_τ y‖ ≤ |ρ'(τ)| C`. -/
theorem norm_displacementIsotopyGenerator_le (hu : LipschitzWith c fun z ↦ h z - z) (hc : c < 1)
    (hρ : ∀ τ, |ρ τ| ≤ 1) {C : ℝ} (hC : ∀ z, ‖h z - z‖ ≤ C) (τ : ℝ) (y : E) :
    ‖displacementIsotopyGenerator hu hc hρ τ y‖ ≤ |deriv ρ τ| * C := by
  rw [displacementIsotopyGenerator_apply, norm_smul, Real.norm_eq_abs]
  exact mul_le_mul_of_nonneg_left (hC _) (abs_nonneg _)

/-- **Lipschitz constant of the generator**: `Z_τ` is `|ρ'(τ)| c (1 - c)⁻¹`-Lipschitz, so it is
`C¹`-small when the displacement is. -/
theorem lipschitzWith_displacementIsotopyGenerator (hu : LipschitzWith c fun z ↦ h z - z)
    (hc : c < 1) (hρ : ∀ τ, |ρ τ| ≤ 1) (τ : ℝ) :
    LipschitzWith (‖deriv ρ τ‖₊ * c * (1 - c)⁻¹) (displacementIsotopyGenerator hu hc hρ τ) := by
  rw [mul_assoc]
  exact (lipschitzWith_smul (deriv ρ τ)).comp
    (hu.comp (lipschitzWith_displacementIsotopyHomeomorph_symm hu hc τ (hρ τ)))

end Generator

end TauCeti
