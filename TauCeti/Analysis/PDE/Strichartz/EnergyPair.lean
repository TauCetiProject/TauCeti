module

public import TauCeti.Analysis.Fourier.PhaseGroup
import TauCeti.Analysis.PDE.Strichartz.Retarded

/-!
# The energy pair in the Strichartz estimates for a phase group

Let `S(t) = exp(itω(D))` be the unitary group on `L²(E, V)` generated by the Fourier multiplier
with real symbol `ω` (`TauCeti.phasePropagator`), for instance the Schrödinger propagator
`exp(itΔ)` or the half-wave propagator `exp(it|D|)`. Besides the Strichartz estimates along
dispersive admissible pairs, the solution of `∂ₜu = iω(D)u + F` satisfies estimates along the
**energy pair** `(∞, 2)`, whose dual estimate `‖∫ S(-s) F(s) ds‖₂ ≤ ‖F‖_{L¹_t L²_x}`
(`TauCeti.enorm_integral_phasePropagator_neg_le`) follows from unitarity. This file combines the
energy pair with a second pair given by a dual estimate

`‖∫ S(-s) F(s) ds‖₂ ≤ C ‖F‖_{L^p_t L^a_x}`

with `1 ≤ p < ∞`, in either order:

* **forcing in `L¹_t L²_x`, solution along the second pair**: the retarded estimate
  `‖∫_{s < t} S(t - s) F(s) ds‖_{L^{p'}_t L^{a'}_x} ≤ (1 - 2^{-1/p})⁻¹ C ‖F‖_{L¹_t L²_x}`, in
  weak form, from the Christ–Kiselev lemma
  (`TauCeti.enorm_integral_setIntegral_Iio_inner_adjoint_le`), whose condition on the time
  exponents, `1 / 1 + 1 / p > 1`, holds since `p < ∞`;
* **forcing in `L^p_t L^a_x`, solution in `L^∞_t L²_x`**: the bound
  `‖∫_I S(t - s) F(s) ds‖₂ ≤ C ‖F‖_{L^p(I; L^a)}` for every set of times `I` and every time `t`.
  It needs no Christ–Kiselev argument: since `S(t - s) = S(t) S(-s)` and `S(t)` is unitary, the
  dual estimate applied to `1_I F` bounds it directly.

## Main declarations

* `TauCeti.enorm_integral_setIntegral_Iio_inner_phasePropagator_sub_le_eLpNorm_one`: the retarded
  estimate with forcing in `L¹_t L²_x`, in weak form.
* `TauCeti.enorm_setIntegral_phasePropagator_sub_le`: the `L^∞_t L²_x` bound for forcing in the
  dual space of the second pair.

## References

* T. Tao, *Nonlinear Dispersive Equations: Local and Global Analysis*, CBMS Regional Conference
  Series in Mathematics 106, AMS, 2006, Theorem 2.3.
* M. Keel and T. Tao, *Endpoint Strichartz estimates*, Amer. J. Math. 120 (1998), 955–980.
* M. Christ and A. Kiselev, *Maximal functions associated to filtrations*, J. Funct. Anal. 179
  (2001), 409–425.
-/

public section

open MeasureTheory Set
open scoped ENNReal InnerProductSpace

namespace TauCeti

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E]
  {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V] {ω : C(E, ℝ)}
  {a p C : ℝ≥0∞}

/-- **The retarded estimate with forcing in the energy space**, in weak form: if `S(t) =
exp(itω(D))` satisfies the dual estimate `‖∫ S(-s) G(s) ds‖₂ ≤ C ‖G‖_{L^p_t L^a_x}` with
`1 ≤ p < ∞`, then for all almost everywhere strongly measurable `F, G : ℝ → L²(E, V)` for which
`s ↦ S(-s) F(s)` and `t ↦ S(-t) G(t)` are integrable,

`|∫ ∫_{s < t} ⟪S(t - s) F(s), G(t)⟫ ds dt| ≤ (1 - 2^{-1/p})⁻¹ C ‖F‖_{L¹_t L²_x} ‖G‖_{L^p_t L^a_x}`.

This is the Duhamel estimate `‖∫_{s < t} S(t - s) F(s) ds‖_{L^{p'}_t L^{a'}_x} ≲ ‖F‖_{L¹_t L²_x}`
tested against `G`, pairing the energy pair `(∞, 2)` on the forcing side with the pair dual to
`(p, a)` on the solution side. -/
theorem enorm_integral_setIntegral_Iio_inner_phasePropagator_sub_le_eLpNorm_one (hp : 1 ≤ p)
    (hp_top : p ≠ ∞)
    (hC : ∀ G : ℝ → Lp V 2 (volume : Measure E), AEStronglyMeasurable G →
      Integrable (fun t ↦ phasePropagator V ω (-t) (G t)) →
      ‖∫ t, phasePropagator V ω (-t) (G t)‖ₑ ≤ C * eLpNorm (fun t ↦ eLpNorm (G t) a volume) p)
    {F G : ℝ → Lp V 2 (volume : Measure E)} (hF : AEStronglyMeasurable F)
    (hG : AEStronglyMeasurable G) (hSF : Integrable fun s ↦ phasePropagator V ω (-s) (F s))
    (hSG : Integrable fun t ↦ phasePropagator V ω (-t) (G t)) :
    ‖∫ t, ∫ s in Iio t, ⟪phasePropagator V ω (t - s) (F s), G t⟫_ℂ‖ₑ ≤
      (1 - 2 ^ (-p⁻¹.toReal))⁻¹ * C * eLpNorm (fun s ↦ eLpNorm (F s) 2 volume) 1 *
        eLpNorm (fun t ↦ eLpNorm (G t) a volume) p := by
  -- The time exponents `1` and `p < ∞` satisfy the Christ–Kiselev condition `1 / 1 + 1 / p > 1`.
  have hpp : 1 < (1 : ℝ≥0∞)⁻¹ + p⁻¹ := by
    rw [inv_one]
    exact ENNReal.lt_add_right ENNReal.one_ne_top (ENNReal.inv_ne_zero.2 hp_top)
  simp_rw [inner_phasePropagator_sub_apply]
  simp_rw [← adjoint_phasePropagator] at hC hSF hSG
  refine (enorm_integral_setIntegral_Iio_inner_adjoint_le (a₁ := 2) (C₁ := 1) hp hpp
    (fun F _ _ ↦ by
      simpa only [one_mul, adjoint_phasePropagator] using
        enorm_integral_phasePropagator_neg_le ω F)
    hC hF hG hSF hSG).trans_eq ?_
  rw [inv_one, ENNReal.add_sub_cancel_left ENNReal.one_ne_top, mul_one]

/-- **The energy bound with forcing in a dual space**: if `S(t) = exp(itω(D))` satisfies the dual
estimate `‖∫ S(-s) G(s) ds‖₂ ≤ C ‖G‖_{L^p_t L^a_x}`, then for every `F : ℝ → L²(E, V)`, every
measurable set of times `I` on which `F` is almost everywhere strongly measurable and
`s ↦ S(-s) F(s)` is integrable, and every time `t`,

`‖∫_I S(t - s) F(s) ds‖₂ ≤ C ‖F‖_{L^p(I; L^a)}`.

For `I = (-∞, t)` this is the retarded estimate
`‖∫_{s < t} S(t - s) F(s) ds‖_{L^∞_t L²_x} ≤ C ‖F‖_{L^p_t L^a_x}`. -/
theorem enorm_setIntegral_phasePropagator_sub_le
    (hC : ∀ G : ℝ → Lp V 2 (volume : Measure E), AEStronglyMeasurable G →
      Integrable (fun s ↦ phasePropagator V ω (-s) (G s)) →
      ‖∫ s, phasePropagator V ω (-s) (G s)‖ₑ ≤ C * eLpNorm (fun s ↦ eLpNorm (G s) a volume) p)
    {F : ℝ → Lp V 2 (volume : Measure E)} {I : Set ℝ} (hI : MeasurableSet I)
    (hF : AEStronglyMeasurable F (volume.restrict I))
    (hSF : IntegrableOn (fun s ↦ phasePropagator V ω (-s) (F s)) I) (t : ℝ) :
    ‖∫ s in I, phasePropagator V ω (t - s) (F s)‖ₑ ≤
      C * eLpNorm (fun s ↦ eLpNorm (F s) a volume) p (volume.restrict I) := by
  -- `S(t - s) = S(t) S(-s)`, and `S(t)` is unitary, so it can be taken out of the integral.
  have hfac : ∫ s in I, phasePropagator V ω (t - s) (F s) =
      phasePropagator V ω t (∫ s in I, phasePropagator V ω (-s) (F s)) := by
    simp_rw [sub_eq_add_neg, phasePropagator_add_apply]
    exact (phasePropagator V ω t).integral_comp_comm hSF
  rw [hfac, enorm_phasePropagator_apply,
    ← eLpNorm_indicator_eq_eLpNorm_restrict (hI.nullMeasurableSet (μ := volume))]
  simp_rw [← adjoint_phasePropagator] at hC hSF ⊢
  exact enorm_setIntegral_adjoint_le hC hI hF hSF

end TauCeti
