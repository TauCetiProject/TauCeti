/-!
# The Dirichlet semigroup of a divergence-form operator

For a divergence-form operator `L u = -∂ᵢ(aⁱʲ ∂ⱼu) + bⁱ ∂ᵢu + c u` on an open set `Ω ⊆ ℝⁿ` whose
energy form is bounded and coercive on `H¹₀(Ω)`, this file constructs the **Dirichlet semigroup**
`e^{-tL}` on `L²(Ω)` (`TauCeti.PDE.dirichletSemigroup`): the strongly continuous contraction
semigroup whose generator is `-L` with the Dirichlet boundary condition. The motivating example is
`L = -Δ` on a domain where the Dirichlet energy form is coercive on `H¹₀(Ω)` (for instance a bounded
`Ω`): there `e^{-tL}` is meant to be the heat semigroup of `Ω` with zero boundary values, with
`t ↦ e^{-tL} u₀` the solution of

`∂ₜu + L u = 0` in `Ω`, `u = 0` on `∂Ω`, `u(0) = u₀`.

This file constructs the semigroup and describes its generator; it does not prove that
`t ↦ e^{-tL} u₀` solves this parabolic problem.

The generator is the **Dirichlet realization** of `-L` on `L²(Ω)`: an element `x ∈ L²(Ω)` lies in
its domain exactly when it is the value of a weak solution `u ∈ H¹₀(Ω)` of a Dirichlet problem
`L u = f` with `f ∈ L²(Ω)` (`TauCeti.PDE.mem_dirichletSemigroup_generator_domain_iff`), and the
generator sends such an `x` to `-f` (`TauCeti.PDE.dirichletSemigroup_generator_apply_eq_neg_iff`).
Equivalently, the solution operator of the Dirichlet problem is the resolvent of the generator at
`0` (`TauCeti.PDE.isResolventAt_dirichletSemigroup_generator_zero`). As everywhere in the weak
theory, the boundary condition is membership in `H¹₀(Ω)`, so no regularity of `∂Ω` enters, and the
domain `Ω` need not be bounded as long as the energy form is coercive. Neither symmetry of `L` nor
any sign condition beyond coercivity is needed: the semigroup is the one generated by minus the
operator associated with the coercive energy form (`IsCoercive.formSemigroup`).

On a Dirichlet eigenfunction `u` with eigenvalue `κ`, the semigroup acts by multiplication by
`exp (-κ t)` (`TauCeti.PDE.dirichletSemigroup_apply_value_of_forall_eq_mul_inner`). Along any
orthonormal basis `(eₖ)` of `L²(Ω)` made of the values of Dirichlet eigenfunctions, the semigroup is
the eigenfunction expansion

`e^{-tL} f = ∑ₖ exp (-κₖ t) ⟪eₖ, f⟫ eₖ`

(`TauCeti.PDE.hasSum_dirichletSemigroup_apply`), the semigroup form of Fourier's
separation-of-variables expansion. For a bounded domain and a symmetric energy form such a basis
exists (`TauCeti.PDE.exists_hilbertBasis_hasSum_dirichletSemigroup_apply`).

## Main declarations

* `TauCeti.PDE.dirichletSemigroup`: the Dirichlet semigroup `e^{-tL}` on `L²(Ω)`.
* `TauCeti.PDE.dirichletSemigroup_generator`: its generator is the generator of the semigroup of
  the energy form, and `TauCeti.PDE.mem_dirichletSemigroup_generator_domain_iff`,
  `TauCeti.PDE.dirichletSemigroup_generator_apply_eq_neg_iff` describe it through weak solutions
  of the Dirichlet problem.
* `TauCeti.PDE.dirichletSemigroup_generator_domain` and
  `TauCeti.PDE.isResolventAt_dirichletSemigroup_generator_zero`: the domain is the range of
  `TauCeti.PDE.dirichletSolutionOperator`, which is the resolvent of the generator at `0`.
* `TauCeti.PDE.dirichletSemigroup_apply_value_of_forall_eq_mul_inner`: the action on an
  eigenfunction.
* `TauCeti.PDE.hasSum_dirichletSemigroup_apply`: the eigenfunction expansion along an orthonormal
  basis of eigenfunctions, which exists on a bounded domain for a symmetric energy form
  (`TauCeti.PDE.exists_hilbertBasis_hasSum_dirichletSemigroup_apply`).

## References

* L. C. Evans, *Partial Differential Equations*, Section 7.4.3 (semigroup theory for second-order
  parabolic equations).
* H. Brezis, *Functional Analysis, Sobolev Spaces and Partial Differential Equations*,
  Section 10.1 (the heat equation by the Hille–Yosida theorem).
* W. Arendt, *Heat kernels*, ISEM lecture notes 2005/06, Chapter 1 (the Dirichlet Laplacian as
  the operator associated with a coercive form).
-/

public section

noncomputable section

namespace TauCeti

namespace PDE

open Bornology MeasureTheory TopologicalSpace TauCeti.Semigroups
open scoped ENNReal InnerProduct InnerProductSpace NNReal

variable {ι : Type*} [Fintype ι] {mu : Measure (EuclideanSpace ℝ ι)} [mu.IsAddHaarMeasure]
  {Omega : Opens (EuclideanSpace ℝ ι)} {a : EuclideanSpace ℝ ι → Matrix ι ι ℝ}
  {b : EuclideanSpace ℝ ι → EuclideanSpace ℝ ι} {c : EuclideanSpace ℝ ι → ℝ}

attribute [local instance] W1p0.instNormedAddCommGroup W1p0.instInnerProductSpace

/-- **The Dirichlet semigroup** `e^{-tL}` on `L²(Ω)` of a divergence-form operator `L` whose
energy form is bounded and coercive on `H¹₀(Ω)`: the contraction semigroup generated by `-L` with
the Dirichlet boundary condition. Its generator is described by
`TauCeti.PDE.mem_dirichletSemigroup_generator_domain_iff` and
`TauCeti.PDE.dirichletSemigroup_generator_apply_eq_neg_iff`. -/
def dirichletSemigroup
    (hcoeff : MemLp (fun x ↦ energyIntegrand (a x) (b x) (c x)) ⊤ (mu.restrict Omega))
    (hcoercive : IsCoercive (energyFormH1L0 hcoeff)) :
    ContractionSemigroup (Lp ℝ 2 (mu.restrict Omega)) :=
  hcoercive.formSemigroup W1p0.denseRange_valueL_two

variable (hcoeff : MemLp (fun x ↦ energyIntegrand (a x) (b x) (c x)) ⊤ (mu.restrict Omega))
  (hcoercive : IsCoercive (energyFormH1L0 hcoeff))

/-- The Dirichlet semigroup is the semigroup of the energy form along the inclusion
`H¹₀(Ω) → L²(Ω)`. -/
theorem dirichletSemigroup_def :
    dirichletSemigroup hcoeff hcoercive = hcoercive.formSemigroup W1p0.denseRange_valueL_two :=
  (rfl)

/-- The generator of the Dirichlet semigroup is the generator of the semigroup of the energy form
along the inclusion `H¹₀(Ω) → L²(Ω)`. -/
theorem dirichletSemigroup_generator :
    (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator =
      hcoercive.formGenerator W1p0.valueL := by
  rw [dirichletSemigroup_def, hcoercive.formSemigroup_generator]

/-- **The domain of the generator of the Dirichlet semigroup.** An element `x ∈ L²(Ω)` lies in
the domain exactly when it is the value of a weak solution `u ∈ H¹₀(Ω)` of a Dirichlet problem
`L u = f` with `f ∈ L²(Ω)`. -/
theorem mem_dirichletSemigroup_generator_domain_iff {x : Lp ℝ 2 (mu.restrict Omega)} :
    x ∈ (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator.domain ↔
      ∃ (f : Lp ℝ 2 (mu.restrict Omega)) (u : W1p0 mu Omega 2),
        W1p.value (u : W1p mu Omega 2) = x ∧ IsWeakSolutionDirichlet a b c f u := by
  rw [dirichletSemigroup_generator, hcoercive.mem_formGenerator_domain_iff, exists_comm]
  simp only [W1p0.valueL_apply, isWeakSolutionDirichlet_iff_forall_energyFormH1L0_eq_inner hcoeff]

/-- The value of a weak solution of the Dirichlet problem `L u = f` with `f ∈ L²(Ω)` lies in the
domain of the generator of the Dirichlet semigroup. -/
theorem value_mem_dirichletSemigroup_generator_domain {f : Lp ℝ 2 (mu.restrict Omega)}
    {u : W1p0 mu Omega 2} (hu : IsWeakSolutionDirichlet a b c f u) :
    W1p.value (u : W1p mu Omega 2) ∈
      (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator.domain :=
  (mem_dirichletSemigroup_generator_domain_iff hcoeff hcoercive).2 ⟨f, u, rfl, hu⟩

/-- The domain of the generator of the Dirichlet semigroup is the range of the solution operator
of the Dirichlet problem. -/
theorem dirichletSemigroup_generator_domain :
    (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator.domain =
      LinearMap.range
        (dirichletSolutionOperator hcoeff hcoercive :
          Lp ℝ 2 (mu.restrict Omega) →ₗ[ℝ] Lp ℝ 2 (mu.restrict Omega)) := by
  rw [dirichletSemigroup_generator, hcoercive.formGenerator_domain, dirichletSolutionOperator_def]

/-- **The generator of the Dirichlet semigroup is the Dirichlet realization of `-L`.** On the
domain of the generator, it sends `x` to `-f` exactly when `x` is the value of a weak solution
`u ∈ H¹₀(Ω)` of the Dirichlet problem `L u = f`. -/
theorem dirichletSemigroup_generator_apply_eq_neg_iff
    (x : (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator.domain)
    (f : Lp ℝ 2 (mu.restrict Omega)) :
    (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator x = -f ↔
      ∃ u : W1p0 mu Omega 2, W1p.value (u : W1p mu Omega 2) = x ∧
        IsWeakSolutionDirichlet a b c f u := by
  revert x
  rw [dirichletSemigroup_def]
  intro x
  rw [hcoercive.formSemigroup_generator_apply W1p0.denseRange_valueL_two x
      (hcoercive.formSemigroup_generator W1p0.denseRange_valueL_two ▸ x.2),
    hcoercive.formGenerator_apply_eq_neg_iff W1p0.denseRange_valueL_two]
  simp only [W1p0.valueL_apply]
  exact exists_congr fun u => and_congr_right fun _ =>
    (isWeakSolutionDirichlet_iff_forall_energyFormH1L0_eq_inner hcoeff f u).symm

/-- On the domain of the generator of the Dirichlet semigroup, the generator sends `x` to `f`
exactly when `x` is the value of a weak solution `u ∈ H¹₀(Ω)` of the Dirichlet problem
`L u = -f`. -/
theorem dirichletSemigroup_generator_apply_eq_iff
    (x : (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator.domain)
    (f : Lp ℝ 2 (mu.restrict Omega)) :
    (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator x = f ↔
      ∃ u : W1p0 mu Omega 2, W1p.value (u : W1p mu Omega 2) = x ∧
        IsWeakSolutionDirichlet a b c (-f) u := by
  rw [← dirichletSemigroup_generator_apply_eq_neg_iff, neg_neg]

/-- The generator of the Dirichlet semigroup sends the value of a weak solution of `L u = f` to
`-f`. -/
theorem dirichletSemigroup_generator_apply_value {f : Lp ℝ 2 (mu.restrict Omega)}
    {u : W1p0 mu Omega 2} (hu : IsWeakSolutionDirichlet a b c f u) :
    (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator
      ⟨_, value_mem_dirichletSemigroup_generator_domain hcoeff hcoercive hu⟩ = -f :=
  (dirichletSemigroup_generator_apply_eq_neg_iff hcoeff hcoercive _ f).2 ⟨u, rfl, hu⟩

/-- **The solution operator of the Dirichlet problem is the resolvent of the generator at `0`**:
it inverts minus the generator of the Dirichlet semigroup. -/
theorem isResolventAt_dirichletSemigroup_generator_zero :
    LinearPMap.IsResolventAt
      (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator 0
      (dirichletSolutionOperator hcoeff hcoercive) := by
  rw [dirichletSemigroup_generator, dirichletSolutionOperator_def]
  exact hcoercive.isResolventAt_formGenerator_zero W1p0.denseRange_valueL_two

/-- The resolvent of the generator of the Dirichlet semigroup at `0` is the solution operator of
the Dirichlet problem. -/
theorem resolvent_dirichletSemigroup_generator_zero :
    (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator.resolvent 0 =
      dirichletSolutionOperator hcoeff hcoercive :=
  LinearPMap.resolvent_eq_of_isResolventAt
    (isResolventAt_dirichletSemigroup_generator_zero hcoeff hcoercive)

/-- An element `x` of the domain of the generator `A` of the Dirichlet semigroup is the value of
the weak solution of the Dirichlet problem `L u = -A x`. -/
theorem value_weakSolutionDirichlet_neg_dirichletSemigroup_generator
    (x : (dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator.domain) :
    W1p.value (weakSolutionDirichlet hcoeff hcoercive
        (-(dirichletSemigroup hcoeff hcoercive).toStronglyContinuousSemigroup.generator x) :
          W1p mu Omega 2) = x := by
  simpa using (isResolventAt_dirichletSemigroup_generator_zero hcoeff hcoercive).apply_smul_sub x

/-- **The Dirichlet semigroup on an eigenfunction.** If `u ∈ H¹₀(Ω)` solves the Dirichlet
eigenvalue problem `L u = κ u` weakly, then `e^{-tL}` multiplies its value by `exp (-κ t)`. -/
theorem dirichletSemigroup_apply_value_of_forall_eq_mul_inner {u : W1p0 mu Omega 2} {κ : ℝ}
    (hu : ∀ v : W1p0 mu Omega 2,
      energyFormH1 a b c (u : W1p mu Omega 2) (v : W1p mu Omega 2) =
        κ * ⟪W1p.value (u : W1p mu Omega 2), W1p.value (v : W1p mu Omega 2)⟫_ℝ)
    (t : ℝ≥0) :
    dirichletSemigroup hcoeff hcoercive t (W1p.value (u : W1p mu Omega 2)) =
      Real.exp (-(κ * t)) • W1p.value (u : W1p mu Omega 2) := by
  rw [dirichletSemigroup_def]
  simpa only [W1p0.valueL_apply] using
    hcoercive.formSemigroup_apply_of_forall_apply_eq_smul_inner W1p0.denseRange_valueL_two
      (u := u) (fun v => by simpa only [energyFormH1L0_apply, W1p0.valueL_apply] using hu v) t

/-- **The eigenfunction expansion of the Dirichlet semigroup.** Let `(eᵢ)` be an orthonormal basis
of `L²(Ω)` with `eᵢ` the value of a weak Dirichlet eigenfunction `uᵢ ∈ H¹₀(Ω)` of eigenvalue `κᵢ`.
Then

`e^{-tL} f = ∑ᵢ exp (-κᵢ t) ⟪eᵢ, f⟫ eᵢ`

for every `f ∈ L²(Ω)` and every `t ≥ 0`. -/
theorem hasSum_dirichletSemigroup_apply {α : Type*}
    (basis : HilbertBasis α ℝ (Lp ℝ 2 (mu.restrict Omega))) {kappa : α → ℝ}
    {u : α → W1p0 mu Omega 2} (hvalue : ∀ i, W1p.value (u i : W1p mu Omega 2) = basis i)
    (hu : ∀ i (v : W1p0 mu Omega 2),
      energyFormH1 a b c (u i : W1p mu Omega 2) (v : W1p mu Omega 2) =
        kappa i * ⟪W1p.value (u i : W1p mu Omega 2), W1p.value (v : W1p mu Omega 2)⟫_ℝ)
    (t : ℝ≥0) (f : Lp ℝ 2 (mu.restrict Omega)) :
    HasSum (fun i ↦ Real.exp (-(kappa i * t)) • basis.repr f i • basis i)
      (dirichletSemigroup hcoeff hcoercive t f) := by
  rw [dirichletSemigroup_def]
  refine hcoercive.hasSum_formSemigroup_apply W1p0.denseRange_valueL_two basis (u := u)
    (fun i => by rw [W1p0.valueL_apply, hvalue]) (fun i v => ?_) t f
  simpa only [energyFormH1L0_apply, W1p0.valueL_apply] using hu i v

/-- **The eigenfunction expansion of the Dirichlet semigroup on a bounded domain.** On a bounded
domain with a symmetric energy form there is an orthonormal basis `(eₖ)` of `L²(Ω)` whose members
are the values of weak Dirichlet eigenfunctions `uₖ ∈ H¹₀(Ω)` with positive eigenvalues `κₖ`, in
which

`e^{-tL} f = ∑ₖ exp (-κₖ t) ⟪eₖ, f⟫ eₖ`

for every `f ∈ L²(Ω)` and every `t ≥ 0`. -/
theorem exists_hilbertBasis_hasSum_dirichletSemigroup_apply
    (hOmega : IsBounded (Omega : Set (EuclideanSpace ℝ ι)))
    (hsymm : ∀ u v : W1p0 mu Omega 2,
      energyFormH1 a b c (u : W1p mu Omega 2) (v : W1p mu Omega 2) =
        energyFormH1 a b c (v : W1p mu Omega 2) (u : W1p mu Omega 2)) :
    ∃ (s : Set (Lp ℝ 2 (mu.restrict Omega)))
      (basis : HilbertBasis s ℝ (Lp ℝ 2 (mu.restrict Omega))) (kappa : s → ℝ)
      (u : s → W1p0 mu Omega 2),
      ⇑basis = ((↑) : s → Lp ℝ 2 (mu.restrict Omega)) ∧ (∀ e : s, 0 < kappa e) ∧
      (∀ e : s, IsDirichletEigenvalue mu Omega a b c (kappa e)) ∧
      (∀ e : s, W1p.value (u e : W1p mu Omega 2) = (e : Lp ℝ 2 (mu.restrict Omega))) ∧
      (∀ (e : s) (v : W1p0 mu Omega 2),
        energyFormH1 a b c (u e : W1p mu Omega 2) (v : W1p mu Omega 2) =
          kappa e * ⟪W1p.value (u e : W1p mu Omega 2), W1p.value (v : W1p mu Omega 2)⟫_ℝ) ∧
      ∀ (t : ℝ≥0) (f : Lp ℝ 2 (mu.restrict Omega)),
        HasSum (fun e : s ↦ Real.exp (-(kappa e * t)) • basis.repr f e • basis e)
          (dirichletSemigroup hcoeff hcoercive t f) := by
  obtain ⟨s, basis, kappa, u, hbasis, hpos, heig, hvalue, heq, -⟩ :=
    exists_hilbertBasis_forall_isDirichletEigenvalue hcoeff hcoercive hOmega hsymm
  refine ⟨s, basis, kappa, u, hbasis, hpos, heig, hvalue, heq, fun t f => ?_⟩
  exact hasSum_dirichletSemigroup_apply hcoeff hcoercive basis
    (fun e => by rw [hvalue, hbasis]) heq t f

end PDE

end TauCeti
