module

public import TauCeti.Analysis.Semigroups.Generation.Form
public import TauCeti.Analysis.Sobolev.WeakDeriv.GelfandTriple
import TauCeti.Analysis.Semigroups.CauchyProblem.Inhomogeneous

/-!
# Weak solutions of autonomous parabolic equations and Duhamel's formula

Let `B` be a bounded coercive bilinear form on a real Hilbert space `V` and `J : V →L[ℝ] H` a
continuous linear map with dense range into a real Hilbert space `H`, so that
`V ↪ H ↪ V*` is a Gelfand triple (`ContinuousLinearMap.gelfandDual`). The form defines two
notions of solution of the autonomous linear parabolic equation

`u' + B u = g`, `u(a) = u₀`,

with forcing `g : (a, b) → H`:

* a **weak solution** is a `u : (a, b) → V` whose image `J.gelfandDual ∘ J ∘ u` in `V*` has the
  weak time derivative `u' = J.gelfandDual ∘ g - B ∘ u`, as in the existence and uniqueness
  theorems `TauCeti.exists_hasWeakLineDerivOn_gelfandDual` and
  `TauCeti.HasWeakLineDerivOn.eqOn_of_gelfandDual`; its values `J ∘ u` in `H` have a
  representative `w` continuous on `[a, b]`;
* the semigroup solution is given by **Duhamel's formula** with the contraction semigroup
  `e^{-t𝒜}` generated by minus the operator `𝒜` associated with the form
  (`IsCoercive.formSemigroup`).

This file shows that the two agree: for every `t ∈ [a, b]`,

`w t = e^{-(t - a)𝒜} (w a) + ∫_{(a,t]} e^{-(t - s)𝒜} g(s) ds`

(`TauCeti.HasWeakLineDerivOn.eqOn_formSemigroup_add_setIntegral_of_gelfandDual`). In particular,
for `g = 0` the continuous representative of a weak solution is the semigroup orbit of its
initial value. Only integrability of `u` and `g` on `(a, b)` is used, not their square
integrability.

## The argument

Integrating the weak equation over `(a, t)` with the fundamental theorem of calculus for weak
derivatives (`TauCeti.HasWeakLineDerivOn.integral_eq_sub`) gives, in `V*`,

`J.gelfandDual (w t - w a) = J.gelfandDual (∫_{(a,t]} g) - B (∫_{(a,t]} u)`,

since the bounded operators `J.gelfandDual` and `B` commute with the Bochner integral. Tested
against `v ∈ V`, this says that `J (∫_{(a,t]} u) = ∫_{(a,t]} w` lies in the domain of the
generator `-𝒜` and that `-𝒜` sends it to `w t - w a - ∫_{(a,t]} g`
(`IsCoercive.mem_graph_formGenerator_iff`). So `w` is a mild solution of `w' = -𝒜 w + g` on
`[a, b]`, and mild solutions on a bounded interval are given by Duhamel's formula
(`StronglyContinuousSemigroup.eqOn_realOperator_sub_add_setIntegral_of_generator_setIntegral_eq`
in `TauCeti.Semigroups`).

## References

* L. C. Evans, *Partial Differential Equations*, 2nd ed., §7.4.3 (second-order parabolic
  equations as semigroups).
* A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*,
  Section 4.2 (mild solutions and Duhamel's formula).
-/

public section

noncomputable section

open MeasureTheory Set TauCeti.Semigroups
open scoped InnerProductSpace

namespace TauCeti

variable {V H : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] {B : V →L[ℝ] V →L[ℝ] ℝ}
  {J : V →L[ℝ] H} {a b : ℝ} {u : ℝ → V} {u' : ℝ → StrongDual ℝ V} {g w : ℝ → H}

/-- **Weak solutions are mild solutions.** For a weak solution of `u' + B u = g` on `(a, b)` with
continuous representative `w`, and `t ∈ [a, b]`, the time integral `∫_{(a,t]} w` lies in the
domain of the generator of the form semigroup, which sends it to `w t - w a - ∫_{(a,t]} g`. -/
private theorem HasWeakLineDerivOn.mem_graph_formGenerator_of_gelfandDual
    (h : HasWeakLineDerivOn volume ⟨Ioo a b, isOpen_Ioo⟩ (fun t ↦ J.gelfandDual (J (u t))) u' 1)
    (hB : IsCoercive B) (hJ : DenseRange J) (hu : IntegrableOn u (Ioo a b))
    (hg : IntegrableOn g (Ioo a b))
    (heq : ∀ᵐ t ∂volume.restrict (Ioo a b), u' t + B (u t) = J.gelfandDual (g t))
    (hw : ContinuousOn w (Icc a b)) (hae : (fun t ↦ J (u t)) =ᵐ[volume.restrict (Ioo a b)] w)
    {t : ℝ} (ht : t ∈ Icc a b) :
    ((∫ s in Ioc a t, w s), w t - w a - ∫ s in Ioc a t, g s) ∈ (hB.formGenerator J).graph := by
  have hsub : Ioo a t ⊆ Ioo a b := Ioo_subset_Ioo_right ht.2
  have hut := hu.mono_set hsub
  have hgt := hg.mono_set hsub
  have hu' : IntegrableOn u' (Ioo a b) := ((J.gelfandDual.integrable_comp hg).sub
    (B.integrable_comp hu)).congr (heq.mono fun s hs ↦ (eq_sub_of_add_eq hs).symm)
  -- The weak equation, integrated over `(a, t)`.
  have hftc := h.integral_eq_sub hu' (J.gelfandDual.continuous.comp_continuousOn hw)
    (hae.fun_comp J.gelfandDual) (left_mem_Icc.2 (ht.1.trans ht.2)) ht
  rw [intervalIntegral.integral_of_le ht.1, integral_Ioc_eq_integral_Ioo,
    setIntegral_congr_ae measurableSet_Ioo ((ae_restrict_iff' measurableSet_Ioo).1
      (ae_restrict_of_ae_restrict_of_subset hsub
        (heq.mono fun s hs ↦ eq_sub_of_add_eq hs))),
    integral_sub (J.gelfandDual.integrable_comp hgt) (B.integrable_comp hut),
    J.gelfandDual.integral_comp_comm hgt, B.integral_comp_comm hut] at hftc
  rw [hB.mem_graph_formGenerator_iff hJ]
  refine ⟨∫ s in Ioc a t, u s, ?_, fun v ↦ ?_⟩
  · rw [integral_Ioc_eq_integral_Ioo, integral_Ioc_eq_integral_Ioo, ← J.integral_comp_comm hut]
    exact setIntegral_congr_ae measurableSet_Ioo ((ae_restrict_iff' measurableSet_Ioo).1
      (ae_restrict_of_ae_restrict_of_subset hsub hae))
  · have hv := congrArg (fun φ : StrongDual ℝ V ↦ φ v) hftc
    simp only [sub_apply, Function.comp_apply, ContinuousLinearMap.gelfandDual_apply] at hv
    simp only [integral_Ioc_eq_integral_Ioo, inner_neg_left, inner_sub_left]
    linarith

/-- **Duhamel's formula for weak solutions.** Let `B` be a bounded coercive bilinear form on `V`
and `J : V →L[ℝ] H` have dense range. Let `u : (a, b) → V` be a weak solution of
`u' + B u = g` with forcing `g` integrable on `(a, b)`: `t ↦ J.gelfandDual (J (u t))` has weak
derivative `u'` on `(a, b)` with `u' t + B (u t) = J.gelfandDual (g t)` for almost every `t`, where
`u` is integrable on `(a, b)`. If `w` is continuous on `[a, b]` and equal to `J ∘ u`
almost everywhere on `(a, b)`, then for every `t ∈ [a, b]`

`w t = S(t - a) (w a) + ∫_{(a,t]} S(t - s) g(s) ds`,

where `S = hB.formSemigroup hJ` is the semigroup `e^{-t𝒜}` of the form. -/
theorem HasWeakLineDerivOn.eqOn_formSemigroup_add_setIntegral_of_gelfandDual
    (h : HasWeakLineDerivOn volume ⟨Ioo a b, isOpen_Ioo⟩ (fun t ↦ J.gelfandDual (J (u t))) u' 1)
    (hB : IsCoercive B) (hJ : DenseRange J) (hu : IntegrableOn u (Ioo a b))
    (hg : IntegrableOn g (Ioo a b))
    (heq : ∀ᵐ t ∂volume.restrict (Ioo a b), u' t + B (u t) = J.gelfandDual (g t))
    (hw : ContinuousOn w (Icc a b)) (hae : (fun t ↦ J (u t)) =ᵐ[volume.restrict (Ioo a b)] w) :
    EqOn w (fun t ↦ (hB.formSemigroup hJ).realOperator (t - a) (w a) +
      ∫ s in Ioc a t, (hB.formSemigroup hJ).realOperator (t - s) (g s)) (Icc a b) := by
  refine (hB.formSemigroup hJ).eqOn_realOperator_sub_add_setIntegral_of_generator_setIntegral_eq
    (by rwa [integrableOn_Ioc_iff_integrableOn_Ioo]) hw fun t ht ↦ ?_
  have hmem := h.mem_graph_formGenerator_of_gelfandDual hB hJ hu hg heq hw hae ht
  rw [hB.formSemigroup_generator hJ]
  exact ⟨LinearPMap.mem_domain_of_mem_graph hmem, ((LinearPMap.image_iff _).2 hmem).symm⟩

end TauCeti
