/-!
# The strict topology on multiplier algebras

For a normed algebra `A` over `𝕜`, the *strict topology* on `𝓜(𝕜, A)` is the locally convex topology
generated by the seminorms `m ↦ ‖m.fst a‖ + ‖m.snd a‖` (`a : A`), so `mᵢ → m` strictly iff
`mᵢ.fst a → m.fst a` and `mᵢ.snd a → m.snd a` for all `a : A` (`tendsto_iff_forall_tendsto`).
Following `ContinuousLinearMapWOT` and `TauCeti.ContinuousLinearMapUltrastrong`, the strict topology
is placed on a type copy `TauCeti.DoubleCentralizerStrict 𝕜 A` (`𝓜ₛ(𝕜, A)`), avoiding instance
diamonds with the operator-norm topology on `𝓜(𝕜, A)`.

We equip `𝓜ₛ(𝕜, A)` with its `WithSeminorms` family (`withSeminorms`), prove `T3Space`,
`ContinuousStar`, `IsSemitopologicalRing`, joint strict continuity of multiplication on norm-bounded
filters and sets (`tendsto_mul_of_eventually_norm_le`, `continuousOn_mul_of_isBounded`), the unital
equivalence `homeomorphDoubleCentralizer` / `uniformEquivDoubleCentralizer`, global and bounded-ball
strict completeness (`instCompleteSpace`, `isComplete_norm_le`), and approximate-unit convergence,
strict density, and ball density (`denseRange_coe`, `closure_image_closedBall`).

## Implementation notes

Algebraic structure is transported along `DoubleCentralizerStrict.equiv` in an `@[expose]` section
so transport and topology/uniformity agreement hold definitionally downstream; `coeHom`,
`inducingFn`, `seminorm`, `seminormFamily`, `uniformEquivDoubleCentralizer`, and
`homeomorphDoubleCentralizer` are marked `@[no_expose]` and accessed via their `*_apply` lemmas.

## References

* R. C. Busby, *Double centralizers and extensions of C*-algebras*, Trans. Amer. Math. Soc. 132
  (1968), 79–99, §3.
* Bruce Blackadar, *Operator Algebras: Theory of C*-Algebras and von Neumann Algebras*, §II.7.3.
* Gerd K. Pedersen, *C*-Algebras and their Automorphism Groups*, §3.12.
* E. C. Lance, *Hilbert C*-Modules*, London Math. Soc. Lecture Note Series 210, Chapter 2.
-/

@[expose] public section

open Filter Topology
open scoped MultiplierAlgebra ENNReal

namespace TauCeti

/-- The type copy of the multiplier algebra `𝓜(𝕜, A)` equipped with the strict topology: the
coarsest topology for which `m ↦ m.fst a` and `m ↦ m.snd a` are continuous into `A` for every
`a : A`. -/
@[ext]
structure DoubleCentralizerStrict (𝕜 A : Type*) [NontriviallyNormedField 𝕜]
    [NonUnitalNormedRing A] [NormedSpace 𝕜 A] [SMulCommClass 𝕜 A A] [IsScalarTower 𝕜 A A] where
  /-- Regard a multiplier as an element of the strict-topology copy. -/
  ofDoubleCentralizer ::
  /-- The underlying multiplier in `𝓜(𝕜, A)`. -/
  toDoubleCentralizer : 𝓜(𝕜, A)

@[inherit_doc]
scoped[MultiplierAlgebra] notation "𝓜ₛ(" 𝕜 ", " A ")" => TauCeti.DoubleCentralizerStrict 𝕜 A

namespace DoubleCentralizerStrict

section Algebra

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜] [NonUnitalNormedRing A] [NormedSpace 𝕜 A]
  [SMulCommClass 𝕜 A A] [IsScalarTower 𝕜 A A]

/-- The equivalence between the strict-topology copy `𝓜ₛ(𝕜, A)` and `𝓜(𝕜, A)`. -/
@[simps]
def equiv : 𝓜ₛ(𝕜, A) ≃ 𝓜(𝕜, A) where
  toFun := toDoubleCentralizer
  invFun := ofDoubleCentralizer
  left_inv _ := rfl
  right_inv _ := rfl

theorem toDoubleCentralizer_injective :
    Function.Injective (toDoubleCentralizer : 𝓜ₛ(𝕜, A) → 𝓜(𝕜, A)) := equiv.injective

theorem ofDoubleCentralizer_injective :
    Function.Injective (ofDoubleCentralizer : 𝓜(𝕜, A) → 𝓜ₛ(𝕜, A)) := equiv.symm.injective

@[simp] theorem ofDoubleCentralizer_toDoubleCentralizer (m : 𝓜ₛ(𝕜, A)) :
    ofDoubleCentralizer m.toDoubleCentralizer = m := rfl

@[simp] theorem toDoubleCentralizer_ofDoubleCentralizer (m : 𝓜(𝕜, A)) :
    (ofDoubleCentralizer m).toDoubleCentralizer = m := rfl

instance instInhabited : Inhabited 𝓜ₛ(𝕜, A) := ⟨ofDoubleCentralizer 0⟩
instance instRing : Ring 𝓜ₛ(𝕜, A) := equiv.ring

/-- The additive equivalence between `𝓜ₛ(𝕜, A)` and `𝓜(𝕜, A)`. -/
@[implicit_reducible, simps!]
def addEquiv : 𝓜ₛ(𝕜, A) ≃+ 𝓜(𝕜, A) where
  __ := equiv
  map_add' _ _ := rfl

/-- The ring equivalence between `𝓜ₛ(𝕜, A)` and `𝓜(𝕜, A)`. -/
@[implicit_reducible, simps!]
def ringEquiv : 𝓜ₛ(𝕜, A) ≃+* 𝓜(𝕜, A) := equiv.ringEquiv

instance instSMul {S : Type*} [SMul S 𝓜(𝕜, A)] : SMul S 𝓜ₛ(𝕜, A) := equiv.smul S

instance instModule {S : Type*} [Semiring S] [Module S 𝓜(𝕜, A)] : Module S 𝓜ₛ(𝕜, A) :=
  addEquiv.module S

instance instIsScalarTower {S T : Type*} [SMul S 𝓜(𝕜, A)] [SMul T 𝓜(𝕜, A)] [SMul S T]
    [IsScalarTower S T 𝓜(𝕜, A)] : IsScalarTower S T 𝓜ₛ(𝕜, A) := equiv.isScalarTower S T

instance instSMulCommClass {S T : Type*} [SMul S 𝓜(𝕜, A)] [SMul T 𝓜(𝕜, A)]
    [SMulCommClass S T 𝓜(𝕜, A)] : SMulCommClass S T 𝓜ₛ(𝕜, A) where
  smul_comm s t m := toDoubleCentralizer_injective <| smul_comm s t m.toDoubleCentralizer

instance instAlgebra : Algebra 𝕜 𝓜ₛ(𝕜, A) where
  toSMul := inferInstance
  algebraMap := ringEquiv.symm.toRingHom.comp (algebraMap 𝕜 𝓜(𝕜, A))
  commutes' c m := toDoubleCentralizer_injective <| Algebra.commutes c m.toDoubleCentralizer
  smul_def' c m := toDoubleCentralizer_injective <| Algebra.smul_def c m.toDoubleCentralizer

@[simp] theorem toDoubleCentralizer_zero : (0 : 𝓜ₛ(𝕜, A)).toDoubleCentralizer = 0 := rfl
@[simp] theorem toDoubleCentralizer_one : (1 : 𝓜ₛ(𝕜, A)).toDoubleCentralizer = 1 := rfl
@[simp] theorem toDoubleCentralizer_add (m n : 𝓜ₛ(𝕜, A)) :
    (m + n).toDoubleCentralizer = m.toDoubleCentralizer + n.toDoubleCentralizer := rfl
@[simp] theorem toDoubleCentralizer_neg (m : 𝓜ₛ(𝕜, A)) :
    (-m).toDoubleCentralizer = -m.toDoubleCentralizer := rfl
@[simp] theorem toDoubleCentralizer_sub (m n : 𝓜ₛ(𝕜, A)) :
    (m - n).toDoubleCentralizer = m.toDoubleCentralizer - n.toDoubleCentralizer := rfl
@[simp] theorem toDoubleCentralizer_mul (m n : 𝓜ₛ(𝕜, A)) :
    (m * n).toDoubleCentralizer = m.toDoubleCentralizer * n.toDoubleCentralizer := rfl
@[simp] theorem toDoubleCentralizer_pow (m : 𝓜ₛ(𝕜, A)) (k : ℕ) :
    (m ^ k).toDoubleCentralizer = m.toDoubleCentralizer ^ k := rfl
@[simp] theorem toDoubleCentralizer_smul {S : Type*} [SMul S 𝓜(𝕜, A)] (c : S) (m : 𝓜ₛ(𝕜, A)) :
    (c • m).toDoubleCentralizer = c • m.toDoubleCentralizer := rfl
@[simp] theorem toDoubleCentralizer_algebraMap (c : 𝕜) :
    (algebraMap 𝕜 𝓜ₛ(𝕜, A) c).toDoubleCentralizer = algebraMap 𝕜 𝓜(𝕜, A) c := rfl

/-- The linear equivalence between `𝓜ₛ(𝕜, A)` and `𝓜(𝕜, A)`. -/
@[simps!]
def linearEquiv (S : Type*) [Semiring S] [Module S 𝓜(𝕜, A)] : 𝓜ₛ(𝕜, A) ≃ₗ[S] 𝓜(𝕜, A) :=
  (addEquiv (𝕜 := 𝕜) (A := A)).linearEquiv S

/-- The `𝕜`-algebra equivalence between `𝓜ₛ(𝕜, A)` and `𝓜(𝕜, A)`. -/
@[simps!]
def algEquiv : 𝓜ₛ(𝕜, A) ≃ₐ[𝕜] 𝓜(𝕜, A) where
  __ := ringEquiv (𝕜 := 𝕜) (A := A)
  commutes' _ := rfl

variable (𝕜) in
/-- The canonical inclusion of `A` into `𝓜ₛ(𝕜, A)`. -/
@[coe] noncomputable def coe (a : A) : 𝓜ₛ(𝕜, A) := ofDoubleCentralizer (a : 𝓜(𝕜, A))

noncomputable instance instCoeTC : CoeTC A 𝓜ₛ(𝕜, A) := ⟨DoubleCentralizerStrict.coe 𝕜⟩

@[simp] theorem toDoubleCentralizer_coe (a : A) :
    ((a : 𝓜ₛ(𝕜, A))).toDoubleCentralizer = (a : 𝓜(𝕜, A)) := rfl

@[simp, norm_cast] theorem ofDoubleCentralizer_coe (a : A) :
    ofDoubleCentralizer (a : 𝓜(𝕜, A)) = (a : 𝓜ₛ(𝕜, A)) := rfl

@[simp, norm_cast] theorem coe_zero : ((0 : A) : 𝓜ₛ(𝕜, A)) = 0 :=
  toDoubleCentralizer_injective DoubleCentralizer.coe_zero

@[simp, norm_cast] theorem coe_add (a b : A) : ((a + b : A) : 𝓜ₛ(𝕜, A)) = (a : 𝓜ₛ(𝕜, A)) + b :=
  toDoubleCentralizer_injective (DoubleCentralizer.coe_add a b)

@[simp, norm_cast] theorem coe_neg (a : A) : ((-a : A) : 𝓜ₛ(𝕜, A)) = -(a : 𝓜ₛ(𝕜, A)) :=
  toDoubleCentralizer_injective (DoubleCentralizer.coe_neg a)

@[simp, norm_cast] theorem coe_sub (a b : A) : ((a - b : A) : 𝓜ₛ(𝕜, A)) = (a : 𝓜ₛ(𝕜, A)) - b :=
  toDoubleCentralizer_injective (DoubleCentralizer.coe_sub a b)

@[simp, norm_cast] theorem coe_mul (a b : A) : ((a * b : A) : 𝓜ₛ(𝕜, A)) = (a : 𝓜ₛ(𝕜, A)) * b :=
  toDoubleCentralizer_injective (DoubleCentralizer.coe_mul a b)

@[simp, norm_cast] theorem coe_smul (c : 𝕜) (a : A) :
    ((c • a : A) : 𝓜ₛ(𝕜, A)) = c • (a : 𝓜ₛ(𝕜, A)) :=
  toDoubleCentralizer_injective (DoubleCentralizer.coe_smul c a)

section Star

variable [StarRing 𝕜] [StarRing A] [StarModule 𝕜 A] [NormedStarGroup A]

instance instStar : Star 𝓜ₛ(𝕜, A) := ⟨fun m => ofDoubleCentralizer (star m.toDoubleCentralizer)⟩

@[simp] theorem toDoubleCentralizer_star (m : 𝓜ₛ(𝕜, A)) :
    (star m).toDoubleCentralizer = star m.toDoubleCentralizer := rfl

@[simp] theorem ofDoubleCentralizer_star (m : 𝓜(𝕜, A)) :
    ofDoubleCentralizer (star m) = star (ofDoubleCentralizer m) := rfl

instance instStarAddMonoid : StarAddMonoid 𝓜ₛ(𝕜, A) where
  star_involutive m := toDoubleCentralizer_injective <| star_star m.toDoubleCentralizer
  star_add m n := toDoubleCentralizer_injective <| star_add m.toDoubleCentralizer
    n.toDoubleCentralizer

instance instStarRing : StarRing 𝓜ₛ(𝕜, A) where
  __ := instStarAddMonoid
  star_mul m n := toDoubleCentralizer_injective <| star_mul m.toDoubleCentralizer
    n.toDoubleCentralizer

instance instStarModule : StarModule 𝕜 𝓜ₛ(𝕜, A) where
  star_smul c m := toDoubleCentralizer_injective <| star_smul c m.toDoubleCentralizer

/-- The unital `⋆`-algebra equivalence between `𝓜ₛ(𝕜, A)` and `𝓜(𝕜, A)`. -/
@[simps!]
def starAlgEquiv : 𝓜ₛ(𝕜, A) ≃⋆ₐ[𝕜] 𝓜(𝕜, A) where
  __ := algEquiv (𝕜 := 𝕜) (A := A)
  map_smul' _ _ := rfl
  map_star' _ := rfl

@[simp, norm_cast] theorem coe_star (a : A) : ((star a : A) : 𝓜ₛ(𝕜, A)) = star (a : 𝓜ₛ(𝕜, A)) :=
  toDoubleCentralizer_injective (DoubleCentralizer.coe_star a)

/-- The canonical inclusion `A →⋆ₙₐ[𝕜] 𝓜ₛ(𝕜, A)` as a nonunital `⋆`-algebra homomorphism. -/
@[no_expose] noncomputable def coeHom : A →⋆ₙₐ[𝕜] 𝓜ₛ(𝕜, A) :=
  starAlgEquiv.symm.toNonUnitalStarAlgHom.comp DoubleCentralizer.coeHom

@[simp] theorem coeHom_apply (a : A) : (coeHom a : 𝓜ₛ(𝕜, A)) = (a : 𝓜ₛ(𝕜, A)) := (rfl)

end Star

end Algebra

/-! ### The strict topology and uniform structure -/

section Topology

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜] [NonUnitalNormedRing A] [NormedSpace 𝕜 A]
  [SMulCommClass 𝕜 A A] [IsScalarTower 𝕜 A A]

variable (𝕜 A) in
/-- The linear map inducing the strict topology: `m` is sent to `a ↦ (m.fst a, m.snd a)` valued in
the `L¹`-product `WithLp 1 (A × A)`. -/
@[no_expose] noncomputable def inducingFn : 𝓜ₛ(𝕜, A) →ₗ[𝕜] (A → WithLp 1 (A × A)) where
  toFun m a := WithLp.toLp 1 (m.toDoubleCentralizer.fst a, m.toDoubleCentralizer.snd a)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp] theorem inducingFn_apply (m : 𝓜ₛ(𝕜, A)) (a : A) :
    inducingFn 𝕜 A m a = WithLp.toLp 1 (m.toDoubleCentralizer.fst a, m.toDoubleCentralizer.snd a) :=
  (rfl)

theorem inducingFn_injective : Function.Injective (inducingFn 𝕜 A) := fun _ _ h =>
  toDoubleCentralizer_injective <| DoubleCentralizer.ext_fst_snd
    (fun a => congrArg Prod.fst (WithLp.toLp_injective 1 (congrFun h a)))
    (fun a => congrArg Prod.snd (WithLp.toLp_injective 1 (congrFun h a)))

/-- The strict topology on `𝓜ₛ(𝕜, A)`, induced by `inducingFn 𝕜 A`. -/
noncomputable instance instTopologicalSpace : TopologicalSpace 𝓜ₛ(𝕜, A) :=
  .induced (inducingFn 𝕜 A) Pi.topologicalSpace

/-- The strict uniform structure on `𝓜ₛ(𝕜, A)`, pulled back along `inducingFn 𝕜 A`. -/
noncomputable instance instUniformSpace : UniformSpace 𝓜ₛ(𝕜, A) :=
  .comap (inducingFn 𝕜 A) inferInstance

theorem isInducing_inducingFn : IsInducing (inducingFn 𝕜 A) := ⟨rfl⟩
theorem isEmbedding_inducingFn : IsEmbedding (inducingFn 𝕜 A) :=
  inducingFn_injective.isEmbedding_induced
theorem isUniformInducing_inducingFn : IsUniformInducing (inducingFn 𝕜 A) := ⟨rfl⟩
theorem isUniformEmbedding_inducingFn : IsUniformEmbedding (inducingFn 𝕜 A) :=
  ⟨isUniformInducing_inducingFn, inducingFn_injective⟩

@[fun_prop] theorem continuous_fst_apply (a : A) :
    Continuous fun m : 𝓜ₛ(𝕜, A) => m.toDoubleCentralizer.fst a :=
  (WithLp.continuous_fst 1 A A).comp <| (continuous_apply a).comp isInducing_inducingFn.continuous

@[fun_prop] theorem continuous_snd_apply (a : A) :
    Continuous fun m : 𝓜ₛ(𝕜, A) => m.toDoubleCentralizer.snd a :=
  (WithLp.continuous_snd 1 A A).comp <| (continuous_apply a).comp isInducing_inducingFn.continuous

theorem continuous_of_continuous_fst_snd {α : Type*} [TopologicalSpace α] {g : α → 𝓜ₛ(𝕜, A)}
    (h₁ : ∀ a : A, Continuous fun x => (g x).toDoubleCentralizer.fst a)
    (h₂ : ∀ a : A, Continuous fun x => (g x).toDoubleCentralizer.snd a) : Continuous g :=
  continuous_induced_rng.2 <| continuous_pi fun a =>
    (WithLp.prod_continuous_toLp 1 A A).comp ((h₁ a).prodMk (h₂ a))

/-- **Strict convergence criterion.** A filter `f` converges strictly to `m` if and only if
`(f x).fst a → m.fst a` and `(f x).snd a → m.snd a` in `A` for every `a : A`. -/
theorem tendsto_iff_forall_tendsto {α : Type*} {l : Filter α} {f : α → 𝓜ₛ(𝕜, A)} {m : 𝓜ₛ(𝕜, A)} :
    Tendsto f l (𝓝 m) ↔
      (∀ a : A, Tendsto (fun x => (f x).toDoubleCentralizer.fst a) l
        (𝓝 (m.toDoubleCentralizer.fst a))) ∧
      (∀ a : A, Tendsto (fun x => (f x).toDoubleCentralizer.snd a) l
        (𝓝 (m.toDoubleCentralizer.snd a))) := by
  refine ⟨fun h => ⟨fun a => ((continuous_fst_apply a).tendsto m).comp h,
      fun a => ((continuous_snd_apply a).tendsto m).comp h⟩, fun ⟨h₁, h₂⟩ => ?_⟩
  rw [isInducing_inducingFn.tendsto_nhds_iff, tendsto_pi_nhds]
  exact fun a => ((WithLp.prod_continuous_toLp 1 A A).tendsto _).comp ((h₁ a).prodMk_nhds (h₂ a))

instance instT3Space : T3Space 𝓜ₛ(𝕜, A) := isEmbedding_inducingFn.t3Space

instance instIsTopologicalAddGroup : IsTopologicalAddGroup 𝓜ₛ(𝕜, A) where
  toContinuousAdd := .induced (inducingFn 𝕜 A)
  toContinuousNeg := .induced (inducingFn 𝕜 A)

instance instContinuousSMul : ContinuousSMul 𝕜 𝓜ₛ(𝕜, A) := .induced (inducingFn 𝕜 A)
instance instIsUniformAddGroup : IsUniformAddGroup 𝓜ₛ(𝕜, A) := .comap (inducingFn 𝕜 A)

instance instContinuousStar [StarRing 𝕜] [StarRing A] [StarModule 𝕜 A] [NormedStarGroup A] :
    ContinuousStar 𝓜ₛ(𝕜, A) where
  continuous_star := continuous_of_continuous_fst_snd
    (fun a => continuous_star.comp (continuous_snd_apply (star a)))
    (fun a => continuous_star.comp (continuous_fst_apply (star a)))

instance instIsSemitopologicalRing : IsSemitopologicalRing 𝓜ₛ(𝕜, A) where
  continuous_const_mul {m} := continuous_of_continuous_fst_snd
    (fun a => m.toDoubleCentralizer.fst.continuous.comp (continuous_fst_apply a))
    (fun a => continuous_snd_apply (m.toDoubleCentralizer.snd a))
  continuous_mul_const {m} := continuous_of_continuous_fst_snd
    (fun a => continuous_fst_apply (m.toDoubleCentralizer.fst a))
    (fun a => m.toDoubleCentralizer.snd.continuous.comp (continuous_snd_apply a))

end Topology

/-! ### The strict seminorms -/

section Seminorms

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜] [NonUnitalNormedRing A] [NormedSpace 𝕜 A]
  [SMulCommClass 𝕜 A A] [IsScalarTower 𝕜 A A]

/-- The strict seminorm `m ↦ ‖m.fst a‖ + ‖m.snd a‖` attached to `a : A`. -/
@[no_expose] noncomputable def seminorm (a : A) : Seminorm 𝕜 𝓜ₛ(𝕜, A) where
  toFun m := ‖m.toDoubleCentralizer.fst a‖ + ‖m.toDoubleCentralizer.snd a‖
  map_zero' := by simp
  add_le' m n := by
    simpa [add_add_add_comm] using add_le_add
      (norm_add_le (m.toDoubleCentralizer.fst a) (n.toDoubleCentralizer.fst a))
      (norm_add_le (m.toDoubleCentralizer.snd a) (n.toDoubleCentralizer.snd a))
  neg' _ := by simp
  smul' _ _ := by simp [norm_smul, mul_add]

@[simp] theorem seminorm_apply (a : A) (m : 𝓜ₛ(𝕜, A)) :
    seminorm a m = ‖m.toDoubleCentralizer.fst a‖ + ‖m.toDoubleCentralizer.snd a‖ := (rfl)

theorem seminorm_apply_eq_norm_inducingFn (a : A) (m : 𝓜ₛ(𝕜, A)) :
    seminorm a m = ‖inducingFn 𝕜 A m a‖ := by
  rw [seminorm_apply, inducingFn_apply, WithLp.prod_norm_eq_of_L1]; rfl

/-- For a regular normed algebra with zero left and right annihilators (including every
C⋆-algebra), the strict seminorm at `a` equals `‖m * a‖ + ‖a * m‖`. -/
theorem seminorm_apply_eq_norm_mul_add_norm_mul [RegularNormedAlgebra 𝕜 A]
    [FaithfulSMul Aᵐᵒᵖ A] [FaithfulSMul A A] (a : A) (m : 𝓜ₛ(𝕜, A)) :
    seminorm a m =
      ‖m.toDoubleCentralizer * (a : 𝓜(𝕜, A))‖ + ‖(a : 𝓜(𝕜, A)) * m.toDoubleCentralizer‖ := by
  rw [seminorm_apply, DoubleCentralizer.mul_coe_eq_coe_fst, DoubleCentralizer.coe_mul_eq_coe_snd,
    DoubleCentralizer.norm_coe, DoubleCentralizer.norm_coe]

theorem seminorm_le_two_mul_norm (a : A) (m : 𝓜ₛ(𝕜, A)) :
    seminorm a m ≤ 2 * ‖m.toDoubleCentralizer‖ * ‖a‖ := by
  have h₁ := (m.toDoubleCentralizer.fst.le_opNorm a).trans
    (mul_le_mul_of_nonneg_right m.toDoubleCentralizer.norm_fst_le (norm_nonneg a))
  have h₂ := (m.toDoubleCentralizer.snd.le_opNorm a).trans
    (mul_le_mul_of_nonneg_right m.toDoubleCentralizer.norm_snd_le (norm_nonneg a))
  linarith [seminorm_apply a m]

variable (𝕜 A) in
/-- The `A`-indexed family of seminorms generating the strict topology on `𝓜ₛ(𝕜, A)`. -/
@[no_expose] noncomputable def seminormFamily : SeminormFamily 𝕜 𝓜ₛ(𝕜, A) A := seminorm

@[simp] theorem seminormFamily_apply (a : A) : seminormFamily 𝕜 A a = seminorm a := (rfl)

theorem withSeminorms : WithSeminorms (seminormFamily 𝕜 A) := by
  let e : A ≃ (Σ _ : A, Unit) := .symm <| .sigmaUnique _ _
  convert (isInducing_inducingFn.withSeminorms
    (withSeminorms_pi fun _ => norm_withSeminorms 𝕜 (WithLp 1 (A × A)))).congr_equiv e using 1
  ext a m; exact seminorm_apply_eq_norm_inducingFn a m

instance instLocallyConvexSpace [NormedSpace ℝ 𝕜] [Module ℝ 𝓜ₛ(𝕜, A)]
    [IsScalarTower ℝ 𝕜 𝓜ₛ(𝕜, A)] : LocallyConvexSpace ℝ 𝓜ₛ(𝕜, A) :=
  withSeminorms.toLocallyConvexSpace

end Seminorms

/-! ### Joint continuity of multiplication on norm-bounded filters and sets -/

section BoundedMul

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜] [NonUnitalNormedRing A] [NormedSpace 𝕜 A]
  [SMulCommClass 𝕜 A A] [IsScalarTower 𝕜 A A]

/-- **Joint strict continuity of multiplication on norm-bounded filters.** If `f → m` and `g → n`
strictly along `l` and both `f` and `g` are eventually bounded in operator norm along `l`, then
`f * g → m * n` strictly along `l`. -/
theorem tendsto_mul_of_eventually_norm_le {α : Type*} {l : Filter α} {f g : α → 𝓜ₛ(𝕜, A)}
    {m n : 𝓜ₛ(𝕜, A)} {C D : ℝ} (hf : Tendsto f l (𝓝 m)) (hg : Tendsto g l (𝓝 n))
    (hCf : ∀ᶠ i in l, ‖(f i).toDoubleCentralizer‖ ≤ C)
    (hDg : ∀ᶠ i in l, ‖(g i).toDoubleCentralizer‖ ≤ D) :
    Tendsto (fun i => f i * g i) l (𝓝 (m * n)) := by
  obtain ⟨hf₁, hf₂⟩ := tendsto_iff_forall_tendsto.mp hf
  obtain ⟨hg₁, hg₂⟩ := tendsto_iff_forall_tendsto.mp hg
  rw [tendsto_iff_forall_tendsto]
  simp only [toDoubleCentralizer_mul, DoubleCentralizer.mul_fst, DoubleCentralizer.mul_snd,
    mul_apply_eq_comp]
  exact ⟨fun a => ContinuousLinearMap.tendsto_apply_of_eventually_norm_le
      (hCf.mono fun i hi => (f i).toDoubleCentralizer.norm_fst_le.trans hi)
      (hf₁ (n.toDoubleCentralizer.fst a)) (hg₁ a),
    fun a => ContinuousLinearMap.tendsto_apply_of_eventually_norm_le
      (hDg.mono fun i hi => (g i).toDoubleCentralizer.norm_snd_le.trans hi)
      (hg₂ (m.toDoubleCentralizer.snd a)) (hf₂ a)⟩

/-- Multiplication on `𝓜ₛ(𝕜, A)` is jointly strictly continuous on products of closed operator-norm
balls. -/
theorem continuousOn_mul_norm_le (C D : ℝ) :
    ContinuousOn (fun p : 𝓜ₛ(𝕜, A) × 𝓜ₛ(𝕜, A) => p.1 * p.2)
      ({m | ‖m.toDoubleCentralizer‖ ≤ C} ×ˢ {n | ‖n.toDoubleCentralizer‖ ≤ D}) := fun _ _ =>
  tendsto_mul_of_eventually_norm_le continuous_fst.continuousWithinAt
    continuous_snd.continuousWithinAt (eventually_nhdsWithin_of_forall fun _ hq => hq.1)
    (eventually_nhdsWithin_of_forall fun _ hq => hq.2)

/-- Multiplication on `𝓜ₛ(𝕜, A)` is jointly strictly continuous on `s ×ˢ t` whenever `s` and `t`
have norm-bounded images in `𝓜(𝕜, A)`. -/
theorem continuousOn_mul_of_isBounded {s t : Set 𝓜ₛ(𝕜, A)}
    (hs : Bornology.IsBounded (toDoubleCentralizer '' s))
    (ht : Bornology.IsBounded (toDoubleCentralizer '' t)) :
    ContinuousOn (fun p : 𝓜ₛ(𝕜, A) × 𝓜ₛ(𝕜, A) => p.1 * p.2) (s ×ˢ t) := by
  obtain ⟨C, hC⟩ := hs.subset_closedBall 0
  obtain ⟨D, hD⟩ := ht.subset_closedBall 0
  exact (continuousOn_mul_norm_le C D).mono fun ⟨m, n⟩ ⟨hm, hn⟩ =>
    ⟨by simpa using hC ⟨m, hm, rfl⟩, by simpa using hD ⟨n, hn, rfl⟩⟩

end BoundedMul

/-! ### Comparison with the norm topology and the unital case -/

section Comparison

section General

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜] [NonUnitalNormedRing A] [NormedSpace 𝕜 A]
  [SMulCommClass 𝕜 A A] [IsScalarTower 𝕜 A A]

/-- The strict topology is coarser than the operator-norm topology on `𝓜(𝕜, A)`. -/
@[fun_prop] theorem continuous_ofDoubleCentralizer :
    Continuous (ofDoubleCentralizer : 𝓜(𝕜, A) → 𝓜ₛ(𝕜, A)) :=
  continuous_of_continuous_fst_snd
    (fun a => (ContinuousLinearMap.apply 𝕜 A a).continuous.comp
      (continuous_fst.comp DoubleCentralizer.continuous_toProd))
    (fun a => (ContinuousLinearMap.apply 𝕜 A a).continuous.comp
      (continuous_snd.comp DoubleCentralizer.continuous_toProd))

theorem uniformContinuous_ofDoubleCentralizer :
    UniformContinuous (ofDoubleCentralizer : 𝓜(𝕜, A) → 𝓜ₛ(𝕜, A)) :=
  uniformContinuous_of_continuousAt_zero addEquiv.symm continuous_ofDoubleCentralizer.continuousAt

/-- The canonical inclusion `A → 𝓜ₛ(𝕜, A)` is norm-to-strict continuous. -/
@[fun_prop] theorem continuous_coe : Continuous (DoubleCentralizerStrict.coe 𝕜 : A → 𝓜ₛ(𝕜, A)) :=
  continuous_of_continuous_fst_snd continuous_mul_const continuous_const_mul

end General

section Unital

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜] [NormedRing A] [NormedAlgebra 𝕜 A]

@[simp, norm_cast] theorem coe_one : ((1 : A) : 𝓜ₛ(𝕜, A)) = 1 :=
  toDoubleCentralizer_injective DoubleCentralizer.coe_one

/-- When `A` is unital, the norm topology on `𝓜(𝕜, A)` is coarser than (hence equal to) the strict
topology, because `m = ↑(m.fst 1)`. -/
@[fun_prop] theorem continuous_toDoubleCentralizer :
    Continuous (toDoubleCentralizer : 𝓜ₛ(𝕜, A) → 𝓜(𝕜, A)) :=
  ((AddMonoidHomClass.continuous_of_bound (DoubleCentralizer.ofUnitalAlgEquiv 𝕜 A).toLinearMap 1
      fun a => by simpa using DoubleCentralizer.norm_coe_le (𝕜 := 𝕜) a).comp
    (continuous_fst_apply (𝕜 := 𝕜) (1 : A))).congr fun m => by simp

theorem uniformContinuous_toDoubleCentralizer :
    UniformContinuous (toDoubleCentralizer : 𝓜ₛ(𝕜, A) → 𝓜(𝕜, A)) :=
  uniformContinuous_of_continuousAt_zero addEquiv continuous_toDoubleCentralizer.continuousAt

variable (𝕜 A) in
/-- When `A` is unital, the strict topology and the norm topology on `𝓜(𝕜, A)` coincide via a
uniform equivalence. -/
@[no_expose] noncomputable def uniformEquivDoubleCentralizer : 𝓜ₛ(𝕜, A) ≃ᵤ 𝓜(𝕜, A) where
  __ := equiv
  uniformContinuous_toFun := uniformContinuous_toDoubleCentralizer
  uniformContinuous_invFun := uniformContinuous_ofDoubleCentralizer

@[simp] theorem uniformEquivDoubleCentralizer_apply (m : 𝓜ₛ(𝕜, A)) :
    uniformEquivDoubleCentralizer 𝕜 A m = m.toDoubleCentralizer := (rfl)

@[simp] theorem uniformEquivDoubleCentralizer_symm_apply (m : 𝓜(𝕜, A)) :
    (uniformEquivDoubleCentralizer 𝕜 A).symm m = ofDoubleCentralizer m := (rfl)

variable (𝕜 A) in
/-- When `A` is unital, the strict topology and the norm topology on `𝓜(𝕜, A)` coincide via a
homeomorphism. -/
@[no_expose] noncomputable def homeomorphDoubleCentralizer : 𝓜ₛ(𝕜, A) ≃ₜ 𝓜(𝕜, A) :=
  (uniformEquivDoubleCentralizer 𝕜 A).toHomeomorph

@[simp] theorem homeomorphDoubleCentralizer_apply (m : 𝓜ₛ(𝕜, A)) :
    homeomorphDoubleCentralizer 𝕜 A m = m.toDoubleCentralizer := (rfl)

@[simp] theorem homeomorphDoubleCentralizer_symm_apply (m : 𝓜(𝕜, A)) :
    (homeomorphDoubleCentralizer 𝕜 A).symm m = ofDoubleCentralizer m := (rfl)

end Unital

end Comparison

/-! ### Closedness of norm balls and strict completeness -/

section Completeness

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜] [NonUnitalNormedRing A] [NormedSpace 𝕜 A]
  [SMulCommClass 𝕜 A A] [IsScalarTower 𝕜 A A]

private theorem continuous_eval_fst (x : A) :
    Continuous fun f : A → WithLp 1 (A × A) => (f x).fst :=
  (WithLp.continuous_fst 1 A A).comp (continuous_apply x)

private theorem continuous_eval_snd (x : A) :
    Continuous fun f : A → WithLp 1 (A × A) => (f x).snd :=
  (WithLp.continuous_snd 1 A A).comp (continuous_apply x)

/-- Every closed operator-norm ball `{m : 𝓜ₛ(𝕜, A) | ‖m.toDoubleCentralizer‖ ≤ C}` is strictly
closed. -/
theorem isClosed_norm_le (C : ℝ) : IsClosed {m : 𝓜ₛ(𝕜, A) | ‖m.toDoubleCentralizer‖ ≤ C} := by
  by_cases hC : 0 ≤ C
  · have hset : {m : 𝓜ₛ(𝕜, A) | ‖m.toDoubleCentralizer‖ ≤ C} =
        (⋂ a : A, {m | ‖m.toDoubleCentralizer.fst a‖ ≤ C * ‖a‖}) ∩
        (⋂ a : A, {m | ‖m.toDoubleCentralizer.snd a‖ ≤ C * ‖a‖}) := by
      ext m
      simp only [Set.mem_ofPred, Set.mem_inter_iff, Set.mem_iInter, DoubleCentralizer.norm_def,
        DoubleCentralizer.toProdHom_apply, Prod.norm_def, max_le_iff,
        ContinuousLinearMap.opNorm_le_iff hC]
    rw [hset]
    exact (isClosed_iInter fun a =>
        isClosed_le (continuous_norm.comp (continuous_fst_apply a)) continuous_const).inter
      (isClosed_iInter fun a =>
        isClosed_le (continuous_norm.comp (continuous_snd_apply a)) continuous_const)
  · have hempty : {m : 𝓜ₛ(𝕜, A) | ‖m.toDoubleCentralizer‖ ≤ C} = ∅ :=
      Set.eq_empty_of_forall_notMem fun _ hm => hC ((norm_nonneg _).trans hm)
    exact hempty ▸ isClosed_empty

private theorem isClosed_range_inducingFn [CompleteSpace A] [FaithfulSMul Aᵐᵒᵖ A]
    [FaithfulSMul A A] : IsClosed (Set.range (inducingFn 𝕜 A)) := by
  convert isClosed_iInter fun x : A => isClosed_iInter fun y : A =>
    isClosed_eq ((continuous_eval_snd x).mul_const y) ((continuous_eval_fst y).const_mul x) using 1
  ext f
  simp only [Set.mem_range, Set.mem_iInter, Set.mem_ofPred]
  refine ⟨by rintro ⟨m, rfl⟩ x y; exact m.toDoubleCentralizer.central x y, fun h =>
    ⟨ofDoubleCentralizer (DoubleCentralizer.ofCentral 𝕜 (fun a => (f a).fst)
      (fun a => (f a).snd) h), ?_⟩⟩
  ext a : 1
  simp only [inducingFn_apply, DoubleCentralizer.coe_ofCentral_fst,
    DoubleCentralizer.coe_ofCentral_snd]
  exact WithLp.toLp_ofLp 1 (f a)

/-- **Global strict completeness (Busby 1968, Prop. 3.6; Pedersen 3.12.5).** If `A` is a complete
normed algebra with zero left and right annihilators (in particular, if `A` is any C⋆-algebra),
then `𝓜ₛ(𝕜, A)` is a complete uniform space in the strict uniformity. -/
instance instCompleteSpace [CompleteSpace A] [FaithfulSMul Aᵐᵒᵖ A] [FaithfulSMul A A] :
    CompleteSpace 𝓜ₛ(𝕜, A) :=
  (completeSpace_iff_isComplete_range isUniformInducing_inducingFn).2
    isClosed_range_inducingFn.isComplete

private theorem mem_image_inducingFn_norm_le_iff {C : ℝ} (hC : 0 ≤ C)
    {f : A → WithLp 1 (A × A)} :
    f ∈ inducingFn 𝕜 A '' {m : 𝓜ₛ(𝕜, A) | ‖m.toDoubleCentralizer‖ ≤ C} ↔
      (∀ x y, (f (x + y)).fst = (f x).fst + (f y).fst ∧
        (f (x + y)).snd = (f x).snd + (f y).snd) ∧
      (∀ (c : 𝕜) x, (f (c • x)).fst = c • (f x).fst ∧
        (f (c • x)).snd = c • (f x).snd) ∧
      (∀ x, ‖(f x).fst‖ ≤ C * ‖x‖ ∧ ‖(f x).snd‖ ≤ C * ‖x‖) ∧
      (∀ x y, (f x).snd * y = x * (f y).fst) := by
  refine ⟨?_, fun ⟨hadd, hsmul, hbd, hcent⟩ => ?_⟩
  · rintro ⟨m, hm, rfl⟩
    simp only [Set.mem_ofPred, DoubleCentralizer.norm_def, DoubleCentralizer.toProdHom_apply,
      Prod.norm_def, max_le_iff] at hm
    exact ⟨fun x y => ⟨map_add _ x y, map_add _ x y⟩, fun c x => ⟨map_smul _ c x, map_smul _ c x⟩,
      fun x => ⟨(m.toDoubleCentralizer.fst.le_opNorm x).trans
          (mul_le_mul_of_nonneg_right hm.1 (norm_nonneg x)),
        (m.toDoubleCentralizer.snd.le_opNorm x).trans
          (mul_le_mul_of_nonneg_right hm.2 (norm_nonneg x))⟩, m.toDoubleCentralizer.central⟩
  · let L : A →L[𝕜] A := LinearMap.mkContinuous
      ⟨⟨fun x => (f x).fst, fun x y => (hadd x y).1⟩, fun c x => (hsmul c x).1⟩ C fun x => (hbd x).1
    let R : A →L[𝕜] A := LinearMap.mkContinuous
      ⟨⟨fun x => (f x).snd, fun x y => (hadd x y).2⟩, fun c x => (hsmul c x).2⟩ C fun x => (hbd x).2
    refine ⟨ofDoubleCentralizer ⟨(L, R), hcent⟩, ?_, funext fun a => WithLp.toLp_ofLp 1 (f a)⟩
    simp only [Set.mem_ofPred, DoubleCentralizer.norm_def, DoubleCentralizer.toProdHom_apply,
      Prod.norm_def, max_le_iff]
    exact ⟨LinearMap.mkContinuous_norm_le _ hC _, LinearMap.mkContinuous_norm_le _ hC _⟩

/-- **Bounded-set strict completeness.** If `A` is complete, every closed operator-norm ball in
`𝓜ₛ(𝕜, A)` is strictly complete (even without zero-annihilator hypotheses on `A`). -/
theorem isComplete_norm_le [CompleteSpace A] (C : ℝ) :
    IsComplete {m : 𝓜ₛ(𝕜, A) | ‖m.toDoubleCentralizer‖ ≤ C} := by
  by_cases hC : 0 ≤ C
  · rw [← isUniformInducing_inducingFn.isComplete_iff]
    refine IsClosed.isComplete ?_
    have hset : inducingFn 𝕜 A '' {m : 𝓜ₛ(𝕜, A) | ‖m.toDoubleCentralizer‖ ≤ C} =
        (⋂ (x : A) (y : A), {f | (f (x + y)).fst = (f x).fst + (f y).fst} ∩
          {f | (f (x + y)).snd = (f x).snd + (f y).snd}) ∩
        (⋂ (c : 𝕜) (x : A), {f | (f (c • x)).fst = c • (f x).fst} ∩
          {f | (f (c • x)).snd = c • (f x).snd}) ∩
        (⋂ x : A, {f | ‖(f x).fst‖ ≤ C * ‖x‖} ∩ {f | ‖(f x).snd‖ ≤ C * ‖x‖}) ∩
        (⋂ (x : A) (y : A), {f | (f x).snd * y = x * (f y).fst}) := by
      ext f
      simp only [mem_image_inducingFn_norm_le_iff hC, Set.mem_inter_iff, Set.mem_iInter,
        Set.mem_ofPred, forall_and]
      tauto
    rw [hset]
    exact (((isClosed_iInter fun x => isClosed_iInter fun y =>
          (isClosed_eq (continuous_eval_fst (x + y))
            ((continuous_eval_fst x).add (continuous_eval_fst y))).inter
          (isClosed_eq (continuous_eval_snd (x + y))
            ((continuous_eval_snd x).add (continuous_eval_snd y)))).inter
        (isClosed_iInter fun c => isClosed_iInter fun x =>
          (isClosed_eq (continuous_eval_fst (c • x)) ((continuous_eval_fst x).const_smul c)).inter
          (isClosed_eq (continuous_eval_snd (c • x)) ((continuous_eval_snd x).const_smul c)))).inter
      (isClosed_iInter fun x =>
        (isClosed_le (continuous_norm.comp (continuous_eval_fst x)) continuous_const).inter
        (isClosed_le (continuous_norm.comp (continuous_eval_snd x)) continuous_const))).inter
      (isClosed_iInter fun x => isClosed_iInter fun y =>
        isClosed_eq ((continuous_eval_snd x).mul_const y) ((continuous_eval_fst y).const_mul x))
  · have hempty : {m : 𝓜ₛ(𝕜, A) | ‖m.toDoubleCentralizer‖ ≤ C} = ∅ :=
      Set.eq_empty_of_forall_notMem fun _ hm => hC ((norm_nonneg _).trans hm)
    rw [hempty]
    exact fun l hl hle =>
      absurd (Filter.empty_mem_iff_bot.mp (hle (Filter.mem_principal_self ∅))) hl.1.ne

end Completeness

/-! ### Approximate-unit convergence and strict density of `A` -/

section Density

section ApproximateUnit

variable {𝕜 A : Type*} [NontriviallyNormedField 𝕜] [NonUnitalNormedRing A] [NormedSpace 𝕜 A]
  [SMulCommClass 𝕜 A A] [IsScalarTower 𝕜 A A]

/-- Any approximate unit `l` in `A` converges strictly to `1 : 𝓜ₛ(𝕜, A)`. -/
theorem tendsto_coe_one_of_isApproximateUnit {l : Filter A} (hl : l.IsApproximateUnit) :
    Tendsto (DoubleCentralizerStrict.coe 𝕜 : A → 𝓜ₛ(𝕜, A)) l (𝓝 1) :=
  tendsto_iff_forall_tendsto.mpr ⟨hl.tendsto_mul_right, hl.tendsto_mul_left⟩

/-- Along an approximate unit `l` of an algebra with zero right annihilator, `(m.fst e : 𝓜ₛ(𝕜, A))`
converges strictly to `m`. -/
theorem tendsto_coe_fst_of_isApproximateUnit [FaithfulSMul Aᵐᵒᵖ A] {l : Filter A}
    (hl : l.IsApproximateUnit) (m : 𝓜ₛ(𝕜, A)) :
    Tendsto (fun e : A => (m.toDoubleCentralizer.fst e : 𝓜ₛ(𝕜, A))) l (𝓝 m) :=
  tendsto_iff_forall_tendsto.mpr
    ⟨fun a => ((m.toDoubleCentralizer.fst.continuous.tendsto a).comp
        (hl.tendsto_mul_right a)).congr (DoubleCentralizer.fst_mul m.toDoubleCentralizer · a),
      fun a => (hl.tendsto_mul_left (m.toDoubleCentralizer.snd a)).congr
        (m.toDoubleCentralizer.central a ·)⟩

/-- Along an approximate unit `l` of an algebra with zero left annihilator, `(m.snd e : 𝓜ₛ(𝕜, A))`
converges strictly to `m`. -/
theorem tendsto_coe_snd_of_isApproximateUnit [FaithfulSMul A A] {l : Filter A}
    (hl : l.IsApproximateUnit) (m : 𝓜ₛ(𝕜, A)) :
    Tendsto (fun e : A => (m.toDoubleCentralizer.snd e : 𝓜ₛ(𝕜, A))) l (𝓝 m) :=
  tendsto_iff_forall_tendsto.mpr
    ⟨fun a => (hl.tendsto_mul_right (m.toDoubleCentralizer.fst a)).congr fun e =>
        (m.toDoubleCentralizer.central e a).symm,
      fun a => ((m.toDoubleCentralizer.snd.continuous.tendsto a).comp
        (hl.tendsto_mul_left a)).congr (DoubleCentralizer.snd_mul m.toDoubleCentralizer a ·)⟩

end ApproximateUnit

section CStarAlgebra

variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- Every multiplier `m : 𝓜ₛ(ℂ, A)` with `‖m.toDoubleCentralizer‖ ≤ R` lies in the strict closure
of the closed norm ball of radius `R` in `A`. -/
theorem mem_closure_image_closedBall {R : ℝ} {m : 𝓜ₛ(ℂ, A)} (hm : ‖m.toDoubleCentralizer‖ ≤ R) :
    m ∈ closure ((DoubleCentralizerStrict.coe ℂ : A → 𝓜ₛ(ℂ, A)) '' Metric.closedBall 0 R) := by
  let := CStarAlgebra.spectralOrder A
  have := CStarAlgebra.spectralOrderedRing A
  have hau := CStarAlgebra.increasingApproximateUnit A
  have := hau.neBot
  refine mem_closure_of_tendsto (tendsto_coe_fst_of_isApproximateUnit hau.toIsApproximateUnit m) <|
    hau.eventually_norm.mono fun e he => ⟨m.toDoubleCentralizer.fst e, ?_, rfl⟩
  rw [Metric.mem_closedBall, dist_zero_right]
  exact (m.toDoubleCentralizer.fst.le_opNorm e).trans <|
    (mul_le_mul m.toDoubleCentralizer.norm_fst_le he (norm_nonneg e)
      (norm_nonneg m.toDoubleCentralizer)).trans (by linarith)

/-- **Strict ball density.** For a C⋆-algebra `A` and any `R : ℝ`, the strict closure of the image
of `Metric.closedBall (0 : A) R` in `𝓜ₛ(ℂ, A)` is `{m : 𝓜ₛ(ℂ, A) | ‖m.toDoubleCentralizer‖ ≤ R}`. -/
@[simp] theorem closure_image_closedBall (R : ℝ) :
    closure ((DoubleCentralizerStrict.coe ℂ : A → 𝓜ₛ(ℂ, A)) '' Metric.closedBall 0 R) =
      {m : 𝓜ₛ(ℂ, A) | ‖m.toDoubleCentralizer‖ ≤ R} := by
  refine Set.Subset.antisymm (closure_minimal ?_ (isClosed_norm_le R))
    fun _ => mem_closure_image_closedBall
  rintro _ ⟨a, ha, rfl⟩; simpa [Metric.mem_closedBall, dist_zero_right] using ha

/-- **Strict density of `A` in `𝓜ₛ(ℂ, A)`.** The canonical inclusion `A → 𝓜ₛ(ℂ, A)` has strictly
dense range. -/
theorem denseRange_coe : DenseRange (DoubleCentralizerStrict.coe ℂ : A → 𝓜ₛ(ℂ, A)) :=
  fun _ => closure_mono (Set.image_subset_range _ _) (mem_closure_image_closedBall le_rfl)

end CStarAlgebra

end Density

end DoubleCentralizerStrict

end TauCeti
