module

public import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Range
public import TauCeti.Algebra.Algebra.Spectrum

/-!
# Pulling back the continuous functional calculus along a closed embedding

Let `φ : A →⋆ₐ[𝕜] B` be a star algebra homomorphism over an `RCLike` field `𝕜` which is a closed
embedding and reflects units, and suppose `B` carries a continuous functional calculus for a
predicate `q`. Then `A` carries a continuous functional calculus for the predicate `q ∘ φ`. The
calculus of `B` at `φ a` lies in the closed star subalgebra `φ.range`, because every value of the
calculus lies in the elemental star subalgebra generated by `φ a`; pulling it back along the
identification of `A` with `φ.range`, a homeomorphism because `φ` is an embedding, gives the
calculus of `A` at `a`.

This is how a real operator algebra obtains its functional calculus from a complex
C⋆-algebra containing it, for instance bounded operators on a real Hilbert space from bounded
operators on its complexification. Once the instance is available, Mathlib's
`StarAlgHom.map_cfc` gives `φ (cfc f a) = cfc f (φ a)`.

Mathlib's `ContinuousFunctionalCalculus.transfer` handles the case of a star algebra
equivalence. The construction here follows it, and Mathlib's proof of `StarAlgHomClass.map_cfc`,
replacing the equivalence by the range restriction of `φ`.

## Main results

* `ContinuousFunctionalCalculus.of_isClosedEmbedding`: a continuous functional calculus pulls
  back along a unit-reflecting star algebra homomorphism which is a closed embedding.
-/

public section

open Topology

namespace ContinuousFunctionalCalculus

variable {𝕜 A B : Type*} {p : A → Prop} {q : B → Prop} [RCLike 𝕜]
  [Ring A] [StarRing A] [TopologicalSpace A] [Algebra 𝕜 A]
  [Ring B] [StarRing B] [TopologicalSpace B] [Algebra 𝕜 B] [StarModule 𝕜 B]
  [IsTopologicalRing B] [ContinuousStar B] [ContinuousFunctionalCalculus 𝕜 B q]

/-- A continuous functional calculus pulls back along a star algebra homomorphism `φ` which is
a closed embedding and reflects units: if `B` has a calculus for `q`, then `A` has one for any
predicate `p` with `p a ↔ q (φ a)`. -/
theorem of_isClosedEmbedding (φ : A →⋆ₐ[𝕜] B) (hφ : IsClosedEmbedding φ) [IsLocalHom φ]
    (hpq : ∀ a, p a ↔ q (φ a)) : ContinuousFunctionalCalculus 𝕜 A p where
  predicate_zero := (hpq 0).mpr <| by simpa using predicate_zero (R := 𝕜) (p := q)
  compactSpace_spectrum a := by
    rw [← AlgHom.spectrum_apply_eq φ a]
    exact compactSpace_spectrum (φ a)
  spectrum_nonempty a ha := by
    have := hφ.injective.nontrivial
    rw [← AlgHom.spectrum_apply_eq φ a]
    exact spectrum_nonempty (φ a) ((hpq a).mp ha)
  exists_cfc_of_predicate a ha := by
    have hb : q (φ a) := (hpq a).mp ha
    -- The calculus of `B` at `φ a`, read on `C(spectrum 𝕜 a, 𝕜)`.
    let h := Homeomorph.setCongr (AlgHom.spectrum_apply_eq φ a)
    let ψ₀ : C(spectrum 𝕜 a, 𝕜) →⋆ₐ[𝕜] B :=
      (cfcHom hb).comp (h.compStarAlgEquiv' 𝕜 𝕜).toStarAlgHom
    have hψ₀ (f : C(spectrum 𝕜 a, 𝕜)) : ψ₀ f = cfcHom hb (f.comp h) := by simp [ψ₀]
    -- Its values lie in the closed star subalgebra `φ.range`, which contains `φ a`.
    have hmem (f : C(spectrum 𝕜 a, 𝕜)) : ψ₀ f ∈ φ.range :=
      StarAlgebra.elemental.le_of_mem (φ.toAlgHom.coe_range ▸ hφ.isClosed_range)
        (φ.toAlgHom.mem_range_self a) (cfcHom_mem_elemental hb _)
    let e := StarAlgEquiv.ofInjective φ hφ.injective
    -- `e y` is `φ y` viewed in `φ.range` (`StarAlgHom.coe_codRestrict` holds by `rfl`).
    have he (x : φ.range) : φ (e.symm x) = x := congr(Subtype.val $(e.apply_symm_apply x))
    let ψ : C(spectrum 𝕜 a, 𝕜) →⋆ₐ[𝕜] A :=
      e.symm.toStarAlgHom.comp (ψ₀.codRestrict φ.range hmem)
    have hψ : φ ∘ ψ = ψ₀ := funext fun f ↦ he _
    have hψ₀c : Continuous ψ₀ := by
      have : (ψ₀ : C(spectrum 𝕜 a, 𝕜) → B) = cfcHom hb ∘ (·.comp h) := funext hψ₀
      rw [this]
      exact (cfcHom_continuous hb).comp (ContinuousMap.continuous_precomp _)
    refine ⟨ψ, hφ.isEmbedding.continuous_iff.mpr (hψ ▸ hψ₀c), .of_comp (f := φ) ?_, ?_,
      fun f ↦ ?_, fun f ↦ ?_⟩
    · rw [hψ]
      intro f g hfg
      rw [hψ₀, hψ₀] at hfg
      ext x
      simpa using congr($(cfcHom_injective hb hfg) (h.symm x))
    · apply hφ.injective
      rw [← Function.comp_apply (f := φ), hψ, hψ₀]
      exact cfcHom_id hb
    · rw [← AlgHom.spectrum_apply_eq φ, ← Function.comp_apply (f := φ), hψ, hψ₀,
        cfcHom_map_spectrum hb, ContinuousMap.coe_comp]
      exact h.surjective.range_comp _
    · rw [hpq, ← Function.comp_apply (f := φ), hψ]
      exact cfcHom_predicate hb _

end ContinuousFunctionalCalculus
