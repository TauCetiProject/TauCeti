/-!
# Strictly positive elements and σ-unital C⋆-algebras

An element `h` of a possibly nonunital C⋆-algebra `A` is *strictly positive*,
`TauCeti.CStarAlgebra.IsStrictlyPositive h` (defined in
`TauCeti.Analysis.CStarAlgebra.Hereditary.Ideal`), when `0 ≤ h` and `h A h` is dense in `A`
(that is, the hereditary C⋆-subalgebra `(h A h)⁻` generated by `h` is all of `A`). On a unital
C⋆-algebra this coincides with Mathlib's `_root_.IsStrictlyPositive h` (`0 ≤ h ∧ IsUnit h`, see
`TauCeti.CStarAlgebra.isStrictlyPositive_iff_of_unital`).

## Main definitions and results

* Basic properties supplementing `TauCeti.Analysis.CStarAlgebra.Hereditary.Ideal`:
  `IsStrictlyPositive.dense_range_mul_mul`, `isStrictlyPositive_zero_iff`,
  `IsStrictlyPositive.ne_zero`, `IsStrictlyPositive.smul`, `IsStrictlyPositive.map`,
  `IsStrictlyPositive.map_equiv_iff`.
* `TauCeti.CStarAlgebra.resolventApproxAt` and `TauCeti.CStarAlgebra.resolventApprox`: the
  resolvent cutoffs `cfcₙ (fun t : ℝ => t * (t + c)⁻¹) h` (`resolventApproxAt_def`) at real
  scale `c : ℝ` and their sequential specialization
  `resolventApprox h n = resolventApproxAt h ((n : ℝ) + 1)⁻¹` (`resolventApprox_def`). For
  `0 ≤ h` and `0 < c`, they satisfy self-adjointness (`isSelfAdjoint_resolventApproxAt`),
  normality, homomorphism transport (`map_resolventApproxAt`), positivity
  (`resolventApproxAt_nonneg`), strict contractive norm bound (`norm_resolventApproxAt_lt_one`),
  antitone dependence on `c` (`antitoneOn_resolventApproxAt`) and monotonicity in `n`
  (`monotone_resolventApprox`), algebraic identity (`resolventApproxAt_mul_self_add_smul`),
  unitization invertibility (`isUnit_inr_add_smul_one`) and inverse embedding formula
  `((resolventApproxAt h c : A) : A⁺¹) = (h : A⁺¹) * Ring.inverse ((h : A⁺¹) + c • 1)`
  (`inr_resolventApproxAt`, `inr_resolventApprox`), and norm bound
  `‖resolventApproxAt h c * h - h‖ ≤ c` (`norm_resolventApproxAt_mul_self_sub_le`,
  `norm_resolventApprox_mul_self_sub_le`).
* Equivalent characterizations of strict positivity (Blackadar II.4.2.4):
  * `isStrictlyPositive_iff_dense_range_mul_left` and `isStrictlyPositive_iff_dense_range_mul_right`
    (for `0 ≤ h`): density of `h A` or `A h`;
  * `isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox` (without assuming `0 ≤ h`,
    since nonnegativity is recovered from the quasispectrum of `h`) and
    `isStrictlyPositive_iff_isApproximateUnit_resolventApprox` (for `0 ≤ h`);
  * `isStrictlyPositive_iff_forall_positiveLinearMap_pos` and
    `isStrictlyPositive_iff_forall_positiveContinuousLinearMap_pos` (without assuming `0 ≤ h`):
    `0 < φ h` for every nonzero positive linear functional `φ`.
* `TauCeti.CStarAlgebra.IsSigmaUnital`: typeclass asserting the existence of a countably generated
  approximate unit (`IsSigmaUnital.exists_isCountablyGenerated_and_isApproximateUnit`),
  characterized equivalently by existence of a strictly positive element
  (`isSigmaUnital_iff_exists_isStrictlyPositive`), a countably generated increasing approximate unit
  (`isSigmaUnital_iff_exists_isCountablyGenerated_and_isIncreasingApproximateUnit`), or a monotone
  sequential increasing approximate unit
  (`isSigmaUnital_iff_exists_seq_isIncreasingApproximateUnit`), with instances for unital,
  separable, and quotient C⋆-algebras and preservation under surjective star homomorphisms and
  star-algebra equivalences (`StarAlgEquiv.isSigmaUnital_iff`).

## References

* B. Blackadar, *Operator Algebras*, II.4.2.1, II.4.2.4 and II.4.2.5.
* G. K. Pedersen, *C⋆-Algebras and Their Automorphism Groups*, §3.10.
-/

public section

open Filter Set Topology Unitization WeakDual
open scoped ComplexOrder NNReal CStarAlgebra

namespace TauCeti.CStarAlgebra

section Basic

namespace IsStrictlyPositive

theorem dense_range_mul_mul {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] {h : A}
    (hh : IsStrictlyPositive h) : Dense (Set.range fun x : A => h * x * h) :=
  dense_iff_closure_eq.mpr hh.closure_range_eq_univ

/-- Zero is strictly positive if and only if the algebra is a subsingleton. -/
@[simp, grind =]
theorem _root_.TauCeti.CStarAlgebra.isStrictlyPositive_zero_iff {A : Type*}
    [NonUnitalCStarAlgebra A] [PartialOrder A] :
    IsStrictlyPositive (0 : A) ↔ Subsingleton A := by
  refine ⟨fun h => ?_, fun _ => isStrictlyPositive_def.mpr ⟨le_rfl, Set.eq_univ_of_forall fun x =>
    subset_closure ⟨0, Subsingleton.elim _ _⟩⟩⟩
  by_contra hns
  rw [not_subsingleton_iff_nontrivial] at hns
  exact not_isStrictlyPositive_zero h

@[grind →]
theorem ne_zero {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]
    [Nontrivial A] {h : A} (hh : IsStrictlyPositive h) : h ≠ 0 := by
  rintro rfl
  exact not_isStrictlyPositive_zero hh

/-- Scaling a strictly positive element by a positive scalar preserves strict positivity. -/
@[grind ←]
theorem smul {𝕜 A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]
    [Semifield 𝕜] [PartialOrder 𝕜] [MulActionWithZero 𝕜 A] [IsScalarTower 𝕜 A A]
    [SMulCommClass 𝕜 A A] [PosSMulMono 𝕜 A]
    {h : A} (hh : IsStrictlyPositive h) {c : 𝕜} (hc : 0 < c) :
    IsStrictlyPositive (c • h) := by
  refine isStrictlyPositive_def.mpr ⟨smul_nonneg hc.le hh.nonneg, ?_⟩
  have hc1 : c * (c⁻¹ * c⁻¹ * c) = 1 := by
    rw [mul_assoc c⁻¹ c⁻¹ c, inv_mul_cancel₀ hc.ne', mul_one, mul_inv_cancel₀ hc.ne']
  have hrange : (Set.range fun x : A => (c • h) * x * (c • h)) =
      Set.range fun x : A => h * x * h := by
    ext y
    refine ⟨?_, ?_⟩
    · rintro ⟨x, rfl⟩
      exact ⟨(c * c) • x, by simp [smul_mul_assoc, mul_smul_comm, smul_smul]⟩
    · rintro ⟨x, rfl⟩
      exact ⟨(c⁻¹ * c⁻¹) • x, by simp [smul_mul_assoc, mul_smul_comm, smul_smul, hc1]⟩
  rw [hrange]
  exact hh.closure_range_eq_univ

/-- Surjective star-algebra homomorphisms map strictly positive elements to strictly positive
elements. -/
theorem map {A B F : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
    [NonUnitalCStarAlgebra B] [PartialOrder B] [StarOrderedRing B]
    [FunLike F A B] [NonUnitalAlgHomClass F ℂ A B] [StarHomClass F A B]
    {h : A} (hh : IsStrictlyPositive h) (f : F) (hf : Function.Surjective f) :
    IsStrictlyPositive (f h) :=
  isStrictlyPositive_def.mpr ⟨map_nonneg f hh.nonneg,
    dense_iff_closure_eq.mp <| hf.denseRange.dense_of_mapsTo (map_continuous f)
      hh.dense_range_mul_mul fun _ ⟨x, hx⟩ => ⟨f x, by rw [← hx, map_mul, map_mul]⟩⟩

/-- Star-algebra equivalences preserve strict positivity in both directions. -/
@[simp]
theorem map_equiv_iff {A B : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
    [NonUnitalCStarAlgebra B] [PartialOrder B] [StarOrderedRing B]
    (e : A ≃⋆ₐ[ℂ] B) {h : A} :
    IsStrictlyPositive (e h) ↔ IsStrictlyPositive h :=
  ⟨fun hh => e.symm_apply_apply h ▸ hh.map e.symm e.symm.surjective,
    fun hh => hh.map e e.surjective⟩

end IsStrictlyPositive

end Basic

section Resolvent

/-- The resolvent cutoff `h * (h + c)⁻¹` at real scale `c` attached to an element `h` of a
nonunital C⋆-algebra, defined for general `h` via the real nonunital continuous functional calculus
as `cfcₙ (fun t : ℝ => t * (t + c)⁻¹) h`. When `0 ≤ h` and `0 < c`, it embeds in the unitization
`A⁺¹` as `(h : A⁺¹) * Ring.inverse ((h : A⁺¹) + c • 1)` (`inr_resolventApproxAt`). -/
noncomputable def resolventApproxAt {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (c : ℝ) : A :=
  cfcₙ (fun t : ℝ => t * (t + c)⁻¹) h

/-- Unfolding formula for `resolventApproxAt`. -/
theorem resolventApproxAt_def {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (c : ℝ) :
    resolventApproxAt h c = cfcₙ (fun t : ℝ => t * (t + c)⁻¹) h :=
  (rfl)

@[simp, grind =]
theorem resolventApproxAt_zero {A : Type*} [NonUnitalCStarAlgebra A] (c : ℝ) :
    resolventApproxAt (0 : A) c = 0 :=
  cfcₙ_apply_zero

@[simp, grind .]
theorem isSelfAdjoint_resolventApproxAt {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (c : ℝ) :
    IsSelfAdjoint (resolventApproxAt h c) :=
  IsSelfAdjoint.cfcₙ

@[simp]
instance instIsStarNormalResolventApproxAt {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (c : ℝ) :
    IsStarNormal (resolventApproxAt h c) :=
  (isSelfAdjoint_resolventApproxAt h c).isStarNormal

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

private theorem continuousOn_mul_add_inv_quasispectrum {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    ContinuousOn (fun t : ℝ => t * (t + c)⁻¹) (quasispectrum ℝ h) :=
  continuousOn_id.mul (TauCeti.continuousOn_add_inv_quasispectrum hh hc)

/-- Nonunital star-algebra homomorphisms commute with `resolventApproxAt` on nonnegative
elements for positive scales. -/
@[simp]
theorem map_resolventApproxAt {B F : Type*} [NonUnitalCStarAlgebra B]
    [FunLike F A B] [NonUnitalAlgHomClass F ℂ A B] [StarHomClass F A B]
    (f : F) {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    f (resolventApproxAt h c) = resolventApproxAt (f h) c :=
  NonUnitalStarAlgHomClass.map_cfcₙ f (fun t : ℝ => t * (t + c)⁻¹) h
    (continuousOn_mul_add_inv_quasispectrum hh hc) (by simp) (map_continuous f)
    hh.isSelfAdjoint (hh.isSelfAdjoint.map f)

/-- For `0 ≤ h` and `0 < c`, `resolventApproxAt h c` agrees with
`cfcₙ (fun x : ℝ≥0 => 1 - (1 + x)⁻¹)` at `c⁻¹ • h`, connecting the resolvent formula to Mathlib's
operator-monotone contraction. -/
theorem resolventApproxAt_eq_cfcₙ_one_sub {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    resolventApproxAt h c = cfcₙ (fun x : ℝ≥0 => 1 - (1 + x)⁻¹) (c⁻¹ • h) := by
  have hc_inv : 0 < c⁻¹ := inv_pos.mpr hc
  have hsh : 0 ≤ c⁻¹ • h := smul_nonneg hc_inv.le hh
  rw [cfcₙ_nnreal_eq_real _ _ hsh]
  have hcongr1 : cfcₙ (fun x : ℝ => ((1 - (1 + x.toNNReal)⁻¹ : ℝ≥0) : ℝ)) (c⁻¹ • h) =
      cfcₙ (fun x : ℝ => 1 - (1 + x)⁻¹) (c⁻¹ • h) := by
    refine cfcₙ_congr fun x hx => ?_
    have hx₀ : 0 ≤ x := quasispectrum_nonneg_of_nonneg _ hsh x hx
    have hle : (1 + x.toNNReal)⁻¹ ≤ (1 : ℝ≥0) := inv_le_one_of_one_le₀ (by simp)
    simp [NNReal.coe_sub hle, Real.coe_toNNReal x hx₀]
  rw [hcongr1, ← cfcₙ_comp_smul c⁻¹ (fun x : ℝ => 1 - (1 + x)⁻¹) h ?_ (by simp) hh.isSelfAdjoint]
  · refine cfcₙ_congr fun t ht => ?_
    have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
    have : t + c ≠ 0 := by positivity
    have : 1 + c⁻¹ * t ≠ 0 := by positivity
    dsimp only [smul_eq_mul]
    field_simp
    ring
  · refine continuousOn_const.sub (ContinuousOn.inv₀ (by fun_prop) ?_)
    rintro _ ⟨t, ht, rfl⟩
    have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
    have hmul : 0 ≤ c⁻¹ * t := mul_nonneg hc_inv.le ht₀
    dsimp only [smul_eq_mul]
    linarith

theorem resolventApproxAt_nonneg {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    0 ≤ resolventApproxAt h c := by
  rw [resolventApproxAt_eq_cfcₙ_one_sub hh hc]
  exact cfcₙ_nonneg_of_predicate

theorem norm_resolventApproxAt_lt_one {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    ‖resolventApproxAt h c‖ < 1 := by
  rw [resolventApproxAt_eq_cfcₙ_one_sub hh hc]
  exact norm_cfcₙ_one_sub_one_add_inv_lt_one _

/-- For `0 ≤ h`, `resolventApproxAt h` is antitone on `(0, ∞)`. -/
theorem antitoneOn_resolventApproxAt {h : A} (hh : 0 ≤ h) :
    AntitoneOn (resolventApproxAt h) (Set.Ioi 0) := by
  intro c₁ hc₁ c₂ hc₂ hle
  rw [resolventApproxAt_eq_cfcₙ_one_sub hh hc₂, resolventApproxAt_eq_cfcₙ_one_sub hh hc₁]
  have h1 : 0 ≤ c₁⁻¹ • h := smul_nonneg (inv_pos.mpr hc₁).le hh
  have h2 : 0 ≤ c₂⁻¹ • h := smul_nonneg (inv_pos.mpr hc₂).le hh
  have hsmul : c₂⁻¹ • h ≤ c₁⁻¹ • h := by
    rw [← sub_nonneg, ← sub_smul]
    exact smul_nonneg (sub_nonneg.mpr (inv_anti₀ hc₁ hle)) hh
  exact CFC.monotoneOn_one_sub_one_add_inv h2 h1 hsmul

theorem resolventApproxAt_le_inv_smul {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    resolventApproxAt h c ≤ c⁻¹ • h := by
  have hcont := continuousOn_mul_add_inv_quasispectrum hh hc
  rw [resolventApproxAt, ← cfcₙ_const_mul_id c⁻¹ h hh.isSelfAdjoint]
  refine cfcₙ_mono (fun t ht => ?_) hcont (by fun_prop) (by simp) (by simp)
  have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
  have hpos : 0 < t + c := by positivity
  have hmul : c⁻¹ * t * (t + c) = c⁻¹ * t ^ 2 + t := by field_simp
  rw [← div_eq_mul_inv, div_le_iff₀ hpos, hmul]
  linarith [mul_nonneg (inv_pos.mpr hc).le (sq_nonneg t)]

/-- Algebraic resolvent identity in `A`: `(h (h + c)⁻¹) h + c • (h (h + c)⁻¹) = h` for
`0 ≤ h` and `0 < c`. -/
theorem resolventApproxAt_mul_self_add_smul {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    resolventApproxAt h c * h + c • resolventApproxAt h c = h := by
  let g : ℝ → ℝ := fun t => t * (t + c)⁻¹
  have hg : ContinuousOn g (quasispectrum ℝ h) := continuousOn_mul_add_inv_quasispectrum hh hc
  rw [resolventApproxAt]
  nth_rw 2 [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
  rw [← cfcₙ_mul g (fun t : ℝ => t) h hg (by simp [g]) (by fun_prop) (by simp),
    ← cfcₙ_smul c g h hg (by simp [g]),
    ← cfcₙ_add (fun x => g x * x) (fun x => c • g x) h
      (hg.mul continuousOn_id) (by simp [g]) (by fun_prop) (by simp [g])]
  conv_rhs => rw [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
  refine cfcₙ_congr fun t ht => ?_
  have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
  have : t + c ≠ 0 := by positivity
  dsimp only [g, smul_eq_mul]
  field_simp

omit [PartialOrder A] [StarOrderedRing A] in
theorem commute_resolventApproxAt_self (h : A) (c : ℝ) :
    Commute (resolventApproxAt h c) h := by
  by_cases hh : IsSelfAdjoint h
  · simpa only [resolventApproxAt, cfcₙ_id' ℝ h hh] using
      cfcₙ_commute_cfcₙ (fun t : ℝ => t * (t + c)⁻¹) (fun t : ℝ => t) h
  · simp [resolventApproxAt, cfcₙ_apply_of_not_predicate h hh]

/-- Resolvent approximation bound: `‖resolventApproxAt h c * h - h‖ ≤ c`. -/
theorem norm_resolventApproxAt_mul_self_sub_le {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    ‖resolventApproxAt h c * h - h‖ ≤ c := by
  have heq : resolventApproxAt h c * h - h = -(c • resolventApproxAt h c) := by
    rw [eq_sub_iff_add_eq.mpr (resolventApproxAt_mul_self_add_smul hh hc)]
    abel
  rw [heq, norm_neg, norm_smul, Real.norm_of_nonneg hc.le]
  exact mul_le_of_le_one_right hc.le (norm_resolventApproxAt_lt_one hh hc).le

private theorem add_ne_zero_of_mem_spectrum_inr {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c)
    {t : ℝ} (ht : t ∈ spectrum ℝ (h : A⁺¹)) : t + c ≠ 0 := by
  have : 0 ≤ t := spectrum_nonneg_of_nonneg (Unitization.inr_nonneg ℂ h hh) ht
  positivity

/-- In the unitization `A⁺¹`, `(h : A⁺¹) + c • 1` is invertible for `0 ≤ h` and `0 < c`. -/
theorem isUnit_inr_add_smul_one {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    IsUnit ((h : A⁺¹) + c • (1 : A⁺¹)) :=
  (_root_.IsStrictlyPositive.nonneg_add (Unitization.inr_nonneg ℂ h hh)
    (_root_.IsStrictlyPositive.smul hc _root_.isStrictlyPositive_one)).isUnit

/-- In the unitization `A⁺¹`, `resolventApproxAt h c` embeds as
`(h : A⁺¹) * Ring.inverse ((h : A⁺¹) + c • 1)` for `0 ≤ h` and `0 < c`. -/
theorem inr_resolventApproxAt {h : A} (hh : 0 ≤ h) {c : ℝ} (hc : 0 < c) :
    ((resolventApproxAt h c : A) : A⁺¹) =
      (h : A⁺¹) * Ring.inverse ((h : A⁺¹) + c • (1 : A⁺¹)) := by
  have hh' : 0 ≤ (h : A⁺¹) := Unitization.inr_nonneg ℂ h hh
  have hne : ∀ t ∈ spectrum ℝ (h : A⁺¹), t + c ≠ 0 :=
    fun _ ht => add_ne_zero_of_mem_spectrum_inr hh hc ht
  have hcont : ContinuousOn (fun t : ℝ => (t + c)⁻¹) (spectrum ℝ (h : A⁺¹)) :=
    ContinuousOn.inv₀ (by fun_prop) hne
  rw [resolventApproxAt, Unitization.real_cfcₙ_eq_cfc_inr h _,
    cfc_mul (fun t : ℝ => t) (fun t : ℝ => (t + c)⁻¹) (h : A⁺¹) (by fun_prop) hcont,
    cfc_id' ℝ (h : A⁺¹) hh'.isSelfAdjoint,
    cfc_inv (fun t : ℝ => t + c) (h : A⁺¹) hne (by fun_prop) hh'.isSelfAdjoint,
    cfc_add_const c (fun t : ℝ => t) (h : A⁺¹) (by fun_prop) hh'.isSelfAdjoint,
    cfc_id' ℝ (h : A⁺¹) hh'.isSelfAdjoint, Algebra.algebraMap_eq_smul_one]

/-- The resolvent sequence `resolventApproxAt h ((n : ℝ) + 1)⁻¹` attached to an element `h` of a
nonunital C⋆-algebra, defined for general `h` as
`cfcₙ (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) h`. When `0 ≤ h`, it embeds in `A⁺¹` as
`(h : A⁺¹) * Ring.inverse ((h : A⁺¹) + ((n : ℝ) + 1)⁻¹ • 1)` (`inr_resolventApprox`), and when `h`
is strictly positive it is a monotone sequential increasing approximate unit of `A`. -/
noncomputable def resolventApprox {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (n : ℕ) : A :=
  resolventApproxAt h ((n : ℝ) + 1)⁻¹

/-- Unfolding formula for `resolventApprox`. -/
theorem resolventApprox_def {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (n : ℕ) :
    resolventApprox h n = cfcₙ (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) h :=
  (rfl)

@[simp, grind =]
theorem resolventApprox_zero {A : Type*} [NonUnitalCStarAlgebra A] (n : ℕ) :
    resolventApprox (0 : A) n = 0 :=
  resolventApproxAt_zero _

@[simp, grind .]
theorem isSelfAdjoint_resolventApprox {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (n : ℕ) :
    IsSelfAdjoint (resolventApprox h n) :=
  isSelfAdjoint_resolventApproxAt h _

@[simp]
instance instIsStarNormalResolventApprox {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (n : ℕ) :
    IsStarNormal (resolventApprox h n) :=
  instIsStarNormalResolventApproxAt h _

/-- Nonunital star-algebra homomorphisms commute with `resolventApprox` on nonnegative elements. -/
@[simp]
theorem map_resolventApprox {B F : Type*} [NonUnitalCStarAlgebra B]
    [FunLike F A B] [NonUnitalAlgHomClass F ℂ A B] [StarHomClass F A B]
    (f : F) {h : A} (hh : 0 ≤ h) (n : ℕ) :
    f (resolventApprox h n) = resolventApprox (f h) n :=
  map_resolventApproxAt f hh (by positivity)

/-- For `0 ≤ h`, `resolventApprox h n` agrees with `cfcₙ (fun x : ℝ≥0 => 1 - (1 + x)⁻¹)` at
`((n : ℝ) + 1) • h`, connecting the resolvent formula to Mathlib's operator-monotone contraction. -/
theorem resolventApprox_eq_cfcₙ_one_sub {h : A} (hh : 0 ≤ h) (n : ℕ) :
    resolventApprox h n = cfcₙ (fun x : ℝ≥0 => 1 - (1 + x)⁻¹) (((n : ℝ) + 1) • h) := by
  simpa [resolventApprox] using
    resolventApproxAt_eq_cfcₙ_one_sub hh (c := ((n : ℝ) + 1)⁻¹) (by positivity)

theorem resolventApprox_nonneg {h : A} (hh : 0 ≤ h) (n : ℕ) : 0 ≤ resolventApprox h n :=
  resolventApproxAt_nonneg hh (by positivity)

theorem norm_resolventApprox_lt_one {h : A} (hh : 0 ≤ h) (n : ℕ) :
    ‖resolventApprox h n‖ < 1 :=
  norm_resolventApproxAt_lt_one hh (by positivity)

/-- For `0 ≤ h`, `resolventApprox h` is monotone in `n`. -/
theorem monotone_resolventApprox {h : A} (hh : 0 ≤ h) : Monotone (resolventApprox h) :=
  fun _ _ hmn => antitoneOn_resolventApproxAt hh (Set.mem_Ioi.mpr (by positivity))
    (Set.mem_Ioi.mpr (by positivity)) (inv_anti₀ (by positivity) (by gcongr))

theorem resolventApprox_le_smul {h : A} (hh : 0 ≤ h) (n : ℕ) :
    resolventApprox h n ≤ ((n : ℝ) + 1) • h := by
  simpa [resolventApprox] using
    resolventApproxAt_le_inv_smul hh (c := ((n : ℝ) + 1)⁻¹) (by positivity)

/-- Algebraic resolvent identity in `A`: `(h (h + c)⁻¹) h + c • (h (h + c)⁻¹) = h` for
`c = ((n : ℝ) + 1)⁻¹`. -/
theorem resolventApprox_mul_self_add_smul {h : A} (hh : 0 ≤ h) (n : ℕ) :
    resolventApprox h n * h + ((n : ℝ) + 1)⁻¹ • resolventApprox h n = h :=
  resolventApproxAt_mul_self_add_smul hh (by positivity)

omit [PartialOrder A] [StarOrderedRing A] in
theorem commute_resolventApprox_self (h : A) (n : ℕ) :
    Commute (resolventApprox h n) h :=
  commute_resolventApproxAt_self h _

/-- Resolvent approximation bound: `‖resolventApprox h n * h - h‖ ≤ ((n : ℝ) + 1)⁻¹`. -/
theorem norm_resolventApprox_mul_self_sub_le {h : A} (hh : 0 ≤ h) (n : ℕ) :
    ‖resolventApprox h n * h - h‖ ≤ ((n : ℝ) + 1)⁻¹ :=
  norm_resolventApproxAt_mul_self_sub_le hh (by positivity)

/-- In the unitization `A⁺¹`, `resolventApprox h n` embeds as
`(h : A⁺¹) * Ring.inverse ((h : A⁺¹) + ((n : ℝ) + 1)⁻¹ • 1)` for `0 ≤ h`. -/
theorem inr_resolventApprox {h : A} (hh : 0 ≤ h) (n : ℕ) :
    ((resolventApprox h n : A) : A⁺¹) =
      (h : A⁺¹) * Ring.inverse ((h : A⁺¹) + ((n : ℝ) + 1)⁻¹ • (1 : A⁺¹)) :=
  inr_resolventApproxAt hh (by positivity)

end Resolvent

section Characterizations

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- If `0 ≤ h` and `h A` is dense in `A`, then `resolventApprox h` is an increasing approximate
unit of `A`. -/
private theorem isIncreasingApproximateUnit_resolventApprox_of_dense_mul_left {h : A} (hh : 0 ≤ h)
    (hdense : Dense (Set.range fun x : A => h * x)) :
    (atTop.map (resolventApprox h)).IsIncreasingApproximateUnit := by
  refine Filter.IsIncreasingApproximateUnit.of_tendsto_mul_right_of_dense hdense ?_
    (eventually_map.mpr (.of_forall (resolventApprox_nonneg hh)))
    (eventually_map.mpr (.of_forall fun n => (norm_resolventApprox_lt_one hh n).le))
  rintro _ ⟨x, rfl⟩
  rw [tendsto_map'_iff, tendsto_iff_norm_sub_tendsto_zero]
  have hlim : Tendsto (fun n : ℕ => ((n : ℝ) + 1)⁻¹ * ‖x‖) atTop (𝓝 0) := by
    simpa [one_div] using tendsto_one_div_add_atTop_nhds_zero_nat.mul_const ‖x‖
  refine squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_) hlim
  rw [Function.comp_apply, ← mul_assoc, ← sub_mul]
  exact (norm_mul_le _ _).trans
    (mul_le_mul_of_nonneg_right (norm_resolventApprox_mul_self_sub_le hh n) (norm_nonneg x))

/-- If `0 ≤ h` and `resolventApprox h` is an approximate unit of `A`, then `h` is strictly
positive. -/
private theorem isStrictlyPositive_of_isApproximateUnit_resolventApprox {h : A} (hh : 0 ≤ h)
    (hl : (atTop.map (resolventApprox h)).IsApproximateUnit) :
    IsStrictlyPositive h := by
  let u : ℕ → A := resolventApprox h
  let y : ℕ → A := fun n => cfcₙ (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹ ^ 2) h
  have hy (n : ℕ) : h * y n = u n * u n ∧ y n * h = u n * u n := by
    have hg := continuousOn_mul_add_inv_quasispectrum hh (c := ((n : ℝ) + 1)⁻¹) (by positivity)
    have hyc : ContinuousOn (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹ ^ 2)
        (quasispectrum ℝ h) :=
      continuousOn_id.mul ((TauCeti.continuousOn_add_inv_quasispectrum hh (by positivity)).pow 2)
    have hmul : u n * u n = cfcₙ (fun t : ℝ => (t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) *
        (t * (t + ((n : ℝ) + 1)⁻¹)⁻¹)) h :=
      (cfcₙ_mul _ _ h hg (by simp) hg (by simp)).symm
    refine ⟨?_, ?_⟩
    · nth_rw 1 [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
      dsimp only [y]
      rw [← cfcₙ_mul _ _ h (by fun_prop) (by simp) hyc (by simp), hmul]
      exact cfcₙ_congr fun t _ => by ring
    · nth_rw 1 [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
      dsimp only [y]
      rw [← cfcₙ_mul _ _ h hyc (by simp) (by fun_prop) (by simp), hmul]
      exact cfcₙ_congr fun t _ => by ring
  have hu2 : (atTop.map (fun n => u n * u n)).IsApproximateUnit := by
    simpa only [Filter.map_map, Function.comp_def] using
      hl.map_mul_self (C := 1)
        (eventually_map.mpr (.of_forall fun n => (norm_resolventApprox_lt_one hh n).le))
  refine isStrictlyPositive_def.mpr ⟨hh, dense_iff_closure_eq.mp fun a =>
    mem_closure_of_tendsto (tendsto_map'_iff.mp (hu2.tendsto_mul_mul a)) ?_⟩
  refine .of_forall fun n => ⟨y n * a * y n, ?_⟩
  dsimp only [Function.comp_def]
  calc h * (y n * a * y n) * h = (h * y n) * a * (y n * h) := by simp only [mul_assoc]
    _ = u n * u n * a * (u n * u n) := by rw [(hy n).1, (hy n).2]

/-- Recover `0 ≤ h` from `(atTop.map (resolventApprox h)).IsIncreasingApproximateUnit` via the
real quasispectrum of `h`. -/
private theorem nonneg_of_isIncreasingApproximateUnit_resolventApprox {h : A}
    (hl : (atTop.map (resolventApprox h)).IsIncreasingApproximateUnit) : 0 ≤ h := by
  rcases subsingleton_or_nontrivial A with _ | _
  · exact Subsingleton.elim (0 : A) h ▸ le_rfl
  obtain ⟨a, ha⟩ := exists_ne (0 : A)
  have hlim : Tendsto (fun n => resolventApprox h n * a) atTop (𝓝 a) :=
    tendsto_map'_iff.mp (hl.tendsto_mul_right a)
  have hne_ev : ∀ᶠ n in atTop, resolventApprox h n ≠ 0 := by
    filter_upwards [hlim.eventually_ne ha] with n hn h0
    exact hn (by simp [h0])
  have hnorm_ev : ∀ᶠ n in atTop, ‖resolventApprox h n‖ ≤ 1 := eventually_map.mp hl.eventually_norm
  obtain ⟨N, hN⟩ := eventually_atTop.mp (hne_ev.and hnorm_ev)
  have hh_sa : IsSelfAdjoint h := by
    by_contra hnsa
    exact (hN N le_rfl).1 (cfcₙ_apply_of_not_predicate h hnsa)
  rw [StarOrderedRing.nonneg_iff_quasispectrum_nonneg (R := ℝ) h hh_sa]
  intro t ht
  by_contra! ht_neg
  obtain ⟨k, hk⟩ := exists_nat_gt (-t)⁻¹
  let n := max N k
  obtain ⟨hne, hnorm⟩ := hN n (le_max_left N k)
  let c : ℝ := ((n : ℝ) + 1)⁻¹
  have hc_pos : 0 < c := by positivity
  have hct : c < -t := by
    have hkn : (k : ℝ) ≤ n := Nat.cast_le.mpr (le_max_right N k)
    have hk' : (-t)⁻¹ < (n : ℝ) + 1 := hk.trans_le (by linarith)
    exact (inv_lt_comm₀ (by linarith) (by positivity)).mp hk'
  let g : ℝ → ℝ := fun s => s * (s + c)⁻¹
  have hg_cont : ContinuousOn g (quasispectrum ℝ h) := by
    by_contra hg
    exact hne (cfcₙ_apply_of_not_continuousOn h hg)
  have hle := (norm_apply_le_norm_cfcₙ g h ht hg_cont (by simp [g]) hh_sa).trans hnorm
  have hgt : 1 < g t := by
    have htc : t + c < 0 := by linarith
    have heq : g t = (-t) / (-t - c) := by
      dsimp only [g]
      rw [div_eq_mul_inv]
      have : t + c ≠ 0 := htc.ne
      have : -t - c ≠ 0 := by linarith
      field_simp
      ring
    rw [heq, one_lt_div (by linarith)]
    linarith
  linarith [Real.le_norm_self (g t)]

/-- **Blackadar II.4.2.4 (resolvent characterization).** An element `h` of a C⋆-algebra is strictly
positive if and only if its resolvent sequence `resolventApprox h` is an increasing approximate
unit of `A` (no nonnegativity hypothesis on `h` is needed). -/
theorem isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox {h : A} :
    IsStrictlyPositive h ↔ (atTop.map (resolventApprox h)).IsIncreasingApproximateUnit := by
  refine ⟨fun hh => isIncreasingApproximateUnit_resolventApprox_of_dense_mul_left hh.nonneg ?_,
    fun hl => isStrictlyPositive_of_isApproximateUnit_resolventApprox
      (nonneg_of_isIncreasingApproximateUnit_resolventApprox hl) hl.toIsApproximateUnit⟩
  refine hh.dense_range_mul_mul.mono ?_
  rintro _ ⟨x, rfl⟩
  exact ⟨x * h, (mul_assoc h x h).symm⟩

/-- For `0 ≤ h`, `h` is strictly positive if and only if `resolventApprox h` is an approximate
unit of `A`. -/
theorem isStrictlyPositive_iff_isApproximateUnit_resolventApprox {h : A} (hh : 0 ≤ h) :
    IsStrictlyPositive h ↔ (atTop.map (resolventApprox h)).IsApproximateUnit :=
  ⟨fun hsp => (isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox.mp
    hsp).toIsApproximateUnit, isStrictlyPositive_of_isApproximateUnit_resolventApprox hh⟩

/-- **Blackadar II.4.2.4 (right ideal density).** A nonnegative element `h` is strictly positive
if and only if `h A` is dense in `A`. -/
theorem isStrictlyPositive_iff_dense_range_mul_left {h : A} (hh : 0 ≤ h) :
    IsStrictlyPositive h ↔ Dense (Set.range fun x : A => h * x) := by
  refine ⟨fun hsp => hsp.dense_range_mul_mul.mono ?_, fun hdense =>
    isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox.mpr
      (isIncreasingApproximateUnit_resolventApprox_of_dense_mul_left hh hdense)⟩
  rintro _ ⟨x, rfl⟩
  exact ⟨x * h, (mul_assoc h x h).symm⟩

/-- **Blackadar II.4.2.4 (left ideal density).** A nonnegative element `h` is strictly positive if
and only if `A h` is dense in `A`. -/
theorem isStrictlyPositive_iff_dense_range_mul_right {h : A} (hh : 0 ≤ h) :
    IsStrictlyPositive h ↔ Dense (Set.range fun x : A => x * h) := by
  rw [isStrictlyPositive_iff_dense_range_mul_left hh]
  simp only [Metric.dense_iff]
  refine ⟨fun hd a ε hε => ?_, fun hd a ε hε => ?_⟩
  · obtain ⟨_, hball, ⟨x, rfl⟩⟩ := hd (star a) ε hε
    refine ⟨star x * h, ?_, ⟨star x, rfl⟩⟩
    rw [Metric.mem_ball, dist_eq_norm, ← norm_star]
    simpa [Metric.mem_ball, dist_eq_norm, hh.isSelfAdjoint.star_eq] using hball
  · obtain ⟨_, hball, ⟨x, rfl⟩⟩ := hd (star a) ε hε
    refine ⟨h * star x, ?_, ⟨star x, rfl⟩⟩
    rw [Metric.mem_ball, dist_eq_norm, ← norm_star]
    simpa [Metric.mem_ball, dist_eq_norm, hh.isSelfAdjoint.star_eq] using hball

/-- If `h` is strictly positive, every nonzero positive linear functional takes a strictly positive
value at `h`. -/
private theorem pos_of_isStrictlyPositive {h : A} (hh : IsStrictlyPositive h) (φ : A →ₚ[ℂ] ℂ)
    (hφ : φ ≠ 0) : 0 < φ h := by
  refine lt_of_le_of_ne (map_nonneg φ hh.nonneg) fun heq => hφ ?_
  let s : A := CFC.sqrt h
  have hs : star s * s = h := by
    rw [(CFC.sqrt_nonneg (a := h)).isSelfAdjoint.star_eq,
      CFC.sqrt_mul_sqrt_self h (ha := hh.nonneg)]
  have hφs : φ (star s * s) = 0 := hs.symm ▸ heq.symm
  have hL (x : A) : φ (h * x * h) = 0 := by
    have hmul : h * x * h = star s * (s * x * h) := by
      calc h * x * h = (star s * s) * x * h := by rw [hs]
        _ = star s * (s * x * h) := by simp only [mul_assoc]
    rw [hmul]
    simpa [hφs] using PositiveLinearMap.norm_map_star_mul_le φ s (s * x * h)
  let ω : A →L[ℂ] ℂ := PositiveContinuousLinearMap.ofClass (R := ℂ) φ
  have hω : ω = 0 := ContinuousLinearMap.ext fun a => by
    have hcl : Set.range (fun x : A => h * x * h) ⊆ ω ⁻¹' {0} := by
      rintro _ ⟨x, rfl⟩
      exact hL x
    exact closure_minimal hcl (isClosed_singleton.preimage ω.continuous)
      (hh.dense_range_mul_mul a)
  ext a
  exact DFunLike.congr_fun hω a

private theorem exists_mem_stateSpace_compress_eq_norm_sq {u : A} (hu : IsSelfAdjoint u) (a : A) :
    ∃ ω ∈ stateSpace A⁺¹,
      ω ((1 - (u : A⁺¹)) * ((a * star a : A) : A⁺¹) * (1 - (u : A⁺¹))) =
        ((‖a - u * a‖ ^ 2 : ℝ) : ℂ) := by
  obtain ⟨ω, hω, hω_eq⟩ := TauCeti.exists_mem_stateSpace_apply_star_mul_mul_eq_norm_sq
    (A := A⁺¹) (1 - (u : A⁺¹)) (a : A⁺¹)
  have hustar : star (u : A⁺¹) = (u : A⁺¹) := by rw [← Unitization.inr_star, hu.star_eq]
  have h1u : star (1 - (u : A⁺¹)) = 1 - (u : A⁺¹) := by simp [hustar]
  have hmul : (1 - (u : A⁺¹)) * (a : A⁺¹) = ((a - u * a : A) : A⁺¹) := by
    rw [sub_mul, one_mul, Unitization.inr_sub, Unitization.inr_mul]
  rw [h1u, ← Unitization.inr_star, ← Unitization.inr_mul, hmul, Unitization.norm_inr] at hω_eq
  exact ⟨ω, hω, hω_eq⟩

private theorem one_sub_inr_resolventApprox_nonneg_and_norm_le_one {h : A} (hh : 0 ≤ h)
    (m : ℕ) :
    0 ≤ 1 - (Unitization.inr (resolventApprox h m) : A⁺¹) ∧
      ‖1 - (Unitization.inr (resolventApprox h m) : A⁺¹)‖ ≤ 1 :=
  CStarAlgebra.mem_Icc_iff_norm_le_one.mp <| Set.sub_mem_Icc_zero_iff_right.mpr <|
    CStarAlgebra.inr_mem_Icc_iff_norm_le.mpr
      ⟨resolventApprox_nonneg hh m, (norm_resolventApprox_lt_one hh m).le⟩

/-- Along `atTop`, compressing any sequence of states `ω m ∈ stateSpace A⁺¹` by
`1 - ((resolventApprox h m : A) : A⁺¹)` sends `(h : A⁺¹)` to `0`. -/
private theorem tendsto_compressFunctional_resolventApprox_self {h : A} (hh : 0 ≤ h)
    {ω : ℕ → WeakDual ℂ A⁺¹} (hω : ∀ m, ω m ∈ stateSpace A⁺¹) :
    Tendsto (fun m => compressFunctional (1 - ((resolventApprox h m : A) : A⁺¹)) (ω m) (h : A⁺¹))
      atTop (𝓝 (0 : ℂ)) := by
  let u : ℕ → A := resolventApprox h
  let v : ℕ → A⁺¹ := fun m => 1 - (u m : A⁺¹)
  have hv (m : ℕ) : 0 ≤ v m ∧ ‖v m‖ ≤ 1 :=
    one_sub_inr_resolventApprox_nonneg_and_norm_le_one hh m
  have hinv : Tendsto (fun m : ℕ => ((m : ℝ) + 1)⁻¹) atTop (𝓝 0) := by
    simpa only [one_div] using tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
  refine tendsto_iff_norm_sub_tendsto_zero.mpr <| squeeze_zero_norm' (.of_forall fun m => ?_) hinv
  rw [sub_zero, Real.norm_of_nonneg (norm_nonneg _), compressFunctional_apply,
    (hv m).1.isSelfAdjoint.star_eq, ← toStrongDual_apply]
  have hvh : v m * (h : A⁺¹) * v m = ((h - u m * h : A) : A⁺¹) * v m := by
    simp [v, u, sub_mul, Unitization.inr_sub, Unitization.inr_mul]
  rw [hvh]
  refine ((toStrongDual (ω m)).le_opNorm _).trans ?_
  rw [norm_toStrongDual_of_mem_stateSpace (hω m), one_mul]
  calc ‖((h - u m * h : A) : A⁺¹) * v m‖ ≤ ‖((h - u m * h : A) : A⁺¹)‖ * ‖v m‖ := norm_mul_le _ _
    _ ≤ ‖u m * h - h‖ := by
      rw [Unitization.norm_inr, norm_sub_rev]
      exact mul_le_of_le_one_right (norm_nonneg _) (hv m).2
    _ ≤ ((m : ℝ) + 1)⁻¹ := norm_resolventApprox_mul_self_sub_le hh m

/-- Weak-* compactness step (Blackadar II.4.2.4): if `0 ≤ h` and `0 < φ h` for every nonzero
`φ : A →ₚ[ℂ] ℂ`, then `resolventApprox h m * a → a` for every `a : A`. -/
private theorem tendsto_resolventApprox_mul_of_forall_positiveLinearMap_pos {h : A} (hh : 0 ≤ h)
    (hpos : ∀ φ : A →ₚ[ℂ] ℂ, φ ≠ 0 → 0 < φ h) (a : A) :
    Tendsto (fun m => resolventApprox h m * a) atTop (𝓝 a) := by
  by_contra hnot
  obtain ⟨ε, hε, hfreq⟩ : ∃ ε > 0, ∃ᶠ m in atTop, ε ≤ ‖a - resolventApprox h m * a‖ := by
    rw [Metric.tendsto_nhds] at hnot; push Not at hnot
    obtain ⟨ε, hε, hf⟩ := hnot
    exact ⟨ε, hε, hf.mono fun m hm => by simpa [dist_eq_norm'] using hm⟩
  let u : ℕ → A := resolventApprox h
  let v : ℕ → A⁺¹ := fun m => 1 - (u m : A⁺¹)
  have hv (m : ℕ) : 0 ≤ v m ∧ ‖v m‖ ≤ 1 :=
    one_sub_inr_resolventApprox_nonneg_and_norm_le_one hh m
  choose ω hω_mem hω_val using fun m =>
    exists_mem_stateSpace_compress_eq_norm_sq (isSelfAdjoint_resolventApprox h m) a
  let ψ : ℕ → WeakDual ℂ A⁺¹ := fun m => compressFunctional (v m) (ω m)
  let l_bad : Filter ℕ := atTop ⊓ 𝓟 {m : ℕ | ε ≤ ‖a - u m * a‖}
  have : l_bad.NeBot := frequently_iff_neBot.mp hfreq
  obtain ⟨ψ₀, _, hcl⟩ := (WeakDual.isCompact_closedBall (0 : StrongDual ℂ A⁺¹) 1).exists_clusterPt
    (f := l_bad.map ψ) (le_principal_iff.mpr <| eventually_map.mpr <| .of_forall fun m =>
      compressFunctional_mem_closedBall (hv m).2
        (norm_toStrongDual_of_mem_stateSpace (hω_mem m)).le)
  have heval (z : A⁺¹) : MapClusterPt (ψ₀ z) l_bad (fun m => ψ m z) :=
    (mapClusterPt_def.mpr hcl).continuousAt_comp (WeakBilin.eval_continuous _ z).continuousAt
  let φ₀ : A →ₚ[ℂ] ℂ := .mk₀
    ((toStrongDual ψ₀).toLinearMap.comp (Unitization.inrHom ℂ ℂ A)) fun x hx => by
      simpa [WeakDual.toStrongDual_apply] using
        isClosed_Ici.mem_of_mapClusterPt (heval (x : A⁺¹))
          (.of_forall fun m => map_nonneg_compressFunctional
            (fun _ => map_nonneg_of_mem_stateSpace (hω_mem m)) (Unitization.inr_nonneg ℂ x hx))
  have hφ₀_apply (x : A) : φ₀ x = ψ₀ (x : A⁺¹) := by
    simp [φ₀]
  have hφ₀_ne : φ₀ ≠ 0 := fun h0 => by
    have hge : ε ^ 2 ≤ ‖ψ₀ ((a * star a : A) : A⁺¹)‖ :=
      (isClosed_le continuous_const continuous_norm).mem_of_mapClusterPt
        (heval ((a * star a : A) : A⁺¹)) <|
          eventually_inf_principal.mpr <| .of_forall fun m hm => by
            simp only [Set.mem_ofPred_eq] at hm ⊢
            rw [compressFunctional_apply, (hv m).1.isSelfAdjoint.star_eq, hω_val m,
              Complex.norm_real, Real.norm_of_nonneg (sq_nonneg _)]
            exact pow_le_pow_left₀ hε.le hm 2
    have hzero : ψ₀ ((a * star a : A) : A⁺¹) = 0 :=
      (hφ₀_apply (a * star a)).symm.trans (DFunLike.congr_fun h0 (a * star a))
    rw [hzero, norm_zero] at hge; linarith [sq_pos_of_pos hε]
  have hlim_top := tendsto_compressFunctional_resolventApprox_self hh hω_mem
  exact (hpos φ₀ hφ₀_ne).ne'
    (eq_of_nhds_neBot ((heval (h : A⁺¹)).clusterPt.mono (hlim_top.mono_left inf_le_left)))

/-- **Blackadar II.4.2.4 (state / positive functional characterization).** An element `h` of a
C⋆-algebra is strictly positive if and only if `0 < φ h` for every nonzero positive linear
functional `φ : A →ₚ[ℂ] ℂ` (no nonnegativity hypothesis on `h` is needed). -/
theorem isStrictlyPositive_iff_forall_positiveLinearMap_pos {h : A} :
    IsStrictlyPositive h ↔ ∀ φ : A →ₚ[ℂ] ℂ, φ ≠ 0 → 0 < φ h := by
  refine ⟨pos_of_isStrictlyPositive, fun hpos => ?_⟩
  have hh : 0 ≤ h := by
    rw [TauCeti.nonneg_iff_forall_mem_stateSpace]
    intro ψ hψ
    let ω := TauCeti.stateToPositiveLinearMap hψ
    have hω_ne : ω ≠ 0 := fun h0 => by
      have hnorm := TauCeti.norm_toStrongDual_of_mem_stateSpace hψ
      have hzero : toStrongDual ψ = 0 := ContinuousLinearMap.ext fun x => by
        simpa [ω] using DFunLike.congr_fun h0 x
      simp [hzero] at hnorm
    exact (hpos ω hω_ne).le.trans_eq (TauCeti.stateToPositiveLinearMap_apply hψ h)
  rw [isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox]
  exact Filter.IsIncreasingApproximateUnit.of_tendsto_mul_right
    (fun a => tendsto_map'_iff.mpr
      (tendsto_resolventApprox_mul_of_forall_positiveLinearMap_pos hh hpos a))
    (eventually_map.mpr (.of_forall (resolventApprox_nonneg hh)))
    (eventually_map.mpr (.of_forall fun n => (norm_resolventApprox_lt_one hh n).le))

/-- Continuous-functional variant of `isStrictlyPositive_iff_forall_positiveLinearMap_pos`. -/
theorem isStrictlyPositive_iff_forall_positiveContinuousLinearMap_pos {h : A} :
    IsStrictlyPositive h ↔ ∀ φ : A →P[ℂ] ℂ, φ ≠ 0 → 0 < φ h := by
  rw [isStrictlyPositive_iff_forall_positiveLinearMap_pos]
  refine ⟨fun h φ hφ => h φ.toPositiveLinearMap fun h0 =>
      hφ (by ext x; exact DFunLike.congr_fun h0 x),
    fun h φ hφ => h (.ofClass φ) fun h0 =>
      hφ (by ext x; exact DFunLike.congr_fun h0 x)⟩

end Characterizations

section SigmaUnital

/-- A C⋆-algebra `A` is *σ-unital* if it admits a countably generated approximate unit. By
`isSigmaUnital_iff_exists_isStrictlyPositive` and
`isSigmaUnital_iff_exists_seq_isIncreasingApproximateUnit`, this is equivalent to possessing a
strictly positive element or a monotone sequential increasing approximate unit. -/
class IsSigmaUnital (A : Type*) [NonUnitalCStarAlgebra A] : Prop where
  exists_isCountablyGenerated_and_isApproximateUnit :
    ∃ l : Filter A, l.IsCountablyGenerated ∧ l.IsApproximateUnit

/-- Existence of a strictly positive element from a separating sequence for GNS representations:
if no nonzero positive functional sends every `v n` to `0` in its GNS Hilbert space, then `A`
contains a strictly positive element, witnessed by the weighted series
`∑' n, ((1 / 2) ^ (n + 1) * (1 + ‖star (v n) * v n‖)⁻¹) • (star (v n) * v n)`. -/
private theorem exists_isStrictlyPositive_of_forall_toGNS_eq_zero {A : Type*}
    [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A] (v : ℕ → A)
    (hv : ∀ φ : A →ₚ[ℂ] ℂ, (∀ n, φ.toGNS (v n) = 0) → φ = 0) :
    ∃ h : A, IsStrictlyPositive h := by
  let c : ℕ → ℝ := fun n => ((1 : ℝ) / 2) ^ (n + 1) * (1 + ‖star (v n) * v n‖)⁻¹
  let w : ℕ → A := fun n => c n • (star (v n) * v n)
  have hc_pos (n : ℕ) : 0 < c n := by positivity
  have hw_nonneg (n : ℕ) : 0 ≤ w n := smul_nonneg (hc_pos n).le (star_mul_self_nonneg (v n))
  have hw_sum : Summable w := by
    refine .of_norm_bounded (summable_geometric_two.comp_injective Nat.succ_injective) fun n => ?_
    rw [norm_smul, Real.norm_of_nonneg (hc_pos n).le, mul_assoc]
    refine mul_le_of_le_one_right (by positivity) ?_
    rw [inv_mul_le_iff₀ (by positivity), mul_one]
    exact le_add_of_nonneg_left zero_le_one
  refine ⟨∑' n, w n, isStrictlyPositive_iff_forall_positiveLinearMap_pos.mpr fun φ hφ => ?_⟩
  have hh_nonneg : 0 ≤ ∑' n, w n := tsum_nonneg hw_nonneg
  refine lt_of_le_of_ne (map_nonneg φ hh_nonneg) fun heq => hφ (hv φ fun n => ?_)
  have hwn_le : w n ≤ ∑' k, w k := hw_sum.le_tsum n fun k _ => hw_nonneg k
  have hφ_wn : φ (w n) = 0 := le_antisymm
    ((OrderHomClass.mono φ hwn_le).trans_eq heq.symm) (map_nonneg φ (hw_nonneg n))
  rw [PositiveLinearMap.toGNS_eq_zero_iff]
  have hsmul : (c n : ℂ) * φ (star (v n) * v n) = 0 := by
    simpa [w, Complex.real_smul] using ((φ : A →ₗ[ℂ] ℂ).map_smul_of_tower (c n) _).symm.trans hφ_wn
  exact (mul_eq_zero.mp hsmul).resolve_left (Complex.ofReal_ne_zero.mpr (hc_pos n).ne')

/-- **Blackadar II.4.2.5 (strictly positive element characterization).** A C⋆-algebra is σ-unital
if and only if it contains a strictly positive element. -/
theorem isSigmaUnital_iff_exists_isStrictlyPositive {A : Type*} [NonUnitalCStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A] :
    IsSigmaUnital A ↔ ∃ h : A, IsStrictlyPositive h := by
  refine ⟨fun ⟨⟨l, hcg, hl⟩⟩ => ?_, fun ⟨h, hh⟩ => ⟨⟨atTop.map (resolventApprox h),
    inferInstance, (isStrictlyPositive_iff_isApproximateUnit_resolventApprox hh.nonneg).mp hh⟩⟩⟩
  have := hl.neBot
  obtain ⟨v, hv⟩ := Filter.exists_seq_tendsto l
  refine exists_isStrictlyPositive_of_forall_toGNS_eq_zero v fun φ hφ => ?_
  refine PositiveLinearMap.eq_zero_of_forall_toGNS_eq_zero fun a => ?_
  have hlim : Tendsto (fun n => φ.toGNS (a * v n)) atTop (𝓝 (φ.toGNS a)) :=
    (φ.toGNS.continuous.tendsto a).comp ((hl.tendsto_mul_left a).comp hv)
  have hzero : ∀ n, φ.toGNS (a * v n) = 0 := fun n => by
    rw [← φ.gnsNonUnitalStarAlgHom_apply_toGNS a (v n), hφ n, map_zero]
  exact (tendsto_nhds_unique (by simp [hzero]) hlim).symm

/-- A C⋆-algebra is σ-unital if and only if it admits a countably generated increasing approximate
unit. -/
theorem isSigmaUnital_iff_exists_isCountablyGenerated_and_isIncreasingApproximateUnit
    {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A] :
    IsSigmaUnital A ↔ ∃ l : Filter A, l.IsCountablyGenerated ∧ l.IsIncreasingApproximateUnit := by
  rw [isSigmaUnital_iff_exists_isStrictlyPositive]
  refine ⟨fun ⟨h, hh⟩ => ⟨atTop.map (resolventApprox h), inferInstance,
    isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox.mp hh⟩,
    fun ⟨l, hcg, hl⟩ => isSigmaUnital_iff_exists_isStrictlyPositive.mp ⟨⟨l, hcg,
      hl.toIsApproximateUnit⟩⟩⟩

/-- **Blackadar II.4.2.5 (monotone sequential approximate unit).** A C⋆-algebra is σ-unital if and
only if it admits a monotone sequence `u : ℕ → A` of nonnegative strict contractions forming an
increasing approximate unit. -/
theorem isSigmaUnital_iff_exists_seq_isIncreasingApproximateUnit {A : Type*}
    [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A] :
    IsSigmaUnital A ↔ ∃ u : ℕ → A, Monotone u ∧ (∀ n, 0 ≤ u n) ∧ (∀ n, ‖u n‖ < 1) ∧
      (atTop.map u).IsIncreasingApproximateUnit := by
  refine ⟨fun hA => ?_, fun ⟨u, _, _, _, hu⟩ =>
    isSigmaUnital_iff_exists_isCountablyGenerated_and_isIncreasingApproximateUnit.mpr
      ⟨atTop.map u, inferInstance, hu⟩⟩
  obtain ⟨h, hh⟩ := isSigmaUnital_iff_exists_isStrictlyPositive.mp hA
  exact ⟨resolventApprox h, monotone_resolventApprox hh.nonneg,
    resolventApprox_nonneg hh.nonneg, norm_resolventApprox_lt_one hh.nonneg,
    isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox.mp hh⟩

/-- Every unital C⋆-algebra is σ-unital. -/
instance instIsSigmaUnitalOfUnital {A : Type*} [CStarAlgebra A] : IsSigmaUnital A :=
  ⟨⟨pure 1, inferInstance, .pure_one A⟩⟩

/-- Every separable C⋆-algebra is σ-unital (and hence possesses a strictly positive element and a
monotone sequential increasing approximate unit). -/
instance instIsSigmaUnitalOfSeparableSpace {A : Type*} [NonUnitalCStarAlgebra A]
    [TopologicalSpace.SeparableSpace A] : IsSigmaUnital A := by
  let _ : PartialOrder A := CStarAlgebra.spectralOrder A
  have : StarOrderedRing A := CStarAlgebra.spectralOrderedRing A
  rw [isSigmaUnital_iff_exists_isStrictlyPositive]
  obtain ⟨v, hv⟩ := TopologicalSpace.exists_dense_seq A
  refine exists_isStrictlyPositive_of_forall_toGNS_eq_zero v fun φ hφ => ?_
  refine PositiveLinearMap.eq_zero_of_forall_toGNS_eq_zero fun a => ?_
  have hcl : Set.range v ⊆ φ.toGNS ⁻¹' {0} := by
    rintro _ ⟨n, rfl⟩
    exact hφ n
  exact closure_minimal hcl (isClosed_singleton.preimage φ.toGNS.continuous) (hv a)

/-- Surjective star-algebra homomorphisms carry σ-unitality to the codomain; in particular
quotients of σ-unital C⋆-algebras are σ-unital. -/
theorem IsSigmaUnital.of_surjective {A B F : Type*} [NonUnitalCStarAlgebra A] [IsSigmaUnital A]
    [NonUnitalCStarAlgebra B] [FunLike F A B] [NonUnitalAlgHomClass F ℂ A B] [StarHomClass F A B]
    (f : F) (hf : Function.Surjective f) :
    IsSigmaUnital B := by
  obtain ⟨l, hcg, hl⟩ := IsSigmaUnital.exists_isCountablyGenerated_and_isApproximateUnit (A := A)
  exact ⟨⟨l.map f, inferInstance, hl.map f (map_continuous f) hf⟩⟩

/-- Quotients of σ-unital C⋆-algebras by closed two-sided ideals are σ-unital. -/
instance instIsSigmaUnitalQuotient {A : Type*} [NonUnitalCStarAlgebra A] [IsSigmaUnital A]
    (I : TwoSidedIdeal A) [IsClosed (I : Set A)] : IsSigmaUnital (A ⧸ I) :=
  IsSigmaUnital.of_surjective (TwoSidedIdeal.Quotient.mkStarAlgHom I)
    (TwoSidedIdeal.Quotient.mkStarAlgHom_surjective I)

/-- Star-algebra equivalences preserve σ-unitality in both directions. -/
theorem _root_.StarAlgEquiv.isSigmaUnital_iff {A B : Type*} [NonUnitalCStarAlgebra A]
    [NonUnitalCStarAlgebra B] (e : A ≃⋆ₐ[ℂ] B) :
    IsSigmaUnital A ↔ IsSigmaUnital B :=
  ⟨fun _ => IsSigmaUnital.of_surjective e e.surjective,
    fun _ => IsSigmaUnital.of_surjective e.symm e.symm.surjective⟩

end SigmaUnital

end TauCeti.CStarAlgebra
