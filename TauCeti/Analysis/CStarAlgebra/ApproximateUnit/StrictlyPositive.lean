/-!
# Strictly positive elements and σ-unital C⋆-algebras

An element `h` of a possibly nonunital C⋆-algebra `A` is *strictly positive*,
`TauCeti.CStarAlgebra.IsStrictlyPositive h`, when `0 ≤ h` and `h A h` is dense in `A` (that is, the
hereditary C⋆-subalgebra `(h A h)⁻` generated by `h` is all of `A`). Mathlib's unital predicate
`_root_.IsStrictlyPositive` requires `0 ≤ h ∧ IsUnit h`; on a unital C⋆-algebra the two notions
coincide (`TauCeti.CStarAlgebra.isStrictlyPositive_iff_unital`), whereas in a nonunital algebra no
element is a unit.

## Main definitions and results

* `TauCeti.CStarAlgebra.IsStrictlyPositive`: `0 ≤ h ∧ Dense (Set.range fun x : A => h * x * h)`,
  together with basic properties (`nonneg`, `isSelfAdjoint`, `isStrictlyPositive_zero_iff`, `smul`,
  `map`, `isStrictlyPositive_iff_unital`, `isStrictlyPositive_one`).
* `TauCeti.CStarAlgebra.resolventApprox`: the resolvent sequence
  `h * (h + (n + 1)⁻¹)⁻¹ = cfcₙ (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) h`, with positivity,
  strict contractive norm bound, monotonicity, algebraic identity, unitization inverse formula and
  norm bound `‖resolventApprox h n * h - h‖ ≤ ((n : ℝ) + 1)⁻¹`.
* Equivalent characterizations of strict positivity (Blackadar II.4.2.4):
  * `isStrictlyPositive_iff_dense_range_mul_left` and `isStrictlyPositive_iff_dense_range_mul_right`
    (for `0 ≤ h`): density of `h A` or `A h`;
  * `isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox` (without assuming `0 ≤ h`,
    since nonnegativity is recovered from the quasispectrum of `h`) and
    `isStrictlyPositive_iff_isApproximateUnit_resolventApprox` (for `0 ≤ h`);
  * `isStrictlyPositive_iff_forall_positiveLinearMap_pos` and
    `isStrictlyPositive_iff_forall_positiveContinuousLinearMap_pos` (without assuming `0 ≤ h`):
    `0 < φ h` for every nonzero positive linear functional `φ`.
* `TauCeti.CStarAlgebra.IsSigmaUnital`: typeclass asserting the existence of a countably generated
  approximate unit, characterized equivalently by existence of a strictly positive element
  (`isSigmaUnital_iff_exists_isStrictlyPositive`), a countably generated increasing approximate unit
  (`isSigmaUnital_iff_exists_increasingApproximateUnit`), or a monotone sequential increasing
  approximate unit (`isSigmaUnital_iff_exists_seq_increasingApproximateUnit`), with instances for
  unital and separable C⋆-algebras and preservation under surjective star homomorphisms.

## References

* B. Blackadar, *Operator Algebras*, II.4.2.1, II.4.2.4 and II.4.2.5.
* G. K. Pedersen, *C⋆-Algebras and Their Automorphism Groups*, §3.10.
-/

public section

open Filter Set Topology Unitization WeakDual
open scoped ComplexOrder NNReal CStarAlgebra

namespace TauCeti.CStarAlgebra

section Basic

/-- An element `h` of a possibly nonunital C⋆-algebra `A` is *strictly positive* if `0 ≤ h` and
`h A h` is dense in `A`. On a unital C⋆-algebra this agrees with `_root_.IsStrictlyPositive h`
(`0 ≤ h ∧ IsUnit h`); see `TauCeti.CStarAlgebra.isStrictlyPositive_iff_unital`. -/
def IsStrictlyPositive {A : Type*} [TopologicalSpace A] [Mul A] [LE A] [Zero A] (h : A) : Prop :=
  0 ≤ h ∧ Dense (Set.range fun x : A => h * x * h)

namespace IsStrictlyPositive

theorem nonneg {A : Type*} [TopologicalSpace A] [Mul A] [LE A] [Zero A] {h : A}
    (hh : IsStrictlyPositive h) : 0 ≤ h :=
  hh.1

theorem denseRange_mul_mul {A : Type*} [TopologicalSpace A] [Mul A] [LE A] [Zero A] {h : A}
    (hh : IsStrictlyPositive h) : Dense (Set.range fun x : A => h * x * h) :=
  hh.2

theorem isSelfAdjoint {A : Type*} [TopologicalSpace A] [NonUnitalSemiring A] [PartialOrder A]
    [StarRing A] [StarOrderedRing A] {h : A} (hh : IsStrictlyPositive h) : IsSelfAdjoint h :=
  hh.nonneg.isSelfAdjoint

/-- Zero is strictly positive if and only if the algebra is a subsingleton. -/
@[simp]
theorem _root_.TauCeti.CStarAlgebra.isStrictlyPositive_zero_iff {A : Type*} [TopologicalSpace A]
    [MulZeroClass A] [PartialOrder A] [T1Space A] :
    IsStrictlyPositive (0 : A) ↔ Subsingleton A := by
  refine ⟨fun ⟨_, hdense⟩ => ⟨fun x y => ?_⟩, fun _ => ⟨le_rfl, fun x => ?_⟩⟩
  · have hsub : closure (Set.range fun z : A => (0 : A) * z * 0) ⊆ {(0 : A)} :=
      closure_minimal (by rintro _ ⟨_, rfl⟩; simp) isClosed_singleton
    rw [mem_singleton_iff.mp (hsub (hdense x)), mem_singleton_iff.mp (hsub (hdense y))]
  · exact subset_closure ⟨0, by simp [Subsingleton.elim x 0]⟩

theorem ne_zero {A : Type*} [TopologicalSpace A] [MulZeroClass A] [PartialOrder A] [T1Space A]
    [Nontrivial A] {h : A} (hh : IsStrictlyPositive h) : h ≠ 0 := by
  rintro rfl
  exact not_subsingleton A (isStrictlyPositive_zero_iff.mp hh)

/-- Scaling a strictly positive element by a positive real scalar preserves strict positivity. -/
theorem smul {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
    {h : A} (hh : IsStrictlyPositive h) {c : ℝ} (hc : 0 < c) :
    IsStrictlyPositive (c • h) := by
  refine ⟨smul_nonneg hc.le hh.nonneg, ?_⟩
  have hrange : (Set.range fun x : A => (c • h) * x * (c • h)) =
      Set.range fun x : A => h * x * h := by
    ext y
    refine ⟨?_, ?_⟩
    · rintro ⟨x, rfl⟩
      exact ⟨(c * c) • x, by simp [smul_mul_assoc, mul_smul_comm, smul_smul]⟩
    · rintro ⟨x, rfl⟩
      exact ⟨(c⁻¹ * c⁻¹) • x, by simp [smul_mul_assoc, mul_smul_comm, smul_smul, hc.ne']⟩
  rw [hrange]
  exact hh.denseRange_mul_mul

/-- Surjective star-algebra homomorphisms map strictly positive elements to strictly positive
elements. -/
theorem map {A B F : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
    [NonUnitalCStarAlgebra B] [PartialOrder B] [StarOrderedRing B]
    [FunLike F A B] [NonUnitalAlgHomClass F ℂ A B] [StarHomClass F A B]
    {h : A} (hh : IsStrictlyPositive h) (f : F) (hf : Function.Surjective f) :
    IsStrictlyPositive (f h) := by
  refine ⟨map_nonneg f hh.nonneg, Metric.dense_iff.mpr fun b ε hε => ?_⟩
  obtain ⟨a, rfl⟩ := hf b
  obtain ⟨_, hdist, ⟨x, rfl⟩⟩ := Metric.dense_iff.mp hh.denseRange_mul_mul a ε hε
  refine ⟨f h * f x * f h, ?_, ⟨f x, rfl⟩⟩
  rw [Metric.mem_ball, dist_eq_norm, ← map_mul, ← map_mul, ← map_sub]
  exact (NonUnitalStarAlgHom.norm_apply_le f _).trans_lt (by simpa [dist_eq_norm] using hdist)

end IsStrictlyPositive

/-- On a unital C⋆-algebra, `TauCeti.CStarAlgebra.IsStrictlyPositive h` (`0 ≤ h` and `h A h` dense)
is equivalent to Mathlib's `_root_.IsStrictlyPositive h` (`0 ≤ h ∧ IsUnit h`). -/
theorem isStrictlyPositive_iff_unital {A : Type*} [CStarAlgebra A] [PartialOrder A] {h : A} :
    IsStrictlyPositive h ↔ _root_.IsStrictlyPositive h := by
  refine ⟨fun ⟨hh₀, hdense⟩ => ⟨hh₀, ?_⟩, fun ⟨hh₀, hu⟩ => ⟨hh₀, ?_⟩⟩
  · obtain ⟨_, hball, ⟨x, rfl⟩⟩ := Metric.dense_iff.mp hdense 1 1 zero_lt_one
    have hnorm : ‖1 - h * x * h‖ < 1 := by simpa [Metric.mem_ball, dist_eq_norm'] using hball
    obtain ⟨u, hu⟩ := isUnit_one_sub_of_norm_lt_one hnorm
    have hux : (u : A) = h * x * h := hu.trans (sub_sub_cancel 1 (h * x * h))
    have hr : h * (x * h * ↑u⁻¹) = 1 := by
      rw [← mul_assoc, ← mul_assoc, ← hux, u.mul_inv]
    have hl : (↑u⁻¹ * h * x) * h = 1 := by
      calc (↑u⁻¹ * h * x) * h = ↑u⁻¹ * (h * x * h) := by simp only [mul_assoc]
        _ = 1 := by rw [← hux, u.inv_mul]
    have hlr : ↑u⁻¹ * h * x = x * h * ↑u⁻¹ := by
      calc ↑u⁻¹ * h * x = (↑u⁻¹ * h * x) * (h * (x * h * ↑u⁻¹)) := by rw [hr, mul_one]
        _ = ((↑u⁻¹ * h * x) * h) * (x * h * ↑u⁻¹) := by rw [← mul_assoc]
        _ = x * h * ↑u⁻¹ := by rw [hl, one_mul]
    exact ⟨⟨h, x * h * ↑u⁻¹, hr, hlr ▸ hl⟩, rfl⟩
  · obtain ⟨u, rfl⟩ := hu
    refine dense_iff_closure_eq.mpr
      (eq_univ_of_forall fun y => subset_closure ⟨↑u⁻¹ * y * ↑u⁻¹, ?_⟩)
    simp [mul_assoc]

@[simp]
theorem isStrictlyPositive_one {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A] :
    IsStrictlyPositive (1 : A) :=
  isStrictlyPositive_iff_unital.mpr _root_.isStrictlyPositive_one

end Basic

section Resolvent

/-- The resolvent sequence `h * (h + (n + 1)⁻¹)⁻¹` attached to an element `h` of a nonunital
C⋆-algebra, defined via the real nonunital continuous functional calculus as
`cfcₙ (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) h`. When `h` is strictly positive, this is a
monotone sequential increasing approximate unit of `A`. -/
noncomputable def resolventApprox {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (n : ℕ) : A :=
  cfcₙ (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) h

@[simp]
theorem resolventApprox_zero {A : Type*} [NonUnitalCStarAlgebra A] (n : ℕ) :
    resolventApprox (0 : A) n = 0 :=
  cfcₙ_apply_zero

theorem resolventApprox_isSelfAdjoint {A : Type*} [NonUnitalCStarAlgebra A] (h : A) (n : ℕ) :
    IsSelfAdjoint (resolventApprox h n) :=
  IsSelfAdjoint.cfcₙ

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- For `0 ≤ h`, `resolventApprox h n` agrees with `cfcₙ (fun x : ℝ≥0 => 1 - (1 + x)⁻¹)` at
`((n : ℝ) + 1) • h`, connecting the resolvent formula to Mathlib's operator-monotone contraction. -/
theorem resolventApprox_eq_cfcₙ_one_sub {h : A} (hh : 0 ≤ h) (n : ℕ) :
    resolventApprox h n = cfcₙ (fun x : ℝ≥0 => 1 - (1 + x)⁻¹) (((n : ℝ) + 1) • h) := by
  have hc : 0 < (n : ℝ) + 1 := by positivity
  have hsh : 0 ≤ ((n : ℝ) + 1) • h := smul_nonneg hc.le hh
  rw [cfcₙ_nnreal_eq_real _ _ hsh]
  have hcongr1 : cfcₙ (fun x : ℝ => ((1 - (1 + x.toNNReal)⁻¹ : ℝ≥0) : ℝ)) (((n : ℝ) + 1) • h) =
      cfcₙ (fun x : ℝ => 1 - (1 + x)⁻¹) (((n : ℝ) + 1) • h) := by
    refine cfcₙ_congr fun x hx => ?_
    have hx₀ : 0 ≤ x := quasispectrum_nonneg_of_nonneg _ hsh x hx
    have hle : (1 + x.toNNReal)⁻¹ ≤ (1 : ℝ≥0) := inv_le_one_of_one_le₀ (by simp)
    simp [NNReal.coe_sub hle, Real.coe_toNNReal x hx₀]
  rw [hcongr1, ← cfcₙ_comp_smul ((n : ℝ) + 1) (fun x : ℝ => 1 - (1 + x)⁻¹) h ?_ (by simp)
    hh.isSelfAdjoint]
  · refine cfcₙ_congr fun t ht => ?_
    have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
    have : t + ((n : ℝ) + 1)⁻¹ ≠ 0 := by positivity
    have : 1 + ((n : ℝ) + 1) * t ≠ 0 := by positivity
    dsimp only [smul_eq_mul]
    field_simp
    ring
  · refine continuousOn_const.sub ((continuousOn_const.add continuousOn_id).inv₀ ?_)
    rintro _ ⟨t, ht, rfl⟩
    have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
    have hmul : 0 ≤ ((n : ℝ) + 1) * t := mul_nonneg hc.le ht₀
    change 1 + ((n : ℝ) + 1) * t ≠ 0
    linarith

theorem resolventApprox_nonneg {h : A} (hh : 0 ≤ h) (n : ℕ) : 0 ≤ resolventApprox h n := by
  rw [resolventApprox_eq_cfcₙ_one_sub hh n]
  exact cfcₙ_nonneg_of_predicate

theorem norm_resolventApprox_lt_one {h : A} (hh : 0 ≤ h) (n : ℕ) :
    ‖resolventApprox h n‖ < 1 := by
  rw [resolventApprox_eq_cfcₙ_one_sub hh n]
  exact norm_cfcₙ_one_sub_one_add_inv_lt_one _

/-- For `0 ≤ h`, `resolventApprox h` is monotone in `n`. -/
theorem monotone_resolventApprox {h : A} (hh : 0 ≤ h) : Monotone (resolventApprox h) := by
  intro m n hmn
  rw [resolventApprox_eq_cfcₙ_one_sub hh m, resolventApprox_eq_cfcₙ_one_sub hh n]
  have hm : 0 ≤ ((m : ℝ) + 1) • h := smul_nonneg (by positivity) hh
  have hn : 0 ≤ ((n : ℝ) + 1) • h := smul_nonneg (by positivity) hh
  have hle : ((m : ℝ) + 1) • h ≤ ((n : ℝ) + 1) • h := by
    rw [← sub_nonneg, ← sub_smul]
    exact smul_nonneg (by linarith [show (m : ℝ) ≤ n from Nat.cast_le.mpr hmn]) hh
  exact CFC.monotoneOn_one_sub_one_add_inv hm hn hle

theorem resolventApprox_le_smul {h : A} (hh : 0 ≤ h) (n : ℕ) :
    resolventApprox h n ≤ ((n : ℝ) + 1) • h := by
  have hc : 0 < (n : ℝ) + 1 := by positivity
  have hcont : ContinuousOn (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) (quasispectrum ℝ h) := by
    refine continuousOn_id.mul ((continuousOn_id.add continuousOn_const).inv₀ fun t ht => ?_)
    have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
    change t + ((n : ℝ) + 1)⁻¹ ≠ 0
    positivity
  rw [resolventApprox, ← cfcₙ_const_mul_id ((n : ℝ) + 1) h hh.isSelfAdjoint]
  refine cfcₙ_mono (fun t ht => ?_) hcont (by fun_prop) (by simp) (by simp)
  have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
  have hpos : 0 < t + ((n : ℝ) + 1)⁻¹ := by positivity
  have hmul : ((n : ℝ) + 1) * t * (t + ((n : ℝ) + 1)⁻¹) = ((n : ℝ) + 1) * t ^ 2 + t := by
    field_simp
  rw [← div_eq_mul_inv, div_le_iff₀ hpos, hmul]
  linarith [mul_nonneg hc.le (sq_nonneg t)]

/-- Algebraic resolvent identity in `A`: `(h (h + c)⁻¹) h + c • (h (h + c)⁻¹) = h` for
`c = ((n : ℝ) + 1)⁻¹`. -/
theorem resolventApprox_mul_self_add_smul {h : A} (hh : 0 ≤ h) (n : ℕ) :
    resolventApprox h n * h + ((n : ℝ) + 1)⁻¹ • resolventApprox h n = h := by
  let g : ℝ → ℝ := fun t => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹
  have hg : ContinuousOn g (quasispectrum ℝ h) := by
    refine continuousOn_id.mul ((continuousOn_id.add continuousOn_const).inv₀ fun t ht => ?_)
    have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
    change t + ((n : ℝ) + 1)⁻¹ ≠ 0
    positivity
  change cfcₙ g h * h + ((n : ℝ) + 1)⁻¹ • cfcₙ g h = h
  nth_rw 2 [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
  rw [← cfcₙ_mul g (fun t : ℝ => t) h hg (by simp [g]) (by fun_prop) (by simp),
    ← cfcₙ_smul ((n : ℝ) + 1)⁻¹ g h hg (by simp [g]),
    ← cfcₙ_add (fun x => g x * x) (fun x => ((n : ℝ) + 1)⁻¹ • g x) h
      (hg.mul continuousOn_id) (by simp [g]) (by fun_prop) (by simp [g])]
  conv_rhs => rw [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
  refine cfcₙ_congr fun t ht => ?_
  have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
  have : t + ((n : ℝ) + 1)⁻¹ ≠ 0 := by positivity
  dsimp only [g, smul_eq_mul]
  field_simp

omit [PartialOrder A] [StarOrderedRing A] in
theorem commute_resolventApprox_self (h : A) (n : ℕ) :
    Commute (resolventApprox h n) h := by
  by_cases hh : IsSelfAdjoint h
  · simpa only [resolventApprox, cfcₙ_id' ℝ h hh] using
      cfcₙ_commute_cfcₙ (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) (fun t : ℝ => t) h
  · simp [resolventApprox, cfcₙ_apply_of_not_predicate h hh]

/-- Resolvent approximation bound: `‖resolventApprox h n * h - h‖ ≤ ((n : ℝ) + 1)⁻¹`. -/
theorem norm_resolventApprox_mul_self_sub_le {h : A} (hh : 0 ≤ h) (n : ℕ) :
    ‖resolventApprox h n * h - h‖ ≤ ((n : ℝ) + 1)⁻¹ := by
  have heq : resolventApprox h n * h - h = -(((n : ℝ) + 1)⁻¹ • resolventApprox h n) := by
    rw [eq_sub_iff_add_eq.mpr (resolventApprox_mul_self_add_smul hh n)]
    abel
  rw [heq, norm_neg, norm_smul, Real.norm_of_nonneg (by positivity)]
  exact mul_le_of_le_one_right (by positivity) (norm_resolventApprox_lt_one hh n).le

/-- In the unitization `A⁺¹`, `(h : A⁺¹) + ((n : ℝ) + 1)⁻¹ • 1` is invertible for `0 ≤ h`, and
`resolventApprox h n` embeds as `(h : A⁺¹) * Ring.inverse ((h : A⁺¹) + ((n : ℝ) + 1)⁻¹ • 1)`. -/
theorem isUnit_inr_add_inv_succ {h : A} (hh : 0 ≤ h) (n : ℕ) :
    IsUnit ((h : A⁺¹) + ((n : ℝ) + 1)⁻¹ • (1 : A⁺¹)) := by
  have hh' : 0 ≤ (h : A⁺¹) := Unitization.inr_nonneg h hh
  have hne : ∀ t ∈ spectrum ℝ (h : A⁺¹), t + ((n : ℝ) + 1)⁻¹ ≠ 0 := fun t ht => by
    have : 0 ≤ t := spectrum_nonneg_of_nonneg hh' ht
    positivity
  have hcfc : cfc (fun t : ℝ => t + ((n : ℝ) + 1)⁻¹) (h : A⁺¹) =
      (h : A⁺¹) + ((n : ℝ) + 1)⁻¹ • (1 : A⁺¹) := by
    rw [cfc_add_const ((n : ℝ) + 1)⁻¹ (fun t : ℝ => t) (h : A⁺¹) (by fun_prop) hh'.isSelfAdjoint,
      cfc_id' ℝ (h : A⁺¹) hh'.isSelfAdjoint, Algebra.algebraMap_eq_smul_one]
  exact hcfc ▸ (cfcUnits (fun t : ℝ => t + ((n : ℝ) + 1)⁻¹) (h : A⁺¹) hne).isUnit

theorem inr_resolventApprox {h : A} (hh : 0 ≤ h) (n : ℕ) :
    ((resolventApprox h n : A) : A⁺¹) =
      (h : A⁺¹) * Ring.inverse ((h : A⁺¹) + ((n : ℝ) + 1)⁻¹ • (1 : A⁺¹)) := by
  have hh' : 0 ≤ (h : A⁺¹) := Unitization.inr_nonneg h hh
  have hne : ∀ t ∈ spectrum ℝ (h : A⁺¹), t + ((n : ℝ) + 1)⁻¹ ≠ 0 := fun t ht => by
    have : 0 ≤ t := spectrum_nonneg_of_nonneg hh' ht
    positivity
  have hcont : ContinuousOn (fun t : ℝ => (t + ((n : ℝ) + 1)⁻¹)⁻¹) (spectrum ℝ (h : A⁺¹)) :=
    (continuousOn_id.add continuousOn_const).inv₀ fun t ht => by
      change t + ((n : ℝ) + 1)⁻¹ ≠ 0
      exact hne t ht
  rw [resolventApprox, Unitization.real_cfcₙ_eq_cfc_inr h _,
    cfc_mul (fun t : ℝ => t) (fun t : ℝ => (t + ((n : ℝ) + 1)⁻¹)⁻¹) (h : A⁺¹) (by fun_prop) hcont,
    cfc_id' ℝ (h : A⁺¹) hh'.isSelfAdjoint,
    cfc_inv (fun t : ℝ => t + ((n : ℝ) + 1)⁻¹) (h : A⁺¹) hne (by fun_prop) hh'.isSelfAdjoint,
    cfc_add_const ((n : ℝ) + 1)⁻¹ (fun t : ℝ => t) (h : A⁺¹) (by fun_prop) hh'.isSelfAdjoint,
    cfc_id' ℝ (h : A⁺¹) hh'.isSelfAdjoint, Algebra.algebraMap_eq_smul_one]

end Resolvent

section Characterizations

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- If `0 ≤ h` and `h A` is dense in `A`, then `resolventApprox h` is an increasing approximate
unit of `A`. -/
private theorem isIncreasingApproximateUnit_resolventApprox_of_dense_mul_left {h : A} (hh : 0 ≤ h)
    (hdense : Dense (Set.range fun x : A => h * x)) :
    (atTop.map (resolventApprox h)).IsIncreasingApproximateUnit := by
  have hright : ∀ a : A, Tendsto (· * a) (atTop.map (resolventApprox h)) (𝓝 a) := by
    intro a
    rw [tendsto_map'_iff, Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨_, hball, ⟨x, rfl⟩⟩ := Metric.dense_iff.mp hdense a (ε / 3) (by positivity)
    have hax : ‖h * x - a‖ < ε / 3 := by simpa [Metric.mem_ball, dist_eq_norm] using hball
    have hlim : Tendsto (fun n : ℕ => ((n : ℝ) + 1)⁻¹ * ‖x‖) atTop (𝓝 0) := by
      simpa [one_div] using tendsto_one_div_add_atTop_nhds_zero_nat.mul_const ‖x‖
    filter_upwards [(Metric.tendsto_nhds.mp hlim (ε / 3) (by positivity))] with n hn
    have hnx : ‖resolventApprox h n * (h * x) - h * x‖ < ε / 3 := by
      rw [← mul_assoc, ← sub_mul]
      refine (norm_mul_le _ _).trans_lt ((mul_le_mul_of_nonneg_right
        (norm_resolventApprox_mul_self_sub_le hh n) (norm_nonneg x)).trans_lt ?_)
      simpa [dist_zero_right, Real.norm_of_nonneg (by positivity : 0 ≤ ((n : ℝ) + 1)⁻¹ * ‖x‖)]
        using hn
    rw [dist_eq_norm]
    calc ‖resolventApprox h n * a - a‖
        = ‖resolventApprox h n * (a - h * x) + (resolventApprox h n * (h * x) - h * x) +
            (h * x - a)‖ := by congr 1; noncomm_ring
      _ ≤ ‖resolventApprox h n * (a - h * x)‖ + ‖resolventApprox h n * (h * x) - h * x‖ +
            ‖h * x - a‖ := norm_add₃_le
      _ ≤ 1 * ‖a - h * x‖ + ‖resolventApprox h n * (h * x) - h * x‖ + ‖h * x - a‖ := by
        gcongr
        exact (norm_mul_le _ _).trans
          (mul_le_mul_of_nonneg_right (norm_resolventApprox_lt_one hh n).le (norm_nonneg _))
      _ < ε := by rw [one_mul, norm_sub_rev a (h * x)]; linarith
  have hsa : ∀ᶠ x in atTop.map (resolventApprox h), IsSelfAdjoint x :=
    eventually_map.mpr (.of_forall (resolventApprox_isSelfAdjoint h))
  exact
    { tendsto_mul_left := (CStarAlgebra.tendsto_mul_left_iff_tendsto_mul_right hsa).mpr hright
      tendsto_mul_right := hright
      eventually_nonneg := eventually_map.mpr (.of_forall (resolventApprox_nonneg hh))
      eventually_norm := eventually_map.mpr (.of_forall fun n =>
        (norm_resolventApprox_lt_one hh n).le) }

/-- Squaring `resolventApprox h` preserves the approximate unit property when `0 ≤ h`. -/
private theorem isApproximateUnit_resolventApprox_mul_self {h : A} (hh : 0 ≤ h)
    (hl : (atTop.map (resolventApprox h)).IsApproximateUnit) :
    (atTop.map (fun n => resolventApprox h n * resolventApprox h n)).IsApproximateUnit := by
  let u : ℕ → A := resolventApprox h
  have hsa : ∀ᶠ x in atTop.map (fun n => u n * u n), IsSelfAdjoint x :=
    eventually_map.mpr (.of_forall fun n => by
      simp [u, IsSelfAdjoint, star_mul, (resolventApprox_isSelfAdjoint h n).star_eq])
  have hr : ∀ a : A, Tendsto (· * a) (atTop.map (fun n => u n * u n)) (𝓝 a) := fun a => by
    rw [tendsto_map'_iff, tendsto_iff_norm_sub_tendsto_zero]
    have h1 : Tendsto (fun n => 2 * ‖u n * a - a‖) atTop (𝓝 0) := by
      simpa using (tendsto_iff_norm_sub_tendsto_zero.mp
        (tendsto_map'_iff.mp (hl.tendsto_mul_right a))).const_mul 2
    refine squeeze_zero_norm' (.of_forall fun n => ?_) h1
    rw [Real.norm_of_nonneg (norm_nonneg _)]
    calc ‖u n * u n * a - a‖ = ‖u n * (u n * a - a) + (u n * a - a)‖ := by congr 1; noncomm_ring
      _ ≤ ‖u n * (u n * a - a)‖ + ‖u n * a - a‖ := norm_add_le _ _
      _ ≤ 1 * ‖u n * a - a‖ + ‖u n * a - a‖ := by
        gcongr
        exact (norm_mul_le _ _).trans
          (mul_le_mul_of_nonneg_right (norm_resolventApprox_lt_one hh n).le (norm_nonneg _))
      _ = 2 * ‖u n * a - a‖ := by ring
  exact
    { tendsto_mul_left := (CStarAlgebra.tendsto_mul_left_iff_tendsto_mul_right hsa).mpr hr
      tendsto_mul_right := hr }

/-- If `0 ≤ h` and `resolventApprox h` is an approximate unit of `A`, then `h` is strictly
positive. -/
private theorem isStrictlyPositive_of_isApproximateUnit_resolventApprox {h : A} (hh : 0 ≤ h)
    (hl : (atTop.map (resolventApprox h)).IsApproximateUnit) :
    IsStrictlyPositive h := by
  let u : ℕ → A := resolventApprox h
  let y : ℕ → A := fun n => cfcₙ (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹ ^ 2) h
  have hy (n : ℕ) : h * y n = u n * u n ∧ y n * h = u n * u n := by
    have hg : ContinuousOn (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) (quasispectrum ℝ h) := by
      refine continuousOn_id.mul ((continuousOn_id.add continuousOn_const).inv₀ fun t ht => ?_)
      have : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
      change t + ((n : ℝ) + 1)⁻¹ ≠ 0
      positivity
    have hyc : ContinuousOn (fun t : ℝ => t * (t + ((n : ℝ) + 1)⁻¹)⁻¹ ^ 2)
        (quasispectrum ℝ h) := by
      refine continuousOn_id.mul
        (((continuousOn_id.add continuousOn_const).inv₀ fun t ht => ?_).pow 2)
      have : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh t ht
      change t + ((n : ℝ) + 1)⁻¹ ≠ 0
      positivity
    have hmul : u n * u n = cfcₙ (fun t : ℝ => (t * (t + ((n : ℝ) + 1)⁻¹)⁻¹) *
        (t * (t + ((n : ℝ) + 1)⁻¹)⁻¹)) h :=
      (cfcₙ_mul _ _ h hg (by simp) hg (by simp)).symm
    refine ⟨?_, ?_⟩
    · nth_rw 1 [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
      dsimp only [y]
      rw [← cfcₙ_mul _ _ h (by fun_prop) (by simp) hyc (by simp), hmul]
      exact cfcₙ_congr fun t _ => by ring
    · nth_rw 1 [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
      dsimp only [y]
      rw [← cfcₙ_mul _ _ h hyc (by simp) (by fun_prop) (by simp), hmul]
      exact cfcₙ_congr fun t _ => by ring
  have hu2 := isApproximateUnit_resolventApprox_mul_self hh hl
  refine ⟨hh, fun a => mem_closure_of_tendsto (tendsto_map'_iff.mp (hu2.tendsto_mul_mul a)) ?_⟩
  refine .of_forall fun n => ⟨y n * a * y n, ?_⟩
  dsimp only [Function.comp_def]
  calc h * (y n * a * y n) * h = (h * y n) * a * (y n * h) := by simp only [mul_assoc]
    _ = u n * u n * a * (u n * u n) := by rw [(hy n).1, (hy n).2]

/-- Recover `0 ≤ h` from `(atTop.map (resolventApprox h)).IsIncreasingApproximateUnit` via the
real quasispectrum of `h`. -/
private theorem nonneg_of_isIncreasingApproximateUnit_resolventApprox {h : A}
    (hl : (atTop.map (resolventApprox h)).IsIncreasingApproximateUnit) : 0 ≤ h := by
  rcases subsingleton_or_nontrivial A with _ | _
  · exact Subsingleton.elim (0 : A) h ▸ le_rfl
  obtain ⟨a, ha⟩ := exists_ne (0 : A)
  have hlim : Tendsto (fun n => resolventApprox h n * a) atTop (𝓝 a) :=
    tendsto_map'_iff.mp (hl.tendsto_mul_right a)
  have hne_ev : ∀ᶠ n in atTop, resolventApprox h n ≠ 0 := by
    filter_upwards [hlim.eventually_ne ha] with n hn h0
    exact hn (by simp [h0])
  have hnorm_ev : ∀ᶠ n in atTop, ‖resolventApprox h n‖ ≤ 1 := eventually_map.mp hl.eventually_norm
  obtain ⟨N, hN⟩ := eventually_atTop.mp (hne_ev.and hnorm_ev)
  have hh_sa : IsSelfAdjoint h := by
    by_contra hnsa
    exact (hN N le_rfl).1 (cfcₙ_apply_of_not_predicate h hnsa)
  rw [StarOrderedRing.nonneg_iff_quasispectrum_nonneg (R := ℝ) h hh_sa]
  intro t ht
  by_contra! ht_neg
  obtain ⟨k, hk⟩ := exists_nat_gt (-t)⁻¹
  let n := max N k
  obtain ⟨hne, hnorm⟩ := hN n (le_max_left N k)
  let c : ℝ := ((n : ℝ) + 1)⁻¹
  have hc_pos : 0 < c := by positivity
  have hct : c < -t := by
    have hk' : (-t)⁻¹ < (n : ℝ) + 1 :=
      hk.trans_le (by linarith [show (k : ℝ) ≤ n from Nat.cast_le.mpr (le_max_right N k)])
    exact (inv_lt_comm₀ (by linarith) (by positivity)).mp hk'
  let g : ℝ → ℝ := fun s => s * (s + c)⁻¹
  have hg_cont : ContinuousOn g (quasispectrum ℝ h) := by
    by_contra hg
    exact hne (cfcₙ_apply_of_not_continuousOn h hg)
  have hle := (norm_apply_le_norm_cfcₙ g h ht hg_cont (by simp [g]) hh_sa).trans hnorm
  have hgt : 1 < g t := by
    have htc : t + c < 0 := by linarith
    have heq : g t = (-t) / (-t - c) := by
      dsimp only [g]
      rw [div_eq_mul_inv]
      have : t + c ≠ 0 := htc.ne
      have : -t - c ≠ 0 := by linarith
      field_simp
      ring
    rw [heq, one_lt_div (by linarith)]
    linarith
  linarith [Real.le_norm_self (g t)]

/-- **Blackadar II.4.2.4 (resolvent characterization).** An element `h` of a C⋆-algebra is strictly
positive if and only if its resolvent sequence `resolventApprox h` is an increasing approximate
unit of `A` (no nonnegativity hypothesis on `h` is needed). -/
theorem isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox {h : A} :
    IsStrictlyPositive h ↔ (atTop.map (resolventApprox h)).IsIncreasingApproximateUnit := by
  refine ⟨fun hh => isIncreasingApproximateUnit_resolventApprox_of_dense_mul_left hh.nonneg ?_,
    fun hl => isStrictlyPositive_of_isApproximateUnit_resolventApprox
      (nonneg_of_isIncreasingApproximateUnit_resolventApprox hl) hl.toIsApproximateUnit⟩
  refine hh.denseRange_mul_mul.mono ?_
  rintro _ ⟨x, rfl⟩
  exact ⟨x * h, (mul_assoc h x h).symm⟩

/-- For `0 ≤ h`, `h` is strictly positive if and only if `resolventApprox h` is an approximate
unit of `A`. -/
theorem isStrictlyPositive_iff_isApproximateUnit_resolventApprox {h : A} (hh : 0 ≤ h) :
    IsStrictlyPositive h ↔ (atTop.map (resolventApprox h)).IsApproximateUnit :=
  ⟨fun hsp => (isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox.mp
    hsp).toIsApproximateUnit, isStrictlyPositive_of_isApproximateUnit_resolventApprox hh⟩

/-- **Blackadar II.4.2.4 (left ideal density).** A nonnegative element `h` is strictly positive if
and only if `h A` is dense in `A`. -/
theorem isStrictlyPositive_iff_dense_range_mul_left {h : A} (hh : 0 ≤ h) :
    IsStrictlyPositive h ↔ Dense (Set.range fun x : A => h * x) := by
  refine ⟨fun hsp => hsp.denseRange_mul_mul.mono ?_, fun hdense =>
    isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox.mpr
      (isIncreasingApproximateUnit_resolventApprox_of_dense_mul_left hh hdense)⟩
  rintro _ ⟨x, rfl⟩
  exact ⟨x * h, (mul_assoc h x h).symm⟩

/-- **Blackadar II.4.2.4 (right ideal density).** A nonnegative element `h` is strictly positive if
and only if `A h` is dense in `A`. -/
theorem isStrictlyPositive_iff_dense_range_mul_right {h : A} (hh : 0 ≤ h) :
    IsStrictlyPositive h ↔ Dense (Set.range fun x : A => x * h) := by
  rw [isStrictlyPositive_iff_dense_range_mul_left hh]
  simp only [Metric.dense_iff]
  refine ⟨fun hd a ε hε => ?_, fun hd a ε hε => ?_⟩
  · obtain ⟨_, hball, ⟨x, rfl⟩⟩ := hd (star a) ε hε
    refine ⟨star x * h, ?_, ⟨star x, rfl⟩⟩
    rw [Metric.mem_ball, dist_eq_norm, ← norm_star]
    simpa [Metric.mem_ball, dist_eq_norm, hh.isSelfAdjoint.star_eq] using hball
  · obtain ⟨_, hball, ⟨x, rfl⟩⟩ := hd (star a) ε hε
    refine ⟨h * star x, ?_, ⟨star x, rfl⟩⟩
    rw [Metric.mem_ball, dist_eq_norm, ← norm_star]
    simpa [Metric.mem_ball, dist_eq_norm, hh.isSelfAdjoint.star_eq] using hball

/-- If `h` is strictly positive, every nonzero positive linear functional takes a strictly positive
value at `h`. -/
private theorem pos_of_isStrictlyPositive {h : A} (hh : IsStrictlyPositive h) (φ : A →ₚ[ℂ] ℂ)
    (hφ : φ ≠ 0) : 0 < φ h := by
  have hnonneg : 0 ≤ φ h := map_nonneg φ hh.nonneg
  refine lt_of_le_of_ne hnonneg fun heq => hφ ?_
  have heq0 : φ h = 0 := heq.symm
  have hsq_le : h * h ≤ ‖h‖ • h := by
    conv_lhs => rw [← cfcₙ_id' ℝ h hh.isSelfAdjoint]
    rw [← cfcₙ_mul _ _ h (by fun_prop) (by simp) (by fun_prop) (by simp),
      ← cfcₙ_const_mul_id ‖h‖ h hh.isSelfAdjoint]
    refine cfcₙ_mono (fun t ht => ?_) (by fun_prop) (by fun_prop) (by simp) (by simp)
    have ht₀ : 0 ≤ t := quasispectrum_nonneg_of_nonneg h hh.nonneg t ht
    have htn : t ≤ ‖h‖ := (Real.le_norm_self t).trans
      (NonUnitalIsometricContinuousFunctionalCalculus.norm_quasispectrum_le h ht hh.isSelfAdjoint)
    exact mul_le_mul_of_nonneg_right htn ht₀
  have hφ_sq : φ (h * h) = 0 := by
    have hh_sq : 0 ≤ h * h := by
      have := star_mul_self_nonneg h
      rwa [hh.isSelfAdjoint.star_eq] at this
    have h2 : φ (h * h) ≤ 0 := (OrderHomClass.mono φ hsq_le).trans_eq (by simp [heq0])
    exact le_antisymm h2 (map_nonneg φ hh_sq)
  let L : A →ₗ[ℂ] ℂ :=
    { toFun := fun x => φ (h * x * h)
      map_add' := fun x y => by simp [mul_add, add_mul]
      map_smul' := fun c x => by simp [mul_smul_comm, smul_mul_assoc] }
  have hL_nonneg : ∀ x ∈ {x : A | 0 ≤ x}, L x = (0 : A →ₗ[ℂ] ℂ) x := by
    intro y hy
    have hy0 : 0 ≤ h * y * h := by
      have := star_left_conjugate_nonneg hy h
      rwa [hh.isSelfAdjoint.star_eq] at this
    have hyle : h * y * h ≤ ‖y‖ • (h * h) := by
      simpa [hh.isSelfAdjoint.star_eq] using
        CStarAlgebra.star_left_conjugate_le_norm_smul h y hy.isSelfAdjoint
    exact le_antisymm
      ((OrderHomClass.mono φ hyle).trans_eq (by simp [hφ_sq]))
      (map_nonneg φ hy0)
  have hL : ∀ x : A, φ (h * x * h) = 0 :=
    LinearMap.congr_fun (LinearMap.ext_on (CStarAlgebra.span_nonneg (A := A)) hL_nonneg)
  let ω : A →L[ℂ] ℂ := PositiveContinuousLinearMap.ofClass (R := ℂ) φ
  have hω : ω = 0 := ContinuousLinearMap.ext fun a => by
    have hcl : Set.range (fun x : A => h * x * h) ⊆ ω ⁻¹' {0} := by
      rintro _ ⟨x, rfl⟩
      exact hL x
    exact closure_minimal hcl (isClosed_singleton.preimage ω.continuous)
      (hh.denseRange_mul_mul a)
  ext a
  exact DFunLike.congr_fun hω a

/-- Compressing a state `ω` of a unital C⋆-algebra by a nonnegative contraction `v` produces a
positive functional in the weak-* closed unit ball taking `z` to `ω (v * z * v)`. -/
private noncomputable def compressState {B : Type*} [CStarAlgebra B] (v : B)
    (ω : WeakDual ℂ B) : WeakDual ℂ B :=
  StrongDual.toWeakDual <| (toStrongDual ω).comp <| LinearMap.mkContinuous
    ({ toFun := fun z => v * z * v
       map_add' := fun x y => by simp [mul_add, add_mul]
       map_smul' := fun c x => by simp } : B →ₗ[ℂ] B)
    (‖v‖ * ‖v‖) fun z => by
      calc ‖v * z * v‖ ≤ ‖v * z‖ * ‖v‖ := norm_mul_le _ _
        _ ≤ (‖v‖ * ‖z‖) * ‖v‖ := mul_le_mul_of_nonneg_right (norm_mul_le _ _) (norm_nonneg _)
        _ = ‖v‖ * ‖v‖ * ‖z‖ := by ring

private theorem compressState_apply {B : Type*} [CStarAlgebra B] (v : B) (ω : WeakDual ℂ B)
    (z : B) : compressState v ω z = ω (v * z * v) := by
  simp [compressState]

private theorem compressState_nonneg_and_mem_closedBall {B : Type*} [CStarAlgebra B]
    [PartialOrder B] [StarOrderedRing B] {v : B} (hv₀ : 0 ≤ v) (hv₁ : ‖v‖ ≤ 1)
    {ω : WeakDual ℂ B} (hω : ω ∈ stateSpace B) :
    (∀ z : B, 0 ≤ z → 0 ≤ compressState v ω z) ∧
      compressState v ω ∈ toStrongDual ⁻¹' Metric.closedBall 0 1 := by
  have hpos : ∀ z : B, 0 ≤ z → 0 ≤ compressState v ω z := fun z hz => by
    rw [compressState_apply]
    have hvz : 0 ≤ v * z * v := by
      have := star_left_conjugate_nonneg hz v
      rwa [hv₀.isSelfAdjoint.star_eq] at this
    exact map_nonneg_of_mem_stateSpace hω hvz
  refine ⟨hpos, ?_⟩
  simp only [Set.mem_preimage, Metric.mem_closedBall, dist_zero_right]
  have hnorm1 := WeakDual.norm_toStrongDual_eq_map_one_of_map_nonneg hpos
  have hle : ‖compressState v ω 1‖ ≤ 1 := by
    calc ‖compressState v ω 1‖ = ‖toStrongDual ω (v * 1 * v)‖ := by
          rw [compressState_apply, toStrongDual_apply]
      _ ≤ ‖toStrongDual ω‖ * ‖v * 1 * v‖ := (toStrongDual ω).le_opNorm _
      _ ≤ 1 * 1 := by
        rw [norm_toStrongDual_of_mem_stateSpace hω, mul_one v]
        exact mul_le_mul_of_nonneg_left
          ((norm_mul_le_of_le hv₁ hv₁).trans_eq (one_mul 1)) zero_le_one
      _ = 1 := one_mul 1
  simpa [Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _)] using
    (congrArg norm hnorm1).le.trans hle

omit [PartialOrder A] [StarOrderedRing A] in
private theorem exists_mem_stateSpace_compress_eq_norm_sq {u : A} (hu : IsSelfAdjoint u) (a : A) :
    ∃ ω ∈ stateSpace A⁺¹,
      ω ((1 - (u : A⁺¹)) * ((a * star a : A) : A⁺¹) * (1 - (u : A⁺¹))) =
        ((‖a - u * a‖ ^ 2 : ℝ) : ℂ) := by
  let b : A⁺¹ := ((a - u * a : A) : A⁺¹)
  obtain ⟨ω, hω, hω_eq⟩ := TauCeti.exists_mem_stateSpace_apply_eq_norm (a := b * star b)
    (mul_star_self_nonneg b)
  have hustar : star (u : A⁺¹) = (u : A⁺¹) := by rw [← Unitization.inr_star, hu.star_eq]
  have hb : b * star b = (1 - (u : A⁺¹)) * ((a * star a : A) : A⁺¹) * (1 - (u : A⁺¹)) := by
    simp only [b, Unitization.inr_sub, Unitization.inr_mul, Unitization.inr_star, star_sub,
      star_mul, hustar]
    noncomm_ring
  rw [CStarRing.norm_self_mul_star, ← sq, Unitization.norm_inr, hb] at hω_eq
  exact ⟨ω, hω, hω_eq⟩

/-- Along `atTop`, compressing any sequence of states `ω m ∈ stateSpace A⁺¹` by
`1 - ((resolventApprox h m : A) : A⁺¹)` sends `(h : A⁺¹)` to `0`. -/
private theorem tendsto_compressState_resolventApprox_self {h : A} (hh : 0 ≤ h)
    {ω : ℕ → WeakDual ℂ A⁺¹} (hω : ∀ m, ω m ∈ stateSpace A⁺¹) :
    Tendsto (fun m => compressState (1 - ((resolventApprox h m : A) : A⁺¹)) (ω m) (h : A⁺¹))
      atTop (𝓝 (0 : ℂ)) := by
  let u : ℕ → A := resolventApprox h
  let v : ℕ → A⁺¹ := fun m => 1 - (u m : A⁺¹)
  have hv_norm (m : ℕ) : ‖v m‖ ≤ 1 := (CStarAlgebra.mem_Icc_iff_norm_le_one.mp <|
    Set.sub_mem_Icc_zero_iff_right.mpr <| CStarAlgebra.inr_mem_Icc_iff_norm_le.mpr
      ⟨resolventApprox_nonneg hh m, (norm_resolventApprox_lt_one hh m).le⟩).2
  have hinv : Tendsto (fun m : ℕ => ((m : ℝ) + 1)⁻¹) atTop (𝓝 0) := by
    simpa only [one_div] using tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
  refine tendsto_iff_norm_sub_tendsto_zero.mpr <| squeeze_zero_norm' (.of_forall fun m => ?_) hinv
  rw [sub_zero, Real.norm_of_nonneg (norm_nonneg _), compressState_apply, ← toStrongDual_apply]
  have hvh : v m * (h : A⁺¹) * v m = ((h - u m * h : A) : A⁺¹) * v m := by
    simp [v, u, sub_mul, Unitization.inr_sub, Unitization.inr_mul]
  rw [hvh]
  refine ((toStrongDual (ω m)).le_opNorm _).trans ?_
  rw [norm_toStrongDual_of_mem_stateSpace (hω m), one_mul]
  calc ‖((h - u m * h : A) : A⁺¹) * v m‖ ≤ ‖((h - u m * h : A) : A⁺¹)‖ * ‖v m‖ := norm_mul_le _ _
    _ ≤ ‖u m * h - h‖ := by
      rw [Unitization.norm_inr, norm_sub_rev]
      exact mul_le_of_le_one_right (norm_nonneg _) (hv_norm m)
    _ ≤ ((m : ℝ) + 1)⁻¹ := norm_resolventApprox_mul_self_sub_le hh m

/-- Weak-* compactness step (Blackadar II.4.2.4): if `0 ≤ h` and `0 < φ h` for every nonzero
`φ : A →ₚ[ℂ] ℂ`, then `resolventApprox h m * a → a` for every `a : A`. -/
private theorem tendsto_resolventApprox_mul_of_forall_positiveLinearMap_pos {h : A} (hh : 0 ≤ h)
    (hpos : ∀ φ : A →ₚ[ℂ] ℂ, φ ≠ 0 → 0 < φ h) (a : A) :
    Tendsto (fun m => resolventApprox h m * a) atTop (𝓝 a) := by
  by_contra hnot
  obtain ⟨ε, hε, hfreq⟩ : ∃ ε > 0, ∃ᶠ m in atTop, ε ≤ ‖a - resolventApprox h m * a‖ := by
    rw [Metric.tendsto_nhds] at hnot; push Not at hnot
    obtain ⟨ε, hε, hf⟩ := hnot
    exact ⟨ε, hε, hf.mono fun m hm => by simpa [dist_eq_norm'] using hm⟩
  let u : ℕ → A := resolventApprox h
  let v : ℕ → A⁺¹ := fun m => 1 - (u m : A⁺¹)
  have hv (m : ℕ) : 0 ≤ v m ∧ ‖v m‖ ≤ 1 := CStarAlgebra.mem_Icc_iff_norm_le_one.mp <|
    Set.sub_mem_Icc_zero_iff_right.mpr <| CStarAlgebra.inr_mem_Icc_iff_norm_le.mpr
      ⟨resolventApprox_nonneg hh m, (norm_resolventApprox_lt_one hh m).le⟩
  choose ω hω_mem hω_val using fun m =>
    exists_mem_stateSpace_compress_eq_norm_sq (resolventApprox_isSelfAdjoint h m) a
  let ψ : ℕ → WeakDual ℂ A⁺¹ := fun m => compressState (v m) (ω m)
  have hψ (m : ℕ) := compressState_nonneg_and_mem_closedBall (hv m).1 (hv m).2 (hω_mem m)
  let l_bad : Filter ℕ := atTop ⊓ 𝓟 {m : ℕ | ε ≤ ‖a - u m * a‖}
  have : l_bad.NeBot := frequently_iff_neBot.mp hfreq
  obtain ⟨ψ₀, _, hcl⟩ := (WeakDual.isCompact_closedBall (0 : StrongDual ℂ A⁺¹) 1).exists_clusterPt
    (f := l_bad.map ψ) (le_principal_iff.mpr <| eventually_map.mpr <| .of_forall fun m => (hψ m).2)
  have heval (z : A⁺¹) : MapClusterPt (ψ₀ z) l_bad (fun m => ψ m z) :=
    (mapClusterPt_def.mpr hcl).continuousAt_comp (WeakBilin.eval_continuous _ z).continuousAt
  let φ₀ : A →ₚ[ℂ] ℂ := .mk₀
    ((toStrongDual ψ₀).toLinearMap.comp (Unitization.inrHom ℂ ℂ A)) fun x hx =>
      isClosed_Ici.mem_of_mapClusterPt (heval (x : A⁺¹))
        (.of_forall fun m => (hψ m).1 (x : A⁺¹) (Unitization.inr_nonneg x hx))
  have hφ₀_ne : φ₀ ≠ 0 := fun h0 => by
    have hge : ε ^ 2 ≤ ‖ψ₀ ((a * star a : A) : A⁺¹)‖ :=
      (isClosed_le continuous_const continuous_norm).mem_of_mapClusterPt
        (heval ((a * star a : A) : A⁺¹)) <|
          eventually_inf_principal.mpr <| .of_forall fun m hm => by
            change ε ^ 2 ≤ ‖ψ m ((a * star a : A) : A⁺¹)‖
            rw [compressState_apply, hω_val m, Complex.norm_real, Real.norm_of_nonneg (sq_nonneg _)]
            exact pow_le_pow_left₀ hε.le hm 2
    have hzero : ψ₀ ((a * star a : A) : A⁺¹) = 0 := DFunLike.congr_fun h0 (a * star a)
    rw [hzero, norm_zero] at hge; linarith [sq_pos_of_pos hε]
  have hlim_top := tendsto_compressState_resolventApprox_self hh hω_mem
  exact (hpos φ₀ hφ₀_ne).ne'
    (eq_of_nhds_neBot ((heval (h : A⁺¹)).clusterPt.mono (hlim_top.mono_left inf_le_left)))

/-- **Blackadar II.4.2.4 (state / positive functional characterization).** An element `h` of a
C⋆-algebra is strictly positive if and only if `0 < φ h` for every nonzero positive linear
functional `φ : A →ₚ[ℂ] ℂ` (no nonnegativity hypothesis on `h` is needed). -/
theorem isStrictlyPositive_iff_forall_positiveLinearMap_pos {h : A} :
    IsStrictlyPositive h ↔ ∀ φ : A →ₚ[ℂ] ℂ, φ ≠ 0 → 0 < φ h := by
  refine ⟨pos_of_isStrictlyPositive, fun hpos => ?_⟩
  have hh : 0 ≤ h := by
    rw [← Unitization.inr_nonneg_iff, TauCeti.nonneg_iff_forall_mem_stateSpace]
    intro ω hω
    let φ : A →ₚ[ℂ] ℂ := .mk₀
      ((toStrongDual ω).toLinearMap.comp (Unitization.inrHom ℂ ℂ A)) fun x hx =>
        map_nonneg_of_mem_stateSpace hω (Unitization.inr_nonneg x hx)
    by_cases hφ : φ = 0
    · have : ω (h : A⁺¹) = 0 := DFunLike.congr_fun hφ h
      simp [this]
    · exact (hpos φ hφ).le
  rw [isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox]
  have hright : ∀ a : A, Tendsto (· * a) (atTop.map (resolventApprox h)) (𝓝 a) := fun a =>
    tendsto_map'_iff.mpr (tendsto_resolventApprox_mul_of_forall_positiveLinearMap_pos hh hpos a)
  have hsa : ∀ᶠ x in atTop.map (resolventApprox h), IsSelfAdjoint x :=
    eventually_map.mpr (.of_forall (resolventApprox_isSelfAdjoint h))
  exact
    { tendsto_mul_left := (CStarAlgebra.tendsto_mul_left_iff_tendsto_mul_right hsa).mpr hright
      tendsto_mul_right := hright
      eventually_nonneg := eventually_map.mpr (.of_forall (resolventApprox_nonneg hh))
      eventually_norm := eventually_map.mpr (.of_forall fun n =>
        (norm_resolventApprox_lt_one hh n).le) }

/-- Continuous-functional variant of `isStrictlyPositive_iff_forall_positiveLinearMap_pos`. -/
theorem isStrictlyPositive_iff_forall_positiveContinuousLinearMap_pos {h : A} :
    IsStrictlyPositive h ↔ ∀ φ : A →P[ℂ] ℂ, φ ≠ 0 → 0 < φ h := by
  rw [isStrictlyPositive_iff_forall_positiveLinearMap_pos]
  refine ⟨fun h φ hφ => h φ.toPositiveLinearMap fun h0 =>
      hφ (by ext x; exact DFunLike.congr_fun h0 x),
    fun h φ hφ => h (.ofClass φ) fun h0 =>
      hφ (by ext x; exact DFunLike.congr_fun h0 x)⟩

end Characterizations

section SigmaUnital

/-- A C⋆-algebra `A` is *σ-unital* if it admits a countably generated approximate unit. By
`isSigmaUnital_iff_exists_isStrictlyPositive` and
`isSigmaUnital_iff_exists_seq_increasingApproximateUnit`, this is equivalent to possessing a
strictly positive element or a monotone sequential increasing approximate unit. -/
class IsSigmaUnital (A : Type*) [NonUnitalCStarAlgebra A] : Prop where
  exists_approximateUnit : ∃ l : Filter A, l.IsCountablyGenerated ∧ l.IsApproximateUnit

/-- Weighted convergent series of positive squares: if no nonzero positive functional sends every
`v n` to `0` in its GNS Hilbert space, then
`∑' n, ((1 / 2) ^ (n + 1) * (1 + ‖star (v n) * v n‖)⁻¹) • (star (v n) * v n)` is strictly
positive. -/
private theorem isStrictlyPositive_tsum_of_forall_toGNS_eq_zero {A : Type*}
    [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A] (v : ℕ → A)
    (hv : ∀ φ : A →ₚ[ℂ] ℂ, (∀ n, φ.toGNS (v n) = 0) → φ = 0) :
    ∃ h : A, IsStrictlyPositive h := by
  let c : ℕ → ℝ := fun n => ((1 : ℝ) / 2) ^ (n + 1) * (1 + ‖star (v n) * v n‖)⁻¹
  let w : ℕ → A := fun n => c n • (star (v n) * v n)
  have hc_pos (n : ℕ) : 0 < c n := by positivity
  have hw_nonneg (n : ℕ) : 0 ≤ w n := smul_nonneg (hc_pos n).le (star_mul_self_nonneg (v n))
  have hw_sum : Summable w := by
    refine .of_norm_bounded (summable_geometric_two.comp_injective Nat.succ_injective) fun n => ?_
    rw [norm_smul, Real.norm_of_nonneg (hc_pos n).le, mul_assoc]
    refine mul_le_of_le_one_right (by positivity) ?_
    rw [inv_mul_le_iff₀ (by positivity), mul_one]
    exact le_add_of_nonneg_left zero_le_one
  refine ⟨∑' n, w n, isStrictlyPositive_iff_forall_positiveLinearMap_pos.mpr fun φ hφ => ?_⟩
  have hh_nonneg : 0 ≤ ∑' n, w n := tsum_nonneg hw_nonneg
  refine lt_of_le_of_ne (map_nonneg φ hh_nonneg) fun heq => hφ (hv φ fun n => ?_)
  have hwn_le : w n ≤ ∑' k, w k := hw_sum.le_tsum n fun k _ => hw_nonneg k
  have hφ_wn : φ (w n) = 0 := le_antisymm
    ((OrderHomClass.mono φ hwn_le).trans_eq heq.symm) (map_nonneg φ (hw_nonneg n))
  rw [PositiveLinearMap.toGNS_eq_zero_iff]
  have hsmul : (c n : ℂ) * φ (star (v n) * v n) = 0 := by
    simpa [w, Complex.real_smul] using ((φ : A →ₗ[ℂ] ℂ).map_smul_of_tower (c n) _).symm.trans hφ_wn
  exact (mul_eq_zero.mp hsmul).resolve_left (Complex.ofReal_ne_zero.mpr (hc_pos n).ne')

/-- A positive linear functional whose GNS quotient map vanishes identically is zero. -/
theorem _root_.PositiveLinearMap.eq_zero_of_forall_toGNS_eq_zero {A : Type*}
    [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A] {φ : A →ₚ[ℂ] ℂ}
    (h : ∀ a : A, φ.toGNS a = 0) : φ = 0 := by
  have hnonneg : ∀ a ∈ {x : A | 0 ≤ x}, (φ : A →ₗ[ℂ] ℂ) a = (0 : A →ₗ[ℂ] ℂ) a := by
    intro a ha
    have hsq : star (CFC.sqrt a) * CFC.sqrt a = a := by
      rw [(CFC.sqrt_nonneg (a := a)).isSelfAdjoint.star_eq, CFC.sqrt_mul_sqrt_self a]
    exact hsq ▸ (φ.toGNS_eq_zero_iff (CFC.sqrt a)).mp (h (CFC.sqrt a))
  have hext := LinearMap.ext_on (CStarAlgebra.span_nonneg (A := A)) hnonneg
  ext a
  exact LinearMap.congr_fun hext a

/-- **Blackadar II.4.2.5 (strictly positive element characterization).** A C⋆-algebra is σ-unital
if and only if it contains a strictly positive element. -/
theorem isSigmaUnital_iff_exists_isStrictlyPositive {A : Type*} [NonUnitalCStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A] :
    IsSigmaUnital A ↔ ∃ h : A, IsStrictlyPositive h := by
  refine ⟨fun ⟨⟨l, hcg, hl⟩⟩ => ?_, fun ⟨h, hh⟩ => ⟨⟨atTop.map (resolventApprox h),
    inferInstance, (isStrictlyPositive_iff_isApproximateUnit_resolventApprox hh.nonneg).mp hh⟩⟩⟩
  have := hl.neBot
  obtain ⟨v, hv⟩ := Filter.exists_seq_tendsto l
  refine isStrictlyPositive_tsum_of_forall_toGNS_eq_zero v fun φ hφ => ?_
  refine PositiveLinearMap.eq_zero_of_forall_toGNS_eq_zero fun a => ?_
  have hlim : Tendsto (fun n => φ.toGNS (a * v n)) atTop (𝓝 (φ.toGNS a)) :=
    (φ.toGNS.continuous.tendsto a).comp ((hl.tendsto_mul_left a).comp hv)
  have hzero : ∀ n, φ.toGNS (a * v n) = 0 := fun n => by
    have hact : φ.gnsNonUnitalStarAlgHom a (φ.toGNS (v n)) = φ.toGNS (a * v n) := by
      simp [PositiveLinearMap.toGNS_apply]
    rw [← hact, hφ n, map_zero]
  exact (tendsto_nhds_unique (by simp [hzero]) hlim).symm

/-- A C⋆-algebra is σ-unital if and only if it admits a countably generated increasing approximate
unit. -/
theorem isSigmaUnital_iff_exists_increasingApproximateUnit {A : Type*} [NonUnitalCStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A] :
    IsSigmaUnital A ↔ ∃ l : Filter A, l.IsCountablyGenerated ∧ l.IsIncreasingApproximateUnit := by
  rw [isSigmaUnital_iff_exists_isStrictlyPositive]
  refine ⟨fun ⟨h, hh⟩ => ⟨atTop.map (resolventApprox h), inferInstance,
    isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox.mp hh⟩,
    fun ⟨l, hcg, hl⟩ => isSigmaUnital_iff_exists_isStrictlyPositive.mp ⟨⟨l, hcg,
      hl.toIsApproximateUnit⟩⟩⟩

/-- **Blackadar II.4.2.5 (monotone sequential approximate unit).** A C⋆-algebra is σ-unital if and
only if it admits a monotone sequence `u : ℕ → A` of nonnegative strict contractions forming an
increasing approximate unit. -/
theorem isSigmaUnital_iff_exists_seq_increasingApproximateUnit {A : Type*}
    [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A] :
    IsSigmaUnital A ↔ ∃ u : ℕ → A, Monotone u ∧ (∀ n, 0 ≤ u n) ∧ (∀ n, ‖u n‖ < 1) ∧
      (atTop.map u).IsIncreasingApproximateUnit := by
  refine ⟨fun hA => ?_, fun ⟨u, _, _, _, hu⟩ =>
    isSigmaUnital_iff_exists_increasingApproximateUnit.mpr ⟨atTop.map u, inferInstance, hu⟩⟩
  obtain ⟨h, hh⟩ := isSigmaUnital_iff_exists_isStrictlyPositive.mp hA
  exact ⟨resolventApprox h, monotone_resolventApprox hh.nonneg,
    resolventApprox_nonneg hh.nonneg, norm_resolventApprox_lt_one hh.nonneg,
    isStrictlyPositive_iff_isIncreasingApproximateUnit_resolventApprox.mp hh⟩

/-- Every unital C⋆-algebra is σ-unital. -/
instance instIsSigmaUnitalOfUnital {A : Type*} [CStarAlgebra A] : IsSigmaUnital A :=
  ⟨⟨pure 1, inferInstance, .pure_one A⟩⟩

/-- Every separable C⋆-algebra is σ-unital (and hence possesses a strictly positive element and a
monotone sequential increasing approximate unit). -/
instance instIsSigmaUnitalOfSeparableSpace {A : Type*} [NonUnitalCStarAlgebra A]
    [TopologicalSpace.SeparableSpace A] : IsSigmaUnital A := by
  let _ : PartialOrder A := CStarAlgebra.spectralOrder A
  have : StarOrderedRing A := CStarAlgebra.spectralOrderedRing A
  rw [isSigmaUnital_iff_exists_isStrictlyPositive]
  obtain ⟨v, hv⟩ := TopologicalSpace.exists_dense_seq A
  refine isStrictlyPositive_tsum_of_forall_toGNS_eq_zero v fun φ hφ => ?_
  refine PositiveLinearMap.eq_zero_of_forall_toGNS_eq_zero fun a => ?_
  have hcl : Set.range v ⊆ φ.toGNS ⁻¹' {0} := by
    rintro _ ⟨n, rfl⟩
    exact hφ n
  exact closure_minimal hcl (isClosed_singleton.preimage φ.toGNS.continuous) (hv a)

/-- Surjective star-algebra homomorphisms carry σ-unitality to the codomain; in particular
quotients of σ-unital C⋆-algebras are σ-unital. -/
theorem IsSigmaUnital.of_surjective {A B F : Type*} [NonUnitalCStarAlgebra A] [IsSigmaUnital A]
    [NonUnitalCStarAlgebra B] [FunLike F A B] [NonUnitalAlgHomClass F ℂ A B] [StarHomClass F A B]
    (f : F) (hf : Function.Surjective f) :
    IsSigmaUnital B := by
  obtain ⟨l, hcg, hl⟩ := IsSigmaUnital.exists_approximateUnit (A := A)
  exact ⟨⟨l.map f, inferInstance, hl.map f (map_continuous f) hf⟩⟩

end SigmaUnital

end TauCeti.CStarAlgebra
