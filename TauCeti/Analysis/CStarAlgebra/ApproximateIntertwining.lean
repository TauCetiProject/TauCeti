/-!
# Elliott's approximate intertwining theorem

This file formalizes two-algebra approximate intertwinings between sequences of possibly nonunital
star homomorphisms of C⋆-algebras and deduces Elliott's approximate intertwining theorem for
separable unital C⋆-algebras.

Given C⋆-algebras `A` and `B` (not assumed unital), sequences of star homomorphisms
`φ : ℕ → A →⋆ₙₐ[ℂ] B` and `ψ : ℕ → B →⋆ₙₐ[ℂ] A`, increasing sequences of subsets `F : ℕ → Set A`
and `G : ℕ → Set B` whose unions generate dense nonunital star subalgebras, and summable error
sequences `ε, δ : ℕ → ℝ` controlling `ψ n (φ n a) - a` on `F n` and `φ (n + 1) (ψ n b) - b` on
`G n`, `TauCeti.IsApproximateIntertwining` packages the intertwining hypotheses and yields:

* `IsApproximateIntertwining.forwardHom` and `IsApproximateIntertwining.backwardHom`: the
  pointwise limit star homomorphisms `A →⋆ₙₐ[ℂ] B` and `B →⋆ₙₐ[ℂ] A`, constructed via equicontinuous
  Cauchy propagation (`Equicontinuous.isClosed_setOfPred_cauchy_map`) and
  `NonUnitalStarAlgHom.ofTendsto`.
* `IsApproximateIntertwining.norm_forwardHom_sub_le` and
  `IsApproximateIntertwining.norm_backwardHom_sub_le`: explicit tail-series bounds for the
  distance from `φ n` and `ψ n` to the limit homomorphisms on `F n` and `G n`.
* `IsApproximateIntertwining.starAlgEquiv`: the induced star isomorphism `A ≃⋆ₐ[ℂ] B`.
* `IsApproximateIntertwining.of_summable_norm_unitary_sub` and
  `IsApproximateIntertwining.starAlgEquiv_of_summable_norm_unitary_sub_eq_conjStarAlgAut`:
  specialization to inner automorphisms `Ad(u n)` when `∑ ‖u (n + 1) - u n‖ < ∞`.
* `TauCeti.elliott_intertwining`: for unital C⋆-algebras `A` and `B` with `A` separable, if
  `φ : A →⋆ₙₐ[ℂ] B` and `ψ : B →⋆ₙₐ[ℂ] A` satisfy `ψ ∘ φ ≈ᵤ id_A` and `φ ∘ ψ ≈ᵤ id_B`, then there
  exists a star isomorphism `θ : A ≃⋆ₐ[ℂ] B` approximately unitarily equivalent to `φ`
  (separability of `B` is derived automatically from isometricity of `ψ`).

## References

* M. Rørdam, *Classification of Nuclear C⋆-Algebras*, Encyclopaedia of Mathematical Sciences
  **126**, Springer, 2002, §2.3 (Proposition 2.3.2 and Corollary 2.3.4).
* E. Kirchberg and N. C. Phillips, *Embedding of exact C⋆-algebras in the Cuntz algebra O₂*,
  J. Reine Angew. Math. **525** (2000), 17–53, Lemma 0.6.
-/

public section

open Filter Topology
open scoped CStarAlgebra

namespace TauCeti

/-- A two-algebra approximate intertwining between sequences of nonunital star homomorphisms
`φ : ℕ → A →⋆ₙₐ[ℂ] B` and `ψ : ℕ → B →⋆ₙₐ[ℂ] A` along increasing sequences of subsets
`F : ℕ → Set A` and `G : ℕ → Set B` with summable error sequences `ε, δ : ℕ → ℝ`.

The subsets `F n` and `G n` need not be finite, and only the nonunital star subalgebras generated
by their unions are required to be dense. -/
structure IsApproximateIntertwining {A B : Type*}
    [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]
    (φ : ℕ → A →⋆ₙₐ[ℂ] B) (ψ : ℕ → B →⋆ₙₐ[ℂ] A)
    (F : ℕ → Set A) (G : ℕ → Set B) (ε δ : ℕ → ℝ) : Prop where
  /-- The stages `F n` form an increasing sequence of subsets of `A`. -/
  subset_left (n : ℕ) : F n ⊆ F (n + 1)
  /-- Each forward map `φ n` sends `F n` into `G n`. -/
  mapsTo_forward (n : ℕ) : Set.MapsTo (φ n) (F n) (G n)
  /-- The stages `G n` form an increasing sequence of subsets of `B`. -/
  subset_right (n : ℕ) : G n ⊆ G (n + 1)
  /-- Each backward map `ψ n` sends `G n` into `F (n + 1)`. -/
  mapsTo_backward (n : ℕ) : Set.MapsTo (ψ n) (G n) (F (n + 1))
  /-- On `F n`, `ψ n ∘ φ n` approximates the identity within `ε n`. -/
  norm_comp_sub_le_left (n : ℕ) ⦃a : A⦄ : a ∈ F n → ‖ψ n (φ n a) - a‖ ≤ ε n
  /-- On `G n`, `φ (n + 1) ∘ ψ n` approximates the identity within `δ n`. -/
  norm_comp_sub_le_right (n : ℕ) ⦃b : B⦄ : b ∈ G n → ‖φ (n + 1) (ψ n b) - b‖ ≤ δ n
  /-- The left error bounds are summable. -/
  summable_left : Summable ε
  /-- The right error bounds are summable. -/
  summable_right : Summable δ
  /-- The nonunital star subalgebra generated by `⋃ n, F n` is dense in `A`. -/
  dense_adjoin_left : Dense (NonUnitalStarAlgebra.adjoin ℂ (⋃ n, F n) : Set A)
  /-- The nonunital star subalgebra generated by `⋃ n, G n` is dense in `B`. -/
  dense_adjoin_right : Dense (NonUnitalStarAlgebra.adjoin ℂ (⋃ n, G n) : Set B)

namespace IsApproximateIntertwining

section General

variable {A B : Type*} [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]

section WithParams

variable {φ : ℕ → A →⋆ₙₐ[ℂ] B} {ψ : ℕ → B →⋆ₙₐ[ℂ] A}
  {F : ℕ → Set A} {G : ℕ → Set B} {ε δ : ℕ → ℝ}

/-- Construct an `IsApproximateIntertwining` when `⋃ n, F n` and `⋃ n, G n` are already dense in
`A` and `B`. -/
theorem of_dense
    (hF_sub : ∀ n, F n ⊆ F (n + 1))
    (hφ_maps : ∀ n, Set.MapsTo (φ n) (F n) (G n))
    (hG_sub : ∀ n, G n ⊆ G (n + 1))
    (hψ_maps : ∀ n, Set.MapsTo (ψ n) (G n) (F (n + 1)))
    (h_left : ∀ n ⦃a⦄, a ∈ F n → ‖ψ n (φ n a) - a‖ ≤ ε n)
    (h_right : ∀ n ⦃b⦄, b ∈ G n → ‖φ (n + 1) (ψ n b) - b‖ ≤ δ n)
    (hε : Summable ε) (hδ : Summable δ)
    (hdF : Dense (⋃ n, F n)) (hdG : Dense (⋃ n, G n)) :
    IsApproximateIntertwining φ ψ F G ε δ where
  subset_left := hF_sub
  mapsTo_forward := hφ_maps
  subset_right := hG_sub
  mapsTo_backward := hψ_maps
  norm_comp_sub_le_left := h_left
  norm_comp_sub_le_right := h_right
  summable_left := hε
  summable_right := hδ
  dense_adjoin_left := hdF.mono (NonUnitalStarAlgebra.subset_adjoin ℂ _)
  dense_adjoin_right := hdG.mono (NonUnitalStarAlgebra.subset_adjoin ℂ _)

/-- Shifting the zig-zag diagram by half a step swaps the roles of the forward and backward
sequences, producing an approximate intertwining from `B` to `A`. -/
theorem shift (h : IsApproximateIntertwining φ ψ F G ε δ) :
    IsApproximateIntertwining ψ (fun n ↦ φ (n + 1)) G (fun n ↦ F (n + 1)) δ
      (fun n ↦ ε (n + 1)) where
  subset_left := h.subset_right
  mapsTo_forward := h.mapsTo_backward
  subset_right n := h.subset_left (n + 1)
  mapsTo_backward n := h.mapsTo_forward (n + 1)
  norm_comp_sub_le_left := h.norm_comp_sub_le_right
  norm_comp_sub_le_right n := h.norm_comp_sub_le_left (n + 1)
  summable_left := h.summable_right
  summable_right := (summable_nat_add_iff 1).mpr h.summable_left
  dense_adjoin_left := h.dense_adjoin_right
  dense_adjoin_right := by
    have hiUnion : (⋃ n, F (n + 1)) = ⋃ n, F n := by
      refine Set.Subset.antisymm (Set.iUnion_subset fun n ↦ Set.subset_iUnion F (n + 1)) ?_
      refine Set.iUnion_subset fun n ↦ ?_
      cases n with
      | zero => exact (h.subset_left 0).trans (Set.subset_iUnion (fun k ↦ F (k + 1)) 0)
      | succ k => exact Set.subset_iUnion (fun k ↦ F (k + 1)) k
    rw [hiUnion]
    exact h.dense_adjoin_left

/-- Monotonicity of the left stages across `m` steps. -/
theorem subset_left_add (h : IsApproximateIntertwining φ ψ F G ε δ) (n m : ℕ) :
    F n ⊆ F (n + m) := by
  induction m with
  | zero => exact Set.Subset.rfl
  | succ m ih => exact ih.trans (h.subset_left (n + m))

/-- Monotonicity of the right stages across `m` steps. -/
theorem subset_right_add (h : IsApproximateIntertwining φ ψ F G ε δ) (n m : ℕ) :
    G n ⊆ G (n + m) :=
  h.shift.subset_left_add n m

/-- On `F n`, consecutive forward maps differ in norm by at most `ε n + δ n`. -/
theorem norm_forward_succ_sub_le (h : IsApproximateIntertwining φ ψ F G ε δ) {n : ℕ} {a : A}
    (ha : a ∈ F n) : ‖φ (n + 1) a - φ n a‖ ≤ ε n + δ n := by
  have hdecomp : φ (n + 1) a - φ n a =
      φ (n + 1) (a - ψ n (φ n a)) + (φ (n + 1) (ψ n (φ n a)) - φ n a) := by
    rw [map_sub]; abel
  rw [hdecomp]
  refine (norm_add_le _ _).trans
    (add_le_add ?_ (h.norm_comp_sub_le_right n (h.mapsTo_forward n ha)))
  calc
    ‖φ (n + 1) (a - ψ n (φ n a))‖ ≤ ‖a - ψ n (φ n a)‖ :=
      NonUnitalStarAlgHom.norm_apply_le (φ (n + 1)) _
    _ = ‖ψ n (φ n a) - a‖ := norm_sub_rev _ _
    _ ≤ ε n := h.norm_comp_sub_le_left n ha

/-- On `G n`, consecutive backward maps differ in norm by at most `δ n + ε (n + 1)`. -/
theorem norm_backward_succ_sub_le (h : IsApproximateIntertwining φ ψ F G ε δ) {n : ℕ} {b : B}
    (hb : b ∈ G n) : ‖ψ (n + 1) b - ψ n b‖ ≤ δ n + ε (n + 1) :=
  h.shift.norm_forward_succ_sub_le hb

/-- For every `a : A`, the forward sequence `n ↦ φ n a` is Cauchy in `B`. -/
theorem cauchySeq_forward (h : IsApproximateIntertwining φ ψ F G ε δ) (a : A) :
    CauchySeq (fun n ↦ φ n a) := by
  -- Package `{x | CauchySeq (fun n ↦ φ n x)}` as a closed nonunital star subalgebra of `A`
  -- using completeness of `B` for algebraic closure and 1-Lipschitz equicontinuity for closedness.
  let S : NonUnitalStarSubalgebra ℂ A :=
    { carrier := {x : A | CauchySeq (fun n ↦ φ n x)}
      zero_mem' := by simp [cauchySeq_const]
      add_mem' {x y} hx hy := by
        obtain ⟨bx, hbx⟩ := cauchySeq_tendsto_of_complete hx
        obtain ⟨by_, hby⟩ := cauchySeq_tendsto_of_complete hy
        simpa only [Set.mem_ofPred_eq, map_add] using (hbx.add hby).cauchySeq
      mul_mem' {x y} hx hy := by
        obtain ⟨bx, hbx⟩ := cauchySeq_tendsto_of_complete hx
        obtain ⟨by_, hby⟩ := cauchySeq_tendsto_of_complete hy
        simpa only [Set.mem_ofPred_eq, map_mul] using (hbx.mul hby).cauchySeq
      smul_mem' c {x} hx := by
        obtain ⟨bx, hbx⟩ := cauchySeq_tendsto_of_complete hx
        simpa only [Set.mem_ofPred_eq, map_smul] using (hbx.const_smul c).cauchySeq
      star_mem' {x} hx := by
        obtain ⟨bx, hbx⟩ := cauchySeq_tendsto_of_complete hx
        simpa only [Set.mem_ofPred_eq, map_star] using hbx.star.cauchySeq }
  have hF_mem : ⋃ k, F k ⊆ (S : Set A) := by
    refine Set.iUnion_subset fun k x hx ↦ ?_
    have hd : Summable (fun m ↦ ε (m + k) + δ (m + k)) :=
      (summable_nat_add_iff k).mpr (h.summable_left.add h.summable_right)
    have hstep (m : ℕ) : dist (φ (m + k) x) (φ (m + 1 + k) x) ≤ ε (m + k) + δ (m + k) := by
      have hxk : x ∈ F (m + k) := by
        simpa only [Nat.add_comm] using h.subset_left_add k m hx
      rw [dist_comm, dist_eq_norm, Nat.add_right_comm m 1 k]
      exact h.norm_forward_succ_sub_le hxk
    obtain ⟨b, hb⟩ := cauchySeq_tendsto_of_complete
      (cauchySeq_of_dist_le_of_summable _ hstep hd)
    exact ((tendsto_add_atTop_iff_nat k).mp hb).cauchySeq
  have hadj : (NonUnitalStarAlgebra.adjoin ℂ (⋃ k, F k) : Set A) ⊆ (S : Set A) :=
    NonUnitalStarAlgebra.adjoin_le hF_mem
  have hequi : Equicontinuous (fun n (x : A) ↦ φ n x) := by
    refine Metric.equicontinuous_of_continuity_modulus id tendsto_id
      (fun n (x : A) ↦ φ n x) fun x y n ↦ ?_
    simpa only [id_eq, dist_eq_norm, ← map_sub] using
      NonUnitalStarAlgHom.norm_apply_le (φ n) (x - y)
  have hclosed : IsClosed (S : Set A) := hequi.isClosed_setOfPred_cauchy_map
  exact hclosed.closure_subset_iff.mpr hadj (h.dense_adjoin_left a)

/-- For every `b : B`, the backward sequence `n ↦ ψ n b` is Cauchy in `A`. -/
theorem cauchySeq_backward (h : IsApproximateIntertwining φ ψ F G ε δ) (b : B) :
    CauchySeq (fun n ↦ ψ n b) :=
  h.shift.cauchySeq_forward b

/-- The forward limit star homomorphism `A →⋆ₙₐ[ℂ] B` of an approximate intertwining, defined as
the pointwise limit of `φ n`. -/
noncomputable def forwardHom (h : IsApproximateIntertwining φ ψ F G ε δ) : A →⋆ₙₐ[ℂ] B :=
  NonUnitalStarAlgHom.ofTendsto
    (fun a ↦ Classical.choose (cauchySeq_tendsto_of_complete (h.cauchySeq_forward a))) φ
    (tendsto_pi_nhds.mpr fun a ↦
      Classical.choose_spec (cauchySeq_tendsto_of_complete (h.cauchySeq_forward a)))

/-- The forward maps `φ n` converge pointwise to `h.forwardHom`. -/
theorem tendsto_forwardHom (h : IsApproximateIntertwining φ ψ F G ε δ) (a : A) :
    Tendsto (fun n ↦ φ n a) atTop (𝓝 (h.forwardHom a)) := by
  simpa only [forwardHom, NonUnitalStarAlgHom.ofTendsto_apply] using
    Classical.choose_spec (cauchySeq_tendsto_of_complete (h.cauchySeq_forward a))

/-- Pointwise uniqueness characterization of `h.forwardHom a`. -/
theorem forwardHom_apply_eq_of_tendsto (h : IsApproximateIntertwining φ ψ F G ε δ) {a : A}
    {b : B} (hb : Tendsto (fun n ↦ φ n a) atTop (𝓝 b)) : h.forwardHom a = b :=
  tendsto_nhds_unique (h.tendsto_forwardHom a) hb

/-- Uniqueness characterization of `h.forwardHom` from pointwise convergence. -/
theorem forwardHom_eq_of_tendsto (h : IsApproximateIntertwining φ ψ F G ε δ) {f : A →⋆ₙₐ[ℂ] B}
    (hf : ∀ a, Tendsto (fun n ↦ φ n a) atTop (𝓝 (f a))) : h.forwardHom = f :=
  DFunLike.ext _ _ fun a ↦ h.forwardHom_apply_eq_of_tendsto (hf a)

/-- The backward limit star homomorphism `B →⋆ₙₐ[ℂ] A` of an approximate intertwining, defined as
the pointwise limit of `ψ n`. -/
noncomputable def backwardHom (h : IsApproximateIntertwining φ ψ F G ε δ) : B →⋆ₙₐ[ℂ] A :=
  h.shift.forwardHom

/-- The backward maps `ψ n` converge pointwise to `h.backwardHom`. -/
theorem tendsto_backwardHom (h : IsApproximateIntertwining φ ψ F G ε δ) (b : B) :
    Tendsto (fun n ↦ ψ n b) atTop (𝓝 (h.backwardHom b)) :=
  h.shift.tendsto_forwardHom b

/-- Pointwise uniqueness characterization of `h.backwardHom b`. -/
theorem backwardHom_apply_eq_of_tendsto (h : IsApproximateIntertwining φ ψ F G ε δ) {b : B}
    {a : A} (ha : Tendsto (fun n ↦ ψ n b) atTop (𝓝 a)) : h.backwardHom b = a :=
  h.shift.forwardHom_apply_eq_of_tendsto ha

/-- Uniqueness characterization of `h.backwardHom` from pointwise convergence. -/
theorem backwardHom_eq_of_tendsto (h : IsApproximateIntertwining φ ψ F G ε δ) {g : B →⋆ₙₐ[ℂ] A}
    (hg : ∀ b, Tendsto (fun n ↦ ψ n b) atTop (𝓝 (g b))) : h.backwardHom = g :=
  h.shift.forwardHom_eq_of_tendsto hg

/-- Shifting an approximate intertwining swaps `forwardHom` and `backwardHom`: the shifted
forward map is `h.backwardHom`. -/
@[simp]
theorem shift_forwardHom (h : IsApproximateIntertwining φ ψ F G ε δ) :
    h.shift.forwardHom = h.backwardHom :=
  (rfl)

/-- Shifting an approximate intertwining swaps `forwardHom` and `backwardHom`: the shifted
backward map is `h.forwardHom`. -/
@[simp]
theorem shift_backwardHom (h : IsApproximateIntertwining φ ψ F G ε δ) :
    h.shift.backwardHom = h.forwardHom :=
  h.shift.backwardHom_eq_of_tendsto fun a ↦
    (tendsto_add_atTop_iff_nat 1).mpr (h.tendsto_forwardHom a)

/-- Tail-error estimate for the forward limit map: for `a ∈ F n`, the norm distance between
`h.forwardHom a` and `φ n a` is bounded by `∑' m, (ε (n + m) + δ (n + m))`. -/
theorem norm_forwardHom_sub_le (h : IsApproximateIntertwining φ ψ F G ε δ) {n : ℕ} {a : A}
    (ha : a ∈ F n) : ‖h.forwardHom a - φ n a‖ ≤ ∑' m, (ε (n + m) + δ (n + m)) := by
  have hd : Summable (fun m ↦ ε (n + m) + δ (n + m)) := by
    simpa only [Nat.add_comm n] using
      (summable_nat_add_iff n).mpr (h.summable_left.add h.summable_right)
  have hstep (m : ℕ) : dist (φ (n + m) a) (φ (n + (m + 1)) a) ≤ ε (n + m) + δ (n + m) := by
    rw [dist_comm, dist_eq_norm, ← Nat.add_assoc]
    exact h.norm_forward_succ_sub_le (h.subset_left_add n m ha)
  have hlim : Tendsto (fun m ↦ φ (n + m) a) atTop (𝓝 (h.forwardHom a)) := by
    simpa only [Nat.add_comm n] using (tendsto_add_atTop_iff_nat n).mpr (h.tendsto_forwardHom a)
  have hbound := dist_le_tsum_of_dist_le_of_tendsto₀ _ hstep hd hlim
  rwa [Nat.add_zero, dist_comm, dist_eq_norm] at hbound

/-- Tail-error estimate for the backward limit map: for `b ∈ G n`, the norm distance between
`h.backwardHom b` and `ψ n b` is bounded by `∑' m, (δ (n + m) + ε (n + m + 1))`. -/
theorem norm_backwardHom_sub_le (h : IsApproximateIntertwining φ ψ F G ε δ) {n : ℕ} {b : B}
    (hb : b ∈ G n) : ‖h.backwardHom b - ψ n b‖ ≤ ∑' m, (δ (n + m) + ε (n + m + 1)) :=
  h.shift.norm_forwardHom_sub_le hb

/-- The limit maps satisfy `h.backwardHom ∘ h.forwardHom = id_A`. -/
@[simp]
theorem backwardHom_comp_forwardHom (h : IsApproximateIntertwining φ ψ F G ε δ) :
    h.backwardHom.comp h.forwardHom = .id ℂ A := by
  have hF (k : ℕ) {a : A} (ha : a ∈ F k) : h.backwardHom (h.forwardHom a) = a := by
    have hnorm : Tendsto (fun m ↦ ‖ψ (m + k) (h.forwardHom a) - a‖) atTop (𝓝 0) := by
      have hsub : Tendsto (fun m ↦ ‖h.forwardHom a - φ (m + k) a‖) atTop (𝓝 0) := by
        simpa only [sub_self, norm_zero] using
          (((tendsto_add_atTop_iff_nat k).mpr (h.tendsto_forwardHom a)).const_sub
            (h.forwardHom a)).norm
      have h0 : Tendsto (fun m ↦ ‖h.forwardHom a - φ (m + k) a‖ + ε (m + k)) atTop (𝓝 0) := by
        simpa only [add_zero] using
          hsub.add ((tendsto_add_atTop_iff_nat k).mpr h.summable_left.tendsto_atTop_zero)
      refine squeeze_zero (fun _ ↦ norm_nonneg _) (fun m ↦ ?_) h0
      have hak : a ∈ F (m + k) := by simpa only [Nat.add_comm] using h.subset_left_add k m ha
      have hsplit : ψ (m + k) (h.forwardHom a) - a =
          ψ (m + k) (h.forwardHom a - φ (m + k) a) + (ψ (m + k) (φ (m + k) a) - a) := by
        rw [map_sub]; abel
      rw [hsplit]
      exact (norm_add_le _ _).trans (add_le_add
        (NonUnitalStarAlgHom.norm_apply_le (ψ (m + k)) _) (h.norm_comp_sub_le_left (m + k) hak))
    have htend : Tendsto (fun m ↦ ψ (m + k) (h.forwardHom a)) atTop (𝓝 a) :=
      tendsto_sub_nhds_zero_iff.mp (tendsto_zero_iff_norm_tendsto_zero.mpr hnorm)
    exact tendsto_nhds_unique
      ((tendsto_add_atTop_iff_nat k).mpr (h.tendsto_backwardHom (h.forwardHom a))) htend
  have hadj : (NonUnitalStarAlgebra.adjoin ℂ (⋃ k, F k) : Set A) ⊆
      (NonUnitalStarAlgHom.equalizer (h.backwardHom.comp h.forwardHom) (.id ℂ A) : Set A) :=
    NonUnitalStarAlgebra.adjoin_le (Set.iUnion_subset fun k _ ha ↦ hF k ha)
  exact DFunLike.ext'_iff.mpr <| Continuous.ext_on h.dense_adjoin_left
    (map_continuous (h.backwardHom.comp h.forwardHom))
    (map_continuous (NonUnitalStarAlgHom.id ℂ A)) fun a ha ↦
      (NonUnitalStarAlgHom.mem_equalizer _ _ a).mp (hadj ha)

/-- The limit maps satisfy `h.forwardHom ∘ h.backwardHom = id_B`. -/
@[simp]
theorem forwardHom_comp_backwardHom (h : IsApproximateIntertwining φ ψ F G ε δ) :
    h.forwardHom.comp h.backwardHom = .id ℂ B := by
  rw [← h.shift_backwardHom, ← h.shift_forwardHom]
  exact h.shift.backwardHom_comp_forwardHom

/-- The star-algebra isomorphism `A ≃⋆ₐ[ℂ] B` induced by an approximate intertwining, with
forward map `h.forwardHom` and inverse `h.backwardHom`. -/
noncomputable def starAlgEquiv (h : IsApproximateIntertwining φ ψ F G ε δ) : A ≃⋆ₐ[ℂ] B :=
  StarAlgEquiv.ofNonUnitalStarAlgHom h.forwardHom h.backwardHom
    h.backwardHom_comp_forwardHom h.forwardHom_comp_backwardHom

/-- Forgetting invertibility of `h.starAlgEquiv` gives `h.forwardHom`. -/
@[simp]
theorem toNonUnitalStarAlgHom_starAlgEquiv (h : IsApproximateIntertwining φ ψ F G ε δ) :
    h.starAlgEquiv.toNonUnitalStarAlgHom = h.forwardHom :=
  StarAlgEquiv.toNonUnitalStarAlgHom_ofNonUnitalStarAlgHom ..

/-- Forgetting invertibility of `h.starAlgEquiv.symm` gives `h.backwardHom`. -/
@[simp]
theorem toNonUnitalStarAlgHom_symm_starAlgEquiv (h : IsApproximateIntertwining φ ψ F G ε δ) :
    h.starAlgEquiv.symm.toNonUnitalStarAlgHom = h.backwardHom :=
  StarAlgEquiv.toNonUnitalStarAlgHom_symm_ofNonUnitalStarAlgHom ..

/-- Evaluating `h.starAlgEquiv` agrees with `h.forwardHom`. -/
@[simp]
theorem starAlgEquiv_apply (h : IsApproximateIntertwining φ ψ F G ε δ) (a : A) :
    h.starAlgEquiv a = h.forwardHom a :=
  DFunLike.congr_fun h.toNonUnitalStarAlgHom_starAlgEquiv a

/-- Evaluating `h.starAlgEquiv.symm` agrees with `h.backwardHom`. -/
@[simp]
theorem starAlgEquiv_symm_apply (h : IsApproximateIntertwining φ ψ F G ε δ) (b : B) :
    h.starAlgEquiv.symm b = h.backwardHom b :=
  DFunLike.congr_fun h.toNonUnitalStarAlgHom_symm_starAlgEquiv b

/-- Uniqueness characterization of `h.starAlgEquiv` from pointwise convergence of `φ n`. -/
theorem starAlgEquiv_eq_of_tendsto (h : IsApproximateIntertwining φ ψ F G ε δ) {e : A ≃⋆ₐ[ℂ] B}
    (he : ∀ a, Tendsto (fun n ↦ φ n a) atTop (𝓝 (e a))) : h.starAlgEquiv = e :=
  DFunLike.ext _ _ fun a ↦ (h.starAlgEquiv_apply a).trans (h.forwardHom_apply_eq_of_tendsto (he a))

end WithParams

/-- Any star isomorphism `e : A ≃⋆ₐ[ℂ] B` defines a constant zero-error approximate intertwining
on `Set.univ`. -/
theorem of_starAlgEquiv (e : A ≃⋆ₐ[ℂ] B) :
    IsApproximateIntertwining (fun _ ↦ e.toNonUnitalStarAlgHom)
      (fun _ ↦ e.symm.toNonUnitalStarAlgHom) (fun _ ↦ Set.univ) (fun _ ↦ Set.univ) 0 0 :=
  of_dense (fun _ ↦ Set.Subset.rfl) (fun _ _ _ ↦ trivial) (fun _ ↦ Set.Subset.rfl)
    (fun _ _ _ ↦ trivial) (fun _ _ _ ↦ by simp) (fun _ _ _ ↦ by simp)
    summable_zero summable_zero
    (by rw [Set.iUnion_const]; exact dense_univ)
    (by rw [Set.iUnion_const]; exact dense_univ)

/-- The limit isomorphism of the constant intertwining associated to `e` recovers `e`. -/
@[simp]
theorem starAlgEquiv_of_starAlgEquiv (e : A ≃⋆ₐ[ℂ] B) :
    (of_starAlgEquiv e).starAlgEquiv = e :=
  (of_starAlgEquiv e).starAlgEquiv_eq_of_tendsto fun _ ↦ tendsto_const_nhds

end General

section Unital

variable {A B : Type*} [CStarAlgebra A] [CStarAlgebra B]
  {φ : ℕ → A →⋆ₙₐ[ℂ] B} {ψ : ℕ → B →⋆ₙₐ[ℂ] A}
  {F : ℕ → Set A} {G : ℕ → Set B} {ε δ : ℕ → ℝ}

/-- Between unital C⋆-algebras, the forward limit homomorphism automatically preserves `1`, even
when the stage maps `φ n` are nonunital. -/
@[simp]
theorem forwardHom_one (h : IsApproximateIntertwining φ ψ F G ε δ) : h.forwardHom 1 = 1 := by
  rw [← h.starAlgEquiv_apply, map_one]

/-- Between unital C⋆-algebras, the backward limit homomorphism automatically preserves `1`, even
when the stage maps `ψ n` are nonunital. -/
@[simp]
theorem backwardHom_one (h : IsApproximateIntertwining φ ψ F G ε δ) : h.backwardHom 1 = 1 :=
  h.shift.forwardHom_one

end Unital

section UnitarySeq

variable {A : Type*} [CStarAlgebra A]

/-- If `u : ℕ → unitary A` has summable consecutive differences `∑ ‖u (n + 1) - u n‖ < ∞`, then
the inner automorphisms `Ad(u n)` and `Ad(star (u n))` form an approximate intertwining on the
closed unit ball of `A` with errors `0` and `2 * ‖u (n + 1) - u n‖`. -/
theorem of_summable_norm_unitary_sub {u : ℕ → unitary A}
    (hu : Summable fun n ↦ ‖(u (n + 1) : A) - (u n : A)‖) :
    IsApproximateIntertwining
      (fun n ↦ (Unitary.conjStarAlgAut ℂ A (u n)).toNonUnitalStarAlgHom)
      (fun n ↦ (Unitary.conjStarAlgAut ℂ A (star (u n))).toNonUnitalStarAlgHom)
      (fun _ ↦ Metric.closedBall 0 1) (fun _ ↦ Metric.closedBall 0 1)
      0 (fun n ↦ 2 * ‖(u (n + 1) : A) - (u n : A)‖) := by
  have hmaps (v : unitary A) : Set.MapsTo (Unitary.conjStarAlgAut ℂ A v).toNonUnitalStarAlgHom
      (Metric.closedBall 0 1) (Metric.closedBall 0 1) := fun a ha ↦ by
    simpa using (StarAlgEquiv.norm_map (Unitary.conjStarAlgAut ℂ A v) a).trans_le
      (mem_closedBall_zero_iff.mp ha)
  have hdense :
      Dense (NonUnitalStarAlgebra.adjoin ℂ (⋃ _ : ℕ, Metric.closedBall (0 : A) 1) : Set A) := by
    refine dense_iff_closure_eq.mpr (Set.eq_univ_of_forall fun a ↦ subset_closure ?_)
    rcases eq_or_ne a 0 with rfl | ha
    · exact zero_mem _
    · have hmem : (‖a‖ : ℂ)⁻¹ • a ∈ ⋃ _ : ℕ, Metric.closedBall (0 : A) 1 :=
        Set.mem_iUnion.mpr ⟨0, by simp [norm_smul, inv_mul_cancel₀ (norm_ne_zero_iff.mpr ha)]⟩
      have hsmul := SMulMemClass.smul_mem (‖a‖ : ℂ) (NonUnitalStarAlgebra.subset_adjoin ℂ _ hmem)
      rwa [smul_inv_smul₀ (Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr ha)) a] at hsmul
  refine ⟨fun _ ↦ Set.Subset.rfl, fun n ↦ hmaps (u n), fun _ ↦ Set.Subset.rfl,
    fun n ↦ hmaps (star (u n)), fun n a _ ↦ ?_, fun n b hb ↦ ?_,
    summable_zero, hu.mul_left 2, hdense, hdense⟩
  · rw [StarAlgEquiv.toNonUnitalStarAlgHom_apply, StarAlgEquiv.toNonUnitalStarAlgHom_apply,
      ← Unitary.conjStarAlgAut_symm, StarAlgEquiv.symm_apply_apply, sub_self, norm_zero,
      Pi.zero_apply]
  · have hb1 : ‖b‖ ≤ 1 := mem_closedBall_zero_iff.mp hb
    let e := Unitary.conjStarAlgAut ℂ A (u (n + 1))
    let d : A := (u n : A) - (u (n + 1) : A)
    rw [StarAlgEquiv.toNonUnitalStarAlgHom_apply, StarAlgEquiv.toNonUnitalStarAlgHom_apply,
      ← StarAlgEquiv.norm_map e.symm, map_sub, e.symm_apply_apply]
    have hdiff : Unitary.conjStarAlgAut ℂ A (star (u n)) b - e.symm b =
        star d * b * (u n : A) + star (u (n + 1) : A) * b * d := by
      simp only [e, d, Unitary.conjStarAlgAut_symm_apply, Unitary.conjStarAlgAut_apply,
        Unitary.coe_star, star_star, star_sub, sub_mul, mul_sub]
      abel
    rw [hdiff]
    calc
      ‖star d * b * (u n : A) + star (u (n + 1) : A) * b * d‖
        ≤ ‖star d * b * (u n : A)‖ + ‖star (u (n + 1) : A) * b * d‖ := norm_add_le _ _
      _ = ‖star d * b‖ + ‖b * d‖ := by
          rw [CStarRing.norm_mul_coe_unitary, mul_assoc (star (u (n + 1) : A)),
            ← Unitary.coe_star, CStarRing.norm_coe_unitary_mul]
      _ ≤ ‖d‖ * 1 + 1 * ‖d‖ :=
          add_le_add ((norm_mul_le _ _).trans (by rw [norm_star]; gcongr))
            ((norm_mul_le _ _).trans (by gcongr))
      _ = 2 * ‖(u (n + 1) : A) - (u n : A)‖ := by rw [norm_sub_rev (u (n + 1) : A)]; ring

/-- When a summable-step unitary sequence `u : ℕ → unitary A` converges to `u₀`, the induced
intertwining isomorphism is the inner automorphism `Ad(u₀)`. -/
theorem starAlgEquiv_of_summable_norm_unitary_sub_eq_conjStarAlgAut {u : ℕ → unitary A}
    (hu : Summable fun n ↦ ‖(u (n + 1) : A) - (u n : A)‖) {u₀ : unitary A}
    (hlim : Tendsto u atTop (𝓝 u₀)) :
    (of_summable_norm_unitary_sub hu).starAlgEquiv = Unitary.conjStarAlgAut ℂ A u₀ := by
  refine (of_summable_norm_unitary_sub hu).starAlgEquiv_eq_of_tendsto fun a ↦ ?_
  have hc : Tendsto (fun n ↦ (u n : A)) atTop (𝓝 (u₀ : A)) :=
    (continuous_subtype_val.tendsto u₀).comp hlim
  simpa only [StarAlgEquiv.toNonUnitalStarAlgHom_apply, Unitary.conjStarAlgAut_apply] using
    (hc.mul tendsto_const_nhds).mul hc.star

end UnitarySeq

end IsApproximateIntertwining

section ElliottIntertwining

private structure ElliottStage (A B : Type*) [CStarAlgebra A] [CStarAlgebra B] where
  F : Finset A
  v : unitary B
  G : Finset B
  u : unitary A

private noncomputable def elliottConjMap {A B : Type*} [NonUnitalCStarAlgebra A] [CStarAlgebra B]
    (φ : A →⋆ₙₐ[ℂ] B) (v : unitary B) : A →⋆ₙₐ[ℂ] B :=
  (Unitary.conjStarAlgAut ℂ B v).toNonUnitalStarAlgHom.comp φ

private lemma approximatelyUnitarilyEquivalent_elliottConjMap {A B : Type*}
    [NonUnitalCStarAlgebra A] [CStarAlgebra B] (φ : A →⋆ₙₐ[ℂ] B) (v : unitary B) :
    ApproximatelyUnitarilyEquivalent (elliottConjMap φ v) φ :=
  (ApproximatelyUnitarilyEquivalent.of_unitary v fun _ ↦ rfl).symm

private lemma exists_unitary_comp_elliottConjMap {A B : Type*} [CStarAlgebra A] [CStarAlgebra B]
    {φ : A →⋆ₙₐ[ℂ] B} {ψ : B →⋆ₙₐ[ℂ] A}
    (hψφ : ApproximatelyUnitarilyEquivalent (ψ.comp φ) (.id ℂ A))
    (v : unitary B) (F : Finset A) {ε : ℝ} (hε : 0 < ε) :
    ∃ u : unitary A, ∀ a ∈ F, ‖elliottConjMap ψ u (elliottConjMap φ v a) - a‖ ≤ ε := by
  have hA : ApproximatelyUnitarilyEquivalent (ψ.comp (elliottConjMap φ v)) (.id ℂ A) :=
    ((approximatelyUnitarilyEquivalent_elliottConjMap φ v).postcomp ψ).trans hψφ
  obtain ⟨u, hu⟩ := (approximatelyUnitarilyEquivalent_def _ _).mp hA F ε hε
  refine ⟨u, fun a ha ↦ ?_⟩
  simpa only [elliottConjMap, NonUnitalStarAlgHom.comp_apply,
    StarAlgEquiv.toNonUnitalStarAlgHom_apply, Unitary.conjStarAlgAut_apply,
    NonUnitalStarAlgHom.coe_id, id_eq] using (hu a ha).le

private noncomputable def buildElliottStage {A B : Type*} [CStarAlgebra A] [CStarAlgebra B]
    [DecidableEq A] [DecidableEq B]
    (φ : A →⋆ₙₐ[ℂ] B) (ψ : B →⋆ₙₐ[ℂ] A)
    (hψφ : ApproximatelyUnitarilyEquivalent (ψ.comp φ) (.id ℂ A))
    (hφψ : ApproximatelyUnitarilyEquivalent (φ.comp ψ) (.id ℂ B))
    (dA : ℕ → A) (dB : ℕ → B) : ℕ → ElliottStage A B
  | 0 =>
    let F₀ : Finset A := {dA 0}
    let v₀ : unitary B := 1
    let G₀ : Finset B := F₀.image (elliottConjMap φ v₀) ∪ {dB 0}
    let u₀ : unitary A := Classical.choose
      (exists_unitary_comp_elliottConjMap hψφ v₀ F₀ (ε := (1 / 2 : ℝ) ^ 0) (by positivity))
    ⟨F₀, v₀, G₀, u₀⟩
  | n + 1 =>
    let prev := buildElliottStage φ ψ hψφ hφψ dA dB n
    let F_next : Finset A := prev.F ∪ prev.G.image (elliottConjMap ψ prev.u) ∪ {dA (n + 1)}
    let v_next : unitary B := Classical.choose
      (exists_unitary_comp_elliottConjMap hφψ prev.u prev.G (ε := (1 / 2 : ℝ) ^ n) (by positivity))
    let G_next : Finset B := prev.G ∪ F_next.image (elliottConjMap φ v_next) ∪ {dB (n + 1)}
    let u_next : unitary A := Classical.choose
      (exists_unitary_comp_elliottConjMap hψφ v_next F_next
        (ε := (1 / 2 : ℝ) ^ (n + 1)) (by positivity))
    ⟨F_next, v_next, G_next, u_next⟩

private lemma isApproximateIntertwining_buildElliottStage {A B : Type*}
    [CStarAlgebra A] [CStarAlgebra B] [DecidableEq A] [DecidableEq B]
    (φ : A →⋆ₙₐ[ℂ] B) (ψ : B →⋆ₙₐ[ℂ] A)
    (hψφ : ApproximatelyUnitarilyEquivalent (ψ.comp φ) (.id ℂ A))
    (hφψ : ApproximatelyUnitarilyEquivalent (φ.comp ψ) (.id ℂ B))
    {dA : ℕ → A} {dB : ℕ → B} (hdA : DenseRange dA) (hdB : DenseRange dB) :
    IsApproximateIntertwining
      (fun n ↦ elliottConjMap φ (buildElliottStage φ ψ hψφ hφψ dA dB n).v)
      (fun n ↦ elliottConjMap ψ (buildElliottStage φ ψ hψφ hφψ dA dB n).u)
      (fun n ↦ ((buildElliottStage φ ψ hψφ hφψ dA dB n).F : Set A))
      (fun n ↦ ((buildElliottStage φ ψ hψφ hφψ dA dB n).G : Set B))
      (fun n ↦ (1 / 2 : ℝ) ^ n)
      (fun n ↦ (1 / 2 : ℝ) ^ n) := by
  refine IsApproximateIntertwining.of_dense
    (fun n a ha ↦ ?_) (fun n a ha ↦ ?_) (fun n b hb ↦ ?_) (fun n b hb ↦ ?_)
    (fun n a ha ↦ ?_) (fun n b hb ↦ ?_)
    summable_geometric_two summable_geometric_two ?_ ?_
  · exact Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_union_left _ ha))
  · cases n with
    | zero => exact Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem _ ha))
    | succ n =>
      exact Finset.mem_coe.mpr
        (Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ ha)))
  · exact Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_union_left _ hb))
  · exact Finset.mem_coe.mpr
      (Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hb)))
  · cases n with
    | zero =>
      exact Classical.choose_spec
        (exists_unitary_comp_elliottConjMap hψφ 1 {dA 0}
          (ε := (1 / 2 : ℝ) ^ 0) (by positivity)) a ha
    | succ n =>
      exact Classical.choose_spec
        (exists_unitary_comp_elliottConjMap hψφ
          (buildElliottStage φ ψ hψφ hφψ dA dB (n + 1)).v
          (buildElliottStage φ ψ hψφ hφψ dA dB (n + 1)).F
          (ε := (1 / 2 : ℝ) ^ (n + 1)) (by positivity)) a ha
  · exact Classical.choose_spec
      (exists_unitary_comp_elliottConjMap hφψ
        (buildElliottStage φ ψ hψφ hφψ dA dB n).u
        (buildElliottStage φ ψ hψφ hφψ dA dB n).G
        (ε := (1 / 2 : ℝ) ^ n) (by positivity)) b hb
  · refine hdA.mono (Set.range_subset_iff.mpr fun n ↦ Set.mem_iUnion_of_mem n ?_)
    cases n with
    | zero => exact Finset.mem_coe.mpr (Finset.mem_singleton_self _)
    | succ n => exact Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_singleton_self _))
  · refine hdB.mono (Set.range_subset_iff.mpr fun n ↦ Set.mem_iUnion_of_mem n ?_)
    cases n <;> exact Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_singleton_self _))

/-- **Elliott's approximate intertwining theorem** for two unital C⋆-algebras: if `A` is separable
and `φ : A →⋆ₙₐ[ℂ] B`, `ψ : B →⋆ₙₐ[ℂ] A` satisfy `ψ ∘ φ ≈ᵤ id_A` and `φ ∘ ψ ≈ᵤ id_B`, then there
exists a star isomorphism `θ : A ≃⋆ₐ[ℂ] B` approximately unitarily equivalent to `φ`.

Neither `φ` nor `ψ` is assumed unital, and separability of `B` is deduced automatically from
isometricity of `ψ`. See Rørdam, *Classification of Nuclear C⋆-Algebras*, Corollary 2.3.4, and
Kirchberg–Phillips, *Embedding of exact C⋆-algebras in the Cuntz algebra O₂*, Lemma 0.6. -/
theorem elliott_intertwining {A B : Type*} [CStarAlgebra A] [CStarAlgebra B]
    [TopologicalSpace.SeparableSpace A]
    (φ : A →⋆ₙₐ[ℂ] B) (ψ : B →⋆ₙₐ[ℂ] A)
    (hψφ : ApproximatelyUnitarilyEquivalent (ψ.comp φ) (.id ℂ A))
    (hφψ : ApproximatelyUnitarilyEquivalent (φ.comp ψ) (.id ℂ B)) :
    ∃ θ : A ≃⋆ₐ[ℂ] B, ApproximatelyUnitarilyEquivalent θ.toNonUnitalStarAlgHom φ := by
  classical
  have hψ_inj : Function.Injective ψ :=
    .of_comp (f := φ) (hφψ.injective_iff.mpr Function.injective_id)
  have : TopologicalSpace.SeparableSpace B :=
    (NonUnitalStarAlgHom.isometry ψ hψ_inj).isEmbedding.separableSpace
  let st := buildElliottStage φ ψ hψφ hφψ
    (TopologicalSpace.denseSeq A) (TopologicalSpace.denseSeq B)
  have hint := isApproximateIntertwining_buildElliottStage φ ψ hψφ hφψ
    (TopologicalSpace.denseRange_denseSeq A) (TopologicalSpace.denseRange_denseSeq B)
  refine ⟨hint.starAlgEquiv, ?_⟩
  refine (ApproximatelyUnitarilyEquivalent.of_tendsto (l := atTop)
    (fun n ↦ (st n).v) fun a ↦ ?_).symm
  simpa only [st, elliottConjMap, NonUnitalStarAlgHom.comp_apply,
    StarAlgEquiv.toNonUnitalStarAlgHom_apply, Unitary.conjStarAlgAut_apply,
    IsApproximateIntertwining.starAlgEquiv_apply] using hint.tendsto_forwardHom a

end ElliottIntertwining

end TauCeti
