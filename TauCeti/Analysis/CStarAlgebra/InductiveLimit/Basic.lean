/-! ### Stage-wise asymptotic C⋆-seminorm -/

section StageSeminorm

variable {ι : Type u} [Preorder ι]
  (A : ι → Type v) [∀ i, NonUnitalCStarAlgebra (A i)]
  {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*} (f : ∀ i j (h : i ≤ j), T h)
  [∀ i j (h : i ≤ j), FunLike (T h) (A i) (A j)]
  [∀ i j h, NonUnitalAlgHomClass (T h) ℂ (A i) (A j)]
  [∀ i j h, StarHomClass (T h) (A i) (A j)]
  [DirectedSystem A (f · · ·)]

/-- Because transition `⋆`-homomorphisms are contractive, `j ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) x‖` is
antitone on `Set.Ici i`. -/
theorem antitone_norm_map (i : ι) (x : A i) :
    Antitone (fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) x‖) := by
  intro j k (hjk : j.1 ≤ k.1)
  dsimp only
  rw [← DirectedSystem.map_map' f (Set.mem_Ici.mp j.2) hjk x]
  exact NonUnitalStarAlgHom.norm_apply_le (f j.1 k.1 hjk) _

omit [∀ i j h, NonUnitalAlgHomClass (T h) ℂ (A i) (A j)]
  [∀ i j h, StarHomClass (T h) (A i) (A j)] [DirectedSystem A (f · · ·)] in
private theorem bddBelow_range_norm_map (i : ι) (x : A i) :
    BddBelow (Set.range fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) x‖) :=
  ⟨0, by rintro _ ⟨_, rfl⟩; exact norm_nonneg _⟩

private theorem tendsto_ciInf_norm_map (i : ι) (x : A i) :
    Tendsto (fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) x‖) atTop
      (𝓝 (⨅ j : Set.Ici i, ‖f i j.1 (Set.mem_Ici.mp j.2) x‖)) :=
  tendsto_atTop_ciInf (antitone_norm_map A f i x) (bddBelow_range_norm_map A f i x)

variable [IsDirectedOrder ι]

/-- The asymptotic C⋆-seminorm `x ↦ ⨅ j : Set.Ici i, ‖f i j.1 (Set.mem_Ici.mp j.2) x‖` on stage
`A i` of a directed system of C⋆-algebras. -/
def stageSeminorm (i : ι) : Seminorm ℂ (A i) :=
  Seminorm.ofSMulLE (fun x ↦ ⨅ j : Set.Ici i, ‖f i j.1 (Set.mem_Ici.mp j.2) x‖)
    (by
      have h0 : (fun _ : Set.Ici i ↦ (0 : ℝ)) =
          fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) (0 : A i)‖ := by
        ext j; simp
      exact (tendsto_nhds_unique (h0 ▸ tendsto_const_nhds) (tendsto_ciInf_norm_map A f i 0)).symm)
    (fun x y ↦
      le_of_tendsto_of_tendsto (tendsto_ciInf_norm_map A f i (x + y))
        ((tendsto_ciInf_norm_map A f i x).add (tendsto_ciInf_norm_map A f i y))
        (Eventually.of_forall fun j ↦ by dsimp only; rw [map_add]; exact norm_add_le _ _))
    (fun c x ↦
      le_of_tendsto_of_tendsto (tendsto_ciInf_norm_map A f i (c • x))
        ((tendsto_ciInf_norm_map A f i x).const_mul ‖c‖)
        (Eventually.of_forall fun j ↦ by dsimp only; rw [map_smul, norm_smul]))

variable {A f}

/-- Explicit formula for `stageSeminorm A f i x` as the infimum of norms along `Set.Ici i`. -/
theorem stageSeminorm_apply (i : ι) (x : A i) :
    stageSeminorm A f i x = ⨅ j : Set.Ici i, ‖f i j.1 (Set.mem_Ici.mp j.2) x‖ :=
  (rfl)

/-- Along `Set.Ici i`, the norms `‖f i j.1 (Set.mem_Ici.mp j.2) x‖` converge to
`stageSeminorm A f i x`. -/
theorem tendsto_norm_map_atTop (i : ι) (x : A i) :
    Tendsto (fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) x‖) atTop
      (𝓝 (stageSeminorm A f i x)) :=
  tendsto_ciInf_norm_map A f i x

/-- The asymptotic seminorm at stage `i` is bounded above by the norm at any stage `j ≥ i`. -/
theorem stageSeminorm_le_norm_map {i j : ι} (hij : i ≤ j) (x : A i) :
    stageSeminorm A f i x ≤ ‖f i j hij x‖ :=
  ciInf_le (bddBelow_range_norm_map A f i x) ⟨j, hij⟩

/-- The asymptotic seminorm at stage `i` is contractive with respect to the norm of `A i`. -/
theorem stageSeminorm_le_norm (i : ι) (x : A i) : stageSeminorm A f i x ≤ ‖x‖ := by
  simpa only [DirectedSystem.map_self' f] using stageSeminorm_le_norm_map (f := f) (le_refl i) x

/-- Strict upper bound characterization for `stageSeminorm A f i x`: it is strictly less than `c`
iff some later stage `j ≥ i` has `‖f i j hij x‖ < c`. -/
theorem stageSeminorm_lt_iff {i : ι} {x : A i} {c : ℝ} :
    stageSeminorm A f i x < c ↔ ∃ j, ∃ hij : i ≤ j, ‖f i j hij x‖ < c := by
  constructor
  · intro h
    obtain ⟨⟨j, hij⟩, hj⟩ := exists_lt_of_ciInf_lt h
    exact ⟨j, Set.mem_Ici.mp hij, hj⟩
  · rintro ⟨j, hij, hj⟩
    exact (stageSeminorm_le_norm_map hij x).trans_lt hj

/-- Characterization of upper bounds for `stageSeminorm A f i x`: it is at most `c` iff for every
`ε > 0` some stage `j ≥ i` has `‖f i j hij x‖ < c + ε`. -/
theorem stageSeminorm_le_iff {i : ι} {x : A i} {c : ℝ} :
    stageSeminorm A f i x ≤ c ↔ ∀ ε > 0, ∃ j, ∃ hij : i ≤ j, ‖f i j hij x‖ < c + ε :=
  ⟨fun h _ hε ↦ stageSeminorm_lt_iff.mp (lt_add_of_le_of_pos h hε),
    fun h ↦ le_of_forall_pos_lt_add fun ε hε ↦ stageSeminorm_lt_iff.mpr (h ε hε)⟩

/-- The asymptotic seminorms are invariant under the transition maps. -/
@[simp]
theorem stageSeminorm_map {i j : ι} (hij : i ≤ j) (x : A i) :
    stageSeminorm A f j (f i j hij x) = stageSeminorm A f i x := by
  refine le_antisymm (le_ciInf fun k ↦ ?_) (le_ciInf fun k ↦ ?_)
  · obtain ⟨m, hjm, hkm⟩ := exists_ge_ge j k.1
    calc
      stageSeminorm A f j (f i j hij x) ≤ ‖f j m hjm (f i j hij x)‖ :=
        stageSeminorm_le_norm_map hjm _
      _ = ‖f k.1 m hkm (f i k.1 (Set.mem_Ici.mp k.2) x)‖ := by
        rw [DirectedSystem.map_map' f hij hjm,
          DirectedSystem.map_map' f (Set.mem_Ici.mp k.2) hkm]
      _ ≤ ‖f i k.1 (Set.mem_Ici.mp k.2) x‖ := NonUnitalStarAlgHom.norm_apply_le (f k.1 m hkm) _
  · rw [DirectedSystem.map_map' f hij (Set.mem_Ici.mp k.2)]
    exact stageSeminorm_le_norm_map (hij.trans (Set.mem_Ici.mp k.2)) x

/-- The asymptotic seminorm on `A i` is submultiplicative. -/
theorem stageSeminorm_mul_le (i : ι) (x y : A i) :
    stageSeminorm A f i (x * y) ≤ stageSeminorm A f i x * stageSeminorm A f i y :=
  le_of_tendsto_of_tendsto (tendsto_norm_map_atTop i (x * y))
    ((tendsto_norm_map_atTop i x).mul (tendsto_norm_map_atTop i y))
    (Eventually.of_forall fun j ↦ by dsimp only; rw [map_mul]; exact norm_mul_le _ _)

/-- The asymptotic seminorm on `A i` is `star`-invariant. -/
@[simp]
theorem stageSeminorm_star (i : ι) (x : A i) :
    stageSeminorm A f i (star x) = stageSeminorm A f i x := by
  simp only [stageSeminorm_apply, map_star, norm_star]

/-- The asymptotic seminorm on `A i` satisfies the C⋆-identity. -/
theorem stageSeminorm_star_mul_self (i : ι) (x : A i) :
    stageSeminorm A f i (star x * x) = stageSeminorm A f i x * stageSeminorm A f i x :=
  tendsto_nhds_unique (tendsto_norm_map_atTop i (star x * x)) <|
    ((tendsto_norm_map_atTop i x).mul (tendsto_norm_map_atTop i x)).congr fun j ↦ by
      rw [map_mul, map_star, CStarRing.norm_star_mul_self]

/-- When every transition map out of stage `i` is injective, `stageSeminorm A f i` equals the
original C⋆-norm of `A i`. -/
theorem stageSeminorm_eq_norm_of_injective {i : ι}
    (hinj : ∀ j (hij : i ≤ j), Function.Injective (f i j hij)) (x : A i) :
    stageSeminorm A f i x = ‖x‖ := by
  refine tendsto_nhds_unique (tendsto_norm_map_atTop i x) ?_
  have hconst : (fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) x‖) = fun _ ↦ ‖x‖ := by
    ext j
    exact NonUnitalStarAlgHom.norm_map (f i j.1 (Set.mem_Ici.mp j.2))
      (hinj j.1 (Set.mem_Ici.mp j.2)) x
  exact hconst ▸ tendsto_const_nhds

/-- Every compatible family of `⋆`-homomorphisms `g i : A i →⋆ₙₐ[ℂ] B` into a C⋆-algebra is
automatically bounded by `stageSeminorm A f i`. -/
theorem norm_le_stageSeminorm {B : Type w} [NonUnitalCStarAlgebra B]
    (g : ∀ i, A i →⋆ₙₐ[ℂ] B) (hg : ∀ i j hij x, g j (f i j hij x) = g i x) (i : ι) (x : A i) :
    ‖g i x‖ ≤ stageSeminorm A f i x :=
  le_ciInf fun j ↦ by
    rw [← hg i j.1 (Set.mem_Ici.mp j.2) x]
    exact NonUnitalStarAlgHom.norm_apply_le (g j.1) _

end StageSeminorm

/-! ### Seminormed algebraic direct limit -/

section SeminormedDirectLimit

variable {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
  (A : ι → Type v) [∀ i, NonUnitalCStarAlgebra (A i)]
  {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*} (f : ∀ i j (h : i ≤ j), T h)
  [∀ i j (h : i ≤ j), FunLike (T h) (A i) (A j)]
  [∀ i j h, NonUnitalAlgHomClass (T h) ℂ (A i) (A j)]
  [∀ i j h, StarHomClass (T h) (A i) (A j)]
  [DirectedSystem A (f · · ·)]

/-- The algebraic colimit `DirectLimit A f` equipped with the descended asymptotic C⋆-seminorm
`stageSeminorm A f`. Its separated Hausdorff completion is `CStarInductiveLimit A f`. -/
def SeminormedDirectLimit : Type (max u v) :=
  DirectLimit A f

namespace SeminormedDirectLimit

variable {A f}

instance : NonUnitalRing (SeminormedDirectLimit A f) :=
  inferInstanceAs (NonUnitalRing (DirectLimit A f))

instance : Module ℂ (SeminormedDirectLimit A f) :=
  inferInstanceAs (Module ℂ (DirectLimit A f))

instance : IsScalarTower ℂ (SeminormedDirectLimit A f) (SeminormedDirectLimit A f) :=
  inferInstanceAs (IsScalarTower ℂ (DirectLimit A f) (DirectLimit A f))

instance : SMulCommClass ℂ (SeminormedDirectLimit A f) (SeminormedDirectLimit A f) :=
  inferInstanceAs (SMulCommClass ℂ (DirectLimit A f) (DirectLimit A f))

instance : StarRing (SeminormedDirectLimit A f) :=
  inferInstanceAs (StarRing (DirectLimit A f))

instance : StarModule ℂ (SeminormedDirectLimit A f) :=
  inferInstanceAs (StarModule ℂ (DirectLimit A f))

variable (A f) in
/-- The `⋆`-algebra equivalence identifying `DirectLimit A f` with `SeminormedDirectLimit A f`. -/
def toSeminormed : DirectLimit A f ≃⋆ₐ[ℂ] SeminormedDirectLimit A f where
  toFun := id
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := (rfl)
  map_add' _ _ := (rfl)
  map_smul' _ _ := (rfl)
  map_star' _ := (rfl)

/-- Descend `stageSeminorm A f` to an additive-group seminorm on `SeminormedDirectLimit A f`. -/
def addGroupSeminorm : AddGroupSeminorm (SeminormedDirectLimit A f) where
  toFun z := DirectLimit.lift f (fun i x ↦ stageSeminorm A f i x)
    (fun _ _ hij x ↦ (stageSeminorm_map hij x).symm) ((toSeminormed A f).symm z)
  map_zero' := by
    let ⟨i⟩ := ‹Nonempty ι›
    rw [map_zero, DirectLimit.zero_def i, DirectLimit.lift_def, map_zero]
  add_le' z w := by
    obtain ⟨i, x, y, hx, hy⟩ := DirectLimit.exists_eq_mk₂ f ((toSeminormed A f).symm z)
      ((toSeminormed A f).symm w)
    rw [map_add, hx, hy, DirectLimit.add_def, DirectLimit.lift_def, DirectLimit.lift_def,
      DirectLimit.lift_def]
    exact map_add_le_add (stageSeminorm A f i) x y
  neg' z := by
    obtain ⟨i, x, hx⟩ := DirectLimit.exists_eq_mk f ((toSeminormed A f).symm z)
    have hneg : -(⟦⟨i, x⟩⟧ : DirectLimit A f) = ⟦⟨i, -x⟩⟧ := rfl
    rw [map_neg, hx, hneg, DirectLimit.lift_def, DirectLimit.lift_def, map_neg_eq_map]

instance : SeminormedAddCommGroup (SeminormedDirectLimit A f) :=
  @AddGroupSeminorm.toSeminormedAddCommGroup (SeminormedDirectLimit A f) _ addGroupSeminorm

@[simp]
theorem norm_toSeminormed_mk (i : ι) (x : A i) :
    ‖toSeminormed A f ⟦⟨i, x⟩⟧‖ = stageSeminorm A f i x :=
  (rfl)

instance : NormedSpace ℂ (SeminormedDirectLimit A f) where
  __ : Module ℂ (SeminormedDirectLimit A f) := inferInstance
  norm_smul_le c z := by
    obtain ⟨i, x, hx⟩ := DirectLimit.exists_eq_mk f ((toSeminormed A f).symm z)
    have hz : z = toSeminormed A f ⟦⟨i, x⟩⟧ := (toSeminormed A f).symm_apply_eq.mp hx
    rw [hz, ← map_smul, DirectLimit.smul_def, norm_toSeminormed_mk, norm_toSeminormed_mk,
      map_smul_eq_mul]

instance : NonUnitalSeminormedRing (SeminormedDirectLimit A f) where
  __ : SeminormedAddCommGroup (SeminormedDirectLimit A f) := inferInstance
  __ : NonUnitalRing (SeminormedDirectLimit A f) := inferInstance
  norm_mul_le z w := by
    obtain ⟨i, x, y, hx, hy⟩ := DirectLimit.exists_eq_mk₂ f ((toSeminormed A f).symm z)
      ((toSeminormed A f).symm w)
    have hz : z = toSeminormed A f ⟦⟨i, x⟩⟧ := (toSeminormed A f).symm_apply_eq.mp hx
    have hw : w = toSeminormed A f ⟦⟨i, y⟩⟧ := (toSeminormed A f).symm_apply_eq.mp hy
    rw [hz, hw, ← map_mul, DirectLimit.mul_def, norm_toSeminormed_mk, norm_toSeminormed_mk,
      norm_toSeminormed_mk]
    exact stageSeminorm_mul_le i x y

instance : NormedStarGroup (SeminormedDirectLimit A f) where
  norm_star_le z := by
    obtain ⟨i, x, hx⟩ := DirectLimit.exists_eq_mk f ((toSeminormed A f).symm z)
    have hz : z = toSeminormed A f ⟦⟨i, x⟩⟧ := (toSeminormed A f).symm_apply_eq.mp hx
    rw [hz, ← map_star, DirectLimit.star_def, norm_toSeminormed_mk, norm_toSeminormed_mk,
      stageSeminorm_star]

theorem norm_star_mul_self (z : SeminormedDirectLimit A f) : ‖star z * z‖ = ‖z‖ * ‖z‖ := by
  obtain ⟨i, x, hx⟩ := DirectLimit.exists_eq_mk f ((toSeminormed A f).symm z)
  have hz : z = toSeminormed A f ⟦⟨i, x⟩⟧ := (toSeminormed A f).symm_apply_eq.mp hx
  rw [hz, ← map_star, ← map_mul, DirectLimit.star_def, DirectLimit.mul_def,
    norm_toSeminormed_mk, norm_toSeminormed_mk, stageSeminorm_star_mul_self]

instance : CStarRing (Completion (SeminormedDirectLimit A f)) :=
  Completion.cstarRing fun z ↦ (norm_star_mul_self z).ge

instance : NonUnitalCStarAlgebra (Completion (SeminormedDirectLimit A f)) where

end SeminormedDirectLimit

end SeminormedDirectLimit

end CStarInductiveLimit

/-! ### Definition and C⋆-algebra instances of `CStarInductiveLimit` -/

section Def

variable {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
  (A : ι → Type v) [∀ i, NonUnitalCStarAlgebra (A i)]
  {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*} (f : ∀ i j (h : i ≤ j), T h)
  [∀ i j (h : i ≤ j), FunLike (T h) (A i) (A j)]
  [∀ i j h, NonUnitalAlgHomClass (T h) ℂ (A i) (A j)]
  [∀ i j h, StarHomClass (T h) (A i) (A j)]
  [DirectedSystem A (f · · ·)]

/-- The **C⋆-inductive limit** of a directed system `(A i, f i j)` of (possibly nonunital) complex
C⋆-algebras and `⋆`-homomorphisms (including noninjective connecting maps), constructed as the
separated completion of `SeminormedDirectLimit A f`.

When each `A i` is a unital `CStarAlgebra` and the transition maps satisfy `AlgHomClass` (for
instance `f i j h : A i →⋆ₐ[ℂ] A j`), this same type automatically carries a `CStarAlgebra`
instance whose underlying `NonUnitalCStarAlgebra` structure is definitionally equal to the
nonunital one. -/
def CStarInductiveLimit : Type (max u v) :=
  Completion (CStarInductiveLimit.SeminormedDirectLimit A f)

end Def

namespace CStarInductiveLimit

open SeminormedDirectLimit

section NonUnital

variable {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
  {A : ι → Type v} [∀ i, NonUnitalCStarAlgebra (A i)]
  {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*} {f : ∀ i j (h : i ≤ j), T h}
  [∀ i j (h : i ≤ j), FunLike (T h) (A i) (A j)]
  [∀ i j h, NonUnitalAlgHomClass (T h) ℂ (A i) (A j)]
  [∀ i j h, StarHomClass (T h) (A i) (A j)]
  [DirectedSystem A (f · · ·)]

/-- The C⋆-inductive limit of a directed system of nonunital C⋆-algebras is a nonunital
C⋆-algebra. -/
instance instNonUnitalCStarAlgebra : NonUnitalCStarAlgebra (CStarInductiveLimit A f) :=
  inferInstanceAs (NonUnitalCStarAlgebra (Completion (SeminormedDirectLimit A f)))

/-! ### Canonical maps, norm formula, kernels, and density -/

variable (A f) in
/-- The canonical `⋆`-algebra homomorphism from the algebraic `DirectLimit A f` into
`CStarInductiveLimit A f`, with dense range and norm `stageSeminorm A f` on representatives. -/
def fromDirectLimit : DirectLimit A f →⋆ₙₐ[ℂ] CStarInductiveLimit A f where
  toFun z := (toSeminormed A f z : Completion (SeminormedDirectLimit A f))
  map_smul' c z := by rw [map_smul]; exact Completion.coe_smul c _
  map_zero' := by rw [map_zero]; exact Completion.coe_zero
  map_add' z w := by rw [map_add]; exact Completion.coe_add _ _
  map_mul' z w := by rw [map_mul]; exact Completion.coe_mul' _ _
  map_star' z := by rw [map_star]; exact Completion.coe_star _

/-- The norm of a representative `⟦⟨i, x⟩⟧` in `CStarInductiveLimit A f` is
`stageSeminorm A f i x`. -/
theorem norm_fromDirectLimit_mk (i : ι) (x : A i) :
    ‖fromDirectLimit A f ⟦⟨i, x⟩⟧‖ = stageSeminorm A f i x :=
  Completion.norm_coe (toSeminormed A f ⟦⟨i, x⟩⟧)

/-- The image of the algebraic `DirectLimit A f` is dense in `CStarInductiveLimit A f`. -/
theorem denseRange_fromDirectLimit : DenseRange (fromDirectLimit A f) :=
  Completion.denseRange_coe.comp (toSeminormed A f).surjective.denseRange
    (Completion.continuous_coe _)

variable (A f) in
/-- The canonical `⋆`-algebra homomorphism from stage `A i` into `CStarInductiveLimit A f`. -/
def of (i : ι) : A i →⋆ₙₐ[ℂ] CStarInductiveLimit A f :=
  (fromDirectLimit A f).comp (DirectLimit.NonUnitalStarAlgebra.of ℂ A f i)

theorem fromDirectLimit_of (i : ι) (x : A i) :
    fromDirectLimit A f (DirectLimit.NonUnitalStarAlgebra.of ℂ A f i x) = of A f i x :=
  (rfl)

@[simp]
theorem fromDirectLimit_mk (i : ι) (x : A i) :
    fromDirectLimit A f ⟦⟨i, x⟩⟧ = of A f i x := by
  rw [← DirectLimit.NonUnitalStarAlgebra.of_apply (R := ℂ) (f := f) i x, fromDirectLimit_of]

@[simp]
theorem fromDirectLimit_comp_of (i : ι) :
    (fromDirectLimit A f).comp (DirectLimit.NonUnitalStarAlgebra.of ℂ A f i) = of A f i :=
  (rfl)

/-- Compatibility of the canonical stage maps with the transition maps. -/
@[simp]
theorem of_f {i j : ι} (hij : i ≤ j) (x : A i) : of A f j (f i j hij x) = of A f i x := by
  rw [← fromDirectLimit_of, ← fromDirectLimit_of, DirectLimit.NonUnitalStarAlgebra.of_f hij]

@[simp]
theorem of_comp_ofClass {i j : ι} (hij : i ≤ j) :
    (of A f j).comp (NonUnitalStarAlgHom.ofClass (f i j hij)) = of A f i :=
  NonUnitalStarAlgHom.ext (of_f hij)

@[simp]
theorem of_comp_f {A : ι → Type v} [∀ i, NonUnitalCStarAlgebra (A i)]
    {f : ∀ i j, i ≤ j → A i →⋆ₙₐ[ℂ] A j} [DirectedSystem A (f · · ·)] {i j : ι} (hij : i ≤ j) :
    (of A f j).comp (f i j hij) = of A f i :=
  NonUnitalStarAlgHom.ext (of_f hij)

/-- **Norm formula in a C⋆-inductive limit**: `‖of A f i x‖` equals `stageSeminorm A f i x`. -/
@[simp]
theorem norm_of (i : ι) (x : A i) : ‖of A f i x‖ = stageSeminorm A f i x := by
  rw [← fromDirectLimit_mk, norm_fromDirectLimit_mk]

/-- Infimum form of the norm formula:
`‖of A f i x‖ = ⨅ j : Set.Ici i, ‖f i j.1 (Set.mem_Ici.mp j.2) x‖`. -/
theorem norm_of_eq_ciInf (i : ι) (x : A i) :
    ‖of A f i x‖ = ⨅ j : Set.Ici i, ‖f i j.1 (Set.mem_Ici.mp j.2) x‖ :=
  (norm_of i x).trans (stageSeminorm_apply i x)

/-- Strict upper bound characterization for norms in `CStarInductiveLimit A f`: `‖of A f i x‖ < c`
iff some later stage `j ≥ i` satisfies `‖f i j hij x‖ < c`. -/
theorem norm_of_lt_iff {i : ι} {x : A i} {c : ℝ} :
    ‖of A f i x‖ < c ↔ ∃ j, ∃ hij : i ≤ j, ‖f i j hij x‖ < c := by
  rw [norm_of, stageSeminorm_lt_iff]

/-- Limit form of the norm formula: `‖f i j.1 (Set.mem_Ici.mp j.2) x‖ → ‖of A f i x‖` along
`atTop` on `Set.Ici i`. -/
theorem tendsto_norm_atTop_norm_of (i : ι) (x : A i) :
    Tendsto (fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) x‖) atTop (𝓝 ‖of A f i x‖) := by
  rw [norm_of]
  exact tendsto_norm_map_atTop i x

/-- The norm in the inductive limit is bounded by the norm at every later stage. -/
theorem norm_of_le_norm_map {i j : ι} (hij : i ≤ j) (x : A i) :
    ‖of A f i x‖ ≤ ‖f i j hij x‖ := by
  rw [norm_of]
  exact stageSeminorm_le_norm_map hij x

/-- The canonical map `of A f i` is contractive. -/
theorem norm_of_le (i : ι) (x : A i) : ‖of A f i x‖ ≤ ‖x‖ := by
  rw [norm_of]
  exact stageSeminorm_le_norm i x

/-- Continuity of `of A f i`. -/
@[fun_prop]
theorem continuous_of (i : ι) : Continuous (of A f i) :=
  map_continuous (of A f i)

private theorem coe_sem_eq_of (i : ι) (a : A i) :
    ((toSeminormed A f ⟦⟨i, a⟩⟧ : Completion (SeminormedDirectLimit A f)) :
      CStarInductiveLimit A f) = of A f i a :=
  fromDirectLimit_mk i a

/-- To prove a closed property on `CStarInductiveLimit A f`, it suffices to prove it on the image
of every stage `A i`. -/
@[elab_as_elim]
theorem induction_on {p : CStarInductiveLimit A f → Prop} (x : CStarInductiveLimit A f)
    (hp : IsClosed {x | p x}) (ih : ∀ i (a : A i), p (of A f i a)) : p x :=
  Completion.induction_on (α := SeminormedDirectLimit A f) (p := p) x hp fun z ↦ by
    obtain ⟨i, a, ha⟩ := DirectLimit.exists_eq_mk f ((toSeminormed A f).symm z)
    have hz : z = toSeminormed A f ⟦⟨i, a⟩⟧ := (toSeminormed A f).symm_apply_eq.mp ha
    rw [hz]
    exact (coe_sem_eq_of (f := f) i a).symm ▸ ih i a

/-- Two-variable closed induction principle on `CStarInductiveLimit A f` reducing to pairs at a
common stage `A i`. -/
@[elab_as_elim]
theorem induction_on₂ {p : CStarInductiveLimit A f → CStarInductiveLimit A f → Prop}
    (x y : CStarInductiveLimit A f) (hp : IsClosed {q : CStarInductiveLimit A f × _ | p q.1 q.2})
    (ih : ∀ i (a b : A i), p (of A f i a) (of A f i b)) : p x y :=
  Completion.induction_on₂ (α := SeminormedDirectLimit A f) (β := SeminormedDirectLimit A f)
    (p := p) x y hp fun z w ↦ by
      obtain ⟨i, a, b, ha, hb⟩ := DirectLimit.exists_eq_mk₂ f ((toSeminormed A f).symm z)
        ((toSeminormed A f).symm w)
      have hz : z = toSeminormed A f ⟦⟨i, a⟩⟧ := (toSeminormed A f).symm_apply_eq.mp ha
      have hw : w = toSeminormed A f ⟦⟨i, b⟩⟧ := (toSeminormed A f).symm_apply_eq.mp hb
      rw [hz, hw]
      exact (coe_sem_eq_of (f := f) i a).symm ▸ (coe_sem_eq_of (f := f) i b).symm ▸ ih i a b

/-- An element `x : A i` maps to `0` in `CStarInductiveLimit A f` iff its asymptotic stage seminorm
vanishes. -/
theorem of_eq_zero_iff {i : ι} {x : A i} :
    of A f i x = 0 ↔ stageSeminorm A f i x = 0 := by
  rw [← norm_eq_zero, norm_of]

/-- Kernel characterization for `of A f i`: `x ∈ ker (of A f i)` iff
`‖f i j.1 (Set.mem_Ici.mp j.2) x‖ → 0` along `Set.Ici i`. -/
theorem mem_ker_of_iff_tendsto {i : ι} {x : A i} :
    x ∈ TwoSidedIdeal.ker (of A f i) ↔
      Tendsto (fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) x‖) atTop (𝓝 0) := by
  rw [TwoSidedIdeal.mem_ker, of_eq_zero_iff]
  exact ⟨fun h ↦ h ▸ tendsto_norm_map_atTop i x,
    fun h ↦ tendsto_nhds_unique (tendsto_norm_map_atTop i x) h⟩

/-- Quantitative kernel characterization: `of A f i x = 0` iff for every `ε > 0` there is a later
stage `j ≥ i` with `‖f i j hij x‖ < ε`. -/
theorem mem_ker_of_iff {i : ι} {x : A i} :
    x ∈ TwoSidedIdeal.ker (of A f i) ↔ ∀ ε > 0, ∃ j, ∃ hij : i ≤ j, ‖f i j hij x‖ < ε := by
  rw [TwoSidedIdeal.mem_ker, of_eq_zero_iff]
  refine ⟨fun h ε hε ↦ ?_, fun h ↦ le_antisymm ?_ (apply_nonneg _ _)⟩
  · simpa only [zero_add] using (stageSeminorm_le_iff.mp h.le) ε hε
  · exact stageSeminorm_le_iff.mpr fun ε hε ↦ by simpa only [zero_add] using h ε hε

/-- Two elements at stage `i` become equal in `CStarInductiveLimit A f` iff their images become
arbitrarily close in norm at later stages. -/
theorem of_eq_of_iff {i : ι} {x y : A i} :
    of A f i x = of A f i y ↔
      ∀ ε > 0, ∃ j, ∃ hij : i ≤ j, ‖f i j hij x - f i j hij y‖ < ε := by
  rw [← sub_eq_zero, ← map_sub, ← TwoSidedIdeal.mem_ker, mem_ker_of_iff]
  simp only [map_sub]

/-- When all transition maps out of stage `i` are injective, `of A f i` preserves norms. -/
theorem norm_of_eq_of_injective {i : ι}
    (hinj : ∀ j (hij : i ≤ j), Function.Injective (f i j hij)) (x : A i) :
    ‖of A f i x‖ = ‖x‖ := by
  rw [norm_of, stageSeminorm_eq_norm_of_injective hinj]

/-- When all transition maps out of stage `i` are injective, `of A f i` is an isometry. -/
theorem isometry_of {i : ι} (hinj : ∀ j (hij : i ≤ j), Function.Injective (f i j hij)) :
    Isometry (of A f i) :=
  AddMonoidHomClass.isometry_of_norm (of A f i) (norm_of_eq_of_injective hinj)

/-- When all transition maps out of stage `i` are injective, `of A f i` is injective. -/
theorem of_injective {i : ι} (hinj : ∀ j (hij : i ≤ j), Function.Injective (f i j hij)) :
    Function.Injective (of A f i) :=
  (isometry_of hinj).injective

/-- The `⋆`-subalgebra image of `DirectLimit A f` in `CStarInductiveLimit A f` equals the union of
the images of all stages `A i`. -/
theorem coe_range_fromDirectLimit :
    ((fromDirectLimit A f).range : Set (CStarInductiveLimit A f)) =
      ⋃ i, Set.range (of A f i) := by
  ext y
  rw [NonUnitalStarAlgHom.coe_range, Set.mem_range, Set.mem_iUnion]
  constructor
  · rintro ⟨z, rfl⟩
    obtain ⟨i, a, rfl⟩ := DirectLimit.exists_eq_mk f z
    exact ⟨i, a, (fromDirectLimit_mk i a).symm⟩
  · rintro ⟨i, a, rfl⟩
    exact ⟨DirectLimit.NonUnitalStarAlgebra.of ℂ A f i a, rfl⟩

variable (A f) in
/-- The union of the stage images `⋃ i, Set.range (of A f i)` is dense in
`CStarInductiveLimit A f`. -/
theorem dense_iUnion_range_of : Dense (⋃ i, Set.range (of A f i)) := by
  rw [← coe_range_fromDirectLimit, NonUnitalStarAlgHom.coe_range]
  exact denseRange_fromDirectLimit

/-- The topological closure of the algebraic colimit image `(fromDirectLimit A f).range` is `⊤`. -/
@[simp]
theorem topologicalClosure_range_fromDirectLimit :
    (fromDirectLimit A f).range.topologicalClosure = ⊤ :=
  eq_top_iff.mpr fun x _ ↦
    closure_minimal (fromDirectLimit A f).range.le_topologicalClosure
      (fromDirectLimit A f).range.isClosed_topologicalClosure <| by
        rw [NonUnitalStarAlgHom.coe_range]
        exact denseRange_fromDirectLimit x

/-- Every element of `CStarInductiveLimit A f` can be approximated arbitrarily closely in norm by an
element coming from some stage `A i`. -/
theorem exists_norm_sub_of_lt (x : CStarInductiveLimit A f) {ε : ℝ} (hε : 0 < ε) :
    ∃ i, ∃ a : A i, ‖x - of A f i a‖ < ε := by
  obtain ⟨y, hy, hdist⟩ := Metric.mem_closure_iff.mp
    ((dense_iUnion_range_of A f).closure_eq.symm ▸ Set.mem_univ x) ε hε
  obtain ⟨i, a, rfl⟩ := Set.mem_iUnion.mp hy
  rw [dist_eq_norm] at hdist
  exact ⟨i, a, hdist⟩

/-- Every finite subset of `CStarInductiveLimit A f` can be simultaneously approximated within `ε`
by elements coming from a *single* common stage `A i`. -/
theorem exists_finset_norm_sub_of_lt (s : Finset (CStarInductiveLimit A f)) {ε : ℝ} (hε : 0 < ε) :
    ∃ i, ∀ x ∈ s, ∃ a : A i, ‖x - of A f i a‖ < ε := by
  classical
  have hex : ∀ x : s,
      ∃ z : DirectLimit A f, ‖(x : CStarInductiveLimit A f) - fromDirectLimit A f z‖ < ε := by
    rintro ⟨x, _⟩
    obtain ⟨i, a, ha⟩ := exists_norm_sub_of_lt x hε
    exact ⟨DirectLimit.NonUnitalStarAlgebra.of ℂ A f i a, ha⟩
  choose g hg using hex
  obtain ⟨i, hi⟩ := DirectLimit.NonUnitalStarAlgebra.exists_subset_range_of (R := ℂ) (G := A)
    (f := f) (Finset.univ.image g)
  refine ⟨i, fun x hx ↦ ?_⟩
  obtain ⟨a, ha⟩ := hi (Finset.mem_coe.mpr (Finset.mem_image_of_mem g (Finset.mem_univ ⟨x, hx⟩)))
  refine ⟨a, ?_⟩
  rw [← fromDirectLimit_of, ha]
  exact hg ⟨x, hx⟩

/-- `CStarInductiveLimit A f` is nontrivial iff some stage element has nonzero asymptotic
seminorm. -/
theorem nontrivial_iff :
    Nontrivial (CStarInductiveLimit A f) ↔ ∃ i, ∃ x : A i, stageSeminorm A f i x ≠ 0 := by
  rw [nontrivial_iff_exists_ne (0 : CStarInductiveLimit A f)]
  constructor
  · rintro ⟨z, hz⟩
    obtain ⟨i, a, ha⟩ := exists_norm_sub_of_lt z (norm_pos_iff.mpr hz)
    refine ⟨i, a, fun h0 ↦ ?_⟩
    rw [of_eq_zero_iff.mpr h0, sub_zero] at ha
    exact lt_irrefl _ ha
  · rintro ⟨i, x, hx⟩
    exact ⟨of A f i x, mt of_eq_zero_iff.mp hx⟩

/-- **Separability of C⋆-inductive limits**: the inductive limit of separable C⋆-algebras over a
countable directed preorder is separable. -/
instance instSeparableSpace [Countable ι] [∀ i, TopologicalSpace.SeparableSpace (A i)] :
    TopologicalSpace.SeparableSpace (CStarInductiveLimit A f) :=
  (dense_iUnion_range_of A f).isSeparable_iff.mp
    (.iUnion fun i ↦ TopologicalSpace.isSeparable_range (continuous_of i))

/-! ### Universal property and extensionality (nonunital) -/

/-- `⋆`-homomorphisms from `CStarInductiveLimit A f` into a C⋆-algebra are uniquely determined by
their compositions with the stage maps `of A f i`. -/
@[ext]
theorem starAlgHom_ext {B : Type w} [NonUnitalCStarAlgebra B]
    {φ ψ : CStarInductiveLimit A f →⋆ₙₐ[ℂ] B}
    (h : ∀ i, φ.comp (of A f i) = ψ.comp (of A f i)) : φ = ψ :=
  NonUnitalStarAlgHom.ext fun x ↦
    induction_on x (isClosed_eq (map_continuous φ) (map_continuous ψ)) fun i a ↦
      DFunLike.congr_fun (h i) a

/-- Continuous linear maps out of `CStarInductiveLimit A f` into a Hausdorff space are uniquely
determined by their values on all stages. -/
theorem continuousLinearMap_ext {E : Type w} [TopologicalSpace E] [T2Space E] [AddCommMonoid E]
    [Module ℂ E] {S T' : CStarInductiveLimit A f →L[ℂ] E}
    (h : ∀ i (a : A i), S (of A f i a) = T' (of A f i a)) : S = T' :=
  ContinuousLinearMap.ext fun x ↦
    induction_on x (isClosed_eq S.continuous T'.continuous) h

section Lift

variable {B : Type w} [NonUnitalCStarAlgebra B]

private def liftCLM (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) : SeminormedDirectLimit A f →L[ℂ] B :=
  LinearMap.mkContinuous
    { toFun := fun z ↦
        DirectLimit.NonUnitalStarAlgebra.lift ℂ A f g hg ((toSeminormed A f).symm z)
      map_add' := fun z w ↦ by simp only [map_add]
      map_smul' := fun c z ↦ by simp only [map_smul, RingHom.id_apply] }
    1 fun z ↦ by
      obtain ⟨i, x, hx⟩ := DirectLimit.exists_eq_mk f ((toSeminormed A f).symm z)
      have hnorm : ‖z‖ = stageSeminorm A f i x := by
        rw [(toSeminormed A f).symm_apply_eq.mp hx, norm_toSeminormed_mk]
      simpa only [LinearMap.coe_mk, AddHom.coe_mk, hx,
        DirectLimit.NonUnitalStarAlgebra.lift_mk, one_mul, hnorm] using
        norm_le_stageSeminorm g hg i x

private theorem fromCompletion_liftCLM_of (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) (i : ι) (x : A i) :
    (liftCLM g hg).fromCompletion (of A f i x) = g i x := by
  rw [← coe_sem_eq_of (f := f), ContinuousLinearMap.fromCompletion_apply_coe]
  simp [liftCLM]

variable (A f) in
/-- **Universal property of `CStarInductiveLimit`**: any compatible family of `⋆`-homomorphisms
`g i : A i →⋆ₙₐ[ℂ] B` into a C⋆-algebra `B` extends uniquely to a `⋆`-homomorphism
`CStarInductiveLimit A f →⋆ₙₐ[ℂ] B`. No norm bound hypothesis is needed because `⋆`-homomorphisms
between C⋆-algebras are automatically contractive. -/
def lift (g : ∀ i, A i →⋆ₙₐ[ℂ] B) (hg : ∀ i j hij x, g j (f i j hij x) = g i x) :
    CStarInductiveLimit A f →⋆ₙₐ[ℂ] B :=
  let L : CStarInductiveLimit A f → B := fun z ↦ (liftCLM g hg).fromCompletion z
  have hcont : Continuous L := (liftCLM g hg).fromCompletion.continuous
  { toFun := L
    map_smul' := (liftCLM g hg).fromCompletion.map_smul
    map_zero' := (liftCLM g hg).fromCompletion.map_zero
    map_add' := (liftCLM g hg).fromCompletion.map_add
    map_mul' := fun x y ↦
      induction_on₂ x y (isClosed_eq (hcont.comp continuous_mul)
        ((hcont.comp continuous_fst).mul (hcont.comp continuous_snd))) fun i a b ↦ by
        dsimp only [L]
        simp only [← map_mul, fromCompletion_liftCLM_of]
    map_star' := fun x ↦
      induction_on x (isClosed_eq (hcont.comp continuous_star) (continuous_star.comp hcont))
        fun i a ↦ by
          dsimp only [L]
          simp only [← map_star, fromCompletion_liftCLM_of] }

@[simp]
theorem lift_of (g : ∀ i, A i →⋆ₙₐ[ℂ] B) (hg : ∀ i j hij x, g j (f i j hij x) = g i x)
    (i : ι) (x : A i) : lift A f g hg (of A f i x) = g i x :=
  fromCompletion_liftCLM_of g hg i x

@[simp]
theorem lift_comp_of (g : ∀ i, A i →⋆ₙₐ[ℂ] B) (hg : ∀ i j hij x, g j (f i j hij x) = g i x)
    (i : ι) : (lift A f g hg).comp (of A f i) = g i :=
  NonUnitalStarAlgHom.ext (lift_of g hg i)

@[simp]
theorem lift_comp_fromDirectLimit (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) :
    (lift A f g hg).comp (fromDirectLimit A f) =
      DirectLimit.NonUnitalStarAlgebra.lift ℂ A f g hg :=
  DirectLimit.NonUnitalStarAlgebra.hom_ext fun i ↦ by ext x; simp

@[simp]
theorem lift_of_self :
    lift A f (of A f) (fun _ _ hij x ↦ of_f hij x) = NonUnitalStarAlgHom.id ℂ _ :=
  starAlgHom_ext fun i ↦ by simp

theorem comp_lift {C : Type*} [NonUnitalCStarAlgebra C] (ψ : B →⋆ₙₐ[ℂ] C)
    (g : ∀ i, A i →⋆ₙₐ[ℂ] B) (hg : ∀ i j hij x, g j (f i j hij x) = g i x) :
    ψ.comp (lift A f g hg) =
      lift A f (fun i ↦ ψ.comp (g i)) (fun i j hij x ↦ by simp [hg i j hij x]) :=
  starAlgHom_ext fun i ↦ by ext x; simp

variable (A f B) in
/-- Categorical colimit equivalence for `CStarInductiveLimit`: `⋆`-homomorphisms out of
`CStarInductiveLimit A f` into `B` correspond bijectively to compatible families of
`⋆`-homomorphisms `(A i →⋆ₙₐ[ℂ] B)`. -/
def liftEquiv :
    (CStarInductiveLimit A f →⋆ₙₐ[ℂ] B) ≃
      { g : ∀ i, A i →⋆ₙₐ[ℂ] B // ∀ i j hij x, g j (f i j hij x) = g i x } where
  toFun φ := ⟨fun i ↦ φ.comp (of A f i), fun _ _ hij x ↦ by simp [of_f hij]⟩
  invFun g := lift A f g.1 g.2
  left_inv _ := starAlgHom_ext fun i ↦ lift_comp_of _ _ i
  right_inv g := Subtype.ext <| funext fun i ↦ lift_comp_of g.1 g.2 i

@[simp]
theorem liftEquiv_apply_coe (φ : CStarInductiveLimit A f →⋆ₙₐ[ℂ] B) (i : ι) :
    (liftEquiv A f B φ).1 i = φ.comp (of A f i) :=
  (rfl)

@[simp]
theorem liftEquiv_symm_apply
    (g : { g : ∀ i, A i →⋆ₙₐ[ℂ] B // ∀ i j hij x, g j (f i j hij x) = g i x }) :
    (liftEquiv A f B).symm g = lift A f g.1 g.2 :=
  (rfl)

/-! ### Range, injectivity, and recognition of C⋆-inductive limits -/

/-- Because `⋆`-homomorphisms between C⋆-algebras have closed range, the range of `lift A f g hg`
is the norm closure of `⋃ i, Set.range (g i)`. -/
theorem range_lift (g : ∀ i, A i →⋆ₙₐ[ℂ] B) (hg : ∀ i j hij x, g j (f i j hij x) = g i x) :
    Set.range (lift A f g hg) = closure (⋃ i, Set.range (g i)) := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro _ ⟨x, rfl⟩
    have himg : lift A f g hg '' (⋃ i, Set.range (of A f i)) = ⋃ i, Set.range (g i) := by
      ext y
      simp only [Set.mem_image, Set.mem_iUnion, Set.mem_range]
      exact ⟨fun ⟨_, ⟨i, a, rfl⟩, hy⟩ ↦ ⟨i, a, (lift_of g hg i a).symm.trans hy⟩,
        fun ⟨i, a, hy⟩ ↦ ⟨of A f i a, ⟨i, a, rfl⟩, (lift_of g hg i a).trans hy⟩⟩
    rw [← himg]
    exact map_mem_closure (map_continuous (lift A f g hg)) (dense_iUnion_range_of A f x)
      fun _ hy ↦ Set.mem_image_of_mem _ hy
  · refine closure_minimal (Set.iUnion_subset fun i ↦ ?_)
      (NonUnitalStarAlgHom.isClosed_setRange (lift A f g hg))
    rintro _ ⟨a, rfl⟩
    exact ⟨of A f i a, lift_of g hg i a⟩

/-- `lift A f g hg` is surjective if and only if `⋃ i, Set.range (g i)` is dense in `B`. -/
theorem lift_surjective_iff (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) :
    Function.Surjective (lift A f g hg) ↔ Dense (⋃ i, Set.range (g i)) := by
  rw [← Set.range_eq_univ, range_lift, dense_iff_closure_eq]

/-- `lift A f g hg` is injective (hence isometric) if and only if `‖g i x‖ = stageSeminorm A f i x`
for every stage `i` and element `x : A i`. -/
theorem lift_injective_iff (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) :
    Function.Injective (lift A f g hg) ↔ ∀ i x, ‖g i x‖ = stageSeminorm A f i x := by
  constructor
  · intro hinj i x
    rw [← lift_of g hg i x, NonUnitalStarAlgHom.norm_map (lift A f g hg) hinj, norm_of]
  · intro hnorm
    exact (AddMonoidHomClass.isometry_of_norm (lift A f g hg) fun z ↦
      induction_on z (isClosed_eq (continuous_norm.comp (map_continuous _)) continuous_norm)
        fun i a ↦ by rw [lift_of, hnorm, norm_of]).injective

variable (A f) in
/-- **Recognition theorem for C⋆-inductive limits**: if `g i : A i →⋆ₙₐ[ℂ] B` is a compatible
family of `⋆`-homomorphisms whose ranges have dense union in `B` and satisfy the asymptotic norm
formula `‖g i x‖ = stageSeminorm A f i x`, then `lift A f g hg` is an isometric `⋆`-isomorphism
`CStarInductiveLimit A f ≃⋆ₐ[ℂ] B`. -/
def equivOfDenseUnion (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x)
    (hdense : Dense (⋃ i, Set.range (g i)))
    (hnorm : ∀ i x, ‖g i x‖ = stageSeminorm A f i x) :
    CStarInductiveLimit A f ≃⋆ₐ[ℂ] B :=
  StarAlgEquiv.ofBijective (lift A f g hg)
    ⟨(lift_injective_iff g hg).mpr hnorm, (lift_surjective_iff g hg).mpr hdense⟩

@[simp]
theorem equivOfDenseUnion_of (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x)
    (hdense : Dense (⋃ i, Set.range (g i)))
    (hnorm : ∀ i x, ‖g i x‖ = stageSeminorm A f i x) (i : ι) (x : A i) :
    equivOfDenseUnion A f g hg hdense hnorm (of A f i x) = g i x :=
  lift_of g hg i x

@[simp]
theorem toNonUnitalStarAlgHom_equivOfDenseUnion (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x)
    (hdense : Dense (⋃ i, Set.range (g i)))
    (hnorm : ∀ i x, ‖g i x‖ = stageSeminorm A f i x) :
    (equivOfDenseUnion A f g hg hdense hnorm).toNonUnitalStarAlgHom = lift A f g hg :=
  (rfl)

variable (A f) in
/-- **Recognition of an inductive limit of C⋆-subalgebras**: if `g i : A i →⋆ₙₐ[ℂ] B` are
*injective* compatible `⋆`-homomorphisms whose images have dense union in `B`, then `B` is
isometrically `⋆`-isomorphic to `CStarInductiveLimit A f`. -/
def equivOfInjectiveDenseUnion (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x)
    (hdense : Dense (⋃ i, Set.range (g i)))
    (hinj : ∀ i, Function.Injective (g i)) :
    CStarInductiveLimit A f ≃⋆ₐ[ℂ] B :=
  equivOfDenseUnion A f g hg hdense fun i x ↦ by
    have hinj_f : ∀ j (hij : i ≤ j), Function.Injective (f i j hij) := fun j hij a b hab ↦
      hinj i (by rw [← hg i j hij a, ← hg i j hij b, hab])
    rw [NonUnitalStarAlgHom.norm_map (g i) (hinj i), stageSeminorm_eq_norm_of_injective hinj_f]

@[simp]
theorem equivOfInjectiveDenseUnion_of (g : ∀ i, A i →⋆ₙₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x)
    (hdense : Dense (⋃ i, Set.range (g i)))
    (hinj : ∀ i, Function.Injective (g i)) (i : ι) (x : A i) :
    equivOfInjectiveDenseUnion A f g hg hdense hinj (of A f i x) = g i x :=
  lift_of g hg i x

end Lift

/-! ### Functoriality and stabilization at a top element -/

section Functoriality

variable {B : ι → Type w} [∀ i, NonUnitalCStarAlgebra (B i)]
  {T' : ∀ ⦃i j : ι⦄, i ≤ j → Type*} {f' : ∀ i j (h : i ≤ j), T' h}
  [∀ i j (h : i ≤ j), FunLike (T' h) (B i) (B j)]
  [∀ i j h, NonUnitalAlgHomClass (T' h) ℂ (B i) (B j)]
  [∀ i j h, StarHomClass (T' h) (B i) (B j)]
  [DirectedSystem B (f' · · ·)]

variable (A f B f') in
/-- Functoriality of `CStarInductiveLimit`: a natural transformation `φ i : A i →⋆ₙₐ[ℂ] B i`
commuting with the transition maps induces a `⋆`-homomorphism between the C⋆-inductive limits. -/
def map (φ : ∀ i, A i →⋆ₙₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) :
    CStarInductiveLimit A f →⋆ₙₐ[ℂ] CStarInductiveLimit B f' :=
  lift A f (fun i ↦ (of B f' i).comp (φ i)) fun i j hij x ↦ by
    simp only [NonUnitalStarAlgHom.comp_apply, ← hφ i j hij x, of_f]

@[simp]
theorem map_of (φ : ∀ i, A i →⋆ₙₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) (i : ι) (x : A i) :
    map A f B f' φ hφ (of A f i x) = of B f' i (φ i x) :=
  lift_of _ _ i x

@[simp]
theorem map_comp_of (φ : ∀ i, A i →⋆ₙₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) (i : ι) :
    (map A f B f' φ hφ).comp (of A f i) = (of B f' i).comp (φ i) :=
  NonUnitalStarAlgHom.ext (map_of φ hφ i)

@[simp]
theorem map_id :
    map A f A f (fun i ↦ NonUnitalStarAlgHom.id ℂ (A i)) (fun _ _ _ _ ↦ rfl) =
      NonUnitalStarAlgHom.id ℂ (CStarInductiveLimit A f) :=
  starAlgHom_ext fun i ↦ (map_comp_of _ _ i).trans (NonUnitalStarAlgHom.comp_id _)

theorem map_comp {C : ι → Type*} [∀ i, NonUnitalCStarAlgebra (C i)]
    {T'' : ∀ ⦃i j : ι⦄, i ≤ j → Type*} {f'' : ∀ i j (h : i ≤ j), T'' h}
    [∀ i j (h : i ≤ j), FunLike (T'' h) (C i) (C j)]
    [∀ i j h, NonUnitalAlgHomClass (T'' h) ℂ (C i) (C j)]
    [∀ i j h, StarHomClass (T'' h) (C i) (C j)]
    [DirectedSystem C (f'' · · ·)]
    (ψ : ∀ i, B i →⋆ₙₐ[ℂ] C i) (hψ : ∀ i j hij y, f'' i j hij (ψ i y) = ψ j (f' i j hij y))
    (φ : ∀ i, A i →⋆ₙₐ[ℂ] B i) (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) :
    (map B f' C f'' ψ hψ).comp (map A f B f' φ hφ) =
      map A f C f'' (fun i ↦ (ψ i).comp (φ i)) (fun i j hij x ↦ by simp [hψ, hφ]) :=
  starAlgHom_ext fun i ↦ by ext x; simp

variable (A f B f') in
/-- A natural `⋆`-isomorphism `φ i : A i ≃⋆ₐ[ℂ] B i` between directed systems induces an isometric
`⋆`-isomorphism between their C⋆-inductive limits. -/
def mapEquiv (φ : ∀ i, A i ≃⋆ₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) :
    CStarInductiveLimit A f ≃⋆ₐ[ℂ] CStarInductiveLimit B f' :=
  have hφ' : ∀ i j hij x,
      f' i j hij ((φ i).toNonUnitalStarAlgHom x) = (φ j).toNonUnitalStarAlgHom (f i j hij x) := hφ
  have hφ_symm : ∀ i j hij y,
      f i j hij ((φ i).symm.toNonUnitalStarAlgHom y) =
        (φ j).symm.toNonUnitalStarAlgHom (f' i j hij y) :=
    fun i j hij y ↦ EquivLike.injective (φ j) <| by
      rw [StarAlgEquiv.toNonUnitalStarAlgHom_apply, StarAlgEquiv.toNonUnitalStarAlgHom_apply,
        ← hφ i j hij ((φ i).symm y), StarAlgEquiv.apply_symm_apply,
        StarAlgEquiv.apply_symm_apply]
  StarAlgEquiv.ofNonUnitalStarAlgHom
    (map A f B f' (fun i ↦ (φ i).toNonUnitalStarAlgHom) hφ')
    (map B f' A f (fun i ↦ (φ i).symm.toNonUnitalStarAlgHom) hφ_symm)
    (starAlgHom_ext fun i ↦ NonUnitalStarAlgHom.ext fun x ↦ by
      rw [NonUnitalStarAlgHom.comp_apply, NonUnitalStarAlgHom.comp_apply, map_of, map_of]
      exact congrArg (of A f i) ((φ i).symm_apply_apply x))
    (starAlgHom_ext fun i ↦ NonUnitalStarAlgHom.ext fun y ↦ by
      rw [NonUnitalStarAlgHom.comp_apply, NonUnitalStarAlgHom.comp_apply, map_of, map_of]
      exact congrArg (of B f' i) ((φ i).apply_symm_apply y))

@[simp]
theorem mapEquiv_of (φ : ∀ i, A i ≃⋆ₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) (i : ι) (x : A i) :
    mapEquiv A f B f' φ hφ (of A f i x) = of B f' i (φ i x) :=
  map_of _ hφ i x

@[simp]
theorem mapEquiv_symm_of (φ : ∀ i, A i ≃⋆ₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) (i : ι) (y : B i) :
    (mapEquiv A f B f' φ hφ).symm (of B f' i y) = of A f i ((φ i).symm y) := by
  rw [StarAlgEquiv.symm_apply_eq, mapEquiv_of, StarAlgEquiv.apply_symm_apply]

end Functoriality

variable (A f) in
/-- If `m : ι` is a top element of the index preorder, then `CStarInductiveLimit A f` is
isometrically `⋆`-isomorphic to `A m`. -/
def equivOfIsTop (m : ι) (hm : IsTop m) : CStarInductiveLimit A f ≃⋆ₐ[ℂ] A m :=
  have hle : ∀ i, i ≤ m := hm
  have hcompat : ∀ i j hij x,
      NonUnitalStarAlgHom.ofClass (f j m (hle j)) (f i j hij x) =
        NonUnitalStarAlgHom.ofClass (f i m (hle i)) x :=
    fun i j hij x ↦ DirectedSystem.map_map' f hij (hle j) x
  StarAlgEquiv.ofNonUnitalStarAlgHom
    (lift A f (fun i ↦ NonUnitalStarAlgHom.ofClass (f i m (hle i))) hcompat)
    (of A f m)
    (starAlgHom_ext fun i ↦ NonUnitalStarAlgHom.ext fun x ↦ by
      rw [NonUnitalStarAlgHom.comp_apply, NonUnitalStarAlgHom.comp_apply, lift_of]
      exact of_f (hle i) x)
    (NonUnitalStarAlgHom.ext fun x ↦ by
      rw [NonUnitalStarAlgHom.comp_apply, lift_of, NonUnitalStarAlgHom.coe_ofClass,
        DirectedSystem.map_self' f]
      rfl)

@[simp]
theorem equivOfIsTop_of (m : ι) (hm : IsTop m) (i : ι) (x : A i) :
    equivOfIsTop A f m hm (of A f i x) = f i m (hm i) x :=
  lift_of _ _ i x

@[simp]
theorem equivOfIsTop_symm_apply (m : ι) (hm : IsTop m) (x : A m) :
    (equivOfIsTop A f m hm).symm x = of A f m x :=
  (rfl)

end NonUnital

section NonUnitalComm

variable {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
  {A : ι → Type v} [∀ i, NonUnitalCommCStarAlgebra (A i)]
  {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*} {f : ∀ i j (h : i ≤ j), T h}
  [∀ i j (h : i ≤ j), FunLike (T h) (A i) (A j)]
  [∀ i j h, NonUnitalAlgHomClass (T h) ℂ (A i) (A j)]
  [∀ i j h, StarHomClass (T h) (A i) (A j)]
  [DirectedSystem A (f · · ·)]

/-- The C⋆-inductive limit of commutative nonunital C⋆-algebras is commutative. -/
instance instNonUnitalCommCStarAlgebra :
    NonUnitalCommCStarAlgebra (CStarInductiveLimit A f) where
  __ := instNonUnitalCStarAlgebra
  mul_comm x y :=
    induction_on₂ x y
      (isClosed_eq continuous_mul (continuous_mul.comp (continuous_snd.prodMk continuous_fst)))
      fun i a b ↦ by rw [← map_mul, ← map_mul, mul_comm]

end NonUnitalComm

/-! ### Unital C⋆-inductive limits -/

section Unital

variable {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
  {A : ι → Type v} [∀ i, CStarAlgebra (A i)]
  {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*} {f : ∀ i j (h : i ≤ j), T h}
  [∀ i j (h : i ≤ j), FunLike (T h) (A i) (A j)]
  [∀ i j h, AlgHomClass (T h) ℂ (A i) (A j)]
  [∀ i j h, StarHomClass (T h) (A i) (A j)]
  [DirectedSystem A (f · · ·)]

instance : SeminormedRing (SeminormedDirectLimit A f) where
  __ : Ring (SeminormedDirectLimit A f) := inferInstanceAs (Ring (DirectLimit A f))
  __ : NonUnitalSeminormedRing (SeminormedDirectLimit A f) := inferInstance

instance : NormedAlgebra ℂ (SeminormedDirectLimit A f) where
  __ : Algebra ℂ (SeminormedDirectLimit A f) := inferInstanceAs (Algebra ℂ (DirectLimit A f))
  norm_smul_le := norm_smul_le

instance : CStarAlgebra (Completion (SeminormedDirectLimit A f)) where

/-- The C⋆-inductive limit of unital C⋆-algebras along unital `⋆`-homomorphisms is a unital
C⋆-algebra. -/
instance instCStarAlgebra : CStarAlgebra (CStarInductiveLimit A f) :=
  inferInstanceAs (CStarAlgebra (Completion (SeminormedDirectLimit A f)))

-- Verify that the unital `CStarAlgebra` structure extends `instNonUnitalCStarAlgebra`
-- with zero instance diamonds.
example : (instCStarAlgebra (A := A) (f := f)).toNonUnitalCStarAlgebra =
    instNonUnitalCStarAlgebra :=
  rfl

@[simp]
theorem of_one (i : ι) : of A f i 1 = 1 := by
  have h1 : toSeminormed A f (1 : DirectLimit A f) = 1 := rfl
  rw [← coe_sem_eq_of (f := f), ← DirectLimit.one_def i, h1]
  exact Completion.coe_one (α := SeminormedDirectLimit A f)

variable (A f) in
/-- The canonical unital `⋆`-algebra homomorphism from the algebraic `DirectLimit A f` into
`CStarInductiveLimit A f`. -/
def fromDirectLimitUnital : DirectLimit A f →⋆ₐ[ℂ] CStarInductiveLimit A f :=
  { (fromDirectLimit A f : DirectLimit A f →⋆ₙₐ[ℂ] CStarInductiveLimit A f) with
    toFun := fromDirectLimit A f
    map_one' := by
      let ⟨i⟩ := ‹Nonempty ι›
      rw [DirectLimit.one_def i, fromDirectLimit_mk, of_one]
    commutes' := fun c ↦ by
      let ⟨i⟩ := ‹Nonempty ι›
      rw [Algebra.algebraMap_eq_smul_one, map_smul, DirectLimit.one_def i,
        fromDirectLimit_mk, of_one, Algebra.algebraMap_eq_smul_one] }

@[simp]
theorem coe_fromDirectLimitUnital :
    ⇑(fromDirectLimitUnital A f) = fromDirectLimit A f :=
  (rfl)

@[simp]
theorem toNonUnitalStarAlgHom_fromDirectLimitUnital :
    (fromDirectLimitUnital A f).toNonUnitalStarAlgHom = fromDirectLimit A f :=
  (rfl)

variable (A f) in
/-- The canonical unital `⋆`-algebra homomorphism from stage `A i` into
`CStarInductiveLimit A f`. -/
def ofUnital (i : ι) : A i →⋆ₐ[ℂ] CStarInductiveLimit A f :=
  { (of A f i : A i →⋆ₙₐ[ℂ] CStarInductiveLimit A f) with
    toFun := of A f i
    map_one' := of_one i
    commutes' := fun c ↦ by
      rw [Algebra.algebraMap_eq_smul_one, map_smul, of_one, Algebra.algebraMap_eq_smul_one] }

@[simp]
theorem coe_ofUnital (i : ι) : ⇑(ofUnital A f i) = of A f i :=
  (rfl)

theorem ofUnital_apply (i : ι) (x : A i) : ofUnital A f i x = of A f i x :=
  (rfl)

@[simp]
theorem toNonUnitalStarAlgHom_ofUnital (i : ι) :
    (ofUnital A f i).toNonUnitalStarAlgHom = of A f i :=
  (rfl)

theorem ofUnital_f {i j : ι} (hij : i ≤ j) (x : A i) :
    ofUnital A f j (f i j hij x) = ofUnital A f i x :=
  of_f hij x

@[simp]
theorem ofUnital_comp_ofClass {i j : ι} (hij : i ≤ j) :
    (ofUnital A f j).comp (StarAlgHom.ofClass (f i j hij)) = ofUnital A f i :=
  StarAlgHom.ext (of_f hij)

@[simp]
theorem ofUnital_comp_f {A : ι → Type v} [∀ i, CStarAlgebra (A i)]
    {f : ∀ i j, i ≤ j → A i →⋆ₐ[ℂ] A j} [DirectedSystem A (f · · ·)] {i j : ι} (hij : i ≤ j) :
    (ofUnital A f j).comp (f i j hij) = ofUnital A f i :=
  StarAlgHom.ext (of_f hij)

/-- A unital C⋆-inductive limit is nontrivial if and only if every stage `A i` is nontrivial. -/
theorem nontrivial_iff_forall_nontrivial :
    Nontrivial (CStarInductiveLimit A f) ↔ ∀ i, Nontrivial (A i) := by
  constructor
  · intro _ i
    refine ⟨⟨1, 0, fun h10 ↦ one_ne_zero (α := CStarInductiveLimit A f) ?_⟩⟩
    rw [← of_one (f := f) i, h10, map_zero]
  · intro hall
    let ⟨i⟩ := ‹Nonempty ι›
    refine nontrivial_iff.mpr ⟨i, 1, ?_⟩
    have hnorm1 : stageSeminorm A f i 1 = 1 := by
      refine tendsto_nhds_unique (tendsto_norm_map_atTop i 1) ?_
      have hconst :
          (fun j : Set.Ici i ↦ ‖f i j.1 (Set.mem_Ici.mp j.2) (1 : A i)‖) = fun _ ↦ 1 := by
        ext j
        have := hall j.1
        rw [map_one, norm_one]
      exact hconst ▸ tendsto_const_nhds
    rw [hnorm1]
    exact one_ne_zero

/-- The C⋆-inductive limit of nontrivial unital C⋆-algebras is nontrivial. -/
instance instNontrivial [∀ i, Nontrivial (A i)] : Nontrivial (CStarInductiveLimit A f) :=
  nontrivial_iff_forall_nontrivial.mpr ‹_›

/-- Unital `⋆`-homomorphisms out of `CStarInductiveLimit A f` are uniquely determined on stages. -/
@[ext]
theorem unitalStarAlgHom_ext {B : Type w} [CStarAlgebra B]
    {φ ψ : CStarInductiveLimit A f →⋆ₐ[ℂ] B}
    (h : ∀ i, φ.comp (ofUnital A f i) = ψ.comp (ofUnital A f i)) : φ = ψ := by
  ext x
  exact DFunLike.congr_fun
    (starAlgHom_ext (φ := φ.toNonUnitalStarAlgHom) (ψ := ψ.toNonUnitalStarAlgHom)
      fun i ↦ NonUnitalStarAlgHom.ext fun a ↦ DFunLike.congr_fun (h i) a) x

section LiftUnital

variable {B : Type w} [CStarAlgebra B]

variable (A f) in
/-- **Unital universal property of `CStarInductiveLimit`**: compatible unital `⋆`-homomorphisms
`g i : A i →⋆ₐ[ℂ] B` extend uniquely to a unital `⋆`-homomorphism
`CStarInductiveLimit A f →⋆ₐ[ℂ] B`. -/
def liftUnital (g : ∀ i, A i →⋆ₐ[ℂ] B) (hg : ∀ i j hij x, g j (f i j hij x) = g i x) :
    CStarInductiveLimit A f →⋆ₐ[ℂ] B :=
  have hg' : ∀ i j hij x,
      (g j).toNonUnitalStarAlgHom (f i j hij x) = (g i).toNonUnitalStarAlgHom x := hg
  let φ := lift A f (fun i ↦ (g i).toNonUnitalStarAlgHom) hg'
  have hφ1 : φ 1 = 1 := by
    let ⟨i⟩ := ‹Nonempty ι›
    dsimp only [φ]
    rw [← of_one (f := f) i, lift_of]
    exact map_one (g i)
  { φ with
    toFun := φ
    map_one' := hφ1
    commutes' := fun c ↦ by
      rw [Algebra.algebraMap_eq_smul_one, map_smul, hφ1, Algebra.algebraMap_eq_smul_one] }

@[simp]
theorem toNonUnitalStarAlgHom_liftUnital (g : ∀ i, A i →⋆ₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) :
    (liftUnital A f g hg).toNonUnitalStarAlgHom =
      lift A f (fun i ↦ (g i).toNonUnitalStarAlgHom) hg :=
  (rfl)

@[simp]
theorem liftUnital_of (g : ∀ i, A i →⋆ₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) (i : ι) (x : A i) :
    liftUnital A f g hg (of A f i x) = g i x :=
  lift_of _ hg i x

theorem liftUnital_ofUnital (g : ∀ i, A i →⋆ₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) (i : ι) (x : A i) :
    liftUnital A f g hg (ofUnital A f i x) = g i x :=
  lift_of _ hg i x

@[simp]
theorem liftUnital_comp_ofUnital (g : ∀ i, A i →⋆ₐ[ℂ] B)
    (hg : ∀ i j hij x, g j (f i j hij x) = g i x) (i : ι) :
    (liftUnital A f g hg).comp (ofUnital A f i) = g i :=
  StarAlgHom.ext (liftUnital_of g hg i)

variable (A f B) in
/-- Categorical colimit equivalence in the category of unital C⋆-algebras. -/
def liftUnitalEquiv :
    (CStarInductiveLimit A f →⋆ₐ[ℂ] B) ≃
      { g : ∀ i, A i →⋆ₐ[ℂ] B // ∀ i j hij x, g j (f i j hij x) = g i x } where
  toFun φ := ⟨fun i ↦ φ.comp (ofUnital A f i), fun _ _ hij x ↦ by simp [of_f hij]⟩
  invFun g := liftUnital A f g.1 g.2
  left_inv _ := unitalStarAlgHom_ext fun i ↦ liftUnital_comp_ofUnital _ _ i
  right_inv g := Subtype.ext <| funext fun i ↦ liftUnital_comp_ofUnital g.1 g.2 i

@[simp]
theorem liftUnitalEquiv_apply_coe (φ : CStarInductiveLimit A f →⋆ₐ[ℂ] B) (i : ι) :
    (liftUnitalEquiv A f B φ).1 i = φ.comp (ofUnital A f i) :=
  (rfl)

@[simp]
theorem liftUnitalEquiv_symm_apply
    (g : { g : ∀ i, A i →⋆ₐ[ℂ] B // ∀ i j hij x, g j (f i j hij x) = g i x }) :
    (liftUnitalEquiv A f B).symm g = liftUnital A f g.1 g.2 :=
  (rfl)

end LiftUnital

section MapUnital

variable {B : ι → Type w} [∀ i, CStarAlgebra (B i)]
  {T' : ∀ ⦃i j : ι⦄, i ≤ j → Type*} {f' : ∀ i j (h : i ≤ j), T' h}
  [∀ i j (h : i ≤ j), FunLike (T' h) (B i) (B j)]
  [∀ i j h, AlgHomClass (T' h) ℂ (B i) (B j)]
  [∀ i j h, StarHomClass (T' h) (B i) (B j)]
  [DirectedSystem B (f' · · ·)]

variable (A f B f') in
/-- Unital functoriality of `CStarInductiveLimit`: compatible unital `⋆`-homomorphisms
`φ i : A i →⋆ₐ[ℂ] B i` induce a unital `⋆`-homomorphism between the C⋆-inductive limits. -/
def mapUnital (φ : ∀ i, A i →⋆ₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) :
    CStarInductiveLimit A f →⋆ₐ[ℂ] CStarInductiveLimit B f' :=
  liftUnital A f (fun i ↦ (ofUnital B f' i).comp (φ i)) fun i j hij x ↦ by
    simp only [StarAlgHom.comp_apply, ofUnital_apply, ← hφ i j hij x, of_f]

@[simp]
theorem toNonUnitalStarAlgHom_mapUnital (φ : ∀ i, A i →⋆ₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) :
    (mapUnital A f B f' φ hφ).toNonUnitalStarAlgHom =
      map A f B f' (fun i ↦ (φ i).toNonUnitalStarAlgHom) hφ :=
  (rfl)

@[simp]
theorem mapUnital_of (φ : ∀ i, A i →⋆ₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) (i : ι) (x : A i) :
    mapUnital A f B f' φ hφ (of A f i x) = of B f' i (φ i x) :=
  lift_of _ _ i x

@[simp]
theorem mapUnital_comp_ofUnital (φ : ∀ i, A i →⋆ₐ[ℂ] B i)
    (hφ : ∀ i j hij x, f' i j hij (φ i x) = φ j (f i j hij x)) (i : ι) :
    (mapUnital A f B f' φ hφ).comp (ofUnital A f i) = (ofUnital B f' i).comp (φ i) :=
  StarAlgHom.ext (mapUnital_of φ hφ i)

end MapUnital

end Unital

section UnitalComm

variable {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
  {A : ι → Type v} [∀ i, CommCStarAlgebra (A i)]
  {T : ∀ ⦃i j : ι⦄, i ≤ j → Type*} {f : ∀ i j (h : i ≤ j), T h}
  [∀ i j (h : i ≤ j), FunLike (T h) (A i) (A j)]
  [∀ i j h, AlgHomClass (T h) ℂ (A i) (A j)]
  [∀ i j h, StarHomClass (T h) (A i) (A j)]
  [DirectedSystem A (f · · ·)]

/-- The C⋆-inductive limit of unital commutative C⋆-algebras along unital `⋆`-homomorphisms is a
unital commutative C⋆-algebra. -/
instance instCommCStarAlgebra : CommCStarAlgebra (CStarInductiveLimit A f) where
  __ := instCStarAlgebra
  mul_comm := mul_comm

example : (instCommCStarAlgebra (A := A) (f := f)).toNonUnitalCommCStarAlgebra =
    instNonUnitalCommCStarAlgebra :=
  rfl

end UnitalComm

end CStarInductiveLimit

end TauCeti
