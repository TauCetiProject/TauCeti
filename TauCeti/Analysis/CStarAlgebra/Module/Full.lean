/-!
# The inner-product ideal and full Hilbert C⋆-modules

For a Hilbert C⋆-module `E` over a (possibly nonunital) C⋆-algebra `A`, the range of the
`A`-valued inner product absorbs multiplication in `A` on both sides (`a * ⟪x, y⟫_A = ⟪x, a • y⟫_A`
and `⟪x, y⟫_A * a = ⟪star a • x, y⟫_A`) as well as complex scalars (`c • ⟪x, y⟫_A = ⟪x, c • y⟫_A`)
and involution (`star ⟪x, y⟫_A = ⟪y, x⟫_A`). Consequently, the algebraic two-sided ideal generated
by all inner products coincides as a set with their complex linear span `CStarModule.innerSubmodule`
(`CStarModule.coe_span_range_inner`), and by polarization this span is already generated by the
diagonal elements `⟪x, x⟫_A` (`CStarModule.innerSubmodule_eq_span_self`).

Taking closures yields the closed two-sided ideal `I_E = CStarModule.innerIdeal A E` (and, for a
right Hilbert `A`-module `CStarModule Aᵐᵒᵖ E`, `CStarModule.rightInnerIdeal A E` in `A`). A module
is *full* (`CStarModule.IsFull A E`) when `I_E = ⊤`, equivalently when `innerSubmodule A E` is dense
in `A`. Restricting scalars and codomain of the inner product to the C⋆-subalgebra `I_E` makes `E`
a full Hilbert `I_E`-module (`CStarModule.instCStarModuleInnerIdeal`,
`CStarModule.isFull_innerIdeal`), and similarly in right-module form over `rightInnerIdeal A E`
(`CStarModule.instCStarModuleRightInnerIdeal`, `CStarModule.isFull_rightInnerIdeal`).

We also establish compatibility between `idealSubmodule`, `innerIdeal`, `IsFull`, quotients, and
self-modules (`idealSubmodule_eq_top_iff`, `idealSubmodule_innerIdeal`, `idealSubmodule_eq_bot_iff`,
`idealSubmodule_innerIdeal_inf`, `idealSubmodule_comap_innerIdeal`, `innerIdeal_quotient`,
`rightInnerIdeal_quotient`, `isFull_quotient_iff`, `idealSubmodule_self`, and
`idealSubmodule_op_self`).

## Main declarations

* `CStarModule.innerSubmodule`: the complex linear span of `{⟪x, y⟫_A | x, y ∈ E}`, equal to the
  span of `{⟪x, x⟫_A | x ∈ E}` (`CStarModule.innerSubmodule_eq_span_self`) and to the underlying
  set of the two-sided ideal span (`CStarModule.coe_span_range_inner`).
* `CStarModule.innerIdeal` and `CStarModule.rightInnerIdeal`: the closed two-sided ideal `I_E`
  generated by inner products (`innerIdeal A E` for `CStarModule A E`, `rightInnerIdeal A E` for
  `CStarModule Aᵐᵒᵖ E`, both ideals of `A`).
* `CStarModule.IsFull`: predicate `innerIdeal A E = ⊤` characterizing full Hilbert C⋆-modules, with
  self-module results `CStarModule.isFull_self` and `CStarModule.isFull_mulOpposite_self`.
* `CStarModule.instCStarModuleInnerIdeal` and `CStarModule.instCStarModuleRightInnerIdeal`: the
  canonical full Hilbert `I_E`-module structure on `E`, with fullness proved in
  `CStarModule.isFull_innerIdeal` and `CStarModule.isFull_rightInnerIdeal`.
* `CStarModule.innerIdeal_quotient`, `CStarModule.rightInnerIdeal_quotient`,
  `CStarModule.isFull_quotient_iff`, `CStarModule.idealSubmodule_eq_top_iff`,
  `CStarModule.idealSubmodule_innerIdeal`, and `CStarModule.idealSubmodule_eq_bot_iff`:
  compatibility between quotients, inner-product ideals, and fullness.

## References

* E. Christopher Lance, *Hilbert C⋆-Modules: A Toolkit for Operator Algebraists*, Chapter 1.
* Iain Raeburn and Dana P. Williams, *Morita Equivalence and Continuous-Trace C⋆-Algebras*,
  Chapter 2, Lemma 2.6 and Proposition 3.25.
-/

public section

open MulOpposite Filter Topology

namespace CStarModule

/-! ### The algebraic inner-product span -/

section InnerSubmodule

/-- The complex submodule of `A` spanned by all inner products `⟪x, y⟫_A` for `x, y : E`. -/
def innerSubmodule (A E : Type*) [AddCommMonoid A] [Module ℂ A] [Inner A E] : Submodule ℂ A :=
  Submodule.span ℂ (Set.range fun p : E × E => inner A p.1 p.2)

theorem inner_mem_innerSubmodule {A E : Type*} [AddCommMonoid A] [Module ℂ A] [Inner A E]
    (x y : E) : inner A x y ∈ innerSubmodule A E :=
  Submodule.subset_span ⟨(x, y), rfl⟩

theorem innerSubmodule_le_iff {A E : Type*} [AddCommMonoid A] [Module ℂ A] [Inner A E]
    {S : Submodule ℂ A} :
    innerSubmodule A E ≤ S ↔ ∀ x y : E, inner A x y ∈ S := by
  rw [innerSubmodule, Submodule.span_le, Set.range_subset_iff, Prod.forall]
  rfl

section Algebraic

variable {A E : Type*} [NonUnitalRing A] [StarRing A] [Module ℂ A]
  [PartialOrder A] [Norm A] [AddCommGroup E] [Module ℂ E] [SMul A E] [Norm E] [CStarModule A E]

/-- By polarization, `innerSubmodule A E` is already spanned over `ℂ` by the diagonal elements
`⟪x, x⟫_A`. -/
theorem innerSubmodule_eq_span_self [StarModule ℂ A] :
    innerSubmodule A E = Submodule.span ℂ (Set.range fun x : E => inner A x x) := by
  refine le_antisymm (innerSubmodule_le_iff.mpr fun x y => ?_)
    (Submodule.span_mono <| by rintro _ ⟨x, rfl⟩; exact ⟨(x, x), rfl⟩)
  rw [inner_polarization]
  refine Submodule.smul_mem _ _ ?_
  refine Submodule.add_mem _ (Submodule.sub_mem _ (Submodule.sub_mem _ ?_ ?_) ?_) ?_
  · exact Submodule.subset_span ⟨x + y, rfl⟩
  · exact Submodule.subset_span ⟨x - y, rfl⟩
  · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨x + Complex.I • y, rfl⟩)
  · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨x - Complex.I • y, rfl⟩)

theorem innerSubmodule_le_iff_self [StarModule ℂ A] {S : Submodule ℂ A} :
    innerSubmodule A E ≤ S ↔ ∀ x : E, inner A x x ∈ S := by
  rw [innerSubmodule_eq_span_self, Submodule.span_le, Set.range_subset_iff]
  rfl

/-- The additive subgroup generated by the range of `inner A` already coincides with the complex
submodule `innerSubmodule A E`, because `c • ⟪x, y⟫_A = ⟪x, c • y⟫_A`. -/
private theorem coe_addSubgroup_closure_range_inner :
    (AddSubgroup.closure (Set.range fun p : E × E => inner A p.1 p.2) : Set A) =
      (innerSubmodule A E : Set A) := by
  set s : Set A := Set.range fun p : E × E => inner A p.1 p.2
  refine Set.Subset.antisymm
    ((AddSubgroup.closure_le (K := (innerSubmodule A E).toAddSubgroup)).mpr
      Submodule.subset_span) ?_
  let M : Submodule ℂ A :=
    { carrier := AddSubgroup.closure s
      zero_mem' := (AddSubgroup.closure s).zero_mem
      add_mem' := (AddSubgroup.closure s).add_mem
      smul_mem' := fun c {z} hz => by
        induction hz using AddSubgroup.closure_induction with
        | mem _ hx =>
          rcases hx with ⟨⟨x, y⟩, rfl⟩
          exact AddSubgroup.subset_closure ⟨(x, c • y), inner_smul_right_complex⟩
        | zero => simp
        | add _ _ _ _ hx hy => simpa [smul_add] using (AddSubgroup.closure s).add_mem hx hy
        | neg _ _ hx => simpa [smul_neg] using (AddSubgroup.closure s).neg_mem hx }
  exact (Submodule.span_le (p := M)).mpr AddSubgroup.subset_closure

/-- Because `a * ⟪x, y⟫_A = ⟪x, a • y⟫_A` and `⟪x, y⟫_A * a = ⟪star a • x, y⟫_A`, the algebraic
two-sided ideal generated by all inner products has the same underlying set as their complex linear
span `innerSubmodule A E`. -/
theorem coe_span_range_inner :
    (TwoSidedIdeal.span (Set.range fun p : E × E => inner A p.1 p.2) : Set A) =
      (innerSubmodule A E : Set A) := by
  rw [← coe_addSubgroup_closure_range_inner]
  ext z
  exact TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure_absorbing
    (s := Set.range fun p : E × E => inner A p.1 p.2)
    (fun a _ ⟨⟨x, y⟩, hy⟩ => hy ▸ ⟨(x, a • y), inner_op_smul_right⟩)
    (fun _ a ⟨⟨x, y⟩, hy⟩ => hy ▸
      ⟨(star a • x, y), by dsimp only; rw [inner_op_smul_left, star_star]⟩)

theorem mul_mem_innerSubmodule_left (a : A) {b : A} (hb : b ∈ innerSubmodule A E) :
    a * b ∈ innerSubmodule A E := by
  rw [← SetLike.mem_coe, ← coe_span_range_inner] at hb ⊢
  exact (TwoSidedIdeal.span _).mul_mem_left a b hb

theorem mul_mem_innerSubmodule_right {b : A} (hb : b ∈ innerSubmodule A E) (a : A) :
    b * a ∈ innerSubmodule A E := by
  rw [← SetLike.mem_coe, ← coe_span_range_inner] at hb ⊢
  exact (TwoSidedIdeal.span _).mul_mem_right b a hb

theorem star_mem_innerSubmodule {b : A} (hb : b ∈ innerSubmodule A E) :
    star b ∈ innerSubmodule A E := by
  rw [← SetLike.mem_coe, ← coe_addSubgroup_closure_range_inner] at hb ⊢
  induction hb using AddSubgroup.closure_induction with
  | mem _ hx =>
    rcases hx with ⟨⟨x, y⟩, rfl⟩
    exact AddSubgroup.subset_closure ⟨(y, x), (star_inner x y).symm⟩
  | zero => simp
  | add _ _ _ _ hx hy => simpa [star_add] using AddSubgroup.add_mem _ hx hy
  | neg _ _ hx => simpa [star_neg] using AddSubgroup.neg_mem _ hx

end Algebraic

end InnerSubmodule

/-! ### The closed inner-product ideal `I_E` and fullness -/

section InnerIdeal

/-- The closed two-sided ideal `I_E` of `A` generated by all inner products `⟪x, y⟫_A` (`x, y : E`).
For a `CStarModule A E`, its underlying set is `closure (innerSubmodule A E : Set A)`
(`CStarModule.coe_innerIdeal`). -/
def innerIdeal (A E : Type*) [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [Inner A E] : TwoSidedIdeal A :=
  (TwoSidedIdeal.span (Set.range fun p : E × E => inner A p.1 p.2)).topologicalClosure

/-- For a right Hilbert `A`-module `CStarModule Aᵐᵒᵖ E`, `rightInnerIdeal A E` is the closed
two-sided ideal of `A` generated by the `A`-valued inner products
`⟨x, y⟩_A = unop (inner Aᵐᵒᵖ x y)`. -/
def rightInnerIdeal (A E : Type*) [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [Inner Aᵐᵒᵖ E] : TwoSidedIdeal A :=
  (innerIdeal Aᵐᵒᵖ E).unop

/-- A Hilbert C⋆-module `E` over `A` is *full* when the closed two-sided ideal `innerIdeal A E`
generated by its inner products is all of `A`. For a right Hilbert `A`-module `CStarModule Aᵐᵒᵖ E`,
`IsFull Aᵐᵒᵖ E` is equivalent to `rightInnerIdeal A E = ⊤` (`CStarModule.isFull_mulOpposite_iff`).
-/
def IsFull (A E : Type*) [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [Inner A E] : Prop :=
  innerIdeal A E = ⊤

section TopologicalRing

variable {A E : Type*} [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A]

instance isClosed_innerIdeal [Inner A E] : IsClosed (innerIdeal A E : Set A) :=
  TwoSidedIdeal.isClosed_topologicalClosure _

instance isClosed_rightInnerIdeal [Inner Aᵐᵒᵖ E] : IsClosed (rightInnerIdeal A E : Set A) :=
  TwoSidedIdeal.isClosed_unop (innerIdeal Aᵐᵒᵖ E)

@[simp]
theorem op_rightInnerIdeal [Inner Aᵐᵒᵖ E] : (rightInnerIdeal A E).op = innerIdeal Aᵐᵒᵖ E :=
  TwoSidedIdeal.opOrderIso.right_inv (innerIdeal Aᵐᵒᵖ E)

@[simp]
theorem unop_innerIdeal [Inner Aᵐᵒᵖ E] : (innerIdeal Aᵐᵒᵖ E).unop = rightInnerIdeal A E := (rfl)

theorem inner_mem_innerIdeal [Inner A E] (x y : E) : inner A x y ∈ innerIdeal A E :=
  TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span ⟨(x, y), rfl⟩)

theorem unop_inner_mem_rightInnerIdeal [Inner Aᵐᵒᵖ E] (x y : E) :
    unop (inner Aᵐᵒᵖ x y) ∈ rightInnerIdeal A E :=
  TwoSidedIdeal.mem_unop_iff.mpr (op_unop (inner Aᵐᵒᵖ x y) ▸ inner_mem_innerIdeal x y)

/-- A closed two-sided ideal `J` contains `innerIdeal A E` if and only if it contains every inner
product `⟪x, y⟫_A`. -/
theorem innerIdeal_le_iff [Inner A E] {J : TwoSidedIdeal A} [hJ : IsClosed (J : Set A)] :
    innerIdeal A E ≤ J ↔ ∀ x y : E, inner A x y ∈ J := by
  rw [innerIdeal, TwoSidedIdeal.topologicalClosure_le_iff _ _ hJ, TwoSidedIdeal.span_le,
    Set.range_subset_iff, Prod.forall]
  rfl

/-- A closed two-sided ideal `J` of `A` contains `rightInnerIdeal A E` if and only if it contains
every `A`-valued inner product `⟨x, y⟩_A`. -/
theorem rightInnerIdeal_le_iff [Inner Aᵐᵒᵖ E] {J : TwoSidedIdeal A}
    [IsClosed (J : Set A)] :
    rightInnerIdeal A E ≤ J ↔ ∀ x y : E, unop (inner Aᵐᵒᵖ x y) ∈ J := by
  rw [← TwoSidedIdeal.opOrderIso.le_iff_le, TwoSidedIdeal.opOrderIso_apply,
    TwoSidedIdeal.opOrderIso_apply, op_rightInnerIdeal, innerIdeal_le_iff]
  simp [TwoSidedIdeal.mem_op_iff]

theorem isFull_iff_innerIdeal_eq_top [Inner A E] : IsFull A E ↔ innerIdeal A E = ⊤ :=
  Iff.rfl

@[simp]
theorem isFull_mulOpposite_iff [Inner Aᵐᵒᵖ E] : IsFull Aᵐᵒᵖ E ↔ rightInnerIdeal A E = ⊤ := by
  rw [IsFull, ← op_rightInnerIdeal, ← TwoSidedIdeal.opOrderIso_apply,
    ← TopHomClass.map_top TwoSidedIdeal.opOrderIso, TwoSidedIdeal.opOrderIso.injective.eq_iff]

/-- Restricting the codomain of `inner A` to `innerIdeal A E` equips `E` with an
`(innerIdeal A E)`-valued inner product. Scalar multiplication `SMul (innerIdeal A E) E` is
provided by Mathlib's low-priority subtype action for `SetLike` carriers
(`Mathlib/Algebra/Group/Submonoid/MulAction.lean`), acting by `(a : A) • x`. -/
instance instInnerInnerIdeal [Inner A E] : Inner (innerIdeal A E) E where
  inner x y := ⟨inner A x y, inner_mem_innerIdeal x y⟩

@[simp, norm_cast]
theorem coe_inner_innerIdeal [Inner A E] (x y : E) :
    ((inner (innerIdeal A E) x y : innerIdeal A E) : A) = inner A x y := (rfl)

/-- Right action of `rightInnerIdeal A E` on a right module `E` (`[SMul Aᵐᵒᵖ E]`), defined by
coercing coefficients to `A`. -/
instance instSMulRightInnerIdeal [Inner Aᵐᵒᵖ E] [SMul Aᵐᵒᵖ E] :
    SMul (rightInnerIdeal A E)ᵐᵒᵖ E where
  smul u x := op (u.unop : A) • x

@[simp]
theorem rightInnerIdeal_op_smul [Inner Aᵐᵒᵖ E] [SMul Aᵐᵒᵖ E]
    (a : rightInnerIdeal A E) (x : E) :
    op a • x = op (a : A) • x := (rfl)

/-- `(rightInnerIdeal A E)ᵐᵒᵖ`-valued inner product on a right module `E` (`[Inner Aᵐᵒᵖ E]`). -/
instance instInnerRightInnerIdeal [Inner Aᵐᵒᵖ E] : Inner (rightInnerIdeal A E)ᵐᵒᵖ E where
  inner x y := op ⟨unop (inner Aᵐᵒᵖ x y), unop_inner_mem_rightInnerIdeal x y⟩

@[simp, norm_cast]
theorem coe_unop_inner_rightInnerIdeal [Inner Aᵐᵒᵖ E] (x y : E) :
    ((unop (inner (rightInnerIdeal A E)ᵐᵒᵖ x y) : rightInnerIdeal A E) : A) =
      unop (inner Aᵐᵒᵖ x y) := (rfl)

end TopologicalRing

section TopologicalCStarModule

variable {A E : Type*} [NonUnitalRing A] [StarRing A] [Module ℂ A]
  [PartialOrder A] [Norm A] [TopologicalSpace A] [IsTopologicalRing A]
  [AddCommGroup E] [Module ℂ E] [SMul A E] [Norm E] [CStarModule A E]

/-- As a subset of `A`, `innerIdeal A E` is the closure of the complex linear span
`innerSubmodule A E` of inner products. -/
theorem coe_innerIdeal :
    (innerIdeal A E : Set A) = closure (innerSubmodule A E : Set A) := by
  rw [innerIdeal, TwoSidedIdeal.coe_topologicalClosure, coe_span_range_inner]

theorem mem_innerIdeal_iff {a : A} :
    a ∈ innerIdeal A E ↔ a ∈ closure (innerSubmodule A E : Set A) := by
  rw [← SetLike.mem_coe, coe_innerIdeal]

/-- `E` is full over `A` if and only if the linear span `innerSubmodule A E` of its inner products
is dense in `A`. -/
theorem isFull_iff_dense : IsFull A E ↔ Dense (innerSubmodule A E : Set A) := by
  rw [IsFull, ← SetLike.coe_set_eq, coe_innerIdeal, TwoSidedIdeal.coe_top, dense_iff_closure_eq]

theorem isFull_iff_topologicalClosure_eq_top [ContinuousConstSMul ℂ A] :
    IsFull A E ↔ (innerSubmodule A E).topologicalClosure = ⊤ := by
  rw [isFull_iff_dense, Submodule.dense_iff_topologicalClosure_eq_top]

/-- In a `T₁` coefficient ring, `innerIdeal A E = ⊥` if and only if `E` is a subsingleton. -/
@[simp]
theorem innerIdeal_eq_bot_iff [T1Space A] :
    innerIdeal A E = ⊥ ↔ Subsingleton E := by
  refine ⟨fun h => ⟨fun x y => ?_⟩, fun h => ?_⟩
  · apply sub_eq_zero.mp
    apply (inner_self (A := A)).mp
    have hmem : inner A (x - y) (x - y) ∈ (⊥ : TwoSidedIdeal A) :=
      h ▸ inner_mem_innerIdeal (x - y) (x - y)
    rwa [TwoSidedIdeal.mem_bot] at hmem
  · refine le_antisymm ?_ bot_le
    rw [innerIdeal_le_iff]
    intro x y
    rw [Subsingleton.elim x 0, inner_zero_left', TwoSidedIdeal.mem_bot]

end TopologicalCStarModule

private theorem image_linearMap_span_range {B C : Type*} [AddCommMonoid B] [Module ℂ B]
    [AddCommMonoid C] [Module ℂ C] (f : B →ₗ[ℂ] C) {ι : Type*} (g : ι → B) {h : ι → C}
    (hfg : ∀ i, f (g i) = h i) :
    f '' (Submodule.span ℂ (Set.range g) : Set B) =
      (Submodule.span ℂ (Set.range h) : Set C) := by
  rw [← Submodule.map_coe, Submodule.map_span, ← Set.range_comp]
  simp only [Function.comp_def, hfg]

section RightTopologicalCStarModule

variable {A E : Type*} [NonUnitalRing A] [StarRing A] [Module ℂ A]
  [PartialOrder A] [TopologicalSpace A] [IsTopologicalRing A] [Norm Aᵐᵒᵖ]
  [AddCommGroup E] [Module ℂ E] [SMul Aᵐᵒᵖ E] [Norm E] [CStarModule Aᵐᵒᵖ E]

/-- For a right Hilbert `A`-module, `(rightInnerIdeal A E : Set A)` is the closure of the complex
linear span of `{⟨x, y⟩_A | x, y ∈ E}`. -/
theorem coe_rightInnerIdeal :
    (rightInnerIdeal A E : Set A) =
      closure
        (Submodule.span ℂ (Set.range fun p : E × E => unop (inner Aᵐᵒᵖ p.1 p.2)) : Set A) := by
  have himg : unop '' (innerSubmodule Aᵐᵒᵖ E : Set Aᵐᵒᵖ) =
      (Submodule.span ℂ (Set.range fun p : E × E => unop (inner Aᵐᵒᵖ p.1 p.2)) : Set A) :=
    image_linearMap_span_range (opLinearEquiv ℂ (M := A)).symm.toLinearMap _ fun _ => rfl
  have hpre : unop ⁻¹'
      (Submodule.span ℂ (Set.range fun p : E × E => unop (inner Aᵐᵒᵖ p.1 p.2)) : Set A) =
      (innerSubmodule Aᵐᵒᵖ E : Set Aᵐᵒᵖ) := by
    rw [← himg, Set.preimage_image_eq _ unop_injective]
  rw [rightInnerIdeal, TwoSidedIdeal.coe_unop, coe_innerIdeal, ← hpre]
  exact (opHomeomorph.preimage_closure _).trans rfl

/-- A right Hilbert `A`-module is full if and only if the complex linear span of `{⟨x, y⟩_A}` is
dense in `A`. -/
theorem isFull_mulOpposite_iff_dense :
    IsFull Aᵐᵒᵖ E ↔
      Dense (Submodule.span ℂ (Set.range fun p : E × E => unop (inner Aᵐᵒᵖ p.1 p.2)) : Set A) := by
  rw [isFull_mulOpposite_iff, ← SetLike.coe_set_eq, coe_rightInnerIdeal, TwoSidedIdeal.coe_top,
    dense_iff_closure_eq]

@[simp]
theorem rightInnerIdeal_eq_bot_iff [T1Space A] :
    rightInnerIdeal A E = ⊥ ↔ Subsingleton E := by
  refine ⟨fun h => ⟨fun x y => ?_⟩, fun _ => ?_⟩
  · apply sub_eq_zero.mp
    apply (inner_self (A := Aᵐᵒᵖ)).mp
    apply unop_injective
    have hmem : unop (inner Aᵐᵒᵖ (x - y) (x - y)) ∈ (⊥ : TwoSidedIdeal A) :=
      h ▸ unop_inner_mem_rightInnerIdeal (x - y) (x - y)
    rwa [TwoSidedIdeal.mem_bot] at hmem
  · refine le_antisymm ?_ bot_le
    rw [rightInnerIdeal_le_iff]
    intro x y
    rw [Subsingleton.elim x 0, inner_zero_left', unop_zero, TwoSidedIdeal.mem_bot]

end RightTopologicalCStarModule

end InnerIdeal

/-! ### C⋆-algebraic properties and the full Hilbert `I_E`-module structure -/

section CStarAlgebra

variable {A E : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]

section Module

variable [AddCommGroup E] [Module ℂ E] [SMul A E] [Norm E] [CStarModule A E]

@[simp]
theorem toSubmodule_innerIdeal :
    (innerIdeal A E).toSubmodule = (innerSubmodule A E).topologicalClosure := by
  apply SetLike.coe_injective
  rw [TwoSidedIdeal.coe_toSubmodule, coe_innerIdeal, Submodule.topologicalClosure_coe]

/-- A closed two-sided ideal `J` of a C⋆-algebra `A` contains `innerIdeal A E` if and only if it
contains every diagonal inner product `⟪x, x⟫_A`. -/
theorem innerIdeal_le_iff_self {J : TwoSidedIdeal A} [IsClosed (J : Set A)] :
    innerIdeal A E ≤ J ↔ ∀ x : E, inner A x x ∈ J := by
  refine ⟨fun h x => h (inner_mem_innerIdeal x x), fun h => ?_⟩
  have hsub : (innerIdeal A E).toSubmodule ≤ J.toSubmodule := by
    rw [toSubmodule_innerIdeal]
    exact Submodule.topologicalClosure_minimal _
      (innerSubmodule_le_iff_self.mpr fun x => J.mem_toSubmodule.mpr (h x)) J.isClosed_toSubmodule
  exact fun a ha => J.mem_toSubmodule.mp (hsub ((innerIdeal A E).mem_toSubmodule.mpr ha))

/-- Mapping `innerSubmodule (innerIdeal A E) E` into `A` recovers `innerSubmodule A E`. -/
theorem image_coe_innerSubmodule_innerIdeal :
    ((↑) : innerIdeal A E → A) '' (innerSubmodule (innerIdeal A E) E : Set (innerIdeal A E)) =
      (innerSubmodule A E : Set A) :=
  image_linearMap_span_range (innerIdeal A E).toSubmodule.subtype _ fun _ => rfl

/-- Every Hilbert `A`-module `E` is canonically a Hilbert `(innerIdeal A E)`-module by restricting
scalars and the codomain of the inner product to `innerIdeal A E`. -/
noncomputable instance instCStarModuleInnerIdeal : CStarModule (innerIdeal A E) E where
  toInner := inferInstance
  inner_add_right := Subtype.ext inner_add_right
  inner_self_nonneg {x} := (inner_self_nonneg (A := A) (x := x) : (0 : A) ≤ inner A x x)
  inner_self {x} := by rw [Subtype.ext_iff]; exact inner_self (A := A)
  inner_op_smul_right {a x y} := Subtype.ext (inner_op_smul_right (a := (a : A)))
  inner_smul_right_complex {c x y} := Subtype.ext inner_smul_right_complex
  star_inner x y := Subtype.ext (star_inner x y)
  norm_eq_sqrt_norm_inner_self x := norm_eq_sqrt_norm_inner_self (A := A) x

/-- Viewed over `I_E = innerIdeal A E`, the inner-product ideal of `E` is all of `I_E`. -/
@[simp]
theorem innerIdeal_innerIdeal : innerIdeal (innerIdeal A E) E = ⊤ := by
  ext z
  simp only [TwoSidedIdeal.mem_top, iff_true]
  rw [mem_innerIdeal_iff, closure_subtype, image_coe_innerSubmodule_innerIdeal, ← coe_innerIdeal]
  exact z.property

/-- Every Hilbert C⋆-module `E` is full as a Hilbert module over `innerIdeal A E`. -/
theorem isFull_innerIdeal : IsFull (innerIdeal A E) E := innerIdeal_innerIdeal

end Module

section RightModule

variable [AddCommGroup E] [Module ℂ E] [SMul Aᵐᵒᵖ E] [Norm E] [CStarModule Aᵐᵒᵖ E]

/-- A closed two-sided ideal `J` of `A` contains `rightInnerIdeal A E` if and only if it contains
every diagonal inner product `⟨x, x⟩_A = unop (inner Aᵐᵒᵖ x x)`. -/
theorem rightInnerIdeal_le_iff_self {J : TwoSidedIdeal A} [IsClosed (J : Set A)] :
    rightInnerIdeal A E ≤ J ↔ ∀ x : E, unop (inner Aᵐᵒᵖ x x) ∈ J := by
  rw [← TwoSidedIdeal.opOrderIso.le_iff_le, TwoSidedIdeal.opOrderIso_apply,
    TwoSidedIdeal.opOrderIso_apply, op_rightInnerIdeal, innerIdeal_le_iff_self]
  simp [TwoSidedIdeal.mem_op_iff]

/-- Every right Hilbert `A`-module `E` is canonically a right Hilbert `(rightInnerIdeal A E)`-module
via `CStarModule (rightInnerIdeal A E)ᵐᵒᵖ E`. -/
noncomputable instance instCStarModuleRightInnerIdeal :
    CStarModule (rightInnerIdeal A E)ᵐᵒᵖ E where
  toInner := inferInstance
  inner_add_right := unop_injective <| Subtype.ext (by simp)
  inner_self_nonneg {x} := op_nonneg.mpr
    (unop_nonneg.mpr (inner_self_nonneg (A := Aᵐᵒᵖ) (x := x)) :
      (0 : A) ≤ unop (inner Aᵐᵒᵖ x x))
  inner_self {x} := by
    rw [← unop_eq_zero_iff, Subtype.ext_iff, ZeroMemClass.coe_zero, coe_unop_inner_rightInnerIdeal,
      unop_eq_zero_iff]
    exact inner_self (A := Aᵐᵒᵖ)
  inner_op_smul_right {a x y} := by
    obtain ⟨a, rfl⟩ := op_surjective a
    exact unop_injective <| Subtype.ext (by simp)
  inner_smul_right_complex {c x y} := unop_injective <| Subtype.ext (by simp)
  star_inner x y := unop_injective <| Subtype.ext <| by
    rw [unop_star, TwoSidedIdeal.coe_star, coe_unop_inner_rightInnerIdeal,
      coe_unop_inner_rightInnerIdeal, ← unop_star, star_inner]
  norm_eq_sqrt_norm_inner_self x := by
    rw [← norm_unop, AddSubgroupClass.coe_norm, coe_unop_inner_rightInnerIdeal, norm_unop]
    exact norm_eq_sqrt_norm_inner_self (A := Aᵐᵒᵖ) x

/-- Mapping the complex span of right inner products over `rightInnerIdeal A E` into `A` recovers
the complex span of right inner products over `A`. -/
theorem image_coe_span_unop_inner_rightInnerIdeal :
    ((↑) : rightInnerIdeal A E → A) ''
        (Submodule.span ℂ (Set.range fun p : E × E =>
          unop (inner (rightInnerIdeal A E)ᵐᵒᵖ p.1 p.2)) : Set (rightInnerIdeal A E)) =
      (Submodule.span ℂ (Set.range fun p : E × E => unop (inner Aᵐᵒᵖ p.1 p.2)) : Set A) :=
  image_linearMap_span_range (rightInnerIdeal A E).toSubmodule.subtype _ fun _ => rfl

/-- Viewed as a right module over `I_E = rightInnerIdeal A E`, the right inner-product ideal of `E`
is all of `I_E`. -/
@[simp]
theorem rightInnerIdeal_rightInnerIdeal :
    rightInnerIdeal (rightInnerIdeal A E) E = ⊤ := by
  ext z
  simp only [TwoSidedIdeal.mem_top, iff_true]
  rw [← SetLike.mem_coe, coe_rightInnerIdeal, closure_subtype,
    image_coe_span_unop_inner_rightInnerIdeal, ← coe_rightInnerIdeal]
  exact z.property

/-- Every right Hilbert `A`-module `E` is full over `rightInnerIdeal A E`. -/
theorem isFull_rightInnerIdeal : IsFull (rightInnerIdeal A E)ᵐᵒᵖ E :=
  isFull_mulOpposite_iff.mpr rightInnerIdeal_rightInnerIdeal

end RightModule

section Self

variable [StarOrderedRing A]

/-- A C⋆-algebra `A` is full as a right Hilbert module over itself (`CStarModule Aᵐᵒᵖ A`). -/
theorem isFull_mulOpposite_self : IsFull Aᵐᵒᵖ A := by
  rw [isFull_mulOpposite_iff_dense]
  exact dense_range_unop_inner_mulOpposite.mono Submodule.subset_span

@[simp]
theorem rightInnerIdeal_self : rightInnerIdeal A A = ⊤ :=
  isFull_mulOpposite_iff.mp isFull_mulOpposite_self

/-- A C⋆-algebra `A` is full as a left Hilbert module over itself (`CStarModule A A`). -/
theorem isFull_self : IsFull A A := by
  rw [isFull_iff_dense]
  have hl := CStarAlgebra.increasingApproximateUnit A
  have := hl.neBot
  refine fun y => mem_closure_of_tendsto (hl.tendsto_mul_left y) ?_
  filter_upwards [hl.eventually_star_eq] with e he
  exact Submodule.subset_span ⟨(e, y), by simp [WithCStarModule.inner_def, he]⟩

@[simp]
theorem innerIdeal_self : innerIdeal A A = ⊤ := isFull_self

end Self

end CStarAlgebra

/-! ### Compatibility of `idealSubmodule`, `innerIdeal`, `IsFull`, and self-modules -/

section Compatibility

variable {A E : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

section Module

variable [NormedAddCommGroup E] [NormedSpace ℂ E] [SMul A E] [CStarModule A E]

/-- For a closed ideal `J`, `E J = E` if and only if `innerIdeal A E ≤ J`. -/
theorem idealSubmodule_eq_top_iff {J : TwoSidedIdeal A} [IsClosed (J : Set A)] :
    idealSubmodule J E = ⊤ ↔ innerIdeal A E ≤ J := by
  rw [Submodule.eq_top_iff', innerIdeal_le_iff_self]
  exact forall_congr' fun _ => mem_idealSubmodule_iff

/-- Every Hilbert `A`-module is nondegenerate over its own inner-product ideal:
`E (innerIdeal A E) = E`. -/
@[simp]
theorem idealSubmodule_innerIdeal : idealSubmodule (innerIdeal A E) E = ⊤ :=
  idealSubmodule_eq_top_iff.mpr le_rfl

/-- For a closed ideal `J`, `E J = ⊥` if and only if `innerIdeal A E ⊓ J = ⊥`. -/
theorem idealSubmodule_eq_bot_iff {J : TwoSidedIdeal A} [IsClosed (J : Set A)] :
    idealSubmodule J E = ⊥ ↔ innerIdeal A E ⊓ J = ⊥ := by
  refine ⟨fun h => le_antisymm (fun a ha => ?_) bot_le, fun h => ?_⟩
  · rw [TwoSidedIdeal.mem_inf] at ha
    obtain ⟨haI, haJ⟩ := ha
    -- Since `a ∈ J` and `E J = ⊥`, `a` annihilates `E`, hence left-annihilates `innerIdeal A E`.
    have hann_inner : (innerSubmodule A E : Set A) ⊆ {b : A | a * b = 0} := by
      let mulLeftLM : A →ₗ[ℂ] A :=
        { toFun := (a * ·), map_add' := mul_add a, map_smul' := fun c b => mul_smul_comm c a b }
      have hle : innerSubmodule A E ≤ LinearMap.ker mulLeftLM := by
        rw [innerSubmodule_le_iff]
        intro x y
        have hay : a • y = 0 := (Submodule.mem_bot ℂ).mp (h ▸ smul_mem_idealSubmodule haJ y)
        simp [mulLeftLM, ← inner_op_smul_right, hay]
      exact fun b hb => by simpa [mulLeftLM] using hle hb
    have hann_ideal : ∀ b ∈ innerIdeal A E, a * b = 0 := fun b hb =>
      closure_minimal hann_inner (isClosed_eq (continuous_const_mul a) continuous_const)
        (mem_innerIdeal_iff.mp hb)
    rw [TwoSidedIdeal.mem_bot]
    exact mul_star_self_eq_zero.mp (hann_ideal (star a) ((innerIdeal A E).star_mem_of_isClosed haI))
  · rw [eq_bot_iff]
    intro x hx
    rw [Submodule.mem_bot, ← inner_self (A := A), ← TwoSidedIdeal.mem_bot, ← h,
      TwoSidedIdeal.mem_inf]
    exact ⟨inner_mem_innerIdeal x x, mem_idealSubmodule_iff.mp hx⟩

/-- `E J` depends on the closed ideal `J` only through `innerIdeal A E ⊓ J`. -/
@[simp]
theorem idealSubmodule_innerIdeal_inf (J : TwoSidedIdeal A) [IsClosed (J : Set A)] :
    idealSubmodule (innerIdeal A E ⊓ J) E = idealSubmodule J E := by
  rw [idealSubmodule_inf, idealSubmodule_innerIdeal, top_inf_eq]

/-- Viewing `E` as a Hilbert module over `innerIdeal A E`, the submodule attached to
`J ∩ innerIdeal A E` (`TwoSidedIdeal.comap (innerIdeal A E).starAlgHom J`) coincides with
`idealSubmodule J E`. -/
theorem idealSubmodule_comap_innerIdeal (J : TwoSidedIdeal A) [IsClosed (J : Set A)] :
    idealSubmodule (TwoSidedIdeal.comap (innerIdeal A E).starAlgHom J) E =
      idealSubmodule J E := by
  have : IsClosed
      (TwoSidedIdeal.comap (innerIdeal A E).starAlgHom J : Set (innerIdeal A E)) :=
    TwoSidedIdeal.isClosed_comap (innerIdeal A E).isometry_starAlgHom.continuous J
  ext x
  rw [mem_idealSubmodule_iff, TwoSidedIdeal.mem_comap, TwoSidedIdeal.starAlgHom_apply,
    coe_inner_innerIdeal, mem_idealSubmodule_iff]

/-- The inner-product ideal of the quotient module `E ⧸ idealSubmodule J E` over `A ⧸ J` is the
pushforward of `innerIdeal A E` along the quotient map `mk J : A →ₙ+* A ⧸ J` (which is already
closed by `TwoSidedIdeal.isClosed_map_mk`). -/
@[simp]
theorem innerIdeal_quotient (J : TwoSidedIdeal A) [IsClosed (J : Set A)] :
    innerIdeal (A ⧸ J) (E ⧸ idealSubmodule J E) =
      TwoSidedIdeal.map (TwoSidedIdeal.Quotient.mk J) (innerIdeal A E) := by
  refine le_antisymm ?_ ?_
  · rw [innerIdeal_le_iff]
    intro u v
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ u
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ v
    rw [inner_mk_mk,
      TwoSidedIdeal.mem_map_iff_of_surjective (TwoSidedIdeal.Quotient.mk_surjective J)]
    exact ⟨inner A x y, inner_mem_innerIdeal x y, rfl⟩
  · rw [TwoSidedIdeal.map_le_iff_le_comap]
    have := TwoSidedIdeal.isClosed_comap (TwoSidedIdeal.Quotient.continuous_mk J)
      (innerIdeal (A ⧸ J) (E ⧸ idealSubmodule J E))
    rw [innerIdeal_le_iff]
    exact fun x y => (TwoSidedIdeal.mem_comap _).mpr (inner_mk_mk J x y ▸ inner_mem_innerIdeal _ _)

/-- The quotient module `E ⧸ idealSubmodule J E` is full over `A ⧸ J` if and only if
`innerIdeal A E ⊔ J = ⊤`. -/
theorem isFull_quotient_iff (J : TwoSidedIdeal A) [IsClosed (J : Set A)] :
    IsFull (A ⧸ J) (E ⧸ idealSubmodule J E) ↔ innerIdeal A E ⊔ J = ⊤ := by
  rw [isFull_iff_innerIdeal_eq_top, innerIdeal_quotient, TwoSidedIdeal.map_mk_eq_top_iff]

/-- Every quotient of a full Hilbert `A`-module by a closed two-sided ideal is full over `A ⧸ J`.
-/
theorem IsFull.quotient (h : IsFull A E) (J : TwoSidedIdeal A) [IsClosed (J : Set A)] :
    IsFull (A ⧸ J) (E ⧸ idealSubmodule J E) := by
  rw [isFull_quotient_iff, isFull_iff_innerIdeal_eq_top.mp h, top_sup_eq]

end Module

section RightModule

variable [NormedAddCommGroup E] [NormedSpace ℂ E] [SMul Aᵐᵒᵖ E] [CStarModule Aᵐᵒᵖ E]

/-- Right-module form: for a closed ideal `J` of `A`, `idealSubmodule J.op E = ⊤` if and only if
`rightInnerIdeal A E ≤ J`. -/
theorem idealSubmodule_op_eq_top_iff {J : TwoSidedIdeal A} [IsClosed (J : Set A)] :
    idealSubmodule J.op E = ⊤ ↔ rightInnerIdeal A E ≤ J := by
  rw [idealSubmodule_eq_top_iff, ← op_rightInnerIdeal, ← TwoSidedIdeal.opOrderIso_apply,
    ← TwoSidedIdeal.opOrderIso_apply]
  exact TwoSidedIdeal.opOrderIso.le_iff_le

/-- Right-module form: every right Hilbert `A`-module is nondegenerate over its own
inner-product ideal, `idealSubmodule (rightInnerIdeal A E).op E = ⊤`. -/
theorem idealSubmodule_op_rightInnerIdeal :
    idealSubmodule (rightInnerIdeal A E).op E = ⊤ :=
  idealSubmodule_op_eq_top_iff.mpr le_rfl

/-- Right-module form: for a closed ideal `J` of `A`, `idealSubmodule J.op E = ⊥` if and only if
`rightInnerIdeal A E ⊓ J = ⊥`. -/
theorem idealSubmodule_op_eq_bot_iff {J : TwoSidedIdeal A} [IsClosed (J : Set A)] :
    idealSubmodule J.op E = ⊥ ↔ rightInnerIdeal A E ⊓ J = ⊥ := by
  rw [idealSubmodule_eq_bot_iff, ← op_rightInnerIdeal, ← TwoSidedIdeal.opOrderIso_apply,
    ← TwoSidedIdeal.opOrderIso_apply, ← map_inf TwoSidedIdeal.opOrderIso,
    ← map_bot TwoSidedIdeal.opOrderIso, TwoSidedIdeal.opOrderIso.injective.eq_iff]

/-- Right-module form: `rightInnerIdeal (A ⧸ J) (E ⧸ idealSubmodule J.op E)` is the pushforward of
`rightInnerIdeal A E` along `mk J : A →ₙ+* A ⧸ J`. -/
@[simp]
theorem rightInnerIdeal_quotient (J : TwoSidedIdeal A) [IsClosed (J : Set A)] :
    rightInnerIdeal (A ⧸ J) (E ⧸ idealSubmodule J.op E) =
      TwoSidedIdeal.map (TwoSidedIdeal.Quotient.mk J) (rightInnerIdeal A E) := by
  refine le_antisymm ?_ ?_
  · rw [rightInnerIdeal_le_iff]
    intro u v
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ u
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ v
    rw [unop_inner_mk_mk,
      TwoSidedIdeal.mem_map_iff_of_surjective (TwoSidedIdeal.Quotient.mk_surjective J)]
    exact ⟨unop (inner Aᵐᵒᵖ x y), unop_inner_mem_rightInnerIdeal x y, rfl⟩
  · rw [TwoSidedIdeal.map_le_iff_le_comap]
    have := TwoSidedIdeal.isClosed_comap (TwoSidedIdeal.Quotient.continuous_mk J)
      (rightInnerIdeal (A ⧸ J) (E ⧸ idealSubmodule J.op E))
    rw [rightInnerIdeal_le_iff]
    exact fun x y =>
      (TwoSidedIdeal.mem_comap _).mpr (unop_inner_mk_mk J x y ▸ unop_inner_mem_rightInnerIdeal _ _)

/-- Right-module form: `E ⧸ idealSubmodule J.op E` is full as a right Hilbert `(A ⧸ J)`-module if
and only if `rightInnerIdeal A E ⊔ J = ⊤`. -/
theorem isFull_quotient_mulOpposite_iff (J : TwoSidedIdeal A) [IsClosed (J : Set A)] :
    IsFull (A ⧸ J)ᵐᵒᵖ (E ⧸ idealSubmodule J.op E) ↔ rightInnerIdeal A E ⊔ J = ⊤ := by
  rw [isFull_mulOpposite_iff, rightInnerIdeal_quotient, TwoSidedIdeal.map_mk_eq_top_iff]

theorem IsFull.quotient_mulOpposite (h : IsFull Aᵐᵒᵖ E) (J : TwoSidedIdeal A)
    [IsClosed (J : Set A)] :
    IsFull (A ⧸ J)ᵐᵒᵖ (E ⧸ idealSubmodule J.op E) := by
  rw [isFull_quotient_mulOpposite_iff, isFull_mulOpposite_iff.mp h, top_sup_eq]

end RightModule

section Self

variable (J : TwoSidedIdeal A) [IsClosed (J : Set A)]

/-- For `A` viewed as a left Hilbert module over itself, `idealSubmodule J A` is `J.toSubmodule`.
-/
theorem idealSubmodule_self : idealSubmodule J A = J.toSubmodule := by
  refine le_antisymm ?_ ?_
  · exact (idealSubmodule_le_iff J.isClosed_toSubmodule).mpr fun a ha x =>
      J.mul_mem_right a x ha
  · intro a ha
    rw [mem_idealSubmodule_iff, WithCStarModule.inner_def]
    exact J.mul_mem_right a (star a) ha

/-- For `A` viewed as a right Hilbert module over itself (`CStarModule Aᵐᵒᵖ A`),
`idealSubmodule J.op A` is `J.toSubmodule`. -/
theorem idealSubmodule_op_self : idealSubmodule J.op A = J.toSubmodule := by
  refine le_antisymm ?_ ?_
  · exact (idealSubmodule_le_iff J.isClosed_toSubmodule).mpr fun u hu x =>
      J.mul_mem_left x u.unop (TwoSidedIdeal.mem_op_iff.mp hu)
  · intro a ha
    rw [mem_idealSubmodule_op_iff, unop_inner_mulOpposite]
    exact J.mul_mem_left (star a) a ha

end Self

end Compatibility

end CStarModule
