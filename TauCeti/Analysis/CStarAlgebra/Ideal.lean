/-!
# Closed two-sided ideals in C⋆-algebras and full elements

Every closed two-sided ring ideal `I : TwoSidedIdeal A` of a (possibly nonunital) complex
C⋆-algebra `A` is automatically closed under complex scalar multiplication and under the involution
`star`, hence forms a nonunital C⋆-subalgebra of `A` in its own right.

For scalar multiplication, `(c • e) * a = c • (e * a) → c • a` along an approximate unit `e` of `A`
while `(c • e) * a ∈ I` by left ideal absorption. For self-adjointness, the symmetric core
`S = {x ∈ I | star x ∈ I}` (`ClosedSubmodule.starSubalgebra`) is already a closed nonunital
`⋆`-subalgebra of `A`, hence a nonunital C⋆-algebra containing `star a * a` for every `a ∈ I`.
Along the increasing approximate unit `e` of `S`, right ideal absorption gives
`(e : A) * star a ∈ I`, while
`Filter.IsIncreasingApproximateUnit.tendsto_mul_star_of_star_mul_self_mem` gives
`(e : A) * star a → star a` (see, e.g., Gerard J. Murphy, *C*-Algebras and Operator Theory*,
Theorem 3.1.3, or Kenneth R. Davidson, *C*-Algebras by Example*, Theorem I.5.3).

## Main declarations

* `TwoSidedIdeal.smul_mem_of_isClosed`: closed two-sided ideals in C⋆-algebras absorb complex
  scalars (specializing `TwoSidedIdeal.smul_mem_of_isApproximateUnit`).
* `TwoSidedIdeal.star_mem_of_isClosed` and `Ideal.star_mem_of_isClosed`: closed two-sided ideals in
  C⋆-algebras are closed under `star`.
* `TwoSidedIdeal.toSubmodule` and `TwoSidedIdeal.toNonUnitalStarSubalgebra`: bundle a closed
  two-sided ideal of a C⋆-algebra as a `Submodule ℂ A` and as a `NonUnitalStarSubalgebra ℂ A`.
* `TwoSidedIdeal.nonUnitalCStarAlgebra`: a closed two-sided ideal `I : TwoSidedIdeal A` is a
  `NonUnitalCStarAlgebra` on its subtype carrier, with canonical isometric `⋆`-monomorphism
  `TwoSidedIdeal.starAlgHom : I →⋆ₙₐ[ℂ] A`, `⋆`-isomorphism
  `TwoSidedIdeal.toNonUnitalStarSubalgebraEquiv : I ≃⋆ₐ[ℂ] I.toNonUnitalStarSubalgebra`, and
  functional-calculus closure `TwoSidedIdeal.cfcₙ_mem_of_isClosed` and
  `TwoSidedIdeal.cfcₙ_nnreal_mem_of_isClosed`.
* `TwoSidedIdeal.instStarOrderedRingOfIsClosed`: the order of `A` restricted to a closed ideal `I`
  is the C⋆-algebra order of `I`.
* `TwoSidedIdeal.coe_topologicalClosure_span_eq_closure_span_univ_mul_univ`: the closed two-sided
  ideal generated by any subset `s` of a C⋆-algebra equals
  `closure (span ℂ (Set.univ * s * Set.univ))`.
* `TauCeti.isFull_iff_closure_span_mul_eq_univ` and `TauCeti.isFull_star`: C⋆-algebra
  characterizations of full elements (`TauCeti.IsFull`, defined in
  `TauCeti.Topology.Algebra.Ring.TwoSidedIdeal.Basic`).

## References

* Gerard J. Murphy, *C*-Algebras and Operator Theory*, Theorem 3.1.3.
* Kenneth R. Davidson, *C*-Algebras by Example*, Theorem I.5.3.
-/

public section

open Filter Topology
open scoped CStarAlgebra NNReal

namespace TwoSidedIdeal

section CStarAlgebra

variable {A : Type*} [NonUnitalCStarAlgebra A] (I : TwoSidedIdeal A) [hI : IsClosed (I : Set A)]

/-- Every closed two-sided ideal of a C⋆-algebra is closed under complex scalar multiplication. -/
theorem smul_mem_of_isClosed (c : ℂ) {a : A} (ha : a ∈ I) : c • a ∈ I := by
  let _ := CStarAlgebra.spectralOrder A
  have _ := CStarAlgebra.spectralOrderedRing A
  exact I.smul_mem_of_isApproximateUnit
    (CStarAlgebra.increasingApproximateUnit A).toIsApproximateUnit c ha

/-- A closed two-sided ideal of a C⋆-algebra bundled as a complex submodule. -/
@[expose] def toSubmodule : Submodule ℂ A :=
  I.toSubmoduleOfSMulMem I.smul_mem_of_isClosed

@[simp]
theorem coe_toSubmodule : (I.toSubmodule : Set A) = I :=
  I.coe_toSubmoduleOfSMulMem I.smul_mem_of_isClosed

@[simp, grind =]
theorem mem_toSubmodule {a : A} : a ∈ I.toSubmodule ↔ a ∈ I :=
  mem_toSubmoduleOfSMulMem

instance isClosed_toSubmodule : IsClosed (I.toSubmodule : Set A) :=
  hI

/-- Every closed two-sided ideal of a C⋆-algebra is self-adjoint (closed under `star`). -/
theorem star_mem_of_isClosed {a : A} (ha : a ∈ I) : star a ∈ I := by
  let _ := CStarAlgebra.spectralOrder A
  have _ := CStarAlgebra.spectralOrderedRing A
  let L : ClosedSubmodule ℂ A := ⟨I.toSubmodule, hI⟩
  let S : NonUnitalStarSubalgebra ℂ A := L.starSubalgebra I.mul_mem_left
  have : IsClosed (S : Set A) := L.isClosed_starSubalgebra _
  have _ : StarOrderedRing S := Subtype.starOrderedRing (𝕜 := ℂ) S
  have hl : (CStarAlgebra.approximateUnit S).IsIncreasingApproximateUnit :=
    CStarAlgebra.increasingApproximateUnit S
  have := hl.neBot
  have hmem : star a * a ∈ S := L.mem_starSubalgebra.mpr
    ⟨I.mul_mem_left (star a) a ha, by rw [star_mul, star_star]; exact I.mul_mem_left (star a) a ha⟩
  refine hI.mem_of_tendsto (hl.tendsto_mul_star_of_star_mul_self_mem hmem) ?_
  exact Eventually.of_forall fun e =>
    I.mul_mem_right (e : A) (star a) (L.mem_starSubalgebra.mp e.property).1

@[simp, grind =]
theorem star_mem_iff_of_isClosed {a : A} : star a ∈ I ↔ a ∈ I :=
  ⟨fun h => star_star a ▸ I.star_mem_of_isClosed h, I.star_mem_of_isClosed⟩

/-- A closed two-sided ideal of a C⋆-algebra bundled as a nonunital complex ⋆-subalgebra. -/
def toNonUnitalStarSubalgebra : NonUnitalStarSubalgebra ℂ A where
  __ := I.toSubmodule
  mul_mem' hx _ := I.mul_mem_right _ _ hx
  star_mem' hx := I.star_mem_of_isClosed hx

@[simp]
theorem coe_toNonUnitalStarSubalgebra : (I.toNonUnitalStarSubalgebra : Set A) = I :=
  (rfl)

@[simp, grind =]
theorem mem_toNonUnitalStarSubalgebra {a : A} : a ∈ I.toNonUnitalStarSubalgebra ↔ a ∈ I :=
  Iff.rfl

/-- `I.toNonUnitalStarSubalgebra` absorbs multiplication on the left by elements of `A`. -/
theorem mul_mem_toNonUnitalStarSubalgebra :
    ∀ a : A, ∀ x ∈ I.toNonUnitalStarSubalgebra, a * x ∈ I.toNonUnitalStarSubalgebra :=
  I.mul_mem_left

instance isClosed_toNonUnitalStarSubalgebra :
    IsClosed (I.toNonUnitalStarSubalgebra : Set A) :=
  hI

instance instStar : Star I where
  star x := ⟨star (x : A), I.star_mem_of_isClosed x.property⟩

@[simp, norm_cast]
theorem coe_star (x : I) : ((star x : I) : A) = star (x : A) :=
  (rfl)

instance instStarRing : StarRing I where
  star_involutive x := Subtype.ext (star_star (x : A))
  star_mul x y := Subtype.ext (star_mul (x : A) (y : A))
  star_add x y := Subtype.ext (star_add (x : A) (y : A))

instance instSMulComplex : SMul ℂ I where
  smul c x := ⟨c • (x : A), I.smul_mem_of_isClosed c x.property⟩

@[simp, norm_cast]
theorem coe_smul_complex (c : ℂ) (x : I) : ((c • x : I) : A) = c • (x : A) :=
  (rfl)

instance instModuleComplex : Module ℂ I :=
  Function.Injective.module ℂ I.coeAddMonoidHom Subtype.coe_injective I.coe_smul_complex

noncomputable instance instNormedSpaceComplex : NormedSpace ℂ I where
  norm_smul_le c x := norm_smul_le c (x : A)

instance instIsScalarTowerComplex : IsScalarTower ℂ I I where
  smul_assoc c x y := Subtype.ext (smul_mul_assoc c (x : A) (y : A))

instance instSMulCommClassComplex : SMulCommClass ℂ I I where
  smul_comm c x y := Subtype.ext (mul_smul_comm c (x : A) (y : A)).symm

instance instStarModuleComplex : StarModule ℂ I where
  star_smul c x := Subtype.ext (star_smul c (x : A))

instance instCompleteSpace : CompleteSpace I :=
  hI.completeSpace_coe

instance instCStarRing : CStarRing I where
  norm_mul_self_le x := (CStarRing.norm_star_mul_self (x := (x : A))).symm.le

/-- Every closed two-sided ideal of a C⋆-algebra is a nonunital C⋆-algebra in its own right. -/
noncomputable instance nonUnitalCStarAlgebra : NonUnitalCStarAlgebra I where

noncomputable instance nonUnitalCommCStarAlgebra {A : Type*}
    [NonUnitalCommCStarAlgebra A] (I : TwoSidedIdeal A) [IsClosed (I : Set A)] :
    NonUnitalCommCStarAlgebra I where
  mul_comm x y := Subtype.ext (mul_comm (x : A) (y : A))

/-- The canonical isometric ⋆-algebra monomorphism from a closed two-sided ideal `I` into `A`. -/
def starAlgHom : I →⋆ₙₐ[ℂ] A where
  toFun x := x
  map_smul' c x := by simp
  map_zero' := rfl
  map_add' _ _ := rfl
  map_mul' _ _ := rfl
  map_star' _ := rfl

@[simp]
theorem coe_starAlgHom : ⇑I.starAlgHom = ((↑) : I → A) :=
  (rfl)

@[simp]
theorem starAlgHom_apply (x : I) : I.starAlgHom x = (x : A) :=
  (rfl)

theorem starAlgHom_injective : Function.Injective I.starAlgHom :=
  Subtype.coe_injective

theorem isometry_starAlgHom : Isometry I.starAlgHom :=
  isometry_subtypeVal

@[simp]
theorem range_starAlgHom :
    NonUnitalStarAlgHom.range I.starAlgHom = I.toNonUnitalStarSubalgebra := by
  ext a
  simp [NonUnitalStarAlgHom.mem_range]

@[simp]
theorem ker_starAlgHom : TwoSidedIdeal.ker I.starAlgHom = ⊥ := by
  ext x
  rw [TwoSidedIdeal.mem_ker, TwoSidedIdeal.mem_bot, starAlgHom_apply, Subtype.ext_iff]
  rfl

/-- The canonical `⋆`-algebra isomorphism between a closed two-sided ideal `I` and its associated
nonunital `⋆`-subalgebra `I.toNonUnitalStarSubalgebra`. -/
def toNonUnitalStarSubalgebraEquiv : I ≃⋆ₐ[ℂ] I.toNonUnitalStarSubalgebra :=
  { NonUnitalStarAlgHom.codRestrict I.starAlgHom I.toNonUnitalStarSubalgebra
      fun x => I.mem_toNonUnitalStarSubalgebra.mpr x.property with
    invFun := fun x => ⟨x, I.mem_toNonUnitalStarSubalgebra.mp x.property⟩
    left_inv := fun _ => Subtype.ext rfl
    right_inv := fun _ => Subtype.ext rfl }

@[simp]
theorem toNonUnitalStarSubalgebraEquiv_apply (x : I) :
    I.toNonUnitalStarSubalgebraEquiv x = ⟨x, I.mem_toNonUnitalStarSubalgebra.mpr x.property⟩ :=
  (rfl)

@[simp]
theorem toNonUnitalStarSubalgebraEquiv_symm_apply (x : I.toNonUnitalStarSubalgebra) :
    I.toNonUnitalStarSubalgebraEquiv.symm x = ⟨x, I.mem_toNonUnitalStarSubalgebra.mp x.property⟩ :=
  (rfl)

theorem coe_toNonUnitalStarSubalgebraEquiv_apply (x : I) :
    (I.toNonUnitalStarSubalgebraEquiv x : A) = x :=
  (rfl)

theorem coe_toNonUnitalStarSubalgebraEquiv_symm_apply (x : I.toNonUnitalStarSubalgebra) :
    (I.toNonUnitalStarSubalgebraEquiv.symm x : A) = x :=
  (rfl)

@[simp]
theorem subtype_comp_toNonUnitalStarSubalgebraEquiv :
    (NonUnitalStarSubalgebraClass.subtype I.toNonUnitalStarSubalgebra).comp
      I.toNonUnitalStarSubalgebraEquiv.toNonUnitalStarAlgHom = I.starAlgHom :=
  (rfl)

/-- The nonunital continuous functional calculus of an element in a closed two-sided ideal of a
C⋆-algebra stays in the ideal. -/
theorem cfcₙ_mem_of_isClosed {𝕜 : Type*} [RCLike 𝕜] [NormedSpace 𝕜 A] [SMulCommClass 𝕜 A A]
    [IsScalarTower 𝕜 A A] [StarModule 𝕜 A] {p : A → Prop}
    [NonUnitalContinuousFunctionalCalculus 𝕜 A p] [SMul 𝕜 ℂ] [IsScalarTower 𝕜 ℂ A]
    (f : 𝕜 → 𝕜) {a : A} (ha : a ∈ I) :
    cfcₙ f a ∈ I :=
  I.mem_toNonUnitalStarSubalgebra.mp <|
    cfcₙ_mem (𝕜' := ℂ) (s := I.toNonUnitalStarSubalgebra) f
      (I.mem_toNonUnitalStarSubalgebra.mpr ha)

/-- The `ℝ≥0` nonunital continuous functional calculus of an element in a closed two-sided ideal of
a C⋆-algebra stays in the ideal. -/
theorem cfcₙ_nnreal_mem_of_isClosed [PartialOrder A] [StarOrderedRing A]
    (f : ℝ≥0 → ℝ≥0) {a : A} (ha : a ∈ I) :
    cfcₙ f a ∈ I :=
  I.mem_toNonUnitalStarSubalgebra.mp <|
    cfcₙ_nnreal_mem (𝕜 := ℂ) (s := I.toNonUnitalStarSubalgebra) f
      (I.mem_toNonUnitalStarSubalgebra.mpr ha)

/-- The order of a C⋆-algebra restricted to a closed two-sided ideal `I` is the C⋆-algebra order
of `I`. -/
instance instStarOrderedRingOfIsClosed [PartialOrder A] [StarOrderedRing A] : StarOrderedRing I :=
  -- Mathlib's `Subtype.starOrderedRing` does not apply to `I` as a `TwoSidedIdeal` (which has no
  -- `SMulMemClass`), so it is applied to the star subalgebra `I.toNonUnitalStarSubalgebra`. This
  -- relies on `↥I` and `↥I.toNonUnitalStarSubalgebra` being the same subtype of `A`, with the same
  -- ring, star and order structures (all induced from `A`), so the instance for the subalgebra is
  -- one for `I` by definitional unfolding.
  Subtype.starOrderedRing (𝕜 := ℂ) I.toNonUnitalStarSubalgebra

end CStarAlgebra

open scoped Pointwise in
/-- In a C⋆-algebra, the closed two-sided ideal generated by any subset `s` coincides as a set
with the closure of the complex linear span of `Set.univ * s * Set.univ`. -/
theorem coe_topologicalClosure_span_eq_closure_span_univ_mul_univ {A : Type*}
    [NonUnitalCStarAlgebra A] (s : Set A) :
    ((TwoSidedIdeal.span s).topologicalClosure : Set A) =
      closure (Submodule.span ℂ (Set.univ * s * Set.univ) : Set A) := by
  let _ := CStarAlgebra.spectralOrder A
  have _ := CStarAlgebra.spectralOrderedRing A
  let M : Submodule ℂ A := (Submodule.span ℂ (Set.univ * s * Set.univ)).topologicalClosure
  have hM_closed : IsClosed (M : Set A) := Submodule.isClosed_topologicalClosure _
  refine Set.Subset.antisymm ?_ ?_
  · rw [TwoSidedIdeal.coe_topologicalClosure, ← Submodule.topologicalClosure_coe]
    refine closure_minimal ?_ hM_closed
    let l : Filter A := CStarAlgebra.approximateUnit A
    have hl : l.IsIncreasingApproximateUnit := CStarAlgebra.increasingApproximateUnit A
    have := hl.neBot
    have h3 : Set.univ * s * Set.univ ⊆ (M : Set A) :=
      (Submodule.subset_span).trans (Submodule.le_topologicalClosure _)
    have h2_left : Set.univ * s ⊆ (M : Set A) := by
      rintro _ ⟨x, -, b, hb, rfl⟩
      exact hM_closed.mem_of_tendsto (hl.tendsto_mul_left (x * b)) <|
        Eventually.of_forall fun e => h3 ⟨x * b, ⟨x, trivial, b, hb, rfl⟩, e, trivial, rfl⟩
    have h2_right : s * Set.univ ⊆ (M : Set A) := by
      rintro _ ⟨b, hb, y, -, rfl⟩
      exact hM_closed.mem_of_tendsto (hl.tendsto_mul_right (b * y)) <|
        Eventually.of_forall fun e =>
          h3 ⟨e * b, ⟨e, trivial, b, hb, rfl⟩, y, trivial, mul_assoc e b y⟩
    have h1 : s ⊆ (M : Set A) := fun b hb =>
      hM_closed.mem_of_tendsto (hl.tendsto_mul_left b) <|
        Eventually.of_forall fun e => h2_right ⟨b, hb, e, trivial, rfl⟩
    intro z hz
    rw [SetLike.mem_coe, TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure_nonunital] at hz
    have hle : AddSubgroup.closure (s ∪ s * Set.univ ∪ Set.univ * s ∪ Set.univ * s * Set.univ) ≤
        M.toAddSubgroup := by
      rw [AddSubgroup.closure_le]
      simp only [Submodule.coe_toAddSubgroup, Set.union_subset_iff]
      exact ⟨⟨⟨h1, h2_right⟩, h2_left⟩, h3⟩
    exact hle hz
  · let J := (TwoSidedIdeal.span s).topologicalClosure
    have hJ : IsClosed (J : Set A) := TwoSidedIdeal.isClosed_topologicalClosure _
    refine closure_minimal ?_ hJ
    rw [← J.coe_toSubmodule, SetLike.coe_subset_coe, Submodule.span_le]
    rintro _ ⟨_, ⟨x, -, b, hb, rfl⟩, y, -, rfl⟩
    exact J.mul_mem_right _ y
      (J.mul_mem_left x _ (TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span hb)))

end TwoSidedIdeal

namespace Ideal

variable {A : Type*} [CStarAlgebra A] (I : Ideal A) [I.IsTwoSided] [hI : IsClosed (I : Set A)]

/-- Every closed two-sided `Ideal` of a unital C⋆-algebra is closed under `star`. -/
theorem star_mem_of_isClosed {a : A} (ha : a ∈ I) : star a ∈ I := by
  have : IsClosed (I.toTwoSided : Set A) := by simpa only [Ideal.coe_toTwoSided] using hI
  rw [← Ideal.mem_toTwoSided] at ha ⊢
  exact I.toTwoSided.star_mem_of_isClosed ha

@[simp, grind =]
theorem star_mem_iff_of_isClosed {a : A} : star a ∈ I ↔ a ∈ I :=
  ⟨fun h => star_star a ▸ I.star_mem_of_isClosed h, I.star_mem_of_isClosed⟩

/-- Bundle a closed two-sided `Ideal` of a unital C⋆-algebra as a `NonUnitalStarSubalgebra ℂ A`. -/
def toNonUnitalStarSubalgebra : NonUnitalStarSubalgebra ℂ A where
  carrier := I
  add_mem' := I.add_mem
  zero_mem' := I.zero_mem
  smul_mem' c a ha := algebraMap_smul A c a ▸ I.mul_mem_left (algebraMap ℂ A c) ha
  mul_mem' hx _ := I.mul_mem_right _ hx
  star_mem' hx := I.star_mem_of_isClosed hx

@[simp]
theorem coe_toNonUnitalStarSubalgebra : (I.toNonUnitalStarSubalgebra : Set A) = I :=
  (rfl)

@[simp, grind =]
theorem mem_toNonUnitalStarSubalgebra {a : A} : a ∈ I.toNonUnitalStarSubalgebra ↔ a ∈ I :=
  Iff.rfl

instance isClosed_toNonUnitalStarSubalgebra :
    IsClosed (I.toNonUnitalStarSubalgebra : Set A) :=
  hI

/-- The nonunital continuous functional calculus of an element in a closed two-sided `Ideal` of a
unital C⋆-algebra stays in the ideal. -/
theorem cfcₙ_mem_of_isClosed {𝕜 : Type*} [RCLike 𝕜] [NormedSpace 𝕜 A] [SMulCommClass 𝕜 A A]
    [IsScalarTower 𝕜 A A] [StarModule 𝕜 A] {p : A → Prop}
    [NonUnitalContinuousFunctionalCalculus 𝕜 A p] [SMul 𝕜 ℂ] [IsScalarTower 𝕜 ℂ A]
    (f : 𝕜 → 𝕜) {a : A} (ha : a ∈ I) :
    cfcₙ f a ∈ I :=
  I.mem_toNonUnitalStarSubalgebra.mp <|
    cfcₙ_mem (𝕜' := ℂ) (s := I.toNonUnitalStarSubalgebra) f
      (I.mem_toNonUnitalStarSubalgebra.mpr ha)

/-- The `ℝ≥0` nonunital continuous functional calculus of an element in a closed two-sided `Ideal`
of a unital C⋆-algebra stays in the ideal. -/
theorem cfcₙ_nnreal_mem_of_isClosed [PartialOrder A] [StarOrderedRing A]
    (f : ℝ≥0 → ℝ≥0) {a : A} (ha : a ∈ I) :
    cfcₙ f a ∈ I :=
  I.mem_toNonUnitalStarSubalgebra.mp <|
    cfcₙ_nnreal_mem (𝕜 := ℂ) (s := I.toNonUnitalStarSubalgebra) f
      (I.mem_toNonUnitalStarSubalgebra.mpr ha)

end Ideal

namespace TauCeti

section Full

open scoped Pointwise in
/-- In a (possibly nonunital) C⋆-algebra `A`, an element `a` is full if and only if the complex
linear span of the two-sided products `Set.univ * {a} * Set.univ` is norm-dense in `A`. -/
theorem isFull_iff_closure_span_mul_eq_univ {A : Type*} [NonUnitalCStarAlgebra A] {a : A} :
    IsFull a ↔
      closure (Submodule.span ℂ (Set.univ * ({a} : Set A) * Set.univ) : Set A) = Set.univ := by
  rw [isFull_def, ← SetLike.coe_set_eq,
    TwoSidedIdeal.coe_topologicalClosure_span_eq_closure_span_univ_mul_univ,
    TwoSidedIdeal.coe_top]

@[simp]
theorem isFull_star {A : Type*} [NonUnitalCStarAlgebra A] {a : A} :
    IsFull (star a) ↔ IsFull a := by
  have hclosure {x y : A} (hxy : y = star x) :
      (TwoSidedIdeal.span ({x} : Set A)).topologicalClosure ≤
        (TwoSidedIdeal.span ({y} : Set A)).topologicalClosure := by
    let J := (TwoSidedIdeal.span ({y} : Set A)).topologicalClosure
    have : IsClosed (J : Set A) := TwoSidedIdeal.isClosed_topologicalClosure _
    refine (TwoSidedIdeal.topologicalClosure_le_iff _ J this).mpr
      (TwoSidedIdeal.span_le.mpr ?_)
    rw [Set.singleton_subset_iff, SetLike.mem_coe, ← J.star_mem_iff_of_isClosed, ← hxy]
    exact TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span rfl)
  rw [isFull_def, isFull_def,
    le_antisymm (hclosure (star_star a).symm) (hclosure rfl)]

end Full

end TauCeti
