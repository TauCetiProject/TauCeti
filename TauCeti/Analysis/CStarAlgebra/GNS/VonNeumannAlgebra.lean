/-!
# The GNS von Neumann algebra and its vector state

For a positive functional `f` on a possibly nonunital C⋆-algebra `A`, with GNS representation
`π_f` on the GNS space `H_f`, the *GNS von Neumann algebra* `PositiveLinearMap.gnsVonNeumannAlgebra`
is the von Neumann algebra `π_f(A)''` generated by `π_f(A)`. It is the smallest von Neumann
algebra on `H_f` containing `π_f(A)`, `PositiveLinearMap.gnsVonNeumannAlgebra_le_iff`, and its
commutant `M_f'` consists of the operators commuting with `π_f(A)`,
`PositiveLinearMap.mem_gnsVonNeumannAlgebra_commutant_iff`. For unital `A` it is also generated by
the unital representation, `PositiveLinearMap.gnsVonNeumannAlgebra_eq_adjoin_range_gnsStarAlgHom`.
For tracial `f`, the right representation of `Aᵐᵒᵖ` takes values in the commutant `M_f'`,
`PositiveLinearMap.gnsRightNonUnitalStarAlgHom_mem_commutant`.

For unital `A`, with GNS vector `Ω = [1]`, the *GNS vector state*
`PositiveLinearMap.gnsVectorState` is the positive functional `x ↦ ⟪Ω, x Ω⟫` on `π_f(A)''`, viewed
as a C⋆-algebra. It extends `f` along `π_f`,
`PositiveLinearMap.gnsVectorState_gnsNonUnitalStarAlgHom`, and its value at `x⋆ x` is
`‖x Ω‖ ^ 2`, `PositiveLinearMap.gnsVectorState_star_mul_self`.

If `f` is tracial, `f (a b) = f (b a)`, then so is its vector state on `π_f(A)''`,
`PositiveLinearMap.gnsVectorState_mul_comm`. Traciality passes from `π_f(A)` to `π_f(A)''` one
variable at a time. For `b ∈ A` the vector functionals `x ↦ ⟪Ω, x π_f(b) Ω⟫` and
`x ↦ ⟪π_f(b⋆) Ω, x Ω⟫ = ⟪Ω, π_f(b) x Ω⟫` agree on `π_f(A)`, as `f (c b) = f (b c)`. Then for fixed
`x ∈ π_f(A)''` the vector functionals `y ↦ ⟪x⋆ Ω, y Ω⟫` and `y ↦ ⟪Ω, y x Ω⟫` agree on `π_f(A)` by
the first step. In both steps, vector functionals that agree on `π_f(A)` agree on `π_f(A)''` by the
von Neumann density theorem, `PositiveLinearMap.inner_apply_eq_of_mem_gnsVonNeumannAlgebra`. For a
tracial state the vector state is thus the vector trace, a faithful tracial state of `π_f(A)''`;
see `TauCeti.Analysis.CStarAlgebra.Action.KMS.VectorState`.

## References

* N. P. Brown, *Invariant means and finite representation theory of C⋆-algebras*, Mem. Amer.
  Math. Soc. 184 (2006), Chapter 2, for the GNS von Neumann algebra of a tracial state and its
  vector trace.
-/

public section

open scoped InnerProductSpace ComplexOrder Pointwise

namespace PositiveLinearMap

section NonUnital

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
  (f : A →ₚ[ℂ] ℂ)

/-- The GNS von Neumann algebra `π_f(A)''` of a positive functional `f`: the von Neumann algebra
on the GNS space generated by the GNS representation `π_f`. -/
noncomputable def gnsVonNeumannAlgebra : VonNeumannAlgebra f.GNS :=
  VonNeumannAlgebra.adjoin (Set.range f.gnsNonUnitalStarAlgHom)

/-- The GNS von Neumann algebra is the von Neumann algebra generated by the GNS
representation. -/
theorem gnsVonNeumannAlgebra_def :
    f.gnsVonNeumannAlgebra = VonNeumannAlgebra.adjoin (Set.range f.gnsNonUnitalStarAlgHom) :=
  (rfl)

/-- The GNS von Neumann algebra contains the image of the GNS representation. -/
@[simp]
theorem gnsNonUnitalStarAlgHom_mem_gnsVonNeumannAlgebra (a : A) :
    f.gnsNonUnitalStarAlgHom a ∈ f.gnsVonNeumannAlgebra :=
  VonNeumannAlgebra.subset_adjoin _ ⟨a, rfl⟩

/-- The GNS von Neumann algebra is the smallest von Neumann algebra containing the image of the
GNS representation. -/
@[simp]
theorem gnsVonNeumannAlgebra_le_iff {M : VonNeumannAlgebra f.GNS} :
    f.gnsVonNeumannAlgebra ≤ M ↔ ∀ a, f.gnsNonUnitalStarAlgHom a ∈ M := by
  simp [gnsVonNeumannAlgebra_def, VonNeumannAlgebra.adjoin_le_iff, Set.range_subset_iff]

private theorem star_range_gnsNonUnitalStarAlgHom_subset :
    star (Set.range f.gnsNonUnitalStarAlgHom) ⊆ Set.range f.gnsNonUnitalStarAlgHom := by
  rintro _ ⟨a, ha⟩
  exact ⟨star a, by rw [map_star, ha, star_star]⟩

/-- The commutant of the GNS von Neumann algebra is the centralizer of the GNS representation. -/
theorem coe_commutant_gnsVonNeumannAlgebra :
    (f.gnsVonNeumannAlgebra.commutant : Set (f.GNS →L[ℂ] f.GNS)) =
      (Set.range f.gnsNonUnitalStarAlgHom).centralizer := by
  rw [gnsVonNeumannAlgebra_def, VonNeumannAlgebra.coe_commutant_adjoin,
    Set.union_eq_left.2 f.star_range_gnsNonUnitalStarAlgHom_subset]

/-- An operator lies in the GNS von Neumann algebra exactly when it lies in the double
commutant of the GNS representation. -/
theorem mem_gnsVonNeumannAlgebra_iff {x : f.GNS →L[ℂ] f.GNS} :
    x ∈ f.gnsVonNeumannAlgebra ↔
      x ∈ (Set.range f.gnsNonUnitalStarAlgHom).centralizer.centralizer := by
  rw [← SetLike.mem_coe, gnsVonNeumannAlgebra_def,
    VonNeumannAlgebra.coe_adjoin_of_star_subset f.star_range_gnsNonUnitalStarAlgHom_subset]

/-- An operator lies in the commutant `M_f'` of the GNS von Neumann algebra exactly when it
commutes with the image of the GNS representation. -/
theorem mem_gnsVonNeumannAlgebra_commutant_iff {T : f.GNS →L[ℂ] f.GNS} :
    T ∈ f.gnsVonNeumannAlgebra.commutant ↔
      ∀ a, f.gnsNonUnitalStarAlgHom a * T = T * f.gnsNonUnitalStarAlgHom a := by
  rw [gnsVonNeumannAlgebra_def, VonNeumannAlgebra.mem_commutant_adjoin_iff_of_star_subset
    f.star_range_gnsNonUnitalStarAlgHom_subset, Set.forall_mem_range]

/-- The right representation of a tracial functional takes values in the commutant `M_f'` of the
GNS von Neumann algebra. -/
theorem gnsRightNonUnitalStarAlgHom_mem_commutant (hf : ∀ a b, f (a * b) = f (b * a))
    (b : Aᵐᵒᵖ) : f.gnsRightNonUnitalStarAlgHom hf b ∈ f.gnsVonNeumannAlgebra.commutant :=
  (f.mem_gnsVonNeumannAlgebra_commutant_iff).2 fun a ↦
    (f.commute_gnsNonUnitalStarAlgHom_gnsRightNonUnitalStarAlgHom hf a b).eq

end NonUnital

section Unital

variable {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A] (f : A →ₚ[ℂ] ℂ)

/-- The range of the unital GNS representation equals the range of the non-unital GNS
representation. -/
@[simp]
theorem range_gnsStarAlgHom :
    Set.range f.gnsStarAlgHom = Set.range f.gnsNonUnitalStarAlgHom :=
  congrArg Set.range (funext f.gnsStarAlgHom_apply)

/-- For a unital algebra, the GNS von Neumann algebra is generated by the unital GNS
representation. -/
theorem gnsVonNeumannAlgebra_eq_adjoin_range_gnsStarAlgHom :
    f.gnsVonNeumannAlgebra = VonNeumannAlgebra.adjoin (Set.range f.gnsStarAlgHom) := by
  rw [gnsVonNeumannAlgebra_def, range_gnsStarAlgHom]

/-- The vector state `x ↦ ⟪Ω, x Ω⟫` of the GNS vector `Ω` on the GNS von Neumann algebra of a
positive functional `f` on a unital C⋆-algebra. It recovers `f` on the image of the GNS
representation, `gnsVectorState_gnsNonUnitalStarAlgHom`, and it is a state when `f 1 = 1`. -/
noncomputable def gnsVectorState : f.gnsVonNeumannAlgebra.toStarSubalgebra →P[ℂ] ℂ :=
  .ofClass <| PositiveLinearMap.mk₀
    ({ toFun x := ⟪f.gnsVector, (x : f.GNS →L[ℂ] f.GNS) f.gnsVector⟫_ℂ
       map_add' x y := by simp [inner_add_right]
       map_smul' c x := by simp [inner_smul_right] } :
      f.gnsVonNeumannAlgebra.toStarSubalgebra →ₗ[ℂ] ℂ)
    fun x hx => by
      simpa using ((ContinuousLinearMap.nonneg_iff_isPositive).mp hx).inner_nonneg_right
        f.gnsVector

/-- The GNS vector state at `x` is `⟪Ω, x Ω⟫`. -/
theorem gnsVectorState_apply (x : f.gnsVonNeumannAlgebra.toStarSubalgebra) :
    f.gnsVectorState x = ⟪f.gnsVector, (x : f.GNS →L[ℂ] f.GNS) f.gnsVector⟫_ℂ :=
  (rfl)

/-- The GNS vector state recovers `f` on the image of the GNS representation. -/
@[simp]
theorem gnsVectorState_gnsNonUnitalStarAlgHom (a : A) :
    f.gnsVectorState
        ⟨f.gnsNonUnitalStarAlgHom a, f.gnsNonUnitalStarAlgHom_mem_gnsVonNeumannAlgebra a⟩ =
      f a := by
  simp [gnsVectorState_apply, inner_gnsVector_coe]

/-- The GNS vector state takes the value `f 1` at the unit. -/
@[simp]
theorem gnsVectorState_one : f.gnsVectorState 1 = f 1 := by
  simp [gnsVectorState_apply, norm_gnsVector_sq]

/-- The norm of the GNS vector state is `f 1`, so it is a state exactly when `f 1 = 1`. -/
theorem ofReal_opNorm_gnsVectorState :
    (‖(f.gnsVectorState : f.gnsVonNeumannAlgebra.toStarSubalgebra →L[ℂ] ℂ)‖ : ℂ) = f 1 :=
  (f.gnsVectorState.ofReal_opNorm_eq_map_one).trans f.gnsVectorState_one

/-- The GNS vector state at `x⋆ x` is the squared norm of `x Ω`. -/
theorem gnsVectorState_star_mul_self (x : f.gnsVonNeumannAlgebra.toStarSubalgebra) :
    f.gnsVectorState (star x * x) = (‖(x : f.GNS →L[ℂ] f.GNS) f.gnsVector‖ ^ 2 : ℝ) := by
  simp [gnsVectorState_apply, ContinuousLinearMap.star_eq_adjoint,
    ContinuousLinearMap.adjoint_inner_right, inner_self_eq_norm_sq_to_K]

/-- Two vector functionals that agree on the image of the GNS representation agree on the GNS
von Neumann algebra. -/
theorem inner_apply_eq_of_mem_gnsVonNeumannAlgebra {u₁ v₁ u₂ v₂ : f.GNS}
    (h : ∀ c, ⟪u₁, f.gnsStarAlgHom c v₁⟫_ℂ = ⟪u₂, f.gnsStarAlgHom c v₂⟫_ℂ)
    {x : f.GNS →L[ℂ] f.GNS} (hx : x ∈ f.gnsVonNeumannAlgebra) :
    ⟪u₁, x v₁⟫_ℂ = ⟪u₂, x v₂⟫_ℂ := by
  rw [gnsVonNeumannAlgebra_eq_adjoin_range_gnsStarAlgHom] at hx
  refine VonNeumannAlgebra.inner_apply_eq_of_mem_adjoin (fun t ht => ?_) hx
  -- the unital star algebra generated by the image of `π` is that image
  have hrange : StarAlgebra.adjoin ℂ (Set.range f.gnsStarAlgHom) ≤ f.gnsStarAlgHom.range :=
    StarAlgebra.adjoin_le (Set.range_subset_iff.mpr fun c => ⟨c, rfl⟩)
  obtain ⟨c, rfl⟩ := hrange ht
  exact h c

/-- **The GNS vector state of a tracial functional is tracial.** If `f (a b) = f (b a)` for all
`a, b`, then the vector state `x ↦ ⟪Ω, x Ω⟫` on the GNS von Neumann algebra satisfies
`⟪Ω, x y Ω⟫ = ⟪Ω, y x Ω⟫`. -/
theorem gnsVectorState_mul_comm (hf : ∀ a b, f (a * b) = f (b * a))
    (x y : f.gnsVonNeumannAlgebra.toStarSubalgebra) :
    f.gnsVectorState (x * y) = f.gnsVectorState (y * x) := by
  -- for `b ∈ A`, the functionals `x ↦ ⟪Ω, x π(b) Ω⟫` and `x ↦ ⟪Ω, π(b) x Ω⟫` agree on `π(A)`,
  -- hence on the GNS von Neumann algebra
  have hgen {x : f.GNS →L[ℂ] f.GNS} (hx : x ∈ f.gnsVonNeumannAlgebra) (b : A) :
      ⟪f.gnsVector, x (f.gnsStarAlgHom b f.gnsVector)⟫_ℂ =
        ⟪f.gnsVector, f.gnsStarAlgHom b (x f.gnsVector)⟫_ℂ := by
    conv_rhs => rw [← ContinuousLinearMap.adjoint_inner_left,
      ← ContinuousLinearMap.star_eq_adjoint, ← map_star]
    refine f.inner_apply_eq_of_mem_gnsVonNeumannAlgebra (fun c => ?_) hx
    calc ⟪f.gnsVector, f.gnsStarAlgHom c (f.gnsStarAlgHom b f.gnsVector)⟫_ℂ
        = ⟪f.gnsStarAlgHom 1 f.gnsVector, f.gnsStarAlgHom (c * b) f.gnsVector⟫_ℂ := by
          rw [map_one, map_mul, one_apply_eq_self, mul_apply_eq_comp]
      _ = f (b * c) := by rw [inner_gnsStarAlgHom_gnsVector, star_one, one_mul, hf]
      _ = ⟪f.gnsStarAlgHom (star b) f.gnsVector, f.gnsStarAlgHom c f.gnsVector⟫_ℂ := by
          rw [inner_gnsStarAlgHom_gnsVector, star_star]
  -- for fixed `x`, the functionals `y ↦ ⟪x⋆ Ω, y Ω⟫` and `y ↦ ⟪Ω, y x Ω⟫` agree on `π(A)`,
  -- hence on the GNS von Neumann algebra
  have hxy := f.inner_apply_eq_of_mem_gnsVonNeumannAlgebra
    (u₁ := star (x : f.GNS →L[ℂ] f.GNS) f.gnsVector) (v₁ := f.gnsVector) (u₂ := f.gnsVector)
    (v₂ := (x : f.GNS →L[ℂ] f.GNS) f.gnsVector) (fun c => ?_) y.property
  · rw [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_left] at hxy
    simpa [gnsVectorState_apply] using hxy
  · rw [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_left]
    exact hgen x.property c

end Unital

end PositiveLinearMap
