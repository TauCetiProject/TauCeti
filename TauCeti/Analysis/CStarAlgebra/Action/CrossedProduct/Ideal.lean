module

public import TauCeti.Analysis.CStarAlgebra.Action.Convolution.Ideal
public import TauCeti.Analysis.CStarAlgebra.Action.Covariant.Ideal
public import TauCeti.Analysis.CStarAlgebra.Action.CrossedProduct.Functoriality
public import TauCeti.Analysis.CStarAlgebra.Action.Ideal
import TauCeti.Topology.Algebra.NonUnitalStarAlgebra

/-!
# Embedding full crossed products of closed invariant ideals

Let `α` be a point-norm continuous action of a locally compact group `G` on a C⋆-algebra `A`, and
let `I` be a closed `α`-invariant nonunital star subalgebra of `A` equipped with the restricted
action `hI.restrict` and equivariant inclusion `hI.subtypeHom`.

When `I` is a closed `α`-invariant two-sided star ideal of `A`:
* `hI.subtypeHom.fullCrossedProductMap μ` is an isometric closed embedding of
  `FullCrossedProduct hI.restrict μ` into `FullCrossedProduct α μ`;
* its range is a closed two-sided star ideal of `FullCrossedProduct α μ`, equal to the
  topological closure of the image of `C_c(G, I)`;
* for any closed `α`-invariant star subalgebra `I`, the extended integrated form of a covariant
  representation `P` of `α` vanishes on `(hI.subtypeHom.fullCrossedProductMap μ).range` precisely
  when `P.coefficient` vanishes on `I`.

For a bundled closed invariant two-sided ideal `I : TwoSidedIdeal A`, the same results are exposed
for `hI.idealSubtypeHom`, and the embedded crossed product is bundled as the closed two-sided ideal
`hI.fullCrossedProductIdeal μ : TwoSidedIdeal (FullCrossedProduct α μ)`, identified with the
topological closure of `TwoSidedIdeal.span` of the image of `C_c(G, I)`.

These results combine the compact-support ideal absorption in
`TauCeti.Analysis.CStarAlgebra.Action.Convolution.Ideal` with the covariant representation
extensions in `TauCeti.Analysis.CStarAlgebra.Action.Covariant.Ideal` to supply the ideal-embedding
half of the full crossed-product short exact sequence associated to an invariant ideal. No
unitality, separability, or global σ-finiteness is assumed.

## Main statements

* `IsInvariant.isometry_fullCrossedProductMap_subtypeHom` and
  `IsInvariant.isClosedEmbedding_fullCrossedProductMap_subtypeHom`: isometric closed embedding of
  the ideal crossed product into the ambient full crossed product (plus `idealSubtypeHom`
  counterparts).
* `IsInvariant.range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure`: identification of
  that embedded range with the closed star subalgebra generated by `C_c(G, I)`.
* `IsInvariant.mul_mem_range_fullCrossedProductMap_subtypeHom_left` and
  `IsInvariant.mul_mem_range_fullCrossedProductMap_subtypeHom_right`: two-sided ideal absorption
  in `FullCrossedProduct α μ`.
* `IsInvariant.fullCrossedProductRestrictIdealEquiv`, `IsInvariant.fullCrossedProductIdeal`, and
  `IsInvariant.fullCrossedProductIdeal_eq_topologicalClosure_span`: canonical `⋆`-isomorphism
  between `FullCrossedProduct hI.restrictIdeal μ` and
  `FullCrossedProduct hI.toNonUnitalStarSubalgebra.restrict μ`, and the closed two-sided ideal of
  `FullCrossedProduct α μ` attached to a closed invariant `I : TwoSidedIdeal A` (with boundary
  identifications `TauCeti.CStarAction.fullCrossedProductIdeal_bot` and
  `TauCeti.CStarAction.fullCrossedProductIdeal_top`).
* `IsInvariant.forall_mem_range_fullCrossedProductMap_subtypeHom_integratedFull_eq_zero_iff`:
  characterization of covariant representations annihilating the embedded crossed product.

## References

* Dana Williams, *Crossed Products of C*-Algebras*, Proposition 3.19.
-/

public section

noncomputable section

open MeasureTheory Topology TauCeti CStarAction CStarAction.FullCrossedProduct
open scoped CStarAlgebra

namespace IsInvariant

universe u v

section StarSubalgebra

variable {G : Type u} {A : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G] [NonUnitalCStarAlgebra A]
  {α : CStarAction G A} {I : NonUnitalStarSubalgebra ℂ A} [IsClosed (I : Set A)]
  (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
  (μ : Measure G) [μ.IsHaarMeasure]

/-- Every compactly supported function in `C_c(G, I)` maps into the range of
`hI.subtypeHom.fullCrossedProductMap μ` inside `FullCrossedProduct α μ`. -/
theorem of_convolutionMap_mem_range_fullCrossedProductMap_subtypeHom
    (f : ConvolutionAlgebra hI.restrict μ) :
    of α μ (hI.subtypeHom.convolutionMap μ f) ∈
      (hI.subtypeHom.fullCrossedProductMap μ).range :=
  (hI.subtypeHom.fullCrossedProductMap μ).mem_range.2
    ⟨of hI.restrict μ f, hI.subtypeHom.fullCrossedProductMap_of μ f⟩

/-- Any compactly supported function on `G` taking values in `I` maps under `FullCrossedProduct.of`
into the range of `hI.subtypeHom.fullCrossedProductMap μ`. -/
theorem of_mem_range_fullCrossedProductMap_subtypeHom_of_forall_mem
    {f : ConvolutionAlgebra α μ} (hf : ∀ s : G, f.ofConv s ∈ I) :
    of α μ f ∈ (hI.subtypeHom.fullCrossedProductMap μ).range := by
  obtain ⟨g, rfl⟩ := (hI.subtypeHom.convolutionMap μ).mem_range.1 <|
    (hI.mem_range_convolutionMap_subtypeHom_iff μ).2 hf
  exact hI.of_convolutionMap_mem_range_fullCrossedProductMap_subtypeHom μ g

/-- The extended integrated form of a covariant representation `P` of `α` vanishes on the range of
`hI.subtypeHom.fullCrossedProductMap μ` precisely when `P.coefficient` vanishes on `I`. -/
theorem forall_mem_range_fullCrossedProductMap_subtypeHom_integratedFull_eq_zero_iff
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (P : CovariantRepresentation α H) :
    (∀ y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range, P.integratedFull μ y = 0) ↔
      ∀ x ∈ I, P.coefficient x = 0 := by
  rw [P.forall_mem_range_fullCrossedProductMap_integratedFull_eq_zero_iff μ hI.subtypeHom]
  simp only [subtypeHom_apply, Subtype.forall]

/-- The induced full crossed-product map from a closed invariant two-sided star ideal preserves
norms identically. -/
theorem norm_fullCrossedProductMap_subtypeHom (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    (x : FullCrossedProduct hI.restrict μ) :
    ‖hI.subtypeHom.fullCrossedProductMap μ x‖ = ‖x‖ := by
  induction x using FullCrossedProduct.induction_on with
  | hp =>
    exact isClosed_eq
      (continuous_norm.comp (map_continuous (hI.subtypeHom.fullCrossedProductMap μ)))
      continuous_norm
  | ih f =>
    rw [Hom.fullCrossedProductMap_of, norm_of, norm_of,
      hI.fullSeminorm_convolutionMap_subtypeHom μ hmul f]

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is an
isometry. -/
theorem isometry_fullCrossedProductMap_subtypeHom (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    Isometry (hI.subtypeHom.fullCrossedProductMap μ) :=
  AddMonoidHomClass.isometry_of_norm _ (hI.norm_fullCrossedProductMap_subtypeHom μ hmul)

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is a closed
topological embedding. -/
theorem isClosedEmbedding_fullCrossedProductMap_subtypeHom
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosedEmbedding (hI.subtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_subtypeHom μ hmul).isClosedEmbedding

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is
injective. -/
theorem fullCrossedProductMap_subtypeHom_injective (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    Function.Injective (hI.subtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_subtypeHom μ hmul).injective

/-- The range of `hI.subtypeHom.fullCrossedProductMap μ` is closed in `FullCrossedProduct α μ`. -/
theorem isClosed_range_fullCrossedProductMap_subtypeHom
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosed ((hI.subtypeHom.fullCrossedProductMap μ).range : Set (FullCrossedProduct α μ)) := by
  rw [NonUnitalStarAlgHom.coe_range]
  exact (hI.isClosedEmbedding_fullCrossedProductMap_subtypeHom μ hmul).isClosed_range

/-- For a closed invariant two-sided star ideal `I`, the range of
`hI.subtypeHom.fullCrossedProductMap μ` equals the topological closure of the image of `C_c(G, I)`
inside `FullCrossedProduct α μ`. -/
theorem range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    (hI.subtypeHom.fullCrossedProductMap μ).range =
      ((of α μ).comp (hI.subtypeHom.convolutionMap μ)).range.topologicalClosure := by
  refine le_antisymm (hI.subtypeHom.range_fullCrossedProductMap_le_topologicalClosure μ) ?_
  refine NonUnitalStarSubalgebra.topologicalClosure_minimal _ ?_
    (hI.isClosed_range_fullCrossedProductMap_subtypeHom μ hmul)
  rw [← hI.subtypeHom.fullCrossedProductMap_comp_of μ]
  exact NonUnitalStarAlgHom.range_comp_le_range _ _

/-- The embedded full crossed product of a closed invariant two-sided star ideal is closed under
left multiplication in `FullCrossedProduct α μ`. -/
theorem mul_mem_range_fullCrossedProductMap_subtypeHom_left
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    (a : FullCrossedProduct α μ) {y : FullCrossedProduct α μ}
    (hy : y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range) :
    a * y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range := by
  rw [hI.range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure μ hmul,
    ← SetLike.mem_coe, NonUnitalStarSubalgebra.topologicalClosure_coe] at hy ⊢
  refine map_mem_closure₂ continuous_mul (denseRange_of (α := α) (μ := μ) a) hy ?_
  rintro _ ⟨f, rfl⟩ z hz
  obtain ⟨g, rfl⟩ := ((of α μ).comp (hI.subtypeHom.convolutionMap μ)).mem_range.1 hz
  simp only [NonUnitalStarAlgHom.comp_apply, ← map_mul]
  obtain ⟨k, hk⟩ := (hI.subtypeHom.convolutionMap μ).mem_range.1 <|
    hI.mul_mem_range_convolutionMap_subtypeHom_left μ hmul f
      ((hI.subtypeHom.convolutionMap μ).mem_range.2 ⟨g, rfl⟩)
  exact ((of α μ).comp (hI.subtypeHom.convolutionMap μ)).mem_range.2
    ⟨k, by rw [NonUnitalStarAlgHom.comp_apply, hk]⟩

/-- The embedded full crossed product of a closed invariant two-sided star ideal is closed under
right multiplication in `FullCrossedProduct α μ`. -/
theorem mul_mem_range_fullCrossedProductMap_subtypeHom_right
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    {y : FullCrossedProduct α μ}
    (hy : y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range)
    (a : FullCrossedProduct α μ) :
    y * a ∈ (hI.subtypeHom.fullCrossedProductMap μ).range :=
  StarMemClass.mul_mem_right_of_mul_mem_left
    (hI.mul_mem_range_fullCrossedProductMap_subtypeHom_left μ hmul) a hy

/-- The closed two-sided ideal of `FullCrossedProduct α μ` carried by the embedded crossed product
of a closed invariant two-sided star ideal `I`. -/
def fullCrossedProductStarIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    TwoSidedIdeal (FullCrossedProduct α μ) :=
  TwoSidedIdeal.mk' ((hI.subtypeHom.fullCrossedProductMap μ).range : Set (FullCrossedProduct α μ))
    (zero_mem _)
    (fun hx hy => add_mem hx hy)
    (fun hx => neg_mem hx)
    (fun {x _} hy => hI.mul_mem_range_fullCrossedProductMap_subtypeHom_left μ hmul x hy)
    (fun {_ y} hx => hI.mul_mem_range_fullCrossedProductMap_subtypeHom_right μ hmul hx y)

@[simp]
theorem coe_fullCrossedProductStarIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    (hI.fullCrossedProductStarIdeal μ hmul : Set (FullCrossedProduct α μ)) =
      Set.range (hI.subtypeHom.fullCrossedProductMap μ) :=
  (TwoSidedIdeal.coe_mk' _ _ _ _ _ _).trans (NonUnitalStarAlgHom.coe_range _)

@[simp]
theorem mem_fullCrossedProductStarIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    {x : FullCrossedProduct α μ} :
    x ∈ hI.fullCrossedProductStarIdeal μ hmul ↔
      x ∈ Set.range (hI.subtypeHom.fullCrossedProductMap μ) := by
  rw [← SetLike.mem_coe, coe_fullCrossedProductStarIdeal]

instance isClosed_fullCrossedProductStarIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosed (hI.fullCrossedProductStarIdeal μ hmul : Set (FullCrossedProduct α μ)) := by
  rw [coe_fullCrossedProductStarIdeal]
  exact (hI.isClosedEmbedding_fullCrossedProductMap_subtypeHom μ hmul).isClosed_range

@[simp]
theorem toNonUnitalStarSubalgebra_fullCrossedProductStarIdeal
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    (hI.fullCrossedProductStarIdeal μ hmul).toNonUnitalStarSubalgebra =
      (hI.subtypeHom.fullCrossedProductMap μ).range := by
  ext x
  rw [TwoSidedIdeal.mem_toNonUnitalStarSubalgebra, mem_fullCrossedProductStarIdeal,
    NonUnitalStarAlgHom.mem_range]
  rfl

end StarSubalgebra

section TwoSidedIdeal

variable {G : Type u} {A : Type v} [Group G] [TopologicalSpace G] [NonUnitalCStarAlgebra A]
  {α : CStarAction G A} {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
  (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
  [IsTopologicalGroup G] [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
  (μ : Measure G) [μ.IsHaarMeasure]

/-- Canonical isometric `⋆`-isomorphism between the full crossed products of a closed invariant
two-sided ideal `I` equipped with `hI.restrictIdeal` and with
`hI.toNonUnitalStarSubalgebra.restrict`. -/
def fullCrossedProductRestrictIdealEquiv :
    FullCrossedProduct hI.restrictIdeal μ ≃⋆ₐ[ℂ]
      FullCrossedProduct hI.toNonUnitalStarSubalgebra.restrict μ :=
  StarAlgEquiv.ofNonUnitalStarAlgHom
    (hI.idealToStarSubalgebraHom.fullCrossedProductMap μ)
    (hI.starSubalgebraToIdealHom.fullCrossedProductMap μ)
    (by
      rw [← Hom.fullCrossedProductMap_comp,
        hI.starSubalgebraToIdealHom_comp_idealToStarSubalgebraHom,
        Hom.fullCrossedProductMap_id])
    (by
      rw [← Hom.fullCrossedProductMap_comp,
        hI.idealToStarSubalgebraHom_comp_starSubalgebraToIdealHom,
        Hom.fullCrossedProductMap_id])

@[simp]
theorem toNonUnitalStarAlgHom_fullCrossedProductRestrictIdealEquiv :
    (hI.fullCrossedProductRestrictIdealEquiv μ).toNonUnitalStarAlgHom =
      hI.idealToStarSubalgebraHom.fullCrossedProductMap μ :=
  (rfl)

@[simp]
theorem toNonUnitalStarAlgHom_fullCrossedProductRestrictIdealEquiv_symm :
    (hI.fullCrossedProductRestrictIdealEquiv μ).symm.toNonUnitalStarAlgHom =
      hI.starSubalgebraToIdealHom.fullCrossedProductMap μ :=
  (rfl)

@[simp]
theorem fullCrossedProductRestrictIdealEquiv_apply
    (x : FullCrossedProduct hI.restrictIdeal μ) :
    hI.fullCrossedProductRestrictIdealEquiv μ x =
      hI.idealToStarSubalgebraHom.fullCrossedProductMap μ x :=
  (rfl)

@[simp]
theorem coe_fullCrossedProductRestrictIdealEquiv :
    ⇑(hI.fullCrossedProductRestrictIdealEquiv μ) =
      hI.idealToStarSubalgebraHom.fullCrossedProductMap μ :=
  (rfl)

@[simp]
theorem fullCrossedProductRestrictIdealEquiv_symm_apply
    (x : FullCrossedProduct hI.restrictIdeal μ) :
    (hI.fullCrossedProductRestrictIdealEquiv μ).symm
      (hI.idealToStarSubalgebraHom.fullCrossedProductMap μ x) = x :=
  (hI.fullCrossedProductRestrictIdealEquiv μ).symm_apply_apply x

@[simp]
theorem fullCrossedProductMap_fullCrossedProductRestrictIdealEquiv_symm
    (y : FullCrossedProduct hI.toNonUnitalStarSubalgebra.restrict μ) :
    hI.idealToStarSubalgebraHom.fullCrossedProductMap μ
      ((hI.fullCrossedProductRestrictIdealEquiv μ).symm y) = y :=
  (hI.fullCrossedProductRestrictIdealEquiv μ).apply_symm_apply y

/-- The embedded range of `hI.idealSubtypeHom.fullCrossedProductMap μ` agrees with that of
`hI.toNonUnitalStarSubalgebra.subtypeHom.fullCrossedProductMap μ`. -/
theorem range_fullCrossedProductMap_idealSubtypeHom_eq :
    (hI.idealSubtypeHom.fullCrossedProductMap μ).range =
      (hI.toNonUnitalStarSubalgebra.subtypeHom.fullCrossedProductMap μ).range := by
  rw [hI.idealSubtypeHom_eq_comp, Hom.fullCrossedProductMap_comp]
  ext y
  simp only [NonUnitalStarAlgHom.mem_range, NonUnitalStarAlgHom.comp_apply]
  exact ⟨fun ⟨x, hx⟩ => ⟨_, hx⟩, fun ⟨z, hz⟩ =>
    ⟨(hI.fullCrossedProductRestrictIdealEquiv μ).symm z, by simpa using hz⟩⟩

/-- The induced full crossed-product map from a closed invariant two-sided ideal preserves norms. -/
theorem norm_fullCrossedProductMap_idealSubtypeHom (x : FullCrossedProduct hI.restrictIdeal μ) :
    ‖hI.idealSubtypeHom.fullCrossedProductMap μ x‖ = ‖x‖ := by
  rw [hI.idealSubtypeHom_eq_comp, Hom.fullCrossedProductMap_comp, NonUnitalStarAlgHom.comp_apply,
    hI.toNonUnitalStarSubalgebra.norm_fullCrossedProductMap_subtypeHom μ
      I.mul_mem_toNonUnitalStarSubalgebra_left,
    ← hI.fullCrossedProductRestrictIdealEquiv_apply μ x]
  exact StarAlgEquiv.norm_map _ x

/-- The induced full crossed-product map from a closed invariant two-sided ideal is an isometry. -/
theorem isometry_fullCrossedProductMap_idealSubtypeHom :
    Isometry (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  AddMonoidHomClass.isometry_of_norm _ (hI.norm_fullCrossedProductMap_idealSubtypeHom μ)

/-- The induced full crossed-product map from a closed invariant two-sided ideal is a closed
topological embedding. -/
theorem isClosedEmbedding_fullCrossedProductMap_idealSubtypeHom :
    IsClosedEmbedding (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_idealSubtypeHom μ).isClosedEmbedding

/-- The induced full crossed-product map from a closed invariant two-sided ideal is injective. -/
theorem fullCrossedProductMap_idealSubtypeHom_injective :
    Function.Injective (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_idealSubtypeHom μ).injective

/-- The extended integrated form of `P` vanishes on the embedded full crossed product of `I`
precisely when `P.coefficient` vanishes on `I`. -/
theorem forall_mem_range_fullCrossedProductMap_idealSubtypeHom_integratedFull_eq_zero_iff
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (P : CovariantRepresentation α H) :
    (∀ y ∈ (hI.idealSubtypeHom.fullCrossedProductMap μ).range, P.integratedFull μ y = 0) ↔
      ∀ x ∈ I, P.coefficient x = 0 := by
  rw [P.forall_mem_range_fullCrossedProductMap_integratedFull_eq_zero_iff μ hI.idealSubtypeHom]
  simp only [idealSubtypeHom_apply, Subtype.forall]

/-- The closed two-sided ideal of `FullCrossedProduct α μ` carried by the image of
`FullCrossedProduct hI.restrictIdeal μ` for a closed `α`-invariant two-sided ideal `I`. -/
def fullCrossedProductIdeal : TwoSidedIdeal (FullCrossedProduct α μ) :=
  hI.toNonUnitalStarSubalgebra.fullCrossedProductStarIdeal μ
    I.mul_mem_toNonUnitalStarSubalgebra_left

@[simp]
theorem coe_fullCrossedProductIdeal :
    (hI.fullCrossedProductIdeal μ : Set (FullCrossedProduct α μ)) =
      Set.range (hI.idealSubtypeHom.fullCrossedProductMap μ) := by
  rw [fullCrossedProductIdeal, coe_fullCrossedProductStarIdeal,
    ← NonUnitalStarAlgHom.coe_range, ← NonUnitalStarAlgHom.coe_range,
    hI.range_fullCrossedProductMap_idealSubtypeHom_eq μ]

@[simp]
theorem mem_fullCrossedProductIdeal {x : FullCrossedProduct α μ} :
    x ∈ hI.fullCrossedProductIdeal μ ↔
      x ∈ Set.range (hI.idealSubtypeHom.fullCrossedProductMap μ) := by
  rw [← SetLike.mem_coe, coe_fullCrossedProductIdeal]

instance isClosed_fullCrossedProductIdeal :
    IsClosed (hI.fullCrossedProductIdeal μ : Set (FullCrossedProduct α μ)) :=
  hI.toNonUnitalStarSubalgebra.isClosed_fullCrossedProductStarIdeal μ
    I.mul_mem_toNonUnitalStarSubalgebra_left

@[simp]
theorem toNonUnitalStarSubalgebra_fullCrossedProductIdeal :
    (hI.fullCrossedProductIdeal μ).toNonUnitalStarSubalgebra =
      (hI.idealSubtypeHom.fullCrossedProductMap μ).range := by
  ext x
  rw [TwoSidedIdeal.mem_toNonUnitalStarSubalgebra, mem_fullCrossedProductIdeal,
    NonUnitalStarAlgHom.mem_range]
  rfl

/-- The ideal `hI.fullCrossedProductIdeal μ` equals the topological closure of the two-sided ideal
generated by the compactly supported elements coming from `C_c(G, I)`. -/
theorem fullCrossedProductIdeal_eq_topologicalClosure_span :
    hI.fullCrossedProductIdeal μ =
      (TwoSidedIdeal.span
        (Set.range (of α μ ∘ hI.idealSubtypeHom.convolutionMap μ))).topologicalClosure := by
  refine SetLike.ext' (Set.Subset.antisymm ?_ ?_)
  · rw [coe_fullCrossedProductIdeal, ← NonUnitalStarAlgHom.coe_range,
      hI.range_fullCrossedProductMap_idealSubtypeHom_eq μ,
      hI.toNonUnitalStarSubalgebra.range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure μ
        I.mul_mem_toNonUnitalStarSubalgebra_left,
      NonUnitalStarSubalgebra.topologicalClosure_coe, TwoSidedIdeal.coe_topologicalClosure]
    refine closure_mono ?_
    rintro _ ⟨f, rfl⟩
    refine TwoSidedIdeal.subset_span ⟨hI.starSubalgebraToIdealHom.convolutionMap μ f, ?_⟩
    have hconv : hI.idealSubtypeHom.convolutionMap μ
        (hI.starSubalgebraToIdealHom.convolutionMap μ f) =
        hI.toNonUnitalStarSubalgebra.subtypeHom.convolutionMap μ f := by
      rw [← NonUnitalStarAlgHom.comp_apply, ← Hom.convolutionMap_comp,
        hI.idealSubtypeHom_comp_starSubalgebraToIdealHom]
    exact congrArg (of α μ) hconv
  · rw [TwoSidedIdeal.coe_topologicalClosure]
    refine (hI.isClosed_fullCrossedProductIdeal μ).closure_subset_iff.mpr ?_
    exact SetLike.coe_subset_coe.mpr <| TwoSidedIdeal.span_le.mpr <| by
      rintro _ ⟨f, rfl⟩
      rw [SetLike.mem_coe, mem_fullCrossedProductIdeal]
      exact ⟨of hI.restrictIdeal μ f, hI.idealSubtypeHom.fullCrossedProductMap_of μ f⟩

end TwoSidedIdeal

end IsInvariant

namespace TauCeti.CStarAction

section BoundaryCases

variable {G A : Type*} [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
  [NonUnitalCStarAlgebra A]
  (α : CStarAction G A) (μ : Measure G) [μ.IsHaarMeasure]

/-- At the zero ideal `⊥`, the embedded crossed-product ideal in `FullCrossedProduct α μ` is `⊥`. -/
@[simp]
theorem fullCrossedProductIdeal_bot :
    (IsInvariant.bot_ideal α).fullCrossedProductIdeal μ = ⊥ := by
  ext x
  rw [IsInvariant.mem_fullCrossedProductIdeal, TwoSidedIdeal.mem_bot]
  refine ⟨?_, fun hx => ⟨0, by rw [hx, map_zero]⟩⟩
  rintro ⟨y, rfl⟩
  rw [Subsingleton.elim y 0, map_zero]

/-- At the zero ideal `⊥`, the quotient crossed-product homomorphism
`FullCrossedProduct α μ →⋆ₙₐ[ℂ] FullCrossedProduct (α.quotient ⊥ _) μ` is bijective, without
assuming `T2Space G`. -/
theorem bijective_fullCrossedProductMap_quotientMkHom_bot :
    Function.Bijective ((α.quotientMkHom ⊥ (IsInvariant.bot_ideal α)).fullCrossedProductMap μ) := by
  refine (α.quotientMkHom ⊥ (IsInvariant.bot_ideal α)).bijective_fullCrossedProductMap μ
    ⟨?_, α.quotientMkHom_surjective ⊥ (IsInvariant.bot_ideal α)⟩
  rw [← Hom.coe_toNonUnitalStarAlgHom, ← TwoSidedIdeal.ker_eq_bot]
  exact α.ker_quotientMkHom ⊥ (IsInvariant.bot_ideal α)

/-- At the top ideal `⊤`, the ideal inclusion induces a bijective homomorphism of full crossed
products. -/
theorem bijective_fullCrossedProductMap_idealSubtypeHom_top :
    Function.Bijective (((IsInvariant.top_ideal α).idealSubtypeHom).fullCrossedProductMap μ) :=
  ((IsInvariant.top_ideal α).idealSubtypeHom).bijective_fullCrossedProductMap μ
    ⟨(IsInvariant.top_ideal α).idealSubtypeHom_injective,
      fun a => ⟨⟨a, TwoSidedIdeal.mem_top A⟩,
        (IsInvariant.top_ideal α).idealSubtypeHom_apply ⟨a, TwoSidedIdeal.mem_top A⟩⟩⟩

/-- At the top ideal `⊤`, the embedded crossed-product ideal in `FullCrossedProduct α μ` is `⊤`. -/
@[simp]
theorem fullCrossedProductIdeal_top :
    (IsInvariant.top_ideal α).fullCrossedProductIdeal μ = ⊤ := by
  ext x
  simp only [IsInvariant.mem_fullCrossedProductIdeal, TwoSidedIdeal.mem_top, iff_true]
  exact (bijective_fullCrossedProductMap_idealSubtypeHom_top α μ).surjective x

end BoundaryCases

end TauCeti.CStarAction
