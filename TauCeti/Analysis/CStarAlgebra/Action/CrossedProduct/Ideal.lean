public import TauCeti.Analysis.CStarAlgebra.Action.Covariant.Ideal
public import TauCeti.Analysis.CStarAlgebra.Action.CrossedProduct.Functoriality
import TauCeti.Topology.Algebra.NonUnitalStarAlgebra

/-!
# Embedding full crossed products of closed invariant ideals

Let `α` be a point-norm continuous action of a locally compact group `G` on a C⋆-algebra `A`, and
let `I` be a closed `α`-invariant nonunital star subalgebra of `A` equipped with the restricted
action `hI.restrict` and equivariant inclusion `hI.subtypeHom`.

At the compact-support twisted convolution level:
* `hI.subtypeHom.convolutionMap μ` is injective and its range consists of those compactly
  supported functions taking all values in `I`;
* when `I` is a left (hence two-sided) star ideal of `A`, that range absorbs twisted convolution
  on both the left and the right.

At the full crossed-product level, when `I` is a closed `α`-invariant two-sided star ideal:
* `hI.subtypeHom.fullCrossedProductMap μ` is an isometric closed embedding of
  `FullCrossedProduct hI.restrict μ` into `FullCrossedProduct α μ`;
* its range is a closed two-sided star ideal of `FullCrossedProduct α μ`, equal to the
  topological closure of the image of `C_c(G, I)`;
* for any closed `α`-invariant star subalgebra `I`, the extended integrated form of a covariant
  representation `P` of `α` vanishes on `(hI.subtypeHom.fullCrossedProductMap μ).range` precisely
  when `P.coefficient` vanishes on `I`.

These results supply the ideal-embedding half of the full crossed-product short exact sequence
associated to an invariant ideal. No unitality, separability, or global σ-finiteness is assumed.

## Main statements

* `IsInvariant.mem_range_convolutionMap_subtypeHom_iff`: pointwise characterization of the image
  of `C_c(G, I)` inside `ConvolutionAlgebra α μ`.
* `IsInvariant.mul_mem_range_convolutionMap_subtypeHom_left` and
  `IsInvariant.mul_mem_range_convolutionMap_subtypeHom_right`: two-sided ideal absorption in the
  compact-support twisted convolution algebra.
* `IsInvariant.isometry_fullCrossedProductMap_subtypeHom` and
  `IsInvariant.isClosedEmbedding_fullCrossedProductMap_subtypeHom`: isometric closed embedding of
  the ideal crossed product into the ambient full crossed product.
* `IsInvariant.range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure`: identification of
  that embedded range with the closed star subalgebra generated by `C_c(G, I)`.
* `IsInvariant.mul_mem_range_fullCrossedProductMap_subtypeHom_left` and
  `IsInvariant.mul_mem_range_fullCrossedProductMap_subtypeHom_right`: two-sided ideal absorption
  in `FullCrossedProduct α μ`.
* `IsInvariant.forall_mem_range_fullCrossedProductMap_subtypeHom_integratedFull_eq_zero_iff`:
  characterization of covariant representations annihilating the embedded crossed product.

## References

* Dana Williams, *Crossed Products of C*-Algebras*, Proposition 3.19.
-/

public section

noncomputable section

open MeasureTheory Topology TauCeti
open scoped CompactlySupported CStarAlgebra

namespace IsInvariant

section Convolution

variable {G A : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [OpensMeasurableSpace G]
  [NonUnitalCStarAlgebra A] {α : CStarAction G A}
  {I : NonUnitalStarSubalgebra ℂ A} [IsClosed (I : Set A)]
  (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
  (μ : Measure G) [IsFiniteMeasureOnCompacts μ]

/-- The induced map of compact-support twisted convolution algebras from a closed invariant star
subalgebra is injective. -/
theorem convolutionMap_subtypeHom_injective :
    Function.Injective (hI.subtypeHom.convolutionMap μ) :=
  hI.subtypeHom.convolutionMap_injective fun _ _ h => Subtype.ext (by simpa using h)

/-- An element of `ConvolutionAlgebra α μ` lies in the range of `hI.subtypeHom.convolutionMap μ`
precisely when its underlying function takes every value in `I`. -/
theorem mem_range_convolutionMap_subtypeHom_iff {f : CStarAction.ConvolutionAlgebra α μ} :
    f ∈ (hI.subtypeHom.convolutionMap μ).range ↔ ∀ s : G, f.ofConv s ∈ I := by
  rw [(hI.subtypeHom.convolutionMap μ).mem_range]
  refine ⟨?_, fun hf => ?_⟩
  · rintro ⟨g, rfl⟩ s
    simpa only [CStarAction.Hom.convolutionMap_apply, subtypeHom_apply] using (g.ofConv s).2
  · have hsupp : HasCompactSupport (fun s : G => (⟨f.ofConv s, hf s⟩ : I)) := by
      have hEq : Function.support (fun s : G => (⟨f.ofConv s, hf s⟩ : I)) =
          Function.support f.ofConv := by
        ext s
        simp [Subtype.ext_iff]
      simpa only [HasCompactSupport, tsupport, hEq] using f.ofConv.hasCompactSupport
    let g : CStarAction.ConvolutionAlgebra hI.restrict μ :=
      .toConv ⟨⟨fun s => ⟨f.ofConv s, hf s⟩, (map_continuous f.ofConv).subtype_mk hf⟩, hsupp⟩
    refine ⟨g, CStarAction.ConvolutionAlgebra.ext ?_⟩
    ext s
    simp [g]

/-- When `I` is a closed invariant two-sided star ideal of `A`, the range of
`hI.subtypeHom.convolutionMap μ` absorbs left twisted convolution by arbitrary elements of
`ConvolutionAlgebra α μ`. -/
theorem mul_mem_range_convolutionMap_subtypeHom_left (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    (f : CStarAction.ConvolutionAlgebra α μ) {g : CStarAction.ConvolutionAlgebra α μ}
    (hg : g ∈ (hI.subtypeHom.convolutionMap μ).range) :
    f * g ∈ (hI.subtypeHom.convolutionMap μ).range := by
  have hg' := (hI.mem_range_convolutionMap_subtypeHom_iff μ).1 hg
  refine (hI.mem_range_convolutionMap_subtypeHom_iff μ).2 fun s => ?_
  let φ : G → I := fun r =>
    ⟨f.ofConv r * α r (g.ofConv (r⁻¹ * s)),
      hmul (f.ofConv r) _ (hI.apply_mem r (hg' (r⁻¹ * s)))⟩
  have hint : (∫ r, (φ r : A) ∂μ) = ((∫ r, φ r ∂μ : I) : A) :=
    I.toSubmodule.subtypeₗᵢ.integral_comp_comm φ
  simpa only [CStarAction.ConvolutionAlgebra.ofConv_mul, CStarAction.convolution_apply, φ] using
    hint ▸ (∫ r, φ r ∂μ).2

/-- When `I` is a closed invariant two-sided star ideal of `A`, the range of
`hI.subtypeHom.convolutionMap μ` absorbs right twisted convolution by arbitrary elements of
`ConvolutionAlgebra α μ`. -/
theorem mul_mem_range_convolutionMap_subtypeHom_right (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    {f : CStarAction.ConvolutionAlgebra α μ}
    (hf : f ∈ (hI.subtypeHom.convolutionMap μ).range)
    (g : CStarAction.ConvolutionAlgebra α μ) :
    f * g ∈ (hI.subtypeHom.convolutionMap μ).range := by
  have hf' := (hI.mem_range_convolutionMap_subtypeHom_iff μ).1 hf
  refine (hI.mem_range_convolutionMap_subtypeHom_iff μ).2 fun s => ?_
  let φ : G → I := fun r =>
    ⟨f.ofConv r * α r (g.ofConv (r⁻¹ * s)),
      StarMemClass.mul_mem_right_of_mul_mem_left hmul (α r (g.ofConv (r⁻¹ * s))) (hf' r)⟩
  have hint : (∫ r, (φ r : A) ∂μ) = ((∫ r, φ r ∂μ : I) : A) :=
    I.toSubmodule.subtypeₗᵢ.integral_comp_comm φ
  simpa only [CStarAction.ConvolutionAlgebra.ofConv_mul, CStarAction.convolution_apply, φ] using
    hint ▸ (∫ r, φ r ∂μ).2

end Convolution

section FullCrossedProduct

universe u v

variable {G : Type u} {A : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G] [NonUnitalCStarAlgebra A]
  {α : CStarAction G A} {I : NonUnitalStarSubalgebra ℂ A} [IsClosed (I : Set A)]
  (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
  (μ : Measure G) [μ.IsHaarMeasure]

open CStarAction CStarAction.FullCrossedProduct

/-- Every compactly supported function in `C_c(G, I)` maps into the range of
`hI.subtypeHom.fullCrossedProductMap μ` inside `FullCrossedProduct α μ`. -/
theorem of_convolutionMap_mem_range_fullCrossedProductMap_subtypeHom
    (f : ConvolutionAlgebra hI.restrict μ) :
    of α μ (hI.subtypeHom.convolutionMap μ f) ∈
      (hI.subtypeHom.fullCrossedProductMap μ).range :=
  (hI.subtypeHom.fullCrossedProductMap μ).mem_range.2
    ⟨of hI.restrict μ f, hI.subtypeHom.fullCrossedProductMap_of μ f⟩

/-- Any compactly supported function on `G` taking values in `I` maps under `FullCrossedProduct.of`
into the range of `hI.subtypeHom.fullCrossedProductMap μ`. -/
theorem of_mem_range_fullCrossedProductMap_subtypeHom_of_forall_mem
    {f : ConvolutionAlgebra α μ} (hf : ∀ s : G, f.ofConv s ∈ I) :
    of α μ f ∈ (hI.subtypeHom.fullCrossedProductMap μ).range := by
  obtain ⟨g, rfl⟩ := (hI.subtypeHom.convolutionMap μ).mem_range.1 <|
    (hI.mem_range_convolutionMap_subtypeHom_iff μ).2 hf
  exact hI.of_convolutionMap_mem_range_fullCrossedProductMap_subtypeHom μ g

/-- The extended integrated form of a covariant representation `P` of `α` vanishes on the range of
`hI.subtypeHom.fullCrossedProductMap μ` precisely when `P.coefficient` vanishes on `I`. -/
theorem forall_mem_range_fullCrossedProductMap_subtypeHom_integratedFull_eq_zero_iff
    {H : Type (max u v)} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (P : CovariantRepresentation α H) :
    (∀ y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range, P.integratedFull μ y = 0) ↔
      ∀ x ∈ I, P.coefficient x = 0 := by
  rw [P.forall_mem_range_fullCrossedProductMap_integratedFull_eq_zero_iff μ hI.subtypeHom]
  simp only [subtypeHom_apply, Subtype.forall]

/-- The induced full crossed-product map from a closed invariant two-sided star ideal preserves
norms identically. -/
theorem norm_fullCrossedProductMap_subtypeHom (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    (x : FullCrossedProduct hI.restrict μ) :
    ‖hI.subtypeHom.fullCrossedProductMap μ x‖ = ‖x‖ := by
  induction x using FullCrossedProduct.induction_on with
  | hp =>
    exact isClosed_eq
      (continuous_norm.comp (map_continuous (hI.subtypeHom.fullCrossedProductMap μ)))
      continuous_norm
  | ih f =>
    rw [Hom.fullCrossedProductMap_of, norm_of, norm_of,
      ConvolutionAlgebra.fullSeminorm_convolutionMap_subtypeHom hI μ hmul f]

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is an
isometry. -/
theorem isometry_fullCrossedProductMap_subtypeHom (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    Isometry (hI.subtypeHom.fullCrossedProductMap μ) :=
  AddMonoidHomClass.isometry_of_norm _ (hI.norm_fullCrossedProductMap_subtypeHom μ hmul)

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is a closed
topological embedding. -/
theorem isClosedEmbedding_fullCrossedProductMap_subtypeHom
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosedEmbedding (hI.subtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_subtypeHom μ hmul).isClosedEmbedding

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is
injective. -/
theorem fullCrossedProductMap_subtypeHom_injective (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    Function.Injective (hI.subtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_subtypeHom μ hmul).injective

/-- The range of `hI.subtypeHom.fullCrossedProductMap μ` is closed in `FullCrossedProduct α μ`. -/
theorem isClosed_range_fullCrossedProductMap_subtypeHom
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosed ((hI.subtypeHom.fullCrossedProductMap μ).range : Set (FullCrossedProduct α μ)) := by
  rw [NonUnitalStarAlgHom.coe_range]
  exact (hI.isClosedEmbedding_fullCrossedProductMap_subtypeHom μ hmul).isClosed_range

/-- For a closed invariant two-sided star ideal `I`, the range of
`hI.subtypeHom.fullCrossedProductMap μ` equals the topological closure of the image of `C_c(G, I)`
inside `FullCrossedProduct α μ`. -/
theorem range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    (hI.subtypeHom.fullCrossedProductMap μ).range =
      ((of α μ).comp (hI.subtypeHom.convolutionMap μ)).range.topologicalClosure := by
  refine le_antisymm (hI.subtypeHom.range_fullCrossedProductMap_le_topologicalClosure μ) ?_
  refine NonUnitalStarSubalgebra.topologicalClosure_minimal _ ?_
    (hI.isClosed_range_fullCrossedProductMap_subtypeHom μ hmul)
  rw [← hI.subtypeHom.fullCrossedProductMap_comp_of μ]
  exact NonUnitalStarAlgHom.range_comp_le_range _ _

/-- The embedded full crossed product of a closed invariant two-sided star ideal is closed under
left multiplication in `FullCrossedProduct α μ`. -/
theorem mul_mem_range_fullCrossedProductMap_subtypeHom_left
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    (a : FullCrossedProduct α μ) {y : FullCrossedProduct α μ}
    (hy : y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range) :
    a * y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range := by
  rw [hI.range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure μ hmul] at hy ⊢
  refine NonUnitalStarSubalgebra.mul_mem_topologicalClosure_of_dense _
    (denseRange_of (α := α) (μ := μ)) ?_ a hy
  rintro _ ⟨f, rfl⟩ z hz
  obtain ⟨g, rfl⟩ := ((of α μ).comp (hI.subtypeHom.convolutionMap μ)).mem_range.1 hz
  simp only [NonUnitalStarAlgHom.comp_apply, ← map_mul]
  obtain ⟨k, hk⟩ := (hI.subtypeHom.convolutionMap μ).mem_range.1 <|
    hI.mul_mem_range_convolutionMap_subtypeHom_left μ hmul f
      ((hI.subtypeHom.convolutionMap μ).mem_range.2 ⟨g, rfl⟩)
  exact NonUnitalStarSubalgebra.le_topologicalClosure _
    (((of α μ).comp (hI.subtypeHom.convolutionMap μ)).mem_range.2
      ⟨k, by rw [NonUnitalStarAlgHom.comp_apply, hk]⟩)

/-- The embedded full crossed product of a closed invariant two-sided star ideal is closed under
right multiplication in `FullCrossedProduct α μ`. -/
theorem mul_mem_range_fullCrossedProductMap_subtypeHom_right
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    {y : FullCrossedProduct α μ}
    (hy : y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range)
    (a : FullCrossedProduct α μ) :
    y * a ∈ (hI.subtypeHom.fullCrossedProductMap μ).range :=
  StarMemClass.mul_mem_right_of_mul_mem_left
    (hI.mul_mem_range_fullCrossedProductMap_subtypeHom_left μ hmul) a hy

end FullCrossedProduct

end IsInvariant
