/-!
# Embedding full crossed products of closed invariant ideals

Let `α` be a point-norm continuous action of a locally compact group `G` on a C⋆-algebra `A`, and
let `I` be a closed `α`-invariant nonunital star subalgebra of `A` equipped with the restricted
action `hI.restrict` and equivariant inclusion `hI.subtypeHom`.

When `I` is a closed `α`-invariant two-sided star ideal of `A` (or more generally when
`φ : CStarAction.Hom γ α` is injective and `Set.range φ` is a left ideal of `A`):
* `hI.subtypeHom.fullCrossedProductMap μ`, `φ.fullCrossedProductMap μ`, and
  `hI.idealSubtypeHom.fullCrossedProductMap μ` are isometric closed embeddings into
  `FullCrossedProduct α μ`;
* the embedded range forms a closed two-sided ideal `hI.fullCrossedProductIdeal μ hmul` (and
  `hI.idealFullCrossedProductIdeal μ` for `I : TwoSidedIdeal A`) of `FullCrossedProduct α μ`,
  equal to the closed two-sided ideal generated by the compactly supported functions `C_c(G, I)`;
* for any equivariant homomorphism `φ : CStarAction.Hom γ α`, the `⋆`-subalgebra range of
  `φ.fullCrossedProductMap μ` agrees with that of `(IsInvariant.range φ).subtypeHom`;
* for any closed `α`-invariant star subalgebra `I`, the extended integrated form of a covariant
  representation `P` of `α` on a Hilbert space in any universe vanishes on
  `(hI.subtypeHom.fullCrossedProductMap μ).range` precisely when `P.coefficient` vanishes on `I`.

These results combine the compact-support ideal absorption in
`TauCeti.Analysis.CStarAlgebra.Action.Convolution.Ideal` with the covariant representation
extensions in `TauCeti.Analysis.CStarAlgebra.Action.Covariant.Ideal` to supply the ideal-embedding
half of the full crossed-product short exact sequence associated to an invariant ideal. No
unitality, separability, Hausdorff assumption on `G`, or global σ-finiteness is assumed.

## Main statements

* `IsInvariant.isometry_fullCrossedProductMap_subtypeHom`,
  `TauCeti.CStarAction.Hom.isometry_fullCrossedProductMap_of_injective`, and
  `IsInvariant.isometry_fullCrossedProductMap_idealSubtypeHom`: isometric closed embeddings of ideal
  full crossed products into `FullCrossedProduct α μ`.
* `TauCeti.CStarAction.Hom.range_fullCrossedProductMap`: range of `φ.fullCrossedProductMap μ` for
  arbitrary `φ : CStarAction.Hom γ α`.
* `IsInvariant.fullCrossedProductIdeal` and `IsInvariant.idealFullCrossedProductIdeal`: the embedded
  full crossed product bundled as a closed `TwoSidedIdeal (FullCrossedProduct α μ)`, together with
  `isClosed_fullCrossedProductIdeal`, `fullCrossedProductIdeal_eq_topologicalClosure_span`,
  `fullCrossedProductIdeal_le_iff`, `idealFullCrossedProductIdeal_eq_topologicalClosure_span`, and
  `idealFullCrossedProductIdeal_le_iff`.
* `IsInvariant.mul_mem_range_fullCrossedProductMap_subtypeHom_left` and
  `IsInvariant.mul_mem_range_fullCrossedProductMap_subtypeHom_right`: two-sided ideal absorption
  in `FullCrossedProduct α μ`.
* `IsInvariant.forall_mem_range_fullCrossedProductMap_subtypeHom_integratedFull_eq_zero_iff`:
  characterization of covariant representations annihilating the embedded crossed product.

## References

* Dana Williams, *Crossed Products of C*-Algebras*, Proposition 3.19.
-/

public section

noncomputable section

open MeasureTheory Topology TauCeti CStarAction CStarAction.FullCrossedProduct
open scoped CStarAlgebra

namespace IsInvariant

universe u v

section StarSubalgebra

variable {G : Type u} {A : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G] [NonUnitalCStarAlgebra A]
  {α : CStarAction G A} {I : NonUnitalStarSubalgebra ℂ A} [IsClosed (I : Set A)]
  (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
  (μ : Measure G) [μ.IsHaarMeasure]

/-- Every compactly supported function in `C_c(G, I)` maps into the range of
`hI.subtypeHom.fullCrossedProductMap μ` inside `FullCrossedProduct α μ`. -/
theorem of_convolutionMap_mem_range_fullCrossedProductMap_subtypeHom
    (f : ConvolutionAlgebra hI.restrict μ) :
    of α μ (hI.subtypeHom.convolutionMap μ f) ∈
      (hI.subtypeHom.fullCrossedProductMap μ).range :=
  (hI.subtypeHom.fullCrossedProductMap μ).mem_range.mpr
    ⟨of hI.restrict μ f, hI.subtypeHom.fullCrossedProductMap_of μ f⟩

/-- Any compactly supported function on `G` taking values in `I` maps under `FullCrossedProduct.of`
into the range of `hI.subtypeHom.fullCrossedProductMap μ`. -/
theorem of_mem_range_fullCrossedProductMap_subtypeHom_of_forall_mem
    {f : ConvolutionAlgebra α μ} (hf : ∀ s : G, f.ofConv s ∈ I) :
    of α μ f ∈ (hI.subtypeHom.fullCrossedProductMap μ).range := by
  obtain ⟨g, rfl⟩ := (hI.subtypeHom.convolutionMap μ).mem_range.mp <|
    (hI.mem_range_convolutionMap_subtypeHom_iff μ).mpr hf
  exact hI.of_convolutionMap_mem_range_fullCrossedProductMap_subtypeHom μ g

/-- The extended integrated form of a covariant representation `P` of `α` vanishes on the range of
`hI.subtypeHom.fullCrossedProductMap μ` precisely when `P.coefficient` vanishes on `I`. -/
theorem forall_mem_range_fullCrossedProductMap_subtypeHom_integratedFull_eq_zero_iff
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (P : CovariantRepresentation α H) :
    (∀ y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range, P.integratedFull μ y = 0) ↔
      ∀ x ∈ I, P.coefficient x = 0 := by
  rw [P.forall_mem_range_fullCrossedProductMap_integratedFull_eq_zero_iff μ hI.subtypeHom]
  simp only [subtypeHom_apply, Subtype.forall]

/-- The induced full crossed-product map from a closed invariant two-sided star ideal preserves
norms identically. -/
theorem norm_fullCrossedProductMap_subtypeHom (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    (x : FullCrossedProduct hI.restrict μ) :
    ‖hI.subtypeHom.fullCrossedProductMap μ x‖ = ‖x‖ := by
  induction x using FullCrossedProduct.induction_on with
  | hp =>
    exact isClosed_eq
      (continuous_norm.comp (map_continuous (hI.subtypeHom.fullCrossedProductMap μ)))
      continuous_norm
  | ih f =>
    rw [Hom.fullCrossedProductMap_of, norm_of, norm_of,
      hI.fullSeminorm_convolutionMap_subtypeHom μ hmul f]

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is an
isometry. -/
theorem isometry_fullCrossedProductMap_subtypeHom (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    Isometry (hI.subtypeHom.fullCrossedProductMap μ) :=
  AddMonoidHomClass.isometry_of_norm _ (hI.norm_fullCrossedProductMap_subtypeHom μ hmul)

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is a closed
topological embedding. -/
theorem isClosedEmbedding_fullCrossedProductMap_subtypeHom
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosedEmbedding (hI.subtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_subtypeHom μ hmul).isClosedEmbedding

/-- The induced full crossed-product map from a closed invariant two-sided star ideal is
injective. -/
theorem fullCrossedProductMap_subtypeHom_injective (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    Function.Injective (hI.subtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_subtypeHom μ hmul).injective

/-- The range of `hI.subtypeHom.fullCrossedProductMap μ` is closed in `FullCrossedProduct α μ`. -/
theorem isClosed_range_fullCrossedProductMap_subtypeHom
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosed ((hI.subtypeHom.fullCrossedProductMap μ).range : Set (FullCrossedProduct α μ)) := by
  rw [NonUnitalStarAlgHom.coe_range]
  exact (hI.isClosedEmbedding_fullCrossedProductMap_subtypeHom μ hmul).isClosed_range

/-- For a closed invariant two-sided star ideal `I`, the range of
`hI.subtypeHom.fullCrossedProductMap μ` equals the topological closure of the image of `C_c(G, I)`
inside `FullCrossedProduct α μ`. -/
theorem range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    (hI.subtypeHom.fullCrossedProductMap μ).range =
      ((of α μ).comp (hI.subtypeHom.convolutionMap μ)).range.topologicalClosure := by
  refine le_antisymm (hI.subtypeHom.range_fullCrossedProductMap_le_topologicalClosure μ) ?_
  refine NonUnitalStarSubalgebra.topologicalClosure_minimal _ ?_
    (hI.isClosed_range_fullCrossedProductMap_subtypeHom μ hmul)
  rw [← hI.subtypeHom.fullCrossedProductMap_comp_of μ]
  exact NonUnitalStarAlgHom.range_comp_le_range _ _

/-- The embedded full crossed product of a closed invariant two-sided star ideal is closed under
left multiplication in `FullCrossedProduct α μ`. -/
theorem mul_mem_range_fullCrossedProductMap_subtypeHom_left
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    (a : FullCrossedProduct α μ) {y : FullCrossedProduct α μ}
    (hy : y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range) :
    a * y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range := by
  rw [hI.range_fullCrossedProductMap_subtypeHom_eq_topologicalClosure μ hmul,
    ← SetLike.mem_coe, NonUnitalStarSubalgebra.topologicalClosure_coe] at hy ⊢
  refine map_mem_closure₂ continuous_mul (denseRange_of (α := α) (μ := μ) a) hy ?_
  rintro _ ⟨f, rfl⟩ z hz
  obtain ⟨g, rfl⟩ := ((of α μ).comp (hI.subtypeHom.convolutionMap μ)).mem_range.mp hz
  simp only [NonUnitalStarAlgHom.comp_apply, ← map_mul]
  obtain ⟨k, hk⟩ := (hI.subtypeHom.convolutionMap μ).mem_range.mp <|
    hI.mul_mem_range_convolutionMap_subtypeHom_left μ hmul f
      ((hI.subtypeHom.convolutionMap μ).mem_range.mpr ⟨g, rfl⟩)
  exact ((of α μ).comp (hI.subtypeHom.convolutionMap μ)).mem_range.mpr
    ⟨k, by rw [NonUnitalStarAlgHom.comp_apply, hk]⟩

/-- The embedded full crossed product of a closed invariant two-sided star ideal is closed under
right multiplication in `FullCrossedProduct α μ`. -/
theorem mul_mem_range_fullCrossedProductMap_subtypeHom_right
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    {y : FullCrossedProduct α μ}
    (hy : y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range)
    (a : FullCrossedProduct α μ) :
    y * a ∈ (hI.subtypeHom.fullCrossedProductMap μ).range :=
  StarMemClass.mul_mem_right_of_mul_mem_left
    (hI.mul_mem_range_fullCrossedProductMap_subtypeHom_left μ hmul) a hy

/-- For a closed invariant two-sided star ideal `I`, the range of
`hI.subtypeHom.fullCrossedProductMap μ` as a two-sided ideal of `FullCrossedProduct α μ`. -/
def fullCrossedProductIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    TwoSidedIdeal (FullCrossedProduct α μ) :=
  .mk' (hI.subtypeHom.fullCrossedProductMap μ).range (zero_mem _) (add_mem · ·) (neg_mem ·)
    (fun hy => hI.mul_mem_range_fullCrossedProductMap_subtypeHom_left μ hmul _ hy)
    (fun hy => hI.mul_mem_range_fullCrossedProductMap_subtypeHom_right μ hmul hy _)

@[simp]
theorem coe_fullCrossedProductIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    (hI.fullCrossedProductIdeal μ hmul : Set (FullCrossedProduct α μ)) =
      Set.range (hI.subtypeHom.fullCrossedProductMap μ) := by
  simp [fullCrossedProductIdeal]

/-- Membership in `hI.fullCrossedProductIdeal μ hmul` is membership in the range of
`hI.subtypeHom.fullCrossedProductMap μ`. -/
@[simp]
theorem mem_fullCrossedProductIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    {y : FullCrossedProduct α μ} :
    y ∈ hI.fullCrossedProductIdeal μ hmul ↔ y ∈ (hI.subtypeHom.fullCrossedProductMap μ).range :=
  TwoSidedIdeal.mem_mk' _ _ _ _ _ _ y

/-- The ideal `hI.fullCrossedProductIdeal μ hmul` is closed in `FullCrossedProduct α μ`. -/
theorem isClosed_fullCrossedProductIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosed (hI.fullCrossedProductIdeal μ hmul : Set (FullCrossedProduct α μ)) := by
  rw [fullCrossedProductIdeal, TwoSidedIdeal.coe_mk']
  exact hI.isClosed_range_fullCrossedProductMap_subtypeHom μ hmul

/-- The closedness of `hI.fullCrossedProductIdeal μ hmul` as an instance, so that the quotient of
`FullCrossedProduct α μ` by it is a C⋆-algebra. -/
instance (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    IsClosed (hI.fullCrossedProductIdeal μ hmul : Set (FullCrossedProduct α μ)) :=
  hI.isClosed_fullCrossedProductIdeal μ hmul

@[simp]
theorem toNonUnitalStarSubalgebra_fullCrossedProductIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    (hI.fullCrossedProductIdeal μ hmul).toNonUnitalStarSubalgebra =
      (hI.subtypeHom.fullCrossedProductMap μ).range := by
  ext x
  simp

/-- Every compactly supported generator in `C_c(G, I)` belongs to
`hI.fullCrossedProductIdeal μ hmul`. -/
theorem of_convolutionMap_mem_fullCrossedProductIdeal (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    (f : ConvolutionAlgebra hI.restrict μ) :
    of α μ (hI.subtypeHom.convolutionMap μ f) ∈ hI.fullCrossedProductIdeal μ hmul :=
  (hI.mem_fullCrossedProductIdeal μ hmul).mpr <|
    (hI.subtypeHom.fullCrossedProductMap μ).mem_range.mpr
      ⟨of hI.restrict μ f, hI.subtypeHom.fullCrossedProductMap_of μ f⟩

/-- A closed two-sided ideal `J` of `FullCrossedProduct α μ` contains
`hI.fullCrossedProductIdeal μ hmul` precisely when it contains the image of `C_c(G, I)`. -/
theorem fullCrossedProductIdeal_le_iff (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I)
    {J : TwoSidedIdeal (FullCrossedProduct α μ)} [IsClosed (J : Set (FullCrossedProduct α μ))] :
    hI.fullCrossedProductIdeal μ hmul ≤ J ↔
      ∀ f : ConvolutionAlgebra hI.restrict μ,
        of α μ (hI.subtypeHom.convolutionMap μ f) ∈ J := by
  have hle : hI.fullCrossedProductIdeal μ hmul ≤ J ↔
      (hI.subtypeHom.fullCrossedProductMap μ).range ≤ J.toNonUnitalStarSubalgebra := by
    simp [← SetLike.coe_subset_coe]
  rw [hle, hI.subtypeHom.range_fullCrossedProductMap_le_iff μ J.isClosed_toNonUnitalStarSubalgebra]
  simp only [J.mem_toNonUnitalStarSubalgebra]

/-- `hI.fullCrossedProductIdeal μ hmul` equals the topological closure of the two-sided ideal
generated by the compactly supported elements coming from `C_c(G, I)`. -/
theorem fullCrossedProductIdeal_eq_topologicalClosure_span
    (hmul : ∀ a : A, ∀ x ∈ I, a * x ∈ I) :
    hI.fullCrossedProductIdeal μ hmul =
      (TwoSidedIdeal.span
        (Set.range ((of α μ).comp (hI.subtypeHom.convolutionMap μ)))).topologicalClosure := by
  let S := Set.range ((of α μ).comp (hI.subtypeHom.convolutionMap μ))
  have : IsClosed ((TwoSidedIdeal.span S).topologicalClosure : Set (FullCrossedProduct α μ)) :=
    TwoSidedIdeal.isClosed_topologicalClosure _
  refine le_antisymm
    ((hI.fullCrossedProductIdeal_le_iff μ hmul).mpr fun f =>
      TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span ⟨f, rfl⟩))
    ((TwoSidedIdeal.topologicalClosure_le_iff _ _
      (hI.isClosed_fullCrossedProductIdeal μ hmul)).mpr ?_)
  rw [TwoSidedIdeal.span_le]
  rintro _ ⟨f, rfl⟩
  exact hI.of_convolutionMap_mem_fullCrossedProductIdeal μ hmul f

end StarSubalgebra

end IsInvariant

namespace TauCeti.CStarAction.Hom

universe u v

variable {G : Type u} {A D : Type v} [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra D]
  {α : CStarAction G A} {γ : CStarAction G D}
  (μ : Measure G) [μ.IsHaarMeasure]

/-- For any equivariant homomorphism `φ : Hom γ α`, the `⋆`-subalgebra range of
`φ.fullCrossedProductMap μ` agrees with that of `(IsInvariant.range φ).subtypeHom`. -/
theorem range_fullCrossedProductMap (φ : Hom γ α) :
    (φ.fullCrossedProductMap μ).range =
      ((IsInvariant.range φ).subtypeHom.fullCrossedProductMap μ).range := by
  have hsurj : Function.Surjective (φ.rangeRestrict.fullCrossedProductMap μ) :=
    φ.rangeRestrict.surjective_fullCrossedProductMap μ φ.rangeRestrict_surjective.denseRange
  have hcomp : φ.fullCrossedProductMap μ =
      ((IsInvariant.range φ).subtypeHom.fullCrossedProductMap μ).comp
        (φ.rangeRestrict.fullCrossedProductMap μ) := by
    rw [← fullCrossedProductMap_comp, φ.subtypeHom_comp_rangeRestrict]
  apply SetLike.coe_injective
  rw [NonUnitalStarAlgHom.coe_range, NonUnitalStarAlgHom.coe_range, hcomp,
    NonUnitalStarAlgHom.coe_comp, Set.range_comp, hsurj.range_eq, Set.image_univ]

/-- An injective equivariant homomorphism `φ : Hom γ α` whose range is a left ideal of `A` induces
a norm-preserving homomorphism on full crossed products. -/
theorem norm_fullCrossedProductMap_of_injective (φ : Hom γ α) (hφ : Function.Injective φ)
    (hmul : ∀ (a : A) (d : D), a * φ d ∈ Set.range φ) (z : FullCrossedProduct γ μ) :
    ‖φ.fullCrossedProductMap μ z‖ = ‖z‖ := by
  have hinj : Function.Injective (φ.rangeRestrict.fullCrossedProductMap μ) :=
    Function.LeftInverse.injective fun y => by
      calc (φ.rangeRestrictInv hφ).fullCrossedProductMap μ
            (φ.rangeRestrict.fullCrossedProductMap μ y)
          = (((φ.rangeRestrictInv hφ).comp φ.rangeRestrict).fullCrossedProductMap μ) y := by
            rw [fullCrossedProductMap_comp, NonUnitalStarAlgHom.comp_apply]
        _ = y := by simp [φ.rangeRestrictInv_comp_rangeRestrict hφ]
  have hmul' : ∀ (a : A), ∀ x ∈ φ.toNonUnitalStarAlgHom.range,
      a * x ∈ φ.toNonUnitalStarAlgHom.range := by
    intro a x hx
    obtain ⟨d, rfl⟩ := (NonUnitalStarAlgHom.mem_range _).mp hx
    obtain ⟨c, hc⟩ := hmul a d
    exact (NonUnitalStarAlgHom.mem_range _).mpr ⟨c, hc⟩
  have hcomp : φ.fullCrossedProductMap μ =
      ((IsInvariant.range φ).subtypeHom.fullCrossedProductMap μ).comp
        (φ.rangeRestrict.fullCrossedProductMap μ) := by
    rw [← fullCrossedProductMap_comp, φ.subtypeHom_comp_rangeRestrict]
  rw [hcomp, NonUnitalStarAlgHom.comp_apply,
    (IsInvariant.range φ).norm_fullCrossedProductMap_subtypeHom μ hmul',
    NonUnitalStarAlgHom.norm_map _ hinj]

/-- An injective equivariant homomorphism whose range is a left ideal of `A` induces an isometry
on full crossed products. -/
theorem isometry_fullCrossedProductMap_of_injective (φ : Hom γ α) (hφ : Function.Injective φ)
    (hmul : ∀ (a : A) (d : D), a * φ d ∈ Set.range φ) :
    Isometry (φ.fullCrossedProductMap μ) :=
  AddMonoidHomClass.isometry_of_norm _ (φ.norm_fullCrossedProductMap_of_injective μ hφ hmul)

/-- An injective equivariant homomorphism whose range is a left ideal of `A` induces a closed
topological embedding on full crossed products. -/
theorem isClosedEmbedding_fullCrossedProductMap_of_injective (φ : Hom γ α)
    (hφ : Function.Injective φ) (hmul : ∀ (a : A) (d : D), a * φ d ∈ Set.range φ) :
    IsClosedEmbedding (φ.fullCrossedProductMap μ) :=
  (φ.isometry_fullCrossedProductMap_of_injective μ hφ hmul).isClosedEmbedding

/-- An injective equivariant homomorphism whose range is a left ideal of `A` induces an injective
homomorphism on full crossed products. -/
theorem fullCrossedProductMap_injective (φ : Hom γ α) (hφ : Function.Injective φ)
    (hmul : ∀ (a : A) (d : D), a * φ d ∈ Set.range φ) :
    Function.Injective (φ.fullCrossedProductMap μ) :=
  (φ.isometry_fullCrossedProductMap_of_injective μ hφ hmul).injective

end TauCeti.CStarAction.Hom

namespace IsInvariant

universe u v

section TwoSidedIdeal

variable {G : Type u} {A : Type v} [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
  [NonUnitalCStarAlgebra A] {α : CStarAction G A}
  {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
  (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
  (μ : Measure G) [μ.IsHaarMeasure]

/-- `hI.idealSubtypeHom.fullCrossedProductMap μ` preserves norms identically. -/
theorem norm_fullCrossedProductMap_idealSubtypeHom (x : FullCrossedProduct hI.restrictIdeal μ) :
    ‖hI.idealSubtypeHom.fullCrossedProductMap μ x‖ = ‖x‖ :=
  hI.idealSubtypeHom.norm_fullCrossedProductMap_of_injective μ hI.idealSubtypeHom_injective
    (fun a d => ⟨⟨a * d, I.mul_mem_left a d d.property⟩, by simp⟩) x

/-- `hI.idealSubtypeHom.fullCrossedProductMap μ` is an isometry. -/
theorem isometry_fullCrossedProductMap_idealSubtypeHom :
    Isometry (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  hI.idealSubtypeHom.isometry_fullCrossedProductMap_of_injective μ hI.idealSubtypeHom_injective
    fun a d => ⟨⟨a * d, I.mul_mem_left a d d.property⟩, by simp⟩

/-- `hI.idealSubtypeHom.fullCrossedProductMap μ` is a closed topological embedding. -/
theorem isClosedEmbedding_fullCrossedProductMap_idealSubtypeHom :
    IsClosedEmbedding (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  hI.idealSubtypeHom.isClosedEmbedding_fullCrossedProductMap_of_injective μ
    hI.idealSubtypeHom_injective
    fun a d => ⟨⟨a * d, I.mul_mem_left a d d.property⟩, by simp⟩

/-- `hI.idealSubtypeHom.fullCrossedProductMap μ` is injective. -/
theorem fullCrossedProductMap_idealSubtypeHom_injective :
    Function.Injective (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  hI.idealSubtypeHom.fullCrossedProductMap_injective μ hI.idealSubtypeHom_injective
    fun a d => ⟨⟨a * d, I.mul_mem_left a d d.property⟩, by simp⟩

/-- The `⋆`-subalgebra range of `hI.idealSubtypeHom.fullCrossedProductMap μ` agrees with that of
`I.toNonUnitalStarSubalgebra`. -/
theorem range_fullCrossedProductMap_idealSubtypeHom :
    (hI.idealSubtypeHom.fullCrossedProductMap μ).range =
      (hI.toNonUnitalStarSubalgebra.subtypeHom.fullCrossedProductMap μ).range := by
  have hsurj : Function.Surjective (hI.idealToSubalgebraHom.fullCrossedProductMap μ) :=
    Function.RightInverse.surjective fun y => by
      calc hI.idealToSubalgebraHom.fullCrossedProductMap μ
            (hI.subalgebraToIdealHom.fullCrossedProductMap μ y)
          = ((hI.idealToSubalgebraHom.comp hI.subalgebraToIdealHom).fullCrossedProductMap μ) y := by
            rw [Hom.fullCrossedProductMap_comp, NonUnitalStarAlgHom.comp_apply]
        _ = y := by simp
  apply SetLike.coe_injective
  rw [NonUnitalStarAlgHom.coe_range, NonUnitalStarAlgHom.coe_range,
    ← hI.subtypeHom_comp_idealToSubalgebraHom, Hom.fullCrossedProductMap_comp,
    NonUnitalStarAlgHom.coe_comp, Set.range_comp, hsurj.range_eq, Set.image_univ]

/-- The closed two-sided ideal of `FullCrossedProduct α μ` formed by the embedded full crossed
product of a closed `α`-invariant `I : TwoSidedIdeal A`. -/
def idealFullCrossedProductIdeal : TwoSidedIdeal (FullCrossedProduct α μ) :=
  hI.toNonUnitalStarSubalgebra.fullCrossedProductIdeal μ fun a _ hx =>
    I.mem_toNonUnitalStarSubalgebra.mpr
      (I.mul_mem_left a _ (I.mem_toNonUnitalStarSubalgebra.mp hx))

theorem idealFullCrossedProductIdeal_eq_fullCrossedProductIdeal :
    hI.idealFullCrossedProductIdeal μ =
      hI.toNonUnitalStarSubalgebra.fullCrossedProductIdeal μ
        (fun a _ hx => I.mem_toNonUnitalStarSubalgebra.mpr
          (I.mul_mem_left a _ (I.mem_toNonUnitalStarSubalgebra.mp hx))) :=
  (rfl)

@[simp]
theorem coe_idealFullCrossedProductIdeal :
    (hI.idealFullCrossedProductIdeal μ : Set (FullCrossedProduct α μ)) =
      Set.range (hI.idealSubtypeHom.fullCrossedProductMap μ) := by
  rw [idealFullCrossedProductIdeal, coe_fullCrossedProductIdeal, ← NonUnitalStarAlgHom.coe_range,
    ← hI.range_fullCrossedProductMap_idealSubtypeHom μ, NonUnitalStarAlgHom.coe_range]

@[simp]
theorem mem_idealFullCrossedProductIdeal {y : FullCrossedProduct α μ} :
    y ∈ hI.idealFullCrossedProductIdeal μ ↔
      y ∈ (hI.idealSubtypeHom.fullCrossedProductMap μ).range := by
  rw [idealFullCrossedProductIdeal, mem_fullCrossedProductIdeal,
    ← hI.range_fullCrossedProductMap_idealSubtypeHom μ]

/-- The embedded ideal crossed product `hI.idealFullCrossedProductIdeal μ` is topologically closed
in `FullCrossedProduct α μ`. -/
instance isClosed_idealFullCrossedProductIdeal :
    IsClosed (hI.idealFullCrossedProductIdeal μ : Set (FullCrossedProduct α μ)) := by
  dsimp [idealFullCrossedProductIdeal]
  infer_instance

@[simp]
theorem toNonUnitalStarSubalgebra_idealFullCrossedProductIdeal :
    (hI.idealFullCrossedProductIdeal μ).toNonUnitalStarSubalgebra =
      (hI.idealSubtypeHom.fullCrossedProductMap μ).range := by
  ext x
  simp

/-- Every compactly supported generator in `C_c(G, I)` belongs to
`hI.idealFullCrossedProductIdeal μ`. -/
theorem of_convolutionMap_mem_idealFullCrossedProductIdeal
    (f : ConvolutionAlgebra hI.restrictIdeal μ) :
    of α μ (hI.idealSubtypeHom.convolutionMap μ f) ∈ hI.idealFullCrossedProductIdeal μ :=
  (hI.mem_idealFullCrossedProductIdeal μ).mpr <|
    (hI.idealSubtypeHom.fullCrossedProductMap μ).mem_range.mpr
      ⟨of hI.restrictIdeal μ f, hI.idealSubtypeHom.fullCrossedProductMap_of μ f⟩

/-- A closed two-sided ideal `J` of `FullCrossedProduct α μ` contains
`hI.idealFullCrossedProductIdeal μ` precisely when it contains the image of `C_c(G, I)`. -/
theorem idealFullCrossedProductIdeal_le_iff
    {J : TwoSidedIdeal (FullCrossedProduct α μ)} [IsClosed (J : Set (FullCrossedProduct α μ))] :
    hI.idealFullCrossedProductIdeal μ ≤ J ↔
      ∀ f : ConvolutionAlgebra hI.restrictIdeal μ,
        of α μ (hI.idealSubtypeHom.convolutionMap μ f) ∈ J := by
  have hle : hI.idealFullCrossedProductIdeal μ ≤ J ↔
      (hI.idealSubtypeHom.fullCrossedProductMap μ).range ≤ J.toNonUnitalStarSubalgebra := by
    simp [← SetLike.coe_subset_coe]
  rw [hle,
    hI.idealSubtypeHom.range_fullCrossedProductMap_le_iff μ J.isClosed_toNonUnitalStarSubalgebra]
  simp only [J.mem_toNonUnitalStarSubalgebra]

/-- `hI.idealFullCrossedProductIdeal μ` equals the topological closure of the two-sided ideal
generated by the compactly supported elements coming from `C_c(G, I)`. -/
theorem idealFullCrossedProductIdeal_eq_topologicalClosure_span :
    hI.idealFullCrossedProductIdeal μ =
      (TwoSidedIdeal.span
        (Set.range ((of α μ).comp (hI.idealSubtypeHom.convolutionMap μ)))).topologicalClosure := by
  have hsurj : Function.Surjective (hI.idealToSubalgebraHom.convolutionMap μ) :=
    Function.RightInverse.surjective fun y => by
      calc hI.idealToSubalgebraHom.convolutionMap μ
            (hI.subalgebraToIdealHom.convolutionMap μ y)
          = ((hI.idealToSubalgebraHom.comp hI.subalgebraToIdealHom).convolutionMap μ) y := by
            rw [Hom.convolutionMap_comp, NonUnitalStarAlgHom.comp_apply]
        _ = y := by simp
  have hrange : Set.range ((of α μ).comp (hI.idealSubtypeHom.convolutionMap μ)) =
      Set.range ((of α μ).comp (hI.toNonUnitalStarSubalgebra.subtypeHom.convolutionMap μ)) := by
    rw [← hI.subtypeHom_comp_idealToSubalgebraHom, Hom.convolutionMap_comp,
      ← NonUnitalStarAlgHom.comp_assoc, NonUnitalStarAlgHom.coe_comp, Set.range_comp,
      hsurj.range_eq, Set.image_univ]
  rw [idealFullCrossedProductIdeal_eq_fullCrossedProductIdeal,
    hI.toNonUnitalStarSubalgebra.fullCrossedProductIdeal_eq_topologicalClosure_span, hrange]

end TwoSidedIdeal

end IsInvariant
