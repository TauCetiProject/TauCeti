/-!
# The ideal exact sequence of full crossed products

Let `α` be a point-norm continuous action of a locally compact group `G` on a C⋆-algebra `A`,
and let `I` be a closed `α`-invariant two-sided ideal of `A` (given either as a closed invariant
`NonUnitalStarSubalgebra ℂ A` or as a closed invariant `TwoSidedIdeal A`). For any surjective
equivariant homomorphism `q : Hom α β` with kernel `I` — in particular, the canonical quotient
projection `α.quotientMkHom I hI : Hom α (α.quotient I hI)` — the induced full crossed-product
maps form a short exact sequence

`0 → I ⋊_α G → A ⋊_α G → B ⋊_β G → 0`,

and the quotient `(A ⋊_α G) ⧸ (I ⋊_α G)` is canonically `⋆`-isomorphic to `B ⋊_β G` (and in
particular to `(A ⧸ I) ⋊_{α/I} G`).

Middle exactness (`ker (q.fullCrossedProductMap μ) = range (hI.subtypeHom.fullCrossedProductMap μ)`)
requires no Hausdorff assumption on `G`: if `x` lies in `ker (q.fullCrossedProductMap μ)`, every
nondegenerate Hilbert-space representation `L` of `(A ⋊_α G) ⧸ J` pulls back to a nondegenerate
representation of `A ⋊_α G` annihilating `J`, disintegrates to a covariant pair `P` of `α`
annihilating `I`, descends via `CovariantRepresentation.descend` to a covariant pair `Q` of `β`,
and therefore satisfies `L (mk J x) = Q.integratedFull μ (q.fullCrossedProductMap μ x) = 0`.
Separating elements of `(A ⋊_α G) ⧸ J` by nondegenerate GNS representations
(`TauCeti.CStarAlgebra.eq_iff_forall_isNondegenerate`) concludes `x ∈ J`. Surjectivity of
`q.fullCrossedProductMap μ` (which uses `[T2Space G]`) then yields the full short exact sequence
and the canonical quotient `⋆`-isomorphism.

No unitality, separability, or global σ-finiteness is assumed.

## Main definitions and results

* `TauCeti.CStarAction.CovariantRepresentation.integratedFull_descend_comp_fullCrossedProductMap`
  and `integratedFull_quotientLift_comp_fullCrossedProductMap`: compatibility of quotient descent
  of covariant pairs with extended integrated forms on full crossed products (in any Hilbert-space
  universe).
* `IsInvariant.fullCrossedProductIdeal`: the closed two-sided ideal of `FullCrossedProduct α μ`
  given by the isometric embedded image of `FullCrossedProduct hI.restrictIdeal μ`, identified
  with the closed star subalgebra generated by `C_c(G, I)`.
* `IsInvariant.fullCrossedProductMap_eq_zero_iff_mem_range_subtypeHom`,
  `IsInvariant.ker_fullCrossedProductMap_eq_fullCrossedProductIdeal`, and
  `IsInvariant.ker_fullCrossedProductMap_quotientMkHom`: middle exactness of the ideal sequence
  without `[T2Space G]`.
* `IsInvariant.quotientFullCrossedProductEquivOfSurjective` and
  `IsInvariant.quotientFullCrossedProductEquiv`: canonical isometric `⋆`-isomorphisms identifying
  `(FullCrossedProduct α μ) ⧸ hI.fullCrossedProductIdeal μ` with `FullCrossedProduct β μ` and
  `FullCrossedProduct (α.quotient I hI) μ`.
* `TauCeti.CStarAction.fullCrossedProductMap_exact`,
  `IsInvariant.fullCrossedProductMap_ideal_exact`, and
  `IsInvariant.fullCrossedProductMap_quotientMkHom_exact`: the short exact sequence of full
  crossed products.

## References

* Dana Williams, *Crossed Products of C*-Algebras*, Proposition 3.19, p. 93.
-/

public section

noncomputable section

open MeasureTheory Topology TauCeti CStarAction CStarAction.FullCrossedProduct
open scoped CStarAlgebra

namespace TauCeti.CStarAction

section Integration

universe u v w

variable {G : Type u} {A B C : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  {α : CStarAction G A} {β : CStarAction G B} {γ : CStarAction G C}
  (μ : Measure G) [μ.IsHaarMeasure]

/-- If the composite of two equivariant coefficient maps vanishes, then so does the composite of
their induced full crossed-product homomorphisms. -/
theorem Hom.fullCrossedProductMap_comp_eq_zero (ψ : Hom β γ) (φ : Hom α β)
    (h : ∀ a, ψ (φ a) = 0) :
    (ψ.fullCrossedProductMap μ).comp (φ.fullCrossedProductMap μ) = 0 := by
  refine FullCrossedProduct.starAlgHom_ext (NonUnitalStarAlgHom.ext fun f => ?_)
  have hconv : ψ.convolutionMap μ (φ.convolutionMap μ f) = 0 := by
    refine ConvolutionAlgebra.ext (CompactlySupportedContinuousMap.ext fun s => ?_)
    simp only [Hom.convolutionMap_apply, h, ConvolutionAlgebra.ofConv_zero,
      CompactlySupportedContinuousMap.zero_apply]
  simp only [NonUnitalStarAlgHom.comp_apply, Hom.fullCrossedProductMap_of, hconv, map_zero,
    NonUnitalStarAlgHom.zero_apply]

namespace CovariantRepresentation

variable {H : Type w} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The extended integrated form of a descended covariant representation intertwines
`q.fullCrossedProductMap μ` with the extended integrated form of `P`. -/
@[simp]
theorem integratedFull_descend_comp_fullCrossedProductMap
    (P : CovariantRepresentation α H) (q : Hom α β) (hq : Function.Surjective q)
    (hker : ∀ a, q a = 0 → P.coefficient a = 0) :
    ((P.descend q hq hker).integratedFull μ).comp (q.fullCrossedProductMap μ) =
      P.integratedFull μ := by
  refine FullCrossedProduct.starAlgHom_ext (NonUnitalStarAlgHom.ext fun f => ?_)
  simpa only [NonUnitalStarAlgHom.comp_apply, Hom.fullCrossedProductMap_of,
    integratedFull_of, integratedStarAlgHom_apply] using
    P.integratedOperator_descend q hq hker μ f

/-- Applying the extended integrated form of `P.descend q hq hker` to `q.fullCrossedProductMap μ x`
recovers `P.integratedFull μ x`. -/
@[simp]
theorem integratedFull_descend_fullCrossedProductMap_apply
    (P : CovariantRepresentation α H) (q : Hom α β) (hq : Function.Surjective q)
    (hker : ∀ a, q a = 0 → P.coefficient a = 0) (x : FullCrossedProduct α μ) :
    (P.descend q hq hker).integratedFull μ (q.fullCrossedProductMap μ x) =
      P.integratedFull μ x :=
  DFunLike.congr_fun (P.integratedFull_descend_comp_fullCrossedProductMap μ q hq hker) x

/-- The extended integrated form of `P.quotientLift I hI hker` intertwines the quotient crossed
product homomorphism with `P.integratedFull μ`. -/
@[simp]
theorem integratedFull_quotientLift_comp_fullCrossedProductMap
    (P : CovariantRepresentation α H) (I : TwoSidedIdeal A) [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (hker : ∀ a ∈ I, P.coefficient a = 0) :
    ((P.quotientLift I hI hker).integratedFull μ).comp
        ((α.quotientMkHom I hI).fullCrossedProductMap μ) =
      P.integratedFull μ := by
  refine FullCrossedProduct.starAlgHom_ext (NonUnitalStarAlgHom.ext fun f => ?_)
  simpa only [NonUnitalStarAlgHom.comp_apply, Hom.fullCrossedProductMap_of,
    integratedFull_of, integratedStarAlgHom_apply] using
    P.integratedOperator_quotientLift I hI hker μ f

/-- Applying the extended integrated form of `P.quotientLift I hI hker` to
`(α.quotientMkHom I hI).fullCrossedProductMap μ x` recovers `P.integratedFull μ x`. -/
@[simp]
theorem integratedFull_quotientLift_fullCrossedProductMap_apply
    (P : CovariantRepresentation α H) (I : TwoSidedIdeal A) [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (hker : ∀ a ∈ I, P.coefficient a = 0) (x : FullCrossedProduct α μ) :
    (P.quotientLift I hI hker).integratedFull μ
        ((α.quotientMkHom I hI).fullCrossedProductMap μ x) =
      P.integratedFull μ x :=
  DFunLike.congr_fun (P.integratedFull_quotientLift_comp_fullCrossedProductMap μ I hI hker) x

end CovariantRepresentation

end Integration

end TauCeti.CStarAction

namespace IsInvariant

universe u v w

section IdealEmbedding

variable {G : Type u} {A : Type v} [Group G] [TopologicalSpace G] [NonUnitalCStarAlgebra A]
  {α : CStarAction G A} {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
  (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))

private theorem isInvSubalgebra
    {α : CStarAction G A} {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) :
    _root_.IsInvariant (fun g a => α g a) (I.toNonUnitalStarSubalgebra : Set A) :=
  fun g _ ha => I.mem_toNonUnitalStarSubalgebra.mpr (hI g (I.mem_toNonUnitalStarSubalgebra.mp ha))

private theorem mul_mem_toNonUnitalStarSubalgebra (a : A) {x : A}
    (hx : x ∈ I.toNonUnitalStarSubalgebra) : a * x ∈ I.toNonUnitalStarSubalgebra :=
  I.mem_toNonUnitalStarSubalgebra.mpr (I.mul_mem_left a x (I.mem_toNonUnitalStarSubalgebra.mp hx))

private def restrictIdealToSubalgebraHom :
    Hom hI.restrictIdeal (isInvSubalgebra hI).restrict where
  toNonUnitalStarAlgHom := I.toNonUnitalStarSubalgebraEquiv.toNonUnitalStarAlgHom
  map_action' g x := Subtype.ext <| by
    rw [restrict_apply]
    exact (I.coe_toNonUnitalStarSubalgebraEquiv_apply (hI.restrictIdeal g x)).trans <|
      (hI.coe_restrictIdeal_apply g x).trans <|
        congrArg (α g) (I.coe_toNonUnitalStarSubalgebraEquiv_apply x).symm

private def subalgebraToRestrictIdealHom :
    Hom (isInvSubalgebra hI).restrict hI.restrictIdeal where
  toNonUnitalStarAlgHom := I.toNonUnitalStarSubalgebraEquiv.symm.toNonUnitalStarAlgHom
  map_action' g x := Subtype.ext <| by
    rw [hI.coe_restrictIdeal_apply]
    exact (I.coe_toNonUnitalStarSubalgebraEquiv_symm_apply _).trans <|
      (congrArg Subtype.val (restrict_apply (isInvSubalgebra hI) g x)).trans <|
        congrArg (α g) (I.coe_toNonUnitalStarSubalgebraEquiv_symm_apply x).symm

private theorem subalgebraToRestrictIdealHom_comp :
    (subalgebraToRestrictIdealHom hI).comp (restrictIdealToSubalgebraHom hI) =
      Hom.id hI.restrictIdeal := by
  refine Hom.ext fun x => Subtype.ext ?_
  rw [Hom.comp_apply, Hom.id_apply]
  exact (I.coe_toNonUnitalStarSubalgebraEquiv_symm_apply _).trans
    (I.coe_toNonUnitalStarSubalgebraEquiv_apply x)

private theorem restrictIdealToSubalgebraHom_comp :
    (restrictIdealToSubalgebraHom hI).comp (subalgebraToRestrictIdealHom hI) =
      Hom.id (isInvSubalgebra hI).restrict := by
  refine Hom.ext fun x => Subtype.ext ?_
  rw [Hom.comp_apply, Hom.id_apply]
  exact (I.coe_toNonUnitalStarSubalgebraEquiv_apply _).trans
    (I.coe_toNonUnitalStarSubalgebraEquiv_symm_apply x)

private theorem subtypeHom_comp_restrictIdealToSubalgebraHom :
    (isInvSubalgebra hI).subtypeHom.comp
        (restrictIdealToSubalgebraHom hI) = hI.idealSubtypeHom := by
  refine Hom.ext fun x => ?_
  rw [Hom.comp_apply, subtypeHom_apply, idealSubtypeHom_apply]
  exact I.coe_toNonUnitalStarSubalgebraEquiv_apply x

variable [IsTopologicalGroup G] [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
  (μ : Measure G) [μ.IsHaarMeasure]

private def fullCrossedProductRestrictIdealEquiv :
    FullCrossedProduct hI.restrictIdeal μ ≃⋆ₐ[ℂ]
      FullCrossedProduct (isInvSubalgebra hI).restrict μ :=
  StarAlgEquiv.ofNonUnitalStarAlgHom
    ((restrictIdealToSubalgebraHom hI).fullCrossedProductMap μ)
    ((subalgebraToRestrictIdealHom hI).fullCrossedProductMap μ)
    (by
      rw [← Hom.fullCrossedProductMap_comp, subalgebraToRestrictIdealHom_comp,
        Hom.fullCrossedProductMap_id])
    (by
      rw [← Hom.fullCrossedProductMap_comp, restrictIdealToSubalgebraHom_comp,
        Hom.fullCrossedProductMap_id])

private theorem fullCrossedProductMap_idealSubtypeHom_eq_comp :
    hI.idealSubtypeHom.fullCrossedProductMap μ =
      ((isInvSubalgebra hI).subtypeHom.fullCrossedProductMap μ).comp
        (fullCrossedProductRestrictIdealEquiv hI μ).toNonUnitalStarAlgHom := by
  rw [fullCrossedProductRestrictIdealEquiv,
    StarAlgEquiv.toNonUnitalStarAlgHom_ofNonUnitalStarAlgHom,
    ← Hom.fullCrossedProductMap_comp, subtypeHom_comp_restrictIdealToSubalgebraHom]

private theorem range_fullCrossedProductMap_idealSubtypeHom_eq :
    (hI.idealSubtypeHom.fullCrossedProductMap μ).range =
      ((isInvSubalgebra hI).subtypeHom.fullCrossedProductMap μ).range := by
  ext x
  rw [fullCrossedProductMap_idealSubtypeHom_eq_comp]
  simp only [NonUnitalStarAlgHom.mem_range, NonUnitalStarAlgHom.comp_apply]
  refine ⟨fun ⟨y, hy⟩ => ⟨_, hy⟩, fun ⟨y, hy⟩ =>
    ⟨(fullCrossedProductRestrictIdealEquiv hI μ).symm y, ?_⟩⟩
  simpa only [StarAlgEquiv.toNonUnitalStarAlgHom_apply, StarAlgEquiv.apply_symm_apply] using hy

/-- The induced full crossed-product map from a closed invariant two-sided ideal preserves norms
identically. -/
theorem norm_fullCrossedProductMap_idealSubtypeHom (x : FullCrossedProduct hI.restrictIdeal μ) :
    ‖hI.idealSubtypeHom.fullCrossedProductMap μ x‖ = ‖x‖ := by
  rw [fullCrossedProductMap_idealSubtypeHom_eq_comp, NonUnitalStarAlgHom.comp_apply,
    (isInvSubalgebra hI).norm_fullCrossedProductMap_subtypeHom μ
      (fun a _ hx => mul_mem_toNonUnitalStarSubalgebra (I := I) a hx)]
  exact (StarAlgEquiv.isometry (fullCrossedProductRestrictIdealEquiv hI μ)).norm_map_of_map_zero
    (map_zero _) x

/-- The induced full crossed-product map from a closed invariant two-sided ideal is an isometry. -/
theorem isometry_fullCrossedProductMap_idealSubtypeHom :
    Isometry (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  AddMonoidHomClass.isometry_of_norm _ (hI.norm_fullCrossedProductMap_idealSubtypeHom μ)

/-- The induced full crossed-product map from a closed invariant two-sided ideal is a closed
topological embedding. -/
theorem isClosedEmbedding_fullCrossedProductMap_idealSubtypeHom :
    IsClosedEmbedding (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_idealSubtypeHom μ).isClosedEmbedding

/-- The induced full crossed-product map from a closed invariant two-sided ideal is injective. -/
theorem fullCrossedProductMap_idealSubtypeHom_injective :
    Function.Injective (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  (hI.isometry_fullCrossedProductMap_idealSubtypeHom μ).injective

/-- The range of `hI.idealSubtypeHom.fullCrossedProductMap μ` is closed in
`FullCrossedProduct α μ`. -/
theorem isClosed_range_fullCrossedProductMap_idealSubtypeHom :
    IsClosed ((hI.idealSubtypeHom.fullCrossedProductMap μ).range :
      Set (FullCrossedProduct α μ)) := by
  rw [NonUnitalStarAlgHom.coe_range]
  exact (hI.isClosedEmbedding_fullCrossedProductMap_idealSubtypeHom μ).isClosed_range

/-- For a closed invariant two-sided ideal `I`, the range of
`hI.idealSubtypeHom.fullCrossedProductMap μ` equals the topological closure of the image of
`C_c(G, I)` inside `FullCrossedProduct α μ`. -/
theorem range_fullCrossedProductMap_idealSubtypeHom_eq_topologicalClosure :
    (hI.idealSubtypeHom.fullCrossedProductMap μ).range =
      ((of α μ).comp (hI.idealSubtypeHom.convolutionMap μ)).range.topologicalClosure := by
  refine le_antisymm (hI.idealSubtypeHom.range_fullCrossedProductMap_le_topologicalClosure μ) ?_
  refine NonUnitalStarSubalgebra.topologicalClosure_minimal _ ?_
    (hI.isClosed_range_fullCrossedProductMap_idealSubtypeHom μ)
  rw [← hI.idealSubtypeHom.fullCrossedProductMap_comp_of μ]
  exact NonUnitalStarAlgHom.range_comp_le_range _ _

/-- The embedded full crossed product of a closed invariant two-sided ideal is closed under left
multiplication in `FullCrossedProduct α μ`. -/
theorem mul_mem_range_fullCrossedProductMap_idealSubtypeHom_left
    (a : FullCrossedProduct α μ) {y : FullCrossedProduct α μ}
    (hy : y ∈ (hI.idealSubtypeHom.fullCrossedProductMap μ).range) :
    a * y ∈ (hI.idealSubtypeHom.fullCrossedProductMap μ).range := by
  rw [range_fullCrossedProductMap_idealSubtypeHom_eq] at hy ⊢
  exact (isInvSubalgebra hI).mul_mem_range_fullCrossedProductMap_subtypeHom_left
    μ (fun b _ hx => mul_mem_toNonUnitalStarSubalgebra (I := I) b hx) a hy

/-- The embedded full crossed product of a closed invariant two-sided ideal is closed under right
multiplication in `FullCrossedProduct α μ`. -/
theorem mul_mem_range_fullCrossedProductMap_idealSubtypeHom_right
    {y : FullCrossedProduct α μ} (hy : y ∈ (hI.idealSubtypeHom.fullCrossedProductMap μ).range)
    (a : FullCrossedProduct α μ) :
    y * a ∈ (hI.idealSubtypeHom.fullCrossedProductMap μ).range :=
  StarMemClass.mul_mem_right_of_mul_mem_left
    (hI.mul_mem_range_fullCrossedProductMap_idealSubtypeHom_left μ) a hy

/-- The closed two-sided ideal of `FullCrossedProduct α μ` given by the embedded image of
`FullCrossedProduct hI.restrictIdeal μ`. -/
def fullCrossedProductIdeal : TwoSidedIdeal (FullCrossedProduct α μ) :=
  TwoSidedIdeal.mk'
    ((hI.idealSubtypeHom.fullCrossedProductMap μ).range : Set (FullCrossedProduct α μ))
    (zero_mem _)
    (fun hx hy => add_mem hx hy)
    (fun hx => neg_mem hx)
    (fun {a _} hx => hI.mul_mem_range_fullCrossedProductMap_idealSubtypeHom_left μ a hx)
    (fun {_ a} hx => hI.mul_mem_range_fullCrossedProductMap_idealSubtypeHom_right μ hx a)

/-- The underlying set of `hI.fullCrossedProductIdeal μ` is the range of
`hI.idealSubtypeHom.fullCrossedProductMap μ`. -/
@[simp]
theorem coe_fullCrossedProductIdeal :
    (hI.fullCrossedProductIdeal μ : Set (FullCrossedProduct α μ)) =
      (hI.idealSubtypeHom.fullCrossedProductMap μ).range :=
  TwoSidedIdeal.coe_mk' _ _ _ _ _ _

/-- Membership in `hI.fullCrossedProductIdeal μ` agrees with membership in the range star
subalgebra of `hI.idealSubtypeHom.fullCrossedProductMap μ`. -/
@[simp]
theorem mem_fullCrossedProductIdeal {x : FullCrossedProduct α μ} :
    x ∈ hI.fullCrossedProductIdeal μ ↔ x ∈ (hI.idealSubtypeHom.fullCrossedProductMap μ).range :=
  TwoSidedIdeal.mem_mk' _ _ _ _ _ _ x

/-- Membership in `hI.fullCrossedProductIdeal μ` is equivalent to membership in the set range of
`hI.idealSubtypeHom.fullCrossedProductMap μ`. -/
theorem mem_fullCrossedProductIdeal_iff_mem_range {x : FullCrossedProduct α μ} :
    x ∈ hI.fullCrossedProductIdeal μ ↔
      x ∈ Set.range (hI.idealSubtypeHom.fullCrossedProductMap μ) := by
  rw [mem_fullCrossedProductIdeal, NonUnitalStarAlgHom.mem_range]
  rfl

/-- The ideal `hI.fullCrossedProductIdeal μ` is closed in `FullCrossedProduct α μ`. -/
instance isClosed_fullCrossedProductIdeal :
    IsClosed (hI.fullCrossedProductIdeal μ : Set (FullCrossedProduct α μ)) := by
  rw [coe_fullCrossedProductIdeal]
  exact hI.isClosed_range_fullCrossedProductMap_idealSubtypeHom μ

/-- The nonunital star subalgebra underlying `hI.fullCrossedProductIdeal μ` is the range of
`hI.idealSubtypeHom.fullCrossedProductMap μ`. -/
@[simp]
theorem toNonUnitalStarSubalgebra_fullCrossedProductIdeal :
    (hI.fullCrossedProductIdeal μ).toNonUnitalStarSubalgebra =
      (hI.idealSubtypeHom.fullCrossedProductMap μ).range := by
  ext x
  simp only [TwoSidedIdeal.mem_toNonUnitalStarSubalgebra, mem_fullCrossedProductIdeal]

/-- The closed star subalgebra underlying `hI.fullCrossedProductIdeal μ` is the topological
closure of the image of `C_c(G, I)`. -/
theorem toNonUnitalStarSubalgebra_fullCrossedProductIdeal_eq_topologicalClosure :
    (hI.fullCrossedProductIdeal μ).toNonUnitalStarSubalgebra =
      ((of α μ).comp (hI.idealSubtypeHom.convolutionMap μ)).range.topologicalClosure := by
  rw [toNonUnitalStarSubalgebra_fullCrossedProductIdeal,
    range_fullCrossedProductMap_idealSubtypeHom_eq_topologicalClosure]

/-- Every element in the image of `hI.idealSubtypeHom.fullCrossedProductMap μ` lies in
`hI.fullCrossedProductIdeal μ`. -/
theorem fullCrossedProductMap_idealSubtypeHom_mem_fullCrossedProductIdeal
    (x : FullCrossedProduct hI.restrictIdeal μ) :
    hI.idealSubtypeHom.fullCrossedProductMap μ x ∈ hI.fullCrossedProductIdeal μ :=
  (hI.mem_fullCrossedProductIdeal_iff_mem_range μ).2 ⟨x, rfl⟩

/-- Any compactly supported function on `G` taking values in `I` maps under `FullCrossedProduct.of`
into `hI.fullCrossedProductIdeal μ`. -/
theorem of_mem_fullCrossedProductIdeal_of_forall_mem {f : ConvolutionAlgebra α μ}
    (hf : ∀ s : G, f.ofConv s ∈ I) :
    of α μ f ∈ hI.fullCrossedProductIdeal μ := by
  rw [mem_fullCrossedProductIdeal, range_fullCrossedProductMap_idealSubtypeHom_eq]
  exact (isInvSubalgebra hI).of_mem_range_fullCrossedProductMap_subtypeHom_of_forall_mem
    μ fun s => I.mem_toNonUnitalStarSubalgebra.mpr (hf s)

/-- The extended integrated form of a covariant representation `P` of `α` (on a Hilbert space in
any universe) vanishes on `hI.fullCrossedProductIdeal μ` precisely when `P.coefficient` vanishes
on `I`. -/
theorem forall_mem_fullCrossedProductIdeal_integratedFull_eq_zero_iff
    {H : Type w} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (P : CovariantRepresentation α H) :
    (∀ y ∈ hI.fullCrossedProductIdeal μ, P.integratedFull μ y = 0) ↔
      ∀ x ∈ I, P.coefficient x = 0 := by
  have hcomp :
      (P.integratedFull μ).comp (hI.idealSubtypeHom.fullCrossedProductMap μ) =
        (P.comap hI.idealSubtypeHom).integratedFull μ := by
    refine FullCrossedProduct.starAlgHom_ext (NonUnitalStarAlgHom.ext fun f => ?_)
    simpa only [NonUnitalStarAlgHom.comp_apply, Hom.fullCrossedProductMap_of,
      CovariantRepresentation.integratedFull_of,
      CovariantRepresentation.integratedStarAlgHom_apply] using
      (P.integratedOperator_comap hI.idealSubtypeHom μ f).symm
  have hiff :
      (∀ y ∈ hI.fullCrossedProductIdeal μ, P.integratedFull μ y = 0) ↔
        (P.integratedFull μ).comp (hI.idealSubtypeHom.fullCrossedProductMap μ) = 0 := by
    simp only [mem_fullCrossedProductIdeal, NonUnitalStarAlgHom.mem_range,
      NonUnitalStarAlgHom.ext_iff, NonUnitalStarAlgHom.comp_apply, NonUnitalStarAlgHom.zero_apply,
      forall_exists_index, forall_apply_eq_imp_iff]
  rw [hiff, hcomp, CovariantRepresentation.integratedFull_eq_zero_iff, NonUnitalStarAlgHom.ext_iff]
  simp only [CovariantRepresentation.comap_coefficient, NonUnitalStarAlgHom.comp_apply,
    Hom.coe_toNonUnitalStarAlgHom, idealSubtypeHom_apply, NonUnitalStarAlgHom.zero_apply,
    Subtype.forall]

end IdealEmbedding

section MiddleExactness

variable {G : Type u} {A B : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]
  {α : CStarAction G A} {β : CStarAction G B}
  (μ : Measure G) [μ.IsHaarMeasure]

/-- If `q : Hom α β` vanishes on a closed invariant two-sided ideal `I`, the composite of the
induced full crossed-product maps is zero. -/
theorem fullCrossedProductMap_comp_idealSubtypeHom_eq_zero
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hker : ∀ a ∈ I, q a = 0) :
    (q.fullCrossedProductMap μ).comp (hI.idealSubtypeHom.fullCrossedProductMap μ) = 0 :=
  Hom.fullCrossedProductMap_comp_eq_zero μ q hI.idealSubtypeHom fun a => by
    simpa only [idealSubtypeHom_apply] using hker a a.2

/-- If `q : Hom α β` vanishes on a closed invariant star subalgebra `I`, the composite of the
induced full crossed-product maps is zero. -/
theorem fullCrossedProductMap_comp_subtypeHom_eq_zero
    {I : NonUnitalStarSubalgebra ℂ A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hker : ∀ a ∈ I, q a = 0) :
    (q.fullCrossedProductMap μ).comp (hI.subtypeHom.fullCrossedProductMap μ) = 0 :=
  Hom.fullCrossedProductMap_comp_eq_zero μ q hI.subtypeHom fun a => by
    simpa only [subtypeHom_apply] using hker a a.2

/-- Middle exactness of the ideal sequence for full crossed products (Williams, Proposition 3.19):
for a surjective equivariant homomorphism `q : Hom α β` with kernel a closed invariant two-sided
ideal `I`, the kernel of `q.fullCrossedProductMap μ` equals `hI.fullCrossedProductIdeal μ`. No
Hausdorff assumption on `G` is required. -/
theorem ker_fullCrossedProductMap_eq_fullCrossedProductIdeal
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I) :
    TwoSidedIdeal.ker (q.fullCrossedProductMap μ) = hI.fullCrossedProductIdeal μ := by
  ext x
  rw [TwoSidedIdeal.mem_ker]
  refine ⟨fun hx => ?_, fun hx => ?_⟩
  · suffices hmk : TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) x = 0 from
      TwoSidedIdeal.Quotient.eq_zero_iff_mem.1 hmk
    refine TauCeti.CStarAlgebra.eq_iff_forall_isNondegenerate.2 fun H _ _ _ L hL => ?_
    let L' : FullCrossedProduct α μ →⋆ₙₐ[ℂ] (H →L[ℂ] H) :=
      L.comp (TwoSidedIdeal.Quotient.mkStarAlgHom (hI.fullCrossedProductIdeal μ))
    have hL' : L'.IsNondegenerate := by
      rw [NonUnitalStarAlgHom.isNondegenerate_iff_dense]
      exact (L.isNondegenerate_iff_dense_span_comp
        (TwoSidedIdeal.Quotient.mkStarAlgHom_surjective _).denseRange).1 hL
    let P : CovariantRepresentation α H := L'.toCovariantRepresentation hL'
    have hP_int : P.integratedFull μ = L' :=
      NonUnitalStarAlgHom.integratedFull_toCovariantRepresentation L' hL'
    have hP_ideal : ∀ y ∈ hI.fullCrossedProductIdeal μ, P.integratedFull μ y = 0 := by
      intro y hy
      rw [hP_int, NonUnitalStarAlgHom.comp_apply, TwoSidedIdeal.Quotient.mkStarAlgHom_apply,
        TwoSidedIdeal.Quotient.eq_zero_iff_mem.2 hy, map_zero]
    have hP_ker : ∀ a, q a = 0 → P.coefficient a = 0 := fun a ha =>
      (hI.forall_mem_fullCrossedProductIdeal_integratedFull_eq_zero_iff μ P).1 hP_ideal a <|
        hker ▸ (TwoSidedIdeal.mem_ker q.toNonUnitalStarAlgHom).2 ha
    calc L (TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) x)
        = P.integratedFull μ x := by
          rw [hP_int, NonUnitalStarAlgHom.comp_apply, TwoSidedIdeal.Quotient.mkStarAlgHom_apply]
      _ = (P.descend q hq hP_ker).integratedFull μ (q.fullCrossedProductMap μ x) :=
          (P.integratedFull_descend_fullCrossedProductMap_apply μ q hq hP_ker x).symm
      _ = L 0 := by rw [hx, map_zero, map_zero]
  · obtain ⟨y, rfl⟩ := (hI.mem_fullCrossedProductIdeal_iff_mem_range μ).1 hx
    exact DFunLike.congr_fun
      (hI.fullCrossedProductMap_comp_idealSubtypeHom_eq_zero μ q fun a ha =>
        (TwoSidedIdeal.mem_ker q.toNonUnitalStarAlgHom).1 (hker.symm ▸ ha)) y

/-- Elementwise middle exactness for a closed invariant `TwoSidedIdeal A` and any surjective
equivariant homomorphism `q : Hom α β` with kernel `I`. -/
theorem fullCrossedProductMap_eq_zero_iff_mem_range_idealSubtypeHom
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I)
    (x : FullCrossedProduct α μ) :
    q.fullCrossedProductMap μ x = 0 ↔
      x ∈ Set.range (hI.idealSubtypeHom.fullCrossedProductMap μ) := by
  rw [← hI.mem_fullCrossedProductIdeal_iff_mem_range μ,
    ← hI.ker_fullCrossedProductMap_eq_fullCrossedProductIdeal μ q hq hker, TwoSidedIdeal.mem_ker]

/-- Elementwise middle exactness for a closed invariant nonunital star subalgebra `I` and any
surjective equivariant homomorphism `q : Hom α β` with kernel `I`. No Hausdorff assumption on `G`
is required. -/
theorem fullCrossedProductMap_eq_zero_iff_mem_range_subtypeHom
    {I : NonUnitalStarSubalgebra ℂ A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q) (hker : ∀ a, q a = 0 ↔ a ∈ I)
    (x : FullCrossedProduct α μ) :
    q.fullCrossedProductMap μ x = 0 ↔
      x ∈ Set.range (hI.subtypeHom.fullCrossedProductMap μ) := by
  let K : TwoSidedIdeal A := TwoSidedIdeal.ker q.toNonUnitalStarAlgHom
  have hK : _root_.IsInvariant (fun g a => α g a) (K : Set A) := IsInvariant.ker q
  have hKI : K.toNonUnitalStarSubalgebra = I := by
    ext a
    rw [TwoSidedIdeal.mem_toNonUnitalStarSubalgebra, TwoSidedIdeal.mem_ker,
      Hom.coe_toNonUnitalStarAlgHom]
    exact hker a
  have hx := hK.fullCrossedProductMap_eq_zero_iff_mem_range_idealSubtypeHom μ q hq rfl x
  rw [Set.mem_range, ← NonUnitalStarAlgHom.mem_range,
    range_fullCrossedProductMap_idealSubtypeHom_eq, NonUnitalStarAlgHom.mem_range,
    ← Set.mem_range] at hx
  subst hKI
  exact hx

/-- The nonunital star subalgebra underlying `TwoSidedIdeal.ker (q.fullCrossedProductMap μ)` is
the range of `hI.subtypeHom.fullCrossedProductMap μ`. -/
theorem toNonUnitalStarSubalgebra_ker_fullCrossedProductMap
    {I : NonUnitalStarSubalgebra ℂ A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q) (hker : ∀ a, q a = 0 ↔ a ∈ I) :
    (TwoSidedIdeal.ker (q.fullCrossedProductMap μ)).toNonUnitalStarSubalgebra =
      (hI.subtypeHom.fullCrossedProductMap μ).range := by
  ext x
  rw [TwoSidedIdeal.mem_toNonUnitalStarSubalgebra, TwoSidedIdeal.mem_ker,
    NonUnitalStarAlgHom.mem_range]
  exact hI.fullCrossedProductMap_eq_zero_iff_mem_range_subtypeHom μ q hq hker x

/-- Even without `[T2Space G]`, the quotient norm on
`FullCrossedProduct α μ ⧸ hI.fullCrossedProductIdeal μ` agrees identically with the norm in
`FullCrossedProduct β μ`. -/
theorem norm_mk_fullCrossedProductIdeal_eq
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I)
    (x : FullCrossedProduct α μ) :
    ‖TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) x‖ =
      ‖q.fullCrossedProductMap μ x‖ := by
  have heq := hI.ker_fullCrossedProductMap_eq_fullCrossedProductIdeal μ q hq hker
  have h1 :=
    (StarAlgEquiv.isometry
      (TwoSidedIdeal.Quotient.quotStarAlgEquivOfEq heq.symm)).norm_map_of_map_zero
        (map_zero _) (TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) x)
  have h2 := (q.fullCrossedProductMap μ).isometry_quotientKerHom.norm_map_of_map_zero
    (map_zero _) (TwoSidedIdeal.Quotient.mk (TwoSidedIdeal.ker (q.fullCrossedProductMap μ)) x)
  rw [TwoSidedIdeal.Quotient.quotStarAlgEquivOfEq_mk] at h1
  rw [NonUnitalStarAlgHom.quotientKerHom_mk] at h2
  exact h1.symm.trans h2.symm

/-- Composing the canonical quotient and ideal inclusion full crossed-product maps gives zero. -/
@[simp]
theorem fullCrossedProductMap_quotientMkHom_comp_idealSubtypeHom
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) :
    ((α.quotientMkHom I hI).fullCrossedProductMap μ).comp
        (hI.idealSubtypeHom.fullCrossedProductMap μ) = 0 :=
  hI.fullCrossedProductMap_comp_idealSubtypeHom_eq_zero μ (α.quotientMkHom I hI) fun a ha => by
    rw [CStarAction.quotientMkHom_apply, TwoSidedIdeal.Quotient.eq_zero_iff_mem.2 ha]

/-- The canonical quotient crossed-product homomorphism annihilates the image of the ideal
inclusion. -/
@[simp]
theorem fullCrossedProductMap_quotientMkHom_idealSubtypeHom_apply
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (x : FullCrossedProduct hI.restrictIdeal μ) :
    (α.quotientMkHom I hI).fullCrossedProductMap μ
        (hI.idealSubtypeHom.fullCrossedProductMap μ x) = 0 :=
  DFunLike.congr_fun (hI.fullCrossedProductMap_quotientMkHom_comp_idealSubtypeHom μ) x

/-- The kernel of the canonical quotient crossed-product homomorphism
`(α.quotientMkHom I hI).fullCrossedProductMap μ` is `hI.fullCrossedProductIdeal μ`. -/
@[simp]
theorem ker_fullCrossedProductMap_quotientMkHom
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) :
    TwoSidedIdeal.ker ((α.quotientMkHom I hI).fullCrossedProductMap μ) =
      hI.fullCrossedProductIdeal μ :=
  hI.ker_fullCrossedProductMap_eq_fullCrossedProductIdeal μ (α.quotientMkHom I hI)
    (α.quotientMkHom_surjective I hI) (α.ker_quotientMkHom I hI)

/-- Elementwise middle exactness for the canonical ideal inclusion and quotient projection. -/
theorem fullCrossedProductMap_quotientMkHom_eq_zero_iff
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (x : FullCrossedProduct α μ) :
    (α.quotientMkHom I hI).fullCrossedProductMap μ x = 0 ↔
      x ∈ Set.range (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  hI.fullCrossedProductMap_eq_zero_iff_mem_range_idealSubtypeHom μ (α.quotientMkHom I hI)
    (α.quotientMkHom_surjective I hI) (α.ker_quotientMkHom I hI) x

end MiddleExactness

section QuotientEquiv

variable {G : Type u} {A B : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [T2Space G] [MeasurableSpace G] [BorelSpace G]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]
  {α : CStarAction G A} {β : CStarAction G B}
  (μ : Measure G) [μ.IsHaarMeasure]

/-- The canonical isometric `⋆`-isomorphism
`(FullCrossedProduct α μ) ⧸ hI.fullCrossedProductIdeal μ ≃⋆ₐ[ℂ] FullCrossedProduct β μ`
induced by a surjective equivariant homomorphism `q : Hom α β` with kernel `I`. -/
def quotientFullCrossedProductEquivOfSurjective
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I) :
    FullCrossedProduct α μ ⧸ hI.fullCrossedProductIdeal μ ≃⋆ₐ[ℂ] FullCrossedProduct β μ :=
  (TwoSidedIdeal.Quotient.quotStarAlgEquivOfEq
      (hI.ker_fullCrossedProductMap_eq_fullCrossedProductIdeal μ q hq hker).symm).trans
    (NonUnitalStarAlgHom.quotientKerEquivOfSurjective
      (q.surjective_fullCrossedProductMap μ hq.denseRange))

/-- On quotient classes, `quotientFullCrossedProductEquivOfSurjective` agrees with
`q.fullCrossedProductMap μ`. -/
@[simp]
theorem quotientFullCrossedProductEquivOfSurjective_mk
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I) (x : FullCrossedProduct α μ) :
    hI.quotientFullCrossedProductEquivOfSurjective μ q hq hker
        (TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) x) =
      q.fullCrossedProductMap μ x := by
  simp only [quotientFullCrossedProductEquivOfSurjective, StarAlgEquiv.trans_apply,
    TwoSidedIdeal.Quotient.quotStarAlgEquivOfEq_mk,
    NonUnitalStarAlgHom.quotientKerEquivOfSurjective_mk]

/-- On compactly supported elements, `quotientFullCrossedProductEquivOfSurjective` applies
`q.convolutionMap μ`. -/
theorem quotientFullCrossedProductEquivOfSurjective_mk_of
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I) (f : ConvolutionAlgebra α μ) :
    hI.quotientFullCrossedProductEquivOfSurjective μ q hq hker
        (TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) (of α μ f)) =
      of β μ (q.convolutionMap μ f) := by
  rw [quotientFullCrossedProductEquivOfSurjective_mk, Hom.fullCrossedProductMap_of]

/-- The inverse of `quotientFullCrossedProductEquivOfSurjective` sends `q.fullCrossedProductMap μ x`
to the quotient class of `x`. -/
@[simp]
theorem quotientFullCrossedProductEquivOfSurjective_symm_apply
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I) (x : FullCrossedProduct α μ) :
    (hI.quotientFullCrossedProductEquivOfSurjective μ q hq hker).symm
        (q.fullCrossedProductMap μ x) =
      TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) x :=
  (hI.quotientFullCrossedProductEquivOfSurjective μ q hq hker).symm_apply_eq.mpr
    (hI.quotientFullCrossedProductEquivOfSurjective_mk μ q hq hker x).symm

/-- On compactly supported elements, the inverse of `quotientFullCrossedProductEquivOfSurjective`
sends `of β μ (q.convolutionMap μ f)` to the quotient class of `of α μ f`. -/
@[simp]
theorem quotientFullCrossedProductEquivOfSurjective_symm_of
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I) (f : ConvolutionAlgebra α μ) :
    (hI.quotientFullCrossedProductEquivOfSurjective μ q hq hker).symm
        (of β μ (q.convolutionMap μ f)) =
      TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) (of α μ f) := by
  rw [← Hom.fullCrossedProductMap_of, quotientFullCrossedProductEquivOfSurjective_symm_apply]

/-- The canonical isometric `⋆`-isomorphism identifying
`(FullCrossedProduct α μ) ⧸ hI.fullCrossedProductIdeal μ` with
`FullCrossedProduct (α.quotient I hI) μ` for a closed invariant two-sided ideal `I`. -/
def quotientFullCrossedProductEquiv
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) :
    FullCrossedProduct α μ ⧸ hI.fullCrossedProductIdeal μ ≃⋆ₐ[ℂ]
      FullCrossedProduct (α.quotient I hI) μ :=
  hI.quotientFullCrossedProductEquivOfSurjective μ (α.quotientMkHom I hI)
    (α.quotientMkHom_surjective I hI) (α.ker_quotientMkHom I hI)

/-- On quotient classes, `quotientFullCrossedProductEquiv` agrees with
`(α.quotientMkHom I hI).fullCrossedProductMap μ`. -/
@[simp]
theorem quotientFullCrossedProductEquiv_mk
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) (x : FullCrossedProduct α μ) :
    hI.quotientFullCrossedProductEquiv μ
        (TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) x) =
      (α.quotientMkHom I hI).fullCrossedProductMap μ x :=
  hI.quotientFullCrossedProductEquivOfSurjective_mk μ (α.quotientMkHom I hI)
    (α.quotientMkHom_surjective I hI) (α.ker_quotientMkHom I hI) x

/-- On compactly supported elements, `quotientFullCrossedProductEquiv` applies
`(α.quotientMkHom I hI).convolutionMap μ`. -/
theorem quotientFullCrossedProductEquiv_mk_of
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) (f : ConvolutionAlgebra α μ) :
    hI.quotientFullCrossedProductEquiv μ
        (TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) (of α μ f)) =
      of (α.quotient I hI) μ ((α.quotientMkHom I hI).convolutionMap μ f) :=
  hI.quotientFullCrossedProductEquivOfSurjective_mk_of μ (α.quotientMkHom I hI)
    (α.quotientMkHom_surjective I hI) (α.ker_quotientMkHom I hI) f

/-- The inverse of `quotientFullCrossedProductEquiv` sends
`(α.quotientMkHom I hI).fullCrossedProductMap μ x` to the quotient class of `x`. -/
@[simp]
theorem quotientFullCrossedProductEquiv_symm_apply
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) (x : FullCrossedProduct α μ) :
    (hI.quotientFullCrossedProductEquiv μ).symm
        ((α.quotientMkHom I hI).fullCrossedProductMap μ x) =
      TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) x :=
  hI.quotientFullCrossedProductEquivOfSurjective_symm_apply μ (α.quotientMkHom I hI)
    (α.quotientMkHom_surjective I hI) (α.ker_quotientMkHom I hI) x

/-- On compactly supported elements, the inverse of `quotientFullCrossedProductEquiv` sends
`of (α.quotient I hI) μ ((α.quotientMkHom I hI).convolutionMap μ f)` to the quotient class of
`of α μ f`. -/
@[simp]
theorem quotientFullCrossedProductEquiv_symm_of
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) (f : ConvolutionAlgebra α μ) :
    (hI.quotientFullCrossedProductEquiv μ).symm
        (of (α.quotient I hI) μ ((α.quotientMkHom I hI).convolutionMap μ f)) =
      TwoSidedIdeal.Quotient.mk (hI.fullCrossedProductIdeal μ) (of α μ f) :=
  hI.quotientFullCrossedProductEquivOfSurjective_symm_of μ (α.quotientMkHom I hI)
    (α.quotientMkHom_surjective I hI) (α.ker_quotientMkHom I hI) f

/-- The short exact sequence of full crossed products associated to a closed invariant two-sided
ideal `I : TwoSidedIdeal A` and any surjective equivariant homomorphism `q : Hom α β` with kernel
`I` (Williams, Proposition 3.19). -/
theorem fullCrossedProductMap_ideal_exact
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q)
    (hker : TwoSidedIdeal.ker q.toNonUnitalStarAlgHom = I) :
    Function.Injective (hI.idealSubtypeHom.fullCrossedProductMap μ) ∧
      Function.Surjective (q.fullCrossedProductMap μ) ∧
      ∀ x, q.fullCrossedProductMap μ x = 0 ↔
        x ∈ Set.range (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  ⟨hI.fullCrossedProductMap_idealSubtypeHom_injective μ,
    q.surjective_fullCrossedProductMap μ hq.denseRange,
    hI.fullCrossedProductMap_eq_zero_iff_mem_range_idealSubtypeHom μ q hq hker⟩

/-- The canonical short exact sequence of full crossed products
`0 → I ⋊_α G → A ⋊_α G → (A ⧸ I) ⋊_{α/I} G → 0` associated to a closed invariant two-sided ideal
`I : TwoSidedIdeal A` (Williams, Proposition 3.19). -/
theorem fullCrossedProductMap_quotientMkHom_exact
    {I : TwoSidedIdeal A} [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A)) :
    Function.Injective (hI.idealSubtypeHom.fullCrossedProductMap μ) ∧
      Function.Surjective ((α.quotientMkHom I hI).fullCrossedProductMap μ) ∧
      ∀ x, (α.quotientMkHom I hI).fullCrossedProductMap μ x = 0 ↔
        x ∈ Set.range (hI.idealSubtypeHom.fullCrossedProductMap μ) :=
  hI.fullCrossedProductMap_ideal_exact μ (α.quotientMkHom I hI)
    (α.quotientMkHom_surjective I hI) (α.ker_quotientMkHom I hI)

end QuotientEquiv

end IsInvariant

namespace TauCeti.CStarAction

universe u v

variable {G : Type u} {A B : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [T2Space G] [MeasurableSpace G] [BorelSpace G]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]
  {α : CStarAction G A} {β : CStarAction G B}
  (μ : Measure G) [μ.IsHaarMeasure]

/-- The ideal exact sequence of full crossed products (Williams, Proposition 3.19, p. 93): for a
closed invariant nonunital star subalgebra `I` and a surjective equivariant homomorphism
`q : Hom α β` with kernel `I`, the induced full crossed-product maps
`I ⋊ G → A ⋊ G → B ⋊ G` form a short exact sequence: the first is injective, the second is
surjective, and the kernel of the second is the range of the first. -/
theorem fullCrossedProductMap_exact
    (I : NonUnitalStarSubalgebra ℂ A) [IsClosed (I : Set A)]
    (hI : _root_.IsInvariant (fun g a => α g a) (I : Set A))
    (q : Hom α β) (hq : Function.Surjective q) (hker : ∀ a, q a = 0 ↔ a ∈ I) :
    Function.Injective (hI.subtypeHom.fullCrossedProductMap μ) ∧
      Function.Surjective (q.fullCrossedProductMap μ) ∧
      ∀ x, q.fullCrossedProductMap μ x = 0 ↔
        x ∈ Set.range (hI.subtypeHom.fullCrossedProductMap μ) :=
  ⟨hI.fullCrossedProductMap_subtypeHom_injective μ fun a y hy =>
      (hker (a * y)).1 (by rw [map_mul, (hker y).2 hy, mul_zero]),
    q.surjective_fullCrossedProductMap μ hq.denseRange,
    hI.fullCrossedProductMap_eq_zero_iff_mem_range_subtypeHom μ q hq hker⟩

end TauCeti.CStarAction
