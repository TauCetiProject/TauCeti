module

public import TauCeti.Analysis.CStarAlgebra.Action.Covariant.Intertwiner
import Mathlib.Logic.Small.List
import Mathlib.RingTheory.Finiteness.Small
import TauCeti.Analysis.InnerProductSpace.HilbertBasis.Small
import TauCeti.Analysis.InnerProductSpace.PartialIsometry
import TauCeti.Topology.Sequences.Small

/-!
# Covariant subrepresentations and the size of their Hilbert spaces

Let `(π, U)` be a covariant representation of a point-norm continuous action `α` of `G` on a
possibly nonunital C⋆-algebra `A`, on a Hilbert space `H`, and let `V : K → H` be a linear isometry
from another Hilbert space whose range is invariant under every `π(a)` and every `U_g`. Then the
compressions `V† π(a) V` and `V† U_g V` form a covariant representation on `K`,
`CovariantRepresentation.restrict`, and `V` intertwines it with `(π, U)`. Hence `V` also
intertwines the integrated forms, `restrict_integratedOperator_apply`.

Every vector `ξ ∈ H` lies in such an invariant range with `K` in the universe `max u v`, where
`G : Type u` and `A : Type v`, whatever the universe of `H`,
`exists_isometry_mapsTo_mem_range`. Indeed the closed linear span of the vectors `T ξ`, for `T` in
the monoid of operators generated by `π(A)` and `U(G)`, is invariant. It is the closure of the
span of a `max u v`-small set, so it is `max u v`-small and has a Hilbert basis indexed in that
universe.

This is the universe control for full crossed products: covariant representations on Hilbert
spaces in the universe `max u v` already detect the norms of the integrated forms of all
covariant representations, see `ConvolutionAlgebra.norm_integratedStarAlgHom_le_fullSeminorm`.

## References

Dana Williams, *Crossed Products of C*-Algebras*, Chapter 2, for the reduction of the universal
norm to a set of cyclic covariant representations of bounded size.
-/

public section

noncomputable section

open MeasureTheory
open scoped CompactlySupported

namespace TauCeti.CStarAction.CovariantRepresentation

variable {G A H K : Type*} [Group G] [TopologicalSpace G] [NonUnitalCStarAlgebra A]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
  {α : CStarAction G A} (P : CovariantRepresentation α H) (V : K →ₗᵢ[ℂ] H)

/-- The compression `V† T V` of an operator by a linear isometry. -/
private abbrev compress (T : H →L[ℂ] H) : K →L[ℂ] K :=
  ContinuousLinearMap.adjoint V.toContinuousLinearMap ∘L T ∘L V.toContinuousLinearMap

variable {P V}

/-- The covariant representation on `K` obtained by compressing `(π, U)` along a linear isometry
`V : K → H` whose range is invariant under every `π(a)` and every `U_g`. -/
def restrict (hπ : ∀ a, Set.MapsTo (P.coefficient a) (Set.range V) (Set.range V))
    (hU : ∀ g, Set.MapsTo (P.group g) (Set.range V) (Set.range V)) :
    CovariantRepresentation α K where
  coefficient :=
    { toFun a := compress V (P.coefficient a)
      map_smul' c a := by ext; simp
      map_zero' := by ext; simp
      map_add' a b := by ext; simp
      map_mul' a b := by
        rw [map_mul, ContinuousLinearMap.mul_def]
        exact V.isPartialIsometry_toContinuousLinearMap.adjoint_comp_comp_comp_of_mapsTo _ (hπ b)
      map_star' a := by
        rw [map_star]
        simp only [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_comp,
          ContinuousLinearMap.adjoint_adjoint, ContinuousLinearMap.comp_assoc] }
  group := .ofMonoidHom
    { toFun g := compress V (P.group g)
      map_one' := by
        ext x
        simpa only [map_one, ContinuousLinearMap.comp_apply, one_apply_eq_self,
          LinearIsometry.coe_toContinuousLinearMap] using congr($(V.adjoint_comp_self) x)
      map_mul' g h := by
        rw [map_mul, ContinuousLinearMap.mul_def]
        exact V.isPartialIsometry_toContinuousLinearMap.adjoint_comp_comp_comp_of_mapsTo _ (hU h) }
  isUnitary := (ContRepresentation.isUnitary_iff_norm_map _).2 fun g x => by
    -- The group operators of `ContRepresentation.ofMonoidHom` are the given compressions.
    change ‖ContinuousLinearMap.adjoint V.toContinuousLinearMap (P.group g (V x))‖ = ‖x‖
    rw [← V.norm_map, V.apply_adjoint_apply_of_mem_range (hU g ⟨x, rfl⟩), P.isUnitary.norm_map,
      V.norm_map]
  continuous_orbit x :=
    (ContinuousLinearMap.adjoint V.toContinuousLinearMap).continuous.comp
      (P.continuous_orbit (V x))
  covariance g a x := by
    -- The operators of the restricted pair are, by construction, the given compressions.
    change compress V (P.group g) (compress V (P.coefficient a) x) =
      compress V (P.coefficient (α g a)) (compress V (P.group g) x)
    simp only [ContinuousLinearMap.comp_apply, LinearIsometry.coe_toContinuousLinearMap]
    rw [V.apply_adjoint_apply_of_mem_range (hπ a ⟨x, rfl⟩),
      V.apply_adjoint_apply_of_mem_range (hU g ⟨_, rfl⟩), P.covariance]

variable (hπ : ∀ a, Set.MapsTo (P.coefficient a) (Set.range V) (Set.range V))
  (hU : ∀ g, Set.MapsTo (P.group g) (Set.range V) (Set.range V))

/-- The isometry intertwines the restricted coefficient representation with the original one. -/
@[simp]
theorem restrict_coefficient_apply (a : A) (x : K) :
    V ((P.restrict hπ hU).coefficient a x) = P.coefficient a (V x) :=
  V.apply_adjoint_apply_of_mem_range (hπ a ⟨x, rfl⟩)

/-- The isometry intertwines the restricted group representation with the original one. -/
@[simp]
theorem restrict_group_apply (g : G) (x : K) :
    V ((P.restrict hπ hU).group g x) = P.group g (V x) :=
  V.apply_adjoint_apply_of_mem_range (hU g ⟨x, rfl⟩)

/-- The isometry intertwines the integrated forms of the restricted and the original covariant
representations. -/
@[simp]
theorem restrict_integratedOperator_apply [MeasurableSpace G] [OpensMeasurableSpace G]
    (μ : Measure G) [IsFiniteMeasureOnCompacts μ] (f : C_c(G, A)) (x : K) :
    V ((P.restrict hπ hU).integratedOperator μ f x) = P.integratedOperator μ f (V x) :=
  congr($(comp_integratedOperator (T := V.toContinuousLinearMap) μ
    (fun a => ContinuousLinearMap.ext (restrict_coefficient_apply hπ hU a))
    (fun g => ContinuousLinearMap.ext (restrict_group_apply hπ hU g)) f) x)

universe u v w

/-- Every vector of a covariant representation lies in the range of a linear isometry from a
Hilbert space in the universe `max u v` whose range is invariant under the representation, where
`G : Type u` and `A : Type v`. -/
theorem exists_isometry_mapsTo_mem_range {G : Type u} {A : Type v} {H : Type w} [Group G]
    [TopologicalSpace G] [NonUnitalCStarAlgebra A] [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] {α : CStarAction G A}
    (P : CovariantRepresentation α H) (ξ : H) :
    ∃ (K : Type (max u v)) (_ : NormedAddCommGroup K) (_ : InnerProductSpace ℂ K)
      (_ : CompleteSpace K) (V : K →ₗᵢ[ℂ] H),
        (∀ a, Set.MapsTo (P.coefficient a) (Set.range V) (Set.range V)) ∧
        (∀ g, Set.MapsTo (P.group g) (Set.range V) (Set.range V)) ∧ ξ ∈ Set.range V := by
  -- `M` is the monoid generated by the operators of the pair, and `W` the closed span of `M ξ`.
  let M := Submonoid.closure (Set.range P.coefficient ∪ Set.range P.group)
  let S := Submodule.span ℂ ((fun T : H →L[ℂ] H => T ξ) '' M)
  let W := S.topologicalClosure
  have hS {T : H →L[ℂ] H} (hT : T ∈ M) : Set.MapsTo T S S := by
    refine fun x hx => (show S.map (T : H →ₗ[ℂ] H) ≤ S from ?_) ⟨x, hx, rfl⟩
    rw [Submodule.map_span]
    refine Submodule.span_mono ?_
    rintro _ ⟨_, ⟨b, hb, rfl⟩, rfl⟩
    exact ⟨T * b, M.mul_mem hT hb, rfl⟩
  have hW {T : H →L[ℂ] H} (hT : T ∈ M) : Set.MapsTo T W W := by
    simpa [W, Submodule.topologicalClosure_coe] using (hS hT).closure T.continuous
  have : Small.{max u v} A := small_max.{u} A
  have : Small.{max u v} G := small_lift.{u, v} G
  have : Small.{max u v} (M : Set (H →L[ℂ] H)) := by
    have : Small.{max u v} (FreeMonoid ↥(Set.range P.coefficient ∪ Set.range P.group)) :=
      small_map FreeMonoid.toListEquiv
    rw [show M = _ from Submonoid.closure_eq_mrange _, MonoidHom.coe_mrange]
    exact small_range _
  have : Small.{max u v} S := Submodule.small_span _
  have : Small.{max u v} (W : Set H) := by
    rw [Submodule.topologicalClosure_coe]
    exact TauCeti.small_closure _
  have : Small.{max u v} W := this
  obtain ⟨ι, ⟨b⟩⟩ := TauCeti.exists_hilbertBasis_of_small.{max u v} ℂ W
  let V := W.subtypeₗᵢ.comp b.repr.symm.toLinearIsometry
  have hV : Set.range V = W := by
    simp [V, Set.range_comp, b.repr.symm.surjective.range_eq]
  refine ⟨lp (fun _ : ι => ℂ) 2, inferInstance, inferInstance, inferInstance, V, fun a => ?_,
    fun g => ?_, ?_⟩
  all_goals rw [hV]
  · simpa using hW (Submonoid.subset_closure (Or.inl ⟨a, rfl⟩))
  · simpa using hW (Submonoid.subset_closure (Or.inr ⟨g, rfl⟩))
  · exact S.le_topologicalClosure (Submodule.subset_span ⟨1, M.one_mem, rfl⟩)

end TauCeti.CStarAction.CovariantRepresentation
