module

public import TauCeti.Analysis.CStarAlgebra.Action.Covariant.Basic
public import TauCeti.Analysis.VonNeumannAlgebra.Adjoin
import TauCeti.RepresentationTheory.Continuous.Unitary.StronglyContinuous

/-!
# The von Neumann algebra of a covariant representation and the implemented action

Let `(π, U)` be a covariant representation of a point-norm continuous action `α` of `G` on a
possibly nonunital C⋆-algebra `A`. Its von Neumann algebra is the double commutant
`M = π(A)''`, `CovariantRepresentation.vonNeumannAlgebra`, as a Mathlib `VonNeumannAlgebra`.
Covariance says `U_g π(a) U_g⁻¹ = π(α_g a)`, so conjugation by the unitary `U_g` maps `π(A)` onto
itself, and therefore maps `M` into itself. This gives the action
`CovariantRepresentation.vonNeumannAction : G →* (M ≃⋆ₐ[ℂ] M)`,
`τ̄_g(x) = U_g x U_g⁻¹`, which extends `α` along `π`
(`CovariantRepresentation.vonNeumannAction_coefficient`). Its orbits are continuous for the
strong operator topology: `g ↦ τ̄_g(x) v` is norm continuous for every `x ∈ M` and every vector
`v` (`CovariantRepresentation.continuous_vonNeumannAction_apply_apply`). Since each `τ̄_g` is a
star map, the same holds for `g ↦ τ̄_g(x)⋆ v`.

Each `τ̄_g` is implemented by a unitary, which is the source of its normality. The σ-weak
topology is not available in Mathlib, so normality itself is not stated here.

Applied to the GNS covariant representation `CStarAction.gnsCovariantRepresentation` of an
invariant state `ω`, for example a β-KMS state with `β ≠ 0`, this is the extension of the
dynamics to the GNS von Neumann algebra `π_ω(A)''`.

## References

Bratteli–Robinson, *Operator Algebras and Quantum Statistical Mechanics 1*, second edition,
Corollary 2.3.17, and volume 2, Section 5.3.1, for the extension of an invariant state's dynamics
to the weak closure of its GNS representation.
-/

public section

namespace TauCeti.CStarAction.CovariantRepresentation

variable {G A H : Type*} [Group G] [TopologicalSpace G] [NonUnitalCStarAlgebra A]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] {α : CStarAction G A}
  (P : CovariantRepresentation α H)

/-- The von Neumann algebra `π(A)''` of a covariant pair: the von Neumann algebra generated by
the range of its coefficient representation. -/
noncomputable def vonNeumannAlgebra : VonNeumannAlgebra H :=
  .adjoin (Set.range P.coefficient)

/-- The von Neumann algebra of a covariant pair is the double commutant of the range of its
coefficient representation. -/
theorem coe_vonNeumannAlgebra :
    (P.vonNeumannAlgebra : Set (H →L[ℂ] H)) =
      (Set.range P.coefficient).centralizer.centralizer := by
  rw [vonNeumannAlgebra, VonNeumannAlgebra.coe_adjoin, ← NonUnitalStarAlgHom.coe_range,
    StarMemClass.star_coe_eq, Set.union_self]

/-- Every coefficient operator lies in the von Neumann algebra of the covariant pair. -/
theorem coefficient_mem_vonNeumannAlgebra (a : A) : P.coefficient a ∈ P.vonNeumannAlgebra :=
  VonNeumannAlgebra.subset_adjoin _ ⟨a, rfl⟩

/-- The von Neumann algebra of a covariant pair is the smallest von Neumann algebra containing
every coefficient operator. -/
theorem vonNeumannAlgebra_le_iff {M : VonNeumannAlgebra H} :
    P.vonNeumannAlgebra ≤ M ↔ ∀ a, P.coefficient a ∈ M :=
  VonNeumannAlgebra.adjoin_le_iff.trans Set.range_subset_iff

/-- The adjoint of a group operator is the operator of the inverse group element. -/
private theorem star_group (g : G) : star (P.group g) = P.group g⁻¹ := by
  rw [ContinuousLinearMap.star_eq_adjoint, P.isUnitary.adjoint_eq_inv]

private theorem group_inv_mul_cancel_left (g : G) (x : H →L[ℂ] H) :
    P.group g⁻¹ * (P.group g * x) = x := by
  rw [← mul_assoc, ← map_mul, inv_mul_cancel, map_one, one_mul]

private theorem group_mul_inv_cancel_left (g : G) (x : H →L[ℂ] H) :
    P.group g * (P.group g⁻¹ * x) = x := by
  rw [← mul_assoc, ← map_mul, mul_inv_cancel, map_one, one_mul]

/-- Conjugation by a group operator preserves the von Neumann algebra of a covariant pair. -/
theorem group_mul_mul_group_inv_mem_vonNeumannAlgebra (g : G) {x : H →L[ℂ] H}
    (hx : x ∈ P.vonNeumannAlgebra) :
    P.group g * x * P.group g⁻¹ ∈ P.vonNeumannAlgebra := by
  rw [← P.star_group]
  refine VonNeumannAlgebra.conj_mem_adjoin (P.isUnitary.mem_unitary g) ?_ hx
  rintro _ ⟨a, rfl⟩
  exact ⟨α g a, by rw [P.star_group, P.coefficient_action]⟩

/-- The action of `G` on the von Neumann algebra `π(A)''` of a covariant pair implemented by its
unitary group: `τ̄_g(x) = U_g x U_g⁻¹`. It extends the C⋆-action along the coefficient
representation, `CovariantRepresentation.vonNeumannAction_coefficient`. -/
noncomputable def vonNeumannAction :
    G →* (P.vonNeumannAlgebra.toStarSubalgebra ≃⋆ₐ[ℂ] P.vonNeumannAlgebra.toStarSubalgebra) where
  toFun g :=
    { toFun x := ⟨P.group g * x * P.group g⁻¹,
        P.group_mul_mul_group_inv_mem_vonNeumannAlgebra g x.2⟩
      invFun x := ⟨P.group g⁻¹ * x * P.group g, by
        simpa using P.group_mul_mul_group_inv_mem_vonNeumannAlgebra g⁻¹ x.2⟩
      left_inv x := Subtype.ext <| by
        simp [mul_assoc, P.group_inv_mul_cancel_left, ← map_mul]
      right_inv x := Subtype.ext <| by
        simp [mul_assoc, P.group_mul_inv_cancel_left, ← map_mul]
      map_mul' x y := Subtype.ext <| by
        simp [mul_assoc, P.group_inv_mul_cancel_left]
      map_add' x y := Subtype.ext <| by
        simp [mul_add, add_mul]
      map_star' x := Subtype.ext <| by
        simp [star_mul, mul_assoc, P.star_group]
      map_smul' c x := Subtype.ext <| by
        simp }
  map_one' := by
    ext x
    simp
  map_mul' g h := by
    ext x
    simp [mul_assoc]

/-- The implemented action conjugates by the group operators. -/
@[simp]
theorem coe_vonNeumannAction_apply (g : G) (x : P.vonNeumannAlgebra.toStarSubalgebra) :
    (P.vonNeumannAction g x : H →L[ℂ] H) = P.group g * x * P.group g⁻¹ :=
  (rfl)

/-- The implemented action extends the C⋆-action: `τ̄_g(π(a)) = π(α_g a)`. -/
theorem vonNeumannAction_coefficient (g : G) (a : A) :
    P.vonNeumannAction g ⟨P.coefficient a, P.coefficient_mem_vonNeumannAlgebra a⟩ =
      ⟨P.coefficient (α g a), P.coefficient_mem_vonNeumannAlgebra (α g a)⟩ :=
  Subtype.ext (P.coefficient_action g a).symm

/-- The implemented action is continuous for the strong operator topology: for every `x` in
`π(A)''` and every vector `v`, the orbit `g ↦ τ̄_g(x) v` is norm continuous. Continuity of inversion
in `G` is not needed. -/
theorem continuous_vonNeumannAction_apply_apply (x : P.vonNeumannAlgebra.toStarSubalgebra)
    (v : H) : Continuous fun g => (P.vonNeumannAction g x : H →L[ℂ] H) v := by
  simp only [coe_vonNeumannAction_apply, mul_apply_eq_comp]
  exact (P.isUnitary.continuous_apply_prod P.continuous_orbit).comp
    (continuous_id.prodMk ((x : H →L[ℂ] H).continuous.comp
      (P.isUnitary.continuous_inv_apply P.continuous_orbit v)))

end TauCeti.CStarAction.CovariantRepresentation
