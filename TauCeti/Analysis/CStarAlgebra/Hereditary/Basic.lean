section Predicate

/-- A subset-like object `s` of an ordered type with zero is *hereditary* if `0 ≤ a ≤ b` and
`b ∈ s` imply `a ∈ s`. -/
def IsHereditary {S α : Type*} [SetLike S α] [Zero α] [LE α] (s : S) : Prop :=
  ∀ ⦃a b : α⦄, 0 ≤ a → a ≤ b → b ∈ s → a ∈ s

theorem isHereditary_def {S α : Type*} [SetLike S α] [Zero α] [LE α] {s : S} :
    IsHereditary s ↔ ∀ ⦃a b : α⦄, 0 ≤ a → a ≤ b → b ∈ s → a ∈ s :=
  Iff.rfl

theorem IsHereditary.mem_of_le {S α : Type*} [SetLike S α] [Zero α] [LE α] {s : S}
    (hs : IsHereditary s) {a b : α} (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ∈ s) : a ∈ s :=
  hs ha hab hb

theorem isHereditary_congr {S₁ S₂ α : Type*} [SetLike S₁ α] [SetLike S₂ α] [Zero α] [LE α]
    {s₁ : S₁} {s₂ : S₂} (h : (s₁ : Set α) = (s₂ : Set α)) :
    IsHereditary s₁ ↔ IsHereditary s₂ := by
  simp only [isHereditary_def, ← SetLike.mem_coe, h]

/-- Every order-connected subset containing `0` is hereditary. -/
theorem IsHereditary.of_ordConnected {S α : Type*} [SetLike S α] [Zero α] [Preorder α]
    [ZeroMemClass S α] {s : S} (h : (s : Set α).OrdConnected) : IsHereditary s :=
  fun _ _ ha hab hb => h.out (zero_mem s) hb ⟨ha, hab⟩

/-- For an additive subgroup of an ordered additive group, heredity coincides with order
connectedness. -/
theorem isHereditary_iff_ordConnected {S α : Type*} [SetLike S α] [AddCommGroup α]
    [PartialOrder α] [IsOrderedAddMonoid α] [AddSubgroupClass S α] {s : S} :
    IsHereditary s ↔ (s : Set α).OrdConnected := by
  refine ⟨fun hs => ⟨fun x hx y hy z hz => ?_⟩, fun h => IsHereditary.of_ordConnected (s := s) h⟩
  rw [SetLike.mem_coe] at hx hy ⊢
  have hsub : z - x ∈ s :=
    hs (sub_nonneg.mpr hz.1) (sub_le_sub_right hz.2 x) (sub_mem hy hx)
  simpa only [sub_add_cancel] using add_mem hsub hx

/-- For a subset containing `0` and consisting of nonnegative elements, heredity coincides with
order connectedness. -/
theorem isHereditary_iff_ordConnected_of_nonneg {S α : Type*} [SetLike S α] [Zero α] [Preorder α]
    [ZeroMemClass S α] {s : S} (hnonneg : ∀ x ∈ s, 0 ≤ x) :
    IsHereditary s ↔ (s : Set α).OrdConnected :=
  ⟨fun hs => ⟨fun _ hx _ hy _ hz => hs ((hnonneg _ hx).trans hz.1) hz.2 hy⟩,
    fun h => IsHereditary.of_ordConnected (s := s) h⟩

end Predicate

section Sandwich

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- If `B` is a hereditary `⋆`-subalgebra (not necessarily closed), `b ∈ B`, and `0 ≤ a`, then
`star b * a * b ∈ B`. -/
private theorem star_mul_mul_mem_of_isHereditary_of_nonneg {B : NonUnitalStarSubalgebra ℂ A}
    (hB : IsHereditary B) {b : A} (hb : b ∈ B) {a : A} (ha : 0 ≤ a) :
    star b * a * b ∈ B := by
  have ha_inr : (0 : A⁺¹) ≤ (a : A⁺¹) := Unitization.inr_nonneg_iff.mpr ha
  have hbound : (a : A⁺¹) ≤ algebraMap ℝ A⁺¹ ‖(a : A⁺¹)‖ :=
    ha_inr.isSelfAdjoint.le_algebraMap_norm_self
  have hconj := star_left_conjugate_le_conjugate hbound (b : A⁺¹)
  have hrhs : star (b : A⁺¹) * algebraMap ℝ A⁺¹ ‖(a : A⁺¹)‖ * (b : A⁺¹) =
      ((‖a‖ • (star b * b) : A) : A⁺¹) := by
    rw [Unitization.norm_inr, Algebra.algebraMap_eq_smul_one, mul_smul_comm, mul_one,
      smul_mul_assoc, ← Unitization.inr_star, ← Unitization.inr_mul, ← Unitization.inr_smul]
  have hle : star b * a * b ≤ ‖a‖ • (star b * b) := by
    rw [← Unitization.inr_le_inr_iff]
    simpa only [Unitization.inr_mul, Unitization.inr_star, hrhs] using hconj
  have hmem : (‖a‖ : ℂ) • (star b * b) ∈ B :=
    SMulMemClass.smul_mem (‖a‖ : ℂ) (mul_mem (star_mem hb) hb)
  exact hB (star_left_conjugate_nonneg ha b) (by simpa only [Complex.coe_smul] using hle)
    (by simpa only [Complex.coe_smul] using hmem)

/-- Every hereditary `⋆`-subalgebra `B` of a C⋆-algebra satisfies `B * A * B ⊆ B`, without any
closedness hypothesis on `B`. -/
theorem IsHereditary.mul_mem {B : NonUnitalStarSubalgebra ℂ A} (hB : IsHereditary B)
    {b₁ : A} (hb₁ : b₁ ∈ B) (a : A) {b₂ : A} (hb₂ : b₂ ∈ B) :
    b₁ * a * b₂ ∈ B := by
  -- Step 1: Decompose `a` into four positive elements so `z * a * star z ∈ B` for all `z ∈ B`.
  have hquad (z : A) (hz : z ∈ B) : z * a * star z ∈ B := by
    obtain ⟨c, hc, -, rfl⟩ := CStarAlgebra.exists_sum_four_nonneg a
    simp only [Finset.mul_sum, Finset.sum_mul, mul_smul_comm, smul_mul_assoc]
    refine sum_mem fun i _ => SMulMemClass.smul_mem _ ?_
    simpa only [star_star] using
      star_mul_mul_mem_of_isHereditary_of_nonneg hB (star_mem hz) (hc i)
  -- Step 2: Polarize `(x, y) ↦ x * a * star y` with `x = b₁` and `y = star b₂ ∈ B`.
  let y : A := star b₂
  have hy : y ∈ B := star_mem hb₂
  have hre : (b₁ + y) * a * star (b₁ + y) - (b₁ - y) * a * star (b₁ - y) =
      (2 : ℂ) • (b₁ * a * b₂ + y * a * star b₁) := by
    simp only [y, star_add, star_sub, star_star, add_mul, sub_mul, mul_add, mul_sub]
    rw [two_smul]
    abel
  have him : Complex.I • ((b₁ + Complex.I • y) * a * star (b₁ + Complex.I • y) -
        (b₁ - Complex.I • y) * a * star (b₁ - Complex.I • y)) =
      (2 : ℂ) • (b₁ * a * b₂ - y * a * star b₁) := by
    have hdiff : (b₁ + Complex.I • y) * a * star (b₁ + Complex.I • y) -
        (b₁ - Complex.I • y) * a * star (b₁ - Complex.I • y) =
        (-Complex.I) • ((2 : ℂ) • (b₁ * a * b₂ - y * a * star b₁)) := by
      simp only [y, star_add, star_sub, star_smul, star_star, Complex.star_def, Complex.conj_I,
        add_mul, sub_mul, mul_add, mul_sub, mul_neg, smul_mul_assoc, mul_smul_comm,
        neg_smul, smul_add, smul_sub, two_smul]
      abel
    rw [hdiff, smul_smul]
    norm_num [Complex.I_mul_I]
  have hpol : b₁ * a * b₂ = (4 : ℂ)⁻¹ •
      (((b₁ + y) * a * star (b₁ + y) - (b₁ - y) * a * star (b₁ - y)) +
        Complex.I • ((b₁ + Complex.I • y) * a * star (b₁ + Complex.I • y) -
          (b₁ - Complex.I • y) * a * star (b₁ - Complex.I • y))) := by
    rw [hre, him, ← smul_add, add_add_sub_cancel, ← two_smul ℂ (b₁ * a * b₂), smul_smul,
      smul_smul]
    norm_num
  rw [hpol]
  refine B.smul_mem _ (B.add_mem (B.sub_mem ?_ ?_) (B.smul_mem _ (B.sub_mem ?_ ?_)))
  · exact hquad _ (B.add_mem hb₁ hy)
  · exact hquad _ (B.sub_mem hb₁ hy)
  · exact hquad _ (B.add_mem hb₁ (B.smul_mem _ hy))
  · exact hquad _ (B.sub_mem hb₁ (B.smul_mem _ hy))

end Sandwich

