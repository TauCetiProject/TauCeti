section CStarAlgebra

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- The closed complex left ideal `{x : A | star x * x ∈ P}` attached to a closed hereditary cone
`P` in a C⋆-algebra `A`. -/
def leftIdeal (P : ProperCone ℝ A) (hP : IsHereditary P) : ClosedSubmodule ℂ A where
  carrier := {x : A | star x * x ∈ P}
  zero_mem' := by simp
  add_mem' {x y} hx hy := by
    have hpar : star (x + y) * (x + y) + star (x - y) * (x - y) =
        (2 : ℝ) • (star x * x + star y * y) := by
      rw [two_smul]
      simp only [star_add, star_sub, add_mul, sub_mul, mul_add, mul_sub]
      abel
    have hle : star (x + y) * (x + y) ≤ (2 : ℝ) • (star x * x + star y * y) := by
      rw [← hpar]
      exact le_add_of_nonneg_right (star_mul_self_nonneg (x - y))
    exact hP (star_mul_self_nonneg (x + y)) hle (P.smul_mem (add_mem hx hy) zero_le_two)
  smul_mem' c {x} hx := by
    have hsmul : star (c • x) * (c • x) = (‖c‖ ^ 2 : ℝ) • (star x * x) := by
      rw [star_smul, mul_smul_comm, smul_mul_assoc, smul_smul, Complex.star_def,
        Complex.mul_conj', ← Complex.ofReal_pow, Complex.coe_smul]
    rw [Set.mem_ofPred_eq, hsmul]
    exact P.smul_mem hx (sq_nonneg ‖c‖)
  isClosed' := P.isClosed.preimage (continuous_star.mul continuous_id)

@[simp, grind =]
theorem mem_leftIdeal {P : ProperCone ℝ A} {hP : IsHereditary P} {x : A} :
    x ∈ P.leftIdeal hP ↔ star x * x ∈ P :=
  Iff.rfl

@[simp]
theorem coe_leftIdeal (P : ProperCone ℝ A) (hP : IsHereditary P) :
    (P.leftIdeal hP : Set A) = {x : A | star x * x ∈ P} :=
  (rfl)

/-- `P.leftIdeal hP` absorbs left multiplication by arbitrary elements of `A`. -/
theorem mul_mem_leftIdeal (P : ProperCone ℝ A) (hP : IsHereditary P) (a : A) {x : A}
    (hx : x ∈ P.leftIdeal hP) : a * x ∈ P.leftIdeal hP := by
  rw [mem_leftIdeal] at hx ⊢
  have hle : star (a * x) * (a * x) ≤ (‖a‖ ^ 2 : ℝ) • (star x * x) := by
    calc
      star (a * x) * (a * x) = star x * (star a * a) * x := by simp only [star_mul, mul_assoc]
      _ ≤ ‖star a * a‖ • (star x * x) :=
        CStarAlgebra.star_left_conjugate_le_norm_smul x (star a * a)
      _ = (‖a‖ ^ 2 : ℝ) • (star x * x) := by rw [CStarRing.norm_star_mul_self, sq]
  exact hP (star_mul_self_nonneg _) hle (P.smul_mem hx (sq_nonneg ‖a‖))

/-- In a closed hereditary subcone `P` of `A₊`, `x ∈ P` implies `x * x ∈ P`. -/
theorem mul_self_mem_of_mem (P : ProperCone ℝ A) (hP₀ : P ≤ ProperCone.positive ℝ A)
    (hP : IsHereditary P) {x : A} (hx : x ∈ P) : x * x ∈ P := by
  have hx₀ : 0 ≤ x := hP₀ hx
  let s : A := CFC.sqrt x
  have hs₀ : 0 ≤ s := CFC.sqrt_nonneg x
  have hss : s * s = x := CFC.sqrt_mul_sqrt_self x hx₀
  have hle : x * x ≤ ‖x‖ • x := by
    calc
      x * x = (s * s) * (s * s) := by rw [← hss]
      _ = s * (s * s) * s := by simp only [mul_assoc]
      _ = star s * x * s := by rw [hs₀.isSelfAdjoint.star_eq, hss]
      _ ≤ ‖x‖ • (star s * s) := CStarAlgebra.star_left_conjugate_le_norm_smul s x hx₀.isSelfAdjoint
      _ = ‖x‖ • x := by rw [hs₀.isSelfAdjoint.star_eq, hss]
  have hsq₀ : 0 ≤ x * x := by
    simpa only [hx₀.isSelfAdjoint.star_eq] using star_mul_self_nonneg x
  exact hP hsq₀ hle (P.smul_mem hx (norm_nonneg x))

/-- In a closed hereditary cone `P`, if `0 ≤ x` and `x * x ∈ P`, then `x ∈ P`. -/
theorem mem_of_mul_self_mem (P : ProperCone ℝ A) (hP : IsHereditary P) {x : A}
    (hx₀ : 0 ≤ x) (hx : x * x ∈ P) : x ∈ P := by
  -- Truncate from below by `max 0 (t - 1/(n+1)) ≤ (4 / (n+1))⁻¹ * t ^ 2`.
  have _ : IsSelfAdjoint x := hx₀.isSelfAdjoint
  let ε : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  let F : ℕ → ℝ → ℝ := fun n t => max 0 (t - ε n)
  have hε_pos (n : ℕ) : 0 < ε n := Nat.one_div_pos_of_nat
  have hF_cont (n : ℕ) : Continuous (F n) :=
    continuous_const.max (continuous_id.sub continuous_const)
  have hF0 (n : ℕ) : F n 0 = 0 := max_eq_left (by linarith [hε_pos n])
  have hF_mem (n : ℕ) : cfcₙ (F n) x ∈ P := by
    have hdom (t : ℝ) : F n t ≤ (4 * ε n)⁻¹ * t ^ 2 := by
      refine max_le (by positivity) ?_
      rw [inv_mul_eq_div, le_div_iff₀' (by positivity)]
      nlinarith [sq_nonneg (t - 2 * ε n)]
    have hle : cfcₙ (F n) x ≤ (4 * ε n)⁻¹ • (x * x) := by
      have hsq_eq : (4 * ε n)⁻¹ • (x * x) = cfcₙ (fun t : ℝ => (4 * ε n)⁻¹ * t ^ 2) x := by
        rw [cfcₙ_const_mul (4 * ε n)⁻¹ (fun t : ℝ => t ^ 2) x]
        simp_rw [sq]
        rw [cfcₙ_mul (fun t : ℝ => t) (fun t : ℝ => t) x, cfcₙ_id' ℝ x]
      rw [hsq_eq]
      exact cfcₙ_mono (fun t _ => hdom t) (hF_cont n).continuousOn
        (hf0 := hF0 n)
    exact hP (cfcₙ_nonneg fun _ _ => le_max_left _ _) hle
      (P.smul_mem hx (inv_nonneg.mpr (by positivity)))
  have h_unif : TendstoUniformlyOn F id atTop (quasispectrum ℝ x) := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro δ hδ
    filter_upwards [(tendsto_order.mp tendsto_one_div_add_atTop_nhds_zero_nat).2 δ hδ]
      with n hn t ht
    have ht₀ : 0 ≤ t :=
      (StarOrderedRing.nonneg_iff_quasispectrum_nonneg (R := ℝ) x).mp hx₀ t ht
    have h_err : |t - F n t| ≤ ε n := by
      dsimp only [F]
      rcases le_total (t - ε n) 0 with hcase | hcase
      · rw [max_eq_left hcase, sub_zero, abs_of_nonneg ht₀]; linarith
      · rw [max_eq_right hcase, sub_sub_cancel, abs_of_pos (hε_pos n)]
    exact (dist_eq_norm _ _).trans_le h_err |>.trans_lt hn
  have hlim : Tendsto (fun n : ℕ => cfcₙ (F n) x) atTop (𝓝 x) := by
    simpa only [cfcₙ_id ℝ x] using tendsto_cfcₙ_fun h_unif
      (Eventually.of_forall fun n => (hF_cont n).continuousOn) (Eventually.of_forall hF0)
  exact P.isClosed.mem_of_tendsto hlim (Eventually.of_forall hF_mem)

/-- For a closed hereditary subcone `P` of `A₊` and `0 ≤ x`, `x * x ∈ P` if and only if `x ∈ P`. -/
theorem mul_self_mem_iff (P : ProperCone ℝ A) (hP₀ : P ≤ ProperCone.positive ℝ A)
    (hP : IsHereditary P) {x : A} (hx₀ : 0 ≤ x) :
    x * x ∈ P ↔ x ∈ P :=
  ⟨P.mem_of_mul_self_mem hP hx₀, P.mul_self_mem_of_mem hP₀ hP⟩

end CStarAlgebra

end ProperCone

namespace ClosedSubmodule

open TauCeti.CStarAlgebra

section CStarAlgebra

/-- For any closed complex left ideal `L` of a C⋆-algebra `A`, `star x * x ∈ L` implies `x ∈ L`. -/
theorem mem_of_star_mul_self_mem {A : Type*} [NonUnitalCStarAlgebra A]
    (L : ClosedSubmodule ℂ A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) {x : A}
    (hx : star x * x ∈ L) : x ∈ L := by
  let _ := CStarAlgebra.spectralOrder A
  have _ := CStarAlgebra.spectralOrderedRing A
  let B := L.starSubalgebra hL
  have : IsClosed (B : Set A) := L.isClosed_starSubalgebra hL
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  have hl : (CStarAlgebra.approximateUnit B).IsIncreasingApproximateUnit :=
    CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  have hmem : star x * x ∈ B :=
    L.mem_starSubalgebra.mpr ⟨hx, by rw [star_mul, star_star]; exact hx⟩
  refine L.isClosed.mem_of_tendsto (hl.tendsto_mul_of_star_mul_self_mem hmem) ?_
  exact Eventually.of_forall fun e => hL x (e : A) (L.mem_starSubalgebra.mp e.2).1

/-- For any closed complex left ideal `L` of a C⋆-algebra `A`, `star x * x ∈ L` if and only if
`x ∈ L`. -/
theorem star_mul_self_mem_iff {A : Type*} [NonUnitalCStarAlgebra A]
    (L : ClosedSubmodule ℂ A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) {x : A} :
    star x * x ∈ L ↔ x ∈ L :=
  ⟨L.mem_of_star_mul_self_mem hL, fun hx => hL (star x) x hx⟩

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- For any closed complex left ideal `L`, its self-adjoint core `L ∩ L⋆` is hereditary. -/
@[simp]
theorem isHereditary_starSubalgebra (L : ClosedSubmodule ℂ A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) :
    IsHereditary (L.starSubalgebra hL) := by
  refine (L.starSubalgebra hL).isHereditary_of_mul_mem fun b₁ hb₁ a b₂ hb₂ => ?_
  rw [L.mem_starSubalgebra] at hb₁ hb₂ ⊢
  refine ⟨hL (b₁ * a) b₂ hb₂.1, ?_⟩
  rw [star_mul, star_mul]
  exact hL (star b₂) (star a * star b₁) (hL (star a) (star b₁) hb₁.2)

/-- Every closed complex left ideal of a C⋆-algebra is hereditary in the spectral order. -/
theorem isHereditary_of_mul_mem (L : ClosedSubmodule ℂ A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) :
    IsHereditary L := fun _ _ ha hab hb =>
  (L.mem_starSubalgebra.mp <| (L.isHereditary_starSubalgebra hL) ha hab <|
    L.mem_starSubalgebra.mpr ⟨hb, by rwa [(ha.trans hab).isSelfAdjoint.star_eq]⟩).1

end CStarAlgebra

end ClosedSubmodule

namespace NonUnitalStarSubalgebra

open TauCeti.CStarAlgebra

section Correspondences

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- The closed cone `B₊ = {x ∈ B | 0 ≤ x}` of positive elements in a closed `⋆`-subalgebra `B`. -/
def positiveCone (B : NonUnitalStarSubalgebra ℂ A) [hB : IsClosed (B : Set A)] :
    ProperCone ℝ A where
  carrier := {x : A | x ∈ B ∧ 0 ≤ x}
  zero_mem' := ⟨zero_mem B, le_rfl⟩
  add_mem' hx hy := ⟨add_mem hx.1 hy.1, add_nonneg hx.2 hy.2⟩
  smul_mem' c {x} hx :=
    ⟨by
      have h : ((c : ℝ) : ℂ) • x ∈ B := SMulMemClass.smul_mem _ hx.1
      rwa [Complex.coe_smul] at h,
      smul_nonneg c.2 hx.2⟩
  isClosed' := hB.inter isClosed_Ici

@[simp, grind =]
theorem mem_positiveCone {B : NonUnitalStarSubalgebra ℂ A} [IsClosed (B : Set A)] {x : A} :
    x ∈ B.positiveCone ↔ x ∈ B ∧ 0 ≤ x :=
  Iff.rfl

@[simp]
theorem coe_positiveCone (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)] :
    (B.positiveCone : Set A) = (B : Set A) ∩ Set.Ici 0 :=
  (rfl)

theorem positiveCone_le_positive (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)] :
    B.positiveCone ≤ ProperCone.positive ℝ A :=
  fun _ hx => hx.2

theorem isHereditary_positiveCone {B : NonUnitalStarSubalgebra ℂ A} [IsClosed (B : Set A)]
    (hB : IsHereditary B) : IsHereditary B.positiveCone :=
  fun _ _ ha hab hb => ⟨hB ha hab hb.1, ha⟩

@[simp]
theorem isHereditary_positiveCone_iff {B : NonUnitalStarSubalgebra ℂ A} [IsClosed (B : Set A)] :
    IsHereditary B.positiveCone ↔ IsHereditary B :=
  ⟨fun h _ _ ha hab hb => (h ha hab ⟨hb, ha.trans hab⟩).1, B.isHereditary_positiveCone⟩

/-- The closed complex left ideal `{x : A | star x * x ∈ B}` attached to a closed hereditary
`⋆`-subalgebra `B`. -/
def closedLeftIdeal (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B) : ClosedSubmodule ℂ A :=
  B.positiveCone.leftIdeal (B.isHereditary_positiveCone hB)

@[simp, grind =]
theorem mem_closedLeftIdeal {B : NonUnitalStarSubalgebra ℂ A} [IsClosed (B : Set A)]
    {hB : IsHereditary B} {x : A} :
    x ∈ B.closedLeftIdeal hB ↔ star x * x ∈ B := by
  simp [closedLeftIdeal, star_mul_self_nonneg]

@[simp]
theorem coe_closedLeftIdeal (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B) :
    (B.closedLeftIdeal hB : Set A) = {x : A | star x * x ∈ B} := by
  ext x
  exact mem_closedLeftIdeal

theorem mul_mem_closedLeftIdeal (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B) (a : A) {x : A} (hx : x ∈ B.closedLeftIdeal hB) :
    a * x ∈ B.closedLeftIdeal hB :=
  B.positiveCone.mul_mem_leftIdeal (B.isHereditary_positiveCone hB) a hx

/-- **Cohen–Hewitt factorization for `star x * x ∈ B`** (Blackadar II.5.3.7): for any closed
`⋆`-subalgebra `B ⊆ A` (without assuming `B` hereditary) and any `x : A` with `star x * x ∈ B`,
`x` factors as `x = y * b` with `b ∈ B`, `‖b‖ ≤ 1`, and `y` in `closure (x · B)` within `ε` of
`x`. -/
theorem exists_mul_eq_of_star_mul_self_mem (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] {x : A} (hx : star x * x ∈ B) {ε : ℝ} (hε : 0 < ε) :
    ∃ b ∈ B, ∃ y : A,
      ‖b‖ ≤ 1 ∧ y ∈ closure (Set.range fun e : B => x * (e : A)) ∧ ‖y - x‖ < ε ∧ y * b = x := by
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  let l : Filter B := CStarAlgebra.approximateUnit B
  have hl : l.IsIncreasingApproximateUnit := CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  let ι : B →L[ℂ] A := B.toSubmodule.subtypeL
  let R : A →L[ℂ] B →L[ℂ] A := ((ContinuousLinearMap.mul ℂ A).flip.comp ι).flip
  have hR_assoc (z : A) (b₁ b₂ : B) : R (R z b₁) b₂ = R z (b₁ * b₂) := mul_assoc z b₁ b₂
  have hx_mem :
      x ∈ (Submodule.span ℂ (Set.range fun p : A × B => R p.1 p.2)).topologicalClosure := by
    rw [← SetLike.mem_coe, Submodule.topologicalClosure_coe]
    refine closure_mono Submodule.subset_span ?_
    exact mem_closure_of_tendsto (hl.tendsto_mul_of_star_mul_self_mem hx)
      (Eventually.of_forall fun e => ⟨(x, e), rfl⟩)
  obtain ⟨b, y, hb_norm, hy_mem, hy_dist, hfac⟩ :=
    ContinuousLinearMap.exists_apply_eq_of_mem_topologicalClosure_span_right R hR_assoc
      hl.eventually_norm hl.tendsto_mul_left hx_mem hε
  exact ⟨b, b.2, y, hb_norm, hy_mem, hy_dist, hfac⟩

/-- **Left-ideal factorization for hereditary C⋆-subalgebras** (Blackadar II.5.3.7): for a closed
hereditary `⋆`-subalgebra `B ⊆ A`, the closed left ideal `{x : A | star x * x ∈ B}` equals the
product set `Set.univ * (B : Set A)`. -/
theorem coe_closedLeftIdeal_eq_univ_mul (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : IsHereditary B) :
    (B.closedLeftIdeal hB : Set A) = Set.univ * (B : Set A) := by
  refine Set.Subset.antisymm (fun x hx => ?_) ?_
  · obtain ⟨b, hbB, y, -, -, -, hfac⟩ :=
      B.exists_mul_eq_of_star_mul_self_mem (mem_closedLeftIdeal.mp hx) one_pos
    exact ⟨y, trivial, b, hbB, hfac⟩
  · rintro _ ⟨a, -, b, hb, rfl⟩
    refine B.mul_mem_closedLeftIdeal hB a ?_
    rw [mem_closedLeftIdeal]
    exact mul_mem (star_mem hb) hb

@[simp]
theorem starSubalgebra_closedLeftIdeal (B : NonUnitalStarSubalgebra ℂ A)
    [hB_closed : IsClosed (B : Set A)] (hB : IsHereditary B) :
    (B.closedLeftIdeal hB).starSubalgebra (B.mul_mem_closedLeftIdeal hB) = B := by
  ext x
  simp only [ClosedSubmodule.mem_starSubalgebra, mem_closedLeftIdeal, star_star]
  refine ⟨fun ⟨hx₁, hx₂⟩ => ?_, fun hx =>
    ⟨mul_mem (star_mem hx) hx, mul_mem hx (star_mem hx)⟩⟩
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  let l : Filter B := CStarAlgebra.approximateUnit B
  have hl : l.IsIncreasingApproximateUnit := CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  have hsand : Tendsto (fun e : B => (e : A) * x * (e : A)) l (𝓝 x) :=
    TauCeti.tendsto_mul_mul_of_isBoundedUnder ⟨1, eventually_map.mpr hl.eventually_norm⟩
      (hl.tendsto_mul_of_mul_star_self_mem hx₂) (hl.tendsto_mul_of_star_mul_self_mem hx₁)
  exact hB_closed.mem_of_tendsto hsand (Eventually.of_forall fun e => hB.mul_mem e.2 x e.2)

@[simp]
theorem closedLeftIdeal_starSubalgebra (L : ClosedSubmodule ℂ A)
    (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) :
    (L.starSubalgebra hL).closedLeftIdeal (L.isHereditary_starSubalgebra hL) = L := by
  refine SetLike.ext fun x => ?_
  rw [mem_closedLeftIdeal, ClosedSubmodule.mem_starSubalgebra,
    and_iff_left_of_imp (fun h => by rw [star_mul, star_star]; exact h)]
  exact L.star_mul_self_mem_iff hL

@[simp]
theorem positiveCone_starSubalgebra_leftIdeal (P : ProperCone ℝ A)
    (hP₀ : P ≤ ProperCone.positive ℝ A) (hP : IsHereditary P) :
    ((P.leftIdeal hP).starSubalgebra (P.mul_mem_leftIdeal hP)).positiveCone = P := by
  ext x
  simp only [mem_positiveCone, ClosedSubmodule.mem_starSubalgebra, ProperCone.mem_leftIdeal]
  refine ⟨fun ⟨⟨hx₁, _⟩, hx₀⟩ => P.mem_of_mul_self_mem hP hx₀ ?_, fun hx => ?_⟩
  · rwa [hx₀.isSelfAdjoint.star_eq] at hx₁
  · have hx₀ : 0 ≤ x := hP₀ hx
    have hsq : x * x ∈ P := P.mul_self_mem_of_mem hP₀ hP hx
    simp only [hx₀.isSelfAdjoint.star_eq]
    exact ⟨⟨hsq, hsq⟩, hx₀⟩

end Correspondences

end NonUnitalStarSubalgebra

namespace TauCeti.CStarAlgebra

section OrderIsos

variable (A : Type*) [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- **Blackadar II.5.3.2 (left-ideal correspondence)**: order isomorphism between closed hereditary
`⋆`-subalgebras `B` of `A` and closed complex left ideals `L` of `A`, given by
`B ↦ {x : A | star x * x ∈ B}` and `L ↦ L ∩ star ⁻¹' L`. -/
def hereditarySubalgebraOrderIsoClosedLeftIdeal :
    {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B} ≃o
      {L : ClosedSubmodule ℂ A // ∀ a : A, ∀ x ∈ L, a * x ∈ L} :=
  OrderIso.ofHomInv
    { toFun := fun B => ⟨@NonUnitalStarSubalgebra.closedLeftIdeal A _ _ _ B.1 B.2.1 B.2.2,
        @NonUnitalStarSubalgebra.mul_mem_closedLeftIdeal A _ _ _ B.1 B.2.1 B.2.2⟩
      monotone' := fun B₁ B₂ h => by
        have := B₁.2.1
        have := B₂.2.1
        rw [Subtype.mk_le_mk]
        intro x hx
        exact NonUnitalStarSubalgebra.mem_closedLeftIdeal.mpr
          (h (NonUnitalStarSubalgebra.mem_closedLeftIdeal.mp hx)) }
    { toFun := fun L => ⟨L.1.starSubalgebra L.2, L.1.isClosed_starSubalgebra L.2,
        L.1.isHereditary_starSubalgebra L.2⟩
      monotone' := fun L₁ L₂ h => by
        rw [Subtype.mk_le_mk] at h ⊢
        intro x hx
        rw [ClosedSubmodule.mem_starSubalgebra] at hx ⊢
        exact ⟨h hx.1, h hx.2⟩ }
    (OrderHom.ext _ _ <| funext fun L => Subtype.ext <|
      NonUnitalStarSubalgebra.closedLeftIdeal_starSubalgebra L.1 L.2)
    (OrderHom.ext _ _ <| funext fun B => Subtype.ext <|
      @NonUnitalStarSubalgebra.starSubalgebra_closedLeftIdeal A _ _ _ B.1 B.2.1 B.2.2)

@[simp, grind =]
theorem mem_hereditarySubalgebraOrderIsoClosedLeftIdeal_apply
    (B : {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B}) {x : A} :
    x ∈ (hereditarySubalgebraOrderIsoClosedLeftIdeal A B).1 ↔ star x * x ∈ B.1 := by
  have := B.2.1
  exact B.1.mem_closedLeftIdeal (hB := B.2.2)

@[simp]
theorem coe_hereditarySubalgebraOrderIsoClosedLeftIdeal_apply
    (B : {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B}) :
    ((hereditarySubalgebraOrderIsoClosedLeftIdeal A B).1 : Set A) =
      {x : A | star x * x ∈ B.1} := by
  have := B.2.1
  exact B.1.coe_closedLeftIdeal B.2.2

@[simp]
theorem coe_hereditarySubalgebraOrderIsoClosedLeftIdeal_symm_apply
    (L : {L : ClosedSubmodule ℂ A // ∀ a : A, ∀ x ∈ L, a * x ∈ L}) :
    ((hereditarySubalgebraOrderIsoClosedLeftIdeal A).symm L).1 = L.1.starSubalgebra L.2 :=
  (rfl)

/-- **Blackadar II.5.3.2 (cone correspondence)**: order isomorphism between closed hereditary
`⋆`-subalgebras `B` of `A` and closed hereditary cones `P` in `A₊`, given by `B ↦ B ∩ A₊` and
`P ↦ {x : A | star x * x ∈ P ∧ x * star x ∈ P}`. -/
noncomputable def hereditarySubalgebraOrderIsoProperCone :
    {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B} ≃o
      {P : ProperCone ℝ A // P ≤ ProperCone.positive ℝ A ∧ IsHereditary P} :=
  OrderIso.ofHomInv
    { toFun := fun B => ⟨@NonUnitalStarSubalgebra.positiveCone A _ _ _ B.1 B.2.1,
        @NonUnitalStarSubalgebra.positiveCone_le_positive A _ _ _ B.1 B.2.1,
        @NonUnitalStarSubalgebra.isHereditary_positiveCone A _ _ _ B.1 B.2.1 B.2.2⟩
      monotone' := fun B₁ B₂ h => by
        have := B₁.2.1
        have := B₂.2.1
        rw [Subtype.mk_le_mk]
        intro x hx
        rw [NonUnitalStarSubalgebra.mem_positiveCone] at hx ⊢
        exact ⟨h hx.1, hx.2⟩ }
    { toFun := fun P => ⟨(P.1.leftIdeal P.2.2).starSubalgebra (P.1.mul_mem_leftIdeal P.2.2),
        (P.1.leftIdeal P.2.2).isClosed_starSubalgebra _,
        (P.1.leftIdeal P.2.2).isHereditary_starSubalgebra _⟩
      monotone' := fun P₁ P₂ h => by
        rw [Subtype.mk_le_mk] at h ⊢
        intro x hx
        rw [ClosedSubmodule.mem_starSubalgebra, ProperCone.mem_leftIdeal] at hx ⊢
        exact ⟨h hx.1, h hx.2⟩ }
    (OrderHom.ext _ _ <| funext fun P => Subtype.ext <|
      NonUnitalStarSubalgebra.positiveCone_starSubalgebra_leftIdeal P.1 P.2.1 P.2.2)
    (OrderHom.ext _ _ <| funext fun B => Subtype.ext <| by
      have := B.2.1
      exact B.1.starSubalgebra_closedLeftIdeal B.2.2)

@[simp, grind =]
theorem mem_hereditarySubalgebraOrderIsoProperCone_apply
    (B : {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B}) {x : A} :
    x ∈ (hereditarySubalgebraOrderIsoProperCone A B).1 ↔ x ∈ B.1 ∧ 0 ≤ x := by
  have := B.2.1
  exact B.1.mem_positiveCone

@[simp]
theorem coe_hereditarySubalgebraOrderIsoProperCone_apply
    (B : {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B}) :
    ((hereditarySubalgebraOrderIsoProperCone A B).1 : Set A) = (B.1 : Set A) ∩ Set.Ici 0 := by
  have := B.2.1
  exact B.1.coe_positiveCone

@[simp]
theorem coe_hereditarySubalgebraOrderIsoProperCone_symm_apply
    (P : {P : ProperCone ℝ A // P ≤ ProperCone.positive ℝ A ∧ IsHereditary P}) :
    ((hereditarySubalgebraOrderIsoProperCone A).symm P).1 =
      (P.1.leftIdeal P.2.2).starSubalgebra (P.1.mul_mem_leftIdeal P.2.2) :=
  (rfl)

end OrderIsos

end TauCeti.CStarAlgebra
