section Sandwich

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- A hereditary `⋆`-subalgebra `B` of a C⋆-algebra (not necessarily closed) contains
`star b * x * b` for every `b` with `star b * b ∈ B` (not necessarily `b ∈ B`) and every `x`. -/
theorem IsHereditary.star_mul_mul_mem_of_star_mul_self_mem {B : NonUnitalStarSubalgebra ℂ A}
    (hB : IsHereditary B) {b : A} (hbb : star b * b ∈ B) (x : A) : star b * x * b ∈ B := by
  obtain ⟨y, hy, -, rfl⟩ := CStarAlgebra.exists_sum_four_nonneg x
  -- Each `star b * y i * b` lies between `0` and `‖y i‖ • (star b * b) ∈ B`.
  have key (i : Fin 4) : star b * y i * b ∈ B := by
    refine hB.mem_of_le (star_left_conjugate_nonneg (hy i) b) ?_ ?_
      (b := (‖y i‖ : ℂ) • (star b * b))
    · simpa only [Complex.coe_smul] using
        CStarAlgebra.star_left_conjugate_le_norm_smul b (y i) (hy i).isSelfAdjoint
    · exact SMulMemClass.smul_mem _ hbb
  simp only [Finset.mul_sum, Finset.sum_mul, mul_smul_comm, smul_mul_assoc]
  exact sum_mem fun i _ ↦ SMulMemClass.smul_mem _ (key i)

/-- A hereditary `⋆`-subalgebra of a C⋆-algebra (not necessarily closed) contains `star b * x * b`
for every `b` in it and every `x`. -/
theorem IsHereditary.star_mul_mul_mem {B : NonUnitalStarSubalgebra ℂ A} (hB : IsHereditary B)
    {b : A} (hb : b ∈ B) (x : A) : star b * x * b ∈ B :=
  hB.star_mul_mul_mem_of_star_mul_self_mem (mul_mem (star_mem hb) hb) x

/-- Every hereditary `⋆`-subalgebra `B` of a C⋆-algebra satisfies `B * A * B ⊆ B`, without any
closedness hypothesis on `B`. -/
@[grind ←]
theorem IsHereditary.mul_mem {B : NonUnitalStarSubalgebra ℂ A} (hB : IsHereditary B)
    {b₁ : A} (hb₁ : b₁ ∈ B) (a : A) {b₂ : A} (hb₂ : b₂ ∈ B) :
    b₁ * a * b₂ ∈ B := by
  -- Polarize `(u, c) ↦ star u * a * c` with `u = star b₁ ∈ B` and `c = b₂`.
  have hu : star b₁ ∈ B := star_mem hb₁
  have h4 : b₁ * a * b₂ = (4 : ℂ)⁻¹ • ((4 : ℂ) • (star (star b₁) * a * b₂)) := by
    rw [star_star, smul_smul, inv_mul_cancel₀ (by norm_num), one_smul]
  rw [h4, star_mul_mul_polarization]
  refine SMulMemClass.smul_mem _ (sub_mem (sub_mem (add_mem ?_ ?_) ?_) ?_)
  · exact hB.star_mul_mul_mem (add_mem hb₂ hu) a
  · exact SMulMemClass.smul_mem _ <|
      hB.star_mul_mul_mem (add_mem hb₂ (SMulMemClass.smul_mem _ hu)) a
  · exact hB.star_mul_mul_mem (sub_mem hb₂ hu) a
  · exact SMulMemClass.smul_mem _ <|
      hB.star_mul_mul_mem (sub_mem hb₂ (SMulMemClass.smul_mem _ hu)) a

end Sandwich

end TauCeti

namespace NonUnitalStarSubalgebra

open TauCeti TauCeti.CStarAlgebra

section Hereditary

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- A closed `⋆`-subalgebra `B` containing `star b * x * b` for every `b ∈ B` and every `x` is
hereditary. Only this diagonal case of `B * A * B ⊆ B` is needed, since the approximate unit of `B`
is self-adjoint. -/
theorem isHereditary_of_star_mul_mul_mem (B : NonUnitalStarSubalgebra ℂ A)
    [hBc : IsClosed (B : Set A)] (h : ∀ b ∈ B, ∀ x : A, star b * x * b ∈ B) : IsHereditary B := by
  rw [isHereditary_def]
  intro a b ha hab hb
  obtain ⟨y, rfl⟩ := _root_.CStarAlgebra.nonneg_iff_eq_star_mul_self.mp ha
  obtain ⟨l, _, hlB, -, hsa, hnorm, hl⟩ := NonUnitalStarSubalgebra.exists_approximateUnit hBc
  -- A right approximate unit for `b` is one for `y`, hence for `star y * y` on both sides.
  have hr : Tendsto (star y * y * ·) l (𝓝 (star y * y)) := by
    simpa only [mul_assoc] using
      (TauCeti.CStarAlgebra.tendsto_mul_of_star_mul_self_le hsa hnorm hab
        (hl b hb).1).const_mul (star y)
  have hl' : Tendsto (· * (star y * y)) l (𝓝 (star y * y)) := by
    simpa only [star_mul, star_star] using TauCeti.tendsto_mul_star_of_tendsto_mul hsa hr
  -- The approximate unit is self-adjoint, so `e * (star y * y) * e = star e * (star y * y) * e`.
  exact hBc.mem_of_tendsto_mul
    ((hlB.and hsa).mono fun e he ↦ by
      simpa only [he.2.star_eq, SetLike.mem_coe] using h e he.1 (star y * y))
    (isBoundedUnder_of_eventually_le hnorm) hr hl'

/-- A closed `⋆`-subalgebra `B` satisfying `B * A * B ⊆ B` is hereditary. -/
theorem isHereditary_of_mul_mem (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hmul : ∀ b₁ ∈ B, ∀ a : A, ∀ b₂ ∈ B, b₁ * a * b₂ ∈ B) :
    IsHereditary B :=
  B.isHereditary_of_star_mul_mul_mem fun _ hb x ↦ hmul _ (star_mem hb) x _ hb

/-- **Sandwich characterization of hereditary C⋆-subalgebras** (Blackadar II.5.3.2): a closed
`⋆`-subalgebra `B ⊆ A` is hereditary if and only if `B * A * B ⊆ B`. -/
theorem isHereditary_iff_mul_mem (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)] :
    IsHereditary B ↔ ∀ b₁ ∈ B, ∀ a : A, ∀ b₂ ∈ B, b₁ * a * b₂ ∈ B :=
  ⟨fun h _ hb₁ a _ hb₂ => h.mul_mem hb₁ a hb₂, B.isHereditary_of_mul_mem⟩

/-- For any `a`, not necessarily self-adjoint, the closure of the `⋆`-subalgebra
`star a * A * a` is hereditary. -/
theorem isHereditary_topologicalClosure_starMulMul (a : A) :
    IsHereditary (starMulMul (R := ℂ) a).topologicalClosure := by
  have := isClosed_topologicalClosure (starMulMul (R := ℂ) a)
  refine isHereditary_of_star_mul_mul_mem _ fun b hb x ↦ ?_
  rw [← SetLike.mem_coe, topologicalClosure_coe, coe_starMulMul] at hb ⊢
  refine map_mem_closure (f := fun b ↦ star b * x * b) (by fun_prop) hb ?_
  rintro _ ⟨y, rfl⟩
  exact ⟨star y * a * x * star a * y, by simp only [star_mul, star_star]; noncomm_ring⟩

/-- A closed hereditary `⋆`-subalgebra containing `a` contains the closure of `star a * A * a`. -/
theorem topologicalClosure_starMulMul_le {B : NonUnitalStarSubalgebra ℂ A}
    [hBc : IsClosed (B : Set A)] (hB : IsHereditary B) {a : A} (ha : a ∈ B) :
    (starMulMul (R := ℂ) a).topologicalClosure ≤ B :=
  topologicalClosure_minimal _ (fun _ hy ↦ by
    obtain ⟨x, rfl⟩ := mem_starMulMul.mp hy
    exact hB.mul_mem (star_mem ha) x ha) hBc

end Hereditary

end NonUnitalStarSubalgebra

namespace TauCeti.CStarAlgebra

section Generated

variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- The algebraic corner `{a * x * a | x : A}` associated to a self-adjoint element `a`, bundled as
a nonunital `⋆`-subalgebra before taking norm closure. -/
private def cornerSubalgebra (a : A) (ha : IsSelfAdjoint a) : NonUnitalStarSubalgebra ℂ A where
  carrier := Set.range fun x : A => a * x * a
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x * a * a * y, by simp only [mul_assoc]⟩
  add_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x + y, by simp only [mul_add, add_mul]⟩
  zero_mem' := ⟨0, by simp⟩
  smul_mem' := by
    rintro c _ ⟨x, rfl⟩
    exact ⟨c • x, by simp only [mul_smul_comm, smul_mul_assoc]⟩
  star_mem' := by
    rintro _ ⟨x, rfl⟩
    exact ⟨star x, by simp only [star_mul, ha.star_eq, mul_assoc]⟩

/-- The closed hereditary `⋆`-subalgebra `closure {a * x * a | x : A}` generated by a self-adjoint
(in particular, positive) element `a` of a C⋆-algebra `A`. -/
def hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    NonUnitalStarSubalgebra ℂ A :=
  (cornerSubalgebra a ha).topologicalClosure

@[simp]
theorem coe_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    (hereditarySubalgebra a ha : Set A) = closure (Set.range fun x : A => a * x * a) := by
  rw [hereditarySubalgebra, NonUnitalStarSubalgebra.topologicalClosure_coe]
  rfl

theorem mem_hereditarySubalgebra {a y : A} {ha : IsSelfAdjoint a} :
    y ∈ hereditarySubalgebra a ha ↔ y ∈ closure (Set.range fun x : A => a * x * a) := by
  rw [← SetLike.mem_coe, coe_hereditarySubalgebra a ha]

instance isClosed_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    IsClosed (hereditarySubalgebra a ha : Set A) :=
  NonUnitalStarSubalgebra.isClosed_topologicalClosure _

@[simp, grind .]
theorem mul_self_mem_hereditarySubalgebra (a x : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    a * x * a ∈ hereditarySubalgebra a ha :=
  mem_hereditarySubalgebra.mpr (subset_closure ⟨x, rfl⟩)

/-- Every self-adjoint element `a` belongs to the hereditary C⋆-subalgebra `closure(aAa)` that it
generates. -/
@[simp, grind .]
theorem self_mem_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    a ∈ hereditarySubalgebra a ha := by
  -- Approximate `id` uniformly on `ℝ` by `F n t = t * (t / (t ^ 2 + ε n)) * t`.
  rw [mem_hereditarySubalgebra]
  let ε : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  let g : ℕ → ℝ → ℝ := fun n t => t / (t ^ 2 + ε n)
  let F : ℕ → ℝ → ℝ := fun n t => t * g n t * t
  have hε_pos (n : ℕ) : 0 < ε n := Nat.one_div_pos_of_nat
  have hg_cont (n : ℕ) : Continuous (g n) :=
    continuous_id.div (continuous_id.pow 2 |>.add continuous_const) fun t => by
      linarith [sq_nonneg t, hε_pos n]
  have hF_cont (n : ℕ) : Continuous (F n) := (continuous_id.mul (hg_cont n)).mul continuous_id
  have h_unif : TendstoUniformlyOn F id atTop (quasispectrum ℝ a) := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro δ hδ
    have hsqrt_lim : Tendsto (fun n : ℕ => Real.sqrt (ε n) / 2) atTop (𝓝 0) := by
      simpa [ε] using ((Real.continuous_sqrt.tendsto 0).comp
        tendsto_one_div_add_atTop_nhds_zero_nat).div_const 2
    filter_upwards [(tendsto_order.mp hsqrt_lim).2 δ hδ] with n hn t _
    have hpos : 0 < t ^ 2 + ε n := by linarith [sq_nonneg t, hε_pos n]
    have hbound : |t - F n t| ≤ Real.sqrt (ε n) / 2 := by
      have hdiff : t - F n t = t * ε n / (t ^ 2 + ε n) := by
        dsimp only [F, g]; field_simp [hpos.ne']; ring
      rw [hdiff, abs_div, abs_mul, abs_of_pos (hε_pos n), abs_of_pos hpos,
        div_le_div_iff₀ hpos two_pos]
      have h_amgm : 2 * |t| * Real.sqrt (ε n) ≤ t ^ 2 + ε n := by
        nlinarith [sq_abs t, sq_nonneg (|t| - Real.sqrt (ε n)), Real.sq_sqrt (hε_pos n).le]
      calc
        |t| * ε n * 2 = (2 * |t| * Real.sqrt (ε n)) * Real.sqrt (ε n) := by
          conv_lhs => rw [← Real.sq_sqrt (hε_pos n).le]
          ring
        _ ≤ Real.sqrt (ε n) * (t ^ 2 + ε n) := by
          rw [mul_comm]
          exact mul_le_mul_of_nonneg_left h_amgm (Real.sqrt_nonneg _)
    exact (dist_eq_norm _ _).trans_le hbound |>.trans_lt hn
  -- Apply `cfcₙ` continuity and factor `cfcₙ (F n) a = a * cfcₙ (g n) a * a`.
  have hlim : Tendsto (fun n : ℕ => cfcₙ (F n) a) atTop (𝓝 a) := by
    simpa only [cfcₙ_id ℝ a] using tendsto_cfcₙ_fun h_unif
      (Eventually.of_forall fun n => (hF_cont n).continuousOn)
      (Eventually.of_forall fun n => by simp [F, g])
  refine mem_closure_of_tendsto hlim (Eventually.of_forall fun n => ⟨cfcₙ (g n) a, ?_⟩)
  symm
  dsimp only [F]
  rw [cfcₙ_mul (fun t : ℝ => t * g n t) (fun t : ℝ => t) a
      ((continuous_id.mul (hg_cont n)).continuousOn) (by simp [g]),
    cfcₙ_mul (fun t : ℝ => t) (g n) a (hg := (hg_cont n).continuousOn) (hg0 := by simp [g]),
    cfcₙ_id' ℝ a]

@[simp]
theorem hereditarySubalgebra_zero : hereditarySubalgebra (0 : A) = ⊥ := by
  rw [← SetLike.coe_set_eq, coe_hereditarySubalgebra 0 (IsSelfAdjoint.zero A),
    NonUnitalStarAlgebra.coe_bot]
  have hrange : (Set.range fun x : A => (0 : A) * x * 0) = {0} :=
    Set.Subset.antisymm (by rintro _ ⟨_, rfl⟩; simp) (by rintro _ rfl; exact ⟨0, by simp⟩)
  rw [hrange, closure_singleton]

@[simp]
theorem hereditarySubalgebra_eq_bot_iff {a : A} {ha : IsSelfAdjoint a} :
    hereditarySubalgebra a ha = ⊥ ↔ a = 0 :=
  ⟨fun h => NonUnitalStarAlgebra.mem_bot.mp (h ▸ self_mem_hereditarySubalgebra a ha),
    by rintro rfl; exact hereditarySubalgebra_zero⟩

@[simp]
theorem hereditarySubalgebra_one {A : Type*} [CStarAlgebra A] :
    hereditarySubalgebra (1 : A) = ⊤ := by
  ext x
  simp only [NonUnitalStarAlgebra.mem_top, iff_true]
  simpa using mul_self_mem_hereditarySubalgebra (1 : A) x

variable [PartialOrder A] [StarOrderedRing A]

/-- The closed subalgebra `hereditarySubalgebra a` is hereditary. -/
@[simp]
theorem isHereditary_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    IsHereditary (hereditarySubalgebra a ha) := by
  refine (hereditarySubalgebra a ha).isHereditary_of_mul_mem fun b₁ hb₁ z b₂ hb₂ => ?_
  rw [mem_hereditarySubalgebra] at hb₁ hb₂ ⊢
  refine map_mem_closure₂ (f := fun x y => x * z * y)
    ((continuous_fst.mul continuous_const).mul continuous_snd) hb₁ hb₂ ?_
  rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
  exact ⟨x * a * z * a * y, by simp only [mul_assoc]⟩

/-- **Universal property of `hereditarySubalgebra`**: for any closed hereditary `⋆`-subalgebra `B`,
`hereditarySubalgebra a ≤ B` if and only if `a ∈ B`. -/
@[simp, grind =]
theorem hereditarySubalgebra_le_iff {a : A} {ha : IsSelfAdjoint a}
    {B : NonUnitalStarSubalgebra ℂ A} [hB_closed : IsClosed (B : Set A)] (hB : IsHereditary B) :
    hereditarySubalgebra a ha ≤ B ↔ a ∈ B := by
  refine ⟨fun h => h (self_mem_hereditarySubalgebra a ha), fun haB => ?_⟩
  rw [← SetLike.coe_subset_coe, coe_hereditarySubalgebra a ha]
  refine closure_minimal ?_ hB_closed
  rintro _ ⟨x, rfl⟩
  exact hB.mul_mem haB x haB

end Generated

end TauCeti.CStarAlgebra

/-! ### Correspondences between hereditary subalgebras, left ideals, and hereditary cones -/

namespace ProperCone

open TauCeti

section CStarAlgebra

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- The closed complex left ideal `{x : A | star x * x ∈ P}` attached to a closed hereditary cone
`P` in a C⋆-algebra `A`. -/
def leftIdeal (P : ProperCone ℝ A) (hP : IsHereditary P) : ClosedSubmodule ℂ A where
  carrier := {x : A | star x * x ∈ P}
  zero_mem' := by simp
  add_mem' {x y} hx hy := by
    have hpar : star (x + y) * (x + y) + star (x - y) * (x - y) =
        (2 : ℝ) • (star x * x + star y * y) := by
      rw [two_smul]
      simp only [star_add, star_sub, add_mul, sub_mul, mul_add, mul_sub]
      abel
    have hle : star (x + y) * (x + y) ≤ (2 : ℝ) • (star x * x + star y * y) := by
      rw [← hpar]
      exact le_add_of_nonneg_right (star_mul_self_nonneg (x - y))
    exact hP.mem_of_le (star_mul_self_nonneg (x + y)) hle (P.smul_mem (add_mem hx hy) zero_le_two)
  smul_mem' c {x} hx := by
    have hsmul : star (c • x) * (c • x) = (‖c‖ ^ 2 : ℝ) • (star x * x) := by
      rw [star_smul, mul_smul_comm, smul_mul_assoc, smul_smul, Complex.star_def,
        Complex.mul_conj', ← Complex.ofReal_pow, Complex.coe_smul]
    rw [Set.mem_ofPred_eq, hsmul]
    exact P.smul_mem hx (sq_nonneg ‖c‖)
  isClosed' := P.isClosed.preimage (continuous_star.mul continuous_id)

@[simp, grind =]
theorem mem_leftIdeal {P : ProperCone ℝ A} {hP : IsHereditary P} {x : A} :
    x ∈ P.leftIdeal hP ↔ star x * x ∈ P :=
  Iff.rfl

@[simp]
theorem coe_leftIdeal (P : ProperCone ℝ A) (hP : IsHereditary P) :
    (P.leftIdeal hP : Set A) = {x : A | star x * x ∈ P} :=
  (rfl)

/-- `P.leftIdeal hP` absorbs left multiplication by arbitrary elements of `A`. -/
theorem mul_mem_leftIdeal (P : ProperCone ℝ A) (hP : IsHereditary P) (a : A) {x : A}
    (hx : x ∈ P.leftIdeal hP) : a * x ∈ P.leftIdeal hP := by
  rw [mem_leftIdeal] at hx ⊢
  have hle : star (a * x) * (a * x) ≤ (‖a‖ ^ 2 : ℝ) • (star x * x) := by
    calc
      star (a * x) * (a * x) = star x * (star a * a) * x := by simp only [star_mul, mul_assoc]
      _ ≤ ‖star a * a‖ • (star x * x) :=
        CStarAlgebra.star_left_conjugate_le_norm_smul x (star a * a)
      _ = (‖a‖ ^ 2 : ℝ) • (star x * x) := by rw [CStarRing.norm_star_mul_self, sq]
  exact hP.mem_of_le (star_mul_self_nonneg _) hle (P.smul_mem hx (sq_nonneg ‖a‖))

/-- In a closed hereditary subcone `P` of `A₊`, `x ∈ P` implies `x * x ∈ P`. -/
theorem mul_self_mem_of_mem (P : ProperCone ℝ A) (hP₀ : P ≤ ProperCone.positive ℝ A)
    (hP : IsHereditary P) {x : A} (hx : x ∈ P) : x * x ∈ P := by
  have hx₀ : 0 ≤ x := hP₀ hx
  let s : A := CFC.sqrt x
  have hs₀ : 0 ≤ s := CFC.sqrt_nonneg x
  have hss : s * s = x := CFC.sqrt_mul_sqrt_self x hx₀
  have hle : x * x ≤ ‖x‖ • x := by
    calc
      x * x = (s * s) * (s * s) := by rw [← hss]
      _ = s * (s * s) * s := by simp only [mul_assoc]
      _ = star s * x * s := by rw [hs₀.isSelfAdjoint.star_eq, hss]
      _ ≤ ‖x‖ • (star s * s) := CStarAlgebra.star_left_conjugate_le_norm_smul s x hx₀.isSelfAdjoint
      _ = ‖x‖ • x := by rw [hs₀.isSelfAdjoint.star_eq, hss]
  have hsq₀ : 0 ≤ x * x := by
    simpa only [hx₀.isSelfAdjoint.star_eq] using star_mul_self_nonneg x
  exact hP.mem_of_le hsq₀ hle (P.smul_mem hx (norm_nonneg x))

/-- In a closed hereditary cone `P`, if `0 ≤ x` and `x * x ∈ P`, then `x ∈ P`. -/
theorem mem_of_mul_self_mem (P : ProperCone ℝ A) (hP : IsHereditary P) {x : A}
    (hx₀ : 0 ≤ x) (hx : x * x ∈ P) : x ∈ P := by
  -- Truncate from below by `max 0 (t - 1/(n+1)) ≤ (4 / (n+1))⁻¹ * t ^ 2`.
  have _ : IsSelfAdjoint x := hx₀.isSelfAdjoint
  let ε : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  let F : ℕ → ℝ → ℝ := fun n t => max 0 (t - ε n)
  have hε_pos (n : ℕ) : 0 < ε n := Nat.one_div_pos_of_nat
  have hF_cont (n : ℕ) : Continuous (F n) :=
    continuous_const.max (continuous_id.sub continuous_const)
  have hF0 (n : ℕ) : F n 0 = 0 := max_eq_left (by linarith [hε_pos n])
  have hF_mem (n : ℕ) : cfcₙ (F n) x ∈ P := by
    have hdom (t : ℝ) : F n t ≤ (4 * ε n)⁻¹ * t ^ 2 := by
      refine max_le (by positivity) ?_
      rw [inv_mul_eq_div, le_div_iff₀' (by positivity)]
      nlinarith [sq_nonneg (t - 2 * ε n)]
    have hle : cfcₙ (F n) x ≤ (4 * ε n)⁻¹ • (x * x) := by
      have hsq_eq : (4 * ε n)⁻¹ • (x * x) = cfcₙ (fun t : ℝ => (4 * ε n)⁻¹ * t ^ 2) x := by
        rw [cfcₙ_const_mul (4 * ε n)⁻¹ (fun t : ℝ => t ^ 2) x]
        simp_rw [sq]
        rw [cfcₙ_mul (fun t : ℝ => t) (fun t : ℝ => t) x, cfcₙ_id' ℝ x]
      rw [hsq_eq]
      exact cfcₙ_mono (fun t _ => hdom t) (hF_cont n).continuousOn
        (hf0 := hF0 n)
    exact hP.mem_of_le (cfcₙ_nonneg fun _ _ => le_max_left _ _) hle
      (P.smul_mem hx (inv_nonneg.mpr (by positivity)))
  have h_unif : TendstoUniformlyOn F id atTop (quasispectrum ℝ x) := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro δ hδ
    filter_upwards [(tendsto_order.mp tendsto_one_div_add_atTop_nhds_zero_nat).2 δ hδ]
      with n hn t ht
    have ht₀ : 0 ≤ t :=
      (StarOrderedRing.nonneg_iff_quasispectrum_nonneg (R := ℝ) x).mp hx₀ t ht
    have h_err : |t - F n t| ≤ ε n := by
      dsimp only [F]
      rcases le_total (t - ε n) 0 with hcase | hcase
      · rw [max_eq_left hcase, sub_zero, abs_of_nonneg ht₀]; linarith
      · rw [max_eq_right hcase, sub_sub_cancel, abs_of_pos (hε_pos n)]
    exact (dist_eq_norm _ _).trans_le h_err |>.trans_lt hn
  have hlim : Tendsto (fun n : ℕ => cfcₙ (F n) x) atTop (𝓝 x) := by
    simpa only [cfcₙ_id ℝ x] using tendsto_cfcₙ_fun h_unif
      (Eventually.of_forall fun n => (hF_cont n).continuousOn) (Eventually.of_forall hF0)
  exact P.isClosed.mem_of_tendsto hlim (Eventually.of_forall hF_mem)

/-- For a closed hereditary subcone `P` of `A₊` and `0 ≤ x`, `x * x ∈ P` if and only if `x ∈ P`. -/
theorem mul_self_mem_iff (P : ProperCone ℝ A) (hP₀ : P ≤ ProperCone.positive ℝ A)
    (hP : IsHereditary P) {x : A} (hx₀ : 0 ≤ x) :
    x * x ∈ P ↔ x ∈ P :=
  ⟨P.mem_of_mul_self_mem hP hx₀, P.mul_self_mem_of_mem hP₀ hP⟩

end CStarAlgebra

end ProperCone

namespace ClosedSubmodule

open TauCeti

section CStarAlgebra

/-- For any closed complex left ideal `L` of a C⋆-algebra `A`, `star x * x ∈ L` implies `x ∈ L`. -/
theorem mem_of_star_mul_self_mem {A : Type*} [NonUnitalCStarAlgebra A]
    (L : ClosedSubmodule ℂ A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) {x : A}
    (hx : star x * x ∈ L) : x ∈ L := by
  let _ := CStarAlgebra.spectralOrder A
  have _ := CStarAlgebra.spectralOrderedRing A
  let B := L.starSubalgebra hL
  have : IsClosed (B : Set A) := L.isClosed_starSubalgebra hL
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  have hl : (CStarAlgebra.approximateUnit B).IsIncreasingApproximateUnit :=
    CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  have hmem : star x * x ∈ B :=
    L.mem_starSubalgebra.mpr ⟨hx, by rw [star_mul, star_star]; exact hx⟩
  refine L.isClosed.mem_of_tendsto (hl.tendsto_mul_of_star_mul_self_mem hmem) ?_
  exact Eventually.of_forall fun e => hL x (e : A) (L.mem_starSubalgebra.mp e.property).1

/-- For any closed complex left ideal `L` of a C⋆-algebra `A`, `star x * x ∈ L` if and only if
`x ∈ L`. -/
theorem star_mul_self_mem_iff {A : Type*} [NonUnitalCStarAlgebra A]
    (L : ClosedSubmodule ℂ A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) {x : A} :
    star x * x ∈ L ↔ x ∈ L :=
  ⟨L.mem_of_star_mul_self_mem hL, fun hx => hL (star x) x hx⟩

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- For any closed complex left ideal `L`, its self-adjoint core `L ∩ L⋆` is hereditary. -/
@[simp]
theorem isHereditary_starSubalgebra (L : ClosedSubmodule ℂ A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) :
    IsHereditary (L.starSubalgebra hL) := by
  refine (L.starSubalgebra hL).isHereditary_of_mul_mem fun b₁ hb₁ a b₂ hb₂ => ?_
  rw [L.mem_starSubalgebra] at hb₁ hb₂ ⊢
  refine ⟨hL (b₁ * a) b₂ hb₂.1, ?_⟩
  rw [star_mul, star_mul]
  exact hL (star b₂) (star a * star b₁) (hL (star a) (star b₁) hb₁.2)

/-- Every closed complex left ideal of a C⋆-algebra is hereditary in the spectral order. -/
theorem isHereditary_of_mul_mem (L : ClosedSubmodule ℂ A) (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) :
    IsHereditary L := isHereditary_def.mpr fun _ _ ha hab hb =>
  (L.mem_starSubalgebra.mp <| (L.isHereditary_starSubalgebra hL).mem_of_le ha hab <|
    L.mem_starSubalgebra.mpr ⟨hb, by rwa [(ha.trans hab).isSelfAdjoint.star_eq]⟩).1

end CStarAlgebra

end ClosedSubmodule

namespace NonUnitalStarSubalgebra

open TauCeti

section Correspondences

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- The closed cone `B₊ = {x ∈ B | 0 ≤ x}` of positive elements in a closed `⋆`-subalgebra `B`. -/
def positiveCone (B : NonUnitalStarSubalgebra ℂ A) [hB : IsClosed (B : Set A)] :
    ProperCone ℝ A where
  carrier := {x : A | x ∈ B ∧ 0 ≤ x}
  zero_mem' := ⟨zero_mem B, le_rfl⟩
  add_mem' hx hy := ⟨add_mem hx.1 hy.1, add_nonneg hx.2 hy.2⟩
  smul_mem' c {x} hx :=
    ⟨by
      have h : ((c : ℝ) : ℂ) • x ∈ B := SMulMemClass.smul_mem _ hx.1
      rwa [Complex.coe_smul] at h,
      smul_nonneg c.property hx.2⟩
  isClosed' := hB.inter isClosed_Ici

@[simp, grind =]
theorem mem_positiveCone {B : NonUnitalStarSubalgebra ℂ A} [IsClosed (B : Set A)] {x : A} :
    x ∈ B.positiveCone ↔ x ∈ B ∧ 0 ≤ x :=
  Iff.rfl

@[simp]
theorem coe_positiveCone (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)] :
    (B.positiveCone : Set A) = (B : Set A) ∩ Set.Ici 0 :=
  (rfl)

theorem positiveCone_le_positive (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)] :
    B.positiveCone ≤ ProperCone.positive ℝ A :=
  fun _ hx => hx.2

theorem isHereditary_positiveCone {B : NonUnitalStarSubalgebra ℂ A} [IsClosed (B : Set A)]
    (hB : IsHereditary B) : IsHereditary B.positiveCone :=
  isHereditary_def.mpr fun _ _ ha hab hb => ⟨hB.mem_of_le ha hab hb.1, ha⟩

@[simp]
theorem isHereditary_positiveCone_iff {B : NonUnitalStarSubalgebra ℂ A} [IsClosed (B : Set A)] :
    IsHereditary B.positiveCone ↔ IsHereditary B :=
  ⟨fun h => isHereditary_def.mpr fun _ _ ha hab hb => (h.mem_of_le ha hab ⟨hb, ha.trans hab⟩).1,
    B.isHereditary_positiveCone⟩

/-- The closed complex left ideal `{x : A | star x * x ∈ B}` attached to a closed hereditary
`⋆`-subalgebra `B`. -/
def closedLeftIdeal (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B) : ClosedSubmodule ℂ A :=
  B.positiveCone.leftIdeal (B.isHereditary_positiveCone hB)

@[simp, grind =]
theorem mem_closedLeftIdeal {B : NonUnitalStarSubalgebra ℂ A} [IsClosed (B : Set A)]
    {hB : IsHereditary B} {x : A} :
    x ∈ B.closedLeftIdeal hB ↔ star x * x ∈ B := by
  simp [closedLeftIdeal, star_mul_self_nonneg]

@[simp]
theorem coe_closedLeftIdeal (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B) :
    (B.closedLeftIdeal hB : Set A) = {x : A | star x * x ∈ B} := by
  ext x
  exact mem_closedLeftIdeal

theorem mul_mem_closedLeftIdeal (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B) (a : A) {x : A} (hx : x ∈ B.closedLeftIdeal hB) :
    a * x ∈ B.closedLeftIdeal hB :=
  B.positiveCone.mul_mem_leftIdeal (B.isHereditary_positiveCone hB) a hx

/-- **Cohen–Hewitt factorization for `star x * x ∈ B`** (Blackadar II.5.3.7): for any closed
`⋆`-subalgebra `B ⊆ A` (without assuming `B` hereditary) and any `x : A` with `star x * x ∈ B`,
`x` factors as `x = y * b` with `b ∈ B`, `‖b‖ ≤ 1`, and `y` in `closure (x · B)` within `ε` of
`x`. -/
theorem exists_mul_eq_of_star_mul_self_mem (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] {x : A} (hx : star x * x ∈ B) {ε : ℝ} (hε : 0 < ε) :
    ∃ b ∈ B, ∃ y : A,
      ‖b‖ ≤ 1 ∧ y ∈ closure (Set.range fun e : B => x * (e : A)) ∧ ‖y - x‖ < ε ∧ y * b = x := by
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  let l : Filter B := CStarAlgebra.approximateUnit B
  have hl : l.IsIncreasingApproximateUnit := CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  let ι : B →L[ℂ] A := B.toSubmodule.subtypeL
  let R : A →L[ℂ] B →L[ℂ] A := ((ContinuousLinearMap.mul ℂ A).flip.comp ι).flip
  have hR_assoc (z : A) (b₁ b₂ : B) : R (R z b₁) b₂ = R z (b₁ * b₂) := mul_assoc z b₁ b₂
  have hx_mem :
      x ∈ (Submodule.span ℂ (Set.range fun p : A × B => R p.1 p.2)).topologicalClosure := by
    rw [← SetLike.mem_coe, Submodule.topologicalClosure_coe]
    refine closure_mono Submodule.subset_span ?_
    exact mem_closure_of_tendsto (hl.tendsto_mul_of_star_mul_self_mem hx)
      (Eventually.of_forall fun e => ⟨(x, e), rfl⟩)
  obtain ⟨b, y, hb_norm, hy_mem, hy_dist, hfac⟩ :=
    ContinuousLinearMap.exists_apply_eq_of_mem_topologicalClosure_span_right R hR_assoc
      hl.eventually_norm hl.tendsto_mul_left hx_mem hε
  exact ⟨b, b.property, y, hb_norm, hy_mem, hy_dist, hfac⟩

/-- **Left-ideal factorization for hereditary C⋆-subalgebras** (Blackadar II.5.3.7): for a closed
hereditary `⋆`-subalgebra `B ⊆ A`, the closed left ideal `{x : A | star x * x ∈ B}` equals the
product set `Set.univ * (B : Set A)`. -/
theorem coe_closedLeftIdeal_eq_univ_mul (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : IsHereditary B) :
    (B.closedLeftIdeal hB : Set A) = Set.univ * (B : Set A) := by
  refine Set.Subset.antisymm (fun x hx => ?_) ?_
  · obtain ⟨b, hbB, y, -, -, -, hfac⟩ :=
      B.exists_mul_eq_of_star_mul_self_mem (mem_closedLeftIdeal.mp hx) one_pos
    exact ⟨y, trivial, b, hbB, hfac⟩
  · rintro _ ⟨a, -, b, hb, rfl⟩
    refine B.mul_mem_closedLeftIdeal hB a ?_
    rw [mem_closedLeftIdeal]
    exact mul_mem (star_mem hb) hb

@[simp]
theorem starSubalgebra_closedLeftIdeal (B : NonUnitalStarSubalgebra ℂ A)
    [hB_closed : IsClosed (B : Set A)] (hB : IsHereditary B) :
    (B.closedLeftIdeal hB).starSubalgebra (B.mul_mem_closedLeftIdeal hB) = B := by
  ext x
  simp only [ClosedSubmodule.mem_starSubalgebra, mem_closedLeftIdeal, star_star]
  refine ⟨fun ⟨hx₁, hx₂⟩ => ?_, fun hx =>
    ⟨mul_mem (star_mem hx) hx, mul_mem hx (star_mem hx)⟩⟩
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  let l : Filter B := CStarAlgebra.approximateUnit B
  have hl : l.IsIncreasingApproximateUnit := CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  have hsand : Tendsto (fun e : B => (e : A) * x * (e : A)) l (𝓝 x) :=
    TauCeti.tendsto_mul_mul_of_isBoundedUnder ⟨1, eventually_map.mpr hl.eventually_norm⟩
      (hl.tendsto_mul_of_mul_star_self_mem hx₂) (hl.tendsto_mul_of_star_mul_self_mem hx₁)
  exact hB_closed.mem_of_tendsto hsand (Eventually.of_forall fun e => hB.mul_mem e.property x
      e.property)

@[simp]
theorem closedLeftIdeal_starSubalgebra (L : ClosedSubmodule ℂ A)
    (hL : ∀ a : A, ∀ x ∈ L, a * x ∈ L) :
    (L.starSubalgebra hL).closedLeftIdeal (L.isHereditary_starSubalgebra hL) = L := by
  refine SetLike.ext fun x => ?_
  rw [mem_closedLeftIdeal, ClosedSubmodule.mem_starSubalgebra,
    and_iff_left_of_imp (fun h => by rw [star_mul, star_star]; exact h)]
  exact L.star_mul_self_mem_iff hL

@[simp]
theorem positiveCone_starSubalgebra_leftIdeal (P : ProperCone ℝ A)
    (hP₀ : P ≤ ProperCone.positive ℝ A) (hP : IsHereditary P) :
    ((P.leftIdeal hP).starSubalgebra (P.mul_mem_leftIdeal hP)).positiveCone = P := by
  ext x
  simp only [mem_positiveCone, ClosedSubmodule.mem_starSubalgebra, ProperCone.mem_leftIdeal]
  refine ⟨fun ⟨⟨hx₁, _⟩, hx₀⟩ => P.mem_of_mul_self_mem hP hx₀ ?_, fun hx => ?_⟩
  · rwa [hx₀.isSelfAdjoint.star_eq] at hx₁
  · have hx₀ : 0 ≤ x := hP₀ hx
    have hsq : x * x ∈ P := P.mul_self_mem_of_mem hP₀ hP hx
    simp only [hx₀.isSelfAdjoint.star_eq]
    exact ⟨⟨hsq, hsq⟩, hx₀⟩

end Correspondences

end NonUnitalStarSubalgebra

namespace TauCeti.CStarAlgebra

section OrderIsos

variable (A : Type*) [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- **Blackadar II.5.3.2 (left-ideal correspondence)**: order isomorphism between closed hereditary
`⋆`-subalgebras `B` of `A` and closed complex left ideals `L` of `A`, given by
`B ↦ {x : A | star x * x ∈ B}` and `L ↦ L ∩ star ⁻¹' L`. -/
def hereditarySubalgebraOrderIsoClosedLeftIdeal :
    {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B} ≃o
      {L : ClosedSubmodule ℂ A // ∀ a : A, ∀ x ∈ L, a * x ∈ L} :=
  OrderIso.ofHomInv
    { toFun := fun B =>
        ⟨@NonUnitalStarSubalgebra.closedLeftIdeal A _ _ _ B.val B.property.1 B.property.2,
          @NonUnitalStarSubalgebra.mul_mem_closedLeftIdeal A _ _ _ B.val B.property.1 B.property.2⟩
      monotone' := fun B₁ B₂ h => by
        have := B₁.property.1
        have := B₂.property.1
        rw [Subtype.mk_le_mk]
        intro x hx
        exact NonUnitalStarSubalgebra.mem_closedLeftIdeal.mpr
          (h (NonUnitalStarSubalgebra.mem_closedLeftIdeal.mp hx)) }
    { toFun := fun L => ⟨L.val.starSubalgebra L.property, L.val.isClosed_starSubalgebra L.property,
        L.val.isHereditary_starSubalgebra L.property⟩
      monotone' := fun L₁ L₂ h => by
        rw [Subtype.mk_le_mk] at h ⊢
        intro x hx
        rw [ClosedSubmodule.mem_starSubalgebra] at hx ⊢
        exact ⟨h hx.1, h hx.2⟩ }
    (OrderHom.ext _ _ <| funext fun L => Subtype.ext <|
      NonUnitalStarSubalgebra.closedLeftIdeal_starSubalgebra L.val L.property)
    (OrderHom.ext _ _ <| funext fun B => Subtype.ext <|
      @NonUnitalStarSubalgebra.starSubalgebra_closedLeftIdeal A _ _ _ B.val B.property.1
        B.property.2)

@[simp, grind =]
theorem mem_hereditarySubalgebraOrderIsoClosedLeftIdeal_apply
    (B : {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B}) {x : A} :
    x ∈ (hereditarySubalgebraOrderIsoClosedLeftIdeal A B).val ↔ star x * x ∈ B.val := by
  have := B.property.1
  exact B.val.mem_closedLeftIdeal (hB := B.property.2)

@[simp]
theorem coe_hereditarySubalgebraOrderIsoClosedLeftIdeal_apply
    (B : {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B}) :
    ((hereditarySubalgebraOrderIsoClosedLeftIdeal A B).val : Set A) =
      {x : A | star x * x ∈ B.val} := by
  have := B.property.1
  exact B.val.coe_closedLeftIdeal B.property.2

@[simp]
theorem coe_hereditarySubalgebraOrderIsoClosedLeftIdeal_symm_apply
    (L : {L : ClosedSubmodule ℂ A // ∀ a : A, ∀ x ∈ L, a * x ∈ L}) :
    ((hereditarySubalgebraOrderIsoClosedLeftIdeal A).symm L).val =
      L.val.starSubalgebra L.property :=
  (rfl)

/-- **Blackadar II.5.3.2 (cone correspondence)**: order isomorphism between closed hereditary
`⋆`-subalgebras `B` of `A` and closed hereditary cones `P` in `A₊`, given by `B ↦ B ∩ A₊` and
`P ↦ {x : A | star x * x ∈ P ∧ x * star x ∈ P}`. -/
noncomputable def hereditarySubalgebraOrderIsoProperCone :
    {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B} ≃o
      {P : ProperCone ℝ A // P ≤ ProperCone.positive ℝ A ∧ IsHereditary P} :=
  OrderIso.ofHomInv
    { toFun := fun B => ⟨@NonUnitalStarSubalgebra.positiveCone A _ _ _ B.val B.property.1,
        @NonUnitalStarSubalgebra.positiveCone_le_positive A _ _ _ B.val B.property.1,
        @NonUnitalStarSubalgebra.isHereditary_positiveCone A _ _ _ B.val B.property.1 B.property.2⟩
      monotone' := fun B₁ B₂ h => by
        have := B₁.property.1
        have := B₂.property.1
        rw [Subtype.mk_le_mk]
        intro x hx
        rw [NonUnitalStarSubalgebra.mem_positiveCone] at hx ⊢
        exact ⟨h hx.1, hx.2⟩ }
    { toFun := fun P =>
        ⟨(P.val.leftIdeal P.property.2).starSubalgebra (P.val.mul_mem_leftIdeal P.property.2),
          (P.val.leftIdeal P.property.2).isClosed_starSubalgebra _,
          (P.val.leftIdeal P.property.2).isHereditary_starSubalgebra _⟩
      monotone' := fun P₁ P₂ h => by
        rw [Subtype.mk_le_mk] at h ⊢
        intro x hx
        rw [ClosedSubmodule.mem_starSubalgebra, ProperCone.mem_leftIdeal] at hx ⊢
        exact ⟨h hx.1, h hx.2⟩ }
    (OrderHom.ext _ _ <| funext fun P => Subtype.ext <|
      NonUnitalStarSubalgebra.positiveCone_starSubalgebra_leftIdeal P.val P.property.1 P.property.2)
    (OrderHom.ext _ _ <| funext fun B => Subtype.ext <| by
      have := B.property.1
      exact B.val.starSubalgebra_closedLeftIdeal B.property.2)

@[simp, grind =]
theorem mem_hereditarySubalgebraOrderIsoProperCone_apply
    (B : {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B}) {x : A} :
    x ∈ (hereditarySubalgebraOrderIsoProperCone A B).val ↔ x ∈ B.val ∧ 0 ≤ x := by
  have := B.property.1
  exact B.val.mem_positiveCone

@[simp]
theorem coe_hereditarySubalgebraOrderIsoProperCone_apply
    (B : {B : NonUnitalStarSubalgebra ℂ A // IsClosed (B : Set A) ∧ IsHereditary B}) :
    ((hereditarySubalgebraOrderIsoProperCone A B).val : Set A) = (B.val : Set A) ∩ Set.Ici 0 := by
  have := B.property.1
  exact B.val.coe_positiveCone

@[simp]
theorem coe_hereditarySubalgebraOrderIsoProperCone_symm_apply
    (P : {P : ProperCone ℝ A // P ≤ ProperCone.positive ℝ A ∧ IsHereditary P}) :
    ((hereditarySubalgebraOrderIsoProperCone A).symm P).val =
      (P.val.leftIdeal P.property.2).starSubalgebra (P.val.mul_mem_leftIdeal P.property.2) :=
  (rfl)

end OrderIsos

