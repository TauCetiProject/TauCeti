section Lattice

variable {R A : Type*} [CommSemiring R] [StarRing R] [NonUnitalSemiring A] [StarRing A]
  [Module R A] [IsScalarTower R A A] [SMulCommClass R A A] [StarModule R A]

@[simp]
theorem isHereditary_top [LE A] : IsHereditary (⊤ : NonUnitalStarSubalgebra R A) :=
  fun _ _ _ _ _ => trivial

@[simp]
theorem isHereditary_bot [PartialOrder A] : IsHereditary (⊥ : NonUnitalStarSubalgebra R A) := by
  intro a b ha hab hb
  rw [NonUnitalStarAlgebra.mem_bot] at hb ⊢
  exact le_antisymm (hab.trans_eq hb) ha

theorem isHereditary_inf [LE A] {B₁ B₂ : NonUnitalStarSubalgebra R A}
    (h₁ : IsHereditary B₁) (h₂ : IsHereditary B₂) : IsHereditary (B₁ ⊓ B₂) :=
  fun _ _ ha hab hb => ⟨h₁ ha hab hb.1, h₂ ha hab hb.2⟩

end Lattice

section Hereditary

variable {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- A closed `⋆`-subalgebra `B` satisfying `B * A * B ⊆ B` is hereditary. -/
theorem isHereditary_of_mul_mem (B : NonUnitalStarSubalgebra ℂ A) [hB : IsClosed (B : Set A)]
    (hmul : ∀ b₁ ∈ B, ∀ a : A, ∀ b₂ ∈ B, b₁ * a * b₂ ∈ B) :
    IsHereditary B := by
  intro a b ha hab hb
  let x : A := CFC.sqrt a
  let y : A := CFC.sqrt b
  have hx₀ : 0 ≤ x := CFC.sqrt_nonneg a
  have hy₀ : 0 ≤ y := CFC.sqrt_nonneg b
  have hxx : star x * x = a := by rw [hx₀.isSelfAdjoint.star_eq, CFC.sqrt_mul_sqrt_self a ha]
  have hyy : star y * y = b := by
    rw [hy₀.isSelfAdjoint.star_eq, CFC.sqrt_mul_sqrt_self b (ha.trans hab)]
  have hyB : y ∈ B := cfcₙ_nnreal_mem (𝕜 := ℂ) NNReal.sqrt hb
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  let l : Filter B := CStarAlgebra.approximateUnit B
  have hl : l.IsIncreasingApproximateUnit := CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  have hy_lim : Tendsto (fun e : B => ‖y - y * (e : A)‖) l (𝓝 0) := by
    have h := (continuous_subtype_val.tendsto (⟨y, hyB⟩ : B)).comp
      (hl.tendsto_mul_left ⟨y, hyB⟩)
    simpa only [Function.comp_def, MulMemClass.coe_mul, norm_sub_rev] using
      tendsto_iff_norm_sub_tendsto_zero.mp h
  have hx_right : Tendsto (fun e : B => x * (e : A)) l (𝓝 x) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero_norm' ?_ hy_lim
    refine Eventually.of_forall fun e => ?_
    rw [Real.norm_of_nonneg (norm_nonneg _), norm_sub_rev]
    exact norm_sub_mul_le_of_star_mul_self_le (by rwa [hxx, hyy]) (e : A)
  have hx_left : Tendsto (fun e : B => (e : A) * x) l (𝓝 x) := by
    have hstar : Tendsto (fun e : B => star (x * (e : A))) l (𝓝 (star x)) :=
      (continuous_star.tendsto x).comp hx_right
    rw [hx₀.isSelfAdjoint.star_eq] at hstar
    refine hstar.congr' ?_
    filter_upwards [hl.eventually_nonneg] with e he
    have he_sa : star (e : A) = (e : A) :=
      (IsSelfAdjoint.of_nonneg (Subtype.coe_le_coe.mpr he)).star_eq
    rw [star_mul, he_sa, hx₀.isSelfAdjoint.star_eq]
  have ha_lim : Tendsto (fun e : B => (e : A) * a * (e : A)) l (𝓝 a) := by
    have hprod := hx_left.mul hx_right
    rw [CFC.sqrt_mul_sqrt_self a ha] at hprod
    refine hprod.congr fun e => ?_
    calc
      ((e : A) * x) * (x * (e : A)) = (e : A) * (x * x) * (e : A) := by simp only [mul_assoc]
      _ = (e : A) * a * (e : A) := by rw [CFC.sqrt_mul_sqrt_self a ha]
  exact hB.mem_of_tendsto ha_lim (Eventually.of_forall fun e => hmul (e : A) e.2 a (e : A) e.2)

/-- **Sandwich characterization of hereditary C⋆-subalgebras** (Blackadar II.5.3.2): a closed
`⋆`-subalgebra `B ⊆ A` is hereditary if and only if `B * A * B ⊆ B`. -/
theorem isHereditary_iff_mul_mem (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)] :
    IsHereditary B ↔ ∀ b₁ ∈ B, ∀ a : A, ∀ b₂ ∈ B, b₁ * a * b₂ ∈ B :=
  ⟨fun h _ hb₁ a _ hb₂ => h.mul_mem hb₁ a hb₂, B.isHereditary_of_mul_mem⟩

end Hereditary

end NonUnitalStarSubalgebra

namespace TauCeti.CStarAlgebra

section Generated

variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- The algebraic corner `{a * x * a | x : A}` associated to a self-adjoint element `a`, bundled as
a nonunital `⋆`-subalgebra before taking norm closure. -/
private def cornerSubalgebra (a : A) (ha : IsSelfAdjoint a) : NonUnitalStarSubalgebra ℂ A where
  carrier := Set.range fun x : A => a * x * a
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x * a * a * y, by simp only [mul_assoc]⟩
  add_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x + y, by simp only [mul_add, add_mul]⟩
  zero_mem' := ⟨0, by simp⟩
  smul_mem' := by
    rintro c _ ⟨x, rfl⟩
    exact ⟨c • x, by simp only [mul_smul_comm, smul_mul_assoc]⟩
  star_mem' := by
    rintro _ ⟨x, rfl⟩
    exact ⟨star x, by simp only [star_mul, ha.star_eq, mul_assoc]⟩

/-- The closed hereditary `⋆`-subalgebra `closure {a * x * a | x : A}` generated by a self-adjoint
(in particular, positive) element `a` of a C⋆-algebra `A`. -/
def hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    NonUnitalStarSubalgebra ℂ A :=
  (cornerSubalgebra a ha).topologicalClosure

@[simp]
theorem coe_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    (hereditarySubalgebra a ha : Set A) = closure (Set.range fun x : A => a * x * a) := by
  rw [hereditarySubalgebra, NonUnitalStarSubalgebra.topologicalClosure_coe]
  rfl

theorem mem_hereditarySubalgebra {a y : A} {ha : IsSelfAdjoint a} :
    y ∈ hereditarySubalgebra a ha ↔ y ∈ closure (Set.range fun x : A => a * x * a) := by
  rw [← SetLike.mem_coe, coe_hereditarySubalgebra a ha]

instance isClosed_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    IsClosed (hereditarySubalgebra a ha : Set A) :=
  NonUnitalStarSubalgebra.isClosed_topologicalClosure _

theorem mul_self_mem_hereditarySubalgebra (a x : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    a * x * a ∈ hereditarySubalgebra a ha :=
  mem_hereditarySubalgebra.mpr (subset_closure ⟨x, rfl⟩)

/-- Every self-adjoint element `a` belongs to the hereditary C⋆-subalgebra `closure(aAa)` that it
generates. -/
theorem self_mem_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    a ∈ hereditarySubalgebra a ha := by
  rw [mem_hereditarySubalgebra]
  let ε : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  let g : ℕ → ℝ → ℝ := fun n t => t / (t ^ 2 + ε n)
  let F : ℕ → ℝ → ℝ := fun n t => t * g n t * t
  have hε_pos (n : ℕ) : 0 < ε n := Nat.one_div_pos_of_nat
  have hg_cont (n : ℕ) : Continuous (g n) := by
    refine continuous_id.div (continuous_id.pow 2 |>.add continuous_const) fun t => ?_
    linarith [sq_nonneg t, hε_pos n]
  have hF_cont (n : ℕ) : Continuous (F n) := (continuous_id.mul (hg_cont n)).mul continuous_id
  have h_unif : TendstoUniformlyOn F id atTop (quasispectrum ℝ a) := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro δ hδ
    have hsqrt_lim : Tendsto (fun n : ℕ => Real.sqrt (ε n) / 2) atTop (𝓝 0) := by
      simpa [ε] using ((Real.continuous_sqrt.tendsto 0).comp
        tendsto_one_div_add_atTop_nhds_zero_nat).div_const 2
    filter_upwards [(tendsto_order.mp hsqrt_lim).2 δ hδ] with n hn t _
    have hpos : 0 < t ^ 2 + ε n := by linarith [sq_nonneg t, hε_pos n]
    have hbound : |t - F n t| ≤ Real.sqrt (ε n) / 2 := by
      have hdiff : t - F n t = t * ε n / (t ^ 2 + ε n) := by
        dsimp only [F, g]
        field_simp [hpos.ne']
        ring
      rw [hdiff, abs_div, abs_mul, abs_of_pos (hε_pos n), abs_of_pos hpos,
        div_le_div_iff₀ hpos two_pos]
      have hsq : 0 ≤ (|t| - Real.sqrt (ε n)) ^ 2 := sq_nonneg _
      have hε_sq : Real.sqrt (ε n) ^ 2 = ε n := Real.sq_sqrt (hε_pos n).le
      have h_amgm : 2 * |t| * Real.sqrt (ε n) ≤ t ^ 2 + ε n := by
        nlinarith [sq_abs t, hsq, hε_sq]
      have h_eq : |t| * ε n * 2 = (2 * |t| * Real.sqrt (ε n)) * Real.sqrt (ε n) := by
        have h1 : |t| * (Real.sqrt (ε n) ^ 2) * 2 = |t| * ε n * 2 := by rw [hε_sq]
        have h2 : |t| * (Real.sqrt (ε n) ^ 2) * 2 =
            (2 * |t| * Real.sqrt (ε n)) * Real.sqrt (ε n) := by ring
        exact h1.symm.trans h2
      calc
        |t| * ε n * 2 = (2 * |t| * Real.sqrt (ε n)) * Real.sqrt (ε n) := h_eq
        _ ≤ (t ^ 2 + ε n) * Real.sqrt (ε n) :=
          mul_le_mul_of_nonneg_right h_amgm (Real.sqrt_nonneg _)
        _ = Real.sqrt (ε n) * (t ^ 2 + ε n) := mul_comm _ _
    exact (dist_eq_norm _ _).trans_le hbound |>.trans_lt hn
  have hlim : Tendsto (fun n : ℕ => cfcₙ (F n) a) atTop (𝓝 a) := by
    simpa only [cfcₙ_id ℝ a] using tendsto_cfcₙ_fun h_unif
      (Eventually.of_forall fun n => (hF_cont n).continuousOn)
      (Eventually.of_forall fun n => by simp [F, g])
  refine mem_closure_of_tendsto hlim (Eventually.of_forall fun n => ⟨cfcₙ (g n) a, ?_⟩)
  have hg0 : g n 0 = 0 := by simp [g]
  have ha_id : cfcₙ (fun t : ℝ => t) a = a := cfcₙ_id' ℝ a
  have hmul1 : cfcₙ (fun t : ℝ => t * g n t) a = a * cfcₙ (g n) a := by
    rw [cfcₙ_mul (fun t : ℝ => t) (g n) a continuous_id.continuousOn rfl
      (hg_cont n).continuousOn hg0, ha_id]
  have hmul2 : cfcₙ (F n) a = a * cfcₙ (g n) a * a := by
    rw [cfcₙ_mul (fun t : ℝ => t * g n t) (fun t : ℝ => t) a
      (continuous_id.mul (hg_cont n)).continuousOn (by simp [g])
      continuous_id.continuousOn rfl, hmul1, ha_id]
  exact hmul2.symm

@[simp]
theorem hereditarySubalgebra_zero : hereditarySubalgebra (0 : A) = ⊥ := by
  rw [← SetLike.coe_set_eq, coe_hereditarySubalgebra 0 (IsSelfAdjoint.zero A),
    NonUnitalStarAlgebra.coe_bot]
  have hrange : (Set.range fun x : A => (0 : A) * x * 0) = {0} :=
    Set.Subset.antisymm (by rintro _ ⟨_, rfl⟩; simp) (by rintro _ rfl; exact ⟨0, by simp⟩)
  rw [hrange, closure_singleton]

variable [PartialOrder A] [StarOrderedRing A]

/-- The closed subalgebra `hereditarySubalgebra a` is hereditary. -/
theorem isHereditary_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    IsHereditary (hereditarySubalgebra a ha) := by
  refine (hereditarySubalgebra a ha).isHereditary_of_mul_mem fun b₁ hb₁ z b₂ hb₂ => ?_
  rw [mem_hereditarySubalgebra] at hb₁ hb₂ ⊢
  refine map_mem_closure₂ (f := fun x y => x * z * y)
    ((continuous_fst.mul continuous_const).mul continuous_snd) hb₁ hb₂ ?_
  rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
  exact ⟨x * a * z * a * y, by simp only [mul_assoc]⟩

/-- **Universal property of `hereditarySubalgebra`**: for any closed hereditary `⋆`-subalgebra `B`,
`hereditarySubalgebra a ≤ B` if and only if `a ∈ B`. -/
@[simp]
theorem hereditarySubalgebra_le_iff {a : A} {ha : IsSelfAdjoint a}
    {B : NonUnitalStarSubalgebra ℂ A} [hB_closed : IsClosed (B : Set A)] (hB : IsHereditary B) :
    hereditarySubalgebra a ha ≤ B ↔ a ∈ B := by
  refine ⟨fun h => h (self_mem_hereditarySubalgebra a ha), fun haB => ?_⟩
  rw [← SetLike.coe_subset_coe, coe_hereditarySubalgebra a ha]
  refine closure_minimal ?_ hB_closed
  rintro _ ⟨x, rfl⟩
  exact hB.mul_mem haB x haB

