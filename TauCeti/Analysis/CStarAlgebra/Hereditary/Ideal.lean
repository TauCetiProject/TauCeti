/-!
# Closed ideals, hereditary subalgebras, and full vs. strictly positive elements

Every closed two-sided ideal of a C⋆-algebra — and in a unital C⋆-algebra every closed left ideal —
is hereditary in the spectral order (`TwoSidedIdeal.isHereditary_of_isClosed`,
`Ideal.isHereditary_of_isClosed`).

Conversely, if `B` is a closed hereditary `⋆`-subalgebra of a C⋆-algebra `A`, then closed two-sided
ideals `K` of `B` correspond bijectively and order-isomorphically to closed two-sided ideals `J` of
`A` contained in the closed ideal `B.closedIdeal = closure (span ℂ (A · B · A))` generated by `B`,
via `K ↦ closure (span ℂ (A · K · A))` (`NonUnitalStarSubalgebra.inducedClosedIdeal`) and
`J ↦ J ∩ B` (`NonUnitalStarSubalgebra.restrictIdeal`), packaged as
`NonUnitalStarSubalgebra.closedIdealOrderIso`.

At the single-element level, an element `a : A` is *full* (`TauCeti.CStarAlgebra.IsFull`) when the
closed two-sided ideal it generates is all of `A`, whereas `a` is *strictly positive*
(`TauCeti.CStarAlgebra.IsStrictlyPositive`) when `0 ≤ a` and the hereditary C⋆-subalgebra
`closure {a * x * a | x : A}` it generates is all of `A`. In unital C⋆-algebras, strict positivity
coincides with `0 ≤ a ∧ IsUnit a` (`TauCeti.CStarAlgebra.isStrictlyPositive_iff_of_unital`). Every
strictly positive element is full (`TauCeti.CStarAlgebra.IsStrictlyPositive.isFull`), while in
`CStarMatrix (Fin 2) (Fin 2) ℂ` the diagonal `⋆`-subalgebra is closed yet not hereditary and the
rank-one projection `e₀₀` is positive and full yet not strictly positive.

## Main declarations

* `TwoSidedIdeal.isHereditary_of_isClosed` and `Ideal.isHereditary_of_isClosed`: closed ideals in
  C⋆-algebras are hereditary.
* `TwoSidedIdeal.mem_of_star_mul_self_mem_of_isClosed` and
  `TwoSidedIdeal.star_mul_self_mem_iff_of_isClosed`: for a closed two-sided ideal `I`, `star x * x`
  lies in `I` if and only if `x` lies in `I`.
* `NonUnitalStarSubalgebra.closedIdeal`, `NonUnitalStarSubalgebra.restrictIdeal`, and
  `NonUnitalStarSubalgebra.inducedClosedIdeal`: the closed two-sided ideal generated by `B`,
  restriction `J ↦ J ∩ B`, and induction `K ↦ closure (span ℂ (A · K · A))`, packaged as the order
  isomorphism `NonUnitalStarSubalgebra.closedIdealOrderIso`.
* `TauCeti.CStarAlgebra.IsFull` and `TauCeti.CStarAlgebra.IsStrictlyPositive`: full and strictly
  positive elements in (possibly nonunital) C⋆-algebras, with
  `isStrictlyPositive_iff_hereditarySubalgebra_eq_top`, `isStrictlyPositive_iff_of_unital`, and
  `IsStrictlyPositive.isFull`.
* `TauCeti.CStarAlgebra.exists_isClosed_not_isHereditary_matrix` and
  `TauCeti.CStarAlgebra.exists_isFull_and_not_isStrictlyPositive_matrix`: `2 × 2` matrix witnesses
  separating closed `⋆`-subalgebras from hereditary ones and full positive elements from strictly
  positive ones.

## References

* B. Blackadar, *Operator Algebras: Theory of C⋆-Algebras and von Neumann Algebras*,
  II.5.1.1(ii), II.5.3.2, and II.5.3.5.
* G. J. Murphy, *C⋆-Algebras and Operator Theory*, Section 3.2, Theorems 3.2.1 and 3.2.7.
* G. K. Pedersen, *C⋆-Algebras and their Automorphism Groups*, Sections 1.5 and 3.10.
-/

public section

open Filter Topology
open scoped CStarAlgebra ComplexOrder Pointwise

namespace TwoSidedIdeal

open TauCeti.CStarAlgebra

/-- For a closed two-sided ideal `I` of a C⋆-algebra `A`, `star x * x ∈ I` implies `x ∈ I`. -/
theorem mem_of_star_mul_self_mem_of_isClosed {A : Type*} [NonUnitalCStarAlgebra A]
    (I : TwoSidedIdeal A) [hI : IsClosed (I : Set A)] {x : A} (hx : star x * x ∈ I) :
    x ∈ I := by
  let _ := CStarAlgebra.spectralOrder A
  have _ := CStarAlgebra.spectralOrderedRing A
  let B := I.toNonUnitalStarSubalgebra
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  have hl : (CStarAlgebra.approximateUnit B).IsIncreasingApproximateUnit :=
    CStarAlgebra.increasingApproximateUnit B
  have := hl.neBot
  exact hI.mem_of_tendsto
    (hl.tendsto_mul_of_star_mul_self_mem (I.mem_toNonUnitalStarSubalgebra.mpr hx))
    (Eventually.of_forall fun e =>
      I.mul_mem_left x (e : A) (I.mem_toNonUnitalStarSubalgebra.mp e.2))

@[simp]
theorem star_mul_self_mem_iff_of_isClosed {A : Type*} [NonUnitalCStarAlgebra A]
    (I : TwoSidedIdeal A) [IsClosed (I : Set A)] {x : A} :
    star x * x ∈ I ↔ x ∈ I :=
  ⟨I.mem_of_star_mul_self_mem_of_isClosed, fun hx => I.mul_mem_left (star x) x hx⟩

/-- Every closed two-sided ideal of a C⋆-algebra is hereditary (Blackadar II.5.1.1(ii)). -/
theorem isHereditary_of_isClosed {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]
    [StarOrderedRing A] (I : TwoSidedIdeal A) [IsClosed (I : Set A)] :
    IsHereditary I :=
  (isHereditary_congr I.coe_toNonUnitalStarSubalgebra).mp <|
    I.toNonUnitalStarSubalgebra.isHereditary_of_mul_mem fun b₁ hb₁ a _ _ =>
      I.mem_toNonUnitalStarSubalgebra.mpr
        (I.mul_mem_right (b₁ * a) _ (I.mul_mem_right b₁ a (I.mem_toNonUnitalStarSubalgebra.mp hb₁)))

end TwoSidedIdeal

namespace Ideal

/-- Every closed left ideal of a unital C⋆-algebra (in particular, every closed two-sided ideal) is
hereditary in the spectral order. -/
theorem isHereditary_of_isClosed {A : Type*} [CStarAlgebra A] [PartialOrder A]
    [StarOrderedRing A] (I : Ideal A) [hI : IsClosed (I : Set A)] :
    TauCeti.CStarAlgebra.IsHereditary I := by
  let L : ClosedSubmodule ℂ A :=
    { carrier := I
      add_mem' := I.add_mem
      zero_mem' := I.zero_mem
      smul_mem' := fun c x hx => algebraMap_smul A c x ▸ I.mul_mem_left (algebraMap ℂ A c) hx
      isClosed' := hI }
  exact (TauCeti.CStarAlgebra.isHereditary_congr (s₁ := L) (s₂ := I) rfl).mp
    (L.isHereditary_of_mul_mem fun a _ hx => I.mul_mem_left a hx)

end Ideal

/-! ### Ideal correspondence for hereditary C⋆-subalgebras (Blackadar II.5.3.5) -/

namespace NonUnitalStarSubalgebra

open TauCeti.CStarAlgebra

section IdealCorrespondence

variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- The closed two-sided ideal `closure (span ℂ (A · B · A))` of `A` generated by a `⋆`-subalgebra
`B`. -/
def closedIdeal (B : NonUnitalStarSubalgebra ℂ A) : TwoSidedIdeal A :=
  (TwoSidedIdeal.span (B : Set A)).topologicalClosure

instance isClosed_closedIdeal (B : NonUnitalStarSubalgebra ℂ A) :
    IsClosed (B.closedIdeal : Set A) :=
  TwoSidedIdeal.isClosed_topologicalClosure _

theorem subset_closedIdeal (B : NonUnitalStarSubalgebra ℂ A) :
    (B : Set A) ⊆ (B.closedIdeal : Set A) :=
  (TwoSidedIdeal.subset_span).trans (TwoSidedIdeal.le_topologicalClosure _)

theorem coe_closedIdeal (B : NonUnitalStarSubalgebra ℂ A) :
    (B.closedIdeal : Set A) =
      closure (Submodule.span ℂ (Set.univ * (B : Set A) * Set.univ) : Set A) :=
  TwoSidedIdeal.coe_topologicalClosure_span_eq_closure_span_univ_mul_univ (B : Set A)

theorem closedIdeal_le_iff {B : NonUnitalStarSubalgebra ℂ A} {J : TwoSidedIdeal A}
    [hJ : IsClosed (J : Set A)] :
    B.closedIdeal ≤ J ↔ (B : Set A) ⊆ (J : Set A) := by
  refine ⟨fun h => B.subset_closedIdeal.trans h, fun h => ?_⟩
  rw [← SetLike.coe_subset_coe, closedIdeal, TwoSidedIdeal.coe_topologicalClosure]
  exact closure_minimal (TwoSidedIdeal.span_le.mpr h) hJ

/-- Restrict a two-sided ideal `J` of `A` to a `⋆`-subalgebra `B`, with carrier `J ∩ B`. -/
def restrictIdeal (B : NonUnitalStarSubalgebra ℂ A) (J : TwoSidedIdeal A) : TwoSidedIdeal B :=
  J.comap (NonUnitalStarSubalgebraClass.subtype B)

@[simp]
theorem mem_restrictIdeal {B : NonUnitalStarSubalgebra ℂ A} {J : TwoSidedIdeal A} {b : B} :
    b ∈ B.restrictIdeal J ↔ (b : A) ∈ J :=
  TwoSidedIdeal.mem_comap (NonUnitalStarSubalgebraClass.subtype B)

@[simp]
theorem coe_restrictIdeal (B : NonUnitalStarSubalgebra ℂ A) (J : TwoSidedIdeal A) :
    (B.restrictIdeal J : Set B) = ((↑) : B → A) ⁻¹' (J : Set A) := by
  ext b
  exact B.mem_restrictIdeal

instance isClosed_restrictIdeal (B : NonUnitalStarSubalgebra ℂ A) (J : TwoSidedIdeal A)
    [hJ : IsClosed (J : Set A)] :
    IsClosed (B.restrictIdeal J : Set B) := by
  rw [B.coe_restrictIdeal]
  exact hJ.preimage continuous_subtype_val

/-- The closed two-sided ideal `closure (span ℂ (A · K · A))` of `A` induced by a two-sided ideal
`K` of `B`. -/
def inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A) (K : TwoSidedIdeal B) :
    TwoSidedIdeal A :=
  (TwoSidedIdeal.span ((↑) '' (K : Set B) : Set A)).topologicalClosure

instance isClosed_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A) (K : TwoSidedIdeal B) :
    IsClosed (B.inducedClosedIdeal K : Set A) :=
  TwoSidedIdeal.isClosed_topologicalClosure _

theorem coe_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A) (K : TwoSidedIdeal B) :
    (B.inducedClosedIdeal K : Set A) =
      closure (Submodule.span ℂ (Set.univ * (((↑) : B → A) '' (K : Set B)) * Set.univ) : Set A) :=
  TwoSidedIdeal.coe_topologicalClosure_span_eq_closure_span_univ_mul_univ _

theorem image_subset_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A) (K : TwoSidedIdeal B) :
    ((↑) '' (K : Set B) : Set A) ⊆ (B.inducedClosedIdeal K : Set A) :=
  (TwoSidedIdeal.subset_span).trans (TwoSidedIdeal.le_topologicalClosure _)

theorem inducedClosedIdeal_mono (B : NonUnitalStarSubalgebra ℂ A) :
    Monotone B.inducedClosedIdeal := fun _ _ h => by
  rw [← SetLike.coe_subset_coe, inducedClosedIdeal, TwoSidedIdeal.coe_topologicalClosure]
  refine closure_minimal (TwoSidedIdeal.span_le.mpr ?_) (B.isClosed_inducedClosedIdeal _)
  exact (Set.image_mono h).trans (B.image_subset_inducedClosedIdeal _)

theorem inducedClosedIdeal_le_closedIdeal (B : NonUnitalStarSubalgebra ℂ A)
    (K : TwoSidedIdeal B) :
    B.inducedClosedIdeal K ≤ B.closedIdeal := by
  rw [← SetLike.coe_subset_coe, inducedClosedIdeal, TwoSidedIdeal.coe_topologicalClosure]
  refine closure_minimal (TwoSidedIdeal.span_le.mpr ?_) B.isClosed_closedIdeal
  rintro _ ⟨b, -, rfl⟩
  exact B.subset_closedIdeal b.2

@[simp]
theorem inducedClosedIdeal_top (B : NonUnitalStarSubalgebra ℂ A) :
    B.inducedClosedIdeal ⊤ = B.closedIdeal := by
  have himg : (((↑) : B → A) '' ((⊤ : TwoSidedIdeal B) : Set B)) = (B : Set A) := by
    rw [TwoSidedIdeal.coe_top, Set.image_univ, Subtype.range_coe]
  rw [inducedClosedIdeal, himg, closedIdeal]

variable [PartialOrder A] [StarOrderedRing A]

/-- Restricting the induced closed ideal `closure (span ℂ (A · K · A))` back to a closed hereditary
`⋆`-subalgebra `B` recovers `K` (Blackadar II.5.3.5). -/
@[simp]
theorem restrictIdeal_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : IsHereditary B)
    (K : TwoSidedIdeal B) [hK : IsClosed (K : Set B)] :
    B.restrictIdeal (B.inducedClosedIdeal K) = K := by
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  refine le_antisymm (fun b hb => ?_) (fun b hb =>
    B.mem_restrictIdeal.mpr (B.image_subset_inducedClosedIdeal K ⟨b, hb, rfl⟩))
  rw [B.mem_restrictIdeal, ← SetLike.mem_coe, B.coe_inducedClosedIdeal] at hb
  let hlB : (CStarAlgebra.approximateUnit B).IsIncreasingApproximateUnit :=
    CStarAlgebra.increasingApproximateUnit B
  have := hlB.neBot
  refine hK.mem_of_tendsto (hlB.tendsto_mul_self b) (Eventually.of_forall fun e => ?_)
  -- For fixed `e : B`, the linear map `z ↦ e * z * e : A → B` sends `B.inducedClosedIdeal K`
  -- into `K`.
  let Φ : A →ₗ[ℂ] B :=
    { toFun := fun z => ⟨(e : A) * z * (e : A), hB.mul_mem e.2 z e.2⟩
      map_add' := fun z₁ z₂ => Subtype.ext (by simp only [mul_add, add_mul, AddMemClass.coe_add])
      map_smul' := fun c z =>
        Subtype.ext (by simp only [mul_smul_comm, smul_mul_assoc, RingHom.id_apply,
          SetLike.val_smul]) }
  have hΦ_cont : Continuous Φ :=
    Continuous.subtype_mk ((continuous_const.mul continuous_id).mul continuous_const) _
  let M : Submodule ℂ A := K.toSubmodule.comap Φ
  have hM_closed : IsClosed (M : Set A) := hK.preimage hΦ_cont
  have hle :
      closure (Submodule.span ℂ (Set.univ * (((↑) : B → A) '' (K : Set B)) * Set.univ) : Set A) ⊆
        (M : Set A) := by
    refine closure_minimal ?_ hM_closed
    rw [SetLike.coe_subset_coe, Submodule.span_le]
    rintro _ ⟨_, ⟨x, -, _, ⟨k, hk, rfl⟩, rfl⟩, y, -, rfl⟩
    change Φ (x * (k : A) * y) ∈ K
    let S : NonUnitalStarSubalgebra ℂ B := K.toNonUnitalStarSubalgebra
    have _ : StarOrderedRing S := Subtype.starOrderedRing (𝕜 := ℂ) S
    have hlS : (CStarAlgebra.approximateUnit S).IsIncreasingApproximateUnit :=
      CStarAlgebra.increasingApproximateUnit S
    have := hlS.neBot
    let kS : S := ⟨k, K.mem_toNonUnitalStarSubalgebra.mpr hk⟩
    have hk_lim : Tendsto (fun u : S => ((u : B) : A) * (k : A) * ((u : B) : A))
        (CStarAlgebra.approximateUnit S) (𝓝 (k : A)) := by
      have h1 := (continuous_subtype_val.tendsto kS).comp (hlS.tendsto_mul_self kS)
      have h2 := (continuous_subtype_val.tendsto k).comp h1
      simpa only [Function.comp_def, MulMemClass.coe_mul] using h2
    have hΦ_lim : Tendsto (fun u : S => Φ (x * (((u : B) : A) * (k : A) * ((u : B) : A)) * y))
        (CStarAlgebra.approximateUnit S) (𝓝 (Φ (x * (k : A) * y))) :=
      (hΦ_cont.tendsto _).comp ((hk_lim.const_mul x).mul_const y)
    refine hK.mem_of_tendsto hΦ_lim (Eventually.of_forall fun u => ?_)
    let b₁ : B := ⟨(e : A) * x * ((u : B) : A), hB.mul_mem e.2 x (u : B).2⟩
    let b₂ : B := ⟨((u : B) : A) * y * (e : A), hB.mul_mem (u : B).2 y e.2⟩
    have hEq : Φ (x * (((u : B) : A) * (k : A) * ((u : B) : A)) * y) = b₁ * k * b₂ :=
      Subtype.ext (by simp only [Φ, b₁, b₂, LinearMap.coe_mk, AddHom.coe_mk, MulMemClass.coe_mul,
        mul_assoc])
    rw [hEq]
    exact K.mul_mem_right _ b₂ (K.mul_mem_left b₁ k hk)
  have hmem : Φ (b : A) ∈ K := hle hb
  have hΦb : Φ (b : A) = e * b * e := Subtype.ext rfl
  rwa [hΦb] at hmem

/-- Every closed two-sided ideal `J` of `A` contained in `B.closedIdeal` is generated as a closed
ideal of `A` by its intersection `J ∩ B` with a hereditary `⋆`-subalgebra `B`
(Blackadar II.5.3.5). -/
@[simp]
theorem inducedClosedIdeal_restrictIdeal (B : NonUnitalStarSubalgebra ℂ A) (hB : IsHereditary B)
    (J : TwoSidedIdeal A) [hJ : IsClosed (J : Set A)] (hJB : J ≤ B.closedIdeal) :
    B.inducedClosedIdeal (B.restrictIdeal J) = J := by
  let K := B.restrictIdeal J
  let I' := B.inducedClosedIdeal K
  refine le_antisymm ?_ (fun z hz => ?_)
  · rw [← SetLike.coe_subset_coe, inducedClosedIdeal, TwoSidedIdeal.coe_topologicalClosure]
    refine closure_minimal (TwoSidedIdeal.span_le.mpr ?_) hJ
    rintro _ ⟨b, hb, rfl⟩
    exact B.mem_restrictIdeal.mp hb
  · let SJ : NonUnitalStarSubalgebra ℂ A := J.toNonUnitalStarSubalgebra
    have _ : StarOrderedRing SJ := Subtype.starOrderedRing (𝕜 := ℂ) SJ
    have hlJ : (CStarAlgebra.approximateUnit SJ).IsIncreasingApproximateUnit :=
      CStarAlgebra.increasingApproximateUnit SJ
    have := hlJ.neBot
    let zJ : SJ := ⟨z, J.mem_toNonUnitalStarSubalgebra.mpr hz⟩
    have hz_lim : Tendsto (fun u : SJ => (u : A) * z) (CStarAlgebra.approximateUnit SJ) (𝓝 z) := by
      have h := (continuous_subtype_val.tendsto zJ).comp (hlJ.tendsto_mul_right zJ)
      simpa only [Function.comp_def, MulMemClass.coe_mul] using h
    refine (B.isClosed_inducedClosedIdeal K).mem_of_tendsto hz_lim
      (Eventually.of_forall fun u => ?_)
    -- For fixed `u ∈ J`, `{w : A | u * w ∈ I'}` is a closed submodule containing `A · B · A`.
    let Ψ : A →ₗ[ℂ] A :=
      { toFun := fun w => (u : A) * w
        map_add' := mul_add (u : A)
        map_smul' := fun c w => by simp only [mul_smul_comm, RingHom.id_apply] }
    let M : Submodule ℂ A := I'.toSubmodule.comap Ψ
    have hM_closed : IsClosed (M : Set A) :=
      (B.isClosed_inducedClosedIdeal K).preimage (continuous_const.mul continuous_id)
    have hle : (B.closedIdeal : Set A) ⊆ (M : Set A) := by
      rw [B.coe_closedIdeal]
      refine closure_minimal ?_ hM_closed
      rw [SetLike.coe_subset_coe, Submodule.span_le]
      rintro _ ⟨_, ⟨x, -, b, hb, rfl⟩, y, -, rfl⟩
      change (u : A) * (x * b * y) ∈ I'
      let v : A := (u : A) * x
      have hv : v ∈ J := J.mul_mem_right (u : A) x (J.mem_toNonUnitalStarSubalgebra.mp u.2)
      let w : A := v * b
      let k₀ : B := ⟨star b * (star v * v) * b, hB.mul_mem (star_mem hb) (star v * v) hb⟩
      have hk₀ : k₀ ∈ K := by
        rw [B.mem_restrictIdeal]
        have hEq : (k₀ : A) = (star b * star v) * (v * b) := by simp only [k₀, mul_assoc]
        rw [hEq]
        exact J.mul_mem_left (star b * star v) (v * b) (J.mul_mem_right v b hv)
      have hstar_w : star w * w ∈ I' := by
        have hEq : star w * w = (k₀ : A) := by simp only [w, k₀, star_mul, mul_assoc]
        rw [hEq]
        exact B.image_subset_inducedClosedIdeal K ⟨k₀, hk₀, rfl⟩
      have hw : w ∈ I' := I'.mem_of_star_mul_self_mem_of_isClosed hstar_w
      have hmul_eq : (u : A) * (x * b * y) = w * y := by simp only [w, v, mul_assoc]
      rw [hmul_eq]
      exact I'.mul_mem_right w y hw
    exact hle (hJB hz)

/-- **Blackadar II.5.3.5**: for a closed hereditary `⋆`-subalgebra `B` of a C⋆-algebra `A`, closed
two-sided ideals of `A` contained in `B.closedIdeal = closure (span ℂ (A · B · A))` are order
isomorphic to closed two-sided ideals of `B`, via `J ↦ J ∩ B` and
`K ↦ closure (span ℂ (A · K · A))`. -/
def closedIdealOrderIso (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B) :
    {J : TwoSidedIdeal A // IsClosed (J : Set A) ∧ J ≤ B.closedIdeal} ≃o
      {K : TwoSidedIdeal B // IsClosed (K : Set B)} where
  toFun J := ⟨B.restrictIdeal J.1, @isClosed_restrictIdeal A _ B J.1 J.2.1⟩
  invFun K := ⟨B.inducedClosedIdeal K.1, B.isClosed_inducedClosedIdeal K.1,
    B.inducedClosedIdeal_le_closedIdeal K.1⟩
  left_inv J := Subtype.ext <| by
    have := J.2.1
    exact B.inducedClosedIdeal_restrictIdeal hB J.1 J.2.2
  right_inv K := Subtype.ext <| by
    have := K.2
    exact B.restrictIdeal_inducedClosedIdeal hB K.1
  map_rel_iff' {J₁ J₂} := by
    have := J₁.2.1
    have := J₂.2.1
    refine ⟨fun h => ?_, fun h b hb => ?_⟩
    · change B.restrictIdeal J₁.1 ≤ B.restrictIdeal J₂.1 at h
      change J₁.1 ≤ J₂.1
      rw [← B.inducedClosedIdeal_restrictIdeal hB J₁.1 J₁.2.2,
        ← B.inducedClosedIdeal_restrictIdeal hB J₂.1 J₂.2.2]
      exact B.inducedClosedIdeal_mono h
    · change b ∈ B.restrictIdeal J₁.1 at hb
      change b ∈ B.restrictIdeal J₂.1
      exact B.mem_restrictIdeal.mpr (h (B.mem_restrictIdeal.mp hb))

@[simp]
theorem coe_closedIdealOrderIso_apply (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B)
    (J : {J : TwoSidedIdeal A // IsClosed (J : Set A) ∧ J ≤ B.closedIdeal}) :
    (B.closedIdealOrderIso hB J).1 = B.restrictIdeal J.1 :=
  (rfl)

@[simp]
theorem coe_closedIdealOrderIso_symm_apply (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : IsHereditary B)
    (K : {K : TwoSidedIdeal B // IsClosed (K : Set B)}) :
    ((B.closedIdealOrderIso hB).symm K).1 = B.inducedClosedIdeal K.1 :=
  (rfl)

end IdealCorrespondence

end NonUnitalStarSubalgebra

/-! ### Full and strictly positive elements -/

namespace TauCeti.CStarAlgebra

section FullAndStrictlyPositive

/-- An element `a` of a topological nonunital ring `A` is *full* if the closed two-sided ideal it
generates is the whole ring `A`. -/
def IsFull {A : Type*} [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A] (a : A) :
    Prop :=
  (TwoSidedIdeal.span ({a} : Set A)).topologicalClosure = ⊤

theorem isFull_def {A : Type*} [NonUnitalRing A] [TopologicalSpace A] [IsTopologicalRing A]
    {a : A} :
    IsFull a ↔ (TwoSidedIdeal.span ({a} : Set A)).topologicalClosure = ⊤ :=
  Iff.rfl

theorem isFull_iff_closure_span_mul_eq_univ {A : Type*} [NonUnitalCStarAlgebra A] {a : A} :
    IsFull a ↔
      closure (Submodule.span ℂ (Set.univ * ({a} : Set A) * Set.univ) : Set A) = Set.univ := by
  rw [isFull_def, ← SetLike.coe_set_eq,
    TwoSidedIdeal.coe_topologicalClosure_span_eq_closure_span_univ_mul_univ,
    TwoSidedIdeal.coe_top]

theorem IsFull.of_isUnit {A : Type*} [Ring A] [TopologicalSpace A] [IsTopologicalRing A] {a : A}
    (ha : IsUnit a) : IsFull a := by
  rw [isFull_def, ← TwoSidedIdeal.one_mem_iff]
  obtain ⟨u, rfl⟩ := ha
  refine TwoSidedIdeal.le_topologicalClosure _ ?_
  simpa only [Units.mul_inv] using
    (TwoSidedIdeal.span ({(u : A)} : Set A)).mul_mem_right (u : A) ↑u⁻¹
      (TwoSidedIdeal.subset_span (Set.mem_singleton _))

theorem not_isFull_zero {A : Type*} [NonUnitalCStarAlgebra A] [Nontrivial A] :
    ¬IsFull (0 : A) := by
  rw [isFull_iff_closure_span_mul_eq_univ]
  intro h
  obtain ⟨x, hx⟩ := exists_ne (0 : A)
  have hzero : Set.univ * ({(0 : A)} : Set A) * Set.univ ⊆ ({(0 : A)} : Set A) := by
    rintro _ ⟨_, ⟨u, -, _, rfl, rfl⟩, v, -, rfl⟩
    simp
  have hsub : closure (Submodule.span ℂ (Set.univ * ({(0 : A)} : Set A) * Set.univ) : Set A) ⊆
      ({(0 : A)} : Set A) := by
    refine closure_minimal ?_ isClosed_singleton
    rw [← Submodule.bot_coe (R := ℂ) (M := A), SetLike.coe_subset_coe, Submodule.span_le,
      Submodule.bot_coe]
    exact hzero
  have hx_mem : x ∈ ({(0 : A)} : Set A) := hsub (h.symm ▸ Set.mem_univ x)
  exact hx hx_mem

/-- An element `a` of a (possibly nonunital) C⋆-algebra `A` is *strictly positive* if `0 ≤ a` and
the hereditary C⋆-subalgebra `closure {a * x * a | x : A}` generated by `a` is all of `A`.
In unital C⋆-algebras this coincides with Mathlib's `_root_.IsStrictlyPositive`
(`TauCeti.CStarAlgebra.isStrictlyPositive_iff_of_unital`). -/
def IsStrictlyPositive {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] (a : A) : Prop :=
  0 ≤ a ∧ closure (Set.range fun x : A => a * x * a) = Set.univ

theorem IsStrictlyPositive.nonneg {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] {a : A}
    (ha : IsStrictlyPositive a) : 0 ≤ a :=
  ha.1

theorem IsStrictlyPositive.isSelfAdjoint {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]
    [StarOrderedRing A] {a : A} (ha : IsStrictlyPositive a) : IsSelfAdjoint a :=
  ha.1.isSelfAdjoint

theorem IsStrictlyPositive.hereditarySubalgebra_eq_top {A : Type*} [NonUnitalCStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A] {a : A} (ha : IsStrictlyPositive a) :
    hereditarySubalgebra a ha.isSelfAdjoint = ⊤ := by
  rw [← SetLike.coe_set_eq, coe_hereditarySubalgebra a ha.isSelfAdjoint,
    NonUnitalStarAlgebra.coe_top]
  exact ha.2

theorem isStrictlyPositive_iff_hereditarySubalgebra_eq_top {A : Type*} [NonUnitalCStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A] {a : A} (ha : 0 ≤ a) :
    IsStrictlyPositive a ↔ hereditarySubalgebra a ha.isSelfAdjoint = ⊤ := by
  rw [← SetLike.coe_set_eq, IsStrictlyPositive, coe_hereditarySubalgebra a ha.isSelfAdjoint,
    NonUnitalStarAlgebra.coe_top]
  exact and_iff_right ha

/-- Every strictly positive element of a C⋆-algebra is full. -/
theorem IsStrictlyPositive.isFull {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] {a : A}
    (ha : IsStrictlyPositive a) : IsFull a := by
  let I := (TwoSidedIdeal.span ({a} : Set A)).topologicalClosure
  have haI : a ∈ I := TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span rfl)
  have hsub : (Set.univ : Set A) ⊆ (I : Set A) := by
    rw [← ha.2]
    refine closure_minimal ?_ (TwoSidedIdeal.isClosed_topologicalClosure _)
    rintro _ ⟨x, rfl⟩
    exact I.mul_mem_right (a * x) a (I.mul_mem_right a x haI)
  rw [isFull_def, ← SetLike.coe_set_eq, TwoSidedIdeal.coe_top]
  exact Set.Subset.antisymm (Set.subset_univ _) hsub

/-- In a unital C⋆-algebra, `TauCeti.CStarAlgebra.IsStrictlyPositive a` (`0 ≤ a` and
`closure (a · A · a) = A`) is equivalent to Mathlib's `_root_.IsStrictlyPositive a`
(`0 ≤ a ∧ IsUnit a`). -/
theorem isStrictlyPositive_iff_of_unital {A : Type*} [CStarAlgebra A] [PartialOrder A] {a : A} :
    IsStrictlyPositive a ↔ _root_.IsStrictlyPositive a := by
  rw [_root_.IsStrictlyPositive.iff_of_unital]
  refine and_congr_right fun _ => ⟨fun hdense => ?_, fun hu => ?_⟩
  · have h1 : (1 : A) ∈ closure (Set.range fun x : A => a * x * a) :=
      hdense ▸ Set.mem_univ (1 : A)
    obtain ⟨_, ⟨x, rfl⟩, hdist⟩ := Metric.mem_closure_iff.mp h1 1 one_pos
    rw [dist_eq_norm] at hdist
    let u : Aˣ := Units.oneSub (1 - a * x * a) hdist
    have hu_val : (u : A) = a * x * a := by
      rw [Units.val_oneSub, sub_sub_cancel]
    let r : A := x * a * ↑u⁻¹
    let l : A := ↑u⁻¹ * a * x
    have hr : a * r = 1 := by
      calc
        a * r = (a * x * a) * ↑u⁻¹ := by simp only [r, mul_assoc]
        _ = (u : A) * ↑u⁻¹ := by rw [← hu_val]
        _ = 1 := u.mul_inv
    have hl : l * a = 1 := by
      calc
        l * a = ↑u⁻¹ * (a * x * a) := by simp only [l, mul_assoc]
        _ = ↑u⁻¹ * (u : A) := by rw [← hu_val]
        _ = 1 := u.inv_mul
    have hlr : l = r := by
      calc
        l = l * (a * r) := by rw [hr, mul_one]
        _ = (l * a) * r := (mul_assoc l a r).symm
        _ = r := by rw [hl, one_mul]
    exact ⟨⟨a, r, hr, hlr ▸ hl⟩, rfl⟩
  · obtain ⟨u, rfl⟩ := hu
    refine Set.Subset.antisymm (Set.subset_univ _) fun y _ => subset_closure ⟨↑u⁻¹ * y * ↑u⁻¹, ?_⟩
    calc
      (u : A) * (↑u⁻¹ * y * ↑u⁻¹) * (u : A) = ((u : A) * ↑u⁻¹) * y * (↑u⁻¹ * (u : A)) := by
        simp only [mul_assoc]
      _ = y := by rw [u.mul_inv, u.inv_mul, one_mul, mul_one]

end FullAndStrictlyPositive

section MatrixCounterexamples

/-- In `CStarMatrix (Fin 2) (Fin 2) ℂ`, the diagonal `⋆`-subalgebra is norm-closed yet not
hereditary. -/
theorem exists_isClosed_not_isHereditary_matrix :
    ∃ B : NonUnitalStarSubalgebra ℂ (CStarMatrix (Fin 2) (Fin 2) ℂ),
      IsClosed (B : Set (CStarMatrix (Fin 2) (Fin 2) ℂ)) ∧ ¬IsHereditary B := by
  let B : NonUnitalStarSubalgebra ℂ (CStarMatrix (Fin 2) (Fin 2) ℂ) :=
    { carrier := {M | M 0 1 = 0 ∧ M 1 0 = 0}
      mul_mem' := fun {M N} hM hN => by
        refine ⟨?_, ?_⟩ <;>
          simp [CStarMatrix.mul_apply, Fin.sum_univ_two, hM.1, hM.2, hN.1, hN.2]
      add_mem' := fun {M N} hM hN => ⟨by simp [hM.1, hN.1], by simp [hM.2, hN.2]⟩
      zero_mem' := ⟨rfl, rfl⟩
      smul_mem' := fun c {M} hM => ⟨by simp [hM.1], by simp [hM.2]⟩
      star_mem' := fun {M} hM =>
        ⟨by simp [CStarMatrix.star_apply, hM.2], by simp [CStarMatrix.star_apply, hM.1]⟩ }
  have hB_closed : IsClosed (B : Set (CStarMatrix (Fin 2) (Fin 2) ℂ)) :=
    (isClosed_eq ((continuous_apply (1 : Fin 2)).comp (continuous_apply (0 : Fin 2)))
      continuous_const).inter
      (isClosed_eq ((continuous_apply (0 : Fin 2)).comp (continuous_apply (1 : Fin 2)))
        continuous_const)
  refine ⟨B, hB_closed, fun hB => ?_⟩
  let b₁ : CStarMatrix (Fin 2) (Fin 2) ℂ := CStarMatrix.ofMatrix (Matrix.single 0 0 1)
  let b₂ : CStarMatrix (Fin 2) (Fin 2) ℂ := CStarMatrix.ofMatrix (Matrix.single 1 1 1)
  let a : CStarMatrix (Fin 2) (Fin 2) ℂ := CStarMatrix.ofMatrix (Matrix.single 0 1 1)
  have hb₁ : b₁ ∈ B := ⟨by simp [b₁], by simp [b₁]⟩
  have hb₂ : b₂ ∈ B := ⟨by simp [b₂], by simp [b₂]⟩
  have hmem : b₁ * a * b₂ ∈ B := hB.mul_mem hb₁ a hb₂
  have h01 : (b₁ * a * b₂) 0 1 = 1 := by
    simp [b₁, b₂, a, CStarMatrix.mul_apply, Fin.sum_univ_two]
  exact one_ne_zero (h01 ▸ hmem.1)

/-- In `CStarMatrix (Fin 2) (Fin 2) ℂ`, the rank-one projection `e₀₀` is positive and full, yet not
strictly positive. -/
theorem exists_isFull_and_not_isStrictlyPositive_matrix :
    ∃ e : CStarMatrix (Fin 2) (Fin 2) ℂ, 0 ≤ e ∧ IsFull e ∧ ¬IsStrictlyPositive e := by
  let e : CStarMatrix (Fin 2) (Fin 2) ℂ := CStarMatrix.ofMatrix (Matrix.single 0 0 1)
  have he_sq : star e * e = e := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [e, CStarMatrix.star_apply, CStarMatrix.mul_apply, Fin.sum_univ_two]
  have he_nonneg : 0 ≤ e := he_sq ▸ star_mul_self_nonneg e
  have he_full : IsFull e := by
    rw [isFull_def, ← TwoSidedIdeal.one_mem_iff]
    refine TwoSidedIdeal.le_topologicalClosure _ ?_
    let I := TwoSidedIdeal.span ({e} : Set (CStarMatrix (Fin 2) (Fin 2) ℂ))
    have heI : e ∈ I := TwoSidedIdeal.subset_span (Set.mem_singleton e)
    let u : CStarMatrix (Fin 2) (Fin 2) ℂ := CStarMatrix.ofMatrix (Matrix.single 1 0 1)
    let v : CStarMatrix (Fin 2) (Fin 2) ℂ := CStarMatrix.ofMatrix (Matrix.single 0 1 1)
    have he11 : u * e * v ∈ I := I.mul_mem_right (u * e) v (I.mul_mem_left u e heI)
    have hsum : e + u * e * v = 1 := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [e, u, v, CStarMatrix.mul_apply, Fin.sum_univ_two]
    exact hsum ▸ I.add_mem heI he11
  have he_not_sp : ¬IsStrictlyPositive e := by
    rw [isStrictlyPositive_iff_of_unital]
    intro h
    obtain ⟨u, hu⟩ := h.isUnit
    let u_inv : CStarMatrix (Fin 2) (Fin 2) ℂ := ↑u⁻¹
    have hmul : e * u_inv = 1 := hu ▸ u.mul_inv
    have h11 : (e * u_inv) 1 1 = 0 := by
      simp [e, CStarMatrix.mul_apply]
    have hone : (1 : CStarMatrix (Fin 2) (Fin 2) ℂ) 1 1 = 1 := CStarMatrix.one_apply_eq 1
    exact one_ne_zero (hone ▸ hmul ▸ h11)
  exact ⟨e, he_nonneg, he_full, he_not_sp⟩

end MatrixCounterexamples

end TauCeti.CStarAlgebra
