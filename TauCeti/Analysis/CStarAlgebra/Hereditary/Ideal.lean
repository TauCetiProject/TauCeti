/-!
# Closed ideals, hereditary subalgebras, and full vs. strictly positive elements

Every closed two-sided ideal of a C⋆-algebra — and in a unital C⋆-algebra every closed left ideal —
is hereditary in the spectral order (`TwoSidedIdeal.isHereditary_of_isClosed`,
`Ideal.isHereditary_of_isClosed`).

Conversely, if `B` is a closed hereditary `⋆`-subalgebra of a C⋆-algebra `A`, then closed two-sided
ideals `K` of `B` correspond bijectively and order-isomorphically to closed two-sided ideals `J` of
`A` contained in the closed ideal `B.closedIdeal = closure (span ℂ (A · B · A))` generated by `B`,
via `K ↦ closure (span ℂ (A · K · A))` (`NonUnitalStarSubalgebra.inducedClosedIdeal`) and
`J ↦ J ∩ B` (`NonUnitalStarSubalgebra.restrictIdeal`), packaged as
`NonUnitalStarSubalgebra.closedIdealOrderIso`.

At the single-element level, an element `a : A` is *full* (`TauCeti.IsFull`, defined in
`TauCeti.Topology.Algebra.Ring.TwoSidedIdeal`) when the closed two-sided ideal it generates is all
of `A`, whereas `a` is *strictly positive* (`TauCeti.CStarAlgebra.IsStrictlyPositive`) when `0 ≤ a`
and the hereditary C⋆-subalgebra `closure {a * x * a | x : A}` it generates is all of `A`. In unital
C⋆-algebras, strict positivity coincides with `0 ≤ a ∧ IsUnit a`
(`TauCeti.CStarAlgebra.isStrictlyPositive_iff_of_unital`), and every strictly positive element is
full (`TauCeti.CStarAlgebra.IsStrictlyPositive.isFull`). Concrete `2 × 2` matrix counterexamples
live in `TauCeti.Examples.Analysis.CStarAlgebra.Hereditary`.

## Main declarations

* `TwoSidedIdeal.isHereditary_of_isClosed` and `Ideal.isHereditary_of_isClosed`: closed ideals in
  C⋆-algebras are hereditary.
* `TwoSidedIdeal.mem_of_star_mul_self_mem_of_isClosed`,
  `TwoSidedIdeal.star_mul_self_mem_iff_of_isClosed`, and `Ideal.star_mul_self_mem_iff_of_isClosed`:
  for closed ideals in C⋆-algebras, `star x * x` lies in the ideal if and only if `x` does.
* `NonUnitalStarSubalgebra.closedIdeal`, `NonUnitalStarSubalgebra.restrictIdeal`, and
  `NonUnitalStarSubalgebra.inducedClosedIdeal`: the closed two-sided ideal generated by `B`,
  restriction `J ↦ J ∩ B`, and induction `K ↦ closure (span ℂ (A · K · A))` (with universal
  property `inducedClosedIdeal_le_iff`), packaged as the order isomorphism
  `NonUnitalStarSubalgebra.closedIdealOrderIso`.
* `TauCeti.CStarAlgebra.IsStrictlyPositive`: strictly positive elements in (possibly nonunital)
  C⋆-algebras, with `isStrictlyPositive_iff_hereditarySubalgebra_eq_top`,
  `isStrictlyPositive_iff_of_unital`, and `IsStrictlyPositive.isFull`.

## References

* B. Blackadar, *Operator Algebras: Theory of C⋆-Algebras and von Neumann Algebras*,
  II.5.1.1(ii), II.5.3.2, and II.5.3.5.
* G. J. Murphy, *C⋆-Algebras and Operator Theory*, Section 3.2, Theorems 3.2.1 and 3.2.7.
* G. K. Pedersen, *C⋆-Algebras and their Automorphism Groups*, Sections 1.5 and 3.10.
-/

public section

open Filter Topology
open scoped CStarAlgebra Pointwise

namespace TwoSidedIdeal

open TauCeti

/-- For a closed two-sided ideal `I` of a C⋆-algebra `A`, `star x * x ∈ I` implies `x ∈ I`. -/
theorem mem_of_star_mul_self_mem_of_isClosed {A : Type*} [NonUnitalCStarAlgebra A]
    (I : TwoSidedIdeal A) [hI : IsClosed (I : Set A)] {x : A} (hx : star x * x ∈ I) :
    x ∈ I :=
  (⟨I.toSubmodule, hI⟩ : ClosedSubmodule ℂ A).mem_of_star_mul_self_mem I.mul_mem_left hx

@[simp, grind =]
theorem star_mul_self_mem_iff_of_isClosed {A : Type*} [NonUnitalCStarAlgebra A]
    (I : TwoSidedIdeal A) [IsClosed (I : Set A)] {x : A} :
    star x * x ∈ I ↔ x ∈ I :=
  ⟨I.mem_of_star_mul_self_mem_of_isClosed, fun hx => I.mul_mem_left (star x) x hx⟩

@[simp, grind =]
theorem mul_star_self_mem_iff_of_isClosed {A : Type*} [NonUnitalCStarAlgebra A]
    (I : TwoSidedIdeal A) [IsClosed (I : Set A)] {x : A} :
    x * star x ∈ I ↔ x ∈ I := by
  simpa only [star_star] using
    (I.star_mul_self_mem_iff_of_isClosed (x := star x)).trans I.star_mem_iff_of_isClosed

/-- Every closed two-sided ideal of a C⋆-algebra is hereditary (Blackadar II.5.1.1(ii)). -/
@[simp]
theorem isHereditary_of_isClosed {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]
    [StarOrderedRing A] (I : TwoSidedIdeal A) [IsClosed (I : Set A)] :
    IsHereditary I :=
  (isHereditary_congr I.coe_toNonUnitalStarSubalgebra).mp <|
    I.toNonUnitalStarSubalgebra.isHereditary_of_mul_mem fun b₁ hb₁ a _ _ =>
      I.mem_toNonUnitalStarSubalgebra.mpr
        (I.mul_mem_right (b₁ * a) _ (I.mul_mem_right b₁ a (I.mem_toNonUnitalStarSubalgebra.mp hb₁)))

end TwoSidedIdeal

namespace Ideal

/-- For a closed left ideal `I` of a unital C⋆-algebra `A`, `star x * x ∈ I` implies `x ∈ I`. -/
theorem mem_of_star_mul_self_mem_of_isClosed {A : Type*} [CStarAlgebra A]
    (I : Ideal A) [hI : IsClosed (I : Set A)] {x : A} (hx : star x * x ∈ I) :
    x ∈ I := by
  let L : ClosedSubmodule ℂ A := ⟨I.restrictScalars ℂ, hI⟩
  exact L.mem_of_star_mul_self_mem (fun a _ hy => I.mul_mem_left a hy) hx

@[simp, grind =]
theorem star_mul_self_mem_iff_of_isClosed {A : Type*} [CStarAlgebra A]
    (I : Ideal A) [IsClosed (I : Set A)] {x : A} :
    star x * x ∈ I ↔ x ∈ I :=
  ⟨I.mem_of_star_mul_self_mem_of_isClosed, fun hx => I.mul_mem_left (star x) hx⟩

@[simp, grind =]
theorem mul_star_self_mem_iff_of_isClosed {A : Type*} [CStarAlgebra A]
    (I : Ideal A) [I.IsTwoSided] [IsClosed (I : Set A)] {x : A} :
    x * star x ∈ I ↔ x ∈ I := by
  simpa only [star_star] using
    (I.star_mul_self_mem_iff_of_isClosed (x := star x)).trans I.star_mem_iff_of_isClosed

/-- Every closed left ideal of a unital C⋆-algebra (in particular, every closed two-sided ideal) is
hereditary in the spectral order. -/
@[simp]
theorem isHereditary_of_isClosed {A : Type*} [CStarAlgebra A] [PartialOrder A]
    [StarOrderedRing A] (I : Ideal A) [hI : IsClosed (I : Set A)] :
    TauCeti.IsHereditary I := by
  let L : ClosedSubmodule ℂ A := ⟨I.restrictScalars ℂ, hI⟩
  exact (TauCeti.isHereditary_congr (s₁ := L) (s₂ := I) rfl).mp
    (L.isHereditary_of_mul_mem fun a _ hx => I.mul_mem_left a hx)

end Ideal

/-! ### Ideal correspondence for hereditary C⋆-subalgebras (Blackadar II.5.3.5) -/

namespace NonUnitalStarSubalgebra

open TauCeti TauCeti.CStarAlgebra

section IdealCorrespondence

variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- The closed two-sided ideal `closure (span ℂ (A · B · A))` of `A` generated by a `⋆`-subalgebra
`B`. -/
def closedIdeal (B : NonUnitalStarSubalgebra ℂ A) : TwoSidedIdeal A :=
  (TwoSidedIdeal.span (B : Set A)).topologicalClosure

instance isClosed_closedIdeal (B : NonUnitalStarSubalgebra ℂ A) :
    IsClosed (B.closedIdeal : Set A) :=
  TwoSidedIdeal.isClosed_topologicalClosure _

theorem subset_closedIdeal (B : NonUnitalStarSubalgebra ℂ A) :
    (B : Set A) ⊆ (B.closedIdeal : Set A) :=
  (TwoSidedIdeal.subset_span).trans (TwoSidedIdeal.le_topologicalClosure _)

theorem coe_closedIdeal (B : NonUnitalStarSubalgebra ℂ A) :
    (B.closedIdeal : Set A) =
      closure (Submodule.span ℂ (Set.univ * (B : Set A) * Set.univ) : Set A) :=
  TwoSidedIdeal.coe_topologicalClosure_span_eq_closure_span_univ_mul_univ (B : Set A)

theorem mem_closedIdeal {B : NonUnitalStarSubalgebra ℂ A} {a : A} :
    a ∈ B.closedIdeal ↔
      a ∈ closure (Submodule.span ℂ (Set.univ * (B : Set A) * Set.univ) : Set A) := by
  rw [← SetLike.mem_coe, B.coe_closedIdeal]

/-- For any closed two-sided ideal `J` of `A`, the closed two-sided ideal `B.closedIdeal` generated
by `B` is contained in `J` if and only if `(B : Set A) ⊆ (J : Set A)`. -/
@[simp, grind =]
theorem closedIdeal_le_iff {B : NonUnitalStarSubalgebra ℂ A} {J : TwoSidedIdeal A}
    [hJ : IsClosed (J : Set A)] :
    B.closedIdeal ≤ J ↔ (B : Set A) ⊆ (J : Set A) := by
  rw [closedIdeal, TwoSidedIdeal.topologicalClosure_le_iff _ J hJ, TwoSidedIdeal.span_le]

theorem closedIdeal_mono {B₁ B₂ : NonUnitalStarSubalgebra ℂ A} (h : B₁ ≤ B₂) :
    B₁.closedIdeal ≤ B₂.closedIdeal :=
  closedIdeal_le_iff.mpr <| (SetLike.coe_subset_coe.mpr h).trans B₂.subset_closedIdeal

@[simp]
theorem closedIdeal_bot : (⊥ : NonUnitalStarSubalgebra ℂ A).closedIdeal = ⊥ := by
  have : IsClosed ((⊥ : TwoSidedIdeal A) : Set A) :=
    TwoSidedIdeal.coe_bot (R := A) ▸ isClosed_singleton
  exact le_bot_iff.mp <|
    closedIdeal_le_iff.mpr (by simp [NonUnitalStarAlgebra.coe_bot, TwoSidedIdeal.coe_bot])

@[simp]
theorem closedIdeal_top : (⊤ : NonUnitalStarSubalgebra ℂ A).closedIdeal = ⊤ := by
  rw [← SetLike.coe_set_eq, TwoSidedIdeal.coe_top]
  exact Set.Subset.antisymm (Set.subset_univ _) <|
    (Set.subset_univ _).trans_eq (NonUnitalStarAlgebra.coe_top (R := ℂ) (A := A)).symm |>.trans
      (subset_closedIdeal ⊤)

/-- The closed two-sided ideal generated by `hereditarySubalgebra a` coincides with the closed
two-sided ideal generated by `a` itself. -/
@[simp]
theorem closedIdeal_hereditarySubalgebra (a : A) (ha : IsSelfAdjoint a := by cfc_tac) :
    (hereditarySubalgebra a ha).closedIdeal =
      (TwoSidedIdeal.span ({a} : Set A)).topologicalClosure := by
  let J := (TwoSidedIdeal.span ({a} : Set A)).topologicalClosure
  have hJ : IsClosed (J : Set A) := TwoSidedIdeal.isClosed_topologicalClosure _
  refine le_antisymm (closedIdeal_le_iff.mpr ?_) ?_
  · rw [coe_hereditarySubalgebra a ha]
    refine closure_minimal ?_ hJ
    rintro _ ⟨x, rfl⟩
    have haJ : a ∈ J := TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span rfl)
    exact J.mul_mem_right (a * x) a (J.mul_mem_right a x haJ)
  · refine (TwoSidedIdeal.topologicalClosure_le_iff _ _
      (hereditarySubalgebra a ha).isClosed_closedIdeal).mpr (TwoSidedIdeal.span_le.mpr ?_)
    rw [Set.singleton_subset_iff]
    exact (hereditarySubalgebra a ha).subset_closedIdeal (self_mem_hereditarySubalgebra a ha)

/-- Restrict a two-sided ideal `J` of `A` to a `⋆`-subalgebra `B`, with carrier `J ∩ B`. -/
def restrictIdeal (B : NonUnitalStarSubalgebra ℂ A) (J : TwoSidedIdeal A) : TwoSidedIdeal B :=
  J.comap (NonUnitalStarSubalgebraClass.subtype B)

@[simp, grind =]
theorem mem_restrictIdeal {B : NonUnitalStarSubalgebra ℂ A} {J : TwoSidedIdeal A} {b : B} :
    b ∈ B.restrictIdeal J ↔ (b : A) ∈ J :=
  TwoSidedIdeal.mem_comap (NonUnitalStarSubalgebraClass.subtype B)

@[simp]
theorem coe_restrictIdeal (B : NonUnitalStarSubalgebra ℂ A) (J : TwoSidedIdeal A) :
    (B.restrictIdeal J : Set B) = ((↑) : B → A) ⁻¹' (J : Set A) := by
  ext b
  exact B.mem_restrictIdeal

instance isClosed_restrictIdeal (B : NonUnitalStarSubalgebra ℂ A) (J : TwoSidedIdeal A)
    [hJ : IsClosed (J : Set A)] :
    IsClosed (B.restrictIdeal J : Set B) := by
  rw [B.coe_restrictIdeal]
  exact hJ.preimage continuous_subtypeVal

theorem restrictIdeal_mono (B : NonUnitalStarSubalgebra ℂ A) : Monotone B.restrictIdeal :=
  fun _ _ h _ hb => B.mem_restrictIdeal.mpr (h (B.mem_restrictIdeal.mp hb))

@[simp]
theorem restrictIdeal_bot (B : NonUnitalStarSubalgebra ℂ A) : B.restrictIdeal ⊥ = ⊥ := by
  ext b
  rw [B.mem_restrictIdeal, TwoSidedIdeal.mem_bot, ZeroMemClass.coe_eq_zero, TwoSidedIdeal.mem_bot]

@[simp]
theorem restrictIdeal_top (B : NonUnitalStarSubalgebra ℂ A) : B.restrictIdeal ⊤ = ⊤ := by
  ext b
  simp

@[simp]
theorem restrictIdeal_closedIdeal (B : NonUnitalStarSubalgebra ℂ A) :
    B.restrictIdeal B.closedIdeal = ⊤ := by
  ext b
  simp only [B.mem_restrictIdeal, TwoSidedIdeal.mem_top, iff_true]
  exact B.subset_closedIdeal b.property

/-- The closed two-sided ideal `closure (span ℂ (A · K · A))` of `A` induced by a two-sided ideal
`K` of `B`. -/
def inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A) (K : TwoSidedIdeal B) :
    TwoSidedIdeal A :=
  (K.map (NonUnitalStarSubalgebraClass.subtype B)).topologicalClosure

instance isClosed_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A) (K : TwoSidedIdeal B) :
    IsClosed (B.inducedClosedIdeal K : Set A) :=
  TwoSidedIdeal.isClosed_topologicalClosure _

theorem coe_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A) (K : TwoSidedIdeal B) :
    (B.inducedClosedIdeal K : Set A) =
      closure (Submodule.span ℂ
        (Set.univ * (((↑) : B → A) '' (K : Set B)) * Set.univ) : Set A) := by
  rw [inducedClosedIdeal, TwoSidedIdeal.map, NonUnitalStarSubalgebraClass.coe_subtype,
    TwoSidedIdeal.coe_topologicalClosure_span_eq_closure_span_univ_mul_univ]

theorem image_subset_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A) (K : TwoSidedIdeal B) :
    ((↑) '' (K : Set B) : Set A) ⊆ (B.inducedClosedIdeal K : Set A) := by
  rw [inducedClosedIdeal, TwoSidedIdeal.map, NonUnitalStarSubalgebraClass.coe_subtype]
  exact (TwoSidedIdeal.subset_span).trans (TwoSidedIdeal.le_topologicalClosure _)

theorem coe_mem_inducedClosedIdeal {B : NonUnitalStarSubalgebra ℂ A} {K : TwoSidedIdeal B}
    {b : B} (hb : b ∈ K) : (b : A) ∈ B.inducedClosedIdeal K :=
  B.image_subset_inducedClosedIdeal K ⟨b, hb, rfl⟩

/-- **Universal property of `inducedClosedIdeal`**: for any closed two-sided ideal `J` of `A`
(without assuming `B` closed or hereditary, or `K` closed), `B.inducedClosedIdeal K ≤ J` if and
only if `K ≤ B.restrictIdeal J`. -/
@[simp, grind =]
theorem inducedClosedIdeal_le_iff {B : NonUnitalStarSubalgebra ℂ A} {K : TwoSidedIdeal B}
    {J : TwoSidedIdeal A} [hJ : IsClosed (J : Set A)] :
    B.inducedClosedIdeal K ≤ J ↔ K ≤ B.restrictIdeal J := by
  rw [inducedClosedIdeal, TwoSidedIdeal.topologicalClosure_le_iff _ J hJ, TwoSidedIdeal.map,
    TwoSidedIdeal.span_le, NonUnitalStarSubalgebraClass.coe_subtype, Set.image_subset_iff,
    ← B.coe_restrictIdeal, SetLike.coe_subset_coe]

theorem inducedClosedIdeal_mono (B : NonUnitalStarSubalgebra ℂ A) :
    Monotone B.inducedClosedIdeal := fun _ _ h =>
  TwoSidedIdeal.topologicalClosure_mono
    (TwoSidedIdeal.map_mono (NonUnitalStarSubalgebraClass.subtype B) h)

@[simp]
theorem inducedClosedIdeal_bot (B : NonUnitalStarSubalgebra ℂ A) :
    B.inducedClosedIdeal ⊥ = ⊥ := by
  have : IsClosed ((⊥ : TwoSidedIdeal A) : Set A) :=
    TwoSidedIdeal.coe_bot (R := A) ▸ isClosed_singleton
  exact le_bot_iff.mp (B.inducedClosedIdeal_le_iff.mpr bot_le)

@[simp]
theorem inducedClosedIdeal_top (B : NonUnitalStarSubalgebra ℂ A) :
    B.inducedClosedIdeal ⊤ = B.closedIdeal := by
  have himg : (((↑) : B → A) '' ((⊤ : TwoSidedIdeal B) : Set B)) = (B : Set A) := by
    rw [TwoSidedIdeal.coe_top, Set.image_univ, Subtype.range_coe]
  rw [inducedClosedIdeal, TwoSidedIdeal.map, NonUnitalStarSubalgebraClass.coe_subtype, himg,
    closedIdeal]

theorem inducedClosedIdeal_le_closedIdeal (B : NonUnitalStarSubalgebra ℂ A)
    (K : TwoSidedIdeal B) :
    B.inducedClosedIdeal K ≤ B.closedIdeal :=
  B.inducedClosedIdeal_top ▸ B.inducedClosedIdeal_mono le_top

variable [PartialOrder A] [StarOrderedRing A]

/-- Two-sided compression `z ↦ e₁ * z * e₂` by elements of a hereditary `⋆`-subalgebra `B` maps
`B.inducedClosedIdeal K` into a closed two-sided ideal `K` of `B`. -/
private theorem mul_mem_of_mem_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : IsHereditary B) (K : TwoSidedIdeal B) [hK : IsClosed (K : Set B)]
    (e₁ e₂ : B) {z : A} (hz : z ∈ B.inducedClosedIdeal K) :
    (⟨(e₁ : A) * z * (e₂ : A), hB.mul_mem e₁.property z e₂.property⟩ : B) ∈ K := by
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  rw [← SetLike.mem_coe, B.coe_inducedClosedIdeal] at hz
  let Φ : A →ₗ[ℂ] B :=
    { toFun := fun w => ⟨(e₁ : A) * w * (e₂ : A), hB.mul_mem e₁.property w e₂.property⟩
      map_add' := fun w₁ w₂ => Subtype.ext (by simp only [mul_add, add_mul, AddMemClass.coe_add])
      map_smul' := fun c w =>
        Subtype.ext (by simp only [mul_smul_comm, smul_mul_assoc, RingHom.id_apply,
          SetLike.val_smul]) }
  have hΦ_cont : Continuous Φ :=
    Continuous.subtype_mk ((continuous_const.mul continuous_id).mul continuous_const) _
  let M : Submodule ℂ A := K.toSubmodule.comap Φ
  have hM_closed : IsClosed (M : Set A) := hK.preimage hΦ_cont
  have hle :
      closure (Submodule.span ℂ (Set.univ * (((↑) : B → A) '' (K : Set B)) * Set.univ) : Set A) ⊆
        (M : Set A) := by
    refine closure_minimal ?_ hM_closed
    rw [SetLike.coe_subset_coe, Submodule.span_le]
    rintro _ ⟨_, ⟨x, -, _, ⟨k, hk, rfl⟩, rfl⟩, y, -, rfl⟩
    rw [SetLike.mem_coe, Submodule.mem_comap, K.mem_toSubmodule]
    let S : NonUnitalStarSubalgebra ℂ B := K.toNonUnitalStarSubalgebra
    have _ : StarOrderedRing S := Subtype.starOrderedRing (𝕜 := ℂ) S
    have hlS : (CStarAlgebra.approximateUnit S).IsIncreasingApproximateUnit :=
      CStarAlgebra.increasingApproximateUnit S
    have := hlS.neBot
    let kS : S := ⟨k, K.mem_toNonUnitalStarSubalgebra.mpr hk⟩
    have hk_lim : Tendsto (fun u : S => ((u : B) : A) * (k : A) * ((u : B) : A))
        (CStarAlgebra.approximateUnit S) (𝓝 (k : A)) := by
      have h1 := (continuous_subtypeVal.tendsto kS).comp (hlS.tendsto_mul_self kS)
      simpa only [Function.comp_def, MulMemClass.coe_mul] using
        (continuous_subtypeVal.tendsto k).comp h1
    have hΦ_lim : Tendsto (fun u : S => Φ (x * (((u : B) : A) * (k : A) * ((u : B) : A)) * y))
        (CStarAlgebra.approximateUnit S) (𝓝 (Φ (x * (k : A) * y))) :=
      (hΦ_cont.tendsto _).comp ((hk_lim.const_mul x).mul_const y)
    refine hK.mem_of_tendsto hΦ_lim (Eventually.of_forall fun u => ?_)
    let b₁ : B := ⟨(e₁ : A) * x * ((u : B) : A), hB.mul_mem e₁.property x (u : B).property⟩
    let b₂ : B := ⟨((u : B) : A) * y * (e₂ : A), hB.mul_mem (u : B).property y e₂.property⟩
    have hEq : Φ (x * (((u : B) : A) * (k : A) * ((u : B) : A)) * y) = b₁ * k * b₂ :=
      Subtype.ext (by simp only [Φ, b₁, b₂, LinearMap.coe_mk, AddHom.coe_mk, MulMemClass.coe_mul,
        mul_assoc])
    rw [hEq]
    exact K.mul_mem_right _ b₂ (K.mul_mem_left b₁ k hk)
  exact K.mem_toSubmodule.mp (Submodule.mem_comap.mp (hle hz))

/-- For a closed two-sided ideal `K` of a closed hereditary `⋆`-subalgebra `B`, restricting the
induced closed ideal `closure (span ℂ (A · K · A))` back to `B` recovers `K`
(Blackadar II.5.3.5). -/
@[simp]
theorem restrictIdeal_inducedClosedIdeal (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : IsHereditary B)
    (K : TwoSidedIdeal B) [hK : IsClosed (K : Set B)] :
    B.restrictIdeal (B.inducedClosedIdeal K) = K := by
  have _ : StarOrderedRing B := Subtype.starOrderedRing (𝕜 := ℂ) B
  refine le_antisymm (fun b hb => ?_) (fun b hb =>
    B.mem_restrictIdeal.mpr (B.coe_mem_inducedClosedIdeal hb))
  let hlB : (CStarAlgebra.approximateUnit B).IsIncreasingApproximateUnit :=
    CStarAlgebra.increasingApproximateUnit B
  have := hlB.neBot
  refine hK.mem_of_tendsto (hlB.tendsto_mul_self b) (Eventually.of_forall fun e => ?_)
  exact B.mul_mem_of_mem_inducedClosedIdeal hB K e e (B.mem_restrictIdeal.mp hb)

/-- For any two-sided ideal `J` of `A` and a hereditary `⋆`-subalgebra `B`, multiplying any
`u ∈ J` by any `z ∈ B.closedIdeal` lands in `B.inducedClosedIdeal (B.restrictIdeal J)`. -/
private theorem mul_mem_inducedClosedIdeal_restrictIdeal (B : NonUnitalStarSubalgebra ℂ A)
    (hB : IsHereditary B) (J : TwoSidedIdeal A)
    {u : A} (hu : u ∈ J) {z : A} (hz : z ∈ B.closedIdeal) :
    u * z ∈ B.inducedClosedIdeal (B.restrictIdeal J) := by
  let K := B.restrictIdeal J
  let I' := B.inducedClosedIdeal K
  let M : Submodule ℂ A := I'.toSubmodule.comap (LinearMap.mulLeft ℂ u)
  have hM_closed : IsClosed (M : Set A) :=
    (B.isClosed_inducedClosedIdeal K).preimage (continuous_const.mul continuous_id)
  have hle : (B.closedIdeal : Set A) ⊆ (M : Set A) := by
    rw [B.coe_closedIdeal]
    refine closure_minimal ?_ hM_closed
    rw [SetLike.coe_subset_coe, Submodule.span_le]
    rintro _ ⟨_, ⟨x, -, b, hb, rfl⟩, y, -, rfl⟩
    rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply, I'.mem_toSubmodule]
    let v : A := u * x
    have hv : v ∈ J := J.mul_mem_right u x hu
    let w : A := v * b
    let k₀ : B := ⟨star b * (star v * v) * b, hB.mul_mem (star_mem hb) (star v * v) hb⟩
    have hk₀ : k₀ ∈ K := by
      rw [B.mem_restrictIdeal]
      have hEq : (k₀ : A) = (star b * star v) * (v * b) := by simp only [k₀, mul_assoc]
      rw [hEq]
      exact J.mul_mem_left (star b * star v) (v * b) (J.mul_mem_right v b hv)
    have hstar_w : star w * w ∈ I' := by
      have hEq : star w * w = (k₀ : A) := by simp only [w, k₀, star_mul, mul_assoc]
      rw [hEq]
      exact B.coe_mem_inducedClosedIdeal hk₀
    have hw : w ∈ I' := I'.mem_of_star_mul_self_mem_of_isClosed hstar_w
    have hmul_eq : u * (x * b * y) = w * y := by simp only [w, v, mul_assoc]
    rw [hmul_eq]
    exact I'.mul_mem_right w y hw
  exact I'.mem_toSubmodule.mp (Submodule.mem_comap.mp (hle hz))

/-- Every closed two-sided ideal `J` of `A` contained in `B.closedIdeal` is generated as a closed
ideal of `A` by its intersection `J ∩ B` with a hereditary `⋆`-subalgebra `B`
(Blackadar II.5.3.5). -/
@[simp]
theorem inducedClosedIdeal_restrictIdeal (B : NonUnitalStarSubalgebra ℂ A) (hB : IsHereditary B)
    (J : TwoSidedIdeal A) [IsClosed (J : Set A)] (hJB : J ≤ B.closedIdeal) :
    B.inducedClosedIdeal (B.restrictIdeal J) = J := by
  refine le_antisymm (B.inducedClosedIdeal_le_iff.mpr le_rfl) (fun z hz => ?_)
  let SJ : NonUnitalStarSubalgebra ℂ A := J.toNonUnitalStarSubalgebra
  have _ : StarOrderedRing SJ := Subtype.starOrderedRing (𝕜 := ℂ) SJ
  have hlJ : (CStarAlgebra.approximateUnit SJ).IsIncreasingApproximateUnit :=
    CStarAlgebra.increasingApproximateUnit SJ
  have := hlJ.neBot
  let zJ : SJ := ⟨z, J.mem_toNonUnitalStarSubalgebra.mpr hz⟩
  have hz_lim : Tendsto (fun u : SJ => (u : A) * z) (CStarAlgebra.approximateUnit SJ) (𝓝 z) := by
    simpa only [Function.comp_def, MulMemClass.coe_mul] using
      (continuous_subtypeVal.tendsto zJ).comp (hlJ.tendsto_mul_right zJ)
  refine (B.isClosed_inducedClosedIdeal _).mem_of_tendsto hz_lim (Eventually.of_forall fun u => ?_)
  exact B.mul_mem_inducedClosedIdeal_restrictIdeal hB J
    (J.mem_toNonUnitalStarSubalgebra.mp u.property) (hJB hz)

/-- **Blackadar II.5.3.5**: for a closed hereditary `⋆`-subalgebra `B` of a C⋆-algebra `A`, closed
two-sided ideals of `A` contained in `B.closedIdeal = closure (span ℂ (A · B · A))` are order
isomorphic to closed two-sided ideals of `B`, via `J ↦ J ∩ B` and
`K ↦ closure (span ℂ (A · K · A))`. -/
def closedIdealOrderIso (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B) :
    {J : TwoSidedIdeal A // IsClosed (J : Set A) ∧ J ≤ B.closedIdeal} ≃o
      {K : TwoSidedIdeal B // IsClosed (K : Set B)} :=
  OrderIso.ofHomInv
    { toFun := fun J => ⟨B.restrictIdeal J.val, @isClosed_restrictIdeal A _ B J.val J.property.1⟩
      monotone' := fun _ _ h => B.restrictIdeal_mono h }
    { toFun := fun K => ⟨B.inducedClosedIdeal K.val, B.isClosed_inducedClosedIdeal K.val,
        B.inducedClosedIdeal_le_closedIdeal K.val⟩
      monotone' := fun _ _ h => B.inducedClosedIdeal_mono h }
    (OrderHom.ext _ _ <| funext fun K => Subtype.ext <| by
      have := K.property
      exact B.restrictIdeal_inducedClosedIdeal hB K.val)
    (OrderHom.ext _ _ <| funext fun J => Subtype.ext <| by
      have := J.property.1
      exact B.inducedClosedIdeal_restrictIdeal hB J.val J.property.2)

@[simp]
theorem coe_closedIdealOrderIso_apply (B : NonUnitalStarSubalgebra ℂ A) [IsClosed (B : Set A)]
    (hB : IsHereditary B)
    (J : {J : TwoSidedIdeal A // IsClosed (J : Set A) ∧ J ≤ B.closedIdeal}) :
    (B.closedIdealOrderIso hB J).val = B.restrictIdeal J.val :=
  (rfl)

@[simp]
theorem coe_closedIdealOrderIso_symm_apply (B : NonUnitalStarSubalgebra ℂ A)
    [IsClosed (B : Set A)] (hB : IsHereditary B)
    (K : {K : TwoSidedIdeal B // IsClosed (K : Set B)}) :
    ((B.closedIdealOrderIso hB).symm K).val = B.inducedClosedIdeal K.val :=
  (rfl)

end IdealCorrespondence

end NonUnitalStarSubalgebra

/-! ### Strictly positive elements and comparison with fullness -/

namespace TauCeti.CStarAlgebra

section StrictlyPositive

/-- An element `a` of a (possibly nonunital) C⋆-algebra `A` is *strictly positive* if `0 ≤ a` and
the hereditary C⋆-subalgebra `closure {a * x * a | x : A}` generated by `a` is all of `A`.
In unital C⋆-algebras this coincides with Mathlib's `_root_.IsStrictlyPositive`
(`TauCeti.CStarAlgebra.isStrictlyPositive_iff_of_unital`). -/
protected def IsStrictlyPositive {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]
    (a : A) : Prop :=
  0 ≤ a ∧ closure (Set.range fun x : A => a * x * a) = Set.univ

@[grind =]
theorem isStrictlyPositive_def {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] {a : A} :
    CStarAlgebra.IsStrictlyPositive a ↔
      0 ≤ a ∧ closure (Set.range fun x : A => a * x * a) = Set.univ :=
  Iff.rfl

@[aesop 20% apply (rule_sets := [CStarAlgebra]), grind →]
theorem IsStrictlyPositive.nonneg {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] {a : A}
    (ha : CStarAlgebra.IsStrictlyPositive a) : 0 ≤ a :=
  ha.1

@[grind →]
theorem IsStrictlyPositive.closure_range_eq_univ {A : Type*} [NonUnitalCStarAlgebra A]
    [PartialOrder A] {a : A} (ha : CStarAlgebra.IsStrictlyPositive a) :
    closure (Set.range fun x : A => a * x * a) = Set.univ :=
  ha.2

@[grind →]
theorem IsStrictlyPositive.isSelfAdjoint {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]
    [StarOrderedRing A] {a : A} (ha : CStarAlgebra.IsStrictlyPositive a) : IsSelfAdjoint a :=
  ha.1.isSelfAdjoint

theorem IsStrictlyPositive.hereditarySubalgebra_eq_top {A : Type*} [NonUnitalCStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A] {a : A} (ha : CStarAlgebra.IsStrictlyPositive a) :
    hereditarySubalgebra a ha.isSelfAdjoint = ⊤ := by
  rw [← SetLike.coe_set_eq, coe_hereditarySubalgebra a ha.isSelfAdjoint,
    NonUnitalStarAlgebra.coe_top]
  exact ha.2

/-- A positive element `a` (`0 ≤ a`) of a C⋆-algebra `A` is strictly positive if and only if the
hereditary C⋆-subalgebra `hereditarySubalgebra a` it generates equals `⊤`. -/
theorem isStrictlyPositive_iff_hereditarySubalgebra_eq_top {A : Type*} [NonUnitalCStarAlgebra A]
    [PartialOrder A] [StarOrderedRing A] {a : A} (ha : 0 ≤ a) :
    CStarAlgebra.IsStrictlyPositive a ↔ hereditarySubalgebra a ha.isSelfAdjoint = ⊤ := by
  rw [← SetLike.coe_set_eq, isStrictlyPositive_def, coe_hereditarySubalgebra a ha.isSelfAdjoint,
    NonUnitalStarAlgebra.coe_top]
  exact and_iff_right ha

/-- Every strictly positive element of a C⋆-algebra is full. -/
@[grind →]
theorem IsStrictlyPositive.isFull {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A] {a : A}
    (ha : CStarAlgebra.IsStrictlyPositive a) : IsFull a := by
  let I := (TwoSidedIdeal.span ({a} : Set A)).topologicalClosure
  have haI : a ∈ I := TwoSidedIdeal.le_topologicalClosure _ (TwoSidedIdeal.subset_span rfl)
  have hsub : (Set.univ : Set A) ⊆ (I : Set A) := by
    rw [← ha.closure_range_eq_univ]
    refine closure_minimal ?_ (TwoSidedIdeal.isClosed_topologicalClosure _)
    rintro _ ⟨x, rfl⟩
    exact I.mul_mem_right (a * x) a (I.mul_mem_right a x haI)
  rw [isFull_def, ← SetLike.coe_set_eq, TwoSidedIdeal.coe_top]
  exact Set.Subset.antisymm (Set.subset_univ _) hsub

@[simp]
theorem not_isStrictlyPositive_zero {A : Type*} [NonUnitalCStarAlgebra A] [PartialOrder A]
    [Nontrivial A] : ¬CStarAlgebra.IsStrictlyPositive (0 : A) :=
  fun h => not_isFull_zero h.isFull

/-- In a unital C⋆-algebra, `TauCeti.CStarAlgebra.IsStrictlyPositive a` (`0 ≤ a` and
`closure (a · A · a) = A`) is equivalent to Mathlib's `_root_.IsStrictlyPositive a`
(`0 ≤ a ∧ IsUnit a`). -/
theorem isStrictlyPositive_iff_of_unital {A : Type*} [CStarAlgebra A] [PartialOrder A] {a : A} :
    CStarAlgebra.IsStrictlyPositive a ↔ _root_.IsStrictlyPositive a := by
  rw [isStrictlyPositive_def, _root_.IsStrictlyPositive.iff_of_unital]
  refine and_congr_right fun _ => ⟨fun hdense => ?_, fun hu => ?_⟩
  · have h1 : (1 : A) ∈ closure (Set.range fun x : A => a * x * a) :=
      hdense ▸ Set.mem_univ (1 : A)
    obtain ⟨_, ⟨x, rfl⟩, hdist⟩ := Metric.mem_closure_iff.mp h1 1 one_pos
    rw [dist_eq_norm] at hdist
    let u : Aˣ := Units.oneSub (1 - a * x * a) hdist
    have hu_val : (u : A) = a * x * a := by
      rw [Units.val_oneSub, sub_sub_cancel]
    exact isUnit_iff_exists_and_exists.mpr
      ⟨⟨x * a * ↑u⁻¹, by
          calc
            a * (x * a * ↑u⁻¹) = (a * x * a) * ↑u⁻¹ := by simp only [mul_assoc]
            _ = 1 := by rw [← hu_val, u.mul_inv]⟩,
       ⟨↑u⁻¹ * a * x, by
          calc
            ↑u⁻¹ * a * x * a = ↑u⁻¹ * (a * x * a) := by simp only [mul_assoc]
            _ = 1 := by rw [← hu_val, u.inv_mul]⟩⟩
  · obtain ⟨u, rfl⟩ := hu
    refine Set.Subset.antisymm (Set.subset_univ _) fun y _ => subset_closure ⟨↑u⁻¹ * y * ↑u⁻¹, ?_⟩
    calc
      (u : A) * (↑u⁻¹ * y * ↑u⁻¹) * (u : A) = ((u : A) * ↑u⁻¹) * y * (↑u⁻¹ * (u : A)) := by
        simp only [mul_assoc]
      _ = y := by rw [u.mul_inv, u.inv_mul, one_mul, mul_one]

@[simp, grind .]
protected theorem isStrictlyPositive_one {A : Type*} [CStarAlgebra A] [PartialOrder A]
    [StarOrderedRing A] :
    CStarAlgebra.IsStrictlyPositive (1 : A) :=
  isStrictlyPositive_iff_of_unital.mpr
    (_root_.IsStrictlyPositive.iff_of_unital.mpr ⟨zero_le_one, isUnit_one⟩)

end StrictlyPositive

end TauCeti.CStarAlgebra
