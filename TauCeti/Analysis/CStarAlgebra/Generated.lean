/-!
# C⋆-subalgebras generated by operator families

Given a family `T : ι → A` in a topological `R`-⋆-algebra `A`, `TauCeti.generatedCStarAlgebra R T`
is the topological closure `(StarAlgebra.adjoin R (Set.range T)).topologicalClosure` of the unital
⋆-subalgebra generated by `T`. When `R = ℂ` and `A` is `H →L[ℂ] H` for a Hilbert space `H`, this
is the C⋆-subalgebra generated by `T`, and `TauCeti.starOrderedRing_generatedCStarAlgebra` equips it
with the inherited star-ordered ring structure.

## Main definitions

* `TauCeti.generatedCStarAlgebra`: the norm-closed unital ⋆-subalgebra generated by a family `T`.
* `TauCeti.generatedCStarAlgebraEquiv`: transport of `generatedCStarAlgebra` along a continuous
  ⋆-algebra equivalence matching the generators.
* `TauCeti.starOrderedRing_generatedCStarAlgebra`: the inherited `StarOrderedRing` structure on
  `generatedCStarAlgebra ℂ T` for bounded operators on a complex Hilbert space.

## Main results

* `TauCeti.generatedCStarAlgebra_le_iff`: minimality among closed unital ⋆-subalgebras containing
  `T`.
* `TauCeti.denseRange_inclusion_adjoin_generatedCStarAlgebra`: density of
  `StarAlgebra.adjoin R (Set.range T)` inside `generatedCStarAlgebra R T`.
* `TauCeti.generatedCStarAlgebra_induction`: closed predicates on `generatedCStarAlgebra R T` are
  determined on `StarAlgebra.adjoin R (Set.range T)`.
-/

public section

namespace TauCeti

section GeneratedCStarAlgebra

variable (R : Type*) {A ι : Type*} [CommSemiring R] [StarRing R]
  [TopologicalSpace A] [Semiring A] [StarRing A] [Algebra R A] [StarModule R A]
  [IsSemitopologicalSemiring A] [ContinuousStar A]

/-- The closed unital ⋆-subalgebra generated by a family `T : ι → A`: the topological closure of
the unital `R`-⋆-subalgebra generated by the range of `T`. -/
def generatedCStarAlgebra (T : ι → A) : StarSubalgebra R A :=
  (StarAlgebra.adjoin R (Set.range T)).topologicalClosure

/-- Unfolding lemma for `generatedCStarAlgebra`. -/
theorem generatedCStarAlgebra_def (T : ι → A) :
    generatedCStarAlgebra R T = (StarAlgebra.adjoin R (Set.range T)).topologicalClosure :=
  (rfl)

/-- The generated closed ⋆-subalgebra is closed. -/
instance isClosed_generatedCStarAlgebra (T : ι → A) :
    IsClosed (generatedCStarAlgebra R T : Set A) :=
  StarSubalgebra.isClosed_topologicalClosure _

/-- Every generator belongs to the generated closed ⋆-subalgebra. -/
@[simp]
theorem apply_mem_generatedCStarAlgebra (T : ι → A) (i : ι) :
    T i ∈ generatedCStarAlgebra R T :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin R _ ⟨i, rfl⟩)

/-- The unital ⋆-subalgebra generated by `T` is contained in `generatedCStarAlgebra R T`. -/
theorem starAlgebra_adjoin_le_generatedCStarAlgebra (T : ι → A) :
    StarAlgebra.adjoin R (Set.range T) ≤ generatedCStarAlgebra R T :=
  StarSubalgebra.le_topologicalClosure _

/-- The unital ⋆-algebra generated by `T` is dense in `generatedCStarAlgebra R T`. -/
theorem denseRange_inclusion_adjoin_generatedCStarAlgebra (T : ι → A) :
    DenseRange (Set.inclusion (starAlgebra_adjoin_le_generatedCStarAlgebra R T)) := by
  rw [denseRange_inclusion_iff (starAlgebra_adjoin_le_generatedCStarAlgebra R T)]
  intro x hx
  simpa [generatedCStarAlgebra_def, StarSubalgebra.topologicalClosure_coe] using hx

variable {R}

/-- A closed ⋆-subalgebra contains `generatedCStarAlgebra R T` if and only if it contains every
generator `T i`. -/
theorem generatedCStarAlgebra_le_iff {T : ι → A}
    {B : StarSubalgebra R A} (hB : IsClosed (B : Set A)) :
    generatedCStarAlgebra R T ≤ B ↔ ∀ i, T i ∈ B := by
  refine ⟨fun h i ↦ h (apply_mem_generatedCStarAlgebra R T i), fun h ↦ ?_⟩
  rw [generatedCStarAlgebra_def]
  exact StarSubalgebra.topologicalClosure_minimal
    (StarAlgebra.adjoin_le (by rintro _ ⟨i, rfl⟩; exact h i)) hB

/-- A closed predicate on `generatedCStarAlgebra R T` holds everywhere once it holds on the dense
⋆-subalgebra `StarAlgebra.adjoin R (Set.range T)`. -/
@[elab_as_elim]
theorem generatedCStarAlgebra_induction {T : ι → A}
    {p : generatedCStarAlgebra R T → Prop}
    (hp : IsClosed {x : generatedCStarAlgebra R T | p x})
    (ih : ∀ x (hx : x ∈ StarAlgebra.adjoin R (Set.range T)),
      p ⟨x, starAlgebra_adjoin_le_generatedCStarAlgebra R T hx⟩)
    (x : generatedCStarAlgebra R T) : p x :=
  (denseRange_inclusion_adjoin_generatedCStarAlgebra R T).induction_on x hp fun ⟨a, ha⟩ ↦ by
    rw [Set.inclusion_mk]
    exact ih a ha

end GeneratedCStarAlgebra

section Equiv

variable {R A B ι : Type*} [CommSemiring R] [StarRing R]
  [TopologicalSpace A] [Semiring A] [StarRing A] [Algebra R A] [StarModule R A]
  [IsSemitopologicalSemiring A] [ContinuousStar A]
  [TopologicalSpace B] [Semiring B] [StarRing B] [Algebra R B] [StarModule R B]
  [IsSemitopologicalSemiring B] [ContinuousStar B]

/-- A bicontinuous `R`-⋆-algebra equivalence sending a generating family `T₁` to `T₂` restricts to
a ⋆-algebra equivalence between `generatedCStarAlgebra R T₁` and `generatedCStarAlgebra R T₂`. -/
def generatedCStarAlgebraEquiv (e : A ≃⋆ₐ[R] B) (he : Continuous e) (he_symm : Continuous e.symm)
    {T₁ : ι → A} {T₂ : ι → B} (hT : ∀ i, e (T₁ i) = T₂ i) :
    generatedCStarAlgebra R T₁ ≃⋆ₐ[R] generatedCStarAlgebra R T₂ where
  toFun x := ⟨e x, by
    have hle : generatedCStarAlgebra R T₁ ≤
        (generatedCStarAlgebra R T₂).comap e.toStarAlgHom :=
      (generatedCStarAlgebra_le_iff
        ((isClosed_generatedCStarAlgebra R T₂).preimage he)).2 fun i ↦ by
        simp [hT i]
    exact hle x.property⟩
  invFun y := ⟨e.symm y, by
    have hle : generatedCStarAlgebra R T₂ ≤
        (generatedCStarAlgebra R T₁).comap e.symm.toStarAlgHom :=
      (generatedCStarAlgebra_le_iff
        ((isClosed_generatedCStarAlgebra R T₁).preimage he_symm)).2 fun i ↦ by
        simp [← hT i]
    exact hle y.property⟩
  left_inv x := Subtype.ext (e.symm_apply_apply _)
  right_inv y := Subtype.ext (e.apply_symm_apply _)
  map_mul' _ _ := Subtype.ext (map_mul e _ _)
  map_add' _ _ := Subtype.ext (map_add e _ _)
  map_smul' _ _ := Subtype.ext (map_smul e _ _)
  map_star' _ := Subtype.ext (map_star e _)

/-- Coercing `generatedCStarAlgebraEquiv` to the ambient algebra applies `e`. -/
@[simp, norm_cast]
theorem coe_generatedCStarAlgebraEquiv_apply (e : A ≃⋆ₐ[R] B) (he : Continuous e)
    (he_symm : Continuous e.symm) {T₁ : ι → A} {T₂ : ι → B} (hT : ∀ i, e (T₁ i) = T₂ i)
    (x : generatedCStarAlgebra R T₁) :
    (generatedCStarAlgebraEquiv e he he_symm hT x : B) = e x :=
  (rfl)

/-- Coercing the inverse of `generatedCStarAlgebraEquiv` to the ambient algebra applies `e.symm`. -/
@[simp, norm_cast]
theorem coe_generatedCStarAlgebraEquiv_symm_apply (e : A ≃⋆ₐ[R] B) (he : Continuous e)
    (he_symm : Continuous e.symm) {T₁ : ι → A} {T₂ : ι → B} (hT : ∀ i, e (T₁ i) = T₂ i)
    (y : generatedCStarAlgebra R T₂) :
    ((generatedCStarAlgebraEquiv e he he_symm hT).symm y : A) = e.symm y :=
  (rfl)

/-- `generatedCStarAlgebraEquiv` is continuous when `e` is continuous. -/
@[fun_prop]
theorem continuous_generatedCStarAlgebraEquiv (e : A ≃⋆ₐ[R] B) (he : Continuous e)
    (he_symm : Continuous e.symm) {T₁ : ι → A} {T₂ : ι → B} (hT : ∀ i, e (T₁ i) = T₂ i) :
    Continuous (generatedCStarAlgebraEquiv e he he_symm hT) :=
  (he.comp continuous_subtypeVal).subtype_mk _

/-- The inverse of `generatedCStarAlgebraEquiv` is continuous when `e.symm` is continuous. -/
@[fun_prop]
theorem continuous_generatedCStarAlgebraEquiv_symm (e : A ≃⋆ₐ[R] B) (he : Continuous e)
    (he_symm : Continuous e.symm) {T₁ : ι → A} {T₂ : ι → B} (hT : ∀ i, e (T₁ i) = T₂ i) :
    Continuous (generatedCStarAlgebraEquiv e he he_symm hT).symm :=
  (he_symm.comp continuous_subtypeVal).subtype_mk _

end Equiv

section StarOrderedRing

/-- The order on `generatedCStarAlgebra ℂ T` inherited from the Loewner order on `H →L[ℂ] H`
makes it a star-ordered ring. This specializes `Subtype.starOrderedRing`, whose instance search
over operators on a concrete Hilbert space otherwise rebuilds their continuous functional calculus
and fails or times out. -/
instance starOrderedRing_generatedCStarAlgebra {H ι : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] (T : ι → (H →L[ℂ] H)) :
    StarOrderedRing (generatedCStarAlgebra ℂ T) :=
  Subtype.starOrderedRing (𝕜 := ℂ) (generatedCStarAlgebra ℂ T)

end StarOrderedRing

end TauCeti
