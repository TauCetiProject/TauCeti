module

public import Mathlib.Analysis.Complex.Basic
public import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# C⋆-subalgebras generated by operator families

Given a family `T : ι → A` in a topological ℂ-⋆-algebra `A`, `TauCeti.generatedCStarAlgebra T`
is the topological closure `(StarAlgebra.adjoin ℂ (Set.range T)).topologicalClosure` of the unital
⋆-subalgebra generated by `T`. When `A` is a unital C⋆-algebra (for instance `H →L[ℂ] H`), this
is the C⋆-subalgebra generated by `T`.

## Main definitions

* `TauCeti.generatedCStarAlgebra`: the norm-closed unital ⋆-subalgebra generated by a family `T`.

## Main results

* `TauCeti.generatedCStarAlgebra_le_iff`: minimality among closed unital ⋆-subalgebras containing
  `T`.
* `TauCeti.denseRange_inclusion_adjoin_generatedCStarAlgebra`: density of
  `StarAlgebra.adjoin ℂ (Set.range T)` inside `generatedCStarAlgebra T`.
* `TauCeti.induction_generatedCStarAlgebra`: closed predicates on `generatedCStarAlgebra T` are
  determined on `StarAlgebra.adjoin ℂ (Set.range T)`.
-/

public section

namespace TauCeti

section GeneratedCStarAlgebra

variable {A ι : Type*} [TopologicalSpace A] [Semiring A] [StarRing A]
  [Algebra ℂ A] [StarModule ℂ A] [IsSemitopologicalSemiring A] [ContinuousStar A]

/-- The C⋆-subalgebra generated by a family `T : ι → A`: the topological closure of the unital
⋆-subalgebra generated by the range of `T`. -/
def generatedCStarAlgebra (T : ι → A) : StarSubalgebra ℂ A :=
  (StarAlgebra.adjoin ℂ (Set.range T)).topologicalClosure

/-- Unfolding lemma for `generatedCStarAlgebra`. -/
theorem generatedCStarAlgebra_def (T : ι → A) :
    generatedCStarAlgebra T = (StarAlgebra.adjoin ℂ (Set.range T)).topologicalClosure :=
  (rfl)

/-- The generated C⋆-subalgebra is closed. -/
instance isClosed_generatedCStarAlgebra (T : ι → A) :
    IsClosed (generatedCStarAlgebra T : Set A) :=
  StarSubalgebra.isClosed_topologicalClosure _

/-- Every generator belongs to the generated C⋆-subalgebra. -/
@[simp]
theorem apply_mem_generatedCStarAlgebra (T : ι → A) (i : ι) :
    T i ∈ generatedCStarAlgebra T :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨i, rfl⟩)

/-- The unital ⋆-subalgebra generated by `T` is contained in `generatedCStarAlgebra T`. -/
theorem starAlgebra_adjoin_le_generatedCStarAlgebra (T : ι → A) :
    StarAlgebra.adjoin ℂ (Set.range T) ≤ generatedCStarAlgebra T :=
  StarSubalgebra.le_topologicalClosure _

/-- A closed ⋆-subalgebra contains `generatedCStarAlgebra T` if and only if it contains every
generator `T i`. -/
theorem generatedCStarAlgebra_le_iff {T : ι → A}
    {B : StarSubalgebra ℂ A} (hB : IsClosed (B : Set A)) :
    generatedCStarAlgebra T ≤ B ↔ ∀ i, T i ∈ B := by
  refine ⟨fun h i ↦ h (apply_mem_generatedCStarAlgebra T i), fun h ↦ ?_⟩
  rw [generatedCStarAlgebra_def]
  exact StarSubalgebra.topologicalClosure_minimal
    (StarAlgebra.adjoin_le (by rintro _ ⟨i, rfl⟩; exact h i)) hB

/-- The unital ⋆-algebra generated by `T` is dense in `generatedCStarAlgebra T`. -/
theorem denseRange_inclusion_adjoin_generatedCStarAlgebra (T : ι → A) :
    DenseRange (Set.inclusion (starAlgebra_adjoin_le_generatedCStarAlgebra T)) := by
  rw [denseRange_inclusion_iff (starAlgebra_adjoin_le_generatedCStarAlgebra T)]
  intro x hx
  simpa [generatedCStarAlgebra_def, StarSubalgebra.topologicalClosure_coe] using hx

/-- A closed predicate on `generatedCStarAlgebra T` holds everywhere once it holds on the dense
⋆-subalgebra `StarAlgebra.adjoin ℂ (Set.range T)`. -/
@[elab_as_elim]
theorem induction_generatedCStarAlgebra {T : ι → A}
    {p : generatedCStarAlgebra T → Prop}
    (hp : IsClosed {x : generatedCStarAlgebra T | p x})
    (ih : ∀ x (hx : x ∈ StarAlgebra.adjoin ℂ (Set.range T)),
      p ⟨x, starAlgebra_adjoin_le_generatedCStarAlgebra T hx⟩)
    (x : generatedCStarAlgebra T) : p x :=
  (denseRange_inclusion_adjoin_generatedCStarAlgebra T).induction_on x hp fun ⟨a, ha⟩ ↦ by
    rw [Set.inclusion_mk]
    exact ih a ha

end GeneratedCStarAlgebra

end TauCeti
