/-!
# The universal C⋆-algebra generated by unitaries

For a type `ι : Type u`, the *universal unital C⋆-algebra on unitary generators indexed by `ι`*
is the completion of the group ⋆-algebra `ℂ[F_ι]` of the free group on `ι` in the universal
C⋆-seminorm

`‖x‖ᵤ = sup ‖ρ(x)‖`,

the supremum over all unitary representations `ρ` of `F_ι` on Hilbert spaces, that is, over all
families of unitaries indexed by `ι` (Blackadar II.8.3.1–II.8.3.2). For `ι = ℕ` this is
`C*(F_∞)`, the universal C⋆-algebra on countably many unitaries.

The supremum ranges over representations on Hilbert spaces in the universe `u`. This loses
nothing: every vector of a representation on a Hilbert space in any universe lies in an invariant
subspace isometric to a Hilbert space in the universe `u`, the closure of its orbit under
`ℂ[F_ι] : Type u`. So every ⋆-representation of `ℂ[F_ι]` on any Hilbert space, and by the
Gelfand–Naimark theorem every unital ⋆-homomorphism into any unital C⋆-algebra, is bounded by the
universal seminorm (`UniversalUnitaryCStarAlgebra.norm_apply_le_universalSeminorm`). Since every
group element acts unitarily, the supremum is bounded by the `ℓ¹` norm of the coefficients.

The completion `UniversalUnitaryCStarAlgebra ι` is a unital C⋆-algebra. Its generators
`UniversalUnitaryCStarAlgebra.generator i` are unitaries, and it has the universal property:
every family of unitaries `ι → unitary B` in a unital C⋆-algebra `B`, in any universe, comes from
a unique unital ⋆-homomorphism (`UniversalUnitaryCStarAlgebra.lift`). It is separable when `ι` is
countable. A definition through a single representation, for instance the left regular one,
would lose the universal property.

## Main definitions

* `TauCeti.UniversalUnitaryCStarAlgebra.universalSeminorm`: the universal C⋆-seminorm on
  `ℂ[F_ι]`.
* `TauCeti.FreeUnitaryAlgebra ι`: the group ⋆-algebra `ℂ[F_ι]` with the universal seminorm.
* `TauCeti.UniversalUnitaryCStarAlgebra ι`: its completion, a unital C⋆-algebra; for `ι = ℕ`
  this is `C*(F_∞)`.
* `TauCeti.UniversalUnitaryCStarAlgebra.of`: the canonical unital ⋆-homomorphism from `ℂ[F_ι]`,
  with dense range.
* `TauCeti.UniversalUnitaryCStarAlgebra.generator`: the unitary generators.
* `TauCeti.UniversalUnitaryCStarAlgebra.lift`: unital ⋆-homomorphisms into a unital C⋆-algebra
  `B` are the families of unitaries of `B` indexed by `ι`.

## Main statements

* `TauCeti.UniversalUnitaryCStarAlgebra.norm_apply_le_universalSeminorm`: every unital
  ⋆-homomorphism from `ℂ[F_ι]` into a unital C⋆-algebra is bounded by the universal seminorm.
* `TauCeti.UniversalUnitaryCStarAlgebra.universalSeminorm_le_iff`: the universal seminorm is the
  least bound for the representations on Hilbert spaces in the universe of `ι`.
* `TauCeti.UniversalUnitaryCStarAlgebra.norm_of`: `‖of x‖ = ‖x‖ᵤ`.
* `TauCeti.UniversalUnitaryCStarAlgebra.lift_generator` and
  `TauCeti.UniversalUnitaryCStarAlgebra.hom_ext`: the universal property.
* `TauCeti.UniversalUnitaryCStarAlgebra.topologicalClosure_adjoin_range_generator`: the
  generators generate it as a C⋆-algebra.
* `TauCeti.UniversalUnitaryCStarAlgebra.instSeparableSpace`: it is separable for countable `ι`.

## References

* B. Blackadar, *Operator Algebras: Theory of C⋆-Algebras and von Neumann Algebras*,
  II.8.3.1–II.8.3.2.
-/

public section

noncomputable section

open UniformSpace MonoidAlgebra

namespace TauCeti

universe u w

namespace UniversalUnitaryCStarAlgebra

/-- A unitary of a C⋆-ring has norm at most `1`; it is `0` in the zero ring. -/
private theorem norm_le_one_of_mem_unitary {E : Type*} [NormedRing E] [StarRing E] [CStarRing E]
    {U : E} (hU : U ∈ unitary E) : ‖U‖ ≤ 1 := by
  rcases subsingleton_or_nontrivial E with _ | _
  · simp [Subsingleton.elim U 0]
  · exact (CStarRing.norm_of_mem_unitary hU).le

/-- A unital ⋆-homomorphism from a group algebra into a C⋆-algebra is bounded by the `ℓ¹` norm of
the coefficients, since group elements map to unitaries. -/
theorem norm_apply_le_sum_norm_coeff {G B : Type*} [Group G] [NormedRing B] [StarRing B]
    [CStarRing B] [NormedAlgebra ℂ B]
    (ρ : MonoidAlgebra ℂ G →⋆ₐ[ℂ] B) (x : MonoidAlgebra ℂ G) :
    ‖ρ x‖ ≤ x.coeff.sum fun _ r => ‖r‖ := by
  conv_lhs => rw [← sum_coeff_single x]
  rw [Finsupp.sum, map_sum]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun g _ => ?_)
  have hg : single g (x.coeff g) = x.coeff g • single g (1 : ℂ) := by simp
  rw [hg, map_smul]
  refine (norm_smul_le _ _).trans ?_
  simpa using mul_le_mul_of_nonneg_left
    (norm_le_one_of_mem_unitary (Unitary.map_mem ρ (single_one_mem_unitary g)))
    (norm_nonneg (x.coeff g))

variable {ι : Type u}

variable (ι) in
/-- The seminorms `x ↦ ‖ρ x‖` of the unitary representations `ρ` of `F_ι` on Hilbert spaces in
the universe `u`. -/
private def representationSeminorms : Set (Seminorm ℂ (MonoidAlgebra ℂ (FreeGroup ι))) :=
  {p | ∃ (H : Type u) (_ : NormedAddCommGroup H) (_ : InnerProductSpace ℂ H)
    (_ : CompleteSpace H) (ρ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] (H →L[ℂ] H)),
      p = (normSeminorm ℂ (H →L[ℂ] H)).comp
        (ρ : MonoidAlgebra ℂ (FreeGroup ι) →ₗ[ℂ] (H →L[ℂ] H))}

private theorem bddAbove_representationSeminorms : BddAbove (representationSeminorms ι) :=
  Seminorm.bddAbove_iff.2 ⟨fun x => x.coeff.sum fun _ r => ‖r‖, by
    rintro _ ⟨_, ⟨H, _, _, _, ρ, rfl⟩, rfl⟩ x
    exact norm_apply_le_sum_norm_coeff ρ x⟩

variable (ι) in
/-- The universal C⋆-seminorm `‖x‖ᵤ = sup ‖ρ x‖` on the group algebra `ℂ[F_ι]`: the supremum of
the norms of the unitary representations of the free group `F_ι` on Hilbert spaces in the
universe of `ι`. Its completion is `UniversalUnitaryCStarAlgebra ι`. -/
def universalSeminorm : Seminorm ℂ (MonoidAlgebra ℂ (FreeGroup ι)) :=
  sSup (representationSeminorms ι)

/-- Compressing the identity along a linear isometry gives the identity. -/
private theorem compression_one {H K : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
    (V : K →ₗᵢ[ℂ] H) : (1 : H →L[ℂ] H).compression V.toContinuousLinearMap = 1 := by
  ext y
  simpa only [ContinuousLinearMap.compression_apply, ContinuousLinearMap.comp_apply,
    one_apply_eq_self, LinearIsometry.coe_toContinuousLinearMap] using
    congr($(V.adjoint_comp_self) y)

/-- Compression of a ⋆-representation along a linear isometry with invariant range. -/
private def compress {D H K : Type*} [Ring D] [Algebra ℂ D] [StarRing D]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
    (ρ : D →⋆ₐ[ℂ] (H →L[ℂ] H)) (V : K →ₗᵢ[ℂ] H)
    (hV : ∀ x, Set.MapsTo (ρ x) (Set.range V) (Set.range V)) : D →⋆ₐ[ℂ] (K →L[ℂ] K) where
  toFun x := (ρ x).compression V.toContinuousLinearMap
  map_one' := by
    rw [map_one, compression_one]
  map_mul' x y := by
    simp only [map_mul, ContinuousLinearMap.mul_def, ContinuousLinearMap.compression_def]
    exact V.isPartialIsometry_toContinuousLinearMap.adjoint_comp_comp_comp_of_mapsTo _ (hV y)
  map_zero' := by simp
  map_add' x y := by simp [ContinuousLinearMap.compression_add]
  commutes' r := by
    rw [Algebra.algebraMap_eq_smul_one, map_smul, map_one, ContinuousLinearMap.compression_smul,
      compression_one, Algebra.algebraMap_eq_smul_one]
  map_star' x := by
    simp only [map_star, ContinuousLinearMap.star_eq_adjoint,
      ContinuousLinearMap.adjoint_compression]

private theorem apply_compress {D H K : Type*} [Ring D] [Algebra ℂ D] [StarRing D]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
    (ρ : D →⋆ₐ[ℂ] (H →L[ℂ] H)) (V : K →ₗᵢ[ℂ] H)
    (hV : ∀ x, Set.MapsTo (ρ x) (Set.range V) (Set.range V)) (x : D) (y : K) :
    V (compress ρ V hV x y) = ρ x (V y) :=
  (congrArg V ((ρ x).compression_apply V.toContinuousLinearMap y)).trans
    (V.apply_adjoint_apply_of_mem_range (hV x ⟨y, rfl⟩))

/-- Every vector of a ⋆-representation of `ℂ[F_ι]` lies in the range of a linear isometry from a
Hilbert space in the universe of `ι` whose range is invariant: the closure of the orbit of the
vector under `ℂ[F_ι]`. -/
private theorem exists_isometry_mapsTo_mem_range {H : Type w} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H]
    (ρ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] (H →L[ℂ] H)) (ξ : H) :
    ∃ (K : Type u) (_ : NormedAddCommGroup K) (_ : InnerProductSpace ℂ K)
      (_ : CompleteSpace K) (V : K →ₗᵢ[ℂ] H),
        (∀ x, Set.MapsTo (ρ x) (Set.range V) (Set.range V)) ∧ ξ ∈ Set.range V := by
  -- `S` is the orbit `ℂ[F_ι] ξ`, a submodule, and `W` its closure.
  let S := LinearMap.range ((ContinuousLinearMap.apply ℂ H ξ : (H →L[ℂ] H) →ₗ[ℂ] H) ∘ₗ
    (ρ : MonoidAlgebra ℂ (FreeGroup ι) →ₗ[ℂ] (H →L[ℂ] H)))
  let W := S.topologicalClosure
  have hS (x) : Set.MapsTo (ρ x) S S := by
    rintro _ ⟨y, rfl⟩
    exact ⟨x * y, by simp⟩
  have hW (x) : Set.MapsTo (ρ x) W W := by
    simpa [W, Submodule.topologicalClosure_coe] using (hS x).closure (ρ x).continuous
  have : Small.{u} S := by
    change Small.{u} (S : Set H)
    rw [LinearMap.coe_range]
    exact small_range _
  have : Small.{u} (W : Set H) := by
    rw [Submodule.topologicalClosure_coe]
    exact Set.small_closure _
  have : Small.{u} W := this
  obtain ⟨κ, ⟨b⟩⟩ := TauCeti.exists_hilbertBasis_of_small.{u} ℂ W
  let V := W.subtypeₗᵢ.comp b.repr.symm.toLinearIsometry
  have hV : Set.range V = W := by
    simp [V, Set.range_comp, b.repr.symm.surjective.range_eq]
  refine ⟨lp (fun _ : κ => ℂ) 2, inferInstance, inferInstance, inferInstance, V, fun x => ?_, ?_⟩
  all_goals rw [hV]
  · exact hW x
  · exact S.le_topologicalClosure ⟨1, by simp⟩

/-- Every ⋆-representation of `ℂ[F_ι]` on a Hilbert space in any universe is bounded by the
universal seminorm. Each vector lies in an invariant subspace isometric to a Hilbert space in the
universe of `ι`, on which the representation is one of those defining the universal seminorm. -/
theorem norm_le_universalSeminorm {H : Type w} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (ρ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] (H →L[ℂ] H))
    (x : MonoidAlgebra ℂ (FreeGroup ι)) : ‖ρ x‖ ≤ universalSeminorm ι x := by
  refine (ρ x).opNorm_le_bound (apply_nonneg _ x) fun ξ => ?_
  obtain ⟨K, _, _, _, V, hV, η, rfl⟩ := exists_isometry_mapsTo_mem_range ρ ξ
  have hK : ‖compress ρ V hV x‖ ≤ universalSeminorm ι x :=
    le_csSup bddAbove_representationSeminorms ⟨K, _, _, _, compress ρ V hV, rfl⟩ x
  rw [← apply_compress ρ V hV, V.norm_map, V.norm_map]
  exact (compress ρ V hV x).le_of_opNorm_le hK η

/-- **The universal seminorm bounds every unital ⋆-homomorphism** from `ℂ[F_ι]` into a unital
C⋆-algebra in any universe: compose with a faithful representation (Gelfand–Naimark), which is
isometric. -/
theorem norm_apply_le_universalSeminorm {B : Type w} [CStarAlgebra B]
    (φ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] B) (x : MonoidAlgebra ℂ (FreeGroup ι)) :
    ‖φ x‖ ≤ universalSeminorm ι x := by
  obtain ⟨H, _, _, _, π, hπ⟩ := TauCeti.CStarAlgebra.exists_faithful_representation B
  rw [← NonUnitalStarAlgHom.norm_map π hπ]
  exact norm_le_universalSeminorm (π.comp φ) x

/-- The universal seminorm is the least bound for the unitary representations of `F_ι` on
Hilbert spaces in the universe of `ι`. -/
theorem universalSeminorm_le_iff {x : MonoidAlgebra ℂ (FreeGroup ι)} {c : ℝ} :
    universalSeminorm ι x ≤ c ↔
      ∀ (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
        (ρ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] (H →L[ℂ] H)), ‖ρ x‖ ≤ c := by
  refine ⟨fun h _ _ _ _ ρ => (norm_le_universalSeminorm ρ x).trans h, fun h => ?_⟩
  rw [universalSeminorm, Seminorm.sSup_apply bddAbove_representationSeminorms]
  have hc : 0 ≤ c := by
    let H := EuclideanSpace ℂ PEmpty.{u + 1}
    exact (norm_nonneg _).trans (h H (starLift ℂ (FreeGroup ι) (H →L[ℂ] H) 1))
  exact Real.iSup_le (fun ⟨_, H, _, _, _, ρ, hp⟩ => hp ▸ h H ρ) hc

/-- The universal seminorm is bounded by the `ℓ¹` norm of the coefficients. -/
theorem universalSeminorm_le_sum_norm_coeff (x : MonoidAlgebra ℂ (FreeGroup ι)) :
    universalSeminorm ι x ≤ x.coeff.sum fun _ r => ‖r‖ :=
  universalSeminorm_le_iff.2 fun _ _ _ _ ρ => norm_apply_le_sum_norm_coeff ρ x

/-- The universal seminorm is submultiplicative. -/
theorem universalSeminorm_mul_le (x y : MonoidAlgebra ℂ (FreeGroup ι)) :
    universalSeminorm ι (x * y) ≤ universalSeminorm ι x * universalSeminorm ι y := by
  refine universalSeminorm_le_iff.2 fun _ _ _ _ ρ => ?_
  rw [map_mul]
  exact (norm_mul_le _ _).trans (mul_le_mul (norm_le_universalSeminorm ρ x)
    (norm_le_universalSeminorm ρ y) (norm_nonneg _) (apply_nonneg _ x))

/-- The universal seminorm is invariant under the involution. -/
@[simp]
theorem universalSeminorm_star (x : MonoidAlgebra ℂ (FreeGroup ι)) :
    universalSeminorm ι (star x) = universalSeminorm ι x := by
  have key (y : MonoidAlgebra ℂ (FreeGroup ι)) :
      universalSeminorm ι (star y) ≤ universalSeminorm ι y := by
    refine universalSeminorm_le_iff.2 fun _ _ _ _ ρ => ?_
    rw [map_star, norm_star]
    exact norm_le_universalSeminorm ρ y
  exact le_antisymm (key x) (by simpa using key (star x))

/-- The universal seminorm satisfies the C⋆-identity `‖x⋆ * x‖ᵤ = ‖x‖ᵤ * ‖x‖ᵤ`. -/
theorem universalSeminorm_star_mul_self (x : MonoidAlgebra ℂ (FreeGroup ι)) :
    universalSeminorm ι (star x * x) = universalSeminorm ι x * universalSeminorm ι x := by
  refine le_antisymm ((universalSeminorm_mul_le _ _).trans_eq (by rw [universalSeminorm_star]))
    ?_
  -- Each `‖ρ x‖` is the square root of `‖ρ (x⋆ * x)‖ ≤ ‖x⋆ * x‖ᵤ`.
  have hsqrt : universalSeminorm ι x ≤ √(universalSeminorm ι (star x * x)) := by
    refine universalSeminorm_le_iff.2 fun _ _ _ _ ρ => Real.le_sqrt_of_sq_le ?_
    rw [sq, ← CStarRing.norm_star_mul_self, ← map_star, ← map_mul]
    exact norm_le_universalSeminorm ρ _
  calc universalSeminorm ι x * universalSeminorm ι x
      ≤ √(universalSeminorm ι (star x * x)) * √(universalSeminorm ι (star x * x)) :=
        mul_le_mul hsqrt hsqrt (apply_nonneg _ x) (Real.sqrt_nonneg _)
    _ = universalSeminorm ι (star x * x) := Real.mul_self_sqrt (apply_nonneg _ _)

end UniversalUnitaryCStarAlgebra

open UniversalUnitaryCStarAlgebra

variable (ι : Type u)

/-- The group ⋆-algebra `ℂ[F_ι]` of the free group on `ι`, with the universal C⋆-seminorm
`universalSeminorm ι` as its norm. Its completion is `UniversalUnitaryCStarAlgebra ι`. Use
`FreeUnitaryAlgebra.equiv` to pass to and from `MonoidAlgebra ℂ (FreeGroup ι)`. -/
@[expose] def FreeUnitaryAlgebra : Type u :=
  MonoidAlgebra ℂ (FreeGroup ι)

namespace FreeUnitaryAlgebra

instance : Ring (FreeUnitaryAlgebra ι) :=
  inferInstanceAs (Ring (MonoidAlgebra ℂ (FreeGroup ι)))

instance : Algebra ℂ (FreeUnitaryAlgebra ι) :=
  inferInstanceAs (Algebra ℂ (MonoidAlgebra ℂ (FreeGroup ι)))

instance : StarRing (FreeUnitaryAlgebra ι) :=
  inferInstanceAs (StarRing (MonoidAlgebra ℂ (FreeGroup ι)))

instance : StarModule ℂ (FreeUnitaryAlgebra ι) :=
  inferInstanceAs (StarModule ℂ (MonoidAlgebra ℂ (FreeGroup ι)))

/-- `FreeUnitaryAlgebra ι` is `ℂ[F_ι]` as a ⋆-algebra. -/
def equiv : MonoidAlgebra ℂ (FreeGroup ι) ≃⋆ₐ[ℂ] FreeUnitaryAlgebra ι :=
  StarAlgEquiv.refl ℂ (MonoidAlgebra ℂ (FreeGroup ι))

/-- The universal seminorm makes `ℂ[F_ι]` a seminormed group. -/
instance : SeminormedAddCommGroup (FreeUnitaryAlgebra ι) :=
  @AddGroupSeminorm.toSeminormedAddCommGroup (FreeUnitaryAlgebra ι) _
    (universalSeminorm ι).toAddGroupSeminorm

variable {ι}

/-- The norm of `FreeUnitaryAlgebra ι` is the universal seminorm. -/
@[simp]
theorem norm_equiv (x : MonoidAlgebra ℂ (FreeGroup ι)) : ‖equiv ι x‖ = universalSeminorm ι x :=
  (rfl)

/-- The norm of `FreeUnitaryAlgebra ι` is the universal seminorm of the underlying element of
`ℂ[F_ι]`. -/
theorem norm_def (x : FreeUnitaryAlgebra ι) : ‖x‖ = universalSeminorm ι ((equiv ι).symm x) :=
  (rfl)

/-- The universal seminorm is submultiplicative, so `FreeUnitaryAlgebra ι` is a seminormed
ring. -/
instance : SeminormedRing (FreeUnitaryAlgebra ι) where
  __ : SeminormedAddCommGroup (FreeUnitaryAlgebra ι) := inferInstance
  __ : Ring (FreeUnitaryAlgebra ι) := inferInstance
  norm_mul_le := universalSeminorm_mul_le (ι := ι)

instance : NormedAlgebra ℂ (FreeUnitaryAlgebra ι) where
  __ : Algebra ℂ (FreeUnitaryAlgebra ι) := inferInstance
  norm_smul_le c x := (map_smul_eq_mul (universalSeminorm ι) c x).le

/-- The involution is isometric for the universal seminorm. -/
instance : NormedStarGroup (FreeUnitaryAlgebra ι) where
  norm_star_le x := (universalSeminorm_star (ι := ι) x).le

/-- The universal seminorm satisfies the C⋆-identity on `FreeUnitaryAlgebra ι`. -/
theorem norm_star_mul_self (x : FreeUnitaryAlgebra ι) : ‖star x * x‖ = ‖x‖ * ‖x‖ :=
  universalSeminorm_star_mul_self (ι := ι) x

end FreeUnitaryAlgebra

/-- **The universal unital C⋆-algebra on unitary generators indexed by `ι`**: the completion of
the group ⋆-algebra `ℂ[F_ι]` of the free group on `ι` in the universal C⋆-seminorm, the supremum
over all unitary representations of `F_ι`. For `ι = ℕ` it is `C*(F_∞)`. It is a unital
C⋆-algebra with unitary generators `UniversalUnitaryCStarAlgebra.generator i`, and unital
⋆-homomorphisms out of it are the families of unitaries indexed by `ι`
(`UniversalUnitaryCStarAlgebra.lift`). -/
@[expose] def UniversalUnitaryCStarAlgebra : Type u :=
  Completion (FreeUnitaryAlgebra ι)

namespace UniversalUnitaryCStarAlgebra

/-- The completion of `ℂ[F_ι]` in the universal seminorm is a unital C⋆-algebra. -/
instance instCStarAlgebra : CStarAlgebra (UniversalUnitaryCStarAlgebra ι) :=
  letI : CStarAlgebra (Completion (FreeUnitaryAlgebra ι)) :=
    { toCStarRing := Completion.cstarRing fun x => (FreeUnitaryAlgebra.norm_star_mul_self x).ge
      norm_smul_le := norm_smul_le }
  inferInstanceAs (CStarAlgebra (Completion (FreeUnitaryAlgebra ι)))

/-- The canonical unital ⋆-homomorphism from `ℂ[F_ι]` into the universal C⋆-algebra. -/
def of : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] UniversalUnitaryCStarAlgebra ι where
  toFun x := (FreeUnitaryAlgebra.equiv ι x : Completion (FreeUnitaryAlgebra ι))
  map_one' := by
    rw [map_one]
    exact Completion.coe_one _
  map_mul' x y := by
    rw [map_mul]
    exact Completion.coe_mul' _ _
  map_zero' := by
    rw [map_zero]
    exact Completion.coe_zero
  map_add' x y := by
    rw [map_add]
    exact Completion.coe_add _ _
  commutes' r := by
    rw [AlgHomClass.commutes]
    exact (Completion.algebraMap_def _ _ r).symm
  map_star' x := by
    rw [map_star]
    exact Completion.coe_star _

variable {ι}

/-- The image of `x` under the completion map of `FreeUnitaryAlgebra ι` is `of ι x`. -/
@[simp]
theorem coe_equiv (x : MonoidAlgebra ℂ (FreeGroup ι)) :
    ((FreeUnitaryAlgebra.equiv ι x : Completion (FreeUnitaryAlgebra ι)) :
      UniversalUnitaryCStarAlgebra ι) = of ι x :=
  (rfl)

/-- The norm of the image of `x` in the universal C⋆-algebra is its universal seminorm. -/
@[simp]
theorem norm_of (x : MonoidAlgebra ℂ (FreeGroup ι)) : ‖of ι x‖ = universalSeminorm ι x :=
  (Completion.norm_coe (FreeUnitaryAlgebra.equiv ι x)).trans (FreeUnitaryAlgebra.norm_equiv x)

/-- `ℂ[F_ι]` is dense in the universal C⋆-algebra. -/
theorem denseRange_of : DenseRange (of ι) :=
  Completion.denseRange_coe.comp (FreeUnitaryAlgebra.equiv ι).surjective.denseRange
    (Completion.continuous_coe _)

/-- To prove a closed property of every element of the universal C⋆-algebra, it suffices to
prove it on `ℂ[F_ι]`. -/
@[elab_as_elim]
theorem induction_on {p : UniversalUnitaryCStarAlgebra ι → Prop}
    (x : UniversalUnitaryCStarAlgebra ι) (hp : IsClosed {x | p x}) (ih : ∀ x, p (of ι x)) :
    p x :=
  Completion.induction_on (p := p) x hp fun y => by
    have h := ih ((FreeUnitaryAlgebra.equiv ι).symm y)
    rwa [← coe_equiv, StarAlgEquiv.apply_symm_apply] at h

variable {B : Type w} [CStarAlgebra B]

open scoped _root_.CStarAlgebra in
/-- Unital ⋆-homomorphisms out of the universal C⋆-algebra are determined on `ℂ[F_ι]`. -/
theorem starAlgHom_ext {φ ψ : UniversalUnitaryCStarAlgebra ι →⋆ₐ[ℂ] B}
    (h : φ.comp (of ι) = ψ.comp (of ι)) : φ = ψ :=
  StarAlgHom.ext fun x => induction_on x (isClosed_eq (map_continuous φ) (map_continuous ψ))
    fun y => congr($h y)

/-- A unital ⋆-homomorphism from `ℂ[F_ι]` into a unital C⋆-algebra, as a continuous linear map
for the universal seminorm. -/
private def extendCLM (φ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] B) :
    FreeUnitaryAlgebra ι →L[ℂ] B :=
  ((φ : MonoidAlgebra ℂ (FreeGroup ι) →ₗ[ℂ] B).comp
    ((FreeUnitaryAlgebra.equiv ι).symm :
      FreeUnitaryAlgebra ι →ₗ[ℂ] MonoidAlgebra ℂ (FreeGroup ι))).mkContinuous 1 fun x => by
    simpa [FreeUnitaryAlgebra.norm_def] using
      norm_apply_le_universalSeminorm φ ((FreeUnitaryAlgebra.equiv ι).symm x)

private theorem fromCompletion_extendCLM_of (φ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] B)
    (x : MonoidAlgebra ℂ (FreeGroup ι)) : (extendCLM φ).fromCompletion (of ι x) = φ x := by
  refine (ContinuousLinearMap.fromCompletion_apply_coe (extendCLM φ)
    (FreeUnitaryAlgebra.equiv ι x)).trans ?_
  simp [extendCLM]

/-- Extend a unital ⋆-homomorphism from `ℂ[F_ι]` into a unital C⋆-algebra to the universal
C⋆-algebra. It is bounded by the universal seminorm, `norm_apply_le_universalSeminorm`. -/
def extend (φ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] B) :
    UniversalUnitaryCStarAlgebra ι →⋆ₐ[ℂ] B where
  toFun := (extendCLM φ).fromCompletion
  map_one' := by
    rw [← map_one (of ι), fromCompletion_extendCLM_of, map_one]
  map_zero' := map_zero _
  map_add' := map_add _
  map_mul' x y := by
    induction x using induction_on with
    | hp => exact isClosed_eq (by fun_prop) (by fun_prop)
    | ih x =>
      induction y using induction_on with
      | hp => exact isClosed_eq (by fun_prop) (by fun_prop)
      | ih y => simp only [← map_mul, fromCompletion_extendCLM_of]
  commutes' r := by
    rw [← AlgHomClass.commutes (of ι) r, fromCompletion_extendCLM_of, AlgHomClass.commutes]
  map_star' x := by
    induction x using induction_on with
    | hp => exact isClosed_eq (by fun_prop) (by fun_prop)
    | ih x => simp only [← map_star, fromCompletion_extendCLM_of]

/-- The extension agrees with the original ⋆-homomorphism on `ℂ[F_ι]`. -/
@[simp]
theorem extend_of (φ : MonoidAlgebra ℂ (FreeGroup ι) →⋆ₐ[ℂ] B)
    (x : MonoidAlgebra ℂ (FreeGroup ι)) : extend φ (of ι x) = φ x :=
  fromCompletion_extendCLM_of φ x

variable (ι) in
/-- The unitary generator of the universal C⋆-algebra indexed by `i`: the image of the free
generator `FreeGroup.of i`. -/
def generator (i : ι) : unitary (UniversalUnitaryCStarAlgebra ι) :=
  ⟨of ι (single (FreeGroup.of i) 1), Unitary.map_mem (of ι) (single_one_mem_unitary _)⟩

theorem coe_generator (i : ι) :
    (generator ι i : UniversalUnitaryCStarAlgebra ι) = of ι (single (FreeGroup.of i) 1) :=
  (rfl)

/-- **Unital ⋆-homomorphisms out of the universal C⋆-algebra are determined by their values on
the generators.** -/
@[ext]
theorem hom_ext {φ ψ : UniversalUnitaryCStarAlgebra ι →⋆ₐ[ℂ] B}
    (h : ∀ i, φ (generator ι i) = ψ (generator ι i)) : φ = ψ := by
  refine starAlgHom_ext ((starLift ℂ (FreeGroup ι) B).symm.injective (FreeGroup.ext_hom _ _ fun i =>
    Subtype.ext ?_))
  simpa [coe_generator] using h i

variable (ι B) in
/-- **The universal property of the universal C⋆-algebra on unitary generators.** Unital
⋆-homomorphisms into a unital C⋆-algebra `B`, in any universe, are the families of unitaries of
`B` indexed by `ι`: a family `u` gives the unique unital ⋆-homomorphism sending `generator ι i`
to `u i`, and a ⋆-homomorphism restricts to its values on the generators. -/
def lift : (ι → unitary B) ≃ (UniversalUnitaryCStarAlgebra ι →⋆ₐ[ℂ] B) where
  toFun u := extend (starLift ℂ (FreeGroup ι) B (FreeGroup.lift u))
  invFun φ i := ⟨φ (generator ι i), Unitary.map_mem φ (generator ι i).property⟩
  left_inv u := funext fun i => Subtype.ext (by simp [coe_generator])
  right_inv φ := hom_ext fun i => by simp [coe_generator]

/-- The ⋆-homomorphism given by a family of unitaries sends each generator to its unitary. -/
@[simp]
theorem lift_generator (u : ι → unitary B) (i : ι) :
    lift ι B u (generator ι i) = u i := by
  simp [lift, coe_generator]

@[simp]
theorem lift_symm_apply_coe (φ : UniversalUnitaryCStarAlgebra ι →⋆ₐ[ℂ] B) (i : ι) :
    ((lift ι B).symm φ i : B) = φ (generator ι i) :=
  (rfl)

/-- The universal C⋆-algebra on unitary generators is nontrivial: sending every generator to `1`
gives a unital ⋆-homomorphism onto `ℂ`. -/
instance : Nontrivial (UniversalUnitaryCStarAlgebra ι) := by
  refine ⟨⟨1, 0, fun h => ?_⟩⟩
  simpa using congr(lift ι ℂ (fun _ => 1) $h)

/-- **The generators generate the universal C⋆-algebra**: the closure of the ⋆-subalgebra they
generate is everything. -/
theorem topologicalClosure_adjoin_range_generator :
    StarSubalgebra.topologicalClosure
      (StarAlgebra.adjoin ℂ (Set.range fun i => (generator ι i : UniversalUnitaryCStarAlgebra ι)))
      = ⊤ := by
  have hs := StarAlgebra.subset_adjoin ℂ
    (Set.range fun i => (generator ι i : UniversalUnitaryCStarAlgebra ι))
  generalize StarAlgebra.adjoin ℂ
    (Set.range fun i => (generator ι i : UniversalUnitaryCStarAlgebra ι)) = S at hs ⊢
  -- Every group element lies in `S`: the generators and their adjoints do.
  have hg (g : FreeGroup ι) : of ι (single g 1) ∈ S := by
    induction g using FreeGroup.induction_on with
    | one => simp [← one_def]
    | of i => exact hs ⟨i, rfl⟩
    | inv_of i _ => simpa [coe_generator, ← map_star] using star_mem (hs ⟨i, rfl⟩)
    | mul g h hg hh => simpa [← map_mul, single_mul_single] using S.mul_mem hg hh
  have hS : Set.range (of ι) ⊆ S := by
    rintro _ ⟨x, rfl⟩
    induction x using induction_linear with
    | zero => simp
    | add x y hx hy => simpa using S.add_mem hx hy
    | single g r =>
      have : single g r = r • single g (1 : ℂ) := by simp
      rw [this, map_smul]
      exact S.smul_mem (hg g) r
  refine eq_top_iff.2 fun x _ => ?_
  exact closure_mono hS (denseRange_of.closure_range ▸ Set.mem_univ x)

/-- The universal C⋆-algebra on countably many unitary generators, such as `C*(F_∞)`, is
separable: it is the closed span of the countably many group elements. -/
instance instSeparableSpace [Countable ι] :
    TopologicalSpace.SeparableSpace (UniversalUnitaryCStarAlgebra ι) := by
  have hs : TopologicalSpace.IsSeparable
      (Submodule.span ℂ (Set.range fun g : FreeGroup ι => of ι (single g 1)) :
        Set (UniversalUnitaryCStarAlgebra ι)) :=
    (Set.countable_range _).isSeparable.span
  refine TopologicalSpace.isSeparable_univ_iff.1 ?_
  refine hs.closure.mono fun x _ => closure_mono ?_ (denseRange_of.closure_range ▸ Set.mem_univ x)
  rintro _ ⟨x, rfl⟩
  rw [← sum_coeff_single x, Finsupp.sum, map_sum]
  refine Submodule.sum_mem _ fun g _ => ?_
  have : single g (x.coeff g) = x.coeff g • single g (1 : ℂ) := by simp
  rw [this, map_smul]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨g, rfl⟩)

end UniversalUnitaryCStarAlgebra

end TauCeti
