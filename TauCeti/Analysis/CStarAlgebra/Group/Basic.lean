/-!
# Reduced group C⋆-algebras and their canonical faithful tracial state

For a group `Γ` with measurable multiplication (`[MeasurableMul Γ]`), the **reduced group
C⋆-algebra** `TauCeti.reducedGroupCStarAlgebra Γ` (`C*_r(Γ)`) is the norm-closed unital
⋆-subalgebra of `B(L²(Γ, Measure.count))` generated by the left regular representation
`(Measure.count : Measure Γ).leftRegular ℂ ℂ 2`. Any discrete group
(`[DiscreteMeasurableSpace Γ]`) satisfies `[MeasurableMul Γ]` and `[MeasurableSingletonClass Γ]`
automatically, without any countability assumption on `Γ`.

* `TauCeti.reducedGroupCStarAlgebra`: `C*_r(Γ)`, contained in `TauCeti.groupVonNeumannAlgebra Γ`
  (`TauCeti.reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra`) and commuting with right
  translations (`TauCeti.commute_reducedGroupCStarAlgebra_rightRegular`).
* `TauCeti.leftRegularUnitary`: the canonical group homomorphism `Γ →* unitary C*_r(Γ)`.
* `TauCeti.groupAlgebraToReducedGroupCStarAlgebra`: the canonical ⋆-algebra homomorphism
  `ℂ[Γ] →⋆ₐ[ℂ] C*_r(Γ)` with dense range
  (`TauCeti.denseRange_groupAlgebraToReducedGroupCStarAlgebra`).
* When singletons are measurable (`[MeasurableSingletonClass Γ]`), restricting
  `TauCeti.groupVonNeumannTrace Γ` yields the canonical faithful tracial state
  `TauCeti.canonicalTrace Γ : C*_r(Γ) →L[ℂ] ℂ`, evaluating `f ∈ ℂ[Γ]` at `f.coeff 1`.

## References

* J. Peterson, *Notes on von Neumann Algebras* (2013), Chapter 5.
* P. de la Harpe, *On simplicity of reduced C*-algebras of groups*, Bull. Lond. Math. Soc. 39
  (2007), 1–26.
-/

public section

noncomputable section

open MeasureTheory VonNeumannAlgebra
open scoped ComplexConjugate ComplexOrder ENNReal InnerProductSpace

namespace TauCeti

section MeasurableMul

variable (Γ : Type*) [Group Γ] [MeasurableSpace Γ] [MeasurableMul Γ]

/-- **The reduced group C⋆-algebra `C*_r(Γ)`**, defined as the norm-closed unital ⋆-subalgebra of
`B(L²(Γ, Measure.count))` generated by the left regular representation. -/
def reducedGroupCStarAlgebra :
    StarSubalgebra ℂ
      (Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :=
  generatedCStarAlgebra ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)

/-- Unfolding lemma for `reducedGroupCStarAlgebra`. -/
theorem reducedGroupCStarAlgebra_def :
    reducedGroupCStarAlgebra Γ =
      generatedCStarAlgebra ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2) :=
  (rfl)

/-- The reduced group C⋆-algebra is norm-closed. -/
instance isClosed_reducedGroupCStarAlgebra :
    IsClosed (reducedGroupCStarAlgebra Γ :
      Set (Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))) :=
  isClosed_generatedCStarAlgebra _

variable {Γ}

/-- Every left regular unitary belongs to `reducedGroupCStarAlgebra Γ`. -/
@[simp]
theorem leftRegular_mem_reducedGroupCStarAlgebra (g : Γ) :
    (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g ∈ reducedGroupCStarAlgebra Γ :=
  apply_mem_generatedCStarAlgebra _ g

variable (Γ)

/-- The reduced group C⋆-algebra `C*_r(Γ)` is contained in the group von Neumann algebra
`L(Γ)`. -/
theorem reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra :
    reducedGroupCStarAlgebra Γ ≤ (groupVonNeumannAlgebra Γ).toStarSubalgebra :=
  (generatedCStarAlgebra_le_iff (groupVonNeumannAlgebra Γ).isClosed).2 fun g ↦
    leftRegular_mem_groupVonNeumannAlgebra g

/-- The reduced group C⋆-algebra `C*_r(Γ)` is contained in the commutant `R(Γ)'` of the right
group von Neumann algebra. -/
theorem reducedGroupCStarAlgebra_le_commutant_rightGroupVonNeumannAlgebra :
    reducedGroupCStarAlgebra Γ ≤ (rightGroupVonNeumannAlgebra Γ).commutant.toStarSubalgebra :=
  (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ).trans
    groupVonNeumannAlgebra_le_commutant_rightGroupVonNeumannAlgebra

variable {Γ}

/-- Every element of `reducedGroupCStarAlgebra Γ` commutes with right translations on `L²(Γ)`. -/
theorem commute_reducedGroupCStarAlgebra_rightRegular (x : reducedGroupCStarAlgebra Γ) (h : Γ) :
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) *
        (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 h =
      (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 h *
        (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :=
  (mem_commutant_rightGroupVonNeumannAlgebra_iff_rightRegular.1
    (reducedGroupCStarAlgebra_le_commutant_rightGroupVonNeumannAlgebra Γ x.property) h).symm

variable (Γ)

/-- The left regular representation as a group homomorphism into
`unitary (reducedGroupCStarAlgebra Γ)`. -/
def leftRegularUnitary : Γ →* unitary (reducedGroupCStarAlgebra Γ) where
  toFun g :=
    ⟨⟨(Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g,
        leftRegular_mem_reducedGroupCStarAlgebra g⟩,
      Unitary.mem_iff.2 ⟨
        Subtype.ext <| by
          rw [MulMemClass.coe_mul, StarMemClass.coe_star]
          exact (Unitary.mem_iff.1
            ((Measure.isUnitary_leftRegular Measure.count).mem_unitary g)).1,
        Subtype.ext <| by
          rw [MulMemClass.coe_mul, StarMemClass.coe_star]
          exact (Unitary.mem_iff.1
            ((Measure.isUnitary_leftRegular Measure.count).mem_unitary g)).2⟩⟩
  map_one' := Subtype.ext (Subtype.ext (map_one ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)))
  map_mul' g h :=
    Subtype.ext (Subtype.ext (map_mul ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2) g h))

/-- Viewing `leftRegularUnitary Γ g` in `B(L²(Γ))` yields
`(Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g`. -/
@[simp]
theorem coe_leftRegularUnitary (g : Γ) :
    ((leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) :
        Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) =
      (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g :=
  (rfl)

/-- Coercing `star (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ)` recovers
`leftRegular g⁻¹`. -/
@[simp]
theorem star_coe_leftRegularUnitary (g : Γ) :
    star (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) =
      (leftRegularUnitary Γ g⁻¹ : reducedGroupCStarAlgebra Γ) := by
  rw [← Unitary.coe_star, Unitary.star_eq_inv, ← map_inv]

/-- The canonical ⋆-algebra homomorphism `ℂ[Γ] →⋆ₐ[ℂ] reducedGroupCStarAlgebra Γ` sending `g` to
`leftRegularUnitary Γ g`. -/
def groupAlgebraToReducedGroupCStarAlgebra :
    MonoidAlgebra ℂ Γ →⋆ₐ[ℂ] reducedGroupCStarAlgebra Γ :=
  MonoidAlgebra.starLift ℂ Γ (reducedGroupCStarAlgebra Γ) (leftRegularUnitary Γ)

/-- Evaluating `groupAlgebraToReducedGroupCStarAlgebra Γ` on a group-algebra generator
`single g c`. -/
@[simp]
theorem groupAlgebraToReducedGroupCStarAlgebra_single (g : Γ) (c : ℂ) :
    groupAlgebraToReducedGroupCStarAlgebra Γ (MonoidAlgebra.single g c) =
      c • (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) :=
  MonoidAlgebra.starLift_single (leftRegularUnitary Γ) g c

/-- Inclusion into `groupVonNeumannAlgebra Γ` sends `groupAlgebraToReducedGroupCStarAlgebra Γ f`
to `groupAlgebraToVonNeumannAlgebra Γ f`. -/
theorem inclusion_groupAlgebraToReducedGroupCStarAlgebra (f : MonoidAlgebra ℂ Γ) :
    StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)
        (groupAlgebraToReducedGroupCStarAlgebra Γ f) =
      groupAlgebraToVonNeumannAlgebra Γ f := by
  apply Subtype.ext
  induction f using MonoidAlgebra.induction_linear with
  | zero => simp
  | add f₁ f₂ ih₁ ih₂ =>
    simp only [map_add, AddMemClass.coe_add] at ih₁ ih₂ ⊢
    rw [ih₁, ih₂]
  | single g c => simp

/-- Every element of `StarAlgebra.adjoin ℂ (Set.range leftRegular)` lies in the image of
`groupAlgebraToReducedGroupCStarAlgebra Γ`. -/
theorem exists_groupAlgebraToReducedGroupCStarAlgebra_of_mem_adjoin
    {y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)}
    (hy : y ∈ StarAlgebra.adjoin ℂ (Set.range ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2))) :
    ∃ f : MonoidAlgebra ℂ Γ,
      (groupAlgebraToReducedGroupCStarAlgebra Γ f :
          Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) = y := by
  let S : StarSubalgebra ℂ
      (Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :=
    (StarAlgHom.comp (reducedGroupCStarAlgebra Γ).subtype
      (groupAlgebraToReducedGroupCStarAlgebra Γ)).range
  have hle : StarAlgebra.adjoin ℂ (Set.range ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)) ≤
      S :=
    StarAlgebra.adjoin_le (by
      rintro _ ⟨g, rfl⟩
      refine ⟨MonoidAlgebra.single g (1 : ℂ), ?_⟩
      simp [one_smul])
  obtain ⟨f, hf⟩ := hle hy
  exact ⟨f, hf⟩

/-- The image of `ℂ[Γ]` under `groupAlgebraToReducedGroupCStarAlgebra Γ` is dense in
`reducedGroupCStarAlgebra Γ`. -/
theorem denseRange_groupAlgebraToReducedGroupCStarAlgebra :
    DenseRange (groupAlgebraToReducedGroupCStarAlgebra Γ) := by
  rw [Metric.denseRange_iff]
  intro x δ hδ
  have hx : (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) ∈
      closure (StarAlgebra.adjoin ℂ
          (Set.range ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)) :
        Set (Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))) := by
    rw [← StarSubalgebra.topologicalClosure_coe, SetLike.mem_coe, ← generatedCStarAlgebra_def,
      ← reducedGroupCStarAlgebra_def]
    exact x.property
  obtain ⟨a, ha, hdist⟩ := Metric.mem_closure_iff.1 hx δ hδ
  obtain ⟨f, hf⟩ := exists_groupAlgebraToReducedGroupCStarAlgebra_of_mem_adjoin Γ ha
  refine ⟨f, ?_⟩
  rw [Subtype.dist_eq, hf]
  exact hdist

end MeasurableMul

section Trace

variable (Γ : Type*) [Group Γ] [MeasurableSpace Γ] [MeasurableMul Γ] [MeasurableSingletonClass Γ]

/-- **The canonical tracial state** `τ(x) = ⟪δ₁, x δ₁⟫_ℂ` on `reducedGroupCStarAlgebra Γ`, obtained
by restricting `groupVonNeumannTrace Γ`. -/
def canonicalTrace : reducedGroupCStarAlgebra Γ →L[ℂ] ℂ :=
  LinearMap.mkContinuous
    ((groupVonNeumannTrace Γ).comp
      (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)).toLinearMap)
    1 fun x ↦ by
      let δ₁ : Lp ℂ 2 (Measure.count : Measure Γ) := L2.countHilbertBasis ℂ Γ 1
      have h1 : ‖δ₁‖ = 1 := L2.norm_countHilbertBasis 1
      change ‖groupVonNeumannTrace Γ
          (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ) x)‖ ≤
        1 * ‖x‖
      rw [groupVonNeumannTrace_apply, groupVonNeumannCoeff_def]
      calc ‖⟪δ₁, (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ]
              Lp ℂ 2 (Measure.count : Measure Γ)) δ₁⟫_ℂ‖
          ≤ ‖δ₁‖ * ‖(x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ]
              Lp ℂ 2 (Measure.count : Measure Γ)) δ₁‖ := norm_inner_le_norm _ _
        _ ≤ 1 * ‖(x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ]
              Lp ℂ 2 (Measure.count : Measure Γ)) δ₁‖ := by rw [h1]
        _ ≤ 1 * (‖(x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ]
              Lp ℂ 2 (Measure.count : Measure Γ))‖ * ‖δ₁‖) :=
            mul_le_mul_of_nonneg_left (ContinuousLinearMap.le_opNorm _ _) zero_le_one
        _ = 1 * ‖x‖ := by rw [h1, mul_one, AddSubgroupClass.coe_norm]

variable {Γ}

/-- `canonicalTrace Γ` is the restriction of `groupVonNeumannTrace Γ` along the inclusion
`reducedGroupCStarAlgebra Γ ≤ (groupVonNeumannAlgebra Γ).toStarSubalgebra`. -/
theorem canonicalTrace_eq_groupVonNeumannTrace (x : reducedGroupCStarAlgebra Γ) :
    canonicalTrace Γ x =
      groupVonNeumannTrace Γ
        (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ) x) :=
  (rfl)

/-- Evaluating `canonicalTrace Γ` at `x` yields `⟪δ₁, x δ₁⟫_ℂ`. -/
theorem canonicalTrace_apply (x : reducedGroupCStarAlgebra Γ) :
    canonicalTrace Γ x =
      ⟪L2.countHilbertBasis ℂ Γ 1,
        (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
          (L2.countHilbertBasis ℂ Γ 1)⟫_ℂ := by
  simp [canonicalTrace_eq_groupVonNeumannTrace, groupVonNeumannTrace_apply,
    groupVonNeumannCoeff_def]

/-- The operator norm of `canonicalTrace Γ` is at most `1`. -/
theorem norm_canonicalTrace_le : ‖canonicalTrace Γ‖ ≤ 1 :=
  LinearMap.mkContinuous_norm_le _ zero_le_one _

/-- The canonical trace is contractive: `‖canonicalTrace Γ x‖ ≤ ‖x‖`. -/
theorem norm_canonicalTrace_apply_le (x : reducedGroupCStarAlgebra Γ) :
    ‖canonicalTrace Γ x‖ ≤ ‖x‖ := by
  simpa using (canonicalTrace Γ).le_opNorm x |>.trans
    (mul_le_of_le_one_left (norm_nonneg _) (norm_canonicalTrace_le (Γ := Γ)))

/-- The canonical trace is unital. -/
@[simp]
theorem canonicalTrace_one : canonicalTrace Γ 1 = 1 := by
  rw [canonicalTrace_eq_groupVonNeumannTrace, map_one, groupVonNeumannTrace_one]

/-- The canonical trace commutes with `star` as complex conjugation. -/
@[simp]
theorem canonicalTrace_star (x : reducedGroupCStarAlgebra Γ) :
    canonicalTrace Γ (star x) = conj (canonicalTrace Γ x) := by
  rw [canonicalTrace_eq_groupVonNeumannTrace, canonicalTrace_eq_groupVonNeumannTrace, map_star,
    groupVonNeumannTrace_star]

/-- Evaluating `canonicalTrace Γ` on `star x * x` gives `‖x δ₁‖ ^ 2`. -/
theorem canonicalTrace_star_mul_self (x : reducedGroupCStarAlgebra Γ) :
    canonicalTrace Γ (star x * x) =
      (‖(x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
        (L2.countHilbertBasis ℂ Γ 1)‖ ^ 2 : ℂ) := by
  rw [canonicalTrace_eq_groupVonNeumannTrace, map_mul, map_star, groupVonNeumannTrace_star_mul,
    inner_self_eq_norm_sq_to_K]
  simp

/-- The canonical trace is nonnegative on `star x * x`. -/
@[simp]
theorem canonicalTrace_star_mul_self_nonneg (x : reducedGroupCStarAlgebra Γ) :
    0 ≤ canonicalTrace Γ (star x * x) := by
  rw [canonicalTrace_eq_groupVonNeumannTrace, map_mul, map_star]
  exact groupVonNeumannTrace_star_mul_self_nonneg _

/-- The identity point mass `δ₁` is separating for `reducedGroupCStarAlgebra Γ`. -/
theorem eq_zero_of_reducedGroupCStarAlgebra_apply_countHilbertBasis_one
    {x : reducedGroupCStarAlgebra Γ}
    (hx : (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
      (L2.countHilbertBasis ℂ Γ 1) = 0) :
    x = 0 :=
  Subtype.ext <| (isSeparating_groupVonNeumannAlgebra_one Γ).eq_zero
    (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ x.property) hx

/-- The canonical trace is faithful: `τ (star x * x) = 0 ↔ x = 0`. -/
@[simp]
theorem canonicalTrace_star_mul_self_eq_zero_iff (x : reducedGroupCStarAlgebra Γ) :
    canonicalTrace Γ (star x * x) = 0 ↔ x = 0 := by
  refine ⟨fun h ↦ Subtype.ext ?_, fun h ↦ by simp [h]⟩
  rw [canonicalTrace_eq_groupVonNeumannTrace,
    map_mul (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)),
    map_star (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)),
    groupVonNeumannTrace_star_mul_self_eq_zero_iff] at h
  simpa using congrArg Subtype.val h

/-- The canonical trace on `reducedGroupCStarAlgebra Γ` satisfies `τ (x * y) = τ (y * x)`. -/
theorem canonicalTrace_mul_comm (x y : reducedGroupCStarAlgebra Γ) :
    canonicalTrace Γ (x * y) = canonicalTrace Γ (y * x) := by
  rw [canonicalTrace_eq_groupVonNeumannTrace, canonicalTrace_eq_groupVonNeumannTrace,
    map_mul (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)),
    map_mul (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ))]
  exact groupVonNeumannTrace_mul_comm _ _

/-- On the image of `MonoidAlgebra ℂ Γ`, `canonicalTrace Γ` extracts the identity coefficient. -/
@[simp]
theorem canonicalTrace_groupAlgebraToReducedGroupCStarAlgebra (f : MonoidAlgebra ℂ Γ) :
    canonicalTrace Γ (groupAlgebraToReducedGroupCStarAlgebra Γ f) = f.coeff 1 := by
  rw [canonicalTrace_eq_groupVonNeumannTrace, inclusion_groupAlgebraToReducedGroupCStarAlgebra,
    groupVonNeumannTrace_groupAlgebraToVonNeumannAlgebra]

/-- The canonical trace of a finite linear combination of left regular unitaries is its identity
coefficient. -/
theorem canonicalTrace_finsupp_sum (c : Γ →₀ ℂ) :
    canonicalTrace Γ
        (∑ g ∈ c.support, c g • (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ)) =
      c 1 := by
  have hsum :
      (∑ g ∈ c.support, c g • (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ)) =
        groupAlgebraToReducedGroupCStarAlgebra Γ (MonoidAlgebra.ofCoeff c) := by
    conv_rhs => rw [← MonoidAlgebra.sum_coeff_single (MonoidAlgebra.ofCoeff c)]
    rw [Finsupp.sum, map_sum]
    simp
  simp [hsum]

/-- The canonical trace of a left regular unitary equals `1` at `g = 1` and `0` otherwise. -/
@[simp]
theorem canonicalTrace_leftRegularUnitary [DecidableEq Γ] (g : Γ) :
    canonicalTrace Γ (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) =
      if g = 1 then 1 else 0 := by
  have h : (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) =
      groupAlgebraToReducedGroupCStarAlgebra Γ (MonoidAlgebra.single g (1 : ℂ)) := by
    simp
  rw [h, canonicalTrace_groupAlgebraToReducedGroupCStarAlgebra, MonoidAlgebra.coeff_single,
    Finsupp.single_apply, eq_comm]

end Trace

end TauCeti
