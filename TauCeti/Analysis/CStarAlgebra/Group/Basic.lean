/-!
# Reduced group C⋆-algebras and their canonical faithful tracial state

For a group `Γ` with measurable multiplication (`[MeasurableMul Γ]`), the **reduced group
C⋆-algebra** `TauCeti.reducedGroupCStarAlgebra Γ` (`C*_r(Γ)`) is the norm-closed unital
⋆-subalgebra of `B(L²(Γ, Measure.count))` generated by the left regular representation
`(Measure.count : Measure Γ).leftRegular ℂ ℂ 2`. Any discrete group
(`[DiscreteMeasurableSpace Γ]`) satisfies `[MeasurableMul Γ]` and `[MeasurableSingletonClass Γ]`
automatically, without any countability assumption on `Γ`.

* `TauCeti.reducedGroupCStarAlgebra`: `C*_r(Γ)`, contained in `TauCeti.groupVonNeumannAlgebra Γ`
  (`TauCeti.reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra`) and commuting with right
  translations (`TauCeti.commute_reducedGroupCStarAlgebra_rightRegular`).
* `TauCeti.leftRegularUnitary`: the canonical group homomorphism `Γ →* unitary C*_r(Γ)`.
* `TauCeti.groupAlgebraToReducedGroupCStarAlgebra`: the canonical ⋆-algebra homomorphism
  `ℂ[Γ] →⋆ₐ[ℂ] C*_r(Γ)` with support-sum expansion
  `TauCeti.groupAlgebraToReducedGroupCStarAlgebra_eq_sum` and dense range
  (`TauCeti.denseRange_groupAlgebraToReducedGroupCStarAlgebra`).
* When singletons are measurable (`[MeasurableSingletonClass Γ]`),
  `MeasureTheory.Measure.countHilbertBasis_conjStarAlgEquiv_leftRegular`,
  `TauCeti.countHilbertBasis_conjStarAlgEquiv_sum_leftRegularUnitary`, and
  `TauCeti.reducedGroupCStarAlgebraEquivOfApply` identify `C*_r(Γ)` under
  `(MeasureTheory.L2.countHilbertBasis ℂ Γ).repr` with `generatedCStarAlgebra ℂ lam` for any
  operator family `lam` satisfying `(lam g ξ) h = ξ (g⁻¹ * h)` (by
  `TauCeti.coe_leftTranslation_eq_of_apply`). Restricting `TauCeti.groupVonNeumannTrace Γ` yields
  the canonical faithful tracial state `TauCeti.reducedGroupCStarAlgebraTrace Γ : C*_r(Γ) →L[ℂ] ℂ`
  (bundled as `TauCeti.reducedGroupCStarAlgebraTracePositive Γ : C*_r(Γ) →P[ℂ] ℂ` with
  `TauCeti.isTracialState_reducedGroupCStarAlgebraTracePositive`), evaluating `f ∈ ℂ[Γ]` at
  `f.coeff 1`.

## References

* J. Peterson, *Notes on von Neumann Algebras* (2013), Chapter 5.
* P. de la Harpe, *On simplicity of reduced C*-algebras of groups*, Bull. Lond. Math. Soc. 39
  (2007), 1–26.
-/

public section

noncomputable section

open MeasureTheory VonNeumannAlgebra
open scoped ComplexConjugate ComplexOrder ENNReal InnerProductSpace

namespace TauCeti

section MeasurableMul

variable (Γ : Type*) [Group Γ] [MeasurableSpace Γ] [MeasurableMul Γ]

/-- **The reduced group C⋆-algebra `C*_r(Γ)`**, defined as the norm-closed unital ⋆-subalgebra of
`B(L²(Γ, Measure.count))` generated by the left regular representation. -/
def reducedGroupCStarAlgebra :
    StarSubalgebra ℂ
      (Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :=
  generatedCStarAlgebra ℂ ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)

/-- Unfolding lemma for `reducedGroupCStarAlgebra`. -/
theorem reducedGroupCStarAlgebra_def :
    reducedGroupCStarAlgebra Γ =
      generatedCStarAlgebra ℂ ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2) :=
  (rfl)

/-- The reduced group C⋆-algebra is norm-closed. -/
instance isClosed_reducedGroupCStarAlgebra :
    IsClosed (reducedGroupCStarAlgebra Γ :
      Set (Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))) :=
  isClosed_generatedCStarAlgebra _ _

variable {Γ}

/-- Every left regular unitary belongs to `reducedGroupCStarAlgebra Γ`. -/
@[simp]
theorem leftRegular_mem_reducedGroupCStarAlgebra (g : Γ) :
    (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g ∈ reducedGroupCStarAlgebra Γ :=
  apply_mem_generatedCStarAlgebra ℂ _ g

variable (Γ)

/-- The reduced group C⋆-algebra `C*_r(Γ)` is contained in the group von Neumann algebra
`L(Γ)`. -/
theorem reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra :
    reducedGroupCStarAlgebra Γ ≤ (groupVonNeumannAlgebra Γ).toStarSubalgebra :=
  (generatedCStarAlgebra_le_iff (groupVonNeumannAlgebra Γ).isClosed).2 fun g ↦
    leftRegular_mem_groupVonNeumannAlgebra g

/-- The reduced group C⋆-algebra `C*_r(Γ)` is contained in the commutant `R(Γ)'` of the right
group von Neumann algebra. -/
theorem reducedGroupCStarAlgebra_le_commutant_rightGroupVonNeumannAlgebra :
    reducedGroupCStarAlgebra Γ ≤ (rightGroupVonNeumannAlgebra Γ).commutant.toStarSubalgebra :=
  (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ).trans
    groupVonNeumannAlgebra_le_commutant_rightGroupVonNeumannAlgebra

variable {Γ}

/-- Every element of `reducedGroupCStarAlgebra Γ` commutes with right translations on `L²(Γ)`. -/
theorem commute_reducedGroupCStarAlgebra_rightRegular (x : reducedGroupCStarAlgebra Γ) (h : Γ) :
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) *
        (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 h =
      (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 h *
        (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :=
  (mem_commutant_rightGroupVonNeumannAlgebra_iff_rightRegular.1
    (reducedGroupCStarAlgebra_le_commutant_rightGroupVonNeumannAlgebra Γ x.property) h).symm

variable (Γ)

/-- The left regular representation as a group homomorphism into
`unitary (reducedGroupCStarAlgebra Γ)`. -/
def leftRegularUnitary : Γ →* unitary (reducedGroupCStarAlgebra Γ) where
  toFun g :=
    ⟨⟨(Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g,
        leftRegular_mem_reducedGroupCStarAlgebra g⟩,
      Unitary.mem_iff.2 ⟨
        Subtype.ext <| by
          rw [MulMemClass.coe_mul, StarMemClass.coe_star]
          exact (Unitary.mem_iff.1
            ((Measure.isUnitary_leftRegular Measure.count).mem_unitary g)).1,
        Subtype.ext <| by
          rw [MulMemClass.coe_mul, StarMemClass.coe_star]
          exact (Unitary.mem_iff.1
            ((Measure.isUnitary_leftRegular Measure.count).mem_unitary g)).2⟩⟩
  map_one' := Subtype.ext (Subtype.ext (map_one ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)))
  map_mul' g h :=
    Subtype.ext (Subtype.ext (map_mul ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2) g h))

/-- Viewing `leftRegularUnitary Γ g` in `B(L²(Γ))` yields
`(Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g`. -/
@[simp]
theorem coe_leftRegularUnitary (g : Γ) :
    ((leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) :
        Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) =
      (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g :=
  (rfl)

/-- Coercing `star (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ)` recovers
`leftRegular g⁻¹`. -/
@[simp]
theorem star_coe_leftRegularUnitary (g : Γ) :
    star (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) =
      (leftRegularUnitary Γ g⁻¹ : reducedGroupCStarAlgebra Γ) := by
  rw [← Unitary.coe_star, Unitary.star_eq_inv, ← map_inv]

/-- The canonical ⋆-algebra homomorphism `ℂ[Γ] →⋆ₐ[ℂ] reducedGroupCStarAlgebra Γ` sending `g` to
`leftRegularUnitary Γ g`. -/
def groupAlgebraToReducedGroupCStarAlgebra :
    MonoidAlgebra ℂ Γ →⋆ₐ[ℂ] reducedGroupCStarAlgebra Γ :=
  MonoidAlgebra.starLift ℂ Γ (reducedGroupCStarAlgebra Γ) (leftRegularUnitary Γ)

/-- Evaluating `groupAlgebraToReducedGroupCStarAlgebra Γ` on a group-algebra generator
`single g c`. -/
@[simp]
theorem groupAlgebraToReducedGroupCStarAlgebra_single (g : Γ) (c : ℂ) :
    groupAlgebraToReducedGroupCStarAlgebra Γ (MonoidAlgebra.single g c) =
      c • (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) :=
  MonoidAlgebra.starLift_single (leftRegularUnitary Γ) g c

/-- Expanding `groupAlgebraToReducedGroupCStarAlgebra Γ f` as a finite sum over
`f.coeff.support`. -/
theorem groupAlgebraToReducedGroupCStarAlgebra_eq_sum (f : MonoidAlgebra ℂ Γ) :
    groupAlgebraToReducedGroupCStarAlgebra Γ f =
      ∑ g ∈ f.coeff.support,
        f.coeff g • (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) := by
  conv_lhs => rw [← MonoidAlgebra.sum_coeff_single f]
  rw [Finsupp.sum, map_sum]
  simp

/-- Inclusion into `groupVonNeumannAlgebra Γ` sends `groupAlgebraToReducedGroupCStarAlgebra Γ f`
to `groupAlgebraToVonNeumannAlgebra Γ f`. -/
theorem inclusion_groupAlgebraToReducedGroupCStarAlgebra (f : MonoidAlgebra ℂ Γ) :
    StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)
        (groupAlgebraToReducedGroupCStarAlgebra Γ f) =
      groupAlgebraToVonNeumannAlgebra Γ f := by
  apply Subtype.ext
  rw [← StarSubalgebra.subtype_apply (groupVonNeumannAlgebra Γ).toStarSubalgebra,
    ← StarAlgHom.comp_apply, StarSubalgebra.subtype_comp_inclusion, StarSubalgebra.subtype_apply,
    ← StarSubalgebra.subtype_apply (groupVonNeumannAlgebra Γ).toStarSubalgebra]
  induction f using MonoidAlgebra.induction_linear with
  | zero => simp
  | add f₁ f₂ ih₁ ih₂ => simp [ih₁, ih₂]
  | single g c => simp

/-- Every element of `StarAlgebra.adjoin ℂ (Set.range leftRegular)` lies in the image of
`groupAlgebraToReducedGroupCStarAlgebra Γ`. -/
theorem exists_groupAlgebraToReducedGroupCStarAlgebra_of_mem_adjoin
    {y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)}
    (hy : y ∈ StarAlgebra.adjoin ℂ (Set.range ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2))) :
    ∃ f : MonoidAlgebra ℂ Γ,
      (groupAlgebraToReducedGroupCStarAlgebra Γ f :
          Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) = y := by
  let φ : MonoidAlgebra ℂ Γ →⋆ₐ[ℂ]
      (Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :=
    (reducedGroupCStarAlgebra Γ).subtype.comp (groupAlgebraToReducedGroupCStarAlgebra Γ)
  have hle : StarAlgebra.adjoin ℂ (Set.range ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)) ≤
      φ.range :=
    StarAlgebra.adjoin_le (by
      rintro _ ⟨g, rfl⟩
      exact (AlgHom.mem_range φ.toAlgHom).2 ⟨MonoidAlgebra.single g (1 : ℂ), by
        simp [φ, StarAlgHom.comp_apply, one_smul]⟩)
  obtain ⟨f, hf⟩ := (AlgHom.mem_range φ.toAlgHom).1 (hle hy)
  exact ⟨f, by simpa [φ, StarAlgHom.comp_apply] using hf⟩

/-- The image of `ℂ[Γ]` under `groupAlgebraToReducedGroupCStarAlgebra Γ` is dense in
`reducedGroupCStarAlgebra Γ`. -/
theorem denseRange_groupAlgebraToReducedGroupCStarAlgebra :
    DenseRange (groupAlgebraToReducedGroupCStarAlgebra Γ) := by
  refine (denseRange_inclusion_adjoin_generatedCStarAlgebra ℂ
    ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)).mono ?_
  rintro _ ⟨⟨a, ha⟩, rfl⟩
  obtain ⟨f, hf⟩ := exists_groupAlgebraToReducedGroupCStarAlgebra_of_mem_adjoin Γ ha
  exact ⟨f, Subtype.ext hf⟩

end MeasurableMul

/-- Any operator family `lam` on `ℓ²(Γ, E)` satisfying `(lam g ξ) h = ξ (g⁻¹ * h)` coincides
with `lp.leftTranslation 2 𝕜 g`. -/
theorem coe_leftTranslation_eq_of_apply {Γ 𝕜 E : Type*} [Group Γ] [NormedRing 𝕜]
    [NormedAddCommGroup E] [Module 𝕜 E] [IsBoundedSMul 𝕜 E]
    {lam : Γ → (lp (fun _ : Γ ↦ E) 2 →L[𝕜] lp (fun _ : Γ ↦ E) 2)}
    (hlam : ∀ g ξ h, lam g ξ h = ξ (g⁻¹ * h)) (g : Γ) :
    (lp.leftTranslation 2 𝕜 (X := Γ) (E := E) g :
      lp (fun _ : Γ ↦ E) 2 →L[𝕜] lp (fun _ : Γ ↦ E) 2) = lam g := by
  ext ξ h
  simp [hlam]

section Trace

variable {Γ : Type*} [Group Γ] [MeasurableSpace Γ] [MeasurableMul Γ] [MeasurableSingletonClass Γ]

/-- Conjugating a finite linear combination of left regular unitaries in `B(L²(Γ))` by
`(L2.countHilbertBasis ℂ Γ).repr` gives the corresponding combination of
`lp.leftTranslation 2 ℂ`. -/
theorem countHilbertBasis_conjStarAlgEquiv_sum_leftRegularUnitary
    (F : Finset Γ) (c : Γ → ℂ) :
    (L2.countHilbertBasis ℂ Γ).repr.conjStarAlgEquiv
        ((∑ f ∈ F, c f • (leftRegularUnitary Γ f : reducedGroupCStarAlgebra Γ) :
            reducedGroupCStarAlgebra Γ) :
          Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) =
      ∑ f ∈ F, c f • (lp.leftTranslation 2 ℂ (X := Γ) (E := ℂ) f :
        lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) := by
  simp [map_sum, Measure.countHilbertBasis_conjStarAlgEquiv_leftRegular]

/-- Any family `lam : Γ → B(ℓ²(Γ, ℂ))` satisfying `(lam g ξ) h = ξ (g⁻¹ * h)` generates a
C⋆-subalgebra ⋆-isomorphic to `reducedGroupCStarAlgebra Γ`, via conjugation by
`(L2.countHilbertBasis ℂ Γ).repr`. -/
def reducedGroupCStarAlgebraEquivOfApply
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, lam g ξ h = ξ (g⁻¹ * h)) :
    reducedGroupCStarAlgebra Γ ≃⋆ₐ[ℂ] generatedCStarAlgebra ℂ lam :=
  generatedCStarAlgebraEquiv (L2.countHilbertBasis ℂ Γ).repr.conjStarAlgEquiv
    (L2.countHilbertBasis ℂ Γ).repr.continuous_conjStarAlgEquiv
    (L2.countHilbertBasis ℂ Γ).repr.symm.continuous_conjStarAlgEquiv
    fun g ↦ (Measure.countHilbertBasis_conjStarAlgEquiv_leftRegular g).trans
      (coe_leftTranslation_eq_of_apply hlam g)

/-- Coercing `reducedGroupCStarAlgebraEquivOfApply hlam x` to `B(ℓ²(Γ, ℂ))` applies conjugation by
`(L2.countHilbertBasis ℂ Γ).repr`. -/
@[simp, norm_cast]
theorem coe_reducedGroupCStarAlgebraEquivOfApply
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, lam g ξ h = ξ (g⁻¹ * h)) (x : reducedGroupCStarAlgebra Γ) :
    (reducedGroupCStarAlgebraEquivOfApply hlam x :
        lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) =
      (L2.countHilbertBasis ℂ Γ).repr.conjStarAlgEquiv
        (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :=
  coe_generatedCStarAlgebraEquiv_apply _ _ _ _ x

/-- Coercing `(reducedGroupCStarAlgebraEquivOfApply hlam).symm y` to `B(L²(Γ))` applies inverse
conjugation by `(L2.countHilbertBasis ℂ Γ).repr`. -/
@[simp, norm_cast]
theorem coe_reducedGroupCStarAlgebraEquivOfApply_symm
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, lam g ξ h = ξ (g⁻¹ * h)) (y : generatedCStarAlgebra ℂ lam) :
    ((reducedGroupCStarAlgebraEquivOfApply hlam).symm y :
        Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) =
      (L2.countHilbertBasis ℂ Γ).repr.conjStarAlgEquiv.symm
        (y : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) :=
  coe_generatedCStarAlgebraEquiv_symm_apply _ _ _ _ y

/-- `reducedGroupCStarAlgebraEquivOfApply hlam` is continuous. -/
@[fun_prop]
theorem continuous_reducedGroupCStarAlgebraEquivOfApply
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, lam g ξ h = ξ (g⁻¹ * h)) :
    Continuous (reducedGroupCStarAlgebraEquivOfApply hlam) :=
  continuous_generatedCStarAlgebraEquiv _ _ _ _

/-- The inverse of `reducedGroupCStarAlgebraEquivOfApply hlam` is continuous. -/
@[fun_prop]
theorem continuous_reducedGroupCStarAlgebraEquivOfApply_symm
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, lam g ξ h = ξ (g⁻¹ * h)) :
    Continuous (reducedGroupCStarAlgebraEquivOfApply hlam).symm :=
  continuous_generatedCStarAlgebraEquiv_symm _ _ _ _

variable (Γ)

/-- **The canonical tracial state** `τ(x) = ⟪δ₁, x δ₁⟫_ℂ` on `reducedGroupCStarAlgebra Γ`, obtained
by restricting the vector functional `a ↦ ⟪δ₁, a δ₁⟫_ℂ`. -/
def reducedGroupCStarAlgebraTrace : reducedGroupCStarAlgebra Γ →L[ℂ] ℂ :=
  let δ₁ : Lp ℂ 2 (Measure.count : Measure Γ) := L2.countHilbertBasis ℂ Γ 1
  (vectorFunctional δ₁ δ₁).comp (reducedGroupCStarAlgebra Γ).toSubalgebra.toSubmodule.subtypeL

variable {Γ}

/-- Evaluating `reducedGroupCStarAlgebraTrace Γ` at `x` yields `⟪δ₁, x δ₁⟫_ℂ`. -/
theorem reducedGroupCStarAlgebraTrace_apply (x : reducedGroupCStarAlgebra Γ) :
    reducedGroupCStarAlgebraTrace Γ x =
      ⟪L2.countHilbertBasis ℂ Γ 1,
        (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
          (L2.countHilbertBasis ℂ Γ 1)⟫_ℂ := by
  rw [reducedGroupCStarAlgebraTrace, ContinuousLinearMap.comp_apply, Submodule.subtypeL_apply,
    vectorFunctional_apply]

/-- `reducedGroupCStarAlgebraTrace Γ` is the restriction of `groupVonNeumannTrace Γ` along the
inclusion `reducedGroupCStarAlgebra Γ ≤ (groupVonNeumannAlgebra Γ).toStarSubalgebra`. -/
theorem reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace (x : reducedGroupCStarAlgebra Γ) :
    reducedGroupCStarAlgebraTrace Γ x =
      groupVonNeumannTrace Γ
        (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ) x) := by
  simp [reducedGroupCStarAlgebraTrace_apply, groupVonNeumannTrace_apply, groupVonNeumannCoeff_def]

/-- The operator norm of `reducedGroupCStarAlgebraTrace Γ` is at most `1`. -/
theorem norm_reducedGroupCStarAlgebraTrace_le : ‖reducedGroupCStarAlgebraTrace Γ‖ ≤ 1 := by
  let δ₁ : Lp ℂ 2 (Measure.count : Measure Γ) := L2.countHilbertBasis ℂ Γ 1
  have hδ : ‖δ₁‖ = 1 := L2.norm_countHilbertBasis 1
  have hv : ‖vectorFunctional (𝕜 := ℂ) δ₁ δ₁‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun a ↦ ?_
    rw [vectorFunctional_apply, one_mul]
    exact (norm_inner_le_norm _ _).trans
      (by simpa [hδ] using mul_le_mul_of_nonneg_left (a.le_opNorm δ₁) (norm_nonneg δ₁))
  exact (ContinuousLinearMap.opNorm_comp_le _ _).trans
    ((mul_le_of_le_one_right (norm_nonneg _)
      (reducedGroupCStarAlgebra Γ).toSubalgebra.toSubmodule.norm_subtypeL_le).trans hv)

/-- The canonical trace is contractive: `‖reducedGroupCStarAlgebraTrace Γ x‖ ≤ ‖x‖`. -/
theorem norm_reducedGroupCStarAlgebraTrace_apply_le (x : reducedGroupCStarAlgebra Γ) :
    ‖reducedGroupCStarAlgebraTrace Γ x‖ ≤ ‖x‖ := by
  simpa using (reducedGroupCStarAlgebraTrace Γ).le_opNorm x |>.trans
    (mul_le_of_le_one_left (norm_nonneg _)
      (norm_reducedGroupCStarAlgebraTrace_le (Γ := Γ)))

/-- The canonical trace is unital. -/
@[simp]
theorem reducedGroupCStarAlgebraTrace_one : reducedGroupCStarAlgebraTrace Γ 1 = 1 := by
  rw [reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace, map_one, groupVonNeumannTrace_one]

/-- The canonical trace commutes with `star` as complex conjugation. -/
@[simp]
theorem reducedGroupCStarAlgebraTrace_star (x : reducedGroupCStarAlgebra Γ) :
    reducedGroupCStarAlgebraTrace Γ (star x) = conj (reducedGroupCStarAlgebraTrace Γ x) := by
  rw [reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace,
    reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace, map_star, groupVonNeumannTrace_star]

/-- Evaluating `reducedGroupCStarAlgebraTrace Γ` on `star x * x` gives `‖x δ₁‖ ^ 2`. -/
theorem reducedGroupCStarAlgebraTrace_star_mul_self (x : reducedGroupCStarAlgebra Γ) :
    reducedGroupCStarAlgebraTrace Γ (star x * x) =
      (‖(x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
        (L2.countHilbertBasis ℂ Γ 1)‖ ^ 2 : ℂ) := by
  rw [reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace, map_mul, map_star,
    groupVonNeumannTrace_star_mul, inner_self_eq_norm_sq_to_K]
  simp

/-- The canonical trace is nonnegative on `star x * x`. -/
@[simp]
theorem reducedGroupCStarAlgebraTrace_star_mul_self_nonneg (x : reducedGroupCStarAlgebra Γ) :
    0 ≤ reducedGroupCStarAlgebraTrace Γ (star x * x) := by
  rw [reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace, map_mul, map_star]
  exact groupVonNeumannTrace_star_mul_self_nonneg _

/-- The identity point mass `δ₁` is separating for `reducedGroupCStarAlgebra Γ`. -/
theorem eq_zero_of_reducedGroupCStarAlgebra_apply_countHilbertBasis_one
    {x : reducedGroupCStarAlgebra Γ}
    (hx : (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
      (L2.countHilbertBasis ℂ Γ 1) = 0) :
    x = 0 :=
  Subtype.ext <| (isSeparating_groupVonNeumannAlgebra_one Γ).eq_zero
    (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ x.property) hx

/-- The canonical trace is faithful: `τ (star x * x) = 0 ↔ x = 0`. -/
@[simp]
theorem reducedGroupCStarAlgebraTrace_star_mul_self_eq_zero_iff (x : reducedGroupCStarAlgebra Γ) :
    reducedGroupCStarAlgebraTrace Γ (star x * x) = 0 ↔ x = 0 := by
  refine ⟨fun h ↦ Subtype.ext ?_, fun h ↦ by simp [h]⟩
  rw [reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace,
    map_mul (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)),
    map_star (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)),
    groupVonNeumannTrace_star_mul_self_eq_zero_iff] at h
  simpa using congrArg Subtype.val h

/-- The canonical trace on `reducedGroupCStarAlgebra Γ` satisfies `τ (x * y) = τ (y * x)`. -/
theorem reducedGroupCStarAlgebraTrace_mul_comm (x y : reducedGroupCStarAlgebra Γ) :
    reducedGroupCStarAlgebraTrace Γ (x * y) = reducedGroupCStarAlgebraTrace Γ (y * x) := by
  rw [reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace,
    reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace,
    map_mul (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ)),
    map_mul (StarSubalgebra.inclusion (reducedGroupCStarAlgebra_le_groupVonNeumannAlgebra Γ))]
  exact groupVonNeumannTrace_mul_comm _ _

/-- The order on `reducedGroupCStarAlgebra Γ` inherited from the Loewner order on operators makes
it a star-ordered ring, matching the continuous functional calculus order. This specializes
`starOrderedRing_generatedCStarAlgebra` through the semireducible definition
`reducedGroupCStarAlgebra`, avoiding a typeclass synthesis failure/timeout on `L²(Γ)`. -/
instance instStarOrderedRingReducedGroupCStarAlgebra :
    StarOrderedRing (reducedGroupCStarAlgebra Γ) :=
  starOrderedRing_generatedCStarAlgebra _

/-- Pulling back `reducedGroupCStarAlgebraTrace Γ` along
`(reducedGroupCStarAlgebraEquivOfApply hlam).symm` computes the vector state at `lp.single 2 1 1`.
-/
theorem reducedGroupCStarAlgebraTrace_symm_equivOfApply [DecidableEq Γ]
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, lam g ξ h = ξ (g⁻¹ * h)) (x : generatedCStarAlgebra ℂ lam) :
    reducedGroupCStarAlgebraTrace Γ ((reducedGroupCStarAlgebraEquivOfApply hlam).symm x) =
      ⟪lp.single 2 (1 : Γ) (1 : ℂ),
        (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) (lp.single 2 (1 : Γ) (1 : ℂ))⟫_ℂ := by
  rw [reducedGroupCStarAlgebraTrace_apply, coe_reducedGroupCStarAlgebraEquivOfApply_symm,
    LinearIsometryEquiv.symm_conjStarAlgEquiv_apply_apply]
  have hre : ⟪L2.countHilbertBasis ℂ Γ 1, (L2.countHilbertBasis ℂ Γ).repr.symm
      ((x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
        ((L2.countHilbertBasis ℂ Γ).repr (L2.countHilbertBasis ℂ Γ 1)))⟫_ℂ =
      ⟪(L2.countHilbertBasis ℂ Γ).repr (L2.countHilbertBasis ℂ Γ 1),
        (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
          ((L2.countHilbertBasis ℂ Γ).repr (L2.countHilbertBasis ℂ Γ 1))⟫_ℂ := by
    simpa only [LinearIsometryEquiv.apply_symm_apply] using
      ((L2.countHilbertBasis ℂ Γ).repr.inner_map_map (L2.countHilbertBasis ℂ Γ 1)
        ((L2.countHilbertBasis ℂ Γ).repr.symm
          ((x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
            ((L2.countHilbertBasis ℂ Γ).repr (L2.countHilbertBasis ℂ Γ 1))))).symm
  rw [hre, (L2.countHilbertBasis ℂ Γ).repr_self]

variable (Γ) in
/-- **The canonical tracial state** `τ(x) = ⟪δ₁, x δ₁⟫_ℂ` on `reducedGroupCStarAlgebra Γ`,
bundled as a positive continuous linear functional `reducedGroupCStarAlgebra Γ →P[ℂ] ℂ`. -/
def reducedGroupCStarAlgebraTracePositive : reducedGroupCStarAlgebra Γ →P[ℂ] ℂ :=
  PositiveContinuousLinearMap.mk₀ (reducedGroupCStarAlgebraTrace Γ) fun x hx ↦ by
    obtain ⟨y, rfl⟩ := CStarAlgebra.nonneg_iff_eq_star_mul_self.1 hx
    exact reducedGroupCStarAlgebraTrace_star_mul_self_nonneg y

/-- Coercing `reducedGroupCStarAlgebraTracePositive Γ` to a continuous linear map yields
`reducedGroupCStarAlgebraTrace Γ`. -/
@[simp]
theorem toContinuousLinearMap_reducedGroupCStarAlgebraTracePositive :
    (reducedGroupCStarAlgebraTracePositive Γ : reducedGroupCStarAlgebra Γ →L[ℂ] ℂ) =
      reducedGroupCStarAlgebraTrace Γ :=
  PositiveContinuousLinearMap.toContinuousLinearMap_mk₀ _ _

/-- Evaluating `reducedGroupCStarAlgebraTracePositive Γ` yields
`reducedGroupCStarAlgebraTrace Γ`. -/
@[simp]
theorem reducedGroupCStarAlgebraTracePositive_apply (x : reducedGroupCStarAlgebra Γ) :
    reducedGroupCStarAlgebraTracePositive Γ x = reducedGroupCStarAlgebraTrace Γ x :=
  PositiveContinuousLinearMap.mk₀_apply _ _ x

/-- `reducedGroupCStarAlgebraTracePositive Γ` is a tracial state on `reducedGroupCStarAlgebra Γ`. -/
theorem isTracialState_reducedGroupCStarAlgebraTracePositive :
    (reducedGroupCStarAlgebraTracePositive Γ).IsTracialState :=
  PositiveContinuousLinearMap.isTracialState_iff_map_one.2
    ⟨reducedGroupCStarAlgebraTrace_one, fun x y ↦ by
      simp [reducedGroupCStarAlgebraTrace_mul_comm]⟩

/-- On the image of `MonoidAlgebra ℂ Γ`, `reducedGroupCStarAlgebraTrace Γ` extracts the identity
coefficient. -/
@[simp]
theorem reducedGroupCStarAlgebraTrace_groupAlgebraToReducedGroupCStarAlgebra
    (f : MonoidAlgebra ℂ Γ) :
    reducedGroupCStarAlgebraTrace Γ (groupAlgebraToReducedGroupCStarAlgebra Γ f) = f.coeff 1 := by
  rw [reducedGroupCStarAlgebraTrace_eq_groupVonNeumannTrace,
    inclusion_groupAlgebraToReducedGroupCStarAlgebra,
    groupVonNeumannTrace_groupAlgebraToVonNeumannAlgebra]

/-- The canonical trace of a left regular unitary equals `1` at `g = 1` and `0` otherwise. -/
@[simp]
theorem reducedGroupCStarAlgebraTrace_leftRegularUnitary [DecidableEq Γ] (g : Γ) :
    reducedGroupCStarAlgebraTrace Γ (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) =
      if g = 1 then 1 else 0 := by
  have h : (leftRegularUnitary Γ g : reducedGroupCStarAlgebra Γ) =
      groupAlgebraToReducedGroupCStarAlgebra Γ (MonoidAlgebra.single g (1 : ℂ)) := by
    simp
  rw [h, reducedGroupCStarAlgebraTrace_groupAlgebraToReducedGroupCStarAlgebra,
    MonoidAlgebra.coeff_single, Finsupp.single_apply, eq_comm]

