/-!
# Powers averaging, simplicity, and uniqueness of the trace

A group `Γ` has the *Powers partition property* (`TauCeti.HasPowersProperty Γ`) if for every finite
subset `F ⊆ Γ \ {1}` and every `N : ℕ`, there exist a partition `Γ = C ⊔ D` and elements
`γ : Fin N → Γ` such that `f • C` is disjoint from `C` for every `f ∈ F` and the translates
`γ j • D` are pairwise disjoint. By `FreeGroup.exists_powers_partition`, every free group on a
basis with two distinct elements has this property (`FreeGroup.hasPowersProperty_of_ne`).

For any left-regular unitary family `lam : Γ → (ℓ²(Γ, ℂ) →L[ℂ] ℓ²(Γ, ℂ))` pinned by
`(lam g ξ) h = ξ (g⁻¹ * h)`, we study the generated reduced group C⋆-algebra
`A = TauCeti.generatedCStarAlgebra lam`:

* **Canonical trace and separating vector**: `TauCeti.canonicalTrace` (`x ↦ ⟪δ₁, x δ₁⟫_ℂ`) is a
  faithful tracial state on `A`. Faithfulness follows because `A` commutes with right translations
  on `ℓ²(Γ, ℂ)`, so `δ₁` is separating for `A`.
* **Zero-compression averaging**: on the complementary projections `1 - P j` onto
  `ℓ²((γ j • ·) '' D)ᶜ`, any finite linear combination supported on `F ⊆ Γ \ {1}` has vanishing
  compression after conjugation by `lam (γ j)`. The projection averaging estimate yields the norm
  bound `2 * ‖x‖ / √N`.
* **Simplicity and unique trace**: approximating arbitrary elements (or finite families) of `A` by
  finite sums in `StarAlgebra.adjoin ℂ (Set.range lam)` shows that `τ(x) • 1` lies in the norm
  closure of the convex hull of unitary conjugates of `x`. Consequently, whenever
  `HasPowersProperty Γ` holds, `A` is a simple ring (`TauCeti.isSimpleRing_of_hasPowersProperty`)
  and `canonicalTrace lam` is the unique continuous unital tracial linear functional on `A`
  (`TauCeti.eq_canonicalTrace_of_hasPowersProperty`). Specializing to `FreeGroup ι` with two
  distinct generators gives `TauCeti.reducedFreeGroup_isSimpleRing` and
  `TauCeti.reducedFreeGroup_trace_unique`.

## References

* R. T. Powers, *Simplicity of the C*-algebra associated with the free group on two generators*,
  Duke Math. J. 42 (1975), 151–156.
* P. de la Harpe, *On simplicity of reduced C*-algebras of groups*, Bull. Lond. Math. Soc. 39
  (2007), 1–26, Definition 9, Theorem 14, and p. 19.
-/

public section

noncomputable section

open scoped InnerProductSpace ComplexOrder ENNReal lp

namespace TauCeti

section GeneratedCStarAlgebra

variable {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The C⋆-subalgebra generated by a family of bounded operators: the norm closure of the unital
⋆-subalgebra they generate. For the left-regular unitaries of a discrete group this is the
reduced group C⋆-algebra. -/
def generatedCStarAlgebra (T : ι → (H →L[ℂ] H)) : StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ (Set.range T)).topologicalClosure

/-- Unfolding lemma for `generatedCStarAlgebra`. -/
theorem generatedCStarAlgebra_def (T : ι → (H →L[ℂ] H)) :
    generatedCStarAlgebra T = (StarAlgebra.adjoin ℂ (Set.range T)).topologicalClosure :=
  (rfl)

/-- The generated C⋆-subalgebra is norm-closed. -/
instance isClosed_generatedCStarAlgebra (T : ι → (H →L[ℂ] H)) :
    IsClosed (generatedCStarAlgebra T : Set (H →L[ℂ] H)) :=
  StarSubalgebra.isClosed_topologicalClosure _

/-- Every generator belongs to the generated C⋆-subalgebra. -/
@[simp]
theorem apply_mem_generatedCStarAlgebra (T : ι → (H →L[ℂ] H)) (i : ι) :
    T i ∈ generatedCStarAlgebra T :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨i, rfl⟩)

/-- The unital ⋆-subalgebra generated by `T` is contained in `generatedCStarAlgebra T`. -/
theorem starAlgebra_adjoin_le_generatedCStarAlgebra (T : ι → (H →L[ℂ] H)) :
    StarAlgebra.adjoin ℂ (Set.range T) ≤ generatedCStarAlgebra T :=
  StarSubalgebra.le_topologicalClosure _

/-- A closed ⋆-subalgebra contains `generatedCStarAlgebra T` if and only if it contains every
generator `T i`. -/
theorem generatedCStarAlgebra_le_iff {T : ι → (H →L[ℂ] H)}
    {B : StarSubalgebra ℂ (H →L[ℂ] H)} (hB : IsClosed (B : Set (H →L[ℂ] H))) :
    generatedCStarAlgebra T ≤ B ↔ ∀ i, T i ∈ B := by
  refine ⟨fun h i ↦ h (apply_mem_generatedCStarAlgebra T i), fun h ↦ ?_⟩
  rw [generatedCStarAlgebra_def]
  exact StarSubalgebra.topologicalClosure_minimal
    (StarAlgebra.adjoin_le (by rintro _ ⟨i, rfl⟩; exact h i)) hB

/-- The unital ⋆-algebra generated by `T` is dense in `generatedCStarAlgebra T`. -/
theorem denseRange_inclusion_adjoin_generatedCStarAlgebra (T : ι → (H →L[ℂ] H)) :
    DenseRange (Set.inclusion (starAlgebra_adjoin_le_generatedCStarAlgebra T)) := by
  rw [denseRange_inclusion_iff (starAlgebra_adjoin_le_generatedCStarAlgebra T)]
  intro x hx
  simpa [generatedCStarAlgebra_def, StarSubalgebra.topologicalClosure_coe] using hx

/-- A closed predicate on `generatedCStarAlgebra T` holds everywhere once it holds on the dense
⋆-subalgebra `StarAlgebra.adjoin ℂ (Set.range T)`. -/
@[elab_as_elim]
theorem induction_generatedCStarAlgebra {T : ι → (H →L[ℂ] H)}
    {p : generatedCStarAlgebra T → Prop}
    (hp : IsClosed {x : generatedCStarAlgebra T | p x})
    (ih : ∀ x (hx : x ∈ StarAlgebra.adjoin ℂ (Set.range T)),
      p ⟨x, starAlgebra_adjoin_le_generatedCStarAlgebra T hx⟩)
    (x : generatedCStarAlgebra T) : p x :=
  (denseRange_inclusion_adjoin_generatedCStarAlgebra T).induction_on x hp fun ⟨a, ha⟩ ↦ ih a ha

/-- The generated C⋆-subalgebra on a nontrivial Hilbert space is nontrivial. -/
theorem nontrivial_generatedCStarAlgebra [Nontrivial H] (T : ι → (H →L[ℂ] H)) :
    Nontrivial (generatedCStarAlgebra T) := by
  obtain ⟨v, hv⟩ := exists_ne (0 : H)
  refine ⟨⟨1, 0, fun h ↦ hv ?_⟩⟩
  simpa using congrArg (fun x : generatedCStarAlgebra T ↦ (x : H →L[ℂ] H) v) h

end GeneratedCStarAlgebra

section PowersProperty

/-- **The Powers partition property** of a group `Γ` (de la Harpe, Definition 9): for every finite
set `F ⊆ Γ \ {1}` and every `N : ℕ`, there exist a partition `Γ = C ⊔ D` and elements
`γ : Fin N → Γ` such that `f • C` is disjoint from `C` for every `f ∈ F` and the translates
`γ j • D` are pairwise disjoint. -/
def HasPowersProperty (Γ : Type*) [Group Γ] : Prop :=
  ∀ (F : Finset Γ), (∀ f ∈ F, f ≠ 1) → ∀ N : ℕ,
    ∃ (C D : Set Γ) (γ : Fin N → Γ),
      Disjoint C D ∧ C ∪ D = Set.univ ∧
      (∀ f ∈ F, Disjoint ((fun x : Γ ↦ f * x) '' C) C) ∧
      Pairwise (fun i j : Fin N ↦
        Disjoint ((fun x : Γ ↦ γ i * x) '' D) ((fun x : Γ ↦ γ j * x) '' D))

/-- Unfolding lemma for `HasPowersProperty`. -/
theorem hasPowersProperty_def {Γ : Type*} [Group Γ] :
    HasPowersProperty Γ ↔
      ∀ (F : Finset Γ), (∀ f ∈ F, f ≠ 1) → ∀ N : ℕ,
        ∃ (C D : Set Γ) (γ : Fin N → Γ),
          Disjoint C D ∧ C ∪ D = Set.univ ∧
          (∀ f ∈ F, Disjoint ((fun x : Γ ↦ f * x) '' C) C) ∧
          Pairwise (fun i j : Fin N ↦
            Disjoint ((fun x : Γ ↦ γ i * x) '' D) ((fun x : Γ ↦ γ j * x) '' D)) :=
  Iff.rfl

/-- A free group on a type of generators with two distinct elements `a ≠ b` has the Powers
partition property. -/
theorem _root_.FreeGroup.hasPowersProperty_of_ne {α : Type*} {a b : α} (hab : a ≠ b) :
    HasPowersProperty (FreeGroup α) :=
  FreeGroup.exists_powers_partition a b hab

end PowersProperty

section LeftRegular

variable {Γ : Type*} [Group Γ]

/-- Right translation by `h` on `ℓ²(Γ, ℂ)`. -/
private def rightMulCLM (h : Γ) :
    lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2 :=
  (LinearIsometryEquiv.lpCongrLeft 2 ℂ ℂ (Equiv.mulRight h)).toLinearIsometry.toContinuousLinearMap

private theorem rightMulCLM_apply (h : Γ) (ξ : lp (fun _ : Γ ↦ ℂ) 2) (t : Γ) :
    rightMulCLM h ξ t = ξ (t * h⁻¹) := by
  simp [rightMulCLM]

private theorem star_rightMulCLM (h : Γ) :
    star (rightMulCLM h) = rightMulCLM h⁻¹ := by
  rw [ContinuousLinearMap.star_eq_adjoint]
  symm
  refine (ContinuousLinearMap.eq_adjoint_iff (rightMulCLM h⁻¹) (rightMulCLM h)).2 fun ξ η ↦ ?_
  simp only [lp.inner_eq_tsum, rightMulCLM_apply, inv_inv]
  rw [← (Equiv.mulRight h⁻¹).tsum_eq (fun t ↦ ⟪ξ (t * h), η t⟫_ℂ)]
  simp

variable {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
  (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h))

include hlam

/-- The left-regular operator of `1` is the identity. -/
theorem leftRegular_one : lam 1 = 1 := by
  ext ξ h
  simp [hlam]

/-- Left-regular operators multiply according to the group law. -/
theorem leftRegular_mul (g₁ g₂ : Γ) : lam (g₁ * g₂) = lam g₁ * lam g₂ := by
  ext ξ h
  simp [hlam, mul_assoc]

/-- The adjoint of `lam g` is `lam g⁻¹`. -/
theorem leftRegular_inv (g : Γ) : lam g⁻¹ = star (lam g) := by
  rw [ContinuousLinearMap.star_eq_adjoint]
  refine (ContinuousLinearMap.eq_adjoint_iff (lam g⁻¹) (lam g)).2 fun ξ η ↦ ?_
  simp only [lp.inner_eq_tsum, hlam, inv_inv]
  exact ((Equiv.mulLeft g⁻¹).tsum_eq (fun h ↦ ⟪ξ (g * h), η h⟫_ℂ)).symm.trans (by
    simp [mul_inv_cancel_left])

/-- Every left-regular operator is unitary. -/
theorem leftRegular_mem_unitary (g : Γ) :
    lam g ∈ unitary (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) := by
  refine Unitary.mem_iff.2 ⟨?_, ?_⟩
  · rw [← leftRegular_inv hlam, ← leftRegular_mul hlam, inv_mul_cancel, leftRegular_one hlam]
  · rw [← leftRegular_inv hlam, ← leftRegular_mul hlam, mul_inv_cancel, leftRegular_one hlam]

/-- Left-regular operators shift coordinate basis vectors. -/
@[simp]
theorem leftRegular_single [DecidableEq Γ] (g h : Γ) (a : ℂ) :
    lam g (lp.single 2 h a) = lp.single 2 (g * h) a := by
  ext t
  rw [hlam]
  by_cases ht : g⁻¹ * t = h
  · have htg : t = g * h := eq_mul_of_inv_mul_eq ht
    simp [htg]
  · have htg : t ≠ g * h := fun heq ↦ ht (by rw [heq, inv_mul_cancel_left])
    simp [ht, htg]

/-- Left-regular unitaries regarded as unitary elements of `generatedCStarAlgebra lam`. -/
def leftRegularUnitary (g : Γ) : unitary (generatedCStarAlgebra lam) where
  val := ⟨lam g, apply_mem_generatedCStarAlgebra lam g⟩
  property := Unitary.mem_iff.2 ⟨
    Subtype.ext <| by
      simpa using (Unitary.mem_iff.1 (leftRegular_mem_unitary hlam g)).1,
    Subtype.ext <| by
      simpa using (Unitary.mem_iff.1 (leftRegular_mem_unitary hlam g)).2⟩

/-- Viewing `leftRegularUnitary hlam g` in `lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2`
yields `lam g`. -/
@[simp]
theorem coe_leftRegularUnitary (g : Γ) :
    ((leftRegularUnitary hlam g : generatedCStarAlgebra lam) :
        lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) = lam g :=
  (rfl)

/-- The left-regular unitary at `1` is `1` in `generatedCStarAlgebra lam`. -/
@[simp]
theorem leftRegularUnitary_one : (leftRegularUnitary hlam 1 : generatedCStarAlgebra lam) = 1 :=
  Subtype.ext (leftRegular_one hlam)

/-- Left-regular unitaries in `generatedCStarAlgebra lam` multiply according to the group law. -/
@[simp]
theorem leftRegularUnitary_mul (g₁ g₂ : Γ) :
    (leftRegularUnitary hlam (g₁ * g₂) : generatedCStarAlgebra lam) =
      (leftRegularUnitary hlam g₁ : generatedCStarAlgebra lam) *
        (leftRegularUnitary hlam g₂ : generatedCStarAlgebra lam) :=
  Subtype.ext (leftRegular_mul hlam g₁ g₂)

/-- The star of `leftRegularUnitary hlam g` is `leftRegularUnitary hlam g⁻¹`. -/
@[simp]
theorem leftRegularUnitary_inv (g : Γ) :
    (leftRegularUnitary hlam g⁻¹ : generatedCStarAlgebra lam) =
      star (leftRegularUnitary hlam g : generatedCStarAlgebra lam) :=
  Subtype.ext (leftRegular_inv hlam g)

private theorem commute_leftRegular_rightMulCLM (g h : Γ) :
    lam g * rightMulCLM h = rightMulCLM h * lam g := by
  ext ξ t
  simp only [mul_apply_eq_comp, hlam, rightMulCLM_apply, mul_assoc]

/-- Every element of `generatedCStarAlgebra lam` commutes with right translations. -/
private theorem commute_generatedCStarAlgebra_rightMulCLM (x : generatedCStarAlgebra lam)
    (h : Γ) :
    (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) * rightMulCLM h =
      rightMulCLM h * (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) := by
  let S : StarSubalgebra ℂ (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) :=
    { carrier := {T | ∀ k : Γ, T * rightMulCLM k = rightMulCLM k * T}
      mul_mem' := fun ha hb k ↦ by
        rw [mul_assoc, hb k, ← mul_assoc, ha k, mul_assoc]
      one_mem' := fun k ↦ by simp
      add_mem' := fun ha hb k ↦ by
        rw [add_mul, mul_add, ha k, hb k]
      zero_mem' := fun k ↦ by simp
      algebraMap_mem' := fun c k ↦ by
        simp [Algebra.algebraMap_eq_smul_one]
      star_mem' := fun {T} hT k ↦ by
        have h' := congrArg star (hT k⁻¹)
        simpa [star_mul, star_rightMulCLM, inv_inv] using h'.symm }
  have hS : IsClosed (S : Set (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)) := by
    have heq : (S : Set (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)) =
        ⋂ k : Γ, {T | T * rightMulCLM k = rightMulCLM k * T} := by
      ext T
      simp [S]
    rw [heq]
    exact isClosed_iInter fun k ↦ isClosed_eq (continuous_mul_const _) (continuous_const_mul _)
  have hle : generatedCStarAlgebra lam ≤ S :=
    (generatedCStarAlgebra_le_iff hS).2 fun g k ↦ commute_leftRegular_rightMulCLM hlam g k
  exact hle x.property h

/-- The identity point mass `δ₁` is separating for `generatedCStarAlgebra lam`: if `x δ₁ = 0`,
then `x = 0`. -/
theorem eq_zero_of_apply_single_one [DecidableEq Γ] {x : generatedCStarAlgebra lam}
    (hx : (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
      (lp.single 2 (1 : Γ) (1 : ℂ)) = 0) :
    x = 0 := by
  apply Subtype.ext
  refine ContinuousLinearMap.ext fun ξ ↦ ?_
  have hsingle (h : Γ) :
      (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
        (lp.single 2 h (1 : ℂ)) = 0 := by
    have hr : rightMulCLM h (lp.single 2 (1 : Γ) (1 : ℂ)) = lp.single 2 h (1 : ℂ) := by
      simp [rightMulCLM]
    have hcomp :
        (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
          (rightMulCLM h (lp.single 2 (1 : Γ) (1 : ℂ))) =
          ((x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) * rightMulCLM h)
            (lp.single 2 (1 : Γ) (1 : ℂ)) :=
      rfl
    have hcomp' :
        (rightMulCLM h * (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2))
          (lp.single 2 (1 : Γ) (1 : ℂ)) =
          rightMulCLM h ((x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
            (lp.single 2 (1 : Γ) (1 : ℂ))) :=
      rfl
    rw [← hr, hcomp, commute_generatedCStarAlgebra_rightMulCLM hlam x h, hcomp', hx, map_zero]
  have hsum : HasSum (fun h : Γ ↦ lp.single (E := fun _ : Γ ↦ ℂ) 2 h (ξ h)) ξ :=
    lp.hasSum_single (p := 2) ENNReal.ofNat_ne_top ξ
  have hsum_x := hsum.map (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
    (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2).continuous
  have hterm (h : Γ) :
      (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
        (lp.single (E := fun _ : Γ ↦ ℂ) 2 h (ξ h)) = 0 := by
    have hs : lp.single (E := fun _ : Γ ↦ ℂ) 2 h (ξ h) =
        (ξ h) • lp.single (E := fun _ : Γ ↦ ℂ) 2 h (1 : ℂ) := by
      ext t
      by_cases ht : t = h <;> simp [ht]
    rw [hs, map_smul, hsingle h, smul_zero]
  simp only [Function.comp_def, hterm] at hsum_x
  exact hsum_x.unique hasSum_zero

/-- Every element of `StarAlgebra.adjoin ℂ (Set.range lam)` is a finite `ℂ`-linear combination of
left-regular operators `lam g`. -/
theorem mem_span_range_of_mem_adjoin {y : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2}
    (hy : y ∈ StarAlgebra.adjoin ℂ (Set.range lam)) :
    y ∈ Submodule.span ℂ (Set.range lam) := by
  have mul_mem_span {a b : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2}
      (ha : a ∈ Submodule.span ℂ (Set.range lam))
      (hb : b ∈ Submodule.span ℂ (Set.range lam)) :
      a * b ∈ Submodule.span ℂ (Set.range lam) := by
    induction ha using Submodule.span_induction with
    | mem _ hx' =>
      obtain ⟨g, rfl⟩ := hx'
      induction hb using Submodule.span_induction with
      | mem _ hy' =>
        obtain ⟨h, rfl⟩ := hy'
        rw [← leftRegular_mul hlam g h]
        exact Submodule.subset_span ⟨g * h, rfl⟩
      | zero => simp
      | add _ _ _ _ h₁ h₂ => rw [mul_add]; exact Submodule.add_mem _ h₁ h₂
      | smul r _ _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ r h
    | zero => simp
    | add _ _ _ _ h₁ h₂ => rw [add_mul]; exact Submodule.add_mem _ h₁ h₂
    | smul r _ _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r h
  have star_mem_span {a : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2}
      (ha : a ∈ Submodule.span ℂ (Set.range lam)) :
      star a ∈ Submodule.span ℂ (Set.range lam) := by
    induction ha using Submodule.span_induction with
    | mem _ hx' =>
      obtain ⟨g, rfl⟩ := hx'
      rw [← leftRegular_inv hlam g]
      exact Submodule.subset_span ⟨g⁻¹, rfl⟩
    | zero =>
      rw [ContinuousLinearMap.star_eq_adjoint, map_zero]
      exact zero_mem _
    | add _ _ _ _ h₁ h₂ =>
      rw [ContinuousLinearMap.star_eq_adjoint, map_add,
        ← ContinuousLinearMap.star_eq_adjoint, ← ContinuousLinearMap.star_eq_adjoint]
      exact Submodule.add_mem _ h₁ h₂
    | smul r _ _ h =>
      rw [ContinuousLinearMap.star_eq_adjoint, map_smulₛₗ,
        ← ContinuousLinearMap.star_eq_adjoint]
      exact Submodule.smul_mem _ (star r) h
  induction hy using StarAlgebra.adjoin_induction with
  | mem _ hx => exact Submodule.subset_span hx
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one, ← leftRegular_one hlam]
    exact Submodule.smul_mem _ r (Submodule.subset_span ⟨1, rfl⟩)
  | add _ _ _ _ hx hy => exact Submodule.add_mem _ hx hy
  | mul _ _ _ _ hx hy => exact mul_mem_span hx hy
  | star _ _ hx => exact star_mem_span hx

/-- Every element of `StarAlgebra.adjoin ℂ (Set.range lam)` is a finitely supported sum
`∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)`. -/
theorem exists_finsupp_sum_of_mem_adjoin {y : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2}
    (hy : y ∈ StarAlgebra.adjoin ℂ (Set.range lam)) :
    ∃ c : Γ →₀ ℂ, (⟨y, starAlgebra_adjoin_le_generatedCStarAlgebra lam hy⟩ :
        generatedCStarAlgebra lam) =
      ∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam) := by
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.1
    (mem_span_range_of_mem_adjoin hlam hy)
  refine ⟨c, Subtype.ext ?_⟩
  simpa [Finsupp.sum] using hc.symm

end LeftRegular

section CanonicalTrace

variable {Γ : Type*} [Group Γ]

/-- **The canonical tracial state** `τ(x) = ⟪δ₁, x δ₁⟫_ℂ` on `generatedCStarAlgebra lam`. -/
def canonicalTrace (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)) :
    generatedCStarAlgebra lam →L[ℂ] ℂ :=
  letI := Classical.decEq Γ
  LinearMap.mkContinuous
    { toFun := fun x ↦
        ⟪(lp.single 2 (1 : Γ) (1 : ℂ) : lp (fun _ : Γ ↦ ℂ) 2),
          (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
            (lp.single 2 (1 : Γ) (1 : ℂ))⟫_ℂ
      map_add' := fun x y ↦ by simp [inner_add_right]
      map_smul' := fun c x ↦ by simp [inner_smul_right] }
    1 fun x ↦ by
      let δ₁ : lp (fun _ : Γ ↦ ℂ) 2 := lp.single 2 (1 : Γ) (1 : ℂ)
      have h1 : ‖δ₁‖ = 1 := by
        simp only [δ₁]
        rw [lp.norm_single (E := fun _ : Γ ↦ ℂ) (p := 2) (by norm_num) (1 : Γ) (1 : ℂ), norm_one]
      calc ‖⟪δ₁, (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) δ₁⟫_ℂ‖
          ≤ ‖δ₁‖ * ‖(x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) δ₁‖ :=
            norm_inner_le_norm _ _
        _ ≤ 1 * ‖(x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) δ₁‖ := by
            rw [h1]
        _ ≤ 1 * (‖(x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)‖ * ‖δ₁‖) :=
            mul_le_mul_of_nonneg_left (ContinuousLinearMap.le_opNorm _ _) zero_le_one
        _ = 1 * ‖x‖ := by rw [h1, mul_one]; rfl

/-- Evaluating `canonicalTrace lam` at `x` yields `⟪δ₁, x δ₁⟫_ℂ`. -/
theorem canonicalTrace_apply [DecidableEq Γ]
    (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2))
    (x : generatedCStarAlgebra lam) :
    canonicalTrace lam x =
      ⟪(lp.single 2 (1 : Γ) (1 : ℂ) : lp (fun _ : Γ ↦ ℂ) 2),
        (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
          (lp.single 2 (1 : Γ) (1 : ℂ))⟫_ℂ := by
  have hdec : Classical.decEq Γ = ‹DecidableEq Γ› := Subsingleton.elim _ _
  calc canonicalTrace lam x
      = letI := Classical.decEq Γ
        ⟪(lp.single 2 (1 : Γ) (1 : ℂ) : lp (fun _ : Γ ↦ ℂ) 2),
          (x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
            (lp.single 2 (1 : Γ) (1 : ℂ))⟫_ℂ := rfl
    _ = _ := by rw [hdec]

/-- The operator norm of `canonicalTrace lam` is at most `1`. -/
theorem norm_canonicalTrace_le
    (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)) :
    ‖canonicalTrace lam‖ ≤ 1 :=
  LinearMap.mkContinuous_norm_le _ zero_le_one _

/-- The canonical trace is contractive: `‖canonicalTrace lam x‖ ≤ ‖x‖`. -/
theorem norm_canonicalTrace_apply_le
    (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2))
    (x : generatedCStarAlgebra lam) :
    ‖canonicalTrace lam x‖ ≤ ‖x‖ := by
  simpa using (canonicalTrace lam).le_opNorm x |>.trans
    (mul_le_of_le_one_left (norm_nonneg _) (norm_canonicalTrace_le lam))

/-- The canonical trace is unital. -/
@[simp]
theorem canonicalTrace_one
    (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)) :
    canonicalTrace lam 1 = 1 := by
  classical
  simp [canonicalTrace_apply]

/-- The canonical trace of a left-regular unitary equals `1` at `g = 1` and `0` otherwise. -/
@[simp]
theorem canonicalTrace_leftRegularUnitary [DecidableEq Γ]
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h)) (g : Γ) :
    canonicalTrace lam (leftRegularUnitary hlam g : generatedCStarAlgebra lam) =
      if g = 1 then 1 else 0 := by
  rw [canonicalTrace_apply, coe_leftRegularUnitary, leftRegular_single hlam, lp.inner_single_left,
    lp.single_apply]
  by_cases hg : g = 1 <;> simp [hg, eq_comm]

/-- Evaluating `canonicalTrace lam` on `star x * x` gives `‖x δ₁‖ ^ 2`. -/
theorem canonicalTrace_star_mul_self [DecidableEq Γ]
    (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2))
    (x : generatedCStarAlgebra lam) :
    canonicalTrace lam (star x * x) =
      (‖(x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
        (lp.single 2 (1 : Γ) (1 : ℂ))‖ ^ 2 : ℂ) := by
  rw [canonicalTrace_apply, MulMemClass.coe_mul, StarMemClass.coe_star,
    ContinuousLinearMap.star_eq_adjoint, mul_apply_eq_comp,
    ContinuousLinearMap.adjoint_inner_right, inner_self_eq_norm_sq_to_K,
    RCLike.ofReal_eq_complex_ofReal]

/-- The canonical trace is positive on `star x * x`. -/
@[simp]
theorem canonicalTrace_nonneg_star_mul_self
    (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2))
    (x : generatedCStarAlgebra lam) :
    0 ≤ canonicalTrace lam (star x * x) := by
  classical
  rw [canonicalTrace_star_mul_self, ← Complex.ofReal_pow]
  exact Complex.zero_le_real.2 (sq_nonneg _)

/-- The canonical trace is faithful: `τ (star x * x) = 0` iff `x = 0`. -/
@[simp]
theorem canonicalTrace_star_mul_self_eq_zero_iff
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h)) (x : generatedCStarAlgebra lam) :
    canonicalTrace lam (star x * x) = 0 ↔ x = 0 := by
  classical
  refine ⟨fun h ↦ ?_, fun h ↦ by simp [h]⟩
  rw [canonicalTrace_star_mul_self] at h
  have hnorm : ‖(x : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)
      (lp.single 2 (1 : Γ) (1 : ℂ))‖ = 0 :=
    (pow_eq_zero_iff two_ne_zero).1 (by exact_mod_cast h)
  exact eq_zero_of_apply_single_one hlam (norm_eq_zero.1 hnorm)

/-- The canonical trace satisfies the trace identity `τ (x * y) = τ (y * x)` on
`generatedCStarAlgebra lam`. -/
theorem canonicalTrace_mul_comm
    {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
    (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h)) (x y : generatedCStarAlgebra lam) :
    canonicalTrace lam (x * y) = canonicalTrace lam (y * x) := by
  classical
  have hgen (g h : Γ) :
      canonicalTrace lam ((leftRegularUnitary hlam g : generatedCStarAlgebra lam) *
          (leftRegularUnitary hlam h : generatedCStarAlgebra lam)) =
        canonicalTrace lam ((leftRegularUnitary hlam h : generatedCStarAlgebra lam) *
          (leftRegularUnitary hlam g : generatedCStarAlgebra lam)) := by
    have heq : (g * h = 1) ↔ (h * g = 1) := by
      rw [mul_eq_one_iff_eq_inv, mul_eq_one_iff_inv_eq, eq_comm]
    simp only [← leftRegularUnitary_mul, canonicalTrace_leftRegularUnitary, heq]
  have hadj : ∀ a (ha : a ∈ StarAlgebra.adjoin ℂ (Set.range lam)),
      ∀ b (hb : b ∈ StarAlgebra.adjoin ℂ (Set.range lam)),
        canonicalTrace lam (⟨a, starAlgebra_adjoin_le_generatedCStarAlgebra lam ha⟩ *
            ⟨b, starAlgebra_adjoin_le_generatedCStarAlgebra lam hb⟩) =
          canonicalTrace lam (⟨b, starAlgebra_adjoin_le_generatedCStarAlgebra lam hb⟩ *
            ⟨a, starAlgebra_adjoin_le_generatedCStarAlgebra lam ha⟩) := by
    intro a ha b hb
    obtain ⟨c₁, hc₁⟩ := exists_finsupp_sum_of_mem_adjoin hlam ha
    obtain ⟨c₂, hc₂⟩ := exists_finsupp_sum_of_mem_adjoin hlam hb
    rw [hc₁, hc₂]
    simp only [Finset.sum_mul, Finset.mul_sum, smul_mul_assoc, mul_smul_comm, map_sum, map_smul,
      smul_eq_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun h _ ↦ Finset.sum_congr rfl fun g _ ↦ ?_
    rw [mul_left_comm, hgen g h]
  have hleft : ∀ a (ha : a ∈ StarAlgebra.adjoin ℂ (Set.range lam)),
      ∀ y : generatedCStarAlgebra lam,
        canonicalTrace lam (⟨a, starAlgebra_adjoin_le_generatedCStarAlgebra lam ha⟩ * y) =
          canonicalTrace lam (y * ⟨a, starAlgebra_adjoin_le_generatedCStarAlgebra lam ha⟩) := by
    intro a ha y
    induction y using induction_generatedCStarAlgebra with
    | hp =>
      exact isClosed_eq
        ((canonicalTrace lam).continuous.comp (continuous_const_mul _))
        ((canonicalTrace lam).continuous.comp (continuous_mul_const _))
    | ih b hb => exact hadj a ha b hb
  induction x using induction_generatedCStarAlgebra with
  | hp =>
    exact isClosed_eq
      ((canonicalTrace lam).continuous.comp (continuous_mul_const _))
      ((canonicalTrace lam).continuous.comp (continuous_const_mul _))
  | ih a ha => exact hleft a ha y

end CanonicalTrace

section Averaging

variable {Γ : Type*} [Group Γ]
  {lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)}
  (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h))

include hlam

/-- **Zero compression on the complement of `γ • D`.** When `C ⊔ D = univ` is a partition of `Γ`
with `Disjoint ((f * ·) '' C) C`, conjugating `lam f` by `lam g` has vanishing compression onto the
complement of `(g * ·) '' D`. -/
theorem compression_sub_indicatorCLM_leftRegular_eq_zero {C D : Set Γ}
    (hCDU : C ∪ D = Set.univ) {f : Γ} (hfC : Disjoint ((fun x : Γ ↦ f * x) '' C) C) (g : Γ) :
    (1 - lp.indicatorCLM 2 ℂ ((fun x : Γ ↦ g * x) '' D)) *
        (lam g * lam f * star (lam g)) *
        (1 - lp.indicatorCLM 2 ℂ ((fun x : Γ ↦ g * x) '' D)) = 0 := by
  set S : Set Γ := (fun x : Γ ↦ g * x) '' D
  rw [← lp.indicatorCLM_compl, ← leftRegular_inv hlam, ← leftRegular_mul hlam,
    ← leftRegular_mul hlam]
  ext ξ t
  simp only [mul_apply_eq_comp, zero_apply, lp.coeFn_zero, Pi.zero_apply, lp.indicatorCLM_apply]
  by_cases ht : t ∈ Sᶜ
  · rw [Set.indicator_of_mem ht, hlam]
    have hgtD : g⁻¹ * t ∉ D := fun hmem ↦ ht ⟨g⁻¹ * t, hmem, mul_inv_cancel_left g t⟩
    have hgtC : g⁻¹ * t ∈ C := by
      have huniv : g⁻¹ * t ∈ C ∪ D := hCDU.symm ▸ Set.mem_univ _
      exact huniv.resolve_right hgtD
    have hfc : f⁻¹ * (g⁻¹ * t) ∉ C := by
      intro hmem
      exact Set.disjoint_left.1 hfC ⟨f⁻¹ * (g⁻¹ * t), hmem, mul_inv_cancel_left f _⟩ hgtC
    have hfD : f⁻¹ * (g⁻¹ * t) ∈ D := by
      have huniv : f⁻¹ * (g⁻¹ * t) ∈ C ∪ D := hCDU.symm ▸ Set.mem_univ _
      exact huniv.resolve_left hfc
    have harg : (g * f * g⁻¹)⁻¹ * t ∈ S := by
      refine ⟨f⁻¹ * (g⁻¹ * t), hfD, ?_⟩
      group
    rw [lp.indicatorCLM_apply]
    exact Set.indicator_of_notMem (Set.notMem_compl_iff.2 harg) _
  · exact Set.indicator_of_notMem ht _

/-- **Powers's operator-norm averaging bound.** For a finite sum `x = ∑ f ∈ F, c f • lam f` with
`F` disjoint from `{1}`, a Powers partition `(C, D, γ)` yields
`‖(N : ℂ)⁻¹ • ∑ j, lam (γ j) * x * star (lam (γ j))‖ ≤ 2 * ‖x‖ / √N`. -/
theorem norm_average_unitary_conj_le_of_powersPartition
    {F : Finset Γ} {C D : Set Γ} {N : ℕ} {γ : Fin N → Γ}
    (hCDU : C ∪ D = Set.univ)
    (hfC : ∀ f ∈ F, Disjoint ((fun x : Γ ↦ f * x) '' C) C)
    (hγD : Pairwise fun i j : Fin N ↦
      Disjoint ((fun x : Γ ↦ γ i * x) '' D) ((fun x : Γ ↦ γ j * x) '' D))
    (c : Γ → ℂ) :
    ‖(N : ℂ)⁻¹ • ∑ j : Fin N,
        lam (γ j) * (∑ f ∈ F, c f • lam f) * star (lam (γ j))‖ ≤
      2 * ‖∑ f ∈ F, c f • lam f‖ / Real.sqrt N := by
  let x := ∑ f ∈ F, c f • lam f
  let P : Fin N → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) :=
    fun j ↦ lp.indicatorCLM 2 ℂ ((fun y : Γ ↦ γ j * y) '' D)
  let U : Fin N → unitary (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) :=
    fun j ↦ ⟨lam (γ j), leftRegular_mem_unitary hlam (γ j)⟩
  have hzero : ∀ j ∈ (Finset.univ : Finset (Fin N)),
      (1 - P j) * ((U j : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) * x *
        star (U j : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2)) * (1 - P j) = 0 := by
    intro j _
    simp only [x, U, Finset.mul_sum, Finset.sum_mul, mul_smul_comm, smul_mul_assoc]
    exact Finset.sum_eq_zero fun f hf ↦ by
      rw [compression_sub_indicatorCLM_leftRegular_eq_zero hlam hCDU (hfC f hf) (γ j)]
      ext
      simp
  simpa [P, U, x] using
    ContinuousLinearMap.norm_average_unitary_conj_le_two_mul_div_sqrt_card_of_compression_eq_zero
      x U P Finset.univ
      (fun j _ ↦ lp.isStarProjection_indicatorCLM ℂ _)
      (fun i _ j _ hij ↦ lp.indicatorCLM_mul_of_disjoint (hγD hij))
      hzero

private theorem norm_average_unitary_conj_sub_le {N : ℕ} (hN : 0 < N) (γ : Fin N → Γ)
    (z : generatedCStarAlgebra lam) :
    ‖(N : ℂ)⁻¹ • ∑ j : Fin N,
        (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * z *
          star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)‖ ≤ ‖z‖ := by
  have hN0 : (0 : ℝ) < N := Nat.cast_pos.2 hN
  rw [norm_smul, norm_inv, Complex.norm_natCast]
  calc (N : ℝ)⁻¹ * ‖∑ j : Fin N,
          (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * z *
            star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)‖
      ≤ (N : ℝ)⁻¹ * ∑ j : Fin N,
          ‖(leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * z *
            star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)‖ := by
        gcongr
        exact norm_sum_le _ _
    _ = (N : ℝ)⁻¹ * (N • ‖z‖) := by
        simp [CStarRing.norm_unitary_conj]
    _ = ‖z‖ := by
        rw [nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hN0.ne', one_mul]

private theorem average_unitary_conj_one {N : ℕ} (hN : 0 < N) (γ : Fin N → Γ) :
    (N : ℂ)⁻¹ • ∑ j : Fin N,
        (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * 1 *
          star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) = 1 := by
  have hN0 : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.2 hN.ne'
  have hterm (j : Fin N) :
      (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * 1 *
          star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) = 1 := by
    rw [mul_one, Unitary.mul_star_self_of_mem (leftRegularUnitary hlam (γ j)).property]
  simp_rw [hterm]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, ← Nat.cast_smul_eq_nsmul ℂ,
    smul_smul, inv_mul_cancel₀ hN0, one_smul]

private theorem finsupp_sum_sub_canonicalTrace_eq [DecidableEq Γ] {F : Finset Γ}
    (hF : ∀ f ∈ F, f ≠ 1) (c : Γ →₀ ℂ) (hcF : c.support.erase 1 ⊆ F) :
    (∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)) -
        canonicalTrace lam
          (∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)) • 1 =
      ∑ f ∈ F, c f • (leftRegularUnitary hlam f : generatedCStarAlgebra lam) := by
  have htr : canonicalTrace lam
      (∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)) = c 1 := by
    simp only [map_sum, map_smul, smul_eq_mul, canonicalTrace_leftRegularUnitary]
    by_cases h1 : (1 : Γ) ∈ c.support
    · rw [Finset.sum_eq_single (1 : Γ)]
      · simp
      · intro g _ hg; simp [hg]
      · intro hnot; exact (hnot h1).elim
    · rw [Finsupp.notMem_support_iff.1 h1]
      refine Finset.sum_eq_zero fun g hg ↦ ?_
      have hg1 : g ≠ 1 := fun hge ↦ h1 (hge ▸ hg)
      simp [hg1]
  have hsum_F : ∑ f ∈ F, c f • (leftRegularUnitary hlam f : generatedCStarAlgebra lam) =
      ∑ f ∈ c.support.erase 1, c f • (leftRegularUnitary hlam f : generatedCStarAlgebra lam) := by
    refine (Finset.sum_subset hcF fun f hfF hfnot ↦ ?_).symm
    have hnot : f ∉ c.support := fun hmem ↦ hfnot (Finset.mem_erase.2 ⟨hF f hfF, hmem⟩)
    simp [Finsupp.notMem_support_iff.1 hnot]
  rw [htr, hsum_F]
  by_cases h1 : (1 : Γ) ∈ c.support
  · rw [← Finset.add_sum_erase c.support
      (fun g ↦ c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)) h1,
      leftRegularUnitary_one hlam, add_sub_cancel_left]
  · rw [Finsupp.notMem_support_iff.1 h1, zero_smul, sub_zero, Finset.erase_eq_of_notMem h1]

private theorem norm_average_sub_canonicalTrace_lt_of_approx {N : ℕ} (hN : 0 < N)
    (γ : Fin N → Γ) {x y : generatedCStarAlgebra lam} {ε : ℝ}
    (hxy : ‖x - y‖ < ε / 3)
    (hMy : ‖((N : ℂ)⁻¹ • ∑ j : Fin N,
        (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) *
          (y - canonicalTrace lam y • 1) *
          star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam))‖ < ε / 3) :
    ‖((N : ℂ)⁻¹ • ∑ j : Fin N,
        (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * x *
          star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)) -
      canonicalTrace lam x • 1‖ < ε := by
  let M : generatedCStarAlgebra lam → generatedCStarAlgebra lam := fun z ↦
    (N : ℂ)⁻¹ • ∑ j : Fin N,
      (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * z *
        star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)
  have hM_sub (a b : generatedCStarAlgebra lam) : M (a - b) = M a - M b := by
    simp only [M, mul_sub, sub_mul, Finset.sum_sub_distrib, smul_sub]
  have hM_smul (r : ℂ) (a : generatedCStarAlgebra lam) : M (r • a) = r • M a := by
    simp only [M, mul_smul_comm, smul_mul_assoc, ← Finset.smul_sum]
    rw [smul_comm]
  have hM1 : M 1 = 1 := average_unitary_conj_one hlam hN γ
  have hdecomp : M x - canonicalTrace lam x • 1 =
      M (x - y) + M (y - canonicalTrace lam y • 1) +
        (canonicalTrace lam y - canonicalTrace lam x) • 1 := by
    rw [hM_sub, hM_sub, hM_smul, hM1, sub_smul]
    abel
  have hnorm1 : ‖M (x - y)‖ < ε / 3 :=
    (norm_average_unitary_conj_sub_le hlam hN γ (x - y)).trans_lt hxy
  have hnorm3 : ‖(canonicalTrace lam y - canonicalTrace lam x) •
      (1 : generatedCStarAlgebra lam)‖ < ε / 3 := by
    calc ‖(canonicalTrace lam y - canonicalTrace lam x) • (1 : generatedCStarAlgebra lam)‖
        = ‖canonicalTrace lam (y - x)‖ * ‖(1 : generatedCStarAlgebra lam)‖ := by
          rw [norm_smul, map_sub]
      _ ≤ ‖canonicalTrace lam (y - x)‖ * 1 :=
          mul_le_mul_of_nonneg_left CStarRing.norm_one_le (norm_nonneg _)
      _ = ‖canonicalTrace lam (y - x)‖ := mul_one _
      _ ≤ ‖y - x‖ := norm_canonicalTrace_apply_le lam _
      _ = ‖x - y‖ := norm_sub_rev _ _
      _ < ε / 3 := hxy
  rw [hdecomp]
  calc ‖M (x - y) + M (y - canonicalTrace lam y • 1) +
        (canonicalTrace lam y - canonicalTrace lam x) • 1‖
      ≤ ‖M (x - y) + M (y - canonicalTrace lam y • 1)‖ +
          ‖(canonicalTrace lam y - canonicalTrace lam x) • (1 : generatedCStarAlgebra lam)‖ :=
        norm_add_le _ _
    _ ≤ (‖M (x - y)‖ + ‖M (y - canonicalTrace lam y • 1)‖) +
          ‖(canonicalTrace lam y - canonicalTrace lam x) • (1 : generatedCStarAlgebra lam)‖ :=
        add_le_add (norm_add_le _ _) le_rfl
    _ < ε / 3 + ε / 3 + ε / 3 := by linarith
    _ = ε := by ring

private theorem exists_finsupp_norm_sub_lt (x : generatedCStarAlgebra lam) {δ : ℝ} (hδ : 0 < δ) :
    ∃ c : Γ →₀ ℂ,
      ‖x - ∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)‖ < δ := by
  have hx := denseRange_inclusion_adjoin_generatedCStarAlgebra lam x
  obtain ⟨⟨a, ha⟩, hdist⟩ := Metric.mem_closure_range_iff.1 hx δ hδ
  obtain ⟨c, hc⟩ := exists_finsupp_sum_of_mem_adjoin hlam ha
  have hsub : Set.inclusion (starAlgebra_adjoin_le_generatedCStarAlgebra lam) ⟨a, ha⟩ =
      ∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam) := hc
  refine ⟨c, ?_⟩
  rwa [dist_eq_norm, hsub] at hdist

private theorem norm_average_finsupp_sub_canonicalTrace_le [DecidableEq Γ]
    {F : Finset Γ} (hF : ∀ f ∈ F, f ≠ 1) {C D : Set Γ} {N : ℕ} {γ : Fin N → Γ}
    (hCDU : C ∪ D = Set.univ) (hfC : ∀ f ∈ F, Disjoint ((fun x : Γ ↦ f * x) '' C) C)
    (hγD : Pairwise fun i j : Fin N ↦
      Disjoint ((fun x : Γ ↦ γ i * x) '' D) ((fun x : Γ ↦ γ j * x) '' D))
    (c : Γ →₀ ℂ) (hcF : c.support.erase 1 ⊆ F) :
    let y : generatedCStarAlgebra lam :=
      ∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)
    ‖(N : ℂ)⁻¹ • ∑ j : Fin N,
        (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) *
          (y - canonicalTrace lam y • 1) *
          star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)‖ ≤
      2 * ‖y - canonicalTrace lam y • 1‖ / Real.sqrt N := by
  intro y
  have hMy_diff : y - canonicalTrace lam y • 1 =
      ∑ f ∈ F, c f • (leftRegularUnitary hlam f : generatedCStarAlgebra lam) :=
    finsupp_sum_sub_canonicalTrace_eq hlam hF c hcF
  have hcoe_sum (t : Finset Γ) (u : Γ → generatedCStarAlgebra lam) :
      ((∑ k ∈ t, u k : generatedCStarAlgebra lam) :
          lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) =
        ∑ k ∈ t, (u k : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2) :=
    map_sum (generatedCStarAlgebra lam).subtype u t
  have hnorm_coe :
      ‖(N : ℂ)⁻¹ • ∑ j : Fin N,
          (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) *
            (y - canonicalTrace lam y • 1) *
            star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)‖ =
        ‖(N : ℂ)⁻¹ • ∑ j : Fin N,
          lam (γ j) * (∑ f ∈ F, c f • lam f) * star (lam (γ j))‖ := by
    rw [hMy_diff, AddSubgroupClass.coe_norm]
    simp [hcoe_sum, MulMemClass.coe_mul, StarMemClass.coe_star]
  have hnorm_y : ‖∑ f ∈ F, c f • lam f‖ = ‖y - canonicalTrace lam y • 1‖ := by
    rw [hMy_diff, AddSubgroupClass.coe_norm]
    simp [hcoe_sum]
  rw [hnorm_coe, ← hnorm_y]
  exact norm_average_unitary_conj_le_of_powersPartition hlam hCDU hfC hγD c

/-- **Simultaneous Powers averaging in `generatedCStarAlgebra lam`.** Given a finite family `x` in
`generatedCStarAlgebra lam` and `ε > 0`, when `Γ` has the Powers property there exist `N > 0` and
`γ : Fin N → Γ` whose conjugate average brings every `x i` (`i ∈ s`) within `ε` of
`canonicalTrace lam (x i) • 1`. -/
theorem exists_forall_norm_average_unitary_conj_sub_canonicalTrace_lt
    (hΓ : HasPowersProperty Γ)
    {ι : Type*} (s : Finset ι) (x : ι → generatedCStarAlgebra lam)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ (N : ℕ) (γ : Fin N → Γ), 0 < N ∧ ∀ i ∈ s,
      ‖(N : ℂ)⁻¹ • ∑ j : Fin N,
          (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * x i *
            star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) -
          canonicalTrace lam (x i) • 1‖ < ε := by
  classical
  rcases s.eq_empty_or_nonempty with rfl | hs
  · exact ⟨1, fun _ ↦ 1, zero_lt_one, fun _ hi ↦ absurd hi (Finset.notMem_empty _)⟩
  have happrox (i : ι) : ∃ c : Γ →₀ ℂ,
      ‖x i - ∑ g ∈ c.support, c g • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)‖ <
        ε / 3 :=
    exists_finsupp_norm_sub_lt hlam (x i) (by positivity)
  choose c hc using happrox
  let y : ι → generatedCStarAlgebra lam :=
    fun i ↦ ∑ g ∈ (c i).support, (c i g) • (leftRegularUnitary hlam g : generatedCStarAlgebra lam)
  let F : Finset Γ := s.biUnion fun i ↦ (c i).support.erase 1
  have hF : ∀ f ∈ F, f ≠ 1 := fun f hf ↦
    let ⟨_, _, hfi⟩ := Finset.mem_biUnion.1 hf
    Finset.ne_of_mem_erase hfi
  let R : ℝ := s.sup' hs fun i ↦ ‖y i - canonicalTrace lam (y i) • 1‖
  obtain ⟨N₀, hN₀⟩ := exists_nat_gt ((6 * R / ε) ^ 2)
  let N : ℕ := max 1 N₀
  have hN_pos : 0 < N := lt_of_lt_of_le zero_lt_one (le_max_left 1 N₀)
  have hN_sqrt : 6 * R / ε < Real.sqrt N :=
    Real.lt_sqrt_of_sq_lt (hN₀.trans_le (Nat.cast_le.2 (le_max_right 1 N₀)))
  obtain ⟨C, D, γ, -, hCDU, hfC, hγD⟩ := hΓ F hF N
  refine ⟨N, γ, hN_pos, fun i hi ↦ ?_⟩
  have hR : ‖y i - canonicalTrace lam (y i) • 1‖ ≤ R :=
    Finset.le_sup' (fun k ↦ ‖y k - canonicalTrace lam (y k) • 1‖) hi
  have hM_bound :
      ‖(N : ℂ)⁻¹ • ∑ j : Fin N,
          (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) *
            (y i - canonicalTrace lam (y i) • 1) *
            star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)‖ < ε / 3 := by
    calc _ ≤ 2 * ‖y i - canonicalTrace lam (y i) • 1‖ / Real.sqrt N :=
          norm_average_finsupp_sub_canonicalTrace_le hlam hF hCDU (fun f hf ↦ hfC f hf) hγD
            (c i) (Finset.subset_biUnion_of_mem (u := fun i ↦ (c i).support.erase 1) hi)
      _ ≤ 2 * R / Real.sqrt N := by gcongr
      _ < ε / 3 := by
        rw [div_lt_iff₀ (Real.sqrt_pos.2 (Nat.cast_pos.2 hN_pos))]
        have hmul : 6 * R < ε * Real.sqrt N := (div_lt_iff₀' hε).1 hN_sqrt
        linarith
  exact norm_average_sub_canonicalTrace_lt_of_approx hlam hN_pos γ (hc i) hM_bound

/-- **Powers averaging in `generatedCStarAlgebra lam`.** Every element `x` can be averaged by
finitely many left-regular unitary conjugates arbitrarily close to `canonicalTrace lam x • 1`. -/
theorem exists_norm_average_unitary_conj_sub_canonicalTrace_lt
    (hΓ : HasPowersProperty Γ) (x : generatedCStarAlgebra lam) {ε : ℝ} (hε : 0 < ε) :
    ∃ (N : ℕ) (γ : Fin N → Γ), 0 < N ∧
      ‖(N : ℂ)⁻¹ • ∑ j : Fin N,
          (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * x *
            star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) -
          canonicalTrace lam x • 1‖ < ε := by
  obtain ⟨N, γ, hN, h⟩ :=
    exists_forall_norm_average_unitary_conj_sub_canonicalTrace_lt hlam hΓ ({()} : Finset Unit)
      (fun _ ↦ x) hε
  exact ⟨N, γ, hN, h () (Finset.mem_singleton_self ())⟩

/-- **Dixmier property.** When `Γ` has the Powers property, `canonicalTrace lam x • 1` lies in
the norm closure of the real convex hull of unitary conjugates of `x`. -/
theorem canonicalTrace_smul_one_mem_closure_convexHull
    (hΓ : HasPowersProperty Γ) (x : generatedCStarAlgebra lam) :
    canonicalTrace lam x • (1 : generatedCStarAlgebra lam) ∈
      closure (convexHull ℝ (Set.range fun g : Γ ↦
        (leftRegularUnitary hlam g : generatedCStarAlgebra lam) * x *
          star (leftRegularUnitary hlam g : generatedCStarAlgebra lam))) := by
  rw [Metric.mem_closure_iff]
  intro ε hε
  obtain ⟨N, γ, hN, hnorm⟩ :=
    exists_norm_average_unitary_conj_sub_canonicalTrace_lt hlam hΓ x hε
  have : Nonempty (Fin N) := Fin.pos_iff_nonempty.1 hN
  let z : generatedCStarAlgebra lam :=
    Finset.univ.centerMass (fun _ : Fin N ↦ (1 : ℝ)) fun j ↦
      (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * x *
        star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)
  have hz_eq : z = (N : ℂ)⁻¹ • ∑ j : Fin N,
      (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * x *
        star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) := by
    simp only [z, Finset.centerMass, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul, mul_one, one_smul]
    rw [← algebraMap_smul ℂ (N : ℝ)⁻¹]
    simp
  have hz_mem : z ∈ convexHull ℝ (Set.range fun g : Γ ↦
      (leftRegularUnitary hlam g : generatedCStarAlgebra lam) * x *
        star (leftRegularUnitary hlam g : generatedCStarAlgebra lam)) :=
    Finset.univ.centerMass_mem_convexHull (fun _ _ ↦ zero_le_one) (by
      simpa [Finset.card_univ] using (Nat.cast_pos (α := ℝ)).2 hN)
      fun j _ ↦ ⟨γ j, rfl⟩
  refine ⟨z, hz_mem, ?_⟩
  rw [dist_comm, dist_eq_norm, hz_eq]
  exact hnorm

end Averaging

section SimplicityAndUniqueTrace

/-- **Simplicity of reduced group C⋆-algebras with the Powers property.** Every two-sided ideal,
closed or not, of `generatedCStarAlgebra lam` is `⊥` or `⊤`. -/
theorem isSimpleRing_of_hasPowersProperty {Γ : Type*} [Group Γ] (hΓ : HasPowersProperty Γ)
    (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2))
    (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h)) :
    IsSimpleRing (generatedCStarAlgebra lam) := by
  classical
  have : Nontrivial (lp (fun _ : Γ ↦ ℂ) 2) :=
    ⟨⟨lp.single 2 (1 : Γ) (1 : ℂ), 0, fun h ↦ by
      simpa using congrArg (· (1 : Γ)) h⟩⟩
  have : Nontrivial (generatedCStarAlgebra lam) :=
    nontrivial_generatedCStarAlgebra lam
  have : Nontrivial (TwoSidedIdeal (generatedCStarAlgebra lam)) :=
    ⟨⟨⊥, ⊤, bot_ne_top⟩⟩
  refine ⟨⟨TwoSidedIdeal.eq_bot_or_eq_top_of_forall_isClosed Units.isOpen fun I hI ↦ ?_⟩⟩
  rw [or_iff_not_imp_left]
  intro hI0
  obtain ⟨a, haI, ha0⟩ : ∃ a ∈ I, a ≠ 0 := by
    by_contra! hall
    apply hI0
    ext x
    exact ⟨fun hx ↦ (TwoSidedIdeal.mem_bot _).2 (hall x hx), fun hx ↦ by
      rw [(TwoSidedIdeal.mem_bot _).1 hx]
      exact I.zero_mem⟩
  let b : generatedCStarAlgebra lam := star a * a
  have hbI : b ∈ I := I.mul_mem_left (star a) a haI
  have hb_tr : canonicalTrace lam b ≠ 0 := by
    simpa [b] using mt (canonicalTrace_star_mul_self_eq_zero_iff hlam a).1 ha0
  let c : generatedCStarAlgebra lam := (canonicalTrace lam b)⁻¹ • b
  have hcI : c ∈ I := I.smul_mem_of_isClosed (canonicalTrace lam b)⁻¹ hbI
  have hc_tr : canonicalTrace lam c = 1 := by
    dsimp only [c]
    rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hb_tr]
  obtain ⟨N, γ, _, havg⟩ :=
    exists_norm_average_unitary_conj_sub_canonicalTrace_lt hlam hΓ c zero_lt_one
  let avg : generatedCStarAlgebra lam :=
    (N : ℂ)⁻¹ • ∑ j : Fin N,
      (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * c *
        star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)
  have havgI : avg ∈ I := by
    refine I.smul_mem_of_isClosed (N : ℂ)⁻¹ (sum_mem fun j _ ↦ ?_)
    exact I.mul_mem_right _ _ (I.mul_mem_left _ c hcI)
  have hunit : IsUnit avg := by
    have hlt : ‖(1 : generatedCStarAlgebra lam) - avg‖ < 1 := by
      rw [norm_sub_rev]
      simpa [avg, hc_tr] using havg
    simpa [sub_sub_cancel] using isUnit_one_sub_of_norm_lt_one hlt
  obtain ⟨u, hu⟩ := hunit
  have h1I : (1 : generatedCStarAlgebra lam) ∈ I := by
    rw [← u.mul_inv, hu]
    exact I.mul_mem_right avg (↑u⁻¹) havgI
  exact I.eq_top h1I

/-- **Uniqueness of the trace under the Powers property.** Every continuous unital tracial linear
functional on `generatedCStarAlgebra lam` agrees with `canonicalTrace lam`. -/
theorem eq_canonicalTrace_of_hasPowersProperty {Γ : Type*} [Group Γ]
    (hΓ : HasPowersProperty Γ)
    (lam : Γ → (lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2))
    (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h))
    (φ : generatedCStarAlgebra lam →L[ℂ] ℂ)
    (hone : φ 1 = 1) (htrace : ∀ x y, φ (x * y) = φ (y * x))
    (x : generatedCStarAlgebra lam) :
    φ x = canonicalTrace lam x := by
  rw [← sub_eq_zero, ← norm_eq_zero]
  refine le_antisymm ?_ (norm_nonneg _)
  refine le_of_forall_pos_le_add fun δ hδ ↦ ?_
  rw [zero_add]
  have hε : 0 < δ / (‖φ‖ + 1) := div_pos hδ (add_pos_of_nonneg_of_pos (norm_nonneg _) zero_lt_one)
  obtain ⟨N, γ, hN, havg⟩ :=
    exists_norm_average_unitary_conj_sub_canonicalTrace_lt hlam hΓ x hε
  let avg : generatedCStarAlgebra lam :=
    (N : ℂ)⁻¹ • ∑ j : Fin N,
      (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * x *
        star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)
  have hφ_avg : φ avg = φ x := by
    have hconj (j : Fin N) :
        φ ((leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam) * x *
            star (leftRegularUnitary hlam (γ j) : generatedCStarAlgebra lam)) = φ x := by
      rw [htrace, ← mul_assoc,
        Unitary.star_mul_self_of_mem (leftRegularUnitary hlam (γ j)).property, one_mul]
    have hN0 : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.2 hN.ne'
    simp only [avg, map_smul, map_sum, hconj, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul, smul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hN0, one_mul]
  have hφ_tr : φ (canonicalTrace lam x • 1) = canonicalTrace lam x := by
    rw [map_smul, hone, smul_eq_mul, mul_one]
  calc ‖φ x - canonicalTrace lam x‖
      = ‖φ (avg - canonicalTrace lam x • 1)‖ := by rw [map_sub, hφ_avg, hφ_tr]
    _ ≤ ‖φ‖ * ‖avg - canonicalTrace lam x • 1‖ := φ.le_opNorm _
    _ ≤ ‖φ‖ * (δ / (‖φ‖ + 1)) := mul_le_mul_of_nonneg_left havg.le (norm_nonneg _)
    _ ≤ δ := by
        rw [mul_div_assoc', div_le_iff₀ (by positivity)]
        nlinarith [norm_nonneg φ]

/-- Powers's theorem: the reduced C⋆-algebra of a free group on a basis with two distinct elements
is simple as a ring (every two-sided ideal, closed or not, is `⊥` or `⊤`). -/
theorem reducedFreeGroup_isSimpleRing {ι : Type*} (a b : ι) (hab : a ≠ b)
    (lam : FreeGroup ι →
      (lp (fun _ : FreeGroup ι ↦ ℂ) 2 →L[ℂ] lp (fun _ : FreeGroup ι ↦ ℂ) 2))
    (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h)) :
    IsSimpleRing (generatedCStarAlgebra lam) :=
  isSimpleRing_of_hasPowersProperty (FreeGroup.hasPowersProperty_of_ne hab) lam hlam

/-- Uniqueness of the trace: every continuous unital tracial linear functional (in particular every
tracial state) on the reduced C⋆-algebra of a free group on a basis with two distinct elements
equals the canonical trace `τ(x) = ⟪δ₁, x δ₁⟫_ℂ`. -/
theorem reducedFreeGroup_trace_unique {ι : Type*} [DecidableEq ι] (a b : ι) (hab : a ≠ b)
    (lam : FreeGroup ι →
      (lp (fun _ : FreeGroup ι ↦ ℂ) 2 →L[ℂ] lp (fun _ : FreeGroup ι ↦ ℂ) 2))
    (hlam : ∀ g ξ h, (lam g ξ) h = ξ (g⁻¹ * h))
    (φ : generatedCStarAlgebra lam →L[ℂ] ℂ) (hone : φ 1 = 1)
    (htrace : ∀ x y, φ (x * y) = φ (y * x)) (x : generatedCStarAlgebra lam) :
    φ x = inner ℂ (lp.single 2 (1 : FreeGroup ι) (1 : ℂ))
      ((x : lp (fun _ : FreeGroup ι ↦ ℂ) 2 →L[ℂ] lp (fun _ : FreeGroup ι ↦ ℂ) 2)
        (lp.single 2 (1 : FreeGroup ι) (1 : ℂ))) :=
  (eq_canonicalTrace_of_hasPowersProperty (FreeGroup.hasPowersProperty_of_ne hab) lam hlam φ
    hone htrace x).trans (canonicalTrace_apply lam x)

end SimplicityAndUniqueTrace

