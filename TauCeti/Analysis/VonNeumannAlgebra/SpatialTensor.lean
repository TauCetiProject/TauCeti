module

public import TauCeti.Analysis.InnerProductSpace.TensorProduct.Completion
public import TauCeti.Analysis.VonNeumannAlgebra.Lattice

/-!
# Spatial tensor products of von Neumann algebras

Given sets of bounded operators `A ⊆ B(E)` and `B ⊆ B(F)` on complex inner product spaces `E` and
`F`, their **spatial tensor product** `VonNeumannAlgebra.spatialTensor A B` is the concrete von
Neumann algebra on the completed Hilbert tensor product `UniformSpace.Completion (E ⊗[ℂ] F)`
generated by the left amplifications `x ⊗ 1` (`x ∈ A`) and right amplifications `1 ⊗ y` (`y ∈ B`).

Because `VonNeumannAlgebra.adjoin` is defined by the double commutant and `Completion (E ⊗[ℂ] F)`
is complete for arbitrary inner product spaces `E` and `F`, `spatialTensor A B` requires no
completeness hypotheses on `E` or `F` in its definition, basic lattice laws, flip symmetry, or
associativity. When `E` and `F` are Hilbert spaces and `M : VonNeumannAlgebra E`,
`N : VonNeumannAlgebra F`, the vector-functional slice maps (`TensorProduct.sliceRight`,
`TensorProduct.sliceLeft`) combine with the double-commutant identity `M.commutant.commutant = M`
and rank-one operators to establish the structural theorems of concrete W⋆-tensor theory without
separability assumptions:

* **Unitary transport** (`VonNeumannAlgebra.mapLinearIsometryEquiv`): conjugation by a Hilbert-space
  unitary `U : H₁ ≃ₗᵢ[ℂ] H₂` induces an order isomorphism `VonNeumannAlgebra H₁ ≃o
  VonNeumannAlgebra H₂` commuting with `adjoin` and `commutant`, together with a concrete
  `⋆`-algebra equivalence `VonNeumannAlgebra.equivMapLinearIsometryEquiv` on carriers.
* **Canonical factor embeddings** (`VonNeumannAlgebra.inlSpatialTensor`,
  `VonNeumannAlgebra.inrSpatialTensor`): unital `⋆`-algebra homomorphisms
  `M →⋆ₐ[ℂ] spatialTensor M N` and `N →⋆ₐ[ℂ] spatialTensor M N` with commuting ranges, isometric
  when the opposite Hilbert space is nontrivial, and sharp injectivity characterizations
  (`Nontrivial F ∨ Subsingleton E`).
* **Symmetry, scalar units, and associativity**: flip symmetry along
  `(TensorProduct.commIsometry ℂ E F).completion`, left/right `ℂ`-unit laws along
  `TensorProduct.lidCompletionEquiv` and `TensorProduct.ridCompletionEquiv`, and associativity along
  `TensorProduct.assocCompletion`.
* **Slice-map invariance** (`VonNeumannAlgebra.sliceRight_mem_of_mem_spatialTensor`,
  `VonNeumannAlgebra.sliceLeft_mem_of_mem_spatialTensor`): right slices of elements of
  `spatialTensor M B` belong to `M`, and left slices of elements of `spatialTensor A N` belong to
  `N`.
* **`B(K)` commutation and tensor splitting**
  (`VonNeumannAlgebra.commutant_spatialTensor_top_right`,
  `VonNeumannAlgebra.commutant_spatialTensor_bot_right`,
  `VonNeumannAlgebra.coe_spatialTensor_bot_right`, `VonNeumannAlgebra.spatialTensor_top_top`,
  `VonNeumannAlgebra.existsUnique_eq_spatialTensor_top_right`):
  `(spatialTensor M ⊤)' = spatialTensor M' ⊥`, `(spatialTensor M ⊥)' = spatialTensor M' ⊤`,
  `spatialTensor M ⊥` has carrier `{x ⊗ 1 | x ∈ M}` on the nose, `spatialTensor ⊤ ⊤ = ⊤`, and any
  von Neumann algebra on `Completion (E ⊗[ℂ] F)` containing `spatialTensor ⊥ ⊤` splits uniquely as
  `spatialTensor M ⊤` when `F` is nontrivial.
* **Center and factoriality**
  (`VonNeumannAlgebra.spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_left`,
  `VonNeumannAlgebra.spatialTensor_inf_commutant_eq_bot`,
  `VonNeumannAlgebra.spatialTensor_inf_commutant_eq_bot_iff`): if `M` has trivial center
  (`M ⊓ M' = ⊥`), then `Z(spatialTensor M N) = spatialTensor ⊥ Z(N)`; consequently, on nontrivial
  Hilbert spaces, `spatialTensor M N` has trivial center if and only if both `M` and `N` have
  trivial center.

## References

* F. J. Murray and J. von Neumann, *On rings of operators. IV*, Ann. of Math. (2) **44** (1943),
  716–808.
* J. Dixmier, *Von Neumann Algebras*, North-Holland, 1981, Part I, Chapter 2.
* M. Takesaki, *Theory of Operator Algebras I*, Springer, 2002, Chapter IV, §1 and §5.
* R. V. Kadison and J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras*, Vol. II,
  Academic Press, 1986, §11.2.
-/

public section

open scoped Pointwise TensorProduct InnerProductSpace
open UniformSpace TensorProduct

namespace VonNeumannAlgebra

/-! ### Degenerate Hilbert spaces -/

section Subsingleton

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

instance instSubsingleton [Subsingleton H] : Subsingleton (VonNeumannAlgebra H) where
  allEq M N := ext fun x ↦
    ⟨fun _ ↦ Subsingleton.elim (0 : H →L[ℂ] H) x ▸ zero_mem N,
     fun _ ↦ Subsingleton.elim (0 : H →L[ℂ] H) x ▸ zero_mem M⟩

/-- The carrier type of a von Neumann algebra `M` on `H` is a subsingleton if and only if `H` is a
subsingleton. -/
theorem subsingleton_coe_iff (M : VonNeumannAlgebra H) : Subsingleton M ↔ Subsingleton H := by
  refine ⟨fun h ↦ subsingleton_of_forall_eq 0 fun v ↦ ?_, fun _ ↦ inferInstance⟩
  have h10 : (1 : H →L[ℂ] H) = 0 := congrArg Subtype.val (Subsingleton.elim (1 : M) (0 : M))
  simpa using congr($h10 v)

end Subsingleton

/-! ### Unitary transport of von Neumann algebras -/

section UnitaryTransport

private theorem image_centralizer {A B F : Type*} [Mul A] [Mul B] [EquivLike F A B]
    [MulEquivClass F A B] (e : F) (s : Set A) :
    (e '' s).centralizer = e '' s.centralizer := by
  ext b
  constructor
  · intro hb
    obtain ⟨c, rfl⟩ := EquivLike.surjective e b
    refine ⟨c, fun a ha ↦ EquivLike.injective e ?_, rfl⟩
    rw [map_mul, map_mul]
    exact hb (e a) ⟨a, ha, rfl⟩
  · rintro ⟨a, ha, rfl⟩ _ ⟨x, hx, rfl⟩
    rw [← map_mul, ← map_mul, ha x hx]

variable {H₁ H₂ H₃ : Type*}
  [NormedAddCommGroup H₁] [InnerProductSpace ℂ H₁] [CompleteSpace H₁]
  [NormedAddCommGroup H₂] [InnerProductSpace ℂ H₂] [CompleteSpace H₂]
  [NormedAddCommGroup H₃] [InnerProductSpace ℂ H₃] [CompleteSpace H₃]

/-- Transport of von Neumann algebras along a linear isometric equivalence `U : H₁ ≃ₗᵢ[ℂ] H₂` via
spatial conjugation `T ↦ U ∘L T ∘L U.symm`, bundled as an order isomorphism of complete lattices. -/
noncomputable def mapLinearIsometryEquiv (U : H₁ ≃ₗᵢ[ℂ] H₂) :
    VonNeumannAlgebra H₁ ≃o VonNeumannAlgebra H₂ where
  toFun M :=
    { toStarSubalgebra := M.toStarSubalgebra.map U.conjStarAlgEquiv.toStarAlgHom
      centralizer_centralizer' := by
        have hcoe : (M.toStarSubalgebra.map U.conjStarAlgEquiv.toStarAlgHom).carrier =
            U.conjStarAlgEquiv '' (M : Set _) := StarSubalgebra.coe_map _ _
        rw [hcoe, image_centralizer U.conjStarAlgEquiv, image_centralizer U.conjStarAlgEquiv,
          M.centralizer_centralizer] }
  invFun N :=
    { toStarSubalgebra := N.toStarSubalgebra.map U.symm.conjStarAlgEquiv.toStarAlgHom
      centralizer_centralizer' := by
        have hcoe : (N.toStarSubalgebra.map U.symm.conjStarAlgEquiv.toStarAlgHom).carrier =
            U.symm.conjStarAlgEquiv '' (N : Set _) := StarSubalgebra.coe_map _ _
        rw [hcoe, image_centralizer U.symm.conjStarAlgEquiv,
          image_centralizer U.symm.conjStarAlgEquiv, N.centralizer_centralizer] }
  left_inv M := SetLike.coe_injective <| by
    simp [coe_mk, StarSubalgebra.coe_map, Set.image_image,
      ← LinearIsometryEquiv.symm_conjStarAlgEquiv]
  right_inv N := SetLike.coe_injective <| by
    simp [coe_mk, StarSubalgebra.coe_map, Set.image_image,
      ← LinearIsometryEquiv.symm_conjStarAlgEquiv]
  map_rel_iff' {M₁ M₂} := by
    refine ⟨fun h x hx ↦ ?_, fun h y hy ↦ ?_⟩
    · obtain ⟨x', hx', hxx'⟩ := h ⟨x, hx, rfl⟩
      exact U.conjStarAlgEquiv.injective hxx' ▸ hx'
    · obtain ⟨x, hx, rfl⟩ := hy
      exact ⟨x, h hx, rfl⟩

@[simp, norm_cast]
theorem coe_mapLinearIsometryEquiv (U : H₁ ≃ₗᵢ[ℂ] H₂) (M : VonNeumannAlgebra H₁) :
    (mapLinearIsometryEquiv U M : Set (H₂ →L[ℂ] H₂)) = U.conjStarAlgEquiv '' (M : Set _) :=
  (rfl)

@[simp]
theorem mem_mapLinearIsometryEquiv {U : H₁ ≃ₗᵢ[ℂ] H₂} {M : VonNeumannAlgebra H₁}
    {y : H₂ →L[ℂ] H₂} :
    y ∈ mapLinearIsometryEquiv U M ↔ U.symm.conjStarAlgEquiv y ∈ M := by
  rw [← SetLike.mem_coe, coe_mapLinearIsometryEquiv]
  exact ⟨fun ⟨x, hx, hxy⟩ ↦ hxy ▸ by simpa [← LinearIsometryEquiv.symm_conjStarAlgEquiv] using hx,
    fun hy ↦ ⟨U.symm.conjStarAlgEquiv y, hy, U.conjStarAlgEquiv.apply_symm_apply y⟩⟩

@[simp]
theorem mapLinearIsometryEquiv_symm (U : H₁ ≃ₗᵢ[ℂ] H₂) :
    (mapLinearIsometryEquiv U).symm = mapLinearIsometryEquiv U.symm :=
  (rfl)

@[simp]
theorem mapLinearIsometryEquiv_refl :
    mapLinearIsometryEquiv (.refl ℂ H₁) = OrderIso.refl (VonNeumannAlgebra H₁) := by
  ext M x
  rw [OrderIso.refl_apply, mem_mapLinearIsometryEquiv,
    ← LinearIsometryEquiv.symm_conjStarAlgEquiv, LinearIsometryEquiv.conjStarAlgEquiv_refl]
  rfl

theorem mapLinearIsometryEquiv_trans (U : H₁ ≃ₗᵢ[ℂ] H₂) (V : H₂ ≃ₗᵢ[ℂ] H₃) :
    mapLinearIsometryEquiv (U.trans V) =
      (mapLinearIsometryEquiv U).trans (mapLinearIsometryEquiv V) := by
  ext M z
  simp [LinearIsometryEquiv.conjStarAlgEquiv_trans]

/-- Unitary transport commutes with `VonNeumannAlgebra.adjoin`. -/
@[simp]
theorem mapLinearIsometryEquiv_adjoin (U : H₁ ≃ₗᵢ[ℂ] H₂) (s : Set (H₁ →L[ℂ] H₁)) :
    mapLinearIsometryEquiv U (adjoin s) = adjoin (U.conjStarAlgEquiv '' s) := by
  refine le_antisymm ?_ (adjoin_le_iff.2 ?_)
  · rw [← (mapLinearIsometryEquiv U).le_symm_apply, adjoin_le_iff]
    rintro x hx
    rw [SetLike.mem_coe, mapLinearIsometryEquiv_symm, mem_mapLinearIsometryEquiv,
      LinearIsometryEquiv.symm_symm]
    exact subset_adjoin _ ⟨x, hx, rfl⟩
  · rintro _ ⟨x, hx, rfl⟩
    rw [SetLike.mem_coe, mem_mapLinearIsometryEquiv, ← LinearIsometryEquiv.symm_conjStarAlgEquiv,
      StarAlgEquiv.symm_apply_apply]
    exact subset_adjoin s hx

/-- Unitary transport commutes with taking commutants. -/
@[simp]
theorem mapLinearIsometryEquiv_commutant (U : H₁ ≃ₗᵢ[ℂ] H₂) (M : VonNeumannAlgebra H₁) :
    mapLinearIsometryEquiv U M.commutant = (mapLinearIsometryEquiv U M).commutant :=
  SetLike.coe_injective <| by
    rw [coe_mapLinearIsometryEquiv, coe_commutant, coe_commutant, coe_mapLinearIsometryEquiv,
      image_centralizer U.conjStarAlgEquiv]

/-- Spatial conjugation restricts to a `⋆`-algebra equivalence between `M` and its transported
von Neumann algebra `mapLinearIsometryEquiv U M`. -/
noncomputable def equivMapLinearIsometryEquiv (U : H₁ ≃ₗᵢ[ℂ] H₂) (M : VonNeumannAlgebra H₁) :
    M ≃⋆ₐ[ℂ] mapLinearIsometryEquiv U M where
  toFun x := ⟨U.conjStarAlgEquiv x.1, ⟨x.1, x.2, rfl⟩⟩
  invFun y := ⟨U.symm.conjStarAlgEquiv y.1, mem_mapLinearIsometryEquiv.1 y.2⟩
  left_inv x := Subtype.ext <| by simp [← LinearIsometryEquiv.symm_conjStarAlgEquiv]
  right_inv y := Subtype.ext <| U.conjStarAlgEquiv.apply_symm_apply y.1
  map_mul' x y := Subtype.ext <| map_mul U.conjStarAlgEquiv x.1 y.1
  map_add' x y := Subtype.ext <| map_add U.conjStarAlgEquiv x.1 y.1
  map_smul' c x := Subtype.ext <| map_smul U.conjStarAlgEquiv c x.1
  map_star' x := Subtype.ext <| map_star U.conjStarAlgEquiv x.1

@[simp, norm_cast]
theorem coe_equivMapLinearIsometryEquiv (U : H₁ ≃ₗᵢ[ℂ] H₂) (M : VonNeumannAlgebra H₁) (x : M) :
    (equivMapLinearIsometryEquiv U M x : H₂ →L[ℂ] H₂) = U.conjStarAlgEquiv x :=
  (rfl)

end UnitaryTransport

/-! ### Definition and basic lattice laws of the spatial tensor product -/

section SpatialTensorBasic

variable {E F G : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
  [NormedAddCommGroup G] [InnerProductSpace ℂ G]

/-- The **spatial tensor product** `spatialTensor A B` of two sets of bounded operators `A ⊆ B(E)`
and `B ⊆ B(F)`: the von Neumann algebra on `Completion (E ⊗[ℂ] F)` generated by the left
amplifications `x.rTensorCompletion F` (`x ∈ A`) and right amplifications `y.lTensorCompletion E`
(`y ∈ B`). -/
noncomputable def spatialTensor (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    VonNeumannAlgebra (Completion (E ⊗[ℂ] F)) :=
  adjoin (ContinuousLinearMap.rTensorCompletion F '' A ∪
    ContinuousLinearMap.lTensorCompletion E '' B)

theorem rTensorCompletion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {x : E →L[ℂ] E} (hx : x ∈ A) :
    x.rTensorCompletion F ∈ spatialTensor A B :=
  subset_adjoin _ (Or.inl ⟨x, hx, rfl⟩)

theorem lTensorCompletion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {y : F →L[ℂ] F} (hy : y ∈ B) :
    y.lTensorCompletion E ∈ spatialTensor A B :=
  subset_adjoin _ (Or.inr ⟨y, hy, rfl⟩)

theorem mapL_completion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {x : E →L[ℂ] E} {y : F →L[ℂ] F} (hx : x ∈ A) (hy : y ∈ B) :
    (TensorProduct.mapL x y).completion ∈ spatialTensor A B := by
  rw [← ContinuousLinearMap.rTensorCompletion_comp_lTensorCompletion, ← ContinuousLinearMap.mul_def]
  exact mul_mem (rTensorCompletion_mem_spatialTensor hx) (lTensorCompletion_mem_spatialTensor hy)

@[simp]
theorem spatialTensor_le_iff {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {P : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))} :
    spatialTensor A B ≤ P ↔
      (∀ x ∈ A, x.rTensorCompletion F ∈ P) ∧ ∀ y ∈ B, y.lTensorCompletion E ∈ P := by
  rw [spatialTensor, adjoin_le_iff, Set.union_subset_iff, Set.image_subset_iff,
    Set.image_subset_iff]
  rfl

theorem spatialTensor_mono {A₁ A₂ : Set (E →L[ℂ] E)} {B₁ B₂ : Set (F →L[ℂ] F)}
    (hA : A₁ ⊆ A₂) (hB : B₁ ⊆ B₂) :
    spatialTensor A₁ B₁ ≤ spatialTensor A₂ B₂ :=
  spatialTensor_le_iff.2 ⟨fun _ hx ↦ rTensorCompletion_mem_spatialTensor (hA hx),
    fun _ hy ↦ lTensorCompletion_mem_spatialTensor (hB hy)⟩

@[simp]
theorem spatialTensor_empty_empty :
    spatialTensor (∅ : Set (E →L[ℂ] E)) (∅ : Set (F →L[ℂ] F)) = ⊥ := by
  simp [spatialTensor]

theorem spatialTensor_eq_sup (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor A B = spatialTensor A ∅ ⊔ spatialTensor ∅ B := by
  simp [spatialTensor, adjoin_union]

theorem spatialTensor_union_left (A₁ A₂ : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor (A₁ ∪ A₂) B = spatialTensor A₁ B ⊔ spatialTensor A₂ B := by
  rw [spatialTensor, spatialTensor, spatialTensor, Set.image_union, adjoin_union, adjoin_union,
    adjoin_union, adjoin_union, sup_sup_distrib_right]

theorem spatialTensor_union_right (A : Set (E →L[ℂ] E)) (B₁ B₂ : Set (F →L[ℂ] F)) :
    spatialTensor A (B₁ ∪ B₂) = spatialTensor A B₁ ⊔ spatialTensor A B₂ := by
  rw [spatialTensor, spatialTensor, spatialTensor, Set.image_union, adjoin_union, adjoin_union,
    adjoin_union, adjoin_union, sup_sup_distrib_left]

@[simp]
theorem spatialTensor_bot_left [CompleteSpace E] (B : Set (F →L[ℂ] F)) :
    spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) B = spatialTensor ∅ B := by
  refine le_antisymm ?_ (spatialTensor_mono (Set.empty_subset _) Set.Subset.rfl)
  rw [spatialTensor_le_iff]
  refine ⟨?_, fun _ hy ↦ lTensorCompletion_mem_spatialTensor hy⟩
  rintro x hx
  obtain ⟨c, rfl⟩ := mem_bot.1 hx
  rw [Algebra.algebraMap_eq_smul_one, ContinuousLinearMap.rTensorCompletion_smul,
    ContinuousLinearMap.rTensorCompletion_one, ← Algebra.algebraMap_eq_smul_one]
  exact algebraMap_mem _ c

@[simp]
theorem spatialTensor_bot_right [CompleteSpace F] (A : Set (E →L[ℂ] E)) :
    spatialTensor A ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) = spatialTensor A ∅ := by
  refine le_antisymm ?_ (spatialTensor_mono Set.Subset.rfl (Set.empty_subset _))
  rw [spatialTensor_le_iff]
  refine ⟨fun _ hx ↦ rTensorCompletion_mem_spatialTensor hx, ?_⟩
  rintro y hy
  obtain ⟨c, rfl⟩ := mem_bot.1 hy
  rw [Algebra.algebraMap_eq_smul_one, ContinuousLinearMap.lTensorCompletion_smul,
    ContinuousLinearMap.lTensorCompletion_one, ← Algebra.algebraMap_eq_smul_one]
  exact algebraMap_mem _ c

theorem spatialTensor_bot_bot [CompleteSpace E] [CompleteSpace F] :
    spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
      ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) = ⊥ := by
  rw [spatialTensor_bot_left, spatialTensor_bot_right, spatialTensor_empty_empty]

end SpatialTensorBasic

/-! ### Canonical factor embeddings -/

section FactorEmbeddings

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]

/-- The canonical left factor unital `⋆`-algebra homomorphism `x ↦ x ⊗ 1` into
`spatialTensor M N`. -/
noncomputable def inlSpatialTensor (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    M →⋆ₐ[ℂ] spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) where
  toFun x := ⟨(x : E →L[ℂ] E).rTensorCompletion F, rTensorCompletion_mem_spatialTensor x.2⟩
  map_one' := Subtype.ext ContinuousLinearMap.rTensorCompletion_one
  map_mul' x y := Subtype.ext <| ContinuousLinearMap.rTensorCompletion_mul x.1 y.1
  map_zero' := Subtype.ext ContinuousLinearMap.rTensorCompletion_zero
  map_add' x y := Subtype.ext <| ContinuousLinearMap.rTensorCompletion_add x.1 y.1
  commutes' c := Subtype.ext <| by simp [Algebra.algebraMap_eq_smul_one]
  map_star' x := Subtype.ext <| (ContinuousLinearMap.star_rTensorCompletion x.1).symm

/-- The canonical right factor unital `⋆`-algebra homomorphism `y ↦ 1 ⊗ y` into
`spatialTensor M N`. -/
noncomputable def inrSpatialTensor (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    N →⋆ₐ[ℂ] spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) where
  toFun y := ⟨(y : F →L[ℂ] F).lTensorCompletion E, lTensorCompletion_mem_spatialTensor y.2⟩
  map_one' := Subtype.ext ContinuousLinearMap.lTensorCompletion_one
  map_mul' x y := Subtype.ext <| ContinuousLinearMap.lTensorCompletion_mul x.1 y.1
  map_zero' := Subtype.ext ContinuousLinearMap.lTensorCompletion_zero
  map_add' x y := Subtype.ext <| ContinuousLinearMap.lTensorCompletion_add x.1 y.1
  commutes' c := Subtype.ext <| by simp [Algebra.algebraMap_eq_smul_one]
  map_star' y := Subtype.ext <| (ContinuousLinearMap.star_lTensorCompletion y.1).symm

@[simp, norm_cast]
theorem coe_inlSpatialTensor (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) (x : M) :
    (inlSpatialTensor M N x : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)) =
      (x : E →L[ℂ] E).rTensorCompletion F :=
  (rfl)

@[simp, norm_cast]
theorem coe_inrSpatialTensor (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) (y : N) :
    (inrSpatialTensor M N y : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)) =
      (y : F →L[ℂ] F).lTensorCompletion E :=
  (rfl)

/-- Elements embedded from the two factors commute in `spatialTensor M N`. -/
theorem commute_inlSpatialTensor_inrSpatialTensor (M : VonNeumannAlgebra E)
    (N : VonNeumannAlgebra F) (x : M) (y : N) :
    Commute (inlSpatialTensor M N x) (inrSpatialTensor M N y) :=
  Subtype.ext <| ContinuousLinearMap.rTensorCompletion_mul_lTensorCompletion_comm x.1 y.1

theorem norm_inlSpatialTensor [Nontrivial F] (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F)
    (x : M) :
    ‖inlSpatialTensor M N x‖ = ‖x‖ :=
  ContinuousLinearMap.norm_rTensorCompletion (x : E →L[ℂ] E)

theorem norm_inrSpatialTensor [Nontrivial E] (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F)
    (y : N) :
    ‖inrSpatialTensor M N y‖ = ‖y‖ :=
  ContinuousLinearMap.norm_lTensorCompletion (y : F →L[ℂ] F)

theorem inlSpatialTensor_injective [Nontrivial F] (M : VonNeumannAlgebra E)
    (N : VonNeumannAlgebra F) :
    Function.Injective (inlSpatialTensor M N) := fun _ _ h ↦
  Subtype.ext <| ContinuousLinearMap.rTensorCompletion_injective F (congrArg Subtype.val h)

theorem inrSpatialTensor_injective [Nontrivial E] (M : VonNeumannAlgebra E)
    (N : VonNeumannAlgebra F) :
    Function.Injective (inrSpatialTensor M N) := fun _ _ h ↦
  Subtype.ext <| ContinuousLinearMap.lTensorCompletion_injective E (congrArg Subtype.val h)

/-- Sharp injectivity characterization for `inlSpatialTensor`: `M →⋆ₐ[ℂ] spatialTensor M N` is
injective if and only if the opposite Hilbert space `F` is nontrivial or `E` is zero. -/
theorem inlSpatialTensor_injective_iff (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    Function.Injective (inlSpatialTensor M N) ↔ Nontrivial F ∨ Subsingleton E := by
  refine ⟨fun hinj ↦ ?_, ?_⟩
  · by_cases hF : Nontrivial F
    · exact Or.inl hF
    · rw [not_nontrivial_iff_subsingleton] at hF
      exact Or.inr <| (subsingleton_coe_iff M).1 hinj.subsingleton
  · rintro (hF | hE)
    · exact inlSpatialTensor_injective M N
    · have : Subsingleton M := (subsingleton_coe_iff M).2 hE
      exact Function.injective_of_subsingleton _

/-- Sharp injectivity characterization for `inrSpatialTensor`: `N →⋆ₐ[ℂ] spatialTensor M N` is
injective if and only if the opposite Hilbert space `E` is nontrivial or `F` is zero. -/
theorem inrSpatialTensor_injective_iff (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    Function.Injective (inrSpatialTensor M N) ↔ Nontrivial E ∨ Subsingleton F := by
  refine ⟨fun hinj ↦ ?_, ?_⟩
  · by_cases hE : Nontrivial E
    · exact Or.inl hE
    · rw [not_nontrivial_iff_subsingleton] at hE
      exact Or.inr <| (subsingleton_coe_iff N).1 hinj.subsingleton
  · rintro (hE | hF)
    · exact inrSpatialTensor_injective M N
    · have : Subsingleton N := (subsingleton_coe_iff N).2 hF
      exact Function.injective_of_subsingleton _

end FactorEmbeddings

/-! ### Slice-map invariance and generator reduction -/

section SliceInvariance

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]

private theorem sliceRight_mul_rTensorCompletion [CompleteSpace E] (ξ η : F)
    (T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)) (f : E →L[ℂ] E) :
    sliceRight ξ η (T * f.rTensorCompletion F) = sliceRight ξ η T * f :=
  sliceRight_comp_rTensorCompletion ξ η T f

private theorem rTensorCompletion_mul_sliceRight [CompleteSpace E] (ξ η : F) (f : E →L[ℂ] E)
    (T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)) :
    sliceRight ξ η (f.rTensorCompletion F * T) = f * sliceRight ξ η T :=
  rTensorCompletion_comp_sliceRight ξ η f T

private theorem sliceLeft_mul_lTensorCompletion [CompleteSpace F] (e₁ e₂ : E)
    (T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)) (g : F →L[ℂ] F) :
    sliceLeft e₁ e₂ (T * g.lTensorCompletion E) = sliceLeft e₁ e₂ T * g :=
  sliceLeft_comp_lTensorCompletion e₁ e₂ T g

private theorem lTensorCompletion_mul_sliceLeft [CompleteSpace F] (e₁ e₂ : E) (g : F →L[ℂ] F)
    (T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)) :
    sliceLeft e₁ e₂ (g.lTensorCompletion E * T) = g * sliceLeft e₁ e₂ T :=
  lTensorCompletion_comp_sliceLeft e₁ e₂ g T

/-- Every right slice of an operator in `(spatialTensor A B)'` centralizes `A ∪ star A`. -/
theorem sliceRight_mem_centralizer_of_mem_commutant_spatialTensor [CompleteSpace E]
    {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)}
    (hT : T ∈ (spatialTensor A B).commutant) (ξ η : F) :
    sliceRight ξ η T ∈ (A ∪ star A).centralizer := by
  have hcomm (x : E →L[ℂ] E) (hx : x.rTensorCompletion F ∈ spatialTensor A B) :
      x * sliceRight ξ η T = sliceRight ξ η T * x := by
    have hTx := (mem_commutant_iff.1 hT) _ hx
    calc x * sliceRight ξ η T
        = sliceRight ξ η (x.rTensorCompletion F * T) :=
          (rTensorCompletion_mul_sliceRight ξ η x T).symm
      _ = sliceRight ξ η (T * x.rTensorCompletion F) := congrArg (sliceRight ξ η) hTx
      _ = sliceRight ξ η T * x := sliceRight_mul_rTensorCompletion ξ η T x
  rintro x (hx | hx)
  · exact hcomm x (rTensorCompletion_mem_spatialTensor hx)
  · rw [Set.mem_star] at hx
    refine hcomm x ?_
    have hstar : x.rTensorCompletion F = star ((star x).rTensorCompletion F) := by
      rw [ContinuousLinearMap.star_rTensorCompletion, star_star]
    rw [hstar]
    exact star_mem (rTensorCompletion_mem_spatialTensor hx)

/-- Every left slice of an operator in `(spatialTensor A B)'` centralizes `B ∪ star B`. -/
theorem sliceLeft_mem_centralizer_of_mem_commutant_spatialTensor [CompleteSpace F]
    {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)}
    (hT : T ∈ (spatialTensor A B).commutant) (e₁ e₂ : E) :
    sliceLeft e₁ e₂ T ∈ (B ∪ star B).centralizer := by
  have hcomm (y : F →L[ℂ] F) (hy : y.lTensorCompletion E ∈ spatialTensor A B) :
      y * sliceLeft e₁ e₂ T = sliceLeft e₁ e₂ T * y := by
    have hTy := (mem_commutant_iff.1 hT) _ hy
    calc y * sliceLeft e₁ e₂ T
        = sliceLeft e₁ e₂ (y.lTensorCompletion E * T) :=
          (lTensorCompletion_mul_sliceLeft e₁ e₂ y T).symm
      _ = sliceLeft e₁ e₂ (T * y.lTensorCompletion E) := congrArg (sliceLeft e₁ e₂) hTy
      _ = sliceLeft e₁ e₂ T * y := sliceLeft_mul_lTensorCompletion e₁ e₂ T y
  rintro y (hy | hy)
  · exact hcomm y (lTensorCompletion_mem_spatialTensor hy)
  · rw [Set.mem_star] at hy
    refine hcomm y ?_
    have hstar : y.lTensorCompletion E = star ((star y).lTensorCompletion E) := by
      rw [ContinuousLinearMap.star_lTensorCompletion, star_star]
    rw [hstar]
    exact star_mem (lTensorCompletion_mem_spatialTensor hy)

/-- Replacing the left generating set `s` by `adjoin s` does not change `spatialTensor`. -/
theorem spatialTensor_adjoin_left [CompleteSpace E] (s : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor (adjoin s : Set (E →L[ℂ] E)) B = spatialTensor s B := by
  refine le_antisymm ?_ (spatialTensor_mono (subset_adjoin s) Set.Subset.rfl)
  rw [spatialTensor_le_iff]
  refine ⟨fun x hx ↦ ?_, fun _ hy ↦ lTensorCompletion_mem_spatialTensor hy⟩
  rw [← commutant_commutant (spatialTensor s B), mem_commutant_iff]
  intro T hT
  refine ext_of_sliceRight fun ξ η ↦ ?_
  have hslice := sliceRight_mem_centralizer_of_mem_commutant_spatialTensor hT ξ η
  have hx' : x ∈ (s ∪ star s).centralizer.centralizer := by rwa [← coe_adjoin]
  calc sliceRight ξ η (T * x.rTensorCompletion F)
      = sliceRight ξ η T * x := sliceRight_mul_rTensorCompletion ξ η T x
    _ = x * sliceRight ξ η T := hx' _ hslice
    _ = sliceRight ξ η (x.rTensorCompletion F * T) :=
        (rTensorCompletion_mul_sliceRight ξ η x T).symm

/-- Replacing the right generating set `t` by `adjoin t` does not change `spatialTensor`. -/
theorem spatialTensor_adjoin_right [CompleteSpace F] (A : Set (E →L[ℂ] E)) (t : Set (F →L[ℂ] F)) :
    spatialTensor A (adjoin t : Set (F →L[ℂ] F)) = spatialTensor A t := by
  refine le_antisymm ?_ (spatialTensor_mono Set.Subset.rfl (subset_adjoin t))
  rw [spatialTensor_le_iff]
  refine ⟨fun _ hx ↦ rTensorCompletion_mem_spatialTensor hx, fun y hy ↦ ?_⟩
  rw [← commutant_commutant (spatialTensor A t), mem_commutant_iff]
  intro T hT
  refine ext_of_sliceLeft fun e₁ e₂ ↦ ?_
  have hslice := sliceLeft_mem_centralizer_of_mem_commutant_spatialTensor hT e₁ e₂
  have hy' : y ∈ (t ∪ star t).centralizer.centralizer := by rwa [← coe_adjoin]
  calc sliceLeft e₁ e₂ (T * y.lTensorCompletion E)
      = sliceLeft e₁ e₂ T * y := sliceLeft_mul_lTensorCompletion e₁ e₂ T y
    _ = y * sliceLeft e₁ e₂ T := hy' _ hslice
    _ = sliceLeft e₁ e₂ (y.lTensorCompletion E * T) :=
        (lTensorCompletion_mul_sliceLeft e₁ e₂ y T).symm

/-- Right slices of elements of `(spatialTensor M B)'` lie in `M'`. -/
theorem sliceRight_mem_commutant_of_mem_commutant_spatialTensor [CompleteSpace E]
    {M : VonNeumannAlgebra E} {B : Set (F →L[ℂ] F)}
    {T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)}
    (hT : T ∈ (spatialTensor (M : Set (E →L[ℂ] E)) B).commutant) (ξ η : F) :
    sliceRight ξ η T ∈ M.commutant := by
  rw [← adjoin_eq M, ← SetLike.mem_coe, coe_commutant_adjoin]
  exact sliceRight_mem_centralizer_of_mem_commutant_spatialTensor hT ξ η

/-- Left slices of elements of `(spatialTensor A N)'` lie in `N'`. -/
theorem sliceLeft_mem_commutant_of_mem_commutant_spatialTensor [CompleteSpace F]
    {A : Set (E →L[ℂ] E)} {N : VonNeumannAlgebra F}
    {T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)}
    (hT : T ∈ (spatialTensor A (N : Set (F →L[ℂ] F))).commutant) (e₁ e₂ : E) :
    sliceLeft e₁ e₂ T ∈ N.commutant := by
  rw [← adjoin_eq N, ← SetLike.mem_coe, coe_commutant_adjoin]
  exact sliceLeft_mem_centralizer_of_mem_commutant_spatialTensor hT e₁ e₂

/-- **Right slice-map invariance.** For any von Neumann algebra `M` on `E` and any `B ⊆ B(F)`,
every right slice `sliceRight ξ η T` of an operator `T ∈ spatialTensor M B` belongs to `M`. -/
theorem sliceRight_mem_of_mem_spatialTensor [CompleteSpace E]
    {M : VonNeumannAlgebra E} {B : Set (F →L[ℂ] F)}
    {T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)}
    (hT : T ∈ spatialTensor (M : Set (E →L[ℂ] E)) B) (ξ η : F) :
    sliceRight ξ η T ∈ M := by
  let gen : Set (Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)) :=
    ContinuousLinearMap.rTensorCompletion F '' (M.commutant : Set (E →L[ℂ] E))
  have hstar : star gen ⊆ gen := by
    intro w hw
    obtain ⟨a, ha, hEq⟩ := Set.mem_star.1 hw
    refine ⟨star a, star_mem ha, ?_⟩
    rw [← ContinuousLinearMap.star_rTensorCompletion, hEq, star_star]
  have hcomm_eq : ((spatialTensor (M.commutant : Set (E →L[ℂ] E))
      (∅ : Set (F →L[ℂ] F))).commutant : Set _) = gen.centralizer := by
    rw [spatialTensor, Set.image_empty, Set.union_empty, coe_commutant_adjoin,
      Set.union_eq_left.2 hstar]
  have hle : spatialTensor (M : Set (E →L[ℂ] E)) B ≤
      (spatialTensor (M.commutant : Set (E →L[ℂ] E)) (∅ : Set (F →L[ℂ] F))).commutant := by
    rw [spatialTensor_le_iff]
    refine ⟨fun x hx ↦ ?_, fun y _ ↦ ?_⟩
    · rw [← SetLike.mem_coe, hcomm_eq]
      rintro _ ⟨a, ha, rfl⟩
      rw [← ContinuousLinearMap.rTensorCompletion_mul,
        ← ContinuousLinearMap.rTensorCompletion_mul, (mem_commutant_iff.1 ha) x hx]
    · rw [← SetLike.mem_coe, hcomm_eq]
      rintro _ ⟨a, -, rfl⟩
      exact ContinuousLinearMap.rTensorCompletion_mul_lTensorCompletion_comm a y
  rw [← commutant_commutant M]
  exact sliceRight_mem_commutant_of_mem_commutant_spatialTensor (hle hT) ξ η

/-- **Left slice-map invariance.** For any `A ⊆ B(E)` and any von Neumann algebra `N` on `F`,
every left slice `sliceLeft e₁ e₂ T` of an operator `T ∈ spatialTensor A N` belongs to `N`. -/
theorem sliceLeft_mem_of_mem_spatialTensor [CompleteSpace F]
    {A : Set (E →L[ℂ] E)} {N : VonNeumannAlgebra F}
    {T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)}
    (hT : T ∈ spatialTensor A (N : Set (F →L[ℂ] F))) (e₁ e₂ : E) :
    sliceLeft e₁ e₂ T ∈ N := by
  let gen : Set (Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)) :=
    ContinuousLinearMap.lTensorCompletion E '' (N.commutant : Set (F →L[ℂ] F))
  have hstar : star gen ⊆ gen := by
    intro w hw
    obtain ⟨b, hb, hEq⟩ := Set.mem_star.1 hw
    refine ⟨star b, star_mem hb, ?_⟩
    rw [← ContinuousLinearMap.star_lTensorCompletion, hEq, star_star]
  have hcomm_eq : ((spatialTensor (∅ : Set (E →L[ℂ] E))
      (N.commutant : Set (F →L[ℂ] F))).commutant : Set _) = gen.centralizer := by
    rw [spatialTensor, Set.image_empty, Set.empty_union, coe_commutant_adjoin,
      Set.union_eq_left.2 hstar]
  have hle : spatialTensor A (N : Set (F →L[ℂ] F)) ≤
      (spatialTensor (∅ : Set (E →L[ℂ] E)) (N.commutant : Set (F →L[ℂ] F))).commutant := by
    rw [spatialTensor_le_iff]
    refine ⟨fun x _ ↦ ?_, fun y hy ↦ ?_⟩
    · rw [← SetLike.mem_coe, hcomm_eq]
      rintro _ ⟨b, -, rfl⟩
      exact (ContinuousLinearMap.rTensorCompletion_mul_lTensorCompletion_comm x b).symm
    · rw [← SetLike.mem_coe, hcomm_eq]
      rintro _ ⟨b, hb, rfl⟩
      rw [← ContinuousLinearMap.lTensorCompletion_mul,
        ← ContinuousLinearMap.lTensorCompletion_mul, (mem_commutant_iff.1 hb) y hy]
  rw [← commutant_commutant N]
  exact sliceLeft_mem_commutant_of_mem_commutant_spatialTensor (hle hT) e₁ e₂

/-- The tensor product of commutants is contained in the commutant of the spatial tensor product:
`spatialTensor M' N' ≤ (spatialTensor M N)'`. -/
theorem spatialTensor_commutant_le_commutant_spatialTensor [CompleteSpace E] [CompleteSpace F]
    (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    spatialTensor (M.commutant : Set (E →L[ℂ] E)) (N.commutant : Set (F →L[ℂ] F)) ≤
      (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant := by
  rw [spatialTensor_le_iff]
  refine ⟨fun x hx ↦ mem_commutant_iff.2 fun T hT ↦ ?_,
    fun y hy ↦ mem_commutant_iff.2 fun T hT ↦ ?_⟩
  · refine ext_of_sliceRight fun ξ η ↦ ?_
    have hslice := sliceRight_mem_of_mem_spatialTensor hT ξ η
    rw [sliceRight_mul_rTensorCompletion, rTensorCompletion_mul_sliceRight,
      (mem_commutant_iff.1 hx) _ hslice]
  · refine ext_of_sliceLeft fun e₁ e₂ ↦ ?_
    have hslice := sliceLeft_mem_of_mem_spatialTensor hT e₁ e₂
    rw [sliceLeft_mul_lTensorCompletion, lTensorCompletion_mul_sliceLeft,
      (mem_commutant_iff.1 hy) _ hslice]

end SliceInvariance

/-! ### Symmetry, scalar units, and associativity -/

section MonoidalCoherence

variable {E F G : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
  [NormedAddCommGroup G] [InnerProductSpace ℂ G]

/-- **Flip symmetry** of the spatial tensor product along the completed tensor swap
`(TensorProduct.commIsometry ℂ E F).completion`. -/
@[simp]
theorem mapLinearIsometryEquiv_commIsometry_spatialTensor
    (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    mapLinearIsometryEquiv (commIsometry ℂ E F).completion (spatialTensor A B) =
      spatialTensor B A := by
  rw [spatialTensor, spatialTensor, mapLinearIsometryEquiv_adjoin, Set.image_union,
    Set.image_image, Set.image_image, Set.union_comm]
  simp [conjStarAlgEquiv_commIsometry_completion_rTensorCompletion,
    conjStarAlgEquiv_commIsometry_completion_lTensorCompletion]

/-- **Left scalar unit law**: `spatialTensor ⊥ M` on `ℂ ⊗[ℂ] F` is carried onto `M` by
`lidCompletionEquiv ℂ F`. -/
theorem mapLinearIsometryEquiv_lidCompletionEquiv_spatialTensor [CompleteSpace F]
    (M : VonNeumannAlgebra F) :
    mapLinearIsometryEquiv (lidCompletionEquiv ℂ F)
      (spatialTensor ((⊥ : VonNeumannAlgebra ℂ) : Set (ℂ →L[ℂ] ℂ)) (M : Set (F →L[ℂ] F))) = M := by
  rw [spatialTensor_bot_left, spatialTensor, Set.image_empty, Set.empty_union,
    mapLinearIsometryEquiv_adjoin, Set.image_image]
  simp [conjStarAlgEquiv_lidCompletionEquiv_lTensorCompletion]

/-- **Right scalar unit law**: `spatialTensor M ⊥` on `E ⊗[ℂ] ℂ` is carried onto `M` by
`ridCompletionEquiv ℂ E`. -/
theorem mapLinearIsometryEquiv_ridCompletionEquiv_spatialTensor [CompleteSpace E]
    (M : VonNeumannAlgebra E) :
    mapLinearIsometryEquiv (ridCompletionEquiv ℂ E)
      (spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra ℂ) : Set (ℂ →L[ℂ] ℂ))) = M := by
  rw [spatialTensor_bot_right, spatialTensor, Set.image_empty, Set.union_empty,
    mapLinearIsometryEquiv_adjoin, Set.image_image]
  simp [conjStarAlgEquiv_ridCompletionEquiv_rTensorCompletion]

/-- **Associativity** of the spatial tensor product along `TensorProduct.assocCompletion`:
`spatialTensor (spatialTensor A B) C` is carried onto `spatialTensor A (spatialTensor B C)`. -/
@[simp]
theorem mapLinearIsometryEquiv_assocCompletion_spatialTensor
    (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) (C : Set (G →L[ℂ] G)) :
    mapLinearIsometryEquiv (assocCompletion ℂ E F G)
      (spatialTensor (spatialTensor A B : Set _) C) =
      spatialTensor A (spatialTensor B C : Set _) := by
  have hL : spatialTensor (spatialTensor A B : Set _) C =
      spatialTensor (ContinuousLinearMap.rTensorCompletion F '' A ∪
        ContinuousLinearMap.lTensorCompletion E '' B) C :=
    spatialTensor_adjoin_left _ C
  have hR : spatialTensor A (spatialTensor B C : Set _) =
      spatialTensor A (ContinuousLinearMap.rTensorCompletion G '' B ∪
        ContinuousLinearMap.lTensorCompletion F '' C) :=
    spatialTensor_adjoin_right A _
  rw [hL, hR, spatialTensor, spatialTensor, mapLinearIsometryEquiv_adjoin]
  refine congrArg adjoin ?_
  simp only [Set.image_union, Set.image_image, Set.union_assoc]
  congr 1
  · ext T
    simp [conjStarAlgEquiv_assocCompletion_rTensorCompletion_rTensorCompletion]
  · congr 1
    · ext T
      simp [conjStarAlgEquiv_assocCompletion_lTensorCompletion_rTensorCompletion]
    · ext T
      simp [conjStarAlgEquiv_assocCompletion_lTensorCompletion]

end MonoidalCoherence

/-! ### `B(K)` commutation, carrier of `spatialTensor M ⊥`, and tensor splitting -/

section TopCommutantAndSplitting

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]

omit [CompleteSpace F] in
/-- An operator on `Completion (E ⊗[ℂ] F)` that commutes with all amplified rank-one operators
`1 ⊗ |y⟩⟨ξ₀|` for a unit vector `ξ₀ ∈ F` is the left amplification `(sliceRight ξ₀ ξ₀ T) ⊗ 1`. -/
theorem eq_rTensorCompletion_sliceRight_of_commute_rankOne
    {T : Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F)} {ξ₀ : F} (hξ₀ : ‖ξ₀‖ = 1)
    (hcomm : ∀ y : F,
      (InnerProductSpace.rankOne ℂ y ξ₀).lTensorCompletion E * T =
        T * (InnerProductSpace.rankOne ℂ y ξ₀).lTensorCompletion E) :
    T = (sliceRight ξ₀ ξ₀ T).rTensorCompletion F := by
  rw [ContinuousLinearMap.eq_rTensorCompletion_iff]
  intro x y
  have hy : ((x ⊗ₜ[ℂ] y : E ⊗[ℂ] F) : Completion (E ⊗[ℂ] F)) =
      (InnerProductSpace.rankOne ℂ y ξ₀).lTensorCompletion E (x ⊗ₜ[ℂ] ξ₀ : E ⊗[ℂ] F) := by
    simp [hξ₀]
  have hmul := congr($(hcomm y) (x ⊗ₜ[ℂ] ξ₀ : E ⊗[ℂ] F))
  calc T (x ⊗ₜ[ℂ] y : E ⊗[ℂ] F)
      = (T * (InnerProductSpace.rankOne ℂ y ξ₀).lTensorCompletion E)
          (x ⊗ₜ[ℂ] ξ₀ : E ⊗[ℂ] F) := by rw [hy, mul_apply_eq_comp]
    _ = ((InnerProductSpace.rankOne ℂ y ξ₀).lTensorCompletion E * T)
          (x ⊗ₜ[ℂ] ξ₀ : E ⊗[ℂ] F) := hmul.symm
    _ = ((tmulCLM ℂ E F).flip y ∘L ((tmulCLM ℂ E F).flip ξ₀).adjoint)
          (T (x ⊗ₜ[ℂ] ξ₀ : E ⊗[ℂ] F)) := by
        rw [mul_apply_eq_comp, ← ContinuousLinearMap.flip_tmulCLM_comp_adjoint]
    _ = (sliceRight ξ₀ ξ₀ T x ⊗ₜ[ℂ] y : E ⊗[ℂ] F) := by simp [sliceRight_def]

/-- **`B(F)` commutation theorem**: `(spatialTensor M ⊤)' = spatialTensor M' ⊥`. -/
theorem commutant_spatialTensor_top_right (M : VonNeumannAlgebra E) :
    (spatialTensor (M : Set (E →L[ℂ] E)) ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F))).commutant =
      spatialTensor (M.commutant : Set (E →L[ℂ] E))
        ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  by_cases hF : Nontrivial F
  · refine le_antisymm (fun T hT ↦ ?_) ?_
    · obtain ⟨ξ₀, hξ₀⟩ := exists_norm_eq F zero_le_one
      have hEq : T = (sliceRight ξ₀ ξ₀ T).rTensorCompletion F :=
        eq_rTensorCompletion_sliceRight_of_commute_rankOne hξ₀ fun y ↦
          (mem_commutant_iff.1 hT) _ (lTensorCompletion_mem_spatialTensor mem_top)
      rw [hEq]
      exact rTensorCompletion_mem_spatialTensor
        (sliceRight_mem_commutant_of_mem_commutant_spatialTensor hT ξ₀ ξ₀)
    · have hle := spatialTensor_commutant_le_commutant_spatialTensor M (⊤ : VonNeumannAlgebra F)
      rwa [commutant_top] at hle
  · rw [not_nontrivial_iff_subsingleton] at hF
    exact Subsingleton.elim _ _

/-- **`B(E)` commutation theorem**: `(spatialTensor ⊤ N)' = spatialTensor ⊥ N'`. -/
theorem commutant_spatialTensor_top_left (N : VonNeumannAlgebra F) :
    (spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant =
      spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        (N.commutant : Set (F →L[ℂ] F)) := by
  let U := (commIsometry ℂ F E).completion
  calc (spatialTensor ((⊤ : VonNeumannAlgebra E) : Set _) (N : Set (F →L[ℂ] F))).commutant
      = (mapLinearIsometryEquiv U
          (spatialTensor (N : Set (F →L[ℂ] F))
            ((⊤ : VonNeumannAlgebra E) : Set _))).commutant := by
        rw [mapLinearIsometryEquiv_commIsometry_spatialTensor]
    _ = mapLinearIsometryEquiv U
          (spatialTensor (N : Set (F →L[ℂ] F)) ((⊤ : VonNeumannAlgebra E) : Set _)).commutant :=
        (mapLinearIsometryEquiv_commutant U _).symm
    _ = mapLinearIsometryEquiv U
          (spatialTensor (N.commutant : Set (F →L[ℂ] F)) ((⊥ : VonNeumannAlgebra E) : Set _)) := by
        rw [commutant_spatialTensor_top_right]
    _ = spatialTensor ((⊥ : VonNeumannAlgebra E) : Set _) (N.commutant : Set (F →L[ℂ] F)) :=
        mapLinearIsometryEquiv_commIsometry_spatialTensor _ _

/-- **Commutant of `spatialTensor M ⊥`**: `(spatialTensor M ⊥)' = spatialTensor M' ⊤`. -/
theorem commutant_spatialTensor_bot_right (M : VonNeumannAlgebra E) :
    (spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F))).commutant =
      spatialTensor (M.commutant : Set (E →L[ℂ] E))
        ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  have h := congrArg commutant (commutant_spatialTensor_top_right (F := F) M.commutant)
  rw [commutant_commutant, commutant_commutant] at h
  exact h.symm

/-- **Commutant of `spatialTensor ⊥ N`**: `(spatialTensor ⊥ N)' = spatialTensor ⊤ N'`. -/
theorem commutant_spatialTensor_bot_left (N : VonNeumannAlgebra F) :
    (spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant =
      spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        (N.commutant : Set (F →L[ℂ] F)) := by
  have h := congrArg commutant (commutant_spatialTensor_top_left (E := E) N.commutant)
  rw [commutant_commutant, commutant_commutant] at h
  exact h.symm

/-- **Spatial tensor product of full operator algebras**: `spatialTensor ⊤ ⊤ = ⊤`. -/
theorem spatialTensor_top_top :
    spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
      ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) = ⊤ := by
  rw [← commutant_eq_bot_iff, commutant_spatialTensor_top_right, commutant_top,
    spatialTensor_bot_bot]

/-- The image `x ↦ x ⊗ 1` of a von Neumann algebra `M` is already equal to its double commutant:
the carrier of `spatialTensor M ⊥` is `{x.rTensorCompletion F | x ∈ M}` on the nose. -/
theorem coe_spatialTensor_bot_right (M : VonNeumannAlgebra E) :
    (spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) :
      Set (Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F))) =
      ContinuousLinearMap.rTensorCompletion F '' (M : Set (E →L[ℂ] E)) := by
  by_cases hF : Nontrivial F
  · refine Set.Subset.antisymm (fun T hT ↦ ?_) ?_
    · obtain ⟨ξ₀, hξ₀⟩ := exists_norm_eq F zero_le_one
      have hT' : T ∈ (spatialTensor (M.commutant : Set _)
          ((⊤ : VonNeumannAlgebra F) : Set _)).commutant := by
        rwa [commutant_spatialTensor_top_right, commutant_commutant]
      refine ⟨sliceRight ξ₀ ξ₀ T, sliceRight_mem_of_mem_spatialTensor hT ξ₀ ξ₀,
        (eq_rTensorCompletion_sliceRight_of_commute_rankOne hξ₀ fun y ↦
          (mem_commutant_iff.1 hT') _ (lTensorCompletion_mem_spatialTensor mem_top)).symm⟩
    · rintro _ ⟨x, hx, rfl⟩
      exact rTensorCompletion_mem_spatialTensor hx
  · rw [not_nontrivial_iff_subsingleton] at hF
    ext T
    refine ⟨fun _ ↦ ⟨0, zero_mem M, Subsingleton.elim _ _⟩,
      fun ⟨x, hx, hEq⟩ ↦ hEq ▸ rTensorCompletion_mem_spatialTensor hx⟩

/-- Symmetrically, the carrier of `spatialTensor ⊥ N` is `{y.lTensorCompletion E | y ∈ N}` on the
nose. -/
theorem coe_spatialTensor_bot_left (N : VonNeumannAlgebra F) :
    (spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) :
      Set (Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F))) =
      ContinuousLinearMap.lTensorCompletion E '' (N : Set (F →L[ℂ] F)) := by
  let U := (commIsometry ℂ F E).completion
  have h := congrArg (⇑U.conjStarAlgEquiv '' ·) (coe_spatialTensor_bot_right (F := E) N)
  rw [← coe_mapLinearIsometryEquiv, mapLinearIsometryEquiv_commIsometry_spatialTensor,
    Set.image_image] at h
  simpa [U, conjStarAlgEquiv_commIsometry_completion_rTensorCompletion] using h

/-- When `F` is nontrivial, `x ↦ x ⊗ 1` is a `⋆`-algebra equivalence
`M ≃⋆ₐ[ℂ] spatialTensor M ⊥`. -/
noncomputable def inlSpatialTensorBotEquiv [Nontrivial F] (M : VonNeumannAlgebra E) :
    M ≃⋆ₐ[ℂ] spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) :=
  StarAlgEquiv.ofBijective (inlSpatialTensor M (⊥ : VonNeumannAlgebra F))
    ⟨inlSpatialTensor_injective M (⊥ : VonNeumannAlgebra F), fun T ↦ by
      have hmem : T.1 ∈ (spatialTensor (M : Set (E →L[ℂ] E))
          ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) : Set _) := T.2
      rw [coe_spatialTensor_bot_right] at hmem
      obtain ⟨x, hx, hEq⟩ := hmem
      exact ⟨⟨x, hx⟩, Subtype.ext hEq⟩⟩

/-- When `E` is nontrivial, `y ↦ 1 ⊗ y` is a `⋆`-algebra equivalence
`N ≃⋆ₐ[ℂ] spatialTensor ⊥ N`. -/
noncomputable def inrSpatialTensorBotEquiv [Nontrivial E] (N : VonNeumannAlgebra F) :
    N ≃⋆ₐ[ℂ] spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) :=
  StarAlgEquiv.ofBijective (inrSpatialTensor (⊥ : VonNeumannAlgebra E) N)
    ⟨inrSpatialTensor_injective (⊥ : VonNeumannAlgebra E) N, fun T ↦ by
      have hmem : T.1 ∈ (spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
          (N : Set (F →L[ℂ] F)) : Set _) := T.2
      rw [coe_spatialTensor_bot_left] at hmem
      obtain ⟨y, hy, hEq⟩ := hmem
      exact ⟨⟨y, hy⟩, Subtype.ext hEq⟩⟩

/-- **`B(F)` tensor splitting theorem.** When `F` is nontrivial, a von Neumann algebra `P` on
`Completion (E ⊗[ℂ] F)` contains `spatialTensor ⊥ ⊤` if and only if there exists a unique von
Neumann algebra `M` on `E` such that `P = spatialTensor M ⊤`. -/
theorem existsUnique_eq_spatialTensor_top_right [Nontrivial F]
    (P : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))) :
    spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) ≤ P ↔
      ∃! M : VonNeumannAlgebra E,
        P = spatialTensor (M : Set (E →L[ℂ] E))
          ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  constructor
  · intro hle
    let S : Set (E →L[ℂ] E) := ContinuousLinearMap.rTensorCompletion F ⁻¹' (P.commutant : Set _)
    let M : VonNeumannAlgebra E := (adjoin S).commutant
    have hMc : M.commutant = adjoin S := commutant_commutant (adjoin S)
    have hPcomm : P.commutant =
        spatialTensor (M.commutant : Set (E →L[ℂ] E))
          ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
      refine le_antisymm (fun T hT ↦ ?_) ?_
      · have hcomm_bot :
            (spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
              ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F))).commutant =
              spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
                ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
          rw [commutant_spatialTensor_bot_left, commutant_top]
        have hT' : T ∈ (spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
            ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) : Set _) :=
          hcomm_bot ▸ commutant_le_commutant hle hT
        rw [coe_spatialTensor_bot_right] at hT'
        obtain ⟨x, -, rfl⟩ := hT'
        exact rTensorCompletion_mem_spatialTensor (hMc ▸ subset_adjoin S hT)
      · rw [hMc, spatialTensor_adjoin_left, spatialTensor_bot_right, spatialTensor_le_iff]
        exact ⟨fun _ hx ↦ hx, fun _ hy ↦ False.elim hy⟩
    have hPM : P = spatialTensor (M : Set (E →L[ℂ] E))
        ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
      rw [← commutant_commutant P, hPcomm, ← commutant_spatialTensor_top_right,
        commutant_commutant]
    refine ⟨M, hPM, fun M' hPM' ↦ ?_⟩
    obtain ⟨ξ₀, hξ₀⟩ := exists_norm_eq F zero_le_one
    have h1 : ⟪ξ₀, ξ₀⟫_ℂ = 1 := by simp [inner_self_eq_norm_sq_to_K, hξ₀]
    have hsub {N₁ N₂ : VonNeumannAlgebra E}
        (hEq : spatialTensor (N₁ : Set (E →L[ℂ] E)) ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) ≤
          spatialTensor (N₂ : Set (E →L[ℂ] E)) ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F))) :
        N₁ ≤ N₂ := fun x hx ↦ by
      have hmem := sliceRight_mem_of_mem_spatialTensor
        (hEq (rTensorCompletion_mem_spatialTensor hx)) ξ₀ ξ₀
      rwa [sliceRight_rTensorCompletion, h1, one_smul] at hmem
    exact le_antisymm (hsub (hPM'.symm.trans hPM).le) (hsub (hPM.symm.trans hPM').le)
  · rintro ⟨M, rfl, -⟩
    exact spatialTensor_mono (SetLike.coe_subset_coe.2 bot_le) Set.Subset.rfl

/-- **`B(E)` tensor splitting theorem.** When `E` is nontrivial, a von Neumann algebra `P` on
`Completion (E ⊗[ℂ] F)` contains `spatialTensor ⊤ ⊥` if and only if there exists a unique von
Neumann algebra `N` on `F` such that `P = spatialTensor ⊤ N`. -/
theorem existsUnique_eq_spatialTensor_top_left [Nontrivial E]
    (P : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))) :
    spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) ≤ P ↔
      ∃! N : VonNeumannAlgebra F,
        P = spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
          (N : Set (F →L[ℂ] F)) := by
  let U := (commIsometry ℂ E F).completion
  have hiff := existsUnique_eq_spatialTensor_top_right (E := F) (F := E)
    (mapLinearIsometryEquiv U P)
  rw [← (mapLinearIsometryEquiv U).le_iff_le,
    mapLinearIsometryEquiv_commIsometry_spatialTensor]
  refine hiff.trans ⟨fun ⟨N, hN, huniq⟩ ↦ ⟨N, ?_, fun N' hN' ↦ huniq N' ?_⟩,
    fun ⟨N, hN, huniq⟩ ↦ ⟨N, ?_, fun N' hN' ↦ huniq N' ?_⟩⟩
  · apply (mapLinearIsometryEquiv U).injective
    rwa [mapLinearIsometryEquiv_commIsometry_spatialTensor]
  · rw [hN', mapLinearIsometryEquiv_commIsometry_spatialTensor]
  · rw [hN, mapLinearIsometryEquiv_commIsometry_spatialTensor]
  · apply (mapLinearIsometryEquiv U).injective
    rwa [mapLinearIsometryEquiv_commIsometry_spatialTensor]

end TopCommutantAndSplitting

/-! ### Center and factoriality of spatial tensor products -/

section CenterAndFactors

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]

/-- **Center of a spatial tensor product with a factor on the left.** If `M` has trivial center
(`M ⊓ M' = ⊥`), then `(spatialTensor M N) ⊓ (spatialTensor M N)'` equals
`spatialTensor ⊥ (N ⊓ N')`. -/
theorem spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_left
    {M : VonNeumannAlgebra E} (hM : M ⊓ M.commutant = ⊥) (N : VonNeumannAlgebra F) :
    spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
      (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant =
      spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((N ⊓ N.commutant : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  refine le_antisymm (fun T hT ↦ ?_) (le_inf ?_ ?_)
  · obtain ⟨hTMN, hTcomm⟩ := mem_inf.1 hT
    have hbot (ξ η : F) : sliceRight ξ η T ∈ (⊥ : VonNeumannAlgebra E) := by
      rw [← hM, mem_inf]
      exact ⟨sliceRight_mem_of_mem_spatialTensor hTMN ξ η,
        sliceRight_mem_commutant_of_mem_commutant_spatialTensor hTcomm ξ η⟩
    have hTtop : T ∈ (spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F))).commutant := by
      rw [mem_commutant_iff]
      intro S hS
      have hS' : S ∈ (spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
          ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) : Set _) := hS
      rw [coe_spatialTensor_bot_right] at hS'
      obtain ⟨a, -, rfl⟩ := hS'
      refine ext_of_sliceRight fun ξ η ↦ ?_
      obtain ⟨c, hc⟩ := mem_bot.1 (hbot ξ η)
      rw [rTensorCompletion_mul_sliceRight, sliceRight_mul_rTensorCompletion, ← hc,
        Algebra.commutes]
    rw [commutant_spatialTensor_top_left, commutant_bot] at hTtop
    have hTtop' : T ∈ (spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) : Set _) := hTtop
    rw [coe_spatialTensor_bot_left] at hTtop'
    obtain ⟨y, -, rfl⟩ := hTtop'
    by_cases hE : Nontrivial E
    · obtain ⟨e₀, he₀⟩ := exists_norm_eq E zero_le_one
      have h1 : ⟪e₀, e₀⟫_ℂ = 1 := by simp [inner_self_eq_norm_sq_to_K, he₀]
      have hyN : y ∈ N := by
        have hmem := sliceLeft_mem_of_mem_spatialTensor hTMN e₀ e₀
        rwa [sliceLeft_lTensorCompletion, h1, one_smul] at hmem
      have hyN' : y ∈ N.commutant := by
        have hmem := sliceLeft_mem_commutant_of_mem_commutant_spatialTensor hTcomm e₀ e₀
        rwa [sliceLeft_lTensorCompletion, h1, one_smul] at hmem
      exact lTensorCompletion_mem_spatialTensor (mem_inf.2 ⟨hyN, hyN'⟩)
    · rw [not_nontrivial_iff_subsingleton] at hE
      rw [Subsingleton.elim (y.lTensorCompletion E) 0]
      exact zero_mem _
  · exact spatialTensor_mono (SetLike.coe_subset_coe.2 bot_le)
      (SetLike.coe_subset_coe.2 inf_le_left)
  · exact (spatialTensor_mono (SetLike.coe_subset_coe.2 (bot_le (a := M.commutant)))
      (SetLike.coe_subset_coe.2 inf_le_right)).trans
      (spatialTensor_commutant_le_commutant_spatialTensor M N)

/-- **Center of a spatial tensor product with a factor on the right.** If `N` has trivial center
(`N ⊓ N' = ⊥`), then `(spatialTensor M N) ⊓ (spatialTensor M N)'` equals
`spatialTensor (M ⊓ M') ⊥`. -/
theorem spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_right
    (M : VonNeumannAlgebra E) {N : VonNeumannAlgebra F} (hN : N ⊓ N.commutant = ⊥) :
    spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
      (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant =
      spatialTensor ((M ⊓ M.commutant : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  let U := (commIsometry ℂ F E).completion
  have h := congrArg (mapLinearIsometryEquiv U)
    (spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_left (E := F) hN M)
  rw [OrderIso.map_inf, mapLinearIsometryEquiv_commutant,
    mapLinearIsometryEquiv_commIsometry_spatialTensor,
    mapLinearIsometryEquiv_commIsometry_spatialTensor] at h
  exact h

/-- **Factoriality of spatial tensor products.** If `M` and `N` both have trivial center, then
`spatialTensor M N` also has trivial center. -/
theorem spatialTensor_inf_commutant_eq_bot {M : VonNeumannAlgebra E} {N : VonNeumannAlgebra F}
    (hM : M ⊓ M.commutant = ⊥) (hN : N ⊓ N.commutant = ⊥) :
    spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
      (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant = ⊥ := by
  rw [spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_left hM N, hN]
  exact spatialTensor_bot_bot

/-- **Sharp factoriality equivalence.** On nontrivial Hilbert spaces `E` and `F`, the spatial tensor
product `spatialTensor M N` has trivial center if and only if both `M` and `N` have trivial
center (`M ⊓ M' = ⊥` and `N ⊓ N' = ⊥`). -/
theorem spatialTensor_inf_commutant_eq_bot_iff [Nontrivial E] [Nontrivial F]
    (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
      (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant = ⊥ ↔
      M ⊓ M.commutant = ⊥ ∧ N ⊓ N.commutant = ⊥ := by
  refine ⟨fun hMN ↦ ⟨le_antisymm (fun x hx ↦ ?_) bot_le,
    le_antisymm (fun y hy ↦ ?_) bot_le⟩,
    fun ⟨hM, hN⟩ ↦ spatialTensor_inf_commutant_eq_bot hM hN⟩
  · obtain ⟨hxM, hxM'⟩ := mem_inf.1 hx
    have hxbot : x.rTensorCompletion F ∈ (⊥ : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))) := by
      rw [← hMN, mem_inf]
      exact ⟨rTensorCompletion_mem_spatialTensor hxM,
        spatialTensor_commutant_le_commutant_spatialTensor M N
          (rTensorCompletion_mem_spatialTensor hxM')⟩
    obtain ⟨c, hc⟩ := mem_bot.1 hxbot
    rw [Algebra.algebraMap_eq_smul_one, ← ContinuousLinearMap.rTensorCompletion_one (E := E),
      ← ContinuousLinearMap.rTensorCompletion_smul, ← Algebra.algebraMap_eq_smul_one] at hc
    exact mem_bot.2 ⟨c, ContinuousLinearMap.rTensorCompletion_injective F hc⟩
  · obtain ⟨hyN, hyN'⟩ := mem_inf.1 hy
    have hybot : y.lTensorCompletion E ∈ (⊥ : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))) := by
      rw [← hMN, mem_inf]
      exact ⟨lTensorCompletion_mem_spatialTensor hyN,
        spatialTensor_commutant_le_commutant_spatialTensor M N
          (lTensorCompletion_mem_spatialTensor hyN')⟩
    obtain ⟨c, hc⟩ := mem_bot.1 hybot
    rw [Algebra.algebraMap_eq_smul_one, ← ContinuousLinearMap.lTensorCompletion_one (F := F),
      ← ContinuousLinearMap.lTensorCompletion_smul, ← Algebra.algebraMap_eq_smul_one] at hc
    exact mem_bot.2 ⟨c, ContinuousLinearMap.lTensorCompletion_injective E hc⟩

end CenterAndFactors

end VonNeumannAlgebra
