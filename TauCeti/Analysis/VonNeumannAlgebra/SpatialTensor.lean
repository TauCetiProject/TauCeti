module

public import TauCeti.Analysis.InnerProductSpace.TensorProduct.Slice
public import TauCeti.Analysis.VonNeumannAlgebra.Lattice

/-!
# Spatial tensor products of concrete von Neumann algebras

For sets of bounded operators `A ⊆ E →L[ℂ] E` and `B ⊆ F →L[ℂ] F` on complex inner product spaces
`E` and `F` (neither assumed complete), `VonNeumannAlgebra.spatialTensor A B` is the concrete von
Neumann algebra on the completed Hilbert tensor product `Completion (E ⊗[ℂ] F)` generated by the
amplifications `x.rTensorCompletion F` (`x ⊗ 1`, `x ∈ A`) and `y.lTensorCompletion E`
(`1 ⊗ y`, `y ∈ B`).

## Main definitions

* `VonNeumannAlgebra.mapLinearIsometryEquiv`: order isomorphism `VonNeumannAlgebra H₁ ≃o
  VonNeumannAlgebra H₂` induced by conjugation with `e : H₁ ≃ₗᵢ[ℂ] H₂`.
* `VonNeumannAlgebra.conjStarAlgEquivOfEq`: star-algebra isomorphism `M ≃⋆ₐ[ℂ] N` induced by
  `e : H₁ ≃ₗᵢ[ℂ] H₂` when `mapLinearIsometryEquiv e M = N`.
* `VonNeumannAlgebra.spatialTensor`: the spatial tensor product `spatialTensor M N` on
  `Completion (E ⊗[ℂ] F)`.
* `VonNeumannAlgebra.spatialTensorCommEquiv`, `VonNeumannAlgebra.spatialTensorAssocEquiv`: symmetry
  and associativity star-algebra equivalences implemented by `commIsometry` and `assocCompletion`.
* `VonNeumannAlgebra.inlSpatialTensor`, `VonNeumannAlgebra.inrSpatialTensor`: canonical unital
  `⋆`-algebra inclusions `x ↦ x ⊗ 1` and `y ↦ 1 ⊗ y`.
* `VonNeumannAlgebra.comapRTensorCompletion`, `VonNeumannAlgebra.comapLTensorCompletion`: pullback
  von Neumann algebras `{x | x ⊗ 1 ∈ R}` and `{y | 1 ⊗ y ∈ R}`.

## Main results

* `VonNeumannAlgebra.spatialTensor_adjoin_left`, `VonNeumannAlgebra.spatialTensor_adjoin_right`:
  generation invariance `spatialTensor (adjoin A) B = spatialTensor A B` and its right counterpart.
* `VonNeumannAlgebra.opSliceRight_mem_of_mem_spatialTensor`,
  `VonNeumannAlgebra.opSliceLeft_mem_of_mem_spatialTensor`: operator slice maps land in the
  corresponding von Neumann tensor factor.
* `VonNeumannAlgebra.coe_spatialTensor_bot_right`, `VonNeumannAlgebra.coe_spatialTensor_bot_left`:
  the carriers of `spatialTensor M ⊥` and `spatialTensor ⊥ N` are `M ⊗ 1` and `1 ⊗ N`
  unconditionally.
* `VonNeumannAlgebra.commutant_spatialTensor_top_right`,
  `VonNeumannAlgebra.commutant_spatialTensor_bot_right`,
  `VonNeumannAlgebra.commutant_spatialTensor_top_left`,
  `VonNeumannAlgebra.commutant_spatialTensor_bot_left`: commutation theorems with `⊤ = B(K)` and
  `⊥ = ℂ • 1` (Kadison–Ringrose Theorem 11.2.10 in the full-algebra case).
* `VonNeumannAlgebra.eq_spatialTensor_top_right_of_le`,
  `VonNeumannAlgebra.eq_spatialTensor_top_left_of_le`: tensor splitting of any von Neumann algebra
  containing `1 ⊗ B(K)` or `B(H) ⊗ 1`.
* `VonNeumannAlgebra.spatialTensor_inf_commutant_eq_bot`: the spatial tensor product of two factors
  has trivial center.

## References

* R. V. Kadison and J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras*, Vol. II,
  Academic Press, 1986, §§11.1–11.2.
* M. Takesaki, *Theory of Operator Algebras I*, Springer, 1979, Chapter IV, §§1, 5.
* J. Dixmier, *Von Neumann Algebras*, North-Holland, 1981, Part I, Chapter 2, §4.
-/

public section

open UniformSpace ContinuousLinearMap TensorProduct
open scoped InnerProductSpace TensorProduct Pointwise

namespace VonNeumannAlgebra

/-! ### Unitary transport along linear isometric equivalences -/

section MapLinearIsometryEquiv

variable {H₁ H₂ : Type*}
  [NormedAddCommGroup H₁] [InnerProductSpace ℂ H₁] [CompleteSpace H₁]
  [NormedAddCommGroup H₂] [InnerProductSpace ℂ H₂] [CompleteSpace H₂]

private theorem conjStarAlgEquiv_eq_of_comp (e : H₁ ≃ₗᵢ[ℂ] H₂) {T₁ : H₁ →L[ℂ] H₁}
    {T₂ : H₂ →L[ℂ] H₂} (h : (e : H₁ →L[ℂ] H₂) ∘L T₁ = T₂ ∘L (e : H₁ →L[ℂ] H₂)) :
    e.conjStarAlgEquiv T₁ = T₂ := by
  ext v
  simpa [LinearIsometryEquiv.conjStarAlgEquiv_apply_apply] using congr($h (e.symm v))

private theorem image_conjStarAlgEquiv_centralizer (e : H₁ ≃ₗᵢ[ℂ] H₂) (s : Set (H₁ →L[ℂ] H₁)) :
    e.conjStarAlgEquiv '' s.centralizer = (e.conjStarAlgEquiv '' s).centralizer := by
  ext y
  rw [Set.mem_image, Set.mem_centralizer_iff]
  refine ⟨?_, fun hy ↦ ⟨e.conjStarAlgEquiv.symm y, Set.mem_centralizer_iff.mpr fun m hm ↦ ?_,
    e.conjStarAlgEquiv.apply_symm_apply y⟩⟩
  · rintro ⟨z, hz, rfl⟩ _ ⟨m, hm, rfl⟩
    rw [← map_mul, ← map_mul, hz m hm]
  · have h := congrArg e.conjStarAlgEquiv.symm (hy _ ⟨m, hm, rfl⟩)
    rwa [map_mul, map_mul, StarAlgEquiv.symm_apply_apply] at h

/-- Order isomorphism between concrete von Neumann algebras induced by conjugation with a linear
isometric equivalence `e : H₁ ≃ₗᵢ[ℂ] H₂`. -/
noncomputable def mapLinearIsometryEquiv (e : H₁ ≃ₗᵢ[ℂ] H₂) :
    VonNeumannAlgebra H₁ ≃o VonNeumannAlgebra H₂ where
  toFun M :=
    { toStarSubalgebra := M.toStarSubalgebra.map e.conjStarAlgEquiv.toStarAlgHom
      centralizer_centralizer' := by
        change (e.conjStarAlgEquiv '' (M : Set (H₁ →L[ℂ] H₁))).centralizer.centralizer =
          e.conjStarAlgEquiv '' (M : Set (H₁ →L[ℂ] H₁))
        rw [← image_conjStarAlgEquiv_centralizer, ← image_conjStarAlgEquiv_centralizer,
          M.centralizer_centralizer] }
  invFun N :=
    { toStarSubalgebra := N.toStarSubalgebra.map e.symm.conjStarAlgEquiv.toStarAlgHom
      centralizer_centralizer' := by
        change (e.symm.conjStarAlgEquiv '' (N : Set (H₂ →L[ℂ] H₂))).centralizer.centralizer =
          e.symm.conjStarAlgEquiv '' (N : Set (H₂ →L[ℂ] H₂))
        rw [← image_conjStarAlgEquiv_centralizer, ← image_conjStarAlgEquiv_centralizer,
          N.centralizer_centralizer] }
  left_inv M := SetLike.coe_injective <| by
    change e.symm.conjStarAlgEquiv '' (e.conjStarAlgEquiv '' (M : Set (H₁ →L[ℂ] H₁))) = M
    rw [Set.image_image]
    simp_rw [← LinearIsometryEquiv.symm_conjStarAlgEquiv, StarAlgEquiv.symm_apply_apply,
      Set.image_id']
  right_inv N := SetLike.coe_injective <| by
    change e.conjStarAlgEquiv '' (e.symm.conjStarAlgEquiv '' (N : Set (H₂ →L[ℂ] H₂))) = N
    rw [Set.image_image]
    simp_rw [← LinearIsometryEquiv.symm_conjStarAlgEquiv, StarAlgEquiv.apply_symm_apply,
      Set.image_id']
  map_rel_iff' {M₁ M₂} := by
    rw [← SetLike.coe_subset_coe]
    exact Set.image_subset_image_iff e.conjStarAlgEquiv.injective

@[simp]
theorem coe_mapLinearIsometryEquiv (e : H₁ ≃ₗᵢ[ℂ] H₂) (M : VonNeumannAlgebra H₁) :
    (mapLinearIsometryEquiv e M : Set (H₂ →L[ℂ] H₂)) = e.conjStarAlgEquiv '' M :=
  (rfl)

@[simp]
theorem mem_mapLinearIsometryEquiv (e : H₁ ≃ₗᵢ[ℂ] H₂) {M : VonNeumannAlgebra H₁}
    {y : H₂ →L[ℂ] H₂} :
    y ∈ mapLinearIsometryEquiv e M ↔ e.symm.conjStarAlgEquiv y ∈ M := by
  rw [← SetLike.mem_coe, coe_mapLinearIsometryEquiv, ← LinearIsometryEquiv.symm_conjStarAlgEquiv]
  refine ⟨?_, fun hy ↦ ⟨e.conjStarAlgEquiv.symm y, hy, StarAlgEquiv.apply_symm_apply _ _⟩⟩
  rintro ⟨x, hx, rfl⟩
  rwa [StarAlgEquiv.symm_apply_apply]

@[simp]
theorem symm_mapLinearIsometryEquiv (e : H₁ ≃ₗᵢ[ℂ] H₂) :
    (mapLinearIsometryEquiv e).symm = mapLinearIsometryEquiv e.symm :=
  (rfl)

theorem mapLinearIsometryEquiv_commutant (e : H₁ ≃ₗᵢ[ℂ] H₂) (M : VonNeumannAlgebra H₁) :
    mapLinearIsometryEquiv e M.commutant = (mapLinearIsometryEquiv e M).commutant :=
  SetLike.coe_injective <| by simp [image_conjStarAlgEquiv_centralizer]

theorem mapLinearIsometryEquiv_adjoin (e : H₁ ≃ₗᵢ[ℂ] H₂) (s : Set (H₁ →L[ℂ] H₁)) :
    mapLinearIsometryEquiv e (adjoin s) = adjoin (e.conjStarAlgEquiv '' s) := by
  refine SetLike.coe_injective ?_
  have hstar : e.conjStarAlgEquiv '' star s = star (e.conjStarAlgEquiv '' s) := by
    ext y
    simp only [Set.mem_image, Set.mem_star]
    exact ⟨fun ⟨x, hx, hy⟩ ↦ ⟨star x, hx, by rw [map_star, hy]⟩,
      fun ⟨z, hz, hy⟩ ↦ ⟨star z, by simpa using hz, by rw [map_star, hy, star_star]⟩⟩
  rw [coe_mapLinearIsometryEquiv, coe_adjoin, coe_adjoin, image_conjStarAlgEquiv_centralizer,
    image_conjStarAlgEquiv_centralizer, Set.image_union, hstar]

private theorem conjStarAlgEquiv_mem_of_eq (e : H₁ ≃ₗᵢ[ℂ] H₂) {M : VonNeumannAlgebra H₁}
    {N : VonNeumannAlgebra H₂} (h : mapLinearIsometryEquiv e M = N) (x : M) :
    e.conjStarAlgEquiv x.1 ∈ N := by
  rw [← h, mem_mapLinearIsometryEquiv, ← LinearIsometryEquiv.symm_conjStarAlgEquiv,
    StarAlgEquiv.symm_apply_apply]
  exact x.2

/-- Unital `⋆`-algebra equivalence `M ≃⋆ₐ[ℂ] N` induced by conjugation with `e : H₁ ≃ₗᵢ[ℂ] H₂` when
`mapLinearIsometryEquiv e M = N`. -/
noncomputable def conjStarAlgEquivOfEq (e : H₁ ≃ₗᵢ[ℂ] H₂) {M : VonNeumannAlgebra H₁}
    {N : VonNeumannAlgebra H₂} (h : mapLinearIsometryEquiv e M = N) :
    M ≃⋆ₐ[ℂ] N where
  toFun x := ⟨e.conjStarAlgEquiv x.1, conjStarAlgEquiv_mem_of_eq e h x⟩
  invFun y := ⟨e.symm.conjStarAlgEquiv y.1, (mem_mapLinearIsometryEquiv e).mp (h.symm ▸ y.2)⟩
  left_inv x := Subtype.ext <| by
    change e.symm.conjStarAlgEquiv (e.conjStarAlgEquiv x.1) = x.1
    rw [← LinearIsometryEquiv.symm_conjStarAlgEquiv, StarAlgEquiv.symm_apply_apply]
  right_inv y := Subtype.ext <| by
    change e.conjStarAlgEquiv (e.symm.conjStarAlgEquiv y.1) = y.1
    rw [← LinearIsometryEquiv.symm_conjStarAlgEquiv, StarAlgEquiv.apply_symm_apply]
  map_mul' x₁ x₂ := Subtype.ext (map_mul e.conjStarAlgEquiv x₁.1 x₂.1)
  map_add' x₁ x₂ := Subtype.ext (map_add e.conjStarAlgEquiv x₁.1 x₂.1)
  map_smul' c x := Subtype.ext (map_smul e.conjStarAlgEquiv c x.1)
  map_star' x := Subtype.ext (map_star e.conjStarAlgEquiv x.1)

@[simp]
theorem coe_conjStarAlgEquivOfEq_apply (e : H₁ ≃ₗᵢ[ℂ] H₂) {M : VonNeumannAlgebra H₁}
    {N : VonNeumannAlgebra H₂} (h : mapLinearIsometryEquiv e M = N) (x : M) :
    (conjStarAlgEquivOfEq e h x : H₂ →L[ℂ] H₂) = e.conjStarAlgEquiv x.1 :=
  (rfl)

end MapLinearIsometryEquiv

/-! ### Definition and generation properties of the spatial tensor product -/

section DefsAndBasic

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]

/-- **Spatial tensor product of operator sets / von Neumann algebras.** For `A ⊆ E →L[ℂ] E` and
`B ⊆ F →L[ℂ] F`, `spatialTensor A B` is the concrete von Neumann algebra on `Completion (E ⊗[ℂ] F)`
generated by `x ⊗ 1` (`x ∈ A`) and `1 ⊗ y` (`y ∈ B`). Neither `E` nor `F` is assumed complete. -/
noncomputable def spatialTensor (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    VonNeumannAlgebra (Completion (E ⊗[ℂ] F)) :=
  adjoin (rTensorCompletion F '' A ∪ lTensorCompletion E '' B)

theorem rTensorCompletion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {x : E →L[ℂ] E} (hx : x ∈ A) :
    x.rTensorCompletion F ∈ spatialTensor A B :=
  subset_adjoin _ (Or.inl ⟨x, hx, rfl⟩)

theorem lTensorCompletion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {y : F →L[ℂ] F} (hy : y ∈ B) :
    y.lTensorCompletion E ∈ spatialTensor A B :=
  subset_adjoin _ (Or.inr ⟨y, hy, rfl⟩)

theorem mapLCompletion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {x : E →L[ℂ] E} (hx : x ∈ A) {y : F →L[ℂ] F} (hy : y ∈ B) :
    mapLCompletion x y ∈ spatialTensor A B := by
  have hmul := mul_mem (rTensorCompletion_mem_spatialTensor (B := B) hx)
    (lTensorCompletion_mem_spatialTensor (A := A) hy)
  rwa [mul_def, rTensorCompletion_comp_lTensorCompletion] at hmul

@[simp]
theorem spatialTensor_le_iff {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {R : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))} :
    spatialTensor A B ≤ R ↔
      (∀ x ∈ A, x.rTensorCompletion F ∈ R) ∧ (∀ y ∈ B, y.lTensorCompletion E ∈ R) := by
  rw [spatialTensor, adjoin_le_iff, Set.union_subset_iff]
  exact ⟨fun ⟨hA, hB⟩ ↦ ⟨fun x hx ↦ hA ⟨x, hx, rfl⟩, fun y hy ↦ hB ⟨y, hy, rfl⟩⟩,
    fun ⟨hA, hB⟩ ↦ ⟨by rintro _ ⟨x, hx, rfl⟩; exact hA x hx,
      by rintro _ ⟨y, hy, rfl⟩; exact hB y hy⟩⟩

theorem spatialTensor_mono {A₁ A₂ : Set (E →L[ℂ] E)} {B₁ B₂ : Set (F →L[ℂ] F)}
    (hA : A₁ ⊆ A₂) (hB : B₁ ⊆ B₂) :
    spatialTensor A₁ B₁ ≤ spatialTensor A₂ B₂ :=
  spatialTensor_le_iff.mpr
    ⟨fun _ hx ↦ rTensorCompletion_mem_spatialTensor (hA hx),
      fun _ hy ↦ lTensorCompletion_mem_spatialTensor (hB hy)⟩

@[simp]
theorem spatialTensor_empty_empty :
    spatialTensor (∅ : Set (E →L[ℂ] E)) (∅ : Set (F →L[ℂ] F)) = ⊥ := by
  simp [spatialTensor]

theorem spatialTensor_eq_adjoin_image2_mapLCompletion {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    (hA : (1 : E →L[ℂ] E) ∈ A) (hB : (1 : F →L[ℂ] F) ∈ B) :
    spatialTensor A B = adjoin (Set.image2 mapLCompletion A B) := by
  refine le_antisymm ?_ (adjoin_le_iff.mpr ?_)
  · refine spatialTensor_le_iff.mpr ⟨fun x hx ↦ subset_adjoin _ ?_, fun y hy ↦ subset_adjoin _ ?_⟩
    · exact ⟨x, hx, 1, hB, (rTensorCompletion_eq_mapLCompletion F x).symm⟩
    · exact ⟨1, hA, y, hy, (lTensorCompletion_eq_mapLCompletion E y).symm⟩
  · rintro _ ⟨x, hx, y, hy, rfl⟩
    exact mapLCompletion_mem_spatialTensor hx hy

@[simp]
theorem spatialTensor_subsingleton_left [Subsingleton E] (A : Set (E →L[ℂ] E))
    (B : Set (F →L[ℂ] F)) :
    spatialTensor A B = ⊥ := by
  have := subsingleton_completion_of_subsingleton_left (𝕜 := ℂ) (E := E) (F := F)
  refine eq_bot_iff.mpr fun X _ ↦ ?_
  rw [Subsingleton.elim X 0]
  exact zero_mem ⊥

@[simp]
theorem spatialTensor_subsingleton_right [Subsingleton F] (A : Set (E →L[ℂ] E))
    (B : Set (F →L[ℂ] F)) :
    spatialTensor A B = ⊥ := by
  have := subsingleton_completion_of_subsingleton_right (𝕜 := ℂ) (E := E) (F := F)
  refine eq_bot_iff.mpr fun X _ ↦ ?_
  rw [Subsingleton.elim X 0]
  exact zero_mem ⊥

/-- Generation invariance in the left factor: replacing `A` by `adjoin A` does not change the
spatial tensor product. No completeness hypothesis on `F` is required. -/
theorem spatialTensor_adjoin_left [CompleteSpace E] (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor (adjoin A : Set (E →L[ℂ] E)) B = spatialTensor A B := by
  refine le_antisymm ?_ (spatialTensor_mono (subset_adjoin A) Set.Subset.rfl)
  refine spatialTensor_le_iff.mpr ⟨fun x hx ↦ ?_, fun _ hy ↦ lTensorCompletion_mem_spatialTensor hy⟩
  rw [coe_adjoin] at hx
  rw [← SetLike.mem_coe, spatialTensor, coe_adjoin]
  intro Y hY
  rw [ext_opSliceRight]
  intro η₁ η₂
  have hslice : opSliceRight η₁ η₂ Y ∈ (A ∪ star A).centralizer := by
    rintro a (ha | ha)
    · have hcomm : a.rTensorCompletion F * Y = Y * a.rTensorCompletion F :=
        hY _ (Or.inl (Or.inl ⟨a, ha, rfl⟩))
      simpa only [mul_def, opSliceRight_rTensorCompletion_comp,
        opSliceRight_comp_rTensorCompletion] using congrArg (opSliceRight η₁ η₂) hcomm
    · rw [Set.mem_star] at ha
      have hmem : a.rTensorCompletion F ∈
          star (rTensorCompletion F '' A ∪ lTensorCompletion E '' B) := by
        rw [Set.mem_star, star_rTensorCompletion]
        exact Or.inl ⟨star a, ha, rfl⟩
      have hcomm : a.rTensorCompletion F * Y = Y * a.rTensorCompletion F := hY _ (Or.inr hmem)
      simpa only [mul_def, opSliceRight_rTensorCompletion_comp,
        opSliceRight_comp_rTensorCompletion] using congrArg (opSliceRight η₁ η₂) hcomm
  simpa only [mul_def, opSliceRight_rTensorCompletion_comp,
    opSliceRight_comp_rTensorCompletion] using hx _ hslice

theorem mapLinearIsometryEquiv_comm_spatialTensor (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    mapLinearIsometryEquiv (commIsometry ℂ E F).completion (spatialTensor A B) =
      spatialTensor B A := by
  rw [spatialTensor, spatialTensor, mapLinearIsometryEquiv_adjoin, Set.image_union]
  congr 1
  have h₁ : (commIsometry ℂ E F).completion.conjStarAlgEquiv '' (rTensorCompletion F '' A) =
      lTensorCompletion F '' A := by
    rw [Set.image_image]
    refine Set.image_congr' fun x ↦ ?_
    simpa [LinearIsometryEquiv.conjStarAlgEquiv_apply] using
      commIsometry_completion_comp_rTensorCompletion_comp_commIsometry_completion
        (𝕜 := ℂ) (E := F) (F := E) (G := E) x
  have h₂ : (commIsometry ℂ E F).completion.conjStarAlgEquiv '' (lTensorCompletion E '' B) =
      rTensorCompletion E '' B := by
    rw [Set.image_image]
    refine Set.image_congr' fun y ↦ ?_
    simpa [LinearIsometryEquiv.conjStarAlgEquiv_apply] using
      commIsometry_completion_comp_lTensorCompletion_comp_commIsometry_completion
        (𝕜 := ℂ) (E := F) (F := F) (G := E) y
  rw [h₁, h₂, Set.union_comm]

/-- Generation invariance in the right factor: replacing `B` by `adjoin B` does not change the
spatial tensor product. No completeness hypothesis on `E` is required. -/
theorem spatialTensor_adjoin_right [CompleteSpace F] (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor A (adjoin B : Set (F →L[ℂ] F)) = spatialTensor A B :=
  (mapLinearIsometryEquiv (commIsometry ℂ E F).completion).injective <| by
    rw [mapLinearIsometryEquiv_comm_spatialTensor, spatialTensor_adjoin_left,
      mapLinearIsometryEquiv_comm_spatialTensor]

end DefsAndBasic

/-! ### Symmetry and associativity of the spatial tensor product -/

section SymmetryAndAssociativity

variable {E F G : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
  [NormedAddCommGroup G] [InnerProductSpace ℂ G]

/-- **Symmetry of the spatial tensor product.** Conjugation by `(commIsometry ℂ E F).completion`
yields a unital `⋆`-algebra equivalence `spatialTensor A B ≃⋆ₐ[ℂ] spatialTensor B A`. -/
noncomputable def spatialTensorCommEquiv (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor A B ≃⋆ₐ[ℂ] spatialTensor B A :=
  conjStarAlgEquivOfEq (commIsometry ℂ E F).completion
    (mapLinearIsometryEquiv_comm_spatialTensor A B)

@[simp]
theorem coe_spatialTensorCommEquiv_apply (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F))
    (X : spatialTensor A B) :
    (spatialTensorCommEquiv A B X : Completion (F ⊗[ℂ] E) →L[ℂ] Completion (F ⊗[ℂ] E)) =
      (commIsometry ℂ E F).completion.conjStarAlgEquiv X.1 :=
  (rfl)

theorem mapLinearIsometryEquiv_assoc_spatialTensor (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F))
    (C : Set (G →L[ℂ] G)) :
    mapLinearIsometryEquiv (assocCompletion ℂ E F G)
        (spatialTensor (SetLike.coe (spatialTensor A B)) C) =
      spatialTensor A (SetLike.coe (spatialTensor B C)) := by
  have hA (x : E →L[ℂ] E) :
      (assocCompletion ℂ E F G).conjStarAlgEquiv
          ((x.rTensorCompletion F).rTensorCompletion G) =
        x.rTensorCompletion (Completion (F ⊗[ℂ] G)) :=
    conjStarAlgEquiv_eq_of_comp (assocCompletion ℂ E F G)
      (assocCompletion_comp_rTensorCompletion_rTensorCompletion x)
  have hB (y : F →L[ℂ] F) :
      (assocCompletion ℂ E F G).conjStarAlgEquiv
          ((y.lTensorCompletion E).rTensorCompletion G) =
        (y.rTensorCompletion G).lTensorCompletion E :=
    conjStarAlgEquiv_eq_of_comp (assocCompletion ℂ E F G)
      (assocCompletion_comp_lTensorCompletion_rTensorCompletion y)
  have hC (z : G →L[ℂ] G) :
      (assocCompletion ℂ E F G).conjStarAlgEquiv
          (z.lTensorCompletion (Completion (E ⊗[ℂ] F))) =
        (z.lTensorCompletion F).lTensorCompletion E :=
    conjStarAlgEquiv_eq_of_comp (assocCompletion ℂ E F G)
      (assocCompletion_comp_lTensorCompletion z)
  change mapLinearIsometryEquiv (assocCompletion ℂ E F G)
      (spatialTensor (SetLike.coe (adjoin (rTensorCompletion F '' A ∪ lTensorCompletion E '' B))) C)
    = spatialTensor A (SetLike.coe (adjoin (rTensorCompletion G '' B ∪ lTensorCompletion F '' C)))
  rw [spatialTensor_adjoin_left, spatialTensor_adjoin_right, spatialTensor, spatialTensor,
    mapLinearIsometryEquiv_adjoin]
  refine congrArg adjoin (Set.ext fun T ↦ ⟨?_, ?_⟩)
  · rintro ⟨_, (⟨_, (⟨x, hx, rfl⟩ | ⟨y, hy, rfl⟩), rfl⟩ | ⟨z, hz, rfl⟩), rfl⟩
    · exact Or.inl ⟨x, hx, (hA x).symm⟩
    · exact Or.inr ⟨y.rTensorCompletion G, Or.inl ⟨y, hy, rfl⟩, (hB y).symm⟩
    · exact Or.inr ⟨z.lTensorCompletion F, Or.inr ⟨z, hz, rfl⟩, (hC z).symm⟩
  · rintro (⟨x, hx, rfl⟩ | ⟨_, (⟨y, hy, rfl⟩ | ⟨z, hz, rfl⟩), rfl⟩)
    · exact ⟨_, Or.inl ⟨_, Or.inl ⟨x, hx, rfl⟩, rfl⟩, hA x⟩
    · exact ⟨_, Or.inl ⟨_, Or.inr ⟨y, hy, rfl⟩, rfl⟩, hB y⟩
    · exact ⟨_, Or.inr ⟨z, hz, rfl⟩, hC z⟩

/-- **Associativity of the spatial tensor product.** Conjugation by `assocCompletion ℂ E F G`
yields a unital `⋆`-algebra equivalence
`spatialTensor (spatialTensor A B) C ≃⋆ₐ[ℂ] spatialTensor A (spatialTensor B C)` without
completeness assumptions on `E`, `F`, or `G`. -/
noncomputable def spatialTensorAssocEquiv (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F))
    (C : Set (G →L[ℂ] G)) :
    spatialTensor (SetLike.coe (spatialTensor A B)) C ≃⋆ₐ[ℂ]
      spatialTensor A (SetLike.coe (spatialTensor B C)) :=
  conjStarAlgEquivOfEq (assocCompletion ℂ E F G)
    (mapLinearIsometryEquiv_assoc_spatialTensor A B C)

@[simp]
theorem coe_spatialTensorAssocEquiv_apply (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F))
    (C : Set (G →L[ℂ] G)) (X : spatialTensor (SetLike.coe (spatialTensor A B)) C) :
    (spatialTensorAssocEquiv A B C X :
        Completion (E ⊗[ℂ] Completion (F ⊗[ℂ] G)) →L[ℂ]
          Completion (E ⊗[ℂ] Completion (F ⊗[ℂ] G))) =
      (assocCompletion ℂ E F G).conjStarAlgEquiv X.1 :=
  (rfl)

end SymmetryAndAssociativity

/-! ### Canonical factor inclusions `x ↦ x ⊗ 1` and `y ↦ 1 ⊗ y` -/

section Inclusions

variable {E F H K : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

/-- Canonical unital `⋆`-algebra inclusion `x ↦ x ⊗ 1` of `M` into `spatialTensor M B`. Defined
without nontriviality or completeness assumptions on `F`. -/
noncomputable def inlSpatialTensor (M : VonNeumannAlgebra H) (B : Set (F →L[ℂ] F)) :
    M →⋆ₐ[ℂ] spatialTensor (M : Set (H →L[ℂ] H)) B where
  toFun x := ⟨x.1.rTensorCompletion F, rTensorCompletion_mem_spatialTensor x.2⟩
  map_one' := Subtype.ext (rTensorCompletion_one (𝕜 := ℂ) (E := H) (G := F))
  map_mul' x₁ x₂ := Subtype.ext (rTensorCompletion_mul x₁.1 x₂.1)
  map_zero' := Subtype.ext (rTensorCompletion_zero (𝕜 := ℂ) (E := H) (F := H) (G := F))
  map_add' x₁ x₂ := Subtype.ext (rTensorCompletion_add x₁.1 x₂.1)
  commutes' c := Subtype.ext <| by simp [Algebra.algebraMap_eq_smul_one]
  map_star' x := Subtype.ext (star_rTensorCompletion x.1).symm

@[simp]
theorem coe_inlSpatialTensor_apply (M : VonNeumannAlgebra H) (B : Set (F →L[ℂ] F)) (x : M) :
    (inlSpatialTensor M B x : Completion (H ⊗[ℂ] F) →L[ℂ] Completion (H ⊗[ℂ] F)) =
      x.1.rTensorCompletion F :=
  (rfl)

theorem inlSpatialTensor_injective [Nontrivial F] (M : VonNeumannAlgebra H) (B : Set (F →L[ℂ] F)) :
    Function.Injective (inlSpatialTensor M B) := fun _ _ h ↦
  Subtype.ext <| rTensorCompletion_injective (𝕜 := ℂ) (E := H) (F := H) (G := F)
    (congrArg Subtype.val h)

theorem norm_inlSpatialTensor [Nontrivial F] (M : VonNeumannAlgebra H) (B : Set (F →L[ℂ] F))
    (x : M) :
    ‖inlSpatialTensor M B x‖ = ‖x‖ :=
  norm_rTensorCompletion (G := F) x.1

@[simp]
theorem inlSpatialTensor_eq_zero [Subsingleton F] (M : VonNeumannAlgebra H) (B : Set (F →L[ℂ] F))
    (x : M) :
    inlSpatialTensor M B x = 0 := by
  have := subsingleton_completion_of_subsingleton_right (𝕜 := ℂ) (E := H) (F := F)
  exact Subsingleton.elim _ _

/-- Canonical unital `⋆`-algebra inclusion `y ↦ 1 ⊗ y` of `N` into `spatialTensor A N`. Defined
without nontriviality or completeness assumptions on `E`. -/
noncomputable def inrSpatialTensor (A : Set (E →L[ℂ] E)) (N : VonNeumannAlgebra K) :
    N →⋆ₐ[ℂ] spatialTensor A (N : Set (K →L[ℂ] K)) where
  toFun y := ⟨y.1.lTensorCompletion E, lTensorCompletion_mem_spatialTensor y.2⟩
  map_one' := Subtype.ext (lTensorCompletion_one (𝕜 := ℂ) (E := E) (G := K))
  map_mul' y₁ y₂ := Subtype.ext (lTensorCompletion_mul y₁.1 y₂.1)
  map_zero' := Subtype.ext (lTensorCompletion_zero (𝕜 := ℂ) (E := E) (F := K) (G := K))
  map_add' y₁ y₂ := Subtype.ext (lTensorCompletion_add y₁.1 y₂.1)
  commutes' c := Subtype.ext <| by simp [Algebra.algebraMap_eq_smul_one]
  map_star' y := Subtype.ext (star_lTensorCompletion y.1).symm

@[simp]
theorem coe_inrSpatialTensor_apply (A : Set (E →L[ℂ] E)) (N : VonNeumannAlgebra K) (y : N) :
    (inrSpatialTensor A N y : Completion (E ⊗[ℂ] K) →L[ℂ] Completion (E ⊗[ℂ] K)) =
      y.1.lTensorCompletion E :=
  (rfl)

theorem inrSpatialTensor_injective [Nontrivial E] (A : Set (E →L[ℂ] E)) (N : VonNeumannAlgebra K) :
    Function.Injective (inrSpatialTensor A N) := fun _ _ h ↦
  Subtype.ext <| lTensorCompletion_injective (𝕜 := ℂ) (E := E) (F := K) (G := K)
    (congrArg Subtype.val h)

theorem norm_inrSpatialTensor [Nontrivial E] (A : Set (E →L[ℂ] E)) (N : VonNeumannAlgebra K)
    (y : N) :
    ‖inrSpatialTensor A N y‖ = ‖y‖ :=
  norm_lTensorCompletion (E := E) y.1

@[simp]
theorem inrSpatialTensor_eq_zero [Subsingleton E] (A : Set (E →L[ℂ] E)) (N : VonNeumannAlgebra K)
    (y : N) :
    inrSpatialTensor A N y = 0 := by
  have := subsingleton_completion_of_subsingleton_left (𝕜 := ℂ) (E := E) (F := K)
  exact Subsingleton.elim _ _

end Inclusions

/-! ### Slice membership, commutants with `⊤` and `⊥`, tensor splitting, and factoriality -/

section SliceAndCommutants

variable {E F H K : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

/-- Right operator slices of any operator in `spatialTensor M B` lie in `M` (no completeness
assumption on `F`). -/
theorem opSliceRight_mem_of_mem_spatialTensor {M : VonNeumannAlgebra H} {B : Set (F →L[ℂ] F)}
    (η₁ η₂ : F) {X : Completion (H ⊗[ℂ] F) →L[ℂ] Completion (H ⊗[ℂ] F)}
    (hX : X ∈ spatialTensor (M : Set (H →L[ℂ] H)) B) :
    opSliceRight η₁ η₂ X ∈ M := by
  rw [← SetLike.mem_coe, ← M.centralizer_centralizer]
  intro a ha
  have ha_comm : a.rTensorCompletion F ∈ (spatialTensor (M : Set (H →L[ℂ] H)) B).commutant := by
    rw [← SetLike.mem_coe, spatialTensor, coe_commutant_adjoin]
    rintro Z (hZ | hZ)
    · rcases hZ with ⟨m, hm, rfl⟩ | ⟨b, _, rfl⟩
      · simpa only [rTensorCompletion_mul] using congrArg (rTensorCompletion F) (ha m hm)
      · exact (commute_rTensorCompletion_lTensorCompletion a b).symm
    · rw [Set.mem_star] at hZ
      rcases hZ with ⟨m, hm, hZ⟩ | ⟨b, _, hZ⟩
      · have hZ' : Z = (star m).rTensorCompletion F := by
          simpa [star_rTensorCompletion] using (congrArg star hZ).symm
        rw [hZ']
        simpa only [rTensorCompletion_mul] using congrArg (rTensorCompletion F) (ha _ (star_mem hm))
      · have hcomm : b.lTensorCompletion H * (star a).rTensorCompletion F =
            (star a).rTensorCompletion F * b.lTensorCompletion H :=
          (commute_rTensorCompletion_lTensorCompletion (star a) b).symm
        simpa only [star_mul, star_rTensorCompletion, star_star, hZ] using
          (congrArg star hcomm).symm
  have hXa : X * a.rTensorCompletion F = a.rTensorCompletion F * X :=
    (mem_commutant_iff.mp ha_comm) X hX
  simpa only [mul_def, opSliceRight_rTensorCompletion_comp,
    opSliceRight_comp_rTensorCompletion] using congrArg (opSliceRight η₁ η₂) hXa.symm

/-- Left operator slices of any operator in `spatialTensor A N` lie in `N` (no completeness
assumption on `E`). -/
theorem opSliceLeft_mem_of_mem_spatialTensor {A : Set (E →L[ℂ] E)} {N : VonNeumannAlgebra K}
    (ξ₁ ξ₂ : E) {X : Completion (E ⊗[ℂ] K) →L[ℂ] Completion (E ⊗[ℂ] K)}
    (hX : X ∈ spatialTensor A (N : Set (K →L[ℂ] K))) :
    opSliceLeft ξ₁ ξ₂ X ∈ N := by
  have hcomm : (commIsometry ℂ E K).completion.conjStarAlgEquiv X ∈
      spatialTensor (N : Set (K →L[ℂ] K)) A := by
    rw [← mapLinearIsometryEquiv_comm_spatialTensor]
    exact ⟨X, hX, rfl⟩
  have hsl := opSliceRight_mem_of_mem_spatialTensor ξ₁ ξ₂ hcomm
  rwa [LinearIsometryEquiv.conjStarAlgEquiv_apply, LinearIsometryEquiv.completion_symm,
    commIsometry_symm, ← opSliceLeft_eq_opSliceRight_conj_commIsometry] at hsl

private theorem centralizer_centralizer_comap_rTensorCompletion
    (R : VonNeumannAlgebra (Completion (H ⊗[ℂ] F))) :
    Set.centralizer (Set.centralizer
      (R.toStarSubalgebra.comap (rTensorCompletionStarAlgHom ℂ H F) : Set (H →L[ℂ] H))) =
      R.toStarSubalgebra.comap (rTensorCompletionStarAlgHom ℂ H F) := by
  refine Set.Subset.antisymm (fun x hx ↦ ?_) Set.subset_centralizer_centralizer
  simp only [SetLike.mem_coe, StarSubalgebra.mem_comap, rTensorCompletionStarAlgHom_apply]
  change x.rTensorCompletion F ∈ (R : Set _)
  rw [← R.centralizer_centralizer]
  intro Y hY
  rw [ext_opSliceRight]
  intro η₁ η₂
  have hslice : opSliceRight η₁ η₂ Y ∈
      Set.centralizer (R.toStarSubalgebra.comap (rTensorCompletionStarAlgHom ℂ H F) :
        Set (H →L[ℂ] H)) := by
    intro a ha
    simp only [SetLike.mem_coe, StarSubalgebra.mem_comap, rTensorCompletionStarAlgHom_apply] at ha
    simpa only [mul_def, opSliceRight_rTensorCompletion_comp,
      opSliceRight_comp_rTensorCompletion] using congrArg (opSliceRight η₁ η₂) (hY _ ha)
  simpa only [mul_def, opSliceRight_rTensorCompletion_comp,
    opSliceRight_comp_rTensorCompletion] using hx _ hslice

/-- Pullback of a von Neumann algebra on `Completion (H ⊗[ℂ] F)` along `x ↦ x ⊗ 1`. -/
noncomputable def comapRTensorCompletion (F : Type*) [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    (R : VonNeumannAlgebra (Completion (H ⊗[ℂ] F))) : VonNeumannAlgebra H where
  toStarSubalgebra := R.toStarSubalgebra.comap (rTensorCompletionStarAlgHom ℂ H F)
  centralizer_centralizer' := centralizer_centralizer_comap_rTensorCompletion R

@[simp]
theorem mem_comapRTensorCompletion {R : VonNeumannAlgebra (Completion (H ⊗[ℂ] F))}
    {x : H →L[ℂ] H} :
    x ∈ R.comapRTensorCompletion F ↔ x.rTensorCompletion F ∈ R := by
  simp [comapRTensorCompletion, ← SetLike.mem_coe]

private theorem centralizer_centralizer_comap_lTensorCompletion
    (R : VonNeumannAlgebra (Completion (E ⊗[ℂ] K))) :
    Set.centralizer (Set.centralizer
      (R.toStarSubalgebra.comap (lTensorCompletionStarAlgHom ℂ E K) : Set (K →L[ℂ] K))) =
      R.toStarSubalgebra.comap (lTensorCompletionStarAlgHom ℂ E K) := by
  have heq : (R.toStarSubalgebra.comap (lTensorCompletionStarAlgHom ℂ E K) : Set (K →L[ℂ] K)) =
      ((mapLinearIsometryEquiv (commIsometry ℂ E K).completion R).comapRTensorCompletion E :
        Set (K →L[ℂ] K)) := by
    ext y
    simp only [SetLike.mem_coe, StarSubalgebra.mem_comap, lTensorCompletionStarAlgHom_apply,
      mem_comapRTensorCompletion, mem_mapLinearIsometryEquiv, LinearIsometryEquiv.completion_symm,
      commIsometry_symm, LinearIsometryEquiv.conjStarAlgEquiv_apply]
    rw [commIsometry_completion_comp_rTensorCompletion_comp_commIsometry_completion]
    rfl
  rw [heq, centralizer_centralizer]

/-- Pullback of a von Neumann algebra on `Completion (E ⊗[ℂ] K)` along `y ↦ 1 ⊗ y`. -/
noncomputable def comapLTensorCompletion (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (R : VonNeumannAlgebra (Completion (E ⊗[ℂ] K))) : VonNeumannAlgebra K where
  toStarSubalgebra := R.toStarSubalgebra.comap (lTensorCompletionStarAlgHom ℂ E K)
  centralizer_centralizer' := centralizer_centralizer_comap_lTensorCompletion R

@[simp]
theorem mem_comapLTensorCompletion {R : VonNeumannAlgebra (Completion (E ⊗[ℂ] K))}
    {y : K →L[ℂ] K} :
    y ∈ R.comapLTensorCompletion E ↔ y.lTensorCompletion E ∈ R := by
  simp [comapLTensorCompletion, ← SetLike.mem_coe]

@[simp]
theorem comapRTensorCompletion_spatialTensor [Nontrivial F] (M : VonNeumannAlgebra H)
    (B : Set (F →L[ℂ] F)) :
    (spatialTensor (M : Set (H →L[ℂ] H)) B).comapRTensorCompletion F = M := by
  obtain ⟨v, hv⟩ := exists_ne (0 : F)
  have hc : ⟪v, v⟫_ℂ ≠ 0 := inner_self_ne_zero.mpr hv
  ext x
  rw [mem_comapRTensorCompletion]
  refine ⟨fun hx ↦ ?_, fun hx ↦ rTensorCompletion_mem_spatialTensor hx⟩
  have hmem := SMulMemClass.smul_mem (⟪v, v⟫_ℂ)⁻¹ (opSliceRight_mem_of_mem_spatialTensor v v hx)
  rwa [opSliceRight_rTensorCompletion, smul_smul, inv_mul_cancel₀ hc, one_smul] at hmem

@[simp]
theorem comapLTensorCompletion_spatialTensor [Nontrivial E] (A : Set (E →L[ℂ] E))
    (N : VonNeumannAlgebra K) :
    (spatialTensor A (N : Set (K →L[ℂ] K))).comapLTensorCompletion E = N := by
  obtain ⟨u, hu⟩ := exists_ne (0 : E)
  have hc : ⟪u, u⟫_ℂ ≠ 0 := inner_self_ne_zero.mpr hu
  ext y
  rw [mem_comapLTensorCompletion]
  refine ⟨fun hy ↦ ?_, fun hy ↦ lTensorCompletion_mem_spatialTensor hy⟩
  have hmem := SMulMemClass.smul_mem (⟪u, u⟫_ℂ)⁻¹ (opSliceLeft_mem_of_mem_spatialTensor u u hy)
  rwa [opSliceLeft_lTensorCompletion, smul_smul, inv_mul_cancel₀ hc, one_smul] at hmem

@[simp]
theorem spatialTensor_bot_bot :
    spatialTensor ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) = ⊥ := by
  refine eq_bot_iff.mpr (spatialTensor_le_iff.mpr ⟨?_, ?_⟩)
  · intro x hx
    obtain ⟨c, rfl⟩ := mem_bot.mp hx
    rw [mem_bot]
    exact ⟨c, by simp [Algebra.algebraMap_eq_smul_one]⟩
  · intro y hy
    obtain ⟨c, rfl⟩ := mem_bot.mp hy
    rw [mem_bot]
    exact ⟨c, by simp [Algebra.algebraMap_eq_smul_one]⟩

/-- Elementary commutant inclusion `spatialTensor M' N' ≤ (spatialTensor M N)'` (the easy half of
Tomita's commutation theorem). -/
theorem spatialTensor_commutant_le (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K) :
    spatialTensor (M.commutant : Set (H →L[ℂ] H)) (N.commutant : Set (K →L[ℂ] K)) ≤
      (spatialTensor (M : Set (H →L[ℂ] H)) (N : Set (K →L[ℂ] K))).commutant := by
  have hstar_M : star (rTensorCompletion K '' (M : Set (H →L[ℂ] H))) ⊆
      rTensorCompletion K '' (M : Set (H →L[ℂ] H)) := by
    intro a ha
    obtain ⟨x, hx, hxa⟩ := Set.mem_star.mp ha
    exact ⟨star x, star_mem hx, by simpa [star_rTensorCompletion] using congrArg star hxa⟩
  have hstar_N : star (lTensorCompletion H '' (N : Set (K →L[ℂ] K))) ⊆
      lTensorCompletion H '' (N : Set (K →L[ℂ] K)) := by
    intro a ha
    obtain ⟨y, hy, hya⟩ := Set.mem_star.mp ha
    exact ⟨star y, star_mem hy, by simpa [star_lTensorCompletion] using congrArg star hya⟩
  have hstar :
      star (rTensorCompletion K '' (M : Set (H →L[ℂ] H)) ∪
          lTensorCompletion H '' (N : Set (K →L[ℂ] K))) ⊆
        rTensorCompletion K '' (M : Set (H →L[ℂ] H)) ∪
          lTensorCompletion H '' (N : Set (K →L[ℂ] K)) := by
    rw [Set.union_star]
    exact Set.union_subset_union hstar_M hstar_N
  refine spatialTensor_le_iff.mpr ⟨fun a ha ↦ ?_, fun b hb ↦ ?_⟩
  · rw [← SetLike.mem_coe, spatialTensor, coe_commutant_adjoin, Set.union_eq_left.mpr hstar]
    rintro _ (⟨m, hm, rfl⟩ | ⟨n, _, rfl⟩)
    · simpa only [rTensorCompletion_mul] using congrArg (rTensorCompletion K)
        ((mem_commutant_iff.mp ha) m hm)
    · exact (commute_rTensorCompletion_lTensorCompletion a n).symm
  · rw [← SetLike.mem_coe, spatialTensor, coe_commutant_adjoin, Set.union_eq_left.mpr hstar]
    rintro _ (⟨m, _, rfl⟩ | ⟨n, hn, rfl⟩)
    · exact commute_rTensorCompletion_lTensorCompletion m b
    · simpa only [lTensorCompletion_mul] using congrArg (lTensorCompletion H)
        ((mem_commutant_iff.mp hb) n hn)

omit [CompleteSpace K] in
private theorem opSliceRight_smul_left (c : ℂ) (η₁ η₂ : K)
    (X : Completion (H ⊗[ℂ] K) →L[ℂ] Completion (H ⊗[ℂ] K)) :
    opSliceRight (c • η₁) η₂ X = c • opSliceRight η₁ η₂ X := by
  ext ξ₁
  refine ext_inner_left ℂ fun ξ₂ ↦ ?_
  simp [tmul_smul, inner_smul_right]

omit [CompleteSpace K] in
private theorem opSliceRight_smul_right (c : ℂ) (η₁ η₂ : K)
    (X : Completion (H ⊗[ℂ] K) →L[ℂ] Completion (H ⊗[ℂ] K)) :
    opSliceRight η₁ (c • η₂) X = star c • opSliceRight η₁ η₂ X := by
  ext ξ₁
  refine ext_inner_left ℂ fun ξ₂ ↦ ?_
  simp [tmul_smul, inner_smul_left, inner_smul_right]

/-- An operator on `Completion (H ⊗[ℂ] K)` commutes with every `1 ⊗ y` (`y : K →L[ℂ] K`) if and only
if it has the form `x ⊗ 1` for some `x : H →L[ℂ] H`. Holds unconditionally (including `K = 0`). -/
theorem mem_centralizer_lTensorCompletion_univ_iff
    {X : Completion (H ⊗[ℂ] K) →L[ℂ] Completion (H ⊗[ℂ] K)} :
    (∀ y : K →L[ℂ] K, y.lTensorCompletion H * X = X * y.lTensorCompletion H) ↔
      X ∈ Set.range (rTensorCompletion K : (H →L[ℂ] H) → _) := by
  refine ⟨fun hcomm ↦ ?_, ?_⟩
  · rcases subsingleton_or_nontrivial K with _ | _
    · have := subsingleton_completion_of_subsingleton_right (𝕜 := ℂ) (E := H) (F := K)
      exact ⟨0, Subsingleton.elim _ _⟩
    obtain ⟨v, hv⟩ := exists_ne (0 : K)
    have hc : ⟪v, v⟫_ℂ ≠ 0 := inner_self_ne_zero.mpr hv
    refine ⟨(⟪v, v⟫_ℂ)⁻¹ • opSliceRight v v X, ext_opSliceRight.mpr fun η₁ η₂ ↦ ?_⟩
    let z : K →L[ℂ] K := InnerProductSpace.rankOne ℂ η₁ v
    have hz := congrArg (opSliceRight v η₂) (hcomm z)
    rw [mul_def, mul_def, opSliceRight_lTensorCompletion_comp, opSliceRight_comp_lTensorCompletion,
      InnerProductSpace.adjoint_rankOne, InnerProductSpace.rankOne_apply,
      InnerProductSpace.rankOne_apply, opSliceRight_smul_right, opSliceRight_smul_left] at hz
    have hconj : (star ⟪η₁, η₂⟫_ℂ : ℂ) = ⟪η₂, η₁⟫_ℂ := inner_conj_symm η₂ η₁
    rw [hconj] at hz
    rw [opSliceRight_rTensorCompletion, smul_comm, hz, smul_smul, inv_mul_cancel₀ hc, one_smul]
  · rintro ⟨x, rfl⟩ y
    exact (commute_rTensorCompletion_lTensorCompletion x y).symm

/-- Unconditional carrier identification `(spatialTensor M ⊥ : Set _) = (· ⊗ 1) '' M`. -/
@[simp]
theorem coe_spatialTensor_bot_right (M : VonNeumannAlgebra H) :
    SetLike.coe (spatialTensor (M : Set (H →L[ℂ] H))
      ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K))) =
      rTensorCompletion K '' (M : Set (H →L[ℂ] H)) := by
  refine Set.Subset.antisymm (fun X hX ↦ ?_)
    (Set.image_subset_iff.mpr fun x hx ↦ rTensorCompletion_mem_spatialTensor hx)
  have h1 : spatialTensor ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) ≤
      (spatialTensor (M : Set (H →L[ℂ] H))
        ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K))).commutant :=
    (spatialTensor_mono (SetLike.coe_subset_coe.mpr bot_le)
      (by simp [commutant_bot])).trans (spatialTensor_commutant_le M (⊥ : VonNeumannAlgebra K))
  have hcomm : ∀ y : K →L[ℂ] K, y.lTensorCompletion H * X = X * y.lTensorCompletion H := fun y ↦ by
    have hy : y.lTensorCompletion H ∈
        (spatialTensor (M : Set (H →L[ℂ] H))
          ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K))).commutant :=
      h1 (lTensorCompletion_mem_spatialTensor (mem_top (x := y)))
    exact ((mem_commutant_iff.mp hy) X hX).symm
  obtain ⟨x, rfl⟩ := mem_centralizer_lTensorCompletion_univ_iff.mp hcomm
  rcases subsingleton_or_nontrivial K with _ | _
  · have := subsingleton_completion_of_subsingleton_right (𝕜 := ℂ) (E := H) (F := K)
    exact ⟨0, zero_mem M, Subsingleton.elim _ _⟩
  · have hx : x ∈ (spatialTensor (M : Set (H →L[ℂ] H))
        ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K))).comapRTensorCompletion K :=
      mem_comapRTensorCompletion.mpr hX
    rw [comapRTensorCompletion_spatialTensor] at hx
    exact ⟨x, hx, rfl⟩

/-- Unconditional carrier identification `(spatialTensor ⊥ N : Set _) = (1 ⊗ ·) '' N`. -/
@[simp]
theorem coe_spatialTensor_bot_left (N : VonNeumannAlgebra K) :
    SetLike.coe (spatialTensor ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      (N : Set (K →L[ℂ] K))) =
      lTensorCompletion H '' (N : Set (K →L[ℂ] K)) := by
  refine Set.Subset.antisymm (fun X hX ↦ ?_)
    (Set.image_subset_iff.mpr fun y hy ↦ lTensorCompletion_mem_spatialTensor hy)
  have hX' : (commIsometry ℂ H K).completion.conjStarAlgEquiv X ∈
      spatialTensor (N : Set (K →L[ℂ] K)) ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) := by
    rw [← mapLinearIsometryEquiv_comm_spatialTensor]
    exact ⟨X, hX, rfl⟩
  rw [← SetLike.mem_coe, coe_spatialTensor_bot_right] at hX'
  obtain ⟨y, hy, hyX⟩ := hX'
  refine ⟨y, hy, ?_⟩
  have hsymm := congrArg (commIsometry ℂ H K).completion.conjStarAlgEquiv.symm hyX
  rw [StarAlgEquiv.symm_apply_apply, LinearIsometryEquiv.symm_conjStarAlgEquiv,
    LinearIsometryEquiv.conjStarAlgEquiv_apply, LinearIsometryEquiv.symm_symm,
    LinearIsometryEquiv.completion_symm, commIsometry_symm,
    commIsometry_completion_comp_rTensorCompletion_comp_commIsometry_completion] at hsymm
  exact hsymm

/-- **Commutation theorem with `⊤ = B(K)` on the right:**
`(spatialTensor M ⊤)' = spatialTensor M' ⊥`. -/
theorem commutant_spatialTensor_top_right (M : VonNeumannAlgebra H) :
    (spatialTensor (M : Set (H →L[ℂ] H))
      ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K))).commutant =
      spatialTensor (M.commutant : Set (H →L[ℂ] H))
        ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) := by
  refine le_antisymm (fun X hX ↦ ?_) ?_
  · have hcomm_K : ∀ y : K →L[ℂ] K, y.lTensorCompletion H * X = X * y.lTensorCompletion H :=
      fun y ↦ (mem_commutant_iff.mp hX) _ (lTensorCompletion_mem_spatialTensor (mem_top (x := y)))
    obtain ⟨x, rfl⟩ := mem_centralizer_lTensorCompletion_univ_iff.mp hcomm_K
    rcases subsingleton_or_nontrivial K with _ | _
    · have := subsingleton_completion_of_subsingleton_right (𝕜 := ℂ) (E := H) (F := K)
      simp
    · refine rTensorCompletion_mem_spatialTensor (mem_commutant_iff.mpr fun m hm ↦ ?_)
      have hmx : m.rTensorCompletion K * x.rTensorCompletion K =
          x.rTensorCompletion K * m.rTensorCompletion K :=
        (mem_commutant_iff.mp hX) _ (rTensorCompletion_mem_spatialTensor hm)
      exact rTensorCompletion_injective (𝕜 := ℂ) (E := H) (F := H) (G := K) <| by
        simpa only [← rTensorCompletion_mul] using hmx
  · simpa [commutant_top] using spatialTensor_commutant_le M (⊤ : VonNeumannAlgebra K)

/-- **Commutation theorem with `⊥ = ℂ • 1` on the right:**
`(spatialTensor M ⊥)' = spatialTensor M' ⊤`. -/
@[simp]
theorem commutant_spatialTensor_bot_right (M : VonNeumannAlgebra H) :
    (spatialTensor (M : Set (H →L[ℂ] H))
      ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K))).commutant =
      spatialTensor (M.commutant : Set (H →L[ℂ] H))
        ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) := by
  simpa only [commutant_commutant] using
    congrArg commutant (commutant_spatialTensor_top_right (K := K) M.commutant).symm

/-- **Commutation theorem with `⊤ = B(H)` on the left:**
`(spatialTensor ⊤ N)' = spatialTensor ⊥ N'`. -/
theorem commutant_spatialTensor_top_left (N : VonNeumannAlgebra K) :
    (spatialTensor ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      (N : Set (K →L[ℂ] K))).commutant =
      spatialTensor ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
        (N.commutant : Set (K →L[ℂ] K)) := by
  have h := congrArg (mapLinearIsometryEquiv (commIsometry ℂ K H).completion)
    (commutant_spatialTensor_top_right (H := K) (K := H) N)
  rwa [mapLinearIsometryEquiv_commutant, mapLinearIsometryEquiv_comm_spatialTensor,
    mapLinearIsometryEquiv_comm_spatialTensor] at h

/-- **Commutation theorem with `⊥ = ℂ • 1` on the left:**
`(spatialTensor ⊥ N)' = spatialTensor ⊤ N'`. -/
@[simp]
theorem commutant_spatialTensor_bot_left (N : VonNeumannAlgebra K) :
    (spatialTensor ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      (N : Set (K →L[ℂ] K))).commutant =
      spatialTensor ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
        (N.commutant : Set (K →L[ℂ] K)) := by
  simpa only [commutant_commutant] using
    congrArg commutant (commutant_spatialTensor_top_left (H := H) N.commutant).symm

theorem spatialTensor_top_top :
    spatialTensor ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) = ⊤ := by
  rw [← commutant_eq_bot_iff, commutant_spatialTensor_top_right, commutant_top,
    spatialTensor_bot_bot]

private theorem opSliceRight_mem_comapRTensorCompletion_of_le [Nontrivial K]
    {R : VonNeumannAlgebra (Completion (H ⊗[ℂ] K))}
    (hR : spatialTensor ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) ≤ R)
    {X : Completion (H ⊗[ℂ] K) →L[ℂ] Completion (H ⊗[ℂ] K)} (hX : X ∈ R) (η₁ η₂ : K) :
    opSliceRight η₁ η₂ X ∈ R.comapRTensorCompletion K := by
  obtain ⟨v, hv⟩ := exists_ne (0 : K)
  have hvv : ⟪v, v⟫_ℂ ≠ 0 := inner_self_ne_zero.mpr hv
  rw [mem_comapRTensorCompletion, ← R.commutant_commutant, mem_commutant_iff]
  intro Y hY
  have hY_mem : Y ∈ spatialTensor ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) := by
    rw [← commutant_top (H := K), ← commutant_spatialTensor_bot_left]
    exact commutant_le_commutant hR hY
  rw [← SetLike.mem_coe, coe_spatialTensor_bot_right] at hY_mem
  obtain ⟨d, _, rfl⟩ := hY_mem
  have hrank : (InnerProductSpace.rankOne ℂ v η₂).lTensorCompletion H =
      embedRight v ∘L sliceRight η₂ :=
    completion_continuousLinearMap_ext fun a b ↦ by
      simp [InnerProductSpace.rankOne_apply, tmul_smul]
  have hsand : (InnerProductSpace.rankOne ℂ v η₂).lTensorCompletion H * X *
      (InnerProductSpace.rankOne ℂ η₁ v).lTensorCompletion H =
      mapLCompletion (opSliceRight η₁ η₂ X) (InnerProductSpace.rankOne ℂ v v) :=
    completion_continuousLinearMap_ext fun ξ w ↦ by
      simp [mul_def, hrank, opSliceRight_apply_apply, InnerProductSpace.rankOne_apply, tmul_smul]
  have hsand_mem : mapLCompletion (opSliceRight η₁ η₂ X) (InnerProductSpace.rankOne ℂ v v) ∈ R := by
    rw [← hsand]
    exact mul_mem
      (mul_mem (hR (lTensorCompletion_mem_spatialTensor (mem_top (x := _)))) hX)
      (hR (lTensorCompletion_mem_spatialTensor (mem_top (x := _))))
  have hd_comm := congrArg (opSliceRight v v) ((mem_commutant_iff.mp hY) _ hsand_mem)
  simp only [mul_def, rTensorCompletion_comp_mapLCompletion,
    mapLCompletion_comp_rTensorCompletion, opSliceRight_mapLCompletion,
    InnerProductSpace.rankOne_apply, inner_smul_right] at hd_comm
  have hd_eq : opSliceRight η₁ η₂ X ∘L d = d ∘L opSliceRight η₁ η₂ X :=
    smul_right_injective (H →L[ℂ] H) (mul_ne_zero hvv hvv) hd_comm
  simpa only [mul_def, rTensorCompletion_comp] using congrArg (rTensorCompletion K) hd_eq.symm

/-- **Tensor splitting over `⊤ = B(K)` on the right.** Every von Neumann algebra `R` on
`Completion (H ⊗[ℂ] K)` containing `spatialTensor ⊥ ⊤ = 1 ⊗ B(K)` splits as
`spatialTensor (R.comapRTensorCompletion K) ⊤`. -/
theorem eq_spatialTensor_top_right_of_le {R : VonNeumannAlgebra (Completion (H ⊗[ℂ] K))}
    (hR : spatialTensor ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) ≤ R) :
    R = spatialTensor ((R.comapRTensorCompletion K) : Set (H →L[ℂ] H))
      ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) := by
  refine le_antisymm ?_ (spatialTensor_le_iff.mpr
    ⟨fun x hx ↦ mem_comapRTensorCompletion.mp hx,
      fun y hy ↦ hR (lTensorCompletion_mem_spatialTensor hy)⟩)
  rw [← commutant_le_commutant_iff, commutant_spatialTensor_top_right]
  refine spatialTensor_le_iff.mpr ⟨fun b hb ↦ ?_, fun c hc ↦ ?_⟩
  · rcases subsingleton_or_nontrivial K with _ | _
    · have := subsingleton_completion_of_subsingleton_right (𝕜 := ℂ) (E := H) (F := K)
      simp
    refine mem_commutant_iff.mpr fun X hX ↦ ext_opSliceRight.mpr fun η₁ η₂ ↦ ?_
    simpa only [mul_def, opSliceRight_rTensorCompletion_comp,
      opSliceRight_comp_rTensorCompletion] using
      (mem_commutant_iff.mp hb) _ (opSliceRight_mem_comapRTensorCompletion_of_le hR hX η₁ η₂)
  · obtain ⟨z, rfl⟩ := mem_bot.mp hc
    exact SetLike.coe_subset_coe.mpr bot_le
      (mem_bot.mpr ⟨z, by simp [Algebra.algebraMap_eq_smul_one]⟩)

/-- **Tensor splitting over `⊤ = B(H)` on the left.** Every von Neumann algebra `R` on
`Completion (H ⊗[ℂ] K)` containing `spatialTensor ⊤ ⊥ = B(H) ⊗ 1` splits as
`spatialTensor ⊤ (R.comapLTensorCompletion H)`. -/
theorem eq_spatialTensor_top_left_of_le {R : VonNeumannAlgebra (Completion (H ⊗[ℂ] K))}
    (hR : spatialTensor ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) ≤ R) :
    R = spatialTensor ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((R.comapLTensorCompletion H) : Set (K →L[ℂ] K)) := by
  let e := (commIsometry ℂ H K).completion
  let R' := mapLinearIsometryEquiv e R
  have hR' : spatialTensor ((⊥ : VonNeumannAlgebra K) : Set (K →L[ℂ] K))
      ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) ≤ R' := by
    rw [← mapLinearIsometryEquiv_comm_spatialTensor]
    exact (mapLinearIsometryEquiv e).monotone hR
  have hsplit := eq_spatialTensor_top_right_of_le hR'
  have hcomap : R'.comapRTensorCompletion H = R.comapLTensorCompletion H := by
    ext y
    have hconj : e.symm.conjStarAlgEquiv (y.rTensorCompletion H) = y.lTensorCompletion H := by
      rw [LinearIsometryEquiv.conjStarAlgEquiv_apply, LinearIsometryEquiv.symm_symm]
      change ((commIsometry ℂ H K).completion.symm :
          Completion (K ⊗[ℂ] H) →L[ℂ] Completion (H ⊗[ℂ] K)) ∘L y.rTensorCompletion H ∘L
        ((commIsometry ℂ H K).completion :
          Completion (H ⊗[ℂ] K) →L[ℂ] Completion (K ⊗[ℂ] H)) = y.lTensorCompletion H
      rw [LinearIsometryEquiv.completion_symm, commIsometry_symm]
      exact commIsometry_completion_comp_rTensorCompletion_comp_commIsometry_completion y
    simp only [mem_comapRTensorCompletion, mem_comapLTensorCompletion, R',
      mem_mapLinearIsometryEquiv, hconj]
  have hback := congrArg (mapLinearIsometryEquiv e).symm hsplit
  rw [OrderIso.symm_apply_apply, symm_mapLinearIsometryEquiv, hcomap] at hback
  have he_symm : e.symm = (commIsometry ℂ K H).completion := by
    change (commIsometry ℂ H K).completion.symm = (commIsometry ℂ K H).completion
    rw [LinearIsometryEquiv.completion_symm, commIsometry_symm]
  rwa [he_symm, mapLinearIsometryEquiv_comm_spatialTensor] at hback

/-- **Factoriality of spatial tensor products.** If `M` and `N` have trivial center (`M ⊓ M' = ⊥`
and `N ⊓ N' = ⊥`), then `spatialTensor M N` also has trivial center. -/
theorem spatialTensor_inf_commutant_eq_bot {M : VonNeumannAlgebra H} {N : VonNeumannAlgebra K}
    (hM : M ⊓ M.commutant = ⊥) (hN : N ⊓ N.commutant = ⊥) :
    spatialTensor (M : Set (H →L[ℂ] H)) (N : Set (K →L[ℂ] K)) ⊓
        (spatialTensor (M : Set (H →L[ℂ] H)) (N : Set (K →L[ℂ] K))).commutant = ⊥ := by
  refine eq_bot_iff.mpr fun X hX ↦ ?_
  obtain ⟨hX₁, hX₂⟩ := mem_inf.mp hX
  have hX_bot_top : X ∈ spatialTensor ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H))
      ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) := by
    rw [← commutant_bot (H := K), ← commutant_spatialTensor_top_left, mem_commutant_iff]
    intro Z hZ
    rw [← SetLike.mem_coe, coe_spatialTensor_bot_right] at hZ
    obtain ⟨a, _, rfl⟩ := hZ
    refine ext_opSliceRight.mpr fun η₁ η₂ ↦ ?_
    have hX₂' : X ∈ spatialTensor (M.commutant : Set (H →L[ℂ] H))
        ((⊤ : VonNeumannAlgebra K) : Set (K →L[ℂ] K)) := by
      rw [← commutant_spatialTensor_bot_right]
      exact commutant_le_commutant
        (spatialTensor_mono Set.Subset.rfl (SetLike.coe_subset_coe.mpr bot_le)) hX₂
    have hsl_bot : opSliceRight η₁ η₂ X ∈ (⊥ : VonNeumannAlgebra H) := hM ▸ mem_inf.mpr
      ⟨opSliceRight_mem_of_mem_spatialTensor η₁ η₂ hX₁,
        opSliceRight_mem_of_mem_spatialTensor η₁ η₂ hX₂'⟩
    obtain ⟨c, hc⟩ := mem_bot.mp hsl_bot
    simpa only [mul_def, opSliceRight_rTensorCompletion_comp,
      opSliceRight_comp_rTensorCompletion, ← hc] using (Algebra.commutes c a).symm
  rw [← SetLike.mem_coe, coe_spatialTensor_bot_left] at hX_bot_top
  obtain ⟨y, _, rfl⟩ := hX_bot_top
  rcases subsingleton_or_nontrivial H with _ | _
  · have := subsingleton_completion_of_subsingleton_left (𝕜 := ℂ) (E := H) (F := K)
    simp
  have hy₁ : y ∈ N := by
    rw [← comapLTensorCompletion_spatialTensor (E := H) (M : Set (H →L[ℂ] H)) N,
      mem_comapLTensorCompletion]
    exact hX₁
  have hy₂ : y ∈ N.commutant := by
    rw [← comapLTensorCompletion_spatialTensor (E := H)
      ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) N.commutant, mem_comapLTensorCompletion,
      ← commutant_spatialTensor_bot_left]
    exact commutant_le_commutant
      (spatialTensor_mono (SetLike.coe_subset_coe.mpr bot_le) Set.Subset.rfl) hX₂
  obtain ⟨c, rfl⟩ := mem_bot.mp (hN ▸ mem_inf.mpr ⟨hy₁, hy₂⟩)
  rw [mem_bot]
  exact ⟨c, by simp [Algebra.algebraMap_eq_smul_one]⟩

end SliceAndCommutants

