module

public import TauCeti.Analysis.InnerProductSpace.TensorProduct.Completion
public import TauCeti.Analysis.VonNeumannAlgebra.Factor

/-!
# Spatial tensor products of von Neumann algebras

Given sets of bounded operators `A ⊆ B(E)` and `B ⊆ B(F)` on complex inner product spaces `E` and
`F`, their **spatial tensor product** `VonNeumannAlgebra.spatialTensor A B` is the von Neumann
algebra on `UniformSpace.Completion (E ⊗[ℂ] F)` generated by `x ⊗ 1` (`x ∈ A`) and `1 ⊗ y`
(`y ∈ B`). Taking raw operator sets on not-necessarily-complete inner product spaces lets iterated
spatial tensor products and pre-Hilbert completions share a single definition: by
`spatialTensor_adjoin_left` and `spatialTensor_adjoin_right`, `spatialTensor A B` depends only on
the generated von Neumann algebras, so concrete algebras `M : VonNeumannAlgebra E` and
`N : VonNeumannAlgebra F` pass via set coercion `(M : Set (E →L[ℂ] E))` and `(N : Set (F →L[ℂ] F))`.

Main results: factor embeddings `inlSpatialTensor` / `inrSpatialTensor` with no passive
completeness and sharp injectivity / isometry characterizations (`inlSpatialTensor_injective_iff`,
`isometry_inlSpatialTensor_iff`); slice invariance (`sliceRight_mem_of_mem_spatialTensor`,
`sliceLeft_mem_of_mem_spatialTensor`), pure-amplification membership
(`rTensorCompletion_mem_spatialTensor_iff`), flip symmetry, scalar units, and associativity along
`TensorProduct.assocIsometryCompletion`; `B(K)` commutation (`commutant_spatialTensor_top_right`,
`commutant_spatialTensor_bot_right`), equivalences `inlSpatialTensorBotEquiv` /
`inrSpatialTensorBotEquiv`, unique splitting (`spatialTensor_bot_top_le_iff_existsUnique`), and
center and factoriality theorems (`spatialTensor_inf_commutant_eq_bot`,
`spatialTensor_inf_commutant_eq_bot_iff`, `IsFactor.spatialTensor`, `isFactor_spatialTensor_iff`).

## References

* F. J. Murray and J. von Neumann, *On rings of operators. IV*, Ann. of Math. (2) **44** (1943).
* J. Dixmier, *Von Neumann Algebras*, North-Holland, 1981, Part I, Chapter 2.
* M. Takesaki, *Theory of Operator Algebras I*, Springer, 2002, Chapter IV, §1 and §5.
* R. V. Kadison and J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras*, Vol. II, §11.
-/

public section
open scoped Pointwise TensorProduct InnerProductSpace
open UniformSpace TensorProduct

namespace VonNeumannAlgebra
/-! ### Definition, basic lattice laws, and flip symmetry of the spatial tensor product -/
section SpatialTensorBasic
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
/-- The **spatial tensor product** `spatialTensor A B` of two sets of bounded operators `A ⊆ B(E)`
and `B ⊆ B(F)`: the von Neumann algebra on `Completion (E ⊗[ℂ] F)` generated by
`x.rTensorCompletion F` (`x ∈ A`) and `y.lTensorCompletion E` (`y ∈ B`). -/
noncomputable def spatialTensor (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    VonNeumannAlgebra (Completion (E ⊗[ℂ] F)) :=
  adjoin (ContinuousLinearMap.rTensorCompletion F '' A ∪
    ContinuousLinearMap.lTensorCompletion E '' B)
theorem spatialTensor_def (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor A B = adjoin (ContinuousLinearMap.rTensorCompletion F '' A ∪
      ContinuousLinearMap.lTensorCompletion E '' B) := (rfl)
theorem rTensorCompletion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {x : E →L[ℂ] E} (hx : x ∈ A) : x.rTensorCompletion F ∈ spatialTensor A B :=
  subset_adjoin _ (Or.inl ⟨x, hx, rfl⟩)
theorem lTensorCompletion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {y : F →L[ℂ] F} (hy : y ∈ B) : y.lTensorCompletion E ∈ spatialTensor A B :=
  subset_adjoin _ (Or.inr ⟨y, hy, rfl⟩)
theorem mapLCompletion_mem_spatialTensor {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {x : E →L[ℂ] E} {y : F →L[ℂ] F} (hx : x ∈ A) (hy : y ∈ B) :
    TensorProduct.mapLCompletion x y ∈ spatialTensor A B := by
  rw [← ContinuousLinearMap.rTensorCompletion_comp_lTensorCompletion, ← ContinuousLinearMap.mul_def]
  exact mul_mem (rTensorCompletion_mem_spatialTensor hx) (lTensorCompletion_mem_spatialTensor hy)
@[simp] theorem spatialTensor_le_iff {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)}
    {P : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))} :
    spatialTensor A B ≤ P ↔
      (∀ x ∈ A, x.rTensorCompletion F ∈ P) ∧ ∀ y ∈ B, y.lTensorCompletion E ∈ P := by
  simp [spatialTensor_def, Set.image_subset_iff]; simp [Set.subset_def]
theorem spatialTensor_mono {A₁ A₂ : Set (E →L[ℂ] E)} {B₁ B₂ : Set (F →L[ℂ] F)}
    (hA : A₁ ⊆ A₂) (hB : B₁ ⊆ B₂) : spatialTensor A₁ B₁ ≤ spatialTensor A₂ B₂ :=
  spatialTensor_le_iff.2 ⟨fun _ hx ↦ rTensorCompletion_mem_spatialTensor (hA hx),
    fun _ hy ↦ lTensorCompletion_mem_spatialTensor (hB hy)⟩
@[simp] theorem spatialTensor_empty_empty :
    spatialTensor (∅ : Set (E →L[ℂ] E)) (∅ : Set (F →L[ℂ] F)) = ⊥ := by simp [spatialTensor_def]
theorem spatialTensor_eq_sup (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor A B = spatialTensor A ∅ ⊔ spatialTensor ∅ B := by
  simp [spatialTensor_def, adjoin_union]
theorem spatialTensor_union_left (A₁ A₂ : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor (A₁ ∪ A₂) B = spatialTensor A₁ B ⊔ spatialTensor A₂ B := by
  simp [spatialTensor_def, Set.image_union, adjoin_union, sup_sup_distrib_right]
theorem spatialTensor_union_right (A : Set (E →L[ℂ] E)) (B₁ B₂ : Set (F →L[ℂ] F)) :
    spatialTensor A (B₁ ∪ B₂) = spatialTensor A B₁ ⊔ spatialTensor A B₂ := by
  simp [spatialTensor_def, Set.image_union, adjoin_union, sup_sup_distrib_left]
/-- **Flip symmetry** of the spatial tensor product along `(commIsometry ℂ E F).completion`. -/
@[simp] theorem mapLinearIsometryEquiv_commIsometry_spatialTensor
    (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    mapLinearIsometryEquiv (commIsometry ℂ E F).completion (spatialTensor A B) =
      spatialTensor B A := by
  rw [spatialTensor_def, spatialTensor_def, mapLinearIsometryEquiv_adjoin, Set.image_union,
    Set.image_image, Set.image_image, Set.union_comm]; simp
@[simp] theorem spatialTensor_bot_left [CompleteSpace E] (B : Set (F →L[ℂ] F)) :
    spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) B = spatialTensor ∅ B := by
  refine le_antisymm (spatialTensor_le_iff.2 ⟨?_, fun _ ↦ lTensorCompletion_mem_spatialTensor⟩)
    (spatialTensor_mono (Set.empty_subset _) Set.Subset.rfl)
  rintro _ hx; obtain ⟨c, rfl⟩ := mem_bot.1 hx
  simpa [Algebra.algebraMap_eq_smul_one] using algebraMap_mem (spatialTensor (E := E) ∅ B) c
@[simp] theorem spatialTensor_bot_right [CompleteSpace F] (A : Set (E →L[ℂ] E)) :
    spatialTensor A ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) = spatialTensor A ∅ := by
  apply (mapLinearIsometryEquiv (commIsometry ℂ E F).completion).injective; simp
theorem spatialTensor_bot_bot [CompleteSpace E] [CompleteSpace F] :
    spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
      ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) = ⊥ := by simp
end SpatialTensorBasic

/-! ### Canonical factor embeddings -/
section FactorEmbeddings
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
/-- Left factor unital `⋆`-algebra homomorphism `x ↦ x ⊗ 1` into `spatialTensor M B`, requiring
completeness only on `E`. -/
noncomputable def inlSpatialTensor [CompleteSpace E] (M : VonNeumannAlgebra E)
    (B : Set (F →L[ℂ] F)) : M →⋆ₐ[ℂ] spatialTensor (M : Set (E →L[ℂ] E)) B :=
  ((ContinuousLinearMap.rTensorCompletionStarAlgHom ℂ E F).comp
    M.toStarSubalgebra.subtype).codRestrict _ fun x ↦ by
      simpa using rTensorCompletion_mem_spatialTensor (B := B) x.property
/-- Right factor unital `⋆`-algebra homomorphism `y ↦ 1 ⊗ y` into `spatialTensor A N`, requiring
completeness only on `F`. -/
noncomputable def inrSpatialTensor [CompleteSpace F] (A : Set (E →L[ℂ] E))
    (N : VonNeumannAlgebra F) : N →⋆ₐ[ℂ] spatialTensor A (N : Set (F →L[ℂ] F)) :=
  ((ContinuousLinearMap.lTensorCompletionStarAlgHom ℂ E F).comp
    N.toStarSubalgebra.subtype).codRestrict _ fun y ↦ by
      simpa using lTensorCompletion_mem_spatialTensor (A := A) y.property
@[simp, norm_cast] theorem coe_inlSpatialTensor [CompleteSpace E] (M : VonNeumannAlgebra E)
    (B : Set (F →L[ℂ] F)) (x : M) :
    (inlSpatialTensor M B x : _ →L[ℂ] _) = (x : E →L[ℂ] E).rTensorCompletion F :=
  ContinuousLinearMap.rTensorCompletionStarAlgHom_apply (x : E →L[ℂ] E)
@[simp, norm_cast] theorem coe_inrSpatialTensor [CompleteSpace F] (A : Set (E →L[ℂ] E))
    (N : VonNeumannAlgebra F) (y : N) :
    (inrSpatialTensor A N y : _ →L[ℂ] _) = (y : F →L[ℂ] F).lTensorCompletion E :=
  ContinuousLinearMap.lTensorCompletionStarAlgHom_apply (y : F →L[ℂ] F)
/-- Elements embedded from the two factors commute in `spatialTensor M N`. -/
theorem commute_inlSpatialTensor_inrSpatialTensor [CompleteSpace E] [CompleteSpace F]
    (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) (x : M) (y : N) :
    Commute (inlSpatialTensor M (N : Set (F →L[ℂ] F)) x)
      (inrSpatialTensor (M : Set (E →L[ℂ] E)) N y) :=
  Subtype.ext <| by
    simpa using (ContinuousLinearMap.commute_rTensorCompletion_lTensorCompletion x.val y.val).eq
theorem norm_inlSpatialTensor_le [CompleteSpace E] (M : VonNeumannAlgebra E) (B : Set (F →L[ℂ] F))
    (x : M) : ‖inlSpatialTensor M B x‖ ≤ ‖x‖ :=
  (congrArg norm (coe_inlSpatialTensor M B x)).trans_le x.val.norm_rTensorCompletion_le
theorem norm_inrSpatialTensor_le [CompleteSpace F] (A : Set (E →L[ℂ] E)) (N : VonNeumannAlgebra F)
    (y : N) : ‖inrSpatialTensor A N y‖ ≤ ‖y‖ :=
  (congrArg norm (coe_inrSpatialTensor A N y)).trans_le y.val.norm_lTensorCompletion_le
theorem norm_inlSpatialTensor [CompleteSpace E] [Nontrivial F] (M : VonNeumannAlgebra E)
    (B : Set (F →L[ℂ] F)) (x : M) : ‖inlSpatialTensor M B x‖ = ‖x‖ := by simp
theorem norm_inrSpatialTensor [CompleteSpace F] [Nontrivial E] (A : Set (E →L[ℂ] E))
    (N : VonNeumannAlgebra F) (y : N) : ‖inrSpatialTensor A N y‖ = ‖y‖ := by simp
@[simp] theorem inlSpatialTensor_eq_zero [CompleteSpace E] [Subsingleton F]
    (M : VonNeumannAlgebra E) (B : Set (F →L[ℂ] F)) (x : M) : inlSpatialTensor M B x = 0 :=
  Subtype.ext <| by simp [ContinuousLinearMap.rTensorCompletion_of_subsingleton]
@[simp] theorem inrSpatialTensor_eq_zero [CompleteSpace F] [Subsingleton E]
    (A : Set (E →L[ℂ] E)) (N : VonNeumannAlgebra F) (y : N) : inrSpatialTensor A N y = 0 :=
  Subtype.ext <| by simp [ContinuousLinearMap.lTensorCompletion_of_subsingleton]
theorem inlSpatialTensor_injective [CompleteSpace E] [Nontrivial F] (M : VonNeumannAlgebra E)
    (B : Set (F →L[ℂ] F)) : Function.Injective (inlSpatialTensor M B) := fun _ _ h ↦ by
  simpa using congrArg Subtype.val h
theorem inrSpatialTensor_injective [CompleteSpace F] [Nontrivial E] (A : Set (E →L[ℂ] E))
    (N : VonNeumannAlgebra F) : Function.Injective (inrSpatialTensor A N) := fun _ _ h ↦ by
  simpa using congrArg Subtype.val h
/-- `inlSpatialTensor M B` is injective iff `F` is nontrivial or `E` is subsingleton. -/
theorem inlSpatialTensor_injective_iff [CompleteSpace E] (M : VonNeumannAlgebra E)
    (B : Set (F →L[ℂ] F)) :
    Function.Injective (inlSpatialTensor M B) ↔ Nontrivial F ∨ Subsingleton E := by
  refine ⟨fun hinj ↦ or_iff_not_imp_left.2 fun hF ↦ ?_, fun h ↦ h.elim
    (fun _ ↦ inlSpatialTensor_injective M B) fun hE ↦ ?_⟩
  · rw [not_nontrivial_iff_subsingleton] at hF; exact (subsingleton_coe_iff M).1 hinj.subsingleton
  · have := (subsingleton_coe_iff M).2 hE; exact Function.injective_of_subsingleton _
/-- `inrSpatialTensor A N` is injective iff `E` is nontrivial or `F` is subsingleton. -/
theorem inrSpatialTensor_injective_iff [CompleteSpace F] (A : Set (E →L[ℂ] E))
    (N : VonNeumannAlgebra F) :
    Function.Injective (inrSpatialTensor A N) ↔ Nontrivial E ∨ Subsingleton F := by
  refine ⟨fun hinj ↦ or_iff_not_imp_left.2 fun hE ↦ ?_, fun h ↦ h.elim
    (fun _ ↦ inrSpatialTensor_injective A N) fun hF ↦ ?_⟩
  · rw [not_nontrivial_iff_subsingleton] at hE; exact (subsingleton_coe_iff N).1 hinj.subsingleton
  · have := (subsingleton_coe_iff N).2 hF; exact Function.injective_of_subsingleton _
/-- `inlSpatialTensor M B` is an isometry iff `F` is nontrivial or `E` is subsingleton. -/
theorem isometry_inlSpatialTensor_iff [CompleteSpace E] (M : VonNeumannAlgebra E)
    (B : Set (F →L[ℂ] F)) :
    Isometry (inlSpatialTensor M B) ↔ Nontrivial F ∨ Subsingleton E := by
  refine ⟨fun h ↦ (inlSpatialTensor_injective_iff M B).1 h.injective, fun h ↦ h.elim
    (fun _ ↦ AddMonoidHomClass.isometry_of_norm _ (norm_inlSpatialTensor M B)) fun hE ↦ ?_⟩
  have := (subsingleton_coe_iff M).2 hE; exact fun x y ↦ by simp [Subsingleton.elim x y]
/-- `inrSpatialTensor A N` is an isometry iff `E` is nontrivial or `F` is subsingleton. -/
theorem isometry_inrSpatialTensor_iff [CompleteSpace F] (A : Set (E →L[ℂ] E))
    (N : VonNeumannAlgebra F) :
    Isometry (inrSpatialTensor A N) ↔ Nontrivial E ∨ Subsingleton F := by
  refine ⟨fun h ↦ (inrSpatialTensor_injective_iff A N).1 h.injective, fun h ↦ h.elim
    (fun _ ↦ AddMonoidHomClass.isometry_of_norm _ (norm_inrSpatialTensor A N)) fun hF ↦ ?_⟩
  have := (subsingleton_coe_iff N).2 hF; exact fun x y ↦ by simp [Subsingleton.elim x y]
end FactorEmbeddings

/-! ### Slice-map invariance, pure-amplification membership, and generator reduction -/

section SliceInvariance
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
/-- Every right slice of an operator in `(spatialTensor A B)'` centralizes `A ∪ star A`. -/
theorem sliceRight_mem_centralizer_of_mem_commutant_spatialTensor [CompleteSpace E]
    {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)} {T}
    (hT : T ∈ (spatialTensor A B).commutant) (ξ η : F) :
    sliceRight ξ η T ∈ (A ∪ star A).centralizer := by
  have hcomm (x : E →L[ℂ] E) (hx : x.rTensorCompletion F ∈ spatialTensor A B) :
      x * sliceRight ξ η T = sliceRight ξ η T * x := by
    rw [← sliceRight_rTensorCompletion_mul, ← sliceRight_mul_rTensorCompletion,
      (mem_commutant_iff.1 hT) _ hx]
  rintro x (hx | hx); · exact hcomm x (rTensorCompletion_mem_spatialTensor hx)
  refine hcomm x ?_; rw [← star_mem_iff, ContinuousLinearMap.star_rTensorCompletion]
  exact rTensorCompletion_mem_spatialTensor (Set.mem_star.1 hx)
/-- Every left slice of an operator in `(spatialTensor A B)'` centralizes `B ∪ star B`. -/
theorem sliceLeft_mem_centralizer_of_mem_commutant_spatialTensor [CompleteSpace F]
    {A : Set (E →L[ℂ] E)} {B : Set (F →L[ℂ] F)} {T}
    (hT : T ∈ (spatialTensor A B).commutant) (e₁ e₂ : E) :
    sliceLeft e₁ e₂ T ∈ (B ∪ star B).centralizer := by
  rw [← sliceRight_conjStarAlgEquiv_commIsometry_completion]
  refine sliceRight_mem_centralizer_of_mem_commutant_spatialTensor (B := A) ?_ e₁ e₂
  simpa using conjStarAlgEquiv_mem_mapLinearIsometryEquiv
    (U := (commIsometry ℂ E F).completion) |>.2 hT
/-- Replacing the left generating set `s` by `adjoin s` does not change `spatialTensor`. -/
theorem spatialTensor_adjoin_left [CompleteSpace E] (s : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) :
    spatialTensor (adjoin s : Set (E →L[ℂ] E)) B = spatialTensor s B := by
  refine le_antisymm
    (spatialTensor_le_iff.2 ⟨fun x hx ↦ ?_, fun _ ↦ lTensorCompletion_mem_spatialTensor⟩)
    (spatialTensor_mono (subset_adjoin s) Set.Subset.rfl)
  rw [← commutant_commutant (spatialTensor s B), mem_commutant_iff]
  intro T hT; refine ext_of_sliceRight fun ξ η ↦ ?_
  have hx' : x ∈ (s ∪ star s).centralizer.centralizer := by rwa [← coe_adjoin]
  rw [sliceRight_mul_rTensorCompletion, sliceRight_rTensorCompletion_mul]
  exact hx' _ (sliceRight_mem_centralizer_of_mem_commutant_spatialTensor hT ξ η)
/-- Replacing the right generating set `t` by `adjoin t` does not change `spatialTensor`. -/
theorem spatialTensor_adjoin_right [CompleteSpace F] (A : Set (E →L[ℂ] E)) (t : Set (F →L[ℂ] F)) :
    spatialTensor A (adjoin t : Set (F →L[ℂ] F)) = spatialTensor A t := by
  apply (mapLinearIsometryEquiv (commIsometry ℂ E F).completion).injective
  simp only [mapLinearIsometryEquiv_commIsometry_spatialTensor, spatialTensor_adjoin_left]
/-- Right slices of elements of `(spatialTensor M B)'` lie in `M'`. -/
theorem sliceRight_mem_commutant_of_mem_commutant_spatialTensor [CompleteSpace E]
    {M : VonNeumannAlgebra E} {B : Set (F →L[ℂ] F)} {T}
    (hT : T ∈ (spatialTensor (M : Set (E →L[ℂ] E)) B).commutant) (ξ η : F) :
    sliceRight ξ η T ∈ M.commutant := by
  rw [← adjoin_eq M, ← SetLike.mem_coe, coe_commutant_adjoin]
  exact sliceRight_mem_centralizer_of_mem_commutant_spatialTensor hT ξ η
/-- Left slices of elements of `(spatialTensor A N)'` lie in `N'`. -/
theorem sliceLeft_mem_commutant_of_mem_commutant_spatialTensor [CompleteSpace F]
    {A : Set (E →L[ℂ] E)} {N : VonNeumannAlgebra F} {T}
    (hT : T ∈ (spatialTensor A (N : Set (F →L[ℂ] F))).commutant) (e₁ e₂ : E) :
    sliceLeft e₁ e₂ T ∈ N.commutant := by
  rw [← adjoin_eq N, ← SetLike.mem_coe, coe_commutant_adjoin]
  exact sliceLeft_mem_centralizer_of_mem_commutant_spatialTensor hT e₁ e₂
private theorem spatialTensor_le_commutant_spatialTensor_commutant_empty [CompleteSpace E]
    (M : VonNeumannAlgebra E) (B : Set (F →L[ℂ] F)) :
    spatialTensor (M : Set (E →L[ℂ] E)) B ≤
      (spatialTensor (M.commutant : Set (E →L[ℂ] E)) (∅ : Set (F →L[ℂ] F))).commutant := by
  have hmem {T} (h : ∀ a ∈ M.commutant, a.rTensorCompletion F * T = T * a.rTensorCompletion F) :
      T ∈ (spatialTensor (M.commutant : Set (E →L[ℂ] E)) (∅ : Set (F →L[ℂ] F))).commutant := by
    rw [← SetLike.mem_coe, spatialTensor_def, Set.image_empty, Set.union_empty,
      coe_commutant_adjoin]
    rintro w (⟨a, ha, rfl⟩ | ⟨a, ha, hEq⟩)
    · exact h a ha
    · rw [← star_star w, ← hEq, ContinuousLinearMap.star_rTensorCompletion]
      exact h (star a) (star_mem ha)
  refine spatialTensor_le_iff.2 ⟨fun x hx ↦ hmem fun a ha ↦ ?_,
    fun y _ ↦ hmem fun a _ ↦
      (ContinuousLinearMap.commute_rTensorCompletion_lTensorCompletion a y).eq⟩
  rw [← ContinuousLinearMap.rTensorCompletion_mul, ← ContinuousLinearMap.rTensorCompletion_mul,
    (mem_commutant_iff.1 ha) x hx]
/-- **Right slice-map invariance**: right slices of `T ∈ spatialTensor M B` belong to `M`. -/
theorem sliceRight_mem_of_mem_spatialTensor [CompleteSpace E]
    {M : VonNeumannAlgebra E} {B : Set (F →L[ℂ] F)} {T}
    (hT : T ∈ spatialTensor (M : Set (E →L[ℂ] E)) B) (ξ η : F) : sliceRight ξ η T ∈ M := by
  rw [← commutant_commutant M]
  exact sliceRight_mem_commutant_of_mem_commutant_spatialTensor
    (spatialTensor_le_commutant_spatialTensor_commutant_empty M B hT) ξ η
/-- **Left slice-map invariance**: left slices of `T ∈ spatialTensor A N` belong to `N`. -/
theorem sliceLeft_mem_of_mem_spatialTensor [CompleteSpace F]
    {A : Set (E →L[ℂ] E)} {N : VonNeumannAlgebra F} {T}
    (hT : T ∈ spatialTensor A (N : Set (F →L[ℂ] F))) (e₁ e₂ : E) : sliceLeft e₁ e₂ T ∈ N := by
  rw [← sliceRight_conjStarAlgEquiv_commIsometry_completion]
  refine sliceRight_mem_of_mem_spatialTensor (B := A) ?_ e₁ e₂
  simpa using conjStarAlgEquiv_mem_mapLinearIsometryEquiv
    (U := (commIsometry ℂ E F).completion) |>.2 hT
/-- When `F` is nontrivial, `x ⊗ 1 ∈ spatialTensor M B` iff `x ∈ M`. -/
@[simp] theorem rTensorCompletion_mem_spatialTensor_iff [CompleteSpace E] [Nontrivial F]
    {M : VonNeumannAlgebra E} {B : Set (F →L[ℂ] F)} {x : E →L[ℂ] E} :
    x.rTensorCompletion F ∈ spatialTensor (M : Set (E →L[ℂ] E)) B ↔ x ∈ M := by
  refine ⟨fun hx ↦ ?_, rTensorCompletion_mem_spatialTensor⟩
  obtain ⟨ξ₀, hξ₀⟩ := exists_norm_eq F zero_le_one
  simpa [sliceRight_rTensorCompletion_of_norm_eq_one hξ₀] using
    sliceRight_mem_of_mem_spatialTensor hx ξ₀ ξ₀
/-- When `E` is nontrivial, `1 ⊗ y ∈ spatialTensor A N` iff `y ∈ N`. -/
@[simp] theorem lTensorCompletion_mem_spatialTensor_iff [CompleteSpace F] [Nontrivial E]
    {A : Set (E →L[ℂ] E)} {N : VonNeumannAlgebra F} {y : F →L[ℂ] F} :
    y.lTensorCompletion E ∈ spatialTensor A (N : Set (F →L[ℂ] F)) ↔ y ∈ N := by
  rw [← conjStarAlgEquiv_mem_mapLinearIsometryEquiv (U := (commIsometry ℂ E F).completion)]; simp
/-- When `F` is nontrivial, `x ⊗ 1 ∈ (spatialTensor M B)'` iff `x ∈ M'`. -/
theorem rTensorCompletion_mem_commutant_spatialTensor_iff [CompleteSpace E] [Nontrivial F]
    {M : VonNeumannAlgebra E} {B : Set (F →L[ℂ] F)} {x : E →L[ℂ] E} :
    x.rTensorCompletion F ∈ (spatialTensor (M : Set (E →L[ℂ] E)) B).commutant ↔ x ∈ M.commutant :=
  ⟨fun hx ↦ by
    obtain ⟨ξ₀, hξ₀⟩ := exists_norm_eq F zero_le_one
    simpa [sliceRight_rTensorCompletion_of_norm_eq_one hξ₀] using
      sliceRight_mem_commutant_of_mem_commutant_spatialTensor hx ξ₀ ξ₀,
   fun hx ↦ le_commutant_comm.1 (spatialTensor_le_commutant_spatialTensor_commutant_empty M B)
     (rTensorCompletion_mem_spatialTensor hx)⟩
/-- When `E` is nontrivial, `1 ⊗ y ∈ (spatialTensor A N)'` iff `y ∈ N'`. -/
theorem lTensorCompletion_mem_commutant_spatialTensor_iff [CompleteSpace F] [Nontrivial E]
    {A : Set (E →L[ℂ] E)} {N : VonNeumannAlgebra F} {y : F →L[ℂ] F} :
    y.lTensorCompletion E ∈ (spatialTensor A (N : Set (F →L[ℂ] F))).commutant ↔
      y ∈ N.commutant := by
  rw [← conjStarAlgEquiv_mem_mapLinearIsometryEquiv (U := (commIsometry ℂ E F).completion),
    mapLinearIsometryEquiv_commutant, mapLinearIsometryEquiv_commIsometry_spatialTensor,
    conjStarAlgEquiv_commIsometry_completion_lTensorCompletion,
    rTensorCompletion_mem_commutant_spatialTensor_iff]
/-- `spatialTensor M' N' ≤ (spatialTensor M N)'`. -/
theorem spatialTensor_commutant_le_commutant_spatialTensor [CompleteSpace E] [CompleteSpace F]
    (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    spatialTensor (M.commutant : Set (E →L[ℂ] E)) (N.commutant : Set (F →L[ℂ] F)) ≤
      (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant := by
  refine spatialTensor_le_iff.2 ⟨fun x hx ↦ mem_commutant_iff.2 fun T hT ↦
      ext_of_sliceRight fun ξ η ↦ ?_,
    fun y hy ↦ mem_commutant_iff.2 fun T hT ↦ ext_of_sliceLeft fun e₁ e₂ ↦ ?_⟩
  · rw [sliceRight_mul_rTensorCompletion, sliceRight_rTensorCompletion_mul]
    exact (mem_commutant_iff.1 hx) _ (sliceRight_mem_of_mem_spatialTensor hT ξ η)
  · rw [sliceLeft_mul_lTensorCompletion, sliceLeft_lTensorCompletion_mul]
    exact (mem_commutant_iff.1 hy) _ (sliceLeft_mem_of_mem_spatialTensor hT e₁ e₂)
end SliceInvariance

/-! ### Scalar units and associativity -/

section MonoidalCoherence
variable {E F G : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [NormedAddCommGroup G] [InnerProductSpace ℂ G]
/-- **Left scalar unit law**: `spatialTensor ⊥ M` on `ℂ ⊗[ℂ] F` maps onto `M`. -/
theorem mapLinearIsometryEquiv_lidIsometryCompletion_spatialTensor [CompleteSpace F]
    (M : VonNeumannAlgebra F) :
    mapLinearIsometryEquiv (lidIsometryCompletion ℂ F)
      (spatialTensor ((⊥ : VonNeumannAlgebra ℂ) : Set (ℂ →L[ℂ] ℂ)) (M : Set (F →L[ℂ] F))) = M := by
  rw [spatialTensor_bot_left]; simp [spatialTensor_def, Set.image_image]
/-- **Right scalar unit law**: `spatialTensor M ⊥` on `E ⊗[ℂ] ℂ` maps onto `M`. -/
theorem mapLinearIsometryEquiv_ridIsometryCompletion_spatialTensor [CompleteSpace E]
    (M : VonNeumannAlgebra E) :
    mapLinearIsometryEquiv (ridIsometryCompletion ℂ E)
      (spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra ℂ) : Set (ℂ →L[ℂ] ℂ))) = M := by
  rw [spatialTensor_bot_right]; simp [spatialTensor_def, Set.image_image]
/-- **Associativity** of the spatial tensor product along
`TensorProduct.assocIsometryCompletion`. -/
@[simp] theorem mapLinearIsometryEquiv_assocIsometryCompletion_spatialTensor
    (A : Set (E →L[ℂ] E)) (B : Set (F →L[ℂ] F)) (C : Set (G →L[ℂ] G)) :
    mapLinearIsometryEquiv (assocIsometryCompletion ℂ E F G)
      (spatialTensor (spatialTensor A B : Set _) C) =
      spatialTensor A (spatialTensor B C : Set _) := by
  rw [spatialTensor_def (A := A) (B := B), spatialTensor_adjoin_left,
    spatialTensor_def (A := B) (B := C), spatialTensor_adjoin_right, spatialTensor_def,
    spatialTensor_def, mapLinearIsometryEquiv_adjoin]
  refine congrArg adjoin ?_; simp only [Set.image_union, Set.image_image, Set.union_assoc]
  congr 1 <;> [skip; congr 1] <;> (ext; simp)
end MonoidalCoherence

/-! ### `B(K)` commutation, carrier of `spatialTensor M ⊥`, and tensor splitting -/

section TopCommutantAndSplitting
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
/-- **`B(F)` commutation theorem**: `(spatialTensor M ⊤)' = spatialTensor M' ⊥`. -/
theorem commutant_spatialTensor_top_right (M : VonNeumannAlgebra E) :
    (spatialTensor (M : Set (E →L[ℂ] E)) ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F))).commutant =
      spatialTensor (M.commutant : Set (E →L[ℂ] E))
        ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  by_cases hF : Nontrivial F
  · refine le_antisymm (fun T hT ↦ ?_) ?_
    · obtain ⟨ξ₀, hξ₀⟩ := exists_norm_eq F zero_le_one
      rw [eq_rTensorCompletion_sliceRight_of_commute_rankOne hξ₀ fun y ↦
        (mem_commutant_iff.1 hT) _ (lTensorCompletion_mem_spatialTensor mem_top)]
      exact rTensorCompletion_mem_spatialTensor
        (sliceRight_mem_commutant_of_mem_commutant_spatialTensor hT ξ₀ ξ₀)
    · simpa [commutant_top] using
        spatialTensor_commutant_le_commutant_spatialTensor M (⊤ : VonNeumannAlgebra F)
  · rw [not_nontrivial_iff_subsingleton] at hF; exact Subsingleton.elim _ _
/-- **`B(E)` commutation theorem**: `(spatialTensor ⊤ N)' = spatialTensor ⊥ N'`. -/
theorem commutant_spatialTensor_top_left (N : VonNeumannAlgebra F) :
    (spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant =
      spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        (N.commutant : Set (F →L[ℂ] F)) := by
  apply (mapLinearIsometryEquiv (commIsometry ℂ E F).completion).injective
  simp only [mapLinearIsometryEquiv_commutant, mapLinearIsometryEquiv_commIsometry_spatialTensor,
    commutant_spatialTensor_top_right]
/-- **Commutant of `spatialTensor M ⊥`**: `(spatialTensor M ⊥)' = spatialTensor M' ⊤`. -/
theorem commutant_spatialTensor_bot_right (M : VonNeumannAlgebra E) :
    (spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F))).commutant =
      spatialTensor (M.commutant : Set (E →L[ℂ] E))
        ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  simpa [commutant_commutant] using
    (congrArg commutant (commutant_spatialTensor_top_right (F := F) M.commutant)).symm
/-- **Commutant of `spatialTensor ⊥ N`**: `(spatialTensor ⊥ N)' = spatialTensor ⊤ N'`. -/
theorem commutant_spatialTensor_bot_left (N : VonNeumannAlgebra F) :
    (spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant =
      spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        (N.commutant : Set (F →L[ℂ] F)) := by
  simpa [commutant_commutant] using
    (congrArg commutant (commutant_spatialTensor_top_left (E := E) N.commutant)).symm
/-- **Spatial tensor product of full operator sets**: `spatialTensor Set.univ Set.univ = ⊤`. -/
@[simp] theorem spatialTensor_univ_univ :
    spatialTensor (Set.univ : Set (E →L[ℂ] E)) (Set.univ : Set (F →L[ℂ] F)) = ⊤ := by
  rw [← coe_top, ← coe_top, ← commutant_eq_bot_iff, commutant_spatialTensor_top_right,
    commutant_top, spatialTensor_bot_bot]
/-- **Spatial tensor product of full operator algebras**: `spatialTensor ⊤ ⊤ = ⊤`. -/
theorem spatialTensor_top_top :
    spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
      ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) = ⊤ := by simp
/-- The carrier of `spatialTensor M ⊥` is `{x.rTensorCompletion F | x ∈ M}` on the nose. -/
theorem coe_spatialTensor_bot_right (M : VonNeumannAlgebra E) :
    (spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) :
      Set (Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F))) =
      ContinuousLinearMap.rTensorCompletion F '' (M : Set (E →L[ℂ] E)) := by
  by_cases hF : Nontrivial F
  · refine Set.Subset.antisymm (fun T hT ↦ ?_)
      (by rintro _ ⟨x, hx, rfl⟩; exact rTensorCompletion_mem_spatialTensor hx)
    obtain ⟨ξ₀, hξ₀⟩ := exists_norm_eq F zero_le_one
    have hT' := hT
    rw [← commutant_commutant M, ← commutant_spatialTensor_top_right] at hT'
    exact ⟨sliceRight ξ₀ ξ₀ T, sliceRight_mem_of_mem_spatialTensor hT ξ₀ ξ₀,
      (eq_rTensorCompletion_sliceRight_of_commute_rankOne hξ₀ fun y ↦
        (mem_commutant_iff.1 hT') _ (lTensorCompletion_mem_spatialTensor mem_top)).symm⟩
  · rw [not_nontrivial_iff_subsingleton] at hF; ext T
    exact ⟨fun _ ↦ ⟨0, zero_mem M, Subsingleton.elim _ _⟩,
      fun ⟨x, hx, hEq⟩ ↦ hEq ▸ rTensorCompletion_mem_spatialTensor hx⟩
/-- The carrier of `spatialTensor ⊥ N` is `{y.lTensorCompletion E | y ∈ N}` on the nose. -/
theorem coe_spatialTensor_bot_left (N : VonNeumannAlgebra F) :
    (spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) :
      Set (Completion (E ⊗[ℂ] F) →L[ℂ] Completion (E ⊗[ℂ] F))) =
      ContinuousLinearMap.lTensorCompletion E '' (N : Set (F →L[ℂ] F)) := by
  have h := congrArg (⇑(commIsometry ℂ F E).completion.conjStarAlgEquiv '' ·)
    (coe_spatialTensor_bot_right (F := E) N)
  rw [← coe_mapLinearIsometryEquiv, mapLinearIsometryEquiv_commIsometry_spatialTensor,
    Set.image_image] at h; simpa using h
/-- When `F` is nontrivial, `x ↦ x ⊗ 1` gives `M ≃⋆ₐ[ℂ] spatialTensor M ⊥`. -/
noncomputable def inlSpatialTensorBotEquiv [Nontrivial F] (M : VonNeumannAlgebra E) :
    M ≃⋆ₐ[ℂ] spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) :=
  StarAlgEquiv.ofBijective (inlSpatialTensor M ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)))
    ⟨inlSpatialTensor_injective M _, fun T ↦ by
      obtain ⟨x, hx, hEq⟩ := coe_spatialTensor_bot_right (F := F) M ▸ SetLike.mem_coe.2 T.property
      exact ⟨⟨x, hx⟩, Subtype.ext <| by simpa using hEq⟩⟩
@[simp] theorem inlSpatialTensorBotEquiv_apply [Nontrivial F] (M : VonNeumannAlgebra E) (x : M) :
    inlSpatialTensorBotEquiv M x =
      inlSpatialTensor M ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) x := (rfl)
@[norm_cast] theorem coe_inlSpatialTensorBotEquiv [Nontrivial F] (M : VonNeumannAlgebra E) (x : M) :
    (↑(inlSpatialTensorBotEquiv (F := F) M x) : Completion (E ⊗[ℂ] F) →L[ℂ] _) =
      (x : E →L[ℂ] E).rTensorCompletion F := by simp
@[simp] theorem inlSpatialTensorBotEquiv_symm_inlSpatialTensor [Nontrivial F]
    (M : VonNeumannAlgebra E) (x : M) :
    (inlSpatialTensorBotEquiv M).symm
      (inlSpatialTensor M ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) x) = x :=
  (inlSpatialTensorBotEquiv M).symm_apply_apply x
@[simp] theorem rTensorCompletion_coe_inlSpatialTensorBotEquiv_symm [Nontrivial F]
    (M : VonNeumannAlgebra E)
    (T : spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F))) :
    ((inlSpatialTensorBotEquiv M).symm T : E →L[ℂ] E).rTensorCompletion F = T :=
  by rw [← coe_inlSpatialTensorBotEquiv, (inlSpatialTensorBotEquiv M).apply_symm_apply]
/-- For any unit vector `ξ₀ ∈ F`, `(inlSpatialTensorBotEquiv M).symm T` equals the diagonal right
slice `sliceRight ξ₀ ξ₀ T`. -/
theorem coe_inlSpatialTensorBotEquiv_symm_eq_sliceRight [Nontrivial F] (M : VonNeumannAlgebra E)
    (T : spatialTensor (M : Set (E →L[ℂ] E)) ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)))
    {ξ₀ : F} (hξ₀ : ‖ξ₀‖ = 1) :
    ((inlSpatialTensorBotEquiv M).symm T : E →L[ℂ] E) = sliceRight ξ₀ ξ₀ (T : _ →L[ℂ] _) := by
  rw [← rTensorCompletion_coe_inlSpatialTensorBotEquiv_symm M T,
    sliceRight_rTensorCompletion_of_norm_eq_one hξ₀]
/-- When `E` is nontrivial, `y ↦ 1 ⊗ y` gives `N ≃⋆ₐ[ℂ] spatialTensor ⊥ N`. -/
noncomputable def inrSpatialTensorBotEquiv [Nontrivial E] (N : VonNeumannAlgebra F) :
    N ≃⋆ₐ[ℂ] spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) :=
  StarAlgEquiv.ofBijective (inrSpatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) N)
    ⟨inrSpatialTensor_injective _ N, fun T ↦ by
      obtain ⟨y, hy, hEq⟩ := coe_spatialTensor_bot_left (E := E) N ▸ SetLike.mem_coe.2 T.property
      exact ⟨⟨y, hy⟩, Subtype.ext <| by simpa using hEq⟩⟩
@[simp] theorem inrSpatialTensorBotEquiv_apply [Nontrivial E] (N : VonNeumannAlgebra F) (y : N) :
    inrSpatialTensorBotEquiv N y =
      inrSpatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) N y := (rfl)
@[norm_cast] theorem coe_inrSpatialTensorBotEquiv [Nontrivial E] (N : VonNeumannAlgebra F) (y : N) :
    (↑(inrSpatialTensorBotEquiv (E := E) N y) : Completion (E ⊗[ℂ] F) →L[ℂ] _) =
      (y : F →L[ℂ] F).lTensorCompletion E := by simp
@[simp] theorem inrSpatialTensorBotEquiv_symm_inrSpatialTensor [Nontrivial E]
    (N : VonNeumannAlgebra F) (y : N) :
    (inrSpatialTensorBotEquiv N).symm
      (inrSpatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) N y) = y :=
  (inrSpatialTensorBotEquiv N).symm_apply_apply y
@[simp] theorem lTensorCompletion_coe_inrSpatialTensorBotEquiv_symm [Nontrivial E]
    (N : VonNeumannAlgebra F)
    (T : spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))) :
    ((inrSpatialTensorBotEquiv N).symm T : F →L[ℂ] F).lTensorCompletion E = T :=
  by rw [← coe_inrSpatialTensorBotEquiv, (inrSpatialTensorBotEquiv N).apply_symm_apply]
/-- For any unit vector `e₀ ∈ E`, `(inrSpatialTensorBotEquiv N).symm T` equals the diagonal left
slice `sliceLeft e₀ e₀ T`. -/
theorem coe_inrSpatialTensorBotEquiv_symm_eq_sliceLeft [Nontrivial E] (N : VonNeumannAlgebra F)
    (T : spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)))
    {e₀ : E} (he₀ : ‖e₀‖ = 1) :
    ((inrSpatialTensorBotEquiv N).symm T : F →L[ℂ] F) = sliceLeft e₀ e₀ (T : _ →L[ℂ] _) := by
  rw [← lTensorCompletion_coe_inrSpatialTensorBotEquiv_symm N T,
    sliceLeft_lTensorCompletion_of_norm_eq_one he₀]
/-- **`B(F)` tensor splitting theorem**: `spatialTensor ⊥ ⊤ ≤ P` iff `P = spatialTensor M ⊤` for a
unique `M` (when `F` is nontrivial). -/
theorem spatialTensor_bot_top_le_iff_existsUnique [Nontrivial F]
    (P : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))) :
    spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) ≤ P ↔
      ∃! M : VonNeumannAlgebra E, P = spatialTensor (M : Set (E →L[ℂ] E))
        ((⊤ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  refine ⟨fun hle ↦ ?_, fun ⟨M, hPM, _⟩ ↦ hPM ▸
    spatialTensor_mono (SetLike.coe_subset_coe.2 bot_le) Set.Subset.rfl⟩
  let S : Set (E →L[ℂ] E) := ContinuousLinearMap.rTensorCompletion F ⁻¹' (P.commutant : Set _)
  have hPcomm : P.commutant = spatialTensor ((adjoin S : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
      ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
    refine le_antisymm (fun T hT ↦ ?_) (by
      rw [spatialTensor_adjoin_left, spatialTensor_bot_right, spatialTensor_le_iff]
      exact ⟨fun _ hx ↦ hx, fun _ ↦ False.elim⟩)
    have hT' := commutant_le_commutant hle hT
    rw [commutant_spatialTensor_bot_left, commutant_top, ← SetLike.mem_coe,
      coe_spatialTensor_bot_right] at hT'
    obtain ⟨x, -, rfl⟩ := hT'; exact rTensorCompletion_mem_spatialTensor (subset_adjoin S hT)
  have hPM : P = spatialTensor ((adjoin S).commutant : Set _)
      ((⊤ : VonNeumannAlgebra F) : Set _) := by
    rw [← commutant_commutant P, hPcomm, commutant_spatialTensor_bot_right]
  refine ⟨(adjoin S).commutant, hPM, fun M' hPM' ↦ ext fun x ↦ ?_⟩
  rw [← rTensorCompletion_mem_spatialTensor_iff (F := F) (B := ((⊤ : VonNeumannAlgebra F) : Set _)),
    ← hPM', hPM, rTensorCompletion_mem_spatialTensor_iff]
/-- **`B(E)` tensor splitting theorem**: `spatialTensor ⊤ ⊥ ≤ P` iff `P = spatialTensor ⊤ N` for a
unique `N` (when `E` is nontrivial). -/
theorem spatialTensor_top_bot_le_iff_existsUnique [Nontrivial E]
    (P : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))) :
    spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) ≤ P ↔
      ∃! N : VonNeumannAlgebra F, P = spatialTensor ((⊤ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        (N : Set (F →L[ℂ] F)) := by
  let φ := mapLinearIsometryEquiv (commIsometry ℂ E F).completion
  rw [← φ.le_iff_le, mapLinearIsometryEquiv_commIsometry_spatialTensor,
    spatialTensor_bot_top_le_iff_existsUnique]
  exact existsUnique_congr fun N ↦ by
    rw [← mapLinearIsometryEquiv_commIsometry_spatialTensor, φ.injective.eq_iff]
end TopCommutantAndSplitting

/-! ### Center and factoriality of spatial tensor products -/

section CenterAndFactors
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
/-- **Center with scalar center on the left**: if `M ⊓ M.commutant = ⊥`, then
`(spatialTensor M N) ⊓ (spatialTensor M N)' = spatialTensor ⊥ (N ⊓ N')`. -/
theorem spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_left
    {M : VonNeumannAlgebra E} (hM : M ⊓ M.commutant = ⊥) (N : VonNeumannAlgebra F) :
    spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
        (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant =
      spatialTensor ((⊥ : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((N ⊓ N.commutant : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  refine le_antisymm (fun T hT ↦ ?_) (le_inf
    (spatialTensor_mono (SetLike.coe_subset_coe.2 bot_le) (SetLike.coe_subset_coe.2 inf_le_left))
    ((spatialTensor_mono (SetLike.coe_subset_coe.2 (bot_le (a := M.commutant)))
      (SetLike.coe_subset_coe.2 inf_le_right)).trans
      (spatialTensor_commutant_le_commutant_spatialTensor M N)))
  obtain ⟨hTMN, hTcomm⟩ := mem_inf.1 hT
  have hbot (ξ η : F) : sliceRight ξ η T ∈ (⊥ : VonNeumannAlgebra E) :=
    hM ▸ mem_inf.2 ⟨sliceRight_mem_of_mem_spatialTensor hTMN ξ η,
      sliceRight_mem_commutant_of_mem_commutant_spatialTensor hTcomm ξ η⟩
  have hTtop : T ∈ spatialTensor ((⊥ : VonNeumannAlgebra E) : Set _)
      ((⊤ : VonNeumannAlgebra F) : Set _) := by
    rw [← commutant_bot (H := F), ← commutant_spatialTensor_top_left, mem_commutant_iff]
    intro S hS; rw [← SetLike.mem_coe, coe_spatialTensor_bot_right] at hS
    obtain ⟨a, -, rfl⟩ := hS; refine ext_of_sliceRight fun ξ η ↦ ?_
    obtain ⟨c, hc⟩ := mem_bot.1 (hbot ξ η)
    rw [sliceRight_rTensorCompletion_mul, sliceRight_mul_rTensorCompletion, ← hc, Algebra.commutes]
  rw [← SetLike.mem_coe, coe_spatialTensor_bot_left] at hTtop; obtain ⟨y, -, rfl⟩ := hTtop
  by_cases hE : Nontrivial E
  · exact lTensorCompletion_mem_spatialTensor (mem_inf.2
      ⟨lTensorCompletion_mem_spatialTensor_iff.1 hTMN,
       lTensorCompletion_mem_commutant_spatialTensor_iff.1 hTcomm⟩)
  · rw [not_nontrivial_iff_subsingleton] at hE
    simp [ContinuousLinearMap.lTensorCompletion_of_subsingleton]
/-- **Center with scalar center on the right**: if `N ⊓ N.commutant = ⊥`, then
`(spatialTensor M N) ⊓ (spatialTensor M N)' = spatialTensor (M ⊓ M') ⊥`. -/
theorem spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_right
    (M : VonNeumannAlgebra E) {N : VonNeumannAlgebra F} (hN : N ⊓ N.commutant = ⊥) :
    spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
        (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant =
      spatialTensor ((M ⊓ M.commutant : VonNeumannAlgebra E) : Set (E →L[ℂ] E))
        ((⊥ : VonNeumannAlgebra F) : Set (F →L[ℂ] F)) := by
  simpa [OrderIso.map_inf] using congrArg (mapLinearIsometryEquiv (commIsometry ℂ F E).completion)
    (spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_left (E := F) hN M)
/-- **Trivial center of spatial tensor products**: if `M ⊓ M.commutant = ⊥` and
`N ⊓ N.commutant = ⊥`, then `spatialTensor M N` has scalar center (`⊓ commutant = ⊥`); see
`IsFactor.spatialTensor` and `isFactor_spatialTensor_iff` for `VonNeumannAlgebra.IsFactor`. -/
theorem spatialTensor_inf_commutant_eq_bot {M : VonNeumannAlgebra E} {N : VonNeumannAlgebra F}
    (hM : M ⊓ M.commutant = ⊥) (hN : N ⊓ N.commutant = ⊥) :
    spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
      (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant = ⊥ := by
  rw [spatialTensor_inf_commutant_eq_of_inf_commutant_eq_bot_left hM N, hN, spatialTensor_bot_bot]
private theorem inf_commutant_eq_bot_left_of_spatialTensor [Nontrivial F]
    {M : VonNeumannAlgebra E} {N : VonNeumannAlgebra F}
    (hMN : spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
      (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant = ⊥) :
    M ⊓ M.commutant = ⊥ :=
  le_antisymm (fun x hx ↦ by
    obtain ⟨hxM, hxM'⟩ := mem_inf.1 hx
    have hxbot : x.rTensorCompletion F ∈ (⊥ : VonNeumannAlgebra (Completion (E ⊗[ℂ] F))) :=
      hMN ▸ mem_inf.2 ⟨rTensorCompletion_mem_spatialTensor hxM,
        (rTensorCompletion_mem_commutant_spatialTensor_iff (B := (N : Set (F →L[ℂ] F)))).2 hxM'⟩
    rwa [← spatialTensor_empty_empty, ← spatialTensor_bot_left,
      rTensorCompletion_mem_spatialTensor_iff] at hxbot) bot_le
/-- **Sharp trivial-center equivalence**: on nontrivial `E` and `F`, `spatialTensor M N` has
scalar center iff both `M` and `N` have scalar center. -/
theorem spatialTensor_inf_commutant_eq_bot_iff [Nontrivial E] [Nontrivial F]
    (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F)) ⊓
        (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).commutant = ⊥ ↔
      M ⊓ M.commutant = ⊥ ∧ N ⊓ N.commutant = ⊥ :=
  ⟨fun hMN ↦ ⟨inf_commutant_eq_bot_left_of_spatialTensor hMN,
    inf_commutant_eq_bot_left_of_spatialTensor (F := E) (N := M) <| by
      simpa [OrderIso.map_inf] using
        congrArg (mapLinearIsometryEquiv (commIsometry ℂ E F).completion) hMN⟩,
   fun ⟨hM, hN⟩ ↦ spatialTensor_inf_commutant_eq_bot hM hN⟩
/-- **Factoriality of spatial tensor products**: `spatialTensor M N` is a factor if and only if
both `M` and `N` are factors. -/
theorem isFactor_spatialTensor_iff (M : VonNeumannAlgebra E) (N : VonNeumannAlgebra F) :
    (spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).IsFactor ↔
      M.IsFactor ∧ N.IsFactor := by
  rw [isFactor_iff_inf_commutant_eq_bot, isFactor_iff_inf_commutant_eq_bot,
    isFactor_iff_inf_commutant_eq_bot, TensorProduct.nontrivial_completion_iff]
  refine ⟨fun ⟨⟨hE, hF⟩, hMN⟩ ↦ ?_, fun ⟨⟨hE, hM⟩, ⟨hF, hN⟩⟩ ↦
    ⟨⟨hE, hF⟩, spatialTensor_inf_commutant_eq_bot hM hN⟩⟩
  obtain ⟨hM, hN⟩ := (spatialTensor_inf_commutant_eq_bot_iff M N).1 hMN
  exact ⟨⟨hE, hM⟩, ⟨hF, hN⟩⟩
/-- The spatial tensor product of two factors is a factor. -/
theorem IsFactor.spatialTensor {M : VonNeumannAlgebra E} {N : VonNeumannAlgebra F}
    (hM : M.IsFactor) (hN : N.IsFactor) :
    (VonNeumannAlgebra.spatialTensor (M : Set (E →L[ℂ] E)) (N : Set (F →L[ℂ] F))).IsFactor :=
  (isFactor_spatialTensor_iff M N).2 ⟨hM, hN⟩
end CenterAndFactors

end VonNeumannAlgebra
