module

public import Mathlib.Analysis.CStarAlgebra.Unitary.Span
public import TauCeti.Analysis.VonNeumannAlgebra.Adjoin

/-!
# Unitary generation of von Neumann algebras

Every concrete von Neumann algebra `M` on a complex Hilbert space `H` is a unital C⋆-algebra via
`M.toStarSubalgebra`, so every `x ∈ M` is a linear combination of four unitaries in `M` with
coefficients bounded in norm by `‖x‖ / 2` (`VonNeumannAlgebra.exists_sum_four_unitary`). In
particular, the complex linear span of the unitaries in `M` is `M` itself
(`VonNeumannAlgebra.coe_span_inter_unitary`).

Consequently, `M` is generated as a von Neumann algebra by its unitary elements
(`VonNeumannAlgebra.adjoin_inter_unitary`), membership in `M.commutant` is tested by commuting
with unitaries in `M` (`VonNeumannAlgebra.mem_commutant_iff_forall_mem_unitary`), and membership in
`M` is tested by commuting with — or being invariant under conjugation by — unitaries in
`M.commutant`.

## Main declarations

* `VonNeumannAlgebra.exists_sum_four_unitary`: every `x ∈ M` is a linear combination of four
  unitaries in `M` with coefficient norms at most `‖x‖ / 2`.
* `VonNeumannAlgebra.coe_span_inter_unitary`: `M` is the complex linear span of its unitary
  elements.
* `VonNeumannAlgebra.adjoin_inter_unitary`: `M` is generated as a von Neumann algebra by its
  unitary elements.
* `VonNeumannAlgebra.mem_commutant_iff_forall_mem_unitary`,
  `VonNeumannAlgebra.mem_iff_forall_commutant_mem_unitary`,
  `VonNeumannAlgebra.mem_iff_forall_commutant_unitary_conj`: unitary tests for membership in
  `M.commutant` and `M`.

## References

* R. V. Kadison, J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras I*,
  Theorem 4.1.7.
* M. Takesaki, *Theory of Operator Algebras I*, Proposition II.3.9.
-/

public section

open scoped Pointwise

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Every operator `x` in a von Neumann algebra `M` is a linear combination of four unitaries in
`M`, with each coefficient bounded in norm by `‖x‖ / 2`. -/
theorem exists_sum_four_unitary {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} (hx : x ∈ M) :
    ∃ u : Fin 4 → H →L[ℂ] H, ∃ c : Fin 4 → ℂ,
      (∀ i, u i ∈ M ∧ u i ∈ unitary (H →L[ℂ] H)) ∧
      x = ∑ i, c i • u i ∧ ∀ i, ‖c i‖ ≤ ‖x‖ / 2 := by
  obtain ⟨u, c, hsum, hc⟩ := CStarAlgebra.exists_sum_four_unitary (⟨x, hx⟩ : M.toStarSubalgebra)
  refine ⟨fun i => (u i : H →L[ℂ] H), c,
    fun i => ⟨(u i).val.property, Unitary.map_mem M.toStarSubalgebra.subtype (u i).property⟩,
    ?_, hc⟩
  simpa only [StarSubalgebra.coe_subtype, map_sum, map_smul] using
    congrArg M.toStarSubalgebra.subtype hsum

/-- The complex linear span of the unitary operators in a von Neumann algebra `M` equals `M`. -/
@[simp]
theorem coe_span_inter_unitary (M : VonNeumannAlgebra H) :
    (Submodule.span ℂ ((M : Set (H →L[ℂ] H)) ∩ unitary (H →L[ℂ] H)) : Set (H →L[ℂ] H)) = M := by
  refine Set.Subset.antisymm (span_subset Set.inter_subset_left) fun x hx => ?_
  obtain ⟨u, c, hu, rfl, _⟩ := exists_sum_four_unitary hx
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span (hu i))

private theorem star_inter_unitary_subset (M : VonNeumannAlgebra H) :
    star ((M : Set (H →L[ℂ] H)) ∩ unitary (H →L[ℂ] H)) ⊆
      (M : Set (H →L[ℂ] H)) ∩ unitary (H →L[ℂ] H) := by
  rintro u hu
  rw [Set.mem_star] at hu
  rw [← star_star u]
  exact ⟨star_mem hu.1, Unitary.star_mem hu.2⟩

/-- Every von Neumann algebra is generated by its unitary elements. -/
@[simp]
theorem adjoin_inter_unitary (M : VonNeumannAlgebra H) :
    adjoin ((M : Set (H →L[ℂ] H)) ∩ unitary (H →L[ℂ] H)) = M :=
  adjoin_eq_of_subset_closure_span Set.inter_subset_left fun _ hx =>
    subset_closure (by rwa [M.coe_span_inter_unitary])

/-- An operator lies in `M.commutant` if and only if it commutes with every unitary in `M`. -/
theorem mem_commutant_iff_forall_mem_unitary {M : VonNeumannAlgebra H} {y : H →L[ℂ] H} :
    y ∈ M.commutant ↔ ∀ u ∈ M, u ∈ unitary (H →L[ℂ] H) → Commute u y := by
  simpa only [Set.mem_inter_iff, SetLike.mem_coe, and_imp] using
    mem_commutant_iff_of_adjoin_eq M.adjoin_inter_unitary (star_inter_unitary_subset M) (y := y)

/-- An operator belongs to a von Neumann algebra `M` if and only if it commutes with every unitary
in `M.commutant`. -/
theorem mem_iff_forall_commutant_mem_unitary {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} :
    x ∈ M ↔ ∀ u ∈ M.commutant, u ∈ unitary (H →L[ℂ] H) → Commute x u := by
  simpa only [Set.mem_inter_iff, SetLike.mem_coe, and_imp] using
    mem_iff_of_adjoin_eq_commutant M.commutant.adjoin_inter_unitary
      (star_inter_unitary_subset M.commutant) (x := x)

/-- An operator belongs to a von Neumann algebra `M` if and only if it is fixed under conjugation by
every unitary in `M.commutant`. -/
theorem mem_iff_forall_commutant_unitary_conj {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} :
    x ∈ M ↔ ∀ u ∈ M.commutant, u ∈ unitary (H →L[ℂ] H) → u * x * star u = x := by
  rw [mem_iff_forall_commutant_mem_unitary]
  refine forall_congr' fun u => imp_congr_right fun _ => imp_congr_right fun hu => ?_
  rw [Commute.symm_iff, commute_unitary_iff_star_right_conjugate hu]

end VonNeumannAlgebra
