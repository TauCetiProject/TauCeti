module

public import TauCeti.Analysis.VonNeumannAlgebra.Conj
public import TauCeti.MeasureTheory.Function.Lp.Multiplication.Basic
public import TauCeti.MeasureTheory.Measure.Atom
import TauCeti.MeasureTheory.Function.Lp.Multiplication.Commutant

/-!
# The multiplication von Neumann algebra `L∞(X, μ)` on `L²(X, μ)`

For any measure `μ` on a measurable space `α`, `VonNeumannAlgebra.multiplicationAlgebra μ` is the
concrete von Neumann algebra on `Lp ℂ 2 μ` generated (`VonNeumannAlgebra.adjoin`) by the `L∞`
multiplication operators `MeasureTheory.Lp.multiplicationOperator a =
(ContinuousLinearMap.mul ℂ ℂ).holderL μ ∞ 2 2 a` for `a : Lp ℂ ∞ μ`.

Because every operator commuting with all bounded multiplication operators commutes with every
other such operator (`MeasureTheory.Lp.commute_of_mem_centralizer_range_multiplicationOperator`),
`multiplicationAlgebra μ` equals its own commutant **unconditionally for every measure `μ`**
(`VonNeumannAlgebra.commutant_multiplicationAlgebra`). In particular, it is always a maximal
abelian self-adjoint algebra, carries `IsMulCommutative` and `CommCStarAlgebra` instances, and
contains precisely those operators commuting with every finite-measure indicator multiplication
(`VonNeumannAlgebra.mem_multiplicationAlgebra_iff_forall_commute_indicatorMultiplication`).

When `μ` is `σ`-finite, `multiplicationAlgebra μ` consists precisely of the multiplication
operators (`VonNeumannAlgebra.coe_multiplicationAlgebra`), and the general ⋆-algebra homomorphism
`VonNeumannAlgebra.multiplicationStarAlgHom μ : Lp ℂ ∞ μ →⋆ₐ[ℂ] multiplicationAlgebra μ` upgrades
to an isometric star algebra isomorphism
`VonNeumannAlgebra.multiplicationStarAlgEquiv μ : Lp ℂ ∞ μ ≃⋆ₐ[ℂ] multiplicationAlgebra μ`
(as well as `VonNeumannAlgebra.multiplicationLinearIsometryEquiv μ`).

An almost-everywhere inverse pair of measure-preserving maps induces a unitary equivalence of `L²`
spaces that conjugates the two multiplication algebras
(`VonNeumannAlgebra.conj_multiplicationAlgebra_compMeasurePreservingₗᵢEquiv`).

Finally, we record the canonical models and checks:
* `μ = 0`: `multiplicationAlgebra 0` is a subsingleton (`0`-dimensional).
* `Measure.dirac x₀`: `multiplicationAlgebra (Measure.dirac x₀)` is `⊥ = ⊤ ≅ ℂ` with no
  singleton-measurability hypothesis on `α`.
* `Measure.count` on a measurable-singleton type `α`: strictly between `⊥` and `⊤` whenever
  `Nontrivial α` (specializing `VonNeumannAlgebra.bot_lt_multiplicationAlgebra` and
  `VonNeumannAlgebra.multiplicationAlgebra_lt_top`); when `α` is finite, star-isomorphic to the
  diagonal algebra `α → ℂ` of complex dimension `Nat.card α`.
* Atomless measures (`∀ s, μ s ≠ ∞ → ¬ μ.IsAtom s`, and in particular
  `[MeasurableSpace.CountablySeparated α] [NullSingletonClass μ]` such as
  `(unitInterval, volume)`): `multiplicationAlgebra μ` has no minimal nonzero star projections
  (every nonzero idempotent strictly dominates a nonzero star projection).

## References

* M. Takesaki, *Theory of Operator Algebras I*, Springer, 2002, Chapter II, §2 and Chapter III, §1.
* R. V. Kadison and J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras I*,
  Academic Press, 1983, Example 5.1.6.
-/

public section

open MeasureTheory
open scoped ENNReal Pointwise

namespace VonNeumannAlgebra

section General

variable {α : Type*} [MeasurableSpace α]

/-- The **multiplication von Neumann algebra** on `Lp ℂ 2 μ`, generated by all `L∞` multiplication
operators `MeasureTheory.Lp.multiplicationOperator a` (`a : Lp ℂ ∞ μ`). -/
noncomputable def multiplicationAlgebra (μ : Measure α) : VonNeumannAlgebra (Lp ℂ 2 μ) :=
  adjoin (Set.range (Lp.multiplicationOperator (E := ℂ) (μ := μ)))

/-- Defining equation of `multiplicationAlgebra μ` as the von Neumann algebra generated by
`L∞` multiplication operators. -/
theorem multiplicationAlgebra_eq_adjoin (μ : Measure α) :
    multiplicationAlgebra μ = adjoin (Set.range (Lp.multiplicationOperator (E := ℂ) (μ := μ))) := by
  rfl

/-- `multiplicationAlgebra μ` equals the von Neumann algebra generated by Mathlib's Hölder product
operators `(ContinuousLinearMap.mul ℂ ℂ).holderL μ ∞ 2 2 a` (`a : Lp ℂ ∞ μ`). -/
theorem multiplicationAlgebra_eq_adjoin_holderL (μ : Measure α) :
    multiplicationAlgebra μ =
      adjoin (Set.range ((ContinuousLinearMap.mul ℂ ℂ).holderL μ ∞ 2 2)) := by
  rw [multiplicationAlgebra_eq_adjoin, Lp.holderL_mul_eq_multiplicationOperator]

theorem multiplicationOperator_mem_multiplicationAlgebra (μ : Measure α) (a : Lp ℂ ∞ μ) :
    Lp.multiplicationOperator a ∈ multiplicationAlgebra μ :=
  subset_adjoin _ ⟨a, rfl⟩

/-- Indicator multiplication by any measurable set `s` lies in `multiplicationAlgebra μ`. -/
theorem indicatorMultiplication_mem_multiplicationAlgebra (μ : Measure α) {s : Set α}
    (hs : MeasurableSet s) :
    Lp.indicatorMultiplication (E := ℂ) ℂ 2 hs ∈ multiplicationAlgebra μ := by
  rw [← Lp.multiplicationOperator_linftyIndicator hs]
  exact multiplicationOperator_mem_multiplicationAlgebra μ _

@[simp]
theorem multiplicationAlgebra_le_iff {μ : Measure α} {M : VonNeumannAlgebra (Lp ℂ 2 μ)} :
    multiplicationAlgebra μ ≤ M ↔ ∀ a : Lp ℂ ∞ μ, Lp.multiplicationOperator a ∈ M :=
  adjoin_le_iff.trans Set.forall_mem_range

theorem coe_multiplicationAlgebra_eq_centralizer_centralizer (μ : Measure α) :
    (multiplicationAlgebra μ : Set (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)) =
      (Set.range (Lp.multiplicationOperator (E := ℂ) (μ := μ))).centralizer.centralizer := by
  rw [multiplicationAlgebra_eq_adjoin, ← Lp.coe_range_multiplicationStarAlgHom μ ℂ,
    coe_adjoin_starSubalgebra]

/-- The commutant of `multiplicationAlgebra μ` is the centralizer of the range of
`Lp.multiplicationOperator`. -/
theorem coe_commutant_multiplicationAlgebra (μ : Measure α) :
    ((multiplicationAlgebra μ).commutant : Set (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)) =
      (Set.range (Lp.multiplicationOperator (E := ℂ) (μ := μ))).centralizer := by
  rw [multiplicationAlgebra_eq_adjoin, ← Lp.coe_range_multiplicationStarAlgHom μ ℂ,
    coe_commutant_adjoin, StarMemClass.star_coe_eq, Set.union_self]

/-- For **every** measure `μ` (without assuming `SigmaFinite μ`), `multiplicationAlgebra μ` equals
its own commutant: it is a maximal abelian self-adjoint subalgebra of `B(Lp ℂ 2 μ)`. -/
@[simp]
theorem commutant_multiplicationAlgebra (μ : Measure α) :
    (multiplicationAlgebra μ).commutant = multiplicationAlgebra μ := by
  refine le_antisymm ?_ ?_
  · intro T hT
    rw [← commutant_commutant (multiplicationAlgebra μ), mem_commutant_iff]
    intro S hS
    rw [← SetLike.mem_coe, coe_commutant_multiplicationAlgebra] at hS hT
    exact (Lp.commute_of_mem_centralizer_range_multiplicationOperator hS hT).eq
  · rw [multiplicationAlgebra_le_iff]
    intro a
    rw [← SetLike.mem_coe, coe_commutant_multiplicationAlgebra]
    rintro _ ⟨b, rfl⟩
    exact (Lp.commute_multiplicationOperator b a).eq

/-- For **every** measure `μ` (without assuming `SigmaFinite μ`), a bounded operator on
`Lp ℂ 2 μ` lies in `multiplicationAlgebra μ` if and only if it commutes with every finite-measure
measurable-set indicator multiplication operator. -/
theorem mem_multiplicationAlgebra_iff_forall_commute_indicatorMultiplication {μ : Measure α}
    {T : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ} :
    T ∈ multiplicationAlgebra μ ↔
      ∀ ⦃s : Set α⦄ (hs : MeasurableSet s), μ s ≠ ∞ →
        Commute T (Lp.indicatorMultiplication ℂ 2 hs) := by
  refine ⟨fun hT s hs _ ↦ ?_, fun hT ↦ ?_⟩
  · rw [← commutant_multiplicationAlgebra] at hT
    exact (commute_iff_eq _ _).mpr
      ((mem_commutant_iff.mp hT) _ (indicatorMultiplication_mem_multiplicationAlgebra μ hs)).symm
  · rw [← commutant_multiplicationAlgebra, ← SetLike.mem_coe, coe_commutant_multiplicationAlgebra]
    rintro _ ⟨a, rfl⟩
    exact (commute_iff_eq _ _).mp <|
      Lp.commute_of_forall_commute_indicatorMultiplication
        (fun _ hs _ ↦ by
          rw [← Lp.multiplicationOperator_linftyIndicator hs]
          exact Lp.commute_multiplicationOperator a _) hT

instance instIsMulCommutativeMultiplicationAlgebra (μ : Measure α) :
    IsMulCommutative (multiplicationAlgebra μ) :=
  isMulCommutative_of_commutant_eq_self (commutant_multiplicationAlgebra μ)

open scoped IsMulCommutative in
noncomputable instance instCommCStarAlgebraMultiplicationAlgebra (μ : Measure α) :
    CommCStarAlgebra (multiplicationAlgebra μ) where

/-- Pointwise multiplication by essentially bounded complex functions, bundled as a unital
⋆-algebra homomorphism into `multiplicationAlgebra μ` (valid for any measure `μ`). -/
noncomputable def multiplicationStarAlgHom (μ : Measure α) :
    Lp ℂ ∞ μ →⋆ₐ[ℂ] multiplicationAlgebra μ :=
  (Lp.multiplicationStarAlgHom μ ℂ).codRestrict (multiplicationAlgebra μ).toStarSubalgebra
    fun a ↦ by
      rw [Lp.multiplicationStarAlgHom_apply]
      exact multiplicationOperator_mem_multiplicationAlgebra μ a

@[simp]
theorem coe_multiplicationStarAlgHom_apply {μ : Measure α} (a : Lp ℂ ∞ μ) :
    ((multiplicationStarAlgHom μ a : multiplicationAlgebra μ) : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) =
      Lp.multiplicationOperator a := by
  rw [multiplicationStarAlgHom, StarAlgHom.coe_codRestrict, Lp.multiplicationStarAlgHom_apply]

/-- If a measure `μ` has two measurable sets `s, t` of positive finite measure with null
intersection, then `multiplicationAlgebra μ` strictly contains the scalars `⊥`. -/
theorem bot_lt_multiplicationAlgebra {μ : Measure α} {s t : Set α}
    (hs : MeasurableSet s) (hμs0 : μ s ≠ 0) (hμs : μ s ≠ ∞)
    (ht : MeasurableSet t) (hμt0 : μ t ≠ 0) (hμt : μ t ≠ ∞)
    (hst : μ (s ∩ t) = 0) :
    ⊥ < multiplicationAlgebra μ := by
  refine bot_lt_iff_ne_bot.mpr fun hbot ↦ ?_
  have hmem : Lp.indicatorMultiplication (E := ℂ) ℂ 2 hs ∈
      (⊥ : VonNeumannAlgebra (Lp ℂ 2 μ)) :=
    hbot ▸ indicatorMultiplication_mem_multiplicationAlgebra μ hs
  obtain ⟨c, hc⟩ := mem_bot.mp hmem
  have hfs := congr($hc (indicatorConstLp 2 hs hμs (1 : ℂ)))
  have hft := congr($hc (indicatorConstLp 2 ht hμt (1 : ℂ)))
  rw [Lp.indicatorMultiplication_indicatorConstLp_self hs hμs (1 : ℂ)] at hfs
  rw [Lp.indicatorMultiplication_indicatorConstLp hs ht hμt (1 : ℂ)] at hft
  have hfs0 : indicatorConstLp 2 hs hμs (1 : ℂ) ≠ 0 := by
    simp [TauCeti.indicatorConstLp_eq_zero_iff, hμs0]
  have hft0 : indicatorConstLp 2 ht hμt (1 : ℂ) ≠ 0 := by
    simp [TauCeti.indicatorConstLp_eq_zero_iff, hμt0]
  have hc1 : c = 1 := by
    have h1 : (c - 1) • indicatorConstLp 2 hs hμs (1 : ℂ) = 0 := by
      rw [sub_smul, one_smul, sub_eq_zero]
      simpa [Algebra.algebraMap_eq_smul_one] using hfs
    exact sub_eq_zero.mp ((smul_eq_zero.mp h1).resolve_right hfs0)
  have hzero : indicatorConstLp 2 (hs.inter ht)
      ((measure_mono Set.inter_subset_right).trans_lt hμt.lt_top).ne (1 : ℂ) = 0 := by
    rw [TauCeti.indicatorConstLp_eq_zero_iff]
    exact Or.inl hst
  have hc0 : c = 0 := by
    have h0 : c • indicatorConstLp 2 ht hμt (1 : ℂ) = 0 := by
      simpa [Algebra.algebraMap_eq_smul_one, hzero] using hft
    exact (smul_eq_zero.mp h0).resolve_right hft0
  exact one_ne_zero (hc1.symm.trans hc0)

/-- If a measure `μ` has two measurable sets `s, t` of positive finite measure with null
intersection, then `multiplicationAlgebra μ` is strictly contained in `⊤ = B(Lp ℂ 2 μ)`. -/
theorem multiplicationAlgebra_lt_top {μ : Measure α} {s t : Set α}
    (hs : MeasurableSet s) (hμs0 : μ s ≠ 0) (hμs : μ s ≠ ∞)
    (ht : MeasurableSet t) (hμt0 : μ t ≠ 0) (hμt : μ t ≠ ∞)
    (hst : μ (s ∩ t) = 0) :
    multiplicationAlgebra μ < ⊤ :=
  lt_top_iff_ne_top.mpr fun htop ↦
    (bot_lt_multiplicationAlgebra hs hμs0 hμs ht hμt0 hμt hst).ne' <|
      (eq_top_iff_eq_bot_of_commutant_eq_self (commutant_multiplicationAlgebra _)).mp htop

end General

section SigmaFinite

variable {α : Type*} [MeasurableSpace α] (μ : Measure α) [SigmaFinite μ]

/-- For a `σ`-finite measure `μ`, `multiplicationAlgebra μ` consists precisely of the `L∞`
multiplication operators on `Lp ℂ 2 μ`. -/
theorem coe_multiplicationAlgebra :
    (multiplicationAlgebra μ : Set (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)) =
      Set.range (Lp.multiplicationOperator (E := ℂ) (μ := μ)) := by
  rw [← commutant_multiplicationAlgebra, coe_commutant_multiplicationAlgebra,
    Lp.centralizer_range_multiplicationOperator]

theorem mem_multiplicationAlgebra_iff {μ : Measure α} [SigmaFinite μ]
    {T : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ} :
    T ∈ multiplicationAlgebra μ ↔ ∃ a : Lp ℂ ∞ μ, Lp.multiplicationOperator a = T := by
  rw [← SetLike.mem_coe, coe_multiplicationAlgebra, Set.mem_range]

private theorem bijective_multiplicationStarAlgHom :
    Function.Bijective (multiplicationStarAlgHom μ) := by
  refine ⟨fun _ _ h ↦ Lp.multiplicationOperator_injective (E := ℂ) (p := 2) ?_,
    fun ⟨_, hT⟩ ↦ ?_⟩
  · simpa only [coe_multiplicationStarAlgHom_apply] using congrArg Subtype.val h
  · obtain ⟨a, ha⟩ := mem_multiplicationAlgebra_iff.mp hT
    exact ⟨a, Subtype.ext (by rwa [coe_multiplicationStarAlgHom_apply])⟩

/-- For a `σ`-finite measure `μ`, `Lp.multiplicationOperator` restricts in codomain to a star
algebra isomorphism `Lp ℂ ∞ μ ≃⋆ₐ[ℂ] multiplicationAlgebra μ`. -/
noncomputable def multiplicationStarAlgEquiv : Lp ℂ ∞ μ ≃⋆ₐ[ℂ] multiplicationAlgebra μ :=
  StarAlgEquiv.ofBijective (multiplicationStarAlgHom μ) (bijective_multiplicationStarAlgHom μ)

@[simp]
theorem coe_multiplicationStarAlgEquiv_apply {μ : Measure α} [SigmaFinite μ] (a : Lp ℂ ∞ μ) :
    ((multiplicationStarAlgEquiv μ a : multiplicationAlgebra μ) : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) =
      Lp.multiplicationOperator a := by
  rw [multiplicationStarAlgEquiv, StarAlgEquiv.ofBijective_apply,
    coe_multiplicationStarAlgHom_apply]

@[simp]
theorem multiplicationOperator_multiplicationStarAlgEquiv_symm {μ : Measure α} [SigmaFinite μ]
    (T : multiplicationAlgebra μ) :
    Lp.multiplicationOperator ((multiplicationStarAlgEquiv μ).symm T) =
      (T : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) := by
  rw [← coe_multiplicationStarAlgEquiv_apply, StarAlgEquiv.apply_symm_apply]

@[simp]
theorem multiplicationStarAlgEquiv_symm_multiplicationStarAlgHom {μ : Measure α} [SigmaFinite μ]
    (a : Lp ℂ ∞ μ) :
    (multiplicationStarAlgEquiv μ).symm (multiplicationStarAlgHom μ a) = a :=
  (multiplicationStarAlgEquiv μ).symm_apply_apply a

/-- The `L∞` multiplication representation as a linear isometric equivalence onto
`multiplicationAlgebra μ` when `μ` is `σ`-finite. -/
noncomputable def multiplicationLinearIsometryEquiv :
    Lp ℂ ∞ μ ≃ₗᵢ[ℂ] multiplicationAlgebra μ :=
  { (multiplicationStarAlgEquiv μ).toAlgEquiv.toLinearEquiv with
    norm_map' := StarAlgEquiv.norm_map (multiplicationStarAlgEquiv μ) }

@[simp]
theorem multiplicationLinearIsometryEquiv_apply {μ : Measure α} [SigmaFinite μ]
    (a : Lp ℂ ∞ μ) :
    multiplicationLinearIsometryEquiv μ a = multiplicationStarAlgEquiv μ a := by
  rfl

@[simp]
theorem multiplicationLinearIsometryEquiv_symm_apply {μ : Measure α} [SigmaFinite μ]
    (T : multiplicationAlgebra μ) :
    (multiplicationLinearIsometryEquiv μ).symm T = (multiplicationStarAlgEquiv μ).symm T :=
  EquivLike.injective (multiplicationStarAlgEquiv μ) <| by
    rw [← multiplicationLinearIsometryEquiv_apply, LinearIsometryEquiv.apply_symm_apply,
      StarAlgEquiv.apply_symm_apply]

instance instNontrivialMultiplicationAlgebra [NeZero μ] :
    Nontrivial (multiplicationAlgebra μ) :=
  (multiplicationStarAlgEquiv μ).symm.toEquiv.nontrivial

end SigmaFinite

section MeasurePreserving

variable {α β : Type*} [MeasurableSpace α] [MeasurableSpace β] {μ : Measure α} {ν : Measure β}
  {f : α → β} {g : β → α}

/-- The `L²` unitary equivalence induced by an almost-everywhere inverse pair of measure-preserving
maps conjugates `multiplicationAlgebra ν` onto `multiplicationAlgebra μ` (with no `SigmaFinite` or
`IsProbabilityMeasure` assumption). -/
@[simp]
theorem conj_multiplicationAlgebra_compMeasurePreservingₗᵢEquiv
    (hf : MeasurePreserving f μ ν) (hg : MeasurePreserving g ν μ) (hfg : f ∘ g =ᵐ[ν] id) :
    (multiplicationAlgebra ν).conj
        (Lp.compMeasurePreservingₗᵢEquiv ℂ (E := ℂ) (p := 2) hf hg hfg) =
      multiplicationAlgebra μ := by
  rw [multiplicationAlgebra_eq_adjoin, multiplicationAlgebra_eq_adjoin, conj_adjoin]
  congr 1
  ext T
  simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and,
    Lp.conjStarAlgEquiv_compMeasurePreservingₗᵢEquiv_multiplicationOperator]
  let eTop := Lp.compMeasurePreservingₗᵢEquiv ℂ (E := ℂ) (p := ∞) hf hg hfg
  refine ⟨fun ⟨a, ha⟩ ↦ ⟨Lp.compMeasurePreserving f hf a, ha⟩, fun ⟨b, hb⟩ ↦ ⟨eTop.symm b, ?_⟩⟩
  have hcomp : Lp.compMeasurePreserving f hf (eTop.symm b) = b := by
    rw [← Lp.compMeasurePreservingₗᵢEquiv_apply ℂ (E := ℂ) (p := ∞) hf hg hfg]
    exact eTop.apply_symm_apply b
  rw [hcomp, hb]

/-- Star algebra isomorphism `multiplicationAlgebra ν ≃⋆ₐ[ℂ] multiplicationAlgebra μ` induced by an
almost-everywhere inverse pair of measure-preserving maps. -/
noncomputable def multiplicationAlgebraCompMeasurePreservingStarAlgEquiv
    (hf : MeasurePreserving f μ ν) (hg : MeasurePreserving g ν μ) (hfg : f ∘ g =ᵐ[ν] id) :
    multiplicationAlgebra ν ≃⋆ₐ[ℂ] multiplicationAlgebra μ :=
  ((multiplicationAlgebra ν).conjStarAlgEquiv
    (Lp.compMeasurePreservingₗᵢEquiv ℂ (E := ℂ) (p := 2) hf hg hfg)).trans <|
      equivOfEq (conj_multiplicationAlgebra_compMeasurePreservingₗᵢEquiv hf hg hfg)

@[simp]
theorem coe_multiplicationAlgebraCompMeasurePreservingStarAlgEquiv_apply
    (hf : MeasurePreserving f μ ν) (hg : MeasurePreserving g ν μ) (hfg : f ∘ g =ᵐ[ν] id)
    (T : multiplicationAlgebra ν) :
    ((multiplicationAlgebraCompMeasurePreservingStarAlgEquiv hf hg hfg T :
        multiplicationAlgebra μ) : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) =
      (Lp.compMeasurePreservingₗᵢEquiv ℂ (E := ℂ) (p := 2) hf hg hfg).conjStarAlgEquiv T := by
  simp [multiplicationAlgebraCompMeasurePreservingStarAlgEquiv]

@[simp]
theorem coe_multiplicationAlgebraCompMeasurePreservingStarAlgEquiv_symm_apply
    (hf : MeasurePreserving f μ ν) (hg : MeasurePreserving g ν μ) (hfg : f ∘ g =ᵐ[ν] id)
    (T : multiplicationAlgebra μ) :
    (((multiplicationAlgebraCompMeasurePreservingStarAlgEquiv hf hg hfg).symm T :
        multiplicationAlgebra ν) : Lp ℂ 2 ν →L[ℂ] Lp ℂ 2 ν) =
      (Lp.compMeasurePreservingₗᵢEquiv ℂ (E := ℂ) (p := 2) hf hg hfg).symm.conjStarAlgEquiv T := by
  simp [multiplicationAlgebraCompMeasurePreservingStarAlgEquiv]

@[simp]
theorem multiplicationAlgebraCompMeasurePreservingStarAlgEquiv_multiplicationStarAlgHom
    (hf : MeasurePreserving f μ ν) (hg : MeasurePreserving g ν μ) (hfg : f ∘ g =ᵐ[ν] id)
    (a : Lp ℂ ∞ ν) :
    multiplicationAlgebraCompMeasurePreservingStarAlgEquiv hf hg hfg
        (multiplicationStarAlgHom ν a) =
      multiplicationStarAlgHom μ (Lp.compMeasurePreserving f hf a) := by
  apply Subtype.ext
  rw [coe_multiplicationAlgebraCompMeasurePreservingStarAlgEquiv_apply,
    coe_multiplicationStarAlgHom_apply, coe_multiplicationStarAlgHom_apply,
    Lp.conjStarAlgEquiv_compMeasurePreservingₗᵢEquiv_multiplicationOperator]

end MeasurePreserving

section ConcreteModels

variable {α : Type*} [MeasurableSpace α]

/-! ### The zero measure -/

-- On the zero measure space, `Lp ℂ 2 0` is trivial, so `multiplicationAlgebra 0` is a
-- subsingleton (`0 = 1`, the zero C⋆-algebra).
example : Subsingleton (multiplicationAlgebra (0 : Measure α)) :=
  inferInstance

/-! ### Dirac point masses -/

@[simp]
theorem multiplicationAlgebra_dirac_eq_bot (x₀ : α) :
    multiplicationAlgebra (Measure.dirac x₀) = ⊥ := by
  refine le_bot_iff.mp (multiplicationAlgebra_le_iff.mpr fun a ↦ ?_)
  obtain ⟨c, rfl⟩ := Lp.exists_eq_algebraMap_dirac a
  rw [mem_bot]
  exact ⟨c, by
    rw [Lp.multiplicationOperator_algebraMap, Algebra.algebraMap_eq_smul_one,
      ContinuousLinearMap.one_def]⟩

theorem multiplicationAlgebra_dirac_eq_top (x₀ : α) :
    multiplicationAlgebra (Measure.dirac x₀) = ⊤ := by
  rw [← commutant_multiplicationAlgebra, multiplicationAlgebra_dirac_eq_bot, commutant_bot]

/-- For any point `x₀ : α`, `StarAlgHom.ofId ℂ (multiplicationAlgebra (Measure.dirac x₀))` upgrades
to a star algebra isomorphism `ℂ ≃⋆ₐ[ℂ] multiplicationAlgebra (Measure.dirac x₀)`. -/
noncomputable def multiplicationAlgebraDiracStarAlgEquiv (x₀ : α) :
    ℂ ≃⋆ₐ[ℂ] multiplicationAlgebra (Measure.dirac x₀) :=
  StarAlgEquiv.ofBijective (StarAlgHom.ofId ℂ (multiplicationAlgebra (Measure.dirac x₀)))
    (by
      refine ⟨(StarAlgHom.ofId ℂ (multiplicationAlgebra (Measure.dirac x₀))).toRingHom.injective,
        fun T ↦ ?_⟩
      have hT : (T : Lp ℂ 2 (Measure.dirac x₀) →L[ℂ] Lp ℂ 2 (Measure.dirac x₀)) ∈
          (⊥ : VonNeumannAlgebra (Lp ℂ 2 (Measure.dirac x₀))) := by
        simpa [multiplicationAlgebra_dirac_eq_bot] using T.property
      obtain ⟨c, hc⟩ := mem_bot.mp hT
      refine ⟨c, Subtype.ext ?_⟩
      rw [StarAlgHom.ofId_apply, Algebra.algebraMap_eq_smul_one, SetLike.val_smul,
        OneMemClass.coe_one, ← Algebra.algebraMap_eq_smul_one, hc])

@[simp]
theorem multiplicationAlgebraDiracStarAlgEquiv_apply (x₀ : α) (c : ℂ) :
    multiplicationAlgebraDiracStarAlgEquiv x₀ c =
      algebraMap ℂ (multiplicationAlgebra (Measure.dirac x₀)) c := by
  simpa using AlgHomClass.commutes (multiplicationAlgebraDiracStarAlgEquiv x₀) c

theorem coe_multiplicationAlgebraDiracStarAlgEquiv_apply (x₀ : α) (c : ℂ) :
    ((multiplicationAlgebraDiracStarAlgEquiv x₀ c :
        multiplicationAlgebra (Measure.dirac x₀)) :
      Lp ℂ 2 (Measure.dirac x₀) →L[ℂ] Lp ℂ 2 (Measure.dirac x₀)) = c • 1 := by
  rw [multiplicationAlgebraDiracStarAlgEquiv_apply, Algebra.algebraMap_eq_smul_one,
    SetLike.val_smul, OneMemClass.coe_one]

@[simp]
theorem algebraMap_multiplicationAlgebraDiracStarAlgEquiv_symm (x₀ : α)
    (T : multiplicationAlgebra (Measure.dirac x₀)) :
    algebraMap ℂ (multiplicationAlgebra (Measure.dirac x₀))
        ((multiplicationAlgebraDiracStarAlgEquiv x₀).symm T) = T := by
  rw [← multiplicationAlgebraDiracStarAlgEquiv_apply, StarAlgEquiv.apply_symm_apply]

@[simp]
theorem multiplicationAlgebraDiracStarAlgEquiv_symm_algebraMap (x₀ : α) (c : ℂ) :
    (multiplicationAlgebraDiracStarAlgEquiv x₀).symm
        (algebraMap ℂ (multiplicationAlgebra (Measure.dirac x₀)) c) = c := by
  rw [← multiplicationAlgebraDiracStarAlgEquiv_apply, StarAlgEquiv.symm_apply_apply]

/-! ### Counting measure (diagonal algebra `ℂ^α`) -/

/-- On any measurable-singleton space with at least two points, the diagonal multiplication algebra
strictly contains the scalars `⊥`. -/
theorem bot_lt_multiplicationAlgebra_count [MeasurableSingletonClass α] [Nontrivial α] :
    ⊥ < multiplicationAlgebra (Measure.count : Measure α) := by
  obtain ⟨x, y, hxy⟩ := exists_pair_ne α
  exact bot_lt_multiplicationAlgebra (measurableSet_singleton x) (by simp) (by simp)
    (measurableSet_singleton y) (by simp) (by simp) (by simp [hxy])

/-- On any measurable-singleton space with at least two points, the diagonal multiplication algebra
is strictly contained in `⊤ = B(Lp ℂ 2 Measure.count)`. -/
theorem multiplicationAlgebra_count_lt_top [MeasurableSingletonClass α] [Nontrivial α] :
    multiplicationAlgebra (Measure.count : Measure α) < ⊤ := by
  obtain ⟨x, y, hxy⟩ := exists_pair_ne α
  exact multiplicationAlgebra_lt_top (measurableSet_singleton x) (by simp) (by simp)
    (measurableSet_singleton y) (by simp) (by simp) (by simp [hxy])

section FiniteCount

variable [Finite α] [MeasurableSingletonClass α]

/-- For a finite measurable-singleton space `α`, `multiplicationAlgebra (Measure.count : Measure α)`
is star-isomorphic to the diagonal algebra `α → ℂ`. -/
noncomputable def multiplicationAlgebraCountStarAlgEquiv :
    (α → ℂ) ≃⋆ₐ[ℂ] multiplicationAlgebra (Measure.count : Measure α) :=
  (Lp.countStarAlgEquiv α ℂ ℂ).trans (multiplicationStarAlgEquiv (Measure.count : Measure α))

@[simp]
theorem coe_multiplicationAlgebraCountStarAlgEquiv_apply (f : α → ℂ) :
    ((multiplicationAlgebraCountStarAlgEquiv f :
        multiplicationAlgebra (Measure.count : Measure α)) :
      Lp ℂ 2 (Measure.count : Measure α) →L[ℂ] Lp ℂ 2 (Measure.count : Measure α)) =
      Lp.multiplicationOperator (MemLp.of_discrete.toLp f) := by
  rw [multiplicationAlgebraCountStarAlgEquiv, StarAlgEquiv.trans_apply,
    Lp.countStarAlgEquiv_apply, coe_multiplicationStarAlgEquiv_apply]

@[simp]
theorem multiplicationAlgebraCountStarAlgEquiv_symm_apply
    (T : multiplicationAlgebra (Measure.count : Measure α)) :
    multiplicationAlgebraCountStarAlgEquiv.symm T =
      ⇑((multiplicationStarAlgEquiv (Measure.count : Measure α)).symm T) := by
  rw [multiplicationAlgebraCountStarAlgEquiv, StarAlgEquiv.symm_trans_apply,
    Lp.countStarAlgEquiv_symm_apply]

/-- On a finite measurable-singleton space `α`, the complex dimension of
`multiplicationAlgebra (Measure.count : Measure α)` is `Nat.card α`. -/
@[simp]
theorem finrank_multiplicationAlgebra_count :
    Module.finrank ℂ (multiplicationAlgebra (Measure.count : Measure α)) = Nat.card α := by
  cases nonempty_fintype α
  rw [← (multiplicationAlgebraCountStarAlgEquiv (α := α)).toAlgEquiv.toLinearEquiv.finrank_eq,
    Module.finrank_pi, Nat.card_eq_fintype_card]

end FiniteCount

/-! ### Atomless measures: absence of minimal projections -/

/-- If `P ∈ multiplicationAlgebra μ` is an idempotent whose product with the indicator of a
finite-measure measurable set `E` equals `multiplicationStarAlgHom μ p` for a symbol `p` supported
on `E`, then `p` is an idempotent in `Lp ℂ ∞ μ`. -/
private theorem isIdempotentElem_of_mul_linftyIndicator_eq {μ : Measure α}
    {E : Set α} (hE : MeasurableSet E) (hμE : μ E ≠ ∞)
    {P : multiplicationAlgebra μ} (hP : IsIdempotentElem P) {p : Lp ℂ ∞ μ}
    (hpe : p * TauCeti.linftyIndicator μ ℂ E hE = p)
    (hPE : P * multiplicationStarAlgHom μ (TauCeti.linftyIndicator μ ℂ E hE) =
      multiplicationStarAlgHom μ p) :
    IsIdempotentElem p := by
  set E_op : multiplicationAlgebra μ :=
    multiplicationStarAlgHom μ (TauCeti.linftyIndicator μ ℂ E hE)
  have hE_idem : E_op * E_op = E_op := by
    rw [← map_mul, (TauCeti.isIdempotentElem_linftyIndicator hE).eq]
  have hS_idem : multiplicationStarAlgHom μ (p * p) = multiplicationStarAlgHom μ p := by
    rw [map_mul, ← hPE, mul_mul_mul_comm, hP.eq, hE_idem]
  exact sub_eq_zero.mp <|
    Lp.eq_zero_of_mul_linftyIndicator_eq_self_of_multiplicationOperator_eq_zero (E := ℂ) hE hμE
      (by rw [sub_mul, mul_assoc, hpe])
      (by
        rw [Lp.multiplicationOperator_sub, sub_eq_zero]
        simpa only [coe_multiplicationStarAlgHom_apply] using congrArg Subtype.val hS_idem)

/-- A nonzero idempotent `P ∈ multiplicationAlgebra μ` restricts on some finite-measure measurable
set `E` to multiplication by the indicator of a positive-measure measurable subset `s ⊆ E` (with
no `SigmaFinite` hypothesis on `μ`). -/
private theorem exists_measurableSet_subset_and_mul_linftyIndicator_eq {μ : Measure α}
    {P : multiplicationAlgebra μ} (hP : IsIdempotentElem P) (hP0 : P ≠ 0) :
    ∃ (E : Set α) (hE : MeasurableSet E) (_ : μ E ≠ ∞) (s : Set α) (hs : MeasurableSet s),
      s ⊆ E ∧ 0 < μ s ∧
      P * multiplicationStarAlgHom μ (TauCeti.linftyIndicator μ ℂ E hE) =
        multiplicationStarAlgHom μ (TauCeti.linftyIndicator μ ℂ s hs) := by
  have ⟨E, hE, hμE, c, hPEc⟩ :
      ∃ (E : Set α) (hE : MeasurableSet E) (hμE : μ E ≠ ∞) (c : ℂ),
        (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) (indicatorConstLp 2 hE hμE c) ≠ 0 := by
    by_contra! hall
    exact hP0 (Subtype.ext (ContinuousLinearMap.eq_zero_of_apply_indicatorConstLp
      ENNReal.ofNat_ne_top (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) hall))
  set eE := TauCeti.linftyIndicator μ ℂ E hE with heE_def
  have hPcomm : ∀ b : Lp ℂ ∞ μ,
      Commute (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) (Lp.multiplicationOperator b) := fun b ↦
    (commute_iff_eq _ _).mpr <| by
      simpa only [MulMemClass.coe_mul, coe_multiplicationStarAlgHom_apply] using
        congrArg Subtype.val (mul_comm P (multiplicationStarAlgHom μ b))
  obtain ⟨b, -, hb_eq⟩ := Lp.exists_norm_le_and_comp_indicatorMultiplication_eq
    hE hμE (P : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) fun _ ht _ ↦ by
      rw [← Lp.multiplicationOperator_linftyIndicator ht]; exact hPcomm _
  set p : Lp ℂ ∞ μ := b * eE with hp_def
  have hPE : P * multiplicationStarAlgHom μ eE = multiplicationStarAlgHom μ p :=
    Subtype.ext <| by
      rw [MulMemClass.coe_mul, ContinuousLinearMap.mul_def, coe_multiplicationStarAlgHom_apply,
        coe_multiplicationStarAlgHom_apply, Lp.multiplicationOperator_linftyIndicator, hb_eq,
        ← Lp.multiplicationOperator_linftyIndicator,
        Lp.multiplicationOperator_comp_multiplicationOperator, hp_def]
  have hpe : p * eE = p := by
    rw [hp_def, mul_assoc, (TauCeti.isIdempotentElem_linftyIndicator hE).eq]
  obtain ⟨s₀, hs₀, hp_s₀⟩ := Lp.exists_measurableSet_eq_linftyIndicator_of_isIdempotentElem
    (isIdempotentElem_of_mul_linftyIndicator_eq hE hμE hP hpe hPE)
  have hp_s : p = TauCeti.linftyIndicator μ ℂ (s₀ ∩ E) (hs₀.inter hE) := by
    rw [← hpe, hp_s₀, heE_def, TauCeti.linftyIndicator_mul_linftyIndicator]
  refine ⟨E, hE, hμE, s₀ ∩ E, hs₀.inter hE, Set.inter_subset_right,
    pos_iff_ne_zero.mpr fun h0 ↦ hPEc ?_, hPE.trans (congrArg _ hp_s)⟩
  have hzero : multiplicationStarAlgHom μ p = 0 := by
    rw [hp_s, (TauCeti.linftyIndicator_eq_zero_iff (hs₀.inter hE)).mpr h0, map_zero]
  have hPE_val := congrArg Subtype.val (hPE.trans hzero)
  have h0' := congr($hPE_val (indicatorConstLp 2 hE hμE c))
  simpa only [MulMemClass.coe_mul, coe_multiplicationStarAlgHom_apply,
    mul_apply_eq_comp, ContinuousLinearMap.comp_apply, eE,
    Lp.multiplicationOperator_linftyIndicator,
    Lp.indicatorMultiplication_indicatorConstLp_self hE hμE c,
    ZeroMemClass.coe_zero, zero_apply] using h0'

/-- Indicator multiplication by any measurable set `t` defines a star projection in
`multiplicationAlgebra μ`. -/
theorem isStarProjection_indicatorMultiplication {μ : Measure α}
    {t : Set α} (ht : MeasurableSet t) :
    IsStarProjection (⟨Lp.indicatorMultiplication ℂ 2 ht,
      indicatorMultiplication_mem_multiplicationAlgebra μ ht⟩ : multiplicationAlgebra μ) := by
  have h : multiplicationStarAlgHom μ (TauCeti.linftyIndicator μ ℂ t ht) =
      ⟨Lp.indicatorMultiplication ℂ 2 ht,
        indicatorMultiplication_mem_multiplicationAlgebra μ ht⟩ :=
    Subtype.ext <| by
      rw [coe_multiplicationStarAlgHom_apply, Lp.multiplicationOperator_linftyIndicator]
  rw [← h]
  exact (TauCeti.isStarProjection_linftyIndicator (μ := μ) (R := ℂ) ht).map
    (multiplicationStarAlgHom μ)

/-- For any measure `μ` with no finite-mass atoms (`∀ s, μ s ≠ ∞ → ¬ μ.IsAtom s`, with **no**
`SigmaFinite` assumption), every nonzero idempotent — in particular every nonzero star projection —
`P ∈ multiplicationAlgebra μ` dominates a strictly smaller nonzero star projection
`Q ∈ multiplicationAlgebra μ` (`Q * P = Q` and `0 ≠ Q ≠ P`): `multiplicationAlgebra μ` has no
minimal projections. -/
theorem exists_multiplicationAlgebra_isStarProjection_ne_zero_and_mul_eq_and_ne_of_not_isAtom
    {μ : Measure α} (hμ : ∀ s, μ s ≠ ∞ → ¬ μ.IsAtom s) {P : multiplicationAlgebra μ}
    (hP : IsIdempotentElem P) (hP0 : P ≠ 0) :
    ∃ Q : multiplicationAlgebra μ, IsStarProjection Q ∧ Q ≠ 0 ∧ Q * P = Q ∧ Q ≠ P := by
  obtain ⟨E, hE, hμE, s, hs, hsE, hμs_pos, hPE⟩ :=
    exists_measurableSet_subset_and_mul_linftyIndicator_eq hP hP0
  have hμs_fin : μ s ≠ ∞ := ((measure_mono hsE).trans_lt hμE.lt_top).ne
  obtain ⟨t, hts, ht, hμt_pos, hμts_lt⟩ :=
    (Measure.IsAtom.not_isAtom_iff_exists hs hμs_pos).mp (hμ s hμs_fin)
  have hμt_fin : μ t ≠ ∞ := ((measure_mono (hts.trans hsE)).trans_lt hμE.lt_top).ne
  set q := TauCeti.linftyIndicator μ ℂ t ht
  set eE := TauCeti.linftyIndicator μ ℂ E hE
  set es := TauCeti.linftyIndicator μ ℂ s hs
  let Q : multiplicationAlgebra μ := multiplicationStarAlgHom μ q
  have hQE : Q * multiplicationStarAlgHom μ eE = Q := by
    dsimp only [Q]
    rw [← map_mul,
      TauCeti.linftyIndicator_mul_linftyIndicator_of_subset_left ht hE (hts.trans hsE)]
  refine ⟨Q, (TauCeti.isStarProjection_linftyIndicator (μ := μ) (R := ℂ) ht).map
    (multiplicationStarAlgHom μ), ?_, ?_, ?_⟩
  · intro hQ0
    have hq_op : Lp.multiplicationOperator (E := ℂ) (p := 2) q = 0 := by
      simpa only [Q, coe_multiplicationStarAlgHom_apply, ZeroMemClass.coe_zero] using
        congrArg Subtype.val hQ0
    have hq0 : q = 0 :=
      Lp.eq_zero_of_mul_linftyIndicator_eq_self_of_multiplicationOperator_eq_zero ht hμt_fin
        (TauCeti.isIdempotentElem_linftyIndicator ht).eq hq_op
    exact hμt_pos.ne' ((TauCeti.linftyIndicator_eq_zero_iff ht).mp hq0)
  · have hQS : Q * multiplicationStarAlgHom μ es = Q := by
      dsimp only [Q]
      rw [← map_mul, TauCeti.linftyIndicator_mul_linftyIndicator_of_subset_left ht hs hts]
    calc Q * P = (Q * multiplicationStarAlgHom μ eE) * P := by rw [hQE]
      _ = Q * (P * multiplicationStarAlgHom μ eE) := by rw [mul_assoc, mul_comm _ P]
      _ = Q := by rw [hPE, hQS]
  · intro hQP
    have hqt_eq_s :
        Lp.indicatorMultiplication (E := ℂ) (μ := μ) ℂ 2 ht =
          Lp.indicatorMultiplication (E := ℂ) (μ := μ) ℂ 2 hs := by
      have h1 : Q = multiplicationStarAlgHom μ es := by
        calc Q = Q * multiplicationStarAlgHom μ eE := hQE.symm
          _ = P * multiplicationStarAlgHom μ eE := by rw [hQP]
          _ = multiplicationStarAlgHom μ es := hPE
      simpa only [Q, q, es, coe_multiplicationStarAlgHom_apply,
        Lp.multiplicationOperator_linftyIndicator] using congrArg Subtype.val h1
    exact hμts_lt.ne <| measure_congr <|
      Lp.ae_eq_of_indicatorMultiplication_eq ht hμt_fin hs hμs_fin hqt_eq_s

/-- On any countably separated measurable space with null singletons (such as
`(unitInterval, volume)` or `(ℝ, volume)`), every nonzero idempotent — in particular every nonzero
star projection — in `multiplicationAlgebra μ` dominates a strictly smaller nonzero star projection
(with no `SigmaFinite` assumption on `μ`). -/
theorem exists_multiplicationAlgebra_isStarProjection_ne_zero_and_mul_eq_and_ne
    [MeasurableSpace.CountablySeparated α] (μ : Measure α) [NullSingletonClass μ]
    {P : multiplicationAlgebra μ} (hP : IsIdempotentElem P) (hP0 : P ≠ 0) :
    ∃ Q : multiplicationAlgebra μ, IsStarProjection Q ∧ Q ≠ 0 ∧ Q * P = Q ∧ Q ≠ P :=
  exists_multiplicationAlgebra_isStarProjection_ne_zero_and_mul_eq_and_ne_of_not_isAtom
    (fun _ hfin ↦ Measure.not_isAtom_of_nullSingletonClass_of_measure_ne_top hfin) hP hP0

end ConcreteModels

