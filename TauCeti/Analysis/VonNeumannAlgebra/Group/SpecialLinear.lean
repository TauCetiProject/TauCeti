module

public import TauCeti.Analysis.VonNeumannAlgebra.Group.Factor
public import TauCeti.GroupTheory.SemidirectProduct.SpecialLinear

/-!
# The group von Neumann algebra of `ℤ² ⋊ G` is a factor

For a nonamenable group `G` embedded in `SL(2, ℤ)`, every nontrivial conjugacy class of `ℤ² ⋊ G`
is infinite (`TauCeti.infinite_setOf_isConj_semidirectProduct_slTwo_of_not_amenable`), so by
Murray and von Neumann's ICC factor theorem (`TauCeti.isFactor_groupVonNeumannAlgebra_iff`) its
group von Neumann algebra `L(ℤ² ⋊ G)` is a factor. This applies to every finite-index subgroup of
`SL(2, ℤ)`, including `SL(2, ℤ)` itself and the free subgroup generated by `[[1, 2], [0, 1]]` and
`[[1, 0], [2, 1]]`, which has index `12`.

## Main statements

* `TauCeti.isFactor_groupVonNeumannAlgebra_semidirectProduct_slTwo_of_not_amenable`:
  `L(ℤ² ⋊ G)` is a factor for nonamenable `G` embedded in `SL(2, ℤ)`.
* `Subgroup.isFactor_groupVonNeumannAlgebra_semidirectProduct_slTwo_of_finiteIndex`:
  `L(ℤ² ⋊ G)` is a factor for every finite-index subgroup `G ≤ SL(2, ℤ)`.

## References

* C. Anantharaman and S. Popa, *An Introduction to II₁ Factors*, Proposition 1.3.7 and
  Example 18.1.5.
-/

public section

open MeasureTheory
open scoped MatrixGroups

namespace TauCeti

/-- For a nonamenable group `G` embedded in `SL(2, ℤ)` by `ι`, the group von Neumann algebra of
`ℤ² ⋊ G` is a factor. -/
theorem isFactor_groupVonNeumannAlgebra_semidirectProduct_slTwo_of_not_amenable {G : Type*}
    [Group G] [TopologicalSpace G] [IsTopologicalGroup G] {ι : G →* SL(2, ℤ)}
    (hι : Function.Injective ι)
    (hG : ¬ Amenable G) [MeasurableSpace (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G)]
    [MeasurableMul (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G)]
    [MeasurableSingletonClass (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G)] :
    (groupVonNeumannAlgebra (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G)).IsFactor :=
  (isFactor_groupVonNeumannAlgebra_iff _).2 fun _ =>
    infinite_setOf_isConj_semidirectProduct_slTwo_of_not_amenable hι hG

end TauCeti

namespace Subgroup

open TauCeti

/-- For a finite-index subgroup `G ≤ SL(2, ℤ)`, the group von Neumann algebra of `ℤ² ⋊ G` is a
factor. -/
theorem isFactor_groupVonNeumannAlgebra_semidirectProduct_slTwo_of_finiteIndex
    (G : Subgroup SL(2, ℤ)) [G.FiniteIndex]
    [MeasurableSpace (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G)]
    [MeasurableMul (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G)]
    [MeasurableSingletonClass (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G)] :
    (groupVonNeumannAlgebra
      (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G)).IsFactor :=
  (isFactor_groupVonNeumannAlgebra_iff _).2 fun _ =>
    G.infinite_setOf_isConj_semidirectProduct_slTwo_of_finiteIndex

end Subgroup
