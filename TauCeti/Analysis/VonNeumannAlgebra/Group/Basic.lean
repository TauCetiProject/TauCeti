/-!
# Group von Neumann algebras, mutual commutants, Fourier coefficients, and the canonical trace

Let `Γ` be a group equipped with a measurable multiplication (`[MeasurableMul Γ]`), acting on
counting-measure `L²(Γ)` (`Lp ℂ 2 (Measure.count : Measure Γ)`) via the left and right regular
representations `(Measure.count : Measure Γ).leftRegular ℂ ℂ 2` and
`(Measure.count : Measure Γ).rightRegular ℂ ℂ 2`. Any discrete group (`[DiscreteMeasurableSpace Γ]`)
satisfies both `[MeasurableMul Γ]` and `[MeasurableSingletonClass Γ]` automatically, without any
countability hypothesis on `Γ`.

* **Left and right group von Neumann algebras**: `TauCeti.groupVonNeumannAlgebra Γ` (`L(Γ)`) and
  `TauCeti.rightGroupVonNeumannAlgebra Γ` (`R(Γ)`) are the von Neumann algebras generated by the
  ranges of the left and right regular representations.
* **Mutual commutant theorem**: when singletons are measurable (`[MeasurableSingletonClass Γ]`),
  `L(Γ)' = R(Γ)` and `R(Γ)' = L(Γ)` (`TauCeti.commutant_groupVonNeumannAlgebra`,
  `TauCeti.commutant_rightGroupVonNeumannAlgebra`). Consequently the identity point mass
  `δ₁ = L2.countHilbertBasis ℂ Γ 1` is both cyclic and separating for `L(Γ)` and `R(Γ)`.
* **Fourier expansion and convolution**: for `x ∈ L(Γ)`, the coefficients
  `TauCeti.groupVonNeumannCoeff x g = ⟪δ_g, x δ₁⟫_ℂ` are square-summable, uniquely determine `x`
  (`TauCeti.eq_of_groupVonNeumannCoeff_eq`), satisfy
  `groupVonNeumannCoeff (star x) g = conj (groupVonNeumannCoeff x g⁻¹)`, and multiply by
  unconditional `ℓ²`-convolution (`TauCeti.hasSum_groupVonNeumannCoeff_mul`).
* **Canonical faithful normal tracial state and finiteness**: the vector functional
  `TauCeti.groupVonNeumannTrace Γ` (`x ↦ ⟪δ₁, x δ₁⟫_ℂ`) is a faithful normal tracial state on
  `L(Γ)`, making `L(Γ)` Dedekind-finite and finite (`TauCeti.isFinite_groupVonNeumannAlgebra`),
  and the canonical algebra homomorphism `TauCeti.groupAlgebraToVonNeumannAlgebra Γ` from
  `MonoidAlgebra ℂ Γ` into `L(Γ)` is injective.

## References

* J. Peterson, *Notes on von Neumann Algebras* (2013), Theorem 5.1.3 and Proposition 5.1.4.
* C. Anantharaman and S. Popa, *An Introduction to II₁ Factors*, §1.3.
-/

public section

open MeasureTheory VonNeumannAlgebra
open scoped ComplexConjugate ComplexOrder ENNReal InnerProductSpace

namespace TauCeti

section MeasurableMul

variable (Γ : Type*) [Group Γ] [MeasurableSpace Γ] [MeasurableMul Γ]

/-- **The group von Neumann algebra `L(Γ)`**, generated on `Lp ℂ 2 (Measure.count : Measure Γ)` by
the range of the left regular representation. -/
noncomputable def groupVonNeumannAlgebra :
    VonNeumannAlgebra (Lp ℂ 2 (Measure.count : Measure Γ)) :=
  VonNeumannAlgebra.adjoin (Set.range ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2))

/-- **The right group von Neumann algebra `R(Γ)`**, generated on
`Lp ℂ 2 (Measure.count : Measure Γ)` by the range of the right regular representation. -/
noncomputable def rightGroupVonNeumannAlgebra :
    VonNeumannAlgebra (Lp ℂ 2 (Measure.count : Measure Γ)) :=
  VonNeumannAlgebra.adjoin (Set.range ((Measure.count : Measure Γ).rightRegular ℂ ℂ 2))

theorem groupVonNeumannAlgebra_def :
    groupVonNeumannAlgebra Γ =
      VonNeumannAlgebra.adjoin (Set.range ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2)) :=
  (rfl)

theorem rightGroupVonNeumannAlgebra_def :
    rightGroupVonNeumannAlgebra Γ =
      VonNeumannAlgebra.adjoin (Set.range ((Measure.count : Measure Γ).rightRegular ℂ ℂ 2)) :=
  (rfl)

variable {Γ}

/-- Every left translation operator lies in `groupVonNeumannAlgebra Γ`. -/
theorem leftRegular_mem_groupVonNeumannAlgebra (g : Γ) :
    (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g ∈ groupVonNeumannAlgebra Γ :=
  VonNeumannAlgebra.subset_adjoin _ ⟨g, rfl⟩

/-- Every right translation operator lies in `rightGroupVonNeumannAlgebra Γ`. -/
theorem rightRegular_mem_rightGroupVonNeumannAlgebra (g : Γ) :
    (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 g ∈ rightGroupVonNeumannAlgebra Γ :=
  VonNeumannAlgebra.subset_adjoin _ ⟨g, rfl⟩

@[simp]
theorem star_leftRegular_count (g : Γ) :
    star ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g) =
      (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g⁻¹ := by
  rw [ContinuousLinearMap.star_eq_adjoint]
  exact (Measure.isUnitary_leftRegular Measure.count).adjoint_eq_inv g

@[simp]
theorem star_rightRegular_count (g : Γ) :
    star ((Measure.count : Measure Γ).rightRegular ℂ ℂ 2 g) =
      (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 g⁻¹ := by
  rw [ContinuousLinearMap.star_eq_adjoint]
  exact (Measure.isUnitary_rightRegular Measure.count).adjoint_eq_inv g

omit [MeasurableSpace Γ] [MeasurableMul Γ] in
private theorem mem_commutant_adjoin_range_iff {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] {π : ContRepresentation ℂ Γ H}
    (hπ : π.IsUnitary) {T : H →L[ℂ] H} :
    T ∈ (VonNeumannAlgebra.adjoin (Set.range π)).commutant ↔ ∀ g : Γ, π g * T = T * π g := by
  refine ⟨fun hT g => mem_commutant_iff.1 hT _ (VonNeumannAlgebra.subset_adjoin _ ⟨g, rfl⟩),
    fun hT => ?_⟩
  rw [← SetLike.mem_coe, coe_commutant_adjoin, Set.mem_centralizer_iff]
  rintro x (⟨g, rfl⟩ | hx)
  · exact hT g
  · obtain ⟨g, hg⟩ := Set.mem_star.1 hx
    have hstar : x = π g⁻¹ := by
      simpa [ContinuousLinearMap.star_eq_adjoint, hπ.adjoint_eq_inv] using congr_arg star hg.symm
    exact hstar ▸ hT g⁻¹

/-- An operator lies in `L(Γ)'` if and only if it commutes with every left regular unitary. -/
theorem mem_commutant_groupVonNeumannAlgebra_iff_leftRegular
    {T : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)} :
    T ∈ (groupVonNeumannAlgebra Γ).commutant ↔
      ∀ g : Γ, (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g * T =
        T * (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g :=
  mem_commutant_adjoin_range_iff (Measure.isUnitary_leftRegular Measure.count)

/-- An operator lies in `R(Γ)'` if and only if it commutes with every right regular unitary. -/
theorem mem_commutant_rightGroupVonNeumannAlgebra_iff_rightRegular
    {T : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)} :
    T ∈ (rightGroupVonNeumannAlgebra Γ).commutant ↔
      ∀ g : Γ, (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 g * T =
        T * (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 g :=
  mem_commutant_adjoin_range_iff (Measure.isUnitary_rightRegular Measure.count)

/-- `L(Γ)` is contained in `R(Γ)'`. -/
theorem groupVonNeumannAlgebra_le_commutant_rightGroupVonNeumannAlgebra :
    groupVonNeumannAlgebra Γ ≤ (rightGroupVonNeumannAlgebra Γ).commutant := by
  rw [groupVonNeumannAlgebra_def, adjoin_le_iff]
  rintro _ ⟨g, rfl⟩
  exact mem_commutant_rightGroupVonNeumannAlgebra_iff_rightRegular.2 fun h =>
    (Measure.commute_leftRegular_rightRegular Measure.count 2 g h).eq.symm

/-- `R(Γ)` is contained in `L(Γ)'`. -/
theorem rightGroupVonNeumannAlgebra_le_commutant_groupVonNeumannAlgebra :
    rightGroupVonNeumannAlgebra Γ ≤ (groupVonNeumannAlgebra Γ).commutant :=
  le_commutant_comm.1 groupVonNeumannAlgebra_le_commutant_rightGroupVonNeumannAlgebra

variable (Γ) in
/-- The canonical `ℂ`-algebra homomorphism from the group algebra `MonoidAlgebra ℂ Γ` into
`groupVonNeumannAlgebra Γ`, sending `g` to left translation by `g`. -/
noncomputable def groupAlgebraToVonNeumannAlgebra :
    MonoidAlgebra ℂ Γ →ₐ[ℂ] (groupVonNeumannAlgebra Γ).toStarSubalgebra :=
  MonoidAlgebra.lift ℂ (groupVonNeumannAlgebra Γ).toStarSubalgebra Γ
    { toFun g := ⟨(Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g,
        leftRegular_mem_groupVonNeumannAlgebra g⟩
      map_one' := Subtype.ext (map_one ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2))
      map_mul' g h := Subtype.ext (map_mul ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2) g h) }

@[simp]
theorem coe_groupAlgebraToVonNeumannAlgebra_single (g : Γ) (c : ℂ) :
    ((groupAlgebraToVonNeumannAlgebra Γ (MonoidAlgebra.single g c) :
        (groupVonNeumannAlgebra Γ).toStarSubalgebra) :
      Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) =
      c • (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g := by
  simp [groupAlgebraToVonNeumannAlgebra]

end MeasurableMul

/-! ### Fourier coefficients at a basepoint -/

section Coeff

variable {Γ : Type*} [One Γ] [MeasurableSpace Γ] [MeasurableSingletonClass Γ]

/-- The `g`-th **Fourier coefficient** `⟪δ_g, x δ₁⟫_ℂ` of a bounded operator `x` on `L²(Γ)`. -/
noncomputable def groupVonNeumannCoeff
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
    (g : Γ) : ℂ :=
  ⟪L2.countHilbertBasis ℂ Γ g, x (L2.countHilbertBasis ℂ Γ 1)⟫_ℂ

theorem groupVonNeumannCoeff_def
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
    (g : Γ) :
    groupVonNeumannCoeff x g = ⟪L2.countHilbertBasis ℂ Γ g, x (L2.countHilbertBasis ℂ Γ 1)⟫_ℂ :=
  (rfl)

/-- The `g`-th Fourier coefficient of `x` is the value `(x δ₁) g` at `g`. -/
theorem groupVonNeumannCoeff_eq_apply
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ))
    (g : Γ) :
    groupVonNeumannCoeff x g = (x (L2.countHilbertBasis ℂ Γ 1)) g :=
  L2.inner_countHilbertBasis_left _ g

@[simp]
theorem groupVonNeumannCoeff_zero (g : Γ) :
    groupVonNeumannCoeff
      (0 : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) g = 0 := by
  simp [groupVonNeumannCoeff_def]

@[simp]
theorem groupVonNeumannCoeff_add
    (x y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) (g : Γ) :
    groupVonNeumannCoeff (x + y) g = groupVonNeumannCoeff x g + groupVonNeumannCoeff y g := by
  simp [groupVonNeumannCoeff_def, inner_add_right]

@[simp]
theorem groupVonNeumannCoeff_sub
    (x y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) (g : Γ) :
    groupVonNeumannCoeff (x - y) g = groupVonNeumannCoeff x g - groupVonNeumannCoeff y g := by
  simp [groupVonNeumannCoeff_def, inner_sub_right]

@[simp]
theorem groupVonNeumannCoeff_smul (c : ℂ)
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) (g : Γ) :
    groupVonNeumannCoeff (c • x) g = c * groupVonNeumannCoeff x g := by
  simp [groupVonNeumannCoeff_def, inner_smul_right]

@[simp]
theorem groupVonNeumannCoeff_one_one :
    groupVonNeumannCoeff
      (1 : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) 1 = 1 := by
  simp [groupVonNeumannCoeff_def, (L2.countHilbertBasis ℂ Γ).orthonormal.1 1]

/-- For `g ≠ 1`, the `g`-th Fourier coefficient of the identity operator is `0`. -/
theorem groupVonNeumannCoeff_one_of_ne {g : Γ} (hg : g ≠ 1) :
    groupVonNeumannCoeff
      (1 : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) g = 0 := by
  rw [groupVonNeumannCoeff_def, one_apply_eq_self]
  exact (L2.countHilbertBasis ℂ Γ).orthonormal.2 hg

/-- Unconditional `L²` Fourier expansion of `x δ₁`. -/
theorem hasSum_groupVonNeumannCoeff
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :
    HasSum (fun g : Γ => groupVonNeumannCoeff x g • L2.countHilbertBasis ℂ Γ g)
      (x (L2.countHilbertBasis ℂ Γ 1)) := by
  simpa only [← groupVonNeumannCoeff_eq_apply] using
    L2.hasSum_countHilbertBasis (x (L2.countHilbertBasis ℂ Γ 1))

/-- The Fourier coefficients of any bounded operator on `L²(Γ)` are square-summable. -/
theorem summable_norm_sq_groupVonNeumannCoeff
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :
    Summable fun g : Γ => ‖groupVonNeumannCoeff x g‖ ^ 2 := by
  simpa only [← groupVonNeumannCoeff_eq_apply] using
    L2.summable_norm_sq_apply (x (L2.countHilbertBasis ℂ Γ 1))

/-- Parseval's identity for the Fourier coefficients of `x`: `‖x δ₁‖² = ∑' g, ‖c_g(x)‖²`. -/
theorem norm_apply_one_sq_eq_tsum_groupVonNeumannCoeff
    (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) :
    ‖x (L2.countHilbertBasis ℂ Γ 1)‖ ^ 2 = ∑' g : Γ, ‖groupVonNeumannCoeff x g‖ ^ 2 := by
  simpa only [← groupVonNeumannCoeff_eq_apply] using
    L2.norm_sq_eq_tsum_apply (x (L2.countHilbertBasis ℂ Γ 1))

end Coeff

/-! ### Mutual commutants, cyclic/separating identity vector, convolution, and trace -/

section MeasurableSingleton

variable {Γ : Type*} [Group Γ] [MeasurableSpace Γ] [MeasurableMul Γ] [MeasurableSingletonClass Γ]

@[simp]
theorem leftRegular_countHilbertBasis (g h : Γ) :
    (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g (L2.countHilbertBasis ℂ Γ h) =
      L2.countHilbertBasis ℂ Γ (g * h) := by
  simp [L2.countHilbertBasis_apply]

@[simp]
theorem rightRegular_countHilbertBasis (g h : Γ) :
    (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 g (L2.countHilbertBasis ℂ Γ h) =
      L2.countHilbertBasis ℂ Γ (h * g⁻¹) := by
  simp [L2.countHilbertBasis_apply]

private theorem apply_countHilbertBasis_one_comm
    {T S : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)}
    (hT : T ∈ (rightGroupVonNeumannAlgebra Γ).commutant)
    (hS : S ∈ (groupVonNeumannAlgebra Γ).commutant) :
    T (S (L2.countHilbertBasis ℂ Γ 1)) = S (T (L2.countHilbertBasis ℂ Γ 1)) := by
  let δ := L2.countHilbertBasis ℂ Γ
  refine δ.repr.injective (lp.ext (funext fun x => ?_))
  simp only [δ, L2.countHilbertBasis_repr_apply, ← L2.inner_countHilbertBasis_left]
  have h1 : HasSum (fun h : Γ => (S (δ 1)) h * (T (δ 1)) (x * h⁻¹))
      ⟪δ x, T (S (δ 1))⟫_ℂ := by
    have hmap := (L2.hasSum_countHilbertBasis (S (δ 1))).mapL ((innerSL ℂ (δ x)).comp T)
    refine hmap.congr_fun fun h => ?_
    have hcomm := DFunLike.congr_fun
      (mem_commutant_rightGroupVonNeumannAlgebra_iff_rightRegular.1 hT h⁻¹) (δ 1)
    simp only [ContinuousLinearMap.comp_apply, innerSL_apply_apply, map_smul, smul_eq_mul]
    congr 1
    have hδ : δ h = (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 h⁻¹ (δ 1) := by simp [δ]
    rw [hδ, ← mul_apply_eq_comp, ← hcomm, mul_apply_eq_comp,
      (Measure.isUnitary_rightRegular Measure.count).inner_map_right]
    simp [δ]
  have h2 : HasSum (fun g : Γ => (T (δ 1)) g * (S (δ 1)) (g⁻¹ * x))
      ⟪δ x, S (T (δ 1))⟫_ℂ := by
    have hmap := (L2.hasSum_countHilbertBasis (T (δ 1))).mapL ((innerSL ℂ (δ x)).comp S)
    refine hmap.congr_fun fun g => ?_
    have hcomm := DFunLike.congr_fun
      (mem_commutant_groupVonNeumannAlgebra_iff_leftRegular.1 hS g) (δ 1)
    simp only [ContinuousLinearMap.comp_apply, innerSL_apply_apply, map_smul, smul_eq_mul]
    congr 1
    have hδ : δ g = (Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g (δ 1) := by simp [δ]
    rw [hδ, ← mul_apply_eq_comp, ← hcomm, mul_apply_eq_comp,
      (Measure.isUnitary_leftRegular Measure.count).inner_map_right]
    simp [δ]
  let e : Γ ≃ Γ :=
    { toFun h := x * h⁻¹
      invFun g := g⁻¹ * x
      left_inv h := by group
      right_inv g := by group }
  have h2' : HasSum (fun h : Γ => (S (δ 1)) h * (T (δ 1)) (x * h⁻¹))
      ⟪δ x, S (T (δ 1))⟫_ℂ :=
    (e.hasSum_iff.2 h2).congr_fun fun h => by
      have hxh : (x * h⁻¹)⁻¹ * x = h := by group
      simp only [Function.comp_apply, e, Equiv.coe_fn_mk]
      rw [hxh, mul_comm]
  exact h1.unique h2'

variable (Γ) in
/-- **Mutual commutant theorem (right-to-left).** The commutant of `R(Γ)` is `L(Γ)`. -/
@[simp]
theorem commutant_rightGroupVonNeumannAlgebra :
    (rightGroupVonNeumannAlgebra Γ).commutant = groupVonNeumannAlgebra Γ := by
  refine le_antisymm (fun T hT => ?_)
    groupVonNeumannAlgebra_le_commutant_rightGroupVonNeumannAlgebra
  rw [← commutant_commutant (groupVonNeumannAlgebra Γ), mem_commutant_iff]
  intro S hS
  have hbasis (k : Γ) :
      (S * T) (L2.countHilbertBasis ℂ Γ k) = (T * S) (L2.countHilbertBasis ℂ Γ k) := by
    let ρk := (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 k⁻¹
    have hρk : ρk ∈ (groupVonNeumannAlgebra Γ).commutant :=
      rightGroupVonNeumannAlgebra_le_commutant_groupVonNeumannAlgebra
        (rightRegular_mem_rightGroupVonNeumannAlgebra k⁻¹)
    have hcomm := apply_countHilbertBasis_one_comm hT
      ((groupVonNeumannAlgebra Γ).commutant.mul_mem hS hρk)
    have hTk : ρk (T (L2.countHilbertBasis ℂ Γ 1)) = T (L2.countHilbertBasis ℂ Γ k) := by
      have hTρ := DFunLike.congr_fun
        (mem_commutant_rightGroupVonNeumannAlgebra_iff_rightRegular.1 hT k⁻¹)
        (L2.countHilbertBasis ℂ Γ 1)
      simpa [ρk, mul_apply_eq_comp] using hTρ
    have hSk : (S * ρk) (L2.countHilbertBasis ℂ Γ 1) = S (L2.countHilbertBasis ℂ Γ k) := by
      simp [ρk, mul_apply_eq_comp]
    rw [hSk, mul_apply_eq_comp, hTk] at hcomm
    exact hcomm.symm
  have htop := congr_arg (SetLike.coe : Submodule ℂ _ → Set _)
    (L2.countHilbertBasis ℂ Γ).dense_span
  rw [Submodule.topologicalClosure_coe, Submodule.top_coe] at htop
  have hsub : Submodule.span ℂ (Set.range (L2.countHilbertBasis ℂ Γ)) ≤
      LinearMap.eqLocus (S * T).toLinearMap (T * S).toLinearMap :=
    Submodule.span_le.2 (by rintro _ ⟨k, rfl⟩; exact hbasis k)
  have hall := closure_minimal (t := {f | (S * T) f = (T * S) f}) hsub
    (isClosed_eq (S * T).continuous (T * S).continuous)
  rw [htop] at hall
  exact ContinuousLinearMap.ext fun f => hall trivial

variable (Γ) in
/-- **Mutual commutant theorem (left-to-right).** The commutant of `L(Γ)` is `R(Γ)`. -/
@[simp]
theorem commutant_groupVonNeumannAlgebra :
    (groupVonNeumannAlgebra Γ).commutant = rightGroupVonNeumannAlgebra Γ := by
  rw [← commutant_commutant (rightGroupVonNeumannAlgebra Γ), commutant_rightGroupVonNeumannAlgebra]

omit [MeasurableMul Γ] in
private theorem isCyclic_of_forall_countHilbertBasis
    {M : VonNeumannAlgebra (Lp ℂ 2 (Measure.count : Measure Γ))}
    (h : ∀ g : Γ, ∃ x ∈ M, x (L2.countHilbertBasis ℂ Γ 1) = L2.countHilbertBasis ℂ Γ g) :
    M.IsCyclic (L2.countHilbertBasis ℂ Γ 1) := by
  rw [isCyclic_def, dense_iff_closure_eq]
  have htop := congr_arg (SetLike.coe : Submodule ℂ _ → Set _)
    (L2.countHilbertBasis ℂ Γ).dense_span
  rw [Submodule.topologicalClosure_coe, Submodule.top_coe] at htop
  refine Set.eq_univ_of_forall fun v => ?_
  have hv : v ∈ closure (Submodule.span ℂ (Set.range (L2.countHilbertBasis ℂ Γ)) : Set _) := by
    rw [htop]
    trivial
  refine closure_mono ?_ hv
  have hsub : Submodule.span ℂ (Set.range (L2.countHilbertBasis ℂ Γ)) ≤
      M.toStarSubalgebra.toSubalgebra.toSubmodule.map
        (ContinuousLinearMap.apply ℂ _ (L2.countHilbertBasis ℂ Γ 1)).toLinearMap := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨g, rfl⟩
    exact h g
  intro w hw
  obtain ⟨x, hx, rfl⟩ := hsub hw
  exact ⟨⟨x, hx⟩, rfl⟩

variable (Γ) in
/-- The identity point mass `δ₁` is cyclic for `groupVonNeumannAlgebra Γ`. -/
theorem isCyclic_groupVonNeumannAlgebra_one :
    (groupVonNeumannAlgebra Γ).IsCyclic (L2.countHilbertBasis ℂ Γ 1) :=
  isCyclic_of_forall_countHilbertBasis fun g =>
    ⟨(Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g,
      leftRegular_mem_groupVonNeumannAlgebra g, by simp⟩

variable (Γ) in
/-- The identity point mass `δ₁` is cyclic for `rightGroupVonNeumannAlgebra Γ`. -/
theorem isCyclic_rightGroupVonNeumannAlgebra_one :
    (rightGroupVonNeumannAlgebra Γ).IsCyclic (L2.countHilbertBasis ℂ Γ 1) :=
  isCyclic_of_forall_countHilbertBasis fun g =>
    ⟨(Measure.count : Measure Γ).rightRegular ℂ ℂ 2 g⁻¹,
      rightRegular_mem_rightGroupVonNeumannAlgebra g⁻¹, by simp⟩

variable (Γ) in
/-- The identity point mass `δ₁` is separating for `groupVonNeumannAlgebra Γ`. -/
theorem isSeparating_groupVonNeumannAlgebra_one :
    (groupVonNeumannAlgebra Γ).IsSeparating (L2.countHilbertBasis ℂ Γ 1) := by
  rw [isSeparating_iff_isCyclic_commutant, commutant_groupVonNeumannAlgebra]
  exact isCyclic_rightGroupVonNeumannAlgebra_one Γ

variable (Γ) in
/-- The identity point mass `δ₁` is separating for `rightGroupVonNeumannAlgebra Γ`. -/
theorem isSeparating_rightGroupVonNeumannAlgebra_one :
    (rightGroupVonNeumannAlgebra Γ).IsSeparating (L2.countHilbertBasis ℂ Γ 1) := by
  rw [isSeparating_iff_isCyclic_commutant, commutant_rightGroupVonNeumannAlgebra]
  exact isCyclic_groupVonNeumannAlgebra_one Γ

/-! ### Uniqueness, involution, and convolution of Fourier coefficients -/

@[simp]
theorem groupVonNeumannCoeff_leftRegular_self (g : Γ) :
    groupVonNeumannCoeff ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g) g = 1 := by
  simp [groupVonNeumannCoeff_def, (L2.countHilbertBasis ℂ Γ).orthonormal.1 g]

/-- For `h ≠ g`, the `h`-th Fourier coefficient of `leftRegular g` is `0`. -/
theorem groupVonNeumannCoeff_leftRegular_of_ne {g h : Γ} (hgh : h ≠ g) :
    groupVonNeumannCoeff ((Measure.count : Measure Γ).leftRegular ℂ ℂ 2 g) h = 0 := by
  simp only [groupVonNeumannCoeff_def, leftRegular_countHilbertBasis, mul_one]
  exact (L2.countHilbertBasis ℂ Γ).orthonormal.2 hgh

/-- Operators in `groupVonNeumannAlgebra Γ` are uniquely determined by their Fourier
coefficients. -/
theorem eq_of_groupVonNeumannCoeff_eq
    {x y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)}
    (hx : x ∈ groupVonNeumannAlgebra Γ) (hy : y ∈ groupVonNeumannAlgebra Γ)
    (h : ∀ g : Γ, groupVonNeumannCoeff x g = groupVonNeumannCoeff y g) : x = y := by
  refine (isSeparating_groupVonNeumannAlgebra_one Γ).eq_of_apply_eq hx hy ?_
  exact (hasSum_groupVonNeumannCoeff x).unique
    ((hasSum_groupVonNeumannCoeff y).congr_fun fun g => by rw [h g])

/-- Every `x ∈ groupVonNeumannAlgebra Γ` acts on `δ_g` by right-translating `x δ₁`. -/
theorem apply_countHilbertBasis_eq_rightRegular
    {x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)}
    (hx : x ∈ groupVonNeumannAlgebra Γ) (g : Γ) :
    x (L2.countHilbertBasis ℂ Γ g) =
      (Measure.count : Measure Γ).rightRegular ℂ ℂ 2 g⁻¹ (x (L2.countHilbertBasis ℂ Γ 1)) := by
  have hx' : x ∈ (rightGroupVonNeumannAlgebra Γ).commutant :=
    groupVonNeumannAlgebra_le_commutant_rightGroupVonNeumannAlgebra hx
  have hcomm := DFunLike.congr_fun
    (mem_commutant_rightGroupVonNeumannAlgebra_iff_rightRegular.1 hx' g⁻¹)
    (L2.countHilbertBasis ℂ Γ 1)
  simpa [mul_apply_eq_comp] using hcomm.symm

/-- For `x ∈ groupVonNeumannAlgebra Γ`, the `g`-th Fourier coefficient of `star x` is
`conj (groupVonNeumannCoeff x g⁻¹)`. -/
theorem groupVonNeumannCoeff_star
    {x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)}
    (hx : x ∈ groupVonNeumannAlgebra Γ) (g : Γ) :
    groupVonNeumannCoeff (star x) g = conj (groupVonNeumannCoeff x g⁻¹) := by
  rw [groupVonNeumannCoeff_def, ContinuousLinearMap.star_eq_adjoint,
    ContinuousLinearMap.adjoint_inner_right, apply_countHilbertBasis_eq_rightRegular hx g,
    (Measure.isUnitary_rightRegular Measure.count).inner_map_left, inv_inv,
    rightRegular_countHilbertBasis, one_mul, ← inner_conj_symm, groupVonNeumannCoeff_def]

/-- **Convolution formula for Fourier coefficients.** For `x ∈ groupVonNeumannAlgebra Γ` and any
bounded operator `y`, `c_g(x * y) = ∑' h, c_{g * h⁻¹}(x) * c_h(y)` unconditionally. -/
theorem hasSum_groupVonNeumannCoeff_mul
    {x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)}
    (hx : x ∈ groupVonNeumannAlgebra Γ)
    (y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) (g : Γ) :
    HasSum (fun h : Γ => groupVonNeumannCoeff x (g * h⁻¹) * groupVonNeumannCoeff y h)
      (groupVonNeumannCoeff (x * y) g) := by
  have hinner : groupVonNeumannCoeff (x * y) g =
      ⟪(star x) (L2.countHilbertBasis ℂ Γ g), y (L2.countHilbertBasis ℂ Γ 1)⟫_ℂ := by
    rw [groupVonNeumannCoeff_def, mul_apply_eq_comp, ContinuousLinearMap.star_eq_adjoint,
      ContinuousLinearMap.adjoint_inner_left]
  rw [hinner]
  refine (L2.hasSum_conj_mul_apply _ _).congr_fun fun h => ?_
  rw [← groupVonNeumannCoeff_eq_apply y h]
  congr 1
  rw [← L2.inner_countHilbertBasis_left, apply_countHilbertBasis_eq_rightRegular (star_mem hx) g,
    (Measure.isUnitary_rightRegular Measure.count).inner_map_right, inv_inv,
    rightRegular_countHilbertBasis, ← groupVonNeumannCoeff_def, groupVonNeumannCoeff_star hx,
    mul_inv_rev, inv_inv]
  simp

/-- `tsum` form of the Fourier convolution formula `hasSum_groupVonNeumannCoeff_mul`. -/
theorem groupVonNeumannCoeff_mul
    {x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)}
    (hx : x ∈ groupVonNeumannAlgebra Γ)
    (y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) (g : Γ) :
    groupVonNeumannCoeff (x * y) g =
      ∑' h : Γ, groupVonNeumannCoeff x (g * h⁻¹) * groupVonNeumannCoeff y h :=
  (hasSum_groupVonNeumannCoeff_mul hx y g).tsum_eq.symm

/-! ### The canonical faithful normal tracial state and group-algebra embedding -/

variable (Γ) in
/-- **The canonical trace on `groupVonNeumannAlgebra Γ`**, given by the vector functional
`x ↦ ⟪δ₁, x δ₁⟫_ℂ = groupVonNeumannCoeff x 1`. -/
noncomputable def groupVonNeumannTrace :
    (groupVonNeumannAlgebra Γ).toStarSubalgebra →ₗ[ℂ] ℂ :=
  (groupVonNeumannAlgebra Γ).innerLinearMap (L2.countHilbertBasis ℂ Γ 1)
    (L2.countHilbertBasis ℂ Γ 1)

/-- The canonical trace evaluates `x ∈ groupVonNeumannAlgebra Γ` at its identity Fourier
coefficient. -/
theorem groupVonNeumannTrace_apply (x : (groupVonNeumannAlgebra Γ).toStarSubalgebra) :
    groupVonNeumannTrace Γ x =
      groupVonNeumannCoeff
        (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) 1 := by
  simp [groupVonNeumannTrace, groupVonNeumannCoeff_def]

/-- The canonical trace on `groupVonNeumannAlgebra Γ` is a normal functional. -/
theorem isNormalFunctional_groupVonNeumannTrace :
    (groupVonNeumannAlgebra Γ).IsNormalFunctional (groupVonNeumannTrace Γ) :=
  (groupVonNeumannAlgebra Γ).isNormalFunctional_innerLinearMap _ _

/-- The canonical vector functional on `groupVonNeumannAlgebra Γ` is a tracial state. -/
theorem isTracialState_groupVonNeumannTrace :
    (groupVonNeumannAlgebra Γ).IsTracialState (groupVonNeumannTrace Γ) := by
  rw [isTracialState_def]
  refine ⟨by simp [groupVonNeumannTrace_apply], fun x => ?_, fun x y => ?_⟩
  · rw [groupVonNeumannTrace_apply, Subalgebra.coe_mul, StarMemClass.coe_star,
      groupVonNeumannCoeff_def, mul_apply_eq_comp, ContinuousLinearMap.star_eq_adjoint,
      ContinuousLinearMap.adjoint_inner_right, inner_self_eq_norm_sq_to_K]
    simp
  · rw [groupVonNeumannTrace_apply, groupVonNeumannTrace_apply]
    push_cast
    have hxy := hasSum_groupVonNeumannCoeff_mul x.2
      (y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) 1
    have hyx := hasSum_groupVonNeumannCoeff_mul y.2
      (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) 1
    simp only [one_mul] at hxy hyx
    have hyx' : HasSum
        (fun h : Γ =>
          groupVonNeumannCoeff
            (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) h⁻¹ *
            groupVonNeumannCoeff
              (y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) h)
        (groupVonNeumannCoeff
          ((y : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) *
            (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)))
          1) :=
      ((Equiv.inv Γ).hasSum_iff.2 hyx).congr_fun fun h => by
        simp [Equiv.inv, mul_comm]
    exact hxy.unique hyx'

/-- **Faithfulness of the canonical trace.** For `x ∈ groupVonNeumannAlgebra Γ`,
`τ (star x * x) = 0 ↔ x = 0`. -/
@[simp]
theorem groupVonNeumannTrace_star_mul_self_eq_zero_iff
    (x : (groupVonNeumannAlgebra Γ).toStarSubalgebra) :
    groupVonNeumannTrace Γ (star x * x) = 0 ↔ x = 0 := by
  refine ⟨fun h => ?_, fun h => by simp [h]⟩
  rw [groupVonNeumannTrace_apply, Subalgebra.coe_mul, StarMemClass.coe_star,
    groupVonNeumannCoeff_def, mul_apply_eq_comp, ContinuousLinearMap.star_eq_adjoint,
    ContinuousLinearMap.adjoint_inner_right, inner_self_eq_zero] at h
  exact Subtype.ext ((isSeparating_groupVonNeumannAlgebra_one Γ).eq_zero x.2 h)

/-- The star subalgebra underlying `groupVonNeumannAlgebra Γ` is Dedekind-finite
(`a * b = 1 → b * a = 1`). -/
instance instIsDedekindFiniteMonoidGroupVonNeumannAlgebra :
    IsDedekindFiniteMonoid (groupVonNeumannAlgebra Γ).toStarSubalgebra :=
  CStarAlgebra.isDedekindFiniteMonoid_of_tracial
    (groupVonNeumannTrace Γ).toAddMonoidHom
    (((groupVonNeumannAlgebra Γ).isTracialState_def _).1 isTracialState_groupVonNeumannTrace).2.2
    fun q hq hτ => (groupVonNeumannTrace_star_mul_self_eq_zero_iff q).1
      (by rw [hq.isSelfAdjoint.star_eq, hq.isIdempotentElem.eq]; exact hτ)

variable (Γ) in
/-- Every group von Neumann algebra `groupVonNeumannAlgebra Γ` is a finite von Neumann algebra. -/
theorem isFinite_groupVonNeumannAlgebra : (groupVonNeumannAlgebra Γ).IsFinite :=
  IsFinite.of_isDedekindFiniteMonoid (groupVonNeumannAlgebra Γ)

@[simp]
theorem groupVonNeumannCoeff_groupAlgebraToVonNeumannAlgebra (f : MonoidAlgebra ℂ Γ) (g : Γ) :
    groupVonNeumannCoeff ((groupAlgebraToVonNeumannAlgebra Γ f :
        (groupVonNeumannAlgebra Γ).toStarSubalgebra) :
      Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) g =
      f.coeff g := by
  classical
  induction f using MonoidAlgebra.induction_linear with
  | zero => simp
  | add f₁ f₂ ih₁ ih₂ => simp [ih₁, ih₂]
  | single h c =>
    rw [coe_groupAlgebraToVonNeumannAlgebra_single, groupVonNeumannCoeff_smul]
    by_cases hgh : g = h
    · subst hgh
      simp
    · rw [groupVonNeumannCoeff_leftRegular_of_ne hgh, mul_zero, MonoidAlgebra.coeff_single,
        Finsupp.single_eq_of_ne hgh]

/-- The canonical homomorphism from `MonoidAlgebra ℂ Γ` into `groupVonNeumannAlgebra Γ` is
injective. -/
theorem groupAlgebraToVonNeumannAlgebra_injective :
    Function.Injective (groupAlgebraToVonNeumannAlgebra Γ) := by
  intro f₁ f₂ h
  ext g
  have hg := congr_arg (fun x : (groupVonNeumannAlgebra Γ).toStarSubalgebra =>
    groupVonNeumannCoeff
      (x : Lp ℂ 2 (Measure.count : Measure Γ) →L[ℂ] Lp ℂ 2 (Measure.count : Measure Γ)) g) h
  simpa only [groupVonNeumannCoeff_groupAlgebraToVonNeumannAlgebra] using hg

end MeasurableSingleton

