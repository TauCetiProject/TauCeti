/-!
# The von Neumann algebra generated by a set of operators

For a set `s` of bounded operators on a complex Hilbert space, `VonNeumannAlgebra.adjoin s` is the
double commutant of `s ∪ star s`. A triple commutant equals the single commutant, so this star
subalgebra is equal to its own double commutant, and it is the smallest von Neumann algebra
containing `s` (`VonNeumannAlgebra.adjoin_le_iff`). Its commutant is the commutant of
`s ∪ star s`. The set `s` and the star algebra it generates generate the same von Neumann
algebra (`VonNeumannAlgebra.adjoin_starAlgebraAdjoin`), and a star subalgebra generates its
double commutant (`VonNeumannAlgebra.coe_adjoin_starSubalgebra`). Consequently the double
commutant of a star subalgebra is closed under the unital and non-unital continuous functional
calculus over any `RCLike` scalar field (`StarSubalgebra.cfc_mem_centralizer_centralizer`,
`StarSubalgebra.cfcₙ_mem_centralizer_centralizer`).

When `s` is the range of a representation of a C⋆-algebra, `adjoin s` is the von Neumann algebra
`π(A)''` of the representation. Conjugation by a unitary that normalizes `s` preserves
`adjoin s` (`VonNeumannAlgebra.conj_mem_adjoin`); this is how a unitarily implemented automorphism
of `π(A)` extends to `π(A)''`.

Mathlib's `VonNeumannAlgebra` is the concrete double-commutant notion, so no von Neumann
density theorem is used here.
-/

public section

open scoped Pointwise

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {s t : Set (H →L[ℂ] H)}

/-- The **von Neumann algebra generated** by a set `s` of bounded operators: the double commutant
of `s ∪ star s`. -/
noncomputable def adjoin (s : Set (H →L[ℂ] H)) : VonNeumannAlgebra H where
  toStarSubalgebra :=
    StarSubalgebra.centralizer ℂ (StarSubalgebra.centralizer ℂ s : Set (H →L[ℂ] H))
  centralizer_centralizer' := by
    have h := StarSubalgebra.coe_centralizer_centralizer ℂ s
    -- The carrier is the coercion of the star subalgebra to a set, up to unfolding `SetLike.coe`.
    exact (congrArg (fun S => S.centralizer.centralizer) h).trans
      ((Set.centralizer_centralizer_centralizer _).trans h.symm)

/-- The generated von Neumann algebra is the double commutant of `s ∪ star s`. -/
@[simp]
theorem coe_adjoin (s : Set (H →L[ℂ] H)) :
    (adjoin s : Set (H →L[ℂ] H)) = (s ∪ star s).centralizer.centralizer :=
  StarSubalgebra.coe_centralizer_centralizer ℂ s

/-- The commutant of the generated von Neumann algebra is the commutant of `s ∪ star s`. -/
theorem coe_commutant_adjoin (s : Set (H →L[ℂ] H)) :
    ((adjoin s).commutant : Set (H →L[ℂ] H)) = (s ∪ star s).centralizer := by
  rw [coe_commutant, coe_adjoin, Set.centralizer_centralizer_centralizer]

/-- A set is contained in the von Neumann algebra it generates. -/
theorem subset_adjoin (s : Set (H →L[ℂ] H)) : s ⊆ adjoin s := by
  rw [coe_adjoin]
  exact Set.subset_union_left.trans Set.subset_centralizer_centralizer

/-- The generated von Neumann algebra is the smallest von Neumann algebra containing `s`. -/
@[simp]
theorem adjoin_le_iff {M : VonNeumannAlgebra H} : adjoin s ≤ M ↔ s ⊆ M := by
  refine ⟨fun h => (subset_adjoin s).trans h, fun h x hx => ?_⟩
  have hs : s ∪ star s ⊆ M := Set.union_subset h fun y hy => by
    simpa using star_mem (h (Set.mem_star.1 hy))
  rw [← SetLike.mem_coe, coe_adjoin] at hx
  rw [← SetLike.mem_coe, ← M.centralizer_centralizer]
  exact Set.centralizer_subset (Set.centralizer_subset hs) hx

/-- Generating von Neumann algebras is monotone. -/
theorem adjoin_mono (h : s ⊆ t) : adjoin s ≤ adjoin t :=
  adjoin_le_iff.2 (h.trans (subset_adjoin t))

/-- The von Neumann algebra generated by a set closed under adjoints is its double
commutant. -/
theorem coe_adjoin_of_star_subset (hs : star s ⊆ s) :
    (adjoin s : Set (H →L[ℂ] H)) = s.centralizer.centralizer := by
  rw [coe_adjoin, Set.union_eq_left.2 hs]

/-- The commutant of the von Neumann algebra generated by a set closed under adjoints is its
commutant. -/
theorem coe_commutant_adjoin_of_star_subset (hs : star s ⊆ s) :
    ((adjoin s).commutant : Set (H →L[ℂ] H)) = s.centralizer := by
  rw [coe_commutant_adjoin, Set.union_eq_left.2 hs]

/-- The complex linear span of `s` is contained in the von Neumann algebra generated by `s`. -/
theorem span_subset_adjoin (s : Set (H →L[ℂ] H)) :
    (Submodule.span ℂ s : Set (H →L[ℂ] H)) ⊆ adjoin s :=
  span_subset (subset_adjoin s)

/-- The norm-closed complex linear span of `s` is contained in the von Neumann algebra generated by
`s`. -/
theorem closure_span_subset_adjoin (s : Set (H →L[ℂ] H)) :
    closure (Submodule.span ℂ s : Set (H →L[ℂ] H)) ⊆ adjoin s :=
  closure_span_subset (subset_adjoin s)

/-- The von Neumann algebra generated by a star subalgebra is its double commutant. -/
theorem coe_adjoin_starSubalgebra (S : StarSubalgebra ℂ (H →L[ℂ] H)) :
    (adjoin (S : Set (H →L[ℂ] H)) : Set (H →L[ℂ] H)) =
      (S : Set (H →L[ℂ] H)).centralizer.centralizer :=
  coe_adjoin_of_star_subset (StarMemClass.star_coe_eq _).subset

/-- A set and the star algebra it generates generate the same von Neumann algebra. -/
@[simp]
theorem adjoin_starAlgebraAdjoin (s : Set (H →L[ℂ] H)) :
    adjoin (StarAlgebra.adjoin ℂ s : Set (H →L[ℂ] H)) = adjoin s :=
  le_antisymm (adjoin_le_iff.2 (StarAlgebra.adjoin_le (S := (adjoin s).toStarSubalgebra)
    (subset_adjoin s))) (adjoin_mono (StarAlgebra.subset_adjoin ℂ s))

/-- The von Neumann algebra generated by `s` is the double commutant of the star algebra
generated by `s`. -/
theorem coe_adjoin_eq_centralizer_centralizer_starAlgebraAdjoin (s : Set (H →L[ℂ] H)) :
    (adjoin s : Set (H →L[ℂ] H)) =
      (StarAlgebra.adjoin ℂ s : Set (H →L[ℂ] H)).centralizer.centralizer := by
  rw [← adjoin_starAlgebraAdjoin, coe_adjoin_of_star_subset (StarMemClass.star_coe_eq _).subset]

/-- Conjugation by a unitary `u` preserves the von Neumann algebra generated by `s` when it maps
`s` into itself. -/
theorem conj_mem_adjoin {u : H →L[ℂ] H} (hu : u ∈ unitary (H →L[ℂ] H))
    (hs : ∀ x ∈ s, u * x * star u ∈ s) {x : H →L[ℂ] H} (hx : x ∈ adjoin s) :
    u * x * star u ∈ adjoin s := by
  let v : (H →L[ℂ] H)ˣ := Unitary.toUnits ⟨u, hu⟩
  -- Conjugation by `u` maps `s ∪ star s` into itself, hence conjugation by `star u` maps its
  -- commutant into itself, hence conjugation by `u` maps its double commutant into itself.
  have hT : ∀ y ∈ s ∪ star s, ↑v⁻¹⁻¹ * y * ↑v⁻¹ ∈ s ∪ star s := by
    rintro y (hy | hy)
    · exact Or.inl (hs y hy)
    · refine Or.inr ?_
      rw [Set.mem_star] at hy ⊢
      simpa [v, mul_assoc, ← Unitary.star_eq_inv, Unitary.coe_star] using hs _ hy
  rw [← SetLike.mem_coe, coe_adjoin] at hx ⊢
  exact Set.conj_mem_centralizer v
    (fun y hy => by simpa using Set.conj_mem_centralizer v⁻¹ hT hy) hx

end VonNeumannAlgebra

namespace StarSubalgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {𝕜 : Type*} {p : (H →L[ℂ] H) → Prop} [RCLike 𝕜] [Algebra 𝕜 (H →L[ℂ] H)]
  [StarModule 𝕜 (H →L[ℂ] H)] [SMul 𝕜 ℂ] [IsScalarTower 𝕜 ℂ (H →L[ℂ] H)]

/-- The double commutant `S''` is closed under the continuous functional calculus over any
`RCLike` scalar field, being the von Neumann algebra generated by `S`. -/
theorem cfc_mem_centralizer_centralizer [ContinuousFunctionalCalculus 𝕜 (H →L[ℂ] H) p]
    (S : StarSubalgebra ℂ (H →L[ℂ] H)) (f : 𝕜 → 𝕜)
    {x : H →L[ℂ] H} (hx : x ∈ (S : Set (H →L[ℂ] H)).centralizer.centralizer) :
    cfc f x ∈ (S : Set (H →L[ℂ] H)).centralizer.centralizer := by
  rw [← VonNeumannAlgebra.coe_adjoin_starSubalgebra, SetLike.mem_coe] at hx ⊢
  exact cfc_mem (s := (VonNeumannAlgebra.adjoin _).toStarSubalgebra) (𝕜' := ℂ) f hx

/-- The double commutant `S''` is closed under the non-unital continuous functional calculus over
any `RCLike` scalar field. -/
theorem cfcₙ_mem_centralizer_centralizer
    [NonUnitalContinuousFunctionalCalculus 𝕜 (H →L[ℂ] H) p]
    (S : StarSubalgebra ℂ (H →L[ℂ] H)) (f : 𝕜 → 𝕜)
    {x : H →L[ℂ] H} (hx : x ∈ (S : Set (H →L[ℂ] H)).centralizer.centralizer) :
    cfcₙ f x ∈ (S : Set (H →L[ℂ] H)).centralizer.centralizer := by
  rw [← VonNeumannAlgebra.coe_adjoin_starSubalgebra, SetLike.mem_coe] at hx ⊢
  exact cfcₙ_mem (s := (VonNeumannAlgebra.adjoin _).toStarSubalgebra) (𝕜' := ℂ) f hx

end StarSubalgebra
