module

public import Mathlib.Analysis.VonNeumannAlgebra.Basic
import TauCeti.Algebra.Group.Center

/-!
# The von Neumann algebra generated by a set of operators

For a set `s` of bounded operators on a complex Hilbert space, `VonNeumannAlgebra.adjoin s` is the
double commutant of `s ∪ star s`. A triple commutant equals the single commutant, so this star
subalgebra is equal to its own double commutant, and it is the smallest von Neumann algebra
containing `s` (`VonNeumannAlgebra.adjoin_le_iff`). Its commutant is the commutant of
`s ∪ star s`.

When `s` is the range of a representation of a C⋆-algebra, `adjoin s` is the von Neumann algebra
`π(A)''` of the representation. Conjugation by a unitary that normalizes `s` preserves
`adjoin s` (`VonNeumannAlgebra.conj_mem_adjoin`); this is how a unitarily implemented automorphism
of `π(A)` extends to `π(A)''`.

Mathlib's `VonNeumannAlgebra` is the concrete double-commutant notion, so no von Neumann
density theorem is used here.
-/

public section

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {s t : Set (H →L[ℂ] H)}

/-- The **von Neumann algebra generated** by a set `s` of bounded operators: the double commutant
of `s ∪ star s`. -/
noncomputable def adjoin (s : Set (H →L[ℂ] H)) : VonNeumannAlgebra H where
  toStarSubalgebra :=
    StarSubalgebra.centralizer ℂ (StarSubalgebra.centralizer ℂ s : Set (H →L[ℂ] H))
  centralizer_centralizer' := by
    have h := StarSubalgebra.coe_centralizer_centralizer ℂ s
    -- The carrier is the coercion of the star subalgebra to a set, up to unfolding `SetLike.coe`.
    exact (congrArg (fun S => S.centralizer.centralizer) h).trans
      ((Set.centralizer_centralizer_centralizer _).trans h.symm)

/-- The generated von Neumann algebra is the double commutant of `s ∪ star s`. -/
@[simp]
theorem coe_adjoin (s : Set (H →L[ℂ] H)) :
    (adjoin s : Set (H →L[ℂ] H)) = (s ∪ star s).centralizer.centralizer :=
  StarSubalgebra.coe_centralizer_centralizer ℂ s

/-- The commutant of the generated von Neumann algebra is the commutant of `s ∪ star s`. -/
theorem coe_commutant_adjoin (s : Set (H →L[ℂ] H)) :
    ((adjoin s).commutant : Set (H →L[ℂ] H)) = (s ∪ star s).centralizer := by
  rw [coe_commutant, coe_adjoin, Set.centralizer_centralizer_centralizer]

/-- A set is contained in the von Neumann algebra it generates. -/
theorem subset_adjoin (s : Set (H →L[ℂ] H)) : s ⊆ adjoin s := by
  rw [coe_adjoin]
  exact Set.subset_union_left.trans Set.subset_centralizer_centralizer

/-- The generated von Neumann algebra is the smallest von Neumann algebra containing `s`. -/
@[simp]
theorem adjoin_le_iff {M : VonNeumannAlgebra H} : adjoin s ≤ M ↔ s ⊆ M := by
  refine ⟨fun h => (subset_adjoin s).trans h, fun h x hx => ?_⟩
  have hs : s ∪ star s ⊆ M := Set.union_subset h fun y hy => by
    simpa using star_mem (h (Set.mem_star.1 hy))
  rw [← SetLike.mem_coe, coe_adjoin] at hx
  rw [← SetLike.mem_coe, ← M.centralizer_centralizer]
  exact Set.centralizer_subset (Set.centralizer_subset hs) hx

/-- Generating von Neumann algebras is monotone. -/
theorem adjoin_mono (h : s ⊆ t) : adjoin s ≤ adjoin t :=
  adjoin_le_iff.2 (h.trans (subset_adjoin t))

/-- Conjugation by a unitary `u` preserves the von Neumann algebra generated by `s` when it maps
`s` into itself. -/
theorem conj_mem_adjoin {u : H →L[ℂ] H} (hu : u ∈ unitary (H →L[ℂ] H))
    (hs : ∀ x ∈ s, u * x * star u ∈ s) {x : H →L[ℂ] H} (hx : x ∈ adjoin s) :
    u * x * star u ∈ adjoin s := by
  let v : (H →L[ℂ] H)ˣ := Unitary.toUnits ⟨u, hu⟩
  -- Conjugation by `u` maps `s ∪ star s` into itself, hence conjugation by `star u` maps its
  -- commutant into itself, hence conjugation by `u` maps its double commutant into itself.
  have hT : ∀ y ∈ s ∪ star s, ↑v⁻¹⁻¹ * y * ↑v⁻¹ ∈ s ∪ star s := by
    rintro y (hy | hy)
    · exact Or.inl (hs y hy)
    · refine Or.inr ?_
      rw [Set.mem_star] at hy ⊢
      simpa [v, mul_assoc, ← Unitary.star_eq_inv, Unitary.coe_star] using hs _ hy
  rw [← SetLike.mem_coe, coe_adjoin] at hx ⊢
  exact Set.conj_mem_centralizer v
    (fun y hy => by simpa using Set.conj_mem_centralizer v⁻¹ hT hy) hx

end VonNeumannAlgebra
