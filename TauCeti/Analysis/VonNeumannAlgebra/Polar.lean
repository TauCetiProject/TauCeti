module

public import TauCeti.Analysis.InnerProductSpace.Polar.Bounded
public import TauCeti.Analysis.VonNeumannAlgebra.Adjoin
import Mathlib.Analysis.CStarAlgebra.Unitary.Span

/-!
# Unitary generation and polar decomposition in von Neumann algebras

Every concrete von Neumann algebra `M` on a complex Hilbert space `H` is a unital C⋆-algebra, so
the complex linear span of the unitaries in `M` is `M` itself
(`VonNeumannAlgebra.coe_span_inter_unitary`). Consequently, membership in `M.commutant` is tested by
commuting with unitaries in `M`, and membership in `M` is tested by commuting with — or being
invariant under conjugation by — unitaries in `M.commutant`.

Combining unitary invariance of `ContinuousLinearMap.polarFactor`
(`ContinuousLinearMap.commute_polarFactor_of_mem_unitary`) with functional-calculus commutativity of
`ContinuousLinearMap.modulus` (`ContinuousLinearMap.commute_modulus_of_commute`) shows that for any
bounded operator `x : H →L[ℂ] H`, its modulus `x.modulus`, its polar partial isometry
`x.polarFactor`, its initial projection `x.kerᗮ.starProjection`, its kernel projection
`x.ker.starProjection`, and its final projection `x.range.topologicalClosure.starProjection` all
belong to `VonNeumannAlgebra.adjoin {x}`, and hence to every von Neumann algebra containing `x`.

## Main declarations

* `VonNeumannAlgebra.coe_span_inter_unitary`, `VonNeumannAlgebra.adjoin_inter_unitary`: `M` is the
  complex linear span of, and is generated by, its unitary elements.
* `VonNeumannAlgebra.mem_commutant_iff_forall_mem_unitary`,
  `VonNeumannAlgebra.mem_iff_forall_commutant_mem_unitary`,
  `VonNeumannAlgebra.mem_iff_forall_commutant_unitary_conj`: unitary tests for membership in
  `M.commutant` and `M`.
* `VonNeumannAlgebra.modulus_mem_adjoin_star_mul_self`, `VonNeumannAlgebra.modulus_mem_adjoin`,
  `VonNeumannAlgebra.modulus_mem`: membership of `x.modulus` in generated and ambient von Neumann
  algebras.
* `VonNeumannAlgebra.polarFactor_mem_adjoin`, `VonNeumannAlgebra.polarFactor_mem`: membership of the
  polar partial isometry `x.polarFactor` in `adjoin {x}` and in any `M` containing `x`.
* `VonNeumannAlgebra.starProjection_orthogonal_ker_mem_adjoin`,
  `VonNeumannAlgebra.starProjection_orthogonal_ker_mem`,
  `VonNeumannAlgebra.starProjection_ker_mem_adjoin`, `VonNeumannAlgebra.starProjection_ker_mem`,
  `VonNeumannAlgebra.starProjection_topologicalClosure_range_mem_adjoin`,
  `VonNeumannAlgebra.starProjection_topologicalClosure_range_mem`: membership of initial, kernel,
  and range projections in `adjoin {x}` and in `M`.

## References

* R. V. Kadison, J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras I*,
  Theorem 4.1.7 and Theorem 6.1.2.
* M. Takesaki, *Theory of Operator Algebras I*, Proposition II.3.9 and Theorem II.3.12.
-/

public section

open scoped InnerProduct

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

section Unitary

/-- The complex linear span of the unitary operators in a von Neumann algebra `M` equals `M`. -/
@[simp]
theorem coe_span_inter_unitary (M : VonNeumannAlgebra H) :
    (Submodule.span ℂ ((M : Set (H →L[ℂ] H)) ∩ unitary (H →L[ℂ] H)) : Set (H →L[ℂ] H)) = M := by
  have himage : Subtype.val '' (unitary M.toStarSubalgebra : Set M.toStarSubalgebra) =
      (M : Set (H →L[ℂ] H)) ∩ unitary (H →L[ℂ] H) := by
    ext u
    refine ⟨?_, ?_⟩
    · rintro ⟨⟨u, huM⟩, hu, rfl⟩
      exact ⟨huM, Unitary.map_mem M.toStarSubalgebra.subtype hu⟩
    · rintro ⟨huM, hu⟩
      exact ⟨⟨u, huM⟩, Unitary.mem_iff.2 ⟨Subtype.ext hu.1, Subtype.ext hu.2⟩, rfl⟩
  have hspan :
      Submodule.span ℂ (Subtype.val '' (unitary M.toStarSubalgebra : Set M.toStarSubalgebra)) =
        M.toStarSubalgebra.toSubmodule :=
    (Submodule.span_val_image_eq_iff M.toStarSubalgebra.toSubmodule _).2
      (CStarAlgebra.span_unitary M.toStarSubalgebra)
  rw [himage] at hspan
  exact congrArg SetLike.coe hspan

/-- Every von Neumann algebra is generated by its unitary elements. -/
@[simp]
theorem adjoin_inter_unitary (M : VonNeumannAlgebra H) :
    adjoin ((M : Set (H →L[ℂ] H)) ∩ unitary (H →L[ℂ] H)) = M := by
  set U : Set (H →L[ℂ] H) := (M : Set (H →L[ℂ] H)) ∩ unitary (H →L[ℂ] H)
  refine le_antisymm (adjoin_le_iff.2 Set.inter_subset_left) ?_
  intro x hx
  have hx' : x ∈ (Submodule.span ℂ U : Set (H →L[ℂ] H)) := by
    rwa [M.coe_span_inter_unitary]
  exact (Submodule.span_le (p := (adjoin U).toStarSubalgebra.toSubmodule)).mpr (subset_adjoin U) hx'

/-- An operator lies in `M.commutant` if and only if it commutes with every unitary in `M`. -/
theorem mem_commutant_iff_forall_mem_unitary {M : VonNeumannAlgebra H} {y : H →L[ℂ] H} :
    y ∈ M.commutant ↔ ∀ u ∈ M, u ∈ unitary (H →L[ℂ] H) → Commute u y := by
  refine ⟨fun hy u hu _ => (mem_commutant_iff.1 hy) u hu, fun h => ?_⟩
  rw [← M.adjoin_inter_unitary, ← SetLike.mem_coe, coe_commutant_adjoin]
  rintro u (⟨huM, hu⟩ | hu')
  · exact (h u huM hu).eq
  · rw [Set.mem_star] at hu'
    have hu_star : u ∈ M ∧ u ∈ unitary (H →L[ℂ] H) := by
      rw [← star_star u]
      exact ⟨star_mem hu'.1, Unitary.star_mem hu'.2⟩
    exact (h u hu_star.1 hu_star.2).eq

/-- An operator belongs to a von Neumann algebra `M` if and only if it commutes with every unitary
in `M.commutant`. -/
theorem mem_iff_forall_commutant_mem_unitary {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} :
    x ∈ M ↔ ∀ u ∈ M.commutant, u ∈ unitary (H →L[ℂ] H) → Commute x u := by
  conv_lhs => rw [← M.commutant_commutant]
  rw [mem_commutant_iff_forall_mem_unitary]
  exact forall_congr' fun u => imp_congr_right fun _ => imp_congr_right fun _ => Commute.symm_iff

/-- An operator belongs to a von Neumann algebra `M` if and only if it is fixed under conjugation by
every unitary in `M.commutant`. -/
theorem mem_iff_forall_commutant_unitary_conj {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} :
    x ∈ M ↔ ∀ u ∈ M.commutant, u ∈ unitary (H →L[ℂ] H) → u * x * star u = x := by
  rw [mem_iff_forall_commutant_mem_unitary]
  refine forall_congr' fun u => imp_congr_right fun _ => imp_congr_right fun hu => ?_
  rw [Commute.symm_iff, commute_unitary_iff_star_right_conjugate hu]

end Unitary

section Polar

/-- The modulus `x.modulus = √(x† x)` belongs to the von Neumann algebra generated by `star x * x`.
-/
theorem modulus_mem_adjoin_star_mul_self (x : H →L[ℂ] H) :
    x.modulus ∈ adjoin {star x * x} := by
  rw [ContinuousLinearMap.modulus_eq_sqrt, CFC.sqrt, ← ContinuousLinearMap.star_eq_adjoint,
    ← ContinuousLinearMap.mul_def]
  exact cfcₙ_nnreal_mem (𝕜 := ℂ) NNReal.sqrt (subset_adjoin _ (Set.mem_singleton _))

/-- The modulus `x.modulus` belongs to the von Neumann algebra generated by `x`. -/
theorem modulus_mem_adjoin (x : H →L[ℂ] H) : x.modulus ∈ adjoin {x} := by
  refine (adjoin_le_iff.2 ?_) (modulus_mem_adjoin_star_mul_self x)
  rw [Set.singleton_subset_iff]
  have hx : x ∈ adjoin {x} := subset_adjoin _ (Set.mem_singleton x)
  exact mul_mem (star_mem hx) hx

/-- If `x` belongs to a von Neumann algebra `M`, then its modulus `x.modulus` belongs to `M`. -/
theorem modulus_mem {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} (hx : x ∈ M) :
    x.modulus ∈ M :=
  (adjoin_le_iff.2 (Set.singleton_subset_iff.2 hx)) (modulus_mem_adjoin x)

/-- The polar partial isometry `x.polarFactor` belongs to the von Neumann algebra generated by `x`.
-/
theorem polarFactor_mem_adjoin (x : H →L[ℂ] H) : x.polarFactor ∈ adjoin {x} := by
  rw [mem_iff_forall_commutant_mem_unitary]
  intro u huM hu
  have hux : Commute u x :=
    ((mem_commutant_iff.1 huM) x (subset_adjoin _ (Set.mem_singleton x))).symm
  exact (ContinuousLinearMap.commute_polarFactor_of_mem_unitary hu hux).symm

/-- If `x` belongs to a von Neumann algebra `M`, then its polar partial isometry `x.polarFactor`
belongs to `M`. -/
theorem polarFactor_mem {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} (hx : x ∈ M) :
    x.polarFactor ∈ M :=
  (adjoin_le_iff.2 (Set.singleton_subset_iff.2 hx)) (polarFactor_mem_adjoin x)

/-- The orthogonal projection onto `(ker x)ᗮ` (the initial projection of `x`) belongs to
`adjoin {x}`. -/
theorem starProjection_orthogonal_ker_mem_adjoin (x : H →L[ℂ] H) :
    x.kerᗮ.starProjection ∈ adjoin {x} := by
  rw [← x.adjoint_polarFactor_comp_polarFactor, ← ContinuousLinearMap.star_eq_adjoint,
    ← ContinuousLinearMap.mul_def]
  exact mul_mem (star_mem (polarFactor_mem_adjoin x)) (polarFactor_mem_adjoin x)

/-- If `x ∈ M`, then the orthogonal projection onto `(ker x)ᗮ` belongs to `M`. -/
theorem starProjection_orthogonal_ker_mem {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} (hx : x ∈ M) :
    x.kerᗮ.starProjection ∈ M :=
  (adjoin_le_iff.2 (Set.singleton_subset_iff.2 hx)) (starProjection_orthogonal_ker_mem_adjoin x)

/-- The orthogonal projection onto `ker x` belongs to `adjoin {x}`. -/
theorem starProjection_ker_mem_adjoin (x : H →L[ℂ] H) :
    x.ker.starProjection ∈ adjoin {x} := by
  have hker : x.ker.starProjection = 1 - x.kerᗮ.starProjection := by
    rw [Submodule.starProjection_orthogonal', sub_sub_cancel]
  rw [hker]
  exact sub_mem (one_mem _) (starProjection_orthogonal_ker_mem_adjoin x)

/-- If `x ∈ M`, then the orthogonal projection onto `ker x` belongs to `M`. -/
theorem starProjection_ker_mem {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} (hx : x ∈ M) :
    x.ker.starProjection ∈ M :=
  (adjoin_le_iff.2 (Set.singleton_subset_iff.2 hx)) (starProjection_ker_mem_adjoin x)

/-- The orthogonal projection onto the closure of `range x` (the final projection of `x`) belongs to
`adjoin {x}`. -/
theorem starProjection_topologicalClosure_range_mem_adjoin (x : H →L[ℂ] H) :
    x.range.topologicalClosure.starProjection ∈ adjoin {x} := by
  rw [← x.polarFactor_comp_adjoint_polarFactor, ← ContinuousLinearMap.star_eq_adjoint,
    ← ContinuousLinearMap.mul_def]
  exact mul_mem (polarFactor_mem_adjoin x) (star_mem (polarFactor_mem_adjoin x))

/-- If `x ∈ M`, then the orthogonal projection onto the closure of `range x` belongs to `M`. -/
theorem starProjection_topologicalClosure_range_mem {M : VonNeumannAlgebra H} {x : H →L[ℂ] H}
    (hx : x ∈ M) : x.range.topologicalClosure.starProjection ∈ M :=
  (adjoin_le_iff.2 (Set.singleton_subset_iff.2 hx))
    (starProjection_topologicalClosure_range_mem_adjoin x)

end Polar

end VonNeumannAlgebra
