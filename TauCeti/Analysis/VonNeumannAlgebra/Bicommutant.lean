public import TauCeti.Analysis.LocallyConvex.WeakOperatorTopology
public import TauCeti.Analysis.VonNeumannAlgebra.Density

/-!
# The bicommutant theorem

For a unital star subalgebra of bounded operators on a complete real or complex Hilbert
space, its closures in the strong, weak, ultrastrong, and ultraweak operator topologies are all
equal to its double commutant. In particular, equality with the double commutant is equivalent to
closedness in any of the four operator topologies.

The closures are taken on the separate topology copies (`PointwiseConvergenceCLM`,
`ContinuousLinearMapWOT`, `TauCeti.ContinuousLinearMapUltrastrong`, and
`TauCeti.ContinuousLinearMapUltraweak`), not in the operator norm. For a concrete complex von
Neumann algebra this gives closedness in all four topologies; for a generated algebra it identifies
each closure of the star algebra generated by the original set
(`VonNeumannAlgebra.image_ofCLM_adjoin_eq_closure`,
`VonNeumannAlgebra.image_ultraweak_ofCLM_adjoin_eq_closure`). Taking the star algebra first is
essential for a set not closed under adjoints.

Since operator balls are compact in both the weak and ultraweak topologies, closedness makes every
closed norm ball of a concrete von Neumann algebra compact in both topologies.

The approximation inputs are the strong and ultrastrong finite-family density theorems in
`TauCeti.Analysis.VonNeumannAlgebra.Density`.

The same holds for self-adjoint parts: the closures in all four topologies of the self-adjoint
elements of the algebra are the self-adjoint elements of the double commutant. The weak and
ultraweak forms apply the continuous real-part map `A ↦ 2⁻¹ • (A + A⋆)` to the bicommutant
theorem; the strong and ultrastrong forms follow because the self-adjoint part is convex, so the
strong closure agrees with the weak closure and the ultrastrong closure agrees with the ultraweak
closure.

## References

* R. V. Kadison and J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras I*, Theorem
  5.3.1, and the proof of Theorem 5.3.5 for the self-adjoint parts.
* J. Dixmier, *Von Neumann Algebras*, North-Holland, 1981, Part I, Chapter 3, §4, Theorem 2.
-/

public section

open TauCeti
open scoped Topology

namespace StarSubalgebra

variable {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
    [CompleteSpace H]

/-- The strong operator closure of a unital star subalgebra is its double commutant. -/
theorem closure_image_toPointwiseConvergenceCLM
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    closure (ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H ''
      (S : Set (H →L[𝕜] H))) =
      ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H ''
        (S : Set (H →L[𝕜] H)).centralizer.centralizer := by
  let q := ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H
  have hclosed : IsClosed (q '' (S : Set (H →L[𝕜] H)).centralizer.centralizer) := by
    -- The pointwise copy has the same underlying maps; the preimage is along the
    -- continuous identity to the WOT copy, not along a norm-continuous inverse.
    convert ((S : Set (H →L[𝕜] H)).centralizer.isClosed_image_ofCLM_centralizer).preimage
      ContinuousLinearMapWOT.continuous_ofPointwiseConvergenceCLM using 1
    ext T
    simp only [q, Set.mem_image, Set.mem_preimage,
      ContinuousLinearMap.toPointwiseConvergenceCLM_apply]
    constructor
    · rintro ⟨a, ha, h⟩
      exact ⟨a, ha, congrArg ContinuousLinearMapWOT.ofCLM h⟩
    · rintro ⟨a, ha, h⟩
      exact ⟨a, ha, ContinuousLinearMapWOT.ofCLM_injective h⟩
  refine subset_antisymm
    (closure_minimal (Set.image_mono Set.subset_centralizer_centralizer) hclosed) ?_
  rintro _ ⟨x, hx, rfl⟩
  rw [mem_closure_iff_nhds_basis
    ((PointwiseConvergenceCLM.hasBasis_nhds_zero_of_basis
      (σ := RingHom.id 𝕜) (E := H) Metric.nhds_basis_ball).nhds_of_zero (q x))]
  rintro ⟨F, ε⟩ ⟨hF, hε⟩
  obtain ⟨s, hs, happrox⟩ := S.exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer
    hx (fun v : F => (v : H)) hε
  refine ⟨q s, ⟨s, hs, rfl⟩, ?_⟩
  intro v hv
  rw [Metric.mem_ball, dist_zero_right, sub_apply, norm_sub_rev]
  exact happrox ⟨v, hv⟩

/-- The weak operator closure of a unital star subalgebra is its double commutant. -/
theorem closure_image_ofCLM (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    closure (ContinuousLinearMapWOT.ofCLM '' (S : Set (H →L[𝕜] H))) =
      ContinuousLinearMapWOT.ofCLM '' (S : Set (H →L[𝕜] H)).centralizer.centralizer := by
  refine subset_antisymm
    (closure_minimal (Set.image_mono Set.subset_centralizer_centralizer)
      ((S : Set (H →L[𝕜] H)).centralizer.isClosed_image_ofCLM_centralizer)) ?_
  rintro _ ⟨x, hx, rfl⟩
  have hx' : ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H x ∈
      closure (ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H ''
        (S : Set (H →L[𝕜] H))) := by
    rw [S.closure_image_toPointwiseConvergenceCLM]
    exact ⟨x, hx, rfl⟩
  simpa only [Set.image_image, Function.comp_def,
    ContinuousLinearMap.toPointwiseConvergenceCLM_apply] using
    mem_closure_image
      ContinuousLinearMapWOT.continuous_ofPointwiseConvergenceCLM.continuousAt hx'

/-- The ultrastrong operator closure of a unital star subalgebra is its double commutant. -/
theorem closure_image_ultrastrong_ofCLM (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    closure (ContinuousLinearMapUltrastrong.ofCLM '' (S : Set (H →L[𝕜] H))) =
      ContinuousLinearMapUltrastrong.ofCLM '' (S : Set (H →L[𝕜] H)).centralizer.centralizer := by
  refine subset_antisymm
    (closure_minimal (Set.image_mono Set.subset_centralizer_centralizer)
      (ContinuousLinearMapUltrastrong.isClosed_image_ofCLM_centralizer _)) ?_
  rintro _ ⟨x, hx, rfl⟩
  rw [mem_closure_iff_nhds_basis (ContinuousLinearMapUltrastrong.hasBasis_ball _)]
  rintro ⟨ξ, ε⟩ hε
  obtain ⟨s, hs, happrox⟩ :=
    S.exists_forall_norm_ampliation_sub_apply_lt_of_mem_centralizer_centralizer
      hx (fun _ : Unit ↦ ξ) hε
  refine ⟨ContinuousLinearMapUltrastrong.ofCLM s, ⟨s, hs, rfl⟩, ?_⟩
  rw [Seminorm.mem_ball, ContinuousLinearMapUltrastrong.seminorm_apply,
    ContinuousLinearMapUltrastrong.toCLM_sub, map_sub, sub_apply, norm_sub_rev]
  exact happrox ()

/-- The ultraweak operator closure of a unital star subalgebra is its double commutant. -/
theorem closure_image_ultraweak_ofCLM (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    closure (ContinuousLinearMapUltraweak.ofCLM '' (S : Set (H →L[𝕜] H))) =
      ContinuousLinearMapUltraweak.ofCLM '' (S : Set (H →L[𝕜] H)).centralizer.centralizer := by
  refine subset_antisymm
    (closure_minimal (Set.image_mono Set.subset_centralizer_centralizer)
      (ContinuousLinearMapUltraweak.isClosed_image_ofCLM_centralizer _)) ?_
  rintro _ ⟨x, hx, rfl⟩
  have hx' : ContinuousLinearMapUltrastrong.ofCLM x ∈
      closure (ContinuousLinearMapUltrastrong.ofCLM '' (S : Set (H →L[𝕜] H))) := by
    rw [S.closure_image_ultrastrong_ofCLM]
    exact ⟨x, hx, rfl⟩
  simpa only [Set.image_image, Function.comp_def] using
    mem_closure_image ContinuousLinearMapUltraweak.continuous_ofUltrastrong.continuousAt hx'

private theorem convex_inter_selfAdjoint [NormedSpace ℝ H] [IsScalarTower ℝ 𝕜 H]
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    Convex ℝ ((S : Set (H →L[𝕜] H)) ∩ selfAdjoint (H →L[𝕜] H)) := by
  -- Mathlib records only `StarModule 𝕜` here; real scalars act through `𝕜`, so they commute
  -- with adjoints and `selfAdjoint.submodule ℝ` is available.
  have : StarModule ℝ (H →L[𝕜] H) := ⟨fun r a ↦ by
    simp only [RCLike.real_smul_eq_coe_smul (K := 𝕜), star_smul, RCLike.star_def,
      RCLike.conj_ofReal, star_trivial]⟩
  exact (S.toSubalgebra.toSubmodule.restrictScalars ℝ).convex.inter
    (selfAdjoint.submodule ℝ (H →L[𝕜] H)).convex

/-- The weak operator closure of the self-adjoint part of a unital star subalgebra is the
self-adjoint part of its double commutant. -/
theorem closure_image_ofCLM_inter_selfAdjoint (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    closure (ContinuousLinearMapWOT.ofCLM ''
      ((S : Set (H →L[𝕜] H)) ∩ selfAdjoint (H →L[𝕜] H))) =
      ContinuousLinearMapWOT.ofCLM ''
        ((S : Set (H →L[𝕜] H)).centralizer.centralizer ∩ selfAdjoint (H →L[𝕜] H)) := by
  -- Adjoints on the WOT copy are computed on the underlying operators.
  have hsa {x : H →L[𝕜] H} : IsSelfAdjoint (ContinuousLinearMapWOT.ofCLM x) ↔
      IsSelfAdjoint x :=
    ContinuousLinearMapWOT.ofCLM_injective.eq_iff
  refine subset_antisymm (fun A hA ↦ ?_) ?_
  · have hA' :
        A ∈ ContinuousLinearMapWOT.ofCLM '' (S : Set (H →L[𝕜] H)).centralizer.centralizer :=
      S.closure_image_ofCLM ▸ closure_mono (Set.image_mono Set.inter_subset_left) hA
    have hAsa : IsSelfAdjoint A := by
      refine closure_minimal ?_ (isClosed_eq continuous_star continuous_id) hA
      rintro _ ⟨a, ha, rfl⟩
      exact hsa.mpr ha.2
    obtain ⟨x, hx, rfl⟩ := hA'
    exact ⟨x, ⟨hx, hsa.mp hAsa⟩, rfl⟩
  · rintro _ ⟨x, ⟨hx, hxsa⟩, rfl⟩
    -- Apply the WOT-continuous real part `A ↦ 2⁻¹ • (A + A⋆)` to the WOT density of `S`.
    have hmem : ContinuousLinearMapWOT.ofCLM x ∈
        closure (ContinuousLinearMapWOT.ofCLM '' (S : Set (H →L[𝕜] H))) :=
      S.closure_image_ofCLM ▸ ⟨x, hx, rfl⟩
    have h2 : IsSelfAdjoint (2⁻¹ : 𝕜) := by simp [IsSelfAdjoint]
    have hre := map_mem_closure (f := fun A : H →WOT[𝕜] H ↦ (2⁻¹ : 𝕜) • (A + star A))
      (by fun_prop) hmem (t := ContinuousLinearMapWOT.ofCLM ''
        ((S : Set (H →L[𝕜] H)) ∩ selfAdjoint (H →L[𝕜] H))) (by
        rintro _ ⟨a, ha, rfl⟩
        exact ⟨(2⁻¹ : 𝕜) • (a + star a),
          ⟨SMulMemClass.smul_mem _ (add_mem ha (star_mem ha)), h2.smul (.add_star_self a)⟩, rfl⟩)
    have hx2 : (2⁻¹ : 𝕜) • (x + star x) = x := by
      rw [hxsa.star_eq, ← two_smul 𝕜 x, smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul]
    convert hre using 1
    exact congrArg ContinuousLinearMapWOT.ofCLM hx2.symm

/-- The strong operator closure of the self-adjoint part of a unital star subalgebra is the
self-adjoint part of its double commutant. -/
theorem closure_image_toPointwiseConvergenceCLM_inter_selfAdjoint [NormedSpace ℝ H]
    [IsScalarTower ℝ 𝕜 H] (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    closure (ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H ''
      ((S : Set (H →L[𝕜] H)) ∩ selfAdjoint (H →L[𝕜] H))) =
      ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H ''
        ((S : Set (H →L[𝕜] H)).centralizer.centralizer ∩ selfAdjoint (H →L[𝕜] H)) := by
  set q := ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H
  ext T
  -- `q` is the identity on underlying operators.
  obtain ⟨x, rfl⟩ : ∃ x : H →L[𝕜] H, q x = T := ⟨T, rfl⟩
  rw [(S.convex_inter_selfAdjoint).toPointwiseConvergenceCLM_mem_closure_image_iff,
    S.closure_image_ofCLM_inter_selfAdjoint, ContinuousLinearMapWOT.ofCLM_injective.mem_set_image,
    ContinuousLinearMap.toPointwiseConvergenceCLM_injective.mem_set_image]

/-- The ultraweak operator closure of the self-adjoint part of a unital star subalgebra is the
self-adjoint part of its double commutant. -/
theorem closure_image_ultraweak_ofCLM_inter_selfAdjoint (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    closure (ContinuousLinearMapUltraweak.ofCLM ''
      ((S : Set (H →L[𝕜] H)) ∩ selfAdjoint (H →L[𝕜] H))) =
      ContinuousLinearMapUltraweak.ofCLM ''
        ((S : Set (H →L[𝕜] H)).centralizer.centralizer ∩ selfAdjoint (H →L[𝕜] H)) := by
  have hsa {x : H →L[𝕜] H} : IsSelfAdjoint (ContinuousLinearMapUltraweak.ofCLM x) ↔
      IsSelfAdjoint x :=
    ContinuousLinearMapUltraweak.ofCLM_injective.eq_iff
  refine subset_antisymm (fun A hA ↦ ?_) ?_
  · have hA' : A ∈
        ContinuousLinearMapUltraweak.ofCLM '' (S : Set (H →L[𝕜] H)).centralizer.centralizer :=
      S.closure_image_ultraweak_ofCLM ▸ closure_mono (Set.image_mono Set.inter_subset_left) hA
    have hAsa : IsSelfAdjoint A := by
      refine closure_minimal ?_ (isClosed_eq continuous_star continuous_id) hA
      rintro _ ⟨a, ha, rfl⟩
      exact hsa.mpr ha.2
    obtain ⟨x, hx, rfl⟩ := hA'
    exact ⟨x, ⟨hx, hsa.mp hAsa⟩, rfl⟩
  · rintro _ ⟨x, ⟨hx, hxsa⟩, rfl⟩
    -- Apply the ultraweakly continuous real part `A ↦ 2⁻¹ • (A + A⋆)` to ultraweak density of `S`.
    have hmem : ContinuousLinearMapUltraweak.ofCLM x ∈
        closure (ContinuousLinearMapUltraweak.ofCLM '' (S : Set (H →L[𝕜] H))) :=
      S.closure_image_ultraweak_ofCLM ▸ ⟨x, hx, rfl⟩
    have h2 : IsSelfAdjoint (2⁻¹ : 𝕜) := by simp [IsSelfAdjoint]
    have hre := map_mem_closure
      (f := fun A : ContinuousLinearMapUltraweak 𝕜 H H ↦ (2⁻¹ : 𝕜) • (A + star A))
      (by fun_prop) hmem (t := ContinuousLinearMapUltraweak.ofCLM ''
        ((S : Set (H →L[𝕜] H)) ∩ selfAdjoint (H →L[𝕜] H))) (by
        rintro _ ⟨a, ha, rfl⟩
        exact ⟨(2⁻¹ : 𝕜) • (a + star a),
          ⟨SMulMemClass.smul_mem _ (add_mem ha (star_mem ha)), h2.smul (.add_star_self a)⟩, rfl⟩)
    have hx2 : (2⁻¹ : 𝕜) • (x + star x) = x := by
      rw [hxsa.star_eq, ← two_smul 𝕜 x, smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul]
    convert hre using 1
    exact congrArg ContinuousLinearMapUltraweak.ofCLM hx2.symm

/-- The ultrastrong operator closure of the self-adjoint part of a unital star subalgebra is the
self-adjoint part of its double commutant. -/
theorem closure_image_ultrastrong_ofCLM_inter_selfAdjoint [NormedSpace ℝ H]
    [IsScalarTower ℝ 𝕜 H] (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    closure (ContinuousLinearMapUltrastrong.ofCLM ''
      ((S : Set (H →L[𝕜] H)) ∩ selfAdjoint (H →L[𝕜] H))) =
      ContinuousLinearMapUltrastrong.ofCLM ''
        ((S : Set (H →L[𝕜] H)).centralizer.centralizer ∩ selfAdjoint (H →L[𝕜] H)) := by
  ext T
  obtain ⟨x, rfl⟩ := ContinuousLinearMapUltrastrong.ofCLM_surjective T
  rw [(S.convex_inter_selfAdjoint).ultrastrong_ofCLM_mem_closure_image_iff,
    S.closure_image_ultraweak_ofCLM_inter_selfAdjoint,
    ContinuousLinearMapUltraweak.ofCLM_injective.mem_set_image,
    ContinuousLinearMapUltrastrong.ofCLM_injective.mem_set_image]

/-- **The bicommutant theorem:** a unital star subalgebra equals its double commutant
if and only if it is weak operator closed. -/
theorem double_commutant_iff_isClosed_image_ofCLM
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    (S : Set (H →L[𝕜] H)).centralizer.centralizer = S ↔
      IsClosed (ContinuousLinearMapWOT.ofCLM '' (S : Set (H →L[𝕜] H))) := by
  rw [← closure_eq_iff_isClosed, S.closure_image_ofCLM,
    Set.image_injective.mpr ContinuousLinearMapWOT.ofCLM_injective |>.eq_iff]

/-- A unital star subalgebra equals its double commutant if and only if it is
strong operator closed. -/
theorem double_commutant_iff_isClosed_image_toPointwiseConvergenceCLM
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    (S : Set (H →L[𝕜] H)).centralizer.centralizer = S ↔
      IsClosed (ContinuousLinearMap.toPointwiseConvergenceCLM 𝕜 (RingHom.id 𝕜) H H ''
        (S : Set (H →L[𝕜] H))) := by
  rw [← closure_eq_iff_isClosed, S.closure_image_toPointwiseConvergenceCLM]
  exact (Set.image_injective.mpr
    ContinuousLinearMap.toPointwiseConvergenceCLM_injective).eq_iff.symm

/-- **The ultraweak bicommutant theorem:** a unital star subalgebra equals its double commutant if
and only if it is ultraweakly closed. -/
theorem double_commutant_iff_isClosed_image_ultraweak_ofCLM
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    (S : Set (H →L[𝕜] H)).centralizer.centralizer = S ↔
      IsClosed (ContinuousLinearMapUltraweak.ofCLM '' (S : Set (H →L[𝕜] H))) := by
  rw [← closure_eq_iff_isClosed, S.closure_image_ultraweak_ofCLM,
    Set.image_injective.mpr ContinuousLinearMapUltraweak.ofCLM_injective |>.eq_iff]

/-- **The ultrastrong bicommutant theorem:** a unital star subalgebra equals its double commutant
if and only if it is ultrastrongly closed. -/
theorem double_commutant_iff_isClosed_image_ultrastrong_ofCLM
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    (S : Set (H →L[𝕜] H)).centralizer.centralizer = S ↔
      IsClosed (ContinuousLinearMapUltrastrong.ofCLM '' (S : Set (H →L[𝕜] H))) := by
  rw [← closure_eq_iff_isClosed, S.closure_image_ultrastrong_ofCLM,
    Set.image_injective.mpr ContinuousLinearMapUltrastrong.ofCLM_injective |>.eq_iff]

end StarSubalgebra

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- A concrete von Neumann algebra is weak operator closed. -/
theorem isClosed_image_ofCLM (M : VonNeumannAlgebra H) :
    IsClosed (ContinuousLinearMapWOT.ofCLM '' (M : Set (H →L[ℂ] H))) :=
  M.toStarSubalgebra.double_commutant_iff_isClosed_image_ofCLM.mp M.centralizer_centralizer

/-- Every closed norm ball of a concrete von Neumann algebra is weak operator compact; in
particular, so is its unit ball. -/
theorem isCompact_image_ofCLM_inter_closedBall (M : VonNeumannAlgebra H) (A : H →L[ℂ] H)
    (r : ℝ) :
    IsCompact (ContinuousLinearMapWOT.ofCLM ''
      ((M : Set (H →L[ℂ] H)) ∩ Metric.closedBall A r)) := by
  rw [Set.image_inter ContinuousLinearMapWOT.ofCLM_injective]
  exact (ContinuousLinearMapWOT.isCompact_image_ofCLM_closedBall A r).inter_left
    M.isClosed_image_ofCLM

/-- A concrete von Neumann algebra is strong operator closed. -/
theorem isClosed_image_toPointwiseConvergenceCLM (M : VonNeumannAlgebra H) :
    IsClosed (ContinuousLinearMap.toPointwiseConvergenceCLM ℂ (RingHom.id ℂ) H H ''
      (M : Set (H →L[ℂ] H))) :=
  M.toStarSubalgebra.double_commutant_iff_isClosed_image_toPointwiseConvergenceCLM.mp
    M.centralizer_centralizer

/-- A concrete von Neumann algebra is ultraweakly closed. -/
theorem isClosed_image_ultraweak_ofCLM (M : VonNeumannAlgebra H) :
    IsClosed (ContinuousLinearMapUltraweak.ofCLM '' (M : Set (H →L[ℂ] H))) :=
  M.toStarSubalgebra.double_commutant_iff_isClosed_image_ultraweak_ofCLM.mp
    M.centralizer_centralizer

/-- Every closed norm ball of a concrete von Neumann algebra is ultraweakly compact; in particular,
so is its unit ball. -/
theorem isCompact_image_ultraweak_ofCLM_inter_closedBall (M : VonNeumannAlgebra H) (A : H →L[ℂ] H)
    (r : ℝ) :
    IsCompact (ContinuousLinearMapUltraweak.ofCLM ''
      ((M : Set (H →L[ℂ] H)) ∩ Metric.closedBall A r)) := by
  rw [Set.image_inter ContinuousLinearMapUltraweak.ofCLM_injective]
  exact (ContinuousLinearMapUltraweak.isCompact_image_ofCLM_closedBall A r).inter_left
    M.isClosed_image_ultraweak_ofCLM

/-- A concrete von Neumann algebra is ultrastrongly closed. -/
theorem isClosed_image_ultrastrong_ofCLM (M : VonNeumannAlgebra H) :
    IsClosed (ContinuousLinearMapUltrastrong.ofCLM '' (M : Set (H →L[ℂ] H))) :=
  M.toStarSubalgebra.double_commutant_iff_isClosed_image_ultrastrong_ofCLM.mp
    M.centralizer_centralizer

/-- The von Neumann algebra generated by `s` is the weak operator closure of the star algebra
generated by `s`. -/
theorem image_ofCLM_adjoin_eq_closure (s : Set (H →L[ℂ] H)) :
    ContinuousLinearMapWOT.ofCLM '' (adjoin s : Set (H →L[ℂ] H)) =
      closure (ContinuousLinearMapWOT.ofCLM '' (StarAlgebra.adjoin ℂ s : Set (H →L[ℂ] H))) := by
  rw [StarSubalgebra.closure_image_ofCLM, ← adjoin_starAlgebraAdjoin,
    coe_adjoin_of_star_subset (StarMemClass.star_coe_eq _).subset]

/-- The von Neumann algebra generated by `s` is the strong operator closure of the star algebra
generated by `s`. -/
theorem image_toPointwiseConvergenceCLM_adjoin_eq_closure (s : Set (H →L[ℂ] H)) :
    ContinuousLinearMap.toPointwiseConvergenceCLM ℂ (RingHom.id ℂ) H H ''
        (adjoin s : Set (H →L[ℂ] H)) =
      closure (ContinuousLinearMap.toPointwiseConvergenceCLM ℂ (RingHom.id ℂ) H H ''
        (StarAlgebra.adjoin ℂ s : Set (H →L[ℂ] H))) := by
  rw [StarSubalgebra.closure_image_toPointwiseConvergenceCLM, ← adjoin_starAlgebraAdjoin,
    coe_adjoin_of_star_subset (StarMemClass.star_coe_eq _).subset]

/-- The von Neumann algebra generated by `s` is the ultraweak closure of the star algebra generated
by `s`. -/
theorem image_ultraweak_ofCLM_adjoin_eq_closure (s : Set (H →L[ℂ] H)) :
    ContinuousLinearMapUltraweak.ofCLM '' (adjoin s : Set (H →L[ℂ] H)) =
      closure
        (ContinuousLinearMapUltraweak.ofCLM '' (StarAlgebra.adjoin ℂ s : Set (H →L[ℂ] H))) := by
  rw [StarSubalgebra.closure_image_ultraweak_ofCLM, ← adjoin_starAlgebraAdjoin,
    coe_adjoin_of_star_subset (StarMemClass.star_coe_eq _).subset]

/-- The von Neumann algebra generated by `s` is the ultrastrong closure of the star algebra
generated by `s`. -/
theorem image_ultrastrong_ofCLM_adjoin_eq_closure (s : Set (H →L[ℂ] H)) :
    ContinuousLinearMapUltrastrong.ofCLM '' (adjoin s : Set (H →L[ℂ] H)) =
      closure
        (ContinuousLinearMapUltrastrong.ofCLM '' (StarAlgebra.adjoin ℂ s : Set (H →L[ℂ] H))) := by
  rw [StarSubalgebra.closure_image_ultrastrong_ofCLM, ← adjoin_starAlgebraAdjoin,
    coe_adjoin_of_star_subset (StarMemClass.star_coe_eq _).subset]

end VonNeumannAlgebra
