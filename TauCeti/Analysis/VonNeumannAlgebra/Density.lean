/-!
# The von Neumann density theorem

Let `A` be a nonunital star subalgebra of the bounded operators on a Hilbert space `H` over `ℝ` or
`ℂ`. Every operator `x` in the double commutant `A''` that vanishes on the common annihilator
`A.essentialSubspaceᗮ` is a strong-operator limit of elements of `A`: for a single vector `v`,
`x v` lies in the closure of the orbit `A v`
(`NonUnitalStarSubalgebra.apply_mem_closure_of_mem_centralizer_centralizer`), and for finitely many
vectors `v i` and every `ε > 0` there is `a ∈ A` with `‖x (v i) - a (v i)‖ < ε` for all `i`
(`NonUnitalStarSubalgebra.exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer`). When
`A.essentialSubspace = ⊤`, this holds for every `x ∈ A''`
(`exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer_of_essentialSubspace_eq_top`).

Specializing to a unital star subalgebra `S` (whose essential subspace is `⊤`) yields the unital
von Neumann density theorems
`StarSubalgebra.apply_mem_closure_of_mem_centralizer_centralizer` and
`StarSubalgebra.exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer`.

Applying this result to the countable Hilbert-sum ampliation `lp.ampliationStarAlgHom ℕ 𝕜 H` via
`lp.ampliation_mem_centralizer_centralizer` yields ultrastrong density as well: for finitely many
square-summable sequences `ξ i ∈ ℓ²(ℕ, H)` and every `ε > 0` there is `s ∈ S` with
`‖(⊕ₙ x) (ξ i) - (⊕ₙ s) (ξ i)‖ < ε` (and `∑' n, ‖x (ξ i n) - s (ξ i n)‖ ^ 2 < ε`) for all `i`,
`StarSubalgebra.exists_forall_norm_ampliation_sub_apply_lt_of_mem_centralizer_centralizer` and
`StarSubalgebra.exists_forall_tsum_norm_sub_sq_lt_of_mem_centralizer_centralizer`.

For a von Neumann algebra generated by a set `s` of operators on a complex Hilbert space, every
element of `VonNeumannAlgebra.adjoin s` is approximated in both senses by elements of the star
algebra generated by `s`, `VonNeumannAlgebra.exists_forall_norm_sub_apply_lt_of_mem_adjoin` and
`VonNeumannAlgebra.exists_forall_tsum_norm_sub_sq_lt_of_mem_adjoin`.

For a single vector `v`, the closure `K` of the orbit `A v` has carrier
`closure ((fun a => a v) '' A)` (`NonUnitalStarSubalgebra.coe_topologicalClosure_map_apply`) and is
invariant under `A` and its adjoints, so its orthogonal projection lies in the commutant `A'`
(`NonUnitalStarSubalgebra.starProjection_topologicalClosure_map_apply_mem_centralizer`), and
agrees with `A.essentialSubspace.starProjection` at `v`. Finitely many vectors are handled by
diagonal amplification on the Hilbert sum `PiLp 2 (fun _ : ι => H)` through `PiLp.diagStarAlgHom`
and `PiLp.diagStarAlgHom_mem_centralizer_centralizer`.

Simultaneous approximation on finitely many vectors is what lets an identity between vector
functionals `y ↦ ⟪u, y v⟫`, proved for `y` in the range `π(A)` of a representation, pass to the
von Neumann algebra `π(A)''` that it generates,
`VonNeumannAlgebra.inner_apply_eq_of_mem_adjoin`.

## References

* R. V. Kadison and J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras I*, Theorem
  5.3.1, for the double commutant theorem and its amplification proof.
* J. Dixmier, *Von Neumann Algebras*, North-Holland, 1981, Part I, Chapter 3, §4, Theorem 2, for
  ultrastrong density via countable ampliation.
-/

public section

open scoped ENNReal InnerProductSpace lp
open scoped Pointwise

namespace NonUnitalStarSubalgebra

variable {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]

/-- The closed submodule obtained by closing the orbit `A v` of a nonunital star subalgebra `A` has
carrier `closure ((fun a => a v) '' A)`. -/
theorem coe_topologicalClosure_map_apply (A : NonUnitalStarSubalgebra 𝕜 (H →L[𝕜] H)) (v : H) :
    (((A.toNonUnitalSubalgebra.toSubmodule.map
        (ContinuousLinearMap.apply 𝕜 H v).toLinearMap).topologicalClosure : Submodule 𝕜 H) :
        Set H) =
      closure ((fun a : H →L[𝕜] H => a v) '' (A : Set (H →L[𝕜] H))) := by
  simp only [Submodule.topologicalClosure_coe, Submodule.map_coe,
    NonUnitalSubalgebra.coe_toSubmodule, NonUnitalStarSubalgebra.coe_toNonUnitalSubalgebra,
    ContinuousLinearMap.coe_coe]
  exact congrArg closure (Set.image_congr fun a _ => ContinuousLinearMap.apply_apply v a)

/-- For a nonunital star subalgebra `A` and vector `v`, the orthogonal projection onto the closure
of the orbit `A v` lies in the commutant `A'`. -/
theorem starProjection_topologicalClosure_map_apply_mem_centralizer
    (A : NonUnitalStarSubalgebra 𝕜 (H →L[𝕜] H)) (v : H) :
    (A.toNonUnitalSubalgebra.toSubmodule.map
        (ContinuousLinearMap.apply 𝕜 H v).toLinearMap).topologicalClosure.starProjection ∈
      (A : Set (H →L[𝕜] H)).centralizer := by
  set K : Submodule 𝕜 H :=
    (A.toNonUnitalSubalgebra.toSubmodule.map
      (ContinuousLinearMap.apply 𝕜 H v).toLinearMap).topologicalClosure
  have hKc : IsClosed (K : Set H) := Submodule.isClosed_topologicalClosure _
  -- `K` is invariant under every element of `A`
  have hinv : ∀ t ∈ A, K ∈ Module.End.invtSubmodule (t : Module.End 𝕜 H) := by
    intro t ht
    rw [Module.End.mem_invtSubmodule]
    refine Submodule.topologicalClosure_minimal _ ?_ (hKc.preimage t.continuous)
    rintro _ ⟨a, ha, rfl⟩
    exact Submodule.le_topologicalClosure _
      ⟨t * a, A.mul_mem ht ha, by simp [_root_.mul_apply_eq_comp]⟩
  -- since `A` is closed under adjoints, the orthogonal projection onto `K` commutes with `A`
  intro t ht
  have hadj : K ∈ Module.End.invtSubmodule (t.adjoint : Module.End 𝕜 H) := by
    simpa [← ContinuousLinearMap.star_eq_adjoint] using hinv (star t) (star_mem ht)
  have hred : K.IsReducing (t : Module.End 𝕜 H) :=
    ContinuousLinearMap.isReducing_iff_mem_invtSubmodule_adjoint.mpr ⟨hinv t ht, hadj⟩
  exact (Submodule.isReducing_coe_iff_commute_starProjection.mp hred).eq.symm

/-- **Nonunital von Neumann density for one vector.** If `x ∈ A''` vanishes on the common
annihilator `A.essentialSubspaceᗮ`, then `x v` lies in the closure of the orbit `A v` for every
`v : H`. -/
theorem apply_mem_closure_of_mem_centralizer_centralizer
    (A : NonUnitalStarSubalgebra 𝕜 (H →L[𝕜] H)) {x : H →L[𝕜] H}
    (hx : x ∈ (A : Set (H →L[𝕜] H)).centralizer.centralizer)
    (hker : ∀ ξ ∈ A.essentialSubspaceᗮ, x ξ = 0) (v : H) :
    x v ∈ closure ((fun a : H →L[𝕜] H => a v) '' A) := by
  set K : Submodule 𝕜 H :=
    (A.toNonUnitalSubalgebra.toSubmodule.map
      (ContinuousLinearMap.apply 𝕜 H v).toLinearMap).topologicalClosure
  have hKcoe : (K : Set H) = closure ((fun a : H →L[𝕜] H => a v) '' A) :=
    A.coe_topologicalClosure_map_apply v
  have hKle : K ≤ A.essentialSubspace := by
    refine Submodule.topologicalClosure_minimal _ ?_ A.isClosed_essentialSubspace
    rintro _ ⟨a, ha, rfl⟩
    exact A.apply_mem_essentialSubspace ha v
  have hp : K.starProjection ∈ (A : Set (H →L[𝕜] H)).centralizer :=
    A.starProjection_topologicalClosure_map_apply_mem_centralizer v
  -- `A.essentialSubspace.starProjection v - K.starProjection v` lies in both `A.essentialSubspace`
  -- and `A.essentialSubspaceᗮ`, so it vanishes.
  have hdiff_orth :
      A.essentialSubspace.starProjection v - K.starProjection v ∈ A.essentialSubspaceᗮ := by
    refine A.mem_orthogonal_essentialSubspace_iff.2 fun a ha => ?_
    have haK : K.starProjection (a v) = a v :=
      K.starProjection_eq_self_iff.2 (Submodule.le_topologicalClosure _ ⟨a, ha, by simp⟩)
    calc a (A.essentialSubspace.starProjection v - K.starProjection v)
        = (a * A.essentialSubspace.starProjection) v - (a * K.starProjection) v := by
          rw [map_sub, _root_.mul_apply_eq_comp, _root_.mul_apply_eq_comp]
      _ = a v - K.starProjection (a v) := by
          rw [A.mul_starProjection_essentialSubspace ha, hp a ha, _root_.mul_apply_eq_comp]
      _ = 0 := by rw [haK, sub_self]
  have hdiff_mem :
      A.essentialSubspace.starProjection v - K.starProjection v ∈ A.essentialSubspace :=
    A.essentialSubspace.sub_mem (A.essentialSubspace.starProjection_apply_mem v)
      (hKle (K.starProjection_apply_mem v))
  have hpv_eq : A.essentialSubspace.starProjection v = K.starProjection v :=
    sub_eq_zero.1 <| (Submodule.mem_bot 𝕜).1 <|
      A.essentialSubspace.inf_orthogonal_eq_bot ▸ ⟨hdiff_mem, hdiff_orth⟩
  have hcomm : K.starProjection (x v) = x (K.starProjection v) := by
    simpa only [_root_.mul_apply_eq_comp] using DFunLike.congr_fun (hx _ hp) v
  have hxv : x v = K.starProjection (x v) :=
    calc x v = x (A.essentialSubspace.starProjection v) :=
          (A.essentialSubspace.apply_starProjection_eq_of_forall_mem_orthogonal hker v).symm
      _ = x (K.starProjection v) := by rw [hpv_eq]
      _ = K.starProjection (x v) := hcomm.symm
  rw [← hKcoe, SetLike.mem_coe, hxv]
  exact K.starProjection_apply_mem (x v)

/-- **The nonunital von Neumann density theorem.** Every operator `x` in `A''` that vanishes on the
common annihilator `A.essentialSubspaceᗮ` is a strong-operator limit of elements of `A`: for every
finite family of vectors `v : ι → H` and every `ε > 0`, some `a ∈ A` satisfies
`‖x (v i) - a (v i)‖ < ε` for all `i`. -/
theorem exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer
    (A : NonUnitalStarSubalgebra 𝕜 (H →L[𝕜] H)) {x : H →L[𝕜] H}
    (hx : x ∈ (A : Set (H →L[𝕜] H)).centralizer.centralizer)
    (hker : ∀ ξ ∈ A.essentialSubspaceᗮ, x ξ = 0) {ι : Type*} [Finite ι]
    (v : ι → H) {ε : ℝ} (hε : 0 < ε) : ∃ a ∈ A, ∀ i, ‖x (v i) - a (v i)‖ < ε := by
  classical
  have := Fintype.ofFinite ι
  let φ := (PiLp.diagStarAlgHom 𝕜 H ι).toNonUnitalStarAlgHom
  have hdiag : PiLp.diagStarAlgHom 𝕜 H ι x ∈
      ((A.map φ : NonUnitalStarSubalgebra 𝕜 _) : Set _).centralizer.centralizer := by
    rw [coe_map]
    simpa only [φ, StarAlgHom.coe_toNonUnitalStarAlgHom] using
      PiLp.diagStarAlgHom_mem_centralizer_centralizer (ι := ι) hx
  have hdiag_ker : ∀ z ∈ (A.map φ).essentialSubspaceᗮ, PiLp.diagStarAlgHom 𝕜 H ι x z = 0 := by
    intro z hz
    ext i
    have hzi : z i ∈ A.essentialSubspaceᗮ := by
      refine A.mem_orthogonal_essentialSubspace_iff.2 fun a ha => ?_
      have hza := (A.map φ).apply_eq_zero_of_mem_orthogonal_essentialSubspace hz
        (mem_map.2 ⟨a, ha, rfl⟩)
      simpa [φ] using congrArg (fun y : PiLp 2 (fun _ : ι => H) => y i) hza
    simpa using hker (z i) hzi
  obtain ⟨_, ⟨T, hT, rfl⟩, hlt⟩ := Metric.mem_closure_iff.1
    ((A.map φ).apply_mem_closure_of_mem_centralizer_centralizer hdiag hdiag_ker (WithLp.toLp 2 v))
    ε hε
  obtain ⟨a, ha, rfl⟩ := mem_map.1 hT
  refine ⟨a, ha, fun i => ?_⟩
  have hlt' : ‖PiLp.diagStarAlgHom 𝕜 H ι (x - a) (WithLp.toLp 2 v)‖ < ε := by
    simpa only [φ, StarAlgHom.coe_toNonUnitalStarAlgHom, dist_eq_norm, ← _root_.sub_apply,
      ← map_sub] using hlt
  calc ‖x (v i) - a (v i)‖
      = ‖PiLp.diagStarAlgHom 𝕜 H ι (x - a) (WithLp.toLp 2 v) i‖ := by simp
    _ ≤ ‖PiLp.diagStarAlgHom 𝕜 H ι (x - a) (WithLp.toLp 2 v)‖ := PiLp.norm_apply_le _ _
    _ < ε := hlt'

/-- When `A.essentialSubspace = ⊤`, every operator in `A''` (including `1`) is a strong-operator
limit of elements of `A`. -/
theorem exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer_of_essentialSubspace_eq_top
    {A : NonUnitalStarSubalgebra 𝕜 (H →L[𝕜] H)} (hA : A.essentialSubspace = ⊤) {x : H →L[𝕜] H}
    (hx : x ∈ (A : Set (H →L[𝕜] H)).centralizer.centralizer) {ι : Type*} [Finite ι]
    (v : ι → H) {ε : ℝ} (hε : 0 < ε) : ∃ a ∈ A, ∀ i, ‖x (v i) - a (v i)‖ < ε :=
  A.exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer hx
    (fun ξ hξ => by
      rw [hA, Submodule.top_orthogonal_eq_bot, Submodule.mem_bot] at hξ
      rw [hξ, map_zero]) v hε

end NonUnitalStarSubalgebra

namespace StarSubalgebra

variable {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]

/-- **The von Neumann density theorem for one vector.** An operator in the double commutant of a
unital star subalgebra `S` maps each vector `v` into the closure of the orbit `S v`. -/
theorem apply_mem_closure_of_mem_centralizer_centralizer [CompleteSpace H]
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) {x : H →L[𝕜] H}
    (hx : x ∈ (S : Set (H →L[𝕜] H)).centralizer.centralizer) (v : H) :
    x v ∈ closure ((fun s : H →L[𝕜] H => s v) '' S) := by
  have hScoe : (S.toNonUnitalStarSubalgebra : Set (H →L[𝕜] H)) = (S : Set (H →L[𝕜] H)) :=
    Set.ext fun _ => StarSubalgebra.mem_toNonUnitalStarSubalgebra
  rw [← hScoe] at hx ⊢
  exact S.toNonUnitalStarSubalgebra.apply_mem_closure_of_mem_centralizer_centralizer hx
    (fun ξ hξ => by
      rw [NonUnitalStarSubalgebra.essentialSubspace_toNonUnitalStarSubalgebra,
        Submodule.top_orthogonal_eq_bot, Submodule.mem_bot] at hξ
      rw [hξ, map_zero]) v

/-- **The von Neumann density theorem.** An operator `x` in the double commutant of a unital star
subalgebra `S` of the bounded operators on a Hilbert space is a strong-operator limit of elements
of `S`: for every finite family of vectors `v i` and every `ε > 0` there is `s ∈ S` with
`‖x (v i) - s (v i)‖ < ε` for all `i`. -/
theorem exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer [CompleteSpace H]
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) {x : H →L[𝕜] H}
    (hx : x ∈ (S : Set (H →L[𝕜] H)).centralizer.centralizer) {ι : Type*} [Finite ι]
    (v : ι → H) {ε : ℝ} (hε : 0 < ε) : ∃ s ∈ S, ∀ i, ‖x (v i) - s (v i)‖ < ε := by
  have hScoe : (S.toNonUnitalStarSubalgebra : Set (H →L[𝕜] H)) = (S : Set (H →L[𝕜] H)) :=
    Set.ext fun _ => StarSubalgebra.mem_toNonUnitalStarSubalgebra
  rw [← hScoe] at hx
  open NonUnitalStarSubalgebra in
  simpa only [StarSubalgebra.mem_toNonUnitalStarSubalgebra] using
    exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer_of_essentialSubspace_eq_top
      (essentialSubspace_toNonUnitalStarSubalgebra S) hx v hε

/-- **The ultrastrong von Neumann density theorem.** An operator `x` in the double commutant of a
unital star subalgebra `S` of the bounded operators on a Hilbert space is an ultrastrong limit of
elements of `S`: for every finite family of square-summable sequences `ξ i ∈ ℓ²(ℕ, H)` and every
`ε > 0` there is `s ∈ S` with `‖(⊕ₙ x) (ξ i) - (⊕ₙ s) (ξ i)‖ < ε` for all `i`. -/
theorem exists_forall_norm_ampliation_sub_apply_lt_of_mem_centralizer_centralizer
    [CompleteSpace H] (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) {x : H →L[𝕜] H}
    (hx : x ∈ (S : Set (H →L[𝕜] H)).centralizer.centralizer) {ι : Type*} [Finite ι]
    (ξ : ι → ℓ²(ℕ, H)) {ε : ℝ} (hε : 0 < ε) :
    ∃ s ∈ S, ∀ i, ‖lp.ampliation ℕ 2 x (ξ i) - lp.ampliation ℕ 2 s (ξ i)‖ < ε := by
  let S' := S.map (lp.ampliationStarAlgHom ℕ 𝕜 H)
  have hx' : lp.ampliation ℕ 2 x ∈ (S' : Set _).centralizer.centralizer := by
    rw [StarSubalgebra.coe_map, lp.coe_ampliationStarAlgHom]
    exact lp.ampliation_mem_centralizer_centralizer ENNReal.ofNat_ne_top hx
  obtain ⟨T, hT, hlt⟩ :=
    S'.exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer hx' ξ hε
  obtain ⟨s, hs, rfl⟩ := StarSubalgebra.mem_map.mp hT
  exact ⟨s, hs, by simpa using hlt⟩

/-- **Coordinate form of ultrastrong density.** For an operator `x` in the double commutant of a
unital star subalgebra `S`, every finite family of square-summable sequences `ξ i ∈ ℓ²(ℕ, H)`, and
every `ε > 0`, there is `s ∈ S` with `∑' n, ‖x (ξ i n) - s (ξ i n)‖ ^ 2 < ε` for all `i`. -/
theorem exists_forall_tsum_norm_sub_sq_lt_of_mem_centralizer_centralizer [CompleteSpace H]
    (S : StarSubalgebra 𝕜 (H →L[𝕜] H)) {x : H →L[𝕜] H}
    (hx : x ∈ (S : Set (H →L[𝕜] H)).centralizer.centralizer) {ι : Type*} [Finite ι]
    (ξ : ι → ℓ²(ℕ, H)) {ε : ℝ} (hε : 0 < ε) :
    ∃ s ∈ S, ∀ i, (∑' n, ‖x (ξ i n) - s (ξ i n)‖ ^ 2) < ε := by
  obtain ⟨s, hs, hlt⟩ :=
    S.exists_forall_norm_ampliation_sub_apply_lt_of_mem_centralizer_centralizer
      hx ξ (Real.sqrt_pos.2 hε)
  refine ⟨s, hs, fun i ↦ ?_⟩
  have hsq : ∑' n, ‖x (ξ i n) - s (ξ i n)‖ ^ 2 =
      ‖lp.ampliation ℕ 2 x (ξ i) - lp.ampliation ℕ 2 s (ξ i)‖ ^ 2 := by
    have hv := lp.norm_rpow_eq_tsum (p := 2) (by simp)
      (lp.ampliation ℕ 2 x (ξ i) - lp.ampliation ℕ 2 s (ξ i))
    simpa using hv.symm
  rw [hsq, ← Real.sq_sqrt hε.le]
  exact pow_lt_pow_left₀ (hlt i) (norm_nonneg _) two_ne_zero

end StarSubalgebra

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- **The von Neumann density theorem for a generated von Neumann algebra.** An operator `x` in
the von Neumann algebra generated by a set `s` of bounded operators is a strong-operator limit of
elements of the star algebra generated by `s`: for every finite family of vectors `v i` and every
`ε > 0` there is `t ∈ StarAlgebra.adjoin ℂ s` with `‖x (v i) - t (v i)‖ < ε` for all `i`. -/
theorem exists_forall_norm_sub_apply_lt_of_mem_adjoin {s : Set (H →L[ℂ] H)} {x : H →L[ℂ] H}
    (hx : x ∈ adjoin s) {ι : Type*} [Finite ι] (v : ι → H) {ε : ℝ} (hε : 0 < ε) :
    ∃ t ∈ StarAlgebra.adjoin ℂ s, ∀ i, ‖x (v i) - t (v i)‖ < ε :=
  (StarAlgebra.adjoin ℂ s).exists_forall_norm_sub_apply_lt_of_mem_centralizer_centralizer
    ((coe_adjoin_eq_centralizer_centralizer_starAlgebraAdjoin s).subset hx) v hε

/-- **Ultrastrong density for a generated von Neumann algebra.** For
`x ∈ VonNeumannAlgebra.adjoin s`, every finite family of square-summable sequences `ξ i ∈ ℓ²(ℕ, H)`,
and every `ε > 0`, there is `t ∈ StarAlgebra.adjoin ℂ s` with `‖(⊕ₙ x) (ξ i) - (⊕ₙ t) (ξ i)‖ < ε`
for all `i`. -/
theorem exists_forall_norm_ampliation_sub_apply_lt_of_mem_adjoin {s : Set (H →L[ℂ] H)}
    {x : H →L[ℂ] H} (hx : x ∈ adjoin s) {ι : Type*} [Finite ι] (ξ : ι → ℓ²(ℕ, H)) {ε : ℝ}
    (hε : 0 < ε) :
    ∃ t ∈ StarAlgebra.adjoin ℂ s,
      ∀ i, ‖lp.ampliation ℕ 2 x (ξ i) - lp.ampliation ℕ 2 t (ξ i)‖ < ε :=
  StarSubalgebra.exists_forall_norm_ampliation_sub_apply_lt_of_mem_centralizer_centralizer
    (StarAlgebra.adjoin ℂ s)
    ((coe_adjoin_eq_centralizer_centralizer_starAlgebraAdjoin s).subset hx) ξ hε

/-- **Coordinate ultrastrong density for a generated von Neumann algebra.** For
`x ∈ VonNeumannAlgebra.adjoin s`, every finite family of square-summable sequences `ξ i ∈ ℓ²(ℕ, H)`,
and every `ε > 0`, there is `t ∈ StarAlgebra.adjoin ℂ s` with
`∑' n, ‖x (ξ i n) - t (ξ i n)‖ ^ 2 < ε` for all `i`. -/
theorem exists_forall_tsum_norm_sub_sq_lt_of_mem_adjoin {s : Set (H →L[ℂ] H)} {x : H →L[ℂ] H}
    (hx : x ∈ adjoin s) {ι : Type*} [Finite ι] (ξ : ι → ℓ²(ℕ, H)) {ε : ℝ} (hε : 0 < ε) :
    ∃ t ∈ StarAlgebra.adjoin ℂ s, ∀ i, (∑' n, ‖x (ξ i n) - t (ξ i n)‖ ^ 2) < ε :=
  (StarAlgebra.adjoin ℂ s).exists_forall_tsum_norm_sub_sq_lt_of_mem_centralizer_centralizer
    ((coe_adjoin_eq_centralizer_centralizer_starAlgebraAdjoin s).subset hx) ξ hε

/-- **Vector functionals on a generated von Neumann algebra.** If the vector functionals
`y ↦ ⟪u₁, y v₁⟫` and `y ↦ ⟪u₂, y v₂⟫` agree on the star algebra generated by a set `s` of bounded
operators, they agree on the von Neumann algebra generated by `s`. -/
theorem inner_apply_eq_of_mem_adjoin {s : Set (H →L[ℂ] H)} {u₁ v₁ u₂ v₂ : H}
    (h : ∀ t ∈ StarAlgebra.adjoin ℂ s, ⟪u₁, t v₁⟫_ℂ = ⟪u₂, t v₂⟫_ℂ) {y : H →L[ℂ] H}
    (hy : y ∈ adjoin s) : ⟪u₁, y v₁⟫_ℂ = ⟪u₂, y v₂⟫_ℂ := by
  rw [← sub_eq_zero, ← norm_le_zero_iff]
  refine le_of_forall_pos_lt_add fun ε hε => ?_
  set C := ‖u₁‖ + ‖u₂‖ + 1
  obtain ⟨t, ht, hyt⟩ := exists_forall_norm_sub_apply_lt_of_mem_adjoin hy ![v₁, v₂]
    (div_pos hε (by positivity : (0 : ℝ) < C))
  -- the difference of the two functionals at `y` is their difference at `y - t`
  have hsplit : ⟪u₁, y v₁⟫_ℂ - ⟪u₂, y v₂⟫_ℂ = ⟪u₁, y v₁ - t v₁⟫_ℂ - ⟪u₂, y v₂ - t v₂⟫_ℂ := by
    rw [inner_sub_right, inner_sub_right, h t ht]
    ring
  rw [zero_add, hsplit]
  calc ‖⟪u₁, y v₁ - t v₁⟫_ℂ - ⟪u₂, y v₂ - t v₂⟫_ℂ‖
      ≤ ‖u₁‖ * ‖y v₁ - t v₁‖ + ‖u₂‖ * ‖y v₂ - t v₂‖ :=
        (norm_sub_le _ _).trans (add_le_add (norm_inner_le_norm _ _) (norm_inner_le_norm _ _))
    _ ≤ ‖u₁‖ * (ε / C) + ‖u₂‖ * (ε / C) := by
        gcongr
        exacts [(hyt 0).le, (hyt 1).le]
    _ < ε := by
        rw [← add_mul, mul_div_assoc', div_lt_iff₀ (by positivity)]
        nlinarith

end VonNeumannAlgebra
