module

public import TauCeti.Analysis.InnerProductSpace.Modulus
public import TauCeti.Analysis.VonNeumannAlgebra.Adjoin

/-!
# Modulus of an operator in a von Neumann algebra

For any bounded operator `x : H →L[ℂ] H` on a complex Hilbert space `H`, its modulus
`x.modulus = √(x† x)` belongs to `VonNeumannAlgebra.adjoin {star x * x}`, hence to
`VonNeumannAlgebra.adjoin {x}`, and therefore to every von Neumann algebra `M` containing `x`.

## Main declarations

* `VonNeumannAlgebra.modulus_mem_adjoin_star_mul_self`: `x.modulus ∈ adjoin {star x * x}`.
* `VonNeumannAlgebra.modulus_mem_adjoin`: `x.modulus ∈ adjoin {x}`.
* `VonNeumannAlgebra.modulus_mem`: `x ∈ M → x.modulus ∈ M`.

## References

* R. V. Kadison, J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras I*,
  Theorem 6.1.2.
* M. Takesaki, *Theory of Operator Algebras I*, Theorem II.3.12.
-/

public section

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The modulus `x.modulus = √(x† x)` belongs to the von Neumann algebra generated by `star x * x`.
-/
theorem modulus_mem_adjoin_star_mul_self (x : H →L[ℂ] H) :
    x.modulus ∈ adjoin {star x * x} := by
  rw [ContinuousLinearMap.modulus_eq_sqrt, CFC.sqrt, ← ContinuousLinearMap.star_eq_adjoint,
    ← ContinuousLinearMap.mul_def]
  exact cfcₙ_nnreal_mem (𝕜 := ℂ) NNReal.sqrt (subset_adjoin _ (Set.mem_singleton _))

/-- The modulus `x.modulus` belongs to the von Neumann algebra generated by `x`. -/
theorem modulus_mem_adjoin (x : H →L[ℂ] H) : x.modulus ∈ adjoin {x} :=
  let hx : x ∈ adjoin {x} := subset_adjoin _ (Set.mem_singleton x)
  adjoin_singleton_le (mul_mem (star_mem hx) hx) (modulus_mem_adjoin_star_mul_self x)

/-- If `x` belongs to a von Neumann algebra `M`, then its modulus `x.modulus` belongs to `M`. -/
theorem modulus_mem {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} (hx : x ∈ M) :
    x.modulus ∈ M :=
  adjoin_singleton_le hx (modulus_mem_adjoin x)

end VonNeumannAlgebra
