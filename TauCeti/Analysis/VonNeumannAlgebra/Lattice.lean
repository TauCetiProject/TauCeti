module

public import TauCeti.Analysis.VonNeumannAlgebra.Adjoin

/-!
# The complete lattice of von Neumann algebras

The von Neumann algebras acting on a complex Hilbert space `H` form a complete lattice, obtained
from the Galois insertion of `VonNeumannAlgebra.adjoin` into sets of operators
(`VonNeumannAlgebra.gi`).

* The meet of a family is its intersection (`VonNeumannAlgebra.coe_iInf`): an intersection of
  sets equal to their double commutants is again equal to its double commutant.
* The join of a family is the von Neumann algebra generated by its union
  (`VonNeumannAlgebra.iSup_eq_adjoin`), the double commutant of the union
  (`VonNeumannAlgebra.coe_iSup`).
* The top element is all of `H →L[ℂ] H`, and the bottom element is the scalars `ℂ • 1`
  (`VonNeumannAlgebra.coe_bot`), because the center of `H →L[ℂ] H` consists of the scalars. In
  particular the von Neumann algebra generated by the empty set is `ℂ • 1`.

Taking commutants reverses inclusions and is involutive, so it is an order isomorphism onto the
order dual (`VonNeumannAlgebra.commutantOrderIso`). Hence the commutant of a join is the meet of
the commutants and the commutant of a meet is the join of the commutants
(`VonNeumannAlgebra.commutant_iSup`, `VonNeumannAlgebra.commutant_iInf`), and the commutants of
`⊤` and `⊥` are `⊥` and `⊤`.

The forgetful map to star subalgebras preserves meets, top and bottom, but not joins: a join is
generated by the union, and by `VonNeumannAlgebra.image_ofCLM_adjoin_eq_closure` the von Neumann
algebra generated by a set is the weak operator closure of the star algebra it generates.
-/

public section

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {ι : Sort*} {M N : VonNeumannAlgebra H} {x : H →L[ℂ] H}

/-! ### Copies and the Galois insertion -/

/-- Copy of a von Neumann algebra with a new carrier equal to the old one. Useful to fix
definitional equalities. -/
protected noncomputable def copy (M : VonNeumannAlgebra H) (s : Set (H →L[ℂ] H)) (hs : s = ↑M) :
    VonNeumannAlgebra H where
  toStarSubalgebra := M.toStarSubalgebra.copy s hs
  centralizer_centralizer' := by
    subst hs
    exact M.centralizer_centralizer

@[simp, norm_cast]
theorem coe_copy (M : VonNeumannAlgebra H) (s : Set (H →L[ℂ] H)) (hs : s = ↑M) :
    (M.copy s hs : Set (H →L[ℂ] H)) = s :=
  (rfl)

theorem copy_eq (M : VonNeumannAlgebra H) (s : Set (H →L[ℂ] H)) (hs : s = ↑M) :
    M.copy s hs = M :=
  SetLike.coe_injective hs

/-- Generating a von Neumann algebra is left adjoint to the coercion to sets of operators. -/
protected theorem gc :
    GaloisConnection (adjoin : Set (H →L[ℂ] H) → VonNeumannAlgebra H) (↑) :=
  fun _ _ => adjoin_le_iff

/-- The Galois insertion between generating a von Neumann algebra and the coercion to sets of
operators. -/
protected noncomputable def gi :
    GaloisInsertion (adjoin : Set (H →L[ℂ] H) → VonNeumannAlgebra H) (↑) where
  choice s hs := (adjoin s).copy s (le_antisymm (subset_adjoin s) hs)
  gc := VonNeumannAlgebra.gc
  le_l_u M := subset_adjoin (M : Set (H →L[ℂ] H))
  choice_eq _ _ := copy_eq _ _ _

/-- The von Neumann algebras on `H` form a complete lattice: meets are intersections and joins
are generated von Neumann algebras. -/
noncomputable instance instCompleteLattice : CompleteLattice (VonNeumannAlgebra H) :=
  VonNeumannAlgebra.gi.liftCompleteLattice

/-- A von Neumann algebra is the von Neumann algebra it generates. -/
@[simp]
theorem adjoin_eq (M : VonNeumannAlgebra H) : adjoin (M : Set (H →L[ℂ] H)) = M :=
  VonNeumannAlgebra.gi.l_u_eq M

/-! ### Meets -/

@[simp, norm_cast]
theorem coe_inf (M N : VonNeumannAlgebra H) :
    ((M ⊓ N : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) = (M : Set (H →L[ℂ] H)) ∩ N :=
  (rfl)

@[simp]
theorem mem_inf : x ∈ M ⊓ N ↔ x ∈ M ∧ x ∈ N :=
  Iff.rfl

@[simp, norm_cast]
theorem coe_sInf (S : Set (VonNeumannAlgebra H)) :
    ((sInf S : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) = ⋂ M ∈ S, (M : Set (H →L[ℂ] H)) :=
  VonNeumannAlgebra.gc.u_sInf

theorem mem_sInf {S : Set (VonNeumannAlgebra H)} : x ∈ sInf S ↔ ∀ M ∈ S, x ∈ M := by
  simp [← SetLike.mem_coe]

@[simp, norm_cast]
theorem coe_iInf (M : ι → VonNeumannAlgebra H) :
    ((⨅ i, M i : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) = ⋂ i, (M i : Set (H →L[ℂ] H)) :=
  VonNeumannAlgebra.gc.u_iInf

@[simp]
theorem mem_iInf {M : ι → VonNeumannAlgebra H} : x ∈ ⨅ i, M i ↔ ∀ i, x ∈ M i := by
  simp [← SetLike.mem_coe]

/-! ### Top and bottom -/

@[simp, norm_cast]
theorem coe_top : ((⊤ : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) = Set.univ :=
  (rfl)

@[simp]
theorem mem_top : x ∈ (⊤ : VonNeumannAlgebra H) :=
  Set.mem_univ x

/-- The von Neumann algebra generated by the empty set. -/
@[simp]
theorem adjoin_empty : adjoin (∅ : Set (H →L[ℂ] H)) = ⊥ :=
  VonNeumannAlgebra.gc.l_bot

@[simp]
theorem adjoin_univ : adjoin (Set.univ : Set (H →L[ℂ] H)) = ⊤ :=
  eq_top_iff.2 fun x _ => subset_adjoin _ (Set.mem_univ x)

/-- The bottom von Neumann algebra consists of the scalar multiples of the identity: it is the
double commutant of the empty set, that is, the center of `H →L[ℂ] H`. -/
theorem coe_bot :
    ((⊥ : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) = Set.range (algebraMap ℂ (H →L[ℂ] H)) := by
  rw [← adjoin_empty, coe_adjoin, Set.star_empty, Set.union_empty, Set.centralizer_empty,
    Set.top_eq_univ, Set.centralizer_univ]
  ext x
  -- `Set.center` is the carrier of `Subalgebra.center`, which is trivial for a central algebra.
  exact (Algebra.IsCentral.mem_center_iff (K := ℂ)).trans (by simp [eq_comm])

theorem mem_bot : x ∈ (⊥ : VonNeumannAlgebra H) ↔ x ∈ Set.range (algebraMap ℂ (H →L[ℂ] H)) := by
  rw [← SetLike.mem_coe, coe_bot]

/-! ### Joins -/

/-- The join of two von Neumann algebras is the von Neumann algebra generated by their union. -/
theorem sup_eq_adjoin (M N : VonNeumannAlgebra H) :
    M ⊔ N = adjoin ((M : Set (H →L[ℂ] H)) ∪ N) :=
  rfl

/-- The join of a set of von Neumann algebras is the von Neumann algebra generated by their
union. -/
theorem sSup_eq_adjoin (S : Set (VonNeumannAlgebra H)) :
    sSup S = adjoin (⋃ M ∈ S, (M : Set (H →L[ℂ] H))) := by
  rw [← VonNeumannAlgebra.gi.l_sSup_u_image S, sSup_image]
  rfl

/-- The join of a family of von Neumann algebras is the von Neumann algebra generated by their
union. -/
theorem iSup_eq_adjoin (M : ι → VonNeumannAlgebra H) :
    ⨆ i, M i = adjoin (⋃ i, (M i : Set (H →L[ℂ] H))) := by
  rw [iSup, sSup_eq_adjoin, Set.biUnion_range]

/-- The join of two von Neumann algebras is the double commutant of their union. -/
theorem coe_sup (M N : VonNeumannAlgebra H) :
    ((M ⊔ N : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) =
      ((M : Set (H →L[ℂ] H)) ∪ N).centralizer.centralizer := by
  rw [sup_eq_adjoin, coe_adjoin_of_star_subset]
  rw [Set.union_star]
  exact Set.union_subset_union (by simp) (by simp)

/-- The join of a family of von Neumann algebras is the double commutant of their union. -/
theorem coe_iSup (M : ι → VonNeumannAlgebra H) :
    ((⨆ i, M i : VonNeumannAlgebra H) : Set (H →L[ℂ] H)) =
      (⋃ i, (M i : Set (H →L[ℂ] H))).centralizer.centralizer := by
  rw [iSup_eq_adjoin, coe_adjoin_of_star_subset]
  rw [Set.iUnion_star]
  exact Set.iUnion_mono fun i => by simp

/-- Generating von Neumann algebras turns unions into joins. -/
theorem adjoin_union (s t : Set (H →L[ℂ] H)) : adjoin (s ∪ t) = adjoin s ⊔ adjoin t :=
  VonNeumannAlgebra.gc.l_sup

/-- Generating von Neumann algebras turns indexed unions into joins. -/
theorem adjoin_iUnion (s : ι → Set (H →L[ℂ] H)) : adjoin (⋃ i, s i) = ⨆ i, adjoin (s i) :=
  VonNeumannAlgebra.gc.l_iSup

/-! ### The forgetful map to star subalgebras -/

theorem toStarSubalgebra_injective :
    Function.Injective
      (toStarSubalgebra : VonNeumannAlgebra H → StarSubalgebra ℂ (H →L[ℂ] H)) :=
  fun _ _ h => ext fun x => SetLike.ext_iff.mp h x

@[simp]
theorem toStarSubalgebra_inf (M N : VonNeumannAlgebra H) :
    (M ⊓ N).toStarSubalgebra = M.toStarSubalgebra ⊓ N.toStarSubalgebra :=
  SetLike.coe_injective rfl

@[simp]
theorem toStarSubalgebra_iInf (M : ι → VonNeumannAlgebra H) :
    (⨅ i, M i).toStarSubalgebra = ⨅ i, (M i).toStarSubalgebra :=
  SetLike.coe_injective <| by simp

@[simp]
theorem toStarSubalgebra_top : (⊤ : VonNeumannAlgebra H).toStarSubalgebra = ⊤ :=
  SetLike.coe_injective rfl

@[simp]
theorem toStarSubalgebra_bot : (⊥ : VonNeumannAlgebra H).toStarSubalgebra = ⊥ :=
  SetLike.coe_injective <| by rw [coe_toStarSubalgebra, coe_bot, StarSubalgebra.coe_bot]

/-! ### Commutants reverse the order -/

/-- Taking commutants reverses inclusions. -/
theorem commutant_le_commutant (h : M ≤ N) : N.commutant ≤ M.commutant := by
  rw [← SetLike.coe_subset_coe, coe_commutant, coe_commutant]
  exact Set.centralizer_subset h

theorem commutant_anti : Antitone (commutant : VonNeumannAlgebra H → VonNeumannAlgebra H) :=
  fun _ _ => commutant_le_commutant

@[simp]
theorem commutant_le_commutant_iff : M.commutant ≤ N.commutant ↔ N ≤ M :=
  ⟨fun h => by simpa using commutant_le_commutant h, commutant_le_commutant⟩

/-- `M` commutes with `N` exactly when `N` commutes with `M`. -/
theorem le_commutant_comm : M ≤ N.commutant ↔ N ≤ M.commutant := by
  rw [← commutant_le_commutant_iff, commutant_commutant]

theorem commutant_involutive :
    Function.Involutive (commutant : VonNeumannAlgebra H → VonNeumannAlgebra H) :=
  commutant_commutant

/-- Taking commutants is an order-reversing involution of the lattice of von Neumann
algebras. -/
noncomputable def commutantOrderIso : VonNeumannAlgebra H ≃o (VonNeumannAlgebra H)ᵒᵈ where
  toFun M := OrderDual.toDual M.commutant
  invFun M := (OrderDual.ofDual M).commutant
  left_inv := commutant_commutant
  right_inv := commutant_commutant
  map_rel_iff' := commutant_le_commutant_iff

@[simp]
theorem commutantOrderIso_apply (M : VonNeumannAlgebra H) :
    commutantOrderIso M = OrderDual.toDual M.commutant :=
  (rfl)

@[simp]
theorem commutantOrderIso_symm_apply (M : (VonNeumannAlgebra H)ᵒᵈ) :
    commutantOrderIso.symm M = (OrderDual.ofDual M).commutant :=
  (rfl)

/-- The commutant of a join is the meet of the commutants. -/
@[simp]
theorem commutant_sup (M N : VonNeumannAlgebra H) :
    (M ⊔ N).commutant = M.commutant ⊓ N.commutant :=
  commutantOrderIso.map_sup M N

/-- The commutant of a meet is the join of the commutants. -/
@[simp]
theorem commutant_inf (M N : VonNeumannAlgebra H) :
    (M ⊓ N).commutant = M.commutant ⊔ N.commutant :=
  commutantOrderIso.map_inf M N

/-- The commutant of a join is the meet of the commutants. -/
@[simp]
theorem commutant_iSup (M : ι → VonNeumannAlgebra H) :
    (⨆ i, M i).commutant = ⨅ i, (M i).commutant :=
  commutantOrderIso.map_iSup M

/-- The commutant of a meet is the join of the commutants. -/
@[simp]
theorem commutant_iInf (M : ι → VonNeumannAlgebra H) :
    (⨅ i, M i).commutant = ⨆ i, (M i).commutant :=
  commutantOrderIso.map_iInf M

/-- The commutant of a join is the meet of the commutants. -/
@[simp]
theorem commutant_sSup (S : Set (VonNeumannAlgebra H)) :
    (sSup S).commutant = ⨅ M ∈ S, M.commutant :=
  commutantOrderIso.map_sSup S

/-- The commutant of a meet is the join of the commutants. -/
@[simp]
theorem commutant_sInf (S : Set (VonNeumannAlgebra H)) :
    (sInf S).commutant = ⨆ M ∈ S, M.commutant :=
  commutantOrderIso.map_sInf S

/-- The commutant of all bounded operators is the scalars. -/
@[simp]
theorem commutant_top : (⊤ : VonNeumannAlgebra H).commutant = ⊥ :=
  commutantOrderIso.map_top

/-- The commutant of the scalars is all bounded operators. -/
@[simp]
theorem commutant_bot : (⊥ : VonNeumannAlgebra H).commutant = ⊤ :=
  commutantOrderIso.map_bot

@[simp]
theorem commutant_eq_top_iff : M.commutant = ⊤ ↔ M = ⊥ :=
  ⟨fun h => by rw [← commutant_commutant M, h, commutant_top], fun h => h ▸ commutant_bot⟩

@[simp]
theorem commutant_eq_bot_iff : M.commutant = ⊥ ↔ M = ⊤ :=
  ⟨fun h => by rw [← commutant_commutant M, h, commutant_bot], fun h => h ▸ commutant_top⟩

end VonNeumannAlgebra
