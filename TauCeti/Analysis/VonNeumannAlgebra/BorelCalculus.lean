/-!
# The Borel functional calculus in von Neumann algebras

For a unital star representation `π : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)` on a complex Hilbert space `H`
with `K` compact Hausdorff, any bounded operator commuting with `π(C(K))` also commutes with its
Borel extension `π.representationBorelOperator` and its projection-valued measure
`ProjValMeasure.ofRepresentation π`. By the double-commutant definition of
`VonNeumannAlgebra.adjoin`, every Borel operator `π.representationBorelOperator f` and every
measurable-set projection `(ProjValMeasure.ofRepresentation π).proj B hB` therefore belongs to
`VonNeumannAlgebra.adjoin (Set.range π)`, and those projections generate the same von Neumann
algebra as `Set.range π`.

Specializing to the continuous functional calculus of a normal operator `a : H →L[ℂ] H` shows that
every value `a.borelCalculus f` of the Borel functional calculus — and in particular every spectral
projection `a.spectralPVM.proj B hB` — belongs to `VonNeumannAlgebra.adjoin {a}`, hence to every
von Neumann algebra `M` containing `a`. Since every normal element is a norm limit of linear
combinations of its spectral projections (`ContinuousLinearMap.mem_closure_span_spectralPVM_proj`),
splitting an arbitrary element of `M` into its real and imaginary parts shows that `M` is the
operator-norm closure of the complex linear span of its star projections
(`VonNeumannAlgebra.closure_span_isStarProjection`), and in particular is generated as a von
Neumann algebra by its star projections (`VonNeumannAlgebra.adjoin_isStarProjection`).

## Main declarations

* `VonNeumannAlgebra.representationBorelOperator_mem_adjoin`,
  `VonNeumannAlgebra.representationBorelOperator_mem`: Borel extensions of `C(K, ℂ)`-representations
  lie in the generated von Neumann algebra.
* `VonNeumannAlgebra.adjoin_range_representationBorelOperator`,
  `VonNeumannAlgebra.adjoin_ofRepresentation_proj`: the Borel extension and the projections of its
  projection-valued measure generate `adjoin (Set.range π)`.
* `VonNeumannAlgebra.borelCalculus_mem_adjoin`, `VonNeumannAlgebra.borelCalculus_mem`,
  `VonNeumannAlgebra.spectralPVM_proj_mem_adjoin`, `VonNeumannAlgebra.spectralPVM_proj_mem`: values
  of the Borel functional calculus and spectral projections of a normal operator lie in `adjoin {a}`
  and in any von Neumann algebra containing `a`.
* `VonNeumannAlgebra.adjoin_range_borelCalculus`, `VonNeumannAlgebra.adjoin_spectralPVM_proj`: the
  Borel calculus and spectral projections of `a` generate `adjoin {a}`.
* `VonNeumannAlgebra.closure_span_isStarProjection`: a von Neumann algebra is the operator-norm
  closure of the complex linear span of its star projections.
* `VonNeumannAlgebra.adjoin_isStarProjection`: a von Neumann algebra is generated by its star
  projections.
* `VonNeumannAlgebra.mem_commutant_iff_forall_isStarProjection`,
  `VonNeumannAlgebra.mem_iff_forall_commutant_isStarProjection`: membership in `M.commutant` and in
  `M` tested solely against star projections.

## References

* R. V. Kadison, J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras I*,
  Theorem 5.2.2 and Proposition 5.2.3.
* J. B. Conway, *A Course in Functional Analysis*, 2nd ed., Springer (1990), §IX.2.
-/

public section

open TauCeti
open scoped ComplexStarModule

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

private theorem span_subset {M : VonNeumannAlgebra H} {s : Set (H →L[ℂ] H)} (hs : s ⊆ M) :
    (Submodule.span ℂ s : Set (H →L[ℂ] H)) ⊆ M :=
  Set.Subset.trans (Submodule.span_mono hs) (Submodule.coe_span_eq_self M).subset

section Representation

variable {K : Type*} [TopologicalSpace K] [CompactSpace K] [T2Space K] [MeasurableSpace K]
  [BorelSpace K]

/-- For a unital star representation `π : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)`, every operator in its Borel
extension belongs to the von Neumann algebra generated by `Set.range π`. -/
theorem representationBorelOperator_mem_adjoin (π : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H))
    (f : BoundedBorelFunction K) :
    π.representationBorelOperator f ∈ adjoin (Set.range π) := by
  rw [← commutant_commutant (adjoin (Set.range π)), mem_commutant_iff]
  intro y hy
  have hcomm : ∀ g : C(K, ℂ), Commute y (π g) := fun g =>
    ((mem_commutant_iff.1 hy) (π g) (subset_adjoin _ ⟨g, rfl⟩)).symm
  exact (π.commute_representationBorelOperator hcomm f).eq

/-- If a von Neumann algebra `M` contains the range of a unital star representation `π` of
`C(K, ℂ)`, then it contains every value of the Borel extension of `π`. -/
theorem representationBorelOperator_mem {M : VonNeumannAlgebra H}
    {π : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)} (hπ : Set.range π ⊆ M) (f : BoundedBorelFunction K) :
    π.representationBorelOperator f ∈ M :=
  (adjoin_le_iff.2 hπ) (representationBorelOperator_mem_adjoin π f)

/-- Every measurable-set projection of `ProjValMeasure.ofRepresentation π` belongs to the von
Neumann algebra generated by `Set.range π`. -/
theorem ofRepresentation_proj_mem_adjoin (π : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H))
    {B : Set K} (hB : MeasurableSet B) :
    (ProjValMeasure.ofRepresentation π).proj B hB ∈ adjoin (Set.range π) := by
  rw [ProjValMeasure.ofRepresentation_proj]
  exact representationBorelOperator_mem_adjoin π _

/-- If a von Neumann algebra `M` contains the range of `π`, then it contains every measurable-set
projection of `ProjValMeasure.ofRepresentation π`. -/
theorem ofRepresentation_proj_mem {M : VonNeumannAlgebra H}
    {π : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)} (hπ : Set.range π ⊆ M)
    {B : Set K} (hB : MeasurableSet B) :
    (ProjValMeasure.ofRepresentation π).proj B hB ∈ M :=
  (adjoin_le_iff.2 hπ) (ofRepresentation_proj_mem_adjoin π hB)

/-- The Borel extension of `π` generates the same von Neumann algebra as `π` itself. -/
@[simp]
theorem adjoin_range_representationBorelOperator (π : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)) :
    adjoin (Set.range π.representationBorelOperator) = adjoin (Set.range π) := by
  refine le_antisymm
    (adjoin_le_iff.2 (Set.range_subset_iff.2 (representationBorelOperator_mem_adjoin π)))
    (adjoin_mono ?_)
  rintro _ ⟨g, rfl⟩
  exact ⟨BoundedBorelFunction.ofContinuousMap g,
    π.representationBorelOperator_ofContinuousMap g⟩

/-- The projections of `ProjValMeasure.ofRepresentation π` generate the same von Neumann algebra as
`Set.range π`. -/
theorem adjoin_ofRepresentation_proj (π : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)) :
    adjoin {p | ∃ B hB, (ProjValMeasure.ofRepresentation π).proj B hB = p} =
      adjoin (Set.range π) := by
  set S : Set (H →L[ℂ] H) :=
    {p | ∃ B hB, (ProjValMeasure.ofRepresentation π).proj B hB = p}
  refine le_antisymm ?_ (adjoin_le_iff.2 ?_)
  · refine adjoin_le_iff.2 ?_
    rintro _ ⟨B, hB, rfl⟩
    exact ofRepresentation_proj_mem_adjoin π hB
  · rintro _ ⟨g, rfl⟩
    have hmem := (ProjValMeasure.ofRepresentation π).integral_mem_closure_span_proj
      (BoundedBorelFunction.ofContinuousMap g)
    rw [ProjValMeasure.integral_ofRepresentation_ofContinuousMap] at hmem
    exact closure_minimal (span_subset (subset_adjoin S)) (adjoin S).isClosed hmem

end Representation

section Normal

variable (a : H →L[ℂ] H) [IsStarNormal a]

/-- Every value of the Borel functional calculus of a normal operator `a` lies in the von Neumann
algebra generated by `a`. -/
theorem borelCalculus_mem_adjoin (f : BoundedBorelFunction (spectrum ℂ a)) :
    a.borelCalculus f ∈ adjoin {a} := by
  rw [← commutant_commutant (adjoin {a}), mem_commutant_iff]
  intro y hy
  have hcomm : Commute y a :=
    ((mem_commutant_iff.1 hy) a (subset_adjoin _ (Set.mem_singleton a))).symm
  exact ((a.forall_commute_borelCalculus_iff y).2 hcomm f).eq

/-- Every spectral projection of a normal operator `a` lies in the von Neumann algebra generated by
`a`. -/
theorem spectralPVM_proj_mem_adjoin {B : Set (spectrum ℂ a)} (hB : MeasurableSet B) :
    a.spectralPVM.proj B hB ∈ adjoin {a} := by
  rw [← a.borelCalculus_indicator hB]
  exact borelCalculus_mem_adjoin a _

variable {a} in
/-- If a normal operator `a` belongs to a von Neumann algebra `M`, then every value of its Borel
functional calculus belongs to `M`. -/
theorem borelCalculus_mem {M : VonNeumannAlgebra H} (ha : a ∈ M)
    (f : BoundedBorelFunction (spectrum ℂ a)) :
    a.borelCalculus f ∈ M :=
  (adjoin_le_iff.2 (Set.singleton_subset_iff.2 ha)) (borelCalculus_mem_adjoin a f)

variable {a} in
/-- If a normal operator `a` belongs to a von Neumann algebra `M`, then every spectral projection of
`a` belongs to `M`. -/
theorem spectralPVM_proj_mem {M : VonNeumannAlgebra H} (ha : a ∈ M)
    {B : Set (spectrum ℂ a)} (hB : MeasurableSet B) :
    a.spectralPVM.proj B hB ∈ M :=
  (adjoin_le_iff.2 (Set.singleton_subset_iff.2 ha)) (spectralPVM_proj_mem_adjoin a hB)

/-- The range of the Borel functional calculus of `a` generates `adjoin {a}`. -/
@[simp]
theorem adjoin_range_borelCalculus :
    adjoin (Set.range a.borelCalculus) = adjoin {a} := by
  refine le_antisymm
    (adjoin_le_iff.2 (Set.range_subset_iff.2 (borelCalculus_mem_adjoin a)))
    (adjoin_mono ?_)
  rw [Set.singleton_subset_iff]
  exact ⟨_, a.borelCalculus_restrict_id⟩

/-- The spectral projections of a normal operator `a` generate `adjoin {a}`. -/
theorem adjoin_spectralPVM_proj :
    adjoin {p | ∃ B hB, a.spectralPVM.proj B hB = p} = adjoin {a} := by
  set S : Set (H →L[ℂ] H) := {p | ∃ B hB, a.spectralPVM.proj B hB = p}
  refine le_antisymm ?_ ?_
  · refine adjoin_le_iff.2 ?_
    rintro _ ⟨B, hB, rfl⟩
    exact spectralPVM_proj_mem_adjoin a hB
  · rw [adjoin_le_iff, Set.singleton_subset_iff]
    exact closure_minimal (span_subset (subset_adjoin S)) (adjoin S).isClosed
      a.mem_closure_span_spectralPVM_proj

end Normal

section Projections

/-- Every normal element of a von Neumann algebra `M` lies in the operator-norm closure of the
complex linear span of the star projections in `M`. -/
theorem mem_closure_span_isStarProjection_of_isStarNormal {M : VonNeumannAlgebra H}
    {a : H →L[ℂ] H} [IsStarNormal a] (ha : a ∈ M) :
    a ∈ closure
      (Submodule.span ℂ {p : H →L[ℂ] H | p ∈ M ∧ IsStarProjection p} : Set (H →L[ℂ] H)) := by
  refine closure_mono (Submodule.span_mono ?_) a.mem_closure_span_spectralPVM_proj
  rintro _ ⟨B, hB, rfl⟩
  exact ⟨spectralPVM_proj_mem ha hB, a.spectralPVM.isStarProjection_proj B hB⟩

/-- **Norm generation by projections.** Every concrete von Neumann algebra is the operator-norm
closure of the complex linear span of its star projections. -/
theorem closure_span_isStarProjection (M : VonNeumannAlgebra H) :
    closure (Submodule.span ℂ {p : H →L[ℂ] H | p ∈ M ∧ IsStarProjection p} : Set (H →L[ℂ] H)) =
      M := by
  set P : Submodule ℂ (H →L[ℂ] H) :=
    Submodule.span ℂ {p : H →L[ℂ] H | p ∈ M ∧ IsStarProjection p}
  refine Set.Subset.antisymm
    (closure_minimal (span_subset fun _ hp => hp.1) M.isClosed) fun x hx => ?_
  -- Decompose `x ∈ M` into its self-adjoint real and imaginary parts, each of which lies in the
  -- closed submodule `P.topologicalClosure`.
  have hre_mem : (ℜ x : H →L[ℂ] H) ∈ M := by
    rw [realPart_apply_coe, ← Complex.coe_smul]
    exact SMulMemClass.smul_mem _ (add_mem hx (star_mem hx))
  have him_mem : (ℑ x : H →L[ℂ] H) ∈ M := by
    rw [imaginaryPart_apply_coe, ← Complex.coe_smul, neg_smul]
    exact neg_mem (SMulMemClass.smul_mem _ (SMulMemClass.smul_mem _ (sub_mem hx (star_mem hx))))
  have : IsStarNormal (ℜ x : H →L[ℂ] H) := (ℜ x).property.isStarNormal
  have : IsStarNormal (ℑ x : H →L[ℂ] H) := (ℑ x).property.isStarNormal
  have hre : (ℜ x : H →L[ℂ] H) ∈ P.topologicalClosure :=
    mem_closure_span_isStarProjection_of_isStarNormal hre_mem
  have him : (ℑ x : H →L[ℂ] H) ∈ P.topologicalClosure :=
    mem_closure_span_isStarProjection_of_isStarNormal him_mem
  rw [← P.topologicalClosure_coe, SetLike.mem_coe, ← realPart_add_I_smul_imaginaryPart x]
  exact P.topologicalClosure.add_mem hre (P.topologicalClosure.smul_mem Complex.I him)

/-- Every concrete von Neumann algebra is generated by its star projections. -/
@[simp]
theorem adjoin_isStarProjection (M : VonNeumannAlgebra H) :
    adjoin {p : H →L[ℂ] H | p ∈ M ∧ IsStarProjection p} = M := by
  set S : Set (H →L[ℂ] H) := {p : H →L[ℂ] H | p ∈ M ∧ IsStarProjection p}
  refine le_antisymm (adjoin_le_iff.2 fun _ hp => hp.1) ?_
  intro x hx
  have hx' : x ∈ closure (Submodule.span ℂ S : Set (H →L[ℂ] H)) := by
    rwa [M.closure_span_isStarProjection]
  exact closure_minimal (span_subset (subset_adjoin S)) (adjoin S).isClosed hx'

/-- An operator lies in the commutant of `M` if and only if it commutes with every star projection
in `M`. -/
theorem mem_commutant_iff_forall_isStarProjection {M : VonNeumannAlgebra H} {y : H →L[ℂ] H} :
    y ∈ M.commutant ↔ ∀ p ∈ M, IsStarProjection p → Commute p y := by
  refine ⟨fun hy p hp _ => (mem_commutant_iff.1 hy) p hp, fun h => ?_⟩
  rw [← M.adjoin_isStarProjection, ← SetLike.mem_coe, coe_commutant_adjoin]
  rintro p (⟨hpM, hp⟩ | hp')
  · exact (h p hpM hp).eq
  · rw [Set.mem_star] at hp'
    have hp_eq : star p = p := by simpa [star_star] using hp'.2.isSelfAdjoint.star_eq.symm
    rw [hp_eq] at hp'
    exact (h p hp'.1 hp'.2).eq

/-- An operator belongs to a von Neumann algebra `M` if and only if it commutes with every star
projection in `M.commutant`. -/
theorem mem_iff_forall_commutant_isStarProjection {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} :
    x ∈ M ↔ ∀ p ∈ M.commutant, IsStarProjection p → Commute x p := by
  conv_lhs => rw [← M.commutant_commutant]
  rw [mem_commutant_iff_forall_isStarProjection]
  exact forall_congr' fun p => imp_congr_right fun _ => imp_congr_right fun _ => Commute.symm_iff

end Projections

end VonNeumannAlgebra
