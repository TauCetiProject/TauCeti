module

public import TauCeti.Analysis.SpecialFunctions.Complex.CircleAddChar
public import TauCeti.RingTheory.RootsOfUnity.PrimitiveRoots
public import TauCeti.FieldTheory.IsAlgClosed.Automorphism

/-!
# Automorphisms of complex roots of unity

For a positive level, every unit modulo the level is realized on the standard primitive root
by an automorphism of `ℂ`. Its restriction defines the intrinsic conjugation of the subfield
generated by the roots of unity. These supply the coefficient maps for modular function fields.
-/

public noncomputable section

/-- For every unit `d` modulo a positive `N`, some automorphism of `ℂ` sends `ζ_N` to `ζ_N^d`. -/
theorem Units.exists_ringEquiv_apply_stdAddChar_one {N : ℕ} [NeZero N] (d : (ZMod N)ˣ) :
    ∃ σ : ℂ ≃+* ℂ, σ (ZMod.stdAddChar (1 : ZMod N)) = ZMod.stdAddChar (d : ZMod N) := by
  let A := algebraicClosure ℚ ℂ
  let ζ : A := ⟨ZMod.stdAddChar (1 : ZMod N), mem_algebraicClosure_iff.mpr
    (((ZMod.isPrimitiveRoot_stdAddChar_one N).isIntegral (NeZero.pos N)).tower_top
      (A := ℚ)).isAlgebraic⟩
  have hζ : IsPrimitiveRoot ζ N :=
    (ZMod.isPrimitiveRoot_stdAddChar_one N).of_map_of_injective
      (f := algebraMap A ℂ) (algebraMap A ℂ).injective
  obtain ⟨τ, hτ⟩ := hζ.exists_algEquiv_apply_eq_pow_of_coprime
    (K := ℚ) (ZMod.val_coe_unit_coprime d).symm
    (Polynomial.cyclotomic.irreducible_rat (NeZero.pos N))
  obtain ⟨σ, hσ⟩ := τ.exists_algEquiv_apply_algebraMap (Ω := ℂ)
  refine ⟨σ.toRingEquiv, ?_⟩
  have h := hσ ζ
  rw [hτ, map_pow] at h
  simpa only [AlgEquiv.coe_toRingEquiv, ζ, IntermediateField.algebraMap_apply,
    Subtype.coe_mk, ← AddChar.map_nsmul_eq_pow,
    nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val] using h

/-- The intrinsic conjugate of a cyclotomic constant under `ζ_N ↦ ζ_N^d`, as a ring homomorphism
of the subfield generated by the `N`th roots of unity. Its value is independent of the extension
to `ℂ`, as recorded by `Units.coe_cyclotomicConjugate`. -/
def Units.cyclotomicConjugate {N : ℕ} [NeZero N] (d : (ZMod N)ˣ) :
    Subfield.closure {z : ℂ | z ^ N = 1} →+* Subfield.closure {z : ℂ | z ^ N = 1} :=
  ((Classical.choose d.exists_ringEquiv_apply_stdAddChar_one).toRingHom.comp
      (Subfield.closure {z : ℂ | z ^ N = 1}).subtype).codRestrict _ fun c ↦ by
    rw [RingHom.comp_apply, Subfield.subtype_apply, ← Subfield.mem_comap]
    apply RingHom.field_closure_preimage_le _ {z : ℂ | z ^ N = 1}
    apply Subfield.closure_mono (fun z hz ↦ ?_) c.property
    rw [Set.mem_ofPred_eq] at hz
    rw [Set.mem_preimage, Set.mem_ofPred_eq, ← map_pow, hz, map_one]

/-- The intrinsic cyclotomic conjugate agrees with every complex coefficient map having the
prescribed value at the standard primitive root. -/
theorem Units.coe_cyclotomicConjugate {N : ℕ} [NeZero N] (d : (ZMod N)ˣ)
    {σ : ℂ →+* ℂ}
    (hσ : σ (ZMod.stdAddChar (1 : ZMod N)) = ZMod.stdAddChar (d : ZMod N))
    (c : Subfield.closure {z : ℂ | z ^ N = 1}) : (d.cyclotomicConjugate c : ℂ) = σ c := by
  rw [Units.cyclotomicConjugate, RingHom.codRestrict_apply, RingHom.comp_apply,
    Subfield.subtype_apply]
  apply RingHom.eqOn_field_closure (s := {z : ℂ | z ^ N = 1}) _ c.property
  intro z hz
  obtain ⟨i, -, rfl⟩ := (ZMod.isPrimitiveRoot_stdAddChar_one N).eq_pow_of_pow_eq_one hz
  rw [map_pow, map_pow, hσ, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
    Classical.choose_spec d.exists_ringEquiv_apply_stdAddChar_one]

/-- Only `d = 1` fixes every cyclotomic constant, since `ζ_N ↦ ζ_N^d` fixes `ζ_N` only for
`d = 1`. -/
theorem Units.eq_one_of_forall_cyclotomicConjugate_apply_eq {N : ℕ} [NeZero N]
    {d : (ZMod N)ˣ} (h : ∀ c, d.cyclotomicConjugate c = c) : d = 1 := by
  obtain ⟨σ, hσ⟩ := d.exists_ringEquiv_apply_stdAddChar_one
  have hζ : ZMod.stdAddChar (1 : ZMod N) ∈ Subfield.closure {z : ℂ | z ^ N = 1} :=
    Subfield.subset_closure (ZMod.isPrimitiveRoot_stdAddChar_one N).pow_eq_one
  have h' := congrArg Subtype.val (h ⟨_, hζ⟩)
  rw [d.coe_cyclotomicConjugate (σ := (σ : ℂ →+* ℂ)) hσ, RingEquiv.coe_toRingHom, hσ] at h'
  exact Units.val_eq_one.mp (ZMod.injective_stdAddChar h')
