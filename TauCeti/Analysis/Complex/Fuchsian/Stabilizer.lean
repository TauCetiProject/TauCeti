module

public import TauCeti.Analysis.Complex.Fuchsian.ProperAction
public import TauCeti.Analysis.Complex.UpperHalfPlane.Stabilizer
public import TauCeti.Topology.Algebra.ConstMulAction

/-!
# Point stabilizers in Fuchsian groups

Every point stabilizer in a discrete subgroup of `PSL(2, ℝ)` is finite by proper
discontinuity of the action on the upper half-plane, and is cyclic through its faithful
derivative character. A generator has the order of the stabilizer, its derivative at the fixed
point has the same order, and when the stabilizer is nontrivial every `SL(2, ℝ)` representative of
the generator is elliptic.

## Main results

* `Subgroup.exists_generator_stabilizer_of_discrete`: every point stabilizer in a discrete
  subgroup of `PSL(2, ℝ)` is finite cyclic, generated by an element whose order equals the order
  of the stabilizer and of its derivative, and whose representatives are elliptic when the
  stabilizer is nontrivial.

## References

* [S. Katok, *Fuchsian Groups*, Chapter 2][katok1992]
-/

public section

open scoped MatrixGroups

noncomputable section

namespace Subgroup

open MulAction UpperHalfPlane Matrix.ProjectiveSpecialLinearGroup Matrix.SpecialLinearGroup

/-- Every point stabilizer in a discrete subgroup of `PSL(2, ℝ)` is finite cyclic. It has a
generator `g` whose order is the order of the stabilizer and of the derivative of `g` at the fixed
point, and if `g ≠ 1` then every `SL(2, ℝ)` representative of `g` is elliptic. -/
theorem exists_generator_stabilizer_of_discrete (G : Subgroup PSL(2, ℝ)) [DiscreteTopology G]
    (τ : ℍ) :
    Finite (stabilizer G τ) ∧ ∃ g : stabilizer G τ, (∀ x, x ∈ zpowers g) ∧
      orderOf g = Nat.card (stabilizer G τ) ∧
      orderOf (derivative (g.1.1 : PSL(2, ℝ)) τ) = orderOf g ∧
      ∀ a : SL(2, ℝ), (a : PSL(2, ℝ)) = g.1.1 → g ≠ 1 → (mapGL ℝ a).IsElliptic := by
  obtain ⟨g, hg⟩ := (isCyclic_stabilizer G τ).exists_generator
  refine ⟨inferInstance, g, hg, orderOf_eq_card_of_forall_mem_zpowers hg,
    stabilizerDerivative_apply G τ g ▸ orderOf_stabilizerDerivative G τ g, fun a ha hne ↦ ?_⟩
  apply isElliptic_of_exists_smul_eq_self
  · rw [← Matrix.GeneralLinearGroup.val_det_apply, det_mapGL]
    exact zero_lt_one
  · intro hcenter
    apply hne
    apply Subtype.ext
    apply Subtype.ext
    rw [← ha, OneMemClass.coe_one, OneMemClass.coe_one, QuotientGroup.eq_one_iff]
    exact (toGL_mem_center_iff a).mp hcenter
  · refine ⟨τ, ?_⟩
    have hfix : (a : PSL(2, ℝ)) • τ = τ := by
      rw [ha]
      simpa only [Subgroup.smul_def] using (MulAction.mem_stabilizer_iff.mp g.property)
    have hfix' : a • τ = τ := by simpa only [pslMk_smul] using hfix
    simpa only [MulAction.compHom_smul_def] using hfix'

end Subgroup
