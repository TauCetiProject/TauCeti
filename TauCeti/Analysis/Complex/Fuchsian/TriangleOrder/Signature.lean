module

public import TauCeti.Analysis.Complex.Fuchsian.Cusp.VertexCycle
public import TauCeti.Analysis.Complex.Fuchsian.Elliptic.Polygon
public import TauCeti.Analysis.Complex.Fuchsian.TriangleOrder.Polygon
public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.DoubleTriangle

/-!
# Elliptic points and cusps of a group tiled by a doubled triangle

Let `P` be a convex hyperbolic triangle whose angles at the ends of side `0` are acute, and let
`Γ ≤ PSL(2, ℝ)` contain the side-pairing maps of its double
`ConvexPolygon.doubleTriangleSidePairing`, with locally finite translates of the double whose
interiors are pairwise disjoint: the double is a locally finite fundamental polygon for `Γ`. This
is how a hyperbolic triangle group, generated by the side-pairing maps, acts on its tessellation
by triangles and their mirror images.

The vertex cycles of the double are `{P 0}`, `{P 1}` and `{P 2, P 2'}`, so they correspond to
the vertices of `P`, and no side of the double is paired with itself. Hence the elliptic orbits
of `Γ` are exactly the orbits of the finite vertices of `P`, and the cusp orbits of `Γ` are
exactly the orbits of its ideal vertices, distinct vertices giving distinct orbits. At a vertex
with angle `π / m`, the stabilizer has order `m`. In terms of a typed triple `p, q, r` of
`TriangleOrder` parameters realised as the angles of `P`, the group has one elliptic orbit for
each elliptic entry, of the stated order, and one cusp for each cusp entry. These are the
elliptic orders and the cusp count in the orbifold signature of a triangle group.

## Main declarations

* `ConvexPolygon.doubleTriangleEllipticOrbitEquiv`: the finite vertices of `P` are in bijection
  with the elliptic orbits of `Γ`, each vertex going to its orbit.
* `ConvexPolygon.doubleTriangleCuspOrbitEquiv`: the ideal vertices of `P` are in bijection with
  the cusp orbits of `Γ`, each vertex going to its orbit.
* `ConvexPolygon.natCard_stabilizer_of_doubleTriangle`: at a vertex of `P` with angle `π / m`,
  the stabilizer in `Γ` has order `m`.
* `ConvexPolygon.natCard_ellipticOrbits_of_doubleTriangle` and
  `ConvexPolygon.natCard_cuspOrbit_of_doubleTriangle`: the numbers of elliptic orbits and of
  cusps are the numbers of elliptic and of cusp entries of the typed triple.
* `ConvexPolygon.natCard_stabilizer_of_doubleTriangle_of_eq_elliptic`: at a vertex whose entry is
  elliptic of order `m`, the stabilizer has order `m`.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, Graduate Texts in Mathematics 91, Springer,
  1983, §10.6 (triangle groups and their fundamental polygons).
* Svetlana Katok, *Fuchsian Groups*, Chicago Lectures in Mathematics, University of Chicago
  Press, 1992, §4.3 (the signature of a Fuchsian group).
-/

public section

noncomputable section

open MulAction UpperHalfPlane
open scoped MatrixGroups Pointwise Real

namespace TauCeti.UpperHalfPlane.ConvexPolygon

variable {P : ConvexPolygon 3} {h₀ : P.interiorAngle 0 < π / 2}
  {h₁ : P.interiorAngle 1 < π / 2} {Γ : Subgroup PSL(2, ℝ)}

/-- The vertex of the double sitting at a vertex of `P`: `P 0`, `P 1` and `P 2` are the vertices
`0`, `2` and `3` of the double. -/
private theorem doubleTriangle_vertex_comp (i : Fin 3) :
    (P.doubleTriangle h₀ h₁).vertex ((![0, 2, 3] : Fin 3 → Fin 4) i) = P.vertex i := by
  fin_cases i <;> simp

/-- Going from a vertex of `P` to the vertex of the double sitting there and back is the
identity. -/
private theorem doubleTriangle_index_comp (i : Fin 3) :
    (![0, 2, 1, 2] : Fin 4 → Fin 3) ((![0, 2, 3] : Fin 3 → Fin 4) i) = i := by
  fin_cases i <;> rfl

/-- A same-cycle quotient of vertices of the double, restricted by a predicate that only depends
on the vertex of `P` they come from, is that set of vertices of `P`. -/
private def doubleTriangleCycleEquiv {p : Fin 4 → Prop} {s : Fin 3 → Prop}
    (hps : ∀ j, p j ↔ s ((![0, 2, 1, 2] : Fin 4 → Fin 3) j)) :
    Quotient (Setoid.comap Subtype.val
        (Equiv.Perm.SameCycle.setoid (P.doubleTriangleSidePairing h₀ h₁).next) :
      Setoid {j : Fin 4 // p j}) ≃ {i : Fin 3 // s i} :=
  (Quotient.congrRight fun j k ↦ by
      rw [Setoid.ker_def, Subtype.ext_iff]
      exact doubleTriangleSidePairing_sameCycle_iff).trans
    (Setoid.quotientKerEquivOfSurjective
      (fun j ↦ ⟨(![0, 2, 1, 2] : Fin 4 → Fin 3) j, (hps j).1 j.2⟩) fun i ↦
        ⟨⟨(![0, 2, 3] : Fin 3 → Fin 4) i,
            (hps _).2 (by rw [doubleTriangle_index_comp]; exact i.2)⟩,
          Subtype.ext (doubleTriangle_index_comp i)⟩)

private theorem doubleTriangleCycleEquiv_symm_apply {p : Fin 4 → Prop} {s : Fin 3 → Prop}
    (hps : ∀ j, p j ↔ s ((![0, 2, 1, 2] : Fin 4 → Fin 3) j)) (i : {i : Fin 3 // s i}) :
    (doubleTriangleCycleEquiv (h₀ := h₀) (h₁ := h₁) hps).symm i =
      Quotient.mk'' ⟨(![0, 2, 3] : Fin 3 → Fin 4) i,
        (hps _).2 (by rw [doubleTriangle_index_comp]; exact i.2)⟩ := by
  rw [Equiv.symm_apply_eq]
  exact Subtype.ext (doubleTriangle_index_comp i).symm

/-- A vertex of the double is finite with nonidentity cycle transformation exactly when it comes
from a finite vertex of `P`. -/
private theorem isLeft_and_cycleMap_ne_one_iff (j : Fin 4) :
    ((P.doubleTriangle h₀ h₁).vertex j).isLeft ∧
        (P.doubleTriangleSidePairing h₀ h₁).cycleMap j ≠ 1 ↔
      (P.vertex ((![0, 2, 1, 2] : Fin 4 → Fin 3) j)).isLeft := by
  rw [← isLeft_doubleTriangle_vertex (h₀ := h₀) (h₁ := h₁)]
  exact ⟨And.left, fun hj ↦ ⟨hj, doubleTriangleSidePairing_cycleMap_ne_one hj⟩⟩

/-! ### Elliptic points -/

/-- **The elliptic orbits of a group tiled by a doubled triangle.** Let `Γ` contain the
side-pairing maps of the double of `P`, with translates of the double covering `ℍ` and having
pairwise disjoint interiors. Sending a finite vertex of `P` to its orbit identifies the finite
vertices of `P` with the elliptic orbits of `Γ`. -/
def doubleTriangleEllipticOrbitEquiv
    (hmap : ∀ i, (P.doubleTriangleSidePairing h₀ h₁).map i ∈ Γ)
    (hcover : ⋃ γ : Γ, (γ : PSL(2, ℝ)) • (P.doubleTriangle h₀ h₁).carrier = Set.univ)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier)) :
    {i : Fin 3 // (P.vertex i).isLeft} ≃ Γ.ellipticOrbits :=
  (doubleTriangleCycleEquiv isLeft_and_cycleMap_ne_one_iff).symm.trans <|
    (Equiv.sumEmpty _ _).symm.trans <|
      (P.doubleTriangleSidePairing h₀ h₁).ellipticOrbitEquiv hmap hcover hdisj

/-- The elliptic-orbit bijection sends a finite vertex of `P` to its orbit. -/
@[simp]
theorem coe_doubleTriangleEllipticOrbitEquiv_apply
    (hmap : ∀ i, (P.doubleTriangleSidePairing h₀ h₁).map i ∈ Γ)
    (hcover : ⋃ γ : Γ, (γ : PSL(2, ℝ)) • (P.doubleTriangle h₀ h₁).carrier = Set.univ)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier))
    (i : {i : Fin 3 // (P.vertex i).isLeft}) :
    (doubleTriangleEllipticOrbitEquiv hmap hcover hdisj i : orbitRel.Quotient Γ ℍ) =
      Quotient.mk'' ((P.vertex i).getLeft i.2) := by
  rw [doubleTriangleEllipticOrbitEquiv, Equiv.trans_apply, doubleTriangleCycleEquiv_symm_apply,
    Equiv.trans_apply, Equiv.sumEmpty_symm_apply,
    SidePairing.ellipticOrbitEquiv_apply_inl_mk]
  congr 1
  simp only [doubleTriangle_vertex_comp]

/-- **The elliptic orders of a group tiled by a doubled triangle.** At a finite vertex of `P` with
angle `π / m`, the stabilizer in `Γ` has order `m`. -/
theorem natCard_stabilizer_of_doubleTriangle
    (hmap : ∀ i, (P.doubleTriangleSidePairing h₀ h₁).map i ∈ Γ)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier))
    {i : Fin 3} {z : ℍ} (hz : P.vertex i = .inl z) {m : ℕ} (hm : m ≠ 0)
    (hP : P.interiorAngle i = π / m) :
    Nat.card (stabilizer Γ z) = m := by
  rw [(P.doubleTriangleSidePairing h₀ h₁).natCard_stabilizer_eq_orderOf_cycleMap
    ((doubleTriangle_vertex_comp i).trans hz) hmap hdisj]
  fin_cases i
  · exact orderOf_doubleTriangleSidePairing_cycleMap_zero hm hP
  · exact orderOf_doubleTriangleSidePairing_cycleMap_two hm hP
  · exact orderOf_doubleTriangleSidePairing_cycleMap_three hm hP

/-! ### Cusps -/

/-- **The cusps of a group tiled by a doubled triangle.** Let `Γ` contain the side-pairing maps of
the double of `P`, with locally finite translates of the double having pairwise disjoint
interiors. Sending an ideal vertex of `P` to its orbit identifies the ideal vertices of `P` with
the cusp orbits of `Γ`. -/
def doubleTriangleCuspOrbitEquiv
    (hmap : ∀ i, (P.doubleTriangleSidePairing h₀ h₁).map i ∈ Γ)
    (hlf : LocallyFinite fun γ : Γ ↦
      (γ : PSL(2, ℝ)) • (P.doubleTriangle h₀ h₁).carrier)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier)) :
    {i : Fin 3 // (P.vertex i).isRight} ≃ Γ.CuspOrbit :=
  (doubleTriangleCycleEquiv fun j ↦ by
      rw [isRight_doubleTriangle_vertex (h₀ := h₀) (h₁ := h₁)]).symm.trans <|
    (P.doubleTriangleSidePairing h₀ h₁).idealVertexCycleEquiv hmap hlf hdisj

/-- The cusp bijection sends an ideal vertex of `P` to its orbit. -/
@[simp]
theorem coe_doubleTriangleCuspOrbitEquiv_apply
    (hmap : ∀ i, (P.doubleTriangleSidePairing h₀ h₁).map i ∈ Γ)
    (hlf : LocallyFinite fun γ : Γ ↦
      (γ : PSL(2, ℝ)) • (P.doubleTriangle h₀ h₁).carrier)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier))
    (i : {i : Fin 3 // (P.vertex i).isRight}) :
    (doubleTriangleCuspOrbitEquiv hmap hlf hdisj i : Γ.BoundaryOrbit) =
      Quotient.mk'' ((P.vertex i).getRight i.2) := by
  rw [doubleTriangleCuspOrbitEquiv, Equiv.trans_apply, doubleTriangleCycleEquiv_symm_apply,
    SidePairing.coe_idealVertexCycleEquiv_mk]
  congr 1
  simp only [doubleTriangle_vertex_comp]

/-! ### Typed triangle parameters -/

variable {p q r : TriangleOrder}

/-- **The number of elliptic orbits of a triangle group.** If `P` has angles given by the typed
triple `p`, `q`, `r`, a group tiled by the double of `P` has one elliptic orbit for each elliptic
entry of the triple. -/
theorem natCard_ellipticOrbits_of_doubleTriangle (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle)
    (hmap : ∀ i, (P.doubleTriangleSidePairing h₀ h₁).map i ∈ Γ)
    (hcover : ⋃ γ : Γ, (γ : PSL(2, ℝ)) • (P.doubleTriangle h₀ h₁).carrier = Set.univ)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier)) :
    Nat.card Γ.ellipticOrbits = (Finset.univ.filter fun i ↦ ![p, q, r] i ≠ .cusp).card := by
  rw [← Nat.card_congr (doubleTriangleEllipticOrbitEquiv hmap hcover hdisj),
    Nat.card_eq_fintype_card, Fintype.card_subtype]
  congr 1
  ext i
  rw [Finset.mem_filter, Finset.mem_filter, ne_eq, ← isRight_vertex_iff_eq_cusp hp hq hr,
    Sum.not_isRight]

/-- **The number of cusps of a triangle group.** If `P` has angles given by the typed triple `p`,
`q`, `r`, a group tiled by the double of `P` has one cusp orbit for each cusp entry of the
triple. -/
theorem natCard_cuspOrbit_of_doubleTriangle (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle)
    (hmap : ∀ i, (P.doubleTriangleSidePairing h₀ h₁).map i ∈ Γ)
    (hlf : LocallyFinite fun γ : Γ ↦
      (γ : PSL(2, ℝ)) • (P.doubleTriangle h₀ h₁).carrier)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier)) :
    Nat.card Γ.CuspOrbit = (Finset.univ.filter fun i ↦ ![p, q, r] i = .cusp).card := by
  rw [← Nat.card_congr (doubleTriangleCuspOrbitEquiv hmap hlf hdisj), Nat.card_eq_fintype_card,
    Fintype.card_subtype]
  congr 1
  ext i
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, isRight_vertex_iff_eq_cusp hp hq hr]

/-- **The elliptic orders of a triangle group.** If `P` has angles given by the typed triple `p`,
`q`, `r`, then at a vertex of `P` whose entry is elliptic of order `m`, the stabilizer in a group
tiled by the double of `P` has order `m`. -/
theorem natCard_stabilizer_of_doubleTriangle_of_eq_elliptic (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle)
    (hmap : ∀ i, (P.doubleTriangleSidePairing h₀ h₁).map i ∈ Γ)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier))
    {i : Fin 3} {z : ℍ} (hz : P.vertex i = .inl z) {m : ℕ} {hm : 2 ≤ m}
    (hi : ![p, q, r] i = .elliptic m hm) :
    Nat.card (stabilizer Γ z) = m := by
  refine natCard_stabilizer_of_doubleTriangle hmap hdisj hz (by omega) ?_
  rw [← TriangleOrder.angle_elliptic m hm, ← hi]
  fin_cases i <;> simp [hp, hq, hr]

end TauCeti.UpperHalfPlane.ConvexPolygon
