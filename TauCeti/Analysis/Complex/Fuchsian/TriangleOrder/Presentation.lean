module

public import TauCeti.Analysis.Complex.Fuchsian.TriangleOrder.Basic
public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.DoubleTriangle
public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.Presentation
public import TauCeti.GroupTheory.TriangleGroup.Basic
import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.Convex.IdealVertex.Reflection

/-!
# The triangle presentation of a doubled hyperbolic triangle

The side-and-cycle relator quotient of a doubled triangle is the oriented triangle group.
The equivalence eliminates the inverse side generators and identifies the three vertex-cycle
relations with the three triangle-group power relations. Typed cusp parameters contribute no
power relation. The inverse sends the triangle generators `x`, `y`, `z` to
`(of 0)⁻¹`, `(of 2)⁻¹`, `of 0 * of 2`, respectively, in the relator quotient.

The side chosen for doubling must have acute endpoint angles, as required by
`ConvexPolygon.doubleTriangle`. This is a presentation calculation, not an assertion of
no-overlap or discreteness of the group generated by the reflections.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, §10.6.

The construction uses `ConvexPolygon.doubleTriangleSidePairing` and
`TauCeti.TriangleGroup.lift`.
-/

public section

noncomputable section

open UpperHalfPlane Matrix.ProjectiveSpecialLinearGroup
open scoped MatrixGroups Real

namespace TauCeti.UpperHalfPlane.ConvexPolygon

variable (P : ConvexPolygon 3) (h₀ : P.interiorAngle 0 < Real.pi / 2)
  (h₁ : P.interiorAngle 1 < Real.pi / 2)

private theorem double_cycle_order {j : Fin 4} {i : Fin 3} (t : TriangleOrder)
    (hfinite : ∀ m : ℕ, m ≠ 0 → P.interiorAngle i = Real.pi / m →
      orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap j) = m)
    (hc : (P.doubleTriangleSidePairing h₀ h₁).cycleMap j =
      geodesicReflectionComp (P.sideGeodesic (i - 1)) (P.sideGeodesic i))
    (ha : P.interiorAngle i = t.angle) :
    orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap j) = t.exponent := by
  cases t with
  | elliptic m hm =>
    rw [TriangleOrder.exponent_elliptic]
    exact hfinite m (by omega) (ha.trans (TriangleOrder.angle_elliptic m hm))
  | cusp =>
    obtain ⟨ξ, hξ⟩ := Sum.isRight_iff.mp ((P.interiorAngle_eq_zero_iff i).mp
      (ha.trans TriangleOrder.angle_cusp))
    have hpar := P.isParabolic_geodesicReflectionComp_sideGeodesic hξ
    rw [hc, TriangleOrder.exponent_cusp]
    exact orderOf_eq_zero_iff'.mpr fun n hn ↦ (hpar.pow hn.ne').ne_one

variable {P h₀ h₁} {p q r : TriangleOrder}

/-- The four cycle transformations of a typed doubled triangle have the prescribed orders.
Here order zero means infinite order, and occurs exactly at cusp vertices. -/
theorem orderOf_doubleTriangleSidePairing_cycleMap
    (hp : P.interiorAngle 0 = p.angle) (hq : P.interiorAngle 1 = q.angle)
    (hr : P.interiorAngle 2 = r.angle) :
    (fun j ↦ orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap j)) =
      ![p.exponent, r.exponent, q.exponent, r.exponent] := by
  have hprev : (0 : Fin 3) - 1 = 2 := rfl
  have h0 := double_cycle_order P h₀ h₁ p (j := 0) (i := 0)
    (fun _ hm ha ↦ orderOf_doubleTriangleSidePairing_cycleMap_zero hm ha)
    (by simp [hprev]) hp
  have h2 := double_cycle_order P h₀ h₁ q (j := 2) (i := 1)
    (fun _ hm ha ↦ orderOf_doubleTriangleSidePairing_cycleMap_two hm ha) (by simp) hq
  have h3 := double_cycle_order P h₀ h₁ r (j := 3) (i := 2)
    (fun _ hm ha ↦ orderOf_doubleTriangleSidePairing_cycleMap_three hm ha) (by simp) hr
  have h1 : orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap 1) = r.exponent := by
    rw [← h3]
    apply SidePairing.orderOf_cycleMap_eq_of_mem_cycle
    apply (SidePairing.mem_cycle_iff _ _ _).mpr
    exact ⟨1, by norm_num [SidePairing.next_apply, Fin.rev]⟩
  funext j
  fin_cases j <;> assumption

private theorem double_relatorQuotient_of_three :
    (PresentedGroup.of 3 : (P.doubleTriangleSidePairing h₀ h₁).RelatorQuotient) =
      (PresentedGroup.of 0)⁻¹ := by
  simpa [Fin.rev] using (P.doubleTriangleSidePairing h₀ h₁).relatorQuotient_of_pair 0

private theorem double_relatorQuotient_of_one :
    (PresentedGroup.of 1 : (P.doubleTriangleSidePairing h₀ h₁).RelatorQuotient) =
      (PresentedGroup.of 2)⁻¹ := by
  simpa [Fin.rev] using (P.doubleTriangleSidePairing h₀ h₁).relatorQuotient_of_pair 2

private theorem double_cycle_power {j : Fin 4} {i : Fin 3} (t : TriangleOrder)
    (hv : (P.doubleTriangle h₀ h₁).vertex j = P.vertex i)
    (ha : P.interiorAngle i = t.angle)
    (ho : orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap j) = t.exponent) :
    (PresentedGroup.mk (P.doubleTriangleSidePairing h₀ h₁).relators
      ((P.doubleTriangleSidePairing h₀ h₁).cycleWord j)) ^ t.exponent = 1 := by
  cases t with
  | cusp => simp
  | elliptic m hm =>
    rw [← ho]
    rcases hi : P.vertex i with z | ξ
    · exact SidePairing.relatorQuotient_cycleWord_pow _ (hv.trans hi)
    · have hzero := P.interiorAngle_eq_zero_of_vertex_eq_inr hi
      have hpos := (TriangleOrder.elliptic m hm).angle_pos_iff.mpr (by simp)
      linarith

variable (hp : P.interiorAngle 0 = p.angle) (hq : P.interiorAngle 1 = q.angle)
  (hr : P.interiorAngle 2 = r.angle)

/-- Interpret the triangle generators as words in the doubled polygon's sides. -/
private def triangleToDouble : TriangleGroup p.exponent q.exponent r.exponent →*
    (P.doubleTriangleSidePairing h₀ h₁).RelatorQuotient := by
  have ho := congrFun
    (orderOf_doubleTriangleSidePairing_cycleMap (h₀ := h₀) (h₁ := h₁) hp hq hr)
  have hpow0 := double_cycle_power p (j := 0) (i := 0) (by simp) hp (ho 0)
  have hpow2 := double_cycle_power q (j := 2) (i := 1) (by simp) hq (ho 2)
  have hpow3 := double_cycle_power r (j := 3) (i := 2) (by simp) hr (ho 3)
  rw [doubleTriangleSidePairing_cycleWord] at hpow0 hpow2 hpow3
  simp only [Matrix.cons_val_zero, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons, map_mul] at hpow0 hpow2 hpow3
  refine TriangleGroup.lift (PresentedGroup.of 0)⁻¹ (PresentedGroup.of 2)⁻¹
    (PresentedGroup.of 0 * PresentedGroup.of 2)
    (by simpa only [inv_pow, inv_eq_one, PresentedGroup.of] using hpow0)
    (by simpa only [inv_pow, inv_eq_one, PresentedGroup.of] using hpow2) ?_ (by group)
  change (PresentedGroup.of 1 * PresentedGroup.of 3 :
    (P.doubleTriangleSidePairing h₀ h₁).RelatorQuotient) ^ r.exponent = 1 at hpow3
  rw [double_relatorQuotient_of_one, double_relatorQuotient_of_three,
    ← mul_inv_rev, inv_pow, inv_eq_one] at hpow3
  exact hpow3

/-- Eliminate inverse side generators in favour of the triangle generators. -/
private def doubleToTriangle : (P.doubleTriangleSidePairing h₀ h₁).RelatorQuotient →*
    TriangleGroup p.exponent q.exponent r.exponent :=
  PresentedGroup.toGroup (f :=
    ![(TriangleGroup.x p.exponent q.exponent r.exponent)⁻¹,
      TriangleGroup.y p.exponent q.exponent r.exponent,
      (TriangleGroup.y p.exponent q.exponent r.exponent)⁻¹,
      TriangleGroup.x p.exponent q.exponent r.exponent]) <| by
    intro w hw
    have ho := congrFun
      (orderOf_doubleTriangleSidePairing_cycleMap (h₀ := h₀) (h₁ := h₁) hp hq hr)
    rw [SidePairing.mem_relators_iff] at hw
    rcases hw with ⟨i, rfl⟩ | ⟨j, z, hj, rfl⟩
    · fin_cases i <;> simp [SidePairing.sideRelator_def, Fin.rev]
    · rw [doubleTriangleSidePairing_cycleWord, ho j]
      fin_cases j <;> simp [inv_pow, TriangleGroup.x_mul_y_pow]

variable (h₀ h₁)

/-- The side-and-cycle presentation of a doubled triangle is the oriented triangle group.
The inverse side generators at vertices zero and one are the first two triangle generators.
No discreteness or disjointness of translated interiors is assumed. -/
def doubleTriangleRelatorEquiv : (P.doubleTriangleSidePairing h₀ h₁).RelatorQuotient ≃*
    TriangleGroup p.exponent q.exponent r.exponent :=
  MonoidHom.toMulEquiv (doubleToTriangle hp hq hr) (triangleToDouble hp hq hr)
    (by
      apply PresentedGroup.ext
      intro i
      fin_cases i <;> simp [doubleToTriangle, triangleToDouble, PresentedGroup.toGroup.of,
        double_relatorQuotient_of_one, double_relatorQuotient_of_three])
    (by
      apply TriangleGroup.hom_ext <;>
        simp [doubleToTriangle, triangleToDouble, PresentedGroup.toGroup.of])

/-- Images of the four side generators under the triangle-presentation equivalence. -/
@[simp]
theorem doubleTriangleRelatorEquiv_of (i : Fin 4) :
    doubleTriangleRelatorEquiv h₀ h₁ hp hq hr (PresentedGroup.of i) =
      ![(TriangleGroup.x p.exponent q.exponent r.exponent)⁻¹,
        TriangleGroup.y p.exponent q.exponent r.exponent,
        (TriangleGroup.y p.exponent q.exponent r.exponent)⁻¹,
        TriangleGroup.x p.exponent q.exponent r.exponent] i := by
  simp [doubleTriangleRelatorEquiv, doubleToTriangle, PresentedGroup.toGroup.of]

/-- The first triangle generator is the inverse of the side-zero generator. -/
@[simp]
theorem doubleTriangleRelatorEquiv_symm_x :
    (doubleTriangleRelatorEquiv h₀ h₁ hp hq hr).symm
      (TriangleGroup.x p.exponent q.exponent r.exponent) = (PresentedGroup.of 0)⁻¹ := by
  simp [doubleTriangleRelatorEquiv, triangleToDouble]

/-- The second triangle generator is the inverse of the side-two generator. -/
@[simp]
theorem doubleTriangleRelatorEquiv_symm_y :
    (doubleTriangleRelatorEquiv h₀ h₁ hp hq hr).symm
      (TriangleGroup.y p.exponent q.exponent r.exponent) = (PresentedGroup.of 2)⁻¹ := by
  simp [doubleTriangleRelatorEquiv, triangleToDouble]

/-- The third triangle generator is the product of the side-zero and side-two generators. -/
@[simp]
theorem doubleTriangleRelatorEquiv_symm_z :
    (doubleTriangleRelatorEquiv h₀ h₁ hp hq hr).symm
      (TriangleGroup.z p.exponent q.exponent r.exponent) =
        PresentedGroup.of 0 * PresentedGroup.of 2 := by
  simp [doubleTriangleRelatorEquiv, triangleToDouble]

end TauCeti.UpperHalfPlane.ConvexPolygon
