/-!
# Hyperbolic triangle groups from reflections

Let `P` be a hyperbolic triangle, with vertices in `ℍ ∪ ∂ℍ`. The products of the reflections in
two of its sides are orientation-preserving isometries, and they generate the subgroup
`P.triangleGroup` of `PSL(2, ℝ)`: the orientation-preserving half of the group generated by the
reflections in the sides of `P`. It is generated by the three *vertex transformations*
`P.vertexReflectionComp i`, the products of the reflections in the two sides meeting at vertex
`i`, which satisfy `v 2 * v 1 * v 0 = 1`.

Suppose that the angles of `P` are given by a typed triple `p`, `q`, `r` of `TriangleOrder`
parameters: `π / m` at an elliptic entry of order `m`, and `0` at a cusp. Such a triangle exists
exactly when the triple is hyperbolic
(`TauCeti.TriangleOrder.isHyperbolic_iff_exists_interiorAngle_eq`).
Doubling `P` across a side whose ends have acute angles gives a side-paired quadrilateral
satisfying the hypotheses of Poincaré's polygon theorem: its finite vertex cycles have angle sums
`2π / m`, and the cycle transformations at its ideal vertices are parabolic. Hence:

* `P.triangleGroup` is a cofinite Fuchsian group, and the double of `P` is a fundamental domain;
* the abstract triangle group `Δ(p, q, r)` (`TauCeti.TriangleGroup`, with a cusp contributing no
  relation) maps isomorphically onto `P.triangleGroup`, by sending its generators to the vertex
  transformations: the presentation is faithful;
* the stabilizer of a finite vertex of `P` has order the corresponding elliptic order, and
  `P.triangleGroup` has one elliptic orbit for each elliptic entry and one cusp for each cusp
  entry of the triple.

## Main declarations

* `ConvexPolygon.triangleGroup`: the group generated by products of reflections in the sides of a
  triangle.
* `ConvexPolygon.vertexReflectionComp`: the product of the reflections in the two sides at a
  vertex.
* `ConvexPolygon.isFundamentalDomain_triangleGroup_doubleTriangle`: the double of the triangle is
  a fundamental domain.
* `ConvexPolygon.isCofinite_triangleGroup`: the triangle group is a cofinite Fuchsian group.
* `ConvexPolygon.triangleGroupEquiv`: the isomorphism `Δ(p, q, r) ≃* P.triangleGroup`.
* `ConvexPolygon.natCard_stabilizer_triangleGroup`,
  `ConvexPolygon.natCard_ellipticOrbits_triangleGroup` and
  `ConvexPolygon.natCard_cuspOrbit_triangleGroup`: the elliptic orders and the cusp count.
* `TriangleOrder.IsHyperbolic.exists_isCofinite_triangleGroup`: every hyperbolic typed triple is
  realised by a cofinite Fuchsian triangle group isomorphic to `Δ(p, q, r)`.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, Graduate Texts in Mathematics 91, Springer,
  1983, §10.6 (triangle groups).
* Svetlana Katok, *Fuchsian Groups*, Chicago Lectures in Mathematics, University of Chicago
  Press, 1992, §4.3 (Poincaré's theorem and the signature).
-/

public section

noncomputable section

open MeasureTheory MulAction Set UpperHalfPlane
open Matrix.ProjectiveSpecialLinearGroup (IsParabolic)
open scoped MatrixGroups Pointwise Real

namespace TauCeti.UpperHalfPlane.ConvexPolygon

variable (P : ConvexPolygon 3)

/-! ### The vertex transformations and the triangle group -/

/-- The transformation at vertex `i` of a triangle: the product of the reflections in the two
sides meeting there, first in side `i - 1` and then in side `i`. It is elliptic at a finite
vertex and parabolic at an ideal one. -/
def vertexReflectionComp (i : Fin 3) : PSL(2, ℝ) :=
  geodesicReflectionComp (P.sideGeodesic i) (P.sideGeodesic (i - 1))

/-- The vertex transformation, unfolded. -/
theorem vertexReflectionComp_def (i : Fin 3) :
    P.vertexReflectionComp i =
      geodesicReflectionComp (P.sideGeodesic i) (P.sideGeodesic (i - 1)) :=
  (rfl)

/-- The transformation at `P 0` is the product of the reflections in sides `2` and `0`. -/
theorem vertexReflectionComp_zero :
    P.vertexReflectionComp 0 = geodesicReflectionComp (P.sideGeodesic 0) (P.sideGeodesic 2) :=
  (rfl)

/-- The transformation at `P 1` is the product of the reflections in sides `0` and `1`. -/
theorem vertexReflectionComp_one :
    P.vertexReflectionComp 1 = geodesicReflectionComp (P.sideGeodesic 1) (P.sideGeodesic 0) :=
  (rfl)

/-- The transformation at `P 2` is the product of the reflections in sides `1` and `2`. -/
theorem vertexReflectionComp_two :
    P.vertexReflectionComp 2 = geodesicReflectionComp (P.sideGeodesic 2) (P.sideGeodesic 1) :=
  (rfl)

/-- Relabelling the vertices relabels the vertex transformations. -/
@[simp]
theorem vertexReflectionComp_rotate (k i : Fin 3) :
    (P.rotate k).vertexReflectionComp i = P.vertexReflectionComp (i + k) := by
  rw [vertexReflectionComp_def, vertexReflectionComp_def, sideGeodesic_rotate, sideGeodesic_rotate,
    sub_add_eq_add_sub]

/-- **The product relation of a triangle group**: the middle reflections cancel in
`v 2 * v 1 * v 0`. -/
@[simp]
theorem vertexReflectionComp_two_mul_one_mul_zero :
    P.vertexReflectionComp 2 * P.vertexReflectionComp 1 * P.vertexReflectionComp 0 = 1 := by
  simp [vertexReflectionComp_zero, vertexReflectionComp_one, vertexReflectionComp_two]

/-- At an ideal vertex, the vertex transformation is parabolic. -/
theorem isParabolic_vertexReflectionComp {i : Fin 3} {ξ : OnePoint ℝ}
    (hi : P.vertex i = .inr ξ) : IsParabolic (P.vertexReflectionComp i) := by
  rw [vertexReflectionComp_def, ← geodesicReflectionComp_inv,
    Matrix.ProjectiveSpecialLinearGroup.isParabolic_inv_iff]
  exact P.isParabolic_geodesicReflectionComp_sideGeodesic hi

/-- **The triangle group of a triangle**: the subgroup of `PSL(2, ℝ)` generated by the products
of the reflections in two of its sides, that is, the orientation-preserving subgroup of the group
generated by the reflections in its sides. -/
def triangleGroup : Subgroup PSL(2, ℝ) :=
  Subgroup.closure (range fun ij : Fin 3 × Fin 3 ↦
    geodesicReflectionComp (P.sideGeodesic ij.1) (P.sideGeodesic ij.2))

/-- The triangle group, unfolded. -/
theorem triangleGroup_def :
    P.triangleGroup = Subgroup.closure (range fun ij : Fin 3 × Fin 3 ↦
      geodesicReflectionComp (P.sideGeodesic ij.1) (P.sideGeodesic ij.2)) :=
  (rfl)

/-- The product of the reflections in two sides lies in the triangle group. -/
theorem geodesicReflectionComp_mem_triangleGroup (i j : Fin 3) :
    geodesicReflectionComp (P.sideGeodesic i) (P.sideGeodesic j) ∈ P.triangleGroup :=
  Subgroup.subset_closure ⟨(i, j), rfl⟩

/-- The vertex transformations lie in the triangle group. -/
theorem vertexReflectionComp_mem_triangleGroup (i : Fin 3) :
    P.vertexReflectionComp i ∈ P.triangleGroup :=
  P.geodesicReflectionComp_mem_triangleGroup _ _

/-- **The triangle group is generated by the vertex transformations.** -/
theorem triangleGroup_eq_closure_range_vertexReflectionComp :
    P.triangleGroup = Subgroup.closure (range P.vertexReflectionComp) := by
  refine le_antisymm ((Subgroup.closure_le _).2 ?_)
    ((Subgroup.closure_le _).2 (range_subset_iff.2 P.vertexReflectionComp_mem_triangleGroup))
  rintro _ ⟨⟨i, j⟩, rfl⟩
  -- the product of the reflections in sides `i` and `0` is a product of vertex transformations
  have h₀ (i : Fin 3) : geodesicReflectionComp (P.sideGeodesic i) (P.sideGeodesic 0) ∈
      Subgroup.closure (range P.vertexReflectionComp) := by
    have hv (k : Fin 3) : P.vertexReflectionComp k ∈ Subgroup.closure
        (range P.vertexReflectionComp) := Subgroup.subset_closure ⟨k, rfl⟩
    fin_cases i
    · simp
    · simpa [vertexReflectionComp_one] using hv 1
    · simpa [vertexReflectionComp_one, vertexReflectionComp_two] using mul_mem (hv 2) (hv 1)
  have hij := mul_mem (h₀ i) (inv_mem (h₀ j))
  rwa [geodesicReflectionComp_inv, geodesicReflectionComp_mul_geodesicReflectionComp] at hij

/-- Relabelling the vertices does not change the triangle group. -/
@[simp]
theorem triangleGroup_rotate (k : Fin 3) : (P.rotate k).triangleGroup = P.triangleGroup := by
  have h : (P.rotate k).vertexReflectionComp = P.vertexReflectionComp ∘ Equiv.addRight k :=
    funext fun i ↦ P.vertexReflectionComp_rotate k i
  rw [triangleGroup_eq_closure_range_vertexReflectionComp,
    triangleGroup_eq_closure_range_vertexReflectionComp, h,
    (Equiv.addRight k).surjective.range_comp]

/-! ### The double of a triangle with acute angles at the ends of side `0` -/

section Double

variable {P} (h₀ : P.interiorAngle 0 < π / 2) (h₁ : P.interiorAngle 1 < π / 2)

/-- The triangle group is generated by the side-pairing maps of the double of the triangle. -/
theorem triangleGroup_eq_closure_range_doubleTriangleSidePairing_map :
    P.triangleGroup = Subgroup.closure (range (P.doubleTriangleSidePairing h₀ h₁).map) := by
  refine le_antisymm ?_ ((Subgroup.closure_le _).2 ?_)
  · rw [triangleGroup_eq_closure_range_vertexReflectionComp, Subgroup.closure_le]
    have hm (j : Fin 4) : (P.doubleTriangleSidePairing h₀ h₁).map j ∈
        Subgroup.closure (range (P.doubleTriangleSidePairing h₀ h₁).map) :=
      Subgroup.subset_closure ⟨j, rfl⟩
    simp only [doubleTriangleSidePairing_map] at hm
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · simpa [vertexReflectionComp_zero] using hm 3
    · simpa [vertexReflectionComp_one] using hm 1
    · simpa [vertexReflectionComp_two] using mul_mem (hm 0) (hm 2)
  · rintro _ ⟨j, rfl⟩
    fin_cases j <;> simp [geodesicReflectionComp_mem_triangleGroup]

/-- The cycle transformations at `P 0`, `P 1` and `P 2` of the double are the inverses of the
vertex transformations there. -/
private theorem doubleTriangleSidePairing_cycleMap_eq_inv :
    (P.doubleTriangleSidePairing h₀ h₁).cycleMap 0 = (P.vertexReflectionComp 0)⁻¹ ∧
      (P.doubleTriangleSidePairing h₀ h₁).cycleMap 2 = (P.vertexReflectionComp 1)⁻¹ ∧
        (P.doubleTriangleSidePairing h₀ h₁).cycleMap 3 = (P.vertexReflectionComp 2)⁻¹ := by
  simp [vertexReflectionComp_zero, vertexReflectionComp_one, vertexReflectionComp_two]

/-- The cycle angle sum at a vertex of the double is twice the angle of `P` at the vertex it
comes from. -/
private theorem doubleTriangleSidePairing_cycleAngleSum (j : Fin 4) :
    (P.doubleTriangleSidePairing h₀ h₁).cycleAngleSum j =
      2 * P.interiorAngle ((![0, 2, 1, 2] : Fin 4 → Fin 3) j) := by
  fin_cases j <;> simp

variable {h₀ h₁}

/-- At a finite vertex of the double, coming from a vertex of `P` with angle `π / m`, the cycle
transformation has order `m`. -/
private theorem orderOf_doubleTriangleSidePairing_cycleMap {j : Fin 4} {z : ℍ}
    (hz : (P.doubleTriangle h₀ h₁).vertex j = .inl z) {m : ℕ}
    (hm : P.interiorAngle ((![0, 2, 1, 2] : Fin 4 → Fin 3) j) = π / m) :
    orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap j) = m :=
  SidePairing.orderOf_cycleMap_of_cycleAngleSum _ hz (by
    rw [doubleTriangleSidePairing_cycleAngleSum, hm, mul_div_assoc])

/-- If every angle of `P` is `π / m` for a natural number `m`, the double of `P` satisfies the
angle condition of Poincaré's theorem at its finite vertex cycles. -/
private theorem orderOf_doubleTriangleSidePairing_cycleMap_mul_cycleAngleSum
    (hP : ∀ i, ∃ m : ℕ, P.interiorAngle i = π / m) (j : Fin 4) (z : ℍ)
    (hz : (P.doubleTriangle h₀ h₁).vertex j = .inl z) :
    (orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap j) : ℝ) *
      (P.doubleTriangleSidePairing h₀ h₁).cycleAngleSum j = 2 * π := by
  obtain ⟨m, hm⟩ := hP ((![0, 2, 1, 2] : Fin 4 → Fin 3) j)
  have hleft : (P.vertex ((![0, 2, 1, 2] : Fin 4 → Fin 3) j)).isLeft := by
    rw [← isLeft_doubleTriangle_vertex (h₀ := h₀) (h₁ := h₁), hz, Sum.isLeft_inl]
  have hm0 : (m : ℝ) ≠ 0 := by
    intro h
    rw [h, div_zero, interiorAngle_eq_zero_iff, ← Sum.not_isLeft, hleft] at hm
    exact hm rfl
  rw [orderOf_doubleTriangleSidePairing_cycleMap hz hm, doubleTriangleSidePairing_cycleAngleSum,
    hm]
  field_simp

/-- The cycle transformations at the ideal vertices of the double are parabolic. -/
private theorem isParabolic_doubleTriangleSidePairing_cycleMap (j : Fin 4) (ξ : OnePoint ℝ)
    (hξ : (P.doubleTriangle h₀ h₁).vertex j = .inr ξ) :
    IsParabolic ((P.doubleTriangleSidePairing h₀ h₁).cycleMap j) := by
  obtain ⟨hc₀, hc₂, hc₃⟩ := doubleTriangleSidePairing_cycleMap_eq_inv h₀ h₁
  have hright : (P.vertex ((![0, 2, 1, 2] : Fin 4 → Fin 3) j)).isRight := by
    rw [← isRight_doubleTriangle_vertex (h₀ := h₀) (h₁ := h₁), hξ, Sum.isRight_inr]
  obtain ⟨η, hη⟩ := Sum.isRight_iff.1 hright
  have hv := P.isParabolic_vertexReflectionComp hη
  fin_cases j
  · simpa [hc₀] using hv
  · -- the cycle through the mirror image of `P 2` is conjugate to the one at `P 2`
    have h := (P.doubleTriangleSidePairing h₀ h₁).cycleMap_next 3
    rw [doubleTriangleSidePairing_next, Equiv.swap_apply_right, hc₃] at h
    simp only [Fin.mk_one]
    rw [h, Matrix.ProjectiveSpecialLinearGroup.isParabolic_conj_iff,
      Matrix.ProjectiveSpecialLinearGroup.isParabolic_inv_iff]
    simpa using hv
  · simpa [hc₂] using hv
  · simpa [hc₃] using hv

/-- If every angle of `P` is `π / m` for a natural number `m`, the translates of the double of
`P` by the triangle group are locally finite, and those of its interior are pairwise disjoint. -/
private theorem locallyFinite_and_disjoint_doubleTriangle
    (hP : ∀ i, ∃ m : ℕ, P.interiorAngle i = π / m) :
    (LocallyFinite fun γ : P.triangleGroup ↦
      (γ : PSL(2, ℝ)) • (P.doubleTriangle h₀ h₁).carrier) ∧
    ∀ γ : P.triangleGroup, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior (P.doubleTriangle h₀ h₁).carrier)
        (interior (P.doubleTriangle h₀ h₁).carrier) := by
  have hcyc := orderOf_doubleTriangleSidePairing_cycleMap_mul_cycleAngleSum (h₀ := h₀) (h₁ := h₁) hP
  have hpar := isParabolic_doubleTriangleSidePairing_cycleMap (h₀ := h₀) (h₁ := h₁)
  rw [triangleGroup_eq_closure_range_doubleTriangleSidePairing_map h₀ h₁]
  exact ⟨(P.doubleTriangleSidePairing h₀ h₁).locallyFinite_smul_carrier_of_isParabolic hcyc hpar,
    (P.doubleTriangleSidePairing h₀ h₁).disjoint_smul_interior_carrier_of_isParabolic hcyc hpar⟩

/-- The side-pairing maps of the double lie in the triangle group. -/
private theorem doubleTriangleSidePairing_map_mem_triangleGroup (i : Fin 4) :
    (P.doubleTriangleSidePairing h₀ h₁).map i ∈ P.triangleGroup := by
  rw [triangleGroup_eq_closure_range_doubleTriangleSidePairing_map h₀ h₁]
  exact Subgroup.subset_closure ⟨i, rfl⟩

/-- At a finite vertex of `P` with angle `π / m`, the vertex transformation has order `m`. -/
private theorem orderOf_vertexReflectionComp_of_acute (h₀ : P.interiorAngle 0 < π / 2)
    (h₁ : P.interiorAngle 1 < π / 2) {i : Fin 3} {z : ℍ}
    (hz : P.vertex i = .inl z) {m : ℕ} (hm : P.interiorAngle i = π / m) :
    orderOf (P.vertexReflectionComp i) = m := by
  have hm0 : m ≠ 0 := by
    rintro rfl
    rw [Nat.cast_zero, div_zero, interiorAngle_eq_zero_iff, hz] at hm
    exact Bool.false_ne_true hm
  obtain ⟨hc₀, hc₂, hc₃⟩ := doubleTriangleSidePairing_cycleMap_eq_inv h₀ h₁
  fin_cases i
  · simpa [hc₀] using orderOf_doubleTriangleSidePairing_cycleMap_zero (h₀ := h₀) (h₁ := h₁) hm0 hm
  · simpa [hc₂] using orderOf_doubleTriangleSidePairing_cycleMap_two (h₀ := h₀) (h₁ := h₁) hm0 hm
  · simpa [hc₃] using
      orderOf_doubleTriangleSidePairing_cycleMap_three (h₀ := h₀) (h₁ := h₁) hm0 hm

end Double

/-! ### Typed angles -/

variable {P} {p q r : TriangleOrder}

/-- The angles of a triangle with typed angles `p`, `q`, `r` are `π` divided by the orders. -/
private theorem interiorAngle_eq_pi_div_order (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) (i : Fin 3) :
    P.interiorAngle i = π / (![p, q, r] i).order := by
  rw [← TriangleOrder.angle_eq_pi_div_order]
  fin_cases i <;> simpa

/-- **The fundamental domain of a triangle group.** If the angles of `P` are given by a typed
triple, and those at the ends of side `0` are acute, the double of `P` is a fundamental domain for
the triangle group. -/
theorem isFundamentalDomain_triangleGroup_doubleTriangle (h₀ : P.interiorAngle 0 < π / 2)
    (h₁ : P.interiorAngle 1 < π / 2) (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    IsFundamentalDomain P.triangleGroup (P.doubleTriangle h₀ h₁).carrier := by
  obtain ⟨hlf, hdisj⟩ := locallyFinite_and_disjoint_doubleTriangle (h₀ := h₀) (h₁ := h₁)
    fun i ↦ ⟨_, interiorAngle_eq_pi_div_order hp hq hr i⟩
  exact (P.doubleTriangleSidePairing h₀ h₁).isFundamentalDomain_carrier
    doubleTriangleSidePairing_map_mem_triangleGroup hlf hdisj

/-- **Hyperbolic triangle groups are cofinite Fuchsian groups.** If the angles of `P` are given
by a typed triple of elliptic orders and cusps, the triangle group of `P` is discrete and has
finite covolume. -/
theorem isCofinite_triangleGroup (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    P.triangleGroup.IsCofinite := by
  obtain ⟨k, h₀, h₁⟩ := P.exists_interiorAngle_rotate_lt_pi_div_two
  rw [← P.triangleGroup_rotate k]
  obtain ⟨hlf, hdisj⟩ := locallyFinite_and_disjoint_doubleTriangle (h₀ := h₀) (h₁ := h₁)
    fun i ↦ ⟨_, (interiorAngle_rotate P k i).trans (interiorAngle_eq_pi_div_order hp hq hr _)⟩
  exact ((P.rotate k).doubleTriangleSidePairing h₀ h₁).isCofinite
    doubleTriangleSidePairing_map_mem_triangleGroup hlf hdisj

/-- **The orders of the vertex transformations.** If the angles of `P` are given by a typed
triple, the transformation at a vertex has the order of the corresponding entry: `m` at an
elliptic entry of order `m`, and infinite order at a cusp. -/
theorem orderOf_vertexReflectionComp (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) (i : Fin 3) :
    orderOf (P.vertexReflectionComp i) = (![p, q, r] i).order := by
  have hi := interiorAngle_eq_pi_div_order hp hq hr i
  rcases hv : P.vertex i with z | ξ
  · obtain ⟨k, h₀, h₁⟩ := P.exists_interiorAngle_rotate_lt_pi_div_two
    have h := orderOf_vertexReflectionComp_of_acute h₀ h₁ (i := i - k)
      (by rw [vertex_rotate, sub_add_cancel, hv]) (by rw [interiorAngle_rotate, sub_add_cancel, hi])
    rwa [vertexReflectionComp_rotate, sub_add_cancel] at h
  · rw [(P.isParabolic_vertexReflectionComp hv).orderOf_eq_zero, eq_comm]
    rw [P.interiorAngle_eq_zero_of_vertex_eq_inr hv, eq_comm, div_eq_zero_iff] at hi
    exact_mod_cast hi.resolve_left Real.pi_ne_zero

/-! ### The presentation -/

/-- The homomorphism from the abstract triangle group `Δ(p, q, r)` onto the triangle group of a
triangle with angles `p`, `q`, `r`, sending the generators to the vertex transformations. -/
private def triangleGroupHom (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    TriangleGroup p.order q.order r.order →* P.triangleGroup :=
  TriangleGroup.lift ⟨_, P.vertexReflectionComp_mem_triangleGroup 0⟩
    ⟨_, P.vertexReflectionComp_mem_triangleGroup 1⟩ ⟨_, P.vertexReflectionComp_mem_triangleGroup 2⟩
    (Subtype.ext (by
      simpa using (orderOf_vertexReflectionComp hp hq hr 0) ▸ pow_orderOf_eq_one _))
    (Subtype.ext (by
      simpa using (orderOf_vertexReflectionComp hp hq hr 1) ▸ pow_orderOf_eq_one _))
    (Subtype.ext (by
      simpa using (orderOf_vertexReflectionComp hp hq hr 2) ▸ pow_orderOf_eq_one _))
    (Subtype.ext (by simp))

@[simp]
private theorem coe_triangleGroupHom_x (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    (triangleGroupHom hp hq hr (TriangleGroup.x _ _ _) : PSL(2, ℝ)) = P.vertexReflectionComp 0 := by
  simp [triangleGroupHom]

@[simp]
private theorem coe_triangleGroupHom_y (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    (triangleGroupHom hp hq hr (TriangleGroup.y _ _ _) : PSL(2, ℝ)) = P.vertexReflectionComp 1 := by
  simp [triangleGroupHom]

@[simp]
private theorem coe_triangleGroupHom_z (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    (triangleGroupHom hp hq hr (TriangleGroup.z _ _ _) : PSL(2, ℝ)) = P.vertexReflectionComp 2 := by
  simp [triangleGroupHom]

/-- The vertex transformations generate the triangle group, so the homomorphism from `Δ(p, q, r)`
is onto. -/
private theorem triangleGroupHom_surjective (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    Function.Surjective (triangleGroupHom hp hq hr) := by
  rintro ⟨g, hg⟩
  have hle : Subgroup.closure (range P.vertexReflectionComp) ≤
      (P.triangleGroup.subtype.comp (triangleGroupHom hp hq hr)).range := by
    rw [Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact ⟨TriangleGroup.x _ _ _, by simp⟩
    · exact ⟨TriangleGroup.y _ _ _, by simp⟩
    · exact ⟨TriangleGroup.z _ _ _, by simp⟩
  obtain ⟨w, hw⟩ := (P.triangleGroup_eq_closure_range_vertexReflectionComp.trans_le hle) hg
  exact ⟨w, Subtype.ext hw⟩

/-- When the angles at the ends of side `0` are acute, the side and cycle relations of the double
of `P` follow from the relations of `Δ(p, q, r)`, so Poincaré's presentation theorem for the
double makes the homomorphism from `Δ(p, q, r)` injective. -/
private theorem triangleGroupHom_injective_of_acute (h₀ : P.interiorAngle 0 < π / 2)
    (h₁ : P.interiorAngle 1 < π / 2) (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    Function.Injective (triangleGroupHom hp hq hr) := by
  set σ := P.doubleTriangleSidePairing h₀ h₁
  have hmap : ∀ i, σ.map i ∈ P.triangleGroup := doubleTriangleSidePairing_map_mem_triangleGroup
  obtain ⟨hlf, hdisj⟩ := locallyFinite_and_disjoint_doubleTriangle (h₀ := h₀) (h₁ := h₁)
    fun i ↦ ⟨_, interiorAngle_eq_pi_div_order hp hq hr i⟩
  have hbij := σ.relatorQuotientTo_bijective hmap hlf hdisj
  -- the side-pairing maps of the double are `v 0⁻¹`, `v 1`, `v 1⁻¹` and `v 0`
  let ψ : σ.RelatorQuotient →* TriangleGroup p.order q.order r.order :=
    PresentedGroup.toGroup (f := ![(TriangleGroup.x _ _ _)⁻¹, TriangleGroup.y _ _ _,
      (TriangleGroup.y _ _ _)⁻¹, TriangleGroup.x _ _ _]) <| by
      intro w hw
      rcases σ.mem_relators_iff.1 hw with ⟨i, rfl⟩ | ⟨j, z, hz, rfl⟩
      · fin_cases i <;> simp [σ, SidePairing.sideRelator_def, Fin.rev]
      · rw [map_pow, orderOf_doubleTriangleSidePairing_cycleMap hz
          (interiorAngle_eq_pi_div_order hp hq hr _)]
        fin_cases j
        · simp [σ, SidePairing.cycleWord_def, SidePairing.partialCycleWord_succ]
        · -- the cycle word through the mirror image of `P 2` is conjugate to `y * x`
          have hxy : TriangleGroup.x p.order q.order r.order * TriangleGroup.y _ _ _ =
              TriangleGroup.x _ _ _ * (TriangleGroup.y _ _ _ * TriangleGroup.x _ _ _) *
                (TriangleGroup.x _ _ _)⁻¹ := by
            group
          simp [σ, SidePairing.cycleWord_def, SidePairing.partialCycleWord_succ,
            doubleTriangleSidePairing_next, hxy, conj_pow]
        · simp [σ, SidePairing.cycleWord_def, SidePairing.partialCycleWord_succ]
        · simp [σ, SidePairing.cycleWord_def, SidePairing.partialCycleWord_succ,
            doubleTriangleSidePairing_next]
  have hcomp : (triangleGroupHom hp hq hr).comp ψ = σ.relatorQuotientTo hmap := by
    refine PresentedGroup.ext fun j ↦ Subtype.ext ?_
    fin_cases j <;> simp [ψ, σ, SidePairing.relatorQuotientTo_of, vertexReflectionComp_zero,
      vertexReflectionComp_one]
  have hψ : Function.Surjective ψ := by
    refine MonoidHom.range_eq_top.1 (eq_top_iff.2 ?_)
    rw [← TriangleGroup.closure_x_y, Subgroup.closure_le]
    rintro _ (rfl | rfl)
    · exact ⟨PresentedGroup.of 3, by simp [ψ]⟩
    · exact ⟨PresentedGroup.of 1, by simp [ψ]⟩
  refine (injective_iff_map_eq_one _).2 fun g hg ↦ ?_
  obtain ⟨w, rfl⟩ := hψ g
  have hw : σ.relatorQuotientTo hmap w = σ.relatorQuotientTo hmap 1 := by
    rw [map_one, ← hcomp, MonoidHom.comp_apply, hg]
  rw [hbij.1 hw, map_one]

/-- If the homomorphism from `Δ(p, q, r)` for `P` factors through an injective homomorphism into
the abstract triangle group of a triangle `Q` with acute angles at the ends of side `0`, it is
injective. -/
private theorem triangleGroupHom_injective_of_factor {a b c : TriangleOrder} {Q : ConvexPolygon 3}
    (hp : P.interiorAngle 0 = p.angle) (hq : P.interiorAngle 1 = q.angle)
    (hr : P.interiorAngle 2 = r.angle) (ha : Q.interiorAngle 0 = a.angle)
    (hb : Q.interiorAngle 1 = b.angle) (hc : Q.interiorAngle 2 = c.angle)
    (h₀ : Q.interiorAngle 0 < π / 2) (h₁ : Q.interiorAngle 1 < π / 2)
    (e : TriangleGroup p.order q.order r.order →* TriangleGroup a.order b.order c.order)
    (he : Function.Injective e)
    (hfac : P.triangleGroup.subtype.comp (triangleGroupHom hp hq hr) =
      Q.triangleGroup.subtype.comp ((triangleGroupHom ha hb hc).comp e)) :
    Function.Injective (triangleGroupHom hp hq hr) := by
  intro g₁ g₂ hg
  refine he (triangleGroupHom_injective_of_acute h₀ h₁ ha hb hc (Subtype.ext ?_))
  have h₁ := DFunLike.congr_fun hfac g₁
  have h₂ := DFunLike.congr_fun hfac g₂
  simp only [MonoidHom.comp_apply, Subgroup.coe_subtype] at h₁ h₂
  rw [← h₁, ← h₂, hg]

/-- The homomorphism from `Δ(p, q, r)` is injective. The double of a relabelling of `P` with
acute angles at the ends of side `0` gives injectivity for that relabelling, and relabelling the
vertices corresponds to rotating the generators of the abstract triangle group. -/
private theorem triangleGroupHom_injective (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    Function.Injective (triangleGroupHom hp hq hr) := by
  obtain ⟨k, h₀, h₁⟩ := P.exists_interiorAngle_rotate_lt_pi_div_two
  fin_cases k
  · simp only [Fin.zero_eta, rotate_zero] at h₀ h₁
    exact triangleGroupHom_injective_of_factor hp hq hr hp hq hr h₀ h₁ (MonoidHom.id _)
      Function.injective_id rfl
  · have hq' : (P.rotate 1).interiorAngle 0 = q.angle := by simpa using hq
    have hr' : (P.rotate 1).interiorAngle 1 = r.angle := by simpa using hr
    have hp' : (P.rotate 1).interiorAngle 2 = p.angle := by simpa using hp
    exact triangleGroupHom_injective_of_factor (a := q) (b := r) (c := p) hp hq hr hq' hr' hp'
      h₀ h₁ TriangleGroup.rotate.toMonoidHom TriangleGroup.rotate.injective
      (TriangleGroup.hom_ext _ _ _ (by simp) (by simp))
  · have hr' : (P.rotate 2).interiorAngle 0 = r.angle := by simpa using hr
    have hp' : (P.rotate 2).interiorAngle 1 = p.angle := by simpa using hp
    have hq' : (P.rotate 2).interiorAngle 2 = q.angle := by simpa using hq
    exact triangleGroupHom_injective_of_factor (a := r) (b := p) (c := q) hp hq hr hr' hp' hq'
      h₀ h₁ (TriangleGroup.rotate.trans TriangleGroup.rotate).toMonoidHom
      (TriangleGroup.rotate.trans TriangleGroup.rotate).injective
      (TriangleGroup.hom_ext _ _ _ (by simp) (by simp))

/-- **The presentation of a hyperbolic triangle group is faithful.** If the angles of `P` are
given by a typed triple `p`, `q`, `r`, the abstract triangle group
`Δ(p, q, r) = ⟨x, y, z | x ^ p, y ^ q, z ^ r, z * y * x⟩`, in which a cusp entry imposes no
power relation, is isomorphic to the triangle group of `P`, by sending `x`, `y`, `z` to the
vertex transformations at `P 0`, `P 1`, `P 2`. -/
def triangleGroupEquiv (hp : P.interiorAngle 0 = p.angle) (hq : P.interiorAngle 1 = q.angle)
    (hr : P.interiorAngle 2 = r.angle) :
    TriangleGroup p.order q.order r.order ≃* P.triangleGroup :=
  MulEquiv.ofBijective (triangleGroupHom hp hq hr)
    ⟨triangleGroupHom_injective hp hq hr, triangleGroupHom_surjective hp hq hr⟩

/-- The isomorphism `Δ(p, q, r) ≃* P.triangleGroup` sends `x` to the transformation at `P 0`. -/
@[simp]
theorem coe_triangleGroupEquiv_x (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    (triangleGroupEquiv hp hq hr (TriangleGroup.x _ _ _) : PSL(2, ℝ)) =
      P.vertexReflectionComp 0 :=
  coe_triangleGroupHom_x hp hq hr

/-- The isomorphism `Δ(p, q, r) ≃* P.triangleGroup` sends `y` to the transformation at `P 1`. -/
@[simp]
theorem coe_triangleGroupEquiv_y (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    (triangleGroupEquiv hp hq hr (TriangleGroup.y _ _ _) : PSL(2, ℝ)) =
      P.vertexReflectionComp 1 :=
  coe_triangleGroupHom_y hp hq hr

/-- The isomorphism `Δ(p, q, r) ≃* P.triangleGroup` sends `z` to the transformation at `P 2`. -/
@[simp]
theorem coe_triangleGroupEquiv_z (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    (triangleGroupEquiv hp hq hr (TriangleGroup.z _ _ _) : PSL(2, ℝ)) =
      P.vertexReflectionComp 2 :=
  coe_triangleGroupHom_z hp hq hr

/-! ### Elliptic orders and cusps -/

/-- **The elliptic orders of a triangle group.** If the angles of `P` are given by a typed
triple, the stabilizer of a finite vertex of `P` in its triangle group has the order of the
corresponding entry. -/
theorem natCard_stabilizer_triangleGroup (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) {i : Fin 3} {z : ℍ}
    (hz : P.vertex i = .inl z) :
    Nat.card (stabilizer P.triangleGroup z) = (![p, q, r] i).order := by
  obtain ⟨k, h₀, h₁⟩ := P.exists_interiorAngle_rotate_lt_pi_div_two
  have hi := interiorAngle_eq_pi_div_order hp hq hr i
  have hm : (![p, q, r] i).order ≠ 0 := by
    intro h
    rw [h, Nat.cast_zero, div_zero, interiorAngle_eq_zero_iff, hz] at hi
    exact Bool.false_ne_true hi
  obtain ⟨hlf, hdisj⟩ := locallyFinite_and_disjoint_doubleTriangle (h₀ := h₀) (h₁ := h₁)
    fun i ↦ ⟨_, (interiorAngle_rotate P k i).trans (interiorAngle_eq_pi_div_order hp hq hr _)⟩
  rw [← P.triangleGroup_rotate k]
  exact natCard_stabilizer_of_doubleTriangle doubleTriangleSidePairing_map_mem_triangleGroup hdisj
    (i := i - k) (by rw [vertex_rotate, sub_add_cancel, hz]) hm
    (by rw [interiorAngle_rotate, sub_add_cancel, hi])

/-- **The number of elliptic orbits of a triangle group.** If the angles of `P` are given by a
typed triple, the triangle group of `P` has one elliptic orbit for each elliptic entry. -/
theorem natCard_ellipticOrbits_triangleGroup (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    Nat.card P.triangleGroup.ellipticOrbits =
      (Finset.univ.filter fun i ↦ ![p, q, r] i ≠ .cusp).card := by
  obtain ⟨k, h₀, h₁⟩ := P.exists_interiorAngle_rotate_lt_pi_div_two
  obtain ⟨hlf, hdisj⟩ := locallyFinite_and_disjoint_doubleTriangle (h₀ := h₀) (h₁ := h₁)
    fun i ↦ ⟨_, (interiorAngle_rotate P k i).trans (interiorAngle_eq_pi_div_order hp hq hr _)⟩
  have hcover := ((P.rotate k).doubleTriangleSidePairing h₀ h₁).iUnion_smul_carrier_eq_univ
    doubleTriangleSidePairing_map_mem_triangleGroup hlf
  rw [← P.triangleGroup_rotate k, ← Nat.card_congr (doubleTriangleEllipticOrbitEquiv
      doubleTriangleSidePairing_map_mem_triangleGroup hcover hdisj),
    Nat.card_congr (Equiv.subtypeEquiv (q := fun i ↦ (P.vertex i).isLeft) (Equiv.addRight k)
      fun i ↦ by rw [vertex_rotate, Equiv.coe_addRight]),
    Nat.card_eq_fintype_card, Fintype.card_subtype]
  simp_rw [← Sum.not_isRight, isRight_vertex_iff_eq_cusp hp hq hr]

/-- **The number of cusps of a triangle group.** If the angles of `P` are given by a typed triple,
the triangle group of `P` has one cusp orbit for each cusp entry. -/
theorem natCard_cuspOrbit_triangleGroup (hp : P.interiorAngle 0 = p.angle)
    (hq : P.interiorAngle 1 = q.angle) (hr : P.interiorAngle 2 = r.angle) :
    Nat.card P.triangleGroup.CuspOrbit =
      (Finset.univ.filter fun i ↦ ![p, q, r] i = .cusp).card := by
  obtain ⟨k, h₀, h₁⟩ := P.exists_interiorAngle_rotate_lt_pi_div_two
  obtain ⟨hlf, hdisj⟩ := locallyFinite_and_disjoint_doubleTriangle (h₀ := h₀) (h₁ := h₁)
    fun i ↦ ⟨_, (interiorAngle_rotate P k i).trans (interiorAngle_eq_pi_div_order hp hq hr _)⟩
  rw [← P.triangleGroup_rotate k, ← Nat.card_congr (doubleTriangleCuspOrbitEquiv
      doubleTriangleSidePairing_map_mem_triangleGroup hlf hdisj),
    Nat.card_congr (Equiv.subtypeEquiv (q := fun i ↦ (P.vertex i).isRight) (Equiv.addRight k)
      fun i ↦ by rw [vertex_rotate, Equiv.coe_addRight]),
    Nat.card_eq_fintype_card, Fintype.card_subtype]
  simp_rw [isRight_vertex_iff_eq_cusp hp hq hr]

end TauCeti.UpperHalfPlane.ConvexPolygon

namespace TauCeti.TriangleOrder.IsHyperbolic

open UpperHalfPlane.ConvexPolygon

/-- **Hyperbolic triangle groups.** For a hyperbolic typed triple `p`, `q`, `r` of elliptic orders
and cusps, some hyperbolic triangle has the corresponding angles, and its triangle group, generated
by products of reflections in its sides, is a cofinite Fuchsian group isomorphic to the abstract
triangle group `Δ(p, q, r)`. -/
theorem exists_isCofinite_triangleGroup {p q r : TriangleOrder} (h : IsHyperbolic p q r) :
    ∃ P : UpperHalfPlane.ConvexPolygon 3, P.interiorAngle 0 = p.angle ∧
      P.interiorAngle 1 = q.angle ∧ P.interiorAngle 2 = r.angle ∧ P.triangleGroup.IsCofinite ∧
        Nonempty (TriangleGroup p.order q.order r.order ≃* P.triangleGroup) := by
  obtain ⟨P, hp, hq, hr⟩ := isHyperbolic_iff_exists_interiorAngle_eq.1 h
  exact ⟨P, hp, hq, hr, isCofinite_triangleGroup hp hq hr, ⟨triangleGroupEquiv hp hq hr⟩⟩

end TauCeti.TriangleOrder.IsHyperbolic
