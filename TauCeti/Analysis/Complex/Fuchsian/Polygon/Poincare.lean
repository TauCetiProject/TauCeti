module

public import TauCeti.Analysis.Complex.Fuchsian.FundamentalPolygon
public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.Presentation
import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.LocalTiling

/-!
# Poincaré's polygon theorem for compact polygons

Let `σ` be a side pairing of a compact convex hyperbolic polygon `P`, and let `Γ` be the subgroup
of `PSL(2, ℝ)` generated by the side-pairing maps. Suppose that every vertex cycle satisfies the
angle condition: its cycle transformation has finite order `m`, and the interior angles of `P`
along the cycle add up to `2π / m`. Then

* `Γ` is a cofinite Fuchsian group, in particular discrete;
* `P` is a fundamental domain for `Γ`: its translates cover the upper half-plane and distinct
  translates of its interior are disjoint;
* `Γ` is presented by generators indexed by the sides, subject to the side relations
  `map (pair i) * map i = 1` and the cycle relations `cycleWord j ^ m = 1`.

The angle condition makes the tiles predicted by the side pairings a local tiling of the upper
half-plane, and the theorem follows from the global tessellation theorem for local tilings. The
converse, that a compact fundamental polygon satisfies the angle condition, is
`ConvexPolygon.SidePairing.orderOf_cycleMap_mul_cycleAngleSum`.

## Main results

* `ConvexPolygon.SidePairing.isFundamentalDomain_carrier_of_isCompact`: `P` is a measurable
  fundamental domain for the group generated by the side-pairing maps.
* `ConvexPolygon.SidePairing.isCofinite_of_isCompact`: this group is a cofinite Fuchsian group.
* `ConvexPolygon.SidePairing.relatorQuotientTo_bijective_of_isCompact`: this group is presented
  by the side and cycle relations.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, Graduate Texts in Mathematics 91,
  Springer, 1983, §9.8 (Poincaré's theorem).
* Svetlana Katok, *Fuchsian Groups*, Chicago Lectures in Mathematics, University of Chicago
  Press, 1992, §4.3.
* Bernard Maskit, *On Poincaré's theorem for fundamental polygons*, Adv. Math. 7 (1971),
  219–230.
-/

public section

open MeasureTheory Set UpperHalfPlane
open scoped MatrixGroups Pointwise Real

namespace TauCeti.UpperHalfPlane.ConvexPolygon.SidePairing

variable {n : ℕ} [NeZero n] {P : ConvexPolygon n} (σ : P.SidePairing)

/-- **The fundamental-set part of Poincaré's polygon theorem.** If a compact side-paired polygon
satisfies the angle condition at every vertex cycle, then it is a measurable fundamental domain
for the group generated by its side-pairing maps. -/
theorem isFundamentalDomain_carrier_of_isCompact (hc : IsCompact P.carrier)
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π) :
    IsFundamentalDomain (Subgroup.closure (range σ.map)) P.carrier :=
  σ.isFundamentalDomain_carrier (fun i ↦ Subgroup.subset_closure (mem_range_self i))
    (σ.locallyFinite_smul_carrier_of_isCompact hc hcyc)
    (σ.disjoint_smul_interior_carrier_of_isCompact hc hcyc)

/-- **The discreteness part of Poincaré's polygon theorem.** If a compact side-paired polygon
satisfies the angle condition at every vertex cycle, then the group generated by its side-pairing
maps is a cofinite Fuchsian group: it is discrete and has finite covolume. -/
theorem isCofinite_of_isCompact (hc : IsCompact P.carrier)
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π) :
    (Subgroup.closure (range σ.map)).IsCofinite :=
  σ.isCofinite (fun i ↦ Subgroup.subset_closure (mem_range_self i))
    (σ.locallyFinite_smul_carrier_of_isCompact hc hcyc)
    (σ.disjoint_smul_interior_carrier_of_isCompact hc hcyc)

/-- **The presentation part of Poincaré's polygon theorem.** If a compact side-paired polygon
satisfies the angle condition at every vertex cycle, then evaluating the side generators at the
side-pairing maps is an isomorphism from the group presented by the side relations and the vertex
cycle relations onto the group generated by the side-pairing maps. -/
theorem relatorQuotientTo_bijective_of_isCompact (hc : IsCompact P.carrier)
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π) :
    Function.Bijective
      (σ.relatorQuotientTo fun i ↦ Subgroup.subset_closure (mem_range_self i)) :=
  σ.relatorQuotientTo_bijective _ (σ.locallyFinite_smul_carrier_of_isCompact hc hcyc)
    (σ.disjoint_smul_interior_carrier_of_isCompact hc hcyc)

end TauCeti.UpperHalfPlane.ConvexPolygon.SidePairing
