/-!
# The deformation of the modular group into the triangle groups `Δ(3, 2, p)`

The modular group `PSL(2, ℤ)` is generated by the classes of `S = !![0, -1; 1, 0]` and
`T = !![1, 1; 0, 1]`; it is the triangle group `Δ(3, 2, ∞)`, with `x`, `y`, `z` going to `S T`,
`S` and `T⁻¹` (`TauCeti.ModularGroup.triangleGroupEquiv`). Replacing the parabolic `T` by an
elliptic element of order `p` deforms this presentation into one of the compact triangle group
`Δ(3, 2, p)`. For a real `θ` with `4 sin² θ ≤ 1` put

`b θ = (1 + √(1 - 4 sin² θ)) / 2`, the larger root of `b ^ 2 - b + sin² θ = 0`,

`U θ = !![cos θ, b θ; b θ - 1, cos θ]` and `L θ = !![cos θ, b θ - 1; b θ, cos θ]`.

Both have determinant `cos² θ + b θ (1 - b θ) = 1` and trace `2 cos θ`, and `S U θ` has trace `1`.
At `θ = π / p` this gives `U ^ p = -1`, `(S U) ^ 3 = -1` and `S ^ 2 = -1`, so the classes of
`S U`, `S` and `U⁻¹` in `PSL(2, ℝ)` satisfy the relations of `Δ(3, 2, p)` and have the exact
orders `3`, `2` and `p`. The fixed points in `ℍ` are explicit: for `0 < sin θ`, `U θ` fixes
exactly the point `i y` with `y = b θ / sin θ`, whose square is `b θ / (1 - b θ)`, and for
`0 < cos θ`, `S U θ` fixes exactly the point `(1 - 2 b θ + i √3) / (2 cos θ)`. For `7 ≤ p`,
where `π / p + π / 3 + π / 2 < π`, these two points at `θ = π / p` and the fixed point `i` of `S`
are the vertices of the hyperbolic triangle with angles `π / p`, `π / 3` and `π / 2` that the
representation is meant to realize; the identification of its vertex transformations with `U⁻¹`,
`S U` and `S`, which would make the representation faithful with cofinite image, is not proved
here. At `p = 6` the triangle group is Euclidean, `b = 1 / 2`, all three fixed points are `i`, and
the image of the representation is finite. As `p → ∞` the matrices `U (π / p)` and `L (π / p)` tend
to the unipotent matrices `T` and `Tᵀ`, while the height `b / sin θ` of the fixed point of
`U (π / p)` is `p / π + O(1 / p)`.

## Main definitions

* `TauCeti.TriangleDeformation.b`, `TauCeti.TriangleDeformation.U`,
  `TauCeti.TriangleDeformation.L`: the deformation parameter and the deformed matrices.
* `TauCeti.TriangleDeformation.slU`, `TauCeti.TriangleDeformation.slL`: the same matrices as
  elements of `SL(2, ℝ)`, for `4 sin² θ ≤ 1`.
* `TauCeti.TriangleDeformation.cuspHeight`: the height `b θ / sin θ` of the fixed point of `U θ`.
* `TauCeti.TriangleDeformation.pslRep`: for `6 ≤ p`, the representation
  `Δ(3, 2, p) →* PSL(2, ℝ)` sending `x`, `y`, `z` to the classes of `S U`, `S` and `U⁻¹` at
  `θ = π / p`.

## Main results

* `TauCeti.TriangleDeformation.det_U`, `TauCeti.TriangleDeformation.trace_U`,
  `TauCeti.TriangleDeformation.trace_S_mul_U`: the determinant and the traces.
* `TauCeti.TriangleDeformation.slU_pow_eq_neg_one`,
  `TauCeti.TriangleDeformation.S_mul_slU_pow_three_eq_neg_one`: `U (π / p) ^ p = -1` and
  `(S U) ^ 3 = -1`.
* `TauCeti.TriangleDeformation.slL_eq`: `L = S U⁻¹ S⁻¹`.
* `TauCeti.TriangleDeformation.slU_smul_eq_self_iff`,
  `TauCeti.TriangleDeformation.S_mul_slU_smul_eq_self_iff`: the fixed points of `U` and `S U`.
* `TauCeti.TriangleDeformation.tendsto_U_pi_div`, `TauCeti.TriangleDeformation.tendsto_L_pi_div`:
  the limits `T` and `Tᵀ` as `p → ∞`.
* `TauCeti.TriangleDeformation.abs_cuspHeight_pi_div_sub_le`: `|b / sin (π / p) - p / π| ≤ 4π / p`.
* `TauCeti.TriangleDeformation.orderOf_pslRep_x`, `orderOf_pslRep_y` and `orderOf_pslRep_z`: the
  images of the generators have the orders `3`, `2` and `p`.

The integer powers of `U` are given by `Matrix.SpecialLinearGroup.coe_zpow_eq_cos_smul_one_add`:
`U ^ a = cos (a θ) • 1 + (sin (a θ) / sin θ) • (U - cos θ • 1)`.

## References

* Benjamin Bakker and Jacob Tsimerman, *p-torsion monodromy representations of elliptic curves
  over geometric function fields*, Annals of Mathematics 184 (2016), 709–744, §3.2 (the
  matrices `U_p`, `L_p` and the compact triangle coordinates).
-/

public section

noncomputable section

open Complex Filter Real Topology
open scoped MatrixGroups UpperHalfPlane

namespace TauCeti.TriangleDeformation

variable {θ : ℝ}

/-! ### The deformation parameter -/

/-- The deformation parameter `b θ = (1 + √(1 - 4 sin² θ)) / 2`: for `4 sin² θ ≤ 1` it is the
larger root of `b ^ 2 - b + sin² θ = 0`. It equals `1` at `θ = 0`, where the deformed matrix
`TauCeti.TriangleDeformation.U` is the unipotent `!![1, 1; 0, 1]`. -/
def b (θ : ℝ) : ℝ :=
  (1 + √(1 - 4 * Real.sin θ ^ 2)) / 2

theorem b_def (θ : ℝ) : b θ = (1 + √(1 - 4 * Real.sin θ ^ 2)) / 2 :=
  (rfl)

/-- `b θ` is a root of `b ^ 2 - b + sin² θ = 0`: `b θ (1 - b θ) = sin² θ`. -/
theorem b_mul_one_sub_b (h : 4 * Real.sin θ ^ 2 ≤ 1) : b θ * (1 - b θ) = Real.sin θ ^ 2 := by
  have hs := Real.sq_sqrt (sub_nonneg.2 h)
  rw [b_def]
  linear_combination (-1 / 4 : ℝ) * hs

/-- `2 b θ - 1 = √(1 - 4 sin² θ)` squares to `1 - 4 sin² θ`. -/
theorem two_mul_b_sub_one_sq (h : 4 * Real.sin θ ^ 2 ≤ 1) :
    (2 * b θ - 1) ^ 2 = 1 - 4 * Real.sin θ ^ 2 := by
  rw [b_def, show 2 * ((1 + √(1 - 4 * Real.sin θ ^ 2)) / 2) - 1 = √(1 - 4 * Real.sin θ ^ 2) by
    ring, Real.sq_sqrt (sub_nonneg.2 h)]

theorem one_half_le_b (θ : ℝ) : 1 / 2 ≤ b θ := by
  rw [b_def]
  linarith [Real.sqrt_nonneg (1 - 4 * Real.sin θ ^ 2)]

theorem b_pos (θ : ℝ) : 0 < b θ :=
  lt_of_lt_of_le (by norm_num) (one_half_le_b θ)

theorem b_le_one (θ : ℝ) : b θ ≤ 1 := by
  have : √(1 - 4 * Real.sin θ ^ 2) ≤ 1 :=
    Real.sqrt_le_one.2 (by nlinarith [sq_nonneg (Real.sin θ)])
  rw [b_def]
  linarith

/-- For `sin θ ≠ 0` the deformation parameter is less than `1`. -/
theorem b_lt_one (hθ : Real.sin θ ≠ 0) : b θ < 1 := by
  have : √(1 - 4 * Real.sin θ ^ 2) < 1 :=
    (Real.sqrt_lt' one_pos).2 (by nlinarith [sq_pos_of_ne_zero hθ])
  rw [b_def]
  linarith

/-- For `4 sin² θ < 1` the deformation parameter is greater than `1 / 2`. -/
theorem one_half_lt_b (h : 4 * Real.sin θ ^ 2 < 1) : 1 / 2 < b θ := by
  have : 0 < √(1 - 4 * Real.sin θ ^ 2) := Real.sqrt_pos.2 (by linarith)
  rw [b_def]
  linarith

@[simp]
theorem b_zero : b 0 = 1 := by
  simp [b_def]

@[fun_prop]
theorem continuous_b : Continuous b := by
  unfold b
  fun_prop

/-! ### The deformed matrices -/

/-- The deformed matrix `U θ = !![cos θ, b θ; b θ - 1, cos θ]`. At `θ = π / p` with `6 ≤ p` its
class in `PSL(2, ℝ)` has order `p` (`TauCeti.TriangleDeformation.orderOf_mk_slU`). For
`4 sin² θ ≤ 1` and `0 < sin θ` it is elliptic and fixes exactly `i (b θ / sin θ)` in `ℍ`
(`TauCeti.TriangleDeformation.slU_smul_eq_self_iff`); at `θ = 0` it is the parabolic
`T = !![1, 1; 0, 1]`. -/
def U (θ : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  !![Real.cos θ, b θ; b θ - 1, Real.cos θ]

/-- The deformed matrix `L θ = !![cos θ, b θ - 1; b θ, cos θ]`, the transpose of `U θ`
(`TauCeti.TriangleDeformation.L_eq_transpose_U`) and the conjugate `S U⁻¹ S⁻¹`
(`TauCeti.TriangleDeformation.slL_eq`). At `θ = 0` it is `!![1, 0; 1, 1]`. -/
def L (θ : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  !![Real.cos θ, b θ - 1; b θ, Real.cos θ]

theorem U_def (θ : ℝ) : U θ = !![Real.cos θ, b θ; b θ - 1, Real.cos θ] :=
  (rfl)

theorem L_def (θ : ℝ) : L θ = !![Real.cos θ, b θ - 1; b θ, Real.cos θ] :=
  (rfl)

/-- `L θ` is the transpose of `U θ`. -/
theorem L_eq_transpose_U (θ : ℝ) : L θ = (U θ).transpose := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

/-- `U θ` has determinant `cos² θ + b θ (1 - b θ) = 1` for `4 sin² θ ≤ 1`. -/
theorem det_U (h : 4 * Real.sin θ ^ 2 ≤ 1) : (U θ).det = 1 := by
  rw [U_def, Matrix.det_fin_two_of]
  linear_combination b_mul_one_sub_b h + Real.cos_sq_add_sin_sq θ

/-- `L θ` has determinant one for `4 sin² θ ≤ 1`. -/
theorem det_L (h : 4 * Real.sin θ ^ 2 ≤ 1) : (L θ).det = 1 := by
  rw [L_eq_transpose_U, Matrix.det_transpose, det_U h]

/-- `U θ` has trace `2 cos θ`. -/
@[simp]
theorem trace_U (θ : ℝ) : (U θ).trace = 2 * Real.cos θ := by
  rw [U_def, Matrix.trace_fin_two_of]
  ring

/-- `L θ` has trace `2 cos θ`. -/
@[simp]
theorem trace_L (θ : ℝ) : (L θ).trace = 2 * Real.cos θ := by
  rw [L_eq_transpose_U, Matrix.trace_transpose, trace_U]

/-- `S U θ = !![1 - b θ, -cos θ; cos θ, b θ]`. -/
theorem S_mul_U (θ : ℝ) :
    ((ModularGroup.S : SL(2, ℝ)) : Matrix (Fin 2) (Fin 2) ℝ) * U θ =
      !![1 - b θ, -Real.cos θ; Real.cos θ, b θ] := by
  rw [Matrix.SpecialLinearGroup.coe_modularGroup_S, U_def, Matrix.mul_fin_two]
  simp

/-- `S U θ` has trace `1 = 2 cos (π / 3)`, the trace of an elliptic element of order `3`. -/
theorem trace_S_mul_U (θ : ℝ) :
    (((ModularGroup.S : SL(2, ℝ)) : Matrix (Fin 2) (Fin 2) ℝ) * U θ).trace = 1 := by
  rw [S_mul_U, Matrix.trace_fin_two_of]
  ring

/-- `U θ` as an element of `SL(2, ℝ)`, for `4 sin² θ ≤ 1`. -/
def slU (h : 4 * Real.sin θ ^ 2 ≤ 1) : SL(2, ℝ) :=
  ⟨U θ, det_U h⟩

/-- `L θ` as an element of `SL(2, ℝ)`, for `4 sin² θ ≤ 1`. -/
def slL (h : 4 * Real.sin θ ^ 2 ≤ 1) : SL(2, ℝ) :=
  ⟨L θ, det_L h⟩

@[simp]
theorem coe_slU (h : 4 * Real.sin θ ^ 2 ≤ 1) : (slU h : Matrix (Fin 2) (Fin 2) ℝ) = U θ :=
  (rfl)

@[simp]
theorem coe_slL (h : 4 * Real.sin θ ^ 2 ≤ 1) : (slL h : Matrix (Fin 2) (Fin 2) ℝ) = L θ :=
  (rfl)

/-- **`L` is a conjugate of `U⁻¹`**: `L θ = S U θ⁻¹ S⁻¹`. -/
theorem slL_eq (h : 4 * Real.sin θ ^ 2 ≤ 1) :
    slL h = ModularGroup.S * (slU h)⁻¹ * (ModularGroup.S : SL(2, ℝ))⁻¹ := by
  ext i j
  simp only [coe_slL, Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv,
    coe_slU, Matrix.SpecialLinearGroup.coe_modularGroup_S, L_def, U_def,
    Matrix.adjugate_fin_two_of]
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

/-! ### The relations of `Δ(3, 2, p)` -/

/-- **`U (π / p)` has order `p` up to sign**: `U (π / p) ^ p = -1` for `2 ≤ p`. -/
theorem slU_pow_eq_neg_one {p : ℕ} (hp : 2 ≤ p) (h : 4 * Real.sin (π / p) ^ 2 ≤ 1) :
    slU h ^ p = -1 :=
  Subtype.ext (by
    rw [Matrix.SpecialLinearGroup.coe_pow, Matrix.SpecialLinearGroup.coe_neg,
      Matrix.SpecialLinearGroup.coe_one, coe_slU]
    exact Matrix.pow_eq_neg_one_of_trace_eq_two_mul_cos_pi_div (det_U h) hp (trace_U _))

/-- The trace of `S U θ` is `2 cos (π / 3)`. -/
private theorem trace_S_mul_slU (h : 4 * Real.sin θ ^ 2 ≤ 1) :
    (((ModularGroup.S * slU h : SL(2, ℝ))) : Matrix (Fin 2) (Fin 2) ℝ).trace =
      2 * Real.cos (π / (3 : ℕ)) := by
  rw [Matrix.SpecialLinearGroup.coe_mul, coe_slU, trace_S_mul_U, Nat.cast_ofNat,
    Real.cos_pi_div_three]
  norm_num

/-- **`S U θ` has order `3` up to sign**: `(S U θ) ^ 3 = -1`. -/
theorem S_mul_slU_pow_three_eq_neg_one (h : 4 * Real.sin θ ^ 2 ≤ 1) :
    ((ModularGroup.S : SL(2, ℝ)) * slU h) ^ 3 = -1 :=
  Subtype.ext (by
    rw [Matrix.SpecialLinearGroup.coe_pow, Matrix.SpecialLinearGroup.coe_neg,
      Matrix.SpecialLinearGroup.coe_one]
    exact Matrix.pow_eq_neg_one_of_trace_eq_two_mul_cos_pi_div
      (ModularGroup.S * slU h : SL(2, ℝ)).det_coe (by norm_num)
      (by exact_mod_cast trace_S_mul_slU h))

/-- The class of `U (π / p)` in `PSL(2, ℝ)` has order exactly `p`, for `2 ≤ p`. -/
theorem orderOf_mk_slU {p : ℕ} (hp : 2 ≤ p) (h : 4 * Real.sin (π / p) ^ 2 ≤ 1) :
    orderOf (slU h : PSL(2, ℝ)) = p :=
  Matrix.ProjectiveSpecialLinearGroup.orderOf_mk_of_trace_sq_eq_two_mul_cos_pi_div_sq hp
    (by rw [coe_slU, trace_U])

/-- The class of `S U θ` in `PSL(2, ℝ)` has order exactly `3`. -/
theorem orderOf_mk_S_mul_slU (h : 4 * Real.sin θ ^ 2 ≤ 1) :
    orderOf (((ModularGroup.S : SL(2, ℝ)) * slU h : SL(2, ℝ)) : PSL(2, ℝ)) = 3 :=
  Matrix.ProjectiveSpecialLinearGroup.orderOf_mk_of_trace_sq_eq_two_mul_cos_pi_div_sq
    (by norm_num) (by rw [trace_S_mul_slU h])

/-! ### Fixed points -/

/-- The height `b θ / sin θ` of the point of `ℍ` fixed by `U θ`
(`TauCeti.TriangleDeformation.slU_smul_eq_self_iff`). At `θ = π / p` with `7 ≤ p` this is the
vertex of order `p` that replaces the cusp `∞` of the modular triangle, and it tends to `∞` as
`p → ∞`; at `p = 6` it is `1`, so the fixed point is `i`. Its square is `b θ / (1 - b θ)`,
and at `θ = π / p` it is `p / π + O(1 / p)`
(`TauCeti.TriangleDeformation.abs_cuspHeight_pi_div_sub_le`). -/
def cuspHeight (θ : ℝ) : ℝ :=
  b θ / Real.sin θ

theorem cuspHeight_def (θ : ℝ) : cuspHeight θ = b θ / Real.sin θ :=
  (rfl)

theorem cuspHeight_pos (hθ : 0 < Real.sin θ) : 0 < cuspHeight θ :=
  div_pos (b_pos θ) hθ

theorem cuspHeight_sq (h : 4 * Real.sin θ ^ 2 ≤ 1) (hθ : Real.sin θ ≠ 0) :
    cuspHeight θ ^ 2 = b θ / (1 - b θ) := by
  have h₁ : 1 - b θ ≠ 0 := (sub_pos.2 (b_lt_one hθ)).ne'
  rw [cuspHeight_def, div_pow, ← b_mul_one_sub_b h]
  field_simp

/-- For `4 sin² θ < 1` and `sin θ > 0` the fixed point of `U θ` lies above `i`. -/
theorem one_lt_cuspHeight (h : 4 * Real.sin θ ^ 2 < 1) (hθ : 0 < Real.sin θ) :
    1 < cuspHeight θ := by
  rw [cuspHeight_def, one_lt_div hθ]
  nlinarith [one_half_lt_b h]

/-- **The fixed point of `U θ`.** For `0 < sin θ` and `4 sin² θ ≤ 1`, the only point of `ℍ` fixed
by `U θ` is `i (b θ / sin θ)`. -/
theorem slU_smul_eq_self_iff (h : 4 * Real.sin θ ^ 2 ≤ 1) (hθ : 0 < Real.sin θ) (z : ℍ) :
    slU h • z = z ↔ (z : ℂ) = cuspHeight θ * I := by
  have hell : (Matrix.SpecialLinearGroup.mapGL ℝ (slU h)).IsElliptic := by
    refine (Matrix.isElliptic_iff_abs_trace_lt_two (slU h).det_coe).2 ?_
    rw [coe_slU, trace_U, abs_lt]
    constructor <;> nlinarith [Real.cos_sq_add_sin_sq θ]
  -- `w = i y` with `y = b / sin θ` is fixed, and an elliptic element fixes only one point
  let w : ℍ := ⟨cuspHeight θ * I, by simpa using cuspHeight_pos hθ⟩
  have hw : slU h • w = w := by
    have hy : (1 - (b θ : ℂ)) * (cuspHeight θ : ℂ) ^ 2 = b θ := by
      have := cuspHeight_sq h hθ.ne'
      rw [eq_div_iff (sub_pos.2 (b_lt_one hθ.ne')).ne'] at this
      exact_mod_cast (mul_comm _ _).trans this
    have hden : ((b θ - 1 : ℝ) : ℂ) * (cuspHeight θ * I) + (Real.cos θ : ℝ) ≠ 0 := fun h0 ↦ by
      have := congrArg Complex.im h0
      simp only [add_im, mul_im, ofReal_re, ofReal_im, I_re, I_im, zero_mul, add_zero, zero_im,
        mul_zero, mul_one] at this
      nlinarith [b_lt_one hθ.ne', cuspHeight_pos hθ]
    rw [UpperHalfPlane.ext_iff, UpperHalfPlane.coe_specialLinearGroup_apply]
    simp only [Algebra.algebraMap_self, RingHom.id_apply, coe_slU, U_def, Matrix.of_apply,
      Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
    rw [div_eq_iff hden, ofReal_sub, ofReal_one]
    linear_combination (-1) * hy - ((b θ : ℂ) - 1) * (cuspHeight θ : ℂ) ^ 2 * I_sq
  rw [Matrix.SpecialLinearGroup.smul_eq_self_iff_of_isElliptic hell hw, UpperHalfPlane.ext_iff,
    UpperHalfPlane.coe_mk]

/-- **The fixed point of `S U θ`.** For `0 < cos θ` and `4 sin² θ ≤ 1`, the only point of `ℍ`
fixed by `S U θ` is `(1 - 2 b θ + i √3) / (2 cos θ)`. -/
theorem S_mul_slU_smul_eq_self_iff (h : 4 * Real.sin θ ^ 2 ≤ 1) (hc : 0 < Real.cos θ) (z : ℍ) :
    ((ModularGroup.S : SL(2, ℝ)) * slU h) • z = z ↔
      (z : ℂ) = ((1 - 2 * b θ : ℝ) + √3 * I) / (2 * Real.cos θ : ℝ) := by
  have hell :
      (Matrix.SpecialLinearGroup.mapGL ℝ ((ModularGroup.S : SL(2, ℝ)) * slU h)).IsElliptic :=
    (Matrix.isElliptic_iff_abs_trace_lt_two (ModularGroup.S * slU h : SL(2, ℝ)).det_coe).2 (by
      rw [Matrix.SpecialLinearGroup.coe_mul, coe_slU, trace_S_mul_U]
      norm_num)
  have him : 0 < (((1 - 2 * b θ : ℝ) + √3 * I) / (2 * Real.cos θ : ℝ) : ℂ).im := by
    rw [Complex.div_ofReal_im]
    simp only [add_im, ofReal_im, mul_im, ofReal_re, I_im, I_re, mul_zero, zero_add, mul_one]
    positivity
  -- `w = (1 - 2 b + i √3) / (2 cos θ)` is fixed, and an elliptic element fixes only one point
  let w : ℍ := ⟨_, him⟩
  have hw : ((ModularGroup.S : SL(2, ℝ)) * slU h) • w = w := by
    have h3 : (√3 : ℂ) ^ 2 = 3 := by exact_mod_cast Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)
    -- `(2 b - 1) ^ 2 = 1 - 4 sin² θ = 4 cos² θ - 3`
    have hq : (2 * (b θ : ℂ) - 1) ^ 2 = 4 * (Real.cos θ : ℂ) ^ 2 - 3 := by
      have := two_mul_b_sub_one_sq h
      have hcs := Real.cos_sq_add_sin_sq θ
      exact_mod_cast (by linear_combination this - 4 * hcs :
        (2 * b θ - 1) ^ 2 = 4 * Real.cos θ ^ 2 - 3)
    have hc' : (Real.cos θ : ℂ) ≠ 0 := by exact_mod_cast hc.ne'
    have hden : ((Real.cos θ : ℝ) : ℂ) * (w : ℂ) + (b θ : ℝ) ≠ 0 := fun h0 ↦ by
      have := congrArg Complex.im h0
      simp only [add_im, mul_im, ofReal_re, ofReal_im, zero_mul, add_zero, zero_im] at this
      nlinarith [w.im_pos]
    rw [UpperHalfPlane.ext_iff, UpperHalfPlane.coe_specialLinearGroup_apply,
      Matrix.SpecialLinearGroup.coe_mul, coe_slU, S_mul_U]
    simp only [Algebra.algebraMap_self, RingHom.id_apply, Matrix.of_apply, Matrix.cons_val',
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
    rw [div_eq_iff hden]
    simp only [w, ofReal_sub, ofReal_one, ofReal_neg, ofReal_mul,
      ofReal_ofNat]
    field_simp
    linear_combination hq - I ^ 2 * h3 - 3 * I_sq
  rw [Matrix.SpecialLinearGroup.smul_eq_self_iff_of_isElliptic hell hw, UpperHalfPlane.ext_iff,
    UpperHalfPlane.coe_mk]

/-! ### Limits as `p → ∞` -/

@[fun_prop]
theorem continuous_U : Continuous U :=
  continuous_matrix fun i j ↦ by
    fin_cases i <;> fin_cases j
    exacts [Real.continuous_cos, continuous_b, continuous_b.sub continuous_const,
      Real.continuous_cos]

@[fun_prop]
theorem continuous_L : Continuous L :=
  continuous_U.matrix_transpose.congr fun θ ↦ (L_eq_transpose_U θ).symm

@[simp]
theorem U_zero : U 0 = !![1, 1; 0, 1] := by
  simp [U_def]

@[simp]
theorem L_zero : L 0 = !![1, 0; 1, 1] := by
  rw [L_eq_transpose_U, U_zero]
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

/-- **`U (π / p)` tends to `T`**: as `p → ∞` the deformed matrix converges to the parabolic
`!![1, 1; 0, 1]`. -/
theorem tendsto_U_pi_div : Tendsto (fun p : ℕ ↦ U (π / p)) atTop (𝓝 !![1, 1; 0, 1]) := by
  rw [← U_zero]
  exact (continuous_U.tendsto 0).comp (tendsto_const_div_atTop_nhds_zero_nat π)

/-- **`L (π / p)` tends to `Tᵀ`**: as `p → ∞` the deformed matrix converges to the parabolic
`!![1, 0; 1, 1]`. -/
theorem tendsto_L_pi_div : Tendsto (fun p : ℕ ↦ L (π / p)) atTop (𝓝 !![1, 0; 1, 1]) := by
  rw [← L_zero]
  exact (continuous_L.tendsto 0).comp (tendsto_const_div_atTop_nhds_zero_nat π)

/-- The height of the fixed point of `U θ` is `1 / θ` up to `4 θ`, for `0 < θ ≤ 1` with
`4 sin² θ ≤ 1`. -/
theorem abs_cuspHeight_sub_inv_le (h₀ : 0 < θ) (h₁ : θ ≤ 1) (h : 4 * Real.sin θ ^ 2 ≤ 1) :
    |cuspHeight θ - θ⁻¹| ≤ 4 * θ := by
  have hs := Real.sin_lt h₀
  have hs' := Real.sin_gt_sub_cube h₀
  have hθ2 : θ ^ 2 ≤ 1 := by nlinarith
  have hθ3 : θ ^ 3 ≤ θ := by nlinarith [mul_le_mul_of_nonneg_left hθ2 h₀.le]
  have hspos : 0 < Real.sin θ := by linarith
  have hsθ : 5 / 6 * θ ≤ Real.sin θ := by linarith
  have hb₂ := one_half_le_b θ
  have hb₁ := b_le_one θ
  -- `(1 - b) / 2 ≤ b (1 - b) = sin² θ ≤ θ ^ 2`
  have hb' : 1 - b θ ≤ 2 * θ ^ 2 := by
    nlinarith [mul_le_mul_of_nonneg_right hb₂ (sub_nonneg.2 hb₁), b_mul_one_sub_b h,
      pow_le_pow_left₀ hspos.le hs.le 2]
  have hup : b θ * θ ≤ θ := by nlinarith [mul_le_mul_of_nonneg_right hb₁ h₀.le]
  have hlow : (1 - 2 * θ ^ 2) * θ ≤ b θ * θ := mul_le_mul_of_nonneg_right (by linarith) h₀.le
  have hden : 10 / 3 * θ ^ 3 ≤ 4 * θ * (Real.sin θ * θ) := by
    nlinarith [mul_le_mul_of_nonneg_left hsθ (by positivity : (0 : ℝ) ≤ 4 * θ ^ 2)]
  rw [cuspHeight_def, inv_eq_one_div, div_sub_div _ _ hspos.ne' h₀.ne', abs_div,
    abs_of_pos (mul_pos hspos h₀), div_le_iff₀ (mul_pos hspos h₀), abs_le]
  constructor <;> nlinarith

/-- For `6 ≤ p`, `sin (π / p) ≤ sin (π / 6) = 1 / 2`, so the deformation at `θ = π / p` is
defined. -/
theorem four_mul_sin_pi_div_sq_le_one {p : ℕ} (hp : 6 ≤ p) :
    4 * Real.sin (π / p) ^ 2 ≤ 1 := by
  have hp₀ : (0 : ℝ) < p := by positivity
  have hle : π / p ≤ π / 6 := div_le_div_of_nonneg_left pi_pos.le (by norm_num)
    (by exact_mod_cast hp)
  have h₀ : 0 ≤ Real.sin (π / p) := Real.sin_nonneg_of_nonneg_of_le_pi (by positivity)
    (by linarith [div_le_self pi_pos.le (by exact_mod_cast (show 1 ≤ p by omega) : (1 : ℝ) ≤ p)])
  have h₁ : Real.sin (π / p) ≤ 1 / 2 := by
    rw [← Real.sin_pi_div_six]
    exact Real.sin_le_sin_of_le_of_le_pi_div_two (by linarith [pi_pos, div_pos pi_pos hp₀])
      (by linarith [pi_pos]) hle
  nlinarith

/-- **The fixed point of `U (π / p)` is at height `p / π + O(1 / p)`**: for `6 ≤ p`,
`|b (π / p) / sin (π / p) - p / π| ≤ 4π / p`. -/
theorem abs_cuspHeight_pi_div_sub_le {p : ℕ} (hp : 6 ≤ p) :
    |cuspHeight (π / p) - p / π| ≤ 4 * π / p := by
  have hp₀ : (0 : ℝ) < p := by positivity
  have h₁ : π / p ≤ 1 := by
    have h6 : (6 : ℝ) ≤ p := by exact_mod_cast hp
    rw [div_le_one hp₀]
    linarith [Real.pi_le_four]
  have := abs_cuspHeight_sub_inv_le (div_pos pi_pos hp₀) h₁ (four_mul_sin_pi_div_sq_le_one hp)
  rwa [inv_div, mul_div_assoc'] at this

/-! ### The representation of `Δ(3, 2, p)` -/

/-- The relation `(S U) ^ 3 = 1` in `PSL(2, ℝ)`. -/
private theorem mk_S_mul_slU_pow_three (h : 4 * Real.sin θ ^ 2 ≤ 1) :
    (((ModularGroup.S : SL(2, ℝ)) * slU h : SL(2, ℝ)) : PSL(2, ℝ)) ^ 3 = 1 := by
  rw [← QuotientGroup.mk_pow, S_mul_slU_pow_three_eq_neg_one,
    Matrix.ProjectiveSpecialLinearGroup.mk_neg, QuotientGroup.mk_one]

/-- The relation `(U⁻¹) ^ p = 1` in `PSL(2, ℝ)`. -/
private theorem mk_slU_inv_pow {p : ℕ} (hp : 2 ≤ p) (h : 4 * Real.sin (π / p) ^ 2 ≤ 1) :
    ((slU h : PSL(2, ℝ)))⁻¹ ^ p = 1 := by
  rw [inv_pow, ← QuotientGroup.mk_pow, slU_pow_eq_neg_one hp,
    Matrix.ProjectiveSpecialLinearGroup.mk_neg, QuotientGroup.mk_one, inv_one]

/-- The product relation `U⁻¹ S (S U) = U⁻¹ S² U = 1` in `PSL(2, ℝ)`. -/
private theorem mk_slU_inv_mul_pslS_mul (h : 4 * Real.sin θ ^ 2 ≤ 1) :
    ((slU h : PSL(2, ℝ)))⁻¹ * TauCeti.pslS *
      (((ModularGroup.S : SL(2, ℝ)) * slU h : SL(2, ℝ)) : PSL(2, ℝ)) = 1 := by
  rw [QuotientGroup.mk_mul, ← TauCeti.pslS_eq_mk, mul_assoc, ← mul_assoc TauCeti.pslS,
    TauCeti.pslS_mul_self, one_mul, inv_mul_cancel]

/-- **The deformed representation of `Δ(3, 2, p)`.** For `6 ≤ p`, the homomorphism
`Δ(3, 2, p) →* PSL(2, ℝ)` sending `x`, `y`, `z` to the classes of `S U`, `S` and `U⁻¹`, where
`U = U (π / p)`. The images have the exact orders `3`, `2` and `p`. For `7 ≤ p` this is meant to
be the faithful representation of the hyperbolic triangle group (not proved here); at `p = 6`
all three images fix `i` and the image is finite. -/
def pslRep (p : ℕ) (hp : 6 ≤ p) : TriangleGroup 3 2 p →* PSL(2, ℝ) :=
  have h := four_mul_sin_pi_div_sq_le_one hp
  TriangleGroup.lift (((ModularGroup.S : SL(2, ℝ)) * slU h : SL(2, ℝ)) : PSL(2, ℝ))
    TauCeti.pslS ((slU h : PSL(2, ℝ))⁻¹) (mk_S_mul_slU_pow_three h)
    (by rw [pow_two, TauCeti.pslS_mul_self]) (mk_slU_inv_pow (by omega) h)
    (mk_slU_inv_mul_pslS_mul h)

@[simp]
theorem pslRep_x {p : ℕ} (hp : 6 ≤ p) :
    pslRep p hp (TriangleGroup.x 3 2 p) =
      (((ModularGroup.S : SL(2, ℝ)) * slU (four_mul_sin_pi_div_sq_le_one hp) : SL(2, ℝ)) :
        PSL(2, ℝ)) :=
  TriangleGroup.lift_x ..

@[simp]
theorem pslRep_y {p : ℕ} (hp : 6 ≤ p) : pslRep p hp (TriangleGroup.y 3 2 p) = TauCeti.pslS :=
  TriangleGroup.lift_y ..

@[simp]
theorem pslRep_z {p : ℕ} (hp : 6 ≤ p) :
    pslRep p hp (TriangleGroup.z 3 2 p) =
      ((slU (four_mul_sin_pi_div_sq_le_one hp) : PSL(2, ℝ)))⁻¹ :=
  TriangleGroup.lift_z ..

/-- The image of `x` under `pslRep` has order exactly `3`. -/
theorem orderOf_pslRep_x {p : ℕ} (hp : 6 ≤ p) :
    orderOf (pslRep p hp (TriangleGroup.x 3 2 p)) = 3 := by
  rw [pslRep_x, orderOf_mk_S_mul_slU]

/-- The image of `y` under `pslRep` has order exactly `2`. -/
theorem orderOf_pslRep_y {p : ℕ} (hp : 6 ≤ p) :
    orderOf (pslRep p hp (TriangleGroup.y 3 2 p)) = 2 := by
  rw [pslRep_y, TauCeti.pslS_def, orderOf_injective _ psl2zToPSL2R_injective,
    TauCeti.ModularGroup.orderOf_coe_S]

/-- The image of `z` under `pslRep` has order exactly `p`. -/
theorem orderOf_pslRep_z {p : ℕ} (hp : 6 ≤ p) :
    orderOf (pslRep p hp (TriangleGroup.z 3 2 p)) = p := by
  rw [pslRep_z, orderOf_inv, orderOf_mk_slU (by omega)]

end TauCeti.TriangleDeformation
