module

public import TauCeti.Analysis.Complex.Fuchsian.LevelOne.Basic
public import TauCeti.Analysis.Complex.Fuchsian.Cusp.Extension
import Mathlib.NumberTheory.Modular
import TauCeti.Analysis.Complex.UpperHalfPlane.PSL.Translation

/-!
# The normalized level-one cusp

The cusp at infinity of the effective modular group has width one in the identity scaling.
Its full stabilizer is generated by the image of the translation matrix `T`. The resulting
normalized datum identifies the compactification's cusp coordinate with the usual modular
parameter `q = exp (2πiτ)`, allowing modular q-expansions to be read in the surface chart.

## References

* Fred Diamond and Jerry Shurman, *A First Course in Modular Forms*, §§2.3–2.4.
-/

public noncomputable section

open Matrix Matrix.ProjectiveSpecialLinearGroup MulAction OnePoint Subgroup UpperHalfPlane
  TauCeti.UpperHalfPlane
open scoped MatrixGroups

namespace TauCeti.ModularGroup

/-- The normalized cusp datum at infinity for the effective level-one modular group: identity
scaling, width one, and the image of `T` as primitive positive generator. -/
def cuspDatumInfty : psl2zToPSL2R.range.CuspDatum := by
  let γ : psl2zToPSL2R.range :=
    ⟨psl2zToPSL2R (_root_.ModularGroup.T : PSL(2, ℤ)), _, rfl⟩
  have hγ : (γ : PSL(2, ℝ)) = upperRightHom 1 := by
    apply eq_of_smul_eq_smul (α := ℍ)
    intro z
    calc
      (γ : PSL(2, ℝ)) • z = _root_.ModularGroup.T • z :=
        (UpperHalfPlane.psl2zToPSL2R_smul _ z).trans
          (UpperHalfPlane.pslMk_smul _ z)
      _ = upperRightHom (1 : ℝ) • z := by
        rw [upperRightHom_smul]
        apply UpperHalfPlane.ext
        simpa [coe_vadd, add_comm] using
          (_root_.ModularGroup.coe_T_zpow_smul_eq z (n := 1))
  refine ⟨∞, 1, γ, 1, zero_lt_one, le_antisymm ?_ ?_, by simpa using hγ⟩
  · apply zpowers_le.mpr
    rw [mem_stabilizer_iff, Subgroup.smul_def, hγ]
    exact upperRightHom_smul_infty 1
  · intro g hg
    obtain ⟨p, hp⟩ := g.property
    induction p using QuotientGroup.induction_on with
    | H a =>
      have hfix : Matrix.SpecialLinearGroup.toGL
          (Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) a) •
          (∞ : OnePoint ℝ) = ∞ := by
        have h := mem_stabilizer_iff.mp hg
        rw [Subgroup.smul_def, ← hp, psl2zToPSL2R_mk, sl2zToPSL2R_apply,
          OnePoint.pslMk_smul] at h
        exact h
      have hc : a 1 0 = 0 := by
        rw [OnePoint.smul_infty_eq_self_iff, Matrix.SpecialLinearGroup.coe_GL_coe_matrix] at hfix
        simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply,
          Matrix.map_apply, Int.coe_castRingHom] at hfix
        exact_mod_cast hfix
      obtain ⟨n, hn⟩ := _root_.ModularGroup.exists_eq_T_zpow_of_c_eq_zero hc
      apply mem_zpowers_iff.mpr
      refine ⟨n, Subtype.ext ?_⟩
      apply eq_of_smul_eq_smul (α := ℍ)
      intro z
      rw [Subgroup.coe_zpow, ← hp, ← map_zpow]
      simp only [psl2zToPSL2R_smul, UpperHalfPlane.pslMk_smul]
      exact (hn z).symm

@[simp]
theorem cuspDatumInfty_cusp : cuspDatumInfty.cusp = (∞ : OnePoint ℝ) := (rfl)

@[simp]
theorem cuspDatumInfty_scaling : cuspDatumInfty.scaling = 1 := (rfl)

@[simp]
theorem cuspDatumInfty_width : cuspDatumInfty.width = 1 := (rfl)

@[simp]
theorem cuspDatumInfty_generator :
    (cuspDatumInfty.generator : PSL(2, ℝ)) =
      psl2zToPSL2R (_root_.ModularGroup.T : PSL(2, ℤ)) := (rfl)

/-- The surface cusp coordinate for the normalized modular datum is the usual width-one
q-parameter. -/
@[simp]
theorem coordinate_cuspDatumInfty (z : ℍ) :
    TauCeti.Subgroup.CuspDatum.coordinate cuspDatumInfty z = Function.Periodic.qParam 1 z := by
  simp [TauCeti.Subgroup.CuspDatum.coordinate_apply]

/-- Reading a function in the normalized modular cusp datum gives its usual width-one cusp
function. -/
@[simp]
theorem cuspExtension_cuspDatumInfty (f : ℍ → ℂ) :
    TauCeti.Subgroup.CuspDatum.cuspExtension cuspDatumInfty f = cuspFunction 1 f := by
  simp [TauCeti.Subgroup.CuspDatum.cuspExtension_def]

end TauCeti.ModularGroup
