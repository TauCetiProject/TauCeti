/-!
# The prime-end compactification

The **prime-end compactification** of a plane set `U` adjoins to `U` its prime ends. It carries
Carathéodory's topology: for open `U`, a point of `U` has its usual neighbourhoods, and a prime
end `p` has as basic neighbourhoods a domain `D` cut off by a chain representing `p`, together
with the prime ends having a domain inside `D`. Carathéodory's prime-end theorem says that a
conformal map of the unit disc onto a bounded simply connected domain extends to a homeomorphism
of the closed disc onto the prime-end compactification of the domain; this file sets up the space
and proves the case of the disc itself.

The topology is described uniformly through filters on `ℂ`. Each point `x` of the
compactification has a filter `x.toFilter`: the principal ultrafilter at a point of `U`, and the
filter `PrimeEnd.domainFilter` of the domains of a prime end. The topology is generated by the
sets `{x | V ∈ x.toFilter}` for open `V ⊆ ℂ`, and these sets form a basis of the neighbourhoods
of each point (`TauCeti.PrimeEndCompactification.hasBasis_nhds`). For an open set `U`, the
inclusion of `U` is an open embedding with dense range, and a family of points of `U` converges to
a prime end exactly when it eventually enters each domain of that prime end.

For the unit disc, the filter of the prime end at a point `ζ` of the circle is the neighbourhood
filter of `ζ` within the disc (`TauCeti.domainFilter_unitDiscPrimeEnd`). The map sending a point
of the open disc to itself and a point of the circle to its prime end is therefore a continuous
bijection from the closed disc onto a Hausdorff space, hence a homeomorphism.

## Main declarations

* `TauCeti.PrimeEndCompactification` -- the points of `U` together with its prime ends.
* `TauCeti.PrimeEndCompactification.toFilter` -- the filter on `ℂ` of a point.
* `TauCeti.PrimeEndCompactification.hasBasis_nhds` -- the basic neighbourhoods of a point.
* `TauCeti.PrimeEndCompactification.isOpenEmbedding_point`,
  `TauCeti.PrimeEndCompactification.denseRange_point` -- an open set embeds as an open dense
  subspace.
* `TauCeti.PrimeEndCompactification.tendsto_point_nhds_primeEnd_iff` -- convergence to a prime
  end.
* `TauCeti.closedBallHomeomorphPrimeEndCompactification` -- the closed unit disc is homeomorphic
  to the prime-end compactification of the open disc.

## References

* Ch. Pommerenke, *Boundary Behaviour of Conformal Maps*, Chapter 2.
* C. Carathéodory, *Über die Begrenzung einfach zusammenhängender Gebiete*, Math. Ann. 73
  (1913).
-/

public section

noncomputable section

open Filter Metric Set Topology

namespace TauCeti

/-- The **prime-end compactification** of a plane set `U`: the points of `U` together with the
prime ends of `U`. -/
inductive PrimeEndCompactification (U : Set ℂ) : Type
  /-- A point of `U`. -/
  | point (z : U)
  /-- A prime end of `U`. -/
  | primeEnd (p : PrimeEnd U)

namespace PrimeEndCompactification

variable {U : Set ℂ}

/-- The filter on `ℂ` of a point of the prime-end compactification: the principal ultrafilter at
a point of `U`, and the filter of the domains of a prime end. -/
def toFilter : PrimeEndCompactification U → Filter ℂ
  | point z => pure (z : ℂ)
  | primeEnd p => p.domainFilter

@[simp]
theorem toFilter_point (z : U) : (point z).toFilter = pure (z : ℂ) :=
  (rfl)

@[simp]
theorem toFilter_primeEnd (p : PrimeEnd U) : (primeEnd p).toFilter = p.domainFilter :=
  (rfl)

/-- The filter of a point of the prime-end compactification is proper. -/
instance neBot_toFilter (x : PrimeEndCompactification U) : x.toFilter.NeBot := by
  cases x with
  | point z => rw [toFilter_point]; infer_instance
  | primeEnd p => rw [toFilter_primeEnd]; infer_instance

/-- The filter of every point of the prime-end compactification of `U` lives on `U`. -/
theorem toFilter_le_principal (x : PrimeEndCompactification U) : x.toFilter ≤ 𝓟 U := by
  cases x with
  | point z => simp
  | primeEnd p => simpa using p.domainFilter_le_principal

/-- No point of the prime-end compactification has two disjoint sets in its filter. -/
theorem disjoint_setOf_mem_toFilter {V W : Set ℂ} (h : Disjoint V W) :
    Disjoint {x : PrimeEndCompactification U | V ∈ x.toFilter} {x | W ∈ x.toFilter} :=
  disjoint_left.mpr fun x hV hW => (x.toFilter).empty_notMem (h.inter_eq ▸ inter_mem hV hW)

/-- The topology of the prime-end compactification, generated by the sets of points whose
filters contain a given open subset of `ℂ`. -/
instance : TopologicalSpace (PrimeEndCompactification U) :=
  .generateFrom {s | ∃ V : Set ℂ, IsOpen V ∧ s = {x | V ∈ x.toFilter}}

/-- For an open `V ⊆ ℂ`, the points whose filters contain `V` form an open set. -/
theorem isOpen_setOf_mem_toFilter {V : Set ℂ} (hV : IsOpen V) :
    IsOpen {x : PrimeEndCompactification U | V ∈ x.toFilter} :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨V, hV, rfl⟩

/-- The sets of points whose filters contain a given open subset of `ℂ` form a basis of the
topology: they are closed under intersection and include `univ`. -/
private theorem isTopologicalBasis :
    TopologicalSpace.IsTopologicalBasis {s : Set (PrimeEndCompactification U) |
      ∃ V : Set ℂ, IsOpen V ∧ s = {x | V ∈ x.toFilter}} := by
  have h := TopologicalSpace.isTopologicalBasis_of_subbasis_of_inter
    (t := (inferInstance : TopologicalSpace (PrimeEndCompactification U))) rfl ?_
  · have huniv : (univ : Set (PrimeEndCompactification U)) ∈
        {s | ∃ V : Set ℂ, IsOpen V ∧ s = {x | V ∈ x.toFilter}} :=
      ⟨univ, isOpen_univ, by simp⟩
    rwa [insert_eq_of_mem huniv] at h
  rintro _ ⟨V, hV, rfl⟩ _ ⟨W, hW, rfl⟩
  exact ⟨V ∩ W, hV.inter hW, by ext; simp [inter_mem_iff]⟩

/-- **The basic neighbourhoods.** The neighbourhoods of a point `x` of the prime-end
compactification have a basis consisting of the sets of points whose filters contain `V`, for
`V ⊆ ℂ` open and belonging to the filter of `x`. -/
theorem hasBasis_nhds (x : PrimeEndCompactification U) :
    (𝓝 x).HasBasis (fun V : Set ℂ => IsOpen V ∧ V ∈ x.toFilter)
      fun V => {y | V ∈ y.toFilter} := by
  refine ⟨fun t => isTopologicalBasis.mem_nhds_iff.trans ⟨?_, ?_⟩⟩
  · rintro ⟨_, ⟨V, hV, rfl⟩, hx, ht⟩
    exact ⟨V, ⟨hV, hx⟩, ht⟩
  · rintro ⟨V, ⟨hV, hx⟩, ht⟩
    exact ⟨_, ⟨V, hV, rfl⟩, hx, ht⟩

/-- The inclusion of `U` into its prime-end compactification is continuous. -/
@[fun_prop]
theorem continuous_point : Continuous (point : U → PrimeEndCompactification U) := by
  refine continuous_generateFrom_iff.mpr ?_
  rintro _ ⟨V, hV, rfl⟩
  have h : (point : U → PrimeEndCompactification U) ⁻¹' {x | V ∈ x.toFilter} =
      Subtype.val ⁻¹' V := by
    ext
    simp
  exact h ▸ hV.preimage continuous_subtype_val

/-- The inclusion of an open set into its prime-end compactification is an open map: near a point
of `U`, the compactification consists of points of `U`. -/
theorem isOpenMap_point (hU : IsOpen U) : IsOpenMap (point : U → PrimeEndCompactification U) := by
  intro W hW
  obtain ⟨O, hO, rfl⟩ := isOpen_induced_iff.mp hW
  refine isOpen_iff_mem_nhds.mpr ?_
  rintro _ ⟨z, hzO, rfl⟩
  obtain ⟨ε, hε, hεO⟩ := Metric.isOpen_iff.mp (hO.inter hU) (z : ℂ) ⟨hzO, z.2⟩
  -- the ball of radius `ε / 2` is compactly contained in `U`, so no prime end has a domain in it
  refine (hasBasis_nhds _).mem_iff.mpr ⟨ball (z : ℂ) (ε / 2),
    ⟨isOpen_ball, by simp [hε]⟩, ?_⟩
  have hsub : closedBall (z : ℂ) (ε / 2) ⊆ O ∩ U :=
    (closedBall_subset_ball (half_lt_self hε)).trans hεO
  rintro (w | p) hw
  · exact ⟨w, (hsub (ball_subset_closedBall (by simpa using hw))).1, rfl⟩
  · exact (p.notMem_domainFilter_of_isCompact hU (isCompact_closedBall _ _)
      (hsub.trans inter_subset_right) (mem_of_superset hw ball_subset_closedBall)).elim

/-- **An open set is an open subspace of its prime-end compactification.** -/
theorem isOpenEmbedding_point (hU : IsOpen U) :
    IsOpenEmbedding (point : U → PrimeEndCompactification U) :=
  .of_continuous_injective_isOpenMap continuous_point (fun _ _ h => point.inj h)
    (isOpenMap_point hU)

/-- **`U` is dense in its prime-end compactification.** -/
theorem denseRange_point : DenseRange (point : U → PrimeEndCompactification U) := by
  refine fun x => (mem_closure_iff_nhds_basis (hasBasis_nhds x)).mpr fun V ⟨_, hVx⟩ => ?_
  obtain ⟨w, hwV, hwU⟩ :=
    (x.toFilter).nonempty_of_mem (inter_mem hVx (le_principal_iff.mp (toFilter_le_principal x)))
  exact ⟨point ⟨w, hwU⟩, mem_range_self _, by simpa using hwV⟩

/-- **Convergence to a prime end.** In an open set `U`, points of `U` converge to a prime end `p`
of `U` in the prime-end compactification exactly when they converge along the filter of `p`, that
is, when they eventually enter each domain cut off by a chain representing `p`. -/
theorem tendsto_point_nhds_primeEnd_iff (hU : IsOpen U) {α : Type*} {l : Filter α}
    {f : α → U} {p : PrimeEnd U} :
    Tendsto (fun a => point (f a)) l (𝓝 (primeEnd p)) ↔
      Tendsto (fun a => (f a : ℂ)) l p.domainFilter := by
  rw [(hasBasis_nhds _).tendsto_right_iff, (p.hasBasis_domainFilter hU).tendsto_right_iff]
  simp

end PrimeEndCompactification

/-! ### The prime-end compactification of the unit disc -/

section UnitDisc

open PrimeEndCompactification

open scoped Classical in
/-- The point of the prime-end compactification of the unit disc at a point of the closed disc:
the point itself inside the disc, and its prime end on the circle. -/
private def ofClosedBall (z : closedBall (0 : ℂ) 1) : PrimeEndCompactification (ball (0 : ℂ) 1) :=
  if hz : (z : ℂ) ∈ ball 0 1 then point ⟨z, hz⟩ else
    primeEnd (unitDiscPrimeEnd ⟨z, mem_sphere_zero_iff_norm.mpr
      (le_antisymm (mem_closedBall_zero_iff.mp z.2) (not_lt.mp (by simpa using hz)))⟩)

/-- On open sets, the filter of the point at `z` agrees with the neighbourhood filter of `z`
within the disc. -/
private theorem mem_toFilter_ofClosedBall_iff {V : Set ℂ} (hV : IsOpen V)
    (z : closedBall (0 : ℂ) 1) :
    V ∈ (ofClosedBall z).toFilter ↔ V ∈ 𝓝[ball 0 1] (z : ℂ) := by
  unfold ofClosedBall
  split_ifs with hz
  · rw [toFilter_point, isOpen_ball.nhdsWithin_eq hz, hV.mem_nhds_iff, mem_pure]
  · rw [toFilter_primeEnd, domainFilter_unitDiscPrimeEnd]

private theorem continuous_ofClosedBall : Continuous ofClosedBall := by
  refine continuous_generateFrom_iff.mpr ?_
  rintro _ ⟨V, hV, rfl⟩
  have h : ofClosedBall ⁻¹' {x | V ∈ x.toFilter} =
      Subtype.val ⁻¹' {w : ℂ | ∀ᶠ y in 𝓝 w, y ∈ ball 0 1 → y ∈ V} := by
    ext z
    simp only [mem_preimage, mem_ofPred_eq, mem_toFilter_ofClosedBall_iff hV,
      ← eventually_nhdsWithin_iff, eventually_mem_set]
  rw [h]
  exact isOpen_setOfPred_eventually_nhds.preimage continuous_subtype_val

private theorem ofClosedBall_injective : Function.Injective ofClosedBall := by
  intro a b h
  unfold ofClosedBall at h
  split_ifs at h with ha hb hb
  · exact Subtype.ext (by simpa using h)
  · have hab := unitDiscPrimeEnd_injective (primeEnd.inj h)
    exact Subtype.ext (by simpa using hab)

private theorem ofClosedBall_surjective : Function.Surjective ofClosedBall := by
  rintro (⟨w, hw⟩ | p)
  · exact ⟨⟨w, ball_subset_closedBall hw⟩, by simp [ofClosedBall, hw]⟩
  · obtain ⟨ζ, rfl⟩ := unitDiscPrimeEnd_surjective p
    have hζ : ¬(ζ : ℂ) ∈ ball 0 1 := by simp [mem_sphere_zero_iff_norm.mp ζ.2]
    exact ⟨⟨ζ, sphere_subset_closedBall ζ.2⟩, by simp [ofClosedBall, hζ]⟩

/-- The prime-end compactification of the unit disc is Hausdorff. -/
instance : T2Space (PrimeEndCompactification (ball (0 : ℂ) 1)) := by
  refine ⟨fun x y hxy => ?_⟩
  obtain ⟨a, rfl⟩ := ofClosedBall_surjective x
  obtain ⟨b, rfl⟩ := ofClosedBall_surjective y
  have hab : 0 < dist (a : ℂ) b :=
    dist_pos.mpr fun h => hxy (congrArg ofClosedBall (Subtype.ext h))
  -- disjoint balls around `a` and `b` give disjoint basic open sets
  have hmem (c : closedBall (0 : ℂ) 1) :
      ofClosedBall c ∈ {x | ball (c : ℂ) (dist (a : ℂ) b / 2) ∈ x.toFilter} :=
    (mem_toFilter_ofClosedBall_iff isOpen_ball c).mpr
      (mem_nhdsWithin_of_mem_nhds (ball_mem_nhds _ (half_pos hab)))
  exact ⟨_, _, isOpen_setOf_mem_toFilter isOpen_ball, isOpen_setOf_mem_toFilter isOpen_ball,
    hmem a, hmem b, disjoint_setOf_mem_toFilter (ball_disjoint_ball (by linarith))⟩

/-- The prime-end compactification of the unit disc is compact. -/
instance : CompactSpace (PrimeEndCompactification (ball (0 : ℂ) 1)) :=
  have := isCompact_iff_compactSpace.mp (isCompact_closedBall (0 : ℂ) 1)
  ofClosedBall_surjective.compactSpace continuous_ofClosedBall

/-- **The prime-end compactification of the unit disc is the closed disc.** The map sending a
point of the open disc to itself and a point `ζ` of the circle to its prime end
`TauCeti.unitDiscPrimeEnd ζ` is a homeomorphism from the closed unit disc onto the prime-end
compactification of the open disc. -/
def closedBallHomeomorphPrimeEndCompactification :
    closedBall (0 : ℂ) 1 ≃ₜ PrimeEndCompactification (ball (0 : ℂ) 1) :=
  continuous_ofClosedBall.homeoOfEquivCompactToT2
    (f := .ofBijective _ ⟨ofClosedBall_injective, ofClosedBall_surjective⟩)

/-- The homeomorphism is the bijection `ofClosedBall` it is built from; `rfl` unfolds
`Continuous.homeoOfEquivCompactToT2`, whose generated `simps` lemma is not exported. -/
private theorem closedBallHomeomorphPrimeEndCompactification_apply (z : closedBall (0 : ℂ) 1) :
    closedBallHomeomorphPrimeEndCompactification z = ofClosedBall z :=
  (rfl)

/-- Inside the disc, the homeomorphism onto the prime-end compactification is the inclusion. -/
@[simp]
theorem closedBallHomeomorphPrimeEndCompactification_apply_of_mem_ball
    (z : closedBall (0 : ℂ) 1) (hz : (z : ℂ) ∈ ball 0 1) :
    closedBallHomeomorphPrimeEndCompactification z = point ⟨z, hz⟩ := by
  simp [closedBallHomeomorphPrimeEndCompactification_apply, ofClosedBall, hz]

/-- On the circle, the homeomorphism onto the prime-end compactification sends a point to its
prime end. -/
theorem closedBallHomeomorphPrimeEndCompactification_apply_of_mem_sphere
    (z : closedBall (0 : ℂ) 1) (hz : (z : ℂ) ∈ sphere 0 1) :
    closedBallHomeomorphPrimeEndCompactification z = primeEnd (unitDiscPrimeEnd ⟨z, hz⟩) := by
  have hz' : ¬(z : ℂ) ∈ ball 0 1 := by simp [mem_sphere_zero_iff_norm.mp hz]
  simp [closedBallHomeomorphPrimeEndCompactification_apply, ofClosedBall, hz']

end UnitDisc

end TauCeti

