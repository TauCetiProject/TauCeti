/-!
# The local tiling of a side-paired polygon

Let `σ` be a side pairing of a convex hyperbolic polygon `P`. Following the side pairings
predicts the tiles around each point `x` of `P`: the polygon itself, its translate
`(map i)⁻¹ • P` across each side `i` through `x`, and, at a finite vertex `x = vertex j`, the
tiles `(partialCycleMap j m)⁻¹ • P` met by following the vertex cycle of `j`. These are the
*local neighbours* `σ.localNeighbors x`.

Suppose that every finite vertex cycle satisfies the angle condition of Poincaré's polygon
theorem: the order `m` of its cycle transformation is finite and the interior angles along the
cycle add up to `2π / m`. Then the local neighbours form a local tiling by `P` in the sense of
`TauCeti.IsLocalTiling`. Along a side the polygon and its paired translate cover a neighbourhood,
and around a finite vertex the tiles met during `m` circuits of the cycle fill a full turn
without overlapping.

Ideal vertices impose no condition here: they are not points of the upper half-plane. They enter
when the generic local tiling theorems are applied, which needs tiling charts of a uniform size;
this is done in `SidePairing/HorodiscChart.lean`. Charts other than those at the points of `P`
are built from sets of tiles with pairwise disjoint interiors, and a tile of such a set through a
point `h • v`, `v ∈ P`, is a translated local neighbour of `v` as soon as the set contains all
these translates (`inv_mul_mem_localNeighbors_of_smul_mem`).

## Main definitions

* `ConvexPolygon.SidePairing.localNeighbors`: the local neighbours of a point.

## Main results

* `ConvexPolygon.SidePairing.localNeighbors_eq_range`: at a finite vertex, the local neighbours
  are the inverse partial cycle products.
* `ConvexPolygon.SidePairing.isLocalTiling`: under the angle condition at the finite vertex cycles,
  the local neighbours form a local tiling by `P`.
* `ConvexPolygon.SidePairing.closure_biUnion_localNeighbors`: the local neighbours generate the
  group generated by the side-pairing maps.
* `ConvexPolygon.SidePairing.inv_mul_mem_localNeighbors_of_smul_mem`: a tile through a translated
  point of `P`, in a set of tiles with disjoint interiors containing the translated local
  neighbours, is a translated local neighbour.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, Graduate Texts in Mathematics 91,
  Springer, 1983, §9.8 (Poincaré's theorem).
* Bernard Maskit, *On Poincaré's theorem for fundamental polygons*, Adv. Math. 7 (1971),
  219–230.
* David B. A. Epstein and Carlo Petronio, *An exposition of Poincaré's polyhedron theorem*,
  Enseign. Math. (2) 40 (1994), 113–170.
-/

public section

noncomputable section

open Set Topology UpperHalfPlane
open scoped MatrixGroups Pointwise Real

namespace TauCeti.UpperHalfPlane.ConvexPolygon.SidePairing

variable {n : ℕ} [NeZero n] {P : ConvexPolygon n} (σ : P.SidePairing)

/-- The **local neighbours** of a point `x` for the tiling by a side-paired polygon `P`: the
elements `h` such that `h • P` is one of the tiles around `x` predicted by the side pairing. They
are the identity, the inverse side-pairing map `(map i)⁻¹` for each side `i` through `x`, whose
translate of `P` lies across side `i`, and, when `x` is a finite vertex `vertex j`, the inverse
partial cycle products `(partialCycleMap j m)⁻¹`. -/
def localNeighbors (x : ℍ) : Set PSL(2, ℝ) :=
  insert 1 ((fun i ↦ (σ.map i)⁻¹) '' {i | x ∈ P.side i} ∪
    ⋃ (j : Fin n) (_ : P.vertex j = .inl x), range fun m ↦ (σ.partialCycleMap j m)⁻¹)

/-- Membership in the local neighbours. -/
@[simp]
theorem mem_localNeighbors_iff {x : ℍ} {h : PSL(2, ℝ)} :
    h ∈ σ.localNeighbors x ↔ h = 1 ∨ (∃ i, x ∈ P.side i ∧ (σ.map i)⁻¹ = h) ∨
      ∃ j m, P.vertex j = .inl x ∧ (σ.partialCycleMap j m)⁻¹ = h := by
  simp only [localNeighbors, mem_insert_iff, mem_union, mem_image, mem_ofPred_eq, mem_iUnion,
    mem_range, exists_prop, exists_and_left]

/-- The identity is a local neighbour of every point. -/
theorem one_mem_localNeighbors (x : ℍ) : 1 ∈ σ.localNeighbors x :=
  mem_insert _ _

/-- The inverse side-pairing map of a side through `x` is a local neighbour of `x`. -/
theorem inv_map_mem_localNeighbors {x : ℍ} {i : Fin n} (hx : x ∈ P.side i) :
    (σ.map i)⁻¹ ∈ σ.localNeighbors x :=
  σ.mem_localNeighbors_iff.2 (.inr (.inl ⟨i, hx, rfl⟩))

/-- At a finite vertex, the inverse partial cycle products are local neighbours. -/
theorem inv_partialCycleMap_mem_localNeighbors {j : Fin n} {x : ℍ} (hx : P.vertex j = .inl x)
    (m : ℕ) : (σ.partialCycleMap j m)⁻¹ ∈ σ.localNeighbors x :=
  σ.mem_localNeighbors_iff.2 (.inr (.inr ⟨j, m, hx, rfl⟩))

/-- An interior point of the polygon has only the identity as local neighbour. -/
theorem localNeighbors_of_mem_interior {x : ℍ} (hx : x ∈ interior P.carrier) :
    σ.localNeighbors x = {1} := by
  have hside (i : Fin n) : x ∉ P.side i := fun hi ↦
    disjoint_left.1 disjoint_interior_frontier hx (P.side_subset_frontier_carrier i hi)
  refine eq_singleton_iff_unique_mem.2 ⟨σ.one_mem_localNeighbors x, fun h hh ↦ ?_⟩
  rcases σ.mem_localNeighbors_iff.1 hh with rfl | ⟨i, hi, -⟩ | ⟨j, m, hj, -⟩
  · rfl
  · exact absurd hi (hside i)
  · exact absurd (P.mem_side_of_vertex_eq_inl hj) (hside j)

/-! ### The cycle of a finite vertex -/

/-- **The local neighbours of a finite vertex** are the inverse partial cycle products, provided
the cycle transformation there has finite order. -/
theorem localNeighbors_eq_range {j : Fin n} {x : ℍ} (hx : P.vertex j = .inl x)
    (hj : 0 < orderOf (σ.cycleMap j)) :
    σ.localNeighbors x = range fun m ↦ (σ.partialCycleMap j m)⁻¹ := by
  refine Subset.antisymm (fun h hh ↦ ?_) (range_subset_iff.2 fun m ↦
    σ.inv_partialCycleMap_mem_localNeighbors hx m)
  rcases σ.mem_localNeighbors_iff.1 hh with rfl | ⟨i, hi, rfl⟩ | ⟨j', m, hj', rfl⟩
  · exact ⟨0, by simp⟩
  · rcases P.eq_or_eq_add_one_of_vertex_eq_inl_of_mem_side hx hi with rfl | rfl
    · exact ⟨1, by simp [partialCycleMap_succ]⟩
    · -- the last step of a full turn about `vertex (i + 1)` crosses side `i`
      obtain ⟨T, hT⟩ : ∃ T, orderOf (σ.cycleMap (i + 1)) * σ.cycleLength (i + 1) = T + 1 :=
        Nat.exists_eq_add_one.2 (Nat.mul_pos hj (σ.cycleLength_pos _))
      have h1 := σ.partialCycleMap_mul_orderOf_mul_cycleLength_add (i + 1) 1 0
      rw [one_mul, add_zero, hT, partialCycleMap_succ, partialCycleMap_zero] at h1
      have hprev : σ.next^[T] (i + 1) = σ.pair i := by
        have h := σ.next_iterate_mul_cycleLength (i + 1) (orderOf (σ.cycleMap (i + 1)))
        rw [hT, Function.iterate_succ_apply'] at h
        rw [← σ.next.symm_apply_apply (σ.next^[T] (i + 1)), h, next_symm_apply,
          add_sub_cancel_right]
      rw [hprev, map_pair] at h1
      exact ⟨T, inv_eq_of_mul_eq_one_left h1⟩
  · exact ⟨m, by rw [P.vertex_injective (hj'.trans hx.symm)]⟩

/-- Under the angle condition, every point has finitely many local neighbours. -/
theorem finite_localNeighbors
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π) (x : ℍ) :
    (σ.localNeighbors x).Finite := by
  refine (((finite_range fun i ↦ (σ.map i)⁻¹).union (finite_iUnion fun j ↦
    (finite_Iio (orderOf (σ.cycleMap j) * σ.cycleLength j)).image
      fun m ↦ (σ.partialCycleMap j m)⁻¹)).insert 1).subset fun h hh ↦ ?_
  rcases σ.mem_localNeighbors_iff.1 hh with rfl | ⟨i, -, rfl⟩ | ⟨j, m, hj, rfl⟩
  · exact mem_insert _ _
  · exact mem_insert_of_mem _ (.inl (mem_range_self i))
  · refine mem_insert_of_mem _ (.inr (mem_iUnion.2 ⟨j, m % _, Nat.mod_lt _ ?_, ?_⟩))
    · exact Nat.mul_pos (Nat.pos_of_ne_zero
        (σ.orderOf_cycleMap_ne_zero_of_mul_cycleAngleSum_eq (hcyc j x hj))) (σ.cycleLength_pos j)
    · simp only [partialCycleMap_mod_orderOf_mul_cycleLength]

/-! ### The local tiling axioms -/

/-- A point of `P` lies in the tiles of its local neighbours. -/
private theorem inv_smul_mem_carrier {x : ℍ} (hx : x ∈ P.carrier) {h : PSL(2, ℝ)}
    (hh : h ∈ σ.localNeighbors x) : h⁻¹ • x ∈ P.carrier := by
  rcases σ.mem_localNeighbors_iff.1 hh with rfl | ⟨i, hi, rfl⟩ | ⟨j, m, hj, rfl⟩
  · rwa [inv_one, one_smul]
  · rw [inv_inv]
    exact P.side_subset_carrier _ (σ.map_smul_mem_side hi)
  · rw [inv_inv]
    exact P.vertex_mem_carrier (σ.vertex_next_iterate_eq_inl hj m)

/-- Seen from the tile of a local neighbour, `P` is the tile of a local neighbour. -/
private theorem inv_mem_localNeighbors
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {x : ℍ} {h : PSL(2, ℝ)} (hh : h ∈ σ.localNeighbors x) :
    h⁻¹ ∈ σ.localNeighbors (h⁻¹ • x) := by
  rcases σ.mem_localNeighbors_iff.1 hh with rfl | ⟨i, hi, rfl⟩ | ⟨j, m, hj, rfl⟩
  · rw [inv_one]
    exact σ.one_mem_localNeighbors _
  · have := σ.inv_map_mem_localNeighbors (σ.map_smul_mem_side hi)
    rwa [map_pair, inv_inv, ← inv_inv (σ.map i)] at this
  · obtain ⟨m', hm'⟩ := σ.exists_partialCycleMap_eq_inv
      (Nat.pos_of_ne_zero (σ.orderOf_cycleMap_ne_zero_of_mul_cycleAngleSum_eq (hcyc j x hj))) m
    rw [inv_inv, ← inv_inv (σ.partialCycleMap j m), ← hm']
    exact σ.inv_partialCycleMap_mem_localNeighbors
      (by rw [σ.vertex_next_iterate_eq_inl hj, hm', inv_inv]) m'

/-- The local neighbours seen from the tile of a local neighbour are local neighbours. -/
private theorem mul_mem_localNeighbors
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {x : ℍ} {h k : PSL(2, ℝ)} (hh : h ∈ σ.localNeighbors x)
    (hk : k ∈ σ.localNeighbors (h⁻¹ • x)) : h * k ∈ σ.localNeighbors x := by
  by_cases hv : ∃ j, P.vertex j = .inl x
  · -- around a finite vertex, consecutive partial cycle products compose
    obtain ⟨j, hj⟩ := hv
    have hpos := Nat.pos_of_ne_zero
      (σ.orderOf_cycleMap_ne_zero_of_mul_cycleAngleSum_eq (hcyc j x hj))
    rw [σ.localNeighbors_eq_range hj hpos] at hh ⊢
    obtain ⟨m, rfl⟩ := hh
    have hj' := σ.vertex_next_iterate_eq_inl hj m
    rw [inv_inv, σ.localNeighbors_eq_range hj' (Nat.pos_of_ne_zero
      (σ.orderOf_cycleMap_ne_zero_of_mul_cycleAngleSum_eq (hcyc _ _ hj')))] at hk
    obtain ⟨m', rfl⟩ := hk
    exact ⟨m + m', by simp only [partialCycleMap_add, mul_inv_rev]⟩
  push Not at hv
  rcases σ.mem_localNeighbors_iff.1 hh with rfl | ⟨i, hi, rfl⟩ | ⟨j, m, hj, -⟩
  · simpa using hk
  · -- across a side, the only tiles are `P` and its paired translate
    rw [inv_inv] at hk
    have hne := σ.vertex_ne_inl_map_smul hi (hv i) (hv (i + 1))
    rcases σ.mem_localNeighbors_iff.1 hk with rfl | ⟨i', hi', rfl⟩ | ⟨l, m, hl, -⟩
    · rw [mul_one]
      exact σ.inv_map_mem_localNeighbors hi
    · rw [P.eq_of_mem_side_of_mem_side hi' (hne i') (hne (i' + 1)) (σ.map_smul_mem_side hi),
        map_pair, inv_inv, inv_mul_cancel]
      exact σ.one_mem_localNeighbors x
    · exact absurd hl (hne l)
  · exact absurd hj (hv j)

/-- If `y` lies on every side through `v`, then the local neighbours of `v` are local neighbours
of `y`. When `v` is a vertex this forces `y = v`, since the two sides through `v` meet only
there. -/
private theorem localNeighbors_subset {v y : ℍ} (hvy : ∀ k, v ∈ P.side k → y ∈ P.side k) :
    σ.localNeighbors v ⊆ σ.localNeighbors y := by
  intro h hh
  rcases σ.mem_localNeighbors_iff.1 hh with rfl | ⟨i, hi, rfl⟩ | ⟨l, m, hl, rfl⟩
  · exact σ.one_mem_localNeighbors y
  · exact σ.inv_map_mem_localNeighbors (hvy i hi)
  · have hyv : y = v := by
      by_contra hne
      have h₁ := hvy l (P.mem_side_of_vertex_eq_inl hl)
      have h₂ := hvy (l - 1) (P.mem_side_of_vertex_add_one_eq_inl (by rwa [sub_add_cancel]))
      exact sub_one_ne_self (Nat.le_of_succ_le P.three_le) l
        (P.eq_of_nontrivial_side_inter_side ⟨y, ⟨h₁, h₂⟩, v,
          ⟨P.mem_side_of_vertex_eq_inl hl,
            P.mem_side_of_vertex_add_one_eq_inl (by rwa [sub_add_cancel])⟩, hne⟩).symm
    exact hyv ▸ σ.inv_partialCycleMap_mem_localNeighbors hl m

/-- **Local coverage.** Under the angle condition, the tiles of the local neighbours of a point
of the polygon cover a neighbourhood of it. -/
private theorem mem_interior_iUnion_smul_carrier
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {x : ℍ} (hx : x ∈ P.carrier) :
    x ∈ interior (⋃ h ∈ σ.localNeighbors x, h • P.carrier) := by
  by_cases hv : ∃ j, P.vertex j = .inl x
  · -- at a finite vertex, `orderOf (cycleMap j)` circuits of its cycle fill a full turn
    obtain ⟨j, hj⟩ := hv
    refine interior_mono (iUnion₂_subset fun m _ ↦ ?_)
      (σ.mem_interior_iUnion_inv_partialCycleMap_smul_carrier_of_le_mul_cycleAngleSum hj
        (hcyc j x hj).ge)
    exact subset_biUnion_of_mem (u := fun h ↦ h • P.carrier)
      (σ.inv_partialCycleMap_mem_localNeighbors hj m)
  push Not at hv
  by_cases hint : x ∈ interior P.carrier
  · refine interior_mono (subset_biUnion_of_mem (u := fun h ↦ h • P.carrier)
      (σ.one_mem_localNeighbors x)) ?_
    rwa [one_smul]
  -- a boundary point lies on a side, where `P` and its paired translate cover a neighbourhood
  obtain ⟨i, hi, h⟩ := σ.exists_mem_side_mem_interior_union_inv_smul_carrier hx hint hv
  refine interior_mono (union_subset ?_ ?_) h
  · simpa only [one_smul] using
      subset_biUnion_of_mem (u := fun h ↦ h • P.carrier) (σ.one_mem_localNeighbors x)
  · exact subset_biUnion_of_mem (u := fun h ↦ h • P.carrier) (σ.inv_map_mem_localNeighbors hi)

/-- **Local no-overlap**, relative to the polygon itself: under the angle condition, a local
neighbour whose tile meets the interior of `P` in an interior point is the identity. -/
private theorem eq_one_of_interior_inter_smul_interior_nonempty
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {y : ℍ} {g : PSL(2, ℝ)} (hg : g ∈ σ.localNeighbors y)
    (h : (interior P.carrier ∩ g • interior P.carrier).Nonempty) : g = 1 := by
  by_cases hv : ∃ j, P.vertex j = .inl y
  · -- the tiles met during one full turn about a finite vertex have disjoint interiors
    obtain ⟨j, hj⟩ := hv
    have hpos := Nat.pos_of_ne_zero
      (σ.orderOf_cycleMap_ne_zero_of_mul_cycleAngleSum_eq (hcyc j y hj))
    rw [σ.localNeighbors_eq_range hj hpos] at hg
    obtain ⟨m, rfl⟩ := hg
    have hT : 0 < orderOf (σ.cycleMap j) * σ.cycleLength j :=
      Nat.mul_pos hpos (σ.cycleLength_pos j)
    beta_reduce at h ⊢
    rw [← partialCycleMap_mod_orderOf_mul_cycleLength] at h ⊢
    by_contra hne
    have hm : m % (orderOf (σ.cycleMap j) * σ.cycleLength j) ≠ 0 := by
      rintro hm
      rw [hm, partialCycleMap_zero, inv_one] at hne
      exact hne rfl
    refine not_disjoint_iff_nonempty_inter.2 ?_
      (σ.pairwiseDisjoint_inv_partialCycleMap_smul_interior_carrier_of_mul_cycleAngleSum_le hj
        (hcyc j y hj).le (Finset.mem_coe.2 (Finset.mem_range.2 hT))
        (Finset.mem_coe.2 (Finset.mem_range.2 (Nat.mod_lt m hT))) hm.symm)
    simpa using h
  push Not at hv
  rcases σ.mem_localNeighbors_iff.1 hg with rfl | ⟨i, -, rfl⟩ | ⟨j, m, hj, -⟩
  · rfl
  · -- the translate across a side misses the interior of `P`
    obtain ⟨w, hw, hw'⟩ := h
    rw [← map_pair] at hw'
    exact (disjoint_left.1 (σ.disjoint_smul_interior_carrier_carrier (σ.pair i)) hw'
      (interior_subset hw)).elim
  · exact absurd hj (hv j)

/-- **Local no-overlap.** Under the angle condition, two local neighbours of a point of the
polygon whose tiles have overlapping interiors are equal. -/
private theorem eq_of_smul_interior_inter_smul_interior_nonempty
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {y : ℍ} {g g' : PSL(2, ℝ)} (hg : g ∈ σ.localNeighbors y) (hg' : g' ∈ σ.localNeighbors y)
    (h : (g • interior P.carrier ∩ g' • interior P.carrier).Nonempty) : g = g' := by
  -- seen from the tile of `g`, the tile of `g'` is that of a local neighbour of `g⁻¹ • y`
  have hk : g⁻¹ * g' ∈ σ.localNeighbors (g⁻¹ • y) :=
    σ.mul_mem_localNeighbors hcyc (σ.inv_mem_localNeighbors hcyc hg) (by simpa using hg')
  refine (inv_mul_eq_one.1 (σ.eq_one_of_interior_inter_smul_interior_nonempty hcyc hk ?_))
  obtain ⟨w, hw, hw'⟩ := h
  refine ⟨g⁻¹ • w, mem_smul_set_iff_inv_smul_mem.1 hw, ?_⟩
  rw [mul_smul]
  exact smul_mem_smul_set hw'

/-- A translate of the interior of `P` whose closure contains a point `v` of `P` meets the
interior of the tile of a local neighbour of `v`: those tiles cover a neighbourhood of `v`, and
each is the closure of its interior. -/
private theorem exists_mem_localNeighbors_smul_interior_inter_nonempty
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {v : ℍ} (hv : v ∈ P.carrier) {g : PSL(2, ℝ)} (hvg : v ∈ closure (g • interior P.carrier)) :
    ∃ a ∈ σ.localNeighbors v, (g • interior P.carrier ∩ a • interior P.carrier).Nonempty := by
  obtain ⟨w, hwO, hw⟩ := mem_closure_iff.1 hvg _ isOpen_interior
    (σ.mem_interior_iUnion_smul_carrier hcyc hv)
  have hcl : ⋃ a ∈ σ.localNeighbors v, a • P.carrier =
      closure (⋃ a ∈ σ.localNeighbors v, a • interior P.carrier) := by
    rw [(σ.finite_localNeighbors hcyc v).closure_biUnion]
    simp only [closure_smul, P.closure_interior_carrier]
  rw [hcl] at hwO
  obtain ⟨u, ⟨hu, -⟩, hua⟩ := mem_closure_iff.1 (interior_subset hwO) _
    ((isOpen_interior.smul _).inter isOpen_interior) ⟨hw, hwO⟩
  obtain ⟨a, ha, hua⟩ := mem_iUnion₂.1 hua
  exact ⟨a, ha, u, hu, hua⟩

/-- **Tiles through a point are translated local neighbours.** Let `M` be a set of tiles with
pairwise disjoint interiors, let `v ∈ P`, and suppose `M` contains the translates `h * k` of the
local neighbours `k` of `v`. Then, under the angle condition, every tile of `M` through `h • v` is
such a translate: the local neighbours of `v` cover a neighbourhood of `v`, so a tile through
`h • v` overlaps one of their translates. -/
theorem inv_mul_mem_localNeighbors_of_smul_mem
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {M : Set PSL(2, ℝ)}
    (hM : ∀ a ∈ M, ∀ b ∈ M, (a • interior P.carrier ∩ b • interior P.carrier).Nonempty → a = b)
    {h : PSL(2, ℝ)} {v : ℍ} (hv : v ∈ P.carrier) (hmul : ∀ k ∈ σ.localNeighbors v, h * k ∈ M)
    {h' : PSL(2, ℝ)} (hh' : h' ∈ M) (hvh' : h • v ∈ h' • P.carrier) :
    h⁻¹ * h' ∈ σ.localNeighbors v := by
  have hvg : v ∈ closure ((h⁻¹ * h') • interior P.carrier) := by
    rw [closure_smul, P.closure_interior_carrier, mul_smul, mem_inv_smul_set_iff]
    exact hvh'
  obtain ⟨a, ha, w, hw, hwa⟩ :=
    σ.exists_mem_localNeighbors_smul_interior_inter_nonempty hcyc hv hvg
  have hh'a : h' = h * a := hM h' hh' (h * a) (hmul a ha) ⟨h • w, by
    rw [mul_smul, mem_inv_smul_set_iff] at hw
    exact ⟨hw, by rw [mul_smul]; exact smul_mem_smul_set hwa⟩⟩
  rwa [hh'a, inv_mul_cancel_left]

/-- **The tiling chart at a point of the polygon.** It consists of the points whose preimage in
each neighbouring tile lies on no side missed by the preimage of `x`, and which are covered by
the neighbouring tiles. -/
private theorem exists_isTilingChart
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {x : ℍ} (hx : x ∈ P.carrier) :
    ∃ W, x ∈ W ∧ IsTilingChart P.carrier σ.localNeighbors W (σ.localNeighbors x) := by
  set M := σ.localNeighbors x
  have hM := σ.finite_localNeighbors hcyc x
  set W := (⋂ h ∈ M, ⋂ k, {w : ℍ | h⁻¹ • w ∈ P.side k → h⁻¹ • x ∈ P.side k}) ∩
    interior (⋃ h ∈ M, h • P.carrier)
  have hWside {h : PSL(2, ℝ)} (hh : h ∈ M) {v : ℍ} (hv : h • v ∈ W) (k : Fin n)
      (hk : v ∈ P.side k) : h⁻¹ • x ∈ P.side k := by
    have := mem_iInter.1 (mem_iInter₂.1 hv.1 h hh) k
    rw [mem_ofPred_eq, inv_smul_smul] at this
    exact this hk
  -- a neighbour of a point of the chart is a neighbour of the corresponding preimage of `x`
  have hmul (h : PSL(2, ℝ)) (hh : h ∈ M) (v : ℍ) (hvW : h • v ∈ W) (k : PSL(2, ℝ))
      (hk : k ∈ σ.localNeighbors v) : h * k ∈ M :=
    σ.mul_mem_localNeighbors hcyc hh (by simpa using σ.localNeighbors_subset (hWside hh hvW) hk)
  refine ⟨W, ⟨mem_iInter₂.2 fun h _ ↦ mem_iInter.2 fun k ↦ id,
    σ.mem_interior_iUnion_smul_carrier hcyc hx⟩, ⟨?_, fun w hw ↦ interior_subset hw.2, ?_,
    fun h hh v _ hvW k hk ↦ hmul h hh v hvW k hk, fun h hh v hv hvW h' hh' hvh' ↦
      σ.inv_mul_mem_localNeighbors_of_smul_mem hcyc
        (fun _ ha _ hb ↦ σ.eq_of_smul_interior_inter_smul_interior_nonempty hcyc ha hb) hv
        (hmul h hh v hvW) hh' hvh'⟩⟩
  · refine (hM.isOpen_biInter fun h _ ↦ isOpen_iInter_of_finite fun k ↦ ?_).inter isOpen_interior
    by_cases hk : h⁻¹ • x ∈ P.side k
    · simp [hk]
    · simp only [hk, imp_false]
      exact (P.isClosed_side k).isOpen_compl.preimage (continuous_const_smul h⁻¹)
  · have := hM.to_subtype
    exact locallyFinite_of_finite _

/-- **The local tiling of a side-paired polygon.** If at every finite vertex the cycle
transformation has finite order `m` and the interior angles along the cycle add up to `2π / m`,
then the local neighbours of the points of `P` form a local tiling by `P`. -/
theorem isLocalTiling
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π) :
    IsLocalTiling P.carrier σ.localNeighbors where
  isClosed := P.isClosed_carrier
  isPathConnected := P.isPathConnected_carrier
  one_mem x _ := σ.one_mem_localNeighbors x
  inv_smul_mem _ hx _ hh := σ.inv_smul_mem_carrier hx hh
  inv_mem _ _ _ hh := σ.inv_mem_localNeighbors hcyc hh
  mul_mem _ _ _ hh _ hk := σ.mul_mem_localNeighbors hcyc hh hk
  exists_isTilingChart _ hx := σ.exists_isTilingChart hcyc hx

/-- The local neighbours of the points of `P` generate the same group as the side-pairing
maps. -/
theorem closure_biUnion_localNeighbors :
    Subgroup.closure (⋃ x ∈ P.carrier, σ.localNeighbors x) = Subgroup.closure (range σ.map) := by
  refine le_antisymm ((Subgroup.closure_le _).2 (iUnion₂_subset fun x _ h hh ↦ ?_))
    (Subgroup.closure_mono (range_subset_iff.2 fun i ↦ ?_))
  · rcases σ.mem_localNeighbors_iff.1 hh with rfl | ⟨i, -, rfl⟩ | ⟨j, m, -, rfl⟩
    · exact Subgroup.one_mem _
    · exact Subgroup.inv_mem _ (Subgroup.subset_closure (mem_range_self i))
    · exact Subgroup.inv_mem _
        (σ.partialCycleMap_mem (fun i ↦ Subgroup.subset_closure (mem_range_self i)) j m)
  · -- `map i` carries `P` across the paired side
    obtain ⟨z, hz, -⟩ := P.exists_mem_side_ne_endpoints (σ.pair i)
    exact mem_iUnion₂.2 ⟨z, P.side_subset_carrier _ hz, by
      simpa using σ.inv_map_mem_localNeighbors hz⟩

end TauCeti.UpperHalfPlane.ConvexPolygon.SidePairing
