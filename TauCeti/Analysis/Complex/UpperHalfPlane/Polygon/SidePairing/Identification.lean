module

public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.Elliptic
public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.Vertex.Orbit
import TauCeti.Topology.Algebra.GroupAction.LocallyFiniteQuotient

/-!
# The quotient by a fundamental polygon is its side-pairing identification space

Let `σ` pair the sides of a convex hyperbolic polygon `P`. The *side-pairing identification* is
the equivalence relation on `ℍ` generated by identifying each point `z` of side `i` with its image
`σ.map i • z` on side `pair i`. Restricted to `P`, its quotient is the space obtained from the
polygon by gluing its sides in pairs.

Now let `Γ ≤ PSL(2, ℝ)` contain the side-pairing maps, with distinct translates of the interior
of `P` disjoint. Two points of `P` lie in the same `Γ`-orbit exactly when they are identified:
either the points coincide, or one is carried to the other by the map of a side through it (so
identifications away from the finite vertices take at most one side-pairing step), or both are
finite vertices in the same vertex cycle, identified along that cycle
(`ConvexPolygon.SidePairing.mem_orbit_iff_of_mem_carrier`). If moreover the
translates of `P` are locally finite, they cover `ℍ`, and the orbit projection restricted to `P`
is a quotient map. Hence the coarse quotient `Γ \ ℍ` is homeomorphic to the identification space
of `P` (`ConvexPolygon.SidePairing.carrierQuotientHomeomorph`).

This is the topological model of the quotient surface read off from a fundamental polygon: its
points are the interior points of `P`, the pairs of identified side points, and the finite vertex
cycles. It is the starting point for computing the topology of the quotient, such as its Euler
characteristic, from the combinatorics of the side pairing.

## Main definitions

* `ConvexPolygon.SidePairing.identification`: the side-pairing identification on `ℍ`.
* `ConvexPolygon.SidePairing.carrierSetoid`: its restriction to the points of `P`.
* `ConvexPolygon.SidePairing.carrierQuotientHomeomorph`: the homeomorphism from the
  identification space of a locally finite fundamental polygon to the coarse quotient.

## Main results

* `ConvexPolygon.SidePairing.mem_orbit_iff_of_mem_carrier`: two points of `P` are `Γ`-equivalent
  exactly when they coincide, are related by one side-pairing map, or are finite vertices in the
  same cycle.
* `ConvexPolygon.SidePairing.identification_iff_orbitRel`: on the points of `P`, the side-pairing
  identification is the orbit relation of `Γ`.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, Graduate Texts in Mathematics 91, Springer,
  1983, §§9.2–9.3 (locally finite fundamental polygons, side pairings and the quotient space).
* Svetlana Katok, *Fuchsian Groups*, Chicago Lectures in Mathematics, University of Chicago
  Press, 1992, §§3.1 and 4.1 (the identification of a fundamental region with the quotient).
-/

public section

open MulAction Set Topology UpperHalfPlane
open scoped MatrixGroups Pointwise

namespace TauCeti.UpperHalfPlane.ConvexPolygon.SidePairing

variable {n : ℕ} [NeZero n] {P : ConvexPolygon n} (σ : P.SidePairing) {Γ : Subgroup PSL(2, ℝ)}

/-! ### The side-pairing identification -/

/-- The side-pairing identification: the equivalence relation on `ℍ` generated by identifying
each point `z` of side `i` with its image `σ.map i • z` on the paired side. -/
def identification : Setoid ℍ :=
  Relation.EqvGen.setoid fun z w ↦ ∃ i, z ∈ P.side i ∧ σ.map i • z = w

/-- Two points are identified exactly when they are joined by a chain of side-pairing steps. -/
theorem identification_iff {z w : ℍ} :
    σ.identification z w ↔ Relation.EqvGen (fun z w ↦ ∃ i, z ∈ P.side i ∧ σ.map i • z = w) z w :=
  Iff.rfl

/-- A point of a side is identified with its image under the side-pairing map. -/
theorem identification_map_smul {i : Fin n} {z : ℍ} (hz : z ∈ P.side i) :
    σ.identification z (σ.map i • z) :=
  Relation.EqvGen.rel _ _ ⟨i, hz, rfl⟩

/-- A finite vertex is identified with its images along its vertex cycle. -/
theorem identification_partialCycleMap_smul {j : Fin n} {z : ℍ} (hz : P.vertex j = .inl z)
    (m : ℕ) : σ.identification z (σ.partialCycleMap j m • z) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [partialCycleMap_succ, mul_smul]
    exact σ.identification.trans ih (σ.identification_map_smul
      (P.mem_side_of_vertex_eq_inl (σ.vertex_next_iterate_eq_inl hz m)))

/-- Finite vertices in the same vertex cycle are identified. -/
theorem identification_of_mem_cycle {j k : Fin n} {z w : ℍ} (hz : P.vertex j = .inl z)
    (hw : P.vertex k = .inl w) (hk : k ∈ σ.cycle j) : σ.identification z w := by
  obtain ⟨m, rfl⟩ := (σ.mem_cycle_iff j k).1 hk
  rw [σ.vertex_next_iterate_eq_inl hz m, Sum.inl.injEq] at hw
  exact hw ▸ σ.identification_partialCycleMap_smul hz m

/-- Identified points lie in the same orbit of any group containing the side-pairing maps. -/
theorem orbitRel_of_identification (hmap : ∀ i, σ.map i ∈ Γ) {z w : ℍ}
    (h : σ.identification z w) : orbitRel Γ ℍ z w :=
  haveI := (orbitRel Γ ℍ).iseqv.isEquiv
  Relation.EqvGen.eqvGen_le (fun z _ ⟨i, _, h⟩ ↦
    h ▸ (orbitRel Γ ℍ).symm (mem_orbit z (⟨σ.map i, hmap i⟩ : Γ))) _ _ h

/-! ### Orbits of points of a fundamental polygon -/

/-- A side-pairing step read backwards is the step of the paired side. -/
private theorem exists_side_smul_eq_of_mem_side {i : Fin n} {z w : ℍ} (hw : w ∈ P.side i)
    (hwz : σ.map i • w = z) : ∃ k, z ∈ P.side k ∧ σ.map k • z = w := by
  refine ⟨σ.pair i, hwz ▸ σ.map_smul_mem_side hw, ?_⟩
  rw [← hwz, smul_smul, σ.map_pair, inv_mul_cancel, one_smul]

/-- An element of `Γ` moving an interior point of the polygon into the polygon is the identity. -/
private theorem eq_one_of_smul_mem_carrier
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier))
    {g : PSL(2, ℝ)} (hg : g ∈ Γ) {z : ℍ}
    (hz : z ∈ interior P.carrier) (hgz : g • z ∈ P.carrier) : g = 1 :=
  P.eq_of_smul_interior_inter_smul_carrier_nonempty hdisj hg Γ.one_mem
    ⟨g • z, smul_mem_smul_set hz, by rwa [one_smul]⟩

/-- An element of `Γ` carrying a point of the polygon to a point of side `i` other than its
finite endpoints either fixes the point or acts as a side-pairing map on it. -/
private theorem eq_or_exists_side_smul_eq_of_smul_mem_side (hmap : ∀ i, σ.map i ∈ Γ)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier))
    {g : PSL(2, ℝ)} (hg : g ∈ Γ) {i : Fin n} {z w : ℍ} (hz : z ∈ P.carrier) (hw : w ∈ P.side i)
    (hwp : P.vertex i ≠ .inl w) (hwq : P.vertex (i + 1) ≠ .inl w) (hgz : g • z = w) :
    w = z ∨ ∃ k, z ∈ P.side k ∧ σ.map k • z = w := by
  rcases σ.eq_one_or_eq_map_pair_of_smul_mem_side (hmap _) hdisj hg hz hw hwp hwq hgz with
    rfl | rfl
  · exact Or.inl (by rw [← hgz, one_smul])
  · refine Or.inr (σ.exists_side_smul_eq_of_mem_side hw ?_)
    rw [← hgz, smul_smul, σ.map_pair, mul_inv_cancel, one_smul]

/-- **Orbits of points of a fundamental polygon.** Let `Γ` contain the side-pairing maps, with
distinct translates of the interior of `P` disjoint. Two points `z` and `w` of `P` lie in the same
`Γ`-orbit exactly when they coincide, or `z` lies on a side `i` with `σ.map i • z = w`, or both
are finite vertices in the same vertex cycle. -/
theorem mem_orbit_iff_of_mem_carrier (hmap : ∀ i, σ.map i ∈ Γ)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier))
    {z w : ℍ} (hz : z ∈ P.carrier) (hw : w ∈ P.carrier) :
    w ∈ orbit Γ z ↔ w = z ∨ (∃ i, z ∈ P.side i ∧ σ.map i • z = w) ∨
      ∃ j k, P.vertex j = .inl z ∧ P.vertex k = .inl w ∧ k ∈ σ.cycle j := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · obtain ⟨⟨g, hg⟩, hgz⟩ := mem_orbit_iff.mp h
    rw [Subgroup.mk_smul] at hgz
    have hgw : g⁻¹ • w = z := by rw [← hgz, inv_smul_smul]
    rcases P.mem_interior_or_mem_side_or_vertex_eq_inl hw with hwi | ⟨i, hwi, hwp, hwq⟩ | ⟨k, hk⟩
    · -- an interior point is only equivalent to itself
      have h1 := eq_one_of_smul_mem_carrier hdisj (Γ.inv_mem hg) hwi (hgw ▸ hz)
      rw [inv_eq_one] at h1
      exact Or.inl (by rw [← hgz, h1, one_smul])
    · exact (σ.eq_or_exists_side_smul_eq_of_smul_mem_side hmap hdisj hg hz hwi hwp hwq
        hgz).imp_right Or.inl
    rcases P.mem_interior_or_mem_side_or_vertex_eq_inl hz with hzi | ⟨i, hzi, hzp, hzq⟩ | ⟨j, hj⟩
    · have h1 := eq_one_of_smul_mem_carrier hdisj hg hzi (hgz ▸ hw)
      exact Or.inl (by rw [← hgz, h1, one_smul])
    · rcases σ.eq_or_exists_side_smul_eq_of_smul_mem_side hmap hdisj (Γ.inv_mem hg) hw hzi hzp
        hzq hgw with hzw | ⟨k, hwk, hkw⟩
      · exact Or.inl hzw.symm
      · exact Or.inr (Or.inl (σ.exists_side_smul_eq_of_mem_side hwk hkw))
    · exact Or.inr (Or.inr ⟨j, k, hj, hk, (σ.mem_orbit_iff_mem_cycle hj hk hmap hdisj).1 h⟩)
  · rintro (rfl | ⟨i, -, rfl⟩ | ⟨j, k, hj, hk, hjk⟩)
    · exact mem_orbit_self w
    · exact mem_orbit z (⟨σ.map i, hmap i⟩ : Γ)
    · exact (σ.mem_orbit_iff_mem_cycle hj hk hmap hdisj).2 hjk

/-- **The side-pairing identification is the orbit relation on a fundamental polygon.** Let `Γ`
contain the side-pairing maps, with distinct translates of the interior of `P` disjoint. Two
points of `P` are identified by the side pairing exactly when they lie in the same `Γ`-orbit. -/
theorem identification_iff_orbitRel (hmap : ∀ i, σ.map i ∈ Γ)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier))
    {z w : ℍ} (hz : z ∈ P.carrier) (hw : w ∈ P.carrier) :
    σ.identification z w ↔ orbitRel Γ ℍ z w := by
  refine ⟨σ.orbitRel_of_identification hmap, fun h ↦ ?_⟩
  rcases (σ.mem_orbit_iff_of_mem_carrier hmap hdisj hw hz).1 (orbitRel_apply.1 h) with
    rfl | ⟨i, hi, rfl⟩ | ⟨j, k, hj, hk, hjk⟩
  · exact σ.identification.refl z
  · exact σ.identification.symm (σ.identification_map_smul hi)
  · exact σ.identification.symm (σ.identification_of_mem_cycle hj hk hjk)

/-! ### The identification space -/

/-- The side-pairing identification of the points of `P`. The quotient of `P` by it, with the
quotient topology, is the identification space of `P`: the polygon with its sides glued in pairs
by the side-pairing maps. -/
def carrierSetoid : Setoid P.carrier :=
  σ.identification.comap Subtype.val

/-- Points of the polygon are related exactly when they are identified by the side pairing. -/
@[simp]
theorem carrierSetoid_iff {z w : P.carrier} :
    σ.carrierSetoid z w ↔ σ.identification (z : ℍ) w :=
  Iff.rfl

/-- **The quotient by a fundamental polygon is its identification space.** Let `Γ` contain the
side-pairing maps, with locally finite translates of `P` whose interiors are pairwise disjoint.
Then sending the class of a point of `P` to its orbit is a homeomorphism from the identification
space of `P` onto the coarse quotient `Γ \ ℍ`. -/
noncomputable def carrierQuotientHomeomorph (hmap : ∀ i, σ.map i ∈ Γ)
    (hlf : LocallyFinite fun γ : Γ ↦ (γ : PSL(2, ℝ)) • P.carrier)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier)) :
    Quotient σ.carrierSetoid ≃ₜ orbitRel.Quotient Γ ℍ :=
  have hq := isQuotientMap_quotientMk_domRestrict_of_locallyFinite_smul (G := Γ)
    P.isClosed_carrier (σ.iUnion_smul_carrier_eq_univ hmap hlf) hlf
  (Homeomorph.Quotient.congrRight (r := σ.carrierSetoid) fun z w ↦
      (σ.identification_iff_orbitRel hmap hdisj z.2 w.2).trans Quotient.eq''.symm).trans
    (IsQuotientMap.homeomorph (f := ⟨_, hq.continuous⟩) hq)

/-- The homeomorphism sends the class of a point of `P` to its orbit. -/
@[simp]
theorem carrierQuotientHomeomorph_mk (hmap : ∀ i, σ.map i ∈ Γ)
    (hlf : LocallyFinite fun γ : Γ ↦ (γ : PSL(2, ℝ)) • P.carrier)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier)) (z : P.carrier) :
    σ.carrierQuotientHomeomorph hmap hlf hdisj (Quotient.mk _ z) = Quotient.mk'' (z : ℍ) :=
  (rfl)

/-- The inverse homeomorphism sends the orbit of a point of `P` to its class. -/
@[simp]
theorem carrierQuotientHomeomorph_symm_mk (hmap : ∀ i, σ.map i ∈ Γ)
    (hlf : LocallyFinite fun γ : Γ ↦ (γ : PSL(2, ℝ)) • P.carrier)
    (hdisj : ∀ γ : Γ, γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier)) (z : P.carrier) :
    (σ.carrierQuotientHomeomorph hmap hlf hdisj).symm (Quotient.mk'' (z : ℍ)) =
      Quotient.mk _ z := by
  rw [Homeomorph.symm_apply_eq, carrierQuotientHomeomorph_mk]

end TauCeti.UpperHalfPlane.ConvexPolygon.SidePairing
