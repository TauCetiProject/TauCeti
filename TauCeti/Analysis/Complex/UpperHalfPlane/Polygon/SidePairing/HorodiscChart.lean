/-!
# The tessellation by a side-paired polygon with ideal vertices

Let `σ` be a side pairing of a convex hyperbolic polygon `P`, possibly with ideal vertices.
Suppose that every finite vertex cycle satisfies the angle condition of Poincaré's polygon
theorem, and that the cycle transformation of every ideal vertex is parabolic. This file proves
that the group generated by the side-pairing maps then moves the interior of `P` off itself and
has locally finite translates of `P`: these are the tessellation hypotheses from which the
fundamental domain, discreteness, covolume and presentation statements for side-paired polygons
are proved.

The local neighbours of the points of `P` form a local tiling (`SidePairing.isLocalTiling`), and
the global tessellation theorem for local tilings applies once tiling charts of a uniform size
exist. A compact polygon has them automatically; at an ideal vertex the charts at the points of
`P` shrink towards the vertex, and a different chart is needed. Move the ideal vertex `vertex j`
to `∞` by `g`, and let `T` be its cycle transformation. When `T` is parabolic, the tiles
`(T ^ k * (partialCycleMap j m)⁻¹) • P` cover a horodisc `{z | B < Im (g • z)}` at the vertex
(`exists_setOf_lt_im_smul_subset_iUnion_smul_carrier`), and have pairwise disjoint interiors.
High enough in that horodisc, a point of a tile lies only on the two sides through the ideal
vertex, and crossing such a side moves to the previous or the next tile of the cycle. So the
horodisc with these tiles is a tiling chart (`exists_isTilingChart_of_vertex_eq_inr`). Since
`P` minus horodiscs at its ideal vertices is compact, the charts at the points of this
truncation, together with the horodisc charts, are uniform.

Conversely, the angle condition and the parabolic cycle condition hold at the vertices of every
locally finite fundamental polygon, so for a side-paired polygon the tessellation hypotheses are
equivalent to these cycle conditions.

## Main results

* `ConvexPolygon.SidePairing.exists_isTilingChart_of_vertex_eq_inr`: a horodisc at an ideal
  vertex with parabolic cycle transformation, with the tiles of its cycle, is a tiling chart.
* `ConvexPolygon.SidePairing.hasUniformTilingCharts_of_isParabolic`: under the angle and
  parabolic cycle conditions, the local tiling by `P` has uniform tiling charts.
* `ConvexPolygon.SidePairing.disjoint_smul_interior_carrier_of_isParabolic`,
  `ConvexPolygon.SidePairing.locallyFinite_smul_carrier_of_isParabolic`: under these conditions,
  the group generated by the side-pairing maps has disjoint translates of the interior of `P` and
  locally finite translates of `P`.
* `ConvexPolygon.SidePairing.disjoint_smul_interior_carrier_and_locallyFinite_iff`: these
  tessellation properties are equivalent to the angle and parabolic cycle conditions.
* `ConvexPolygon.SidePairing.disjoint_smul_interior_carrier_iff_of_isCompact`: for a compact
  polygon, the translated interiors are disjoint exactly when the angle condition holds.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, Graduate Texts in Mathematics 91,
  Springer, 1983, §9.8 (Poincaré's theorem).
* Bernard Maskit, *On Poincaré's theorem for fundamental polygons*, Adv. Math. 7 (1971),
  219–230.
* David B. A. Epstein and Carlo Petronio, *An exposition of Poincaré's polyhedron theorem*,
  Enseign. Math. (2) 40 (1994), 113–170.
-/

public section

open Matrix.ProjectiveSpecialLinearGroup Metric Set UpperHalfPlane
open scoped MatrixGroups OnePoint Pointwise Real

namespace TauCeti.UpperHalfPlane.ConvexPolygon.SidePairing

variable {n : ℕ} [NeZero n] {P : ConvexPolygon n} (σ : P.SidePairing)

/-- Every tile `(T ^ k * (partialCycleMap j m)⁻¹) • P` met by following the cycle of `j`, where
`T` is the cycle transformation, is already met within the first circuit of the cycle. -/
private theorem exists_lt_cycleLength_cycleMap_zpow_mul_inv_partialCycleMap_eq (j : Fin n)
    (k : ℤ) (m : ℕ) : ∃ k' : ℤ, ∃ m' < σ.cycleLength j,
      σ.cycleMap j ^ k * (σ.partialCycleMap j m)⁻¹ =
        σ.cycleMap j ^ k' * (σ.partialCycleMap j m')⁻¹ := by
  refine ⟨k - (m / σ.cycleLength j : ℕ), m % σ.cycleLength j,
    Nat.mod_lt _ (σ.cycleLength_pos j), ?_⟩
  have h := σ.partialCycleMap_mul_cycleLength_add j (m / σ.cycleLength j) (m % σ.cycleLength j)
  rw [Nat.div_add_mod'] at h
  rw [h]
  group

/-- Crossing the side before the vertex `next^[m] j` of the tile
`(T ^ k * (partialCycleMap j m)⁻¹) • P`, where `T` is the cycle transformation of `j`, leads to
the tile before it along the cycle; at `m = 0` this tile is found one circuit back. -/
private theorem exists_cycleMap_zpow_mul_inv_partialCycleMap_mul_inv_map_eq (j : Fin n)
    (k : ℤ) (m : ℕ) : ∃ (k' : ℤ) (m' : ℕ),
      σ.cycleMap j ^ k * (σ.partialCycleMap j m)⁻¹ * (σ.map (σ.next^[m] j - 1))⁻¹ =
        σ.cycleMap j ^ k' * (σ.partialCycleMap j m')⁻¹ := by
  -- write the tile as the successor of a tile of the cycle, also when `m = 0`
  obtain ⟨k', m', heq, hJ⟩ : ∃ k' : ℤ, ∃ m' : ℕ,
      σ.cycleMap j ^ k * (σ.partialCycleMap j m)⁻¹ =
        σ.cycleMap j ^ k' * (σ.partialCycleMap j (m' + 1))⁻¹ ∧
      σ.next^[m' + 1] j = σ.next^[m] j := by
    rcases m with _ | m'
    · obtain ⟨L, hL⟩ := Nat.exists_eq_add_one.2 (σ.cycleLength_pos j)
      refine ⟨k + 1, L, ?_, ?_⟩
      · rw [← hL, ← cycleMap_def, partialCycleMap_zero]
        group
      · rw [← hL, next_iterate_cycleLength, Function.iterate_zero_apply]
    · exact ⟨k, m', rfl, rfl⟩
  refine ⟨k', m', ?_⟩
  rw [heq, ← hJ, Function.iterate_succ_apply', next_apply, add_sub_cancel_right, map_pair,
    inv_inv, partialCycleMap_succ]
  group

/-- **The tiling chart at an ideal vertex.** Let `vertex j = ξ` be an ideal vertex whose cycle
transformation `T` is parabolic, let `g` carry `ξ` to `∞`, and let every finite vertex cycle
satisfy the angle condition. Then above some height, every horodisc `{z | B < Im (g • z)}` at `ξ`
is a tiling chart whose tiles are `(T ^ k * (partialCycleMap j m)⁻¹) • P`, for `k ∈ ℤ` and
`m ∈ ℕ`. -/
theorem exists_isTilingChart_of_vertex_eq_inr
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    {j : Fin n} {ξ : OnePoint ℝ} (hj : P.vertex j = .inr ξ) (hpar : IsParabolic (σ.cycleMap j))
    {g : PSL(2, ℝ)} (hg : g • ξ = ∞) :
    ∃ A : ℝ, ∀ B, A < B → IsTilingChart P.carrier σ.localNeighbors {z | B < (g • z).im}
      (range fun p : ℤ × ℕ ↦ σ.cycleMap j ^ p.1 * (σ.partialCycleMap j p.2)⁻¹) := by
  set M := range fun p : ℤ × ℕ ↦ σ.cycleMap j ^ p.1 * (σ.partialCycleMap j p.2)⁻¹
  have hmem (k : ℤ) (m : ℕ) : σ.cycleMap j ^ k * (σ.partialCycleMap j m)⁻¹ ∈ M := ⟨(k, m), rfl⟩
  -- in the coordinate `g`, the powers of the cycle transformation preserve the height
  obtain ⟨x, -, hx⟩ := σ.exists_pos_conj_cycleMap_eq_upperRightHom hj hpar hg
  have him (k : ℤ) (z : ℍ) : (g • σ.cycleMap j ^ k • z).im = (g • z).im := by
    rw [smul_zpow_smul hx, vadd_im]
  have hnorm {h : PSL(2, ℝ)} (hh : h ∈ M) : ∃ k : ℤ, ∃ m < σ.cycleLength j,
      h = σ.cycleMap j ^ k * (σ.partialCycleMap j m)⁻¹ := by
    obtain ⟨⟨k, m⟩, rfl⟩ := hh
    exact σ.exists_lt_cycleLength_cycleMap_zpow_mul_inv_partialCycleMap_eq j k m
  -- the tiles of `M` have pairwise disjoint interiors
  have hdisj (a : PSL(2, ℝ)) (ha : a ∈ M) (b : PSL(2, ℝ)) (hb : b ∈ M)
      (hab : (a • interior P.carrier ∩ b • interior P.carrier).Nonempty) : a = b := by
    obtain ⟨k, m, hm, rfl⟩ := hnorm ha
    obtain ⟨k', m', hm', rfl⟩ := hnorm hb
    by_contra hne
    refine not_disjoint_iff_nonempty_inter.2 hab
      (σ.pairwiseDisjoint_cycleMap_zpow_mul_inv_partialCycleMap_smul_interior_carrier hj
        (mk_mem_prod (mem_univ k) (by simpa using hm))
        (mk_mem_prod (mem_univ k') (by simpa using hm'))
        fun h ↦ hne ?_)
    rw [Prod.mk.injEq] at h
    rw [h.1, h.2]
  -- the tiles of the first circuit cover a horodisc
  obtain ⟨A₀, hA₀⟩ := σ.exists_setOf_lt_im_smul_subset_iUnion_smul_carrier hj hpar hg
  -- high enough, a point of a tile of the first circuit lies only on the two sides through the
  -- ideal vertex
  obtain ⟨A₁, hA₁⟩ := (atImInfty_mem _).1 ((Finset.range (σ.cycleLength j)).eventually_all.2
    fun m _ ↦ ((g * (σ.partialCycleMap j m)⁻¹) • P).eventually_forall_mem_side_atImInfty
      (σ.mul_inv_partialCycleMap_smul_vertex hj hg m))
  have hside {m : ℕ} (hm : m < σ.cycleLength j) {v : ℍ}
      (hv : A₁ ≤ (g • (σ.partialCycleMap j m)⁻¹ • v).im) {i : Fin n} (hi : v ∈ P.side i) :
      i = σ.next^[m] j - 1 ∨ i = σ.next^[m] j := by
    refine hA₁ _ hv m (Finset.mem_range.2 hm) i ?_
    rw [side_smul, mul_smul]
    exact smul_mem_smul_set (smul_mem_smul_set hi)
  -- crossing a side through the ideal vertex moves to the previous or the next tile of the cycle
  have hmul (h : PSL(2, ℝ)) (hh : h ∈ M) (v : ℍ) (hv : v ∈ P.carrier)
      (hvW : h • v ∈ {z : ℍ | max A₀ A₁ < (g • z).im}) (c : PSL(2, ℝ))
      (hc : c ∈ σ.localNeighbors v) : h * c ∈ M := by
    obtain ⟨k, m, hm, rfl⟩ := hnorm hh
    have hvA : A₁ ≤ (g • (σ.partialCycleMap j m)⁻¹ • v).im := by
      rw [mem_ofPred_eq, mul_smul, him] at hvW
      exact (le_max_right _ _).trans hvW.le
    rcases σ.mem_localNeighbors_iff.1 hc with rfl | ⟨i, hi, rfl⟩ | ⟨l, m', hl, -⟩
    · rw [mul_one]
      exact hmem k m
    · rcases hside hm hvA hi with rfl | rfl
      · obtain ⟨k', m', h⟩ := σ.exists_cycleMap_zpow_mul_inv_partialCycleMap_mul_inv_map_eq j k m
        rw [h]
        exact hmem k' m'
      · rw [mul_assoc, ← mul_inv_rev, ← partialCycleMap_succ]
        exact hmem k (m + 1)
    · -- a finite vertex lies on two sides, which cannot both pass through the ideal vertex
      exfalso
      have hJ : P.vertex (σ.next^[m] j) = .inr (σ.partialCycleMap j m • ξ) := by
        rw [← σ.partialCycleMap_smul_vertex, hj, Sum.smul_inr]
      rcases hside hm hvA (P.mem_side_of_vertex_eq_inl hl) with h₁ | h₁
      · rcases hside hm hvA
          (P.mem_side_of_vertex_add_one_eq_inl (i := l - 1) (by rwa [sub_add_cancel])) with
          h₂ | h₂
        · exact sub_one_ne_self (by have := P.three_le; omega) l (h₂.trans h₁.symm)
        · have hl1 : l + 1 = σ.next^[m] j := by rw [h₁, sub_add_cancel]
          exact add_one_add_one_ne_self P.three_le (l - 1) (by rw [sub_add_cancel, hl1, h₂])
      · rw [h₁, hJ] at hl
        exact Sum.inr_ne_inl hl
  have hcont : Continuous fun z : ℍ ↦ (g • z).im :=
    UpperHalfPlane.continuous_im.comp (continuous_const_smul g)
  refine ⟨max A₀ A₁, fun B hB ↦ (σ.isLocalTiling hcyc).isTilingChart_of_closure_subset
    (isOpen_lt continuous_const hcont)
    ((closure_lt_subset_le continuous_const hcont).trans fun z hz ↦ hB.trans_le hz)
    (fun z hz ↦ ?_) hmul fun h hh v hv hvW h' hh' hvh' ↦
      σ.inv_mul_mem_localNeighbors_of_smul_mem hcyc hdisj hv (hmul h hh v hv hvW) hh' hvh'⟩
  have hz' : A₀ < (g • z).im := (le_max_left _ _).trans_lt hz
  obtain ⟨k, hk⟩ := mem_iUnion.1 (hA₀ hz')
  obtain ⟨m, -, hzm⟩ := mem_iUnion₂.1 hk
  exact mem_iUnion₂.2 ⟨_, hmem k m, hzm⟩

/-- **Uniform tiling charts for a side-paired polygon.** If every finite vertex cycle satisfies
the angle condition and every ideal vertex cycle transformation is parabolic, then the local
tiling by `P` has tiling charts of a uniform size. -/
theorem hasUniformTilingCharts_of_isParabolic
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    (hpar : ∀ j ξ, P.vertex j = .inr ξ → IsParabolic (σ.cycleMap j)) :
    HasUniformTilingCharts P.carrier σ.localNeighbors := by
  -- a coordinate at each ideal vertex moving it to `∞`
  have hgex (j : Fin n) : ∃ g : PSL(2, ℝ), ∀ ξ, P.vertex j = .inr ξ → g • ξ = ∞ := by
    cases hv : P.vertex j with
    | inl z => exact ⟨1, fun _ h ↦ by simp at h⟩
    | inr ξ =>
      obtain ⟨g, hg⟩ := MulAction.exists_smul_eq PSL(2, ℝ) ξ (∞ : OnePoint ℝ)
      exact ⟨g, fun ξ' h ↦ by rwa [← Sum.inr_injective h]⟩
  choose g hg using hgex
  -- a height above which the horodisc at each ideal vertex is a tiling chart
  have hAex (j : Fin n) : ∃ A : ℝ, ∀ ξ, P.vertex j = .inr ξ → ∀ B, A < B →
      IsTilingChart P.carrier σ.localNeighbors {z | B < (g j • z).im}
        (range fun p : ℤ × ℕ ↦ σ.cycleMap j ^ p.1 * (σ.partialCycleMap j p.2)⁻¹) := by
    cases hv : P.vertex j with
    | inl z => exact ⟨0, fun _ h ↦ by simp at h⟩
    | inr ξ =>
      obtain ⟨A, hA⟩ := σ.exists_isTilingChart_of_vertex_eq_inr hcyc hv (hpar j ξ hv) (hg j ξ hv)
      exact ⟨A, fun _ _ ↦ hA⟩
  choose A hA using hAex
  -- off a compact truncation, a point is high in some horodisc, together with its unit ball
  refine (σ.isLocalTiling hcyc).hasUniformTilingCharts_of_isCompact_of_forall_notMem
    (P.isCompact_carrier_diff_iUnion g hg fun j ↦ (A j + 1) * Real.exp 1) one_pos
    fun y hy hyK ↦ ?_
  obtain ⟨j, hj, hyj⟩ := mem_iUnion₂.1 (not_not.1 fun h ↦ hyK ⟨hy, h⟩)
  obtain ⟨ξ, hξ⟩ : ∃ ξ, P.vertex j = .inr ξ := by
    cases hv : P.vertex j with
    | inl z => simp [hv] at hj
    | inr ξ => exact ⟨ξ, rfl⟩
  refine ⟨_, _, hA j ξ hξ (A j + 1) (lt_add_one _), ?_, 1, ⟨(0, 0), by simp⟩, fun z hz ↦ ?_⟩
  · have hmap (i : Fin n) : σ.map i ∈ Subgroup.closure (range σ.map) :=
      Subgroup.subset_closure (mem_range_self i)
    rw [σ.closure_biUnion_localNeighbors]
    rintro _ ⟨⟨k, m⟩, rfl⟩
    exact Subgroup.mul_mem _ (Subgroup.zpow_mem _ (σ.cycleMap_mem hmap j) k)
      (Subgroup.inv_mem _ (σ.partialCycleMap_mem hmap j m))
  · -- the height changes by a factor less than `e` across the unit ball
    rw [one_smul, mem_ball, dist_comm] at hz
    have hle := im_le_im_mul_exp_dist (g j • y) (g j • z)
    rw [dist_smul] at hle
    have hlt : (A j + 1) * Real.exp 1 < (g j • z).im * Real.exp 1 :=
      (mem_ofPred_eq ▸ hyj).trans_le (hle.trans
        (mul_le_mul_of_nonneg_left (Real.exp_lt_exp.2 hz).le (g j • z).im_pos.le))
    exact lt_of_mul_lt_mul_right hlt (Real.exp_pos 1).le

/-- **No overlap for a side-paired polygon.** If every finite vertex cycle satisfies the angle
condition and every ideal vertex cycle transformation is parabolic, then distinct translates of
the interior of `P` by the group generated by the side-pairing maps are disjoint. -/
theorem disjoint_smul_interior_carrier_of_isParabolic
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    (hpar : ∀ j ξ, P.vertex j = .inr ξ → IsParabolic (σ.cycleMap j))
    (γ : Subgroup.closure (range σ.map)) (hγ : γ ≠ 1) :
    Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier) := by
  have hP := σ.isLocalTiling hcyc
  refine disjoint_left.2 fun w hw hwi ↦ hγ ?_
  obtain ⟨u, hu, rfl⟩ := mem_smul_set.1 hw
  -- `γ` carries the interior point `u` into `P`, so it is a local neighbour of `γ • u`
  have hmem := hP.mem_of_smul_mem (σ.hasUniformTilingCharts_of_isParabolic hcyc hpar)
    (by rw [σ.closure_biUnion_localNeighbors]; exact γ.2) (interior_subset hu) (interior_subset hwi)
  rw [σ.localNeighbors_of_mem_interior hwi] at hmem
  exact Subtype.ext hmem

/-- **Local finiteness for a side-paired polygon.** If every finite vertex cycle satisfies the
angle condition and every ideal vertex cycle transformation is parabolic, then the translates of
`P` by the group generated by the side-pairing maps form a locally finite family. -/
theorem locallyFinite_smul_carrier_of_isParabolic
    (hcyc : ∀ j (z : ℍ), P.vertex j = .inl z →
      (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π)
    (hpar : ∀ j ξ, P.vertex j = .inr ξ → IsParabolic (σ.cycleMap j)) :
    LocallyFinite fun γ : Subgroup.closure (range σ.map) ↦ (γ : PSL(2, ℝ)) • P.carrier := by
  have hP := σ.isLocalTiling hcyc
  have h := hP.locallyFinite_smul (σ.hasUniformTilingCharts_of_isParabolic hcyc hpar)
  rwa [σ.closure_biUnion_localNeighbors] at h

/-- **The cycle conditions characterize the tessellation.** The translates of a side-paired
polygon `P` by the group generated by the side-pairing maps are locally finite with disjoint
interiors if and only if every finite vertex cycle satisfies the angle condition and every ideal
vertex cycle transformation is parabolic. -/
theorem disjoint_smul_interior_carrier_and_locallyFinite_iff :
    ((∀ γ : Subgroup.closure (range σ.map), γ ≠ 1 →
        Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier)) ∧
      LocallyFinite fun γ : Subgroup.closure (range σ.map) ↦ (γ : PSL(2, ℝ)) • P.carrier) ↔
      (∀ j (z : ℍ), P.vertex j = .inl z →
        (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π) ∧
      ∀ j ξ, P.vertex j = .inr ξ → IsParabolic (σ.cycleMap j) := by
  have hmap (i : Fin n) : σ.map i ∈ Subgroup.closure (range σ.map) :=
    Subgroup.subset_closure (mem_range_self i)
  exact ⟨fun ⟨hdisj, hlf⟩ ↦ ⟨fun _ _ hz ↦ σ.orderOf_cycleMap_mul_cycleAngleSum hz hmap hdisj,
      fun j _ hj ↦ σ.isParabolic_cycleMap_of_locallyFinite hj (σ.cycleMap_mem hmap j) hlf⟩,
    fun ⟨hcyc, hpar⟩ ↦ ⟨σ.disjoint_smul_interior_carrier_of_isParabolic hcyc hpar,
      σ.locallyFinite_smul_carrier_of_isParabolic hcyc hpar⟩⟩

/-- **The angle condition characterizes no overlap for a compact side-paired polygon.** The
translates of the interior of a compact polygon `P` by the group generated by the side-pairing
maps are disjoint if and only if, at every vertex, the cycle transformation has finite order `m`
and the interior angles along the cycle add up to `2π / m`. -/
theorem disjoint_smul_interior_carrier_iff_of_isCompact (hc : IsCompact P.carrier) :
    (∀ γ : Subgroup.closure (range σ.map), γ ≠ 1 →
      Disjoint ((γ : PSL(2, ℝ)) • interior P.carrier) (interior P.carrier)) ↔
      ∀ j (z : ℍ), P.vertex j = .inl z →
        (orderOf (σ.cycleMap j) : ℝ) * σ.cycleAngleSum j = 2 * π :=
  ⟨fun hdisj _ _ hz ↦ σ.orderOf_cycleMap_mul_cycleAngleSum hz
      (fun i ↦ Subgroup.subset_closure (mem_range_self i)) hdisj,
    fun hcyc ↦ σ.disjoint_smul_interior_carrier_of_isParabolic hcyc fun _ _ hj ↦
      (P.not_isCompact_carrier_of_vertex_eq_inr hj hc).elim⟩

end TauCeti.UpperHalfPlane.ConvexPolygon.SidePairing
