module

public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.Convex.DoubleTriangle
public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.Relations
import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.SidePairing.CycleOrder

/-!
# The side pairing of the double of a hyperbolic triangle

Let `P` be a convex hyperbolic triangle, with vertices in `ℍ ∪ ∂ℍ`, whose interior angles at the
two ends `P 0`, `P 1` of side `0` are acute. Reflecting `P` in the geodesic line of side `0` gives
a second triangle, and together they form the convex quadrilateral `P.doubleTriangle` with
vertices `P 0`, `P 2'`, `P 1`, `P 2`, where `P 2'` is the mirror image of `P 2`
(`ConvexPolygon.carrier_doubleTriangle`, in
`TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.Convex.DoubleTriangle`).

Its sides are paired by orientation-preserving products of two reflections in sides of `P`
(`ConvexPolygon.doubleTriangleSidePairing`): the two sides at `P 0` by the product of the
reflections in sides `0` and `2`, which fixes `P 0`, and the two sides at `P 1` by the product of
the reflections in sides `1` and `0`, which fixes `P 1`. In the classical construction of
hyperbolic triangle groups, these two products generate the orientation-preserving subgroup of the
group generated by the reflections in the sides of a triangle with angles `π / p`, `π / q`,
`π / r`, and Poincaré's polygon theorem is applied to this side-paired quadrilateral. Another side
of `P` can be doubled by first relabelling the vertices with `ConvexPolygon.rotate`.

The vertex cycles of this pairing are `{P 0}`, `{P 1}` and `{P 2, P 2'}`. Their angle sums are
twice the angles of `P` at `P 0`, `P 1` and `P 2`. The cycle transformation at each vertex of `P`
is the product of the reflections in the two sides of `P` meeting there; at `P 2'` it is the
conjugate of the inverse of the one at `P 2` by the reflection in side `0`. So if `P` has angle
`π / m` at a vertex, the corresponding product of reflections has exact order `m`: these are the
relations of the triangle group.

## Main declarations

* `ConvexPolygon.doubleTriangleSidePairing`: the side pairing of `ConvexPolygon.doubleTriangle`
  by products of reflections.
* `ConvexPolygon.doubleTriangleSidePairing_cycleLength_zero` and its companions: the lengths of
  the vertex cycles.
* `ConvexPolygon.doubleTriangleSidePairing_cycleAngleSum_zero` and its companions: the cycle angle
  sums are twice the angles of `P`.
* `ConvexPolygon.doubleTriangleSidePairing_cycleWord`: the words read along the vertex cycles.
* `ConvexPolygon.doubleTriangleSidePairing_cycleMap_zero` and its companions: the cycle
  transformations as products of reflections.
* `ConvexPolygon.orderOf_doubleTriangleSidePairing_cycleMap_zero`,
  `ConvexPolygon.orderOf_doubleTriangleSidePairing_cycleMap_two`,
  `ConvexPolygon.orderOf_doubleTriangleSidePairing_cycleMap_three`: at a vertex of `P` with angle
  `π / m`, the cycle transformation has exact order `m`.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, Graduate Texts in Mathematics 91, Springer,
  1983, §10.6 (triangle groups, generated by products of reflections in the sides of a triangle,
  with fundamental polygon the union of the triangle and one of its reflections).
-/

public section

noncomputable section

open UpperHalfPlane
open scoped Real

namespace TauCeti.UpperHalfPlane.ConvexPolygon

variable (P : ConvexPolygon 3) (h₀ : P.interiorAngle 0 < π / 2) (h₁ : P.interiorAngle 1 < π / 2)

/-- **The side pairing of the double of a triangle.** Side `i` is paired with side `3 - i`. The
two sides at `P 0` are paired by the product of the reflections in sides `0` and `2` of `P`, which
fixes `P 0`, and the two sides at `P 1` by the product of the reflections in sides `1` and `0`,
which fixes `P 1`. -/
def doubleTriangleSidePairing : (P.doubleTriangle h₀ h₁).SidePairing where
  pair := Fin.revPerm
  pair_pair := Fin.rev_rev
  map := ![geodesicReflectionComp (P.sideGeodesic 2) (P.sideGeodesic 0),
    geodesicReflectionComp (P.sideGeodesic 1) (P.sideGeodesic 0),
    geodesicReflectionComp (P.sideGeodesic 0) (P.sideGeodesic 1),
    geodesicReflectionComp (P.sideGeodesic 0) (P.sideGeodesic 2)]
  map_pair i := by
    fin_cases i <;> simp [Fin.rev]
  map_smul_vertex i := by
    fin_cases i <;> simp [geodesicReflectionComp_smul_eq_extGeodesicReflection, Fin.rev]
  map_smul_vertex_add_one i := by
    fin_cases i <;> simp [geodesicReflectionComp_smul_eq_extGeodesicReflection, Fin.rev]

/-- The side pairing of the double of a triangle pairs side `i` with side `3 - i`. -/
@[simp]
theorem doubleTriangleSidePairing_pair :
    (P.doubleTriangleSidePairing h₀ h₁).pair = Fin.revPerm :=
  (rfl)

/-- The side-pairing maps of the double of a triangle are products of reflections in the sides of
the original triangle `P`. -/
@[simp]
theorem doubleTriangleSidePairing_map :
    (P.doubleTriangleSidePairing h₀ h₁).map =
      ![geodesicReflectionComp (P.sideGeodesic 2) (P.sideGeodesic 0),
        geodesicReflectionComp (P.sideGeodesic 1) (P.sideGeodesic 0),
        geodesicReflectionComp (P.sideGeodesic 0) (P.sideGeodesic 1),
        geodesicReflectionComp (P.sideGeodesic 0) (P.sideGeodesic 2)] :=
  (rfl)

/-! ### Vertex cycles -/

variable {P h₀ h₁}

/-- The vertex `P 0` of the double is a cycle of its own. -/
@[simp]
theorem doubleTriangleSidePairing_cycleLength_zero :
    (P.doubleTriangleSidePairing h₀ h₁).cycleLength 0 = 1 := by
  rw [SidePairing.cycleLength_def, Function.minimalPeriod_eq_one_iff_isFixedPt]
  simp [Function.IsFixedPt]

/-- The vertex `P 1` of the double is a cycle of its own. -/
@[simp]
theorem doubleTriangleSidePairing_cycleLength_two :
    (P.doubleTriangleSidePairing h₀ h₁).cycleLength 2 = 1 := by
  rw [SidePairing.cycleLength_def, Function.minimalPeriod_eq_one_iff_isFixedPt]
  simp [Function.IsFixedPt]

/-- The mirror image `P 2'` of `P 2` lies on a cycle of length `2`, together with `P 2`. -/
@[simp]
theorem doubleTriangleSidePairing_cycleLength_one :
    (P.doubleTriangleSidePairing h₀ h₁).cycleLength 1 = 2 := by
  rw [SidePairing.cycleLength_def]
  exact Function.minimalPeriod_eq_prime (by simp [Function.IsPeriodicPt, Function.IsFixedPt])
    (by simp [Function.IsFixedPt])

/-- The vertex `P 2` of the double lies on a cycle of length `2`, together with `P 2'`. -/
@[simp]
theorem doubleTriangleSidePairing_cycleLength_three :
    (P.doubleTriangleSidePairing h₀ h₁).cycleLength 3 = 2 := by
  rw [SidePairing.cycleLength_def]
  exact Function.minimalPeriod_eq_prime (by simp [Function.IsPeriodicPt, Function.IsFixedPt])
    (by simp [Function.IsFixedPt])

/-- The angle sum of the cycle at `P 0` is twice the angle of `P` there. -/
@[simp]
theorem doubleTriangleSidePairing_cycleAngleSum_zero :
    (P.doubleTriangleSidePairing h₀ h₁).cycleAngleSum 0 = 2 * P.interiorAngle 0 := by
  simp [SidePairing.cycleAngleSum_eq_sum_range, interiorAngle_doubleTriangle_zero]

/-- The angle sum of the cycle at `P 1` is twice the angle of `P` there. -/
@[simp]
theorem doubleTriangleSidePairing_cycleAngleSum_two :
    (P.doubleTriangleSidePairing h₀ h₁).cycleAngleSum 2 = 2 * P.interiorAngle 1 := by
  simp [SidePairing.cycleAngleSum_eq_sum_range, interiorAngle_doubleTriangle_two]

/-- The angle sum of the cycle through `P 2'` is twice the angle of `P` at `P 2`. -/
@[simp]
theorem doubleTriangleSidePairing_cycleAngleSum_one :
    (P.doubleTriangleSidePairing h₀ h₁).cycleAngleSum 1 = 2 * P.interiorAngle 2 := by
  simp [SidePairing.cycleAngleSum_eq_sum_range, Finset.sum_range_succ,
    interiorAngle_doubleTriangle_one, interiorAngle_doubleTriangle_three, two_mul]

/-- The angle sum of the cycle through `P 2` is twice the angle of `P` there. -/
@[simp]
theorem doubleTriangleSidePairing_cycleAngleSum_three :
    (P.doubleTriangleSidePairing h₀ h₁).cycleAngleSum 3 = 2 * P.interiorAngle 2 := by
  simp [SidePairing.cycleAngleSum_eq_sum_range, Finset.sum_range_succ,
    interiorAngle_doubleTriangle_one, interiorAngle_doubleTriangle_three, two_mul]

/-- The four cycle words of the doubled triangle, in vertex order. -/
@[simp]
theorem doubleTriangleSidePairing_cycleWord :
    (P.doubleTriangleSidePairing h₀ h₁).cycleWord =
      ![FreeGroup.of 0, FreeGroup.of 3 * FreeGroup.of 1,
        FreeGroup.of 2, FreeGroup.of 1 * FreeGroup.of 3] := by
  funext j
  fin_cases j <;> simp [SidePairing.cycleWord_def, SidePairing.partialCycleWord_succ,
    SidePairing.next_apply, Fin.rev]

/-- The cycle transformation at `P 0` is the product of the reflections in the sides `0` and `2`
of `P` meeting there. -/
@[simp]
theorem doubleTriangleSidePairing_cycleMap_zero :
    (P.doubleTriangleSidePairing h₀ h₁).cycleMap 0 =
      geodesicReflectionComp (P.sideGeodesic 2) (P.sideGeodesic 0) := by
  simp [SidePairing.cycleMap_def, SidePairing.partialCycleMap_succ]

/-- The cycle transformation at `P 1` is the product of the reflections in the sides `1` and `0`
of `P` meeting there. -/
@[simp]
theorem doubleTriangleSidePairing_cycleMap_two :
    (P.doubleTriangleSidePairing h₀ h₁).cycleMap 2 =
      geodesicReflectionComp (P.sideGeodesic 0) (P.sideGeodesic 1) := by
  simp [SidePairing.cycleMap_def, SidePairing.partialCycleMap_succ]

/-- The cycle transformation at `P 2` is the product of the reflections in the sides `2` and `1`
of `P` meeting there. -/
@[simp]
theorem doubleTriangleSidePairing_cycleMap_three :
    (P.doubleTriangleSidePairing h₀ h₁).cycleMap 3 =
      geodesicReflectionComp (P.sideGeodesic 1) (P.sideGeodesic 2) := by
  simp [SidePairing.cycleMap_def, SidePairing.partialCycleMap_succ]

/-- The cycle transformation at `P 2'` is the product of the reflections in the sides `1` and `2`
of `P`, the inverse of the one at `P 2`, conjugated by the reflection in side `0`. -/
@[simp]
theorem doubleTriangleSidePairing_cycleMap_one :
    (P.doubleTriangleSidePairing h₀ h₁).cycleMap 1 =
      geodesicReflectionComp (P.sideGeodesic 0) (P.sideGeodesic 2) *
        geodesicReflectionComp (P.sideGeodesic 1) (P.sideGeodesic 0) := by
  simp [SidePairing.cycleMap_def, SidePairing.partialCycleMap_succ]

/-! ### Orders of the cycle transformations -/

/-- At a vertex of the double that is a vertex of `P` with angle `π / m`, and whose cycle angle
sum is twice that angle, the cycle transformation has exact order `m`. -/
private theorem orderOf_doubleTriangleSidePairing_cycleMap {j : Fin 4} {i : Fin 3}
    (hj : (P.doubleTriangle h₀ h₁).vertex j = P.vertex i)
    (hsum : (P.doubleTriangleSidePairing h₀ h₁).cycleAngleSum j = 2 * P.interiorAngle i)
    {m : ℕ} (hm : m ≠ 0) (hP : P.interiorAngle i = π / m) :
    orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap j) = m := by
  rcases hv : P.vertex i with z | ξ
  · refine SidePairing.orderOf_cycleMap_of_cycleAngleSum _ (hj.trans hv) ?_
    rw [hsum, hP]
    ring
  · rw [P.interiorAngle_eq_zero_of_vertex_eq_inr hv] at hP
    exact absurd hP.symm (div_pos Real.pi_pos (Nat.cast_pos.2 (Nat.pos_of_ne_zero hm))).ne'

/-- **The relation at `P 0`.** If `P` has angle `π / m` at `P 0`, the cycle transformation of the
double there, the product of the reflections in the sides `0` and `2` of `P`, has exact order
`m`. -/
theorem orderOf_doubleTriangleSidePairing_cycleMap_zero {m : ℕ} (hm : m ≠ 0)
    (hP : P.interiorAngle 0 = π / m) :
    orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap 0) = m :=
  orderOf_doubleTriangleSidePairing_cycleMap (i := 0) (by simp)
    doubleTriangleSidePairing_cycleAngleSum_zero hm hP

/-- **The relation at `P 1`.** If `P` has angle `π / m` at `P 1`, the cycle transformation of the
double there, the product of the reflections in the sides `1` and `0` of `P`, has exact order
`m`. -/
theorem orderOf_doubleTriangleSidePairing_cycleMap_two {m : ℕ} (hm : m ≠ 0)
    (hP : P.interiorAngle 1 = π / m) :
    orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap 2) = m :=
  orderOf_doubleTriangleSidePairing_cycleMap (i := 1) (by simp)
    doubleTriangleSidePairing_cycleAngleSum_two hm hP

/-- **The relation at `P 2`.** If `P` has angle `π / m` at `P 2`, the cycle transformation of the
double there, the product of the reflections in the sides `2` and `1` of `P`, has exact order
`m`. -/
theorem orderOf_doubleTriangleSidePairing_cycleMap_three {m : ℕ} (hm : m ≠ 0)
    (hP : P.interiorAngle 2 = π / m) :
    orderOf ((P.doubleTriangleSidePairing h₀ h₁).cycleMap 3) = m :=
  orderOf_doubleTriangleSidePairing_cycleMap (i := 2) (by simp)
    doubleTriangleSidePairing_cycleAngleSum_three hm hP

end TauCeti.UpperHalfPlane.ConvexPolygon
