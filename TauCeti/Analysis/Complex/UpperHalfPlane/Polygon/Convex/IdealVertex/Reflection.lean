module

public import TauCeti.Analysis.Complex.UpperHalfPlane.Geodesic.Reflection
public import TauCeti.Analysis.Complex.UpperHalfPlane.Polygon.Convex
import TauCeti.Data.Fin.Basic

/-!
# Reflections in the sides at an ideal vertex

At an ideal vertex `ξ` of a convex hyperbolic polygon, the geodesic lines of the two sides meeting
there both end at `ξ`, and they are distinct because the polygon is strictly convex. The product
of the reflections in two distinct lines with a common ideal endpoint is parabolic
(`TauCeti.UpperHalfPlane.isParabolic_geodesicReflectionComp_iff`): after moving `ξ` to `∞` the
lines are vertical, and the product is a nontrivial translation.

In a hyperbolic triangle group, generated by products of reflections in the sides of a triangle,
this identifies the transformations at the ideal vertices of the triangle as parabolic. These are
the cycle transformations of the ideal vertices of the doubled triangle, and Poincaré's polygon
theorem requires them to be parabolic.

## Main result

* `ConvexPolygon.isParabolic_geodesicReflectionComp_sideGeodesic`: at an ideal vertex, the
  product of the reflections in the two incident sides is parabolic.

## References

* Alan Beardon, *The Geometry of Discrete Groups*, Graduate Texts in Mathematics 91, Springer,
  1983, §7.1 (products of two reflections, classified by the relative position of their lines)
  and §10.6 (triangle groups).
-/

public section

open Matrix.ProjectiveSpecialLinearGroup (IsParabolic)
open scoped OnePoint

namespace TauCeti.UpperHalfPlane.ConvexPolygon

variable {n : ℕ} [NeZero n] (P : ConvexPolygon n)

/-- **Reflections in the sides at an ideal vertex.** At an ideal vertex `vertex j` of a convex
polygon, the product of the reflections in the lines of the two sides meeting there, first in
that of side `j` and then in that of side `j - 1`, is parabolic. -/
theorem isParabolic_geodesicReflectionComp_sideGeodesic {j : Fin n} {ξ : OnePoint ℝ}
    (hj : P.vertex j = .inr ξ) :
    IsParabolic (geodesicReflectionComp (P.sideGeodesic (j - 1)) (P.sideGeodesic j)) := by
  -- both lines run to `ξ`: side `j - 1` from `vertex (j - 1)`, and side `j` reversed from
  -- `vertex (j + 1)`
  have hg : IsGeodesicFromTo (P.sideGeodesic (j - 1)) (P.vertex (j - 1)) (.inr ξ) := by
    simpa only [sub_add_cancel, hj] using P.isGeodesicFromTo_sideGeodesic (j - 1)
  have hh : IsGeodesicFromTo (P.sideGeodesic j * pslS) (P.vertex (j + 1)) (.inr ξ) :=
    isGeodesicFromTo_mul_pslS_iff.2 (hj ▸ P.isGeodesicFromTo_sideGeodesic j)
  have h₁ := hg.smul_infty_eq.trans hh.smul_infty_eq.symm
  rw [← geodesicReflectionComp_mul_pslS_right, isParabolic_geodesicReflectionComp_iff h₁]
  -- if the lines had the same endpoints, `vertex (j + 1)`, which lies on the line of side `j`,
  -- would not be strictly to the left of side `j - 1`
  intro h₀
  obtain ⟨s, hs⟩ := exists_eq_mul_dilation_of_smul_zero_eq_of_smul_infty_eq h₀ h₁
  have hleft := P.vertex_mem_extLeftHalfPlane_sideGeodesic (i := j - 1) (j := j + 1)
    (add_one_ne_sub_one P.three_le j)
    (by rw [sub_add_cancel]; exact add_one_ne_self (Nat.le_of_succ_le P.three_le) j)
  rw [(hg.mul_dilation s).extLeftHalfPlane_eq hg, ← hs] at hleft
  exact hh.left_notMem_extLeftHalfPlane hleft

end TauCeti.UpperHalfPlane.ConvexPolygon
