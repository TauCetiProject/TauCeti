import TauCeti.GroupTheory.SpecificGroups.Dihedral.Basic

/-!
# Finite groups of linear isometries of the plane

Mathlib's `linear_isometry_complex` says that every real linear isometry `f : ℂ ≃ₗᵢ[ℝ] ℂ` is a
rotation `v ↦ a v` or a rotation composed with complex conjugation. This file names the second
kind, `TauCeti.Complex.conjReflection b : v ↦ b · conj v`, the reflection in the line spanned by a
square root of `b`, and studies subgroups `G` of `ℂ ≃ₗᵢ[ℝ] ℂ` through their rotations.

## Main definitions

* `TauCeti.Complex.conjReflection b`: the reflection `v ↦ b · conj v`.
* `TauCeti.Complex.rotationSubgroup G`: the unit complex numbers `a` whose rotation `v ↦ a v`
  lies in `G`.

## Main results

* `TauCeti.Complex.exists_eq_rotation_or_eq_conjReflection`: every isometry is a rotation or a
  reflection; the products of rotations and reflections are computed by `simp`
  (`conjReflection_mul_conjReflection`, `conjReflection_mul_rotation`,
  `rotation_mul_conjReflection`), and a reflection is never a rotation
  (`conjReflection_ne_rotation`).
* `TauCeti.Complex.mem_iff_of_conjReflection_mem`: if `G` contains the reflection
  `conjReflection c`, its elements are the rotations by the rotation subgroup and the reflections
  `conjReflection (a c)` for `a` in the rotation subgroup.
* `TauCeti.Complex.rotationSubgroup_closure_image_conjReflection`: the rotation subgroup of the
  group generated by reflections `conjReflection b`, `b ∈ B`, is generated by the quotients
  `b b'⁻¹`, `b, b' ∈ B`.
* `TauCeti.Complex.finite_iff_finite_rotationSubgroup`: `G` is finite exactly when its rotation
  subgroup is; a finite rotation subgroup is cyclic, by `Circle.isCyclic_of_finite`.
* `TauCeti.Complex.nonempty_mulEquiv_dihedralGroup`: **a finite group of isometries containing a
  reflection is dihedral**, `G ≃* DihedralGroup N` for `N` the order of its rotation subgroup,
  so `Nat.card G = 2 N` (`natCard_eq_two_mul_natCard_rotationSubgroup`).

These facts are used by `TauCeti/Dynamics/Billiard/ReflectionGroup.lean` for the reflection
group of a polygonal billiard table.
-/

public section

noncomputable section

open Complex ComplexConjugate

namespace TauCeti.Complex

/-! ### Rotations and reflections -/

/-- The reflection `v ↦ b · conj v`, in the line spanned by a square root of `b`. -/
def conjReflection (b : Circle) : ℂ ≃ₗᵢ[ℝ] ℂ :=
  conjLIE.trans (rotation b)

/-- The reflection `conjReflection b` is complex conjugation followed by the rotation by `b`. -/
theorem conjReflection_def (b : Circle) : conjReflection b = conjLIE.trans (rotation b) :=
  (rfl)

@[simp]
theorem conjReflection_apply (b : Circle) (z : ℂ) : conjReflection b z = b * conj z := by
  rw [conjReflection_def, LinearIsometryEquiv.trans_apply, rotation_apply, conjLIE_apply]

/-- Every real linear isometry of `ℂ` is a rotation or a reflection. -/
theorem exists_eq_rotation_or_eq_conjReflection (f : ℂ ≃ₗᵢ[ℝ] ℂ) :
    (∃ a, f = rotation a) ∨ ∃ b, f = conjReflection b := by
  obtain ⟨a, h | h⟩ := linear_isometry_complex f
  · exact Or.inl ⟨a, h⟩
  · exact Or.inr ⟨a, h⟩

@[simp]
theorem conjReflection_one : conjReflection 1 = conjLIE := by
  rw [conjReflection_def, map_one, LinearIsometryEquiv.one_def, LinearIsometryEquiv.trans_refl]

theorem conjReflection_injective : Function.Injective conjReflection := fun a b h =>
  Circle.coe_injective (by simpa using DFunLike.congr_fun h 1)

@[simp]
theorem conjReflection_inj {a b : Circle} : conjReflection a = conjReflection b ↔ a = b :=
  conjReflection_injective.eq_iff

/-- The product of two reflections is a rotation. -/
@[simp]
theorem conjReflection_mul_conjReflection (a b : Circle) :
    conjReflection b * conjReflection a = rotation (b * a⁻¹) := by
  ext z
  simp only [LinearIsometryEquiv.coe_mul, Function.comp_apply, conjReflection_apply, rotation_apply,
    map_mul, Complex.conj_conj, Circle.coe_inv_eq_conj]

/-- A rotation followed by a reflection is a reflection. -/
@[simp]
theorem conjReflection_mul_rotation (a b : Circle) :
    conjReflection b * rotation a = conjReflection (b * a⁻¹) := by
  ext z
  simp only [LinearIsometryEquiv.coe_mul, Function.comp_apply, conjReflection_apply, rotation_apply,
    map_mul, Circle.coe_mul, Circle.coe_inv_eq_conj]
  ring

/-- A reflection followed by a rotation is a reflection. -/
@[simp]
theorem rotation_mul_conjReflection (a b : Circle) :
    rotation a * conjReflection b = conjReflection (a * b) := by
  ext z
  simp only [LinearIsometryEquiv.coe_mul, Function.comp_apply, conjReflection_apply, rotation_apply,
    Circle.coe_mul]
  ring

/-- A reflection is not a rotation. -/
@[simp]
theorem conjReflection_ne_rotation (a b : Circle) : conjReflection b ≠ rotation a := by
  intro h
  have h' := congrArg (rotation b⁻¹ * ·) h
  simp only [rotation_mul_conjReflection, inv_mul_cancel, conjReflection_one, ← map_mul] at h'
  exact rotation_ne_conjLIE _ h'.symm

/-- A rotation is not a reflection. -/
@[simp]
theorem rotation_ne_conjReflection (a b : Circle) : rotation a ≠ conjReflection b :=
  (conjReflection_ne_rotation a b).symm

/-- A reflection is an involution. -/
theorem conjReflection_mul_self (b : Circle) : conjReflection b * conjReflection b = 1 := by
  rw [conjReflection_mul_conjReflection, mul_inv_cancel, map_one]

@[simp]
theorem conjReflection_inv (b : Circle) : (conjReflection b)⁻¹ = conjReflection b :=
  inv_eq_of_mul_eq_one_right (conjReflection_mul_self b)

@[simp]
theorem conjReflection_symm (b : Circle) : (conjReflection b).symm = conjReflection b :=
  conjReflection_inv b

/-! ### The rotation subgroup -/

/-- The rotation subgroup of a group `G` of real linear isometries of `ℂ`: the unit complex
numbers `a` whose rotation `v ↦ a v` lies in `G`. -/
def rotationSubgroup (G : Subgroup (ℂ ≃ₗᵢ[ℝ] ℂ)) : Subgroup Circle :=
  G.comap rotation

@[simp]
theorem mem_rotationSubgroup {G : Subgroup (ℂ ≃ₗᵢ[ℝ] ℂ)} {a : Circle} :
    a ∈ rotationSubgroup G ↔ rotation a ∈ G :=
  Iff.rfl

variable {G : Subgroup (ℂ ≃ₗᵢ[ℝ] ℂ)}

/-- If `G` contains the reflection `conjReflection c`, it contains the reflection
`conjReflection b` exactly when it contains the rotation by `b c⁻¹`. -/
theorem conjReflection_mem_iff {b c : Circle} (hc : conjReflection c ∈ G) :
    conjReflection b ∈ G ↔ b * c⁻¹ ∈ rotationSubgroup G := by
  rw [mem_rotationSubgroup, ← conjReflection_mul_conjReflection, G.mul_mem_cancel_right hc]

/-- If `G` contains the reflection `conjReflection c`, its elements are the rotations by elements
of its rotation subgroup and the reflections `conjReflection (a c)` for `a` in its rotation
subgroup. -/
theorem mem_iff_of_conjReflection_mem {c : Circle} (hc : conjReflection c ∈ G)
    {f : ℂ ≃ₗᵢ[ℝ] ℂ} :
    f ∈ G ↔ (∃ a ∈ rotationSubgroup G, rotation a = f) ∨
      ∃ a ∈ rotationSubgroup G, conjReflection (a * c) = f := by
  constructor
  · intro hf
    rcases exists_eq_rotation_or_eq_conjReflection f with ⟨a, rfl⟩ | ⟨b, rfl⟩
    · exact Or.inl ⟨a, mem_rotationSubgroup.2 hf, rfl⟩
    · exact Or.inr ⟨_, (conjReflection_mem_iff hc).1 hf, by simp⟩
  · rintro (⟨a, ha, rfl⟩ | ⟨a, ha, rfl⟩)
    · exact mem_rotationSubgroup.1 ha
    · rw [← rotation_mul_conjReflection]
      exact G.mul_mem (mem_rotationSubgroup.1 ha) hc

/-- **The rotation subgroup of a group generated by reflections** `conjReflection b`, `b ∈ B`, is
generated by the quotients `b b'⁻¹`, `b, b' ∈ B`: `conjReflection b * conjReflection b'` is the
rotation by `b b'⁻¹`. -/
theorem rotationSubgroup_closure_image_conjReflection (B : Set Circle) :
    rotationSubgroup (Subgroup.closure (conjReflection '' B)) =
      Subgroup.closure {c | ∃ b ∈ B, ∃ b' ∈ B, c = b * b'⁻¹} := by
  set K := Subgroup.closure {c : Circle | ∃ b ∈ B, ∃ b' ∈ B, c = b * b'⁻¹}
  -- Every element of the group is a rotation by `K` or a reflection `conjReflection b` with
  -- `b b₀⁻¹ ∈ K` for some `b₀ ∈ B`.
  have key {f : ℂ ≃ₗᵢ[ℝ] ℂ} (hf : f ∈ Subgroup.closure (conjReflection '' B)) :
      (∃ a ∈ K, f = rotation a) ∨ ∃ b, (∃ b₀ ∈ B, b * b₀⁻¹ ∈ K) ∧ f = conjReflection b := by
    induction hf using Subgroup.closure_induction with
    | mem f hf =>
      obtain ⟨b, hb, rfl⟩ := hf
      exact Or.inr ⟨b, ⟨b, hb, by simp [K.one_mem]⟩, rfl⟩
    | one => exact Or.inl ⟨1, K.one_mem, (map_one rotation).symm⟩
    | mul f g _ _ hf hg =>
      rcases hf with ⟨a₁, ha₁, rfl⟩ | ⟨b₁, ⟨d₁, hd₁, hb₁⟩, rfl⟩ <;>
        rcases hg with ⟨a₂, ha₂, rfl⟩ | ⟨b₂, ⟨d₂, hd₂, hb₂⟩, rfl⟩
      · exact Or.inl ⟨a₁ * a₂, K.mul_mem ha₁ ha₂, (map_mul rotation a₁ a₂).symm⟩
      · refine Or.inr ⟨a₁ * b₂, ⟨d₂, hd₂, ?_⟩, rotation_mul_conjReflection a₁ b₂⟩
        rw [mul_assoc]
        exact K.mul_mem ha₁ hb₂
      · refine Or.inr ⟨b₁ * a₂⁻¹, ⟨d₁, hd₁, ?_⟩, conjReflection_mul_rotation a₂ b₁⟩
        rw [mul_right_comm]
        exact K.mul_mem hb₁ (K.inv_mem ha₂)
      · refine Or.inl ⟨b₁ * b₂⁻¹, ?_, conjReflection_mul_conjReflection b₂ b₁⟩
        have hd : d₁ * d₂⁻¹ ∈ K := Subgroup.subset_closure ⟨d₁, hd₁, d₂, hd₂, rfl⟩
        convert K.mul_mem (K.mul_mem hb₁ hd) (K.inv_mem hb₂) using 1
        group
    | inv f _ hf =>
      rcases hf with ⟨a, ha, rfl⟩ | ⟨b, hb, rfl⟩
      · exact Or.inl ⟨a⁻¹, K.inv_mem ha, (map_inv rotation a).symm⟩
      · exact Or.inr ⟨b, hb, conjReflection_inv b⟩
  refine le_antisymm (fun a ha => ?_) ((Subgroup.closure_le _).2 ?_)
  · rcases key (mem_rotationSubgroup.1 ha) with ⟨a', ha', h⟩ | ⟨b, -, h⟩
    · rwa [rotation_injective h]
    · exact absurd h.symm (conjReflection_ne_rotation a b)
  · rintro c ⟨b, hb, b', hb', rfl⟩
    rw [SetLike.mem_coe, mem_rotationSubgroup, ← conjReflection_mul_conjReflection]
    exact Subgroup.mul_mem _ (Subgroup.subset_closure (Set.mem_image_of_mem _ hb))
      (Subgroup.subset_closure (Set.mem_image_of_mem _ hb'))

instance finite_rotationSubgroup [Finite G] : Finite (rotationSubgroup G) :=
  Finite.of_injective _ (rotation.subgroupComap_injective G rotation_injective)

/-- A group of real linear isometries of `ℂ` is finite exactly when its rotation subgroup is: its
reflections, if any, are `conjReflection (a c)` for a fixed reflection `conjReflection c` and `a`
in the rotation subgroup. -/
theorem finite_iff_finite_rotationSubgroup : Finite G ↔ Finite (rotationSubgroup G) := by
  refine ⟨fun _ => inferInstance, fun hK => ?_⟩
  by_cases h : ∃ c, conjReflection c ∈ G
  · obtain ⟨c, hc⟩ := h
    have hsub : (G : Set (ℂ ≃ₗᵢ[ℝ] ℂ)) ⊆ Set.range (Sum.elim
        (fun a : rotationSubgroup G => rotation (a : Circle))
        fun a : rotationSubgroup G => conjReflection ((a : Circle) * c)) := by
      intro f hf
      rcases (mem_iff_of_conjReflection_mem hc).1 hf with ⟨a, ha, rfl⟩ | ⟨a, ha, rfl⟩
      · exact ⟨.inl ⟨a, ha⟩, rfl⟩
      · exact ⟨.inr ⟨a, ha⟩, rfl⟩
    exact ((Set.finite_range _).subset hsub).to_subtype
  · simp only [not_exists] at h
    have hsub : (G : Set (ℂ ≃ₗᵢ[ℝ] ℂ)) ⊆
        Set.range fun a : rotationSubgroup G => rotation (a : Circle) := by
      intro f hf
      rcases exists_eq_rotation_or_eq_conjReflection f with ⟨a, rfl⟩ | ⟨b, rfl⟩
      · exact ⟨⟨a, mem_rotationSubgroup.2 hf⟩, rfl⟩
      · exact absurd hf (h b)
    exact ((Set.finite_range _).subset hsub).to_subtype

/-- **A finite group of isometries containing a reflection is dihedral.** A finite group `G` of
real linear isometries of `ℂ` containing a reflection is isomorphic to the dihedral group of order
`2N`, where `N` is the order of its rotation subgroup. -/
theorem nonempty_mulEquiv_dihedralGroup [Finite G] {b : Circle} (hb : conjReflection b ∈ G) :
    Nonempty (G ≃* DihedralGroup (Nat.card (rotationSubgroup G))) := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := rotationSubgroup G)
  -- The rotations of `G`, as an injective homomorphism from its rotation subgroup.
  obtain ⟨φ, hφ, hφi⟩ : ∃ φ : rotationSubgroup G →* G,
      (∀ a, (φ a : ℂ ≃ₗᵢ[ℝ] ℂ) = rotation a) ∧ Function.Injective φ :=
    ⟨rotation.subgroupComap G, fun _ => rfl, rotation.subgroupComap_injective G rotation_injective⟩
  -- The reflection `s` and the reflection `t = s ρ`, `ρ` a generating rotation.
  set s : G := ⟨conjReflection b, hb⟩
  set t : G := s * φ g
  have hs : s * s = 1 := Subtype.ext (conjReflection_mul_self b)
  have ht : t * t = 1 := Subtype.ext (by simp [t, s, hφ])
  have hs1 : s ≠ 1 := fun h =>
    conjReflection_ne_rotation 1 b (by simpa [s] using congrArg Subtype.val h)
  have ht1 : t ≠ 1 := fun h => conjReflection_ne_rotation 1 (b * (g : Circle)⁻¹)
    (by simpa [t, s, hφ] using congrArg Subtype.val h)
  have hst : s * t = φ g := by rw [← mul_assoc, hs, one_mul]
  have hN : orderOf (s * t) = Nat.card (rotationSubgroup G) := by
    rw [hst, orderOf_injective _ hφi, orderOf_eq_card_of_forall_mem_zpowers hg]
  have hrot (a : rotationSubgroup G) : φ a ∈ Subgroup.closure {s, t} := by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hg a)
    rw [map_zpow, ← hst]
    exact zpow_mem (Subgroup.mul_mem _ (Subgroup.subset_closure (by simp))
      (Subgroup.subset_closure (by simp))) k
  have hgen : Subgroup.closure ({s, t} : Set G) = ⊤ := by
    refine eq_top_iff.2 fun ⟨f, hf⟩ _ => ?_
    rcases (mem_iff_of_conjReflection_mem hb).1 hf with ⟨a, ha, rfl⟩ | ⟨a, ha, rfl⟩
    · rw [show (⟨rotation a, hf⟩ : G) = φ ⟨a, ha⟩ from Subtype.ext (hφ ⟨a, ha⟩).symm]
      exact hrot _
    · rw [show (⟨conjReflection (a * b), hf⟩ : G) = φ ⟨a, ha⟩ * s from
        Subtype.ext (by simp [s, hφ])]
      exact Subgroup.mul_mem _ (hrot _) (Subgroup.subset_closure (by simp))
  exact ⟨(dihedralGroupMulEquiv hs ht hs1 ht1 hN hgen).symm⟩

/-- A group of isometries containing a reflection has twice as many elements as its rotation
subgroup. (When it is infinite, so is its rotation subgroup, and both cardinalities are `0`.) -/
theorem natCard_eq_two_mul_natCard_rotationSubgroup {b : Circle} (hb : conjReflection b ∈ G) :
    Nat.card G = 2 * Nat.card (rotationSubgroup G) := by
  by_cases hG : Finite G
  · obtain ⟨e⟩ := nonempty_mulEquiv_dihedralGroup hb
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  · have : Infinite G := not_finite_iff_infinite.1 hG
    have : Infinite (rotationSubgroup G) :=
      not_finite_iff_infinite.1 (finite_iff_finite_rotationSubgroup.not.1 hG)
    rw [Nat.card_eq_zero_of_infinite, Nat.card_eq_zero_of_infinite]

end TauCeti.Complex
