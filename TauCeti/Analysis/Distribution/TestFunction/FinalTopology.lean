module

public import Mathlib.Analysis.Distribution.TestFunction
public import TauCeti.Analysis.LocallyConvex.FinalTopology

/-!
# The native test-function topology as a final locally convex topology

The general final locally convex construction recovers Mathlib's native LF test-function
topology from its fixed-compact inclusions. Consequently comparisons with other presentations
can use continuous stage factorizations without replacing the native test-function carrier or
its topology. The statement includes finite regularity and arbitrary normed real coefficient
spaces.

This comparison uses Mathlib's `TestFunction.continuous_iff_continuous_comp` and
`TestFunction.continuous_ofSupportedIn`, the universal property and continuity of the native
fixed-support inclusions.
-/

public section

noncomputable section

open TopologicalSpace
open scoped Distributions

namespace TestFunction

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] (Ω : Opens E) (n : ℕ∞)

/-- The final locally convex topology generated by all native fixed-support inclusions is
exactly the native LF topology, not the final topology of topological spaces. -/
theorem finalLocallyConvexTopology_eq :
    TauCeti.finalLocallyConvexTopology
      (fun K : {K : Compacts E // (K : Set E) ⊆ Ω} ↦
        (ofSupportedInCLM ℝ K.2 : 𝓓^{n}_{K.1}(E, F) →L[ℝ] 𝓓^{n}(Ω, F)).toLinearMap) =
      topologicalSpace Ω F n := by
  let f := fun K : {K : Compacts E // (K : Set E) ⊆ Ω} ↦
    (ofSupportedInCLM ℝ K.2 : 𝓓^{n}_{K.1}(E, F) →L[ℝ] 𝓓^{n}(Ω, F)).toLinearMap
  apply le_antisymm ((TauCeti.FinalLocallyConvexTopology.le_iff f _).2 fun K ↦
    (ofSupportedInCLM ℝ K.2).continuous)
  have hid : @Continuous 𝓓^{n}(Ω, F) 𝓓^{n}(Ω, F) (topologicalSpace Ω F n)
      (TauCeti.finalLocallyConvexTopology f) id := by
    let := TauCeti.finalLocallyConvexTopology f
    apply (TestFunction.continuous_iff_continuous_comp
      (LinearMap.id : 𝓓^{n}(Ω, F) →ₗ[ℝ] 𝓓^{n}(Ω, F))).2
    intro K hK
    exact TauCeti.FinalLocallyConvexTopology.continuous f ⟨K, hK⟩
  exact (@continuous_id_iff_le _ (topologicalSpace Ω F n)
    (TauCeti.finalLocallyConvexTopology f)).1 hid

end TestFunction
