/-!
# The semigroup generated by `EVI_λ` solutions

Let `φ : X → EReal` be a lower semicontinuous energy on a metric space and `λ : ℝ`. An `EVI_λ`
solution is determined by its initial point (`TauCeti.IsEVISolution.eqOn`), and a time translate
`t ↦ u (t + s)` of a solution is again a solution (`TauCeti.IsEVISolution.comp_add_const`). So
the solutions define an evolution `S_t x = u t`, for `u` the solution with `u 0 = x`, which is a
semigroup, `S_{s + t} = S_s ∘ S_t`, and a `λ`-contraction,
`d(S_t x, S_t y) ≤ e^{-λt} d(x, y)`. This is the gradient flow of `φ` in its `EVI_λ` formulation.

The evolution is defined on the set `TauCeti.eviDomain λ φ` of points from which an `EVI_λ`
solution starts, and nothing is assumed about this set. Since solutions have finite energy at
positive times, it lies in the closure of the effective domain `{x | φ x ≠ ⊤}`. Existence of
solutions is a separate problem: Ambrosio–Gigli–Savaré (Theorem 4.0.4) prove that on a complete
space every point of that closure starts a solution, for a lower semicontinuous energy satisfying
their convexity Assumption 4.0.1, as `λ`-convex energies along generalized geodesics do. Time
translation makes the set invariant: the flow stays in `TauCeti.eviDomain λ φ`, and by
contraction and continuity in time it is a continuous semiflow there, in the sense of Mathlib's
`Flow`.

## Main definitions

* `TauCeti.eviDomain λ φ`: the set of initial points of `EVI_λ` solutions for `φ`.
* `TauCeti.eviFlow λ φ t x`: the point at time `t ≥ 0` of the `EVI_λ` solution starting at
  `x ∈ TauCeti.eviDomain λ φ`, and `x` itself if there is no such solution.
* `TauCeti.eviSemiflow λ hφ`: for a lower semicontinuous energy on a metric space, the evolution
  as a continuous semiflow `Flow ℝ≥0 (TauCeti.eviDomain λ φ)`.

## Main results

* `TauCeti.eviDomain_subset_closure`: initial points of solutions lie in the closure of the
  effective domain of `φ`.
* `TauCeti.isEVISolution_eviFlow`: from a point of `TauCeti.eviDomain λ φ` the flow is an
  `EVI_λ` solution, and `TauCeti.IsEVISolution.eviFlow_eq`: on a metric space it is the solution
  from that point, for a lower semicontinuous energy.
* `TauCeti.eviFlow_add`: the semigroup law `S_{s + t} x = S_s (S_t x)`.
* `TauCeti.dist_eviFlow_le` and `TauCeti.lipschitzOnWith_eviFlow`: the `λ`-contraction estimate.
* `TauCeti.continuousOn_uncurry_eviFlow`: joint continuity of `(t, x) ↦ S_t x`.
* `TauCeti.eviFlow_half_norm_sq`: on a real inner product space, the flow of `‖x‖² / 2` is
  `S_t x = e⁻ᵗ x`.

## Implementation notes

The time variable of the flow is `t : ℝ≥0`, so that the semigroup law needs no sign conditions,
while an `EVI_λ` solution is a curve `ℝ → X`; the two are related by `t ↦ S_{t.toNNReal} x`
(`TauCeti.isEVISolution_eviFlow`).

## References

* L. Ambrosio, N. Gigli, G. Savaré, *Gradient Flows in Metric Spaces and in the Space of
  Probability Measures*, 2nd ed., Birkhäuser 2008, Chapter 4, Theorem 4.0.4.
* M. Muratori, G. Savaré, *Gradient flows and evolution variational inequalities in metric
  spaces. I: Structural properties*, J. Funct. Anal. 278 (2020), Section 3.
-/

public section

open Filter Set Topology Real NNReal Function

namespace TauCeti

variable {X : Type*}

section PseudoMetricSpace

variable [PseudoMetricSpace X] {lam : ℝ} {φ : X → EReal} {u : ℝ → X} {x y : X}

/-- The set of initial points of `EVI_λ` solutions for the energy `φ`, where `λ = lam`. -/
def eviDomain (lam : ℝ) (φ : X → EReal) : Set X :=
  {x | ∃ u, IsEVISolution lam φ u ∧ u 0 = x}

/-- A point lies in `TauCeti.eviDomain λ φ` when some `EVI_λ` solution starts there. -/
@[simp]
theorem mem_eviDomain : x ∈ eviDomain lam φ ↔ ∃ u, IsEVISolution lam φ u ∧ u 0 = x :=
  Iff.rfl

/-- An initial point of an `EVI_λ` solution is a limit of points of finite energy. -/
theorem eviDomain_subset_closure : eviDomain lam φ ⊆ closure {x | φ x ≠ ⊤} := by
  rintro _ ⟨u, hu, rfl⟩
  exact mem_closure_of_tendsto
    ((hu.continuousOn 0 self_mem_Ici).tendsto.mono_left (nhdsWithin_mono _ Ioi_subset_Ici_self))
    (eventually_nhdsWithin_of_forall fun t (ht : 0 < t) ↦ hu.apply_ne_top ht)

/-- Every point of an `EVI_λ` solution at a time `t ≥ 0` starts an `EVI_λ` solution, its time
translate. -/
theorem IsEVISolution.apply_mem_eviDomain (h : IsEVISolution lam φ u) {t : ℝ} (ht : 0 ≤ t) :
    u t ∈ eviDomain lam φ :=
  ⟨fun r ↦ u (r + t), h.comp_add_const ht, by simp⟩

open scoped Classical in
/-- The `EVI_λ` flow of the energy `φ`, where `λ = lam`: `eviFlow lam φ t x` is the point at
time `t` of a chosen `EVI_λ` solution starting at `x`, if there is one, and `x` otherwise. For a
lower semicontinuous energy on a metric space the solution is unique
(`TauCeti.IsEVISolution.eviFlow_eq`), so no choice is involved. -/
noncomputable def eviFlow (lam : ℝ) (φ : X → EReal) (t : ℝ≥0) (x : X) : X :=
  if hx : x ∈ eviDomain lam φ then (mem_eviDomain.1 hx).choose t else x

/-- From a point of `TauCeti.eviDomain λ φ`, the flow follows an `EVI_λ` solution. -/
private theorem exists_isEVISolution_eviFlow_eq (hx : x ∈ eviDomain lam φ) :
    ∃ u, IsEVISolution lam φ u ∧ u 0 = x ∧ ∀ t : ℝ≥0, eviFlow lam φ t x = u t := by
  classical
  obtain ⟨hu, hu0⟩ := (mem_eviDomain.1 hx).choose_spec
  exact ⟨_, hu, hu0, fun t ↦ by simp [eviFlow, hx]⟩

/-- Off `TauCeti.eviDomain λ φ` the flow is the identity. -/
theorem eviFlow_of_notMem (hx : x ∉ eviDomain lam φ) (t : ℝ≥0) : eviFlow lam φ t x = x := by
  simp [eviFlow, hx]

/-- At time `0` the flow is the identity. -/
@[simp]
theorem eviFlow_zero (x : X) : eviFlow lam φ 0 x = x := by
  by_cases hx : x ∈ eviDomain lam φ
  · obtain ⟨u, -, hu0, hflow⟩ := exists_isEVISolution_eviFlow_eq hx
    rw [hflow, NNReal.coe_zero, hu0]
  · exact eviFlow_of_notMem hx 0

/-- From a point `x` of `TauCeti.eviDomain λ φ`, the curve `t ↦ S_t x` is an `EVI_λ`
solution. -/
theorem isEVISolution_eviFlow (hx : x ∈ eviDomain lam φ) :
    IsEVISolution lam φ fun t ↦ eviFlow lam φ t.toNNReal x := by
  obtain ⟨u, hu, -, hflow⟩ := exists_isEVISolution_eviFlow_eq hx
  exact hu.congr fun t (ht : 0 ≤ t) ↦ by rw [hflow, Real.coe_toNNReal t ht]

/-- The flow is continuous in time. -/
theorem continuous_eviFlow (x : X) : Continuous fun t : ℝ≥0 ↦ eviFlow lam φ t x := by
  by_cases hx : x ∈ eviDomain lam φ
  · obtain ⟨u, hu, -, hflow⟩ := exists_isEVISolution_eviFlow_eq hx
    simp only [hflow]
    exact hu.continuousOn.comp_continuous NNReal.continuous_coe fun t ↦ mem_Ici.2 t.2
  · simpa only [eviFlow_of_notMem hx] using continuous_const

/-- The flow preserves `TauCeti.eviDomain λ φ`. -/
theorem mapsTo_eviFlow (t : ℝ≥0) :
    MapsTo (eviFlow lam φ t) (eviDomain lam φ) (eviDomain lam φ) := fun x hx ↦ by
  simpa using (isEVISolution_eviFlow hx).apply_mem_eviDomain t.2

/-- **`λ`-contraction of the `EVI_λ` flow.** For a lower semicontinuous energy and two points of
`TauCeti.eviDomain λ φ`, `d(S_t x, S_t y) ≤ e^{-λt} d(x, y)`. -/
theorem dist_eviFlow_le (hφ : LowerSemicontinuous φ) (hx : x ∈ eviDomain lam φ)
    (hy : y ∈ eviDomain lam φ) (t : ℝ≥0) :
    dist (eviFlow lam φ t x) (eviFlow lam φ t y) ≤ exp (-(lam * t)) * dist x y := by
  simpa using (isEVISolution_eviFlow hx).dist_le (isEVISolution_eviFlow hy) hφ t.2

/-- The `EVI_λ` flow at time `t` is `e^{-λt}`-Lipschitz on `TauCeti.eviDomain λ φ`, for a lower
semicontinuous energy. -/
theorem lipschitzOnWith_eviFlow (hφ : LowerSemicontinuous φ) (t : ℝ≥0) :
    LipschitzOnWith (Real.toNNReal (exp (-(lam * t)))) (eviFlow lam φ t) (eviDomain lam φ) :=
  LipschitzOnWith.of_dist_le_mul fun x hx y hy ↦ by
    rw [Real.coe_toNNReal _ (exp_pos _).le]
    exact dist_eviFlow_le hφ hx hy t

/-- The `EVI_λ` flow `(t, x) ↦ S_t x` of a lower semicontinuous energy is jointly continuous on
`[0, ∞) × TauCeti.eviDomain λ φ`. -/
theorem continuousOn_uncurry_eviFlow (hφ : LowerSemicontinuous φ) :
    ContinuousOn (uncurry (eviFlow lam φ)) (univ ×ˢ eviDomain lam φ) := by
  rintro ⟨t₀, x₀⟩ ⟨-, hx₀ : x₀ ∈ eviDomain lam φ⟩
  -- `d(S_t x, S_{t₀} x₀) ≤ e^{-λt} d(x, x₀) + d(S_t x₀, S_{t₀} x₀)`, and both terms tend to `0`.
  have h₁ : Tendsto (fun p : ℝ≥0 × X ↦ exp (-(lam * p.1)) * dist p.2 x₀) (𝓝 (t₀, x₀)) (𝓝 0) := by
    simpa using ((by fun_prop : Continuous fun p : ℝ≥0 × X ↦
      exp (-(lam * p.1)) * dist p.2 x₀).tendsto (t₀, x₀))
  have h₂ : Tendsto (fun p : ℝ≥0 × X ↦ dist (eviFlow lam φ p.1 x₀) (eviFlow lam φ t₀ x₀))
      (𝓝 (t₀, x₀)) (𝓝 0) :=
    tendsto_iff_dist_tendsto_zero.1 <|
      ((continuous_eviFlow x₀).tendsto t₀).comp (continuous_fst.tendsto (t₀, x₀))
  refine tendsto_iff_dist_tendsto_zero.2 <| squeeze_zero' (.of_forall fun _ ↦ dist_nonneg) ?_
    (by simpa using (h₁.add h₂).mono_left nhdsWithin_le_nhds)
  filter_upwards [self_mem_nhdsWithin] with ⟨t, x⟩ hp
  exact (dist_triangle _ (eviFlow lam φ t x₀) _).trans
    (add_le_add (dist_eviFlow_le hφ hp.2 hx₀ t) le_rfl)

end PseudoMetricSpace

section MetricSpace

variable [MetricSpace X] {lam : ℝ} {φ : X → EReal} {u : ℝ → X} {x : X}

/-- For a lower semicontinuous energy on a metric space, the `EVI_λ` flow from the initial point
of an `EVI_λ` solution `u` is `u`: `S_t (u 0) = u t`. -/
theorem IsEVISolution.eviFlow_eq (h : IsEVISolution lam φ u) (hφ : LowerSemicontinuous φ)
    (t : ℝ≥0) : eviFlow lam φ t (u 0) = u t := by
  simpa using (isEVISolution_eviFlow ⟨u, h, rfl⟩).eqOn h hφ (by simp) (mem_Ici.2 t.2)

/-- **The semigroup law of the `EVI_λ` flow.** For a lower semicontinuous energy on a metric space,
`S_{s + t} x = S_s (S_t x)`. -/
theorem eviFlow_add (hφ : LowerSemicontinuous φ) (s t : ℝ≥0) (x : X) :
    eviFlow lam φ (s + t) x = eviFlow lam φ s (eviFlow lam φ t x) := by
  by_cases hx : x ∈ eviDomain lam φ
  · -- The time translate by `t` of the flow from `x` is the solution starting at `S_t x`.
    rw [eq_comm]
    simpa [add_comm] using ((isEVISolution_eviFlow hx).comp_add_const t.2).eviFlow_eq hφ s
  · simp only [eviFlow_of_notMem hx]

/-- The `EVI_λ` flow of a lower semicontinuous energy on a metric space, as a continuous semiflow
on the set `TauCeti.eviDomain λ φ` of initial points of `EVI_λ` solutions. -/
noncomputable def eviSemiflow (lam : ℝ) (hφ : LowerSemicontinuous φ) :
    Flow ℝ≥0 (eviDomain lam φ) where
  toFun t x := ⟨eviFlow lam φ t x, mapsTo_eviFlow t x.2⟩
  cont' := ((continuousOn_uncurry_eviFlow hφ).comp_continuous
    (continuous_fst.prodMk (continuous_subtype_val.comp continuous_snd))
    fun p ↦ ⟨mem_univ _, p.2.2⟩).subtype_mk _
  map_add' s t x := Subtype.ext (eviFlow_add hφ s t x)
  map_zero' x := Subtype.ext (eviFlow_zero (x : X))

@[simp]
theorem coe_eviSemiflow_apply (hφ : LowerSemicontinuous φ) (t : ℝ≥0) (x : eviDomain lam φ) :
    (eviSemiflow lam hφ t x : X) = eviFlow lam φ t x := by
  rfl

end MetricSpace

section InnerProductSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- On a real inner product space, every point starts an `EVI_1` solution for `‖x‖² / 2`. -/
theorem eviDomain_half_norm_sq : eviDomain 1 (fun y : E ↦ ((‖y‖ ^ 2 / 2 : ℝ) : EReal)) = univ :=
  eq_univ_of_forall fun x ↦ ⟨_, isEVISolution_exp_neg_smul x, by simp⟩

/-- On a real inner product space, the `EVI_1` flow of `‖x‖² / 2` is `S_t x = e⁻ᵗ x`. -/
theorem eviFlow_half_norm_sq (t : ℝ≥0) (x : E) :
    eviFlow 1 (fun y : E ↦ ((‖y‖ ^ 2 / 2 : ℝ) : EReal)) t x = exp (-t) • x := by
  simpa using (isEVISolution_exp_neg_smul x).eviFlow_eq
    (continuous_coe_real_ereal.comp (by fun_prop)).lowerSemicontinuous t

end InnerProductSpace

end TauCeti
