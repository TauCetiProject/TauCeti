module

public import TauCeti.Analysis.ODE.DysonSeries
public import TauCeti.Analysis.Calculus.Deriv.Idempotent
import TauCeti.Topology.Algebra.Star.RealModule

/-!
# Kato's intertwining evolution

For a continuously differentiable path of idempotents `P`, the correction `P' P - P P'`
transports their ranges. More generally, adding this correction to a continuous coefficient
`A` that commutes with `P` produces an evolution `Γ` with `Γ(t) P(0) = P(t) Γ(t)`.
For self-adjoint `P` and skew-adjoint `A`, the evolution is unitary and conjugates `P(0)`
to `P(t)`. This is the adiabatic evolution used to compare Schrödinger evolution with
transport of a separated spectral band.

The argument is Kato's intertwining construction; see Jansen, Ruskai and Seiler,
*Bounds for the adiabatic approximation with applications to quantum computation*,
J. Math. Phys. **48** (2007), 102111, Lemma 1 and equation (7).
-/

public section

namespace TauCeti

variable {B : Type*} [NormedRing B] [NormedAlgebra ℝ B] [CompleteSpace B]
  {P D A : ℝ → B}

/-- **Kato's intertwining identity.** The evolution generated by `A + P' P - P P'`
intertwines a continuously differentiable path of idempotents, provided `A` commutes
with the idempotent at each time. The derivative is supplied as a continuous path `D`. -/
theorem dysonSeriesLeft_mul_eq_mul_dysonSeriesLeft
    (hP : ∀ t, HasDerivAt P (D t) t) (hD : Continuous D) (hA : Continuous A)
    (hPP : ∀ t, IsIdempotentElem (P t)) (hAP : ∀ t, Commute (A t) (P t)) (t : ℝ) :
    dysonSeriesLeft (fun s ↦ A s + D s * P s - P s * D s) t * P 0 =
      P t * dysonSeriesLeft (fun s ↦ A s + D s * P s - P s * D s) t := by
  have hPc : Continuous P := continuous_iff_continuousAt.2 fun s ↦ (hP s).continuousAt
  let K := fun s ↦ A s + D s * P s - P s * D s
  have hK : Continuous K := (hA.add (hD.mul hPc)).sub (hPc.mul hD)
  have hcomm (s : ℝ) : D s + P s * K s = K s * P s := by
    have hd := (hP s).mul_add_mul_eq_of_isIdempotentElem (Filter.Eventually.of_forall hPP)
    have hzero := (hP s).mul_mul_eq_zero_of_isIdempotentElem
      (Filter.Eventually.of_forall hPP)
    dsimp only [K]
    calc
      D s + P s * (A s + D s * P s - P s * D s) =
          D s + P s * A s + P s * D s * P s - (P s * P s) * D s := by
            noncomm_ring
      _ = (D s - P s * D s) + A s * P s := by
        rw [(hPP s).eq, hzero, add_zero, ← (hAP s).eq]
        noncomm_ring
      _ = D s * P s + A s * P s := by rw [← eq_sub_of_add_eq hd]
      _ = (A s + D s * P s - P s * D s) * P s := by
        rw [sub_mul, add_mul, mul_assoc (D s), (hPP s).eq, hzero]
        noncomm_ring
  have hf (s : ℝ) : HasDerivAt (fun r ↦ P r * dysonSeriesLeft K r)
      (K s * (P s * dysonSeriesLeft K s)) s := by
    convert (hP s).mul (hasDerivAt_dysonSeriesLeft hK s) using 1
    calc
      K s * (P s * dysonSeriesLeft K s) =
          (D s + P s * K s) * dysonSeriesLeft K s := by rw [hcomm, mul_assoc]
      _ = _ := by noncomm_ring
  simpa only [dysonSeriesLeft_zero, mul_one] using (eq_dysonSeriesLeft_mul hK hf t).symm

section Star

variable [StarRing B] [ContinuousStar B]

/-- For a self-adjoint path and a skew-adjoint coefficient,
Kato's intertwining evolution is unitary. -/
theorem dysonSeriesLeft_add_commutator_mem_unitary
    (hP : ∀ t, HasDerivAt P (D t) t) (hD : Continuous D) (hA : Continuous A)
    (hPstar : ∀ t, IsSelfAdjoint (P t)) (hAstar : ∀ t, star (A t) = -A t) (t : ℝ) :
    dysonSeriesLeft (fun s ↦ A s + D s * P s - P s * D s) t ∈ unitary B := by
  have : StarModule ℝ B := ContinuousStar.starModule_real
  have hPc : Continuous P := continuous_iff_continuousAt.2 fun s ↦ (hP s).continuousAt
  have hDstar (s : ℝ) : star (D s) = D s := by
    exact ((hP s).star.congr_of_eventuallyEq
      (Filter.Eventually.of_forall fun r ↦ (hPstar r).star_eq.symm)).unique (hP s)
  have hskew (s : ℝ) : star (A s + D s * P s - P s * D s) =
      -(A s + D s * P s - P s * D s) := by
    simp only [star_sub, star_add, star_mul, hAstar, hDstar, (hPstar s).star_eq]
    noncomm_ring
  have hu := dysonSeries_mem_unitary (p := fun s ↦
    MulOpposite.op (A s + D s * P s - P s * D s))
    (MulOpposite.continuous_op.comp ((hA.add (hD.mul hPc)).sub (hPc.mul hD)))
    (fun s ↦ by simp only [← MulOpposite.op_star, hskew, MulOpposite.op_neg]) t
  rw [← op_dysonSeriesLeft] at hu
  exact MulOpposite.mem_unitary_iff.mp hu

/-- **Unitary transport of projections.** Kato's evolution conjugates the initial
self-adjoint idempotent to the idempotent at time `t`. -/
theorem dysonSeriesLeft_mul_mul_star_eq
    (hP : ∀ t, HasDerivAt P (D t) t) (hD : Continuous D) (hA : Continuous A)
    (hPP : ∀ t, IsIdempotentElem (P t)) (hAP : ∀ t, Commute (A t) (P t))
    (hPstar : ∀ t, IsSelfAdjoint (P t)) (hAstar : ∀ t, star (A t) = -A t) (t : ℝ) :
    let Γ := dysonSeriesLeft (fun s ↦ A s + D s * P s - P s * D s)
    Γ t * P 0 * star (Γ t) = P t := by
  dsimp only
  rw [dysonSeriesLeft_mul_eq_mul_dysonSeriesLeft hP hD hA hPP hAP, mul_assoc,
    Unitary.mul_star_self_of_mem (dysonSeriesLeft_add_commutator_mem_unitary
      hP hD hA hPstar hAstar t), mul_one]

end Star

end TauCeti
