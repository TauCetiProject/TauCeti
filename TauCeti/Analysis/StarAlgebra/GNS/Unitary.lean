module

public import TauCeti.Analysis.StarAlgebra.GNS.Bounded

/-!
# Isometric and unitary GNS operators of unitary elements

In any unital complex `⋆`-ring `A`, a unitary element `u ∈ unitary A` satisfies `star u * u = 1` and
`u * star u = 1`, so `φ (star b * star u * u * b) = φ (star b * b)` for every positive functional
`φ : StarPositiveFunctional A`. Left multiplication `φ.leftMul u` on `φ.GNS` is therefore an
isometry, its extension `φ.hilbertLeftMul` to `φ.HilbertGNS` is a unitary operator, and any complex
`⋆`-algebra generated by unitary elements has `φ.boundedSubalgebra = ⊤` for every positive
functional `φ`.

## Main results

* `TauCeti.StarPositiveFunctional.norm_leftMul_of_mem_unitary`,
  `TauCeti.StarPositiveFunctional.isometry_leftMul_of_mem_unitary`: unitary elements act
  isometrically on `φ.GNS`.
* `TauCeti.StarPositiveFunctional.continuous_leftMul_of_mem_unitary`,
  `TauCeti.StarPositiveFunctional.hilbertLeftMul_mem_unitary`: continuity on `φ.GNS` and unitarity
  on `φ.HilbertGNS`.
* `TauCeti.StarPositiveFunctional.boundedSubalgebra_eq_top_of_adjoin_unitary`,
  `TauCeti.StarPositiveFunctional.exists_cstar_representation_iff_of_adjoin_unitary`: automatic GNS
  boundedness and C⋆-representation characterization for algebras generated by unitary elements.

## References

* G. J. Murphy, *C⋆-Algebras and Operator Theory*, §3.3.
* K. Schmüdgen, *Unbounded Operator Algebras and Representation Theory*, §8.6.
-/

public section

noncomputable section

open scoped ComplexOrder

namespace TauCeti.StarPositiveFunctional

section Ring

variable {A : Type*} [Ring A] [Module ℂ A] [StarRing A] (φ : StarPositiveFunctional A)

/-- For `u ∈ unitary A`, the quadratic pairing `φ (star b * star u * u * b)` equals
`φ (star b * b)`. -/
theorem apply_star_mul_self_of_mem_unitary {u : A} (hu : u ∈ unitary A) (b : A) :
    φ (star b * star u * u * b) = φ (star b * b) := by
  rw [mul_assoc (star b) (star u) u, Unitary.star_mul_self_of_mem hu, mul_one]

variable [StarModule ℂ A] [IsScalarTower ℂ A A]

/-- Left multiplication by a unitary element preserves norms on the algebraic GNS space. -/
@[simp]
theorem norm_leftMul_of_mem_unitary {u : A} (hu : u ∈ unitary A) (x : φ.GNS) :
    ‖φ.leftMul u x‖ = ‖x‖ := by
  obtain ⟨b, rfl⟩ := φ.classMap_surjective x
  refine sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _) |>.mp ?_
  rw [φ.leftMul_classMap, φ.norm_classMap_sq, φ.norm_classMap_sq]
  simpa only [star_mul, ← mul_assoc] using
    congrArg Complex.re (φ.apply_star_mul_self_of_mem_unitary hu b)

/-- Left multiplication by a unitary element is an isometry on the algebraic GNS space. -/
theorem isometry_leftMul_of_mem_unitary {u : A} (hu : u ∈ unitary A) :
    Isometry (φ.leftMul u) :=
  AddMonoidHomClass.isometry_of_norm (φ.leftMul u) (φ.norm_leftMul_of_mem_unitary hu)

/-- Left multiplication by a unitary element is continuous on the algebraic GNS space. -/
theorem continuous_leftMul_of_mem_unitary {u : A} (hu : u ∈ unitary A) :
    Continuous (φ.leftMul u) :=
  (φ.isometry_leftMul_of_mem_unitary hu).continuous

/-- Extended left multiplication by a unitary element is a unitary operator on `φ.HilbertGNS`. -/
theorem hilbertLeftMul_mem_unitary {u : A} (hu : u ∈ unitary A) :
    φ.hilbertLeftMul (φ.continuous_leftMul_of_mem_unitary hu) ∈
      unitary (φ.HilbertGNS →L[ℂ] φ.HilbertGNS) := by
  rw [Unitary.mem_iff, φ.star_hilbertLeftMul, ← φ.hilbertLeftMul_mul, ← φ.hilbertLeftMul_mul]
  exact ⟨φ.hilbertClassMap_clm_ext fun b => by simp [Unitary.star_mul_self_of_mem hu],
    φ.hilbertClassMap_clm_ext fun b => by simp [Unitary.mul_star_self_of_mem hu]⟩

end Ring

section Unital

universe u

variable {A : Type u} [Ring A] [Algebra ℂ A] [StarRing A] [StarModule ℂ A]

/-- Every unitary element belongs to the bounded GNS subalgebra of any positive functional. -/
theorem mem_boundedSubalgebra_of_mem_unitary (φ : StarPositiveFunctional A) {u : A}
    (hu : u ∈ unitary A) : u ∈ φ.boundedSubalgebra :=
  φ.mem_boundedSubalgebra.mpr (φ.continuous_leftMul_of_mem_unitary hu)

/-- If `A` is generated as a `ℂ`-algebra by unitary elements, then every element of `A` acts
boundedly on `φ.GNS`. -/
theorem boundedSubalgebra_eq_top_of_adjoin_unitary (φ : StarPositiveFunctional A)
    {s : Set A} (hs : Algebra.adjoin ℂ s = ⊤) (hu : ∀ u ∈ s, u ∈ unitary A) :
    φ.boundedSubalgebra = ⊤ :=
  φ.boundedSubalgebra_eq_top_of_algebra_adjoin_eq_top hs fun u hu' =>
    φ.continuous_leftMul_of_mem_unitary (hu u hu')

/-- If `A` is generated as a `ℂ`-algebra by unitary elements, left multiplication on `φ.GNS` is
continuous for every element of `A`. -/
theorem continuous_leftMul_of_adjoin_unitary (φ : StarPositiveFunctional A)
    {s : Set A} (hs : Algebra.adjoin ℂ s = ⊤) (hu : ∀ u ∈ s, u ∈ unitary A) (a : A) :
    Continuous (φ.leftMul a) :=
  φ.continuous_leftMul_of_algebra_adjoin_eq_top hs
    (fun u hu' => φ.continuous_leftMul_of_mem_unitary (hu u hu')) a

/-- On an algebra generated by unitary elements, algebraic positivity of a linear functional is
equivalent to factoring through a unital `⋆`-representation in a C⋆-algebra. -/
theorem exists_cstar_representation_iff_of_adjoin_unitary {s : Set A}
    (hs : Algebra.adjoin ℂ s = ⊤) (hu : ∀ u ∈ s, u ∈ unitary A) {f : A →ₗ[ℂ] ℂ} :
    (∃ (C : Type u) (_ : CStarAlgebra C) (_ : PartialOrder C) (_ : StarOrderedRing C)
        (ω : C →ₚ[ℂ] ℂ) (π : A →⋆ₐ[ℂ] C), ∀ a, ω (π a) = f a) ↔
      ∀ a : A, 0 ≤ f (star a * a) :=
  exists_cstar_representation_iff_forall_nonneg_of_forall_continuous_leftMul
    (fun ψ => ψ.continuous_leftMul_of_adjoin_unitary hs hu)

end Unital

end TauCeti.StarPositiveFunctional
