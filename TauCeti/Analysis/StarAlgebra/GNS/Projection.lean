module

public import TauCeti.Analysis.StarAlgebra.GNS.Bounded

/-!
# Bounded GNS operators of star projections

In any complex `⋆`-algebra `A` (not necessarily unital), a star projection `p : A` satisfies the
identities `star (p * b) * (p * b) = star b * p * b` and
`star (b - p * b) * (b - p * b) = star b * b - star b * p * b`. Applying a positive functional
`φ : StarPositiveFunctional A` yields `0 ≤ φ (star b * p * b) ≤ φ (star b * b)` without assuming a
norm or an order on `A`.

Consequently, left multiplication `φ.leftMul p` on `φ.GNS` is a contraction, its extension
`φ.hilbertLeftMul` to the completed GNS Hilbert space `φ.HilbertGNS` is a star projection of
operator norm at most `1`, and any unital complex `⋆`-algebra generated by star projections has
`φ.boundedSubalgebra = ⊤` for every positive functional `φ`.

## Main results

* `TauCeti.StarPositiveFunctional.apply_star_mul_mul_nonneg_of_isStarProjection`,
  `TauCeti.StarPositiveFunctional.apply_star_mul_mul_le_of_isStarProjection`: the quadratic-form
  bounds `0 ≤ φ (star b * p * b) ≤ φ (star b * b)` for a star projection `p`.
* `TauCeti.StarPositiveFunctional.continuous_leftMul_of_isStarProjection`,
  `TauCeti.StarPositiveFunctional.norm_hilbertLeftMul_le_one_of_isStarProjection`,
  `TauCeti.StarPositiveFunctional.isStarProjection_hilbertLeftMul`: boundedness by `1` and the
  projection property on `φ.HilbertGNS`.
* `TauCeti.StarPositiveFunctional.boundedSubalgebra_eq_top_of_adjoin_isStarProjection`,
  `TauCeti.StarPositiveFunctional.exists_cstar_representation_iff_of_adjoin_isStarProjection`:
  automatic GNS boundedness and C⋆-representation characterization for algebras generated by star
  projections.

## References

* G. J. Murphy, *C⋆-Algebras and Operator Theory*, §3.3.
* K. Schmüdgen, *Unbounded Operator Algebras and Representation Theory*, §8.6.
-/

public section

noncomputable section

open scoped ComplexOrder

namespace TauCeti.StarPositiveFunctional

section NonUnital

variable {A : Type*} [NonUnitalRing A] [Module ℂ A] [StarRing A] (φ : StarPositiveFunctional A)

/-- For a star projection `p`, `φ (star b * p * b)` is nonnegative because it equals the square
`φ (star (p * b) * (p * b))`. -/
theorem apply_star_mul_mul_nonneg_of_isStarProjection {p : A} (hp : IsStarProjection p) (b : A) :
    0 ≤ φ (star b * p * b) := by
  have heq : star (p * b) * (p * b) = star b * p * b := by
    rw [star_mul, hp.isSelfAdjoint.star_eq, ← mul_assoc, mul_assoc (star b) p p,
      hp.isIdempotentElem.eq]
  simpa only [heq, φ.toLinearMap_apply] using φ.square_nonneg (p * b)

/-- For a star projection `p`, `φ (star b * p * b) ≤ φ (star b * b)`, proved without an identity
element from the square `star (b - p * b) * (b - p * b)`. -/
theorem apply_star_mul_mul_le_of_isStarProjection {p : A} (hp : IsStarProjection p) (b : A) :
    φ (star b * p * b) ≤ φ (star b * b) := by
  have hp_mul : p * (p * b) = p * b := by
    rw [← mul_assoc, hp.isIdempotentElem.eq]
  have hp_sub : p * (b - p * b) = 0 := by
    rw [mul_sub, hp_mul, sub_self]
  have heq : star (b - p * b) * (b - p * b) = star b * b - star b * p * b := by
    suffices star (b - p * b) * (b - p * b) = star b * (b - p * b) by
      rw [this, mul_sub, mul_assoc]
    simp [hp.isSelfAdjoint.star_eq, sub_mul, mul_assoc, hp_sub]
  have h : 0 ≤ φ (star (b - p * b) * (b - p * b)) := by
    simpa only [φ.toLinearMap_apply] using φ.square_nonneg (b - p * b)
  rw [heq, map_sub] at h
  exact sub_nonneg.mp h

/-- Quadratic-form bound `φ (star b * star p * p * b) ≤ φ (star b * b)` for a star projection
`p`. -/
theorem apply_star_mul_self_le_of_isStarProjection {p : A} (hp : IsStarProjection p) (b : A) :
    φ (star b * star p * p * b) ≤ φ (star b * b) := by
  rw [hp.isSelfAdjoint.star_eq, mul_assoc (star b) p p, hp.isIdempotentElem.eq]
  exact φ.apply_star_mul_mul_le_of_isStarProjection hp b

variable [StarModule ℂ A] [IsScalarTower ℂ A A]

/-- Left multiplication by a star projection is a contraction on the algebraic GNS space. -/
theorem norm_leftMul_le_of_isStarProjection {p : A} (hp : IsStarProjection p) (x : φ.GNS) :
    ‖φ.leftMul p x‖ ≤ ‖x‖ := by
  simpa only [one_mul] using
    (φ.forall_norm_leftMul_le_iff zero_le_one).mpr
      (fun b => by simpa using φ.apply_star_mul_self_le_of_isStarProjection hp b) x

/-- Left multiplication by a star projection is continuous on the algebraic GNS space. -/
theorem continuous_leftMul_of_isStarProjection {p : A} (hp : IsStarProjection p) :
    Continuous (φ.leftMul p) :=
  (φ.continuous_leftMul_iff p).mpr
    ⟨1, zero_le_one, fun b => by simpa using φ.apply_star_mul_self_le_of_isStarProjection hp b⟩

/-- Left multiplication by a star projection on `φ.GNS` has operator norm at most `1`. -/
theorem norm_leftMulCLM_le_one_of_isStarProjection {p : A} (hp : IsStarProjection p) :
    ‖φ.leftMulCLM (φ.continuous_leftMul_of_isStarProjection hp)‖ ≤ 1 :=
  (φ.norm_leftMulCLM_le_iff _ zero_le_one).mpr fun b => by
    simpa using φ.apply_star_mul_self_le_of_isStarProjection hp b

/-- Extended left multiplication by a star projection on `φ.HilbertGNS` has operator norm at most
`1`. -/
theorem norm_hilbertLeftMul_le_one_of_isStarProjection {p : A} (hp : IsStarProjection p) :
    ‖φ.hilbertLeftMul (φ.continuous_leftMul_of_isStarProjection hp)‖ ≤ 1 := by
  rw [φ.norm_hilbertLeftMul]
  exact φ.norm_leftMulCLM_le_one_of_isStarProjection hp

/-- Extended left multiplication by a star projection is a star projection on `φ.HilbertGNS`. -/
theorem isStarProjection_hilbertLeftMul {p : A} (hp : IsStarProjection p) :
    IsStarProjection (φ.hilbertLeftMul (φ.continuous_leftMul_of_isStarProjection hp)) where
  isIdempotentElem := by
    rw [IsIdempotentElem, ← φ.hilbertLeftMul_mul]
    exact φ.hilbertClassMap_clm_ext fun b => by simp [hp.isIdempotentElem.eq]
  isSelfAdjoint := by
    rw [IsSelfAdjoint, φ.star_hilbertLeftMul]
    exact φ.hilbertClassMap_clm_ext fun b => by simp [hp.isSelfAdjoint.star_eq]

end NonUnital

section Unital

universe u

variable {A : Type u} [Ring A] [Algebra ℂ A] [StarRing A] [StarModule ℂ A]

/-- Every star projection belongs to the bounded GNS subalgebra of any positive functional. -/
theorem mem_boundedSubalgebra_of_isStarProjection (φ : StarPositiveFunctional A) {p : A}
    (hp : IsStarProjection p) : p ∈ φ.boundedSubalgebra :=
  φ.mem_boundedSubalgebra.mpr (φ.continuous_leftMul_of_isStarProjection hp)

/-- If `A` is generated as a `ℂ`-algebra by star projections, then every element of `A` acts
boundedly on `φ.GNS`. -/
theorem boundedSubalgebra_eq_top_of_adjoin_isStarProjection (φ : StarPositiveFunctional A)
    {s : Set A} (hs : Algebra.adjoin ℂ s = ⊤) (hp : ∀ p ∈ s, IsStarProjection p) :
    φ.boundedSubalgebra = ⊤ :=
  φ.boundedSubalgebra_eq_top_of_algebra_adjoin_eq_top hs fun p hp' =>
    φ.continuous_leftMul_of_isStarProjection (hp p hp')

/-- If `A` is generated as a `ℂ`-algebra by star projections, left multiplication on `φ.GNS` is
continuous for every element of `A`. -/
theorem continuous_leftMul_of_adjoin_isStarProjection (φ : StarPositiveFunctional A)
    {s : Set A} (hs : Algebra.adjoin ℂ s = ⊤) (hp : ∀ p ∈ s, IsStarProjection p) (a : A) :
    Continuous (φ.leftMul a) :=
  φ.continuous_leftMul_of_algebra_adjoin_eq_top hs
    (fun p hp' => φ.continuous_leftMul_of_isStarProjection (hp p hp')) a

/-- On an algebra generated by star projections, algebraic positivity of a linear functional is
equivalent to factoring through a unital `⋆`-representation in a C⋆-algebra. -/
theorem exists_cstar_representation_iff_of_adjoin_isStarProjection {s : Set A}
    (hs : Algebra.adjoin ℂ s = ⊤) (hp : ∀ p ∈ s, IsStarProjection p) {f : A →ₗ[ℂ] ℂ} :
    (∃ (C : Type u) (_ : CStarAlgebra C) (_ : PartialOrder C) (_ : StarOrderedRing C)
        (ω : C →ₚ[ℂ] ℂ) (π : A →⋆ₐ[ℂ] C), ∀ a, ω (π a) = f a) ↔
      ∀ a : A, 0 ≤ f (star a * a) :=
  exists_cstar_representation_iff_forall_nonneg_of_forall_continuous_leftMul
    (fun ψ => ψ.continuous_leftMul_of_adjoin_isStarProjection hs hp)

end Unital

end TauCeti.StarPositiveFunctional
