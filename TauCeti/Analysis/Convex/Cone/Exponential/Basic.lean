/-!
# The closed real exponential cone

We define the strictly positive-scale branch `TauCeti.ExponentialCone.positive` in `ℝ × ℝ × ℝ`
with coordinates `(u, v, w)` representing epigraph height, perspective scale, and exponent
numerator:

`positive = {(u, v, w) | 0 < v ∧ v * exp (w / v) ≤ u}`.

We then package the closed exponential cone `TauCeti.ExponentialCone.cone` natively as
`(PointedCone.hull ℝ positive).closure`, so Mathlib's `PointedCone` convexity, zero/addition
membership, nonnegative scalar multiplication, and closure API apply directly.

Through the supporting affine halfspaces `exp a * (w + (1 - a) * v) ≤ u` (`a : ℝ`) obtained from
the tangent inequality `exp a * (1 + z - a) ≤ exp z`, together with the explicit boundary
approximation `(u + δ, δ, w) → (u, 0, w)` as `δ → 0⁺`, we identify the carrier of `cone` with
the union of `positive` and the literal zero face `{(u, 0, w) | 0 ≤ u ∧ w ≤ 0}` and prove that
`closure positive = (cone : Set (ℝ × ℝ × ℝ))`.

## Main definitions and results

* `TauCeti.ExponentialCone.positive`: the positive-scale branch `{q | 0 < q.2.1 ∧ ...}`.
* `TauCeti.ExponentialCone.cone`: the closed `PointedCone ℝ (ℝ × ℝ × ℝ)` generated by `positive`.
* `TauCeti.ExponentialCone.isClosed_cone`: closedness of `(cone : Set (ℝ × ℝ × ℝ))`.
* `TauCeti.ExponentialCone.mem_cone_iff`: membership in `cone` is the union of the positive branch
  and the literal zero face `v = 0 ∧ 0 ≤ u ∧ w ≤ 0`.
* `TauCeti.ExponentialCone.mem_cone_iff_forall_exp`: supporting-halfspace characterization of
  `cone`.
* `TauCeti.ExponentialCone.closure_positive`: `closure positive = (cone : Set (ℝ × ℝ × ℝ))`.

## References

* P. R. Chares, *Cones and Interior-Point Algorithms for Structured Convex Optimization involving
  Powers and Exponentials*, Section 4.2, Lemma 4.2.1.
* MOSEK, *Modeling Cookbook* 3.4.0, Section 5.1.
* D. E. Bernal Neira, *Modern Computational Approaches to Nonlinear Discrete Optimization and
  Applications in Process Systems Engineering*, Carnegie Mellon University doctoral thesis,
  May 2021, Chapter 8, (8.8).
* The supporting-halfspace characterization and explicit zero-face approximation `(u + δ, δ, w)`
  follow the proof route in D. E. Bernal Neira's `complete-retained-library`
  (commit `59c355eb14ed1eff9664736428ca02b4543200b8`, Apache-2.0,
  `Chapter08ExponentialGeometry.lean`); all Lean definitions and proofs here are written from
  scratch using Mathlib's `PointedCone` interface.
-/

public section

open Filter Set
open scoped Topology

namespace TauCeti.ExponentialCone

/-- The strictly positive-scale branch of the real exponential cone in `ℝ × ℝ × ℝ`, with
coordinates `(u, v, w)` for epigraph height, perspective scale, and exponent numerator.
It excludes zero and all zero-scale points. -/
def positive : Set (ℝ × ℝ × ℝ) :=
  {q | 0 < q.2.1 ∧ q.2.1 * Real.exp (q.2.2 / q.2.1) ≤ q.1}

/-- Definitional expansion of `positive`. -/
theorem positive_def :
    positive = {q : ℝ × ℝ × ℝ | 0 < q.2.1 ∧ q.2.1 * Real.exp (q.2.2 / q.2.1) ≤ q.1} := (rfl)

/-- Coordinate characterization of membership in the positive branch `positive`. -/
@[simp]
theorem mem_positive_iff {u v w : ℝ} :
    (u, v, w) ∈ positive ↔ 0 < v ∧ v * Real.exp (w / v) ≤ u := (Iff.rfl)

/-- The closed real exponential cone in `ℝ × ℝ × ℝ`, constructed as the topological closure of
the pointed cone hull of `positive`. -/
def cone : PointedCone ℝ (ℝ × ℝ × ℝ) :=
  (PointedCone.hull ℝ positive).closure

/-- Definitional expansion of `cone`. -/
theorem cone_def : cone = (PointedCone.hull ℝ positive).closure := (rfl)

/-- The carrier of `cone` is closed in `ℝ × ℝ × ℝ`. -/
theorem isClosed_cone : IsClosed (cone : Set (ℝ × ℝ × ℝ)) := by
  rw [cone_def, PointedCone.coe_closure]
  exact isClosed_closure

/-! ### Positive-branch properties -/

/-- Every point of `positive` has strictly positive epigraph height. -/
theorem height_pos_of_mem_positive {u v w : ℝ} (h : (u, v, w) ∈ positive) : 0 < u :=
  (mul_pos h.1 (Real.exp_pos _)).trans_le h.2

/-- Increasing the epigraph height preserves membership in `positive`. -/
theorem mem_positive_of_le {u u' v w : ℝ} (h : (u, v, w) ∈ positive) (hu : u ≤ u') :
    (u', v, w) ∈ positive :=
  ⟨h.1, h.2.trans hu⟩

/-- Scaling by a strictly positive real preserves and reflects membership in `positive`. -/
theorem smul_mem_positive_iff {a : ℝ} (ha : 0 < a) {q : ℝ × ℝ × ℝ} :
    a • q ∈ positive ↔ q ∈ positive := by
  rcases q with ⟨u, v, w⟩
  simp only [Prod.smul_mk, smul_eq_mul, mem_positive_iff]
  constructor
  · rintro ⟨hav, hle⟩
    have hv : 0 < v := (mul_pos_iff_of_pos_left ha).mp hav
    rw [mul_div_mul_left _ _ ha.ne', mul_assoc] at hle
    exact ⟨hv, (mul_le_mul_iff_right₀ ha).mp hle⟩
  · rintro ⟨hv, hle⟩
    refine ⟨mul_pos ha hv, ?_⟩
    rw [mul_div_mul_left _ _ ha.ne', mul_assoc]
    exact mul_le_mul_of_nonneg_left hle ha.le

/-- The origin does not belong to `positive`. -/
@[simp]
theorem zero_notMem_positive : (0 : ℝ × ℝ × ℝ) ∉ positive := by
  simp [positive_def]

/-- No point with nonpositive scale belongs to `positive`. -/
theorem notMem_positive_of_nonpos {u v w : ℝ} (hv : v ≤ 0) : (u, v, w) ∉ positive :=
  fun h ↦ hv.not_gt h.1

/-- For a zero-face point `(u, 0, w)` with `0 ≤ u` and `w ≤ 0`, every positive perturbation
`(u + δ, δ, w)` lies in `positive`. -/
theorem mem_positive_add_of_nonneg_of_nonpos {u w δ : ℝ} (hu : 0 ≤ u) (hw : w ≤ 0)
    (hδ : 0 < δ) : (u + δ, δ, w) ∈ positive := by
  refine ⟨hδ, ?_⟩
  have hexp : Real.exp (w / δ) ≤ 1 :=
    Real.exp_le_one_iff.mpr (div_nonpos_of_nonpos_of_nonneg hw hδ.le)
  calc δ * Real.exp (w / δ) ≤ δ * 1 := mul_le_mul_of_nonneg_left hexp hδ.le
    _ ≤ u + δ := by linarith

/-! ### Supporting halfspaces and carrier identification -/

private def halfspaceSet : Set (ℝ × ℝ × ℝ) :=
  {q | 0 ≤ q.1 ∧ 0 ≤ q.2.1 ∧ ∀ a : ℝ, Real.exp a * (q.2.2 + (1 - a) * q.2.1) ≤ q.1}

private def carrierSet : Set (ℝ × ℝ × ℝ) :=
  {q | (0 < q.2.1 ∧ q.2.1 * Real.exp (q.2.2 / q.2.1) ≤ q.1) ∨
    (q.2.1 = 0 ∧ 0 ≤ q.1 ∧ q.2.2 ≤ 0)}

private theorem mem_carrierSet_iff_mem_halfspaceSet (u v w : ℝ) :
    (u, v, w) ∈ carrierSet ↔ (u, v, w) ∈ halfspaceSet := by
  constructor
  · rintro (⟨hv, hle⟩ | ⟨rfl, hu, hw⟩)
    · refine ⟨(mul_pos hv (Real.exp_pos _)).le.trans hle, hv.le, fun a ↦ ?_⟩
      have htan : Real.exp a * ((w / v - a) + 1) ≤ Real.exp (w / v) := by
        calc Real.exp a * ((w / v - a) + 1)
            ≤ Real.exp a * Real.exp (w / v - a) := by
              gcongr
              exact Real.add_one_le_exp (w / v - a)
          _ = Real.exp (w / v) := by rw [← Real.exp_add, add_sub_cancel]
      calc Real.exp a * (w + (1 - a) * v)
          = v * (Real.exp a * ((w / v - a) + 1)) := by field_simp [hv.ne']; ring
        _ ≤ v * Real.exp (w / v) := mul_le_mul_of_nonneg_left htan hv.le
        _ ≤ u := hle
    · refine ⟨hu, le_rfl, fun a ↦ ?_⟩
      have hmul : Real.exp a * w ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (Real.exp_nonneg a) hw
      simpa using hmul.trans hu
  · rintro ⟨hu, hv, hhalf⟩
    rcases hv.eq_or_lt with rfl | hvpos
    · refine Or.inr ⟨rfl, hu, ?_⟩
      by_contra hpos
      have hw : 0 < w := lt_of_not_ge hpos
      have harg : 0 < (u + 1) / w := div_pos (by linarith) hw
      have hspec := hhalf (Real.log ((u + 1) / w))
      rw [mul_zero, add_zero, Real.exp_log harg, div_mul_cancel₀ _ hw.ne'] at hspec
      linarith
    · refine Or.inl ⟨hvpos, ?_⟩
      have hspec := hhalf (w / v)
      have hlin : w + (1 - w / v) * v = v := by field_simp [hvpos.ne']; ring
      rw [hlin, mul_comm] at hspec
      exact hspec

private theorem carrierSet_eq_halfspaceSet : carrierSet = halfspaceSet := by
  ext ⟨u, v, w⟩
  exact mem_carrierSet_iff_mem_halfspaceSet u v w

private theorem isClosed_halfspaceSet : IsClosed halfspaceSet := by
  have heq : halfspaceSet =
      {q : ℝ × ℝ × ℝ | 0 ≤ q.1} ∩ {q : ℝ × ℝ × ℝ | 0 ≤ q.2.1} ∩
        ⋂ a : ℝ, {q : ℝ × ℝ × ℝ | Real.exp a * (q.2.2 + (1 - a) * q.2.1) ≤ q.1} := by
    ext ⟨u, v, w⟩
    simp [halfspaceSet, and_assoc]
  rw [heq]
  refine ((isClosed_le continuous_const continuous_fst).inter
    (isClosed_le continuous_const (continuous_fst.comp continuous_snd))).inter ?_
  refine isClosed_iInter fun a ↦ isClosed_le ?_ continuous_fst
  fun_prop

private def halfspaceCone : PointedCone ℝ (ℝ × ℝ × ℝ) where
  carrier := halfspaceSet
  zero_mem' := ⟨le_rfl, le_rfl, fun a ↦ by simp⟩
  add_mem' {p q} hp hq := by
    refine ⟨add_nonneg hp.1 hq.1, add_nonneg hp.2.1 hq.2.1, fun a ↦ ?_⟩
    have hsplit : Real.exp a * ((p.2.2 + q.2.2) + (1 - a) * (p.2.1 + q.2.1)) =
        Real.exp a * (p.2.2 + (1 - a) * p.2.1) + Real.exp a * (q.2.2 + (1 - a) * q.2.1) := by
      ring
    rw [Prod.fst_add, Prod.snd_add, Prod.fst_add, Prod.snd_add, hsplit]
    exact add_le_add (hp.2.2 a) (hq.2.2 a)
  smul_mem' c {q} hq := by
    refine ⟨mul_nonneg c.property hq.1, mul_nonneg c.property hq.2.1, fun a ↦ ?_⟩
    have hscale : Real.exp a * (c.val * q.2.2 + (1 - a) * (c.val * q.2.1)) =
        c.val * (Real.exp a * (q.2.2 + (1 - a) * q.2.1)) := by
      ring
    simpa only [← Nonneg.coe_smul, Prod.smul_fst, Prod.smul_snd, smul_eq_mul, hscale] using
      mul_le_mul_of_nonneg_left (hq.2.2 a) c.property

private theorem coe_halfspaceCone : (halfspaceCone : Set (ℝ × ℝ × ℝ)) = halfspaceSet := rfl

private theorem carrierSet_subset_closure_positive : carrierSet ⊆ closure positive := by
  rintro ⟨u, v, w⟩ (hpos | ⟨rfl, hu, hw⟩)
  · exact subset_closure hpos
  · have hlim : Tendsto (fun δ : ℝ ↦ (u + δ, δ, w)) (𝓝[>] (0 : ℝ)) (𝓝 (u, 0, w)) := by
      have hcont : Continuous (fun δ : ℝ ↦ (u + δ, δ, w)) := by fun_prop
      simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
    exact mem_closure_of_tendsto hlim <|
      eventually_of_mem self_mem_nhdsWithin fun δ hδ ↦
        mem_positive_add_of_nonneg_of_nonpos hu hw hδ

private theorem coe_cone_eq_halfspaceSet : (cone : Set (ℝ × ℝ × ℝ)) = halfspaceSet := by
  have hpos_sub : positive ⊆ (halfspaceCone : Set (ℝ × ℝ × ℝ)) := by
    rw [coe_halfspaceCone, ← carrierSet_eq_halfspaceSet]
    rintro ⟨u, v, w⟩ hq
    exact Or.inl (mem_positive_iff.mp hq)
  have hhull_le : PointedCone.hull ℝ positive ≤ halfspaceCone := Submodule.span_le.mpr hpos_sub
  have hhull_sub : (PointedCone.hull ℝ positive : Set (ℝ × ℝ × ℝ)) ⊆ halfspaceSet := by
    rw [← coe_halfspaceCone]
    exact SetLike.coe_subset_coe.mpr hhull_le
  have hcone_sub : (cone : Set (ℝ × ℝ × ℝ)) ⊆ halfspaceSet := by
    rw [cone_def, PointedCone.coe_closure]
    exact closure_minimal hhull_sub isClosed_halfspaceSet
  have hhalf_sub : halfspaceSet ⊆ (cone : Set (ℝ × ℝ × ℝ)) := by
    rw [cone_def, PointedCone.coe_closure, ← carrierSet_eq_halfspaceSet]
    exact carrierSet_subset_closure_positive.trans (closure_mono PointedCone.subset_hull)
  exact Subset.antisymm hcone_sub hhalf_sub

/-- The positive-scale branch `positive` is dense in the carrier of `cone`. -/
theorem closure_positive : closure positive = (cone : Set (ℝ × ℝ × ℝ)) := by
  refine Subset.antisymm ?_ ?_
  · rw [cone_def, PointedCone.coe_closure]
    exact closure_mono PointedCone.subset_hull
  · rw [coe_cone_eq_halfspaceSet, ← carrierSet_eq_halfspaceSet]
    exact carrierSet_subset_closure_positive

/-- The positive branch is contained in `cone`. -/
theorem positive_subset_cone : positive ⊆ (cone : Set (ℝ × ℝ × ℝ)) :=
  closure_positive ▸ subset_closure

/-- Membership in the closed exponential cone is the union of its positive-scale branch and its
literal zero face `v = 0 ∧ 0 ≤ u ∧ w ≤ 0`. -/
theorem mem_cone_iff {u v w : ℝ} :
    (u, v, w) ∈ cone ↔
      (0 < v ∧ v * Real.exp (w / v) ≤ u) ∨ (v = 0 ∧ 0 ≤ u ∧ w ≤ 0) :=
  Set.ext_iff.mp (coe_cone_eq_halfspaceSet.trans carrierSet_eq_halfspaceSet.symm) (u, v, w)

/-- Supporting affine halfspaces characterize the full exponential cone, including its zero face. -/
theorem mem_cone_iff_forall_exp {u v w : ℝ} :
    (u, v, w) ∈ cone ↔
      0 ≤ u ∧ 0 ≤ v ∧ ∀ a : ℝ, Real.exp a * (w + (1 - a) * v) ≤ u :=
  Set.ext_iff.mp coe_cone_eq_halfspaceSet (u, v, w)

/-! ### Branch, face, and monotonicity API -/

/-- Under strictly positive perspective scale `0 < v`, membership in `cone` simplifies to the
perspective exponential bound `v * exp (w / v) ≤ u`. -/
theorem mem_cone_iff_of_pos {u v w : ℝ} (hv : 0 < v) :
    (u, v, w) ∈ cone ↔ v * Real.exp (w / v) ≤ u := by
  rw [mem_cone_iff]
  simp [hv, hv.ne']

/-- At zero perspective scale, membership in `cone` simplifies to the literal zero-face
conditions `0 ≤ u ∧ w ≤ 0`. -/
@[simp]
theorem mem_cone_zero_iff {u w : ℝ} : (u, 0, w) ∈ cone ↔ 0 ≤ u ∧ w ≤ 0 := by
  rw [mem_cone_iff]
  simp

/-- No point with strictly negative perspective scale belongs to `cone`. -/
theorem notMem_cone_of_neg {u v w : ℝ} (hv : v < 0) : (u, v, w) ∉ cone :=
  fun h ↦ hv.not_ge (mem_cone_iff_forall_exp.mp h).2.1

/-- The positive branch is closed under coordinatewise addition. -/
theorem add_mem_positive {p q : ℝ × ℝ × ℝ} (hp : p ∈ positive) (hq : q ∈ positive) :
    p + q ∈ positive := by
  rcases p with ⟨u₁, v₁, w₁⟩
  rcases q with ⟨u₂, v₂, w₂⟩
  have hsum : (u₁ + u₂, v₁ + v₂, w₁ + w₂) ∈ cone :=
    cone.add_mem (positive_subset_cone hp) (positive_subset_cone hq)
  have hv : 0 < v₁ + v₂ := add_pos hp.1 hq.1
  exact ⟨hv, (mem_cone_iff_of_pos hv).mp hsum⟩

/-- Increasing the epigraph height preserves membership in `cone`. -/
theorem mem_cone_of_le {u u' v w : ℝ} (h : (u, v, w) ∈ cone) (hu : u ≤ u') :
    (u', v, w) ∈ cone := by
  have hzero : (u' - u, 0, 0) ∈ cone := mem_cone_zero_iff.mpr ⟨sub_nonneg.mpr hu, le_rfl⟩
  have hadd := cone.add_mem h hzero
  simpa using hadd

/-! ### Examples -/

example : (1, 1, 0) ∈ positive := by
  simp

example : (0, 1, 0) ∉ positive := by
  simp

example : (0, 0, 0) ∉ positive := by
  simp

example : (1, 1, 0) ∈ cone :=
  positive_subset_cone (by simp)

example : (2, 0, -1) ∈ cone := by
  simp

example : ((2, 0, -1) : ℝ × ℝ × ℝ) ∈ closure positive := by
  have hlim : Tendsto (fun δ : ℝ ↦ ((2 + δ, δ, -1) : ℝ × ℝ × ℝ)) (𝓝[>] (0 : ℝ))
      (𝓝 (2, 0, -1)) := by
    have hcont : Continuous (fun δ : ℝ ↦ ((2 + δ, δ, -1) : ℝ × ℝ × ℝ)) := by fun_prop
    simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
  refine mem_closure_of_tendsto hlim ?_
  filter_upwards [self_mem_nhdsWithin] with δ hδ
  exact mem_positive_add_of_nonneg_of_nonpos (by norm_num) (by norm_num) hδ

example : (1, 0, 1) ∉ cone := by
  simp

example : (1, 0, 1) ∉ cone := by
  intro h
  have hlog := (mem_cone_iff_forall_exp.mp h).2.2 (Real.log 2)
  rw [Real.exp_log two_pos] at hlog
  norm_num at hlog

example : (1, -1, 0) ∉ cone :=
  notMem_cone_of_neg (by norm_num)

example : IsClosed (cone : Set (ℝ × ℝ × ℝ)) :=
  isClosed_cone

example : Convex ℝ (cone : Set (ℝ × ℝ × ℝ)) :=
  cone.convex

example : (0 : ℝ) • ((1, 1, 0) : ℝ × ℝ × ℝ) = 0 ∧ (0 : ℝ) • ((1, 1, 0) : ℝ × ℝ × ℝ) ∈ cone :=
  ⟨zero_smul _ _, cone.smul_mem le_rfl (positive_subset_cone (by simp))⟩

example : (3 / 2, 1 / 2, -1 / 2) ∈ cone := by
  have h1 : (1, 1, 0) ∈ cone := positive_subset_cone (by simp)
  have h2 : (2, 0, -1) ∈ cone := by simp
  have hmid := cone.convex h1 h2 (a := (1 / 2 : ℝ)) (b := (1 / 2 : ℝ))
    (by norm_num) (by norm_num) (by norm_num)
  have hcoords : (1 / 2 : ℝ) • ((1 : ℝ), (1 : ℝ), (0 : ℝ)) +
      (1 / 2 : ℝ) • ((2 : ℝ), (0 : ℝ), (-1 : ℝ)) = (3 / 2, 1 / 2, -1 / 2) := by
    ext <;> norm_num
  rwa [hcoords] at hmid

end TauCeti.ExponentialCone
