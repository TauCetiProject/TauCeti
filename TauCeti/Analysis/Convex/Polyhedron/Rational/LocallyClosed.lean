/-!
# Locally closed rational-normal polyhedra and rational semilinear sets

A locally closed rational-normal polyhedron is a closed rational-normal polyhedron
cut by finitely many strict affine inequalities whose linear parts are again
rational multiples of lattice characters; all offsets are real. Such sets are
convex and locally closed, and they include the closed rational-normal polyhedra and
the sign cells of finite rational-normal arrangements, in particular the relatively
open cells cut out by equations and strict inequalities. They are stable under
intersection, under pullback along rational affine maps and under integral affine
transport. The closure of a nonempty one is obtained by weakening its strict
inequalities (`Convex.closure_inter_setOf_forall_neg`), so every closure is a closed
rational-normal polyhedron.

A rational semilinear set is a finite Boolean combination of closed rational-normal
affine half-spaces, the natural domains of piecewise-affine maps with rational
linear parts. Every such set is a union of sign cells of one finite rational-normal
arrangement, hence a finite disjoint union of locally closed rational-normal
polyhedra; conversely every finite union of locally closed rational-normal polyhedra
is rational semilinear.

The definition of `IsRationalSemilinear` and its Boolean closure API are modeled on
Mathlib's `Topology.IsConstructible` in `Mathlib.Topology.Constructible`.

## Main definitions

* `IsLocallyClosedPolyhedron`: a rational-normal polyhedron intersected with finitely
  many strict rational-normal affine inequalities.
* `IsRationalSemilinear`: membership in the Boolean subalgebra of sets generated by
  the closed rational-normal affine half-spaces.

## Main results

* `IsLocallyClosedPolyhedron.isLocallyClosed`, `IsLocallyClosedPolyhedron.convex`.
* `isLocallyClosedPolyhedron_signCell`: sign cells of finite rational-normal
  arrangements are locally closed rational-normal polyhedra.
* `IsLocallyClosedPolyhedron.isRationalNormalPolyhedron_closure`.
* `IsRationalSemilinear.exists_eq_biUnion_signCell`: a rational semilinear set is a
  union of sign cells of one finite rational-normal arrangement.
* `isRationalSemilinear_iff_exists_pairwise_disjoint`: rational semilinear sets are
  exactly the finite disjoint unions of locally closed rational-normal polyhedra.

Adapted from `Mei/Geometry/Convex/Polyhedron/Rational/LocallyClosed.lean` in
[yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
`a79c57178cc83666fc244ca6e6eeaa722e9b8bc7` (Apache 2.0).
-/

public section

namespace TauCeti

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {h : TauCeti.Toric.IsIntegralLattice i}
  {N' W : Type*} [AddCommGroup N'] [NormedAddCommGroup W] [NormedSpace ℝ W]
  {i' : N' →+ W} {h' : TauCeti.Toric.IsIntegralLattice i'}

/-- A locally closed rational-normal polyhedron: a closed rational-normal polyhedron
cut by finitely many strict affine inequalities with rational linear parts and real
offsets. -/
def IsLocallyClosedPolyhedron (h : TauCeti.Toric.IsIntegralLattice i) (S : Set V) : Prop :=
  ∃ P : Set V, IsRationalNormalPolyhedron h P ∧
    ∃ (n : ℕ) (g : Fin n → (V →ᴬ[ℝ] ℝ)),
      (∀ k, Toric.IsRationalFunctional h (g k).toAffineMap.linear) ∧
        P ∩ {x | ∀ k, g k x < 0} = S

/-- A locally closed polyhedron is a rational-normal polyhedron cut by finitely many
strict rational-normal inequalities. -/
theorem isLocallyClosedPolyhedron_iff {S : Set V} :
    IsLocallyClosedPolyhedron h S ↔
      ∃ P : Set V, IsRationalNormalPolyhedron h P ∧
        ∃ (n : ℕ) (g : Fin n → (V →ᴬ[ℝ] ℝ)),
          (∀ k, Toric.IsRationalFunctional h (g k).toAffineMap.linear) ∧
            P ∩ {x | ∀ k, g k x < 0} = S := Iff.rfl

/-- A rational-normal polyhedron cut by strict rational-normal inequalities indexed by
any finite type is a locally closed polyhedron. -/
theorem IsRationalNormalPolyhedron.isLocallyClosedPolyhedron_inter {P : Set V}
    (hP : IsRationalNormalPolyhedron h P) {κ : Type*} [Finite κ] (g : κ → (V →ᴬ[ℝ] ℝ))
    (hg : ∀ k, Toric.IsRationalFunctional h (g k).toAffineMap.linear) :
    IsLocallyClosedPolyhedron h (P ∩ {x | ∀ k, g k x < 0}) := by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin κ
  refine ⟨P, hP, n, fun k => g (e.symm k), fun k => hg _, ?_⟩
  ext x
  simp only [Set.mem_inter_iff, Set.mem_ofPred_eq, e.symm.forall_congr_left,
    Equiv.symm_symm, Equiv.symm_apply_apply]

/-- Closed rational-normal polyhedra are locally closed polyhedra, with no strict
inequality. -/
theorem IsRationalNormalPolyhedron.isLocallyClosedPolyhedron {S : Set V}
    (hS : IsRationalNormalPolyhedron h S) : IsLocallyClosedPolyhedron h S :=
  ⟨S, hS, 0, Fin.elim0, fun k => k.elim0, by ext x; simp⟩

/-- Finitely many strict affine inequalities with rational linear parts cut out a
locally closed polyhedron. -/
theorem isLocallyClosedPolyhedron_setOf_forall_neg {κ : Type*} [Finite κ]
    (g : κ → (V →ᴬ[ℝ] ℝ)) (hg : ∀ k, Toric.IsRationalFunctional h (g k).toAffineMap.linear) :
    IsLocallyClosedPolyhedron h {x | ∀ k, g k x < 0} := by
  simpa using (IsRationalNormalPolyhedron.univ h).isLocallyClosedPolyhedron_inter g hg

namespace IsLocallyClosedPolyhedron

/-- The whole space is a locally closed polyhedron. -/
@[simp]
theorem univ (h : TauCeti.Toric.IsIntegralLattice i) :
    IsLocallyClosedPolyhedron h (Set.univ : Set V) :=
  (IsRationalNormalPolyhedron.univ h).isLocallyClosedPolyhedron

/-- The empty set is a locally closed polyhedron. -/
@[simp]
theorem empty (h : TauCeti.Toric.IsIntegralLattice i) :
    IsLocallyClosedPolyhedron h (∅ : Set V) :=
  (IsRationalNormalPolyhedron.empty h).isLocallyClosedPolyhedron

/-- Locally closed polyhedra are convex. -/
theorem convex {S : Set V} (hS : IsLocallyClosedPolyhedron h S) : Convex ℝ S := by
  obtain ⟨P, hP, n, g, -, rfl⟩ := hS
  rw [Set.ofPred_forall]
  exact hP.convex.inter (convex_iInter fun k =>
    (convex_Iio (0 : ℝ)).affine_preimage (g k).toAffineMap)

/-- Locally closed polyhedra are locally closed: a closed set cut by an open one. -/
theorem isLocallyClosed {S : Set V} (hS : IsLocallyClosedPolyhedron h S) :
    IsLocallyClosed S := by
  obtain ⟨P, hP, n, g, -, rfl⟩ := hS
  rw [Set.ofPred_forall]
  exact hP.isClosed.isLocallyClosed.inter
    (isOpen_iInter_of_finite fun k => isOpen_Iio.preimage (g k).continuous).isLocallyClosed

/-- Locally closed polyhedra are closed under intersection. -/
theorem inter {S T : Set V} (hS : IsLocallyClosedPolyhedron h S)
    (hT : IsLocallyClosedPolyhedron h T) : IsLocallyClosedPolyhedron h (S ∩ T) := by
  obtain ⟨P, hP, n, g, hg, rfl⟩ := hS
  obtain ⟨Q, hQ, m, g', hg', rfl⟩ := hT
  convert (hP.inter hQ).isLocallyClosedPolyhedron_inter (Sum.elim g g') (Sum.rec hg hg') using 1
  ext x
  simp only [Set.mem_inter_iff, Set.mem_ofPred_eq, Sum.forall, Sum.elim_inl, Sum.elim_inr]
  tauto

/-- A finite intersection of locally closed rational-normal polyhedra is again
one; the empty intersection is the whole space. -/
theorem iInter {κ : Type*} [Finite κ] {S : κ → Set V}
    (hS : ∀ j, IsLocallyClosedPolyhedron h (S j)) :
    IsLocallyClosedPolyhedron h (⋂ j, S j) := by
  classical
  let := Fintype.ofFinite κ
  have hs (s : Finset κ) : IsLocallyClosedPolyhedron h (⋂ j ∈ s, S j) := by
    induction s using Finset.induction_on with
    | empty => simp
    | insert j s _ ih => simpa using (hS j).inter ih
  simpa using hs Finset.univ

/-- Locally closed polyhedra pull back along affine maps with rational linear part. -/
theorem preimage {S : Set V} (hS : IsLocallyClosedPolyhedron h S) (f : W →ᴬ[ℝ] V)
    (hf : Toric.IsRationalLinearMap h' h f.toAffineMap.linear) :
    IsLocallyClosedPolyhedron h' (f ⁻¹' S) := by
  obtain ⟨P, hP, n, g, hg, rfl⟩ := hS
  exact ⟨f ⁻¹' P, hP.preimage f hf, n, fun k => (g k).comp f,
    fun k => hf.map_functional (hg k), by ext x; simp⟩

/-- Locally closed polyhedra are invariant under integral affine transport. -/
theorem image {S : Set V} (hS : IsLocallyClosedPolyhedron h S)
    (e : Toric.IntegralAffineEquiv h h') : IsLocallyClosedPolyhedron h' (e '' S) := by
  have he : e '' S = e.symm.toContinuousAffineMap ⁻¹' S := by
    simpa only [AffineEquiv.coe_toEquiv, AffineEquiv.coe_symm_toEquiv, Set.preimage,
      Toric.IntegralAffineEquiv.toContinuousAffineMap_apply,
      Toric.IntegralAffineEquiv.symm_toAffineEquiv] using
      e.toAffineEquiv.toEquiv.image_eq_preimage_symm S
  rw [he]
  exact hS.preimage _ e.symm.isRational_toContinuousAffineMap

/-- The closure of a locally closed polyhedron is a closed rational-normal polyhedron. -/
theorem isRationalNormalPolyhedron_closure {S : Set V} (hS : IsLocallyClosedPolyhedron h S) :
    IsRationalNormalPolyhedron h (closure S) := by
  obtain ⟨P, hP, n, g, hg, rfl⟩ := hS
  rcases (P ∩ {x | ∀ k, g k x < 0}).eq_empty_or_nonempty with he | hne
  · rw [he, closure_empty]
    exact .empty h
  · rw [hP.convex.closure_inter_setOf_forall_neg hP.isClosed g hne]
    exact hP.inter (isRationalNormalPolyhedron_setOf_forall g hg)

end IsLocallyClosedPolyhedron

/-- The strict rows of a sign cell: the row or its negative for a nonzero sign, and a
constant negative row for a zero sign, whose equation is imposed weakly instead. -/
private def signCellStrictRows {ι : Type*} (g : ι → (V →ᴬ[ℝ] ℝ)) (σ : ι → SignType) :
    ι → (V →ᴬ[ℝ] ℝ) := fun j => match σ j with
  | .zero => ContinuousAffineMap.const ℝ V (-1)
  | .neg => g j
  | .pos => -g j

/-- Sign cells of a finite rational-normal arrangement are locally closed
polyhedra. Zero signs give equations and nonzero signs give strict inequalities, so
these include the relatively open cells cut out by equations and strict
inequalities. -/
theorem isLocallyClosedPolyhedron_signCell {ι : Type*} [Finite ι] (g : ι → (V →ᴬ[ℝ] ℝ))
    (hg : ∀ j, Toric.IsRationalFunctional h (g j).toAffineMap.linear) (σ : ι → SignType) :
    IsLocallyClosedPolyhedron h (Convex.signCell g σ) := by
  have hrows : ∀ j, Toric.IsRationalFunctional h
      (signCellStrictRows g σ j).toAffineMap.linear := by
    intro j
    cases hs : σ j <;> simp only [signCellStrictRows, hs]
    · exact Toric.IsRationalFunctional.zero h
    · exact hg j
    · exact (hg j).neg
  have he : Convex.signCell g σ =
      Convex.weakSignCell g σ ∩ {x | ∀ j, signCellStrictRows g σ j x < 0} := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_ofPred_eq, Convex.mem_weakSignCell,
      Convex.mem_signCell, ← forall_and]
    refine forall_congr' fun j => ?_
    cases hs : σ j <;> simp +contextual [signCellStrictRows, hs, sign_eq_zero_iff,
      sign_eq_neg_one_iff, sign_eq_one_iff, le_of_lt]
  rw [he]
  exact (Convex.isRationalNormalPolyhedron_weakSignCell g hg σ).isLocallyClosedPolyhedron_inter
    _ hrows

/-- A rational semilinear set: a finite Boolean combination of closed half-spaces
`{x | g x ≤ 0}` cut out by affine functions `g` whose linear parts are rational
multiples of lattice characters; the offsets are real. -/
def IsRationalSemilinear (h : TauCeti.Toric.IsIntegralLattice i) (S : Set V) : Prop :=
  S ∈ BooleanSubalgebra.closure
    {T : Set V | ∃ g : V →ᴬ[ℝ] ℝ,
      Toric.IsRationalFunctional h g.toAffineMap.linear ∧ {x | g x ≤ 0} = T}

/-- Rational semilinear sets belong to the Boolean subalgebra generated by closed
rational-normal half-spaces. -/
theorem isRationalSemilinear_iff {S : Set V} :
    IsRationalSemilinear h S ↔
      S ∈ BooleanSubalgebra.closure
        {T : Set V | ∃ g : V →ᴬ[ℝ] ℝ,
          Toric.IsRationalFunctional h g.toAffineMap.linear ∧ {x | g x ≤ 0} = T} := (Iff.rfl)

/-- A complement is rational semilinear exactly when the original set is. -/
@[simp]
theorem isRationalSemilinear_compl {S : Set V} :
    IsRationalSemilinear h Sᶜ ↔ IsRationalSemilinear h S :=
  BooleanSubalgebra.compl_mem_iff

namespace IsRationalSemilinear

/-- A closed rational-normal half-space is rational semilinear. -/
theorem setOf_nonpos {g : V →ᴬ[ℝ] ℝ} (hg : Toric.IsRationalFunctional h g.toAffineMap.linear) :
    IsRationalSemilinear h {x | g x ≤ 0} :=
  BooleanSubalgebra.subset_closure ⟨g, hg, rfl⟩

/-- The empty set is rational semilinear. -/
@[simp]
theorem empty (h : TauCeti.Toric.IsIntegralLattice i) :
    IsRationalSemilinear h (∅ : Set V) :=
  BooleanSubalgebra.bot_mem

/-- The whole space is rational semilinear. -/
@[simp]
theorem univ (h : TauCeti.Toric.IsIntegralLattice i) :
    IsRationalSemilinear h (Set.univ : Set V) :=
  BooleanSubalgebra.top_mem

/-- Rational semilinear sets are closed under complement. -/
theorem compl {S : Set V} (hS : IsRationalSemilinear h S) : IsRationalSemilinear h Sᶜ :=
  BooleanSubalgebra.compl_mem hS

/-- Rational semilinear sets are closed under union. -/
theorem union {S T : Set V} (hS : IsRationalSemilinear h S) (hT : IsRationalSemilinear h T) :
    IsRationalSemilinear h (S ∪ T) :=
  BooleanSubalgebra.sup_mem hS hT

/-- Rational semilinear sets are closed under intersection. -/
theorem inter {S T : Set V} (hS : IsRationalSemilinear h S) (hT : IsRationalSemilinear h T) :
    IsRationalSemilinear h (S ∩ T) :=
  BooleanSubalgebra.inf_mem hS hT

/-- Rational semilinear sets are closed under difference. -/
theorem sdiff {S T : Set V} (hS : IsRationalSemilinear h S) (hT : IsRationalSemilinear h T) :
    IsRationalSemilinear h (S \ T) :=
  BooleanSubalgebra.sdiff_mem hS hT

/-- Rational semilinear sets are closed under finite unions. -/
theorem iUnion {κ : Type*} [Finite κ] {S : κ → Set V}
    (hS : ∀ k, IsRationalSemilinear h (S k)) : IsRationalSemilinear h (⋃ k, S k) :=
  BooleanSubalgebra.iSup_mem hS

/-- Rational semilinear sets are closed under finite intersections. -/
theorem iInter {κ : Type*} [Finite κ] {S : κ → Set V}
    (hS : ∀ k, IsRationalSemilinear h (S k)) : IsRationalSemilinear h (⋂ k, S k) :=
  BooleanSubalgebra.iInf_mem hS

/-- Induction on rational semilinear sets using closed rational-normal half-spaces,
the empty set, unions, and complements. -/
@[elab_as_elim]
theorem induction_on {S : Set V} (hS : IsRationalSemilinear h S)
    {p : ∀ S, IsRationalSemilinear h S → Prop}
    (halfspace : ∀ (g : V →ᴬ[ℝ] ℝ) (hg : Toric.IsRationalFunctional h g.toAffineMap.linear),
      p {x | g x ≤ 0} (setOf_nonpos hg))
    (empty : p ∅ (empty h))
    (union : ∀ S hS T hT, p S hS → p T hT → p (S ∪ T) (hS.union hT))
    (compl : ∀ S hS, p S hS → p Sᶜ hS.compl) : p S hS := by
  induction hS using BooleanSubalgebra.closure_bot_sup_induction with
  | mem T hT =>
    obtain ⟨g, hg, rfl⟩ := hT
    exact halfspace g hg
  | bot => exact empty
  | sup S hS T hT ihS ihT => exact union S hS T hT ihS ihT
  | compl S hS ihS => exact compl S hS ihS

/-- An open rational-normal half-space is rational semilinear. -/
theorem setOf_neg {g : V →ᴬ[ℝ] ℝ} (hg : Toric.IsRationalFunctional h g.toAffineMap.linear) :
    IsRationalSemilinear h {x | g x < 0} := by
  have he : {x | g x < 0} = {x | (-g) x ≤ 0}ᶜ := by
    ext x
    simp
  rw [he]
  exact (setOf_nonpos (g := -g) hg.neg).compl

/-- Rational semilinear sets pull back along affine maps with rational linear part. -/
theorem preimage {S : Set V} (hS : IsRationalSemilinear h S) (f : W →ᴬ[ℝ] V)
    (hf : Toric.IsRationalLinearMap h' h f.toAffineMap.linear) :
    IsRationalSemilinear h' (f ⁻¹' S) := by
  induction hS using BooleanSubalgebra.closure_bot_sup_induction with
  | mem T hT =>
    obtain ⟨g, hg, rfl⟩ := hT
    exact setOf_nonpos (g := g.comp f) (hf.map_functional hg)
  | bot => exact empty h'
  | sup S _ T _ hS hT => exact hS.union hT
  | compl S _ hS => exact hS.compl

end IsRationalSemilinear

/-- Locally closed polyhedra are rational semilinear. -/
theorem IsLocallyClosedPolyhedron.isRationalSemilinear {S : Set V}
    (hS : IsLocallyClosedPolyhedron h S) : IsRationalSemilinear h S := by
  obtain ⟨P, hP, n, g, hg, rfl⟩ := hS
  obtain ⟨Q, rfl⟩ := isRationalNormalPolyhedron_iff.mp hP
  have hQ : Q.carrier = {x | ∀ j, Q.inequality j x ≤ 0} :=
    Set.ext fun _ => RationalAffinePolyhedron.mem_carrier
  rw [hQ, Set.ofPred_forall, Set.ofPred_forall]
  exact (IsRationalSemilinear.iInter fun j =>
      IsRationalSemilinear.setOf_nonpos (Q.rational_linear j)).inter
    (IsRationalSemilinear.iInter fun k => IsRationalSemilinear.setOf_neg (hg k))

/-- Membership is determined by the signs of finitely many rational-normal affine
functions. -/
private def IsSignDetermined (h : TauCeti.Toric.IsIntegralLattice i) (S : Set V) : Prop :=
  ∃ (ι : Type) (_ : Finite ι) (g : ι → (V →ᴬ[ℝ] ℝ)),
    (∀ j, Toric.IsRationalFunctional h (g j).toAffineMap.linear) ∧
      ∀ x y, (∀ j, SignType.sign (g j x) = SignType.sign (g j y)) → x ∈ S → y ∈ S

/-- Every rational semilinear set is determined by the signs of one finite
rational-normal arrangement. -/
private theorem IsRationalSemilinear.isSignDetermined {S : Set V}
    (hS : IsRationalSemilinear h S) : IsSignDetermined h S := by
  induction hS using BooleanSubalgebra.closure_bot_sup_induction with
  | mem T hT =>
    obtain ⟨g, hg, rfl⟩ := hT
    refine ⟨Unit, inferInstance, fun _ => g, fun _ => hg, fun x y hxy hx => ?_⟩
    rw [Set.mem_ofPred_eq, ← sign_nonpos_iff] at hx ⊢
    rwa [← hxy ()]
  | bot => exact ⟨Empty, inferInstance, Empty.elim, Empty.rec, fun _ _ _ hx => hx.elim⟩
  | sup S _ T _ hS hT =>
    obtain ⟨ι, _, g, hg, hgS⟩ := hS
    obtain ⟨κ, _, g', hg', hgT⟩ := hT
    refine ⟨ι ⊕ κ, inferInstance, Sum.elim g g', Sum.rec hg hg', fun x y hxy hx => ?_⟩
    rcases hx with hx | hx
    · exact Or.inl (hgS x y (fun j => hxy (.inl j)) hx)
    · exact Or.inr (hgT x y (fun j => hxy (.inr j)) hx)
  | compl S _ hS =>
    obtain ⟨ι, _, g, hg, hgS⟩ := hS
    exact ⟨ι, inferInstance, g, hg, fun x y hxy hx hy =>
      hx (hgS y x (fun j => (hxy j).symm) hy)⟩

/-- A rational semilinear set is a union of sign cells of one finite rational-normal
arrangement. -/
theorem IsRationalSemilinear.exists_eq_biUnion_signCell {S : Set V}
    (hS : IsRationalSemilinear h S) :
    ∃ (ι : Type) (_ : Finite ι) (g : ι → (V →ᴬ[ℝ] ℝ)),
      (∀ j, Toric.IsRationalFunctional h (g j).toAffineMap.linear) ∧
        ∃ s : Set (ι → SignType), ⋃ σ ∈ s, Convex.signCell g σ = S := by
  obtain ⟨ι, _, g, hg, hgS⟩ := hS.isSignDetermined
  refine ⟨ι, inferInstance, g, hg, {σ | Convex.signCell g σ ⊆ S}, ?_⟩
  apply Set.Subset.antisymm
  · exact Set.iUnion₂_subset fun σ hσ => hσ
  · intro x hx
    refine Set.mem_iUnion₂.mpr ⟨fun j => SignType.sign (g j x), fun y hy => ?_,
      Convex.mem_signCell_sign g x⟩
    exact hgS x y (fun j => (Convex.mem_signCell.mp hy j).symm) hx

/-- A union of sign cells of a finite rational-normal arrangement is rational
semilinear. -/
theorem isRationalSemilinear_biUnion_signCell {ι : Type*} [Finite ι] (g : ι → (V →ᴬ[ℝ] ℝ))
    (hg : ∀ j, Toric.IsRationalFunctional h (g j).toAffineMap.linear)
    (s : Set (ι → SignType)) :
    IsRationalSemilinear h (⋃ σ ∈ s, Convex.signCell g σ) :=
  BooleanSubalgebra.biSup_mem s.toFinite fun σ _ =>
    (isLocallyClosedPolyhedron_signCell g hg σ).isRationalSemilinear

/-- Rational semilinear sets are exactly the finite disjoint unions of locally closed
rational-normal polyhedra. -/
theorem isRationalSemilinear_iff_exists_pairwise_disjoint {S : Set V} :
    IsRationalSemilinear h S ↔
      ∃ (κ : Type) (_ : Finite κ) (C : κ → Set V),
        (∀ k, IsLocallyClosedPolyhedron h (C k)) ∧
          (Pairwise fun k l => Disjoint (C k) (C l)) ∧ ⋃ k, C k = S := by
  constructor
  · intro hS
    obtain ⟨ι, _, g, hg, s, hs⟩ := hS.exists_eq_biUnion_signCell
    refine ⟨s, inferInstance, fun σ => Convex.signCell g σ, fun σ =>
      isLocallyClosedPolyhedron_signCell g hg σ, fun σ τ hστ =>
        Convex.signCell_disjoint (Subtype.coe_injective.ne hστ), ?_⟩
    rw [← hs, Set.biUnion_eq_iUnion]
  · rintro ⟨κ, _, C, hC, -, rfl⟩
    exact IsRationalSemilinear.iUnion fun k => (hC k).isRationalSemilinear

end TauCeti
