/-!
# Carrier-defined homogenization

The homogenization of `P` is the topological closure of the pointed cone hull
of its height-one embedding. Its definition depends only on the carrier `P`.
In a Hausdorff space the empty carrier gives the zero cone. Positive-height
slices recover a closed convex base after rescaling. Closure is essential for
the height-zero directions of an unbounded base. Conversely, a closed cone in
nonnegative heights meeting height one is the homogenization of that slice.
Intersecting a closed convex base with the height-one slice of a closed cone
commutes with homogenization whenever the intersection is nonempty.
Pulling back its lineality to height zero recovers the lineality of the
recession cone.

Adapted from `Mei/Geometry/Convex/Homogenization.lean` at Mei commit
`7f1e4c7714fb020473694755ad8748c8f15d0e7f`.
-/

public section

open Set Filter
open scoped Topology

namespace Set

section Algebra

variable {R V : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
  [AddCommGroup V] [Module R V]

/-- A cone-hull point over a convex base is zero or one positive multiple of a
height-one base point. No closure is taken in this statement. -/
theorem _root_.Convex.mem_hull_heightOne_iff {P : Set V}
    (hP : _root_.Convex R P) {z : V × R} :
    z ∈ PointedCone.hull R ((fun p : V => (p, (1 : R))) '' P) ↔
      z = 0 ∨ ∃ t : R, 0 < t ∧ ∃ p ∈ P, z = (t • p, t) := by
  constructor
  · intro hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨p, hp, rfl⟩ := hz
      exact Or.inr ⟨1, zero_lt_one, p, hp, by simp⟩
    | zero => exact Or.inl rfl
    | add z w hz hw iz iw =>
      rcases iz with rfl | ⟨t, ht, p, hp, rfl⟩
      · simpa using iw
      rcases iw with rfl | ⟨s, hs, q, hq, rfl⟩
      · exact Or.inr ⟨t, ht, p, hp, by simp⟩
      obtain ⟨r, hr, he⟩ := hP.exists_mem_add_smul_eq hp hq ht.le hs.le
      exact Or.inr ⟨t + s, add_pos ht hs, r, hr, Prod.ext he.symm rfl⟩
    | smul c z hz iz =>
      rcases iz with rfl | ⟨t, ht, p, hp, rfl⟩
      · exact Or.inl (smul_zero _)
      rcases eq_or_lt_of_le c.property with hc | hc
      · left
        simp only [← Nonneg.coe_smul, Prod.smul_mk, smul_eq_mul]
        simp [← hc]
      · right
        refine ⟨c.val * t, mul_pos hc ht, p, hp, ?_⟩
        simp only [← Nonneg.coe_smul, Prod.smul_mk, smul_eq_mul, smul_smul]
  · rintro (rfl | ⟨t, ht, p, hp, rfl⟩)
    · exact Submodule.zero_mem _
    · have hm := PointedCone.smul_mem
        (PointedCone.hull R ((fun p : V => (p, (1 : R))) '' P)) ht.le
        (PointedCone.subset_hull (Set.mem_image_of_mem _ hp))
      simpa using hm

end Algebra

section Topology

variable {V : Type*} [AddCommGroup V] [Module ℝ V] [TopologicalSpace V]
  [ContinuousAdd V] [ContinuousSMul ℝ V]

/-- The closed pointed cone generated by the height-one embedding of a set. -/
def homogenization (P : Set V) : PointedCone ℝ (V × ℝ) :=
  (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)).topologicalClosure

/-- Membership in homogenization is membership in the closure of the actual cone hull. -/
theorem mem_homogenization_iff {P : Set V} {z : V × ℝ} :
    z ∈ homogenization P ↔
      z ∈ closure (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) : Set (V × ℝ)) :=
  (Iff.rfl)

/-- Homogenization is a closed cone. -/
theorem isClosed_homogenization (P : Set V) : IsClosed (homogenization P : Set (V × ℝ)) :=
  Submodule.isClosed_topologicalClosure _

/-- The height-one embedding lies in the homogenization. -/
theorem mem_homogenization_one {P : Set V} {p : V} (hp : p ∈ P) :
    (p, (1 : ℝ)) ∈ homogenization P :=
  Submodule.le_topologicalClosure _ (PointedCone.subset_hull ⟨p, hp, rfl⟩)

/-- A closed cone contains the homogenization exactly when it contains every
height-one generator. -/
theorem homogenization_le_iff {P : Set V} {C : PointedCone ℝ (V × ℝ)}
    (hC : IsClosed (C : Set (V × ℝ))) :
    homogenization P ≤ C ↔ ∀ p ∈ P, (p, (1 : ℝ)) ∈ C := by
  constructor
  · intro h p hp
    exact h (mem_homogenization_one hp)
  · intro h
    apply Submodule.topologicalClosure_minimal _ _ hC
    apply Submodule.span_le.mpr
    rintro _ ⟨p, hp, rfl⟩
    exact h p hp

/-- Homogenization preserves inclusions of carriers. -/
theorem homogenization_mono {P Q : Set V} (h : P ⊆ Q) :
    homogenization P ≤ homogenization Q :=
  Submodule.topologicalClosure_mono (Submodule.span_mono (Set.image_mono h))

/-- The empty base gives exactly the zero cone. -/
@[simp]
theorem homogenization_empty [T2Space V] : homogenization (∅ : Set V) = ⊥ := by
  apply SetLike.ext'
  simp [homogenization, Submodule.topologicalClosure_coe]

/-- Homogenization has no points of negative height. -/
theorem homogenization_height_nonneg {P : Set V} {z : V × ℝ}
    (hz : z ∈ homogenization P) : 0 ≤ z.2 := by
  apply closure_minimal (s :=
      (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) : Set (V × ℝ)))
    (t := {z : V × ℝ | 0 ≤ z.2}) ?_
    (isClosed_le continuous_const continuous_snd) hz
  have hcone : PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) ≤
      (PointedCone.positive ℝ ℝ).comap (LinearMap.snd ℝ V ℝ) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨p, _, rfl⟩
    simpa only [SetLike.mem_coe, PointedCone.mem_comap, LinearMap.snd_apply,
      PointedCone.mem_positive, Set.mem_ofPred_eq]
      using (zero_le_one : (0 : ℝ) ≤ 1)
  exact fun z hz => by
    simpa only [SetLike.mem_coe, PointedCone.mem_comap, LinearMap.snd_apply,
      PointedCone.mem_positive, Set.mem_ofPred_eq] using hcone hz

/-- A point belongs to homogenization when its positive-height rescaling lies in the base. -/
theorem mem_homogenization_of_inv_smul_mem {P : Set V} {x : V} {t : ℝ}
    (ht : 0 < t) (hx : t⁻¹ • x ∈ P) : (x, t) ∈ homogenization P := by
  have hm := PointedCone.smul_mem (homogenization P) ht.le (mem_homogenization_one hx)
  convert hm using 1
  simp [ht.ne']

/-- Positive-height slices recover a closed convex base after rescaling. -/
theorem _root_.Convex.mem_homogenization_pos_iff {P : Set V} (hconvex : _root_.Convex ℝ P)
    (hclosed : IsClosed P) {x : V} {t : ℝ} (ht : 0 < t) :
    (x, t) ∈ homogenization P ↔ t⁻¹ • x ∈ P := by
  constructor
  · intro hz
    rw [mem_homogenization_iff] at hz
    have := mem_closure_iff_nhdsWithin_neBot.mp hz
    have hsnd : Tendsto (fun z : V × ℝ => z.2)
        (𝓝[PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)] (x, t)) (𝓝 t) :=
      (continuous_snd.tendsto (x, t)).mono_left nhdsWithin_le_nhds
    have hfst : Tendsto (fun z : V × ℝ => z.1)
        (𝓝[PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)] (x, t)) (𝓝 x) :=
      (continuous_fst.tendsto (x, t)).mono_left nhdsWithin_le_nhds
    have hpos := hsnd.eventually (lt_mem_nhds ht)
    apply hclosed.mem_of_tendsto ((hsnd.inv₀ ht.ne').smul hfst)
    filter_upwards [self_mem_nhdsWithin, hpos] with z hz hk
    rcases (hconvex.mem_hull_heightOne_iff).mp hz with he | ⟨s, hs, p, hp, he⟩
    · simp [he] at hk
    · simp only [he, inv_smul_smul₀ hs.ne']
      exact hp
  · exact mem_homogenization_of_inv_smul_mem ht

/-- The height-one slice of a closed convex base is precisely the original carrier. -/
@[simp]
theorem _root_.Convex.mem_homogenization_one_iff {P : Set V} (hconvex : _root_.Convex ℝ P)
    (hclosed : IsClosed P) {x : V} :
    (x, (1 : ℝ)) ∈ homogenization P ↔ x ∈ P := by
  simpa using hconvex.mem_homogenization_pos_iff hclosed (x := x) zero_lt_one

/-- Every recession direction of a nonempty base occurs at height zero in its
closed homogenization. -/
theorem mem_homogenization_zero_of_mem_recessionCone {P : Set V} (hne : P.Nonempty)
    {v : V} (hv : v ∈ recessionCone ℝ P) : (v, (0 : ℝ)) ∈ homogenization P := by
  obtain ⟨p, hp⟩ := hne
  rw [mem_homogenization_iff]
  have hlim : Tendsto (fun ε : ℝ => (v + ε • p, ε)) (𝓝[>] 0) (𝓝 (v, (0 : ℝ))) := by
    have hf : Continuous (fun ε : ℝ => (v + ε • p, ε)) :=
      (continuous_const.add (continuous_id.smul continuous_const)).prodMk continuous_id
    have hh : Tendsto (fun ε : ℝ => (v + ε • p, ε)) (𝓝[>] (0 : ℝ))
        (𝓝 (v + (0 : ℝ) • p, (0 : ℝ))) :=
      (hf.tendsto 0).mono_left nhdsWithin_le_nhds
    simpa only [zero_smul, add_zero] using hh
  apply mem_closure_of_tendsto hlim
  filter_upwards [self_mem_nhdsWithin] with ε hε
  have hpos : 0 < ε := hε
  have hpv : p + ε⁻¹ • v ∈ P := (mem_recessionCone.mp hv) p hp ε⁻¹ (inv_nonneg.mpr hpos.le)
  have hm := PointedCone.smul_mem
    (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)) hpos.le
    (PointedCone.subset_hull (Set.mem_image_of_mem _ hpv))
  have he : (v + ε • p, ε) = ε • (p + ε⁻¹ • v, (1 : ℝ)) := by
    ext
    · simp only [Prod.smul_mk]
      rw [smul_add, smul_inv_smul₀ hpos.ne']
      exact add_comm _ _
    · simp
  rw [he]
  exact hm

/-- Height-zero membership implies preservation of all nonnegative base rays. -/
theorem _root_.Convex.mem_recessionCone_of_mem_homogenization_zero {P : Set V}
    (hconvex : _root_.Convex ℝ P) (hclosed : IsClosed P) {v : V}
    (hv : (v, (0 : ℝ)) ∈ homogenization P) :
    v ∈ recessionCone ℝ P := by
  rw [mem_recessionCone]
  intro p hp t ht
  apply (hconvex.mem_homogenization_one_iff hclosed).mp
  have hm := (homogenization P).add_mem (mem_homogenization_one hp)
    (PointedCone.smul_mem (homogenization P) ht hv)
  simpa using hm

/-- For a nonempty closed convex base, its recession cone is precisely the
height-zero slice of its carrier-defined homogenization. -/
theorem _root_.Convex.mem_homogenization_zero_iff {P : Set V} (hconvex : _root_.Convex ℝ P)
    (hne : P.Nonempty) (hclosed : IsClosed P) {v : V} :
    (v, (0 : ℝ)) ∈ homogenization P ↔ v ∈ recessionCone ℝ P :=
  ⟨hconvex.mem_recessionCone_of_mem_homogenization_zero hclosed,
    mem_homogenization_zero_of_mem_recessionCone hne⟩

/-- The lineality of a nonempty closed convex set's recession cone is the
height-zero pullback of the lineality of its homogenization. -/
theorem _root_.Convex.lineal_recessionCone_eq_comap {P : Set V}
    (hconvex : _root_.Convex ℝ P) (hne : P.Nonempty) (hclosed : IsClosed P) :
    (recessionCone ℝ P).lineal =
      (homogenization P).lineal.comap (LinearMap.inl ℝ V ℝ) := by
  ext v
  simp only [Submodule.mem_comap, LinearMap.inl_apply, PointedCone.mem_lineal,
    Prod.neg_mk, neg_zero, hconvex.mem_homogenization_zero_iff hne hclosed]

end Topology

end Set

namespace PointedCone

variable {V : Type*} [AddCommGroup V] [Module ℝ V] [TopologicalSpace V]
  [ContinuousAdd V] [ContinuousSMul ℝ V]

/-- A closed cone in nonnegative heights, meeting height one, is determined by
its height-one slice, including all its height-zero directions. -/
theorem homogenization_slice_one (C : PointedCone ℝ (V × ℝ))
    (hclosed : IsClosed (C : Set (V × ℝ))) (hheight : ∀ z ∈ C, 0 ≤ z.2)
    (hne : {x : V | (x, (1 : ℝ)) ∈ C}.Nonempty) :
    Set.homogenization {x : V | (x, (1 : ℝ)) ∈ C} = C := by
  let P := {x : V | (x, (1 : ℝ)) ∈ C}
  have hpos {x : V} {t : ℝ} (ht : 0 < t) (hz : (x, t) ∈ C) :
      (x, t) ∈ Set.homogenization P := by
    have hbase : (t⁻¹ • x, (1 : ℝ)) ∈ C := by
      have hm := C.smul_mem (inv_nonneg.mpr ht.le) hz
      simpa [ht.ne'] using hm
    exact Set.mem_homogenization_of_inv_smul_mem ht hbase
  apply le_antisymm
  · exact (Set.homogenization_le_iff hclosed).mpr fun x hx => hx
  · rintro ⟨x, t⟩ hz
    rcases (hheight _ hz).eq_or_lt with rfl | ht
    · exact Set.mem_homogenization_zero_of_mem_recessionCone hne
        (Set.mem_recessionCone.mpr fun p hp s hs => by
          simpa using C.add_mem hp (C.smul_mem hs hz))
    · exact hpos ht hz

end PointedCone

/-- If the height-one slice of a closed cone meets a closed convex set, homogenizing
their intersection recovers the intersection of the two cones at every height. -/
theorem Convex.homogenization_setOf_mem_eq_inf {V : Type*} [AddCommGroup V] [Module ℝ V]
    [TopologicalSpace V] [ContinuousAdd V] [ContinuousSMul ℝ V] {P : Set V}
    (hconv : Convex ℝ P) (hclosed : IsClosed P) {C : PointedCone ℝ (V × ℝ)}
    (hC : IsClosed (C : Set (V × ℝ))) (hne : {x ∈ P | (x, (1 : ℝ)) ∈ C}.Nonempty) :
    Set.homogenization {x ∈ P | (x, (1 : ℝ)) ∈ C} = Set.homogenization P ⊓ C := by
  have hslice : {x : V | (x, (1 : ℝ)) ∈ Set.homogenization P ⊓ C} =
      {x ∈ P | (x, (1 : ℝ)) ∈ C} := by
    ext
    simp only [Set.mem_ofPred_eq, Submodule.mem_inf, hconv.mem_homogenization_one_iff hclosed]
  rw [← hslice] at hne ⊢
  exact (Set.homogenization P ⊓ C).homogenization_slice_one
    ((Set.isClosed_homogenization P).inter hC)
    (fun _ hz => Set.homogenization_height_nonneg hz.1) hne
