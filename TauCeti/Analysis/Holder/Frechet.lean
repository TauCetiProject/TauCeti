/-!
# The Fréchet space `C^{k,α}_loc(Ω)` of locally Hölder maps

Let `Ω` be an open subset of a real normed space `E`. This file constructs the space
`C^{k,α}_loc(Ω, F)` (`TauCeti.CkHolderLocSpace k α Ω F`) of maps `Ω → F` that are `C^k` on `Ω` and
whose `k`-th iterated derivative is `α`-Hölder on every compact subset of `Ω`, with the topology of
convergence of all derivatives through order `k`, together with the `α`-Hölder seminorm of the
`k`-th derivative, uniformly on compact subsets of `Ω`. An element is stored as a map `E → F`
vanishing outside `Ω`, so it is determined by its values on `Ω`
(`TauCeti.CkHolderLocSpace.ext`).

For a compact `K ⊆ Ω` the seminorm `p_K` (`TauCeti.CkHolderLocSpace.seminorm`) is the larger of
`max_{i ≤ k} sup_K ‖D^i f‖` and `sup_K ‖D^k f‖ + [D^k f]_{α,K}`. It is comparable, within a
factor `k + 2`, to the usual `∑_{i ≤ k} sup_K ‖D^i f‖ + [D^k f]_{α,K}`, and it is characterized by
the bounds `TauCeti.CkHolderLocSpace.norm_iteratedFDeriv_le_seminorm`,
`TauCeti.CkHolderLocSpace.holderOnWith_seminorm` and `TauCeti.CkHolderLocSpace.seminorm_le`. The
topology is the one generated by the family of all `p_K`
(`TauCeti.CkHolderLocSpace.withSeminorms`), so the space is a locally convex Hausdorff
topological vector space. When `E` is proper, the seminorms of a compact exhaustion of `Ω` already
generate the topology (`TauCeti.CkHolderLocSpace.withSeminorms_of_forall_exists_subset`), so the
topology is first countable; when moreover `F` is complete, the space is complete. Thus
`C^{k,α}_loc(Ω)` is a Fréchet space for `E = ℝⁿ` and a Banach codomain. For `α ≤ 1`, nonempty `Ω`,
`n ≥ 1` and nontrivial `F` it is not normable (`TauCeti.CkHolderLocSpace.not_isNormableSpace`): a
smooth bump supported in `Ω` away from a compact set `K` has `p_K = 0` without vanishing.

This is the space of solutions of interior Schauder estimates: such an estimate bounds `p_K u` by
data on a slightly larger compact set, with no control up to the boundary of `Ω`. It differs from
the Banach space of maps with *globally* bounded `C^{k,α}` norm on `Ω`. On `Ω = (0, 1)` the map
`x ↦ 1 / x` lies in `C^{k,α}_loc(Ω)` for every `k` and every `α ≤ 1` but is unbounded, and on
`(-1, 0) ∪ (0, 1)` the sign function lies in `C^{0,α}_loc` for every `α > 0` although its global
`α`-Hölder seminorm is infinite.

## Main declarations

* `TauCeti.CkHolderLocSpace k α Ω F`: the space `C^{k,α}_loc(Ω, F)`, with its vector space
  structure and the constructor `TauCeti.CkHolderLocSpace.ofContDiffOn`.
* `TauCeti.CkHolderLocSpace.seminorm`, `TauCeti.CkHolderLocSpace.seminormFamily`: the seminorms
  `p_K`, monotone in `K` (`TauCeti.CkHolderLocSpace.seminorm_mono`).
* `TauCeti.CkHolderLocSpace.withSeminorms`: the topology is generated by the `p_K`.
* `TauCeti.CkHolderLocSpace.instFirstCountableTopology` and
  `TauCeti.CkHolderLocSpace.instCompleteSpace`: first countability for proper `E`, and
  completeness for locally compact `E` and complete `F`.
* `TauCeti.CkHolderLocSpace.not_isNormableSpace`: the topology is not given by a norm.

## Implementation notes

As for Mathlib's `ContDiffMapSupportedIn` and `TestFunction`, an element is stored as a map on the
whole space vanishing outside `Ω`. The topology, uniform structure and `IsUniformAddGroup`
instance are built from the seminorm family as for Mathlib's `SchwartzMap`
(`Mathlib/Analysis/Distribution/SchwartzSpace/Basic.lean`).

## References

* D. Gilbarg and N. S. Trudinger, *Elliptic Partial Differential Equations of Second Order*,
  Section 4.1 (the local Hölder spaces `C^{k,α}(Ω)`).
* W. Rudin, *Functional Analysis*, 2nd ed., Section 1.46 (the Fréchet space `C^∞(Ω)` defined by
  the seminorms of a compact exhaustion).
-/

public section

noncomputable section

namespace TauCeti

open Set Filter Topology TopologicalSpace
open scoped NNReal BoundedContinuousFunction

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The space `C^{k,α}_loc(Ω, F)` of maps that are `C^k` on the open set `Ω` and whose `k`-th
iterated derivative is `α`-Hölder on every compact subset of `Ω`. An element is a map `E → F`
vanishing outside `Ω`; its values outside `Ω` carry no information. -/
structure CkHolderLocSpace (k : ℕ) (α : ℝ≥0) (Ω : Opens E) (F : Type*) [NormedAddCommGroup F]
    [NormedSpace ℝ F] where
  /-- The underlying map, extended by zero outside `Ω`. -/
  protected toFun : E → F
  /-- The map is `C^k` on `Ω`. -/
  protected contDiffOn' : ContDiffOn ℝ k toFun Ω
  /-- The `k`-th iterated derivative is `α`-Hölder on every compact subset of `Ω`. -/
  protected holderOnWith' : ∀ K ⊆ (Ω : Set E), IsCompact K →
    ∃ C, HolderOnWith C α (iteratedFDeriv ℝ k toFun) K
  /-- The map vanishes outside `Ω`. -/
  protected eqOn_compl' : EqOn toFun 0 (Ω : Set E)ᶜ

namespace CkHolderLocSpace

variable {k : ℕ} {α : ℝ≥0} {Ω : Opens E} {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

instance instFunLike : FunLike (CkHolderLocSpace k α Ω F) E F where
  coe f := f.toFun
  coe_injective f g h := by cases f; cases g; congr

theorem contDiffOn (f : CkHolderLocSpace k α Ω F) : ContDiffOn ℝ k f Ω :=
  f.contDiffOn'

theorem exists_holderOnWith (f : CkHolderLocSpace k α Ω F) {K : Set E} (hKΩ : K ⊆ Ω)
    (hK : IsCompact K) : ∃ C, HolderOnWith C α (iteratedFDeriv ℝ k f) K :=
  f.holderOnWith' K hKΩ hK

theorem apply_of_notMem (f : CkHolderLocSpace k α Ω F) {x : E} (hx : x ∉ Ω) : f x = 0 :=
  f.eqOn_compl' hx

/-- An element of `C^{k,α}_loc(Ω)` is determined by its values on `Ω`. -/
@[ext]
theorem ext {f g : CkHolderLocSpace k α Ω F} (h : ∀ x ∈ Ω, f x = g x) : f = g := by
  refine DFunLike.ext _ _ fun x => ?_
  by_cases hx : x ∈ Ω
  · exact h x hx
  · rw [f.apply_of_notMem hx, g.apply_of_notMem hx]

/-- An element of `C^{k,α}_loc(Ω)` is `C^i` at every point of `Ω`, for `i ≤ k`. -/
theorem contDiffAt (f : CkHolderLocSpace k α Ω F) {i : ℕ} (hi : i ≤ k) {x : E} (hx : x ∈ Ω) :
    ContDiffAt ℝ i f x :=
  (f.contDiffOn.contDiffAt (Ω.isOpen.mem_nhds hx)).of_le (Nat.cast_le.mpr hi)

/-! ### The vector space structure -/

instance instZero : Zero (CkHolderLocSpace k α Ω F) where
  zero := ⟨0, contDiffOn_const, fun _ _ _ => ⟨0, by
    rw [iteratedFDeriv_zero]
    intro x _ y _
    simp⟩, fun _ _ => rfl⟩

instance instAdd : Add (CkHolderLocSpace k α Ω F) where
  add f g := ⟨f + g, f.contDiffOn.add g.contDiffOn, fun K hKΩ hK => by
    obtain ⟨C, hC⟩ := f.exists_holderOnWith hKΩ hK
    obtain ⟨C', hC'⟩ := g.exists_holderOnWith hKΩ hK
    exact ⟨C + C', hC.iteratedFDeriv_add hC' (fun x hx => f.contDiffAt le_rfl (hKΩ hx))
      fun x hx => g.contDiffAt le_rfl (hKΩ hx)⟩,
    fun x hx => by simp [f.apply_of_notMem hx, g.apply_of_notMem hx]⟩

instance instSMul : SMul ℝ (CkHolderLocSpace k α Ω F) where
  smul c f := ⟨c • ⇑f, f.contDiffOn.const_smul c, fun K hKΩ hK => by
    obtain ⟨C, hC⟩ := f.exists_holderOnWith hKΩ hK
    exact ⟨C * ‖c‖₊, (HolderWith.restrict_iff.mp
      ((HolderWith.restrict_iff.mpr hC).smul c)).congr fun _ hx =>
        (iteratedFDeriv_const_smul_apply (f.contDiffAt le_rfl (hKΩ hx))).symm⟩,
    fun x hx => by simp [f.apply_of_notMem hx]⟩

instance instNeg : Neg (CkHolderLocSpace k α Ω F) where
  neg f := ⟨-⇑f, f.contDiffOn.neg, fun K hKΩ hK => by
    obtain ⟨C, hC⟩ := f.exists_holderOnWith hKΩ hK
    refine ⟨C, fun x hx y hy => ?_⟩
    rw [iteratedFDeriv_neg_apply, iteratedFDeriv_neg_apply, edist_neg_neg]
    exact hC x hx y hy,
    fun x hx => by simp [f.apply_of_notMem hx]⟩

instance instSub : Sub (CkHolderLocSpace k α Ω F) where
  sub f g := f + -g

instance instSMulNat : SMul ℕ (CkHolderLocSpace k α Ω F) where
  smul n f := (n : ℝ) • f

instance instSMulInt : SMul ℤ (CkHolderLocSpace k α Ω F) where
  smul n f := (n : ℝ) • f

@[simp, norm_cast]
theorem coe_zero : ⇑(0 : CkHolderLocSpace k α Ω F) = 0 :=
  (rfl)

@[simp, norm_cast]
theorem coe_add (f g : CkHolderLocSpace k α Ω F) : ⇑(f + g) = f + g :=
  (rfl)

@[simp, norm_cast]
theorem coe_smul (c : ℝ) (f : CkHolderLocSpace k α Ω F) : ⇑(c • f) = c • ⇑f :=
  (rfl)

@[simp, norm_cast]
theorem coe_neg (f : CkHolderLocSpace k α Ω F) : ⇑(-f) = -⇑f :=
  (rfl)

@[simp, norm_cast]
theorem coe_sub (f g : CkHolderLocSpace k α Ω F) : ⇑(f - g) = f - g :=
  (sub_eq_add_neg (f : E → F) g).symm

instance instAddCommGroup : AddCommGroup (CkHolderLocSpace k α Ω F) :=
  DFunLike.coe_injective.addCommGroup _ coe_zero coe_add coe_neg coe_sub
    (fun f n => (coe_smul (n : ℝ) f).trans (Nat.cast_smul_eq_nsmul ℝ n (f : E → F)))
    (fun f n => (coe_smul (n : ℝ) f).trans (Int.cast_smul_eq_zsmul ℝ n (f : E → F)))

instance instModule : Module ℝ (CkHolderLocSpace k α Ω F) :=
  DFunLike.coe_injective.module ℝ
    (AddMonoidHom.mk' (fun f : CkHolderLocSpace k α Ω F => ⇑f) coe_add) coe_smul

@[simp]
theorem add_apply (f g : CkHolderLocSpace k α Ω F) (x : E) : (f + g) x = f x + g x :=
  (rfl)

@[simp]
theorem smul_apply (c : ℝ) (f : CkHolderLocSpace k α Ω F) (x : E) : (c • f) x = c • f x :=
  (rfl)

@[simp]
theorem zero_apply (x : E) : (0 : CkHolderLocSpace k α Ω F) x = 0 :=
  (rfl)

@[simp]
theorem neg_apply (f : CkHolderLocSpace k α Ω F) (x : E) : (-f) x = -f x :=
  (rfl)

@[simp]
theorem sub_apply (f g : CkHolderLocSpace k α Ω F) (x : E) : (f - g) x = f x - g x :=
  congrFun (coe_sub f g) x

theorem continuousOn_iteratedFDeriv (f : CkHolderLocSpace k α Ω F) {i : ℕ} (hi : i ≤ k) :
    ContinuousOn (iteratedFDeriv ℝ i f) Ω :=
  (f.contDiffOn.continuousOn_iteratedFDerivWithin (Nat.cast_le.mpr hi)
    Ω.isOpen.uniqueDiffOn).congr fun _ hx => (iteratedFDerivWithin_of_isOpen i Ω.isOpen hx).symm

theorem iteratedFDeriv_add_apply (f g : CkHolderLocSpace k α Ω F) {i : ℕ} (hi : i ≤ k) {x : E}
    (hx : x ∈ Ω) :
    iteratedFDeriv ℝ i ⇑(f + g) x = iteratedFDeriv ℝ i f x + iteratedFDeriv ℝ i g x :=
  _root_.iteratedFDeriv_add_apply (f.contDiffAt hi hx) (g.contDiffAt hi hx)

theorem iteratedFDeriv_smul_apply (c : ℝ) (f : CkHolderLocSpace k α Ω F) {i : ℕ} (hi : i ≤ k)
    {x : E} (hx : x ∈ Ω) : iteratedFDeriv ℝ i ⇑(c • f) x = c • iteratedFDeriv ℝ i f x :=
  iteratedFDeriv_const_smul_apply (f.contDiffAt hi hx)

theorem iteratedFDeriv_sub_apply (f g : CkHolderLocSpace k α Ω F) {i : ℕ} (hi : i ≤ k) {x : E}
    (hx : x ∈ Ω) :
    iteratedFDeriv ℝ i ⇑(f - g) x = iteratedFDeriv ℝ i f x - iteratedFDeriv ℝ i g x := by
  rw [coe_sub]
  exact _root_.iteratedFDeriv_sub_apply (f.contDiffAt hi hx) (g.contDiffAt hi hx)

/-! ### Construction from a map on `Ω` -/

/-- An element of `C^{k,α}_loc(Ω)` from a map `g : E → F` that is `C^k` on `Ω` with `k`-th
derivative `α`-Hölder on compact subsets of `Ω`. It agrees with `g` on `Ω`
(`TauCeti.CkHolderLocSpace.ofContDiffOn_apply_of_mem`); the values of `g` outside `Ω` are
discarded. -/
def ofContDiffOn (g : E → F) (hg : ContDiffOn ℝ k g Ω)
    (hgH : ∀ K ⊆ (Ω : Set E), IsCompact K → ∃ C, HolderOnWith C α (iteratedFDeriv ℝ k g) K) :
    CkHolderLocSpace k α Ω F :=
  have heq : ∀ x ∈ Ω, (Ω : Set E).indicator g =ᶠ[𝓝 x] g := fun x hx =>
    eventually_of_mem (Ω.isOpen.mem_nhds hx) fun y hy => indicator_of_mem hy g
  ⟨(Ω : Set E).indicator g, hg.congr fun y hy => indicator_of_mem hy g, fun K hKΩ hK => by
    obtain ⟨C, hC⟩ := hgH K hKΩ hK
    exact ⟨C, hC.congr fun x hx => ((heq x (hKΩ hx)).iteratedFDeriv ℝ k).eq_of_nhds.symm⟩,
    fun _ hx => indicator_of_notMem hx g⟩

@[simp]
theorem ofContDiffOn_apply_of_mem (g : E → F) (hg : ContDiffOn ℝ k g Ω)
    (hgH : ∀ K ⊆ (Ω : Set E), IsCompact K → ∃ C, HolderOnWith C α (iteratedFDeriv ℝ k g) K)
    {x : E} (hx : x ∈ Ω) : ofContDiffOn g hg hgH x = g x :=
  indicator_of_mem hx g

@[simp]
theorem ofContDiffOn_coe (f : CkHolderLocSpace k α Ω F) :
    ofContDiffOn f f.contDiffOn (fun _ hKΩ hK => f.exists_holderOnWith hKΩ hK) = f :=
  ext fun _ hx => ofContDiffOn_apply_of_mem _ _ _ hx

@[simp]
theorem iteratedFDeriv_ofContDiffOn (g : E → F) (hg : ContDiffOn ℝ k g Ω)
    (hgH : ∀ K ⊆ (Ω : Set E), IsCompact K → ∃ C, HolderOnWith C α (iteratedFDeriv ℝ k g) K)
    (i : ℕ) {x : E} (hx : x ∈ Ω) :
    iteratedFDeriv ℝ i (ofContDiffOn g hg hgH) x = iteratedFDeriv ℝ i g x :=
  (Filter.EventuallyEq.iteratedFDeriv ℝ
    (eventually_of_mem (Ω.isOpen.mem_nhds hx) fun _ hy => indicator_of_mem hy g) i).eq_of_nhds

/-! ### The seminorms -/

variable (k α F) in
/-- The restrictions of the derivatives through order `k` to a compact set `K`, with the
supremum norm, together with the `k`-th derivative in the Hölder space of `K`. -/
private abbrev Jet (K : Set E) : Type _ :=
  (Π i : Fin (k + 1), K →ᵇ (E [×i]→L[ℝ] F)) × HolderSpace α K (E [×k]→L[ℝ] F)

/-- The `i`-th derivative of `f`, restricted to the compact set `K ⊆ Ω`. -/
private def derivOn (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) {i : ℕ} (hi : i ≤ k) : K →ᵇ (E [×i]→L[ℝ] F) :=
  @BoundedContinuousFunction.mkOfCompact _ _ _ _ (isCompact_iff_compactSpace.mp hK)
    ⟨K.domRestrict (iteratedFDeriv ℝ i f),
      ((f.continuousOn_iteratedFDeriv hi).mono hKΩ).domRestrict⟩

private theorem derivOn_apply (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) {i : ℕ} (hi : i ≤ k) (x : K) :
    f.derivOn hK hKΩ hi x = iteratedFDeriv ℝ i f x :=
  (rfl)

/-- The `k`-th derivative of `f` on the compact set `K ⊆ Ω`, in the Hölder space of `K`. -/
private def derivHolder (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) : HolderSpace α K (E [×k]→L[ℝ] F) :=
  HolderSpace.ofBoundedContinuousFunction (f.derivOn hK hKΩ le_rfl) (by
    obtain ⟨C, hC⟩ := f.exists_holderOnWith hKΩ hK
    exact (HolderWith.restrict_iff.mpr hC).memHolder)

private theorem derivHolder_apply (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) (x : K) : f.derivHolder hK hKΩ x = iteratedFDeriv ℝ k f x :=
  HolderSpace.ofBoundedContinuousFunction_apply _ _ x

/-- The jet of `f` on the compact set `K ⊆ Ω`. -/
private def jet {K : Set E} (hK : IsCompact K) (hKΩ : K ⊆ Ω) :
    CkHolderLocSpace k α Ω F →ₗ[ℝ] Jet k α F K where
  toFun f := (fun i => f.derivOn hK hKΩ (Nat.lt_succ_iff.mp i.2), f.derivHolder hK hKΩ)
  map_add' f g := by
    refine Prod.ext (funext fun i => BoundedContinuousFunction.ext fun x => ?_)
      (HolderSpace.ext fun x => ?_)
    · simp only [Prod.fst_add, Pi.add_apply, _root_.add_apply, derivOn_apply]
      exact iteratedFDeriv_add_apply f g (Nat.lt_succ_iff.mp i.2) (hKΩ x.2)
    · simp only [Prod.snd_add, HolderSpace.add_apply, derivHolder_apply]
      exact iteratedFDeriv_add_apply f g le_rfl (hKΩ x.2)
  map_smul' c f := by
    refine Prod.ext (funext fun i => BoundedContinuousFunction.ext fun x => ?_)
      (HolderSpace.ext fun x => ?_)
    · simp only [Prod.smul_fst, Pi.smul_apply, _root_.smul_apply, RingHom.id_apply,
        derivOn_apply]
      exact iteratedFDeriv_smul_apply c f (Nat.lt_succ_iff.mp i.2) (hKΩ x.2)
    · simp only [Prod.smul_snd, RingHom.id_apply, HolderSpace.smul_apply, derivHolder_apply]
      exact iteratedFDeriv_smul_apply c f le_rfl (hKΩ x.2)

private theorem jet_fst_apply (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) (i : Fin (k + 1)) (x : K) :
    (jet hK hKΩ f).1 i x = iteratedFDeriv ℝ i f x :=
  (rfl)

private theorem jet_snd (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) : (jet hK hKΩ f).2 = f.derivHolder hK hKΩ :=
  (rfl)

private theorem jet_snd_apply (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) (x : K) : (jet hK hKΩ f).2 x = iteratedFDeriv ℝ k f x :=
  derivHolder_apply f hK hKΩ x

/-- The seminorm `p_K` of `C^{k,α}_loc(Ω)` attached to a compact set `K ⊆ Ω`: the larger of
`max_{i ≤ k} sup_K ‖D^i f‖` and `sup_K ‖D^k f‖ + [D^k f]_{α,K}`. -/
def seminorm {K : Set E} (hK : IsCompact K) (hKΩ : K ⊆ Ω) :
    Seminorm ℝ (CkHolderLocSpace k α Ω F) :=
  (normSeminorm ℝ (Jet k α F K)).comp (jet hK hKΩ)

private theorem seminorm_apply {K : Set E} (hK : IsCompact K) (hKΩ : K ⊆ Ω)
    (f : CkHolderLocSpace k α Ω F) : seminorm hK hKΩ f = ‖jet hK hKΩ f‖ :=
  (rfl)

/-- The seminorm `p_K` bounds the derivatives through order `k` on `K`. -/
theorem norm_iteratedFDeriv_le_seminorm (f : CkHolderLocSpace k α Ω F) {K : Set E}
    (hK : IsCompact K) (hKΩ : K ⊆ Ω) {i : ℕ} (hi : i ≤ k) {x : E} (hx : x ∈ K) :
    ‖iteratedFDeriv ℝ i f x‖ ≤ seminorm hK hKΩ f := by
  rw [seminorm_apply]
  calc ‖iteratedFDeriv ℝ i f x‖ = ‖(jet hK hKΩ f).1 ⟨i, Nat.lt_succ_iff.mpr hi⟩ ⟨x, hx⟩‖ := by
        rw [jet_fst_apply]
    _ ≤ ‖(jet hK hKΩ f).1 ⟨i, Nat.lt_succ_iff.mpr hi⟩‖ :=
        BoundedContinuousFunction.norm_coe_le_norm _ _
    _ ≤ ‖(jet hK hKΩ f).1‖ := norm_le_pi_norm (jet hK hKΩ f).1 ⟨i, Nat.lt_succ_iff.mpr hi⟩
    _ ≤ ‖jet hK hKΩ f‖ := norm_fst_le _

/-- The seminorm `p_K` bounds the `α`-Hölder constant of the `k`-th derivative on `K`. -/
theorem holderOnWith_seminorm (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) :
    HolderOnWith (seminorm hK hKΩ f).toNNReal α (iteratedFDeriv ℝ k f) K := by
  have hle : ‖(jet hK hKΩ f).2‖₊ ≤ (seminorm hK hKΩ f).toNNReal :=
    (Real.le_toNNReal_iff_coe_le (apply_nonneg _ _)).mpr (norm_snd_le (jet hK hKΩ f))
  refine HolderOnWith.mono_const (HolderWith.restrict_iff.mp ?_) hle
  convert (jet hK hKΩ f).2.holderWith_nnnorm using 1
  exact funext fun x => (jet_snd_apply f hK hKΩ x).symm

/-- Conversely, bounds on the derivatives through order `k` and on the Hölder constant of the
`k`-th derivative on `K` bound the seminorm `p_K`. -/
theorem seminorm_le (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K) (hKΩ : K ⊆ Ω)
    {M : ℝ} (hM : 0 ≤ M) (hfM : ∀ i ≤ k, ∀ x ∈ K, ‖iteratedFDeriv ℝ i f x‖ ≤ M) {C : ℝ≥0}
    (hfC : HolderOnWith C α (iteratedFDeriv ℝ k f) K) : seminorm hK hKΩ f ≤ M + C := by
  have hbcf : ∀ (i : ℕ) (hi : i ≤ k), ‖f.derivOn hK hKΩ hi‖ ≤ M := fun i hi =>
    (BoundedContinuousFunction.norm_le hM).mpr fun x => hfM i hi x x.2
  rw [seminorm_apply, Prod.norm_def, max_le_iff]
  refine ⟨((pi_norm_le_iff_of_nonneg (x := (jet hK hKΩ f).1) hM).mpr
    fun i => hbcf i (Nat.lt_succ_iff.mp i.2)).trans
    (le_add_of_nonneg_right C.2), ?_⟩
  rw [jet_snd, HolderSpace.norm_def, derivHolder,
    HolderSpace.toBoundedContinuousFunction_ofBoundedContinuousFunction]
  refine add_le_add (hbcf k le_rfl) (NNReal.coe_le_coe.mpr (HolderWith.nnholderNorm_le ?_))
  intro x y
  rw [derivOn_apply, derivOn_apply]
  exact hfC x x.2 y y.2

/-- The seminorm `p_K` is monotone in `K`. -/
theorem seminorm_mono (f : CkHolderLocSpace k α Ω F) {K K' : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) (hK' : IsCompact K') (hK'Ω : K' ⊆ Ω) (hKK' : K ⊆ K') :
    seminorm hK hKΩ f ≤ seminorm hK' hK'Ω f := by
  rw [seminorm_apply, seminorm_apply, Prod.norm_def, Prod.norm_def]
  refine max_le_max ?_ ?_
  · refine (pi_norm_le_iff_of_nonneg (norm_nonneg _)).mpr fun i => ?_
    refine (BoundedContinuousFunction.norm_le (norm_nonneg _)).mpr fun x => ?_
    calc ‖(jet hK hKΩ f).1 i x‖ = ‖(jet hK' hK'Ω f).1 i ⟨x, hKK' x.2⟩‖ := by
          rw [jet_fst_apply, jet_fst_apply]
      _ ≤ ‖(jet hK' hK'Ω f).1 i‖ := BoundedContinuousFunction.norm_coe_le_norm _ _
      _ ≤ ‖(jet hK' hK'Ω f).1‖ := norm_le_pi_norm (jet hK' hK'Ω f).1 i
  · have hg : LipschitzWith 1 fun x : K => (⟨x, hKK' x.2⟩ : K') :=
      (LipschitzWith.subtype_val K).subtype_mk _
    have heq : (jet hK hKΩ f).2 = HolderSpace.compLipschitzL _ hg (jet hK' hK'Ω f).2 :=
      HolderSpace.ext fun x => by
        rw [HolderSpace.compLipschitzL_apply, jet_snd_apply, jet_snd_apply]
    rw [heq]
    exact (ContinuousLinearMap.le_of_opNorm_le _ (HolderSpace.norm_compLipschitzL_le_one hg)
      _).trans (one_mul _).le

/-- The seminorm `p_K` bounds the values on `K`. -/
theorem norm_apply_le_seminorm (f : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) {x : E} (hx : x ∈ K) : ‖f x‖ ≤ seminorm hK hKΩ f := by
  simpa only [norm_iteratedFDeriv_zero] using
    f.norm_iteratedFDeriv_le_seminorm hK hKΩ (Nat.zero_le k) hx

/-! ### The topology -/

variable (k α Ω F) in
/-- The family of seminorms `p_K` of `C^{k,α}_loc(Ω)`, indexed by the compact subsets `K` of
`Ω`. -/
def seminormFamily :
    SeminormFamily ℝ (CkHolderLocSpace k α Ω F) {K : Set E // IsCompact K ∧ K ⊆ Ω} :=
  fun K => seminorm K.2.1 K.2.2

@[simp]
theorem seminormFamily_apply (K : {K : Set E // IsCompact K ∧ K ⊆ Ω}) :
    seminormFamily k α Ω F K = seminorm K.2.1 K.2.2 :=
  (rfl)

/-- The topology of `C^{k,α}_loc(Ω)`: uniform convergence of the derivatives through order `k` and
of the Hölder seminorm of the `k`-th derivative on compact subsets of `Ω`. -/
instance instTopologicalSpace : TopologicalSpace (CkHolderLocSpace k α Ω F) :=
  (seminormFamily k α Ω F).moduleFilterBasis.topology'

variable (k α Ω F) in
/-- The topology of `C^{k,α}_loc(Ω)` is generated by the seminorms `p_K`. -/
theorem withSeminorms : WithSeminorms (seminormFamily k α Ω F) :=
  ⟨rfl⟩

instance instIsTopologicalAddGroup : IsTopologicalAddGroup (CkHolderLocSpace k α Ω F) :=
  (seminormFamily k α Ω F).addGroupFilterBasis.isTopologicalAddGroup

instance instContinuousSMul : ContinuousSMul ℝ (CkHolderLocSpace k α Ω F) := by
  rw [(withSeminorms k α Ω F).withSeminorms_eq]
  exact (seminormFamily k α Ω F).moduleFilterBasis.continuousSMul

instance instUniformSpace : UniformSpace (CkHolderLocSpace k α Ω F) :=
  (seminormFamily k α Ω F).addGroupFilterBasis.uniformSpace

instance instIsUniformAddGroup : IsUniformAddGroup (CkHolderLocSpace k α Ω F) :=
  (seminormFamily k α Ω F).addGroupFilterBasis.isUniformAddGroup

instance instLocallyConvexSpace : LocallyConvexSpace ℝ (CkHolderLocSpace k α Ω F) :=
  (withSeminorms k α Ω F).toLocallyConvexSpace

instance instT2Space : T2Space (CkHolderLocSpace k α Ω F) := by
  have : T1Space (CkHolderLocSpace k α Ω F) :=
    (withSeminorms k α Ω F).T1_of_separating fun f hf => by
      obtain ⟨x, hx⟩ : ∃ x, f x ≠ 0 := by
        by_contra! h
        exact hf (DFunLike.ext _ _ h)
      have hxΩ : x ∈ Ω := by_contra fun hxΩ => hx (f.apply_of_notMem hxΩ)
      refine ⟨⟨{x}, isCompact_singleton, singleton_subset_iff.mpr hxΩ⟩, ?_⟩
      exact ((norm_pos_iff.mpr hx).trans_le
        (f.norm_apply_le_seminorm _ _ (mem_singleton x))).ne'
  infer_instance

theorem continuous_seminorm {K : Set E} (hK : IsCompact K) (hKΩ : K ⊆ Ω) :
    Continuous (seminorm (k := k) (α := α) (F := F) hK hKΩ) :=
  (withSeminorms k α Ω F).continuous_seminorm ⟨K, hK, hKΩ⟩

/-- If every compact subset of `Ω` lies in one of the compact sets `K n ⊆ Ω`, for instance for a
compact exhaustion of `Ω`, then the countably many seminorms `p_{K n}` generate the topology of
`C^{k,α}_loc(Ω)`. -/
theorem withSeminorms_of_forall_exists_subset {K : ℕ → Set E} (hK : ∀ n, IsCompact (K n))
    (hKΩ : ∀ n, K n ⊆ Ω) (hcof : ∀ L ⊆ (Ω : Set E), IsCompact L → ∃ n, L ⊆ K n) :
    WithSeminorms fun n => seminorm (k := k) (α := α) (F := F) (hK n) (hKΩ n) := by
  refine (withSeminorms k α Ω F).congr (fun n => ⟨{⟨K n, hK n, hKΩ n⟩}, 1, ?_⟩)
    fun L => ?_
  · rw [Finset.sup_singleton, one_smul, Seminorm.comp_id, seminormFamily_apply]
  · obtain ⟨n, hn⟩ := hcof L.1 L.2.2 L.2.1
    refine ⟨{n}, 1, fun f => ?_⟩
    rw [Finset.sup_singleton, one_smul, Seminorm.comp_id, seminormFamily_apply]
    exact f.seminorm_mono _ _ _ _ hn

/-- For a proper `E`, such as `ℝⁿ`, the topology of `C^{k,α}_loc(Ω)` is first countable: it is
generated by the seminorms of a compact exhaustion of `Ω`. -/
instance instFirstCountableTopology [ProperSpace E] :
    FirstCountableTopology (CkHolderLocSpace k α Ω F) := by
  obtain ⟨K, hK, hKint, hKU, -⟩ := Ω.isOpen.exists_isFilledIn_compact_exhaustion
  have hKΩ : ∀ n, K n ⊆ Ω := fun n => (subset_iUnion K n).trans hKU.le
  have hmono : Monotone fun n => interior (K (n + 1)) := monotone_nat_of_le_succ fun n =>
    interior_mono ((hKint (n + 1)).trans interior_subset)
  refine (withSeminorms_of_forall_exists_subset hK hKΩ fun L hLΩ hL => ?_).firstCountableTopology
  have hcover : L ⊆ ⋃ n, interior (K (n + 1)) := fun x hx => by
    obtain ⟨m, hm⟩ := mem_iUnion.mp (hKU.ge (hLΩ hx))
    exact mem_iUnion.mpr ⟨m, hKint m hm⟩
  obtain ⟨n, hn⟩ := hL.elim_directed_cover _ (fun _ => isOpen_interior) hcover hmono.directed_le
  exact ⟨n + 1, hn.trans interior_subset⟩

/-! ### The topology is not normable -/

/-- For every compact `K ⊆ Ω` there is an element of `C^{k,α}_loc(Ω)` with `p_K f = 0` that does not
vanish at some point of `Ω`: a smooth bump supported in `Ω` away from `K`. -/
private theorem exists_seminorm_eq_zero [FiniteDimensional ℝ E] [Nontrivial E] [Nontrivial F]
    (hα : α ≤ 1) (hΩ : (Ω : Set E).Nonempty) {K : Set E} (hK : IsCompact K) (hKΩ : K ⊆ Ω) :
    ∃ f : CkHolderLocSpace k α Ω F, ∃ x ∈ Ω, seminorm hK hKΩ f = 0 ∧ f x ≠ 0 := by
  -- A compact subset of `Ω` misses a point of `Ω`, since otherwise `Ω` is clopen and compact.
  obtain ⟨x, hxΩ, hxK⟩ : ∃ x ∈ Ω, x ∉ K := by
    by_contra! h
    have hΩK : (Ω : Set E) = K := Subset.antisymm (fun x hx => h x hx) hKΩ
    have huniv : (Ω : Set E) = univ := IsClopen.eq_univ ⟨hΩK ▸ hK.isClosed, Ω.isOpen⟩ hΩ
    exact noncompact_univ E (by rw [← huniv, hΩK]; exact hK)
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp (Ω.isOpen.sdiff hK.isClosed) x ⟨hxΩ, hxK⟩
  obtain ⟨v, hv⟩ := exists_ne (0 : F)
  let φ : ContDiffBump x := ⟨ε / 4, ε / 2, by positivity, by linarith⟩
  set u : E → F := fun y => φ y • v with hu_def
  have hu : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) u := φ.contDiff.smul contDiff_const
  have hsupp' : tsupport u ⊆ Metric.closedBall x (ε / 2) :=
    (tsupport_smul_subset_left _ _).trans φ.tsupport_eq.le
  have hsupp : tsupport u ⊆ Metric.ball x ε :=
    hsupp'.trans (Metric.closedBall_subset_ball (by linarith))
  have hcs : HasCompactSupport u :=
    (isCompact_closedBall x (ε / 2)).of_isClosed_subset (isClosed_tsupport u) hsupp'
  -- `D^k u` is bounded and Lipschitz, hence `α`-Hölder on every set.
  obtain ⟨L, hL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport (hcs.iteratedFDeriv k)
    (hu.iteratedFDeriv_right (m := 1) (by exact_mod_cast le_top)) one_ne_zero
  obtain ⟨M, hM⟩ := (hcs.iteratedFDeriv k).exists_bound_of_continuous
    (hu.continuous_iteratedFDeriv (by simp))
  have hH : ∀ L' ⊆ (Ω : Set E), IsCompact L' →
      ∃ C, HolderOnWith C α (iteratedFDeriv ℝ k u) L' := fun L' _ _ =>
    ⟨_, (hL.lipschitzOnWith (s := L')).holderOnWith_of_norm_le
      (M := M.toNNReal) (fun y _ => (hM y).trans (Real.le_coe_toNNReal M)) hα⟩
  let f : CkHolderLocSpace k α Ω F :=
    ofContDiffOn u (hu.of_le (by exact_mod_cast le_top)).contDiffOn hH
  have hzero : ∀ i, ∀ y ∈ K, iteratedFDeriv ℝ i f y = 0 := fun i y hy => by
    rw [iteratedFDeriv_ofContDiffOn _ _ _ i (hKΩ hy)]
    exact image_eq_zero_of_notMem_tsupport fun hyu =>
      (hball (hsupp (tsupport_iteratedFDeriv_subset i hyu))).2 hy
  refine ⟨f, x, hxΩ, le_antisymm ?_ (apply_nonneg _ _), ?_⟩
  · have h := f.seminorm_le hK hKΩ le_rfl (fun i _ y hy => by rw [hzero i y hy, norm_zero])
      (C := 0) fun y hy z hz => by rw [hzero k y hy, hzero k z hz, edist_self]; exact bot_le
    rwa [NNReal.coe_zero, add_zero] at h
  · rw [ofContDiffOn_apply_of_mem _ _ _ hxΩ]
    simpa only [hu_def, φ.one_of_mem_closedBall (Metric.mem_closedBall_self (by positivity)),
      one_smul] using hv

/-- For `α ≤ 1`, a nonempty `Ω` in a finite-dimensional nontrivial `E`, such as `ℝⁿ` with `n ≥ 1`,
and a nontrivial `F`, the topology of `C^{k,α}_loc(Ω, F)` is not given by a norm: no
finite set of seminorms `p_K` controls the values of a map off a compact subset of `Ω`. -/
theorem not_isNormableSpace [FiniteDimensional ℝ E] [Nontrivial E] [Nontrivial F] (hα : α ≤ 1)
    (hΩ : (Ω : Set E).Nonempty) : ¬ IsNormableSpace ℝ (CkHolderLocSpace k α Ω F) := by
  rintro ⟨q, hq⟩
  -- The norm `q` is bounded by finitely many `p_K`, hence by the one of their union `K₀`.
  obtain ⟨s, C, -, hqC⟩ := Seminorm.bound_of_continuous (withSeminorms k α Ω F) q
    (hq.continuous_seminorm ())
  have hK₀ : IsCompact (⋃ K ∈ s, K.1) := s.isCompact_biUnion fun K _ => K.2.1
  have hK₀Ω : (⋃ K ∈ s, K.1) ⊆ Ω := iUnion₂_subset fun K _ => K.2.2
  obtain ⟨f, x, hxΩ, hf0, hfx⟩ := exists_seminorm_eq_zero (k := k) (F := F) hα hΩ hK₀ hK₀Ω
  have hqf : q f = 0 := by
    refine le_antisymm ((hqC f).trans ?_) (apply_nonneg _ _)
    rw [_root_.smul_apply, NNReal.smul_def, smul_eq_mul]
    refine mul_nonpos_of_nonneg_of_nonpos C.2 (Seminorm.finset_sup_apply_le le_rfl fun K hK => ?_)
    rw [seminormFamily_apply, ← hf0]
    exact f.seminorm_mono _ _ _ _ (subset_biUnion_of_mem (u := fun K : {K : Set E // _} => K.1) hK)
  -- But `p_{x}` is bounded by a multiple of `q`, and `p_{x} f ≥ ‖f x‖ > 0`.
  obtain ⟨t, C', -, hpq⟩ := Seminorm.bound_of_continuous hq
    (seminorm (k := k) (α := α) (F := F) isCompact_singleton (singleton_subset_iff.mpr hxΩ))
    (continuous_seminorm _ _)
  have hpf := (f.norm_apply_le_seminorm isCompact_singleton (singleton_subset_iff.mpr hxΩ)
    (mem_singleton x)).trans (hpq f)
  rw [_root_.smul_apply, NNReal.smul_def, smul_eq_mul] at hpf
  have : t.sup (fun _ => q) f ≤ 0 := Seminorm.finset_sup_apply_le le_rfl fun _ _ => hqf.le
  exact hfx (norm_le_zero_iff.mp (hpf.trans (mul_nonpos_of_nonneg_of_nonpos C'.2 this)))

/-! ### Completeness -/

private theorem derivHolder_sub (f g : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) : (f - g).derivHolder hK hKΩ = f.derivHolder hK hKΩ - g.derivHolder hK hKΩ :=
  HolderSpace.ext fun x => by
    rw [HolderSpace.sub_apply, derivHolder_apply, derivHolder_apply, derivHolder_apply,
      iteratedFDeriv_sub_apply f g le_rfl (hKΩ x.2)]

private theorem dist_derivOn_le (f g : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) {i : ℕ} (hi : i ≤ k) :
    dist (f.derivOn hK hKΩ hi) (g.derivOn hK hKΩ hi) ≤ seminorm hK hKΩ (f - g) :=
  (BoundedContinuousFunction.dist_le (apply_nonneg _ _)).mpr fun x => by
    rw [derivOn_apply, derivOn_apply, dist_eq_norm, ← iteratedFDeriv_sub_apply f g hi (hKΩ x.2)]
    exact (f - g).norm_iteratedFDeriv_le_seminorm hK hKΩ hi x.2

private theorem dist_derivHolder_le (f g : CkHolderLocSpace k α Ω F) {K : Set E}
    (hK : IsCompact K) (hKΩ : K ⊆ Ω) :
    dist (f.derivHolder hK hKΩ) (g.derivHolder hK hKΩ) ≤ seminorm hK hKΩ (f - g) := by
  rw [dist_eq_norm, ← derivHolder_sub, ← jet_snd, seminorm_apply]
  exact norm_snd_le _

/-- The seminorm `p_K (f - g)` is controlled by the distances between the restricted derivatives of
`f` and `g`. -/
private theorem seminorm_sub_le (f g : CkHolderLocSpace k α Ω F) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) {ε : ℝ} (hε : 0 ≤ ε)
    (h₁ : ∀ i : Fin (k + 1), dist (f.derivOn hK hKΩ (Nat.lt_succ_iff.mp i.2))
      (g.derivOn hK hKΩ (Nat.lt_succ_iff.mp i.2)) ≤ ε)
    (h₂ : dist (f.derivHolder hK hKΩ) (g.derivHolder hK hKΩ) ≤ ε) :
    seminorm hK hKΩ (f - g) ≤ ε := by
  rw [seminorm_apply, Prod.norm_def, max_le_iff]
  refine ⟨(pi_norm_le_iff_of_nonneg (x := (jet hK hKΩ (f - g)).1) hε).mpr fun i =>
    (BoundedContinuousFunction.norm_le hε).mpr fun x => ?_, ?_⟩
  · rw [jet_fst_apply, iteratedFDeriv_sub_apply f g (Nat.lt_succ_iff.mp i.2) (hKΩ x.2),
      ← dist_eq_norm, ← derivOn_apply f hK hKΩ (Nat.lt_succ_iff.mp i.2),
      ← derivOn_apply g hK hKΩ (Nat.lt_succ_iff.mp i.2)]
    exact (BoundedContinuousFunction.dist_coe_le_dist x).trans (h₁ i)
  · rw [jet_snd, derivHolder_sub, ← dist_eq_norm]
    exact h₂

/-- A map that is `1`-Lipschitz for one of the seminorms `p_K` sends Cauchy filters to Cauchy
filters. -/
private theorem cauchy_map_of_dist_le {X : Type*} [PseudoMetricSpace X]
    {l : Filter (CkHolderLocSpace k α Ω F)} (hl : Cauchy l) {K : Set E} (hK : IsCompact K)
    (hKΩ : K ⊆ Ω) (φ : CkHolderLocSpace k α Ω F → X)
    (hφ : ∀ f g, dist (φ f) (φ g) ≤ seminorm hK hKΩ (f - g)) : Cauchy (map φ l) := by
  refine Metric.cauchy_iff.mpr ⟨hl.1.map _, fun ε hε => ?_⟩
  have hV : {h : CkHolderLocSpace k α Ω F | seminorm hK hKΩ h < ε} ∈ 𝓝 0 :=
    ((continuous_seminorm hK hKΩ).tendsto' 0 0 (map_zero _)).eventually (gt_mem_nhds hε)
  obtain ⟨s, hs, hss⟩ :=
    mem_prod_same_iff.mp (((IsUniformAddGroup.cauchy_iff_tendsto l).mp hl).2 hV)
  refine ⟨φ '' s, image_mem_map hs, ?_⟩
  rintro _ ⟨f, hf, rfl⟩ _ ⟨g, hg, rfl⟩
  have hfg := hss (mk_mem_prod hf hg)
  simp only [mem_preimage, mem_ofPred_eq] at hfg
  exact (hφ f g).trans_lt hfg

/-- If the restricted derivatives of a filter of elements converge on every compact subset of
`Ω`, then their limits are the restricted derivatives of a single element. -/
private theorem exists_eq_of_tendsto [LocallyCompactSpace E]
    {l : Filter (CkHolderLocSpace k α Ω F)} [l.NeBot]
    (J₁ : ∀ (K : {K : Set E // IsCompact K ∧ K ⊆ Ω}) (i : Fin (k + 1)), K.1 →ᵇ (E [×i]→L[ℝ] F))
    (J₂ : ∀ K : {K : Set E // IsCompact K ∧ K ⊆ Ω}, HolderSpace α K.1 (E [×k]→L[ℝ] F))
    (hJ₁ : ∀ K i, Tendsto (fun f => f.derivOn K.2.1 K.2.2 (Nat.lt_succ_iff.mp i.2)) l
      (𝓝 (J₁ K i)))
    (hJ₂ : ∀ K, Tendsto (fun f => f.derivHolder K.2.1 K.2.2) l (𝓝 (J₂ K))) :
    ∃ g : CkHolderLocSpace k α Ω F, (∀ K i, g.derivOn K.2.1 K.2.2 (Nat.lt_succ_iff.mp i.2) =
      J₁ K i) ∧ ∀ K, g.derivHolder K.2.1 K.2.2 = J₂ K := by
  -- The candidate derivatives are the pointwise limits.
  set G : (m : ℕ) → E → E [×m]→L[ℝ] F := fun m x => limUnder l fun f => iteratedFDeriv ℝ m f x
  have hJ₁G : ∀ K i (y : K.1), J₁ K i y = G i y := fun K i y =>
    ((((continuous_eval_const y).tendsto _).comp (hJ₁ K i)).limUnder_eq).symm
  have hJ₂G : ∀ K (y : K.1), J₂ K y = G k y := fun K y => by
    have h := ((HolderSpace.evalCLM (α := α) y).continuous.tendsto (J₂ K)).comp (hJ₂ K)
    simp only [Function.comp_def, HolderSpace.evalCLM_apply, derivHolder_apply] at h
    exact h.limUnder_eq.symm
  -- The derivatives converge locally uniformly on `Ω`.
  have hunif : ∀ m : ℕ, m ≤ k →
      TendstoLocallyUniformlyOn (fun (f : CkHolderLocSpace k α Ω F) x => iteratedFDeriv ℝ m f x)
        (G m) l Ω := by
    intro m hm
    refine (tendstoLocallyUniformlyOn_iff_forall_isCompact Ω.isOpen).mpr fun L hLΩ hL => ?_
    have h := BoundedContinuousFunction.tendsto_iff_tendstoUniformly.mp
      (hJ₁ ⟨L, hL, hLΩ⟩ ⟨m, Nat.lt_succ_iff.mpr hm⟩)
    have hlim : ⇑(J₁ ⟨L, hL, hLΩ⟩ ⟨m, Nat.lt_succ_iff.mpr hm⟩) = G m ∘ Subtype.val :=
      funext fun y => hJ₁G _ _ y
    rw [hlim] at h
    exact tendstoUniformlyOn_iff_tendstoUniformly_comp_coe.mpr h
  have hpt : ∀ x ∈ Ω, Tendsto (fun f : CkHolderLocSpace k α Ω F => f x) l (𝓝 ((G 0 x) 0)) :=
    fun x hx => by
      have h := ((continuous_eval_const (0 : Fin 0 → E)).tendsto _).comp
        ((hunif 0 (Nat.zero_le k)).tendsto_at hx)
      exact h.congr fun f => iteratedFDeriv_zero_apply _
  -- The limit map, extended by zero, has the limits as its Taylor series on `Ω`.
  set g : E → F := (Ω : Set E).indicator fun x => (G 0 x) 0
  have hT : HasFTaylorSeriesUpToOn k g (fun x m => G m x) Ω := by
    refine HasFTaylorSeriesUpToOn.of_tendstoLocallyUniformlyOn Ω.isOpen
      (fun f : CkHolderLocSpace k α Ω F => f.contDiffOn.ftaylorSeriesWithin Ω.isOpen.uniqueDiffOn)
      (fun m hm => ?_) fun x hx => by simpa only [g, indicator_of_mem hx] using hpt x hx
    exact (hunif m (by exact_mod_cast hm)).congr fun f x hx =>
      (iteratedFDerivWithin_of_isOpen m Ω.isOpen hx).symm
  have hgG : ∀ m ≤ k, ∀ x ∈ Ω, iteratedFDeriv ℝ m g x = G m x := fun m hm x hx => by
    rw [← iteratedFDerivWithin_of_isOpen m Ω.isOpen hx,
      hT.eq_iteratedFDerivWithin_of_uniqueDiffOn (Nat.cast_le.mpr hm) Ω.isOpen.uniqueDiffOn hx]
  let g' : CkHolderLocSpace k α Ω F :=
    ⟨g, hT.contDiffOn, fun L hLΩ hL => ⟨‖J₂ ⟨L, hL, hLΩ⟩‖₊, HolderWith.restrict_iff.mp (by
      convert (J₂ ⟨L, hL, hLΩ⟩).holderWith_nnnorm using 1
      exact funext fun y => (hgG k le_rfl y (hLΩ y.2)).trans (hJ₂G ⟨L, hL, hLΩ⟩ y).symm)⟩,
      fun x hx => indicator_of_notMem hx _⟩
  refine ⟨g', fun K i => BoundedContinuousFunction.ext fun y => ?_,
    fun K => HolderSpace.ext fun y => ?_⟩
  · exact (hgG i (Nat.lt_succ_iff.mp i.2) y (K.2.2 y.2)).trans (hJ₁G K i y).symm
  · exact (derivHolder_apply g' _ _ y).trans ((hgG k le_rfl y (K.2.2 y.2)).trans (hJ₂G K y).symm)

/-- For a locally compact `E`, such as `ℝⁿ`, and a complete `F`, the space `C^{k,α}_loc(Ω, F)` is
complete. -/
instance instCompleteSpace [LocallyCompactSpace E] [CompleteSpace F] :
    CompleteSpace (CkHolderLocSpace k α Ω F) := by
  refine ⟨fun {l} hl => ?_⟩
  have := hl.1
  have h₁ : ∀ (K : {K : Set E // IsCompact K ∧ K ⊆ Ω}) (i : Fin (k + 1)), ∃ J,
      Tendsto (fun f : CkHolderLocSpace k α Ω F => f.derivOn K.2.1 K.2.2
        (Nat.lt_succ_iff.mp i.2)) l (𝓝 J) := fun K i =>
    CompleteSpace.complete (cauchy_map_of_dist_le hl K.2.1 K.2.2 _ fun f g =>
      dist_derivOn_le f g K.2.1 K.2.2 _)
  have h₂ : ∀ K : {K : Set E // IsCompact K ∧ K ⊆ Ω}, ∃ J,
      Tendsto (fun f : CkHolderLocSpace k α Ω F => f.derivHolder K.2.1 K.2.2) l (𝓝 J) := fun K =>
    CompleteSpace.complete (cauchy_map_of_dist_le hl K.2.1 K.2.2 _ fun f g =>
      dist_derivHolder_le f g K.2.1 K.2.2)
  choose J₁ hJ₁ using h₁
  choose J₂ hJ₂ using h₂
  obtain ⟨g, hg₁, hg₂⟩ := exists_eq_of_tendsto J₁ J₂ hJ₁ hJ₂
  refine ⟨g, ((withSeminorms k α Ω F).tendsto_nhds id g).mpr fun K ε hε => ?_⟩
  have hε2 : 0 < ε / 2 := half_pos hε
  filter_upwards [eventually_all.mpr fun i => Metric.tendsto_nhds.mp (hJ₁ K i) _ hε2,
    Metric.tendsto_nhds.mp (hJ₂ K) _ hε2] with f hf₁ hf₂
  refine (seminorm_sub_le f g K.2.1 K.2.2 hε2.le (fun i => ?_) ?_).trans_lt (half_lt_self hε)
  · exact (hg₁ K i ▸ hf₁ i).le
  · exact (hg₂ K ▸ hf₂).le

end CkHolderLocSpace

end TauCeti
