/-!
# Compatible planarity of closed webs

A `TauCeti.ClosedWeb` stores at each vertex a cyclic order of its three interval ends, but
nothing in the record asks that the web can be drawn in the plane with these cyclic orders. This
file supplies the combinatorial test.

The darts of the graph are the interval ends `W.End`. The **end swap** `τ`
(`TauCeti.ClosedWeb.endSwap`) exchanges the two ends of each interval edge. The **effective
rotation** `ρ` (`TauCeti.ClosedWeb.rotation`) is the stored cyclic order `κ` at a split vertex
and its inverse `κ⁻¹` at a merge vertex; this is the surface rotation of Goertz–Marino–Wedrich's
conversion from generator words to abstract webs, recorded in the docstring of
`TauCeti.ClosedWeb`. The cycles of `ρ`, `τ` and `ρ * τ` are the vertices, edges and faces of the
closed oriented surface on which the graph is cellularly embedded, and the orbits of the group
generated by `ρ` and `τ` are its connected components. Each component contributes at most `2` to
`V - E + F`, with equality exactly for a sphere, so a web is **compatibly planar**
(`TauCeti.ClosedWeb.IsCompatiblyPlanar`) when `V - E + F` is twice the number of components.
`TauCeti.ClosedWeb.isCompatiblyPlanar_iff_forall_eulerChar_restrictToOrbit` restates this as the
componentwise test `V_C - E_C + F_C = 2` on every component `C`.

Vertex-free circles are not darts. A circle subdivided by an auxiliary bivalent vertex is a
sphere component with Euler value `1 - 1 + 2 = 2`, so circles always pass the componentwise
test and are left out of the count. In particular the empty web, and every web without vertices,
is compatibly planar. The test reads the prescribed rotation, not whether the underlying graph
admits some planar rotation: the theta web is compatibly planar, while the theta web with the
cyclic order reversed at one vertex (`TauCeti.ClosedWeb.twistedTheta`) has a single face and is
not.

The rotation system is a bipartite ribbon graph (`TauCeti.ClosedWeb.toRibbonGraph`), with the
vertices black, the interval edges white, and the ends as its edges. Its Euler characteristic and
connected components are those above, and web isomorphisms give ribbon-graph isomorphisms. The
test is invariant under isomorphism, mirror reversal (which inverts `ρ`) and orientation reversal
(which conjugates `ρ⁻¹` by `τ`, so that renaming each end by the opposite end of its edge makes
the reversed and mirrored rotation systems isomorphic), and a disjoint union is compatibly planar
exactly when both summands are.

## Main definitions

* `TauCeti.ClosedWeb.rotation`, `TauCeti.ClosedWeb.endSwap`, `TauCeti.ClosedWeb.facePerm`: the
  effective rotation, the end swap and the face traversal.
* `TauCeti.ClosedWeb.faceCount`, `TauCeti.ClosedWeb.Component`, `TauCeti.ClosedWeb.eulerChar`:
  faces, connected components and `V - E + F`.
* `TauCeti.ClosedWeb.IsCompatiblyPlanar`: every component of the rotation system is a sphere.
* `TauCeti.ClosedWeb.toRibbonGraph`: the rotation system as a bipartite ribbon graph, with
  `TauCeti.ClosedWeb.Iso.toRibbonGraphIso` and `TauCeti.ClosedWeb.reverseRibbonGraphIsoMirror`.
* `TauCeti.ClosedWeb.twistedTheta`: the theta web with the cyclic order at one vertex reversed.

## Main results

* `TauCeti.ClosedWeb.eulerChar_le_two_mul_card_component`: the Euler bound.
* `TauCeti.ClosedWeb.isCompatiblyPlanar_iff_forall_eulerChar_restrictToOrbit`: the componentwise
  test.
* `TauCeti.ClosedWeb.Iso.isCompatiblyPlanar_iff`, `TauCeti.ClosedWeb.isCompatiblyPlanar_reverse`,
  `TauCeti.ClosedWeb.isCompatiblyPlanar_mirror`, `TauCeti.ClosedWeb.isCompatiblyPlanar_sum`:
  closure under the planar operations.
* `TauCeti.ClosedWeb.isCompatiblyPlanar_theta` and
  `TauCeti.ClosedWeb.not_isCompatiblyPlanar_twistedTheta`.

## References

* F. Goertz, L. Marino, P. Wedrich, *Monoidal 2-categories from foam evaluation*,
  arXiv:2602.11120v1, Definition 3.4.
* S. K. Lando, A. K. Zvonkin, *Graphs on Surfaces and Their Applications*, Encyclopaedia of
  Mathematical Sciences 141, Springer 2004, §1.3 (rotation systems and their faces).
-/

public section

namespace TauCeti

universe u v

open Equiv Equiv.Perm

namespace ClosedWeb

variable (W : ClosedWeb.{u})

/-! ### The effective rotation system -/

/-- The **effective rotation** of the interval ends at each vertex: the stored cyclic order at a
split and its inverse at a merge. This is the rotation of the compatible surface, and its cycles
are the vertices. -/
def rotation : Perm W.End :=
  W.ends.symm.trans ((prodCongrRight fun v ↦
    if W.IsSplit v then finRotate 3 else (finRotate 3).symm).trans W.ends)

/-- The effective rotation moves each local slot forward at a split and backward at a merge. -/
theorem rotation_ends (v : W.Vertex) (i : Fin 3) :
    W.rotation (W.ends (v, i)) =
      W.ends (v, if W.IsSplit v then finRotate 3 i else (finRotate 3).symm i) := by
  simp only [rotation, Equiv.trans_apply, Equiv.symm_apply_apply, prodCongrRight_apply]
  split_ifs <;> rfl

@[simp] theorem rotation_ends_of_isSplit {v : W.Vertex} (hv : W.IsSplit v) (i : Fin 3) :
    W.rotation (W.ends (v, i)) = W.ends (v, finRotate 3 i) := by
  simp [rotation_ends, hv]

@[simp] theorem rotation_ends_of_isMerge {v : W.Vertex} (hv : W.IsMerge v) (i : Fin 3) :
    W.rotation (W.ends (v, i)) = W.ends (v, (finRotate 3).symm i) := by
  simp [rotation_ends, (W.not_isSplit_iff v).mpr hv]

/-- The effective rotation is cyclic successor at splits and cyclic predecessor at merges. -/
theorem rotation_apply (d : W.End) :
    W.rotation d =
      if W.IsSplit (W.incident d) then W.cyclicSucc d else W.cyclicSucc.symm d := by
  obtain ⟨⟨v, i⟩, rfl⟩ := W.ends.surjective d
  rw [rotation_ends, incident_ends]
  split_ifs <;> simp

/-- The effective rotation preserves incidence. -/
@[simp] theorem incident_rotation (d : W.End) : W.incident (W.rotation d) = W.incident d := by
  rw [rotation_apply]
  split_ifs <;> simp

/-- The inverse effective rotation is cyclic predecessor at splits and cyclic successor at
merges. -/
theorem rotation_symm_apply (d : W.End) :
    W.rotation.symm d =
      if W.IsSplit (W.incident d) then W.cyclicSucc.symm d else W.cyclicSucc d := by
  apply W.rotation.injective
  rw [Equiv.apply_symm_apply]
  by_cases h : W.IsSplit (W.incident d) <;> simp [rotation_apply, h]

/-- The inverse effective rotation preserves incidence. -/
@[simp] theorem incident_rotation_symm (d : W.End) :
    W.incident (W.rotation.symm d) = W.incident d := by
  conv_rhs => rw [← W.rotation.apply_symm_apply d]
  rw [incident_rotation]

/-- The **end swap** exchanges the source and target ends of each interval edge. Its cycles are
the interval edges. -/
def endSwap : Perm W.End :=
  prodCongrRight fun _ ↦ boolNot

@[simp] theorem endSwap_apply (d : W.End) : W.endSwap d = (d.1, !d.2) := (rfl)

/-- The end swap is an involution. -/
theorem endSwap_involutive : Function.Involutive W.endSwap := fun d ↦ by simp

@[simp] theorem endSwap_mul_endSwap : W.endSwap * W.endSwap = 1 :=
  Equiv.ext fun d ↦ W.endSwap_involutive d

@[simp] theorem endSwap_inv : W.endSwap⁻¹ = W.endSwap :=
  inv_eq_of_mul_eq_one_left W.endSwap_mul_endSwap

/-- The **face traversal** `ρ * τ`: cross to the other end of the interval edge, then turn to the
next end in the effective rotation. Its cycles are the faces of the compatible surface. -/
def facePerm : Perm W.End :=
  W.rotation * W.endSwap

theorem facePerm_def : W.facePerm = W.rotation * W.endSwap := (rfl)

theorem facePerm_apply (d : W.End) : W.facePerm d = W.rotation (W.endSwap d) := (rfl)

/-- The number of faces of the compatible surface, fixed points of the face traversal
included. -/
noncomputable def faceCount : ℕ :=
  orbitCount W.facePerm

theorem faceCount_def : W.faceCount = orbitCount W.facePerm := (rfl)

/-! ### The bipartite ribbon graph -/

/-- The three ends at a vertex are reached from any one of them by at most two effective
rotations. -/
private theorem ends_eq_or (v : W.Vertex) (i j : Fin 3) :
    W.ends (v, j) = W.ends (v, i) ∨ W.ends (v, j) = W.rotation (W.ends (v, i)) ∨
      W.ends (v, j) = W.rotation (W.rotation (W.ends (v, i))) := by
  rcases W.isMerge_or_isSplit v with hv | hv
  · simp only [W.rotation_ends_of_isMerge hv, W.ends.injective.eq_iff, Prod.mk.injEq, true_and]
    revert i j
    decide
  · simp only [W.rotation_ends_of_isSplit hv, W.ends.injective.eq_iff, Prod.mk.injEq, true_and]
    revert i j
    decide

/-- The effective rotation is a single cycle on the three ends at each vertex. -/
theorem isCycleOn_rotation (v : W.Vertex) : W.rotation.IsCycleOn (W.incident ⁻¹' {v}) := by
  refine ⟨⟨fun d hd ↦ by simpa using hd, W.rotation.injective.injOn,
    fun d hd ↦ ⟨W.rotation.symm d, by simpa using hd, by simp⟩⟩, ?_⟩
  intro a ha b hb
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at ha hb
  obtain ⟨i, rfl⟩ := (W.incident_eq_iff a v).mp ha
  obtain ⟨j, rfl⟩ := (W.incident_eq_iff b v).mp hb
  rcases W.ends_eq_or v i j with h | h | h
  · rw [h]
  · rw [h]
    exact ⟨1, by simp⟩
  · rw [h]
    exact ⟨2, by rw [zpow_two, Perm.mul_apply]⟩

/-- The end swap is a single cycle on the two ends of each interval edge. -/
theorem isCycleOn_endSwap (e : W.Edge) : W.endSwap.IsCycleOn (Prod.fst ⁻¹' {e}) := by
  refine ⟨⟨fun d hd ↦ by simpa using hd, W.endSwap.injective.injOn,
    fun d hd ↦ ⟨W.endSwap d, by simpa using hd, W.endSwap_involutive d⟩⟩, ?_⟩
  rintro ⟨a, b⟩ ha ⟨a', b'⟩ hb
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at ha hb
  subst ha hb
  by_cases h : b' = b
  · subst h
    exact SameCycle.refl _ _
  · exact ⟨1, by cases b <;> cases b' <;> simp_all⟩

/-- The effective rotation system as a bipartite ribbon graph: its edges are the interval ends,
its black vertices the vertices of the web with the effective rotation, and its white vertices
the interval edges with the end swap. -/
@[expose] noncomputable def toRibbonGraph : BipartiteRibbonGraph.{u} where
  E := W.End
  B := W.Vertex
  W := W.Edge
  fintypeE := Fintype.ofFinite _
  fintypeB := Fintype.ofFinite _
  fintypeW := Fintype.ofFinite _
  decidableEqE := Classical.decEq _
  decidableEqB := Classical.decEq _
  decidableEqW := Classical.decEq _
  blackEnd := W.incident
  whiteEnd := Prod.fst
  rotB := W.rotation
  rotW := W.endSwap
  blackEnd_surjective v := ⟨W.ends (v, 0), W.incident_ends v 0⟩
  whiteEnd_surjective e := ⟨(e, false), rfl⟩
  isCycleOn_rotB := W.isCycleOn_rotation
  isCycleOn_rotW := W.isCycleOn_endSwap

@[simp] theorem toRibbonGraph_blackEnd : W.toRibbonGraph.blackEnd = W.incident := (rfl)

@[simp] theorem toRibbonGraph_whiteEnd : W.toRibbonGraph.whiteEnd = Prod.fst := (rfl)

@[simp] theorem toRibbonGraph_rotB : W.toRibbonGraph.rotB = W.rotation := (rfl)

@[simp] theorem toRibbonGraph_rotW : W.toRibbonGraph.rotW = W.endSwap := (rfl)

/-- The connected components of the graph of interval edges: the connected components of the
ribbon graph, that is, the orbits of the group generated by the effective rotation and the end
swap. Vertex-free circles are not included. -/
abbrev Component : Type u :=
  W.toRibbonGraph.ConnectedComponent

/-- The Euler characteristic `V - E + F` of the compatible surface of the graph of interval
edges. -/
noncomputable def eulerChar : ℤ :=
  Nat.card W.Vertex - Nat.card W.Edge + W.faceCount

theorem eulerChar_def :
    W.eulerChar = Nat.card W.Vertex - Nat.card W.Edge + W.faceCount := (rfl)

/-- A closed web is **compatibly planar** when every connected component of its effective
rotation system is a sphere: `V - E + F` is twice the number of components. Since each component
contributes at most `2` (`TauCeti.ClosedWeb.eulerChar_le_two_mul_card_component`), this is the
componentwise condition `V_C - E_C + F_C = 2`
(`TauCeti.ClosedWeb.isCompatiblyPlanar_iff_forall_eulerChar_restrictToOrbit`). Vertex-free
circles are sphere components after subdivision by an auxiliary bivalent vertex, and do not
enter the condition. -/
def IsCompatiblyPlanar : Prop :=
  W.eulerChar = 2 * Fintype.card W.Component

theorem isCompatiblyPlanar_def :
    W.IsCompatiblyPlanar ↔ W.eulerChar = 2 * Fintype.card W.Component := Iff.rfl

/-- Compatible planarity is an integer equation, so it is decidable (classically, since the
counts are taken over `Finite` types). -/
noncomputable instance : DecidablePred IsCompatiblyPlanar.{u} :=
  fun W ↦ decidable_of_iff _ W.isCompatiblyPlanar_def.symm

/-! ### Components -/

/-- A function invariant under the effective rotation and the end swap is constant on
components. -/
theorem apply_eq_of_mem_rotationGroup {Y : Type*} {f : W.End → Y}
    (hρ : ∀ d, f (W.rotation d) = f d) (hτ : ∀ d, f (W.endSwap d) = f d) {g : Perm W.End}
    (hg : g ∈ W.toRibbonGraph.rotationGroup) (d : W.End) : f (g d) = f d :=
  apply_eq_of_mem_closure (S := {W.rotation, W.endSwap})
    (by rintro g (rfl | rfl) <;> assumption)
    (W.toRibbonGraph.closure_pair_eq_rotationGroup ▸ hg) d

@[simp] theorem mk_rotation (d : W.End) :
    (Quotient.mk'' (W.rotation d) : W.Component) = Quotient.mk'' d :=
  Quotient.sound ⟨⟨W.rotation, W.toRibbonGraph.rotB_mem_rotationGroup⟩, rfl⟩

theorem mk_endSwap (d : W.End) :
    (Quotient.mk'' (W.endSwap d) : W.Component) = Quotient.mk'' d :=
  Quotient.sound ⟨⟨W.endSwap, W.toRibbonGraph.rotW_mem_rotationGroup⟩, rfl⟩

/-- A function of the ends invariant under the effective rotation and the end swap descends to
the components. -/
private noncomputable def liftComponent {Y : Type*} (f : W.End → Y)
    (hρ : ∀ d, f (W.rotation d) = f d) (hτ : ∀ d, f (W.endSwap d) = f d) : W.Component → Y :=
  Quotient.lift f fun _ _ ⟨g, hg⟩ ↦ hg ▸ W.apply_eq_of_mem_rotationGroup hρ hτ g.property _

/-- A map of ends commuting with the effective rotations and the end swaps induces a map of
components. -/
private noncomputable def componentMap {X : ClosedWeb.{v}} (g : W.End → X.End)
    (hρ : ∀ d, g (W.rotation d) = X.rotation (g d)) (hτ : ∀ d, g (W.endSwap d) = X.endSwap (g d)) :
    W.Component → X.Component :=
  W.liftComponent (fun d ↦ (Quotient.mk'' (g d) : X.Component))
    (fun d ↦ by rw [hρ]; exact X.mk_rotation _) (fun d ↦ by rw [hτ]; exact X.mk_endSwap _)

/-! ### Counting vertices, edges and faces -/

/-- The vertices are the cycles of the effective rotation. -/
theorem orbitCount_rotation : orbitCount W.rotation = Nat.card W.Vertex :=
  W.toRibbonGraph.orbitCount_rotB.trans (Nat.card_eq_fintype_card (α := W.toRibbonGraph.B)).symm

/-- The interval edges are the cycles of the end swap. -/
theorem orbitCount_endSwap : orbitCount W.endSwap = Nat.card W.Edge :=
  W.toRibbonGraph.orbitCount_rotW.trans (Nat.card_eq_fintype_card (α := W.toRibbonGraph.W)).symm

private theorem card_end : Nat.card W.End = 2 * Nat.card W.Edge := by
  rw [Nat.card_prod, Nat.card_eq_fintype_card (α := Bool), Fintype.card_bool, mul_comm]

/-- The ribbon graph has the faces of the effective rotation system. -/
@[simp] theorem faceCount_toRibbonGraph : W.toRibbonGraph.faceCount = W.faceCount := by
  rw [BipartiteRibbonGraph.faceCount_def, ← Nat.card_eq_fintype_card, ← orbitCount_def,
    BipartiteRibbonGraph.facePerm_def, orbitCount_inv]
  -- The rotations of `W.toRibbonGraph` are `W.rotation` and `W.endSwap` on `W.End` by definition;
  -- rewriting with `toRibbonGraph_rotB` fails, since the carriers differ syntactically.
  change orbitCount (W.endSwap * W.rotation) = orbitCount (W.rotation * W.endSwap)
  exact orbitCount_mul_comm _ _

/-- The ribbon graph has the Euler characteristic of the effective rotation system: its `|B| +
|W| + F - |E|` is `V + E + F - 2E`. -/
@[simp] theorem eulerChar_toRibbonGraph : W.toRibbonGraph.eulerChar = W.eulerChar := by
  rw [BipartiteRibbonGraph.eulerChar_def, faceCount_toRibbonGraph, eulerChar_def]
  simp only [← Nat.card_eq_fintype_card]
  -- The vertex and edge types of `W.toRibbonGraph` are `W.Vertex`, `W.Edge` and `W.End`.
  change ((Nat.card W.Vertex : ℕ) : ℤ) + Nat.card W.Edge + W.faceCount - Nat.card W.End = _
  rw [card_end]
  push_cast
  ring

/-- Compatible planarity is planarity of every component of the ribbon graph. -/
theorem isCompatiblyPlanar_iff_toRibbonGraph :
    W.IsCompatiblyPlanar ↔
      W.toRibbonGraph.eulerChar = 2 * Fintype.card W.toRibbonGraph.ConnectedComponent := by
  rw [eulerChar_toRibbonGraph, isCompatiblyPlanar_def]

/-! ### The Euler bound and the componentwise test -/

/-- **The Euler bound.** Every component contributes at most `2` to `V - E + F`. -/
theorem eulerChar_le_two_mul_card_component : W.eulerChar ≤ 2 * Fintype.card W.Component := by
  rw [← eulerChar_toRibbonGraph]
  exact W.toRibbonGraph.eulerChar_le_two_mul_card_connectedComponent

/-- **The componentwise test.** For any numbering `ν` of the interval ends, a closed web is
compatibly planar exactly when the restriction of its permutation triple to each connected
component has Euler characteristic `V_C - E_C + F_C = 2`. -/
theorem isCompatiblyPlanar_iff_forall_eulerChar_restrictToOrbit {n : ℕ} (ν : W.End ≃ Fin n) :
    W.IsCompatiblyPlanar ↔ ∀ O : (W.toRibbonGraph.toPermutationTriple ν).MonodromyOrbit,
      ((W.toRibbonGraph.toPermutationTriple ν).restrictToOrbit O).eulerChar = 2 := by
  rw [← PermutationTriple.eulerChar_eq_two_mul_card_monodromyOrbit_iff,
    W.toRibbonGraph.eulerChar_toPermutationTriple ν, eulerChar_toRibbonGraph,
    W.toRibbonGraph.card_monodromyOrbits_toPermutationTriple ν, Nat.card_eq_fintype_card,
    isCompatiblyPlanar_def]

/-- A web without vertices is compatibly planar: it consists only of vertex-free circles. -/
theorem isCompatiblyPlanar_of_isEmpty_vertex [IsEmpty W.Vertex] : W.IsCompatiblyPlanar := by
  have : IsEmpty W.toRibbonGraph.E := inferInstanceAs (IsEmpty W.End)
  have : IsEmpty W.Component := Quotient.instIsEmpty
  rw [isCompatiblyPlanar_def, eulerChar_def, faceCount_def, orbitCount_def]
  simp

/-- Every web of vertex-free circles, the empty web included, is compatibly planar. -/
@[simp] theorem isCompatiblyPlanar_circles (C : Type u) [Finite C] :
    (circles C).IsCompatiblyPlanar :=
  isCompatiblyPlanar_of_isEmpty_vertex _

/-! ### Isomorphisms -/

namespace Iso

variable {W : ClosedWeb.{u}} {V : ClosedWeb.{v}}

/-- The transport of interval ends along a web isomorphism. -/
def endEquiv (f : W.Iso V) : W.End ≃ V.End :=
  prodCongr f.edge (Equiv.refl Bool)

@[simp] theorem endEquiv_apply (f : W.Iso V) (d : W.End) : f.endEquiv d = (f.edge d.1, d.2) :=
  (rfl)

/-- Web isomorphisms preserve the effective rotation. -/
@[simp] theorem map_rotation (f : W.Iso V) (e : W.Edge) (b : Bool) :
    V.rotation (f.edge e, b) = (f.edge (W.rotation (e, b)).1, (W.rotation (e, b)).2) := by
  simp only [rotation_apply, map_incident, isSplit_vertex]
  split_ifs <;> simp

/-- A web isomorphism is an isomorphism of the bipartite ribbon graphs of the effective rotation
systems. -/
noncomputable def toRibbonGraphIso (f : W.Iso V) : W.toRibbonGraph.Iso V.toRibbonGraph where
  edge := f.endEquiv
  black := f.vertex
  white := f.edge
  map_blackEnd d := f.map_incident d.1 d.2
  map_whiteEnd _ := rfl
  map_rotB d := (f.map_rotation d.1 d.2).symm
  map_rotW _ := rfl

@[simp] theorem toRibbonGraphIso_edge (f : W.Iso V) : f.toRibbonGraphIso.edge = f.endEquiv :=
  (rfl)

/-- Compatible planarity is invariant under web isomorphism. -/
theorem isCompatiblyPlanar_iff (f : W.Iso V) : W.IsCompatiblyPlanar ↔ V.IsCompatiblyPlanar := by
  rw [isCompatiblyPlanar_iff_toRibbonGraph, isCompatiblyPlanar_iff_toRibbonGraph,
    f.toRibbonGraphIso.eulerChar_eq,
    Fintype.card_congr f.toRibbonGraphIso.connectedComponentEquiv]

end Iso

/-! ### Mirror and orientation reversal -/

/-- Mirror reversal inverts the effective rotation. -/
@[simp] theorem rotation_mirror : W.mirror.rotation = W.rotation⁻¹ := by
  refine Equiv.ext fun d ↦ ?_
  simp only [rotation_apply, cyclicSucc_mirror, incident_mirror, isSplit_mirror, Perm.inv_def,
    rotation_symm_apply, Equiv.symm_symm]

@[simp] theorem endSwap_mirror : W.mirror.endSwap = W.endSwap := (rfl)

@[simp] theorem faceCount_mirror : W.mirror.faceCount = W.faceCount := by
  rw [faceCount_def, faceCount_def, facePerm_def, facePerm_def, rotation_mirror, endSwap_mirror,
    ← orbitCount_inv, mul_inv_rev, inv_inv, endSwap_inv, orbitCount_mul_comm]

/-- Mirror reversal preserves the group generated by the effective rotation and the end swap. -/
@[simp] theorem rotationGroup_toRibbonGraph_mirror :
    W.mirror.toRibbonGraph.rotationGroup = W.toRibbonGraph.rotationGroup := by
  rw [← BipartiteRibbonGraph.closure_pair_eq_rotationGroup,
    ← BipartiteRibbonGraph.closure_pair_eq_rotationGroup]
  -- The rotations of the two ribbon graphs are `W.mirror.rotation`, `W.rotation` and the common
  -- end swap, on the common carrier `W.End`.
  change Subgroup.closure {W.mirror.rotation, W.mirror.endSwap} =
    Subgroup.closure {W.rotation, W.endSwap}
  rw [rotation_mirror, endSwap_mirror]
  conv_rhs => rw [← Subgroup.closure_inv]
  rw [Set.inv_insert, Set.inv_singleton, endSwap_inv]

/-- Mirror reversal preserves the number of components. -/
@[simp] theorem card_component_mirror :
    Fintype.card W.mirror.Component = Fintype.card W.Component :=
  -- `W.mirror` has the ends of `W`, so only the acting group changes.
  Fintype.card_congr (MulAction.orbitRelQuotientCongr
    (MulEquiv.subgroupCongr W.rotationGroup_toRibbonGraph_mirror) (Equiv.refl _) fun _ _ ↦ rfl)

/-- Mirror reversal preserves compatible planarity. -/
@[simp] theorem isCompatiblyPlanar_mirror :
    W.mirror.IsCompatiblyPlanar ↔ W.IsCompatiblyPlanar := by
  rw [isCompatiblyPlanar_def, isCompatiblyPlanar_def, eulerChar_def, eulerChar_def,
    faceCount_mirror, card_component_mirror]

/-- Orientation reversal conjugates the inverse effective rotation by the end swap: it inverts
every rotation, after renaming each end by the opposite end of its edge. -/
@[simp] theorem rotation_reverse :
    W.reverse.rotation = W.endSwap * W.rotation⁻¹ * W.endSwap := by
  refine Equiv.ext fun d ↦ ?_
  simp only [Perm.mul_apply, Perm.inv_def, rotation_symm_apply, rotation_apply, incident_reverse,
    isSplit_reverse, cyclicSucc_reverse_apply, cyclicSucc_symm_reverse_apply, endSwap_apply]
  rcases W.isMerge_or_isSplit (W.incident (d.1, !d.2)) with h | h
  · simp [h, (W.not_isSplit_iff _).mpr h]
  · simp [h, (W.not_isMerge_iff _).mpr h]

@[simp] theorem endSwap_reverse : W.reverse.endSwap = W.endSwap := (rfl)

@[simp] theorem faceCount_reverse : W.reverse.faceCount = W.faceCount := by
  rw [faceCount_def, faceCount_def, facePerm_def, facePerm_def, rotation_reverse, endSwap_reverse,
    mul_assoc, W.endSwap_mul_endSwap, mul_one, ← orbitCount_inv, mul_inv_rev, inv_inv,
    endSwap_inv]

/-- Renaming each end by the opposite end of its edge identifies the rotation system of the
reversed web with that of the mirrored web. -/
noncomputable def reverseRibbonGraphIsoMirror :
    W.reverse.toRibbonGraph.Iso W.mirror.toRibbonGraph where
  edge := W.endSwap
  black := Equiv.refl _
  white := Equiv.refl _
  map_blackEnd d := (W.incident_mirror _).trans (W.incident_reverse d).symm
  map_whiteEnd _ := rfl
  map_rotB d := by
    rw [toRibbonGraph_rotB, toRibbonGraph_rotB, rotation_reverse, rotation_mirror]
    -- Both ribbon graphs have the edges `W.End`; `rw [Perm.mul_apply]` fails since the carriers
    -- differ syntactically, so the product `W.endSwap * W.rotation⁻¹ * W.endSwap` is applied by
    -- `Perm.mul_apply`, which holds by definition.
    change W.endSwap (W.endSwap (W.rotation⁻¹ (W.endSwap d))) = W.rotation⁻¹ (W.endSwap d)
    exact W.endSwap_involutive _
  map_rotW _ := rfl

@[simp] theorem reverseRibbonGraphIsoMirror_edge :
    W.reverseRibbonGraphIsoMirror.edge = W.endSwap := (rfl)

/-- Orientation reversal preserves the number of components. -/
@[simp] theorem card_component_reverse :
    Fintype.card W.reverse.Component = Fintype.card W.Component :=
  (Fintype.card_congr W.reverseRibbonGraphIsoMirror.connectedComponentEquiv).trans
    W.card_component_mirror

/-- Orientation reversal preserves compatible planarity. -/
@[simp] theorem isCompatiblyPlanar_reverse :
    W.reverse.IsCompatiblyPlanar ↔ W.IsCompatiblyPlanar := by
  rw [isCompatiblyPlanar_def, isCompatiblyPlanar_def, eulerChar_def, eulerChar_def,
    faceCount_reverse, card_component_reverse]

/-! ### Disjoint union -/

section Sum

variable (V : ClosedWeb.{v})

@[simp] theorem rotation_sum_apply_inl (e : W.Edge) (b : Bool) :
    (W.sum V).rotation ((Sum.inl e, b) : (W.Edge ⊕ V.Edge) × Bool) =
      (Sum.inl (W.rotation (e, b)).1, (W.rotation (e, b)).2) := by
  simp only [rotation_apply, incident_sum_inl, isSplit_sum_inl]
  split_ifs <;> simp

@[simp] theorem rotation_sum_apply_inr (e : V.Edge) (b : Bool) :
    (W.sum V).rotation ((Sum.inr e, b) : (W.Edge ⊕ V.Edge) × Bool) =
      (Sum.inr (V.rotation (e, b)).1, (V.rotation (e, b)).2) := by
  simp only [rotation_apply, incident_sum_inr, isSplit_sum_inr]
  split_ifs <;> simp

/-- The face traversal of a disjoint union acts separately on the two summands. -/
theorem permCongr_facePerm_sum :
    (sumProdDistrib W.Edge V.Edge Bool).permCongr (W.sum V).facePerm =
      Perm.sumCongr W.facePerm V.facePerm := by
  refine Equiv.ext ?_
  -- `facePerm_apply` is instantiated at `W.sum V`, whose ends `(W.sum V).End` are not reducibly
  -- the pairs `(W.Edge ⊕ V.Edge) × Bool` that `sumProdDistrib` produces.
  rintro (⟨e, b⟩ | ⟨e, b⟩) <;> simp [facePerm_apply (W.sum V), facePerm_apply]

@[simp] theorem faceCount_sum : (W.sum V).faceCount = W.faceCount + V.faceCount := by
  rw [faceCount_def, ← orbitCount_permCongr (sumProdDistrib W.Edge V.Edge Bool),
    permCongr_facePerm_sum, Perm.orbitCount_sumCongr, faceCount_def, faceCount_def]

@[simp] theorem eulerChar_sum : (W.sum V).eulerChar = W.eulerChar + V.eulerChar := by
  rw [eulerChar_def, eulerChar_def, eulerChar_def, faceCount_sum]
  simp only [Nat.card_sum]
  push_cast
  ring

/-- The component of a dart of a disjoint union, in the summand containing it. -/
private noncomputable def splitComponent (d : (W.sum V).End) : W.Component ⊕ V.Component :=
  Sum.map Quotient.mk'' Quotient.mk'' (sumProdDistrib W.Edge V.Edge Bool d)

private theorem splitComponent_rotation (d : (W.sum V).End) :
    splitComponent W V ((W.sum V).rotation d) = splitComponent W V d := by
  rcases d with ⟨e | e, b⟩
  · simp only [splitComponent, rotation_sum_apply_inl, sumProdDistrib_apply_left]
    exact congrArg Sum.inl (W.mk_rotation (e, b))
  · simp only [splitComponent, rotation_sum_apply_inr, sumProdDistrib_apply_right]
    exact congrArg Sum.inr (V.mk_rotation (e, b))

private theorem splitComponent_endSwap (d : (W.sum V).End) :
    splitComponent W V ((W.sum V).endSwap d) = splitComponent W V d := by
  rcases d with ⟨e | e, b⟩
  · simp only [splitComponent, endSwap_apply, sumProdDistrib_apply_left]
    exact congrArg Sum.inl (W.mk_endSwap (e, b))
  · simp only [splitComponent, endSwap_apply, sumProdDistrib_apply_right]
    exact congrArg Sum.inr (V.mk_endSwap (e, b))

/-- The components of a disjoint union are those of its two summands. -/
noncomputable def sumComponentEquiv : (W.sum V).Component ≃ W.Component ⊕ V.Component where
  toFun := (W.sum V).liftComponent (splitComponent W V) (splitComponent_rotation W V)
    (splitComponent_endSwap W V)
  invFun := Sum.elim
    (W.componentMap (fun d ↦ (Sum.inl d.1, d.2)) (fun d ↦ (rotation_sum_apply_inl W V d.1 d.2).symm)
      fun _ ↦ rfl)
    (V.componentMap (fun d ↦ (Sum.inr d.1, d.2)) (fun d ↦ (rotation_sum_apply_inr W V d.1 d.2).symm)
      fun _ ↦ rfl)
  left_inv q := by
    induction q using Quotient.inductionOn with
    | h d => rcases d with ⟨e | e, b⟩ <;> rfl
  right_inv := by
    rintro (q | q) <;> induction q using Quotient.inductionOn <;> rfl

@[simp] theorem sumComponentEquiv_mk_inl (d : W.End) :
    sumComponentEquiv W V (Quotient.mk'' (Sum.inl d.1, d.2)) = Sum.inl (Quotient.mk'' d) :=
  (rfl)

@[simp] theorem sumComponentEquiv_mk_inr (d : V.End) :
    sumComponentEquiv W V (Quotient.mk'' (Sum.inr d.1, d.2)) = Sum.inr (Quotient.mk'' d) :=
  (rfl)

@[simp] theorem sumComponentEquiv_symm_inl_mk (d : W.End) :
    (sumComponentEquiv W V).symm (Sum.inl (Quotient.mk'' d)) = Quotient.mk'' (Sum.inl d.1, d.2) :=
  (rfl)

@[simp] theorem sumComponentEquiv_symm_inr_mk (d : V.End) :
    (sumComponentEquiv W V).symm (Sum.inr (Quotient.mk'' d)) = Quotient.mk'' (Sum.inr d.1, d.2) :=
  (rfl)

/-- The number of components is additive under disjoint union. -/
@[simp] theorem card_component_sum :
    Fintype.card (W.sum V).Component = Fintype.card W.Component + Fintype.card V.Component := by
  rw [Fintype.card_congr (sumComponentEquiv W V), Fintype.card_sum]

/-- A disjoint union is compatibly planar exactly when both summands are. Since each summand
satisfies the Euler bound, a deficit of faces in one summand cannot be offset by the other. -/
@[simp] theorem isCompatiblyPlanar_sum :
    (W.sum V).IsCompatiblyPlanar ↔ W.IsCompatiblyPlanar ∧ V.IsCompatiblyPlanar := by
  rw [isCompatiblyPlanar_def, isCompatiblyPlanar_def, isCompatiblyPlanar_def, eulerChar_sum,
    card_component_sum]
  have hW := W.eulerChar_le_two_mul_card_component
  have hV := V.eulerChar_le_two_mul_card_component
  push_cast
  omega

end Sum

/-! ### The theta web -/

/-- A web is connected when every end is reached from a fixed end by a power of the effective
rotation, possibly followed by the end swap. -/
private theorem card_component_eq_one {X : ClosedWeb.{u}} (x₀ : X.End)
    (h : ∀ y, ∃ k : ℕ, ∃ b : Bool, (if b then X.endSwap else 1) ((X.rotation ^ k) x₀) = y) :
    Fintype.card X.Component = 1 := by
  rw [← Nat.card_eq_fintype_card, Nat.card_eq_one_iff_unique]
  refine ⟨⟨fun p q ↦ ?_⟩, ⟨Quotient.mk'' x₀⟩⟩
  have hx : ∀ y : X.End, (Quotient.mk'' y : X.Component) = Quotient.mk'' x₀ := fun y ↦ by
    obtain ⟨k, b, rfl⟩ := h y
    have hg : (if b then X.endSwap else 1) * X.rotation ^ k ∈ X.toRibbonGraph.rotationGroup := by
      refine mul_mem ?_ (pow_mem X.toRibbonGraph.rotB_mem_rotationGroup _)
      split_ifs
      · exact X.toRibbonGraph.rotW_mem_rotationGroup
      · exact one_mem _
    exact Quotient.sound ⟨⟨_, hg⟩, rfl⟩
  induction p using Quotient.inductionOn
  induction q using Quotient.inductionOn
  exact (hx _).trans (hx _).symm

/-- The oriented theta web has three faces. -/
@[simp] theorem faceCount_theta : theta.faceCount = 3 := by
  have hsq : theta.facePerm ^ 2 = 1 := by
    refine Equiv.ext fun ⟨e, b⟩ ↦ ?_
    fin_cases e <;> cases b <;> simp +decide [sq, facePerm_apply, rotation_apply]
  have hfix : ∀ d, theta.facePerm d ≠ d := by
    rintro ⟨e, b⟩
    fin_cases e <;> cases b <;> simp +decide [facePerm_apply, rotation_apply]
  have h := Perm.mul_orbitCount_of_pow_prime_eq_one (p := 2) hsq
  rw [Finset.filter_false_of_mem fun d _ ↦ hfix d, Finset.card_empty] at h
  simp only [Fintype.card_prod, Fintype.card_fin, Fintype.card_bool] at h
  rw [faceCount_def]
  omega

/-- The oriented theta web is connected. -/
@[simp] theorem card_component_theta : Fintype.card theta.Component = 1 := by
  refine card_component_eq_one ((0 : Fin 3), false) fun ⟨e, b⟩ ↦ ?_
  fin_cases e <;> cases b <;>
    first
    | (refine ⟨0, false, ?_⟩; simp; done)
    | (refine ⟨1, false, ?_⟩; simp +decide [rotation_apply]; done)
    | (refine ⟨2, false, ?_⟩; simp +decide [sq, rotation_apply]; done)
    | (refine ⟨0, true, ?_⟩; simp; done)
    | (refine ⟨1, true, ?_⟩; simp +decide [rotation_apply]; done)
    | (refine ⟨2, true, ?_⟩; simp +decide [sq, rotation_apply])

/-- **The theta web is compatibly planar**: it has `V - E + F = 2 - 3 + 3 = 2`. -/
theorem isCompatiblyPlanar_theta : theta.IsCompatiblyPlanar := by
  rw [isCompatiblyPlanar_def, eulerChar_def, faceCount_theta, card_component_theta]
  simp

/-- The theta web with the cyclic order at its split vertex reversed. Its underlying graph is the
planar theta graph, but its effective rotation is the cyclic predecessor `theta.cyclicSucc.symm`
of the theta web's stored order at both vertices
(`TauCeti.ClosedWeb.rotation_twistedTheta_apply`), whereas the effective rotation of the theta
web turns forward at its split vertex and backward at its merge vertex. -/
abbrev twistedTheta : ClosedWeb where
  Vertex := Bool
  Edge := Fin 3
  Circle := PEmpty
  ends := (prodCongrRight fun v : Bool ↦ if v then swap (1 : Fin 3) 2 else Equiv.refl _).trans
    theta.ends
  orientation_one v := by cases v <;> rfl
  orientation_two v := by cases v <;> rfl

/-- The effective rotation of the twisted theta web is the cyclic predecessor of the theta
web at both vertices. -/
theorem rotation_twistedTheta_apply (d : twistedTheta.End) :
    twistedTheta.rotation d = theta.cyclicSucc.symm d := by
  obtain ⟨⟨v, i⟩, rfl⟩ := twistedTheta.ends.surjective d
  have hsplit : twistedTheta.IsSplit v ↔ v = true := by
    rw [isSplit_def]
    cases v <;> simp +decide
  rw [rotation_ends]
  simp only [hsplit, Equiv.trans_apply, prodCongrRight_apply]
  cases v <;> fin_cases i <;> simp +decide [Equiv.swap_apply_def]

/-- The twisted theta web has a single face. -/
@[simp] theorem faceCount_twistedTheta : twistedTheta.faceCount = 1 := by
  have h : ∀ y, ∃ k : ℕ, (twistedTheta.facePerm ^ k) ((0 : Fin 3), false) = y := by
    rintro ⟨e, b⟩
    fin_cases e <;> cases b <;>
      first
      | (refine ⟨0, ?_⟩; simp; done)
      | (refine ⟨1, ?_⟩; simp +decide [facePerm_apply, rotation_twistedTheta_apply]; done)
      | (refine ⟨2, ?_⟩; simp +decide [pow_succ, facePerm_apply, rotation_twistedTheta_apply]; done)
      | (refine ⟨3, ?_⟩; simp +decide [pow_succ, facePerm_apply, rotation_twistedTheta_apply]; done)
      | (refine ⟨4, ?_⟩; simp +decide [pow_succ, facePerm_apply, rotation_twistedTheta_apply]; done)
      | (refine ⟨5, ?_⟩; simp +decide [pow_succ, facePerm_apply, rotation_twistedTheta_apply])
  have hx : ∀ y, twistedTheta.facePerm.SameCycle ((0 : Fin 3), false) y := fun y ↦ by
    obtain ⟨k, hk⟩ := h y
    exact ⟨k, by rw [zpow_natCast, hk]⟩
  exact orbitCount_eq_one_of_forall_sameCycle fun x y ↦ (hx x).symm.trans (hx y)

/-- **The twisted theta web is not compatibly planar**: it has `V - E + F = 2 - 3 + 1 = 0`,
although its underlying graph is planar. The test reads the prescribed rotation system. -/
theorem not_isCompatiblyPlanar_twistedTheta : ¬twistedTheta.IsCompatiblyPlanar := by
  have hc : 0 < Fintype.card twistedTheta.Component :=
    Fintype.card_pos_iff.mpr ⟨Quotient.mk'' ((0 : Fin 3), false)⟩
  rw [isCompatiblyPlanar_def, eulerChar_def, faceCount_twistedTheta]
  simp only [Nat.card_eq_fintype_card, Fintype.card_bool, Fintype.card_fin]
  omega

end ClosedWeb

end TauCeti
