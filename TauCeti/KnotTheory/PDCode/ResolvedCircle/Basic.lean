module

public import TauCeti.KnotTheory.PDCode.Kauffman

/-!
# The circles of a smoothed PD-code

Smoothing every crossing of a PD-code according to a state `s` leaves a disjoint union of circles,
which `TauCeti.PDCode.stateLoopCount` counts. This file constructs those circles as a finite type,
the set of circles a Khovanov chain group is built on.

A circle meeting a crossing is a connected component of the graph on the half-edges whose edges
are the arcs of the code (`TauCeti.PDCode.edgePair`) and the arcs of the chosen local smoothings
(`TauCeti.PDCode.smoothingTurn`). So `TauCeti.PDCode.CrossingCircle D s` is the quotient of the
half-edges by the equivalence relation generated by these two perfect matchings. The crossing-free
circles of the code, recorded only by their number, are adjoined as
`Fin D.crossinglessComponentCount` to give `TauCeti.PDCode.ResolvedCircle D s`.

The traversal `TauCeti.PDCode.statePerm`, crossing an arc and then following a smoothing, is the
product of the two matchings. Its orbits are the circles with a direction of travel, and following
the other end of an arc reverses that direction (`TauCeti.PDCode.stateCycleReversal`). By the
general theory of two perfect matchings in `TauCeti/Combinatorics/Enumerative/PerfectMatching.lean`,
the circles are the directed traversal orbits modulo reversal, and no directed orbit is its own
reverse, even on a circle made of a single arc and a single smoothing arc. Hence every circle
carries exactly two directed orbits, which is the halving in `TauCeti.PDCode.stateLoopCount`.

## Main definitions

* `TauCeti.PDCode.CircleStep`: the relation joining a half-edge to its partners along an arc and
  along the chosen smoothing.
* `TauCeti.PDCode.CrossingCircle`: the circles of a smoothed code that meet a crossing.
* `TauCeti.PDCode.ResolvedCircle`: all circles of a smoothed code.
* `TauCeti.PDCode.stateCycleReversal`: reversing the direction of travel on the directed
  traversal orbits of a smoothed code.
* `TauCeti.PDCode.crossingCircleEquiv`: the circles meeting a crossing are the directed traversal
  orbits modulo reversal.

## Main results

* `TauCeti.PDCode.CrossingCircle.mk_eq_mk_iff`: two half-edges lie on one circle exactly when the
  second lies on the directed traversal orbit of the first or of its partner along the arc.
* `TauCeti.PDCode.isPerfectMatching_stateCycleReversal`: no directed traversal orbit is its own
  reverse.
* `TauCeti.PDCode.two_mul_card_crossingCircle`: the circles meeting a crossing are half as many as
  the directed traversal orbits.
* `TauCeti.PDCode.card_resolvedCircle`: there are `TauCeti.PDCode.stateLoopCount D s` circles.

## References

* M. Khovanov, *A categorification of the Jones polynomial*, Duke Math. J. 101 (2000), 359-426,
  §2 (the circles of a resolution).
* D. Bar-Natan, *On Khovanov's categorification of the Jones polynomial*, Algebr. Geom. Topol. 2
  (2002), 337-370, §2.
-/

public section

namespace TauCeti

open Equiv Equiv.Perm

namespace PDCode

variable {n : ℕ}

/-- The relation joining a half-edge `x` to the other end `y` of its arc, and to the half-edge `y`
that the local smoothing chosen by the state `s` joins it to. The equivalence relation it
generates has the circles of the smoothed diagram that meet a crossing as its classes
(`TauCeti.PDCode.CrossingCircle`).

This is an `abbrev`, so that the general results about the equivalence relation generated by two
involutions, stated for the relation `fun a b ↦ b = g a ∨ b = f a`, apply to it directly. -/
abbrev CircleStep (D : PDCode n) (s : Fin n → Bool) (x y : Fin (4 * n)) : Prop :=
  y = D.edgePair.val x ∨ y = D.smoothingTurn (D.smoothingChoice s) x

/-- The defining property of the circle relation. -/
theorem circleStep_iff (D : PDCode n) (s : Fin n → Bool) {x y : Fin (4 * n)} :
    D.CircleStep s x y ↔ y = D.edgePair.val x ∨ y = D.smoothingTurn (D.smoothingChoice s) x :=
  Iff.rfl

/-- The circle relation is symmetric, since it is built from two involutions. -/
theorem circleStep_comm (D : PDCode n) (s : Fin n → Bool) {x y : Fin (4 * n)} :
    D.CircleStep s x y ↔ D.CircleStep s y x := by
  constructor <;> rintro (rfl | rfl)
  exacts [.inl (D.edgePair.apply_apply _).symm, .inr (D.smoothingTurn_apply_apply _ _).symm,
    .inl (D.edgePair.apply_apply _).symm, .inr (D.smoothingTurn_apply_apply _ _).symm]

/-- The circles meeting a crossing of the diagram smoothed according to the state `s`: the classes
of half-edges under the equivalence relation generated by `TauCeti.PDCode.CircleStep`. -/
abbrev CrossingCircle (D : PDCode n) (s : Fin n → Bool) : Type :=
  Quotient (Relation.EqvGen.setoid (D.CircleStep s))

/-- All circles of the diagram smoothed according to the state `s`: the circles meeting a crossing,
together with one label for each crossing-free circle of the code. -/
abbrev ResolvedCircle (D : PDCode n) (s : Fin n → Bool) : Type :=
  D.CrossingCircle s ⊕ Fin D.crossinglessComponentCount

/-- Two half-edges lie on one circle of a smoothed diagram exactly when the second lies on the
directed traversal orbit of the first, or on that of the other end of the first's arc. -/
theorem eqvGen_circleStep_iff (D : PDCode n) (s : Fin n → Bool) {x y : Fin (4 * n)} :
    Relation.EqvGen (D.CircleStep s) x y ↔
      (D.statePerm s).SameCycle x y ∨ (D.statePerm s).SameCycle (D.edgePair.val x) y := by
  rw [statePerm_def]
  exact (D.isPerfectMatching_smoothingTurn _).involutive.eqvGen_iff_sameCycle
    D.edgePair.prop.involutive

/-- Lying on one circle of a smoothed diagram is decidable, by iterating the traversal. -/
instance (D : PDCode n) (s : Fin n → Bool) : DecidableRel (Relation.EqvGen (D.CircleStep s)) :=
  fun _ _ ↦ decidable_of_iff _ (D.eqvGen_circleStep_iff s).symm

/-- Equality of circles of a smoothed diagram is decidable. -/
instance (D : PDCode n) (s : Fin n → Bool) : DecidableEq (D.CrossingCircle s) :=
  @Quotient.decidableEq _ _ (inferInstanceAs (DecidableRel (Relation.EqvGen (D.CircleStep s))))

/-- The circles meeting a crossing of a smoothed diagram form a finite type, computably. -/
instance (D : PDCode n) (s : Fin n → Bool) : Fintype (D.CrossingCircle s) :=
  @Quotient.fintype _ _ _ (inferInstanceAs (DecidableRel (Relation.EqvGen (D.CircleStep s))))

namespace CrossingCircle

variable {D : PDCode n} {s : Fin n → Bool}

/-- Two half-edges lie on one circle exactly when the second lies on the directed traversal orbit
of the first, or on that of the other end of the first's arc. -/
theorem mk_eq_mk_iff {x y : Fin (4 * n)} :
    (⟦x⟧ : D.CrossingCircle s) = ⟦y⟧ ↔
      (D.statePerm s).SameCycle x y ∨ (D.statePerm s).SameCycle (D.edgePair.val x) y :=
  Quotient.eq.trans (D.eqvGen_circleStep_iff s)

/-- The two ends of an arc lie on the same circle. -/
@[simp]
theorem mk_edgePair (x : Fin (4 * n)) :
    (⟦D.edgePair.val x⟧ : D.CrossingCircle s) = ⟦x⟧ :=
  Quotient.sound (.symm _ _ (.rel _ _ (Or.inl rfl)))

/-- The two ends of an arc of the chosen smoothing lie on the same circle. -/
@[simp]
theorem mk_smoothingTurn (x : Fin (4 * n)) :
    (⟦D.smoothingTurn (D.smoothingChoice s) x⟧ : D.CrossingCircle s) = ⟦x⟧ :=
  Quotient.sound (.symm _ _ (.rel _ _ (Or.inr rfl)))

/-- Traversal stays on a circle. -/
theorem mk_statePerm (x : Fin (4 * n)) :
    (⟦D.statePerm s x⟧ : D.CrossingCircle s) = ⟦x⟧ := by
  simp

-- Not `@[simp]`: `TauCeti.PDCode.crossing_apply` rewrites the left-hand side.
/-- The two half-edges at a crossing `c` joined by the local smoothing there lie on the same
circle. -/
theorem mk_crossing_slotSmoothing (c : Fin n) (k : Fin 4) :
    (⟦D.crossing c (slotSmoothing (D.smoothingChoice s c) k)⟧ : D.CrossingCircle s) =
      ⟦D.crossing c k⟧ := by
  simpa using mk_smoothingTurn (D := D) (s := s) (D.crossing c k)

end CrossingCircle

/-- The directed traversal orbits of a smoothed diagram, with the traversal written as the product
of the two matchings it is built from. The definition of `TauCeti.PDCode.statePerm` is not exposed
outside its module, so the two quotients are not definitionally equal here; this equivalence
identifies them through `TauCeti.PDCode.statePerm_def`. -/
private def stateOrbitEquiv (D : PDCode n) (s : Fin n → Bool) :
    Quotient (SameCycle.setoid (D.smoothingTurn (D.smoothingChoice s) * D.edgePair.val)) ≃
      Quotient (SameCycle.setoid (D.statePerm s)) :=
  Quotient.congr (Equiv.refl _) fun _ _ ↦ by rw [statePerm_def]; rfl

private theorem stateOrbitEquiv_mk (D : PDCode n) (s : Fin n → Bool) (x : Fin (4 * n)) :
    D.stateOrbitEquiv s ⟦x⟧ = ⟦x⟧ :=
  rfl

private theorem stateOrbitEquiv_symm_mk (D : PDCode n) (s : Fin n → Bool) (x : Fin (4 * n)) :
    (D.stateOrbitEquiv s).symm ⟦x⟧ = ⟦x⟧ :=
  (Equiv.symm_apply_eq _).mpr rfl

/-- **Reversal of the directed traversal orbits** of the diagram smoothed according to the state
`s`: following the other end of an arc carries each directed orbit of
`TauCeti.PDCode.statePerm` onto the same circle traversed in the opposite direction. -/
def stateCycleReversal (D : PDCode n) (s : Fin n → Bool) :
    Equiv.Perm (Quotient (SameCycle.setoid (D.statePerm s))) :=
  (D.stateOrbitEquiv s).permCongr
    ((D.isPerfectMatching_smoothingTurn _).involutive.cycleReversal D.edgePair.apply_apply)

/-- Reversal sends the directed orbit of a half-edge to that of the other end of its arc. -/
@[simp]
theorem stateCycleReversal_mk (D : PDCode n) (s : Fin n → Bool) (x : Fin (4 * n)) :
    D.stateCycleReversal s ⟦x⟧ = ⟦D.edgePair.val x⟧ :=
  -- A term proof: `rw` rejects these goals as not type-correct at its transparency, since the
  -- coercion `D.edgePair.val` only typechecks after unfolding `TauCeti.PerfectMatching`.
  (Equiv.permCongr_apply _ _ _).trans <|
    (congrArg _ ((congrArg _ (D.stateOrbitEquiv_symm_mk s x)).trans
      (Function.Involutive.cycleReversal_mk _ _ x))).trans (D.stateOrbitEquiv_mk s _)

/-- **No directed traversal orbit of a smoothed diagram is its own reverse**, and reversing twice
gives back every orbit: reversal is a perfect matching of the directed orbits. -/
theorem isPerfectMatching_stateCycleReversal (D : PDCode n) (s : Fin n → Bool) :
    IsPerfectMatching (D.stateCycleReversal s) :=
  PerfectMatching.isPerfectMatching_permCongr _
    ((D.isPerfectMatching_smoothingTurn _).isPerfectMatching_cycleReversal D.edgePair.prop)

/-- **The circles meeting a crossing are the directed traversal orbits modulo reversal**: the circle
through a half-edge corresponds to the reversal orbit of its directed traversal orbit. -/
noncomputable def crossingCircleEquiv (D : PDCode n) (s : Fin n → Bool) :
    D.CrossingCircle s ≃ Quotient (SameCycle.setoid (D.stateCycleReversal s)) :=
  ((D.isPerfectMatching_smoothingTurn _).involutive.eqvGenQuotientEquiv
    D.edgePair.apply_apply).trans
    (Quotient.congr (D.stateOrbitEquiv s) fun _ _ ↦ (sameCycle_permCongr _ _).symm)

/-- The circle through a half-edge corresponds to the reversal orbit of its directed traversal
orbit. -/
@[simp]
theorem crossingCircleEquiv_mk (D : PDCode n) (s : Fin n → Bool) (x : Fin (4 * n)) :
    D.crossingCircleEquiv s ⟦x⟧ = ⟦⟦x⟧⟧ :=
  -- A term proof, for the reason given in `TauCeti.PDCode.stateCycleReversal_mk`.
  (Equiv.trans_apply _ _ _).trans <|
    (congrArg _ (Function.Involutive.eqvGenQuotientEquiv_mk _ _ x)).trans <|
      (Quotient.congr_mk _ _ _).trans (congrArg _ (D.stateOrbitEquiv_mk s x))

/-- **Each circle meeting a crossing carries exactly two directed traversal orbits**, so there are
half as many such circles as directed orbits. -/
theorem two_mul_card_crossingCircle (D : PDCode n) (s : Fin n → Bool) :
    2 * Fintype.card (D.CrossingCircle s) = orbitCount (D.statePerm s) := by
  rw [statePerm_def, Fintype.card_eq_nat_card]
  exact (D.isPerfectMatching_smoothingTurn _).two_mul_card_quotient_eqvGen D.edgePair.prop

/-- **The number of circles of a smoothed diagram.** The diagram smoothed according to the state
`s` has `TauCeti.PDCode.stateLoopCount D s` circles, the crossing-free circles included. -/
theorem card_resolvedCircle (D : PDCode n) (s : Fin n → Bool) :
    Fintype.card (D.ResolvedCircle s) = D.stateLoopCount s := by
  have h := D.two_mul_card_crossingCircle s
  rw [Fintype.card_sum, Fintype.card_fin, stateLoopCount_def]
  omega

/-- Every smoothing of a diagram with a component has a circle. -/
theorem one_le_card_resolvedCircle_of_componentCount_pos (D : PDCode n)
    (h : 0 < D.componentCount) (s : Fin n → Bool) : 1 ≤ Fintype.card (D.ResolvedCircle s) :=
  D.card_resolvedCircle s ▸ D.one_le_stateLoopCount_of_componentCount_pos h s

/-- Every smoothing of a diagram with a crossing has a circle. -/
theorem one_le_card_resolvedCircle (D : PDCode n) (hn : n ≠ 0) (s : Fin n → Bool) :
    1 ≤ Fintype.card (D.ResolvedCircle s) :=
  D.one_le_card_resolvedCircle_of_componentCount_pos (D.componentCount_pos hn) s

end PDCode

end TauCeti
