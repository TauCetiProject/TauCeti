module

public import TauCeti.KnotTheory.PDCode.Alexander.Reduced
public import TauCeti.KnotTheory.SeifertMatrix.FittingIdeal

/-!
# Comparing diagram and Seifert Alexander ideals

A surjection onto a diagram's reduced Alexander module whose kernel is the image of a
Seifert Alexander matrix identifies its first elementary ideal with the principal ideal
generated by the normalized Seifert Alexander polynomial.

This isolates the algebraic conclusion of the algorithm comparison. Constructing the
presentation from a Seifert surface remains a geometric prerequisite; no relation
between an arbitrary diagram and an arbitrary matrix is asserted here.
-/

public section

noncomputable section

open LaurentPolynomial

namespace TauCeti.OrientedPDCode

variable {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- A Seifert presentation of the reduced Alexander module makes the diagram's first
elementary ideal principal, generated by the normalized Seifert Alexander polynomial. -/
theorem elementaryIdeal_one_eq_span_alexander_of_ker_eq_range (D : OrientedPDCode n)
    (V : Matrix ι ι ℤ)
    {π : (ι → ℤ[T;T⁻¹]) →ₗ[ℤ[T;T⁻¹]] D.ReducedAlexanderModule}
    (hπ : Function.Surjective π)
    (h : LinearMap.ker π = LinearMap.range (KnotTheory.alexanderMatrix V).mulVecLin) :
    D.elementaryIdeal 1 = Ideal.span {KnotTheory.alexander V} := by
  rw [D.elementaryIdeal_succ_eq_fittingIdeal_reduced 0]
  exact V.fittingIdeal_zero_eq_span_alexander_of_ker_eq_range hπ h

end TauCeti.OrientedPDCode
