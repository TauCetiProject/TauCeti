/-!
# Partially blocked grid homology and the dimension of fully blocked grid homology

For a set `S` of columns of a grid diagram `G`, setting the variables `V_s`, `s ∈ S`, of the
unblocked grid complex `GC⁻` to zero gives the *partially blocked* grid complex: the quotient of
`GC⁻` by the chains `blockedChains S` whose coefficients lie in the ideal generated by these
variables. Its homology over `𝔽₂` is `G.partiallyBlockedHomology S`. Blocking one column `i` gives
the simply blocked complex, so `partiallyBlockedHomology {i}` is the simply blocked grid homology
`G-hat` (`IsKnot.partiallyBlockedHomologySingletonEquiv`); blocking every column gives the fully
blocked complex, so `partiallyBlockedHomology univ` is fully blocked grid homology `GH~`
(`partiallyBlockedHomologyUnivEquiv`).

On a knot grid the `X`-marking homotopies make every variable `V_t` chain homotopic to `V_i` on
`GC⁻` (`IsKnot.XSmulHomotopy`). Once `i ∈ S`, the variable `V_i`
is zero on the partially blocked complex, so `V_t` is null-homotopic there; and `V_t` acts freely
on it when `t ∉ S`. Blocking `t` as well therefore doubles the homology
(`LinearMap.quotientHomologyProdEquiv`):

`H(S ∪ {t}) ≅ H(S) × H(S)`.

Blocking the remaining `n - 1` columns one at a time gives the dimension formula
`dim GH~ = 2 ^ (n - 1) · dim G-hat` for a knot grid of size `n`
(`IsKnot.finrank_fullyBlockedHomology`). This is the dimension count of the isomorphism
`GH~ ≅ G-hat ⊗ W ^ (n - 1)` of Ozsváth--Stipsicz--Szabó, with `W` two-dimensional; in particular
`G-hat` is computed by the finite complex of fully blocked rectangles.

## Main definitions

* `TauCeti.GridDiagram.blockedChains`: the chains of `GC⁻` whose coefficients lie in the ideal
  generated by the variables of the columns in `S`.
* `TauCeti.GridDiagram.partiallyBlockedHomology`: the homology of `GC⁻` modulo these chains.
* `TauCeti.GridDiagram.IsKnot.partiallyBlockedHomologySingletonEquiv`: its identification with
  simply blocked grid homology when `S = {i}`.
* `TauCeti.GridDiagram.partiallyBlockedHomologyUnivEquiv`: its identification with fully blocked
  grid homology when `S` contains every column.
* `TauCeti.GridDiagram.IsKnot.partiallyBlockedHomologyInsertEquiv`: blocking one more column
  doubles the homology of a knot grid.

## Main results

* `TauCeti.GridDiagram.IsKnot.partiallyBlockedHomologySingletonEquiv_mk`,
  `TauCeti.GridDiagram.partiallyBlockedHomologyUnivEquiv_mk` and
  `TauCeti.GridDiagram.IsKnot.partiallyBlockedHomologyInsertEquiv_mk`: the three identifications
  on classes of chains.
* `TauCeti.GridDiagram.IsKnot.finrank_partiallyBlockedHomology_insert`: the dimension doubles
  when one more column is blocked.
* `TauCeti.GridDiagram.IsKnot.finrank_fullyBlockedHomology`: the dimension of fully blocked grid
  homology of a knot grid of size `n` is `2 ^ (n - 1)` times that of simply blocked grid homology.

## References

* P. Ozsváth, A. Stipsicz, Z. Szabó, *Grid Homology for Knots and Links*, AMS Mathematical Surveys
  and Monographs 208, 2015, Section 4.6 (the comparison of fully blocked and simply blocked grid
  homology).
* C. Manolescu, P. Ozsváth, Z. Szabó, D. Thurston, *On combinatorial link Floer homology*,
  Geom. Topol. 11 (2007), [arXiv:math/0610559](https://arxiv.org/abs/math/0610559), Section 2.
-/

public section

open MvPolynomial

namespace TauCeti

namespace GridDiagram

variable {n : ℕ}

local notation "F" => ZMod 2

/-! ### Chains with coefficients in the ideal of blocked variables -/

section BlockedChains

variable (R : Type*) [CommSemiring R]

/-- The chains of `GC⁻` whose coefficients lie in the ideal generated by the variables `V_s` of
the columns `s ∈ S`. The quotient of `GC⁻` by them is the grid complex with these variables set to
zero. -/
noncomputable def blockedChains (S : Finset (Fin n)) :
    Submodule (MvPolynomial (Fin n) R) (GridChainMinus R n) :=
  Finsupp.submodule fun _ => Ideal.span (MvPolynomial.X '' (S : Set (Fin n)))

variable {R}

/-- A chain is blocked exactly when each of its coefficients lies in the ideal generated by the
blocked variables. -/
theorem mem_blockedChains_iff {S : Finset (Fin n)} {c : GridChainMinus R n} :
    c ∈ blockedChains R S ↔ ∀ x, c x ∈ Ideal.span (MvPolynomial.X '' (S : Set (Fin n))) :=
  Finsupp.mem_submodule_iff _ c

/-- Blocking more columns blocks more chains. -/
theorem blockedChains_mono {S T : Finset (Fin n)} (h : S ⊆ T) :
    blockedChains R S ≤ blockedChains R T :=
  fun _ hc x => Ideal.span_mono (Set.image_mono (Finset.coe_subset.mpr h)) (hc x)

/-- A multiple of a blocked variable is blocked. -/
theorem X_smul_mem_blockedChains {S : Finset (Fin n)} {t : Fin n} (ht : t ∈ S)
    (c : GridChainMinus R n) :
    (MvPolynomial.X t : MvPolynomial (Fin n) R) • c ∈ blockedChains R S :=
  fun _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨t, ht, rfl⟩)

/-- Every linear endomorphism of `GC⁻` over the polynomial ring preserves the blocked chains. -/
theorem map_mem_blockedChains {S : Finset (Fin n)}
    (f : GridChainMinus R n →ₗ[MvPolynomial (Fin n) R] GridChainMinus R n) {c : GridChainMinus R n}
    (hc : c ∈ blockedChains R S) : f c ∈ blockedChains R S := by
  intro y
  have hsum : c = c.sum fun x p => p • Finsupp.single x (1 : MvPolynomial (Fin n) R) := by
    conv_lhs => rw [← Finsupp.sum_single c]
    simp only [Finsupp.smul_single_one]
  rw [hsum, map_finsuppSum, Finsupp.sum_apply]
  exact Ideal.sum_mem _ fun x _ => by
    simp only [map_smul, Finsupp.smul_apply, smul_eq_mul]
    exact Ideal.mul_mem_right _ _ (hc x)

/-- A chain blocked for `insert t S` differs from a multiple of `V_t` by a chain blocked for
`S`. -/
theorem exists_sub_X_smul_mem_blockedChains {R : Type*} [CommRing R] {S : Finset (Fin n)}
    {t : Fin n} {c : GridChainMinus R n} (hc : c ∈ blockedChains R (insert t S)) :
    ∃ u : GridChainMinus R n, c - (MvPolynomial.X t : MvPolynomial (Fin n) R) • u ∈
      blockedChains R S := by
  classical
  have key (p : MvPolynomial (Fin n) R)
      (hp : p ∈ Ideal.span (MvPolynomial.X '' ((insert t S : Finset _) : Set (Fin n)))) :
      ∃ a, p - MvPolynomial.X t * a ∈ Ideal.span (MvPolynomial.X '' (S : Set (Fin n))) := by
    rw [Finset.coe_insert, Set.image_insert_eq, Ideal.mem_span_insert] at hp
    obtain ⟨a, z, hz, rfl⟩ := hp
    exact ⟨a, by rwa [mul_comm, add_sub_cancel_left]⟩
  choose! a ha using key
  refine ⟨Finsupp.onFinset c.support (fun x => if c x = 0 then 0 else a (c x)) fun x hx => ?_,
    fun x => ?_⟩
  · rw [Finsupp.mem_support_iff]
    rintro h
    simp [h] at hx
  · rw [Finsupp.sub_apply, Finsupp.smul_apply, Finsupp.onFinset_apply, smul_eq_mul]
    split_ifs with h
    · rw [h, mul_zero, sub_zero]
      exact Ideal.zero_mem _
    · exact ha _ (hc x)

/-- A chain is blocked for the single column `i` exactly when setting `V_i` to zero kills it. -/
theorem simplyBlockedSpecialization_eq_zero_iff {i : Fin n} {c : GridChainMinus R n} :
    simplyBlockedSpecialization R i c = 0 ↔ c ∈ blockedChains R {i} := by
  have hrange : Set.range (Subtype.val : {c : Fin n // c ≠ i} → Fin n) = {i}ᶜ := by
    ext d
    simp
  rw [mem_blockedChains_iff, Finsupp.ext_iff]
  refine forall_congr' fun x => ?_
  rw [simplyBlockedSpecialization_apply, Finsupp.coe_zero, Pi.zero_apply,
    killCompl_eq_zero_iff_X_dvd Subtype.val_injective hrange, Finset.coe_singleton,
    Set.image_singleton, Ideal.mem_span_singleton]

/-- A chain is blocked for every column exactly when its constant coefficients vanish. -/
theorem mapRange_constantCoeff_eq_zero_iff {c : GridChainMinus R n} :
    c.mapRange constantCoeff (map_zero _) = 0 ↔ c ∈ blockedChains R Finset.univ := by
  rw [mem_blockedChains_iff, Finsupp.ext_iff, Finset.coe_univ, Set.image_univ]
  refine forall_congr' fun x => ?_
  rw [Finsupp.mapRange_apply, Finsupp.coe_zero, Pi.zero_apply, ← RingHom.mem_ker,
    ker_constantCoeff, idealOfVars]

end BlockedChains

/-- A chain whose multiple by an unblocked variable `V_t` is blocked is itself blocked: a monomial
of `V_t * p` involves a blocked variable only if the corresponding monomial of `p` does. -/
theorem mem_blockedChains_of_X_smul_mem {R : Type*} [CommSemiring R] {S : Finset (Fin n)}
    {t : Fin n} (ht : t ∉ S) {c : GridChainMinus R n}
    (hc : (MvPolynomial.X t : MvPolynomial (Fin n) R) • c ∈ blockedChains R S) :
    c ∈ blockedChains R S := by
  intro x
  have hx := mem_ideal_span_X_image.mp (hc x)
  refine mem_ideal_span_X_image.mpr fun m hm => ?_
  have hm' :
      Finsupp.single t 1 + m ∈ ((MvPolynomial.X t : MvPolynomial (Fin n) R) * c x).support := by
    rw [mem_support_iff, coeff_X_mul]
    exact mem_support_iff.mp hm
  obtain ⟨j, hj, hne⟩ := hx _ (by simpa only [Finsupp.smul_apply, smul_eq_mul] using hm')
  refine ⟨j, hj, fun hmj => hne ?_⟩
  have hjt : j ≠ t := fun h => ht (h ▸ hj)
  rw [Finsupp.add_apply, Finsupp.single_eq_of_ne hjt, hmj, add_zero]

/-! ### Partially blocked grid homology -/

variable (G : GridDiagram n)

/-- Over `𝔽₂`, the unblocked grid differential squares to zero as an `𝔽₂`-linear map. -/
theorem restrictScalars_unblockedDifferential_comp_self_eq_zero :
    (G.unblockedDifferential F).restrictScalars F ∘ₗ (G.unblockedDifferential F).restrictScalars F =
      0 :=
  LinearMap.ext fun c => congr($(G.unblockedDifferential_comp_self_eq_zero F) c)

/-- The unblocked grid differential preserves the blocked chains. -/
theorem blockedChains_le_comap_unblockedDifferential (S : Finset (Fin n)) :
    (blockedChains F S).restrictScalars F ≤
      ((blockedChains F S).restrictScalars F).comap
        ((G.unblockedDifferential F).restrictScalars F) :=
  fun _ hc => map_mem_blockedChains _ hc

/-- The partially blocked grid homology of the columns `S`: the homology over `𝔽₂` of the
unblocked grid complex `GC⁻` with the variables `V_s`, `s ∈ S`, set to zero, that is, of `GC⁻`
modulo `blockedChains S`. -/
noncomputable abbrev partiallyBlockedHomology (S : Finset (Fin n)) : Type :=
  ((G.unblockedDifferential F).restrictScalars F).quotientHomology
    G.restrictScalars_unblockedDifferential_comp_self_eq_zero
    ((blockedChains F S).restrictScalars F)
    (G.blockedChains_le_comap_unblockedDifferential S)

/-- **Blocking one more column doubles partially blocked homology.** On a knot grid, if the
column `i` is blocked and `t` is not, then blocking `t` as well gives two copies of the homology:
the class of `(a, b)` goes to the class of `a + H b` for the homotopy `H = hG.XSmulHomotopy F t i`
from `V_t` to `V_i` (`IsKnot.partiallyBlockedHomologyInsertEquiv_mk`). -/
noncomputable def IsKnot.partiallyBlockedHomologyInsertEquiv {G : GridDiagram n} (hG : G.IsKnot)
    {S : Finset (Fin n)} {i t : Fin n} (hi : i ∈ S) (ht : t ∉ S) :
    (G.partiallyBlockedHomology S × G.partiallyBlockedHomology S) ≃ₗ[F]
      G.partiallyBlockedHomology (insert t S) :=
  LinearMap.quotientHomologyProdEquiv (h := (hG.XSmulHomotopy F t i).restrictScalars F)
    (v := DistribSMul.toLinearMap F (GridChainMinus F n) (MvPolynomial.X t))
    G.restrictScalars_unblockedDifferential_comp_self_eq_zero
    (G.blockedChains_le_comap_unblockedDifferential S)
    (G.blockedChains_le_comap_unblockedDifferential (insert t S))
    (blockedChains_mono (Finset.subset_insert t S))
    (fun m => by
      simp only [Submodule.restrictScalars_mem]
      exact X_smul_mem_blockedChains (Finset.mem_insert_self t S) m)
    (fun _ hx => by
      simp only [DistribSMul.toLinearMap_apply, Submodule.restrictScalars_mem]
      exact exists_sub_X_smul_mem_blockedChains hx)
    (fun _ hm => map_mem_blockedChains _ hm)
    (fun m => by
      simp only [LinearMap.restrictScalars_apply, DistribSMul.toLinearMap_apply]
      exact (G.unblockedDifferential F).map_smul _ m)
    (fun _ hm => by
      simp only [DistribSMul.toLinearMap_apply, Submodule.restrictScalars_mem] at hm ⊢
      exact mem_blockedChains_of_X_smul_mem ht hm)
    (fun m => by
      have hm : G.unblockedDifferential F (hG.XSmulHomotopy F t i m) +
          hG.XSmulHomotopy F t i (G.unblockedDifferential F m) =
          (MvPolynomial.X t + MvPolynomial.X i : MvPolynomial (Fin n) F) • m :=
        congr($(hG.unblockedDifferential_comp_XSmulHomotopy_add_XSmulHomotopy_comp F t i) m)
      simp only [LinearMap.restrictScalars_apply, DistribSMul.toLinearMap_apply,
        Submodule.restrictScalars_mem]
      rw [hm, add_smul, add_sub_cancel_left]
      exact X_smul_mem_blockedChains hi m)

/-- The splitting sends the classes of chains `a` and `b` with blocked boundaries to the class of
`a + H b`, where `H = hG.XSmulHomotopy F t i`. -/
@[simp]
theorem IsKnot.partiallyBlockedHomologyInsertEquiv_mk {G : GridDiagram n} (hG : G.IsKnot)
    {S : Finset (Fin n)} {i t : Fin n} (hi : i ∈ S) (ht : t ∉ S) (a b : GridChainMinus F n)
    (ha : G.unblockedDifferential F a ∈ blockedChains F S)
    (hb : G.unblockedDifferential F b ∈ blockedChains F S) :
    hG.partiallyBlockedHomologyInsertEquiv hi ht
        (Submodule.Quotient.mk
            ⟨Submodule.Quotient.mk a, (Submodule.mk_mem_ker_mapQ_iff a).mpr ha⟩,
          Submodule.Quotient.mk
            ⟨Submodule.Quotient.mk b, (Submodule.mk_mem_ker_mapQ_iff b).mpr hb⟩) =
      Submodule.Quotient.mk ⟨Submodule.Quotient.mk (a + hG.XSmulHomotopy F t i b),
        (Submodule.mk_mem_ker_mapQ_iff _).mpr (by
          have hH := congr($(hG.unblockedDifferential_comp_XSmulHomotopy_add_XSmulHomotopy_comp
            F t i) b)
          simp only [LinearMap.add_apply, LinearMap.comp_apply, LinearMap.smul_apply,
            LinearMap.id_apply, add_smul] at hH
          simp only [LinearMap.restrictScalars_apply, Submodule.restrictScalars_mem, map_add,
            eq_sub_of_add_eq hH]
          have hS := blockedChains_mono (R := F) (Finset.subset_insert t S)
          exact add_mem (hS ha) (sub_mem (add_mem
            (X_smul_mem_blockedChains (Finset.mem_insert_self t S) b)
            (hS (X_smul_mem_blockedChains hi b))) (hS (map_mem_blockedChains _ hb))))⟩ := by
  rw [partiallyBlockedHomologyInsertEquiv]
  refine (LinearMap.quotientHomologyProdEquiv_mk _ _ _ _ _ _ _ _ _ _ a b ?_ ?_).trans rfl
  exacts [ha, hb]

/-- On a knot grid, blocking one more column doubles the dimension of partially blocked
homology, provided some column is already blocked. -/
theorem IsKnot.finrank_partiallyBlockedHomology_insert {G : GridDiagram n} (hG : G.IsKnot)
    {S : Finset (Fin n)} {i t : Fin n} (hi : i ∈ S) (ht : t ∉ S) :
    Module.finrank F (G.partiallyBlockedHomology (insert t S)) =
      2 * Module.finrank F (G.partiallyBlockedHomology S) := by
  rw [← (hG.partiallyBlockedHomologyInsertEquiv hi ht).finrank_eq, Module.finrank_prod_self]

/-- On a knot grid, blocking the columns of `T` in addition to the column `i` multiplies the
dimension of partially blocked homology by `2 ^ |T|`. -/
theorem IsKnot.finrank_partiallyBlockedHomology_insert_eq_two_pow_mul {G : GridDiagram n}
    (hG : G.IsKnot) {i : Fin n} {T : Finset (Fin n)} (hiT : i ∉ T) :
    Module.finrank F (G.partiallyBlockedHomology (insert i T)) =
      2 ^ T.card * Module.finrank F (G.partiallyBlockedHomology {i}) := by
  induction T using Finset.induction_on with
  | empty => rw [LawfulSingleton.insert_empty_eq, Finset.card_empty, pow_zero, one_mul]
  | insert t T htT ih =>
    have hit : i ≠ t := fun h => hiT (h ▸ Finset.mem_insert_self t T)
    rw [Finset.insert_comm, hG.finrank_partiallyBlockedHomology_insert (Finset.mem_insert_self i T)
      (by simp [Ne.symm hit, htT]), ih (fun h => hiT (Finset.mem_insert_of_mem h)),
      Finset.card_insert_of_notMem htT, pow_succ, mul_assoc, mul_left_comm]

/-! ### Simply blocked and fully blocked homology -/

/-- Setting `V_i` to zero, as an `𝔽₂`-linear map `GC⁻ → GC^`. -/
private noncomputable def specialization₂ (i : Fin n) :
    GridChainMinus F n →ₗ[F] GridChainHat F n i :=
  (simplyBlockedSpecialization F i).toAddMonoidHom.toZModLinearMap 2

private theorem specialization₂_apply (i : Fin n) (c : GridChainMinus F n) :
    specialization₂ i c = simplyBlockedSpecialization F i c :=
  (rfl)

private theorem specialization₂_surjective (i : Fin n) :
    Function.Surjective (specialization₂ (n := n) i) :=
  fun c => simplyBlockedSpecialization_surjective F i c

private theorem ker_specialization₂ (i : Fin n) :
    LinearMap.ker (specialization₂ (n := n) i) = (blockedChains F {i}).restrictScalars F := by
  ext c
  rw [LinearMap.mem_ker, Submodule.restrictScalars_mem, specialization₂_apply,
    simplyBlockedSpecialization_eq_zero_iff]

/-- The simply blocked differential over `𝔽₂`, as an `𝔽₂`-linear map. -/
private noncomputable abbrev dHat₂ (i : Fin n) : GridChainHat F n i →ₗ[F] GridChainHat F n i :=
  (G.simplyBlockedDifferential F i).restrictScalars F

private theorem dHat₂_comp_self (i : Fin n) : G.dHat₂ i ∘ₗ G.dHat₂ i = 0 :=
  LinearMap.ext fun c => congr($(G.simplyBlockedDifferential_comp_self_eq_zero F i) c)

private theorem specialization₂_comp (i : Fin n) :
    specialization₂ i ∘ₗ (G.unblockedDifferential F).restrictScalars F =
      G.dHat₂ i ∘ₗ specialization₂ i :=
  LinearMap.ext fun c => G.simplyBlockedSpecialization_unblockedDifferential F i c

/-- A cycle of the simply blocked differential over `𝔽₂`, as a simply blocked cycle of the
categorical simply blocked complex. -/
private noncomputable def kerToSimplyBlockedCycles {G : GridDiagram n} (hG : G.IsKnot) (i : Fin n) :
    LinearMap.ker (G.dHat₂ i) →+ hG.simplyBlockedCycles F i where
  toFun z := ⟨(G.simplyBlockedChainEquiv F i).symm z, by
    rw [IsKnot.mem_simplyBlockedCycles, LinearEquiv.apply_symm_apply]
    exact z.2⟩
  map_zero' := Subtype.ext (map_zero (G.simplyBlockedChainEquiv F i).symm)
  map_add' z z' := Subtype.ext
    (map_add (G.simplyBlockedChainEquiv F i).symm (z : GridChainHat F n i) z')

private theorem coe_kerToSimplyBlockedCycles {G : GridDiagram n} (hG : G.IsKnot) (i : Fin n)
    (z : LinearMap.ker (G.dHat₂ i)) :
    (kerToSimplyBlockedCycles hG i z : (G.simplyBlockedComplex F i).X ()) =
      (G.simplyBlockedChainEquiv F i).symm z :=
  (rfl)

/-- The class in simply blocked grid homology of a cycle of the simply blocked differential over
`𝔽₂`. -/
private noncomputable def simplyBlockedClass₂ {G : GridDiagram n} (hG : G.IsKnot) (i : Fin n) :
    LinearMap.ker (G.dHat₂ i) →ₗ[F]
      (ModuleCat.restrictScalars (C : F →+* MvPolynomial {c : Fin n // c ≠ i} F)).obj
        (hG.simplyBlockedHomology F i) where
  toFun z := hG.simplyBlockedHomologyClass F i (kerToSimplyBlockedCycles hG i z)
  map_add' z z' := by
    rw [map_add, map_add]
    -- The addition of the restriction of scalars is that of `G-hat` itself.
    rfl
  map_smul' := ZMod.map_smul (M₁ := (ModuleCat.restrictScalars
      (C : F →+* MvPolynomial {c : Fin n // c ≠ i} F)).obj (hG.simplyBlockedHomology F i))
    ((hG.simplyBlockedHomologyClass F i).toAddMonoidHom.comp (kerToSimplyBlockedCycles hG i))

private theorem simplyBlockedClass₂_apply {G : GridDiagram n} (hG : G.IsKnot) (i : Fin n)
    (z : LinearMap.ker (G.dHat₂ i)) :
    simplyBlockedClass₂ hG i z =
      hG.simplyBlockedHomologyClass F i (kerToSimplyBlockedCycles hG i z) :=
  (rfl)

private theorem simplyBlockedClass₂_eq_zero_iff {G : GridDiagram n} (hG : G.IsKnot) (i : Fin n)
    (z : LinearMap.ker (G.dHat₂ i)) :
    simplyBlockedClass₂ hG i z = 0 ↔
      hG.simplyBlockedHomologyClass F i (kerToSimplyBlockedCycles hG i z) = 0 :=
  Iff.rfl

private theorem simplyBlockedClass₂_surjective {G : GridDiagram n} (hG : G.IsKnot) (i : Fin n) :
    Function.Surjective (simplyBlockedClass₂ hG i) := fun y => by
  obtain ⟨c, rfl⟩ := hG.simplyBlockedHomologyClass_surjective F i y
  refine ⟨⟨G.simplyBlockedChainEquiv F i c, ?_⟩, ?_⟩
  · rw [LinearMap.mem_ker]
    exact (IsKnot.mem_simplyBlockedCycles F hG i c).mp c.2
  · rw [simplyBlockedClass₂_apply]
    congr 1
    ext1
    rw [coe_kerToSimplyBlockedCycles, LinearEquiv.symm_apply_apply]

private theorem boundariesInKer_eq_ker_simplyBlockedClass₂ {G : GridDiagram n} (hG : G.IsKnot)
    (i : Fin n) : (G.dHat₂ i).boundariesInKer = LinearMap.ker (simplyBlockedClass₂ hG i) := by
  ext z
  rw [LinearMap.mem_ker, simplyBlockedClass₂_eq_zero_iff,
    IsKnot.simplyBlockedHomologyClass_eq_zero_iff, IsKnot.mem_simplyBlockedBoundaries_iff,
    coe_kerToSimplyBlockedCycles,
    LinearEquiv.apply_symm_apply, LinearMap.mem_boundariesInKer]
  -- The range of a restriction of scalars is the range of the original map.
  rfl

/-- The homology of the simply blocked differential, viewed over `𝔽₂`, is simply blocked grid
homology. -/
private noncomputable def dHat₂HomologyEquiv {G : GridDiagram n} (hG : G.IsKnot) (i : Fin n) :
    (G.dHat₂ i).homology (G.dHat₂_comp_self i) ≃ₗ[F]
      (ModuleCat.restrictScalars (C : F →+* MvPolynomial {c : Fin n // c ≠ i} F)).obj
        (hG.simplyBlockedHomology F i) :=
  (Submodule.quotEquivOfEq _ _ (boundariesInKer_eq_ker_simplyBlockedClass₂ hG i)).trans
    ((simplyBlockedClass₂ hG i).quotKerEquivOfSurjective (simplyBlockedClass₂_surjective hG i))

/-- **Blocking one column gives simply blocked grid homology.** For a knot grid, the partially
blocked homology of a single column `i` is the simply blocked grid homology `G-hat`, viewed over
`𝔽₂`. -/
noncomputable def IsKnot.partiallyBlockedHomologySingletonEquiv {G : GridDiagram n}
    (hG : G.IsKnot) (i : Fin n) :
    G.partiallyBlockedHomology {i} ≃ₗ[F]
      (ModuleCat.restrictScalars (C : F →+* MvPolynomial {c : Fin n // c ≠ i} F)).obj
        (hG.simplyBlockedHomology F i) :=
  (LinearMap.quotientHomologyEquivOfSurjective
    G.restrictScalars_unblockedDifferential_comp_self_eq_zero
    (G.blockedChains_le_comap_unblockedDifferential {i}) (G.dHat₂_comp_self i) (specialization₂ i)
    (specialization₂_surjective i) (ker_specialization₂ i) (G.specialization₂_comp i)).trans
    (dHat₂HomologyEquiv hG i)

/-- The identification with `G-hat` sends the class of a chain `c` whose boundary is blocked for
`i` to the class in `G-hat` of `c` with `V_i` set to zero. -/
@[simp]
theorem IsKnot.partiallyBlockedHomologySingletonEquiv_mk {G : GridDiagram n} (hG : G.IsKnot)
    (i : Fin n) (c : GridChainMinus F n) (hc : G.unblockedDifferential F c ∈ blockedChains F {i}) :
    hG.partiallyBlockedHomologySingletonEquiv i
        (Submodule.Quotient.mk
            ⟨Submodule.Quotient.mk c, (Submodule.mk_mem_ker_mapQ_iff c).mpr hc⟩) =
      hG.simplyBlockedHomologyClass F i
        ⟨(G.simplyBlockedChainEquiv F i).symm (simplyBlockedSpecialization F i c), by
          rw [IsKnot.mem_simplyBlockedCycles, LinearEquiv.apply_symm_apply,
            ← simplyBlockedSpecialization_unblockedDifferential,
            simplyBlockedSpecialization_eq_zero_iff]
          exact hc⟩ := by
  rw [partiallyBlockedHomologySingletonEquiv, LinearEquiv.trans_apply,
    LinearMap.quotientHomologyEquivOfSurjective_mk
      G.restrictScalars_unblockedDifferential_comp_self_eq_zero
      (G.blockedChains_le_comap_unblockedDifferential {i}) (G.dHat₂_comp_self i) (specialization₂ i)
      (specialization₂_surjective i) (ker_specialization₂ i) (G.specialization₂_comp i) c hc]
  rfl

/-- Taking constant coefficients, as an `𝔽₂`-linear map `GC⁻ → GC~`. -/
private noncomputable def constantCoeff₂ : GridChainMinus F n →ₗ[F] GridChain F n :=
  (Finsupp.mapRange.addMonoidHom (constantCoeff : MvPolynomial (Fin n) F →+* F).toAddMonoidHom
    ).toZModLinearMap 2

private theorem constantCoeff₂_apply (c : GridChainMinus F n) :
    constantCoeff₂ c = c.mapRange constantCoeff (map_zero _) :=
  (rfl)

private theorem constantCoeff₂_surjective : Function.Surjective (constantCoeff₂ (n := n)) :=
  fun c => ⟨c.mapRange C (map_zero _), by
    ext x
    simp [constantCoeff₂_apply]⟩

private theorem constantCoeff₂_comp :
    constantCoeff₂ ∘ₗ (G.unblockedDifferential F).restrictScalars F =
      G.fullyBlockedDifferential ∘ₗ constantCoeff₂ :=
  LinearMap.ext fun c => (G.fullyBlockedDifferential_mapRange_constantCoeff c).symm

private theorem ker_constantCoeff₂ :
    LinearMap.ker (constantCoeff₂ (n := n)) =
      (blockedChains F (Finset.univ : Finset (Fin n))).restrictScalars F := by
  ext c
  rw [LinearMap.mem_ker, Submodule.restrictScalars_mem, constantCoeff₂_apply,
    mapRange_constantCoeff_eq_zero_iff]

/-- **Blocking every column gives fully blocked grid homology.** The partially blocked homology
of all the columns is the fully blocked grid homology `GH~`. -/
noncomputable def partiallyBlockedHomologyUnivEquiv :
    G.partiallyBlockedHomology Finset.univ ≃ₗ[F] G.fullyBlockedHomology :=
  (LinearMap.quotientHomologyEquivOfSurjective
    G.restrictScalars_unblockedDifferential_comp_self_eq_zero
    (G.blockedChains_le_comap_unblockedDifferential Finset.univ)
    G.fullyBlockedDifferential_comp_self_eq_zero
    constantCoeff₂ constantCoeff₂_surjective ker_constantCoeff₂ G.constantCoeff₂_comp).trans
    G.fullyBlockedHomologyEquivLinearMapHomology.symm

/-- The identification with `GH~` sends the class of a chain `c` whose boundary is blocked for every
column to the class of its constant coefficients. -/
@[simp]
theorem partiallyBlockedHomologyUnivEquiv_mk (c : GridChainMinus F n)
    (hc : G.unblockedDifferential F c ∈ blockedChains F Finset.univ) :
    G.partiallyBlockedHomologyUnivEquiv
        (Submodule.Quotient.mk
            ⟨Submodule.Quotient.mk c, (Submodule.mk_mem_ker_mapQ_iff c).mpr hc⟩) =
      Submodule.Quotient.mk ⟨c.mapRange constantCoeff (map_zero _), by
        rw [mem_fullyBlockedCycles, fullyBlockedDifferential_mapRange_constantCoeff,
          mapRange_constantCoeff_eq_zero_iff]
        exact hc⟩ := by
  rw [partiallyBlockedHomologyUnivEquiv, LinearEquiv.trans_apply]
  rw [LinearMap.quotientHomologyEquivOfSurjective_mk
      G.restrictScalars_unblockedDifferential_comp_self_eq_zero
      (G.blockedChains_le_comap_unblockedDifferential Finset.univ)
      G.fullyBlockedDifferential_comp_self_eq_zero constantCoeff₂ constantCoeff₂_surjective
      ker_constantCoeff₂ G.constantCoeff₂_comp c hc,
    fullyBlockedHomologyEquivLinearMapHomology_symm_mk]
  rfl

/-- **Fully blocked grid homology is `2 ^ (n - 1)` copies of simply blocked grid homology.** For a
knot grid of size `n`, the dimension of `GH~` is `2 ^ (n - 1)` times the dimension of `G-hat`
for any blocked column `i`. This is the dimension count of `GH~ ≅ G-hat ⊗ W ^ (n - 1)`. -/
theorem IsKnot.finrank_fullyBlockedHomology {G : GridDiagram n} (hG : G.IsKnot) (i : Fin n) :
    Module.finrank F G.fullyBlockedHomology =
      2 ^ (n - 1) * Module.finrank F
        ((ModuleCat.restrictScalars (C : F →+* MvPolynomial {c : Fin n // c ≠ i} F)).obj
          (hG.simplyBlockedHomology F i)) := by
  have h :=
    hG.finrank_partiallyBlockedHomology_insert_eq_two_pow_mul (Finset.notMem_erase i Finset.univ)
  rw [Finset.insert_erase (Finset.mem_univ i), Finset.card_erase_of_mem (Finset.mem_univ i),
    Finset.card_univ, Fintype.card_fin] at h
  rw [← G.partiallyBlockedHomologyUnivEquiv.finrank_eq, h,
    (hG.partiallyBlockedHomologySingletonEquiv i).finrank_eq]

end GridDiagram

end TauCeti
