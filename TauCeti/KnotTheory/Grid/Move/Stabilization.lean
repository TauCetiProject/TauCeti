module

public import Mathlib.Data.Fin.SuccPredOrder
public import Mathlib.Order.SuccPred.Relation
public import TauCeti.KnotTheory.Grid.Move.Basic

/-!
# Reducing grid stabilizations to two corner types

An elementary stabilization (`GridDiagram.IsStabilization`) splits an `O`- or an `X`-marking of a
grid diagram `G` across a new `2 × 2` block, and the new row and column may sit on either side of
the split marking, giving eight stabilization types. This file shows that, up to the moves that
keep the size of a diagram, only two of them matter: every stabilization of `G` is connected by
cyclic permutations and commutations to one of

* `G.stabilizeX s.castSucc (G.X s).castSucc s`, whose new `O`-marking is the south-west corner of
  the new block, with the two `X`-markings to its north and east, and
* `G.stabilizeX s.succ (G.X s).succ s`, whose new `O`-marking is the north-east corner of the new
  block, with the two `X`-markings to its south and west,

for some column `s` of `G` (`GridDiagram.IsStabilization.exists_commutationMovesTo`). The first
of these is the stabilization whose invariance for `GH⁻` is proved in
`TauCeti.KnotTheory.Grid.Stabilization.Homology`. Consequently a function on grid diagrams that is
invariant under cyclic permutations, commutations and these two stabilizations is invariant
under every stabilization (`GridDiagram.IsStabilization.apply_eq_apply`), which is the hypothesis
of `GridLink.lift`.

The reduction has three steps.

* A cyclic permutation of the rows or columns of the stabilized diagram moves a new row or column
  that wraps around the torus next to the split marking.
* With the new column just before the split column, the new row together with its two markings
  is a short horizontal segment that commutes with every row
  (`GridDiagram.rowsNoninterleaving_of_X_eq_finRotate_O`), so it can be slid to any height
  (`GridDiagram.commutationMovesTo_stabilizeX_castSucc`). A column commutation exchanges the two
  columns of the new block when one of them is a short vertical segment.
* With the new column just after the split column, the new row is a short segment with its
  markings in the opposite order. It still commutes with every row that has no marking in the two
  columns of the new block, so it slides between the rows of the two markings of the split column
  (`GridDiagram.isRowCommutation_stabilizeX_succ`). Sliding it from the `X`-marking up to the
  `O`-marking turns the north-east `X`-stabilization into an `O`-stabilization
  (`GridDiagram.commutationMovesTo_stabilizeO_castSucc_stabilizeX_succ`).

Every `O`-stabilization with the new column next to the split column is an `X`-stabilization with
the new column on the other side (`GridDiagram.stabilizeO_castSucc_eq_stabilizeX_succ`,
`GridDiagram.stabilizeO_succ_eq_stabilizeX_castSucc`), so these slides cover all eight types. The
two corner types are not identified with each other here.

## Main definitions

* `TauCeti.GridDiagram.CommutationMovesTo`: the equivalence relation on grid diagrams of one size
  generated by cyclic permutations and commutations.

## Main results

* `TauCeti.GridDiagram.IsStabilization.exists_commutationMovesTo`: every stabilization is related
  by cyclic permutations and commutations to one of the two corner stabilizations above.
* `TauCeti.GridDiagram.IsStabilization.apply_eq_apply`: invariance under cyclic permutations,
  commutations and the two corner stabilizations implies invariance under every stabilization.

## References

The grid moves and the eight stabilization types are those of Ozsváth--Stipsicz--Szabó, *Grid
Homology for Knots and Links*, Chapter 3. Stabilization invariance of grid homology is Chapter 5
of the same book.
-/

public section

namespace TauCeti

namespace GridDiagram

variable {n : ℕ}

/-! ### Moves that keep the size -/

/-- Two grid diagrams of the same size are connected by cyclic permutations of the rows or
columns and by commutations, the grid moves that do not change the size of a diagram. -/
def CommutationMovesTo (G G' : GridDiagram n) : Prop :=
  Relation.EqvGen (fun H H' : GridDiagram n ↦
    H' = H.relabelRows (finRotate n) ∨ H' = H.relabelColumns (finRotate n) ∨
      IsCommutation H H') G G'

/-- `CommutationMovesTo` is the equivalence relation generated by cyclic permutations of the rows,
cyclic permutations of the columns, and commutations. -/
theorem commutationMovesTo_def (G G' : GridDiagram n) :
    CommutationMovesTo G G' ↔ Relation.EqvGen (fun H H' : GridDiagram n ↦
      H' = H.relabelRows (finRotate n) ∨ H' = H.relabelColumns (finRotate n) ∨
        IsCommutation H H') G G' :=
  Iff.rfl

namespace CommutationMovesTo

variable {G G' G'' : GridDiagram n}

/-- Induction principle for `CommutationMovesTo`: a relation that contains cyclic permutations of
the rows and of the columns and commutations, and is reflexive, symmetric and transitive along
connected diagrams, holds between any two connected diagrams. -/
@[elab_as_elim]
theorem induction_on {motive : GridDiagram n → GridDiagram n → Prop}
    (h : CommutationMovesTo G G')
    (rows : ∀ H : GridDiagram n, motive H (H.relabelRows (finRotate n)))
    (columns : ∀ H : GridDiagram n, motive H (H.relabelColumns (finRotate n)))
    (comm : ∀ {H H' : GridDiagram n}, IsCommutation H H' → motive H H')
    (refl : ∀ H : GridDiagram n, motive H H)
    (symm : ∀ {H H' : GridDiagram n}, CommutationMovesTo H H' → motive H H' → motive H' H)
    (trans : ∀ {H H' H'' : GridDiagram n}, CommutationMovesTo H H' → CommutationMovesTo H' H'' →
      motive H H' → motive H' H'' → motive H H'') :
    motive G G' := by
  induction h with
  | rel H H' h =>
    rcases h with rfl | rfl | h
    · exact rows H
    · exact columns H
    · exact comm h
  | refl H => exact refl H
  | symm _ _ h ih => exact symm h ih
  | trans _ _ _ h h' ih ih' => exact trans h h' ih ih'

/-- Every grid diagram is connected to itself. -/
@[refl]
theorem refl (G : GridDiagram n) : CommutationMovesTo G G :=
  Relation.EqvGen.refl _

/-- Size-preserving grid moves can be traversed in reverse. -/
@[symm]
theorem symm (h : CommutationMovesTo G G') : CommutationMovesTo G' G :=
  Relation.EqvGen.symm _ _ h

/-- Sequences of size-preserving grid moves compose. -/
@[trans]
theorem trans (h : CommutationMovesTo G G') (h' : CommutationMovesTo G' G'') :
    CommutationMovesTo G G'' :=
  Relation.EqvGen.trans _ _ _ h h'

/-- Size-preserving grid moves are grid moves. -/
theorem movesTo (h : CommutationMovesTo G G') : MovesTo G G' :=
  h.induction_on cyclicRows_movesTo cyclicColumns_movesTo IsCommutation.movesTo
    (fun _ ↦ .refl _) (fun _ ih ↦ ih.symm) (fun _ _ ih ih' ↦ ih.trans ih')

/-- A function on grid diagrams of one size that is invariant under cyclic permutations and
commutations takes the same value on diagrams connected by these moves. -/
theorem apply_eq {α : Sort*} (f : GridDiagram n → α)
    (hrows : ∀ H : GridDiagram n, f H = f (H.relabelRows (finRotate n)))
    (hcolumns : ∀ H : GridDiagram n, f H = f (H.relabelColumns (finRotate n)))
    (hcomm : ∀ {H H' : GridDiagram n}, IsCommutation H H' → f H = f H')
    (h : CommutationMovesTo G G') : f G = f G' :=
  h.induction_on (motive := fun H H' ↦ f H = f H') hrows hcolumns hcomm (fun _ ↦ rfl)
    (fun _ ih ↦ ih.symm) (fun _ _ ih ih' ↦ ih.trans ih')

end CommutationMovesTo

/-- An elementary commutation connects two diagrams of the same size. -/
theorem IsCommutation.commutationMovesTo {G G' : GridDiagram n} (h : IsCommutation G G') :
    CommutationMovesTo G G' :=
  Relation.EqvGen.rel _ _ (Or.inr (Or.inr h))

/-- An elementary row commutation connects two diagrams of the same size. -/
theorem IsRowCommutation.commutationMovesTo {G G' : GridDiagram n} (h : IsRowCommutation G G') :
    CommutationMovesTo G G' :=
  ((isCommutation_iff G G').mpr (.inl h)).commutationMovesTo

/-- An elementary column commutation connects two diagrams of the same size. -/
theorem IsColumnCommutation.commutationMovesTo {G G' : GridDiagram n}
    (h : IsColumnCommutation G G') : CommutationMovesTo G G' :=
  ((isCommutation_iff G G').mpr (.inr h)).commutationMovesTo

/-- A cyclic permutation of the rows connects two diagrams of the same size. -/
theorem commutationMovesTo_relabelRows_finRotate (G : GridDiagram n) :
    CommutationMovesTo G (G.relabelRows (finRotate n)) :=
  Relation.EqvGen.rel _ _ (Or.inl rfl)

/-- A cyclic permutation of the columns connects two diagrams of the same size. -/
theorem commutationMovesTo_relabelColumns_finRotate (G : GridDiagram n) :
    CommutationMovesTo G (G.relabelColumns (finRotate n)) :=
  Relation.EqvGen.rel _ _ (Or.inr (Or.inl rfl))

/-- Diagrams indexed by `Fin (n + 1)` are connected from `p` up to `q` when each one is
connected to the next between them. -/
private theorem commutationMovesTo_of_le {m : ℕ} (D : Fin (n + 1) → GridDiagram m)
    {p q : Fin (n + 1)} (hpq : p ≤ q)
    (h : ∀ k : Fin n, p ≤ k.castSucc → k.succ ≤ q →
      CommutationMovesTo (D k.castSucc) (D k.succ)) :
    CommutationMovesTo (D p) (D q) := by
  have hstep (i : Fin (n + 1)) (hi : i ∈ Set.Ico p q) :
      CommutationMovesTo (D i) (D (Order.succ i)) := by
    obtain ⟨k, rfl⟩ := Fin.exists_castSucc_eq.mpr (Fin.ne_last_of_lt hi.2)
    rw [Fin.orderSucc_castSucc]
    exact h k hi.1 (Fin.castSucc_lt_iff_succ_le.mp hi.2)
  have hrel := reflTransGen_of_succ_of_le (fun i j ↦ CommutationMovesTo (D i) (D j)) hstep hpq
  clear hstep h hpq
  induction hrel with
  | refl => rfl
  | tail _ hjk ih => exact ih.trans hjk

/-- A family of diagrams indexed by `Fin (n + 1)` whose last member is connected to its first:
the member at a position `p` cyclically adjacent to `p.succAbove i` is connected to the member at
`i.castSucc` or at `i.succ`. -/
private theorem commutationMovesTo_of_succAbove_adjacent {m : ℕ}
    (D : Fin (n + 1) → GridDiagram m) (hD : CommutationMovesTo (D (Fin.last n)) (D 0))
    {p : Fin (n + 1)} {i : Fin n}
    (h : finRotate (n + 1) p = p.succAbove i ∨ finRotate (n + 1) (p.succAbove i) = p) :
    CommutationMovesTo (D p) (D i.castSucc) ∨ CommutationMovesTo (D p) (D i.succ) := by
  rcases Fin.succAbove_adjacent_cases h with rfl | rfl | ⟨rfl, hi⟩ | ⟨rfl, hi⟩
  · exact .inl (.refl _)
  · exact .inr (.refl _)
  · exact .inl (hi ▸ hD)
  · exact .inr (hi ▸ hD.symm)

/-! ### Sliding the new row of a stabilization -/

variable (G : GridDiagram n) (s : Fin n)

/-- A cyclic permutation of the rows moves the new top row of an `X`-stabilization to the
bottom. -/
private theorem commutationMovesTo_stabilizeX_last_zero (c : Fin (n + 1)) :
    CommutationMovesTo (G.stabilizeX c (Fin.last n) s) (G.stabilizeX c 0 s) := by
  simpa only [stabilizeX_last_relabelRows] using
    commutationMovesTo_relabelRows_finRotate (G.stabilizeX c (Fin.last n) s)

/-- With the new column just before the split column, the new row of an `X`-stabilization carries
its `O`-marking directly left of its `X`-marking, so it commutes with the old row above it. -/
theorem isRowCommutation_stabilizeX_castSucc (k : Fin n) :
    IsRowCommutation (G.stabilizeX s.castSucc k.castSucc s)
      (G.stabilizeX s.castSucc k.succ s) := by
  have hk : finRotate (n + 1) k.castSucc = k.succ := by
    rw [finRotate_apply, Fin.coeSucc_eq_succ]
  have h := isRowCommutation_swapRows _ k.castSucc (by rw [hk]; exact Fin.castSucc_lt_succ.ne)
    (rowsNoninterleaving_of_X_eq_finRotate_O (G.stabilizeX s.castSucc k.castSucc s) ?_ _)
  · rwa [hk, stabilizeX_swapRows] at h
  rw [stabilizeX_castSucc_X, stabilizeX_O, GridState.transpose_insertPoint,
    GridState.transpose_insertPoint, GridState.insertPoint_apply_newColumn,
    GridState.insertPoint_apply_newColumn, finRotate_apply, Fin.coeSucc_eq_succ]

/-- With the new column just after the split column, the new row of an `X`-stabilization carries
its `O`-marking directly right of its `X`-marking. It commutes with the old row `k` above it
provided neither marking of the split column lies in that row. -/
theorem isRowCommutation_stabilizeX_succ {k : Fin n} (hO : G.O s ≠ k) (hX : G.X s ≠ k) :
    IsRowCommutation (G.stabilizeX s.succ k.castSucc s) (G.stabilizeX s.succ k.succ s) := by
  have hk : finRotate (n + 1) k.castSucc = k.succ := by
    rw [finRotate_apply, Fin.coeSucc_eq_succ]
  have h := isRowCommutation_swapRows (G.stabilizeX s.succ k.castSucc s) k.castSucc
    (by rw [hk]; exact Fin.castSucc_lt_succ.ne) ?_
  · rwa [hk, stabilizeX_swapRows] at h
  rw [hk, RowsNoninterleaving, stabilizeX_O, stabilizeX_succ_X, GridState.transpose_insertPoint,
    GridState.transpose_insertPoint, GridState.insertPoint_apply_newColumn,
    GridState.insertPoint_apply_newColumn, ← Fin.succAbove_castSucc_self k,
    GridState.insertPoint_apply_succAbove, GridState.insertPoint_apply_succAbove]
  refine Grid.noninterleaving_of_finRotate_eq (by rw [finRotate_apply, Fin.coeSucc_eq_succ])
    (Fin.succAbove_ne _ _) ?_ ?_ (Fin.succAbove_ne _ _)
  · rw [← Fin.succAbove_succ_self s]
    intro h
    exact hO (by rw [← Fin.succAbove_right_injective h, GridState.apply_transpose_apply])
  · rw [← Fin.succAbove_castSucc_self s]
    intro h
    exact hX (by rw [← Fin.succAbove_right_injective h, GridState.apply_transpose_apply])

/-- With the new column just before the split column, all positions of the new row give
`X`-stabilizations connected by row commutations. -/
theorem commutationMovesTo_stabilizeX_castSucc (t t' : Fin (n + 1)) :
    CommutationMovesTo (G.stabilizeX s.castSucc t s) (G.stabilizeX s.castSucc t' s) := by
  have h₀ (t : Fin (n + 1)) :
      CommutationMovesTo (G.stabilizeX s.castSucc 0 s) (G.stabilizeX s.castSucc t s) :=
    commutationMovesTo_of_le (fun t ↦ G.stabilizeX s.castSucc t s) (Fin.zero_le t)
      fun k _ _ ↦ (G.isRowCommutation_stabilizeX_castSucc s k).commutationMovesTo
  exact (h₀ t).symm.trans (h₀ t')

/-- Exchanging the two columns of the new block of the south-west `X`-stabilization is a column
commutation, since its new column is a short vertical segment. -/
theorem isColumnCommutation_stabilizeX_castSucc_X_castSucc :
    IsColumnCommutation (G.stabilizeX s.castSucc (G.X s).castSucc s)
      (G.stabilizeX s.succ (G.X s).castSucc s) := by
  have hs : finRotate (n + 1) s.castSucc = s.succ := by
    rw [finRotate_apply, Fin.coeSucc_eq_succ]
  have h := isColumnCommutation_swapColumns _ s.castSucc (by rw [hs]; exact Fin.castSucc_lt_succ.ne)
    (columnsNoninterleaving_of_X_eq_finRotate_O
      (G.stabilizeX s.castSucc (G.X s).castSucc s) ?_ _)
  · rwa [hs, stabilizeX_castSucc_swapColumns] at h
  rw [stabilizeX_castSucc_X, stabilizeX_O, GridState.insertPoint_apply_newColumn,
    ← Fin.succAbove_succ_self s, GridState.insertPoint_apply_succAbove,
    Fin.succAbove_castSucc_self, finRotate_apply, Fin.coeSucc_eq_succ]

/-- Exchanging the two columns of the new block of the `X`-stabilization with the new row just
above the `O`-marking of the split column is a column commutation, since the split column becomes
a short vertical segment. -/
theorem isColumnCommutation_stabilizeX_castSucc_O_succ :
    IsColumnCommutation (G.stabilizeX s.castSucc (G.O s).succ s)
      (G.stabilizeX s.succ (G.O s).succ s) := by
  have hs : finRotate (n + 1) s.castSucc = s.succ := by
    rw [finRotate_apply, Fin.coeSucc_eq_succ]
  have h := isColumnCommutation_swapColumns (G.stabilizeX s.castSucc (G.O s).succ s) s.castSucc
    (by rw [hs]; exact Fin.castSucc_lt_succ.ne) ?_
  · rwa [hs, stabilizeX_castSucc_swapColumns] at h
  rw [hs, columnsNoninterleaving_comm]
  refine columnsNoninterleaving_of_X_eq_finRotate_O _ ?_ _
  rw [stabilizeX_castSucc_X, stabilizeX_O, GridState.insertPoint_apply_newColumn,
    ← Fin.succAbove_castSucc_self s, GridState.insertPoint_apply_succAbove,
    Fin.succAbove_succ_self, finRotate_apply, Fin.coeSucc_eq_succ]

/-- **Sliding a stabilization along a column.** The `O`-stabilization of column `s` with its
`X`-marking in the south-west corner of the new block is connected by row commutations, and
possibly one cyclic permutation of the rows, to the `X`-stabilization of column `s` with its
`O`-marking in the north-east corner: the new row slides from just above the `X`-marking of
column `s` to just below its `O`-marking. -/
theorem commutationMovesTo_stabilizeO_castSucc_stabilizeX_succ :
    CommutationMovesTo (G.stabilizeO s.castSucc (G.O s).castSucc s)
      (G.stabilizeX s.succ (G.X s).succ s) := by
  rw [stabilizeO_castSucc_eq_stabilizeX_succ]
  symm
  let D : Fin (n + 1) → GridDiagram (n + 1) := fun t ↦ G.stabilizeX s.succ t s
  have step {k : Fin n} (hO : G.O s ≠ k) (hX : G.X s ≠ k) :
      CommutationMovesTo (D k.castSucc) (D k.succ) :=
    (G.isRowCommutation_stabilizeX_succ s hO hX).commutationMovesTo
  rcases lt_or_gt_of_ne (G.disjoint s) with h | h
  · -- The `O`-marking lies below the `X`-marking: slide up to the top row, wrap around, and slide
    -- up to the `O`-marking.
    refine ((commutationMovesTo_of_le D (Fin.le_last _) fun k h₁ _ ↦ ?_).trans
      (G.commutationMovesTo_stabilizeX_last_zero s s.succ)).trans
      (commutationMovesTo_of_le D (Fin.zero_le _) fun k _ h₂ ↦ ?_)
    · have hk := Fin.succ_le_castSucc_iff.mp h₁
      exact step (h.trans hk).ne hk.ne
    · have hk := Fin.succ_le_castSucc_iff.mp h₂
      exact step hk.ne' (hk.trans h).ne'
  · -- The `X`-marking lies below the `O`-marking: slide straight up to the `O`-marking.
    refine commutationMovesTo_of_le D (Fin.succ_le_castSucc_iff.mpr h) fun k h₁ h₂ ↦ ?_
    exact step (Fin.succ_le_castSucc_iff.mp h₂).ne' (Fin.succ_le_castSucc_iff.mp h₁).ne

/-! ### The reduction -/

/-- With the new column just after the split column, moving the new row of an
`X`-stabilization from just above the `O`-marking of column `s` to just above its `X`-marking
corresponds to exchanging the two columns of the new block on either end. -/
private theorem commutationMovesTo_stabilizeX_succ_O_succ :
    CommutationMovesTo (G.stabilizeX s.succ (G.O s).succ s)
      (G.stabilizeX s.castSucc (G.X s).castSucc s) :=
  (G.isColumnCommutation_stabilizeX_castSucc_O_succ s).commutationMovesTo.symm.trans
    (G.commutationMovesTo_stabilizeX_castSucc s _ _)

/-- An elementary `X`-stabilization is connected by cyclic permutations and commutations to one
of the two corner `X`-stabilizations of the split column. -/
theorem IsXStabilization.exists_commutationMovesTo {G : GridDiagram n} {G' : GridDiagram (n + 1)}
    (h : IsXStabilization G G') :
    ∃ s : Fin n, CommutationMovesTo G' (G.stabilizeX s.castSucc (G.X s).castSucc s) ∨
      CommutationMovesTo G' (G.stabilizeX s.succ (G.X s).succ s) := by
  obtain ⟨c, r, s, hc, hr, rfl⟩ := (isXStabilization_iff G G').mp h
  refine ⟨s, ?_⟩
  -- First move the new column next to the split column.
  rcases commutationMovesTo_of_succAbove_adjacent (fun c ↦ G.stabilizeX c r s)
    (by simpa only [stabilizeX_last_relabelColumns] using
      commutationMovesTo_relabelColumns_finRotate (G.stabilizeX (Fin.last n) r s)) hc
    with hc | hc
  · exact .inl (hc.trans (G.commutationMovesTo_stabilizeX_castSucc s _ _))
  -- The new column is just after the split column: move the new row next to the split marking.
  rcases commutationMovesTo_of_succAbove_adjacent (fun t ↦ G.stabilizeX s.succ t s)
    (G.commutationMovesTo_stabilizeX_last_zero s _) hr with hr | hr
  · exact .inl (hc.trans
      (hr.trans (G.isColumnCommutation_stabilizeX_castSucc_X_castSucc s).commutationMovesTo.symm))
  · exact .inr (hc.trans hr)

/-- An elementary `O`-stabilization is connected by cyclic permutations and commutations to one
of the two corner `X`-stabilizations of the split column. -/
theorem IsOStabilization.exists_commutationMovesTo {G : GridDiagram n} {G' : GridDiagram (n + 1)}
    (h : IsOStabilization G G') :
    ∃ s : Fin n, CommutationMovesTo G' (G.stabilizeX s.castSucc (G.X s).castSucc s) ∨
      CommutationMovesTo G' (G.stabilizeX s.succ (G.X s).succ s) := by
  obtain ⟨c, r, s, hc, hr, rfl⟩ := (isOStabilization_iff G G').mp h
  refine ⟨s, ?_⟩
  -- First move the new column next to the split column.
  rcases commutationMovesTo_of_succAbove_adjacent (fun c ↦ G.stabilizeO c r s)
    (by simpa only [stabilizeO_last_relabelColumns] using
      commutationMovesTo_relabelColumns_finRotate (G.stabilizeO (Fin.last n) r s)) hc
    with hc | hc
  · -- The new column is just before the split column: move the new row next to the split
    -- marking.
    rw [stabilizeO_castSucc_eq_stabilizeX_succ] at hc
    rcases commutationMovesTo_of_succAbove_adjacent (fun t ↦ G.stabilizeX s.succ t s)
      (G.commutationMovesTo_stabilizeX_last_zero s _) hr with hr | hr
    · have hslide := G.commutationMovesTo_stabilizeO_castSucc_stabilizeX_succ s
      rw [stabilizeO_castSucc_eq_stabilizeX_succ] at hslide
      exact .inr (hc.trans (hr.trans hslide))
    · exact .inl (hc.trans (hr.trans (G.commutationMovesTo_stabilizeX_succ_O_succ s)))
  · rw [stabilizeO_succ_eq_stabilizeX_castSucc] at hc
    exact .inl (hc.trans (G.commutationMovesTo_stabilizeX_castSucc s _ _))

/-- **Every stabilization reduces to one of two corner types.** If `G'` is an elementary
stabilization of `G`, then for some column `s` of `G`, cyclic permutations and commutations
connect `G'` to the `X`-stabilization of column `s` whose new `O`-marking is the south-west
corner of the new block, or to the one whose new `O`-marking is its north-east corner. -/
theorem IsStabilization.exists_commutationMovesTo {G : GridDiagram n} {G' : GridDiagram (n + 1)}
    (h : IsStabilization G G') :
    ∃ s : Fin n, CommutationMovesTo G' (G.stabilizeX s.castSucc (G.X s).castSucc s) ∨
      CommutationMovesTo G' (G.stabilizeX s.succ (G.X s).succ s) :=
  ((isStabilization_iff G G').mp h).elim IsOStabilization.exists_commutationMovesTo
    IsXStabilization.exists_commutationMovesTo

/-- **Invariance under stabilization from two corner types.** A function on grid diagrams that is
invariant under cyclic permutations, commutations, and the two corner `X`-stabilizations of
`GridDiagram.IsStabilization.exists_commutationMovesTo` is invariant under every elementary
stabilization. -/
theorem IsStabilization.apply_eq_apply {α : Sort*} (f : ∀ n, GridDiagram n → α)
    (hrows : ∀ {n} (G : GridDiagram n), f n G = f n (G.relabelRows (finRotate n)))
    (hcolumns : ∀ {n} (G : GridDiagram n), f n G = f n (G.relabelColumns (finRotate n)))
    (hcomm : ∀ {n} {G G' : GridDiagram n}, IsCommutation G G' → f n G = f n G')
    (hcastSucc : ∀ {n} (G : GridDiagram n) (s : Fin n),
      f n G = f (n + 1) (G.stabilizeX s.castSucc (G.X s).castSucc s))
    (hsucc : ∀ {n} (G : GridDiagram n) (s : Fin n),
      f n G = f (n + 1) (G.stabilizeX s.succ (G.X s).succ s))
    {G : GridDiagram n} {G' : GridDiagram (n + 1)} (h : IsStabilization G G') :
    f n G = f (n + 1) G' := by
  obtain ⟨s, hs | hs⟩ := h.exists_commutationMovesTo
  · rw [hcastSucc G s, hs.apply_eq (f (n + 1)) hrows hcolumns hcomm]
  · rw [hsucc G s, hs.apply_eq (f (n + 1)) hrows hcolumns hcomm]

end GridDiagram

end TauCeti
