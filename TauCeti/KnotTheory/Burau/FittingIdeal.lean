module

public import TauCeti.KnotTheory.Burau.Alexander
public import TauCeti.RingTheory.FittingIdeal.CornerMinor

/-!
# The Fitting ideals of the Burau presentation

For a braid `b` on `n + 1` strands, the matrix `burau b - 1` is annihilated on the right by the
all-ones vector and on the left by the geometric vector `(1, t, …, t ^ n)`, whose last coordinates
are the units `1` and `t ^ n`. The general results of
`TauCeti/RingTheory/FittingIdeal/CornerMinor.lean` therefore apply: the ideal of `n × n` minors of
`burau b - 1` is the principal ideal generated by its corner minor, which is
`TauCeti.MarkovBraid.burauAlexander`, and so is the first Fitting ideal of the cokernel of
`burau b - 1`.

Since `TauCeti.MarkovEquiv.associated_burauAlexander` shows that `burauAlexander` changes only by
a unit under Markov moves, this ideal depends only on the Markov class of the braid. Classically,
over `ℤ[T;T⁻¹]` at `t = T` the cokernel of `burau b - 1` is the Alexander module of the closure of
`b` (Birman, Theorem 3.11); combined with that identification, which is not part of this file, the
first elementary ideal of a braid closure is the principal ideal generated by `burauAlexander`.

## Main results

* `TauCeti.KnotTheory.minorsIdeal_range_burau_sub_one`: the `n × n` minors of `burau b - 1`
  generate the principal ideal of `burauAlexander`.
* `TauCeti.KnotTheory.fittingIdeal_coker_burau_sub_one_one`: `Fitt₁` of the cokernel of
  `burau b - 1` is generated by `burauAlexander`.
* `TauCeti.KnotTheory.fittingIdeal_coker_burau_sigma_pow_three_sub_one_one`: for the trefoil braid
  `σ₀ ^ 3` this ideal is `(t ^ 2 - t + 1)`.

## References

* J. Birman, *Braids, Links, and Mapping Class Groups*, Annals of Mathematics Studies 82 (1974),
  Theorem 3.11 (the Alexander polynomial of a braid closure from the Burau matrix).
* R. H. Crowell, R. H. Fox, *Introduction to Knot Theory*, Ginn (1963), Chapter VII.
-/

public section

noncomputable section

open Matrix

namespace TauCeti.KnotTheory

variable {R : Type*} [CommRing R] {n : ℕ}

/-- The last coordinate of the geometric vector `(1, t, …, t ^ n)` is a unit. -/
private theorem isUnit_geom_last (t : Rˣ) :
    IsUnit ((fun k : Fin (n + 1) => (t : R) ^ (k : ℕ)) (Fin.last n)) := by
  simpa using t.isUnit.pow n

/-- **The codimension-one minors of the Burau presentation.** For a braid `b` on `n + 1` strands,
the `n × n` minors of `burau b - 1` generate the principal ideal of the Burau-Alexander
polynomial. -/
theorem minorsIdeal_range_burau_sub_one (t : Rˣ) (b : BraidGroup (n + 1)) :
    (LinearMap.range ((burau (n + 1) t b : Matrix (Fin (n + 1)) (Fin (n + 1)) R) -
        1).mulVecLin).minorsIdeal n =
      Ideal.span {MarkovBraid.burauAlexander ⟨n, b⟩ t} := by
  rw [MarkovBraid.burauAlexander_def]
  exact minorsIdeal_range_mulVecLin_eq_span_det_submatrix_castSucc _
    (burau_sub_one_mulVec_one t b) (geom_vecMul_burau_sub_one t b) (by simp)
    (isUnit_geom_last t)

/-- **The first Fitting ideal of the Burau presentation is generated by the Burau-Alexander
polynomial.** For a braid `b` on `n + 1` strands, `Fitt₁` of the cokernel of `burau b - 1` is the
principal ideal of `TauCeti.MarkovBraid.burauAlexander`. -/
theorem fittingIdeal_coker_burau_sub_one_one (t : Rˣ) (b : BraidGroup (n + 1)) :
    fittingIdeal R ((Fin (n + 1) → R) ⧸
        LinearMap.range ((burau (n + 1) t b : Matrix (Fin (n + 1)) (Fin (n + 1)) R) -
          1).mulVecLin) 1 =
      Ideal.span {MarkovBraid.burauAlexander ⟨n, b⟩ t} := by
  rw [MarkovBraid.burauAlexander_def]
  exact fittingIdeal_coker_one_eq_span_det_submatrix_castSucc _ (burau_sub_one_mulVec_one t b)
    (geom_vecMul_burau_sub_one t b) (by simp) (isUnit_geom_last t)

/-- **The first Fitting ideal of the trefoil braid.** For the braid `σ₀ ^ 3` on two strands, whose
closure is the right-handed trefoil, `Fitt₁` of the cokernel of `burau b - 1` is generated by
`t ^ 2 - t + 1`, the trefoil's Alexander polynomial up to the unit `t`. -/
theorem fittingIdeal_coker_burau_sigma_pow_three_sub_one_one (t : Rˣ) :
    fittingIdeal R ((Fin 2 → R) ⧸
        LinearMap.range ((burau 2 t (BraidGroup.sigma 0 ^ 3) : Matrix (Fin 2) (Fin 2) R) -
          1).mulVecLin) 1 =
      Ideal.span {(t : R) ^ 2 - t + 1} := by
  rw [fittingIdeal_coker_burau_sub_one_one, MarkovBraid.burauAlexander_sigma_pow_three,
    Ideal.span_singleton_mul_left_unit (by simp)]

end TauCeti.KnotTheory
