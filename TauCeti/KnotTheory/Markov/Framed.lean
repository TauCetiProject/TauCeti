module

public import TauCeti.KnotTheory.Markov.Components

/-!
# Framing-preserving Markov equivalence

Framed braid closures carry an integer coefficient on each component relative to the Seifert
framing. Conjugation and either stabilization transport these coefficients along their canonical
component bijections. The equivalence generated by these operations therefore preserves the
coefficient of every corresponding component, even when the number of strands changes.

Every ordinary Markov equivalence lifts starting from any framing of its initial braid. This
provides the forgetful map between the framed and unframed equivalence relations. Conversely,
forgetting framing can identify inequivalent framed presentations: different constant coefficients
on the same underlying braid are distinguished by the component transport theorem.

These are combinatorial equivalence relations on braid presentations. No equivalence with
geometric framed isotopy is asserted here. The coefficients are Seifert-relative; ordinary
stabilization changes the blackboard writhe but preserves these coefficients.

## References

* J. Birman, *Braids, Links, and Mapping Class Groups*, Theorem 2.3 (ordinary Markov moves).
* R. Gompf and A. Stipsicz, *4-Manifolds and Kirby Calculus*, Section 4.5 (integer framings
  relative to the Seifert framing).

The component transport maps are those of `TauCeti.KnotTheory.Markov.Components`.
-/

public section

namespace TauCeti

/-- Markov moves carrying the Seifert-relative framing of each component along its canonical
bijection. As for `IsMarkovMove`, each generator points towards the unstabilized or unconjugated
presentation; the generated equivalence allows both directions. -/
inductive IsFramedMarkovMove : FramedMarkovBraid → FramedMarkovBraid → Prop
  /-- Conjugation with its induced transport of component coefficients. -/
  | conj (β : FramedMarkovBraid)
      (c : BraidGroup (β.forgetFraming.predStrands + 1)) : IsFramedMarkovMove (β.conj c) β
  /-- Positive stabilization, retaining each component's Seifert-relative coefficient. -/
  | stabilize (β : FramedMarkovBraid) : IsFramedMarkovMove β.stabilize β
  /-- Negative stabilization, retaining each component's Seifert-relative coefficient. -/
  | stabilizeInv (β : FramedMarkovBraid) : IsFramedMarkovMove β.stabilizeInv β

/-- Framing-preserving Markov equivalence, generated by conjugation and both stabilizations
with their canonical transport of component coefficients. -/
def FramedMarkovEquiv : FramedMarkovBraid → FramedMarkovBraid → Prop :=
  Relation.EqvGen IsFramedMarkovMove

namespace IsFramedMarkovMove

variable {β γ : FramedMarkovBraid}

/-- A framing-preserving move is an ordinary Markov move after forgetting its coefficients. -/
theorem forgetFraming (h : IsFramedMarkovMove β γ) :
    IsMarkovMove β.forgetFraming γ.forgetFraming := by
  cases h with
  | conj _ c => exact .conj γ.forgetFraming.braid c
  | stabilize _ => exact .stabilize γ.forgetFraming.braid
  | stabilizeInv _ => exact .stabilizeInv γ.forgetFraming.braid

/-- Each framed move supplies a bijection of components preserving their individual coefficients. -/
theorem exists_componentsEquiv (h : IsFramedMarkovMove β γ) :
    ∃ e : β.forgetFraming.Components ≃ γ.forgetFraming.Components,
      ∀ q, γ.framing (e q) = β.framing q := by
  cases h with
  | conj _ c =>
    exact ⟨(MarkovBraid.conjComponentsEquiv γ.forgetFraming.braid c).symm, fun _ => rfl⟩
  | stabilize _ =>
    exact ⟨(MarkovBraid.stabilizeComponentsEquiv γ.forgetFraming.braid).symm, fun _ => rfl⟩
  | stabilizeInv _ =>
    exact ⟨(MarkovBraid.stabilizeInvComponentsEquiv γ.forgetFraming.braid).symm, fun _ => rfl⟩

/-- A single framing-preserving move gives a framed Markov equivalence. -/
theorem framedMarkovEquiv (h : IsFramedMarkovMove β γ) : FramedMarkovEquiv β γ :=
  Relation.EqvGen.rel _ _ h

end IsFramedMarkovMove

namespace FramedMarkovEquiv

variable {β γ δ : FramedMarkovBraid}

/-- Framed Markov equivalence is an equivalence relation. -/
theorem equivalence : Equivalence FramedMarkovEquiv :=
  Relation.EqvGen.is_equivalence _

/-- Every framed braid presentation is equivalent to itself. -/
@[refl] theorem refl (β : FramedMarkovBraid) : FramedMarkovEquiv β β :=
  Relation.EqvGen.refl _

/-- Framed Markov equivalence is symmetric. -/
@[symm] theorem symm (h : FramedMarkovEquiv β γ) : FramedMarkovEquiv γ β :=
  Relation.EqvGen.symm _ _ h

/-- Framed Markov equivalences compose. -/
@[trans] theorem trans (h : FramedMarkovEquiv β γ) (h' : FramedMarkovEquiv γ δ) :
    FramedMarkovEquiv β δ := Relation.EqvGen.trans _ _ _ h h'

/-- Induction over framing-preserving Markov moves, their inverses, and finite composites. -/
theorem induction {motive : FramedMarkovBraid → FramedMarkovBraid → Prop}
    (move : ∀ {β γ}, IsFramedMarkovMove β γ → motive β γ)
    (refl : ∀ β, motive β β)
    (symm : ∀ {β γ}, FramedMarkovEquiv β γ → motive β γ → motive γ β)
    (trans : ∀ {β γ δ}, FramedMarkovEquiv β γ → FramedMarkovEquiv γ δ →
      motive β γ → motive γ δ → motive β δ)
    (h : FramedMarkovEquiv β γ) : motive β γ := by
  induction h with
  | rel _ _ h => exact move h
  | refl β => exact refl β
  | symm _ _ h ih => exact symm h ih
  | trans _ _ _ h h' ih ih' => exact trans h h' ih ih'

/-- Forgetting coefficients sends framed Markov equivalence to ordinary Markov equivalence. -/
theorem forgetFraming (h : FramedMarkovEquiv β γ) :
    MarkovEquiv β.forgetFraming γ.forgetFraming :=
  h.induction (fun h => h.forgetFraming.markovEquiv) (fun _ => .refl _)
    (fun _ ih => ih.symm) (fun _ _ ih ih' => ih.trans ih')

/-- Framed Markov equivalence preserves every component coefficient under a bijection of
components. The bijection may depend on the sequence of moves; no canonical one is asserted. -/
theorem exists_componentsEquiv (h : FramedMarkovEquiv β γ) :
    ∃ e : β.forgetFraming.Components ≃ γ.forgetFraming.Components,
      ∀ q, γ.framing (e q) = β.framing q := by
  refine h.induction IsFramedMarkovMove.exists_componentsEquiv
    (fun β => ⟨Equiv.refl _, fun _ => rfl⟩) ?_ ?_
  · rintro β γ _ ⟨e, he⟩
    exact ⟨e.symm, fun q => by simpa using (he (e.symm q)).symm⟩
  · rintro β γ δ _ _ ⟨e, he⟩ ⟨d, hd⟩
    exact ⟨e.trans d, fun q => (hd (e q)).trans (he q)⟩

end FramedMarkovEquiv

namespace MarkovEquiv

/-- A Markov equivalence transports every possible framing by one component bijection.
Keeping this bijection in the induction permits reversing the transport as well as composing it. -/
private theorem exists_framingTransport {β γ : MarkovBraid} (h : MarkovEquiv β γ) :
    ∃ e : β.Components ≃ γ.Components, ∀ a : β.Components → ℤ,
      FramedMarkovEquiv ⟨β, a⟩ ⟨γ, a ∘ e.symm⟩ := by
  refine h.induction (motive := fun β γ =>
    ∃ e : β.Components ≃ γ.Components, ∀ a : β.Components → ℤ,
      FramedMarkovEquiv ⟨β, a⟩ ⟨γ, a ∘ e.symm⟩)
    ?_ (fun β => ⟨Equiv.refl _, fun _ => .refl _⟩) ?_ ?_
  · intro β γ hmove
    cases hmove with
    | conj b c =>
      let e := MarkovBraid.conjComponentsEquiv b c
      refine ⟨e.symm, fun a => ?_⟩
      have heq : (FramedMarkovBraid.conj ⟨_, a ∘ e⟩ c) = ⟨_, a⟩ := by
        simp [FramedMarkovBraid.conj, Function.comp_def, e]
      rw [← heq]
      exact (IsFramedMarkovMove.conj ⟨⟨_, b⟩, a ∘ e⟩ c).framedMarkovEquiv
    | stabilize b =>
      let e := MarkovBraid.stabilizeComponentsEquiv b
      refine ⟨e.symm, fun a => ?_⟩
      have heq : (FramedMarkovBraid.stabilize ⟨_, a ∘ e⟩) = ⟨_, a⟩ := by
        simp [FramedMarkovBraid.stabilize, Function.comp_def, e]
      rw [← heq]
      exact (IsFramedMarkovMove.stabilize ⟨⟨_, b⟩, a ∘ e⟩).framedMarkovEquiv
    | stabilizeInv b =>
      let e := MarkovBraid.stabilizeInvComponentsEquiv b
      refine ⟨e.symm, fun a => ?_⟩
      have heq : (FramedMarkovBraid.stabilizeInv ⟨_, a ∘ e⟩) = ⟨_, a⟩ := by
        simp [FramedMarkovBraid.stabilizeInv, Function.comp_def, e]
      rw [← heq]
      exact (IsFramedMarkovMove.stabilizeInv ⟨⟨_, b⟩, a ∘ e⟩).framedMarkovEquiv
  · rintro β γ _ ⟨e, he⟩
    refine ⟨e.symm, fun a => ?_⟩
    have h := (he (a ∘ e)).symm
    simpa [Function.comp_def] using h
  · rintro β γ δ _ _ ⟨e, he⟩ ⟨d, hd⟩
    exact ⟨e.trans d, fun a => (he a).trans (hd (a ∘ e.symm))⟩

/-- Every ordinary Markov equivalence lifts from any given framing of its initial braid.
The terminal framing is transported along the moves, rather than chosen independently. -/
theorem exists_framedMarkovEquiv {β γ : MarkovBraid} (h : MarkovEquiv β γ)
    (a : β.Components → ℤ) :
    ∃ b : γ.Components → ℤ, FramedMarkovEquiv ⟨β, a⟩ ⟨γ, b⟩ := by
  obtain ⟨e, he⟩ := h.exists_framingTransport
  exact ⟨a ∘ e.symm, he a⟩

end MarkovEquiv

/-- An ordinary target braid is Markov equivalent to the underlying braid of a framed
presentation exactly when some framing of that target is framed Markov equivalent to it. -/
theorem markovEquiv_iff_exists_framedMarkovEquiv (β : FramedMarkovBraid) (γ : MarkovBraid) :
    MarkovEquiv β.forgetFraming γ ↔
      ∃ b : γ.Components → ℤ, FramedMarkovEquiv β ⟨γ, b⟩ := by
  constructor
  · intro h
    exact h.exists_framedMarkovEquiv β.framing
  · rintro ⟨b, h⟩
    exact h.forgetFraming

/-- Changing a constant framing coefficient changes the framed Markov class, even on the same
underlying braid. In particular, forgetting framing identifies distinct framed classes. -/
theorem not_framedMarkovEquiv_const (β : MarkovBraid) {a b : ℤ} (hab : a ≠ b) :
    ¬ FramedMarkovEquiv ⟨β, fun _ => a⟩ ⟨β, fun _ => b⟩ := by
  intro h
  obtain ⟨e, he⟩ := h.exists_componentsEquiv
  exact hab (he (Quotient.mk _ (0 : Fin (β.predStrands + 1)))).symm

end TauCeti
