module

public import TauCeti.KnotTheory.BraidWord.ArtinEquivalence
public import TauCeti.KnotTheory.BraidWord.FreeCancellation.Basic

/-!
# Completeness of braid-word moves

Two braid words represent the same braid if and only if they are connected by Artin relations
and insertion or deletion of adjacent inverse letters. This is the algebraic input to comparing
closures of arbitrary words representing a fixed braid: a closure invariant need only respect
these elementary moves.

## References

* J. Birman, *Braids, Links, and Mapping Class Groups*, Annals of Mathematics Studies 82 (1974),
  Chapter 1 (the Artin presentation).
-/

public section

namespace TauCeti.BraidWord

open BraidGroup

variable {n : ℕ} {w w' w'' : BraidWord n}

/-- The equivalence relation on braid words generated by Artin relations and free cancellation.
Each elementary step already includes its surrounding word. -/
def WordEquiv : BraidWord n → BraidWord n → Prop :=
  Relation.EqvGen fun u v => ArtinStep u v ∨ FreeCancelStep u v

namespace WordEquiv

/-- Braid-word equivalence is an equivalence relation. -/
theorem equivalence : Equivalence (WordEquiv (n := n)) :=
  Relation.EqvGen.is_equivalence _

/-- Braid-word equivalence is reflexive. -/
@[refl]
theorem refl (w : BraidWord n) : WordEquiv w w := Relation.EqvGen.refl w

/-- Braid-word equivalence is symmetric. -/
@[symm]
theorem symm (h : WordEquiv w w') : WordEquiv w' w := Relation.EqvGen.symm _ _ h

/-- Braid-word equivalence is transitive. -/
@[trans]
theorem trans (h : WordEquiv w w') (h' : WordEquiv w' w'') : WordEquiv w w'' :=
  Relation.EqvGen.trans _ _ _ h h'

/-- An Artin step is a braid-word equivalence. -/
theorem of_artinStep (h : ArtinStep w w') : WordEquiv w w' :=
  Relation.EqvGen.rel _ _ (Or.inl h)

/-- A free insertion or deletion is a braid-word equivalence. -/
theorem of_freeCancelStep (h : FreeCancelStep w w') : WordEquiv w w' :=
  Relation.EqvGen.rel _ _ (Or.inr h)

/-- Induct over a sequence of Artin relations and free insertions or deletions. -/
theorem induction {motive : BraidWord n → BraidWord n → Prop}
    (artin : ∀ {u v}, ArtinStep u v → motive u v)
    (cancel : ∀ {u v}, FreeCancelStep u v → motive u v)
    (refl : ∀ u, motive u u)
    (symm : ∀ {u v}, WordEquiv u v → motive u v → motive v u)
    (trans : ∀ {u v z}, WordEquiv u v → WordEquiv v z →
      motive u v → motive v z → motive u z)
    (h : WordEquiv w w') : motive w w' := by
  induction h with
  | rel _ _ h => exact h.elim artin cancel
  | refl u => exact refl u
  | symm _ _ h ih => exact symm h ih
  | trans _ _ _ h h' ih ih' => exact trans h h' ih ih'

/-- Artin equivalence embeds into braid-word equivalence. -/
theorem of_artinEquiv (h : ArtinEquiv w w') : WordEquiv w w' :=
  ArtinEquiv.induction of_artinStep (fun _ => refl _) (fun _ ih => ih.symm)
    (fun _ _ ih ih' => ih.trans ih') h

/-- Free-cancellation equivalence embeds into braid-word equivalence. -/
theorem of_freeCancelEquiv (h : FreeCancelEquiv w w') : WordEquiv w w' :=
  FreeCancelEquiv.induction of_freeCancelStep (fun _ => refl _) (fun _ ih => ih.symm)
    (fun _ _ ih ih' => ih.trans ih') h

/-- A common prefix preserves braid-word equivalence. -/
theorem append_left (pre : BraidWord n) (h : WordEquiv w w') :
    WordEquiv (pre ++ w) (pre ++ w') := by
  refine h.induction (motive := fun u v => WordEquiv (pre ++ u) (pre ++ v))
    ?_ ?_ (fun _ => refl _) (fun _ ih => ih.symm) (fun _ _ ih ih' => ih.trans ih')
  · intro u v h
    exact of_artinEquiv ((ArtinEquiv.of_step h).append_left pre)
  · intro u v h
    exact of_freeCancelEquiv ((FreeCancelEquiv.of_step h).append_left pre)

/-- Prepending a common letter preserves braid-word equivalence. -/
theorem cons (a : Fin (n - 1) × ℤˣ) (h : WordEquiv w w') :
    WordEquiv (a :: w) (a :: w') := by
  simpa only [List.singleton_append] using h.append_left [a]

/-- A common suffix preserves braid-word equivalence. -/
theorem append_right (h : WordEquiv w w') (suf : BraidWord n) :
    WordEquiv (w ++ suf) (w' ++ suf) := by
  refine h.induction (motive := fun u v => WordEquiv (u ++ suf) (v ++ suf))
    ?_ ?_ (fun _ => refl _) (fun _ ih => ih.symm) (fun _ _ ih ih' => ih.trans ih')
  · intro u v h
    exact of_artinEquiv ((ArtinEquiv.of_step h).append_right suf)
  · intro u v h
    exact of_freeCancelEquiv ((FreeCancelEquiv.of_step h).append_right suf)

/-- Concatenating equivalent braid words preserves equivalence. -/
theorem append {u u' : BraidWord n} (hu : WordEquiv u u') (h : WordEquiv w w') :
    WordEquiv (u ++ w) (u' ++ w') :=
  (hu.append_right w).trans (h.append_left u')

/-- Equivalent braid words represent the same braid. -/
theorem toBraid_eq (h : WordEquiv w w') : toBraid w = toBraid w' :=
  h.induction toBraid_eq_of_artinStep toBraid_freeCancel (fun _ => rfl)
    (fun _ ih => ih.symm) (fun _ _ ih ih' => ih.trans ih')

end WordEquiv

/-- The equivalence relation generated by Artin moves and free cancellation. -/
private def wordSetoid (n : ℕ) : Setoid (BraidWord n) :=
  Relation.EqvGen.setoid fun u v => ArtinStep u v ∨ FreeCancelStep u v

/-- Braid words modulo Artin moves and free cancellation. -/
private abbrev WordClasses (n : ℕ) := Quotient (wordSetoid n)

/-- Prepending a letter followed by its inverse leaves the word class unchanged. -/
private theorem cons_cons_inv (i : Fin (n - 1)) (ε : ℤˣ) (u : BraidWord n) :
    WordEquiv ((i, ε) :: (i, -ε) :: u) u := by
  simpa only [List.nil_append, List.cons_append] using
    WordEquiv.of_freeCancelStep (FreeCancelStep.delete [] u i ε)

/-- Prepending a letter permutes word classes: prepending its opposite letter is the inverse,
since the two adjacent letters cancel freely. -/
private def letterPerm (a : Fin (n - 1) × ℤˣ) : Equiv.Perm (WordClasses n) where
  toFun := Quotient.map' (s₁ := wordSetoid n) (s₂ := wordSetoid n) (List.cons a) fun _ _ h => by
    -- Identify the private setoid relation with `WordEquiv` to use its congruence API.
    change WordEquiv _ _ at h ⊢
    exact h.cons a
  invFun := Quotient.map' (s₁ := wordSetoid n) (s₂ := wordSetoid n)
    (List.cons (a.1, -a.2)) fun _ _ h => by
    -- The standard equivalence-closure setoid uses the same relation as `WordEquiv`.
    change WordEquiv _ _ at h ⊢
    exact h.cons (a.1, -a.2)
  left_inv x := Quotient.inductionOn x fun u => Quotient.sound (by
    -- Expose the equivalence closure so adjacent inverse-letter cancellation applies.
    change WordEquiv _ _
    simpa only [neg_neg, Prod.mk.eta] using cons_cons_inv a.1 (-a.2) u)
  right_inv x := Quotient.inductionOn x fun u => Quotient.sound (by
    -- Expose the same equivalence closure for cancellation in the opposite order.
    change WordEquiv _ _
    simpa only [Prod.mk.eta] using cons_cons_inv a.1 a.2 u)

private theorem letterPerm_apply (a : Fin (n - 1) × ℤˣ) (u : BraidWord n) :
    letterPerm a (Quotient.mk (wordSetoid n) u) = Quotient.mk (wordSetoid n) (a :: u) := by
  -- Unfold the permutation application and `Quotient.map'` on its constructor.
  rfl

private theorem letterPerm_inv_apply (a : Fin (n - 1) × ℤˣ) (u : BraidWord n) :
    (letterPerm a)⁻¹ (Quotient.mk (wordSetoid n) u) =
      Quotient.mk (wordSetoid n) ((a.1, -a.2) :: u) := by
  -- `Equiv.Perm` inversion is `Equiv.symm`; its `invFun` is the inverse quotient map.
  rfl

private theorem letterPerm_sign (i : Fin (n - 1)) (ε : ℤˣ) :
    letterPerm (i, 1) ^ (ε : ℤ) = letterPerm (i, ε) := by
  rcases Int.units_eq_one_or ε with rfl | rfl
  · simp
  · simp only [Units.val_neg, Units.val_one, zpow_neg, zpow_one]
    ext x
    induction x using Quotient.inductionOn with
    | _ u => simp only [letterPerm_inv_apply, letterPerm_apply]

/-- The braid-group action on word classes induced by prepending generators. The Artin
relations hold on the quotient, and acting on the empty word recovers the class of a word. -/
private def wordAction (n : ℕ) : BraidGroup n →* Equiv.Perm (WordClasses n) :=
  BraidGroup.lift (fun i => letterPerm (i, 1))
    (fun {i j} h => by
      ext x
      induction x using Quotient.inductionOn with
      | _ u =>
        simp only [Equiv.Perm.mul_apply, letterPerm_apply]
        apply Quotient.sound
        exact WordEquiv.of_artinStep (ArtinStep.commute [] u h))
    (fun {i j} h => by
      ext x
      induction x using Quotient.inductionOn with
      | _ u =>
        simp only [Equiv.Perm.mul_apply, letterPerm_apply]
        apply Quotient.sound
        rcases h with h | h
        · exact WordEquiv.of_artinStep (ArtinStep.braid [] u 1 h.symm)
        · exact (WordEquiv.of_artinStep (ArtinStep.braid [] u 1 h.symm)).symm)

private theorem wordAction_sigma (i : Fin (n - 1)) :
    wordAction n (sigma i) = letterPerm (i, 1) := by
  simp only [wordAction, lift_sigma]

private theorem wordAction_toBraid (u v : BraidWord n) :
    wordAction n (toBraid u) (Quotient.mk (wordSetoid n) v) =
      Quotient.mk (wordSetoid n) (u ++ v) := by
  induction u with
  | nil => simp
  | cons a u ih =>
    simp only [toBraid_cons, map_mul, map_zpow, wordAction_sigma,
      letterPerm_sign, Equiv.Perm.mul_apply]
    rw [ih, letterPerm_apply]
    simp only [List.cons_append, Prod.mk.eta]

/-- **Completeness of the Artin word moves:** two braid words represent the same braid exactly
when Artin relations and free insertions or deletions connect them. -/
theorem toBraid_eq_iff_wordEquiv : toBraid w = toBraid w' ↔ WordEquiv w w' := by
  constructor
  · intro h
    have heq := congrArg (fun b => wordAction n b (Quotient.mk (wordSetoid n) [])) h
    simp only [wordAction_toBraid, List.append_nil] at heq
    exact Quotient.exact heq
  · exact WordEquiv.toBraid_eq

end TauCeti.BraidWord
