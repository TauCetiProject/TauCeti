module

public import Mathlib.Logic.Relation
public import TauCeti.KnotTheory.Alexander

/-!
# S-equivalence of integral square matrices

Two integral square matrices are S-equivalent when they are connected by unimodular congruences
and elementary enlargements or their inverses. Since an enlargement changes the size by two, the
relation is defined on the dependent sum of matrices of all finite sizes.

This is the ambient algebraic equivalence relation. Its carrier is intentionally not called
`SeifertMatrix`: an actual Seifert matrix must satisfy an additional unimodularity condition. The
development does not assert that a matrix is realised by a Seifert surface, nor the geometric
theorem that Seifert matrices of isotopic knots are S-equivalent.

## Main definitions

* `TauCeti.KnotTheory.IntegralSquareMatrix`: integral square matrices of arbitrary finite size.
* `TauCeti.KnotTheory.IntegralSquareMatrix.IsMove`: unimodular congruence and the two elementary
  enlargements.
* `TauCeti.KnotTheory.IntegralSquareMatrix.SEquivalent`: the equivalence relation generated by
  those moves.

## References

* W. B. R. Lickorish, *An Introduction to Knot Theory*, Springer GTM 175 (1997), Chapter 8.

This supplies the algebraic relation needed for the Tristram--Levine signature in Layer 6 of the
GeometricTopology roadmap to descend from a chosen Seifert matrix.
-/

public section

open Matrix

namespace TauCeti.KnotTheory

variable {R S : Type*} [CommRing R] [CommRing S]
variable {ι : Type*} {n : ℕ}

/-- A column enlargement, reindexed onto the canonical finite type of the enlarged size. -/
def enlargeColumnFin (V : Matrix (Fin n) (Fin n) R) (xi : Fin n → R) :
    Matrix (Fin (n + 2)) (Fin (n + 2)) R :=
  (enlargeColumn V xi).submatrix finSumFinEquiv.symm finSumFinEquiv.symm

/-- A canonical column enlargement is the ordinary enlargement reindexed by
`finSumFinEquiv`. -/
theorem enlargeColumnFin_eq (V : Matrix (Fin n) (Fin n) R) (xi : Fin n → R) :
    enlargeColumnFin V xi =
      (enlargeColumn V xi).submatrix finSumFinEquiv.symm finSumFinEquiv.symm :=
  (rfl)

/-- A row enlargement, reindexed onto the canonical finite type of the enlarged size. -/
def enlargeRowFin (V : Matrix (Fin n) (Fin n) R) (eta : Fin n → R) :
    Matrix (Fin (n + 2)) (Fin (n + 2)) R :=
  (enlargeRow V eta).submatrix finSumFinEquiv.symm finSumFinEquiv.symm

/-- A canonical row enlargement is the ordinary enlargement reindexed by
`finSumFinEquiv`. -/
theorem enlargeRowFin_eq (V : Matrix (Fin n) (Fin n) R) (eta : Fin n → R) :
    enlargeRowFin V eta =
      (enlargeRow V eta).submatrix finSumFinEquiv.symm finSumFinEquiv.symm :=
  (rfl)

/-- Ring homomorphisms commute with column enlargement. -/
theorem map_enlargeColumn (f : R →+* S) (V : Matrix ι ι R) (xi : ι → R) :
    (enlargeColumn V xi).map f = enlargeColumn (V.map f) (f ∘ xi) := by
  ext (i | i) (j | j)
  · simp
  · fin_cases j <;> simp [Function.comp_apply]
  · fin_cases i <;> simp
  · fin_cases i <;> fin_cases j <;> simp

/-- Ring homomorphisms commute with row enlargement. -/
theorem map_enlargeRow (f : R →+* S) (V : Matrix ι ι R) (eta : ι → R) :
    (enlargeRow V eta).map f = enlargeRow (V.map f) (f ∘ eta) := by
  rw [enlargeRow_def, enlargeRow_def, transpose_map, map_enlargeColumn, transpose_map]

/-- Ring homomorphisms commute with canonically reindexed column enlargement. -/
theorem map_enlargeColumnFin (f : R →+* S) (V : Matrix (Fin n) (Fin n) R)
    (xi : Fin n → R) :
    (enlargeColumnFin V xi).map f = enlargeColumnFin (V.map f) (f ∘ xi) := by
  rw [enlargeColumnFin, enlargeColumnFin, ← submatrix_map, map_enlargeColumn]

/-- Ring homomorphisms commute with canonically reindexed row enlargement. -/
theorem map_enlargeRowFin (f : R →+* S) (V : Matrix (Fin n) (Fin n) R)
    (eta : Fin n → R) :
    (enlargeRowFin V eta).map f = enlargeRowFin (V.map f) (f ∘ eta) := by
  rw [enlargeRowFin, enlargeRowFin, ← submatrix_map, map_enlargeRow]

/-- An integral square matrix of unspecified finite size. -/
abbrev IntegralSquareMatrix := Σ n : ℕ, Matrix (Fin n) (Fin n) ℤ

namespace IntegralSquareMatrix

/-- One elementary S-equivalence move: a unimodular congruence or one of the two elementary
enlargements. Inverses are supplied by the equivalence closure `SEquivalent`. -/
inductive IsMove : IntegralSquareMatrix → IntegralSquareMatrix → Prop
  | congr {n : ℕ} (V P : Matrix (Fin n) (Fin n) ℤ) (hP : IsUnit P.det) :
      IsMove ⟨n, V⟩ ⟨n, P * V * Pᵀ⟩
  | enlargeColumn {n : ℕ} (V : Matrix (Fin n) (Fin n) ℤ) (xi : Fin n → ℤ) :
      IsMove ⟨n, V⟩ ⟨n + 2, enlargeColumnFin V xi⟩
  | enlargeRow {n : ℕ} (V : Matrix (Fin n) (Fin n) ℤ) (eta : Fin n → ℤ) :
      IsMove ⟨n, V⟩ ⟨n + 2, enlargeRowFin V eta⟩

/-- S-equivalence is the equivalence relation generated by unimodular congruence and elementary
row and column enlargements. -/
def SEquivalent : IntegralSquareMatrix → IntegralSquareMatrix → Prop := Relation.EqvGen IsMove

namespace SEquivalent

/-- S-equivalence is an equivalence relation. -/
theorem equivalence : Equivalence SEquivalent :=
  Relation.EqvGen.is_equivalence IsMove

/-- Every integral square matrix is S-equivalent to itself. -/
@[refl]
theorem refl (V : IntegralSquareMatrix) : SEquivalent V V := Relation.EqvGen.refl V

/-- S-equivalence is symmetric. -/
@[symm]
theorem symm {V W : IntegralSquareMatrix} (h : SEquivalent V W) : SEquivalent W V :=
  Relation.EqvGen.symm _ _ h

/-- S-equivalences compose. -/
@[trans]
theorem trans {U V W : IntegralSquareMatrix} (hUV : SEquivalent U V) (hVW : SEquivalent V W) :
    SEquivalent U W :=
  Relation.EqvGen.trans _ _ _ hUV hVW

/-- Induction on S-equivalence. It is enough to check one elementary move and closure under
reflexivity, symmetry, and transitivity. -/
theorem induction {motive : IntegralSquareMatrix → IntegralSquareMatrix → Prop}
    (move : ∀ {V W : IntegralSquareMatrix}, IsMove V W → motive V W)
    (refl : ∀ V : IntegralSquareMatrix, motive V V)
    (symm : ∀ {V W : IntegralSquareMatrix}, SEquivalent V W → motive V W → motive W V)
    (trans : ∀ {U V W : IntegralSquareMatrix}, SEquivalent U V → SEquivalent V W →
      motive U V → motive V W → motive U W)
    {V W : IntegralSquareMatrix} (h : SEquivalent V W) : motive V W := by
  induction h with
  | rel _ _ hmove => exact move hmove
  | refl V => exact refl V
  | symm _ _ hVW ih => exact symm hVW ih
  | trans _ _ _ hUV hVW ihUV ihVW => exact trans hUV hVW ihUV ihVW

end SEquivalent

/-- One elementary S-equivalence move gives an S-equivalence. -/
theorem IsMove.sEquivalent {V W : IntegralSquareMatrix} (h : IsMove V W) : SEquivalent V W :=
  Relation.EqvGen.rel _ _ h

/-- A unimodular congruence is an S-equivalence. -/
theorem sEquivalent_congr (V P : Matrix (Fin n) (Fin n) ℤ) (hP : IsUnit P.det) :
    SEquivalent ⟨n, V⟩ ⟨n, P * V * Pᵀ⟩ :=
  (IsMove.congr V P hP).sEquivalent

/-- A column enlargement is an S-equivalence. -/
theorem sEquivalent_enlargeColumn (V : Matrix (Fin n) (Fin n) ℤ) (xi : Fin n → ℤ) :
    SEquivalent ⟨n, V⟩ ⟨n + 2, enlargeColumnFin V xi⟩ :=
  (IsMove.enlargeColumn V xi).sEquivalent

/-- A row enlargement is an S-equivalence. -/
theorem sEquivalent_enlargeRow (V : Matrix (Fin n) (Fin n) ℤ) (eta : Fin n → ℤ) :
    SEquivalent ⟨n, V⟩ ⟨n + 2, enlargeRowFin V eta⟩ :=
  (IsMove.enlargeRow V eta).sEquivalent

end IntegralSquareMatrix

end TauCeti.KnotTheory
