module

public import TauCeti.KnotTheory.Alexander
public import TauCeti.RingTheory.FittingIdeal.Determinant

/-!
# The Fitting ideal of the Seifert Alexander presentation

The matrix `t V - Vᵀ` presents the reduced Alexander module when `V` is a Seifert matrix.
Its cokernel has zeroth Fitting ideal generated by `alexander V`. The Laurent monomial
used to normalize the determinant is a unit, so it does not change this ideal.

This is an algebraic statement about arbitrary square matrices. Identifying this cokernel
with the homology of an infinite cyclic cover is a separate geometric theorem.

## References

* W. B. R. Lickorish, *An Introduction to Knot Theory*, Springer GTM 175 (1997),
  Theorem 6.5 and Definition 6.6 (the Seifert presentation and Alexander polynomial).
-/

public section

noncomputable section

open LaurentPolynomial TauCeti TauCeti.KnotTheory

namespace Matrix

variable {R ι : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

/-- A square Seifert presentation has zeroth Fitting ideal generated by the normalized
Alexander polynomial. No even-size or unimodularity hypothesis is needed. -/
theorem fittingIdeal_zero_eq_span_alexander_of_ker_eq_range (V : Matrix ι ι R)
    {M : Type*} [AddCommGroup M] [Module R[T;T⁻¹] M] [Module.Finite R[T;T⁻¹] M]
    {π : (ι → R[T;T⁻¹]) →ₗ[R[T;T⁻¹]] M} (hπ : Function.Surjective π)
    (h : LinearMap.ker π = LinearMap.range (alexanderMatrix V).mulVecLin) :
    fittingIdeal R[T;T⁻¹] M 0 = Ideal.span {alexander V} := by
  rw [Matrix.fittingIdeal_zero_eq_span_det_of_ker_eq_range _ hπ h,
    ← V.span_alexander_eq_span_det_alexanderMatrix]

/-- The zeroth Fitting ideal of the cokernel of the Seifert Alexander matrix is generated
by the normalized Alexander polynomial. No even-size or unimodularity hypothesis is needed
for this ideal identity. -/
@[simp 1100]
theorem fittingIdeal_coker_alexanderMatrix_zero_eq_span_alexander (V : Matrix ι ι R) :
    fittingIdeal R[T;T⁻¹]
      ((ι → R[T;T⁻¹]) ⧸ LinearMap.range (alexanderMatrix V).mulVecLin) 0 =
        Ideal.span {alexander V} := by
  exact V.fittingIdeal_zero_eq_span_alexander_of_ker_eq_range
    (Submodule.mkQ_surjective _) (Submodule.ker_mkQ _)

end Matrix
