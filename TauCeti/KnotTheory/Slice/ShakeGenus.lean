noncomputable section

open CategoryTheory Limits AlgebraicTopology Manifold Metric Module Set
open scoped EuclideanSpace Manifold ContDiff

namespace TauCeti

attribute [local instance] Complex.finrank_real_complex_fact

variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [Fact (finrank ℝ E = 3 + 1)]

/-- A **`0`-shake surface** for a knot `K : S¹ → S³` in the unit sphere of the four-dimensional
space `E`: a compact, connected, orientable smooth surface `S` with boundary, smoothly and properly
embedded in the closed unit ball `D⁴`, together with a solid torus neighbourhood `Ψ` of `K` whose
longitude is null-homologous in the knot complement (the `0`-framing) and a finite set `C` of points
of the open disc, such that

* the embedding carries the boundary of `S` onto the parallel copies `Ψ ({c} × S¹)` of `K`,
  `c ∈ C`: the continuous map `boundaryMap : ∂S → D² × S¹` reads the boundary through `Ψ`, and its
  image is `C × S¹`;
* the classes of `H₁(∂S; ℤ)` vanishing in `H₁(S; ℤ)` are carried onto `H₁(S¹; ℤ)` by the projection
  of `∂S` to the core circle. Equivalently, the parallel copies, with their boundary orientations,
  sum to a generator of the homology of the solid torus.

Capping the copies by parallel cores of a `2`-handle attached along `K` with framing `0` turns `S`
into a closed surface of the same genus generating the second homology of the `0`-trace of `K`. -/
structure ZeroShakeSurface (K : SmoothCircleEmbedding (𝓡 3) (sphere (0 : E) 1)) where
  /-- The underlying surface. -/
  carrier : Type
  /-- The topology of the surface. -/
  [topologicalSpace : TopologicalSpace carrier]
  /-- The charts of the surface, modelled on the half-plane. -/
  [chartedSpace : ChartedSpace (EuclideanHalfSpace 2) carrier]
  /-- The surface is a smooth manifold with boundary. -/
  [isManifold : IsManifold (𝓡∂ 2) ∞ carrier]
  /-- The surface is compact. -/
  [compactSpace : CompactSpace carrier]
  /-- The surface is connected. -/
  [connectedSpace : ConnectedSpace carrier]
  /-- The surface is orientable. -/
  [orientable : Orientable (𝓡∂ 2) carrier]
  /-- The map of the surface into the closed unit ball. -/
  toFun : carrier → closedBall (0 : E) 1
  /-- The surface is smoothly embedded, as a manifold with boundary. -/
  isSmoothEmbedding : IsSmoothEmbedding (𝓡∂ 2) (𝓡∂ (3 + 1)) ∞ toFun
  /-- The surface is properly mapped: it meets the boundary sphere exactly along its boundary. -/
  preimage_boundary :
    toFun ⁻¹' (𝓡∂ (3 + 1)).boundary (closedBall (0 : E) 1) = (𝓡∂ 2).boundary carrier
  /-- The solid torus neighbourhood of the knot along which the copies are taken. -/
  solidTorus : SolidTorus → sphere (0 : E) 1
  /-- It is a solid torus neighbourhood of `K`. -/
  isSolidTorusNeighborhood : IsSolidTorusNeighborhood K solidTorus
  /-- The solid torus has the `0`-framing: its longitude is null-homologous in the complement. -/
  boundaryHomologyMap_longitude :
    isSolidTorusNeighborhood.boundaryHomologyMap
      (isSolidTorusNeighborhood.framedBoundaryTorus.basis 1) = 0
  /-- The points of the disc whose parallel copies of the knot bound the surface. -/
  parallels : Finset (closedBall (0 : ℂ) 1)
  /-- The parallel copies lie in the interior of the solid torus. -/
  norm_lt_one_of_mem_parallels {c : closedBall (0 : ℂ) 1} (hc : c ∈ parallels) : ‖(c : ℂ)‖ < 1
  /-- The boundary of the surface, read through the solid torus. -/
  boundaryMap : C((𝓡∂ 2).boundary carrier, SolidTorus)
  /-- The boundary of the surface lies on the solid torus as recorded by `boundaryMap`. -/
  solidTorus_boundaryMap (x : (𝓡∂ 2).boundary carrier) :
    (solidTorus (boundaryMap x) : E) = toFun x
  /-- The boundary of the surface is the union of the parallel copies `{c} × S¹`, `c ∈ C`. -/
  range_boundaryMap : range boundaryMap = (parallels : Set (closedBall (0 : ℂ) 1)) ×ˢ univ
  /-- The signed sum of the boundary circles generates the homology of the core circle. -/
  map_ker_eq_top :
    Submodule.map (ContinuousMap.singularHomologyMap ℤ 1 (ContinuousMap.snd.comp boundaryMap))
      (LinearMap.ker (ContinuousMap.singularHomologyMap ℤ 1
        (ContinuousMap.subtypeVal ((𝓡∂ 2).boundary carrier)))) = ⊤

namespace ZeroShakeSurface

attribute [instance] topologicalSpace chartedSpace isManifold compactSpace connectedSpace orientable

variable {K : SmoothCircleEmbedding (𝓡 3) (sphere (0 : E) 1)}

/-- The first singular homology `H₁(S; ℚ)` of a `0`-shake surface, with rational coefficients. -/
abbrev firstHomology (S : ZeroShakeSurface K) : Type :=
  ((singularHomologyFunctor (ModuleCat ℚ) 1).obj (ModuleCat.of ℚ ℚ)).obj (TopCat.of S.carrier)

/-- The **genus** of a `0`-shake surface: `(dim H₁(S; ℚ) + 1 - b) / 2`, `b` the number of parallel
copies of the knot bounding it. A compact, connected, orientable surface of genus `g` with `b`
boundary circles has `H₁(S; ℚ) ≅ ℚ²ᵍ⁺ᵇ⁻¹`, and the embedding identifies the boundary of `S` with
the `b` disjoint copies. -/
def genus (S : ZeroShakeSurface K) : ℕ :=
  (finrank ℚ S.firstHomology + 1 - S.parallels.card) / 2

/-- The genus of a `0`-shake surface in terms of its first rational homology and its number of
boundary circles. -/
theorem genus_def (S : ZeroShakeSurface K) :
    S.genus = (finrank ℚ S.firstHomology + 1 - S.parallels.card) / 2 :=
  (rfl)

/-- The solid torus neighbourhood of a `0`-shake surface has framing number `0`, for any proofs
that the first and second reduced integral homology of the sphere vanish. -/
theorem framingNumber_eq_zero (S : ZeroShakeSurface K)
    (h₁ : IsZero ((reducedSingularHomologyFunctor (ModuleCat.of ℤ ℤ) 1).obj
      (TopCat.of (sphere (0 : E) 1))))
    (h₂ : IsZero ((reducedSingularHomologyFunctor (ModuleCat.of ℤ ℤ) 2).obj
      (TopCat.of (sphere (0 : E) 1)))) :
    S.isSolidTorusNeighborhood.framingNumber h₁ h₂ = 0 := by
  rw [IsSolidTorusNeighborhood.framingNumber_eq_zero_iff, S.boundaryHomologyMap_longitude]

/-! ### Transport -/

variable {K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : E) 1)}

/-- Reparametrization of a `0`-shake surface along a homeomorphism `g` of the circle with
`K' = K ∘ g`: the same surface and copies, in the solid torus `(w, z) ↦ Ψ (w, g z)`. -/
private def reparam (S : ZeroShakeSurface K) (g : Circle ≃ₜ Circle) (hg : ⇑K' = K ∘ g) :
    ZeroShakeSurface K' where
  carrier := S.carrier
  toFun := S.toFun
  isSmoothEmbedding := S.isSmoothEmbedding
  preimage_boundary := S.preimage_boundary
  solidTorus := S.solidTorus ∘ Prod.map id g
  isSolidTorusNeighborhood := hg ▸ S.isSolidTorusNeighborhood.comp_prodMap g
  boundaryHomologyMap_longitude :=
    S.isSolidTorusNeighborhood.boundaryHomologyMap_basis_one_eq_zero_of_map _ g
      (ContinuousMap.inclusion
        (compl_subset_compl.2 (by rw [hg, range_comp]; exact image_subset_range _ _)))
      (fun _ q hx ↦ hx.trans (congrArg S.solidTorus (Prod.ext (Subtype.ext (by simp)) (by simp))))
      S.boundaryHomologyMap_longitude
  parallels := S.parallels
  norm_lt_one_of_mem_parallels := S.norm_lt_one_of_mem_parallels
  boundaryMap := ((ContinuousMap.id _).prodMap (g.symm : C(Circle, Circle))).comp S.boundaryMap
  solidTorus_boundaryMap x := by simpa [Prod.map] using S.solidTorus_boundaryMap x
  range_boundaryMap := by
    rw [ContinuousMap.coe_comp, range_comp, S.range_boundaryMap]
    ext ⟨c, z⟩
    simp [Prod.map, Homeomorph.symm_apply_eq]
  map_ker_eq_top := by
    have hmap : ContinuousMap.singularHomologyMap ℤ 1 (ContinuousMap.snd.comp
        (((ContinuousMap.id _).prodMap (g.symm : C(Circle, Circle))).comp S.boundaryMap)) =
        ContinuousMap.singularHomologyMap ℤ 1 (g.symm : C(Circle, Circle)) ∘ₗ
          ContinuousMap.singularHomologyMap ℤ 1 (ContinuousMap.snd.comp S.boundaryMap) :=
      -- Projecting after the reparametrization is reparametrizing the projection.
      LinearMap.ext (ContinuousMap.singularHomologyMap_comp (g.symm : C(Circle, Circle))
        (ContinuousMap.snd.comp S.boundaryMap))
    rw [hmap, Submodule.map_comp, S.map_ker_eq_top, Submodule.map_top, LinearMap.range_eq_top]
    exact (ContinuousMap.HomotopyEquiv.bijective_singularHomologyMap ℤ 1
      g.symm.toHomotopyEquiv).2

/-- The reparametrized solid torus sends `(w, z)` to `Ψ (w, g z)`. -/
private theorem solidTorus_reparam_apply (S : ZeroShakeSurface K) (g : Circle ≃ₜ Circle)
    (hg : ⇑K' = K ∘ g) (w : closedBall (0 : ℂ) 1) (z : Circle) :
    (S.reparam g hg).solidTorus (w, z) = S.solidTorus (w, g z) :=
  (rfl)

/-- Reparametrizing a `0`-shake surface keeps its genus: the surface and the copies are
unchanged. -/
private theorem genus_reparam (S : ZeroShakeSurface K) (g : Circle ≃ₜ Circle)
    (hg : ⇑K' = K ∘ g) : (S.reparam g hg).genus = S.genus :=
  (rfl)

/-- A `0`-shake surface for `K` is one for every knot `K'` with the same image: `K'` is `K`
reparametrized by a homeomorphism `g` of the circle, and the solid torus neighbourhood is
reparametrized along `g`, `(w, z) ↦ Ψ (w, g z)`. -/
def congrRange (S : ZeroShakeSurface K) (h : range K = range K') : ZeroShakeSurface K' :=
  S.reparam (K'.isEmbedding.toHomeomorph.trans
    ((Homeomorph.setCongr h.symm).trans K.isEmbedding.toHomeomorph.symm)) <| funext fun z ↦ by
      simp only [Function.comp_apply, Homeomorph.trans_apply]
      rw [← K.isEmbedding.toHomeomorph_apply_coe, Homeomorph.apply_symm_apply]
      -- `Homeomorph.setCongr` does not change the underlying point.
      exact (K'.isEmbedding.toHomeomorph_apply_coe z).symm

/-- Transporting a `0`-shake surface to a knot with the same image keeps the surface. -/
theorem carrier_congrRange (S : ZeroShakeSurface K) (h : range K = range K') :
    (S.congrRange h).carrier = S.carrier :=
  (rfl)

/-- Transporting a `0`-shake surface to a knot with the same image keeps its embedded image. -/
@[simp]
theorem range_toFun_congrRange (S : ZeroShakeSurface K) (h : range K = range K') :
    range (S.congrRange h).toFun = range S.toFun :=
  (rfl)

/-- Transporting a `0`-shake surface to a knot with the same image reparametrizes its solid torus:
the point `(w, z)` goes to `Ψ (w, z')`, where `K z' = K' z`. -/
theorem solidTorus_congrRange_apply (S : ZeroShakeSurface K) (h : range K = range K')
    (w : closedBall (0 : ℂ) 1) {z z' : Circle} (hz : K z' = K' z) :
    (S.congrRange h).solidTorus (w, z) = S.solidTorus (w, z') := by
  rw [congrRange, solidTorus_reparam_apply]
  refine congrArg (fun z ↦ S.solidTorus (w, z)) (K.isEmbedding.injective ?_)
  rw [Homeomorph.trans_apply, Homeomorph.trans_apply, ← K.isEmbedding.toHomeomorph_apply_coe,
    Homeomorph.apply_symm_apply, hz]
  -- `Homeomorph.setCongr` does not change the underlying point.
  exact K'.isEmbedding.toHomeomorph_apply_coe z

/-- Transporting a `0`-shake surface to a knot with the same image keeps its parallel copies. -/
@[simp]
theorem parallels_congrRange (S : ZeroShakeSurface K) (h : range K = range K') :
    (S.congrRange h).parallels = S.parallels :=
  (rfl)

/-- Transporting a `0`-shake surface to a knot with the same image keeps its genus. -/
@[simp]
theorem genus_congrRange (S : ZeroShakeSurface K) (h : range K = range K') :
    (S.congrRange h).genus = S.genus :=
  S.genus_reparam _ _

variable {F : Type} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [Fact (finrank ℝ F = 3 + 1)]

/-- Transport of a `0`-shake surface for `K` along a linear isometry `e : E ≃ₗᵢ[ℝ] F` of the ambient
spaces: the same surface, embedded by `e ∘ S.toFun`, with the solid torus `e ∘ Ψ` and the same
parallel copies, is a `0`-shake surface for `K' = e ∘ K`. -/
def mapLinearIsometryEquiv (S : ZeroShakeSurface K) (e : E ≃ₗᵢ[ℝ] F)
    {K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : F) 1)} (hK' : ∀ z, (K' z : F) = e (K z)) :
    ZeroShakeSurface K' where
  carrier := S.carrier
  toFun := e.toLinearIsometry.unitClosedBallMap ∘ S.toFun
  isSmoothEmbedding := by
    have := isSmoothEmbedding_diffeomorph_comp S.isSmoothEmbedding
      (e.unitClosedBallDiffeomorph (k := ∞))
    rwa [LinearIsometryEquiv.coe_unitClosedBallDiffeomorph] at this
  preimage_boundary := by
    rw [← S.preimage_boundary]
    ext x
    simp [boundary_closedBall]
  solidTorus := e.unitSphereIsometryEquiv ∘ S.solidTorus
  isSolidTorusNeighborhood := by
    have hK : ⇑K' = e.unitSphereIsometryEquiv ∘ K := funext fun z ↦
      Subtype.ext ((hK' z).trans (e.coe_unitSphereIsometryEquiv_apply _).symm)
    exact hK ▸ S.isSolidTorusNeighborhood.comp
      e.unitSphereIsometryEquiv.toHomeomorph.isOpenEmbedding
  boundaryHomologyMap_longitude := by
    -- The isometry maps the complement of `K` into the complement of `K'`.
    have hmaps (x : ↥(range K)ᶜ) : e.unitSphereIsometryEquiv x ∈ (range K')ᶜ := by
      rintro ⟨z, hz⟩
      refine x.2 ⟨z, e.unitSphereIsometryEquiv.injective (Subtype.ext ?_)⟩
      rw [e.coe_unitSphereIsometryEquiv_apply, ← hK', hz]
    exact S.isSolidTorusNeighborhood.boundaryHomologyMap_basis_one_eq_zero_of_map _
      (ContinuousMap.id Circle) ⟨fun x ↦ ⟨_, hmaps x⟩,
        (e.unitSphereIsometryEquiv.continuous.comp continuous_subtype_val).subtype_mk _⟩
      (fun _ _ hx ↦ congrArg e.unitSphereIsometryEquiv hx) S.boundaryHomologyMap_longitude
  parallels := S.parallels
  norm_lt_one_of_mem_parallels := S.norm_lt_one_of_mem_parallels
  boundaryMap := S.boundaryMap
  solidTorus_boundaryMap x := by simpa using congrArg e (S.solidTorus_boundaryMap x)
  range_boundaryMap := S.range_boundaryMap
  map_ker_eq_top := S.map_ker_eq_top

/-- Transporting a `0`-shake surface along a linear isometry of the ambient spaces keeps the
surface. -/
theorem carrier_mapLinearIsometryEquiv (S : ZeroShakeSurface K) (e : E ≃ₗᵢ[ℝ] F)
    {K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : F) 1)} (hK' : ∀ z, (K' z : F) = e (K z)) :
    (S.mapLinearIsometryEquiv e hK').carrier = S.carrier :=
  (rfl)

/-- Transporting a `0`-shake surface along a linear isometry `e` composes its embedding with `e`,
so its embedded image is the image under `e`. -/
@[simp]
theorem range_toFun_mapLinearIsometryEquiv (S : ZeroShakeSurface K) (e : E ≃ₗᵢ[ℝ] F)
    {K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : F) 1)} (hK' : ∀ z, (K' z : F) = e (K z)) :
    range (S.mapLinearIsometryEquiv e hK').toFun =
      e.toLinearIsometry.unitClosedBallMap '' range S.toFun :=
  (range_comp e.toLinearIsometry.unitClosedBallMap S.toFun)

/-- Transporting a `0`-shake surface along a linear isometry `e` composes its solid torus with
`e`. -/
@[simp]
theorem coe_solidTorus_mapLinearIsometryEquiv (S : ZeroShakeSurface K) (e : E ≃ₗᵢ[ℝ] F)
    {K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : F) 1)} (hK' : ∀ z, (K' z : F) = e (K z))
    (p : SolidTorus) : ((S.mapLinearIsometryEquiv e hK').solidTorus p : F) = e (S.solidTorus p) :=
  e.coe_unitSphereIsometryEquiv_apply _

/-- Transporting a `0`-shake surface along a linear isometry of the ambient spaces keeps its
parallel copies. -/
@[simp]
theorem parallels_mapLinearIsometryEquiv (S : ZeroShakeSurface K) (e : E ≃ₗᵢ[ℝ] F)
    {K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : F) 1)} (hK' : ∀ z, (K' z : F) = e (K z)) :
    (S.mapLinearIsometryEquiv e hK').parallels = S.parallels :=
  (rfl)

/-- Transporting a `0`-shake surface along a linear isometry of the ambient spaces keeps its
genus. -/
@[simp]
theorem genus_mapLinearIsometryEquiv (S : ZeroShakeSurface K) (e : E ≃ₗᵢ[ℝ] F)
    {K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : F) 1)} (hK' : ∀ z, (K' z : F) = e (K z)) :
    (S.mapLinearIsometryEquiv e hK').genus = S.genus :=
  (rfl)

end ZeroShakeSurface

/-- The **`0`-shake genus** `g_sh⁰(K)` of a knot `K : S¹ → S³`: the least genus of a `0`-shake
surface for `K`, or `⊤` if there is none. It is the least genus of a closed, connected, orientable
surface smoothly embedded in the `0`-trace of `K` and representing a generator of its second
homology. -/
def zeroShakeGenus (K : SmoothCircleEmbedding (𝓡 3) (sphere (0 : E) 1)) : ℕ∞ :=
  ⨅ S : ZeroShakeSurface K, (S.genus : ℕ∞)

variable {K K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : E) 1)}

/-- The `0`-shake genus is the infimum of the genera of all `0`-shake surfaces. -/
theorem zeroShakeGenus_def : zeroShakeGenus K = ⨅ S : ZeroShakeSurface K, (S.genus : ℕ∞) :=
  (rfl)

/-- The `0`-shake genus is at most the genus of any `0`-shake surface. -/
theorem zeroShakeGenus_le_genus (S : ZeroShakeSurface K) : zeroShakeGenus K ≤ S.genus :=
  iInf_le _ S

/-- A lower bound for the `0`-shake genus is a lower bound for the genus of every `0`-shake
surface. -/
@[simp]
theorem le_zeroShakeGenus_iff {m : ℕ∞} :
    m ≤ zeroShakeGenus K ↔ ∀ S : ZeroShakeSurface K, m ≤ S.genus :=
  le_iInf_iff

/-- The `0`-shake genus is attained when a `0`-shake surface exists. -/
theorem exists_genus_eq_zeroShakeGenus [Nonempty (ZeroShakeSurface K)] :
    ∃ S : ZeroShakeSurface K, (S.genus : ℕ∞) = zeroShakeGenus K :=
  ENat.exists_eq_iInf _

/-- The `0`-shake genus is finite exactly when a `0`-shake surface exists. -/
@[simp]
theorem zeroShakeGenus_lt_top_iff : zeroShakeGenus K < ⊤ ↔ Nonempty (ZeroShakeSurface K) :=
  ENat.iInf_natCast_lt_top

/-- Two knots with the same image have the same `0`-shake genus. -/
theorem zeroShakeGenus_congr_range (h : range K = range K') :
    zeroShakeGenus K = zeroShakeGenus K' :=
  le_antisymm
    (le_zeroShakeGenus_iff.2 fun S ↦ by simpa using zeroShakeGenus_le_genus (S.congrRange h.symm))
    (le_zeroShakeGenus_iff.2 fun S ↦ by simpa using zeroShakeGenus_le_genus (S.congrRange h))

/-- The `0`-shake genus does not depend on the rotation of the parametrization. -/
@[simp]
theorem zeroShakeGenus_rotate (a : Circle) : zeroShakeGenus (K.rotate a) = zeroShakeGenus K :=
  zeroShakeGenus_congr_range (K.range_rotate a)

/-- The `0`-shake genus does not depend on the orientation of the knot. -/
@[simp]
theorem zeroShakeGenus_reverse : zeroShakeGenus K.reverse = zeroShakeGenus K :=
  zeroShakeGenus_congr_range K.range_reverse

/-- The `0`-shake genus is invariant under linear isometries of the ambient spaces: if `K' = e ∘ K`
for a linear isometry `e : E ≃ₗᵢ[ℝ] F`, then `K'` and `K` have the same `0`-shake genus. -/
theorem zeroShakeGenus_congr_linearIsometryEquiv {F : Type} [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] [Fact (finrank ℝ F = 3 + 1)] (e : E ≃ₗᵢ[ℝ] F)
    {K' : SmoothCircleEmbedding (𝓡 3) (sphere (0 : F) 1)} (hK' : ∀ z, (K' z : F) = e (K z)) :
    zeroShakeGenus K' = zeroShakeGenus K := by
  have hK : ∀ z, (K z : E) = e.symm (K' z) := fun z ↦ by simp [hK']
  exact le_antisymm
    (le_zeroShakeGenus_iff.2 fun S ↦ by
      simpa using zeroShakeGenus_le_genus (S.mapLinearIsometryEquiv e hK'))
    (le_zeroShakeGenus_iff.2 fun S ↦ by
      simpa using zeroShakeGenus_le_genus (S.mapLinearIsometryEquiv e.symm hK))

/-! ### Slice discs as shake surfaces -/

variable {Φ : closedBall (0 : ℂ) 1 → closedBall (0 : E) 1} {Ψ : SolidTorus → sphere (0 : E) 1}

/-- A smooth slice disc `Φ` for `K`, together with a solid torus neighbourhood `Ψ` of `K` with the
`0`-framing, is a `0`-shake surface: the disc is bounded by the single copy `Ψ ({0} × S¹)`, the knot
itself. Its boundary circle projects homeomorphically onto the core circle, and the first homology
of the disc vanishes, so its boundary circle is a generator. -/
def IsSmoothSliceDisc.toZeroShakeSurface (h : IsSmoothSliceDisc K Φ)
    (hΨ : IsSolidTorusNeighborhood K Ψ)
    (hl : hΨ.boundaryHomologyMap (hΨ.framedBoundaryTorus.basis 1) = 0) : ZeroShakeSurface K where
  carrier := closedBall (0 : ℂ) 1
  compactSpace := isCompact_iff_compactSpace.1 (isCompact_closedBall 0 1)
  connectedSpace := isConnected_iff_connectedSpace.1
    ((convex_closedBall 0 1).isConnected (nonempty_closedBall.2 zero_le_one))
  orientable := orientable_closedBall
  toFun := Φ
  isSmoothEmbedding := h.isSmoothEmbedding
  preimage_boundary := h.preimage_boundary
  solidTorus := Ψ
  isSolidTorusNeighborhood := hΨ
  boundaryHomologyMap_longitude := hl
  parallels := {0}
  norm_lt_one_of_mem_parallels hc := by simp [Finset.mem_singleton.1 hc]
  boundaryMap := (ContinuousMap.const _ 0).prodMk circleHomeomorphBoundaryClosedBall.symm
  solidTorus_boundaryMap x := by
    rw [ContinuousMap.prod_eval, ContinuousMap.const_apply, hΨ.apply_zero, ← h.apply_inclusion]
    congr 2
    exact Subtype.ext (circleHomeomorphBoundaryClosedBall_symm_apply_coe x)
  range_boundaryMap := by
    ext ⟨c, z⟩
    simp only [mem_range, ContinuousMap.prod_eval, ContinuousMap.const_apply, Prod.mk.injEq,
      Finset.coe_singleton, mem_prod, mem_singleton_iff, mem_univ, and_true]
    refine ⟨fun ⟨x, hx, _⟩ ↦ hx.symm, fun hc ↦ ⟨circleHomeomorphBoundaryClosedBall z, hc.symm, ?_⟩⟩
    exact circleHomeomorphBoundaryClosedBall.symm_apply_apply z
  map_ker_eq_top := by
    have := contractibleSpace_closedBall (x := (0 : ℂ)) zero_le_one
    -- `singularHomologyFunctor` unfolds to the homology of the singular chain complex, so the
    -- vanishing of the first homology of the contractible disc is the chain-level statement.
    have : Subsingleton (((singularChains ℤ).obj (TopCat.of (closedBall (0 : ℂ) 1))).homology 1) :=
      inferInstanceAs (Subsingleton (((singularHomologyFunctor (ModuleCat ℤ) 1).obj
        (ModuleCat.of ℤ ℤ)).obj (TopCat.of (closedBall (0 : ℂ) 1))))
    rw [LinearMap.ker_eq_top.2 (Subsingleton.elim _ _), Submodule.map_top, LinearMap.range_eq_top]
    -- The projection of the boundary circle to the core circle is a homeomorphism.
    exact (ContinuousMap.HomotopyEquiv.bijective_singularHomologyMap ℤ 1
      circleHomeomorphBoundaryClosedBall.symm.toHomotopyEquiv).2

/-- A smooth slice disc, as a `0`-shake surface, is carried by the closed unit disc. -/
theorem IsSmoothSliceDisc.carrier_toZeroShakeSurface (h : IsSmoothSliceDisc K Φ)
    (hΨ : IsSolidTorusNeighborhood K Ψ)
    (hl : hΨ.boundaryHomologyMap (hΨ.framedBoundaryTorus.basis 1) = 0) :
    (h.toZeroShakeSurface hΨ hl).carrier = closedBall (0 : ℂ) 1 :=
  (rfl)

/-- A smooth slice disc, as a `0`-shake surface, is embedded by the slice disc. -/
@[simp]
theorem IsSmoothSliceDisc.range_toFun_toZeroShakeSurface (h : IsSmoothSliceDisc K Φ)
    (hΨ : IsSolidTorusNeighborhood K Ψ)
    (hl : hΨ.boundaryHomologyMap (hΨ.framedBoundaryTorus.basis 1) = 0) :
    range (h.toZeroShakeSurface hΨ hl).toFun = range Φ :=
  (rfl)

/-- A smooth slice disc, as a `0`-shake surface, has the given solid torus neighbourhood. -/
@[simp]
theorem IsSmoothSliceDisc.solidTorus_toZeroShakeSurface (h : IsSmoothSliceDisc K Φ)
    (hΨ : IsSolidTorusNeighborhood K Ψ)
    (hl : hΨ.boundaryHomologyMap (hΨ.framedBoundaryTorus.basis 1) = 0) :
    (h.toZeroShakeSurface hΨ hl).solidTorus = Ψ :=
  (rfl)

/-- A smooth slice disc, as a `0`-shake surface, is bounded by the single copy at the centre. -/
@[simp]
theorem IsSmoothSliceDisc.parallels_toZeroShakeSurface (h : IsSmoothSliceDisc K Φ)
    (hΨ : IsSolidTorusNeighborhood K Ψ)
    (hl : hΨ.boundaryHomologyMap (hΨ.framedBoundaryTorus.basis 1) = 0) :
    (h.toZeroShakeSurface hΨ hl).parallels = {0} :=
  (rfl)

/-- A smooth slice disc, as a `0`-shake surface, has genus `0`: the disc is contractible and has a
single boundary circle. -/
@[simp]
theorem IsSmoothSliceDisc.genus_toZeroShakeSurface (h : IsSmoothSliceDisc K Φ)
    (hΨ : IsSolidTorusNeighborhood K Ψ)
    (hl : hΨ.boundaryHomologyMap (hΨ.framedBoundaryTorus.basis 1) = 0) :
    (h.toZeroShakeSurface hΨ hl).genus = 0 := by
  have := contractibleSpace_closedBall (x := (0 : ℂ)) zero_le_one
  -- The carrier of `h.toZeroShakeSurface hΨ hl` is the closed unit disc by definition.
  have : Subsingleton (h.toZeroShakeSurface hΨ hl).firstHomology :=
    inferInstanceAs (Subsingleton (((singularHomologyFunctor (ModuleCat ℚ) 1).obj
      (ModuleCat.of ℚ ℚ)).obj (TopCat.of (closedBall (0 : ℂ) 1))))
  rw [ZeroShakeSurface.genus_def, finrank_zero_of_subsingleton]
  simp

/-- **Smoothly slice knots with a `0`-framed solid torus neighbourhood have `0`-shake genus
`0`.** -/
theorem IsSmoothlySlice.zeroShakeGenus_eq_zero (h : IsSmoothlySlice K)
    (hΨ : IsSolidTorusNeighborhood K Ψ)
    (hl : hΨ.boundaryHomologyMap (hΨ.framedBoundaryTorus.basis 1) = 0) :
    zeroShakeGenus K = 0 := by
  obtain ⟨Φ, hΦ⟩ := h.elim
  exact nonpos_iff_eq_zero.1 <| by
    simpa using zeroShakeGenus_le_genus (hΦ.toZeroShakeSurface hΨ hl)

/-- **The unknot has `0`-shake genus `0`**, equal to its slice genus: it bounds a flat disc, and its
standard solid torus neighbourhood has the `0`-framing. -/
@[simp]
theorem zeroShakeGenus_unknot : zeroShakeGenus unknot = 0 := by
  have hU := isSolidTorusNeighborhood_unknotSolidTorus
  exact isSmoothlySlice_unknot.zeroShakeGenus_eq_zero hU <| (hU.framingNumber_eq_zero_iff
    (isZero_reducedSingularHomologyFunctor_one_sphere_euclideanSpace_fin_four _)
    (isZero_reducedSingularHomologyFunctor_two_sphere_euclideanSpace_fin_four _)).1
    (framingNumber_unknotSolidTorus _ _)

/-! ### Kirby's problem 1.41 (A) -/

/-- **Piccirillo's theorem** on Kirby's problem 1.41 (A): the `0`-shake genus of a knot in `S³` can
be strictly smaller than its slice genus. Akbulut and Kirby asked whether the two always agree;
Piccirillo constructed knots `K` with `g_sh⁰(K) < g_s(K)`. Both genera are taken in the smooth
category. The statement is recorded, not proved. -/
def PiccirilloShakeGenusTheorem : Prop :=
  ∃ K : SmoothCircleEmbedding (𝓡 3) (sphere (0 : EuclideanSpace ℝ (Fin 4)) 1),
    zeroShakeGenus K < sliceGenus K

/-- The defining characterization of **Piccirillo's theorem**: some knot has `0`-shake genus
strictly smaller than its slice genus. -/
theorem piccirilloShakeGenusTheorem_iff :
    PiccirilloShakeGenusTheorem ↔
      ∃ K : SmoothCircleEmbedding (𝓡 3) (sphere (0 : EuclideanSpace ℝ (Fin 4)) 1),
        zeroShakeGenus K < sliceGenus K :=
  Iff.rfl

/-- A knot witnessing **Piccirillo's theorem** bounds a `0`-shake surface, since its `0`-shake
genus is finite, and has positive slice genus, so it is not smoothly slice. -/
theorem PiccirilloShakeGenusTheorem.exists_not_isSmoothlySlice (h : PiccirilloShakeGenusTheorem) :
    ∃ K : SmoothCircleEmbedding (𝓡 3) (sphere (0 : EuclideanSpace ℝ (Fin 4)) 1),
      Nonempty (ZeroShakeSurface K) ∧ 0 < sliceGenus K ∧ ¬IsSmoothlySlice K := by
  obtain ⟨K, hK⟩ := piccirilloShakeGenusTheorem_iff.1 h
  refine ⟨K, zeroShakeGenus_lt_top_iff.1 (hK.trans_le le_top), zero_le.trans_lt hK, fun hs ↦ ?_⟩
  rw [hs.sliceGenus_eq_zero] at hK
  exact not_lt_zero hK

end TauCeti
