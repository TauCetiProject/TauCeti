module

public import TauCeti.Probability.MDP.HistoryPolicy
public import TauCeti.Probability.Kernel.IonescuTulcea.Traj
import TauCeti.Probability.Kernel.Composition.MeasureCompProd

/-!
# State-action trajectories under a history-dependent policy

A controlled transition kernel draws the next state from the current state-action pair. The
policy then draws the next action from the finite history and that new state. Composing these
two kernels gives the joint step for Mathlib's Ionescu–Tulcea construction.

The joint-law identities describe this sequential sampling on arbitrary measurable spaces.
On nonempty standard Borel state and action spaces, they identify the regular conditional laws
of the next state given the history and of the next action given the history and the new state.

See Puterman, *Markov Decision Processes* (1994), §2.1.6, for the history-dependent trajectory law.
-/

public section

noncomputable section

open Finset MeasureTheory Preorder ProbabilityTheory
open scoped ProbabilityTheory

namespace TauCeti.HistoryPolicy

variable {S A : Type*} [MeasurableSpace S] [MeasurableSpace A]
variable (π : HistoryPolicy S A) (κ : Kernel (S × A) S)

/-- The joint step that draws a state from the last state-action pair and then samples the
action prescribed by the policy at the extended history. -/
def step (n : ℕ) : Kernel ((i : Iic n) → S × A) (S × A) :=
  κ.comap (fun h ↦ h ⟨n, mem_Iic.2 le_rfl⟩) (measurable_pi_apply _) ⊗ₖ π.next n

/-- The joint step is the composition-product of state transition and action selection. -/
theorem step_def (n : ℕ) :
    π.step κ n = κ.comap (fun h ↦ h ⟨n, mem_Iic.2 le_rfl⟩) (measurable_pi_apply _) ⊗ₖ
      π.next n := (rfl)

variable [IsMarkovKernel κ]

instance (n : ℕ) : IsMarkovKernel (π.step κ n) := by
  rw [step_def]
  infer_instance

variable (s : S)

/-- The state-action trajectory law from initial state `s` under the policy `π`. -/
def trajLaw : Measure (ℕ → S × A) :=
  Kernel.trajMeasure (X := fun _ ↦ S × A) (Measure.dirac s ⊗ₘ π.first) (π.step κ)

/-- The trajectory is generated by the initial state-action law and the joint step kernels. -/
theorem trajLaw_def :
    π.trajLaw κ s =
      Kernel.trajMeasure (X := fun _ ↦ S × A) (Measure.dirac s ⊗ₘ π.first) (π.step κ) := (rfl)

instance : IsProbabilityMeasure (π.trajLaw κ s) := by
  rw [trajLaw_def]
  infer_instance

/-- At time zero, the state is fixed and the action is drawn from the policy's first kernel. -/
@[simp]
theorem trajLaw_map_eval_zero :
    (π.trajLaw κ s).map (fun x ↦ x 0) = Measure.dirac s ⊗ₘ π.first := by
  rw [trajLaw_def, Kernel.trajMeasure_map_eval_zero]

/-- The initial state marginal is the point mass at the starting state. -/
@[simp]
theorem trajLaw_map_state_zero :
    (π.trajLaw κ s).map (fun x ↦ (x 0).1) = Measure.dirac s := by
  calc
    _ = ((π.trajLaw κ s).map (fun x ↦ x 0)).fst :=
      (Measure.map_map measurable_fst (measurable_pi_apply 0)).symm
    _ = _ := by rw [trajLaw_map_eval_zero, Measure.fst_compProd]

/-- The initial action marginal is the policy's first row at the starting state. -/
@[simp]
theorem trajLaw_map_action_zero :
    (π.trajLaw κ s).map (fun x ↦ (x 0).2) = π.first s := by
  calc
    _ = ((π.trajLaw κ s).map (fun x ↦ x 0)).snd :=
      (Measure.map_map measurable_snd (measurable_pi_apply 0)).symm
    _ = _ := by
      rw [trajLaw_map_eval_zero, Measure.snd_compProd, Measure.dirac_bind π.first.measurable]

/-- The law of the history and the next pair is obtained by appending the joint step. -/
theorem trajLaw_map_history_succ (n : ℕ) :
    (π.trajLaw κ s).map (fun x ↦ (frestrictLe n x, x (n + 1))) =
      (π.trajLaw κ s).map (frestrictLe n) ⊗ₘ π.step κ n := by
  rw [trajLaw_def]
  exact Kernel.map_frestrictLe_trajMeasure_compProd_eq_map_trajMeasure.symm

/-- The law of history and the next state is obtained by applying the state transition to the
last state-action pair. -/
theorem trajLaw_map_history_state_succ (n : ℕ) :
    (π.trajLaw κ s).map (fun x ↦ (frestrictLe n x, (x (n + 1)).1)) =
      (π.trajLaw κ s).map (frestrictLe n) ⊗ₘ
        κ.comap (fun h ↦ h ⟨n, mem_Iic.2 le_rfl⟩) (measurable_pi_apply _) := by
  have h := congrArg (fun μ : Measure (((i : Iic n) → S × A) × (S × A)) ↦
    μ.map (Prod.map id Prod.fst)) (π.trajLaw_map_history_succ κ s n)
  rw [Measure.map_map (measurable_id.prodMap measurable_fst) (by fun_prop),
    ← Measure.compProd_map measurable_fst, ← Kernel.fst_eq, step_def, Kernel.fst_compProd] at h
  exact h

/-- The law of the history, next state and next action is obtained by applying the policy to
the history and next state. -/
theorem trajLaw_map_history_state_action_succ (n : ℕ) :
    (π.trajLaw κ s).map (fun x ↦ ((frestrictLe n x, (x (n + 1)).1), (x (n + 1)).2)) =
      (π.trajLaw κ s).map (fun x ↦ (frestrictLe n x, (x (n + 1)).1)) ⊗ₘ π.next n := by
  have h := congrArg (fun μ : Measure (((i : Iic n) → S × A) × (S × A)) ↦
    μ.map MeasurableEquiv.prodAssoc.symm) (π.trajLaw_map_history_succ κ s n)
  rw [Measure.map_map (MeasurableEquiv.measurable _) (by fun_prop), step_def,
    Measure.compProd_assoc, ← trajLaw_map_history_state_succ] at h
  exact h

/-- Given the history through time `n`, the next state's conditional law is the transition
kernel evaluated at the last state-action pair. -/
theorem condDistrib_state_succ [StandardBorelSpace S] [Nonempty S] (n : ℕ) :
    condDistrib (fun x ↦ (x (n + 1)).1) (frestrictLe n) (π.trajLaw κ s)
      =ᵐ[(π.trajLaw κ s).map (frestrictLe n)]
        κ.comap (fun h ↦ h ⟨n, mem_Iic.2 le_rfl⟩) (measurable_pi_apply _) :=
  condDistrib_ae_eq_of_measure_eq_compProd_of_measurable (by fun_prop) (by fun_prop)
    (π.trajLaw_map_history_state_succ κ s n)

/-- Given the history through time `n` and the next state, the next action has the policy's
conditional law at time `n + 1`. -/
theorem condDistrib_action_succ [StandardBorelSpace A] [Nonempty A] (n : ℕ) :
    condDistrib (fun x ↦ (x (n + 1)).2) (fun x ↦ (frestrictLe n x, (x (n + 1)).1)) (π.trajLaw κ s)
      =ᵐ[(π.trajLaw κ s).map (fun x ↦ (frestrictLe n x, (x (n + 1)).1))] π.next n :=
  condDistrib_ae_eq_of_measure_eq_compProd_of_measurable (by fun_prop) (by fun_prop)
    (π.trajLaw_map_history_state_action_succ κ s n)

/-- The trajectory starts at the initial state almost surely. -/
theorem trajLaw_ae_state_zero [MeasurableSingletonClass S] :
    ∀ᵐ x ∂π.trajLaw κ s, (x 0).1 = s :=
  HasLaw.ae_eq_of_dirac ⟨(measurable_fst.comp (measurable_pi_apply 0)).aemeasurable,
    π.trajLaw_map_state_zero κ s⟩

/-- The joint law of the pair at time `n` and the state at time `n + 1` is the law of that pair
followed by the transition kernel. -/
theorem trajLaw_map_eval_state_succ (n : ℕ) :
    (π.trajLaw κ s).map (fun x ↦ (x n, (x (n + 1)).1)) =
      (π.trajLaw κ s).map (fun x ↦ x n) ⊗ₘ κ := by
  have hlast : Measurable fun h : (i : Iic n) → S × A ↦ h ⟨n, mem_Iic.2 le_rfl⟩ :=
    measurable_pi_apply _
  have h := congrArg (Measure.map (Prod.map (fun h : (i : Iic n) → S × A ↦
    h ⟨n, mem_Iic.2 le_rfl⟩) (id : S → S))) (π.trajLaw_map_history_state_succ κ s n)
  rwa [Measure.map_map (hlast.prodMap measurable_id) (by fun_prop),
    Measure.map_prodMap_compProd_comap _ _ hlast,
    Measure.map_map hlast (measurable_frestrictLe n)] at h

/-- Under the Markov policy `ofMarkov π`, the pair at time `n + 1` has the law of the state at
time `n + 1` followed by `π (n + 1)`: given that state, the action is drawn from `π (n + 1)`. -/
theorem trajLaw_ofMarkov_map_eval_succ [Countable S] [MeasurableSingletonClass S]
    {π : ℕ → S → PMF A} (n : ℕ) :
    ((ofMarkov π).trajLaw κ s).map (fun x ↦ x (n + 1)) =
      ((ofMarkov π).trajLaw κ s).map (fun x ↦ (x (n + 1)).1) ⊗ₘ Kernel.ofPMF (π (n + 1)) := by
  have hmeas : Measurable
      fun x : ℕ → S × A ↦ ((frestrictLe n x, (x (n + 1)).1), (x (n + 1)).2) := by
    fun_prop
  have h := congrArg (Measure.map (Prod.map Prod.snd id))
    ((ofMarkov π).trajLaw_map_history_state_action_succ κ s n)
  rwa [Measure.map_map (measurable_snd.prodMap measurable_id) hmeas, ofMarkov_next,
    Measure.map_prodMap_compProd_comap _ _ measurable_snd,
    Measure.map_map measurable_snd (by fun_prop)] at h

end TauCeti.HistoryPolicy
