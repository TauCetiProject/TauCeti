module

public import TauCeti.Probability.FreeProbability.Topology
public import TauCeti.Probability.FreeProbability.StarIndependence
public import TauCeti.Analysis.VonNeumannAlgebra.Adjoin
public import Mathlib.Analysis.InnerProductSpace.WeakOperatorTopology
import TauCeti.Analysis.VonNeumannAlgebra.Bicommutant

/-!
# Free independence and weak operator closure

Free subalgebras of bounded operators remain free after weak operator closure for a weak-operator
continuous normalized functional (in particular, a normalized vector functional). We use Mathlib's
`ContinuousLinearMapWOT` to take these closures, transporting both the subalgebras and the
functional through its canonical algebra equivalence. No trace or faithfulness is needed. In
particular the result applies to a trace represented by its GNS vector; it does not assert that
every normal state is weak-operator continuous in an arbitrary representation.

Multiplication in the weak operator topology is separately, not jointly, continuous. The
one-letter approximation theorem for free independence therefore applies, although continuity
of the whole word-product map cannot be used.

On a complete complex Hilbert space, the bicommutant theorem identifies the weak operator closure
of the star algebra generated by `s` with the concrete von Neumann algebra
`VonNeumannAlgebra.adjoin s`. Consequently, generated von Neumann subalgebras are freely
independent for a weak-operator continuous normalized functional (in particular, any normalized
vector functional) if and only if the corresponding generated star subalgebras are freely
independent. For single operators this characterizes freeness of generated von Neumann algebras by
`IsStarFreelyIndependentElements`, and for selfadjoint operators by `IsFreelyIndependentElements`.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 5.
* R. V. Kadison, J. R. Ringrose, *Fundamentals of the Theory of Operator Algebras I*, Theorem 5.3.1.
-/

public section

open scoped InnerProductSpace

namespace TauCeti

section NormedSpace

variable {𝕜 H ι : Type*} [NormedField 𝕜] [NormedAddCommGroup H] [NormedSpace 𝕜 H]

/-- Freeness of operator subalgebras can be tested after weak operator closure, provided the
functional is continuous for that topology. The functional and subalgebras on the norm-topology
carrier are transported using Mathlib's canonical algebra equivalence. -/
theorem isFreelyIndependent_weakOperatorClosure_iff
    {φ : (H →L[𝕜] H) →ₗ[𝕜] 𝕜} {B : ι → Subalgebra 𝕜 (H →L[𝕜] H)}
    (hφ : φ 1 = 1)
    (hcont : Continuous (fun T : H →WOT[𝕜] H => φ T.toCLM)) :
    IsFreelyIndependent (φ.comp (ContinuousLinearMapWOT.algEquiv 𝕜).toLinearMap)
        (fun i => ((B i).map (ContinuousLinearMapWOT.algEquiv 𝕜).symm.toAlgHom).topologicalClosure)
      ↔ IsFreelyIndependent φ B := by
  let e := ContinuousLinearMapWOT.algEquiv (𝕜₁ := 𝕜) (E := H) 𝕜
  let ψ := φ.comp e.toLinearMap
  have hψ : ψ 1 = 1 := by simp [ψ, hφ]
  have hcomp : ψ.comp e.symm.toAlgHom.toLinearMap = φ := by
    ext T
    simp [ψ]
  rw [isFreelyIndependent_topologicalClosure_iff hψ hcont, isFreelyIndependent_map_iff, hcomp]

end NormedSpace

section InnerProductSpace

variable {𝕜 H ι : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]

/-- A normalized vector functional preserves and reflects freeness when the subalgebras are
replaced by their weak operator closures. This includes vector realizations of tracial states,
without requiring traciality of the vector state on all bounded operators. -/
theorem isFreelyIndependent_weakOperatorClosure_iff_of_vectorState
    {φ : (H →L[𝕜] H) →ₗ[𝕜] 𝕜} {B : ι → Subalgebra 𝕜 (H →L[𝕜] H)}
    (hφ : φ 1 = 1) (ξ : H) (hξ : ∀ T, φ T = ⟪ξ, T ξ⟫_𝕜) :
    IsFreelyIndependent (φ.comp (ContinuousLinearMapWOT.algEquiv 𝕜).toLinearMap)
        (fun i => ((B i).map (ContinuousLinearMapWOT.algEquiv 𝕜).symm.toAlgHom).topologicalClosure)
      ↔ IsFreelyIndependent φ B := by
  apply isFreelyIndependent_weakOperatorClosure_iff hφ
  simp only [hξ]
  exact ContinuousLinearMapWOT.continuous_dual_apply ξ (innerSL 𝕜 ξ)

end InnerProductSpace

section VonNeumannAlgebra

variable {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- For a weak-operator continuous normalized functional on bounded operators of a complete complex
Hilbert space, the von Neumann subalgebras generated by sets `s i` are freely independent if and
only if the star subalgebras generated by `s i` are freely independent. -/
theorem isFreelyIndependent_vonNeumannAlgebra_adjoin_iff
    {φ : (H →L[ℂ] H) →ₗ[ℂ] ℂ} {s : ι → Set (H →L[ℂ] H)} (hφ : φ 1 = 1)
    (hcont : Continuous (fun T : H →WOT[ℂ] H => φ T.toCLM)) :
    IsFreelyIndependent φ (fun i => (VonNeumannAlgebra.adjoin (s i)).toSubalgebra) ↔
      IsFreelyIndependent φ (fun i => (StarAlgebra.adjoin ℂ (s i)).toSubalgebra) := by
  have he : (((ContinuousLinearMapWOT.algEquiv ℂ).symm : (H →L[ℂ] H) ≃ₐ[ℂ] (H →WOT[ℂ] H)) :
      (H →L[ℂ] H) → (H →WOT[ℂ] H)) = ContinuousLinearMapWOT.ofCLM :=
    funext fun T => by rw [AlgEquiv.symm_apply_eq]; ext x; simp
  have hcl : (fun i => ((StarAlgebra.adjoin ℂ (s i)).toSubalgebra.map
        (ContinuousLinearMapWOT.algEquiv ℂ).symm.toAlgHom).topologicalClosure) =
      fun i => (VonNeumannAlgebra.adjoin (s i)).toSubalgebra.map
        (ContinuousLinearMapWOT.algEquiv ℂ).symm.toAlgHom := funext fun i =>
    SetLike.coe_injective <| by
      rw [Subalgebra.topologicalClosure_coe, Subalgebra.coe_map, Subalgebra.coe_map,
        AlgEquiv.coe_toAlgHom, he, StarSubalgebra.coe_toSubalgebra,
        StarSubalgebra.coe_toSubalgebra, VonNeumannAlgebra.coe_toStarSubalgebra,
        VonNeumannAlgebra.image_ofCLM_adjoin_eq_closure]
  have hcomp : (φ.comp (ContinuousLinearMapWOT.algEquiv ℂ).toLinearMap).comp
      (ContinuousLinearMapWOT.algEquiv ℂ).symm.toAlgHom.toLinearMap = φ := by ext T; simp
  rw [← isFreelyIndependent_weakOperatorClosure_iff
      (B := fun i => (StarAlgebra.adjoin ℂ (s i)).toSubalgebra) hφ hcont,
    hcl, isFreelyIndependent_map_iff, hcomp]

/-- For a weak-operator continuous normalized functional, the von Neumann algebras generated by
single bounded operators `T i` are freely independent if and only if `T` is star-freely independent.
-/
theorem isFreelyIndependent_vonNeumannAlgebra_adjoin_singleton_iff
    {φ : (H →L[ℂ] H) →ₗ[ℂ] ℂ} {T : ι → H →L[ℂ] H} (hφ : φ 1 = 1)
    (hcont : Continuous (fun A : H →WOT[ℂ] H => φ A.toCLM)) :
    IsFreelyIndependent φ (fun i => (VonNeumannAlgebra.adjoin {T i}).toSubalgebra) ↔
      IsStarFreelyIndependentElements φ T :=
  (isFreelyIndependent_vonNeumannAlgebra_adjoin_iff (s := fun i => {T i}) hφ hcont).trans
    isStarFreelyIndependentElements_iff.symm

/-- For selfadjoint operators and a weak-operator continuous normalized functional, the generated
von Neumann subalgebras are freely independent if and only if the operators are freely independent.
-/
theorem isFreelyIndependent_vonNeumannAlgebra_adjoin_singleton_iff_of_isSelfAdjoint
    {φ : (H →L[ℂ] H) →ₗ[ℂ] ℂ} {T : ι → H →L[ℂ] H} (hφ : φ 1 = 1)
    (hcont : Continuous (fun A : H →WOT[ℂ] H => φ A.toCLM)) (hT : ∀ i, IsSelfAdjoint (T i)) :
    IsFreelyIndependent φ (fun i => (VonNeumannAlgebra.adjoin {T i}).toSubalgebra) ↔
      IsFreelyIndependentElements φ T :=
  (isFreelyIndependent_vonNeumannAlgebra_adjoin_singleton_iff hφ hcont).trans
    (isStarFreelyIndependentElements_iff_of_isSelfAdjoint hT)

end VonNeumannAlgebra

end TauCeti
