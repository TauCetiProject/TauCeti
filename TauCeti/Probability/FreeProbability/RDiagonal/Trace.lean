module

import TauCeti.Data.Fin.Basic
import TauCeti.Probability.FreeProbability.Cumulant.Trace
public import TauCeti.Probability.FreeProbability.RDiagonal.Basic

/-!
# Traciality of R-diagonal distributions

An R-diagonal element has a tracial distribution exactly when its two determining sequences
agree. The trace is required only on the generated unital star algebra, not on the ambient
algebra. This criterion distinguishes general R-diagonal elements, with two determining
sequences, from their tracial specialization, with just one.

The proof uses the fact that cyclic rotation exchanges the two even alternating words.
All other cumulants vanish, so agreement of the determining sequences gives cyclicity of
every joint cumulant and hence traciality of every star-polynomial moment. No positivity,
faithfulness, or analytic realization is needed.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 15.
-/

public section

open Finset

namespace TauCeti

/-- Rotating an even alternating word backwards exchanges its starting letter. -/
@[simp↓]
theorem rDiagonalWord_finRotate_symm (c : Bool) {n : ℕ} (hn : Even n) (i : Fin n) :
    rDiagonalWord c n ((finRotate n).symm i) = rDiagonalWord (!c) n i := by
  simpa only [rDiagonalWord_apply, Function.comp_apply, Bool.not_not] using
    congrFun (Fin.ite_even_comp_finRotate_symm hn c (!c)) i

/-- Rotating an even alternating word exchanges its starting letter. -/
@[simp↓]
theorem rDiagonalWord_finRotate (c : Bool) {n : ℕ} (hn : Even n) (i : Fin n) :
    rDiagonalWord c n (finRotate n i) = rDiagonalWord (!c) n i := by
  simpa only [Equiv.symm_apply_apply, Bool.not_not] using
    (rDiagonalWord_finRotate_symm (!c) hn (finRotate n i)).symm

variable {R A : Type*} [CommRing R] [Semiring A] [Algebra R A] [StarRing A]
  {φ : A →ₗ[R] R} {a : A}

namespace IsRDiagonal

/-- If the two determining sequences agree, all joint cumulants in an R-diagonal element
and its adjoint are cyclically invariant. -/
theorem freeCumulant_comp_finRotate (h : IsRDiagonal φ a)
    (hc : ∀ k, rDiagonalDeterminingSequence φ a false k =
      rDiagonalDeterminingSequence φ a true k) {n : ℕ} (w : Fin n → Bool) :
    freeCumulant φ (fun i => if w (finRotate n i) then Star.star a else a) univ =
      freeCumulant φ (fun i => if w i then Star.star a else a) univ := by
  by_cases hn : n = 0
  · subst n
    simp [freeCumulant_empty]
  by_cases hw : ∃ k c, n = 2 * (k + 1) ∧ ∀ i, w i = rDiagonalWord c n i
  · obtain ⟨k, c, rfl, hw⟩ := hw
    have he : Even (2 * (k + 1)) := even_two_mul _
    have hc' : rDiagonalDeterminingSequence φ a (!c) k =
        rDiagonalDeterminingSequence φ a c k := by
      cases c
      · exact (hc k).symm
      · exact hc k
    simpa only [hw, rDiagonalWord_finRotate _ he, rDiagonalDeterminingSequence_def]
      using hc'
  · rw [h.freeCumulant_eq_zero hn w hw, h.freeCumulant_eq_zero hn _ ?_]
    rintro ⟨k, c, rfl, hc⟩
    apply hw
    refine ⟨k, !c, rfl, fun i => ?_⟩
    simpa only [Equiv.apply_symm_apply, rDiagonalWord_finRotate_symm _ (even_two_mul _)] using
      hc ((finRotate (2 * (k + 1))).symm i)

variable [StarRing R] [StarModule R A]

/-- Equality of the two determining sequences makes the functional tracial on the star
algebra generated by the R-diagonal element. -/
theorem apply_mul_comm_of_mem_adjoin (h : IsRDiagonal φ a)
    (hc : ∀ k, rDiagonalDeterminingSequence φ a false k =
      rDiagonalDeterminingSequence φ a true k)
    {x y : A} (hx : x ∈ StarAlgebra.adjoin R {a})
    (hy : y ∈ StarAlgebra.adjoin R {a}) : φ (x * y) = φ (y * x) := by
  have hs : (StarAlgebra.adjoin R {a}).toSubalgebra =
      Algebra.adjoin R (Set.range (fun c : Bool => if c then Star.star a else a)) := by
    simp [StarAlgebra.adjoin_toSubalgebra, Set.star_singleton, Bool.range_eq, Set.pair_comm]
  rw [← StarSubalgebra.mem_toSubalgebra, hs] at hx hy
  exact forall_apply_mul_comm_mem_adjoin_iff_freeCumulant_comp_finRotate.mpr
    (fun _ w => h.freeCumulant_comp_finRotate hc w) x hx y hy

end IsRDiagonal

/-- A trace on the submonoid generated by an element and its adjoint forces its two
alternating cumulant sequences to agree. This direction does not require R-diagonality. -/
theorem rDiagonalDeterminingSequence_eq_of_apply_mul_comm
    (htr : ∀ x ∈ Submonoid.closure {a, Star.star a},
      ∀ y ∈ Submonoid.closure {a, Star.star a}, φ (x * y) = φ (y * x)) (k : ℕ) :
    rDiagonalDeterminingSequence φ a false k =
      rDiagonalDeterminingSequence φ a true k := by
  have hr := freeCumulant_comp_finRotate_of_apply_mul_comm htr
    (w := fun i : Fin (2 * (k + 1)) =>
      if rDiagonalWord false (2 * (k + 1)) i then Star.star a else a)
    (fun i => Submonoid.subset_closure (by split <;> simp))
  simpa only [rDiagonalDeterminingSequence_def, Function.comp_def,
    rDiagonalWord_finRotate _ (even_two_mul _), Bool.not_false] using hr.symm

namespace IsRDiagonal

/-- An R-diagonal element has a tracial generated star algebra if and only if its two
determining sequences agree. No trace on the ambient algebra is required. -/
theorem forall_apply_mul_comm_iff_rDiagonalDeterminingSequence_eq [StarRing R] [StarModule R A]
    (h : IsRDiagonal φ a) :
    (∀ x ∈ StarAlgebra.adjoin R {a}, ∀ y ∈ StarAlgebra.adjoin R {a},
      φ (x * y) = φ (y * x)) ↔
      ∀ k, rDiagonalDeterminingSequence φ a false k =
        rDiagonalDeterminingSequence φ a true k := by
  have hle : Submonoid.closure {a, Star.star a} ≤
      (StarAlgebra.adjoin R {a}).toSubalgebra.toSubmonoid := by
    rw [Submonoid.closure_le]
    intro x hx
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    change x ∈ (StarAlgebra.adjoin R {a}).toSubalgebra
    rw [StarSubalgebra.mem_toSubalgebra]
    rcases hx with hx | hx
    · rw [hx]
      exact StarAlgebra.self_mem_adjoin_singleton R a
    · rw [hx]
      exact StarAlgebra.star_self_mem_adjoin_singleton R a
  exact ⟨fun htr => rDiagonalDeterminingSequence_eq_of_apply_mul_comm
    (fun x hx y hy => htr x (StarSubalgebra.mem_toSubalgebra.mp
      (show x ∈ (StarAlgebra.adjoin R {a}).toSubalgebra from hle hx)) y
      (StarSubalgebra.mem_toSubalgebra.mp
        (show y ∈ (StarAlgebra.adjoin R {a}).toSubalgebra from hle hy))),
    fun hc _ hx _ hy => h.apply_mul_comm_of_mem_adjoin hc hx hy⟩

end IsRDiagonal

end TauCeti
