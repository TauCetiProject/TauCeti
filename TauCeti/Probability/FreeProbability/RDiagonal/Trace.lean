module

public import TauCeti.Probability.FreeProbability.RDiagonal.Basic
import TauCeti.Probability.FreeProbability.Cumulant.Trace

/-!
# Traciality of R-diagonal distributions

An R-diagonal element has a tracial distribution exactly when its two determining sequences
agree. The trace is required only on the generated unital star algebra, not on the ambient
algebra. This criterion distinguishes general R-diagonal elements, with two determining
sequences, from their tracial specialization, with just one.

The proof uses the fact that cyclic rotation exchanges the two even alternating words.
All other cumulants vanish, so agreement of the determining sequences gives cyclicity of
every joint cumulant and hence traciality of every star-polynomial moment. No positivity,
faithfulness, or analytic realization is needed.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 15.
-/

public section

open Finset

namespace TauCeti

/-- Rotating an even alternating word exchanges its starting letter, including the wrap
from the last position to the first. -/
theorem rDiagonalWord_finRotate (c : Bool) {n : ℕ} (hn : Even n) (i : Fin n) :
    rDiagonalWord c n (finRotate n i) = rDiagonalWord (!c) n i := by
  cases n with
  | zero => exact i.elim0
  | succ n =>
    have hn' : ¬ Even n := Nat.even_add_one.mp hn
    by_cases hi : i = Fin.last n
    · subst i
      simp [rDiagonalWord_apply, hn']
    · simp only [rDiagonalWord_apply, coe_finRotate_of_ne_last hi, Nat.even_add_one]
      by_cases he : Even (i : ℕ) <;> simp [he]

variable {R A : Type*} [CommRing R] [Semiring A] [Algebra R A] [StarRing A]
  {φ : A →ₗ[R] R} {a : A}

namespace IsRDiagonal

/-- If the two determining sequences agree, all joint cumulants in an R-diagonal element
and its adjoint are cyclically invariant. -/
theorem freeCumulant_comp_finRotate (h : IsRDiagonal φ a)
    (hc : ∀ k, rDiagonalDeterminingSequence φ a false k =
      rDiagonalDeterminingSequence φ a true k) {n : ℕ} (w : Fin n → Bool) :
    freeCumulant φ (fun i => if w (finRotate n i) then Star.star a else a) univ =
      freeCumulant φ (fun i => if w i then Star.star a else a) univ := by
  by_cases hn : n = 0
  · subst n
    simp [freeCumulant_empty]
  by_cases hw : ∃ k c, n = 2 * (k + 1) ∧ ∀ i, w i = rDiagonalWord c n i
  · obtain ⟨k, c, rfl, hw⟩ := hw
    have he : Even (2 * (k + 1)) := even_two_mul _
    have hc' : rDiagonalDeterminingSequence φ a (!c) k =
        rDiagonalDeterminingSequence φ a c k := by
      cases c
      · exact (hc k).symm
      · exact hc k
    simpa only [hw, rDiagonalWord_finRotate _ he, rDiagonalDeterminingSequence_def]
      using hc'
  · rw [h.freeCumulant_eq_zero hn w hw, h.freeCumulant_eq_zero hn _ ?_]
    rintro ⟨k, c, rfl, hc⟩
    apply hw
    refine ⟨k, !c, rfl, fun i => ?_⟩
    have hi := hc ((finRotate (2 * (k + 1))).symm i)
    have he := rDiagonalWord_finRotate (!c) (even_two_mul (k + 1))
      ((finRotate (2 * (k + 1))).symm i)
    simp only [Equiv.apply_symm_apply, Bool.not_not] at hi he
    exact hi.trans he.symm

variable [StarRing R] [StarModule R A]

/-- Equality of the two determining sequences makes the functional tracial on the star
algebra generated by the R-diagonal element. -/
theorem apply_mul_comm_of_mem_adjoin (h : IsRDiagonal φ a)
    (hc : ∀ k, rDiagonalDeterminingSequence φ a false k =
      rDiagonalDeterminingSequence φ a true k)
    {x y : A} (hx : x ∈ StarAlgebra.adjoin R ({a} : Set A))
    (hy : y ∈ StarAlgebra.adjoin R ({a} : Set A)) : φ (x * y) = φ (y * x) := by
  have hs : (StarAlgebra.adjoin R ({a} : Set A)).toSubalgebra =
      Algebra.adjoin R (Set.range (fun c : Bool => if c then Star.star a else a)) := by
    rw [StarAlgebra.adjoin_toSubalgebra]
    congr 1
    ext x
    simp only [Set.mem_union, Set.mem_singleton_iff, Set.mem_star,
      Set.mem_range, Bool.exists_bool]
    simp [eq_comm, eq_star_iff_eq_star]
  apply apply_mul_comm_of_mem_adjoin_of_freeCumulant
    (a := fun c : Bool => if c then Star.star a else a)
    (fun n w => h.freeCumulant_comp_finRotate hc w)
  · rw [← hs]
    exact hx
  · rw [← hs]
    exact hy

end IsRDiagonal

/-- A trace on the generated star algebra forces the two alternating cumulant sequences
to agree. This direction does not require R-diagonality. -/
theorem rDiagonalDeterminingSequence_eq_of_mul_comm [StarRing R] [StarModule R A]
    (htr : ∀ x y : StarAlgebra.adjoin R ({a} : Set A),
      φ ((x : A) * (y : A)) = φ ((y : A) * (x : A))) (k : ℕ) :
    rDiagonalDeterminingSequence φ a false k =
      rDiagonalDeterminingSequence φ a true k := by
  let S := StarAlgebra.adjoin R ({a} : Set A)
  let b : S := ⟨a, StarAlgebra.self_mem_adjoin_singleton R a⟩
  let ψ : S → R := fun x => φ x
  have ht : ∀ x y : S, ψ (x * y) = ψ (y * x) := htr
  have hr := TauCeti.freeCumulant_comp_finRotate ht
    (fun i : Fin (2 * (k + 1)) =>
      if rDiagonalWord false (2 * (k + 1)) i then Star.star b else b)
  have hm (c : Bool) :
      freeCumulant ψ (fun i : Fin (2 * (k + 1)) =>
        if rDiagonalWord c (2 * (k + 1)) i then Star.star b else b) univ =
        rDiagonalDeterminingSequence φ a c k := by
    rw [rDiagonalDeterminingSequence_def]
    have hm := freeCumulant_comp_monoidHom (φ : A → R) S.subtype.toAlgHom.toMonoidHom
      (fun i : Fin (2 * (k + 1)) =>
        if rDiagonalWord c (2 * (k + 1)) i then Star.star b else b) univ
    refine hm.trans (freeCumulant_congr φ ?_)
    intro i _
    dsimp only [Function.comp_apply]
    split <;> rfl
  have he : Even (2 * (k + 1)) := even_two_mul _
  simpa only [Function.comp_def, rDiagonalWord_finRotate _ he, Bool.not_false, hm]
    using hr.symm

namespace IsRDiagonal

/-- An R-diagonal element has a tracial generated star algebra if and only if its two
determining sequences agree. No trace on the ambient algebra is required. -/
theorem mul_comm_iff_determiningSequence_eq [StarRing R] [StarModule R A]
    (h : IsRDiagonal φ a) :
    (∀ x y : StarAlgebra.adjoin R ({a} : Set A),
      φ ((x : A) * (y : A)) = φ ((y : A) * (x : A))) ↔
      ∀ k, rDiagonalDeterminingSequence φ a false k =
        rDiagonalDeterminingSequence φ a true k := by
  refine ⟨fun htr k => rDiagonalDeterminingSequence_eq_of_mul_comm htr k, fun hc x y => ?_⟩
  exact h.apply_mul_comm_of_mem_adjoin hc x.property y.property

end IsRDiagonal

end TauCeti
