module

public import TauCeti.Analysis.StarAlgebra.GNS.Bounded
public import TauCeti.Probability.FreeProbability.FreeProduct.Positive

/-!
# The reduced C⋆-free product associated to states

For normalized positive functionals on a family of unital C⋆-algebras, the positive
algebraic free-product functional has a bounded GNS representation. The reduced product
is the norm closure of its image on the completed GNS space. Its canonical factor maps
preserve the prescribed states and are freely independent for the vacuum state, whose
cyclic orbit is dense.

The construction allows nonfaithful factor states. In particular, no faithfulness of the
vacuum state or injectivity of the factor maps is asserted here.

## References

* D. V. Voiculescu, K. J. Dykema, A. Nica, *Free Random Variables*, §§1.2–1.5.
* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 4.
-/

public section

noncomputable section

open LinearAlgebra.FreeProduct
open scoped ComplexOrder InnerProductSpace InnerProduct

namespace TauCeti
namespace ReducedFreeProduct

variable {I : Type*} [DecidableEq I] {A : I → Type*} [∀ i, CStarAlgebra (A i)]
  (φ : ∀ i, StarPositiveFunctional (A i)) (hφ : ∀ i, φ i 1 = 1)

/-- Every element of the algebraic free product acts boundedly in its state GNS representation. -/
theorem continuous_leftMul (a : LinearAlgebra.FreeProduct ℂ A) :
    Continuous ((freeProductPositiveFunctional φ hφ).leftMul a) := by
  let ψ := freeProductPositiveFunctional φ hφ
  have htop : ψ.boundedSubalgebra = ⊤ := by
    apply eq_top_iff.mpr
    rw [← iSup_range_ιStar ℂ A]
    refine iSup_le fun i x hx => ?_
    obtain ⟨b, rfl⟩ := hx
    exact ψ.mem_boundedSubalgebra.mpr (ψ.continuous_leftMul_of_cstar_source (ιStar ℂ A i) b)
  exact ψ.mem_boundedSubalgebra.mp (htop.symm ▸ trivial)

/-- The completed GNS Hilbert space of the algebraic free-product state. -/
abbrev HilbertSpace := (freeProductPositiveFunctional φ hφ).HilbertGNS

-- Fix the operator carrier before invoking the general topological instances: inferring
-- it from their topology projections otherwise unfolds the algebraic GNS quotient.
private instance : IsTopologicalRing (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) :=
  NonUnitalSeminormedRing.toIsTopologicalRing
    (α := HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ)

private instance : ContinuousStar (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) :=
  ⟨(ContinuousLinearMap.adjoint :
    (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) ≃ₗᵢ⋆[ℂ]
      (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ)).continuous⟩

/-- The bounded left regular representation of the algebraic free product. -/
def representation : LinearAlgebra.FreeProduct ℂ A →⋆ₐ[ℂ]
    (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) :=
  (freeProductPositiveFunctional φ hφ).boundedRepresentation (continuous_leftMul φ hφ)

@[simp]
theorem representation_hilbertClassMap (a b : LinearAlgebra.FreeProduct ℂ A) :
    representation φ hφ a ((freeProductPositiveFunctional φ hφ).hilbertClassMap b) =
      (freeProductPositiveFunctional φ hφ).hilbertClassMap (a * b) :=
  (freeProductPositiveFunctional φ hφ).boundedRepresentation_hilbertClassMap _ a b

/-- The vacuum vector, represented by the unit of the algebraic free product. -/
def vacuum : HilbertSpace φ hφ :=
  (freeProductPositiveFunctional φ hφ).hilbertCyclicVector

@[simp]
theorem norm_vacuum : ‖vacuum φ hφ‖ = 1 :=
  (freeProductPositiveFunctional φ hφ).norm_hilbertCyclicVector
    (freeProductPositiveFunctional_one φ hφ)

@[simp]
theorem representation_vacuum (a : LinearAlgebra.FreeProduct ℂ A) :
    representation φ hφ a (vacuum φ hφ) =
      (freeProductPositiveFunctional φ hφ).hilbertClassMap a :=
  (freeProductPositiveFunctional φ hφ).boundedRepresentation_hilbertCyclicVector _ a

/-- The represented algebraic free-product orbit of the vacuum is dense. -/
theorem denseRange_representation_vacuum :
    DenseRange (fun a => representation φ hφ a (vacuum φ hφ)) :=
  (freeProductPositiveFunctional φ hφ).denseRange_boundedRepresentation_hilbertCyclicVector _

/-- The reduced C⋆-free product, as the closed star subalgebra generated by the represented
algebraic free product on its GNS Hilbert space. -/
def algebra : StarSubalgebra ℂ (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) :=
  (representation φ hφ).range.topologicalClosure

/-- The reduced algebra has the operator-norm topology and is closed. -/
instance isClosed_algebra : IsClosed (algebra φ hφ : Set
    (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ)) :=
  isClosed_closure

/-- The reduced algebra carries the inherited C⋆-algebra structure. The explicit delegate
also exposes this structure through the named public carrier. -/
instance cstarAlgebra : CStarAlgebra (algebra φ hφ) :=
  StarSubalgebra.cstarAlgebra (algebra φ hφ)

/-- The reduced algebra is complete in its inherited operator-norm uniformity. -/
instance completeSpace : CompleteSpace (algebra φ hφ) :=
  (isClosed_algebra φ hφ).completeSpace_coe

-- These native delegates make the lower operation classes discoverable through the
-- named carrier, including for an empty family, without changing its inherited data.
instance one : One (algebra φ hφ) := OneMemClass.one (algebra φ hφ)

instance zero : Zero (algebra φ hφ) := ZeroMemClass.zero (algebra φ hφ)

instance mulOneClass : MulOneClass (algebra φ hφ) :=
  SubmonoidClass.toMulOneClass (algebra φ hφ)

instance addZeroClass : AddZeroClass (algebra φ hφ) :=
  AddSubmonoidClass.toAddZeroClass (algebra φ hφ)

instance starMul : StarMul (algebra φ hφ) :=
  (StarSubalgebra.starRing (algebra φ hφ)).toStarMul

/-- Membership in the reduced algebra is membership in the closure of the represented range. -/
theorem mem_algebra_iff (T : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) :
    T ∈ algebra φ hφ ↔ T ∈ closure (Set.range (representation φ hφ)) :=
  Iff.rfl

/-- The canonical dense algebraic map into the reduced C⋆-free product. -/
def ofAlgebraic : LinearAlgebra.FreeProduct ℂ A →⋆ₐ[ℂ] algebra φ hφ :=
  (representation φ hφ).codRestrict (algebra φ hφ)
    fun a => (mem_algebra_iff φ hφ _).mpr (subset_closure ⟨a, rfl⟩)

@[simp]
theorem coe_ofAlgebraic (a : LinearAlgebra.FreeProduct ℂ A) :
    (ofAlgebraic φ hφ a : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) =
      representation φ hφ a := (rfl)

/-- Algebraic elements are norm dense in the reduced product. -/
theorem denseRange_ofAlgebraic : DenseRange (ofAlgebraic φ hφ) := by
  rw [DenseRange, Subtype.dense_iff, ← Set.range_comp]
  intro T hT
  simpa only [Function.comp_def, coe_ofAlgebraic] using (mem_algebra_iff φ hφ T).mp hT

/-- The canonical homomorphism from a factor into the reduced product. It need not be injective
when the factor's GNS representation has a kernel. -/
def factor (i : I) : A i →⋆ₐ[ℂ] algebra φ hφ :=
  (ofAlgebraic φ hφ).comp (ιStar ℂ A i)

@[simp]
theorem factor_apply (i : I) (a : A i) :
    factor φ hφ i a = ofAlgebraic φ hφ (ι ℂ A i a) := by
  simp [factor]

/-- The vacuum state on the reduced C⋆-free product. -/
def state : algebra φ hφ →ₚ[ℂ] ℂ :=
  PositiveLinearMap.mk₀
    ((freeProductPositiveFunctional φ hφ).hilbertPositiveLinearMap.toLinearMap.comp
      (algebra φ hφ).subtype.toAlgHom.toLinearMap)
    fun _ hT => (freeProductPositiveFunctional φ hφ).hilbertPositiveLinearMap.map_nonneg hT

-- Keep state evaluation bundled so the factor and algebraic restriction simp rules match.
theorem state_apply (T : algebra φ hφ) :
    state φ hφ T = ⟪vacuum φ hφ, (T : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ)
      (vacuum φ hφ)⟫_ℂ := by
  exact (freeProductPositiveFunctional φ hφ).hilbertPositiveLinearMap_apply T

@[simp]
theorem state_ofAlgebraic (a : LinearAlgebra.FreeProduct ℂ A) :
    state φ hφ (ofAlgebraic φ hφ a) = freeProductPositiveFunctional φ hφ a := by
  rw [state_apply, coe_ofAlgebraic, representation_vacuum, vacuum]
  exact (freeProductPositiveFunctional φ hφ).inner_hilbertCyclicVector_hilbertClassMap a

@[simp]
theorem state_one : state φ hφ 1 = 1 := by
  simpa using state_ofAlgebraic φ hφ 1

/-- The reduced-product vacuum state restricts to each prescribed factor state. -/
theorem state_factor (i : I) (a : A i) : state φ hφ (factor φ hφ i a) = φ i a := by
  exact (congrArg (state φ hφ) (factor_apply φ hφ i a)).trans
    ((state_ofAlgebraic φ hφ (ι ℂ A i a)).trans (freeProductPositiveFunctional_ι φ hφ i a))

/-- The factor ranges are freely independent for the vacuum state. -/
theorem isFreelyIndependent_factor :
    IsFreelyIndependent (state φ hφ).toLinearMap
      (fun i => (factor φ hφ i).toAlgHom.range) := by
  have h := (isFreelyIndependent_freeProductExpectation
    (fun i => (φ i).toLinearMap) hφ).map (ofAlgebraic φ hφ).toAlgHom
    (φ' := (state φ hφ).toLinearMap)
    (by
      ext a
      exact (state_ofAlgebraic φ hφ a).trans (freeProductPositiveFunctional_apply φ hφ a))
  -- The native C⋆-algebra delegate preserves the inherited scalar-action projections;
  -- identify these data instances before comparing the factor ranges.
  convert h using 1 <;> try rfl
  funext i
  simpa only [factor, StarAlgHom.comp, ιStar_toAlgHom] using
    AlgHom.range_comp (ι ℂ A i) (ofAlgebraic φ hφ).toAlgHom

/-- The vacuum remains cyclic for the closed reduced product. -/
theorem denseRange_algebra_vacuum :
    DenseRange (fun T : algebra φ hφ =>
      (T : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) (vacuum φ hφ)) := by
  apply (denseRange_representation_vacuum φ hφ).mono
  rintro _ ⟨a, rfl⟩
  exact ⟨ofAlgebraic φ hφ a, by simp only [coe_ofAlgebraic]⟩

end ReducedFreeProduct
end TauCeti
