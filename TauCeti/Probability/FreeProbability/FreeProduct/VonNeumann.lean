module

public import TauCeti.Analysis.VonNeumannAlgebra.Density
public import TauCeti.Probability.FreeProbability.FreeProduct.Reduced
public import TauCeti.Probability.FreeProbability.WeakClosure

/-!
# The von Neumann envelope of a reduced C⋆-free product

Let `φ i` be normalized positive functionals on a family of unital C⋆-algebras `A i`. On the
completed GNS Hilbert space of the algebraic free-product state, the reduced C⋆-free product
`ReducedFreeProduct.algebra φ hφ` generates the concrete von Neumann algebra
`ReducedFreeProduct.vonNeumannAlgebra φ hφ`, defined as its double commutant via
`VonNeumannAlgebra.adjoin`.

The vacuum vector state restricts to a state `vonNeumannState φ hφ` on this von Neumann algebra,
compatible with the C⋆-reduced vacuum state along the canonical inclusion `toVonNeumann φ hφ`.
By the bicommutant theorem and weak-operator persistence of freeness for vector states, not only
the factor images `vonNeumannFactor φ hφ i` are freely independent, but so are the von Neumann
subalgebras they generate inside `vonNeumannAlgebra φ hφ`. When every input functional `φ i` is
tracial, the vacuum vector state is tracial on the entire generated von Neumann algebra by the
von Neumann density theorem.

## Main declarations

* `TauCeti.ReducedFreeProduct.vonNeumannAlgebra`: the von Neumann algebra generated by the
  reduced C⋆-free product on its GNS Hilbert space.
* `TauCeti.ReducedFreeProduct.toVonNeumann`: the canonical inclusion of the reduced C⋆-algebra
  into its generated von Neumann algebra.
* `TauCeti.ReducedFreeProduct.vonNeumannFactor`: the canonical homomorphism from each factor into
  `vonNeumannAlgebra φ hφ`.
* `TauCeti.ReducedFreeProduct.vonNeumannState`: the vacuum vector state on
  `vonNeumannAlgebra φ hφ`.
* `TauCeti.ReducedFreeProduct.vonNeumannState_mul_comm`: traciality of the vacuum state on
  `vonNeumannAlgebra φ hφ` when all input functionals are tracial.
* `TauCeti.ReducedFreeProduct.isFreelyIndependent_vonNeumannFactor` and
  `TauCeti.ReducedFreeProduct.isFreelyIndependent_adjoin_vonNeumannFactor`: freeness of the factor
  images and of the von Neumann subalgebras they generate.

## References

* D. V. Voiculescu, K. J. Dykema, A. Nica, *Free Random Variables*, CRM Monograph Ser. 1,
  Amer. Math. Soc. (1992), §1.5.
* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 7.
-/

public section

noncomputable section

open scoped ComplexOrder InnerProductSpace

namespace TauCeti
namespace ReducedFreeProduct

variable {I : Type*} [DecidableEq I] {A : I → Type*} [∀ i, CStarAlgebra (A i)]
  (φ : ∀ i, StarPositiveFunctional (A i)) (hφ : ∀ i, φ i 1 = 1)

/-- The concrete von Neumann algebra generated by the reduced C⋆-free product on its completed GNS
Hilbert space. -/
def vonNeumannAlgebra : VonNeumannAlgebra (HilbertSpace φ hφ) :=
  VonNeumannAlgebra.adjoin (algebra φ hφ : Set (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ))

/-- `vonNeumannAlgebra φ hφ` is a `StarOrderedRing` under the inherited operator order. -/
instance isStarOrderedRing_vonNeumannAlgebra : StarOrderedRing (vonNeumannAlgebra φ hφ) :=
  starOrderedRing_subtype (vonNeumannAlgebra φ hφ)

/-- The canonical unital star-algebra inclusion of the reduced C⋆-free product into the von Neumann
algebra it generates. -/
def toVonNeumann : algebra φ hφ →⋆ₐ[ℂ] vonNeumannAlgebra φ hφ where
  toFun x := ⟨x.1, VonNeumannAlgebra.subset_adjoin _ x.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl
  map_star' _ := rfl

@[simp]
theorem coe_toVonNeumann (x : algebra φ hφ) :
    (toVonNeumann φ hφ x : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) = x :=
  (rfl)

/-- The canonical homomorphism from the `i`-th factor into `vonNeumannAlgebra φ hφ`. -/
def vonNeumannFactor (i : I) : A i →⋆ₐ[ℂ] vonNeumannAlgebra φ hφ :=
  (toVonNeumann φ hφ).comp (factor φ hφ i)

@[simp]
theorem vonNeumannFactor_apply (i : I) (a : A i) :
    vonNeumannFactor φ hφ i a = toVonNeumann φ hφ (factor φ hφ i a) :=
  (rfl)

/-- The vacuum vector state on `vonNeumannAlgebra φ hφ`. -/
def vonNeumannState : vonNeumannAlgebra φ hφ →ₚ[ℂ] ℂ :=
  PositiveLinearMap.mk₀
    ((ContinuousLinearMap.innerPositiveLinearMap ℂ (vacuum φ hφ)).toLinearMap.comp
      (SubalgebraClass.val (vonNeumannAlgebra φ hφ)).toLinearMap)
    fun _ hT => (ContinuousLinearMap.innerPositiveLinearMap ℂ (vacuum φ hφ)).map_nonneg hT

/-- `vonNeumannState φ hφ` evaluates an operator in `vonNeumannAlgebra φ hφ` at the vacuum
vector. -/
theorem vonNeumannState_apply (T : vonNeumannAlgebra φ hφ) :
    vonNeumannState φ hφ T =
      ⟪vacuum φ hφ, (T : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) (vacuum φ hφ)⟫_ℂ :=
  ContinuousLinearMap.innerPositiveLinearMap_apply (𝕜 := ℂ) (vacuum φ hφ)
    (T : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ)

@[simp]
theorem vonNeumannState_toVonNeumann (x : algebra φ hφ) :
    vonNeumannState φ hφ (toVonNeumann φ hφ x) = state φ hφ x :=
  (vonNeumannState_apply φ hφ (toVonNeumann φ hφ x)).trans (state_apply φ hφ x).symm

@[simp]
theorem vonNeumannState_one : vonNeumannState φ hφ 1 = 1 := by
  rw [← map_one (toVonNeumann φ hφ), vonNeumannState_toVonNeumann, state_one]

/-- The vacuum state on `vonNeumannAlgebra φ hφ` restricts to each prescribed factor functional. -/
theorem vonNeumannState_vonNeumannFactor (i : I) (a : A i) :
    vonNeumannState φ hφ (vonNeumannFactor φ hφ i a) = φ i a := by
  rw [vonNeumannFactor_apply, vonNeumannState_toVonNeumann, state_factor]

/-- If each prescribed factor functional is tracial, the vacuum state is tracial on the generated
von Neumann algebra. -/
theorem vonNeumannState_mul_comm (htr : ∀ i (a b : A i), φ i (a * b) = φ i (b * a))
    (x y : vonNeumannAlgebra φ hφ) :
    vonNeumannState φ hφ (x * y) = vonNeumannState φ hφ (y * x) := by
  refine (vonNeumannState_apply φ hφ (x * y)).trans <|
    (VonNeumannAlgebra.inner_mul_comm_of_mem_adjoin
      (s := (algebra φ hφ : Set (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ))) ?_ x.2 y.2).trans
      (vonNeumannState_apply φ hφ (y * x)).symm
  rw [StarAlgebra.adjoin_eq]
  intro s hs t ht
  exact (state_apply φ hφ ⟨s * t, mul_mem hs ht⟩).symm.trans <|
    (state_mul_comm φ hφ htr ⟨s, hs⟩ ⟨t, ht⟩).trans (state_apply φ hφ ⟨t * s, mul_mem ht hs⟩)

/-- The factor ranges in `vonNeumannAlgebra φ hφ` are freely independent for `vonNeumannState`. -/
theorem isFreelyIndependent_vonNeumannFactor :
    IsFreelyIndependent (vonNeumannState φ hφ).toLinearMap
      (fun i => (vonNeumannFactor φ hφ i).toAlgHom.range) := by
  have h := (isFreelyIndependent_factor φ hφ).map (toVonNeumann φ hφ).toAlgHom
    (φ' := (vonNeumannState φ hφ).toLinearMap)
    (by ext x; exact vonNeumannState_toVonNeumann φ hφ x)
  have hranges : (fun i => (vonNeumannFactor φ hφ i).toAlgHom.range) =
      (fun i => ((factor φ hφ i).toAlgHom.range).map (toVonNeumann φ hφ).toAlgHom) := by
    funext i
    exact AlgHom.range_comp (factor φ hφ i).toAlgHom (toVonNeumann φ hφ).toAlgHom
  simpa only [← hranges] using h

/-- The von Neumann subalgebras generated by the factors, pulled back to
`vonNeumannAlgebra φ hφ`, are freely independent for `vonNeumannState`. -/
theorem isFreelyIndependent_adjoin_vonNeumannFactor :
    IsFreelyIndependent (vonNeumannState φ hφ).toLinearMap fun i =>
      (VonNeumannAlgebra.adjoin (Set.range fun a =>
        (vonNeumannFactor φ hφ i a : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ))).toSubalgebra.comap
        (SubalgebraClass.val (vonNeumannAlgebra φ hφ)) := by
  let ω := (ContinuousLinearMap.innerPositiveLinearMap ℂ (vacuum φ hφ)).toLinearMap
  have hωξ (T : HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) :
      ω T = ⟪vacuum φ hφ, T (vacuum φ hφ)⟫_ℂ :=
    ContinuousLinearMap.innerPositiveLinearMap_apply (𝕜 := ℂ) (vacuum φ hφ) T
  have hω1 : ω 1 = 1 := vonNeumannState_one φ hφ
  let S : I → StarSubalgebra ℂ (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ) :=
    fun i => ((algebra φ hφ).subtype.comp (factor φ hφ i)).range
  have hS : IsFreelyIndependent ω (fun i => (S i).toSubalgebra) := by
    have hmap := (isFreelyIndependent_factor φ hφ).map (algebra φ hφ).subtype.toAlgHom
      (φ' := ω) (LinearMap.ext fun x => (hωξ x).trans (state_apply φ hφ x).symm)
    have hranges : (fun i => (S i).toSubalgebra) =
        (fun i => ((factor φ hφ i).toAlgHom.range).map (algebra φ hφ).subtype.toAlgHom) := by
      funext i
      exact AlgHom.range_comp (factor φ hφ i).toAlgHom (algebra φ hφ).subtype.toAlgHom
    simpa only [← hranges] using hmap
  have hvn : IsFreelyIndependent ω fun i =>
      (VonNeumannAlgebra.adjoin (Set.range fun a =>
        (vonNeumannFactor φ hφ i a :
          HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ))).toSubalgebra :=
    (isFreelyIndependent_vonNeumannAlgebra_adjoin_starSubalgebra_iff_of_vectorState
      hω1 (vacuum φ hφ) hωξ).2 hS
  exact hvn.comap (SubalgebraClass.val (vonNeumannAlgebra φ hφ))

end ReducedFreeProduct
end TauCeti
