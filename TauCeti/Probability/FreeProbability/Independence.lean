/-!
# Free independence of subalgebras

Let `A` be a unital algebra over a commutative semiring `R` and let `φ : A →ₗ[R] R` be a linear
functional. A family of unital subalgebras `B i` of `A` is *freely independent* with respect to
`φ` if `φ (a₁ * ⋯ * aₙ) = 0` whenever `n ≥ 1`, each `aⱼ` lies in some `B iⱼ` and is centred,
`φ aⱼ = 0`, and consecutive labels differ, `iⱼ ≠ iⱼ₊₁`. Labels that are not adjacent may
coincide. In free probability `R = ℂ` and `φ` is normalised, `φ 1 = 1`; here normalisation is a
separate hypothesis of the results that use it, and no positivity or traciality is assumed.
The definition and basic transport lemmas work over semirings; the centring expansions and their
consequences require rings.

A word `a₁ ⋯ aₙ` is encoded as a list `[(i₁, a₁), …, (iₙ, aₙ)]` of label–element pairs, whose
value is the ordered product of the list of elements.

Over rings, for a normalised functional, every word reduces by merging adjacent letters with
equal labels and by centring letters one at a time, to centred alternating words and to shorter
words. Hence the subalgebra generated by the family is spanned by `1` and the values of the
centred alternating words, on which free functionals vanish. Two consequences are proved:
freeness determines a normalised functional on the generated subalgebra from its restrictions to
the individual members, and freeness is preserved by grouping the members along disjoint sets of
labels.

## Main definitions

* `TauCeti.IsFreelyIndependent φ B` — the subalgebras `B i` are freely independent with respect
  to `φ`, unfolded by `TauCeti.isFreelyIndependent_iff`.
* `TauCeti.centeredAlternatingProds φ B` — the values of the nonempty centred alternating words,
  with `TauCeti.isFreelyIndependent_iff_span_le_ker` characterising freeness as the vanishing of
  `φ` on their span.

## Main results

* `TauCeti.IsFreelyIndependent.mono`, `TauCeti.IsFreelyIndependent.comp` and
  `TauCeti.IsFreelyIndependent.map` — freeness passes to smaller subalgebras, to subfamilies
  along injective reindexings, and to images under algebra homomorphisms intertwining the
  functionals.
* `TauCeti.isFreelyIndependent_of_subsingleton` — a family with at most one member, in particular
  the empty family, is free.
* `TauCeti.isFreelyIndependent_domRestrict_iff` — for a normalised functional, members equal to the
  scalars may be added to or removed from a free family.
* `TauCeti.IsFreelyIndependent.apply_mul_of_ne` — the first mixed moment factorises,
  `φ (a * b) = φ a * φ b`; `TauCeti.IsFreelyIndependent.apply_mul_mul_of_ne` and
  `TauCeti.IsFreelyIndependent.apply_mul_mul_mul_of_ne` compute the alternating mixed moments of
  orders three and four.
* `TauCeti.IsFreelyIndependent.sub_mul_sub_eq_zero_of_commute` — freeness is not
  classical independence: for commuting letters from distinct members the product of their
  variances vanishes.
* `TauCeti.toSubmodule_iSup_eq_span_insert_one_centeredAlternatingProds` — for a normalised
  functional, `1` and the values of the centred alternating words span the generated subalgebra;
  `TauCeti.IsFreelyIndependent.mem_span_centeredAlternatingProds_iff` identifies, for a free
  family, the span of the latter with the centred elements of the generated subalgebra.
* `TauCeti.IsFreelyIndependent.eqOn_iSup` — two normalised functionals for which the family is
  free and which agree on each member agree on the subalgebra the family generates, with
  `TauCeti.IsFreelyIndependent.eq_of_iSup_eq_top` the case of a generating family.
* `TauCeti.IsFreelyIndependent.iSup_fiber` — for a normalised functional and `g : ι → κ`, the
  subalgebras generated by the members over the fibres of `g` are free.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 5.
-/

public section

open scoped Pointwise

namespace TauCeti

variable {R A A' ι κ : Type*}

section Semiring

variable [CommSemiring R] [Semiring A] [Algebra R A] [Semiring A'] [Algebra R A']

/-- Subalgebras `B i` of `A` are *freely independent* with respect to a linear functional `φ` if
`φ (a₁ * ⋯ * aₙ) = 0` for every nonempty word `[(i₁, a₁), …, (iₙ, aₙ)]` whose consecutive labels
are distinct and whose letters satisfy `aⱼ ∈ B iⱼ` and `φ aⱼ = 0`. Labels that are not adjacent
may coincide. -/
def IsFreelyIndependent (φ : A →ₗ[R] R) (B : ι → Subalgebra R A) : Prop :=
  ∀ w : List (ι × A), w ≠ [] → (w.map Prod.fst).IsChain (· ≠ ·) → (∀ x ∈ w, x.2 ∈ B x.1) →
    (∀ x ∈ w, φ x.2 = 0) → φ (w.map Prod.snd).prod = 0

theorem isFreelyIndependent_iff {φ : A →ₗ[R] R} {B : ι → Subalgebra R A} :
    IsFreelyIndependent φ B ↔
      ∀ w : List (ι × A), w ≠ [] → (w.map Prod.fst).IsChain (· ≠ ·) →
        (∀ x ∈ w, x.2 ∈ B x.1) → (∀ x ∈ w, φ x.2 = 0) → φ (w.map Prod.snd).prod = 0 :=
  Iff.rfl

/-- The values `a₁ * ⋯ * aₙ` of the nonempty words `[(i₁, a₁), …, (iₙ, aₙ)]` whose consecutive
labels are distinct and whose letters satisfy `aⱼ ∈ B iⱼ` and `φ aⱼ = 0`: the values of the
centred alternating words, on which a free functional vanishes by definition. -/
def centeredAlternatingProds (φ : A →ₗ[R] R) (B : ι → Subalgebra R A) : Set A :=
  {p | ∃ w : List (ι × A), w ≠ [] ∧ (w.map Prod.fst).IsChain (· ≠ ·) ∧ (∀ x ∈ w, x.2 ∈ B x.1) ∧
    (∀ x ∈ w, φ x.2 = 0) ∧ (w.map Prod.snd).prod = p}

theorem mem_centeredAlternatingProds {φ : A →ₗ[R] R} {B : ι → Subalgebra R A} {p : A} :
    p ∈ centeredAlternatingProds φ B ↔
      ∃ w : List (ι × A), w ≠ [] ∧ (w.map Prod.fst).IsChain (· ≠ ·) ∧ (∀ x ∈ w, x.2 ∈ B x.1) ∧
        (∀ x ∈ w, φ x.2 = 0) ∧ (w.map Prod.snd).prod = p :=
  Iff.rfl

/-- Freeness says exactly that `φ` vanishes on the span of the values of the centred alternating
words. -/
theorem isFreelyIndependent_iff_span_le_ker {φ : A →ₗ[R] R} {B : ι → Subalgebra R A} :
    IsFreelyIndependent φ B ↔
      Submodule.span R (centeredAlternatingProds φ B) ≤ LinearMap.ker φ := by
  rw [Submodule.span_le]
  constructor
  · rintro h _ ⟨w, hne, halt, hw, hc, rfl⟩
    exact h w hne halt hw hc
  · intro h w hne halt hw hc
    exact h ⟨w, hne, halt, hw, hc, rfl⟩

/-- A family with at most one member is free: an alternating word then has a single letter. -/
theorem isFreelyIndependent_of_subsingleton [Subsingleton ι] (φ : A →ₗ[R] R)
    (B : ι → Subalgebra R A) : IsFreelyIndependent φ B := by
  rintro (_ | ⟨x, _ | ⟨y, w⟩⟩) hne halt - hc
  · exact (hne rfl).elim
  · simpa using hc x (by simp)
  · simp only [List.map_cons, List.isChain_cons_cons] at halt
    exact (halt.1 (Subsingleton.elim _ _)).elim

namespace IsFreelyIndependent

variable {φ : A →ₗ[R] R} {B C : ι → Subalgebra R A}

/-- Freeness passes to smaller subalgebras. -/
theorem mono (h : IsFreelyIndependent φ B) (hCB : ∀ i, C i ≤ B i) : IsFreelyIndependent φ C :=
  fun w hne halt hw hc => h w hne halt (fun x hx => hCB _ (hw x hx)) hc

/-- Freeness passes to subfamilies along an injective reindexing. -/
theorem comp (h : IsFreelyIndependent φ B) {e : κ → ι} (he : Function.Injective e) :
    IsFreelyIndependent φ (B ∘ e) := by
  intro w hne halt hw hc
  simpa [List.map_map, Prod.map_snd'] using h (w.map (Prod.map e id)) (by simpa using hne)
    (by simpa [List.map_map, List.isChain_map, he.ne_iff] using halt)
    (fun _ hx => by obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx; exact hw y hy)
    (fun _ hx => by obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx; exact hc y hy)

/-- Freeness is transported along an algebra homomorphism `f` intertwining the functionals:
the images of a free family are free. -/
theorem map (h : IsFreelyIndependent φ B) (f : A →ₐ[R] A') {φ' : A' →ₗ[R] R}
    (hf : φ'.comp f.toLinearMap = φ) : IsFreelyIndependent φ' fun i => (B i).map f := by
  intro w hne halt hw hc
  choose g hgB hgf using fun x (hx : x ∈ w) => Subalgebra.mem_map.1 (hw x hx)
  have hφ (a : A) : φ' (f a) = φ a := by simpa using LinearMap.congr_fun hf a
  let w' : List (ι × A) := w.pmap (fun x hx => (x.1, g x hx)) fun _ hx => hx
  have hsnd : (w'.map Prod.snd).map f = w.map Prod.snd := by simp [w', List.map_pmap, hgf]
  have hfst : w'.map Prod.fst = w.map Prod.fst := by simp [w', List.map_pmap]
  rw [← hsnd, ← map_list_prod, hφ]
  refine h w' (by simpa [w'] using hne) (hfst ▸ halt) (fun y hy => ?_) fun y hy => ?_
  · obtain ⟨x, hx, rfl⟩ := List.mem_pmap.1 hy
    exact hgB x hx
  · obtain ⟨x, hx, rfl⟩ := List.mem_pmap.1 hy
    rw [← hφ, hgf]
    exact hc x hx

/-- Pulling back a free family and its functional along an algebra homomorphism preserves
freeness. The homomorphism need not be injective: letters in its kernel have zero expectation. -/
theorem comap {φ' : A' →ₗ[R] R} {B' : ι → Subalgebra R A'}
    (h : IsFreelyIndependent φ' B') (f : A →ₐ[R] A') :
    IsFreelyIndependent (φ'.comp f.toLinearMap) fun i => (B' i).comap f := by
  intro w hne halt hw hc
  have hz := h (w.map (Prod.map id f)) (by simpa using hne)
    (by simpa [List.map_map, Function.comp_def] using halt)
    (by
      simp only [List.mem_map]
      rintro _ ⟨x, hx, rfl⟩
      exact hw x hx)
    (by
      simp only [List.mem_map]
      rintro _ ⟨x, hx, rfl⟩
      exact hc x hx)
  simpa [List.map_map, Function.comp_def, map_list_prod] using hz

end IsFreelyIndependent

/-- For a normalised functional, members of a family equal to the scalars do not affect freeness:
if `B i = ⊥` for every label outside `s`, then `B` is free exactly when its restriction to `s`
is free. -/
theorem isFreelyIndependent_domRestrict_iff {φ : A →ₗ[R] R} (hφ : φ 1 = 1)
    {B : ι → Subalgebra R A} {s : Set ι} (hs : ∀ i ∉ s, B i = ⊥) :
    IsFreelyIndependent φ (s.domRestrict B) ↔ IsFreelyIndependent φ B := by
  refine ⟨fun h => ?_, fun h => h.comp Subtype.val_injective⟩
  intro w hne halt hw hc
  by_cases hsw : ∀ x ∈ w, x.1 ∈ s
  · -- All labels lie in `s`: lift the word to a word labelled by `s`.
    let w' : List (s × A) := w.pmap (fun x hx => (⟨x.1, hx⟩, x.2)) hsw
    have hsnd : w'.map Prod.snd = w.map Prod.snd := by simp [w', List.map_pmap]
    have hfst : (w'.map Prod.fst).map Subtype.val = w.map Prod.fst := by
      simp [w', List.map_pmap]
    rw [← hfst, List.isChain_map] at halt
    rw [← hsnd]
    refine h w' (by simpa [w'] using hne) (halt.imp fun _ _ hab h => hab (congrArg _ h))
      (fun y hy => ?_) fun y hy => ?_
    · obtain ⟨x, hx, rfl⟩ := List.mem_pmap.1 hy
      exact hw x hx
    · obtain ⟨x, hx, rfl⟩ := List.mem_pmap.1 hy
      exact hc x hx
  · -- Some letter is a centred scalar, hence zero.
    push Not at hsw
    obtain ⟨x, hx, hxs⟩ := hsw
    obtain ⟨c, hcx⟩ := Algebra.mem_bot.1 (hs x.1 hxs ▸ hw x hx)
    have hx0 : x.2 = 0 := by
      have := hc x hx
      rw [← hcx, Algebra.algebraMap_eq_smul_one, map_smul, hφ, smul_eq_mul, mul_one] at this
      rw [← hcx, this, map_zero]
    rw [List.prod_eq_zero (List.mem_map.2 ⟨x, hx, hx0⟩), map_zero]

end Semiring

section Ring

variable [CommRing R] [Ring A] [Algebra R A]

namespace IsFreelyIndependent

variable {φ : A →ₗ[R] R} {B : ι → Subalgebra R A}

/-- The first mixed moment of a free family factorises: for a normalised functional and letters
from members with distinct labels, `φ (a * b) = φ a * φ b`. -/
theorem apply_mul_of_ne (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1) {i j : ι} (hij : i ≠ j)
    {a b : A} (ha : a ∈ B i) (hb : b ∈ B j) : φ (a * b) = φ a * φ b := by
  have := h [(i, a - algebraMap R A (φ a)), (j, b - algebraMap R A (φ b))] (by simp)
    (by simpa using hij)
    (by simp [sub_mem, ha, hb])
    (by simp [Algebra.algebraMap_eq_smul_one, hφ])
  simpa [Algebra.algebraMap_eq_smul_one, sub_mul, mul_sub, hφ, sub_eq_zero] using this

/-- The mixed moment of order three of a free family: for a normalised functional, letters
`a, a'` from one member and `b` from a member with a different label,
`φ (a * b * a') = φ (a * a') * φ b`. -/
theorem apply_mul_mul_of_ne (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1) {i j : ι}
    (hij : i ≠ j) {a b a' : A} (ha : a ∈ B i) (hb : b ∈ B j) (ha' : a' ∈ B i) :
    φ (a * b * a') = φ (a * a') * φ b := by
  -- Expand the vanishing moment of the centred word `a° b° a'°`.
  have := h [(i, a - algebraMap R A (φ a)), (j, b - algebraMap R A (φ b)),
    (i, a' - algebraMap R A (φ a'))] (by simp) (by simp [hij, hij.symm])
    (by simp [sub_mem, ha, hb, ha']) (by simp [Algebra.algebraMap_eq_smul_one, hφ])
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
    Algebra.algebraMap_eq_smul_one, sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul,
    mul_one, map_sub, map_smul, smul_eq_mul, hφ] at this
  rw [mul_assoc]
  linear_combination this + φ a' * h.apply_mul_of_ne hφ hij ha hb +
    φ a * h.apply_mul_of_ne hφ hij.symm hb ha'

/-- The alternating mixed moment of order four of a free family: for a normalised functional,
letters `a, a'` from one member and `b, b'` from a member with a different label,
`φ (a * b * a' * b') = φ (a * a') * φ b * φ b' + φ a * φ a' * φ (b * b') - φ a * φ a' * φ b * φ b'`.

For centred `a = a'` and `b = b'` it gives `φ (a * b * a * b) = 0`, whereas
`φ (a * a * (b * b)) = φ (a * a) * φ (b * b)` by `IsFreelyIndependent.apply_mul_of_ne`; for
variance one these are `0` and `1`, while for commuting classically independent variables both
equal `1`. -/
theorem apply_mul_mul_mul_of_ne (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1) {i j : ι}
    (hij : i ≠ j) {a b a' b' : A} (ha : a ∈ B i) (hb : b ∈ B j) (ha' : a' ∈ B i)
    (hb' : b' ∈ B j) :
    φ (a * b * a' * b') =
      φ (a * a') * φ b * φ b' + φ a * φ a' * φ (b * b') - φ a * φ a' * φ b * φ b' := by
  -- Expand the vanishing moment of the centred word `a° b° a'° b'°`, and evaluate the moments
  -- of its subwords by the mixed moments of orders two and three.
  have := h [(i, a - algebraMap R A (φ a)), (j, b - algebraMap R A (φ b)),
    (i, a' - algebraMap R A (φ a')), (j, b' - algebraMap R A (φ b'))] (by simp)
    (by simp [hij, hij.symm])
    (by simp [sub_mem, ha, hb, ha', hb']) (by simp [Algebra.algebraMap_eq_smul_one, hφ])
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
    Algebra.algebraMap_eq_smul_one, sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul,
    mul_one, map_sub, map_smul, smul_eq_mul, hφ] at this
  have h₁ := h.apply_mul_mul_of_ne hφ hij ha hb ha'
  have h₂ := h.apply_mul_mul_of_ne hφ hij.symm hb ha' hb'
  have h₃ := h.apply_mul_of_ne hφ hij ha (mul_mem hb hb')
  have h₄ := h.apply_mul_of_ne hφ hij (mul_mem ha ha') hb'
  simp only [mul_assoc] at h₁ h₂ h₃ h₄ ⊢
  linear_combination this + φ b' * h₁ + φ a * h₂ + φ a' * h₃ + φ b * h₄ -
    φ a' * φ b' * h.apply_mul_of_ne hφ hij ha hb - φ a' * φ b * h.apply_mul_of_ne hφ hij ha hb' -
    φ a * φ b' * h.apply_mul_of_ne hφ hij.symm hb ha' -
    φ a * φ b * h.apply_mul_of_ne hφ hij ha' hb'

/-- Freeness differs from classical independence: if `a` and `b` lie in members of a free family
with distinct labels and commute, then for a normalised functional the product of their variances
`φ (a * a) - φ a ^ 2` and `φ (b * b) - φ b ^ 2` vanishes; over a ring without zero divisors, such
as `ℂ`, one of them is zero, so commuting variables of nonzero variance are never free. -/
theorem sub_mul_sub_eq_zero_of_commute (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1)
    {i j : ι} (hij : i ≠ j) {a b : A} (ha : a ∈ B i) (hb : b ∈ B j) (hab : Commute a b) :
    (φ (a * a) - φ a ^ 2) * (φ (b * b) - φ b ^ 2) = 0 := by
  -- Compare the two evaluations of `φ (a * b * a * b) = φ (a * a * (b * b))`.
  have h₁ := h.apply_mul_mul_mul_of_ne hφ hij ha hb ha hb
  rw [mul_assoc (a * b), hab.symm.mul_mul_mul_comm] at h₁
  linear_combination h₁ - h.apply_mul_of_ne hφ hij (mul_mem ha ha) (mul_mem hb hb)

end IsFreelyIndependent

section Span

variable {φ : A →ₗ[R] R} {B : ι → Subalgebra R A}

/-- The merging step: a word with two adjacent letters of equal labels has the same value as a
shorter word, obtained by multiplying those two letters together. -/
private theorem exists_shorter_of_not_isChain {w : List (ι × A)} (hw : ∀ x ∈ w, x.2 ∈ B x.1)
    (halt : ¬(w.map Prod.fst).IsChain (· ≠ ·)) :
    ∃ w' : List (ι × A), w'.length < w.length ∧ (∀ x ∈ w', x.2 ∈ B x.1) ∧
      (w'.map Prod.snd).prod = (w.map Prod.snd).prod := by
  obtain ⟨k, hk, hne⟩ := List.exists_not_getElem_of_not_isChain halt
  simp only [List.length_map] at hk
  simp only [List.getElem_map, ne_eq, not_not] at hne
  have hsplit : w = w.take k ++ w[k] :: w[k + 1] :: w.drop (k + 1 + 1) := by
    rw [← List.drop_eq_getElem_cons hk, ← List.drop_eq_getElem_cons, List.take_append_drop]
  obtain ⟨u, x, y, v, rfl, hxy⟩ : ∃ u x y v, w = u ++ x :: y :: v ∧ x.1 = y.1 :=
    ⟨_, _, _, _, hsplit, hne⟩
  refine ⟨u ++ (x.1, x.2 * y.2) :: v, by simp, ?_, by simp [mul_assoc]⟩
  simp only [List.mem_append, List.mem_cons] at hw ⊢
  rintro z (hz | rfl | hz)
  · exact hw z (.inl hz)
  · exact mul_mem (hw x (.inr (.inl rfl))) (hxy ▸ hw y (.inr (.inr (.inl rfl))))
  · exact hw z (.inr (.inr (.inr hz)))


/-- The centring step: if the value of every word of length less than `n` with letters from the
`B i` lies in the span of `1` and the values of the centred alternating words, then so does the
value of every alternating word `v ++ u` of length `n ≠ 0` whose prefix `v` is centred. The
letters of `u` are centred one at a time, each step producing a word with a longer centred prefix
and a shorter word. -/
private theorem prod_append_mem_span_of_isChain (hφ : φ 1 = 1) {n : ℕ} (hn0 : n ≠ 0)
    (ih : ∀ w : List (ι × A), w.length < n → (∀ x ∈ w, x.2 ∈ B x.1) →
      (w.map Prod.snd).prod ∈ Submodule.span R (insert 1 (centeredAlternatingProds φ B))) :
    ∀ u v : List (ι × A), (v ++ u).length = n → (∀ x ∈ v ++ u, x.2 ∈ B x.1) →
      ((v ++ u).map Prod.fst).IsChain (· ≠ ·) → (∀ x ∈ v, φ x.2 = 0) →
      ((v ++ u).map Prod.snd).prod ∈
        Submodule.span R (insert 1 (centeredAlternatingProds φ B)) := by
  intro u
  induction u with
  | nil =>
    intro v hlen hw halt hc
    simp only [List.append_nil] at hlen hw halt ⊢
    have hne : v ≠ [] := by rintro rfl; exact hn0 hlen.symm
    exact Submodule.subset_span (Set.mem_insert_of_mem _ ⟨v, hne, halt, hw, hc, rfl⟩)
  | cons x u ihu =>
    intro v hlen hw halt hc
    have hx : x.2 ∈ B x.1 := hw x (by simp)
    rw [show ((v ++ x :: u).map Prod.snd).prod =
        ((v ++ (x.1, x.2 - algebraMap R A (φ x.2)) :: u).map Prod.snd).prod +
          φ x.2 • ((v ++ u).map Prod.snd).prod by
      simp only [List.map_append, List.map_cons, List.prod_append_sub_algebraMap_cons,
        sub_add_cancel]]
    refine add_mem ?_ (Submodule.smul_mem _ _ ?_)
    · have := ihu (v ++ [(x.1, x.2 - algebraMap R A (φ x.2))]) (by simpa using hlen) ?_ ?_ ?_
      · simpa using this
      · simp only [List.append_assoc, List.singleton_append, List.mem_append, List.mem_cons]
          at hw ⊢
        rintro y (hy | rfl | hy)
        · exact hw y (.inl hy)
        · exact sub_mem hx (Subalgebra.algebraMap_mem _ _)
        · exact hw y (.inr (.inr hy))
      · simpa using halt
      · simp only [List.mem_append, List.mem_singleton]
        rintro y (hy | rfl)
        · exact hc y hy
        · simp [Algebra.algebraMap_eq_smul_one, hφ]
    · refine ih (v ++ u) ?_ ?_
      · simp only [List.length_append, List.length_cons] at hlen ⊢
        omega
      · simp only [List.mem_append, List.mem_cons] at hw ⊢
        rintro y (hy | hy)
        · exact hw y (.inl hy)
        · exact hw y (.inr (.inr hy))

/-- For a normalised functional, the value of every word with letters from the `B i` lies in the
span of `1` and the values of the centred alternating words. -/
private theorem prod_mem_span (hφ : φ 1 = 1) (w : List (ι × A)) (hw : ∀ x ∈ w, x.2 ∈ B x.1) :
    (w.map Prod.snd).prod ∈ Submodule.span R (insert 1 (centeredAlternatingProds φ B)) := by
  induction hn : w.length using Nat.strong_induction_on generalizing w with
  | _ n ih =>
  have ih' (w' : List (ι × A)) (hlen : w'.length < n) (hw' : ∀ x ∈ w', x.2 ∈ B x.1) :
      (w'.map Prod.snd).prod ∈ Submodule.span R (insert 1 (centeredAlternatingProds φ B)) :=
    ih _ hlen w' hw' rfl
  by_cases halt : (w.map Prod.fst).IsChain (· ≠ ·)
  · rcases eq_or_ne w [] with rfl | hne
    · exact Submodule.subset_span (by simp)
    have hn0 : n ≠ 0 := by rw [← hn]; exact (List.length_pos_iff.2 hne).ne'
    exact prod_append_mem_span_of_isChain hφ hn0 ih' w [] hn hw halt (by simp)
  · obtain ⟨w', hlen, hw', hprod⟩ := exists_shorter_of_not_isChain hw halt
    rw [← hprod]
    exact ih' w' (hn ▸ hlen) hw'

/-- For a normalised functional `φ`, the subalgebra generated by the `B i` is spanned by `1` and
the values of the words alternating between the `B i` whose letters are centred with respect to
`φ`. No freeness is needed: every word reduces to these by merging adjacent letters with equal
labels and by centring letters one at a time. -/
theorem toSubmodule_iSup_eq_span_insert_one_centeredAlternatingProds (hφ : φ 1 = 1)
    (B : ι → Subalgebra R A) :
    Subalgebra.toSubmodule (⨆ i, B i) =
      Submodule.span R (insert 1 (centeredAlternatingProds φ B)) := by
  refine le_antisymm (fun x hx => ?_) (Submodule.span_le.2 ?_)
  · -- Every element of the generated subalgebra is a combination of values of words.
    let S : Set A := {p | ∃ w : List (ι × A), (∀ x ∈ w, x.2 ∈ B x.1) ∧ (w.map Prod.snd).prod = p}
    have hS : S * S ⊆ S := by
      rintro _ ⟨_, ⟨w₁, hw₁, rfl⟩, _, ⟨w₂, hw₂, rfl⟩, rfl⟩
      refine ⟨w₁ ++ w₂, ?_, by simp⟩
      simp only [List.mem_append]
      rintro x (hx | hx)
      exacts [hw₁ x hx, hw₂ x hx]
    have hxS : x ∈ Submodule.span R S := by
      refine Algebra.iSup_induction B (motive := (· ∈ Submodule.span R S))
        ((Subalgebra.mem_toSubmodule _).1 hx) (fun i a ha => ?_) (fun a b ha hb => add_mem ha hb)
        (fun a b ha hb => ?_) fun r => ?_
      · exact Submodule.subset_span ⟨[(i, a)], by simpa using ha, by simp⟩
      · exact Submodule.span_mono hS (Submodule.span_mul_span R S S ▸ Submodule.mul_mem_mul ha hb)
      · rw [Algebra.algebraMap_eq_smul_one]
        exact Submodule.smul_mem _ r (Submodule.subset_span ⟨[], by simp, by simp⟩)
    refine Submodule.span_le.2 ?_ hxS
    rintro _ ⟨w, hw, rfl⟩
    exact prod_mem_span hφ w hw
  · rintro _ (rfl | ⟨w, -, -, hw, -, rfl⟩)
    · exact (Subalgebra.mem_toSubmodule _).2 (one_mem _)
    refine (Subalgebra.mem_toSubmodule _).2 (Subalgebra.list_prod_mem _ fun a ha => ?_)
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 ha
    exact le_iSup B x.1 (hw x hx)

end Span

namespace IsFreelyIndependent

variable {φ ψ : A →ₗ[R] R} {B : ι → Subalgebra R A}

/-- For a normalised functional for which `B` is free, the span of the values of the centred
alternating words consists of the centred elements of the subalgebra generated by the `B i`. -/
theorem mem_span_centeredAlternatingProds_iff (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1)
    {x : A} :
    x ∈ Submodule.span R (centeredAlternatingProds φ B) ↔ x ∈ ⨆ i, B i ∧ φ x = 0 := by
  rw [← Subalgebra.mem_toSubmodule, toSubmodule_iSup_eq_span_insert_one_centeredAlternatingProds hφ]
  refine ⟨fun hx => ⟨Submodule.span_mono (Set.subset_insert _ _) hx,
    isFreelyIndependent_iff_span_le_ker.1 h hx⟩, fun ⟨hx, hx0⟩ => ?_⟩
  rw [Submodule.span_insert, Submodule.mem_sup] at hx
  obtain ⟨_, hy, z, hz, rfl⟩ := hx
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hy
  have hz0 : φ z = 0 := isFreelyIndependent_iff_span_le_ker.1 h hz
  rw [map_add, map_smul, hφ, hz0, smul_eq_mul, mul_one, add_zero] at hx0
  simpa [hx0] using hz

/-- Freeness determines the joint distribution from the individual ones: two normalised
functionals for which `B` is free and which agree on each `B i` agree on the subalgebra
generated by the `B i`. -/
theorem eqOn_iSup (hφ : φ 1 = 1) (hψ : ψ 1 = 1) (hfφ : IsFreelyIndependent φ B)
    (hfψ : IsFreelyIndependent ψ B) (h : ∀ i, Set.EqOn φ ψ (B i)) :
    Set.EqOn φ ψ (⨆ i, B i : Subalgebra R A) := by
  intro x hx
  -- `x - φ x` is a combination of words centred for `φ`, hence also for `ψ`.
  have hS : centeredAlternatingProds φ B ⊆ centeredAlternatingProds ψ B := by
    rintro _ ⟨w, hne, halt, hw, hc, rfl⟩
    exact ⟨w, hne, halt, hw, fun x hx => (h x.1 (hw x hx)).symm.trans (hc x hx), rfl⟩
  have hx0 := (hfφ.mem_span_centeredAlternatingProds_iff hφ).2
    ⟨sub_mem hx (Subalgebra.smul_mem _ (one_mem _) (φ x)), by simp [hφ]⟩
  have := isFreelyIndependent_iff_span_le_ker.1 hfψ (Submodule.span_mono hS hx0)
  rw [LinearMap.mem_ker, map_sub, map_smul, hψ, smul_eq_mul, mul_one, sub_eq_zero] at this
  exact this.symm

/-- Two normalised functionals for which a generating family `B` is free and which agree on
each `B i` are equal. -/
theorem eq_of_iSup_eq_top (hφ : φ 1 = 1) (hψ : ψ 1 = 1) (hfφ : IsFreelyIndependent φ B)
    (hfψ : IsFreelyIndependent ψ B) (h : ∀ i, Set.EqOn φ ψ (B i)) (htop : ⨆ i, B i = ⊤) :
    φ = ψ :=
  LinearMap.ext fun x => eqOn_iSup hφ hψ hfφ hfψ h (by rw [htop]; exact Algebra.mem_top)

/-- Freeness passes to the subalgebras generated by the members over disjoint sets of labels:
for a normalised functional and any `g : ι → κ`, the subalgebras `⨆ (i) (_ : g i = k), B i`
generated by the members labelled by the fibres of `g` are free. -/
theorem iSup_fiber (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1) (g : ι → κ) :
    IsFreelyIndependent φ fun k => ⨆ (i) (_ : g i = k), B i := by
  -- `S k` holds the values of the centred alternating words labelled by the fibre over `k`;
  -- `V k` those of the nonempty centred alternating words whose first label lies over `k`, and
  -- `T k` those of the possibly empty ones whose first label does not lie over `k`.
  let S (k : κ) := centeredAlternatingProds φ fun i : {i // g i = k} => B i
  let V (k : κ) : Set A := {p | ∃ w : List (ι × A), w ≠ [] ∧ (w.map Prod.fst).IsChain (· ≠ ·) ∧
    (∀ x ∈ w, x.2 ∈ B x.1) ∧ (∀ x ∈ w, φ x.2 = 0) ∧ (∀ y ∈ w.head?, g y.1 = k) ∧
      (w.map Prod.snd).prod = p}
  let T (k : κ) : Set A := {p | ∃ w : List (ι × A), (w.map Prod.fst).IsChain (· ≠ ·) ∧
    (∀ x ∈ w, x.2 ∈ B x.1) ∧ (∀ x ∈ w, φ x.2 = 0) ∧ (∀ y ∈ w.head?, g y.1 ≠ k) ∧
      (w.map Prod.snd).prod = p}
  -- A centred element of the subalgebra generated over the fibre of `k` lies in the span of `S k`.
  have hS {k : κ} {x : A} (hx : x ∈ ⨆ (i) (_ : g i = k), B i) (hx0 : φ x = 0) :
      x ∈ Submodule.span R (S k) :=
    ((h.comp Subtype.val_injective).mem_span_centeredAlternatingProds_iff hφ).2
      ⟨by rwa [Function.comp_def, iSup_subtype], hx0⟩
  -- Juxtaposing a word labelled by the fibre over `k` with a word not starting over `k`.
  have hST (k : κ) : S k * T k ⊆ V k := by
    rintro _ ⟨_, ⟨w₁, hne, halt₁, hw₁, hc₁, rfl⟩, _, ⟨w₂, halt₂, hw₂, hc₂, hg₂, rfl⟩, rfl⟩
    obtain ⟨z, w₁, rfl⟩ := List.exists_cons_of_ne_nil hne
    let f : {i // g i = k} × A → ι × A := Prod.map Subtype.val id
    have hfst : ((z :: w₁).map f).map Prod.fst = ((z :: w₁).map Prod.fst).map Subtype.val := by
      simp [f]
    refine ⟨(z :: w₁).map f ++ w₂, by simp, ?_, ?_, ?_, by simp [f, z.1.2],
      by simp [f, Function.comp_def, mul_assoc]⟩
    · rw [List.map_append, List.isChain_append, hfst, List.isChain_map]
      refine ⟨halt₁.imp fun _ _ hab h => hab (Subtype.val_injective h), halt₂,
        fun a ha b hb hab => ?_⟩
      obtain ⟨t, -, rfl⟩ := List.mem_map.1 (List.mem_of_mem_getLast? ha)
      rw [List.head?_map, Option.mem_map] at hb
      obtain ⟨y, hy, rfl⟩ := hb
      exact hg₂ y hy (hab ▸ t.2)
    · simp only [List.mem_append, List.mem_map]
      rintro x (⟨x, hx, rfl⟩ | hx)
      exacts [hw₁ x hx, hw₂ x hx]
    · simp only [List.mem_append, List.mem_map]
      rintro x (⟨x, hx, rfl⟩ | hx)
      exacts [hc₁ x hx, hc₂ x hx]
  -- By induction along the word, the value of a centred alternating word in the subalgebras
  -- generated over the fibres, with first label `k`, lies in the span of `V k`.
  have key (W : List (κ × A)) : ∀ x : κ × A, ((x :: W).map Prod.fst).IsChain (· ≠ ·) →
      (∀ y ∈ x :: W, y.2 ∈ ⨆ (i) (_ : g i = y.1), B i) → (∀ y ∈ x :: W, φ y.2 = 0) →
      ((x :: W).map Prod.snd).prod ∈ Submodule.span R (V x.1) := by
    have hcons (x : κ × A) (q : A) (hx : x.2 ∈ ⨆ (i) (_ : g i = x.1), B i) (hx0 : φ x.2 = 0)
        (hq : q ∈ Submodule.span R (T x.1)) : x.2 * q ∈ Submodule.span R (V x.1) :=
      Submodule.span_mono (hST x.1)
        (Submodule.span_mul_span R (S x.1) (T x.1) ▸ Submodule.mul_mem_mul (hS hx hx0) hq)
    induction W with
    | nil =>
      intro x _ hW hc
      simpa using hcons x 1 (hW x (by simp)) (hc x (by simp))
        (Submodule.subset_span ⟨[], by simp, by simp, by simp, by simp, by simp⟩)
    | cons x' W ih =>
      intro x halt hW hc
      simp only [List.map_cons, List.isChain_cons_cons] at halt
      rw [List.map_cons, List.prod_cons]
      refine hcons x _ (hW x (by simp)) (hc x (by simp)) (Submodule.span_mono ?_
        (ih x' (by simpa using halt.2) (fun y hy => hW y (.tail _ hy))
          fun y hy => hc y (.tail _ hy)))
      rintro _ ⟨w, -, halt', hw, hc', hg, rfl⟩
      exact ⟨w, halt', hw, hc', fun y hy => (hg y hy).trans_ne (Ne.symm halt.1), rfl⟩
  intro W hne halt hW hc
  obtain ⟨x, W, rfl⟩ := List.exists_cons_of_ne_nil hne
  refine isFreelyIndependent_iff_span_le_ker.1 h (Submodule.span_mono ?_ (key W x halt hW hc))
  rintro _ ⟨w, hne, halt, hw, hc, -, rfl⟩
  exact ⟨w, hne, halt, hw, hc, rfl⟩

end IsFreelyIndependent

end Ring

end TauCeti
