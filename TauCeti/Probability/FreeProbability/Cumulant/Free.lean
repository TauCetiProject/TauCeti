import Mathlib.Algebra.BigOperators.Fin

/-!
# Freeness is the vanishing of mixed free cumulants

Let `φ : A →ₗ[R] R` be a linear functional on an algebra `A` over a commutative ring `R`, and let
`B i` be unital subalgebras of `A`. A free cumulant `κ_n(a₁, …, aₙ)` is *mixed* for the family
`(B i)` when `aⱼ ∈ B iⱼ` for labels `iⱼ` that are not all equal. For a normalised `φ`, the family is
freely independent exactly when every mixed free cumulant vanishes. This turns freeness, a
condition on centred alternating words, into the vanishing of the off-diagonal cumulants, which is
what makes cumulants additive on free families and underlies the free convolution.

The *generated-algebra test* refines this: freeness of the unital subalgebras generated by sets
`G i` only needs the vanishing of the mixed free cumulants whose letters are generators, and in
particular elements are freely independent exactly when their own mixed free cumulants vanish.

The words are indexed by a finite set `s` of positions in a linear order, so that the results apply
to every subword of a word; the cumulants `κ_n` are the case `s = Finset.univ : Finset (Fin n)`.

## Main results

* `TauCeti.IsFreelyIndependent.freeCumulant_eq_zero` — for a normalised `φ` and a free family, the
  free cumulant of a word with letters in the family vanishes when the labels are not all equal.
* `TauCeti.isFreelyIndependent_of_freeCumulant_eq_zero` — if every mixed cumulant `κ_n` vanishes,
  the family is free.
* `TauCeti.isFreelyIndependent_iff_freeCumulant_eq_zero` — for a normalised `φ`, freeness is
  equivalent to the vanishing of all mixed free cumulants.
* `TauCeti.isFreelyIndependent_adjoin_of_freeCumulant_eq_zero`,
  `TauCeti.isFreelyIndependent_adjoin_iff_freeCumulant_eq_zero` — the generated-algebra test: for a
  normalised `φ`, the subalgebras generated by the sets `G i` are free exactly when the mixed free
  cumulants with letters in the sets `G i` vanish.
* `TauCeti.isFreelyIndependentElements_iff_freeCumulant_eq_zero` — for a normalised `φ`, elements
  `c i` are freely independent exactly when every mixed free cumulant `κ_n(c_{w 1}, …, c_{w n})`
  vanishes.
* `TauCeti.IsFreelyIndependent.freeCumulant_sum`, `TauCeti.IsFreelyIndependent.freeCumulant_add`
  — for a normalised `φ`, the free cumulant of a sum of words whose letters lie in distinct free
  subalgebras is the sum of their free cumulants.
* `TauCeti.IsFreelyIndependentElements.freeCumulant_sum`,
  `TauCeti.IsFreelyIndependentElements.freeCumulant_add` — the cumulants `κ_n` of a sum of free
  elements are the sums of their cumulants, which is the additivity underlying free convolution.
* `TauCeti.IsFreelyIndependentElements.apply_sum_pow_eq_sum_prod_sum_freeCumulant` — the moments
  of a sum of free elements, by the moment–cumulant formula with the summed cumulants.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Theorem 11.16 and its
  proof via Theorem 11.12 and Proposition 11.15, and Theorem 11.20 for the generated-algebra
  test.
  Additivity of free cumulants on free families is in Lecture 12 there.
* R. Speicher, *Multiplicative functions on the lattice of non-crossing partitions and free
  convolution*, Math. Ann. 298 (1994), 611–628.
-/

public section

open Finset Function

namespace TauCeti

variable {R A ι α : Type*} [CommRing R] [Semiring A] [Algebra R A] [LinearOrder α]
  {φ : A →ₗ[R] R} {B : ι → Subalgebra R A} {s : Finset α} {ℓ : α → ι}

/-- If the mixed free cumulants of the proper subwords of `b` along `s` vanish, a noncrossing
partition `π ≠ 1` of `s` with a mixed part contributes zero to the moment–cumulant formula. -/
private theorem prod_freeCumulant_eq_zero_of_mixed {b : α → A}
    (hsub : ∀ t ⊂ s, ∀ x ∈ t, ∀ y ∈ t, ℓ x ≠ ℓ y → freeCumulant φ b t = 0)
    {π : NoncrossingPartition s} (hπ : π ≠ ⊤) {X : Finset α} (hX : X ∈ π.1.parts) {u v : α}
    (hu : u ∈ X) (hv : v ∈ X) (huv : ℓ u ≠ ℓ v) :
    ∏ X ∈ π.1.parts, freeCumulant φ b X = 0 := by
  refine prod_eq_zero hX (hsub X (ssubset_of_subset_of_ne (π.1.le hX) fun hXs => hπ ?_) u hu v hv
    huv)
  exact Subtype.ext <| (Finpartition.eq_top_of_mem_parts (hXs ▸ hX)).trans
    NoncrossingPartition.coe_top.symm

/-- Let `f` be monotone on `s` and identify no two positions other than `i ≤ j`, which are adjacent
in `s`. If the join in `NC(s)` of `π` with the partition `σ_f` into the fibres of `f` is `1`, then
`s` is the union of the parts of `π` through `i` and `j`: merging these two parts gives a
noncrossing partition above `π` and `σ_f`. -/
private theorem mem_union_of_sup_comap_eq_top {f : α → α} (hf : MonotoneOn f s) {i j : α}
    (hi : i ∈ s) (hj : j ∈ s) (hij : i ≤ j) (hadj : ∀ z ∈ s, z ≤ i ∨ j ≤ z)
    (hfeq : ∀ {u v}, f u = f v → u ≠ v → (u = i ∨ u = j) ∧ (v = i ∨ v = j))
    {π : NoncrossingPartition s} (hπ : π ⊔ NoncrossingPartition.comap hf ⊥ = ⊤) {z : α}
    (hz : z ∈ s) : z ∈ π.1.part i ∪ π.1.part j := by
  obtain ⟨Q, hQ, hπQ, hQi⟩ := π.2.exists_part_eq_union hi hj hij hadj
  have hiQ : ∀ {u}, u = i ∨ u = j → u ∈ Q.part i := by
    rintro u (rfl | rfl) <;> rw [hQi]
    exacts [mem_union_left _ (π.1.mem_part_self.2 hi), mem_union_right _ (π.1.mem_part_self.2 hj)]
  -- The fibres of `f` lie in the parts of `Q`.
  have hσQ : (NoncrossingPartition.comap hf ⊥ : Finpartition s) ≤ Q := by
    intro b hb
    obtain ⟨x, hx⟩ := Finpartition.nonempty_of_mem_parts _ hb
    have hxs := Finpartition.le _ hb hx
    refine ⟨Q.part x, Q.part_mem.2 hxs, fun w hw => ?_⟩
    rw [← Finpartition.part_eq_of_mem _ hb hx, NoncrossingPartition.coe_comap,
      NoncrossingPartition.coe_bot, Finpartition.part_comap_bot hxs] at hw
    obtain ⟨-, hwx⟩ := mem_filter.1 hw
    rcases eq_or_ne w x with rfl | hne
    · exact Q.mem_part_self.2 hxs
    obtain ⟨hw', hx'⟩ := hfeq hwx hne
    rw [Q.part_eq_of_mem (Q.part_mem.2 hi) (hiQ hx')]
    exact hiQ hw'
  have htop : Q = ⊤ := congrArg Subtype.val
    (top_le_iff.1 (hπ ▸ sup_le hπQ hσQ) : (⟨Q, hQ⟩ : NoncrossingPartition s) = ⊤)
  rw [← hQi, htop, Finpartition.part_eq_of_mem _ (by
    rw [Finpartition.parts_top (nonempty_of_ne_empty (ne_empty_of_mem hi)).ne_empty]
    exact mem_singleton_self s) hi]
  exact hz

/-- *Grouping two adjacent letters with equal labels*: let `i < j` be adjacent positions of `s` with
`ℓ i = ℓ j`, and let the labels along `s` not all be equal. If the mixed free cumulants of the
proper subwords of `a` along `s` vanish, then grouping the letters at `i` and `j` into the letter
`a i * a j` does not change the free cumulant. By the formula for cumulants with products as
arguments, every other contribution comes from a partition `π ≠ 1` whose parts through `i` and `j`
cover `s`, so one of these two parts is mixed. -/
private theorem freeCumulant_fiberProd_collapse_eq {a : α → A}
    (hsub : ∀ t ⊂ s, ∀ x ∈ t, ∀ y ∈ t, ℓ x ≠ ℓ y → freeCumulant φ a t = 0) {x y : α}
    (hx : x ∈ s) (hy : y ∈ s) (hxy : ℓ x ≠ ℓ y) {i j : α} (hi : i ∈ s) (hj : j ∈ s) (hij : i < j)
    (hadj : ∀ z ∈ s, z ≤ i ∨ j ≤ z) (hℓ : ℓ i = ℓ j) :
    freeCumulant φ (fiberProd a s fun z => if z = j then i else z)
      (s.image fun z => if z = j then i else z) = freeCumulant φ a s := by
  obtain ⟨hf, hfeq, -⟩ := Finset.collapse_adjacent_spec hi hj hij hadj
  rw [freeCumulant_fiberProd_eq_sum_prod φ a hf, sum_eq_single_of_mem ⊤ (by simp) ?_,
    ← partitionCumulant_eq_prod_freeCumulant, ← freeCumulant_def]
  intro π hπ hπtop
  obtain ⟨z, hz, hzi⟩ : ∃ z ∈ s, ℓ z ≠ ℓ i := by
    by_contra! h
    exact hxy ((h x hx).trans (h y hy).symm)
  rcases mem_union.1 (mem_union_of_sup_comap_eq_top hf hi hj hij.le hadj hfeq
    (mem_filter.1 hπ).2 hz) with hz' | hz'
  · exact prod_freeCumulant_eq_zero_of_mixed hsub hπtop (π.1.part_mem.2 hi) hz'
      (π.1.mem_part_self.2 hi) hzi
  · exact prod_freeCumulant_eq_zero_of_mixed hsub hπtop (π.1.part_mem.2 hj) hz'
      (π.1.mem_part_self.2 hj) (hℓ ▸ hzi)

/-- The inductive step when two adjacent letters `a i`, `a j` of a mixed word have equal labels:
grouping them into the letter `a i * a j` gives a shorter mixed word with the same cumulant, which
vanishes by induction. -/
private theorem freeCumulant_eq_zero_of_label_eq
    (ih : ∀ t : Finset α, #t < #s → ∀ b : α → A, (∀ z ∈ t, b z ∈ B (ℓ z)) →
      ∀ x ∈ t, ∀ y ∈ t, ℓ x ≠ ℓ y → freeCumulant φ b t = 0)
    {a : α → A} (ha : ∀ x ∈ s, a x ∈ B (ℓ x)) {x y : α} (hx : x ∈ s) (hy : y ∈ s)
    (hxy : ℓ x ≠ ℓ y) {i j : α} (hi : i ∈ s) (hj : j ∈ s) (hij : i < j)
    (hadj : ∀ z ∈ s, z ≤ i ∨ j ≤ z) (hℓ : ℓ i = ℓ j) : freeCumulant φ a s = 0 := by
  -- Collapse `j` onto `i`; this preserves labels and the order of the positions of `s`.
  obtain ⟨-, -, hcard⟩ := Finset.collapse_adjacent_spec hi hj hij hadj
  set f : α → α := fun z => if z = j then i else z
  have hfℓ : ∀ z, ℓ (f z) = ℓ z := fun z => by by_cases h : z = j <;> simp [f, h, hℓ]
  -- The grouped word is shorter, and its letters lie in the subalgebras, since grouping preserves
  -- labels; it is mixed, so its cumulant vanishes.
  have hmem : ∀ z ∈ s.image f, fiberProd a s f z ∈ B (ℓ z) := fun z _ => by
    refine fiberProd_def a s f z ▸ Subalgebra.list_prod_mem _ (List.forall_mem_map.2 fun w hw => ?_)
    obtain ⟨hws, rfl⟩ := mem_filter.1 ((mem_sort _).1 hw)
    exact hfℓ w ▸ ha w hws
  rw [← freeCumulant_fiberProd_collapse_eq (fun t ht => ih t (card_lt_card ht) a
    fun z hz => ha z (ht.subset hz)) hx hy hxy hi hj hij hadj hℓ]
  exact ih _ hcard _ hmem _ (mem_image_of_mem f hx) _ (mem_image_of_mem f hy) (by rwa [hfℓ, hfℓ])

/-- A word of length greater than one whose adjacent labels differ has zero free cumulant when its
letters belong to freely independent subalgebras and the functional is normalised. -/
private theorem freeCumulant_eq_zero_of_isChain (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1)
    {a : α → A} (ha : ∀ x ∈ s, a x ∈ B (ℓ x)) (hs : 1 < #s)
    (halt : (s.sort.map ℓ).IsChain (· ≠ ·)) : freeCumulant φ a s = 0 := by
  -- Centre the letters. Each noncrossing partition has an interval part on which the centred
  -- word alternates, so freeness makes its moment vanish.
  set b : α → A := fun z => a z + algebraMap R A (-φ (a z)) with hb
  have hbc : ∀ z, φ (b z) = 0 := fun z => by
    simp [hb, Algebra.algebraMap_eq_smul_one, hφ]
  rw [← freeCumulant_add_algebraMap φ a hφ (fun z => -φ (a z)) hs,
    freeCumulant_eq_sum_mu_mul_partitionMoment]
  refine sum_eq_zero fun π _ => ?_
  obtain ⟨X, hX, hint⟩ := π.2.exists_interval_mem_parts (card_pos.1 (by omega))
  have hXs := π.1.le hX
  obtain ⟨x, hx⟩ := π.1.nonempty_of_mem_parts hX
  have hne : X.sort.map (fun z => (ℓ z, b z)) ≠ [] :=
    List.ne_nil_of_mem (List.mem_map_of_mem ((mem_sort _).2 hx))
  have hzero := isFreelyIndependent_iff.1 h _ hne (by
    rw [List.map_map]
    refine isChain_map_sort_iff.2 fun u hu v hv huv hadj => isChain_map_sort_iff.1 halt u
      (hXs hu) v (hXs hv) huv fun z hz => ?_
    by_contra! hz'
    exact (hadj z (hint u hu v hv z hz hz'.1 hz'.2)).elim hz'.1.not_ge hz'.2.not_ge)
    (by simpa using fun z hz => add_mem (ha z (hXs hz)) (Subalgebra.algebraMap_mem _ _))
    (by simp [hbc])
  rw [List.map_map] at hzero
  rw [partitionMoment_def, prod_eq_zero hX hzero, mul_zero]

/-- *Free cumulants detect freeness*, the vanishing direction: if the subalgebras `B i` are freely
independent for a normalised `φ`, then the free cumulant `κ_s(a)` of a word whose letters satisfy
`a x ∈ B (ℓ x)` vanishes as soon as two of its labels differ. -/
theorem IsFreelyIndependent.freeCumulant_eq_zero (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1)
    {a : α → A} (ha : ∀ x ∈ s, a x ∈ B (ℓ x)) {x y : α} (hx : x ∈ s) (hy : y ∈ s)
    (hxy : ℓ x ≠ ℓ y) : freeCumulant φ a s = 0 := by
  -- Induct on the length. If two adjacent letters have equal labels, group them into one letter:
  -- by the formula for cumulants with products as arguments, the shorter mixed cumulant is the
  -- original one plus cumulants of partitions `π ≠ 1` that vanish by induction. If all adjacent
  -- labels differ, centre the letters: each noncrossing partition has an interval block whose
  -- moment vanishes by freeness, so every term in the Möbius expansion of the cumulant vanishes.
  induction hn : #s using Nat.strong_induction_on generalizing s a x y with | _ n ih =>
  have ih' : ∀ t : Finset α, #t < #s → ∀ b : α → A, (∀ z ∈ t, b z ∈ B (ℓ z)) →
      ∀ x ∈ t, ∀ y ∈ t, ℓ x ≠ ℓ y → freeCumulant φ b t = 0 :=
    fun t ht b hb x hx y hy hxy => ih #t (hn ▸ ht) hb hx hy hxy rfl
  by_cases hA : ∃ i ∈ s, ∃ j ∈ s, i < j ∧ (∀ z ∈ s, z ≤ i ∨ j ≤ z) ∧ ℓ i = ℓ j
  · obtain ⟨i, hi, j, hj, hij, hadj, hℓ⟩ := hA
    exact freeCumulant_eq_zero_of_label_eq ih' ha hx hy hxy hi hj hij hadj hℓ
  · push Not at hA
    exact freeCumulant_eq_zero_of_isChain h hφ ha
      (one_lt_card.2 ⟨x, hx, y, hy, ne_of_apply_ne ℓ hxy⟩) (isChain_map_sort_iff.2 hA)

/-- *Free cumulants detect freeness*, the converse direction: if every mixed free cumulant
`κ_n(a₁, …, aₙ)`, with letters `aₖ ∈ B (ℓ k)` whose labels are not all equal, vanishes, then the
subalgebras `B i` are freely independent. No normalisation of `φ` is needed. -/
theorem isFreelyIndependent_of_freeCumulant_eq_zero
    (h : ∀ (n : ℕ) (a : Fin n → A) (ℓ : Fin n → ι), (∀ k, a k ∈ B (ℓ k)) → ∀ k k', ℓ k ≠ ℓ k' →
      freeCumulant φ a univ = 0) :
    IsFreelyIndependent φ B := by
  -- In the moment–cumulant formula for a centred alternating word, every noncrossing partition
  -- has a singleton part, whose cumulant is a centred moment, or a part containing two adjacent
  -- letters, whose labels differ; either way it contributes zero.
  rw [isFreelyIndependent_iff]
  intro w hne halt hw hc
  -- Read the word as letters `a k` with labels `ℓ k` at the positions `k : Fin w.length`.
  set a : Fin w.length → A := fun k => w[(k : ℕ)].2
  set ℓ : Fin w.length → ι := fun k => w[(k : ℕ)].1
  have hlen : w.length ≠ 0 := by simpa using hne
  have halt' : ((univ : Finset (Fin w.length)).sort.map ℓ).IsChain (· ≠ ·) := by
    rwa [Fin.sort_univ, ← List.ofFn_eq_map, List.ofFn_getElem_eq_map]
  rw [← List.ofFn_getElem_eq_map, apply_prod_ofFn_eq_sum_prod_freeCumulant φ hlen]
  refine sum_eq_zero fun π _ => ?_
  obtain ⟨X, hX, hX1 | ⟨u, hu, v, hv, huv, hadj⟩⟩ :=
    π.2.exists_mem_parts_card_eq_one_or_adjacent (univ_nonempty_iff.2 ⟨⟨0, by omega⟩⟩)
  · obtain ⟨k, rfl⟩ := card_eq_one.1 hX1
    exact prod_eq_zero hX (by rw [freeCumulant_singleton]; exact hc _ (List.getElem_mem _))
  -- Relabel the part `X`, which has two adjacent positions with distinct labels, by `Fin #X`.
  refine prod_eq_zero hX ?_
  set e := X.orderEmbOfFin rfl
  obtain ⟨k, hk⟩ : u ∈ Set.range e := by rwa [range_orderEmbOfFin]
  obtain ⟨k', hk'⟩ : v ∈ Set.range e := by rwa [range_orderEmbOfFin]
  rw [freeCumulant_eq_freeCumulant_comp_orderEmbOfFin φ a X]
  refine h _ (a ∘ e) (ℓ ∘ e) (fun k => hw _ (List.getElem_mem _)) k k' ?_
  simp only [comp_apply, hk, hk']
  exact isChain_map_sort_iff.1 halt' u (mem_univ u) v (mem_univ v) huv hadj

/-- *Free cumulants detect freeness*: for a normalised `φ`, the subalgebras `B i` are freely
independent exactly when every mixed free cumulant `κ_n(a₁, …, aₙ)`, with letters
`aₖ ∈ B (ℓ k)` whose labels are not all equal, vanishes. -/
theorem isFreelyIndependent_iff_freeCumulant_eq_zero (hφ : φ 1 = 1) :
    IsFreelyIndependent φ B ↔
      ∀ (n : ℕ) (a : Fin n → A) (ℓ : Fin n → ι), (∀ k, a k ∈ B (ℓ k)) → ∀ k k', ℓ k ≠ ℓ k' →
        freeCumulant φ a univ = 0 :=
  ⟨fun h _ _ _ ha k k' hk => h.freeCumulant_eq_zero hφ (fun z _ => ha z) (mem_univ k)
    (mem_univ k') hk, isFreelyIndependent_of_freeCumulant_eq_zero⟩

section Generated

/-! ### The generated-algebra test

For a normalised `φ`, freeness of the unital subalgebras generated by sets `G i` can be tested on
the generators alone: it suffices that the mixed free cumulants with letters in the sets `G i`
vanish. By multilinearity it is enough to consider letters that are products of generators, and
such a product letter is split into two adjacent letters, one generator at a time; by the formula
for cumulants with products as arguments, splitting does not change a mixed cumulant once the
mixed cumulants of the shorter words vanish. -/

variable {G : ι → Set A}

/-- Grouping the adjacent letters at `p` and `p + 1` of a word `a` of length `n + 1` gives the
word of length `n` with the letter `a p * a (p + 1)` at `p`; its free cumulant is that of the word
grouped along the map collapsing `p + 1` onto `p`. -/
private theorem freeCumulant_ite_eq_freeCumulant_fiberProd {n : ℕ} (a : Fin (n + 1) → A)
    (p : Fin n) :
    freeCumulant φ (fun q => if q = p then a p.castSucc * a p.succ else a (p.succ.succAbove q))
        univ =
      freeCumulant φ (fiberProd a univ fun z => if z = p.succ then p.castSucc else z)
        (univ.image fun z => if z = p.succ then p.castSucc else z) := by
  set e : Fin n → Fin (n + 1) := p.succ.succAbove
  have hep : e p = p.castSucc := Fin.succAbove_of_castSucc_lt _ _ p.castSucc_lt_succ
  -- The fibre of the collapse over `e q` is `{p, p + 1}` for `q = p`, and `{e q}` otherwise.
  have hfib (q : Fin n) :
      fiberProd a univ (fun z => if z = p.succ then p.castSucc else z) (e q) =
        if q = p then a p.castSucc * a p.succ else a (e q) := by
    rw [fiberProd_def]
    by_cases hq : q = p
    · subst hq
      have : {z ∈ (univ : Finset (Fin (n + 1))) | (if z = q.succ then q.castSucc else z) = e q} =
          {q.castSucc, q.succ} := by
        ext z
        by_cases hz : z = q.succ <;> simp [hz, hep]
      rw [this, sort_pair _ q.castSucc_lt_succ.le q.castSucc_lt_succ.ne]
      simp
    · have : {z ∈ (univ : Finset (Fin (n + 1))) | (if z = p.succ then p.castSucc else z) = e q} =
          {e q} := by
        ext z
        by_cases hz : z = p.succ
        · simp only [hz, ite_true, mem_filter, mem_univ, true_and, mem_singleton]
          rw [← hep]
          exact ⟨fun h => absurd (Fin.succAbove_right_injective h).symm hq,
            fun h => absurd h.symm (Fin.succAbove_ne _ _)⟩
        · simp [hz]
      rw [this, sort_singleton]
      simp [hq]
  -- The collapse takes the same values as `e`, which skips `p + 1`.
  have himage : univ.image (fun z => if z = p.succ then p.castSucc else z) = univ.image e := by
    ext y
    simp only [mem_image, mem_univ, true_and]
    constructor
    · rintro ⟨z, rfl⟩
      rw [← Set.mem_range, Fin.range_succAbove]
      by_cases hz : z = p.succ <;> simp [hz, p.castSucc_lt_succ.ne]
    · rintro ⟨q, rfl⟩
      exact ⟨e q, ite_eq_right_iff.2 fun h => absurd h (Fin.succAbove_ne p.succ q)⟩
  rw [himage, ← freeCumulant_comp_of_strictMonoOn φ ((Fin.strictMono_succAbove _).strictMonoOn _)]
  exact congrArg (freeCumulant φ · univ) (funext fun q => (hfib q).symm)

/-- The mixed free cumulants of words whose letters are products of nonempty lists of generators
vanish, by induction on the number of generators in excess of the number of letters. -/
private theorem freeCumulant_list_prod_eq_zero
    (h : ∀ (n : ℕ) (a : Fin n → A) (ℓ : Fin n → ι), (∀ k, a k ∈ G (ℓ k)) → ∀ k k', ℓ k ≠ ℓ k' →
      freeCumulant φ a univ = 0)
    (m : ℕ) : ∀ (n : ℕ) (L : Fin n → List A) (ℓ : Fin n → ι), ∑ k, ((L k).length - 1) = m →
      (∀ k, L k ≠ []) → (∀ k, ∀ g ∈ L k, g ∈ G (ℓ k)) → ∀ k k', ℓ k ≠ ℓ k' →
        freeCumulant φ (fun k => (L k).prod) univ = 0 := by
  induction m using Nat.strong_induction_on with | _ m ih => ?_
  intro n L ℓ hm hL hG k k' hkk'
  by_cases hlen : ∀ q, (L q).length = 1
  · refine h n _ ℓ (fun q => ?_) k k' hkk'
    obtain ⟨g, hg⟩ := List.length_eq_one_iff.1 (hlen q)
    simpa [hg] using hG q g (by simp [hg])
  push Not at hlen
  obtain ⟨p, hp⟩ := hlen
  obtain ⟨g, r, hgr⟩ := List.exists_cons_of_ne_nil (hL p)
  have hr : r ≠ [] := by
    rintro rfl
    simp [hgr] at hp
  -- Split the letter at `p` into the adjacent letters `g` at `p` and `r.prod` at `p + 1`. The old
  -- positions sit in `Fin (n + 1)` along `e`, which skips `p + 1`.
  set e : Fin n → Fin (n + 1) := p.succ.succAbove
  set L' : Fin (n + 1) → List A := Fin.insertNth p.succ r (update L p [g])
  set ℓ' : Fin (n + 1) → ι := Fin.insertNth p.succ (ℓ p) ℓ
  set a' : Fin (n + 1) → A := fun z => (L' z).prod
  have hL'e (q : Fin n) : L' (e q) = update L p [g] q := Fin.insertNth_apply_succAbove _ _ _ _
  have hℓ'e (q : Fin n) : ℓ' (e q) = ℓ q := Fin.insertNth_apply_succAbove _ _ _ _
  have hL'p : L' p.succ = r := Fin.insertNth_apply_same _ _ _
  have hℓ'p : ℓ' p.succ = ℓ p := Fin.insertNth_apply_same _ _ _
  have hep : e p = p.castSucc := Fin.succAbove_of_castSucc_lt _ _ p.castSucc_lt_succ
  have hL' : ∀ z, L' z ≠ [] := (Fin.forall_iff_succAbove p.succ).2 ⟨hL'p ▸ hr, fun q => by
    rw [hL'e]
    by_cases hq : q = p
    · simp [hq]
    · simpa [hq] using hL q⟩
  have hG' : ∀ z, ∀ x ∈ L' z, x ∈ G (ℓ' z) := (Fin.forall_iff_succAbove p.succ).2
    ⟨fun x hx => hℓ'p ▸ hG p x (by rw [hgr]; exact List.mem_cons_of_mem g (hL'p ▸ hx)),
      fun q x hx => by
        rw [hL'e] at hx
        rw [hℓ'e]
        by_cases hq : q = p
        · subst hq
          exact hG q x (by simp_all)
        · exact hG q x (by simpa [hq] using hx)⟩
  -- The split word has one generator less in excess.
  have hm' : ∑ z, ((L' z).length - 1) < m := by
    have hsum : ∑ q, ((update L p [g] q).length - 1) = ∑ q ∈ univ.erase p, ((L q).length - 1) := by
      rw [← add_sum_erase _ _ (mem_univ p)]
      simp only [update_self, List.length_singleton, tsub_self, zero_add]
      exact sum_congr rfl fun q hq => by rw [update_of_ne (ne_of_mem_erase hq)]
    rw [Fin.sum_univ_succAbove _ p.succ, hL'p]
    simp only [e] at hL'e
    simp only [hL'e, hsum]
    rw [← hm, ← add_sum_erase _ _ (mem_univ p), hgr, List.length_cons]
    have := List.length_pos_of_ne_nil hr
    omega
  -- Every mixed subword of the split word has vanishing cumulant, by induction.
  have hsub : ∀ t : Finset (Fin (n + 1)), ∀ x ∈ t, ∀ y ∈ t, ℓ' x ≠ ℓ' y →
      freeCumulant φ a' t = 0 := by
    intro t x hx y hy hxy
    set eV := t.orderEmbOfFin rfl
    obtain ⟨i, rfl⟩ : x ∈ Set.range eV := by rwa [range_orderEmbOfFin]
    obtain ⟨j, rfl⟩ : y ∈ Set.range eV := by rwa [range_orderEmbOfFin]
    rw [freeCumulant_eq_freeCumulant_comp_orderEmbOfFin]
    refine ih _ (lt_of_le_of_lt ?_ hm') _ (L' ∘ eV) (ℓ' ∘ eV) rfl (fun _ => hL' _)
      (fun _ => hG' _) i j hxy
    exact (sum_image fun _ _ _ _ h => eV.injective h).symm.trans_le
      (sum_le_sum_of_subset (f := fun z => (L' z).length - 1) (subset_univ _))
  -- Grouping the two halves of the split letter recovers the original word.
  have hgroup : (fun q => (L q).prod) =
      fun q => if q = p then a' p.castSucc * a' p.succ else a' (e q) := by
    funext q
    by_cases hq : q = p
    · subst hq
      simp [a', ← hep, hL'e, hL'p, hgr]
    · simp [a', hL'e, hq]
  rw [hgroup, freeCumulant_ite_eq_freeCumulant_fiberProd,
    freeCumulant_fiberProd_collapse_eq (fun t _ => hsub t) (mem_univ (e k)) (mem_univ (e k'))
      (by rwa [hℓ'e, hℓ'e]) (mem_univ _) (mem_univ _) p.castSucc_lt_succ
      (fun z _ => by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega)
      (by rw [← hep, hℓ'e, hℓ'p])]
  exact hsub univ _ (mem_univ (e k)) _ (mem_univ (e k')) (by rwa [hℓ'e, hℓ'e])

/-- The mixed free cumulants of words with letters in the submonoids generated by the sets `G i`
vanish when those of the generators do, for a normalised `φ`. -/
private theorem freeCumulant_eq_zero_of_mem_closure (hφ : φ 1 = 1)
    (h : ∀ (n : ℕ) (a : Fin n → A) (ℓ : Fin n → ι), (∀ k, a k ∈ G (ℓ k)) → ∀ k k', ℓ k ≠ ℓ k' →
      freeCumulant φ a univ = 0)
    {n : ℕ} (a : Fin n → A) (ℓ : Fin n → ι) (ha : ∀ k, a k ∈ Submonoid.closure (G (ℓ k)))
    {k k' : Fin n} (hkk' : ℓ k ≠ ℓ k') : freeCumulant φ a univ = 0 := by
  -- A unit letter makes the cumulant vanish; otherwise every letter is a product of a nonempty
  -- list of generators.
  by_cases h1 : ∃ q, a q = 1
  · obtain ⟨q, hq⟩ := h1
    refine freeCumulant_eq_zero_of_apply_eq_one φ a hφ hq (mem_univ q) ?_
    exact one_lt_card.2 ⟨k, mem_univ k, k', mem_univ k', ne_of_apply_ne ℓ hkk'⟩
  push Not at h1
  choose L hL hprod using fun q => Submonoid.exists_list_of_mem_closure (ha q)
  have ha' : a = fun q => (L q).prod := funext fun q => (hprod q).symm
  subst ha'
  exact freeCumulant_list_prod_eq_zero h _ n L ℓ rfl
    (fun q hq => h1 q (by simp [hq])) hL k k' hkk'

/-- *The generated-algebra test for freeness*: for a normalised `φ`, if every mixed free cumulant
`κ_n(a₁, …, aₙ)` with letters `aₖ ∈ G (ℓ k)` in the generating sets, whose labels are not all
equal, vanishes, then the unital subalgebras generated by the sets `G i` are freely
independent. -/
theorem isFreelyIndependent_adjoin_of_freeCumulant_eq_zero (hφ : φ 1 = 1)
    (h : ∀ (n : ℕ) (a : Fin n → A) (ℓ : Fin n → ι), (∀ k, a k ∈ G (ℓ k)) → ∀ k k', ℓ k ≠ ℓ k' →
      freeCumulant φ a univ = 0) :
    IsFreelyIndependent φ fun i => Algebra.adjoin R (G i) := by
  classical
  refine isFreelyIndependent_of_freeCumulant_eq_zero fun n a ℓ ha k k' hkk' => ?_
  -- Replace the letters by elements of the generated submonoids one position at a time, using
  -- multilinearity and `Algebra.adjoin R (G i) = span R (Submonoid.closure (G i))`.
  suffices H : ∀ T : Finset (Fin n), ∀ b : Fin n → A, (∀ q, b q ∈ Algebra.adjoin R (G (ℓ q))) →
      (∀ q ∉ T, b q ∈ Submonoid.closure (G (ℓ q))) → freeCumulant φ b univ = 0 from
    H univ a ha fun q hq => absurd (mem_univ q) hq
  intro T
  induction T using Finset.induction_on with
  | empty =>
    intro b _ hb
    exact freeCumulant_eq_zero_of_mem_closure hφ h b ℓ (fun q => hb q (notMem_empty q)) hkk'
  | insert q T hqT ih =>
    intro b hb hbT
    have hq : b q ∈ Submodule.span R (Submonoid.closure (G (ℓ q)) : Set A) := by
      rw [← Algebra.adjoin_eq_span, Subalgebra.mem_toSubmodule]
      exact hb q
    suffices key : ∀ x ∈ Submodule.span R (Submonoid.closure (G (ℓ q)) : Set A),
        freeCumulant φ (update b q x) univ = 0 by simpa using key _ hq
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      refine ih _ (fun z => ?_) fun z hz => ?_
      · rcases eq_or_ne z q with rfl | hzq
        · simpa using Submonoid.closure_le.2 (Algebra.subset_adjoin (R := R)) hx
        · simpa [hzq] using hb z
      · rcases eq_or_ne z q with rfl | hzq
        · simpa using hx
        · simpa [hzq] using hbT z (by simp [hzq, hz])
    | zero => simpa using freeCumulant_update_smul φ b (mem_univ q) 0 0
    | add x y _ _ hx hy => rw [freeCumulant_update_add φ b (mem_univ q), hx, hy, add_zero]
    | smul c x _ hx => rw [freeCumulant_update_smul φ b (mem_univ q), hx, mul_zero]

/-- *The generated-algebra test for freeness*: for a normalised `φ`, the unital subalgebras
generated by the sets `G i` are freely independent exactly when every mixed free cumulant
`κ_n(a₁, …, aₙ)` with letters `aₖ ∈ G (ℓ k)` in the generating sets, whose labels are not all
equal, vanishes. -/
theorem isFreelyIndependent_adjoin_iff_freeCumulant_eq_zero (hφ : φ 1 = 1) :
    (IsFreelyIndependent φ fun i => Algebra.adjoin R (G i)) ↔
      ∀ (n : ℕ) (a : Fin n → A) (ℓ : Fin n → ι), (∀ k, a k ∈ G (ℓ k)) → ∀ k k', ℓ k ≠ ℓ k' →
        freeCumulant φ a univ = 0 :=
  ⟨fun h n a ℓ ha => (isFreelyIndependent_iff_freeCumulant_eq_zero hφ).1 h n a ℓ
    fun k => Algebra.subset_adjoin (ha k), isFreelyIndependent_adjoin_of_freeCumulant_eq_zero hφ⟩

/-- *Free cumulants detect free elements*: for a normalised `φ`, the elements `c i` are freely
independent exactly when every mixed free cumulant `κ_n(c_{w 1}, …, c_{w n})` of the elements, for
a word `w` whose labels are not all equal, vanishes. -/
theorem isFreelyIndependentElements_iff_freeCumulant_eq_zero (hφ : φ 1 = 1) {c : ι → A} :
    IsFreelyIndependentElements φ c ↔
      ∀ (n : ℕ) (w : Fin n → ι), ∀ k k', w k ≠ w k' → freeCumulant φ (c ∘ w) univ = 0 := by
  rw [isFreelyIndependentElements_iff, isFreelyIndependent_adjoin_iff_freeCumulant_eq_zero hφ]
  refine ⟨fun h n w => h n (c ∘ w) w fun _ => rfl, fun h n a ℓ ha => ?_⟩
  obtain rfl : a = c ∘ ℓ := funext ha
  exact h n ℓ

end Generated

/-- *Free cumulants are additive on free families*: if the letters of the words `a k` lie in the
freely independent subalgebras `B k`, for a normalised `φ`, then the free cumulant of the sum of
these words is the sum of their free cumulants,
`κ_s(∑ k ∈ T, a k) = ∑ k ∈ T, κ_s(a k)` for nonempty `s`. -/
theorem IsFreelyIndependent.freeCumulant_sum (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1)
    {T : Finset ι} {a : ι → α → A} (ha : ∀ k ∈ T, ∀ x ∈ s, a k x ∈ B k) (hs : s.Nonempty) :
    freeCumulant φ (fun x => ∑ k ∈ T, a k x) s = ∑ k ∈ T, freeCumulant φ (a k) s := by
  classical
  -- Relabel the positions by `Fin #s` and expand by multilinearity: the free cumulant of the sum
  -- is the sum over all label assignments `r` of the cumulants of the words `x ↦ a (r x) x`.
  have : Nonempty (Fin #s) := ⟨⟨0, card_pos.2 hs⟩⟩
  simp_rw [freeCumulant_eq_freeCumulant_comp_orderEmbOfFin φ _ s, ← freeCumulantMultilinear_apply,
    comp_def, MultilinearMap.map_sum_finset, freeCumulantMultilinear_apply]
  -- Only the constant assignments contribute: a non-constant one gives a mixed cumulant.
  refine (sum_subset (s₁ := T.image (const (Fin #s))) (fun r hr => ?_)
    fun r hr hr' => ?_).symm.trans (sum_image fun _ _ _ _ hkl => const_injective hkl)
  · obtain ⟨k, hk, rfl⟩ := mem_image.1 hr
    exact Fintype.mem_piFinset.2 fun _ => hk
  · have hr := Fintype.mem_piFinset.1 hr
    obtain ⟨x, y, hxy⟩ : ∃ x y, r x ≠ r y := by
      by_contra! hc
      exact hr' (mem_image.2 ⟨r ⟨0, card_pos.2 hs⟩, hr _, funext fun x => hc _ x⟩)
    exact h.freeCumulant_eq_zero hφ (ℓ := r) (fun x _ => ha _ (hr x) _ (orderEmbOfFin_mem s rfl x))
      (mem_univ x) (mem_univ y) hxy

/-- *Free cumulants are additive on two free families*: if the letters of `a` lie in `B i` and
those of `b` in `B j` for `i ≠ j`, with `B` freely independent for a normalised `φ`, then
`κ_s(a + b) = κ_s(a) + κ_s(b)` for nonempty `s`. -/
theorem IsFreelyIndependent.freeCumulant_add (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1)
    {i j : ι} (hij : i ≠ j) {a b : α → A} (ha : ∀ x ∈ s, a x ∈ B i) (hb : ∀ x ∈ s, b x ∈ B j)
    (hs : s.Nonempty) :
    freeCumulant φ (fun x => a x + b x) s = freeCumulant φ a s + freeCumulant φ b s := by
  classical
  have := h.freeCumulant_sum hφ (T := {i, j}) (a := fun k => if k = i then a else b)
    (by simpa [hij.symm] using ⟨ha, hb⟩) hs
  simpa [sum_pair hij, hij.symm] using this

/-- *Free cumulants are additive on free elements*: if the elements `c k` are freely independent
for a normalised `φ`, then `κ_n(∑ k ∈ T, c k) = ∑ k ∈ T, κ_n(c k)` for `n ≥ 1`, where `κ_n(c)` is
the free cumulant of the constant word `(c, …, c)` along a nonempty set of `n` positions. -/
theorem IsFreelyIndependentElements.freeCumulant_sum {c : ι → A}
    (h : IsFreelyIndependentElements φ c) (hφ : φ 1 = 1) (T : Finset ι) (hs : s.Nonempty) :
    freeCumulant φ (fun _ => ∑ k ∈ T, c k) s = ∑ k ∈ T, freeCumulant φ (fun _ => c k) s :=
  (isFreelyIndependentElements_iff.1 h).freeCumulant_sum hφ
    (fun k _ _ _ => Algebra.self_mem_adjoin_singleton R (c k)) hs

/-- *Free cumulants are additive on two free elements*: if `c i` and `c j`, for `i ≠ j`, belong to
a freely independent family for a normalised `φ`, then `κ_n(c i + c j) = κ_n(c i) + κ_n(c j)` for
`n ≥ 1`, where `κ_n(c)` is the free cumulant of the constant word `(c, …, c)` along a nonempty set
of `n` positions. -/
theorem IsFreelyIndependentElements.freeCumulant_add {c : ι → A}
    (h : IsFreelyIndependentElements φ c) (hφ : φ 1 = 1) {i j : ι} (hij : i ≠ j)
    (hs : s.Nonempty) :
    freeCumulant φ (fun _ => c i + c j) s =
      freeCumulant φ (fun _ => c i) s + freeCumulant φ (fun _ => c j) s :=
  (isFreelyIndependentElements_iff.1 h).freeCumulant_add hφ hij
    (fun _ _ => Algebra.self_mem_adjoin_singleton R (c i))
    (fun _ _ => Algebra.self_mem_adjoin_singleton R (c j)) hs

/-- *Moments of a sum of free elements*: if the elements `c k` are freely independent for a
normalised `φ`, then the moments of their sum over `T` are given by the moment–cumulant formula
with the summed cumulants of the individual elements,
`φ ((∑ k ∈ T, c k) ^ n) = ∑_{π ∈ NC(n)} ∏_{B ∈ π} ∑ k ∈ T, κ_B(c k)`, where `κ_B(c k)` is the
free cumulant of the constant word `(c k, …, c k)` along the part `B`. -/
theorem IsFreelyIndependentElements.apply_sum_pow_eq_sum_prod_sum_freeCumulant {c : ι → A}
    (h : IsFreelyIndependentElements φ c) (hφ : φ 1 = 1) (T : Finset ι) (n : ℕ) :
    φ ((∑ k ∈ T, c k) ^ n) =
      ∑ π : NoncrossingPartition (univ : Finset (Fin n)),
        ∏ B ∈ π.1.parts, ∑ k ∈ T, freeCumulant φ (fun _ => c k) B := by
  rcases eq_or_ne n 0 with rfl | hn
  · rw [pow_zero, hφ, Fintype.sum_unique, Finpartition.parts_eq_empty_iff.2 (by simp), prod_empty]
  rw [← List.prod_replicate, ← List.ofFn_const, apply_prod_ofFn_eq_sum_prod_freeCumulant φ hn]
  exact sum_congr rfl fun π _ => prod_congr rfl fun B hB =>
    h.freeCumulant_sum hφ T (π.1.nonempty_of_mem_parts hB)

end TauCeti
