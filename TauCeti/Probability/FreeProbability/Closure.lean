module

public import TauCeti.Probability.FreeProbability.Independence
public import Mathlib.Topology.Algebra.Algebra

/-!
# Free independence and topological closure

For a normalised continuous linear functional on a topological algebra, taking the closure of
each member of a free family preserves freeness. In particular this applies to norm closures
in C*-probability spaces, since positive linear functionals on C*-algebras are continuous.
Neither positivity nor a trace is needed here.

The centring map `a ↦ a - φ(a) • 1` is continuous. Thus the expectation of an alternating
product of centred letters vanishes on the product of the original subalgebras, and hence on
the product of their closures. This avoids assuming that arbitrary approximating letters are
already centred.

The closed subalgebras generated by disjoint groups of a free family are again free. Two
normalised continuous functionals making the same family free and agreeing on its members
agree on the closure of the generated algebra.

The closure-preservation theorem requires jointly continuous multiplication; the uniqueness
results only require separately continuous multiplication and addition. No weak operator
closure preservation is asserted.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 5.
-/

public section

namespace TauCeti

variable {R A ι κ : Type*} [CommRing R] [Ring A] [Algebra R A]
  [TopologicalSpace R] [TopologicalSpace A] [T2Space R]
  {φ ψ : A →ₗ[R] R} {B : ι → Subalgebra R A}

section Closure

variable [IsTopologicalRing A] [ContinuousSMul R A]

namespace IsFreelyIndependent

/-- Taking the topological closure of each subalgebra preserves freeness for a normalised
continuous functional. In a normed algebra these are the norm closures. -/
theorem topologicalClosure (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1)
    (hcont : Continuous φ) :
    IsFreelyIndependent φ fun i ↦ (B i).topologicalClosure := by
  rw [isFreelyIndependent_iff_centered_prod hφ]
  intro w hne halt hw
  -- Index approximation coordinates by labelled letters; repetitions use the same coordinate.
  let S : Set ((ι × A) → A) := Set.pi {x | x ∈ w} fun x ↦ (B x.1 : Set A)
  let F (b : (ι × A) → A) : R :=
    φ (w.map fun x ↦ b x - algebraMap R A (φ (b x))).prod
  have hF : Continuous F := hcont.comp (continuous_list_prod w fun x _ ↦
    (continuous_apply x).sub ((continuous_algebraMap R A).comp
      (hcont.comp (continuous_apply x))))
  have hzero : S ⊆ {b | F b = 0} := by
    intro b hb
    exact h.apply_prod_map_of_mem w hne halt _
      (fun x hx ↦ (B x.1).sub_mem (hb x hx) ((B x.1).algebraMap_mem _))
      (fun x _ ↦ by simp [Algebra.algebraMap_eq_smul_one, hφ])
  have hmem : Prod.snd ∈ closure S := by
    apply mem_closure_pi.2
    intro x hx
    exact hw x hx
  exact (closure_minimal hzero (isClosed_eq hF continuous_const)) hmem

/-- Closing the algebras generated by the fibres of a map preserves freeness. This is the
closed-algebra version of grouping a free family along disjoint sets of labels. -/
theorem topologicalClosure_iSup_fiber (h : IsFreelyIndependent φ B) (hφ : φ 1 = 1)
    (hcont : Continuous φ) (g : ι → κ) :
    IsFreelyIndependent φ fun k ↦ (⨆ (i) (_ : g i = k), B i).topologicalClosure :=
  (h.iSup_fiber hφ g).topologicalClosure hφ hcont

end IsFreelyIndependent

/-- Freeness for a normalised continuous functional is equivalent to freeness of the
closures. The reverse implication is restriction to the original subalgebras. -/
@[simp]
theorem isFreelyIndependent_topologicalClosure_iff (hφ : φ 1 = 1) (hcont : Continuous φ) :
    (IsFreelyIndependent φ fun i ↦ (B i).topologicalClosure) ↔ IsFreelyIndependent φ B :=
  ⟨fun h ↦ h.mono fun i ↦ (B i).le_topologicalClosure,
    fun h ↦ h.topologicalClosure hφ hcont⟩

end Closure

namespace IsFreelyIndependent

variable [IsSemitopologicalSemiring A]

/-- Normalised continuous functionals making a family free and agreeing on its members agree
on the closure of the unital algebra generated by the family. -/
theorem eqOn_topologicalClosure_iSup (hφ : φ 1 = 1) (hψ : ψ 1 = 1)
    (hfφ : IsFreelyIndependent φ B) (hfψ : IsFreelyIndependent ψ B)
    (hcφ : Continuous φ) (hcψ : Continuous ψ)
    (hrest : ∀ i, Set.EqOn φ ψ (B i)) :
    Set.EqOn φ ψ ((⨆ i, B i).topologicalClosure : Set A) :=
  (hfφ.eqOn_iSup hφ hψ hfψ hrest).closure hcφ hcψ

/-- A family generating a dense unital algebra determines a normalised continuous free
functional from its restrictions to the individual members. -/
theorem eq_of_topologicalClosure_iSup_eq_top (hφ : φ 1 = 1) (hψ : ψ 1 = 1)
    (hfφ : IsFreelyIndependent φ B) (hfψ : IsFreelyIndependent ψ B)
    (hcφ : Continuous φ) (hcψ : Continuous ψ)
    (hrest : ∀ i, Set.EqOn φ ψ (B i)) (htop : (⨆ i, B i).topologicalClosure = ⊤) :
    φ = ψ := by
  ext x
  exact eqOn_topologicalClosure_iSup hφ hψ hfφ hfψ hcφ hcψ hrest
    (by rw [htop]; exact Algebra.mem_top)

end IsFreelyIndependent

end TauCeti
