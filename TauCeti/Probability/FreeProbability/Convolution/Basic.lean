/-! ### Abstracted Hilbert-space representation helpers and reduced C⋆-free product transport -/

/-- Abstracting the Hilbert space carrier avoids unfolding GNS quotients during operator-algebra
and topological typeclass synthesis. -/
private theorem law_innerPositiveLinearMap_of_starAlgHom
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {C : Type*} [CStarAlgebra C] [PartialOrder C] [StarOrderedRing C]
    (ξ : H) (ω : C →ₚ[ℂ] ℂ) (f : C →⋆ₐ[ℂ] (H →L[ℂ] H))
    (hf : ∀ x, ⟪ξ, f x ξ⟫_ℂ = ω x) {a : C} (ha : IsSelfAdjoint a) :
    (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law (f a) = ω.law a :=
  PositiveLinearMap.law_map_of_isSelfAdjoint ω
    (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ) f
    (fun x ↦ by simpa using hf x) ha

private theorem isFreelyIndependent_closures_of_subalgebra
    {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {I : Type*} {A : I → Type*} [∀ i, CStarAlgebra (A i)]
    {ξ : H} (hξ : ‖ξ‖ = 1) (B₀ : StarSubalgebra ℂ (H →L[ℂ] H)) (ψ₀ : B₀ →ₗ[ℂ] ℂ)
    (hψ₀ : ∀ T : B₀, ψ₀ T = ⟪ξ, (T : H →L[ℂ] H) ξ⟫_ℂ)
    (f : ∀ i, A i →⋆ₐ[ℂ] B₀)
    (hfree₀ : IsFreelyIndependent ψ₀ (fun i ↦ (f i).toAlgHom.range)) :
    IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
      (fun i ↦ ((B₀.subtype.comp (f i)).range).topologicalClosure.toSubalgebra) ∧
    IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
      (fun i ↦ (VonNeumannAlgebra.adjoin
        (((B₀.subtype.comp (f i)).range : StarSubalgebra ℂ (H →L[ℂ] H)) :
          Set (H →L[ℂ] H))).toSubalgebra) ∧
    IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
      (fun i ↦ (VonNeumannAlgebra.adjoin
        ((((B₀.subtype.comp (f i)).range).topologicalClosure :
          StarSubalgebra ℂ (H →L[ℂ] H)) : Set (H →L[ℂ] H))).toSubalgebra) := by
  let φ := ContinuousLinearMap.innerPositiveLinearMap ℂ ξ
  have h1 : φ.toLinearMap 1 = 1 := by
    rw [PositiveLinearMap.coe_toLinearMap, ContinuousLinearMap.innerPositiveLinearMap_one, hξ]
    simp
  have hcont : Continuous φ.toLinearMap :=
    (φ.toLinearMap.mkContinuous (‖ξ‖ ^ 2) fun T ↦ by
      simpa only [PositiveLinearMap.coe_toLinearMap] using
        ContinuousLinearMap.norm_innerPositiveLinearMap_apply_le ξ T).continuous
  have hmap := hfree₀.map B₀.subtype.toAlgHom (φ' := φ.toLinearMap) (by
    ext T
    simpa [φ, PositiveLinearMap.coe_toLinearMap] using (hψ₀ T).symm)
  have hranges : (fun i ↦ ((B₀.subtype.comp (f i)).range).toSubalgebra) =
      fun i ↦ ((f i).toAlgHom.range).map B₀.subtype.toAlgHom := by
    funext i
    ext T
    rw [StarSubalgebra.mem_toSubalgebra, StarAlgHom.range_eq_map_top]
    simp
  have hfree_range : IsFreelyIndependent φ.toLinearMap
      (fun i ↦ ((B₀.subtype.comp (f i)).range).toSubalgebra) := by
    simpa only [hranges] using hmap
  have hnorm : IsFreelyIndependent φ.toLinearMap
      (fun i ↦ ((B₀.subtype.comp (f i)).range).topologicalClosure.toSubalgebra) := by
    have hcl : (fun i ↦ ((B₀.subtype.comp (f i)).range).topologicalClosure.toSubalgebra) =
        fun i ↦ ((B₀.subtype.comp (f i)).range).toSubalgebra.topologicalClosure := by
      funext i
      rfl
    rw [hcl]
    exact hfree_range.topologicalClosure h1 hcont
  have hvN_raw : IsFreelyIndependent φ.toLinearMap
      (fun i ↦ (VonNeumannAlgebra.adjoin
        (((B₀.subtype.comp (f i)).range : StarSubalgebra ℂ (H →L[ℂ] H)) :
          Set (H →L[ℂ] H))).toSubalgebra) :=
    (isFreelyIndependent_vonNeumannAlgebraAdjoin_iff_of_vectorState
      (fun i ↦ (B₀.subtype.comp (f i)).range) h1 ξ
      (fun T ↦ by simp [φ, PositiveLinearMap.coe_toLinearMap])).mpr hfree_range
  have hvN_cl : IsFreelyIndependent φ.toLinearMap
      (fun i ↦ (VonNeumannAlgebra.adjoin
        ((((B₀.subtype.comp (f i)).range).topologicalClosure :
          StarSubalgebra ℂ (H →L[ℂ] H)) : Set (H →L[ℂ] H))).toSubalgebra) :=
    (isFreelyIndependent_vonNeumannAlgebraAdjoin_iff_of_vectorState
      (fun i ↦ ((B₀.subtype.comp (f i)).range).topologicalClosure) h1 ξ
      (fun T ↦ by simp [φ, PositiveLinearMap.coe_toLinearMap])).mpr hnorm
  exact ⟨hnorm, hvN_raw, hvN_cl⟩

private theorem emb_le_algebraMap_of_le {H : Type u} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] {C : Type*} [CStarAlgebra C] [PartialOrder C]
    [StarOrderedRing C] (f : C →⋆ₐ[ℂ] (H →L[ℂ] H)) {a : C} {r : ℝ}
    (h : a ≤ algebraMap ℂ C (r : ℂ)) : f a ≤ algebraMap ℝ (H →L[ℂ] H) r := by
  have hm := OrderHomClass.mono f h
  have halg : algebraMap ℂ (H →L[ℂ] H) (r : ℂ) = algebraMap ℝ (H →L[ℂ] H) r := by
    rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, Complex.coe_smul]
  rwa [AlgHomClass.commutes f (r : ℂ), halg] at hm

private theorem algebraMap_le_emb_of_le {H : Type u} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] {C : Type*} [CStarAlgebra C] [PartialOrder C]
    [StarOrderedRing C] (f : C →⋆ₐ[ℂ] (H →L[ℂ] H)) {a : C} {l : ℝ}
    (h : algebraMap ℂ C (l : ℂ) ≤ a) : algebraMap ℝ (H →L[ℂ] H) l ≤ f a := by
  have hm := OrderHomClass.mono f h
  have halg : algebraMap ℂ (H →L[ℂ] H) (l : ℂ) = algebraMap ℝ (H →L[ℂ] H) l := by
    rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, Complex.coe_smul]
  rwa [AlgHomClass.commutes f (l : ℂ), halg] at hm

namespace ReducedFreeProduct

variable {I : Type*} [DecidableEq I] {A : I → Type*} [∀ i, CStarAlgebra (A i)]

/-- Each represented factor map of the reduced C⋆-free product on its GNS Hilbert space preserves
the law of every selfadjoint element whenever `φ i` agrees with an order-positive functional
`ω i`. -/
theorem law_factor_innerPositiveLinearMap_vacuum [∀ i, PartialOrder (A i)]
    [∀ i, StarOrderedRing (A i)] (φ : ∀ i, StarPositiveFunctional (A i)) (hφ : ∀ i, φ i 1 = 1)
    {i : I} (ω : A i →ₚ[ℂ] ℂ) (hφ_ω : ∀ x, φ i x = ω x) {a : A i} (ha : IsSelfAdjoint a) :
    (ContinuousLinearMap.innerPositiveLinearMap ℂ (vacuum φ hφ)).law
        (((algebra φ hφ).subtype.comp (factor φ hφ i)) a) =
      ω.law a :=
  law_innerPositiveLinearMap_of_starAlgHom (H := HilbertSpace φ hφ) (vacuum φ hφ) ω
    ((algebra φ hφ).subtype.comp (factor φ hφ i))
    (fun x ↦ (state_apply φ hφ (factor φ hφ i x)).symm.trans
      ((state_factor φ hφ i x).trans (hφ_ω x)))
    ha

/-- The concrete von Neumann algebras generated on the GNS Hilbert space by the factor images of a
reduced C⋆-free product are freely independent for the vacuum vector state. -/
theorem isFreelyIndependent_vonNeumannAlgebraAdjoin_factor (φ : ∀ i, StarPositiveFunctional (A i))
    (hφ : ∀ i, φ i 1 = 1) :
    IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ (vacuum φ hφ)).toLinearMap
      (fun i ↦ (VonNeumannAlgebra.adjoin
        ((((algebra φ hφ).subtype.comp (factor φ hφ i)).range :
          StarSubalgebra ℂ (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ)) :
            Set (HilbertSpace φ hφ →L[ℂ] HilbertSpace φ hφ))).toSubalgebra) :=
  (isFreelyIndependent_closures_of_subalgebra (H := HilbertSpace φ hφ) (norm_vacuum φ hφ)
    (algebra φ hφ) (state φ hφ).toLinearMap (fun T ↦ state_apply φ hφ T) (factor φ hφ)
    (isFreelyIndependent_factor φ hφ)).2.1

end ReducedFreeProduct

/-! ### Simultaneous Hilbert-space, C⋆, and von Neumann realizations of compactly supported laws -/

/-- Packaging a concrete pointed Hilbert-space representation of factor C⋆-algebras into the full
C⋆- and von Neumann realization statement, keeping `H` and `A` opaque so typeclass synthesis never
unfolds GNS or Riesz–Markov–Kakutani carriers. -/
private theorem exists_hilbert_of_pointed_representation
    {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {I : Type u} {A : I → Type} [∀ i, CStarAlgebra (A i)] [∀ i, PartialOrder (A i)]
    [∀ i, StarOrderedRing (A i)] (μ : I → Measure ℝ)
    (ω : ∀ i, A i →ₚ[ℂ] ℂ) (coord : ∀ i, A i) (hsa : ∀ i, IsSelfAdjoint (coord i))
    (hω_law : ∀ i, (ω i).law (coord i) = μ i)
    (hIic_coord : ∀ i (r : ℝ), (μ i).support ⊆ Set.Iic r → coord i ≤ algebraMap ℂ (A i) (r : ℂ))
    (hIci_coord : ∀ i (l : ℝ), (μ i).support ⊆ Set.Ici l → algebraMap ℂ (A i) (l : ℂ) ≤ coord i)
    (ξ : H) (hξ : ‖ξ‖ = 1) (B₀ : StarSubalgebra ℂ (H →L[ℂ] H)) (ψ₀ : B₀ →ₗ[ℂ] ℂ)
    (hψ₀ : ∀ T : B₀, ψ₀ T = ⟪ξ, (T : H →L[ℂ] H) ξ⟫_ℂ)
    (f : ∀ i, A i →⋆ₐ[ℂ] B₀)
    (hf_state : ∀ i x, ψ₀ (f i x) = ω i x)
    (hfree₀ : IsFreelyIndependent ψ₀ (fun i ↦ (f i).toAlgHom.range)) :
    ∃ (H' : Type u) (_ : NormedAddCommGroup H') (_ : InnerProductSpace ℂ H') (_ : CompleteSpace H')
      (ξ' : H') (S : I → StarSubalgebra ℂ (H' →L[ℂ] H')) (T : I → H' →L[ℂ] H'),
      ‖ξ'‖ = 1 ∧
      (∀ i, IsClosed (S i : Set (H' →L[ℂ] H'))) ∧
      (∀ i, T i ∈ S i) ∧
      (∀ i, IsSelfAdjoint (T i)) ∧
      (∀ i, (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ').law (T i) = μ i) ∧
      (∀ i (r : ℝ), (μ i).support ⊆ Set.Iic r → T i ≤ algebraMap ℝ (H' →L[ℂ] H') r) ∧
      (∀ i (l : ℝ), (μ i).support ⊆ Set.Ici l → algebraMap ℝ (H' →L[ℂ] H') l ≤ T i) ∧
      IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ').toLinearMap
        (fun i ↦ (S i).toSubalgebra) ∧
      IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ').toLinearMap
        (fun i ↦ (VonNeumannAlgebra.adjoin (S i : Set (H' →L[ℂ] H'))).toSubalgebra) := by
  let emb (i : I) : A i →⋆ₐ[ℂ] (H →L[ℂ] H) := B₀.subtype.comp (f i)
  obtain ⟨hfree_S, _, hfree_vN⟩ :=
    isFreelyIndependent_closures_of_subalgebra hξ B₀ ψ₀ hψ₀ f hfree₀
  refine ⟨H, inferInstance, inferInstance, inferInstance, ξ,
    fun i ↦ (emb i).range.topologicalClosure, fun i ↦ emb i (coord i), hξ,
    fun i ↦ StarSubalgebra.isClosed_topologicalClosure _,
    fun i ↦ subset_closure ⟨coord i, rfl⟩,
    fun i ↦ (hsa i).map (emb i), ?_, ?_, ?_, hfree_S, hfree_vN⟩
  · intro i
    rw [law_innerPositiveLinearMap_of_starAlgHom ξ (ω i) (emb i)
      (fun x ↦ (hψ₀ (f i x)).symm.trans (hf_state i x)) (hsa i), hω_law i]
  · exact fun i r hr ↦ emb_le_algebraMap_of_le (emb i) (hIic_coord i r hr)
  · exact fun i l hl ↦ algebraMap_le_emb_of_le (emb i) (hIci_coord i l hl)

private theorem exists_hilbert_of_starPositiveFunctional
    {I : Type u} {A : I → Type} [∀ i, CStarAlgebra (A i)]
    [∀ i, PartialOrder (A i)] [∀ i, StarOrderedRing (A i)]
    (μ : I → Measure ℝ) (ω : ∀ i, A i →ₚ[ℂ] ℂ)
    (φ : ∀ i, StarPositiveFunctional (A i)) (hφ : ∀ i, φ i 1 = 1)
    (hφ_ω : ∀ i x, φ i x = ω i x)
    (coord : ∀ i, A i) (hsa : ∀ i, IsSelfAdjoint (coord i))
    (hω_law : ∀ i, (ω i).law (coord i) = μ i)
    (hIic_coord : ∀ i (r : ℝ), (μ i).support ⊆ Set.Iic r → coord i ≤ algebraMap ℂ (A i) (r : ℂ))
    (hIci_coord : ∀ i (l : ℝ), (μ i).support ⊆ Set.Ici l → algebraMap ℂ (A i) (l : ℂ) ≤ coord i) :
    ∃ (H : Type u) (_ : NormedAddCommGroup H) (_ : InnerProductSpace ℂ H) (_ : CompleteSpace H)
      (ξ : H) (S : I → StarSubalgebra ℂ (H →L[ℂ] H)) (T : I → H →L[ℂ] H),
      ‖ξ‖ = 1 ∧
      (∀ i, IsClosed (S i : Set (H →L[ℂ] H))) ∧
      (∀ i, T i ∈ S i) ∧
      (∀ i, IsSelfAdjoint (T i)) ∧
      (∀ i, (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law (T i) = μ i) ∧
      (∀ i (r : ℝ), (μ i).support ⊆ Set.Iic r → T i ≤ algebraMap ℝ (H →L[ℂ] H) r) ∧
      (∀ i (l : ℝ), (μ i).support ⊆ Set.Ici l → algebraMap ℝ (H →L[ℂ] H) l ≤ T i) ∧
      IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
        (fun i ↦ (S i).toSubalgebra) ∧
      IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
        (fun i ↦ (VonNeumannAlgebra.adjoin (S i : Set (H →L[ℂ] H))).toSubalgebra) := by
  classical
  exact exists_hilbert_of_pointed_representation
    (H := ReducedFreeProduct.HilbertSpace φ hφ) μ ω coord hsa hω_law hIic_coord hIci_coord
    (ReducedFreeProduct.vacuum φ hφ) (ReducedFreeProduct.norm_vacuum φ hφ)
    (ReducedFreeProduct.algebra φ hφ) (ReducedFreeProduct.state φ hφ).toLinearMap
    (fun T ↦ ReducedFreeProduct.state_apply φ hφ T) (ReducedFreeProduct.factor φ hφ)
    (fun i x ↦ (ReducedFreeProduct.state_factor φ hφ i x).trans (hφ_ω i x))
    (ReducedFreeProduct.isFreelyIndependent_factor φ hφ)

/-- Simultaneous operator-algebraic realization of any indexed family of compactly supported
probability measures on `ℝ`: on a complex Hilbert space `H` with unit vector `ξ`, there exist
norm-closed `⋆`-subalgebras `S i` and selfadjoint operators `T i ∈ S i` whose laws under the
vector state `A ↦ ⟪ξ, A ξ⟫_ℂ` are the prescribed `μ i`, whose Loewner order bounds reflect upper
and lower interval bounds on `(μ i).support`, and such that both the C⋆-subalgebras `S i` and the
generated von Neumann algebras `VonNeumannAlgebra.adjoin (S i)` are freely independent. -/
theorem exists_hilbert_isFreelyIndependent_law_eq {I : Type u} (μ : I → Measure ℝ)
    [∀ i, IsProbabilityMeasure (μ i)] (hμ : ∀ i, IsCompact (μ i).support) :
    ∃ (H : Type u) (_ : NormedAddCommGroup H) (_ : InnerProductSpace ℂ H) (_ : CompleteSpace H)
      (ξ : H) (S : I → StarSubalgebra ℂ (H →L[ℂ] H)) (T : I → H →L[ℂ] H),
      ‖ξ‖ = 1 ∧
      (∀ i, IsClosed (S i : Set (H →L[ℂ] H))) ∧
      (∀ i, T i ∈ S i) ∧
      (∀ i, IsSelfAdjoint (T i)) ∧
      (∀ i, (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law (T i) = μ i) ∧
      (∀ i (r : ℝ), (μ i).support ⊆ Set.Iic r → T i ≤ algebraMap ℝ (H →L[ℂ] H) r) ∧
      (∀ i (l : ℝ), (μ i).support ⊆ Set.Ici l → algebraMap ℝ (H →L[ℂ] H) l ≤ T i) ∧
      IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
        (fun i ↦ (S i).toSubalgebra) ∧
      IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
        (fun i ↦ (VonNeumannAlgebra.adjoin (S i : Set (H →L[ℂ] H))).toSubalgebra) := by
  have _ (i : I) : CompactSpace (μ i).support := isCompact_iff_compactSpace.mp (hμ i)
  let ν (i : I) : Measure (μ i).support := (μ i).comap ((↑) : (μ i).support → ℝ)
  have _ (i : I) : IsProbabilityMeasure (ν i) :=
    MeasurableEmbedding.subtype_coe Measure.isClosed_support.measurableSet
      |>.isProbabilityMeasure_comap (Subtype.range_coe ▸ Measure.support_mem_ae)
  let ω (i : I) : C((μ i).support, ℂ) →ₚ[ℂ] ℂ := ContinuousMap.integralPositiveLinearMap (ν i)
  let coord (i : I) : C((μ i).support, ℂ) :=
    (ContinuousMap.restrict (μ i).support (ContinuousMap.id ℝ)).realToRCLike ℂ
  exact exists_hilbert_of_starPositiveFunctional μ ω
    (fun i ↦ StarPositiveFunctional.ofPositiveLinearMap (ω i))
    (fun i ↦ by simp [ω])
    (fun i x ↦ StarPositiveFunctional.ofPositiveLinearMap_apply (ω i) x)
    coord
    (fun _ ↦ ContinuousMap.isSelfAdjoint_realToRCLike ℂ)
    (fun _ ↦ PositiveLinearMap.law_integralPositiveLinearMap_comap_restrict_id
      Measure.measure_compl_support)
    (fun i r hr ↦ ContinuousMap.le_def.mpr fun x ↦ by
      simpa [coord, Algebra.algebraMap_eq_smul_one] using Complex.real_le_real.mpr (hr x.2))
    (fun i l hl ↦ ContinuousMap.le_def.mpr fun x ↦ by
      simpa [coord, Algebra.algebraMap_eq_smul_one] using Complex.real_le_real.mpr (hl x.2))

/-! ### Realization independence of sums of free selfadjoint families -/

section RealizationIndependence

variable {A B ι : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
  [CStarAlgebra B] [PartialOrder B] [StarOrderedRing B]

/-- **Realization independence for sums of free selfadjoint variables.** If `(a i)` in `(A, φ)` and
`(b i)` in `(B, ψ)` are freely independent families whose members indexed by a finite set `s` are
selfadjoint with matching marginal laws `φ.law (a i) = ψ.law (b i)`, then the finite sums
`∑ i ∈ s, a i` and `∑ i ∈ s, b i` have the same law. -/
theorem IsFreelyIndependentElements.law_sum_congr {φ : A →ₚ[ℂ] ℂ} {ψ : B →ₚ[ℂ] ℂ}
    {a : ι → A} {b : ι → B} (ha_free : IsFreelyIndependentElements φ.toLinearMap a)
    (hb_free : IsFreelyIndependentElements ψ.toLinearMap b) (hφ : φ 1 = 1) (hψ : ψ 1 = 1)
    (s : Finset ι) (ha : ∀ i ∈ s, IsSelfAdjoint (a i)) (hb : ∀ i ∈ s, IsSelfAdjoint (b i))
    (hlaw : ∀ i ∈ s, φ.law (a i) = ψ.law (b i)) :
    φ.law (∑ i ∈ s, a i) = ψ.law (∑ i ∈ s, b i) := by
  have ha_sub : IsFreelyIndependentElements φ.toLinearMap (fun k : s ↦ a k) :=
    ha_free.comp Subtype.val_injective
  have hb_sub : IsFreelyIndependentElements ψ.toLinearMap (fun k : s ↦ b k) :=
    hb_free.comp Subtype.val_injective
  have hφ' : φ.toLinearMap 1 = 1 := by simpa [PositiveLinearMap.coe_toLinearMap] using hφ
  have hψ' : ψ.toLinearMap 1 = 1 := by simpa [PositiveLinearMap.coe_toLinearMap] using hψ
  have hjd : jointDistribution φ.toLinearMap (fun k : s ↦ a k) =
      jointDistribution ψ.toLinearMap (fun k : s ↦ b k) := by
    refine ha_sub.jointDistribution_eq_of_forall_pow hb_sub hφ' hψ' fun k n ↦ ?_
    simpa only [PositiveLinearMap.coe_toLinearMap] using
      (PositiveLinearMap.law_eq_law_iff_forall_apply_pow φ ψ (ha k k.2) (hb k k.2)).mp
        (hlaw k k.2) n
  have hsa_a : IsSelfAdjoint (∑ i ∈ s, a i) := isSelfAdjoint_sum s ha
  have hsa_b : IsSelfAdjoint (∑ i ∈ s, b i) := isSelfAdjoint_sum s hb
  refine (PositiveLinearMap.law_eq_law_iff_forall_apply_pow φ ψ hsa_a hsa_b).mpr fun n ↦ ?_
  let W : FreeAlgebra ℂ s := ∑ k : s, FreeAlgebra.ι ℂ k
  have hW := LinearMap.congr_fun hjd (W ^ n)
  have heval_a : FreeAlgebra.lift ℂ (fun k : s ↦ a k) (W ^ n) = (∑ i ∈ s, a i) ^ n := by
    simp [W, map_pow, map_sum, Finset.sum_attach]
  have heval_b : FreeAlgebra.lift ℂ (fun k : s ↦ b k) (W ^ n) = (∑ i ∈ s, b i) ^ n := by
    simp [W, map_pow, map_sum, Finset.sum_attach]
  simpa only [jointDistribution_apply, heval_a, heval_b, PositiveLinearMap.coe_toLinearMap] using hW

/-- Subalgebra version of `IsFreelyIndependentElements.law_sum_congr`: if `S` and `T` are freely
independent families of subalgebras in C⋆-probability spaces `(A, φ)` and `(B, ψ)` and `a i ∈ S i`,
`b i ∈ T i` are selfadjoint on `i ∈ s` with matching laws, then `∑ i ∈ s, a i` and `∑ i ∈ s, b i`
have the same law. -/
theorem IsFreelyIndependent.law_sum_congr {φ : A →ₚ[ℂ] ℂ} {ψ : B →ₚ[ℂ] ℂ}
    {S : ι → Subalgebra ℂ A} {T : ι → Subalgebra ℂ B} {a : ι → A} {b : ι → B}
    (hS : IsFreelyIndependent φ.toLinearMap S) (hT : IsFreelyIndependent ψ.toLinearMap T)
    (hφ : φ 1 = 1) (hψ : ψ 1 = 1) (s : Finset ι)
    (ha_mem : ∀ i ∈ s, a i ∈ S i) (hb_mem : ∀ i ∈ s, b i ∈ T i)
    (ha : ∀ i ∈ s, IsSelfAdjoint (a i)) (hb : ∀ i ∈ s, IsSelfAdjoint (b i))
    (hlaw : ∀ i ∈ s, φ.law (a i) = ψ.law (b i)) :
    φ.law (∑ i ∈ s, a i) = ψ.law (∑ i ∈ s, b i) := by
  have ha_free : IsFreelyIndependentElements φ.toLinearMap (fun k : s ↦ a k) := by
    rw [isFreelyIndependentElements_iff]
    exact (hS.comp Subtype.val_injective).mono fun k ↦
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr (ha_mem k.1 k.2))
  have hb_free : IsFreelyIndependentElements ψ.toLinearMap (fun k : s ↦ b k) := by
    rw [isFreelyIndependentElements_iff]
    exact (hT.comp Subtype.val_injective).mono fun k ↦
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr (hb_mem k.1 k.2))
  have h := ha_free.law_sum_congr hb_free hφ hψ Finset.univ
    (fun k _ ↦ ha k.1 k.2) (fun k _ ↦ hb k.1 k.2) (fun k _ ↦ hlaw k.1 k.2)
  simpa only [Finset.univ_eq_attach, Finset.sum_attach] using h

end RealizationIndependence

end TauCeti

/-! ### Definition and basic properties of free additive convolution -/

namespace MeasureTheory.Measure

/-- Existence of the law of `a + b` in a Hilbert-space C⋆-realization of two compactly supported
probability measures `μ` and `ν`. -/
private theorem exists_freeConvLaw (μ ν : Measure ℝ) (hμ : IsProbabilityMeasure μ)
    (hKμ : IsCompact μ.support) (hν : IsProbabilityMeasure ν) (hKν : IsCompact ν.support) :
    ∃ ρ : Measure ℝ,
      ∃ (H : Type) (_ : NormedAddCommGroup H) (_ : InnerProductSpace ℂ H) (_ : CompleteSpace H)
        (ξ : H) (S : Fin 2 → StarSubalgebra ℂ (H →L[ℂ] H)) (T : Fin 2 → H →L[ℂ] H),
        ‖ξ‖ = 1 ∧
        (∀ i, T i ∈ S i) ∧
        (∀ i, IsSelfAdjoint (T i)) ∧
        (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law (T 0) = μ ∧
        (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law (T 1) = ν ∧
        TauCeti.IsFreelyIndependent
          (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
          (fun i ↦ (S i).toSubalgebra) ∧
        ρ = (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law (T 0 + T 1) := by
  have _ : ∀ i : Fin 2, IsProbabilityMeasure (![μ, ν] i) :=
    Fin.cases hμ (Fin.cases hν Fin.rec0)
  have hsupp : ∀ i : Fin 2, IsCompact (![μ, ν] i).support :=
    Fin.cases hKμ (Fin.cases hKν Fin.rec0)
  obtain ⟨H, _, _, _, ξ, S, T, hξ, _, hmem, hsa, hlaw, _, _, hfree, _⟩ :=
    TauCeti.exists_hilbert_isFreelyIndependent_law_eq ![μ, ν] hsupp
  exact ⟨(ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law (T 0 + T 1),
    H, inferInstance, inferInstance, inferInstance, ξ, S, T, hξ, hmem, hsa,
    hlaw 0, hlaw 1, hfree, rfl⟩

open Classical in
/-- The **free additive convolution** `μ.freeConv ν` (often denoted `μ ⊞ ν`) of two Borel measures
on `ℝ`. When `μ` and `ν` are compactly supported probability measures, it is the law of `a + b` for
freely independent bounded selfadjoint operators `a` and `b` with laws `μ` and `ν` in their reduced
C⋆-free product; otherwise it is `0`. -/
def freeConv (μ ν : Measure ℝ) : Measure ℝ :=
  if h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support then
    (exists_freeConvLaw μ ν h.1 h.2.1 h.2.2.1 h.2.2.2).choose
  else
    0

/-- Outside compactly supported probability measures, `freeConv` returns `0`. -/
theorem freeConv_of_not {μ ν : Measure ℝ}
    (h : ¬(IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support)) :
    μ.freeConv ν = 0 :=
  dite_eq_right h

/-- The zero measure is a left-absorbing element for `freeConv`. -/
@[simp]
theorem zero_freeConv (μ : Measure ℝ) : (0 : Measure ℝ).freeConv μ = 0 :=
  freeConv_of_not fun h ↦ @IsProbabilityMeasure.ne_zero _ _ 0 h.1 rfl

/-- The zero measure is a right-absorbing element for `freeConv`. -/
@[simp]
theorem freeConv_zero (μ : Measure ℝ) : μ.freeConv (0 : Measure ℝ) = 0 :=
  freeConv_of_not fun h ↦ @IsProbabilityMeasure.ne_zero _ _ 0 h.2.2.1 rfl

/-- The free additive convolution of any two measures on `ℝ` is a finite measure. -/
instance isFiniteMeasure_freeConv (μ ν : Measure ℝ) : IsFiniteMeasure (μ.freeConv ν) := by
  by_cases h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support
  · rw [freeConv, dite_eq_left h]
    obtain ⟨H, _, _, _, ξ, _, T, _, _, _, _, _, _, hρ⟩ :=
      (exists_freeConvLaw μ ν h.1 h.2.1 h.2.2.1 h.2.2.2).choose_spec
    rw [hρ]
    infer_instance
  · rw [freeConv_of_not h]
    infer_instance

/-- The topological support of `μ.freeConv ν` is always compact. -/
theorem isCompact_support_freeConv (μ ν : Measure ℝ) : IsCompact (μ.freeConv ν).support := by
  by_cases h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support
  · rw [freeConv, dite_eq_left h]
    obtain ⟨H, _, _, _, ξ, _, T, _, _, _, _, _, _, hρ⟩ :=
      (exists_freeConvLaw μ ν h.1 h.2.1 h.2.2.1 h.2.2.2).choose_spec
    rw [hρ]
    exact PositiveLinearMap.isCompact_support_law _ _
  · simp [freeConv_of_not h]

/-- The free additive convolution of two compactly supported probability measures is a probability
measure. -/
theorem isProbabilityMeasure_freeConv {μ ν : Measure ℝ} [hμ : IsProbabilityMeasure μ]
    (hKμ : IsCompact μ.support) [hν : IsProbabilityMeasure ν] (hKν : IsCompact ν.support) :
    IsProbabilityMeasure (μ.freeConv ν) := by
  have h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support := ⟨hμ, hKμ, hν, hKν⟩
  rw [freeConv, dite_eq_left h]
  obtain ⟨H, _, _, _, ξ, _, T, hξ, _, hsa, _, _, _, hρ⟩ :=
    (exists_freeConvLaw μ ν h.1 h.2.1 h.2.2.1 h.2.2.2).choose_spec
  rw [hρ]
  refine PositiveLinearMap.isProbabilityMeasure_law _ ?_ ((hsa 0).add (hsa 1))
  rw [ContinuousLinearMap.innerPositiveLinearMap_one, hξ]
  simp

/-- `μ.freeConv ν` is a probability measure if and only if both `μ` and `ν` are compactly supported
probability measures. -/
theorem isProbabilityMeasure_freeConv_iff {μ ν : Measure ℝ} :
    IsProbabilityMeasure (μ.freeConv ν) ↔
      IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
        IsProbabilityMeasure ν ∧ IsCompact ν.support := by
  refine ⟨fun hprob ↦ ?_, fun ⟨h1, h2, h3, h4⟩ ↦ isProbabilityMeasure_freeConv h2 h4⟩
  by_contra h
  exact @IsProbabilityMeasure.ne_zero _ _ (μ.freeConv ν) hprob (freeConv_of_not h)

end MeasureTheory.Measure

/-! ### Identification of `φ.law (a + b)` with `freeConv` across C⋆ and von Neumann algebras -/

namespace TauCeti

section LawAdd

variable {A ι : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- **Law of a sum of two freely independent selfadjoint elements.** For any state `φ` on a unital
C⋆-algebra `A` and any freely independent family `B` of subalgebras, if `a ∈ B i` and `b ∈ B j`
(`i ≠ j`) are selfadjoint, then the law of `a + b` is `(φ.law a).freeConv (φ.law b)`. -/
theorem IsFreelyIndependent.law_add {φ : A →ₚ[ℂ] ℂ} {B : ι → Subalgebra ℂ A}
    (hfree : IsFreelyIndependent φ.toLinearMap B) (hφ : φ 1 = 1) {i j : ι} (hij : i ≠ j)
    {a b : A} (ha_mem : a ∈ B i) (hb_mem : b ∈ B j) (ha : IsSelfAdjoint a)
    (hb : IsSelfAdjoint b) :
    φ.law (a + b) = (φ.law a).freeConv (φ.law b) := by
  have hcond : IsProbabilityMeasure (φ.law a) ∧ IsCompact (φ.law a).support ∧
      IsProbabilityMeasure (φ.law b) ∧ IsCompact (φ.law b).support :=
    ⟨PositiveLinearMap.isProbabilityMeasure_law φ hφ ha,
      PositiveLinearMap.isCompact_support_law φ a,
      PositiveLinearMap.isProbabilityMeasure_law φ hφ hb,
      PositiveLinearMap.isCompact_support_law φ b⟩
  rw [Measure.freeConv, dite_eq_left hcond]
  obtain ⟨H, _, _, _, ξ, S, T, hξ, hmem, hsa, hlaw0, hlaw1, hfreeT, hρ⟩ :=
    (Measure.exists_freeConvLaw (φ.law a) (φ.law b)
      hcond.1 hcond.2.1 hcond.2.2.1 hcond.2.2.2).choose_spec
  rw [hρ]
  have hψ : (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ) 1 = 1 := by
    rw [ContinuousLinearMap.innerPositiveLinearMap_one, hξ]
    simp
  have hinj : Function.Injective ![i, j] := by
    intro x y hxy
    fin_cases x <;> fin_cases y <;> simp_all
  have hfree2 : IsFreelyIndependent φ.toLinearMap (fun k : Fin 2 ↦ B (![i, j] k)) :=
    hfree.comp hinj
  have hcongr := hfree2.law_sum_congr hfreeT hφ hψ Finset.univ
    (a := ![a, b]) (b := T)
    (by intro k _; fin_cases k <;> assumption)
    (fun k _ ↦ hmem k)
    (by intro k _; fin_cases k <;> assumption)
    (fun k _ ↦ hsa k)
    (by intro k _; fin_cases k <;> simp [hlaw0, hlaw1])
  simpa only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one] using hcongr

/-- Element version of `IsFreelyIndependent.law_add`: if `(a k)` is a freely independent family in
`(A, φ)` and `a i`, `a j` (`i ≠ j`) are selfadjoint, then `φ.law (a i + a j)` is the free additive
convolution `(φ.law (a i)).freeConv (φ.law (a j))`. -/
theorem IsFreelyIndependentElements.law_add {φ : A →ₚ[ℂ] ℂ} {a : ι → A}
    (hfree : IsFreelyIndependentElements φ.toLinearMap a) (hφ : φ 1 = 1) {i j : ι} (hij : i ≠ j)
    (ha : IsSelfAdjoint (a i)) (hb : IsSelfAdjoint (a j)) :
    φ.law (a i + a j) = (φ.law (a i)).freeConv (φ.law (a j)) := by
  rw [isFreelyIndependentElements_iff] at hfree
  exact hfree.law_add hφ hij (Algebra.self_mem_adjoin_singleton ℂ _)
    (Algebra.self_mem_adjoin_singleton ℂ _) ha hb

end LawAdd

section VonNeumannLawAdd

variable {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- If `S` is a freely independent family of unital `⋆`-subalgebras of `H →L[ℂ] H` for a
WOT-continuous state `φ`, then selfadjoint operators `a ∈ VonNeumannAlgebra.adjoin (S i)` and
`b ∈ VonNeumannAlgebra.adjoin (S j)` (`i ≠ j`) satisfy
`φ.law (a + b) = (φ.law a).freeConv (φ.law b)`. -/
theorem IsFreelyIndependent.law_add_of_mem_vonNeumannAlgebraAdjoin
    {φ : (H →L[ℂ] H) →ₚ[ℂ] ℂ} {S : ι → StarSubalgebra ℂ (H →L[ℂ] H)}
    (hfree : IsFreelyIndependent φ.toLinearMap (fun k ↦ (S k).toSubalgebra)) (hφ : φ 1 = 1)
    (hcont : Continuous (fun T : H →WOT[ℂ] H ↦ φ T.toCLM)) {i j : ι} (hij : i ≠ j)
    {a b : H →L[ℂ] H} (ha_mem : a ∈ VonNeumannAlgebra.adjoin (S i : Set (H →L[ℂ] H)))
    (hb_mem : b ∈ VonNeumannAlgebra.adjoin (S j : Set (H →L[ℂ] H)))
    (ha : IsSelfAdjoint a) (hb : IsSelfAdjoint b) :
    φ.law (a + b) = (φ.law a).freeConv (φ.law b) := by
  have hφ' : φ.toLinearMap 1 = 1 := by simpa [PositiveLinearMap.coe_toLinearMap] using hφ
  have hcont' : Continuous (fun T : H →WOT[ℂ] H ↦ φ.toLinearMap T.toCLM) := by
    simpa only [PositiveLinearMap.coe_toLinearMap] using hcont
  exact ((isFreelyIndependent_vonNeumannAlgebraAdjoin_iff S hφ' hcont').mpr hfree).law_add hφ hij
    ha_mem hb_mem ha hb

/-- Vector-state specialization of `IsFreelyIndependent.law_add_of_mem_vonNeumannAlgebraAdjoin` at
a unit vector `ξ : H`. -/
theorem IsFreelyIndependent.law_add_of_mem_vonNeumannAlgebraAdjoin_vectorState
    {ξ : H} (hξ : ‖ξ‖ = 1) {S : ι → StarSubalgebra ℂ (H →L[ℂ] H)}
    (hfree : IsFreelyIndependent (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap
      (fun k ↦ (S k).toSubalgebra))
    {i j : ι} (hij : i ≠ j) {a b : H →L[ℂ] H}
    (ha_mem : a ∈ VonNeumannAlgebra.adjoin (S i : Set (H →L[ℂ] H)))
    (hb_mem : b ∈ VonNeumannAlgebra.adjoin (S j : Set (H →L[ℂ] H)))
    (ha : IsSelfAdjoint a) (hb : IsSelfAdjoint b) :
    (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law (a + b) =
      ((ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law a).freeConv
        ((ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).law b) := by
  have h1 : (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ) 1 = 1 := by
    rw [ContinuousLinearMap.innerPositiveLinearMap_one, hξ]
    simp
  have h1' : (ContinuousLinearMap.innerPositiveLinearMap ℂ ξ).toLinearMap 1 = 1 := by
    simpa [PositiveLinearMap.coe_toLinearMap] using h1
  exact ((isFreelyIndependent_vonNeumannAlgebraAdjoin_iff_of_vectorState S h1' ξ
    (fun T ↦ by simp [PositiveLinearMap.coe_toLinearMap])).mpr hfree).law_add h1 hij
    ha_mem hb_mem ha hb

end VonNeumannLawAdd

end TauCeti

/-! ### R-series, free cumulants, algebraic laws, affine pushforwards, and support bounds -/

namespace MeasureTheory.Measure

/-- **Additivity of the formal R-series under free additive convolution.** For compactly supported
probability measures `μ` and `ν` on `ℝ`, `(μ.freeConv ν).rSeries = μ.rSeries + ν.rSeries`. -/
theorem rSeries_freeConv {μ ν : Measure ℝ} [IsProbabilityMeasure μ] (hμ : IsCompact μ.support)
    [IsProbabilityMeasure ν] (hν : IsCompact ν.support) :
    (μ.freeConv ν).rSeries = μ.rSeries + ν.rSeries := by
  have _ : ∀ i : Fin 2, IsProbabilityMeasure (![μ, ν] i) :=
    Fin.cases ‹_› (Fin.cases ‹_› Fin.rec0)
  have hsupp : ∀ i : Fin 2, IsCompact (![μ, ν] i).support :=
    Fin.cases hμ (Fin.cases hν Fin.rec0)
  obtain ⟨H, _, _, _, ξ, S, T, hξ, _, hmem, hsa, hlaw, _, _, hfree, _⟩ :=
    TauCeti.exists_hilbert_isFreelyIndependent_law_eq ![μ, ν] hsupp
  let φ := ContinuousLinearMap.innerPositiveLinearMap ℂ ξ
  have hφ : φ 1 = 1 := by
    rw [ContinuousLinearMap.innerPositiveLinearMap_one, hξ]
    simp
  have hφ' : φ.toLinearMap 1 = 1 := by simpa [PositiveLinearMap.coe_toLinearMap] using hφ
  have hlaw0 : φ.law (T 0) = μ := by simpa using hlaw 0
  have hlaw1 : φ.law (T 1) = ν := by simpa using hlaw 1
  have hconv : μ.freeConv ν = φ.law (T 0 + T 1) := by
    rw [hfree.law_add hφ (by decide : (0 : Fin 2) ≠ 1) (hmem 0) (hmem 1) (hsa 0) (hsa 1),
      hlaw0, hlaw1]
  have hr0 : μ.rSeries = (φ.law (T 0)).rSeries := congrArg Measure.rSeries hlaw0.symm
  have hr1 : ν.rSeries = (φ.law (T 1)).rSeries := congrArg Measure.rSeries hlaw1.symm
  apply PowerSeries.map_injective Complex.ofRealHom Complex.ofReal_injective
  rw [hconv, hr0, hr1, PositiveLinearMap.map_ofReal_rSeries_law φ ((hsa 0).add (hsa 1)), map_add,
    PositiveLinearMap.map_ofReal_rSeries_law φ (hsa 0),
    PositiveLinearMap.map_ofReal_rSeries_law φ (hsa 1)]
  exact hfree.rSeries_add hφ' (by decide : (0 : Fin 2) ≠ 1) (hmem 0) (hmem 1)

/-- **Additivity of free cumulants under free additive convolution.** Every positive-order free
cumulant `κ_n` (`n ≠ 0`) is additive on compactly supported probability measures. (At `n = 0`,
`freeCumulant` is `0` by convention.) -/
theorem freeCumulant_freeConv {μ ν : Measure ℝ} [IsProbabilityMeasure μ] (hμ : IsCompact μ.support)
    [IsProbabilityMeasure ν] (hν : IsCompact ν.support) {n : ℕ} (hn : n ≠ 0) :
    (μ.freeConv ν).freeCumulant n = μ.freeCumulant n + ν.freeCumulant n := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  simp only [← coeff_rSeries, rSeries_freeConv hμ hν, map_add]

/-- Free additive convolution on `ℝ` is commutative. -/
theorem freeConv_comm (μ ν : Measure ℝ) : μ.freeConv ν = ν.freeConv μ := by
  by_cases h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support
  · obtain ⟨hμ, hKμ, hν, hKν⟩ := h
    have _ : IsProbabilityMeasure (μ.freeConv ν) := isProbabilityMeasure_freeConv hKμ hKν
    have _ : IsProbabilityMeasure (ν.freeConv μ) := isProbabilityMeasure_freeConv hKν hKμ
    rw [eq_iff_rSeries_eq (isCompact_support_freeConv μ ν) (isCompact_support_freeConv ν μ),
      rSeries_freeConv hKμ hKν, rSeries_freeConv hKν hKμ, add_comm]
  · have h' : ¬(IsProbabilityMeasure ν ∧ IsCompact ν.support ∧
        IsProbabilityMeasure μ ∧ IsCompact μ.support) := fun ⟨h1, h2, h3, h4⟩ ↦ h ⟨h3, h4, h1, h2⟩
    rw [freeConv_of_not h, freeConv_of_not h']

/-- Free additive convolution on `ℝ` is associative. -/
theorem freeConv_assoc (μ ν ρ : Measure ℝ) :
    (μ.freeConv ν).freeConv ρ = μ.freeConv (ν.freeConv ρ) := by
  by_cases h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support ∧
      IsProbabilityMeasure ρ ∧ IsCompact ρ.support
  · obtain ⟨hμ, hKμ, hν, hKν, hρ, hKρ⟩ := h
    have _ : IsProbabilityMeasure (μ.freeConv ν) := isProbabilityMeasure_freeConv hKμ hKν
    have _ : IsProbabilityMeasure (ν.freeConv ρ) := isProbabilityMeasure_freeConv hKν hKρ
    have _ : IsProbabilityMeasure ((μ.freeConv ν).freeConv ρ) :=
      isProbabilityMeasure_freeConv (isCompact_support_freeConv μ ν) hKρ
    have _ : IsProbabilityMeasure (μ.freeConv (ν.freeConv ρ)) :=
      isProbabilityMeasure_freeConv hKμ (isCompact_support_freeConv ν ρ)
    rw [eq_iff_rSeries_eq (isCompact_support_freeConv _ _) (isCompact_support_freeConv _ _),
      rSeries_freeConv (isCompact_support_freeConv μ ν) hKρ, rSeries_freeConv hKμ hKν,
      rSeries_freeConv hKμ (isCompact_support_freeConv ν ρ), rSeries_freeConv hKν hKρ, add_assoc]
  · have hL : ¬(IsProbabilityMeasure (μ.freeConv ν) ∧ IsCompact (μ.freeConv ν).support ∧
        IsProbabilityMeasure ρ ∧ IsCompact ρ.support) := by
      rw [isProbabilityMeasure_freeConv_iff]
      rintro ⟨⟨h1, h2, h3, h4⟩, _, h5, h6⟩
      exact h ⟨h1, h2, h3, h4, h5, h6⟩
    have hR : ¬(IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
        IsProbabilityMeasure (ν.freeConv ρ) ∧ IsCompact (ν.freeConv ρ).support) := by
      rw [isProbabilityMeasure_freeConv_iff]
      rintro ⟨h1, h2, ⟨h3, h4, h5, h6⟩, _⟩
      exact h ⟨h1, h2, h3, h4, h5, h6⟩
    rw [freeConv_of_not hL, freeConv_of_not hR]

private theorem isProbabilityMeasure_map_continuous (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {f : ℝ → ℝ} (hf : Continuous f) : IsProbabilityMeasure (μ.map f) :=
  ⟨by rw [Measure.map_apply hf.measurable MeasurableSet.univ]; simp⟩

private theorem isCompact_support_map_continuous {μ : Measure ℝ} (hμ : IsCompact μ.support)
    {f : ℝ → ℝ} (hf : Continuous f) : IsCompact (μ.map f).support := by
  rw [Measure.support_map_eq_closure_image μ Measure.support_mem_ae hf]
  exact (hμ.image hf).closure

private theorem isProbabilityMeasure_and_isCompact_support_map_homeomorph_iff (μ : Measure ℝ)
    (e : ℝ ≃ₜ ℝ) :
    (IsProbabilityMeasure (μ.map e) ∧ IsCompact (μ.map e).support) ↔
      IsProbabilityMeasure μ ∧ IsCompact μ.support := by
  refine ⟨fun ⟨hp, hk⟩ ↦ ?_, fun ⟨hp, hk⟩ ↦
    ⟨isProbabilityMeasure_map_continuous μ e.continuous,
      isCompact_support_map_continuous hk e.continuous⟩⟩
  have hinv : (μ.map e).map e.symm = μ := by
    rw [Measure.map_map e.symm.continuous.measurable e.continuous.measurable]
    simp [Function.comp_def]
  exact ⟨hinv ▸ isProbabilityMeasure_map_continuous (μ.map e) e.symm.continuous,
    hinv ▸ isCompact_support_map_continuous hk e.symm.continuous⟩

/-- Convolving a compactly supported probability measure `μ` with `Measure.dirac c` on the right
translates `μ` by `c`. -/
theorem freeConv_dirac {μ : Measure ℝ} [IsProbabilityMeasure μ] (hμ : IsCompact μ.support)
    (c : ℝ) : μ.freeConv (Measure.dirac c) = μ.map (· + c) := by
  have hc : IsCompact (Measure.dirac c).support := by simp [Measure.support_dirac]
  have _ : IsProbabilityMeasure (μ.freeConv (Measure.dirac c)) :=
    isProbabilityMeasure_freeConv hμ hc
  have _ : IsProbabilityMeasure (μ.map (· + c)) :=
    isProbabilityMeasure_map_continuous μ (continuous_add_const c)
  rw [eq_iff_rSeries_eq (isCompact_support_freeConv μ _)
      (isCompact_support_map_continuous hμ (continuous_add_const c)),
    rSeries_freeConv hμ hc, rSeries_dirac, rSeries_map_add_right μ hμ c]

/-- Convolving `Measure.dirac c` with a compactly supported probability measure `μ` on the left
translates `μ` by `c`. -/
theorem dirac_freeConv {μ : Measure ℝ} [IsProbabilityMeasure μ] (hμ : IsCompact μ.support)
    (c : ℝ) : (Measure.dirac c).freeConv μ = μ.map (· + c) := by
  rw [freeConv_comm, freeConv_dirac hμ]

/-- `Measure.dirac 0` is the right identity for `freeConv` on compactly supported probability
measures. -/
@[simp]
theorem freeConv_dirac_zero {μ : Measure ℝ} [IsProbabilityMeasure μ] (hμ : IsCompact μ.support) :
    μ.freeConv (Measure.dirac 0) = μ := by
  simp [freeConv_dirac hμ]

/-- `Measure.dirac 0` is the left identity for `freeConv` on compactly supported probability
measures. -/
@[simp]
theorem dirac_zero_freeConv {μ : Measure ℝ} [IsProbabilityMeasure μ] (hμ : IsCompact μ.support) :
    (Measure.dirac 0).freeConv μ = μ := by
  simp [dirac_freeConv hμ]

/-- The free additive convolution of two point masses is the point mass at the sum of their
locations. -/
@[simp]
theorem dirac_freeConv_dirac (a b : ℝ) :
    (Measure.dirac a).freeConv (Measure.dirac b) = Measure.dirac (a + b) := by
  have ha : IsCompact (Measure.dirac a).support := by simp [Measure.support_dirac]
  rw [freeConv_dirac ha, Measure.map_dirac' (measurable_add_const b)]

/-- **Affine equivariance of free additive convolution.** Pushing compactly supported probability
measures `μ` and `ν` forward by affine maps `x ↦ r * x + c₁` and `x ↦ r * x + c₂` with a common
slope `r` (including `r = 0`) pushes their free convolution forward by `x ↦ r * x + (c₁ + c₂)`.
Compactness of the supports cannot be omitted: at `r = 0`, a heavy-tailed probability measure maps
to `Measure.dirac 0`, whereas `μ.freeConv ν = 0` maps to `0`. -/
theorem freeConv_map_affine {μ ν : Measure ℝ} [IsProbabilityMeasure μ] (hμ : IsCompact μ.support)
    [IsProbabilityMeasure ν] (hν : IsCompact ν.support) (r c₁ c₂ : ℝ) :
    (μ.map (fun x ↦ r * x + c₁)).freeConv (ν.map (fun x ↦ r * x + c₂)) =
      (μ.freeConv ν).map (fun x ↦ r * x + (c₁ + c₂)) := by
  have hf₁ : Continuous (fun x : ℝ ↦ r * x + c₁) := by fun_prop
  have hf₂ : Continuous (fun x : ℝ ↦ r * x + c₂) := by fun_prop
  have hf : Continuous (fun x : ℝ ↦ r * x + (c₁ + c₂)) := by fun_prop
  have _ : IsProbabilityMeasure (μ.map (fun x ↦ r * x + c₁)) :=
    isProbabilityMeasure_map_continuous μ hf₁
  have _ : IsProbabilityMeasure (ν.map (fun x ↦ r * x + c₂)) :=
    isProbabilityMeasure_map_continuous ν hf₂
  have _ : IsProbabilityMeasure (μ.freeConv ν) := isProbabilityMeasure_freeConv hμ hν
  have _ : IsProbabilityMeasure
      ((μ.map (fun x ↦ r * x + c₁)).freeConv (ν.map (fun x ↦ r * x + c₂))) :=
    isProbabilityMeasure_freeConv (isCompact_support_map_continuous hμ hf₁)
      (isCompact_support_map_continuous hν hf₂)
  have _ : IsProbabilityMeasure ((μ.freeConv ν).map (fun x ↦ r * x + (c₁ + c₂))) :=
    isProbabilityMeasure_map_continuous (μ.freeConv ν) hf
  rw [eq_iff_rSeries_eq (isCompact_support_freeConv _ _)
      (isCompact_support_map_continuous (isCompact_support_freeConv μ ν) hf),
    rSeries_freeConv (isCompact_support_map_continuous hμ hf₁)
      (isCompact_support_map_continuous hν hf₂),
    rSeries_map_affine μ hμ r c₁, rSeries_map_affine ν hν r c₂,
    rSeries_map_affine (μ.freeConv ν) (isCompact_support_freeConv μ ν) r (c₁ + c₂),
    rSeries_freeConv hμ hν, map_add, smul_add, map_add]
  abel

/-- Rescaling compactly supported probability measures `μ` and `ν` by `r : ℝ` rescales their free
additive convolution by `r`. -/
theorem freeConv_map_mul_left {μ ν : Measure ℝ} [IsProbabilityMeasure μ] (hμ : IsCompact μ.support)
    [IsProbabilityMeasure ν] (hν : IsCompact ν.support) (r : ℝ) :
    (μ.map (r * ·)).freeConv (ν.map (r * ·)) = (μ.freeConv ν).map (r * ·) := by
  simpa using freeConv_map_affine hμ hν r 0 0

/-- Translating any two measures `μ` and `ν` on `ℝ` by `c₁` and `c₂` translates their free additive
convolution by `c₁ + c₂`. -/
theorem freeConv_map_add_right (μ ν : Measure ℝ) (c₁ c₂ : ℝ) :
    (μ.map (· + c₁)).freeConv (ν.map (· + c₂)) = (μ.freeConv ν).map (· + (c₁ + c₂)) := by
  by_cases h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support
  · obtain ⟨hμ, hKμ, hν, hKν⟩ := h
    simpa using freeConv_map_affine hKμ hKν 1 c₁ c₂
  · have h' : ¬(IsProbabilityMeasure (μ.map (· + c₁)) ∧ IsCompact (μ.map (· + c₁)).support ∧
        IsProbabilityMeasure (ν.map (· + c₂)) ∧ IsCompact (ν.map (· + c₂)).support) := by
      have he₁ := isProbabilityMeasure_and_isCompact_support_map_homeomorph_iff μ
        (Homeomorph.addRight c₁)
      have he₂ := isProbabilityMeasure_and_isCompact_support_map_homeomorph_iff ν
        (Homeomorph.addRight c₂)
      rintro ⟨hp1, hk1, hp2, hk2⟩
      exact h ⟨(he₁.mp ⟨hp1, hk1⟩).1, (he₁.mp ⟨hp1, hk1⟩).2,
        (he₂.mp ⟨hp2, hk2⟩).1, (he₂.mp ⟨hp2, hk2⟩).2⟩
    rw [freeConv_of_not h', freeConv_of_not h, Measure.map_zero]

/-- Reflecting any two measures `μ` and `ν` on `ℝ` through the origin reflects their free additive
convolution. -/
theorem freeConv_map_neg (μ ν : Measure ℝ) :
    (μ.map (-·)).freeConv (ν.map (-·)) = (μ.freeConv ν).map (-·) := by
  by_cases h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support
  · obtain ⟨hμ, hKμ, hν, hKν⟩ := h
    simpa [neg_one_mul] using freeConv_map_affine hKμ hKν (-1) 0 0
  · have h' : ¬(IsProbabilityMeasure (μ.map (-·)) ∧ IsCompact (μ.map (-·)).support ∧
        IsProbabilityMeasure (ν.map (-·)) ∧ IsCompact (ν.map (-·)).support) := by
      have he₁ := isProbabilityMeasure_and_isCompact_support_map_homeomorph_iff μ
        (Homeomorph.neg ℝ)
      have he₂ := isProbabilityMeasure_and_isCompact_support_map_homeomorph_iff ν
        (Homeomorph.neg ℝ)
      rintro ⟨hp1, hk1, hp2, hk2⟩
      exact h ⟨(he₁.mp ⟨hp1, hk1⟩).1, (he₁.mp ⟨hp1, hk1⟩).2,
        (he₂.mp ⟨hp2, hk2⟩).1, (he₂.mp ⟨hp2, hk2⟩).2⟩
    rw [freeConv_of_not h', freeConv_of_not h, Measure.map_zero]

/-! ### Topological support bounds -/

/-- Upper interval bounds on the supports of `μ` and `ν` add under free additive convolution. -/
theorem support_freeConv_subset_Iic {μ ν : Measure ℝ} {r₁ r₂ : ℝ} (h₁ : μ.support ⊆ Set.Iic r₁)
    (h₂ : ν.support ⊆ Set.Iic r₂) : (μ.freeConv ν).support ⊆ Set.Iic (r₁ + r₂) := by
  by_cases h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support
  · obtain ⟨hμ, hKμ, hν, hKν⟩ := h
    have _ : ∀ i : Fin 2, IsProbabilityMeasure (![μ, ν] i) :=
      Fin.cases hμ (Fin.cases hν Fin.rec0)
    have hsupp : ∀ i : Fin 2, IsCompact (![μ, ν] i).support :=
      Fin.cases hKμ (Fin.cases hKν Fin.rec0)
    obtain ⟨H, _, _, _, ξ, S, T, hξ, _, hmem, hsa, hlaw, hIic, _, hfree, _⟩ :=
      TauCeti.exists_hilbert_isFreelyIndependent_law_eq ![μ, ν] hsupp
    let φ := ContinuousLinearMap.innerPositiveLinearMap ℂ ξ
    have hφ : φ 1 = 1 := by
      rw [ContinuousLinearMap.innerPositiveLinearMap_one, hξ]
      simp
    have hlaw0 : φ.law (T 0) = μ := by simpa using hlaw 0
    have hlaw1 : φ.law (T 1) = ν := by simpa using hlaw 1
    have hconv : μ.freeConv ν = φ.law (T 0 + T 1) := by
      rw [hfree.law_add hφ (by decide : (0 : Fin 2) ≠ 1) (hmem 0) (hmem 1) (hsa 0) (hsa 1),
        hlaw0, hlaw1]
    rw [hconv]
    apply PositiveLinearMap.support_law_subset_Iic φ
    rw [map_add]
    exact add_le_add (hIic 0 r₁ (by simpa using h₁)) (hIic 1 r₂ (by simpa using h₂))
  · simp [freeConv_of_not h]

/-- Lower interval bounds on the supports of `μ` and `ν` add under free additive convolution. -/
theorem support_freeConv_subset_Ici {μ ν : Measure ℝ} {l₁ l₂ : ℝ} (h₁ : μ.support ⊆ Set.Ici l₁)
    (h₂ : ν.support ⊆ Set.Ici l₂) : (μ.freeConv ν).support ⊆ Set.Ici (l₁ + l₂) := by
  have hneg (ρ : Measure ℝ) (l : ℝ) (hl : ρ.support ⊆ Set.Ici l) :
      (ρ.map (-·)).support ⊆ Set.Iic (-l) := by
    have heq : (ρ.map (-·)).support = (Homeomorph.neg ℝ) '' ρ.support :=
      Measure.support_map_homeomorph ρ (Homeomorph.neg ℝ)
    rw [heq]
    rintro _ ⟨x, hx, rfl⟩
    exact Set.mem_Iic.mpr (neg_le_neg (hl hx))
  intro x hx
  have heq : ((μ.freeConv ν).map (-·)).support = (Homeomorph.neg ℝ) '' (μ.freeConv ν).support :=
    Measure.support_map_homeomorph (μ.freeConv ν) (Homeomorph.neg ℝ)
  have hx' : -x ∈ ((μ.freeConv ν).map (-·)).support := heq ▸ ⟨x, hx, rfl⟩
  rw [← freeConv_map_neg] at hx'
  have hle := support_freeConv_subset_Iic (hneg μ l₁ h₁) (hneg ν l₂ h₂) hx'
  exact Set.mem_Ici.mpr (by linarith [Set.mem_Iic.mp hle])

/-- Closed interval bounds `[l₁, r₁]` and `[l₂, r₂]` on the supports of `μ` and `ν` confine the
support of `μ.freeConv ν` to `[l₁ + l₂, r₁ + r₂]`. -/
theorem support_freeConv_subset_Icc {μ ν : Measure ℝ} {l₁ r₁ l₂ r₂ : ℝ}
    (h₁ : μ.support ⊆ Set.Icc l₁ r₁) (h₂ : ν.support ⊆ Set.Icc l₂ r₂) :
    (μ.freeConv ν).support ⊆ Set.Icc (l₁ + l₂) (r₁ + r₂) :=
  Set.subset_inter
    (support_freeConv_subset_Ici (h₁.trans Set.Icc_subset_Ici_self)
      (h₂.trans Set.Icc_subset_Ici_self))
    (support_freeConv_subset_Iic (h₁.trans Set.Icc_subset_Iic_self)
      (h₂.trans Set.Icc_subset_Iic_self))

/-- Symmetric ball bounds `[-R₁, R₁]` and `[-R₂, R₂]` on the supports of `μ` and `ν` confine the
support of `μ.freeConv ν` to `[-(R₁ + R₂), R₁ + R₂]`. -/
theorem support_freeConv_subset_closedBall {μ ν : Measure ℝ} {R₁ R₂ : ℝ}
    (h₁ : μ.support ⊆ Metric.closedBall 0 R₁) (h₂ : ν.support ⊆ Metric.closedBall 0 R₂) :
    (μ.freeConv ν).support ⊆ Metric.closedBall 0 (R₁ + R₂) := by
  simp only [Real.closedBall_eq_Icc, zero_sub, zero_add] at h₁ h₂ ⊢
  simpa only [neg_add] using support_freeConv_subset_Icc h₁ h₂

/-- The support of `μ.freeConv ν` lies in
`[sInf μ.support + sInf ν.support, sSup μ.support + sSup ν.support]`. -/
theorem support_freeConv_subset_Icc_sInf_sSup (μ ν : Measure ℝ) :
    (μ.freeConv ν).support ⊆
      Set.Icc (sInf μ.support + sInf ν.support) (sSup μ.support + sSup ν.support) := by
  by_cases h : IsProbabilityMeasure μ ∧ IsCompact μ.support ∧
      IsProbabilityMeasure ν ∧ IsCompact ν.support
  · obtain ⟨_, hKμ, _, hKν⟩ := h
    refine support_freeConv_subset_Icc
      (fun x hx ↦ ⟨csInf_le hKμ.bddBelow hx, le_csSup hKμ.bddAbove hx⟩)
      (fun x hx ↦ ⟨csInf_le hKν.bddBelow hx, le_csSup hKν.bddAbove hx⟩)
  · simp [freeConv_of_not h]

end MeasureTheory.Measure
