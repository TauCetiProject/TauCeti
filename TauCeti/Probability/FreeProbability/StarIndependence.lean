/-!
# Star-free families and their distributions

A family is star-free when the unital star subalgebras generated by its individual members
are free. The variable and its adjoint belong to the same factor: they are not required to
be free from each other. The centered-word test can equivalently use evaluations of
one-variable noncommutative star polynomials.

Star-freeness is preserved by subfamilies and state-preserving star homomorphisms, depends
only on the joint star distribution, and agrees with ordinary freeness for selfadjoint
families. For normalized functionals, the individual star distributions of a star-free
family determine its joint star distribution, even across different ambient algebras.
Neither positivity nor traciality is required.

The proofs use the range of `StarPolynomial.lift` and the uniqueness theorem
`IsFreelyIndependent.eqOn_iSup`, rather than constructing a second free-product functional.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lectures 1 and 5.
-/

public section

namespace TauCeti

open StarPolynomial

variable {R A B ι κ : Type*}

section Semiring

variable [CommSemiring R] [StarRing R]
  [Semiring A] [Algebra R A] [StarRing A] [StarModule R A]
  [Semiring B] [Algebra R B] [StarRing B] [StarModule R B]

/-- Elements are star-freely independent when their generated unital star subalgebras are
freely independent. Normalization and positivity of the functional are separate hypotheses. -/
def IsStarFreelyIndependentElements (φ : A →ₗ[R] R) (a : ι → A) : Prop :=
  IsFreelyIndependent φ fun i ↦ (StarAlgebra.adjoin R {a i}).toSubalgebra

/-- The generated-star-subalgebra criterion for star-free elements. -/
theorem isStarFreelyIndependentElements_iff {φ : A →ₗ[R] R} {a : ι → A} :
    IsStarFreelyIndependentElements φ a ↔
      IsFreelyIndependent φ fun i ↦ (StarAlgebra.adjoin R {a i}).toSubalgebra :=
  Iff.rfl

/-- Star-freeness can be tested on nonempty centered alternating words of one-variable
star-polynomial evaluations. Only consecutive labels must differ. -/
theorem isStarFreelyIndependentElements_iff_polynomial {φ : A →ₗ[R] R} {a : ι → A} :
    IsStarFreelyIndependentElements φ a ↔
      ∀ w : List (ι × StarPolynomial R Unit), w ≠ [] →
        (w.map Prod.fst).IsChain (· ≠ ·) →
        (∀ x ∈ w, φ (lift (fun _ : Unit ↦ a x.1) x.2) = 0) →
          φ (w.map fun x ↦ lift (fun _ : Unit ↦ a x.1) x.2).prod = 0 := by
  have hrange (i : ι) :
      (lift (R := R) (fun _ : Unit ↦ a i)).range = StarAlgebra.adjoin R {a i} := by
    rw [range_lift, Set.range_const]
  rw [isStarFreelyIndependentElements_iff, isFreelyIndependent_iff]
  constructor
  · intro h w hne halt hc
    simpa only [List.map_map, Function.comp_def] using
      h (w.map fun x ↦ (x.1, lift (fun _ : Unit ↦ a x.1) x.2))
        (by simpa using hne) (by simpa only [List.map_map, Function.comp_def] using halt)
        (by
          simp only [List.mem_map]
          rintro _ ⟨x, _, rfl⟩
          exact (hrange x.1).le ⟨x.2, rfl⟩)
        (by
          simp only [List.mem_map]
          rintro _ ⟨x, hx, rfl⟩
          exact hc x hx)
  · intro h w hne halt hw hc
    have hex (x : ι × A) (hx : x ∈ w) :
        ∃ p : StarPolynomial R Unit, lift (fun _ : Unit ↦ a x.1) p = x.2 := by
      have hx' : x.2 ∈ StarAlgebra.adjoin R {a x.1} := hw x hx
      rw [← hrange] at hx'
      exact hx'
    choose p hp using hex
    let w' := w.pmap (fun x hx ↦ (x.1, p x hx)) fun _ hx ↦ hx
    have heval : (w'.map fun x ↦ lift (fun _ : Unit ↦ a x.1) x.2) =
        w.map Prod.snd := by simp [w', List.map_pmap, hp]
    rw [← heval]
    refine h w' (by simpa [w'] using hne)
      (by simpa [w', List.map_pmap] using halt) ?_
    intro y hy
    obtain ⟨x, hx, rfl⟩ := List.mem_pmap.1 hy
    rw [hp]
    exact hc x hx

namespace IsStarFreelyIndependentElements

variable {φ : A →ₗ[R] R} {a : ι → A}

/-- Star-free families are freely independent without adjoints. The converse need not hold. -/
theorem isFreelyIndependentElements (h : IsStarFreelyIndependentElements φ a) :
    IsFreelyIndependentElements φ a := by
  rw [isFreelyIndependentElements_iff]
  apply IsFreelyIndependent.mono h
  intro i
  exact Algebra.adjoin_le (StarAlgebra.subset_adjoin R _)

/-- An injectively reindexed subfamily of a star-free family is star-free. -/
theorem comp (h : IsStarFreelyIndependentElements φ a) {e : κ → ι}
    (he : Function.Injective e) : IsStarFreelyIndependentElements φ (a ∘ e) :=
  IsFreelyIndependent.comp h he

/-- A star homomorphism preserving the functional sends star-free elements to star-free
elements. Injectivity is not required. -/
theorem map (h : IsStarFreelyIndependentElements φ a) (f : A →⋆ₐ[R] B)
    {ψ : B →ₗ[R] R} (hf : ψ.comp f.toAlgHom.toLinearMap = φ) :
    IsStarFreelyIndependentElements ψ (f ∘ a) := by
  have hm (i : ι) : ((StarAlgebra.adjoin R {a i}).toSubalgebra).map f.toAlgHom =
      (StarAlgebra.adjoin R {f (a i)}).toSubalgebra := by
    rw [← StarSubalgebra.map_toSubalgebra, StarAlgHom.map_adjoin, Set.image_singleton]
  simpa only [IsStarFreelyIndependentElements, hm, Function.comp_apply] using
    IsFreelyIndependent.map h f.toAlgHom hf

end IsStarFreelyIndependentElements

/-- Star-freeness can be tested after a star homomorphism if the functional is pulled back
along the same map, even when that map is not injective. -/
theorem isStarFreelyIndependentElements_map_iff (ψ : B →ₗ[R] R) (f : A →⋆ₐ[R] B)
    (a : ι → A) :
    IsStarFreelyIndependentElements ψ (f ∘ a) ↔
      IsStarFreelyIndependentElements (ψ.comp f.toAlgHom.toLinearMap) a := by
  refine ⟨fun h ↦ ?_, fun h ↦ h.map f rfl⟩
  apply IsFreelyIndependent.mono (IsFreelyIndependent.comap h f.toAlgHom)
  intro i
  have hm : ((StarAlgebra.adjoin R {a i}).toSubalgebra).map f.toAlgHom =
      (StarAlgebra.adjoin R {f (a i)}).toSubalgebra := by
    rw [← StarSubalgebra.map_toSubalgebra, StarAlgHom.map_adjoin, Set.image_singleton]
  rw [Function.comp_apply, ← hm]
  exact Subalgebra.map_le.mp le_rfl

/-- A family indexed by a subsingleton, including an empty family, is star-free. -/
theorem isStarFreelyIndependentElements_of_subsingleton [Subsingleton ι] (φ : A →ₗ[R] R)
    (a : ι → A) : IsStarFreelyIndependentElements φ a :=
  isFreelyIndependent_of_subsingleton φ _

/-- For selfadjoint families star-freeness is exactly ordinary freeness. -/
theorem isStarFreelyIndependentElements_iff_of_isSelfAdjoint {φ : A →ₗ[R] R} {a : ι → A}
    (ha : ∀ i, IsSelfAdjoint (a i)) :
    IsStarFreelyIndependentElements φ a ↔ IsFreelyIndependentElements φ a := by
  rw [isFreelyIndependentElements_iff]
  simp only [IsStarFreelyIndependentElements,
    StarAlgebra.adjoin_toSubalgebra, Set.star_singleton, (ha _).star_eq, Set.union_self]

/-- Taking the adjoint of every member preserves and reflects star-freeness. -/
@[simp]
theorem isStarFreelyIndependentElements_star_iff {φ : A →ₗ[R] R} {a : ι → A} :
    IsStarFreelyIndependentElements φ (star a) ↔ IsStarFreelyIndependentElements φ a := by
  simp only [IsStarFreelyIndependentElements, StarAlgebra.adjoin_toSubalgebra,
    Pi.star_apply, Set.star_singleton, star_star, Set.union_comm]

/-- A family is star-free exactly when the formal variables are star-free for its star
distribution. -/
theorem isStarFreelyIndependentElements_starDistribution_iff (φ : A →ₗ[R] R) (a : ι → A) :
    IsStarFreelyIndependentElements (starDistribution φ a) (X (R := R)) ↔
      IsStarFreelyIndependentElements φ a := by
  simpa only [starDistribution_def, Function.comp_def, lift_X] using
    (isStarFreelyIndependentElements_map_iff φ (lift a) (X (R := R))).symm

/-- Equality of joint star distributions preserves and reflects star-freeness. -/
theorem isStarFreelyIndependentElements_iff_of_starDistribution_eq
    {φ : A →ₗ[R] R} {ψ : B →ₗ[R] R} {a : ι → A} {b : ι → B}
    (h : starDistribution φ a = starDistribution ψ b) :
    IsStarFreelyIndependentElements φ a ↔ IsStarFreelyIndependentElements ψ b := by
  rw [← isStarFreelyIndependentElements_starDistribution_iff φ a,
    ← isStarFreelyIndependentElements_starDistribution_iff ψ b, h]

end Semiring

section Ring

variable [CommRing R] [StarRing R]
  [Ring A] [Algebra R A] [StarRing A] [StarModule R A]
  [Ring B] [Algebra R B] [StarRing B] [StarModule R B]

namespace IsStarFreelyIndependentElements

/-- Two normalized functionals making a family star-free and agreeing on every individual
star distribution agree on the star algebra generated by the whole family. -/
theorem eqOn_adjoin_range {φ ψ : A →ₗ[R] R} {a : ι → A}
    (hφ : φ 1 = 1) (hψ : ψ 1 = 1)
    (ha : IsStarFreelyIndependentElements φ a) (hb : IsStarFreelyIndependentElements ψ a)
    (hmom : ∀ i, starDistribution φ (fun _ : Unit ↦ a i) =
      starDistribution ψ (fun _ : Unit ↦ a i)) :
    Set.EqOn φ ψ (StarAlgebra.adjoin R (Set.range a)) := by
  have hadjoin : (⨆ i, (StarAlgebra.adjoin R {a i}).toSubalgebra) =
      (StarAlgebra.adjoin R (Set.range a)).toSubalgebra := by
    simp only [StarAlgebra.adjoin_toSubalgebra, ← Algebra.adjoin_iUnion]
    congr 1
    ext x
    simp only [Set.mem_iUnion, Set.mem_union, Set.mem_singleton_iff, Set.mem_star,
      Set.mem_range]
    constructor
    · rintro ⟨i, hi | hi⟩
      · exact Or.inl ⟨i, hi.symm⟩
      · exact Or.inr ⟨i, hi.symm⟩
    · rintro (⟨i, rfl⟩ | ⟨i, hi⟩)
      · exact ⟨i, Or.inl rfl⟩
      · exact ⟨i, Or.inr hi.symm⟩
  rw [← StarSubalgebra.coe_toSubalgebra, ← hadjoin]
  refine IsFreelyIndependent.eqOn_iSup hφ hψ ha hb fun i ↦ ?_
  simpa only [Set.range_const, StarSubalgebra.coe_toSubalgebra] using
    (starDistribution_eq_iff_eqOn_adjoin.mp (hmom i))

/-- The individual star distributions of star-free families determine the joint star
distribution. The ambient algebras need not be the same. -/
theorem starDistribution_eq {φ : A →ₗ[R] R} {ψ : B →ₗ[R] R} {a : ι → A} {b : ι → B}
    (ha : IsStarFreelyIndependentElements φ a) (hb : IsStarFreelyIndependentElements ψ b)
    (hφ : φ 1 = 1) (hψ : ψ 1 = 1)
    (hmom : ∀ i, starDistribution φ (fun _ : Unit ↦ a i) =
      starDistribution ψ (fun _ : Unit ↦ b i)) :
    starDistribution φ a = starDistribution ψ b := by
  have h := eqOn_adjoin_range (by simp [hφ]) (by simp [hψ])
    ((isStarFreelyIndependentElements_starDistribution_iff φ a).2 ha)
    ((isStarFreelyIndependentElements_starDistribution_iff ψ b).2 hb) ?_
  · ext p
    exact h (by rw [adjoin_range_X]; trivial)
  · intro i
    simpa only [← starDistribution_subst, lift_X] using hmom i

/-- Among star-free families, equality of joint star distributions is equivalent to equality
of all individual star distributions. Normalization also controls the empty word. -/
theorem starDistribution_eq_iff {φ : A →ₗ[R] R} {ψ : B →ₗ[R] R}
    {a : ι → A} {b : ι → B}
    (ha : IsStarFreelyIndependentElements φ a) (hb : IsStarFreelyIndependentElements ψ b)
    (hφ : φ 1 = 1) (hψ : ψ 1 = 1) :
    starDistribution φ a = starDistribution ψ b ↔
      ∀ i, starDistribution φ (fun _ : Unit ↦ a i) =
        starDistribution ψ (fun _ : Unit ↦ b i) :=
  ⟨fun h i ↦ starDistribution_comp_eq h (fun _ : Unit ↦ i),
    ha.starDistribution_eq hb hφ hψ⟩

end IsStarFreelyIndependentElements

end Ring

end TauCeti
