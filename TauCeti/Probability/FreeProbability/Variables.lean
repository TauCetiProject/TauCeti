module

public import TauCeti.Probability.FreeProbability.Independence
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
# Free independence of elements

A family of elements in a unital algebra is freely independent when the unital subalgebras
generated by the individual elements are freely independent. This file connects that definition
to the two forms used in computations: centred alternating polynomial evaluations and the
subalgebras generated by groups of variables.

The polynomial test is valid in a possibly noncommutative ambient algebra: a polynomial in one
element is evaluated using the central `R`-algebra structure. For a normalised functional, scalar
variables can be inserted or removed, and freeness determines the functional on the algebra
generated by the whole family from its one-variable polynomial moments. The definition, polynomial
test, basic transport lemmas and removal of scalar variables work over a commutative semiring;
the mixed-moment, grouping and uniqueness results use rings.

## References

* A. Nica, R. Speicher, *Lectures on the Combinatorics of Free Probability*, Lecture 5.
-/

public section

namespace TauCeti

variable {R A A' ι κ : Type*}

section Semiring

variable [CommSemiring R] [Semiring A] [Algebra R A] [Semiring A'] [Algebra R A']

/-- Elements `a i` are freely independent with respect to `φ` when the unital subalgebras
generated by the individual elements are freely independent. -/
def IsFreelyIndependentElements (φ : A →ₗ[R] R) (a : ι → A) : Prop :=
  IsFreelyIndependent φ fun i ↦ Algebra.adjoin R {a i}

/-- Free independence of elements, restated as free independence of their generated unital
subalgebras. -/
theorem isFreelyIndependentElements_iff {a : ι → A} {φ : A →ₗ[R] R} :
    IsFreelyIndependentElements φ a ↔
      IsFreelyIndependent φ fun i ↦ Algebra.adjoin R {a i} :=
  Iff.rfl

/-- Elements are freely independent exactly when every nonempty centred polynomial word with
alternating labels has zero expectation. -/
theorem isFreelyIndependentElements_iff_polynomial {a : ι → A} {φ : A →ₗ[R] R} :
    IsFreelyIndependentElements φ a ↔
      ∀ w : List (ι × Polynomial R), w ≠ [] → (w.map Prod.fst).IsChain (· ≠ ·) →
        (∀ x ∈ w, φ (Polynomial.aeval (R := R) (a x.1) x.2) = 0) →
          φ (w.map fun x ↦ Polynomial.aeval (R := R) (a x.1) x.2).prod = 0 := by
  constructor
  · intro h w hne halt hc
    rw [isFreelyIndependentElements_iff] at h
    rw [isFreelyIndependent_iff] at h
    let w' := w.map fun x ↦ (x.1, Polynomial.aeval (R := R) (a x.1) x.2)
    have hfst : w'.map Prod.fst = w.map Prod.fst := by simp [w', List.map_map]
    have hsnd : w'.map Prod.snd =
        w.map fun x ↦ Polynomial.aeval (R := R) (a x.1) x.2 := by
      simp [w', List.map_map]
    rw [← hsnd]
    exact h w' (by simpa [w'] using hne) (hfst ▸ halt)
      (by
        simp only [w', List.mem_map]
        rintro _ ⟨x, hx, rfl⟩
        exact Polynomial.aeval_mem_adjoin_singleton R (a x.1))
      (by
        simp only [w', List.mem_map]
        rintro _ ⟨x, hx, rfl⟩
        exact hc x hx)
  · intro h
    rw [isFreelyIndependentElements_iff]
    rw [isFreelyIndependent_iff]
    intro w hne halt hw hc
    classical
    let p (x : ι × A) : Polynomial R := if hx : x ∈ w then
      Classical.choose (Algebra.adjoin_mem_exists_aeval (R := R) (x := a x.1) (hw x hx)) else 0
    have hp (x : ι × A) (hx : x ∈ w) :
        Polynomial.aeval (R := R) (a x.1) (p x) = x.2 := by
      simp only [p, dite_eq_left hx]
      exact Classical.choose_spec
        (Algebra.adjoin_mem_exists_aeval (R := R) (x := a x.1) (hw x hx))
    let w' : List (ι × Polynomial R) := w.map fun x ↦ (x.1, p x)
    have hfst : w'.map Prod.fst = w.map Prod.fst := by simp [w']
    have heval : (w'.map fun x ↦ Polynomial.aeval (R := R) (a x.1) x.2) =
        w.map Prod.snd := by
      simp only [w', List.map_map]
      exact List.map_congr_left fun x hx ↦ hp x hx
    rw [← heval]
    refine h w' (by simpa [w'] using hne) (hfst ▸ halt) ?_
    rintro y hy
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hy
    simpa only [hp x hx] using hc x hx

namespace IsFreelyIndependentElements

variable {a : ι → A} {φ : A →ₗ[R] R}

/-- A subfamily of a freely independent family, selected by an injective reindexing, is freely
independent. -/
theorem comp (h : IsFreelyIndependentElements φ a) {e : κ → ι} (he : Function.Injective e) :
    IsFreelyIndependentElements φ (a ∘ e) :=
  IsFreelyIndependent.comp h he

/-- An algebra homomorphism intertwining two functionals sends freely independent elements to
freely independent elements. -/
theorem map (h : IsFreelyIndependentElements φ a) (f : A →ₐ[R] A') {φ' : A' →ₗ[R] R}
    (hf : φ'.comp f.toLinearMap = φ) : IsFreelyIndependentElements φ' (f ∘ a) := by
  simpa only [IsFreelyIndependentElements, Function.comp_apply, AlgHom.map_adjoin_singleton]
    using IsFreelyIndependent.map h f hf

end IsFreelyIndependentElements

/-- Free independence of elements can be tested after applying an algebra homomorphism,
provided that the functional is pulled back along the same homomorphism. Injectivity is not
required. -/
theorem isFreelyIndependentElements_map_iff (φ' : A' →ₗ[R] R) (f : A →ₐ[R] A') (a : ι → A) :
    IsFreelyIndependentElements φ' (f ∘ a) ↔
      IsFreelyIndependentElements (φ'.comp f.toLinearMap) a := by
  refine ⟨fun h => ?_, fun h => h.map f rfl⟩
  apply IsFreelyIndependent.mono (IsFreelyIndependent.comap h f)
  intro i
  rw [Function.comp_apply, ← AlgHom.map_adjoin_singleton]
  exact Subalgebra.map_le.mp le_rfl

/-- Every family indexed by a subsingleton type is freely independent. -/
theorem isFreelyIndependentElements_of_subsingleton [Subsingleton ι] (φ : A →ₗ[R] R)
    (a : ι → A) : IsFreelyIndependentElements φ a :=
  isFreelyIndependent_of_subsingleton φ _

/-- For a normalised functional, scalar-valued members can be added to or removed from a family
without changing free independence. -/
theorem isFreelyIndependentElements_domRestrict_iff {φ : A →ₗ[R] R} (hφ : φ 1 = 1)
    {a : ι → A} {s : Set ι} (hs : ∀ i ∉ s, ∃ r : R, a i = algebraMap R A r) :
    IsFreelyIndependentElements φ (s.domRestrict a) ↔ IsFreelyIndependentElements φ a := by
  rw [isFreelyIndependentElements_iff, isFreelyIndependentElements_iff]
  have hfamily : (fun i : s ↦ Algebra.adjoin R {s.domRestrict a i}) =
      s.domRestrict (fun i ↦ Algebra.adjoin R {a i}) := by
    funext i
    rw [Set.domRestrict_apply, Set.domRestrict_apply]
  rw [hfamily]
  apply isFreelyIndependent_domRestrict_iff hφ
  intro i hi
  obtain ⟨r, hr⟩ := hs i hi
  simpa only [hr] using Algebra.adjoin_singleton_algebraMap A r

end Semiring

section Ring

variable [CommRing R] [Ring A] [Algebra R A]

namespace IsFreelyIndependentElements

variable {a : ι → A} {φ ψ : A →ₗ[R] R}

/-- The first mixed moment of two distinct freely independent elements factorises. -/
theorem apply_mul_of_ne (h : IsFreelyIndependentElements φ a) (hφ : φ 1 = 1) {i j : ι}
    (hij : i ≠ j) : φ (a i * a j) = φ (a i) * φ (a j) :=
  IsFreelyIndependent.apply_mul_of_ne h hφ hij (Algebra.self_mem_adjoin_singleton R _)
    (Algebra.self_mem_adjoin_singleton R _)

/-- The alternating mixed moment of order three of two distinct freely independent elements:
`φ (a i * a j * a i) = φ (a i * a i) * φ (a j)`. -/
theorem apply_mul_mul_of_ne (h : IsFreelyIndependentElements φ a) (hφ : φ 1 = 1) {i j : ι}
    (hij : i ≠ j) : φ (a i * a j * a i) = φ (a i * a i) * φ (a j) :=
  IsFreelyIndependent.apply_mul_mul_of_ne h hφ hij (Algebra.self_mem_adjoin_singleton R _)
    (Algebra.self_mem_adjoin_singleton R _) (Algebra.self_mem_adjoin_singleton R _)

/-- The alternating mixed moment of order four of two distinct freely independent elements:
`φ (a i * a j * a i * a j) =
  φ (a i * a i) * φ (a j) ^ 2 + φ (a i) ^ 2 * φ (a j * a j) - φ (a i) ^ 2 * φ (a j) ^ 2`.
For centred elements it vanishes. -/
theorem apply_mul_mul_mul_of_ne (h : IsFreelyIndependentElements φ a) (hφ : φ 1 = 1) {i j : ι}
    (hij : i ≠ j) :
    φ (a i * a j * a i * a j) =
      φ (a i * a i) * φ (a j) ^ 2 + φ (a i) ^ 2 * φ (a j * a j) - φ (a i) ^ 2 * φ (a j) ^ 2 := by
  rw [IsFreelyIndependent.apply_mul_mul_mul_of_ne h hφ hij
    (Algebra.self_mem_adjoin_singleton R _) (Algebra.self_mem_adjoin_singleton R _)
    (Algebra.self_mem_adjoin_singleton R _) (Algebra.self_mem_adjoin_singleton R _)]
  ring

/-- Two distinct freely independent elements that commute have variances
`φ (a i * a i) - φ (a i) ^ 2` and `φ (a j * a j) - φ (a j) ^ 2` with vanishing product. -/
theorem sub_mul_sub_eq_zero_of_commute (h : IsFreelyIndependentElements φ a)
    (hφ : φ 1 = 1) {i j : ι} (hij : i ≠ j) (hcomm : Commute (a i) (a j)) :
    (φ (a i * a i) - φ (a i) ^ 2) * (φ (a j * a j) - φ (a j) ^ 2) = 0 :=
  IsFreelyIndependent.sub_mul_sub_eq_zero_of_commute h hφ hij
    (Algebra.self_mem_adjoin_singleton R _) (Algebra.self_mem_adjoin_singleton R _) hcomm

/-- Grouping freely independent variables along the fibres of a map gives freely independent
generated subalgebras. -/
theorem adjoin_image_fiber (h : IsFreelyIndependentElements φ a) (hφ : φ 1 = 1) (g : ι → κ) :
    IsFreelyIndependent φ fun k ↦ Algebra.adjoin R (a '' (g ⁻¹' {k})) := by
  have hEq (k : κ) :
      (⨆ (i) (_ : g i = k), Algebra.adjoin R {a i}) =
        Algebra.adjoin R (a '' (g ⁻¹' {k})) := by
    apply le_antisymm
    · refine iSup_le fun i ↦ iSup_le fun hi ↦ Algebra.adjoin_le ?_
      rintro _ (rfl : _ = a i)
      exact Algebra.subset_adjoin ⟨i, by simp [hi]⟩
    · refine Algebra.adjoin_le ?_
      rintro _ ⟨i, hi, rfl⟩
      have hik : g i = k := by simpa using hi
      exact (le_iSup₂ (f := fun i (_ : g i = k) ↦ Algebra.adjoin R {a i}) i hik)
        (Algebra.subset_adjoin (Set.mem_singleton _))
  simpa only [hEq] using IsFreelyIndependent.iSup_fiber h hφ g

/-- If two normalised functionals make a family free and have the same one-variable polynomial
moments, they agree on the unital algebra generated by the family. -/
theorem eqOn_adjoin_range (hφ : φ 1 = 1) (hψ : ψ 1 = 1)
    (hfφ : IsFreelyIndependentElements φ a) (hfψ : IsFreelyIndependentElements ψ a)
    (hmom : ∀ i (p : Polynomial R), φ (Polynomial.aeval (R := R) (a i) p) =
      ψ (Polynomial.aeval (R := R) (a i) p)) :
    Set.EqOn φ ψ (Algebra.adjoin R (Set.range a)) := by
  have hadjoin : (⨆ i, Algebra.adjoin R {a i}) = Algebra.adjoin R (Set.range a) := by
    rw [← Algebra.adjoin_iUnion]
    congr 1
    ext x
    simp
  rw [← hadjoin]
  refine IsFreelyIndependent.eqOn_iSup hφ hψ hfφ hfψ fun i x hx ↦ ?_
  obtain ⟨p, rfl⟩ := Algebra.adjoin_mem_exists_aeval (R := R) (x := a i) hx
  exact hmom i p

/-- If freely independent elements generate the ambient algebra, their one-variable polynomial
moments determine the functional. -/
theorem eq_of_adjoin_range_eq_top (hφ : φ 1 = 1) (hψ : ψ 1 = 1)
    (hfφ : IsFreelyIndependentElements φ a) (hfψ : IsFreelyIndependentElements ψ a)
    (hmom : ∀ i (p : Polynomial R), φ (Polynomial.aeval (R := R) (a i) p) =
      ψ (Polynomial.aeval (R := R) (a i) p))
    (htop : Algebra.adjoin R (Set.range a) = ⊤) : φ = ψ := by
  ext x
  exact eqOn_adjoin_range hφ hψ hfφ hfψ hmom (by rw [htop]; exact Algebra.mem_top)

end IsFreelyIndependentElements

end Ring

end TauCeti
