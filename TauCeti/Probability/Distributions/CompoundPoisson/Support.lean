module

public import TauCeti.Probability.Distributions.CompoundPoisson.Basic
public import TauCeti.MeasureTheory.Group.Convolution.MeasureSupport
public import Mathlib.Topology.Algebra.Monoid

/-!
# Support of compound Poisson laws

For a jump law with conull support, the compound Poisson support at positive rate is the
topological closure of the additive monoid generated by the jump support. Every finite number
of jumps has positive
Poisson probability, so every finite sum of support points has positive mass in each
neighbourhood. The empty sum supplies zero even when zero is outside the jump support.
At rate zero the support is the closure of the singleton zero.

This describes the finite-jump part of support arguments for infinitely divisible laws.
It requires neither moments nor an absolutely continuous jump law.

## References

* K. Sato, *Lévy Processes and Infinitely Divisible Distributions*, Cambridge University
  Press, 1999, §24 (supports of infinitely divisible distributions).
-/

public section

noncomputable section

open MeasureTheory ProbabilityTheory Set Topology
open scoped ENNReal NNReal Pointwise

namespace TauCeti.Probability

variable {A : Type*} [AddMonoid A] [TopologicalSpace A] [MeasurableSpace A]
  {r : ℝ≥0} {μ : Measure A}

/-- At positive rate, the support of each convolution power of the jump law is contained
in the support of the compound Poisson law, including the zeroth power. -/
theorem support_convolutionPower_subset_compoundPoissonMeasure (hr : r ≠ 0) (n : ℕ) :
    (μ.convolutionPower n).support ⊆ (compoundPoissonMeasure r μ).support := by
  intro x hx
  rw [Measure.support_eq_forall_isOpen]
  intro U hxU hU
  have hc : 0 < ENNReal.ofReal (Real.exp (-(r : ℝ)) * (r : ℝ) ^ n / n.factorial) := by
    apply ENNReal.ofReal_pos.mpr
    have hrpos : 0 < (r : ℝ) := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hr)
    exact div_pos (mul_pos (Real.exp_pos _) (pow_pos hrpos n)) (by positivity)
  have hle := Measure.le_sum (fun k : ℕ ↦
    ENNReal.ofReal (Real.exp (-(r : ℝ)) * (r : ℝ) ^ k / k.factorial) •
      μ.convolutionPower k) n
  rw [← compoundPoissonMeasure_eq_sum] at hle
  exact (ENNReal.mul_pos hc.ne'
    ((Measure.mem_support_iff_forall x).mp hx U (hU.mem_nhds hxU)).ne').trans_le
    (by simpa only [Measure.smul_apply, smul_eq_mul] using hle U)

variable [ContinuousAdd A] [OpensMeasurableSpace A] [MeasurableAdd₂ A]
  [SFinite μ]

/-- Every finite sum of jump-support points lies in the compound Poisson support at positive
rate. Thus every open neighbourhood of any prescribed finite jump sum has positive mass. -/
theorem list_sum_mem_support_compoundPoissonMeasure (hr : r ≠ 0)
    (l : List A) (hl : ∀ x ∈ l, x ∈ μ.support) :
    l.sum ∈ (compoundPoissonMeasure r μ).support :=
  support_convolutionPower_subset_compoundPoissonMeasure hr l.length
    (μ.list_sum_mem_support_convolutionPower l hl)

/-- At positive rate, the compound Poisson support is the closed additive monoid generated
by the support of its jump law, provided that support is conull. -/
theorem support_compoundPoissonMeasure_of_support_mem_ae (hr : r ≠ 0)
    (hμ : μ.support ∈ ae μ) :
    (compoundPoissonMeasure r μ).support =
      closure (AddSubmonoid.closure μ.support : Set A) := by
  let C := (AddSubmonoid.closure μ.support).topologicalClosure
  have hC : IsClosed (C : Set A) := isClosed_closure
  have hp (n : ℕ) : ∀ᵐ x ∂μ.convolutionPower n, x ∈ C := by
    induction n with
    | zero =>
      rw [Measure.convolutionPower_zero]
      exact (ae_dirac_iff hC.measurableSet).2 C.zero_mem
    | succ n ih =>
      rw [Measure.convolutionPower_succ, Measure.conv]
      apply (ae_map_iff (p := fun z ↦ z ∈ C)
        measurable_add.aemeasurable hC.measurableSet).2
      apply (Measure.ae_prod_iff_ae_ae (hC.measurableSet.preimage measurable_add)).2
      filter_upwards [ih] with x hx
      exact (Filter.eventually_mem_set.mpr hμ).mono fun y hy ↦
        C.add_mem hx (subset_closure (AddSubmonoid.subset_closure hy))
  apply Subset.antisymm
  · apply Measure.support_subset_of_isClosed isClosed_closure
    rw [compoundPoissonMeasure_eq_sum]
    apply (Measure.ae_sum_iff (μ := fun n : ℕ ↦
      ENNReal.ofReal (Real.exp (-(r : ℝ)) * (r : ℝ) ^ n / n.factorial) •
        μ.convolutionPower n)).2
    intro n
    exact Measure.ae_smul_measure (hp n) _
  · apply closure_minimal _ Measure.isClosed_support
    intro x hx
    obtain ⟨l, hl, rfl⟩ := AddSubmonoid.exists_list_of_mem_closure hx
    exact list_sum_mem_support_compoundPoissonMeasure hr l hl

/-- At positive rate in a hereditarily Lindelöf space, the compound Poisson support is the
closed additive monoid generated by the jump support. This includes lattice, one-sided, and
singular jump laws. -/
@[simp]
theorem support_compoundPoissonMeasure [HereditarilyLindelofSpace A] (hr : r ≠ 0) :
    (compoundPoissonMeasure r μ).support =
      closure (AddSubmonoid.closure μ.support : Set A) :=
  support_compoundPoissonMeasure_of_support_mem_ae hr Measure.support_mem_ae

end TauCeti.Probability
