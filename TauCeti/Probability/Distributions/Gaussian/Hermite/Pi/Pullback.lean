module

public import TauCeti.Probability.Distributions.Gaussian.Hermite.Pi.Basis
public import Mathlib.Probability.HasLaw

import Mathlib.MeasureTheory.Function.FactorsThrough

/-!
# Hermite expansions along a standard Gaussian vector

For any measurable finite vector `X` with the product standard Gaussian law, pullback gives
an isometry from Gaussian `L²` into the original measure space. The images of
`TauCeti.gaussianHermitePiBasis` are the explicit products of normalized Hermite polynomials
of `X`. They are orthonormal, and every claim in the isometry's range has a convergent `L²`
expansion with coefficients computed under the original measure. Every square-integrable
claim measurable for the sigma algebra generated by `X` belongs to this range.

The construction reuses the existing Gaussian Hermite basis, without rebuilding its
orthogonality or completeness. Standardized Brownian increment vectors are one application;
see `TauCeti/Probability/BrownianMotion/HermiteExpansion.lean`. The finite-dimensional Gaussian
expansion underlying Brownian martingale representation is described in Karatzas and Shreve,
*Brownian Motion and Stochastic Calculus*, second edition, §3.4.
-/

public section

open MeasureTheory ProbabilityTheory Polynomial Filter
open scoped NNReal ENNReal

namespace ProbabilityTheory.HasLaw

open TauCeti

variable {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
  {P : Measure Ω} {X : Ω → ι → ℝ}

/-- Pullback from Gaussian `L²` along a measurable standard Gaussian vector.
Its image consists of `X`-dependent claims, not all claims on the original space. -/
noncomputable def gaussianVectorL2Isometry
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X) :
    Lp ℝ 2 (Measure.pi fun _ : ι => gaussianReal 0 1) →ₗᵢ[ℝ] Lp ℝ 2 P :=
  Lp.compMeasurePreservingₗᵢ ℝ X (hX.measurePreserving hmeas)

/-- The pullback acts by composition on representatives. -/
theorem coeFn_gaussianVectorL2Isometry
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X)
    (f : Lp ℝ 2 (Measure.pi fun _ : ι => gaussianReal 0 1)) :
    ⇑(gaussianVectorL2Isometry hX hmeas f) =ᵐ[P] fun ω => f (X ω) :=
  Lp.coeFn_compMeasurePreserving _ _

/-- Every square-integrable claim measurable for the sigma algebra generated by the
Gaussian vector is in the pullback's range. -/
theorem exists_gaussianVectorL2Isometry_eq
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X)
    {g : Ω → ℝ} (hg : StronglyMeasurable[MeasurableSpace.comap X inferInstance] g)
    (hgLp : MemLp g 2 P) :
    ∃ f : Lp ℝ 2 (Measure.pi fun _ : ι => gaussianReal 0 1),
      gaussianVectorL2Isometry hX hmeas f = hgLp.toLp g := by
  obtain ⟨f, hf, hgf⟩ := hg.exists_eq_measurable_comp
  have hfLp : MemLp f 2 (Measure.pi fun _ : ι => gaussianReal 0 1) := by
    rw [← hX.map_eq]
    exact (memLp_map_measure_iff hf.aestronglyMeasurable hX.aemeasurable).2
      (hgf ▸ hgLp)
  refine ⟨hfLp.toLp f, ?_⟩
  apply Lp.ext
  have hmp := hX.measurePreserving hmeas
  filter_upwards [coeFn_gaussianVectorL2Isometry hX hmeas (hfLp.toLp f),
    hmp.quasiMeasurePreserving.ae_eq_comp hfLp.coeFn_toLp,
    hgLp.coeFn_toLp] with ω h₁ h₂ h₃
  exact h₁.trans (h₂.trans ((congrFun hgf ω).symm.trans h₃.symm))

/-- The Hermite product of a standard Gaussian vector, as an `L²` class. -/
noncomputable def gaussianVectorHermite
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X)
    (a : ι → ℕ) : Lp ℝ 2 P :=
  gaussianVectorL2Isometry hX hmeas (gaussianHermitePiBasis ℝ ι a)

/-- Pulling back a Gaussian Hermite basis vector gives the vector's Hermite product. -/
theorem gaussianVectorL2Isometry_gaussianHermitePiBasis
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X)
    (a : ι → ℕ) :
    gaussianVectorL2Isometry hX hmeas (gaussianHermitePiBasis ℝ ι a) =
      gaussianVectorHermite hX hmeas a := (rfl)

/-- The pulled-back Hermite vector is a.e. equal to the product of normalized Hermite
polynomials evaluated at the coordinates of `X`. -/
theorem coeFn_gaussianVectorHermite
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X)
    (a : ι → ℕ) :
    ⇑(gaussianVectorHermite hX hmeas a) =ᵐ[P] fun ω =>
      ∏ i, aeval (X ω i) (hermite (a i)) / Real.sqrt ((a i).factorial : ℝ) := by
  have hmp := hX.measurePreserving hmeas
  refine (coeFn_gaussianVectorL2Isometry hX hmeas _).trans ?_
  simpa only [Function.comp_def, Algebra.algebraMap_self, RingHom.id_apply] using
    hmp.quasiMeasurePreserving.ae_eq_comp (coeFn_gaussianHermitePiBasis ℝ ι a)

/-- Products of normalized Hermite polynomials of a standard Gaussian vector form an
orthonormal family in the original measure space. -/
theorem orthonormal_gaussianVectorHermite
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X) :
    Orthonormal ℝ (gaussianVectorHermite hX hmeas) := by
  convert (gaussianHermitePiBasis ℝ ι).orthonormal.comp_linearIsometry
    (gaussianVectorL2Isometry hX hmeas) using 1
  rfl

/-- Hermite coefficients can be computed in the original measure space, as expectations
against the vector's Hermite products. -/
theorem gaussianHermitePiBasis_repr_eq_integral_gaussianVectorHermite
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X)
    (f : Lp ℝ 2 (Measure.pi fun _ : ι => gaussianReal 0 1)) (a : ι → ℕ) :
    (gaussianHermitePiBasis ℝ ι).repr f a =
      ∫ ω, gaussianVectorHermite hX hmeas a ω * gaussianVectorL2Isometry hX hmeas f ω ∂P := by
  rw [(gaussianHermitePiBasis ℝ ι).repr_apply_apply,
    ← (gaussianVectorL2Isometry hX hmeas).inner_map_map,
    gaussianVectorL2Isometry_gaussianHermitePiBasis, L2.inner_def]
  simp only [RCLike.inner_apply, conj_trivial, mul_comm]

/-- Every square-integrable function of the Gaussian vector has its Hermite expansion
converging in `L²` on the original measure space. Its coefficients are computed under the
original measure, not under an auxiliary Gaussian measure. -/
theorem hasSum_gaussianVectorHermite
    (hX : HasLaw X (Measure.pi fun _ : ι => gaussianReal 0 1) P) (hmeas : Measurable X)
    (f : Lp ℝ 2 (Measure.pi fun _ : ι => gaussianReal 0 1)) :
    HasSum (fun a => (∫ ω, gaussianVectorHermite hX hmeas a ω *
      gaussianVectorL2Isometry hX hmeas f ω ∂P) • gaussianVectorHermite hX hmeas a)
      (gaussianVectorL2Isometry hX hmeas f) := by
  simpa only [map_smul, LinearIsometry.coe_toContinuousLinearMap,
    gaussianVectorL2Isometry_gaussianHermitePiBasis,
    gaussianHermitePiBasis_repr_eq_integral_gaussianVectorHermite hX hmeas] using
    (gaussianVectorL2Isometry hX hmeas).toContinuousLinearMap.hasSum
      ((gaussianHermitePiBasis ℝ ι).hasSum_repr f)

end ProbabilityTheory.HasLaw
