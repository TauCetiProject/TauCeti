/-!
# Independence of the future of exponential renewals

For independent exponential increments, the whole future count process after a deterministic
time is independent of the whole natural count history through that time. History means the
sigma-algebra generated by all observations, not just a finite collection of counts.

The residual waiting time and the unused increment sequence factor from each completed-prefix
count slice. The history-slice representation then extends this factorization to the generated
sigma-algebra. All statements apply to arbitrary measurable realizations, including time zero.

## References

* William Feller, *An Introduction to Probability Theory and Its Applications*, vol. II,
  second edition, Wiley, 1971, Chapters I and XI.
-/

public section

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter Function
open scoped ENNReal NNReal

namespace TauCeti.Probability

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
  {T : ℕ → Ω → ℝ≥0} {r : ℝ≥0}

/-- On each completed-prefix count slice, the residual waiting time and the unused increments
have the product of the exponential law and the original increment-sequence law, scaled by
the probability of the slice. This identity also applies to null slices. -/
theorem map_renewalExcess_renewalUnusedTail_restrict_prefix_count_of_expMeasure
    (hT : ∀ n, Measurable (T n)) (hindep : iIndepFun T P)
    (hlaw : ∀ n, HasLaw (fun ω ↦ (T n ω : ℝ)) (expMeasure r) P)
    (n : ℕ) {B : Set (Fin n → ℝ≥0)} (hB : MeasurableSet B) (t : ℝ≥0) :
    (P.restrict {ω | (fun i : Fin n ↦ T i ω) ∈ B ∧ renewalCountNat T t ω = n}).map
        (fun ω ↦ ((renewalExcess T t ω : ℝ), renewalUnusedTail T t ω)) =
      P {ω | (fun i : Fin n ↦ T i ω) ∈ B ∧ renewalCountNat T t ω = n} •
        (expMeasure r).prod (Measure.infinitePi (fun _ : ℕ ↦ P.map (T 0))) := by
  have := hindep.isProbabilityMeasure
  have hr : 0 < (r : ℝ) := by exact_mod_cast pos_of_hasLaw_expMeasure (hlaw 0)
  have := isProbabilityMeasure_expMeasure hr
  have hid (n : ℕ) := (hlaw n).identDistrib_nnreal (hlaw 0)
  have hzero := measure_eq_zero_lt_one_of_hasLaw_expMeasure (hlaw 0)
  let H := {ω | (fun i : Fin n ↦ T i ω) ∈ B ∧ renewalCountNat T t ω = n}
  have hE := (measurable_renewalExcess hT t).coe_nnreal_real
  have hU := measurable_renewalUnusedTail hT t
  apply Measure.ext_prod
  intro C D hC hD
  let A := {ω | (fun i : Fin n ↦ T i ω) ∈ B ∧ (arrival T (n + 1) ω - t : ℝ≥0) ∈
    NNReal.toReal ⁻¹' C}
  have hA : MeasurableSet[blockSigma T (Iio (n + 1))] A := by
    have hp : Measurable[blockSigma T (Iio (n + 1))]
        (fun ω (i : Fin n) ↦ T i ω) := by
      let : MeasurableSpace Ω := blockSigma T (Iio (n + 1))
      exact Measurable.of_eval fun i ↦
        measurable_blockSigma_of_mem (Z := T) (S := Iio (n + 1)) (by simp)
    have ha : Measurable[blockSigma T (Iio (n + 1))] (arrival T (n + 1)) :=
      measurable_arrival_of_lt fun i hi ↦ measurable_blockSigma_of_mem hi
    exact (hp hB).inter ((ha.sub_const t).coe_nnreal_real hC)
  have heq : A ∩ {ω | renewalCountNat T t ω = n} =
      (fun ω ↦ (renewalExcess T t ω : ℝ)) ⁻¹' C ∩ H := by
    ext ω
    by_cases hn : renewalCountNat T t ω = n <;>
      simp [A, H, renewalExcess_def, hn, and_comm]
  have htail := measure_preimage_inter_eq_of_map_restrict_eq_smul hU hD
    (map_renewalUnusedTail_restrict_renewalCountNat hT hindep hid hzero t n hA)
  rw [heq] at htail
  have hexcess := measure_preimage_inter_eq_of_map_restrict_eq_smul hE hC
    (map_renewalExcess_restrict_prefix_count_of_expMeasure hT hindep hlaw n hB t)
  simp only [Measure.map_apply (hE.prodMk hU) (hC.prod hD),
    Measure.restrict_apply ((hE.prodMk hU) (hC.prod hD)),
    smul_apply, smul_eq_mul, Measure.prod_prod]
  have hset : (fun ω ↦ ((renewalExcess T t ω : ℝ), renewalUnusedTail T t ω)) ⁻¹' (C ×ˢ D) ∩ H =
      (renewalUnusedTail T t ⁻¹' D) ∩ ((fun ω ↦ (renewalExcess T t ω : ℝ)) ⁻¹' C ∩ H) := by
    ext ω
    simp only [mem_preimage, mem_prod, mem_inter_iff]
    tauto
  rw [hset, htail, hexcess, mul_assoc]

/-- The residual waiting time together with all untouched increments is independent of the
entire natural count history in an exponential renewal process. -/
theorem indepFun_renewalExcess_renewalUnusedTail_history_of_expMeasure
    (hT : ∀ n, Measurable (T n)) (hindep : iIndepFun T P)
    (hlaw : ∀ n, HasLaw (fun ω ↦ (T n ω : ℝ)) (expMeasure r) P) (t : ℝ≥0) :
    IndepFun (fun ω ↦ ((renewalExcess T t ω : ℝ), renewalUnusedTail T t ω))
      (fun ω (s : Iic t) ↦ renewalCountNat T s ω) P := by
  have := hindep.isProbabilityMeasure
  have hr : 0 < (r : ℝ) := by exact_mod_cast pos_of_hasLaw_expMeasure (hlaw 0)
  have := isProbabilityMeasure_expMeasure hr
  let Y := fun ω ↦ ((renewalExcess T t ω : ℝ), renewalUnusedTail T t ω)
  let L := (expMeasure r).prod (Measure.infinitePi (fun _ : ℕ ↦ P.map (T 0)))
  have hY : Measurable Y :=
    ((measurable_renewalExcess hT t).coe_nnreal_real).prodMk (measurable_renewalUnusedTail hT t)
  have hfactor {A : Set Ω}
      (hA : MeasurableSet[MeasurableSpace.comap
        (fun ω (s : Iic t) ↦ renewalCountNat T s ω) inferInstance] A)
      {C : Set (ℝ × (ℕ → ℝ≥0))} (hC : MeasurableSet C) :
      P (A ∩ Y ⁻¹' C) = P A * L C := by
    apply measure_inter_eq_mul_of_renewal_prefix_slices hT t (hY hC) _ ?_ hA
    intro n B hB
    simpa only [inter_comm, and_comm] using
      measure_preimage_inter_eq_of_map_restrict_eq_smul hY hC
        (map_renewalExcess_renewalUnusedTail_restrict_prefix_count_of_expMeasure
          hT hindep hlaw n hB t)
  have hmarg {C : Set (ℝ × (ℕ → ℝ≥0))} (hC : MeasurableSet C) :
      P (Y ⁻¹' C) = L C := by simpa using hfactor MeasurableSet.univ hC
  rw [indepFun_iff_measure_inter_preimage_eq_mul]
  intro C A hC hA
  rw [inter_comm, hfactor (MeasurableSpace.measurableSet_comap.mpr ⟨A, hA, rfl⟩) hC,
    hmarg hC, mul_comm]

/-- In an exponential renewal process, the whole future count path after a deterministic
time is independent of the natural count history through that time. The assertion includes
all nonnegative future times simultaneously and includes observation at time zero. -/
theorem indepFun_renewalCountNat_future_history_of_expMeasure
    (hT : ∀ n, Measurable (T n)) (hindep : iIndepFun T P)
    (hlaw : ∀ n, HasLaw (fun ω ↦ (T n ω : ℝ)) (expMeasure r) P) (t : ℝ≥0) :
    IndepFun (fun ω (s : ℝ≥0) ↦ renewalCountNat T (t + s) ω - renewalCountNat T t ω)
      (fun ω (s : Iic t) ↦ renewalCountNat T s ω) P := by
  let R (y : ℝ × (ℕ → ℝ≥0)) : ℕ → ℝ≥0
    | 0 => y.1.toNNReal
    | n + 1 => y.2 n
  let count (y : ℝ × (ℕ → ℝ≥0)) (s : ℝ≥0) :=
    renewalCountNat (fun n y ↦ R y n) s y
  have hcount : Measurable count := by
    refine Measurable.of_eval fun s ↦ measurable_renewalCountNat ?_ s
    intro n
    cases n <;> dsimp only [R] <;> fun_prop
  have hi := (indepFun_renewalExcess_renewalUnusedTail_history_of_expMeasure
    hT hindep hlaw t).comp
    hcount measurable_id
  have heq : (fun ω ↦ count ((renewalExcess T t ω : ℝ), renewalUnusedTail T t ω)) =ᵐ[P]
      (fun ω (s : ℝ≥0) ↦ renewalCountNat T (t + s) ω - renewalCountNat T t ω) := by
    filter_upwards [ae_tendsto_arrival_atTop_of_expMeasure hindep hlaw] with ω hω
    have hR : (fun n y ↦ R ((renewalExcess T t y : ℝ), renewalUnusedTail T t y) n) =
        renewalRestart T t := by
      funext n y
      cases n <;> simp [R, renewalRestart_zero, renewalRestart_succ, Nat.add_right_comm]
    funext s
    dsimp only [count]
    rw [← renewalCountNat_comp (T := fun n y ↦ R y n)
      (fun y ↦ ((renewalExcess T t y : ℝ), renewalUnusedTail T t y)) s ω, hR]
    exact renewalCountNat_renewalRestart hω t s
  exact hi.congr heq (EventuallyEq.rfl)

end TauCeti.Probability
