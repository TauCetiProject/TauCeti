/-!
# Dyadic observations of continuous paths

On a finite horizon, the observations at the nested grids `k T / 2^n` generate the
Borel sigma algebra of continuous paths. Conditional expectations on these finite
observation fields approximate every real or complex `Lᵖ` claim, for `1 ≤ p < ∞`.
In particular this gives the finite-grid density needed to pass from Gaussian
cylinder expansions to arbitrary square-integrable claims.

The measure on path space need not be Wiener measure. Claims need only be almost
surely measurable, so the approximation includes claims with completed-measurable
representatives. No right-continuity assertion about an augmented natural
filtration is made here.

## References

* I. Karatzas, S. E. Shreve, *Brownian Motion and Stochastic Calculus*, second edition,
  Springer, 1991, §3.4.
-/

public section

noncomputable section

open MeasureTheory Filter Set
open scoped Topology NNReal ENNReal

namespace TauCeti

/-- The `k`th point of the level-`n` dyadic grid on `[0,T]`, including both endpoints. -/
def dyadicPoint (T : ℝ≥0) (n : ℕ) (k : Fin (2 ^ n + 1)) : Icc (0 : ℝ) T :=
  ⟨(k : ℝ) * T / (2 : ℝ) ^ n, by
    constructor
    · positivity
    · apply (div_le_iff₀ (by positivity : (0 : ℝ) < 2 ^ n)).2
      have hk : (k : ℝ) ≤ (2 : ℝ) ^ n := by
        exact_mod_cast (show (k : ℕ) ≤ 2 ^ n by omega)
      nlinarith [T.coe_nonneg]⟩

/-- The real coordinate of a dyadic grid point. -/
@[simp]
theorem coe_dyadicPoint (T : ℝ≥0) (n : ℕ) (k : Fin (2 ^ n + 1)) :
    (dyadicPoint T n k : ℝ) = (k : ℝ) * T / (2 : ℝ) ^ n :=
  (rfl)

/-- Every point of the horizon is a limit of points from successive dyadic grids.
The zero horizon is allowed. -/
theorem exists_tendsto_dyadicPoint (T : ℝ≥0) (t : Icc (0 : ℝ) T) :
    ∃ k : (n : ℕ) → Fin (2 ^ n + 1),
      Tendsto (fun n ↦ dyadicPoint T n (k n)) atTop (𝓝 t) := by
  by_cases hT : T = 0
  · subst T
    refine ⟨fun _ ↦ 0, ?_⟩
    have ht : t = ⟨0, by simp⟩ := Subtype.ext (by simpa using t.property)
    subst t
    simpa [dyadicPoint] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (⟨0, by simp⟩ : Icc (0 : ℝ) 0)) atTop _)
  have hTpos : (0 : ℝ) < T := by exact_mod_cast (pos_iff_ne_zero.2 hT)
  let k (n : ℕ) : Fin (2 ^ n + 1) :=
    ⟨⌊(t : ℝ) / T * (2 : ℝ) ^ n⌋₊, by
      have hle : (t : ℝ) / T * (2 : ℝ) ^ n ≤ (2 : ℝ) ^ n := by
        nlinarith [(div_le_one hTpos).2 t.property.2,
          (show (0 : ℝ) ≤ 2 ^ n by positivity)]
      have hb : ⌊(t : ℝ) / T * (2 : ℝ) ^ n⌋₊ ≤ 2 ^ n := by
        apply Nat.floor_le_of_le
        simpa using hle
      omega⟩
  refine ⟨k, tendsto_subtype_rng.2 ?_⟩
  have h := (tendsto_nat_floor_mul_div_atTop (div_nonneg t.property.1 hTpos.le)).comp
    (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 2))
  have hmul := h.mul_const (T : ℝ)
  rw [div_mul_cancel₀ (t : ℝ) hTpos.ne'] at hmul
  convert hmul using 1
  ext n
  dsimp [dyadicPoint, k, Function.comp_def]
  ring

/-- The filtration on continuous path space generated by the level-`n` dyadic
observations. Each level uses only the finite grid `k T / 2^n`. -/
def dyadicObservationFiltration (T : ℝ≥0) :
    Filtration ℕ (borel C(Icc (0 : ℝ) T, ℝ)) where
  seq n := ⨆ k : Fin (2 ^ n + 1), (borel ℝ).comap
    (fun γ : C(Icc (0 : ℝ) T, ℝ) ↦ γ (dyadicPoint T n k))
  mono' := monotone_nat_of_le_succ fun n ↦ by
    refine iSup_le fun k ↦ ?_
    let j : Fin (2 ^ (n + 1) + 1) := ⟨2 * k.val, by
      have := k.isLt
      rw [pow_succ]
      omega⟩
    have heq : dyadicPoint T (n + 1) j = dyadicPoint T n k := by
      apply Subtype.ext
      simp only [coe_dyadicPoint, j, Nat.cast_mul, Nat.cast_ofNat, pow_succ]
      field_simp
    exact le_iSup_of_le j (by rw [heq])
  le' n := iSup_le fun k ↦
    (ContinuousMap.measurable_eval (dyadicPoint T n k)).comap_le

/-- The observation field is exactly the field generated by the finite dyadic vector. -/
theorem dyadicObservationFiltration_apply (T : ℝ≥0) (n : ℕ) :
    dyadicObservationFiltration T n =
      (inferInstance : MeasurableSpace (Fin (2 ^ n + 1) → ℝ)).comap
        (fun γ : C(Icc (0 : ℝ) T, ℝ) ↦ fun k ↦ γ (dyadicPoint T n k)) := by
  rw [MeasurableSpace.comap_process_pi]
  simp only [BorelSpace.measurable_eq]
  rfl

/-- Dyadic evaluations generate the full Borel sigma algebra of continuous paths. -/
theorem iSup_dyadicObservationFiltration (T : ℝ≥0) :
    (⨆ n, dyadicObservationFiltration T n) = borel C(Icc (0 : ℝ) T, ℝ) := by
  apply le_antisymm (iSup_le (dyadicObservationFiltration T).le)
  calc
    borel C(Icc (0 : ℝ) T, ℝ) =
        ⨆ t, (borel ℝ).comap (fun γ : C(Icc (0 : ℝ) T, ℝ) ↦ γ t) :=
      ContinuousMap.borel_eq_iSup_comap_eval
    _ ≤ ⨆ n, dyadicObservationFiltration T n := ?_
  refine iSup_le fun t ↦ ?_
  obtain ⟨k, hk⟩ := exists_tendsto_dyadicPoint T t
  let : MeasurableSpace C(Icc (0 : ℝ) T, ℝ) := ⨆ n, dyadicObservationFiltration T n
  apply measurable_iff_comap_le.1
  apply measurable_of_tendsto_metrizable (f := fun n γ ↦ γ (dyadicPoint T n (k n)))
  · intro n
    exact (comap_measurable _).mono
      ((le_iSup (fun k : Fin (2 ^ n + 1) ↦ (borel ℝ).comap
        (fun γ : C(Icc (0 : ℝ) T, ℝ) ↦ γ (dyadicPoint T n k))) (k n)).trans
          (le_iSup (fun n ↦ dyadicObservationFiltration T n) n)) le_rfl
  · exact tendsto_pi_nhds.2 fun γ ↦ γ.continuous.continuousAt.tendsto.comp hk

/-- Finite dyadic conditional prices converge in `Lᵖ` to every claim on continuous
path space. Almost-sure measurability suffices, including completed-measurable claims. -/
theorem tendsto_eLpNorm_condExp_dyadicObservation {T : ℝ≥0}
    {μ : Measure C(Icc (0 : ℝ) T, ℝ)} [IsFiniteMeasure μ]
    {𝕜 : Type*} [RCLike 𝕜] {p : ℝ≥0∞} (hp : 1 ≤ p) (hp' : p ≠ ∞)
    {f : C(Icc (0 : ℝ) T, ℝ) → 𝕜} (hf : MemLp f p μ) :
    Tendsto (fun n ↦ eLpNorm (μ[f | dyadicObservationFiltration T n] - f) p μ)
      atTop (𝓝 0) := by
  have h := hf.tendsto_eLpNorm_condExp (ℱ := dyadicObservationFiltration T) hp'
  rw [iSup_dyadicObservationFiltration] at h
  have heq := condExp_of_aestronglyMeasurable' le_rfl hf.aestronglyMeasurable
    (hf.integrable hp)
  exact h.congr fun n ↦
    eLpNorm_congr_ae (Filter.EventuallyEq.sub (Filter.EventuallyEq.refl _ _) heq)

/-- Every `Lᵖ` claim can be approximated arbitrarily well by a measurable function
of one finite dyadic observation vector, still in `Lᵖ`. This is in particular the
finite-grid density theorem for square-integrable claims. -/
theorem exists_dyadicObservation_approx {T : ℝ≥0}
    {μ : Measure C(Icc (0 : ℝ) T, ℝ)} [IsFiniteMeasure μ]
    {𝕜 : Type*} [RCLike 𝕜] {p : ℝ≥0∞} (hp : 1 ≤ p) (hp' : p ≠ ∞)
    {f : C(Icc (0 : ℝ) T, ℝ) → 𝕜} (hf : MemLp f p μ) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ (n : ℕ) (g : (Fin (2 ^ n + 1) → ℝ) → 𝕜), StronglyMeasurable g ∧
      MemLp (fun γ ↦ g (fun k ↦ γ (dyadicPoint T n k))) p μ ∧
      eLpNorm ((fun γ ↦ g (fun k ↦ γ (dyadicPoint T n k))) - f) p μ < ε := by
  obtain ⟨n, hn⟩ := ((tendsto_order.1
    (tendsto_eLpNorm_condExp_dyadicObservation hp hp' hf)).2 ε hε).exists
  have hm : StronglyMeasurable[dyadicObservationFiltration T n]
      (μ[f | dyadicObservationFiltration T n]) := stronglyMeasurable_condExp
  rw (occs := .pos [1]) [dyadicObservationFiltration_apply] at hm
  obtain ⟨g, hg, heq⟩ := hm.exists_eq_measurable_comp
  refine ⟨n, g, hg, ?_, ?_⟩
  · simpa only [heq, Function.comp_def] using (hf.condExp (m := dyadicObservationFiltration T n) hp)
  · simpa only [heq, Function.comp_def] using hn

end TauCeti
