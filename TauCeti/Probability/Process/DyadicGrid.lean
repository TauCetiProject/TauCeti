/-!
# Dyadic observations of continuous paths

On a finite horizon, the observations at the nested grids `k T / 2^n` generate the
Borel sigma algebra of continuous paths into any second-countable pseudometrizable
space. Conditional expectations on these finite observation fields approximate
every real or complex `Lᵖ` claim, for `1 ≤ p < ∞`.
In particular this gives the finite-grid density needed to pass from Gaussian
cylinder expansions to arbitrary square-integrable claims on real path space.

The measure on path space may be any finite measure, not necessarily Wiener measure.
Claims need only be almost surely measurable, so the approximation includes claims
with completed-measurable representatives. No right-continuity assertion about an
augmented natural filtration is made here.

The same holds for a real process on an arbitrary probability space whose paths are only
almost surely continuous on `[0, T]`, so that it need not define a measurable map into
continuous path space. Its observations at the dyadic times `dyadicTime T n k = k T / 2^n`
generate the filtration `MeasureTheory.Filtration.dyadicNatural`. Every event of the natural
filtration at `T` agrees almost surely with an event observed at dyadic times, and
conditional expectations on the dyadic observations converge in `Lᵖ` to every `Lᵖ` claim
measurable for the null-augmented natural filtration at `T`.

## References

* I. Karatzas, S. E. Shreve, *Brownian Motion and Stochastic Calculus*, second edition,
  Springer, 1991, §3.4.
-/

public section

noncomputable section

open MeasureTheory Filter Set TopologicalSpace
open scoped Topology NNReal ENNReal

namespace TauCeti

variable {Y : Type*} [TopologicalSpace Y] [MeasurableSpace Y] [BorelSpace Y]

/-- The filtration on continuous path space generated by the level-`n` dyadic
observations. Each level uses only the finite grid `k T / 2^n`. -/
def dyadicObservationFiltration (T : ℝ≥0) :
    Filtration ℕ (borel C(Icc (0 : ℝ) T, Y)) where
  seq n := ⨆ k : Fin (2 ^ n + 1), (borel Y).comap
    (fun γ : C(Icc (0 : ℝ) T, Y) ↦ γ (dyadicPoint T.coe_nonneg n k))
  mono' := monotone_nat_of_le_succ fun n ↦ by
    refine iSup_le fun k ↦ ?_
    obtain ⟨j, heq⟩ := exists_dyadicPoint_eq_of_le T.coe_nonneg k (Nat.le_succ n)
    exact le_iSup_of_le j (by rw [heq])
  le' n := iSup_le fun k ↦ by
    simpa only [BorelSpace.measurable_eq] using
      (ContinuousMap.measurable_eval (Y := Y) (dyadicPoint T.coe_nonneg n k)).comap_le

/-- Each level of the observation filtration is the supremum of its evaluation fields. -/
theorem dyadicObservationFiltration_eq_iSup (T : ℝ≥0) (n : ℕ) :
    dyadicObservationFiltration (Y := Y) T n =
      ⨆ k : Fin (2 ^ n + 1), (borel Y).comap
        (fun γ : C(Icc (0 : ℝ) T, Y) ↦ γ (dyadicPoint T.coe_nonneg n k)) := by
  rfl

/-- Each dyadic evaluation is measurable for its level's observation field. -/
theorem comap_eval_le_dyadicObservationFiltration (T : ℝ≥0) (n : ℕ)
    (k : Fin (2 ^ n + 1)) :
    (borel Y).comap (fun γ : C(Icc (0 : ℝ) T, Y) ↦ γ (dyadicPoint T.coe_nonneg n k)) ≤
      dyadicObservationFiltration T n := by
  rw [dyadicObservationFiltration_eq_iSup]
  exact le_iSup_of_le k le_rfl

/-- The observation field is exactly the field generated by the finite dyadic vector. -/
theorem dyadicObservationFiltration_apply (T : ℝ≥0) (n : ℕ) :
    dyadicObservationFiltration (Y := Y) T n =
      (inferInstance : MeasurableSpace (Fin (2 ^ n + 1) → Y)).comap
        (fun γ : C(Icc (0 : ℝ) T, Y) ↦ fun k ↦ γ (dyadicPoint T.coe_nonneg n k)) := by
  rw [dyadicObservationFiltration_eq_iSup, MeasurableSpace.comap_process_pi]
  simp only [BorelSpace.measurable_eq]

variable [SecondCountableTopology Y] [PseudoMetrizableSpace Y]

/-- Dyadic evaluations generate the full Borel sigma algebra of continuous paths. -/
theorem iSup_dyadicObservationFiltration (T : ℝ≥0) :
    (⨆ n, dyadicObservationFiltration (Y := Y) T n) = borel C(Icc (0 : ℝ) T, Y) := by
  apply le_antisymm (iSup_le (dyadicObservationFiltration T).le)
  calc
    borel C(Icc (0 : ℝ) T, Y) =
        ⨆ t ∈ ⋃ n, range (dyadicPoint T.coe_nonneg n),
          (borel Y).comap (fun γ : C(Icc (0 : ℝ) T, Y) ↦ γ t) :=
      ContinuousMap.borel_eq_iSup_comap_eval_of_dense (dense_iUnion_range_dyadicPoint T.coe_nonneg)
    _ ≤ ⨆ n, dyadicObservationFiltration T n := by
      refine iSup_le fun t ↦ iSup_le fun ht ↦ ?_
      obtain ⟨n, k, rfl⟩ := mem_iUnion.1 ht
      exact (comap_eval_le_dyadicObservationFiltration T n k).trans (le_iSup _ n)

/-- For a finite measure and `1 ≤ p < ∞`, conditional expectations on the finite dyadic
observation fields converge in `Lᵖ` to every `Lᵖ` claim on continuous path space.
Almost-sure measurability suffices, including completed-measurable claims. -/
theorem tendsto_eLpNorm_condExp_dyadicObservationFiltration {T : ℝ≥0}
    {μ : Measure C(Icc (0 : ℝ) T, Y)} [IsFiniteMeasure μ]
    {𝕜 : Type*} [RCLike 𝕜] {p : ℝ≥0∞} (hp : 1 ≤ p) (hp' : p ≠ ∞)
    {f : C(Icc (0 : ℝ) T, Y) → 𝕜} (hf : MemLp f p μ) :
    Tendsto (fun n ↦ eLpNorm (μ[f | dyadicObservationFiltration T n] - f) p μ)
      atTop (𝓝 0) := by
  have h := hf.tendsto_eLpNorm_condExp (ℱ := dyadicObservationFiltration T) hp'
  rw [iSup_dyadicObservationFiltration] at h
  have heq := condExp_of_aestronglyMeasurable' le_rfl hf.aestronglyMeasurable
    (hf.integrable hp)
  exact h.congr fun n ↦
    eLpNorm_congr_ae (Filter.EventuallyEq.sub (Filter.EventuallyEq.refl _ _) heq)

/-- Every `Lᵖ` claim can be approximated arbitrarily well by a measurable function
of one finite dyadic observation vector, still in `Lᵖ`. This is in particular the
finite-grid density theorem for square-integrable claims. -/
theorem exists_eLpNorm_comp_dyadicPoint_sub_lt {T : ℝ≥0}
    {μ : Measure C(Icc (0 : ℝ) T, Y)} [IsFiniteMeasure μ]
    {𝕜 : Type*} [RCLike 𝕜] {p : ℝ≥0∞} (hp : 1 ≤ p) (hp' : p ≠ ∞)
    {f : C(Icc (0 : ℝ) T, Y) → 𝕜} (hf : MemLp f p μ) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ (n : ℕ) (g : (Fin (2 ^ n + 1) → Y) → 𝕜), StronglyMeasurable g ∧
      MemLp (fun γ ↦ g (fun k ↦ γ (dyadicPoint T.coe_nonneg n k))) p μ ∧
      eLpNorm ((fun γ ↦ g (fun k ↦ γ (dyadicPoint T.coe_nonneg n k))) - f) p μ < ε := by
  obtain ⟨n, hn⟩ := ((tendsto_order.1
    (tendsto_eLpNorm_condExp_dyadicObservationFiltration hp hp' hf)).2 ε hε).exists
  have hm : StronglyMeasurable[(inferInstance : MeasurableSpace (Fin (2 ^ n + 1) → Y)).comap
      (fun γ : C(Icc (0 : ℝ) T, Y) ↦ fun k ↦ γ (dyadicPoint T.coe_nonneg n k))]
      (μ[f | dyadicObservationFiltration T n]) := by
    exact stronglyMeasurable_condExp.mono (le_of_eq (dyadicObservationFiltration_apply T n))
  obtain ⟨g, hg, heq⟩ := hm.exists_eq_measurable_comp
  refine ⟨n, g, hg, ?_, ?_⟩
  · simpa only [heq, Function.comp_def] using (hf.condExp (m := dyadicObservationFiltration T n) hp)
  · simpa only [heq, Function.comp_def] using hn

/-- The `k`th level-`n` dyadic time `k T / 2 ^ n` of the horizon `[0, T]`, as a time of a
process indexed by `ℝ≥0`. Its real value is that of `dyadicPoint T.coe_nonneg n k`. -/
noncomputable def dyadicTime (T : ℝ≥0) (n : ℕ) (k : Fin (2 ^ n + 1)) : ℝ≥0 :=
  ⟨dyadicPoint T.coe_nonneg n k, (dyadicPoint T.coe_nonneg n k).2.1⟩

/-- The real value of a dyadic time is that of the corresponding point of `[0, T]`. -/
theorem coe_dyadicTime_eq_coe_dyadicPoint (T : ℝ≥0) (n : ℕ) (k : Fin (2 ^ n + 1)) :
    (dyadicTime T n k : ℝ) = dyadicPoint T.coe_nonneg n k :=
  (rfl)

/-- The real value of a dyadic time. -/
@[simp]
theorem coe_dyadicTime (T : ℝ≥0) (n : ℕ) (k : Fin (2 ^ n + 1)) :
    (dyadicTime T n k : ℝ) = k * (T / 2 ^ n) := by
  simp [coe_dyadicTime_eq_coe_dyadicPoint]

/-- The first dyadic time of every level is the initial time. -/
@[simp]
theorem dyadicTime_zero (T : ℝ≥0) (n : ℕ) : dyadicTime T n 0 = 0 :=
  NNReal.eq (by simp)

/-- Dyadic times lie in the horizon. -/
theorem dyadicTime_le (T : ℝ≥0) (n : ℕ) (k : Fin (2 ^ n + 1)) : dyadicTime T n k ≤ T :=
  NNReal.coe_le_coe.1 (dyadicPoint T.coe_nonneg n k).2.2

/-- For a positive horizon, the dyadic times of each level are strictly increasing. -/
theorem strictMono_dyadicTime {T : ℝ≥0} (hT : 0 < T) (n : ℕ) :
    StrictMono (dyadicTime T n) := by
  intro i j hij
  rw [← NNReal.coe_lt_coe, coe_dyadicTime, coe_dyadicTime]
  exact mul_lt_mul_of_pos_right (by exact_mod_cast hij) (by positivity)

/-- A dyadic time of level `m` is also a dyadic time of every finer level. -/
theorem exists_dyadicTime_eq_of_le (T : ℝ≥0) {m n : ℕ} (k : Fin (2 ^ m + 1)) (hmn : m ≤ n) :
    ∃ j, dyadicTime T m k = dyadicTime T n j := by
  obtain ⟨j, hj⟩ := exists_dyadicPoint_eq_of_le T.coe_nonneg k hmn
  exact ⟨j, NNReal.eq (by rw [coe_dyadicTime_eq_coe_dyadicPoint,
    coe_dyadicTime_eq_coe_dyadicPoint, hj])⟩

end TauCeti

namespace MeasureTheory.Filtration

open TauCeti

variable {Ω : Type*} {m : MeasurableSpace Ω}

/-- The filtration generated by the observations of a process `X` at the dyadic times
`k T / 2 ^ n`, `k ≤ 2 ^ n`, of the horizon `[0, T]`. Level `n` uses only these `2 ^ n + 1`
observations. -/
def dyadicNatural {E : Type*} [MeasurableSpace E] (X : ℝ≥0 → Ω → E)
    (hX : ∀ t, Measurable (X t)) (T : ℝ≥0) : Filtration ℕ m where
  seq n := ⨆ k : Fin (2 ^ n + 1), (inferInstance : MeasurableSpace E).comap (X (dyadicTime T n k))
  mono' := monotone_nat_of_le_succ fun n ↦ by
    refine iSup_le fun k ↦ ?_
    obtain ⟨j, heq⟩ := exists_dyadicTime_eq_of_le T k (Nat.le_succ n)
    exact le_iSup_of_le j (by rw [heq])
  le' n := iSup_le fun k ↦ (hX _).comap_le

/-- The dyadic observations up to `T` are part of the natural filtration at `T`. -/
theorem dyadicNatural_le_natural {E : Type*} [TopologicalSpace E] [MetrizableSpace E]
    [MeasurableSpace E] [BorelSpace E] {X : ℝ≥0 → Ω → E} (hX : ∀ t, StronglyMeasurable (X t))
    (T : ℝ≥0) (n : ℕ) :
    dyadicNatural X (fun t ↦ (hX t).measurable) T n ≤ natural X hX T :=
  iSup_le fun k ↦ le_iSup₂_of_le (dyadicTime T n k) (dyadicTime_le T n k) le_rfl

variable {E : Type*} [MeasurableSpace E] {X : ℝ≥0 → Ω → E} {hX : ∀ t, Measurable (X t)}

/-- Each level of the dyadic filtration is the supremum of its observation fields. -/
theorem dyadicNatural_eq_iSup (T : ℝ≥0) (n : ℕ) :
    dyadicNatural X hX T n =
      ⨆ k : Fin (2 ^ n + 1), (inferInstance : MeasurableSpace E).comap (X (dyadicTime T n k)) :=
  (rfl)

/-- Each level of the dyadic filtration is generated by the finite vector of its observations. -/
theorem dyadicNatural_apply (T : ℝ≥0) (n : ℕ) :
    dyadicNatural X hX T n = (inferInstance : MeasurableSpace (Fin (2 ^ n + 1) → E)).comap
      fun ω k ↦ X (dyadicTime T n k) ω := by
  rw [dyadicNatural_eq_iSup, MeasurableSpace.comap_process_pi]

/-- Each dyadic observation is measurable for its level of the dyadic filtration. -/
theorem comap_le_dyadicNatural (T : ℝ≥0) (n : ℕ) (k : Fin (2 ^ n + 1)) :
    (inferInstance : MeasurableSpace E).comap (X (dyadicTime T n k)) ≤ dyadicNatural X hX T n :=
  le_iSup_of_le k le_rfl

variable {P : Measure Ω}

/-- If almost every path of a real process is continuous on `[0, T]`, then every event of its
natural filtration at `T` agrees almost surely with an event generated by its dyadic
observations of all levels. The exceptional path set need not be measurable. -/
theorem natural_le_eventuallyMeasurableSpace_iSup_dyadicNatural {W : ℝ≥0 → Ω → ℝ}
    (hW : ∀ t, StronglyMeasurable (W t)) {T : ℝ≥0}
    (hcont : ∀ᵐ ω ∂P, ContinuousOn (W · ω) (Set.Iic T)) :
    natural W hW T ≤ eventuallyMeasurableSpace
      (⨆ n, dyadicNatural W (fun t ↦ (hW t).measurable) T n) (ae P) := by
  set 𝒟 := ⨆ n, dyadicNatural W (fun t ↦ (hW t).measurable) T n
  refine iSup₂_le fun s hs ↦ measurable_iff_comap_le.1 ?_
  -- Approximate `s` by dyadic times, using their density in the real interval `[0, T]`.
  obtain ⟨u, hu, hlim⟩ := mem_closure_iff_seq_limit.1
    (dense_iUnion_range_dyadicPoint T.coe_nonneg (⟨s, s.2, hs⟩ : Icc (0 : ℝ) T))
  choose j hj using fun n ↦ mem_iUnion.1 (hu n)
  choose k hk using hj
  let v : ℕ → ℝ≥0 := fun n ↦ dyadicTime T (j n) (k n)
  have hv (n : ℕ) : Measurable[𝒟] (W (v n)) :=
    measurable_iff_comap_le.2 ((comap_le_dyadicNatural (hX := fun t ↦ (hW t).measurable)
      T (j n) (k n)).trans (le_iSup (fun n ↦ dyadicNatural W _ T n) (j n)))
  have hvlim : Tendsto v atTop (𝓝[Set.Iic T] s) := by
    refine tendsto_nhdsWithin_iff.2 ⟨NNReal.tendsto_coe.1 ?_,
      Eventually.of_forall fun n ↦ dyadicTime_le T (j n) (k n)⟩
    have hvu : (fun n ↦ (v n : ℝ)) = fun n ↦ (u n : ℝ) :=
      funext fun n ↦ by rw [coe_dyadicTime_eq_coe_dyadicPoint, hk]
    rw [hvu]
    exact (continuous_subtype_val.tendsto _).comp hlim
  -- Off a null set, the observation at `s` is the limit of the dyadic observations.
  refine (Measurable.limsup (mδ := 𝒟) hv).eventuallyMeasurable_of_eventuallyEq ?_
  filter_upwards [hcont] with ω hω
  exact (((hω s hs).tendsto.comp hvlim).limsup_eq).symm

/-- For a real process whose paths are almost surely continuous on `[0, T]`, conditional
expectations on its dyadic observation fields converge in `Lᵖ`, `1 ≤ p < ∞`, to every `Lᵖ`
claim measurable for its null-augmented natural filtration at `T`. -/
theorem tendsto_eLpNorm_condExp_dyadicNatural [IsFiniteMeasure P] {W : ℝ≥0 → Ω → ℝ}
    (hW : ∀ t, StronglyMeasurable (W t)) {T : ℝ≥0}
    (hcont : ∀ᵐ ω ∂P, ContinuousOn (W · ω) (Set.Iic T))
    {𝕜 : Type*} [RCLike 𝕜] {p : ℝ≥0∞} (hp : 1 ≤ p) (hp' : p ≠ ∞) {f : Ω → 𝕜}
    (hf : MemLp f p P) (hfm : AEStronglyMeasurable[(natural W hW).nullAugment P T] f P) :
    Tendsto (fun n ↦ eLpNorm (P[f | dyadicNatural W (fun t ↦ (hW t).measurable) T n] - f) p P)
      atTop (𝓝 0) := by
  set G := dyadicNatural W (fun t ↦ (hW t).measurable) T
  have hle : (natural W hW).nullAugment P T ≤ eventuallyMeasurableSpace (⨆ n, G n) (ae P) := by
    intro s hs
    obtain ⟨t, ht, hst⟩ := (measurableSet_nullAugment_iff _ P T s).1 hs
    obtain ⟨u, hu, htu⟩ := natural_le_eventuallyMeasurableSpace_iSup_dyadicNatural hW hcont t ht
    exact ⟨u, hu, hst.trans htu⟩
  have hfix : P[f | ⨆ n, G n] =ᵐ[P] f :=
    TauCeti.MeasureTheory.condExp_of_aestronglyMeasurable_eventuallyMeasurableSpace
      (iSup_le G.le) (hfm.mono hle) (hf.integrable hp)
  exact (hf.tendsto_eLpNorm_condExp (ℱ := G) hp').congr fun n ↦
    eLpNorm_congr_ae ((Filter.EventuallyEq.refl _ _).sub hfix)

end MeasureTheory.Filtration
