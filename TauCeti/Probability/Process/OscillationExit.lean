/-!
# Oscillation exit stopping times and càdlàg step approximations

For a strongly adapted process `X : ℝ≥0 → Ω → E` with everywhere càdlàg paths in a pseudometric
space `E` and any threshold `ε > 0`, the pathwise `ε`-oscillation exit time
`TauCeti.oscillationExitAfter (X · ω) ε (τ ω)` after a stopping time `τ` is a stopping time on the
raw filtration `ℱ` (`MeasureTheory.StronglyAdapted.isStoppingTime_oscillationExitAfter`), assuming
neither completeness nor right continuity of `ℱ` and neither separability nor algebraic structure on
`E`. Iterating from `0` gives an increasing exhausting sequence of stopping times
`TauCeti.oscillationExit (X · ω) ε n` (`isStoppingTime_oscillationExit`).

Freezing `X` at each exit time `τ_n` on `[τ_n, τ_{n+1})` defines the step process
`TauCeti.oscillationApprox X ε`. On càdlàg paths for `ε > 0`, `oscillationApprox X ε` is itself
càdlàg, stays strictly within distance `ε` of `X` everywhere on `ℝ≥0 × Ω`, and is measurable with
respect to the σ-algebra generated by closed stopping-time rays `{p | σ p.2 ≤ p.1}`. Passing
`ε → 0` yields the optional-ray generation theorem without section or capacity arguments.

## References

* C. Dellacherie and P.-A. Meyer, *Probabilities and Potential*, Chapter IV, Theorem 64 (generation
  of the optional σ-algebra by stopping-time intervals).
* J. Jacod and A. N. Shiryaev, *Limit Theorems for Stochastic Processes*, second edition,
  Chapter I, Proposition 1.21.
-/

public section

open Filter MeasureTheory Set Topology
open scoped NNReal ENNReal

namespace MeasureTheory

section StoppingTime

variable {Ω E : Type*} {m : MeasurableSpace Ω} [PseudoMetricSpace E]
  {ℱ : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}

/-- For a strongly adapted process with everywhere càdlàg paths on `ℝ≥0`, the first `ε`-oscillation
exit time (`ε > 0`) after a stopping time `τ` is a stopping time on the raw filtration `ℱ`, with no
right-continuity or completeness assumption on `ℱ` and no separability assumption on `E`. -/
theorem StronglyAdapted.isStoppingTime_oscillationExitAfter
    (hX : StronglyAdapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω))
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime ℱ τ) {ε : ℝ} (hε : 0 < ε) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExitAfter (X · ω) ε (τ ω)) := by
  intro T
  obtain ⟨S, hSc, hST, hS⟩ :=
    IsCadlag.exists_countable_subset_Iic_oscillationExitAfter_le_coe_iff (E := E) T
  have hprog : IsStronglyProgressive ℱ X :=
    hX.isStronglyProgressive_of_isRightContinuous fun ω ↦ (hc ω).isRightContinuous
  have hstop : StronglyAdapted ℱ (MeasureTheory.stoppedProcess X τ) :=
    hprog.stronglyAdapted_stoppedProcess hτ
  have heq : {ω | TauCeti.oscillationExitAfter (X · ω) ε (τ ω) ≤ (T : WithTop ℝ≥0)} =
      (fun ω ↦ ⨆ s ∈ S, edist (X s ω) (MeasureTheory.stoppedProcess X τ s ω)) ⁻¹'
        Ici (ENNReal.ofReal ε) := by
    ext ω
    simpa only [mem_ofPred_eq, mem_preimage, mem_Ici, MeasureTheory.stoppedProcess] using
      hS (hc ω) hε (τ ω)
  rw [heq]
  let _ : MeasurableSpace Ω := ℱ T
  refine Measurable.biSup S hSc (fun s hs ↦ ?_) measurableSet_Ici
  have hsT : s ≤ T := hST hs
  exact (((hX s).mono (ℱ.mono hsT)).edist ((hstop s).mono (ℱ.mono hsT))).measurable

/-- Iterated `ε`-oscillation exit times (`ε > 0`) of a strongly adapted càdlàg process are stopping
times on the raw filtration `ℱ`. -/
theorem StronglyAdapted.isStoppingTime_oscillationExit
    (hX : StronglyAdapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) (n : ℕ) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExit (X · ω) ε n) := by
  induction n with
  | zero => simpa only [TauCeti.oscillationExit_zero] using isStoppingTime_const ℱ (⊥ : ℝ≥0)
  | succ n ih =>
    simpa only [TauCeti.oscillationExit_succ] using
      hX.isStoppingTime_oscillationExitAfter hc ih hε

/-- For an adapted càdlàg process in a second-countable pseudometric Borel space, the first
`ε`-oscillation exit time (`ε > 0`) after a stopping time `τ` is a stopping time on the raw
filtration `ℱ`. -/
theorem Adapted.isStoppingTime_oscillationExitAfter
    [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]
    (hX : Adapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω))
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime ℱ τ) {ε : ℝ} (hε : 0 < ε) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExitAfter (X · ω) ε (τ ω)) :=
  (stronglyAdapted_iff_adapted.mpr hX).isStoppingTime_oscillationExitAfter hc hτ hε

/-- Iterated `ε`-oscillation exit times (`ε > 0`) of an adapted càdlàg process in a
second-countable pseudometric Borel space are stopping times on the raw filtration `ℱ`. -/
theorem Adapted.isStoppingTime_oscillationExit
    [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]
    (hX : Adapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) (n : ℕ) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExit (X · ω) ε n) :=
  (stronglyAdapted_iff_adapted.mpr hX).isStoppingTime_oscillationExit hc hε n

end StoppingTime

end MeasureTheory

namespace TauCeti

section Approx

variable {ι Ω E : Type*} [ConditionallyCompleteLinearOrderBot ι] [PseudoMetricSpace E]

open scoped Classical in
/-- Piecewise-constant step approximation of `X` frozen at each iterated `ε`-oscillation exit time
`τ_n` on the half-open interval `[τ_n, τ_{n+1})`. On càdlàg paths for `ε > 0`, these intervals
partition `ι`, so the fallback value `X t ω` is never used. -/
noncomputable def oscillationApprox (X : ι → Ω → E) (ε : ℝ) (t : ι) (ω : Ω) : E :=
  if h : ∃ n, oscillationExit (X · ω) ε n ≤ (t : WithTop ι) ∧
      (t : WithTop ι) < oscillationExit (X · ω) ε (n + 1) then
    stoppedValue X (fun ω' ↦ oscillationExit (X · ω') ε h.choose) ω
  else
    X t ω

/-- On the `n`-th half-open oscillation interval `[τ_n(ω), τ_{n+1}(ω))`, `oscillationApprox X ε`
equals the stopped value of `X` at `τ_n`. -/
theorem oscillationApprox_eq_stoppedValue {X : ι → Ω → E} {ε : ℝ} {t : ι} {ω : Ω} {n : ℕ}
    (hle : oscillationExit (X · ω) ε n ≤ (t : WithTop ι))
    (hlt : (t : WithTop ι) < oscillationExit (X · ω) ε (n + 1)) :
    oscillationApprox X ε t ω =
      stoppedValue X (fun ω' ↦ oscillationExit (X · ω') ε n) ω := by
  have hex : ∃ k, oscillationExit (X · ω) ε k ≤ (t : WithTop ι) ∧
      (t : WithTop ι) < oscillationExit (X · ω) ε (k + 1) := ⟨n, hle, hlt⟩
  have hchoose : hex.choose = n := eq_of_mem_Ico_oscillationExit hex.choose_spec ⟨hle, hlt⟩
  simp only [oscillationApprox, hex, ↓reduceDIte, hchoose]

/-- At the initial time `⊥`, the oscillation step approximation agrees with `X`. -/
@[simp]
theorem oscillationApprox_bot (X : ι → Ω → E) (ε : ℝ) (ω : Ω) :
    oscillationApprox X ε ⊥ ω = X ⊥ ω := by
  by_cases hex : ∃ n, oscillationExit (X · ω) ε n ≤ ((⊥ : ι) : WithTop ι) ∧
      ((⊥ : ι) : WithTop ι) < oscillationExit (X · ω) ε (n + 1)
  · have hbot : oscillationExit (X · ω) ε hex.choose = ((⊥ : ι) : WithTop ι) := by
      cases hτ : oscillationExit (X · ω) ε hex.choose with
      | top => exact absurd (hτ ▸ hex.choose_spec.1) (WithTop.not_top_le_coe ⊥)
      | coe a =>
        exact WithTop.coe_eq_coe.mpr
          (le_bot_iff.mp (WithTop.coe_le_coe.mp (hτ ▸ hex.choose_spec.1)))
    simp only [oscillationApprox, hex, ↓reduceDIte, stoppedValue, hbot]
    rfl
  · simp only [oscillationApprox, hex, ↓reduceDIte]

end Approx

end TauCeti

namespace IsCadlag

section Approx

variable {ι Ω E : Type*} [ConditionallyCompleteLinearOrderBot ι] [TopologicalSpace ι]
  [OrderTopology ι] [PseudoMetricSpace E] {X : ι → Ω → E} {ω : Ω}

/-- On a càdlàg path and for `ε > 0`, `TauCeti.oscillationApprox X ε` uniformly approximates `X`
within strict distance `ε` at every time. -/
theorem dist_oscillationApprox_lt (hc : IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) (t : ι) :
    dist (X t ω) (TauCeti.oscillationApprox X ε t ω) < ε := by
  obtain ⟨n, hle, hlt⟩ := hc.exists_mem_Ico_oscillationExit hε t
  rw [TauCeti.oscillationApprox_eq_stoppedValue hle hlt]
  rw [TauCeti.oscillationExit_succ] at hlt
  exact TauCeti.dist_lt_of_lt_oscillationExitAfter hε hle hlt

/-- For `ε > 0`, the oscillation step approximation of a càdlàg path is itself càdlàg. -/
theorem oscillationApprox (hc : IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) :
    IsCadlag (TauCeti.oscillationApprox X ε · ω) where
  isRightContinuous t := by
    -- On `[t, τ_{n+1})`, the step approximation is locally constant equal to `X_{τ_n}`.
    obtain ⟨n, hle, hlt⟩ := hc.exists_mem_Ico_oscillationExit hε t
    let c := stoppedValue X (fun ω' ↦ TauCeti.oscillationExit (X · ω') ε n) ω
    have hval : TauCeti.oscillationApprox X ε t ω = c :=
      TauCeti.oscillationApprox_eq_stoppedValue hle hlt
    refine (continuousWithinAt_const (b := c)).congr_of_eventuallyEq ?_ hval
    cases hnext : TauCeti.oscillationExit (X · ω) ε (n + 1) with
    | top =>
      filter_upwards [self_mem_nhdsWithin] with s hs
      refine TauCeti.oscillationApprox_eq_stoppedValue
        (hle.trans (WithTop.coe_le_coe.mpr hs.le)) ?_
      rw [hnext]
      exact WithTop.coe_lt_top s
    | coe b =>
      have htb : t < b := WithTop.coe_lt_coe.mp (hnext ▸ hlt)
      filter_upwards [Ioo_mem_nhdsGT htb] with s hs
      refine TauCeti.oscillationApprox_eq_stoppedValue
        (hle.trans (WithTop.coe_le_coe.mpr hs.1.le)) ?_
      rw [hnext]
      exact WithTop.coe_lt_coe.mpr hs.2
  tendsto_nhdsLT t := by
    -- Left of `t`, the approximation is constant on `(τ_{n-1}, t)` if `t = τ_n` and on `(τ_n, t)`
    -- if `τ_n < t`.
    obtain ⟨n, hle, hlt⟩ := hc.exists_mem_Ico_oscillationExit hε t
    rcases eq_or_lt_of_le hle with heq | hlt_left
    · rcases n with _ | k
      · rw [TauCeti.oscillationExit_zero] at heq
        have ht : t = ⊥ := (WithTop.coe_eq_coe.mp heq).symm
        subst ht
        exact ⟨X ⊥ ω, by simp⟩
      · have hne_top_succ : TauCeti.oscillationExit (X · ω) ε (k + 1) ≠ ⊤ := by
          rw [heq]
          exact WithTop.coe_ne_top
        have hne_top_k : TauCeti.oscillationExit (X · ω) ε k ≠ ⊤ := by
          intro htop
          apply hne_top_succ
          rw [TauCeti.oscillationExit_succ, htop, TauCeti.oscillationExitAfter_top]
        have hk_lt : TauCeti.oscillationExit (X · ω) ε k < (t : WithTop ι) := by
          simpa only [← TauCeti.oscillationExit_succ, heq] using
            hc.lt_oscillationExitAfter hε hne_top_k
        obtain ⟨a, ha⟩ := WithTop.ne_top_iff_exists.mp hne_top_k
        have hat : a < t := WithTop.coe_lt_coe.mp (ha ▸ hk_lt)
        refine ⟨stoppedValue X (fun ω' ↦ TauCeti.oscillationExit (X · ω') ε k) ω, ?_⟩
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [Ioo_mem_nhdsLT hat] with s hs
        symm
        exact TauCeti.oscillationApprox_eq_stoppedValue
          (ha ▸ WithTop.coe_le_coe.mpr hs.1.le) (heq ▸ WithTop.coe_lt_coe.mpr hs.2)
    · obtain ⟨a, ha⟩ := WithTop.ne_top_iff_exists.mp (ne_top_of_lt hlt_left)
      have hat : a < t := WithTop.coe_lt_coe.mp (ha ▸ hlt_left)
      refine ⟨stoppedValue X (fun ω' ↦ TauCeti.oscillationExit (X · ω') ε n) ω, ?_⟩
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsLT hat] with s hs
      symm
      exact TauCeti.oscillationApprox_eq_stoppedValue
        (ha ▸ WithTop.coe_le_coe.mpr hs.1.le) ((WithTop.coe_lt_coe.mpr hs.2).trans hlt)

/-- Along any positive sequence `δ k → 0`, the oscillation step approximations converge pointwise to
the càdlàg path. -/
theorem tendsto_oscillationApprox (hc : IsCadlag (X · ω)) {δ : ℕ → ℝ}
    (hpos : ∀ k, 0 < δ k) (hδ : Tendsto δ atTop (𝓝 0)) (t : ι) :
    Tendsto (fun k ↦ TauCeti.oscillationApprox X (δ k) t ω) atTop (𝓝 (X t ω)) :=
  tendsto_iff_dist_tendsto_zero.mpr <|
    squeeze_zero (fun _ ↦ dist_nonneg)
      (fun k ↦ by rw [dist_comm]; exact (hc.dist_oscillationApprox_lt (hpos k) t).le) hδ

end Approx

end IsCadlag

namespace MeasureTheory

/-- For a strongly adapted càdlàg process in a pseudometric Borel space and `ε > 0`, the uncurried
step approximation `TauCeti.oscillationApprox X ε` is measurable with respect to the σ-algebra
generated by closed stopping-time rays `{p | τ p.2 ≤ p.1}` on the raw filtration `ℱ`. -/
theorem StronglyAdapted.measurable_generateFrom_le_oscillationApprox
    {Ω E : Type*} {m : MeasurableSpace Ω} [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E]
    {ℱ : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}
    (hX : StronglyAdapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) :
    Measurable[MeasurableSpace.generateFrom
      {s : Set (ℝ≥0 × Ω) | ∃ τ : Ω → WithTop ℝ≥0, IsStoppingTime ℱ τ ∧ s = {p | τ p.2 ≤ p.1}}]
      (Function.uncurry (TauCeti.oscillationApprox X ε)) := by
  classical
  let mRay := MeasurableSpace.generateFrom
    {s : Set (ℝ≥0 × Ω) | ∃ τ : Ω → WithTop ℝ≥0, IsStoppingTime ℱ τ ∧ s = {p | τ p.2 ≤ p.1}}
  have hray {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime ℱ τ) :
      MeasurableSet[mRay] {p : ℝ≥0 × Ω | τ p.2 ≤ p.1} :=
    MeasurableSpace.measurableSet_generateFrom ⟨τ, hτ, rfl⟩
  have hprog : IsStronglyProgressive ℱ X :=
    hX.isStronglyProgressive_of_isRightContinuous fun ω ↦ (hc ω).isRightContinuous
  let τ (n : ℕ) (ω : Ω) : WithTop ℝ≥0 := TauCeti.oscillationExit (X · ω) ε n
  have hτ (n : ℕ) : IsStoppingTime ℱ (τ n) := hX.isStoppingTime_oscillationExit hc hε n
  intro U hU
  -- Restrict each exit time `τ n` to the `ℱ_{τ n}`-event `A n = (X_{τ n})⁻¹(U)`, turning the
  -- slice `[τ n, τ (n+1)) × A n` into the difference of two closed stopping-time rays.
  let A (n : ℕ) : Set Ω := stoppedValue X (τ n) ⁻¹' U
  have hA (n : ℕ) : MeasurableSet[(hτ n).measurableSpace] (A n) :=
    measurable_stoppedValue hprog (hτ n) hU
  let σ (n : ℕ) : Ω → WithTop ℝ≥0 := (A n).piecewise (τ n) (fun _ ↦ ⊤)
  have hσ (n : ℕ) : IsStoppingTime ℱ (σ n) := (hτ n).piecewise_top (hA n)
  have hpre : Function.uncurry (TauCeti.oscillationApprox X ε) ⁻¹' U =
      ⋃ n : ℕ, ({p : ℝ≥0 × Ω | σ n p.2 ≤ p.1} \ {p : ℝ≥0 × Ω | τ (n + 1) p.2 ≤ p.1}) := by
    ext ⟨t, ω⟩
    simp only [mem_preimage, Function.uncurry_apply_pair, mem_iUnion, Set.mem_sdiff,
      mem_ofPred_eq, not_le]
    constructor
    · intro hmem
      obtain ⟨n, hle, hlt⟩ := (hc ω).exists_mem_Ico_oscillationExit hε t
      rw [TauCeti.oscillationApprox_eq_stoppedValue hle hlt] at hmem
      refine ⟨n, ?_, hlt⟩
      simpa only [σ, Set.piecewise_eq_of_mem (A n) (τ n) _ hmem] using hle
    · rintro ⟨n, hσ_le, hlt⟩
      have hωA : ω ∈ A n := by
        by_contra hnot
        dsimp only [σ] at hσ_le
        rw [Set.piecewise_eq_of_notMem (A n) (τ n) _ hnot] at hσ_le
        exact WithTop.not_top_le_coe t hσ_le
      have hle : τ n ω ≤ (t : WithTop ℝ≥0) := by
        simpa only [σ, Set.piecewise_eq_of_mem (A n) (τ n) _ hωA] using hσ_le
      rw [TauCeti.oscillationApprox_eq_stoppedValue hle hlt]
      exact hωA
  rw [hpre]
  exact MeasurableSet.iUnion fun n ↦ (hray (hσ n)).diff (hray (hτ (n + 1)))

end MeasureTheory
