/-!
# Oscillation exit stopping times and càdlàg step approximations

For a strongly progressive process `X : ι → Ω → E` on a second-countable conditionally complete
linear order with bottom (with the order Borel structure and pseudometrizable topology) having
everywhere càdlàg paths in a pseudometric space `E` and any threshold `ε > 0`, the pathwise
`ε`-oscillation exit time `TauCeti.oscillationExitAfter (X · ω) ε (τ ω)` after a stopping time
`τ` is a stopping time on the raw filtration `ℱ`
(`MeasureTheory.IsStronglyProgressive.isStoppingTime_oscillationExitAfter`), assuming neither
completeness nor right continuity of `ℱ` and neither separability nor algebraic structure on `E`.
Iterating from `⊥` gives an increasing exhausting sequence of stopping times
`TauCeti.oscillationExit (X · ω) ε n` (`IsStronglyProgressive.isStoppingTime_oscillationExit`). In
nonnegative real time `ℝ≥0`, these specialize to strongly adapted and adapted càdlàg processes via
right-continuous progressive measurability (`StronglyAdapted.isStoppingTime_oscillationExitAfter`,
`StronglyAdapted.isStoppingTime_oscillationExit`).

Freezing a path `f` at each exit time `τ_n` on `[τ_n, τ_{n+1})` defines the step approximation
`TauCeti.oscillationApprox f ε` (falling back to `f t` outside their union), which stays strictly
within distance `ε` of `f` at every time for `ε > 0` (`TauCeti.dist_oscillationApprox_lt`) and
converges uniformly to `f` along any filter of eventually positive thresholds tending to `0`
(`TauCeti.tendstoUniformly_oscillationApprox`). On a càdlàg path in an order topology for `ε > 0`,
`oscillationApprox f ε` is itself càdlàg (`IsCadlag.oscillationApprox`). Any process on a linearly
ordered time index agreeing on each half-open interval `[τ n, τ (n + 1))` of an exhaustive
sequence of stopping times with a `(τ n)`-measurable coefficient into an arbitrary measurable space
is measurable for the σ-algebra generated by closed stopping-time rays
(`MeasureTheory.measurable_generateFrom_le_of_eq_on_Ico`); specializing to `oscillationApprox` and
passing `ε → 0` yields the optional-ray generation theorem without section or capacity arguments.

## References

* C. Dellacherie and P.-A. Meyer, *Probabilities and Potential*, Chapter IV, Theorem 64 (generation
  of the optional σ-algebra by stopping-time intervals).
* J. Jacod and A. N. Shiryaev, *Limit Theorems for Stochastic Processes*, second edition,
  Chapter I, Proposition 1.21.
-/

public section

open Filter MeasureTheory Set
open scoped NNReal ENNReal Topology

namespace MeasureTheory

section StoppingTime

section IsStronglyProgressive

variable {ι Ω E : Type*} {m : MeasurableSpace Ω}
  [ConditionallyCompleteLinearOrderBot ι] [TopologicalSpace ι] [OrderTopology ι]
  [SecondCountableTopology ι] [MeasurableSpace ι] [BorelSpace ι]
  [TopologicalSpace.PseudoMetrizableSpace ι] [PseudoMetricSpace E]
  {ℱ : Filtration ι m} {X : ι → Ω → E}

/-- For a strongly progressive process with everywhere càdlàg paths, the first `ε`-oscillation
exit time (`ε > 0`) after a stopping time `τ` is a stopping time on the raw filtration `ℱ`, with no
right-continuity or completeness assumption on `ℱ` and no separability assumption on `E`. -/
theorem IsStronglyProgressive.isStoppingTime_oscillationExitAfter
    (hX : IsStronglyProgressive ℱ X) (hc : ∀ ω, IsCadlag (X · ω))
    {τ : Ω → WithTop ι} (hτ : IsStoppingTime ℱ τ) {ε : ℝ} (hε : 0 < ε) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExitAfter (X · ω) ε (τ ω)) := by
  intro T
  obtain ⟨S, hSc, hST, hS⟩ :=
    IsCadlag.exists_countable_subset_Iic_oscillationExitAfter_le_coe_iff (E := E) T
  have hstop : StronglyAdapted ℱ (MeasureTheory.stoppedProcess X τ) :=
    hX.stronglyAdapted_stoppedProcess hτ
  have heq : {ω | TauCeti.oscillationExitAfter (X · ω) ε (τ ω) ≤ (T : WithTop ι)} =
      (fun ω ↦ ⨆ s ∈ S, edist (X s ω) (MeasureTheory.stoppedProcess X τ s ω)) ⁻¹'
        Ici (ENNReal.ofReal ε) := by
    ext ω
    simpa only [mem_ofPred_eq, mem_preimage, mem_Ici, MeasureTheory.stoppedProcess] using
      hS (hc ω) hε (τ ω)
  rw [heq]
  let _ : MeasurableSpace Ω := ℱ T
  refine Measurable.biSup S hSc (fun s hs ↦ ?_) measurableSet_Ici
  have hsT : s ≤ T := hST hs
  exact (((hX.stronglyAdapted s).mono (ℱ.mono hsT)).edist
    ((hstop s).mono (ℱ.mono hsT))).measurable

/-- Iterated `ε`-oscillation exit times (`ε > 0`) of a strongly progressive càdlàg process are
stopping times on the raw filtration `ℱ`. -/
theorem IsStronglyProgressive.isStoppingTime_oscillationExit
    (hX : IsStronglyProgressive ℱ X) (hc : ∀ ω, IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) (n : ℕ) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExit (X · ω) ε n) := by
  induction n with
  | zero => simpa only [TauCeti.oscillationExit_zero] using isStoppingTime_const ℱ (⊥ : ι)
  | succ n ih =>
    simpa only [TauCeti.oscillationExit_succ] using
      hX.isStoppingTime_oscillationExitAfter hc ih hε

end IsStronglyProgressive

variable {Ω E : Type*} {m : MeasurableSpace Ω} [PseudoMetricSpace E]
  {ℱ : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}

/-- For a strongly adapted process with everywhere càdlàg paths on `ℝ≥0`, the first `ε`-oscillation
exit time (`ε > 0`) after a stopping time `τ` is a stopping time on the raw filtration `ℱ`, with no
right-continuity or completeness assumption on `ℱ` and no separability assumption on `E`. -/
theorem StronglyAdapted.isStoppingTime_oscillationExitAfter
    (hX : StronglyAdapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω))
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime ℱ τ) {ε : ℝ} (hε : 0 < ε) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExitAfter (X · ω) ε (τ ω)) :=
  IsStronglyProgressive.isStoppingTime_oscillationExitAfter
    (hX.isStronglyProgressive_of_isRightContinuous fun ω ↦ (hc ω).isRightContinuous) hc hτ hε

/-- Iterated `ε`-oscillation exit times (`ε > 0`) of a strongly adapted càdlàg process are stopping
times on the raw filtration `ℱ`. -/
theorem StronglyAdapted.isStoppingTime_oscillationExit
    (hX : StronglyAdapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) (n : ℕ) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExit (X · ω) ε n) :=
  IsStronglyProgressive.isStoppingTime_oscillationExit
    (hX.isStronglyProgressive_of_isRightContinuous fun ω ↦ (hc ω).isRightContinuous) hc hε n

/-- For an adapted càdlàg process in a second-countable pseudometric space with measurable open
sets, the first `ε`-oscillation exit time (`ε > 0`) after a stopping time `τ` is a stopping time on
the raw filtration `ℱ`. -/
theorem Adapted.isStoppingTime_oscillationExitAfter
    [SecondCountableTopology E] [MeasurableSpace E] [OpensMeasurableSpace E]
    (hX : Adapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω))
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime ℱ τ) {ε : ℝ} (hε : 0 < ε) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExitAfter (X · ω) ε (τ ω)) :=
  hX.stronglyAdapted.isStoppingTime_oscillationExitAfter hc hτ hε

/-- Iterated `ε`-oscillation exit times (`ε > 0`) of an adapted càdlàg process in a
second-countable pseudometric space with measurable open sets are stopping times on the raw
filtration `ℱ`. -/
theorem Adapted.isStoppingTime_oscillationExit
    [SecondCountableTopology E] [MeasurableSpace E] [OpensMeasurableSpace E]
    (hX : Adapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) (n : ℕ) :
    IsStoppingTime ℱ (fun ω ↦ TauCeti.oscillationExit (X · ω) ε n) :=
  hX.stronglyAdapted.isStoppingTime_oscillationExit hc hε n

end StoppingTime

end MeasureTheory

namespace TauCeti

section Approx

variable {ι E : Type*} [ConditionallyCompleteLinearOrderBot ι] [PseudoMetricSpace E]

open scoped Classical in
/-- Piecewise-constant step approximation of `f` frozen at each iterated `ε`-oscillation exit
time `τ_n` on the half-open interval `[τ_n, τ_{n+1})`, and falling back to `f t` outside their
union. On càdlàg paths in an order topology for `ε > 0`, these intervals partition `ι`, so the
fallback value `f t` is never used. -/
noncomputable def oscillationApprox (f : ι → E) (ε : ℝ) (t : ι) : E :=
  if h : ∃ n, oscillationExit f ε n ≤ (t : WithTop ι) ∧
      (t : WithTop ι) < oscillationExit f ε (n + 1) then
    f (oscillationExit f ε h.choose).untopA
  else
    f t

/-- On the `n`-th half-open oscillation interval `[τ_n, τ_{n+1})`, `oscillationApprox f ε`
equals `f` evaluated at `τ_n`. -/
theorem oscillationApprox_eq_of_mem_Ico {f : ι → E} {ε : ℝ} {t : ι} {n : ℕ}
    (hle : oscillationExit f ε n ≤ (t : WithTop ι))
    (hlt : (t : WithTop ι) < oscillationExit f ε (n + 1)) :
    oscillationApprox f ε t = f (oscillationExit f ε n).untopA := by
  have hex : ∃ k, oscillationExit f ε k ≤ (t : WithTop ι) ∧
      (t : WithTop ι) < oscillationExit f ε (k + 1) := ⟨n, hle, hlt⟩
  have hchoose : hex.choose = n := by
    by_contra hne
    exact Set.disjoint_left.mp
      ((oscillationExit_mono f ε).pairwise_disjoint_on_Ico_succ hne)
      hex.choose_spec ⟨hle, hlt⟩
  simp only [oscillationApprox, hex, ↓reduceDIte, hchoose]

/-- Outside the half-open oscillation intervals `[τ_n, τ_{n+1})`, `oscillationApprox f ε` falls
back to `f`. -/
theorem oscillationApprox_eq_of_not_exists {f : ι → E} {ε : ℝ} {t : ι}
    (h : ¬ ∃ n, oscillationExit f ε n ≤ (t : WithTop ι) ∧
      (t : WithTop ι) < oscillationExit f ε (n + 1)) :
    oscillationApprox f ε t = f t := by
  simp only [oscillationApprox, h, ↓reduceDIte]

/-- At the initial time `⊥`, the oscillation step approximation agrees with `f`. -/
@[simp]
theorem oscillationApprox_bot (f : ι → E) (ε : ℝ) :
    oscillationApprox f ε ⊥ = f ⊥ := by
  by_cases hex : ∃ n, oscillationExit f ε n ≤ ((⊥ : ι) : WithTop ι) ∧
      ((⊥ : ι) : WithTop ι) < oscillationExit f ε (n + 1)
  · obtain ⟨n, hle, hlt⟩ := hex
    have hbot : oscillationExit f ε n = ((⊥ : ι) : WithTop ι) :=
      le_antisymm hle
        (oscillationExit_zero f ε ▸ oscillationExit_mono f ε (Nat.zero_le n))
    rw [oscillationApprox_eq_of_mem_Ico hle hlt, hbot]
    simp only [WithTop.untopA, WithTop.untopD_coe]
  · exact oscillationApprox_eq_of_not_exists hex

/-- For any path `f` and `ε > 0`, `oscillationApprox f ε` stays within strict distance `ε` of `f`
at every time. -/
theorem dist_oscillationApprox_lt (f : ι → E) {ε : ℝ} (hε : 0 < ε) (t : ι) :
    dist (f t) (oscillationApprox f ε t) < ε := by
  by_cases hex : ∃ n, oscillationExit f ε n ≤ (t : WithTop ι) ∧
      (t : WithTop ι) < oscillationExit f ε (n + 1)
  · obtain ⟨n, hle, hlt⟩ := hex
    rw [oscillationApprox_eq_of_mem_Ico hle hlt]
    rw [oscillationExit_succ] at hlt
    exact dist_lt_of_lt_oscillationExitAfter hε hle hlt
  · rw [oscillationApprox_eq_of_not_exists hex, dist_self]
    exact hε

/-- Along any filter of thresholds that are eventually positive and converge to `0`, the
oscillation step approximations converge uniformly to `f`. -/
theorem tendstoUniformly_oscillationApprox {κ : Type*} (f : ι → E) {p : Filter κ}
    {δ : κ → ℝ} (hpos : ∀ᶠ k in p, 0 < δ k) (hδ : Tendsto δ p (𝓝 0)) :
    TendstoUniformly (fun k ↦ oscillationApprox f (δ k)) f p := by
  rw [Metric.tendstoUniformly_iff]
  intro ε hε
  filter_upwards [hpos, hδ.eventually (Iio_mem_nhds hε)] with k hk_pos hk_lt t
  exact (dist_oscillationApprox_lt f hk_pos t).trans hk_lt

end Approx

end TauCeti

private theorem exists_mem_Ico_of_lt {α : Type*} [LinearOrder α] {a : ℕ → α} {x : α}
    (ha₀ : a 0 ≤ x) (hex : ∃ N, x < a N) :
    ∃ n, a n ≤ x ∧ x < a (n + 1) := by
  obtain ⟨N, hN⟩ := hex
  obtain ⟨n, _, hle, hlt⟩ := mem_iUnion₂.mp (Ico_subset_biUnion_Ico N a ⟨ha₀, hN⟩)
  exact ⟨n, hle, hlt⟩

namespace IsCadlag

section Approx

variable {ι E : Type*} [ConditionallyCompleteLinearOrderBot ι] [TopologicalSpace ι]
  [OrderTopology ι] [PseudoMetricSpace E] {f : ι → E}

/-- Every time `t` lies in the half-open interval `[τ_n, τ_{n+1})` for some index `n` of the
iterated `ε`-oscillation exit times (`ε > 0`) of a càdlàg path. -/
theorem exists_mem_Ico_oscillationExit (hc : IsCadlag f) {ε : ℝ} (hε : 0 < ε) (t : ι) :
    ∃ n, TauCeti.oscillationExit f ε n ≤ (t : WithTop ι) ∧
      (t : WithTop ι) < TauCeti.oscillationExit f ε (n + 1) :=
  exists_mem_Ico_of_lt (TauCeti.oscillationExit_zero f ε ▸ bot_le)
    (hc.eventually_lt_oscillationExit hε t).exists

/-- For `ε > 0`, the oscillation step approximation of a càdlàg path is itself càdlàg. -/
theorem oscillationApprox (hc : IsCadlag f) {ε : ℝ} (hε : 0 < ε) :
    IsCadlag (TauCeti.oscillationApprox f ε) where
  isRightContinuous t := by
    -- On `[t, τ_{n+1})`, the step approximation is locally constant equal to `f (τ_n)`.
    obtain ⟨n, hle, hlt⟩ := hc.exists_mem_Ico_oscillationExit hε t
    let c := f (TauCeti.oscillationExit f ε n).untopA
    have hval : TauCeti.oscillationApprox f ε t = c :=
      TauCeti.oscillationApprox_eq_of_mem_Ico hle hlt
    refine (continuousWithinAt_const (b := c)).congr_of_eventuallyEq ?_ hval
    cases hnext : TauCeti.oscillationExit f ε (n + 1) with
    | top =>
      filter_upwards [self_mem_nhdsWithin] with s hs
      refine TauCeti.oscillationApprox_eq_of_mem_Ico
        (hle.trans (WithTop.coe_le_coe.mpr hs.le)) ?_
      rw [hnext]
      exact WithTop.coe_lt_top s
    | coe b =>
      have htb : t < b := WithTop.coe_lt_coe.mp (hnext ▸ hlt)
      filter_upwards [Ioo_mem_nhdsGT htb] with s hs
      refine TauCeti.oscillationApprox_eq_of_mem_Ico
        (hle.trans (WithTop.coe_le_coe.mpr hs.1.le)) ?_
      rw [hnext]
      exact WithTop.coe_lt_coe.mpr hs.2
  tendsto_nhdsLT t := by
    -- Left of `t`, the approximation is constant on `(τ_{n-1}, t)` if `t = τ_n` and on `(τ_n, t)`
    -- if `τ_n < t`.
    obtain ⟨n, hle, hlt⟩ := hc.exists_mem_Ico_oscillationExit hε t
    rcases eq_or_lt_of_le hle with heq | hlt_left
    · rcases n with _ | k
      · rw [TauCeti.oscillationExit_zero] at heq
        have ht : t = ⊥ := (WithTop.coe_eq_coe.mp heq).symm
        subst ht
        exact ⟨f ⊥, by simp⟩
      · have hne_top_succ : TauCeti.oscillationExit f ε (k + 1) ≠ ⊤ := by
          rw [heq]
          exact WithTop.coe_ne_top
        have hne_top_k : TauCeti.oscillationExit f ε k ≠ ⊤ := by
          intro htop
          apply hne_top_succ
          rw [TauCeti.oscillationExit_succ, htop, TauCeti.oscillationExitAfter_top]
        have hk_lt : TauCeti.oscillationExit f ε k < (t : WithTop ι) := by
          simpa only [← TauCeti.oscillationExit_succ, heq] using
            hc.lt_oscillationExitAfter hε hne_top_k
        obtain ⟨a, ha⟩ := WithTop.ne_top_iff_exists.mp hne_top_k
        have hat : a < t := WithTop.coe_lt_coe.mp (ha ▸ hk_lt)
        refine ⟨f (TauCeti.oscillationExit f ε k).untopA, ?_⟩
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [Ioo_mem_nhdsLT hat] with s hs
        symm
        exact TauCeti.oscillationApprox_eq_of_mem_Ico
          (ha ▸ WithTop.coe_le_coe.mpr hs.1.le) (heq ▸ WithTop.coe_lt_coe.mpr hs.2)
    · obtain ⟨a, ha⟩ := WithTop.ne_top_iff_exists.mp (ne_top_of_lt hlt_left)
      have hat : a < t := WithTop.coe_lt_coe.mp (ha ▸ hlt_left)
      refine ⟨f (TauCeti.oscillationExit f ε n).untopA, ?_⟩
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsLT hat] with s hs
      symm
      exact TauCeti.oscillationApprox_eq_of_mem_Ico
        (ha ▸ WithTop.coe_le_coe.mpr hs.1.le) ((WithTop.coe_lt_coe.mpr hs.2).trans hlt)

end Approx

end IsCadlag

namespace MeasureTheory

/-- A process on a linearly ordered time index that agrees with `Y n` on each half-open
stochastic interval `[τ n, τ (n + 1))` is measurable with respect to the σ-algebra generated by
closed stopping-time rays `{p | σ p.2 ≤ p.1}`, whenever `(τ n)` is an exhaustive sequence of
stopping times starting at or before every time and each `Y n` is `(τ n)`-measurable into an
arbitrary measurable target. -/
theorem measurable_generateFrom_le_of_eq_on_Ico
    {ι Ω E : Type*} [LinearOrder ι] {m : MeasurableSpace Ω} [MeasurableSpace E]
    {ℱ : Filtration ι m} {τ : ℕ → Ω → WithTop ι}
    (hτ : ∀ n, IsStoppingTime ℱ (τ n))
    (hbot : ∀ ω (t : ι), τ 0 ω ≤ (t : WithTop ι))
    (hexh : ∀ ω (t : ι), ∃ n, (t : WithTop ι) < τ n ω)
    {Y : ℕ → Ω → E} (hY : ∀ n, Measurable[(hτ n).measurableSpace] (Y n))
    {Z : ι → Ω → E}
    (hZ : ∀ n (t : ι) ω, τ n ω ≤ (t : WithTop ι) → (t : WithTop ι) < τ (n + 1) ω →
      Z t ω = Y n ω) :
    Measurable[MeasurableSpace.generateFrom
      {s : Set (ι × Ω) | ∃ σ : Ω → WithTop ι, IsStoppingTime ℱ σ ∧ s = {p | σ p.2 ≤ p.1}}]
      (Function.uncurry Z) := by
  classical
  let mRay := MeasurableSpace.generateFrom
    {s : Set (ι × Ω) | ∃ σ : Ω → WithTop ι, IsStoppingTime ℱ σ ∧ s = {p | σ p.2 ≤ p.1}}
  have hray {σ : Ω → WithTop ι} (hσ : IsStoppingTime ℱ σ) :
      MeasurableSet[mRay] {p : ι × Ω | σ p.2 ≤ p.1} :=
    MeasurableSpace.measurableSet_generateFrom ⟨σ, hσ, rfl⟩
  have hcov (t : ι) (ω : Ω) :
      ∃ n, τ n ω ≤ (t : WithTop ι) ∧ (t : WithTop ι) < τ (n + 1) ω :=
    exists_mem_Ico_of_lt (hbot ω t) (hexh ω t)
  intro U hU
  -- Restrict each `τ n` to the `(τ n)`-measurable event `A n = (Y n)⁻¹(U)`, turning
  -- `[τ n, τ (n + 1)) × A n` into the difference of two closed stopping-time rays.
  let A (n : ℕ) : Set Ω := Y n ⁻¹' U
  have hA (n : ℕ) : MeasurableSet[(hτ n).measurableSpace] (A n) := hY n hU
  let σ (n : ℕ) : Ω → WithTop ι := (A n).piecewise (τ n) (fun _ ↦ ⊤)
  have hσ (n : ℕ) : IsStoppingTime ℱ (σ n) := (hτ n).piecewise_top (hA n)
  have hpre : Function.uncurry Z ⁻¹' U =
      ⋃ n : ℕ, ({p : ι × Ω | σ n p.2 ≤ p.1} \ {p : ι × Ω | τ (n + 1) p.2 ≤ p.1}) := by
    ext ⟨t, ω⟩
    simp only [mem_preimage, Function.uncurry_apply_pair, mem_iUnion, Set.mem_sdiff,
      mem_ofPred_eq, not_le]
    constructor
    · intro hmem
      obtain ⟨n, hle, hlt⟩ := hcov t ω
      rw [hZ n t ω hle hlt] at hmem
      refine ⟨n, ?_, hlt⟩
      simpa only [σ, Set.piecewise_eq_of_mem (A n) (τ n) _ hmem] using hle
    · rintro ⟨n, hσ_le, hlt⟩
      have hωA : ω ∈ A n := by
        by_contra hnot
        dsimp only [σ] at hσ_le
        rw [Set.piecewise_eq_of_notMem (A n) (τ n) _ hnot] at hσ_le
        exact WithTop.not_top_le_coe t hσ_le
      have hle : τ n ω ≤ (t : WithTop ι) := by
        simpa only [σ, Set.piecewise_eq_of_mem (A n) (τ n) _ hωA] using hσ_le
      rw [hZ n t ω hle hlt]
      exact hωA
  rw [hpre]
  exact MeasurableSet.iUnion fun n ↦ (hray (hσ n)).diff (hray (hτ (n + 1)))

/-- For a strongly progressive càdlàg process in a pseudometric Borel space and `ε > 0`, the
pathwise step approximation `fun p ↦ TauCeti.oscillationApprox (X · p.2) ε p.1` is measurable with
respect to the σ-algebra generated by closed stopping-time rays `{p | τ p.2 ≤ p.1}` on the raw
filtration `ℱ`. -/
theorem IsStronglyProgressive.measurable_generateFrom_le_oscillationApprox
    {ι Ω E : Type*} {m : MeasurableSpace Ω}
    [ConditionallyCompleteLinearOrderBot ι] [TopologicalSpace ι] [OrderTopology ι]
    [SecondCountableTopology ι] [MeasurableSpace ι] [BorelSpace ι]
    [TopologicalSpace.PseudoMetrizableSpace ι]
    [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E]
    {ℱ : Filtration ι m} {X : ι → Ω → E}
    (hX : IsStronglyProgressive ℱ X) (hc : ∀ ω, IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) :
    Measurable[MeasurableSpace.generateFrom
      {s : Set (ι × Ω) | ∃ τ : Ω → WithTop ι, IsStoppingTime ℱ τ ∧ s = {p | τ p.2 ≤ p.1}}]
      (fun p : ι × Ω ↦ TauCeti.oscillationApprox (X · p.2) ε p.1) :=
  let τ (n : ℕ) (ω : Ω) : WithTop ι := TauCeti.oscillationExit (X · ω) ε n
  have hτ (n : ℕ) : IsStoppingTime ℱ (τ n) := hX.isStoppingTime_oscillationExit hc hε n
  measurable_generateFrom_le_of_eq_on_Ico hτ
    (fun ω _ ↦ by simp only [τ, TauCeti.oscillationExit_zero]; exact bot_le)
    (fun ω t ↦ ((hc ω).eventually_lt_oscillationExit hε t).exists)
    (fun n ↦ measurable_stoppedValue hX (hτ n))
    (Z := fun t ω ↦ TauCeti.oscillationApprox (X · ω) ε t)
    (fun _ _ _ hle hlt ↦ TauCeti.oscillationApprox_eq_of_mem_Ico hle hlt)

/-- For a strongly adapted càdlàg process on `ℝ≥0` in a pseudometric Borel space and `ε > 0`, the
pathwise step approximation `fun p ↦ TauCeti.oscillationApprox (X · p.2) ε p.1` is measurable with
respect to the σ-algebra generated by closed stopping-time rays `{p | τ p.2 ≤ p.1}` on the raw
filtration `ℱ`. -/
theorem StronglyAdapted.measurable_generateFrom_le_oscillationApprox
    {Ω E : Type*} {m : MeasurableSpace Ω} [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E]
    {ℱ : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}
    (hX : StronglyAdapted ℱ X) (hc : ∀ ω, IsCadlag (X · ω)) {ε : ℝ} (hε : 0 < ε) :
    Measurable[MeasurableSpace.generateFrom
      {s : Set (ℝ≥0 × Ω) | ∃ τ : Ω → WithTop ℝ≥0, IsStoppingTime ℱ τ ∧ s = {p | τ p.2 ≤ p.1}}]
      (fun p : ℝ≥0 × Ω ↦ TauCeti.oscillationApprox (X · p.2) ε p.1) :=
  (hX.isStronglyProgressive_of_isRightContinuous
    fun ω ↦ (hc ω).isRightContinuous).measurable_generateFrom_le_oscillationApprox hc hε

end MeasureTheory
