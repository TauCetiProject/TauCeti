/-!
# The tail σ-algebra of a product space

For a product `∀ i, X i` over an arbitrary index set, `tailEvents` is the σ-algebra of events that,
for every finite set `Λ` of coordinates, depend only on the coordinates outside `Λ`: the infimum
over finite `Λ` of Mathlib's `cylinderEvents Λᶜ`, which is also the infimum of Mathlib's
decreasing family `MeasureTheory.Filtration.cylinderEventsCompl`. This is the tail σ-field of a
random field in Georgii, *Gibbs measures and phase transitions* (2nd ed., 2011), Section 7.1, and
of a configuration space in Sheffield, *Random surfaces* (Astérisque 304, 2005), Section 3.2.

Tail events are unchanged by a modification of finitely many coordinates. For a finite index set
the tail σ-algebra is trivial. Reindexing a product `ι → S` along a finite-to-one map of index
sets is measurable for the tail σ-algebras, so a group acting on the index set maps tail events to
tail events. For a countably infinite index set read along an enumeration `e : ℕ ≃ ι`, the tail
σ-algebra is the tail σ-algebra `TauCeti.Probability.tailProcess` of the coordinate process
`k ↦ ω (e k)`; in particular it does not depend on the enumeration, and it is the `limsup` form
consumed by Kolmogorov's zero-one law.

## Main results

* `TauCeti.Probability.tailEvents`: the tail σ-algebra.
* `TauCeti.Probability.measurableSet_tailEvents_iff`, `TauCeti.Probability.le_tailEvents_iff`:
  its characterisations.
* `Measurable.dependsOn_of_tailEvents`, `MeasurableSet.dependsOn_of_tailEvents`: tail-measurable
  functions and tail events do not see finitely many coordinates.
* `TauCeti.Probability.measurable_comp_tailEvents`: reindexing along a finite-to-one map is
  measurable for the tail σ-algebras.
* `TauCeti.Probability.tailEvents_eq_tailProcess`: along an enumeration of the index set, the tail
  σ-algebra is the tail σ-algebra of the coordinate process.
-/

public section

open Filter MeasureTheory Set TauCeti.MeasureTheory

namespace TauCeti

namespace Probability

variable {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)]

/-- The tail σ-algebra of the product `∀ i, X i`: the events that, for every finite set `Λ` of
coordinates, are generated by the coordinates outside `Λ`. -/
@[implicit_reducible]
def tailEvents : MeasurableSpace (∀ i, X i) :=
  ⨅ Λ : Finset ι, cylinderEvents (↑Λ)ᶜ

/-- Unfolding lemma for `tailEvents`. -/
theorem tailEvents_def : tailEvents (X := X) = ⨅ Λ : Finset ι, cylinderEvents (↑Λ)ᶜ := (rfl)

/-- A σ-algebra is below the tail σ-algebra iff it is below `cylinderEvents Λᶜ` for every finite
`Λ`. -/
theorem le_tailEvents_iff {m : MeasurableSpace (∀ i, X i)} :
    m ≤ tailEvents ↔ ∀ Λ : Finset ι, m ≤ cylinderEvents (↑Λ)ᶜ :=
  tailEvents_def (X := X) ▸ le_iInf_iff

/-- An event is a tail event iff it is measurable for `cylinderEvents Λᶜ` for every finite `Λ`. -/
theorem measurableSet_tailEvents_iff {s : Set (∀ i, X i)} :
    MeasurableSet[tailEvents] s ↔ ∀ Λ : Finset ι, MeasurableSet[cylinderEvents (↑Λ)ᶜ] s := by
  rw [tailEvents_def, MeasurableSpace.measurableSet_iInf]

/-- The tail σ-algebra is below the σ-algebra generated by the coordinates outside any finite
set. -/
theorem tailEvents_le_cylinderEvents_compl {Λ : Set ι} (hΛ : Λ.Finite) :
    tailEvents (X := X) ≤ cylinderEvents Λᶜ := by
  simpa using le_tailEvents_iff.1 le_rfl hΛ.toFinset

/-- The tail σ-algebra is a sub-σ-algebra of the product σ-algebra. -/
theorem tailEvents_le_pi : tailEvents (X := X) ≤ MeasurableSpace.pi := by
  simpa using tailEvents_le_cylinderEvents_compl (X := X) finite_empty

/-- Over a finite index set the tail σ-algebra is trivial. -/
@[simp]
theorem tailEvents_eq_bot [Finite ι] : tailEvents (X := X) = ⊥ :=
  le_bot_iff.1 <| by simpa using tailEvents_le_cylinderEvents_compl (X := X) finite_univ

/-- The tail σ-algebra is the infimum of Mathlib's decreasing family of σ-algebras
`Filtration.cylinderEventsCompl` generated by the coordinates outside the finite sets. -/
theorem tailEvents_eq_iInf_cylinderEventsCompl {S : Type*} [MeasurableSpace S] :
    tailEvents (X := fun _ : ι => S) =
      ⨅ Λ, Filtration.cylinderEventsCompl (m := ‹MeasurableSpace S›) Λ := by
  -- `Filtration.cylinderEventsCompl` sends `toDual Λ` to `cylinderEvents (↑Λ)ᶜ` by definition.
  have h (Λ : Finset ι) : Filtration.cylinderEventsCompl (m := ‹MeasurableSpace S›)
      (OrderDual.toDual Λ) = cylinderEvents (↑Λ)ᶜ := rfl
  rw [tailEvents_def, ← OrderDual.toDual.iInf_comp]
  simp only [h]

end Probability

end TauCeti

open TauCeti.Probability

variable {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)] {Λ : Set ι}

/-- A tail-measurable function, with values in a space whose singletons are measurable, takes the
same value at two configurations that agree outside a finite set of coordinates. -/
theorem Measurable.dependsOn_of_tailEvents {Z : Type*} [MeasurableSpace Z]
    [MeasurableSingletonClass Z] {f : (∀ i, X i) → Z} (hf : Measurable[tailEvents] f)
    (hΛ : Λ.Finite) : DependsOn f Λᶜ :=
  (hf.mono (tailEvents_le_cylinderEvents_compl hΛ) le_rfl).dependsOn_of_cylinderEvents

/-- A tail event contains, with a configuration, every configuration that agrees with it outside a
finite set of coordinates. -/
theorem MeasurableSet.dependsOn_of_tailEvents {s : Set (∀ i, X i)}
    (hs : MeasurableSet[tailEvents] s) (hΛ : Λ.Finite) : DependsOn (· ∈ s) Λᶜ :=
  (tailEvents_le_cylinderEvents_compl hΛ _ hs).dependsOn_of_cylinderEvents

namespace TauCeti

namespace Probability

variable {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)]

/-- Reindexing a product `ι → S` along a finite-to-one map `σ : ι' → ι`, `ω ↦ ω ∘ σ`, is measurable
for the tail σ-algebras. -/
theorem measurable_comp_tailEvents {ι' S : Type*} [MeasurableSpace S] {σ : ι' → ι}
    (hσ : Tendsto σ cofinite cofinite) :
    Measurable[tailEvents (X := fun _ : ι => S), tailEvents (X := fun _ : ι' => S)]
      (fun ω : ι → S => ω ∘ σ) := by
  refine measurable_iff_comap_le.2 <| le_tailEvents_iff.2 fun Λ => ?_
  -- Tail events of `ι' → S` depend only on the coordinates outside the finite set `σ ⁻¹' Λ`.
  calc (tailEvents (X := fun _ : ι' => S)).comap (fun ω : ι → S => ω ∘ σ)
      ≤ (cylinderEvents (X := fun _ : ι' => S) (σ ⁻¹' Λ)ᶜ).comap (fun ω : ι → S => ω ∘ σ) :=
        MeasurableSpace.comap_mono <| tailEvents_le_cylinderEvents_compl <|
          by simpa using hσ Λ.finite_toSet.compl_mem_cofinite
    _ = cylinderEvents (σ '' (σ ⁻¹' Λ)ᶜ) := comap_comp_cylinderEvents _ _
    _ ≤ cylinderEvents (↑Λ)ᶜ := cylinderEvents_mono <| by
        rw [← preimage_compl]
        exact image_preimage_subset _ _

/-- A group acting on the index set maps tail events to tail events: each reindexing
`ω ↦ (i ↦ ω (g • i))` is measurable for the tail σ-algebras. -/
theorem measurable_comp_smul_tailEvents {Γ S : Type*} [Group Γ] [MulAction Γ ι]
    [MeasurableSpace S] (g : Γ) :
    Measurable[tailEvents (X := fun _ : ι => S), tailEvents (X := fun _ : ι => S)]
      (fun (ω : ι → S) i => ω (g • i)) :=
  measurable_comp_tailEvents (MulAction.injective g).tendsto_cofinite

/-- Along an enumeration `e : ℕ ≃ ι` of the index set, the tail σ-algebra of the product is the
tail σ-algebra of the coordinate process `k ↦ ω (e k)`. -/
theorem tailEvents_eq_tailProcess (e : ℕ ≃ ι) :
    tailEvents (X := X) = tailProcess (β := fun k => X (e k)) (fun k ω => ω (e k)) := by
  refine le_antisymm ?_ ?_
  · -- The future σ-algebra from time `n` contains the events generated by the coordinates outside
    -- the finite set `e '' Iio n`.
    rw [tailProcess_eq_iInf_tailFamily]
    refine le_iInf fun n => (tailEvents_le_cylinderEvents_compl ((finite_Iio n).image e)).trans <|
      cylinderEvents_le_iff.2 fun i hi => ?_
    obtain ⟨k, rfl⟩ := e.surjective i
    exact measurable_tailFamily_of_le (β := fun k => X (e k))
      (X := fun k (ω : ∀ i, X i) => ω (e k)) (not_lt.1 fun hk => hi ⟨k, hk, rfl⟩)
  · -- Every finite set of coordinates is enumerated before some time `n`.
    refine le_tailEvents_iff.2 fun Λ => ?_
    obtain ⟨n, hn⟩ := (Λ.finite_toSet.preimage e.injective.injOn).bddAbove
    refine (tailProcess_le_tailFamily _ (n + 1)).trans <| tailFamily_le_iff.2 fun k hk => ?_
    exact measurable_cylinderEvent_apply fun hkΛ => by have := hn hkΛ; omega

end Probability

end TauCeti
