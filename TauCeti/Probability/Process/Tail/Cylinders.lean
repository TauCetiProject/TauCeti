public import TauCeti.Probability.Process.Tail.Basic

/-!
# The tail σ-algebra of a product space

For a family of measurable spaces `X i`, `i : ι`, the σ-algebra `cylinderEvents Λᶜ` (Mathlib's
`MeasureTheory.cylinderEvents`) is generated by the coordinates outside `Λ`. The **tail
σ-algebra** `cylinderEventsTail` is the intersection of these σ-algebras over the finite sets
`Λ`, the infimum of Mathlib's family `MeasureTheory.Filtration.cylinderEventsCompl`. Its events
are the events that do not depend on any finite set of coordinates.

## Main declarations

* `TauCeti.Probability.cylinderEventsTail`: the tail σ-algebra `⨅ Λ, cylinderEvents (↑Λ)ᶜ`.
* `TauCeti.Probability.le_cylinderEventsTail_iff`,
  `TauCeti.Probability.measurableSet_cylinderEventsTail_iff`: a σ-algebra lies below the tail
  σ-algebra, and an event is a tail event, iff this holds for the exterior σ-algebra of every
  finite set.
* `TauCeti.Probability.cylinderEventsTail_le`, `cylinderEventsTail_le_pi`: it lies below every
  exterior σ-algebra of a finite set, hence below the product σ-algebra.
* `TauCeti.Probability.mem_of_measurableSet_cylinderEventsTail`: tail events are invariant under
  any change of finitely many coordinates.
* `TauCeti.Probability.comap_inv_smul_cylinderEventsTail`: for a group `Γ` acting on the index
  set and on configurations by `(γ • ω) i = ω (γ⁻¹ • i)`, pulling the tail σ-algebra back along
  `ω ↦ γ • ω` gives the tail σ-algebra again.
* `TauCeti.Probability.cylinderEventsTail_eq_tailProcess`: along any enumeration `e : ℕ ≃ ι`,
  the tail σ-algebra is the tail σ-algebra `tailProcess` of the coordinate process `ω (e k)`, the
  `limsup` form consumed by Kolmogorov's zero-one law.

## References

* S. Sheffield, *Random surfaces*, Astérisque 304 (2005), Section 3.2.
-/

public section

noncomputable section

open MeasureTheory Set
open scoped Pointwise

namespace TauCeti

namespace Probability

section Tail

variable {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)]

variable (X) in
/-- The tail σ-algebra of the product `∀ i, X i`: the intersection, over the finite sets `Λ`, of
the σ-algebras `cylinderEvents Λᶜ` generated by the coordinates outside `Λ`. -/
@[implicit_reducible]
def cylinderEventsTail : MeasurableSpace (∀ i, X i) :=
  ⨅ Λ : Finset ι, cylinderEvents (↑Λ)ᶜ

variable (X) in
/-- The tail σ-algebra is the infimum of the exterior σ-algebras of the finite sets. -/
theorem cylinderEventsTail_def :
    cylinderEventsTail X = ⨅ Λ : Finset ι, cylinderEvents (↑Λ)ᶜ :=
  (rfl)

/-- A σ-algebra lies below the tail σ-algebra iff it lies below the σ-algebra of the coordinates
outside every finite set. -/
theorem le_cylinderEventsTail_iff {m : MeasurableSpace (∀ i, X i)} :
    m ≤ cylinderEventsTail X ↔ ∀ Λ : Finset ι, m ≤ cylinderEvents (↑Λ)ᶜ :=
  le_iInf_iff

/-- An event is a tail event iff, for every finite set `Λ`, it is measurable with respect to the
coordinates outside `Λ`. -/
theorem measurableSet_cylinderEventsTail_iff {A : Set (∀ i, X i)} :
    MeasurableSet[cylinderEventsTail X] A ↔
      ∀ Λ : Finset ι, MeasurableSet[cylinderEvents (↑Λ)ᶜ] A :=
  MeasurableSpace.measurableSet_iInf

/-- The tail σ-algebra is below the σ-algebra of the coordinates outside a finite set. -/
theorem cylinderEventsTail_le (Λ : Finset ι) :
    cylinderEventsTail X ≤ cylinderEvents (↑Λ)ᶜ :=
  iInf_le _ Λ

/-- The tail σ-algebra is below the σ-algebra of the coordinates outside a finite `Set`. -/
theorem cylinderEventsTail_le_of_finite {Λ : Set ι} (hΛ : Λ.Finite) :
    cylinderEventsTail X ≤ cylinderEvents Λᶜ := by
  simpa using cylinderEventsTail_le (X := X) hΛ.toFinset

/-- The tail σ-algebra is a sub-σ-algebra of the product σ-algebra. -/
theorem cylinderEventsTail_le_pi : cylinderEventsTail X ≤ MeasurableSpace.pi :=
  (cylinderEventsTail_le ∅).trans cylinderEvents_le_pi

/-- On a finite product the tail σ-algebra is trivial. -/
@[simp]
theorem cylinderEventsTail_eq_bot [Finite ι] : cylinderEventsTail X = ⊥ := by
  have := Fintype.ofFinite ι
  refine le_bot_iff.1 ((cylinderEventsTail_le Finset.univ).trans ?_)
  simp [cylinderEvents]

/-- Tail events are invariant under any change of finitely many coordinates. -/
theorem mem_of_measurableSet_cylinderEventsTail {A : Set (∀ i, X i)}
    (hA : MeasurableSet[cylinderEventsTail X] A) {Λ : Set ι} (hΛ : Λ.Finite)
    {ω ω' : ∀ i, X i} (hω : ω ∈ A) (h : ∀ i ∉ Λ, ω' i = ω i) : ω' ∈ A :=
  mem_of_measurableSet_cylinderEvents (cylinderEventsTail_le_of_finite hΛ A hA) hω h

/-- The tail σ-algebra of a product of copies of one space is the infimum of Mathlib's family
`Filtration.cylinderEventsCompl` of exterior σ-algebras of finite sets. -/
theorem cylinderEventsTail_eq_iInf_cylinderEventsCompl {S : Type*} [MeasurableSpace S] :
    cylinderEventsTail (fun _ : ι => S) =
      ⨅ Λ, Filtration.cylinderEventsCompl (α := ι) (m := ‹MeasurableSpace S›) Λ :=
  le_antisymm (le_iInf fun Λ => iInf_le _ (OrderDual.ofDual Λ))
    (le_iInf fun Λ => iInf_le_of_le (OrderDual.toDual Λ) le_rfl)

/-- The future σ-algebra of the coordinates read along a sequence of indices `e`, from `n`
onwards, is the σ-algebra of the coordinates in `e '' Ici n`. -/
theorem tailFamily_comp_eq_cylinderEvents (e : ℕ → ι) (n : ℕ) :
    tailFamily (fun k (ω : ∀ i, X i) => ω (e k)) n = cylinderEvents (e '' Ici n) := by
  refine le_antisymm (tailFamily_le_iff.2 fun k hk => ?_) (cylinderEvents_le_iff.2 ?_)
  · exact measurable_cylinderEvent_apply ⟨k, hk, rfl⟩
  · rintro _ ⟨k, hk, rfl⟩
    exact measurable_tailFamily_of_le (X := fun k (ω : ∀ i, X i) => ω (e k)) hk

/-- Along any enumeration `e : ℕ ≃ ι`, the tail σ-algebra is the tail σ-algebra `tailProcess` of
the coordinate process `k ↦ ω (e k)`. In particular it is of the `limsup` form consumed by
Kolmogorov's zero-one law, and `tailProcess` of the coordinate process does not depend on the
enumeration. -/
theorem cylinderEventsTail_eq_tailProcess (e : ℕ ≃ ι) :
    cylinderEventsTail X = tailProcess (fun k (ω : ∀ i, X i) => ω (e k)) := by
  classical
  rw [tailProcess_eq_iInf_tailFamily]
  refine le_antisymm (le_iInf fun n => ?_) (le_iInf fun Λ => ?_)
  · rw [tailFamily_comp_eq_cylinderEvents]
    refine (cylinderEventsTail_le ((Finset.range n).map e.toEmbedding)).trans
      (cylinderEvents_mono ?_)
    intro i hi
    refine ⟨e.symm i, ?_, e.apply_symm_apply i⟩
    by_contra h
    exact hi (Finset.mem_coe.2 (Finset.mem_map.2
      ⟨e.symm i, Finset.mem_range.2 (not_le.1 h), by simp⟩))
  · refine iInf_le_of_le (Λ.sup fun i => e.symm i + 1) ?_
    rw [tailFamily_comp_eq_cylinderEvents]
    refine cylinderEvents_mono ?_
    rintro _ ⟨k, hk, rfl⟩ hkΛ
    have := Finset.le_sup (f := fun i => e.symm i + 1) hkΛ
    simp only [Equiv.symm_apply_apply] at this
    exact absurd hk (by simp only [mem_Ici, not_le]; omega)

end Tail

section Action

variable {I S : Type*} [MeasurableSpace S]

variable {Γ : Type*} [Group Γ] [MulAction Γ I]

/-- Let `Γ` act on configurations by `(γ • ω) i = ω (γ⁻¹ • i)`. Pulling the tail σ-algebra back
along `ω ↦ γ • ω` gives the tail σ-algebra again. -/
@[simp]
theorem comap_inv_smul_cylinderEventsTail (γ : Γ) :
    MeasurableSpace.comap (fun (ω : I → S) i => ω (γ⁻¹ • i)) (cylinderEventsTail (fun _ : I => S)) =
      cylinderEventsTail (fun _ : I => S) := by
  classical
  have hle (γ : Γ) : MeasurableSpace.comap (fun (ω : I → S) i => ω (γ⁻¹ • i))
      (cylinderEventsTail (fun _ : I => S)) ≤ cylinderEventsTail (fun _ : I => S) := by
    refine le_iInf fun Λ => (MeasurableSpace.comap_mono (cylinderEventsTail_le (γ • Λ))).trans ?_
    rw [comap_inv_smul_cylinderEvents, Finset.coe_smul_finset, ← smul_set_compl,
      inv_smul_smul]
  refine le_antisymm (hle γ) ?_
  calc cylinderEventsTail (fun _ : I => S)
      = MeasurableSpace.comap ((fun (ω : I → S) i => ω (γ⁻¹⁻¹ • i)) ∘
          fun (ω : I → S) i => ω (γ⁻¹ • i)) (cylinderEventsTail (fun _ : I => S)) := by
        simp only [Function.comp_def, inv_inv, inv_smul_smul]
        exact MeasurableSpace.comap_id.symm
    _ ≤ MeasurableSpace.comap (fun (ω : I → S) i => ω (γ⁻¹ • i))
          (cylinderEventsTail (fun _ : I => S)) := by
        rw [← MeasurableSpace.comap_comp]
        exact MeasurableSpace.comap_mono (hle γ⁻¹)

end Action

end Probability

