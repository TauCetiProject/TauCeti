module

public import TauCeti.Probability.Process.Tail.Product
public import Mathlib.Probability.ProductMeasure
import Mathlib.Probability.Independence.ZeroOne
import TauCeti.Probability.Independence.InfinitePi

/-!
# Kolmogorov's zero-one law for product measures

Over any index set `ι`, a product of probability measures (Mathlib's `Measure.infinitePi`) is
trivial on the tail σ-algebra `TauCeti.Probability.tailEvents`: every tail event has measure `0`
or `1`. The coordinates are independent under the product measure, and the tail σ-algebra lies
below the limit superior along the cofinite filter of the σ-algebras they generate, so
Mathlib's zero-one law `ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup` applies.
The ergodicity of Bernoulli product measures under group actions, which follows from it, is in
`TauCeti.Probability.Ergodic.Bernoulli.Action`.

## Main results

* `TauCeti.Probability.infinitePi_eq_zero_or_one_of_measurableSet_tailEvents`: Kolmogorov's
  zero-one law for a product measure.

## References

* H.-O. Georgii, *Gibbs measures and phase transitions* (2nd ed., 2011), Chapter 14.
-/

public section

open Filter MeasureTheory ProbabilityTheory Set

namespace TauCeti

namespace Probability

variable {ι : Type*}

/-- **Kolmogorov's zero-one law** for a product measure: every tail event has measure `0` or `1`
under a product of probability measures. -/
theorem infinitePi_eq_zero_or_one_of_measurableSet_tailEvents {X : ι → Type*}
    [mX : ∀ i, MeasurableSpace (X i)] {P : ∀ i, Measure (X i)} [∀ i, IsProbabilityMeasure (P i)]
    {t : Set (∀ i, X i)} (ht : MeasurableSet[tailEvents] t) :
    Measure.infinitePi P t = 0 ∨ Measure.infinitePi P t = 1 := by
  -- A tail event is measurable for the σ-algebra generated by the coordinates in any cofinite set.
  have hle : tailEvents (X := X) ≤
      limsup (fun i => (mX i).comap fun ω : ∀ i, X i => ω i) cofinite := by
    rw [limsup_eq_iInf_iSup]
    refine le_iInf₂ fun s hs => ?_
    simpa only [cylinderEvents, compl_compl] using
      tailEvents_le_cylinderEvents_compl (X := X) (Λ := sᶜ) hs
  exact measure_zero_or_one_of_measurableSet_limsup (p := Set.Finite)
    (ns := fun Λ : Finset ι => (Λ : Set ι)) (fun i => (measurable_pi_apply i).comap_le)
    (iIndepFun_eval_infinitePi P).iIndep (fun _ h => h.compl_mem_cofinite)
    (Monotone.directed_le fun _ _ h => Finset.coe_subset.2 h) (fun Λ => Λ.finite_toSet)
    (fun i => ⟨{i}, by simp⟩) (hle _ ht)

end Probability

end TauCeti
