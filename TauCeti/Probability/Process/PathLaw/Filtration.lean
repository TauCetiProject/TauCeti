module

public import Mathlib.Probability.Process.Adapted

/-!
# The natural filtration of path space through finite prefixes

Mathlib's natural filtration `MeasureTheory.Filtration.piLE` of a product `Π n, X n` is generated
at time `n` by the restriction to `Finset.Iic n`. On one-sided path space `ℕ → α`, statements about
processes are usually phrased with `Fin`-indexed prefixes `(x 0, …, x n)` instead, as in the prefix
laws of a process. This file identifies the two σ-algebras, so that conditional expectations with
respect to `piLE` can be computed on events of the form `{(x 0, …, x n) ∈ A}`, and records that the
coordinate process is adapted to `piLE`.
-/

public section

namespace MeasureTheory.Filtration

/-- The coordinates of a product `Π i, X i` are adapted to its natural filtration `piLE`. -/
theorem adapted_piLE {ι : Type*} [Preorder ι] {X : ι → Type*} [∀ i, MeasurableSpace (X i)] :
    Adapted (piLE (X := X)) fun i x => x i := fun i =>
  (measurable_pi_apply (⟨i, Set.mem_Iic.2 le_rfl⟩ : Set.Iic i)).comp
    (comap_measurable (Preorder.restrictLe i))

variable {α : Type*} [MeasurableSpace α]

/-- The natural filtration of path space `ℕ → α` at time `n` is generated by the prefix
`(x 0, …, x n)`. -/
theorem piLE_eq_comap_prefix (n : ℕ) :
    piLE (X := fun _ : ℕ => α) n =
      MeasurableSpace.comap (fun x (i : Fin (n + 1)) => x i.1) inferInstance := by
  rw [piLE_eq_comap_frestrictLe]
  refine le_antisymm (Measurable.comap_le ?_) (Measurable.comap_le ?_)
  · have h : Preorder.frestrictLe (π := fun _ : ℕ => α) n =
        (fun (w : Fin (n + 1) → α) (j : Finset.Iic n) =>
          w ⟨j.1, Nat.lt_succ_of_le (Finset.mem_Iic.1 j.2)⟩) ∘
          fun x (i : Fin (n + 1)) => x i.1 := by
      funext x j
      simp
    rw [h]
    exact (by fun_prop : Measurable fun (w : Fin (n + 1) → α) (j : Finset.Iic n) =>
      w ⟨j.1, Nat.lt_succ_of_le (Finset.mem_Iic.1 j.2)⟩).comp (comap_measurable _)
  · have h : (fun x (i : Fin (n + 1)) => x i.1) =
        (fun (u : Finset.Iic n → α) (i : Fin (n + 1)) =>
          u ⟨i.1, Finset.mem_Iic.2 (Nat.lt_succ_iff.1 i.2)⟩) ∘
          Preorder.frestrictLe (π := fun _ : ℕ => α) n := by
      funext x i
      simp
    rw [h]
    exact (by fun_prop : Measurable fun (u : Finset.Iic n → α) (i : Fin (n + 1)) =>
      u ⟨i.1, Finset.mem_Iic.2 (Nat.lt_succ_iff.1 i.2)⟩).comp (comap_measurable _)

end MeasureTheory.Filtration
