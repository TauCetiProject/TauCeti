/-!
# The optional sigma algebra and stopping-time ray generation

The optional sigma algebra is generated by adapted real càdlàg processes. Its universal
property lets one prove measurability by testing precisely these generators. It contains the
predictable sigma algebra for separable order-closed time indices with a bottom element. In
nonnegative real time it is contained in the progressive sigma algebra, without completeness
or right continuity of the filtration.

Closed stopping-time rays, half-open stochastic intervals `[σ, τ)`, their intersections with events
known at the left stopping time, and finite stopping-time graphs are optional. The graph never
includes an evaluation at infinity.

Conversely, in nonnegative real time `ℝ≥0` on an arbitrary filtration (assuming neither
completeness nor right continuity), iterated oscillation exit stopping times approximate every
strongly adapted càdlàg process uniformly by step processes measurable for the σ-algebra generated
by closed stopping-time rays `[τ, ∞)`. Consequently, `F.optional` equals the σ-algebra generated by
closed stopping-time rays (`MeasureTheory.Filtration.optional_eq_generateFrom_le`) and equally by
half-open stochastic intervals `[σ, τ)` (`optional_eq_generateFrom_Ico`). Every adapted càdlàg
process in a second-countable pseudometrizable Borel space (in particular `ℝ^d` and
finite-dimensional real vector spaces) is optional, and every strongly adapted càdlàg process in an
arbitrary pseudometrizable space is strongly optional. No section theorem is asserted here.

## References

* C. Dellacherie and P.-A. Meyer, *Probabilities and Potential*, Chapter IV, Theorem 64, optional
  and predictable sigma algebras.
* I. Karatzas and S. E. Shreve, *Brownian Motion and Stochastic Calculus*, second edition,
  Chapter 1, §1, progressive measurability of right-continuous adapted processes.
-/

public section

open MeasureTheory Set
open scoped NNReal

namespace MeasureTheory.Filtration

variable {ι Ω : Type*} [Preorder ι] [TopologicalSpace ι] {m : MeasurableSpace Ω}

/-- The sigma algebra on time × sample space generated by adapted real càdlàg processes. -/
@[instance_reducible]
def optional (F : Filtration ι m) : MeasurableSpace (ι × Ω) :=
  ⨆ (X : ι → Ω → ℝ) (_ : Adapted F X) (_ : ∀ ω, IsCadlag (fun t => X t ω)),
    MeasurableSpace.comap (Function.uncurry X) inferInstance

/-- An adapted real process with everywhere càdlàg paths is optional. -/
theorem measurable_optional (F : Filtration ι m) {X : ι → Ω → ℝ}
    (hX : Adapted F X) (hc : ∀ ω, IsCadlag (fun t => X t ω)) :
    Measurable[F.optional] (Function.uncurry X) :=
  measurable_iff_comap_le.mpr (le_iSup_of_le X (le_iSup_of_le hX (le_iSup_of_le hc le_rfl)))

/-- A coordinatewise real process `X : ι → Ω → (κ → ℝ)` whose coordinates are adapted and have
everywhere càdlàg paths is optional for the product σ-algebra on `κ → ℝ` (in particular the Borel
σ-algebra on `ℝ^d` when `κ` is finite or countable). -/
theorem measurable_optional_pi {κ : Type*} (F : Filtration ι m) {X : ι → Ω → κ → ℝ}
    (hX : Adapted F X) (hc : ∀ ω k, IsCadlag (fun t => X t ω k)) :
    Measurable[F.optional] (Function.uncurry X) := by
  let _ : MeasurableSpace (ι × Ω) := F.optional
  exact measurable_pi_iff.mpr fun k =>
    F.measurable_optional (fun t => (measurable_pi_apply k).comp (hX t)) (fun ω => hc ω k)

/-- The optional sigma algebra is the least sigma algebra making all adapted real càdlàg
processes measurable. -/
theorem optional_le_iff (F : Filtration ι m) {m' : MeasurableSpace (ι × Ω)} :
    F.optional ≤ m' ↔ ∀ X : ι → Ω → ℝ, Adapted F X →
      (∀ ω, IsCadlag (fun t => X t ω)) → Measurable[m'] (Function.uncurry X) := by
  simp only [optional, iSup_le_iff, measurable_iff_comap_le]

/-- Enlarging the filtration enlarges its optional sigma algebra. -/
theorem optional_mono {F G : Filtration ι m} (h : F ≤ G) : F.optional ≤ G.optional := by
  apply (F.optional_le_iff).mpr
  intro X hX hc
  exact G.measurable_optional (fun t => (hX t).mono (h t) le_rfl) hc

variable (F : Filtration ℝ≥0 m)

/-- Every optional set in nonnegative real time is progressive. -/
theorem optional_le_progressive : F.optional ≤ F.progressive := by
  apply F.optional_le_iff.mpr
  intro X hX hc
  exact (F.measurable_progressive_iff).mpr
    (hX.isProgressive_of_isRightContinuous (fun ω => (hc ω).isRightContinuous))

/-- Every optional set in nonnegative real time is ambient-product measurable. -/
theorem optional_le_prod : F.optional ≤ (inferInstance : MeasurableSpace ℝ≥0).prod m :=
  F.optional_le_progressive.trans F.progressive_le_prod

end MeasureTheory.Filtration

namespace MeasureTheory.IsStoppingTime

variable {ι Ω : Type*} [LinearOrder ι] [TopologicalSpace ι] [OrderClosedTopology ι]
    {m : MeasurableSpace Ω} {F : Filtration ι m} {τ : Ω → WithTop ι}

/-- The closed stochastic ray `[τ,∞)` over an event known at `τ` is optional.
When `τ = ∞` its time fiber is empty. -/
theorem measurableSet_optional_le_inter (hτ : IsStoppingTime F τ) {A : Set Ω}
    (hA : MeasurableSet[hτ.measurableSpace] A) :
    MeasurableSet[F.optional] {p : ι × Ω | τ p.2 ≤ p.1 ∧ p.2 ∈ A} := by
  classical
  let X (t : ι) (ω : Ω) : ℝ := if τ ω ≤ t ∧ ω ∈ A then 1 else 0
  have hX : Adapted F X := by
    intro t
    dsimp only [X]
    apply Measurable.ite _ measurable_const measurable_const
    simpa only [inter_def, mem_ofPred_eq, and_comm] using ((hτ.measurableSet A).mp hA).2 t
  have hc (ω : Ω) : IsCadlag (fun t => X t ω) := by
    by_cases hω : ω ∈ A
    · cases h : τ ω with
      | top =>
        simpa only [X, h, WithTop.not_top_le_coe, false_and, ite_false] using
          (IsCadlag.const (X := ι) (c := (0 : ℝ)))
      | coe a =>
        simpa only [X, h, WithTop.coe_le_coe, hω, and_true] using
          TauCeti.isCadlag_ite_le a (1 : ℝ) 0
    · simp [X, hω]
  have hm := (F.measurable_optional hX hc) (measurableSet_singleton (1 : ℝ))
  convert hm using 1
  ext p
  simp only [mem_ofPred_eq, mem_preimage, mem_singleton_iff, X, Function.uncurry_def]
  split_ifs <;> simp_all

/-- The closed stochastic ray `[τ,∞)` is optional for every stopping time. -/
theorem measurableSet_optional_le (hτ : IsStoppingTime F τ) :
    MeasurableSet[F.optional] {p : ι × Ω | τ p.2 ≤ p.1} := by
  simpa using hτ.measurableSet_optional_le_inter (A := univ) MeasurableSet.univ

/-- The half-open stochastic interval `[σ, τ)` over an event known at the left stopping time `σ` is
optional. No ordering between `σ` and `τ` is assumed; the interval is empty on paths where `τ ≤ σ`
or `σ = ⊤`. -/
theorem measurableSet_optional_Ico_inter {σ : Ω → WithTop ι} (hσ : IsStoppingTime F σ)
    (hτ : IsStoppingTime F τ) {A : Set Ω} (hA : MeasurableSet[hσ.measurableSpace] A) :
    MeasurableSet[F.optional]
      {p : ι × Ω | σ p.2 ≤ p.1 ∧ (p.1 : WithTop ι) < τ p.2 ∧ p.2 ∈ A} := by
  have he : {p : ι × Ω | σ p.2 ≤ p.1 ∧ (p.1 : WithTop ι) < τ p.2 ∧ p.2 ∈ A} =
      {p : ι × Ω | σ p.2 ≤ p.1 ∧ p.2 ∈ A} \ {p : ι × Ω | τ p.2 ≤ p.1} := by
    ext p
    simp only [mem_ofPred_eq, Set.mem_sdiff, not_le]
    tauto
  rw [he]
  exact (hσ.measurableSet_optional_le_inter hA).diff hτ.measurableSet_optional_le

/-- The half-open stochastic interval `[σ, τ)` is optional for any pair of stopping times. -/
theorem measurableSet_optional_Ico {σ : Ω → WithTop ι} (hσ : IsStoppingTime F σ)
    (hτ : IsStoppingTime F τ) :
    MeasurableSet[F.optional] {p : ι × Ω | σ p.2 ≤ p.1 ∧ (p.1 : WithTop ι) < τ p.2} := by
  simpa using hσ.measurableSet_optional_Ico_inter hτ (A := univ) MeasurableSet.univ

end MeasureTheory.IsStoppingTime

namespace MeasureTheory.Filtration

variable {ι Ω : Type*} [LinearOrder ι] [TopologicalSpace ι] [OrderClosedTopology ι]
    {m : MeasurableSpace Ω} (F : Filtration ι m)

/-- A closed deterministic-time ray over an event known at its left endpoint is optional. -/
theorem measurableSet_optional_Ici_prod (t : ι) {A : Set Ω} (hA : MeasurableSet[F t] A) :
    MeasurableSet[F.optional] (Ici t ×ˢ A) := by
  have hτ := isStoppingTime_const F t
  have hAτ : MeasurableSet[hτ.measurableSpace] A := by
    rwa [IsStoppingTime.measurableSpace_const]
  convert hτ.measurableSet_optional_le_inter hAτ using 1
  ext p
  simp only [mem_prod, mem_Ici, mem_ofPred_eq, WithTop.coe_le_coe]

/-- An open deterministic-time ray over an event known at its left endpoint is optional. -/
theorem measurableSet_optional_Ioi_prod [TopologicalSpace.SeparableSpace ι] (t : ι) {A : Set Ω}
    (hA : MeasurableSet[F t] A) : MeasurableSet[F.optional] (Ioi t ×ˢ A) := by
  obtain ⟨D, hDc, hDd⟩ := TopologicalSpace.exists_countable_dense ι
  let S := D ∪ {u : ι | t ⋖ u}
  have hSc : S.Countable := hDc.union (Set.Subsingleton.countable fun _ hx _ hy =>
    hx.unique_right hy)
  have he : Ioi t = ⋃ q ∈ S ∩ Ioi t, Ici q := by
    ext s
    simp only [mem_Ioi, mem_iUnion, mem_inter_iff, mem_Ici]
    constructor
    · intro hts
      by_cases hcov : t ⋖ s
      · exact ⟨s, ⟨Or.inr hcov, hts⟩, le_rfl⟩
      · obtain ⟨q, hqD, htq, hqs⟩ := hDd.exists_mem_open isOpen_Ioo
          ((not_covBy_iff_exists_mem_Ioo hts).mp hcov)
        exact ⟨q, ⟨Or.inl hqD, htq⟩, hqs.le⟩
    · rintro ⟨q, ⟨_, htq⟩, hqs⟩
      exact htq.trans_le hqs
  rw [he, iUnion_prod_const]
  simp_rw [iUnion_prod_const]
  exact MeasurableSet.biUnion (hSc.mono inter_subset_left) fun q hq =>
    F.measurableSet_optional_Ici_prod q (F.mono hq.2.le _ hA)

/-- Every predictable set is optional for separable order-closed time with a bottom element. -/
theorem predictable_le_optional [OrderBot ι] [TopologicalSpace.SeparableSpace ι] :
    F.predictable ≤ F.optional := by
  apply measurableSpace_le_predictable_of_measurableSet
  · intro A hA
    have he : {⊥} ×ˢ A = Ici (⊥ : ι) ×ˢ A \ Ioi ⊥ ×ˢ A := by
      simp only [prod_sdiff_prod, sdiff_self, prod_empty, empty_union, Ici_sdiff_Ioi, Icc_self]
    rw [he]
    exact (F.measurableSet_optional_Ici_prod ⊥ hA).diff
      (F.measurableSet_optional_Ioi_prod ⊥ hA)
  · exact fun t A hA => F.measurableSet_optional_Ioi_prod t hA

end MeasureTheory.Filtration

namespace MeasureTheory.IsStoppingTime

variable {ι Ω : Type*} [LinearOrder ι] [OrderBot ι] [TopologicalSpace ι]
    [OrderTopology ι] [SecondCountableTopology ι] {m : MeasurableSpace Ω}
    {F : Filtration ι m} {τ : Ω → WithTop ι}

/-- The finite graph of a stopping time, restricted to an event known at that time, is optional.
There is no graph point at infinity on the time-first carrier `ι × Ω`. -/
theorem measurableSet_optional_graph_inter (hτ : IsStoppingTime F τ) {A : Set Ω}
    (hA : MeasurableSet[hτ.measurableSpace] A) :
    MeasurableSet[F.optional] {p : ι × Ω | τ p.2 = p.1 ∧ p.2 ∈ A} := by
  have he : {p : ι × Ω | τ p.2 = p.1 ∧ p.2 ∈ A} =
      {p : ι × Ω | τ p.2 ≤ p.1 ∧ p.2 ∈ A} \ {p : ι × Ω | τ p.2 < p.1} := by
    ext p
    simp only [mem_ofPred_eq, mem_sdiff]
    grind
  rw [he]
  exact (hτ.measurableSet_optional_le_inter hA).diff
    (F.predictable_le_optional _ hτ.measurableSet_predictable_lt)

/-- The finite graph of every stopping time is optional. -/
theorem measurableSet_optional_graph (hτ : IsStoppingTime F τ) :
    MeasurableSet[F.optional] {p : ι × Ω | τ p.2 = p.1} := by
  simpa using hτ.measurableSet_optional_graph_inter (A := univ) MeasurableSet.univ

end MeasureTheory.IsStoppingTime

section RayGeneration

open Filter TopologicalSpace
open scoped Topology

namespace MeasureTheory

/-- Every strongly adapted process with everywhere càdlàg paths on `ℝ≥0` into a pseudometrizable
Borel space is measurable with respect to the σ-algebra generated by closed stopping-time rays
`{p | τ p.2 ≤ p.1}`, on the raw filtration `F` (assuming neither completeness nor right continuity
of `F` and neither separability nor algebraic structure on `E`). -/
theorem StronglyAdapted.measurable_generateFrom_le_of_isCadlag
    {Ω E : Type*} {m : MeasurableSpace Ω} [TopologicalSpace E] [PseudoMetrizableSpace E]
    [MeasurableSpace E] [BorelSpace E] {F : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}
    (hX : StronglyAdapted F X) (hc : ∀ ω, IsCadlag (X · ω)) :
    Measurable[MeasurableSpace.generateFrom
      {s : Set (ℝ≥0 × Ω) | ∃ τ : Ω → WithTop ℝ≥0, IsStoppingTime F τ ∧ s = {p | τ p.2 ≤ p.1}}]
      (Function.uncurry X) := by
  let _ : PseudoMetricSpace E := TopologicalSpace.pseudoMetrizableSpacePseudoMetric E
  let _ : MeasurableSpace (ℝ≥0 × Ω) := MeasurableSpace.generateFrom
    {s : Set (ℝ≥0 × Ω) | ∃ τ : Ω → WithTop ℝ≥0, IsStoppingTime F τ ∧ s = {p | τ p.2 ≤ p.1}}
  refine measurable_of_tendsto_metrizable
    (f := fun k : ℕ ↦ Function.uncurry (TauCeti.oscillationApprox X ((1 : ℝ) / (k + 1))))
    (fun k ↦ hX.measurable_generateFrom_le_oscillationApprox hc (by positivity)) ?_
  rw [tendsto_pi_nhds]
  rintro ⟨t, ω⟩
  exact (hc ω).tendsto_oscillationApprox (fun k ↦ by positivity)
    (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)) t

/-- Every adapted càdlàg process on `ℝ≥0` into a second-countable pseudometrizable Borel space is
measurable with respect to the σ-algebra generated by closed stopping-time rays on the raw
filtration `F`. -/
theorem Adapted.measurable_generateFrom_le_of_isCadlag
    {Ω E : Type*} {m : MeasurableSpace Ω} [TopologicalSpace E] [PseudoMetrizableSpace E]
    [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]
    {F : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}
    (hX : Adapted F X) (hc : ∀ ω, IsCadlag (X · ω)) :
    Measurable[MeasurableSpace.generateFrom
      {s : Set (ℝ≥0 × Ω) | ∃ τ : Ω → WithTop ℝ≥0, IsStoppingTime F τ ∧ s = {p | τ p.2 ≤ p.1}}]
      (Function.uncurry X) :=
  (stronglyAdapted_iff_adapted.mpr hX).measurable_generateFrom_le_of_isCadlag hc

namespace Filtration

/-- On an arbitrary filtration in nonnegative real time (assuming neither completeness nor right
continuity), the optional σ-algebra generated by adapted real càdlàg processes equals the σ-algebra
generated by closed stopping-time rays `[τ, ∞)`. -/
theorem optional_eq_generateFrom_le {Ω : Type*} {m : MeasurableSpace Ω} (F : Filtration ℝ≥0 m) :
    F.optional = MeasurableSpace.generateFrom
      {s : Set (ℝ≥0 × Ω) | ∃ τ : Ω → WithTop ℝ≥0, IsStoppingTime F τ ∧ s = {p | τ p.2 ≤ p.1}} := by
  apply le_antisymm
  · exact F.optional_le_iff.mpr fun X hX hc ↦ hX.measurable_generateFrom_le_of_isCadlag hc
  · refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨τ, hτ, rfl⟩
    exact hτ.measurableSet_optional_le

/-- On an arbitrary filtration in nonnegative real time, the optional σ-algebra also equals the
σ-algebra generated by half-open stochastic intervals `[σ, τ)`. -/
theorem optional_eq_generateFrom_Ico {Ω : Type*} {m : MeasurableSpace Ω} (F : Filtration ℝ≥0 m) :
    F.optional = MeasurableSpace.generateFrom
      {s : Set (ℝ≥0 × Ω) | ∃ σ τ : Ω → WithTop ℝ≥0, IsStoppingTime F σ ∧ IsStoppingTime F τ ∧
        s = {p | σ p.2 ≤ p.1 ∧ (p.1 : WithTop ℝ≥0) < τ p.2}} := by
  apply le_antisymm
  · rw [F.optional_eq_generateFrom_le]
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨σ, hσ, rfl⟩
    have heq : {p : ℝ≥0 × Ω | σ p.2 ≤ p.1} =
        {p | σ p.2 ≤ p.1 ∧ (p.1 : WithTop ℝ≥0) < (fun _ : Ω ↦ (⊤ : WithTop ℝ≥0)) p.2} := by
      ext p
      simp only [mem_ofPred_eq, iff_self_and]
      exact fun _ ↦ WithTop.coe_lt_top p.1
    rw [heq]
    exact MeasurableSpace.measurableSet_generateFrom ⟨σ, _, hσ, isStoppingTime_top F, rfl⟩
  · refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨σ, τ, hσ, hτ, rfl⟩
    exact hσ.measurableSet_optional_Ico hτ

end Filtration

/-- Every strongly adapted càdlàg process on `ℝ≥0` into a pseudometrizable Borel space is optional
on the raw filtration `F`. -/
theorem StronglyAdapted.measurable_optional_of_isCadlag
    {Ω E : Type*} {m : MeasurableSpace Ω} [TopologicalSpace E] [PseudoMetrizableSpace E]
    [MeasurableSpace E] [BorelSpace E] {F : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}
    (hX : StronglyAdapted F X) (hc : ∀ ω, IsCadlag (X · ω)) :
    Measurable[F.optional] (Function.uncurry X) := by
  rw [F.optional_eq_generateFrom_le]
  exact hX.measurable_generateFrom_le_of_isCadlag hc

/-- Every adapted càdlàg process on `ℝ≥0` into a second-countable pseudometrizable Borel space (in
particular `ℝ`, `Fin d → ℝ`, any finite-dimensional real normed space, or any Polish space) is
optional on the raw filtration `F`. -/
theorem Adapted.measurable_optional_of_isCadlag
    {Ω E : Type*} {m : MeasurableSpace Ω} [TopologicalSpace E] [PseudoMetrizableSpace E]
    [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]
    {F : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}
    (hX : Adapted F X) (hc : ∀ ω, IsCadlag (X · ω)) :
    Measurable[F.optional] (Function.uncurry X) :=
  (stronglyAdapted_iff_adapted.mpr hX).measurable_optional_of_isCadlag hc

/-- Every strongly adapted càdlàg process on `ℝ≥0` into an arbitrary pseudometrizable topological
space is strongly optional on the raw filtration `F`, with no second-countability or measurable
space assumption on `E`. -/
theorem StronglyAdapted.stronglyMeasurable_optional_of_isCadlag
    {Ω E : Type*} {m : MeasurableSpace Ω} [TopologicalSpace E] [PseudoMetrizableSpace E]
    {F : Filtration ℝ≥0 m} {X : ℝ≥0 → Ω → E}
    (hX : StronglyAdapted F X) (hc : ∀ ω, IsCadlag (X · ω)) :
    StronglyMeasurable[F.optional] (Function.uncurry X) := by
  borelize E
  have hprog : IsStronglyProgressive F X :=
    hX.isStronglyProgressive_of_isRightContinuous fun ω ↦ (hc ω).isRightContinuous
  have hsep : IsSeparable (⋃ n : ℕ, range fun p : Iic (n : ℝ≥0) × Ω ↦ X p.1 p.2) :=
    .iUnion fun n ↦ (hprog n).isSeparable_range
  refine stronglyMeasurable_iff_measurable_separable.mpr
    ⟨hX.measurable_optional_of_isCadlag hc, hsep.mono ?_⟩
  rintro _ ⟨⟨t, ω⟩, rfl⟩
  obtain ⟨n, hn⟩ := exists_nat_ge t
  exact mem_iUnion.mpr ⟨n, ⟨⟨t, hn⟩, ω⟩, rfl⟩

end MeasureTheory

end RayGeneration
