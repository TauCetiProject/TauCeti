module

public import Mathlib.Probability.Process.Stopping
import TauCeti.Probability.Process.StochasticInterval
import TauCeti.Probability.Process.Stopping

/-!
# The stopping-time ray sigma algebra

For any filtration `F` on a preordered time index, `MeasureTheory.Filtration.rayMeasurableSpace F`
is the σ-algebra on `ι × Ω` generated by closed stopping-time rays `{(t, ω) | τ ω ≤ t}`. We provide
its generator membership lemma (`MeasureTheory.Filtration.measurableSet_rayMeasurableSpace`) and
universal property (`MeasureTheory.Filtration.rayMeasurableSpace_le_iff`), and show that on any
linearly ordered time index it coincides with the σ-algebra generated by half-open stochastic
intervals `[σ, τ)` (`MeasureTheory.Filtration.rayMeasurableSpace_eq_generateFrom_Ico`).

## References

* C. Dellacherie and P.-A. Meyer, *Probabilities and Potential*, Chapter IV, Theorem 64.
-/

public section

namespace MeasureTheory.Filtration

variable {ι Ω : Type*} {m : MeasurableSpace Ω}

/-- The σ-algebra on `ι × Ω` generated by closed stopping-time rays `{(t, ω) | τ ω ≤ t}`
for stopping times `τ` of `F`. -/
@[instance_reducible]
def rayMeasurableSpace [Preorder ι] (F : Filtration ι m) : MeasurableSpace (ι × Ω) :=
  MeasurableSpace.generateFrom
    {s : Set (ι × Ω) | ∃ τ : Ω → WithTop ι, IsStoppingTime F τ ∧ s = {p | τ p.2 ≤ p.1}}

/-- Every closed stopping-time ray `[τ, ∞)` is measurable for `F.rayMeasurableSpace`. -/
theorem measurableSet_rayMeasurableSpace [Preorder ι] (F : Filtration ι m)
    {τ : Ω → WithTop ι} (hτ : IsStoppingTime F τ) :
    MeasurableSet[F.rayMeasurableSpace] {p : ι × Ω | τ p.2 ≤ p.1} :=
  MeasurableSpace.measurableSet_generateFrom ⟨τ, hτ, rfl⟩

/-- `F.rayMeasurableSpace` is the coarsest σ-algebra in which every closed stopping-time
ray is measurable. -/
theorem rayMeasurableSpace_le_iff [Preorder ι] (F : Filtration ι m)
    {m' : MeasurableSpace (ι × Ω)} :
    F.rayMeasurableSpace ≤ m' ↔
      ∀ τ : Ω → WithTop ι, IsStoppingTime F τ → MeasurableSet[m'] {p : ι × Ω | τ p.2 ≤ p.1} := by
  constructor
  · intro h τ hτ
    exact h _ (F.measurableSet_rayMeasurableSpace hτ)
  · intro h
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨τ, hτ, rfl⟩
    exact h τ hτ

/-- On an arbitrary filtration over a linearly ordered time index, `F.rayMeasurableSpace`
equals the σ-algebra generated by half-open stochastic intervals `[σ, τ)`. -/
theorem rayMeasurableSpace_eq_generateFrom_Ico [LinearOrder ι] (F : Filtration ι m) :
    F.rayMeasurableSpace =
      MeasurableSpace.generateFrom
        {s : Set (ι × Ω) | ∃ σ τ : Ω → WithTop ι, IsStoppingTime F σ ∧ IsStoppingTime F τ ∧
          s = {p | σ p.2 ≤ p.1 ∧ (p.1 : WithTop ι) < τ p.2}} := by
  apply le_antisymm
  · refine F.rayMeasurableSpace_le_iff.mpr fun σ hσ ↦ ?_
    have heq : {p : ι × Ω | σ p.2 ≤ p.1} =
        {p | σ p.2 ≤ p.1 ∧ (p.1 : WithTop ι) < (fun _ : Ω ↦ (⊤ : WithTop ι)) p.2} := by
      ext p
      simp only [Set.mem_ofPred_eq, iff_self_and]
      exact fun _ ↦ WithTop.coe_lt_top p.1
    rw [heq]
    exact MeasurableSpace.measurableSet_generateFrom ⟨σ, _, hσ, isStoppingTime_top F, rfl⟩
  · refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨σ, τ, hσ, hτ, rfl⟩
    rw [TauCeti.stochasticIco_eq_sdiff]
    exact (F.measurableSet_rayMeasurableSpace hσ).diff (F.measurableSet_rayMeasurableSpace hτ)

end MeasureTheory.Filtration
