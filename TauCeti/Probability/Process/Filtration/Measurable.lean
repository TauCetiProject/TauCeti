module

public import Mathlib.Probability.Process.Adapted
import Mathlib.Topology.Instances.Discrete

/-!
# Natural filtrations of measurable processes

The history of a process up to time `i` is generated by its observations at times `j ≤ i`.
`MeasureTheory.Filtration.naturalOfMeasurable` constructs that history from the measurable
spaces of the observations, so it applies directly to measurably adapted Markov chains.
With a compatible metrizable Borel topology, the construction agrees with Mathlib's
`MeasureTheory.Filtration.natural`.
-/

public section

namespace MeasureTheory.Filtration

open TopologicalSpace

variable {Ω ι : Type*} {m : MeasurableSpace Ω} [Preorder ι]
  {β : ι → Type*} [∀ i, MeasurableSpace (β i)]

/-- The filtration generated by the observations of a measurable process up to each time. -/
def naturalOfMeasurable (X : (i : ι) → Ω → β i) (hX : ∀ i, Measurable (X i)) :
    Filtration ι m where
  seq i := ⨆ j ≤ i, MeasurableSpace.comap (X j) inferInstance
  mono' _ _ hij := biSup_mono fun _ h => h.trans hij
  le' _ := iSup₂_le fun j _ => (hX j).comap_le

/-- At time `i`, the natural filtration is the supremum of the observation σ-algebras
through time `i`. -/
theorem naturalOfMeasurable_apply (X : (i : ι) → Ω → β i) (hX : ∀ i, Measurable (X i))
    (i : ι) : naturalOfMeasurable X hX i = ⨆ j ≤ i, MeasurableSpace.comap (X j) inferInstance :=
  (rfl)

/-- The natural filtration is contained in a filtration exactly when the process is adapted
to that filtration. -/
theorem naturalOfMeasurable_le_iff (X : (i : ι) → Ω → β i) (hX : ∀ i, Measurable (X i))
    (ℱ : Filtration ι m) : naturalOfMeasurable X hX ≤ ℱ ↔ Adapted ℱ X := by
  constructor
  · intro h i
    exact measurable_iff_comap_le.2 <| calc
      MeasurableSpace.comap (X i) _ ≤ naturalOfMeasurable X hX i := by
        rw [naturalOfMeasurable_apply]
        exact le_iSup₂_of_le i le_rfl le_rfl
      _ ≤ ℱ i := h i
  · intro h i
    rw [naturalOfMeasurable_apply]
    exact iSup₂_le fun j hji => (h j).comap_le.trans (ℱ.mono hji)

/-- Mathlib's natural filtration for strongly measurable observations agrees with the
filtration generated by those observations as measurable maps. -/
theorem natural_eq_naturalOfMeasurable [∀ i, TopologicalSpace (β i)]
    [∀ i, MetrizableSpace (β i)] [∀ i, BorelSpace (β i)]
    (X : (i : ι) → Ω → β i) (hX : ∀ i, StronglyMeasurable (X i)) :
    natural X hX = naturalOfMeasurable X (fun i => (hX i).measurable) := by
  exact Filtration.ext (by funext i; rfl)

section Countable

variable {S : Type*} [MeasurableSpace S] [Countable S] [MeasurableSingletonClass S]

private local instance countableStateTopology : TopologicalSpace S := ⊥

private local instance countableStateDiscrete : DiscreteTopology S := discreteTopology_bot S

private local instance countableStateBorel : BorelSpace S :=
  ⟨(eq_top_iff.2 fun s _ => s.to_countable.measurableSet).trans borel_eq_top_of_discrete.symm⟩

-- A countable state space with measurable singletons realizes this filtration with its
-- discrete Borel topology. The instances are local to this comparison.
example (X : ι → Ω → S) (hX : ∀ i, Measurable (X i)) :
    natural X (fun i => (hX i).stronglyMeasurable) = naturalOfMeasurable X hX :=
  natural_eq_naturalOfMeasurable _ _

end Countable

end MeasureTheory.Filtration
