module

public import Mathlib.MeasureTheory.Constructions.Cylinders
public import Mathlib.MeasureTheory.Group.Arithmetic
public import Mathlib.Topology.Constructions

/-!
# Subshifts over a group action on an index set

A group `Γ` acting on an index set `I` acts on configurations `I → S` by
`(g • ω) i = ω (g⁻¹ • i)`. A *subshift* is a set of configurations that is closed for the product
topology and invariant under this action. It is used as the type of its configurations, with the
subspace topology, the trace of the product σ-algebra and the restricted action of `Γ`.

Mathlib's `SymbolicDynamics.FullShift.MulSubshift` is the case `I = Γ`, with `Γ` acting on
itself by left multiplication; `TauCeti.Subshift` allows an index set with several orbits, such
as the edges of a periodic graph.

## Main definitions

* `TauCeti.Subshift Γ I S`: closed `Γ`-invariant sets of configurations `I → S`.
* `TauCeti.Subshift.exterior X Λ`: the exterior σ-algebra `𝓕_{Λᶜ}` on `X`, the trace of the
  σ-algebra generated by the coordinates outside `Λ`.

The action of `Γ` on a subshift is measurable for the trace σ-algebra
(`MeasurableConstSMul Γ X`), and the exterior σ-algebras lie below the trace σ-algebra
(`TauCeti.Subshift.exterior_le`).

Subshifts are the configuration spaces of specifications and Gibbs measures
(`TauCeti.Specification`): a specification resamples a configuration inside a finite set `Λ`
given its values outside `Λ`, measurably for the exterior σ-algebra `𝓕_{Λᶜ}`.
-/

public section

open MeasureTheory

namespace TauCeti

/-- A subshift: a set of configurations `I → S` that is closed for the product topology and
invariant under the action `(g • ω) i = ω (g⁻¹ • i)` of `Γ` induced by an action on the index
set `I`. -/
structure Subshift (Γ I S : Type*) [Group Γ] [MulAction Γ I] [TopologicalSpace S] where
  /-- The configurations. -/
  carrier : Set (I → S)
  /-- The set of configurations is closed for the product topology. -/
  isClosed : IsClosed carrier
  /-- The set of configurations is invariant under the action. -/
  smul_mem' : ∀ (g : Γ) {ω : I → S}, ω ∈ carrier → (fun i => ω (g⁻¹ • i)) ∈ carrier

namespace Subshift

variable {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S]

/-- A subshift is a set of configurations. -/
instance instSetLike : SetLike (Subshift Γ I S) (I → S) where
  coe := carrier
  coe_injective X Y h := by cases X; cases Y; congr

/-- Membership in the carrier of a subshift. -/
@[simp]
theorem mem_carrier {X : Subshift Γ I S} {ω : I → S} : ω ∈ X.carrier ↔ ω ∈ X :=
  Iff.rfl

/-- Two subshifts with the same configurations are equal. -/
@[ext]
theorem ext {X Y : Subshift Γ I S} (h : ∀ ω, ω ∈ X ↔ ω ∈ Y) : X = Y :=
  SetLike.ext h

variable (X : Subshift Γ I S)

/-- A subshift contains `i ↦ ω (g⁻¹ • i)` whenever it contains `ω`. -/
theorem smul_mem (g : Γ) {ω : I → S} (hω : ω ∈ X) : (fun i => ω (g⁻¹ • i)) ∈ X :=
  X.smul_mem' g hω

/-- `Γ` acts on a subshift by `(g • ω) i = ω (g⁻¹ • i)`. -/
instance instSMul : SMul Γ X where
  smul g ω := ⟨fun i => ω.val (g⁻¹ • i), X.smul_mem g ω.property⟩

/-- The coordinates of `g • ω`. -/
@[simp]
theorem coe_smul_apply (g : Γ) (ω : X) (i : I) : (g • ω : X).val i = ω.val (g⁻¹ • i) :=
  rfl

/-- The action of `Γ` on a subshift is a group action. -/
instance instMulAction : MulAction Γ X where
  one_smul ω := Subtype.ext <| funext fun i => by simp
  mul_smul g h ω := Subtype.ext <| funext fun i => by simp [mul_smul]

variable [MeasurableSpace S]

/-- Each `ω ↦ g • ω` is measurable for the trace of the product σ-algebra: each coordinate of
`g • ω` is a coordinate of `ω`. -/
instance instMeasurableConstSMul : MeasurableConstSMul Γ X where
  measurable_const_smul g :=
    Measurable.subtype_mk (f := fun ω : X => fun i => ω.val (g⁻¹ • i)) <|
      .of_eval fun i => (measurable_pi_apply (g⁻¹ • i)).comp measurable_subtypeVal

/-- The exterior σ-algebra `𝓕_{Λᶜ}` on a subshift: the trace of the σ-algebra
`MeasureTheory.cylinderEvents Λᶜ` generated by the coordinates outside `Λ`. -/
abbrev exterior (Λ : Set I) : MeasurableSpace X :=
  MeasurableSpace.comap Subtype.val (cylinderEvents (X := fun _ : I => S) Λᶜ)

/-- The exterior σ-algebras lie below the trace of the product σ-algebra. -/
theorem exterior_le (Λ : Set I) : X.exterior Λ ≤ Subtype.instMeasurableSpace :=
  MeasurableSpace.comap_mono cylinderEvents_le_pi

end Subshift

end TauCeti
