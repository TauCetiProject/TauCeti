module

public import Mathlib.Probability.BrownianMotion.Basic
public import TauCeti.Probability.Distributions.Gaussian.Hermite.Pi.Basis

import Mathlib.MeasureTheory.Function.FactorsThrough

/-!
# Hermite expansions of Brownian increment claims

The increments on a strictly increasing finite time grid, divided by the square roots of their
interval lengths, have the product standard Gaussian law. Pullback along this vector gives an
isometry from Gaussian `L²` into the original probability space. The images of
`TauCeti.gaussianHermitePiBasis` are the explicit products of normalized Hermite polynomials of
these increments. They are orthonormal, and every claim in the isometry's range has a convergent
`L²` expansion in them. Every square-integrable claim measurable for the sigma algebra
generated by the increment vector belongs to this range.

This is a finite-grid expansion, not a martingale representation theorem. For a grid beginning
at a positive time, its range describes functions of the increments and need not contain the
initial observation. Literal measurability of the finitely many observations is required only
for the pullback construction; the joint-law theorem needs just the native pre-Brownian law.
Empty grids are allowed.

The construction uses the existing product Gaussian Hermite basis, rather than rebuilding its
orthogonality or completeness. The finite-dimensional Gaussian expansion underlying Brownian
martingale representation is described in Karatzas and Shreve, *Brownian Motion and Stochastic
Calculus*, second edition, §3.4.
-/

public section

open MeasureTheory ProbabilityTheory Polynomial Filter
open scoped NNReal ENNReal

namespace TauCeti

variable {Ω : Type*} {B : ℝ≥0 → Ω → ℝ}
  {n : ℕ} {t : Fin (n + 1) → ℝ≥0}

/-- The vector of Brownian increments standardized by their interval lengths. -/
noncomputable def normalizedBrownianIncrements (B : ℝ≥0 → Ω → ℝ) (t : Fin (n + 1) → ℝ≥0)
    (ω : Ω) (i : Fin n) : ℝ :=
  (B (t i.succ) ω - B (t i.castSucc) ω) /
    Real.sqrt ((t i.succ : ℝ) - t i.castSucc)

/-- Evaluation of a standardized increment. -/
@[simp]
theorem normalizedBrownianIncrements_apply (ω : Ω) (i : Fin n) :
    normalizedBrownianIncrements B t ω i =
      (B (t i.succ) ω - B (t i.castSucc) ω) /
        Real.sqrt ((t i.succ : ℝ) - t i.castSucc) := (rfl)

end TauCeti

namespace ProbabilityTheory.IsPreBrownianReal

open TauCeti

variable {Ω : Type*} [MeasurableSpace Ω] {B : ℝ≥0 → Ω → ℝ} {P : Measure Ω}
  {n : ℕ} {t : Fin (n + 1) → ℝ≥0}

/-- Standardized increments on a strictly increasing grid have independent standard Gaussian
coordinates. No path regularity or filtration assumption is needed. -/
theorem hasLaw_normalizedBrownianIncrements (hB : IsPreBrownianReal B P) (ht : StrictMono t) :
    HasLaw (normalizedBrownianIncrements B t)
      (Measure.pi fun _ : Fin n => gaussianReal 0 1) P := by
  have hind := (hB.hasIndepIncrements n t ht.monotone).comp
    (fun i x => x / Real.sqrt ((t i.succ : ℝ) - t i.castSucc)) (by fun_prop)
  apply hind.hasLaw_pi
  intro i
  have hlt : (t i.castSucc : ℝ) < t i.succ := ht Fin.castSucc_lt_succ
  have hvar : nndist (t i.succ : ℝ) (t i.castSucc : ℝ) /
      NNReal.mk (Real.sqrt ((t i.succ : ℝ) - t i.castSucc) ^ 2) (sq_nonneg _) =
        (1 : ℝ≥0) := by
    apply NNReal.coe_injective
    simp only [NNReal.coe_div, NNReal.coe_mk, NNReal.coe_one, coe_nndist, Real.dist_eq,
      abs_of_pos (sub_pos.mpr hlt), Real.sq_sqrt (sub_nonneg.mpr hlt.le),
      div_self (sub_ne_zero.mpr hlt.ne')]
  -- Gaussian scaling currently uses the underlying subtype constructor for its variance.
  -- `convert!` reconciles that constructor with `NNReal.mk` without changing the law.
  convert! gaussianReal_div_const (hB.hasLaw_sub (t i.succ) (t i.castSucc))
    (Real.sqrt ((t i.succ : ℝ) - t i.castSucc)) using 1
  exact congrArg₂ gaussianReal (zero_div _).symm hvar.symm

/-- Pullback from Gaussian `L²` along a finite standardized Brownian increment vector.
Its image consists of increment-dependent claims, not all claims on the original space. -/
noncomputable def brownianIncrementL2Isometry (hB : IsPreBrownianReal B P) (ht : StrictMono t)
    (hmeas : ∀ i, Measurable (B (t i))) :
    Lp ℝ 2 (Measure.pi fun _ : Fin n => gaussianReal 0 1) →ₗᵢ[ℝ] Lp ℝ 2 P :=
  Lp.compMeasurePreservingₗᵢ ℝ (normalizedBrownianIncrements B t)
    ((hB.hasLaw_normalizedBrownianIncrements ht).measurePreserving
      (Measurable.of_eval fun i => ((hmeas i.succ).sub (hmeas i.castSucc)).div_const _))

/-- The pullback acts by composition on representatives. -/
theorem coeFn_brownianIncrementL2Isometry (hB : IsPreBrownianReal B P) (ht : StrictMono t)
    (hmeas : ∀ i, Measurable (B (t i)))
    (f : Lp ℝ 2 (Measure.pi fun _ : Fin n => gaussianReal 0 1)) :
    ⇑(brownianIncrementL2Isometry hB ht hmeas f) =ᵐ[P]
      fun ω => f (normalizedBrownianIncrements B t ω) :=
  Lp.coeFn_compMeasurePreserving _ _

/-- Every square-integrable claim measurable for the sigma algebra generated by the
standardized increment vector is in the pullback's range. -/
theorem exists_brownianIncrementL2Isometry_eq (hB : IsPreBrownianReal B P) (ht : StrictMono t)
    (hmeas : ∀ i, Measurable (B (t i))) {g : Ω → ℝ}
    (hg : StronglyMeasurable[MeasurableSpace.comap (normalizedBrownianIncrements B t)
      inferInstance] g) (hgLp : MemLp g 2 P) :
    ∃ f : Lp ℝ 2 (Measure.pi fun _ : Fin n => gaussianReal 0 1),
      brownianIncrementL2Isometry hB ht hmeas f = hgLp.toLp g := by
  obtain ⟨f, hf, hgf⟩ := hg.exists_eq_measurable_comp
  have hlaw := hB.hasLaw_normalizedBrownianIncrements ht
  have hfLp : MemLp f 2 (Measure.pi fun _ : Fin n => gaussianReal 0 1) := by
    rw [← hlaw.map_eq]
    exact (memLp_map_measure_iff hf.aestronglyMeasurable hlaw.aemeasurable).2
      (hgf ▸ hgLp)
  refine ⟨hfLp.toLp f, ?_⟩
  apply Lp.ext
  have hmp := hlaw.measurePreserving
    (Measurable.of_eval fun i => ((hmeas i.succ).sub (hmeas i.castSucc)).div_const _)
  filter_upwards [coeFn_brownianIncrementL2Isometry hB ht hmeas (hfLp.toLp f),
    hmp.quasiMeasurePreserving.ae_eq_comp hfLp.coeFn_toLp,
    hgLp.coeFn_toLp] with ω h₁ h₂ h₃
  exact h₁.trans (h₂.trans ((congrFun hgf ω).symm.trans h₃.symm))

/-- The Hermite product associated with a finite Brownian grid, as an `L²` class. -/
noncomputable def brownianIncrementHermite (hB : IsPreBrownianReal B P) (ht : StrictMono t)
    (hmeas : ∀ i, Measurable (B (t i))) (a : Fin n → ℕ) : Lp ℝ 2 P :=
  brownianIncrementL2Isometry hB ht hmeas (gaussianHermitePiBasis ℝ (Fin n) a)

/-- Pulling back a Gaussian Hermite basis vector gives the Brownian Hermite vector. -/
theorem brownianIncrementL2Isometry_gaussianHermitePiBasis (hB : IsPreBrownianReal B P)
    (ht : StrictMono t) (hmeas : ∀ i, Measurable (B (t i))) (a : Fin n → ℕ) :
    brownianIncrementL2Isometry hB ht hmeas (gaussianHermitePiBasis ℝ (Fin n) a) =
      brownianIncrementHermite hB ht hmeas a := (rfl)

/-- The pulled-back Hermite vectors are the normalized Hermite polynomials of the actual
increments, simultaneously in all coordinates outside one null set. -/
theorem coeFn_brownianIncrementHermite (hB : IsPreBrownianReal B P) (ht : StrictMono t)
    (hmeas : ∀ i, Measurable (B (t i))) (a : Fin n → ℕ) :
    ⇑(brownianIncrementHermite hB ht hmeas a) =ᵐ[P] fun ω =>
      ∏ i, aeval (normalizedBrownianIncrements B t ω i) (hermite (a i)) /
        Real.sqrt ((a i).factorial : ℝ) := by
  have hmp := (hB.hasLaw_normalizedBrownianIncrements ht).measurePreserving
    (Measurable.of_eval fun i => ((hmeas i.succ).sub (hmeas i.castSucc)).div_const _)
  refine (coeFn_brownianIncrementL2Isometry hB ht hmeas _).trans ?_
  simpa only [Function.comp_def, Algebra.algebraMap_self, RingHom.id_apply] using
    hmp.quasiMeasurePreserving.ae_eq_comp (coeFn_gaussianHermitePiBasis ℝ (Fin n) a)

/-- Products of normalized Hermite polynomials of disjoint standardized Brownian increments
form an orthonormal family in the original probability space. -/
theorem orthonormal_brownianIncrementHermite (hB : IsPreBrownianReal B P) (ht : StrictMono t)
    (hmeas : ∀ i, Measurable (B (t i))) :
    Orthonormal ℝ (brownianIncrementHermite hB ht hmeas) := by
  convert (gaussianHermitePiBasis ℝ (Fin n)).orthonormal.comp_linearIsometry
    (brownianIncrementL2Isometry hB ht hmeas) using 1
  rfl

/-- Hermite coefficients can be computed in the original probability space, as expectations
against the increment Hermite products. -/
theorem gaussianHermitePiBasis_repr_eq_integral_brownianIncrementHermite
    (hB : IsPreBrownianReal B P) (ht : StrictMono t) (hmeas : ∀ i, Measurable (B (t i)))
    (f : Lp ℝ 2 (Measure.pi fun _ : Fin n => gaussianReal 0 1)) (a : Fin n → ℕ) :
    (gaussianHermitePiBasis ℝ (Fin n)).repr f a =
      ∫ ω, brownianIncrementHermite hB ht hmeas a ω *
        brownianIncrementL2Isometry hB ht hmeas f ω ∂P := by
  rw [(gaussianHermitePiBasis ℝ (Fin n)).repr_apply_apply,
    ← (brownianIncrementL2Isometry hB ht hmeas).inner_map_map,
    brownianIncrementL2Isometry_gaussianHermitePiBasis, L2.inner_def]
  simp only [RCLike.inner_apply, conj_trivial, mul_comm]

/-- Every square-integrable function of the standardized increment vector has its Hermite
expansion converging in `L²` on the original probability space. Its coefficients are computed
under the original measure, not under an auxiliary Gaussian probability space. -/
theorem hasSum_brownianIncrementHermite (hB : IsPreBrownianReal B P) (ht : StrictMono t)
    (hmeas : ∀ i, Measurable (B (t i)))
    (f : Lp ℝ 2 (Measure.pi fun _ : Fin n => gaussianReal 0 1)) :
    HasSum (fun a => (∫ ω, brownianIncrementHermite hB ht hmeas a ω *
      brownianIncrementL2Isometry hB ht hmeas f ω ∂P) •
        brownianIncrementHermite hB ht hmeas a)
      (brownianIncrementL2Isometry hB ht hmeas f) := by
  simpa only [map_smul, LinearIsometry.coe_toContinuousLinearMap,
    brownianIncrementL2Isometry_gaussianHermitePiBasis,
    gaussianHermitePiBasis_repr_eq_integral_brownianIncrementHermite hB ht hmeas] using
    (brownianIncrementL2Isometry hB ht hmeas).toContinuousLinearMap.hasSum
      ((gaussianHermitePiBasis ℝ (Fin n)).hasSum_repr f)

end ProbabilityTheory.IsPreBrownianReal
