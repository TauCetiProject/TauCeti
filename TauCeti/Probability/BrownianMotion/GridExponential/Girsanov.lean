module

public import TauCeti.Probability.BrownianMotion.GridExponential.Basic
import TauCeti.Probability.Distributions.Gaussian.Conditional.ChangeOfMeasure

/-!
# Girsanov's theorem at trading-grid dates

Under the terminal density `gridExponential τ θ W n`, each increment
`W (τ (j+1)) - W (τ j) - (τ (j+1) - τ j) * θ j`, for `j < n`, is centered
Gaussian and independent of the original filtration at `τ j`. The heights may be
unbounded random variables known at the left endpoints; no moment assumption is needed.
The same terminal measure governs every increment: later likelihood factors do not
change events already known at an earlier grid date.

These are finite-grid change-of-law identities, not a continuous-time Brownian
conclusion. They provide the increment laws and filtration-relative independence
needed when passing elementary drift changes to a continuous-time limit.
Only dates through `n` must be nondecreasing, and only heights before `n` must
be measurable at their left endpoints. Dates may repeat and need not start at zero.

The proof iterates the one-step random-drift Gaussian change of law in
`Gaussian.Conditional.ChangeOfMeasure`.

## References

* I. Karatzas and S. E. Shreve, *Brownian Motion and Stochastic Calculus*, second
  edition, Springer, 1991, §3.5.
-/

public section

noncomputable section

open MeasureTheory ProbabilityTheory Real Set
open scoped NNReal ENNReal

namespace TauCeti.Probability.IsFilteredPreBrownianReal

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}
  {ℱ : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ}
  {τ : ℕ → ℝ≥0} {θ : ℕ → Ω → ℝ}

private theorem withDensity_gridExponential_succ_inter_preimage
    (hW : IsFilteredPreBrownianReal ℱ W P) {j : ℕ}
    (hτ : MonotoneOn τ (Iic (j + 1))) (hθ : ∀ i < j + 1, Measurable[ℱ (τ i)] (θ i))
    {A : Set Ω} (hA : MeasurableSet[ℱ (τ j)] A) {B : Set ℝ} (hB : MeasurableSet B) :
    P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W (j + 1) ω))
        (A ∩ (fun ω ↦ W (τ (j + 1)) ω - W (τ j) ω -
          ((τ (j + 1) : ℝ) - τ j) * θ j ω) ⁻¹' B) =
      P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W j ω)) A *
        gaussianReal 0 (τ (j + 1) - τ j) B := by
  have hj : τ j ≤ τ (j + 1) := hτ (Nat.le_succ j) (mem_Iic.mpr le_rfl) (Nat.le_succ j)
  have hw := hW.adapted.measurable_gridExponential (hτ.mono (Iic_subset_Iic.mpr (Nat.le_succ j)))
    (fun i hi ↦ hθ i (hi.trans (Nat.lt_succ_self j)))
  have h := withDensity_exp_mul_inter_preimage_of_indep_gaussian (ℱ.le _)
    (hθ j (Nat.lt_succ_self j)) hw.ennreal_ofReal (hW.indep_sub hj) (hW.hasLaw_sub_of_le hj) hA hB
  simp only [NNReal.coe_sub hj, Pi.sub_apply] at h
  convert h using 1
  congr 1
  apply withDensity_congr_ae
  filter_upwards [] with ω
  rw [gridExponential_succ, ENNReal.ofReal_mul (gridExponential_pos τ θ W j ω).le,
    mul_comm]
  congr 3; ring

/-- A terminal grid density restricts at an earlier grid date to the corresponding
partial density, without boundedness or integrability assumptions on the heights.
This identity holds for every event of the original filtration, not just events
generated by the sampled Brownian values. -/
theorem withDensity_gridExponential_apply (hW : IsFilteredPreBrownianReal ℱ W P)
    {k n : ℕ} (hτ : MonotoneOn τ (Iic n)) (hθ : ∀ j < n, Measurable[ℱ (τ j)] (θ j))
    (hkn : k ≤ n)
    {A : Set Ω} (hA : MeasurableSet[ℱ (τ k)] A) :
    P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W n ω)) A =
      P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W k ω)) A := by
  induction n, hkn using Nat.le_induction with
  | base => rfl
  | succ n hkn ih =>
    have h := withDensity_gridExponential_succ_inter_preimage hW hτ hθ
      ((ℱ.mono (hτ (hkn.trans (Nat.le_succ n)) (Nat.le_succ n) hkn)) _ hA)
      (B := univ) MeasurableSet.univ
    simp only [preimage_univ, inter_univ, measure_univ, mul_one] at h
    exact h.trans (ih (hτ.mono (Iic_subset_Iic.mpr (Nat.le_succ n)))
      (fun i hi ↦ hθ i (hi.trans (Nat.lt_succ_self n))))

/-- A finite grid likelihood defines a probability measure even for unbounded
predictable heights. No moment assumption on the heights is required. -/
theorem isProbabilityMeasure_withDensity_gridExponential
    (hW : IsFilteredPreBrownianReal ℱ W P) {n : ℕ}
    (hτ : MonotoneOn τ (Iic n)) (hθ : ∀ j < n, Measurable[ℱ (τ j)] (θ j)) :
    IsProbabilityMeasure
      (P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W n ω))) := by
  have := (hW.hasLaw_eval 0).isProbabilityMeasure
  constructor
  rw [hW.withDensity_gridExponential_apply hτ hθ (Nat.zero_le n) MeasurableSet.univ]
  simp

/-- **Finite-grid Girsanov identity.** Under the terminal likelihood, a corrected
increment and any event known at its left endpoint factor with the centered
Gaussian law of variance `τ (j+1) - τ j`. Later random drift heights do not alter
this law or its independence from the past. -/
theorem withDensity_gridExponential_inter_preimage (hW : IsFilteredPreBrownianReal ℱ W P)
    {j n : ℕ} (hτ : MonotoneOn τ (Iic n)) (hθ : ∀ i < n, Measurable[ℱ (τ i)] (θ i))
    (hjn : j < n)
    {A : Set Ω} (hA : MeasurableSet[ℱ (τ j)] A) {B : Set ℝ} (hB : MeasurableSet B) :
    P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W n ω))
        (A ∩ (fun ω ↦ W (τ (j + 1)) ω - W (τ j) ω -
          ((τ (j + 1) : ℝ) - τ j) * θ j ω) ⁻¹' B) =
      P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W n ω)) A *
        gaussianReal 0 (τ (j + 1) - τ j) B := by
  have hj : τ j ≤ τ (j + 1) := hτ hjn.le hjn (Nat.le_succ j)
  have hD : Measurable[ℱ (τ (j + 1))] (fun ω ↦
      W (τ (j + 1)) ω - W (τ j) ω - ((τ (j + 1) : ℝ) - τ j) * θ j ω) :=
    ((hW.adapted _).sub ((hW.adapted _).mono (ℱ.mono hj) le_rfl)).sub
      (((hθ j hjn).mono (ℱ.mono hj) le_rfl).const_mul _)
  rw [hW.withDensity_gridExponential_apply hτ hθ hjn
      (((ℱ.mono hj) _ hA).inter (hD hB)),
    hW.withDensity_gridExponential_apply hτ hθ hjn.le hA]
  exact withDensity_gridExponential_succ_inter_preimage hW (hτ.mono (Iic_subset_Iic.mpr hjn))
    (fun i hi ↦ hθ i (hi.trans_le hjn)) hA hB

/-- Each drift-corrected grid increment has its original centered Gaussian law
under the single terminal grid density, including intervals of length zero. -/
theorem hasLaw_sub_drift_withDensity_gridExponential (hW : IsFilteredPreBrownianReal ℱ W P)
    {j n : ℕ} (hτ : MonotoneOn τ (Iic n)) (hθ : ∀ i < n, Measurable[ℱ (τ i)] (θ i))
    (hjn : j < n) :
    HasLaw (fun ω ↦ W (τ (j + 1)) ω - W (τ j) ω -
      ((τ (j + 1) : ℝ) - τ j) * θ j ω) (gaussianReal 0 (τ (j + 1) - τ j))
      (P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W n ω))) := by
  have := hW.isProbabilityMeasure_withDensity_gridExponential hτ hθ
  have hD : Measurable (fun ω ↦ W (τ (j + 1)) ω - W (τ j) ω -
      ((τ (j + 1) : ℝ) - τ j) * θ j ω) :=
    (hW.adapted.measurable.sub hW.adapted.measurable).sub
      (((hθ j hjn).mono (ℱ.le _) le_rfl).const_mul _)
  refine ⟨hD.aemeasurable, Measure.ext fun B hB ↦ ?_⟩
  rw [Measure.map_apply hD hB]
  simpa only [univ_inter, measure_univ, one_mul] using
    hW.withDensity_gridExponential_inter_preimage hτ hθ hjn MeasurableSet.univ hB

/-- The corrected increment is independent of the full original past sigma algebra
under the terminal density. Random predictable drift does not merely give a
vanishing covariance: it preserves this stronger conditional-law statement. -/
theorem indep_sub_drift_withDensity_gridExponential (hW : IsFilteredPreBrownianReal ℱ W P)
    {j n : ℕ} (hτ : MonotoneOn τ (Iic n)) (hθ : ∀ i < n, Measurable[ℱ (τ i)] (θ i))
    (hjn : j < n) :
    Indep (.comap (fun ω ↦ W (τ (j + 1)) ω - W (τ j) ω -
      ((τ (j + 1) : ℝ) - τ j) * θ j ω) inferInstance) (ℱ (τ j))
      (P.withDensity (fun ω ↦ ENNReal.ofReal (gridExponential τ θ W n ω))) := by
  rw [Indep_iff]
  intro B A hB hA
  obtain ⟨B, hBmeas, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hB
  have h := hW.hasLaw_sub_drift_withDensity_gridExponential hτ hθ hjn
  rw [inter_comm, hW.withDensity_gridExponential_inter_preimage hτ hθ hjn hA hBmeas,
    ← h.map_eq, Measure.map_apply_of_aemeasurable h.aemeasurable hBmeas, mul_comm]

end TauCeti.Probability.IsFilteredPreBrownianReal
