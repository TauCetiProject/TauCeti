module

public import Mathlib.MeasureTheory.Measure.GiryMonad
public import Mathlib.MeasureTheory.Constructions.Projective

/-!
# Laws of random measures from evaluations

The law of a measurable random measure is determined by the joint laws of its evaluations
on finite families of measurable sets. The underlying measures need not be finite, locally
finite or integer-valued, and the two realizations may use different probability spaces.
Only one of the laws on the space of measures needs a finiteness assumption; the empty
finite-dimensional distribution forces their total masses to agree.

It suffices to test disjoint finite families: overlapping evaluations are sums of the
masses of the atoms of their finite Boolean partition. This form is useful for identifying
random measures specified by independent counts on disjoint sets.

We use Mathlib's evaluation measurable space on `Measure` and uniqueness of projective
limits, rather than imposing a topology on the configuration space. The corresponding
finite-evaluation argument for random probability measures is developed in
`TauCeti.MeasureTheory.Measure.ProbabilityMeasure.Ext`; here infinite masses are retained.

## References

* Günter Last and Mathew Penrose, *Lectures on the Poisson Process*, Cambridge University
  Press, 2018, Chapter 2 (distribution of a point process).
-/

public section

open MeasureTheory Set Function
open scoped ENNReal

namespace MeasureTheory.Measure

variable {X : Type*} [MeasurableSpace X]

/-- The measurable space on measures is induced by the joint evaluation map on all
measurable sets. -/
theorem measurableSpace_eq_comap_eval :
    (Measure.instMeasurableSpace : MeasurableSpace (Measure X)) =
      MeasurableSpace.comap
        (fun (μ : Measure X) (A : {A : Set X // MeasurableSet A}) ↦ μ A.val)
        MeasurableSpace.pi := by
  let e : Measure X → ({A : Set X // MeasurableSet A} → ℝ≥0∞) := fun μ A ↦ μ A.val
  apply le_antisymm
  · have hid : Measurable[MeasurableSpace.comap e inferInstance]
        (id : Measure X → Measure X) :=
      measurable_of_measurable_coe _ fun A hA ↦
        (measurable_pi_apply (⟨A, hA⟩ : {A : Set X // MeasurableSet A})).comp
          (comap_measurable e)
    simpa only [MeasurableSpace.comap_id] using hid.comap_le
  · exact (Measurable.of_eval fun A ↦ measurable_coe A.property).comap_le

/-- A measure-valued map generates the same measurable space as its joint evaluations
on all measurable sets. No measurability assumption on the map is needed. -/
theorem comap_eq_comap_eval {Ω : Type*} (N : Ω → Measure X) :
    MeasurableSpace.comap N inferInstance =
      MeasurableSpace.comap
        (fun ω (A : {A : Set X // MeasurableSet A}) ↦ N ω A.val)
        MeasurableSpace.pi := by
  rw [measurableSpace_eq_comap_eval, MeasurableSpace.comap_comp, Function.comp_def]

/-- Finite laws on the space of measures are determined by their finite-dimensional
measurable-set evaluations. The empty family records the total mass of the law. -/
theorem ext_of_forall_finset_map_eval_eq {Q Q' : Measure (Measure X)}
    [IsFiniteMeasure Q]
    (h : ∀ I : Finset {A : Set X // MeasurableSet A},
      Q.map (fun μ (A : I) ↦ μ A.val.val) =
        Q'.map (fun μ (A : I) ↦ μ A.val.val)) : Q = Q' := by
  let e : Measure X → ({A : Set X // MeasurableSet A} → ℝ≥0∞) := fun μ A ↦ μ A.val
  have he : Measurable e := Measurable.of_eval fun A ↦ measurable_coe A.property
  have hmaps : Q.map e = Q'.map e := by
    apply IsProjectiveLimit.unique
      (P := fun I ↦ Q.map (fun μ (A : I) ↦ μ A.val.val))
    · intro I
      rw [map_map (Finset.measurable_restrict I) he]
      rfl
    · intro I
      rw [map_map (Finset.measurable_restrict I) he]
      exact (h I).symm
  have hgen : (inferInstance : MeasurableSpace (Measure X)) =
      MeasurableSpace.comap e inferInstance := measurableSpace_eq_comap_eval
  ext B hB
  have hB' : MeasurableSet[MeasurableSpace.comap e inferInstance] B := hgen ▸ hB
  obtain ⟨C, hC, rfl⟩ := hB'
  simpa only [map_apply he hC] using congrArg (fun R ↦ R C) hmaps

/-- To determine a finite law on measures, it suffices to know the joint evaluations on
pairwise disjoint finite families. Infinite masses in the configurations are allowed. -/
theorem ext_of_forall_map_eval_eq_of_pairwise_disjoint {Q Q' : Measure (Measure X)}
    [IsFiniteMeasure Q]
    (h : ∀ (n : ℕ) (A : Fin n → Set X), (∀ i, MeasurableSet (A i)) →
      Pairwise (Disjoint on A) →
        Q.map (fun μ i ↦ μ (A i)) = Q'.map (fun μ i ↦ μ (A i))) : Q = Q' := by
  classical
  apply ext_of_forall_finset_map_eval_eq
  intro I
  -- The membership vector codes the atoms of the Boolean partition generated by `I`.
  let c : X → (I → Bool) := fun x A ↦ decide (x ∈ A.val.val)
  have hc : Measurable c := Measurable.of_eval fun A ↦ by
    simpa [c] using
      (measurable_const.ite A.val.property measurable_const :
        Measurable fun x ↦ if x ∈ A.val.val then true else false)
  let e := Fintype.equivFin (I → Bool)
  let C : Fin (Fintype.card (I → Bool)) → Set X := fun j ↦ c ⁻¹' {e.symm j}
  have hC (j) : MeasurableSet (C j) := hc (measurableSet_singleton _)
  have hd : Pairwise (Disjoint on C) := by
    intro i j hij
    exact (pairwise_disjoint_fiber c) (e.symm.injective.ne hij)
  let s : I → Finset (I → Bool) := fun A ↦ Finset.univ.filter fun b ↦ b A = true
  let Φ : (Fin (Fintype.card (I → Bool)) → ℝ≥0∞) → (I → ℝ≥0∞) :=
    fun v A ↦ ∑ b ∈ s A, v (e b)
  have hΦ : Measurable Φ := Measurable.of_eval fun A ↦
    Finset.measurable_fun_sum _ fun b _ ↦ measurable_pi_apply _
  have hev : Measurable (fun μ : Measure X ↦ fun j ↦ μ (C j)) :=
    Measurable.of_eval fun j ↦ measurable_coe (hC j)
  -- Each original set is the disjoint union of atoms whose corresponding bit is true.
  have hrecover : Φ ∘ (fun μ : Measure X ↦ fun j ↦ μ (C j)) =
      fun μ (A : I) ↦ μ A.val.val := by
    funext μ A
    dsimp [Φ, C]
    simp only [Equiv.symm_apply_apply]
    rw [sum_measure_preimage_singleton (s A) (fun b _ ↦ hc (measurableSet_singleton b))]
    congr 1
    ext x
    simp [s, c]
  have hmap := congrArg (fun R ↦ R.map Φ) (h _ C hC hd)
  simpa only [map_map hΦ hev, hrecover] using hmap

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
  {P : Measure Ω} {P' : Measure Ω'} {N : Ω → Measure X} {N' : Ω' → Measure X}

/-- Equality in law of random measures is equivalent to equality of all finite-dimensional
measurable-set evaluation laws, even on different sample spaces. -/
theorem map_eq_iff_forall_finset_map_eval_eq [IsFiniteMeasure P]
    (hN : AEMeasurable N P) (hN' : AEMeasurable N' P') :
    P.map N = P'.map N' ↔
      ∀ I : Finset {A : Set X // MeasurableSet A},
        P.map (fun ω (A : I) ↦ N ω A.val.val) =
          P'.map (fun ω (A : I) ↦ N' ω A.val.val) := by
  have hm (I : Finset {A : Set X // MeasurableSet A}) :
      Measurable (fun μ : Measure X ↦ fun A : I ↦ μ A.val.val) :=
    Measurable.of_eval fun A ↦ measurable_coe A.val.property
  constructor
  · intro h I
    simpa only [AEMeasurable.map_map_of_aemeasurable (hm I).aemeasurable hN,
      AEMeasurable.map_map_of_aemeasurable (hm I).aemeasurable hN', Function.comp_def]
      using congrArg (fun Q ↦ Q.map (fun μ (A : I) ↦ μ A.val.val)) h
  · intro h
    apply ext_of_forall_finset_map_eval_eq
    intro I
    simpa only [AEMeasurable.map_map_of_aemeasurable (hm I).aemeasurable hN,
      AEMeasurable.map_map_of_aemeasurable (hm I).aemeasurable hN', Function.comp_def] using h I

/-- Equality in law of random measures can be checked on disjoint finite families of
measurable sets. This identifies laws, not almost-sure equality of the realizations. -/
theorem map_eq_iff_forall_map_eval_eq_of_pairwise_disjoint [IsFiniteMeasure P]
    (hN : AEMeasurable N P) (hN' : AEMeasurable N' P') :
    P.map N = P'.map N' ↔
      ∀ (n : ℕ) (A : Fin n → Set X), (∀ i, MeasurableSet (A i)) →
        Pairwise (Disjoint on A) →
          P.map (fun ω i ↦ N ω (A i)) = P'.map (fun ω i ↦ N' ω (A i)) := by
  constructor
  · intro h n A hA _
    have hm : Measurable (fun μ : Measure X ↦ fun i ↦ μ (A i)) :=
      Measurable.of_eval fun i ↦ measurable_coe (hA i)
    simpa only [AEMeasurable.map_map_of_aemeasurable hm.aemeasurable hN,
      AEMeasurable.map_map_of_aemeasurable hm.aemeasurable hN', Function.comp_def]
      using congrArg (fun Q ↦ Q.map (fun μ i ↦ μ (A i))) h
  · intro h
    apply ext_of_forall_map_eval_eq_of_pairwise_disjoint
    intro n A hA hd
    have hm : Measurable (fun μ : Measure X ↦ fun i ↦ μ (A i)) :=
      Measurable.of_eval fun i ↦ measurable_coe (hA i)
    simpa only [AEMeasurable.map_map_of_aemeasurable hm.aemeasurable hN,
      AEMeasurable.map_map_of_aemeasurable hm.aemeasurable hN', Function.comp_def] using h n A hA hd

end MeasureTheory.Measure
