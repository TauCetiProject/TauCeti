module

public import Mathlib.Probability.Independence.Basic

/-!
# Independence under a pushforward

Two functions are independent under the pushforward of a measure along a map exactly
when their composites with that map are independent under the measure: the events generated by
the composites are the preimages of the events generated by the functions. All three maps need
only be almost everywhere measurable.

## Main results

* `ProbabilityTheory.indepFun_map_iff_comp`
-/

public section

open MeasureTheory

namespace ProbabilityTheory

variable {Ω Ω' β γ : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] [MeasurableSpace β]
  [MeasurableSpace γ] {μ : Measure Ω}

/-- Independence of two functions under a pushforward is independence of their composites. -/
theorem indepFun_map_iff_comp {m : Ω → Ω'} (hm : AEMeasurable m μ) {f : Ω' → β} {g : Ω' → γ}
    (hf : AEMeasurable f (μ.map m)) (hg : AEMeasurable g (μ.map m)) :
    IndepFun f g (μ.map m) ↔ IndepFun (f ∘ m) (g ∘ m) μ := by
  have hfm := ae_eq_comp hm hf.ae_eq_mk
  have hgm := ae_eq_comp hm hg.ae_eq_mk
  calc IndepFun f g (μ.map m) ↔ IndepFun (hf.mk f) (hg.mk g) (μ.map m) :=
        ⟨(·.congr hf.ae_eq_mk hg.ae_eq_mk), (·.congr hf.ae_eq_mk.symm hg.ae_eq_mk.symm)⟩
    _ ↔ IndepFun (hf.mk f ∘ m) (hg.mk g ∘ m) μ := by
      -- for measurable functions, the defining identities coincide set by set
      simp only [indepFun_iff_measure_inter_preimage_eq_mul]
      refine forall₄_congr fun s t hs ht ↦ ?_
      rw [Measure.map_apply_of_aemeasurable hm (hf.measurable_mk hs),
        Measure.map_apply_of_aemeasurable hm (hg.measurable_mk ht),
        Measure.map_apply_of_aemeasurable hm ((hf.measurable_mk hs).inter (hg.measurable_mk ht)),
        Set.preimage_inter, Set.preimage_comp, Set.preimage_comp]
    _ ↔ IndepFun (f ∘ m) (g ∘ m) μ := ⟨(·.congr hfm.symm hgm.symm), (·.congr hfm hgm)⟩

end ProbabilityTheory
