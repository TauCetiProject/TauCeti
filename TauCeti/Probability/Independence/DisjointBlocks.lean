module

public import Mathlib.Probability.Independence.Basic

/-!
# Independence from disjoint blocks of an independent family

Mathlib's `ProbabilityTheory.iIndepFun.indepFun_finset` splits an independent family along two
disjoint **finite** index sets. The statement is true for arbitrary index sets, and that is what a
random object built from a countably infinite block of independent noise needs: the two objects are
independent as soon as the coordinates they read are disjoint, however many of them there are.

`TauCeti.Probability.blockSigma` names the σ-algebra a block of coordinates generates, and
`TauCeti.Probability.indepFun_of_measurable_blockSigma` is the resulting independence criterion. The
proof is Mathlib's `ProbabilityTheory.indep_iSup_of_disjoint` together with the monotonicity of
independence in both σ-algebras.

## Main declarations

* `TauCeti.Probability.blockSigma` — the σ-algebra generated by a set of members of a family of
  random variables;
* `TauCeti.Probability.blockSigma_def` — its defining supremum, for use across module boundaries;
* `TauCeti.Probability.blockSigma_empty` — an empty block generates the bottom σ-algebra;
* `TauCeti.Probability.blockSigma_mono` — monotonicity in the block;
* `TauCeti.Probability.blockSigma_le_iff` — the universal property of that σ-algebra;
* `TauCeti.Probability.measurable_blockSigma_of_mem` — a member of the block is measurable for it;
* `TauCeti.Probability.indep_blockSigma_of_disjoint` — disjoint blocks of an independent family
  generate independent σ-algebras;
* `TauCeti.Probability.indepFun_of_measurable_blockSigma` — two random elements measurable for the
  σ-algebras of disjoint blocks of an independent family are independent;
* `ProbabilityTheory.iIndepFun.indepFun_prefix` — the finite prefix of an independent sequence
  is independent of the next coordinate;
* `ProbabilityTheory.iIndepFun.indepFun_fun_sumElim` — if `Sum.elim X X'` is independent, the
  vectors `(Xᵢ)ᵢ` and `(X'ᵢ)ᵢ` are independent.
-/

public section

open MeasureTheory

namespace TauCeti.Probability

variable {Ω ι : Type*} {β : ι → Type*} [∀ i, MeasurableSpace (β i)]

/-- The σ-algebra generated by the members `Z i` of a family with `i` in a block `S` of indices. -/
@[implicit_reducible]
def blockSigma (Z : ∀ i, Ω → β i) (S : Set ι) : MeasurableSpace Ω :=
  ⨆ i ∈ S, MeasurableSpace.comap (Z i) inferInstance

/-- The defining supremum of `blockSigma`. -/
theorem blockSigma_def (Z : ∀ i, Ω → β i) (S : Set ι) :
    blockSigma Z S = ⨆ i ∈ S, MeasurableSpace.comap (Z i) inferInstance := by
  rfl

/-- The block σ-algebra is the σ-algebra pulled back along the restriction of the family to the
block. -/
theorem blockSigma_eq_comap_restrict (Z : ∀ i, Ω → β i) (S : Set ι) :
    blockSigma Z S = MeasurableSpace.comap (fun ω => fun i : S => Z i ω) inferInstance := by
  rw [blockSigma_def, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp, iSup_subtype, Function.comp_def]

/-- The block σ-algebra of a finite block is the σ-algebra pulled back along the `Finset`
restriction of the family to the block. -/
theorem blockSigma_coe_eq_comap_finset_restrict (Z : ∀ i, Ω → β i) (S : Finset ι) :
    blockSigma Z ↑S = MeasurableSpace.comap (fun ω => S.restrict fun i => Z i ω) inferInstance :=
  -- the subtype of the coerced finset is the subtype of the finset, and the restriction to it is
  -- `Finset.restrict`, both by definition
  blockSigma_eq_comap_restrict Z ↑S

/-- The σ-algebra generated by an empty block is the bottom σ-algebra. -/
@[simp]
theorem blockSigma_empty (Z : ∀ i, Ω → β i) : blockSigma Z ∅ = ⊥ := by
  simp [blockSigma]

/-- A member of a block is measurable for the σ-algebra that block generates. -/
theorem measurable_blockSigma_of_mem {Z : ∀ i, Ω → β i} {S : Set ι} {i : ι} (hi : i ∈ S) :
    Measurable[blockSigma Z S] (Z i) :=
  Measurable.of_comap_le
    (le_iSup₂ (f := fun i (_ : i ∈ S) => MeasurableSpace.comap (Z i) inferInstance) i hi)

/-- The σ-algebra of a block grows with the block. -/
theorem blockSigma_mono {Z : ∀ i, Ω → β i} {S T : Set ι} (hST : S ⊆ T) :
    blockSigma Z S ≤ blockSigma Z T :=
  iSup_le_iSup_of_subset hST

/-- The σ-algebra generated by a block is below `m` exactly when every member of the block is
measurable with respect to `m`. -/
theorem blockSigma_le_iff {Z : ∀ i, Ω → β i} {S : Set ι} {m : MeasurableSpace Ω} :
    blockSigma Z S ≤ m ↔ ∀ i ∈ S, Measurable[m] (Z i) :=
  ⟨fun h _ hi => Measurable.of_comap_le ((measurable_blockSigma_of_mem hi).comap_le.trans h),
    fun h => iSup₂_le fun i hi => (h i hi).comap_le⟩

variable [MeasurableSpace Ω]

/-- The σ-algebra of a block of an independent family sits inside the ambient σ-algebra. -/
theorem blockSigma_le {Z : ∀ i, Ω → β i} (S : Set ι)
    (hZ : ∀ i ∈ S, Measurable (Z i)) :
    blockSigma Z S ≤ (inferInstance : MeasurableSpace Ω) :=
  blockSigma_le_iff.mpr hZ

/-- The σ-algebras generated by two disjoint blocks of an independent family are independent. -/
theorem indep_blockSigma_of_disjoint {μ : Measure Ω} {Z : ∀ i, Ω → β i}
    (hZ : ProbabilityTheory.iIndepFun Z μ) (hZ_meas : ∀ i, Measurable (Z i)) {S T : Set ι}
    (hST : Disjoint S T) : ProbabilityTheory.Indep (blockSigma Z S) (blockSigma Z T) μ :=
  ProbabilityTheory.indep_iSup_of_disjoint (fun i => (hZ_meas i).comap_le) hZ.iIndep hST

/-- Two random elements, each measurable for the σ-algebra generated by its own block of an
independent family, are independent as soon as the two blocks are disjoint. Unlike
`ProbabilityTheory.iIndepFun.indepFun_finset`, the blocks may be infinite. -/
theorem indepFun_of_measurable_blockSigma {μ : Measure Ω} {Z : ∀ i, Ω → β i}
    {S T : Set ι} (hZ : ProbabilityTheory.iIndepFun (fun i : ↥(S ∪ T) => Z i) μ)
    (hZ_meas : ∀ i ∈ S ∪ T, Measurable (Z i)) (hST : Disjoint S T)
    {γ δ : Type*} [MeasurableSpace γ] [MeasurableSpace δ] {U : Ω → γ} {V : Ω → δ}
    (hU : Measurable[blockSigma Z S] U) (hV : Measurable[blockSigma Z T] V) :
    ProbabilityTheory.IndepFun U V μ := by
  have hm_block (A : Set ι) (hA : A ⊆ S ∪ T) :
      blockSigma (fun i : ↥(S ∪ T) => Z i) (Subtype.val ⁻¹' A) = blockSigma Z A :=
    le_antisymm
      (iSup₂_le fun i hi => le_iSup₂_of_le i.1 hi le_rfl)
      (iSup₂_le fun i hi => le_iSup₂_of_le ⟨i, hA hi⟩ hi le_rfl)
  have hblocks := indep_blockSigma_of_disjoint hZ (fun i => hZ_meas i i.property)
    (hST.preimage (Subtype.val : ↥(S ∪ T) → ι))
  rw [hm_block S Set.subset_union_left, hm_block T Set.subset_union_right] at hblocks
  exact ProbabilityTheory.indep_of_indep_of_le
    hblocks hU.comap_le hV.comap_le

end TauCeti.Probability

namespace ProbabilityTheory

/-- The completed prefix of an independent sequence is independent of its next coordinate. -/
theorem iIndepFun.indepFun_prefix {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {β : ℕ → Type*} [∀ i, MeasurableSpace (β i)] {X : ∀ i, Ω → β i}
    (hindep : iIndepFun X μ) (hX : ∀ i, Measurable (X i)) (n : ℕ) :
    IndepFun (fun ω (i : Fin n) ↦ X i ω) (X n) μ := by
  have h := hindep.indepFun_set (Set.Iio n) {n}
    (by simp only [Set.disjoint_left, Set.mem_Iio, Set.mem_singleton_iff]; omega) hX
  exact h.comp
    (by fun_prop : Measurable (fun (z : ∀ i : Set.Iio n, β i) (i : Fin n) ↦ z ⟨i, i.isLt⟩))
    (by fun_prop : Measurable (fun (z : ∀ i : ({n} : Set ℕ), β i) ↦ z ⟨n, by simp⟩))

variable {Ω ι E : Type*} [MeasurableSpace Ω] [MeasurableSpace E] {μ : Measure Ω}
  {X X' : ι → Ω → E}

/-- If the family `Sum.elim X X'` is independent, the vectors `(Xᵢ)ᵢ` and `(X'ᵢ)ᵢ` are independent.
The index type may be infinite. -/
theorem iIndepFun.indepFun_fun_sumElim (hind : iIndepFun (Sum.elim X X') μ)
    (hX : ∀ i, Measurable (X i)) (hX' : ∀ i, Measurable (X' i)) :
    IndepFun (fun ω i ↦ X i ω) (fun ω i ↦ X' i ω) μ := by
  have hZ : ∀ j, Measurable (Sum.elim X X' j) := by
    rintro (i | i)
    exacts [hX i, hX' i]
  have hdisj : Disjoint (Set.range (Sum.inl : ι → ι ⊕ ι)) (Set.range Sum.inr) := by
    rw [Set.disjoint_left]
    rintro _ ⟨i, rfl⟩ ⟨j, hj⟩
    cases hj
  have h := hind.indepFun_set _ _ hdisj hZ
  exact h.comp
    (φ := fun z i ↦ z ⟨Sum.inl i, Set.mem_range_self i⟩)
    (ψ := fun z i ↦ z ⟨Sum.inr i, Set.mem_range_self i⟩)
    (by fun_prop) (by fun_prop)

end ProbabilityTheory
