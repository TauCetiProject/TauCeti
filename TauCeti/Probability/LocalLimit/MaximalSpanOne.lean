/-!
# Integer laws of maximal span one

A measure `μ` on `ℤ` has *maximal span one* when it is carried by no coset `b + hℤ` of a proper
subgroup `hℤ`, `h ≥ 2`: for every such coset, `μ` gives positive mass to its complement. For a
probability measure this says that the law is a lattice law whose maximal span is `1`. This is
the nondegeneracy hypothesis of Gnedenko's local limit theorem for integer-valued summands, which
fails for laws carried by a proper coset (for the simple random walk, `Sₙ` has the parity of `n`).

The condition is stated through cosets rather than through the support, because a law carried by
`b + hℤ` with `b ∉ hℤ` (such as the Rademacher law on `{-1, 1}`, carried by `1 + 2ℤ`) may still
have a support generating `ℤ`. What does characterize it is the group generated by the
*differences* of points of the support.

## Main definitions

* `MeasureTheory.Measure.HasMaximalSpanOne`: a measure on `ℤ` is carried by no coset `b + hℤ`
  with `h ≥ 2`.

## Main results

* `MeasureTheory.Measure.hasMaximalSpanOne_iff_exists_measure_singleton_ne_zero`: the condition
  in terms of atoms: every coset `b + hℤ`, `h ≥ 2`, misses an atom of `μ`.
* `MeasureTheory.Measure.hasMaximalSpanOne_iff_closure_sub_eq_top`: `μ` has maximal span one if
  and only if the differences `k - l` of atoms of `μ` generate `ℤ` as an additive group.
* `MeasureTheory.Measure.HasMaximalSpanOne.measure_compl_singleton_ne_zero`: a law of maximal
  span one is not a point mass; `MeasureTheory.Measure.not_hasMaximalSpanOne_dirac`.
* `MeasureTheory.Measure.HasMaximalSpanOne.variance_pos`: an integer random variable whose law
  has maximal span one and which has a finite second moment has positive variance.
* `Measure.hasMaximalSpanOne_of_measure_singleton_ne_zero_of_measure_singleton_add_one_ne_zero`:
  a measure with atoms at two consecutive integers has maximal span one;
  `MeasureTheory.Measure.hasMaximalSpanOne_bernoulliMeasure_iff`: the Bernoulli law
  `Ber(x, y, p)` has maximal span one if and only if `|x - y| = 1` and `0 < p < 1`.

## References

* R. Durrett, *Probability: Theory and Examples*, fifth edition, §3.5: the definitions of a
  lattice law and its span before Example 3.5.1, and Theorem 3.5.2.
-/

public section

open ProbabilityTheory TauCeti.Probability unitInterval

open scoped Pointwise

namespace MeasureTheory.Measure

variable {μ : Measure ℤ}

/-- A measure `μ` on `ℤ` has *maximal span one* when it is carried by no coset `b + hℤ` with
`h ≥ 2`: for every `b : ℤ` and every natural number `h ≥ 2`, the complement of `b + hℤ` has
positive `μ`-measure. For a probability measure this means that the law is lattice with maximal
span one. -/
def HasMaximalSpanOne (μ : Measure ℤ) : Prop :=
  ∀ b : ℤ, ∀ h : ℕ, 2 ≤ h → μ {k : ℤ | ¬ (h : ℤ) ∣ k - b} ≠ 0

/-- Unfolding `HasMaximalSpanOne`. -/
theorem hasMaximalSpanOne_iff :
    μ.HasMaximalSpanOne ↔ ∀ b : ℤ, ∀ h : ℕ, 2 ≤ h → μ {k : ℤ | ¬ (h : ℤ) ∣ k - b} ≠ 0 :=
  Iff.rfl

/-- A measure on `ℤ` has maximal span one if and only if every coset `b + hℤ` with `h ≥ 2` misses
some atom of `μ`. -/
theorem hasMaximalSpanOne_iff_exists_measure_singleton_ne_zero :
    μ.HasMaximalSpanOne ↔
      ∀ b : ℤ, ∀ h : ℕ, 2 ≤ h → ∃ k : ℤ, μ {k} ≠ 0 ∧ ¬ (h : ℤ) ∣ k - b := by
  refine forall₂_congr fun b h ↦ imp_congr_right fun _ ↦ ?_
  rw [Ne, measure_null_iff_singleton (Set.to_countable _)]
  simp only [Set.mem_ofPred_eq, not_forall, exists_prop, and_comm]

/-- The zero measure does not have maximal span one. -/
theorem HasMaximalSpanOne.ne_zero (hμ : μ.HasMaximalSpanOne) : μ ≠ 0 := by
  rintro rfl
  exact hμ 0 2 le_rfl (by simp)

/-- A measure of maximal span one is not a point mass: it gives positive mass to the complement
of every singleton. -/
theorem HasMaximalSpanOne.measure_compl_singleton_ne_zero (hμ : μ.HasMaximalSpanOne) (b : ℤ) :
    μ {b}ᶜ ≠ 0 := by
  refine fun h0 ↦ hμ b 2 le_rfl (measure_mono_null (fun k hk ↦ ?_) h0)
  rintro rfl
  simp at hk

/-- A point mass on `ℤ` does not have maximal span one. -/
@[simp]
theorem not_hasMaximalSpanOne_dirac (b : ℤ) : ¬ (dirac b).HasMaximalSpanOne := fun h ↦
  h.measure_compl_singleton_ne_zero b (by simp)

/-- A measure on `ℤ` has maximal span one if and only if the differences `k - l` of its atoms
generate `ℤ` as an additive group. -/
theorem hasMaximalSpanOne_iff_closure_sub_eq_top :
    μ.HasMaximalSpanOne ↔
      AddSubgroup.closure ({k : ℤ | μ {k} ≠ 0} - {k : ℤ | μ {k} ≠ 0}) = ⊤ := by
  rw [hasMaximalSpanOne_iff_exists_measure_singleton_ne_zero]
  set S := {k : ℤ | μ {k} ≠ 0}
  constructor
  · intro hμ
    obtain ⟨i, hi⟩ := AddSubgroup.exists_zmultiples_eq_of_zmultiples_eq_top Int.zmultiples_one
      (AddSubgroup.closure (S - S))
    rw [smul_eq_mul, mul_one] at hi
    by_cases h1 : i.natAbs = 1
    · rw [← hi, ← Int.zmultiples_natAbs, h1, Nat.cast_one, Int.zmultiples_one]
    obtain ⟨h, hh, hhi⟩ := Nat.exists_prime_and_dvd h1
    obtain ⟨b, hb, -⟩ := hμ 0 2 le_rfl
    obtain ⟨k, hk, hkb⟩ := hμ b h hh.two_le
    refine absurd ((Int.natCast_dvd.2 hhi).trans ?_) hkb
    rw [← Int.mem_zmultiples_iff, hi]
    exact AddSubgroup.subset_closure (Set.sub_mem_sub hk hb)
  · intro htop b h hh
    by_contra! hdvd
    have hle : AddSubgroup.closure (S - S) ≤ AddSubgroup.zmultiples (h : ℤ) := by
      rw [AddSubgroup.closure_le]
      rintro _ ⟨k, hk, l, hl, rfl⟩
      rw [SetLike.mem_coe, Int.mem_zmultiples_iff]
      simpa using dvd_sub (hdvd k hk) (hdvd l hl)
    have h1 : (h : ℤ) ∣ 1 := by
      rw [← Int.mem_zmultiples_iff]
      exact hle (htop ▸ AddSubgroup.mem_top 1)
    have : h = 1 := by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) h1
    omega

/-- A measure with atoms at two consecutive integers has maximal span one: the difference
`(k + 1) - k = 1` of two atoms generates `ℤ`. -/
theorem hasMaximalSpanOne_of_measure_singleton_ne_zero_of_measure_singleton_add_one_ne_zero
    {k : ℤ} (hk : μ {k} ≠ 0) (hk₁ : μ {k + 1} ≠ 0) : μ.HasMaximalSpanOne := by
  rw [hasMaximalSpanOne_iff_closure_sub_eq_top, eq_top_iff, ← Int.zmultiples_one,
    AddSubgroup.zmultiples_le]
  exact AddSubgroup.subset_closure ⟨k + 1, hk₁, k, hk, add_sub_cancel_left k 1⟩

/-- The Bernoulli law `Ber(x, y, p)` on `ℤ`, with mass `p` at `x` and `1 - p` at `y`, has maximal
span one if and only if `x` and `y` are consecutive integers and `0 < p < 1`. -/
theorem hasMaximalSpanOne_bernoulliMeasure_iff {x y : ℤ} {p : I} :
    Ber(x, y, p).HasMaximalSpanOne ↔ (x - y).natAbs = 1 ∧ 0 < (p : ℝ) ∧ (p : ℝ) < 1 := by
  constructor
  · intro hμ
    have hp₀ : 0 < (p : ℝ) := by
      refine lt_of_le_of_ne (nonneg p) fun hp ↦ ?_
      have : p = 0 := Set.Icc.coe_eq_zero.1 hp.symm
      simp [this] at hμ
    have hp₁ : (p : ℝ) < 1 := by
      refine lt_of_le_of_ne (le_one p) fun hp ↦ ?_
      have : p = 1 := Set.Icc.coe_eq_one.1 hp
      simp [this] at hμ
    refine ⟨?_, hp₀, hp₁⟩
    by_contra hxy
    obtain ⟨h, hh, hdvd⟩ := Nat.exists_prime_and_dvd hxy
    refine hμ y h hh.two_le (bernoulliMeasure_apply_of_notMem_of_notMem p
      (MeasurableSet.of_discrete) ?_ ?_) <;> simp [Int.natCast_dvd.2 hdvd]
  · rintro ⟨hxy, hp₀, hp₁⟩
    have hx := bernoulliMeasure_singleton_left_ne_zero (x := x) (y := y) hp₀
    have hy := bernoulliMeasure_singleton_right_ne_zero (x := x) (y := y) hp₁
    rcases Int.natAbs_eq_iff.1 hxy with h | h
    · exact hasMaximalSpanOne_of_measure_singleton_ne_zero_of_measure_singleton_add_one_ne_zero
        (k := y) hy (by rwa [show y + 1 = x by push_cast at h; omega])
    · exact hasMaximalSpanOne_of_measure_singleton_ne_zero_of_measure_singleton_add_one_ne_zero
        (k := x) hx
        (by rwa [show x + 1 = y by push_cast at h; omega])

/-- An integer random variable whose law has maximal span one and which has a finite second
moment has positive variance: otherwise it would be almost surely constant, and its law a point
mass. -/
theorem HasMaximalSpanOne.variance_pos {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsFiniteMeasure P] {X : Ω → ℤ} (hspan : (P.map X).HasMaximalSpanOne)
    (hX : MemLp (fun ω ↦ (X ω : ℝ)) 2 P) :
    0 < Var[fun ω ↦ (X ω : ℝ); P] := by
  refine (variance_nonneg _ _).lt_of_ne' fun h0 ↦ ?_
  have hnull := ae_iff.1 (ae_eq_integral_of_variance_eq_zero hX h0)
  set m := P[fun ω ↦ (X ω : ℝ)]
  have hXm : AEMeasurable X P := by
    by_contra hXnm
    have hP : P ≠ 0 := by
      rintro rfl
      exact hspan.ne_zero (by simp)
    exact not_hasMaximalSpanOne_dirac _ (map_of_not_aemeasurable_of_ne_zero hXnm hP ▸ hspan)
  obtain ⟨k, hk, -⟩ := hasMaximalSpanOne_iff_exists_measure_singleton_ne_zero.1 hspan 0 2 le_rfl
  rw [map_apply_of_aemeasurable hXm (measurableSet_singleton k)] at hk
  have hkm : (k : ℝ) = m := by
    by_contra hne
    refine hk (measure_mono_null (fun ω hω ↦ ?_) hnull)
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hω
    simpa [hω] using hne
  refine hspan.measure_compl_singleton_ne_zero k ?_
  rw [map_apply_of_aemeasurable hXm (measurableSet_singleton k).compl]
  refine measure_mono_null (fun ω hω ↦ ?_) hnull
  simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff] at hω
  simp only [Set.mem_ofPred_eq, ← hkm]
  exact_mod_cast hω

end MeasureTheory.Measure
