/-!
# The normal cone of a regular immersion is its normal bundle

Let `i : X ⟶ Y` be a regular immersion, with ideal sheaf `I` of `X` in the open
`i.coborderRange` of `Y` in which `X` is closed. The surjection of graded algebras

`Sym (I/I²) ⟶ ⨁ₙ Iⁿ/Iⁿ⁺¹`

(`AlgebraicGeometry.Scheme.Hom.symmetricAlgebraToNormalConeAlgebra`) is an isomorphism
(`AlgebraicGeometry.Scheme.Hom.IsRegularImmersion.isIso_symmetricAlgebraToNormalConeAlgebra`), so
the closed embedding `C_X Y ⟶ N_X Y` of the normal cone into the normal sheaf is an isomorphism
(`isIso_normalConeToNormalSheaf`), and the normal cone is the normal bundle: the total space of the
dual `(I/I²)^∨` of the conormal sheaf, a vector bundle of rank the codimension
(`IsRegularImmersion.normalConeOverIsoTotalSpaceScheme`; Fulton, *Intersection Theory*, §B.7.1).

The proof is local and degree by degree. Over an affine open `U` of `i.coborderRange` on which
`I(U) = J` is generated by a regular sequence, pull the degree-`n` component
`Symⁿ (I/I²) ⟶ Iⁿ/Iⁿ⁺¹` back to the affine chart `Spec (Γ(U) ⧸ J)` of `X`. The source becomes the
sheaf associated with `Symⁿ (J/J²)` and the target the sheaf associated with `(Γ(U) ⧸ J) ⊗ Jⁿ`,
the pullback of the power `Iⁿ` (`Scheme.Hom.pullbackIdealSheafAffineChartIsoTilde`). For a regular
sequence these modules are isomorphic and finitely generated
(`RingTheory.Sequence.IsWeaklyRegular.extendScalarsPowEquivSymmetricPower`). The pulled-back
component is still an epimorphism, so it is surjective on global sections, and a surjective
linear map between isomorphic finitely generated modules over a commutative ring is injective
(the Orzech property). Hence it is an isomorphism on each chart, and these charts cover `X`.

No compatibility of the local identifications with the map is needed: only the existence of an
isomorphism between source and target on each chart enters.

## Main declarations

* `AlgebraicGeometry.Scheme.Hom.pullbackIdealSheafAffineChartIsoTilde`: for a closed immersion
  `j : X ⟶ Z`, an affine open `U` of `Z` and an ideal sheaf `K` on `Z`, the pullback of `j^* K` to
  the affine chart `Spec (Γ(Z, U) ⧸ (ker j)(U))` is the sheaf associated with the extension of
  scalars of `K(U)`.
* `AlgebraicGeometry.Scheme.Hom.IsRegularImmersion.isIso_symmetricAlgebraToNormalConeAlgebra`:
  for a regular immersion, `Sym (I/I²) ⟶ ⨁ₙ Iⁿ/Iⁿ⁺¹` is an isomorphism.
* `AlgebraicGeometry.Scheme.Hom.IsRegularImmersion.isIso_normalConeToNormalSheaf`: for a regular
  immersion the normal cone is the normal sheaf.
* `AlgebraicGeometry.Scheme.Hom.IsRegularImmersion.normalConeOverIsoTotalSpaceScheme`: for a
  regular immersion the normal cone is the total space of the dual of the conormal sheaf, over
  `X`.

## References

* W. Fulton, *Intersection Theory*, 2nd ed., §4.1 and Appendix B.7.
* H. Matsumura, *Commutative Ring Theory*, Theorem 16.2 (i).
-/

public section

open CategoryTheory Opposite

universe u

namespace TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra

variable {X : _root_.AlgebraicGeometry.Scheme.{u}}

/-- A morphism of graded quasicoherent algebras whose homogeneous components are isomorphisms is
an isomorphism. -/
theorem isIso_of_isIso_hom_hom_hom {A B : GradedQuasicoherentAlgebra X} (f : A ⟶ B)
    (hf : ∀ n, IsIso (f.hom.hom.hom n)) : IsIso f := by
  have : IsIso f.hom.hom.hom := @GradedObject.isIso_of_isIso_apply _ _ _ _ _ _ hf
  -- The forgetful functor to graded modules sends `f` to `f.hom.hom.hom` and reflects
  -- isomorphisms.
  have : IsIso ((ObjectProperty.ι _ ⋙ CommMon.forget₂Mon _ ⋙ Mon.forget _).map f) := by
    simpa only [Functor.comp_map, ObjectProperty.ι_map, CommMon.forget₂Mon_map_hom,
      Mon.forget_map]
  exact isIso_of_reflects_iso f (ObjectProperty.ι _ ⋙ CommMon.forget₂Mon _ ⋙ Mon.forget _)

end TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra

namespace AlgebraicGeometry.Scheme.Hom

open TauCeti.AlgebraicGeometry

section AffineChart

variable {X Z : Scheme.{u}} (j : X ⟶ Z) [IsClosedImmersion j] (U : Z.affineOpens)

/-- For a closed immersion `j : X ⟶ Z`, an affine open `U` of `Z` and an ideal sheaf `K` on `Z`,
the pullback of `j^* K` to the affine chart `Spec (Γ(Z, U) ⧸ (ker j)(U))` of `X` is the sheaf
associated with the extension of scalars of the `Γ(Z, U)`-module `K(U)` along the quotient map.
For `K = ker j` this is `Scheme.Hom.pullbackConormalAffineChartIsoTilde` before the
identification of the extension of scalars with the conormal module. -/
noncomputable def pullbackIdealSheafAffineChartIsoTilde (K : Z.IdealSheafData) :
    (Scheme.Modules.pullback (j.affineChart U)).obj ((Scheme.Modules.pullback j).obj K.sheaf) ≅
      tilde ((ModuleCat.extendScalars (Ideal.Quotient.mk (j.ker.ideal U))).obj
        (ModuleCat.of Γ(Z, U) (K.ideal U))) :=
  -- Pull `K` back along `Spec (Γ(Z, U) ⧸ I(U)) ⟶ Spec Γ(Z, U) ⟶ Z`: the open immersion
  -- `U.fromSpec` turns it into the ideal sheaf `K(U)~`, and the closed immersion then extends
  -- scalars (`tildeFunctorCompPullbackIso`).
  have : IsOpenImmersion U.property.fromSpec := U.property.isOpenImmersion_fromSpec
  (Scheme.Modules.pullbackComp (j.affineChart U) j).app _ ≪≫
    (Scheme.Modules.pullbackCongr (j.affineChart_comp U)).app _ ≪≫
    ((Scheme.Modules.pullbackComp _ U.property.fromSpec).app _).symm ≪≫
    (Scheme.Modules.pullback _).mapIso (asIso (K.pullbackSheafHom U.property.fromSpec) ≪≫
      eqToIso (congrArg IdealSheafData.sheaf (K.comap_fromSpec_eq_ofIdealTop U.property)) ≪≫
      IdealSheafData.ofIdealTopSheafIsoTilde (K.ideal U)) ≪≫
    (tildeFunctorCompPullbackIso _).app (ModuleCat.of _ _)

end AffineChart

section Affine

variable {R : CommRingCat.{u}}

/-- **An epimorphism between isomorphic quasicoherent modules of finite type on an affine
spectrum is an isomorphism.** On global sections it is a surjection between isomorphic finitely
generated modules, which is injective by the Orzech property of commutative rings; and global
sections are an equivalence on quasicoherent modules. Only the existence of an isomorphism
`M ≅ N` matters, not its relation to `φ`. -/
theorem _root_.AlgebraicGeometry.Scheme.Modules.isIso_of_epi_of_iso {M N : (Spec R).Modules}
    [M.IsQuasicoherent] [N.IsQuasicoherent] (φ : M ⟶ N) [Epi φ] (e : M ≅ N)
    [Module.Finite R (moduleSpecΓFunctor.obj N)] : IsIso φ := by
  have hsurj := moduleSpecΓFunctor_map_surjective_of_epi_of_isQuasicoherent φ
  -- Precomposed with the inverse of `e`, it is a surjective endomorphism of a finitely generated
  -- module, hence injective.
  have hinj : Function.Injective (moduleSpecΓFunctor.map φ) := by
    have h := OrzechProperty.injective_of_surjective_endomorphism
      ((moduleSpecΓFunctor.mapIso e).inv ≫ moduleSpecΓFunctor.map φ).hom
      (hsurj.comp (moduleSpecΓFunctor.mapIso e).symm.toLinearEquiv.surjective)
    exact (Function.Injective.of_comp_iff' _
      (moduleSpecΓFunctor.mapIso e).symm.toLinearEquiv.bijective).mp h
  have : IsIso (moduleSpecΓFunctor.map φ) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr ⟨hinj, hsurj⟩
  -- Global sections are the inverse of the tilde equivalence, which reflects isomorphisms.
  let P := SheafOfModules.isQuasicoherent (Spec R).ringCatSheaf
  let ψ : (⟨M, ‹_›⟩ : P.FullSubcategory) ⟶ ⟨N, ‹_›⟩ := ObjectProperty.homMk φ
  have : IsIso (tildeEquiv.inverse.map ψ) := by assumption
  have : IsIso ψ := isIso_of_reflects_iso ψ tildeEquiv.inverse
  exact inferInstanceAs (IsIso (P.ι.map ψ))

end Affine

section Regular

variable {X Y : Scheme.{u}} (i : X ⟶ Y) [IsImmersion i]

/-- Every homogeneous component `Symⁿ (I/I²) ⟶ Iⁿ/Iⁿ⁺¹` of
`symmetricAlgebraToNormalConeAlgebra` is an epimorphism: it is a retract of the epimorphism of
direct sums `⨁ₙ Symⁿ (I/I²) ⟶ ⨁ₙ Iⁿ/Iⁿ⁺¹`. -/
theorem epi_symmetricAlgebraToNormalConeAlgebra_hom (n : ℕ) :
    Epi (i.symmetricAlgebraToNormalConeAlgebra.hom.hom.hom n) := by
  -- `πTotal` is typed in `X.Modules` and the components in `SheafOfModules X.ringCatSheaf`, so
  -- the instances are passed explicitly.
  have hπ : IsSplitEpi (GradedQuasicoherentAlgebra.πTotal i.normalConeAlgebra n) :=
    .mk' ⟨_, GradedQuasicoherentAlgebra.ιTotal_πTotal_self _ n⟩
  have hc := @epi_comp _ _ _ _ _ _
    i.epi_toQuasicoherentAlgebra_map_symmetricAlgebraToNormalConeAlgebra _
    (@IsSplitEpi.epi _ _ _ _ _ hπ)
  rw [GradedQuasicoherentAlgebra.toQuasicoherentAlgebra_map_πTotal] at hc
  exact @epi_of_epi _ _ _ _ _ _ _ hc

/-- Over an affine open `U` of `i.coborderRange`, with `J = I(U)`, the pullback of `Symⁿ (I/I²)`
to the affine chart `Spec (Γ(U) ⧸ J)` of `X` is the sheaf associated with `Symⁿ (J/J²)`. -/
noncomputable def pullbackAffineChartSymmetricPowerConormalIso (n : ℕ)
    (U : (i.coborderRange : Scheme.{u}).affineOpens) :
    (Scheme.Modules.pullback (i.liftCoborder.affineChart U)).obj
      (((gradedSymmetricAlgebra X).obj i.conormal).obj.X n) ≅
      tilde ((ModuleCat.of _ (i.liftCoborder.ker.ideal U).Cotangent).symmetricPower n) :=
  have : i.conormal.obj.IsQuasicoherent := i.conormal.property
  (Scheme.Modules.pullback (i.liftCoborder.affineChart U)).mapIso
      (eqToIso (gradedSymmetricAlgebra_obj_obj_X _ n)) ≪≫
    @asIso _ _ _ _ ((Scheme.Modules.pullbackSymmetricPowerComparison
      (i.liftCoborder.affineChart U) n).app i.conormal.obj)
      (isIso_pullbackSymmetricPowerComparison_app _ n _) ≪≫
    (SheafOfModules.symmetricPower
        (Spec (.of (Γ(i.coborderRange, U) ⧸ i.liftCoborder.ker.ideal U))).sheaf n).mapIso
      ((Scheme.Modules.pullback (i.liftCoborder.affineChart U)).mapIso
          (eqToIso i.conormal_obj) ≪≫
        i.liftCoborder.pullbackConormalAffineChartIsoTilde U) ≪≫
    (tildeSymmetricPowerIso n _).symm

/-- Over an affine open `U` of `i.coborderRange`, with `J = I(U)`, the pullback of `Iⁿ/Iⁿ⁺¹` to the
affine chart `Spec (Γ(U) ⧸ J)` of `X` is the sheaf associated with the extension of scalars
`(Γ(U) ⧸ J) ⊗ Jⁿ` of `Jⁿ`. -/
noncomputable def pullbackAffineChartNormalConeAlgebraIso (n : ℕ)
    (U : (i.coborderRange : Scheme.{u}).affineOpens) :
    (Scheme.Modules.pullback (i.liftCoborder.affineChart U)).obj
      (i.normalConeAlgebra.obj.X n) ≅
      tilde ((ModuleCat.extendScalars (Ideal.Quotient.mk (i.liftCoborder.ker.ideal U))).obj
        (ModuleCat.of Γ(i.coborderRange, U) ↥(i.liftCoborder.ker.ideal U ^ n))) :=
  (Scheme.Modules.pullback (i.liftCoborder.affineChart U)).mapIso
      (eqToIso (i.normalConeAlgebra_obj_X n)) ≪≫
    i.liftCoborder.pullbackIdealSheafAffineChartIsoTilde U (i.liftCoborder.ker ^ n)

/-- Over an affine open `U` of `i.coborderRange` on which the ideal `I(U)` of `X` is generated by a
weakly regular sequence, the degree-`n` component `Symⁿ (I/I²) ⟶ Iⁿ/Iⁿ⁺¹` of
`symmetricAlgebraToNormalConeAlgebra`, pulled back to the affine chart `Spec (Γ(U) ⧸ I(U))` of
`X`, is an isomorphism: it is an epimorphism between sheaves associated with the isomorphic
finitely generated modules `Symⁿ (J/J²)` and `(Γ(U) ⧸ J) ⊗ Jⁿ`, for `J = I(U)`. -/
theorem isIso_pullback_affineChart_map_symmetricAlgebraToNormalConeAlgebra (n : ℕ)
    (U : (i.coborderRange : Scheme.{u}).affineOpens) {rs : List Γ(i.coborderRange, U)}
    (hrs : RingTheory.Sequence.IsWeaklyRegular Γ(i.coborderRange, U) rs)
    (hI : Ideal.ofList rs = i.liftCoborder.ker.ideal U) :
    IsIso ((Scheme.Modules.pullback (i.liftCoborder.affineChart U)).map
      (i.symmetricAlgebraToNormalConeAlgebra.hom.hom.hom n)) := by
  -- The objects are written with `CommMon.X` in the statement and with `Mon.X` in `φ`, so the
  -- instances are passed explicitly.
  have hS : ((Scheme.Modules.pullback (i.liftCoborder.affineChart U)).obj
      (((gradedSymmetricAlgebra X).obj i.conormal).obj.X n)).IsQuasicoherent := inferInstance
  have hT : ((Scheme.Modules.pullback (i.liftCoborder.affineChart U)).obj
      (i.normalConeAlgebra.obj.X n)).IsQuasicoherent := inferInstance
  have hepi := @Functor.map_epi _ _ _ _ (Scheme.Modules.pullback (i.liftCoborder.affineChart U)) _
    _ _ _ (i.epi_symmetricAlgebraToNormalConeAlgebra_hom n)
  let eT := i.pullbackAffineChartNormalConeAlgebraIso n U
  -- The target has finitely generated global sections, `(Γ(U) ⧸ J) ⊗ Jⁿ = Jⁿ ⧸ J • Jⁿ`.
  have : Module.Finite (Γ(i.coborderRange, U) ⧸ i.liftCoborder.ker.ideal U)
      (moduleSpecΓFunctor.obj ((Scheme.Modules.pullback (i.liftCoborder.affineChart U)).obj
        (i.normalConeAlgebra.obj.X n))) := by
    have hfg : (i.liftCoborder.ker.ideal U).FG :=
      hI ▸ Submodule.fg_span (s := {r | r ∈ rs}) rs.finite_toSet
    have : Module.Finite Γ(i.coborderRange, U) ↥(i.liftCoborder.ker.ideal U ^ n) :=
      Module.Finite.iff_fg.mpr hfg.pow
    have : Module.Finite (Γ(i.coborderRange, U) ⧸ i.liftCoborder.ker.ideal U)
        (↥(i.liftCoborder.ker.ideal U ^ n) ⧸
          (i.liftCoborder.ker.ideal U • ⊤ :
            Submodule Γ(i.coborderRange, U) ↥(i.liftCoborder.ker.ideal U ^ n))) :=
      Module.Finite.of_restrictScalars_finite Γ(i.coborderRange, U) _ _
    exact Module.Finite.equiv ((Ideal.extendScalarsMkEquivQuotSMul _ _).symm ≪≫ₗ
      (tilde.toTildeΓNatIso.app _ ≪≫ moduleSpecΓFunctor.mapIso eT.symm).toLinearEquiv)
  -- For a regular sequence `Symⁿ (J/J²) ≅ (Γ(U) ⧸ J) ⊗ Jⁿ`, so source and target are isomorphic.
  exact @Scheme.Modules.isIso_of_epi_of_iso _ _ _ hS hT _ hepi
    (i.pullbackAffineChartSymmetricPowerConormalIso n U ≪≫ (tilde.functor _).mapIso
      (hrs.extendScalarsPowEquivSymmetricPower hI n).toModuleIso.symm ≪≫ eT.symm) this

namespace IsRegularImmersion

variable {i} {d : ℕ}

/-- For a regular immersion, every component `Symⁿ (I/I²) ⟶ Iⁿ/Iⁿ⁺¹` of
`symmetricAlgebraToNormalConeAlgebra` is an isomorphism: it is one on the affine charts of `X`
over the affine opens of `i.coborderRange` on which `I` is generated by a regular sequence, and
these charts cover `X`. -/
theorem isIso_symmetricAlgebraToNormalConeAlgebra_hom (h : i.IsRegularImmersion d) (n : ℕ) :
    IsIso (i.symmetricAlgebraToNormalConeAlgebra.hom.hom.hom n) := by
  let ι := {p : Σ U : (i.coborderRange : Scheme.{u}).affineOpens, List Γ(i.coborderRange, U) //
    RingTheory.Sequence.IsRegular Γ(i.coborderRange, p.fst) p.snd ∧
      i.liftCoborder.ker.ideal p.fst = Ideal.ofList p.snd}
  refine (Scheme.Modules.isIso_iff_of_isOpenCover_opensRange
    (fun p : ι ↦ i.liftCoborder.affineChart p.val.fst) ?_ _).mpr fun p ↦
      isIso_pullback_affineChart_map_symmetricAlgebraToNormalConeAlgebra i n p.val.fst
        p.property.left.toIsWeaklyRegular p.property.right.symm
  refine TopologicalSpace.IsOpenCover.mk (eq_top_iff.mpr fun x _ ↦ ?_)
  obtain ⟨U, hxU, rs, -, hrs, hI⟩ := IdealSheafData.isLocallyRegular_iff.mp
    (isRegularImmersion_iff.mp h) (i.liftCoborder x)
    (i.liftCoborder.range_subset_ker_support ⟨x, rfl⟩)
  exact TopologicalSpace.Opens.mem_iSup.mpr
    ⟨⟨⟨U, rs⟩, hrs, hI⟩, (i.liftCoborder.mem_range_affineChart_iff U).mpr hxU⟩

/-- **For a regular immersion, `Sym (I/I²) ⟶ ⨁ₙ Iⁿ/Iⁿ⁺¹` is an isomorphism** (Fulton,
*Intersection Theory*, Appendix B.7.1; Matsumura, *Commutative Ring Theory*, Theorem 16.2 (i)). -/
theorem isIso_symmetricAlgebraToNormalConeAlgebra (h : i.IsRegularImmersion d) :
    IsIso i.symmetricAlgebraToNormalConeAlgebra :=
  GradedQuasicoherentAlgebra.isIso_of_isIso_hom_hom_hom _
    h.isIso_symmetricAlgebraToNormalConeAlgebra_hom

/-- For a regular immersion, the embedding of the normal cone into the normal sheaf is an
isomorphism of affine schemes over `X`. -/
theorem isIso_normalConeToNormalSheafOver (h : i.IsRegularImmersion d) :
    IsIso i.normalConeToNormalSheafOver := by
  have := h.isIso_symmetricAlgebraToNormalConeAlgebra
  have : IsIso (GradedQuasicoherentAlgebra.toQuasicoherentAlgebra.map
      i.symmetricAlgebraToNormalConeAlgebra) := Functor.map_isIso _ _
  rw [normalConeToNormalSheafOver_def]
  exact Functor.map_isIso _ _

/-- **For a regular immersion, the normal cone is the normal sheaf**: the closed embedding
`C_X Y ⟶ N_X Y` is an isomorphism. -/
theorem isIso_normalConeToNormalSheaf (h : i.IsRegularImmersion d) :
    IsIso i.normalConeToNormalSheaf := by
  have := h.isIso_normalConeToNormalSheafOver
  rw [← normalConeToNormalSheafOver_left]
  exact Functor.map_isIso (MorphismProperty.Comma.forget _ _ _ _ _ ⋙ Comma.fst _ _)
    i.normalConeToNormalSheafOver

/-- The conormal sheaf of a regular immersion, as a finite locally free sheaf, is the conormal
sheaf `I/I²`. -/
noncomputable def toQuasicoherentConormalIso (h : i.IsRegularImmersion d) :
    (FiniteLocallyFreeSheaf.toQuasicoherent X).obj h.conormal.obj ≅ i.conormal :=
  ObjectProperty.isoMk _ (eqToIso h.conormal_obj_obj)

/-- **The normal cone of a regular immersion is its normal bundle** (Fulton, *Intersection
Theory*, §B.7.1): the normal cone `C_X Y` is, over `X`, the total space of the dual
`(I/I²)^∨` of the conormal sheaf, a finite locally free sheaf of rank the codimension `d`. -/
noncomputable def normalConeOverIsoTotalSpaceScheme (h : i.IsRegularImmersion d) :
    i.normalConeOver ≅ (totalSpaceScheme X).obj (FiniteLocallyFreeSheaf.dual h.conormal.obj) :=
  have := h.isIso_normalConeToNormalSheafOver
  asIso i.normalConeToNormalSheafOver ≪≫
    i.normalSheafOverIsoTotalSpaceScheme h.conormal.obj h.toQuasicoherentConormalIso

/-- The isomorphism of the normal cone with the normal bundle is the embedding of the normal cone
into the normal sheaf, followed by the identification of the normal sheaf with the total space of
the dual of the conormal sheaf. -/
theorem normalConeOverIsoTotalSpaceScheme_hom (h : i.IsRegularImmersion d) :
    h.normalConeOverIsoTotalSpaceScheme.hom = i.normalConeToNormalSheafOver ≫
      (i.normalSheafOverIsoTotalSpaceScheme h.conormal.obj h.toQuasicoherentConormalIso).hom :=
  (rfl)

end IsRegularImmersion

end Regular

end AlgebraicGeometry.Scheme.Hom
