/-!
# Regular immersions and their conormal sheaves

An ideal sheaf `I` on a scheme `Y` is *regular of codimension `d`*
(`IdealSheafData.IsLocallyRegular`) if every point of its support `V(I)` has an affine open
neighbourhood `U` on which `I(U)` is generated by a regular sequence of length `d` (Stacks, Tag
063E). An immersion `i : X ⟶ Y` is a *regular immersion of codimension `d`*
(`Scheme.Hom.IsRegularImmersion`) if the ideal sheaf of the closed immersion `X ⟶ U` into the
largest open `U = i.coborderRange` of `Y` in which `X` is closed is regular of codimension `d`
(Stacks, Tag 063J; Fulton, Appendix B.7). For a closed immersion `U = Y`.

The conormal sheaf `I/I²` of a regular immersion of codimension `d` is finite locally free of rank
`d` (`IsRegularImmersion.conormal`; Stacks, Tag 063K; Fulton, Appendix B.7.1). Over an affine
open `U` on which `I(U) = (f₁, …, f_d)` for a regular sequence, the conormal sheaf restricted to
`Spec (Γ(U) ⧸ I(U))` is the sheaf associated with `I(U) ⧸ I(U)²`, which is free on the classes of
`f₁, …, f_d` (`RingTheory.Sequence.IsWeaklyRegular.cotangentBasis`).

## Main definitions

* `AlgebraicGeometry.Scheme.IdealSheafData.IsLocallyRegular I d`: the ideal sheaf `I` is locally
  generated by a regular sequence of length `d` around every point of its support.
* `AlgebraicGeometry.Scheme.Hom.IsRegularImmersion i d`: the immersion `i` is a regular immersion
  of codimension `d`.
* `AlgebraicGeometry.Scheme.Hom.IsRegularImmersion.conormal`: the conormal sheaf of a regular
  immersion of codimension `d`, as a finite locally free sheaf of rank `d`.

## Main results

* `AlgebraicGeometry.Scheme.Hom.nonempty_pullback_affineChart_iso_free`: for a closed immersion
  `j : X ⟶ Z` and an affine open `U` of `Z` on which `I(U) ⧸ I(U)²` is free, the pullback of
  `j^* I` to the affine chart `Spec (Γ(Z, U) ⧸ I(U))` of `X` is free.
* `AlgebraicGeometry.Scheme.Hom.IsRegularImmersion.isFiniteLocallyFree_conormal`: the conormal
  sheaf of a regular immersion is finite locally free (`conormal_regular` in the roadmap).

## References

* [The Stacks Project, Tags 063E, 063J and 063K](https://stacks.math.columbia.edu/tag/063K)
* W. Fulton, *Intersection Theory*, 2nd ed., Appendix B.7.
-/

public section

open CategoryTheory Limits Opposite

universe u

namespace AlgebraicGeometry.Scheme

open TauCeti.AlgebraicGeometry

namespace IdealSheafData

variable {Y : Scheme.{u}}

/-- An ideal sheaf `I` on `Y` is *regular of codimension `d`* if every point of its support `V(I)`
has an affine open neighbourhood `U` on which the ideal `I(U)` is generated by a regular sequence
of length `d` on `Γ(Y, U)` (Stacks, Tag 063E). -/
def IsLocallyRegular (I : Y.IdealSheafData) (d : ℕ) : Prop :=
  ∀ y ∈ I.support, ∃ U : Y.affineOpens, y ∈ U.val ∧ ∃ rs : List Γ(Y, U), rs.length = d ∧
    RingTheory.Sequence.IsRegular Γ(Y, U) rs ∧ I.ideal U = Ideal.ofList rs

end IdealSheafData

namespace Hom

variable {X Y : Scheme.{u}}

/-- An immersion `i : X ⟶ Y` is a *regular immersion of codimension `d`* if the ideal sheaf of
the closed immersion `i.liftCoborder : X ⟶ i.coborderRange`, into the largest open of `Y` in which
`X` is closed, is regular of codimension `d`: locally on `i.coborderRange` around `X` it is
generated by a regular sequence of length `d` (Stacks, Tag 063J). For a closed immersion,
`i.coborderRange` is all of `Y`. -/
def IsRegularImmersion (i : X ⟶ Y) [IsImmersion i] (d : ℕ) : Prop :=
  i.liftCoborder.ker.IsLocallyRegular d

section AffineChart

variable {Z : Scheme.{u}} (j : X ⟶ Z) [IsClosedImmersion j] (U : Z.affineOpens)

/-- For a closed immersion `j : X ⟶ Z` with ideal sheaf `I`, and an affine open `U` of `Z` on
which the conormal module `I(U) ⧸ I(U)²` is free over `Γ(Z, U) ⧸ I(U)`, the pullback of
`j^* I` to the affine chart `Spec (Γ(Z, U) ⧸ I(U))` of `X` is free on the same index type. -/
theorem nonempty_pullback_affineChart_iso_free {ι : Type u}
    (b : Module.Basis ι (Γ(Z, U) ⧸ j.ker.ideal U) (Ideal.Cotangent (j.ker.ideal U))) :
    Nonempty ((Scheme.Modules.pullback (j.affineChart U)).obj
      ((Scheme.Modules.pullback j).obj j.ker.sheaf) ≅ SheafOfModules.free ι) :=
  -- Pull `I` back along `Spec (Γ(Z, U) ⧸ I(U)) ⟶ Spec Γ(Z, U) ⟶ Z`: the open immersion
  -- `U.fromSpec` turns it into the ideal sheaf `I(U)~` of `I(U)`, and the closed immersion then
  -- extends scalars to `(Γ(Z, U) ⧸ I(U)) ⊗ I(U) = I(U) ⧸ I(U)²`.
  have : IsOpenImmersion U.property.fromSpec := U.property.isOpenImmersion_fromSpec
  ⟨(Scheme.Modules.pullbackComp (j.affineChart U) j).app _ ≪≫
    (Scheme.Modules.pullbackCongr (j.affineChart_comp U)).app _ ≪≫
    ((Scheme.Modules.pullbackComp _ U.property.fromSpec).app _).symm ≪≫
    (Scheme.Modules.pullback _).mapIso (asIso (j.ker.pullbackSheafHom U.property.fromSpec) ≪≫
      eqToIso (congrArg IdealSheafData.sheaf (j.ker.comap_fromSpec_eq_ofIdealTop U.property)) ≪≫
      IdealSheafData.ofIdealTopSheafIsoTilde (j.ker.ideal U)) ≪≫
    (tildeFunctorCompPullbackIso _).app (ModuleCat.of _ _) ≪≫
    (tilde.functor _).mapIso
      (Ideal.extendScalarsMkEquivCotangent (j.ker.ideal U) ≪≫ₗ b.repr).toModuleIso ≪≫
    tildeFinsupp ι⟩

end AffineChart

namespace IsRegularImmersion

variable {i : X ⟶ Y} [IsImmersion i] {d : ℕ}

/-- The conormal sheaf of a regular immersion of codimension `d` is free of rank `d` on an open
neighbourhood of every point. -/
theorem exists_pullback_conormal_iso_free (h : i.IsRegularImmersion d) (x : X) :
    ∃ (V : Scheme.{u}) (g : V ⟶ X), IsOpenImmersion g ∧ x ∈ Set.range g ∧
      Nonempty ((Scheme.Modules.pullback g).obj i.conormal.obj ≅
        SheafOfModules.free (ULift.{u} (Fin d))) := by
  obtain ⟨U, hxU, rs, rfl, hrs, hI⟩ :=
    h (i.liftCoborder x) (i.liftCoborder.range_subset_ker_support ⟨x, rfl⟩)
  have b : Module.Basis (ULift.{u} (Fin rs.length)) (_ ⧸ i.liftCoborder.ker.ideal U)
      (Ideal.Cotangent (i.liftCoborder.ker.ideal U)) := by
    rw [hI]
    exact hrs.cotangentBasis.reindex Equiv.ulift.symm
  obtain ⟨e⟩ := i.liftCoborder.nonempty_pullback_affineChart_iso_free U b
  exact ⟨_, i.liftCoborder.affineChart U, inferInstance,
    (i.liftCoborder.mem_range_affineChart_iff U).mpr hxU,
    ⟨(Scheme.Modules.pullback _).mapIso (eqToIso i.conormal_obj) ≪≫ e⟩⟩

/-- **The conormal sheaf of a regular immersion is finite locally free** (Stacks, Tag 063K). -/
theorem isFiniteLocallyFree_conormal (h : i.IsRegularImmersion d) :
    Scheme.Modules.isFiniteLocallyFree X i.conormal.obj := by
  choose V g hg hx e using h.exists_pullback_conormal_iso_free
  choose y hy using hx
  refine (Scheme.Modules.isFiniteLocallyFree_iff_exists_openCover (M := i.conormal.obj)).mpr ?_
  exact ⟨Cover.mkOfCovers X V g (fun x ↦ ⟨x, y x, hy x⟩) hg,
    fun x ↦ ⟨ULift (Fin d), inferInstance, e x⟩⟩

/-- The conormal sheaf `I/I²` of a regular immersion of codimension `d`, as a finite locally free
sheaf of rank `d` (`conormal_regular` in the roadmap; Stacks, Tag 063K). -/
noncomputable def conormal (h : i.IsRegularImmersion d) : FiniteLocallyFreeSheaf.FixedRank X d :=
  ⟨⟨i.conormal.obj, h.isFiniteLocallyFree_conormal⟩,
    (FiniteLocallyFreeSheaf.isConstantRank_iff _ _).mpr fun x ↦ by
    obtain ⟨V, g, -, ⟨y, rfl⟩, ⟨e⟩⟩ := h.exists_pullback_conormal_iso_free x
    rw [← FiniteLocallyFreeSheaf.rank_pullback_apply,
      FiniteLocallyFreeSheaf.rank_eq_of_iso (F := FiniteLocallyFreeSheaf.free V (ULift (Fin d)))
        (eqToIso (FiniteLocallyFreeSheaf.pullback_obj_obj g _) ≪≫ e ≪≫
          eqToIso (FiniteLocallyFreeSheaf.free_obj V _).symm),
      FiniteLocallyFreeSheaf.rank_free_apply]
    simp⟩

/-- The underlying sheaf of `IsRegularImmersion.conormal` is the conormal sheaf `I/I²`. -/
@[simp]
theorem conormal_obj_obj (h : i.IsRegularImmersion d) : h.conormal.obj.obj = i.conormal.obj :=
  (rfl)

end IsRegularImmersion

end Hom

end AlgebraicGeometry.Scheme
