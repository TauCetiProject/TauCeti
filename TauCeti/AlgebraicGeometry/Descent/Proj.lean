module

public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.BaseChange
public import TauCeti.RingTheory.GradedAlgebra.Descent

/-!
# The projective spectrum of a descended graded algebra

Let `S` be a flat `R`-algebra and let `D` be a graded descent datum
(`TauCeti.Algebra.DescentDatum.IsGraded`) on an `ℕ`-graded commutative `S`-algebra `B` with
grading `ℬ`. The descended algebra `D.descended` is graded by `D.descendedGrading ℬ`, and its
inclusion into `B` is a graded ring homomorphism exhibiting `B` as the base change of
`D.descended` along `R → S`. Since projective spectra commute with base change
(`AlgebraicGeometry.Proj.isPullback_map_of_isBaseChange`), the square

`Proj ℬ ⟶ Proj (D.descendedGrading ℬ)`, `Spec S ⟶ Spec R`

is cartesian: `Proj ℬ` is the base change of the projective spectrum of the descended graded
algebra. Thus the projective spectrum of a graded algebra carrying a graded descent datum, such
as the homogeneous coordinate ring of a projective scheme with a compatibly descended relatively
ample line bundle, is obtained by base change from a projective scheme over `Spec R`.

## Main results

* `TauCeti.Algebra.DescentDatum.irrelevant_le_map_descendedGradedVal`: the inclusion of the
  descended graded algebra induces a morphism of projective spectra.
* `TauCeti.Algebra.DescentDatum.isPullback_proj_map_descendedGradedVal`: `Proj ℬ` is the base
  change of `Proj (D.descendedGrading ℬ)` along `Spec S ⟶ Spec R`.

## References

* A. Grothendieck, *Revêtements étales et groupe fondamental* (SGA 1), Exposé VIII, §7
  (effectivity of descent data in the presence of an ample invertible sheaf).
* [Stacks Project, Lemma 27.11.6](https://stacks.math.columbia.edu/tag/01N2), base change of
  projective spectra.
* The Stacks Project, Chapter *Descent*, Section *Descent data for schemes over schemes*.
-/

public section

open CategoryTheory Limits AlgebraicGeometry

namespace TauCeti.Algebra.DescentDatum

universe u

variable {R S B : Type u} [CommRing R] [CommRing S] [Algebra R S] [CommRing B] [Algebra R B]
  [Algebra S B] [IsScalarTower R S B] [Module.Flat R S]
  (D : DescentDatum R S B) (ℬ : ℕ → Submodule S B) [GradedAlgebra ℬ] [D.IsGraded ℬ]

/-- The irrelevant ideal of `B` is contained in the ideal generated by the irrelevant ideal of
the descended graded algebra, so its inclusion induces a morphism of projective spectra
`Proj ℬ ⟶ Proj (D.descendedGrading ℬ)`. -/
theorem irrelevant_le_map_descendedGradedVal :
    HomogeneousIdeal.irrelevant ℬ ≤
      (HomogeneousIdeal.irrelevant (D.descendedGrading ℬ)).map (D.descendedGradedVal ℬ) :=
  HomogeneousIdeal.irrelevant_le_map_of_isBaseChange _ (D.descendedGradedVal ℬ)
    D.descended.val.commutes D.isBaseChange_descended_val

/-- **The projective spectrum of the descended graded algebra.** If `S` is flat over `R`, the
projective spectrum of a graded algebra `B` with a graded descent datum is the base change of the
projective spectrum of the descended graded algebra: the square formed by the morphism induced by
the inclusion `D.descended → B` and the coefficient projections to `Spec S` and `Spec R` is
cartesian. -/
theorem isPullback_proj_map_descendedGradedVal :
    IsPullback (Proj.map (D.descendedGradedVal ℬ) (D.irrelevant_le_map_descendedGradedVal ℬ))
      (Proj.toSpecCoeff ℬ) (Proj.toSpecCoeff (D.descendedGrading ℬ))
      (Spec.map (CommRingCat.ofHom (algebraMap R S))) :=
  Proj.isPullback_map_of_isBaseChange _ (D.descendedGradedVal ℬ) D.descended.val.commutes
    D.isBaseChange_descended_val

end TauCeti.Algebra.DescentDatum
