module

public import TauCeti.AlgebraicGeometry.AffineScheme
public import TauCeti.AlgebraicGeometry.ResidueField

/-!
# Decomposition and inertia groups of a point of a scheme

Let a group `G` act on a scheme `X` by automorphisms, `σ : G →* Aut X`, and let `x` be a point of
`X`. The *decomposition group* `D_x = TauCeti.SchemeInertia.decomposition σ x` is the stabilizer of
`x`. An element `g` of `D_x` acts on the residue field `κ(x)`: it is the residue field map of the
automorphism `σ g⁻¹`, which fixes `x`. This is the action of `G` on functions by pullback along
inverses, `g • a = (σ g⁻¹)^*(a)` (`AlgebraicGeometry.Scheme.globalSectionsMulSemiringAction`),
evaluated at `x`. The resulting homomorphism `TauCeti.SchemeInertia.residueAction σ x` from `D_x`
to the ring automorphisms of `κ(x)` has kernel the *inertia group* `I_x`
(`TauCeti.SchemeInertia.inertia σ x`), a normal subgroup of `D_x`.

Moving the point by `g` conjugates both groups by `g`: `D_{g x} = g D_x g⁻¹` and
`I_{g x} = g I_x g⁻¹`. This is what makes the decomposition and inertia groups of the points of a
`G`-orbit a single conjugacy class of subgroups.

Both groups are compared with the decomposition and inertia groups of commutative algebra. The
global functions vanishing at `x` form the prime ideal `P` of `Γ(X, ⊤)` corresponding to the point
`X.toSpecΓ x` of `Spec Γ(X, ⊤)`. For every scheme, `D_x` lies in the stabilizer of `P` and `I_x`
lies in Mathlib's `Ideal.inertia G P`, the elements acting trivially on `Γ(X, ⊤) ⧸ P`. When `X` is
quasi-affine, in particular affine, both inclusions are equalities: the point `x` is determined by
`P`, and the residue field `κ(x)` is generated by the values at `x` of global functions. For
`X = Spec B` with `G` acting on the ring `B`, Mathlib's results on decomposition and inertia groups
of primes in Galois extensions therefore apply to `D_x` and `I_x`.

## Main definitions

* `TauCeti.SchemeInertia.decomposition σ x`: the stabilizer of `x` in `G`.
* `TauCeti.SchemeInertia.residueAction σ x`: the action of the decomposition group on `κ(x)`.
* `TauCeti.SchemeInertia.inertia σ x`: the elements of the decomposition group acting trivially on
  `κ(x)`.

## Main results

* `TauCeti.SchemeInertia.residueAction_Γevaluation`: the action on `κ(x)` is the action on global
  functions, evaluated at `x`.
* `TauCeti.SchemeInertia.decomposition_apply_eq_map_conj`,
  `TauCeti.SchemeInertia.inertia_apply_eq_map_conj`: moving the point by `g` conjugates the
  decomposition and inertia groups by `g`.
* `TauCeti.SchemeInertia.decomposition_eq_stabilizer`,
  `TauCeti.SchemeInertia.inertia_eq_ideal_inertia`: on a quasi-affine scheme, the decomposition and
  inertia groups of `x` are the stabilizer and the inertia group of the prime ideal of global
  functions vanishing at `x`.

## References

* A. Grothendieck, *SGA 1*, Exposé V, §2.
* J.-P. Serre, *Local Fields*, Chapter I, §7.
-/

public section

open CategoryTheory AlgebraicGeometry Pointwise

universe u

namespace TauCeti.SchemeInertia

variable {X : Scheme.{u}} {G : Type*} [Group G] (σ : G →* Aut X)

/-- The action of `G` on the points of `X` through `σ`: `g • x = σ g x`. -/
@[instance_reducible]
private def pointAction : MulAction G X where
  smul g x := (σ g).asIso.hom x
  -- The `show`s unfold the `smul` field just defined, so that `simp` sees `σ` applied to `x`.
  one_smul x := show (σ 1).asIso.hom x = x by simp
  mul_smul g k x := show (σ (g * k)).asIso.hom x = (σ g).asIso.hom ((σ k).asIso.hom x) by simp

/-- The **decomposition group** of a point `x` for an action `σ` of `G` on a scheme `X`: the
stabilizer of `x`. -/
def decomposition (x : X) : Subgroup G :=
  letI := pointAction σ
  MulAction.stabilizer G x

variable {σ} in
/-- An element lies in the decomposition group of `x` exactly when it fixes `x`. -/
@[simp]
theorem mem_decomposition_iff {x : X} {g : G} :
    g ∈ decomposition σ x ↔ (σ g).asIso.hom x = x :=
  .rfl

/-- The map induced on `κ(x)` by `σ g` when `σ g` fixes `x`. Since pullback of functions
reverses composition, `g ↦ residueFieldHom σ g` reverses products. -/
private noncomputable def residueFieldHom {x : X} {g : G} (hg : g ∈ decomposition σ x) :
    X.residueField x ⟶ X.residueField x :=
  (X.residueFieldCongr (mem_decomposition_iff.mp hg)).inv ≫ (σ g).asIso.hom.residueFieldMap x

variable {σ}

private theorem residueFieldHom_congr {x : X} {g k : G} (e : g = k) (hg : g ∈ decomposition σ x)
    (hk : k ∈ decomposition σ x) : residueFieldHom σ hg = residueFieldHom σ hk := by
  subst e
  rfl

private theorem residueFieldHom_one {x : X} (h : (1 : G) ∈ decomposition σ x) :
    residueFieldHom σ h = 𝟙 _ := by
  have e : (σ 1).asIso.hom = 𝟙 X := by rw [map_one, Aut.one_asIso, Iso.refl_hom]
  refine (Scheme.Hom.residueFieldCongr_inv_residueFieldMap_congr e _ rfl).trans ?_
  rw [Scheme.residueFieldCongr_inv_residueFieldMap_id]
  simp

private theorem residueFieldHom_mul {x : X} {g k : G} (hg : g ∈ decomposition σ x)
    (hk : k ∈ decomposition σ x) :
    residueFieldHom σ (mul_mem hg hk) = residueFieldHom σ hg ≫ residueFieldHom σ hk := by
  have e : (σ (g * k)).asIso.hom = (σ k).asIso.hom ≫ (σ g).asIso.hom := by
    rw [map_mul, Aut.mul_asIso, Iso.trans_hom]
  have hgk : ((σ k).asIso.hom ≫ (σ g).asIso.hom) x = x :=
    e ▸ mem_decomposition_iff.mp (mul_mem hg hk)
  exact (Scheme.Hom.residueFieldCongr_inv_residueFieldMap_congr e _ hgk).trans
    (Scheme.Hom.residueFieldCongr_inv_residueFieldMap_comp _ _ (mem_decomposition_iff.mp hk)
      (mem_decomposition_iff.mp hg) hgk)

private theorem residueFieldHom_inv_comp {x : X} {g : G} (hg : g ∈ decomposition σ x) :
    residueFieldHom σ (inv_mem hg) ≫ residueFieldHom σ hg = 𝟙 _ := by
  rw [← residueFieldHom_mul, residueFieldHom_congr (inv_mul_cancel g) _ (one_mem _),
    residueFieldHom_one]

private theorem residueFieldHom_comp_inv {x : X} {g : G} (hg : g ∈ decomposition σ x) :
    residueFieldHom σ hg ≫ residueFieldHom σ (inv_mem hg) = 𝟙 _ := by
  rw [← residueFieldHom_mul, residueFieldHom_congr (mul_inv_cancel g) _ (one_mem _),
    residueFieldHom_one]

variable (σ) in
/-- The **action of the decomposition group on the residue field** `κ(x)`: `g` acts by the
residue field map of `σ g⁻¹`, which fixes `x`. On values of global functions this is the action
`g • a = (σ g⁻¹)^*(a)` of `G` on `Γ(X, ⊤)` (`residueAction_Γevaluation`). -/
noncomputable def residueAction (x : X) : decomposition σ x →* RingAut (X.residueField x) where
  toFun g :=
    { toFun := residueFieldHom σ (inv_mem g.2)
      invFun := residueFieldHom σ g.2
      left_inv a := by
        rw [← CommRingCat.comp_apply, residueFieldHom_inv_comp, CommRingCat.id_apply]
      right_inv a := by
        rw [← CommRingCat.comp_apply, residueFieldHom_comp_inv, CommRingCat.id_apply]
      map_mul' := map_mul _
      map_add' := map_add _ }
  map_one' := by
    ext a
    simp [residueFieldHom_one]
  map_mul' g k := by
    ext a
    simp only [Subgroup.coe_mul, RingEquiv.coe_mk, Equiv.coe_fn_mk, RingAut.mul_apply]
    rw [← CommRingCat.comp_apply, ← residueFieldHom_mul]
    exact congr($(residueFieldHom_congr (mul_inv_rev (g : G) k) _ _) a)

/-- The decomposition group acts on `κ(x)` through the residue field map of `σ g⁻¹`, with its
source `κ(σ g⁻¹ x)` identified with `κ(x)`. -/
theorem residueAction_apply {x : X} (g : decomposition σ x) (a : X.residueField x) :
    residueAction σ x g a =
      ((X.residueFieldCongr (mem_decomposition_iff.mp (inv_mem g.2))).inv ≫
        (σ (g : G)⁻¹).asIso.hom.residueFieldMap x) a :=
  (rfl)

private theorem residueAction_eq_one_iff {x : X} (g : decomposition σ x) :
    residueAction σ x g = 1 ↔ residueFieldHom σ (inv_mem g.2) = 𝟙 _ := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · ext a
    exact congr($h a)
  · ext a
    exact congr($h a)

/-- The action of the decomposition group on `κ(x)` is its action on global functions,
`g • a = (σ g⁻¹)^*(a)`, followed by evaluation at `x`. -/
theorem residueAction_Γevaluation {x : X} (g : decomposition σ x) (a : Γ(X, ⊤)) :
    letI := Scheme.globalSectionsMulSemiringAction σ
    residueAction σ x g (X.Γevaluation x a) = X.Γevaluation x ((g : G) • a) := by
  rw [residueAction_apply, Scheme.Hom.residueFieldCongr_inv_residueFieldMap_Γevaluation,
    Scheme.globalSectionsMulSemiringAction_smul_def]

variable (σ) in
/-- The **inertia group** of a point `x` for an action `σ` of `G` on a scheme `X`: the elements of
the decomposition group acting trivially on the residue field `κ(x)`. -/
noncomputable def inertia (x : X) : Subgroup G :=
  (residueAction σ x).ker.map (decomposition σ x).subtype

/-- An element lies in the inertia group of `x` exactly when it fixes `x` and acts trivially on
`κ(x)`. -/
theorem mem_inertia_iff {x : X} {g : G} :
    g ∈ inertia σ x ↔ ∃ h : g ∈ decomposition σ x, residueAction σ x ⟨g, h⟩ = 1 := by
  simp [inertia, MonoidHom.mem_ker]

/-- The inertia group is contained in the decomposition group. -/
theorem inertia_le_decomposition (x : X) : inertia σ x ≤ decomposition σ x :=
  fun _ hg ↦ (mem_inertia_iff.mp hg).1

/-- Inside the decomposition group, the inertia group is the kernel of the action on `κ(x)`. -/
theorem inertia_subgroupOf_decomposition (x : X) :
    (inertia σ x).subgroupOf (decomposition σ x) = (residueAction σ x).ker :=
  Subgroup.comap_map_eq_self_of_injective (decomposition σ x).subtype_injective _

/-- The inertia group is a normal subgroup of the decomposition group. -/
instance (x : X) : ((inertia σ x).subgroupOf (decomposition σ x)).Normal := by
  rw [inertia_subgroupOf_decomposition]
  infer_instance

/-- **Conjugation of decomposition groups.** The decomposition group of `g x` is the conjugate of
that of `x` by `g`. -/
theorem decomposition_apply_eq_map_conj (g : G) (x : X) :
    decomposition σ ((σ g).asIso.hom x) = (decomposition σ x).map (MulAut.conj g).toMonoidHom :=
  letI := pointAction σ
  MulAction.stabilizer_smul_eq_stabilizer_map_conj g x

/-- The map induced on `κ(σ g x)` by `σ (g k g⁻¹)`, for `k` fixing `x`, is the map induced on
`κ(x)` by `σ k`, transported along the residue field maps of `σ g` and `σ g⁻¹`. -/
private theorem residueFieldHom_conj {x : X} {k : G} (hk : k ∈ decomposition σ x) (g : G)
    (hx : (σ g⁻¹).asIso.hom ((σ g).asIso.hom x) = x)
    (hgk : g * k * g⁻¹ ∈ decomposition σ ((σ g).asIso.hom x)) :
    residueFieldHom σ hgk = (σ g).asIso.hom.residueFieldMap x ≫ residueFieldHom σ hk ≫
      (X.residueFieldCongr hx).inv ≫ (σ g⁻¹).asIso.hom.residueFieldMap ((σ g).asIso.hom x) := by
  have hkx : (σ k).asIso.hom x = x := mem_decomposition_iff.mp hk
  have hy : ((σ k).asIso.hom ≫ (σ g).asIso.hom) x = (σ g).asIso.hom x := by
    rw [Scheme.Hom.comp_apply, hkx]
  have e : (σ (g * k * g⁻¹)).asIso.hom =
      (σ g⁻¹).asIso.hom ≫ (σ k).asIso.hom ≫ (σ g).asIso.hom := by
    simp
  have hm : ((σ g⁻¹).asIso.hom ≫ (σ k).asIso.hom ≫ (σ g).asIso.hom) ((σ g).asIso.hom x) =
      (σ g).asIso.hom x := by
    rw [Scheme.Hom.comp_apply, hx, hy]
  refine (Scheme.Hom.residueFieldCongr_inv_residueFieldMap_congr e _ hm).trans ?_
  rw [Scheme.Hom.residueFieldCongr_inv_residueFieldMap_comp _ _ hx hy hm,
    Scheme.Hom.residueFieldCongr_inv_residueFieldMap_comp _ _ hkx rfl hy]
  simp [residueFieldHom]

private theorem conj_mem_inertia {x : X} {k : G} (hk : k ∈ inertia σ x) (g : G) :
    g * k * g⁻¹ ∈ inertia σ ((σ g).asIso.hom x) := by
  obtain ⟨hkD, hk1⟩ := mem_inertia_iff.mp hk
  set y := (σ g).asIso.hom x
  have hD : g * k * g⁻¹ ∈ decomposition σ y := by
    rw [decomposition_apply_eq_map_conj, Subgroup.mem_map_equiv, MulAut.conj_symm_apply]
    simpa [mul_assoc] using hkD
  refine mem_inertia_iff.mpr ⟨hD, (residueAction_eq_one_iff ⟨_, hD⟩).mpr ?_⟩
  have hx : (σ g⁻¹).asIso.hom y = x := by simp [y]
  have hD' : g * k⁻¹ * g⁻¹ ∈ decomposition σ y := by simpa [mul_assoc] using inv_mem hD
  have hD₁ : g * 1 * g⁻¹ ∈ decomposition σ y := by simp
  -- Conjugating the trivial action of `1` shows that the transport maps are mutually inverse.
  have h₁ := residueFieldHom_conj (one_mem _) g hx hD₁
  rw [residueFieldHom_congr (by group) hD₁ (one_mem _), residueFieldHom_one, residueFieldHom_one,
    Category.id_comp] at h₁
  rw [residueFieldHom_congr (by group) _ hD', residueFieldHom_conj (inv_mem hkD) g hx hD',
    (residueAction_eq_one_iff ⟨k, hkD⟩).mp hk1, Category.id_comp, ← h₁]

/-- **Conjugation of inertia groups.** The inertia group of `g x` is the conjugate of that of `x`
by `g`. -/
theorem inertia_apply_eq_map_conj (g : G) (x : X) :
    inertia σ ((σ g).asIso.hom x) = (inertia σ x).map (MulAut.conj g).toMonoidHom := by
  ext k
  rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply]
  constructor
  · intro hk
    simpa using conj_mem_inertia hk g⁻¹
  · intro hk
    simpa [mul_assoc] using conj_mem_inertia hk g

/-- The decomposition group of `x` stabilizes the prime ideal of global functions vanishing at
`x`. -/
theorem decomposition_le_stabilizer (x : X) :
    letI := Scheme.globalSectionsMulSemiringAction σ
    decomposition σ x ≤ MulAction.stabilizer G (X.toSpecΓ x).asIdeal := by
  let _ := Scheme.globalSectionsMulSemiringAction σ
  intro g hg
  rw [MulAction.mem_stabilizer_iff, ← Scheme.toSpecΓ_apply_asIdeal_eq_smul,
    mem_decomposition_iff.mp hg]

/-- On a quasi-affine scheme, the decomposition group of `x` is the stabilizer of the prime ideal of
global functions vanishing at `x`. -/
theorem decomposition_eq_stabilizer [X.IsQuasiAffine] (x : X) :
    letI := Scheme.globalSectionsMulSemiringAction σ
    decomposition σ x = MulAction.stabilizer G (X.toSpecΓ x).asIdeal := by
  refine le_antisymm (decomposition_le_stabilizer x) fun g hg ↦ mem_decomposition_iff.mpr ?_
  -- A point of a quasi-affine scheme is determined by its image in `Spec Γ(X, ⊤)`.
  exact X.toSpecΓ.isEmbedding.injective
    (PrimeSpectrum.ext ((Scheme.toSpecΓ_apply_asIdeal_eq_smul σ g x).trans hg))

/-- The inertia group of `x` acts trivially modulo the prime ideal of global functions vanishing at
`x`. -/
theorem inertia_le_ideal_inertia (x : X) :
    letI := Scheme.globalSectionsMulSemiringAction σ
    inertia σ x ≤ (X.toSpecΓ x).asIdeal.inertia G := by
  let _ := Scheme.globalSectionsMulSemiringAction σ
  intro g hg
  obtain ⟨hgD, hg1⟩ := mem_inertia_iff.mp hg
  refine Ideal.mem_inertia.mpr fun a ↦ ?_
  rw [Scheme.toSpecΓ_apply_asIdeal, RingHom.mem_ker, map_sub, sub_eq_zero,
    ← residueAction_Γevaluation ⟨g, hgD⟩, hg1, RingAut.one_apply]

/-- On a quasi-affine scheme, the inertia group of `x` is the inertia group of the prime ideal of
global functions vanishing at `x`: the elements acting trivially modulo this prime. -/
theorem inertia_eq_ideal_inertia [X.IsQuasiAffine] (x : X) :
    letI := Scheme.globalSectionsMulSemiringAction σ
    inertia σ x = (X.toSpecΓ x).asIdeal.inertia G := by
  let _ := Scheme.globalSectionsMulSemiringAction σ
  refine le_antisymm (inertia_le_ideal_inertia x) fun g hg ↦ ?_
  have hgD : g ∈ decomposition σ x := by
    rw [decomposition_eq_stabilizer]
    exact Ideal.inertia_le_stabilizer _ hg
  refine mem_inertia_iff.mpr ⟨hgD, (residueAction_eq_one_iff ⟨g, hgD⟩).mpr ?_⟩
  -- On a quasi-affine scheme, a map out of `κ(x)` is determined on values of global functions.
  refine Scheme.residueField_hom_ext ?_
  ext a
  have ha := Ideal.mem_inertia.mp hg a
  rw [Scheme.toSpecΓ_apply_asIdeal, RingHom.mem_ker, map_sub, sub_eq_zero] at ha
  exact (residueAction_Γevaluation ⟨g, hgD⟩ a).trans ha

end TauCeti.SchemeInertia
