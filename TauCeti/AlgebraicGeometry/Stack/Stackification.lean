module

public import TauCeti.AlgebraicGeometry.Sites.Etale.Covering
public import TauCeti.AlgebraicGeometry.Sites.Fppf.Covering
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.IsStack

/-!
# Stackification on the big fppf and étale sites of a scheme

The stackification `TauCeti.Stack.stackification J F` of a prestack adjoins descent data along
`w`-small covering families; it is a stack when every covering sieve of `J` contains a covering
sieve generated by a `w`-small family (`TauCeti.Stack.isStack_stackification`). For a scheme
`S : Scheme.{u}`, the big fppf and étale sites `Over S` have objects in `Type (u + 1)` and
morphisms in `Type u`, and their covering sieves have this property for `w = u`: covering families
of schemes are jointly surjective, so they can be indexed by the points of the target (Mathlib's
`Precoverage.Small` instance for `Scheme.precoverage`). Hence the stackification along `u`-small
families of a prestack on these sites is a stack.

## Main declarations

* `AlgebraicGeometry.Scheme.isStack_stackification_fppfTopology_over`,
  `AlgebraicGeometry.Scheme.isStack_stackification_etaleTopology_over`: the stackification of a
  prestack on these sites is a stack.
-/

public section

universe v' u' u

open CategoryTheory Bicategory

namespace AlgebraicGeometry.Scheme

variable (S : Scheme.{u})

open TauCeti.Stack in
/-- The stackification of a prestack for the fppf topology on `Over S`, adjoining descent data
along `u`-small covering families, is a stack for the fppf topology. -/
instance isStack_stackification_fppfTopology_over
    (F : LocallyDiscrete (Over S)ᵒᵖ ⥤ᵖ Cat.{v', u'}) [F.IsPrestack (fppfTopology.over S)] :
    (stackification.{u} (fppfTopology.over S) F).IsStack (fppfTopology.over S) :=
  isStack_stackification _ _ fun _ _ hR ↦ exists_ofArrows_le_of_mem_fppfTopology_over S hR

open TauCeti.Stack in
/-- The stackification of a prestack for the étale topology on `Over S`, adjoining descent data
along `u`-small covering families, is a stack for the étale topology. -/
instance isStack_stackification_etaleTopology_over
    (F : LocallyDiscrete (Over S)ᵒᵖ ⥤ᵖ Cat.{v', u'}) [F.IsPrestack (etaleTopology.over S)] :
    (stackification.{u} (etaleTopology.over S) F).IsStack (etaleTopology.over S) :=
  isStack_stackification _ _ fun _ _ hR ↦ exists_ofArrows_le_of_mem_etaleTopology_over S hR

end AlgebraicGeometry.Scheme
