module

public import TauCeti.AlgebraicGeometry.Rigid.Affinoid.Presheaf
public import TauCeti.RingTheory.Affinoid.Subdomain.Preimage
public import TauCeti.Topology.GTopology.Finite

/-!
# The weak classical affinoid site

The affinoid subdomains of a classical affinoid spectrum are closed under intersections,
and contain the empty set and the whole spectrum. Their weak G-topology declares a family
admissible when it is contained in its target and has a finite subcover. Thus the associated
site is generated by finite affinoid covers. It is defined on the same inclusion preorder
as `AffinoidSubdomain.presheaf`, so that presheaf is available for affinoid-cover descent.
No sheaf condition is asserted here.

The `Fact (IsAffinoidAlgebra K A)` assumption supplies the order instances without choosing
any norm, presentation, or additional representation data on the ambient algebra.

## References

* Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*, §§7.2.2 and 9.1.4.
-/

public section

namespace TauCeti.AffinoidSubdomain

open CategoryTheory

universe u

section Site

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {A : Type u} [CommRing A] [Algebra K A] [hA : Fact (IsAffinoidAlgebra K A)]

/-- Affinoid subdomains are closed under intersection. -/
noncomputable instance : SemilatticeInf (AffinoidSubdomain K A) where
  inf U V := ⟨(U : Set _) ∩ V, by
    obtain ⟨B, _, _, φ, h⟩ := U.isAffinoidSubdomainMap.exists_inter hA.out
      V.isAffinoidSubdomainMap
    exact ⟨CommAlgCat.of K B, φ, h⟩⟩
  inf_le_left := fun _ _ ↦ Set.inter_subset_left
  inf_le_right := fun _ _ ↦ Set.inter_subset_right
  le_inf := fun _ _ _ h₁ h₂ ↦ Set.subset_inter h₁ h₂

@[simp]
theorem coe_inf (U V : AffinoidSubdomain K A) :
    (↑(U ⊓ V) : Set (MaximalSpectrum A)) = (U : Set _) ∩ V := (rfl)

@[simp]
theorem mem_inf (U V : AffinoidSubdomain K A) (x : MaximalSpectrum A) :
    x ∈ U ⊓ V ↔ x ∈ U ∧ x ∈ V := Iff.rfl

/-- The weak G-topology of an affinoid spectrum: covers admit finite affinoid subcovers.
Its associated Grothendieck topology is the weak classical affinoid site. -/
noncomputable def weakGTopology : GTopology (setEmbedding (K := K) (A := A)) :=
  GTopology.finiteCovers (setEmbedding (K := K) (A := A))
    (by simpa only [setEmbedding_apply] using (coe_top (K := K) (A := A)))
    (fun U V ↦ by simpa only [setEmbedding_apply] using coe_inf U V)

/-- An admissible weak cover is contained in its target and has a finite subcover. -/
@[simp]
theorem weakGTopology_covers_iff {U : AffinoidSubdomain K A}
    {S : Set (AffinoidSubdomain K A)} :
    weakGTopology.Covers U S ↔ (∀ V ∈ S, V ≤ U) ∧
      ∃ R ⊆ S, R.Finite ∧
        ⋃₀ ((fun V : AffinoidSubdomain K A ↦ (V : Set (MaximalSpectrum A))) '' R) =
          (U : Set (MaximalSpectrum A)) := by
  simp only [weakGTopology, GTopology.finiteCovers_covers_iff, setEmbedding_apply]

/-- A finite family of affinoid subdomains covers weakly exactly when it covers as sets. -/
theorem weakGTopology_covers_iff_of_finite {U : AffinoidSubdomain K A}
    {S : Set (AffinoidSubdomain K A)} (hS : S.Finite) :
    weakGTopology.Covers U S ↔
      ⋃₀ ((fun V : AffinoidSubdomain K A ↦ (V : Set (MaximalSpectrum A))) '' S) =
        (U : Set (MaximalSpectrum A)) := by
  simp only [weakGTopology, GTopology.finiteCovers_covers_iff_of_finite _ _ _ hS,
    setEmbedding_apply]

/-- The weak site is generated by finite affinoid covers. -/
theorem mem_weakGTopology_grothendieckTopology_iff {U : AffinoidSubdomain K A}
    {R : Sieve U} :
    R ∈ weakGTopology.grothendieckTopology U ↔
      ∃ S : Set (AffinoidSubdomain K A), S.Finite ∧
        ⋃₀ ((fun V : AffinoidSubdomain K A ↦ (V : Set (MaximalSpectrum A))) '' S) =
          (U : Set (MaximalSpectrum A)) ∧ GTopology.coverPresieve U S ≤ R := by
  simp only [weakGTopology, GTopology.mem_finiteCovers_grothendieckTopology_iff,
    setEmbedding_apply]

/-- An empty weak cover is possible only for the empty affinoid subdomain.
Use with `rw`: simplification first expands covers by `weakGTopology_covers_iff`. -/
theorem weakGTopology_covers_empty_iff {U : AffinoidSubdomain K A} :
    weakGTopology.Covers U ∅ ↔ U = ⊥ := by
  rw [weakGTopology_covers_iff_of_finite Set.finite_empty]
  simp only [Set.image_empty, Set.sUnion_empty]
  exact ⟨fun h ↦ SetLike.coe_injective (h.symm.trans coe_bot.symm), fun h ↦ by simp [h]⟩

end Site

end TauCeti.AffinoidSubdomain
