import Mathlib.Algebra.Category.Ring.FilteredColimits
import Mathlib.RingTheory.Filtration

/-!
# The analytic stalks of an affinoid space

Let `A` be an affinoid algebra and `x` a classical point of `Sp A = MaximalSpectrum A`. The
analytic stalk `𝒪_{Sp A,x}` is the fibre, as commutative rings, of the presheaf of coordinate
algebras `TauCeti.AffinoidSubdomain.presheaf` at the site point of `x` for the weak affinoid
G-topology: the colimit of the coordinate algebras of the affinoid subdomains containing `x`.
No sheaf condition is used.

We show that this stalk is a local ring whose maximal ideal is generated by `𝔪ₓ`, that the germ
map `A → 𝒪_{Sp A,x}` factors through an injective local map `A_𝔪 → 𝒪_{Sp A,x}`, and that it
induces `A ⧸ 𝔪ₓⁿ ≃ 𝒪_{Sp A,x} ⧸ 𝔪ⁿ` for every `n`. A germ is a unit exactly when it does not
vanish at `x`: a section `f` over `U ∋ x` with `f(x) ≠ 0` is invertible on the rational
subdomain `{|ϖⁿ| ≤ |f|}` of `U` for large `n`. Membership of a germ in an extended ideal is
witnessed on a single affinoid neighbourhood, so the infinitesimal comparison passes to the
colimit from the isomorphisms `A ⧸ 𝔪ₓⁿ ≃ B ⧸ 𝔪ₓⁿ B` for each subdomain. Injectivity of
`A_𝔪 → 𝒪_{Sp A,x}` is Krull's intersection theorem in `A_𝔪`.

These local statements are what the stalk maps of morphisms of affinoid spaces, and hence the
local description of immersions, are built on; they also give the comparison of the `𝔪`-adic
completions of `A_𝔪` and `𝒪_{Sp A,x}` through their quotients by powers of the maximal ideal.

## Main definitions

* `TauCeti.AffinoidSubdomain.stalk K x`: the analytic stalk `𝒪_{Sp A,x}`.
* `TauCeti.AffinoidSubdomain.germ`: the germ at `x` of a section over `U ∋ x`.
* `TauCeti.AffinoidSubdomain.toStalk`: the germ map `A → 𝒪_{Sp A,x}`.
* `TauCeti.AffinoidSubdomain.localizationToStalk`: the factorisation `A_𝔪 → 𝒪_{Sp A,x}`.
* `TauCeti.AffinoidSubdomain.quotientPowEquiv`: `A ⧸ 𝔪ₓⁿ ≃ 𝒪_{Sp A,x} ⧸ 𝔪ⁿ`.

## Main results

* `TauCeti.AffinoidSubdomain.isUnit_germ_iff`: a germ is a unit iff it does not vanish at `x`.
* `TauCeti.AffinoidSubdomain.instIsLocalRingStalk`: the stalk is a local ring.
* `TauCeti.AffinoidSubdomain.maximalIdeal_stalk`: its maximal ideal is `𝔪ₓ 𝒪_{Sp A,x}`.
* `TauCeti.AffinoidSubdomain.localizationToStalk_injective`: `A_𝔪 → 𝒪_{Sp A,x}` is injective.

## References

* S. Bosch, *Lectures on Formal and Rigid Geometry*, Lecture Notes in Mathematics 2105,
  Springer, 2014, §4.1, Propositions 1 and 2.
-/

public section

open CategoryTheory Opposite IsLocalRing

namespace TauCeti.AffinoidSubdomain

universe u

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {A : Type u} [CommRing A] [Algebra K A] [hA : Fact (IsAffinoidAlgebra K A)]

variable (K A) in
/-- The presheaf of coordinate algebras of affinoid subdomains, as commutative rings. -/
noncomputable abbrev ringPresheaf : (AffinoidSubdomain K A)ᵒᵖ ⥤ CommRingCat.{u} :=
  presheaf (K := K) (A := A) ⋙ forget₂ (CommAlgCat.{u} K) CommRingCat.{u}

omit hA in
/-- The restriction maps of `ringPresheaf` are `restrict`. -/
theorem ringPresheaf_map_apply {U V : AffinoidSubdomain K A} (h : U ≤ V) (f : V.sections) :
    (ringPresheaf K A).map (homOfLE h).op f = restrict h f :=
  DFunLike.congr_fun (presheaf_map_hom h) f

variable (K) in
/-- The analytic stalk `𝒪_{Sp A,x}`: the fibre of the presheaf of coordinate rings at the site
point of `x` for the weak affinoid G-topology. -/
noncomputable abbrev stalk (x : MaximalSpectrum A) : CommRingCat.{u} :=
  ((weakGTopology (K := K) (A := A)).point x).presheafFiber.obj (ringPresheaf K A)

/-- The germ at `x` of a section over an affinoid subdomain containing `x`. -/
noncomputable def germ (U : AffinoidSubdomain K A) {x : MaximalSpectrum A} (hx : x ∈ U) :
    U.sections →+* stalk K x :=
  ((weakGTopology.point x).toPresheafFiber U
    (weakGTopology.pointElement x (by simpa using hx)) (ringPresheaf K A)).hom

variable (K) in
/-- The germ map `A → 𝒪_{Sp A,x}`. -/
noncomputable def toStalk (x : MaximalSpectrum A) : A →+* stalk K x :=
  (germ ⊤ (mem_top x)).comp (⊤ : AffinoidSubdomain K A).toSections.toRingHom

variable {x : MaximalSpectrum A}

/-- The germ map of `A` is the germ on the whole spectrum. -/
theorem toStalk_apply (a : A) :
    toStalk K x a = germ ⊤ (mem_top x) ((⊤ : AffinoidSubdomain K A).toSections a) :=
  (rfl)

/-- Germs are compatible with restriction. -/
@[simp]
theorem germ_restrict {U V : AffinoidSubdomain K A} (h : U ≤ V) (hx : x ∈ U) (f : V.sections) :
    germ U hx (restrict h f) = germ V (h hx) f :=
  ringPresheaf_map_apply h f ▸
    (weakGTopology.point x).toPresheafFiber_w_apply (homOfLE h) _ (ringPresheaf K A) f

/-- The germ of the restriction of `a ∈ A` is the germ of `a`. -/
@[simp]
theorem germ_toSections {U : AffinoidSubdomain K A} (hx : x ∈ U) (a : A) :
    germ U hx (U.toSections a) = toStalk K x a := by
  rw [toStalk_apply, ← restrict_toSections (le_top : U ≤ ⊤), germ_restrict]

/-- The germ map of `A` factors through the coordinate algebra of every neighbourhood of `x`. -/
theorem germ_comp_toSections {U : AffinoidSubdomain K A} (hx : x ∈ U) :
    (germ U hx).comp U.toSections.toRingHom = toStalk K x :=
  RingHom.ext (germ_toSections hx)

/-- Every element of the stalk is the germ of a section over an affinoid neighbourhood. -/
theorem exists_germ_eq (s : stalk K x) :
    ∃ (U : AffinoidSubdomain K A) (hx : x ∈ U) (f : U.sections), germ U hx f = s := by
  obtain ⟨U, hx, f, rfl⟩ := weakGTopology.exists_toPresheafFiber_pointElement_eq s
  -- The fibre maps of `ringPresheaf` are `germ`, by definition.
  exact ⟨U, by simpa using hx, f, rfl⟩

/-- Two sections have the same germ at `x` iff they agree on a common smaller affinoid
neighbourhood of `x`. -/
theorem germ_eq_germ_iff {U V : AffinoidSubdomain K A} (hU : x ∈ U) (hV : x ∈ V)
    (f : U.sections) (g : V.sections) :
    germ U hU f = germ V hV g ↔
      ∃ (W : AffinoidSubdomain K A) (hWU : W ≤ U) (hWV : W ≤ V), x ∈ W ∧
        restrict hWU f = restrict hWV g := by
  have := weakGTopology.toPresheafFiber_pointElement_eq_iff (P := ringPresheaf K A)
    (by simpa using hU) (by simpa using hV) f g
  simp only [setEmbedding_apply, SetLike.mem_coe, ringPresheaf_map_apply] at this
  -- The fibre maps of `ringPresheaf` are `germ`, by definition.
  exact this

/-- The germ of a section in `J 𝒪(U)` lies in `J 𝒪_{Sp A,x}`. -/
theorem germ_mem_map_toStalk {U : AffinoidSubdomain K A} (hx : x ∈ U) {J : Ideal A}
    {f : U.sections} (hf : f ∈ J.map U.toSections) : germ U hx f ∈ J.map (toStalk K x) := by
  rw [← germ_comp_toSections hx, ← Ideal.map_map]
  exact Ideal.mem_map_of_mem _ hf

/-- **Membership in an extended ideal is local.** The germ of `f` lies in `J 𝒪_{Sp A,x}` iff some
restriction of `f` to an affinoid neighbourhood `W` of `x` lies in `J 𝒪(W)`. -/
theorem germ_mem_map_toStalk_iff {U : AffinoidSubdomain K A} (hx : x ∈ U) (f : U.sections)
    (J : Ideal A) :
    germ U hx f ∈ J.map (toStalk K x) ↔
      ∃ (W : AffinoidSubdomain K A) (hWU : W ≤ U), x ∈ W ∧ restrict hWU f ∈ J.map W.toSections := by
  refine ⟨fun hf ↦ ?_, fun ⟨W, hWU, hxW, hW⟩ ↦ ?_⟩
  · -- Every element of `J 𝒪_{Sp A,x}` is the germ of an element of some `J 𝒪(V)`.
    obtain ⟨V, hxV, g, hg, hgf⟩ : ∃ (V : AffinoidSubdomain K A) (hxV : x ∈ V) (g : V.sections),
        g ∈ J.map V.toSections ∧ germ V hxV g = germ U hx f := by
      refine Submodule.span_induction (p := fun s _ ↦ ∃ (V : AffinoidSubdomain K A) (hxV : x ∈ V)
        (g : V.sections), g ∈ J.map V.toSections ∧ germ V hxV g = s) ?_ ?_ ?_ ?_ hf
      · rintro _ ⟨a, ha, rfl⟩
        exact ⟨⊤, mem_top x, _, Ideal.mem_map_of_mem _ ha, germ_toSections _ a⟩
      · exact ⟨⊤, mem_top x, 0, zero_mem _, map_zero _⟩
      · rintro _ _ - - ⟨V₁, hx₁, g₁, hg₁, rfl⟩ ⟨V₂, hx₂, g₂, hg₂, rfl⟩
        refine ⟨V₁ ⊓ V₂, (mem_inf _ _ _).mpr ⟨hx₁, hx₂⟩,
          restrict inf_le_left g₁ + restrict inf_le_right g₂,
          add_mem (restrict_mem_map _ hg₁) (restrict_mem_map _ hg₂), ?_⟩
        rw [map_add, germ_restrict, germ_restrict]
      · rintro c _ - ⟨V₁, hx₁, g₁, hg₁, rfl⟩
        obtain ⟨V₂, hx₂, g₂, rfl⟩ := exists_germ_eq c
        refine ⟨V₁ ⊓ V₂, (mem_inf _ _ _).mpr ⟨hx₁, hx₂⟩,
          restrict inf_le_right g₂ * restrict inf_le_left g₁,
          Ideal.mul_mem_left _ _ (restrict_mem_map _ hg₁), ?_⟩
        rw [map_mul, germ_restrict, germ_restrict, smul_eq_mul]
    obtain ⟨W, hWV, hWU, hxW, hW⟩ := (germ_eq_germ_iff hxV hx g f).mp hgf
    exact ⟨W, hWU, hxW, hW ▸ restrict_mem_map hWV hg⟩
  · rw [← germ_restrict hWU hxW]
    exact germ_mem_map_toStalk hxW hW

/-- A section that does not vanish at `x` is invertible on a smaller affinoid neighbourhood of
`x`, namely on a rational subdomain `{y ∈ U : |ϖ|ⁿ ≤ |f(y)|}`. -/
theorem exists_isUnit_restrict {U : AffinoidSubdomain K A} (hx : x ∈ U) {f : U.sections}
    (hf : f ∉ x.asIdeal.map U.toSections) :
    ∃ (W : AffinoidSubdomain K A) (hWU : W ≤ U), x ∈ W ∧ IsUnit (restrict hWU f) := by
  have hB := U.isAffinoidAlgebra
  -- The point `y` of `Sp 𝒪(U)` over `x`, at which `f` does not vanish.
  let y : MaximalSpectrum U.sections := ⟨_, U.isAffinoidSubdomainMap.isMaximal_map hA.out hx⟩
  have hy : hB.maximalSpectrumComap U.toSections y = x :=
    MaximalSpectrum.ext ((hB.maximalSpectrumComap_asIdeal _ _).trans
      (U.isAffinoidSubdomainMap.comap_map_of_mem hA.out hx))
  obtain ⟨ϖ, hϖ₀, hϖ₁⟩ := NormedField.exists_norm_lt_one K
  obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one
    ((pointNorm_nonneg f).lt_of_ne (Ne.symm ((hB.pointNorm_eq_zero_iff (x := y)).not.mpr hf))) hϖ₁
  have htop : Ideal.span (insert f (Set.range fun _ : Fin 1 ↦ algebraMap K U.sections (ϖ ^ n))) =
      ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨0, rfl⟩))
      ((IsUnit.pow n (Ne.isUnit (norm_pos_iff.mp hϖ₀))).map (algebraMap K _))
  -- The rational subdomain `{|ϖ|ⁿ ≤ |f|}` of `Sp 𝒪(U)`, pushed forward to `Sp A`.
  let W' := rational hB htop
  have hW' (z : MaximalSpectrum U.sections) :
      z ∈ W' ↔ pointNorm K z f ≠ 0 ∧ ‖ϖ‖ ^ n ≤ pointNorm K z f := by
    rw [← SetLike.mem_coe, coe_rational, mem_rationalDomain]
    simp only [forall_const, pointNorm_algebraMap, norm_pow, ne_eq]
  refine ⟨U.mapSubdomain hA.out W', U.mapSubdomain_le hA.out W', ?_, ?_⟩
  · rw [← SetLike.mem_coe, coe_mapSubdomain]
    exact ⟨y, (hW' y).mpr ⟨(hn.trans_le' (by positivity)).ne', hn.le⟩, hy⟩
  · have hW := (U.mapSubdomain hA.out W').isAffinoidAlgebra
    refine hW.isUnit_iff_forall_pointNorm_ne_zero.mpr fun z ↦ ?_
    rw [← hW.pointNorm_maximalSpectrumComap]
    have hz : hB.maximalSpectrumComap U.toSections
        (hW.maximalSpectrumComap (restrict (U.mapSubdomain_le hA.out W')) z) ∈
          (U.mapSubdomain hA.out W' : Set (MaximalSpectrum A)) :=
      (isAffinoidSubdomainMap_restrict (U.mapSubdomain_le hA.out W')
        ).range_maximalSpectrumComap_subset ⟨z, rfl⟩
    rw [coe_mapSubdomain,
      (U.isAffinoidSubdomainMap.maximalSpectrumComap_injective hA.out).mem_set_image] at hz
    exact ((hW' _).mp hz).1

/-- **Units of the stalk.** The germ of `f` is a unit iff `f` does not vanish at `x`. -/
theorem isUnit_germ_iff {U : AffinoidSubdomain K A} (hx : x ∈ U) {f : U.sections} :
    IsUnit (germ U hx f) ↔ f ∉ x.asIdeal.map U.toSections := by
  refine ⟨fun hu hf ↦ ?_, fun hf ↦ ?_⟩
  · -- Otherwise `1` lies in `𝔪ₓ 𝒪(W)` for an affinoid neighbourhood `W` of `x`.
    have h1 : germ ⊤ (mem_top x) 1 ∈ x.asIdeal.map (toStalk K x) := by
      obtain ⟨c, hc⟩ := hu.exists_right_inv
      rw [map_one, ← hc]
      exact Ideal.mul_mem_right _ _ (germ_mem_map_toStalk hx hf)
    obtain ⟨W, hWU, hxW, hW⟩ := (germ_mem_map_toStalk_iff _ _ _).mp h1
    rw [map_one] at hW
    exact (W.isAffinoidSubdomainMap.isMaximal_map hA.out hxW).ne_top
      ((Ideal.eq_top_iff_one _).mpr hW)
  · obtain ⟨W, hWU, hxW, hW⟩ := exists_isUnit_restrict hx hf
    rw [← germ_restrict hWU hxW]
    exact hW.map _

/-- The germ of `a ∈ A` is a unit iff `a` does not vanish at `x`. -/
theorem isUnit_toStalk_iff {a : A} : IsUnit (toStalk K x a) ↔ a ∉ x.asIdeal := by
  rw [← germ_toSections (mem_top x) a, isUnit_germ_iff, ← Ideal.mem_comap,
    (⊤ : AffinoidSubdomain K A).isAffinoidSubdomainMap.comap_map_of_mem hA.out (mem_top x)]

/-- **The analytic stalks are local rings.** -/
instance instIsLocalRingStalk : IsLocalRing (stalk K x) := by
  -- If `0 = 1`, then the germ of `0 ∈ 𝔪ₓ` would be a unit.
  have : Nontrivial (stalk K x) := ⟨⟨0, 1, fun h ↦ (isUnit_toStalk_iff (K := K) (x := x)).mp
    (by rw [map_zero, h]; exact isUnit_one) x.asIdeal.zero_mem⟩⟩
  refine .of_isUnit_or_isUnit_one_sub_self fun s ↦ ?_
  obtain ⟨U, hx, f, rfl⟩ := exists_germ_eq s
  rw [← map_one (germ U hx), ← map_sub, isUnit_germ_iff, isUnit_germ_iff]
  by_contra! h
  exact (U.isAffinoidSubdomainMap.isMaximal_map hA.out hx).ne_top
    ((Ideal.eq_top_iff_one _).mpr (by simpa using add_mem h.1 h.2))

/-- **The maximal ideal of the analytic stalk** is generated by `𝔪ₓ`. -/
theorem maximalIdeal_stalk : maximalIdeal (stalk K x) = x.asIdeal.map (toStalk K x) := by
  refine le_antisymm (fun s hs ↦ ?_) (Ideal.map_le_iff_le_comap.mpr fun a ha ↦ ?_)
  · obtain ⟨U, hx, f, rfl⟩ := exists_germ_eq s
    have hf : f ∈ x.asIdeal.map U.toSections := by
      simpa [isUnit_germ_iff] using (mem_maximalIdeal _).mp hs
    exact germ_mem_map_toStalk hx hf
  · exact (mem_maximalIdeal _).mpr (by simpa [isUnit_toStalk_iff] using ha)

/-- The germ map `A → 𝒪_{Sp A,x}` pulls the maximal ideal back to `𝔪ₓ`. -/
theorem comap_maximalIdeal_stalk : (maximalIdeal (stalk K x)).comap (toStalk K x) = x.asIdeal :=
  Ideal.ext fun a ↦ by simp [mem_maximalIdeal, isUnit_toStalk_iff]

variable (K x) in
/-- The factorisation `A_𝔪 → 𝒪_{Sp A,x}` of the germ map through the localisation at `x`. -/
noncomputable def localizationToStalk : Localization.AtPrime x.asIdeal →+* stalk K x :=
  IsLocalization.lift (M := x.asIdeal.primeCompl) fun a ↦ isUnit_toStalk_iff.mpr a.property

/-- The germ map `A → 𝒪_{Sp A,x}` factors through `A_𝔪`. -/
@[simp]
theorem localizationToStalk_algebraMap (a : A) :
    localizationToStalk K x (algebraMap A _ a) = toStalk K x a :=
  IsLocalization.lift_eq _ a

/-- **The germ map from the local ring is injective.** -/
theorem localizationToStalk_injective : Function.Injective (localizationToStalk K x) := by
  -- By Krull's intersection theorem in `A_𝔪`: an element of `A` with zero germ lies in every
  -- power of `𝔪ₓ`.
  have := hA.out.isNoetherianRing
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective x.asIdeal.primeCompl z
  have hs := IsLocalization.map_units (Localization.AtPrime x.asIdeal) s
  rw [← hs.mul_left_eq_zero, IsLocalization.mk'_spec]
  -- The germ of `a` vanishes, so `a` vanishes on an affinoid neighbourhood `W` of `x`.
  have ha : germ ⊤ (mem_top x) ((⊤ : AffinoidSubdomain K A).toSections a) =
      germ ⊤ (mem_top x) 0 := by
    rw [germ_toSections, map_zero, ← localizationToStalk_algebraMap,
      ← IsLocalization.mk'_spec (Localization.AtPrime x.asIdeal) a s, map_mul, hz, zero_mul]
  obtain ⟨W, _, _, hxW, hW0⟩ := (germ_eq_germ_iff _ _ _ _).mp ha
  rw [restrict_toSections, map_zero] at hW0
  have hmem : a ∈ ⨅ y ∈ (W : Set (MaximalSpectrum A)), ⨅ n : ℕ, y.asIdeal ^ n :=
    W.isAffinoidSubdomainMap.ker_eq_iInf_pow hA.out ▸ RingHom.mem_ker.mpr hW0
  simp only [Ideal.mem_iInf] at hmem
  rw [← Ideal.mem_bot, ← Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal _)
    (maximalIdeal.isMaximal _).ne_top, Ideal.mem_iInf]
  intro n
  rw [← Localization.AtPrime.map_eq_maximalIdeal, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ (hmem x hxW n)

/-- The germ map `A_𝔪 → 𝒪_{Sp A,x}` is a local homomorphism. -/
instance : IsLocalHom (localizationToStalk K x) := by
  refine ⟨fun z hz ↦ ?_⟩
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective x.asIdeal.primeCompl z
  rw [IsLocalization.AtPrime.isUnit_mk'_iff]
  have hs := (localizationToStalk K x).isUnit_map
    (IsLocalization.map_units (Localization.AtPrime x.asIdeal) s)
  dsimp only at hz
  refine (isUnit_toStalk_iff (K := K)).mp ?_
  rw [← localizationToStalk_algebraMap,
    ← IsLocalization.mk'_spec (Localization.AtPrime x.asIdeal) a s, map_mul]
  exact hz.mul hs

/-- The powers of the maximal ideal of the stalk are generated by the powers of `𝔪ₓ`. -/
theorem maximalIdeal_stalk_pow (n : ℕ) :
    maximalIdeal (stalk K x) ^ n = (x.asIdeal ^ n).map (toStalk K x) := by
  rw [maximalIdeal_stalk, Ideal.map_pow]

variable (K x) in
/-- **Infinitesimal neighbourhoods of the stalk.** The germ map induces
`A ⧸ 𝔪ₓⁿ ≃ 𝒪_{Sp A,x} ⧸ 𝔪ⁿ` for every `n`. -/
noncomputable def quotientPowEquiv (n : ℕ) :
    A ⧸ x.asIdeal ^ n ≃+* stalk K x ⧸ maximalIdeal (stalk K x) ^ n := by
  refine RingEquiv.ofBijective (Ideal.quotientMap _ (toStalk K x)
    (maximalIdeal_stalk_pow (K := K) (x := x) n ▸ Ideal.le_comap_map))
    ⟨Ideal.quotientMap_injective' ?_, ?_⟩
  · -- An element whose germ lies in `𝔪ₓⁿ 𝒪_{Sp A,x}` lies in `𝔪ₓⁿ 𝒪(W)` for some `W ∋ x`.
    intro a ha
    rw [Ideal.mem_comap, maximalIdeal_stalk_pow, ← germ_toSections (mem_top x),
      germ_mem_map_toStalk_iff] at ha
    obtain ⟨W, hW, hxW, ha⟩ := ha
    rw [restrict_toSections] at ha
    rw [← Ideal.Quotient.eq_zero_iff_mem] at ha ⊢
    apply (W.isAffinoidSubdomainMap.quotientPowAlgEquiv hA.out hxW n).injective
    rw [IsAffinoidSubdomainMap.quotientPowAlgEquiv_mk, ha, map_zero]
  · -- A section over `U ∋ x` agrees with an element of `A` modulo `𝔪ₓⁿ 𝒪(U)`.
    intro s
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective s
    obtain ⟨U, hx, f, rfl⟩ := exists_germ_eq s
    obtain ⟨a, ha⟩ := (U.isAffinoidSubdomainMap.quotientPowAlgEquiv hA.out hx n).surjective
      (Ideal.Quotient.mk _ f)
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [IsAffinoidSubdomainMap.quotientPowAlgEquiv_mk, Ideal.Quotient.eq] at ha
    refine ⟨Ideal.Quotient.mk _ a, ?_⟩
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq, maximalIdeal_stalk_pow, ← germ_toSections hx,
      ← map_sub]
    exact germ_mem_map_toStalk hx ha

/-- The comparison `A ⧸ 𝔪ₓⁿ ≃ 𝒪_{Sp A,x} ⧸ 𝔪ⁿ` sends the class of `a` to the class of its
germ. -/
@[simp]
theorem quotientPowEquiv_mk (n : ℕ) (a : A) :
    quotientPowEquiv K x n (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (toStalk K x a) :=
  (rfl)

end TauCeti.AffinoidSubdomain
