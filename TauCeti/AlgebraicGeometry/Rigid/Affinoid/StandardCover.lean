module

public import TauCeti.AlgebraicGeometry.Rigid.Affinoid.AdicComparison
import TauCeti.AlgebraicGeometry.AdicSpace.Spa.StructurePresheaf.StandardCover.Cech

/-!
# Tate acyclicity for standard rational covers

Let `A` be an affinoid algebra over a complete nonarchimedean field `K` and let `T ⊆ A` be a
nonempty finite set generating the unit ideal. The standard rational domains

`R(T/t) = {x ∈ Sp A | |t(x)| ≠ 0, |t'(x)| ≤ |t(x)| for t' ∈ T}`,    `t ∈ T`,

cover `Sp A`. This file proves Tate's acyclicity theorem for this cover: the augmented Čech complex
of the coordinate presheaf of affinoid subdomains, as a presheaf of abelian groups, is exact in
every degree. In degree zero this is the existence and uniqueness of gluing; in positive degrees
it is the vanishing of the Čech cohomology of the cover. Nilpotents are retained.

The proof transports Wedhorn's Lemma 8.34(ii) for the standard rational cover of
`Spa(A, A°)` generated by `T`
(`TauCeti.ValuationSpectrum.quasiIso_cechAugmentation_inf_spaBasicOpen_of_span_eq_top`), which
applies since affinoid algebras are strongly noetherian Tate rings, along the comparison of
classical and adic Čech complexes of rational opens
(`TauCeti.AffinoidSubdomain.quasiIso_cechAugmentation_ofSpaRationalOpen_iff`). The classical
domain `R(T/t)` is the classical trace of the rational open `R(T/t)` of `Spa(A, A°)`.

## Main results

* `TauCeti.AffinoidSubdomain.quasiIso_cechAugmentation_of_span_eq_top`: the augmented Čech
  complex of the coordinate presheaf for the standard rational cover generated by `T` is exact.

## References

* [Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*][bosch-guntzer-remmert], §8.2.2,
  Theorem 1 (Tate's acyclicity theorem).
* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Lemma 8.34.
-/

public section

open CategoryTheory Limits TopologicalSpace TauCeti.Huber TauCeti.ValuationSpectrum
  TauCeti.CategoryTheory

namespace TauCeti.AffinoidSubdomain

universe u

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  {A : Type u} [NormedCommRing A] [IsUltrametricDist A] [NormedAlgebra K A] [CompleteSpace A]
  [hA : Fact (IsAffinoidAlgebra K A)]

/-- **Tate's acyclicity theorem for standard rational covers.** Let `A` be an affinoid algebra
with a complete ultrametric algebra norm and `T ⊆ A` a nonempty finite set generating the unit
ideal. Let `U t` be the standard rational domain `{x | |t(x)| ≠ 0, |t'(x)| ≤ |t(x)| for t' ∈ T}`,
for `t ∈ T`. Then the augmented Čech complex of the coordinate presheaf of affinoid subdomains,
as a presheaf of abelian groups, for the cover `U` of `Sp A` is exact in every degree. -/
theorem quasiIso_cechAugmentation_of_span_eq_top {T : Finset A} (hT : T.Nonempty)
    (hspan : Ideal.span (T : Set A) = ⊤) (U : T → AffinoidSubdomain K A)
    (hU : ∀ t x, x ∈ U t ↔
      pointNorm K x t ≠ 0 ∧ ∀ t' ∈ T, pointNorm K x t' ≤ pointNorm K x t) :
    QuasiIso (cechAugmentation U isTerminalTop (presheaf ⋙ forget₂ (CommAlgCat K) CommRingCat ⋙
      forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat)) := by
  have := IsTateRing.of_normedAlgebra K A
  have := hA.out.isStronglyNoetherian
  obtain ⟨P⟩ := IsHuberRing.nonempty_pairOfDefinition (A := A)
  have hT' : IsOpen (Ideal.span (T : Set A) : Set A) := by
    rw [hspan]
    exact isOpen_univ
  have hV (t : T) : spaBasicOpen (powerBoundedSubring A) T t ∈
      spaRationalOpens (powerBoundedSubring A) :=
    spaBasicOpen_mem_spaRationalOpens hT'
  -- `U t` is the classical trace of the rational open `R(T/t)`.
  have hUV : U = fun t ↦ ofSpaRationalOpen (K := K) (hV t) :=
    funext fun t ↦ ext fun x ↦ by
      rw [hU, mem_ofSpaRationalOpen, maximalSpectrumToSpa_mem_spaBasicOpen_iff]
  rw [hUV, quasiIso_cechAugmentation_ofSpaRationalOpen_iff P hV]
  have h := quasiIso_cechAugmentation_inf_spaBasicOpen_of_span_eq_top P P.le_powerBoundedSubring
    (fun _ ha ↦ mem_powerBoundedSubring.mp ha) hT hspan (top_mem_spaRationalOpens _)
  have e : (fun t : T ↦ (⟨⊤ ⊓ spaBasicOpen (powerBoundedSubring A) T t,
      Set.mem_Iic.2 inf_le_left⟩ : Set.Iic (⊤ : Opens (spa (powerBoundedSubring A))))) =
      fun t ↦ ⟨spaBasicOpen (powerBoundedSubring A) T t, Set.mem_Iic.2 le_top⟩ :=
    funext fun t ↦ Subtype.ext (top_inf_eq _)
  rwa [e] at h

end TauCeti.AffinoidSubdomain
