module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
import TauCeti.RingTheory.Ideal.Colon

/-!
# Colon ideal sheaves

Let `I` and `J` be quasi-coherent ideal sheaves on a scheme `X`, represented as
`Scheme.IdealSheafData`. When `J` is locally finitely generated on affine opens, the ideal
quotients `(I(U) : J(U))` commute with localization to basic opens
(`Ideal.map_colon_of_isLocalization`) and therefore assemble into a quasi-coherent ideal sheaf
`I.colon J hJ`.

The colon ideal sheaf satisfies the residuation universal property `K ≤ I.colon J hJ ↔ J * K ≤ I`,
commutes with restriction along open immersions, and agrees with the ring-level colon ideal on an
affine scheme.

## Main definitions

* `AlgebraicGeometry.Scheme.IdealSheafData.colon`: the colon ideal sheaf `(I : J)` when `J` is
  finitely generated on every affine open.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.ideal_colon`: on each affine open `U`, `(I : J)(U)` is
  the colon ideal `(I(U) : J(U))`.
* `AlgebraicGeometry.Scheme.IdealSheafData.le_colon_iff`: `K ≤ I.colon J hJ ↔ J * K ≤ I`.
* `AlgebraicGeometry.Scheme.IdealSheafData.comap_colon_of_isOpenImmersion`: colon ideal sheaves
  commute with restriction along open immersions.
* `AlgebraicGeometry.Scheme.IdealSheafData.colon_ofIdealTop`: on an affine scheme, the colon of
  ideal sheaves generated by global ideals is generated by their colon ideal.

## References

* [The Stacks Project, Section 29.13 / Tag 01R8](https://stacks.math.columbia.edu/tag/01R8):
  quasi-coherent sheaves of ideals and ideal quotients.
* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Chapter II, Section 5.
-/

public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

noncomputable section

variable {X Y : Scheme.{u}}

/-- The **colon ideal sheaf** `(I : J)` of two ideal sheaves on a scheme `X`, where `J` is finitely
generated on every affine open. On each affine open `U` it is the ideal quotient `(I(U) : J(U))`,
which commutes with localization to basic opens by `Ideal.map_colon_of_isLocalization`. -/
def colon (I J : X.IdealSheafData) (hJ : ∀ U : X.affineOpens, (J.ideal U).FG) :
    X.IdealSheafData where
  ideal U := (I.ideal U).colon (J.ideal U : Set Γ(X, U))
  map_ideal_basicOpen U f := by
    let : Algebra Γ(X, U) Γ(X, X.basicOpen f) :=
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
    have : IsLocalization.Away f Γ(X, X.basicOpen f) :=
      U.2.isLocalization_of_eq_basicOpen _ _ rfl
    have h := Ideal.map_colon_of_isLocalization (I := I.ideal U)
      (Submonoid.powers f) Γ(X, X.basicOpen f) (hJ U)
    rw [RingHom.algebraMap_toAlgebra, I.map_ideal_basicOpen U f, J.map_ideal_basicOpen U f] at h
    exact h

/-- On each affine open `U`, the ideal of `I.colon J hJ` is the colon ideal `(I(U) : J(U))`. -/
@[simp]
theorem ideal_colon (I J : X.IdealSheafData) (hJ : ∀ U : X.affineOpens, (J.ideal U).FG)
    (U : X.affineOpens) :
    (I.colon J hJ).ideal U = (I.ideal U).colon (J.ideal U : Set Γ(X, U)) :=
  (rfl)

/-- **Universal property of the colon ideal sheaf.** An ideal sheaf `K` is contained in `(I : J)`
if and only if `J * K ≤ I`. -/
theorem le_colon_iff {I J K : X.IdealSheafData} (hJ : ∀ U : X.affineOpens, (J.ideal U).FG) :
    K ≤ I.colon J hJ ↔ J * K ≤ I := by
  simp only [le_def, ideal_colon, ideal_mul, Pi.mul_apply, Ideal.mul_le]
  refine ⟨fun h U j hj k hk ↦ ?_, fun h U k hk ↦ Submodule.mem_colon.mpr fun j hj ↦ ?_⟩
  · simpa only [smul_eq_mul, mul_comm k j] using Submodule.mem_colon.mp (h U hk) j hj
  · simpa only [smul_eq_mul, mul_comm j k] using h U j hj k hk

/-- The product `J * (I : J)` is contained in `I`. -/
theorem mul_colon_le (I J : X.IdealSheafData) (hJ : ∀ U : X.affineOpens, (J.ideal U).FG) :
    J * I.colon J hJ ≤ I :=
  (le_colon_iff hJ).mp le_rfl

/-- If `J` is locally principal on affine opens, then `J * (I : J) = I ⊓ J`. No regularity
assumption on the local generators is needed. -/
theorem mul_colon_eq_inf_of_exists_eq_span_singleton (I J : X.IdealSheafData)
    (hJ : ∀ U : X.affineOpens, (J.ideal U).FG)
    (hJp : ∀ x : X, ∃ U : X.affineOpens, x ∈ U.1 ∧ ∃ a : Γ(X, U), J.ideal U = Ideal.span {a}) :
    J * I.colon J hJ = I ⊓ J := by
  choose U hxU a hUa using hJp
  refine ext_of_iSup_eq_top U
    (eq_top_iff.mpr fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxU x⟩) fun x ↦ ?_
  simp only [ideal_mul, Pi.mul_apply, ideal_colon, ideal_inf, Pi.inf_apply, hUa x,
    Ideal.colon_span]
  exact (Ideal.inf_span_singleton_eq_span_singleton_mul_colon (I.ideal (U x)) (a x)).symm

/-- The colon ideal sheaf is covariant in the numerator and contravariant in the denominator. -/
theorem colon_mono {I₁ I₂ J₁ J₂ : X.IdealSheafData} (hI : I₁ ≤ I₂) (hJ : J₂ ≤ J₁)
    (hJ₁ : ∀ U : X.affineOpens, (J₁.ideal U).FG) (hJ₂ : ∀ U : X.affineOpens, (J₂.ideal U).FG) :
    I₁.colon J₁ hJ₁ ≤ I₂.colon J₂ hJ₂ := fun U ↦
  Submodule.colon_mono (hI U) (hJ U)

/-- Every ideal sheaf is contained in its colon by any finitely generated ideal sheaf. -/
theorem le_colon (I J : X.IdealSheafData) (hJ : ∀ U : X.affineOpens, (J.ideal U).FG) :
    I ≤ I.colon J hJ := fun _ ↦
  Ideal.le_colon

/-- `(I : J)` is the unit ideal sheaf if and only if `J ≤ I`. -/
@[simp]
theorem colon_eq_top_iff (I J : X.IdealSheafData) (hJ : ∀ U : X.affineOpens, (J.ideal U).FG) :
    I.colon J hJ = ⊤ ↔ J ≤ I := by
  rw [← top_le_iff, le_colon_iff, mul_top]

/-- Dividing an ideal sheaf by itself yields the unit ideal sheaf. -/
@[simp]
theorem colon_self (I : X.IdealSheafData) (hI : ∀ U : X.affineOpens, (I.ideal U).FG) :
    I.colon I hI = ⊤ :=
  (colon_eq_top_iff I I hI).mpr le_rfl

/-- Dividing the unit ideal sheaf by any finitely generated ideal sheaf yields the unit ideal
sheaf. -/
@[simp]
theorem top_colon (J : X.IdealSheafData) (hJ : ∀ U : X.affineOpens, (J.ideal U).FG) :
    (⊤ : X.IdealSheafData).colon J hJ = ⊤ :=
  (colon_eq_top_iff ⊤ J hJ).mpr le_top

/-- Dividing an ideal sheaf by the unit ideal sheaf leaves it unchanged. -/
@[simp]
theorem colon_top (I : X.IdealSheafData)
    (h : ∀ U : X.affineOpens, ((⊤ : X.IdealSheafData).ideal U).FG) :
    I.colon ⊤ h = I := by
  ext U : 2
  exact Submodule.colon_univ

/-- The colon of an intersection is the intersection of the colons. -/
theorem inf_colon (I₁ I₂ J : X.IdealSheafData) (hJ : ∀ U : X.affineOpens, (J.ideal U).FG) :
    (I₁ ⊓ I₂).colon J hJ = I₁.colon J hJ ⊓ I₂.colon J hJ := by
  ext U : 2
  exact Submodule.inf_colon

/-- The colon by a sum of ideal sheaves is the intersection of the colons. -/
theorem colon_sup (I J₁ J₂ : X.IdealSheafData)
    (hJ₁ : ∀ U : X.affineOpens, (J₁.ideal U).FG) (hJ₂ : ∀ U : X.affineOpens, (J₂.ideal U).FG)
    (hsup : ∀ U : X.affineOpens, ((J₁ ⊔ J₂).ideal U).FG) :
    I.colon (J₁ ⊔ J₂) hsup = I.colon J₁ hJ₁ ⊓ I.colon J₂ hJ₂ := by
  refine le_antisymm (le_inf (colon_mono le_rfl le_sup_left hsup hJ₁)
    (colon_mono le_rfl le_sup_right hsup hJ₂)) ?_
  rw [le_colon_iff, inf_mul]
  exact sup_le
    ((mul_le_mul_of_nonneg_left inf_le_left bot_le).trans (mul_colon_le I J₁ hJ₁))
    ((mul_le_mul_of_nonneg_left inf_le_right bot_le).trans (mul_colon_le I J₂ hJ₂))

/-- Pulling back a locally finitely generated ideal sheaf along an open immersion preserves finite
generation on every affine open. -/
theorem fg_ideal_comap_of_isOpenImmersion {J : Y.IdealSheafData}
    (hJ : ∀ U : Y.affineOpens, (J.ideal U).FG) (f : X ⟶ Y) [IsOpenImmersion f]
    (U : X.affineOpens) : ((J.comap f).ideal U).FG := by
  have h (K : Ideal Γ(Y, f ''ᵁ U)) :
      K.comap (f.appIso U).inv.hom = K.map (f.appIso U).hom.hom :=
    Ideal.comap_symm (f.appIso U).commRingCatIsoToRingEquiv
  rw [ideal_comap_of_isOpenImmersion, h]
  exact (hJ ⟨f ''ᵁ U.1, U.2.image_of_isOpenImmersion f⟩).map _

/-- **Colon ideal sheaves commute with restriction along open immersions.** -/
theorem comap_colon_of_isOpenImmersion (I J : Y.IdealSheafData)
    (hJ : ∀ U : Y.affineOpens, (J.ideal U).FG) (f : X ⟶ Y) [IsOpenImmersion f] :
    (I.colon J hJ).comap f =
      (I.comap f).colon (J.comap f) (fg_ideal_comap_of_isOpenImmersion hJ f) := by
  ext U : 2
  simp only [ideal_comap_of_isOpenImmersion, ideal_colon]
  ext x
  simp only [Ideal.mem_comap, Submodule.mem_colon, smul_eq_mul, SetLike.mem_coe]
  refine ⟨fun h y hy ↦ ?_, fun h y hy ↦ ?_⟩
  · have hxy := h ((f.appIso U).inv.hom y) hy
    rwa [← map_mul] at hxy
  · have hy' : (f.appIso U).inv.hom ((f.appIso U).hom.hom y) ∈
        J.ideal ⟨f ''ᵁ U.1, U.2.image_of_isOpenImmersion f⟩ := by
      simpa only [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply] using hy
    have hxy := h ((f.appIso U).hom.hom y) hy'
    simpa only [map_mul, ← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply] using hxy

/-- An ideal sheaf generated by a finitely generated global ideal is finitely generated on every
affine open. -/
theorem fg_ideal_ofIdealTop {J₀ : Ideal Γ(X, ⊤)} (hJ₀ : J₀.FG) (U : X.affineOpens) :
    ((ofIdealTop J₀).ideal U).FG :=
  hJ₀.map _

/-- On an affine scheme, the colon of ideal sheaves generated by global ideals is generated by
their colon ideal. -/
theorem colon_ofIdealTop [IsAffine X] (I₀ J₀ : Ideal Γ(X, ⊤))
    (hJ : ∀ U : X.affineOpens, ((ofIdealTop J₀).ideal U).FG) :
    (ofIdealTop I₀).colon (ofIdealTop J₀) hJ = ofIdealTop (I₀.colon (J₀ : Set Γ(X, ⊤))) := by
  apply ext_of_isAffine
  simp only [ideal_colon, ofIdealTop_ideal, homOfLE_refl, op_id, CategoryTheory.Functor.map_id,
    CommRingCat.hom_id, Ideal.map_id]

end

end AlgebraicGeometry.Scheme.IdealSheafData
