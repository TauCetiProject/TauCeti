module

public import TauCeti.AlgebraicGeometry.IdealSheaf.Locality
public import TauCeti.AlgebraicGeometry.IdealSheaf.OfIdealTop

/-!
# Inverse images of products of ideal sheaves

For a morphism of schemes `f : X ⟶ Y`, the inverse image `I.comap f` of an ideal sheaf `I` on `Y`
is the ideal sheaf `f⁻¹I·𝒪_X`. This file shows that it is multiplicative:
`(I * J).comap f = I.comap f * J.comap f`. Mathlib already has `comap_sup`, `comap_bot` and
`comap_top`. With multiplicativity, taking inverse images respects all the semiring operations on
ideal sheaves.

These are unconditional identities of ideal sheaves. When the ideals involved, including their
inverse images, define effective Cartier divisors, they give the corresponding compatibility of
divisor sums with pullback.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.comap_mul`: `(I * J).comap f = I.comap f * J.comap f`.
* `AlgebraicGeometry.Scheme.IdealSheafData.comap_pow`: `(I ^ n).comap f = I.comap f ^ n`.
* `AlgebraicGeometry.Scheme.IdealSheafData.comap_prod`: the inverse image of a finite product is
  the product of the inverse images.
-/

public section

open CategoryTheory Limits

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X Y : Scheme.{u}}

/-- Along an open immersion, the inverse image of a product of ideal sheaves is the product of the
inverse images: on each affine open, both are pulled back along the same ring isomorphism. -/
private lemma comap_mul_of_isOpenImmersion (I J : Y.IdealSheafData) (f : X ⟶ Y)
    [IsOpenImmersion f] : (I * J).comap f = I.comap f * J.comap f := by
  ext U : 2
  simp only [ideal_comap_of_isOpenImmersion, ideal_mul, Pi.mul_apply]
  -- Pulling back along the inverse of a ring isomorphism is pushing forward along it.
  have h (K : Ideal Γ(Y, f ''ᵁ U)) :
      K.comap (f.appIso U).inv.hom = K.map (f.appIso U).hom.hom :=
    Ideal.comap_symm (f.appIso U).commRingCatIsoToRingEquiv
  rw [h, h, h, Ideal.map_mul]

/-- Over an affine target, the inverse image of a product of ideal sheaves is the product of the
inverse images, since every ideal sheaf there is generated by its global sections. -/
private lemma comap_mul_of_isAffine [IsAffine Y] (I J : Y.IdealSheafData) (f : X ⟶ Y) :
    (I * J).comap f = I.comap f * J.comap f := by
  let I₀ : Ideal Γ(Y, ⊤) := equivOfIsAffine I
  let J₀ : Ideal Γ(Y, ⊤) := equivOfIsAffine J
  have hI : I = ofIdealTop I₀ := by
    simpa only [I₀, equivOfIsAffine_symm_apply] using
      (equivOfIsAffine.symm_apply_apply I).symm
  have hJ : J = ofIdealTop J₀ := by
    simpa only [J₀, equivOfIsAffine_symm_apply] using
      (equivOfIsAffine.symm_apply_apply J).symm
  calc
    (I * J).comap f = (ofIdealTop (I₀ * J₀)).comap f := by rw [hI, hJ, ofIdealTop_mul]
    _ = ofIdealTop ((I₀ * J₀).map f.appTop.hom) := comap_ofIdealTop _ _
    _ = ofIdealTop (I₀.map f.appTop.hom * J₀.map f.appTop.hom) := by rw [Ideal.map_mul]
    _ = ofIdealTop (I₀.map f.appTop.hom) * ofIdealTop (J₀.map f.appTop.hom) :=
      ofIdealTop_mul _ _
    _ = (ofIdealTop I₀).comap f * (ofIdealTop J₀).comap f := by
      rw [comap_ofIdealTop, comap_ofIdealTop]
    _ = I.comap f * J.comap f := by rw [← hI, ← hJ]

/-- **Inverse images of ideal sheaves are multiplicative.** For every morphism `f : X ⟶ Y`, the
inverse image of `I * J` is `I.comap f * J.comap f`. If these ideals define effective Cartier
divisors, this is the ideal-sheaf identity underlying compatibility of their sum with pullback. -/
@[simp]
theorem comap_mul (I J : Y.IdealSheafData) (f : X ⟶ Y) :
    (I * J).comap f = I.comap f * J.comap f := by
  -- The proof is local on `X`. Pull back the affine open cover of `Y`; on each member, transport
  -- across the pullback square, use multiplicativity over the affine target, and then restrict
  -- back along the two open immersions.
  refine ext_of_comap_openCover (Y.affineCover.pullback₁ f) fun (i : Y.affineCover.I₀) ↦ ?_
  let g := (Y.affineCover.pullback₁ f).f i
  let u := Y.affineCover.f i
  let p := Y.affineCover.pullbackHom f i
  have : IsOpenImmersion g := by
    dsimp [g]
    exact Scheme.Cover.map_prop (𝒰 := Y.affineCover.pullback₁ f) i
  have : IsOpenImmersion u := by
    dsimp [u]
    exact Scheme.Cover.map_prop (𝒰 := Y.affineCover) i
  have hsq : p ≫ u = g ≫ f := by
    dsimp [p, u, g]
    exact Scheme.Cover.pullbackHom_map Y.affineCover f i
  calc
    ((I * J).comap f).comap g = (I * J).comap (g ≫ f) := (comap_comp _ _ _).symm
    _ = (I * J).comap (p ≫ u) := by rw [hsq]
    _ = ((I * J).comap u).comap p := comap_comp _ _ _
    _ = (I.comap u * J.comap u).comap p := by rw [comap_mul_of_isOpenImmersion]
    _ = (I.comap u).comap p * (J.comap u).comap p := comap_mul_of_isAffine _ _ _
    _ = I.comap (p ≫ u) * J.comap (p ≫ u) := by rw [comap_comp, comap_comp]
    _ = I.comap (g ≫ f) * J.comap (g ≫ f) := by rw [hsq]
    _ = (I.comap f).comap g * (J.comap f).comap g := by rw [comap_comp, comap_comp]
    _ = (I.comap f * J.comap f).comap g := (comap_mul_of_isOpenImmersion _ _ _).symm

/-- The inverse image of a power of an ideal sheaf is the power of the inverse image. When the
ideals define effective Cartier divisors, this identifies the inverse image of `n • D` with `n`
times the inverse image of `D`. -/
@[simp]
theorem comap_pow (I : Y.IdealSheafData) (f : X ⟶ Y) (n : ℕ) :
    (I ^ n).comap f = I.comap f ^ n := by
  induction n with
  | zero => simp
  | succ n hn => rw [pow_succ, pow_succ, comap_mul, hn]

/-- The inverse image of a finite product of ideal sheaves is the product of the inverse images.
When the ideals involved define effective Cartier divisors, this is the corresponding identity
for a finite sum of divisors. -/
@[simp]
theorem comap_prod {ι : Type*} (s : Finset ι) (I : ι → Y.IdealSheafData) (f : X ⟶ Y) :
    (∏ i ∈ s, I i).comap f = ∏ i ∈ s, (I i).comap f := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi hs => rw [Finset.prod_insert hi, Finset.prod_insert hi, comap_mul, hs]

end AlgebraicGeometry.Scheme.IdealSheafData
