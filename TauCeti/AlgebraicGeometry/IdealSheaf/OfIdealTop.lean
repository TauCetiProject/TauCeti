module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-!
# Ideal sheaves generated by global sections

For a scheme `X` and an ideal `I` of its ring of global sections, Mathlib's
`AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop I` is the quasi-coherent ideal sheaf `I·𝒪_X`
generated by `I`. This file records how these ideal sheaves interact with morphisms of schemes.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop_le_ker_iff`: `I·𝒪_Y` is contained in the
  kernel of `f : X ⟶ Y` exactly when `f^*` kills `I`, that is, when `f` factors through the zero
  scheme of `I`; `AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop_le_ker_comp_iff` transports
  this condition along a composite `g ≫ f`, replacing `I` by `f^*(I)`;
* `AlgebraicGeometry.Scheme.Hom.ker_Spec_map`: the kernel of `Spec S ⟶ Spec R` is the ideal sheaf
  of the kernel of the ring map;
* `AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop_eq_bot_iff`: `I·𝒪_X` vanishes exactly when
  `I` does;
* `AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop_mul`: `(IJ)·𝒪_X = (I·𝒪_X)(J·𝒪_X)`, and
  `AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop_pow`: `(Iⁿ)·𝒪_X = (I·𝒪_X)ⁿ`;
* `AlgebraicGeometry.Scheme.IdealSheafData.comap_ofIdealTop`: the inverse image ideal sheaf of
  `I·𝒪_Y` along `f : X ⟶ Y` is `f^*(I)·𝒪_X`, so the zero scheme of `I` pulls back to the zero
  scheme of `f^*(I)`;
* `AlgebraicGeometry.Scheme.IdealSheafData.comap_ofIdealTop_map_ΓSpecIso_inv`: the same inverse
  image formula for ideals of affine coordinate rings, transported through the canonical
  global-section isomorphisms;
* `AlgebraicGeometry.Scheme.Hom.ker_pullback_fst_Spec_map`: the base change of the closed
  immersion `Spec S ⟶ Spec R` along `f : X ⟶ Spec R` is the zero scheme of the ideal of `𝒪_X`
  generated by the pullback of the kernel of `R → S`.

The last statement is the scheme-theoretic form of the identity
`X ×_{Spec R} Spec (R ⧸ I) = V(I·𝒪_X)`, for instance for the fibres of a scheme over a local ring.
-/

public section

open CategoryTheory Limits TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X Y : Scheme.{u}}

/-- The ideal sheaf generated by an ideal `I` of global sections of `Y` is contained in the kernel
of `f : X ⟶ Y` exactly when the pullback of every element of `I` vanishes on `X`. -/
theorem ofIdealTop_le_ker_iff (f : X ⟶ Y) (I : Ideal Γ(Y, ⊤)) :
    ofIdealTop I ≤ f.ker ↔ I ≤ RingHom.ker f.appTop.hom := by
  rw [Scheme.Hom.ker, le_ofIdeals_iff]
  refine ⟨fun h s hs ↦ X.IsSheaf.section_ext fun x _ ↦ ?_, fun h U ↦ ?_⟩
  · -- A global section vanishes once it vanishes on the preimages of the affine opens of `Y`.
    obtain ⟨U, hU⟩ := Opens.mem_iSup.mp ((iSup_affineOpens_eq_top Y).ge (Set.mem_univ (f x)))
    refine ⟨f ⁻¹ᵁ U, le_top, hU, ?_⟩
    have hs := h U (Ideal.mem_map_of_mem _ hs)
    rw [RingHom.mem_ker, ← CommRingCat.comp_apply, f.naturality, CommRingCat.comp_apply] at hs
    -- `hs` restricts along `f ⁻¹ᵁ U ≤ f ⁻¹ᵁ ⊤`, the goal along `f ⁻¹ᵁ U ≤ ⊤`; the two opens
    -- `f ⁻¹ᵁ ⊤` and `⊤` are definitionally equal, as in the type of `Scheme.Hom.appTop`.
    exact hs.trans (map_zero _).symm
  · rw [ofIdealTop_ideal, Ideal.map_le_iff_le_comap, RingHom.comap_ker, ← CommRingCat.hom_comp,
      f.naturality, CommRingCat.hom_comp, ← RingHom.comap_ker]
    exact h.trans (Ideal.ker_le_comap _)

/-- The ideal sheaf generated by an ideal `I` of global sections of `Y` is contained in the kernel
of a composite `g ≫ f` with `f : X ⟶ Y` exactly when the ideal sheaf generated by the pullback
`f^*(I)` is contained in the kernel of `g`. -/
theorem ofIdealTop_le_ker_comp_iff {Z : Scheme.{u}} (f : X ⟶ Y) (g : Z ⟶ X)
    (I : Ideal Γ(Y, ⊤)) :
    ofIdealTop I ≤ (g ≫ f).ker ↔ ofIdealTop (I.map f.appTop.hom) ≤ g.ker := by
  rw [ofIdealTop_le_ker_iff, ofIdealTop_le_ker_iff, Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
    ← RingHom.comap_ker, Ideal.map_le_iff_le_comap]

/-- The kernel of the morphism `Spec S ⟶ Spec R` induced by a ring map `R ⟶ S` is the ideal sheaf
of the kernel of the ring map, read in the global sections of `Spec R`. -/
theorem _root_.AlgebraicGeometry.Scheme.Hom.ker_Spec_map {R S : CommRingCat.{u}} (φ : R ⟶ S) :
    (Spec.map φ).ker = ofIdealTop ((RingHom.ker φ.hom).map (Scheme.ΓSpecIso R).inv.hom) := by
  rw [Scheme.ker_of_isAffine]
  congr 1
  calc RingHom.ker (Spec.map φ).appTop.hom
      -- Composing with the isomorphism `Γ(Spec S, ⊤) ≅ S` does not change the kernel.
      _ = RingHom.ker ((Spec.map φ).appTop ≫ (Scheme.ΓSpecIso S).hom).hom :=
        (RingHom.ker_comp_of_injective _
          (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso S).hom).1).symm
      -- By naturality of `ΓSpecIso`, this composite is `φ` read through `Γ(Spec R, ⊤) ≅ R`.
      _ = (RingHom.ker φ.hom).comap (Scheme.ΓSpecIso R).hom.hom := by
        rw [Scheme.ΓSpecIso_naturality, CommRingCat.hom_comp, RingHom.comap_ker]
      -- The ring equivalence underlying `ΓSpecIso R` has `inv.hom` and `hom.hom` as its two maps.
      _ = (RingHom.ker φ.hom).map (Scheme.ΓSpecIso R).inv.hom :=
        Ideal.comap_symm (Scheme.ΓSpecIso R).symm.commRingCatIsoToRingEquiv

/-- The ideal sheaf associated to an ideal of `R` is killed by `Spec S ⟶ Spec R` exactly when
the ring map `R ⟶ S` kills that ideal. -/
@[simp]
theorem _root_.Ideal.ofIdealTop_le_ker_Spec_map_iff {R S : CommRingCat.{u}}
    (I : Ideal R) (φ : R ⟶ S) :
    Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso R).inv.hom) ≤
        (Spec.map φ).ker ↔ I ≤ RingHom.ker φ.hom := by
  rw [Scheme.Hom.ker_Spec_map, ← Scheme.IdealSheafData.equivOfIsAffine_symm_apply,
    ← Scheme.IdealSheafData.equivOfIsAffine_symm_apply, map_le_map_iff,
    Ideal.map_le_iff_le_comap,
    Ideal.comap_map_of_bijective _ (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso R).inv)]

/-- The ideal sheaf generated by an ideal `I` of global sections vanishes exactly when `I`
does. -/
@[simp]
theorem ofIdealTop_eq_bot_iff (I : Ideal Γ(X, ⊤)) : ofIdealTop I = ⊥ ↔ I = ⊥ := by
  -- The identity of `X` has kernel `⊥`, and its action on global sections is injective.
  rw [← le_bot_iff, ← Scheme.Hom.ker_eq_bot_of_isIso (𝟙 X), ofIdealTop_le_ker_iff,
    Scheme.Hom.id_appTop, CommRingCat.hom_id,
    (RingHom.injective_iff_ker_eq_bot _).mp Function.injective_id, le_bot_iff]

/-- The ideal sheaf generated by a product of ideals of global sections is the product of the
ideal sheaves they generate. -/
@[simp]
theorem ofIdealTop_mul (I J : Ideal Γ(X, ⊤)) :
    ofIdealTop (I * J) = ofIdealTop I * ofIdealTop J := by
  ext U : 2
  simp [Ideal.map_mul]

/-- The ideal sheaf generated by a power of an ideal of global sections is the corresponding power
of the ideal sheaf it generates. -/
@[simp]
theorem ofIdealTop_pow (I : Ideal Γ(X, ⊤)) (n : ℕ) : ofIdealTop (I ^ n) = ofIdealTop I ^ n := by
  ext U : 2
  simp [Ideal.map_pow]

/-- **Inverse image of the ideal sheaf generated by global sections.** The inverse image along
`f : X ⟶ Y` of the ideal sheaf generated by an ideal `I` of global sections of `Y` is the ideal
sheaf generated by the pullbacks of the elements of `I`: the zero scheme of `I` pulls back to the
zero scheme of `f^*(I)`. -/
@[simp]
theorem comap_ofIdealTop (I : Ideal Γ(Y, ⊤)) (f : X ⟶ Y) :
    (ofIdealTop I).comap f = ofIdealTop (I.map f.appTop.hom) :=
  -- Both sides are below an ideal sheaf `K` exactly when `ofIdealTop I` is contained in the kernel
  -- of `K.subschemeι ≫ f`, by the Galois connection between `comap f` and `map f`.
  eq_of_forall_ge_iff fun K ↦ by
    rw [← le_map_iff_comap_le, map, ofIdealTop_le_ker_comp_iff, ker_subschemeι]

/-- Pulling back the ideal sheaf associated to an ideal `I` of `R` along `Spec S ⟶ Spec R`
gives the ideal sheaf associated to the extended ideal in `S`, via the canonical global-section
isomorphisms. -/
theorem comap_ofIdealTop_map_ΓSpecIso_inv {R S : CommRingCat.{u}} (φ : R ⟶ S) (I : Ideal R) :
    (ofIdealTop (I.map (Scheme.ΓSpecIso R).inv.hom)).comap (Spec.map φ) =
      ofIdealTop ((I.map φ.hom).map (Scheme.ΓSpecIso S).inv.hom) := by
  simp only [comap_ofIdealTop, Ideal.map_map, ← CommRingCat.hom_comp,
    ← Scheme.ΓSpecIso_inv_naturality]

/-- **Base change of a closed subscheme of an affine scheme.** For a ring map `R ⟶ S` whose
induced morphism `Spec S ⟶ Spec R` is a closed immersion, for instance a surjective ring map, the
base change of this closed immersion along `f : X ⟶ Spec R` is the zero scheme of the ideal of
`𝒪_X` generated by the pullback of the kernel of `R ⟶ S`. -/
theorem _root_.AlgebraicGeometry.Scheme.Hom.ker_pullback_fst_Spec_map {R S : CommRingCat.{u}}
    (φ : R ⟶ S) [IsClosedImmersion (Spec.map φ)] (f : X ⟶ Spec R) :
    (pullback.fst f (Spec.map φ)).ker =
      ofIdealTop ((RingHom.ker φ.hom).map (f.appTop.hom.comp (Scheme.ΓSpecIso R).inv.hom)) := by
  rw [ker_fst_of_isClosedImmersion, Scheme.Hom.ker_Spec_map, comap_ofIdealTop, Ideal.map_map]

end AlgebraicGeometry.Scheme.IdealSheafData
