module

public import TauCeti.AlgebraicGeometry.IdealSheaf.Locality
public import TauCeti.AlgebraicGeometry.Morphisms.Finite.Basic
public import TauCeti.RingTheory.FittingIdeal.Content

/-!
# Weil restriction of a closed subscheme along a finite locally free morphism

Let `g : Y ⟶ S` be finite locally free (finite, flat and locally of finite presentation) and let
`Z = V(I) ⊆ Y` be a closed subscheme. For a scheme `T` over `S`, the base change
`Y_T = T ×_S Y ⟶ Y` may or may not factor through `Z`. This file shows that the condition is
represented by a closed subscheme of `S`: there is an ideal sheaf `I.weilRestriction g` on `S`
such that `Y_T ⟶ Y` factors through `Z` exactly when `T ⟶ S` factors through its closed
subscheme (`AlgebraicGeometry.Scheme.IdealSheafData.weilRestriction_le_ker_iff`). In other words,
the Weil restriction of `Z` along `g`, which is a subfunctor of the Weil restriction `S` of `Y`
itself, is a closed subscheme of `S`. Its formation commutes with arbitrary base change
(`AlgebraicGeometry.Scheme.IdealSheafData.weilRestriction_comap`).

Over an affine open `U ⊆ S`, the ring `B = Γ(Y, g⁻¹ U)` is a finite projective module over
`A = Γ(S, U)`, and the ideal of `I.weilRestriction g` over `U` is the content of
`J = I(g⁻¹ U) ⊆ B`: the ideal `J.minorsIdeal 1` of `A` generated by the values `φ x` of all
`A`-linear functionals `φ : B → A` at all `x ∈ J` (`Submodule.minorsIdeal_one_le_iff`). Over
affine opens of `T` lying over `U`, the sections of `Y_T` are `Γ(T, -) ⊗[A] B`, and `J` vanishes
there exactly when its content does (`IsBaseChange.minorsIdeal_one_le_ker_iff`).

Conditions of the form "a finite locally free family lies in a closed subscheme" are how the loci
of Katz and Mazur are cut out: incidence of relative effective Cartier divisors, and the subgroup
condition defining points of exact order `N` and Drinfeld level structures.

## Main definitions

* `AlgebraicGeometry.Scheme.IdealSheafData.weilRestriction g I`: the ideal sheaf on `S` cutting
  out the locus over which `Y` lies in the closed subscheme `V(I)`.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.weilRestriction_le_ker_iff`: the universal property;
  `weilRestriction_le_ker_iff_of_isPullback` states it for any pullback square.
* `AlgebraicGeometry.Scheme.IdealSheafData.weilRestriction_comap_le_ker_iff`: the condition that a
  family parametrised by a finite locally free scheme lies in a closed subscheme is closed, and
  this persists along any base change of the family.
* `AlgebraicGeometry.Scheme.IdealSheafData.le_ker_pullback_snd_subschemeι_weilRestriction`: over
  the closed subscheme of `I.weilRestriction g`, the base change of `Y` lies in `V(I)`.
* `AlgebraicGeometry.Scheme.IdealSheafData.weilRestriction_comap`: compatibility with base change.

## References

* S. Bosch, W. Lütkebohmert and M. Raynaud, *Néron Models*, §7.6, for Weil restriction.
* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, Annals of Mathematics Studies
  108, §1.6, where closed conditions on finite locally free families cut out the scheme of
  `A`-structures.
-/

public section

open CategoryTheory Limits Opposite

universe u

namespace AlgebraicGeometry

variable {Y S : Scheme.{u}} (g : Y ⟶ S)

namespace Scheme.IdealSheafData

variable [IsFinite g] [Flat g] [LocallyOfFinitePresentation g]

/-- The ideal sheaf on `S` of the **Weil restriction of the closed subscheme `V(I)`** along a
finite locally free morphism `g : Y ⟶ S`. A morphism `T ⟶ S` factors through its closed
subscheme exactly when the base change `T ×_S Y ⟶ Y` factors through `V(I)`
(`AlgebraicGeometry.Scheme.IdealSheafData.weilRestriction_le_ker_iff`). Over an affine open `U`
of `S`, it is the content (the ideal of `1 × 1` minors) of the ideal `I(g⁻¹ U)` of the finite
projective `Γ(S, U)`-module `Γ(Y, g⁻¹ U)`. -/
noncomputable def weilRestriction (I : Y.IdealSheafData) : S.IdealSheafData where
  ideal U := letI := (g.app U).hom.toAlgebra
    ((I.ideal ⟨g ⁻¹ᵁ U, U.2.preimage g⟩).restrictScalars Γ(S, U)).minorsIdeal 1
  map_ideal_basicOpen U f := by
    have hle : g ⁻¹ᵁ S.basicOpen f ≤ g ⁻¹ᵁ U.1 := g.preimage_mono (S.basicOpen_le f)
    -- `Γ(Y, g⁻¹ D(f))` is the pushout of `Γ(S, D(f))` and `Γ(Y, g⁻¹ U)` over `Γ(S, U)`
    have hpush := (isIso_pushoutSection_iff (IsPullback.of_horiz_isIso ⟨by simp⟩ :
      IsPullback (𝟙 Y) g g (𝟙 S)) (S.basicOpen_le f) le_rfl (UY := g ⁻¹ᵁ S.basicOpen f)
      (by simpa using hle)).1 (isIso_pushoutSection_of_isAffineOpen _ _ _ _ U.2
        (S.affineBasicOpen f).2 (U.2.preimage g))
    simp only [Scheme.Hom.appLE_eq_app] at hpush
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app] at hpush
    algebraize [(g.app U).hom, (S.presheaf.map (homOfLE (S.basicOpen_le f)).op).hom,
      (g.app (S.basicOpen f)).hom, (Y.presheaf.map (homOfLE hle).op).hom,
      (Y.presheaf.map (homOfLE hle).op).hom.comp (g.app U).hom]
    have : IsScalarTower Γ(S, U) Γ(S, S.basicOpen f) Γ(Y, g ⁻¹ᵁ S.basicOpen f) :=
      .of_algebraMap_eq' congr($(g.naturality (homOfLE (S.basicOpen_le f)).op).hom).symm
    have : Algebra.IsPushout Γ(S, U) Γ(S, S.basicOpen f) Γ(Y, g ⁻¹ᵁ U)
        Γ(Y, g ⁻¹ᵁ S.basicOpen f) :=
      ((CommRingCat.isPushout_iff_isPushout).1 hpush).symm
    have := g.projective_app U
    have key := Ideal.minorsIdeal_one_restrictScalars_map (A := Γ(S, U))
      (A' := Γ(S, S.basicOpen f)) (B' := Γ(Y, g ⁻¹ᵁ S.basicOpen f))
      (I.ideal ⟨g ⁻¹ᵁ U, U.2.preimage g⟩)
    simp only [RingHom.algebraMap_toAlgebra] at key
    have hI := I.map_ideal (U := ⟨g ⁻¹ᵁ S.basicOpen f, (S.affineBasicOpen f).2.preimage g⟩)
      (V := ⟨g ⁻¹ᵁ U, U.2.preimage g⟩) hle
    dsimp only at hI
    -- `rw [hI] at key` fails to find the coerced affine opens; transport along `hI` instead
    exact key.symm.trans
      (congrArg (fun J ↦ (Submodule.restrictScalars Γ(S, S.basicOpen f) J).minorsIdeal 1) hI)

/-- Over an affine open `U` of `S`, the ideal of `I.weilRestriction g` is the content (the ideal
of `1 × 1` minors) of the ideal `I(g⁻¹ U)` of the projective `Γ(S, U)`-module `Γ(Y, g⁻¹ U)`. -/
theorem weilRestriction_ideal (I : Y.IdealSheafData) (U : S.affineOpens) :
    (I.weilRestriction g).ideal U = letI := (g.app U).hom.toAlgebra
      ((I.ideal ⟨g ⁻¹ᵁ U, U.2.preimage g⟩).restrictScalars Γ(S, U)).minorsIdeal 1 :=
  (rfl)

/-- The Weil restriction is monotone: a smaller closed subscheme has a smaller Weil restriction. -/
theorem weilRestriction_mono : Monotone (weilRestriction g) := fun I J h U ↦ by
  let := (g.app U).hom.toAlgebra
  exact Submodule.minorsIdeal_mono (R := Γ(S, U)) (fun x hx ↦ h ⟨g ⁻¹ᵁ U, U.2.preimage g⟩ hx) 1

/-- The Weil restriction of `Y` itself is `S`. -/
@[simp]
theorem weilRestriction_bot : (⊥ : Y.IdealSheafData).weilRestriction g = ⊥ := by
  ext U : 2
  rw [weilRestriction_ideal]
  simp

variable {g} in
/-- The universal property over a pair of affine opens: for affine opens `U ⊆ S` and `V ⊆ T`
with `t(V) ⊆ U`, the restriction `Γ(S, U) → Γ(T, V)` kills the ideal of `I.weilRestriction g`
over `U` exactly when `I(g⁻¹ U)` vanishes on the corresponding affine open of `T ×_S Y`. -/
private theorem weilRestriction_ideal_le_ker_iff (I : Y.IdealSheafData) {T : Scheme.{u}}
    (t : T ⟶ S) (U : S.affineOpens) (V : T.affineOpens) (hV : V.1 ≤ t ⁻¹ᵁ U) :
    (I.weilRestriction g).ideal U ≤ RingHom.ker (t.appLE U V hV).hom ↔
      I.ideal ⟨g ⁻¹ᵁ U, U.2.preimage g⟩ ≤ RingHom.ker ((pullback.snd t g).appLE (g ⁻¹ᵁ U)
        (pullback.snd t g ⁻¹ᵁ g ⁻¹ᵁ U ⊓ pullback.fst t g ⁻¹ᵁ V) inf_le_left).hom := by
  set P := pullback.snd t g ⁻¹ᵁ g ⁻¹ᵁ U ⊓ pullback.fst t g ⁻¹ᵁ V
  -- the sections of `T ×_S Y` over `P` are the pushout of `Γ(T, V)` and `Γ(Y, g⁻¹ U)`
  have hpush : IsPushout (g.app U) (t.appLE U V hV)
      ((pullback.snd t g).appLE (g ⁻¹ᵁ U) P inf_le_left)
      ((pullback.fst t g).appLE V P inf_le_right) := by
    have := isIso_pushoutSection_of_isAffineOpen (IsPullback.of_hasPullback t g).flip hV le_rfl
      rfl U.2 V.2 (U.2.preimage g)
    rwa [isIso_pushoutSection_iff, Scheme.Hom.appLE_eq_app] at this
  algebraize [(g.app U).hom, (t.appLE U V hV).hom,
    ((pullback.snd t g).appLE (g ⁻¹ᵁ U) P inf_le_left).hom,
    ((pullback.fst t g).appLE V P inf_le_right).hom,
    ((pullback.fst t g).appLE V P inf_le_right).hom.comp (t.appLE U V hV).hom]
  have : IsScalarTower Γ(S, U) Γ(Y, g ⁻¹ᵁ U) Γ(pullback t g, P) :=
    .of_algebraMap_eq' congr($(hpush.w).hom).symm
  have h : Algebra.IsPushout Γ(S, U) Γ(T, V) Γ(Y, g ⁻¹ᵁ U) Γ(pullback t g, P) :=
    ((CommRingCat.isPushout_iff_isPushout).1 hpush).symm
  have := g.projective_app U
  rw [weilRestriction_ideal, ← RingHom.algebraMap_toAlgebra (t.appLE U V hV).hom,
    IsBaseChange.minorsIdeal_one_le_ker_iff h.out]
  simp [IsConcreteLE.le_iff, RingHom.algebraMap_toAlgebra]
  -- the two sides agree after unfolding `P`
  rfl

/-- **The universal property of the Weil restriction of a closed subscheme.** Let `g : Y ⟶ S` be
finite locally free and `I` an ideal sheaf on `Y`. A morphism `t : T ⟶ S` factors through the
closed subscheme of `I.weilRestriction g` exactly when the base change `T ×_S Y ⟶ Y` of `t`
factors through the closed subscheme `V(I)`. -/
theorem weilRestriction_le_ker_iff (I : Y.IdealSheafData) {T : Scheme.{u}} (t : T ⟶ S) :
    I.weilRestriction g ≤ t.ker ↔ I ≤ (pullback.snd t g).ker := by
  constructor
  · intro h
    refine le_ofIdeals_iff.2 fun V x hx ↦ RingHom.mem_ker.2 <|
      (pullback t g).IsSheaf.section_ext fun p hp ↦ ?_
    -- near `p`, choose affine opens `US ⊆ S`, `V' ⊆ V ∩ g⁻¹ US` and `UT ⊆ t⁻¹ US`
    obtain ⟨_, ⟨US, hUS, rfl⟩, hpUS, -⟩ := S.isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_univ (g (pullback.snd t g p))) isOpen_univ
    have hpVUS : pullback.snd t g p ∈ V.1 ⊓ g ⁻¹ᵁ US := ⟨hp, hpUS⟩
    obtain ⟨_, ⟨V', hV', rfl⟩, hpV', hV'le⟩ :=
      Y.isBasis_affineOpens.exists_subset_of_mem_open hpVUS (V.1 ⊓ g ⁻¹ᵁ US).2
    have htp : t (pullback.fst t g p) = g (pullback.snd t g p) := by
      rw [← Scheme.Hom.comp_apply, pullback.condition, Scheme.Hom.comp_apply]
    have hpUS' : t (pullback.fst t g p) ∈ (US : Set S) := htp ▸ hpUS
    obtain ⟨_, ⟨UT, hUT, rfl⟩, hpUT, hUTle⟩ :=
      T.isBasis_affineOpens.exists_subset_of_mem_open hpUS' (t ⁻¹ᵁ US).2
    have hW : pullback.snd t g ⁻¹ᵁ V' ⊓ pullback.fst t g ⁻¹ᵁ UT ≤ pullback.snd t g ⁻¹ᵁ V.1 :=
      inf_le_left.trans ((pullback.snd t g).preimage_mono fun y hy ↦ (hV'le hy).1)
    refine ⟨_, hW, ⟨hpV', hpUT⟩, ?_⟩
    -- over `UT`, the content of `I(g⁻¹ US)` vanishes, so `I(g⁻¹ US)` vanishes on `T ×_S Y`
    have hcore := (weilRestriction_ideal_le_ker_iff I t ⟨US, hUS⟩ ⟨UT, hUT⟩ hUTle).1
      ((h ⟨US, hUS⟩).trans ((t.ideal_ker_le _).trans (t.ker_app_le_ker_appLE hUTle)))
    have hV'V : (⟨V', hV'⟩ : Y.affineOpens) ≤ V := fun y hy ↦ (hV'le hy).1
    have := I.ideal_le_ker_appLE_of_le (pullback.snd t g) (U' := ⟨V', hV'⟩)
      (fun y hy ↦ (hV'le hy).2) (inf_le_inf_right _ ((pullback.snd t g).preimage_mono
        fun y hy ↦ (hV'le hy).2)) _ inf_le_left hcore (I.ideal_le_comap_ideal hV'V hx)
    rw [RingHom.mem_ker, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE] at this
    simpa [Scheme.Hom.appLE] using this
  · intro h
    refine le_ofIdeals_iff.2 fun U a ha ↦ RingHom.mem_ker.2 <|
      T.IsSheaf.section_ext fun q hq ↦ ?_
    obtain ⟨_, ⟨UT, hUT, rfl⟩, hqUT, hUTle⟩ :=
      T.isBasis_affineOpens.exists_subset_of_mem_open hq (t ⁻¹ᵁ U.1).2
    refine ⟨UT, hUTle, hqUT, ?_⟩
    have := (weilRestriction_ideal_le_ker_iff I t U ⟨UT, hUT⟩ hUTle).2
      ((h ⟨g ⁻¹ᵁ U, U.2.preimage g⟩).trans
        (((pullback.snd t g).ideal_ker_le _).trans
          ((pullback.snd t g).ker_app_le_ker_appLE inf_le_left))) ha
    simpa [Scheme.Hom.appLE] using this

variable {g} in
/-- The universal property of the Weil restriction, for a base change `Y'` of `Y` given by any
pullback square: `f : S' ⟶ S` factors through the closed subscheme of `I.weilRestriction g`
exactly when `Y' ⟶ Y` factors through `V(I)`. -/
theorem weilRestriction_le_ker_iff_of_isPullback (I : Y.IdealSheafData) {S' Y' : Scheme.{u}}
    {f : S' ⟶ S} {g' : Y' ⟶ S'} {gY : Y' ⟶ Y} (h : IsPullback g' gY f g) :
    I.weilRestriction g ≤ f.ker ↔ I ≤ gY.ker := by
  rw [weilRestriction_le_ker_iff, ← h.isoPullback_hom_snd, Scheme.Hom.ker_comp_of_isIso]

variable {g} in
/-- **Closed conditions on finite locally free families.** Let `k : Y ⟶ X` be a family over `S`
parametrised by the finite locally free `g : Y ⟶ S`, and `J` an ideal sheaf on `X`. For a pullback
square `Y' ⟶ Y` over `f : S' ⟶ S` and a morphism `k' : Y' ⟶ X'` lying over `k` along
`gX : X' ⟶ X`, the base-changed family `k'` lies in the inverse image of `V(J)` exactly when `f`
factors through the closed subscheme of the Weil restriction of `V(J.comap k)` along `g`. -/
theorem weilRestriction_comap_le_ker_iff {X : Scheme.{u}} (J : X.IdealSheafData) (k : Y ⟶ X)
    {S' Y' X' : Scheme.{u}} {f : S' ⟶ S} {g' : Y' ⟶ S'} {gY : Y' ⟶ Y}
    (h : IsPullback g' gY f g) {k' : Y' ⟶ X'} {gX : X' ⟶ X} (w : k' ≫ gX = gY ≫ k) :
    (J.comap k).weilRestriction g ≤ f.ker ↔ J.comap gX ≤ k'.ker := by
  rw [weilRestriction_le_ker_iff_of_isPullback _ h, ← le_map_iff_comap_le, map_ker, ← w,
    ← map_ker, le_map_iff_comap_le]

/-- Over the closed subscheme of `I.weilRestriction g`, the base change of `Y` lies in the closed
subscheme `V(I)`: the universal family of the Weil restriction. -/
theorem le_ker_pullback_snd_subschemeι_weilRestriction (I : Y.IdealSheafData) :
    I ≤ (pullback.snd (I.weilRestriction g).subschemeι g).ker :=
  (weilRestriction_le_ker_iff g I _).1 (ker_subschemeι _).ge

/-- **The Weil restriction of a closed subscheme commutes with base change.** For `t : T ⟶ S`,
the Weil restriction of the inverse image of `V(I)` in `T ×_S Y` along `T ×_S Y ⟶ T` is the
inverse image of the Weil restriction of `V(I)` along `g`. -/
theorem weilRestriction_comap (I : Y.IdealSheafData) {T : Scheme.{u}} (t : T ⟶ S) :
    (I.comap (pullback.snd t g)).weilRestriction (pullback.fst t g) =
      (I.weilRestriction g).comap t := by
  -- both sides have the same morphisms factoring through their closed subschemes
  have key {T' : Scheme.{u}} (s : T' ⟶ T) :
      (I.comap (pullback.snd t g)).weilRestriction (pullback.fst t g) ≤ s.ker ↔
        (I.weilRestriction g).comap t ≤ s.ker := by
    rw [weilRestriction_le_ker_iff, ← le_map_iff_comap_le, map_ker, ← le_map_iff_comap_le,
      map_ker, weilRestriction_le_ker_iff, ← pullbackRightPullbackFstIso_hom_snd,
      Scheme.Hom.ker_comp_of_isIso]
  exact le_antisymm
    (((key ((I.weilRestriction g).comap t).subschemeι).2 (ker_subschemeι _).ge).trans
      (ker_subschemeι _).le)
    (((key ((I.comap (pullback.snd t g)).weilRestriction (pullback.fst t g)).subschemeι).1
      (ker_subschemeι _).ge).trans (ker_subschemeι _).le)

end Scheme.IdealSheafData

end AlgebraicGeometry
