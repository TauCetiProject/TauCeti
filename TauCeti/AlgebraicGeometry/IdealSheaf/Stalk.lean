module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import TauCeti.RingTheory.Ideal.Order
import TauCeti.AlgebraicGeometry.AffineScheme

/-!
# Stalk ideals and their order

The stalk ideal of quasi-coherent ideal sheaf data is the image of its section ideal under
the germ map on any affine neighbourhood. Independence of that neighbourhood makes local
ideal order available for arbitrary schemes. On an affine chart it agrees with ideal order
at the corresponding prime, without a rationality or regularity assumption on the point.

The stalk construction preserves sums, products and powers. Its being a proper ideal
characterizes membership in the support, so order at least one recovers the usual support;
higher order thresholds retain information about multiplicity.

The order convention follows Bierstone–Milman, *Canonical desingularization in characteristic
zero by blowing up the maximum strata of a local invariant* (1997), Remark 1.8 and §4.1.
-/

public section

open CategoryTheory TopologicalSpace

namespace AlgebraicGeometry.Scheme.IdealSheafData

universe u

variable {X : Scheme.{u}}

private theorem map_ideal_germ_eq (I : X.IdealSheafData) (U V : X.affineOpens)
    (x : X) (hxU : x ∈ U.1) (hxV : x ∈ V.1) :
    (I.ideal U).map (X.presheaf.germ U.1 x hxU).hom =
      (I.ideal V).map (X.presheaf.germ V.1 x hxV).hom := by
  obtain ⟨W, hW, hxW, hWU⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (Opens.mem_inf.mpr ⟨hxU, hxV⟩)
  have h (A : X.affineOpens) (hxA : x ∈ A.1) (hWA : W ≤ A.1) :
      (I.ideal A).map (X.presheaf.germ A.1 x hxA).hom =
        (I.ideal ⟨W, hW⟩).map (X.presheaf.germ W x hxW).hom := by
    rw [← I.map_ideal (U := ⟨W, hW⟩) (V := A) hWA, Ideal.map_map,
      ← CommRingCat.hom_comp]
    exact congrArg (fun f : Γ(X, A) ⟶ X.presheaf.stalk x ↦ (I.ideal A).map f.hom)
      (X.presheaf.germ_res (homOfLE hWA) x hxW).symm
  exact (h U hxU (hWU.trans inf_le_left)).trans
    (h V hxV (hWU.trans inf_le_right)).symm

/-- The ideal in the local ring generated by germs of local sections of an ideal sheaf. -/
noncomputable def stalkIdeal (I : X.IdealSheafData) (x : X) : Ideal (X.presheaf.stalk x) :=
  (I.ideal ⟨_, isAffineOpen_opensRange (X.affineCover.f (X.affineCover.idx x))⟩).map
    (X.presheaf.germ _ x (X.affineCover.covers x)).hom

/-- Every affine neighbourhood computes the stalk ideal by its germ map. -/
theorem stalkIdeal_eq_map (I : X.IdealSheafData) (U : X.affineOpens)
    (x : X) (hxU : x ∈ U.1) :
    I.stalkIdeal x = (I.ideal U).map (X.presheaf.germ U.1 x hxU).hom :=
  map_ideal_germ_eq I _ U x _ hxU

/-- A germ lies in the stalk ideal exactly when a denominator outside the point's prime
clears it to a section in the affine ideal. -/
theorem mem_stalkIdeal_iff (I : X.IdealSheafData) (U : X.affineOpens)
    (x : X) (hxU : x ∈ U.1) (s : X.presheaf.stalk x) :
    s ∈ I.stalkIdeal x ↔
      ∃ f ∈ I.ideal U, ∃ t : Γ(X, U), t ∉ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal ∧
        s * (X.presheaf.germ U.1 x hxU).hom t = (X.presheaf.germ U.1 x hxU).hom f := by
  let := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  let := U.2.isLocalization_stalk ⟨x, hxU⟩
  have hg : algebraMap Γ(X, U) (X.presheaf.stalk x) =
      (X.presheaf.germ U.1 x hxU).hom :=
    X.presheaf.stalk_open_algebraMap ⟨x, hxU⟩
  rw [I.stalkIdeal_eq_map U x hxU]
  exact (IsLocalization.mem_map_algebraMap_iff
    (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl (X.presheaf.stalk x)).trans
    (by
      simp only [Prod.exists, Subtype.exists, Ideal.mem_primeCompl_iff, exists_prop, hg])

/-- Taking stalk ideals preserves inclusion. -/
theorem stalkIdeal_mono {I J : X.IdealSheafData} (h : I ≤ J) (x : X) :
    I.stalkIdeal x ≤ J.stalkIdeal x :=
  Ideal.map_mono (h _)

/-- The zero ideal sheaf has zero stalk ideal. -/
@[simp]
theorem stalkIdeal_bot (x : X) : (⊥ : X.IdealSheafData).stalkIdeal x = ⊥ := by
  simp [stalkIdeal]

/-- The unit ideal sheaf has unit stalk ideal. -/
@[simp]
theorem stalkIdeal_top (x : X) : (⊤ : X.IdealSheafData).stalkIdeal x = ⊤ := by
  simp [stalkIdeal, Ideal.map_top]

/-- Taking stalk ideals preserves sums. -/
@[simp]
theorem stalkIdeal_sup (I J : X.IdealSheafData) (x : X) :
    (I ⊔ J).stalkIdeal x = I.stalkIdeal x ⊔ J.stalkIdeal x := by
  simp [stalkIdeal, Ideal.map_sup]

/-- Taking stalk ideals preserves products. -/
@[simp]
theorem stalkIdeal_mul (I J : X.IdealSheafData) (x : X) :
    (I * J).stalkIdeal x = I.stalkIdeal x * J.stalkIdeal x := by
  simp [stalkIdeal, Ideal.map_mul]

/-- Taking stalk ideals preserves powers. -/
@[simp]
theorem stalkIdeal_pow (I : X.IdealSheafData) (n : ℕ) (x : X) :
    (I ^ n).stalkIdeal x = I.stalkIdeal x ^ n := by
  simp [stalkIdeal, Ideal.map_pow]

/-- The stalk ideal is the localized section ideal under the canonical affine localization
equivalence. -/
theorem stalkIdeal_eq_map_localization (I : X.IdealSheafData) (U : X.affineOpens)
    (x : X) (hxU : x ∈ U.1) :
    let := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
    let := U.2.isLocalization_stalk ⟨x, hxU⟩
    let p := (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal
    I.stalkIdeal x =
      ((I.ideal U).map (algebraMap Γ(X, U) (Localization.AtPrime p))).map
        (IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p)
          (X.presheaf.stalk x)).toRingHom := by
  let := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  let := U.2.isLocalization_stalk ⟨x, hxU⟩
  dsimp only
  rw [I.stalkIdeal_eq_map U x hxU, Ideal.map_map]
  congr 1
  ext r
  exact (IsLocalization.algEquiv (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
    (Localization.AtPrime (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal)
    (X.presheaf.stalk x)).commutes r |>.symm

/-- The order of an ideal sheaf at a point, computed in its local ring. -/
noncomputable def stalkOrder (I : X.IdealSheafData) (x : X) : ℕ∞ :=
  (I.stalkIdeal x).localOrder

/-- Stalk order is the local order of the stalk ideal. -/
theorem stalkOrder_def (I : X.IdealSheafData) (x : X) :
    I.stalkOrder x = (I.stalkIdeal x).localOrder := (rfl)

/-- Inclusion of ideal sheaves reverses stalk orders. -/
theorem stalkOrder_anti {I J : X.IdealSheafData} (h : I ≤ J) (x : X) :
    J.stalkOrder x ≤ I.stalkOrder x :=
  Ideal.localOrder_anti (stalkIdeal_mono h x)

/-- Stalk order at least `n` means containment in the `n`-th maximal-ideal power. -/
@[simp]
theorem natCast_le_stalkOrder_iff (I : X.IdealSheafData) (x : X) (n : ℕ) :
    (n : ℕ∞) ≤ I.stalkOrder x ↔
      I.stalkIdeal x ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ n :=
  Ideal.natCast_le_localOrder_iff _ _

/-- An affine chart identifies stalk order with ideal order at its corresponding prime. -/
theorem stalkOrder_eq_orderAt (I : X.IdealSheafData) (U : X.affineOpens)
    (x : X) (hxU : x ∈ U.1) :
    I.stalkOrder x = (I.ideal U).orderAt (U.2.primeIdealOf ⟨x, hxU⟩) := by
  let := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  let := U.2.isLocalization_stalk ⟨x, hxU⟩
  rw [stalkOrder, I.stalkIdeal_eq_map_localization U x hxU, Ideal.orderAt_def]
  simpa only [RingEquiv.toRingHom_eq_coe, Ideal.map_coe] using
    Ideal.localOrder_map_equiv _ (IsLocalization.algEquiv
      (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
      (Localization.AtPrime (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal)
      (X.presheaf.stalk x)).toRingEquiv

/-- Positive stalk order recovers the support of the ideal sheaf. -/
@[simp]
theorem one_le_stalkOrder_iff (I : X.IdealSheafData) (x : X) :
    1 ≤ I.stalkOrder x ↔ x ∈ I.support := by
  obtain ⟨U, hU, hxU, _⟩ := exists_isAffineOpen_mem_and_subset (X := X) (Opens.mem_top x)
  rw [I.stalkOrder_eq_orderAt ⟨U, hU⟩ x hxU, Ideal.one_le_orderAt_iff,
    I.mem_support_iff_of_mem (U := ⟨U, hU⟩) hxU, Scheme.mem_zeroLocus_iff]
  simp only [hU.mem_basicOpen_iff_notMem_primeIdealOf ⟨x, hxU⟩, not_not,
    IsConcreteLE.le_iff, SetLike.mem_coe]

/-- A point lies in the support exactly when its stalk ideal is proper. -/
theorem mem_support_iff_stalkIdeal_ne_top (I : X.IdealSheafData) (x : X) :
    x ∈ I.support ↔ I.stalkIdeal x ≠ ⊤ := by
  rw [← I.one_le_stalkOrder_iff x, Order.one_le_iff_ne_zero, stalkOrder]
  exact not_congr (Ideal.localOrder_eq_zero_iff _)

/-- Stalk order zero means that the point is outside the support. -/
@[simp]
theorem stalkOrder_eq_zero_iff (I : X.IdealSheafData) (x : X) :
    I.stalkOrder x = 0 ↔ x ∉ I.support := by
  rw [← I.one_le_stalkOrder_iff x, Order.one_le_iff_ne_zero, not_not]

/-- The zero ideal sheaf has infinite order at every point. -/
@[simp]
theorem stalkOrder_bot (x : X) : (⊥ : X.IdealSheafData).stalkOrder x = ⊤ := by
  simp [stalkOrder]

/-- The unit ideal sheaf has order zero at every point. -/
@[simp]
theorem stalkOrder_top (x : X) : (⊤ : X.IdealSheafData).stalkOrder x = 0 := by
  simp [stalkOrder]

/-- The order of a sum of ideal sheaves is the smaller stalk order. -/
@[simp]
theorem stalkOrder_sup (I J : X.IdealSheafData) (x : X) :
    (I ⊔ J).stalkOrder x = min (I.stalkOrder x) (J.stalkOrder x) := by
  simp [stalkOrder]

end AlgebraicGeometry.Scheme.IdealSheafData
