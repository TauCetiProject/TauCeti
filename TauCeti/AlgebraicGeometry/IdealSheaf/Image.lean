module

public import TauCeti.AlgebraicGeometry.IdealSheaf.Module
public import TauCeti.AlgebraicGeometry.Modules.Localization
import TauCeti.AlgebraicGeometry.Modules.Sheaf

/-!
# The ideal generated by a quasicoherent module morphism

A morphism from a quasicoherent module to the structure sheaf determines an ideal sheaf.
On affine opens its ideal is the image on sections. This gives a closed subscheme from a
module-theoretic inclusion, in particular from an invertible ideal in the structure sheaf.

## References

* R. Hartshorne, *Algebraic Geometry*, Proposition II.5.9.
-/

public section

open CategoryTheory Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.Modules.Hom

noncomputable section

variable {X : Scheme.{u}} {M : X.Modules}
  (φ : M ⟶ SheafOfModules.unit X.ringCatSheaf)

/-- The ideal which is the image of a module morphism to the structure sheaf on sections. -/
def imageIdeal (U : X.Opens) : Ideal Γ(X, U) :=
  let f : Γ(M, U) →ₗ[Γ(X, U)] Γ(X, U) := (φ.val.app (op U)).hom
  LinearMap.range f

/-- Membership in the image ideal means having a preimage on sections. -/
@[simp]
lemma mem_imageIdeal {U : X.Opens} {s : Γ(X, U)} :
    s ∈ φ.imageIdeal U ↔ ∃ t : Γ(M, U), φ.app U t = s :=
  Iff.rfl

/-- Restriction carries the image ideal into the image ideal on a smaller open. -/
lemma map_mem_imageIdeal {U V : X.Opens} (i : V ⟶ U) {s : Γ(X, U)}
    (hs : s ∈ φ.imageIdeal U) : X.presheaf.map i.op s ∈ φ.imageIdeal V := by
  obtain ⟨t, rfl⟩ := hs
  exact ⟨M.presheaf.map i.op t, φ.mapPresheaf.naturality_apply i.op t⟩

variable [M.IsQuasicoherent]

/-- Localization of the image ideal is the image ideal over the basic open. -/
lemma map_imageIdeal_basicOpen (U : X.affineOpens) (f : Γ(X, U)) :
    (φ.imageIdeal U).map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom =
      φ.imageIdeal (X.basicOpen f) := by
  apply le_antisymm
  · exact Ideal.map_le_iff_le_comap.mpr fun s hs ↦ φ.map_mem_imageIdeal _ hs
  · rintro s ⟨t, ht⟩
    obtain ⟨n, y, hy⟩ := M.exists_pow_smul_eq_map U.2 f rfl (X.basicOpen_le f) t
    apply (Ideal.unit_mul_mem_iff_mem _ ((X.toRingedSpace.isUnit_res_basicOpen f).pow n)).mp
    have h : X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ n * s =
        X.presheaf.map (homOfLE (X.basicOpen_le f)).op (φ.app U.1 y) := by
      let ψ : Γ(M, X.basicOpen f) →ₗ[Γ(X, X.basicOpen f)] Γ(X, X.basicOpen f) :=
        (φ.val.app (op (X.basicOpen f))).hom
      calc
        _ = X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ n * ψ t :=
          congrArg (_ * ·) ht.symm
        _ = ψ (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ n • t) :=
          (ψ.map_smul _ t).symm
        _ = ψ (M.presheaf.map (homOfLE (X.basicOpen_le f)).op y) := congrArg ψ hy
        _ = X.presheaf.map (homOfLE (X.basicOpen_le f)).op (φ.app U.1 y) := by
          exact φ.mapPresheaf.naturality_apply _ y
    exact h.symm ▸ Ideal.mem_map_of_mem _ ⟨y, rfl⟩

/-- The quasicoherent ideal sheaf generated by a module morphism to the structure sheaf.
Its ideal on every affine open is the image on sections. -/
def imageIdealSheaf : X.IdealSheafData where
  ideal U := φ.imageIdeal U
  map_ideal_basicOpen := φ.map_imageIdeal_basicOpen

/-- The ideal of `imageIdealSheaf` on an affine open is the image on sections. -/
@[simp]
lemma imageIdealSheaf_ideal (U : X.affineOpens) :
    φ.imageIdealSheaf.ideal U = φ.imageIdeal U :=
  (rfl)

/-- Every section in the image of the morphism lies in its image ideal sheaf. -/
lemma app_mem_imageIdealSheaf_sections (U : X.Opens) (s : Γ(M, U)) :
    φ.app U s ∈ φ.imageIdealSheaf.sections U := by
  apply IdealSheafData.mem_sections_of_forall_exists
  intro x hx
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hx U.isOpen
  refine ⟨V, homOfLE hVU, hxV, ?_⟩
  rw [IdealSheafData.sections_eq_ideal _ ⟨V, hV⟩, imageIdealSheaf_ideal]
  exact φ.map_mem_imageIdeal _ ⟨s, rfl⟩

/-- The factorization of a quasicoherent module morphism through its image ideal sheaf. -/
def toImageIdealSheaf : M ⟶ φ.imageIdealSheaf.sheaf :=
  φ.imageIdealSheaf.sheafLift φ φ.app_mem_imageIdealSheaf_sections

/-- Composing the factorization with the ideal inclusion recovers the original morphism. -/
@[simp, reassoc]
lemma toImageIdealSheaf_ι : φ.toImageIdealSheaf ≫ φ.imageIdealSheaf.sheafι = φ :=
  IdealSheafData.sheafLift_ι _ _ _

/-- The image-ideal factorization recovers the original morphism on sections. -/
@[simp]
lemma toImageIdealSheaf_app_sheafι (U : X.Opens) (t : Γ(M, U)) :
    φ.imageIdealSheaf.sheafι.app U (φ.toImageIdealSheaf.app U t) = φ.app U t :=
  congrArg (fun ψ ↦ ψ.app U t) φ.toImageIdealSheaf_ι

/-- A quasicoherent module embedded in the structure sheaf is its image ideal sheaf. -/
instance isIso_toImageIdealSheaf [Mono φ] : IsIso φ.toImageIdealSheaf := by
  have : Mono φ.toImageIdealSheaf := mono_of_mono_fac φ.toImageIdealSheaf_ι
  have : Epi φ.toImageIdealSheaf := Hom.epi_of_surjective_on_affineOpens _ fun U hU s ↦ by
    have hs := φ.imageIdealSheaf.sheafι_app_mem U s
    rw [IdealSheafData.sections_eq_ideal _ ⟨U, hU⟩, imageIdealSheaf_ideal] at hs
    obtain ⟨t, ht⟩ := hs
    refine ⟨t, φ.imageIdealSheaf.sheafι_app_injective U ?_⟩
    exact (φ.toImageIdealSheaf_app_sheafι U t).trans ht
  exact isIso_of_mono_of_epi _

/-- The canonical isomorphism from a quasicoherent submodule of the structure sheaf to the
module associated with its image ideal sheaf. -/
def imageIdealSheafIso [Mono φ] : M ≅ φ.imageIdealSheaf.sheaf :=
  asIso φ.toImageIdealSheaf

/-- The image-ideal isomorphism respects the embeddings into the structure sheaf. -/
@[simp, reassoc]
lemma imageIdealSheafIso_hom_ι [Mono φ] :
    φ.imageIdealSheafIso.hom ≫ φ.imageIdealSheaf.sheafι = φ :=
  φ.toImageIdealSheaf_ι

/-- For a quasicoherent submodule of the structure sheaf, the image ideal describes the
sections of the ideal sheaf even on nonaffine opens. -/
@[simp]
lemma imageIdealSheaf_sections [Mono φ] (U : X.Opens) :
    φ.imageIdealSheaf.sections U = φ.imageIdeal U := by
  ext s
  constructor
  · intro hs
    obtain ⟨t, ht⟩ := (ConcreteCategory.bijective_of_isIso (φ.toImageIdealSheaf.app U)).2
      (φ.imageIdealSheaf.sectionMk s hs)
    refine ⟨t, ?_⟩
    exact (φ.toImageIdealSheaf_app_sheafι U t).symm.trans <|
      (congrArg (φ.imageIdealSheaf.sheafι.app U) ht).trans
        (φ.imageIdealSheaf.sheafι_app_sectionMk s hs)
  · rintro ⟨t, rfl⟩
    exact φ.app_mem_imageIdealSheaf_sections U t

end

end AlgebraicGeometry.Scheme.Modules.Hom
