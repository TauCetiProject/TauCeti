module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Regular ideal sheaves

An ideal sheaf `I` on a scheme `Y` is *regular of codimension `d`*
(`IdealSheafData.IsLocallyRegular`) if every point of its support `V(I)` has an affine open
neighbourhood `U` on which `I(U)` is generated by a regular sequence of length `d` (Stacks, Tag
063D).

## Main definitions

* `AlgebraicGeometry.Scheme.IdealSheafData.IsLocallyRegular I d`: the ideal sheaf `I` is locally
  generated by a regular sequence of length `d` around every point of its support, with its
  characterization `isLocallyRegular_iff`.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.IsLocallyRegular.of_comap`: regularity can be checked
  on the pullback along an open immersion whose image contains the support.
* `AlgebraicGeometry.Scheme.IdealSheafData.isLocallyRegular_comap_iff_of_isIso`: regularity is
  invariant under pullback along an isomorphism.
* `AlgebraicGeometry.Scheme.IdealSheafData.isLocallyRegular_bot`: the zero ideal sheaf is regular
  of codimension zero.
* `AlgebraicGeometry.Scheme.IdealSheafData.isLocallyRegular_of_support_eq_bot`: an ideal sheaf
  with empty support is regular of every codimension.

## References

* [The Stacks Project, Tag 063D](https://stacks.math.columbia.edu/tag/063D)
-/

public section

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

open CategoryTheory

variable {X Y : Scheme.{u}}

/-- An ideal sheaf `I` on `Y` is *regular of codimension `d`* if every point of its support `V(I)`
has an affine open neighbourhood `U` on which the ideal `I(U)` is generated by a regular sequence
of length `d` on `Γ(Y, U)` (Stacks, Tag 063D). -/
def IsLocallyRegular (I : Y.IdealSheafData) (d : ℕ) : Prop :=
  ∀ y ∈ I.support, ∃ U : Y.affineOpens, y ∈ U.val ∧ ∃ rs : List Γ(Y, U), rs.length = d ∧
    RingTheory.Sequence.IsRegular Γ(Y, U) rs ∧ I.ideal U = Ideal.ofList rs

/-- `I` is regular of codimension `d` exactly when every point of its support has an affine open
neighbourhood `U` on which `I(U)` is generated by a regular sequence of length `d`. -/
theorem isLocallyRegular_iff {I : Y.IdealSheafData} {d : ℕ} :
    I.IsLocallyRegular d ↔ ∀ y ∈ I.support, ∃ U : Y.affineOpens, y ∈ U.val ∧
      ∃ rs : List Γ(Y, U), rs.length = d ∧ RingTheory.Sequence.IsRegular Γ(Y, U) rs ∧
        I.ideal U = Ideal.ofList rs :=
  Iff.rfl

/-- If the pullback of `I` along an open immersion `f` whose image contains the support of `I` is
regular of codimension `d`, then so is `I`. -/
theorem IsLocallyRegular.of_comap {I : Y.IdealSheafData} {d : ℕ} (f : X ⟶ Y) [IsOpenImmersion f]
    (hf : (I.support : Set Y) ⊆ Set.range f) (h : (I.comap f).IsLocallyRegular d) :
    I.IsLocallyRegular d := by
  intro y hy
  obtain ⟨x, rfl⟩ := hf hy
  obtain ⟨U, hxU, rs, hlen, hreg, hI⟩ := h x (by rw [support_comap]; exact hy)
  -- Transport the regular sequence along the ring isomorphism `Γ(X, U) ≅ Γ(Y, f ''ᵁ U)`.
  let φ := (f.appIso U).symm.commRingCatIsoToRingEquiv
  have := RingHomInvPair.of_ringEquiv φ
  have := RingHomInvPair.of_ringEquiv_symm φ
  refine ⟨⟨f ''ᵁ U, U.property.image_of_isOpenImmersion f⟩, ⟨x, hxU, rfl⟩, rs.map (φ : _ →+* _),
    by simp [hlen], (φ.toSemilinearEquiv.isRegular_congr' rs).mp hreg, ?_⟩
  rw [ideal_comap_of_isOpenImmersion] at hI
  rw [← Ideal.map_ofList, ← hI, Iso.commRingCatIsoToRingEquiv_toRingHom, Iso.symm_hom,
    Ideal.map_comap_of_surjective _ (ConcreteCategory.bijective_of_isIso (f.appIso U).inv).2]

/-- The pullback of `I` along an isomorphism `f` is regular of codimension `d` exactly when `I`
is. -/
theorem isLocallyRegular_comap_iff_of_isIso {I : Y.IdealSheafData} {d : ℕ} (f : X ⟶ Y)
    [IsIso f] : (I.comap f).IsLocallyRegular d ↔ I.IsLocallyRegular d := by
  refine ⟨.of_comap f fun y _ ↦ f.homeomorph.surjective y, fun h ↦ ?_⟩
  refine .of_comap (inv f) (fun y _ ↦ (inv f).homeomorph.surjective y) ?_
  rwa [← comap_comp, IsIso.inv_hom_id, comap_id]

/-- **The zero ideal sheaf is regular of codimension zero**: around every point it is generated by
the empty sequence, which is regular on every nonempty affine open. -/
theorem isLocallyRegular_bot : (⊥ : Y.IdealSheafData).IsLocallyRegular 0 := by
  intro y _
  obtain ⟨U, hU, hyU, -⟩ := exists_isAffineOpen_mem_and_subset (show y ∈ (⊤ : Y.Opens) from trivial)
  have : Nonempty U := ⟨⟨y, hyU⟩⟩
  exact ⟨⟨U, hU⟩, hyU, [], rfl, .nil _ _, by simp⟩

/-- **An ideal sheaf with empty support is regular of every codimension**: the condition is on the
points of the support, and there are none. -/
theorem isLocallyRegular_of_support_eq_bot {I : Y.IdealSheafData} (h : I.support = ⊥) (d : ℕ) :
    I.IsLocallyRegular d := fun y hy ↦ by
  rw [h] at hy
  exact hy.elim

end AlgebraicGeometry.Scheme.IdealSheafData
