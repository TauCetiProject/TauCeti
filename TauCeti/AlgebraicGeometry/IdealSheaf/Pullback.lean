/-!
# Pullback of an ideal sheaf as a sheaf of modules

Let `g : X ⟶ Y` be a morphism of schemes and `I ⊆ 𝒪_Y` an ideal sheaf. There are two ways to pull
`I` back to `X`: the inverse image `I.comap g`, the ideal sheaf of the fibre product
`X ×_Y V(I)`, and the pullback `g^* I` of `I` as an `𝒪_Y`-module. Pulling back the inclusion
`I ⟶ 𝒪_Y` gives `g^* I ⟶ g^* 𝒪_Y ≅ 𝒪_X`, whose image is generated by the functions `g^♯ s` for
sections `s` of `I`; these lie in `I.comap g` (`app_mem_sections_comap`). So the composite factors
through `I.comap g ⊆ 𝒪_X`, giving the comparison morphism `g^* I ⟶ I.comap g`.

The comparison is not an isomorphism in general: for the inclusion `g` of `V(I)`, the pullback
`g^* I` is `I / I²` while `I.comap g` is zero. It is always an epimorphism
(`epi_pullbackSheafHom`): near every point `I.comap g` is generated by the functions `g^♯ s`. It
is an isomorphism along a flat morphism `g`, for instance an open immersion, since then pulling
back preserves the monomorphism `I ⟶ 𝒪_Y` (`isIso_pullbackSheafHom_of_flat`), and for effective
Cartier divisors whose inverse image is again effective Cartier
(`Scheme.IdealSheafData.isIso_pullbackSheafHom` in
`TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Pullback`).

## Main declarations

* `Scheme.IdealSheafData.app_mem_sections_comap`: `g^♯` carries sections of `I` to sections of
  `I.comap g`;
* `Scheme.IdealSheafData.pullbackSheafHom`: the comparison morphism `g^* I ⟶ I.comap g`,
  characterized by `pullbackSheafHom_sheafι`, and computed on the images of sections of `I`
  under the unit of the pullback–pushforward adjunction by `pullbackSheafHom_app_unit_app`;
* `Scheme.IdealSheafData.epi_pullbackSheafHom`: the comparison is an epimorphism;
* `Scheme.IdealSheafData.isIso_pullbackSheafHom_of_flat`: along a flat morphism the comparison is
  an isomorphism.

## References

* The Stacks Project, *Divisors*, Section *Effective Cartier divisors* (Tag 01WQ), where the
  pullback of an effective Cartier divisor is defined.
-/

public section

open CategoryTheory Limits MonoidalCategory

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

noncomputable section

variable {X Y : Scheme.{u}}

/-- Pulling back along `g` carries sections of `I` to sections of the inverse image of `I`. -/
theorem app_mem_sections_comap (I : Y.IdealSheafData) (g : X ⟶ Y) {U : Y.Opens}
    {s : Γ(Y, U)} (hs : s ∈ I.sections U) : g.app U s ∈ (I.comap g).sections (g ⁻¹ᵁ U) := by
  rw [mem_sections_iff] at hs ⊢
  -- The closed subscheme of `I.comap g` maps to that of `I` compatibly with `g`.
  have hcomm : (I.comap g).subschemeι ≫ g =
      ((I.comapIso g).hom ≫ pullback.snd g I.subschemeι) ≫ I.subschemeι := by
    rw [← I.comapIso_hom_fst g, Category.assoc, Category.assoc, pullback.condition]
  obtain ⟨ψ, e⟩ : ∃ ψ, g.app U ≫ (I.comap g).subschemeι.app (g ⁻¹ᵁ U) =
      I.subschemeι.app U ≫ ψ := by
    have h := Scheme.Hom.congr_app hcomm U
    rw [Scheme.Hom.comp_app, Scheme.Hom.comp_app] at h
    exact ⟨_, h.trans (Category.assoc _ _ _)⟩
  rw [← ConcreteCategory.comp_apply, e, ConcreteCategory.comp_apply, hs, map_zero]

variable (I : Y.IdealSheafData) (g : X ⟶ Y)

/-- The transpose of `g^* I ⟶ g^* 𝒪_Y ≅ 𝒪_X` is the inclusion `I ⟶ 𝒪_Y` followed by the map
`𝒪_Y ⟶ g_* 𝒪_X` given by `g` on sections. -/
private lemma unit_app_comp_pushforward_map :
    (Scheme.Modules.pullbackPushforwardAdjunction g).unit.app I.sheaf ≫
        (Scheme.Modules.pushforward g).map ((Scheme.Modules.pullback g).map I.sheafι ≫
          (Scheme.Modules.pullbackObjUnitIso g).hom) =
      I.sheafι ≫ SheafOfModules.unitToPushforwardObjUnit g.toRingCatSheafHom :=
  ((Scheme.Modules.pullbackPushforwardAdjunction g).homEquiv_unit _ _ _).symm.trans <|
    ((Scheme.Modules.pullbackPushforwardAdjunction g).homEquiv_naturality_left _ _).trans <|
      congrArg (I.sheafι ≫ ·)
        (Scheme.Modules.pullbackPushforwardAdjunction_homEquiv_pullbackObjUnitIso_hom g)

/-- The composite `g^* I ⟶ g^* 𝒪_Y ≅ 𝒪_X` sends the image of a section `t` of `I` under the unit
of the adjunction to `g^♯ t`. -/
private lemma app_unit_app (U : Y.Opens) (t : Γ(I.sheaf, U)) :
    ((Scheme.Modules.pullback g).map I.sheafι ≫ (Scheme.Modules.pullbackObjUnitIso g).hom).app
        (g ⁻¹ᵁ U) (((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app I.sheaf).app U t) =
      g.app U (I.sheafι.app U t) :=
  congrArg (fun φ ↦ Scheme.Modules.Hom.app φ U t) (unit_app_comp_pushforward_map I g)

/-- The composite `g^* I ⟶ g^* 𝒪_Y ≅ 𝒪_X` lands in the inverse image ideal sheaf `I.comap g`. -/
private lemma comp_cokernel_π_eq_zero :
    ((Scheme.Modules.pullback g).map I.sheafι ≫ (Scheme.Modules.pullbackObjUnitIso g).hom) ≫
      cokernel.π (I.comap g).sheafι = 0 := by
  apply ((Scheme.Modules.pullbackPushforwardAdjunction g).homEquiv _ _).injective
  rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit, Functor.map_comp, ← Category.assoc,
    unit_app_comp_pushforward_map, Functor.map_zero, Limits.comp_zero]
  refine Scheme.Modules.hom_ext _ _ fun U ↦ ?_
  ext t
  have h : g.app U (I.sheafι.app U t) = (I.comap g).sheafι.app (g ⁻¹ᵁ U)
      ((I.comap g).sectionMk _ (app_mem_sections_comap I g (I.sheafι_app_mem U t))) :=
    ((I.comap g).sheafι_app_sectionMk _ _).symm
  -- Unfolding the composite on sections over `U`, the left-hand side is `π` applied to `g^♯ t`,
  -- which is a section of `I.comap g`, hence zero.
  change (cokernel.π (I.comap g).sheafι).app (g ⁻¹ᵁ U) (g.app U (I.sheafι.app U t)) = 0
  rw [h]
  exact (congrArg (fun φ ↦ Scheme.Modules.Hom.app φ (g ⁻¹ᵁ U) _)
    (cokernel.condition (I.comap g).sheafι)).trans rfl

/-- The canonical morphism `g^* I ⟶ I.comap g` from the pullback of an ideal sheaf to the ideal
sheaf of its inverse image: the pullback `g^* I ⟶ g^* 𝒪_Y ≅ 𝒪_X` of the inclusion `I ⟶ 𝒪_Y`
factors through `I.comap g ⊆ 𝒪_X` (`pullbackSheafHom_sheafι`). -/
def pullbackSheafHom : (Scheme.Modules.pullback g).obj I.sheaf ⟶ (I.comap g).sheaf :=
  Abelian.monoLift (I.comap g).sheafι _ (comp_cokernel_π_eq_zero I g)

/-- The morphism `pullbackSheafHom` followed by the inclusion `I.comap g ⟶ 𝒪_X` is the pullback
of the inclusion `I ⟶ 𝒪_Y`. -/
@[reassoc, simp]
lemma pullbackSheafHom_sheafι :
    I.pullbackSheafHom g ≫ (I.comap g).sheafι =
      (Scheme.Modules.pullback g).map I.sheafι ≫ (Scheme.Modules.pullbackObjUnitIso g).hom :=
  Abelian.monoLift_comp _ _ _

/-- The morphism `pullbackSheafHom` sends the image of a section `t` of `I` under the unit of the
adjunction to the section `g^♯ t` of `I.comap g`. -/
lemma pullbackSheafHom_app_unit_app (U : Y.Opens) (t : Γ(I.sheaf, U)) :
    (I.pullbackSheafHom g).app (g ⁻¹ᵁ U)
        (((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app I.sheaf).app U t) =
      (I.comap g).sectionMk _ (app_mem_sections_comap I g (I.sheafι_app_mem U t)) := by
  apply (I.comap g).sheafι_app_injective
  rw [sheafι_app_sectionMk]
  exact (congrArg (fun φ ↦ Scheme.Modules.Hom.app φ (g ⁻¹ᵁ U)
    (((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app I.sheaf).app U t))
      (pullbackSheafHom_sheafι I g)).trans (app_unit_app I g U t)

/-- The comparison morphism `g^* I ⟶ I.comap g` is an epimorphism. Near every point, on an affine
open `V` of `X` inside the preimage of an affine open `U` of `Y`, the ideal of `I.comap g` is
generated by the functions `g^♯ a` for `a` in the ideal of `I` on `U` (`ideal_comap_of_le`), and
these are the images of sections of `g^* I` (`pullbackSheafHom_app_unit_app`). -/
instance epi_pullbackSheafHom : Epi (I.pullbackSheafHom g) := by
  -- Over such a `V`, the comparison is surjective on sections.
  have hsurj (U : Y.affineOpens) (V : X.affineOpens) (hVU : V.val ≤ g ⁻¹ᵁ U.val) :
      Function.Surjective ((I.pullbackSheafHom g).app V.val) := by
    -- The section of `g^* I` over `V` coming from a section `t` of `I` over `U`.
    let σ (t : Γ(I.sheaf, U.val)) : Γ((Scheme.Modules.pullback g).obj I.sheaf, V.val) :=
      ((Scheme.Modules.pullback g).obj I.sheaf).presheaf.map (homOfLE hVU).op
        (((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app I.sheaf).app U.val t)
    have hσ (t : Γ(I.sheaf, U.val)) :
        (I.comap g).sheafι.app V.val ((I.pullbackSheafHom g).app V.val (σ t)) =
          g.appLE U.val V.val hVU (I.sheafι.app U.val t) := by
      have hnat := (I.pullbackSheafHom g).mapPresheaf.naturality_apply (homOfLE hVU).op
        (((Scheme.Modules.pullbackPushforwardAdjunction g).unit.app I.sheaf).app U.val t)
      simp only [Scheme.Modules.mapPresheaf_app, Opposite.unop_op] at hnat
      rw [hnat, sheafι_app_map, pullbackSheafHom_app_unit_app, sheafι_app_sectionMk]
      -- Restricting `g^♯ t` from `g ⁻¹ᵁ U` to `V` is `g.appLE U V`, by definition.
      rfl
    -- The range of the composite with `I.comap g ⟶ 𝒪_X` is an ideal of `Γ(X, V)` containing the
    -- generators `g^♯ a`, hence the whole ideal of `I.comap g` on `V`.
    have hle : (I.ideal U).map (g.appLE U.val V.val hVU).hom ≤
        (I.pullbackSheafHom g ≫ (I.comap g).sheafι).imageIdeal V.val := by
      refine Ideal.map_le_iff_le_comap.mpr fun a ha ↦ ?_
      rw [← sections_eq_ideal, ← SetLike.mem_coe, ← range_sheafι_app] at ha
      obtain ⟨t, rfl⟩ := ha
      exact (Scheme.Modules.Hom.mem_imageIdeal _).mpr ⟨σ t, hσ t⟩
    intro y
    have hy : (I.comap g).sheafι.app V.val y ∈ (I.ideal U).map (g.appLE U.val V.val hVU).hom := by
      rw [← ideal_comap_of_le I g U V hVU, ← sections_eq_ideal]
      exact (I.comap g).sheafι_app_mem _ y
    obtain ⟨z, hz⟩ := (Scheme.Modules.Hom.mem_imageIdeal _).mp (hle hy)
    exact ⟨z, (I.comap g).sheafι_app_injective _ hz⟩
  have : Sheaf.IsLocallySurjective
      ((TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf X).map (I.pullbackSheafHom g)) := by
    constructor
    intro W s x hx
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
      Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (g x)) isOpen_univ
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVle⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ W ⊓ g ⁻¹ᵁ U from ⟨hx, hxU⟩) (W ⊓ g ⁻¹ᵁ U).isOpen
    replace hVle : V ≤ W ⊓ g ⁻¹ᵁ U := hVle
    exact ⟨V, homOfLE (hVle.trans inf_le_left), hsurj ⟨U, hU⟩ ⟨V, hV⟩ (hVle.trans inf_le_right)
      (((I.comap g).sheaf).presheaf.map (homOfLE (hVle.trans inf_le_left)).op s), hxV⟩
  exact (TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf X).epi_of_epi_map
    (Sheaf.epi_of_isLocallySurjective _)

/-- Along a flat morphism `g`, for instance an open immersion, the comparison morphism
`g^* I ⟶ I.comap g` is an isomorphism: pulling back along `g` preserves the monomorphism
`I ⟶ 𝒪_Y`, so the comparison is also a monomorphism. -/
instance isIso_pullbackSheafHom_of_flat [Flat g] : IsIso (I.pullbackSheafHom g) := by
  have h₁ : Mono ((Scheme.Modules.pullback g).map I.sheafι) := g.mono_pullback_map_of_flat I.sheafι
  have h₂ : Mono (Scheme.Modules.pullbackObjUnitIso g).hom := inferInstance
  have : Mono (I.pullbackSheafHom g ≫ (I.comap g).sheafι) := by
    rw [pullbackSheafHom_sheafι]
    exact @mono_comp _ _ _ _ _ _ h₁ _ h₂
  have : Mono (I.pullbackSheafHom g) := mono_of_mono _ (I.comap g).sheafι
  exact isIso_of_mono_of_epi _

section Functorial

variable {Z : Scheme.{u}}

private lemma pullbackSheafHom_eqToHom_sheafιUnit {V W : Scheme.{u}} {I : W.IdealSheafData}
    {J : V.IdealSheafData} {f : V ⟶ W} (h : I.comap f = J) :
    (I.pullbackSheafHom f ≫ eqToHom (congrArg sheaf h)) ≫ J.sheafιUnit =
      (Modules.pullback f).map I.sheafιUnit ≫ (Modules.pullbackObjUnitIso f).hom := by
  subst h; rw [eqToHom_refl, Category.comp_id]; exact I.pullbackSheafHom_sheafι f

/-- Compatibility of `Modules.pullbackComp` with `I.sheafι : I.sheaf ⟶ 𝒪_Z`. -/
lemma pullbackComp_inv_map_sheafι (I : Z.IdealSheafData) (f : X ⟶ Y) (g : Y ⟶ Z) :
    (Modules.pullbackComp f g).inv.app I.sheaf ≫
        (Modules.pullback f).map ((Modules.pullback g).map I.sheafι ≫
          (Modules.pullbackObjUnitIso g).hom) ≫ (Modules.pullbackObjUnitIso f).hom =
      (Modules.pullback (f ≫ g)).map I.sheafι ≫ (Modules.pullbackObjUnitIso (f ≫ g)).hom := by
  -- State the goal with `sheafιUnit` (`𝟙_ _.Modules` codomain) so `Functor.map_comp` and
  -- `pullbackComp` naturality rewrite at reducible transparency.
  change (Modules.pullbackComp f g).inv.app I.sheaf ≫
      (Modules.pullback f).map ((Modules.pullback g).map I.sheafιUnit ≫
        (Modules.pullbackObjUnitIso g).hom) ≫ (Modules.pullbackObjUnitIso f).hom =
    (Modules.pullback (f ≫ g)).map I.sheafιUnit ≫ (Modules.pullbackObjUnitIso (f ≫ g)).hom
  rw [Functor.map_comp, Category.assoc, ← Functor.comp_map,
    ← (Modules.pullbackComp f g).inv.naturality_assoc, Modules.pullbackObjUnitIso_comp]

/-- Along the identity morphism, `pullbackSheafHom` is `(Modules.pullbackId X).hom.app`. -/
lemma pullbackSheafHom_id (I : X.IdealSheafData) :
    I.pullbackSheafHom (𝟙 X) ≫ eqToHom (congrArg sheaf I.comap_id) =
      (Modules.pullbackId X).hom.app I.sheaf := by
  refine (cancel_mono I.sheafιUnit).mp ?_
  rw [pullbackSheafHom_eqToHom_sheafιUnit I.comap_id, Modules.pullbackObjUnitIso_id,
    (Modules.pullbackId X).hom.naturality, Functor.id_map]

/-- Along `f ≫ g`, `pullbackSheafHom` factors through `f^* (I.pullbackSheafHom g)` and
`(I.comap g).pullbackSheafHom f`. -/
lemma pullbackSheafHom_comp (I : Z.IdealSheafData) (f : X ⟶ Y) (g : Y ⟶ Z) :
    (Modules.pullbackComp f g).inv.app I.sheaf ≫ (Modules.pullback f).map (I.pullbackSheafHom g) ≫
        (I.comap g).pullbackSheafHom f =
      I.pullbackSheafHom (f ≫ g) ≫ eqToHom (congrArg sheaf (I.comap_comp f g)) := by
  refine (cancel_mono ((I.comap g).comap f).sheafιUnit).mp ?_
  have hι {V W : Scheme.{u}} (K : W.IdealSheafData) (k : V ⟶ W) :
      K.pullbackSheafHom k ≫ (K.comap k).sheafιUnit =
        (Modules.pullback k).map K.sheafιUnit ≫ (Modules.pullbackObjUnitIso k).hom :=
    K.pullbackSheafHom_sheafι k
  rw [Category.assoc, Category.assoc, hι, ← Functor.map_comp_assoc, hι, pullbackComp_inv_map_sheafι,
    pullbackSheafHom_eqToHom_sheafιUnit (I.comap_comp f g)]

end Functorial

end

end AlgebraicGeometry.Scheme.IdealSheafData
