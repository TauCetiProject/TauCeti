module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-!
# Locality of ideal sheaf data

An ideal sheaf is determined by its pullbacks to an open cover. This lets affine
computations of ideal sheaves, such as Fitting ideals, be glued on an arbitrary scheme.

Vanishing of the sections of an ideal sheaf under a morphism also passes to smaller affine opens
(`AlgebraicGeometry.Scheme.IdealSheafData.ideal_le_ker_appLE_of_le`), so it can be checked
locally on an affine basis.

An ideal sheaf is also determined by the morphisms factoring through its closed subscheme
(`AlgebraicGeometry.Scheme.IdealSheafData.ext_of_le_ker_iff`).

-/

public section

noncomputable section

open CategoryTheory Limits AlgebraicGeometry Scheme.IdealSheafData

namespace TauCeti

universe u

variable {X : Scheme.{u}}

/-- An ideal sheaf is the intersection of the pushforwards of its restrictions to
an open cover. -/
theorem _root_.AlgebraicGeometry.Scheme.IdealSheafData.iInf_map_comap_openCover
    (I : X.IdealSheafData) (𝒰 : X.OpenCover) :
    (⨅ i, (I.comap (𝒰.f i)).map (𝒰.f i)) = I := by
  -- Mathlib's `Scheme.Hom.iInf_ker_openCover_map_comp` computes the kernel on an
  -- open cover of its source; apply it to the ideal sheaf's closed immersion.
  calc
    _ = ⨅ i, ((𝒰.pullback₁ I.subschemeι).f i ≫ I.subschemeι).ker := by
      congr 1
      funext i
      rw [← Scheme.Cover.pullbackHom_map, ← map_ker]
      congr 1
      -- The pullback cover uses the opposite order of the two projections from `comap`.
      rw [Scheme.Cover.pullbackHom, ← pullbackSymmetry_hom_comp_fst]
      exact (Scheme.Hom.ker_comp_of_isIso
        (pullbackSymmetry I.subschemeι (𝒰.f i)).hom
        (pullback.fst (𝒰.f i) I.subschemeι)).symm
    _ = I := (I.subschemeι.iInf_ker_openCover_map_comp _).trans I.ker_subschemeι

/-- A function on `U` whose pullback vanishes on `f⁻¹ U` still vanishes on any smaller open. -/
theorem _root_.AlgebraicGeometry.Scheme.Hom.ker_app_le_ker_appLE {X Z : Scheme.{u}} (f : X ⟶ Z)
    {U : Z.Opens} {V : X.Opens} (e : V ≤ f ⁻¹ᵁ U) :
    RingHom.ker (f.app U).hom ≤ RingHom.ker (f.appLE U V e).hom :=
  fun x hx ↦ by simp [Scheme.Hom.appLE, RingHom.mem_ker.1 hx]

/-- If `f : X ⟶ Z` kills the sections of an ideal sheaf `I` over an affine open `U`, restricted to
`V ⊆ f⁻¹ U`, then it kills its sections over any smaller affine open `U'`, restricted to any
`V' ⊆ V ∩ f⁻¹ U'`: the sections of `I` over `U'` are generated by those over `U`. -/
theorem _root_.AlgebraicGeometry.Scheme.IdealSheafData.ideal_le_ker_appLE_of_le
    {X Z : Scheme.{u}} (I : Z.IdealSheafData) (f : X ⟶ Z) {U U' : Z.affineOpens} (hU : U' ≤ U)
    {V V' : X.Opens} (hV : V' ≤ V) (e : V ≤ f ⁻¹ᵁ U) (e' : V' ≤ f ⁻¹ᵁ U')
    (h : I.ideal U ≤ RingHom.ker (f.appLE U V e).hom) :
    I.ideal U' ≤ RingHom.ker (f.appLE U' V' e').hom := by
  rw [← I.map_ideal hU, Ideal.map_le_iff_le_comap, RingHom.comap_ker, ← CommRingCat.hom_comp,
    Scheme.Hom.map_appLE]
  refine h.trans fun x hx ↦ ?_
  rw [RingHom.mem_ker, ← Scheme.Hom.appLE_map f e (homOfLE hV).op, CommRingCat.comp_apply,
    RingHom.mem_ker.1 hx, map_zero]

/-- Ideal sheaves with equal pullbacks to every member of an open cover are equal. -/
theorem _root_.AlgebraicGeometry.Scheme.IdealSheafData.ext_of_comap_openCover
    {I J : X.IdealSheafData} (𝒰 : X.OpenCover)
    (h : ∀ i, I.comap (𝒰.f i) = J.comap (𝒰.f i)) : I = J := by
  rw [← I.iInf_map_comap_openCover 𝒰, ← J.iInf_map_comap_openCover 𝒰]
  simp only [h]

/-- An ideal sheaf on `X` is determined by the morphisms to `X` that factor through its closed
subscheme: if the same morphisms `t : T ⟶ X` satisfy `I ≤ t.ker` and `J ≤ t.ker`, then `I = J`. -/
theorem _root_.AlgebraicGeometry.Scheme.IdealSheafData.ext_of_le_ker_iff {I J : X.IdealSheafData}
    (h : ∀ {T : Scheme.{u}} (t : T ⟶ X), I ≤ t.ker ↔ J ≤ t.ker) : I = J :=
  le_antisymm (((h J.subschemeι).2 (ker_subschemeι _).ge).trans (ker_subschemeι _).le)
    (((h I.subschemeι).1 (ker_subschemeι _).ge).trans (ker_subschemeι _).le)

end TauCeti
