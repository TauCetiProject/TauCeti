module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
import TauCeti.AlgebraicGeometry.Scheme.Opens

/-!
# Locality of ideal sheaf data

An ideal sheaf is determined by its pullbacks to an open cover. This lets affine
computations of ideal sheaves, such as Fitting ideals, be glued on an arbitrary scheme.
For a morphism `f : X ⟶ Y`, it suffices to compare pullbacks along affine charts of `X`
mapping into affine opens of `Y` (`ext_of_comap_fromSpec_over`).

Vanishing of the sections of an ideal sheaf under a morphism also passes to smaller affine opens
(`AlgebraicGeometry.Scheme.IdealSheafData.ideal_le_ker_appLE_of_le`), so it can be checked
locally on an affine basis. An ideal sheaf lies in the kernel of a quasi-compact morphism as soon
as it lies in the kernel of the morphism's restriction to each member of an open cover of the
source (`AlgebraicGeometry.Scheme.Hom.le_ker_iff_of_openCover`).

-/

public section

noncomputable section

open CategoryTheory Limits AlgebraicGeometry Scheme.IdealSheafData

namespace AlgebraicGeometry.Scheme

universe u

variable {X : Scheme.{u}}

/-- An ideal sheaf is the intersection of the pushforwards of its restrictions to
an open cover. -/
theorem IdealSheafData.iInf_map_comap_openCover
    (I : X.IdealSheafData) (𝒰 : X.OpenCover) :
    (⨅ i, (I.comap (𝒰.f i)).map (𝒰.f i)) = I := by
  -- Mathlib's `Scheme.Hom.iInf_ker_openCover_map_comp` computes the kernel on an
  -- open cover of its source; apply it to the ideal sheaf's closed immersion and the
  -- pulled back cover, whose maps are by definition the `pullback.snd (𝒰.f i) I.subschemeι`.
  calc
    _ = ⨅ i, (pullback.snd (𝒰.f i) I.subschemeι ≫ I.subschemeι).ker := by
      simp [comap, map_ker, pullback.condition]
    _ = I := (I.subschemeι.iInf_ker_openCover_map_comp (𝒰.pullback₂ I.subschemeι)).trans
      I.ker_subschemeι

/-- A function on `U` whose pullback vanishes on `f⁻¹ U` still vanishes on any smaller open. -/
theorem Hom.ker_app_le_ker_appLE {X Z : Scheme.{u}} (f : X ⟶ Z)
    {U : Z.Opens} {V : X.Opens} (e : V ≤ f ⁻¹ᵁ U) :
    RingHom.ker (f.app U).hom ≤ RingHom.ker (f.appLE U V e).hom :=
  fun x hx ↦ by simp [Scheme.Hom.appLE, RingHom.mem_ker.1 hx]

/-- If `f : X ⟶ Z` kills the sections of an ideal sheaf `I` over an affine open `U`, restricted to
`V ⊆ f⁻¹ U`, then it kills its sections over any smaller affine open `U'`, restricted to any
`V' ⊆ V ∩ f⁻¹ U'`: the sections of `I` over `U'` are generated by those over `U`. -/
theorem IdealSheafData.ideal_le_ker_appLE_of_le
    {X Z : Scheme.{u}} (I : Z.IdealSheafData) (f : X ⟶ Z) {U U' : Z.affineOpens} (hU : U' ≤ U)
    {V V' : X.Opens} (hV : V' ≤ V) (e : V ≤ f ⁻¹ᵁ U) (e' : V' ≤ f ⁻¹ᵁ U')
    (h : I.ideal U ≤ RingHom.ker (f.appLE U V e).hom) :
    I.ideal U' ≤ RingHom.ker (f.appLE U' V' e').hom := by
  rw [← I.map_ideal hU, Ideal.map_le_iff_le_comap, RingHom.comap_ker, ← CommRingCat.hom_comp,
    Scheme.Hom.map_appLE]
  refine h.trans fun x hx ↦ ?_
  rw [RingHom.mem_ker, ← Scheme.Hom.appLE_map f e (homOfLE hV).op, CommRingCat.comp_apply,
    RingHom.mem_ker.1 hx, map_zero]

/-- If `I` lies in the kernel of `f : X ⟶ Z`, then the sections of `I` over an affine open `U` die
under `f.appLE U V e` for every open `V ⊆ f⁻¹ U`. -/
theorem IdealSheafData.ideal_le_ker_appLE {X Z : Scheme.{u}} (I : Z.IdealSheafData) {f : X ⟶ Z}
    (h : I ≤ f.ker) (U : Z.affineOpens) {V : X.Opens} (e : V ≤ f ⁻¹ᵁ U) :
    I.ideal U ≤ RingHom.ker (f.appLE U V e).hom :=
  (h U).trans ((f.ideal_ker_le U).trans (f.ker_app_le_ker_appLE e))

/-- An ideal sheaf `I` lies in the kernel of `f : X ⟶ Z` as soon as, around each point `p` of `X`,
the sections of `I` over some affine open `U` of `Z` die under `f.appLE U W e` for an open
neighbourhood `W ⊆ f⁻¹ U` of `p`. -/
theorem IdealSheafData.le_ker_of_forall_exists {X Z : Scheme.{u}} (I : Z.IdealSheafData)
    (f : X ⟶ Z)
    (h : ∀ p : X, ∃ (U : Z.affineOpens) (W : X.Opens) (e : W ≤ f ⁻¹ᵁ U), p ∈ W ∧
      I.ideal U ≤ RingHom.ker (f.appLE U W e).hom) :
    I ≤ f.ker := by
  refine le_ofIdeals_iff.2 fun V x hx ↦ RingHom.mem_ker.2 <| X.IsSheaf.section_ext fun p hp ↦ ?_
  -- near `p`, refine `V` to an affine open `V' ⊆ V ∩ U` of `Z` containing `f p`
  obtain ⟨U, W, e, hpW, hU⟩ := h p
  obtain ⟨_, ⟨V', hV', rfl⟩, hpV', hV'le⟩ := Z.isBasis_affineOpens.exists_subset_of_mem_open
    (show f p ∈ V.1 ⊓ U.1 from ⟨hp, e hpW⟩) (V.1 ⊓ U.1).2
  have hV'V : (⟨V', hV'⟩ : Z.affineOpens) ≤ V := fun y hy ↦ (hV'le hy).1
  have hV'U : (⟨V', hV'⟩ : Z.affineOpens) ≤ U := fun y hy ↦ (hV'le hy).2
  refine ⟨W ⊓ f ⁻¹ᵁ V', inf_le_right.trans (f.preimage_mono hV'V), ⟨hpW, hpV'⟩, ?_⟩
  have := I.ideal_le_ker_appLE_of_le f (U' := ⟨V', hV'⟩) hV'U (inf_le_left : W ⊓ f ⁻¹ᵁ V' ≤ W) e
    inf_le_right hU (I.ideal_le_comap_ideal hV'V hx)
  rw [RingHom.mem_ker, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE] at this
  simpa [Scheme.Hom.appLE] using this

/-- An ideal sheaf `I` lies in the kernel of `f : X ⟶ Z` if and only if its sections over every
affine open `U` of `Z` die under `f.appLE U V e` for every affine open `V ⊆ f⁻¹ U` of `X`. -/
theorem IdealSheafData.le_ker_iff {X Z : Scheme.{u}} (I : Z.IdealSheafData) (f : X ⟶ Z) :
    I ≤ f.ker ↔ ∀ (U : Z.affineOpens) (V : X.affineOpens) (e : V.1 ≤ f ⁻¹ᵁ U.1),
      I.ideal U ≤ RingHom.ker (f.appLE U V e).hom := by
  refine ⟨fun h U V e ↦ I.ideal_le_ker_appLE h U e, fun h ↦ I.le_ker_of_forall_exists f fun p ↦ ?_⟩
  obtain ⟨_, ⟨U, hU, rfl⟩, hpU, -⟩ := Z.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ (f p)) isOpen_univ
  obtain ⟨_, ⟨V, hV, rfl⟩, hpV, hVle⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (show p ∈ (f ⁻¹ᵁ U).1 from hpU) (f ⁻¹ᵁ U).2
  exact ⟨⟨U, hU⟩, V, hVle, hpV, h ⟨U, hU⟩ ⟨V, hV⟩ hVle⟩

/-- Ideal sheaves with equal pullbacks to every member of an open cover are equal. -/
theorem IdealSheafData.ext_of_comap_openCover
    {I J : X.IdealSheafData} (𝒰 : X.OpenCover)
    (h : ∀ i, I.comap (𝒰.f i) = J.comap (𝒰.f i)) : I = J := by
  rw [← I.iInf_map_comap_openCover 𝒰, ← J.iInf_map_comap_openCover 𝒰]
  simp only [h]

/-- An ideal sheaf `I` on `Y` lies in the kernel of a quasi-compact morphism `f : X ⟶ Y` if and
only if it lies in the kernel of `𝒰.f a ≫ f` for every member `a` of an open cover `𝒰` of `X`. -/
theorem Hom.le_ker_iff_of_openCover {X Y : Scheme.{u}} (f : X ⟶ Y)
    [QuasiCompact f] (I : Y.IdealSheafData) (𝒰 : X.OpenCover) :
    I ≤ f.ker ↔ ∀ a, I ≤ (𝒰.f a ≫ f).ker := by
  rw [← f.iInf_ker_openCover_map_comp 𝒰, le_iInf_iff]

/-- Ideal sheaves on `X` are equal if their pullbacks agree on every affine chart mapping
into an affine open of `Y`. This allows comparisons local on both sides of `f`. -/
theorem IdealSheafData.ext_of_comap_fromSpec_over
    {Y : Scheme.{u}} {I J : X.IdealSheafData} (f : X ⟶ Y)
    (h : ∀ (U : Y.affineOpens) (V : X.affineOpens), V.1 ≤ f ⁻¹ᵁ U.1 →
      I.comap V.2.fromSpec = J.comap V.2.fromSpec) : I = J := by
  exact ext_of_comap_openCover (Scheme.AffineOpenCover.ofIsOpenCover _
    f.iSup_affineOpens_le_preimage_eq_top fun V ↦ V.1.2).openCover
    fun V ↦ V.2.elim fun U hVU ↦ h U V.1 hVU

end AlgebraicGeometry.Scheme
