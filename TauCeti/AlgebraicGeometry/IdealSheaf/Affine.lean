module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import TauCeti.AlgebraicGeometry.IdealSheaf.OfIdealTop

/-!
# Affine descriptions of pullback ideal sheaves

Restricting ideal sheaf data to an affine open subscheme `U`, or pulling it back along
`Spec Γ(X, U) ⟶ X`, gives the ideal sheaf generated by its ideal of sections on that open. This
file records both equalities, so local equations can be transported using Mathlib's actual closed
subscheme construction.

More generally, for affine opens `U ⊆ Y` and `V ⊆ g⁻¹ U` and a morphism `g : X ⟶ Y`, the ideal
of the inverse image `I.comap g` on `V` is generated by the image of `I(U)` under
`g.appLE U V` (`ideal_comap_of_le`); pulling `I.comap g` back along `Spec Γ(X, V) ⟶ X` gives the
ideal sheaf generated by that image (`comap_comap_fromSpec_eq_ofIdealTop`).

For nested ideal sheaves `K ≤ I'`, the closed subscheme `V(I')` lies in `V(K)`, and over an affine
open `U` of `X` the kernel of the restriction of sections from `V(K)` to `V(I')` is the image of
`I'(U)` in `Γ(X, U) ⧸ K(U)` (`ker_inclusion_app`).
-/

public section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- Restricting an ideal sheaf to an affine open gives the ideal sheaf generated by its
ideal on that open, transported to the global sections of the open subscheme. -/
@[simp]
theorem comap_ι_eq_ofIdealTop (I : X.IdealSheafData) (U : X.affineOpens) :
    I.comap U.1.ι = ofIdealTop ((I.ideal U).map U.1.topIso.inv.hom) := by
  apply ext_of_isAffine
  rw [ideal_comap_of_isOpenImmersion]
  rw [Scheme.Opens.ι_appIso]
  -- The inclusion's section isomorphism is the identity on the sections of its image.
  -- Restate its inverse ring homomorphism to remove the categorical coercions.
  change (I.ideal ⟨U.1.ι ''ᵁ ⊤, _⟩).comap (RingHom.id _) = _
  rw [Ideal.comap_id]
  simp only [ofIdealTop_ideal, homOfLE_refl, op_id, CategoryTheory.Functor.map_id,
    CommRingCat.hom_id, Ideal.map_id]
  exact (I.map_ideal (U := ⟨U.1.ι ''ᵁ ⊤, _⟩) (V := U) U.1.ι_image_top.le).symm

/-- Pulling an ideal sheaf back along `Spec Γ(X, U) ⟶ X` for an affine open `U` gives the ideal
sheaf generated by its ideal on `U`, read in the global sections of `Spec Γ(X, U)`. -/
@[simp]
theorem comap_fromSpec_eq_ofIdealTop (I : X.IdealSheafData) {U : X.Opens} (hU : IsAffineOpen U) :
    I.comap hU.fromSpec =
      ofIdealTop ((I.ideal ⟨U, hU⟩).map (Scheme.ΓSpecIso Γ(X, U)).inv.hom) := by
  rw [← hU.isoSpec_inv_ι, comap_comp, comap_ι_eq_ofIdealTop I ⟨U, hU⟩, comap_ofIdealTop,
    Ideal.map_map, ← CommRingCat.hom_comp, IsAffineOpen.isoSpec_inv_appTop,
    ← Category.assoc, Iso.inv_hom_id, Category.id_comp]

/-- For affine opens `U ⊆ Y` and `V ⊆ g⁻¹ U`, the ideal of the inverse image `I.comap g` on `V` is
generated by the image of the ideal `I(U)` under `g.appLE U V`. -/
theorem ideal_comap_of_le {Y : Scheme.{u}} (I : Y.IdealSheafData) (g : X ⟶ Y)
    (U : Y.affineOpens) (V : X.affineOpens) (h : V.1 ≤ g ⁻¹ᵁ U.1) :
    (I.comap g).ideal V = (I.ideal U).map (g.appLE U V h).hom := by
  -- Restricted to `V`, the inverse image is the pullback along `g.resLE U V` of the restriction
  -- of `I` to `U`; read both sides on the global sections of `V`.
  have key : (I.comap g).comap V.1.ι =
      ofIdealTop (((I.ideal U).map U.1.topIso.inv.hom).map (g.resLE U V h).appTop.hom) := by
    rw [← comap_comp, ← Scheme.Hom.resLE_comp_ι g h, comap_comp, comap_ι_eq_ofIdealTop,
      comap_ofIdealTop]
  rw [comap_ι_eq_ofIdealTop] at key
  have h₁ := congrArg (fun J : V.1.toScheme.IdealSheafData ↦
    J.ideal ⟨⊤, isAffineOpen_top V.1.toScheme⟩) key
  simp only [ofIdealTop_ideal, homOfLE_refl, op_id, V.1.toScheme.presheaf.map_id,
    CommRingCat.hom_id, Ideal.map_id] at h₁
  have h₂ := congrArg (Ideal.map V.1.topIso.hom.hom) h₁
  simp only [Ideal.map_map, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id,
    Ideal.map_id] at h₂
  rw [h₂, Scheme.Hom.appTop, Scheme.Hom.resLE_app_top]
  simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]

/-- Let `f : Y ⟶ X` map an affine open `V` of `Y` into an affine open `U` of `X`. Pulling the
inverse image `I.comap f` back along `Spec Γ(Y, V) ⟶ Y` gives the ideal sheaf generated by the
extension of `I(U)` along `f.appLE U V`, read in the global sections of `Spec Γ(Y, V)`. -/
theorem comap_comap_fromSpec_eq_ofIdealTop {Y : Scheme.{u}} (I : X.IdealSheafData) (f : Y ⟶ X)
    {U : X.Opens} {V : Y.Opens} (hU : IsAffineOpen U) (hV : IsAffineOpen V) (e : V ≤ f ⁻¹ᵁ U) :
    (I.comap f).comap hV.fromSpec = ofIdealTop (((I.ideal ⟨U, hU⟩).map (f.appLE U V e).hom).map
      (Scheme.ΓSpecIso Γ(Y, V)).inv.hom) := by
  rw [comap_fromSpec_eq_ofIdealTop, ideal_comap_of_le I f ⟨U, hU⟩ ⟨V, hV⟩ e]

/-- For ideal sheaves `K ≤ I'` and an affine open `U`, the kernel of the map from the sections of
`V(K)` over `U` to those of its closed subscheme `V(I')` is generated by the image of `I'(U)`. -/
theorem ker_inclusion_app {K I' : X.IdealSheafData} (h : K ≤ I') (U : X.affineOpens) :
    RingHom.ker ((inclusion h).app (K.subschemeι ⁻¹ᵁ U.1)).hom =
      (I'.ideal U).map (K.subschemeι.app U).hom := by
  have h₁ : I'.ideal U = (RingHom.ker ((inclusion h).app (K.subschemeι ⁻¹ᵁ U.1)).hom).comap
      (K.subschemeι.app U).hom := by
    rw [← ker_subschemeι_app, ← inclusion_subschemeι h, Scheme.Hom.comp_app]
    exact (RingHom.comap_ker _ _).symm
  rw [h₁, Ideal.map_comap_of_surjective _ (K.subschemeι_app_surjective U)]

end AlgebraicGeometry.Scheme.IdealSheafData
