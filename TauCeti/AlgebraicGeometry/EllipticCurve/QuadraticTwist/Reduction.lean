/-!
# The reduction of a quadratic twist of a split multiplicative curve

Let `W` be an elliptic curve with split multiplicative reduction over the fraction field `K` of a
discrete valuation ring `R`, and let `E` be the quadratic twist of `W` by a continuous character
`η : Gal(Kᵃˡᵍ/K) → {±1}` (`WeierstrassCurve.IsQuadraticTwistBy`). This file reads the reduction
type of `E`, computed on a minimal equation, off the character `η`.

* Over a Henselian `R`, `E` has split multiplicative reduction exactly when `η = 1`: two curves
  with split multiplicative reduction and the same `j`-invariant are isomorphic, and the twisting
  character of a curve isomorphic to `W` is trivial.
* Over a nonarchimedean local field `K`, `E` has multiplicative reduction exactly when `η` is
  unramified, that is trivial on the inertia subgroup `I_K`, and additive reduction exactly when
  `η` is ramified. Together with the split criterion, the reduction is nonsplit multiplicative
  exactly when `η` is unramified and nontrivial.

For the multiplicative criterion, let `a` be a square root on which `η` acts, so that `η` is
trivial on inertia exactly when `I_K` fixes `K(a)`. If `E` has multiplicative reduction, it is the
twist of `W` by its node quadratic `T² + a₁ T + n`, which has integral coefficients and unit
discriminant; a root of it generates `K(a)`, so `I_K` fixes `K(a)`. Conversely, if `I_K` fixes
`K(a)`, then `K(a)/K` is unramified, hence generated by a root `θ` of a monic integral quadratic
`T² + t T + n` with unit discriminant, and `2θ + t` is a multiple of `a` over `K`. So `E` is
the twist of `W` by `(t, n)`, whose equation is integral with unit `c₄`, hence minimal with
multiplicative reduction. Since `j(E) = j(W)` is not integral, the reduction of `E` is not good,
and additive reduction is the remaining case. All of this holds in residue characteristic `2`;
the reduction is always computed on a minimal equation, never on the twisted equation by `d`.

The intended `W` is a Tate curve `E_q`, which has split multiplicative reduction
(`TauCeti.hasSplitMultiplicativeReduction_tateCurveAt`, stated over the valuation ring of the norm)
and of which every curve with the same nonintegral `j`-invariant is the twist by a unique character
(`TauCeti.existsUnique_isQuadraticTwistBy_tateCurveAt`).

## Main results

* `WeierstrassCurve.IsQuadraticTwistBy.hasSplitMultiplicativeReduction_minimal_iff`: split
  multiplicative reduction exactly for the trivial character.
* `WeierstrassCurve.IsQuadraticTwistBy.hasMultiplicativeReduction_minimal_iff`: multiplicative
  reduction exactly for a character trivial on inertia.
* `WeierstrassCurve.IsQuadraticTwistBy.hasAdditiveReduction_minimal_iff`: additive reduction
  exactly for a ramified character.

## References

* B. Mazur and K. Rubin, *Selmer companion curves*, Trans. Amer. Math. Soc. 367 (2015), §2,
  Definition 2.1 and Proposition 2.2.
* J. H. Silverman, *Advanced Topics in the Arithmetic of Elliptic Curves*, GTM 151, V.5.
-/

public section

namespace WeierstrassCurve

open ValuativeRel TauCeti IntermediateField

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
  {W E : WeierstrassCurve K} [W.IsElliptic] [E.IsElliptic] {η : Gal(AlgebraicClosure K/K) →ₜ* ℤˣ}

variable (R) in
/-- **Split multiplicative reduction of a twist.** Over the fraction field of a Henselian discrete
valuation ring, let `W` have split multiplicative reduction and let `E` be the quadratic twist of
`W` by `η`. Then a minimal equation of `E` has split multiplicative reduction exactly when `η` is
trivial. -/
theorem IsQuadraticTwistBy.hasSplitMultiplicativeReduction_minimal_iff [HenselianLocalRing R]
    [hW : W.HasSplitMultiplicativeReduction R] (h : W.IsQuadraticTwistBy E η) :
    (E.minimal R).HasSplitMultiplicativeReduction R ↔ η = 1 := by
  have h2 := h.two_ne_zero
  obtain ⟨C₀, hC₀⟩ := E.exists_smul_eq_minimal R
  refine ⟨fun hs ↦ ?_, ?_⟩
  · -- `E.minimal` and `W` are split with the same `j`, hence isomorphic over `K`
    obtain ⟨C, hC⟩ := exists_smul_eq_of_j_eq_of_hasSplitMultiplicativeReduction R (E := W)
      (E' := E.minimal R) ((j_minimal R E).trans h.j_eq)
    have h1 : W.IsQuadraticTwistBy E 1 :=
      (isQuadraticTwistBy_one_iff h2).mpr ⟨C₀⁻¹ * C⁻¹, by rw [mul_smul, ← hC, inv_smul_smul,
        ← hC₀, inv_smul_smul]⟩
    exact h.unique (hW.j_ne_zero R) (hW.j_ne_1728 R) h1
  · rintro rfl
    obtain ⟨C, hC⟩ := (isQuadraticTwistBy_one_iff h2).mp h
    exact HasSplitMultiplicativeReduction.of_isMinimal_smul R (C₀ * C)
      (by rw [mul_smul, hC, hC₀]) hW

section LocalField

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  {W E : WeierstrassCurve K} [W.IsElliptic] [E.IsElliptic] {η : Gal(AlgebraicClosure K/K) →ₜ* ℤˣ}

/-- At multiplicative reduction the twisting character is unramified: `E` is the twist of `W` by
its node quadratic `T² + a₁ T + n`, so `η` is the character of a square root `a` of its
discriminant `a₁² - 4n`, and `K⟮a⟯` contains the root `(a - a₁) / 2` of that quadratic, which has
integral coefficients and unit discriminant. So inertia fixes `a`. -/
private theorem IsQuadraticTwistBy.forall_mem_inertiaSubgroup_eq_one
    [hW : W.HasSplitMultiplicativeReduction 𝒪[K]] (h : W.IsQuadraticTwistBy E η)
    [(E.minimal 𝒪[K]).HasMultiplicativeReduction 𝒪[K]] :
    ∀ g ∈ inertiaSubgroup K, η g = 1 := by
  have h2 := h.two_ne_zero
  have h2Ω := h.two_ne_zero_algebraicClosure
  have : NeZero (2 : AlgebraicClosure K) := ⟨h2Ω⟩
  obtain ⟨C₀, hC₀⟩ := E.exists_smul_eq_minimal 𝒪[K]
  set E₁ := E.minimal 𝒪[K]
  obtain ⟨n₀, -, hD, hn₀⟩ := E₁.exists_algebraMap_eq_nodePolynomial_coeff_zero_div 𝒪[K]
  set n := E₁.nodePolynomial.coeff 0 / E₁.c₄
  obtain ⟨C, hC⟩ := exists_smul_eq_quadraticTwistOf_of_j_eq_of_hasMultiplicativeReduction
    𝒪[K] (E := E₁) (E' := W) ((j_minimal 𝒪[K] E).trans h.j_eq).symm
  have hc : E₁.a₁ ^ 2 - 4 * n ≠ 0 := by
    rw [← integralModel_a₁_eq 𝒪[K] E₁, ← hn₀, ← map_pow, ← map_ofNat (algebraMap 𝒪[K] K) 4,
      ← map_mul, ← map_sub]
    exact (map_ne_zero_iff _ (IsFractionRing.injective 𝒪[K] K)).mpr hD.ne_zero
  -- `η` is the character of a square root `a` of the discriminant of the node quadratic
  obtain ⟨a, ha⟩ :=
    IsAlgClosed.exists_pow_nat_eq (algebraMap K (AlgebraicClosure K) (E₁.a₁ ^ 2 - 4 * n)) two_pos
  obtain ⟨η', hη'⟩ := TauCeti.exists_continuousMonoidHom_apply_eq_zsmul_of_sq_eq ha
  obtain ⟨C₁, hC₁⟩ := W.exists_smul_quadraticTwistOf_zero_neg_discrim_eq (-E₁.a₁) n
    (isUnit_iff_ne_zero.mpr h2)
  rw [neg_sq] at hC₁
  obtain rfl : η' = η := IsQuadraticTwistBy.unique (hW.j_ne_zero 𝒪[K]) (hW.j_ne_1728 𝒪[K])
    (.intro (Units.mk0 _ hc) ha hη' (C₀⁻¹ * C⁻¹ * C₁)
      (by rw [mul_smul, mul_smul, Units.val_mk0, hC₁, ← hC, inv_smul_smul, ← hC₀,
        inv_smul_smul])) h
  intro (g : Gal(AlgebraicClosure K/K)) hg
  have ha0 : a ≠ 0 := (pow_ne_zero_iff _root_.two_ne_zero).mp (ha ▸ (map_ne_zero _).mpr hc)
  refine TauCeti.eq_one_of_apply_eq_zsmul_of_apply_eq_self ha0 h2Ω (hη' g) ?_
  by_cases haK : a ∈ (⊥ : IntermediateField K (AlgebraicClosure K))
  · obtain ⟨x, rfl⟩ := mem_bot.mp haK
    exact g.commutes x
  have hfin := TauCeti.IntermediateField.finrank_adjoin_simple_eq_two_of_notMem_bot ha haK
  have := Algebra.isSeparable_of_finrank_eq_two h2 hfin
  -- `θ = (a - a₁) / 2` is a root of the node quadratic in `K⟮a⟯`
  set θ := (a - algebraMap K _ E₁.a₁) / 2
  have hθ : 2 * θ + algebraMap K _ E₁.a₁ = a := by rw [mul_div_cancel₀ _ h2Ω, sub_add_cancel]
  refine (mem_fixingSubgroup_iff _ _).mp
    ((inertiaSubgroup_le_fixingSubgroup_iff_exists_sq_add_mul_add_eq_zero _ hfin).mpr
      ⟨_, _, hD, θ,
        div_mem (sub_mem (mem_adjoin_simple_self K a) (IntermediateField.algebraMap_mem _ _))
          (ofNat_mem _ 2),
        fun ⟨x, hx⟩ ↦ haK (mem_bot.mpr ⟨2 * x + E₁.a₁, by
          rw [map_add, map_mul, map_ofNat, hx, hθ]⟩),
        ?_⟩ hg) a
    (mem_adjoin_simple_self K a)
  rw [← Algebra.algebraMap_ofSubsemiring_apply, integralModel_a₁_eq,
    ← Algebra.algebraMap_ofSubsemiring_apply, hn₀]
  have hq := (quadratic_eq_zero_iff_discrim_eq_sq (b := algebraMap K _ E₁.a₁)
    (c := algebraMap K _ n) one_ne_zero θ).mpr (by
      rw [discrim, mul_one, mul_one, hθ, ha, map_sub, map_pow, map_mul, map_ofNat])
  linear_combination hq

/-- An unramified twisting character gives multiplicative reduction. If `η` is trivial on inertia,
then inertia fixes the field `K⟮a⟯` of a square root on which `η` acts. Either `a ∈ K`, and then
`η = 1`, or `K⟮a⟯/K` is unramified, hence contains a root `θ` of an integral monic quadratic
`T² + t T + n` of unit discriminant; then `2θ + t` is a square root of `t² - 4n` in `K⟮a⟯`, so `E`
is the twist of `W` by `(t, n)`, which has multiplicative reduction. -/
private theorem IsQuadraticTwistBy.hasMultiplicativeReduction_minimal
    [W.HasSplitMultiplicativeReduction 𝒪[K]] (h : W.IsQuadraticTwistBy E η)
    (hI : ∀ g ∈ inertiaSubgroup K, η g = 1) :
    (E.minimal 𝒪[K]).HasMultiplicativeReduction 𝒪[K] := by
  have h2 := h.two_ne_zero
  have h2Ω := h.two_ne_zero_algebraicClosure
  obtain ⟨d, a, ha, hη, -⟩ := isQuadraticTwistBy_iff.mp h
  by_cases haK : a ∈ (⊥ : IntermediateField K (AlgebraicClosure K))
  · -- `a ∈ K` is fixed by every automorphism, so `η` is trivial and the reduction is split
    have ha0 : a ≠ 0 := (pow_ne_zero_iff _root_.two_ne_zero).mp (ha ▸ (map_ne_zero _).mpr d.ne_zero)
    obtain rfl : η = 1 := TauCeti.continuousMonoidHom_eq_of_apply_eq_zsmul ha0 h2Ω hη
      fun g ↦ by obtain ⟨x, rfl⟩ := mem_bot.mp haK; simp
    exact ((h.hasSplitMultiplicativeReduction_minimal_iff 𝒪[K]).mpr
      rfl).toHasMultiplicativeReduction
  have hfin := TauCeti.IntermediateField.finrank_adjoin_simple_eq_two_of_notMem_bot ha haK
  have := Algebra.isSeparable_of_finrank_eq_two h2 hfin
  obtain ⟨t, n, hD, θ, hθa, hθK, hroot⟩ :=
    (inertiaSubgroup_le_fixingSubgroup_iff_exists_sq_add_mul_add_eq_zero _ hfin).mp
      ((le_fixedField_iff_le_fixingSubgroup _ _).mp (adjoin_simple_le_iff.mpr
        ((mem_fixedField_iff _ _).mpr fun g hg ↦ by
          rw [hη g, hI g hg, Units.val_one, one_smul])))
  -- `2θ + t` is a square root of `t² - 4n` in `K⟮a⟯`, so `E` is the twist by `(t, n)`
  have hDK : (t : K) ^ 2 - 4 * n ≠ 0 := fun h0 ↦ hD.ne_zero (Subtype.ext (by push_cast; exact h0))
  have hb := discrim_eq_sq_of_quadratic_eq_zero (a := (1 : AlgebraicClosure K))
    (b := algebraMap K _ t) (c := algebraMap K _ n) (x := θ) (by linear_combination hroot)
  rw [discrim, mul_one, mul_one] at hb
  obtain ⟨C, hC⟩ := h.exists_smul_quadraticTwistOf_zero_eq_of_mem_adjoin h2 ha hη (Units.mk0 _ hDK)
    (b := 2 * θ + algebraMap K _ t)
    (by rw [← hb, Units.val_mk0, map_sub, map_pow, map_mul, map_ofNat])
    (fun ⟨x, hx⟩ ↦ hθK ⟨(x - t) / 2, by
      rw [map_div₀, map_sub, hx, map_ofNat, add_sub_cancel_right, mul_div_cancel_left₀ _ h2Ω]⟩)
    (add_mem (mul_mem (ofNat_mem _ 2) hθa) (IntermediateField.algebraMap_mem _ _))
  obtain ⟨C', hC'⟩ := W.exists_smul_quadraticTwistOf_zero_neg_discrim_eq (t : K) n
    (isUnit_iff_ne_zero.mpr h2)
  obtain ⟨C₀, hC₀⟩ := E.exists_smul_eq_minimal 𝒪[K]
  have := W.isElliptic_quadraticTwistOf _ _ hDK
  have hm := hasMultiplicativeReduction_quadraticTwistOf_algebraMap 𝒪[K] (E := W) hD
  rw [Algebra.algebraMap_ofSubsemiring_apply, Algebra.algebraMap_ofSubsemiring_apply] at hm
  exact HasMultiplicativeReduction.of_isMinimal_smul 𝒪[K] (C₀ * C * C'⁻¹)
    (by rw [mul_smul, mul_smul, ← hC', inv_smul_smul, ← hC₀, ← hC, Units.val_mk0]) hm

/-- **Multiplicative reduction of a twist.** Over a nonarchimedean local field `K`, let `W` have
split multiplicative reduction and let `E` be the quadratic twist of `W` by `η`. Then a minimal
equation of `E` has multiplicative reduction exactly when `η` is unramified, that is trivial on
the inertia subgroup. This holds in every residue characteristic, including `2`. -/
theorem IsQuadraticTwistBy.hasMultiplicativeReduction_minimal_iff
    [W.HasSplitMultiplicativeReduction 𝒪[K]] (h : W.IsQuadraticTwistBy E η) :
    (E.minimal 𝒪[K]).HasMultiplicativeReduction 𝒪[K] ↔ ∀ g ∈ inertiaSubgroup K, η g = 1 :=
  ⟨fun _ ↦ h.forall_mem_inertiaSubgroup_eq_one, h.hasMultiplicativeReduction_minimal⟩

/-- **Additive reduction of a twist.** Over a nonarchimedean local field, let `W` have split
multiplicative reduction and let `E` be the quadratic twist of `W` by `η`. Then a minimal equation
of `E` has additive reduction exactly when `η` is ramified. Its `j`-invariant is that of `W`, which
is not integral, so the reduction is not good, and it is additive exactly when it is not
multiplicative. -/
theorem IsQuadraticTwistBy.hasAdditiveReduction_minimal_iff
    [hW : W.HasSplitMultiplicativeReduction 𝒪[K]] (h : W.IsQuadraticTwistBy E η) :
    (E.minimal 𝒪[K]).HasAdditiveReduction 𝒪[K] ↔ ∃ g ∈ inertiaSubgroup K, η g ≠ 1 := by
  have hgood : ¬ (E.minimal 𝒪[K]).HasGoodReduction 𝒪[K] := fun hg ↦
    HasMultiplicativeReduction.not_isInteger_j 𝒪[K] hW.toHasMultiplicativeReduction
      (by simpa only [j_minimal, h.j_eq] using HasGoodReduction.isInteger_j 𝒪[K] hg)
  refine ⟨fun ha ↦ by_contra fun hne ↦ HasAdditiveReduction.not_hasMultiplicativeReduction 𝒪[K] ha
    (h.hasMultiplicativeReduction_minimal_iff.mpr fun g hg ↦ by_contra fun h1 ↦ hne ⟨g, hg, h1⟩),
    fun ⟨g, hg, hne⟩ ↦ ?_⟩
  rcases hasGoodReduction_or_hasMultiplicativeReduction_or_hasAdditiveReduction 𝒪[K]
    (W := E.minimal 𝒪[K]) with hgd | hm | ha
  · exact (hgood hgd).elim
  · exact (hne (h.hasMultiplicativeReduction_minimal_iff.mp hm g hg)).elim
  · exact ha

end LocalField

end WeierstrassCurve
