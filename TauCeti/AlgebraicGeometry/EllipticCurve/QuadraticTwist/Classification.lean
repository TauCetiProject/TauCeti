/-!
# The twists of an elliptic curve with `j ∉ {0, 1728}` are its quadratic twists

Let `E` be an elliptic curve over a field `K` with `j(E) ∉ {0, 1728}`, and let `Ω` be a separable
closure of `K`. A twist of `E` is a curve `E'` over `K` which becomes isomorphic to `E` over `Ω`.
By Mathlib's `WeierstrassCurve.exists_variableChange_of_j_eq` the twists of `E` are exactly the
elliptic curves `E'` over `K` with `j(E') = j(E)`. This file proves that each of them is
isomorphic over `K` to `E` itself or to the quadratic twist `E.quadraticTwist L` by a quadratic
subextension `L` of `Ω/K`, and that distinct `L` give twists which are not isomorphic over `K`.
Every quadratic twist is a twist: it has the same `j`-invariant
(`WeierstrassCurve.j_quadraticTwist`), and it is not isomorphic to `E` over `K`
(`WeierstrassCurve.not_exists_smul_quadraticTwist_eq`). So `L ↦ E.quadraticTwist L` is a
bijection from the quadratic subextensions of `Ω/K` onto the `K`-isomorphism classes of twists of
`E` other than the class of `E`. The results hold in every characteristic, including `2`, where
the quadratic extensions are of Artin–Schreier type. In characteristic other than `2` and `3`
this is the classification of twists by `K^×/(K^×)²` of Silverman, X.5.4.

## Main results

* `WeierstrassCurve.exists_smul_eq_or_exists_smul_eq_quadraticTwist_of_smul_baseChange_eq`: a form
  of `E` split by a Galois extension `Ω/K`, possibly infinite, is isomorphic over `K` to `E` or to
  the quadratic twist of `E` by a quadratic subextension of `Ω/K`.
* `WeierstrassCurve.exists_smul_quadraticTwist_eq_quadraticTwist_iff`: the quadratic twists by two
  quadratic subextensions of a Galois extension `Ω/K` are isomorphic over `K` exactly when the
  subextensions are equal.
* `WeierstrassCurve.exists_smul_eq_or_exists_smul_eq_quadraticTwist_of_j_eq`: an elliptic curve
  over `K` with the same `j`-invariant as `E` is isomorphic over `K` to `E` or to the quadratic
  twist of `E` by a quadratic subextension of a separable closure of `K`.

## References

* [J. H. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], X.2 and X.5
-/

public section

open IntermediateField

namespace WeierstrassCurve

variable {K : Type*} [Field K] (E : WeierstrassCurve K) [E.IsElliptic]
variable {Ω : Type*} [Field Ω] [Algebra K Ω]

/-- If `ρ` carries `E'` to `E` over `Ω`, then each `K`-automorphism of `Ω` sends `ρ` to `ρ` or to
`[-1] ρ`, because `Aut(E_Ω) = {±1}` and `[-1]` is defined over `K`. -/
private theorem map_eq_or_map_eq_negVariableChange_mul (hj₀ : E.j ≠ 0) (hj₁₇₂₈ : E.j ≠ 1728)
    {E' : WeierstrassCurve K} {ρ : VariableChange Ω}
    (hρ : ρ • E'.baseChange Ω = E.baseChange Ω) (σ : Ω ≃ₐ[K] Ω) :
    ρ.map (σ : Ω →+* Ω) = ρ ∨
      ρ.map (σ : Ω →+* Ω) = (E.baseChange Ω).negVariableChange * ρ := by
  have hσρ : (ρ.map (σ : Ω →+* Ω)) • E'.baseChange Ω = E.baseChange Ω :=
    map_smul_baseChange_eq Ω (σ : Ω →ₐ[K] Ω) hρ
  have hρinv : ρ⁻¹ • E.baseChange Ω = E'.baseChange Ω := by rw [← hρ, inv_smul_smul]
  have hb : (ρ.map (σ : Ω →+* Ω) * ρ⁻¹) • E.baseChange Ω = E.baseChange Ω := by
    rw [mul_smul, hρinv, hσρ]
  rcases E.eq_one_or_eq_negVariableChange_map (f := algebraMap K Ω)
    (FaithfulSMul.algebraMap_injective K Ω) hj₀ hj₁₇₂₈ hb with h | h
  · exact .inl (mul_inv_eq_one.mp h)
  · exact .inr (mul_inv_eq_iff_eq_mul.mp h)

/-- The automorphisms fixing the field generated by the coefficients of an isomorphism
`ρ : E'_Ω ≅ E_Ω` form a subgroup of index one or two. -/
private theorem index_fixingSubgroup_adjoin (hj₀ : E.j ≠ 0) (hj₁₇₂₈ : E.j ≠ 1728)
    {E' : WeierstrassCurve K} {ρ : VariableChange Ω}
    (hρ : ρ • E'.baseChange Ω = E.baseChange Ω) :
    (adjoin K {(ρ.u : Ω), ρ.r, ρ.s, ρ.t}).fixingSubgroup.index = 1 ∨
      (adjoin K {(ρ.u : Ω), ρ.r, ρ.s, ρ.t}).fixingSubgroup.index = 2 := by
  set H := (adjoin K {(ρ.u : Ω), ρ.r, ρ.s, ρ.t}).fixingSubgroup
  -- an automorphism lies in `H` exactly when it fixes `ρ`
  have hmem (σ : Ω ≃ₐ[K] Ω) : σ ∈ H ↔ ρ.map (σ : Ω →+* Ω) = ρ := by
    rw [← Subgroup.zpowers_le, ← le_iff_le, adjoin_le_iff]
    simp [Set.insert_subset_iff, mem_fixedField_zpowers_iff, -mem_fixedField_iff,
      VariableChange.ext_iff, Units.ext_iff]
  have hmul (σ τ : Ω ≃ₐ[K] Ω) : ρ.map ((σ * τ : Ω ≃ₐ[K] Ω) : Ω →+* Ω) =
      (ρ.map (τ : Ω →+* Ω)).map (σ : Ω →+* Ω) := by
    rw [VariableChange.map_map]
    exact congrArg _ (RingHom.ext fun x ↦ AlgEquiv.mul_apply σ τ x)
  set N := (E.baseChange Ω).negVariableChange
  have hconj := E.map_eq_or_map_eq_negVariableChange_mul hj₀ hj₁₇₂₈ hρ
  have hNρ : N * ρ ≠ ρ := fun h ↦ (E.baseChange Ω).negVariableChange_ne_one (mul_eq_right.mp h)
  by_cases h : ∀ σ, σ ∈ H
  · exact .inl (Subgroup.index_eq_one.mpr (eq_top_iff.mpr fun σ _ ↦ h σ))
  push Not at h
  obtain ⟨a, ha⟩ := h
  have ha' : ρ.map (a : Ω →+* Ω) = N * ρ := (hconj a).resolve_left ((hmem a).not.mp ha)
  refine .inr (Subgroup.index_eq_two_iff.mpr ⟨a, fun b ↦ ?_⟩)
  -- `ba` sends `ρ` to `[-1]` times the image of `ρ` under `b`
  have hbN : N.map (b : Ω →+* Ω) = N := E.negVariableChange_baseChange_map Ω (b : Ω →ₐ[K] Ω)
  have hba : ρ.map ((b * a : Ω ≃ₐ[K] Ω) : Ω →+* Ω) = N * ρ.map (b : Ω →+* Ω) := by
    rw [hmul, ha', VariableChange.map_mul, hbN]
  rw [hmem, hmem, hba]
  rcases hconj b with hb | hb
  · rw [hb]
    exact .inr ⟨rfl, hNρ⟩
  · rw [hb, ← mul_assoc, (E.baseChange Ω).negVariableChange_mul_self, one_mul]
    exact .inl ⟨rfl, hNρ⟩

/-- **A form of `E` split by a Galois extension `Ω/K` is `E` or a quadratic twist of `E`**, when
`j(E) ∉ {0, 1728}`. If a curve `E'` over `K` becomes isomorphic to `E` over `Ω`, then it is
isomorphic over `K` either to `E` or to the quadratic twist of `E` by a quadratic subextension
`L` of `Ω/K`. The extension `Ω/K` may be infinite. -/
theorem exists_smul_eq_or_exists_smul_eq_quadraticTwist_of_smul_baseChange_eq [IsGalois K Ω]
    (hj₀ : E.j ≠ 0) (hj₁₇₂₈ : E.j ≠ 1728) {E' : WeierstrassCurve K} {ρ : VariableChange Ω}
    (hρ : ρ • E'.baseChange Ω = E.baseChange Ω) :
    (∃ C : VariableChange K, C • E' = E) ∨
      ∃ (L : IntermediateField K Ω) (_ : Algebra.IsQuadraticExtension K L),
        ∃ C : VariableChange K, C • E' = E.quadraticTwist L := by
  set F := adjoin K {(ρ.u : Ω), ρ.r, ρ.s, ρ.t}
  have hF : Module.finrank K F = 1 ∨ Module.finrank K F = 2 := by
    rw [finrank_eq_fixingSubgroup_index]
    exact E.index_fixingSubgroup_adjoin hj₀ hj₁₇₂₈ hρ
  -- the coefficients of `ρ` lie in `F`
  have hu : (ρ.u : Ω) ∈ F := subset_adjoin K _ (by simp)
  have hr : ρ.r ∈ F := subset_adjoin K _ (by simp)
  have hs : ρ.s ∈ F := subset_adjoin K _ (by simp)
  have ht : ρ.t ∈ F := subset_adjoin K _ (by simp)
  rcases hF with h1 | h2
  · -- `F = K`: the coefficients of `ρ` lie in `K`, so `ρ` descends and `E' ≅ E` over `K`
    left
    have hbot : F = ⊥ := finrank_eq_one_iff.mp h1
    rw [hbot] at hu hr hs ht
    obtain ⟨C, hC⟩ := (VariableChange.mem_range_baseChange_iff (K := K) ρ).mpr
      ⟨mem_bot.mp hu, mem_bot.mp hr, mem_bot.mp hs, mem_bot.mp ht⟩
    dsimp only at hC
    exact ⟨C, smul_eq_of_baseChange_smul_eq Ω (FaithfulSMul.algebraMap_injective K Ω) C
      (by rw [hC]; exact hρ)⟩
  · -- `[F : K] = 2`: `ρ` descends to `F`, and the forms of `E` split by `F` are classified
    have : Algebra.IsQuadraticExtension K F := ⟨h2⟩
    obtain ⟨ρF, hρF⟩ := (VariableChange.mem_range_baseChange_iff (K := F) ρ).mpr
      ⟨⟨⟨_, hu⟩, rfl⟩, ⟨⟨_, hr⟩, rfl⟩, ⟨⟨_, hs⟩, rfl⟩, ⟨⟨_, ht⟩, rfl⟩⟩
    dsimp only at hρF
    have hb (W : WeierstrassCurve K) : (W.baseChange F).baseChange Ω = W.baseChange Ω := by
      simpa [baseChange] using W.map_baseChange (IsScalarTower.toAlgHom K F Ω)
    have hρF' : ρF • E'.baseChange F = E.baseChange F :=
      smul_eq_of_baseChange_smul_eq Ω (FaithfulSMul.algebraMap_injective F Ω) ρF
        (by rw [hρF, hb, hb]; exact hρ)
    rcases E.exists_smul_eq_or_exists_smul_eq_quadraticTwist F hj₀ hj₁₇₂₈ E' ⟨ρF, hρF'⟩ with
      h | h
    · exact .inl h
    · exact .inr ⟨F, inferInstance, h⟩

/-- **Distinct quadratic extensions give distinct twists**, when `j(E) ∉ {0, 1728}`. For quadratic
subextensions `L` and `L'` of a Galois extension `Ω/K`, the quadratic twists of `E` by `L` and by
`L'` are isomorphic over `K` exactly when `L = L'`. With
`exists_smul_eq_or_exists_smul_eq_quadraticTwist_of_j_eq`, this classifies the twists of `E`. -/
@[simp]
theorem exists_smul_quadraticTwist_eq_quadraticTwist_iff [IsGalois K Ω] (hj₀ : E.j ≠ 0)
    (hj₁₇₂₈ : E.j ≠ 1728) (L L' : IntermediateField K Ω) [Algebra.IsQuadraticExtension K L]
    [Algebra.IsQuadraticExtension K L'] :
    (∃ C : VariableChange K, C • E.quadraticTwist L = E.quadraticTwist L') ↔ L = L' := by
  refine ⟨fun ⟨C, hC⟩ ↦ ?_, fun h ↦ by subst h; exact ⟨1, one_smul _ _⟩⟩
  by_contra hne
  -- some `σ` fixes `L` pointwise but moves `L'`: otherwise `L' ⊆ L`, and both have degree two
  obtain ⟨σ, hσL, hσL'⟩ : ∃ σ ∈ L.fixingSubgroup, σ ∉ L'.fixingSubgroup := by
    by_contra! hle
    have hL'L : L' ≤ L := by
      rw [← InfiniteGalois.fixedField_fixingSubgroup L]
      exact (le_iff_le _ _).mpr fun σ hσ ↦ hle σ hσ
    refine hne (eq_of_le_of_finrank_eq hL'L ?_).symm
    rw [Algebra.IsQuadraticExtension.finrank_eq_two, Algebra.IsQuadraticExtension.finrank_eq_two]
  have hσL₀ (x : L) : σ (algebraMap L Ω x) = algebraMap L Ω x :=
    (mem_fixingSubgroup_iff _ _).mp hσL x x.2
  have hσL'₀ : ¬ ∀ x : L', σ (algebraMap L' Ω x) = algebraMap L' Ω x :=
    fun h ↦ hσL' ((mem_fixingSubgroup_iff _ _).mpr fun x hx ↦ h ⟨x, hx⟩)
  set N := (E.baseChange Ω).negVariableChange
  set A := (E.quadraticTwistVariableChange L).baseChange Ω
  set B := (E.quadraticTwistVariableChange L').baseChange Ω
  -- `φ = B⁻¹ Cᴼ A` is an automorphism of `E_Ω`, hence `1` or `[-1]`, hence fixed by `σ`
  set φ := B⁻¹ * C.baseChange Ω * A
  have hφ : φ • E.baseChange Ω = E.baseChange Ω := by
    rw [mul_smul, mul_smul, E.quadraticTwistVariableChange_smul_baseChange L Ω,
      baseChange_smul_baseChange, hC, ← E.quadraticTwistVariableChange_smul_baseChange L' Ω,
      inv_smul_smul]
  have hσN : N.map (σ : Ω →+* Ω) = N := E.negVariableChange_baseChange_map Ω (σ : Ω →ₐ[K] Ω)
  have hσφ : φ.map (σ : Ω →+* Ω) = φ := by
    rcases E.eq_one_or_eq_negVariableChange_map (f := algebraMap K Ω)
      (FaithfulSMul.algebraMap_injective K Ω) hj₀ hj₁₇₂₈ hφ with h | h
    · rw [h, VariableChange.map_one]
    · rw [h]
      exact hσN
  -- but `σ` fixes `A`, defined over `L`, and `Cᴼ`, defined over `K`, while it sends `B` to `B N`
  have hσA : A.map (σ : Ω →+* Ω) = A := by
    simp only [A, VariableChange.baseChange, VariableChange.map_map]
    exact congrArg _ (RingHom.ext hσL₀)
  have hσC : (C.baseChange Ω).map (σ : Ω →+* Ω) = C.baseChange Ω :=
    VariableChange.map_baseChange (C := C) (σ : Ω →ₐ[K] Ω)
  have hσB : B.map (σ : Ω →+* Ω) = B * N :=
    E.map_quadraticTwistVariableChange_baseChange (L := L') Ω hσL'₀
  have hNinv : N⁻¹ = N := (E.baseChange Ω).negVariableChange_inv
  have hNφ : N * φ = φ := by
    conv_rhs => rw [← hσφ]
    rw [VariableChange.map_mul, VariableChange.map_mul, VariableChange.map_inv, hσA, hσB, hσC,
      mul_inv_rev, hNinv]
    simp only [φ, mul_assoc]
  exact (E.baseChange Ω).negVariableChange_ne_one (mul_eq_right.mp hNφ)

/-- **The twists of `E` are `E` and its quadratic twists**, when `j(E) ∉ {0, 1728}`. An elliptic
curve `E'` over `K` with `j(E') = j(E)` is isomorphic over `K` either to `E` or to the quadratic
twist of `E` by a quadratic subextension `L` of a separable closure `Ω` of `K`. By
`exists_smul_quadraticTwist_eq_quadraticTwist_iff`, distinct `L` give twists which are not
isomorphic over `K`. -/
theorem exists_smul_eq_or_exists_smul_eq_quadraticTwist_of_j_eq [IsSepClosure K Ω]
    (hj₀ : E.j ≠ 0) (hj₁₇₂₈ : E.j ≠ 1728) (E' : WeierstrassCurve K) [E'.IsElliptic]
    (hj : E'.j = E.j) :
    (∃ C : VariableChange K, C • E' = E) ∨
      ∃ (L : IntermediateField K Ω) (_ : Algebra.IsQuadraticExtension K L),
        ∃ C : VariableChange K, C • E' = E.quadraticTwist L := by
  have : IsSepClosed Ω := IsSepClosure.sep_closed K
  obtain ⟨ρ, hρ⟩ := exists_variableChange_of_j_eq (E'.baseChange Ω) (E.baseChange Ω)
    (by simp only [baseChange, map_j, hj])
  exact E.exists_smul_eq_or_exists_smul_eq_quadraticTwist_of_smul_baseChange_eq hj₀ hj₁₇₂₈ hρ

end WeierstrassCurve

end
