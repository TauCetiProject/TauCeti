/-!
# Unramified torsion and unramified division fields

Let `W` be a Weierstrass curve over a nonarchimedean local field `K`, with separable closure `Kˢ`
and inertia subgroup `I_K`. The `m`-division field `K(E[m]) ⊆ Kˢ` is generated by the coordinates
of the points of `E(Kˢ)[m]`, and the subgroup of `Gal(Kˢ/K)` fixing it is the kernel of the action
on `E(Kˢ)[m]`.
Hence `K(E[m])/K` is unramified exactly when inertia acts trivially on `E(Kˢ)[m]`: the torsion
module `E[m]` is unramified exactly when the field it cuts out is (Silverman, VII.4 and VII.7).

If inertia acts trivially on the Tate module `T_ℓ E` for a prime `ℓ` invertible in `K`, it acts
trivially on every level `E[ℓ ^ k]`, since every point of `E[ℓ ^ k]` is a component of a point of
`T_ℓ E` (`WeierstrassCurve.tateModuleGaloisRepresentation_eq_one_iff`). So each `K(E[ℓ ^ k])` is a
finite unramified extension of `K`, over which `E` has all `ℓ ^ (2k)` points of order dividing
`ℓ ^ k` (`WeierstrassCurve.natCard_torsionBy_of_divisionField_le`). This is the step of the
criterion of Néron, Ogg and Shafarevich (Silverman, VII.7.1) that turns an unramified Tate module
into rational torsion over unramified extensions of `K`.

## Main results

* `WeierstrassCurve.isUnramified_divisionField_iff`: `K(E[m])/K` is unramified exactly when inertia
  fixes every point of `E(Kˢ)[m]`.
* `WeierstrassCurve.isUnramified_divisionField_pow_of_tateModuleGaloisRepresentation_eq_one`: if
  inertia acts trivially on `T_ℓ E`, then `K(E[ℓ ^ k])/K` is unramified for every `k`.

## References

* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], VII.4 and VII.7.
-/

public section

noncomputable section

open TauCeti ValuativeRel

namespace WeierstrassCurve

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] (W : WeierstrassCurve K)

/-- **The `m`-division field is unramified exactly when inertia acts trivially on `E[m]`.** For a
structure of nonarchimedean local field on `K(E[m])` compatible with `K`, the extension
`K(E[m])/K` is unramified exactly when every element of the inertia subgroup, read in `Gal(Kˢ/K)`,
fixes every point of `E(Kˢ)[m]`. -/
theorem isUnramified_divisionField_iff (m : ℕ) [ValuativeRel (W.divisionField m)]
    [TopologicalSpace (W.divisionField m)] [IsNonarchimedeanLocalField (W.divisionField m)]
    [ValuativeExtension K (W.divisionField m)] :
    IsUnramified K (W.divisionField m) ↔
      ∀ σ ∈ (inertiaSubgroup K).map (absoluteGaloisGroupRestrictEquiv K).toMonoidHom,
        ∀ P : W.TorsionCoeff m, σ • P = P := by
  rw [← map_inertiaSubgroup_le_fixingSubgroup_iff, IsConcreteLE.le_iff]
  simp only [mem_fixingSubgroup_divisionField_iff]

open scoped Classical in
/-- **An unramified Tate module gives unramified division fields.** Let `ℓ` be a prime invertible
in `K`. If the inertia subgroup of `Gal(K^{alg}/K)` acts trivially on the `ℓ`-adic Tate module of
an elliptic curve `W`, then for every `k` the `ℓ ^ k`-division field `K(E[ℓ ^ k])` is unramified
over `K`, for every structure of nonarchimedean local field on it compatible with `K`. -/
theorem isUnramified_divisionField_pow_of_tateModuleGaloisRepresentation_eq_one [W.IsElliptic]
    {ℓ : ℕ} [Fact ℓ.Prime] (hℓ : (ℓ : K) ≠ 0)
    (h : ∀ σ ∈ inertiaSubgroup K, W.tateModuleGaloisRepresentation ℓ σ = 1) (k : ℕ)
    [ValuativeRel (W.divisionField (ℓ ^ k))] [TopologicalSpace (W.divisionField (ℓ ^ k))]
    [IsNonarchimedeanLocalField (W.divisionField (ℓ ^ k))]
    [ValuativeExtension K (W.divisionField (ℓ ^ k))] :
    IsUnramified K (W.divisionField (ℓ ^ k)) := by
  rw [isUnramified_divisionField_iff]
  rintro _ ⟨σ, hσ, rfl⟩ P
  -- `P` is the image of a point `Q` of `E(Kˢ)[ℓ ^ k]`; it suffices that the restriction of `σ`
  -- fixes `Q`.
  set Q := (AddEquiv.torsionByCongr W.pointCoeffEquiv (ℓ ^ k)).symm P
  have hQ : W.pointCoeffEquiv Q = P := by simp [Q]
  refine Subtype.ext ?_
  rw [coe_smul_torsionCoeff, ← hQ, smul_pointCoeffEquiv]
  congr 1
  -- Restriction to `Kˢ` followed by the inclusion `ι` into `K^{alg}` is `ι` followed by `σ`.
  set ι := (separableClosure K (AlgebraicClosure K)).val
  have hcomm : ι.comp ((absoluteGaloisGroupRestrictEquiv K).toMonoidHom σ).toAlgHom =
      σ.toAlgHom.comp ι :=
    AlgHom.ext fun x ↦ coe_absoluteGaloisGroupRestrictEquiv_apply K σ x
  refine Affine.Point.map_injective ι ?_
  rw [Affine.Point.map_map, hcomm, ← Affine.Point.map_map]
  -- The image of `Q` in `E(K^{alg})[ℓ ^ k]` is fixed by `σ`, which acts trivially on `T_ℓ E`.
  have hℓ' : (ℓ : AlgebraicClosure K) ≠ 0 := by
    simpa using (map_ne_zero (algebraMap K (AlgebraicClosure K))).2 hℓ
  refine (W.tateModuleGaloisRepresentation_eq_one_iff hℓ').1 (h σ hσ) k _ ?_
  rw [← map_nsmul, AddSubgroup.torsionBy.nsmul_iff.1 Q.2, map_zero]

end WeierstrassCurve
