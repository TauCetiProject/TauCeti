/-!
# Inertia acts trivially on the Tate module at good reduction

Let `K` be a nonarchimedean local field with residue field `k`, and let `W` be a Weierstrass
equation over `K` with good reduction: its coefficients lie in `𝒪[K]` and its discriminant is a
unit there. This file proves that the inertia subgroup `I_K` of `Gal(K^{alg}/K)` fixes every point
of `W(K^{alg})` whose order is prime to the characteristic of `k`, and hence acts trivially on the
Tate module `T_ℓ E` for every prime `ℓ ≠ char k`. This is the implication from good reduction to
an unramified `ℓ`-adic representation in the criterion of Néron, Ogg and Shafarevich (Silverman
AEC VII.7.1).

The finite-level statement is `WeierstrassCurve.Affine.Point.map_eq_self_of_mem_inertiaSubgroup`,
for the inertia group of a height-one prime of a Dedekind domain. A finite extension `L` of `K`
is the fraction field of the discrete valuation ring `𝒪[L]`, whose maximal ideal gives the
height-one prime, and the inertia group `G_0` of `L/K` is the inertia group of that prime. So
`G_0` fixes the torsion of `W(L)` of order prime to `char k`, and more generally every point `P`
for which it fixes `n • P` with `n` prime to `char k`
(`WeierstrassCurve.Affine.Point.map_eq_self_of_mem_lowerRamificationGroup_zero`). In particular a
finite extension of `K` generated by the `n`-division points of `K`-rational points of `W` has
trivial `G_0`, and when it is Galois over `K`, as `K([n]⁻¹ W(K))` is, it is unramified, because
`#G_0 = e(L/K)` (Silverman AEC VIII.1.5(b)). A point over `K^{alg}` is defined over
the normal closure of the field generated by its coordinates, a finite normal extension of `K`, on
which every element of `I_K` restricts into `G_0`
(`TauCeti.restrictNormal_mem_lowerRamificationGroup_zero`).

## Main results

* `WeierstrassCurve.Affine.Point.map_eq_self_of_mem_lowerRamificationGroup_zero`: for a finite
  extension `L/K` of local fields, an element of the inertia group `G_0` of `L/K` fixes every point
  `P` of `W(L)` for which it fixes `n • P`, for an integer `n` prime to the residue
  characteristic; for instance every point killed by `n`.
* `WeierstrassCurve.lowerRamificationGroup_zero_eq_bot_of_adjoin_coords_eq_top`: a finite
  extension of `K` generated by points `Q` of `W` such that `G_0` fixes `n • Q` has trivial
  inertia group `G_0`.
* `WeierstrassCurve.isUnramified_of_adjoin_coords_eq_top`: such an extension is unramified when it
  is Galois over `K`.
* `WeierstrassCurve.isUnramified_of_adjoin_coords_eq_top_of_nsmul_eq_baseChange`: in particular, a
  finite Galois extension of `K` generated by the `n`-division points of `K`-rational points of `W`
  is unramified.
* `WeierstrassCurve.Affine.Point.map_eq_self_of_mem_inertiaSubgroup_algebraicClosure`: an element
  of the inertia subgroup `I_K` fixes every point `P` of `W(K^{alg})` for which it fixes `n • P`,
  for such an `n`; for instance every point killed by `n`.
* `WeierstrassCurve.tateModuleGaloisRepresentation_eq_one_of_mem_inertiaSubgroup`: `I_K` acts
  trivially on `T_ℓ E` for every prime `ℓ` different from the residue characteristic.

## References

* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], VII.4.1, VII.7.1 and
  VIII.1.5.
-/

public section

open ValuativeRel IsLocalRing TauCeti

namespace WeierstrassCurve

section FiniteExtension

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L] [Module.Finite K L]
  [DecidableEq L] {W : WeierstrassCurve K} [IsIntegral 𝒪[K] W]
  [(integralModel 𝒪[K] W).IsElliptic]

/-- **Division points prime to `p` are unramified in a finite extension, at good reduction.** Let
`L/K` be a finite extension of nonarchimedean local fields and let `W` have good reduction over
`𝒪[K]`. An element `τ` of the inertia group `G_0` of `L/K` fixes every point `P` of `W(L)` such
that `τ` fixes `n • P`, for an integer `n` that is nonzero in the residue field of `K`; in
particular it fixes the `n`-torsion of `W(L)`. -/
theorem Affine.Point.map_eq_self_of_mem_lowerRamificationGroup_zero {n : ℕ}
    (hn : (n : 𝓀[K]) ≠ 0) {τ : Gal(L/K)}
    (hτ : τ ∈ LocalFieldsRamification.lowerRamificationGroup K L 0)
    {P : (W⁄L).toAffine.Point} (hP : Affine.Point.map τ.toAlgHom (n • P) = n • P) :
    Affine.Point.map τ.toAlgHom P = P := by
  -- The valuation ring `A` of `L` is a discrete valuation ring, and the adic valuation of its
  -- maximal ideal `u` has valuation ring `A` again.
  set A := (valuation L).valuationSubring
  -- `A` is `𝒪[L]` with its ring structure, packaged as a valuation subring.
  have : IsDiscreteValuationRing A := inferInstanceAs (IsDiscreteValuationRing 𝒪[L])
  set u := IsDiscreteValuationRing.maximalIdeal A
  set B := (u.valuation L).valuationSubring
  have hB : B = A := Place.valuationSubring_valuation_maximalIdeal A
  have hequiv : (u.valuation L).IsEquiv (valuation L) :=
    (Valuation.isEquiv_iff_valuationSubring _ _).2 hB
  -- Good reduction over `𝒪[K]` gives good reduction over `B`.
  have hKB (r : 𝒪[K]) : algebraMap K L r ∈ B := by
    rw [hB, ← TauCeti.coe_algebraMap_integerRing]
    exact (algebraMap 𝒪[K] 𝒪[L] r).2
  let : Algebra 𝒪[K] B :=
    (((algebraMap K L).comp (algebraMap 𝒪[K] K)).codRestrict B hKB).toAlgebra
  have hRS : (algebraMap B L).comp (algebraMap 𝒪[K] B) =
      (algebraMap K L).comp (algebraMap 𝒪[K] K) := rfl
  have := IsIntegral.baseChange hRS W
  have : (integralModel B (W⁄L)).IsElliptic := by
    rw [integralModel_baseChange hRS W]
    infer_instance
  -- `τ` lies in the inertia group of `B`, since `B` has the same elements as `𝒪[L]`.
  have hdec : τ ∈ B.decompositionSubgroup K := by
    rw [hB, TauCeti.decompositionSubgroup_valuationSubring_eq_top]
    exact Subgroup.mem_top τ
  have hσ : (⟨τ, hdec⟩ : B.decompositionSubgroup K) ∈ B.inertiaSubgroup K := by
    rw [← TauCeti.IsLocalRing.ramificationGroup_zero_eq_inertiaSubgroup,
      TauCeti.IsLocalRing.mem_ramificationGroup_zero_iff]
    rintro ⟨x, hx⟩
    rw [LocalFieldsRamification.lowerRamificationGroup_def,
      TauCeti.IsLocalRing.mem_ramificationGroup_zero_iff] at hτ
    have hxA : x ∈ A := hB ▸ hx
    have h := hτ ⟨x, hxA⟩
    rw [mem_maximalIdeal, mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at h
    rw [Valuation.mem_maximalIdeal_iff]
    exact hequiv.lt_one_iff_lt_one.mpr h
  -- `n` is a unit of `𝒪[K]`, hence of `A`.
  have hn' : (n : A) ∉ u.asIdeal := fun h ↦
    ((Valuation.mem_maximalIdeal_iff (v := valuation L)).mp h).ne
      (by simpa using valuation_natCast_eq_one_of_residueField_natCast_ne_zero (L := L) hn)
  exact Affine.Point.map_eq_self_of_mem_inertiaSubgroup u hn' hσ hP

/-- **A field generated by points with inertia-fixed multiples has trivial inertia at good
reduction.** Let `L/K` be a finite extension of nonarchimedean local fields generated by the
coordinates of a set `S` of points `Q` of `W(L)` such that every element of the inertia group `G_0`
of `L/K` fixes `n • Q`, for an integer `n` that is nonzero in the residue field of `K`. If `W` has
good reduction over `𝒪[K]`, then `G_0` is trivial. This group consists of automorphisms of `L/K`,
so it measures ramification only when `L/K` is Galois; see
`WeierstrassCurve.isUnramified_of_adjoin_coords_eq_top`. -/
theorem lowerRamificationGroup_zero_eq_bot_of_adjoin_coords_eq_top {n : ℕ}
    (hn : (n : 𝓀[K]) ≠ 0) {S : Set (W⁄L).toAffine.Point}
    (hS : ∀ τ ∈ LocalFieldsRamification.lowerRamificationGroup K L 0, ∀ Q ∈ S,
      Affine.Point.map τ.toAlgHom (n • Q) = n • Q)
    (hL : IntermediateField.adjoin K (Affine.Point.xCoord '' S ∪ Affine.Point.yCoord '' S) = ⊤) :
    LocalFieldsRamification.lowerRamificationGroup K L 0 = ⊥ :=
  (Subgroup.eq_bot_iff_forall _).mpr fun τ hτ ↦
    Affine.Point.algEquiv_eq_one_of_adjoin_coords_eq_top hL fun Q hQ ↦
      Affine.Point.map_eq_self_of_mem_lowerRamificationGroup_zero hn hτ (hS τ hτ Q hQ)

/-- **A Galois field generated by points with inertia-fixed multiples is unramified at good
reduction.** Let `L/K` be a finite Galois extension of nonarchimedean local fields generated by the
coordinates of a set `S` of points `Q` of `W(L)` such that every element of the inertia group `G_0`
of `L/K` fixes `n • Q`, for an integer `n` that is nonzero in the residue field of `K`. If `W` has
good reduction over `𝒪[K]`, then `L/K` is unramified. -/
theorem isUnramified_of_adjoin_coords_eq_top [IsGalois K L] {n : ℕ} (hn : (n : 𝓀[K]) ≠ 0)
    {S : Set (W⁄L).toAffine.Point}
    (hS : ∀ τ ∈ LocalFieldsRamification.lowerRamificationGroup K L 0, ∀ Q ∈ S,
      Affine.Point.map τ.toAlgHom (n • Q) = n • Q)
    (hL : IntermediateField.adjoin K (Affine.Point.xCoord '' S ∪ Affine.Point.yCoord '' S) = ⊤) :
    IsUnramified K L := by
  rw [isUnramified_iff_ramificationIndex_eq_one, ←
    LocalFieldsRamification.natCard_lowerRamificationGroup_zero,
    lowerRamificationGroup_zero_eq_bot_of_adjoin_coords_eq_top hn hS hL, Subgroup.card_bot]

/-- **A Galois field of division points is unramified at good reduction** (Silverman AEC
VIII.1.5(b), over a local field). Let `L/K` be a finite Galois extension of nonarchimedean local
fields generated by the coordinates of a set `S` of points `Q` of `W(L)` with `n • Q` in the image
of `W(K)`, for an integer `n` that is nonzero in the residue field of `K`, as `L = K([n]⁻¹ W(K))`
is. If `W` has good reduction over `𝒪[K]`, then `L/K` is unramified. -/
theorem isUnramified_of_adjoin_coords_eq_top_of_nsmul_eq_baseChange [DecidableEq K] [IsGalois K L]
    {n : ℕ} (hn : (n : 𝓀[K]) ≠ 0) {S : Set (W⁄L).toAffine.Point}
    (hS : ∀ Q ∈ S, ∃ P : W.toAffine.Point,
      n • Q = Affine.Point.baseChange (W' := W.toAffine) K L P)
    (hL : IntermediateField.adjoin K (Affine.Point.xCoord '' S ∪ Affine.Point.yCoord '' S) = ⊤) :
    IsUnramified K L := by
  refine isUnramified_of_adjoin_coords_eq_top hn (fun τ _ Q hQ ↦ ?_) hL
  obtain ⟨P, hP⟩ := hS Q hQ
  rw [hP]
  exact Affine.Point.map_baseChange (W' := W.toAffine) _ P

end FiniteExtension

section AlgebraicClosure

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [DecidableEq (AlgebraicClosure K)] (W : WeierstrassCurve K)
  [IsIntegral 𝒪[K] W] [(integralModel 𝒪[K] W).IsElliptic]

variable {W} in
/-- **Division points prime to `p` are unramified at good reduction** (Silverman AEC VII.4.1 and
VIII.1.5(b)). If `W` has good reduction over `𝒪[K]`, every element `σ` of the inertia subgroup of
`Gal(K^{alg}/K)` fixes every point `P` of `W(K^{alg})` such that `σ` fixes `n • P`, for an integer
`n` that is nonzero in the residue field of `K`. In particular `σ` fixes the `n`-torsion of
`W(K^{alg})` and the `n`-division points of the `K`-rational points of `W`. -/
theorem Affine.Point.map_eq_self_of_mem_inertiaSubgroup_algebraicClosure {n : ℕ}
    (hn : (n : 𝓀[K]) ≠ 0) {σ : Gal(AlgebraicClosure K/K)} (hσ : σ ∈ inertiaSubgroup K)
    {P : (W⁄(AlgebraicClosure K)).toAffine.Point}
    (hP : Affine.Point.map σ.toAlgHom (n • P) = n • P) :
    Affine.Point.map σ.toAlgHom P = P := by
  classical
  -- `P` is defined over a finite normal subextension `M` of `K^{alg}/K`.
  obtain ⟨M, _, _, hM⟩ := Affine.Point.exists_finiteDimensional_normal_map_val_eq P
  obtain ⟨Q, rfl⟩ := hM
  let := finiteIntermediateFieldValuativeRel K (AlgebraicClosure K) M
  let := finiteIntermediateFieldTopology K (AlgebraicClosure K) M
  have := finiteIntermediateField_isNonarchimedeanLocalField K (AlgebraicClosure K) M
  have := finiteIntermediateField_valuativeExtension K (AlgebraicClosure K) M
  -- On `M`, `σ` acts through its restriction, which lies in the inertia group of `M/K`.
  rw [← map_nsmul, Affine.Point.map_map_val_eq_map_val_map_restrictNormal] at hP
  rw [Affine.Point.map_map_val_eq_map_val_map_restrictNormal,
    Affine.Point.map_eq_self_of_mem_lowerRamificationGroup_zero hn
      (restrictNormal_mem_lowerRamificationGroup_zero M hσ) (Affine.Point.map_injective M.val hP)]

/-- **The Tate module is unramified at good reduction** (Silverman AEC VII.4.1, and the forward
implication of VII.7.1). If `W` has good reduction over `𝒪[K]` and `ℓ` is a prime different from
the residue characteristic of `K`, the inertia subgroup of `Gal(K^{alg}/K)` acts trivially on the
`ℓ`-adic Tate module of `W`. -/
theorem tateModuleGaloisRepresentation_eq_one_of_mem_inertiaSubgroup {ℓ : ℕ} [Fact ℓ.Prime]
    (hℓ : (ℓ : 𝓀[K]) ≠ 0) {σ : Gal(AlgebraicClosure K/K)} (hσ : σ ∈ inertiaSubgroup K) :
    W.tateModuleGaloisRepresentation ℓ σ = 1 := by
  refine LinearMap.ext fun x ↦ TateModule.ext fun n ↦ Subtype.ext ?_
  rw [coe_proj_tateModuleGaloisRepresentation, Module.End.one_apply]
  refine Affine.Point.map_eq_self_of_mem_inertiaSubgroup_algebraicClosure (n := ℓ ^ n) ?_ hσ ?_
  · rw [Nat.cast_pow]
    exact pow_ne_zero n hℓ
  · rw [AddSubgroup.torsionBy.nsmul_iff.mp (TateModule.proj n x).2, map_zero]

end AlgebraicClosure

end WeierstrassCurve

