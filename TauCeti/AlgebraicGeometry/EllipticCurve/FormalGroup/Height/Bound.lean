module

public import TauCeti.AlgebraicGeometry.EllipticCurve.FormalGroup.Basic
public import TauCeti.RingTheory.FormalGroup.Height.Ideal
-- Proof-only: field-level order bound and vanishing of `[p]_Ê` at a cusp.
import TauCeti.AlgebraicGeometry.EllipticCurve.FormalGroup.Height.Classification
-- Proof-only: `Ideal.Quotient.isUnit_mk_iff` for the quotient-unit reformulation.
import TauCeti.RingTheory.Ideal.Quotient.Coprime

/-!
# The height-two bound for Weierstrass formal groups

For a Weierstrass curve `W` over any commutative ring `R`, any `p > 1`, and any `n ≥ 3`, the height
ideal `I_n(Ê)` is the unit ideal exactly when `Ideal.span {(p : R), W.c₄, W.Δ} = ⊤`, that is, when
`W` has no cuspidal geometric fibers in residue characteristics dividing `p`. Equivalently, for
every `p ≠ 0`, the coefficient of `T ^ (p ^ 2)` in `[p]_Ê(T)` (Landweber's `v₂` when `p` is prime)
is a unit modulo `I₂(Ê)` if and only if `(p, c₄, Δ) = R`.

In particular, for every Weierstrass family without cuspidal fibers (`Ideal.span {W.c₄, W.Δ} = ⊤`,
covering smooth elliptic curves and nodal cubics alike), and hence for every elliptic curve
(`W.IsElliptic`), `I_n(Ê) = ⊤` for all `p > 1`, `n ≥ 3` and the `T ^ (p ^ 2)` coefficient of
`[p]_Ê` is a unit modulo `I₂(Ê)` for all `p ≠ 0` (in particular, Landweber's `v₂` is a unit modulo
`(p, v₁)` at every prime `p`). The statements hold for arbitrary commutative rings, including rings
with nilpotents and the zero ring, with no characteristic or regularity assumption on the
coefficient ring.

The proof tests properness of the ideal generated by the coefficients of `[p]_Ê` below degree
`N > p²` on maximal-ideal quotients `R ⧸ m`, using the field-level order bound
`WeierstrassCurve.order_nsmulSeries_formalGroup_le_sq` (for smooth and nodal fibers) and
`WeierstrassCurve.nsmulSeries_formalGroup_eq_zero_of_Δ_eq_zero_of_c₄_eq_zero` (for cuspidal
fibers).

## Main results

* `WeierstrassCurve.heightIdeal_formalGroup_eq_top_iff`: for `1 < p` and `n ≥ 3`,
  `(formalGroup W).heightIdeal p n = ⊤ ↔ Ideal.span {(p : R), W.c₄, W.Δ} = ⊤`.
* `WeierstrassCurve.heightIdeal_formalGroup_eq_top_of_span_c₄_Δ`: if `Ideal.span {W.c₄, W.Δ} = ⊤`,
  then `(formalGroup W).heightIdeal p n = ⊤` for every `1 < p` and `n ≥ 3`.
* `WeierstrassCurve.heightIdeal_formalGroup_eq_top`: for an elliptic curve `[W.IsElliptic]`,
  `(formalGroup W).heightIdeal p n = ⊤` for every `1 < p` and `n ≥ 3`.
* `WeierstrassCurve.isUnit_mk_coeff_nsmulSeries_formalGroup_iff`,
  `WeierstrassCurve.isUnit_mk_coeff_nsmulSeries_formalGroup_of_span_c₄_Δ`, and
  `WeierstrassCurve.isUnit_mk_coeff_nsmulSeries_formalGroup`: the equivalent height-two unit
  condition for the `T ^ (p ^ 2)` coefficient of `[p]_Ê` modulo `I₂(Ê)` (Landweber's `v₂` modulo
  `(p, v₁)` at every prime `p`), valid for every `p ≠ 0`.

## References

* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], IV.7 and V.3.
* P. S. Landweber, *Homological properties of comodules over `MU_*(MU)` and `BP_*(BP)`*,
  Amer. J. Math. 98 (1976), 591–610.
-/

public section

namespace WeierstrassCurve

variable {R : Type*} [CommRing R] (W : WeierstrassCurve R) {p n : ℕ}

/-- Characterizing `heightIdeal` as the span of coefficients below `pⁿ` via its public universal
property. -/
private theorem heightIdeal_eq_span_Iio (F : FormalGroup R) (p n : ℕ) :
    F.heightIdeal p n =
      Ideal.span ((fun k ↦ PowerSeries.coeff k (F.nsmulSeries p)) '' Set.Iio (p ^ n)) :=
  le_antisymm
    (FormalGroup.heightIdeal_le_iff.mpr fun k hk ↦ Ideal.subset_span ⟨k, hk, rfl⟩)
    (Ideal.span_le.mpr fun _ ⟨_, hk, h⟩ ↦ h ▸ FormalGroup.coeff_nsmulSeries_mem_heightIdeal hk)

/-- The coefficients of `[p]_Ê` in degrees below `N` (with `p ≠ 0` and `p² < N`) generate the unit
ideal exactly when `p`, `c₄`, and `Δ` do. -/
private theorem span_coeff_nsmulSeries_eq_top_iff {N : ℕ} (hp : p ≠ 0) (hN : p ^ 2 < N) :
    Ideal.span ((fun k ↦ PowerSeries.coeff k ((formalGroup W).nsmulSeries p)) '' Set.Iio N) = ⊤ ↔
      Ideal.span {(p : R), W.c₄, W.Δ} = ⊤ := by
  constructor
  · intro htop
    by_contra hJ
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal (Ideal.span {(p : R), W.c₄, W.Δ}) hJ
    let _ : m.IsMaximal := hm
    let _ := Ideal.Quotient.field m
    let π := Ideal.Quotient.mk m
    have hmem {x : R} (hx : x ∈ ({(p : R), W.c₄, W.Δ} : Set R)) : π x = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (hle (Ideal.subset_span hx))
    have hzero := (W.map π).nsmulSeries_formalGroup_eq_zero_of_Δ_eq_zero_of_c₄_eq_zero (m := p)
      (by rw [map_Δ]; exact hmem (by simp)) (by rw [map_c₄]; exact hmem (by simp))
      (by rw [← map_natCast π]; exact hmem (by simp))
    refine hm.ne_top (top_unique (htop ▸ Ideal.span_le.mpr ?_))
    rintro _ ⟨k, -, rfl⟩
    rw [SetLike.mem_coe, ← Ideal.Quotient.eq_zero_iff_mem]
    change π (PowerSeries.coeff k ((formalGroup W).nsmulSeries p)) = 0
    rw [← FormalGroup.coeff_nsmulSeries_map, ← map_formalGroup, hzero, map_zero]
  · intro htop
    by_contra hI
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hI
    let _ : m.IsMaximal := hm
    let _ := Ideal.Quotient.field m
    let π := Ideal.Quotient.mk m
    have hcoeff (k : ℕ) (hk : k < N) :
        PowerSeries.coeff k ((formalGroup (W.map π)).nsmulSeries p) = 0 := by
      rw [map_formalGroup, FormalGroup.coeff_nsmulSeries_map, Ideal.Quotient.eq_zero_iff_mem]
      exact hle (Ideal.subset_span ⟨k, hk, rfl⟩)
    have h1 : 1 < N := lt_of_le_of_lt (Nat.one_le_pow 2 p (Nat.pos_of_ne_zero hp)) hN
    have hord : ((N : ℕ) : ℕ∞) ≤ ((formalGroup (W.map π)).nsmulSeries p).order :=
      PowerSeries.nat_le_order _ N hcoeff
    have hzero : (W.map π).c₄ = 0 ∧ (W.map π).Δ = 0 := by
      by_contra hne
      rw [not_and_or] at hne
      exact not_lt_of_ge (hord.trans ((W.map π).order_nsmulSeries_formalGroup_le_sq hp hne))
        (by exact_mod_cast hN)
    refine hm.ne_top (top_unique (htop ▸ Ideal.span_le.mpr ?_))
    rintro _ (rfl | rfl | rfl) <;> rw [SetLike.mem_coe, ← Ideal.Quotient.eq_zero_iff_mem]
    · simpa [FormalGroup.coeff_one_nsmulSeries] using hcoeff 1 h1
    · simpa [map_c₄] using hzero.1
    · simpa [map_Δ] using hzero.2

/-- **The height-two bound criterion**: for `1 < p` and `n ≥ 3`, the `n`-th height ideal of the
formal group of a Weierstrass curve `W` over a commutative ring `R` is the unit ideal exactly when
`p`, `c₄`, and `Δ` generate the unit ideal (no cuspidal fibers in residue characteristics dividing
`p`). -/
theorem heightIdeal_formalGroup_eq_top_iff (hp : 1 < p) (hn : 3 ≤ n) :
    (formalGroup W).heightIdeal p n = ⊤ ↔ Ideal.span {(p : R), W.c₄, W.Δ} = ⊤ := by
  rw [heightIdeal_eq_span_Iio]
  exact W.span_coeff_nsmulSeries_eq_top_iff (by omega)
    (Nat.pow_lt_pow_right hp (by omega : 2 < n))

/-- For a Weierstrass curve without cuspidal fibers (`Ideal.span {W.c₄, W.Δ} = ⊤`), every height
ideal from `I₃` onward is the unit ideal for every `1 < p`. -/
theorem heightIdeal_formalGroup_eq_top_of_span_c₄_Δ (hp : 1 < p) (hn : 3 ≤ n)
    (h : Ideal.span {W.c₄, W.Δ} = ⊤) : (formalGroup W).heightIdeal p n = ⊤ :=
  (W.heightIdeal_formalGroup_eq_top_iff hp hn).mpr
    (top_unique (h ▸ Ideal.span_mono (Set.subset_insert _ _)))

/-- **The height-two bound for elliptic curves**: for every elliptic Weierstrass curve over any
commutative ring, every height ideal from `I₃` onward is the unit ideal for every `1 < p`. -/
theorem heightIdeal_formalGroup_eq_top [W.IsElliptic] (hp : 1 < p) (hn : 3 ≤ n) :
    (formalGroup W).heightIdeal p n = ⊤ :=
  W.heightIdeal_formalGroup_eq_top_of_span_c₄_Δ hp hn
    (Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (by simp)) W.isUnit_Δ)

/-- **The height-two unit condition**: for any `p ≠ 0`, the `T ^ (p ^ 2)` coefficient of `[p]_Ê`
(Landweber's `v₂` when `p` is prime) is a unit modulo `I₂(Ê)` exactly when `p`, `c₄`, and `Δ`
generate the unit ideal. -/
theorem isUnit_mk_coeff_nsmulSeries_formalGroup_iff (hp : p ≠ 0) :
    IsUnit (Ideal.Quotient.mk ((formalGroup W).heightIdeal p 2)
      (PowerSeries.coeff (p ^ 2) ((formalGroup W).nsmulSeries p))) ↔
      Ideal.span {(p : R), W.c₄, W.Δ} = ⊤ := by
  have h := W.span_coeff_nsmulSeries_eq_top_iff hp (Nat.lt_succ_self (p ^ 2))
  have hU : Set.Iio (p ^ 2 + 1) = insert (p ^ 2) (Set.Iio (p ^ 2)) := by
    ext k
    simp [le_iff_eq_or_lt]
  rw [hU, Set.image_insert_eq] at h
  simpa [Ideal.Quotient.isUnit_mk_iff, heightIdeal_eq_span_Iio, ← Ideal.span_union,
    Set.singleton_union] using h

/-- For a Weierstrass curve without cuspidal fibers (`Ideal.span {W.c₄, W.Δ} = ⊤`), the
`T ^ (p ^ 2)` coefficient of `[p]_Ê` (Landweber's `v₂` at a prime `p`) is a unit modulo `I₂(Ê)`
for every `p ≠ 0`. -/
theorem isUnit_mk_coeff_nsmulSeries_formalGroup_of_span_c₄_Δ (hp : p ≠ 0)
    (h : Ideal.span {W.c₄, W.Δ} = ⊤) :
    IsUnit (Ideal.Quotient.mk ((formalGroup W).heightIdeal p 2)
      (PowerSeries.coeff (p ^ 2) ((formalGroup W).nsmulSeries p))) :=
  (W.isUnit_mk_coeff_nsmulSeries_formalGroup_iff hp).mpr
    (top_unique (h ▸ Ideal.span_mono (Set.subset_insert _ _)))

/-- **Landweber's height-two unit condition for elliptic curves**: for every `p ≠ 0` (in
particular, every prime `p`), the `T ^ (p ^ 2)` coefficient of `[p]_Ê` on an elliptic Weierstrass
curve over any commutative ring is a unit modulo `I₂(Ê)`. This requires no regularity assumption on
the coefficient ring. -/
theorem isUnit_mk_coeff_nsmulSeries_formalGroup [W.IsElliptic] (hp : p ≠ 0) :
    IsUnit (Ideal.Quotient.mk ((formalGroup W).heightIdeal p 2)
      (PowerSeries.coeff (p ^ 2) ((formalGroup W).nsmulSeries p))) :=
  W.isUnit_mk_coeff_nsmulSeries_formalGroup_of_span_c₄_Δ hp
    (Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (by simp)) W.isUnit_Δ)

end WeierstrassCurve
