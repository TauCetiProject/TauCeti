module

public import TauCeti.AlgebraicGeometry.EllipticCurve.Affine.Point.NonsingularReduction
-- Proof-only: the points with singular reduction when the reduction is singular at the origin.
import TauCeti.AlgebraicGeometry.EllipticCurve.Affine.Point.SingularReduction
-- Proof-only: Hensel's lemma for a polynomial that is not monic.
import TauCeti.RingTheory.Henselian.Basic

/-!
# Points with singular reduction at a split node

Let `v` be a valuation on a field `F`, with valuation ring `O` and maximal ideal `𝔪`, and let `W` be
an elliptic curve over `F` with an integral model whose reduction is a split node at the origin.
Centred at the node, as a translation over a Henselian `O` always allows, the model has
`a₃ = a₄ = 0`, `a₆ ∈ 𝔪`, `b₂` a unit, and tangent quadratic `T² + a₁ T - a₂ = (T - α) (T - β)`
with `α, β ∈ O` and `β - α` a unit. In the branch coordinates `u = y - α x` and `w = y - β x` the
equation reads `u w = x³ + a₆`, and the points with singular reduction are the affine points with
`u, w ∈ 𝔪`. This file computes the index of the subgroup `E₀(F)` of points with nonsingular
reduction (`WeierstrassCurve.Affine.nonsingularReduction`) when `O` is Henselian:

`[E(F) : E₀(F)] = #{γ ∈ v(F) | v a₆ < γ ≤ 1}`.

When `𝔪 = (ϖ)` and `v a₆ = v ϖ ^ n`, which is `v Δ = v ϖ ^ n`, the index is `n`: this is the local
index `c_v = n` that Tate's algorithm reports at split multiplicative reduction of type `Iₙ`
(Silverman, *Advanced Topics*, IV.9, Table 4.1), and the order `v Δ` of `E(K) / E₀(K)` in
Silverman VII.6.1, which also shows that this group is cyclic; only its order is computed here.
Neither completeness nor discreteness of `v` is needed for the first formula.

The cosets of `E₀(F)` are read off a single value of `v` attached to each point `P = (x, y)` outside
`E₀(F)`: `v u` when `v w ≤ v u`, and `v a₆ / v w` when `v u < v w`. Both lie in `(v a₆, 1)`. Three
facts make this value a bijection from the nontrivial cosets onto the values of `v` in that
interval.
Each is a valuation estimate along the line `y = ℓ x + ν` through two points, which meets the curve
again at the third point of the chord, with `A = ℓ - α` and `B = ℓ - β`: the branch coordinates of
the three points are `uᵢ = A xᵢ + ν` and `wᵢ = B xᵢ + ν`, and `x₁ + x₂ + x₃ = A B`,
`x₁ x₂ + x₁ x₃ + x₂ x₃ = -(A + B) ν`.

* The value is constant on cosets: if `P` has `v w₁ ≤ v u₁` and `Q` has nonsingular reduction, then
  `A` and `B` share a valuation `σ ≥ 1` with `v u₂ = v w₂ = σ³`, and in
  `w₂ w₃ = w₁² - 3 B x₁ w₁ + 3 B² x₁² - B³ u₁` the last term dominates, so `v w₃ = v u₁`.
* The value separates cosets: if `v w₁ ≤ v u₁ = v w₂` and `v u₂ ≤ v w₂`, then in
  `u₃ = A² B + 3 ν - u₁ - u₂` the first term dominates and `u₃ ∉ 𝔪`, so `P + Q ∈ E₀(F)`.
* Every value occurs: for `v a₆ ≤ (v z)² < 1` the equation `u w = x³ + a₆` with `u = z` and
  `w = z t` becomes `t = z (1 - t)³ / (β - α)³ + a₆ / z²`, which Hensel's lemma solves.

## Main results

* `WeierstrassCurve.Affine.index_nonsingularReduction_eq_natCard_of_tangentQuadratic_root`: over a
  Henselian valuation ring, `[E(F) : E₀(F)]` is the number of values of `v` in `(v a₆, 1]`.
* `WeierstrassCurve.Affine.index_nonsingularReduction_eq_of_tangentQuadratic_root`: if moreover the
  maximal ideal is generated by `ϖ` and `v a₆ = v ϖ ^ n` with `n > 0`, then `[E(F) : E₀(F)] = n`.

## References

* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], VII.2 and VII.6.
* J. H. Silverman, *Advanced Topics in the Arithmetic of Elliptic Curves*, GTM 151, IV.9.
* J. Tate, *Algorithm for determining the type of a singular fibre in an elliptic pencil*, in
  *Modular Functions of One Variable IV*, LNM 476 (1975), 33–52.
-/

public section

open IsLocalRing Polynomial

namespace WeierstrassCurve.Affine

/-! ### Lines meeting the cubic `(y - α x) (y - β x) = x³ + a₆` -/

section Line

variable {R : Type*} [CommRing R] {A B ν x₁ x₂ x₃ : R}

/-- On a line `y = ℓ x + ν` meeting the cubic in `x₁`, `x₂`, `x₃`, with `A = ℓ - α` and
`B = ℓ - β`, the branch coordinates `u = A x + ν` and `w = B x + ν` satisfy
`A w₁ + B u₂ = x₁² + x₁ x₂ + x₂²`. -/
private theorem line_mul_add_mul (he₁ : x₁ + x₂ + x₃ = A * B)
    (he₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = -(A + B) * ν) :
    A * (B * x₁ + ν) + B * (A * x₂ + ν) = x₁ ^ 2 + x₁ * x₂ + x₂ ^ 2 := by
  linear_combination -(x₁ + x₂) * he₁ + he₂

/-- The product of the `w`-coordinates of the second and third points of the line. -/
private theorem line_mul_mul (he₁ : x₁ + x₂ + x₃ = A * B)
    (he₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = -(A + B) * ν) :
    (B * x₂ + ν) * (B * x₃ + ν) = (B * x₁ + ν) ^ 2 - 3 * B * x₁ * (B * x₁ + ν) +
      3 * B ^ 2 * x₁ * x₁ - B ^ 3 * (A * x₁ + ν) := by
  linear_combination B ^ 2 * he₂ + (B * ν - B ^ 2 * x₁) * he₁

end Line

/-! ### Valuations along such a line -/

section Valuation

variable {F Γ₀ : Type*} [Field F] [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation F Γ₀)

/-- `x` is a unit multiple of `u - w`, so it is no larger than the larger of the two. -/
private theorem valuation_le_of_mul_eq {A B x u w : F} (hAB : v (A - B) = 1)
    (h : (A - B) * x = u - w) {g : Γ₀} (hu : v u ≤ g) (hw : v w ≤ g) : v x ≤ g := by
  have := congrArg v h
  rw [map_mul, hAB, one_mul] at this
  rw [this]
  exact v.map_sub_le hu hw

/-- **The sum of two points on opposite branches with matching valuations has nonsingular
reduction.** Let a line `y = ℓ x + ν` meet the cubic in `x₁`, `x₂`, `x₃`, put `A = ℓ - α`,
`B = ℓ - β` with `A - B` a unit, and write `uᵢ = A xᵢ + ν`, `wᵢ = B xᵢ + ν`. If `0 < v u₁ < 1`,
`v w₁ ≤ v u₁ = v w₂` and `v u₂ ≤ v w₂`, then `u₃` is not in the maximal ideal. -/
private theorem one_le_valuation_of_valuation_eq {A B ν x₁ x₂ x₃ : F} (hAB : v (A - B) = 1)
    (he₁ : x₁ + x₂ + x₃ = A * B) (he₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = -(A + B) * ν)
    (hu₁ : v (A * x₁ + ν) < 1) (hu₁0 : A * x₁ + ν ≠ 0)
    (hw₁ : v (B * x₁ + ν) ≤ v (A * x₁ + ν)) (hw₂ : v (B * x₂ + ν) = v (A * x₁ + ν))
    (hu₂ : v (A * x₂ + ν) ≤ v (B * x₂ + ν)) : 1 ≤ v (A * x₃ + ν) := by
  set κ := v (A * x₁ + ν)
  have hκ0 : κ ≠ 0 := (map_ne_zero v).2 hu₁0
  have hx₁ : v x₁ ≤ κ := valuation_le_of_mul_eq v hAB (by ring) le_rfl hw₁
  have hx₂ : v x₂ ≤ κ := valuation_le_of_mul_eq v hAB (by ring) (hu₂.trans hw₂.le) hw₂.le
  -- the quadratic `X = x₂² + x₂ x₁ + x₁²` is smaller than `κ`
  set X := x₂ ^ 2 + x₂ * x₁ + x₁ ^ 2
  have hκκ : κ * κ < κ := by simpa using mul_lt_mul_of_pos_left hu₁ hκ0.pos
  have hXκ : v X < κ := by
    refine lt_of_le_of_lt (v.map_add_le (v.map_add_le ?_ ?_) ?_) hκκ
    · rw [map_pow, sq]; exact mul_le_mul' hx₂ hx₂
    · rw [map_mul]; exact mul_le_mul' hx₂ hx₁
    · rw [map_pow, sq]; exact mul_le_mul' hx₁ hx₁
  -- `A w₂ + B u₁ = X`, so `A (w₂ + u₁)` and `B (w₂ + u₁)` both have valuation `κ`
  have hV : A * (B * x₂ + ν) + B * (A * x₁ + ν) = X :=
    line_mul_add_mul (x₃ := x₃) (by linear_combination he₁) (by linear_combination he₂)
  set D := B * x₂ + ν + (A * x₁ + ν)
  have hvAD : v (A * D) = κ := by
    have hAD : A * D = (A - B) * (A * x₁ + ν) + X := by linear_combination hV
    rw [hAD, v.map_add_eq_of_lt_left] <;> rw [map_mul, hAB, one_mul]
    exact hXκ
  have hvBD : v (B * D) = κ := by
    have hBD : B * D = -((A - B) * (B * x₂ + ν)) + X := by linear_combination hV
    rw [hBD, v.map_add_eq_of_lt_left] <;> rw [v.map_neg, map_mul, hAB, one_mul, hw₂]
    exact hXκ
  have hD0 : v D ≠ 0 := fun h ↦ hκ0 (by rw [← hvAD, map_mul, h, mul_zero])
  have hDκ : v D ≤ κ := v.map_add_le hw₂.le le_rfl
  have hAB' : v B = v A := (mul_left_inj' hD0).1 (by rw [← map_mul, ← map_mul, hvAD, hvBD])
  obtain ⟨σ, hσ⟩ : ∃ σ, v A = σ := ⟨_, rfl⟩
  rw [hσ] at hAB'
  have hσ1 : 1 ≤ σ := by
    by_contra h
    have h' : σ * v D < 1 * v D := mul_lt_mul_of_pos_right (not_le.1 h) hD0.pos
    rw [one_mul, ← hσ, ← map_mul, hvAD] at h'
    exact not_le.2 h' hDκ
  -- `(A - B) ν = A w₁ - B u₁`, so `v ν ≤ σ κ`
  have hν : v ν ≤ σ * κ :=
    valuation_le_of_mul_eq v hAB (u := A * (B * x₁ + ν)) (w := B * (A * x₁ + ν)) (by ring)
      (by rw [map_mul, hσ]; exact mul_le_mul' le_rfl hw₁) (by rw [map_mul, hAB'])
  -- `u₃ = A² B + (3 ν - u₁ - u₂)`, where the first term dominates
  have hu₃ : A * x₃ + ν = A ^ 2 * B + (ν + ν + ν - (A * x₁ + ν) - (A * x₂ + ν)) := by
    linear_combination A * he₁
  have hσ3 : v (A ^ 2 * B) = σ ^ 3 := by rw [map_mul, map_pow, hσ, hAB', ← pow_succ]
  have hσκ : σ * κ < σ ^ 3 := by
    have h := mul_lt_mul_of_pos_left (lt_of_lt_of_le hu₁ (one_le_pow₀ (n := 2) hσ1))
      (lt_of_lt_of_le one_pos hσ1)
    rwa [← pow_succ'] at h
  have hκσ : κ ≤ σ * κ := le_mul_of_one_le_left zero_le hσ1
  have hrest : v (ν + ν + ν - (A * x₁ + ν) - (A * x₂ + ν)) < σ ^ 3 := by
    refine lt_of_le_of_lt (v.map_sub_le (v.map_sub_le ?_ hκσ) ?_) hσκ
    · exact v.map_add_le (v.map_add_le hν hν) hν
    · exact (hu₂.trans hw₂.le).trans hκσ
  rw [hu₃, v.map_add_eq_of_lt_left (by rwa [hσ3]), hσ3]
  exact one_le_pow₀ hσ1

/-- The products `A (w₁ + u₂)` and `B (w₁ + u₂)`, from `A w₁ + B u₂ = x₁² + x₁ x₂ + x₂²`. -/
private theorem mul_add_eq {A B ν x₁ x₂ x₃ : F} (he₁ : x₁ + x₂ + x₃ = A * B)
    (he₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = -(A + B) * ν) :
    A * (B * x₁ + ν + (A * x₂ + ν)) = x₂ ^ 2 + (x₁ ^ 2 + x₁ * x₂ + (A - B) * (A * x₂ + ν)) ∧
      B * (B * x₁ + ν + (A * x₂ + ν)) = x₂ ^ 2 + (x₁ ^ 2 + x₁ * x₂ - (A - B) * (B * x₁ + ν)) := by
  have hV := line_mul_add_mul (A := A) (B := B) (ν := ν) he₁ he₂
  exact ⟨by linear_combination hV, by linear_combination hV⟩

/-- **The slope at an integral point with nonsingular reduction.** In the setting of
`one_le_valuation_of_valuation_eq`, if `v w₁ ≤ v u₁ < 1` and the second point is integral with
`u₂` a unit, then `A` and `B` are units. -/
private theorem valuation_eq_one_of_le_one {a₆ A B ν x₁ x₂ x₃ : F}
    (hAB : v (A - B) = 1) (ha₆ : v a₆ < 1)
    (he₁ : x₁ + x₂ + x₃ = A * B) (he₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = -(A + B) * ν)
    (hc₂ : (A * x₂ + ν) * (B * x₂ + ν) = x₂ ^ 3 + a₆)
    (hu₁ : v (A * x₁ + ν) < 1) (hw₁ : v (B * x₁ + ν) ≤ v (A * x₁ + ν))
    (hx₂ : v x₂ ≤ 1) (hu₂ : v (A * x₂ + ν) = 1) : v A = 1 ∧ v B = 1 := by
  have hx₁ : v x₁ < 1 := (valuation_le_of_mul_eq v hAB (by ring) le_rfl hw₁).trans_lt hu₁
  have hAB1 {z : F} : v ((A - B) * z) = v z := by rw [map_mul, hAB, one_mul]
  obtain ⟨hAD, hBD⟩ := mul_add_eq he₁ he₂
  -- `x₂ (x₂² + (A - B) u₂) = u₂² - a₆` is a unit, so `x₂` and `x₂² + (A - B) u₂` are units
  have hY : x₂ * (x₂ ^ 2 + (A - B) * (A * x₂ + ν)) = (A * x₂ + ν) ^ 2 - a₆ := by
    linear_combination -hc₂
  have hY1 : v ((A * x₂ + ν) ^ 2 - a₆) = 1 := by
    rw [v.map_sub_eq_of_lt_left] <;> rw [map_pow, hu₂, one_pow]
    exact ha₆
  have hZ : v (x₂ ^ 2 + (A - B) * (A * x₂ + ν)) ≤ 1 :=
    v.map_add_le (by rw [map_pow]; exact pow_le_one₀ zero_le hx₂) (by rw [hAB1, hu₂])
  have hmul : v x₂ * v (x₂ ^ 2 + (A - B) * (A * x₂ + ν)) = 1 := by rw [← map_mul, hY, hY1]
  have hx₂1 : v x₂ = 1 := le_antisymm hx₂ (hmul.symm.le.trans (mul_le_of_le_one_right' hZ))
  have hZ1 : v (x₂ ^ 2 + (A - B) * (A * x₂ + ν)) = 1 :=
    le_antisymm hZ (hmul.symm.le.trans (mul_le_of_le_one_left' hx₂))
  -- `w₁ + u₂` is a unit, and so are `A (w₁ + u₂)` and `B (w₁ + u₂)`
  have hD : v (B * x₁ + ν + (A * x₂ + ν)) = 1 := by
    rw [v.map_add_eq_of_lt_right (by rw [hu₂]; exact hw₁.trans_lt hu₁), hu₂]
  have hsmall : v (x₁ ^ 2 + x₁ * x₂) < 1 := by
    refine v.map_add_lt ?_ ?_
    · rw [map_pow]; exact pow_lt_one₀ zero_le hx₁ two_ne_zero
    · rw [map_mul, hx₂1, mul_one]; exact hx₁
  constructor
  · have h : A * (B * x₁ + ν + (A * x₂ + ν)) =
        (x₂ ^ 2 + (A - B) * (A * x₂ + ν)) + (x₁ ^ 2 + x₁ * x₂) := by
      linear_combination hAD
    have := congrArg v h
    rwa [map_mul, hD, mul_one, v.map_add_eq_of_lt_left (by rwa [hZ1]), hZ1] at this
  · have h : B * (B * x₁ + ν + (A * x₂ + ν)) =
        x₂ ^ 2 + (x₁ ^ 2 + x₁ * x₂ - (A - B) * (B * x₁ + ν)) := hBD
    have hlt : v (x₁ ^ 2 + x₁ * x₂ - (A - B) * (B * x₁ + ν)) < v (x₂ ^ 2) := by
      rw [map_pow, hx₂1, one_pow]
      exact v.map_sub_lt hsmall (by rw [hAB1]; exact hw₁.trans_lt hu₁)
    have := congrArg v h
    rwa [map_mul, hD, mul_one, v.map_add_eq_of_lt_left hlt, map_pow, hx₂1, one_pow] at this

/-- **The slope at a point of the kernel of reduction.** In the setting of
`one_le_valuation_of_valuation_eq`, if `v w₁ ≤ v u₁ < 1` and the second point has `1 < v x₂` and
`(v u₂)² = (v x₂)³`, then `A` and `B` have a common valuation `σ > 1` with `σ³ = v u₂`. -/
private theorem valuation_eq_of_one_lt {A B ν x₁ x₂ x₃ : F} (hAB : v (A - B) = 1)
    (he₁ : x₁ + x₂ + x₃ = A * B) (he₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = -(A + B) * ν)
    (hu₁ : v (A * x₁ + ν) < 1) (hw₁ : v (B * x₁ + ν) ≤ v (A * x₁ + ν))
    (hx₂ : 1 < v x₂) (hs : v (A * x₂ + ν) ^ 2 = v x₂ ^ 3) :
    v B = v A ∧ 1 ≤ v A ∧ v A ^ 3 = v (A * x₂ + ν) := by
  have hx₁ : v x₁ ≤ 1 := (valuation_le_of_mul_eq v hAB (by ring) le_rfl hw₁).trans hu₁.le
  have hw₁1 : v (B * x₁ + ν) < 1 := hw₁.trans_lt hu₁
  have hAB1 {z : F} : v ((A - B) * z) = v z := by rw [map_mul, hAB, one_mul]
  obtain ⟨hAD, hBD⟩ := mul_add_eq he₁ he₂
  -- `s = v u₂` satisfies `1 < v x₂ < s < (v x₂)²`
  set s := v (A * x₂ + ν)
  have hx₂0 : v x₂ ≠ 0 := (zero_lt_one.trans hx₂).ne'
  have hs0 : s ≠ 0 := fun h ↦ by
    rw [h, zero_pow two_ne_zero] at hs
    exact hx₂0 (pow_eq_zero_iff three_ne_zero |>.1 hs.symm)
  have hxs : v x₂ < s := by
    refine lt_of_pow_lt_pow_left₀ 2 zero_le ?_
    rw [hs]
    exact pow_lt_pow_right₀ hx₂ (by norm_num)
  have hsx : s < v x₂ ^ 2 := by
    refine lt_of_pow_lt_pow_left₀ 2 zero_le ?_
    rw [hs, ← pow_mul]
    exact pow_lt_pow_right₀ hx₂ (by norm_num)
  have h1s : 1 < s := hx₂.trans hxs
  -- `w₁ + u₂` has valuation `s`, and `A (w₁ + u₂)`, `B (w₁ + u₂)` have valuation `(v x₂)²`
  have hD : v (B * x₁ + ν + (A * x₂ + ν)) = s := v.map_add_eq_of_lt_right (hw₁1.trans h1s)
  have hlt {z : F} (hz : v z < v x₂ ^ 2) : v (x₁ ^ 2 + x₁ * x₂ + z) < v x₂ ^ 2 := by
    have h1 : (1 : Γ₀) < v x₂ ^ 2 := one_lt_pow₀ hx₂ two_ne_zero
    refine v.map_add_lt (v.map_add_lt ?_ ?_) hz
    · rw [map_pow]; exact (pow_le_one₀ zero_le hx₁).trans_lt h1
    · rw [map_mul, pow_two]
      exact mul_lt_mul_of_pos_right (hx₁.trans_lt hx₂) (zero_lt_one.trans hx₂)
  have hvAD : v A * s = v x₂ ^ 2 := by
    rw [← hD, ← map_mul, hAD, v.map_add_eq_of_lt_left, map_pow]
    rw [map_pow]; exact hlt (by rwa [hAB1])
  have hvBD : v B * s = v x₂ ^ 2 := by
    rw [← hD, ← map_mul, hBD, v.map_add_eq_of_lt_left, map_pow]
    rw [map_pow, sub_eq_add_neg]
    exact hlt (by rw [v.map_neg, hAB1]; exact (hw₁1.trans h1s).trans hsx)
  refine ⟨(mul_left_inj' hs0).1 (hvBD.trans hvAD.symm), ?_, ?_⟩
  · by_contra h
    have h' : v A * s < 1 * s := mul_lt_mul_of_pos_right (not_le.1 h) hs0.pos
    rw [hvAD, one_mul] at h'
    exact lt_asymm h' hsx
  · have h : v A ^ 3 * s ^ 3 = s * s ^ 3 := by
      rw [← mul_pow, hvAD, ← pow_mul, mul_comm 2 3, pow_mul, ← hs, ← pow_mul, ← pow_succ']
    exact (mul_left_inj' (pow_ne_zero 3 hs0)).1 h

/-- **The slope at a point with nonsingular reduction.** In the setting of
`one_le_valuation_of_valuation_eq`, if `v w₁ ≤ v u₁ < 1` and the second point has nonsingular
reduction, then `A` and `B` have a common valuation `σ ≥ 1`, and `u₂`, `w₂` both have valuation
`σ³`. -/
private theorem exists_valuation_eq_of_nonsingular {a₆ A B ν x₁ x₂ x₃ : F}
    (hAB : v (A - B) = 1) (ha₆ : v a₆ < 1)
    (he₁ : x₁ + x₂ + x₃ = A * B) (he₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = -(A + B) * ν)
    (hc₂ : (A * x₂ + ν) * (B * x₂ + ν) = x₂ ^ 3 + a₆)
    (hu₁ : v (A * x₁ + ν) < 1) (hw₁ : v (B * x₁ + ν) ≤ v (A * x₁ + ν))
    (h₂ : (v x₂ ≤ 1 ∧ v (A * x₂ + ν) = 1 ∧ v (B * x₂ + ν) = 1) ∨
      (1 < v x₂ ∧ v (A * x₂ + ν) = v (B * x₂ + ν) ∧ v (A * x₂ + ν) ^ 2 = v x₂ ^ 3)) :
    ∃ σ, 1 ≤ σ ∧ v A = σ ∧ v B = σ ∧ v (A * x₂ + ν) = σ ^ 3 ∧ v (B * x₂ + ν) = σ ^ 3 := by
  rcases h₂ with ⟨hx₂, hu₂, hw₂⟩ | ⟨hx₂, hu₂, hs⟩
  · obtain ⟨hA, hB⟩ := valuation_eq_one_of_le_one v hAB ha₆ he₁ he₂ hc₂ hu₁ hw₁ hx₂ hu₂
    exact ⟨1, le_rfl, hA, hB, by rw [hu₂, one_pow], by rw [hw₂, one_pow]⟩
  · obtain ⟨hBA, hσ1, hσ3⟩ := valuation_eq_of_one_lt v hAB he₁ he₂ hu₁ hw₁ hx₂ hs
    exact ⟨v A, hσ1, rfl, hBA, hσ3.symm, by rw [← hu₂, hσ3]⟩

/-- **Adding a point with nonsingular reduction keeps the branch valuation.** In the setting of
`one_le_valuation_of_valuation_eq`, if `0 < v u₁ < 1`, `v w₁ ≤ v u₁`, and the second point has
nonsingular reduction, then the third point has `v w₃ = v u₁` and `v u₃ ≤ v u₁`. -/
private theorem valuation_eq_and_le_of_nonsingular {a₆ A B ν x₁ x₂ x₃ : F}
    (hAB : v (A - B) = 1) (ha₆ : v a₆ < 1)
    (he₁ : x₁ + x₂ + x₃ = A * B) (he₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = -(A + B) * ν)
    (hc₂ : (A * x₂ + ν) * (B * x₂ + ν) = x₂ ^ 3 + a₆)
    (hu₁ : v (A * x₁ + ν) < 1) (hu₁0 : A * x₁ + ν ≠ 0) (hw₁ : v (B * x₁ + ν) ≤ v (A * x₁ + ν))
    (h₂ : (v x₂ ≤ 1 ∧ v (A * x₂ + ν) = 1 ∧ v (B * x₂ + ν) = 1) ∨
      (1 < v x₂ ∧ v (A * x₂ + ν) = v (B * x₂ + ν) ∧ v (A * x₂ + ν) ^ 2 = v x₂ ^ 3)) :
    v (B * x₃ + ν) = v (A * x₁ + ν) ∧ v (A * x₃ + ν) ≤ v (A * x₁ + ν) := by
  obtain ⟨σ, hσ1, hA, hB, hu₂, hw₂⟩ :=
    exists_valuation_eq_of_nonsingular v hAB ha₆ he₁ he₂ hc₂ hu₁ hw₁ h₂
  set κ := v (A * x₁ + ν)
  have hκ0 : κ ≠ 0 := (map_ne_zero v).2 hu₁0
  have hx₁ : v x₁ ≤ κ := valuation_le_of_mul_eq v hAB (by ring) le_rfl hw₁
  have hσ0 : σ ^ 3 ≠ 0 := pow_ne_zero 3 (zero_lt_one.trans_le hσ1).ne'
  -- every quadratic monomial in `x₁`, `u₁`, `w₁` with coefficient of valuation `≤ σ²` is at most
  -- `σ² κ²`, which is smaller than `σ³ κ`
  have hσ2 : σ ≤ σ ^ 2 := le_self_pow₀ hσ1 two_ne_zero
  have hσ23 : σ ^ 2 ≤ σ ^ 3 := pow_le_pow_right₀ hσ1 (by norm_num)
  have hκκ : σ ^ 2 * (κ * κ) < σ ^ 3 * κ :=
    calc σ ^ 2 * (κ * κ) < σ ^ 2 * (σ * κ) :=
          mul_lt_mul_of_pos_left (mul_lt_mul_of_pos_right (hu₁.trans_le hσ1) hκ0.pos)
            (pow_pos (zero_lt_one.trans_le hσ1) 2)
      _ = σ ^ 3 * κ := by rw [← mul_assoc, ← pow_succ]
  have hsq {a b : F} (ha : v a ≤ κ) (hb : v b ≤ κ) : v (a * b) ≤ σ ^ 2 * (κ * κ) := by
    rw [map_mul]
    exact (mul_le_mul' ha hb).trans (le_mul_of_one_le_left zero_le (one_le_pow₀ hσ1))
  have hcoef {c a b : F} (hc : v c ≤ σ ^ 2) (ha : v a ≤ κ) (hb : v b ≤ κ) :
      v (3 * c * a * b) ≤ σ ^ 2 * (κ * κ) := by
    have h3 : 3 * c * a * b = c * (a * b) + c * (a * b) + c * (a * b) := by ring
    have h : v (c * (a * b)) ≤ σ ^ 2 * (κ * κ) := by
      rw [map_mul, map_mul]; exact mul_le_mul' hc (mul_le_mul' ha hb)
    rw [h3]
    exact v.map_add_le (v.map_add_le h h) h
  constructor
  · -- `w₂ w₃ = w₁² - 3 B x₁ w₁ + 3 B² x₁² - B³ u₁`, where the last term dominates
    have hW := line_mul_mul (A := A) (B := B) (ν := ν) he₁ he₂
    have hrest : v ((B * x₁ + ν) ^ 2 - 3 * B * x₁ * (B * x₁ + ν) + 3 * B ^ 2 * x₁ * x₁) <
        σ ^ 3 * κ := by
      refine lt_of_le_of_lt (v.map_add_le (v.map_sub_le ?_ ?_) ?_) hκκ
      · rw [sq]; exact hsq hw₁ hw₁
      · exact hcoef (by rw [hB]; exact hσ2) hx₁ hw₁
      · exact hcoef (by rw [map_pow, hB]) hx₁ hx₁
    have h := congrArg v hW
    rw [v.map_sub_eq_of_lt_right (by rwa [map_mul, map_pow, hB]), map_mul, map_mul, map_pow, hB,
      hw₂] at h
    exact (mul_right_inj' hσ0).1 h
  · -- `u₂ u₃ = u₁² - 3 A x₁ u₁ + 3 A² x₁² - A³ w₁`, every term at most `σ³ κ`
    have hU := line_mul_mul (A := B) (B := A) (ν := ν) (x₁ := x₁) (x₂ := x₂) (x₃ := x₃)
      (by linear_combination he₁) (by linear_combination he₂)
    have hle : v ((A * x₁ + ν) ^ 2 - 3 * A * x₁ * (A * x₁ + ν) + 3 * A ^ 2 * x₁ * x₁ -
        A ^ 3 * (B * x₁ + ν)) ≤ σ ^ 3 * κ := by
      refine v.map_sub_le (v.map_add_le (v.map_sub_le ?_ ?_) ?_) ?_
      · rw [sq]; exact (hsq le_rfl le_rfl).trans hκκ.le
      · exact (hcoef (by rw [hA]; exact hσ2) hx₁ le_rfl).trans hκκ.le
      · exact (hcoef (by rw [map_pow, hA]) hx₁ hx₁).trans hκκ.le
      · rw [map_mul, map_pow, hA]; exact mul_le_mul' le_rfl hw₁
    rw [← hU, map_mul, hu₂] at hle
    exact le_of_mul_le_mul_left hle hσ0.pos

/-- **A branch strictly smaller than the other one.** On `u w = x³ + a₆` with `δ x = u - w`, `δ` a
unit, if `v w < v u < 1` then `v a₆ < (v u)²`. -/
private theorem valuation_lt_sq_of_lt {δ a₆ x u w : F} (hδ : v δ = 1) (hx : δ * x = u - w)
    (hc : u * w = x ^ 3 + a₆) (hu : v u < 1) (hwu : v w < v u) : v a₆ < v u ^ 2 := by
  have hu0 : v u ≠ 0 := (zero_le.trans_lt hwu).ne'
  have hvx : v x = v u := by
    have := congrArg v hx
    rwa [map_mul, hδ, one_mul, v.map_sub_eq_of_lt_left hwu] at this
  by_contra h
  have h3 : v (x ^ 3) < v a₆ := by
    rw [map_pow, hvx]
    refine lt_of_lt_of_le ?_ (not_lt.1 h)
    exact pow_lt_pow_right_of_lt_one₀ (zero_lt_iff.2 hu0) hu (by norm_num)
  have h' := congrArg v hc
  rw [map_mul, v.map_add_eq_of_lt_right h3] at h'
  -- `v u * v w = v a₆ ≥ (v u)²` forces `v w ≥ v u`
  have : v u * v u ≤ v u * v w := by rw [h', ← sq]; exact not_lt.1 h
  exact not_lt.2 (le_of_mul_le_mul_left this (zero_lt_iff.2 hu0)) hwu

/-- **Branches of equal size.** On `u w = x³ + a₆` with `δ x = u - w`, `δ` a unit and `a₆ ≠ 0`, if
`v u = v w < 1` then `(v u)² = v a₆`. -/
private theorem valuation_sq_eq_of_eq {δ a₆ x u w : F} (hδ : v δ = 1) (hx : δ * x = u - w)
    (hc : u * w = x ^ 3 + a₆) (ha₆ : a₆ ≠ 0) (hu : v u < 1) (hwu : v w = v u) :
    v u ^ 2 = v a₆ := by
  have hvx : v x ≤ v u := by
    have := congrArg v hx
    rw [map_mul, hδ, one_mul] at this
    exact this ▸ v.map_sub_le le_rfl hwu.le
  have hu0 : v u ≠ 0 := by
    intro h0
    have hu' : u = 0 := (map_eq_zero v).1 h0
    have hw' : w = 0 := (map_eq_zero v).1 (hwu.trans h0)
    have hx' : x = 0 := (map_eq_zero v).1 (le_antisymm (hvx.trans h0.le) zero_le)
    exact ha₆ (by simpa [hu', hw', hx'] using hc.symm)
  have huw : v (u * w) = v u ^ 2 := by rw [map_mul, hwu, sq]
  have h3 : v (x ^ 3) < v u ^ 2 := by
    rw [map_pow]
    exact (pow_le_pow_left₀ zero_le hvx 3).trans_lt
      (pow_lt_pow_right_of_lt_one₀ (zero_lt_iff.2 hu0) hu (by norm_num))
  rcases lt_trichotomy (v a₆) (v u ^ 2) with h | h | h
  · exact absurd (huw ▸ congrArg v hc ▸ v.map_add_lt h3 h) (lt_irrefl _)
  · exact h.symm
  · have := congrArg v hc
    rw [huw, v.map_add_eq_of_lt_right (h3.trans h)] at this
    exact absurd this h.ne

end Valuation

/-! ### Points of a curve in split nodal normal form -/

section Point

variable {F : Type*} [Field F] [DecidableEq F] {W : Affine F} {α β : F}

omit [DecidableEq F] in
/-- With `a₃ = a₄ = 0` and `T² + a₁ T - a₂ = (T - α) (T - β)`, the Weierstrass equation reads
`(y - α x) (y - β x) = x³ + a₆`. -/
private theorem equation_iff_mul (h₁ : W.a₁ = -(α + β)) (h₂ : W.a₂ = -(α * β)) (h₃ : W.a₃ = 0)
    (h₄ : W.a₄ = 0) {x y : F} :
    W.Equation x y ↔ (y - α * x) * (y - β * x) = x ^ 3 + W.a₆ := by
  rw [equation_iff, h₁, h₂, h₃, h₄]
  constructor <;> intro h <;> linear_combination h

/-- **The line through two points.** For two points of `(y - α x) (y - β x) = x³ + a₆` that are not
negatives of each other, the line `y = ℓ x + ν` through them (the tangent line if they coincide)
meets the curve again at the third point `(x₃, y₃)` with `P + Q = -(x₃, y₃)`. With `A = ℓ - α` and
`B = ℓ - β`, the branch coordinates of the three points are `A xᵢ + ν` and `B xᵢ + ν`, and
`x₁ + x₂ + x₃ = A B`, `x₁ x₂ + x₁ x₃ + x₂ x₃ = -(A + B) ν`. -/
private theorem exists_line (h₁ : W.a₁ = -(α + β)) (h₂ : W.a₂ = -(α * β)) (h₃ : W.a₃ = 0)
    (h₄ : W.a₄ = 0) {x₁ x₂ y₁ y₂ : F} (hP : W.Equation x₁ y₁) (hQ : W.Equation x₂ y₂)
    (hxy : ¬(x₁ = x₂ ∧ y₁ = W.negY x₂ y₂)) :
    ∃ A B ν : F, A - B = β - α ∧ y₁ - α * x₁ = A * x₁ + ν ∧ y₁ - β * x₁ = B * x₁ + ν ∧
      y₂ - α * x₂ = A * x₂ + ν ∧ y₂ - β * x₂ = B * x₂ + ν ∧
      W.addY x₁ x₂ y₁ (W.slope x₁ x₂ y₁ y₂) - α * W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂) =
        -(B * W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂) + ν) ∧
      W.addY x₁ x₂ y₁ (W.slope x₁ x₂ y₁ y₂) - β * W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂) =
        -(A * W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂) + ν) ∧
      x₁ + x₂ + W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂) = A * B ∧
      x₁ * x₂ + x₁ * W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂) +
        x₂ * W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂) = -(A + B) * ν := by
  set ℓ := W.slope x₁ x₂ y₁ y₂ with hℓ
  -- the line passes through the second point
  have hy₂ : y₂ = ℓ * x₂ + (y₁ - ℓ * x₁) := by
    by_cases hx : x₁ = x₂
    · rw [← Y_eq_of_Y_ne hP hQ hx fun h ↦ hxy ⟨hx, h⟩, hx]
      ring
    · rw [hℓ, slope_of_X_ne hx]
      field_simp [sub_ne_zero.2 hx]
      ring
  -- the coefficient of `X` in `W(X, ℓ (X - x₁) + y₁) = -(X - x₁) (X - x₂) (X - x₃)`
  have hc : 2 * x₁ * ℓ ^ 2 + (W.a₁ * x₁ - 2 * y₁ - W.a₃) * ℓ + (-W.a₁ * y₁ + W.a₄) =
      x₁ * x₂ + x₁ * W.addX x₁ x₂ ℓ + x₂ * W.addX x₁ x₂ ℓ := by
    have key := W.addPolynomial_slope hP hQ hxy
    rw [addPolynomial_eq, Cubic.prod_X_sub_C_eq, neg_inj] at key
    exact congrArg Cubic.c ((Cubic.toPoly_injective _ _).1 key)
  refine ⟨ℓ - α, ℓ - β, y₁ - ℓ * x₁, by ring, by ring, by ring, by rw [hy₂]; ring,
    by rw [hy₂]; ring, ?_, ?_, ?_, ?_⟩
  · simp only [addY, negY, negAddY, h₁, h₃]; ring
  · simp only [addY, negY, negAddY, h₁, h₃]; ring
  · simp only [addX, h₁, h₂]; ring
  · rw [← hc, h₁, h₃, h₄]; ring

end Point

/-! ### The component of a point -/

section Component

variable {F Γ₀ : Type*} [Field F] [LinearOrderedCommGroupWithZero Γ₀]
  {v : Valuation F Γ₀} {W : Affine F} {α β : F}

/-- The hypotheses of this file: `W` has `a₃ = a₄ = 0`, nonzero discriminant, `a₆` in the maximal
ideal, and tangent quadratic `T² + a₁ T - a₂ = (T - α) (T - β)` with `α`, `β` integral and `β - α`
a unit. Its reduction is then a split node at the origin. -/
private structure SplitNodal (v : Valuation F Γ₀) (W : Affine F) (α β : F) : Prop where
  a₁ : W.a₁ = -(α + β)
  a₂ : W.a₂ = -(α * β)
  a₃ : W.a₃ = 0
  a₄ : W.a₄ = 0
  α_le : v α ≤ 1
  β_le : v β ≤ 1
  sub : v (β - α) = 1
  a₆_lt : v W.a₆ < 1
  Δ_ne : W.Δ ≠ 0

private theorem SplitNodal.symm (hW : SplitNodal v W α β) : SplitNodal v W β α where
  a₁ := by rw [hW.a₁, add_comm]
  a₂ := by rw [hW.a₂, mul_comm]
  a₃ := hW.a₃
  a₄ := hW.a₄
  α_le := hW.β_le
  β_le := hW.α_le
  sub := by rw [← hW.sub, ← v.map_neg, neg_sub]
  a₆_lt := hW.a₆_lt
  Δ_ne := hW.Δ_ne

private theorem SplitNodal.a₆_ne (hW : SplitNodal v W α β) : W.a₆ ≠ 0 := fun h ↦ hW.Δ_ne <| by
  rw [Δ, b₂, b₄, b₆, b₈, hW.a₃, hW.a₄, h]; ring

private theorem SplitNodal.equation_iff (hW : SplitNodal v W α β) {x y : F} :
    W.Equation x y ↔ (y - α * x) * (y - β * x) = x ^ 3 + W.a₆ :=
  equation_iff_mul hW.a₁ hW.a₂ hW.a₃ hW.a₄

private theorem sub_mul_eq (α β x y : F) : (β - α) * x = (y - α * x) - (y - β * x) := by ring

/-- Negation exchanges the two branch coordinates, up to sign. -/
private theorem SplitNodal.negY_sub (hW : SplitNodal v W α β) (x y : F) :
    W.negY x y - α * x = -(y - β * x) := by
  rw [negY, hW.a₁, hW.a₃]; ring

/-- On a branch at least as large as the other one, `v a₆ < v u ≤ 1` and `v a₆ ≤ (v u)²`. -/
private theorem SplitNodal.valuation_lt_of_le (hW : SplitNodal v W α β) {x y : F}
    (h : W.Equation x y) (hu : v (y - α * x) < 1) (hwu : v (y - β * x) ≤ v (y - α * x)) :
    v W.a₆ < v (y - α * x) ∧ v W.a₆ ≤ v (y - α * x) ^ 2 := by
  have hc := hW.equation_iff.1 h
  have hsq : v W.a₆ ≤ v (y - α * x) ^ 2 := by
    rcases hwu.lt_or_eq with hlt | heq
    · exact (valuation_lt_sq_of_lt v hW.sub (sub_mul_eq α β x y) hc hu hlt).le
    · exact (valuation_sq_eq_of_eq v hW.sub (sub_mul_eq α β x y) hc hW.a₆_ne hu heq).ge
  refine ⟨lt_of_le_of_lt hsq ?_, hsq⟩
  have h0 : v (y - α * x) ≠ 0 := fun h0 ↦ (v.zero_iff.not.2 hW.a₆_ne) (le_antisymm
    (by simpa [h0] using hsq) zero_le)
  exact pow_lt_self_of_lt_one₀ (zero_lt_iff.2 h0) hu one_lt_two

variable [DecidableEq F] [IsIntegral v.valuationSubring W]

omit [DecidableEq F] in
private theorem SplitNodal.integralModel_mem (hW : SplitNodal v W α β) :
    (integralModel v.valuationSubring W).a₃ ∈ maximalIdeal v.valuationSubring ∧
      (integralModel v.valuationSubring W).a₄ ∈ maximalIdeal v.valuationSubring ∧
      (integralModel v.valuationSubring W).a₆ ∈ maximalIdeal v.valuationSubring := by
  have h₃ : ((integralModel v.valuationSubring W).a₃ : F) = W.a₃ :=
    integralModel_a₃_eq v.valuationSubring W
  have h₄ : ((integralModel v.valuationSubring W).a₄ : F) = W.a₄ :=
    integralModel_a₄_eq v.valuationSubring W
  have h₆ : ((integralModel v.valuationSubring W).a₆ : F) = W.a₆ :=
    integralModel_a₆_eq v.valuationSubring W
  simp only [Valuation.mem_maximalIdeal_iff, h₃, h₄, h₆, hW.a₃, hW.a₄, map_zero, zero_lt_one,
    hW.a₆_lt, and_self]

/-- **The points with singular reduction are those on which both branch coordinates are small.** -/
private theorem SplitNodal.some_notMem_iff (hW : SplitNodal v W α β) {x y : F}
    (h : W.Nonsingular x y) : Point.some x y h ∉ W.nonsingularReduction v ↔
      v (y - α * x) < 1 ∧ v (y - β * x) < 1 := by
  obtain ⟨h₃, h₄, h₆⟩ := hW.integralModel_mem
  rw [some_notMem_nonsingularReduction_iff v h₃ h₄ h₆ h]
  have hlt {a z : F} (ha : v a ≤ 1) (hz : v z < 1) : v (a * z) < 1 := by
    rw [map_mul]; exact (mul_le_of_le_one_left' ha).trans_lt hz
  constructor
  · rintro ⟨hx, hy⟩
    exact ⟨v.map_sub_lt hy (hlt hW.α_le hx), v.map_sub_lt hy (hlt hW.β_le hx)⟩
  · rintro ⟨hu, hw⟩
    have hx : v x < 1 := by
      have := congrArg v (sub_mul_eq α β x y)
      rw [map_mul, hW.sub, one_mul] at this
      exact this ▸ v.map_sub_lt hu hw
    exact ⟨hx, by simpa using v.map_add_lt hu (hlt hW.α_le hx)⟩

omit [DecidableEq F] [IsIntegral v.valuationSubring W] in
/-- On an integral point, if the second branch coordinate is a unit then so is the first: otherwise
`x` would be a unit, and so would `x³ + a₆ = u w`. -/
private theorem SplitNodal.valuation_eq_one_of_eq_one (hW : SplitNodal v W α β) {x y : F}
    (h : W.Equation x y) (hu : v (y - α * x) ≤ 1) (hw : v (y - β * x) = 1) :
    v (y - α * x) = 1 := by
  refine le_antisymm hu (not_lt.1 fun hu' ↦ ?_)
  have hx1 : v x = 1 := by
    have := congrArg v (sub_mul_eq α β x y)
    rwa [map_mul, hW.sub, one_mul, v.map_sub_eq_of_lt_right (hw ▸ hu'), hw] at this
  have h' := congrArg v (hW.equation_iff.1 h)
  rw [v.map_add_eq_of_lt_left (by rw [map_pow, hx1, one_pow]; exact hW.a₆_lt), map_pow, hx1,
    one_pow, map_mul, hw, mul_one] at h'
  exact absurd h' hu'.ne

/-- **The branch coordinates of a point with nonsingular reduction**: both are units if the point
is integral, and both have the valuation of `y`, with `(v y)² = (v x)³`, if it is not. -/
private theorem SplitNodal.valuation_of_mem (hW : SplitNodal v W α β) {x y : F}
    (h : W.Nonsingular x y) (hP : Point.some x y h ∈ W.nonsingularReduction v) :
    (v x ≤ 1 ∧ v (y - α * x) = 1 ∧ v (y - β * x) = 1) ∨
      (1 < v x ∧ v (y - α * x) = v (y - β * x) ∧ v (y - α * x) ^ 2 = v x ^ 3) := by
  have hn := mt (hW.some_notMem_iff h).2 (not_not.2 hP)
  rcases le_or_gt (v x) 1 with hx | hx
  · have hy := valuation_y_le_one_of_valuation_x_le_one v h.left hx
    have hle {a : F} (ha : v a ≤ 1) : v (y - a * x) ≤ 1 :=
      v.map_sub_le hy (by rw [map_mul]; exact mul_le_one' ha hx)
    -- the two branch coordinates are integral and not both in the maximal ideal
    rcases (hle hW.α_le).lt_or_eq with hu | hu
    · have hw : v (y - β * x) = 1 :=
        (hle hW.β_le).eq_of_not_lt fun hw ↦ hn ⟨hu, hw⟩
      exact absurd (hW.valuation_eq_one_of_eq_one h.left (hle hW.α_le) hw) hu.ne
    · exact .inl ⟨hx, hu, hW.symm.valuation_eq_one_of_eq_one h.left (hle hW.β_le) hu⟩
  · have hxy := valuation_x_lt_valuation_y v h.left hx
    have hbr {a : F} (ha : v a ≤ 1) : v (y - a * x) = v y := by
      refine v.map_sub_eq_of_lt_left (lt_of_le_of_lt ?_ hxy)
      rw [map_mul]; exact mul_le_of_le_one_left' ha
    refine .inr ⟨hx, by rw [hbr hW.α_le, hbr hW.β_le], ?_⟩
    rw [hbr hW.α_le]
    exact valuation_y_sq_eq_valuation_x_cube v h.left hx

variable (v W α β) in
/-- The component of the special fibre a point reduces to, recorded by a value of `v`: `1` on
`E₀(F)`, `v (y - α x)` when `v (y - β x) ≤ v (y - α x) < 1`, and `v a₆ / v (y - β x)` when
`v (y - α x) < v (y - β x) < 1`. Its values on the points outside `E₀(F)` lie in the interval
`(v a₆, 1)` of the value group, and fill it when the valuation ring is Henselian. -/
private noncomputable def componentValue : W.Point → Γ₀
  | .zero => 1
  | .some x y _ =>
    if v (y - α * x) < 1 ∧ v (y - β * x) < 1 then
      if v (y - β * x) ≤ v (y - α * x) then v (y - α * x) else v W.a₆ / v (y - β * x)
    else 1

omit [DecidableEq F] [IsIntegral v.valuationSubring W] in
private theorem componentValue_zero : componentValue v W α β 0 = 1 := rfl

omit [DecidableEq F] [IsIntegral v.valuationSubring W] in
private theorem componentValue_some_of_le {x y : F} (h : W.Nonsingular x y) (hu : v (y - α * x) < 1)
    (hwu : v (y - β * x) ≤ v (y - α * x)) :
    componentValue v W α β (.some x y h) = v (y - α * x) := by
  simp only [componentValue, hu, hwu.trans_lt hu, and_self, hwu, ↓reduceIte]

omit [DecidableEq F] [IsIntegral v.valuationSubring W] in
private theorem componentValue_some_of_ge (hW : SplitNodal v W α β) {x y : F}
    (h : W.Nonsingular x y)
    (hw : v (y - β * x) < 1) (huw : v (y - α * x) ≤ v (y - β * x)) :
    componentValue v W α β (.some x y h) = v W.a₆ / v (y - β * x) := by
  simp only [componentValue, huw.trans_lt hw, hw, and_self, ↓reduceIte]
  split_ifs with hwu
  · -- the two branches have equal valuation, whose square is `v a₆`
    have heq := le_antisymm huw hwu
    have hsq := valuation_sq_eq_of_eq v hW.sub (sub_mul_eq α β x y) (hW.equation_iff.1 h.left)
      hW.a₆_ne (huw.trans_lt hw) heq.symm
    have h0 : v (y - β * x) ≠ 0 := heq ▸ fun h0 ↦ hW.a₆_ne (v.zero_iff.1 (by
      rw [← hsq, h0, zero_pow two_ne_zero]))
    rw [← hsq, heq, sq, mul_div_cancel_right₀ _ h0]
  · rfl

private theorem componentValue_of_mem (hW : SplitNodal v W α β) {P : W.Point}
    (hP : P ∈ W.nonsingularReduction v) : componentValue v W α β P = 1 := by
  rcases P with _ | ⟨x, y, h⟩
  · rfl
  · simp only [componentValue, (hW.some_notMem_iff h).not.1 (not_not.2 hP), ↓reduceIte]

/-- The squares of the two kinds of values: at least `v a₆` on the first branch, less than `v a₆` on
the second. -/
private theorem SplitNodal.sq_componentValue (hW : SplitNodal v W α β) {x y : F}
    (h : W.Nonsingular x y)
    (hP : Point.some x y h ∉ W.nonsingularReduction v) :
    (v (y - β * x) ≤ v (y - α * x) → v W.a₆ ≤ componentValue v W α β (.some x y h) ^ 2) ∧
      (v (y - α * x) < v (y - β * x) → componentValue v W α β (.some x y h) ^ 2 < v W.a₆) := by
  obtain ⟨hu, hw⟩ := (hW.some_notMem_iff h).1 hP
  refine ⟨fun hwu ↦ ?_, fun huw ↦ ?_⟩
  · rw [componentValue_some_of_le h hu hwu]
    exact (hW.valuation_lt_of_le h.left hu hwu).2
  · rw [componentValue_some_of_ge hW h hw huw.le]
    have hsym := hW.symm.valuation_lt_of_le h.left hw huw.le
    have hw0 : v (y - β * x) ≠ 0 := (zero_le.trans_lt hsym.1).ne'
    have h60 : v W.a₆ ≠ 0 := v.zero_iff.not.2 hW.a₆_ne
    rw [div_pow, div_lt_iff₀ (pow_pos (zero_lt_iff.2 hw0) 2), sq (v W.a₆)]
    -- the strict inequality `v a₆ < (v w)²` of the second branch
    have hlt := valuation_lt_sq_of_lt v (δ := α - β) (x := x) (by rw [← v.map_neg, neg_sub,
      hW.sub]) (by ring) (by rw [mul_comm]; exact hW.equation_iff.1 h.left) hw huw
    exact mul_lt_mul_of_pos_left hlt (zero_lt_iff.2 h60)

/-- **The values of the component** on the points outside `E₀(F)` lie in `(v a₆, 1)`, and are
values of `v`. -/
private theorem SplitNodal.componentValue_mem (hW : SplitNodal v W α β) {P : W.Point}
    (hP : P ∉ W.nonsingularReduction v) :
    componentValue v W α β P ∈ Set.range v ∩ Set.Ioo (v W.a₆) 1 := by
  rcases P with _ | ⟨x, y, h⟩
  · exact absurd (zero_mem _) hP
  obtain ⟨hu, hw⟩ := (hW.some_notMem_iff h).1 hP
  rcases le_total (v (y - β * x)) (v (y - α * x)) with hwu | huw
  · rw [componentValue_some_of_le h hu hwu]
    exact ⟨⟨_, rfl⟩, (hW.valuation_lt_of_le h.left hu hwu).1, hu⟩
  · rw [componentValue_some_of_ge hW h hw huw]
    have hsym := (hW.symm.valuation_lt_of_le h.left hw huw).1
    have hw0 : 0 < v (y - β * x) := zero_le.trans_lt hsym
    refine ⟨⟨W.a₆ / (y - β * x), map_div₀ v _ _⟩, ?_, ?_⟩
    · rw [lt_div_iff₀ hw0]
      exact mul_lt_of_lt_one_right (zero_lt_iff.2 (v.zero_iff.not.2 hW.a₆_ne)) hw
    · rwa [div_lt_one₀ hw0]

/-- **Adding a point of `E₀(F)` to a point on the first branch.** If `(x₁, y₁)` has singular
reduction with `v (y₁ - β x₁) ≤ v (y₁ - α x₁)` and `(x₂, y₂)` has nonsingular reduction, then their
sum `(x₃, y₃)` has `v (y₃ - α x₃) = v (y₁ - α x₁)` and `v (y₃ - β x₃) ≤ v (y₁ - α x₁)`. -/
private theorem SplitNodal.valuation_add_of_le (hW : SplitNodal v W α β) {x₁ y₁ x₂ y₂ : F}
    (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂)
    (hP : Point.some x₁ y₁ h₁ ∉ W.nonsingularReduction v)
    (hT : Point.some x₂ y₂ h₂ ∈ W.nonsingularReduction v)
    (hwu : v (y₁ - β * x₁) ≤ v (y₁ - α * x₁)) (hxy : ¬(x₁ = x₂ ∧ y₁ = W.negY x₂ y₂)) :
    v (W.addY x₁ x₂ y₁ (W.slope x₁ x₂ y₁ y₂) - α * W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂)) =
        v (y₁ - α * x₁) ∧
      v (W.addY x₁ x₂ y₁ (W.slope x₁ x₂ y₁ y₂) - β * W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂)) ≤
        v (y₁ - α * x₁) := by
  obtain ⟨hu, -⟩ := (hW.some_notMem_iff h₁).1 hP
  have hu0 : y₁ - α * x₁ ≠ 0 := fun h0 ↦ by
    simpa [h0] using (zero_le.trans_lt (hW.valuation_lt_of_le h₁.left hu hwu).1)
  have hc₂ := hW.equation_iff.1 h₂.left
  have hmem := hW.valuation_of_mem h₂ hT
  obtain ⟨A, B, ν, hAB, hu₁, hw₁, hu₂, hw₂, hu₃, hw₃, he₁, he₂⟩ :=
    exists_line hW.a₁ hW.a₂ hW.a₃ hW.a₄ h₁.left h₂.left hxy
  rw [hu₂, hw₂] at hc₂ hmem
  rw [hu₁, hw₁] at hwu
  rw [hu₁] at hu hu0 ⊢
  rw [hu₃, hw₃, v.map_neg, v.map_neg]
  exact valuation_eq_and_le_of_nonsingular v (by rw [hAB, hW.sub]) hW.a₆_lt he₁ he₂ hc₂ hu hu0 hwu
    hmem

/-- **The component is constant on the cosets of `E₀(F)`.** -/
private theorem SplitNodal.componentValue_add_of_mem (hW : SplitNodal v W α β) (P : W.Point)
    {T : W.Point} (hT : T ∈ W.nonsingularReduction v) :
    componentValue v W α β (P + T) = componentValue v W α β P := by
  by_cases hP : P ∈ W.nonsingularReduction v
  · rw [componentValue_of_mem hW hP, componentValue_of_mem hW (add_mem hP hT)]
  rcases P with _ | ⟨x₁, y₁, h₁⟩
  · exact absurd (zero_mem _) hP
  rcases T with _ | ⟨x₂, y₂, h₂⟩
  · rw [← Point.zero_def, add_zero]
  have hxy : ¬(x₁ = x₂ ∧ y₁ = W.negY x₂ y₂) := by
    rintro ⟨rfl, rfl⟩
    exact hP (Point.neg_some h₂ ▸ neg_mem hT)
  rw [Point.add_some hxy]
  obtain ⟨hu, hw⟩ := (hW.some_notMem_iff h₁).1 hP
  rcases le_total (v (y₁ - β * x₁)) (v (y₁ - α * x₁)) with hwu | huw
  · obtain ⟨h1, h2⟩ := hW.valuation_add_of_le h₁ h₂ hP hT hwu hxy
    rw [componentValue_some_of_le h₁ hu hwu,
      componentValue_some_of_le _ (h1 ▸ hu) (h2.trans h1.ge), h1]
  · obtain ⟨h1, h2⟩ := hW.symm.valuation_add_of_le h₁ h₂ hP hT huw hxy
    rw [componentValue_some_of_ge hW h₁ hw huw,
      componentValue_some_of_ge hW _ (h1 ▸ hw) (h2.trans h1.ge), h1]

/-- **Two points on opposite branches with matching valuations sum into `E₀(F)`.** If
`(x₁, y₁)` has singular reduction with `v (y₁ - β x₁) ≤ v (y₁ - α x₁)`, and `(x₂, y₂)` has
`v (y₂ - α x₂) ≤ v (y₂ - β x₂) = v (y₁ - α x₁)`, their sum has nonsingular reduction. -/
private theorem SplitNodal.add_mem_of_valuation_eq (hW : SplitNodal v W α β) {x₁ y₁ x₂ y₂ : F}
    (h₁ : W.Nonsingular x₁ y₁) (h₂ : W.Nonsingular x₂ y₂)
    (hP : Point.some x₁ y₁ h₁ ∉ W.nonsingularReduction v)
    (hwu : v (y₁ - β * x₁) ≤ v (y₁ - α * x₁)) (huw : v (y₂ - α * x₂) ≤ v (y₂ - β * x₂))
    (heq : v (y₂ - β * x₂) = v (y₁ - α * x₁)) :
    Point.some x₁ y₁ h₁ + Point.some x₂ y₂ h₂ ∈ W.nonsingularReduction v := by
  by_cases hxy : x₁ = x₂ ∧ y₁ = W.negY x₂ y₂
  · rw [Point.add_of_Y_eq hxy.1 hxy.2]
    exact zero_mem _
  rw [Point.add_some hxy]
  obtain ⟨hu, -⟩ := (hW.some_notMem_iff h₁).1 hP
  have hu0 : y₁ - α * x₁ ≠ 0 := fun h0 ↦ by
    simpa [h0] using (zero_le.trans_lt (hW.valuation_lt_of_le h₁.left hu hwu).1)
  obtain ⟨A, B, ν, hAB, hu₁, hw₁, hu₂, hw₂, -, hw₃, he₁, he₂⟩ :=
    exists_line hW.a₁ hW.a₂ hW.a₃ hW.a₄ h₁.left h₂.left hxy
  rw [hu₁, hw₁] at hwu
  rw [hu₂, hw₂] at huw
  rw [hw₂] at heq
  rw [hu₁] at hu hu0 heq
  have h1 := one_le_valuation_of_valuation_eq v (by rw [hAB, hW.sub]) he₁ he₂ hu hu0 hwu heq huw
  by_contra hn
  have hw := ((hW.some_notMem_iff _).1 hn).2
  rw [hw₃, v.map_neg] at hw
  exact not_le.2 hw h1

/-- **The component separates the cosets of `E₀(F)`.** -/
private theorem SplitNodal.neg_add_mem_of_componentValue_eq (hW : SplitNodal v W α β)
    {P Q : W.Point} (h : componentValue v W α β P = componentValue v W α β Q) :
    -P + Q ∈ W.nonsingularReduction v := by
  by_cases hP : P ∈ W.nonsingularReduction v
  · refine add_mem (neg_mem hP) (by_contra fun hQ ↦ ?_)
    have := (hW.componentValue_mem hQ).2.2
    rw [← h, componentValue_of_mem hW hP] at this
    exact lt_irrefl _ this
  by_cases hQ : Q ∈ W.nonsingularReduction v
  · have := (hW.componentValue_mem hP).2.2
    rw [h, componentValue_of_mem hW hQ] at this
    exact absurd this (lt_irrefl _)
  rcases P with _ | ⟨x₁, y₁, h₁⟩
  · exact absurd (zero_mem _) hP
  rcases Q with _ | ⟨x₂, y₂, h₂⟩
  · exact absurd (zero_mem _) hQ
  -- it suffices that `P - Q` has nonsingular reduction
  suffices hs : Point.some x₁ y₁ h₁ + -Point.some x₂ y₂ h₂ ∈ W.nonsingularReduction v by
    have := neg_mem hs
    rwa [neg_add_rev, neg_neg, add_comm] at this
  obtain ⟨hu₁, hw₁⟩ := (hW.some_notMem_iff h₁).1 hP
  obtain ⟨hu₂, hw₂⟩ := (hW.some_notMem_iff h₂).1 hQ
  have hn₁ := hW.negY_sub x₂ y₂
  have hn₂ := hW.symm.negY_sub x₂ y₂
  rw [Point.neg_some]
  rcases lt_or_ge (v (y₁ - α * x₁)) (v (y₁ - β * x₁)) with huw₁ | hwu₁ <;>
    rcases lt_or_ge (v (y₂ - α * x₂)) (v (y₂ - β * x₂)) with huw₂ | hwu₂
  · -- both on the second branch: `v (y₁ - β x₁) = v (y₂ - β x₂)`
    rw [componentValue_some_of_ge hW h₁ hw₁ huw₁.le,
      componentValue_some_of_ge hW h₂ hw₂ huw₂.le] at h
    have h60 : v W.a₆ ≠ 0 := v.zero_iff.not.2 hW.a₆_ne
    have heq : v (y₁ - β * x₁) = v (y₂ - β * x₂) := by
      have := congrArg (·⁻¹) h
      simpa [div_eq_mul_inv, mul_inv, h60] using this
    exact hW.symm.add_mem_of_valuation_eq h₁ _ hP huw₁.le
      (by rw [hn₁, hn₂, v.map_neg, v.map_neg]; exact huw₂.le)
      (by rw [hn₁, v.map_neg, ← heq])
  · exact absurd (h ▸ (hW.sq_componentValue h₁ hP).2 huw₁)
      (not_lt.2 ((hW.sq_componentValue h₂ hQ).1 hwu₂))
  · exact absurd (h ▸ (hW.sq_componentValue h₂ hQ).2 huw₂)
      (not_lt.2 ((hW.sq_componentValue h₁ hP).1 hwu₁))
  · -- both on the first branch: `v (y₁ - α x₁) = v (y₂ - α x₂)`
    rw [componentValue_some_of_le h₁ hu₁ hwu₁, componentValue_some_of_le h₂ hu₂ hwu₂] at h
    exact hW.add_mem_of_valuation_eq h₁ _ hP hwu₁
      (by rw [hn₁, hn₂, v.map_neg, v.map_neg]; exact hwu₂)
      (by rw [hn₂, v.map_neg, h])

omit [DecidableEq F] [IsIntegral v.valuationSubring W] in
/-- **Points on a prescribed branch.** Over a Henselian valuation ring, for every `z` with
`v z < 1` and `v a₆ ≤ (v z)²` there is a point with `y - α x = z` and `v (y - β x) ≤ v z`: putting
`y - β x = z t`, the equation becomes `t = z (1 - t)³ / (β - α)³ + a₆ / z²`, whose reduction has the
simple root `a₆ / z²`. -/
private theorem SplitNodal.exists_point [HenselianLocalRing v.valuationSubring]
    (hW : SplitNodal v W α β) {z : F} (hz : v z < 1) (hz₆ : v W.a₆ ≤ v z ^ 2) :
    ∃ x y : F, W.Nonsingular x y ∧ y - α * x = z ∧ v (y - β * x) ≤ v z := by
  have hz0 : z ≠ 0 := fun h0 ↦ hW.a₆_ne <| v.zero_iff.1 <| le_antisymm
    (by simpa [h0] using hz₆) zero_le
  have hδ0 : β - α ≠ 0 := fun h0 ↦ by simpa [h0] using hW.sub
  set O := v.valuationSubring
  let e : O := ⟨z / (β - α) ^ 3, by
    rw [Valuation.mem_valuationSubring_iff, map_div₀, map_pow, hW.sub, one_pow, div_one]
    exact hz.le⟩
  let c : O := ⟨W.a₆ / z ^ 2, by
    rw [Valuation.mem_valuationSubring_iff, map_div₀, map_pow]
    exact div_le_one_of_le₀ hz₆ zero_le⟩
  have he : e ∈ maximalIdeal O := by
    have he' : (e : F) = z / (β - α) ^ 3 := rfl
    rwa [Valuation.mem_maximalIdeal_iff, he', map_div₀, map_pow, hW.sub, one_pow, div_one]
  have hev : (X - C e * (1 - X) ^ 3 - C c : O[X]).eval c = -(e * (1 - c) ^ 3) := by
    simp only [eval_sub, eval_X, eval_mul, eval_C, eval_pow, eval_one]
    ring
  obtain ⟨t, ht, -⟩ := TauCeti.HenselianLocalRing.exists_isRoot_sub_mem_maximalIdeal
    (X - C e * (1 - X) ^ 3 - C c) (a₀ := c)
    (by rw [hev]; exact neg_mem ((maximalIdeal O).mul_mem_right _ he))
    (by
      rw [← notMem_maximalIdeal]
      intro hm
      have h1 : (1 : O) ∈ maximalIdeal O := by
        have h3 : (3 : O) * e * (1 - c) ^ 2 ∈ maximalIdeal O :=
          (maximalIdeal O).mul_mem_right _ ((maximalIdeal O).mul_mem_left _ he)
        have := sub_mem hm h3
        simp only [derivative_sub, derivative_X, derivative_mul, derivative_C, zero_mul,
          zero_add, derivative_pow, derivative_sub, derivative_one, zero_sub, eval_sub, eval_one,
          eval_mul, eval_C, eval_pow, eval_X, eval_neg, sub_zero] at this
        convert this using 1
        push_cast
        ring
      exact (maximalIdeal.isMaximal O).ne_top ((Ideal.eq_top_iff_one _).2 h1))
  -- the root `t` gives the point `x = z (1 - t) / (β - α)`, `y = z + α x`
  have hroot : (t : F) - z / (β - α) ^ 3 * (1 - t) ^ 3 - W.a₆ / z ^ 2 = 0 := by
    have := congrArg Subtype.val ht.eq_zero
    simpa [e, c] using this
  have hw : z + α * (z * (1 - t) / (β - α)) - β * (z * (1 - t) / (β - α)) = z * t := by
    field_simp
    ring
  refine ⟨z * (1 - t) / (β - α), z + α * (z * (1 - t) / (β - α)),
    (equation_iff_nonsingular_of_Δ_ne_zero hW.Δ_ne).1 (hW.equation_iff.2 ?_), by ring, ?_⟩
  · rw [hw, add_sub_cancel_right]
    field_simp at hroot ⊢
    linear_combination hroot
  · rw [hw, map_mul]
    exact mul_le_of_le_one_right' t.2

omit [DecidableEq F] [IsIntegral v.valuationSubring W] in
/-- **Every value of `v` in `(v a₆, 1)` is the component of a point.** -/
private theorem SplitNodal.exists_componentValue_eq [HenselianLocalRing v.valuationSubring]
    (hW : SplitNodal v W α β) {γ : Γ₀} (hγ : γ ∈ Set.range v) (h₁ : v W.a₆ < γ) (h₂ : γ < 1) :
    ∃ P : W.Point, componentValue v W α β P = γ := by
  obtain ⟨z, rfl⟩ := hγ
  rcases le_or_gt (v W.a₆) (v z ^ 2) with hz | hz
  · obtain ⟨x, y, h, hu, hw⟩ := hW.exists_point h₂ hz
    exact ⟨.some x y h, by rw [componentValue_some_of_le h (hu ▸ h₂) (hu ▸ hw), hu]⟩
  · -- on the second branch, take a point with `y - β x = a₆ / z`
    have hz0 : 0 < v z := zero_le.trans_lt h₁
    have h60 : v W.a₆ ≠ 0 := v.zero_iff.not.2 hW.a₆_ne
    have hz' : v (W.a₆ / z) < 1 := by rwa [map_div₀, div_lt_one₀ hz0]
    have hz'₆ : v W.a₆ ≤ v (W.a₆ / z) ^ 2 := by
      rw [map_div₀, div_pow, le_div_iff₀ (pow_pos hz0 2), sq (v W.a₆)]
      exact mul_le_mul' le_rfl hz.le
    obtain ⟨x, y, h, hw, hu⟩ := hW.symm.exists_point hz' hz'₆
    refine ⟨.some x y h, ?_⟩
    rw [componentValue_some_of_ge hW h (hw ▸ hz') (hw ▸ hu), hw, map_div₀, div_div_cancel₀ h60]

end Component

/-! ### The index of `E₀(F)` -/

section Index

variable {F Γ₀ : Type*} [Field F] [DecidableEq F] [LinearOrderedCommGroupWithZero Γ₀]
  {v : Valuation F Γ₀} {W : Affine F} [IsIntegral v.valuationSubring W]

omit [DecidableEq F] in
/-- The hypotheses of the main theorem put `W` in split nodal normal form, with `β = -a₁ - α`. -/
private theorem splitNodal_of_isRoot [W.IsElliptic] (h₃ : W.a₃ = 0) (h₄ : W.a₄ = 0)
    (h₆ : v W.a₆ < 1) (hb₂ : v W.b₂ = 1) {α : F} (hα : v α ≤ 1)
    (hαr : α ^ 2 + W.a₁ * α - W.a₂ = 0) : SplitNodal v W α (-W.a₁ - α) where
  a₁ := by ring
  a₂ := by linear_combination -hαr
  a₃ := h₃
  a₄ := h₄
  α_le := hα
  β_le := v.map_sub_le ((v.map_neg _).trans_le (valuation_a₁_le_one v)) hα
  sub := by
    have hsq : (-W.a₁ - α - α) ^ 2 = W.b₂ := by rw [b₂]; linear_combination 4 * hαr
    have h := congrArg v hsq
    rw [map_pow, hb₂] at h
    exact sq_eq_one.1 h
  a₆_lt := h₆
  Δ_ne := W.isUnit_Δ.ne_zero

/-- **The index of `E₀(F)` at a split node is the number of values of `v` in `(v a₆, 1]`.** Let
`v` be a valuation on `F` whose valuation ring is Henselian, and `W` an elliptic curve over `F`
with an integral model whose reduction is a split node at the origin, centred so that
`a₃ = a₄ = 0`: `a₆` lies in the maximal ideal, `b₂` is a unit, and the tangent quadratic
`T² + a₁ T - a₂` has a root `α` in the valuation ring. Then the index of the subgroup `E₀(F)` of
points with nonsingular reduction is the number of values `γ` of `v` with `v a₆ < γ ≤ 1`, both
sides being `0` when infinite. -/
theorem index_nonsingularReduction_eq_natCard_of_tangentQuadratic_root
    [HenselianLocalRing v.valuationSubring]
    [W.IsElliptic] (h₃ : W.a₃ = 0) (h₄ : W.a₄ = 0) (h₆ : v W.a₆ < 1) (hb₂ : v W.b₂ = 1) {α : F}
    (hα : v α ≤ 1) (hαr : α ^ 2 + W.a₁ * α - W.a₂ = 0) :
    (W.nonsingularReduction v).index = Nat.card ↥(Set.range v ∩ Set.Ioc (v W.a₆) 1) := by
  have hW := splitNodal_of_isRoot h₃ h₄ h₆ hb₂ hα hαr
  set S := Set.range v ∩ Set.Ioc (v W.a₆) 1
  -- the component of a point, as an element of `S`
  let g : W.Point → S := fun P ↦ ⟨componentValue v W α (-W.a₁ - α) P, by
    by_cases hP : P ∈ W.nonsingularReduction v
    · rw [componentValue_of_mem hW hP]
      exact ⟨⟨1, v.map_one⟩, h₆, le_rfl⟩
    · obtain ⟨hr, hl, hu⟩ := hW.componentValue_mem hP
      exact ⟨hr, hl, hu.le⟩⟩
  have hg (P Q : W.Point) (h : -P + Q ∈ W.nonsingularReduction v) : g P = g Q :=
    Subtype.ext <| by
      simp only [g]
      rw [← hW.componentValue_add_of_mem P h, add_neg_cancel_left]
  rw [AddSubgroup.index_eq_card]
  refine Nat.card_congr (Equiv.ofBijective (Quotient.lift g fun P Q h ↦
    hg P Q (QuotientAddGroup.leftRel_apply.1 h)) ⟨?_, ?_⟩)
  · intro p q hpq
    induction p using QuotientAddGroup.induction_on with | H P => ?_
    induction q using QuotientAddGroup.induction_on with | H Q => ?_
    exact QuotientAddGroup.eq.2 (hW.neg_add_mem_of_componentValue_eq (congrArg Subtype.val hpq))
  · rintro ⟨γ, hγr, hγ₁, hγ₂⟩
    rcases hγ₂.lt_or_eq with hlt | rfl
    · obtain ⟨P, hP⟩ := hW.exists_componentValue_eq hγr hγ₁ hlt
      exact ⟨(P : W.Point ⧸ W.nonsingularReduction v), Subtype.ext hP⟩
    · exact ⟨(0 : W.Point ⧸ W.nonsingularReduction v),
        Subtype.ext (componentValue_zero (v := v) (W := W) (α := α) (β := -W.a₁ - α))⟩

omit [DecidableEq F] [IsIntegral v.valuationSubring W] in
/-- When the maximal ideal of the valuation ring is generated by `ϖ`, the values of `v` in
`(v ϖ ^ n, 1]` are the powers `v ϖ ^ j` with `j < n`. -/
private theorem exists_pow_eq_of_lt {ϖ : v.valuationSubring}
    (hϖ : maximalIdeal v.valuationSubring = Ideal.span {ϖ}) :
    ∀ (n : ℕ) {z : F}, v (ϖ : F) ^ n < v z → v z ≤ 1 → ∃ j < n, v (ϖ : F) ^ j = v z
  | 0, z, hlt, hle => absurd hle (not_le.2 (by rwa [pow_zero] at hlt))
  | n + 1, z, hlt, hle => by
    rcases hle.lt_or_eq with hz | hz
    · have hm : (⟨z, (v.mem_valuationSubring_iff z).2 hle⟩ : v.valuationSubring) ∈
          maximalIdeal v.valuationSubring := (Valuation.mem_maximalIdeal_iff (v := v)).2 hz
      rw [hϖ, Ideal.mem_span_singleton'] at hm
      obtain ⟨r, hr⟩ := hm
      have hrz : (r : F) * ϖ = z := congrArg Subtype.val hr
      have hϖ0 : 0 < v (ϖ : F) := by
        refine zero_lt_iff.2 fun h0 ↦ ?_
        rw [← hrz, map_mul, h0, mul_zero, ← not_le] at hlt
        exact hlt zero_le
      obtain ⟨j, hj, hjr⟩ := exists_pow_eq_of_lt hϖ n (z := r)
        (by
          rw [← hrz, map_mul, pow_succ] at hlt
          exact lt_of_mul_lt_mul_right' hlt)
        r.2
      exact ⟨j + 1, by lia, by rw [pow_succ, hjr, ← map_mul, hrz]⟩
    · exact ⟨0, by lia, by rw [pow_zero, hz]⟩

omit [DecidableEq F] [IsIntegral v.valuationSubring W] in
/-- When the maximal ideal of the valuation ring is generated by `ϖ ≠ 0`, there are exactly `n`
values of `v` in `(v ϖ ^ n, 1]`. -/
private theorem natCard_range_inter_Ioc_pow {ϖ : v.valuationSubring}
    (hϖ : maximalIdeal v.valuationSubring = Ideal.span {ϖ}) (hϖ0 : (ϖ : F) ≠ 0) (n : ℕ) :
    Nat.card ↥(Set.range v ∩ Set.Ioc (v (ϖ : F) ^ n) 1) = n := by
  have h0 : 0 < v (ϖ : F) := zero_lt_iff.2 ((map_ne_zero v).2 hϖ0)
  have h1 : v (ϖ : F) < 1 :=
    (Valuation.mem_maximalIdeal_iff (v := v)).1 (hϖ ▸ Ideal.mem_span_singleton_self ϖ)
  have hS : Set.range v ∩ Set.Ioc (v (ϖ : F) ^ n) 1 =
      (v (ϖ : F) ^ ·) '' (Finset.range n : Set ℕ) := by
    ext γ
    simp only [Set.mem_inter_iff, Set.mem_range, Set.mem_Ioc, Set.mem_image, Finset.coe_range,
      Set.mem_Iio]
    constructor
    · rintro ⟨⟨z, rfl⟩, hlt, hle⟩
      exact exists_pow_eq_of_lt hϖ n hlt hle
    · rintro ⟨j, hj, rfl⟩
      exact ⟨⟨_, map_pow v _ j⟩, pow_lt_pow_right_of_lt_one₀ h0 h1 hj, pow_le_one₀ zero_le h1.le⟩
  rw [Nat.card_coe_set_eq, hS, Set.ncard_image_of_injective _
    (pow_right_strictAnti₀ h0 h1).injective, Set.ncard_coe_finset, Finset.card_range]

/-- **The local index at split multiplicative reduction `Iₙ` is `n`.** Let `v` be a valuation on
`F` whose valuation ring is Henselian with maximal ideal generated by `ϖ`, and `W` an elliptic curve
over `F` with an integral model, centred at the singular point of its reduction so that
`a₃ = a₄ = 0`, with `b₂` a unit, `v a₆ = v ϖ ^ n` for some `n > 0`, and tangent quadratic
`T² + a₁ T - a₂` with a root `α` in the valuation ring. Then the points with nonsingular reduction
have index `[E(F) : E₀(F)] = n`. -/
theorem index_nonsingularReduction_eq_of_tangentQuadratic_root
    [HenselianLocalRing v.valuationSubring] [W.IsElliptic] (h₃ : W.a₃ = 0) (h₄ : W.a₄ = 0)
    (hb₂ : v W.b₂ = 1) {α : F} (hα : v α ≤ 1) (hαr : α ^ 2 + W.a₁ * α - W.a₂ = 0)
    {ϖ : v.valuationSubring} (hϖ : maximalIdeal v.valuationSubring = Ideal.span {ϖ}) {n : ℕ}
    (hn : 0 < n) (h₆ : v W.a₆ = v (ϖ : F) ^ n) : (W.nonsingularReduction v).index = n := by
  have hϖ0 : (ϖ : F) ≠ 0 := by
    rintro h0
    rw [h0, map_zero, zero_pow hn.ne'] at h₆
    exact (splitNodal_of_isRoot (v := v) h₃ h₄ (by rw [h₆]; exact zero_lt_one) hb₂ hα
      hαr).a₆_ne (v.zero_iff.1 h₆)
  have h1 : v (ϖ : F) < 1 :=
    (Valuation.mem_maximalIdeal_iff (v := v)).1 (hϖ ▸ Ideal.mem_span_singleton_self ϖ)
  rw [index_nonsingularReduction_eq_natCard_of_tangentQuadratic_root h₃ h₄
      (h₆ ▸ pow_lt_one₀ zero_le h1 hn.ne') hb₂ hα hαr, h₆,
    natCard_range_inter_Ioc_pow hϖ hϖ0]

end Index

