/-!
# The Weierstrass equation of the Tate coordinates

Let `K` be a complete non-archimedean normed field and `q ∈ Kˣ` with `‖q‖ < 1`. This file proves
that the Tate coordinates `X(u)` and `Y(u)` (`TauCeti.tateUniformizationX`,
`TauCeti.tateUniformizationY`) satisfy the equation `y² + x y = x³ + a₄(q) x + a₆(q)` of
`TauCeti.tateCurveAt q` at every `u ∈ Kˣ` outside `q^ℤ`, so that the descended coordinates of
every non-identity coset of `Kˣ ⧸ q^ℤ` satisfy that equation.

Both coordinates are invariant under `u ↦ q u`, so it suffices to treat the fundamental annulus
`‖q‖ < ‖u‖ ≤ 1`. On the strict annulus `‖q‖ < ‖u‖ < 1` the equation is
`TauCeti.equation_tateUniformizationX_tateUniformizationY`, obtained by evaluating the formal Tate
point of `ℤ⟦u⟧⟦v⟧` at `u` and `v = q / u`. That evaluation does not reach the unit circle
`‖u‖ = 1`, where the power series in `u` diverge. When the value group of `K` is generated by
`‖q‖`, for instance for `v(q) = 1` over a discretely valued field, the strict annulus is empty and
every `u` is a `q`-power translate of a point of the unit circle.

The unit circle is treated as follows. Multiplied by `(1 - u)²` and `(1 - u)³`, the formal
coordinates `x` and `y` become power series in `v` whose coefficients are polynomials in `u`: the
coefficient of `vᴺ` in `x` is `∑_{d ∣ N} d (uᴺ⁺ᵈ + uᴺ⁻ᵈ - 2uᴺ)` for `N ≥ 1`
(`TauCeti.coeff_tateFormalX_of_ne_zero`), and its constant coefficient is `u / (1 - u)²`
(`TauCeti.coeff_zero_tateFormalX_mul_one_sub_X_sq`). So the formal Tate equation multiplied by
`(1 - u)⁶` is an identity in `ℤ[u]⟦v⟧` (`TauCeti.tateClearedY_sq_add_mul_eq`). An integral
polynomial has norm at most one on the closed unit disc (`Polynomial.norm_aeval_le_one`), so
`ℤ[u]⟦v⟧` can be evaluated at `u` and `v = q / u` whenever `‖u‖ = 1`. With `v = q / u` the
coefficient of `qᴺ` in `x` becomes `∑_{d ∣ N} d (uᵈ + u⁻ᵈ - 2)`, and these Lambert series regroup
(`TauCeti.hasSum_sum_divisors_mul_pow`) into the bilateral series defining `X(u)`, and likewise for
`Y(u)`. Dividing by `(1 - u)⁶ ≠ 0` gives the equation.

## Main results

* `TauCeti.equation_tateUniformizationX_tateUniformizationY_of_norm_eq_one`: the Tate coordinates
  satisfy the Tate equation at every `u ≠ 1` on the unit circle.
* `TauCeti.equation_tateUniformizationX_tateUniformizationY_of_notMem_zpowers`: they satisfy it
  at every `u ∉ q^ℤ`.
* `TauCeti.equation_tateQuotientCoordinates`: the descended coordinates of every non-identity
  coset of `Kˣ ⧸ q^ℤ` satisfy the Tate equation.

## References

* J. H. Silverman, *Advanced Topics in the Arithmetic of Elliptic Curves*, GTM 151, §V.3.
* J. Tate, *A review of non-Archimedean elliptic functions*, in *Elliptic curves, modular forms,
  & Fermat's last theorem* (Hong Kong, 1993), International Press (1995), 162–184.
-/

public section

open PowerSeries ArithmeticFunction
open scoped ArithmeticFunction.sigma

namespace TauCeti

/-! ### Evaluation on the unit circle -/

variable {K : Type*} [NormedField K]

/-- Evaluated at `u` and multiplied by `(q / u)ᴺ`, the divisor sum
`∑_{d ∣ N} d (uᴺ⁺ᵈ + uᴺ⁻ᵈ - 2uᴺ)`, which `tateClearedX` multiplies by `(1 - u)²` to form its
coefficient of `vᴺ` for `N ≥ 1`, becomes `∑_{d ∣ N} d (uᵈ + u⁻ᵈ - 2) qᴺ`. -/
private theorem aeval_sum_divisors_X_mul_div_pow {q u : K} (hu₀ : u ≠ 0) (N : ℕ) :
    Polynomial.aeval u (∑ d ∈ N.divisors, (d : Polynomial ℤ) * (Polynomial.X ^ (N + d) +
        Polynomial.X ^ (N - d) - 2 * Polynomial.X ^ N)) * (q / u) ^ N =
      (∑ d ∈ N.divisors, (d : K) * u ^ d) * q ^ N +
        (∑ d ∈ N.divisors, (d : K) * u⁻¹ ^ d) * q ^ N - 2 * ((σ 1 N : K) * q ^ N) := by
  rw [sigma_one_apply]
  push_cast
  rw [map_sum, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul, Finset.mul_sum,
    ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun d hd ↦ ?_
  obtain ⟨e, rfl⟩ := Nat.exists_eq_add_of_le (Nat.divisor_le hd)
  simp only [map_mul, map_add, map_sub, map_pow, map_natCast, map_ofNat, Polynomial.aeval_X,
    Nat.add_sub_cancel_left, div_pow, inv_pow]
  field_simp
  ring

/-- Evaluated at `u` and multiplied by `(q / u)ᴺ`, the divisor sum
`∑_{d ∣ N} (d (d - 1) / 2 · uᴺ⁺ᵈ - d (d + 1) / 2 · uᴺ⁻ᵈ + d uᴺ)`, which `tateClearedY`
multiplies by `(1 - u)³` to form its coefficient of `vᴺ` for `N ≥ 1`, becomes
`∑_{d ∣ N} (d (d - 1) / 2 · uᵈ - d (d + 1) / 2 · u⁻ᵈ + d) qᴺ`. -/
private theorem aeval_sum_divisors_Y_mul_div_pow {q u : K} (hu₀ : u ≠ 0) (N : ℕ) :
    Polynomial.aeval u (∑ d ∈ N.divisors, ((d.choose 2 : Polynomial ℤ) * Polynomial.X ^ (N + d) -
        ((d + 1).choose 2 : Polynomial ℤ) * Polynomial.X ^ (N - d) +
          (d : Polynomial ℤ) * Polynomial.X ^ N)) * (q / u) ^ N =
      (∑ d ∈ N.divisors, (d.choose 2 : K) * u ^ d) * q ^ N +
        (∑ d ∈ N.divisors, -((d + 1).choose 2 : K) * u⁻¹ ^ d) * q ^ N + (σ 1 N : K) * q ^ N := by
  rw [sigma_one_apply]
  push_cast
  rw [map_sum, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun d hd ↦ ?_
  obtain ⟨e, rfl⟩ := Nat.exists_eq_add_of_le (Nat.divisor_le hd)
  simp only [map_mul, map_add, map_sub, map_pow, map_natCast, Polynomial.aeval_X,
    Nat.add_sub_cancel_left, div_pow, inv_pow]
  field_simp
  ring

variable [CompleteSpace K] [IsUltrametricDist K]

/-- Evaluation of `ℤ[u]⟦v⟧` at `u` in the closed unit disc and `v = w` in the open unit disc. -/
private noncomputable def circleEval (u : K) (hu : ‖u‖ ≤ 1) (w : K) (hw : ‖w‖ < 1) :
    (Polynomial ℤ)⟦X⟧ →+* K :=
  RingHom.evalBoundedSeries (Polynomial.aeval u).toRingHom ⟨1, fun p ↦ p.norm_aeval_le_one hu⟩ w hw

private theorem circleEval_C (u : K) (hu : ‖u‖ ≤ 1) (w : K) (hw : ‖w‖ < 1) (p : Polynomial ℤ) :
    circleEval u hu w hw (C p) = Polynomial.aeval u p :=
  RingHom.evalBoundedSeries_C _ _ w hw p

private theorem circleEval_mk (u : K) (hu : ‖u‖ ≤ 1) (w : K) (hw : ‖w‖ < 1)
    (c : ℕ → Polynomial ℤ) :
    circleEval u hu w hw (mk c) = ∑' N, Polynomial.aeval u (c N) * w ^ N := by
  rw [circleEval, RingHom.evalBoundedSeries_apply]
  simp

private theorem circleEval_tateClearedParamHom {q u : K} (hu : ‖u‖ ≤ 1) (hu₀ : u ≠ 0) (hq : ‖q‖ < 1)
    (hw : ‖q / u‖ < 1) (g : ℤ⟦X⟧) :
    circleEval u hu (q / u) hw (tateClearedParamHom g) = evalIntSeries q hq g := by
  rw [circleEval, RingHom.evalBoundedSeries_apply, evalIntSeries_apply]
  refine tsum_congr fun N ↦ ?_
  rw [coeff_tateClearedParamHom]
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_mul, map_pow, Polynomial.aeval_X,
    eq_intCast, map_intCast, div_pow]
  field_simp

/-- Regrouping `∑_N (∑_{d ∣ N} a(d) sᵈ) qᴺ` along `N = c d`, when the series `∑ a(m) rᵐ` has the
closed form `F r` on the open unit ball. -/
private theorem hasSum_sum_divisors_intCast_mul_pow (a : ℕ → ℤ) (F : K → K)
    (hF : ∀ r : K, ‖r‖ < 1 → ∑' m : ℕ, (a (m + 1) : K) * r ^ (m + 1) = F r) {s : K}
    (hs : ‖s‖ ≤ 1) {q : K} (hq : ‖q‖ < 1) :
    HasSum (fun N : ℕ ↦ (∑ d ∈ N.divisors, (a d : K) * s ^ d) * q ^ N)
      (∑' c : ℕ, F (q ^ (c + 1) * s)) := by
  have hg (d : ℕ) : ‖(a d : K) * s ^ d‖ ≤ 1 := by
    rw [norm_mul, norm_pow, ← one_mul 1]
    exact mul_le_mul (IsUltrametricDist.norm_intCast_le_one K _) (pow_le_one₀ (norm_nonneg _) hs)
      (by positivity) zero_le_one
  convert hasSum_sum_divisors_mul_pow hg hq using 1
  refine tsum_congr fun c ↦ ?_
  have hr : ‖q ^ (c + 1) * s‖ < 1 := by
    rw [norm_mul, norm_pow]
    exact (mul_le_of_le_one_right (by positivity) hs).trans_lt
      (pow_lt_one₀ (norm_nonneg _) hq (Nat.succ_ne_zero c))
  rw [← hF _ hr]
  refine tsum_congr fun m ↦ ?_
  rw [mul_pow, pow_mul]
  ring

/-- `tateClearedX` evaluated at `u` on the unit circle and `v = q / u` is `(1 - u)² X(u)`. -/
private theorem circleEval_tateClearedX {q u : Kˣ} (hq : ‖(q : K)‖ < 1) (hu : ‖(u : K)‖ = 1)
    (hu₁ : (u : K) ≠ 1) (hw : ‖(q : K) / u‖ < 1) :
    circleEval (u : K) hu.le ((q : K) / u) hw tateClearedX =
      (1 - u) ^ 2 * tateUniformizationX q u := by
  have hu₀ : (u : K) ≠ 0 := u.ne_zero
  have hui : ‖(u : K)⁻¹‖ ≤ 1 := by rw [norm_inv, hu, inv_one]
  have hF (r : K) (hr : ‖r‖ < 1) :
      ∑' m : ℕ, (((m + 1 : ℕ) : ℤ) : K) * r ^ (m + 1) = r / (1 - r) ^ 2 := by
    simpa only [Int.cast_natCast] using tsum_natCast_succ_mul_pow_succ r hr
  have hA := hasSum_sum_divisors_intCast_mul_pow (fun d ↦ (d : ℤ)) _ hF hu.le hq
  have hB := hasSum_sum_divisors_intCast_mul_pow (fun d ↦ (d : ℤ)) _ hF hui hq
  have hS := (summable_divisorSumSeries 1 hq).hasSum
  have hP := ((hA.add hB).sub (hS.mul_left 2)).congr_fun fun N ↦
    (aeval_sum_divisors_X_mul_div_pow hu₀ N).trans (by push_cast; rfl)
  rw [tateClearedX_def, map_add, map_mul, circleEval_C, circleEval_C, circleEval_mk, hP.tsum_eq,
    ← divisorSumAt_def]
  have h₁ : (1 : K) - u ≠ 0 := sub_ne_zero.mpr (Ne.symm hu₁)
  rw [tateUniformizationX_eq_tsum_nat q hq u]
  simp only [Polynomial.aeval_X, map_pow, map_sub, map_one]
  field_simp
  ring

/-- `tateClearedY` evaluated at `u` on the unit circle and `v = q / u` is `(1 - u)³ Y(u)`. -/
private theorem circleEval_tateClearedY {q u : Kˣ} (hq : ‖(q : K)‖ < 1) (hu : ‖(u : K)‖ = 1)
    (hu₁ : (u : K) ≠ 1) (hw : ‖(q : K) / u‖ < 1) :
    circleEval (u : K) hu.le ((q : K) / u) hw tateClearedY =
      (1 - u) ^ 3 * tateUniformizationY q u := by
  have hu₀ : (u : K) ≠ 0 := u.ne_zero
  have hui : ‖(u : K)⁻¹‖ ≤ 1 := by rw [norm_inv, hu, inv_one]
  have hF₁ (r : K) (hr : ‖r‖ < 1) :
      ∑' m : ℕ, ((((m + 1).choose 2 : ℕ) : ℤ) : K) * r ^ (m + 1) = r ^ 2 / (1 - r) ^ 3 := by
    simpa only [Int.cast_natCast] using tsum_choose_two_mul_pow_succ r hr
  have hF₂ (r : K) (hr : ‖r‖ < 1) :
      ∑' m : ℕ, ((-(m + 1 + 1).choose 2 : ℤ) : K) * r ^ (m + 1) = -r / (1 - r) ^ 3 := by
    simpa only [Int.cast_neg, Int.cast_natCast] using tsum_neg_choose_two_mul_pow_succ r hr
  have hA := hasSum_sum_divisors_intCast_mul_pow (fun d ↦ (d.choose 2 : ℤ)) _ hF₁ hu.le hq
  have hB := hasSum_sum_divisors_intCast_mul_pow (fun d ↦ -((d + 1).choose 2 : ℤ)) _ hF₂ hui hq
  have hS := (summable_divisorSumSeries 1 hq).hasSum
  have hP := ((hA.add hB).add hS).congr_fun fun N ↦
    (aeval_sum_divisors_Y_mul_div_pow hu₀ N).trans (by push_cast; rfl)
  rw [tateClearedY_def, map_add, map_mul, circleEval_C, circleEval_C, circleEval_mk, hP.tsum_eq,
    ← divisorSumAt_def]
  have h₁ : (1 : K) - u ≠ 0 := sub_ne_zero.mpr (Ne.symm hu₁)
  rw [tateUniformizationY_eq_tsum_nat q hq u]
  simp only [Polynomial.aeval_X, map_pow, map_sub, map_one]
  field_simp
  ring

/-- **The Tate coordinates satisfy the Tate equation on the unit circle.** For `‖q‖ < 1` and
`u ≠ 1` with `‖u‖ = 1`, the point `(X(u), Y(u))` lies on `tateCurveAt q`. No assumption on the
characteristic or discreteness of the norm is needed. -/
theorem equation_tateUniformizationX_tateUniformizationY_of_norm_eq_one (q u : Kˣ)
    (hq : ‖(q : K)‖ < 1) (hu : ‖(u : K)‖ = 1) (hu₁ : u ≠ 1) :
    (tateCurveAt q hq).toAffine.Equation (tateUniformizationX q u) (tateUniformizationY q u) := by
  have hu₁' : (u : K) ≠ 1 := fun h ↦ hu₁ (Units.val_eq_one.mp h)
  have hw : ‖(q : K) / u‖ < 1 := by rwa [norm_div, hu, div_one]
  have h := congrArg (circleEval (u : K) hu.le ((q : K) / u) hw) tateClearedY_sq_add_mul_eq
  simp only [map_add, map_mul, map_pow, circleEval_C, circleEval_tateClearedX hq hu hu₁' hw,
    circleEval_tateClearedY hq hu hu₁' hw, circleEval_tateClearedParamHom hu.le u.ne_zero hq hw,
    map_sub, map_one, Polynomial.aeval_X] at h
  rw [WeierstrassCurve.Affine.equation_iff, tateCurveAt_def]
  simp only [WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₂, WeierstrassCurve.map_a₃,
    WeierstrassCurve.map_a₄, WeierstrassCurve.map_a₆, tateCurve_a₁, tateCurve_a₂, tateCurve_a₃,
    map_one, _root_.map_zero]
  have h₆ : ((1 : K) - u) ^ 6 ≠ 0 := pow_ne_zero 6 (sub_ne_zero.mpr (Ne.symm hu₁'))
  refine mul_left_cancel₀ h₆ ?_
  linear_combination h

/-- **The Tate coordinates satisfy the Tate equation away from `q^ℤ`.** For `‖q‖ < 1` and every
`u ∈ Kˣ` outside `q^ℤ`, the point `(X(u), Y(u))` lies on `tateCurveAt q`. No assumption on the
characteristic or discreteness of the norm is needed. -/
theorem equation_tateUniformizationX_tateUniformizationY_of_notMem_zpowers (q u : Kˣ)
    (hq : ‖(q : K)‖ < 1) (hu : u ∉ Subgroup.zpowers q) :
    (tateCurveAt q hq).toAffine.Equation (tateUniformizationX q u) (tateUniformizationY q u) := by
  obtain ⟨n, ⟨h₁, h₂⟩, -⟩ := existsUnique_norm_zpow_mul_mem_Ioc q u hq
  rw [← tateUniformizationX_zpow_mul q u n, ← tateUniformizationY_zpow_mul q u n]
  rcases h₂.lt_or_eq with h₂ | h₂
  · exact equation_tateUniformizationX_tateUniformizationY q _ h₁ h₂
  · refine equation_tateUniformizationX_tateUniformizationY_of_norm_eq_one q _ hq h₂
      fun h ↦ hu (Subgroup.mem_zpowers_iff.mpr ⟨-n, ?_⟩)
    rw [zpow_neg, inv_eq_iff_eq_inv, eq_inv_of_mul_eq_one_left h]

/-- **The descended Tate coordinates satisfy the Tate equation.** For `‖q‖ < 1`, the coordinates
`tateQuotientCoordinates q x` of every coset `x ≠ 1` of `Kˣ ⧸ q^ℤ` satisfy the equation of
`tateCurveAt q`. -/
theorem equation_tateQuotientCoordinates (q : Kˣ) (hq : ‖(q : K)‖ < 1)
    {x : Kˣ ⧸ Subgroup.zpowers q} (hx : x ≠ 1) :
    (tateCurveAt q hq).toAffine.Equation (tateQuotientCoordinates q x).1
      (tateQuotientCoordinates q x).2 := by
  induction x using QuotientGroup.induction_on with
  | H u =>
    rw [tateQuotientCoordinates_mk]
    exact equation_tateUniformizationX_tateUniformizationY_of_notMem_zpowers q u hq
      fun h ↦ hx ((QuotientGroup.eq_one_iff u).mpr h)

end TauCeti
