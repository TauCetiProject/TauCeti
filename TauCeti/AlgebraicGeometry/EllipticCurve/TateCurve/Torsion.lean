/-!
# The torsion exact sequence of a Tate curve

The uniformization of `E_q` gives the exact sequence
`0 → ℤ → Lˣ → E_q(L) → 0`, with the first map sending `a` to `q^a`.
For `n ≠ 0`, applying multiplication by `n` gives

`0 → μ_n(L) → E_q(L)[n] → ℤ/nℤ → Lˣ/(Lˣ)^n`.

Here `ℤ/nℤ` and the power-class group use Mathlib's `QuotSMulTop`.
The exponent map sends the point represented by `u`, with `u^n = q^a`, to the class of `a`.
Its kernel is precisely the image of the roots of unity. It is surjective when `q` has an
`n`-th root in `L`; no closure or characteristic hypothesis is needed for these statements.
The exponent map is compatible with continuous `K`-algebra maps between complete normed
extensions, so continuous `K`-automorphisms of such extensions preserve exponent classes.
This is the finite-level description used to compute the Tate-module action at multiplicative
reduction.

## References

* J. H. Silverman, *Advanced Topics in the Arithmetic of Elliptic Curves*, V.3 and V.6.
-/

public section

namespace TauCeti

open Function WeierstrassCurve WeierstrassCurve.Affine

section Algebraic

variable {K : Type*} [CommRing K] (L : Type*) [CommRing L] [Algebra K L] (q : Kˣ)

/-- The period homomorphism sends an integer exponent `a` to the unit `q^a`. -/
def tatePeriodHom : ℤ →ₗ[ℤ] Additive Lˣ :=
  (zmultiplesHom (Additive Lˣ)
    (Additive.ofMul (Units.map (algebraMap K L : K →* L) q))).toIntLinearMap

/-- Evaluation of the period homomorphism. -/
@[simp]
theorem tatePeriodHom_apply (a : ℤ) :
    tatePeriodHom L q a =
      Additive.ofMul (Units.map (algebraMap K L : K →* L) q ^ a) := by
  simp [tatePeriodHom, ← ofMul_zpow]

/-- The map from exponent classes to power classes sends `[a]` to `[q^a]`. -/
noncomputable def tatePeriodClass (n : ℕ) : QuotSMulTop (n : ℤ) ℤ →ₗ[ℤ]
    QuotSMulTop (n : ℤ) (Additive Lˣ) :=
  QuotSMulTop.map (n : ℤ) (tatePeriodHom L q)

/-- The characteristic formula for the period power class. -/
@[simp]
theorem tatePeriodClass_intCast (n : ℕ) (a : ℤ) :
    tatePeriodClass L q n (a : QuotSMulTop (n : ℤ) ℤ) =
      Submodule.Quotient.mk (Additive.ofMul (Units.map (algebraMap K L : K →* L) q ^ a)) := by
  -- Keep the cast in simp normal form; the map API evaluates on the quotient projection.
  change tatePeriodClass L q n (Submodule.Quotient.mk a) = _
  rw [tatePeriodClass, QuotSMulTop.map_apply_mk, tatePeriodHom_apply]

end Algebraic

variable {K : Type*} [NormedField K] [CompleteSpace K] [IsUltrametricDist K]
  (L : Type*) [NormedField L] [NormedAlgebra K L] [CompleteSpace L]
  [IsUltrametricDist L] [DecidableEq L] (q : Kˣ) (hq : ‖(q : K)‖ < 1)

/-- The Tate uniformization on unit representatives over an extension of the ground field. -/
noncomputable def tateUnitHom : Additive Lˣ →+ ((tateCurveAt q hq)⁄L).toAffine.Point :=
  (tateUniformizationBaseChangeHom L q hq).comp
    (QuotientGroup.mk' (Subgroup.zpowers (Units.map (algebraMap K L : K →* L) q))).toAdditive

/-- The unit-representative homomorphism is the existing Tate uniformization. -/
@[simp]
theorem tateUnitHom_ofMul (u : Lˣ) :
    tateUnitHom L q hq (Additive.ofMul u) =
      tateUniformizationBaseChange L q hq (u : Lˣ ⧸
        Subgroup.zpowers (Units.map (algebraMap K L : K →* L) q)) := by
  simp [tateUnitHom]

omit [CompleteSpace K] [IsUltrametricDist K] [CompleteSpace L] [IsUltrametricDist L]
  [DecidableEq L] in
include hq in
/-- The period has infinite order, so its integer-power homomorphism is injective. -/
theorem tatePeriodHom_injective : Injective (tatePeriodHom L q) := by
  have hq' : ¬ IsOfFinOrder (Units.map (algebraMap K L : K →* L) q) := by
    intro h
    have hnorm := ((Units.coeHom L).isOfFinOrder h).norm_eq_one
    exact (by simpa using hq : ‖((Units.map (algebraMap K L : K →* L) q : Lˣ) : L)‖ < 1).ne hnorm
  exact fun a b h ↦ (injective_zpow_iff_not_isOfFinOrder.mpr hq')
    (congrArg Additive.toMul h)

/-- The kernel on unit representatives is precisely the subgroup generated by the period. -/
@[simp]
theorem tateUnitHom_eq_zero_iff (u : Additive Lˣ) :
    tateUnitHom L q hq u = 0 ↔
      u.toMul ∈ Subgroup.zpowers (Units.map (algebraMap K L : K →* L) q) := by
  obtain ⟨u, rfl⟩ := Additive.ofMul.surjective u
  simp

/-- The period homomorphism and Tate uniformization on units form an exact sequence. -/
theorem exact_tatePeriodHom_tateUnitHom :
    Exact (tatePeriodHom L q) (tateUnitHom L q hq).toIntLinearMap := by
  intro u
  obtain ⟨u, rfl⟩ := Additive.ofMul.surjective u
  simp [Subgroup.mem_zpowers_iff, tatePeriodHom, ← ofMul_zpow]

/-- Every point of a Tate curve over a complete normed extension has a unit representative. -/
theorem tateUnitHom_surjective : Surjective (tateUnitHom L q hq) := by
  intro P
  obtain ⟨x, rfl⟩ := tateUniformizationBaseChange_surjective L q hq P
  obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective x
  exact ⟨.ofMul u, tateUnitHom_ofMul L q hq u⟩

variable (n : ℕ)

/-- The exponent of a Tate-curve torsion point, modulo `n`: if `u^n = q^a`, the point
represented by `u` maps to `[a] ∈ ℤ/nℤ`. -/
noncomputable def tateTorsionExponent :
    Submodule.torsionBy ℤ (((tateCurveAt q hq)⁄L).toAffine.Point) (n : ℤ) →ₗ[ℤ]
      QuotSMulTop (n : ℤ) ℤ :=
  torsionByδ (n : ℤ) (exact_tatePeriodHom_tateUnitHom L q hq)
    (tatePeriodHom_injective L q hq) (tateUnitHom_surjective L q hq)

/-- The exponent map evaluated on a unit representative. -/
theorem tateTorsionExponent_eq
    (P : Submodule.torsionBy ℤ (((tateCurveAt q hq)⁄L).toAffine.Point) (n : ℤ))
    (u : Lˣ) (hu : tateUnitHom L q hq (.ofMul u) = P) (a : ℤ)
    (ha : u ^ n = Units.map (algebraMap K L : K →* L) q ^ a) :
    tateTorsionExponent L q hq n P = (a : QuotSMulTop (n : ℤ) ℤ) := by
  rw [tateTorsionExponent]
  apply torsionByδ_eq _ _ _ P hu
  exact Additive.toMul.injective (by simpa [tatePeriodHom] using ha.symm)

/-- Roots of unity define Tate-curve torsion points through uniformization. -/
noncomputable def tateRootsOfUnityHom : Additive (rootsOfUnity n L) →+
    Submodule.torsionBy ℤ (((tateCurveAt q hq)⁄L).toAffine.Point) (n : ℤ) :=
  (torsionByMap (n : ℤ) (tateUnitHom L q hq).toIntLinearMap).toAddMonoidHom.comp
    (torsionByUnitsEquivRootsOfUnity n).symm.toAddMonoidHom

/-- The roots-of-unity inclusion sends `ζ` to the point with parameter `ζ`. -/
@[simp]
theorem coe_tateRootsOfUnityHom (ζ : Additive (rootsOfUnity n L)) :
    (tateRootsOfUnityHom L q hq n ζ : ((tateCurveAt q hq)⁄L).toAffine.Point) =
      tateUnitHom L q hq (.ofMul (ζ.toMul : Lˣ)) := by
  simp [tateRootsOfUnityHom]

/-- For `n ≠ 0`, roots of unity inject into the `n`-torsion of the Tate curve. -/
theorem tateRootsOfUnityHom_injective (hn : n ≠ 0) :
    Injective (tateRootsOfUnityHom L q hq n) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro ζ hζ
  obtain ⟨a, ha⟩ := (exact_torsionByMap (r := (n : ℤ))
    (exact_tatePeriodHom_tateUnitHom L q hq) (tatePeriodHom_injective L q hq) _).mp hζ
  have ha0 : a = 0 := Subtype.ext <|
    (mul_eq_zero.mp ((Submodule.mem_torsionBy_iff _ _).mp a.2)).resolve_left
      (Int.natCast_ne_zero.mpr hn)
  apply (torsionByUnitsEquivRootsOfUnity n).symm.injective
  simpa [ha0] using ha.symm

/-- The kernel of the Tate exponent map is exactly the roots-of-unity image. -/
theorem exact_tateRootsOfUnityHom_tateTorsionExponent :
    Exact (tateRootsOfUnityHom L q hq n) (tateTorsionExponent L q hq n) := by
  intro P
  rw [tateTorsionExponent]
  constructor
  · intro hP
    obtain ⟨u, hu⟩ := (exact_torsionByMap_torsionByδ
      (exact_tatePeriodHom_tateUnitHom L q hq) (tatePeriodHom_injective L q hq)
      (tateUnitHom_surjective L q hq) P).mp hP
    exact ⟨torsionByUnitsEquivRootsOfUnity n u, by simpa [tateRootsOfUnityHom] using hu⟩
  · rintro ⟨ζ, rfl⟩
    exact (exact_torsionByMap_torsionByδ (exact_tatePeriodHom_tateUnitHom L q hq)
      (tatePeriodHom_injective L q hq) (tateUnitHom_surjective L q hq)).apply_apply_eq_zero _

/-- Roots of unity have zero exponent class. -/
@[simp]
theorem tateTorsionExponent_tateRootsOfUnityHom (ζ : Additive (rootsOfUnity n L)) :
    tateTorsionExponent L q hq n (tateRootsOfUnityHom L q hq n ζ) = 0 :=
  (exact_tateRootsOfUnityHom_tateTorsionExponent L q hq n).apply_apply_eq_zero ζ

/-- Exponent classes arising from Tate torsion are exactly those whose period power is an
`n`-th power. This retains the rational obstruction when the field lacks a root of `q`. -/
theorem exact_tateTorsionExponent_tatePeriodClass :
    Exact (tateTorsionExponent L q hq n) (tatePeriodClass L q n) :=
  exact_torsionByδ_quotSMulTop_map (exact_tatePeriodHom_tateUnitHom L q hq)
    (tatePeriodHom_injective L q hq) (tateUnitHom_surjective L q hq)

/-- If `q` has an `n`-th root in the extension, every exponent class occurs. -/
theorem tateTorsionExponent_surjective
    (u : Lˣ) (hu : u ^ n = Units.map (algebraMap K L : K →* L) q) :
    Surjective (tateTorsionExponent L q hq n) := by
  intro x
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  have ha : (u ^ a) ^ n = Units.map (algebraMap K L : K →* L) q ^ a := by
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hu]
  apply (exact_tateTorsionExponent_tatePeriodClass L q hq n _).mp
  rw [tatePeriodClass, QuotSMulTop.map_apply_mk, tatePeriodHom_apply,
    Submodule.Quotient.mk_eq_zero, ← ha]
  simpa using Submodule.smul_mem_pointwise_smul
    (Additive.ofMul (u ^ a)) (n : ℤ) (⊤ : Submodule ℤ (Additive Lˣ)) trivial

/-- The exponent map is onto exactly when the period has an `n`-th root in the extension. -/
theorem tateTorsionExponent_surjective_iff :
    Surjective (tateTorsionExponent L q hq n) ↔
      ∃ u : Lˣ, u ^ n = Units.map (algebraMap K L : K →* L) q := by
  constructor
  · intro h
    obtain ⟨P, hP⟩ := h (Submodule.Quotient.mk (1 : ℤ))
    have hz := (exact_tateTorsionExponent_tatePeriodClass L q hq n).apply_apply_eq_zero P
    rw [hP, tatePeriodClass, QuotSMulTop.map_apply_mk] at hz
    simp only [tatePeriodHom_apply, zpow_one, Submodule.Quotient.mk_eq_zero] at hz
    obtain ⟨u, -, hu⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hz
    exact ⟨u.toMul, by simpa using congrArg Additive.toMul hu⟩
  · rintro ⟨u, hu⟩
    exact tateTorsionExponent_surjective L q hq n u hu

section Naturality

variable {L} {M : Type*} [NormedField M] [NormedAlgebra K M] [CompleteSpace M]
  [IsUltrametricDist M] [DecidableEq M] (ι : L →ₐ[K] M) (hι : Continuous ι)

include hι

/-- Tate uniformization on unit representatives commutes with continuous maps of extensions. -/
theorem map_tateUnitHom (u : Lˣ) :
    Point.map ι (tateUnitHom L q hq (.ofMul u)) =
      tateUnitHom M q hq (.ofMul (Units.map (ι : L →* M) u)) := by
  simp [map_tateUniformizationBaseChange q hq ι hι]

/-- The exponent class is unchanged by a continuous map of complete normed extensions.
In particular, continuous `K`-automorphisms of a complete normed extension preserve exponent
classes. -/
theorem tateTorsionExponent_torsionByMap
    (P : Submodule.torsionBy ℤ (((tateCurveAt q hq)⁄L).toAffine.Point) (n : ℤ)) :
    tateTorsionExponent M q hq n (torsionByMap (n : ℤ) (Point.map ι).toIntLinearMap P) =
      tateTorsionExponent L q hq n P := by
  let β : Additive Lˣ →ₗ[ℤ] Additive Mˣ :=
    (Units.map (ι : L →* M)).toAdditive.toIntLinearMap
  have hαβ : β ∘ₗ tatePeriodHom L q = tatePeriodHom M q ∘ₗ LinearMap.id := by
    ext
    simp [β, tatePeriodHom]
  have hβγ : (Point.map ι).toIntLinearMap ∘ₗ (tateUnitHom L q hq).toIntLinearMap =
      (tateUnitHom M q hq).toIntLinearMap ∘ₗ β := by
    ext u
    obtain ⟨u, rfl⟩ := Additive.ofMul.surjective u
    exact map_tateUnitHom q hq ι hι u
  have h := torsionByδ_comp_torsionByMap (r := (n : ℤ))
    (exact_tatePeriodHom_tateUnitHom L q hq) (tatePeriodHom_injective L q hq)
    (tateUnitHom_surjective L q hq) (exact_tatePeriodHom_tateUnitHom M q hq)
    (tatePeriodHom_injective M q hq) (tateUnitHom_surjective M q hq) hαβ hβγ
  simpa [tateTorsionExponent] using LinearMap.congr_fun h P

end Naturality

end TauCeti

