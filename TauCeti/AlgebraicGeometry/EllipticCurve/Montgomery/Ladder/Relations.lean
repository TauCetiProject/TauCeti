module

public import TauCeti.AlgebraicGeometry.EllipticCurve.Montgomery.Double
public import TauCeti.AlgebraicGeometry.EllipticCurve.Montgomery.DiffAdd
public import Mathlib.Data.Nat.BinaryRec

/-!
# The binary Montgomery-ladder invariant

`LadderRel N D S n R T` is the relation generated by the two binary Montgomery-ladder
steps, starting with infinity and the raw pair `S`. It records consecutive multiples:
`LadderRel.coordinates` proves that `R` and `T` are nonzero representatives of `[n]P`
and `[n + 1]P` when `S` represents `P`, provided `P` is neither infinity nor the
distinguished point of order two. The relation is defined over any commutative ring;
its geometric interpretation is over a field of characteristic different from two.

This is a relation between polynomial coordinate expressions, not a scalar-multiplication
implementation. `LadderRel.exists_pairs` shows that every natural index is reached. Leading
zero bits are allowed, so correctness applies to every derivation, not just a canonical
binary expansion. No ellipticity hypothesis is needed.

## References

* P. L. Montgomery, *Speeding the Pollard and elliptic curve methods of factorization*,
  Math. Comp. 48 (1987), 243–264, §10.3.1, p. 261: the binary ladder relations.
-/

public section

namespace TauCeti.Montgomery

/-- The relation generated by binary Montgomery-ladder steps. A false bit sends consecutive
indices `(n, n + 1)` to `(2n, 2n + 1)`, and a true bit sends them to `(2n + 1, 2n + 2)`.
The raw output pairs are not required to be nonzero in the definition. -/
inductive LadderRel {R : Type*} [CommRing R] (N D : R) (S : Pair R) :
    ℕ → Pair R → Pair R → Prop
  | zero : LadderRel N D S 0 ⟨1, 0⟩ S
  | bit {n : ℕ} {U V : Pair R} (b : Bool) (h : LadderRel N D S n U V) :
      LadderRel N D S (2 * n + b.toNat)
        (if b then diffAdd V U S else double N D U)
        (if b then double N D V else diffAdd V U S)

namespace LadderRel

variable {R : Type*} [CommRing R] {N D : R} {S : Pair R}

/-- Every natural index admits a derivation of the binary ladder relation, even when
some raw outputs vanish. -/
theorem exists_pairs (N D : R) (S : Pair R) (n : ℕ) : ∃ U V, LadderRel N D S n U V := by
  induction n using Nat.binaryRec with
  | zero => exact ⟨_, _, .zero⟩
  | bit b n ih =>
    obtain ⟨U, V, h⟩ := ih
    refine ⟨if b then diffAdd V U S else double N D U,
      if b then double N D V else diffAdd V U S, ?_⟩
    simpa only [Nat.bit_val] using h.bit b

section Field

variable {K : Type*} [Field K] [DecidableEq K] {A B N D : K} {S U V : Pair K} {n : ℕ}

/-- **The binary ladder invariant.** Every derivation from a nonzero representative of `P`
produces nonzero representatives of the consecutive multiples `[n]P` and `[n + 1]P`.
The exclusions on `P` are exactly those required by differential addition; they do not
exclude the other points of order two or scalar multiples that reach infinity. -/
theorem coordinates (h : LadderRel N D S n U V) (h₂ : (2 : K) ≠ 0) (hB : B ≠ 0)
    (hD : D ≠ 0) (hND : 4 * N = (A + 2) * D) {P : (model A B).toAffine.Point}
    (hS : S ≠ 0) (hSP : S.cross (Montgomery.coordinates A B P) = 0)
    (hP : P ≠ 0) (hPT : P ≠ twoTorsionPoint A hB) :
    U ≠ 0 ∧ U.cross (Montgomery.coordinates A B (n • P)) = 0 ∧
      V ≠ 0 ∧ V.cross (Montgomery.coordinates A B ((n + 1) • P)) = 0 := by
  induction h with
  | zero =>
    simp only [zero_nsmul, Nat.zero_add, one_nsmul, Montgomery.coordinates_zero]
    exact ⟨by simp [Pair.ne_zero_iff], by simp, hS, hSP⟩
  | @bit n U V b h ih =>
    obtain ⟨hU, hUP, hV, hVP⟩ := ih
    have hsub : (n + 1) • P - n • P = P := by simp [succ_nsmul]
    have hsum : (n + 1) • P + n • P = (2 * n + 1) • P := by
      simp [add_nsmul, two_mul, add_assoc, add_comm, add_left_comm]
    have hdiff := diffAdd_cross_eq_zero_of_cross_eq_zero hB hVP hUP
      (by simpa only [hsub] using hSP)
    have hne := (diffAdd_ne_zero_iff_of_cross_eq_zero h₂ hB hV hU hS hVP hUP
      (by simpa only [hsub] using hSP)).mpr (by simpa only [hsub] using And.intro hP hPT)
    have hdoubleU := double_coordinates_of_cross_eq_zero hB hD hND hU hUP
    have hdoubleV := double_coordinates_of_cross_eq_zero hB hD hND hV hVP
    rw [hsum] at hdiff
    cases b <;> simp only [Bool.toNat_false, Bool.toNat_true, Bool.false_eq_true,
      ↓reduceIte, Nat.add_zero]
    · refine ⟨hdoubleU.1, ?_, hne, hdiff⟩
      simpa only [mul_nsmul, two_nsmul, nsmul_add] using hdoubleU.2
    · refine ⟨hne, hdiff, hdoubleV.1, ?_⟩
      have hsucc : 2 * n + 1 + 1 = 2 * (n + 1) := by omega
      simpa only [hsucc, mul_nsmul, two_nsmul, nsmul_add] using hdoubleV.2

end Field

end LadderRel

end TauCeti.Montgomery
