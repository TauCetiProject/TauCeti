module

public import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.Hom.Ring
public import TauCeti.AlgebraicGeometry.EllipticCurve.Supersingular
-- Proof-only: a nonzero point of order `p` generates `E[p]`.
import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.RelativeFrobenius.Supersingular
-- Proof-only: a cyclic `p`-torsion makes every `p ^ (k + 1)`-torsion cyclic.
import TauCeti.Algebra.Module.Torsion.Basic

/-!
# The endomorphism ring of an ordinary elliptic curve is commutative

Let `W` be an elliptic curve over a field `F` of characteristic `p > 0`. If `W` is ordinary, then
its endomorphism ring `Hom W W` is commutative (Silverman V.3.1 and III.9.4). This rules out a
quaternion order, so the endomorphism ring of an ordinary curve is `ℤ` or an order in an imaginary
quadratic field. Over a finite field it is the latter
(`WeierstrassCurve.finrank_hom_of_isOrdinary`).

The proof reads the endomorphisms on the `p`-power torsion over an algebraic closure `Ω` of `F`.
Endomorphisms over `F` embed into those over `Ω` by base change, and `W` stays ordinary there.

* Since `W` is ordinary, `W(Ω)` has a nonzero point `Q` with `p • Q = 0`. The `p`-torsion has at
  most `p` points, so it is the cyclic group generated by `Q`
  (`WeierstrassCurve.torsionBy_eq_zmultiples`).
* Over the algebraically closed field `Ω`, the nonzero endomorphism `[p ^ k]` is surjective on
  points (`TauCeti.Isogeny.Hom.pointMap_surjective`), so `Q = p ^ k • y` for some point `y`. The
  `p ^ (k + 1)`-torsion is then the cyclic group generated by `y`
  (`AddSubgroup.torsionBy_pow_succ_le_zmultiples`).
* Every endomorphism maps the `p ^ (k + 1)`-torsion to itself, so it acts on the cyclic group
  generated by `y` as multiplication by an integer. Two endomorphisms therefore commute on `y`.
* The points `y` obtained for the various `k` are pairwise distinct, having distinct orders
  `p ^ (k + 1)`. So `f ∘ g` and `g ∘ f` agree on infinitely many points, and they are equal by
  rigidity (`TauCeti.Isogeny.Hom.eq_of_infinite_setOf_pointMap_eq`).

The hypothesis is necessary: the endomorphism ring of a supersingular curve over an algebraically
closed field is a maximal order in a quaternion algebra, which is not commutative.

## Main results

* `WeierstrassCurve.mul_comm_of_isOrdinary`: the endomorphisms of an ordinary elliptic curve
  commute.
* `TauCeti.OrdinaryEnd`: the ordinary endomorphism ring with its commutative ring structure.
* `TauCeti.OrdinaryEnd.ringEquiv`: its identification with the original endomorphisms.

## References

* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], III.6.4, III.9.4 and V.3.1.
-/

public section

open TauCeti.Isogeny WeierstrassCurve.Affine

namespace WeierstrassCurve

variable {F : Type*} [Field F] {p : ℕ} [ExpChar F p] {W : WeierstrassCurve F} [W.IsElliptic]

open scoped Classical in
/-- Over an algebraically closed field, the endomorphisms of an elliptic curve with a nonzero point
of order dividing the characteristic `p` commute: they act on the cyclic `p`-power torsion by
integers, and that torsion is infinite. -/
private theorem mul_comm_of_nsmul_eq_zero [IsAlgClosed F] {Q : W.toAffine.Point}
    (hQ : p • Q = 0) (hQ₀ : Q ≠ 0) (f g : Hom W.toAffine W.toAffine) : f * g = g * f := by
  have mem {m : ℤ} {z : W.toAffine.Point} : z ∈ AddSubgroup.torsionBy _ m ↔ m • z = 0 :=
    Submodule.mem_torsionBy_iff m z
  -- the `p`-torsion is generated by `Q`
  have hcyc := (torsionBy_eq_zmultiples p W hQ hQ₀).le
  -- choose `y k` with `p ^ k • y k = Q`, by surjectivity of `[p ^ k]` on points
  have hdiv (k : ℕ) : ∃ y : W.toAffine.Point, p ^ k • y = Q := by
    have hne : ((p ^ k : ℕ) : Hom W.toAffine W.toAffine) ≠ 0 :=
      Nat.cast_ne_zero.2 (pow_ne_zero k (expChar_ne_zero F p))
    obtain ⟨y, hy⟩ := Hom.pointMap_surjective hne Q
    exact ⟨y, by rwa [← nsmul_one, Hom.nsmul_pointMap, Hom.one_def, Hom.id_pointMap] at hy⟩
  choose y hy using hdiv
  have hy' (k : ℕ) : (p : ℤ) ^ k • y k = Q := by rw [← Nat.cast_pow, natCast_zsmul, hy k]
  -- every endomorphism maps `y k` into the cyclic `p ^ (k + 1)`-torsion generated by `y k`
  have hmul (h : Hom W.toAffine W.toAffine) (k : ℕ) :
      ∃ a : ℤ, h.pointMap (y k) = a • y k := by
    have hle := AddSubgroup.torsionBy_pow_succ_le_zmultiples (n := p) (y := y k) (k := k)
      (by rwa [hy' k])
    obtain ⟨a, ha⟩ := hle (mem.2 (by
      rw [← Hom.pointMap_zsmul h, pow_succ', mul_smul, hy' k, natCast_zsmul, hQ,
        Hom.pointMap_zero]))
    exact ⟨a, ha.symm⟩
  -- so `f ∘ g` and `g ∘ f` agree at every `y k`
  have hcomm (k : ℕ) : (f * g).pointMap (y k) = (g * f).pointMap (y k) := by
    obtain ⟨a, ha⟩ := hmul f k
    obtain ⟨b, hb⟩ := hmul g k
    rw [Hom.mul_def, Hom.mul_def, Hom.comp_pointMap, Hom.comp_pointMap, ha, hb,
      Hom.pointMap_zsmul, Hom.pointMap_zsmul, ha, hb, smul_smul, smul_smul, mul_comm]
  -- the `y k` are pairwise distinct: `p ^ k • y k = Q ≠ 0`, while `p ^ k • y j = 0` for `j < k`
  have hkill {j k : ℕ} (hjk : j < k) : p ^ k • y j = 0 := by
    rw [← Nat.sub_add_cancel hjk, pow_add, mul_smul, pow_succ', mul_smul, hy j, hQ, smul_zero]
  have hinj : Function.Injective y := by
    intro j k hjk
    by_contra hne
    rcases Nat.lt_or_gt_of_ne hne with hlt | hlt
    · exact hQ₀ (by rw [← hy k, ← hjk, hkill hlt])
    · exact hQ₀ (by rw [← hy j, hjk, hkill hlt])
  exact Hom.eq_of_infinite_setOf_pointMap_eq
    (Set.infinite_of_injective_forall_mem hinj hcomm)

/-- **The endomorphism ring of an ordinary elliptic curve is commutative** (Silverman V.3.1,
III.9.4). An ordinary curve over a field of characteristic `p > 0` has nonzero points of order `p`
over an algebraic closure; its endomorphisms act on the `p`-power torsion there, which is cyclic
and infinite, by integers. In characteristic zero no curve is ordinary at `p = 1`, and the
statement is vacuous. -/
theorem mul_comm_of_isOrdinary (hW : W.IsOrdinary p) (f g : Hom W.toAffine W.toAffine) :
    f * g = g * f := by
  classical
  let Ω := AlgebraicClosure F
  have : (W.baseChange Ω).IsElliptic := inferInstanceAs (W.map _).IsElliptic
  have : ExpChar Ω p := expChar_of_injective_algebraMap (algebraMap F Ω).injective p
  obtain ⟨Q, hQ, hQ₀⟩ := isOrdinary_iff_exists.1 hW
  -- compare both sides after base change to `Ω`, which is faithful on endomorphisms
  rw [← Hom.map_inj (algebraMap F Ω), ← Hom.mapRingHom_apply, ← Hom.mapRingHom_apply, map_mul,
    map_mul]
  exact mul_comm_of_nsmul_eq_zero (W := W.baseChange Ω) hQ hQ₀ _ _

end WeierstrassCurve

noncomputable section

namespace TauCeti

variable {F : Type*} [Field F] {p : ℕ} [ExpChar F p]
variable {W : WeierstrassCurve F} [W.IsElliptic]

/-- The endomorphism ring of an ordinary elliptic curve, with its commutative ring structure.
The type synonym keeps this structure separate from general, possibly noncommutative,
endomorphism rings. -/
def OrdinaryEnd (_hW : W.IsOrdinary p) : Type _ := Hom W.toAffine W.toAffine

namespace OrdinaryEnd

variable (hW : W.IsOrdinary p)

instance : CommRing (OrdinaryEnd hW) where
  toRing := inferInstanceAs (Ring (Hom W.toAffine W.toAffine))
  mul_comm := by
    dsimp only [OrdinaryEnd]
    exact WeierstrassCurve.mul_comm_of_isOrdinary hW

instance : IsDomain (OrdinaryEnd hW) :=
  inferInstanceAs (IsDomain (Hom W.toAffine W.toAffine))

instance : CharZero (OrdinaryEnd hW) :=
  inferInstanceAs (CharZero (Hom W.toAffine W.toAffine))

/-- The ordinary commutative ring has exactly the original endomorphisms and operations. -/
def ringEquiv : OrdinaryEnd hW ≃+* Hom W.toAffine W.toAffine := RingEquiv.refl _

end OrdinaryEnd

end TauCeti

end
