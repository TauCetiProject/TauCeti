module

public import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.Frobenius.Basic
public import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.Hom.Add

/-!
# Frobenius and composition of isogenies

Over a finite field, the Frobenius commutes with every isogeny because every function-field
homomorphism commutes with raising to the cardinality of the ground field. Its action by
composition on the additive group of morphisms is additive. This is the Frobenius-specific
distributivity needed to calculate in the subgroup generated by the identity and Frobenius.
Composition with Frobenius is also injective on morphisms.

## Main results

* `TauCeti.Isogeny.frobeniusIsogeny_comp`: Frobenius commutes with an isogeny.
* `TauCeti.Isogeny.Hom.frobenius_comp`: Frobenius is central in the endomorphism carrier.
* `TauCeti.Isogeny.Hom.frobenius_pow_comp`: so is every power of Frobenius.
* `TauCeti.Isogeny.Hom.frobenius_comp_add`: composition by Frobenius preserves addition.
* `TauCeti.Isogeny.Hom.frobenius_comp_injective` and
  `TauCeti.Isogeny.Hom.frobenius_comp_inj`: composition with Frobenius cancels.

## References

* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], V.1–2.
-/

public section

namespace TauCeti.Isogeny

open WeierstrassCurve.Affine

variable {F : Type*} [Field F] [Finite F]
  {W : WeierstrassCurve.Affine F} [W.IsElliptic] {W₁ W₂ : WeierstrassCurve.Affine F}

/-- Frobenius commutes with an isogeny defined over the finite ground field. -/
theorem frobeniusIsogeny_comp (φ : Isogeny W₁ W₂) :
    (frobeniusIsogeny W₂).comp φ = φ.comp (frobeniusIsogeny W₁) := by
  apply Isogeny.ext
  apply AlgHom.ext
  intro x
  have h := congrArg
    (fun σ : W₂.FunctionField →ₐ[F] W₁.FunctionField ↦
      σ (algebraMap W₂.CoordinateRing W₂.FunctionField x))
    (AlgHom.comp_fieldPullback_frobeniusIsogeny φ.fieldPullback)
  simpa only [comp_pullback, AlgHom.comp_apply, fieldPullback_algebraMap] using h

namespace Hom

variable [W₂.IsElliptic]

omit [W₂.IsElliptic] in
/-- Frobenius commutes with every morphism, including the zero morphism. -/
theorem frobenius_comp (f : Hom W₁ W₂) :
    (ofIsogeny (frobeniusIsogeny W₂)).comp f =
      f.comp (ofIsogeny (frobeniusIsogeny W₁)) := by
  rcases f.eq_zero_or_exists_ofIsogeny with rfl | ⟨φ, rfl⟩
  · simp
  · rw [ofIsogeny_comp_ofIsogeny, ofIsogeny_comp_ofIsogeny, frobeniusIsogeny_comp]

omit [W₂.IsElliptic] in
/-- Every power of Frobenius commutes with every morphism, including the zero morphism. -/
theorem frobenius_pow_comp (f : Hom W₁ W₂) (n : ℕ) :
    (ofIsogeny (frobeniusIsogeny W₂) ^ n).comp f =
      f.comp (ofIsogeny (frobeniusIsogeny W₁) ^ n) := by
  induction n with
  | zero => rw [pow_zero, pow_zero, one_def, one_def, id_comp, comp_id]
  | succ n ih =>
    rw [pow_succ, pow_succ, mul_def, mul_def, comp_assoc, frobenius_comp, ← comp_assoc, ih,
      comp_assoc]

/-- Frobenius preserves sums of morphisms under composition. -/
@[simp]
theorem frobenius_comp_add (f g : Hom W₁ W₂) :
    (ofIsogeny (frobeniusIsogeny W₂)).comp (f + g) =
      (ofIsogeny (frobeniusIsogeny W₂)).comp f +
        (ofIsogeny (frobeniusIsogeny W₂)).comp g := by
  rw [frobenius_comp, add_comp, ← frobenius_comp, ← frobenius_comp]

omit [W.IsElliptic] in
/-- **Composition with Frobenius cancels**: `f ↦ π ∘ f` is injective on morphisms. -/
theorem frobenius_comp_injective :
    Function.Injective fun f : Hom W₁ W ↦ (ofIsogeny (frobeniusIsogeny W)).comp f := by
  intro f g h
  simp only at h
  rw [frobenius_comp, frobenius_comp] at h
  -- a composite vanishes only when a factor does, and nonzero morphisms are isogenies
  rcases f.eq_zero_or_exists_ofIsogeny with rfl | ⟨φ, rfl⟩
  · rw [zero_comp] at h
    exact (comp_eq_zero_iff.1 h.symm).resolve_right (ofIsogeny_ne_zero _) |>.symm
  rcases g.eq_zero_or_exists_ofIsogeny with rfl | ⟨ψ, rfl⟩
  · rw [zero_comp] at h
    exact (comp_eq_zero_iff.1 h).resolve_right (ofIsogeny_ne_zero _)
  rw [ofIsogeny_comp_ofIsogeny, ofIsogeny_comp_ofIsogeny] at h
  have h' := ofIsogeny_injective h
  congr 1
  apply Isogeny.ext
  apply AlgHom.ext
  intro x
  refine (frobeniusIsogeny W₁).fieldPullback.injective ?_
  have hz := congrArg (fun χ : Isogeny W₁ W ↦ χ.fieldPullback (algebraMap _ _ x)) h'
  simpa only [comp_fieldPullback, AlgHom.comp_apply, fieldPullback_frobeniusIsogeny_apply,
    fieldPullback_algebraMap, map_pow, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] using hz

omit [W.IsElliptic] in
/-- **Two morphisms agree exactly when they agree after composition with Frobenius.** -/
@[simp]
theorem frobenius_comp_inj {f g : Hom W₁ W} :
    (ofIsogeny (frobeniusIsogeny W)).comp f = (ofIsogeny (frobeniusIsogeny W)).comp g ↔ f = g :=
  frobenius_comp_injective.eq_iff

end Hom

end TauCeti.Isogeny

end
