/-!
# The quadratic field generated by ordinary Frobenius

For an ordinary elliptic curve over a finite field, the endomorphism ring is commutative
and finite of rank two over the integers. We realize its fraction field as a quadratic
number field with no real places, prove that Frobenius generates it over the rationals,
compute its minimal polynomial, and identify the endomorphism ring with an order in this field.
In particular, the order is the full
endomorphism ring, not merely the suborder generated by Frobenius.

`TauCeti.OrdinaryEnd` is a type synonym needed to give the ordinary endomorphism ring a
commutative ring structure without imposing commutativity on other endomorphism rings.
Its identification with the original endomorphisms is `TauCeti.OrdinaryEnd.ringEquiv`.

## References

* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], III.9.4 and V.3.1.
-/

public section

noncomputable section

open TauCeti.Isogeny
open scoped nonZeroDivisors

namespace TauCeti

variable {F : Type*} [Field F] {p : ℕ} [ExpChar F p]
variable {W : WeierstrassCurve F} [W.IsElliptic]

namespace OrdinaryEnd

variable (hW : W.IsOrdinary p)

variable [Finite F]

instance : Module.Finite ℤ (OrdinaryEnd hW) := by
  have := WeierstrassCurve.module_finite_hom_of_isOrdinary hW
  exact Module.Finite.equiv (ringEquiv hW).symm.toAddEquiv.toIntLinearEquiv

/-- The ordinary endomorphism ring has rank two over the integers. -/
@[simp]
theorem finrank_eq_two : Module.finrank ℤ (OrdinaryEnd hW) = 2 :=
  ((ringEquiv hW).toAddEquiv.toIntLinearEquiv.finrank_eq).trans
    (WeierstrassCurve.finrank_hom_of_isOrdinary hW)

/-- The fraction field of the ordinary endomorphism ring. The sealed type keeps the
localization's auxiliary semiring instances from competing with the field structure. -/
def FractionField : Type _ := FractionRing (OrdinaryEnd hW)

instance : Field (FractionField hW) :=
  inferInstanceAs (Field (FractionRing (OrdinaryEnd hW)))

instance : CharZero (FractionField hW) :=
  inferInstanceAs (CharZero (FractionRing (OrdinaryEnd hW)))

instance : Algebra (OrdinaryEnd hW) (FractionField hW) :=
  inferInstanceAs (Algebra (OrdinaryEnd hW) (FractionRing (OrdinaryEnd hW)))

instance : IsFractionRing (OrdinaryEnd hW) (FractionField hW) :=
  inferInstanceAs (IsFractionRing (OrdinaryEnd hW) (FractionRing (OrdinaryEnd hW)))

/-- The fraction field of the ordinary endomorphism ring is quadratic over the rationals. -/
@[simp]
theorem finrank_fractionField_eq_two : Module.finrank ℚ (FractionField hW) = 2 := by
  rw [IsFractionRing.finrank_eq ℤ ℚ (OrdinaryEnd hW) (FractionField hW), finrank_eq_two]

instance : NumberField (FractionField hW) where
  to_charZero := inferInstance
  to_finiteDimensional :=
    Module.finite_of_finrank_pos (by rw [finrank_fractionField_eq_two]; norm_num)

instance : Algebra.IsQuadraticExtension ℚ (FractionField hW) := ⟨finrank_fractionField_eq_two hW⟩

/-- The full endomorphism order, as a subring of its fraction field. -/
def order : GlobalNumberFields.NumberFieldOrder (FractionField hW) :=
  GlobalNumberFields.NumberFieldOrder.ofIsFractionRing (OrdinaryEnd hW) (FractionField hW)

/-- Membership in the endomorphism order means being the image of an endomorphism. -/
theorem mem_order {x : FractionField hW} :
    x ∈ (order hW).toSubalgebra ↔ ∃ f : OrdinaryEnd hW, algebraMap _ _ f = x :=
  GlobalNumberFields.NumberFieldOrder.mem_ofIsFractionRing _ _

/-- Every endomorphism maps into the endomorphism order. -/
@[simp]
theorem algebraMap_mem_order (f : OrdinaryEnd hW) :
    algebraMap (OrdinaryEnd hW) (FractionField hW) f ∈ (order hW).toSubalgebra :=
  (mem_order hW).mpr ⟨f, rfl⟩

/-- The endomorphism ring is isomorphic to its order in the quadratic field. -/
def orderEquiv : OrdinaryEnd hW ≃+* (order hW).toSubalgebra :=
  GlobalNumberFields.NumberFieldOrder.ofIsFractionRingEquiv _ _

/-- The order isomorphism sends an endomorphism to its image in the fraction field. -/
@[simp]
theorem coe_orderEquiv (f : OrdinaryEnd hW) :
    (orderEquiv hW f : FractionField hW) = algebraMap (OrdinaryEnd hW) (FractionField hW) f :=
  GlobalNumberFields.NumberFieldOrder.coe_ofIsFractionRingEquiv _ _ f

/-- The canonical ring homomorphism from the original endomorphisms to their fraction field. -/
def toFractionField : Hom W.toAffine W.toAffine →+* FractionField hW :=
  (algebraMap (OrdinaryEnd hW) (FractionField hW)).comp (ringEquiv hW).symm.toRingHom

omit [Finite F] in
/-- The canonical map sends an endomorphism to the image of its ordinary ring representative. -/
@[simp]
theorem toFractionField_apply (f : Hom W.toAffine W.toAffine) :
    toFractionField hW f =
      algebraMap (OrdinaryEnd hW) (FractionField hW) ((ringEquiv hW).symm f) :=
  (rfl)

/-- Frobenius in the fraction field of the ordinary endomorphism ring. -/
def frobenius : FractionField hW :=
  toFractionField hW (Hom.ofIsogeny (frobeniusIsogeny W.toAffine))

/-- Frobenius is the image of the original Frobenius endomorphism in the fraction field. -/
theorem frobenius_def : frobenius hW =
    toFractionField hW (Hom.ofIsogeny (frobeniusIsogeny W.toAffine)) :=
  (rfl)

/-- Frobenius belongs to the full endomorphism order. -/
@[simp]
theorem frobenius_mem_order : frobenius hW ∈ (order hW).toSubalgebra :=
  (mem_order hW).mpr ⟨_, by rw [frobenius_def, toFractionField_apply]⟩

/-- The integer subalgebra generated by Frobenius is contained in the full endomorphism order. -/
theorem adjoin_frobenius_le_order :
    Algebra.adjoin ℤ {frobenius hW} ≤ (order hW).toSubalgebra :=
  Algebra.adjoin_le (Set.singleton_subset_iff.mpr (frobenius_mem_order hW))

/-- Every endomorphism belongs to the rational field generated by Frobenius. -/
private theorem algebraMap_mem_adjoin_frobenius (f : OrdinaryEnd hW) :
    algebraMap (OrdinaryEnd hW) (FractionField hW) f ∈
      IntermediateField.adjoin ℚ {frobenius hW} := by
  obtain ⟨N, hN, h⟩ :=
    WeierstrassCurve.exists_zsmul_mem_adjoin_ofIsogeny_frobeniusIsogeny_of_isOrdinary hW
  have hf := h (ringEquiv hW f)
  rw [← Subalgebra.mem_toSubmodule, toSubmodule_adjoin_ofIsogeny_frobeniusIsogeny,
    Submodule.mem_span_pair] at hf
  obtain ⟨a, b, hab⟩ := hf
  have key := congrArg (toFractionField hW) hab
  simp only [map_add, map_zsmul, map_one, ← frobenius_def] at key
  have key' : (N : FractionField hW) * algebraMap (OrdinaryEnd hW) (FractionField hW) f =
      a + b * frobenius hW := by
    simpa only [toFractionField_apply, RingEquiv.symm_apply_apply, zsmul_eq_mul, mul_one]
      using key.symm
  let L := IntermediateField.adjoin ℚ {frobenius hW}
  have hπ : frobenius hW ∈ L := IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)
  have hN' : (N : FractionField hW) ≠ 0 := Int.cast_ne_zero.mpr hN
  have hf' : algebraMap (OrdinaryEnd hW) (FractionField hW) f =
      ((N : FractionField hW)⁻¹) * (a + b * frobenius hW) := by
    rw [← key', inv_mul_cancel_left₀ hN']
  rw [hf']
  exact L.mul_mem (L.inv_mem (L.intCast_mem N))
    (L.add_mem (L.intCast_mem a) (L.mul_mem (L.intCast_mem b) hπ))

/-- **Frobenius generates the endomorphism field over the rationals.** Thus this quadratic
number field is precisely `ℚ(π)`, not a larger field containing it. -/
@[simp]
theorem adjoin_frobenius_eq_top :
    IntermediateField.adjoin ℚ {frobenius hW} = ⊤ := by
  apply top_unique
  intro x _
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (OrdinaryEnd hW) x
  exact (IntermediateField.adjoin ℚ {frobenius hW}).div_mem
    (algebraMap_mem_adjoin_frobenius hW a) (algebraMap_mem_adjoin_frobenius hW b)

/-- The minimal polynomial of ordinary Frobenius has degree two. -/
@[simp]
theorem natDegree_minpoly_frobenius : (minpoly ℚ (frobenius hW)).natDegree = 2 := by
  have h := IntermediateField.adjoin.finrank
    (Algebra.IsIntegral.isIntegral (R := ℚ) (frobenius hW))
  rw [adjoin_frobenius_eq_top, IntermediateField.finrank_top', finrank_fractionField_eq_two] at h
  exact h.symm

/-- The characteristic equation of Frobenius in its quadratic number field. -/
theorem frobenius_sq_sub_frobeniusTrace_mul_add_card_eq_zero :
    frobenius hW ^ 2 - W.frobeniusTrace * frobenius hW + Nat.card F = 0 := by
  have h := ofIsogeny_frobeniusIsogeny_comp_ofIsogeny_frobeniusIsogeny W.toAffine
  rw [← Hom.mul_def, ← Hom.one_def] at h
  have key := congrArg (toFractionField hW) h
  simp only [map_mul, map_sub, map_zsmul, map_nsmul, map_one, ← frobenius_def] at key
  simp only [zsmul_eq_mul, nsmul_eq_mul, mul_one, ← pow_two] at key
  linear_combination key

/-- The minimal polynomial of ordinary Frobenius is `X² - a_q X + q`. -/
theorem minpoly_frobenius :
    minpoly ℚ (frobenius hW) =
      Polynomial.X ^ 2 - Polynomial.C (W.frobeniusTrace : ℚ) * Polynomial.X +
        Polynomial.C (Nat.card F : ℚ) := by
  let P : Polynomial ℚ := Polynomial.X ^ 2 -
    Polynomial.C (W.frobeniusTrace : ℚ) * Polynomial.X + Polynomial.C (Nat.card F : ℚ)
  have hmonic : P.Monic := by
    dsimp only [P]
    monicity <;> norm_num
  have hdeg : P.natDegree = 2 := by
    dsimp only [P]
    compute_degree!
  symm
  apply Polynomial.eq_of_monic_of_dvd_of_natDegree_le
    (minpoly.monic (Algebra.IsIntegral.isIntegral (R := ℚ) (frobenius hW))) hmonic
  · apply minpoly.dvd
    simpa [P] using frobenius_sq_sub_frobeniusTrace_mul_add_card_eq_zero hW
  · rw [hdeg, natDegree_minpoly_frobenius]

/-- The ordinary endomorphism field is imaginary quadratic: it has no real places. -/
instance : NumberField.IsTotallyComplex (FractionField hW) where
  isComplex v := by
    apply NumberField.InfinitePlace.not_isReal_iff_isComplex.mp
    intro hv
    let φ := NumberField.InfinitePlace.embedding_of_isReal hv
    have hφ := congrArg φ (frobenius_sq_sub_frobeniusTrace_mul_add_card_eq_zero hW)
    simp only [map_add, map_sub, map_pow, map_mul, map_intCast, map_natCast, map_zero] at hφ
    have hH : (W.frobeniusTrace : ℝ) ^ 2 ≤ 4 * (Nat.card F : ℝ) := by
      exact_mod_cast W.frobeniusTrace_sq_le_four_mul_card
    have he : φ (frobenius hW) = (W.frobeniusTrace : ℝ) / 2 := by
      nlinarith [sq_nonneg (2 * φ (frobenius hW) - (W.frobeniusTrace : ℝ))]
    have hrat : frobenius hW =
        algebraMap ℚ (FractionField hW) ((W.frobeniusTrace : ℚ) / 2) := by
      apply φ.injective
      rw [RingHom.map_rat_algebraMap]
      simpa only [map_div₀, map_intCast, map_ofNat] using he
    have hdeg := natDegree_minpoly_frobenius hW
    rw [hrat, minpoly.eq_X_sub_C, Polynomial.natDegree_X_sub_C] at hdeg
    omega

end OrdinaryEnd

end TauCeti

end
