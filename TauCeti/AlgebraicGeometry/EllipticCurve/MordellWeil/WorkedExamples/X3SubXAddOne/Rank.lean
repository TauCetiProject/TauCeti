/-!
# The Mordell–Weil group of `y² = x³ - x + 1` is `ℤ`

The rational points of the elliptic curve `E : y² = x³ - x + 1` over `ℚ` form a free abelian
group of rank one, so `E(ℚ) ≅ ℤ`. The rank is computed by explicit `2`-descent through the étale
algebra of the cubic `x³ - x + 1`, following the worked example of Stoll's `EllipticCurves`
project (see Provenance); Silverman X.1 is general background on descent.

* **Rank at least one.** The rational point `P = (1, 1)` is nonzero, and `E(ℚ)` is torsion-free
  (`TauCeti.WorkedExamples.torsion_curveX3SubXAddOne_eq_bot`), so `P` has infinite order.
* **Rank at most one.** The cubic `f = x³ - x + 1` is irreducible over `ℚ`, so the étale algebra
  `ℚ[X] ⧸ (f)` of the descent is a single cubic field `L`, generated by a root of `f`. Its
  discriminant `disc f = -23` is squarefree, so at no finite prime does `disc f` vanish to order
  two or more, and `-1` is not a square in `ℚ`. The descent bound
  `WeierstrassCurve.Affine.pow_rank_add_one_le_prod` therefore reads
  `2 ^ (rank E(ℚ) + 1) · #E(ℚ)[2] ≤ 2 ^ (r + 1) · #Cl[2]`, with `r` the unit rank and `Cl` the class
  group of the ring of integers of `L`. Here `#E(ℚ)[2] = 1`, and `L` is the cubic field of
  discriminant `-23`, which has unit rank `1` and class number `1`
  (`TauCeti.NumberField.Cubic23.units_rank_eq_one`,
  `TauCeti.NumberField.Cubic23.classNumber_eq_one`). So `2 ^ (rank E(ℚ) + 1) ≤ 4`.

Since `E(ℚ)` is finitely generated (the Mordell–Weil theorem) and torsion-free, rank one makes it
isomorphic to `ℤ`. The isomorphism is not made explicit here: identifying a generator, for
instance showing that `P` itself generates, needs the canonical height.

## Main definitions

* `TauCeti.WorkedExamples.curveX3SubXAddOnePoint`: the rational point `(1, 1)`.

## Main results

* `TauCeti.WorkedExamples.not_isOfFinAddOrder_curveX3SubXAddOnePoint`: `(1, 1)` has infinite
  order.
* `TauCeti.WorkedExamples.finrank_point_curveX3SubXAddOne`: the rank of `E(ℚ)` is one.
* `TauCeti.WorkedExamples.nonempty_addEquiv_int_point_curveX3SubXAddOne`: `E(ℚ) ≅ ℤ`.

## Provenance

The curve `y² = x³ - x + 1` is the worked example of explicit `2`-descent in Michael Stoll's
`EllipticCurves` project (`github.com/MichaelStollBayreuth/EllipticCurves`, Apache-2.0, commit
`66889eada51a`), on whose descent formalisation the bound
`WeierstrassCurve.Affine.pow_rank_add_one_le_prod` builds; see the provenance of its file.
Here the arithmetic of the cubic field is not recomputed: it is read off the cubic field of
discriminant `-23` through the reciprocal generator of
`TauCeti.NumberField.Cubic23.exists_minpoly_eq_and_adjoin_eq_top_of_root`.

## References

* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], X.1.
-/

public section

open WeierstrassCurve Affine Polynomial NumberField IsDedekindDomain Module
open scoped NumberField

namespace TauCeti.WorkedExamples

/-! ### The point `(1, 1)` -/

/-- The rational point `(1, 1)` of `y² = x³ - x + 1`. -/
def curveX3SubXAddOnePoint : (curveX3SubXAddOne.baseChange ℚ).toAffine.Point :=
  .some 1 1 <| equation_iff_nonsingular.1 <| by
    rw [equation_iff]
    simp [curveX3SubXAddOne]

/-- `curveX3SubXAddOnePoint` is the point `(1, 1)`. -/
@[simp]
theorem curveX3SubXAddOnePoint_def :
    curveX3SubXAddOnePoint = .some 1 1 (equation_iff_nonsingular.1 <| by
      rw [equation_iff]
      simp [curveX3SubXAddOne]) := (rfl)

/-- `(1, 1)` has infinite order. -/
theorem not_isOfFinAddOrder_curveX3SubXAddOnePoint :
    ¬ IsOfFinAddOrder curveX3SubXAddOnePoint := fun h ↦ by
  have := (AddCommGroup.mem_torsion _).mpr h
  rw [torsion_curveX3SubXAddOne_eq_bot, AddSubgroup.mem_bot] at this
  exact Point.some_ne_zero _ this

/-! ### The descent bound -/

/-- The cubic of the `2`-descent is `x³ - x + 1`. -/
private theorem f_curveX3SubXAddOne :
    (curveX3SubXAddOne.baseChange ℚ).toAffine.f = X ^ 3 - X + 1 := by
  simp [Affine.f, curveX3SubXAddOne, sub_eq_add_neg]

/-- The cubic `x³ - x + 1` of the `2`-descent is irreducible over `ℚ`. -/
private theorem irreducible_f_curveX3SubXAddOne :
    Irreducible (curveX3SubXAddOne.baseChange ℚ).toAffine.f := by
  rw [f_curveX3SubXAddOne]
  exact NumberField.Cubic23.irreducible_X_pow_three_sub_X_add_one

/-- The étale algebra of the `2`-descent is a field: its only factor is `x³ - x + 1`. -/
private noncomputable instance : Unique (curveX3SubXAddOne.baseChange ℚ).toAffine.f.Factors where
  default := ⟨_, irreducible_f_curveX3SubXAddOne, monic_f _, dvd_rfl⟩
  uniq p := Subtype.ext <| eq_of_monic_of_associated p.monic (monic_f _) <|
    p.irreducible.associated_of_dvd irreducible_f_curveX3SubXAddOne p.dvd

/-- The field factor of the descent has unit rank one and class number one: it is the cubic field
of discriminant `-23`, generated by the reciprocal `1 - r²` of a root `r` of `x³ - x + 1`. -/
private theorem finrank_units_eq_one_and_isPrincipalIdealRing
    (p : (curveX3SubXAddOne.baseChange ℚ).toAffine.f.Factors) :
    finrank ℤ (Additive ((curveX3SubXAddOne.baseChange ℚ).toAffine.ringOfIntegersFactor
      (𝓞 ℚ) p)ˣ) = 1 ∧
    IsPrincipalIdealRing ((curveX3SubXAddOne.baseChange ℚ).toAffine.ringOfIntegersFactor
      (𝓞 ℚ) p) := by
  have hp : (p : ℚ[X]) = X ^ 3 - X + 1 := by
    rw [Subsingleton.elim p default]
    exact f_curveX3SubXAddOne
  have : NumberField (AdjoinRoot (p : ℚ[X])) := .of_module_finite ℚ _
  have hr : AdjoinRoot.root (p : ℚ[X]) ^ 3 - AdjoinRoot.root (p : ℚ[X]) + 1 = 0 := by
    have h : aeval (AdjoinRoot.root (p : ℚ[X])) (X ^ 3 - X + 1 : ℚ[X]) = 0 := by
      rw [← hp]
      exact (AdjoinRoot.aeval_eq _).trans AdjoinRoot.mk_self
    simpa using h
  obtain ⟨θ, hmin, hgen⟩ := NumberField.Cubic23.exists_minpoly_eq_and_adjoin_eq_top_of_root hr
    AdjoinRoot.adjoinRoot_eq_top
  exact ⟨(finrank_units_integralClosure ℚ _).trans
      (NumberField.Cubic23.units_rank_eq_one hmin hgen),
    (isPrincipalIdealRing_integralClosure_iff ℚ _).mpr
      (NumberField.Cubic23.classNumber_eq_one hmin hgen)⟩

/-- `E(ℚ)[2]` is trivial, whichever decidable equality on `ℚ` the group law is built from. -/
private theorem card_ker_nsmul_two_curveX3SubXAddOne [inst : DecidableEq ℚ] :
    Nat.card (nsmulAddMonoidHom (α := (curveX3SubXAddOne.baseChange ℚ).toAffine.Point) 2).ker =
      1 := by
  obtain rfl : inst = instDecidableEqRat := Subsingleton.elim _ _
  refine (AddSubgroup.eq_bot_iff_card _).mp ((AddMonoidHom.ker_eq_bot_iff _).mpr ?_)
  exact nsmul_right_injective two_ne_zero

/-- **The rank of `y² = x³ - x + 1` over `ℚ` is at most one**, by explicit `2`-descent, whichever
decidable equality on `ℚ` the group law is built from. -/
private theorem finrank_point_curveX3SubXAddOne_le_one [inst : DecidableEq ℚ] :
    finrank ℤ (curveX3SubXAddOne.baseChange ℚ).toAffine.Point ≤ 1 := by
  -- the descent bound is stated for the group law built from classical decidable equality
  obtain rfl : inst = fun a b ↦ Classical.propDecidable (a = b) := Subsingleton.elim _ _
  have hdiscr : (curveX3SubXAddOne.baseChange ℚ).toAffine.f.discr = ((-23 : ℤ) : ℚ) := by
    rw [f_curveX3SubXAddOne, discr_of_degree_eq_three (by compute_degree <;> norm_num)]
    norm_num [coeff_add, coeff_sub, coeff_X_pow, coeff_X, coeff_one]
  have hsq : Squarefree (-23 : ℤ) :=
    Int.squarefree_natAbs.mp (by norm_num : Nat.Prime 23).squarefree
  have h := pow_rank_add_one_le_prod (curveX3SubXAddOne.baseChange ℚ).toAffine
    (fun v ↦ by simp) (fun v ↦ by simp) (fun v ↦ by simp)
    (fun v ↦ hdiscr ▸ Rat.HeightOneSpectrum.exp_neg_one_le_valuation_intCast v hsq)
    fun h ↦ by linarith [h.nonneg]
  -- `E(ℚ)[2]` is trivial and the right-hand side is at most `2 ^ (1 + 1) * 1`
  obtain ⟨hu, hpid⟩ := finrank_units_eq_one_and_isPrincipalIdealRing default
  have hc : Nat.card (ClassGroup ((curveX3SubXAddOne.baseChange ℚ).toAffine.ringOfIntegersFactor
      (𝓞 ℚ) default)) = 1 := by
    rw [Nat.card_eq_fintype_card, card_classGroup_eq_one]
  rw [@card_ker_nsmul_two_curveX3SubXAddOne fun a b ↦ Classical.propDecidable (a = b), mul_one,
    Fintype.prod_unique, hu] at h
  have hle := h.trans (Nat.mul_le_mul_left _ ((Subgroup.card_le_card_group _).trans hc.le))
  rw [mul_one] at hle
  exact Nat.le_of_add_le_add_right ((Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp hle)

/-- **The rank of `y² = x³ - x + 1` over `ℚ` is one.** -/
theorem finrank_point_curveX3SubXAddOne :
    finrank ℤ (curveX3SubXAddOne.baseChange ℚ).toAffine.Point = 1 := by
  refine le_antisymm finrank_point_curveX3SubXAddOne_le_one (Nat.one_le_iff_ne_zero.mpr fun h ↦ ?_)
  obtain ⟨a, ha, hP⟩ := Module.finrank_eq_zero_iff.mp h curveX3SubXAddOnePoint
  exact not_isOfFinAddOrder_curveX3SubXAddOnePoint
    (isOfFinAddOrder_iff_zsmul_eq_zero.mpr ⟨a, ha, hP⟩)

/-- **The Mordell–Weil group of `y² = x³ - x + 1` over `ℚ` is `ℤ`.** It is finitely generated,
torsion-free and of rank one. -/
theorem nonempty_addEquiv_int_point_curveX3SubXAddOne :
    Nonempty ((curveX3SubXAddOne.baseChange ℚ).toAffine.Point ≃+ ℤ) :=
  ⟨(LinearEquiv.ofFinrankEq _ ℤ
    (finrank_point_curveX3SubXAddOne.trans (finrank_self ℤ).symm)).toAddEquiv⟩

end TauCeti.WorkedExamples
