public import TauCeti.AlgebraicGeometry.EllipticCurve.VariableChange.Gamma1Three.Basis

/-!
# The algebraic transfer on the `Γ₁(3)` Weierstrass Hopf algebroid

Following Carrick, Davies and van Nigtevecht (§4.2), for any commutative ring `R` we define the
**algebraic transfer**

`transfer R : BaseRing R →ₗ[R] BaseRing R`,  `x ↦ Algebra.trace (BaseRing R) (ArrowRing R) (η_R x)`

along the right unit `rightUnit R : BaseRing R →+* ArrowRing R` of the `Γ₁(3)` Weierstrass Hopf
algebroid `(BaseRing R, ArrowRing R)`.

Whenever `3` is invertible in `R`, `ArrowRing R` is free of rank `8` over `BaseRing R`
(`arrowRingBasis R`), and combining the groupoid shearing factorization of `coproduct R` with
base-change compatibility of `Algebra.trace` (`trace_coproduct`) shows that every transfer is a
Hopf-algebroid invariant (`rightUnit_transfer`, `transfer_mem_invariantSubalgebra`). Together with
the projection formula (`transfer_mul_of_mem_invariantSubalgebra`), this upgrades `transfer R` to
an `invariantSubalgebra R`-linear map

`transferToInvariants R : BaseRing R →ₗ[invariantSubalgebra R] invariantSubalgebra R`

whose image is an ideal of `invariantSubalgebra R = H⁰(A', Γ')`. Using the explicit basis traces
from `Gamma1Three.Basis`, we evaluate `transfer R` on the modular generators:

* `transfer R 1 = 8`,
* `transfer R (a₁ R) = 0` and `transfer R (a₃ R) = 0`,
* `transfer R (3 * a₁ R * a₃ R) = 2 * (universalCurve R).c₄`,
* `transfer R (27 * a₃ R ^ 2) = 2 * (universalCurve R).c₆`,
* `transfer R (a₃ R ^ 2) = 2 * algebraMap R (BaseRing R) (⅟(3 : R) ^ 3) * (universalCurve R).c₆`,
* `transfer R (a₁ R ^ 4) = 24 * (universalCurve R).c₄`,
* `transfer R (a₁ R ^ 3 * a₃ R) = 2 * (universalCurve R).c₆`.

In particular, the ideal of `invariantSubalgebra R` generated by `8`, `2c₄` and `2c₆` lies in the
image of `transferToInvariants R` (`span_eight_two_c₄_two_c₆_le_range_transferToInvariants`), and
this applies to any `2`-local model `R` of `ℤ_{(2)}` satisfying
`IsLocalization.AtPrime R (Ideal.span {(2 : ℤ)})` (the algebraic core of Carrick–Davies–van
Nigtevecht, Lemma 4.8 and Corollary 4.9).

## Main definitions

* `TauCeti.Gamma1ThreeHopfAlgebroid.transfer R`: the algebraic transfer
  `BaseRing R →ₗ[R] BaseRing R`.
* `TauCeti.Gamma1ThreeHopfAlgebroid.transferToInvariants R`: the `invariantSubalgebra R`-linear
  transfer into `invariantSubalgebra R` when `[Invertible (3 : R)]`.

## Main results

* `transfer_mul_of_rightUnit_eq`, `transfer_mul_of_mem_invariantSubalgebra`,
  `transfer_toBaseRing_mul_of_isIntegralModularForm`: projection formulas for `transfer R`.
* `rightUnit_transfer`, `transfer_mem_invariantSubalgebra`: transfers are `Γ₁(3)` Hopf-algebroid
  invariants when `[Invertible (3 : R)]`.
* `transfer_one`, `transfer_a₁`, `transfer_a₃`, `transfer_three_mul_a₁_mul_a₃`,
  `transfer_twentySeven_mul_a₃_sq`, `transfer_a₃_sq`, `transfer_a₁_pow_four`,
  `transfer_a₁_cube_mul_a₃`: explicit transfer formulas.
* `span_eight_two_c₄_two_c₆_le_range_transferToInvariants`: `(8, 2c₄, 2c₆)` is contained in the
  range of `transferToInvariants R`.
* `isUnit_three_of_atPrime`, `transfer_subset_range_of_atPrime`,
  `transfer_subset_range_localizationAtPrime_two`: prime-localization and `2`-local (`ℤ_{(2)}`)
  corollaries.

## References

* T. Bauer, *Computation of the homotopy of the spectrum tmf*, in *Groups, homotopy and
  configuration spaces*, Geom. Topol. Monogr. 13 (2008), §7.
* K. Carrick, J. Davies and S. van Nigtevecht, *Topological modular forms with level structure:
  deformations, transfers, and differentials*, §4.2, Lemma 4.8 and Corollary 4.9.
-/

public section

noncomputable section

namespace TauCeti.Gamma1ThreeHopfAlgebroid

open MvPolynomial _root_.WeierstrassCurve

section General

variable (R : Type*) [CommRing R]

private theorem baseRing_smul_eq_algebraMap_mul (c : R) (p : BaseRing R) :
    c • p = algebraMap R (BaseRing R) c * p :=
  Algebra.smul_def c p

/-- The **algebraic transfer** `tr : BaseRing R →ₗ[R] BaseRing R` on the `Γ₁(3)` Hopf algebroid,
sending `x` to `Algebra.trace (BaseRing R) (ArrowRing R) (rightUnit R x)` (Carrick, Davies and
van Nigtevecht, §4.2). -/
def transfer : BaseRing R →ₗ[R] BaseRing R :=
  ((Algebra.trace (BaseRing R) (ArrowRing R)).restrictScalars R).comp
    (rightUnitAlgHom R).toLinearMap

/-- Applying `transfer R` computes `Algebra.trace` of `rightUnit R x`. -/
theorem transfer_apply (x : BaseRing R) :
    transfer R x = Algebra.trace (BaseRing R) (ArrowRing R) (rightUnit R x) := by
  simp [transfer]

/-- **Projection formula for `transfer`**: multiplying by any `f` with `η_R f = η_L f` pulls out
of `transfer`. -/
theorem transfer_mul_of_rightUnit_eq {f : BaseRing R}
    (hf : rightUnit R f = algebraMap (BaseRing R) (ArrowRing R) f) (x : BaseRing R) :
    transfer R (f * x) = f * transfer R x := by
  rw [transfer_apply, map_mul, hf, ← ArrowRingOf.smul_eq_algebraMap_mul, LinearMap.map_smul,
    smul_eq_mul, transfer_apply]

/-- Projection formula for elements of `invariantSubalgebra R`. -/
theorem transfer_mul_of_mem_invariantSubalgebra {f : BaseRing R}
    (hf : f ∈ invariantSubalgebra R) (x : BaseRing R) :
    transfer R (f * x) = f * transfer R x :=
  transfer_mul_of_rightUnit_eq R ((mem_invariantSubalgebra R).mp hf) x

/-- Projection formula for pullbacks of level-one integral modular forms. -/
theorem transfer_toBaseRing_mul_of_isIntegralModularForm {k : ℕ} {g : MvPolynomial Coeff ℤ}
    (hg : IsIntegralModularForm k g) (x : BaseRing R) :
    transfer R (toBaseRing R g * x) = toBaseRing R g * transfer R x :=
  transfer_mul_of_rightUnit_eq R (rightUnit_toBaseRing_of_isIntegralModularForm R hg) x

/-- Denominator-free expansion of `rightUnit R (3 * a₃ R)` onto `{1, s, s², t}` over any
commutative ring `R`. -/
theorem rightUnit_three_mul_a₃ :
    rightUnit R (3 * a₃ R) =
      algebraMap (BaseRing R) (ArrowRing R) (3 * a₃ R) +
        algebraMap (BaseRing R) (ArrowRing R) (a₁ R ^ 2) * s R +
        algebraMap (BaseRing R) (ArrowRing R) (a₁ R) * s R ^ 2 +
        6 * t R := by
  rw [map_mul, map_ofNat, rightUnit_a₃, map_mul, map_ofNat, map_pow]
  linear_combination
    algebraMap (BaseRing R) (ArrowRing R) (a₁ R) *
      ArrowRingOf.three_mul_r_sub_s_sq_sub_a₁_mul_s (BaseRing R) (a₁ R) (a₃ R)

/-- `(8 : BaseRing R)` belongs to `invariantSubalgebra R`. -/
theorem eight_mem_invariantSubalgebra : (8 : BaseRing R) ∈ invariantSubalgebra R :=
  ofNat_mem _ 8

/-- `2 * (universalCurve R).c₄` belongs to `invariantSubalgebra R`. -/
theorem two_mul_c₄_mem_invariantSubalgebra :
    2 * (universalCurve R).c₄ ∈ invariantSubalgebra R :=
  mul_mem (ofNat_mem _ 2) (c₄_mem_invariantSubalgebra R)

/-- `2 * (universalCurve R).c₆` belongs to `invariantSubalgebra R`. -/
theorem two_mul_c₆_mem_invariantSubalgebra :
    2 * (universalCurve R).c₆ ∈ invariantSubalgebra R :=
  mul_mem (ofNat_mem _ 2) (c₆_mem_invariantSubalgebra R)

private theorem trace_linearCombination [Invertible (3 : BaseRing R)]
    (c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ : BaseRing R) :
    Algebra.trace (BaseRing R) (ArrowRing R)
        (algebraMap (BaseRing R) (ArrowRing R) c₀ +
          c₁ • s R + c₂ • s R ^ 2 + c₃ • s R ^ 3 +
          c₄ • t R + c₅ • (s R * t R) + c₆ • (s R ^ 2 * t R) + c₇ • (s R ^ 3 * t R)) =
      8 * c₀ + c₁ * (-4 * a₁ R) + c₂ * (2 * a₁ R ^ 2) + c₃ * (-a₁ R ^ 3) +
        c₄ * (⅟(3 : BaseRing R) * a₁ R ^ 3 - 4 * a₃ R) + c₅ * (-2 * a₁ R * a₃ R) +
        c₆ * (-⅟(3 : BaseRing R) * a₁ R ^ 5 + 9 * a₁ R ^ 2 * a₃ R) +
        c₇ * (⅟(3 : BaseRing R) * a₁ R ^ 6 - 7 * a₁ R ^ 3 * a₃ R - 27 * a₃ R ^ 2) := by
  simp only [map_add, LinearMap.map_smul, ArrowRingOf.trace_algebraMap, ArrowRingOf.trace_s,
    ArrowRingOf.trace_s_sq, ArrowRingOf.trace_s_cube, ArrowRingOf.trace_t,
    ArrowRingOf.trace_s_mul_t, ArrowRingOf.trace_s_sq_mul_t, ArrowRingOf.trace_s_cube_mul_t,
    smul_eq_mul]

end General

/-! ### Invariance and explicit transfer formulas when `3` is invertible -/

section InvertibleThree

private abbrev invertibleThreeOfRingHom {A B : Type*} [CommRing A] [CommRing B]
    [Invertible (3 : A)] (f : A →+* B) : Invertible (3 : B) :=
  (Invertible.map f (3 : A)).copy 3 (map_ofNat f 3).symm

variable (R : Type*) [CommRing R] [Invertible (3 : R)]

/-- **Transfers are Hopf-algebroid invariants**: `η_R (transfer x) = η_L (transfer x)`. -/
theorem rightUnit_transfer (x : BaseRing R) :
    rightUnit R (transfer R x) = algebraMap (BaseRing R) (ArrowRing R) (transfer R x) := by
  let _ := invertibleThreeOfRingHom (algebraMap R (BaseRing R))
  let _ := invertibleThreeOfRingHom (algebraMap (BaseRing R) (ArrowRing R))
  have h := trace_coproduct R (rightUnit R x)
  rw [coproduct_rightUnit, ArrowRingOf.trace_map] at h
  simpa [transfer_apply] using h

/-- Every transfer lands in `invariantSubalgebra R = H⁰(A', Γ')`. -/
theorem transfer_mem_invariantSubalgebra (x : BaseRing R) :
    transfer R x ∈ invariantSubalgebra R :=
  (mem_invariantSubalgebra R).mpr (rightUnit_transfer R x)

/-- The transfer bundled as an `invariantSubalgebra R`-linear map into `invariantSubalgebra R`, so
that `LinearMap.range (transferToInvariants R)` is an ideal of `invariantSubalgebra R`. -/
def transferToInvariants : BaseRing R →ₗ[invariantSubalgebra R] invariantSubalgebra R where
  toFun x := ⟨transfer R x, transfer_mem_invariantSubalgebra R x⟩
  map_add' x y := Subtype.ext (map_add (transfer R) x y)
  map_smul' f x := Subtype.ext (transfer_mul_of_mem_invariantSubalgebra R f.2 x)

/-- Coercion of `transferToInvariants R x` to `BaseRing R` is `transfer R x`. -/
@[simp]
theorem coe_transferToInvariants (x : BaseRing R) :
    (transferToInvariants R x : BaseRing R) = transfer R x :=
  (rfl)

/-- `transfer 1 = 8` in `BaseRing R`. -/
@[simp]
theorem transfer_one : transfer R 1 = 8 := by
  let _ := invertibleThreeOfRingHom (algebraMap R (BaseRing R))
  simp [transfer_apply]

/-- `transfer a₁ = 0` in `BaseRing R`. -/
@[simp]
theorem transfer_a₁ : transfer R (a₁ R) = 0 := by
  let _ := invertibleThreeOfRingHom (algebraMap R (BaseRing R))
  have hexp : rightUnit R (a₁ R) =
      algebraMap (BaseRing R) (ArrowRing R) (a₁ R) +
        (2 : BaseRing R) • s R + (0 : BaseRing R) • s R ^ 2 + (0 : BaseRing R) • s R ^ 3 +
        (0 : BaseRing R) • t R + (0 : BaseRing R) • (s R * t R) +
        (0 : BaseRing R) • (s R ^ 2 * t R) + (0 : BaseRing R) • (s R ^ 3 * t R) := by
    rw [rightUnit_a₁]
    simp only [ArrowRingOf.smul_eq_algebraMap_mul, map_ofNat, map_zero]
    ring
  rw [transfer_apply, hexp, trace_linearCombination]
  ring

/-- `transfer a₃ = 0` in `BaseRing R`. -/
@[simp]
theorem transfer_a₃ : transfer R (a₃ R) = 0 := by
  let _ := invertibleThreeOfRingHom (algebraMap R (BaseRing R))
  have hexp : rightUnit R (a₃ R) =
      algebraMap (BaseRing R) (ArrowRing R) (a₃ R) +
        (⅟(3 : BaseRing R) * a₁ R ^ 2) • s R + (⅟(3 : BaseRing R) * a₁ R) • s R ^ 2 +
        (0 : BaseRing R) • s R ^ 3 + (2 : BaseRing R) • t R + (0 : BaseRing R) • (s R * t R) +
        (0 : BaseRing R) • (s R ^ 2 * t R) + (0 : BaseRing R) • (s R ^ 3 * t R) := by
    rw [rightUnit_a₃]
    simp only [ArrowRingOf.smul_eq_algebraMap_mul, map_mul, map_pow, map_ofNat, map_zero]
    linear_combination
      algebraMap (BaseRing R) (ArrowRing R) (a₁ R) *
        ArrowRingOf.r_eq (BaseRing R) (a₁ R) (a₃ R)
  rw [transfer_apply, hexp, trace_linearCombination]
  ring

/-- `transfer (3 a₁ a₃) = 2 c₄` in `BaseRing R` (Carrick–Davies–van Nigtevecht, §4.2). -/
theorem transfer_three_mul_a₁_mul_a₃ :
    transfer R (3 * a₁ R * a₃ R) = 2 * (universalCurve R).c₄ := by
  let _ := invertibleThreeOfRingHom (algebraMap R (BaseRing R))
  have hexp : rightUnit R (3 * a₁ R * a₃ R) =
      algebraMap (BaseRing R) (ArrowRing R) (3 * a₁ R * a₃ R) +
        (a₁ R ^ 3 + 6 * a₃ R) • s R + (3 * a₁ R ^ 2) • s R ^ 2 + (2 * a₁ R) • s R ^ 3 +
        (6 * a₁ R) • t R + (12 : BaseRing R) • (s R * t R) +
        (0 : BaseRing R) • (s R ^ 2 * t R) + (0 : BaseRing R) • (s R ^ 3 * t R) := by
    rw [show 3 * a₁ R * a₃ R = a₁ R * (3 * a₃ R) by ring, map_mul, rightUnit_a₁,
      rightUnit_three_mul_a₃]
    simp only [ArrowRingOf.smul_eq_algebraMap_mul, map_add, map_mul, map_pow, map_ofNat, map_zero]
    ring
  rw [transfer_apply, hexp, trace_linearCombination, universalCurve_c₄]
  linear_combination 2 * a₁ R ^ 4 * invOf_mul_self (3 : BaseRing R)

/-- `transfer (27 a₃²) = 2 c₆` in `BaseRing R` (Carrick–Davies–van Nigtevecht, §4.2). -/
theorem transfer_twentySeven_mul_a₃_sq :
    transfer R (27 * a₃ R ^ 2) = 2 * (universalCurve R).c₆ := by
  let _ := invertibleThreeOfRingHom (algebraMap R (BaseRing R))
  have hexp : rightUnit R (27 * a₃ R ^ 2) =
      algebraMap (BaseRing R) (ArrowRing R) (27 * a₃ R ^ 2) +
        (39 * a₁ R ^ 2 * a₃ R) • s R + (3 * a₁ R ^ 4 + 42 * a₁ R * a₃ R) • s R ^ 2 +
        (3 * a₁ R ^ 3 + 12 * a₃ R) • s R ^ 3 + (21 * a₁ R ^ 3) • t R +
        (66 * a₁ R ^ 2) • (s R * t R) + (60 * a₁ R) • (s R ^ 2 * t R) +
        (24 : BaseRing R) • (s R ^ 3 * t R) := by
    rw [show 27 * a₃ R ^ 2 = 3 * (3 * a₃ R) ^ 2 by ring, map_mul, map_ofNat, map_pow,
      rightUnit_three_mul_a₃]
    simp only [ArrowRingOf.smul_eq_algebraMap_mul, map_add, map_mul, map_pow, map_ofNat]
    linear_combination
      3 * algebraMap (BaseRing R) (ArrowRing R) (a₁ R) ^ 2 *
          ArrowRingOf.s_pow_four (BaseRing R) (a₁ R) (a₃ R) +
        4 * ArrowRingOf.twentySeven_mul_t_sq (BaseRing R) (a₁ R) (a₃ R)
  rw [transfer_apply, hexp, trace_linearCombination, universalCurve_c₆]
  linear_combination -5 * a₁ R ^ 6 * invOf_mul_self (3 : BaseRing R)

/-- `transfer (a₃²) = 2 * ⅟3³ * c₆` in `BaseRing R` (Carrick–Davies–van Nigtevecht, §4.2:
`tr(a₃²) = 2 · 3⁻³ · c₆`). -/
theorem transfer_a₃_sq :
    transfer R (a₃ R ^ 2) =
      2 * algebraMap R (BaseRing R) (⅟(3 : R) ^ 3) * (universalCurve R).c₆ := by
  have h27 : (27 : R) • a₃ R ^ 2 = 27 * a₃ R ^ 2 := by
    rw [baseRing_smul_eq_algebraMap_mul, map_ofNat]
  have hmap := congrArg (fun x : BaseRing R ↦ (⅟(3 : R) ^ 3) • x)
    (transfer_twentySeven_mul_a₃_sq R)
  rw [← h27, LinearMap.map_smul, smul_smul] at hmap
  have hunit : ⅟(3 : R) ^ 3 * 27 = 1 := by
    linear_combination
      (⅟(3 : R) ^ 2 * 9 + ⅟(3 : R) * 3 + 1) * invOf_mul_self (3 : R)
  rw [hunit, one_smul, baseRing_smul_eq_algebraMap_mul] at hmap
  linear_combination hmap

/-- `transfer (a₁⁴) = 24 c₄` in `BaseRing R`. -/
theorem transfer_a₁_pow_four :
    transfer R (a₁ R ^ 4) = 24 * (universalCurve R).c₄ := by
  let _ := invertibleThreeOfRingHom (algebraMap R (BaseRing R))
  have hexp : rightUnit R (a₁ R ^ 4) =
      algebraMap (BaseRing R) (ArrowRing R) (a₁ R ^ 4) +
        (8 * a₁ R ^ 3 + 48 * a₃ R) • s R + (24 * a₁ R ^ 2) • s R ^ 2 +
        (16 * a₁ R) • s R ^ 3 + (48 * a₁ R) • t R + (96 : BaseRing R) • (s R * t R) +
        (0 : BaseRing R) • (s R ^ 2 * t R) + (0 : BaseRing R) • (s R ^ 3 * t R) := by
    rw [map_pow, rightUnit_a₁]
    simp only [ArrowRingOf.smul_eq_algebraMap_mul, map_add, map_mul, map_pow, map_ofNat, map_zero]
    linear_combination 16 * ArrowRingOf.s_pow_four (BaseRing R) (a₁ R) (a₃ R)
  rw [transfer_apply, hexp, trace_linearCombination, universalCurve_c₄]
  linear_combination 16 * a₁ R ^ 4 * invOf_mul_self (3 : BaseRing R)

/-- `transfer (a₁³ a₃) = 2 c₆` in `BaseRing R`. -/
theorem transfer_a₁_cube_mul_a₃ :
    transfer R (a₁ R ^ 3 * a₃ R) = 2 * (universalCurve R).c₆ := by
  let _ := invertibleThreeOfRingHom (algebraMap R (BaseRing R))
  have h3 : transfer R (3 * a₁ R ^ 3 * a₃ R) = 6 * (universalCurve R).c₆ := by
    have hexp : rightUnit R (3 * a₁ R ^ 3 * a₃ R) =
        algebraMap (BaseRing R) (ArrowRing R) (3 * a₁ R ^ 3 * a₃ R) +
          (a₁ R ^ 5 + 54 * a₁ R ^ 2 * a₃ R) • s R +
          (7 * a₁ R ^ 4 + 60 * a₁ R * a₃ R) • s R ^ 2 +
          (6 * a₁ R ^ 3 + 24 * a₃ R) • s R ^ 3 + (42 * a₁ R ^ 3) • t R +
          (132 * a₁ R ^ 2) • (s R * t R) + (120 * a₁ R) • (s R ^ 2 * t R) +
          (48 : BaseRing R) • (s R ^ 3 * t R) := by
      rw [show 3 * a₁ R ^ 3 * a₃ R = a₁ R ^ 3 * (3 * a₃ R) by ring, map_mul, map_pow, rightUnit_a₁,
        rightUnit_three_mul_a₃]
      simp only [ArrowRingOf.smul_eq_algebraMap_mul, map_add, map_mul, map_pow, map_ofNat]
      linear_combination
        (8 * algebraMap (BaseRing R) (ArrowRing R) (a₁ R) * s R +
            12 * algebraMap (BaseRing R) (ArrowRing R) (a₁ R) ^ 2) *
          ArrowRingOf.s_pow_four (BaseRing R) (a₁ R) (a₃ R)
    rw [transfer_apply, hexp, trace_linearCombination, universalCurve_c₆]
    linear_combination -10 * a₁ R ^ 6 * invOf_mul_self (3 : BaseRing R)
  have hsmul : (3 : R) • (a₁ R ^ 3 * a₃ R) = 3 * a₁ R ^ 3 * a₃ R := by
    rw [baseRing_smul_eq_algebraMap_mul, map_ofNat]
    ring
  have hmap := congrArg (fun x : BaseRing R ↦ ⅟(3 : R) • x) h3
  rw [← hsmul, LinearMap.map_smul, smul_smul, invOf_mul_self, one_smul,
    baseRing_smul_eq_algebraMap_mul] at hmap
  have h3B : algebraMap R (BaseRing R) ⅟(3 : R) * 3 = 1 := by
    rw [← map_ofNat (algebraMap R (BaseRing R)) 3, ← map_mul, invOf_mul_self, map_one]
  linear_combination hmap + 2 * (universalCurve R).c₆ * h3B

/-- Explicit specialization check at `(a₁, a₃) = (1, 1)`:
`(transfer R (27 * a₃²))(1, 1) = 2 * (-1 + 36 - 216) = -362`. -/
theorem eval₂_one_one_transfer_twentySeven_mul_a₃_sq :
    eval₂ (RingHom.id R) ![1, 1] (transfer R (27 * a₃ R ^ 2)) = -362 := by
  rw [transfer_twentySeven_mul_a₃_sq, universalCurve_c₆, a₁_def, a₃_def]
  simp
  ring

/-- **Ideal containment for the `Γ₁(3)` algebraic transfer**: when `3` is invertible in `R`, the
ideal of `invariantSubalgebra R` generated by `8`, `2c₄` and `2c₆` lies in the image of
`transferToInvariants R` (Carrick–Davies–van Nigtevecht, §4.2, Lemma 4.8 / Corollary 4.9). -/
theorem span_eight_two_c₄_two_c₆_le_range_transferToInvariants :
    Ideal.span
      ({⟨8, eight_mem_invariantSubalgebra R⟩,
        ⟨2 * (universalCurve R).c₄, two_mul_c₄_mem_invariantSubalgebra R⟩,
        ⟨2 * (universalCurve R).c₆, two_mul_c₆_mem_invariantSubalgebra R⟩} :
        Set (invariantSubalgebra R)) ≤
      LinearMap.range (transferToInvariants R) := by
  rw [Ideal.span_le]
  rintro x (rfl | rfl | rfl)
  · exact ⟨1, Subtype.ext (transfer_one R)⟩
  · exact ⟨3 * a₁ R * a₃ R, Subtype.ext (transfer_three_mul_a₁_mul_a₃ R)⟩
  · exact ⟨27 * a₃ R ^ 2, Subtype.ext (transfer_twentySeven_mul_a₃_sq R)⟩

end InvertibleThree

/-! ### Consequences under `IsUnit (3 : R)` and over `ℤ_{(2)}` -/

section AtPrimeTwo

/-- Over any commutative ring `R` in which `3` is a unit, `{8, 2c₄, 2c₆}` is contained in the
range of `transfer R` and every transfer lies in `invariantSubalgebra R`. -/
theorem eight_two_c₄_two_c₆_subset_range_transfer_of_isUnit_three {R : Type*} [CommRing R]
    (h3 : IsUnit (3 : R)) :
    ({8, 2 * (universalCurve R).c₄, 2 * (universalCurve R).c₆} : Set (BaseRing R)) ⊆
      LinearMap.range (transfer R) ∧
      ∀ x : BaseRing R, transfer R x ∈ invariantSubalgebra R := by
  let _ := h3.invertible
  refine ⟨?_, transfer_mem_invariantSubalgebra R⟩
  rintro _ (rfl | rfl | rfl)
  · exact ⟨1, transfer_one R⟩
  · exact ⟨3 * a₁ R * a₃ R, transfer_three_mul_a₁_mul_a₃ R⟩
  · exact ⟨27 * a₃ R ^ 2, transfer_twentySeven_mul_a₃_sq R⟩

/-- In any localization `R` of a commutative ring `A` at a prime ideal `P` not containing `3`,
`3` is a unit in `R`. -/
theorem isUnit_three_of_atPrime {A : Type*} [CommRing A] (R : Type*) [CommRing R] [Algebra A R]
    (P : Ideal A) [P.IsPrime] [IsLocalization.AtPrime R P] (h3 : (3 : A) ∉ P) :
    IsUnit (3 : R) := by
  simpa [map_ofNat] using IsLocalization.map_units R (⟨(3 : A), h3⟩ : P.primeCompl)

/-- **Prime-localization transfer theorem** (Carrick–Davies–van Nigtevecht, §4.2, Corollary 4.9
for `A = ℤ`, `P = (2)`): over any localization `R` of a commutative ring `A` at a prime ideal `P`
not containing `3`, `ArrowRing R` has rank `8` over `BaseRing R`, every transfer lies in
`invariantSubalgebra R`, and `8`, `2c₄` and `2c₆` all lie in `LinearMap.range (transfer R)`. -/
theorem transfer_subset_range_of_atPrime {A : Type*} [CommRing A] (R : Type*) [CommRing R]
    [Algebra A R] (P : Ideal A) [P.IsPrime] [IsLocalization.AtPrime R P] (h3 : (3 : A) ∉ P) :
    Module.finrank (BaseRing R) (ArrowRing R) = 8 ∧
      ({8, 2 * (universalCurve R).c₄, 2 * (universalCurve R).c₆} : Set (BaseRing R)) ⊆
        LinearMap.range (transfer R) ∧
      ∀ x : BaseRing R, transfer R x ∈ invariantSubalgebra R := by
  have h3u := isUnit_three_of_atPrime R P h3
  let _ := h3u.invertible
  have _ : Nontrivial R := IsLocalization.AtPrime.nontrivial R P
  exact ⟨finrank_arrowRing_eq_eight R,
    eight_two_c₄_two_c₆_subset_range_transfer_of_isUnit_three h3u⟩

private theorem three_notMem_span_two : (3 : ℤ) ∉ Ideal.span {(2 : ℤ)} := by
  rw [Ideal.mem_span_singleton]
  decide

/-- Concrete `2`-local (`ℤ_{(2)}`) instantiation on `Localization.AtPrime (Ideal.span {(2 : ℤ)})`
(Carrick–Davies–van Nigtevecht, §4.2, Corollary 4.9). -/
theorem transfer_subset_range_localizationAtPrime_two :
    have := (Ideal.span_singleton_prime (two_ne_zero : (2 : ℤ) ≠ 0)).mpr Int.prime_two
    let Z2 := Localization.AtPrime (Ideal.span {(2 : ℤ)})
    Module.finrank (BaseRing Z2) (ArrowRing Z2) = 8 ∧
      ({8, 2 * (universalCurve Z2).c₄, 2 * (universalCurve Z2).c₆} : Set (BaseRing Z2)) ⊆
        LinearMap.range (transfer Z2) ∧
      ∀ x : BaseRing Z2, transfer Z2 x ∈ invariantSubalgebra Z2 := by
  have := (Ideal.span_singleton_prime (two_ne_zero : (2 : ℤ) ≠ 0)).mpr Int.prime_two
  exact transfer_subset_range_of_atPrime (Localization.AtPrime (Ideal.span {(2 : ℤ)}))
    (Ideal.span {(2 : ℤ)}) three_notMem_span_two

end AtPrimeTwo

end TauCeti.Gamma1ThreeHopfAlgebroid
