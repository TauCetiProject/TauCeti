module

public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import TauCeti.AlgebraicGeometry.EllipticCurve.Invariants.AlgebraicIndependent

/-!
# The presentation of `ℤ[c₄, c₆, Δ]`

For any Weierstrass curve `W` over a commutative ring `R` whose invariants `c₄` and `c₆` are
algebraically independent over `ℤ`, the invariants `c₄`, `c₆` and `Δ` satisfy exactly one relation,
`c₄³ - c₆² = 1728Δ` (`WeierstrassCurve.c_relation`): the kernel of the evaluation
`ℤ[C₄, C₆, D] → R`, `C₄, C₆, D ↦ W.c₄, W.c₆, W.Δ`, is the principal ideal generated by
`C₄³ - C₆² - 1728D` (`WeierstrassCurve.ker_aeval_c₄_c₆_Δ`), so `ℤ[W.c₄, W.c₆, W.Δ]` is isomorphic
to `ℤ[C₄, C₆, D]/(C₄³ - C₆² - 1728D)` (`WeierstrassCurve.adjoinC₄C₆ΔEquiv`).

Applying this to the universal Weierstrass equation over `ℤ[a₁, a₂, a₃, a₄, a₆]` via
`WeierstrassCurve.Universal.algebraicIndependent_c₄_c₆` presents the ring of integral modular
forms of level one; the same theorem applies to the Tate curve over `ℤ⟦q⟧`.

The proof has two steps. Modulo the relation, `1728D` is congruent to `C₄³ - C₆²`, so some
`1728ⁿ`-multiple of every polynomial is congruent to a polynomial in `C₄` and `C₆` alone; if the
original polynomial lies in the kernel, that polynomial in `C₄` and `C₆` vanishes by the algebraic
independence of `W.c₄` and `W.c₆`. Second, the relation is coprime to every nonzero integer, since
it takes the value `1` at `(C₄, C₆, D) = (1, 0, 0)`; so the power of `1728` can be cancelled.

## References

* P. Deligne, *Courbes elliptiques : formulaire d'après J. Tate*, in *Modular functions of one
  variable IV*, Lecture Notes in Math. 476, Springer, 1975.
* T. Bauer, *Computation of the homotopy of the spectrum tmf*, in *Groups, homotopy and
  configuration spaces*, Geom. Topol. Monogr. 13, 2008, §3.
-/

public section

noncomputable section

namespace WeierstrassCurve

open MvPolynomial

/-- The relation `C₄³ - C₆² - 1728D` among the variables `C₄ = X 0`, `C₆ = X 1`, `D = X 2`. -/
private abbrev relation : MvPolynomial (Fin 3) ℤ := X 0 ^ 3 - X 1 ^ 2 - 1728 * X 2

/-- The relation is coprime to every nonzero integer: it evaluates to `1` at `(1, 0, 0)`. -/
private lemma isRelPrime_relation_C {a : ℤ} (ha : a ≠ 0) : IsRelPrime relation (C a) := by
  induction a using UniqueFactorizationMonoid.induction_on_prime with
  | h₁ => exact absurd rfl ha
  | h₂ x hx => exact (hx.map C).isRelPrime_right
  | h₃ a p ha₀ hp ih =>
    rw [map_mul]
    refine IsRelPrime.mul_right ?_ (ih ha₀)
    refine (((prime_C_iff (Fin 3)).mpr hp).irreducible.isRelPrime_iff_not_dvd.mpr fun h ↦ ?_).symm
    have := map_dvd (eval ![1, 0, 0]) h
    simp only [eval_C, map_sub, map_pow, map_mul, eval_X, map_ofNat] at this
    exact hp.not_isUnit (isUnit_of_dvd_one (by simpa using this))

/-- Modulo the relation, some `1728ⁿ`-multiple of every polynomial in `C₄`, `C₆`, `D` is a
polynomial in `C₄` and `C₆` alone. -/
private lemma exists_relation_dvd (P : MvPolynomial (Fin 3) ℤ) :
    ∃ (n : ℕ) (R : MvPolynomial (Fin 2) ℤ),
      relation ∣ 1728 ^ n * P - rename Fin.castSucc R := by
  induction P using MvPolynomial.induction_on with
  | C a => exact ⟨0, C a, by simp⟩
  | add P Q hP hQ =>
    obtain ⟨m, R, hR⟩ := hP
    obtain ⟨n, S, hS⟩ := hQ
    refine ⟨m + n, 1728 ^ n * R + 1728 ^ m * S, ?_⟩
    convert (hR.mul_left (1728 ^ n)).add (hS.mul_left (1728 ^ m)) using 1
    simp only [map_add, map_mul, map_pow, map_ofNat]
    ring
  | mul_X P i hP =>
    obtain ⟨m, R, hR⟩ := hP
    -- The variable `X i` reduces to `X i` for `i = 0, 1` and `1728 X 2` reduces to `X 0³ - X 1²`.
    obtain ⟨n, S, hS⟩ : ∃ (n : ℕ) (S : MvPolynomial (Fin 2) ℤ),
        relation ∣ 1728 ^ n * X i - rename Fin.castSucc S := by
      fin_cases i
      · exact ⟨0, X 0, by simp⟩
      · exact ⟨0, X 1, by simp⟩
      · exact ⟨1, X 0 ^ 3 - X 1 ^ 2, -1, by simp⟩
    refine ⟨m + n, R * S, ?_⟩
    convert (hR.mul_left (1728 ^ n * X i)).add (hS.mul_left (rename Fin.castSucc R)) using 1
    simp only [map_mul]
    ring

/-- For any Weierstrass curve `W` whose invariants `c₄` and `c₆` are algebraically independent over
`ℤ`, the kernel of the evaluation `ℤ[C₄, C₆, D] → R` at `W.c₄`, `W.c₆`, `W.Δ` is generated by
`C₄³ - C₆² - 1728D`. -/
theorem ker_aeval_c₄_c₆_Δ {R : Type*} [CommRing R] [Algebra ℤ R] (W : WeierstrassCurve R)
    (hind : AlgebraicIndependent ℤ ![W.c₄, W.c₆]) :
    RingHom.ker (aeval (R := ℤ) ![W.c₄, W.c₆, W.Δ]) =
      Ideal.span {X 0 ^ 3 - X 1 ^ 2 - 1728 * X 2} := by
  have hrel : aeval (R := ℤ) ![W.c₄, W.c₆, W.Δ] relation = 0 := by
    simp only [map_sub, map_pow, map_mul, map_ofNat, aeval_X]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
      Matrix.tail_cons]
    linear_combination -W.c_relation
  refine le_antisymm (fun P hP ↦ ?_) ((Ideal.span_le (α := MvPolynomial (Fin 3) ℤ)).mpr ?_)
  · rw [RingHom.mem_ker] at hP
    rw [Ideal.mem_span_singleton]
    obtain ⟨n, Q, k, hk⟩ := exists_relation_dvd P
    -- Evaluating at the invariants, the polynomial `Q` in `C₄` and `C₆` vanishes.
    have hQ : Q = 0 := by
      refine algebraicIndependent_iff_injective_aeval.mp hind ?_
      have := congrArg (aeval (R := ℤ) ![W.c₄, W.c₆, W.Δ]) hk
      rw [map_sub, map_mul, map_mul, hP, hrel, aeval_rename] at this
      simpa [show (![W.c₄, W.c₆, W.Δ] ∘ Fin.castSucc) = ![W.c₄, W.c₆] by
        ext i; fin_cases i <;> rfl] using this
    have h1728 : relation ∣ C (1728 ^ n) * P := ⟨k, by simpa [hQ] using hk⟩
    exact (isRelPrime_relation_C (pow_ne_zero n (by norm_num))).dvd_of_dvd_mul_left h1728
  · simpa using hrel

private lemma range_aeval_c₄_c₆_Δ {R : Type*} [CommRing R] [Algebra ℤ R]
    (W : WeierstrassCurve R) :
    (aeval (R := ℤ) ![W.c₄, W.c₆, W.Δ]).range =
      Algebra.adjoin ℤ {W.c₄, W.c₆, W.Δ} := by
  rw [← Algebra.adjoin_range_eq_range_aeval]
  simp only [Matrix.range_cons, Matrix.range_empty, Set.union_empty, Set.singleton_union]

/-- For any Weierstrass curve `W` whose invariants `c₄` and `c₆` are algebraically independent over
`ℤ`, the subring `ℤ[W.c₄, W.c₆, W.Δ]` of `R` is presented by `c₄³ - c₆² = 1728Δ`. -/
def adjoinC₄C₆ΔEquiv {R : Type*} [CommRing R] [Algebra ℤ R] (W : WeierstrassCurve R)
    (hind : AlgebraicIndependent ℤ ![W.c₄, W.c₆]) :
    (MvPolynomial (Fin 3) ℤ ⧸
        Ideal.span {(X 0 ^ 3 - X 1 ^ 2 - 1728 * X 2 : MvPolynomial (Fin 3) ℤ)}) ≃ₐ[ℤ]
      Algebra.adjoin ℤ {W.c₄, W.c₆, W.Δ} :=
  ((Ideal.quotientEquivAlgOfEq (A := MvPolynomial (Fin 3) ℤ) ℤ
      (W.ker_aeval_c₄_c₆_Δ hind)).symm.trans
    (Ideal.quotientKerEquivRange (aeval (R := ℤ) (σ := Fin 3)
      ![W.c₄, W.c₆, W.Δ]))).trans
    (Subalgebra.equivOfEq _ _ (W.range_aeval_c₄_c₆_Δ))

/-- The presentation `W.adjoinC₄C₆ΔEquiv` sends the class of `P` to `P(W.c₄, W.c₆, W.Δ)`. -/
@[simp]
theorem adjoinC₄C₆ΔEquiv_mk {R : Type*} [CommRing R] [Algebra ℤ R] (W : WeierstrassCurve R)
    (hind : AlgebraicIndependent ℤ ![W.c₄, W.c₆]) (P : MvPolynomial (Fin 3) ℤ) :
    (W.adjoinC₄C₆ΔEquiv hind (Ideal.Quotient.mk _ P) : R) =
      aeval (R := ℤ) ![W.c₄, W.c₆, W.Δ] P :=
  (rfl)

end WeierstrassCurve
