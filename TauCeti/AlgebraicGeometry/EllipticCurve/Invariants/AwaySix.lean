module

public import Mathlib.RingTheory.AlgebraicIndependent.Basic
public import TauCeti.AlgebraicGeometry.EllipticCurve.Universal

/-!
# The Weierstrass invariant algebra away from 6

Over any commutative ring in which 2 and 3 are invertible, the algebra generated by the
invariants of the universal Weierstrass equation is a polynomial algebra on `c₄` and `c₆`.
The discriminant is redundant: it is `(c₄³ - c₆²)/1728`.

Here the coefficient ring may have zero divisors or nilpotents, or even be the zero ring.
Algebraic independence is proved by a polynomial retraction: specialize to the short equation
with coefficients `-C₄/48` and `-C₆/864`. In particular this gives the presentation over
`ℤ[1/6]` without passing to a fraction field or assuming characteristic zero.

This is an algebra presentation of the base-changed integral invariant algebra, not a
comparison with sections on a moduli stack or a claim that taking invariants commutes with
arbitrary base change.

## References

* T. Bauer, *Computation of the homotopy of the spectrum tmf*, §3.
* P. Goerss, *Topological modular forms [after Hopkins, Miller, and Lurie]*, §3.1.
-/

public section

noncomputable section

namespace WeierstrassCurve

open MvPolynomial

/-- If `1728` is invertible in the scalar ring, adjoining the discriminant adds nothing to
the algebra generated by the two `c`-invariants. This holds for singular equations as well. -/
theorem adjoin_c₄_c₆_Δ_eq {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (W : WeierstrassCurve A) (h : IsUnit (1728 : R)) :
    Algebra.adjoin R {W.c₄, W.c₆, W.Δ} = Algebra.adjoin R {W.c₄, W.c₆} := by
  let := h.invertible
  have hΔ : W.Δ = algebraMap R A (⅟(1728 : R)) * (W.c₄ ^ 3 - W.c₆ ^ 2) := by
    rw [← W.c_relation, ← mul_assoc, ← map_ofNat (algebraMap R A) 1728, ← map_mul,
      invOf_mul_self, map_one, one_mul]
  apply le_antisymm
  · refine Algebra.adjoin_le ?_
    rintro _ (rfl | rfl | rfl)
    · exact Algebra.subset_adjoin (by simp)
    · exact Algebra.subset_adjoin (by simp)
    · rw [hΔ]
      exact mul_mem (Subalgebra.algebraMap_mem _ _) (sub_mem
        (pow_mem (Algebra.subset_adjoin (by simp)) _) (pow_mem
          (Algebra.subset_adjoin (by simp)) _))
  · exact Algebra.adjoin_mono (by rintro x (rfl | rfl) <;> simp)

namespace Universal

variable (R : Type*) [CommRing R] [Invertible (2 : R)] [Invertible (3 : R)]

/-- The universal `c₄,c₆` remain algebraically independent after base change to any ring
in which `2` and `3` are invertible, with no reducedness or characteristic-zero hypothesis. -/
theorem algebraicIndependent_map_c₄_c₆ :
    AlgebraicIndependent R ![MvPolynomial.map (Int.castRingHom R) curve.c₄,
      MvPolynomial.map (Int.castRingHom R) curve.c₆] := by
  let a : Coeff → MvPolynomial (Fin 2) R := Coeff.rec 0 0 0
    (-(C (⅟(2 : R) ^ 4 * ⅟(3 : R))) * X 0)
    (-(C (⅟(2 : R) ^ 5 * ⅟(3 : R) ^ 3)) * X 1)
  have h₄ : aeval a (MvPolynomial.map (Int.castRingHom R) curve.c₄) = X 0 := by
    simp only [c₄, b₂, b₄, curve_a₁, curve_a₂, curve_a₃, curve_a₄,
      map_sub, map_add, map_mul, map_pow, map_ofNat, map_X, aeval_X]
    simp only [a, mul_zero, add_zero, zero_pow (by decide : 2 ≠ 0), map_mul, map_pow]
    calc
      0 - 24 * (2 * (-(C (⅟(2 : R)) ^ 4 * C (⅟(3 : R))) * X (0 : Fin 2))) =
          C ((2 * ⅟(2 : R)) ^ 4 * (3 * ⅟(3 : R))) * X 0 := by
        simp only [map_mul, map_pow, map_ofNat]; ring
      _ = X 0 := by simp
  have h₆ : aeval a (MvPolynomial.map (Int.castRingHom R) curve.c₆) = X 1 := by
    simp only [c₆, b₂, b₄, b₆, curve_a₁, curve_a₂, curve_a₃, curve_a₄, curve_a₆,
      map_sub, map_add, map_mul, map_pow, map_neg, map_ofNat, map_X, aeval_X]
    simp only [a, zero_pow (by decide : 2 ≠ 0), zero_pow (by decide : 3 ≠ 0),
      mul_zero, zero_mul, add_zero, zero_add, neg_zero, zero_sub, map_mul, map_pow]
    calc
      -(216 * (4 * (-(C (⅟(2 : R)) ^ 5 * C (⅟(3 : R)) ^ 3) * X (1 : Fin 2)))) =
          C ((2 * ⅟(2 : R)) ^ 5 * (3 * ⅟(3 : R)) ^ 3) * X 1 := by
        simp only [map_mul, map_pow, map_ofNat]; ring
      _ = X 1 := by simp
  have h : aeval a ∘ ![MvPolynomial.map (Int.castRingHom R) curve.c₄,
      MvPolynomial.map (Int.castRingHom R) curve.c₆] = X := by
    funext i
    fin_cases i
    · exact h₄
    · exact h₆
  exact AlgebraicIndependent.of_comp (aeval a) (h ▸ algebraicIndependent_X (Fin 2) R)

/-- Away from `6`, the algebra generated by the base-changed integral Weierstrass invariants
is freely generated by `c₄` and `c₆`. The variables have weights `4` and `6`; the discriminant
is the polynomial `(C₄³ - C₆²)/1728`. -/
def adjoinC₄C₆Equiv : MvPolynomial (Fin 2) R ≃ₐ[R]
    Algebra.adjoin R {MvPolynomial.map (Int.castRingHom R) curve.c₄,
      MvPolynomial.map (Int.castRingHom R) curve.c₆,
      MvPolynomial.map (Int.castRingHom R) curve.Δ} :=
  (algebraicIndependent_map_c₄_c₆ R).aevalEquiv.trans
    (Subalgebra.equivOfEq _ _ (by
      rw [Matrix.range_cons_cons_empty]
      symm
      simpa only [map_c₄, map_c₆, map_Δ] using
        (curve.map (MvPolynomial.map (Int.castRingHom R))).adjoin_c₄_c₆_Δ_eq
          (R := R) (by
            have h : (1728 : R) = 2 ^ 6 * 3 ^ 3 := by norm_num
            rw [h]
            exact (isUnit_of_invertible (2 : R)).pow 6 |>.mul
              ((isUnit_of_invertible (3 : R)).pow 3))))

/-- The polynomial presentation evaluates its variables at the native `c`-invariants. -/
@[simp]
theorem adjoinC₄C₆Equiv_apply (p : MvPolynomial (Fin 2) R) :
    (adjoinC₄C₆Equiv R p : MvPolynomial Coeff R) =
      aeval ![MvPolynomial.map (Int.castRingHom R) curve.c₄,
        MvPolynomial.map (Int.castRingHom R) curve.c₆] p :=
  (algebraicIndependent_map_c₄_c₆ R).algebraMap_aevalEquiv p

/-- The first polynomial generator represents `c₄`. -/
@[simp]
theorem adjoinC₄C₆Equiv_symm_c₄ :
    (adjoinC₄C₆Equiv R).symm
      ⟨MvPolynomial.map (Int.castRingHom R) curve.c₄, Algebra.subset_adjoin (by simp)⟩ = X 0 := by
  apply (adjoinC₄C₆Equiv R).injective
  ext
  simp

/-- The second polynomial generator represents `c₆`, with the native sign convention. -/
@[simp]
theorem adjoinC₄C₆Equiv_symm_c₆ :
    (adjoinC₄C₆Equiv R).symm
      ⟨MvPolynomial.map (Int.castRingHom R) curve.c₆, Algebra.subset_adjoin (by simp)⟩ = X 1 := by
  apply (adjoinC₄C₆Equiv R).injective
  ext
  simp

/-- The discriminant in the polynomial presentation is `(C₄³ - C₆²)/1728`. -/
@[simp]
theorem adjoinC₄C₆Equiv_symm_Δ :
    (adjoinC₄C₆Equiv R).symm
      ⟨MvPolynomial.map (Int.castRingHom R) curve.Δ, Algebra.subset_adjoin (by simp)⟩ =
        C (⅟(2 : R) ^ 6 * ⅟(3 : R) ^ 3) * (X 0 ^ 3 - X 1 ^ 2) := by
  apply (adjoinC₄C₆Equiv R).injective
  apply Subtype.ext
  rw [AlgEquiv.apply_symm_apply, adjoinC₄C₆Equiv_apply]
  simp only [map_mul, map_sub, map_pow, aeval_C, aeval_X,
    Matrix.cons_val_zero, Matrix.cons_val_one]
  have hc := congrArg (MvPolynomial.map (Int.castRingHom R)) curve.c_relation
  simp only [map_mul, map_ofNat, map_sub, map_pow] at hc
  rw [← hc]
  have h : (⅟(2 : R) ^ 6 * ⅟(3 : R) ^ 3) * 1728 = 1 := by
    calc
      _ = (2 * ⅟(2 : R)) ^ 6 * (3 * ⅟(3 : R)) ^ 3 := by ring
      _ = 1 := by simp
  symm
  calc
    _ = algebraMap R (MvPolynomial Coeff R)
        ((⅟(2 : R) ^ 6 * ⅟(3 : R) ^ 3) * 1728) *
          MvPolynomial.map (Int.castRingHom R) curve.Δ := by
      simp only [map_mul, map_pow, map_ofNat]
      ring
    _ = _ := by rw [h, map_one, one_mul]

end Universal

end WeierstrassCurve
