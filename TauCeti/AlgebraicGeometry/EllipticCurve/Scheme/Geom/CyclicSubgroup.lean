import TauCeti.AlgebraicGeometry.IdealSheaf.BaseChange

/-!
# Cyclic subgroups of an elliptic curve

Let `E` be an elliptic curve over a scheme `S`. Following Katz and Mazur, a closed subscheme
`G ⊆ E` is a **cyclic subgroup of order `N`** when it is a finite locally free subgroup scheme of
`E` of rank `N` which, fppf-locally on `S`, is generated by a point of exact order `N`: there is
an fppf covering `{Sᵢ ⟶ S}` and, on each base change `E_{Sᵢ}`, a point `Pᵢ` of exact order `N`
such that `G_{Sᵢ}` is the divisor `[Pᵢ] + [2Pᵢ] + ⋯ + [NPᵢ]`
(`EllipticCurveGeom.IsCyclicSubgroup`). A cyclic subgroup of order `N` is the same thing as a
`[Γ₀(N)]`-structure on `E`.

A generator is only required to exist after an fppf base change, and in residue characteristic
dividing `N` it is a Drinfeld point of exact order `N`, not necessarily a point whose multiples
are distinct. The closed subscheme is recorded by its ideal
sheaf, as for the divisor `[P] + ⋯ + [NP]` (`EllipticCurveGeom.multiplesDivisor`).

The subgroup `⟨P⟩ = [P] + ⋯ + [NP]` generated by a point `P` of exact order `N` is cyclic of order
`N` (`EllipticCurveGeom.IsOfExactOrder.isCyclicSubgroup_multiplesDivisor`), and cyclic subgroups
are stable under arbitrary base change (`EllipticCurveGeom.IsCyclicSubgroup.comap`): the inverse
image of a cyclic subgroup along a pullback square of elliptic curves is again cyclic of the same
order. Every cyclic subgroup of order `N` is killed by `N`, by Deligne's rank theorem, and hence
is canonically a closed subgroup of `E[N]`
(`EllipticCurveGeom.IsCyclicSubgroup.toTorsion`). This containment is scheme-theoretic, so it
includes the infinitesimal part of the subgroup in residue characteristic dividing `N`.

## Main definitions

* `TauCeti.AlgebraicGeometry.EllipticCurveGeom.IsCyclicSubgroup E I N`: the closed subscheme of
  `E` cut out by the ideal sheaf `I` is a cyclic subgroup of order `N`.

## Main results

* `TauCeti.AlgebraicGeometry.EllipticCurveGeom.IsOfExactOrder.isCyclicSubgroup_multiplesDivisor`:
  a point of exact order `N` generates a cyclic subgroup of order `N`.
* `TauCeti.AlgebraicGeometry.EllipticCurveGeom.IsCyclicSubgroup.toTorsion`: a cyclic subgroup of
  order `N` is canonically a closed subgroup of `E[N]`.
* `TauCeti.AlgebraicGeometry.EllipticCurveGeom.IsCyclicSubgroup.comap`: cyclic subgroups are
  stable under base change.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §1.4 (points of exact order),
  §1.10 (cyclic group schemes) and §3.4 (`[Γ₀(N)]`-structures).
-/

public section

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory AlgebraicGeometry MonObj

universe u

namespace TauCeti.AlgebraicGeometry

namespace EllipticCurveGeom

variable {S : Scheme.{u}} (E : EllipticCurveGeom S)

/-- **Cyclic subgroups of order `N`** (Katz–Mazur, §§1.10 and 3.4). The closed subscheme `G` of
an elliptic curve `E` over `S` cut out by the ideal sheaf `I` is a cyclic subgroup of order `N`
when it is a subgroup scheme of `E`, finite locally free of constant rank `N` over `S`, and
fppf-locally on `S` generated by a point of exact order `N`: there is an fppf covering
`{Sᵢ ⟶ S}` such that on each base change `Eᵢ` of `E` to `Sᵢ` the inverse image of `G` is the
divisor `[Pᵢ] + ⋯ + [NPᵢ]` of a point `Pᵢ` of `Eᵢ` of exact order `N`. -/
structure IsCyclicSubgroup (I : E.carrier.IdealSheafData) (N : ℕ) : Prop where
  /-- The closed subscheme is a subgroup scheme of `E`. -/
  exists_grpObj_isMonHom : ∃ _ : GrpObj (Over.mk (I.subschemeι ≫ E.structureMap)),
    IsMonHom (Over.homMk I.subschemeι :
      Over.mk (I.subschemeι ≫ E.structureMap) ⟶ Over.mk E.structureMap)
  /-- The closed subscheme is finite over the base. -/
  isFinite : IsFinite (I.subschemeι ≫ E.structureMap)
  /-- The closed subscheme is flat over the base. -/
  flat : Flat (I.subschemeι ≫ E.structureMap)
  /-- The closed subscheme is locally of finite presentation over the base. -/
  locallyOfFinitePresentation : LocallyOfFinitePresentation (I.subschemeι ≫ E.structureMap)
  /-- The closed subscheme has rank `N` over every point of the base. -/
  finrank_eq (s : S) : (I.subschemeι ≫ E.structureMap).finrank s = N
  /-- Fppf-locally on the base, the closed subscheme is generated by a point of exact order
  `N`. -/
  exists_cover : ∃ 𝒰 : Scheme.Cover.{u} Scheme.fppfPrecoverage S, ∀ i,
    ∃ (E' : EllipticCurveGeom (𝒰.X i)) (g : E'.carrier ⟶ E.carrier)
      (_ : IsPullback g E'.structureMap E.structureMap (𝒰.f i))
      (_ : E'.zero ≫ g = 𝒰.f i ≫ E.zero) (P : 𝟙_ (Over (𝒰.X i)) ⟶ Over.mk E'.structureMap),
      E'.IsOfExactOrder P N ∧ I.comap g = E'.multiplesDivisor P N

variable {E}

/-- **A point of exact order `N` generates a cyclic subgroup of order `N`**: the divisor
`[P] + ⋯ + [NP]` of a point `P` of exact order `N` is a cyclic subgroup of order `N`, generated by
`P` over the base itself. -/
theorem IsOfExactOrder.isCyclicSubgroup_multiplesDivisor
    {P : 𝟙_ (Over S) ⟶ Over.mk E.structureMap} {N : ℕ} (h : E.IsOfExactOrder P N) :
    E.IsCyclicSubgroup (E.multiplesDivisor P N) N where
  exists_grpObj_isMonHom := isOfExactOrder_def.mp h
  isFinite := inferInstance
  flat := inferInstance
  locallyOfFinitePresentation := inferInstance
  finrank_eq s := congrFun (finrank_multiplesDivisor P N) s
  exists_cover := ⟨Scheme.Hom.cover
      (P := (@Flat ⊓ @LocallyOfFinitePresentation : MorphismProperty Scheme.{u})) (𝟙 S)
      ⟨inferInstance, inferInstance⟩,
    fun _ ↦ ⟨E, 𝟙 _, .id_horiz _, (Category.comp_id _).trans (Category.id_comp _).symm, P, h,
      Scheme.IdealSheafData.comap_id _⟩⟩

/-! ### Containment in the torsion subgroup -/

variable {I : E.carrier.IdealSheafData} {N : ℕ}

/-- **A cyclic subgroup of order `N` is killed by `N`.** Multiplication by `N` on `E`, restricted
to the closed subscheme cut out by `I`, is the zero section. This is an equality of scheme
morphisms, not only an equality on geometric points. -/
theorem IsCyclicSubgroup.subschemeι_comp_mulBy (h : E.IsCyclicSubgroup I N) :
    I.subschemeι ≫ (E.mulBy N).left = I.subschemeι ≫ E.structureMap ≫ E.zero := by
  let i : Over.mk (I.subschemeι ≫ E.structureMap) ⟶ Over.mk E.structureMap :=
    Over.homMk I.subschemeι
  obtain ⟨grp, hi⟩ := h.exists_grpObj_isMonHom
  let := grp
  let := hi
  have : Mono i := Over.mono_of_mono_left i
  have hiN : i ≫ E.mulBy N = 1 := by
    rw [comp_mulBy, zpow_natCast]
    exact GroupScheme.pow_eq_one_of_finrank_of_mono i h.isFinite h.flat
      h.locallyOfFinitePresentation h.finrank_eq
  simpa only [Over.comp_left, hom_one_left, i, Over.homMk_left, Over.mk_hom, Category.assoc]
    using congrArg Over.Hom.left hiN

/-- The canonical factorization of a cyclic subgroup of order `N` through the `N`-torsion
`E[N]`. -/
noncomputable def IsCyclicSubgroup.toTorsion (h : E.IsCyclicSubgroup I N) :
    Over.mk (I.subschemeι ≫ E.structureMap) ⟶ (E.torsion N).X :=
  let i : Over.mk (I.subschemeι ≫ E.structureMap) ⟶ Over.mk E.structureMap :=
    Over.homMk I.subschemeι
  torsionLift i (Over.OverMorphism.ext h.subschemeι_comp_mulBy)

/-- The factorization of a cyclic subgroup through `E[N]`, followed by the inclusion
`E[N] ⟶ E`, is the original closed immersion. -/
@[reassoc (attr := simp)]
theorem IsCyclicSubgroup.toTorsion_torsionι (h : E.IsCyclicSubgroup I N) :
    h.toTorsion ≫ E.torsionι N = Over.homMk I.subschemeι :=
  by simp [IsCyclicSubgroup.toTorsion]

/-- The canonical morphism from a cyclic subgroup of order `N` to `E[N]` is a closed
immersion. -/
noncomputable instance IsCyclicSubgroup.isClosedImmersion_toTorsion_left
    (h : E.IsCyclicSubgroup I N) : IsClosedImmersion h.toTorsion.left := by
  have hcomp := congrArg Over.Hom.left h.toTorsion_torsionι
  simp only [Over.comp_left, Over.homMk_left] at hcomp
  have hci : IsClosedImmersion (h.toTorsion.left ≫ (E.torsionι N).left) := by
    rw [hcomp]
    infer_instance
  let _ := hci
  exact .of_comp_isClosedImmersion h.toTorsion.left (E.torsionι N).left

/-- The canonical morphism from a cyclic subgroup of order `N` to `E[N]` is a monomorphism. -/
noncomputable instance IsCyclicSubgroup.mono_toTorsion (h : E.IsCyclicSubgroup I N) :
    Mono h.toTorsion :=
  mono_of_mono_fac h.toTorsion_torsionι

/-- A cyclic subgroup of order `N` is contained in `E[N]` as a closed subscheme. The order on
ideal sheaves reverses containment of the associated closed subschemes. -/
theorem IsCyclicSubgroup.ker_torsionι_le (h : E.IsCyclicSubgroup I N) :
    (E.torsionι N).left.ker ≤ I := by
  have hker := h.toTorsion.left.le_ker_comp (E.torsionι N).left
  simpa only [← Over.comp_left, h.toTorsion_torsionι, Over.homMk_left,
    Scheme.IdealSheafData.ker_subschemeι] using hker

section BaseChange

variable {S' : Scheme.{u}} {E' : EllipticCurveGeom S'} {g : E'.carrier ⟶ E.carrier}
  {f : S' ⟶ S} (hg : IsPullback g E'.structureMap E.structureMap f)
  (h0 : E'.zero ≫ g = f ≫ E.zero)

include hg h0 in
/-- **Cyclic subgroups are stable under base change** (Katz–Mazur, §3.4). Let `g : E' ⟶ E` be a
morphism of elliptic curves lying over `f : S' ⟶ S`, forming a pullback square with the structure
morphisms and carrying the zero section of `E'` to that of `E`. If the ideal sheaf `I` cuts out a
cyclic subgroup of `E` of order `N`, then its inverse image along `g` cuts out a cyclic subgroup of
`E'` of order `N`. -/
theorem IsCyclicSubgroup.comap {I : E.carrier.IdealSheafData} {N : ℕ}
    (h : E.IsCyclicSubgroup I N) : E'.IsCyclicSubgroup (I.comap g) N := by
  have := h.isFinite
  have := h.flat
  have := h.locallyOfFinitePresentation
  -- The closed subscheme of `I.comap g` is the base change of that of `I` along `f`.
  have hsub := I.isPullback_subschemeMap_comap _ hg
  refine
    { exists_grpObj_isMonHom := exists_grpObj_isMonHom_comap hg h0 I h.exists_grpObj_isMonHom
      isFinite := MorphismProperty.of_isPullback hsub ‹_›
      flat := MorphismProperty.of_isPullback hsub ‹_›
      locallyOfFinitePresentation := MorphismProperty.of_isPullback hsub ‹_›
      finrank_eq s := by rw [I.finrank_comap_of_isPullback _ g _ f hg, h.finrank_eq]
      exists_cover := ?_ }
  obtain ⟨𝒰, h𝒰⟩ := h.exists_cover
  -- Pull the covering back along `f`, and on each piece pull the generator back.
  refine ⟨𝒰.pullback₁ f, fun i ↦ ?_⟩
  obtain ⟨E₁, g₁, hg₁, h0₁, P, hP, hI⟩ := h𝒰 i
  let p₁ : (𝒰.pullback₁ f).X i ⟶ S' := (𝒰.pullback₁ f).f i
  let p₂ : (𝒰.pullback₁ f).X i ⟶ 𝒰.X i := pullback.snd f (𝒰.f i)
  have hp : p₁ ≫ f = p₂ ≫ 𝒰.f i := pullback.condition
  -- The base change of `E'` to `S' ×_S Sᵢ`, with its projection to `E'`.
  let E₂ := E'.baseChange p₁
  let g₂ : E₂.carrier ⟶ E'.carrier := (E'.baseChangeIso p₁).hom ≫ pullback.fst _ _
  have hg₂ : IsPullback g₂ E₂.structureMap E'.structureMap p₁ := E'.isPullback_baseChange p₁
  have h0₂ : E₂.zero ≫ g₂ = p₁ ≫ E'.zero := by
    simp [g₂, E₂, E'.zero_baseChangeIso_hom_assoc]
  -- The induced morphism from `E₂` to `E₁`, lying over `p₂`.
  have hk := isPullback_baseChangeLift hg₁ (hg₂.paste_horiz hg) hp.symm
  have h0k := zero_baseChangeLift hg₁ (hg₂.paste_horiz hg).toCommSq hp.symm h0₁
    (by simp [h0, reassoc_of% h0₂])
  refine ⟨E₂, g₂, hg₂, h0₂, pointsPullback hk h0k P, hP.pointsPullback hk h0k, ?_⟩
  rw [multiplesDivisor_pointsPullback hk h0k, ← hI, ← Scheme.IdealSheafData.comap_comp,
    ← Scheme.IdealSheafData.comap_comp, baseChangeLift_fst]

end BaseChange

end EllipticCurveGeom

end TauCeti.AlgebraicGeometry
