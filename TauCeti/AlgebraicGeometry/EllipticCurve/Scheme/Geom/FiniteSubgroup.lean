module

public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.PointsDivisor
public import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.NaiveLevel
import TauCeti.AlgebraicGeometry.GroupScheme.ClosedSubgroup.Criterion
import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.Torsion.Etale.Locus
import TauCeti.CategoryTheory.Monoidal.Cartesian.Over
import Mathlib.AlgebraicGeometry.Morphisms.FlatMono

/-!
# Finite subgroups generated by disjoint torsion sections

A finite group embedded fibrewise into an elliptic curve by torsion sections defines a finite
étale subgroup scheme when the torsion level is invertible. Its divisor is the union of its
disjoint sections. These results hold over arbitrary, possibly nonreduced bases and supply the
subgroup-divisor condition for naive points of exact order.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §1.4 and §3.7.
-/

public section

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory AlgebraicGeometry MonObj

universe u

namespace TauCeti.AlgebraicGeometry.EllipticCurveGeom

variable {S : Scheme.{u}} {E : EllipticCurveGeom S}

variable {A : Type*} [Group A] [Fintype A]
  {φ : A →* (𝟙_ (Over S) ⟶ Over.mk E.structureMap)}

/-- The divisor of a fibrewise injective finite family of sections killed by an invertible
level is étale over the base. -/
theorem IsFiberwiseInjective.etale_pointsDivisor (hφ : E.IsFiberwiseInjective φ)
    {N : ℕ} (hN : ∀ s : S, (N : S.residueField s) ≠ 0) (hkill : ∀ a, φ a ^ N = 1) :
    Etale ((E.pointsDivisor φ).subschemeι ≫ E.structureMap) := by
  exact E.etale_subscheme_of_ker_torsionι_le (E.pointsDivisor φ)
    (fun s ↦ by exact_mod_cast hN s) (hφ.ker_torsionι_left_le_pointsDivisor hkill)

-- The section cover is only used to restrict the group operations to this divisor.
omit [Group A] in
private theorem exists_sectionCover_pointsDivisor
    (φ : A → (𝟙_ (Over S) ⟶ Over.mk E.structureMap))
    [Etale ((E.pointsDivisor φ).subschemeι ≫ E.structureMap)] :
    ∃ s : A → (𝟙_ (Over S) ⟶ Over.mk ((E.pointsDivisor φ).subschemeι ≫ E.structureMap)),
      (∀ a, s a ≫ (Over.homMk (E.pointsDivisor φ).subschemeι :
        Over.mk ((E.pointsDivisor φ).subschemeι ≫ E.structureMap) ⟶
          Over.mk E.structureMap) = φ a) ∧
      (∀ a, IsOpenImmersion (s a).left) ∧ ∀ x, ∃ a t, (s a).left t = x := by
  classical
  let I := E.pointsDivisor φ
  let D := Over.mk (I.subschemeι ≫ E.structureMap)
  let i : D ⟶ Over.mk E.structureMap := Over.homMk I.subschemeι
  have : IsClosedImmersion i.left := inferInstanceAs (IsClosedImmersion I.subschemeι)
  have : Etale D.hom := inferInstanceAs
    (Etale ((E.pointsDivisor φ).subschemeι ≫ E.structureMap))
  let s (a : A) : 𝟙_ (Over S) ⟶ D :=
    closedImmersionOverLift i (φ a) (by simpa [i, I] using E.pointsDivisor_le_ker φ a)
  have hs (a : A) : s a ≫ i = φ a := closedImmersionOverLift_comp _ _ _
  have hsb (a : A) : (s a).left ≫ D.hom = 𝟙 S := Over.w (s a)
  have (a : A) : Etale (s a).left := by
    have : Etale ((s a).left ≫ D.hom) := by
      simpa only [hsb a] using (inferInstance : Etale (𝟙 S))
    exact Etale.of_comp _ D.hom
  have (a : A) : Mono (s a).left := by
    have : Mono (𝟙 S) := inferInstance
    exact mono_of_mono_fac (hsb a)
  have (a : A) : IsOpenImmersion (s a).left := .of_flat_of_mono _
  have hcovers (x : D.left) : ∃ a t, (s a).left t = x := by
    have hx := I.subschemeι.range_subset_ker_support ⟨x, rfl⟩
    rw [Scheme.IdealSheafData.ker_subschemeι] at hx
    rw [E.coe_support_pointsDivisor φ, Set.mem_iUnion] at hx
    obtain ⟨a, ha⟩ := hx
    obtain ⟨t, ht⟩ := ha
    refine ⟨a, t, I.subschemeι.injective ?_⟩
    have he : (s a).left ≫ I.subschemeι = (φ a).left := congrArg Over.Hom.left (hs a)
    rw [← Scheme.Hom.comp_apply, he]
    exact ht
  exact ⟨s, hs, inferInstance, hcovers⟩

/-- A fibrewise injective finite family of torsion sections cuts out a subgroup scheme.
The torsion level is required to be invertible on the base. -/
theorem IsFiberwiseInjective.exists_grpObj_isMonHom_pointsDivisor (hφ : E.IsFiberwiseInjective φ)
    {N : ℕ} (hN : ∀ s : S, (N : S.residueField s) ≠ 0) (hkill : ∀ a, φ a ^ N = 1) :
    ∃ _ : GrpObj (Over.mk ((E.pointsDivisor φ).subschemeι ≫ E.structureMap)),
      IsMonHom (Over.homMk (E.pointsDivisor φ).subschemeι :
        Over.mk ((E.pointsDivisor φ).subschemeι ≫ E.structureMap) ⟶ Over.mk E.structureMap) := by
  classical
  let I := E.pointsDivisor φ
  let D := Over.mk (I.subschemeι ≫ E.structureMap)
  let i : D ⟶ Over.mk E.structureMap := Over.homMk I.subschemeι
  have : Etale ((E.pointsDivisor φ).subschemeι ≫ E.structureMap) :=
    hφ.etale_pointsDivisor hN hkill
  have : IsClosedImmersion i.left := inferInstanceAs (IsClosedImmersion I.subschemeι)
  obtain ⟨s, hs, hsOpen, hcovers⟩ := exists_sectionCover_pointsDivisor φ
  have (a : A) : IsOpenImmersion (s a).left := hsOpen a
  let 𝒰 : D.left.OpenCover :=
    { I₀ := A
      X := fun _ ↦ S
      f := fun a ↦ (s a).left
      mem₀ := by
        rw [Scheme.presieve₀_mem_precoverage_iff]
        exact ⟨hcovers, fun a ↦ inferInstance⟩ }
  have : IsFinite D.hom :=
    inferInstanceAs (IsFinite ((E.pointsDivisor φ).subschemeι ≫ E.structureMap))
  have : IsProper (D ⊗ D).hom := by rw [Over.tensorObj_hom]; infer_instance
  have hqc {T : Over S} (f : T ⟶ Over.mk E.structureMap) [IsProper T.hom] :
      QuasiCompact f.left := by
    have : IsProper (f.left ≫ E.structureMap) := by
      exact (Over.w f).symm ▸ (inferInstance : IsProper T.hom)
    have := IsProper.of_comp f.left E.structureMap
    infer_instance
  have hcheck {T : Scheme.{u}} (f : T ⟶ E.carrier) [QuasiCompact f]
      (𝒱 : T.OpenCover) (h : ∀ a, I ≤ (𝒱.f a ≫ f).ker) : I ≤ f.ker := by
    rw [← f.iInf_ker_openCover_map_comp 𝒱]
    exact le_iInf h
  -- The section cover detects the three subgroup equations: the unit lies on the divisor,
  -- and multiplication and inversion preserve it after restriction to the section charts.
  apply (GroupScheme.exists_grpObj_isMonHom_iff_ker_le i).mpr
  have hi : i.left.ker = I := Scheme.IdealSheafData.ker_subschemeι I
  rw [hi]
  refine ⟨?_, ?_, ?_⟩
  · simpa [i, I, map_one, one_left] using E.pointsDivisor_le_ker φ 1
  · -- Cover the product by pairs of the disjoint sections.
    have := hqc ((i ⊗ₘ i) ≫ μ[Over.mk E.structureMap])
    apply hcheck _ (Scheme.Pullback.openCoverOfLeftRight 𝒰 𝒰 D.hom D.hom)
    rintro ⟨a, b⟩
    have h : (Scheme.Pullback.openCoverOfLeftRight 𝒰 𝒰 D.hom D.hom).f (a, b) ≫
        ((i ⊗ₘ i) ≫ μ[Over.mk E.structureMap]).left =
        pullback.fst ((s a).left ≫ D.hom) ((s b).left ≫ D.hom) ≫ (φ (a * b)).left := by
      have h := TauCeti.CategoryTheory.Over.pullback_map_comp_mul_left i (s a) (s b)
      rw [hs a, hs b, ← map_mul] at h
      exact h
    rw [h]
    exact (E.pointsDivisor_le_ker φ (a * b)).trans (Scheme.Hom.le_ker_comp _ _)
  · have := hqc (i ≫ ι[Over.mk E.structureMap])
    apply hcheck _ 𝒰
    intro a
    have h : 𝒰.f a ≫ (i ≫ ι[Over.mk E.structureMap]).left = (φ a⁻¹).left := by
      dsimp only [𝒰]
      rw [← Over.comp_left, ← Category.assoc, hs, GrpObj.inv_eq_inv, GrpObj.comp_inv,
        Category.comp_id, ← map_inv]
    rw [h]
    exact E.pointsDivisor_le_ker φ a⁻¹

end TauCeti.AlgebraicGeometry.EllipticCurveGeom
