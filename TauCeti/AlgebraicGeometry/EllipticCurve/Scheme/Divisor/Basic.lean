/-!
# The zero-section divisor of a projective Weierstrass model

For any Weierstrass curve `W` over a commutative ring (no ellipticity hypothesis needed), the zero
section `[0 : 1 : 0] : Spec R ⟶ projModel W` cuts out a relative effective Cartier divisor. This
file defines its ideal sheaf as `WeierstrassCurve.zeroSectionDivisor` and proves the same result
for every nonnegative multiple `n[0]`, represented by the power of that ideal sheaf.

The construction commutes with arbitrary pointed cartesian squares (in particular, change of the
coefficient ring and admissible changes of variables). Thus these divisors can be used uniformly
in families, including over nonreduced bases and singular models, as the divisors underlying the
pole sheaves `𝒪(n[0])`.

On the standard affine charts `D₊(Xᵢ)`, the divisor `[0]` is cut out by `X/Y` and `Z/Y` on
`D₊(Y)`, and is empty on `D₊(X)` and `D₊(Z)`. The divisor `3[0]` is the hyperplane section
`Z = 0`: on every chart `D₊(Xᵢ)` its ideal is generated by `Z/Xᵢ`. On `D₊(Y)`, write `x = X/Y` and
`z = Z/Y`; the Weierstrass equation reads `z (1 - t) = x³` with `t` in the ideal `(x, z)`, and this
forces `(x, z)³ = (z)`. On `D(t)` the ideal `(x, z)` is `(1)`, and on `D(1 - t)` it is `(x)` with
`x` regular because `z` is, showing `[0]` is effective Cartier without ellipticity. On `D₊(X)` the
equation exhibits `Z/X` as a unit. This holds for every Weierstrass curve over every commutative
ring, with no ellipticity hypothesis. It is the
divisor-theoretic input for identifying `𝒪(3[0])` with the restriction of the hyperplane bundle
`𝒪(1)` of `ℙ²`, and for bounding the poles of the Weierstrass coordinates `X/Z` and `Y/Z` along
`[0]`; neither identification is made here.

## Main results

* `WeierstrassCurve.isEffectiveCartier_zeroSectionDivisor` / `_pow`: `[0]` and `n[0]` are effective
  Cartier divisors without ellipticity.
* `WeierstrassCurve.isRelativeEffectiveCartier_zeroSectionDivisor`: `[0]` is a relative effective
  Cartier divisor.
* `WeierstrassCurve.isRelativeEffectiveCartier_zeroSectionDivisor_pow`: every `n[0]` is a relative
  effective Cartier divisor.
* `WeierstrassCurve.zeroSectionDivisor_eq_comap_of_isPullback` / `_pow_`: `[0]` and `n[0]` commute
  with arbitrary pointed cartesian squares.
* `WeierstrassCurve.zeroSectionDivisor_map`: `[0]` commutes with arbitrary base change.
* `WeierstrassCurve.zeroSectionDivisor_pow_map`: the same is true for `n[0]`.
* `WeierstrassCurve.zeroSectionDivisor_variableChange` / `_pow_`: `[0]` and `n[0]` commute with
  admissible changes of variables.
* `WeierstrassCurve.zeroSectionDivisor_comap_chartι_one` and
  `WeierstrassCurve.zeroSectionDivisor_comap_chartι_eq_top_of_ne_one`: `[0]` on the standard
  charts.
* `WeierstrassCurve.zeroSectionDivisor_pow_three_comap_chartι`: `3[0]` is the hyperplane section
  `Z = 0`.

## References

* N. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §2.2.
* [J. H. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], III.1: the line `Z = 0`
  meets the curve only at `[0 : 1 : 0]`, with multiplicity three.
-/

public section

open CategoryTheory Limits AlgebraicGeometry

universe u

namespace WeierstrassCurve

variable {R : Type u} [CommRing R] (W : WeierstrassCurve R)

/-- The relative divisor `[0]` on the projective Weierstrass model, represented by the ideal
sheaf of the zero section `[0 : 1 : 0]`. -/
noncomputable def zeroSectionDivisor : W.projModel.IdealSheafData :=
  W.projModelZero.ker

/-- The zero-section divisor is the ideal sheaf of `projModelZero`. -/
theorem zeroSectionDivisor_def : W.zeroSectionDivisor = W.projModelZero.ker :=
  (rfl)

section BaseChange

variable {W} {R' : Type u} [CommRing R'] {W' : WeierstrassCurve R'}
  {g : W'.projModel ⟶ W.projModel} {f : Spec (.of R') ⟶ Spec (.of R)}
  (hg : IsPullback g W'.projModelOver W.projModelOver f)
  (h0 : W'.projModelZero ≫ g = f ≫ W.projModelZero)

include hg h0 in
/-- **The zero-section divisor commutes with arbitrary pointed cartesian squares** of projective
Weierstrass models. -/
theorem zeroSectionDivisor_eq_comap_of_isPullback :
    W'.zeroSectionDivisor = W.zeroSectionDivisor.comap g :=
  hg.ker_eq_comap_of_comp_eq_id W.projModelZero_projModelOver W'.projModelZero_projModelOver h0

include hg h0 in
/-- **Every multiple `n[0]` commutes with arbitrary pointed cartesian squares** of projective
Weierstrass models. -/
theorem zeroSectionDivisor_pow_eq_comap_of_isPullback (n : ℕ) :
    W'.zeroSectionDivisor ^ n = (W.zeroSectionDivisor ^ n).comap g := by
  rw [zeroSectionDivisor_eq_comap_of_isPullback hg h0, Scheme.IdealSheafData.comap_pow]

end BaseChange

variable {R' : Type u} [CommRing R'] (f : R →+* R')

/-- **The zero-section divisor commutes with arbitrary base change.** Under the canonical map
`projModel (W.map f) ⟶ projModel W`, the inverse image of `[0]` is the zero-section divisor of the
base-changed Weierstrass curve. -/
@[simp]
theorem zeroSectionDivisor_map :
    (W.map f).zeroSectionDivisor =
      W.zeroSectionDivisor.comap (W.projModelBaseChange f) :=
  zeroSectionDivisor_eq_comap_of_isPullback (W.isPullback_projModelBaseChange f)
    (W.projModelZero_projModelBaseChange f)

/-- **The multiples `n[0]` commute with arbitrary base change.** -/
theorem zeroSectionDivisor_pow_map (n : ℕ) :
    (W.map f).zeroSectionDivisor ^ n =
      (W.zeroSectionDivisor ^ n).comap (W.projModelBaseChange f) := by
  rw [zeroSectionDivisor_map, AlgebraicGeometry.Scheme.IdealSheafData.comap_pow]

/-- **An admissible change of variables pulls `[0]` back to `[0]`.** -/
@[simp]
theorem zeroSectionDivisor_variableChange (C : VariableChange R) :
    (C • W).zeroSectionDivisor =
      W.zeroSectionDivisor.comap (W.projModelVariableChangeIso C).hom :=
  zeroSectionDivisor_eq_comap_of_isPullback (W.isPullback_projModelVariableChangeIso_hom C)
    ((W.projModelZero_projModelVariableChangeIso_hom C).trans (Category.id_comp _).symm)

/-- **An admissible change of variables pulls `n[0]` back to `n[0]`.** -/
theorem zeroSectionDivisor_pow_variableChange (C : VariableChange R) (n : ℕ) :
    (C • W).zeroSectionDivisor ^ n =
      (W.zeroSectionDivisor ^ n).comap (W.projModelVariableChangeIso C).hom := by
  rw [zeroSectionDivisor_variableChange, Scheme.IdealSheafData.comap_pow]

section Chart

open MvPolynomial Scheme.IdealSheafData

/-- The Weierstrass equation satisfied by the universal point of the chart `D₊(Xᵢ)`. -/
private theorem chartPoint_equation (i : Fin 3) :
    let P := W.toProjective.chartPoint i
    P 1 ^ 2 * P 2 + algebraMap R _ W.a₁ * P 0 * P 1 * P 2 + algebraMap R _ W.a₃ * P 1 * P 2 ^ 2 -
      (P 0 ^ 3 + algebraMap R _ W.a₂ * P 0 ^ 2 * P 2 + algebraMap R _ W.a₄ * P 0 * P 2 ^ 2 +
        algebraMap R _ W.a₆ * P 2 ^ 3) = 0 := by
  have h := (Projective.equation_iff _).mp (W.toProjective.equation_chartPoint i)
  simp only [Projective.baseChange, WeierstrassCurve.baseChange, map_a₁, map_a₂, map_a₃, map_a₄,
    map_a₆] at h
  linear_combination h

/-- On the chart `D₊(X)`, the coordinate `Z/X` is a unit: with `X = 1`, the Weierstrass equation
reads `1 = (Z/X) (y² + a₁ y + a₃ y z - a₂ - a₄ z - a₆ z²)` for `y = Y/X` and `z = Z/X`. -/
private theorem isUnit_chartPoint_zero_two : IsUnit (W.toProjective.chartPoint 0 2) := by
  have h := W.chartPoint_equation 0
  simp only [W.toProjective.chartPoint_self 0] at h
  set y := W.toProjective.chartPoint 0 1
  set z := W.toProjective.chartPoint 0 2
  refine IsUnit.of_mul_eq_one (a := z) (y ^ 2 + algebraMap R _ W.a₁ * y +
    algebraMap R _ W.a₃ * y * z - algebraMap R _ W.a₂ - algebraMap R _ W.a₄ * z -
    algebraMap R _ W.a₆ * z ^ 2) ?_
  linear_combination h

/-- On `D₊(Y)`, the element `t ∈ (x, z)` in `z (1 - t) = x³`, where `x = X/Y` and `z = Z/Y`. -/
private noncomputable def chartOneT : W.toProjective.ChartRing 1 :=
  let x := W.toProjective.chartPoint 1 0; let z := W.toProjective.chartPoint 1 2
  algebraMap R _ W.a₂ * x * x + algebraMap R _ W.a₄ * x * z +
    algebraMap R _ W.a₆ * z * z - algebraMap R _ W.a₁ * x - algebraMap R _ W.a₃ * z

private theorem chartOneT_equation :
    W.toProjective.chartPoint 1 2 * (1 - W.chartOneT) = W.toProjective.chartPoint 1 0 ^ 3 := by
  have h := W.chartPoint_equation 1
  simp only [W.toProjective.chartPoint_self 1] at h; simp only [chartOneT]; linear_combination h

private theorem chartOneT_mem_span :
    W.chartOneT ∈ Ideal.span {W.toProjective.chartPoint 1 0, W.toProjective.chartPoint 1 2} := by
  set x := W.toProjective.chartPoint 1 0; set z := W.toProjective.chartPoint 1 2
  have hx : x ∈ Ideal.span {x, z} := Ideal.subset_span (by simp)
  have hz : z ∈ Ideal.span {x, z} := Ideal.subset_span (by simp)
  exact sub_mem (sub_mem (add_mem (add_mem (Ideal.mul_mem_left _ _ hx)
    (Ideal.mul_mem_left _ _ hz)) (Ideal.mul_mem_left _ _ hz)) (Ideal.mul_mem_left _ _ hx))
    (Ideal.mul_mem_left _ _ hz)

/-- On `D₊(Y)`, with `x = X/Y` and `z = Z/Y`, the ideal `(x, z)` satisfies `(x, z)³ = (z)`. -/
private theorem span_pow_three_chartOne :
    Ideal.span {W.toProjective.chartPoint 1 0, W.toProjective.chartPoint 1 2} ^ 3 =
      Ideal.span {W.toProjective.chartPoint 1 2} :=
  Ideal.span_pair_pow_eq_span_singleton W.chartOneT_equation W.chartOneT_mem_span

/-- On `D₊(Y)`, `Z/Y` is a nonzerodivisor, because `Z` is a nonzerodivisor in the homogeneous
coordinate ring. -/
private theorem isSMulRegular_chartPoint_one_two :
    IsSMulRegular (W.toProjective.ChartRing 1) (W.toProjective.chartPoint 1 2) := by
  rw [← TauCeti.isSMulRegular_map_iff (W.toProjective.awayEquivChartRing 1).symm]
  set M := Submonoid.powers (W.toProjective.coord 1)
  set z' := (W.toProjective.awayEquivChartRing 1).symm (W.toProjective.chartPoint 1 2)
  have hmk := (congrArg (W.toProjective.awayEquivChartRing 1).symm
    (W.toProjective.chartPoint_apply 1 2)).trans (W.toProjective.awayEquivChartRing_symm_mk_X 1 2)
  have hz' : z'.val = Localization.mk (W.toProjective.coord 2)
      (⟨W.toProjective.coord 1 ^ 1, ⟨1, rfl⟩⟩ : M) := by
    rw [show z' = _ from hmk, HomogeneousLocalization.Away.val_mk]
  have hz'mul : z'.val * Localization.mk (W.toProjective.coord 1) (1 : M) =
      algebraMap W.toProjective.CoordinateRing (Localization M) (W.toProjective.coord 2) := by
    rw [hz', Localization.mk_mul, ← Localization.mk_one_eq_algebraMap, Localization.mk_eq_mk_iff,
      Localization.r_iff_exists]
    exact ⟨1, by simp only [OneMemClass.coe_one, Submonoid.coe_mul, pow_one]; ring⟩
  have hreg := IsLocalization.nonZeroDivisors_le_comap M (Localization M)
    W.toProjective.coord_two_mem_nonZeroDivisors
  intro a b hab
  apply HomogeneousLocalization.val_injective
  have hsub : z'.val * (a.val - b.val) = 0 := by
    have hval := congrArg HomogeneousLocalization.val hab
    simp only [smul_eq_mul, HomogeneousLocalization.val_mul] at hval; linear_combination hval
  exact sub_eq_zero.mp <| mem_nonZeroDivisors_iff_left.mp hreg _ <| by
    rw [← hz'mul, mul_comm z'.val, mul_assoc, hsub, mul_zero]

/-- Evaluation at the zero section `X/Y = Z/Y = 0` on the chart ring of `D₊(Y)`. -/
private noncomputable def chartOneEvalZero : W.toProjective.ChartRing 1 →ₐ[R] R :=
  Ideal.Quotient.liftₐ _ (aeval ![0, 1, 0]) fun _ hp ↦ RingHom.mem_ker.mp <| Ideal.span_le.mpr
    (by simpa [Set.range_subset_iff, Fin.forall_fin_two, Projective.Equation] using
      W.toProjective.equation_zero) hp

private theorem chartOneEvalZero_mk_X (k : Fin 3) :
    W.chartOneEvalZero (Ideal.Quotient.mk _ (X k)) = ![0, 1, 0] k := by
  simp [chartOneEvalZero]

/-- The kernel of evaluation at the zero section on the chart ring of `D₊(Y)` is `(X/Y, Z/Y)`. -/
private theorem ker_chartOneEvalZero :
    RingHom.ker (W.chartOneEvalZero : W.toProjective.ChartRing 1 →+* R) =
      Ideal.span {W.toProjective.chartPoint 1 0, W.toProjective.chartPoint 1 2} := by
  set J := Ideal.span {W.toProjective.chartPoint 1 0, W.toProjective.chartPoint 1 2}
  refine le_antisymm (fun a ha ↦ ?_) ?_
  · -- modulo `J`, every element is congruent to its value at the zero section
    have key : Ideal.Quotient.mkₐ R J = (Algebra.ofId R _).comp W.chartOneEvalZero := by
      refine Ideal.Quotient.algHom_ext R (MvPolynomial.algHom_ext fun k ↦ ?_)
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, chartOneEvalZero_mk_X,
        Algebra.ofId_apply]
      fin_cases k
      · simpa using Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp) : _ ∈ J)
      · simp
      · simpa using Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp) : _ ∈ J)
    have ha' : W.chartOneEvalZero a = 0 := by
      rw [← AlgHom.coe_toRingHom, ← RingHom.mem_ker]
      exact ha
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk R, key, AlgHom.comp_apply, ha',
      map_zero]
  · rw [Ideal.span_le, Set.pair_subset_iff]
    exact ⟨RingHom.mem_ker.mpr (by simpa using W.chartOneEvalZero_mk_X 0),
      RingHom.mem_ker.mpr (by simpa using W.chartOneEvalZero_mk_X 2)⟩

/-- The zero section factors through the chart `D₊(Y)` as `Spec` of evaluation at `(0, 1, 0)`. -/
private theorem SpecMap_chartOneEvalZero_chartι :
    Spec.map (CommRingCat.ofHom (W.chartOneEvalZero : _ →+* R)) ≫ W.chartι 1 =
      W.projModelZero := by
  rw [W.SpecMap_chartι]
  conv_rhs => rw [← Category.id_comp W.projModelZero, ← Spec.map_id, ← CommRingCat.ofHom_id,
    W.SpecMap_projModelZero]
  rw [projModelPoint_eq_projModelPoint_iff]
  refine ⟨RingHom.ext fun r ↦ ?_, 1, funext fun k ↦ ?_⟩
  · simp
  · fin_cases k <;> simp [chartOneEvalZero_mk_X]

/-- **The zero-section divisor on the chart `D₊(Y)`.** On the standard affine chart `D₊(Y)`, the
ideal of the divisor `[0]` is generated by `X/Y` and `Z/Y`, the classes of `X` and `Z` in the chart
ring `R[X, Y, Z] ⧸ (W, Y - 1)`, read in the global sections of its spectrum. -/
@[simp]
theorem zeroSectionDivisor_comap_chartι_one :
    W.zeroSectionDivisor.comap (W.chartι 1) =
      ofIdealTop ((Ideal.span {W.toProjective.chartPoint 1 0, W.toProjective.chartPoint 1 2}).map
        (Scheme.ΓSpecIso (.of (W.toProjective.ChartRing 1))).inv.hom) := by
  -- the chart is a monomorphism, so the zero section pulls back to its factorization through it
  have hpb : IsPullback (Spec.map (CommRingCat.ofHom (W.chartOneEvalZero : _ →+* R))) (𝟙 _)
      (W.chartι 1) W.projModelZero :=
    IsPullback.of_vert_isIso_mono ⟨by rw [Category.id_comp, W.SpecMap_chartOneEvalZero_chartι]⟩
  rw [zeroSectionDivisor_def, ← ker_eq_comap_of_isPullback W.projModelZero hpb,
    Scheme.Hom.ker_Spec_map, CommRingCat.hom_ofHom, W.ker_chartOneEvalZero]

/-- **The zero-section divisor misses the charts `D₊(X)` and `D₊(Z)`.** On the standard affine
charts `D₊(Xᵢ)` with `i ≠ 1`, the ideal of the divisor `[0]` is the unit ideal. -/
@[simp]
theorem zeroSectionDivisor_comap_chartι_eq_top_of_ne_one {i : Fin 3} (hi : i ≠ 1) :
    W.zeroSectionDivisor.comap (W.chartι i) = ⊤ := by
  rw [← support_eq_bot_iff, support_comap]
  refine TopologicalSpace.Closeds.ext (Set.eq_empty_iff_forall_notMem.mpr fun x hx ↦ ?_)
  have hx' : W.chartι i x ∈ closure (Set.range W.projModelZero) := by
    rw [← Scheme.Hom.support_ker]
    exact hx
  -- the zero section lies in the closed complement of `D₊(Xᵢ)`, which the chart misses
  have hsub : Set.range W.projModelZero ⊆
      (Proj.basicOpen W.toProjective.grading (W.toProjective.coord i) : Set W.projModel)ᶜ := by
    rintro _ ⟨q, rfl⟩
    exact (W.projModelZero_mem_basicOpen_iff q i).not.mpr hi
  exact closure_minimal hsub (Proj.basicOpen _ _).isOpen.isClosed_compl hx'
    (by rw [← W.opensRange_chartι i]; exact ⟨x, rfl⟩)

/-- **The divisor `3[0]` is the hyperplane section `Z = 0`.** On every standard affine chart
`D₊(Xᵢ)` of the projective Weierstrass model, the ideal of `3[0]` is generated by `Z/Xᵢ`, the class
of `Z` in the chart ring `R[X, Y, Z] ⧸ (W, Xᵢ - 1)`, read in the global sections of its spectrum.
No ellipticity is needed. -/
theorem zeroSectionDivisor_pow_three_comap_chartι (i : Fin 3) :
    (W.zeroSectionDivisor ^ 3).comap (W.chartι i) =
      ofIdealTop ((Ideal.span {W.toProjective.chartPoint i 2}).map
        (Scheme.ΓSpecIso (.of (W.toProjective.ChartRing i))).inv.hom) := by
  rw [comap_pow]
  by_cases hi : i = 1
  · -- on `D₊(Y)`, `(X/Y, Z/Y)³ = (Z/Y)`
    subst hi
    rw [zeroSectionDivisor_comap_chartι_one, ← ofIdealTop_pow, ← Ideal.map_pow,
      span_pow_three_chartOne]
  · -- on `D₊(X)` and `D₊(Z)`, both sides are the unit ideal
    have hu : IsUnit (W.toProjective.chartPoint i 2) := by
      fin_cases i
      · exact W.isUnit_chartPoint_zero_two
      · exact absurd rfl hi
      · exact W.toProjective.chartPoint_self 2 ▸ isUnit_one
    have hrhs : ofIdealTop ((Ideal.span {W.toProjective.chartPoint i 2}).map
        (Scheme.ΓSpecIso (.of (W.toProjective.ChartRing i))).inv.hom) = 1 := by
      rw [Ideal.span_singleton_eq_top.mpr hu, Ideal.map_top, ← Ideal.one_eq_top,
        ← equivOfIsAffine_symm_apply, map_one]
    rw [zeroSectionDivisor_comap_chartι_eq_top_of_ne_one W hi, hrhs, ← one_eq_top, one_pow]

/-- **The zero section cuts out an effective Cartier divisor** on `W.projModel` over any
commutative ring, with no ellipticity hypothesis. -/
theorem isEffectiveCartier_zeroSectionDivisor :
    W.zeroSectionDivisor.IsEffectiveCartier := by
  refine isEffectiveCartier_of_forall_exists_isOpenImmersion _ fun p ↦ ?_
  obtain ⟨i, hp⟩ := W.exists_mem_range_chartι p
  refine ⟨Spec (.of (W.toProjective.ChartRing i)), W.chartι i, inferInstance, hp, ?_⟩
  by_cases hi : i = 1
  · subst hi; rw [W.zeroSectionDivisor_comap_chartι_one, isEffectiveCartier_iff]
    set A := W.toProjective.ChartRing 1; set Y := Spec (.of A)
    set e := (Scheme.ΓSpecIso (.of A)).inv; set x := W.toProjective.chartPoint 1 0
    set z := W.toProjective.chartPoint 1 2; set t := W.chartOneT
    intro q
    have h1 : e t + e (1 - t) = 1 := by rw [← map_add, add_sub_cancel, map_one]
    rcases Y.basicOpen_add_le (e t) (e (1 - t)) (by rw [h1, Y.basicOpen_one]; trivial)
      (x := q) with hqt | hq1t
    · -- On `D(t)`, `t ∈ (x, z)` becomes a unit, so the ideal is `(1)`.
      set U : Y.affineOpens := Y.affineBasicOpen (U := ⟨⊤, isAffineOpen_top Y⟩) (e t)
      have htU : IsUnit (Y.presheaf.map (homOfLE (le_top : U.val ≤ ⊤)).op (e t)) :=
        IsLocalization.Away.algebraMap_isUnit (S := Γ(Y, Y.basicOpen (e t))) (e t)
      refine ⟨U, hqt, 1, IsSMulRegular.one _, ?_⟩
      rw [ofIdealTop_ideal, Ideal.span_singleton_one]
      exact Ideal.eq_top_of_isUnit_mem _
        (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ W.chartOneT_mem_span)) htU
    · -- On `D(1 - t)`, `z (1 - t) = x³` with `1 - t` invertible and `z` regular.
      set U : Y.affineOpens := Y.affineBasicOpen (U := ⟨⊤, isAffineOpen_top Y⟩) (e (1 - t))
      set φ : Γ(Y, ⊤) →+* Γ(Y, U) := (Y.presheaf.map (homOfLE (le_top : U.val ≤ ⊤)).op).hom
      have hu : IsUnit (φ (e (1 - t))) :=
        IsLocalization.Away.algebraMap_isUnit (S := Γ(Y, Y.basicOpen (e (1 - t)))) (e (1 - t))
      have hrel : φ (e z) * φ (e (1 - t)) = φ (e x) ^ 3 := by
        rw [← map_mul, ← map_mul, W.chartOneT_equation, map_pow, map_pow]
      have hz_reg : IsSMulRegular Γ(Y, ⊤) (e z) :=
        (TauCeti.isSMulRegular_map_iff (Scheme.ΓSpecIso (.of A)).symm.commRingCatIsoToRingEquiv
          z).mpr W.isSMulRegular_chartPoint_one_two
      have hx_reg : IsSMulRegular Γ(Y, U) (φ (e x)) :=
        (IsSMulRegular.pow_iff (by decide : 0 < 3)).mp
          (hrel ▸ ((isAffineOpen_top Y).isSMulRegular_map le_top hz_reg).mul
            (hu.isSMulRegular (M := Γ(Y, U))))
      refine ⟨U, hq1t, φ (e x), hx_reg, ?_⟩
      rw [ofIdealTop_ideal, Ideal.map_span, Set.image_pair, Ideal.map_span, Set.image_pair,
        Ideal.span_pair_eq_span_left_iff_dvd, ← hu.dvd_mul_right, hrel]
      exact dvd_pow_self _ (by decide : 3 ≠ 0)
  · rw [W.zeroSectionDivisor_comap_chartι_eq_top_of_ne_one hi]; exact isEffectiveCartier_top _

end Chart

/-- **The zero section cuts out a relative effective Cartier divisor** on `W.projModel` over
`Spec R`, without any ellipticity hypothesis: it is an effective Cartier divisor whose closed
subscheme maps isomorphically to `Spec R`. -/
theorem isRelativeEffectiveCartier_zeroSectionDivisor :
    W.zeroSectionDivisor.IsRelativeEffectiveCartier W.projModelOver := by
  rw [zeroSectionDivisor_def, Scheme.IdealSheafData.isRelativeEffectiveCartier_iff]
  refine ⟨W.isEffectiveCartier_zeroSectionDivisor, ?_⟩
  have := Scheme.Hom.isIso_ker_subschemeι_comp W.projModelZero W.projModelZero_projModelOver
  infer_instance

/-- **Every nonnegative multiple `n[0]` is a relative effective Cartier divisor** on `W.projModel`
over `Spec R`, without any ellipticity hypothesis. -/
theorem isRelativeEffectiveCartier_zeroSectionDivisor_pow (n : ℕ) :
    (W.zeroSectionDivisor ^ n).IsRelativeEffectiveCartier W.projModelOver :=
  TauCeti.isRelativeEffectiveCartier_pow W.isRelativeEffectiveCartier_zeroSectionDivisor n

/-- **Every nonnegative multiple `n[0]` is an effective Cartier divisor** on `W.projModel`, without
any ellipticity hypothesis. -/
theorem isEffectiveCartier_zeroSectionDivisor_pow (n : ℕ) :
    (W.zeroSectionDivisor ^ n).IsEffectiveCartier :=
  (W.isRelativeEffectiveCartier_zeroSectionDivisor_pow n).isEffectiveCartier

end WeierstrassCurve
