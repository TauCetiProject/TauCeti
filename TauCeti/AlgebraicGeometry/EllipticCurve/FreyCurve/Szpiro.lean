/-!
# Szpiro's conjecture for Frey curves, and asymptotic Fermat

Szpiro's conjecture implies Fermat's Last Theorem for all sufficiently large exponents. This file
proves that implication, `TauCeti.AsymptoticFermat`, for the form of Szpiro's conjecture stated
against the algorithmic conductor, `TauCeti.AlgorithmicSzpiroConjecture`.

The link is the Frey curve `y² = x (x - A) (x + B)`. For coprime integers `A` and `B` with
`A ≡ -1 (mod 4)`, `32 ∣ B` and `B ≠ 0`, the Frey curve is semistable, with minimal discriminant
`(A B (A + B))² / 2⁸` and algorithmic conductor `rad (A B (A + B))`. So Szpiro's conjecture bounds
`(A B (A + B))²` by a constant times `rad (A B (A + B)) ^ (6 + ε)`, uniformly over such pairs.

A solution of `aⁿ + bⁿ = cⁿ` in nonzero coprime integers with `n ≥ 5` gives such a pair with
`A B (A + B) = (a b c)ⁿ`: of the three `n`-th powers, the even one, or its negative, is `B`, and
one of the two odd ones, or its negative, is `A`; this is
`TauCeti.exists_isCoprime_and_mul_mul_add_eq_pow`. Its radical is `rad (a b c) ≤ |a b c|`, so
Szpiro's bound with `ε = 1` reads `|a b c| ^ (2 n) ≤ C |a b c| ^ 7`, while `|a b c| ≥ 2` because
one of `a`, `b`, `c` is even. This fails once `2 ^ (2 n - 7) > C`. The argument works for every
exponent `n ≥ 5`, prime or not, and for both parities of `n`.

The bound on the exponent is ineffective: it depends on the unknown constant in Szpiro's
conjecture for `ε = 1`. So the conclusion is **asymptotic** Fermat, which says nothing about any
particular exponent.

## Main results

* `TauCeti.AlgorithmicSzpiroConjecture.exists_sq_le_mul_radical_rpow`: under Szpiro's
  conjecture, for every `ε > 0` there is a constant `C` with
  `(A B (A + B))² ≤ C rad (A B (A + B)) ^ (6 + ε)` for all coprime `A` and `B` with
  `A ≡ -1 (mod 4)`, `32 ∣ B` and `B ≠ 0`.
* `TauCeti.AlgorithmicSzpiroConjecture.asymptoticFermat`: Szpiro's conjecture implies asymptotic
  Fermat.

## References

* G. Frey, *Links between stable elliptic curves and certain Diophantine equations*, Ann. Univ.
  Sarav. Ser. Math. 1 (1986), 1–40.
* J. Oesterlé, *Nouvelles approches du « théorème » de Fermat*, Séminaire Bourbaki 694 (1988),
  Astérisque 161–162 (1988), 165–186.
* H. Darmon, F. Diamond, R. Taylor, *Fermat's Last Theorem*, in *Current Developments in
  Mathematics 1995*, International Press (1995), 1–154.
-/

public section

namespace TauCeti

open WeierstrassCurve UniqueFactorizationMonoid

/-- **Szpiro's conjecture for Frey curves.** Under `TauCeti.AlgorithmicSzpiroConjecture`, for
every `ε > 0` there is a constant `C` such that `(A B (A + B))² ≤ C rad (A B (A + B)) ^ (6 + ε)`
for all coprime integers `A` and `B` with `A ≡ -1 (mod 4)`, `32 ∣ B` and `B ≠ 0`. The Frey curve
`y² = x (x - A) (x + B)` of such a pair has minimal discriminant `(A B (A + B))² / 2⁸` and
algorithmic conductor `rad (A B (A + B))`. -/
theorem AlgorithmicSzpiroConjecture.exists_sq_le_mul_radical_rpow
    (h : AlgorithmicSzpiroConjecture) {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, ∀ A B : ℤ, IsCoprime A B → 4 ∣ A + 1 → 32 ∣ B → B ≠ 0 →
      ((A * B * (A + B) : ℤ) : ℝ) ^ 2 ≤ C * ((radical (A * B * (A + B)) : ℤ) : ℝ) ^ (6 + ε) := by
  obtain ⟨C, hC⟩ := algorithmicSzpiroConjecture_iff.1 h ε hε
  refine ⟨2 ^ 8 * C, fun A B hAB hA hB hB₀ ↦ ?_⟩
  have hA₀ : A ≠ 0 := by omega
  have hAB₀ : A + B ≠ 0 := by omega
  have : ((freyCurve A B).baseChange ℚ).IsElliptic := by
    rw [baseChange, map_freyCurve, isElliptic_freyCurve_iff_ne_zero two_ne_zero]
    simp only [algebraMap_int_eq, eq_intCast, ne_eq, Int.cast_eq_zero, ← Int.cast_add]
    exact ⟨hA₀, hB₀, hAB₀⟩
  have hB₁₆ : (16 : ℤ) ∣ B := dvd_trans ⟨2, by norm_num⟩ hB
  obtain ⟨γ, rfl⟩ := hB
  -- the minimal discriminant is generated by `d = (A B (A + B))² / 2⁸`, and the conductor by
  -- `rad (A B (A + B))`
  have hD := minimalDiscriminantIdeal_freyCurve (F := ℚ) hA hB₁₆ hAB
    (d := (A * (2 * γ) * (A + 32 * γ)) ^ 2) (by ring)
  have hN := algorithmicConductor_freyCurve (F := ℚ) hA (dvd_mul_right 32 γ) hAB
  have key := hC ((freyCurve A (32 * γ)).baseChange ℚ)
  rw [hD, hN] at key
  have hd : (((A * (2 * γ) * (A + 32 * γ)) ^ 2 : ℤ) : ℝ) ≤
      C * ((radical (A * (32 * γ) * (A + 32 * γ)) : ℤ) : ℝ) ^ (6 + ε) := by
    simpa [radical_span_singleton, Ideal.absNorm_span_singleton, abs_of_pos (Int.radical_pos _),
      mul_pow] using key
  push_cast at hd ⊢
  linear_combination 2 ^ 8 * hd

/-- **Szpiro's conjecture implies asymptotic Fermat.** If `TauCeti.AlgorithmicSzpiroConjecture`
holds, there is an `N` such that `aⁿ + bⁿ = cⁿ` has no solution in positive integers for any
exponent `n ≥ N`. The bound `N` depends on the constant of Szpiro's conjecture for `ε = 1`, so it
is ineffective. -/
theorem AlgorithmicSzpiroConjecture.asymptoticFermat (h : AlgorithmicSzpiroConjecture) :
    AsymptoticFermat := by
  obtain ⟨C, hC⟩ := h.exists_sq_le_mul_radical_rpow one_pos
  obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt C (one_lt_two (α := ℝ))
  refine asymptoticFermat_iff.2 ⟨k + 5, fun n hn ↦ ?_⟩
  rw [fermatLastTheoremFor_iff_int]
  refine fermatLastTheoremWith_of_fermatLastTheoremWith_coprime
    fun a b c ha hb hc hgcd habc ↦ ?_
  obtain ⟨A, B, hAB, hA, hB, hprod⟩ := exists_isCoprime_and_mul_mul_add_eq_pow (by omega)
    (isCoprime_of_gcd_eq_one_of_add_pow_eq_pow hgcd habc) habc
  set m := a * b * c
  have hm₀ : m ≠ 0 := mul_ne_zero (mul_ne_zero ha hb) hc
  have hB₀ : B ≠ 0 := by
    rintro rfl
    exact pow_ne_zero n hm₀ (by simpa using hprod.symm)
  -- `m = a b c` is even, as `2 ∣ B ∣ mⁿ`, so `|m| ≥ 2`; and `rad m ≤ |m|`
  have h2m : (2 : ℤ) ∣ m := Int.prime_two.dvd_of_dvd_pow (n := n)
    (hprod ▸ ((dvd_trans ⟨16, by norm_num⟩ hB).mul_left A).mul_right (A + B))
  have hm₂ : (2 : ℝ) ≤ |(m : ℝ)| := by
    exact_mod_cast Int.le_of_dvd (abs_pos.2 hm₀) ((dvd_abs _ _).2 h2m)
  have hrad : ((radical m : ℤ) : ℝ) ≤ |(m : ℝ)| := by
    exact_mod_cast Int.le_of_dvd (abs_pos.2 hm₀) ((dvd_abs _ _).2 radical_dvd_self)
  have hrad₀ : (0 : ℝ) ≤ (radical m : ℤ) := by exact_mod_cast (Int.radical_pos m).le
  -- Szpiro's bound reads `|m| ^ (2 n) ≤ C rad (m) ^ 7 ≤ C |m| ^ 7`
  have key := hC A B hAB hA hB hB₀
  rw [hprod, radical_pow _ (by omega), show (6 : ℝ) + 1 = ((7 : ℕ) : ℝ) by norm_num,
    Real.rpow_natCast] at key
  have hpow : |(m : ℝ)| ^ (2 * n) = (((m ^ n : ℤ) : ℝ)) ^ 2 := by
    rw [(even_two_mul n).pow_abs, Int.cast_pow, ← pow_mul, mul_comm]
  have hpos : 0 < |(m : ℝ)| := by linarith
  have hC₀ : 0 ≤ C := by
    by_contra hneg
    have := mul_nonpos_of_nonpos_of_nonneg (not_le.1 hneg).le (pow_nonneg hrad₀ 7)
    nlinarith [pow_pos hpos (2 * n), hpow]
  have h₁ : |(m : ℝ)| ^ 7 * |(m : ℝ)| ^ (2 * n - 7) ≤ |(m : ℝ)| ^ 7 * C := by
    rw [← pow_add, show 7 + (2 * n - 7) = 2 * n by omega, hpow, mul_comm]
    exact key.trans (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hrad₀ hrad 7) hC₀)
  have h₂ := le_of_mul_le_mul_left h₁ (pow_pos hpos 7)
  -- but `C < 2 ^ k ≤ 2 ^ (2 n - 7) ≤ |m| ^ (2 n - 7)`
  have h₃ : (2 : ℝ) ^ k ≤ |(m : ℝ)| ^ (2 * n - 7) :=
    (pow_le_pow_right₀ one_le_two (by omega)).trans (pow_le_pow_left₀ zero_le_two hm₂ _)
  linarith

end TauCeti

end
