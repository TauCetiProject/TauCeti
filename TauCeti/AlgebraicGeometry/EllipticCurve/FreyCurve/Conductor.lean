/-!
# The algorithmic conductor of the Frey–Hellegouarch curve

Let `O` be a Dedekind domain with fraction field `F`, and let `A` and `B` be coprime elements of
`O` with `A ≡ -1 (mod 4)` and `32 ∣ B`, such that the Frey curve `y² = x (x - A) (x + B)` is
elliptic over `F`. The curve is then semistable, with minimal discriminant ideal generated by
`d = A² B² (A + B)² / 2⁸` (`TauCeti.isSemistable_freyCurve`,
`TauCeti.minimalDiscriminantIdeal_freyCurve`), so its algorithmic conductor is the radical of
`(d)`. Because `32 ∣ B`, every prime dividing `2` still divides `d = (A (B / 16) (A + B))²`, so
`(d)` has the same prime factors as `(A B (A + B))`. Hence the algorithmic conductor is the
radical of `(A B (A + B))`: the product of the primes dividing `A`, `B` or `A + B`, each to the
first power.

For a solution `aᵖ + bᵖ + cᵖ = 0` of Fermat's equation with `p ≥ 5`, normalised so that `b` is
even and `aᵖ ≡ -1 (mod 4)`, this says that the Frey curve of `(aᵖ, bᵖ)` has algorithmic conductor
`(rad (a b c))` over `ℤ`. Together with the minimal discriminant `(a b c)^(2 p) / 2⁸`, this is the
input the Frey curve gives to Szpiro's conjecture.

The hypothesis `32 ∣ B` cannot be weakened to the `16 ∣ B` that semistability needs: over `ℤ`,
if `B = 16 β` with `β` odd, then `d` is odd, so the curve has good reduction at `2` and its
conductor omits `2`. For Fermat's equation, `32 ∣ bᵖ` holds as soon as `b` is even and `p ≥ 5`.

When `16 ∤ A B (A + B)` the Frey curve over `ℤ` need not be semistable at `2`. Its reduction at
every odd prime is still good or multiplicative, and the exponent of `2` in its algorithmic
conductor is at most the valuation of its minimal discriminant `16 (A B (A + B))²`, which is less
than `12`. So the algorithmic conductor divides `2¹¹ rad (A B (A + B))`. This is the case that
Szpiro's conjecture needs besides the semistable one, to bound every coprime triple `a + b = c`.

## Main results

* `TauCeti.algorithmicConductor_freyCurve`: over a Dedekind domain, if `A` and `B` are coprime,
  `A ≡ -1 (mod 4)` and `32 ∣ B`, the Frey curve has algorithmic conductor
  `radical (A B (A + B))`.
* `TauCeti.algorithmicConductor_freyCurve_pow`: for a normalised solution of
  `aᵖ + bᵖ + cᵖ = 0` with `p ≥ 5`, the Frey curve of `(aᵖ, bᵖ)` has algorithmic conductor
  `(rad (a b c))` over `ℤ`.
* `TauCeti.algorithmicConductor_freyCurve_dvd`: over `ℤ`, if `A` and `B` are coprime and
  `16 ∤ A B (A + B)`, the algorithmic conductor of the Frey curve divides
  `2¹¹ rad (A B (A + B))`.

## References

* G. Frey, *Links between stable elliptic curves and certain Diophantine equations*, Ann. Univ.
  Sarav. Ser. Math. 1 (1986), 1–40.
* H. Darmon, F. Diamond, R. Taylor, *Fermat's Last Theorem*, in *Current Developments in
  Mathematics 1995*, International Press (1995), 1–154.
-/

public section

namespace TauCeti

open WeierstrassCurve UniqueFactorizationMonoid IsDedekindDomain

variable {O : Type*} [CommRing O] [IsDedekindDomain O]
  [∀ v : HeightOneSpectrum O,
    PerfectField (IsLocalRing.ResidueField (Localization.AtPrime v.asIdeal))]
  {F : Type*} [Field F] [Algebra O F] [IsFractionRing O F]

/-- **The algorithmic conductor of the Frey curve is the radical of `(A B (A + B))`** when it is
elliptic over the fraction field `F`, `A` and `B` are coprime, `A ≡ -1 (mod 4)` and `32 ∣ B`. The
curve is then semistable, and its primes of bad reduction are exactly the primes dividing `A`, `B`
or `A + B`. -/
theorem algorithmicConductor_freyCurve {A B : O} (hA : 4 ∣ A + 1) (hB : 32 ∣ B)
    (hAB : IsCoprime A B) [((freyCurve A B).baseChange F).IsElliptic] :
    algorithmicConductor O ((freyCurve A B).baseChange F) =
      radical (Ideal.span {A * B * (A + B)}) := by
  have h16 : (16 : O) ∣ B := (Dvd.intro 2 (by norm_num)).trans hB
  obtain ⟨γ, rfl⟩ := hB
  -- the minimal discriminant is generated by `d = A² B² (A + B)² / 2⁸`
  set d := (A * (2 * γ) * (A + 32 * γ)) ^ 2
  rw [(isSemistable_iff_algorithmicConductor_eq_radical _).1 (isSemistable_freyCurve hA h16 hAB),
    minimalDiscriminantIdeal_freyCurve hA h16 hAB (d := d) (by ring)]
  have hd₀ : Ideal.span {d} ≠ 0 := by
    rw [← minimalDiscriminantIdeal_freyCurve hA h16 hAB (F := F) (d := d) (by ring)]
    exact minimalDiscriminantIdeal_ne_bot O _
  -- `(d)` divides `(A B (A + B))²` and `(A B (A + B))` divides `(d)³`, so the two ideals have
  -- the same radical
  have h₁ : Ideal.span {A * (32 * γ) * (A + 32 * γ)} ∣ Ideal.span {d} ^ 3 := by
    rw [Ideal.span_singleton_pow, Ideal.span_singleton_dvd_span_singleton_iff_dvd]
    exact ⟨2 * A ^ 5 * γ ^ 5 * (A + 32 * γ) ^ 5, by ring⟩
  have h₂ : Ideal.span {d} ∣ Ideal.span {A * (32 * γ) * (A + 32 * γ)} ^ 2 := by
    rw [Ideal.span_singleton_pow, Ideal.span_singleton_dvd_span_singleton_iff_dvd]
    exact ⟨2 ^ 8, by ring⟩
  have hN₀ : Ideal.span {A * (32 * γ) * (A + 32 * γ)} ≠ 0 :=
    fun h ↦ pow_ne_zero 3 hd₀ (zero_dvd_iff.1 (h ▸ h₁))
  exact dvd_antisymm ((radical_dvd_radical h₂ (pow_ne_zero 2 hN₀)).trans radical_pow_dvd)
    ((radical_dvd_radical h₁ (pow_ne_zero 3 hd₀)).trans radical_pow_dvd)

/-- **The algorithmic conductor of the Frey curve of a Fermat triple is `(rad (a b c))`.** If
`aᵖ + bᵖ + cᵖ = 0` with `a` and `b` coprime, `b` even, `aᵖ ≡ -1 (mod 4)` and `p ≥ 5`, and
`y² = x (x - aᵖ) (x + bᵖ)` is elliptic over `ℚ`, its algorithmic conductor over `ℤ` is generated
by the radical of `a b c`. -/
theorem algorithmicConductor_freyCurve_pow {p : ℕ} (hp : 5 ≤ p) {a b c : ℤ}
    (hab : IsCoprime a b) (h : a ^ p + b ^ p + c ^ p = 0) (hb : 2 ∣ b) (ha : a ^ p ≡ -1 [ZMOD 4])
    [((freyCurve (a ^ p) (b ^ p)).baseChange ℚ).IsElliptic] :
    algorithmicConductor ℤ ((freyCurve (a ^ p) (b ^ p)).baseChange ℚ) =
      Ideal.span {radical (a * b * c)} := by
  have h32 : (32 : ℤ) ∣ b ^ p := by
    simpa using (pow_dvd_pow_of_dvd hb 5).trans (pow_dvd_pow b hp)
  have habc : a ^ p * b ^ p * (a ^ p + b ^ p) = -(a * b * c) ^ p := by
    linear_combination a ^ p * b ^ p * h
  rw [algorithmicConductor_freyCurve ((Int.ModEq.dvd ha.symm).trans (by simp)) h32 hab.pow, habc,
    Ideal.span_singleton_neg, ← Ideal.span_singleton_pow, radical_pow _ (by omega),
    radical_span_singleton]

/-! ### The Frey curve over `ℤ` when `16 ∤ A B (A + B)` -/

/-- A natural number dividing `16 x²`, divisible by the square of no odd prime, divides
`2¹¹ rad x` if `2¹² ∤ 16 x²`: its odd part is squarefree and divides `x²`, so it divides `rad x`,
and its `2`-part divides `2¹¹`. -/
private theorem dvd_two_pow_eleven_mul_radical {n x : ℕ} (hx : x ≠ 0) (hn : n ∣ 16 * x ^ 2)
    (hodd : ∀ p : ℕ, p.Prime → p ≠ 2 → ¬ p ^ 2 ∣ n) (h2 : ¬ 2 ^ 12 ∣ 16 * x ^ 2) :
    n ∣ 2 ^ 11 * radical x := by
  have hn₀ : n ≠ 0 := by
    rintro rfl
    exact mul_ne_zero (by norm_num) (pow_ne_zero 2 hx) (zero_dvd_iff.1 hn)
  obtain ⟨e, m, hm, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn₀
  refine mul_dvd_mul (Nat.pow_dvd_pow 2 (not_lt.1 fun he ↦ h2 ?_)) ?_
  · exact (Nat.pow_dvd_pow 2 he).trans ((dvd_mul_right _ _).trans hn)
  -- the odd part `m` is squarefree and divides `x²`
  have hsq : Squarefree m := by
    rw [Nat.squarefree_iff_prime_squarefree]
    intro p hp hpm
    by_cases hp2 : p = 2
    · subst hp2
      exact Nat.not_even_iff_odd.2 hm (even_iff_two_dvd.2 ((dvd_mul_right 2 2).trans hpm))
    · exact hodd p hp hp2 (by rw [sq]; exact hpm.trans (dvd_mul_left m _))
  have hmx : m ∣ x ^ 2 :=
    (Nat.Coprime.pow_right 4 (Nat.coprime_two_right.2 hm)).dvd_of_dvd_mul_left
      (by simpa using (dvd_mul_left m _).trans hn)
  rw [← radical_pow x two_ne_zero]
  exact (dvd_radical_iff hsq.isRadical (pow_ne_zero 2 hx)).2 hmx

/-- At an odd prime the Frey curve of a coprime pair has no additive reduction, so the square of no
odd prime divides its algorithmic conductor. -/
private theorem not_sq_dvd_absNorm_algorithmicConductor_freyCurve {A B : ℤ} (hAB : IsCoprime A B)
    [((freyCurve A B).baseChange ℚ).IsElliptic] {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) :
    ¬ p ^ 2 ∣ Ideal.absNorm (algorithmicConductor ℤ ((freyCurve A B).baseChange ℚ)) := by
  intro hdvd
  obtain ⟨v, hv⟩ : ∃ v : HeightOneSpectrum ℤ, v.asIdeal = Ideal.span {(p : ℤ)} :=
    ⟨⟨_, (Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).2
      (Nat.prime_iff_prime_int.1 hp), by simpa using hp.ne_zero⟩, rfl⟩
  have h2 : (2 : ℤ) ∉ v.asIdeal := by
    rw [hv, Ideal.mem_span_singleton]
    intro h
    rcases (Nat.dvd_prime Nat.prime_two).1 (by exact_mod_cast h) with h | h
    · exact hp.ne_one h
    · exact hp2 h
  refine not_hasAdditiveReduction_minimal_baseChange_of_Δ_notMem_or_c₄_notMem (F := ℚ) _
    (freyCurve_Δ_notMem_or_c₄_notMem hAB h2) ?_
  rw [← two_le_algorithmicOggExponent_iff, ← pow_dvd_algorithmicConductor_iff,
    ← Int.ideal_span_absNorm_eq_self (algorithmicConductor ℤ _), hv, Ideal.span_singleton_pow,
    Ideal.span_singleton_dvd_span_singleton_iff_dvd]
  exact_mod_cast hdvd

/-- **The algorithmic conductor of the Frey curve divides `2¹¹ rad (A B (A + B))` when
`16 ∤ A B (A + B)`**, for coprime `A` and `B`. The curve need not be semistable at `2`, but at an
odd prime its reduction is good or multiplicative, with exponent at most `1`, and bad only at the
primes dividing `A B (A + B)`. At `2` the exponent is at most the valuation of the minimal
discriminant `16 (A B (A + B))²`, which is less than `12`. -/
theorem algorithmicConductor_freyCurve_dvd {A B : ℤ} (hAB : IsCoprime A B)
    (h16 : ¬ 16 ∣ A * B * (A + B)) [((freyCurve A B).baseChange ℚ).IsElliptic] :
    algorithmicConductor ℤ ((freyCurve A B).baseChange ℚ) ∣
      Ideal.span {2 ^ 11 * radical (A * B * (A + B))} := by
  have hP : A * B * (A + B) ≠ 0 := fun h ↦ h16 (h ▸ dvd_zero 16)
  -- the conductor divides the minimal discriminant `16 (A B (A + B))²`
  have hn := Ideal.absNorm_dvd_absNorm_of_le (Ideal.le_of_dvd
    ((algorithmicConductor_dvd_minimalDiscriminantIdeal ((freyCurve A B).baseChange ℚ)).trans
      (minimalDiscriminantIdeal_freyCurve_of_not_dvd hAB h16).dvd))
  rw [Int.absNorm_span_singleton, Int.natAbs_mul, Int.natAbs_pow] at hn
  have h2 : ¬ 2 ^ 12 ∣ 16 * (A * B * (A + B)).natAbs ^ 2 := by
    have := (two_pow_twelve_dvd_freyCurve_Δ_iff (A := A) (B := B)).not.2 h16
    contrapose! this
    rw [freyCurve_Δ_eq_mul_sq]
    exact Int.natAbs_dvd_natAbs.1 (by simpa [Int.natAbs_mul, Int.natAbs_pow] using this)
  rw [← Int.ideal_span_absNorm_eq_self (algorithmicConductor ℤ _),
    Ideal.span_singleton_dvd_span_singleton_iff_dvd, ← Int.radical_natAbs_eq_radical]
  exact_mod_cast dvd_two_pow_eleven_mul_radical (Int.natAbs_ne_zero.2 hP) hn
    (fun p hp hp2 ↦ not_sq_dvd_absNorm_algorithmicConductor_freyCurve hAB hp hp2) h2

end TauCeti

end
