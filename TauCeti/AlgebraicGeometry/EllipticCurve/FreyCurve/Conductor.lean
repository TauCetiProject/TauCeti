module

public import TauCeti.AlgebraicGeometry.EllipticCurve.FreyCurve.Basic
public import TauCeti.AlgebraicGeometry.EllipticCurve.TateAlgorithm.Reduction.Conductor
import TauCeti.RingTheory.Radical.Ideal

/-!
# The algorithmic conductor of the Frey–Hellegouarch curve

Let `O` be a Dedekind domain with fraction field `F`, and let `A` and `B` be coprime elements of
`O` with `A ≡ -1 (mod 4)` and `32 ∣ B`, such that the Frey curve `y² = x (x - A) (x + B)` is
elliptic over `F`. The curve is then semistable, with minimal discriminant ideal generated by
`d = A² B² (A + B)² / 2⁸` (`TauCeti.isSemistable_freyCurve`,
`TauCeti.minimalDiscriminantIdeal_freyCurve`), so its algorithmic conductor is the radical of
`(d)`. Because `32 ∣ B`, every prime dividing `2` still divides `d = (A (B / 16) (A + B))²`, so
`(d)` has the same prime factors as `(A B (A + B))`. Hence the algorithmic conductor is the
radical of `(A B (A + B))`: the product of the primes dividing `A`, `B` or `A + B`, each to the
first power.

For a solution `aᵖ + bᵖ + cᵖ = 0` of Fermat's equation with `p ≥ 5`, normalised so that `b` is
even and `aᵖ ≡ -1 (mod 4)`, this says that the Frey curve of `(aᵖ, bᵖ)` has algorithmic conductor
`(rad (a b c))` over `ℤ`. Together with the minimal discriminant `(a b c)^(2 p) / 2⁸`, this is the
input the Frey curve gives to Szpiro's conjecture.

The hypothesis `32 ∣ B` cannot be weakened to the `16 ∣ B` that semistability needs: over `ℤ`,
if `B = 16 β` with `β` odd, then `d` is odd, so the curve has good reduction at `2` and its
conductor omits `2`. For Fermat's equation, `32 ∣ bᵖ` holds as soon as `b` is even and `p ≥ 5`.

## Main results

* `TauCeti.algorithmicConductor_freyCurve`: over a Dedekind domain, if `A` and `B` are coprime,
  `A ≡ -1 (mod 4)` and `32 ∣ B`, the Frey curve has algorithmic conductor
  `radical (A B (A + B))`.
* `TauCeti.algorithmicConductor_freyCurve_pow`: for a normalised solution of
  `aᵖ + bᵖ + cᵖ = 0` with `p ≥ 5`, the Frey curve of `(aᵖ, bᵖ)` has algorithmic conductor
  `(rad (a b c))` over `ℤ`.

## References

* G. Frey, *Links between stable elliptic curves and certain Diophantine equations*, Ann. Univ.
  Sarav. Ser. Math. 1 (1986), 1–40.
* H. Darmon, F. Diamond, R. Taylor, *Fermat's Last Theorem*, in *Current Developments in
  Mathematics 1995*, International Press (1995), 1–154.
-/

public section

namespace TauCeti

open WeierstrassCurve UniqueFactorizationMonoid IsDedekindDomain

variable {O : Type*} [CommRing O] [IsDedekindDomain O]
  [∀ v : HeightOneSpectrum O,
    PerfectField (IsLocalRing.ResidueField (Localization.AtPrime v.asIdeal))]
  {F : Type*} [Field F] [Algebra O F] [IsFractionRing O F]

/-- **The algorithmic conductor of the Frey curve is the radical of `(A B (A + B))`** when it is
elliptic over the fraction field `F`, `A` and `B` are coprime, `A ≡ -1 (mod 4)` and `32 ∣ B`. The
curve is then semistable, and its primes of bad reduction are exactly the primes dividing `A`, `B`
or `A + B`. -/
theorem algorithmicConductor_freyCurve {A B : O} (hA : 4 ∣ A + 1) (hB : 32 ∣ B)
    (hAB : IsCoprime A B) [((freyCurve A B).baseChange F).IsElliptic] :
    algorithmicConductor O ((freyCurve A B).baseChange F) =
      radical (Ideal.span {A * B * (A + B)}) := by
  have h16 : (16 : O) ∣ B := (Dvd.intro 2 (by norm_num)).trans hB
  obtain ⟨γ, rfl⟩ := hB
  -- the minimal discriminant is generated by `d = A² B² (A + B)² / 2⁸`
  set d := (A * (2 * γ) * (A + 32 * γ)) ^ 2
  rw [(isSemistable_iff_algorithmicConductor_eq_radical _).1 (isSemistable_freyCurve hA h16 hAB),
    minimalDiscriminantIdeal_freyCurve hA h16 hAB (d := d) (by ring)]
  have hd₀ : Ideal.span {d} ≠ 0 := by
    rw [← minimalDiscriminantIdeal_freyCurve hA h16 hAB (F := F) (d := d) (by ring)]
    exact minimalDiscriminantIdeal_ne_bot O _
  -- `(d)` divides `(A B (A + B))²` and `(A B (A + B))` divides `(d)³`, so the two ideals have
  -- the same radical
  have h₁ : Ideal.span {A * (32 * γ) * (A + 32 * γ)} ∣ Ideal.span {d} ^ 3 := by
    rw [Ideal.span_singleton_pow, Ideal.span_singleton_dvd_span_singleton_iff_dvd]
    exact ⟨2 * A ^ 5 * γ ^ 5 * (A + 32 * γ) ^ 5, by ring⟩
  have h₂ : Ideal.span {d} ∣ Ideal.span {A * (32 * γ) * (A + 32 * γ)} ^ 2 := by
    rw [Ideal.span_singleton_pow, Ideal.span_singleton_dvd_span_singleton_iff_dvd]
    exact ⟨2 ^ 8, by ring⟩
  have hN₀ : Ideal.span {A * (32 * γ) * (A + 32 * γ)} ≠ 0 :=
    fun h ↦ pow_ne_zero 3 hd₀ (zero_dvd_iff.1 (h ▸ h₁))
  exact dvd_antisymm ((radical_dvd_radical h₂ (pow_ne_zero 2 hN₀)).trans radical_pow_dvd)
    ((radical_dvd_radical h₁ (pow_ne_zero 3 hd₀)).trans radical_pow_dvd)

/-- **The algorithmic conductor of the Frey curve of a Fermat triple is `(rad (a b c))`.** If
`aᵖ + bᵖ + cᵖ = 0` with `a` and `b` coprime, `b` even, `aᵖ ≡ -1 (mod 4)` and `p ≥ 5`, and
`y² = x (x - aᵖ) (x + bᵖ)` is elliptic over `ℚ`, its algorithmic conductor over `ℤ` is generated
by the radical of `a b c`. -/
theorem algorithmicConductor_freyCurve_pow {p : ℕ} (hp : 5 ≤ p) {a b c : ℤ}
    (hab : IsCoprime a b) (h : a ^ p + b ^ p + c ^ p = 0) (hb : 2 ∣ b) (ha : a ^ p ≡ -1 [ZMOD 4])
    [((freyCurve (a ^ p) (b ^ p)).baseChange ℚ).IsElliptic] :
    algorithmicConductor ℤ ((freyCurve (a ^ p) (b ^ p)).baseChange ℚ) =
      Ideal.span {radical (a * b * c)} := by
  have h32 : (32 : ℤ) ∣ b ^ p := by
    simpa using (pow_dvd_pow_of_dvd hb 5).trans (pow_dvd_pow b hp)
  have habc : a ^ p * b ^ p * (a ^ p + b ^ p) = -(a * b * c) ^ p := by
    linear_combination a ^ p * b ^ p * h
  rw [algorithmicConductor_freyCurve ((Int.ModEq.dvd ha.symm).trans (by simp)) h32 hab.pow, habc,
    Ideal.span_singleton_neg, ← Ideal.span_singleton_pow, radical_pow _ (by omega),
    radical_span_singleton]

end TauCeti

end
