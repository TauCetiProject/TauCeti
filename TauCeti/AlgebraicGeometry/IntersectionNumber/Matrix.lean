module

public import TauCeti.AlgebraicGeometry.IntersectionNumber.SpecialFiber
public import TauCeti.AlgebraicGeometry.Scheme.KrullDimension
public import TauCeti.AlgebraicGeometry.SpecialFiber.Components
public import TauCeti.LinearAlgebra.Matrix.NegSemidef

/-!
# The intersection matrix of the special fibre of a regular model

Let `R` be a local ring of dimension at most one whose maximal ideal is generated by a
nonzerodivisor `π`, for instance a discrete valuation ring with a uniformizer, with residue field
`κ`, and let `X` be a regular Noetherian integral scheme, proper and flat over `R`, all of whose
points have codimension at most two, such as a proper regular model of a curve over `R`. The
irreducible components `Cᵢ` of the special fibre, with their reduced structures, are closed
subschemes of the special fibre, hence proper schemes over `κ`
(`TauCeti.subschemeOverResidueField`), and they are curves: a prime divisor on a scheme of
dimension at most two has dimension at most one
(`AlgebraicGeometry.Scheme.Hom.relativeDimensionLE_subscheme_vanishingIdeal_closure_singleton`).

The **intersection matrix** of the special fibre is the integer matrix

`aᵢⱼ = (Cⱼ · Cᵢ) = deg_κ 𝒪_X(Cⱼ)|_{Cᵢ}`

indexed by the components (`AlgebraicGeometry.Scheme.Hom.specialFiberIntersectionMatrix`). When
`H⁰` and `H¹` of the structure sheaf of every component are finite-dimensional over `κ`, it has
the properties of [Stacks, Tag 0C5X](https://stacks.math.columbia.edu/tag/0C5X):

* it kills the vector `m = (mᵢ)` of multiplicities of the components, `Σⱼ aᵢⱼ mⱼ = 0`, because the
  special fibre `Σⱼ mⱼ Cⱼ` is linearly equivalent to zero;
* it is symmetric, `(Cⱼ · Cᵢ) = (Cᵢ · Cⱼ)`, both being the length over `κ` of the scheme-theoretic
  intersection `Cᵢ ∩ Cⱼ` of two prime divisors meeting properly;
* its off-diagonal entries are nonnegative.

Since the multiplicities are positive, the intersection form `x ↦ xᵀ A x` is therefore negative
semidefinite over every linearly ordered field.

## Main declarations

* `AlgebraicGeometry.Scheme.Hom.specialFiberIntersectionMatrix`: the intersection matrix of the
  components of the special fibre.
* `AlgebraicGeometry.Scheme.Hom.specialFiberIntersectionMatrix_mulVec_specialFiberMultiplicity`:
  `A m = 0`.
* `AlgebraicGeometry.Scheme.Hom.specialFiberIntersectionMatrix_isSymm`: `A` is symmetric.
* `AlgebraicGeometry.Scheme.Hom.specialFiberIntersectionMatrix_nonneg_of_ne`: the off-diagonal
  entries of `A` are nonnegative.
* `AlgebraicGeometry.Scheme.Hom.dotProduct_mulVec_specialFiberIntersectionMatrix_nonpos`: the
  intersection form is negative semidefinite.

## References

* [The Stacks Project, Section 55.9](https://stacks.math.columbia.edu/tag/0C9U), and
  [Tag 0C5X](https://stacks.math.columbia.edu/tag/0C5X) for the negative semidefiniteness of the
  intersection form.
* Q. Liu, *Algebraic Geometry and Arithmetic Curves*, Section 9.1, Theorem 1.23.
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing Order
open scoped Matrix
open TauCeti TauCeti.AlgebraicGeometry TauCeti.AlgebraicGeometry.Scheme.Modules
open AlgebraicGeometry.Scheme.IdealSheafData (vanishingIdeal
  isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
  isEffectiveCartier_comap_subschemeι_vanishingIdeal_closure_singleton_of_isRegular)

universe u

namespace AlgebraicGeometry.Scheme.Hom

section Components

variable {R : Type u} [CommRing R] [IsLocalRing R] {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))

/-- **The components of the special fibre are curves.** If all points of `X` have codimension at
most `d + 1`, then the closure of a point of the special fibre which is not a generic point of an
irreducible component of `X`, with its reduced structure, has relative dimension at most `d` over
the residue field. For a regular model of a curve, the components of the special fibre are
codimension-one points and `d = 1`. -/
theorem relativeDimensionLE_subscheme_vanishingIdeal_closure_singleton {d : ℕ}
    (hX : ∀ x : X, coheight x ≤ d + 1) {η : X} (hmax : ¬IsMax η)
    (hη : toBase η = closedPoint R) :
    letI := subschemeOverResidueField
      (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hη)
    TauCeti.AlgebraicGeometry.RelativeDimensionLE d
      ((vanishingIdeal ⟨closure {η}, isClosed_closure⟩).subscheme ↘
        Spec (.of (ResidueField R))) := by
  rw [relativeDimensionLE_iff_of_field,
    ← topologicalKrullDim_range_of_isPreimmersion
      (vanishingIdeal ⟨closure {η}, isClosed_closure⟩).subschemeι,
    IdealSheafData.range_subschemeι, IdealSheafData.coe_support_vanishingIdeal]
  exact topologicalKrullDim_closure_singleton_le_of_not_isMax hX hmax

end Components

section Matrix

variable {R : Type u} [CommRing R] [IsLocalRing R] [Ring.DimensionLEOne R]
  {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R)) [IsIntegral X] [IsNoetherian X]
  [TauCeti.AlgebraicGeometry.IsRegular X]

/-- The **intersection matrix** of the special fibre of a regular model. Let `X` be a regular
Noetherian integral scheme over a local ring `R` of dimension at most one, with all points of
codimension at most two and generic point away from the closed point. Its entry at a pair of
components `Cᵢ`, `Cⱼ` of the special fibre is the intersection number
`(Cⱼ · Cᵢ) = deg 𝒪_X(Cⱼ)|_{Cᵢ}` over the residue field of `R`, where `Cᵢ` carries its reduced
structure and its structure over the residue field through the special fibre. -/
def specialFiberIntersectionMatrix (hX : ∀ x : X, coheight x ≤ 2)
    (hη : toBase (genericPoint X) ≠ closedPoint R) :
    Matrix (toBase.finite_setOf_base_eq_closedPoint
        (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset
      (toBase.finite_setOf_base_eq_closedPoint
        (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset ℤ :=
  fun i j ↦
    letI := subschemeOverResidueField (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      ((Set.Finite.mem_toFinset _).mp i.2))
    LineBundleClass.intersectionNumber (ResidueField R)
      (vanishingIdeal ⟨closure {((i : CodimensionOnePoint X) : X)}, isClosed_closure⟩).subschemeι
      (LineBundleClass.mk (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular hX
        (j : CodimensionOnePoint X).2).toInvertibleSheaf)⁻¹

variable [IsProper toBase]

section Finiteness

variable (hX : ∀ x : X, coheight x ≤ 2) (hη : toBase (genericPoint X) ≠ closedPoint R)
  (h₀ : ∀ (η : CodimensionOnePoint X) (hc : toBase η = closedPoint R),
    letI := subschemeOverResidueField
      (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hc)
    FiniteDimensional (ResidueField R) (Cohomology (InvertibleSheaf.trivial
      (vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩).subscheme).obj 0))
  (h₁ : ∀ (η : CodimensionOnePoint X) (hc : toBase η = closedPoint R),
    letI := subschemeOverResidueField
      (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hc)
    FiniteDimensional (ResidueField R) (Cohomology (InvertibleSheaf.trivial
      (vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩).subscheme).obj 1))
include hX h₀ h₁

omit [Ring.DimensionLEOne R] [IsIntegral X] [IsNoetherian X]
  [TauCeti.AlgebraicGeometry.IsRegular X] in
/-- The hypotheses on a component of the special fibre under which its intersection numbers are
computed by `TauCeti.AlgebraicGeometry.LineBundleClass`: it is a proper curve over the residue field
with finite-dimensional `H⁰` and `H¹` of its structure sheaf. -/
private theorem component_hypotheses {η : CodimensionOnePoint X} (hη' : toBase η = closedPoint R) :
    letI := subschemeOverResidueField
      (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hη')
    IsProper ((vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩).subscheme ↘
        Spec (.of (ResidueField R))) ∧
      TauCeti.AlgebraicGeometry.RelativeDimensionLE 1
        ((vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩).subscheme ↘
          Spec (.of (ResidueField R))) ∧
      FiniteDimensional (ResidueField R) (Cohomology (InvertibleSheaf.trivial
        (vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩).subscheme).obj 0) ∧
      FiniteDimensional (ResidueField R) (Cohomology (InvertibleSheaf.trivial
        (vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩).subscheme).obj 1) :=
  ⟨isProper_subschemeOverResidueField _,
    toBase.relativeDimensionLE_subscheme_vanishingIdeal_closure_singleton hX
      (fun h ↦ one_ne_zero (η.2.symm.trans (coheight_eq_zero.mpr h))) hη', h₀ η hη', h₁ η hη'⟩

/-- **The intersection matrix kills the multiplicities.** Let `X` be a regular Noetherian integral
scheme, proper and flat over a local ring `R` of dimension at most one whose maximal ideal is
generated by a nonzerodivisor `π`, with all points of codimension at most two and generic point
away from the closed point, and suppose that `H⁰` and `H¹` of the structure sheaf of every
component of the special fibre are finite-dimensional over the residue field. Then the
intersection matrix `A` of the special fibre kills the vector `m` of the multiplicities of the
components: `Σⱼ (Cⱼ · Cᵢ) mⱼ = 0` for every component `Cᵢ`. -/
theorem specialFiberIntersectionMatrix_mulVec_specialFiberMultiplicity [Flat toBase] {π : R}
    (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π) :
    toBase.specialFiberIntersectionMatrix hX hη *ᵥ
      (fun j ↦ (toBase.specialFiberMultiplicity π j : ℤ)) = 0 := by
  funext i
  have hi : toBase (i : CodimensionOnePoint X) = closedPoint R := (Set.Finite.mem_toFinset _).mp i.2
  let := subschemeOverResidueField (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hi)
  obtain ⟨_, _, _, _⟩ := toBase.component_hypotheses hX h₀ h₁ hi
  have h := toBase.sum_specialFiberMultiplicity_mul_intersectionNumber_eq_zero (ResidueField R)
    (vanishingIdeal ⟨closure {((i : CodimensionOnePoint X) : X)}, isClosed_closure⟩).subschemeι
    hX hη hπ hreg
  rw [← Finset.sum_coe_sort] at h
  simpa [Matrix.mulVec, dotProduct, specialFiberIntersectionMatrix, mul_comm] using h

/-- **The intersection matrix is symmetric.** Under the hypotheses of
`AlgebraicGeometry.Scheme.Hom.specialFiberIntersectionMatrix_mulVec_specialFiberMultiplicity`
(flatness is not needed), `(Cⱼ · Cᵢ) = (Cᵢ · Cⱼ)` for any two components `Cᵢ`, `Cⱼ` of the
special fibre: both are the dimension over the residue field of the ring of functions on the
scheme-theoretic intersection `Cᵢ ∩ Cⱼ`. -/
theorem specialFiberIntersectionMatrix_isSymm :
    (toBase.specialFiberIntersectionMatrix hX hη).IsSymm := by
  refine Matrix.IsSymm.ext fun i j ↦ ?_
  rcases eq_or_ne i j with rfl | hij
  · rfl
  have hi : toBase (i : CodimensionOnePoint X) = closedPoint R := (Set.Finite.mem_toFinset _).mp i.2
  have hj : toBase (j : CodimensionOnePoint X) = closedPoint R := (Set.Finite.mem_toFinset _).mp j.2
  let := subschemeOverResidueField (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hi)
  let := subschemeOverResidueField (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hj)
  obtain ⟨_, _, _, _⟩ := toBase.component_hypotheses hX h₀ h₁ hi
  obtain ⟨_, _, _, _⟩ := toBase.component_hypotheses hX h₀ h₁ hj
  have hne : (j : CodimensionOnePoint X) ≠ i := fun h ↦ hij (Subtype.ext h).symm
  -- The two components carry the same structure over the residue field on their intersection.
  exact LineBundleClass.intersectionNumber_inv_mk_toInvertibleSheaf_comm (ResidueField R) _ _
    (isEffectiveCartier_comap_subschemeι_vanishingIdeal_closure_singleton_of_isRegular hX hne)
    (isEffectiveCartier_comap_subschemeι_vanishingIdeal_closure_singleton_of_isRegular hX hne.symm)
    (pullback_fst_subschemeToSpecialFiber_assoc _ _ _)

/-- **The off-diagonal entries of the intersection matrix are nonnegative.** Under the hypotheses
of `AlgebraicGeometry.Scheme.Hom.specialFiberIntersectionMatrix_isSymm`, distinct components `Cᵢ`
and `Cⱼ` of the special fibre meet properly, so `(Cⱼ · Cᵢ) ≥ 0`. -/
theorem specialFiberIntersectionMatrix_nonneg_of_ne {i j} (hij : i ≠ j) :
    0 ≤ toBase.specialFiberIntersectionMatrix hX hη i j := by
  have hi : toBase (i : CodimensionOnePoint X) = closedPoint R := (Set.Finite.mem_toFinset _).mp i.2
  let := subschemeOverResidueField (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hi)
  obtain ⟨_, _, _, _⟩ := toBase.component_hypotheses hX h₀ h₁ hi
  exact LineBundleClass.intersectionNumber_inv_mk_toInvertibleSheaf_nonneg_of_ne _ hX
    fun h ↦ hij (Subtype.ext h)

/-- **The intersection form of the special fibre is negative semidefinite.** Under the hypotheses
of `AlgebraicGeometry.Scheme.Hom.specialFiberIntersectionMatrix_mulVec_specialFiberMultiplicity`,
the intersection matrix `A` of the special fibre satisfies `xᵀ A x ≤ 0` for every vector `x` over
a linearly ordered field ([Stacks, Tag 0C5X](https://stacks.math.columbia.edu/tag/0C5X)). -/
theorem dotProduct_mulVec_specialFiberIntersectionMatrix_nonpos [Flat toBase] {π : R}
    (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π) {K : Type*} [Field K]
    [LinearOrder K] [IsStrictOrderedRing K]
    (x : (toBase.finite_setOf_base_eq_closedPoint
      (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset → K) :
    x ⬝ᵥ (toBase.specialFiberIntersectionMatrix hX hη).map (Int.cast : ℤ → K) *ᵥ x ≤ 0 := by
  have hπ0 := toBase.ne_zero_of_base_ne_closedPoint hη hπ
  refine Matrix.dotProduct_mulVec_nonpos_of_mulVec_eq_zero
    ((toBase.specialFiberIntersectionMatrix_isSymm hX hη h₀ h₁).map _)
    (fun i j hij ↦ Int.cast_nonneg_iff.mpr
      (toBase.specialFiberIntersectionMatrix_nonneg_of_ne hX hη h₀ h₁ hij))
    (m := fun j ↦ (toBase.specialFiberMultiplicity π j : K))
    (fun j ↦ Nat.cast_pos.mpr (toBase.specialFiberMultiplicity_pos hη
      (hπ ▸ Ideal.mem_span_singleton_self π) hπ0 j ((Set.Finite.mem_toFinset _).mp j.2))) ?_ x
  funext i
  have h := congrArg (Int.cast : ℤ → K) (congrFun
    (toBase.specialFiberIntersectionMatrix_mulVec_specialFiberMultiplicity hX hη h₀ h₁ hπ hreg) i)
  simpa [Matrix.mulVec, dotProduct] using h

end Finiteness

end Matrix

end AlgebraicGeometry.Scheme.Hom
