module

public import TauCeti.AlgebraicGeometry.IdealSheaf.Image
public import TauCeti.AlgebraicGeometry.LineBundle.Basic

/-!
# Image ideals of line-bundle functionals

The image ideal of a functional on a line bundle is locally principal. In any trivialization,
it is generated by the image of the distinguished basis section.
-/

public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace MonoidalCategory

universe u

namespace AlgebraicGeometry.Scheme.Modules.Hom

noncomputable section

variable {X : Scheme.{u}} {M : X.Modules}
  (φ : M ⟶ 𝟙_ X.Modules)

/-- In a line-bundle trivialization, the image ideal is generated by the image of its basis. -/
lemma imageIdeal_eq_span_trivializationGenerator {V W : X.Opens}
    (t : SheafOfModules.free (R := X.ringCatSheaf.over V) PUnit ≅ M.over V) (i : W ⟶ V) :
    φ.imageIdeal W = Ideal.span (α := Γ(X, W))
      {(φ.app W (M.presheaf.map i.op (Scheme.Modules.trivializationGenerator M t)) : Γ(X, W))} := by
  ext a
  rw [mem_imageIdeal]
  refine Iff.trans ?_ (Ideal.mem_span_singleton' (x := a) (y :=
    (φ.app W (M.presheaf.map i.op (Scheme.Modules.trivializationGenerator M t)) : Γ(X, W)))).symm
  constructor
  · rintro ⟨s, rfl⟩
    obtain ⟨r, rfl, -⟩ := Scheme.Modules.existsUnique_eq_smul_map_trivializationGenerator M t i s
    refine ⟨r, ?_⟩
    -- `app_smul` uses the unit sheaf module; its action on `Γ(X, W)` is multiplication.
    erw [Scheme.Modules.Hom.app_smul]
    rfl
  · rintro ⟨r, rfl⟩
    refine ⟨r • M.presheaf.map i.op (Scheme.Modules.trivializationGenerator M t), ?_⟩
    -- `app_smul` uses the unit sheaf module; its action on `Γ(X, W)` is multiplication.
    erw [Scheme.Modules.Hom.app_smul]
    rfl

/-- The image ideal of a functional on an invertible sheaf is locally principal. -/
lemma exists_imageIdealSheaf_ideal_eq_span
    [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X M] (x : X) :
    ∃ U : X.affineOpens, x ∈ U.val ∧
      ∃ a : Γ(X, U), φ.imageIdealSheaf.ideal U = Ideal.span {a} := by
  obtain ⟨V, t, hxV⟩ := Scheme.Modules.exists_mem_trivialization M x
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxV V.isOpen
  refine ⟨⟨U, hU⟩, hxU,
    φ.app U (M.presheaf.map (homOfLE hUV).op (Scheme.Modules.trivializationGenerator M t)), ?_⟩
  rw [imageIdealSheaf_ideal]
  exact φ.imageIdeal_eq_span_trivializationGenerator t (homOfLE hUV)

end

end AlgebraicGeometry.Scheme.Modules.Hom
