namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {U X : Scheme.{u}}

/-- Pulling back the vanishing ideal sheaf of a closed subset `Z` along an open immersion `j` gives
the vanishing ideal sheaf of the preimage `j ⁻¹' Z`. -/
theorem comap_vanishingIdeal_of_isOpenImmersion (Z : Closeds X) (j : U ⟶ X) [IsOpenImmersion j] :
    (vanishingIdeal Z).comap j = vanishingIdeal (Z.preimage j.continuous) := by
  have hRad : ((vanishingIdeal Z).comap j).radical = (vanishingIdeal Z).comap j := by
    ext V : 2
    rw [radical_ideal, ideal_comap_of_isOpenImmersion]
    refine Ideal.IsRadical.radical (Ideal.IsRadical.comap _ ?_)
    rw [vanishingIdeal_ideal]
    exact PrimeSpectrum.isRadical_vanishingIdeal _
  have hSup : ((vanishingIdeal Z).comap j).support = Z.preimage j.continuous := by
    rw [support_comap]
    congr 1
  rw [← hRad, ← vanishingIdeal_support, hSup]

/-- Along an open immersion `j : U ⟶ X`, the vanishing ideal sheaf of `closure {j u}` pulls back to
the vanishing ideal sheaf of `closure {u}`. -/
theorem comap_vanishingIdeal_closure_singleton_of_isOpenImmersion (j : U ⟶ X) [IsOpenImmersion j]
    (u : U) :
    (vanishingIdeal ⟨closure {j u}, isClosed_closure⟩).comap j =
      vanishingIdeal ⟨closure {u}, isClosed_closure⟩ := by
  rw [comap_vanishingIdeal_of_isOpenImmersion]
  congr 1
  ext1
  change j ⁻¹' closure {j u} = closure {u}
  rw [j.isOpenEmbedding.isOpenMap.preimage_closure_eq_closure_preimage j.continuous]
  congr 1
  ext w
  simp [j.isOpenEmbedding.injective.eq_iff]

/-- Along an open immersion `j : U ⟶ X`, the vanishing ideal sheaf of `closure {x}` for a point
`x ∉ Set.range j` pulls back to the unit ideal sheaf on `U`. -/
theorem comap_vanishingIdeal_closure_singleton_eq_top_of_notMem_range (j : U ⟶ X)
    [IsOpenImmersion j] {x : X} (hx : x ∉ Set.range j) :
    (vanishingIdeal ⟨closure {x}, isClosed_closure⟩).comap j = ⊤ := by
  rw [comap_vanishingIdeal_of_isOpenImmersion, ← vanishingIdeal_bot (X := U)]
  congr 1
  ext1
  change j ⁻¹' closure {x} = ∅
  rw [j.isOpenEmbedding.isOpenMap.preimage_closure_eq_closure_preimage j.continuous]
  have hpre : j ⁻¹' {x} = ∅ := Set.eq_empty_of_forall_notMem fun v hv ↦ hx ⟨v, hv⟩
  simp [hpre]

end AlgebraicGeometry.Scheme.IdealSheafData

namespace TauCeti.AlgebraicGeometry

section OpenImmersion

variable {U X : Scheme.{u}}

/-- The source of an open immersion into a Noetherian scheme is Noetherian. -/
theorem isNoetherian_of_isOpenImmersion (j : U ⟶ X) [IsOpenImmersion j] [IsNoetherian X] :
    IsNoetherian U := by
  have := isLocallyNoetherian_of_isOpenImmersion j
  have : CompactSpace U :=
    ⟨by simpa using QuasiCompact.isCompact_preimage (f := j) Set.univ isOpen_univ isCompact_univ⟩
  exact {}

/-- An open immersion from a nonempty scheme into an irreducible scheme is dominant. -/
theorem isDominant_of_isOpenImmersion [IrreducibleSpace X] [Nonempty U] (j : U ⟶ X)
    [IsOpenImmersion j] : IsDominant j := by
  obtain ⟨u⟩ := ‹Nonempty U›
  have : Nonempty j.opensRange := ⟨⟨j u, ⟨u, rfl⟩⟩⟩
  have hmem : genericPoint X ∈ j.opensRange := Scheme.genericPoint_mem j.opensRange
  exact ⟨(dense_iff_closure_eq.mpr (genericPoint_closure X)).mono
    (Set.singleton_subset_iff.mpr hmem)⟩

/-- A dominant open immersion between irreducible schemes induces an isomorphism on generic stalks
(function fields when the schemes are integral). -/
instance isIso_functionFieldMap_of_isOpenImmersion [IrreducibleSpace X] [IrreducibleSpace U]
    (j : U ⟶ X) [IsOpenImmersion j] [IsDominant j] : IsIso j.functionFieldMap := by
  have hIso : ∀ {x y : X} (h : x = y),
      IsIso (X.presheaf.stalkSpecializes (specializes_of_eq h)) := by
    rintro x _ rfl
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    infer_instance
  let φ := X.presheaf.stalkSpecializes (specializes_of_eq j.genericPoint_eq_of_isDominant) ≫
    j.stalkMap (genericPoint U)
  have hφ : φ = j.functionFieldMap := by
    rw [j.eq_functionFieldMap_iff, Spec.map_comp_assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk]
  have := hIso j.genericPoint_eq_of_isDominant
  rw [← hφ]
  infer_instance

/-- The injection on codimension-one points induced by an open immersion `j : U ⟶ X`. -/
@[expose]
def CodimensionOnePoint.mapOfIsOpenImmersion (j : U ⟶ X) [IsOpenImmersion j]
    (u : CodimensionOnePoint U) : CodimensionOnePoint X :=
  ⟨j u, (coheight_eq_of_isOpenImmersion j).trans u.2⟩

/-- The underlying point of `CodimensionOnePoint.mapOfIsOpenImmersion j u` is `j u`. -/
@[simp]
lemma CodimensionOnePoint.coe_mapOfIsOpenImmersion (j : U ⟶ X) [IsOpenImmersion j]
    (u : CodimensionOnePoint U) :
    (CodimensionOnePoint.mapOfIsOpenImmersion j u : X) = j u :=
  rfl

/-- `CodimensionOnePoint.mapOfIsOpenImmersion j` is injective. -/
lemma CodimensionOnePoint.mapOfIsOpenImmersion_injective (j : U ⟶ X) [IsOpenImmersion j] :
    Function.Injective (CodimensionOnePoint.mapOfIsOpenImmersion j) :=
  fun _ _ h ↦ Subtype.ext (j.isOpenEmbedding.injective (congrArg Subtype.val h))

/-- A codimension-one point of `X` lies in the image of `CodimensionOnePoint.mapOfIsOpenImmersion j`
if and only if its underlying point lies in `Set.range j`. -/
lemma CodimensionOnePoint.mem_range_mapOfIsOpenImmersion_iff (j : U ⟶ X) [IsOpenImmersion j]
    {η : CodimensionOnePoint X} :
    η ∈ Set.range (CodimensionOnePoint.mapOfIsOpenImmersion j) ↔ (η : X) ∈ Set.range j := by
  refine ⟨fun ⟨u, hu⟩ ↦ ⟨u.1, congrArg Subtype.val hu⟩, fun ⟨u, hu⟩ ↦ ?_⟩
  refine ⟨⟨u, (coheight_eq_of_isOpenImmersion j).symm.trans (hu.symm ▸ η.2)⟩, Subtype.ext hu⟩

end OpenImmersion

namespace LineBundleClass

open Scheme.IdealSheafData

section Factorial

variable {U X : Scheme.{u}} [IsIntegral X] [IsNoetherian X]
  [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)]

/-- Pulling back the prime-divisor line-bundle class `[𝒪_X(closure {j u})]` along an open immersion
`j : U ⟶ X` gives `[𝒪_U(closure {u})]`. -/
theorem pullback_inv_mk_toInvertibleSheaf_vanishingIdeal_of_isOpenImmersion (j : U ⟶ X)
    [IsOpenImmersion j] [Nonempty U] (u : CodimensionOnePoint U) :
    letI : IsIntegral U := isIntegral_of_isOpenImmersion j
    letI : IsNoetherian U := isNoetherian_of_isOpenImmersion j
    letI : ∀ v : U, UniqueFactorizationMonoid (U.presheaf.stalk v) := fun v ↦
      (asIso (j.stalkMap v)).commRingCatIsoToRingEquiv.toMulEquiv.uniqueFactorizationMonoid
        inferInstance
    pullback j (mk (isEffectiveCartier_vanishingIdeal_closure_singleton
        (CodimensionOnePoint.mapOfIsOpenImmersion j u).2).toInvertibleSheaf)⁻¹ =
      (mk (isEffectiveCartier_vanishingIdeal_closure_singleton u.2).toInvertibleSheaf)⁻¹ := by
  have : IsIntegral U := isIntegral_of_isOpenImmersion j
  have : IsNoetherian U := isNoetherian_of_isOpenImmersion j
  have : ∀ v : U, UniqueFactorizationMonoid (U.presheaf.stalk v) := fun v ↦
    (asIso (j.stalkMap v)).commRingCatIsoToRingEquiv.toMulEquiv.uniqueFactorizationMonoid
      inferInstance
  have hcomap : (vanishingIdeal
      ⟨closure {(CodimensionOnePoint.mapOfIsOpenImmersion j u : X)}, isClosed_closure⟩).comap j =
      vanishingIdeal ⟨closure {(u : U)}, isClosed_closure⟩ :=
    comap_vanishingIdeal_closure_singleton_of_isOpenImmersion j u.1
  have hU : ((vanishingIdeal
      ⟨closure {(CodimensionOnePoint.mapOfIsOpenImmersion j u : X)},
        isClosed_closure⟩).comap j).IsEffectiveCartier :=
    hcomap ▸ isEffectiveCartier_vanishingIdeal_closure_singleton u.2
  rw [pullback_inv, (isEffectiveCartier_vanishingIdeal_closure_singleton
      (CodimensionOnePoint.mapOfIsOpenImmersion j u).2).pullback_mk_toInvertibleSheaf hU,
    mk_toInvertibleSheaf_congr hU (isEffectiveCartier_vanishingIdeal_closure_singleton u.2) hcomap]

/-- Pulling back the prime-divisor line-bundle class `[𝒪_X(closure {η})]` along an open immersion
`j : U ⟶ X` gives `1` whenever `η` lies outside `Set.range j`. -/
theorem pullback_inv_mk_toInvertibleSheaf_vanishingIdeal_eq_one_of_notMem_range (j : U ⟶ X)
    [IsOpenImmersion j] {η : CodimensionOnePoint X} (hη : (η : X) ∉ Set.range j) :
    pullback j (mk (isEffectiveCartier_vanishingIdeal_closure_singleton η.2).toInvertibleSheaf)⁻¹ =
      1 := by
  have hcomap := comap_vanishingIdeal_closure_singleton_eq_top_of_notMem_range j hη
  have hU : ((vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩).comap j).IsEffectiveCartier :=
    hcomap ▸ isEffectiveCartier_top U
  rw [pullback_inv,
    (isEffectiveCartier_vanishingIdeal_closure_singleton η.2).pullback_mk_toInvertibleSheaf hU,
    mk_toInvertibleSheaf_congr hU (isEffectiveCartier_top U) hcomap, mk_toInvertibleSheaf_top,
    inv_one]

/-- **Compatibility of `Cl ≃+ Pic` with open restriction.** On a Noetherian locally factorial
integral scheme `X`, pulling back the line-bundle class attached to a Weil divisor `D` along a
nonempty open immersion `j : U ⟶ X` agrees with restricting `D` to `U` and taking its line-bundle
class. -/
theorem pullback_classGroupAddEquivLineBundleClass (j : U ⟶ X) [IsOpenImmersion j] [Nonempty U]
    (D : SchemeWeilDivisor X) :
    letI : IsIntegral U := isIntegral_of_isOpenImmersion j
    letI : IsNoetherian U := isNoetherian_of_isOpenImmersion j
    letI : ∀ v : U, UniqueFactorizationMonoid (U.presheaf.stalk v) := fun v ↦
      (asIso (j.stalkMap v)).commRingCatIsoToRingEquiv.toMulEquiv.uniqueFactorizationMonoid
        inferInstance
    MonoidHom.toAdditive (pullbackHom j)
        (SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid X
          ((WeilDivisor.OrderSystem.ofScheme X).divisorClass D)) =
      SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid U
        ((WeilDivisor.OrderSystem.ofScheme U).divisorClass
          (WeilDivisor.pullback (CodimensionOnePoint.mapOfIsOpenImmersion_injective j) D)) := by
  have : IsIntegral U := isIntegral_of_isOpenImmersion j
  have : IsNoetherian U := isNoetherian_of_isOpenImmersion j
  have : ∀ v : U, UniqueFactorizationMonoid (U.presheaf.stalk v) := fun v ↦
    (asIso (j.stalkMap v)).commRingCatIsoToRingEquiv.toMulEquiv.uniqueFactorizationMonoid
      inferInstance
  let φ : SchemeWeilDivisor X →+ Additive (LineBundleClass U) :=
    (MonoidHom.toAdditive (pullbackHom j)).comp
      (SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid
        X).toAddMonoidHom |>.comp (WeilDivisor.OrderSystem.ofScheme X).divisorClass
  let ψ : SchemeWeilDivisor X →+ Additive (LineBundleClass U) :=
    (SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid
      U).toAddMonoidHom.comp (WeilDivisor.OrderSystem.ofScheme U).divisorClass |>.comp
      (WeilDivisor.pullback (CodimensionOnePoint.mapOfIsOpenImmersion_injective j))
  refine WeilDivisor.induction_add_ofPoint (P := fun E ↦ φ E = ψ E)
    (by rw [map_zero, map_zero]) (fun E η ↦ ?_) D
  suffices hη : φ (WeilDivisor.ofPoint η) = ψ (WeilDivisor.ofPoint η) by
    rw [map_add, map_add, hη, add_right_cancel_iff]
  by_cases hmem : (η : X) ∈ Set.range j
  · obtain ⟨u, rfl⟩ := (CodimensionOnePoint.mem_range_mapOfIsOpenImmersion_iff j).mpr hmem
    simp only [φ, ψ, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
      WeilDivisor.pullback_ofPoint,
      SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid_ofPoint,
      MonoidHom.toAdditive_apply_apply, pullbackHom_apply, toMul_ofMul]
    exact congrArg Additive.ofMul
      (pullback_inv_mk_toInvertibleSheaf_vanishingIdeal_of_isOpenImmersion j u)
  · have hnot : η ∉ Set.range (CodimensionOnePoint.mapOfIsOpenImmersion j) :=
      fun h ↦ hmem ((CodimensionOnePoint.mem_range_mapOfIsOpenImmersion_iff j).mp h)
    simp only [φ, ψ, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
      WeilDivisor.pullback_ofPoint_of_notMem_range _ hnot, map_zero,
      SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid_ofPoint,
      MonoidHom.toAdditive_apply_apply, pullbackHom_apply, toMul_ofMul]
    rw [pullback_inv_mk_toInvertibleSheaf_vanishingIdeal_eq_one_of_notMem_range j hmem, ofMul_one]

omit [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] in
/-- Restricting a principal Weil divisor on `X` along an open immersion `j : U ⟶ X` gives the
principal Weil divisor of the pulled-back rational function. -/
private lemma pullback_principalDivisor_of_isOpenImmersion (j : U ⟶ X) [IsOpenImmersion j]
    [Nonempty U] (f : Additive X.functionFieldˣ) :
    letI : IsIntegral U := isIntegral_of_isOpenImmersion j
    letI : IsNoetherian U := isNoetherian_of_isOpenImmersion j
    letI : IsDominant j := isDominant_of_isOpenImmersion j
    WeilDivisor.pullback (CodimensionOnePoint.mapOfIsOpenImmersion_injective j)
        ((WeilDivisor.OrderSystem.ofScheme X).principalDivisor f) =
      (WeilDivisor.OrderSystem.ofScheme U).principalDivisor
        (Additive.ofMul (Units.map j.functionFieldMap.hom.toMonoidHom f.toMul)) := by
  have : IsIntegral U := isIntegral_of_isOpenImmersion j
  have : IsNoetherian U := isNoetherian_of_isOpenImmersion j
  have : IsDominant j := isDominant_of_isOpenImmersion j
  ext u
  rw [WeilDivisor.coeff_pullback, WeilDivisor.OrderSystem.coeff_principalDivisor,
    WeilDivisor.OrderSystem.coeff_principalDivisor, WeilDivisor.OrderSystem.ofScheme_ord,
    WeilDivisor.OrderSystem.ofScheme_ord, SchemeWeilDivisor.orderAt_apply,
    SchemeWeilDivisor.orderAt_apply]
  exact (Scheme.ord_functionFieldMap j _ u.1).symm

/-- **Surjectivity of Picard restriction to a dense open.** On a Noetherian locally factorial
integral scheme `X`, pullback of line-bundle classes along a nonempty open immersion `j : U ⟶ X`
is surjective. Hartshorne, Proposition II.6.5(b). -/
theorem pullback_surjective_of_isOpenImmersion (j : U ⟶ X) [IsOpenImmersion j] [Nonempty U] :
    Function.Surjective (pullback j) := by
  have : IsIntegral U := isIntegral_of_isOpenImmersion j
  have : IsNoetherian U := isNoetherian_of_isOpenImmersion j
  have : ∀ v : U, UniqueFactorizationMonoid (U.presheaf.stalk v) := fun v ↦
    (asIso (j.stalkMap v)).commRingCatIsoToRingEquiv.toMulEquiv.uniqueFactorizationMonoid
      inferInstance
  intro b
  obtain ⟨D, hD⟩ : ∃ D : SchemeWeilDivisor U,
      SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid U
        ((WeilDivisor.OrderSystem.ofScheme U).divisorClass D) = Additive.ofMul b := by
    obtain ⟨c, hc⟩ :=
      (SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid
        U).surjective (Additive.ofMul b)
    obtain ⟨D, rfl⟩ := (WeilDivisor.OrderSystem.ofScheme U).divisorClass_surjective c
    exact ⟨D, hc⟩
  let E : SchemeWeilDivisor X :=
    WeilDivisor.pushforward (CodimensionOnePoint.mapOfIsOpenImmersion j) D
  refine ⟨(SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid X
      ((WeilDivisor.OrderSystem.ofScheme X).divisorClass E)).toMul, ?_⟩
  have h := pullback_classGroupAddEquivLineBundleClass j E
  rw [WeilDivisor.pullback_pushforward, hD, MonoidHom.toAdditive_apply_apply,
    pullbackHom_apply] at h
  exact Additive.ofMul.injective h

/-- On a Noetherian locally factorial integral scheme `X`, a Weil divisor supported inside a finite
set `F` of codimension-one points represents the product of the prime-divisor line bundles over `F`
raised to its coefficients. -/
private lemma toMul_classGroupAddEquiv_of_support_subset {F : Finset (CodimensionOnePoint X)}
    {D : SchemeWeilDivisor X} (hD : (D.support : Set (CodimensionOnePoint X)) ⊆ F) :
    (SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid X
        ((WeilDivisor.OrderSystem.ofScheme X).divisorClass D)).toMul =
      ∏ η : F, (mk (isEffectiveCartier_vanishingIdeal_closure_singleton
        η.1.2).toInvertibleSheaf)⁻¹ ^ (WeilDivisor.coeff D η.1) := by
  have hsum : D = ∑ η ∈ F, WeilDivisor.coeff D η • WeilDivisor.ofPoint η := by
    calc D = ∑ η ∈ D.support, D η • WeilDivisor.ofPoint η := by
          conv_lhs => rw [← Finsupp.sum_single D]
          exact Finset.sum_congr rfl fun η _ ↦ WeilDivisor.single_eq_zsmul_ofPoint η (D η)
      _ = ∑ η ∈ F, WeilDivisor.coeff D η • WeilDivisor.ofPoint η :=
          Finset.sum_subset hD fun η _ hnot ↦ by
            rw [Finsupp.notMem_support_iff.mp hnot, zero_smul]
  conv_lhs => rw [hsum]
  rw [map_sum, map_sum, toMul_sum, ← Finset.prod_coe_sort]
  refine Finset.prod_congr rfl fun η _ ↦ ?_
  rw [map_zsmul, map_zsmul,
    SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid_ofPoint,
    toMul_zsmul, toMul_ofMul]

/-- Every line-bundle class in the kernel of restriction along a nonempty open immersion `j : U ⟶ X`
is represented by a Weil divisor whose restriction to `U` vanishes. -/
private lemma exists_divisor_pullback_eq_zero_of_pullback_eq_one (j : U ⟶ X) [IsOpenImmersion j]
    [Nonempty U] {a : LineBundleClass X} (ha : pullback j a = 1) :
    ∃ D' : SchemeWeilDivisor X,
      SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid X
        ((WeilDivisor.OrderSystem.ofScheme X).divisorClass D') = Additive.ofMul a ∧
      WeilDivisor.pullback (CodimensionOnePoint.mapOfIsOpenImmersion_injective j) D' = 0 := by
  have : IsIntegral U := isIntegral_of_isOpenImmersion j
  have : IsNoetherian U := isNoetherian_of_isOpenImmersion j
  have : IsDominant j := isDominant_of_isOpenImmersion j
  have : ∀ v : U, UniqueFactorizationMonoid (U.presheaf.stalk v) := fun v ↦
    (asIso (j.stalkMap v)).commRingCatIsoToRingEquiv.toMulEquiv.uniqueFactorizationMonoid
      inferInstance
  obtain ⟨c₀, hc₀⟩ :=
    (SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid
      X).surjective (Additive.ofMul a)
  obtain ⟨D, rfl⟩ := (WeilDivisor.OrderSystem.ofScheme X).divisorClass_surjective c₀
  have hDU : (WeilDivisor.OrderSystem.ofScheme U).divisorClass
      (WeilDivisor.pullback (CodimensionOnePoint.mapOfIsOpenImmersion_injective j) D) = 0 := by
    apply (SchemeWeilDivisor.classGroupAddEquivLineBundleClassOfUniqueFactorizationMonoid
      U).injective
    rw [map_zero, ← pullback_classGroupAddEquivLineBundleClass j D, hc₀,
      MonoidHom.toAdditive_apply_apply, pullbackHom_apply, toMul_ofMul, ha, ofMul_one]
  rw [WeilDivisor.OrderSystem.divisorClass_eq_zero_iff,
    WeilDivisor.OrderSystem.mem_principalSubgroup] at hDU
  obtain ⟨g, hg⟩ := hDU
  let e := Units.mapEquiv (asIso j.functionFieldMap).commRingCatIsoToRingEquiv.toMulEquiv
  let f : Additive X.functionFieldˣ := Additive.ofMul (e.symm g.toMul)
  refine ⟨D - (WeilDivisor.OrderSystem.ofScheme X).principalDivisor f, ?_, ?_⟩
  · rw [map_sub, WeilDivisor.OrderSystem.divisorClass_principalDivisor, sub_zero, hc₀]
  · rw [map_sub, pullback_principalDivisor_of_isOpenImmersion j f, toMul_ofMul,
      show Units.map j.functionFieldMap.hom.toMonoidHom (e.symm g.toMul) = g.toMul from
        e.apply_symm_apply g.toMul, ofMul_toMul, hg, sub_self]

/-- **Kernel of Picard restriction to a dense open.** On a Noetherian locally factorial integral
scheme `X`, for any nonempty open immersion `j : U ⟶ X` and finite set `F` of codimension-one
points equal to `{η | (η : X) ∉ Set.range j}`, a line-bundle class `a` on `X` pulls back to `1` on
`U` if and only if it is an integer-power product of `[𝒪_X(closure {η})]` for `η ∈ F`.
Hartshorne, Proposition II.6.5(c). -/
theorem pullback_eq_one_iff_of_isOpenImmersion (j : U ⟶ X) [IsOpenImmersion j] [Nonempty U]
    {F : Finset (CodimensionOnePoint X)}
    (hF : (F : Set (CodimensionOnePoint X)) =
      {η : CodimensionOnePoint X | (η : X) ∉ Set.range j})
    {a : LineBundleClass X} :
    pullback j a = 1 ↔
      ∃ c : F → ℤ, a = ∏ η : F,
        (mk (isEffectiveCartier_vanishingIdeal_closure_singleton
          η.1.2).toInvertibleSheaf)⁻¹ ^ c η := by
  refine ⟨fun ha ↦ ?_, ?_⟩
  · obtain ⟨D', hc₀, hD'pull⟩ := exists_divisor_pullback_eq_zero_of_pullback_eq_one j ha
    have hsupp : (D'.support : Set (CodimensionOnePoint X)) ⊆ F := by
      rw [hF]
      intro η hη hmem
      obtain ⟨u, rfl⟩ := (CodimensionOnePoint.mem_range_mapOfIsOpenImmersion_iff j).mpr hmem
      have h0 : WeilDivisor.coeff (WeilDivisor.pullback
          (CodimensionOnePoint.mapOfIsOpenImmersion_injective j) D') u = 0 := by
        rw [hD'pull, WeilDivisor.coeff_zero]
      rw [WeilDivisor.coeff_pullback] at h0
      exact Finsupp.mem_support_iff.mp hη h0
    refine ⟨fun η ↦ WeilDivisor.coeff D' η.1, ?_⟩
    rw [← toMul_classGroupAddEquiv_of_support_subset hsupp, hc₀, toMul_ofMul]
  · rintro ⟨c, rfl⟩
    rw [← pullbackHom_apply, map_prod]
    refine Finset.prod_eq_one fun η _ ↦ ?_
    have hnot : (η.1 : X) ∉ Set.range j := by
      have hmem : η.1 ∈ (F : Set (CodimensionOnePoint X)) := η.2
      rwa [hF] at hmem
    rw [pullbackHom_apply, pullback_zpow,
      pullback_inv_mk_toInvertibleSheaf_vanishingIdeal_eq_one_of_notMem_range j hnot, one_zpow]

end Factorial

section Regular

variable {U X : Scheme.{u}} [IsIntegral X] [IsNoetherian X] [IsRegular X]

/-- **Surjectivity of Picard restriction on regular schemes of codimension at most two.**
Stacks Tag 0C9X (general open-immersion form). -/
@[stacks 0C9X]
theorem pullback_surjective_of_isRegular (hX : ∀ x : X, coheight x ≤ 2) (j : U ⟶ X)
    [IsOpenImmersion j] [Nonempty U] :
    Function.Surjective (pullback j) :=
  let := fun x ↦ IsRegular.uniqueFactorizationMonoid_stalk x (hX x)
  pullback_surjective_of_isOpenImmersion j

/-- **Kernel of Picard restriction on regular schemes of codimension at most two.**
Stacks Tag 0C9X (general open-immersion form). -/
@[stacks 0C9X]
theorem pullback_eq_one_iff_of_isRegular (hX : ∀ x : X, coheight x ≤ 2) (j : U ⟶ X)
    [IsOpenImmersion j] [Nonempty U] {F : Finset (CodimensionOnePoint X)}
    (hF : (F : Set (CodimensionOnePoint X)) =
      {η : CodimensionOnePoint X | (η : X) ∉ Set.range j})
    {a : LineBundleClass X} :
    pullback j a = 1 ↔
      ∃ c : F → ℤ, a = ∏ η : F,
        (mk (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular hX
          η.1.2).toInvertibleSheaf)⁻¹ ^ c η :=
  let := fun x ↦ IsRegular.uniqueFactorizationMonoid_stalk x (hX x)
  pullback_eq_one_iff_of_isOpenImmersion j hF

end Regular

end LineBundleClass

