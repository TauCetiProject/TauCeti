namespace TauCeti

open TauCeti.AlgebraicGeometry Scheme.IdealSheafData

section GenericFiber

variable (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K]
  {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))

/-- Over a discrete valuation ring `R` with fraction field `K`, the set-theoretic image of
`genericFiberι R K toBase` consists of the points of `X` not lying over the closed point of
`Spec R`. -/
theorem range_genericFiberι_eq_setOf_ne_closedPoint :
    Set.range (genericFiberι R K toBase) = {x : X | toBase x ≠ closedPoint R} := by
  have hrange : Set.range (genericFiberι R K toBase) =
      toBase ⁻¹' {genericPoint (Spec (.of R))} :=
    calc Set.range (genericFiberι R K toBase)
        = Set.range (genericFiberι R K toBase ∘
            (genericFiberIsoFiberGenericPoint (R := .of R) (K := K) toBase).inv) :=
          ((genericFiberIsoFiberGenericPoint (R := .of R) (K := K)
            toBase).inv.surjective.range_comp _).symm
      _ = Set.range ((genericFiberIsoFiberGenericPoint (R := .of R) (K := K) toBase).inv ≫
            genericFiberι R K toBase) :=
          congrArg Set.range (funext fun x ↦ (Scheme.Hom.comp_apply _ _ x).symm)
      _ = Set.range (toBase.fiberι (genericPoint (Spec (.of R)))) :=
          congrArg (fun g : toBase.fiber (genericPoint (Spec (.of R))) ⟶ X ↦ Set.range g)
            (genericFiberIsoFiberGenericPoint_inv_genericFiberι (R := .of R) (K := K) toBase)
      _ = toBase ⁻¹' {genericPoint (Spec (.of R))} :=
          Scheme.Hom.range_fiberι toBase _
  rw [hrange]
  have hp : genericPoint (Spec (.of R)) = (⊥ : PrimeSpectrum R) :=
    genericPoint_eq_bot_of_affine (.of R)
  have hbot_ne : (⊥ : PrimeSpectrum R) ≠ closedPoint R := fun h ↦
    IsDiscreteValuationRing.not_a_field R (congrArg PrimeSpectrum.asIdeal h).symm
  ext x
  let y : PrimeSpectrum R := toBase x
  change y = genericPoint (Spec (.of R)) ↔ y ≠ closedPoint R
  rw [hp]
  rcases IsLocalRing.Ring.KrullDimLE.eq_bot_or_eq_top y with hy | hy
  · rw [hy]
    exact ⟨fun _ ↦ hbot_ne, fun _ ↦ rfl⟩
  · rw [hy]
    exact ⟨fun h ↦ absurd h.symm hbot_ne, fun h ↦ absurd rfl h⟩

/-- If the generic point of `X` does not map to the closed point of `Spec R`, then the generic
fibre `(genericFiber R K toBase).left` is nonempty. -/
theorem nonempty_genericFiber_of_base_ne_closedPoint [IrreducibleSpace X]
    (hη : toBase (genericPoint X) ≠ closedPoint R) :
    Nonempty (genericFiber R K toBase).left := by
  have hmem : genericPoint X ∈ Set.range (genericFiberι R K toBase) := by
    rw [range_genericFiberι_eq_setOf_ne_closedPoint]
    exact hη
  obtain ⟨y, -⟩ := hmem
  exact ⟨y⟩

variable {R K}
variable [IsIntegral X] [IsNoetherian X] [TauCeti.AlgebraicGeometry.IsRegular X]

/-- **Surjectivity of Picard restriction to the generic fibre (Stacks Tag 0C9X).** Let `X` be a
regular Noetherian integral scheme over a discrete valuation ring `R` with fraction field `K`,
with all points of codimension at most two and generic point outside the special fibre. Then
restriction `Pic(X) → Pic(X_K)` is surjective. -/
@[stacks 0C9X]
theorem pullback_genericFiberι_surjective (hX : ∀ x : X, coheight x ≤ 2)
    (hη : toBase (genericPoint X) ≠ closedPoint R) :
    Function.Surjective (LineBundleClass.pullback (genericFiberι R K toBase)) := by
  have := isOpenImmersion_genericFiberι R K toBase
  have := nonempty_genericFiber_of_base_ne_closedPoint R K toBase hη
  exact LineBundleClass.pullback_surjective_of_isRegular hX (genericFiberι R K toBase)

/-- **Kernel of Picard restriction to the generic fibre (Stacks Tag 0C9X).** Under the hypotheses
of `TauCeti.pullback_genericFiberι_surjective`, a line-bundle class on `X` restricts to `1` on the
generic fibre `X_K` if and only if it is an integer-power product of the line bundles
`[𝒪_X(Cᵢ)]` attached to the irreducible components `Cᵢ` of the special fibre. -/
@[stacks 0C9X]
theorem pullback_genericFiberι_eq_one_iff (hX : ∀ x : X, coheight x ≤ 2)
    (hη : toBase (genericPoint X) ≠ closedPoint R) {a : LineBundleClass X} :
    LineBundleClass.pullback (genericFiberι R K toBase) a = 1 ↔
      ∃ c : (toBase.finite_setOf_base_eq_closedPoint
          (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset → ℤ,
        a = ∏ i, (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular hX
            i.1.2).toInvertibleSheaf)⁻¹ ^ c i := by
  have := isOpenImmersion_genericFiberι R K toBase
  have := nonempty_genericFiber_of_base_ne_closedPoint R K toBase hη
  refine LineBundleClass.pullback_eq_one_iff_of_isRegular hX (genericFiberι R K toBase) ?_
  ext η
  simp only [Finset.mem_coe, Set.Finite.mem_toFinset, Set.mem_ofPred_eq,
    range_genericFiberι_eq_setOf_ne_closedPoint, Classical.not_not]

end GenericFiber

namespace Model

variable {R K : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K]
  {C : Scheme.{u}} {toK : C ⟶ Spec (.of K)} (M : Model R K C toK)

/-- The image of a model's chosen generic fibre in its total space is the complement of the
special fibre. -/
theorem range_genericι_eq_setOf_ne_closedPoint :
    Set.range M.genericι = {x : M.total | M.toBase x ≠ closedPoint R} := by
  have hIso : IsIso M.genericFiberIso.inv.left :=
    inferInstanceAs (IsIso ((Over.forget _).map M.genericFiberIso.inv))
  rw [M.genericι_def]
  calc Set.range (M.genericFiberIso.inv.left ≫ genericFiberι R K M.toBase)
      = Set.range (genericFiberι R K M.toBase ∘ M.genericFiberIso.inv.left) :=
        congrArg Set.range (funext fun x ↦ Scheme.Hom.comp_apply _ _ x)
    _ = Set.range (genericFiberι R K M.toBase) :=
        M.genericFiberIso.inv.left.surjective.range_comp _
    _ = {x : M.total | M.toBase x ≠ closedPoint R} :=
        range_genericFiberι_eq_setOf_ne_closedPoint R K M.toBase

variable [IsIntegral M.total] [IsNoetherian M.total] [TauCeti.AlgebraicGeometry.IsRegular M.total]

/-- **Surjectivity of `Pic(M.total) → Pic(C)` for a regular model (Stacks Tag 0C9X).** -/
@[stacks 0C9X]
theorem pullback_genericι_surjective (hM : ∀ x : M.total, coheight x ≤ 2) :
    Function.Surjective (LineBundleClass.pullback M.genericι) := by
  have := M.isOpenImmersion_genericι
  have hη := M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R)
  have : Nonempty C := by
    have hmem : genericPoint M.total ∈ Set.range M.genericι := by
      rw [M.range_genericι_eq_setOf_ne_closedPoint]
      exact hη
    obtain ⟨c, -⟩ := hmem
    exact ⟨c⟩
  exact LineBundleClass.pullback_surjective_of_isRegular hM M.genericι

/-- **Kernel of `Pic(M.total) → Pic(C)` for a regular model (Stacks Tag 0C9X).** -/
@[stacks 0C9X]
theorem pullback_genericι_eq_one_iff (hM : ∀ x : M.total, coheight x ≤ 2)
    {a : LineBundleClass M.total} :
    LineBundleClass.pullback M.genericι a = 1 ↔
      ∃ c : (M.toBase.finite_setOf_base_eq_closedPoint (IsDiscreteValuationRing.not_a_field R)
          (M.toBase.base_genericPoint_ne_closedPoint
            (IsDiscreteValuationRing.not_a_field R))).toFinset → ℤ,
        a = ∏ i, (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular hM
            i.1.2).toInvertibleSheaf)⁻¹ ^ c i := by
  have := M.isOpenImmersion_genericι
  have hη := M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R)
  have : Nonempty C := by
    have hmem : genericPoint M.total ∈ Set.range M.genericι := by
      rw [M.range_genericι_eq_setOf_ne_closedPoint]
      exact hη
    obtain ⟨c, -⟩ := hmem
    exact ⟨c⟩
  refine LineBundleClass.pullback_eq_one_iff_of_isRegular hM M.genericι ?_
  ext η
  simp only [Finset.mem_coe, Set.Finite.mem_toFinset, Set.mem_ofPred_eq,
    M.range_genericι_eq_setOf_ne_closedPoint, Classical.not_not]

end Model

end TauCeti
