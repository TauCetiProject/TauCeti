module

public import TauCeti.AlgebraicGeometry.LineBundle.ProjectiveMap.Basic
public import TauCeti.AlgebraicGeometry.Morphisms.Immersion
import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
import Mathlib.AlgebraicGeometry.ZariskisMainTheorem

/-!
# Projective immersions from section ratios

A morphism defined by sections is an immersion when affine nonvanishing charts of the
source are recovered by the corresponding coordinate ratios.

## References

* R. Hartshorne, *Algebraic Geometry*, Chapter II, Proposition 7.2.
-/

public section

open CategoryTheory AlgebraicGeometry TopologicalSpace

noncomputable section

universe u

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

attribute [local instance] MvPolynomial.gradedAlgebra

variable {X : Scheme.{u}} (L : InvertibleSheaf X) {I R : Type u} [CommRing R]
  (s : I → Γ(L.obj, ⊤)) (c : R →+* Γ(X, ⊤))
  (hcover : ⨆ i, L.obj.nonvanishingLocus (s i) = ⊤)

/-- A covering chart's coordinate homomorphism is surjective if its section ratios include
algebra generators of that chart. -/
theorem surjective_coordinateRingHom_of_generators (i : I) {U : X.Opens}
    (hU : U = L.obj.nonvanishingLocus (s i)) {K : Type u}
    (f : K → Γ(X, U))
    (hf : Function.Surjective (MvPolynomial.eval₂Hom
      ((X.presheaf.map (homOfLE le_top).op).hom.comp c) f))
    (v : K → I)
    (hv : ∀ k, X.presheaf.map (homOfLE hU.le).op (L.sectionRatio s i (v k)) = f k) :
    Function.Surjective (L.coordinateRingHom s c i) := by
  let W := L.obj.nonvanishingLocus (s i)
  let ρ : Γ(W.toScheme, ⊤) →+* Γ(X, U) :=
    (X.presheaf.map (homOfLE hU.le).op).hom.comp W.topIso.hom.hom
  have : IsIso (X.presheaf.map (homOfLE hU.le).op) := by
    rw [Subsingleton.elim (homOfLE hU.le) (eqToHom hU)]
    infer_instance
  have hρ : Function.Injective ρ :=
    (ConcreteCategory.bijective_of_isIso (X.presheaf.map (homOfLE hU.le).op)).injective.comp
      (ConcreteCategory.bijective_of_isIso W.topIso.hom).injective
  have heval : ρ.comp ((L.coordinateRingHom s c i).comp (MvPolynomial.rename v).toRingHom) =
      MvPolynomial.eval₂Hom ((X.presheaf.map (homOfLE le_top).op).hom.comp c) f := by
    apply MvPolynomial.ringHom_ext
    · intro r
      -- Evaluate the composite ring homomorphism on a polynomial constant.
      change ρ (L.coordinateRingHom s c i (MvPolynomial.rename v (MvPolynomial.C r))) = _
      rw [MvPolynomial.rename_C, L.coordinateRingHom_C]
      simp only [ρ, RingHom.comp_apply, W, Iso.inv_hom_id_apply, MvPolynomial.eval₂Hom_C]
      -- Identify the chart's coefficient map with restriction of ambient sections.
      change X.presheaf.map _ (X.presheaf.map _ (c r)) = X.presheaf.map _ (c r)
      calc
        _ = X.presheaf.map (_ ≫ _) (c r) := (Functor.map_comp_apply _ _ _ (c r)).symm
        _ = _ := congrArg (fun f : _ ⟶ _ ↦ X.presheaf.map f (c r))
          (Subsingleton.elim _ _)
    · intro k
      -- Renaming a polynomial variable selects its prescribed section ratio.
      change ρ (L.coordinateRingHom s c i (MvPolynomial.rename v (MvPolynomial.X k))) = _
      rw [MvPolynomial.rename_X, L.coordinateRingHom_X]
      simpa only [RingHom.comp_apply, ρ, W, Iso.inv_hom_id_apply,
        MvPolynomial.eval₂Hom_X'] using hv k
  intro b
  obtain ⟨p, hp⟩ := hf (ρ b)
  exact ⟨MvPolynomial.rename v p, hρ ((DFunLike.congr_fun heval p).trans hp)⟩

/-- If an affine nonvanishing chart is generated by the coordinate ratios, its map to the
corresponding projective chart is a closed immersion. -/
theorem isClosedImmersion_projectiveMap_resLE (i : I)
    (ha : IsAffineOpen (L.obj.nonvanishingLocus (s i)))
    (hs : Function.Surjective (L.coordinateRingHom s c i)) :
    IsClosedImmersion ((L.projectiveMap s c hcover).resLE
      (Proj.basicOpen (MvPolynomial.homogeneousSubmodule I R) (MvPolynomial.X i))
      (L.obj.nonvanishingLocus (s i))
      (L.projectiveMap_preimage_basicOpen s c hcover i).ge) := by
  let A := MvPolynomial.homogeneousSubmodule I R
  let U := L.obj.nonvanishingLocus (s i)
  let D := Proj.basicOpen A (MvPolynomial.X i)
  let e := Proj.basicOpenIsoSpec A (MvPolynomial.X i)
    ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X R i))
    one_pos
  let φ := CommRingCat.ofHom (HomogeneousLocalization.Away.lift A
    (L.coordinateRingHom s c i) (f := MvPolynomial.X i) (by simp))
  have hφ : Function.Surjective φ :=
    RingHom.lift_surjective_of_eval_surjective (L.coordinateRingHom s c i) i
      (by simp) hs
  have : IsClosedImmersion (Spec.map φ) := IsClosedImmersion.spec_of_surjective φ hφ
  have : IsAffine U.toScheme := ha
  have hfactor : (L.projectiveMap s c hcover).resLE D U
      (L.projectiveMap_preimage_basicOpen s c hcover i).ge ≫ e.hom =
        U.toScheme.toSpecΓ ≫ Spec.map φ := by
    apply (cancel_mono (Proj.awayι A (MvPolynomial.X i)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr
        (MvPolynomial.isHomogeneous_X R i)) one_pos)).mp
    rw [Category.assoc]
    have he : e.hom ≫ Proj.awayι A (MvPolynomial.X i)
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr
          (MvPolynomial.isHomogeneous_X R i)) one_pos = D.ι := by
      rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
    rw [he, Scheme.Hom.resLE_comp_ι, L.ι_projectiveMap, L.localProjectiveMap_eq]
    exact (Category.assoc _ _ _).symm
  rw [← MorphismProperty.cancel_right_of_respectsIso @IsClosedImmersion _ e.hom, hfactor]
  infer_instance

/-- Affine charts whose functions are generated by section ratios make the map to projective
space an immersion. Only a covering subfamily of coordinates is required. -/
theorem isImmersion_projectiveMap_of_surjective {J : Type*} (v : J → I)
    (hv : ⨆ j, L.obj.nonvanishingLocus (s (v j)) = ⊤)
    (ha : ∀ j, IsAffineOpen (L.obj.nonvanishingLocus (s (v j))))
    (hs : ∀ j, Function.Surjective (L.coordinateRingHom s c (v j))) :
    IsImmersion (L.projectiveMap s c hcover) := by
  refine IsZariskiLocalAtTarget.of_range_subset_iSup
    (fun j ↦ Proj.basicOpen (MvPolynomial.homogeneousSubmodule I R) (MvPolynomial.X (v j)))
    ?_ fun j ↦ ?_
  · rintro _ ⟨x, rfl⟩
    obtain ⟨j, hj⟩ := Opens.mem_iSup.mp (hv.ge (Opens.mem_top x))
    exact Opens.mem_iSup.mpr ⟨j, (L.projectiveMap_preimage_basicOpen s c hcover (v j)).ge hj⟩
  · rw [← Scheme.Hom.resLE_eq_morphismRestrict,
      Scheme.Hom.resLE_congr (L.projectiveMap s c hcover) le_rfl rfl
        (L.projectiveMap_preimage_basicOpen s c hcover (v j)) @IsImmersion]
    have := L.isClosedImmersion_projectiveMap_resLE s c hcover (v j) (ha j) (hs j)
    infer_instance

/-- An immersion defined by sections of a proper scheme over the coefficient ring is closed. -/
theorem isClosedImmersion_projectiveMap
    [IsProper (X.toSpecΓ ≫ Spec.map (CommRingCat.ofHom c))]
    [IsImmersion (L.projectiveMap s c hcover)] :
    IsClosedImmersion (L.projectiveMap s c hcover) := by
  have : IsProper (L.projectiveMap s c hcover ≫
      Proj.toSpecCoeff (MvPolynomial.homogeneousSubmodule I R)) := by
    rw [L.projectiveMap_toSpecCoeff]
    infer_instance
  have : IsProper (L.projectiveMap s c hcover) :=
    IsProper.of_comp _ (Proj.toSpecCoeff (MvPolynomial.homogeneousSubmodule I R))
  exact (IsClosedImmersion.iff_isProper_and_mono _).mpr ⟨inferInstance, inferInstance⟩

end TauCeti.AlgebraicGeometry.InvertibleSheaf
