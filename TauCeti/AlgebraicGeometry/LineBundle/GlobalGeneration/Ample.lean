variable {X : Scheme.{u}}

/-- **Common affine cover by sections of a single power of an ample line bundle.** If `L` is an
ample line bundle on `X`, then there exist a positive integer `d` and finitely many global sections
of `L^{⊗ d}` whose nonvanishing loci are affine and cover `X`. -/
theorem LineBundleClass.IsAmple.exists_pos_finite_affine_cover {L : InvertibleSheaf X}
    (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ (d : ℕ) (_ : 0 < d) (m : ℕ) (s : Fin m → Γ(TauCeti.tensorPow L.obj d, ⊤)),
      (∀ i, IsAffineOpen ((TauCeti.tensorPow L.obj d).nonvanishingLocus (s i))) ∧
        (⨆ i, (TauCeti.tensorPow L.obj d).nonvanishingLocus (s i)) = ⊤ := by
  classical
  have := hL.compactSpace
  -- Around each point `x`, find a positive power `n x` and a section `t x` of `L^{⊗ n x}` with
  -- affine nonvanishing locus containing `x`.
  have hpt (x : X) : ∃ (n : ℕ) (_ : 0 < n) (t : Γ(TauCeti.tensorPow L.obj n, ⊤)),
      x ∈ (TauCeti.tensorPow L.obj n).nonvanishingLocus t ∧
        IsAffineOpen ((TauCeti.tensorPow L.obj n).nonvanishingLocus t) := by
    obtain ⟨n, hn, h⟩ := hL.exists_pos_forall_mk_eq x
    obtain ⟨t, hxt, haff⟩ := h ⟨TauCeti.tensorPow L.obj n, inferInstance⟩ (mk_tensorPow_obj L n)
    exact ⟨n, hn, t, hxt, haff⟩
  choose n hn t hxt haff using hpt
  obtain ⟨S, hS⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X ↦ ((TauCeti.tensorPow L.obj (n x)).nonvanishingLocus (t x) : Set X))
    (fun x ↦ ((TauCeti.tensorPow L.obj (n x)).nonvanishingLocus (t x)).isOpen)
    (fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hxt x⟩)
  -- Raise every section to a common positive power `d = ∏_{x ∈ S} n x`.
  let d : ℕ := ∏ x ∈ S, n x
  have hd : 0 < d := Finset.prod_pos fun x _ ↦ hn x
  have hlift (x : S) : ∃ s : Γ(TauCeti.tensorPow L.obj d, ⊤),
      (TauCeti.tensorPow L.obj d).nonvanishingLocus s =
        (TauCeti.tensorPow L.obj (n x.1)).nonvanishingLocus (t x.1) := by
    have hdvd : n x.1 ∣ d := Finset.dvd_prod_of_mem n x.2
    let k : ℕ := d / n x.1
    have hnk : n x.1 * k = d := Nat.mul_div_cancel' hdvd
    have hk : 0 < k := Nat.pos_of_ne_zero fun h0 ↦ by simp [h0] at hnk; omega
    have hclass :
        LineBundleClass.mk
            ⟨TauCeti.tensorPow (TauCeti.tensorPow L.obj (n x.1)) k, inferInstance⟩ =
          LineBundleClass.mk ⟨TauCeti.tensorPow L.obj d, inferInstance⟩ := by
      rw [mk_tensorPow_obj ⟨TauCeti.tensorPow L.obj (n x.1), inferInstance⟩ k,
        mk_tensorPow_obj, mk_tensorPow_obj, ← pow_mul, hnk]
    obtain ⟨e⟩ := LineBundleClass.mk_eq_mk_iff.mp hclass
    refine ⟨e.hom.app ⊤ (Scheme.Modules.tensorPowSection (t x.1) k), ?_⟩
    rw [Scheme.Modules.nonvanishingLocus_hom_app,
      Scheme.Modules.nonvanishingLocus_tensorPowSection (t x.1) hk]
  choose s hs using hlift
  let eS : Fin S.card ≃ S := (Fintype.equivFinOfCardEq (Fintype.card_coe S)).symm
  refine ⟨d, hd, S.card, fun i ↦ s (eS i), fun i ↦ ?_, top_unique fun x _ ↦ ?_⟩
  · rw [hs (eS i)]
    exact haff (eS i).1
  · obtain ⟨y, hyS, hxy⟩ := Set.mem_iUnion₂.mp (hS (Set.mem_univ x))
    refine Opens.mem_iSup.mpr ⟨eS.symm ⟨y, hyS⟩, ?_⟩
    dsimp only
    rw [Equiv.apply_symm_apply, hs ⟨y, hyS⟩]
    exact hxy

end TauCeti.AlgebraicGeometry

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-! ### Serre's twisting-generation theorem -/

/-- Raise a global section of `F ⊗ M^{⊗ k}` to degree `n ≥ k` by tensoring with `s^{n - k}` and
combining the tensor powers `M^{⊗ k} ⊗ M^{⊗ (n - k)} ≅ M^{⊗ n}`. -/
private def raiseSection (F M : X.Modules) (s : Γ(M, ⊤)) {k n : ℕ} (hkn : k ≤ n)
    (g : Γ(F ⊗ tensorPow M k, ⊤)) : Γ(F ⊗ tensorPow M n, ⊤) :=
  let ψ : (F ⊗ tensorPow M k) ⊗ tensorPow M (n - k) ⟶ F ⊗ tensorPow M n :=
    (α_ F (tensorPow M k) (tensorPow M (n - k))).hom ≫
      F ◁ (tensorPowAddIso M k (n - k)).hom ≫
      F ◁ eqToHom (congrArg (tensorPow M) (Nat.sub_add_cancel hkn))
  ψ.app ⊤ (tmulRight (F ⊗ tensorPow M k) (tensorPowSection s (n - k)) g)

/-- If `g ∈ Γ(F ⊗ M^{⊗ k}, ⊤)` restricts to `t ⊗ sᵏ` on `U`, then `raiseSection` restricts to
`t ⊗ sⁿ` on `U`. -/
private lemma map_raiseSection (F M : X.Modules) (s : Γ(M, ⊤)) {U : X.Opens} {k n : ℕ}
    (hkn : k ≤ n) (g : Γ(F ⊗ tensorPow M k, ⊤)) (t : Γ(F, U))
    (hg : (F ⊗ tensorPow M k).presheaf.map U.leTop.op g =
      tmulRight F (tensorPowSection (M.presheaf.map U.leTop.op s) k) t) :
    (F ⊗ tensorPow M n).presheaf.map U.leTop.op (raiseSection F M s hkn g) =
      tmulRight F (tensorPowSection (M.presheaf.map U.leTop.op s) n) t := by
  let ψ : (F ⊗ tensorPow M k) ⊗ tensorPow M (n - k) ⟶ F ⊗ tensorPow M n :=
    (α_ F (tensorPow M k) (tensorPow M (n - k))).hom ≫
      F ◁ (tensorPowAddIso M k (n - k)).hom ≫
      F ◁ eqToHom (congrArg (tensorPow M) (Nat.sub_add_cancel hkn))
  have hnat : ψ.app U (((F ⊗ tensorPow M k) ⊗ tensorPow M (n - k)).presheaf.map U.leTop.op
      (tmulRight (F ⊗ tensorPow M k) (tensorPowSection s (n - k)) g)) =
      (F ⊗ tensorPow M n).presheaf.map U.leTop.op (raiseSection F M s hkn g) :=
    ψ.mapPresheaf.naturality_apply U.leTop.op _
  rw [← hnat, map_tmulRight_tensorPowSection, hg]
  simp only [ψ, Hom.comp_app, ConcreteCategory.comp_apply, associator_hom_app_tmulRight,
    whiskerLeft_app_tmulRight, tensorPowAddIso_hom_app_tmulRight_tensorPowSection]
  have heq : ∀ (a : ℕ) (h : a = n),
      (eqToHom (congrArg (tensorPow M) h)).app U
        (tensorPowSection (M.presheaf.map U.leTop.op s) a) =
      tensorPowSection (M.presheaf.map U.leTop.op s) n := by
    rintro _ rfl
    simp
  exact congrArg (fun x ↦ tmulRight F x t) (heq _ (Nat.sub_add_cancel hkn))

/-- If `sFam : I → Γ(F ⊗ M^{⊗ n}, ⊤)` contains sections restricting on `U = X_s` to `t ⊗ sⁿ` for
every `t` in a generating set `T` of `Γ(F, U)`, then the induced morphism
`free I ⟶ F ⊗ M^{⊗ n}` is surjective on sections over `U`. -/
private lemma surjective_freeHomEquiv_symm_app_of_span_eq_top
    (F M : X.Modules) [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X M]
    (s : Γ(M, ⊤)) (n : ℕ) {I : Type u} (sFam : I → (F ⊗ tensorPow M n).sections)
    (T : Set Γ(F, M.nonvanishingLocus s))
    (hT : Submodule.span Γ(X, M.nonvanishingLocus s) T = ⊤)
    (hmem : ∀ t ∈ T, ∃ p : I,
      (sFam p).eval (op (M.nonvanishingLocus s)) =
        tmulRight F
          (tensorPowSection (M.presheaf.map (M.nonvanishingLocus s).leTop.op s) n) t) :
    Function.Surjective
      (Hom.app ((F ⊗ tensorPow M n).freeHomEquiv.symm sFam :
          (SheafOfModules.free I : X.Modules) ⟶ F ⊗ tensorPow M n)
        (M.nonvanishingLocus s)) := by
  let U := M.nonvanishingLocus s
  let freeI : X.Modules := SheafOfModules.free I
  let φ : freeI ⟶ F ⊗ tensorPow M n := (F ⊗ tensorPow M n).freeHomEquiv.symm sFam
  intro y
  have hU : U ≤ M.nonvanishingLocus (M.presheaf.map U.leTop.op s) := by
    rw [nonvanishingLocus_map]
    exact le_inf le_rfl le_rfl
  obtain ⟨x, rfl⟩ :=
    (bijective_tmulRight_tensorPowSection_of_le_nonvanishingLocus F _ hU n).2 y
  have hx : x ∈ Submodule.span Γ(X, U) T := hT ▸ Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem t ht =>
    obtain ⟨p, hp⟩ := hmem t ht
    refine ⟨(SheafOfModules.freeSection (R := X.ringCatSheaf) p).eval (op U), ?_⟩
    have h1 : Hom.app φ U ((SheafOfModules.freeSection (R := X.ringCatSheaf) p).eval (op U)) =
        (sFam p).eval (op U) :=
      congrArg (fun σ : (F ⊗ tensorPow M n).sections ↦ σ.eval (op U))
        (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection sFam p)
    exact h1.trans hp
  | zero => exact ⟨0, by simp⟩
  | add a b _ _ ha hb =>
    obtain ⟨a', ha'⟩ := ha
    obtain ⟨b', hb'⟩ := hb
    exact ⟨a' + b', by rw [map_add, ha', hb', map_add]⟩
  | smul r a _ ha =>
    obtain ⟨a', ha'⟩ := ha
    let a'' : Γ(freeI, U) := a'
    exact ⟨r • a'', by rw [Hom.app_smul φ r a'', ha', LinearMap.map_smul]⟩

/-- **Twisting generation for a line bundle with an affine nonvanishing cover.** Let `X` be
quasi-compact and quasi-separated, `M` an invertible sheaf with finitely many global sections whose
nonvanishing loci are affine and cover `X`, and `F` a quasi-coherent `𝒪_X`-module of finite type.
Then for all sufficiently large `n : ℕ`, `F ⊗ M^{⊗ n}` is generated by finitely many global
sections. -/
theorem exists_generatingSections_tensorPow_of_affineOpenCover
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    [CompactSpace X] [QuasiSeparatedSpace X]
    (M : X.Modules) [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X M]
    {m : ℕ} (s : Fin m → Γ(M, ⊤))
    (haff : ∀ i, IsAffineOpen (M.nonvanishingLocus (s i)))
    (hcover : (⨆ i, M.nonvanishingLocus (s i)) = ⊤) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ σ : (F ⊗ tensorPow M n).GeneratingSections, σ.IsFiniteType := by
  classical
  let U : Fin m → X.Opens := fun i ↦ M.nonvanishingLocus (s i)
  -- On each affine chart `U i`, choose finitely many generators of `Γ(F, U i)`.
  have hfg (i : Fin m) : ∃ T : Finset Γ(F, U i),
      Submodule.span Γ(X, U i) (T : Set Γ(F, U i)) = ⊤ :=
    have := F.finite_sections_of_isAffineOpen (U i) (haff i)
    Module.Finite.fg_top
  choose T hT using hfg
  let I : Type u := Σ i : ULift.{u} (Fin m), {t : Γ(F, U i.down) // t ∈ T i.down}
  have : Fintype I := inferInstance
  -- Extend each local generator `t` after tensoring with a power of `s i`.
  have hext (p : I) : ∃ (k : ℕ) (g : Γ(F ⊗ tensorPow M k, ⊤)),
      (F ⊗ tensorPow M k).presheaf.map (U p.1.down).leTop.op g =
        tmulRight F (tensorPowSection (M.presheaf.map (U p.1.down).leTop.op (s p.1.down)) k)
          p.2.1 := by
    obtain ⟨k, g, hg⟩ := exists_map_eq_tmulRight_tensorPowSection F (U := ⊤)
      (by simpa using isCompact_univ) (by simpa using isQuasiSeparated_univ) (s p.1.down) p.2.1
    exact ⟨k, g, hg⟩
  choose k g hg using hext
  let n₀ : ℕ := Finset.univ.sup k
  refine ⟨n₀, fun n hn ↦ ?_⟩
  have hkn (p : I) : k p ≤ n := (Finset.le_sup (f := k) (Finset.mem_univ p)).trans hn
  let sec (p : I) : Γ(F ⊗ tensorPow M n, ⊤) := raiseSection F M (s p.1.down) (hkn p) (g p)
  have : (tensorPow M n).IsQuasicoherent :=
    InvertibleSheaf.isQuasicoherent_obj ⟨tensorPow M n, inferInstance⟩
  have hqc : (F ⊗ tensorPow M n).IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_tensorObj X F (tensorPow M n)
  let sFam : I → (F ⊗ tensorPow M n).sections := fun p ↦
    (F ⊗ tensorPow M n).sectionsEquivTop.symm (sec p)
  let φ : (SheafOfModules.free I : X.Modules) ⟶ F ⊗ tensorPow M n :=
    (F ⊗ tensorPow M n).freeHomEquiv.symm sFam
  have hφ : Epi φ := by
    refine @Hom.epi_of_surjective_on_affineOpenCover X _ (F ⊗ tensorPow M n) hqc φ _ U haff
      hcover fun i ↦
        surjective_freeHomEquiv_symm_app_of_span_eq_top F M (s i) n sFam (T i) (hT i)
          fun t ht ↦ ⟨⟨⟨i⟩, ⟨t, ht⟩⟩,
            (sectionsEquivTop_symm_val (F ⊗ tensorPow M n) (sec ⟨⟨i⟩, ⟨t, ht⟩⟩) (U i)).trans
              (map_raiseSection F M (s i) (hkn ⟨⟨i⟩, ⟨t, ht⟩⟩) (g _) t (hg _))⟩
  exact ⟨{ I := I, s := sFam, epi := (epi_iff_sheafOfModules φ).mp hφ }, ⟨inferInstance⟩⟩

/-- **Serre's twisting-generation theorem (for monoidal tensor powers).** Let `X` be a
quasi-separated scheme, `L` an ample invertible sheaf on `X`, and `F` a quasi-coherent
`𝒪_X`-module of finite type. Then there exists `n₀ : ℕ` such that for every `n ≥ n₀`,
`F ⊗ L^{⊗ n}` is generated by finitely many global sections. -/
theorem exists_generatingSections_tensorPow_of_isAmple
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] [QuasiSeparatedSpace X]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ σ : (F ⊗ tensorPow L.obj n).GeneratingSections, σ.IsFiniteType := by
  have := hL.compactSpace
  obtain ⟨d, hd, m, s, haff, hcover⟩ := hL.exists_pos_finite_affine_cover
  let M : X.Modules := tensorPow L.obj d
  have hM_inv : TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X M :=
    isInvertible_tensorPow L.obj d
  -- Apply the affine-cover theorem to each remainder twist `F ⊗ L^{⊗ r}` (`r < d`).
  have hrem (r : Fin d) : ∃ N : ℕ, ∀ q ≥ N,
      ∃ σ : ((F ⊗ tensorPow L.obj r.1) ⊗ tensorPow M q).GeneratingSections, σ.IsFiniteType := by
    have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) (tensorPow L.obj r.1) :=
      isInvertible_tensorPow L.obj r.1
    have : (tensorPow L.obj r.1).IsFinitePresentation :=
      TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (R := X.ringCatSheaf)
        (M := tensorPow L.obj r.1)
    exact @exists_generatingSections_tensorPow_of_affineOpenCover X
      (F ⊗ tensorPow L.obj r.1) _ _ _ _ M hM_inv m s haff hcover
  choose N hN using hrem
  let Q : ℕ := Finset.univ.sup N
  refine ⟨d * Q, fun n hn ↦ ?_⟩
  let r : Fin d := ⟨n % d, Nat.mod_lt n hd⟩
  let q : ℕ := n / d
  have hq : Q ≤ q := by
    rw [Nat.le_div_iff_mul_le hd]
    simpa only [mul_comm] using hn
  obtain ⟨σ, hσ⟩ := hN r q ((Finset.le_sup (f := N) (Finset.mem_univ r)).trans hq)
  -- Identify `(F ⊗ L^{⊗ r}) ⊗ (L^{⊗ d})^{⊗ q}` with `F ⊗ L^{⊗ n}` via Picard-group classes.
  let Ar : InvertibleSheaf X := ⟨tensorPow L.obj r.1, isInvertible_tensorPow L.obj r.1⟩
  let Mq : InvertibleSheaf X := ⟨tensorPow M q, @isInvertible_tensorPow X M hM_inv q⟩
  let A : InvertibleSheaf X :=
    ⟨tensorPow L.obj r.1 ⊗ tensorPow M q,
      @isInvertible_tensorObj X _ _ Ar.property Mq.property⟩
  let B : InvertibleSheaf X := ⟨tensorPow L.obj n, isInvertible_tensorPow L.obj n⟩
  have hAB : LineBundleClass.mk A = LineBundleClass.mk B := by
    have hA1 : LineBundleClass.mk A = LineBundleClass.mk Ar * LineBundleClass.mk Mq := by
      rw [← LineBundleClass.mk_tensorProduct, LineBundleClass.mk_eq_mk_iff]
      exact ⟨(InvertibleSheaf.tensorProductObjIso Ar Mq).symm⟩
    have hM : LineBundleClass.mk Mq = LineBundleClass.mk L ^ (d * q) := by
      rw [LineBundleClass.mk_tensorPow_obj ⟨M, hM_inv⟩ q,
        LineBundleClass.mk_tensorPow_obj L d, ← pow_mul]
    rw [hA1, LineBundleClass.mk_tensorPow_obj, hM, LineBundleClass.mk_tensorPow_obj, ← pow_add,
      add_comm, Nat.div_add_mod]
  obtain ⟨eL⟩ := LineBundleClass.mk_eq_mk_iff.mp hAB
  let e : (F ⊗ tensorPow L.obj r.1) ⊗ tensorPow M q ≅ F ⊗ tensorPow L.obj n :=
    α_ F (tensorPow L.obj r.1) (tensorPow M q) ≪≫ whiskerLeftIso F eL
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso (sheafIsoOfIso X e) σ, ⟨hσ.finite⟩⟩

/-- **Serre's twisting-generation theorem (for any representative of `L^{⊗ n}`).** Let `X` be a
quasi-separated scheme, `L` an ample invertible sheaf on `X`, and `F` a quasi-coherent
`𝒪_X`-module of finite type. Then there exists `n₀ : ℕ` such that for every `n ≥ n₀` and every
invertible sheaf `K` representing `L^{⊗ n}`, `F ⊗ K` is generated by finitely many global
sections. -/
theorem exists_generatingSections_tensor_of_isAmple
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] [QuasiSeparatedSpace X]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ K : InvertibleSheaf X,
      LineBundleClass.mk K = LineBundleClass.mk L ^ n →
      ∃ σ : (F ⊗ K.obj).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨n₀, hn₀⟩ := F.exists_generatingSections_tensorPow_of_isAmple L hL
  refine ⟨n₀, fun n hn K hK ↦ ?_⟩
  obtain ⟨σ, hσ⟩ := hn₀ n hn
  have hclass : LineBundleClass.mk ⟨tensorPow L.obj n, inferInstance⟩ = LineBundleClass.mk K := by
    rw [LineBundleClass.mk_tensorPow_obj, hK]
  obtain ⟨eK⟩ := LineBundleClass.mk_eq_mk_iff.mp hclass
  let e : F ⊗ tensorPow L.obj n ≅ F ⊗ K.obj := whiskerLeftIso F eK
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso (sheafIsoOfIso X e) σ, ⟨hσ.finite⟩⟩

/-- **Finite negative-twist presentation.** Let `X` be a quasi-separated scheme, `L` an ample
invertible sheaf on `X`, and `F` a quasi-coherent `𝒪_X`-module of finite type. Then there exists
`n₀ : ℕ` such that for every `n ≥ n₀` and every invertible sheaf `K` representing `L^{⊗ (-n)}`,
there are `k : ℕ` and an epimorphism `(⨁ fun _ : Fin k ↦ K) ⟶ F`. -/
theorem exists_epi_biproduct_of_isAmple
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] [QuasiSeparatedSpace X]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ K : InvertibleSheaf X,
      LineBundleClass.mk K = (LineBundleClass.mk L ^ n)⁻¹ →
      ∃ (k : ℕ) (p : (⨁ fun _ : Fin k ↦ K.obj) ⟶ F), Epi p := by
  obtain ⟨n₀, hn₀⟩ := F.exists_generatingSections_tensor_of_isAmple L hL
  refine ⟨n₀, fun n hn K hK ↦ ?_⟩
  have hKdual : LineBundleClass.mk K.dual = LineBundleClass.mk L ^ n := by
    rw [← LineBundleClass.inv_mk, hK, inv_inv]
  obtain ⟨σ, hσ⟩ := hn₀ n hn K.dual hKdual
  have : Finite σ.I := hσ.finite
  have : Fintype σ.I := Fintype.ofFinite σ.I
  let k : ℕ := Fintype.card σ.I
  let eI : Fin k ≃ σ.I := (Fintype.equivFin σ.I).symm
  have : MonoidalPreadditive X.Modules := TauCeti.SheafOfModules.monoidalPreadditive X.sheaf
  -- Tensor the epimorphism `free σ.I ⟶ F ⊗ K^∨` on the left by `K`.
  let π : (SheafOfModules.free (R := X.ringCatSheaf) σ.I : X.Modules) ⟶ F ⊗ K.dual.obj := σ.π
  have hπ : Epi (C := X.Modules) π := (epi_iff_sheafOfModules π).mpr σ.epi
  have : (tensorLeft K.obj).IsLeftAdjoint := ⟨ihom K.obj, ⟨ihom.adjunction K.obj⟩⟩
  have : Epi (K.obj ◁ π) := TauCeti.epi_whiskerLeft K.obj π
  -- Identify `K ⊗ (F ⊗ K^∨) ≅ F`.
  have hKK : LineBundleClass.mk ⟨K.obj ⊗ K.dual.obj, inferInstance⟩ = 1 := by
    have : LineBundleClass.mk ⟨K.obj ⊗ K.dual.obj, inferInstance⟩ =
        LineBundleClass.mk K * LineBundleClass.mk K.dual := by
      rw [← LineBundleClass.mk_tensorProduct, LineBundleClass.mk_eq_mk_iff]
      exact ⟨(InvertibleSheaf.tensorProductObjIso K K.dual).symm⟩
    rw [this, ← LineBundleClass.inv_mk, mul_inv_cancel]
  obtain ⟨eUnit⟩ := LineBundleClass.mk_eq_one_iff.mp hKK
  let eF : K.obj ⊗ (F ⊗ K.dual.obj) ≅ F :=
    whiskerLeftIso K.obj (β_ F K.dual.obj) ≪≫
      (α_ K.obj K.dual.obj F).symm ≪≫
      whiskerRightIso eUnit F ≪≫
      λ_ F
  -- Identify `⨁_{Fin k} K ≅ K ⊗ free σ.I`.
  let eFree : (⨁ fun _ : Fin k ↦ K.obj) ≅
      K.obj ⊗ (SheafOfModules.free (R := X.ringCatSheaf) σ.I : X.Modules) :=
    biproduct.mapIso (fun _ : Fin k ↦ (ρ_ K.obj).symm) ≪≫
      (leftDistributor K.obj (fun _ : Fin k ↦ 𝟙_ X.Modules)).symm ≪≫
      whiskerLeftIso K.obj
        (biproduct.whiskerEquiv (f := fun _ : Fin k ↦ 𝟙_ X.Modules)
            (g := fun _ : σ.I ↦ 𝟙_ X.Modules) eI (fun _ ↦ Iso.refl _) ≪≫
          Scheme.Modules.isoOfSheafIso X
            (TauCeti.SheafOfModules.biproductIsoFree (R := X.sheaf) σ.I))
  exact ⟨k, (eFree.hom ≫ (K.obj ◁ π)) ≫ eF.hom, inferInstance⟩

end AlgebraicGeometry.Scheme.Modules
