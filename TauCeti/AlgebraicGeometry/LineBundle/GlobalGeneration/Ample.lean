namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- On an affine open `V`, a morphism from a finite free sheaf to a quasi-coherent module `G` whose
generating sections restrict to a spanning family of `Γ(G, V)` has invertible image inclusion over
`V`. -/
private theorem isIso_restrict_image_ι_of_span_eq_top {G : X.Modules} [G.IsQuasicoherent]
    {I : Type u} [Finite I] (s : I → Γ(G, ⊤)) {V : X.Opens} (hV : IsAffineOpen V)
    (hspan : Submodule.span Γ(X, V)
      (Set.range fun k ↦ G.presheaf.map V.leTop.op (s k)) = ⊤) :
    let F : X.Modules := SheafOfModules.free I
    let φ : F ⟶ G := G.freeHomEquiv.symm fun k ↦ G.sectionsEquivTop.symm (s k)
    IsIso ((restrictFunctor V.ι).map (image.ι φ)) := by
  intro F φ
  have : F.IsFinitePresentation :=
    inferInstanceAs (SheafOfModules.free (R := X.ringCatSheaf) I).IsFinitePresentation
  have : IsAffine V.toScheme := hV
  have : Mono ((restrictFunctor V.ι).map (image.ι φ)) :=
    (restrictFunctor V.ι).map_mono (image.ι φ)
  refine isIso_of_mono_of_surjective_sectionsFunctor_map_top _ ?_
  have hspan' : Submodule.span Γ(X, V.ι ''ᵁ ⊤)
      (Set.range fun k ↦ G.presheaf.map (V.ι ''ᵁ ⊤).leTop.op (s k)) = ⊤ := by
    rwa [V.ι_image_top]
  -- Over `V.toScheme`, global sections of the restricted sheaf are sections over `V.ι ''ᵁ ⊤ = V`,
  -- and the induced global-sections map is `(image.ι φ).app (V.ι ''ᵁ ⊤)`.
  change ∀ x : Γ(G, V.ι ''ᵁ ⊤), ∃ y, (image.ι φ).app (V.ι ''ᵁ ⊤) y = x
  intro x
  have hx : x ∈ Submodule.span Γ(X, V.ι ''ᵁ ⊤)
      (Set.range fun k ↦ G.presheaf.map (V.ι ''ᵁ ⊤).leTop.op (s k)) :=
    hspan' ▸ Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨k, rfl⟩ := hy
    let t : Γ(F, V.ι ''ᵁ ⊤) := (SheafOfModules.freeSection k).val (op (V.ι ''ᵁ ⊤))
    refine ⟨(factorThruImage φ).app (V.ι ''ᵁ ⊤) t, ?_⟩
    have hcomp : (image.ι φ).app (V.ι ''ᵁ ⊤) ((factorThruImage φ).app (V.ι ''ᵁ ⊤) t) =
        φ.app (V.ι ''ᵁ ⊤) t :=
      (ConcreteCategory.comp_apply ((factorThruImage φ).app _) ((image.ι φ).app _) t).symm.trans
        (congrArg (fun ψ ↦ ψ.app (V.ι ''ᵁ ⊤) t) (image.fac φ))
    have hsec : SheafOfModules.sectionsMap φ (SheafOfModules.freeSection k) =
        G.sectionsEquivTop.symm (s k) := by
      rw [← SheafOfModules.freeHomEquiv_apply (M := G) φ k]
      exact congrFun (G.freeHomEquiv.apply_symm_apply _) k
    rw [hcomp]
    exact (congrArg (fun σ : G.sections ↦ σ.val (op (V.ι ''ᵁ ⊤))) hsec).trans
      (sectionsEquivTop_symm_val G (s k) (V.ι ''ᵁ ⊤))
  | zero => exact ⟨0, map_zero _⟩
  | add _ _ _ _ ha hb =>
    obtain ⟨u, rfl⟩ := ha
    obtain ⟨v, rfl⟩ := hb
    exact ⟨u + v, map_add _ _ _⟩
  | smul r _ _ ha =>
    obtain ⟨u, rfl⟩ := ha
    exact ⟨r • u, Hom.app_smul _ _ _⟩

/-- **Affine-cover global generation criterion.** Let `G` be a quasi-coherent `𝒪_X`-module and
`s : I → Γ(G, ⊤)` a finite family of global sections. If the restrictions of `s` span `Γ(G, U i)`
over `Γ(X, U i)` on every member of an affine open cover `U` of `X`, then the induced morphism
`free I ⟶ G` is an epimorphism. -/
theorem epi_freeHomEquiv_symm_of_span_eq_top {G : X.Modules} [G.IsQuasicoherent]
    {ι : Type*} (U : ι → X.Opens) (hUa : ∀ i, IsAffineOpen (U i)) (hU : ⨆ i, U i = ⊤)
    {I : Type u} [Finite I] (s : I → Γ(G, ⊤))
    (hspan : ∀ i, Submodule.span Γ(X, U i)
      (Set.range fun k ↦ G.presheaf.map (U i).leTop.op (s k)) = ⊤) :
    Epi (C := X.Modules) (G.freeHomEquiv.symm fun k ↦ G.sectionsEquivTop.symm (s k)) := by
  let F : X.Modules := SheafOfModules.free I
  let φ : F ⟶ G := G.freeHomEquiv.symm fun k ↦ G.sectionsEquivTop.symm (s k)
  have hiso : IsIso (image.ι φ) := by
    refine (isIso_iff_of_isOpenCover (TopologicalSpace.IsOpenCover.mk hU) (image.ι φ)).mpr
      fun i ↦ ?_
    have : IsIso ((restrictFunctor (U i).ι).map (image.ι φ)) :=
      isIso_restrict_image_ι_of_span_eq_top s (hUa i) (hspan i)
    exact (NatIso.isIso_map_iff (restrictFunctorIsoPullback (U i).ι) _).mp this
  have : Epi (factorThruImage φ ≫ image.ι φ) := epi_comp _ _
  rwa [image.fac] at this

/-- On a single nonvanishing chart `U = L.nonvanishingLocus s`, if a family of global sections of
`F ⊗ Lⁿ` restricts to the images `t ⊗ sⁿ` of a spanning set `T` of `Γ(F, U)`, then it spans
`Γ(F ⊗ Lⁿ, U)`. -/
private theorem span_range_tensorPow_eq_top {L F : X.Modules}
    [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X L]
    (s : Γ(L, ⊤)) (n : ℕ) (T : Finset Γ(F, L.nonvanishingLocus s))
    (hT : Submodule.span Γ(X, L.nonvanishingLocus s)
      (T : Set Γ(F, L.nonvanishingLocus s)) = ⊤)
    {I : Type*} (gen : I → Γ(F ⊗ tensorPow L n, ⊤))
    (hlift : ∀ t ∈ T, ∃ j : I,
      (F ⊗ tensorPow L n).presheaf.map (L.nonvanishingLocus s).leTop.op (gen j) =
        tmulRight F (tensorPowSection
          (L.presheaf.map (L.nonvanishingLocus s).leTop.op s) n) t) :
    Submodule.span Γ(X, L.nonvanishingLocus s)
      (Set.range fun j ↦ (F ⊗ tensorPow L n).presheaf.map
        (L.nonvanishingLocus s).leTop.op (gen j)) = ⊤ := by
  let U : X.Opens := L.nonvanishingLocus s
  let e : Γ(L, U) := L.presheaf.map U.leTop.op s
  have hU : U ≤ L.nonvanishingLocus e := by
    rw [nonvanishingLocus_map]
    exact le_inf le_rfl le_rfl
  let φ : Γ(F, U) →ₗ[Γ(X, U)] Γ(F ⊗ tensorPow L n, U) := tmulRight F (tensorPowSection e n)
  have hsurj : Function.Surjective φ :=
    (bijective_tmulRight_tensorPowSection_of_le_nonvanishingLocus F e hU n).2
  refine top_unique fun y _ ↦ ?_
  obtain ⟨x, rfl⟩ := hsurj y
  have hmap : φ x ∈ Submodule.map φ (Submodule.span Γ(X, U) (T : Set Γ(F, U))) :=
    ⟨x, hT ▸ Submodule.mem_top, rfl⟩
  rw [Submodule.map_span] at hmap
  refine Submodule.span_mono (fun z hz ↦ ?_) hmap
  obtain ⟨t, ht, rfl⟩ := hz
  obtain ⟨j, hj⟩ := hlift t ht
  exact ⟨j, hj⟩

/-- **Serre's global generation theorem for a covering invertible sheaf.** If `X` is quasi-compact
and quasi-separated, `L` is an invertible sheaf admitting finitely many global sections whose
nonvanishing loci are affine and cover `X`, and `F` is quasi-coherent of finite type, then
`F ⊗ Lⁿ` is generated by finitely many global sections for all sufficiently large `n`. -/
theorem exists_generatingSections_tensor_tensorPow_of_iSup_nonvanishingLocus
    [CompactSpace X] [QuasiSeparatedSpace X]
    (L : X.Modules) [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X L]
    {ι : Type*} [Finite ι] (s : ι → Γ(L, ⊤))
    (hsa : ∀ i, IsAffineOpen (L.nonvanishingLocus (s i)))
    (hsc : (⨆ i, L.nonvanishingLocus (s i)) = ⊤)
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∃ σ : (F ⊗ tensorPow L n).GeneratingSections, σ.IsFiniteType := by
  classical
  cases nonempty_fintype ι
  let U (i : ι) : X.Opens := L.nonvanishingLocus (s i)
  -- Pick finitely many generators of `Γ(F, U i)` over each affine chart `U i`.
  have hfg (i : ι) : ∃ T : Finset Γ(F, U i),
      Submodule.span Γ(X, U i) (T : Set Γ(F, U i)) = ⊤ :=
    have := finite_sections_of_isAffineOpen F (U i) (hsa i)
    Module.Finite.fg_top
  choose T hT using hfg
  -- Extend each generator after tensoring with a power of `s i`.
  have hext (p : Σ i : ι, T i) :
      ∃ (d : ℕ) (g : Γ(F ⊗ tensorPow L d, ⊤)),
        (F ⊗ tensorPow L d).presheaf.map (U p.1).leTop.op g =
          tmulRight F (tensorPowSection (L.presheaf.map (U p.1).leTop.op (s p.1)) d) p.2.1 :=
    exists_map_eq_tmulRight_tensorPowSection F
      (by simpa only [Opens.coe_top] using isCompact_univ)
      (by simpa only [Opens.coe_top] using isQuasiSeparated_univ)
      (s p.1) p.2.1
  choose d g hg using hext
  refine ⟨Finset.univ.sup d, fun n hn ↦ ?_⟩
  let P := Σ i : ι, T i
  let k (p : P) : ℕ := n - d p
  have hk (p : P) : k p + d p = n :=
    Nat.sub_add_cancel ((Finset.le_sup (f := d) (Finset.mem_univ p)).trans hn)
  -- Lift every extended generator `g p` to `F ⊗ Lⁿ` by tensoring with `s p.1 ^ (n - d p)`.
  let ψ (p : P) : (F ⊗ tensorPow L (d p)) ⊗ tensorPow L (k p) ⟶ F ⊗ tensorPow L n :=
    ((α_ F (tensorPow L (d p)) (tensorPow L (k p))).hom ≫
      F ◁ (tensorPowAddIso L (d p) (k p)).hom) ≫
      F ◁ eqToHom (congrArg (tensorPow L) (hk p))
  let g' (p : P) : Γ(F ⊗ tensorPow L n, ⊤) :=
    (ψ p).app ⊤ (tmulRight (F ⊗ tensorPow L (d p)) (tensorPowSection (s p.1) (k p)) (g p))
  have hg' (p : P) :
      (F ⊗ tensorPow L n).presheaf.map (U p.1).leTop.op (g' p) =
        tmulRight F (tensorPowSection (L.presheaf.map (U p.1).leTop.op (s p.1)) n) p.2.1 := by
    have hnat : (F ⊗ tensorPow L n).presheaf.map (U p.1).leTop.op (g' p) =
        (ψ p).app (U p.1) (((F ⊗ tensorPow L (d p)) ⊗ tensorPow L (k p)).presheaf.map
          (U p.1).leTop.op
          (tmulRight (F ⊗ tensorPow L (d p)) (tensorPowSection (s p.1) (k p)) (g p))) :=
      ((ψ p).mapPresheaf.naturality_apply (U p.1).leTop.op _).symm
    rw [hnat, map_tmulRight_tensorPowSection, hg p]
    dsimp only [ψ]
    rw [Hom.comp_app, ConcreteCategory.comp_apply,
      associator_whiskerLeft_tensorPowAddIso_app_tmulRight,
      whiskerLeft_app_tmulRight, eqToHom_app_tensorPowSection _ (hk p)]
  have : (tensorPow L n).IsQuasicoherent :=
    TauCeti.AlgebraicGeometry.InvertibleSheaf.isQuasicoherent_obj ⟨tensorPow L n, inferInstance⟩
  let eP : ULift.{u} (Fin (Fintype.card P)) ≃ P := Equiv.ulift.trans (Fintype.equivFin P).symm
  let gen : ULift.{u} (Fin (Fintype.card P)) → Γ(F ⊗ tensorPow L n, ⊤) := fun j ↦ g' (eP j)
  have hepi : Epi (C := X.Modules) ((F ⊗ tensorPow L n).freeHomEquiv.symm
      fun j ↦ (F ⊗ tensorPow L n).sectionsEquivTop.symm (gen j)) :=
    epi_freeHomEquiv_symm_of_span_eq_top U hsa hsc gen fun i ↦
      span_range_tensorPow_eq_top (s i) n (T i) (hT i) gen fun t ht ↦
        ⟨eP.symm ⟨i, ⟨t, ht⟩⟩, by simpa only [gen, Equiv.apply_symm_apply] using hg' ⟨i, ⟨t, ht⟩⟩⟩
  exact ⟨{ I := ULift.{u} (Fin (Fintype.card P))
           s := fun j ↦ (F ⊗ tensorPow L n).sectionsEquivTop.symm (gen j)
           epi := hepi }, ⟨inferInstance⟩⟩

/-- From finite generating sections of `F ⊗ M` and a right inverse `K` (`M ⊗ K ≅ 𝒪_X`),
tensoring on the left with `K` produces an epimorphism from a finite direct sum of copies of `K`
onto `F`. -/
theorem exists_epi_biproduct_of_generatingSections_tensor (F M K : X.Modules)
    (σ : (F ⊗ M).GeneratingSections) [σ.IsFiniteType]
    (e : M ⊗ K ≅ 𝟙_ X.Modules) :
    ∃ (k : ℕ) (_ : HasBiproduct (fun _ : Fin k ↦ K)) (π : (⨁ fun _ : Fin k ↦ K) ⟶ F),
      Epi π := by
  classical
  have : HasFiniteBiproducts X.Modules := Abelian.hasFiniteBiproducts
  have : Finite σ.I := SheafOfModules.GeneratingSections.IsFiniteType.finite (σ := σ)
  cases nonempty_fintype σ.I
  let I : Type u := σ.I
  let k := Fintype.card I
  let eqv : I ≃ Fin k := Fintype.equivFin I
  let freeI : X.Modules := SheafOfModules.free I
  let cFree : IsColimit (C := X.Modules)
      ((SheafOfModules.freeCofan (R := X.ringCatSheaf) I).whisker
        (Discrete.equivalence eqv.symm).functor) :=
    IsColimit.whiskerEquivalence (SheafOfModules.isColimitFreeCofan I)
      (Discrete.equivalence eqv.symm)
  let freeIso : (⨁ fun _ : Fin k ↦ 𝟙_ X.Modules) ≅ freeI :=
    IsColimit.coconePointsIsoOfNatIso (biproduct.isColimit fun _ : Fin k ↦ 𝟙_ X.Modules) cFree
      (Discrete.natIso fun _ ↦ Iso.refl _)
  -- `tensorLeft K` is a left adjoint (`MonoidalClosed`), so it preserves finite coproducts
  -- and epimorphisms.
  let c : IsColimit ((tensorLeft K).mapCocone
      (biproduct.bicone (fun _ : Fin k ↦ 𝟙_ X.Modules)).toCocone) :=
    isColimitOfPreserves (tensorLeft K) (biproduct.isColimit _)
  let distIso : (⨁ fun _ : Fin k ↦ K) ≅ K ⊗ (⨁ fun _ : Fin k ↦ 𝟙_ X.Modules) :=
    IsColimit.coconePointsIsoOfNatIso (biproduct.isColimit fun _ : Fin k ↦ K) c
      (Discrete.natIso fun _ ↦ (ρ_ K).symm)
  let cancelIso : K ⊗ (F ⊗ M) ≅ F :=
    (α_ K F M).symm ≪≫ whiskerRightIso (β_ K F) M ≪≫ α_ F K M ≪≫
      whiskerLeftIso F (β_ K M ≪≫ e) ≪≫ ρ_ F
  let π₀ : freeI ⟶ F ⊗ M := σ.π
  have : Epi π₀ := σ.epi
  have : (tensorLeft K).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_isLeftAdjoint (tensorLeft K)
  refine ⟨k, inferInstance, distIso.hom ≫ (K ◁ freeIso.hom) ≫ (K ◁ π₀) ≫ cancelIso.hom, ?_⟩
  infer_instance

end AlgebraicGeometry.Scheme.Modules

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry.Scheme.Modules

namespace LineBundleClass

variable {X : Scheme.{u}}

/-- The line-bundle class of the monoidal tensor power `TauCeti.tensorPow L.obj n` is `mk L ^ n`. -/
@[simp]
theorem mk_tensorPow_obj (L : InvertibleSheaf X) (n : ℕ) :
    LineBundleClass.mk ⟨tensorPow L.obj n, inferInstance⟩ = LineBundleClass.mk L ^ n := by
  induction n with
  | zero =>
    rw [pow_zero]
    exact mk_eq_one_iff.mpr ⟨Iso.refl _⟩
  | succ n ih =>
    rw [pow_succ', ← ih, ← mk_tensorProduct]
    exact mk_eq_mk_iff.mpr ⟨(InvertibleSheaf.tensorProductObjIso L
      ⟨tensorPow L.obj n, inferInstance⟩).symm⟩

/-- For an ample line bundle `L`, some positive tensor power `Lᵐ` admits finitely many global
sections whose nonvanishing loci are affine and cover `X` (Stacks, Tag 01PR). -/
theorem IsAmple.exists_pow_iSup_nonvanishingLocus_eq_top {L : InvertibleSheaf X}
    (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ (m : ℕ) (_ : 0 < m) (k : ℕ) (t : Fin k → Γ(tensorPow L.obj m, ⊤)),
      (∀ i, IsAffineOpen ((tensorPow L.obj m).nonvanishingLocus (t i))) ∧
      (⨆ i, (tensorPow L.obj m).nonvanishingLocus (t i)) = ⊤ := by
  classical
  have : CompactSpace X := hL.compactSpace
  -- Cover `X` by affine nonvanishing loci of global sections of positive powers `L^{d x}`.
  have hcov (x : X) : ∃ (d : ℕ) (_ : 0 < d) (s : Γ(tensorPow L.obj d, ⊤)),
      x ∈ (tensorPow L.obj d).nonvanishingLocus s ∧
        IsAffineOpen ((tensorPow L.obj d).nonvanishingLocus s) := by
    obtain ⟨d, hd, hLd⟩ := hL.exists_pos_forall_mk_eq x
    obtain ⟨s, hx, haff⟩ := hLd ⟨tensorPow L.obj d, inferInstance⟩ (mk_tensorPow_obj L d)
    exact ⟨d, hd, s, hx, haff⟩
  choose d hd s hx haff using hcov
  obtain ⟨S, hS⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X ↦ ((tensorPow L.obj (d x)).nonvanishingLocus (s x) : Set X))
    (fun x ↦ ((tensorPow L.obj (d x)).nonvanishingLocus (s x)).isOpen)
    (fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hx x⟩)
  -- Raise every section to the common positive power `m = ∏_{x ∈ S} d x`.
  let m : ℕ := ∏ x ∈ S, d x
  have hm : 0 < m := Finset.prod_pos fun x _ ↦ hd x
  let K : InvertibleSheaf X := ⟨tensorPow L.obj m, isInvertible_tensorPow L.obj m⟩
  have hpow_iso (x : S) :
      Nonempty (tensorPow (tensorPow L.obj (d x.1)) (m / d x.1) ≅ tensorPow L.obj m) := by
    refine (mk_eq_mk_iff (L := ⟨tensorPow (tensorPow L.obj (d x.1)) (m / d x.1), inferInstance⟩)
      (K := K)).mp ?_
    rw [mk_tensorPow_obj ⟨tensorPow L.obj (d x.1), inferInstance⟩, mk_tensorPow_obj,
      mk_tensorPow_obj L m, ← pow_mul, Nat.mul_div_cancel' (Finset.dvd_prod_of_mem d x.2)]
  let eS := S.equivFin
  let t (i : Fin S.card) : Γ(tensorPow L.obj m, ⊤) :=
    let x := eS.symm i
    (Classical.choice (hpow_iso x)).hom.app ⊤ (tensorPowSection (s x.1) (m / d x.1))
  have ht_locus (i : Fin S.card) :
      (tensorPow L.obj m).nonvanishingLocus (t i) =
        (tensorPow L.obj (d (eS.symm i).1)).nonvanishingLocus (s (eS.symm i).1) := by
    have hq : 0 < m / d (eS.symm i).1 :=
      Nat.div_pos (Nat.le_of_dvd hm (Finset.dvd_prod_of_mem d (eS.symm i).2)) (hd (eS.symm i).1)
    dsimp only [t]
    rw [nonvanishingLocus_hom_app (Classical.choice (hpow_iso (eS.symm i))),
      nonvanishingLocus_tensorPowSection (s (eS.symm i).1) hq]
  refine ⟨m, hm, S.card, t, fun i ↦ by rw [ht_locus i]; exact haff (eS.symm i).1, ?_⟩
  refine top_unique fun y _ ↦ ?_
  obtain ⟨x, hxS, hyx⟩ := Set.mem_iUnion₂.mp (hS (Set.mem_univ y))
  exact Opens.mem_iSup.mpr ⟨eS ⟨x, hxS⟩, by
    rw [ht_locus (eS ⟨x, hxS⟩), Equiv.symm_apply_apply]
    exact hyx⟩

/-- **Serre's global generation theorem** (Hartshorne, Theorem II.5.17; Stacks, Tag 01Q3).
Let `a` be an ample line-bundle class on a quasi-separated scheme `X`, and `F` a quasi-coherent
`𝒪_X`-module of finite type. Then there exists `n₀ : ℕ` such that for every `n ≥ n₀` and every
invertible sheaf `M` representing `aⁿ`, the twist `F ⊗ M` is generated by finitely many global
sections. -/
theorem IsAmple.exists_generatingSections_tensor [QuasiSeparatedSpace X]
    {a : LineBundleClass X} (ha : a.IsAmple) (F : X.Modules) [F.IsQuasicoherent]
    [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ (M : InvertibleSheaf X), LineBundleClass.mk M = a ^ n →
      ∃ σ : (F ⊗ M.obj).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨L, rfl⟩ := mk_surjective a
  have : CompactSpace X := ha.compactSpace
  obtain ⟨m, hm, k, t, hta, htc⟩ := ha.exists_pow_iSup_nonvanishingLocus_eq_top
  let K : InvertibleSheaf X := ⟨tensorPow L.obj m, isInvertible_tensorPow L.obj m⟩
  -- Apply the covering-section theorem to each residue twist `F ⊗ Lʳ` (`0 ≤ r < m`).
  have hrem (r : Fin m) : ∃ q₀ : ℕ, ∀ q ≥ q₀,
      ∃ σ : ((F ⊗ tensorPow L.obj r.1) ⊗ tensorPow (tensorPow L.obj m) q).GeneratingSections,
        σ.IsFiniteType := by
    have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) (tensorPow L.obj r.1) :=
      isInvertible_tensorPow L.obj r.1
    have : (tensorPow L.obj r.1).IsQuasicoherent :=
      InvertibleSheaf.isQuasicoherent_obj ⟨tensorPow L.obj r.1, inferInstance⟩
    have : (tensorPow L.obj r.1).IsFinitePresentation :=
      TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (M := tensorPow L.obj r.1)
    have : (tensorPow L.obj r.1).IsFiniteType :=
      _root_.SheafOfModules.instIsFiniteTypeOfIsFinitePresentation (tensorPow L.obj r.1)
    have : (F ⊗ tensorPow L.obj r.1).IsFiniteType :=
      isFiniteType_of_finite_sections _ fun U hU ↦
        have := finite_sections_of_isAffineOpen F U hU
        have := finite_sections_of_isAffineOpen (tensorPow L.obj r.1) U hU
        let e : (Γ(F, U) ⊗[Γ(X, U)] Γ(tensorPow L.obj r.1, U)) ≃ₗ[Γ(X, U)]
            Γ(F ⊗ tensorPow L.obj r.1, U) :=
          LinearEquiv.ofBijective
            (Functor.LaxMonoidal.μ (sectionsFunctor U) F (tensorPow L.obj r.1)).hom
            (bijective_μ_sectionsFunctor F (tensorPow L.obj r.1) hU)
        Module.Finite.equiv e
    exact exists_generatingSections_tensor_tensorPow_of_iSup_nonvanishingLocus
      (tensorPow L.obj m) t hta htc (F ⊗ tensorPow L.obj r.1)
  choose q₀ hq₀ using hrem
  refine ⟨m * Finset.univ.sup q₀, fun n hn M hM ↦ ?_⟩
  let q := n / m
  let r : Fin m := ⟨n % m, Nat.mod_lt n hm⟩
  have hq : q₀ r ≤ q :=
    (Finset.le_sup (f := q₀) (Finset.mem_univ r)).trans
      ((Nat.le_div_iff_mul_le hm).mpr (by rwa [mul_comm]))
  obtain ⟨σ, hσ⟩ := hq₀ r q hq
  -- Identify `Lʳ ⊗ (Lᵐ)^{⊗q}` with `M` via their Picard classes.
  have hiso : Nonempty (tensorPow L.obj r.1 ⊗ tensorPow (tensorPow L.obj m) q ≅ M.obj) := by
    refine (mk_eq_mk_iff
      (L := ⟨tensorPow L.obj r.1 ⊗ tensorPow (tensorPow L.obj m) q, inferInstance⟩)
      (K := M)).mp ?_
    rw [hM]
    have hprod : LineBundleClass.mk
        ⟨tensorPow L.obj r.1 ⊗ tensorPow (tensorPow L.obj m) q, inferInstance⟩ =
        LineBundleClass.mk ⟨tensorPow L.obj r.1, inferInstance⟩ *
          LineBundleClass.mk ⟨tensorPow (tensorPow L.obj m) q, inferInstance⟩ := by
      rw [← mk_tensorProduct, mk_eq_mk_iff]
      exact ⟨(InvertibleSheaf.tensorProductObjIso
        ⟨tensorPow L.obj r.1, inferInstance⟩
        ⟨tensorPow (tensorPow L.obj m) q, inferInstance⟩).symm⟩
    rw [hprod, mk_tensorPow_obj L r.1, mk_tensorPow_obj K q, mk_tensorPow_obj L m,
      ← pow_mul, ← pow_add, add_comm, Nat.div_add_mod n m]
  obtain ⟨iso⟩ := hiso
  let eFM : (F ⊗ tensorPow L.obj r.1) ⊗ tensorPow (tensorPow L.obj m) q ≅ F ⊗ M.obj :=
    α_ F (tensorPow L.obj r.1) (tensorPow (tensorPow L.obj m) q) ≪≫ whiskerLeftIso F iso
  exact ⟨_root_.SheafOfModules.GeneratingSections.equivOfIso eFM σ,
    _root_.SheafOfModules.GeneratingSections.isFiniteType_equivOfIso eFM σ⟩

/-- For an ample line-bundle class `a` on a quasi-separated scheme `X` and any invertible sheaf `K`,
every twist `K ⊗ M` with `mk M = aⁿ` is globally generated for all sufficiently large `n`. -/
theorem IsAmple.exists_isGloballyGenerated_tensorProduct [QuasiSeparatedSpace X]
    {a : LineBundleClass X} (ha : a.IsAmple) (K : InvertibleSheaf X) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ (M : InvertibleSheaf X), LineBundleClass.mk M = a ^ n →
      (K.tensorProduct M).IsGloballyGenerated := by
  have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) K.obj := K.property
  have : K.obj.IsFinitePresentation :=
    TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (M := K.obj)
  have : K.obj.IsFiniteType :=
    _root_.SheafOfModules.instIsFiniteTypeOfIsFinitePresentation K.obj
  obtain ⟨n₀, hn₀⟩ := ha.exists_generatingSections_tensor K.obj
  refine ⟨n₀, fun n hn M hM ↦ ?_⟩
  obtain ⟨σ, _⟩ := hn₀ n hn M hM
  exact InvertibleSheaf.isGloballyGenerated_iff_nonempty_generatingSections.mpr
    ⟨_root_.SheafOfModules.GeneratingSections.equivOfIso
      (InvertibleSheaf.tensorProductObjIso K M).symm σ⟩

/-- **Finite direct-sum resolution by negative twists.** Let `a` be an ample line-bundle class on a
quasi-separated scheme `X`, and `F` a quasi-coherent `𝒪_X`-module of finite type. Then there exists
`n₀ : ℕ` such that for every `n ≥ n₀` and every invertible sheaf `K` representing `(aⁿ)⁻¹`, `F` is
a quotient of a finite direct sum `⨁_{Fin k} K`. -/
theorem IsAmple.exists_epi_biproduct [QuasiSeparatedSpace X]
    {a : LineBundleClass X} (ha : a.IsAmple) (F : X.Modules) [F.IsQuasicoherent]
    [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ (K : InvertibleSheaf X), LineBundleClass.mk K = (a ^ n)⁻¹ →
      ∃ (k : ℕ) (_ : HasBiproduct fun _ : Fin k ↦ K.obj)
        (π : (⨁ fun _ : Fin k ↦ K.obj) ⟶ F), Epi π := by
  obtain ⟨L, rfl⟩ := mk_surjective a
  obtain ⟨n₀, hn₀⟩ := ha.exists_generatingSections_tensor F
  refine ⟨n₀, fun n hn K hK ↦ ?_⟩
  let M : InvertibleSheaf X := L.tensorPow n
  obtain ⟨σ, hσ⟩ := hn₀ n hn M (mk_tensorPow L n)
  have hMK : Nonempty (M.obj ⊗ K.obj ≅ 𝟙_ X.Modules) := by
    have h1 : LineBundleClass.mk (M.tensorProduct K) = 1 := by
      rw [mk_tensorProduct, mk_tensorPow, hK, mul_inv_cancel]
    obtain ⟨e⟩ := mk_eq_one_iff.mp h1
    exact ⟨(InvertibleSheaf.tensorProductObjIso M K).symm ≪≫ e⟩
  obtain ⟨e⟩ := hMK
  exact exists_epi_biproduct_of_generatingSections_tensor F M.obj K.obj σ e

end LineBundleClass

namespace InvertibleSheaf

variable {X : Scheme.{u}}

/-- **Serre's global generation theorem for an ample line bundle.** For an ample line bundle `L` on
a quasi-separated scheme `X` and a quasi-coherent `𝒪_X`-module `F` of finite type, the twist
`F ⊗ L^{⊗n}` is generated by finitely many global sections for all sufficiently large `n`. -/
theorem exists_generatingSections_tensor_tensorPow_of_isAmple [QuasiSeparatedSpace X]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple)
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∃ σ : (F ⊗ (L.tensorPow n).obj).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨n₀, hn₀⟩ := hL.exists_generatingSections_tensor F
  exact ⟨n₀, fun n hn ↦ hn₀ n hn (L.tensorPow n) (LineBundleClass.mk_tensorPow L n)⟩

/-- Twisting any line bundle `K` by sufficiently high powers of an ample line bundle `L` yields a
globally generated line bundle. -/
theorem exists_isGloballyGenerated_tensorProduct_tensorPow_of_isAmple [QuasiSeparatedSpace X]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) (K : InvertibleSheaf X) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, (K.tensorProduct (L.tensorPow n)).IsGloballyGenerated := by
  obtain ⟨n₀, hn₀⟩ := hL.exists_isGloballyGenerated_tensorProduct K
  exact ⟨n₀, fun n hn ↦ hn₀ n hn (L.tensorPow n) (LineBundleClass.mk_tensorPow L n)⟩

end InvertibleSheaf

