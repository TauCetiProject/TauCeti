noncomputable section

variable {X : Scheme.{u}}

/-! ### Nonvanishing loci of tensor powers of sections -/

/-- For an invertible sheaf `L` and a positive exponent `q`, the nonvanishing locus of `s^q`
in `L^{⊗q}` equals the nonvanishing locus of `s` in `L`. -/
theorem nonvanishingLocus_tensorPowSection_of_pos {L : X.Modules}
    [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X L] {U : X.Opens}
    (s : Γ(L, U)) {q : ℕ} (hq : 0 < q) :
    (tensorPow L q).nonvanishingLocus (tensorPowSection s q) = L.nonvanishingLocus s := by
  ext x
  by_cases hxU : x ∈ U
  · obtain ⟨V, t, hxV⟩ := exists_mem_trivialization L x
    let W : X.Opens := U ⊓ V
    let i : W ⟶ U := homOfLE inf_le_left
    let j : W ⟶ V := homOfLE inf_le_right
    have hxW : x ∈ W := ⟨hxU, hxV⟩
    let e : Γ(L, W) := L.presheaf.map j.op (trivializationGenerator L t)
    have hWe : W ≤ L.nonvanishingLocus e := by
      rw [nonvanishingLocus_map, nonvanishingLocus_trivializationGenerator]
      exact le_inf le_rfl inf_le_right
    have hWeq : W ≤ (tensorPow L q).nonvanishingLocus (tensorPowSection e q) :=
      (le_nonvanishingLocus_iff (tensorPowSection e q) (𝟙 W)).mpr fun W' k ↦ by
        simpa only [Category.comp_id] using bijective_smul_tensorPowSection e
          (fun W'' l ↦ by simpa only [Category.comp_id] using
            (le_nonvanishingLocus_iff e (𝟙 W)).mp hWe W'' l) q W' k
    obtain ⟨r, hr⟩ := surjective_smul_of_le_nonvanishingLocus hWe (L.presheaf.map i.op s)
    have h1 : x ∈ L.nonvanishingLocus s ↔ x ∈ X.basicOpen r := by
      have hW' : W ⊓ L.nonvanishingLocus s = X.basicOpen r := by
        rw [← nonvanishingLocus_map i s, ← hr, nonvanishingLocus_smul,
          inf_eq_left.mpr ((X.basicOpen_le r).trans hWe)]
      exact ⟨fun h ↦ hW' ▸ ⟨hxW, h⟩, fun h ↦ (hW'.symm ▸ h).2⟩
    have h2 : x ∈ (tensorPow L q).nonvanishingLocus (tensorPowSection s q) ↔
        x ∈ X.basicOpen (r ^ q) := by
      have hW' : W ⊓ (tensorPow L q).nonvanishingLocus (tensorPowSection s q) =
          X.basicOpen (r ^ q) := by
        rw [← nonvanishingLocus_map i (tensorPowSection s q), map_tensorPowSection, ← hr,
          tensorPowSection_smul, nonvanishingLocus_smul,
          inf_eq_left.mpr ((X.basicOpen_le (r ^ q)).trans hWeq)]
      exact ⟨fun h ↦ hW' ▸ ⟨hxW, h⟩, fun h ↦ (hW'.symm ▸ h).2⟩
    simp only [SetLike.mem_coe, h2, h1, X.basicOpen_pow r hq]
  · exact ⟨fun h ↦ (hxU (nonvanishingLocus_le _ h)).elim,
      fun h ↦ (hxU (nonvanishingLocus_le _ h)).elim⟩

/-! ### Stepping extensions to higher tensor powers -/

/-- The canonical isomorphism `(F ⊗ L^{⊗k}) ⊗ L ≅ F ⊗ L^{⊗(k + 1)}` obtained by reassociating
and moving the extra copy of `L` to the front of `L^{⊗k}`. -/
def tensorPowStepIso (F L : X.Modules) (k : ℕ) :
    (F ⊗ tensorPow L k) ⊗ L ≅ F ⊗ tensorPow L (k + 1) :=
  α_ F (tensorPow L k) L ≪≫ whiskerLeftIso F (β_ (tensorPow L k) L)

/-- Under `tensorPowStepIso`, tensoring `t ⊗ e^k` with `e` becomes `t ⊗ e^{k + 1}`. -/
theorem tensorPowStepIso_hom_app_tmulRight (F L : X.Modules) (k : ℕ) {U : X.Opens}
    (e : Γ(L, U)) (t : Γ(F, U)) :
    (tensorPowStepIso F L k).hom.app U
        (tmulRight (F ⊗ tensorPow L k) e (tmulRight F (tensorPowSection e k) t)) =
      tmulRight F (tensorPowSection e (k + 1)) t := by
  simp only [tensorPowStepIso, Iso.trans_hom, Hom.comp_app, ConcreteCategory.comp_apply]
  have hassoc := congrArg (fun φ ↦ φ.hom ((t ⊗ₜ tensorPowSection e k) ⊗ₜ e))
    (Functor.LaxMonoidal.associativity (sectionsFunctor U) F (tensorPow L k) L)
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at hassoc
  have h1 : (α_ F (tensorPow L k) L).hom.app U
      (tmulRight (F ⊗ tensorPow L k) e (tmulRight F (tensorPowSection e k) t)) =
        tmulRight F (tmulRight (tensorPow L k) e (tensorPowSection e k)) t := by
    rw [tmulRight_apply, tmulRight_apply, tmulRight_apply, tmulRight_apply]
    exact hassoc
  rw [h1, whiskerLeftIso_hom, whiskerLeft_app_tmulRight]
  have hbraid := congrArg (fun φ ↦ φ.hom (tensorPowSection e k ⊗ₜ e))
    (Functor.LaxBraided.braided (F := sectionsFunctor U) (tensorPow L k) L)
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at hbraid
  have h2 : (β_ (tensorPow L k) L).hom.app U (tmulRight (tensorPow L k) e (tensorPowSection e k)) =
      tensorPowSection e (k + 1) := by
    simp only [tensorPowSection_succ, tmulRight_apply]
    exact hbraid
  exact congrArg (fun a ↦ tmulRight F a t) h2

/-- If `t ⊗ s^k` extends from `W` to `U`, then `t ⊗ s^n` extends from `W` to `U` for every
`n ≥ k`. -/
theorem exists_map_eq_tmulRight_tensorPowSection_of_le (F : X.Modules) {L : X.Modules}
    {U W : X.Opens} (i : W ⟶ U) (s : Γ(L, U)) (t : Γ(F, W)) {k n : ℕ} (hkn : k ≤ n)
    (t' : Γ(F ⊗ tensorPow L k, U))
    (ht' : (F ⊗ tensorPow L k).presheaf.map i.op t' =
      tmulRight F (tensorPowSection (L.presheaf.map i.op s) k) t) :
    ∃ t'' : Γ(F ⊗ tensorPow L n, U),
      (F ⊗ tensorPow L n).presheaf.map i.op t'' =
        tmulRight F (tensorPowSection (L.presheaf.map i.op s) n) t := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkn
  clear hkn
  induction d with
  | zero => exact ⟨t', ht'⟩
  | succ d ih =>
    obtain ⟨u, hu⟩ := ih
    let φ := (tensorPowStepIso F L (k + d)).hom
    have hnat (a : Γ((F ⊗ tensorPow L (k + d)) ⊗ L, U)) :
        (F ⊗ tensorPow L (k + d + 1)).presheaf.map i.op (φ.app U a) =
          φ.app W (((F ⊗ tensorPow L (k + d)) ⊗ L).presheaf.map i.op a) :=
      (φ.mapPresheaf.naturality_apply i.op a).symm
    refine ⟨φ.app U (tmulRight (F ⊗ tensorPow L (k + d)) s u), ?_⟩
    refine (hnat _).trans ?_
    rw [map_tmulRight, hu]
    exact tensorPowStepIso_hom_app_tmulRight F L (k + d) _ t

/-! ### Detecting epimorphisms on an affine open cover -/

/-- If `φ : F ⟶ M` hits every member of a family `s : J → Γ(M, ⊤)` whose restrictions span
`Γ(M, U)` over `Γ(X, U)`, then `image.ι φ` is surjective on sections over `U`. -/
private theorem surjective_app_image_ι_of_span_eq_top {F M : X.Modules} (φ : F ⟶ M)
    {J : Type*} (s : J → Γ(M, ⊤)) (U : X.Opens)
    (hs : ∀ j, ∃ e : Γ(F, ⊤), φ.app ⊤ e = s j)
    (hspan : Submodule.span Γ(X, U)
      (Set.range fun j ↦ M.presheaf.map U.leTop.op (s j)) = ⊤)
    (y : Γ(M, U)) :
    ∃ x : Γ(image φ, U), (image.ι φ).app U x = y := by
  have hy : y ∈ Submodule.span Γ(X, U)
      (Set.range fun j ↦ M.presheaf.map U.leTop.op (s j)) := hspan ▸ Submodule.mem_top
  induction hy using Submodule.span_induction with
  | mem _ hj =>
    obtain ⟨j, rfl⟩ := hj
    obtain ⟨e, he⟩ := hs j
    let eU : Γ(F, U) := F.presheaf.map U.leTop.op e
    refine ⟨(factorThruImage φ).app U eU, ?_⟩
    have hfac : (image.ι φ).app U ((factorThruImage φ).app U eU) = φ.app U eU := by
      rw [← ConcreteCategory.comp_apply, ← Hom.comp_app, image.fac]
    have hnat : φ.app U eU = M.presheaf.map U.leTop.op (φ.app ⊤ e) :=
      φ.mapPresheaf.naturality_apply U.leTop.op e
    rw [hfac, hnat, he]
  | zero => exact ⟨0, map_zero _⟩
  | add _ _ _ _ hx hy =>
    obtain ⟨a, rfl⟩ := hx
    obtain ⟨b, rfl⟩ := hy
    exact ⟨a + b, map_add _ _ _⟩
  | smul r _ _ hx =>
    obtain ⟨a, rfl⟩ := hx
    exact ⟨r • a, Hom.app_smul _ _ _⟩

/-- Let `M` be a quasi-coherent `𝒪_X`-module and `s : J → Γ(M, ⊤)` a finite family of global
sections whose restrictions generate `Γ(M, U i)` over `Γ(X, U i)` on each member of an affine
open cover `U` of `X`. Then the induced morphism `𝒪_X^J ⟶ M` is an epimorphism. -/
theorem epi_of_isOpenCover_span_eq_top {ι : Type*} {U : ι → X.Opens}
    (hU : IsOpenCover U) (hUaff : ∀ i, IsAffineOpen (U i))
    {M : X.Modules} [M.IsQuasicoherent] {J : Type u} [Finite J] (s : J → Γ(M, ⊤))
    (hspan : ∀ i, Submodule.span Γ(X, U i)
      (Set.range fun j ↦ M.presheaf.map (U i).leTop.op (s j)) = ⊤) :
    Epi (M.freeHomEquiv.symm fun j ↦ M.sectionsEquivTop.symm (s j)) := by
  let F : X.Modules := SheafOfModules.free J
  let φ : F ⟶ M := M.freeHomEquiv.symm fun j ↦ M.sectionsEquivTop.symm (s j)
  have hF : F.IsFinitePresentation :=
    inferInstanceAs (SheafOfModules.free (R := X.ringCatSheaf) J).IsFinitePresentation
  have hs (j : J) : ∃ e : Γ(F, ⊤), φ.app ⊤ e = s j := by
    let e : Γ(F, ⊤) := F.sectionsEquivTop (SheafOfModules.freeSection (R := X.ringCatSheaf) j)
    refine ⟨e, ?_⟩
    have htopj : φ.app ⊤ e =
        M.sectionsEquivTop (SheafOfModules.sectionsMap φ (SheafOfModules.freeSection j)) := by
      rw [sectionsEquivTop_sectionsMap]
    rw [htopj, (SheafOfModules.freeHomEquiv_apply (M := M) φ j).symm.trans
      (congrFun (M.freeHomEquiv.apply_symm_apply _) j), Equiv.apply_symm_apply]
  -- It suffices to show `image.ι φ` is an isomorphism, which is checked on the affine cover `U`.
  suffices IsIso (image.ι φ) by
    have := epi_comp (factorThruImage φ) (image.ι φ)
    rwa [image.fac] at this
  refine (isIso_iff_of_isOpenCover hU (image.ι φ)).mpr fun i ↦ ?_
  refine (NatIso.isIso_map_iff (restrictFunctorIsoPullback (U i).ι) (image.ι φ)).mp ?_
  have : IsAffine (U i).toScheme := hUaff i
  have : Mono ((restrictFunctor (U i).ι).map (image.ι φ)) :=
    (restrictFunctor (U i).ι).map_mono (image.ι φ)
  refine isIso_of_mono_of_surjective_sectionsFunctor_map_top _ fun y ↦ ?_
  have htop : (U i).ι ''ᵁ ⊤ = U i := Scheme.Opens.ι_image_top (U i)
  let y' : Γ(M, (U i).ι ''ᵁ ⊤) := y
  let eM := M.presheaf.map (eqToHom htop.symm).op
  let eI := (image φ).presheaf.map (eqToHom htop).op
  obtain ⟨x, hx⟩ := surjective_app_image_ι_of_span_eq_top φ s (U i) hs (hspan i) (eM y')
  refine ⟨eI x, ?_⟩
  have hnat : (image.ι φ).app ((U i).ι ''ᵁ ⊤) (eI x) =
      M.presheaf.map (eqToHom htop).op ((image.ι φ).app (U i) x) :=
    (image.ι φ).mapPresheaf.naturality_apply (eqToHom htop).op x
  have hcomp : M.presheaf.map (eqToHom htop).op (eM y') = y' := by
    have h := (ConcreteCategory.congr_hom
      (M.presheaf.map_comp (eqToHom htop.symm).op (eqToHom htop).op) y').symm
    rw [← op_comp, eqToHom_trans, eqToHom_refl, op_id, M.presheaf.map_id] at h
    exact h
  exact hnat.trans ((congrArg _ hx).trans hcomp)

/-! ### Serre's global generation theorem -/

/-- On the nonvanishing locus `U = X_s` of a global section `s` of an invertible sheaf `L`, if
`T ⊆ Γ(F, U)` spans `Γ(F, U)` and every `t ⊗ s^n` (`t ∈ T`) appears among the restrictions of
global sections `gGlob`, then the restrictions of `gGlob` span `Γ(F ⊗ L^{⊗n}, U)`. -/
private theorem span_eq_top_on_nonvanishingLocus {L F : X.Modules}
    [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X L] (s : Γ(L, ⊤)) (n : ℕ)
    (T : Set Γ(F, L.nonvanishingLocus s)) (hT : Submodule.span Γ(X, L.nonvanishingLocus s) T = ⊤)
    {J : Type*} (gGlob : J → Γ(F ⊗ tensorPow L n, ⊤))
    (hlift : ∀ t ∈ T, ∃ j,
      (F ⊗ tensorPow L n).presheaf.map (L.nonvanishingLocus s).leTop.op (gGlob j) =
        tmulRight F (tensorPowSection (L.presheaf.map (L.nonvanishingLocus s).leTop.op s) n) t) :
    Submodule.span Γ(X, L.nonvanishingLocus s)
      (Set.range fun j ↦
        (F ⊗ tensorPow L n).presheaf.map (L.nonvanishingLocus s).leTop.op (gGlob j)) = ⊤ := by
  let U := L.nonvanishingLocus s
  have hUi : U ≤ L.nonvanishingLocus (L.presheaf.map U.leTop.op s) := by
    rw [nonvanishingLocus_map]
    exact le_inf le_rfl le_rfl
  let φ := tmulRight F (tensorPowSection (L.presheaf.map U.leTop.op s) n)
  have hφsurj : Function.Surjective φ :=
    (bijective_tmulRight_tensorPowSection_of_le_nonvanishingLocus F _ hUi n).2
  rw [eq_top_iff]
  intro y _
  obtain ⟨x, rfl⟩ := hφsurj y
  have hx : x ∈ Submodule.span Γ(X, U) T := hT ▸ Submodule.mem_top
  have hmap : φ x ∈ Submodule.map φ (Submodule.span Γ(X, U) T) := Submodule.mem_map_of_mem hx
  rw [Submodule.map_span] at hmap
  refine Submodule.span_mono ?_ hmap
  rintro _ ⟨t, ht, rfl⟩
  exact hlift t ht

/-- **Global generation from a finite affine nonvanishing cover.** Let `X` be quasi-compact and
quasi-separated, `L` an invertible `𝒪_X`-module, and `s : ι → Γ(L, ⊤)` a finite family of global
sections whose nonvanishing loci `X_{sᵢ}` are affine and cover `X`. Then for every quasi-coherent
`𝒪_X`-module `F` of finite type, there is `n₀ : ℕ` such that for all `n ≥ n₀`, `F ⊗ L^{⊗n}` admits
an epimorphism from a free `𝒪_X`-module of finite rank. -/
theorem exists_epi_free_tensorPow_of_iSup_nonvanishingLocus [CompactSpace X]
    [QuasiSeparatedSpace X] {L : X.Modules}
    [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X L]
    {ι : Type*} [Finite ι] (s : ι → Γ(L, ⊤))
    (haff : ∀ i, IsAffineOpen (L.nonvanishingLocus (s i)))
    (hcov : ⨆ i, L.nonvanishingLocus (s i) = ⊤)
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ (J : Type u) (_ : Finite J)
        (π : Quiver.Hom (V := X.Modules) (SheafOfModules.free J) (F ⊗ tensorPow L n)), Epi π := by
  classical
  cases nonempty_fintype ι
  let U (i : ι) : X.Opens := L.nonvanishingLocus (s i)
  have hfin (i : ι) : Module.Finite Γ(X, U i) Γ(F, U i) :=
    F.finite_sections_of_isAffineOpen (U i) (haff i)
  choose T hT using fun i ↦ Module.Finite.fg_top (R := Γ(X, U i)) (M := Γ(F, U i))
  have hlift (p : Σ i : ι, T i) :
      ∃ (k : ℕ) (g : Γ(F ⊗ tensorPow L k, ⊤)),
        (F ⊗ tensorPow L k).presheaf.map (U p.1).leTop.op g =
          tmulRight F (tensorPowSection (L.presheaf.map (U p.1).leTop.op (s p.1)) k) p.2.1 := by
    have heq : homOfLE (L.nonvanishingLocus_le (s p.1)) = (U p.1).leTop := Subsingleton.elim _ _
    simpa only [heq] using
      exists_map_eq_tmulRight_tensorPowSection F (L := L) (U := ⊤)
        isCompact_univ (isQuasiSeparated_univ_iff.mpr inferInstance) (s p.1) p.2.1
  choose k g hg using hlift
  refine ⟨Finset.univ.sup k, fun n hn ↦ ?_⟩
  have hstep (p : Σ i : ι, T i) :
      ∃ g' : Γ(F ⊗ tensorPow L n, ⊤),
        (F ⊗ tensorPow L n).presheaf.map (U p.1).leTop.op g' =
          tmulRight F (tensorPowSection (L.presheaf.map (U p.1).leTop.op (s p.1)) n) p.2.1 :=
    exists_map_eq_tmulRight_tensorPowSection_of_le F (U p.1).leTop (s p.1) p.2.1
      ((Finset.le_sup (f := k) (Finset.mem_univ p)).trans hn) (g p) (hg p)
  choose g' hg' using hstep
  have : (tensorPow L n).IsFinitePresentation :=
    TauCeti.SheafOfModules.IsInvertible.isFinitePresentation
      (M := tensorPow L n) (hM := isInvertible_tensorPow L n)
  have : (tensorPow L n).IsQuasicoherent := isQuasicoherent_of_isFinitePresentation _
  let eJ : ULift.{u} (Fin (Fintype.card (Σ i : ι, T i))) ≃ Σ i : ι, T i :=
    Equiv.ulift.trans (Fintype.equivFin (Σ i : ι, T i)).symm
  let gGlob (j : ULift.{u} (Fin (Fintype.card (Σ i : ι, T i)))) : Γ(F ⊗ tensorPow L n, ⊤) :=
    g' (eJ j)
  refine ⟨ULift.{u} (Fin (Fintype.card (Σ i : ι, T i))), inferInstance,
    (F ⊗ tensorPow L n).freeHomEquiv.symm fun j ↦
      (F ⊗ tensorPow L n).sectionsEquivTop.symm (gGlob j),
    epi_of_isOpenCover_span_eq_top (U := U) hcov haff gGlob fun i ↦
      span_eq_top_on_nonvanishingLocus (s i) n (T i : Set Γ(F, U i)) (hT i) gGlob fun t ht ↦
        ⟨eJ.symm ⟨i, ⟨t, ht⟩⟩,
          by simpa only [gGlob, Equiv.apply_symm_apply] using hg' ⟨i, ⟨t, ht⟩⟩⟩⟩

/-- For an ample line bundle `L`, some positive power `L^{⊗D}` admits a finite family of global
sections whose nonvanishing loci are affine and cover `X`. -/
private theorem exists_common_power_nonvanishing_cover (L : InvertibleSheaf X)
    (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ (D : ℕ) (_ : 0 < D) (ι : Type u) (_ : Finite ι) (t : ι → Γ(tensorPow L.obj D, ⊤)),
      (∀ i, IsAffineOpen ((tensorPow L.obj D).nonvanishingLocus (t i))) ∧
        ⨆ i, (tensorPow L.obj D).nonvanishingLocus (t i) = ⊤ := by
  classical
  have : CompactSpace X := hL.compactSpace
  have hpt (x : X) : ∃ (d : ℕ) (_ : 0 < d) (s : Γ(tensorPow L.obj d, ⊤)),
      x ∈ (tensorPow L.obj d).nonvanishingLocus s ∧
        IsAffineOpen ((tensorPow L.obj d).nonvanishingLocus s) := by
    obtain ⟨d, hd, hforall⟩ := hL.exists_pos_forall_mk_eq x
    obtain ⟨s, hx, haff⟩ := hforall ⟨tensorPow L.obj d, inferInstance⟩
      (LineBundleClass.mk_tensorPow_obj L d)
    exact ⟨d, hd, s, hx, haff⟩
  choose d hd s hx haff using hpt
  obtain ⟨ι, hι⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X ↦ ((tensorPow L.obj (d x)).nonvanishingLocus (s x) : Set X))
    (fun x ↦ ((tensorPow L.obj (d x)).nonvanishingLocus (s x)).isOpen)
    fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hx x⟩
  let D : ℕ := ∏ x ∈ ι, d x
  have hDpos : 0 < D := Finset.prod_pos fun x _ ↦ hd x
  have hlift (x : ι) : ∃ t : Γ(tensorPow L.obj D, ⊤),
      (tensorPow L.obj D).nonvanishingLocus t =
        (tensorPow L.obj (d x.1)).nonvanishingLocus (s x.1) := by
    obtain ⟨q, hqeq⟩ := Finset.dvd_prod_of_mem d x.2
    have hqpos : 0 < q := Nat.pos_of_ne_zero fun hq0 ↦ by
      rw [hq0, mul_zero] at hqeq
      exact hDpos.ne' hqeq
    let K : InvertibleSheaf X := ⟨tensorPow L.obj (d x.1), inferInstance⟩
    have hmk : LineBundleClass.mk
        ⟨tensorPow K.obj q, @isInvertible_tensorPow X K.obj K.property q⟩ =
        LineBundleClass.mk ⟨tensorPow L.obj D, inferInstance⟩ := by
      rw [LineBundleClass.mk_tensorPow_obj K q, LineBundleClass.mk_tensorPow_obj L D,
        LineBundleClass.mk_tensorPow_obj L (d x.1), ← pow_mul]
      exact congrArg (LineBundleClass.mk L ^ ·) hqeq.symm
    obtain ⟨e⟩ := LineBundleClass.mk_eq_mk_iff.mp hmk
    let e' : tensorPow (tensorPow L.obj (d x.1)) q ≅ tensorPow L.obj D := e
    refine ⟨e'.hom.app ⊤ (tensorPowSection (s x.1) q), ?_⟩
    rw [nonvanishingLocus_hom_app e', nonvanishingLocus_tensorPowSection_of_pos (s x.1) hqpos]
  choose t ht using hlift
  refine ⟨D, hDpos, ι, inferInstance, t, fun x ↦ ht x ▸ haff x.1, top_unique fun y _ ↦ ?_⟩
  obtain ⟨x, hxι, hyx⟩ := Set.mem_iUnion₂.mp (hι (Set.mem_univ y))
  exact Opens.mem_iSup.mpr ⟨⟨x, hxι⟩, (ht ⟨x, hxι⟩).symm ▸ hyx⟩

/-- For an invertible sheaf `L` and exponents satisfying `D * q + r = n`, we have an isomorphism
`L^{⊗r} ⊗ (L^{⊗D})^{⊗q} ≅ L^{⊗n}`. -/
private theorem exists_tensorPow_mul_add_iso (L : InvertibleSheaf X) {D q r n : ℕ}
    (h : D * q + r = n) :
    Nonempty (tensorPow L.obj r ⊗ tensorPow (tensorPow L.obj D) q ≅ tensorPow L.obj n) := by
  obtain ⟨e1⟩ := InvertibleSheaf.nonempty_tensorPow_tensorPow_iso L D q
  obtain ⟨e2⟩ := InvertibleSheaf.nonempty_tensorPow_add_iso L r (D * q)
  have hnr : r + D * q = n := (add_comm r (D * q)).trans h
  exact ⟨whiskerLeftIso (tensorPow L.obj r)
      ((tensorPowMapIso (InvertibleSheaf.tensorPowObjIso L D) q).symm ≪≫
        (InvertibleSheaf.tensorPowObjIso (L.tensorPow D) q).symm ≪≫ e1) ≪≫
    tensorIso (InvertibleSheaf.tensorPowObjIso L r).symm (Iso.refl _) ≪≫
    (InvertibleSheaf.tensorProductObjIso (L.tensorPow r) (L.tensorPow (D * q))).symm ≪≫
    e2.symm ≪≫
    eqToIso (congrArg (fun k ↦ (L.tensorPow k).obj) hnr) ≪≫
    InvertibleSheaf.tensorPowObjIso L n⟩

/-- **Serre's global generation theorem** (Hartshorne, Theorem II.5.17; Stacks Project, Tag 01Q3).
Let `X` be a quasi-separated scheme and `L` an ample line bundle on `X`. For every quasi-coherent
`𝒪_X`-module `F` of finite type, there is `n₀ : ℕ` such that for all `n ≥ n₀`, `F ⊗ L^{⊗n}` admits
an epimorphism from a free `𝒪_X`-module of finite rank. -/
theorem exists_epi_free_tensorPow_of_isAmple [QuasiSeparatedSpace X]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple)
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ (J : Type u) (_ : Finite J)
        (π : Quiver.Hom (V := X.Modules) (SheafOfModules.free J) (F ⊗ tensorPow L.obj n)),
        Epi π := by
  have : CompactSpace X := hL.compactSpace
  obtain ⟨D, hDpos, ι, _, t, haff, hcov⟩ := exists_common_power_nonvanishing_cover L hL
  -- Apply the single-power theorem to `L^{⊗D}` and each of the `D` remainder twists `F ⊗ L^{⊗r}`.
  have hrem (r : Fin D) : ∃ k : ℕ, ∀ q ≥ k,
      ∃ (J : Type u) (_ : Finite J)
        (π : Quiver.Hom (V := X.Modules) (SheafOfModules.free J)
          ((F ⊗ tensorPow L.obj r.1) ⊗ tensorPow (tensorPow L.obj D) q)), Epi π := by
    have : (tensorPow L.obj r.1).IsFinitePresentation :=
      TauCeti.SheafOfModules.IsInvertible.isFinitePresentation
        (M := tensorPow L.obj r.1) (hM := isInvertible_tensorPow L.obj r.1)
    have : (tensorPow L.obj r.1).IsQuasicoherent := isQuasicoherent_of_isFinitePresentation _
    have : (tensorPow L.obj r.1).IsFiniteType := isFiniteType_of_isFinitePresentation _
    exact exists_epi_free_tensorPow_of_iSup_nonvanishingLocus t haff hcov (F ⊗ tensorPow L.obj r.1)
  choose k hk using hrem
  refine ⟨D * Finset.univ.sup k, fun n hn ↦ ?_⟩
  let q : ℕ := n / D
  let r : Fin D := ⟨n % D, Nat.mod_lt n hDpos⟩
  have hq : k r ≤ q :=
    (Finset.le_sup (f := k) (Finset.mem_univ r)).trans ((Nat.le_div_iff_mul_le hDpos).mpr
      (by simpa only [mul_comm] using hn))
  obtain ⟨J, _, π, hπ⟩ := hk r q hq
  obtain ⟨e⟩ := exists_tensorPow_mul_add_iso L (Nat.div_add_mod n D)
  let iso := α_ F (tensorPow L.obj r.1) (tensorPow (tensorPow L.obj D) q) ≪≫ whiskerLeftIso F e
  exact ⟨J, inferInstance, π ≫ iso.hom, epi_comp π iso.hom⟩

/-! ### Corollaries: surjections from biproducts and global generation of line bundles -/

/-- A finite biproduct of copies of `M` is isomorphic to `M ⊗ 𝒪_X^J`. -/
def biproductConstIsoTensorFree (M : X.Modules) (J : Type u) [Finite J]
    [HasBiproduct fun _ : J ↦ M] :
    (⨁ fun _ : J ↦ M) ≅ M ⊗ SheafOfModules.free J := by
  letI : Fintype J := Fintype.ofFinite J
  have : HasBiproduct (C := X.Modules) fun _ : J ↦ 𝟙_ X.Modules :=
    HasBiproduct.of_hasCoproduct _
  exact biproduct.isoCoproduct (fun _ : J ↦ M) ≪≫
    Sigma.mapIso (fun _ ↦ (ρ_ M).symm) ≪≫
    (PreservesCoproduct.iso (tensorLeft M) (fun _ : J ↦ 𝟙_ X.Modules)).symm ≪≫
    whiskerLeftIso M ((biproduct.isoCoproduct (fun _ : J ↦ 𝟙_ X.Modules)).symm ≪≫
      TauCeti.SheafOfModules.biproductIsoFree (R := X.sheaf) J)

/-- Dualizing a surjection onto a twisted sheaf: if `π : 𝒪_X^J ⟶ F ⊗ M` is an epimorphism for a
finite index type `J` and `e : M ⊗ M' ≅ 𝒪_X` exhibits `M'` as an inverse of `M`, then `F` admits
an epimorphism from the finite biproduct `⨁_{j ∈ J} M'`. -/
theorem exists_epi_biproduct_of_epi_free_tensor {F M M' : X.Modules}
    {J : Type u} [Finite J] [HasBiproduct fun _ : J ↦ M']
    (π : Quiver.Hom (V := X.Modules) (SheafOfModules.free J) (F ⊗ M)) [Epi π]
    (e : M ⊗ M' ≅ 𝟙_ X.Modules) :
    ∃ π' : (⨁ fun _ : J ↦ M') ⟶ F, Epi π' := by
  -- Tensor `π` on the left with `M'`; `tensorLeft M'` is a left adjoint so it preserves
  -- epimorphisms.
  have : Epi (M' ◁ π) := (tensorLeft M').map_epi π
  let efree : (⨁ fun _ : J ↦ M') ≅ M' ⊗ SheafOfModules.free J :=
    biproductConstIsoTensorFree M' J
  let etgt : M' ⊗ (F ⊗ M) ≅ F :=
    β_ M' (F ⊗ M) ≪≫ α_ F M M' ≪≫ whiskerLeftIso F e ≪≫ ρ_ F
  have : Epi ((M' ◁ π) ≫ etgt.hom) := epi_comp (M' ◁ π) etgt.hom
  exact ⟨efree.hom ≫ (M' ◁ π) ≫ etgt.hom, epi_comp efree.hom ((M' ◁ π) ≫ etgt.hom)⟩

end

end AlgebraicGeometry.Scheme.Modules

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

variable {X : Scheme.{u}}

/-- **Twists of any line bundle by high powers of an ample line bundle are globally generated.**
On a quasi-separated scheme, if `L` is ample and `K` is any invertible sheaf, then
`K ⊗ L^{⊗n}` is globally generated for all sufficiently large `n`. -/
theorem exists_isGloballyGenerated_tensorProduct_tensorPow [QuasiSeparatedSpace X]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) (K : InvertibleSheaf X) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, (K.tensorProduct (L.tensorPow n)).IsGloballyGenerated := by
  have : K.obj.IsFinitePresentation :=
    TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (M := K.obj)
  have : K.obj.IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_of_isFinitePresentation K.obj
  have : K.obj.IsFiniteType :=
    Scheme.Modules.isFiniteType_of_isFinitePresentation K.obj
  obtain ⟨n₀, hn₀⟩ := Scheme.Modules.exists_epi_free_tensorPow_of_isAmple L hL K.obj
  refine ⟨n₀, fun n hn ↦ ?_⟩
  obtain ⟨J, _, π, hπ⟩ := hn₀ n hn
  let e : K.obj ⊗ TauCeti.tensorPow L.obj n ≅ (K.tensorProduct (L.tensorPow n)).obj :=
    (tensorProductObjIso K (L.tensorPow n) ≪≫ whiskerLeftIso K.obj (tensorPowObjIso L n)).symm
  refine isGloballyGenerated_iff_nonempty_generatingSections.mpr
    ⟨{ I := J
       s := (K.tensorProduct (L.tensorPow n)).obj.freeHomEquiv (π ≫ e.hom)
       epi := by
         change @Epi X.Modules _ _ _ _
         rw [Equiv.symm_apply_apply]
         exact epi_comp π e.hom }⟩

/-- **High powers of an ample line bundle are globally generated.** On a quasi-separated scheme,
if `L` is ample, then `L^{⊗n}` is globally generated for all sufficiently large `n`. -/
theorem exists_isGloballyGenerated_tensorPow [QuasiSeparatedSpace X]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, (L.tensorPow n).IsGloballyGenerated := by
  obtain ⟨n₀, hn₀⟩ := exists_isGloballyGenerated_tensorProduct_tensorPow L hL (trivial X)
  refine ⟨n₀, fun n hn ↦ (isGloballyGenerated_iff_of_iso ?_).mp (hn₀ n hn)⟩
  exact (SheafOfModules.isInvertible X).ι.mapIso (tensorTrivialLeftIso (L.tensorPow n))

end TauCeti.AlgebraicGeometry.InvertibleSheaf
