/-!
# Serre's global generation theorem for ample line bundles

Let `X` be a scheme, `a` an ample line-bundle class on `X` (`LineBundleClass.IsAmple`), and `F` a
quasi-coherent `𝒪_X`-module of finite type. Then there is a bound `n₀ : ℕ` such that for every
`n ≥ n₀` and every invertible sheaf `M` representing `aⁿ`, the twist `F ⊗ M` is generated by
finitely many global sections (`LineBundleClass.IsAmple.exists_generatingSections_tensor`). No
Noetherian or explicit quasi-separatedness hypothesis on `X` is needed, since a scheme carrying an
ample line bundle is automatically quasi-compact and quasi-separated.

The proof reduces to Serre's theorem for an invertible sheaf whose affine nonvanishing loci cover
`X` (`Scheme.Modules.eventually_exists_generatingSections_tensor_tensorPow`):

1. By `IsAmple.exists_finset_isAffineOpen_nonvanishingLocus`, `X` is covered by finitely many affine
   nonvanishing loci of global sections of positive powers `a^{dᵢ}`. Raising each section to the
   power `m / dᵢ` for `m = ∏ dᵢ` preserves its nonvanishing locus
   (`InvertibleSheaf.exists_nonvanishingLocus_eq_of_mk_eq_pow`), producing finitely many global
   sections of a single positive power `Lᵐ` whose affine nonvanishing loci cover `X`
   (`LineBundleClass.IsAmple.exists_pow_iSup_nonvanishingLocus_eq_top`, Stacks Tag 01PR).
2. Applying `eventually_exists_generatingSections_tensor_tensorPow` to `Lᵐ` and each of the
   finitely many residue twists `F ⊗ Lʳ` (`0 ≤ r < m`) yields a uniform threshold `n₀` beyond
   which every twist `F ⊗ M` with `[M] = aⁿ` is generated by finitely many global sections
   (Hartshorne, Theorem II.5.17; Stacks Tag 01Q3).

As consequences:

* For any invertible sheaf `K`, the twists `K ⊗ M` are globally generated for `n ≥ n₀`
  (`LineBundleClass.IsAmple.exists_isGloballyGenerated_tensorProduct`).
* Tensoring a surjection `𝒪_X^k ↠ F ⊗ M` with an inverse `K` (`M ⊗ K ≅ 𝒪_X`) gives an epimorphism
  from a finite direct sum `K^⊕k ↠ F`
  (`AlgebraicGeometry.Scheme.Modules.exists_epi_biproduct_of_generatingSections_tensor`,
  specialized to ample twists in `LineBundleClass.IsAmple.exists_epi_biproduct`).

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Theorem II.5.17.
* [The Stacks Project, Tag 01PR](https://stacks.math.columbia.edu/tag/01PR) and
  [Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3).
-/

public section

open CategoryTheory Limits MonoidalCategory AlgebraicGeometry Opposite
open TopologicalSpace TauCeti

universe u

noncomputable section

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- From finite generating sections of `F ⊗ M` and a right inverse `K` (`M ⊗ K ≅ 𝒪_X`),
tensoring with `K` produces an epimorphism from a finite direct sum of copies of `K` onto `F`. -/
theorem exists_epi_biproduct_of_generatingSections_tensor
    (F M K : X.Modules) (σ : (F ⊗ M).GeneratingSections) [σ.IsFiniteType]
    (e : M ⊗ K ≅ 𝟙_ X.Modules) :
    ∃ (k : ℕ) (π : (⨁ fun _ : Fin k ↦ K) ⟶ F), Epi π := by
  have : Finite σ.I := _root_.SheafOfModules.GeneratingSections.IsFiniteType.finite (σ := σ)
  have : Fintype σ.I := Fintype.ofFinite σ.I
  let I : Type u := σ.I
  let k := Fintype.card I
  let eqv : I ≃ Fin k := Fintype.equivFin I
  let freeI : X.Modules := _root_.SheafOfModules.free I
  let sumIso : (⨁ fun _ : Fin k ↦ K : X.Modules) ≅ freeI ⊗ K :=
    biproduct.whiskerEquiv (f := fun _ : Fin k ↦ K) (g := fun _ : I ↦ K)
      eqv.symm (fun _ ↦ Iso.refl _) ≪≫ (freeTensorIsoBiproduct I K).symm
  let cancelIso : (F ⊗ M) ⊗ K ≅ F :=
    α_ F M K ≪≫ whiskerLeftIso F e ≪≫ ρ_ F
  let π₀ : freeI ⟶ F ⊗ M := σ.π
  have : Epi π₀ := σ.epi
  have : Epi (π₀ ▷ K) := (tensorRight K).map_epi π₀
  exact ⟨k, sumIso.hom ≫ (π₀ ▷ K) ≫ cancelIso.hom, inferInstance⟩

end AlgebraicGeometry.Scheme.Modules

namespace TauCeti.AlgebraicGeometry.LineBundleClass

open _root_.AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- For an ample line bundle `L`, some positive tensor power `Lᵐ` admits finitely many global
sections whose nonvanishing loci are affine and cover `X` (Stacks, Tag 01PR). -/
theorem IsAmple.exists_pow_iSup_nonvanishingLocus_eq_top {L : InvertibleSheaf X}
    (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ (m : ℕ) (_ : 0 < m) (k : ℕ) (t : Fin k → Γ(tensorPow L.obj m, ⊤)),
      (∀ i, IsAffineOpen ((tensorPow L.obj m).nonvanishingLocus (t i))) ∧
      (⨆ i, (tensorPow L.obj m).nonvanishingLocus (t i)) = ⊤ := by
  classical
  obtain ⟨S, hS, hU⟩ := hL.exists_finset_isAffineOpen_nonvanishingLocus
  choose d hd M hM s hs using fun U : S ↦ (hU U.val U.property).2
  -- Raise every section to the common positive power `m = ∏_{U ∈ S} d U`.
  let m : ℕ := ∏ U : S, d U
  have hm : 0 < m := Finset.prod_pos fun U _ ↦ hd U
  have hpow (U : S) : ∃ tU : Γ((tensorPow L m).obj, ⊤),
      (tensorPow L m).obj.nonvanishingLocus tU = U.val := by
    have hdvd : d U ∣ m := Finset.dvd_prod_of_mem d (Finset.mem_univ U)
    have hq : 0 < m / d U := Nat.div_pos (Nat.le_of_dvd hm hdvd) (hd U)
    have hmk : LineBundleClass.mk (tensorPow L m) = LineBundleClass.mk (M U) ^ (m / d U) := by
      rw [mk_tensorPow, hM U, ← pow_mul, Nat.mul_div_cancel' hdvd]
    obtain ⟨tU, htU⟩ := InvertibleSheaf.exists_nonvanishingLocus_eq_of_mk_eq_pow hq hmk (s U)
    exact ⟨tU, htU.trans (hs U)⟩
  choose tU htU using hpow
  let eS := S.equivFin
  let eObj : Iso (C := X.Modules) (tensorPow L m).obj (tensorPow L.obj m) :=
    eqToIso (InvertibleSheaf.tensorPow_obj L m)
  let t (i : Fin S.card) : Γ(tensorPow L.obj m, ⊤) :=
    eObj.hom.app ⊤ (tU (eS.symm i))
  have ht_locus (i : Fin S.card) :
      (tensorPow L.obj m).nonvanishingLocus (t i) = (eS.symm i).val := by
    dsimp only [t]
    rw [nonvanishingLocus_hom_app eObj, htU (eS.symm i)]
  refine ⟨m, hm, S.card, t, fun i ↦ ?_, ?_⟩
  · rw [ht_locus i]
    exact (hU (eS.symm i).val (eS.symm i).property).1
  · refine top_unique fun y _ ↦ ?_
    obtain ⟨U, hUS, hyU⟩ := Opens.mem_sSup.mp (hS ▸ Opens.mem_top y)
    exact Opens.mem_iSup.mpr ⟨eS ⟨U, hUS⟩, by
      rw [ht_locus (eS ⟨U, hUS⟩), Equiv.symm_apply_apply]
      exact hyU⟩

/-- **Serre's global generation theorem** (Hartshorne, Theorem II.5.17; Stacks, Tag 01Q3).
Let `a` be an ample line-bundle class on a scheme `X`, and `F` a quasi-coherent `𝒪_X`-module of
finite type. Then there exists `n₀ : ℕ` such that for every `n ≥ n₀` and every invertible sheaf `M`
representing `aⁿ`, the twist `F ⊗ M` is generated by finitely many global sections. -/
theorem IsAmple.exists_generatingSections_tensor
    {a : LineBundleClass X} (ha : a.IsAmple) (F : X.Modules) [F.IsQuasicoherent]
    [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ (M : InvertibleSheaf X), LineBundleClass.mk M = a ^ n →
      ∃ σ : (F ⊗ M.obj).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨L, rfl⟩ := mk_surjective a
  have : CompactSpace X := ha.compactSpace
  obtain ⟨m, hm, _, t, hta, htc⟩ := ha.exists_pow_iSup_nonvanishingLocus_eq_top
  have hLm (x : X) : ∃ s : Γ(tensorPow L.obj m, ⊤),
      x ∈ (tensorPow L.obj m).nonvanishingLocus s ∧
        IsAffineOpen ((tensorPow L.obj m).nonvanishingLocus s) := by
    obtain ⟨i, hx⟩ := Opens.mem_iSup.mp (htc.symm ▸ Opens.mem_top x)
    exact ⟨t i, hx, hta i⟩
  -- Apply the covering-section theorem to each residue twist `F ⊗ Lʳ` (`0 ≤ r < m`).
  have hrem (r : Fin m) : ∃ q₀ : ℕ, ∀ q ≥ q₀,
      ∃ σ : ((F ⊗ tensorPow L.obj r.val) ⊗ tensorPow (tensorPow L.obj m) q).GeneratingSections,
        σ.IsFiniteType := by
    have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) (tensorPow L.obj r.val) :=
      SheafOfModules.isInvertible_tensorPow L.obj r.val
    have : (tensorPow L.obj r.val).IsFinitePresentation :=
      TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (M := tensorPow L.obj r.val)
    have : (tensorPow L.obj r.val).IsFiniteType := inferInstance
    have : (F ⊗ tensorPow L.obj r.val).IsFiniteType := inferInstance
    exact Filter.eventually_atTop.mp
      (eventually_exists_generatingSections_tensor_tensorPow (F ⊗ tensorPow L.obj r.val) hLm)
  choose q₀ hq₀ using hrem
  refine ⟨m * Finset.univ.sup q₀, fun n hn M hM ↦ ?_⟩
  let q := n / m
  let r : Fin m := ⟨n % m, Nat.mod_lt n hm⟩
  have hq : q₀ r ≤ q :=
    (Finset.le_sup (f := q₀) (Finset.mem_univ r)).trans
      ((Nat.le_div_iff_mul_le hm).mpr (by rwa [mul_comm]))
  obtain ⟨σ, hσ⟩ := hq₀ r q hq
  -- Identify `Lʳ ⊗ (Lᵐ)^{⊗q}` with `M` via their Picard classes.
  have hiso : Nonempty (tensorPow L.obj r.val ⊗ tensorPow (tensorPow L.obj m) q ≅ M.obj) := by
    have hobj : (tensorPow L r.val ⊗ tensorPow (tensorPow L m) q).obj =
        tensorPow L.obj r.val ⊗ tensorPow (tensorPow L.obj m) q := by
      change (tensorPow L r.val).obj ⊗ (tensorPow (tensorPow L m) q).obj = _
      rw [InvertibleSheaf.tensorPow_obj, InvertibleSheaf.tensorPow_obj,
        InvertibleSheaf.tensorPow_obj]
    rw [← hobj]
    refine (mk_eq_mk_iff (L := tensorPow L r.val ⊗ tensorPow (tensorPow L m) q) (K := M)).mp ?_
    rw [hM, mk_tensorObj, mk_tensorPow, mk_tensorPow, mk_tensorPow,
      ← pow_mul, ← pow_add, add_comm, Nat.div_add_mod n m]
  obtain ⟨iso⟩ := hiso
  let eFM : (F ⊗ tensorPow L.obj r.val) ⊗ tensorPow (tensorPow L.obj m) q ≅ F ⊗ M.obj :=
    α_ F (tensorPow L.obj r.val) (tensorPow (tensorPow L.obj m) q) ≪≫ whiskerLeftIso F iso
  exact ⟨_root_.SheafOfModules.GeneratingSections.equivOfIso eFM σ,
    _root_.SheafOfModules.GeneratingSections.isFiniteType_equivOfIso eFM σ⟩

/-- For an ample line-bundle class `a` on a scheme `X` and any invertible sheaf `K`, every twist
`K ⊗ M` with `mk M = aⁿ` is globally generated for all sufficiently large `n`. -/
theorem IsAmple.exists_isGloballyGenerated_tensorProduct
    {a : LineBundleClass X} (ha : a.IsAmple) (K : InvertibleSheaf X) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ (M : InvertibleSheaf X), LineBundleClass.mk M = a ^ n →
      (K.tensorProduct M).IsGloballyGenerated := by
  have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) K.obj := K.property
  have : K.obj.IsFinitePresentation :=
    TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (M := K.obj)
  obtain ⟨n₀, hn₀⟩ := ha.exists_generatingSections_tensor K.obj
  refine ⟨n₀, fun n hn M hM ↦ ?_⟩
  obtain ⟨σ, _⟩ := hn₀ n hn M hM
  exact InvertibleSheaf.isGloballyGenerated_iff_nonempty_generatingSections.mpr
    ⟨_root_.SheafOfModules.GeneratingSections.equivOfIso
      (InvertibleSheaf.tensorProductObjIso K M).symm σ⟩

/-- **Finite direct-sum resolution by negative twists.** Let `a` be an ample line-bundle class on a
scheme `X`, and `F` a quasi-coherent `𝒪_X`-module of finite type. Then there exists `n₀ : ℕ` such
that for every `n ≥ n₀` and every invertible sheaf `K` representing `(aⁿ)⁻¹`, `F` is a quotient of
a finite direct sum `⨁_{Fin k} K`. -/
theorem IsAmple.exists_epi_biproduct
    {a : LineBundleClass X} (ha : a.IsAmple) (F : X.Modules) [F.IsQuasicoherent]
    [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ (K : InvertibleSheaf X), LineBundleClass.mk K = (a ^ n)⁻¹ →
      ∃ (k : ℕ) (π : (⨁ fun _ : Fin k ↦ K.obj) ⟶ F), Epi π := by
  obtain ⟨L, rfl⟩ := mk_surjective a
  obtain ⟨n₀, hn₀⟩ := ha.exists_generatingSections_tensor F
  refine ⟨n₀, fun n hn K hK ↦ ?_⟩
  let M : InvertibleSheaf X := tensorPow L n
  obtain ⟨σ, _⟩ := hn₀ n hn M (mk_tensorPow L n)
  have hMK : Nonempty (M.obj ⊗ K.obj ≅ 𝟙_ X.Modules) := by
    have h1 : LineBundleClass.mk (M.tensorProduct K) = 1 := by
      rw [mk_tensorProduct, mk_tensorPow, hK, mul_inv_cancel]
    obtain ⟨e⟩ := mk_eq_one_iff.mp h1
    exact ⟨(InvertibleSheaf.tensorProductObjIso M K).symm ≪≫ e⟩
  obtain ⟨e⟩ := hMK
  exact exists_epi_biproduct_of_generatingSections_tensor F M.obj K.obj σ e

end TauCeti.AlgebraicGeometry.LineBundleClass

