namespace TauCeti.AlgebraicGeometry

variable {X : Scheme.{u}}

/-- **Common affine cover by sections of a single power of an ample line bundle.** If `L` is an
ample line bundle on `X`, then there exist a positive integer `d` and finitely many global sections
of `L^{⊗ d}` whose nonvanishing loci are affine and cover `X`. -/
theorem LineBundleClass.IsAmple.exists_pos_tensorPow_finite_affine_cover_nonvanishingLocus
    {L : InvertibleSheaf X} (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ (d : ℕ) (_ : 0 < d) (m : ℕ) (s : Fin m → Γ(TauCeti.tensorPow L.obj d, ⊤)),
      (∀ i, IsAffineOpen ((TauCeti.tensorPow L.obj d).nonvanishingLocus (s i))) ∧
        (⨆ i, (TauCeti.tensorPow L.obj d).nonvanishingLocus (s i)) = ⊤ := by
  classical
  obtain ⟨S, hS_top, hS⟩ := hL.exists_finset_isAffineOpen_nonvanishingLocus
  -- Extract the positive power and section for each open `U ∈ S`, transporting to `L^{⊗ n}`.
  have hmem (U : S) : ∃ (n : ℕ) (_ : 0 < n) (t : Γ(TauCeti.tensorPow L.obj n, ⊤)),
      (TauCeti.tensorPow L.obj n).nonvanishingLocus t = U.val := by
    obtain ⟨_, n, hn, L', hL', s', hs'⟩ := hS U.val U.property
    obtain ⟨e⟩ := LineBundleClass.mk_eq_mk_iff.mp (hL'.trans (mk_tensorPow_obj L n).symm)
    obtain ⟨t, ht⟩ : L'.obj.nonvanishingLocus s' ∈
        Set.range ((TauCeti.tensorPow L.obj n).nonvanishingLocus (U := ⊤)) := by
      rw [← Scheme.Modules.range_nonvanishingLocus_eq_of_iso e ⊤]
      exact ⟨s', rfl⟩
    exact ⟨n, hn, t, ht.trans hs'⟩
  choose n hn t ht using hmem
  -- Raise every section to a common positive power `d = ∏ U : S, n U`.
  let d : ℕ := ∏ U : S, n U
  have hd : 0 < d := Nat.pos_of_ne_zero (Finset.prod_ne_zero_iff.mpr fun U _ ↦ (hn U).ne')
  have hlift (U : S) : ∃ s : Γ(TauCeti.tensorPow L.obj d, ⊤),
      (TauCeti.tensorPow L.obj d).nonvanishingLocus s = U.val := by
    have hdvd : n U ∣ d := Finset.dvd_prod_of_mem n (Finset.mem_univ U)
    let k : ℕ := d / n U
    have hnk : n U * k = d := Nat.mul_div_cancel' hdvd
    have hk : 0 < k := Nat.pos_of_ne_zero fun h0 ↦ by simp [h0] at hnk; omega
    obtain ⟨e0⟩ := InvertibleSheaf.nonempty_tensorPow_tensorPow_obj_iso L (n U) k
    let e := e0 ≪≫ eqToIso (congrArg (TauCeti.tensorPow L.obj) hnk)
    refine ⟨e.hom.app ⊤ (Scheme.Modules.tensorPowSection (t U) k), ?_⟩
    rw [Scheme.Modules.nonvanishingLocus_hom_app,
      Scheme.Modules.nonvanishingLocus_tensorPowSection (t U) hk, ht U]
  choose s hs using hlift
  let eS : Fin S.card ≃ S := (Fintype.equivFinOfCardEq (Fintype.card_coe S)).symm
  refine ⟨d, hd, S.card, fun i ↦ s (eS i), fun i ↦ ?_, top_unique fun x _ ↦ ?_⟩
  · rw [hs (eS i)]
    exact (hS (eS i).val (eS i).property).1
  · obtain ⟨U, hUS, hxU⟩ := Opens.mem_sSup.mp (hS_top ▸ Opens.mem_top x)
    refine Opens.mem_iSup.mpr ⟨eS.symm ⟨U, hUS⟩, ?_⟩
    dsimp only
    rw [Equiv.apply_symm_apply, hs ⟨U, hUS⟩]
    exact hxU

end TauCeti.AlgebraicGeometry

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-! ### Serre's twisting-generation theorem -/

/-- **Serre's twisting-generation theorem (for monoidal tensor powers).** Let `X` be a
scheme, `L` an ample invertible sheaf on `X`, and `F` a quasi-coherent `𝒪_X`-module of finite
type. Then there exists `n₀ : ℕ` such that for every `n ≥ n₀`, `F ⊗ L^{⊗ n}` is generated by
finitely many global sections. -/
theorem exists_generatingSections_tensorPow_of_isAmple
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ σ : (F ⊗ tensorPow L.obj n).GeneratingSections, σ.IsFiniteType := by
  have := hL.compactSpace
  obtain ⟨d, hd, m, s, haff, hcover⟩ :=
    hL.exists_pos_tensorPow_finite_affine_cover_nonvanishingLocus
  -- Apply the twisting-generation theorem to each remainder twist `F ⊗ L^{⊗ r}` (`r < d`).
  have hrem (r : Fin d) : ∃ N : ℕ, ∀ q ≥ N,
      ∃ σ : ((F ⊗ tensorPow L.obj r.val) ⊗ tensorPow (tensorPow L.obj d) q).GeneratingSections,
        σ.IsFiniteType := by
    have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) (tensorPow L.obj r.val) :=
      isInvertible_tensorPow L.obj r.val
    have : (tensorPow L.obj r.val).IsFinitePresentation :=
      TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (R := X.ringCatSheaf)
        (M := tensorPow L.obj r.val)
    refine Filter.eventually_atTop.mp
      (eventually_exists_generatingSections_tensor_tensorPow
        (F ⊗ tensorPow L.obj r.val) (L := tensorPow L.obj d) fun x ↦ ?_)
    obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hcover.symm ▸ Opens.mem_top x)
    exact ⟨s i, hi, haff i⟩
  choose N hN using hrem
  let Q : ℕ := Finset.univ.sup N
  refine ⟨d * Q, fun n hn ↦ ?_⟩
  let r : Fin d := ⟨n % d, Nat.mod_lt n hd⟩
  let q : ℕ := n / d
  have hq : Q ≤ q := by
    rw [Nat.le_div_iff_mul_le hd]
    simpa only [mul_comm] using hn
  obtain ⟨σ, hσ⟩ := hN r q ((Finset.le_sup (f := N) (Finset.mem_univ r)).trans hq)
  -- Identify `(F ⊗ L^{⊗ r}) ⊗ (L^{⊗ d})^{⊗ q}` with `F ⊗ L^{⊗ n}` via `tensorPowAddIso`.
  obtain ⟨emul⟩ := InvertibleSheaf.nonempty_tensorPow_tensorPow_obj_iso L d q
  let eL : tensorPow L.obj r.val ⊗ tensorPow (tensorPow L.obj d) q ≅ tensorPow L.obj n :=
    whiskerLeftIso (tensorPow L.obj r.val) emul ≪≫
      TauCeti.tensorPowAddIso L.obj r.val (d * q) ≪≫
      eqToIso (congrArg (TauCeti.tensorPow L.obj) (Nat.div_add_mod n d))
  let e : (F ⊗ tensorPow L.obj r.val) ⊗ tensorPow (tensorPow L.obj d) q ≅
      F ⊗ tensorPow L.obj n :=
    α_ F (tensorPow L.obj r.val) (tensorPow (tensorPow L.obj d) q) ≪≫ whiskerLeftIso F eL
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso e σ, ⟨hσ.finite⟩⟩

/-- **Serre's twisting-generation theorem (for any representative of `L^{⊗ n}`).** Let `X` be a
scheme, `L` an ample invertible sheaf on `X`, and `F` a quasi-coherent `𝒪_X`-module of finite
type. Then there exists `n₀ : ℕ` such that for every `n ≥ n₀` and every invertible sheaf `K`
representing `L^{⊗ n}`, `F ⊗ K` is generated by finitely many global sections. -/
theorem exists_generatingSections_tensor_of_isAmple
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ K : InvertibleSheaf X,
      LineBundleClass.mk K = LineBundleClass.mk L ^ n →
      ∃ σ : (F ⊗ K.obj).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨n₀, hn₀⟩ := F.exists_generatingSections_tensorPow_of_isAmple L hL
  refine ⟨n₀, fun n hn K hK ↦ ?_⟩
  obtain ⟨σ, hσ⟩ := hn₀ n hn
  have hclass : LineBundleClass.mk ⟨tensorPow L.obj n, inferInstance⟩ = LineBundleClass.mk K := by
    rw [LineBundleClass.mk_tensorPow_obj, hK]
  obtain ⟨eK⟩ := LineBundleClass.mk_eq_mk_iff.mp hclass
  let e : F ⊗ tensorPow L.obj n ≅ F ⊗ K.obj := whiskerLeftIso F eK
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso e σ, ⟨hσ.finite⟩⟩

/-- **Finite negative-twist presentation.** Let `X` be a scheme, `L` an ample invertible sheaf on
`X`, and `F` a quasi-coherent `𝒪_X`-module of finite type. Then there exists `n₀ : ℕ` such that for
every `n ≥ n₀` and every invertible sheaf `K` representing `L^{⊗ (-n)}`, there are `k : ℕ` and an
epimorphism `(⨁ fun _ : Fin k ↦ K) ⟶ F`. -/
theorem exists_epi_biproduct_of_isAmple
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∀ K : InvertibleSheaf X,
      LineBundleClass.mk K = (LineBundleClass.mk L ^ n)⁻¹ →
      ∃ (k : ℕ) (p : (⨁ fun _ : Fin k ↦ K.obj) ⟶ F), Epi p := by
  obtain ⟨n₀, hn₀⟩ := F.exists_generatingSections_tensor_of_isAmple L hL
  refine ⟨n₀, fun n hn K hK ↦ ?_⟩
  have hKdual : LineBundleClass.mk K.dual = LineBundleClass.mk L ^ n := by
    rw [← LineBundleClass.inv_mk, hK, inv_inv]
  obtain ⟨σ, hσ⟩ := hn₀ n hn K.dual hKdual
  have : Finite σ.I := hσ.finite
  have : Fintype σ.I := Fintype.ofFinite σ.I
  let k : ℕ := Fintype.card σ.I
  let eI : Fin k ≃ σ.I := (Fintype.equivFin σ.I).symm
  have : MonoidalPreadditive X.Modules := TauCeti.SheafOfModules.monoidalPreadditive X.sheaf
  -- Tensor the epimorphism `free σ.I ⟶ F ⊗ K^∨` on the left by `K`.
  let π : (SheafOfModules.free (R := X.ringCatSheaf) σ.I : X.Modules) ⟶ F ⊗ K.dual.obj := σ.π
  have hπ : Epi (C := X.Modules) π := σ.epi
  have : (tensorLeft K.obj).IsLeftAdjoint := ⟨ihom K.obj, ⟨ihom.adjunction K.obj⟩⟩
  have : Epi (K.obj ◁ π) := TauCeti.epi_whiskerLeft K.obj π
  -- Identify `K ⊗ (F ⊗ K^∨) ≅ F` using the canonical evaluation isomorphism `K ⊗ K^∨ ≅ 𝒪_X`.
  let eF : K.obj ⊗ (F ⊗ K.dual.obj) ≅ F :=
    whiskerLeftIso K.obj (β_ F K.dual.obj) ≪≫
      (α_ K.obj K.dual.obj F).symm ≪≫
      whiskerRightIso K.evaluationDualIso F ≪≫
      λ_ F
  -- Identify `⨁_{Fin k} K ≅ K ⊗ free σ.I`.
  let eFree : (⨁ fun _ : Fin k ↦ K.obj) ≅
      K.obj ⊗ (SheafOfModules.free (R := X.ringCatSheaf) σ.I : X.Modules) :=
    biproduct.mapIso (fun _ : Fin k ↦ (ρ_ K.obj).symm) ≪≫
      (leftDistributor K.obj (fun _ : Fin k ↦ 𝟙_ X.Modules)).symm ≪≫
      whiskerLeftIso K.obj
        (biproduct.whiskerEquiv (f := fun _ : Fin k ↦ 𝟙_ X.Modules)
            (g := fun _ : σ.I ↦ 𝟙_ X.Modules) eI (fun _ ↦ Iso.refl _) ≪≫
          TauCeti.SheafOfModules.biproductIsoFree (R := X.sheaf) σ.I)
  exact ⟨k, (eFree.hom ≫ (K.obj ◁ π)) ≫ eF.hom, inferInstance⟩

end AlgebraicGeometry.Scheme.Modules
