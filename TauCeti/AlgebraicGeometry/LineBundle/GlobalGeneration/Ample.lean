variable {X : Scheme.{u}}

/-- The underlying sheaf of `InvertibleSheaf.tensorPow L n` is isomorphic to the monoidal tensor
power `TauCeti.tensorPow L.obj n`. -/
def InvertibleSheaf.tensorPowObjIso (L : InvertibleSheaf X) :
    (n : ℕ) → (L.tensorPow n).obj ≅ TauCeti.tensorPow L.obj n
  | 0 => eqToIso (congrArg ObjectProperty.FullSubcategory.obj (InvertibleSheaf.tensorPow_zero L)) ≪≫
      InvertibleSheaf.trivialObjIsoUnit X
  | n + 1 =>
    eqToIso (congrArg ObjectProperty.FullSubcategory.obj (InvertibleSheaf.tensorPow_succ L n)) ≪≫
      InvertibleSheaf.tensorProductObjIso (L.tensorPow n) L ≪≫
      tensorIso (InvertibleSheaf.tensorPowObjIso L n) (Iso.refl L.obj) ≪≫
      β_ (TauCeti.tensorPow L.obj n) L.obj

/-- Every monoidal tensor power `TauCeti.tensorPow L n` of an invertible `𝒪_X`-module is
invertible. -/
instance isInvertible_tensorPow (L : X.Modules) [SheafOfModules.isInvertible X L] (n : ℕ) :
    SheafOfModules.isInvertible X (TauCeti.tensorPow L n) :=
  (SheafOfModules.isInvertible X).prop_of_iso
    (InvertibleSheaf.tensorPowObjIso ⟨L, inferInstance⟩ n)
    (InvertibleSheaf.tensorPow ⟨L, inferInstance⟩ n).property

/-- The line-bundle class of the monoidal tensor power `TauCeti.tensorPow L.obj n` is
`(LineBundleClass.mk L) ^ n`. -/
@[simp]
theorem LineBundleClass.mk_tensorPow_obj (L : InvertibleSheaf X) (n : ℕ) :
    LineBundleClass.mk ⟨TauCeti.tensorPow L.obj n, inferInstance⟩ = LineBundleClass.mk L ^ n := by
  rw [← LineBundleClass.mk_tensorPow L n]
  exact LineBundleClass.mk_eq_mk_iff.mpr ⟨(InvertibleSheaf.tensorPowObjIso L n).symm⟩

end

