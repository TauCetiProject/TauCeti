module

public import Mathlib.AlgebraicGeometry.FunctionField
import Mathlib.GroupTheory.MonoidLocalization.UniqueFactorization

/-!
# Stalks of the structure sheaf of `Spec R`

The stalk of `Spec R` at a point `x` is the localization `R_x` of `R` at the prime `x`, with
localization map `StructureSheaf.toStalk R x` (`StructureSheaf.IsLocalization.to_stalk`). This file
records consequences of that description.

## Main results

* `TauCeti.AlgebraicGeometry.StructureSheaf.toStalk_mem_maximalIdeal_iff`: the image of `r` in
  the stalk at `x` lies in its maximal ideal iff `r ∈ x`.
* `TauCeti.AlgebraicGeometry.StructureSheaf.maximalIdeal_stalk_eq_span`: if `x = (p)`, the maximal
  ideal of the stalk at `x` is generated by the image of `p`.
* `TauCeti.AlgebraicGeometry.StructureSheaf.algebraMap_functionField_toStalk`: for a domain `R`,
  the algebra map `R → K(Spec R)` factors through every stalk.
* The stalks of the spectrum of a unique factorization domain are unique factorization domains.
-/

public section

open _root_.AlgebraicGeometry

universe u

namespace TauCeti.AlgebraicGeometry.StructureSheaf

variable {R : CommRingCat.{u}}

/-- The image of `r ∈ R` in the stalk of `Spec R` at `x` lies in the maximal ideal of the stalk iff
`r` lies in the prime ideal `x`. -/
@[simp]
lemma toStalk_mem_maximalIdeal_iff (x : Spec R) (r : R) :
    StructureSheaf.toStalk R x r ∈ IsLocalRing.maximalIdeal ((Spec R).presheaf.stalk x) ↔
      r ∈ x.asIdeal := by
  let _ : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
  have := x.isPrime
  have : IsLocalization.AtPrime ((Spec R).presheaf.stalk x) x.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk R x
  -- `algebraMap R _ r` is `toStalk R x r` by `StructureSheaf.stalkAlgebra_map`
  exact IsLocalization.AtPrime.to_map_mem_maximal_iff _ x.asIdeal r

/-- The maximal ideal of the local ring of `Spec R` at `x` is generated by the image of a
generator of `x`. -/
lemma maximalIdeal_stalk_eq_span {x : Spec R} {p : R} (hx : x.asIdeal = Ideal.span {p}) :
    IsLocalRing.maximalIdeal ((Spec R).presheaf.stalk x) =
      Ideal.span {StructureSheaf.toStalk R x p} := by
  let _ : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
  have := x.isPrime
  have : IsLocalization.AtPrime ((Spec R).presheaf.stalk x) x.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk R x
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal x.asIdeal, hx, Ideal.map_span,
    Set.image_singleton]
  exact congrArg (Ideal.span {·}) (StructureSheaf.stalkAlgebra_map (R := R) x p)

/-- The stalks of the spectrum of a unique factorization domain are unique factorization domains:
they are localizations of `R`. -/
instance uniqueFactorizationMonoid_stalk [UniqueFactorizationMonoid R] (x : Spec R) :
    UniqueFactorizationMonoid ((Spec R).presheaf.stalk x) := by
  let _ : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
  have := x.isPrime
  have : IsLocalization.AtPrime ((Spec R).presheaf.stalk x) x.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk R x
  exact UniqueFactorizationMonoid.of_isLocalization x.asIdeal.primeCompl _

/-- The algebra map `R → K(Spec R)` factors through the stalk at every point of `Spec R`. -/
@[simp]
lemma algebraMap_functionField_toStalk [IsDomain R] (x : Spec R) (r : R) :
    algebraMap ((Spec R).presheaf.stalk x) (Spec R).functionField
        (StructureSheaf.toStalk R x r) = algebraMap R (Spec R).functionField r := by
  rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra]
  exact StructureSheaf.toStalk_stalkSpecializes_apply _ r

end TauCeti.AlgebraicGeometry.StructureSheaf
