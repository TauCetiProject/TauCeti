module

public import TauCeti.AlgebraicGeometry.PicardFunctor.ComponentTorsor

import TauCeti.GroupTheory.SpecificGroups.Cyclic.Index

/-!
# The period and the index of a curve

Let `f : X ⟶ S` be a smooth proper geometrically connected family of curves, for instance a
smooth projective geometrically connected curve `X` over a field `k` with `S = Spec k`, possibly
without a rational point. Two numerical invariants measure how far `X` is from having a rational
point.

* The **period** of `X` (`curvePeriod f`) is the gcd of the degrees of the `S`-rational divisor
  classes: the degrees `d` for which the degree-`d` component `Picᵈ_{X/S}` of the relative Picard
  fppf sheaf has a section over `S`. These degrees form a subgroup of `ℤ` (`curvePeriodSubgroup f`)
  since degrees add, and the period is its index.
* The **index** of `X` (`curveIndex f`) is the gcd of the degrees of the `S`-rational divisors,
  here the relative effective Cartier divisors on `X` over `S`. It is the index of the subgroup of
  `ℤ` they generate (`curveIndexSubgroup f`). Over a field these are the effective Cartier
  divisors on `X`, and every divisor is a difference of two of them, so this is the gcd of the
  degrees of all rational divisors.

A divisor of degree `d` has a class of degree `d`, so **the period divides the index**
(`curvePeriod_dvd_curveIndex`); both are `1` when `f` has a section. The period can be strictly
smaller, since a rational divisor class need not be the class of a rational divisor (Poonen–Stoll,
Section 8).

The period governs the torsors `Picᵈ_{X/S}` under `Pic⁰_{X/S}` (`isTorsor_picardComponent`): when
these components are representable, `picardComponent f d` has a section over `S` exactly when the
period divides `d` (`exists_section_picardComponent_iff`), equivalently when its class in
`Sheaf.NonabelianH1` is trivial (`mk_toTorsor_picardComponent_eq_one_iff`).

## Main declarations

* `TauCeti.AlgebraicGeometry.curvePeriodSubgroup`, `TauCeti.AlgebraicGeometry.curvePeriod`: the
  degrees of `S`-rational divisor classes, and their gcd;
* `TauCeti.AlgebraicGeometry.curvePeriod_dvd_iff`: the period divides `d` exactly when
  `Picᵈ_{X/S}` has a section over `S`;
* `TauCeti.AlgebraicGeometry.curveIndexSubgroup`, `TauCeti.AlgebraicGeometry.curveIndex`: the
  subgroup generated by the degrees of `S`-rational effective divisors, and their gcd;
* `TauCeti.AlgebraicGeometry.curvePeriod_dvd_curveIndex`: the period divides the index;
* `TauCeti.AlgebraicGeometry.curveIndex_eq_one_of_comp_eq_id`,
  `TauCeti.AlgebraicGeometry.curvePeriod_eq_one_of_comp_eq_id`: both are `1` when `f` has a
  section;
* `TauCeti.AlgebraicGeometry.exists_section_picardComponent_iff`,
  `TauCeti.AlgebraicGeometry.mk_toTorsor_picardComponent_eq_one_iff`: `Picᵈ_{X/S}` has a section,
  equivalently is the trivial torsor, exactly when the period divides `d`.

## References

* B. Poonen, M. Stoll, *The Cassels–Tate pairing on polarized abelian varieties*, Ann. of Math.
  150 (1999), Sections 2 and 8.
* J. S. Milne, *Abelian varieties*, Part III, Remark 1.11.
-/

public section

open CategoryTheory Limits Opposite

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry

universe w u

noncomputable section

variable {S X : Scheme.{u}} (f : X ⟶ S)

section Index

variable [IsProper f] [RelativeDimensionLE 1 f]

/-- The **subgroup generated by the degrees of the `S`-rational effective divisors** of a proper
family of curves `f : X ⟶ S`: the subgroup of `ℤ` generated by the degrees `d` for which `X` has a
relative effective Cartier divisor of degree `d` over `S`. -/
def curveIndexSubgroup : AddSubgroup ℤ :=
  AddSubgroup.closure (Nat.cast ''
    {d : ℕ | ((relativeEffectiveCartierDegreeSubfunctor f d).obj (op (Over.mk (𝟙 S)))).Nonempty})

/-- The degree of a relative effective Cartier divisor on `X` over `S` lies in
`curveIndexSubgroup f`. -/
theorem natCast_mem_curveIndexSubgroup {d : ℕ}
    (h : ((relativeEffectiveCartierDegreeSubfunctor f d).obj (op (Over.mk (𝟙 S)))).Nonempty) :
    (d : ℤ) ∈ curveIndexSubgroup f :=
  AddSubgroup.subset_closure ⟨d, h, rfl⟩

/-- The **index** of a proper family of curves `f : X ⟶ S`: the gcd of the degrees of its
`S`-rational effective divisors, the relative effective Cartier divisors on `X` over `S`, defined
as the index of the subgroup `curveIndexSubgroup f` of `ℤ` they generate. It is `0` when `X` has
no such divisor of positive degree. -/
def curveIndex : ℕ :=
  (curveIndexSubgroup f).index

/-- The index divides the degree of every relative effective Cartier divisor on `X` over `S`. -/
theorem curveIndex_dvd {d : ℕ}
    (h : ((relativeEffectiveCartierDegreeSubfunctor f d).obj (op (Over.mk (𝟙 S)))).Nonempty) :
    curveIndex f ∣ d := by
  have := (AddSubgroup.zsmul_mem_iff_index_dvd _ Int.zmultiples_one d).1
    (by simpa only [smul_eq_mul, mul_one] using natCast_mem_curveIndexSubgroup f h)
  exact Int.natCast_dvd_natCast.mp this

end Index

section Period

variable [IsProper f] [SmoothOfRelativeDimension 1 f] [GeometricallyConnected f]

/-- The **degrees of the `S`-rational divisor classes** of a smooth proper geometrically connected
family of curves `f : X ⟶ S`: the integers `d` for which the degree-`d` component `Picᵈ_{X/S}` of
the relative Picard fppf sheaf has a section over `S`. They form a subgroup of `ℤ`, since degrees
add. -/
def curvePeriodSubgroup : AddSubgroup ℤ where
  carrier := {d | ((relativePicardDegreeFppfSubfunctor f d).obj (op (Over.mk (𝟙 S)))).Nonempty}
  zero_mem' := ⟨0, zero_mem_relativePicardDegreeFppfSubfunctor_obj f _⟩
  add_mem' := fun ⟨_, hσ⟩ ⟨_, hτ⟩ ↦ ⟨_, add_mem_relativePicardDegreeFppfSubfunctor_obj f hσ hτ⟩
  neg_mem' := fun ⟨_, hσ⟩ ↦ ⟨_, neg_mem_relativePicardDegreeFppfSubfunctor_obj f hσ⟩

/-- An integer `d` is the degree of an `S`-rational divisor class exactly when `Picᵈ_{X/S}` has a
section over `S`. -/
@[simp]
theorem mem_curvePeriodSubgroup_iff {d : ℤ} :
    d ∈ curvePeriodSubgroup f ↔
      ((relativePicardDegreeFppfSubfunctor f d).obj (op (Over.mk (𝟙 S)))).Nonempty :=
  Iff.rfl

/-- The **period** of a smooth proper geometrically connected family of curves `f : X ⟶ S`: the
gcd of the degrees of its `S`-rational divisor classes, defined as the index of the subgroup
`curvePeriodSubgroup f` of `ℤ` they form. It is `0` when the only such degree is `0`. -/
def curvePeriod : ℕ :=
  (curvePeriodSubgroup f).index

/-- **The period divides exactly the degrees of the `S`-rational divisor classes**: it divides `d`
if and only if `Picᵈ_{X/S}` has a section over `S`. -/
theorem curvePeriod_dvd_iff {d : ℤ} :
    (curvePeriod f : ℤ) ∣ d ↔
      ((relativePicardDegreeFppfSubfunctor f d).obj (op (Over.mk (𝟙 S)))).Nonempty := by
  rw [← mem_curvePeriodSubgroup_iff, curvePeriod]
  simpa only [smul_eq_mul, mul_one] using
    (AddSubgroup.zsmul_mem_iff_index_dvd _ Int.zmultiples_one d).symm

/-- **The class of a divisor has its degree**: the degrees of `S`-rational effective divisors are
degrees of `S`-rational divisor classes. -/
theorem curveIndexSubgroup_le_curvePeriodSubgroup :
    curveIndexSubgroup f ≤ curvePeriodSubgroup f := by
  rw [curveIndexSubgroup, AddSubgroup.closure_le]
  rintro _ ⟨d, ⟨D, hD⟩, rfl⟩
  exact ⟨_, relativePicardToFppfSheaf_app_mem_relativePicardDegreeFppfSubfunctor_of_mem f hD⟩

/-- **The period divides the index** (Poonen–Stoll, Section 8): the gcd of the degrees of the
`S`-rational divisor classes divides the gcd of the degrees of the `S`-rational divisors. -/
theorem curvePeriod_dvd_curveIndex : curvePeriod f ∣ curveIndex f :=
  AddSubgroup.index_dvd_of_le (curveIndexSubgroup_le_curvePeriodSubgroup f)

omit [GeometricallyConnected f] in
/-- A family of curves with a section `x₀` has index `1`: the section is a relative effective
Cartier divisor of degree one. -/
theorem curveIndex_eq_one_of_comp_eq_id (x₀ : S ⟶ X) (hx₀ : x₀ ≫ f = 𝟙 S) :
    curveIndex f = 1 :=
  Nat.dvd_one.mp (curveIndex_dvd f ⟨_,
    (relativeEffectiveCartierDegreeOneSection f x₀ hx₀ (op (Over.mk (𝟙 S)))).property⟩)

/-- A family of curves with a section has period `1`, so that every `Picᵈ_{X/S}` has a section
over `S`. -/
theorem curvePeriod_eq_one_of_comp_eq_id (x₀ : S ⟶ X) (hx₀ : x₀ ≫ f = 𝟙 S) :
    curvePeriod f = 1 :=
  Nat.dvd_one.mp (curveIndex_eq_one_of_comp_eq_id f x₀ hx₀ ▸ curvePeriod_dvd_curveIndex f)

end Period

section Torsor

variable [IsProper f] [SmoothOfRelativeDimension 1 f] [GeometricallyConnected f]
  (d : ℤ) [HasPicardComponent f d]

/-- **`Picᵈ_{X/S}` has a section exactly when the period divides `d`** (Poonen–Stoll, Section 2):
the sections of `picardComponent f d` over `S` are the `S`-rational divisor classes of degree `d`.
-/
theorem exists_section_picardComponent_iff :
    (∃ s : S ⟶ (picardComponent f d).left, s ≫ (picardComponent f d).hom = 𝟙 S) ↔
      (curvePeriod f : ℤ) ∣ d := by
  rw [curvePeriod_dvd_iff]
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨_, ((picardComponentRepresentableBy f d).homEquiv (Over.homMk s hs)).property⟩
  · rintro ⟨σ, hσ⟩
    exact ⟨((picardComponentRepresentableBy f d).homEquiv.symm ⟨σ, hσ⟩).left,
      Over.w ((picardComponentRepresentableBy f d).homEquiv.symm ⟨σ, hσ⟩)⟩

/-- **`Picᵈ_{X/S}` is the trivial `Pic⁰_{X/S}`-torsor exactly when the period divides `d`**: the
class of the torsor `picardComponent f d` in `Sheaf.NonabelianH1` is trivial if and only if the
period of `f` divides `d`. -/
theorem mk_toTorsor_picardComponent_eq_one_iff [HasPicardComponent f 0] :
    Sheaf.NonabelianH1.mk
        (GrothendieckTopology.IsTorsor.toTorsor.{w} (isTorsor_picardComponent f d)) = 1 ↔
      (curvePeriod f : ℤ) ∣ d := by
  rw [GroupScheme.mk_toTorsor_eq_one_iff, exists_section_picardComponent_iff]

end Torsor

end

end TauCeti.AlgebraicGeometry
