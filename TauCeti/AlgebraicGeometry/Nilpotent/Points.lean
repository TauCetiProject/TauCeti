module

public import TauCeti.AlgebraicGeometry.Nilpotent.AdjointQuotient
import TauCeti.AlgebraicGeometry.Scheme.SpecOver

/-!
# Points of the nilpotent cone

A point over a commutative test algebra is a vector in the affine Lie algebra on which the
defining ideal of the cone vanishes. This description uses the ideal generated by the
invariants vanishing at the origin, and applies to test algebras with nilpotents.
Over an algebraically closed field of characteristic zero, the rational points for a connected
group with nondegenerate Killing form are the ad-nilpotent elements of its Lie algebra.
-/

public section

open AlgebraicGeometry CategoryTheory

namespace TauCeti

universe u

variable (k : Type u) [Field k] (H : Type u) [CommRing H] [HopfAlgebra k H]
  [Module.Finite k (Bialgebra.CotangentSpace k H)]

local notation "𝔤" => Module.Dual k (Bialgebra.CotangentSpace k H)
local notation "P" => SymmetricAlgebra k (Module.Dual k 𝔤)
local notation "I" => nilpotentConeIdeal k H

variable {A : Type u} [CommRing A] [Algebra k A]

/-- The points of the nilpotent cone over a test algebra are the vectors on which its
defining ideal vanishes. A vector is specified by its values on the linear functions. -/
noncomputable def nilpotentConePointEquiv :
    {f : Spec (.of A) ⟶ nilpotentCone k H // f.IsOver (Spec (.of k))} ≃
      {x : Module.Dual k 𝔤 →ₗ[k] A // I ≤ RingHom.ker (SymmetricAlgebra.lift x)} :=
  TauCeti.AlgebraicGeometry.specOverHomEquivAlgHom.trans
    { toFun := fun f ↦ ⟨SymmetricAlgebra.lift.symm (f.comp (Ideal.Quotient.mkₐ k I)), by
        rw [Equiv.apply_symm_apply]
        intro p hp
        rw [RingHom.mem_ker, AlgHom.comp_apply]
        simp only [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem.mpr hp, map_zero]⟩
      invFun := fun x ↦ Ideal.Quotient.liftₐ I (SymmetricAlgebra.lift x.val)
        (fun _ hp ↦ RingHom.mem_ker.mp (x.property hp))
      left_inv := by
        intro f
        apply Ideal.Quotient.algHom_ext
        dsimp only
        rw [Ideal.Quotient.liftₐ_comp, Equiv.apply_symm_apply]
      right_inv := by
        intro x
        apply Subtype.ext
        dsimp only
        rw [Ideal.Quotient.liftₐ_comp, Equiv.symm_apply_apply] }

/-- The cone inclusion evaluates polynomial functions by the symmetric algebra lift of the
point's linear coordinates, then transports the point to the tangent scheme. -/
@[reassoc]
theorem nilpotentConePointEquiv_comp_ι
    (f : {f : Spec (.of A) ⟶ nilpotentCone k H // f.IsOver (Spec (.of k))}) :
    f.val ≫ nilpotentConeι k H = Spec.map (CommRingCat.ofHom
      (SymmetricAlgebra.lift (nilpotentConePointEquiv k H f).val).toRingHom) ≫
        (lieAlgebraSchemeIso k H).inv := by
  rw [nilpotentConePointEquiv, Equiv.trans_apply]
  simp only [Equiv.coe_fn_mk, Equiv.apply_symm_apply]
  rw [AlgHom.toRingHom_eq_coe, AlgHom.comp_toRingHom, CommRingCat.ofHom_comp, Spec.map_comp,
    TauCeti.AlgebraicGeometry.spec_map_specOverHomEquivAlgHom, nilpotentConeι_eq,
    ← Ideal.Quotient.mkₐ_toRingHom k I, Category.assoc]
  rw [AlgHom.toRingHom_eq_coe]

/-- The cone point attached to a vector is the spectrum of evaluation factored through
the full coordinate ideal. -/
@[simp]
theorem nilpotentConePointEquiv_symm_apply
    (x : {x : Module.Dual k 𝔤 →ₗ[k] A // I ≤ RingHom.ker (SymmetricAlgebra.lift x)}) :
    ((nilpotentConePointEquiv k H).symm x).val = Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.liftₐ I (SymmetricAlgebra.lift x.val)
        (fun _ hp ↦ RingHom.mem_ker.mp (x.property hp))).toRingHom) := by
  rw [nilpotentConePointEquiv, Equiv.symm_trans_apply]
  exact TauCeti.AlgebraicGeometry.coe_specOverHomEquivAlgHom_symm_apply _

section Rational

variable {k : Type u} [Field k] [CharZero k] [IsAlgClosed k]
  (G : FiniteTypeCommHopfAlgCat.{u, u} k) [ConnectedSpace (PrimeSpectrum G)]

local notation "𝔤₀" => Module.Dual k (Bialgebra.CotangentSpace k G)

/-- Over an algebraically closed field of characteristic zero, the rational points of the
cone of a connected group with nondegenerate Killing form are its ad-nilpotent vectors. -/
noncomputable def nilpotentConeRationalPointEquiv [LieAlgebra.IsKilling k 𝔤₀] :
    {f : Spec (.of k) ⟶ nilpotentCone k G // f.IsOver (Spec (.of k))} ≃
      {x : 𝔤₀ // IsNilpotent (LieAlgebra.ad k 𝔤₀ x)} :=
  (nilpotentConePointEquiv k G).trans <|
    (Module.evalEquiv k 𝔤₀).toEquiv.symm.subtypeEquiv fun x ↦ by
      have h : Module.Dual.eval k 𝔤₀ ((Module.evalEquiv k 𝔤₀).symm x) = x :=
        (Module.evalEquiv k 𝔤₀).apply_symm_apply x
      simpa only [h, LinearEquiv.coe_symm_toEquiv] using (nilpotentConeIdeal_le_ker_lift_eval_iff
        (k := k) (H := G) (x := (Module.evalEquiv k 𝔤₀).symm x))

/-- The vector corresponding to a rational point evaluates precisely its linear coordinates. -/
@[simp]
theorem nilpotentConeRationalPointEquiv_eval [LieAlgebra.IsKilling k 𝔤₀]
    (f : {f : Spec (.of k) ⟶ nilpotentCone k G // f.IsOver (Spec (.of k))}) :
    Module.Dual.eval k 𝔤₀ (nilpotentConeRationalPointEquiv G f).val =
      (nilpotentConePointEquiv k G f).val := by
  simp only [nilpotentConeRationalPointEquiv, Equiv.trans_apply, Equiv.subtypeEquiv_apply,
    LinearEquiv.coe_symm_toEquiv]
  exact (Module.evalEquiv k 𝔤₀).apply_symm_apply _

end Rational

end TauCeti
