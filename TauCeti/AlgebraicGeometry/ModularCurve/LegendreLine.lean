/-!
# The Legendre line over the `j`-line

The **Legendre line** over a commutative ring `R` is `Λ = Spec R[λ, (λ (λ - 1))⁻¹]`, the base of the
Legendre family `y² = x (x - 1) (x - λ)`. Its `j`-invariant is

  `j = 2⁸ (λ² - λ + 1)³ / (λ² (λ - 1)²) = 2⁸ u`,  `u = (λ² - λ + 1)³ / (λ² (λ - 1)²)`.

This file shows that `R[λ, (λ (λ - 1))⁻¹]` is a free module of rank six over the polynomial ring
`R[u]`, and that, when `6` is a nonzerodivisor of `R`, the `R[u]`-algebra invariants of the six
substitutions `λ ↦ λ, 1 - λ, 1 / λ, 1 / (1 - λ), (λ - 1) / λ, λ / (λ - 1)` are exactly `R[u]`.
When `2` is invertible in `R`, the ring `R[u]` is the polynomial ring `R[j]` of the `j`-line, so
the Legendre line is a finite free cover of degree six of the `j`-line, with the anharmonic group
of these six substitutions acting on the fibres and having the `j`-line as its ring of invariants.
This is the ring-theoretic input for identifying the coarse `j`-line away from `2` through the
Legendre family (Katz–Mazur 8.2.1).

## The presentation over `R[u]`

Put `d = λ (λ - 1)` and `f = λ² - λ + 1 = d + 1`. The defining identity `f³ = u d²` says that `λ`
is a root of the polynomial `(T² - T + 1)³ - u T² (T - 1)²` over `R[u]`, which is monic of degree
six (`TauCeti.legendreRelation`). Conversely, in `R[u][T] / ((T² - T + 1)³ - u T² (T - 1)²)` the
identity `(d + 1)³ = u d²` rearranges to `d (u d - d² - 3 d - 3) = 1`, so `d` is already a unit.
The Legendre ring is therefore *defined* as this quotient (`TauCeti.LegendreRing`), which makes it
free with basis `1, λ, …, λ⁵` over `R[u]`, and it is identified with the localization
`R[λ][(λ (λ - 1))⁻¹]` by its universal property (`TauCeti.LegendreRing.lift`,
`TauCeti.LegendreRing.equivLocalization`).

## The invariants

The substitutions `λ ↦ 1 - λ` and `λ ↦ 1 / λ` fix `u`, and generate the anharmonic group, whose
elements are the six substitutions above (`TauCeti.LegendreRing.mem_anharmonicGroup_iff`). Its
orbit of `λ` is `{r, 1 - r}` for `r ∈ {λ, 1 / λ, 1 / (1 - λ)}`, and the three products
`s = r (1 - r)` satisfy

  `∑ s = 3 - u`,  `∑ s² = u² - 6 u + 3`.

Since `r ^ k + (1 - r) ^ k` is a polynomial of degree at most two in `s` for `k ≤ 5`, the sum of
the orbit of every basis vector `λ ^ k` lies in `R[u]`, and so does the orbit sum of every element.
An invariant `a` has orbit sum `6 a`; comparing coefficients in the basis `1, λ, …, λ⁵` shows that
`a ∈ R[u]` once `6` is a nonzerodivisor.

## Main definitions and results

* `TauCeti.legendreRelation`: the monic sextic `(T² - T + 1)³ - u T² (T - 1)²` over `R[u]`.
* `TauCeti.LegendreRing`: the coordinate ring of the Legendre line, as an `R[u]`-algebra.
* `TauCeti.finrank_legendreRing`: it is free of rank six over `R[u]`.
* `TauCeti.LegendreRing.lift`, `TauCeti.LegendreRing.algHom_ext`: its universal property;
  `R`-algebra maps to `S` are elements `x` of `S` with `x` and `x - 1` units.
* `TauCeti.LegendreRing.equivLocalization`: it is the localization `R[λ][(λ (λ - 1))⁻¹]`.
* `TauCeti.LegendreRing.anharmonicGroup`: the group generated by `λ ↦ 1 - λ` and `λ ↦ 1 / λ`.
* `TauCeti.LegendreRing.mem_anharmonicGroup_iff`: its elements are the six substitutions.
* `TauCeti.LegendreRing.isInvariant_anharmonicGroup`: its invariants are `R[u]`.
* `TauCeti.LegendreRing.freyCurve_one_neg_lambda_j`: the Legendre curve `freyCurve 1 (-λ)` has
  `j = 2⁸ u`.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, 8.2.1.
* [J. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], III.1.7.
-/

public section

open Polynomial

namespace TauCeti

variable (R : Type*) [CommRing R]

/-- The **Legendre relation** `(T² - T + 1)³ - u T² (T - 1)²` over the polynomial ring `R[u]`. Its
root `T = λ` and the coordinate `u = (λ² - λ + 1)³ / (λ² (λ - 1)²) = j / 2⁸` present the
coordinate ring of the Legendre line over the `u`-line. -/
noncomputable def legendreRelation : R[X][X] :=
  (X ^ 2 - X + 1) ^ 3 - C X * (X ^ 2 * (X - 1) ^ 2)

/-- The Legendre relation is monic in `T`: the term `u T² (T - 1)²` has degree four. -/
theorem monic_legendreRelation : (legendreRelation R).Monic := by
  unfold legendreRelation
  monicity!

/-- The Legendre relation has degree six in `T`. -/
theorem natDegree_legendreRelation [Nontrivial R] : (legendreRelation R).natDegree = 6 := by
  unfold legendreRelation
  compute_degree!

/-- The coordinate ring `R[λ, (λ (λ - 1))⁻¹]` of the **Legendre line** over `R`, presented as the
`R[u]`-algebra `R[u][λ] / ((λ² - λ + 1)³ - u λ² (λ - 1)²)`, where `u = j / 2⁸`. It is the
localization of `R[λ]` away from `λ (λ - 1)` (`TauCeti.LegendreRing.equivLocalization`). -/
def LegendreRing : Type _ :=
  AdjoinRoot (legendreRelation R)

noncomputable instance : CommRing (LegendreRing R) :=
  inferInstanceAs (CommRing (AdjoinRoot (legendreRelation R)))

noncomputable instance : Algebra R[X] (LegendreRing R) :=
  inferInstanceAs (Algebra R[X] (AdjoinRoot (legendreRelation R)))

noncomputable instance : Algebra R (LegendreRing R) :=
  inferInstanceAs (Algebra R (AdjoinRoot (legendreRelation R)))

instance : IsScalarTower R R[X] (LegendreRing R) :=
  inferInstanceAs (IsScalarTower R R[X] (AdjoinRoot (legendreRelation R)))

/-- The Legendre ring is free over `R[u]`, with basis `1, λ, …, λ⁵`. -/
instance : Module.Free R[X] (LegendreRing R) :=
  (monic_legendreRelation R).free_adjoinRoot

instance : Module.Finite R[X] (LegendreRing R) :=
  (monic_legendreRelation R).finite_adjoinRoot

/-- The Legendre line is a cover of degree six of the `u`-line. -/
theorem finrank_legendreRing [Nontrivial R] : Module.finrank R[X] (LegendreRing R) = 6 := by
  rw [← natDegree_legendreRelation R]
  exact (AdjoinRoot.isAdjoinRootMonic _ (monic_legendreRelation R)).finrank

namespace LegendreRing

/-- The coordinate `λ` of the Legendre line. -/
noncomputable def lambda : LegendreRing R :=
  AdjoinRoot.root _

/-- The defining identity `(λ² - λ + 1)³ = u (λ (λ - 1))²` of the coordinate `u` of the `u`-line,
pulled back to the Legendre line. -/
@[simp]
theorem lambda_sq_sub_lambda_add_one_pow_three :
    (lambda R ^ 2 - lambda R + 1) ^ 3 =
      algebraMap R[X] (LegendreRing R) X * (lambda R * (lambda R - 1)) ^ 2 := by
  have h : aeval (lambda R) (legendreRelation R) = 0 := AdjoinRoot.eval₂_root _
  simp only [legendreRelation, map_sub, map_pow, map_add, map_mul, aeval_X, map_one, aeval_C] at h
  linear_combination h

theorem isUnit_lambda_mul_lambda_sub_one : IsUnit (lambda R * (lambda R - 1)) := by
  refine IsUnit.of_mul_eq_one (algebraMap R[X] (LegendreRing R) X * (lambda R * (lambda R - 1)) -
    (lambda R * (lambda R - 1)) ^ 2 - 3 * (lambda R * (lambda R - 1)) - 3) ?_
  linear_combination -lambda_sq_sub_lambda_add_one_pow_three R

theorem isUnit_lambda : IsUnit (lambda R) :=
  isUnit_of_mul_isUnit_left (isUnit_lambda_mul_lambda_sub_one R)

theorem isUnit_lambda_sub_one : IsUnit (lambda R - 1) :=
  isUnit_of_mul_isUnit_right (isUnit_lambda_mul_lambda_sub_one R)

section lift

variable {R} {S : Type*} [CommRing S] [Algebra R S]

/-- An `R`-algebra map out of the Legendre ring sends the coordinate `u` to
`(x² - x + 1)³ / (x (x - 1))²`, where `x` is the image of `λ`. -/
theorem map_algebraMap_X_mul (φ : LegendreRing R →ₐ[R] S) :
    φ (algebraMap R[X] (LegendreRing R) X) * (φ (lambda R) * (φ (lambda R) - 1)) ^ 2 =
      (φ (lambda R) ^ 2 - φ (lambda R) + 1) ^ 3 := by
  have h := congrArg φ (lambda_sq_sub_lambda_add_one_pow_three R)
  simp only [map_pow, map_add, map_sub, map_mul, map_one] at h
  exact h.symm

/-- The **universal property** of the Legendre line: an element `x` of an `R`-algebra `S` such that
`x` and `x - 1` are units determines an `R`-algebra map sending `λ` to `x`. -/
noncomputable def lift (x : S) (hx : IsUnit x) (hx₁ : IsUnit (x - 1)) :
    LegendreRing R →ₐ[R] S :=
  AdjoinRoot.liftAlgHom (legendreRelation R)
    (aeval ((x ^ 2 - x + 1) ^ 3 * ↑(hx.mul hx₁).unit⁻¹ ^ 2)) x (by
      have h := (hx.mul hx₁).mul_val_inv
      simp only [legendreRelation, eval₂_sub, eval₂_pow, eval₂_add, eval₂_mul, eval₂_X,
        eval₂_one, eval₂_C, AlgHom.coe_toRingHom, aeval_X]
      linear_combination (-(x ^ 2 - x + 1) ^ 3 * (x * (x - 1) * ↑(hx.mul hx₁).unit⁻¹ + 1)) * h)

@[simp]
theorem lift_lambda (x : S) (hx : IsUnit x) (hx₁ : IsUnit (x - 1)) :
    lift (R := R) x hx hx₁ (lambda R) = x :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

/-- The map `TauCeti.LegendreRing.lift` sends the coordinate `u` to
`(x² - x + 1)³ / (x (x - 1))²`. -/
@[simp]
theorem lift_algebraMap_X (x : S) (hx : IsUnit x) (hx₁ : IsUnit (x - 1)) :
    lift (R := R) x hx hx₁ (algebraMap R[X] (LegendreRing R) X) =
      (x ^ 2 - x + 1) ^ 3 * ↑(hx.mul hx₁).unit⁻¹ ^ 2 :=
  (AdjoinRoot.liftAlgHom_of _ _ _ _ X).trans (aeval_X _)

/-- Two `R`-algebra maps out of the Legendre ring agree once they agree on `λ`. -/
@[ext]
theorem algHom_ext {φ ψ : LegendreRing R →ₐ[R] S} (h : φ (lambda R) = ψ (lambda R)) : φ = ψ := by
  have hu : φ (algebraMap R[X] (LegendreRing R) X) = ψ (algebraMap R[X] (LegendreRing R) X) := by
    refine (((isUnit_lambda_mul_lambda_sub_one R).map φ).pow 2).mul_right_cancel ?_
    rw [map_mul φ, map_sub, map_one, map_algebraMap_X_mul, h, ← map_algebraMap_X_mul ψ]
  exact AdjoinRoot.algHom_ext' (Polynomial.algHom_ext hu) h

omit [Algebra R S] in
/-- Two `R[u]`-algebra maps out of the Legendre ring agree once they agree on `λ`. -/
@[ext]
theorem algHom_ext' [Algebra R[X] S] {φ ψ : LegendreRing R →ₐ[R[X]] S}
    (h : φ (lambda R) = ψ (lambda R)) : φ = ψ :=
  AdjoinRoot.algHom_ext h

end lift

/-- The Legendre ring is the localization `R[λ][(λ (λ - 1))⁻¹]` of the polynomial ring in `λ`. -/
noncomputable def equivLocalization :
    LegendreRing R ≃ₐ[R] Localization.Away (X * (X - 1) : R[X]) :=
  have hX : IsUnit (algebraMap R[X] (Localization.Away (X * (X - 1) : R[X])) X *
      (algebraMap R[X] (Localization.Away (X * (X - 1) : R[X])) X - 1)) := by
    have := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (X * (X - 1) : R[X]))
      (X * (X - 1) : R[X])
    rwa [map_mul, map_sub, map_one] at this
  AlgEquiv.ofAlgHom (lift _ (isUnit_of_mul_isUnit_left hX) (isUnit_of_mul_isUnit_right hX))
    (IsLocalization.Away.liftAlgHom (X * (X - 1) : R[X]) (f := aeval (lambda R))
      (by simpa using isUnit_lambda_mul_lambda_sub_one R))
    (AlgHom.toRingHom_injective <| IsLocalization.ringHom_ext (.powers (X * (X - 1) : R[X])) <|
      Polynomial.ringHom_ext
        (fun r ↦ by
          simp [IsScalarTower.algebraMap_apply R R[X] (Localization.Away (X * (X - 1) : R[X]))])
        (by simp))
    (algHom_ext (by simp))

@[simp]
theorem equivLocalization_lambda :
    equivLocalization R (lambda R) =
      algebraMap R[X] (Localization.Away (X * (X - 1) : R[X])) X := by
  simp [equivLocalization]

@[simp]
theorem equivLocalization_symm_algebraMap_X :
    (equivLocalization R).symm (algebraMap R[X] (Localization.Away (X * (X - 1) : R[X])) X) =
      lambda R :=
  (equivLocalization R).symm_apply_eq.mpr (equivLocalization_lambda R).symm

/-- The identification `TauCeti.LegendreRing.equivLocalization` sends the coordinate `u` to
`(λ² - λ + 1)³ / (λ (λ - 1))²`. -/
theorem equivLocalization_algebraMap_X :
    equivLocalization R (algebraMap R[X] (LegendreRing R) X) =
      IsLocalization.mk' (Localization.Away (X * (X - 1) : R[X])) ((X ^ 2 - X + 1) ^ 3 : R[X])
        (⟨(X * (X - 1)) ^ 2, 2, rfl⟩ : Submonoid.powers (X * (X - 1) : R[X])) := by
  rw [IsLocalization.eq_mk'_iff_mul_eq]
  simpa using map_algebraMap_X_mul (equivLocalization R).toAlgHom

section anharmonic

/-- The substitution `λ ↦ 1 - λ`, as an `R`-algebra endomorphism. -/
private noncomputable def oneSubAlgHom : LegendreRing R →ₐ[R] LegendreRing R :=
  lift (1 - lambda R) (by rw [← neg_sub]; exact (isUnit_lambda_sub_one R).neg)
    (by rw [sub_sub_cancel_left]; exact (isUnit_lambda R).neg)

private theorem oneSubAlgHom_lambda : oneSubAlgHom R (lambda R) = 1 - lambda R :=
  lift_lambda _ _ _

private theorem oneSubAlgHom_algebraMap_X :
    oneSubAlgHom R (algebraMap R[X] (LegendreRing R) X) = algebraMap R[X] (LegendreRing R) X := by
  refine ((isUnit_lambda_mul_lambda_sub_one R).pow 2).mul_right_cancel ?_
  have h := map_algebraMap_X_mul (oneSubAlgHom R)
  rw [oneSubAlgHom_lambda] at h
  linear_combination h + lambda_sq_sub_lambda_add_one_pow_three R

private theorem oneSubAlgHom_comp_oneSubAlgHom :
    ((oneSubAlgHom R).toPolynomialAlgHom (oneSubAlgHom_algebraMap_X R)).comp
      ((oneSubAlgHom R).toPolynomialAlgHom (oneSubAlgHom_algebraMap_X R)) = AlgHom.id R[X] _ :=
  algHom_ext' (by simp [oneSubAlgHom_lambda])

/-- The substitution `λ ↦ λ⁻¹`, as an `R`-algebra endomorphism. -/
private noncomputable def invAlgHom : LegendreRing R →ₐ[R] LegendreRing R :=
  lift (↑(isUnit_lambda R).unit⁻¹) (Units.isUnit _) (by
    have h : (↑(isUnit_lambda R).unit⁻¹ : LegendreRing R) - 1 =
        -(↑(isUnit_lambda R).unit⁻¹ * (lambda R - 1)) := by
      linear_combination (isUnit_lambda R).val_inv_mul
    rw [h]
    exact ((Units.isUnit _).mul (isUnit_lambda_sub_one R)).neg)

private theorem invAlgHom_lambda : invAlgHom R (lambda R) = ↑(isUnit_lambda R).unit⁻¹ := by
  rw [invAlgHom, lift_lambda]

private theorem lambda_mul_invAlgHom_lambda : lambda R * invAlgHom R (lambda R) = 1 := by
  rw [invAlgHom_lambda]
  exact (isUnit_lambda R).mul_val_inv

private theorem invAlgHom_algebraMap_X :
    invAlgHom R (algebraMap R[X] (LegendreRing R) X) = algebraMap R[X] (LegendreRing R) X := by
  set l := lambda R
  set i := invAlgHom R l
  set u := algebraMap R[X] (LegendreRing R) X
  have hi : l * i = 1 := lambda_mul_invAlgHom_lambda R
  have h : invAlgHom R u * (i * (i - 1)) ^ 2 = (i ^ 2 - i + 1) ^ 3 := map_algebraMap_X_mul _
  have e₁ : l ^ 2 * (i * (i - 1)) = -(l - 1) := by linear_combination (l * i + 1 - l) * hi
  have e₂ : l ^ 2 * (i ^ 2 - i + 1) = l ^ 2 - l + 1 := by linear_combination (l * i + 1 - l) * hi
  refine ((isUnit_lambda_mul_lambda_sub_one R).pow 2).mul_right_cancel ?_
  calc invAlgHom R u * (l * (l - 1)) ^ 2
      = invAlgHom R u * (l ^ 2 * (i * (i - 1))) ^ 2 * l ^ 2 := by rw [e₁]; ring
    _ = l ^ 6 * (invAlgHom R u * (i * (i - 1)) ^ 2) := by ring
    _ = (l ^ 2 * (i ^ 2 - i + 1)) ^ 3 := by rw [h]; ring
    _ = u * (l * (l - 1)) ^ 2 := by rw [e₂]; exact lambda_sq_sub_lambda_add_one_pow_three R

private theorem invAlgHom_comp_invAlgHom :
    ((invAlgHom R).toPolynomialAlgHom (invAlgHom_algebraMap_X R)).comp
      ((invAlgHom R).toPolynomialAlgHom (invAlgHom_algebraMap_X R)) = AlgHom.id R[X] _ := by
  refine algHom_ext' ?_
  simp only [AlgHom.comp_apply, AlgHom.toPolynomialAlgHom_apply, AlgHom.id_apply]
  set i := invAlgHom R (lambda R)
  have hi : lambda R * i = 1 := lambda_mul_invAlgHom_lambda R
  have h₁ : i * invAlgHom R i = 1 := by
    have := congrArg (invAlgHom R) hi
    rwa [map_mul, map_one] at this
  linear_combination lambda R * h₁ - invAlgHom R i * hi

/-- The substitution `λ ↦ 1 - λ`, an involution of the Legendre ring over the `u`-line. -/
noncomputable def oneSubAut : LegendreRing R ≃ₐ[R[X]] LegendreRing R :=
  AlgEquiv.ofAlgHom _ _ (oneSubAlgHom_comp_oneSubAlgHom R) (oneSubAlgHom_comp_oneSubAlgHom R)

/-- The substitution `λ ↦ λ⁻¹`, an involution of the Legendre ring over the `u`-line. -/
noncomputable def invAut : LegendreRing R ≃ₐ[R[X]] LegendreRing R :=
  AlgEquiv.ofAlgHom _ _ (invAlgHom_comp_invAlgHom R) (invAlgHom_comp_invAlgHom R)

@[simp]
theorem oneSubAut_lambda : oneSubAut R (lambda R) = 1 - lambda R := by
  simp [oneSubAut, oneSubAlgHom_lambda]

@[simp]
theorem invAut_lambda : invAut R (lambda R) = ↑(isUnit_lambda R).unit⁻¹ := by
  simp [invAut, invAlgHom_lambda]

theorem lambda_mul_invAut_lambda : lambda R * invAut R (lambda R) = 1 := by
  simp

@[simp]
theorem oneSubAut_oneSubAut (a : LegendreRing R) : oneSubAut R (oneSubAut R a) = a :=
  congr($(oneSubAlgHom_comp_oneSubAlgHom R) a)

@[simp]
theorem invAut_invAut (a : LegendreRing R) : invAut R (invAut R a) = a :=
  congr($(invAlgHom_comp_invAlgHom R) a)

/-- The **anharmonic group**: the group of automorphisms of the Legendre ring over the `u`-line
generated by `λ ↦ 1 - λ` and `λ ↦ 1 / λ`. Its elements are the six substitutions
`λ ↦ λ, 1 - λ, 1 / λ, 1 / (1 - λ), (λ - 1) / λ, λ / (λ - 1)`
(`TauCeti.LegendreRing.mem_anharmonicGroup_iff`), which coincide when `R` is the zero ring. -/
noncomputable def anharmonicGroup : Subgroup (LegendreRing R ≃ₐ[R[X]] LegendreRing R) :=
  Subgroup.closure {oneSubAut R, invAut R}

theorem oneSubAut_mem_anharmonicGroup : oneSubAut R ∈ anharmonicGroup R :=
  Subgroup.subset_closure (Set.mem_insert _ _)

theorem invAut_mem_anharmonicGroup : invAut R ∈ anharmonicGroup R :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)

/-- The involutions `σ : λ ↦ 1 - λ` and `τ : λ ↦ 1 / λ` satisfy the braid relation
`σ τ σ = τ σ τ`: both send `λ` to `λ / (λ - 1)`. -/
theorem oneSubAut_mul_invAut_mul_oneSubAut :
    oneSubAut R * invAut R * oneSubAut R = invAut R * oneSubAut R * invAut R := by
  refine AlgEquiv.coe_toAlgHom_injective (algHom_ext' ?_)
  simp only [AlgEquiv.coe_toAlgHom, AlgEquiv.mul_apply, oneSubAut_lambda, map_sub, map_one]
  set l := lambda R
  set i := invAut R l
  set m := oneSubAut R i
  have hi : l * i = 1 := lambda_mul_invAut_lambda R
  have hm : m * (1 - l) = 1 := by
    simpa [l, m] using congrArg (oneSubAut R) ((mul_comm _ _).trans hi)
  have hτm : invAut R m * (1 - i) = 1 := by
    simpa [i, invAut_invAut] using congrArg (invAut R) hm
  refine (isUnit_lambda_mul_lambda_sub_one R).mul_right_cancel ?_
  linear_combination -(l ^ 2 * hτm + invAut R m * l * hi - l * hm)

/-- The anharmonic group consists of the six substitutions `1`, `σ`, `τ`, `σ τ`, `τ σ` and
`σ τ σ`, where `σ : λ ↦ 1 - λ` and `τ : λ ↦ 1 / λ`. They send `λ` to
`λ, 1 - λ, 1 / λ, 1 / (1 - λ), (λ - 1) / λ, λ / (λ - 1)` respectively. -/
theorem mem_anharmonicGroup_iff {g : LegendreRing R ≃ₐ[R[X]] LegendreRing R} :
    g ∈ anharmonicGroup R ↔ g = 1 ∨ g = oneSubAut R ∨ g = invAut R ∨
      g = oneSubAut R * invAut R ∨ g = invAut R * oneSubAut R ∨
      g = oneSubAut R * invAut R * oneSubAut R := by
  have hσ : oneSubAut R * oneSubAut R = 1 := AlgEquiv.ext (oneSubAut_oneSubAut R)
  have hτ : invAut R * invAut R = 1 := AlgEquiv.ext (invAut_invAut R)
  have hσ' (x : LegendreRing R ≃ₐ[R[X]] LegendreRing R) : x * oneSubAut R * oneSubAut R = x := by
    rw [mul_assoc, hσ, mul_one]
  have key : ∀ x ∈ ({oneSubAut R, invAut R} : Set (LegendreRing R ≃ₐ[R[X]] LegendreRing R)),
      ∀ y, (y = 1 ∨ y = oneSubAut R ∨ y = invAut R ∨ y = oneSubAut R * invAut R ∨
        y = invAut R * oneSubAut R ∨ y = oneSubAut R * invAut R * oneSubAut R) →
      x * y = 1 ∨ x * y = oneSubAut R ∨ x * y = invAut R ∨ x * y = oneSubAut R * invAut R ∨
        x * y = invAut R * oneSubAut R ∨ x * y = oneSubAut R * invAut R * oneSubAut R := by
    rintro x (rfl | rfl) y (rfl | rfl | rfl | rfl | rfl | rfl) <;>
      simp only [← mul_assoc, mul_one, hσ, hτ, hσ',
        ← oneSubAut_mul_invAut_mul_oneSubAut R, one_mul, true_or, or_true]
  constructor
  · intro hg
    induction hg using Subgroup.closure_induction_left with
    | one => exact Or.inl rfl
    | mul_left x hx y _ ih => exact key x hx y ih
    | inv_mul_cancel x hx y _ ih =>
      rcases hx with rfl | rfl
      · rw [inv_eq_of_mul_eq_one_right hσ]
        exact key _ (Set.mem_insert _ _) y ih
      · rw [inv_eq_of_mul_eq_one_right hτ]
        exact key _ (Set.mem_insert_of_mem _ rfl) y ih
  · have := oneSubAut_mem_anharmonicGroup R
    have := invAut_mem_anharmonicGroup R
    rintro (rfl | rfl | rfl | rfl | rfl | rfl) <;> simp only [one_mem, mul_mem, *]

instance : Finite (anharmonicGroup R) :=
  Set.Finite.to_subtype <| (Set.toFinite {1, oneSubAut R, invAut R, oneSubAut R * invAut R,
    invAut R * oneSubAut R, oneSubAut R * invAut R * oneSubAut R}).subset fun _ hg ↦ by
      simpa using (mem_anharmonicGroup_iff R).mp hg

/-- The sum of a point of the Legendre ring over the six substitutions `1`, `σ`, `τ`, `τ σ`, `σ τ`,
`σ τ σ` of the anharmonic group, counted with multiplicity. -/
private noncomputable def orbitSum : LegendreRing R →ₗ[R[X]] LegendreRing R :=
  let σ := (oneSubAut R).toLinearMap
  let τ := (invAut R).toLinearMap
  LinearMap.id + σ + τ + τ ∘ₗ σ + σ ∘ₗ τ + σ ∘ₗ τ ∘ₗ σ

/-- The three products `s = r (1 - r)`, `r ∈ {λ, 1 / λ, 1 / (1 - λ)}`, have sum `3 - u` and sum
of squares `u² - 6 u + 3`. -/
private theorem sum_and_sum_sq_eq :
    let l := lambda R
    let i := invAut R l
    let m := oneSubAut R i
    let u := algebraMap R[X] (LegendreRing R) X
    l * (1 - l) + i * (1 - i) + m * (1 - m) = 3 - u ∧
      (l * (1 - l)) ^ 2 + (i * (1 - i)) ^ 2 + (m * (1 - m)) ^ 2 = u ^ 2 - 6 * u + 3 := by
  intro l i m u
  have hi : l * i = 1 := lambda_mul_invAut_lambda R
  have hm : m * (1 - l) = 1 := by
    simpa [l, m] using congrArg (oneSubAut R) ((mul_comm _ _).trans hi)
  have rel : (l ^ 2 - l + 1) ^ 3 = u * (l * (l - 1)) ^ 2 := lambda_sq_sub_lambda_add_one_pow_three R
  have h₂ : i * (1 - i) * (l * (l - 1)) ^ 2 = (l - 1) ^ 3 := by
    linear_combination (l - 1) ^ 2 * (l - l * i - 1) * hi
  have h₃ : m * (1 - m) * (l * (l - 1)) ^ 2 = -l ^ 3 := by
    linear_combination -l ^ 2 * (l + m * (1 - l)) * hm
  have hD := isUnit_lambda_mul_lambda_sub_one R
  refine ⟨(hD.pow 2).mul_right_cancel ?_, (hD.pow 4).mul_right_cancel ?_⟩
  · linear_combination h₂ + h₃ - rel
  · linear_combination (i * (1 - i) * (l * (l - 1)) ^ 2 + (l - 1) ^ 3) * h₂ +
      (m * (1 - m) * (l * (l - 1)) ^ 2 - l ^ 3) * h₃ +
      ((l ^ 2 - l + 1) ^ 3 + u * (l * (l - 1)) ^ 2 - 6 * (l * (l - 1)) ^ 2) * rel

private theorem orbitSum_lambda_pow_mem {k : ℕ} (hk : k < 6) :
    orbitSum R (lambda R ^ k) ∈ (1 : Submodule R[X] (LegendreRing R)) := by
  obtain ⟨h₁, h₂⟩ := sum_and_sum_sq_eq R
  set l := lambda R
  set i := invAut R l
  set m := oneSubAut R i
  set u := algebraMap R[X] (LegendreRing R) X
  have e : orbitSum R (l ^ k) =
      l ^ k + (1 - l) ^ k + i ^ k + (1 - i) ^ k + m ^ k + (1 - m) ^ k := by
    simp [orbitSum, l, i, m, map_sub]
  rw [e, Submodule.mem_one]
  interval_cases k
  · exact ⟨6, by rw [map_ofNat]; ring⟩
  · exact ⟨3, by rw [map_ofNat]; ring⟩
  · exact ⟨2 * X - 3, by simp only [map_sub, map_mul, map_ofNat]; linear_combination 2 * h₁⟩
  · exact ⟨3 * X - 6, by simp only [map_sub, map_mul, map_ofNat]; linear_combination 3 * h₁⟩
  · exact ⟨2 * X ^ 2 - 8 * X - 3, by
      simp only [map_sub, map_mul, map_pow, map_ofNat]; linear_combination 4 * h₁ - 2 * h₂⟩
  · exact ⟨5 * X ^ 2 - 25 * X + 3, by
      simp only [map_sub, map_add, map_mul, map_pow, map_ofNat]
      linear_combination 5 * h₁ - 5 * h₂⟩

/-- **The invariants of the anharmonic group.** If `6` is a nonzerodivisor of `R`, a point of the
Legendre ring fixed by the substitutions `λ ↦ 1 - λ` and `λ ↦ 1 / λ` lies in `R[u]`. Thus the
`u`-line, which is the `j`-line when `2` is invertible, is the quotient of the Legendre line by the
anharmonic group. -/
theorem isInvariant_anharmonicGroup (h6 : (6 : R) ∈ nonZeroDivisors R) :
    Algebra.IsInvariant R[X] (LegendreRing R) (anharmonicGroup R) := by
  refine ⟨fun a ha => ?_⟩
  have hσ : oneSubAut R a = a := ha ⟨_, oneSubAut_mem_anharmonicGroup R⟩
  have hτ : invAut R a = a := ha ⟨_, invAut_mem_anharmonicGroup R⟩
  rcases subsingleton_or_nontrivial R with hR | hR
  · have := Module.subsingleton R (LegendreRing R)
    exact ⟨0, Subsingleton.elim _ _⟩
  let pb : PowerBasis R[X] (LegendreRing R) := AdjoinRoot.powerBasis' (monic_legendreRelation R)
  have hdim : pb.dim = 6 := natDegree_legendreRelation R
  -- The orbit sum of `a` is `6 a`, and it lies in `R[u]`.
  obtain ⟨c, hc⟩ : ∃ c, algebraMap R[X] (LegendreRing R) c = (6 : R[X]) • a := by
    refine Submodule.mem_one.mp ?_
    have : orbitSum R a = (6 : R[X]) • a := by
      simp only [orbitSum, LinearMap.add_apply, LinearMap.id_apply, LinearMap.comp_apply,
        AlgEquiv.toLinearMap_apply, hσ, hτ, Algebra.smul_def, map_ofNat]
      ring
    rw [← this, ← pb.basis.sum_repr a, map_sum]
    refine Submodule.sum_mem _ fun j _ => ?_
    rw [map_smul, pb.basis_eq_pow]
    exact Submodule.smul_mem _ _ (orbitSum_lambda_pow_mem R (hdim ▸ j.2))
  -- Comparing coordinates in the basis `1, λ, …, λ⁵`, `a` is its constant coordinate.
  set j₀ : Fin pb.dim := ⟨0, hdim ▸ by norm_num⟩
  have hrepr (c : R[X]) : pb.basis.repr (algebraMap R[X] (LegendreRing R) c) =
      Finsupp.single j₀ c := by
    have hj₀ : pb.basis j₀ = 1 := by simp [pb.basis_eq_pow, j₀]
    rw [Algebra.algebraMap_eq_smul_one, map_smul, ← hj₀, pb.basis.repr_self,
      Finsupp.smul_single_one]
  have h6' : (6 : R[X]) ∈ nonZeroDivisors R[X] :=
    mem_nonZeroDivisors_of_coeff_mem 0 (by simpa using h6)
  refine ⟨pb.basis.repr a j₀, pb.basis.ext_elem fun j => ?_⟩
  rw [hrepr]
  obtain rfl | hj := eq_or_ne j j₀
  · simp
  · have := congr(pb.basis.repr $hc j)
    rw [hrepr, map_smul, Finsupp.smul_apply, smul_eq_mul, Finsupp.single_eq_of_ne hj] at this
    rw [Finsupp.single_eq_of_ne hj,
      (mul_left_mem_nonZeroDivisors_eq_zero_iff h6').mp this.symm]

end anharmonic

/-- The Legendre curve `y² = x (x - 1) (x - λ)` over the Legendre ring is elliptic when `2` is
invertible. -/
instance [Invertible (2 : R)] : (freyCurve (1 : LegendreRing R) (-lambda R)).IsElliptic := by
  rw [isElliptic_freyCurve_iff]
  refine ⟨(isUnit_of_invertible (2 : R)).map (algebraMap R (LegendreRing R)), isUnit_one,
    (isUnit_lambda R).neg, ?_⟩
  rw [← sub_eq_add_neg, ← neg_sub]
  exact (isUnit_lambda_sub_one R).neg

/-- The `j`-invariant of the Legendre curve `y² = x (x - 1) (x - λ)` is
`2⁸ (λ² - λ + 1)³ / (λ² (λ - 1)²) = 2⁸ u`. -/
theorem freyCurve_one_neg_lambda_j [Invertible (2 : R)] :
    (freyCurve (1 : LegendreRing R) (-lambda R)).j =
      256 * algebraMap R[X] (LegendreRing R) X := by
  rw [WeierstrassCurve.j, Units.inv_mul_eq_iff_eq_mul, WeierstrassCurve.coe_Δ', freyCurve_Δ,
    freyCurve_c₄]
  linear_combination 4096 * lambda_sq_sub_lambda_add_one_pow_three R

end LegendreRing

