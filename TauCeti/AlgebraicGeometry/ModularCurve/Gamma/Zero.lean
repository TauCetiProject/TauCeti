module

public import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.CyclicSubgroup
public import TauCeti.AlgebraicGeometry.ModularCurve.Gamma.One

/-!
# The moduli problem `[Γ₀(N)]`

Following Katz and Mazur, a `[Γ₀(N)]`-structure on an elliptic curve `E` over a scheme `S` is a
cyclic subgroup of `E` of order `N`: a finite locally free subgroup scheme of rank `N` which,
fppf-locally on `S`, is the divisor `[P] + [2P] + ⋯ + [NP]` of a point `P` of exact order `N`
(`EllipticCurveGeom.IsCyclicSubgroup`). Like `[Γ₁(N)]`, this is meaningful over every base,
including bases on which `N` is not invertible.

An arrow `(E'/S') ⟶ (E/S)` of `Ell/B` exhibits `E'` as the base change of `E`, and the inverse
image of a cyclic subgroup of `E` along it is a cyclic subgroup of `E'` of the same order
(`EllipticCurveGeom.IsCyclicSubgroup.comap`). Inverse images of ideal sheaves are functorial, so
the `[Γ₀(N)]`-structures form a moduli problem over `Ell/B` (`ModuliProblem.gammaZero`).

A point `P` of exact order `N` generates the cyclic subgroup `⟨P⟩ = [P] + ⋯ + [NP]`, and this
construction commutes with base change. It is therefore a morphism of moduli problems
`[Γ₁(N)] ⟶ [Γ₀(N)]`, `(E, P) ↦ (E, ⟨P⟩)` (`ModuliProblem.gammaOneToGammaZero`).

## Main definitions

* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZero B N`: the moduli problem `[Γ₀(N)]` over
  `Ell/B`.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroEquiv`: the `[Γ₀(N)]`-structures on an
  object `(E/S)` of `Ell/B` are the ideal sheaves on `E` cutting out cyclic subgroups of order
  `N`.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaOneToGammaZero`: the morphism `[Γ₁(N)] ⟶ [Γ₀(N)]`
  sending a point of exact order `N` to the cyclic subgroup it generates.

## Main results

* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroEquiv_map`: the pull-back of a
  `[Γ₀(N)]`-structure along an arrow of `Ell/B` is the inverse image of its ideal sheaf.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroEquiv_gammaOneToGammaZero_app`: the image of
  a `[Γ₁(N)]`-structure `P` in `[Γ₀(N)]` is the divisor `[P] + ⋯ + [NP]`.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §3.4 (the moduli problem
  `[Γ₀(N)]`) and Chapter 4.
-/

public section

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory Opposite AlgebraicGeometry

universe u

namespace TauCeti.AlgebraicGeometry

variable {B : Scheme.{u}}

namespace ModuliProblem

variable (B) (N : ℕ)

/-- **The moduli problem `[Γ₀(N)]`** over `Ell/B` (Katz–Mazur, §3.4). A `[Γ₀(N)]`-structure on an
object `(E/S)` of `Ell/B` is a cyclic subgroup of `E` of order `N`, recorded by its ideal sheaf
(`gammaZeroEquiv`), and it pulls back along an arrow of `Ell/B` by inverse image
(`gammaZeroEquiv_map`). -/
noncomputable def gammaZero : ModuliProblem B where
  obj X := ULift.{u + 1}
    {I : X.unop.curve.carrier.IdealSheafData // X.unop.curve.IsCyclicSubgroup I N}
  map φ := TypeCat.ofHom fun I ↦
    ⟨⟨I.down.1.comap φ.unop.total, I.down.2.comap φ.unop.isPullback φ.unop.zero_total⟩⟩
  map_id X := by
    ext I : 5
    exact Scheme.IdealSheafData.comap_id _
  map_comp φ ψ := by
    ext I : 5
    exact Scheme.IdealSheafData.comap_comp _ _ _

variable {B N}

/-- The `[Γ₀(N)]`-structures on an object `(E/S)` of `Ell/B` are the ideal sheaves on `E`
cutting out cyclic subgroups of order `N`. -/
noncomputable def gammaZeroEquiv (X : EllObj B) :
    (gammaZero B N).obj (op X) ≃
      {I : X.curve.carrier.IdealSheafData // X.curve.IsCyclicSubgroup I N} :=
  Equiv.ulift

/-- The pull-back of a `[Γ₀(N)]`-structure along an arrow `φ` of `Ell/B` is the inverse image of
its ideal sheaf along the morphism of total spaces of `φ`. -/
@[simp]
theorem gammaZeroEquiv_map {X Y : EllObj B} (φ : X ⟶ Y) (α : (gammaZero B N).obj (op Y)) :
    (gammaZeroEquiv X ((gammaZero B N).map φ.op α)).1 = (gammaZeroEquiv Y α).1.comap φ.total :=
  (rfl)

variable (B N) in
/-- **The cyclic subgroup generated by a point of exact order `N`**, as a morphism of moduli
problems `[Γ₁(N)] ⟶ [Γ₀(N)]`: it sends a point `P` of exact order `N` on `E` to the cyclic
subgroup `⟨P⟩ = [P] + ⋯ + [NP]` (`gammaZeroEquiv_gammaOneToGammaZero_app`). -/
noncomputable def gammaOneToGammaZero : gammaOne B N ⟶ gammaZero B N where
  app X := TypeCat.ofHom fun P ↦ (gammaZeroEquiv X.unop).symm
    ⟨X.unop.curve.multiplesDivisor (gammaOneEquiv X.unop P).1 N,
      (gammaOneEquiv X.unop P).2.isCyclicSubgroup_multiplesDivisor⟩
  naturality X Y φ := by
    ext P : 3
    -- Both sides are divisors `[Q] + ⋯ + [NQ]`: on the left `Q` is the pull-back of `P`, on the
    -- right the divisor of `P` is pulled back, and `multiplesDivisor_pointsPullback` equates them.
    have h := gammaOneEquiv_map (N := N) φ.unop P
    rw [Quiver.Hom.op_unop] at h
    exact (gammaZeroEquiv _).injective <| Subtype.ext <|
      (congrArg (fun Q ↦ Y.unop.curve.multiplesDivisor Q N) h).trans
        (EllipticCurveGeom.multiplesDivisor_pointsPullback φ.unop.isPullback φ.unop.zero_total _ N)

/-- The image of a `[Γ₁(N)]`-structure `P` under `gammaOneToGammaZero` is the divisor
`[P] + ⋯ + [NP]`. -/
@[simp]
theorem gammaZeroEquiv_gammaOneToGammaZero_app (X : EllObj B) (P : (gammaOne B N).obj (op X)) :
    (gammaZeroEquiv X ((gammaOneToGammaZero B N).app (op X) P)).1 =
      X.curve.multiplesDivisor (gammaOneEquiv X P).1 N :=
  (rfl)

end ModuliProblem

end TauCeti.AlgebraicGeometry
