module

public import TauCeti.AlgebraicGeometry.Grassmannian.IdealLocus
public import TauCeti.LinearAlgebra.Basis.Flag
public import TauCeti.RingTheory.Grassmannian.RankLocus

import TauCeti.Data.Fin.StrictMono

/-!
# Determinantal rank-condition subschemes of the Grassmannian

Let `M` be a module over a commutative ring `R`. A point of the Grassmannian scheme
`G(k, M) = Module.Grassmannian.scheme R M k` over `Spec A` is an `A`-submodule `N` of `A ⊗[R] M`
whose quotient `Q` is finite projective of constant rank `k`. Given a family of submodules
`F i ≤ M` and bounds `s i`, this file constructs the closed subscheme of `G(k, M)` over which each
map `A ⊗[R] F i → Q` has rank at most `s i`: the **rank-condition subscheme**
(`Module.Grassmannian.schemeRankLocus`). Its ideal over a point `N` is generated by the
`(s i + 1) × (s i + 1)` minors of these maps (`Module.Grassmannian.rankLocus`), and it represents
the points at which all these minors vanish. Over a field `K`, write `(F i).baseChange K` for the
image of `K ⊗[R] F i → K ⊗[R] M`, which need not be injective. When these images are
finite-dimensional, a point lies in the subscheme exactly when
`dim ((F i).baseChange K) ≤ s i + dim ((F i).baseChange K ⊓ N)` for every `i`.

For a basis `b` of `M` indexed by `Fin n`, the subspaces `F_j = b.flag j` spanned by the first `j`
basis vectors form a complete flag of direct summands. For zero-based pivot positions
`p 0 < ⋯ < p (r - 1)` in `Fin n`, the **Schubert rank locus** `X_p`
(`Module.Grassmannian.schemeSchubertLocus`) imposes that `F_{p i + 1} → Q` has rank at most
`p i - i`. Over a field this is the incidence condition `dim (N ⊓ F_{p i + 1}) ≥ i + 1` for every
`i` (`Module.Grassmannian.schemeSchubertLocus_le_ker_toSchemeHom_iff_of_field`), the classical
condition defining the Schubert variety of `p` relative to the flag. The scheme structure here is
the one given by the determinantal equations; it is defined over any base ring and its formation
commutes with base change. No comparison with the reduced structure, with the closure of the
Schubert cell or with the pivot description of the cells (`Module.Basis.flagPivots`) is made in
this file.

## Main definitions

* `Module.Grassmannian.schemeRankLocus k F s`: the ideal sheaf on `G(k, M)` of the closed
  subscheme where each `F i` maps to the universal quotient with rank at most `s i`.
* `Module.Grassmannian.schemeRankLocusHomEquiv k F s A`: its points over `Spec A` are the points
  `N` of `G(k, A ⊗[R] M; A)` with `N.rankLocus (F i) (s i) = ⊥` for all `i`.
* `Module.Grassmannian.schemeSchubertLocus k b p`: the Schubert rank locus of the pivots `p`
  relative to the flag of a basis `b`.

## Main results

* `Module.Grassmannian.comap_toSchemeHom_schemeRankLocus`: the inverse image of the rank-condition
  subscheme along a point `N` is cut out by the minors `N.rankLocus (F i) (s i)`.
* `Module.Grassmannian.schemeRankLocus_le_ker_toSchemeHom_iff`: **the universal property**.
* `Module.Grassmannian.schemeRankLocus_le_ker_toSchemeHom_iff_of_field`: the points over a field
  are those satisfying the dimension conditions.
* `Module.Grassmannian.schemeSchubertLocus_le_ker_toSchemeHom_iff_of_field`: the points of the
  Schubert rank locus over a field are the `N` with `dim (N ⊓ F_{p i + 1}) ≥ i + 1` for all `i`.

## References

* W. Fulton, *Young tableaux*, London Mathematical Society Student Texts 35, Cambridge University
  Press (1997), §9.4, for the rank conditions defining Schubert varieties.
* A. Grothendieck, J. Dieudonné, *Éléments de géométrie algébrique I* (Springer, 1971), 9.7, for
  closed conditions on the Grassmannian.
-/

public section

universe u

open CategoryTheory AlgebraicGeometry TensorProduct Module Scheme.IdealSheafData

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {M : Type u} [AddCommGroup M] [Module R M] {k : ℕ} {ι : Sort*}

/-- The ideal of the rank conditions `F i ≤ s i` at a point is compatible with base change. -/
private theorem iSup_rankLocus_map {A B : Type u} [CommRing A] [Algebra R A] [CommRing B]
    [Algebra R B] (F : ι → Submodule R M) (s : ι → ℕ) (f : A →ₐ[R] B) (N : G(k, A ⊗[R] M; A)) :
    ⨆ i, (map f N).rankLocus (F i) (s i) = Ideal.map f (⨆ i, N.rankLocus (F i) (s i)) := by
  simp [Ideal.map_iSup]

variable (k) in
/-- The ideal sheaf of the **rank-condition subscheme** of the Grassmannian scheme `G(k, M)` for a
family of submodules `F i` of `M` and bounds `s i`: the closed subscheme over which each `F i` maps
to the universal quotient with rank at most `s i`. A morphism `Spec A ⟶ G(k, M)` over `Spec R`,
classifying a point `N` of `G(k, A ⊗[R] M; A)`, factors through it exactly when all the minors
`N.rankLocus (F i) (s i)` vanish (`Module.Grassmannian.schemeRankLocus_le_ker_toSchemeHom_iff`).
Over an affine open `U`, its ideal is generated by these minors at the point over `Γ(G(k, M), U)`
classifying the inclusion of `U`. -/
noncomputable def schemeRankLocus (F : ι → Submodule R M) (s : ι → ℕ) :
    (scheme R M k).IdealSheafData :=
  schemeIdealLocus (R := R) (M := M) (k := k) (fun N ↦ ⨆ i, N.rankLocus (F i) (s i))
    fun f N ↦ iSup_rankLocus_map F s f N

/-- **The inverse image of the rank-condition subscheme along a point.** For an `R`-algebra `A` and
a point `N` of `G(k, A ⊗[R] M; A)`, the inverse image of `schemeRankLocus k F s` along the morphism
`Spec A ⟶ G(k, M)` classifying `N` is the zero scheme of the minors `N.rankLocus (F i) (s i)`. -/
theorem comap_toSchemeHom_schemeRankLocus (F : ι → Submodule R M) (s : ι → ℕ) {A : Type u}
    [CommRing A] [Algebra R A] (N : G(k, A ⊗[R] M; A)) :
    (schemeRankLocus k F s).comap (toSchemeHom N) =
      ofIdealTop ((⨆ i, N.rankLocus (F i) (s i)).map (Scheme.ΓSpecIso (.of A)).inv.hom) :=
  comap_toSchemeHom_schemeIdealLocus (R := R) (M := M) (k := k)
    (fun N ↦ ⨆ i, N.rankLocus (F i) (s i)) (iSup_rankLocus_map F s) N

/-- **The universal property of the rank-condition subscheme.** For an `R`-algebra `A`, the
morphism `Spec A ⟶ G(k, M)` classifying a point `N` of `G(k, A ⊗[R] M; A)` factors through
`schemeRankLocus k F s` exactly when the minors `N.rankLocus (F i) (s i)` all vanish. -/
theorem schemeRankLocus_le_ker_toSchemeHom_iff (F : ι → Submodule R M) (s : ι → ℕ) {A : Type u}
    [CommRing A] [Algebra R A] (N : G(k, A ⊗[R] M; A)) :
    schemeRankLocus k F s ≤ (toSchemeHom N).ker ↔ ∀ i, N.rankLocus (F i) (s i) = ⊥ :=
  (schemeIdealLocus_le_ker_toSchemeHom_iff (R := R) (M := M) (k := k)
    (fun N ↦ ⨆ i, N.rankLocus (F i) (s i)) (iSup_rankLocus_map F s) N).trans iSup_eq_bot

variable (k) in
/-- **The rank-condition subscheme represents the points satisfying the rank conditions.** For an
`R`-algebra `A`, the points `N` of `G(k, A ⊗[R] M; A)` at which all the minors
`N.rankLocus (F i) (s i)` vanish are in bijection with the morphisms from `Spec A` to
`schemeRankLocus k F s` over `Spec R`. The bijection composes with the inclusion into `G(k, M)` to
the morphism classifying `N`
(`Module.Grassmannian.schemeRankLocusHomEquiv_apply_comp_subschemeι` and
`Module.Grassmannian.toSchemeHom_schemeRankLocusHomEquiv_symm_apply`). -/
noncomputable def schemeRankLocusHomEquiv (F : ι → Submodule R M) (s : ι → ℕ) (A : Type u)
    [CommRing A] [Algebra R A] :
    {N : G(k, A ⊗[R] M; A) // ∀ i, N.rankLocus (F i) (s i) = ⊥} ≃
      {h : Spec (.of A) ⟶ (schemeRankLocus k F s).subscheme //
        h ≫ (schemeRankLocus k F s).subschemeι ≫ toSpec R M k =
          Spec.map (CommRingCat.ofHom (algebraMap R A))} :=
  (Equiv.subtypeEquivRight fun _ ↦ iSup_eq_bot.symm).trans
    (schemeIdealLocusHomEquiv (R := R) (M := M) (k := k)
    (fun N ↦ ⨆ i, N.rankLocus (F i) (s i)) (iSup_rankLocus_map F s) A)

/-- The morphism to the rank-condition subscheme corresponding to a point `N`, followed by the
inclusion into the Grassmannian scheme, is the morphism classifying `N`. -/
@[reassoc (attr := simp)]
theorem schemeRankLocusHomEquiv_apply_comp_subschemeι (F : ι → Submodule R M) (s : ι → ℕ)
    {A : Type u} [CommRing A] [Algebra R A]
    (N : {N : G(k, A ⊗[R] M; A) // ∀ i, N.rankLocus (F i) (s i) = ⊥}) :
    (schemeRankLocusHomEquiv k F s A N).1 ≫ (schemeRankLocus k F s).subschemeι =
      toSchemeHom N.1 :=
  schemeIdealLocusHomEquiv_apply_comp_subschemeι (R := R) (M := M) (k := k)
    (fun N ↦ ⨆ i, N.rankLocus (F i) (s i)) (iSup_rankLocus_map F s) _

/-- The point corresponding to a morphism `h` to the rank-condition subscheme is the point
classified by `h` followed by the inclusion into the Grassmannian scheme. -/
@[simp]
theorem toSchemeHom_schemeRankLocusHomEquiv_symm_apply (F : ι → Submodule R M) (s : ι → ℕ)
    {A : Type u} [CommRing A] [Algebra R A]
    (h : {h : Spec (.of A) ⟶ (schemeRankLocus k F s).subscheme //
      h ≫ (schemeRankLocus k F s).subschemeι ≫ toSpec R M k =
        Spec.map (CommRingCat.ofHom (algebraMap R A))}) :
    toSchemeHom ((schemeRankLocusHomEquiv k F s A).symm h).1 =
      h.1 ≫ (schemeRankLocus k F s).subschemeι :=
  toSchemeHom_schemeIdealLocusHomEquiv_symm_apply (R := R) (M := M) (k := k)
    (fun N ↦ ⨆ i, N.rankLocus (F i) (s i)) (iSup_rankLocus_map F s) h

/-- **The points of the rank-condition subscheme over a field.** For a field `K` such that each
`(F i).baseChange K`, the image of `K ⊗[R] F i → K ⊗[R] M` (which need not be injective), is
finite-dimensional, the morphism `Spec K ⟶ G(k, M)` classifying a point `N` of
`G(k, K ⊗[R] M; K)` factors through `schemeRankLocus k F s` exactly when
`dim ((F i).baseChange K) ≤ s i + dim ((F i).baseChange K ⊓ N)` for every `i`. -/
theorem schemeRankLocus_le_ker_toSchemeHom_iff_of_field (F : ι → Submodule R M) (s : ι → ℕ)
    {K : Type u} [Field K] [Algebra R K] [∀ i, FiniteDimensional K ((F i).baseChange K)]
    (N : G(k, K ⊗[R] M; K)) :
    schemeRankLocus k F s ≤ (toSchemeHom N).ker ↔
      ∀ i, finrank K ((F i).baseChange K) ≤
        s i + finrank K ((F i).baseChange K ⊓ N.toSubmodule : Submodule K _) := by
  simp only [schemeRankLocus_le_ker_toSchemeHom_iff, rankLocus_eq_bot_iff_finrank_inf]

section Schubert

variable {n r : ℕ}

variable (k) in
/-- The ideal sheaf of the **Schubert rank locus** of zero-based pivot positions
`p : Fin r → Fin n` relative to the flag `F_j = b.flag j` of a basis `b` of `M`: the
rank-condition subscheme of `G(k, M)` over which `F_{p i + 1}` maps to the universal quotient with
rank at most `p i - i`, for every `i`. Over a field and for strictly increasing `p`, its points are
the `N` with `dim (N ⊓ F_{p i + 1}) ≥ i + 1` for all `i`
(`Module.Grassmannian.schemeSchubertLocus_le_ker_toSchemeHom_iff_of_field`). -/
noncomputable def schemeSchubertLocus (b : Basis (Fin n) R M) (p : Fin r → Fin n) :
    (scheme R M k).IdealSheafData :=
  schemeRankLocus k (fun i ↦ b.flag (p i).succ) fun i ↦ (p i : ℕ) - i

/-- The Schubert rank locus of the pivots `p` is the rank-condition subscheme imposing that
`F_{p i + 1}` maps to the universal quotient with rank at most `p i - i`, for every `i`. -/
theorem schemeSchubertLocus_def (b : Basis (Fin n) R M) (p : Fin r → Fin n) :
    schemeSchubertLocus k b p =
      schemeRankLocus k (fun i ↦ b.flag (p i).succ) fun i ↦ (p i : ℕ) - i :=
  (rfl)

/-- **The points of the Schubert rank locus over a field.** For strictly increasing pivot positions
`p : Fin r → Fin n` and a field `K`, the morphism `Spec K ⟶ G(k, M)` classifying a point `N` of
`G(k, K ⊗[R] M; K)` factors through the Schubert rank locus `schemeSchubertLocus k b p` exactly
when `N` meets the base change of the flag subspace `F_{p i + 1}` in dimension at least `i + 1`, for
every `i`. -/
theorem schemeSchubertLocus_le_ker_toSchemeHom_iff_of_field
    (b : Basis (Fin n) R M) {p : Fin r → Fin n} (hp : StrictMono p) {K : Type u} [Field K]
    [Algebra R K] (N : G(k, K ⊗[R] M; K)) :
    schemeSchubertLocus k b p ≤ (toSchemeHom N).ker ↔
      ∀ i : Fin r, (i : ℕ) + 1 ≤
        finrank K ((b.flag (p i).succ).baseChange K ⊓ N.toSubmodule : Submodule K _) := by
  have := Module.Finite.of_basis b
  rw [schemeSchubertLocus_def, schemeRankLocus_le_ker_toSchemeHom_iff_of_field]
  refine forall_congr' fun i ↦ ?_
  -- the flag subspace `F_{p i + 1}` has dimension `p i + 1` after base change, and `i ≤ p i`
  have hdim : finrank K ((b.flag (p i).succ).baseChange K) = p i + 1 := by
    rw [← Basis.flag_baseChange, Basis.finrank_flag, Fin.val_succ]
  have hle := Submodule.finrank_mono
    (inf_le_left : (b.flag (p i).succ).baseChange K ⊓ N.toSubmodule ≤ _)
  have hi := (Fin.val_strictMono.comp hp).add_sub_le_nat
    (show (⟨0, i.pos⟩ : Fin r) ≤ i from Fin.le_def.mpr (Nat.zero_le _))
  simp only [Function.comp_apply] at hi
  omega

end Schubert

end Module.Grassmannian
