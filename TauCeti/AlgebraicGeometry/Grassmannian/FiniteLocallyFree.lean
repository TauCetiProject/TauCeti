module

public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
public import Mathlib.AlgebraicGeometry.Morphisms.FlatRank
public import TauCeti.AlgebraicGeometry.Grassmannian.HopfIdeal
public import TauCeti.AlgebraicGeometry.Grassmannian.UniversalQuotient

import Mathlib.RingTheory.Finiteness.ModuleFinitePresentation
import TauCeti.AlgebraicGeometry.IdealSheaf.OfIdealTop

/-!
# The universal family over the Hopf-ideal locus is finite locally free

Let `H` be a commutative Hopf algebra over a commutative ring `R` and `k` a natural number. The
universal quotient closed subscheme `Z ⊆ G(k, H) ×_{Spec R} Spec H`
(`Module.Grassmannian.schemeUniversalIdeal`) is the relative spectrum over the Grassmannian scheme
`G(k, H)` of the quotient of `𝒪 ⊗[R] H` by the ideal generated by the universal submodule. Over a
point `N` of `G(k, H)` the ideal generated by `N` can be larger than `N`, so `Z` need not be finite
locally free over `G(k, H)`. On the closed subscheme of Hopf ideals `L ⊆ G(k, H)`
(`Module.Grassmannian.schemeHopfIdealLocus`) the universal submodule is itself an ideal, and this
file proves that the base change `Z ×_{G(k, H)} L` of `Z` to `L`
(`Module.Grassmannian.schemeHopfIdealLocusFamily`) is finite, flat and of finite presentation over
`L`, of constant rank `k`.

The proof is a fibre computation. A morphism `Spec A ⟶ L` over `Spec R` is a point `N` of
`G(k, A ⊗[R] H; A)` on the Hopf-ideal locus (`Module.Grassmannian.schemeHopfIdealLocusHomEquiv`).
The base change of `Z ×_{G(k, H)} L ⟶ L` along it is `Spec ((A ⊗[R] H) ⧸ N) ⟶ Spec A`
(`Module.Grassmannian.isPullback_schemeHopfIdealLocusFamilyHom`), whose quotient is finite
projective of constant rank `k` over `A` by the definition of the Grassmannian. This fibre is the
spectrum of the quotient Hopf algebra that `Module.Grassmannian.subgroupScheme N hN` makes a
closed subgroup scheme of `Spec (A ⊗[R] H)`. Finiteness, flatness and finite presentation are local
on the target, so they follow by covering `L` by affine schemes; the rank is computed on the same
fibres.

That the family is itself a subgroup scheme of `L ×_{Spec R} Spec H` over `L`, that is, that the
group law of `Spec H` restricts to it, is not proved here.

## Main definitions

* `Module.Grassmannian.schemeHopfIdealLocusFamily R H k`: the base change of the universal
  quotient closed subscheme to the closed subscheme of Hopf ideals.
* `Module.Grassmannian.schemeHopfIdealLocusFamilyHom R H k`: its projection to the closed
  subscheme of Hopf ideals.
* `Module.Grassmannian.schemeHopfIdealLocusFamilyι R H k`: its inclusion into the universal
  quotient closed subscheme.
* `Module.Grassmannian.toSchemeHopfIdealLocusFamily N hN`: the inclusion of the fibre
  `Spec ((A ⊗[R] H) ⧸ N)` over the point `N`.

## Main results

* `Module.Grassmannian.isPullback_schemeHopfIdealLocusFamily`: the family is the base change of
  the universal quotient closed subscheme to the closed subscheme of Hopf ideals.
* `Module.Grassmannian.isPullback_schemeHopfIdealLocusFamilyHom`: **the fibre over a point**; the
  base change of the family along the morphism `Spec A ⟶ L` classifying `N` is
  `Spec ((A ⊗[R] H) ⧸ N) ⟶ Spec A`, included by `toSchemeHopfIdealLocusFamily N hN`
  (`Module.Grassmannian.toSchemeHopfIdealLocusFamily_ι_subschemeι` and
  `Module.Grassmannian.toSchemeHopfIdealLocusFamily_schemeHopfIdealLocusFamilyHom`).
* `Module.Grassmannian.isFinite_schemeHopfIdealLocusFamilyHom`,
  `Module.Grassmannian.flat_schemeHopfIdealLocusFamilyHom` and
  `Module.Grassmannian.locallyOfFinitePresentation_schemeHopfIdealLocusFamilyHom`: the family is
  finite locally free over the closed subscheme of Hopf ideals.
* `Module.Grassmannian.finrank_schemeHopfIdealLocusFamilyHom`: it has constant rank `k`.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §1.1, for finite locally free
  subgroup schemes and their ranks.
* A. Grothendieck, J. Dieudonné, *Éléments de géométrie algébrique I* (Springer, 1971), 9.7, for
  the Grassmannian and its universal quotient.
-/

public section

universe u

open CategoryTheory Limits AlgebraicGeometry TensorProduct Scheme.IdealSheafData

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {H : Type u} [CommRing H] [HopfAlgebra R H] {k : ℕ}

variable (R H k) in
/-- The **universal family over the Hopf-ideal locus**: the base change of the universal quotient
closed subscheme of `G(k, H) ×_{Spec R} Spec H` (`Module.Grassmannian.schemeUniversalIdeal`) to the
closed subscheme of Hopf ideals of `G(k, H)` (`Module.Grassmannian.schemeHopfIdealLocus`). Its
fibre over a point `N` of `G(k, A ⊗[R] H; A)` on the Hopf-ideal locus is `Spec ((A ⊗[R] H) ⧸ N)`
(`Module.Grassmannian.isPullback_schemeHopfIdealLocusFamilyHom`), and it is finite locally free of
rank `k` over the closed subscheme of Hopf ideals. -/
noncomputable def schemeHopfIdealLocusFamily : Scheme.{u} :=
  pullback ((schemeUniversalIdeal R H k).subschemeι ≫ pullback.fst _ _)
    (schemeHopfIdealLocus R H k).subschemeι

variable (R H k) in
/-- The projection of the universal family over the Hopf-ideal locus to the closed subscheme of
Hopf ideals. It is finite locally free of rank `k`
(`Module.Grassmannian.finrank_schemeHopfIdealLocusFamilyHom`). -/
noncomputable def schemeHopfIdealLocusFamilyHom :
    schemeHopfIdealLocusFamily R H k ⟶ (schemeHopfIdealLocus R H k).subscheme :=
  pullback.snd _ _

variable (R H k) in
/-- The inclusion of the universal family over the Hopf-ideal locus into the universal quotient
closed subscheme of `G(k, H) ×_{Spec R} Spec H`. It is a closed immersion, as the base change of
the inclusion of the closed subscheme of Hopf ideals. -/
noncomputable def schemeHopfIdealLocusFamilyι :
    schemeHopfIdealLocusFamily R H k ⟶ (schemeUniversalIdeal R H k).subscheme :=
  pullback.fst _ _

variable (R H k) in
/-- The universal family over the Hopf-ideal locus is the base change of the universal quotient
closed subscheme to the closed subscheme of Hopf ideals. -/
theorem isPullback_schemeHopfIdealLocusFamily :
    IsPullback (schemeHopfIdealLocusFamilyι R H k) (schemeHopfIdealLocusFamilyHom R H k)
      ((schemeUniversalIdeal R H k).subschemeι ≫ pullback.fst _ _)
      (schemeHopfIdealLocus R H k).subschemeι :=
  IsPullback.of_hasPullback _ _

instance isClosedImmersion_schemeHopfIdealLocusFamilyι :
    IsClosedImmersion (schemeHopfIdealLocusFamilyι R H k) :=
  MorphismProperty.of_isPullback (isPullback_schemeHopfIdealLocusFamily R H k).flip inferInstance

section Fiber

variable {A : Type u} [CommRing A] [Algebra R A] (N : G(k, A ⊗[R] H; A))
  (hN : N.hopfIdealLocus = ⊥)

/-- The quotient map `A ⊗[R] H → (A ⊗[R] H) ⧸ N` of a point `N` of the Hopf-ideal locus. -/
private noncomputable abbrev quotientMk :
    CommRingCat.of (A ⊗[R] H) ⟶ CommRingCat.of ((A ⊗[R] H) ⧸ N.hopfIdeal hN) :=
  CommRingCat.ofHom (Ideal.Quotient.mk (R := A ⊗[R] H) (N.hopfIdeal hN))

private instance : IsClosedImmersion (Spec.map (quotientMk N hN)) :=
  .spec_of_surjective _ Ideal.Quotient.mk_surjective

/-- The inverse image of the universal quotient closed subscheme in the base change
`Spec (A ⊗[R] H)` along the morphism classifying a point `N` of the Hopf-ideal locus is the closed
subscheme `Spec ((A ⊗[R] H) ⧸ N)`. -/
private theorem comap_schemeUniversalIdeal_eq_ker :
    (schemeUniversalIdeal R H k).comap (toPullbackHom (map Algebra.TensorProduct.includeLeft N)
        Algebra.TensorProduct.includeRight) =
      (Spec.map (quotientMk N hN)).ker := by
  rw [comap_toPullbackHom_map_includeLeft_of_hopfIdealLocus N hN, Scheme.Hom.ker_Spec_map,
    CommRingCat.hom_ofHom, Ideal.mk_ker]

/-- The morphism from `Spec ((A ⊗[R] H) ⧸ N)` to the universal quotient closed subscheme, lifting
the morphism classifying the base change of `N` and the point `h ↦ 1 ⊗ h` of `Spec H`. -/
private noncomputable def toUniversalQuotient :
    Spec (.of ((A ⊗[R] H) ⧸ N.hopfIdeal hN)) ⟶ (schemeUniversalIdeal R H k).subscheme :=
  IsClosedImmersion.lift (schemeUniversalIdeal R H k).subschemeι
    (Spec.map (quotientMk N hN) ≫ toPullbackHom (map Algebra.TensorProduct.includeLeft N)
      Algebra.TensorProduct.includeRight) <| by
    rw [ker_subschemeι, Scheme.Hom.ker_comp, ← comap_schemeUniversalIdeal_eq_ker N hN]
    exact le_map_comap _ _

private theorem toUniversalQuotient_subschemeι :
    toUniversalQuotient N hN ≫ (schemeUniversalIdeal R H k).subschemeι =
      Spec.map (quotientMk N hN) ≫
        toPullbackHom (map Algebra.TensorProduct.includeLeft N)
          Algebra.TensorProduct.includeRight :=
  IsClosedImmersion.lift_fac _ _ _

/-- The closed immersion `Spec ((A ⊗[R] H) ⧸ N) ⟶ Spec (A ⊗[R] H)` followed by the projection to
`Spec A` is the structure morphism of the quotient. -/
private theorem specMap_mk_comp_specMap_includeLeft :
    Spec.map (quotientMk N hN) ≫
        Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          A →+* A ⊗[R] H)) =
      Spec.map (CommRingCat.ofHom (algebraMap A ((A ⊗[R] H) ⧸ N.hopfIdeal hN))) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]

/-- The base change of the universal quotient closed subscheme along the morphism `Spec A ⟶ G(k, H)`
classifying a point `N` of the Hopf-ideal locus is `Spec ((A ⊗[R] H) ⧸ N)`. -/
private theorem isPullback_toUniversalQuotient :
    IsPullback (toUniversalQuotient N hN)
      (Spec.map (CommRingCat.ofHom (algebraMap A ((A ⊗[R] H) ⧸ N.hopfIdeal hN))))
      ((schemeUniversalIdeal R H k).subschemeι ≫ pullback.fst _ _) (toSchemeHom N) := by
  rw [← specMap_mk_comp_specMap_includeLeft]
  -- the fibre of the closed subscheme over `Spec (A ⊗[R] H)`, pasted with the base change of
  -- `G(k, H) ×_{Spec R} Spec H ⟶ G(k, H)` along the morphism classifying `N`
  refine IsPullback.paste_vert ?_ (isPullback_toPullbackHom_map_includeLeft N)
  refine (isPullback_of_isClosedImmersion _ _ _ _
    (toUniversalQuotient_subschemeι N hN).symm ?_).flip
  rw [ker_subschemeι, comap_schemeUniversalIdeal_eq_ker N hN]

/-- The inclusion of the fibre `Spec ((A ⊗[R] H) ⧸ N)` of the universal family over the Hopf-ideal
locus over the point `N` (`Module.Grassmannian.isPullback_schemeHopfIdealLocusFamilyHom`). -/
noncomputable def toSchemeHopfIdealLocusFamily :
    Spec (.of ((A ⊗[R] H) ⧸ N.hopfIdeal hN)) ⟶ schemeHopfIdealLocusFamily R H k :=
  pullback.lift (toUniversalQuotient N hN)
    (Spec.map (CommRingCat.ofHom (algebraMap A ((A ⊗[R] H) ⧸ N.hopfIdeal hN))) ≫
      (schemeHopfIdealLocusHomEquiv R H k A ⟨N, hN⟩).1) <| by
    rw [(isPullback_toUniversalQuotient N hN).w, Category.assoc,
      schemeHopfIdealLocusHomEquiv_apply_comp_subschemeι]

private theorem toSchemeHopfIdealLocusFamily_ι :
    toSchemeHopfIdealLocusFamily N hN ≫ schemeHopfIdealLocusFamilyι R H k =
      toUniversalQuotient N hN :=
  pullback.lift_fst _ _ _

/-- The inclusion of the fibre over `N`, followed by the inclusion of the universal family into
`G(k, H) ×_{Spec R} Spec H`, is the closed immersion `Spec ((A ⊗[R] H) ⧸ N) ⟶ Spec (A ⊗[R] H)`
followed by the morphism classifying the base change of `N` and the point `h ↦ 1 ⊗ h` of
`Spec H`. -/
@[reassoc (attr := simp)]
theorem toSchemeHopfIdealLocusFamily_ι_subschemeι :
    toSchemeHopfIdealLocusFamily N hN ≫ schemeHopfIdealLocusFamilyι R H k ≫
        (schemeUniversalIdeal R H k).subschemeι =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (R := A ⊗[R] H) (N.hopfIdeal hN))) ≫
        toPullbackHom (map Algebra.TensorProduct.includeLeft N)
          Algebra.TensorProduct.includeRight := by
  rw [reassoc_of% toSchemeHopfIdealLocusFamily_ι N hN, toUniversalQuotient_subschemeι]

/-- The inclusion of the fibre over `N` lies over the morphism `Spec A ⟶ L` classifying `N`. -/
@[reassoc (attr := simp)]
theorem toSchemeHopfIdealLocusFamily_schemeHopfIdealLocusFamilyHom :
    toSchemeHopfIdealLocusFamily N hN ≫ schemeHopfIdealLocusFamilyHom R H k =
      Spec.map (CommRingCat.ofHom (algebraMap A ((A ⊗[R] H) ⧸ N.hopfIdeal hN))) ≫
        (schemeHopfIdealLocusHomEquiv R H k A ⟨N, hN⟩).1 :=
  pullback.lift_snd _ _ _

/-- **The fibre of the universal family over a point of the Hopf-ideal locus.** For a point `N` of
`G(k, A ⊗[R] H; A)` on the Hopf-ideal locus, the base change of the universal family over the
Hopf-ideal locus along the morphism `Spec A ⟶ L` classifying `N` is
`Spec ((A ⊗[R] H) ⧸ N) ⟶ Spec A`. -/
theorem isPullback_schemeHopfIdealLocusFamilyHom :
    IsPullback (toSchemeHopfIdealLocusFamily N hN)
      (Spec.map (CommRingCat.ofHom (algebraMap A ((A ⊗[R] H) ⧸ N.hopfIdeal hN))))
      (schemeHopfIdealLocusFamilyHom R H k)
      (schemeHopfIdealLocusHomEquiv R H k A ⟨N, hN⟩).1 := by
  refine IsPullback.of_right ?_ (toSchemeHopfIdealLocusFamily_schemeHopfIdealLocusFamilyHom N hN)
    (isPullback_schemeHopfIdealLocusFamily R H k)
  rw [toSchemeHopfIdealLocusFamily_ι, schemeHopfIdealLocusHomEquiv_apply_comp_subschemeι]
  exact isPullback_toUniversalQuotient N hN

end Fiber

/-- Every morphism from an affine scheme to the closed subscheme of Hopf ideals is, for the
`R`-algebra structure it induces, the morphism classifying a point `N` of the Hopf-ideal locus, and
the universal family over the Hopf-ideal locus pulls back along it to
`Spec ((A ⊗[R] H) ⧸ N) ⟶ Spec A`. -/
private theorem exists_isPullback_schemeHopfIdealLocusFamilyHom (C : CommRingCat.{u})
    (g : Spec C ⟶ (schemeHopfIdealLocus R H k).subscheme) :
    ∃ (_ : Algebra R C) (N : G(k, C ⊗[R] H; C)) (hN : N.hopfIdealLocus = ⊥)
      (t : Spec (.of ((C ⊗[R] H) ⧸ N.hopfIdeal hN)) ⟶ schemeHopfIdealLocusFamily R H k),
      IsPullback t (Spec.map (CommRingCat.ofHom (algebraMap C ((C ⊗[R] H) ⧸ N.hopfIdeal hN))))
        (schemeHopfIdealLocusFamilyHom R H k) g := by
  let _ : Algebra R C :=
    (Spec.preimage (g ≫ (schemeHopfIdealLocus R H k).subschemeι ≫ toSpec R H k)).hom.toAlgebra
  have hg : g ≫ (schemeHopfIdealLocus R H k).subschemeι ≫ toSpec R H k =
      Spec.map (CommRingCat.ofHom (algebraMap R C)) :=
    (Spec.map_preimage _).symm
  let N := (schemeHopfIdealLocusHomEquiv R H k C).symm ⟨g, hg⟩
  have hgN : (schemeHopfIdealLocusHomEquiv R H k C ⟨N.1, N.2⟩).1 = g := by
    rw [Subtype.coe_eta, Equiv.apply_symm_apply]
  exact ⟨_, N.1, N.2, _, hgN ▸ isPullback_schemeHopfIdealLocusFamilyHom N.1 N.2⟩

/-- A property of morphisms which is local on the target holds for the universal family over the
Hopf-ideal locus as soon as it holds for every structure morphism `Spec ((A ⊗[R] H) ⧸ N) ⟶ Spec A`
of a point `N` of the Hopf-ideal locus. -/
private theorem schemeHopfIdealLocusFamilyHom_of_forall {P : MorphismProperty Scheme.{u}}
    [IsZariskiLocalAtTarget P]
    (hP : ∀ (A : Type u) [CommRing A] [Algebra R A] (N : G(k, A ⊗[R] H; A))
      (hN : N.hopfIdealLocus = ⊥),
      P (Spec.map (CommRingCat.ofHom (algebraMap A ((A ⊗[R] H) ⧸ N.hopfIdeal hN))))) :
    P (schemeHopfIdealLocusFamilyHom R H k) := by
  refine IsZariskiLocalAtTarget.of_openCover (schemeHopfIdealLocus R H k).subscheme.affineCover
    fun i ↦ ?_
  obtain ⟨_, N, hN, t, h⟩ := exists_isPullback_schemeHopfIdealLocusFamilyHom _
    ((schemeHopfIdealLocus R H k).subscheme.affineCover.f i)
  have hPN := hP _ N hN
  rw [← h.isoPullback_hom_snd] at hPN
  exact (P.cancel_left_of_respectsIso h.isoPullback.hom _).1 hPN

/-- The universal family over the Hopf-ideal locus is finite over the closed subscheme of Hopf
ideals. -/
instance isFinite_schemeHopfIdealLocusFamilyHom :
    IsFinite (schemeHopfIdealLocusFamilyHom R H k) := by
  -- Instance search does not find the locality of finiteness through `HasAffineProperty`.
  observe h : HasAffineProperty @IsFinite.{u}
    (fun X _ f _ ↦ IsAffine X ∧ RingHom.Finite (f.appTop).hom)
  have := @HasAffineProperty.instIsZariskiLocalAtTarget _ _ h
  refine schemeHopfIdealLocusFamilyHom_of_forall fun _ _ _ _ _ ↦ ?_
  rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom, RingHom.finite_algebraMap]
  infer_instance

/-- The universal family over the Hopf-ideal locus is flat over the closed subscheme of Hopf
ideals. -/
instance flat_schemeHopfIdealLocusFamilyHom :
    AlgebraicGeometry.Flat (schemeHopfIdealLocusFamilyHom R H k) := by
  -- Instance search does not find the locality of flatness through `HasRingHomProperty`.
  have := HasRingHomProperty.instIsZariskiLocalAtTarget @AlgebraicGeometry.Flat
  refine schemeHopfIdealLocusFamilyHom_of_forall fun _ _ _ _ _ ↦ ?_
  rw [AlgebraicGeometry.Flat.SpecMap_iff, CommRingCat.hom_ofHom, RingHom.flat_algebraMap_iff]
  infer_instance

/-- The universal family over the Hopf-ideal locus is locally of finite presentation over the
closed subscheme of Hopf ideals. -/
instance locallyOfFinitePresentation_schemeHopfIdealLocusFamilyHom :
    LocallyOfFinitePresentation (schemeHopfIdealLocusFamilyHom R H k) := by
  -- Instance search does not find the locality of finite presentation through
  -- `HasRingHomProperty`.
  have := HasRingHomProperty.instIsZariskiLocalAtTarget @LocallyOfFinitePresentation
  refine schemeHopfIdealLocusFamilyHom_of_forall fun A _ _ N hN ↦ ?_
  rw [LocallyOfFinitePresentation.SpecMap_iff, CommRingCat.hom_ofHom,
    RingHom.finitePresentation_algebraMap]
  exact (Module.FinitePresentation.iff_finitePresentation_of_finite _ _).1
    (Module.finitePresentation_of_projective A ((A ⊗[R] H) ⧸ N.hopfIdeal hN))

/-- The universal family over the Hopf-ideal locus has constant rank `k` over the closed subscheme
of Hopf ideals. -/
@[simp]
theorem finrank_schemeHopfIdealLocusFamilyHom (x : (schemeHopfIdealLocus R H k).subscheme) :
    Scheme.Hom.finrank (schemeHopfIdealLocusFamilyHom R H k) x = k := by
  obtain ⟨C, g, -, y, rfl⟩ := Scheme.exists_Spec_apply_eq x
  obtain ⟨_, N, hN, t, h⟩ := exists_isPullback_schemeHopfIdealLocusFamilyHom C g
  rw [← Scheme.Hom.finrank_of_isPullback _ _ _ _ h]
  exact (Scheme.Hom.finrank_SpecMap_algebraMap _ _ y).trans (rankAtStalk_quotient_hopfIdeal N hN y)

end Module.Grassmannian
