/-!
# The universal quotient closed subscheme over the Grassmannian

Let `H` be a commutative `R`-algebra and `k` a natural number. A point of the Grassmannian scheme
`G(k, H) = Module.Grassmannian.scheme R H k` over `Spec A` is an `A`-submodule `N` of `A ⊗[R] H`
whose quotient is finite projective of constant rank `k` (`Module.Grassmannian.schemeHomEquiv`).
The ideal generated by `N` cuts out a closed subscheme of `Spec (A ⊗[R] H)`, the base change of
`Spec H` to `Spec A`. This file glues these closed subschemes into the **universal quotient closed
subscheme** of `G(k, H) ×_{Spec R} Spec H`: the relative spectrum over `G(k, H)` of the quotient of
`𝒪 ⊗[R] H` by the ideal generated by the universal submodule.

An `A`-point of `G(k, H) ×_{Spec R} Spec H` is a pair of a point `N` of `G(k, A ⊗[R] H; A)` and an
`R`-algebra map `x : H → A` (`Module.Grassmannian.toPullbackHom N x`, and
`Module.Grassmannian.exists_toPullbackHom_eq`). Over an affine open `U` of the fibre product, the
ideal of the closed subscheme is `Module.Grassmannian.evalIdeal` of the point classifying the
inclusion of `U`: the ideal generated by the values at `x` of the elements of `N`. These ideals are
compatible with restriction to basic opens because the formation of `evalIdeal` commutes with base
change (`Module.Grassmannian.map_evalIdeal`). The gluing follows the construction of the Hopf-ideal
locus `Module.Grassmannian.schemeHopfIdealLocus` in
`TauCeti/AlgebraicGeometry/Grassmannian/HopfIdeal.lean`.

When `H` is a commutative Hopf algebra and `N` lies on the Hopf-ideal locus
(`N.hopfIdealLocus = ⊥`), the ideal generated by `N` is the Hopf ideal `N.hopfIdeal hN`, so the
fibre of the universal quotient closed subscheme over `N` is the spectrum of the quotient Hopf
algebra, the rank-`k` finite locally free subgroup scheme `Module.Grassmannian.subgroupScheme N hN`
of `Spec (A ⊗[R] H)` (`Module.Grassmannian.comap_toPullbackHom_map_includeLeft_of_hopfIdealLocus`).

## Main definitions

* `Module.Grassmannian.schemeUniversalIdeal R H k`: the ideal sheaf on `G(k, H) ×_{Spec R} Spec H`
  of the universal quotient closed subscheme.
* `Module.Grassmannian.toPullbackHom N x`: the morphism `Spec A ⟶ G(k, H) ×_{Spec R} Spec H`
  classifying a point `N` of the Grassmannian together with an `A`-point `x` of `Spec H`.

## Main results

* `Module.Grassmannian.comap_toPullbackHom_schemeUniversalIdeal`: the inverse image of the
  universal quotient closed subscheme along `toPullbackHom N x` is the zero scheme of
  `N.evalIdeal x`.
* `Module.Grassmannian.schemeUniversalIdeal_le_ker_toPullbackHom_iff`: **the universal property**;
  the morphism `toPullbackHom N x` factors through the universal quotient closed subscheme exactly
  when every element of `N` vanishes at `x`.
* `Module.Grassmannian.isPullback_toPullbackHom_map_includeLeft`: the base change of
  `G(k, H) ×_{Spec R} Spec H ⟶ G(k, H)` along the morphism classifying `N` is
  `Spec (A ⊗[R] H) ⟶ Spec A`.
* `Module.Grassmannian.comap_toPullbackHom_map_includeLeft`: **the fibre over a point**; the
  inverse image of the universal quotient closed subscheme in this base change is the closed
  subscheme `Spec ((A ⊗[R] H) ⧸ Ideal.span N)`, and
  `Module.Grassmannian.comap_toPullbackHom_map_includeLeft_of_hopfIdealLocus` its form on the
  Hopf-ideal locus.

## References

* A. Grothendieck, J. Dieudonné, *Éléments de géométrie algébrique I* (Springer, 1971), 9.7, for
  the Grassmannian and its universal quotient.
* [The Stacks Project, Tag 089R](https://stacks.math.columbia.edu/tag/089R), for the Grassmannian
  functor.
-/

public section

universe u

open CategoryTheory Limits AlgebraicGeometry TensorProduct Scheme.IdealSheafData

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {H : Type u} [CommRing H] [Algebra R H] {k : ℕ}

section AffinePoint

/-- The sections of `G(k, H) ×_{Spec R} Spec H` over an open `U` form an `R`-algebra through the
structure morphism to `Spec R`. -/
@[instance_reducible]
private noncomputable def sectionsAlgebra
    (U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens) :
    Algebra R Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), U) :=
  ((Scheme.ΓSpecIso (.of R)).inv ≫ (pullback.fst _ _ ≫ toSpec R H k).appLE ⊤ U
    fun _ _ ↦ trivial).hom.toAlgebra

attribute [local instance] sectionsAlgebra

private theorem algebraMap_sections
    (U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens) :
    algebraMap R Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), U) =
      ((Scheme.ΓSpecIso (.of R)).inv ≫ (pullback.fst _ _ ≫ toSpec R H k).appLE ⊤ U
        fun _ _ ↦ trivial).hom :=
  rfl

/-- The inclusion of an affine open of `G(k, H) ×_{Spec R} Spec H` lies over `Spec R`. -/
private theorem fromSpec_fst_toSpec
    {U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U) :
    hU.fromSpec ≫ pullback.fst _ _ ≫ toSpec R H k =
      Spec.map (CommRingCat.ofHom (algebraMap R Γ(pullback (toSpec R H k)
        (Spec.map (CommRingCat.ofHom (algebraMap R H))), U))) := by
  rw [IsAffineOpen.fromSpec_comp_eq_SpecMap, algebraMap_sections, CommRingCat.ofHom_hom]

/-- The point of the Grassmannian over the sections of an affine open `U` of
`G(k, H) ×_{Spec R} Spec H` classifying the first projection on `U`. -/
private noncomputable def affinePoint
    {U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U) :
    G(k, Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), U) ⊗[R] H;
      Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), U)) :=
  (schemeHomEquiv R H k _).symm
    ⟨hU.fromSpec ≫ pullback.fst _ _, by rw [Category.assoc, fromSpec_fst_toSpec]⟩

private theorem toSchemeHom_affinePoint
    {U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U) :
    toSchemeHom (affinePoint hU) = hU.fromSpec ≫ pullback.fst _ _ :=
  toSchemeHom_schemeHomEquiv_symm_apply _

/-- The point of `Spec H` over the sections of an affine open `U` of `G(k, H) ×_{Spec R} Spec H`
given by the second projection on `U`. -/
private noncomputable def affineEval
    {U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U) :
    H →ₐ[R] Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), U) where
  toRingHom := ((Scheme.ΓSpecIso (.of H)).inv ≫ Scheme.Hom.appLE (pullback.snd _ _) ⊤ U le_top).hom
  commutes' r := by
    -- both sides are the ring map of `U ⟶ Spec R`, through either projection
    have h : CommRingCat.ofHom (algebraMap R H) ≫ (Scheme.ΓSpecIso (.of H)).inv ≫
        Scheme.Hom.appLE (pullback.snd _ _) ⊤ U le_top = CommRingCat.ofHom (algebraMap R _) :=
      Spec.map_injective <| by
        rw [Spec.map_comp, ← IsAffineOpen.fromSpec_comp_eq_SpecMap _ hU, Category.assoc,
          ← pullback.condition, fromSpec_fst_toSpec]
    exact congr(($h).hom r)

private theorem specMap_affineEval
    {U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U) :
    Spec.map (CommRingCat.ofHom (affineEval hU : H →+* _)) = hU.fromSpec ≫ pullback.snd _ _ := by
  rw [IsAffineOpen.fromSpec_comp_eq_SpecMap]
  -- `affineEval hU` is by definition the ring map on the left
  rfl

/-- Restriction of sections of `G(k, H) ×_{Spec R} Spec H`, as a map of `R`-algebras. -/
private noncomputable def resₐ
    {U V : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (h : V ≤ U) :
    Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), U) →ₐ[R]
      Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), V) where
  toRingHom :=
    ((pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).presheaf.map
      (homOfLE h).op).hom
  commutes' r := by
    simp only [algebraMap_sections]
    exact congr(($((pullback.fst _ _ ≫ toSpec R H k).appLE_map (U := ⊤) (fun _ _ ↦ trivial)
      (homOfLE h).op)).hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))

/-- The points classifying the first projection on nested affine opens are related by
restriction. -/
private theorem map_resₐ_affinePoint
    {U V : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U) (hV : IsAffineOpen V) (h : V ≤ U) :
    map (resₐ h) (affinePoint hU) = affinePoint hV := by
  apply toSchemeHom_injective
  rw [toSchemeHom_map, toSchemeHom_affinePoint, toSchemeHom_affinePoint]
  exact hU.map_fromSpec_assoc hV (homOfLE h).op _

/-- The points of `Spec H` given by the second projection on nested affine opens are related by
restriction. -/
private theorem resₐ_comp_affineEval
    {U V : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U) (hV : IsAffineOpen V) (h : V ≤ U) :
    (resₐ h).comp (affineEval hU) = affineEval hV :=
  AlgHom.ext fun y ↦ congr(($(Scheme.Hom.appLE_map (pullback.snd _ _) (U := ⊤) le_top
    (homOfLE h).op)).hom ((Scheme.ΓSpecIso (.of H)).inv.hom y))

end AffinePoint

attribute [local instance] sectionsAlgebra

variable (R H k) in
/-- The ideal sheaf of the **universal quotient closed subscheme** of `G(k, H) ×_{Spec R} Spec H`,
the relative spectrum over the Grassmannian scheme `G(k, H)` of the quotient of `𝒪 ⊗[R] H` by the
ideal generated by the universal submodule. Its inverse image along the morphism
`Spec (A ⊗[R] H) ⟶ G(k, H) ×_{Spec R} Spec H` induced by a point `N` of `G(k, A ⊗[R] H; A)` is
cut out by the ideal generated by `N`
(`Module.Grassmannian.comap_toPullbackHom_map_includeLeft`). Over an affine open `U`, its ideal is
`Module.Grassmannian.evalIdeal` of the point over `Γ(U)` classifying the inclusion of `U`. -/
noncomputable def schemeUniversalIdeal :
    (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).IdealSheafData where
  ideal U := (affinePoint U.2).evalIdeal (affineEval U.2)
  map_ideal_basicOpen U f := by
    rw [← map_resₐ_affinePoint U.2 (Scheme.affineBasicOpen _ f).2 (Scheme.basicOpen_le _ f),
      ← resₐ_comp_affineEval U.2 (Scheme.affineBasicOpen _ f).2 (Scheme.basicOpen_le _ f),
      ← map_evalIdeal]
    -- `resₐ` has underlying ring map the restriction to the basic open
    rfl

private theorem ideal_schemeUniversalIdeal
    {U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U) :
    (schemeUniversalIdeal R H k).ideal ⟨U, hU⟩ = (affinePoint hU).evalIdeal (affineEval hU) :=
  rfl

section ToPullbackHom

variable {A B : Type u} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]

/-- The morphism `Spec A ⟶ G(k, H) ×_{Spec R} Spec H` classifying a point `N` of
`G(k, A ⊗[R] H; A)` together with an `A`-point `x : H →ₐ[R] A` of `Spec H`. Every morphism
`Spec A ⟶ G(k, H) ×_{Spec R} Spec H` over `Spec R` arises in this way
(`Module.Grassmannian.exists_toPullbackHom_eq`). -/
noncomputable def toPullbackHom (N : G(k, A ⊗[R] H; A)) (x : H →ₐ[R] A) :
    Spec (.of A) ⟶ pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))) :=
  pullback.lift (toSchemeHom N) (Spec.map (CommRingCat.ofHom (x : H →+* A))) <| by
    rw [toSchemeHom_toSpec, ← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]

/-- The first component of `toPullbackHom N x` is the morphism classifying `N`. -/
@[reassoc (attr := simp)]
theorem toPullbackHom_fst (N : G(k, A ⊗[R] H; A)) (x : H →ₐ[R] A) :
    toPullbackHom N x ≫ pullback.fst _ _ = toSchemeHom N :=
  pullback.lift_fst _ _ _

/-- The second component of `toPullbackHom N x` is the point `x` of `Spec H`. -/
@[reassoc (attr := simp)]
theorem toPullbackHom_snd (N : G(k, A ⊗[R] H; A)) (x : H →ₐ[R] A) :
    toPullbackHom N x ≫ pullback.snd _ _ = Spec.map (CommRingCat.ofHom (x : H →+* A)) :=
  pullback.lift_snd _ _ _

/-- **Naturality.** The morphism classifying the base changes of `N` and `x` along
`f : A →ₐ[R] B` is the composite of `Spec B ⟶ Spec A` with the morphism classifying `N` and
`x`. -/
theorem toPullbackHom_map (f : A →ₐ[R] B) (N : G(k, A ⊗[R] H; A)) (x : H →ₐ[R] A) :
    toPullbackHom (map f N) (f.comp x) =
      Spec.map (CommRingCat.ofHom (f : A →+* B)) ≫ toPullbackHom N x :=
  pullback.hom_ext (by simp [toSchemeHom_map]) <| by
    rw [toPullbackHom_snd, Category.assoc, toPullbackHom_snd, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, AlgHom.comp_toRingHom]

/-- Every morphism `Spec A ⟶ G(k, H) ×_{Spec R} Spec H` over `Spec R` classifies a point of the
Grassmannian together with an `A`-point of `Spec H`. -/
theorem exists_toPullbackHom_eq
    (t : Spec (.of A) ⟶ pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))))
    (ht : t ≫ pullback.fst _ _ ≫ toSpec R H k =
      Spec.map (CommRingCat.ofHom (algebraMap R A))) :
    ∃ (N : G(k, A ⊗[R] H; A)) (x : H →ₐ[R] A), toPullbackHom N x = t := by
  obtain ⟨N, hN⟩ := exists_toSchemeHom_eq (t ≫ pullback.fst _ _) (by rw [Category.assoc, ht])
  obtain ⟨φ, hφ⟩ := Spec.map_surjective (t ≫ pullback.snd _ _)
  -- the ring map `φ : H → A` of the second projection is an `R`-algebra map, as `t` lies over
  -- `Spec R`
  have hφR : CommRingCat.ofHom (algebraMap R H) ≫ φ = CommRingCat.ofHom (algebraMap R A) :=
    Spec.map_injective <| by
      rw [Spec.map_comp, hφ, Category.assoc, ← pullback.condition, ht]
  refine ⟨N, { φ.hom with commutes' := fun r ↦ congr(($hφR).hom r) }, ?_⟩
  -- the `R`-algebra map built from `φ` has underlying ring map `φ`
  exact pullback.hom_ext (by rw [toPullbackHom_fst, hN]) (by rw [toPullbackHom_snd, ← hφ]; rfl)

end ToPullbackHom

variable {A : Type u} [CommRing A] [Algebra R A]

/-- The ideal of the universal quotient closed subscheme over an affine open `U`, extended along
an `R`-algebra map `φ : Γ(U) → C`, is `N.evalIdeal x` for the `C`-point `(N, x)` through which
`Spec C ⟶ U` factors. -/
private theorem map_ideal_schemeUniversalIdeal {C : Type u} [CommRing C] [Algebra R C]
    {U : (pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H)))).Opens}
    (hU : IsAffineOpen U)
    (φ : Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), U) →ₐ[R] C)
    (N : G(k, C ⊗[R] H; C)) (x : H →ₐ[R] C)
    (h : Spec.map (CommRingCat.ofHom (φ : _ →+* C)) ≫ hU.fromSpec = toPullbackHom N x) :
    ((schemeUniversalIdeal R H k).ideal ⟨U, hU⟩).map φ = N.evalIdeal x := by
  have hN : map φ (affinePoint hU) = N := toSchemeHom_injective <| by
    rw [toSchemeHom_map, toSchemeHom_affinePoint, ← Category.assoc, h, toPullbackHom_fst]
  have hx : φ.comp (affineEval hU) = x := by
    have h' : Spec.map (CommRingCat.ofHom (φ.comp (affineEval hU) : H →+* C)) =
        Spec.map (CommRingCat.ofHom (x : H →+* C)) := by
      rw [AlgHom.comp_toRingHom, CommRingCat.ofHom_comp, Spec.map_comp, specMap_affineEval,
        ← Category.assoc, h, toPullbackHom_snd]
    exact AlgHom.toRingHom_injective (congrArg CommRingCat.Hom.hom (Spec.map_injective h'))
  rw [ideal_schemeUniversalIdeal, map_evalIdeal, hN, hx]

/-- **The inverse image of the universal quotient closed subscheme along a point.** For an
`R`-algebra `A`, a point `N` of `G(k, A ⊗[R] H; A)` and an `A`-point `x` of `Spec H`, the inverse
image of the universal quotient closed subscheme along the morphism
`Spec A ⟶ G(k, H) ×_{Spec R} Spec H` classifying `(N, x)` is the zero scheme of `N.evalIdeal x`. -/
theorem comap_toPullbackHom_schemeUniversalIdeal (N : G(k, A ⊗[R] H; A)) (x : H →ₐ[R] A) :
    (schemeUniversalIdeal R H k).comap (toPullbackHom N x) =
      ofIdealTop ((N.evalIdeal x).map (Scheme.ΓSpecIso (.of A)).inv.hom) := by
  -- compare both sides on the affine opens `V` of `Spec A` mapped into an affine open `U`
  refine ext_of_iSup_eq_top _ (toPullbackHom N x).iSup_affineOpens_le_preimage_eq_top
    fun ⟨V, U, hVU⟩ ↦ ?_
  have hU : IsAffineOpen U.1 := U.2
  have hV : IsAffineOpen V.1 := V.2
  -- the restriction `A → Γ(V)`, as a map of `R`-algebras
  let ψ₀ : A →+* Γ(Spec (.of A), V) :=
    ((Scheme.ΓSpecIso (.of A)).inv ≫ (Spec (.of A)).presheaf.map (homOfLE le_top).op).hom
  let : Algebra R Γ(Spec (.of A), V) := (ψ₀.comp (algebraMap R A)).toAlgebra
  let ψ : A →ₐ[R] Γ(Spec (.of A), V) := { ψ₀ with commutes' := fun _ ↦ rfl }
  have hψ : Spec.map (CommRingCat.ofHom (ψ : A →+* Γ(Spec (.of A), V))) = hV.fromSpec := by
    rw [← (isAffineOpen_top _).map_fromSpec hV (homOfLE le_top).op, IsAffineOpen.fromSpec_top,
      Scheme.isoSpec_Spec_inv, ← Spec.map_comp]
    -- `ψ` is by definition the ring map of this composite
    rfl
  -- the map `Γ(U) → Γ(V)` induced by the morphism classifying `(N, x)`, as a map of `R`-algebras
  have hφ : Spec.map ((toPullbackHom N x).appLE U V hVU) ≫ hU.fromSpec =
      toPullbackHom (map ψ N) (ψ.comp x) := by
    rw [IsAffineOpen.SpecMap_appLE_fromSpec _ hU hV, toPullbackHom_map, hψ]
  let φ : Γ(pullback (toSpec R H k) (Spec.map (CommRingCat.ofHom (algebraMap R H))), U) →ₐ[R]
      Γ(Spec (.of A), V) :=
    { ((toPullbackHom N x).appLE U V hVU).hom with
      commutes' r := by
        have h : CommRingCat.ofHom (algebraMap R _) ≫ (toPullbackHom N x).appLE U V hVU =
            CommRingCat.ofHom (algebraMap R A) ≫ CommRingCat.ofHom (ψ : A →+* Γ(Spec (.of A), V)) :=
          Spec.map_injective <| by
            rw [Spec.map_comp, ← fromSpec_fst_toSpec hU, reassoc_of% hφ, toPullbackHom_fst_assoc,
              toSchemeHom_toSpec, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
        exact congr(($h).hom r) }
  calc ((schemeUniversalIdeal R H k).comap (toPullbackHom N x)).ideal V
      _ = ((schemeUniversalIdeal R H k).ideal U).map φ :=
        ideal_comap_of_le _ (toPullbackHom N x) U V hVU
      _ = (map ψ N).evalIdeal (ψ.comp x) := map_ideal_schemeUniversalIdeal hU φ _ _ hφ
      _ = (N.evalIdeal x).map ψ := (map_evalIdeal ψ N x).symm
      _ = (ofIdealTop ((N.evalIdeal x).map (Scheme.ΓSpecIso (.of A)).inv.hom)).ideal V := by
        rw [ofIdealTop_ideal, Ideal.map_map]
        -- `ψ` is by definition the composite of these two ring maps
        rfl

/-- **The universal property of the universal quotient closed subscheme.** For an `R`-algebra
`A`, the morphism `Spec A ⟶ G(k, H) ×_{Spec R} Spec H` classifying a point `N` of
`G(k, A ⊗[R] H; A)` and an `A`-point `x` of `Spec H` factors through the universal quotient closed
subscheme exactly when `N.evalIdeal x` vanishes, that is, exactly when every element of `N`
vanishes at `x` (`Module.Grassmannian.evalIdeal_eq_bot_iff`). -/
theorem schemeUniversalIdeal_le_ker_toPullbackHom_iff (N : G(k, A ⊗[R] H; A))
    (x : H →ₐ[R] A) :
    schemeUniversalIdeal R H k ≤ (toPullbackHom N x).ker ↔ N.evalIdeal x = ⊥ := by
  calc schemeUniversalIdeal R H k ≤ (toPullbackHom N x).ker
      -- a morphism factors through a closed subscheme when it pulls back its ideal sheaf to `⊥`
      _ ↔ (schemeUniversalIdeal R H k).comap (toPullbackHom N x) = ⊥ := by
        rw [← Scheme.IdealSheafData.map_bot, le_map_iff_comap_le, le_bot_iff]
      _ ↔ (N.evalIdeal x).map (Scheme.ΓSpecIso (.of A)).inv.hom = ⊥ := by
        rw [comap_toPullbackHom_schemeUniversalIdeal, ofIdealTop_eq_bot_iff]
      -- `Γ(Spec A, ⊤) ≅ A` is injective
      _ ↔ N.evalIdeal x = ⊥ := Ideal.map_eq_bot_iff_of_injective
        (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of A)).inv).1

/-- **Base change along a point.** For a point `N` of `G(k, A ⊗[R] H; A)`, the base change of the
projection `G(k, H) ×_{Spec R} Spec H ⟶ G(k, H)` along the morphism `Spec A ⟶ G(k, H)`
classifying `N` is `Spec (A ⊗[R] H) ⟶ Spec A`, mapping to the fibre product by the morphism
classifying the base change of `N` to `A ⊗[R] H` and the point `h ↦ 1 ⊗ h` of `Spec H`. -/
theorem isPullback_toPullbackHom_map_includeLeft (N : G(k, A ⊗[R] H; A)) :
    IsPullback (toPullbackHom (map Algebra.TensorProduct.includeLeft N)
        Algebra.TensorProduct.includeRight)
      (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        A →+* A ⊗[R] H)))
      (pullback.fst _ _) (toSchemeHom N) := by
  refine IsPullback.of_right ?_ ?_ (IsPullback.of_hasPullback _ _).flip
  · -- the outer square is the pullback of affine schemes `Spec (A ⊗[R] H)`
    rw [toPullbackHom_snd, toSchemeHom_toSpec]
    exact (isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct R A H)).flip
  · rw [toPullbackHom_fst, toSchemeHom_map]
    -- `includeLeftRingHom` is the ring map underlying `includeLeft`
    rfl

/-- **The fibre of the universal quotient closed subscheme over a point.** For a point `N` of
`G(k, A ⊗[R] H; A)`, the inverse image of the universal quotient closed subscheme in the base
change `Spec (A ⊗[R] H)` of `G(k, H) ×_{Spec R} Spec H` along the morphism classifying `N`
(`Module.Grassmannian.isPullback_toPullbackHom_map_includeLeft`) is the closed subscheme
`Spec ((A ⊗[R] H) ⧸ Ideal.span N)`, cut out by the ideal generated by `N`. -/
theorem comap_toPullbackHom_map_includeLeft (N : G(k, A ⊗[R] H; A)) :
    (schemeUniversalIdeal R H k).comap (toPullbackHom (map Algebra.TensorProduct.includeLeft N)
        Algebra.TensorProduct.includeRight) =
      ofIdealTop ((Ideal.span (N.toSubmodule : Set (A ⊗[R] H))).map
        (Scheme.ΓSpecIso (.of (A ⊗[R] H))).inv.hom) := by
  rw [comap_toPullbackHom_schemeUniversalIdeal, evalIdeal_map_includeLeft]

/-- **The fibre over a point of the Hopf-ideal locus.** For a commutative Hopf algebra `H'` over
`R` and a point `N` of `G(k, A ⊗[R] H'; A)` on the Hopf-ideal locus, the inverse image of the
universal quotient closed subscheme in the base change `Spec (A ⊗[R] H')` along the morphism
classifying `N` is cut out by the Hopf ideal `N.hopfIdeal hN`, the ideal defining the subgroup
scheme `Module.Grassmannian.subgroupScheme N hN`. -/
theorem comap_toPullbackHom_map_includeLeft_of_hopfIdealLocus {H' : Type u} [CommRing H']
    [HopfAlgebra R H'] (N : G(k, A ⊗[R] H'; A)) (hN : N.hopfIdealLocus = ⊥) :
    (schemeUniversalIdeal R H' k).comap (toPullbackHom (map Algebra.TensorProduct.includeLeft N)
        Algebra.TensorProduct.includeRight) =
      ofIdealTop ((N.hopfIdeal hN).map (Scheme.ΓSpecIso (.of (A ⊗[R] H'))).inv.hom) := by
  rw [comap_toPullbackHom_map_includeLeft, span_toSubmodule_eq_hopfIdeal]

end Module.Grassmannian
