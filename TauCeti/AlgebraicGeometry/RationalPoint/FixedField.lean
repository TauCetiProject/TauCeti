module

public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import TauCeti.FieldTheory.Galois.FixedField

/-!
# Points over a fixed field

Let `ι : F →+* L` be a homomorphism of fields whose image is the set of elements of `L` fixed by
a family `S` of ring endomorphisms of `L`. For every scheme `X`, composition with
`Spec L ⟶ Spec F` identifies the `F`-valued points of `X` with the `L`-valued points fixed by
`S`, where `σ ∈ S` acts on `x : Spec L ⟶ X` by `Spec.map σ ≫ x`
(`TauCeti.AlgebraicGeometry.fromSpecEquivOfRangeEq`). No finiteness hypothesis is put on `X`: a
point of `X` with values in a field is a point `y` of `X` together with an embedding of the
residue field `κ(y)` (`AlgebraicGeometry.Scheme.SpecToEquivOfField`), and such an embedding into
`L` is fixed by `S` exactly when it lands in the image of `F`.

The relative form over a base ring `k` (`fromSpecOverEquivOfRangeEq`) keeps track of the
structure morphism `X ⟶ Spec k`. Its main instance is Galois descent for a single automorphism:
for `σ : L ≃ₐ[k] L` the points of a `k`-scheme with values in the fixed field of the cyclic group
generated by `σ` are the `σ`-fixed `L`-valued points (`fromSpecFixedFieldEquiv`). Over a finite
field `k` with `q` elements and `σ` the `r`-th power, `r ≠ 0`, of the arithmetic Frobenius
`x ↦ x ^ q` of an algebraic closure `L`, that fixed field is the subfield of `L` with `q ^ r`
elements, so the points of `X` over the degree-`r` extension of `k` are the `L`-valued points
fixed by the `r`-th power of Frobenius. This is the identification underlying the count of
rational points of varieties over finite fields by fixed points of Frobenius.

For a ring `k` and a field `L` over `k`, `numberOfRationalPoints L a` is the number of
`L`-valued points of a `k`-scheme `a : X ⟶ Spec k`, with the convention of `Nat.card` that an
infinite set of points has count `0`. It is multiplicative in fibre products over `k`
(`numberOfRationalPoints_pullback`). With values in the fixed field of an automorphism `σ` it
counts the `σ`-fixed `L`-valued points (`numberOfRationalPoints_fixedField_eq_natCard`), so over
a finite field the points over the degree-`r` extension are counted by the fixed points of the
`r`-th power of Frobenius.

## Main definitions

* `TauCeti.AlgebraicGeometry.fromSpecEquivOfRangeEq`: `F`-valued points of a scheme are the
  `L`-valued points fixed by `S`.
* `TauCeti.AlgebraicGeometry.fromSpecOverEquivOfRangeEq`: the same for points over `Spec k`.
* `TauCeti.AlgebraicGeometry.fromSpecFixedFieldEquiv`: points with values in the fixed field of
  `σ` are the `σ`-fixed points.
* `TauCeti.AlgebraicGeometry.numberOfRationalPoints`: the number of `L`-valued points of a
  `k`-scheme.

## Main results

* `TauCeti.AlgebraicGeometry.epi_SpecMap_ofHom`: the spectrum of a homomorphism of fields is an
  epimorphism of schemes.
* `TauCeti.AlgebraicGeometry.SpecMap_inv_comp_eq_self_iff`: a point is fixed by an automorphism
  exactly when it is fixed by its inverse, so arithmetic and geometric Frobenius have the same
  fixed points.
* `TauCeti.AlgebraicGeometry.numberOfRationalPoints_pullback`: point counts are multiplicative in
  fibre products.

## References

* R. Hartshorne, *Algebraic Geometry*, Exercise II.2.7, for morphisms from the spectrum of a
  field, formalized in Mathlib as `AlgebraicGeometry.Scheme.SpecToEquivOfField`.
* P. Deligne, *Cohomologie étale (SGA 4½)*, Rapport, §1, for rational points over finite fields
  as fixed points of Frobenius.
-/

public section

open CategoryTheory Limits AlgebraicGeometry IntermediateField

universe u

namespace TauCeti.AlgebraicGeometry

variable {F L : Type u} [Field F] [Field L]

/-- The spectrum of a homomorphism of fields is an epimorphism of schemes: it is flat and
surjective. -/
instance epi_SpecMap_ofHom (ι : F →+* L) : Epi (Spec.map (CommRingCat.ofHom ι)) := by
  obtain ⟨_, _⟩ := (flat_and_surjective_SpecMap_iff (CommRingCat.ofHom ι)).mpr (by
    algebraize [ι]
    exact inferInstanceAs <| Module.FaithfullyFlat F L)
  exact Flat.epi_of_flat_of_surjective _

section FixedPoints

variable (ι : F →+* L) (S : Set (L →+* L))

/-- An embedding `ψ` of the residue field of `X` at `y` into `L` that is fixed by `S` factors
through `ι`, when the image of `ι` is the set of `S`-fixed elements: if the point
`Spec.map ψ ≫ X.fromSpecResidueField y` is fixed by every `σ ∈ S`, it is the image of an
`F`-valued point. -/
private theorem exists_SpecMap_comp_eq (hι : Set.range ι = {a | ∀ σ ∈ S, σ a = a})
    {X : Scheme.{u}} (y : X) (ψ : X.residueField y ⟶ CommRingCat.of L)
    (hψ : ∀ σ ∈ S, Spec.map (CommRingCat.ofHom σ) ≫ Spec.map ψ ≫ X.fromSpecResidueField y =
      Spec.map ψ ≫ X.fromSpecResidueField y) :
    ∃ g : Spec (.of F) ⟶ X,
      Spec.map (CommRingCat.ofHom ι) ≫ g = Spec.map ψ ≫ X.fromSpecResidueField y := by
  -- `ψ` is fixed by `S` as a ring homomorphism, so it lands in the image of `ι`
  have hfix (a : X.residueField y) : ψ a ∈ ι.fieldRange := by
    rw [RingHom.mem_fieldRange, ← Set.mem_range, hι]
    intro σ hσ
    have h := hψ σ hσ
    rw [← Category.assoc, ← Spec.map_comp] at h
    obtain ⟨_, h⟩ := Scheme.SpecToEquivOfField_eq_iff.mp <| (X.SpecToEquivOfField L).symm.injective
      (a₁ := ⟨y, ψ ≫ CommRingCat.ofHom σ⟩) (a₂ := ⟨y, ψ⟩) h
    simpa using congr($h a)
  refine ⟨Spec.map (CommRingCat.ofHom (ι.rangeRestrictFieldEquiv.symm.toRingHom.comp
    (ψ.hom.codRestrict ι.fieldRange.toSubring hfix))) ≫ X.fromSpecResidueField y, ?_⟩
  rw [← Category.assoc, ← Spec.map_comp]
  congr 2
  ext a
  exact ι.rangeRestrictFieldEquiv_apply_symm_apply ⟨ψ a, hfix a⟩

/-- **Points over a fixed field.** Let `ι : F →+* L` be a homomorphism of fields whose image is
the set of elements of `L` fixed by every `σ ∈ S`. Composition with `Spec.map ι` identifies the
`F`-valued points of any scheme `X` with its `L`-valued points `x` fixed by `S`, that is, with
`Spec.map σ ≫ x = x` for `σ ∈ S`. -/
noncomputable def fromSpecEquivOfRangeEq (hι : Set.range ι = {a | ∀ σ ∈ S, σ a = a})
    (X : Scheme.{u}) :
    (Spec (.of F) ⟶ X) ≃
      {x : Spec (.of L) ⟶ X // ∀ σ ∈ S, Spec.map (CommRingCat.ofHom σ) ≫ x = x} :=
  Equiv.ofBijective (fun g ↦ ⟨Spec.map (CommRingCat.ofHom ι) ≫ g, fun σ hσ ↦ by
      have h : σ.comp ι = ι := RingHom.ext fun a ↦ by
        have : ι a ∈ Set.range ι := Set.mem_range_self a
        rw [hι] at this
        exact this σ hσ
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, h]⟩)
    ⟨fun g₁ g₂ h ↦ (cancel_epi _).mp congr(($h : Spec (.of L) ⟶ X)), fun ⟨x, hx⟩ ↦ by
      obtain ⟨⟨y, ψ⟩, rfl⟩ := (X.SpecToEquivOfField L).symm.surjective x
      obtain ⟨g, hg⟩ := exists_SpecMap_comp_eq ι S hι y ψ hx
      exact ⟨g, Subtype.ext hg⟩⟩

/-- The `L`-valued point attached to an `F`-valued point `g` is `Spec.map ι ≫ g`. -/
@[simp]
theorem coe_fromSpecEquivOfRangeEq_apply (hι : Set.range ι = {a | ∀ σ ∈ S, σ a = a})
    {X : Scheme.{u}} (g : Spec (.of F) ⟶ X) :
    (fromSpecEquivOfRangeEq ι S hι X g : Spec (.of L) ⟶ X) = Spec.map (CommRingCat.ofHom ι) ≫ g :=
  (rfl)

/-- The `F`-valued point attached to an `S`-fixed `L`-valued point `x` recovers `x` after
composition with `Spec.map ι`. -/
@[simp]
theorem SpecMap_comp_fromSpecEquivOfRangeEq_symm_apply
    (hι : Set.range ι = {a | ∀ σ ∈ S, σ a = a}) {X : Scheme.{u}}
    (x : {x : Spec (.of L) ⟶ X // ∀ σ ∈ S, Spec.map (CommRingCat.ofHom σ) ≫ x = x}) :
    Spec.map (CommRingCat.ofHom ι) ≫ (fromSpecEquivOfRangeEq ι S hι X).symm x = x := by
  rw [← coe_fromSpecEquivOfRangeEq_apply ι S hι, Equiv.apply_symm_apply]

end FixedPoints

section Over

variable {k : Type u} [CommRing k] [Algebra k F] [Algebra k L] (ι : F →ₐ[k] L)
  (S : Set (L →+* L))

/-- An `F`-valued point `g` of a `k`-scheme lies over `Spec k` exactly when the `L`-valued point
`Spec.map ι ≫ g` does. -/
theorem SpecMap_comp_comp_eq_iff {X : Scheme.{u}} (a : X ⟶ Spec (.of k))
    (g : Spec (.of F) ⟶ X) :
    Spec.map (CommRingCat.ofHom (ι : F →+* L)) ≫ g ≫ a =
        Spec.map (CommRingCat.ofHom (algebraMap k L)) ↔
      g ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k F)) := by
  rw [← ι.comp_algebraMap, CommRingCat.ofHom_comp, Spec.map_comp, cancel_epi]

/-- **Points over a fixed field, relative form.** Let `ι : F →ₐ[k] L` be a homomorphism of
`k`-algebras between fields whose image is the set of elements of `L` fixed by every `σ ∈ S`.
Composition with `Spec.map ι` identifies the points of a `k`-scheme `a : X ⟶ Spec k` with values
in `F` with its `L`-valued points fixed by `S`. -/
noncomputable def fromSpecOverEquivOfRangeEq (hι : Set.range ι = {a | ∀ σ ∈ S, σ a = a})
    {X : Scheme.{u}} (a : X ⟶ Spec (.of k)) :
    {g : Spec (.of F) ⟶ X // g ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k F))} ≃
      {x : Spec (.of L) ⟶ X // x ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k L)) ∧
        ∀ σ ∈ S, Spec.map (CommRingCat.ofHom σ) ≫ x = x} :=
  ((fromSpecEquivOfRangeEq (ι : F →+* L) S (by simpa using hι) X).subtypeEquiv fun g ↦ by
      rw [coe_fromSpecEquivOfRangeEq_apply, Category.assoc, SpecMap_comp_comp_eq_iff]).trans <|
    (Equiv.subtypeSubtypeEquivSubtypeInter _ _).trans (Equiv.subtypeEquivRight fun _ ↦ and_comm)

/-- The `L`-valued point attached to an `F`-valued point `g` over `Spec k` is
`Spec.map ι ≫ g`. -/
@[simp]
theorem coe_fromSpecOverEquivOfRangeEq_apply (hι : Set.range ι = {a | ∀ σ ∈ S, σ a = a})
    {X : Scheme.{u}} (a : X ⟶ Spec (.of k))
    (g : {g : Spec (.of F) ⟶ X // g ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k F))}) :
    (fromSpecOverEquivOfRangeEq ι S hι a g : Spec (.of L) ⟶ X) =
      Spec.map (CommRingCat.ofHom (ι : F →+* L)) ≫ g :=
  (rfl)

/-- The `F`-valued point over `Spec k` attached to an `S`-fixed `L`-valued point `x` recovers `x`
after composition with `Spec.map ι`. -/
@[simp]
theorem SpecMap_comp_fromSpecOverEquivOfRangeEq_symm_apply
    (hι : Set.range ι = {a | ∀ σ ∈ S, σ a = a}) {X : Scheme.{u}} (a : X ⟶ Spec (.of k))
    (x : {x : Spec (.of L) ⟶ X // x ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k L)) ∧
      ∀ σ ∈ S, Spec.map (CommRingCat.ofHom σ) ≫ x = x}) :
    Spec.map (CommRingCat.ofHom (ι : F →+* L)) ≫ ((fromSpecOverEquivOfRangeEq ι S hι a).symm x :
      Spec (.of F) ⟶ X) = x := by
  rw [← coe_fromSpecOverEquivOfRangeEq_apply ι S hι a, Equiv.apply_symm_apply]

end Over

section FixedField

variable {k : Type u} [Field k] [Algebra k L]

/-- **Galois descent of points for one automorphism.** For an automorphism `σ` of a field
extension `L / k`, the points of a `k`-scheme with values in the fixed field of the cyclic group
generated by `σ` are its `L`-valued points `x` fixed by `σ`, that is, with `Spec.map σ ≫ x = x`.

For `k` finite with `q` elements, `L` an algebraic closure and `σ` the `r`-th power, `r ≠ 0`, of
the arithmetic Frobenius `FiniteField.frobeniusAlgEquivOfAlgebraic k L`, the fixed field is the
subfield of `L` with `q ^ r` elements
(`TauCeti.natCard_fixedField_zpowers_frobeniusAlgEquivOfAlgebraic_pow`). -/
noncomputable def fromSpecFixedFieldEquiv (σ : L ≃ₐ[k] L) {X : Scheme.{u}}
    (a : X ⟶ Spec (.of k)) :
    {g : Spec (.of (fixedField (Subgroup.zpowers σ))) ⟶ X //
        g ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k (fixedField (Subgroup.zpowers σ))))} ≃
      {x : Spec (.of L) ⟶ X // x ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k L)) ∧
        Spec.map (CommRingCat.ofHom (σ : L →+* L)) ≫ x = x} :=
  (fromSpecOverEquivOfRangeEq (fixedField (Subgroup.zpowers σ)).val {(σ : L →+* L)}
      (by ext; simp [mem_fixedField_zpowers_iff, -mem_fixedField_iff]) a).trans
    (Equiv.subtypeEquivRight fun _ ↦ by simp)

/-- The `σ`-fixed `L`-valued point attached to a point `g` with values in the fixed field is the
composite of `g` with the inclusion of the fixed field. -/
@[simp]
theorem coe_fromSpecFixedFieldEquiv_apply (σ : L ≃ₐ[k] L) {X : Scheme.{u}}
    (a : X ⟶ Spec (.of k))
    (g : {g : Spec (.of (fixedField (Subgroup.zpowers σ))) ⟶ X //
      g ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k (fixedField (Subgroup.zpowers σ))))}) :
    (fromSpecFixedFieldEquiv σ a g : Spec (.of L) ⟶ X) =
      Spec.map (CommRingCat.ofHom (algebraMap (fixedField (Subgroup.zpowers σ)) L)) ≫ g :=
  (rfl)

/-- The point with values in the fixed field attached to a `σ`-fixed `L`-valued point `x`
recovers `x` after composition with the inclusion of the fixed field. -/
@[simp]
theorem SpecMap_comp_fromSpecFixedFieldEquiv_symm_apply (σ : L ≃ₐ[k] L) {X : Scheme.{u}}
    (a : X ⟶ Spec (.of k))
    (x : {x : Spec (.of L) ⟶ X // x ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k L)) ∧
        Spec.map (CommRingCat.ofHom (σ : L →+* L)) ≫ x = x}) :
    Spec.map (CommRingCat.ofHom (algebraMap (fixedField (Subgroup.zpowers σ)) L)) ≫
      ((fromSpecFixedFieldEquiv σ a).symm x : Spec (.of (fixedField (Subgroup.zpowers σ))) ⟶ X) =
      x := by
  rw [← coe_fromSpecFixedFieldEquiv_apply σ a, Equiv.apply_symm_apply]

/-- A field-valued point is fixed by an automorphism exactly when it is fixed by its inverse. For
the arithmetic Frobenius of a finite field this says that arithmetic and geometric Frobenius,
and their powers, have the same fixed points. -/
theorem SpecMap_inv_comp_eq_self_iff (σ : L ≃ₐ[k] L) {X : Scheme.{u}} (x : Spec (.of L) ⟶ X) :
    Spec.map (CommRingCat.ofHom ((σ⁻¹ : L ≃ₐ[k] L) : L →+* L)) ≫ x = x ↔
      Spec.map (CommRingCat.ofHom (σ : L →+* L)) ≫ x = x := by
  suffices h : ∀ τ : L ≃ₐ[k] L, Spec.map (CommRingCat.ofHom (τ : L →+* L)) ≫ x = x →
      Spec.map (CommRingCat.ofHom ((τ⁻¹ : L ≃ₐ[k] L) : L →+* L)) ≫ x = x from
    ⟨fun hx ↦ inv_inv σ ▸ h σ⁻¹ hx, h σ⟩
  intro τ hx
  have h : ((τ⁻¹ : L ≃ₐ[k] L) : L →+* L).comp (τ : L →+* L) = RingHom.id L := by
    ext; simp
  conv_lhs => rw [← hx]
  rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, h, CommRingCat.ofHom_id,
    Spec.map_id, Category.id_comp]

end FixedField

section Count

variable {k : Type u} [CommRing k]

variable (L) in
/-- The number of `L`-valued points of a scheme `a : X ⟶ Spec k` over `Spec k`. With the
convention of `Nat.card`, it is `0` when there are infinitely many such points. -/
noncomputable def numberOfRationalPoints [Algebra k L] {X : Scheme.{u}}
    (a : X ⟶ Spec (.of k)) : ℕ :=
  Nat.card {x : Spec (.of L) ⟶ X // x ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k L))}

/-- Unfolding lemma for `numberOfRationalPoints`. -/
theorem numberOfRationalPoints_def [Algebra k L] {X : Scheme.{u}} (a : X ⟶ Spec (.of k)) :
    numberOfRationalPoints L a =
      Nat.card {x : Spec (.of L) ⟶ X // x ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k L))} :=
  (rfl)

/-- The points of a fibre product `X ×_S Y` lying over a morphism `s : T ⟶ S` are the pairs of
points of `X` and of `Y` lying over `s`. -/
noncomputable def pullbackPointsEquiv {T S X Y : Scheme.{u}} (s : T ⟶ S) (a : X ⟶ S)
    (b : Y ⟶ S) :
    {z : T ⟶ pullback a b // z ≫ pullback.fst a b ≫ a = s} ≃
      {x : T ⟶ X // x ≫ a = s} × {y : T ⟶ Y // y ≫ b = s} where
  toFun z := (⟨z.1 ≫ pullback.fst a b, by rw [Category.assoc, z.2]⟩,
    ⟨z.1 ≫ pullback.snd a b, by rw [Category.assoc, ← pullback.condition, z.2]⟩)
  invFun xy := ⟨pullback.lift xy.1.1 xy.2.1 (by rw [xy.1.2, xy.2.2]), by
    rw [pullback.lift_fst_assoc, xy.1.2]⟩
  left_inv z := Subtype.ext <| pullback.hom_ext (by simp) (by simp)
  right_inv xy := by ext <;> simp

/-- The first component of a point of `X ×_S Y` is its composite with the first projection. -/
@[simp]
theorem coe_pullbackPointsEquiv_apply_fst {T S X Y : Scheme.{u}} (s : T ⟶ S) (a : X ⟶ S)
    (b : Y ⟶ S) (z : {z : T ⟶ pullback a b // z ≫ pullback.fst a b ≫ a = s}) :
    ((pullbackPointsEquiv s a b z).1 : T ⟶ X) = z.1 ≫ pullback.fst a b :=
  (rfl)

/-- The second component of a point of `X ×_S Y` is its composite with the second projection. -/
@[simp]
theorem coe_pullbackPointsEquiv_apply_snd {T S X Y : Scheme.{u}} (s : T ⟶ S) (a : X ⟶ S)
    (b : Y ⟶ S) (z : {z : T ⟶ pullback a b // z ≫ pullback.fst a b ≫ a = s}) :
    ((pullbackPointsEquiv s a b z).2 : T ⟶ Y) = z.1 ≫ pullback.snd a b :=
  (rfl)

/-- The point of `X ×_S Y` attached to a pair of points is the induced map into the fibre
product. -/
@[simp]
theorem coe_pullbackPointsEquiv_symm_apply {T S X Y : Scheme.{u}} (s : T ⟶ S) (a : X ⟶ S)
    (b : Y ⟶ S) (xy : {x : T ⟶ X // x ≫ a = s} × {y : T ⟶ Y // y ≫ b = s}) :
    ((pullbackPointsEquiv s a b).symm xy : T ⟶ pullback a b) =
      pullback.lift xy.1.1 xy.2.1 (by rw [xy.1.2, xy.2.2]) :=
  (rfl)

/-- **Point counts are multiplicative in fibre products.** The number of `L`-valued points of
`X ×_k Y` is the product of the numbers of `L`-valued points of `X` and of `Y`; with the
convention of `Nat.card`, both sides are `0` as soon as one factor has infinitely many points and
the other has at least one. -/
theorem numberOfRationalPoints_pullback [Algebra k L] {X Y : Scheme.{u}} (a : X ⟶ Spec (.of k))
    (b : Y ⟶ Spec (.of k)) :
    numberOfRationalPoints L (pullback.fst a b ≫ a) =
      numberOfRationalPoints L a * numberOfRationalPoints L b := by
  rw [numberOfRationalPoints_def, Nat.card_congr (pullbackPointsEquiv _ a b), Nat.card_prod,
    numberOfRationalPoints_def, numberOfRationalPoints_def]

/-- Over a field `k`, the number of points of a `k`-scheme with values in the fixed field of an
automorphism `σ` of `L / k` is the number of its `σ`-fixed `L`-valued points. -/
theorem numberOfRationalPoints_fixedField_eq_natCard {k : Type u} [Field k] [Algebra k L]
    (σ : L ≃ₐ[k] L) {X : Scheme.{u}} (a : X ⟶ Spec (.of k)) :
    numberOfRationalPoints (fixedField (Subgroup.zpowers σ)) a =
      Nat.card {x : Spec (.of L) ⟶ X // x ≫ a = Spec.map (CommRingCat.ofHom (algebraMap k L)) ∧
        Spec.map (CommRingCat.ofHom (σ : L →+* L)) ≫ x = x} :=
  Nat.card_congr (fromSpecFixedFieldEquiv σ a)

end Count

end TauCeti.AlgebraicGeometry
