import Mathlib.RingTheory.Spectrum.Prime.Topology

/-!
# Linear morphisms of affine spaces and geometric Noether normalization

Over any base scheme `S`, a matrix `C : Matrix d n Γ(S, ⊤)` with `n` finite defines an `S`-morphism
`AffineSpace.linearMap S C : 𝔸(n; S) ⟶ 𝔸(d; S)` pulling back the `i`-th coordinate of `𝔸(d; S)` to
`∑ j, (𝔸(n; S) ↘ S).appTop (C i j) * coord S j`. Matrix multiplication corresponds contravariantly
to composition of affine-space morphisms (`linearMap_mul`), and the identity matrix induces the
identity morphism (`linearMap_one`).

Over an affine base `Spec R`, any tuple `x : n → A` in an `R`-algebra `A` induces a canonical
`Spec R`-morphism `specHomOfTuple R x : Spec (.of A) ⟶ 𝔸(n; Spec (.of R))`, equal to
`Spec.map (MvPolynomial.aeval x) ≫ (SpecIso n (.of R)).inv`:

* `isClosedImmersion_specHomOfTuple`: when `x` generates `A` over `R`, `specHomOfTuple R x` is a
  closed immersion;
* `isFinite_specHomOfTuple_iff`: `specHomOfTuple R y` is a finite morphism if and only if
  `MvPolynomial.aeval y` is module-finite;
* `surjective_specHomOfTuple`: when `y` is algebraically independent over `R` and `aeval y` is
  integral, `specHomOfTuple R y` is surjective;
* `specHomOfTuple_comp_linearMap`: composing `specHomOfTuple R x` with `linearMap` for a matrix `C`
  yields `specHomOfTuple R (fun i ↦ ∑ j, C i j • x j)`;
* `exists_linear_normalization`: over an infinite field `k`, for any nontrivial `k`-algebra `A`
  generated by `x : Fin n → A`, the closed immersion `Spec A ↪ 𝔸ⁿ_k` determined by `x` composes
  with a linear projection `𝔸ⁿ_k ⟶ 𝔸ᵈ_k` (`d ≤ n`, `ringKrullDim A = d`) to a finite surjective
  `k`-morphism `Spec A ⟶ 𝔸ᵈ_k`.
-/

public section

open CategoryTheory

namespace AlgebraicGeometry.AffineSpace

universe u

noncomputable section

section LinearMap

/-- The `S`-morphism `𝔸(n; S) ⟶ 𝔸(d; S)` defined by a matrix `C : Matrix d n Γ(S, ⊤)`, pulling
back the `i`-th coordinate of `𝔸(d; S)` to the linear form
`∑ j, (𝔸(n; S) ↘ S).appTop (C i j) * coord S j`. -/
def linearMap {d n : Type u} [Fintype n] (S : Scheme.{u}) (C : Matrix d n Γ(S, ⊤)) :
    𝔸(n; S) ⟶ 𝔸(d; S) :=
  homOfVector (𝔸(n; S) ↘ S) fun i ↦ ∑ j, (𝔸(n; S) ↘ S).appTop (C i j) * coord S j

@[reassoc]
lemma linearMap_over {d n : Type u} [Fintype n] (S : Scheme.{u}) (C : Matrix d n Γ(S, ⊤)) :
    linearMap S C ≫ 𝔸(d; S) ↘ S = 𝔸(n; S) ↘ S :=
  homOfVector_over _ _

instance linearMap_isOver {d n : Type u} [Fintype n] (S : Scheme.{u}) (C : Matrix d n Γ(S, ⊤)) :
    (linearMap S C).IsOver S where
  comp_over := linearMap_over S C

@[simp]
lemma linearMap_appTop_coord {d n : Type u} [Fintype n] (S : Scheme.{u}) (C : Matrix d n Γ(S, ⊤))
    (i : d) :
    (linearMap S C).appTop (coord S i) = ∑ j, (𝔸(n; S) ↘ S).appTop (C i j) * coord S j :=
  homOfVector_appTop_coord _ _ i

/-- Composing a morphism `homOfVector g v : X ⟶ 𝔸(n; S)` with `linearMap S C` forms the
corresponding linear combinations of the coordinate sections `v`. -/
@[reassoc]
lemma homOfVector_comp_linearMap {X S : Scheme.{u}} {d n : Type u} [Fintype n] (g : X ⟶ S)
    (v : n → Γ(X, ⊤)) (C : Matrix d n Γ(S, ⊤)) :
    homOfVector g v ≫ linearMap S C =
      homOfVector g fun i ↦ ∑ j, g.appTop (C i j) * v j := by
  ext1
  · simp
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, linearMap_appTop_coord,
      homOfVector_appTop_coord, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_mul, homOfVector_appTop_coord, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop,
      homOfVector_over]

@[simp]
lemma linearMap_one {n : Type u} [Fintype n] [DecidableEq n] (S : Scheme.{u}) :
    linearMap S (1 : Matrix n n Γ(S, ⊤)) = 𝟙 𝔸(n; S) := by
  ext1
  · simp
  · simp [Matrix.one_apply]

/-- Matrix multiplication corresponds contravariantly to composition of linear morphisms between
affine spaces. -/
@[reassoc, simp]
lemma linearMap_mul {d m n : Type u} [Fintype m] [Fintype n] (S : Scheme.{u})
    (C₁ : Matrix d m Γ(S, ⊤)) (C₂ : Matrix m n Γ(S, ⊤)) :
    linearMap S (C₁ * C₂) = linearMap S C₂ ≫ linearMap S C₁ := by
  symm
  rw [linearMap, homOfVector_comp_linearMap]
  ext1
  · simp
  · simp only [homOfVector_appTop_coord, linearMap_appTop_coord, Matrix.mul_apply, map_sum,
      map_mul, Finset.mul_sum, Finset.sum_mul, mul_assoc]
    exact Finset.sum_comm

end LinearMap

section SpecTuple

/-- The `Spec R`-morphism `Spec A ⟶ 𝔸(n; Spec R)` determined by an `n`-tuple `x : n → A` in an
`R`-algebra `A`. -/
def specHomOfTuple (R : Type u) [CommRing R] {A : Type u} [CommRing A] [Algebra R A] {n : Type u}
    (x : n → A) :
    Spec (.of A) ⟶ 𝔸(n; Spec (.of R)) :=
  homOfVector (Spec.map (CommRingCat.ofHom (algebraMap R A)))
    ((Scheme.ΓSpecIso (.of A)).inv ∘ x)

@[reassoc (attr := simp)]
lemma specHomOfTuple_over (R : Type u) [CommRing R] {A : Type u} [CommRing A] [Algebra R A]
    {n : Type u} (x : n → A) :
    specHomOfTuple R x ≫ 𝔸(n; Spec (.of R)) ↘ Spec (.of R) =
      Spec.map (CommRingCat.ofHom (algebraMap R A)) :=
  homOfVector_over _ _

@[simp]
lemma specHomOfTuple_appTop_coord (R : Type u) [CommRing R] {A : Type u} [CommRing A] [Algebra R A]
    {n : Type u} (x : n → A) (i : n) :
    (specHomOfTuple R x).appTop (coord (Spec (.of R)) i) =
      (Scheme.ΓSpecIso (.of A)).inv (x i) :=
  homOfVector_appTop_coord _ _ i

/-- `specHomOfTuple R x` factors as `Spec.map (MvPolynomial.aeval x)` followed by
`(SpecIso n (.of R)).inv`. -/
lemma specHomOfTuple_eq_specMap_comp_specIso_inv (R : Type u) [CommRing R] {A : Type u}
    [CommRing A] [Algebra R A] {n : Type u} (x : n → A) :
    specHomOfTuple R x =
      Spec.map (CommRingCat.ofHom (MvPolynomial.aeval x : MvPolynomial n R →ₐ[R] A).toRingHom) ≫
        (SpecIso n (.of R)).inv := by
  ext1
  · rw [specHomOfTuple_over, Category.assoc, SpecIso_inv_over, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    congr 1
    ext r
    simp
  · rw [specHomOfTuple_appTop_coord, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
      SpecIso_inv_appTop_coord, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality,
      CommRingCat.comp_apply]
    simp

/-- Composing `specHomOfTuple R x` with `linearMap` for the matrix associated to `C : Matrix d n R`
produces `specHomOfTuple R` for the linear combinations `i ↦ ∑ j, C i j • x j`. -/
@[reassoc]
lemma specHomOfTuple_comp_linearMap (R : Type u) [CommRing R] {A : Type u} [CommRing A]
    [Algebra R A] {d n : Type u} [Fintype n] (x : n → A) (C : Matrix d n R) :
    specHomOfTuple R x ≫ linearMap (Spec (.of R)) (C.map (Scheme.ΓSpecIso (.of R)).inv) =
      specHomOfTuple R (fun i ↦ ∑ j, C i j • x j) := by
  rw [specHomOfTuple, homOfVector_comp_linearMap, specHomOfTuple]
  congr 1
  ext i
  simp only [Function.comp_apply, Matrix.map_apply, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [Algebra.smul_def, map_mul, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality]
  rfl

/-- If `x : n → A` generates `A` as an `R`-algebra, then
`specHomOfTuple R x : Spec A ⟶ 𝔸(n; Spec R)` is a closed immersion. -/
lemma isClosedImmersion_specHomOfTuple {R A n : Type u} [CommRing R] [CommRing A] [Algebra R A]
    {x : n → A} (hx : Algebra.adjoin R (Set.range x) = ⊤) :
    IsClosedImmersion (specHomOfTuple R x) := by
  rw [specHomOfTuple_eq_specMap_comp_specIso_inv]
  have hsurj : Function.Surjective (MvPolynomial.aeval x : MvPolynomial n R →ₐ[R] A) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
    exact hx
  have : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval x : MvPolynomial n R →ₐ[R] A).toRingHom)) :=
    IsClosedImmersion.spec_of_surjective _ hsurj
  infer_instance

/-- `specHomOfTuple R y : Spec A ⟶ 𝔸(d; Spec R)` is a finite morphism if and only if
`MvPolynomial.aeval y` is module-finite. -/
lemma isFinite_specHomOfTuple_iff {R A d : Type u} [CommRing R] [CommRing A] [Algebra R A]
    (y : d → A) :
    IsFinite (specHomOfTuple R y) ↔
      (MvPolynomial.aeval y : MvPolynomial d R →ₐ[R] A).Finite := by
  constructor
  · intro _
    have h' : IsFinite (specHomOfTuple R y ≫ (SpecIso d (.of R)).hom) := inferInstance
    rw [specHomOfTuple_eq_specMap_comp_specIso_inv, Category.assoc, Iso.inv_hom_id,
      Category.comp_id, IsFinite.SpecMap_iff, CommRingCat.hom_ofHom] at h'
    exact h'
  · intro hfin
    rw [specHomOfTuple_eq_specMap_comp_specIso_inv]
    have : IsFinite
        (Spec.map
          (CommRingCat.ofHom (MvPolynomial.aeval y : MvPolynomial d R →ₐ[R] A).toRingHom)) :=
      (IsFinite.SpecMap_iff _).mpr hfin
    infer_instance

/-- If `y : d → A` is algebraically independent over `R` and `MvPolynomial.aeval y` is integral,
then `specHomOfTuple R y : Spec A ⟶ 𝔸(d; Spec R)` is surjective. -/
lemma surjective_specHomOfTuple {R A d : Type u} [CommRing R] [CommRing A] [Algebra R A]
    {y : d → A} (hy : AlgebraicIndependent R y)
    (hint : (MvPolynomial.aeval y : MvPolynomial d R →ₐ[R] A).toRingHom.IsIntegral) :
    Surjective (specHomOfTuple R y) := by
  rw [specHomOfTuple_eq_specMap_comp_specIso_inv]
  have : Surjective
      (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval y : MvPolynomial d R →ₐ[R] A).toRingHom)) :=
    ⟨hint.comap_surjective hy⟩
  infer_instance

/-- **Geometric linear Noether normalization.** Over an infinite field `k`, for any nontrivial
`k`-algebra `A` generated by `x : Fin n → A`, the closed immersion
`specHomOfTuple k (x ∘ ULift.down) : Spec A ⟶ 𝔸(ULift (Fin n); Spec k)` composes with a linear
morphism `𝔸(ULift (Fin n); Spec k) ⟶ 𝔸(ULift (Fin d); Spec k)` (`d ≤ n`, `ringKrullDim A = d`) to
give a finite surjective morphism `Spec A ⟶ 𝔸(ULift (Fin d); Spec k)`. -/
theorem exists_linear_normalization {k A : Type u} [Field k] [Infinite k] [CommRing A]
    [Nontrivial A] [Algebra k A] {n : ℕ} (x : Fin n → A)
    (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    IsClosedImmersion (specHomOfTuple k (x ∘ ULift.down : ULift.{u} (Fin n) → A)) ∧
      ∃ (d : ℕ) (_ : d ≤ n)
        (C : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin n)) Γ(Spec (.of k), ⊤)),
        let π := specHomOfTuple k (x ∘ ULift.down : ULift.{u} (Fin n) → A) ≫
          linearMap (Spec (.of k)) C
        IsFinite π ∧ Surjective π ∧ ringKrullDim A = (d : WithBot ℕ∞) := by
  have hrange : Set.range (x ∘ ULift.down : ULift.{u} (Fin n) → A) = Set.range x :=
    ULift.down_surjective.range_comp x
  refine ⟨isClosedImmersion_specHomOfTuple (hrange ▸ hx), ?_⟩
  obtain ⟨d, hdn, C₀, hy, hfin, hdim⟩ := TauCeti.exists_linear_normalization x hx
  let C' : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin n)) k :=
    Matrix.of fun i j ↦ C₀ i.down j.down
  refine ⟨d, hdn, C'.map (Scheme.ΓSpecIso (.of k)).inv, ?_⟩
  let y : Fin d → A := fun i ↦ ∑ j, C₀ i j • x j
  let y' : ULift.{u} (Fin d) → A := y ∘ ULift.down
  have hy' : (fun i : ULift.{u} (Fin d) ↦ ∑ j : ULift.{u} (Fin n), C' i j • x j.down) = y' := by
    ext ⟨i⟩
    simpa [y', y, C'] using (Equiv.ulift.sum_comp fun j : Fin n ↦ C₀ i j • x j)
  have hπ : specHomOfTuple k (x ∘ ULift.down : ULift.{u} (Fin n) → A) ≫
      linearMap (Spec (.of k)) (C'.map (Scheme.ΓSpecIso (.of k)).inv) = specHomOfTuple k y' := by
    rw [specHomOfTuple_comp_linearMap]
    exact congrArg (specHomOfTuple k) hy'
  have hren : (MvPolynomial.aeval y' : MvPolynomial (ULift.{u} (Fin d)) k →ₐ[k] A) =
      (MvPolynomial.aeval y).comp (MvPolynomial.renameEquiv k Equiv.ulift).toAlgHom := by
    ext ⟨i⟩; simp [y']
  have hy'_ind : AlgebraicIndependent k y' := hy.comp ULift.down ULift.down_injective
  have hy'_fin : (MvPolynomial.aeval y' : MvPolynomial (ULift.{u} (Fin d)) k →ₐ[k] A).Finite := by
    change (MvPolynomial.aeval y' :
      MvPolynomial (ULift.{u} (Fin d)) k →ₐ[k] A).toRingHom.Finite
    rw [congrArg AlgHom.toRingHom hren]
    exact RingHom.Finite.comp hfin
      (RingEquiv.finite (MvPolynomial.renameEquiv k Equiv.ulift).toRingEquiv)
  refine ⟨?_, ?_, hdim⟩
  · rw [hπ, isFinite_specHomOfTuple_iff]
    exact hy'_fin
  · rw [hπ]
    exact surjective_specHomOfTuple hy'_ind hy'_fin.to_isIntegral

end SpecTuple

end

end AlgebraicGeometry.AffineSpace
