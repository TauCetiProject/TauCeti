module

public import TauCeti.AlgebraicGeometry.AffineSpace.Linear
public import TauCeti.RingTheory.NoetherNormalization
import Mathlib.AlgebraicGeometry.Morphisms.QuasiFinite

/-!
# Geometric linear Noether normalization

Combining `AlgebraicGeometry.AffineSpace.linearMap` and `AlgebraicGeometry.AffineSpace.homOfAlgebra`
with `TauCeti.exists_linear_normalization_of_finite` yields the geometric forms of linear Noether
normalization:

* For any nontrivial `k`-algebra `A` over an infinite field `k` and any finite family `x : n → A`
  such that `MvPolynomial.aeval x` is module-finite, there exist `d ≤ Fintype.card n` and a matrix
  `C : Matrix (ULift (Fin d)) n k` such that the composite morphism
  `Spec (.of A) ⟶ 𝔸(ULift (Fin d); Spec (.of k))` of `homOfAlgebra x` with the `k`-linear map
  defined by `C` is finite and surjective, with `ringKrullDim A = d`
  (`AlgebraicGeometry.AffineSpace.exists_linear_normalization_of_finite`).
* When `x` generates `A` as a `k`-algebra, `homOfAlgebra x` is moreover a closed immersion
  `Spec (.of A) ⟶ 𝔸(n; Spec (.of k))`
  (`AlgebraicGeometry.AffineSpace.exists_linear_normalization`).

## Main results

* `AlgebraicGeometry.AffineSpace.exists_linear_normalization_of_finite`: geometric linear Noether
  normalization for `Spec (.of A)` given coordinates `x : n → A` with `MvPolynomial.aeval x`
  module-finite.
* `AlgebraicGeometry.AffineSpace.exists_linear_normalization`: geometric linear Noether
  normalization for `Spec (.of A)` given algebra generators `x : n → A` over an infinite field `k`.

## References

* J. S. Milne, *Algebraic Geometry*, Theorem 2.45 (pp. 55–56).
* [Stacks Project, Tag 00OY](https://stacks.math.columbia.edu/tag/00OY)
-/

public section

open CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineSpace

universe u

/-- **Geometric linear Noether normalization (module-finite form).** Let `k` be an infinite field,
`A` be a nontrivial `k`-algebra, and `x : n → A` be a finite family of elements making `A`
module-finite over `MvPolynomial n k`. Then there exist `d ≤ Fintype.card n` and a matrix
`C : Matrix (ULift.{u} (Fin d)) n k` such that the composite morphism
`π : Spec (.of A) ⟶ 𝔸(ULift.{u} (Fin d); Spec (.of k))` of `homOfAlgebra x` with the linear map
defined by `C` is finite, surjective, and has finite fibers, and `ringKrullDim A = d`. -/
theorem exists_linear_normalization_of_finite {k A : Type u} [Field k] [Infinite k] [CommRing A]
    [Nontrivial A] [Algebra k A] {n : Type u} [Fintype n] (x : n → A)
    (hx : (MvPolynomial.aeval (R := k) x).Finite) :
    ∃ (d : ℕ) (_ : d ≤ Fintype.card n) (C : Matrix (ULift.{u} (Fin d)) n k),
      let π := homOfAlgebra (R := k) x ≫
        linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv)
      IsFinite π ∧ Surjective π ∧ (∀ q, (π ⁻¹' {q}).Finite) ∧ ringKrullDim A = d := by
  let e : Fin (Fintype.card n) ≃ n := (Fintype.equivFin n).symm
  have hx' : (MvPolynomial.aeval (R := k) (x ∘ e)).Finite := by
    rw [← MvPolynomial.aeval_comp_rename]
    exact AlgHom.Finite.comp hx
      (AlgHom.Finite.of_surjective _ (MvPolynomial.rename_surjective _ e.surjective))
  obtain ⟨d, hd, C₀, hy_ind, hy_fin, hdim⟩ :=
    TauCeti.exists_linear_normalization_of_finite (x ∘ e) hx'
  let C : Matrix (ULift.{u} (Fin d)) n k := C₀.submatrix ULift.down e.symm
  let y : Fin d → A := fun i ↦ ∑ j, C₀ i j • x (e j)
  have hπ : homOfAlgebra (R := k) x ≫
      linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv) =
      homOfAlgebra (R := k) (y ∘ ULift.down) := by
    rw [homOfAlgebra_linearMap]
    congr 1
    funext ⟨i⟩
    simpa [C, y, Function.comp_apply] using (e.symm.sum_comp fun j ↦ C₀ i j • x (e j))
  have hy_ind' : AlgebraicIndependent k (y ∘ ULift.down : ULift.{u} (Fin d) → A) :=
    (algebraicIndependent_equiv Equiv.ulift).mpr hy_ind
  have hy_fin' : (MvPolynomial.aeval (R := k) (y ∘ ULift.down : ULift.{u} (Fin d) → A)).Finite := by
    rw [← MvPolynomial.aeval_comp_rename]
    exact AlgHom.Finite.comp hy_fin
      (AlgHom.Finite.of_surjective _ (MvPolynomial.rename_surjective _ Equiv.ulift.surjective))
  have hfin : IsFinite (homOfAlgebra (R := k) (y ∘ ULift.down)) :=
    isFinite_homOfAlgebra_iff.mpr hy_fin'
  refine ⟨d, hd, C, ?_⟩
  dsimp only
  rw [hπ]
  exact ⟨hfin, surjective_homOfAlgebra hy_ind' hy_fin'.to_isIntegral,
    (homOfAlgebra (R := k) (y ∘ ULift.down)).finite_preimage_singleton, hdim⟩

/-- **Geometric linear Noether normalization.** Let `k` be an infinite field and `A` be a nontrivial
`k`-algebra generated by a finite family `x : n → A`. Then `homOfAlgebra x` is a closed immersion
`Spec (.of A) ⟶ 𝔸(n; Spec (.of k))`, and there exist `d ≤ Fintype.card n` and a matrix
`C : Matrix (ULift.{u} (Fin d)) n k` such that the restricted linear projection
`π : Spec (.of A) ⟶ 𝔸(ULift.{u} (Fin d); Spec (.of k))` is finite, surjective, and has finite
fibers, with `ringKrullDim A = d`. -/
theorem exists_linear_normalization {k A : Type u} [Field k] [Infinite k] [CommRing A]
    [Nontrivial A] [Algebra k A] {n : Type u} [Fintype n] (x : n → A)
    (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    IsClosedImmersion (homOfAlgebra (R := k) x) ∧
      ∃ (d : ℕ) (_ : d ≤ Fintype.card n) (C : Matrix (ULift.{u} (Fin d)) n k),
        let π := homOfAlgebra (R := k) x ≫
          linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv)
        IsFinite π ∧ Surjective π ∧ (∀ q, (π ⁻¹' {q}).Finite) ∧ ringKrullDim A = d := by
  have hsurj : Function.Surjective (MvPolynomial.aeval (R := k) x) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, hx]
  exact ⟨isClosedImmersion_homOfAlgebra_iff.mpr hx,
    exists_linear_normalization_of_finite x (AlgHom.Finite.of_surjective _ hsurj)⟩

end AlgebraicGeometry.AffineSpace
