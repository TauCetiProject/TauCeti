public import Mathlib.AlgebraicGeometry.AffineSpace
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.Data.Matrix.Basic

import TauCeti.RingTheory.NoetherNormalization

/-!
# Linear morphisms of affine space and geometric Noether normalization

For a scheme `S` and finite index type `ι`, a matrix `C : Matrix κ ι Γ(S, ⊤)` of global sections on
`S` induces an `S`-morphism `AlgebraicGeometry.AffineSpace.linearMap S C : 𝔸(ι; S) ⟶ 𝔸(κ; S)`
pulling back the `i`-th coordinate of `𝔸(κ; S)` to `∑ j, C i j • coord S j`. Composition of linear
morphisms is contravariant in the matrix (`linearMap_mul`) and commutes with arbitrary base change
along `f : S ⟶ T` (`map_linearMap`).

Over an affine base `Spec R`, any tuple `x : ι → A` in a commutative `R`-algebra `A` defines an
`R`-morphism `AlgebraicGeometry.AffineSpace.homOfTuple R x : Spec (.of A) ⟶ 𝔸(ι; Spec (.of R))`
sending the `j`-th coordinate to `x j`. Under `AffineSpace.SpecIso`, this agrees with
`Spec.map (MvPolynomial.aeval x)` (`homOfTuple_eq_SpecMap_comp`), so it is a closed immersion
precisely when `x` generates `A` over `R` (`isClosedImmersion_homOfTuple_iff`), is finite precisely
when `MvPolynomial.aeval x` is module-finite (`isFinite_homOfTuple_iff`), and is surjective
whenever `x` is algebraically independent and `MvPolynomial.aeval x` is integral
(`surjective_homOfTuple`).

Combining these with `TauCeti.exists_linear_normalization_of_fintype` yields geometric linear
Noether normalization (`AlgebraicGeometry.AffineSpace.exists_linear_normalization`): for any
nontrivial commutative `k`-algebra `A` generated by a finite tuple `x : ι → A` over an infinite
field `k`, the closed subscheme `Spec (.of A) ↪ 𝔸(ι; Spec (.of k))` projects via a linear morphism
`linearMap` onto `𝔸(ULift (Fin d); Spec (.of k))` by a finite surjective `k`-morphism, where
`d ≤ Fintype.card ι` equals `topologicalKrullDim (Spec (.of A))`.

## Main definitions

* `AlgebraicGeometry.AffineSpace.linearMap`: the `S`-morphism `𝔸(ι; S) ⟶ 𝔸(κ; S)` defined by a
  matrix `C : Matrix κ ι Γ(S, ⊤)` of global functions on `S`.
* `AlgebraicGeometry.AffineSpace.homOfTuple`: the `Spec R`-morphism
  `Spec (.of A) ⟶ 𝔸(ι; Spec (.of R))` defined by a tuple `x : ι → A` in an `R`-algebra `A`.

## Main results

* `AlgebraicGeometry.AffineSpace.homOfVector_comp_linearMap`: composing `homOfVector f v` with
  `linearMap S C` transforms the coordinate vector by `C`.
* `AlgebraicGeometry.AffineSpace.linearMap_zero`, `AlgebraicGeometry.AffineSpace.linearMap_one`,
  and `AlgebraicGeometry.AffineSpace.linearMap_mul`: behavior of `linearMap` on `0`, `1`, and
  matrix products.
* `AlgebraicGeometry.AffineSpace.map_linearMap`: compatibility of `linearMap` with base change
  `S ⟶ T`.
* `AlgebraicGeometry.AffineSpace.homOfTuple_eq_SpecMap_comp` and
  `AlgebraicGeometry.AffineSpace.homOfTuple_comp_SpecIso_hom`: `homOfTuple R x` factors through
  `Spec.map (MvPolynomial.aeval x)` and `SpecIso ι (.of R)`.
* `AlgebraicGeometry.AffineSpace.homOfTuple_comp_linearMap`: composing `homOfTuple R x` with
  `linearMap` produces `homOfTuple R (fun i ↦ ∑ j, C i j • x j)`.
* `AlgebraicGeometry.AffineSpace.isClosedImmersion_homOfTuple_iff` and
  `AlgebraicGeometry.AffineSpace.isClosedImmersion_homOfTuple`: `homOfTuple R x` is a closed
  immersion if and only if `x` generates `A` as an `R`-algebra.
* `AlgebraicGeometry.AffineSpace.isFinite_homOfTuple_iff`: `homOfTuple R x` is finite if and only
  if `MvPolynomial.aeval x` is module-finite.
* `AlgebraicGeometry.AffineSpace.surjective_homOfTuple`: `homOfTuple R x` is surjective when `x` is
  algebraically independent over `R` and `MvPolynomial.aeval x` is integral.
* `AlgebraicGeometry.AffineSpace.exists_linear_normalization`: geometric linear Noether
  normalization for a prescribed affine presentation over an infinite field.

## References

* J. S. Milne, *Algebraic Geometry*, Theorem 2.45 and Corollary 2.48.
* R. Hartshorne, *Algebraic Geometry*, Exercise I.3.7.
* [Stacks Project, Tag 00OW](https://stacks.math.columbia.edu/tag/00OW)
-/

public section

open CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineSpace

universe u

noncomputable section

section LinearMap

variable {κ ι μ : Type u} [Fintype ι]

/-- The linear `S`-morphism `𝔸(ι; S) ⟶ 𝔸(κ; S)` determined by a matrix `C : Matrix κ ι Γ(S, ⊤)`
of global sections on `S`, pulling back `coord S i` to
`∑ j, (𝔸(ι; S) ↘ S).appTop (C i j) * coord S j`. -/
def linearMap (S : Scheme.{u}) (C : Matrix κ ι Γ(S, ⊤)) : 𝔸(ι; S) ⟶ 𝔸(κ; S) :=
  homOfVector (𝔸(ι; S) ↘ S) fun i ↦ ∑ j, (𝔸(ι; S) ↘ S).appTop (C i j) * coord S j

/-- `linearMap S C` is a morphism over `S`. -/
@[reassoc]
lemma linearMap_over (S : Scheme.{u}) (C : Matrix κ ι Γ(S, ⊤)) :
    linearMap S C ≫ 𝔸(κ; S) ↘ S = 𝔸(ι; S) ↘ S :=
  homOfVector_over _ _

/-- `linearMap S C` carries the canonical `IsOver S` structure. -/
instance isOver_linearMap (S : Scheme.{u}) (C : Matrix κ ι Γ(S, ⊤)) :
    (linearMap S C).IsOver S := by
  unfold linearMap
  infer_instance

/-- `linearMap S C` pulls back the `i`-th coordinate of `𝔸(κ; S)` to the `i`-th linear form
defined by `C`. -/
@[simp]
lemma linearMap_appTop_coord (S : Scheme.{u}) (C : Matrix κ ι Γ(S, ⊤)) (i : κ) :
    (linearMap S C).appTop (coord S i) = ∑ j, (𝔸(ι; S) ↘ S).appTop (C i j) * coord S j :=
  homOfVector_appTop_coord _ _ i

/-- Composing `homOfVector f v` with `linearMap S C` applies `C` (pulled back along `f`) to `v`. -/
@[reassoc]
lemma homOfVector_comp_linearMap {X S : Scheme.{u}} (f : X ⟶ S) (v : ι → Γ(X, ⊤))
    (C : Matrix κ ι Γ(S, ⊤)) :
    homOfVector f v ≫ linearMap S C =
      homOfVector f fun i ↦ ∑ j, f.appTop (C i j) * v j := by
  rw [linearMap, comp_homOfVector, homOfVector_over]
  congr 1
  ext i
  simp only [Function.comp_apply, map_sum, map_mul, homOfVector_appTop_coord,
    ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, homOfVector_over]

/-- The zero matrix induces the constant zero section of `𝔸(κ; S)` over `S`. -/
@[simp]
lemma linearMap_zero (S : Scheme.{u}) :
    linearMap S (0 : Matrix κ ι Γ(S, ⊤)) = homOfVector (𝔸(ι; S) ↘ S) 0 := by
  ext1 <;> simp

/-- The identity matrix induces the identity morphism on `𝔸(ι; S)`. -/
@[simp]
lemma linearMap_one (S : Scheme.{u}) [DecidableEq ι] :
    linearMap S (1 : Matrix ι ι Γ(S, ⊤)) = 𝟙 𝔸(ι; S) := by
  ext1
  · simp
  · simp [Matrix.one_apply]

/-- `linearMap` is contravariantly functorial with respect to matrix multiplication: applying `D`
on coordinates followed by `C` applies `C * D`. -/
@[reassoc]
lemma linearMap_mul (S : Scheme.{u}) [Fintype κ] (C : Matrix μ κ Γ(S, ⊤))
    (D : Matrix κ ι Γ(S, ⊤)) :
    linearMap S (C * D) = linearMap S D ≫ linearMap S C := by
  refine hom_ext (by simp) fun m ↦ ?_
  rw [linearMap_appTop_coord, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
    linearMap_appTop_coord, map_sum]
  trans ∑ j, ∑ k, (𝔸(ι; S) ↘ S).appTop (C m k) * ((𝔸(ι; S) ↘ S).appTop (D k j) * coord S j)
  · refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [map_mul, mul_assoc]
  · rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [map_mul, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, linearMap_over,
      linearMap_appTop_coord, Finset.mul_sum]

/-- `linearMap` commutes with base change along any morphism of schemes `f : S ⟶ T`. -/
@[reassoc]
lemma map_linearMap {S T : Scheme.{u}} (f : S ⟶ T) (C : Matrix κ ι Γ(T, ⊤)) :
    map ι f ≫ linearMap T C = linearMap S (C.map f.appTop) ≫ map κ f := by
  refine hom_ext (by simp) fun i ↦ ?_
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, linearMap_appTop_coord, map_sum,
    Scheme.Hom.comp_appTop, CommRingCat.comp_apply, map_appTop_coord, linearMap_appTop_coord]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [map_mul, map_appTop_coord, Matrix.map_apply, ← CommRingCat.comp_apply,
    ← Scheme.Hom.comp_appTop, map_over, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]

end LinearMap

section HomOfTuple

variable {R A ι κ : Type u} [CommRing R] [CommRing A] [Algebra R A]

/-- The `Spec (.of R)`-morphism `Spec (.of A) ⟶ 𝔸(ι; Spec (.of R))` determined by a tuple
`x : ι → A` in an `R`-algebra `A`, pulling back `coord (Spec (.of R)) j` to `x j`. -/
def homOfTuple (R : Type u) [CommRing R] {A ι : Type u} [CommRing A] [Algebra R A]
    (x : ι → A) : Spec (.of A) ⟶ 𝔸(ι; Spec (.of R)) :=
  homOfVector (Spec.map (CommRingCat.ofHom (algebraMap R A)))
    fun j ↦ (Scheme.ΓSpecIso (.of A)).inv (x j)

/-- `homOfTuple R x` lies over `Spec (.of R)` via `Spec.map (algebraMap R A)`. -/
@[reassoc (attr := simp)]
lemma homOfTuple_over (x : ι → A) :
    homOfTuple R x ≫ 𝔸(ι; Spec (.of R)) ↘ Spec (.of R) =
      Spec.map (CommRingCat.ofHom (algebraMap R A)) :=
  homOfVector_over _ _

/-- `homOfTuple R x` pulls back the `j`-th coordinate of `𝔸(ι; Spec (.of R))` to `x j` viewed as a
global section of `Spec (.of A)`. -/
@[simp]
lemma homOfTuple_appTop_coord (x : ι → A) (j : ι) :
    (homOfTuple R x).appTop (coord (Spec (.of R)) j) = (Scheme.ΓSpecIso (.of A)).inv (x j) :=
  homOfVector_appTop_coord _ _ j

/-- Under `SpecIso`, `homOfTuple R x` factors as `Spec.map (MvPolynomial.aeval x)` followed by
`(SpecIso ι (.of R)).inv`. -/
lemma homOfTuple_eq_SpecMap_comp (x : ι → A) :
    homOfTuple R x =
      Spec.map (CommRingCat.ofHom (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).toRingHom) ≫
        (SpecIso ι (.of R)).inv := by
  refine hom_ext ?_ fun j ↦ ?_
  · rw [homOfTuple_over, Category.assoc, SpecIso_inv_over, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    congr 2
    ext r
    simp
  · rw [homOfTuple_appTop_coord, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
      SpecIso_inv_appTop_coord, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality,
      CommRingCat.comp_apply, ConcreteCategory.hom_ofHom, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, MvPolynomial.aeval_X]

/-- Composing `homOfTuple R x` with `(SpecIso ι (.of R)).hom` yields
`Spec.map (MvPolynomial.aeval x)`. -/
@[reassoc]
lemma homOfTuple_comp_SpecIso_hom (x : ι → A) :
    homOfTuple R x ≫ (SpecIso ι (.of R)).hom =
      Spec.map (CommRingCat.ofHom (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).toRingHom) := by
  rw [homOfTuple_eq_SpecMap_comp, Category.assoc, Iso.inv_hom_id, Category.comp_id]

/-- Composing `homOfTuple R x` with `linearMap` for a matrix `C : Matrix κ ι R` yields
`homOfTuple R` for the linearly transformed tuple `i ↦ ∑ j, C i j • x j`. -/
@[reassoc]
lemma homOfTuple_comp_linearMap [Fintype ι] (C : Matrix κ ι R) (x : ι → A) :
    homOfTuple R x ≫ linearMap (Spec (.of R)) (C.map (Scheme.ΓSpecIso (.of R)).inv) =
      homOfTuple R fun i ↦ ∑ j, C i j • x j := by
  rw [homOfTuple, homOfVector_comp_linearMap, homOfTuple]
  congr 1
  ext i
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [Matrix.map_apply, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality,
    CommRingCat.comp_apply, ConcreteCategory.hom_ofHom, Algebra.smul_def, map_mul]

/-- `homOfTuple R x` is a closed immersion into `𝔸(ι; Spec (.of R))` if and only if `x` generates
`A` as an `R`-algebra. -/
lemma isClosedImmersion_homOfTuple_iff (x : ι → A) :
    IsClosedImmersion (homOfTuple R x) ↔ Algebra.adjoin R (Set.range x) = ⊤ := by
  let φ : CommRingCat.of (MvPolynomial ι R) ⟶ CommRingCat.of A :=
    CommRingCat.ofHom (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).toRingHom
  rw [homOfTuple_eq_SpecMap_comp,
    MorphismProperty.cancel_right_of_respectsIso (P := @IsClosedImmersion),
    Algebra.adjoin_range_eq_range_aeval R x, AlgHom.range_eq_top]
  refine ⟨fun h a ↦ ?_, fun hsurj ↦ IsClosedImmersion.spec_of_surjective φ hsurj⟩
  obtain ⟨s, hs⟩ := (Spec.map φ).app_surjective ⊤
    (isAffineOpen_top (Spec (.of (MvPolynomial ι R)))) ((Scheme.ΓSpecIso (.of A)).inv a)
  refine ⟨(Scheme.ΓSpecIso (.of (MvPolynomial ι R))).hom s, ?_⟩
  calc (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A)
        ((Scheme.ΓSpecIso (.of (MvPolynomial ι R))).hom s)
      = ((Scheme.ΓSpecIso (.of (MvPolynomial ι R))).hom ≫ φ) s := by simp [φ]
    _ = ((Spec.map φ).appTop ≫ (Scheme.ΓSpecIso (.of A)).hom) s := by
        rw [Scheme.ΓSpecIso_naturality]
    _ = (Scheme.ΓSpecIso (.of A)).hom ((Spec.map φ).appTop s) := rfl
    _ = (Scheme.ΓSpecIso (.of A)).hom ((Scheme.ΓSpecIso (.of A)).inv a) :=
        congr_arg (Scheme.ΓSpecIso (.of A)).hom hs
    _ = ((Scheme.ΓSpecIso (.of A)).inv ≫ (Scheme.ΓSpecIso (.of A)).hom) a := rfl
    _ = a := by simp

/-- If `x : ι → A` generates `A` as an `R`-algebra, then `homOfTuple R x` is a closed immersion
into `𝔸(ι; Spec (.of R))`. -/
lemma isClosedImmersion_homOfTuple {x : ι → A} (hx : Algebra.adjoin R (Set.range x) = ⊤) :
    IsClosedImmersion (homOfTuple R x) :=
  (isClosedImmersion_homOfTuple_iff x).mpr hx

/-- `homOfTuple R x` is a finite morphism if and only if `MvPolynomial.aeval x` is module-finite. -/
lemma isFinite_homOfTuple_iff (x : ι → A) :
    IsFinite (homOfTuple R x) ↔ (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).Finite := by
  rw [homOfTuple_eq_SpecMap_comp, IsFinite.comp_iff, IsFinite.SpecMap_iff]
  rfl

/-- If `x : ι → A` is algebraically independent over `R` and `MvPolynomial.aeval x` is integral,
then `homOfTuple R x` is surjective onto `𝔸(ι; Spec (.of R))`. -/
lemma surjective_homOfTuple {x : ι → A} (hind : AlgebraicIndependent R x)
    (hint : (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).IsIntegral) :
    Surjective (homOfTuple R x) := by
  rw [homOfTuple_eq_SpecMap_comp,
    MorphismProperty.cancel_right_of_respectsIso (P := @Surjective), surjective_iff]
  have hinj : Function.Injective (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).toRingHom :=
    algebraicIndependent_iff_injective_aeval.mp hind
  have hint' : (MvPolynomial.aeval x : MvPolynomial ι R →ₐ[R] A).toRingHom.IsIntegral := hint
  exact hint'.comap_surjective hinj

end HomOfTuple

section LinearNormalization

/-- **Geometric linear Noether normalization.** Over an infinite field `k`, for every nontrivial
commutative `k`-algebra `A` generated by a finite family `x : ι → A`, the affine presentation
`homOfTuple k x : Spec (.of A) ⟶ 𝔸(ι; Spec (.of k))` is a closed immersion and there exist
`d ≤ Fintype.card ι` and a matrix `C : Matrix (ULift.{u} (Fin d)) ι k` such that the composite
projection `π = homOfTuple k x ≫ linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv)`
onto `𝔸(ULift.{u} (Fin d); Spec (.of k))` equals `homOfTuple k (fun i ↦ ∑ j, C i j • x j)`, is
finite and surjective, and satisfies `topologicalKrullDim (Spec (.of A)) = d`. -/
theorem exists_linear_normalization (k : Type u) [Field k] [Infinite k]
    {A ι : Type u} [CommRing A] [Nontrivial A] [Algebra k A] [Fintype ι]
    (x : ι → A) (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    ∃ (d : ℕ) (_ : d ≤ Fintype.card ι) (C : Matrix (ULift.{u} (Fin d)) ι k),
      let π := homOfTuple k x ≫
        linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv)
      IsClosedImmersion (homOfTuple k x) ∧
        π = homOfTuple k (fun i ↦ ∑ j, C i j • x j) ∧
        IsFinite π ∧
        Surjective π ∧
        topologicalKrullDim (Spec (.of A)) = (d : WithBot ℕ∞) := by
  obtain ⟨d, hdn, C₀, hind₀, hfin₀, hdim⟩ := TauCeti.exists_linear_normalization_of_fintype x hx
  let C : Matrix (ULift.{u} (Fin d)) ι k := C₀.submatrix ULift.down id
  let y : ULift.{u} (Fin d) → A := fun i ↦ ∑ j, C i j • x j
  have hy : y = (fun i ↦ ∑ j, C₀ i j • x j) ∘ Equiv.ulift := rfl
  have hind : AlgebraicIndependent k y := by
    rw [hy]
    exact hind₀.comp Equiv.ulift Equiv.ulift.injective
  have hfin : (MvPolynomial.aeval y : MvPolynomial (ULift.{u} (Fin d)) k →ₐ[k] A).Finite := by
    have heq : MvPolynomial.aeval y =
        (MvPolynomial.aeval fun i ↦ ∑ j, C₀ i j • x j).comp
          (MvPolynomial.renameEquiv k Equiv.ulift).toAlgHom :=
      MvPolynomial.algHom_ext fun i ↦ by simp [hy]
    rw [heq]
    exact hfin₀.comp
      (AlgHom.Finite.of_surjective _ (MvPolynomial.renameEquiv k Equiv.ulift).surjective)
  have hπ : homOfTuple k x ≫ linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv) =
      homOfTuple k y := homOfTuple_comp_linearMap C x
  refine ⟨d, hdn, C, isClosedImmersion_homOfTuple hx, hπ, ?_, ?_, ?_⟩
  · rw [hπ, isFinite_homOfTuple_iff]
    exact hfin
  · rw [hπ]
    exact surjective_homOfTuple hind hfin.to_isIntegral
  · exact (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim (R := A)).trans hdim

end LinearNormalization

end

end AlgebraicGeometry.AffineSpace
