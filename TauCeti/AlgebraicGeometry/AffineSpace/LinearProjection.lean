/-!
# Linear morphisms between affine spaces and geometric Noether normalization

For a scheme `S` and a matrix `M : Matrix m n Γ(S, ⊤)` of global functions on `S` (with `n` finite),
we construct via `AlgebraicGeometry.AffineSpace.homOfVector` the linear `S`-morphism
`AlgebraicGeometry.AffineSpace.homOfMatrix S M : 𝔸(n; S) ⟶ 𝔸(m; S)` pulling back the `i`-th
coordinate of `𝔸(m; S)` to `∑ j, M i j • coord S j`.

This construction satisfies `homOfMatrix S 1 = 𝟙 𝔸(n; S)`, reverses multiplication
(`homOfMatrix S N ≫ homOfMatrix S M = homOfMatrix S (M * N)`), commutes with base change along any
morphism `g : S ⟶ T` with a Cartesian square (`isPullback_map_homOfMatrix`), and corresponds over
`Spec R` under `AffineSpace.SpecIso` to the polynomial evaluation homomorphism
`X i ↦ ∑ j, C (M i j) * X j` (`homOfMatrix_SpecIso`). In particular, if `M` has a right inverse
`N` (`M * N = 1`) — for instance when `S = Spec k` for a field `k` and the rows of `M` are
`k`-linearly independent — then `homOfMatrix S M` is a split epimorphism over `S` and hence
surjective (`surjective_homOfMatrix_of_mul_eq_one`,
`surjective_homOfMatrix_Spec_of_linearIndependent`).

Combining this with `TauCeti.exists_linear_normalization` yields the geometric form of linear
Noether normalization (`exists_finite_surjective_linearProjection`): for any nontrivial commutative
algebra `A` over an infinite field `k` generated by `x : Fin n → A`, the closed immersion
`ι : Spec A ⟶ 𝔸ⁿ_k` determined by `x` composes with a surjective linear projection
`π : 𝔸ⁿ_k ⟶ 𝔸ᵈ_k` defined by a row-linearly-independent matrix `C : Matrix (Fin d) (Fin n) k` to
give a finite surjective morphism `ι ≫ π : Spec A ⟶ 𝔸ᵈ_k`, where `d ≤ n` is the Krull dimension of
`Spec A`.

## Main definitions and results

* `AlgebraicGeometry.AffineSpace.homOfMatrix`: the linear `S`-morphism `𝔸(n; S) ⟶ 𝔸(m; S)` attached
  to `M : Matrix m n Γ(S, ⊤)`.
* `AlgebraicGeometry.AffineSpace.homOfMatrix_comp_homOfMatrix`: functoriality
  `homOfMatrix S N ≫ homOfMatrix S M = homOfMatrix S (M * N)`.
* `AlgebraicGeometry.AffineSpace.isPullback_map_homOfMatrix`: compatibility of `homOfMatrix` with
  base change `S ⟶ T` via a pullback square.
* `AlgebraicGeometry.AffineSpace.homOfMatrix_SpecIso`: comparison of `homOfMatrix` over `Spec R`
  with `Spec.map` of a linear polynomial substitution.
* `AlgebraicGeometry.AffineSpace.isClosedImmersion_homOfVector_Spec`: a generating tuple `x : n → A`
  of an `R`-algebra defines a closed immersion `Spec A ⟶ 𝔸(n; Spec R)`.
* `AlgebraicGeometry.AffineSpace.surjective_homOfMatrix_Spec_of_linearIndependent`: over a field
  `k`, a matrix with `k`-linearly independent rows defines a surjective linear projection
  `𝔸(n; Spec k) ⟶ 𝔸(m; Spec k)`.
* `AlgebraicGeometry.AffineSpace.exists_finite_surjective_linearProjection`: geometric linear
  Noether normalization over an infinite field.

## References

* J. S. Milne, *Algebraic Geometry* (v6.10, 2024), Theorem 2.44.
* [Stacks Project, Tag 00OW](https://stacks.math.columbia.edu/tag/00OW).
-/

public section

open scoped Matrix
open CategoryTheory Limits MvPolynomial

namespace AlgebraicGeometry.AffineSpace

universe u

noncomputable section

section OverScheme

variable {l m n : Type u}

/-- The `S`-morphism `𝔸(n; S) ⟶ 𝔸(m; S)` induced by a matrix `M : Matrix m n Γ(S, ⊤)` of global
functions on `S`, pulling back the `i`-th coordinate of `𝔸(m; S)` to
`∑ j, (𝔸(n; S) ↘ S).appTop (M i j) * coord S j`. -/
def homOfMatrix [Fintype n] (S : Scheme.{u}) (M : Matrix m n Γ(S, ⊤)) :
    𝔸(n; S) ⟶ 𝔸(m; S) :=
  homOfVector (𝔸(n; S) ↘ S) (M.map (𝔸(n; S) ↘ S).appTop.hom *ᵥ coord S)

instance [Fintype n] (S : Scheme.{u}) (M : Matrix m n Γ(S, ⊤)) :
    (homOfMatrix S M).IsOver S := by
  unfold homOfMatrix
  infer_instance

/-- `homOfMatrix S M` is a morphism over `S`. -/
@[reassoc]
lemma homOfMatrix_over [Fintype n] (S : Scheme.{u}) (M : Matrix m n Γ(S, ⊤)) :
    homOfMatrix S M ≫ 𝔸(m; S) ↘ S = 𝔸(n; S) ↘ S :=
  homOfVector_over _ _

/-- On global sections, `homOfMatrix S M` sends `coord S i` to the `i`-th row linear combination
of the coordinates of `𝔸(n; S)`. -/
@[simp]
lemma homOfMatrix_appTop_coord [Fintype n] (S : Scheme.{u}) (M : Matrix m n Γ(S, ⊤)) (i : m) :
    (homOfMatrix S M).appTop (coord S i) =
      ∑ j, (𝔸(n; S) ↘ S).appTop (M i j) * coord S j := by
  rw [homOfMatrix, homOfVector_appTop_coord]
  simp [Matrix.mulVec, dotProduct]

/-- Composing a coordinate morphism `homOfVector f v : X ⟶ 𝔸(n; S)` with `homOfMatrix S M` applies
the pulled-back matrix `M.map f.appTop.hom` to the coordinate vector `v`. -/
@[reassoc (attr := simp)]
lemma homOfVector_comp_homOfMatrix [Fintype n] {X : Scheme.{u}} {S : Scheme.{u}} (f : X ⟶ S)
    (v : n → Γ(X, ⊤)) (M : Matrix m n Γ(S, ⊤)) :
    homOfVector f v ≫ homOfMatrix S M = homOfVector f (M.map f.appTop.hom *ᵥ v) := by
  apply hom_ext
  · simp
  · intro i
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, homOfMatrix_appTop_coord,
      homOfVector_appTop_coord, map_sum]
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, map_mul, homOfVector_appTop_coord]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, homOfVector_over]

/-- The identity matrix induces the identity morphism on `𝔸(n; S)`. -/
@[simp]
lemma homOfMatrix_one [Fintype n] [DecidableEq n] (S : Scheme.{u}) :
    homOfMatrix S (1 : Matrix n n Γ(S, ⊤)) = 𝟙 𝔸(n; S) := by
  rw [homOfMatrix, Matrix.map_one _ (map_zero _) (map_one _), Matrix.one_mulVec]
  apply hom_ext <;> simp

/-- The zero matrix induces the zero section morphism `𝔸(n; S) ⟶ 𝔸(m; S)`. -/
@[simp]
lemma homOfMatrix_zero [Fintype n] (S : Scheme.{u}) :
    homOfMatrix S (0 : Matrix m n Γ(S, ⊤)) = homOfVector (𝔸(n; S) ↘ S) 0 := by
  unfold homOfMatrix
  congr 1
  ext i
  simp

/-- Composition of linear morphisms between affine spaces corresponds to matrix multiplication in
contravariant (diagrammatic) order: `homOfMatrix S N ≫ homOfMatrix S M = homOfMatrix S (M * N)`. -/
@[reassoc]
lemma homOfMatrix_comp_homOfMatrix [Fintype m] [Fintype n] (S : Scheme.{u})
    (M : Matrix l m Γ(S, ⊤)) (N : Matrix m n Γ(S, ⊤)) :
    homOfMatrix S N ≫ homOfMatrix S M = homOfMatrix S (M * N) := by
  rw [homOfMatrix, homOfVector_comp_homOfMatrix, Matrix.mulVec_mulVec, ← Matrix.map_mul]
  rfl

/-- An invertible square matrix over `Γ(S, ⊤)` induces an isomorphism of `𝔸(n; S)`. -/
lemma isIso_homOfMatrix [Fintype n] [DecidableEq n] (S : Scheme.{u})
    {M : Matrix n n Γ(S, ⊤)} (hM : IsUnit M) :
    IsIso (homOfMatrix S M) := by
  obtain ⟨u, rfl⟩ := hM
  refine ⟨⟨homOfMatrix S (↑u⁻¹ : Matrix n n Γ(S, ⊤)), ?_, ?_⟩⟩
  · rw [homOfMatrix_comp_homOfMatrix, Units.inv_mul, homOfMatrix_one]
  · rw [homOfMatrix_comp_homOfMatrix, Units.mul_inv, homOfMatrix_one]

/-- If `M : Matrix m n Γ(S, ⊤)` admits a right inverse `N` (`M * N = 1`), then `homOfMatrix S M`
has a section `homOfMatrix S N` and is therefore surjective. -/
lemma surjective_homOfMatrix_of_mul_eq_one [Finite m] [DecidableEq m] [Fintype n]
    (S : Scheme.{u}) {M : Matrix m n Γ(S, ⊤)} {N : Matrix n m Γ(S, ⊤)} (hMN : M * N = 1) :
    Surjective (homOfMatrix S M) := by
  cases nonempty_fintype m
  have hsec : homOfMatrix S N ≫ homOfMatrix S M = 𝟙 𝔸(m; S) := by
    rw [homOfMatrix_comp_homOfMatrix, hMN, homOfMatrix_one]
  have : Surjective (homOfMatrix S N ≫ homOfMatrix S M) := hsec ▸ inferInstance
  exact Surjective.of_comp (homOfMatrix S N) (homOfMatrix S M)

/-- `homOfMatrix` commutes with base change along `g : S ⟶ T`. -/
@[reassoc (attr := simp)]
lemma map_comp_homOfMatrix [Fintype n] {S T : Scheme.{u}} (g : S ⟶ T)
    (M : Matrix m n Γ(T, ⊤)) :
    map n g ≫ homOfMatrix T M = homOfMatrix S (M.map g.appTop.hom) ≫ map m g := by
  apply hom_ext
  · simp
  · intro i
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, homOfMatrix_appTop_coord, map_sum,
      Scheme.Hom.comp_appTop, CommRingCat.comp_apply, map_appTop_coord, homOfMatrix_appTop_coord]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_mul, map_appTop_coord, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, map_over,
      Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    rfl

/-- Base change of `homOfMatrix T M` along `g : S ⟶ T` forms a pullback square. -/
lemma isPullback_map_homOfMatrix [Fintype n] {S T : Scheme.{u}} (g : S ⟶ T)
    (M : Matrix m n Γ(T, ⊤)) :
    IsPullback (map n g) (homOfMatrix S (M.map g.appTop.hom)) (homOfMatrix T M) (map m g) := by
  refine (IsPullback.paste_vert_iff (isPullback_map g) (map_comp_homOfMatrix g M)).mp ?_
  simpa using isPullback_map g

end OverScheme

section OverSpec

/-- Over `Spec R`, the coordinate morphism `Spec A ⟶ 𝔸(n; Spec R)` defined by an `n`-tuple
`x : n → A` factors through `(SpecIso n (.of R)).inv` as `Spec.map` of `MvPolynomial.aeval x`. -/
lemma homOfVector_Spec {n R A : Type u} [CommRing R] [CommRing A] [Algebra R A] (x : n → A) :
    homOfVector (Spec.map (CommRingCat.ofHom (algebraMap R A)))
        (fun j ↦ (Scheme.ΓSpecIso (.of A)).inv (x j)) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.aeval x).toRingHom) ≫
        (SpecIso n (.of R)).inv := by
  apply hom_ext
  · rw [homOfVector_over, Category.assoc, SpecIso_inv_over, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    congr 2
    ext r
    exact (aeval_C x r).symm
  · intro j
    rw [homOfVector_appTop_coord, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
      SpecIso_inv_appTop_coord, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality,
      CommRingCat.comp_apply]
    exact congrArg (Scheme.ΓSpecIso (.of A)).inv (aeval_X x j).symm

/-- If `x : n → A` generates `A` as an `R`-algebra, then the corresponding coordinate morphism
`Spec A ⟶ 𝔸(n; Spec R)` is a closed immersion. -/
lemma isClosedImmersion_homOfVector_Spec {n R A : Type u} [CommRing R] [CommRing A] [Algebra R A]
    (x : n → A) (hx : Algebra.adjoin R (Set.range x) = ⊤) :
    IsClosedImmersion
      (homOfVector (Spec.map (CommRingCat.ofHom (algebraMap R A)))
        (fun j ↦ (Scheme.ΓSpecIso (.of A)).inv (x j))) := by
  rw [homOfVector_Spec]
  have hsurj : Function.Surjective (MvPolynomial.aeval x : MvPolynomial n R →ₐ[R] A) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
    exact hx
  have :
      IsClosedImmersion (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (R := R) x).toRingHom)) :=
    IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (MvPolynomial.aeval (R := R) x).toRingHom) hsurj
  infer_instance

/-- Composing the coordinate morphism `Spec A ⟶ 𝔸(n; Spec R)` of `x : n → A` with the linear
morphism `homOfMatrix` of `M : Matrix m n R` yields `Spec.map` of `aeval` at the linear
combinations `fun i ↦ ∑ j, M i j • x j` followed by `(SpecIso m (.of R)).inv`. -/
lemma homOfVector_Spec_comp_homOfMatrix {m n R A : Type u} [Fintype n] [CommRing R] [CommRing A]
    [Algebra R A] (x : n → A) (M : Matrix m n R) :
    homOfVector (Spec.map (CommRingCat.ofHom (algebraMap R A)))
        (fun j ↦ (Scheme.ΓSpecIso (.of A)).inv (x j)) ≫
      homOfMatrix (Spec (.of R)) (M.map (Scheme.ΓSpecIso (.of R)).inv.hom) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (fun i ↦ ∑ j, M i j • x j)).toRingHom) ≫
        (SpecIso m (.of R)).inv := by
  rw [homOfVector_comp_homOfMatrix, ← homOfVector_Spec]
  congr 1
  ext i
  rw [Matrix.mulVec, dotProduct, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [Matrix.map_apply, Matrix.map_apply, Algebra.smul_def, map_mul]
  congr 1
  rw [← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality]
  rfl

/-- Under `AffineSpace.SpecIso`, `homOfMatrix` over `Spec R` corresponds to `Spec.map` of the
polynomial evaluation homomorphism `X i ↦ ∑ j, M i j • X j`. -/
lemma homOfMatrix_SpecIso {m n : Type u} [Fintype n] (R : CommRingCat.{u})
    (M : Matrix m n R) :
    homOfMatrix (Spec R) (M.map (Scheme.ΓSpecIso R).inv.hom) =
      (SpecIso n R).hom ≫
        Spec.map
          (CommRingCat.ofHom
            (MvPolynomial.aeval (fun i ↦ ∑ j, M i j • (X j : MvPolynomial n R))).toRingHom) ≫
        (SpecIso m R).inv := by
  rcases R with ⟨R, _⟩
  have hX :
      homOfVector (Spec.map (CommRingCat.ofHom (C : R →+* MvPolynomial n R)))
          (fun j ↦ (Scheme.ΓSpecIso (.of (MvPolynomial n R))).inv (X j)) =
        (SpecIso n (.of R)).inv := by
    have h := homOfVector_Spec (R := R) (A := MvPolynomial n R) (X : n → MvPolynomial n R)
    have hid :
        CommRingCat.ofHom (MvPolynomial.aeval (X : n → MvPolynomial n R)).toRingHom =
          𝟙 (CommRingCat.of (MvPolynomial n R)) := by
      ext1
      exact RingHom.ext fun p ↦ aeval_X_left_apply p
    simpa only [algebraMap_eq, hid, Spec.map_id, Category.id_comp] using h
  rw [← Iso.inv_comp_eq, ← hX]
  simpa only [algebraMap_eq] using
    homOfVector_Spec_comp_homOfMatrix (R := R) (A := MvPolynomial n R) (X : n → MvPolynomial n R) M

/-- Over a field `K`, a matrix `M : Matrix m n K` with `K`-linearly independent rows admits a right
inverse `B : Matrix n m K` satisfying `M * B = 1`. -/
private lemma exists_mul_eq_one_of_linearIndependent {m n K : Type*} [Finite m] [DecidableEq m]
    [Fintype n] [Field K] {M : Matrix m n K} (hM : LinearIndependent K M) :
    ∃ B : Matrix n m K, M * B = 1 := by
  classical
  cases nonempty_fintype m
  have hker : LinearMap.ker (Matrix.toLin' Mᵀ) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro v hv
    rw [LinearMap.mem_ker] at hv
    have hv' : ∑ i, v i • M i = 0 := by
      rw [← Matrix.vecMul_eq_sum, ← Matrix.mulVec_transpose]
      exact hv
    exact funext (Fintype.linearIndependent_iff.mp hM v hv')
  obtain ⟨g, hg⟩ := (Matrix.toLin' Mᵀ).exists_leftInverse_of_injective hker
  refine ⟨(LinearMap.toMatrix' g)ᵀ, ?_⟩
  have hgM : LinearMap.toMatrix' g * Mᵀ = 1 := by
    calc
      LinearMap.toMatrix' g * Mᵀ =
          LinearMap.toMatrix' g * LinearMap.toMatrix' (Matrix.toLin' Mᵀ) := by
        rw [LinearMap.toMatrix'_toLin']
      _ = LinearMap.toMatrix' (g.comp (Matrix.toLin' Mᵀ)) := (LinearMap.toMatrix'_comp _ _).symm
      _ = 1 := by rw [hg, LinearMap.toMatrix'_id]
  simpa only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one] using
    congrArg Matrix.transpose hgM

/-- Over a field `k`, any matrix `M : Matrix m n k` whose rows are `k`-linearly independent induces
a surjective linear projection `𝔸(n; Spec k) ⟶ 𝔸(m; Spec k)`. -/
lemma surjective_homOfMatrix_Spec_of_linearIndependent {m n k : Type u} [Finite m] [Fintype n]
    [Field k] {M : Matrix m n k} (hM : LinearIndependent k M) :
    Surjective (homOfMatrix (Spec (.of k)) (M.map (Scheme.ΓSpecIso (.of k)).inv.hom)) := by
  classical
  obtain ⟨B, hMB⟩ := exists_mul_eq_one_of_linearIndependent hM
  refine surjective_homOfMatrix_of_mul_eq_one (Spec (.of k))
    (N := B.map (Scheme.ΓSpecIso (.of k)).inv.hom) ?_
  rw [← Matrix.map_mul, hMB, Matrix.map_one _ (map_zero _) (map_one _)]

/-- **Geometric linear Noether normalization.** Let `A` be a nontrivial commutative algebra over an
infinite field `k`, generated over `k` by `x : Fin n → A`. Then there exist `d ≤ n` and a matrix
`C : Matrix (Fin d) (Fin n) k` with `k`-linearly independent rows such that:
1. the coordinate morphism `ι : Spec A ⟶ 𝔸(ULift (Fin n); Spec k)` defined by `x` is a closed
   immersion;
2. the linear projection `π : 𝔸(ULift (Fin n); Spec k) ⟶ 𝔸(ULift (Fin d); Spec k)` defined by `C`
   is surjective;
3. the composite `ι ≫ π : Spec A ⟶ 𝔸(ULift (Fin d); Spec k)` is finite and surjective; and
4. `topologicalKrullDim (Spec A) = d`. -/
theorem exists_finite_surjective_linearProjection {k A : Type u} [Field k] [Infinite k]
    [CommRing A] [Nontrivial A] [Algebra k A] {n : ℕ} (x : Fin n → A)
    (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    ∃ (d : ℕ) (_ : d ≤ n) (C : Matrix (Fin d) (Fin n) k),
      LinearIndependent k C ∧
      let ι : Spec (.of A) ⟶ 𝔸(ULift.{u} (Fin n); Spec (.of k)) :=
        homOfVector (Spec.map (CommRingCat.ofHom (algebraMap k A)))
          (fun j ↦ (Scheme.ΓSpecIso (.of A)).inv (x j.down))
      let π : 𝔸(ULift.{u} (Fin n); Spec (.of k)) ⟶ 𝔸(ULift.{u} (Fin d); Spec (.of k)) :=
        homOfMatrix (Spec (.of k))
          ((C.submatrix ULift.down ULift.down).map (Scheme.ΓSpecIso (.of k)).inv.hom)
      IsClosedImmersion ι ∧
        Surjective π ∧
        IsFinite (ι ≫ π) ∧
        Surjective (ι ≫ π) ∧
        topologicalKrullDim (Spec (.of A)) = (d : WithBot ℕ∞) := by
  obtain ⟨d, hd, C, hy, hfin, hdim⟩ := TauCeti.exists_linear_normalization x hx
  have hlin : LinearIndependent k C := hy.linearIndependent_of_sum_smul
  refine ⟨d, hd, C, hlin, ?_⟩
  intro ι π
  have hx' : Algebra.adjoin k (Set.range (x ∘ ULift.down : ULift.{u} (Fin n) → A)) = ⊤ := by
    have hrange : Set.range (x ∘ ULift.down : ULift.{u} (Fin n) → A) = Set.range x :=
      Equiv.ulift.surjective.range_comp x
    rwa [hrange]
  have hι : IsClosedImmersion ι := isClosedImmersion_homOfVector_Spec (x ∘ ULift.down) hx'
  have hπ : Surjective π := by
    obtain ⟨B, hCB⟩ := exists_mul_eq_one_of_linearIndependent hlin
    have hCB' :
        C.submatrix ULift.down ULift.down *
          (B.submatrix ULift.down ULift.down : Matrix (ULift.{u} (Fin n)) (ULift.{u} (Fin d)) k) =
          1 := by
      change C.submatrix Equiv.ulift Equiv.ulift * B.submatrix Equiv.ulift Equiv.ulift = 1
      rw [Matrix.submatrix_mul_equiv, hCB, Matrix.submatrix_one_equiv]
    refine surjective_homOfMatrix_of_mul_eq_one (Spec (.of k))
      (N := (B.submatrix ULift.down ULift.down).map (Scheme.ΓSpecIso (.of k)).inv.hom) ?_
    rw [← Matrix.map_mul, hCB', Matrix.map_one _ (map_zero _) (map_one _)]
  set y : Fin d → A := fun i ↦ ∑ j, C i j • x j
  set y' : ULift.{u} (Fin d) → A :=
    fun i ↦ ∑ j : ULift.{u} (Fin n), C.submatrix ULift.down ULift.down i j • x j.down
  have hy'_eq (i : ULift.{u} (Fin d)) : y' i = y i.down :=
    Equiv.ulift.sum_comp fun j ↦ C i.down j • x j
  let e : MvPolynomial (ULift.{u} (Fin d)) k ≃ₐ[k] MvPolynomial (Fin d) k :=
    renameEquiv k Equiv.ulift
  have haeval_eq : (aeval y).comp e.toAlgHom = aeval y' :=
    MvPolynomial.algHom_ext fun i ↦ by simp [e, hy'_eq]
  have hy'_inj :
      Function.Injective (aeval y' : MvPolynomial (ULift.{u} (Fin d)) k →ₐ[k] A) := by
    rw [← haeval_eq, AlgHom.coe_comp]
    exact (algebraicIndependent_iff_injective_aeval.mp hy).comp e.injective
  have hfin' : (aeval y' : MvPolynomial (ULift.{u} (Fin d)) k →ₐ[k] A).Finite := by
    change (aeval (R := k) y').toRingHom.Finite
    have hring : (aeval (R := k) y').toRingHom = (aeval y).toRingHom.comp e.toAlgHom.toRingHom :=
      congrArg AlgHom.toRingHom haeval_eq.symm
    rw [hring]
    exact hfin.comp (RingHom.Finite.of_surjective _ e.surjective)
  let φ : CommRingCat.of (MvPolynomial (ULift.{u} (Fin d)) k) ⟶ CommRingCat.of A :=
    CommRingCat.ofHom (aeval y').toRingHom
  have hcomp : ι ≫ π = Spec.map φ ≫ (SpecIso (ULift.{u} (Fin d)) (.of k)).inv :=
    homOfVector_Spec_comp_homOfMatrix (x ∘ ULift.down) (C.submatrix ULift.down ULift.down)
  have : IsFinite (Spec.map φ) := (IsFinite.SpecMap_iff φ).mpr hfin'
  have hιπ_fin : IsFinite (ι ≫ π) := by
    rw [hcomp]
    infer_instance
  have : Surjective (Spec.map φ) := by
    rw [surjective_iff, funext (Spec.map_apply φ)]
    let : Algebra (MvPolynomial (ULift.{u} (Fin d)) k) A := φ.hom.toAlgebra
    have : Algebra.IsIntegral (MvPolynomial (ULift.{u} (Fin d)) k) A :=
      algebraMap_isIntegral_iff.mp hfin'.to_isIntegral
    have : FaithfulSMul (MvPolynomial (ULift.{u} (Fin d)) k) A :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hy'_inj
    exact Algebra.IsIntegral.comap_surjective (MvPolynomial (ULift.{u} (Fin d)) k) A
  have hιπ_surj : Surjective (ι ≫ π) := by
    rw [hcomp]
    infer_instance
  refine ⟨hι, hπ, hιπ_fin, hιπ_surj, ?_⟩
  exact (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A).trans hdim

end OverSpec

end

