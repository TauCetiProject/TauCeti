module

public import Mathlib.AlgebraicGeometry.AffineSpace
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiFinite
public import TauCeti.RingTheory.NoetherNormalization

/-!
# Linear maps of affine spaces and geometric linear Noether normalization

Given a matrix `C : Matrix m n Γ(S, ⊤)` of global sections over a base scheme `S` (for finite `n`),
the linear combination of standard coordinates `i ↦ ∑ j, C i j * coord S j` defines an `S`-morphism
`AlgebraicGeometry.AffineSpace.linearMap S C : 𝔸(n; S) ⟶ 𝔸(m; S)` contravariantly in the variable
index and covariantly on coordinate vectors (`linearMap_comp`, `homOfVector_linearMap`). Invertible
square matrices induce `S`-automorphisms `AlgebraicGeometry.AffineSpace.linearIso`.

For an `R`-algebra `A` and an `n`-tuple `x : n → A`, `AlgebraicGeometry.AffineSpace.homOfAlgebra x`
is the canonical `Spec R`-morphism `Spec (.of A) ⟶ 𝔸(n; Spec (.of R))` corresponding to evaluation
`MvPolynomial.aeval x`. It is a closed immersion when `x` generates `A` over `R`
(`isClosedImmersion_homOfAlgebra`), finite when `MvPolynomial.aeval x` is module-finite
(`isFinite_homOfAlgebra`), and surjective when `x` is algebraically independent over `R` and makes
`A` integral (`surjective_homOfAlgebra`). Composing `homOfAlgebra x` with a linear morphism of
affine spaces corresponds to taking linear combinations of the coordinates `x`
(`homOfAlgebra_linearMap`).

Combining these constructions with `TauCeti.exists_linear_normalization` yields the geometric form
of linear Noether normalization (`AlgebraicGeometry.AffineSpace.exists_linear_normalization`): for
any nontrivial `k`-algebra `A` over an infinite field `k` generated by `x : Fin n → A`, the closed
immersion `Spec (.of A) ⟶ 𝔸(ULift (Fin n); Spec (.of k))` admits a `k`-linear projection onto an
affine space `𝔸(ULift (Fin d); Spec (.of k))` of dimension `d = ringKrullDim A` whose restriction to
`Spec (.of A)` is finite, surjective, and has finite fibers.

## Main declarations

* `AlgebraicGeometry.AffineSpace.linearMap`: the `S`-morphism `𝔸(n; S) ⟶ 𝔸(m; S)` defined by a
  matrix `C : Matrix m n Γ(S, ⊤)`.
* `AlgebraicGeometry.AffineSpace.linearIso`: the `S`-automorphism of `𝔸(n; S)` induced by an
  invertible matrix `M : (Matrix n n Γ(S, ⊤))ˣ`.
* `AlgebraicGeometry.AffineSpace.homOfAlgebra`: the presentation morphism
  `Spec (.of A) ⟶ 𝔸(n; Spec (.of R))` attached to `x : n → A`.
* `AlgebraicGeometry.AffineSpace.exists_linear_normalization`: geometric linear Noether
  normalization for a closed subscheme of affine space over an infinite field.

## References

* J. S. Milne, *Algebraic Geometry*, Theorem 2.45 (pp. 55–56).
* [Stacks Project, Tag 00OY](https://stacks.math.columbia.edu/tag/00OY)
-/

public section

open CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineSpace

universe u

noncomputable section

section LinearMap

variable {m n p : Type u} [Fintype n] (S : Scheme.{u})

/-- The `S`-linear morphism `𝔸(n; S) ⟶ 𝔸(m; S)` induced by a matrix `C : Matrix m n Γ(S, ⊤)`,
sending a coordinate tuple `v` to `i ↦ ∑ j, C i j * v j`. -/
def linearMap (C : Matrix m n Γ(S, ⊤)) : 𝔸(n; S) ⟶ 𝔸(m; S) :=
  homOfVector (𝔸(n; S) ↘ S) fun i ↦ ∑ j, (𝔸(n; S) ↘ S).appTop (C i j) * coord S j

/-- `linearMap S C` commutes with the structure morphisms to `S`. -/
@[reassoc]
lemma linearMap_over (C : Matrix m n Γ(S, ⊤)) :
    linearMap S C ≫ 𝔸(m; S) ↘ S = 𝔸(n; S) ↘ S :=
  homOfVector_over _ _

instance (C : Matrix m n Γ(S, ⊤)) : (linearMap S C).IsOver S := by
  dsimp [linearMap]
  infer_instance

/-- Pulling back the `i`-th coordinate along `linearMap S C` yields `∑ j, C i j * coord S j`. -/
@[simp]
lemma linearMap_appTop_coord (C : Matrix m n Γ(S, ⊤)) (i : m) :
    (linearMap S C).appTop (coord S i) = ∑ j, (𝔸(n; S) ↘ S).appTop (C i j) * coord S j :=
  homOfVector_appTop_coord _ _ _

/-- Composing a vector-defined morphism `X ⟶ 𝔸(n; S)` with `linearMap S C` multiplies the
coordinate vector by `C`. -/
@[reassoc]
lemma homOfVector_linearMap {X : Scheme.{u}} (f : X ⟶ S) (v : n → Γ(X, ⊤))
    (C : Matrix m n Γ(S, ⊤)) :
    homOfVector f v ≫ linearMap S C =
      homOfVector f (fun i ↦ ∑ j, f.appTop (C i j) * v j) := by
  refine hom_ext (by simp) fun i ↦ ?_
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, linearMap_appTop_coord,
    homOfVector_appTop_coord, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [map_mul, homOfVector_appTop_coord, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop,
    homOfVector_over]

/-- The zero matrix induces the constant zero section morphism `𝔸(n; S) ⟶ 𝔸(m; S)`. -/
@[simp]
lemma linearMap_zero :
    linearMap S (0 : Matrix m n Γ(S, ⊤)) = homOfVector (𝔸(n; S) ↘ S) 0 := by
  refine hom_ext (by simp) fun i ↦ ?_
  simp

/-- The identity matrix induces the identity morphism on `𝔸(n; S)`. -/
@[simp]
lemma linearMap_one [DecidableEq n] :
    linearMap S (1 : Matrix n n Γ(S, ⊤)) = 𝟙 𝔸(n; S) := by
  refine hom_ext (by simp) fun i ↦ ?_
  simp [Matrix.one_apply]

/-- Composition of linear morphisms of affine spaces corresponds to matrix multiplication. -/
@[reassoc]
lemma linearMap_comp [Fintype p] (C : Matrix m n Γ(S, ⊤)) (D : Matrix n p Γ(S, ⊤)) :
    linearMap S D ≫ linearMap S C = linearMap S (C * D) := by
  refine hom_ext (by simp) fun i ↦ ?_
  have lhs : (linearMap S D ≫ linearMap S C).appTop (coord S i) =
      ∑ j : n, ∑ k : p,
        ((𝔸(p; S) ↘ S).appTop (C i j) * (𝔸(p; S) ↘ S).appTop (D j k)) * coord S k := by
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, linearMap_appTop_coord, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_mul, linearMap_appTop_coord, Finset.mul_sum, ← CommRingCat.comp_apply,
      ← Scheme.Hom.comp_appTop, linearMap_over]
    exact Finset.sum_congr rfl fun k _ ↦ (mul_assoc _ _ _).symm
  have rhs : (linearMap S (C * D)).appTop (coord S i) =
      ∑ k : p, ∑ j : n,
        ((𝔸(p; S) ↘ S).appTop (C i j) * (𝔸(p; S) ↘ S).appTop (D j k)) * coord S k := by
    rw [linearMap_appTop_coord]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
    exact Finset.sum_congr rfl fun j _ ↦ by rw [map_mul]
  rw [lhs, rhs, Finset.sum_comm]

/-- Postcomposing `linearMap S C` with `reindex g S` restricts the rows of `C` along `g`. -/
@[reassoc]
lemma linearMap_reindex {q : Type u} (C : Matrix m n Γ(S, ⊤)) (g : q → m) :
    linearMap S C ≫ reindex g S = linearMap S (C.submatrix g id) := by
  refine hom_ext (by simp) fun i ↦ ?_
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, reindex_appTop_coord,
    linearMap_appTop_coord, linearMap_appTop_coord]
  rfl

variable {S} in
/-- Base change of `linearMap T C` along `f : S ⟶ T` applies `f.appTop` to the entries of `C`. -/
@[reassoc]
lemma map_linearMap {T : Scheme.{u}} (f : S ⟶ T) (C : Matrix m n Γ(T, ⊤)) :
    map n f ≫ linearMap T C = linearMap S (C.map f.appTop) ≫ map m f := by
  refine hom_ext (by simp) fun i ↦ ?_
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
    CommRingCat.comp_apply, linearMap_appTop_coord, map_appTop_coord, linearMap_appTop_coord,
    map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [map_mul, map_appTop_coord, Matrix.map_apply, ← CommRingCat.comp_apply,
    ← Scheme.Hom.comp_appTop, map_over, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]

/-- An invertible matrix `M : (Matrix n n Γ(S, ⊤))ˣ` induces an `S`-automorphism of `𝔸(n; S)`. -/
def linearIso [DecidableEq n] (M : (Matrix n n Γ(S, ⊤))ˣ) : 𝔸(n; S) ≅ 𝔸(n; S) where
  hom := linearMap S M.val
  inv := linearMap S M⁻¹.val
  hom_inv_id := by rw [linearMap_comp, Units.inv_mul, linearMap_one]
  inv_hom_id := by rw [linearMap_comp, Units.mul_inv, linearMap_one]

/-- The forward morphism of `linearIso S M` is `linearMap S M.val`. -/
@[simp]
lemma linearIso_hom [DecidableEq n] (M : (Matrix n n Γ(S, ⊤))ˣ) :
    (linearIso S M).hom = linearMap S M.val :=
  (rfl)

/-- The inverse morphism of `linearIso S M` is `linearMap S M⁻¹.val`. -/
@[simp]
lemma linearIso_inv [DecidableEq n] (M : (Matrix n n Γ(S, ⊤))ˣ) :
    (linearIso S M).inv = linearMap S M⁻¹.val :=
  (rfl)

end LinearMap

section HomOfAlgebra

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] {m n : Type u}

/-- The `Spec R`-morphism `Spec (.of A) ⟶ 𝔸(n; Spec (.of R))` corresponding to the `R`-algebra
evaluation homomorphism `MvPolynomial.aeval x : MvPolynomial n R →ₐ[R] A`. -/
def homOfAlgebra (x : n → A) : Spec (.of A) ⟶ 𝔸(n; Spec (.of R)) :=
  Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (R := R) x).toRingHom) ≫
    (SpecIso n (.of R)).inv

/-- Composing `homOfAlgebra x` with `(SpecIso n (.of R)).hom` recovers `Spec.map (aeval x)`. -/
@[reassoc (attr := simp)]
lemma homOfAlgebra_specIso_hom (x : n → A) :
    homOfAlgebra (R := R) x ≫ (SpecIso n (.of R)).hom =
      Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (R := R) x).toRingHom) := by
  simp [homOfAlgebra]

/-- `homOfAlgebra x` lies over `Spec (.of R)` via `Spec.map (algebraMap R A)`. -/
@[reassoc (attr := simp)]
lemma homOfAlgebra_over (x : n → A) :
    homOfAlgebra (R := R) x ≫ 𝔸(n; Spec (.of R)) ↘ Spec (.of R) =
      Spec.map (CommRingCat.ofHom (algebraMap R A)) := by
  rw [homOfAlgebra, Category.assoc, SpecIso_inv_over, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  ext r
  simp

/-- Pulling back the `i`-th coordinate of `𝔸(n; Spec (.of R))` along `homOfAlgebra x` gives the
global section corresponding to `x i`. -/
@[simp]
lemma homOfAlgebra_appTop_coord (x : n → A) (i : n) :
    (homOfAlgebra (R := R) x).appTop (coord (Spec (.of R)) i) =
      (Scheme.ΓSpecIso (.of A)).inv (x i) := by
  rw [homOfAlgebra, Scheme.Hom.comp_appTop, CommRingCat.comp_apply, SpecIso_inv_appTop_coord,
    ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply,
    ConcreteCategory.hom_ofHom]
  simp

/-- `homOfAlgebra x` agrees with `homOfVector` applied to the global sections corresponding to
`x`. -/
lemma homOfAlgebra_eq_homOfVector (x : n → A) :
    homOfAlgebra (R := R) x =
      homOfVector (Spec.map (CommRingCat.ofHom (algebraMap R A)))
        ((Scheme.ΓSpecIso (.of A)).inv ∘ x) := by
  refine hom_ext (by simp) fun i ↦ ?_
  simp

/-- Composing `homOfAlgebra x` with the linear map defined by a matrix `C : Matrix m n R` produces
`homOfAlgebra` for the linear combinations `i ↦ ∑ j, C i j • x j`. -/
@[reassoc]
lemma homOfAlgebra_linearMap [Fintype n] (x : n → A) (C : Matrix m n R) :
    homOfAlgebra (R := R) x ≫
        linearMap (Spec (.of R)) (C.map (Scheme.ΓSpecIso (.of R)).inv) =
      homOfAlgebra (R := R) (fun i ↦ ∑ j, C i j • x j) := by
  refine hom_ext (by simp) fun i ↦ ?_
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, linearMap_appTop_coord,
    homOfAlgebra_appTop_coord, map_sum, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [map_mul, Matrix.map_apply, homOfAlgebra_appTop_coord, ← CommRingCat.comp_apply,
    ← Scheme.Hom.comp_appTop, homOfAlgebra_over, ← CommRingCat.comp_apply,
    ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply, ConcreteCategory.hom_ofHom,
    ← map_mul, Algebra.smul_def]

/-- If `x : n → A` generates `A` as an `R`-algebra, then `homOfAlgebra x` is a closed immersion
`Spec (.of A) ⟶ 𝔸(n; Spec (.of R))`. -/
theorem isClosedImmersion_homOfAlgebra {x : n → A}
    (hx : Algebra.adjoin R (Set.range x) = ⊤) :
    IsClosedImmersion (homOfAlgebra (R := R) x) := by
  have hsurj : Function.Surjective (MvPolynomial.aeval (R := R) x) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, hx]
  exact (MorphismProperty.cancel_right_of_respectsIso @IsClosedImmersion _
    (SpecIso n (.of R)).inv).mpr (IsClosedImmersion.spec_of_surjective _ hsurj)

/-- If `MvPolynomial.aeval y` makes `A` a finite module over `MvPolynomial n R`, then
`homOfAlgebra y : Spec (.of A) ⟶ 𝔸(n; Spec (.of R))` is a finite morphism of schemes. -/
theorem isFinite_homOfAlgebra {y : n → A}
    (hfin : (MvPolynomial.aeval (R := R) y).Finite) :
    IsFinite (homOfAlgebra (R := R) y) := by
  have : IsFinite (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (R := R) y).toRingHom)) :=
    (IsFinite.SpecMap_iff _).mpr hfin
  dsimp only [homOfAlgebra]
  infer_instance

/-- If `y : n → A` is algebraically independent over `R` and makes `A` integral over
`MvPolynomial n R`, then `homOfAlgebra y : Spec (.of A) ⟶ 𝔸(n; Spec (.of R))` is surjective. -/
theorem surjective_homOfAlgebra {y : n → A}
    (hind : AlgebraicIndependent R y)
    (hint : (MvPolynomial.aeval (R := R) y).toRingHom.IsIntegral) :
    Surjective (homOfAlgebra (R := R) y) := by
  have : Surjective (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (R := R) y).toRingHom)) :=
    ⟨hint.comap_surjective (algebraicIndependent_iff_injective_aeval.mp hind)⟩
  dsimp only [homOfAlgebra]
  infer_instance

/-- Every fiber of a module-finite affine presentation `homOfAlgebra y` is a finite set. -/
theorem finite_preimage_singleton_homOfAlgebra {y : n → A}
    (hfin : (MvPolynomial.aeval (R := R) y).Finite) (q : 𝔸(n; Spec (.of R))) :
    (homOfAlgebra (R := R) y ⁻¹' {q}).Finite := by
  have := isFinite_homOfAlgebra (R := R) hfin
  exact (homOfAlgebra (R := R) y).finite_preimage_singleton q

end HomOfAlgebra

section NoetherNormalization

/-- **Geometric linear Noether normalization.** Let `k` be an infinite field and `A` be a nontrivial
`k`-algebra generated by `x : Fin n → A`. Then `ι := homOfAlgebra (x ∘ ULift.down)` is a closed
immersion `Spec (.of A) ⟶ 𝔸(ULift.{u} (Fin n); Spec (.of k))`, and there exist `d ≤ n` and a
matrix `C : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin n)) k` such that the restricted linear
projection `π : Spec (.of A) ⟶ 𝔸(ULift.{u} (Fin d); Spec (.of k))` is finite, surjective, has
finite fibers, and targets an affine space of dimension `d = ringKrullDim A`. -/
theorem exists_linear_normalization {k A : Type u} [Field k] [Infinite k] [CommRing A]
    [Nontrivial A] [Algebra k A] {n : ℕ} (x : Fin n → A)
    (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    IsClosedImmersion (homOfAlgebra (R := k) (x ∘ ULift.down)) ∧
      ∃ (d : ℕ) (_ : d ≤ n) (C : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin n)) k),
        let π := homOfAlgebra (R := k) (x ∘ ULift.down) ≫
          linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv)
        IsFinite π ∧ Surjective π ∧ (∀ q, (π ⁻¹' {q}).Finite) ∧ ringKrullDim A = d := by
  have hrange : Set.range (x ∘ ULift.down : ULift.{u} (Fin n) → A) = Set.range x :=
    Equiv.ulift.surjective.range_comp x
  refine ⟨isClosedImmersion_homOfAlgebra (hrange.symm ▸ hx), ?_⟩
  obtain ⟨d, hd, C₀, hy_ind, hy_fin, hdim⟩ := TauCeti.exists_linear_normalization x hx
  let C : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin n)) k :=
    C₀.submatrix ULift.down ULift.down
  let y : Fin d → A := fun i ↦ ∑ j, C₀ i j • x j
  have hπ : homOfAlgebra (R := k) (x ∘ ULift.down) ≫
      linearMap (Spec (.of k)) (C.map (Scheme.ΓSpecIso (.of k)).inv) =
      homOfAlgebra (R := k) (y ∘ ULift.down) := by
    rw [homOfAlgebra_linearMap]
    congr 1
    funext ⟨i⟩
    simpa [C, y] using (Equiv.ulift.sum_comp fun j ↦ C₀ i j • x j)
  have hy_ind' : AlgebraicIndependent k (y ∘ ULift.down : ULift.{u} (Fin d) → A) :=
    (algebraicIndependent_equiv Equiv.ulift).mpr hy_ind
  have haeval : (MvPolynomial.aeval (R := k) (y ∘ ULift.down : ULift.{u} (Fin d) → A)).toRingHom =
      (MvPolynomial.aeval (R := k) y).toRingHom.comp
        (MvPolynomial.renameEquiv k Equiv.ulift).toAlgHom.toRingHom := by
    ext i <;> simp
  have hy_fin' : (MvPolynomial.aeval (R := k) (y ∘ ULift.down : ULift.{u} (Fin d) → A)).Finite := by
    change (MvPolynomial.aeval (R := k) (y ∘ ULift.down : ULift.{u} (Fin d) → A)).toRingHom.Finite
    rw [haeval]
    exact RingHom.Finite.comp hy_fin
      (RingHom.Finite.of_surjective _ (MvPolynomial.renameEquiv k Equiv.ulift).surjective)
  refine ⟨d, hd, C, ?_⟩
  dsimp only
  rw [hπ]
  exact ⟨isFinite_homOfAlgebra hy_fin', surjective_homOfAlgebra hy_ind' hy_fin'.to_isIntegral,
    finite_preimage_singleton_homOfAlgebra hy_fin', hdim⟩

end NoetherNormalization

end

end AlgebraicGeometry.AffineSpace
