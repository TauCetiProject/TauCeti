/-! ### Locally factorial schemes are normal -/

/-- A scheme whose local rings are unique factorization domains is normal. -/
theorem IsNormalScheme.of_uniqueFactorizationMonoid_stalk {X : Scheme.{u}}
    [∀ x : X, IsDomain (X.presheaf.stalk x)]
    [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] : IsNormalScheme X where
  isDomain_stalk := inferInstance
  isIntegrallyClosed_stalk _ := inferInstance

namespace Scheme

/-! ### Primes of stalks and algebraic Hartogs' principle on normal schemes -/

/-- Every prime ideal `P` of a local ring `𝒪_{X,x}` of a locally Noetherian scheme arises from a
generization `η ⤳ x` whose codimension equals `P.height`. -/
theorem exists_specializes_and_comap_stalkSpecializes_maximalIdeal_eq {X : Scheme.{u}}
    [IsLocallyNoetherian X] {x : X} (P : Ideal (X.presheaf.stalk x)) [P.IsPrime] :
    ∃ η : X, coheight η = P.height ∧ ∃ h : η ⤳ x,
      (maximalIdeal (X.presheaf.stalk η)).comap (X.presheaf.stalkSpecializes h).hom = P := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  replace hU : IsAffineOpen U := hU
  let := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  have := hU.isLocalization_stalk ⟨x, hxU⟩
  set p := hU.primeIdealOf ⟨x, hxU⟩
  let q : Spec Γ(X, U) := ⟨P.comap (algebraMap Γ(X, U) (X.presheaf.stalk x)), inferInstance⟩
  have hqp : q.asIdeal ≤ p.asIdeal := by
    rw [← IsLocalization.AtPrime.under_maximalIdeal (X.presheaf.stalk x) p.asIdeal]
    exact Ideal.comap_mono (le_maximalIdeal Ideal.IsPrime.ne_top')
  have hηx : hU.fromSpec q ⤳ x :=
    (((PrimeSpectrum.le_iff_specializes q p).mp hqp).map hU.fromSpec.continuous).trans
      (specializes_of_eq (hU.fromSpec_primeIdealOf ⟨x, hxU⟩))
  have hprime : hU.primeIdealOf ⟨_, hηx.mem_open U.isOpen hxU⟩ = q :=
    hU.fromSpec.isOpenEmbedding.injective (hU.fromSpec_primeIdealOf _)
  have hdisj : Disjoint (p.asIdeal.primeCompl : Set Γ(X, U)) q.asIdeal :=
    Set.disjoint_left.mpr fun a ha haq ↦ ha (hqp haq)
  have hmap : q.asIdeal.map (algebraMap Γ(X, U) (X.presheaf.stalk x)) = P :=
    IsLocalization.map_under p.asIdeal.primeCompl _ P
  have hcoh : coheight (hU.fromSpec q) = P.height := by
    rw [coheight_eq_of_isOpenImmersion hU.fromSpec, ← idealHeight_eq_coheight,
      ← IsLocalization.height_map_of_disjoint (S := X.presheaf.stalk x) p.asIdeal.primeCompl
        q.asIdeal hdisj, hmap]
  refine ⟨hU.fromSpec q, hcoh, hηx, ?_⟩
  rw [← IsLocalization.map_under p.asIdeal.primeCompl (X.presheaf.stalk x)
      ((maximalIdeal _).comap (X.presheaf.stalkSpecializes hηx).hom), ← hmap]
  exact congrArg _ ((comap_germ_comap_stalkSpecializes_maximalIdeal hU hxU hηx).trans
    (congrArg _ hprime))

section Normal

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormalScheme X]

/-- **Local algebraic Hartogs' principle.** At a point `x` of a locally Noetherian normal integral
scheme, a rational function `f` whose order of vanishing is nonnegative at every codimension-one
generization of `x` lies in the local ring `𝒪_{X,x}`. -/
theorem exists_algebraMap_stalk_eq_of_ord_nonneg_of_isNormalScheme {x : X} {f : X.functionField}
    (hf : ∀ η : CodimensionOnePoint X, (η : X) ⤳ x → 0 ≤ X.ord f η) :
    ∃ g : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField g = f := by
  set A := X.presheaf.stalk x
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := A) f
  by_cases hab : a ∈ Ideal.span {b}
  · obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hab
    refine ⟨g, ?_⟩
    have hb0 : algebraMap A X.functionField b ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
    rw [map_mul, mul_div_cancel_right₀ _ hb0]
  exfalso
  -- `A` is a Noetherian normal domain, so it satisfies `(S_2)` and every associated prime `P` of
  -- `A ⧸ (b)` containing `((b) : a)` has height one.
  have hS : Module.SatisfiesSerreS 2 A A :=
    TauCeti.satisfiesSerreS_two_of_forall_isIntegrallyClosed fun p _ ↦
      ⟨inferInstance, isIntegrallyClosed_of_isLocalization _ p.primeCompl
        p.primeCompl_le_nonZeroDivisors⟩
  obtain ⟨P, hPass, hle⟩ := exists_le_isAssociatedPrime_of_isNoetherianRing A
    (Ideal.Quotient.mk (Ideal.span {b}) a) (by rwa [Ne, Ideal.Quotient.eq_zero_iff_mem])
  have := hPass.isPrime
  have hP1 : P.height = 1 :=
    hS.height_eq_one_of_isAssociatedPrime_quotient_span_singleton hb hPass
  obtain ⟨η, hηcoh, hηx, hcomap⟩ := exists_specializes_and_comap_stalkSpecializes_maximalIdeal_eq P
  rw [hP1] at hηcoh
  have : IsDiscreteValuationRing (X.presheaf.stalk η) :=
    IsNormalScheme.isDiscreteValuationRing_stalk η hηcoh
  -- Nonnegative order at `η` puts `a / b` in `𝒪_{X,η} = A_P`, giving `s * a ∈ (b)` for `s ∉ P`.
  obtain ⟨c, hc⟩ := exists_algebraMap_stalk_eq_of_ord_nonneg (hf ⟨η, hηcoh⟩ hηx)
  let := (X.presheaf.stalkSpecializes hηx).hom.toAlgebra
  set Q := (maximalIdeal (X.presheaf.stalk η)).comap (X.presheaf.stalkSpecializes hηx).hom
  have := isLocalization_stalkSpecializes hηx
  obtain ⟨⟨d, s⟩, hds⟩ := IsLocalization.surj Q.primeCompl c
  have hba : algebraMap A X.functionField (s * a) = algebraMap A X.functionField (b * d) := by
    have hb0 : algebraMap A X.functionField b ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
    have hcd := congrArg (algebraMap (X.presheaf.stalk η) X.functionField) hds
    rw [map_mul] at hcd
    change algebraMap (X.presheaf.stalk η) X.functionField c *
        algebraMap (X.presheaf.stalk η) X.functionField
          ((X.presheaf.stalkSpecializes hηx).hom s.1) =
      algebraMap (X.presheaf.stalk η) X.functionField
        ((X.presheaf.stalkSpecializes hηx).hom d) at hcd
    rw [algebraMap_stalkSpecializes, algebraMap_stalkSpecializes, hc,
      mul_comm _ (algebraMap A _ (s : A))] at hcd
    have hcd' := congrArg (· * algebraMap A X.functionField b) hcd
    rw [mul_div_assoc', div_mul_cancel₀ _ hb0, mul_comm _ (algebraMap A X.functionField b)] at hcd'
    rw [map_mul, map_mul]
    exact hcd'
  have hsa : (s : A) * a ∈ Ideal.span {b} :=
    Ideal.mem_span_singleton'.mpr ⟨d, mul_comm d b ▸
      IsFractionRing.injective A X.functionField hba.symm⟩
  exact (hcomap ▸ s.2 : (s : A) ∉ P) (hle (TauCeti.Ideal.Quotient.mem_colon_singleton_mk.mpr hsa))

/-- **Algebraic Hartogs' principle on normal Noetherian schemes.** On a locally Noetherian normal
integral scheme, a rational function whose order of vanishing is nonnegative at every
codimension-one point of a nonempty open subset `U` is regular on `U`. -/
theorem exists_germToFunctionField_eq_of_ord_nonneg_of_isNormalScheme {U : X.Opens} [Nonempty U]
    {f : X.functionField} (hf : ∀ y : CodimensionOnePoint X, (y : X) ∈ U → 0 ≤ X.ord f y) :
    ∃ a : Γ(X, U), X.germToFunctionField U a = f :=
  exists_germToFunctionField_eq_of_forall_mem_range fun _ hx ↦
    exists_algebraMap_stalk_eq_of_ord_nonneg_of_isNormalScheme fun y hyx ↦
      hf y (hyx.mem_open U.isOpen hx)

/-- **A rational function without zeros or poles on a normal scheme is a regular unit.** On a
locally Noetherian normal integral scheme, a nonzero rational function whose order vanishes at
every codimension-one point of a nonempty open subset `U` comes from a unit of `Γ(X, U)`. -/
theorem exists_unit_germToFunctionField_eq_of_ord_eq_zero_of_isNormalScheme {U : X.Opens}
    [Nonempty U] {f : X.functionFieldˣ}
    (hf : ∀ y : CodimensionOnePoint X, (y : X) ∈ U → X.ord (f : X.functionField) y = 0) :
    ∃ u : Γ(X, U)ˣ, X.germToFunctionField U (u : Γ(X, U)) = (f : X.functionField) := by
  obtain ⟨a, ha⟩ := exists_germToFunctionField_eq_of_ord_nonneg_of_isNormalScheme (U := U)
    (f := (f : X.functionField)) fun y hy ↦ (hf y hy).ge
  obtain ⟨b, hb⟩ := exists_germToFunctionField_eq_of_ord_nonneg_of_isNormalScheme (U := U)
    (f := ((f⁻¹ : X.functionFieldˣ) : X.functionField)) fun y hy ↦ by
      rw [Units.val_inv_eq_inv_val, AlgebraicGeometry.Scheme.ord_inv, hf y hy, neg_zero]
  have hab : a * b = 1 := X.germToFunctionField_injective U <| by
    rw [map_mul, ha, hb, map_one, Units.mul_inv]
  exact ⟨⟨a, b, hab, (mul_comm b a).trans hab⟩, ha⟩

/-- On a locally Noetherian normal integral scheme, two nonzero rational functions with the same
orders at all codimension-one points of a nonempty open subset `U` represent the same Cartier
divisor section over `U`. -/
theorem rationalUnitClass_eq_of_forall_orderAt_eq_of_isNormalScheme {U : X.Opens} [Nonempty U]
    {g h : Additive X.functionFieldˣ}
    (hord : ∀ y : CodimensionOnePoint X, (y : X) ∈ U →
      SchemeWeilDivisor.orderAt y g = SchemeWeilDivisor.orderAt y h) :
    rationalUnitClass X U g = rationalUnitClass X U h := by
  have hzero : ∀ y : CodimensionOnePoint X, (y : X) ∈ U →
      X.ord ((Additive.toMul (g - h) : X.functionFieldˣ) : X.functionField) y = 0 := fun y hy ↦ by
    rw [← SchemeWeilDivisor.orderAt_apply y (g - h), map_sub, hord y hy, sub_self]
  obtain ⟨u, hu⟩ := exists_unit_germToFunctionField_eq_of_ord_eq_zero_of_isNormalScheme hzero
  have hunit : Units.map (X.germToFunctionField U).hom u = Additive.toMul (g - h) := Units.ext hu
  have hcl := rationalUnitClass_germToFunctionField_eq_zero X U u
  rw [hunit] at hcl
  refine sub_eq_zero.mp ?_
  rw [← map_sub]
  simpa only [ofMul_toMul] using hcl

end Normal

namespace CartierDivisor

/-! ### Injectivity of `toWeilDivisorHom` on Noetherian normal schemes -/

section NormalNoetherian

variable {X : Scheme.{u}} [IsIntegral X] [IsNoetherian X] [IsNormalScheme X]

/-- **Cartier divisors embed into Weil divisors on a Noetherian normal scheme.** Two Cartier
divisors with the same associated Weil divisor are equal: locally their equations have the same
orders at every codimension-one point, hence differ by a regular unit. -/
theorem toWeilDivisorHom_injective : Function.Injective (toWeilDivisorHom (X := X)) := by
  refine (injective_iff_map_eq_zero _).mpr fun D hD ↦ ?_
  choose U _ hxU f hf using fun x : X ↦ exists_local_equation X D x (Opens.mem_top x)
  refine (cartierDivisorSheaf X).eq_of_locally_eq' U ⊤ (fun _ ↦ homOfLE le_top)
    (fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxU x⟩) D 0 fun x ↦ ?_
  have : Nonempty (U x) := ⟨⟨x, hxU x⟩⟩
  let g := rationalUnitSectionsEquiv X (U x) (f x)
  have hDg : D |_ (U x) = rationalUnitClass X (U x) g := by
    rw [rationalUnitClass_apply]
    simpa only [g, AddEquiv.symm_apply_apply] using (hf x).symm
  have hD0 : D.toWeilDivisor = 0 := (toWeilDivisorHom_apply D).symm.trans hD
  have hord : ∀ y : CodimensionOnePoint X, (y : X) ∈ U x →
      SchemeWeilDivisor.orderAt y g = SchemeWeilDivisor.orderAt y 0 := fun y hy ↦ by
    rw [map_zero, ← orderAt_eq_of_restrict_eq_rationalUnitClass D y (U x) hy g hDg,
      ← coeff_toWeilDivisor, hD0, WeilDivisor.coeff_zero]
  change D |_ U x = (0 : CartierDivisor X) |_ U x
  rw [hDg, rationalUnitClass_eq_of_forall_orderAt_eq_of_isNormalScheme hord, map_zero]
  exact (map_zero ((cartierDivisorSheaf X).obj.map (homOfLE le_top).op).hom).symm

/-- On a Noetherian normal integral scheme, a Cartier divisor is principal if and only if its
associated Weil divisor is principal. -/
theorem mem_principalSubgroup_iff_toWeilDivisor_mem {D : CartierDivisor X} :
    D ∈ principalSubgroup X ↔
      D.toWeilDivisor ∈ (WeilDivisor.OrderSystem.ofScheme X).principalSubgroup := by
  rw [mem_principalSubgroup, WeilDivisor.OrderSystem.mem_principalSubgroup]
  refine ⟨fun ⟨f, hf⟩ ↦ ⟨Additive.ofMul f, ?_⟩, fun ⟨g, hg⟩ ↦ ⟨g.toMul, ?_⟩⟩
  · rw [← hf, ← toWeilDivisor_principalCartierDivisor, toMul_ofMul]
  · apply toWeilDivisorHom_injective
    rw [toWeilDivisorHom_apply, toWeilDivisorHom_apply, toWeilDivisor_principalCartierDivisor, hg]

end NormalNoetherian

/-! ### The Cartier divisor of an effective Cartier ideal sheaf -/

section OfEffectiveCartier

variable {X : Scheme.{u}} [IsIntegral X] {I : X.IdealSheafData}

/-- If an ideal sheaf `I` on an integral scheme is generated on two affine opens `U` and `V` by
nonzero sections `a` and `b`, then on any nonempty open `W ≤ U ⊓ V` their images in the function
field have the same Cartier-divisor class. -/
private lemma rationalUnitClass_eq_of_ideal_eq_span {U V : X.affineOpens} {W : X.Opens}
    [Nonempty U.1] [Nonempty V.1] [Nonempty W] (hWU : W ≤ U.1) (hWV : W ≤ V.1)
    {a : Γ(X, U)} {b : Γ(X, V)} (ha : IsSMulRegular Γ(X, U) a) (hb : IsSMulRegular Γ(X, V) b)
    (hIa : I.ideal U = Ideal.span {a}) (hIb : I.ideal V = Ideal.span {b})
    (fa fb : X.functionFieldˣ) (hfa : X.germToFunctionField U.1 a = fa)
    (hfb : X.germToFunctionField V.1 b = fb) :
    rationalUnitClass X W (Additive.ofMul fa) = rationalUnitClass X W (Additive.ofMul fb) := by
  have hbW : X.presheaf.map (homOfLE hWV).op b ∈ I.sections W :=
    I.map_mem_sections (homOfLE hWV) (I.mem_sections_of_ideal_eq_span hIb)
  have haW : X.presheaf.map (homOfLE hWU).op a ∈ I.sections W :=
    I.map_mem_sections (homOfLE hWU) (I.mem_sections_of_ideal_eq_span hIa)
  obtain ⟨u, hu⟩ := I.exists_mul_eq_of_ideal_eq_span ha hIa hWU hbW
  obtain ⟨v, hv⟩ := I.exists_mul_eq_of_ideal_eq_span hb hIb hWV haW
  have hfaW : X.germToFunctionField W (X.presheaf.map (homOfLE hWU).op a) = fa := by
    rw [← hfa]
    exact X.presheaf.germ_res_apply (homOfLE hWU) (genericPoint X) (genericPoint_mem W) a
  have hfbW : X.germToFunctionField W (X.presheaf.map (homOfLE hWV).op b) = fb := by
    rw [← hfb]
    exact X.presheaf.germ_res_apply (homOfLE hWV) (genericPoint X) (genericPoint_mem W) b
  have hu' : X.germToFunctionField W u * fa = fb := by
    have := congrArg (X.germToFunctionField W) hu
    rwa [map_mul, hfaW, hfbW, mul_comm] at this
  have hv' : X.germToFunctionField W v * fb = fa := by
    have := congrArg (X.germToFunctionField W) hv
    rwa [map_mul, hfbW, hfaW, mul_comm] at this
  have huv : u * v = 1 := X.germToFunctionField_injective W <| by
    apply mul_right_cancel₀ fa.ne_zero
    rw [map_mul, map_one, one_mul, mul_assoc, mul_comm (X.germToFunctionField W v), ← mul_assoc,
      hu', mul_comm, hv']
  let r : Γ(X, W)ˣ := ⟨u, v, huv, (mul_comm v u).trans huv⟩
  refine ((rationalUnitClass_eq_rationalUnitClass_iff X W fb fa).mpr ⟨r, Units.ext ?_⟩).symm
  rw [Units.val_mul, regularUnitToFunctionField_apply, Units.coe_map]
  exact hu'

/-- **Existence and uniqueness of the Cartier divisor of an effective Cartier ideal sheaf.** On an
integral scheme, an effective Cartier ideal sheaf `I` determines a unique Cartier divisor whose
restriction to every affine open `U` where `I(U) = (a)` is generated by a nonzerodivisor `a` is the
rational class of `a`. -/
theorem existsUnique_ofEffectiveCartier (hI : I.IsEffectiveCartier) :
    ∃! D : CartierDivisor X, ∀ (U : X.affineOpens) [Nonempty U.1] (a : Γ(X, U))
      (f : X.functionFieldˣ), IsSMulRegular Γ(X, U) a → I.ideal U = Ideal.span {a} →
        X.germToFunctionField U.1 a = f →
          D |_ U.1 = rationalUnitClass X U.1 (Additive.ofMul f) := by
  choose U hxU a ha hIa using (Scheme.IdealSheafData.isEffectiveCartier_iff I).mp hI
  have hne (x : X) : Nonempty (U x).1 := ⟨⟨x, hxU x⟩⟩
  have hfnz (x : X) : X.germToFunctionField (U x).1 (a x) ≠ 0 := by
    have := hne x
    have : Nontrivial Γ(X, U x) :=
      (X.germToFunctionField (U x).1).hom.domain_nontrivial
    intro h0
    have ha0 : a x = 0 := X.germToFunctionField_injective (U x).1 (h0.trans (map_zero _).symm)
    exact one_ne_zero (α := Γ(X, U x)) (ha x (by simp [ha0]))
  let f (x : X) : X.functionFieldˣ :=
    letI := hne x
    Units.mk0 (X.germToFunctionField (U x).1 (a x)) (hfnz x)
  have hcompat : TopCat.Presheaf.IsCompatible (cartierDivisorSheaf X).obj (fun x ↦ (U x).1)
      fun x ↦ letI := hne x; rationalUnitClass X (U x).1 (Additive.ofMul (f x)) := by
    intro x y
    have := hne x
    have := hne y
    let W : X.Opens := (U x).1 ⊓ (U y).1
    have : Nonempty W := by
      simpa [W] using nonempty_preirreducible_inter (U x).1.isOpen (U y).1.isOpen
        (by simpa using hne x) (by simpa using hne y)
    have hx := rationalUnitClass_restrict X (U := (U x).1) (V := W) inf_le_left
      (Additive.ofMul (f x))
    have hy := rationalUnitClass_restrict X (U := (U y).1) (V := W) inf_le_right
      (Additive.ofMul (f y))
    exact hx.trans ((rationalUnitClass_eq_of_ideal_eq_span inf_le_left inf_le_right
      (ha x) (ha y) (hIa x) (hIa y) (f x) (f y) rfl rfl).trans hy.symm)
  obtain ⟨D, hD, -⟩ := (cartierDivisorSheaf X).existsUnique_gluing' (fun x ↦ (U x).1) ⊤
    (fun _ ↦ homOfLE le_top) (fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxU x⟩) _ hcompat
  refine ⟨D, fun V hV b g hb hIb hbg ↦ ?_, fun D' hD' ↦ ?_⟩
  · refine (cartierDivisorSheaf X).eq_of_locally_eq' (fun x : X ↦ (U x).1 ⊓ V.1) V.1
      (fun _ ↦ homOfLE inf_le_right) (fun x hx ↦ Opens.mem_iSup.mpr ⟨x, hxU x, hx⟩) _ _ fun x ↦ ?_
    have := hne x
    let W : X.Opens := (U x).1 ⊓ V.1
    have : Nonempty W := by
      simpa [W] using nonempty_preirreducible_inter (U x).1.isOpen V.1.isOpen
        (by simpa using hne x) (by simpa using hV)
    have hDx : D |_ (U x).1 = rationalUnitClass X (U x).1 (Additive.ofMul (f x)) := hD x
    have hleft : (D |_ V.1) |_ W = rationalUnitClass X W (Additive.ofMul (f x)) := by
      rw [TopCat.Presheaf.restrict_restrict (inf_le_right : W ≤ V.1) le_top D,
        ← TopCat.Presheaf.restrict_restrict (inf_le_left : W ≤ (U x).1) le_top D, hDx,
        rationalUnitClass_restrict X inf_le_left]
    change (D |_ V.1) |_ W = (rationalUnitClass X V.1 (Additive.ofMul g)) |_ W
    rw [hleft, rationalUnitClass_restrict X inf_le_right]
    exact rationalUnitClass_eq_of_ideal_eq_span inf_le_left inf_le_right (ha x) hb (hIa x) hIb
      (f x) g rfl hbg
  · refine (cartierDivisorSheaf X).eq_of_locally_eq' (fun x ↦ (U x).1) ⊤
      (fun _ ↦ homOfLE le_top) (fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxU x⟩) _ _ fun x ↦ ?_
    have := hne x
    exact (hD' (U x) (a x) (f x) (ha x) (hIa x) rfl).trans (hD x).symm

/-- The Cartier divisor on an integral scheme attached to an effective Cartier ideal sheaf `I`. -/
def ofEffectiveCartier (hI : I.IsEffectiveCartier) : CartierDivisor X :=
  (existsUnique_ofEffectiveCartier hI).choose

/-- Over an affine open `U` where `I(U) = (a)` is generated by a nonzerodivisor `a`, the Cartier
divisor `ofEffectiveCartier hI` restricts to the class of `a`. -/
theorem ofEffectiveCartier_restrict (hI : I.IsEffectiveCartier) (U : X.affineOpens) [Nonempty U.1]
    {a : Γ(X, U)} {f : X.functionFieldˣ} (ha : IsSMulRegular Γ(X, U) a)
    (hIa : I.ideal U = Ideal.span {a}) (hf : X.germToFunctionField U.1 a = f) :
    ofEffectiveCartier hI |_ U.1 = rationalUnitClass X U.1 (Additive.ofMul f) :=
  (existsUnique_ofEffectiveCartier hI).choose_spec.1 U a f ha hIa hf

/-- The Cartier divisor of an effective Cartier ideal sheaf is effective. -/
theorem isEffective_ofEffectiveCartier (hI : I.IsEffectiveCartier) :
    (ofEffectiveCartier hI).IsEffective := by
  refine isEffective_iff_exists.mpr fun x ↦ ?_
  obtain ⟨U, hxU, a, ha, hIa⟩ := (Scheme.IdealSheafData.isEffectiveCartier_iff I).mp hI x
  have : Nonempty U.1 := ⟨⟨x, hxU⟩⟩
  have : Nontrivial Γ(X, U) := (X.germToFunctionField U.1).hom.domain_nontrivial
  have hfnz : X.germToFunctionField U.1 a ≠ 0 := fun h0 ↦
    one_ne_zero (α := Γ(X, U)) (ha (by
      simp [X.germToFunctionField_injective U.1 (h0.trans (map_zero _).symm)]))
  let f : X.functionFieldˣ := Units.mk0 (X.germToFunctionField U.1 a) hfnz
  refine ⟨f, isLocalEquationAt_of_rationalUnitClass_eq
    (ofEffectiveCartier_restrict hI U ha hIa rfl).symm hxU, ?_⟩
  rw [Units.val_mk0, ← X.algebraMap_germ_eq_germToFunctionField hxU]
  exact RingHom.mem_range_self _ _

/-- Recovering the closed-subscheme ideal sheaf of `ofEffectiveCartier hI` returns `I`. -/
@[simp]
theorem idealSheaf_isEffective_ofEffectiveCartier (hI : I.IsEffectiveCartier) :
    (isEffective_ofEffectiveCartier hI).idealSheaf = I := by
  choose U hxU a ha hIa using (Scheme.IdealSheafData.isEffectiveCartier_iff I).mp hI
  let 𝒰 : X.OpenCover := X.openCoverOfIsOpenCover (fun x ↦ (U x).1)
    (eq_top_iff.mpr fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxU x⟩)
  refine Scheme.IdealSheafData.ext_of_comap_openCover 𝒰 fun (x : X) ↦ ?_
  have : Nonempty (U x).1 := ⟨⟨x, hxU x⟩⟩
  have : Nontrivial Γ(X, U x) := (X.germToFunctionField (U x).1).hom.domain_nontrivial
  have hfnz : X.germToFunctionField (U x).1 (a x) ≠ 0 := fun h0 ↦
    one_ne_zero (α := Γ(X, U x)) (ha x (by
      simp [X.germToFunctionField_injective (U x).1 (h0.trans (map_zero _).symm)]))
  let f : X.functionFieldˣ := Units.mk0 (X.germToFunctionField (U x).1 (a x)) hfnz
  have hspan := (isEffective_ofEffectiveCartier hI).idealSheaf_ideal_eq_span (U x)
    (ofEffectiveCartier_restrict hI (U x) (ha x) (hIa x) (f := f) rfl).symm
    (a := a x) rfl
  change ((isEffective_ofEffectiveCartier hI).idealSheaf).comap (U x).1.ι = I.comap (U x).1.ι
  rw [Scheme.IdealSheafData.comap_ι_eq_ofIdealTop, Scheme.IdealSheafData.comap_ι_eq_ofIdealTop,
    hspan, hIa x]

/-- **The line-bundle class of `ofEffectiveCartier hI` is `[I]⁻¹`.** -/
@[simp]
theorem toLineBundleClass_ofEffectiveCartier (hI : I.IsEffectiveCartier) :
    (ofEffectiveCartier hI).toLineBundleClass = (LineBundleClass.mk hI.toInvertibleSheaf)⁻¹ := by
  have h := (isEffective_ofEffectiveCartier hI).mk_idealSheaf_eq_inv
  rw [LineBundleClass.mk_toInvertibleSheaf_congr _ hI
    (idealSheaf_isEffective_ofEffectiveCartier hI)] at h
  rw [h, inv_inv]

end OfEffectiveCartier

/-! ### Weil–Cartier–Picard equivalence on Noetherian locally factorial schemes -/

section Factorial

open _root_.AlgebraicGeometry.Scheme.IdealSheafData (vanishingIdeal
  isEffectiveCartier_vanishingIdeal_closure_singleton
  map_ideal_vanishingIdeal_closure_singleton_of_specializes
  map_ideal_vanishingIdeal_closure_singleton_of_not_specializes)

variable {X : Scheme.{u}} [IsIntegral X] [IsNoetherian X]
  [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)]

/-- **The Weil divisor of a prime effective Cartier divisor.** On a Noetherian locally factorial
integral scheme, the Cartier divisor attached to the prime closed subscheme `closure {η}` has
associated Weil divisor `1 · [η]`. -/
@[simp]
theorem toWeilDivisor_ofEffectiveCartier_vanishingIdeal_closure_singleton
    (η : CodimensionOnePoint X) :
    (ofEffectiveCartier (isEffectiveCartier_vanishingIdeal_closure_singleton η.2)).toWeilDivisor =
      Finsupp.single η 1 := by
  set hη := isEffectiveCartier_vanishingIdeal_closure_singleton η.2
  refine WeilDivisor.ext fun y ↦ ?_
  obtain ⟨U, hyU, a, ha, hIa⟩ := (Scheme.IdealSheafData.isEffectiveCartier_iff _).mp hη y
  have : Nonempty U.1 := ⟨⟨y, hyU⟩⟩
  have : Nontrivial Γ(X, U) := (X.germToFunctionField U.1).hom.domain_nontrivial
  have hfnz : X.germToFunctionField U.1 a ≠ 0 := fun h0 ↦
    one_ne_zero (α := Γ(X, U)) (ha (by
      simp [X.germToFunctionField_injective U.1 (h0.trans (map_zero _).symm)]))
  let f : X.functionFieldˣ := Units.mk0 (X.germToFunctionField U.1 a) hfnz
  rw [coeff_toWeilDivisor_eq_ord _ y hyU f (ofEffectiveCartier_restrict hη U ha hIa rfl).symm]
  have hgerm_ne : X.presheaf.germ U.1 y hyU a ≠ 0 := fun h0 ↦
    hfnz (by rw [← X.algebraMap_germ_eq_germToFunctionField hyU, h0, map_zero])
  have hmap : ((vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩).ideal U).map
      (X.presheaf.germ U.1 y hyU).hom = Ideal.span {X.presheaf.germ U.1 y hyU a} := by
    rw [hIa, Ideal.map_span, Set.image_singleton]
  have hval : (f : X.functionField) =
      algebraMap (X.presheaf.stalk (y : X)) X.functionField (X.presheaf.germ U.1 y hyU a) :=
    (X.algebraMap_germ_eq_germToFunctionField hyU a).symm
  rw [hval]
  by_cases hyeq : η = y
  · subst hyeq
    rw [WeilDivisor.coeff, Finsupp.single_eq_same]
    rw [map_ideal_vanishingIdeal_closure_singleton_of_specializes hyU specializes_rfl] at hmap
    exact ord_algebraMap_stalk_eq_one η.2 specializes_rfl hmap
  · rw [WeilDivisor.coeff, Finsupp.single_eq_of_ne (Ne.symm hyeq)]
    have hnotsp : ¬ (η : X) ⤳ (y : X) := fun hsp ↦
      hyeq (CodimensionOnePoint.eq_of_specializes hsp)
    rw [map_ideal_vanishingIdeal_closure_singleton_of_not_specializes hyU hnotsp] at hmap
    have hu : IsUnit (X.presheaf.germ U.1 y hyU a) :=
      Ideal.span_singleton_eq_top.mp hmap.symm
    exact (ord_algebraMap_stalk_eq_zero_iff y.2 specializes_rfl hgerm_ne).mpr fun hmem ↦
      (Ideal.comap_isPrime _ _).ne_top (Ideal.eq_top_of_isUnit_mem _ hmem hu)

/-- **Every Weil divisor on a Noetherian locally factorial integral scheme comes from a Cartier
divisor.** -/
theorem toWeilDivisorHom_surjective : Function.Surjective (toWeilDivisorHom (X := X)) := by
  intro D
  induction D using Finsupp.induction_linear with
  | zero => exact ⟨0, map_zero _⟩
  | add D₁ D₂ h₁ h₂ =>
    obtain ⟨C₁, hC₁⟩ := h₁
    obtain ⟨C₂, hC₂⟩ := h₂
    exact ⟨C₁ + C₂, by rw [map_add, hC₁, hC₂]⟩
  | single η n =>
    refine ⟨n • ofEffectiveCartier (isEffectiveCartier_vanishingIdeal_closure_singleton η.2), ?_⟩
    rw [map_zsmul, toWeilDivisorHom_apply,
      toWeilDivisor_ofEffectiveCartier_vanishingIdeal_closure_singleton, Finsupp.smul_single,
      smul_eq_mul, mul_one]

/-- **The Weil–Cartier divisor equivalence (Hartshorne, Proposition II.6.11).** On a Noetherian
integral scheme whose local rings are unique factorization domains, Cartier divisors and Weil
divisors are canonically isomorphic, in arbitrary dimension. -/
def toWeilDivisorAddEquiv (X : Scheme.{u}) [IsIntegral X] [IsNoetherian X]
    [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] :
    CartierDivisor X ≃+ SchemeWeilDivisor X :=
  have := IsNormalScheme.of_uniqueFactorizationMonoid_stalk (X := X)
  AddEquiv.ofBijective (toWeilDivisorHom (X := X))
    ⟨toWeilDivisorHom_injective, toWeilDivisorHom_surjective⟩

/-- Applying `toWeilDivisorAddEquiv` gives `D.toWeilDivisor`. -/
@[simp]
lemma toWeilDivisorAddEquiv_apply (D : CartierDivisor X) :
    toWeilDivisorAddEquiv X D = D.toWeilDivisor :=
  toWeilDivisorHom_apply D

/-- Applying `toWeilDivisorAddEquiv.symm` to `1 · [η]` gives the Cartier divisor of
`closure {η}`. -/
@[simp]
lemma toWeilDivisorAddEquiv_symm_single_one (η : CodimensionOnePoint X) :
    (toWeilDivisorAddEquiv X).symm (Finsupp.single η 1) =
      ofEffectiveCartier (isEffectiveCartier_vanishingIdeal_closure_singleton η.2) := by
  apply (toWeilDivisorAddEquiv X).injective
  rw [AddEquiv.apply_symm_apply, toWeilDivisorAddEquiv_apply,
    toWeilDivisor_ofEffectiveCartier_vanishingIdeal_closure_singleton]

/-- The homomorphism `SchemeWeilDivisor X →+ Additive (LineBundleClass X)` sending a Weil divisor
to the isomorphism class of its associated Cartier line bundle on a Noetherian locally factorial
integral scheme. -/
def weilToLineBundleClassHom (X : Scheme.{u}) [IsIntegral X] [IsNoetherian X]
    [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] :
    SchemeWeilDivisor X →+ Additive (LineBundleClass X) :=
  (toLineBundleClassHom (X := X)).comp (toWeilDivisorAddEquiv X).symm.toAddMonoidHom

/-- `weilToLineBundleClassHom` sends `n · [η]` to `n • [𝒪_X(closure {η})]`. -/
@[simp]
theorem weilToLineBundleClassHom_single (η : CodimensionOnePoint X) (n : ℤ) :
    weilToLineBundleClassHom X (Finsupp.single η n) =
      n • Additive.ofMul (LineBundleClass.mk
        (isEffectiveCartier_vanishingIdeal_closure_singleton η.2).toInvertibleSheaf)⁻¹ := by
  have hsingle : Finsupp.single η n = n • Finsupp.single η (1 : ℤ) := by
    rw [Finsupp.smul_single, smul_eq_mul, mul_one]
  rw [hsingle, map_zsmul, weilToLineBundleClassHom, AddMonoidHom.comp_apply,
    AddEquiv.coe_toAddMonoidHom, toWeilDivisorAddEquiv_symm_single_one, toLineBundleClassHom_apply,
    toLineBundleClass_ofEffectiveCartier]

/-- `weilToLineBundleClassHom` is surjective onto `Additive (LineBundleClass X)`. -/
theorem weilToLineBundleClassHom_surjective :
    Function.Surjective (weilToLineBundleClassHom X) := by
  intro a
  obtain ⟨D, hD⟩ := toLineBundleClass_surjective a.toMul
  refine ⟨toWeilDivisorAddEquiv X D, ?_⟩
  rw [weilToLineBundleClassHom, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
    AddEquiv.symm_apply_apply, toLineBundleClassHom_apply, hD, ofMul_toMul]

/-- The kernel of `weilToLineBundleClassHom` is the subgroup of principal Weil divisors. -/
theorem ker_weilToLineBundleClassHom :
    (weilToLineBundleClassHom X).ker = (WeilDivisor.OrderSystem.ofScheme X).principalSubgroup := by
  have := IsNormalScheme.of_uniqueFactorizationMonoid_stalk (X := X)
  ext D
  rw [AddMonoidHom.mem_ker, weilToLineBundleClassHom, AddMonoidHom.comp_apply,
    ← AddMonoidHom.mem_ker, ← principalSubgroup_eq_ker, mem_principalSubgroup_iff_toWeilDivisor_mem,
    AddEquiv.coe_toAddMonoidHom, ← toWeilDivisorAddEquiv_apply, AddEquiv.apply_symm_apply]

/-- **The Weil divisor class group is the Picard group (Hartshorne, Corollary II.6.16).** On any
Noetherian integral scheme with factorial local rings, `Cl(X) ≃+ Additive (LineBundleClass X)` in
arbitrary dimension. -/
def weilClassGroupAddEquivLineBundleClass (X : Scheme.{u}) [IsIntegral X] [IsNoetherian X]
    [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] :
    (WeilDivisor.OrderSystem.ofScheme X).ClassGroup ≃+ Additive (LineBundleClass X) :=
  QuotientAddGroup.liftEquiv _ weilToLineBundleClassHom_surjective
    ker_weilToLineBundleClassHom.symm

/-- `weilClassGroupAddEquivLineBundleClass` evaluates on `divisorClass D` as
`weilToLineBundleClassHom X D`. -/
@[simp]
lemma weilClassGroupAddEquivLineBundleClass_divisorClass (D : SchemeWeilDivisor X) :
    weilClassGroupAddEquivLineBundleClass X
        ((WeilDivisor.OrderSystem.ofScheme X).divisorClass D) =
      weilToLineBundleClassHom X D := by
  rw [WeilDivisor.OrderSystem.divisorClass_eq_mk']
  exact QuotientAddGroup.liftEquiv_mk _ weilToLineBundleClassHom_surjective
    ker_weilToLineBundleClassHom.symm D

end Factorial

end CartierDivisor

end Scheme

/-! ### Prime-divisor line bundles and open-immersion Picard excision -/

section OpenExcision

open _root_.AlgebraicGeometry.Scheme.IdealSheafData (vanishingIdeal
  isEffectiveCartier_vanishingIdeal_closure_singleton)

/-- Along an open immersion `j : U ⟶ X`, the inverse image of the reduced vanishing ideal of a
closed set `Z` is the reduced vanishing ideal of `j ⁻¹' Z`. -/
theorem comap_vanishingIdeal_of_isOpenImmersion {U X : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    (Z : TopologicalSpace.Closeds X) :
    (vanishingIdeal Z).comap j = vanishingIdeal ⟨j ⁻¹' Z, Z.2.preimage j.continuous⟩ := by
  have hrad : ((vanishingIdeal Z).comap j).radical = (vanishingIdeal Z).comap j :=
    Scheme.IdealSheafData.ext (funext fun W ↦ by
      rw [Scheme.IdealSheafData.radical_ideal, Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion]
      exact ((PrimeSpectrum.isRadical_vanishingIdeal _).comap _).radical)
  rw [← hrad, ← Scheme.IdealSheafData.vanishingIdeal_support]
  congr 1
  ext u
  simp [Scheme.IdealSheafData.support_comap]

/-- If `η : X` lies outside the open image of `j : U ⟶ X`, then `closure {η}` misses `Set.range j`,
so its vanishing ideal pulls back to the unit ideal sheaf `⊤` on `U`. -/
theorem comap_vanishingIdeal_closure_singleton_eq_top_of_notMem_range {U X : Scheme.{u}}
    (j : U ⟶ X) [IsOpenImmersion j] {η : X} (hη : η ∉ Set.range j) :
    (vanishingIdeal ⟨closure {η}, isClosed_closure⟩).comap j = ⊤ := by
  rw [comap_vanishingIdeal_of_isOpenImmersion, ← Scheme.IdealSheafData.vanishingIdeal_bot]
  congr 1
  ext u
  simp only [TopologicalSpace.Closeds.coe_mk, TopologicalSpace.Closeds.coe_bot, Set.mem_preimage,
    Set.mem_empty_iff_false, iff_false]
  intro hmem
  exact hη ((specializes_iff_mem_closure.mpr hmem).mem_open j.isOpenEmbedding.isOpen_range ⟨u, rfl⟩)

/-- Along an open immersion `j : U ⟶ X`, the vanishing ideal of `closure {j u}` pulls back to the
vanishing ideal of `closure {u}`. -/
@[simp]
theorem comap_vanishingIdeal_closure_singleton_apply {U X : Scheme.{u}} (j : U ⟶ X)
    [IsOpenImmersion j] (u : U) :
    (vanishingIdeal ⟨closure {j u}, isClosed_closure⟩).comap j =
      vanishingIdeal ⟨closure {u}, isClosed_closure⟩ := by
  rw [comap_vanishingIdeal_of_isOpenImmersion]
  congr 1
  ext v
  simp only [TopologicalSpace.Closeds.coe_mk, Set.mem_preimage]
  rw [j.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image, Set.image_singleton]
  rfl

/-- An open subscheme of a Noetherian scheme is Noetherian. -/
theorem isNoetherian_of_isOpenImmersion {U X : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    [IsNoetherian X] : IsNoetherian U := by
  have : IsLocallyNoetherian U := isLocallyNoetherian_of_isOpenImmersion j
  have : NoetherianSpace U := j.isOpenEmbedding.isInducing.noetherianSpace
  exact ⟨⟩

/-- The stalks of the source of an open immersion into a locally factorial scheme are unique
factorization domains. -/
theorem uniqueFactorizationMonoid_stalk_of_isOpenImmersion {U X : Scheme.{u}} (j : U ⟶ X)
    [IsOpenImmersion j] [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] (u : U) :
    UniqueFactorizationMonoid (U.presheaf.stalk u) :=
  (asIso (j.stalkMap u)).commRingCatIsoToRingEquiv.toMulEquiv.uniqueFactorizationMonoid
    inferInstance

/-- Pushforward of a codimension-one point along an open immersion. -/
def CodimensionOnePoint.mapOfIsOpenImmersion {U X : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    (y : CodimensionOnePoint U) : CodimensionOnePoint X :=
  ⟨j y, (coheight_eq_of_isOpenImmersion j).trans y.2⟩

/-- Coercing `CodimensionOnePoint.mapOfIsOpenImmersion j y` to `X` gives `j y`. -/
@[simp]
lemma CodimensionOnePoint.coe_mapOfIsOpenImmersion {U X : Scheme.{u}} (j : U ⟶ X)
    [IsOpenImmersion j] (y : CodimensionOnePoint U) :
    (CodimensionOnePoint.mapOfIsOpenImmersion j y : X) = j y :=
  (rfl)

/-- `CodimensionOnePoint.mapOfIsOpenImmersion j` is injective for an open immersion `j`. -/
lemma CodimensionOnePoint.mapOfIsOpenImmersion_injective {U X : Scheme.{u}} (j : U ⟶ X)
    [IsOpenImmersion j] : Function.Injective (CodimensionOnePoint.mapOfIsOpenImmersion j) :=
  fun _ _ h ↦ Subtype.ext (j.isOpenEmbedding.injective (congrArg Subtype.val h))

namespace LineBundleClass

/-- The line-bundle class `[𝒪_X(closure {η})] = [ℐ_{closure {η}}]⁻¹` of a codimension-one point `η`
on a locally Noetherian scheme with factorial local rings. -/
def primeDivisorClass {X : Scheme.{u}} [IsLocallyNoetherian X]
    [∀ x : X, IsDomain (X.presheaf.stalk x)]
    [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)]
    (η : CodimensionOnePoint X) : LineBundleClass X :=
  (mk (isEffectiveCartier_vanishingIdeal_closure_singleton η.2).toInvertibleSheaf)⁻¹

/-- `primeDivisorClass η` unfolds to `[ℐ_{closure {η}}]⁻¹`. -/
lemma primeDivisorClass_def {X : Scheme.{u}} [IsLocallyNoetherian X]
    [∀ x : X, IsDomain (X.presheaf.stalk x)]
    [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)]
    (η : CodimensionOnePoint X) :
    primeDivisorClass η =
      (mk (isEffectiveCartier_vanishingIdeal_closure_singleton η.2).toInvertibleSheaf)⁻¹ :=
  (rfl)

section PullbackPrime

variable {U X : Scheme.{u}} [IsLocallyNoetherian X] [∀ x : X, IsDomain (X.presheaf.stalk x)]
  [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] (j : U ⟶ X) [IsOpenImmersion j]

/-- Pulling back `[𝒪_X(closure {η})]` along an open immersion `j : U ⟶ X` gives `1` when
`η ∉ Set.range j`. -/
theorem pullback_primeDivisorClass_eq_one_of_notMem_range {η : CodimensionOnePoint X}
    (hη : (η : X) ∉ Set.range j) :
    pullback j (primeDivisorClass η) = 1 := by
  have hI := isEffectiveCartier_vanishingIdeal_closure_singleton η.2
  rw [primeDivisorClass_def, pullback_inv, hI.pullback_mk_toInvertibleSheaf (hI.comap j),
    mk_toInvertibleSheaf_congr _ (Scheme.IdealSheafData.isEffectiveCartier_top U)
      (comap_vanishingIdeal_closure_singleton_eq_top_of_notMem_range j hη),
    mk_toInvertibleSheaf_top, inv_one]

/-- Pulling back `[𝒪_X(closure {j y})]` along an open immersion `j : U ⟶ X` gives
`[𝒪_U(closure {y})]`. -/
@[simp]
theorem pullback_primeDivisorClass_mapOfIsOpenImmersion
    [∀ u : U, IsDomain (U.presheaf.stalk u)] (y : CodimensionOnePoint U) :
    letI := isLocallyNoetherian_of_isOpenImmersion j
    letI := uniqueFactorizationMonoid_stalk_of_isOpenImmersion j
    pullback j (primeDivisorClass (CodimensionOnePoint.mapOfIsOpenImmersion j y)) =
      primeDivisorClass y := by
  have := isLocallyNoetherian_of_isOpenImmersion j
  have := uniqueFactorizationMonoid_stalk_of_isOpenImmersion j
  have hI := isEffectiveCartier_vanishingIdeal_closure_singleton
    (CodimensionOnePoint.mapOfIsOpenImmersion j y).2
  rw [primeDivisorClass_def, primeDivisorClass_def, pullback_inv,
    hI.pullback_mk_toInvertibleSheaf (hI.comap j)]
  congr 1
  exact mk_toInvertibleSheaf_congr (hI.comap j)
    (isEffectiveCartier_vanishingIdeal_closure_singleton y.2)
    (comap_vanishingIdeal_closure_singleton_apply j y)

end PullbackPrime

/-- Along a dominant open immersion `j : U ⟶ X` between integral schemes, pullback of rational
functions `j.functionFieldMap` is an isomorphism. -/
private lemma isIso_functionFieldMap_of_isOpenImmersion {U X : Scheme.{u}} [IsIntegral U]
    [IsIntegral X] (j : U ⟶ X) [IsOpenImmersion j] [IsDominant j] :
    IsIso j.functionFieldMap := by
  let φ : X.functionField ⟶ U.functionField :=
    X.presheaf.stalkSpecializes (specializes_of_eq j.genericPoint_eq_of_isDominant) ≫
      j.stalkMap (genericPoint U)
  have hφ : φ = j.functionFieldMap := by
    rw [j.eq_functionFieldMap_iff, Spec.map_comp_assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk]
  have : IsIso (X.presheaf.stalkSpecializes
      (specializes_of_eq j.genericPoint_eq_of_isDominant)) :=
    (X.presheaf.stalkCongr (Inseparable.of_eq j.genericPoint_eq_of_isDominant.symm)).isIso_hom
  rw [← hφ]
  infer_instance

section Excision

variable {U X : Scheme.{u}} [IsIntegral X] [IsNoetherian X]
  [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] (j : U ⟶ X)
  [IsOpenImmersion j] [Nonempty U]

/-- Evaluating `weilToLineBundleClassHom` on a Weil divisor gives the product of powers of the
prime-divisor classes `[𝒪_X(closure {η})]`. -/
theorem toMul_weilToLineBundleClassHom (D : SchemeWeilDivisor X) :
    (Scheme.CartierDivisor.weilToLineBundleClassHom X D).toMul =
      ∏ η ∈ D.support, primeDivisorClass η ^ D η := by
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D₁ D₂ ih₁ ih₂ =>
    classical
    have h₁ : ∏ η ∈ D₁.support, primeDivisorClass η ^ D₁ η =
        ∏ η ∈ D₁.support ∪ D₂.support, primeDivisorClass η ^ D₁ η :=
      Finset.prod_subset Finset.subset_union_left fun η _ hη ↦ by
        rw [Finsupp.notMem_support_iff.mp hη, zpow_zero]
    have h₂ : ∏ η ∈ D₂.support, primeDivisorClass η ^ D₂ η =
        ∏ η ∈ D₁.support ∪ D₂.support, primeDivisorClass η ^ D₂ η :=
      Finset.prod_subset Finset.subset_union_right fun η _ hη ↦ by
        rw [Finsupp.notMem_support_iff.mp hη, zpow_zero]
    have h₁₂ : ∏ η ∈ (D₁ + D₂).support, primeDivisorClass η ^ (D₁ + D₂) η =
        ∏ η ∈ D₁.support ∪ D₂.support, primeDivisorClass η ^ (D₁ + D₂) η :=
      Finset.prod_subset Finsupp.support_add fun η _ hη ↦ by
        rw [Finsupp.notMem_support_iff.mp hη, zpow_zero]
    rw [map_add, toMul_add, ih₁, ih₂, h₁, h₂, h₁₂, ← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun η _ ↦ (zpow_add _ _ _).symm
  | single η n =>
    rcases eq_or_ne n 0 with rfl | hn
    · simp
    · rw [Scheme.CartierDivisor.weilToLineBundleClassHom_single, toMul_zsmul, toMul_ofMul,
        Finsupp.support_single η hn, Finset.prod_singleton, Finsupp.single_eq_same,
        primeDivisorClass_def]

/-- Restriction of Weil divisors along a dominant open immersion `j : U ⟶ X`, pulling back
coefficients along `CodimensionOnePoint.mapOfIsOpenImmersion j`. -/
private def weilComap : SchemeWeilDivisor X →+ SchemeWeilDivisor U where
  toFun D := D.comapDomain (CodimensionOnePoint.mapOfIsOpenImmersion j)
    (CodimensionOnePoint.mapOfIsOpenImmersion_injective j).injOn
  map_zero' := Finsupp.comapDomain_zero _
  map_add' D₁ D₂ := Finsupp.comapDomain_add_of_injective
    (CodimensionOnePoint.mapOfIsOpenImmersion_injective j) D₁ D₂

/-- `LineBundleClass.pullback j` intertwines `weilToLineBundleClassHom` with `weilComap j`. -/
private lemma pullback_weilToLineBundleClassHom (D : SchemeWeilDivisor X) :
    letI : IsIntegral U := isIntegral_of_isOpenImmersion j
    letI : IsNoetherian U := isNoetherian_of_isOpenImmersion j
    letI := uniqueFactorizationMonoid_stalk_of_isOpenImmersion j
    Additive.ofMul (pullback j (Scheme.CartierDivisor.weilToLineBundleClassHom X D).toMul) =
      Scheme.CartierDivisor.weilToLineBundleClassHom U (weilComap j D) := by
  have : IsIntegral U := isIntegral_of_isOpenImmersion j
  have : IsNoetherian U := isNoetherian_of_isOpenImmersion j
  have := uniqueFactorizationMonoid_stalk_of_isOpenImmersion j
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D₁ D₂ ih₁ ih₂ =>
    rw [map_add, toMul_add, pullback_mul, ofMul_mul, ih₁, ih₂, map_add, map_add]
  | single η n =>
    rw [Scheme.CartierDivisor.weilToLineBundleClassHom_single, ← primeDivisorClass_def,
      toMul_zsmul, toMul_ofMul, pullback_zpow, ofMul_zpow]
    by_cases hη : (η : X) ∈ Set.range j
    · obtain ⟨u, hu⟩ := hη
      let y : CodimensionOnePoint U := ⟨u, (coheight_eq_of_isOpenImmersion j).symm.trans
        (hu.symm ▸ η.2)⟩
      have hy : CodimensionOnePoint.mapOfIsOpenImmersion j y = η := Subtype.ext hu
      have hcs : weilComap j (Finsupp.single (CodimensionOnePoint.mapOfIsOpenImmersion j y) n) =
          Finsupp.single y n := Finsupp.comapDomain_single _ _ _ _
      rw [← hy, hcs, pullback_primeDivisorClass_mapOfIsOpenImmersion,
        Scheme.CartierDivisor.weilToLineBundleClassHom_single, ← primeDivisorClass_def]
    · have hcomap : weilComap j (Finsupp.single η n) = 0 := by
        ext y
        have hne : η ≠ CodimensionOnePoint.mapOfIsOpenImmersion j y := fun h ↦
          hη ⟨y.1, h ▸ rfl⟩
        rw [WeilDivisor.coeff, WeilDivisor.coeff, weilComap, AddMonoidHom.coe_mk, ZeroHom.coe_mk,
          Finsupp.comapDomain_apply, Finsupp.coe_zero, Pi.zero_apply,
          Finsupp.single_eq_of_ne hne.symm]
      rw [hcomap, map_zero, pullback_primeDivisorClass_eq_one_of_notMem_range j hη, ofMul_one,
        smul_zero]

/-- **Open-immersion surjectivity on Picard groups (Hartshorne, Proposition II.6.5(c)).** Let `X`
be a Noetherian integral scheme with factorial local rings and `j : U ⟶ X` a nonempty open
immersion. Every line-bundle class on `U` is the pullback of a line-bundle class on `X`. -/
theorem pullback_surjective_of_isOpenImmersion : Function.Surjective (pullback j) := by
  have : IsIntegral U := isIntegral_of_isOpenImmersion j
  have : IsNoetherian U := isNoetherian_of_isOpenImmersion j
  have := uniqueFactorizationMonoid_stalk_of_isOpenImmersion j
  intro b
  obtain ⟨D, hD⟩ := Scheme.CartierDivisor.weilToLineBundleClassHom_surjective (X := U)
    (Additive.ofMul b)
  let E : SchemeWeilDivisor X := D.mapDomain (CodimensionOnePoint.mapOfIsOpenImmersion j)
  have hcomap : weilComap j E = D :=
    Finsupp.comapDomain_mapDomain (CodimensionOnePoint.mapOfIsOpenImmersion j)
      (CodimensionOnePoint.mapOfIsOpenImmersion_injective j) D
  refine ⟨(Scheme.CartierDivisor.weilToLineBundleClassHom X E).toMul, ?_⟩
  apply Additive.ofMul.injective
  rw [pullback_weilToLineBundleClassHom j E, hcomap, hD]

/-- **Open-immersion kernel on Picard groups (Hartshorne, Proposition II.6.5(c); Stacks Tag 01WS).**
Let `X` be a Noetherian integral scheme with factorial local rings and `j : U ⟶ X` a nonempty open
immersion. A line-bundle class on `X` pulls back to `1` on `U` if and only if it lies in the
subgroup generated by the prime-divisor classes `[𝒪_X(closure {η})]` of codimension-one points
`η ∉ Set.range j`. -/
theorem pullback_eq_one_iff_mem_closure_of_isOpenImmersion {a : LineBundleClass X} :
    pullback j a = 1 ↔ a ∈ Subgroup.closure
      {primeDivisorClass η | (η : CodimensionOnePoint X) (_ : (η : X) ∉ Set.range j)} := by
  let S : Set (LineBundleClass X) :=
    {primeDivisorClass η | (η : CodimensionOnePoint X) (_ : (η : X) ∉ Set.range j)}
  change pullback j a = 1 ↔ a ∈ Subgroup.closure S
  refine ⟨fun ha ↦ ?_, fun ha ↦ ?_⟩
  · have : IsIntegral U := isIntegral_of_isOpenImmersion j
    have : IsNoetherian U := isNoetherian_of_isOpenImmersion j
    have := uniqueFactorizationMonoid_stalk_of_isOpenImmersion j
    have : IsDominant j := isDominant_iff_genericPoint_eq.mpr (genericPoint_eq_of_isOpenImmersion j)
    have : IsIso j.functionFieldMap := isIso_functionFieldMap_of_isOpenImmersion j
    obtain ⟨D, hD⟩ := Scheme.CartierDivisor.weilToLineBundleClassHom_surjective (X := X)
      (Additive.ofMul a)
    have hker : weilComap j D ∈ (WeilDivisor.OrderSystem.ofScheme U).principalSubgroup := by
      rw [← Scheme.CartierDivisor.ker_weilToLineBundleClassHom, AddMonoidHom.mem_ker,
        ← pullback_weilToLineBundleClassHom j D, hD, toMul_ofMul, ha, ofMul_one]
    obtain ⟨g, hg⟩ := (WeilDivisor.OrderSystem.ofScheme U).mem_principalSubgroup.mp hker
    let f : X.functionFieldˣ :=
      Units.map (asIso j.functionFieldMap).inv.hom.toMonoidHom g.toMul
    have hfg : (g.toMul : U.functionField) = j.functionFieldMap f := by
      simp [f]
    -- Subtracting `div_X(f)` leaves the class `a` unchanged and kills all coefficients inside `U`.
    let E : SchemeWeilDivisor X :=
      D - (WeilDivisor.OrderSystem.ofScheme X).principalDivisor (Additive.ofMul f)
    have hEa : (Scheme.CartierDivisor.weilToLineBundleClassHom X E).toMul = a := by
      have hprin : (WeilDivisor.OrderSystem.ofScheme X).principalDivisor (Additive.ofMul f) ∈
          (Scheme.CartierDivisor.weilToLineBundleClassHom X).ker := by
        rw [Scheme.CartierDivisor.ker_weilToLineBundleClassHom]
        exact (WeilDivisor.OrderSystem.ofScheme X).principalDivisor_mem_principalSubgroup
          (Additive.ofMul f)
      rw [map_sub, AddMonoidHom.mem_ker.mp hprin, sub_zero, hD, toMul_ofMul]
    have hEout : ∀ η ∈ E.support, (η : X) ∉ Set.range j := by
      rintro η hη ⟨u, hu⟩
      let y : CodimensionOnePoint U := ⟨u, (coheight_eq_of_isOpenImmersion j).symm.trans
        (hu.symm ▸ η.2)⟩
      have hy : CodimensionOnePoint.mapOfIsOpenImmersion j y = η := Subtype.ext hu
      apply Finsupp.mem_support_iff.mp hη
      have hcy : weilComap j E y = E η := by
        simp [weilComap, ← hy]
      rw [← hcy, map_sub, ← hg]
      change WeilDivisor.coeff ((WeilDivisor.OrderSystem.ofScheme U).principalDivisor g) y -
        WeilDivisor.coeff
          ((WeilDivisor.OrderSystem.ofScheme X).principalDivisor (Additive.ofMul f))
          (CodimensionOnePoint.mapOfIsOpenImmersion j y) = 0
      rw [WeilDivisor.OrderSystem.coeff_principalDivisor,
        WeilDivisor.OrderSystem.coeff_principalDivisor,
        WeilDivisor.OrderSystem.ofScheme_ord, WeilDivisor.OrderSystem.ofScheme_ord,
        SchemeWeilDivisor.orderAt_apply, SchemeWeilDivisor.orderAt_apply, toMul_ofMul, hfg,
        Scheme.ord_functionFieldMap, CodimensionOnePoint.coe_mapOfIsOpenImmersion, sub_self]
    rw [← hEa, toMul_weilToLineBundleClassHom]
    exact Subgroup.prod_mem _ fun η hη ↦ Subgroup.zpow_mem _
      (Subgroup.subset_closure (show primeDivisorClass η ∈ S from ⟨η, hEout η hη, rfl⟩)) _
  · refine Subgroup.closure_induction (p := fun b _ ↦ pullback j b = 1) ?_ (pullback_one j)
      (fun _ _ _ _ h₁ h₂ ↦ by rw [pullback_mul, h₁, h₂, mul_one])
      (fun _ _ h₁ ↦ by rw [pullback_inv, h₁, inv_one]) ha
    rintro _ ⟨η, hη, rfl⟩
    exact pullback_primeDivisorClass_eq_one_of_notMem_range j hη

/-- **Finite-complement form of open-immersion Picard excision.** If `s` is the finite set of
codimension-one points of `X` outside `Set.range j`, then `pullback j a = 1` if and only if `a` is
a product `∏ i : s, primeDivisorClass i.1 ^ (v i)` for some integer vector `v : s → ℤ`. -/
theorem pullback_eq_one_iff_exists_prod_of_isOpenImmersion
    {s : Finset (CodimensionOnePoint X)}
    (hs : ∀ η : CodimensionOnePoint X, η ∈ s ↔ (η : X) ∉ Set.range j) {a : LineBundleClass X} :
    pullback j a = 1 ↔ ∃ v : s → ℤ, a = ∏ i : s, primeDivisorClass i.1 ^ v i := by
  refine ⟨fun ha ↦ ?_, ?_⟩
  · rw [pullback_eq_one_iff_mem_closure_of_isOpenImmersion j] at ha
    classical
    refine Subgroup.closure_induction
      (p := fun b _ ↦ ∃ v : s → ℤ, b = ∏ i : s, primeDivisorClass i.1 ^ v i)
      ?_ ⟨0, by simp⟩ ?_ ?_ ha
    · rintro _ ⟨η, hη, rfl⟩
      let i₀ : s := ⟨η, (hs η).mpr hη⟩
      refine ⟨Pi.single i₀ 1, ?_⟩
      rw [Finset.prod_eq_single i₀]
      · simp [i₀]
      · intro i _ hi
        rw [Pi.single_eq_of_ne hi, zpow_zero]
      · intro hi₀
        exact absurd (Finset.mem_univ i₀) hi₀
    · rintro b₁ b₂ _ _ ⟨v₁, rfl⟩ ⟨v₂, rfl⟩
      refine ⟨v₁ + v₂, ?_⟩
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun i _ ↦ (zpow_add _ _ _).symm
    · rintro b _ ⟨v, rfl⟩
      refine ⟨-v, ?_⟩
      rw [← Finset.prod_inv_distrib]
      exact Finset.prod_congr rfl fun i _ ↦ (zpow_neg _ _).symm
  · rintro ⟨v, rfl⟩
    rw [← pullbackHom_apply, map_prod]
    exact Finset.prod_eq_one fun i _ ↦ by
      rw [pullbackHom_apply, pullback_zpow,
        pullback_primeDivisorClass_eq_one_of_notMem_range j ((hs i.1).mp i.2), one_zpow]

end Excision

section RegularSurface

open _root_.AlgebraicGeometry.Scheme.IdealSheafData
  (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular)

variable {U X : Scheme.{u}} [IsIntegral X] [IsNoetherian X] [IsRegular X]
  (j : U ⟶ X) [IsOpenImmersion j] [Nonempty U]

/-- **Open-immersion Picard surjectivity on regular schemes of dimension at most two.** -/
theorem pullback_surjective_of_isOpenImmersion_of_isRegular
    (hX : ∀ x : X, coheight x ≤ 2) : Function.Surjective (pullback j) :=
  have := fun x ↦ IsRegular.uniqueFactorizationMonoid_stalk x (hX x)
  pullback_surjective_of_isOpenImmersion j

/-- **Open-immersion Picard kernel on regular schemes of dimension at most two.** -/
theorem pullback_eq_one_iff_exists_prod_of_isOpenImmersion_of_isRegular
    (hX : ∀ x : X, coheight x ≤ 2) {s : Finset (CodimensionOnePoint X)}
    (hs : ∀ η : CodimensionOnePoint X, η ∈ s ↔ (η : X) ∉ Set.range j) {a : LineBundleClass X} :
    pullback j a = 1 ↔ ∃ v : s → ℤ, a = ∏ i : s,
      (mk (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular hX
        i.1.2).toInvertibleSheaf)⁻¹ ^ v i :=
  have := fun x ↦ IsRegular.uniqueFactorizationMonoid_stalk x (hX x)
  pullback_eq_one_iff_exists_prod_of_isOpenImmersion j hs

end RegularSurface

