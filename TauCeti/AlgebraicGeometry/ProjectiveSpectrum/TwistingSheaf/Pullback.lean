module

public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.Functor
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.LocalTriviality
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.Quasicoherent
public import TauCeti.AlgebraicGeometry.Modules.Pullback.BaseChange
public import TauCeti.AlgebraicGeometry.Modules.AffineRestriction

/-!
# Pullback of the twisting sheaves along `Proj.map`

Let `f : 𝒜 →+*ᵍ ℬ` be a graded ring homomorphism with `ℬ₊ ≤ 𝒜₊.map f`, so that Mathlib's
`AlgebraicGeometry.Proj.map f hf : Proj ℬ ⟶ Proj 𝒜` is defined. The morphism of twisting sheaves
`𝒪_{Proj 𝒜}(n) ⟶ (Proj.map f hf)_* 𝒪_{Proj ℬ}(n)` (`AlgebraicGeometry.Proj.twistingSheafMap`)
corresponds under the pullback–pushforward adjunction to a comparison morphism

`(Proj.map f hf)^* 𝒪_{Proj 𝒜}(n) ⟶ 𝒪_{Proj ℬ}(n)`

(`AlgebraicGeometry.Proj.pullbackTwistingSheafMap`), which sends the pullback of a section `s` to
its image `f(s)` under the maps of localizations induced by `f`. This file proves that it is an
isomorphism whenever the standard opens `D₊(a)` of finitely or infinitely many elements `a` of
degree one cover `Proj 𝒜`, for instance when `A` is generated by `A₁` over `A₀`
(`AlgebraicGeometry.Proj.isIso_pullbackTwistingSheafMap`). In particular, the twisting sheaves of
projective space `Proj (Sym M)` pull back to the twisting sheaves along every graded homomorphism
out of `Sym M`; when `ℬ = S ⊗[R] Sym M`, this says that the formation of `𝒪(n)` on projective space
commutes with every change of base ring `R → S`, as needed to compare the cohomology of `𝒪(n)` on
`ℙⁿ_R` with that on its fibres.

The comparison is checked on the affine cover of `Proj ℬ` by the preimages `D₊(f a)` of the
degree-one charts. On `D₊(a)` the twisting sheaf `𝒪(n)` is free on the section `aⁿ`
(`AlgebraicGeometry.Proj.twistingSheaf.chartSectionsLinearEquiv`), so the sections of its pullback
over the affine open `D₊(f a)`, which are the base change `Γ(D₊(f a), 𝒪) ⊗ Γ(D₊(a), 𝒪(n))`
(`AlgebraicGeometry.Scheme.Hom.pullbackSectionsEquiv`), are generated by the pullback of `aⁿ`
(`AlgebraicGeometry.Scheme.Hom.span_singleton_pullbackSections_eq_top`).
The comparison sends it to `(f a)ⁿ`, which freely generates `Γ(D₊(f a), 𝒪(n))`.

## Main declarations

* `AlgebraicGeometry.Proj.pullbackTwistingSheafMap`: the comparison
  `(Proj.map f hf)^* 𝒪(n) ⟶ 𝒪(n)`, adjoint to `twistingSheafMap`
  (`AlgebraicGeometry.Proj.unit_app_comp_pushforward_map_pullbackTwistingSheafMap`), and
  characterized on sections by
  `AlgebraicGeometry.Proj.pullbackTwistingSheafMap_app_pullbackSections`.
* `AlgebraicGeometry.Proj.bijective_pullbackTwistingSheafMap_app_basicOpen`: it is bijective on
  the sections over the preimage of a degree-one chart `D₊(a)`.
* `AlgebraicGeometry.Proj.isIso_pullbackTwistingSheafMap`: it is an isomorphism when the
  degree-one standard opens cover `Proj 𝒜`.
* `AlgebraicGeometry.Proj.pullbackTwistingSheafIso`: the resulting isomorphism
  `(Proj.map f hf)^* 𝒪(n) ≅ 𝒪(n)`.

## References

* R. Hartshorne, *Algebraic Geometry*, Proposition II.5.12(c).
* [The Stacks Project, Lemma 27.11.1](https://stacks.math.columbia.edu/tag/01MX).
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry Opposite TopologicalSpace HomogeneousIdeal
open scoped TensorProduct ChangeOfRings

namespace AlgebraicGeometry.Proj

universe u

variable {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
  (f : 𝒜 →+*ᵍ ℬ) (hf : ℬ₊ ≤ 𝒜₊.map f)

open Scheme.Modules

/-- The pullback of the standard generator `aⁿ` of `𝒪_{Proj 𝒜}(n)` on `D₊(a)` is the standard
generator `(f a)ⁿ` of `𝒪_{Proj ℬ}(n)` on the preimage. -/
@[simp]
theorem twistingSheaf.comap_chartGenerator (n : ℤ) {a : A} (ha : a ∈ 𝒜 1)
    {U : (Proj 𝒜).Opens} (hU : U ≤ basicOpen 𝒜 a) {V : (Proj ℬ).Opens}
    (hUV : V.1 ⊆ ProjectiveSpectrum.comap f hf ⁻¹' U.1) :
    twistingSheaf.comap f hf hUV (twistingSheaf.chartGenerator n a ha U hU) =
      twistingSheaf.chartGenerator n (f a) (Graded.map_mem f ha) V
        (fun _ hy ↦ hU (hUV hy)) := by
  refine twistingSheaf.ext fun (y : V) ↦ ?_
  rw [twistingSheaf.comap_apply, twistingSheaf.chartGenerator_apply]
  refine (ProjectiveSpectrum.TwistingSheaf.localizationsMap_mk f hf y.1 _ _).trans
    (Eq.trans ?_ (twistingSheaf.chartGenerator_apply n (f a) _ V _ y).symm)
  congr 1
  · exact map_pow f a _
  · exact Subtype.ext (map_pow f a _)

/-- **The comparison of twisting sheaves along `Proj.map`**: the morphism
`(Proj.map f hf)^* 𝒪_{Proj 𝒜}(n) ⟶ 𝒪_{Proj ℬ}(n)` adjoint to
`AlgebraicGeometry.Proj.twistingSheafMap`. -/
def pullbackTwistingSheafMap (n : ℤ) :
    (pullback (map f hf)).obj (twistingSheaf 𝒜 n) ⟶ twistingSheaf ℬ n :=
  ((pullbackPushforwardAdjunction (map f hf)).homEquiv _ _).symm (twistingSheafMap f hf n)

/-- The comparison `pullbackTwistingSheafMap` is adjoint to `twistingSheafMap`: composing the unit
of the pullback–pushforward adjunction with its pushforward recovers `twistingSheafMap`. -/
@[reassoc]
theorem unit_app_comp_pushforward_map_pullbackTwistingSheafMap (n : ℤ) :
    (pullbackPushforwardAdjunction (map f hf)).unit.app _ ≫
      (pushforward (map f hf)).map (pullbackTwistingSheafMap f hf n) = twistingSheafMap f hf n :=
  ((pullbackPushforwardAdjunction (map f hf)).homEquiv_unit _ _ _).symm.trans
    (Equiv.apply_symm_apply _ _)

/-- The comparison sends the pullback of a section `s` of `𝒪_{Proj 𝒜}(n)` over `U` to its image
`f(s)` over the preimage of `U`. -/
@[simp]
theorem pullbackTwistingSheafMap_app_pullbackSections (n : ℤ) (U : (Proj 𝒜).Opens)
    (s : Γ(twistingSheaf 𝒜 n, U)) :
    (pullbackTwistingSheafMap f hf n).app (map f hf ⁻¹ᵁ U)
        ((map f hf).pullbackSections _ U s) =
      twistingSheaf.comap f hf (U := U) Set.Subset.rfl s := by
  have hs := congr(Scheme.Modules.Hom.app
    $(unit_app_comp_pushforward_map_pullbackTwistingSheafMap f hf n) U s)
  rw [Scheme.Modules.Hom.comp_app, pushforward_map_app, twistingSheafMap_app] at hs
  rw [Scheme.Hom.pullbackSections_apply]
  exact hs

/-- Over an affine open `U ⊆ D₊(a)`, for `a` of degree one, whose preimage is affine, the
comparison of twisting sheaves is bijective on sections. -/
private theorem bijective_pullbackTwistingSheafMap_app {a : A} (ha : a ∈ 𝒜 1)
    {U : (Proj 𝒜).Opens} (hUa : U ≤ basicOpen 𝒜 a) (hU : IsAffineOpen U)
    (hV : IsAffineOpen (map f hf ⁻¹ᵁ U)) (n : ℤ) :
    Function.Bijective ((pullbackTwistingSheafMap f hf n).app (map f hf ⁻¹ᵁ U)) := by
  let cA := twistingSheaf.chartSectionsLinearEquiv n a ha U hUa
  let cB := twistingSheaf.chartSectionsLinearEquiv n (f a) (Graded.map_mem f ha)
    (map f hf ⁻¹ᵁ U) (fun _ hy ↦ hUa hy)
  -- The generator and its pullback are kept opaque, so that the rewrites below do not unfold
  -- their definitions.
  obtain ⟨gA, hgA⟩ : ∃ g, twistingSheaf.chartGenerator n a ha U hUa = g := ⟨_, rfl⟩
  obtain ⟨p, hpA⟩ : ∃ p, (map f hf).pullbackSections (twistingSheaf 𝒜 n) U gA = p := ⟨_, rfl⟩
  -- The pulled-back sections over `f⁻¹ U` are generated by the pullback `p` of `aⁿ`.
  have hp (x) : ∃ b : Γ(Proj ℬ, map f hf ⁻¹ᵁ U), x = b • p := by
    have hgen : Submodule.span Γ(Proj 𝒜, U) {gA} = ⊤ :=
      eq_top_iff.mpr fun m _ ↦ Submodule.mem_span_singleton.mpr ⟨cA.symm m, by
        rw [← hgA, ← twistingSheaf.chartSectionsLinearEquiv_apply, LinearEquiv.apply_symm_apply]⟩
    have hspan := (map f hf).span_singleton_pullbackSections_eq_top _ hU hV hgen
    rw [hpA] at hspan
    obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp (hspan ▸ Submodule.mem_top (x := x))
    exact ⟨b, hb.symm⟩
  -- On `b • p` the comparison is the chart trivialization `b ↦ b • (f a)ⁿ` of `𝒪_{Proj ℬ}(n)`.
  have hF (b : Γ(Proj ℬ, map f hf ⁻¹ᵁ U)) :
      (pullbackTwistingSheafMap f hf n).app (map f hf ⁻¹ᵁ U) (b • p) = cB b := by
    rw [Scheme.Modules.Hom.app_smul, ← hpA, ← hgA, pullbackTwistingSheafMap_app_pullbackSections]
    exact (congrArg (b • ·) (twistingSheaf.comap_chartGenerator f hf n ha hUa _)).trans
      (twistingSheaf.chartSectionsLinearEquiv_apply ..).symm
  refine ⟨fun x x' h ↦ ?_, fun t ↦ ?_⟩
  · obtain ⟨b, rfl⟩ := hp x
    obtain ⟨b', rfl⟩ := hp x'
    rw [hF, hF] at h
    rw [cB.injective h]
  · obtain ⟨b, rfl⟩ := cB.surjective t
    exact ⟨b • p, hF b⟩

/-- Over the preimage of a degree-one chart `D₊(a)`, the comparison of twisting sheaves is
bijective on sections. -/
theorem bijective_pullbackTwistingSheafMap_app_basicOpen {a : A} (ha : a ∈ 𝒜 1) (n : ℤ) :
    Function.Bijective
      ((pullbackTwistingSheafMap f hf n).app (map f hf ⁻¹ᵁ basicOpen 𝒜 a)) :=
  bijective_pullbackTwistingSheafMap_app f hf ha le_rfl (isAffineOpen_basicOpen 𝒜 a ha one_pos)
    (isAffineOpen_basicOpen ℬ (f a) (Graded.map_mem f ha) one_pos) n

/-- **Twisting sheaves pull back to twisting sheaves.** If the standard opens of a family of
degree-one elements cover `Proj 𝒜`, then the comparison
`(Proj.map f hf)^* 𝒪_{Proj 𝒜}(n) ⟶ 𝒪_{Proj ℬ}(n)` is an isomorphism for every `n : ℤ`. -/
theorem isIso_pullbackTwistingSheafMap {ι : Type*} (a : ι → A) (ha : ∀ i, a i ∈ 𝒜 1)
    (hcover : ⨆ i, basicOpen 𝒜 (a i) = ⊤) (n : ℤ) :
    IsIso (pullbackTwistingSheafMap f hf n) :=
  (pullbackTwistingSheafMap f hf n).isIso_of_bijective_app
    (U := fun i ↦ map f hf ⁻¹ᵁ basicOpen 𝒜 (a i))
    (fun i ↦ isAffineOpen_basicOpen ℬ (f (a i)) (Graded.map_mem f (ha i)) one_pos)
    (by rw [← Scheme.Hom.preimage_iSup, hcover, Scheme.Hom.preimage_top])
    fun i ↦ bijective_pullbackTwistingSheafMap_app_basicOpen f hf (ha i) n

/-- The isomorphism `(Proj.map f hf)^* 𝒪_{Proj 𝒜}(n) ≅ 𝒪_{Proj ℬ}(n)` when the standard opens of
a family of degree-one elements cover `Proj 𝒜`. -/
def pullbackTwistingSheafIso {ι : Type*} (a : ι → A) (ha : ∀ i, a i ∈ 𝒜 1)
    (hcover : ⨆ i, basicOpen 𝒜 (a i) = ⊤) (n : ℤ) :
    (pullback (map f hf)).obj (twistingSheaf 𝒜 n) ≅ twistingSheaf ℬ n :=
  have := isIso_pullbackTwistingSheafMap f hf a ha hcover n
  asIso (pullbackTwistingSheafMap f hf n)

/-- The isomorphism `pullbackTwistingSheafIso` is the comparison `pullbackTwistingSheafMap`. -/
@[simp]
theorem pullbackTwistingSheafIso_hom {ι : Type*} (a : ι → A) (ha : ∀ i, a i ∈ 𝒜 1)
    (hcover : ⨆ i, basicOpen 𝒜 (a i) = ⊤) (n : ℤ) :
    (pullbackTwistingSheafIso f hf a ha hcover n).hom = pullbackTwistingSheafMap f hf n := by
  simp [pullbackTwistingSheafIso]

end AlgebraicGeometry.Proj

namespace TauCeti.SymmetricAlgebra

variable {R M B τ : Type u} [CommRing R] [AddCommMonoid M] [Module R M]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B] {ℬ : ℕ → τ} [GradedRing ℬ]

/-- On the projective spectrum of a symmetric algebra, every twisting sheaf pulls back to the
twisting sheaf along every graded homomorphism out of the symmetric algebra. -/
instance isIso_pullbackTwistingSheafMap (f : homogeneousSubmodule R M →+*ᵍ ℬ)
    (hf : ℬ₊ ≤ (homogeneousSubmodule R M)₊.map f) (n : ℤ) :
    IsIso (AlgebraicGeometry.Proj.pullbackTwistingSheafMap f hf n) :=
  AlgebraicGeometry.Proj.isIso_pullbackTwistingSheafMap f hf (_root_.SymmetricAlgebra.ι R M)
    (ι_mem_homogeneousSubmodule R M) (iSup_basicOpen_ι_eq_top R M id (by simp)) n

end TauCeti.SymmetricAlgebra
