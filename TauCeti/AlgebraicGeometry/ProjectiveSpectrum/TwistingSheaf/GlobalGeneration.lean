module

public import TauCeti.AlgebraicGeometry.LineBundle.GlobalGeneration.Ample
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.Ample
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.TensorProduct
import TauCeti.Algebra.Category.ModuleCat.Sheaf.GeneratingSections

/-!
# Serre's theorem on twists of quasi-coherent sheaves on `Proj`

Let `A` be a graded ring such that `Proj A` is quasi-compact and covered by the standard opens
`D₊(f)` of degree-one elements `f`, as for projective space `ℙⁿ_R = Proj R[x₀, …, xₙ]`. The
twisting sheaf `𝒪(1)` is ample (`AlgebraicGeometry.Proj.isAmple_twistingSheaf`) and its
line-bundle powers represent `𝒪(n)`
(`AlgebraicGeometry.Proj.lineBundleClass_twistingSheaf_eq_zpow`), so Serre's twisting-generation
theorem for ample line bundles
(`AlgebraicGeometry.Scheme.Modules.exists_generatingSections_tensor_of_isAmple`) shows that every
quasi-coherent `𝒪_{Proj A}`-module `F` of finite type has its twists `F(n) = F ⊗ 𝒪(n)`
generated by finitely many global sections for all large `n`.
Tensoring a surjection `𝒪^{⊕I} → F(n)` with `𝒪(-n)` exhibits `F` as a quotient of the finite
direct sum `𝒪(-n)^{⊕I}` of copies of a twisting sheaf.

This is the first step in the finiteness of the cohomology of coherent sheaves on projective
schemes: it reduces statements about `F` to statements about the twisting sheaves `𝒪(m)`.

## Main results

* `AlgebraicGeometry.Proj.eventually_exists_generatingSections_tensor_twistingSheaf`: for every
  sufficiently large `n`, the twist `F(n)` is generated by finitely many global sections.
* `AlgebraicGeometry.Proj.eventually_exists_epi_free_tensor_twistingSheaf`: for every sufficiently
  large `n`, `F` is a quotient of `𝒪^{⊕I} ⊗ 𝒪(-n)` for some finite `I`.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Theorem II.5.17 and
  Corollary II.5.18.
-/

public section

noncomputable section

open CategoryTheory MonoidalCategory AlgebraicGeometry TopologicalSpace TauCeti

namespace AlgebraicGeometry.Proj

universe u

variable {A : Type u} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {ι : Type*} (f : ι → A) (hf : ∀ i, f i ∈ 𝒜 1)
  (hcover : ⨆ i, basicOpen 𝒜 (f i) = ⊤)

include hf hcover in
/-- Reindex a degree-one cover `f` by its range to obtain `𝒪(1)` as an ample invertible sheaf
together with the line-bundle class power formula for `𝒪(n)`. -/
private lemma isAmple_twistingSheaf_one_of_range [CompactSpace (Proj 𝒜)] :
    ∃ (L : TauCeti.AlgebraicGeometry.InvertibleSheaf (Proj 𝒜)),
      (TauCeti.AlgebraicGeometry.LineBundleClass.mk L).IsAmple ∧
      ∀ n : ℤ, ∃ (h : TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible (Proj 𝒜)
          (twistingSheaf 𝒜 n)),
        TauCeti.AlgebraicGeometry.LineBundleClass.mk ⟨twistingSheaf 𝒜 n, h⟩ =
          TauCeti.AlgebraicGeometry.LineBundleClass.mk L ^ n := by
  have hf' (a : Set.range f) : (a : A) ∈ 𝒜 1 := by
    obtain ⟨_, i, rfl⟩ := a
    exact hf i
  have hcover' : ⨆ a : Set.range f, basicOpen 𝒜 (a : A) = ⊤ :=
    (iSup_range' (basicOpen 𝒜) f).trans hcover
  let L : TauCeti.AlgebraicGeometry.InvertibleSheaf (Proj 𝒜) :=
    ⟨twistingSheaf 𝒜 1, isInvertible_twistingSheaf_of_iSup_eq_top _ hf' hcover' 1⟩
  exact ⟨L, isAmple_twistingSheaf _ hf' hcover' Nat.one_pos, fun n ↦
    ⟨isInvertible_twistingSheaf_of_iSup_eq_top _ hf' hcover' n,
      lineBundleClass_twistingSheaf_eq_zpow _ hf' hcover' n⟩⟩

include hf hcover in
/-- **Serre's theorem on `Proj`.** If `Proj A` is quasi-compact and covered by degree-one standard
opens `D₊(f i)` (for instance on projective space over a ring), then for every quasi-coherent
module `F` of finite type and every sufficiently large `n`, the twist `F(n) = F ⊗ 𝒪(n)` is
generated by finitely many global sections. -/
theorem eventually_exists_generatingSections_tensor_twistingSheaf [CompactSpace (Proj 𝒜)]
    (F : (Proj 𝒜).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∀ᶠ n : ℕ in Filter.atTop,
      ∃ σ : (F ⊗ twistingSheaf 𝒜 n).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨L, hL, hpow⟩ := isAmple_twistingSheaf_one_of_range f hf hcover
  obtain ⟨n₀, hn₀⟩ := F.exists_generatingSections_tensor_of_isAmple L hL
  refine Filter.eventually_atTop.mpr ⟨n₀, fun n hn ↦ ?_⟩
  obtain ⟨hinv, hK⟩ := hpow (n : ℤ)
  rw [zpow_natCast] at hK
  exact hn₀ n hn ⟨twistingSheaf 𝒜 (n : ℤ), hinv⟩ hK

include hf hcover in
/-- **Quasi-coherent sheaves of finite type on `Proj` are quotients of sums of twisting
sheaves.** If `Proj A` is quasi-compact and covered by degree-one standard opens, then for every
quasi-coherent module `F` of finite type and every sufficiently large `n`, `F` receives an
epimorphism from `𝒪^{⊕I} ⊗ 𝒪(-n) ≅ 𝒪(-n)^{⊕I}` for some finite `I`. -/
theorem eventually_exists_epi_free_tensor_twistingSheaf [CompactSpace (Proj 𝒜)]
    (F : (Proj 𝒜).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∀ᶠ n : ℕ in Filter.atTop, ∃ (I : Type u) (_ : Finite I)
      (π : (SheafOfModules.free I : (Proj 𝒜).Modules) ⊗ twistingSheaf 𝒜 (-n) ⟶ F), Epi π := by
  obtain ⟨L, hL, hpow⟩ := isAmple_twistingSheaf_one_of_range f hf hcover
  obtain ⟨n₀, hn₀⟩ := F.exists_epi_biproduct_of_isAmple L hL
  refine Filter.eventually_atTop.mpr ⟨n₀, fun n hn ↦ ?_⟩
  obtain ⟨hinv, hK⟩ := hpow (-n)
  rw [zpow_neg, zpow_natCast] at hK
  let K : TauCeti.AlgebraicGeometry.InvertibleSheaf (Proj 𝒜) := ⟨twistingSheaf 𝒜 (-n), hinv⟩
  obtain ⟨k, p, hp⟩ := hn₀ n hn K hK
  let e := (Scheme.Modules.biproductIsoFreeTensor K.obj
    (Equiv.ulift.symm : Fin k ≃ ULift.{u} (Fin k))).symm
  exact ⟨ULift.{u} (Fin k), inferInstance, e.hom ≫ p, epi_comp e.hom p⟩

end AlgebraicGeometry.Proj
