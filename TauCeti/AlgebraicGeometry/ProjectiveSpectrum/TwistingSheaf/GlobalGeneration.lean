/-!
# Serre's theorem on twists of quasi-coherent sheaves on `Proj`

Let `A` be a graded ring such that `Proj A` is quasi-compact and covered by the standard opens
`D₊(f)` of degree-one elements `f`, as for projective space `ℙⁿ_R = Proj R[x₀, …, xₙ]`. The
sections `f` of `𝒪(1)` have the affine opens `D₊(f)` as nonvanishing loci, so Serre's theorem for
invertible sheaves
(`AlgebraicGeometry.Scheme.Modules.eventually_exists_generatingSections_tensor_tensorPow`) applies
to `𝒪(1)`. Since `𝒪(1)^{⊗n} ≅ 𝒪(n)` (`AlgebraicGeometry.Proj.tensorPowTwistingSheafIso`),
every quasi-coherent `𝒪_{Proj A}`-module `F` of finite type has its twists `F(n) = F ⊗ 𝒪(n)`
generated by finitely many global sections for all large `n`.
Tensoring a surjection `𝒪^{⊕I} → F(n)` with `𝒪(-n)` exhibits `F` as a quotient of the finite
direct sum `𝒪(-n)^{⊕I}` of copies of a twisting sheaf.

This is the first step in the finiteness of the cohomology of coherent sheaves on projective
schemes: it reduces statements about `F` to statements about the twisting sheaves `𝒪(m)`.

## Main results

* `AlgebraicGeometry.Proj.eventually_exists_generatingSections_tensor_twistingSheaf` and
  `TauCeti.SymmetricAlgebra.eventually_exists_generatingSections_tensor_twistingSheaf`: for every
  sufficiently large `n`, the twist `F(n)` is generated by finitely many global sections.
* `AlgebraicGeometry.Proj.eventually_exists_epi_free_tensor_twistingSheaf` and
  `TauCeti.SymmetricAlgebra.eventually_exists_epi_free_tensor_twistingSheaf`: for every
  sufficiently large `n`, `F` is a quotient of `𝒪^{⊕I} ⊗ 𝒪(-n)` for some finite `I`.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Theorem II.5.17 and
  Corollary II.5.18.
-/

public section

noncomputable section

open CategoryTheory MonoidalCategory AlgebraicGeometry TopologicalSpace TauCeti

namespace AlgebraicGeometry.Proj

universe u

variable {A : Type u} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {ι : Type*} (f : ι → A) (hf : ∀ i, f i ∈ 𝒜 1)
  (hcover : ⨆ i, basicOpen 𝒜 (f i) = ⊤)

include hf hcover in
/-- **Serre's theorem on `Proj`.** If `Proj A` is quasi-compact and covered by degree-one standard
opens `D₊(f i)` (for instance on projective space over a ring), then for every quasi-coherent
module `F` of finite type and every sufficiently large `n`, the twist `F(n) = F ⊗ 𝒪(n)` is
generated by finitely many global sections. -/
theorem eventually_exists_generatingSections_tensor_twistingSheaf [CompactSpace (Proj 𝒜)]
    (F : (Proj 𝒜).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∀ᶠ n : ℕ in Filter.atTop,
      ∃ σ : (F ⊗ twistingSheaf 𝒜 n).GeneratingSections, σ.IsFiniteType := by
  -- The invertibility results index the cover by a type in the universe of `A`; reindex the cover
  -- by the range of `f`.
  have hf' (a : Set.range f) : (a : A) ∈ 𝒜 1 := by
    obtain ⟨_, i, rfl⟩ := a
    exact hf i
  have hcover' : ⨆ a : Set.range f, basicOpen 𝒜 (a : A) = ⊤ :=
    (iSup_range' (basicOpen 𝒜) f).trans hcover
  have := isInvertible_twistingSheaf_of_iSup_eq_top _ hf' hcover' 1
  -- The sections `f i` of `𝒪(1)` have the affine standard opens `D₊(f i)` as nonvanishing loci.
  have hL (x : Proj 𝒜) : ∃ s : Γ(twistingSheaf 𝒜 1, ⊤),
      x ∈ (twistingSheaf 𝒜 1).nonvanishingLocus s ∧
        IsAffineOpen ((twistingSheaf 𝒜 1).nonvanishingLocus s) := by
    obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hcover.symm ▸ Opens.mem_top x)
    have h := twistingSheaf.nonvanishingLocus_toTwistingSheaf _ hf' hcover' 1 ⟨f i, hf i⟩
    exact ⟨toTwistingSheaf 𝒜 rfl ⊤ ⟨f i, hf i⟩, h ▸ hi,
      h ▸ isAffineOpen_basicOpen 𝒜 (f i) (hf i) one_pos⟩
  filter_upwards [Scheme.Modules.eventually_exists_generatingSections_tensor_tensorPow F hL]
    with n ⟨σ, _⟩
  exact ⟨_, SheafOfModules.GeneratingSections.isFiniteType_equivOfIso
    (whiskerLeftIso F (tensorPowTwistingSheafIso f hf hcover n)) σ⟩

include hf hcover in
/-- **Quasi-coherent sheaves of finite type on `Proj` are quotients of sums of twisting
sheaves.** If `Proj A` is quasi-compact and covered by degree-one standard opens, then for every
quasi-coherent module `F` of finite type and every sufficiently large `n`, `F` receives an
epimorphism from `𝒪^{⊕I} ⊗ 𝒪(-n) ≅ 𝒪(-n)^{⊕I}` for some finite `I`. -/
theorem eventually_exists_epi_free_tensor_twistingSheaf [CompactSpace (Proj 𝒜)]
    (F : (Proj 𝒜).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∀ᶠ n : ℕ in Filter.atTop, ∃ (I : Type u) (_ : Finite I)
      (π : (SheafOfModules.free I : (Proj 𝒜).Modules) ⊗ twistingSheaf 𝒜 (-n) ⟶ F), Epi π := by
  filter_upwards [eventually_exists_generatingSections_tensor_twistingSheaf f hf hcover F]
    with n ⟨σ, _⟩
  -- Tensor `𝒪^{⊕I} → F(n)` with `𝒪(-n)` and cancel `𝒪(n) ⊗ 𝒪(-n) ≅ 𝒪(0) ≅ 𝒪`.
  let μ : twistingSheaf 𝒜 n ⊗ twistingSheaf 𝒜 (-n) ≅ 𝟙_ (Proj 𝒜).Modules :=
    twistingSheaf.tensorObjIso f hf hcover n (-n) ≪≫
      eqToIso (congrArg (twistingSheaf 𝒜) (add_neg_cancel (n : ℤ))) ≪≫
      (unitIsoTwistingSheafZero 𝒜).symm
  -- The surjection `𝒪^{⊕I} → F(n)`, as a morphism of `𝒪_{Proj A}`-modules.
  let P : (Proj 𝒜).Modules := SheafOfModules.free σ.I
  let p : P ⟶ F ⊗ twistingSheaf 𝒜 n := σ.π
  have : Epi p := σ.epi
  -- Tensoring on the right is a left adjoint, as `𝒪_{Proj A}`-modules are braided and closed.
  have : Epi (p ▷ twistingSheaf 𝒜 (-n)) := (tensorRight _).map_epi p
  let e : (F ⊗ twistingSheaf 𝒜 n) ⊗ twistingSheaf 𝒜 (-n) ≅ F :=
    α_ F (twistingSheaf 𝒜 n) (twistingSheaf 𝒜 (-n)) ≪≫ whiskerLeftIso F μ ≪≫ ρ_ F
  exact ⟨σ.I, inferInstance, p ▷ twistingSheaf 𝒜 (-n) ≫ e.hom,
    epi_comp' this (IsIso.epi_of_iso e.hom)⟩

end AlgebraicGeometry.Proj

namespace TauCeti.SymmetricAlgebra

universe u

variable (R M : Type u) [CommRing R] [AddCommMonoid M] [Module R M] [Module.Finite R M]

/-- On `Proj (Sym M)` for a finite `R`-module `M`, every quasi-coherent module `F` of finite type
satisfies that `F ⊗ 𝒪(n)` is generated by finitely many global sections for all sufficiently
large `n`. -/
theorem eventually_exists_generatingSections_tensor_twistingSheaf
    (F : (Proj (homogeneousSubmodule R M)).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∀ᶠ n : ℕ in Filter.atTop,
      ∃ σ : (F ⊗ Proj.twistingSheaf (homogeneousSubmodule R M) n).GeneratingSections,
        σ.IsFiniteType :=
  Proj.eventually_exists_generatingSections_tensor_twistingSheaf (_root_.SymmetricAlgebra.ι R M)
    (ι_mem_homogeneousSubmodule R M) (iSup_basicOpen_ι_eq_top R M id (by simp)) F

/-- On `Proj (Sym M)` for a finite `R`-module `M`, every quasi-coherent module `F` of finite type
receives an epimorphism from `𝒪^{⊕I} ⊗ 𝒪(-n)` for some finite `I`, for all sufficiently large
`n`. -/
theorem eventually_exists_epi_free_tensor_twistingSheaf
    (F : (Proj (homogeneousSubmodule R M)).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∀ᶠ n : ℕ in Filter.atTop, ∃ (I : Type u) (_ : Finite I)
      (π : (SheafOfModules.free I : (Proj (homogeneousSubmodule R M)).Modules) ⊗
        Proj.twistingSheaf (homogeneousSubmodule R M) (-n) ⟶ F), Epi π :=
  Proj.eventually_exists_epi_free_tensor_twistingSheaf (_root_.SymmetricAlgebra.ι R M)
    (ι_mem_homogeneousSubmodule R M) (iSup_basicOpen_ι_eq_top R M id (by simp)) F

end TauCeti.SymmetricAlgebra
