module

public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.Functor
public import TauCeti.RingTheory.GradedAlgebra.Localization

/-!
# Twisting sheaves along localizations in degree zero

Let `f : 𝒜 →+*ᵍ ℬ` be a graded ring homomorphism exhibiting `B` as the localization of `A` at a
submonoid `M` of degree-zero elements, for instance `B = A_g` for `g ∈ A₀`. Then the points of
`Proj ℬ` correspond to the points of `Proj 𝒜` disjoint from `M` (an open subset, `D(g)`, when
`M` is generated by a single element `g`, but not in general), and the twisting sheaves of
`Proj ℬ` are compatible with those of `Proj 𝒜`. This file proves the second statement on sections:
over every open `U` of `Proj 𝒜` whose points are disjoint from `M`, the pullback of sections

`Γ(U, 𝒪_{Proj 𝒜}(n)) → Γ((Proj.map f hf)⁻¹ U, 𝒪_{Proj ℬ}(n))`

is bijective, for every `n ∈ ℤ` (`AlgebraicGeometry.Proj.twistingSheaf.bijective_comap`). In the
relative `Proj`, restriction of graded sections from an affine open to a basic open is such a
localization (`CategoryTheory.CommMon.isLocalization_gradedSections_basicOpen`), so this is the
statement that the transition maps of the twisting sheaves of the charts are isomorphisms over the
overlaps.

The points of `Proj ℬ` are the points of `Proj 𝒜` disjoint from `M`: the point over `x` is
obtained by extending the homogeneous prime ideal of `x`
(`ProjectiveSpectrum.extendOfIsLocalization`). The maps of localizations `A_{f⁻¹ y} → B_y` are
isomorphisms (`AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.localizationsMap_bijective`), as
both sides are localizations of `A` at the prime ideal of `f⁻¹ y`. Carrying the values of a section
of `𝒪_{Proj ℬ}(n)` back along their inverses gives a section of `𝒪_{Proj 𝒜}(n)`: a local fraction
`r / s` of `B` is a local fraction of `A`, because `r` and `s` are, up to units of degree zero,
images of homogeneous elements of `A` of the same degrees.

## Main results

* `AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.localizationsMap_bijective`: the maps of
  localizations `A_{f⁻¹ y} → B_y` are bijective.
* `AlgebraicGeometry.Proj.twistingSheaf.bijective_comap`: the pullback of sections of twisting
  sheaves along a localization in degree zero is bijective over opens disjoint from the submonoid.
* `AlgebraicGeometry.Proj.twistingSheaf.bijective_comap_of_isLocalizationAway`: the same for the
  localization away from a degree-zero element `g`, over opens contained in `D(g)`.

## References

* The Stacks Project, Section 27.11, Functoriality of Proj.
* [The Stacks Project, Section 27.15, Relative Proj](https://stacks.math.columbia.edu/tag/01NS)
-/

public section

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace HomogeneousIdeal

universe u

section universe_polymorphic

variable {A B σ τ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
  {f : 𝒜 →+*ᵍ ℬ} {M : Submonoid A} (hloc : letI := f.toRingHom.toAlgebra; IsLocalization M B)


namespace AlgebraicGeometry

open ProjectiveSpectrum.TwistingSheaf

namespace ProjectiveSpectrum.TwistingSheaf

variable (hf : ℬ₊ ≤ 𝒜₊.map f)

include hloc in
/-- Along a localization `B` of `A`, the localization `B_y` is the localization of `A` at the
prime ideal of `f⁻¹ y`. -/
private theorem isLocalization_localizations (y : ProjectiveSpectrum ℬ) :
    letI := f.toRingHom.toAlgebra
    IsLocalization.AtPrime (Localizations ℬ y)
      (ProjectiveSpectrum.comap f hf y).asHomogeneousIdeal.toIdeal :=
  let := f.toRingHom.toAlgebra
  have := hloc
  IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M _ _

include hloc in
/-- Along a localization, the maps of localizations `A_{f⁻¹ y} → B_y` are bijective. -/
theorem localizationsMap_bijective (y : ProjectiveSpectrum ℬ) :
    Function.Bijective (localizationsMap f hf y) := by
  let := f.toRingHom.toAlgebra
  have := isLocalization_localizations hloc hf y
  -- `localizationsMap` is compatible with the maps from `A`
  refine IsLocalization.bijective
    (ProjectiveSpectrum.comap f hf y).asHomogeneousIdeal.toIdeal.primeCompl _
    (RingHom.ext fun a ↦ ?_)
  rw [RingHom.comp_apply, ← Localization.mk_one_eq_algebraMap, localizationsMap_mk,
    IsScalarTower.algebraMap_apply A B (Localizations ℬ y), ← Localization.mk_one_eq_algebraMap]
  exact congrArg _ (Subtype.ext (map_one f))

variable (x : ProjectiveSpectrum 𝒜) (hx : Disjoint (M : Set A) x.asHomogeneousIdeal.toIdeal)

include hloc hf in
/-- At the point `y` over `x`, the localization `B_y` is the localization of `A` at the prime ideal
of `x`. -/
private theorem isLocalization_localizations_extendOfIsLocalization :
    letI := f.toRingHom.toAlgebra
    IsLocalization.AtPrime (Localizations ℬ (x.extendOfIsLocalization hloc hx))
      x.asHomogeneousIdeal.toIdeal := by
  have := isLocalization_localizations hloc hf (x.extendOfIsLocalization hloc hx)
  rwa [ProjectiveSpectrum.comap_extendOfIsLocalization] at this

/-- The inverse `B_y → A_x` of the map of localizations, at the point `y` over `x`: both are
localizations of `A` at the prime ideal of `x`. -/
private def localizationsInv :
    Localizations ℬ (x.extendOfIsLocalization hloc hx) →+* Localizations 𝒜 x :=
  letI := f.toRingHom.toAlgebra
  haveI := isLocalization_localizations_extendOfIsLocalization hloc hf x hx
  (IsLocalization.algEquiv x.asHomogeneousIdeal.toIdeal.primeCompl (Localizations 𝒜 x)
    (Localizations ℬ (x.extendOfIsLocalization hloc hx))).symm.toRingHom

private theorem localizationsInv_apply (b : Localizations ℬ (x.extendOfIsLocalization hloc hx)) :
    letI := f.toRingHom.toAlgebra
    haveI := isLocalization_localizations_extendOfIsLocalization hloc hf x hx
    localizationsInv hloc hf x hx b =
      (IsLocalization.algEquiv x.asHomogeneousIdeal.toIdeal.primeCompl (Localizations 𝒜 x)
        (Localizations ℬ (x.extendOfIsLocalization hloc hx))).symm b :=
  (rfl)

/-- The inverse of the map of localizations is the identity on `A`. -/
private theorem localizationsInv_algebraMap (a : A) :
    letI := f.toRingHom.toAlgebra
    localizationsInv hloc hf x hx (algebraMap B _ (algebraMap A B a)) = algebraMap A _ a := by
  let := f.toRingHom.toAlgebra
  have := isLocalization_localizations_extendOfIsLocalization hloc hf x hx
  rw [localizationsInv_apply, ← IsScalarTower.algebraMap_apply]
  exact (IsLocalization.algEquiv _ _ _).symm.commutes a

/-- The inverse of the map of localizations on a fraction `b₁ / b₂`, where `b₁ f(m₁) = f(a₁)` and
`b₂ f(m₂) = f(c₁)`. -/
private theorem localizationsInv_mk {b₁ b₂ : B}
    (hb₂ : b₂ ∈ (x.extendOfIsLocalization hloc hx).asHomogeneousIdeal.toIdeal.primeCompl)
    {a₁ c₁ : A} {m₁ m₂ : M} (h₁ : b₁ * f m₁ = f a₁) (h₂ : b₂ * f m₂ = f c₁)
    (hc : c₁ * m₁ ∈ x.asHomogeneousIdeal.toIdeal.primeCompl) :
    localizationsInv hloc hf x hx (Localization.mk b₁ ⟨b₂, hb₂⟩) =
      Localization.mk (a₁ * m₂) ⟨c₁ * m₁, hc⟩ := by
  let := f.toRingHom.toAlgebra
  have := hloc
  -- `b₁ / b₂ = (a₁ m₂) / (c₁ m₁)` in `B_y`, computed in terms of the images of `A` and `B`
  have e₁ := congrArg (algebraMap B (Localizations ℬ (x.extendOfIsLocalization hloc hx))) h₁
  have e₂ := congrArg (algebraMap B (Localizations ℬ (x.extendOfIsLocalization hloc hx))) h₂
  have e₃ := IsLocalization.mk'_spec (Localizations ℬ (x.extendOfIsLocalization hloc hx)) b₁
    ⟨b₂, hb₂⟩
  have := isLocalization_localizations_extendOfIsLocalization hloc hf x hx
  rw [Localization.mk_eq_mk'_apply, Localization.mk_eq_mk'_apply, localizationsInv_apply,
    AlgEquiv.symm_apply_eq, IsLocalization.algEquiv_mk',
    IsLocalization.eq_mk'_iff_mul_eq]
  simp only [map_mul, IsScalarTower.algebraMap_apply A B
    (Localizations ℬ (x.extendOfIsLocalization hloc hx))] at e₁ e₂ ⊢
  linear_combination
    (-(IsLocalization.mk' _ b₁ ⟨b₂, hb₂⟩ * algebraMap B _ (algebraMap A B m₁))) * e₂ +
      algebraMap B _ (algebraMap A B m₂) * algebraMap B _ (algebraMap A B m₁) * e₃ +
      algebraMap B _ (algebraMap A B m₂) * e₁

include hf in
/-- The inverse of the map of localizations is a right inverse up to the identification of `y`
with the point over `f⁻¹ y`: the composite `B_{y'} → A_{f⁻¹ y} → B_y` is the identity on `B`. -/
private theorem localizationsMap_localizationsInv_algebraMap (y : ProjectiveSpectrum ℬ) (b : B) :
    localizationsMap f hf y (localizationsInv hloc hf (ProjectiveSpectrum.comap f hf y)
      (ProjectiveSpectrum.disjoint_comap_of_isLocalization hloc hf y) (algebraMap B _ b)) =
        algebraMap B _ b := by
  let := f.toRingHom.toAlgebra
  have := hloc
  refine DFunLike.congr_fun (IsLocalization.ringHom_ext M
    (j := ((localizationsMap f hf y).comp (localizationsInv hloc hf _
      (ProjectiveSpectrum.disjoint_comap_of_isLocalization hloc hf y))).comp (algebraMap B _))
    (k := algebraMap B (Localizations ℬ y)) (RingHom.ext fun a ↦ ?_)) b
  simp only [RingHom.comp_apply]
  rw [localizationsInv_algebraMap, ← Localization.mk_one_eq_algebraMap, localizationsMap_mk,
    ← Localization.mk_one_eq_algebraMap]
  exact congrArg _ (Subtype.ext (map_one f))

include hf in
/-- The values of `t` at the points over the points of `U`, carried back by the inverses of the
maps of localizations, form a local fraction of degree `n` on `U` when `t` is one on `V`. -/
private theorem isLocallyFraction_localizationsInv (hM : ∀ m ∈ M, m ∈ 𝒜 0) {n : ℤ}
    {U : Opens (ProjectiveSpectrum.top 𝒜)} {V : Opens (ProjectiveSpectrum.top ℬ)}
    (hU : ∀ x : U, Disjoint (M : Set A) x.1.asHomogeneousIdeal.toIdeal)
    (hUV : ∀ x : U, x.1.extendOfIsLocalization hloc (hU x) ∈ V)
    {t : ∀ y : V, Localizations ℬ y.1} (ht : (isLocallyFraction ℬ n).pred t) :
    (isLocallyFraction 𝒜 n).pred fun x : U ↦
      localizationsInv hloc hf x.1 (hU x) (t ⟨_, hUV x⟩) := by
  intro x
  -- near the point over `x`, `t` is a fraction `r / s` on `V'`, and `V'` contains a basic open
  -- `D(b)` around that point, where `b f(m₀) = f(e)`
  obtain ⟨V', hV', iV', i, j, h, r, s, hs, w⟩ := ht ⟨_, hUV x⟩
  obtain ⟨_, ⟨b, rfl⟩, hb, hbV'⟩ :=
    (ProjectiveSpectrum.isTopologicalBasis_basic_opens ℬ).exists_subset_of_mem_open hV' V'.2
  let := f.toRingHom.toAlgebra
  have := hloc
  -- the algebra map of `f.toRingHom.toAlgebra` is `f`
  have hu (m : M) : IsUnit (f m) := IsLocalization.map_units B m
  obtain ⟨⟨e, m₀⟩, he : b * f m₀ = f e⟩ := IsLocalization.surj M b
  -- `r` and `s` are images of homogeneous elements of `A` of the same degrees, up to units
  obtain ⟨a, ha, m₁, h₁⟩ := f.exists_mem_mul_eq_of_isLocalization hloc hM r.2
  obtain ⟨c, hc, m₂, h₂⟩ := f.exists_mem_mul_eq_of_isLocalization hloc hM s.2
  -- the point over `z` lies in `D(b)` exactly when `z` lies in `D(e)`
  have hV' (z : U) (hz : e ∉ z.1.asHomogeneousIdeal.toIdeal) :
      z.1.extendOfIsLocalization hloc (hU z) ∈ V' :=
    hbV' fun hbz ↦ hz <| (ProjectiveSpectrum.map_mem_extendOfIsLocalization_iff hloc _ _ e).mp <|
      he ▸ Ideal.mul_mem_right _ _ (HomogeneousIdeal.mem_iff.mpr hbz)
  refine ⟨U ⊓ ProjectiveSpectrum.basicOpen 𝒜 e, ⟨x.2, fun hex ↦ hb ?_⟩, homOfLE inf_le_left, i, j,
    h, ⟨a * m₂, by simpa using SetLike.mul_mem_graded ha (hM _ m₂.2)⟩,
    ⟨c * m₁, by simpa using SetLike.mul_mem_graded hc (hM _ m₁.2)⟩, fun z hcz ↦ ?_, fun z ↦ ?_⟩
  · rw [← HomogeneousIdeal.mem_iff, ← Ideal.mul_unit_mem_iff_mem _ (hu m₀), he]
    exact (ProjectiveSpectrum.map_mem_extendOfIsLocalization_iff hloc _ (hU x) e).mpr hex
  · -- the denominator `c m₁` lies outside `z`, as `s` lies outside the point over `z`
    refine hs ⟨_, hV' ⟨z.1, z.2.1⟩ z.2.2⟩ ?_
    rw [← Ideal.mul_unit_mem_iff_mem _ (hu m₂), h₂, ← Ideal.mul_unit_mem_iff_mem _ (hu m₁),
      ← map_mul]
    exact (ProjectiveSpectrum.map_mem_extendOfIsLocalization_iff hloc _ (hU _) _).mpr hcz
  · exact (congrArg (localizationsInv hloc hf z.1 (hU ⟨z.1, z.2.1⟩))
      (w ⟨_, hV' ⟨z.1, z.2.1⟩ z.2.2⟩)).trans (localizationsInv_mk hloc hf _ _ _ h₁ h₂ _)

end ProjectiveSpectrum.TwistingSheaf

end AlgebraicGeometry

end universe_polymorphic

section universe_monomorphic

variable {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
  (f : 𝒜 →+*ᵍ ℬ) (hf : ℬ₊ ≤ 𝒜₊.map f) {M : Submonoid A} {n : ℤ}

namespace AlgebraicGeometry.Proj.twistingSheaf

open ProjectiveSpectrum.TwistingSheaf

/-- **The twisting sheaves are compatible with localization in degree zero.** If `f` exhibits `B`
as the localization of `A` at a submonoid `M` of degree-zero elements, then over every open `U` of
`Proj 𝒜` whose points are disjoint from `M`, the pullback of sections
`Γ(U, 𝒪_{Proj 𝒜}(n)) → Γ((Proj.map f hf)⁻¹ U, 𝒪_{Proj ℬ}(n))` is bijective. -/
theorem bijective_comap (hloc : letI := f.toRingHom.toAlgebra; IsLocalization M B)
    (hM : ∀ m ∈ M, m ∈ 𝒜 0) {U : (Proj 𝒜).Opens}
    (hU : ∀ x : U, Disjoint (M : Set A) x.1.asHomogeneousIdeal.toIdeal) :
    Function.Bijective (comap f hf (n := n) (U := U) (V := map f hf ⁻¹ᵁ U) Set.Subset.rfl) := by
  -- the point over `x` lies in the preimage of `U`, as its image under `Proj.map f hf` is `x`
  have hy (x : U) : ProjectiveSpectrum.extendOfIsLocalization hloc x.1 (hU x) ∈ map f hf ⁻¹ᵁ U :=
    Set.mem_of_eq_of_mem (s := (U : Set (Proj 𝒜)))
      (ProjectiveSpectrum.comap_extendOfIsLocalization hloc hf x.1 (hU x)) x.2
  refine ⟨(injective_iff_map_eq_zero _).mpr fun s hs ↦ ext fun (x : U) ↦ ?_, fun t ↦ ?_⟩
  · -- the pullback of `s` vanishes at the point over `x`, and the map of localizations there is
    -- injective
    have h0 : localizationsMap f hf _ (s.1 ⟨_, hy x⟩) = 0 :=
      (comap_apply f hf _ s ⟨_, hy x⟩).symm.trans
      ((congrArg (fun t : Γ(twistingSheaf ℬ n, map f hf ⁻¹ᵁ U) ↦ t.1 ⟨_, hy x⟩) hs).trans
        (zero_apply _))
    replace h0 := (localizationsMap_bijective hloc hf _).1 (h0.trans (map_zero _).symm)
    have e : (⟨_, hy x⟩ : U) = x :=
      Subtype.ext (ProjectiveSpectrum.comap_extendOfIsLocalization hloc hf x.1 _)
    exact ((congrArg (fun z : U ↦ s.1 z = 0) e).mp h0).trans (zero_apply x).symm
  -- the value at `x` is the value of `t` at the point over `x`, carried back to `A_x`
  refine ⟨⟨fun x ↦ localizationsInv hloc hf x.1 (hU x) (t.1 ⟨_, hy x⟩),
    isLocallyFraction_localizationsInv hloc hf hM hU hy t.2⟩, ext fun (y : map f hf ⁻¹ᵁ U) ↦ ?_⟩
  -- at `y`, the composite `B_{y'} → A_{f⁻¹ y} → B_y` through the point `y'` over `f⁻¹ y = y` is
  -- the identity
  have key (y' y₀ : ProjectiveSpectrum ℬ) (hy' : y' ∈ map f hf ⁻¹ᵁ U)
      (hy₀ : y₀ ∈ map f hf ⁻¹ᵁ U) (g : Localizations ℬ y' →+* Localizations ℬ y₀)
      (hg : ∀ b, g (algebraMap B _ b) = algebraMap B _ b) (hyy : y' = y₀) :
      g (t.1 ⟨y', hy'⟩) = t.1 ⟨y₀, hy₀⟩ := by
    subst hyy
    rw [IsLocalization.ringHom_ext y'.asHomogeneousIdeal.toIdeal.primeCompl
      (j := g) (k := RingHom.id _) (RingHom.ext hg)]
    rfl
  exact (comap_apply f hf _ _ y).trans (key _ y.1 _ y.2 ((localizationsMap f hf y.1).comp
    (localizationsInv hloc hf _ (ProjectiveSpectrum.disjoint_comap_of_isLocalization hloc hf y.1)))
    (localizationsMap_localizationsInv_algebraMap hloc hf y.1)
    (ProjectiveSpectrum.extendOfIsLocalization_comap hloc hf y.1))

/-- **The twisting sheaves are compatible with localization away from a degree-zero element.** If
`f` exhibits `B` as the localization of `A` away from `g ∈ A₀`, then over every open `U ⊆ D(g)` of
`Proj 𝒜`, the pullback of sections `Γ(U, 𝒪_{Proj 𝒜}(n)) → Γ((Proj.map f hf)⁻¹ U, 𝒪_{Proj ℬ}(n))`
is bijective. -/
theorem bijective_comap_of_isLocalizationAway {g : A} (hg : g ∈ 𝒜 0)
    (hloc : letI := f.toRingHom.toAlgebra; IsLocalization.Away g B) {U : (Proj 𝒜).Opens}
    (hU : U ≤ basicOpen 𝒜 g) :
    Function.Bijective (comap f hf (n := n) (U := U) (V := map f hf ⁻¹ᵁ U) Set.Subset.rfl) :=
  bijective_comap f hf hloc (by rintro _ ⟨k, rfl⟩; simpa using SetLike.pow_mem_graded k hg)
    fun x ↦ (Ideal.disjoint_powers_iff_notMem g
      (x.1 : ProjectiveSpectrum 𝒜).isPrime.isRadical).mpr (hU x.2)

end AlgebraicGeometry.Proj.twistingSheaf

end universe_monomorphic
