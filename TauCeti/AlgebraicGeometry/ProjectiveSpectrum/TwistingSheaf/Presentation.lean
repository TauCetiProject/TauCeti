module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Proper
public import TauCeti.AlgebraicGeometry.LineBundle.Quotient
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.SymmetricAlgebra
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.Ample
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.TensorProduct

/-!
# Serre generation and quotient presentations by twisting sheaves on `Proj`

On a quasi-compact projective spectrum `Proj 𝒜` covered by degree-one standard opens `D₊(f i)`,
`𝒪(1)` is ample (`AlgebraicGeometry.Proj.isAmple_twistingSheaf`) and `[𝒪(n)] = [𝒪(1)] ^ n` in the
group of line-bundle classes (`AlgebraicGeometry.Proj.lineBundleClass_twistingSheaf_eq_zpow`).
Combining these with Serre's global generation theorem for ample line bundles
(`TauCeti.AlgebraicGeometry.LineBundleClass.IsAmple.exists_forall_ge_generatingSections`) yields:

1. For every quasi-coherent `𝒪_{Proj 𝒜}`-module `F` of finite type, there exists `n₀` such that
   `F ⊗ 𝒪(n)` is generated by finitely many global sections for all `n ≥ n₀`
   (`AlgebraicGeometry.Proj.exists_forall_ge_generatingSections_twistingSheaf`).
2. Equivalently, for all `n ≥ n₀` there exist `k : ℕ` and an epimorphism
   `⨁_{Fin k} 𝒪(-n) ⟶ F` (`AlgebraicGeometry.Proj.exists_forall_ge_epi_biproduct_twistingSheaf`).

Both statements specialize unconditionally (without Noetherian or freeness hypotheses) to
`Proj (SymmetricAlgebra.homogeneousSubmodule R M)` for any finite `R`-module `M`.

## References

* A. Grothendieck, *Éléments de géométrie algébrique. II*, Publ. Math. IHÉS **8** (1961), §4.5.
* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Theorem II.5.17 and
  Corollary II.5.18.
* [The Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3).
-/

public section

noncomputable section

open CategoryTheory Limits MonoidalCategory AlgebraicGeometry

namespace AlgebraicGeometry.Proj

universe u

variable {A : Type u} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜] [CompactSpace (Proj 𝒜)]
  {ι : Type u} (f : ι → A) (hf : ∀ i, f i ∈ 𝒜 1)
  (hcover : ⨆ i, basicOpen 𝒜 (f i) = ⊤)

include hf hcover

/-- **Serre's global generation theorem on `Proj`** (Hartshorne, Theorem II.5.17): on a
quasi-compact `Proj 𝒜` covered by degree-one standard opens, every quasi-coherent module `F` of
finite type has `F ⊗ 𝒪(n)` generated by finitely many global sections for all sufficiently large
`n : ℕ`. -/
theorem exists_forall_ge_generatingSections_twistingSheaf
    (F : (Proj 𝒜).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ G : (F ⊗ (twistingSheaf 𝒜 (n : ℤ) : (Proj 𝒜).Modules)).GeneratingSections,
        G.IsFiniteType := by
  obtain ⟨n₀, hn₀⟩ :=
    (isAmple_twistingSheaf f hf hcover Nat.one_pos).exists_forall_ge_generatingSections F
  refine ⟨n₀, fun n hn ↦ hn₀ n hn
    ⟨twistingSheaf 𝒜 (n : ℤ), isInvertible_twistingSheaf_of_iSup_eq_top f hf hcover (n : ℤ)⟩ ?_⟩
  exact (lineBundleClass_twistingSheaf_eq_zpow f hf hcover (n : ℤ)).trans (zpow_natCast _ n)

/-- Integer-indexed form of `exists_forall_ge_generatingSections_twistingSheaf`: for quasi-coherent
`F` of finite type on a quasi-compact `Proj 𝒜` covered by degree-one standard opens, `F ⊗ 𝒪(m)` is
generated by finitely many global sections for all sufficiently large `m : ℤ`. -/
theorem exists_int_forall_ge_generatingSections_twistingSheaf
    (F : (Proj 𝒜).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ m₀ : ℤ, ∀ m ≥ m₀,
      ∃ G : (F ⊗ (twistingSheaf 𝒜 m : (Proj 𝒜).Modules)).GeneratingSections,
        G.IsFiniteType := by
  obtain ⟨n₀, hn₀⟩ := exists_forall_ge_generatingSections_twistingSheaf f hf hcover F
  refine ⟨(n₀ : ℤ), fun m hm ↦ ?_⟩
  have hm0 : 0 ≤ m := le_trans (Nat.cast_nonneg n₀) hm
  have hmn : n₀ ≤ m.toNat := by omega
  exact Int.toNat_of_nonneg hm0 ▸ hn₀ m.toNat hmn

/-- **Quotient presentation by negative twists on `Proj`** (Hartshorne, Corollary II.5.18): on a
quasi-compact `Proj 𝒜` covered by degree-one standard opens, every quasi-coherent module `F` of
finite type is a quotient of a finite biproduct `⨁_{Fin k} 𝒪(-n)` for all sufficiently large
`n : ℕ`. -/
theorem exists_forall_ge_epi_biproduct_twistingSheaf
    (F : (Proj 𝒜).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ (k : ℕ) (p : (⨁ fun _ : Fin k ↦ (twistingSheaf 𝒜 (-(n : ℤ)) : (Proj 𝒜).Modules)) ⟶ F),
        Epi p := by
  obtain ⟨n₀, hn₀⟩ :=
    (isAmple_twistingSheaf f hf hcover Nat.one_pos).exists_forall_ge_epi_biproduct F
  refine ⟨n₀, fun n hn ↦ hn₀ n hn
    ⟨twistingSheaf 𝒜 (-(n : ℤ)),
      isInvertible_twistingSheaf_of_iSup_eq_top f hf hcover (-(n : ℤ))⟩ ?_⟩
  exact (lineBundleClass_twistingSheaf_eq_zpow f hf hcover (-(n : ℤ))).trans
    ((zpow_neg _ (n : ℤ)).trans (congrArg Inv.inv (zpow_natCast _ n)))

end AlgebraicGeometry.Proj

namespace TauCeti.SymmetricAlgebra

universe u

variable (R M : Type u) [CommRing R] [AddCommMonoid M] [Module R M] [Module.Finite R M]

/-- On `Proj(Sym_R M)` for a finite `R`-module `M`, every quasi-coherent module `F` of finite type
has `F ⊗ 𝒪(n)` generated by finitely many global sections for all sufficiently large `n : ℕ`. -/
theorem exists_forall_ge_generatingSections_twistingSheaf
    (F : (Proj (homogeneousSubmodule R M)).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ G : (F ⊗ (Proj.twistingSheaf (homogeneousSubmodule R M) (n : ℤ) :
        (Proj (homogeneousSubmodule R M)).Modules)).GeneratingSections, G.IsFiniteType :=
  Proj.exists_forall_ge_generatingSections_twistingSheaf (_root_.SymmetricAlgebra.ι R M)
    (ι_mem_homogeneousSubmodule R M) (iSup_basicOpen_ι_eq_top R M id (by simp)) F

/-- On `Proj(Sym_R M)` for a finite `R`-module `M`, every quasi-coherent module `F` of finite type
is a quotient of a finite biproduct `⨁_{Fin k} 𝒪(-n)` for all sufficiently large `n : ℕ`. -/
theorem exists_forall_ge_epi_biproduct_twistingSheaf
    (F : (Proj (homogeneousSubmodule R M)).Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ (k : ℕ) (p : (⨁ fun _ : Fin k ↦
        (Proj.twistingSheaf (homogeneousSubmodule R M) (-(n : ℤ)) :
          (Proj (homogeneousSubmodule R M)).Modules)) ⟶ F), Epi p :=
  Proj.exists_forall_ge_epi_biproduct_twistingSheaf (_root_.SymmetricAlgebra.ι R M)
    (ι_mem_homogeneousSubmodule R M) (iSup_basicOpen_ι_eq_top R M id (by simp)) F

end TauCeti.SymmetricAlgebra

end
