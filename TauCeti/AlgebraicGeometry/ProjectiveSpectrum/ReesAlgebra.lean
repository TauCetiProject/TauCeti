module

public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.BaseChange
public import TauCeti.RingTheory.ReesAlgebra.Grading

/-!
# Projective spectrum of the Rees algebra

Basic geometric properties of `Proj R[It]` for an ideal `I` of a commutative ring `R`, bridging
`reesAlgebra.grade I` and `AlgebraicGeometry.Proj`:

* `TauCeti.AlgebraicGeometry.toSpecCoeff_reesAlgebra`: the coefficient structure morphism
  `Proj R[It] ⟶ Spec R` is `Proj.toSpecZero` composed with the degree-zero identification
  `gradeZeroEquiv I`.
* `TauCeti.AlgebraicGeometry.iSup_basicOpen_monomialDegreeOne`: any generating family of `I`
  gives a cover of `Proj R[It]` by degree-one standard opens `D₊(sᵢ t)`.
* `TauCeti.AlgebraicGeometry.sup_basicOpen_monomialDegreeOne_span_pair`: for a two-generator
  ideal `(x₁, x₂)`, the two standard opens `D₊(x₁ t)` and `D₊(x₂ t)` cover `Proj R[(x₁, x₂)t]`.
-/

public section

noncomputable section

open CategoryTheory reesAlgebra

universe u

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry

variable {R : Type u} [CommRing R] {I : Ideal R}

/-- The coefficient structure morphism `Proj R[It] ⟶ Spec R` of the blowup is the structure
morphism to the spectrum of the degree zero part of `R[It]`, identified with `R` by
`reesAlgebra.gradeZeroEquiv`. -/
theorem toSpecCoeff_reesAlgebra (I : Ideal R) :
    Proj.toSpecCoeff (grade I) =
      Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom := by
  have h : (gradeZeroEquiv I : R →+* grade I 0) = algebraMap R (grade I 0) :=
    RingHom.ext (gradeZeroEquiv_apply I)
  rw [Proj.toSpecCoeff_def, RingEquiv.toCommRingCatIso_hom, h]

/-- **The standard opens of a generating family cover `Proj R[It]`.** If the ideal `I` is
generated by a family `s`, then the standard opens `D₊(sᵢ t)` cover `Proj R[It]`. -/
theorem iSup_basicOpen_monomialDegreeOne {ι : Type*} {s : ι → R}
    (hs : Ideal.span (Set.range s) = I) :
    ⨆ i, Proj.basicOpen (grade I)
      (monomialDegreeOne (hs ▸ Ideal.subset_span ⟨i, rfl⟩ : s i ∈ I)) = ⊤ :=
  Proj.iSup_basicOpen_eq_top _ _ (irrelevant_eq_span_monomialDegreeOne hs).le

/-- The standard opens `D₊(a t)` for all `a ∈ I` cover `Proj R[It]`. -/
theorem iSup_basicOpen_monomialDegreeOne_coe (I : Ideal R) :
    ⨆ a : I, Proj.basicOpen (grade I) (monomialDegreeOne a.property) = ⊤ :=
  iSup_basicOpen_monomialDegreeOne (s := ((↑) : I → R)) (by simp)

/-- The two standard opens `D₊(x₁ t)` and `D₊(x₂ t)` cover the blowup `Proj R[(x₁, x₂)t]`. -/
theorem sup_basicOpen_monomialDegreeOne_span_pair (x₁ x₂ : R) :
    Proj.basicOpen (grade (Ideal.span ({x₁, x₂} : Set R)))
        (monomialDegreeOne (Ideal.subset_span (Set.mem_insert x₁ {x₂}))) ⊔
      Proj.basicOpen (grade (Ideal.span ({x₁, x₂} : Set R)))
        (monomialDegreeOne (Ideal.subset_span (Set.mem_insert_of_mem x₁ (Set.mem_singleton x₂)))) =
      ⊤ := by
  have hspan : Ideal.span (Set.range ![x₁, x₂]) = Ideal.span ({x₁, x₂} : Set R) := by
    rw [Matrix.range_cons_cons_empty]
  have htop := iSup_basicOpen_monomialDegreeOne hspan
  rw [← htop, ← finTwoEquiv.symm.iSup_comp, iSup_bool_eq, sup_comm]
  simp [finTwoEquiv]

end TauCeti.AlgebraicGeometry
