/-!
# The Segre closed immersion

For any commutative ring `R` and coordinate sets `σ` and `τ`, pairwise products of
homogeneous coordinates define a closed immersion
`Proj R[Xᵢ] ×[Spec R] Proj R[Yⱼ] → Proj R[Z₍ᵢ,ⱼ₎]`.

The construction glues the standard charts. Their coordinate rings are generated by
normalized coordinates, and the induced chart maps are surjective. The inverse-image
formula for a product coordinate chart identifies these affine maps with the restrictions
of the global morphism, proving the closed-immersion assertion locally on the target.
No finiteness assumption on the coordinate sets or coefficient ring is needed.

## References

* The Stacks Project, Section 27.13, projective space (tag 01ND).
* R. Hartshorne, *Algebraic Geometry*, Chapter I, Exercise 2.14.
-/

public section

open HomogeneousLocalization CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped TensorProduct

namespace AlgebraicGeometry.Proj

universe u

section Segre

attribute [local instance] MvPolynomial.gradedAlgebra

open MvPolynomial TauCeti.MvPolynomial

variable (R σ τ : Type u) [CommRing R]

private noncomputable abbrev segreCover :
    (pullback (toSpecCoeff (homogeneousSubmodule σ R))
      (toSpecCoeff (homogeneousSubmodule τ R))).OpenCover :=
  Scheme.Pullback.openCoverOfLeftRight (polynomialAffineOpenCover R σ).openCover
    (polynomialAffineOpenCover R τ).openCover _ _

variable {σ τ}

private instance isOpenImmersion_segreCover_f (i : σ) (j : τ) :
    IsOpenImmersion ((segreCover R σ τ).f (i, j)) :=
  (segreCover R σ τ).map_prop (i, j)

private noncomputable def segreCoverFst (i : σ) (j : τ) :
    (segreCover R σ τ).X (i, j) ⟶
      Spec (.of (Away (homogeneousSubmodule σ R) (X i))) :=
  pullback.fst _ _

private noncomputable def segreCoverSnd (i : σ) (j : τ) :
    (segreCover R σ τ).X (i, j) ⟶
      Spec (.of (Away (homogeneousSubmodule τ R) (X j))) :=
  pullback.snd _ _

@[reassoc]
private theorem segreCoverFst_awayι (i : σ) (j : τ) :
    segreCoverFst R i j ≫ awayι _ (X i) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R
      i)) one_pos =
      (segreCover R σ τ).f (i, j) ≫ pullback.fst _ _ := by
  -- The cover projection is the first projection of the pullback of the two chart maps.
  change pullback.fst _ _ ≫ _ =
    pullback.map _ _ _ _ _ _ (𝟙 (Spec (.of R)))
      (Category.comp_id _) (Category.comp_id _) ≫ pullback.fst _ _
  simp only [pullback.map, pullback.lift_fst]
  rfl

@[reassoc]
private theorem segreCoverSnd_awayι (i : σ) (j : τ) :
    segreCoverSnd R i j ≫ awayι _ (X j) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R
      j)) one_pos =
      (segreCover R σ τ).f (i, j) ≫ pullback.snd _ _ := by
  -- The cover projection is the second projection of the pullback of the two chart maps.
  change pullback.snd _ _ ≫ _ =
    pullback.map _ _ _ _ _ _ (𝟙 (Spec (.of R)))
      (Category.comp_id _) (Category.comp_id _) ≫ pullback.snd _ _
  simp only [pullback.map, pullback.lift_snd]
  rfl

private noncomputable def segreChartSection (i : σ) (j : τ) (k : σ × τ) :
    Γ((segreCover R σ τ).X (i, j), ⊤) :=
  ((Scheme.ΓSpecIso _).inv ≫ (segreCoverFst R i j).appTop).hom (awayXRatio i k.1) *
    ((Scheme.ΓSpecIso _).inv ≫ (segreCoverSnd R i j).appTop).hom (awayXRatio j k.2)

@[simp]
private theorem segreChartSection_self (i : σ) (j : τ) :
    segreChartSection R i j (i, j) = 1 := by
  simp [segreChartSection]

private noncomputable def segreChartCoeff (i : σ) (j : τ) :
    R →+* Γ((segreCover R σ τ).X (i, j), ⊤) :=
  ((Scheme.ΓSpecIso (.of R)).inv ≫
    ((segreCover R σ τ).f (i, j) ≫ pullback.fst _ _ ≫
      toSpecCoeff (homogeneousSubmodule σ R)).appTop).hom

private noncomputable def segreChartEval (i : σ) (j : τ) :
    MvPolynomial (σ × τ) R →+* Γ((segreCover R σ τ).X (i, j), ⊤) :=
  eval₂Hom (segreChartCoeff R i j) (segreChartSection R i j)

private theorem segreChartEval_irrelevant (i : σ) (j : τ) :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule (σ × τ) R)).toIdeal.map
      (segreChartEval R i j) = ⊤ := by
  rw [irrelevant_eq_span_X, Ideal.map_span, ← Set.range_comp, Ideal.eq_top_iff_one]
  exact Ideal.subset_span ⟨(i, j), by simp [segreChartEval]⟩

private noncomputable def segreChartHom (i : σ) (j : τ) :
    (segreCover R σ τ).X (i, j) ⟶ Proj (homogeneousSubmodule (σ × τ) R) :=
  fromOfGlobalSections _ (segreChartEval R i j) (segreChartEval_irrelevant R i j)

private theorem segreChartSection_pullback {Z : Scheme.{u}} (i : σ) (j : τ)
    (p : Z ⟶ (segreCover R σ τ).X (i, j)) (a : σ × τ) :
    p.appTop.hom (segreChartSection R i j a) =
      ((Scheme.ΓSpecIso _).inv ≫ (p ≫ segreCoverFst R i j).appTop).hom
        (awayXRatio (R := R) i a.1) *
      ((Scheme.ΓSpecIso _).inv ≫ (p ≫ segreCoverSnd R i j).appTop).hom
        (awayXRatio (R := R) j a.2) := by
  exact p.appTop.hom.map_mul _ _

private theorem segreChartSection_rescaling {Z : Scheme.{u}} (i k : σ) (j l : τ)
    (p : Z ⟶ (segreCover R σ τ).X (i, j))
    (q : Z ⟶ (segreCover R σ τ).X (k, l))
    (h : p ≫ (segreCover R σ τ).f (i, j) =
      q ≫ (segreCover R σ τ).f (k, l)) :
    ∃ c : Γ(Z, ⊤)ˣ, ∀ a,
      q.appTop.hom (segreChartSection R k l a) =
        c * p.appTop.hom (segreChartSection R i j a) := by
  have h₁ : (p ≫ segreCoverFst R i j) ≫ awayι _ (X i) ((mem_homogeneousSubmodule _ _).mpr
    (isHomogeneous_X R i)) one_pos =
      (q ≫ segreCoverFst R k l) ≫ awayι _ (X k) ((mem_homogeneousSubmodule _ _).mpr
        (isHomogeneous_X R k)) one_pos := by
    rw [Category.assoc, Category.assoc, segreCoverFst_awayι, segreCoverFst_awayι,
      ← Category.assoc, ← Category.assoc, h]
  have h₂ : (p ≫ segreCoverSnd R i j) ≫ awayι _ (X j) ((mem_homogeneousSubmodule _ _).mpr
    (isHomogeneous_X R j)) one_pos =
      (q ≫ segreCoverSnd R k l) ≫ awayι _ (X l) ((mem_homogeneousSubmodule _ _).mpr
        (isHomogeneous_X R l)) one_pos := by
    rw [Category.assoc, Category.assoc, segreCoverSnd_awayι, segreCoverSnd_awayι,
      ← Category.assoc, ← Category.assoc, h]
  obtain ⟨a, ha⟩ := awayXRatio_rescaling R i k _ _ h₁
  obtain ⟨b, hb⟩ := awayXRatio_rescaling R j l _ _ h₂
  refine ⟨a * b, fun s ↦ ?_⟩
  rw [segreChartSection_pullback, segreChartSection_pullback, ha s.1, hb s.2,
    Units.val_mul]
  ring

private theorem segreChartCoeff_compatible (i k : σ) (j l : τ) :
    (pullback.fst ((segreCover R σ τ).f (i, j))
      ((segreCover R σ τ).f (k, l))).appTop.hom.comp (segreChartCoeff R i j) =
    (pullback.snd ((segreCover R σ τ).f (i, j))
      ((segreCover R σ τ).f (k, l))).appTop.hom.comp (segreChartCoeff R k l) := by
  have h : pullback.fst ((segreCover R σ τ).f (i, j))
        ((segreCover R σ τ).f (k, l)) ≫
      ((segreCover R σ τ).f (i, j) ≫ pullback.fst _ _ ≫
        toSpecCoeff (homogeneousSubmodule σ R)) =
      pullback.snd _ _ ≫ ((segreCover R σ τ).f (k, l) ≫ pullback.fst _ _ ≫
        toSpecCoeff (homogeneousSubmodule σ R)) := by
    rw [← Category.assoc, ← Category.assoc, pullback.condition]
    simp only [Category.assoc]
  exact congrArg (fun m : pullback ((segreCover R σ τ).f (i, j))
      ((segreCover R σ τ).f (k, l)) ⟶ Spec (.of R) ↦
    ((Scheme.ΓSpecIso (.of R)).inv ≫ m.appTop).hom) h

private theorem segreChartEval_rescaling {Z : Scheme.{u}} (i k : σ) (j l : τ)
    (p : Z ⟶ (segreCover R σ τ).X (i, j))
    (q : Z ⟶ (segreCover R σ τ).X (k, l))
    (hcoeff : p.appTop.hom.comp (segreChartCoeff R i j) =
      q.appTop.hom.comp (segreChartCoeff R k l)) (c : Γ(Z, ⊤)ˣ)
    (hc : ∀ s, q.appTop.hom (segreChartSection R k l s) =
      c * p.appTop.hom (segreChartSection R i j s))
    {n : ℕ} {a : MvPolynomial (σ × τ) R}
    (ha : a ∈ homogeneousSubmodule (σ × τ) R n) :
    (q.appTop.hom.comp (segreChartEval R k l)) a =
      c ^ n * (p.appTop.hom.comp (segreChartEval R i j)) a := by
  simp only [segreChartEval, comp_eval₂Hom, coe_eval₂Hom]
  rw [← hcoeff]
  simp only [hc]
  exact (mem_homogeneousSubmodule _ _).mp ha |>.eval₂_const_mul _ _ _

private theorem segreChartHom_compatible (i k : σ) (j l : τ) :
    pullback.fst ((segreCover R σ τ).f (i, j)) ((segreCover R σ τ).f (k, l)) ≫
      segreChartHom R i j =
    pullback.snd _ _ ≫ segreChartHom R k l := by
  let p := pullback.fst ((segreCover R σ τ).f (i, j)) ((segreCover R σ τ).f (k, l))
  let q := pullback.snd ((segreCover R σ τ).f (i, j)) ((segreCover R σ τ).f (k, l))
  obtain ⟨c, hc⟩ := segreChartSection_rescaling R i k j l p q pullback.condition
  have hscale : ∀ n, ∀ a ∈ homogeneousSubmodule (σ × τ) R n,
      (q.appTop.hom.comp (segreChartEval R k l)) a =
        c ^ n * (p.appTop.hom.comp (segreChartEval R i j)) a := by
    intro n a ha
    exact segreChartEval_rescaling R i k j l p q
      (segreChartCoeff_compatible R i k j l) c hc ha
  simp only [segreChartHom, fromOfGlobalSections_naturality]
  exact (TauCeti.ProjectiveSpectrum.fromOfGlobalSections_eq_of_unit_rescaling _
    (p.appTop.hom.comp (segreChartEval R i j))
    (q.appTop.hom.comp (segreChartEval R k l)) c hscale _).symm

/-- The Segre morphism, sending a pair of homogeneous coordinates to their pairwise products. -/
noncomputable def segre :
    pullback (toSpecCoeff (homogeneousSubmodule σ R))
      (toSpecCoeff (homogeneousSubmodule τ R)) ⟶
      Proj (homogeneousSubmodule (σ × τ) R) :=
  (segreCover R σ τ).glueMorphisms (fun a ↦ segreChartHom R a.1 a.2)
    (fun a b ↦ segreChartHom_compatible R a.1 b.1 a.2 b.2)

@[reassoc]
private theorem segreCover_f_segre (i : σ) (j : τ) :
    (segreCover R σ τ).f (i, j) ≫ segre (σ := σ) (τ := τ) R =
      segreChartHom R i j :=
  (segreCover R σ τ).ι_glueMorphisms _ _ (i, j)

end Segre

end AlgebraicGeometry.Proj

namespace AlgebraicGeometry

universe u


end AlgebraicGeometry

namespace AlgebraicGeometry.Proj

universe u

open MvPolynomial TauCeti.MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] {σ τ : Type u}

private theorem isPullback_segreCover (i : σ) (j : τ) :
    IsPullback (segreCoverFst R i j) (segreCoverSnd R i j)
      (Spec.map (CommRingCat.ofHom (algebraMap R (Away (homogeneousSubmodule σ R) (X i)))))
      (Spec.map (CommRingCat.ofHom (algebraMap R (Away (homogeneousSubmodule τ R) (X j))))) := by
  rw [← awayι_toSpecCoeff _ ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R i)) one_pos,
    ← awayι_toSpecCoeff _ ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R j)) one_pos]
  exact IsPullback.of_hasPullback _ _

private noncomputable def segreChartIso (i : σ) (j : τ) :
    (segreCover R σ τ).X (i, j) ≅
      Spec (.of (Away (homogeneousSubmodule σ R) (X i) ⊗[R]
        Away (homogeneousSubmodule τ R) (X j))) :=
  (isPullback_segreCover R i j).isoPullback ≪≫ pullbackSpecIso _ _ _

@[reassoc]
private theorem segreChartIso_hom_fst (i : σ) (j : τ) :
    (segreChartIso R i j).hom ≫
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := R))) =
      segreCoverFst R i j := by
  rw [segreChartIso, Iso.trans_hom, Category.assoc, pullbackSpecIso_hom_fst,
    IsPullback.isoPullback_hom_fst]

@[reassoc]
private theorem segreChartIso_hom_snd (i : σ) (j : τ) :
    (segreChartIso R i j).hom ≫
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
        (R := R)).toRingHom) = segreCoverSnd R i j := by
  calc
    _ = (isPullback_segreCover R i j).isoPullback.hom ≫
        ((pullbackSpecIso R (Away (homogeneousSubmodule σ R) (X i))
          (Away (homogeneousSubmodule τ R) (X j))).hom ≫
          Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
            (R := R)).toRingHom)) := rfl
    _ = (isPullback_segreCover R i j).isoPullback.hom ≫ pullback.snd _ _ :=
      congrArg ((isPullback_segreCover R i j).isoPullback.hom ≫ ·)
        (pullbackSpecIso_hom_snd R (Away (homogeneousSubmodule σ R) (X i))
          (Away (homogeneousSubmodule τ R) (X j)))
    _ = _ := IsPullback.isoPullback_hom_snd _

private instance isAffine_segreChart (i : σ) (j : τ) :
    IsAffine ((segreCover R σ τ).X (i, j)) :=
  IsAffine.of_isIso (segreChartIso R i j).hom

/-- The polynomial homomorphism on a tensor product of standard charts,
sending `X₍ₖ,ₗ₎` to `(Xₖ / Xᵢ) ⊗ (Xₗ / Xⱼ)`. -/
noncomputable def segreTensorEval (i : σ) (j : τ) :
    MvPolynomial (σ × τ) R →ₐ[R]
      Away (homogeneousSubmodule σ R) (X i) ⊗[R] Away (homogeneousSubmodule τ R) (X j) :=
  aeval (fun k : σ × τ ↦ awayXRatio i k.1 ⊗ₜ[R] awayXRatio j k.2)

/-- The tensor chart homomorphism sends a variable to the tensor of normalized coordinates. -/
@[simp]
theorem segreTensorEval_X (i k : σ) (j l : τ) :
    segreTensorEval R i j (X (k, l)) = awayXRatio i k ⊗ₜ[R] awayXRatio j l := by
  simp [segreTensorEval]

private theorem segreTensorEval_surjective (i : σ) (j : τ) :
    Function.Surjective (segreTensorEval R i j) := by
  rw [← AlgHom.range_eq_top, segreTensorEval, ← Algebra.adjoin_range_eq_range_aeval]
  exact Algebra.TensorProduct.adjoin_range_tmul_eq_top
    (adjoin_range_awayXRatio i) (adjoin_range_awayXRatio j)
    (awayXRatio_self i) (awayXRatio_self j)

private noncomputable def segreChartSections (i : σ) (j : τ) :
    Away (homogeneousSubmodule σ R) (X i) ⊗[R] Away (homogeneousSubmodule τ R) (X j) →+*
      Γ((segreCover R σ τ).X (i, j), ⊤) :=
  ((Scheme.ΓSpecIso _).inv ≫ (segreChartIso R i j).hom.appTop).hom

private theorem segreChartSections_left (i : σ) (j : τ)
    (a : Away (homogeneousSubmodule σ R) (X i)) :
    segreChartSections R i j (a ⊗ₜ[R] 1) =
      ((Scheme.ΓSpecIso _).inv ≫ (segreCoverFst R i j).appTop).hom a := by
  rw [← segreChartIso_hom_fst R i j, Scheme.Hom.comp_appTop, ← Category.assoc,
    ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  rfl

private theorem segreChartSections_right (i : σ) (j : τ)
    (b : Away (homogeneousSubmodule τ R) (X j)) :
    segreChartSections R i j (1 ⊗ₜ[R] b) =
      ((Scheme.ΓSpecIso _).inv ≫ (segreCoverSnd R i j).appTop).hom b := by
  rw [← segreChartIso_hom_snd R i j, Scheme.Hom.comp_appTop, ← Category.assoc,
    ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  rfl

private theorem segreChartSections_tmul (i : σ) (j : τ)
    (a : Away (homogeneousSubmodule σ R) (X i))
    (b : Away (homogeneousSubmodule τ R) (X j)) :
    segreChartSections R i j (a ⊗ₜ[R] b) =
      ((Scheme.ΓSpecIso _).inv ≫ (segreCoverFst R i j).appTop).hom a *
        ((Scheme.ΓSpecIso _).inv ≫ (segreCoverSnd R i j).appTop).hom b := by
  rw [← segreChartSections_left R i j, ← segreChartSections_right R i j, ← map_mul,
    Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

private theorem segreChartCoeff_eq (i : σ) (j : τ) (r : R) :
    segreChartCoeff R i j r =
      segreChartSections R i j (algebraMap R _ r) := by
  have hbase : (segreCover R σ τ).f (i, j) ≫ pullback.fst _ _ ≫
      toSpecCoeff (homogeneousSubmodule σ R) =
      segreCoverFst R i j ≫ Spec.map
        (CommRingCat.ofHom (algebraMap R (Away (homogeneousSubmodule σ R) (X i)))) := by
    rw [← Category.assoc, ← segreCoverFst_awayι, Category.assoc]
    exact congrArg (segreCoverFst R i j ≫ ·)
      (awayι_toSpecCoeff _ ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R i)) one_pos)
  -- Expand the chosen coefficient map to apply the chart structure-map equation hbase.
  change ((Scheme.ΓSpecIso (.of R)).inv ≫
    ((segreCover R σ τ).f (i, j) ≫ pullback.fst _ _ ≫
      toSpecCoeff (homogeneousSubmodule σ R)).appTop).hom r = _
  rw [hbase, Scheme.Hom.comp_appTop, ← Category.assoc,
    ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  exact (segreChartSections_left R i j
    (algebraMap R (Away (homogeneousSubmodule σ R) (X i)) r)).symm

private theorem segreChartEval_eq (i : σ) (j : τ) :
    segreChartEval R i j =
      (segreChartSections R i j).comp (segreTensorEval R i j).toRingHom := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simpa [segreChartEval, segreTensorEval] using segreChartCoeff_eq R i j r
  · intro s
    simp only [segreChartEval, eval₂Hom_X', RingHom.comp_apply,
      segreTensorEval, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_X]
    exact (segreChartSections_tmul R i j (awayXRatio i s.1) (awayXRatio j s.2)).symm

private theorem tensorProductChart_eq_segreChart (i : σ) (j : τ)
    (hA : Spec.map (CommRingCat.ofHom
      (algebraMap R (Away (homogeneousSubmodule σ R) (X i)))) ≫ 𝟙 _ =
        awayι _ (X i) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R i)) one_pos ≫
          toSpecCoeff (homogeneousSubmodule σ R))
    (hB : Spec.map (CommRingCat.ofHom
      (algebraMap R (Away (homogeneousSubmodule τ R) (X j)))) ≫ 𝟙 _ =
        awayι _ (X j) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R j)) one_pos ≫
          toSpecCoeff (homogeneousSubmodule τ R)) :
    TauCeti.AlgebraicGeometry.tensorProductChart (IsPullback.of_hasPullback _ _) hA hB =
      (segreChartIso R i j).inv ≫ (segreCover R σ τ).f (i, j) := by
  apply pullback.hom_ext
  · rw [TauCeti.AlgebraicGeometry.tensorProductChart_fst, Category.assoc,
      ← segreCoverFst_awayι, ← Category.assoc, ← segreChartIso_hom_fst,
      Iso.inv_hom_id_assoc]
  · rw [TauCeti.AlgebraicGeometry.tensorProductChart_snd, Category.assoc,
      ← segreCoverSnd_awayι, ← Category.assoc, ← segreChartIso_hom_snd,
      Iso.inv_hom_id_assoc]

/-- On a tensor-product coordinate chart, the Segre morphism is induced by the pairwise
products of normalized coordinates. -/
@[reassoc]
theorem tensorProductChart_segre (i : σ) (j : τ) :
    TauCeti.AlgebraicGeometry.tensorProductChart
      (IsPullback.of_hasPullback (toSpecCoeff (homogeneousSubmodule σ R))
        (toSpecCoeff (homogeneousSubmodule τ R)))
      (iA := awayι _ (X i) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R i)) one_pos)
      (iB := awayι _ (X j) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R j)) one_pos)
      (iC := 𝟙 _) (by rw [Category.comp_id, awayι_toSpecCoeff])
      (by rw [Category.comp_id, awayι_toSpecCoeff]) ≫ segre (σ := σ) (τ := τ) R =
        Spec.map (CommRingCat.ofHom (Away.lift (homogeneousSubmodule (σ × τ) R)
          (segreTensorEval R i j).toRingHom (by simp [← Algebra.TensorProduct.one_def]))) ≫
            awayι _ (X (i, j)) ((mem_homogeneousSubmodule _ _).mpr
              (isHomogeneous_X R (i, j))) one_pos := by
  have hsections : (segreChartIso R i j).inv.appTop.hom.comp
      (segreChartSections R i j) =
        (Scheme.ΓSpecIso (.of (Away (homogeneousSubmodule σ R) (X i) ⊗[R]
          Away (homogeneousSubmodule τ R) (X j)))).inv.hom := by
    apply RingHom.ext
    intro a
    -- The section map is pullback along the chart isomorphism, so its inverse cancels it.
    change (((Scheme.ΓSpecIso _).inv ≫ (segreChartIso R i j).hom.appTop) ≫
      (segreChartIso R i j).inv.appTop).hom a = _
    rw [Category.assoc, ← Scheme.Hom.comp_appTop, Iso.inv_hom_id,
      Scheme.Hom.id_appTop, Category.comp_id]
  rw [tensorProductChart_eq_segreChart, Category.assoc, segreCover_f_segre, segreChartHom,
    fromOfGlobalSections_naturality]
  simp only [segreChartEval_eq, ← RingHom.comp_assoc, hsections]
  apply fromOfGlobalSections_Spec_eq_awayLift
  rw [irrelevant_eq_span_X, Ideal.map_span, ← Set.range_comp, Ideal.eq_top_iff_one]
  exact Ideal.subset_span ⟨(i, j), by simp [← Algebra.TensorProduct.one_def]⟩

private theorem segreChartEval_surjective (i : σ) (j : τ) :
    Function.Surjective (segreChartEval R i j) := by
  have : IsIso (segreChartIso R i j).hom.appTop :=
    Scheme.Γ.map_isIso (segreChartIso R i j).hom.op
  have hiso : IsIso ((Scheme.ΓSpecIso _).inv ≫ (segreChartIso R i j).hom.appTop) :=
    inferInstance
  have hs : Function.Surjective (segreChartSections R i j) :=
    ((ConcreteCategory.isIso_iff_bijective _).mp hiso).2
  rw [segreChartEval_eq]
  exact hs.comp (segreTensorEval_surjective R i j)

private noncomputable def segreChartMap (i : σ) (j : τ) :
    (segreCover R σ τ).X (i, j) ⟶
      Spec (.of (Away (homogeneousSubmodule (σ × τ) R) (X (i, j)))) :=
  ((segreCover R σ τ).X (i, j)).toSpecΓ ≫
    Spec.map (CommRingCat.ofHom (Away.lift (homogeneousSubmodule (σ × τ) R)
      (segreChartEval R i j) (by simp [segreChartEval])))

private instance isClosedImmersion_segreChartMap (i : σ) (j : τ) :
    IsClosedImmersion (segreChartMap R i j) := by
  have hs : Function.Surjective (Away.lift (homogeneousSubmodule (σ × τ) R)
      (segreChartEval R i j) (f := X (i, j)) (by simp [segreChartEval])) :=
    (segreChartEval R i j).lift_surjective_of_eval_surjective (i, j)
      (by simp [segreChartEval]) (segreChartEval_surjective R i j)
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Away.lift
      (homogeneousSubmodule (σ × τ) R) (segreChartEval R i j)
      (f := X (i, j)) (by simp [segreChartEval])))) :=
    IsClosedImmersion.spec_of_surjective _ hs
  unfold segreChartMap
  infer_instance

@[reassoc]
private theorem segreChartMap_awayι (i : σ) (j : τ) :
    segreChartMap R i j ≫ awayι _ (X (i, j)) ((mem_homogeneousSubmodule _ _).mpr
      (isHomogeneous_X R (i, j))) one_pos =
      segreChartHom R i j := by
  simpa only [segreChartMap, segreChartHom, Category.assoc] using
    (fromOfGlobalSections_eq_toSpecΓ_awayLift (𝒜 := homogeneousSubmodule (σ × τ) R)
      (segreChartEval R i j)
    (segreChartEval_irrelevant R i j) one_pos ((mem_homogeneousSubmodule _ _).mpr
      (isHomogeneous_X R (i, j)))
    (by simp [segreChartEval])).symm

private theorem segreCover_f_preimage_inf (i k : σ) (j l : τ) :
    (segreCover R σ τ).f (i, j) ⁻¹ᵁ
      (pullback.fst (toSpecCoeff (homogeneousSubmodule σ R))
          (toSpecCoeff (homogeneousSubmodule τ R)) ⁻¹ᵁ
        basicOpen (homogeneousSubmodule σ R) (X k) ⊓
      pullback.snd (toSpecCoeff (homogeneousSubmodule σ R))
        (toSpecCoeff (homogeneousSubmodule τ R)) ⁻¹ᵁ basicOpen (homogeneousSubmodule τ R) (X l)) =
      ((segreCover R σ τ).X (i, j)).basicOpen (segreChartSection R i j (k, l)) := by
  -- Distribute preimage over intersection and express the two iterated preimages as composites.
  change (((segreCover R σ τ).f (i, j) ≫ pullback.fst _ _) ⁻¹ᵁ _) ⊓
    (((segreCover R σ τ).f (i, j) ≫ pullback.snd _ _) ⁻¹ᵁ _) = _
  rw [← segreCoverFst_awayι, ← segreCoverSnd_awayι,
    preimage_basicOpen_X, preimage_basicOpen_X, ← Scheme.basicOpen_mul]
  rfl

private theorem segreCover_f_preimage_segre (i k : σ) (j l : τ) :
    (segreCover R σ τ).f (i, j) ⁻¹ᵁ
      (segre (σ := σ) (τ := τ) R ⁻¹ᵁ
        basicOpen (homogeneousSubmodule (σ × τ) R) (X (k, l))) =
      ((segreCover R σ τ).X (i, j)).basicOpen (segreChartSection R i j (k, l)) := by
  rw [← Scheme.Hom.comp_preimage, segreCover_f_segre, segreChartHom,
    fromOfGlobalSections_preimage_basicOpen _ _ _ one_pos ((mem_homogeneousSubmodule _ _).mpr
      (isHomogeneous_X R (k, l)))]
  simp only [segreChartEval, eval₂Hom_X']

/-- The inverse image of the product coordinate chart is the intersection
of the two corresponding factor charts. -/
theorem segre_preimage_basicOpen (k : σ) (l : τ) :
    segre (σ := σ) (τ := τ) R ⁻¹ᵁ
        basicOpen (homogeneousSubmodule (σ × τ) R) (X (k, l)) =
      pullback.fst (toSpecCoeff (homogeneousSubmodule σ R))
          (toSpecCoeff (homogeneousSubmodule τ R)) ⁻¹ᵁ
        basicOpen (homogeneousSubmodule σ R) (X k) ⊓
      pullback.snd (toSpecCoeff (homogeneousSubmodule σ R))
        (toSpecCoeff (homogeneousSubmodule τ R)) ⁻¹ᵁ basicOpen (homogeneousSubmodule τ R) (X l)
          := by
  apply TopologicalSpace.Opens.ext
  apply Set.ext
  intro x
  obtain ⟨y, hy⟩ := (segreCover R σ τ).covers x
  rw [← hy]
  have he := (segreCover_f_preimage_segre R ((segreCover R σ τ).idx x).1 k
      ((segreCover R σ τ).idx x).2 l).trans
    (segreCover_f_preimage_inf R ((segreCover R σ τ).idx x).1 k
      ((segreCover R σ τ).idx x).2 l).symm
  exact Iff.of_eq (congrArg (fun U ↦ y ∈ U) he)

private theorem opensRange_segreCover_f (i : σ) (j : τ) :
    ((segreCover R σ τ).f (i, j)).opensRange =
      pullback.fst (toSpecCoeff (homogeneousSubmodule σ R))
          (toSpecCoeff (homogeneousSubmodule τ R)) ⁻¹ᵁ
        basicOpen (homogeneousSubmodule σ R) (X i) ⊓
      pullback.snd (toSpecCoeff (homogeneousSubmodule σ R))
        (toSpecCoeff (homogeneousSubmodule τ R)) ⁻¹ᵁ basicOpen (homogeneousSubmodule τ R) (X j)
          := by
  have h := Scheme.Pullback.opensRange_map (toSpecCoeff (homogeneousSubmodule σ R))
    (toSpecCoeff (homogeneousSubmodule τ R))
    (awayι _ (X i) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R i)) one_pos)
    (awayι _ (X j) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R j)) one_pos)
  apply TopologicalSpace.Opens.ext
  rw [Scheme.Hom.coe_opensRange, Scheme.Pullback.openCoverOfLeftRight_f]
  exact congrArg (fun U : (pullback (toSpecCoeff (homogeneousSubmodule σ R))
    (toSpecCoeff (homogeneousSubmodule τ R))).Opens ↦ U.carrier)
    (by simpa only [opensRange_awayι] using h)

/-- The Segre morphism is a closed immersion over every coefficient ring. -/
instance isClosedImmersion_segre : IsClosedImmersion (segre (σ := σ) (τ := τ) R) := by
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
    (fun s : σ × τ ↦ basicOpen (homogeneousSubmodule (σ × τ) R) (X s))
    (iSup_basicOpen_eq_top _ _ (irrelevant_eq_span_X (σ × τ) R).le) ?_
  rintro ⟨i, j⟩
  let e := Scheme.Hom.morphismRestrictArrowIso (segre (σ := σ) (τ := τ) R) (segreChartMap R i j)
    ((segreCover_f_segre R i j).trans (segreChartMap_awayι R i j).symm)
    (by rw [opensRange_awayι, segre_preimage_basicOpen, opensRange_segreCover_f])
  have h : IsClosedImmersion (segre (σ := σ) (τ := τ) R ∣_
      (awayι _ (X (i, j)) ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X R (i, j)))
        one_pos).opensRange) :=
    (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion e).mpr inferInstance
  rwa [opensRange_awayι] at h

/-- The Segre morphism respects the coefficient-ring structure maps. -/
@[reassoc]
theorem segre_toSpecCoeff :
    segre (σ := σ) (τ := τ) R ≫ toSpecCoeff (homogeneousSubmodule (σ × τ) R) =
      pullback.fst (toSpecCoeff (homogeneousSubmodule σ R))
        (toSpecCoeff (homogeneousSubmodule τ R)) ≫ toSpecCoeff (homogeneousSubmodule σ R) := by
  refine (segreCover R σ τ).hom_ext _ _ ?_
  -- The cover hom-ext goal is indexed by coordinate pairs, allowing the chart equations below.
  change ∀ s : σ × τ, (segreCover R σ τ).f s ≫
    segre (σ := σ) (τ := τ) R ≫ toSpecCoeff (homogeneousSubmodule (σ × τ) R) =
      (segreCover R σ τ).f s ≫ pullback.fst _ _ ≫ toSpecCoeff (homogeneousSubmodule σ R)
  rintro ⟨i, j⟩
  rw [← Category.assoc]
  refine (congrArg (fun f ↦ f ≫ toSpecCoeff (homogeneousSubmodule (σ × τ) R))
    (segreCover_f_segre R i j)).trans ?_
  rw [← segreChartMap_awayι R i j, Category.assoc, awayι_toSpecCoeff]
  unfold segreChartMap
  rw [Category.assoc, ← Spec.map_comp]
  have h : CommRingCat.ofHom (algebraMap R
        (Away (homogeneousSubmodule (σ × τ) R) (X (i, j)))) ≫
      CommRingCat.ofHom (Away.lift (homogeneousSubmodule (σ × τ) R)
        (segreChartEval R i j) (by simp [segreChartEval])) =
        CommRingCat.ofHom (segreChartCoeff R i j) := by
    ext r
    -- Degree-zero scalar transport exposes the argument of the localization scalar law.
    change Away.lift _ (segreChartEval R i j) (by simp [segreChartEval])
      (algebraMap (homogeneousSubmodule (σ × τ) R 0)
        (Away (homogeneousSubmodule (σ × τ) R) (X (i, j)))
        (algebraMap R (homogeneousSubmodule (σ × τ) R 0) r)) = _
    rw [Away.lift_algebraMap]
    simp [segreChartEval]
  rw [h]
  -- Reassociate the cover map with the structure map before using the chosen coefficient map.
  change _ = (segreCover R σ τ).f (i, j) ≫
    pullback.fst _ _ ≫ toSpecCoeff (homogeneousSubmodule σ R)
  -- The coefficient map is the global-sections pullback; toSpecΓ naturality compares its map.
  change ((segreCover R σ τ).X (i, j)).toSpecΓ ≫
    Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫
      ((segreCover R σ τ).f (i, j) ≫ pullback.fst _ _ ≫
        toSpecCoeff (homogeneousSubmodule σ R)).appTop) = _
  rw [Spec.map_comp, ← Scheme.toSpecΓ_naturality_assoc,
    toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]

end AlgebraicGeometry.Proj
