module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
public import TauCeti.LinearAlgebra.SymmetricAlgebra.GradedMap
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Grading
public import TauCeti.RingTheory.GradedAlgebra.Homogeneous.Maps
import TauCeti.RingTheory.GradedAlgebra.HomogeneousLocalization.Basic

/-!
# Surjective graded ring homomorphisms induce closed immersions of `Proj`

A surjective homomorphism `f : A →+* B` of `ℕ`-graded rings preserving degrees induces a closed
immersion `Proj B ⟶ Proj A`: the projective spectrum of a graded quotient is a closed subscheme.
On the standard chart `D₊(s)` of `Proj A`, for `s` homogeneous of positive degree, the morphism
`Proj.map f` restricts to `Spec B_{(f s)} ⟶ Spec A_{(s)}`, which is `Spec` of the induced map of
homogeneous localizations, and that map is surjective
(`HomogeneousLocalization.Away.map_surjective`). Being a closed immersion is local on the target.

In particular, a graded `R`-algebra `A` generated by its degree-one part is a graded quotient of
the symmetric algebra `Sym_R M` of any module `M` mapping onto a generating set of degree-one
elements (`SymmetricAlgebra.gradedLift`), so `Proj A` is a closed subscheme of the projective space
`Proj (Sym_R M)`. When `M` is a finite `R`-module, `Proj (Sym_R M)` is proper over `Spec R`
(`TauCeti.SymmetricAlgebra.projToSpec`). This is how the projective spectrum of a graded algebra
generated in degree one, for instance a section ring of a divisor on a curve after passing to a
Veronese subring, becomes a closed subscheme of a projective space.

## Main results

* `AlgebraicGeometry.Proj.isClosedImmersion_map`: `Proj.map f` is a closed immersion for every
  surjective graded ring homomorphism `f`.
* `AlgebraicGeometry.Proj.isClosedImmersion_map_gradedLift`: if degree-one elements `f m`,
  `m ∈ M`, generate a graded `R`-algebra `A`, then `Proj A` is a closed subscheme of
  `Proj (Sym_R M)`.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Exercise II.3.12(a).
-/

public section

open CategoryTheory HomogeneousLocalization

namespace AlgebraicGeometry.Proj

universe u

variable {A B σ τ : Type u} [CommRing A] [CommRing B] [SetLike σ A] [SetLike τ B]
  [AddSubgroupClass σ A] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]

/-- **A surjective graded ring homomorphism induces a closed immersion of projective spectra**:
if `f : 𝒜 →+*ᵍ ℬ` is surjective, then `Proj.map f : Proj ℬ ⟶ Proj 𝒜` is a closed immersion. The
containment `ℬ₊ ≤ 𝒜₊.map f` needed to form `Proj.map f` always holds for a surjective `f`
(`HomogeneousIdeal.irrelevant_le_map_of_surjective`). -/
theorem isClosedImmersion_map (f : 𝒜 →+*ᵍ ℬ)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f)
    (hsurj : Function.Surjective f) : IsClosedImmersion (map f hf) := by
  -- the standard charts `D₊(s)`, for `s` homogeneous of positive degree, cover `Proj 𝒜`
  have hU : ⨆ s : Σ i : ℕ+, 𝒜 i, basicOpen 𝒜 (s.2 : A) = ⊤ :=
    (iSup_congr fun s ↦ (opensRange_awayι 𝒜 _ s.2.2 s.1.pos).symm).trans
      (affineOpenCover 𝒜).openCover.iSup_opensRange
  refine IsZariskiLocalAtTarget.of_iSup_eq_top _ hU fun ⟨i, s, hs⟩ ↦ ?_
  -- over `D₊(s)`, the morphism is the restriction `D₊(f s) ⟶ D₊(s)`
  rw [← Scheme.Hom.resLE_eq_morphismRestrict,
    Scheme.Hom.resLE_congr (e₁ := rfl) (e₂ := map_preimage_basicOpen f hf s)
      (P := @IsClosedImmersion)]
  -- in the charts `D₊(f s) ≅ Spec B_{(f s)}` and `D₊(s) ≅ Spec A_{(s)}`, it is `Spec` of the
  -- induced map of homogeneous localizations
  have key : (basicOpenIsoSpec ℬ (f s) (Graded.map_mem f hs) i.pos).inv ≫
      (map f hf).resLE (basicOpen 𝒜 s) (basicOpen ℬ (f s)) (map_preimage_basicOpen f hf s).ge ≫
        (basicOpenIsoSpec 𝒜 s hs i.pos).hom = Spec.map (CommRingCat.ofHom (Away.map f s)) := by
    rw [← cancel_mono (awayι 𝒜 s hs i.pos), ← awayι_comp_map f hf i.pos s hs,
      ← basicOpenIsoSpec_inv_ι, ← basicOpenIsoSpec_inv_ι, Category.assoc, Category.assoc,
      Iso.hom_inv_id_assoc, Scheme.Hom.resLE_comp_ι, Category.assoc]
  have := IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (Away.map f s))
    (Away.map_surjective hsurj hs)
  rw [← key, MorphismProperty.cancel_left_of_respectsIso (P := @IsClosedImmersion),
    MorphismProperty.cancel_right_of_respectsIso (P := @IsClosedImmersion)] at this
  exact this

/-- **A graded algebra generated in degree one is a closed subscheme of a projective space**: if
`f : M →ₗ[R] 𝒜 1` is a linear map whose values generate the graded `R`-algebra `A` as an
`R`-algebra, then the projective spectrum of `A` is a closed subscheme of `Proj (Sym_R M)`, via
the morphism induced by the graded lift `Sym_R M → A` of `f`. -/
theorem isClosedImmersion_map_gradedLift {R M : Type u} [CommRing R] [AddCommMonoid M]
    [Module R M] [Algebra R A] (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {f : M →ₗ[R] 𝒜 1}
    (hf : Algebra.adjoin R (Set.range fun m ↦ (f m : A)) = ⊤) :
    IsClosedImmersion (map (SymmetricAlgebra.gradedLift R 𝒜 f)
      (HomogeneousIdeal.irrelevant_le_map_of_surjective _
        (SymmetricAlgebra.gradedLift_surjective R 𝒜 hf))) :=
  isClosedImmersion_map _ _ (SymmetricAlgebra.gradedLift_surjective R 𝒜 hf)

end AlgebraicGeometry.Proj
