module

public import TauCeti.AlgebraicGeometry.IdealSheaf.Regular
public import Mathlib.AlgebraicGeometry.Morphisms.Immersion

/-!
# Regular immersions

An immersion `i : X ⟶ Y` is a *regular immersion of codimension `d`*
(`Scheme.Hom.IsRegularImmersion`) if the ideal sheaf of the closed immersion `X ⟶ U` into the
largest open `U = i.coborderRange` of `Y` in which `X` is closed is regular of codimension `d`
(Stacks, Tag 063J; Fulton, Appendix B.7). For a closed immersion `U = Y`, and `i` is a regular
immersion of codimension `d` exactly when its ideal sheaf `i.ker` is regular of codimension `d`
(`isRegularImmersion_iff_of_isClosedImmersion`).

## Main definitions

* `AlgebraicGeometry.Scheme.Hom.IsRegularImmersion i d`: the immersion `i` is a regular immersion
  of codimension `d`, with its characterization `isRegularImmersion_iff`.

## Main results

* `AlgebraicGeometry.Scheme.Hom.isRegularImmersion_iff_of_isClosedImmersion`: a closed immersion
  is a regular immersion of codimension `d` exactly when its ideal sheaf is regular of
  codimension `d`.
* `AlgebraicGeometry.Scheme.Hom.isRegularImmersion_zero_of_isIso`: an isomorphism, for instance
  the identity, is a regular immersion of codimension zero.
* `AlgebraicGeometry.Scheme.Hom.isRegularImmersion_of_isEmpty`: an immersion with empty source is
  a regular immersion of every codimension.

## References

* [The Stacks Project, Tag 063J](https://stacks.math.columbia.edu/tag/063J)
* W. Fulton, *Intersection Theory*, 2nd ed., Appendix B.7.
-/

public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme.Hom

variable {X Y : Scheme.{u}}

/-- An immersion `i : X ⟶ Y` is a *regular immersion of codimension `d`* if the ideal sheaf of
the closed immersion `i.liftCoborder : X ⟶ i.coborderRange`, into the largest open of `Y` in which
`X` is closed, is regular of codimension `d`: locally on `i.coborderRange` around `X` it is
generated by a regular sequence of length `d` (Stacks, Tag 063J). For a closed immersion,
`i.coborderRange` is all of `Y`. -/
def IsRegularImmersion (i : X ⟶ Y) [IsImmersion i] (d : ℕ) : Prop :=
  i.liftCoborder.ker.IsLocallyRegular d

/-- `i` is a regular immersion of codimension `d` exactly when the ideal sheaf of
`i.liftCoborder` is regular of codimension `d`. -/
theorem isRegularImmersion_iff {i : X ⟶ Y} [IsImmersion i] {d : ℕ} :
    i.IsRegularImmersion d ↔ i.liftCoborder.ker.IsLocallyRegular d :=
  Iff.rfl

/-- A closed immersion `i` is a regular immersion of codimension `d` exactly when its ideal sheaf
`i.ker` is regular of codimension `d`. -/
theorem isRegularImmersion_iff_of_isClosedImmersion {i : X ⟶ Y} [IsClosedImmersion i] {d : ℕ} :
    i.IsRegularImmersion d ↔ i.ker.IsLocallyRegular d := by
  -- `X` is closed in `Y`, so `i.coborderRange` is all of `Y` and its inclusion is an isomorphism.
  have htop : i.coborderRange = ⊤ :=
    TopologicalSpace.Opens.ext i.isClosedEmbedding.isClosed_range.coborder_eq
  have : IsIso i.coborderRange.ι := by rw [htop, ← Scheme.topIso_hom]; infer_instance
  -- `i.liftCoborder` is the pullback of `i` along `i.coborderRange.ι`.
  have hker : i.liftCoborder.ker = i.ker.comap i.coborderRange.ι := by
    rw [Scheme.Hom.liftCoborder, ← IdealSheafData.ker_fst_of_isClosedImmersion,
      ← (IsOpenImmersion.isPullback_lift_id i i.coborderRange.ι _).isoPullback_hom_fst,
      Scheme.Hom.ker_comp_of_isIso]
  rw [isRegularImmersion_iff, hker, IdealSheafData.isLocallyRegular_comap_iff_of_isIso]

/-- **An isomorphism is a regular immersion of codimension zero**: its ideal sheaf is zero. -/
theorem isRegularImmersion_zero_of_isIso (i : X ⟶ Y) [IsIso i] : i.IsRegularImmersion 0 := by
  rw [isRegularImmersion_iff_of_isClosedImmersion, i.ker_eq_bot_of_isIso]
  exact IdealSheafData.isLocallyRegular_bot

/-- **An immersion with empty source is a regular immersion of every codimension**: its ideal sheaf
has empty support, so the condition is vacuous. -/
theorem isRegularImmersion_of_isEmpty (i : X ⟶ Y) [IsImmersion i] [IsEmpty X] (d : ℕ) :
    i.IsRegularImmersion d := by
  refine IdealSheafData.isLocallyRegular_of_support_eq_bot ?_ d
  refine SetLike.coe_injective ?_
  rw [Scheme.Hom.support_ker, Set.range_eq_empty, closure_empty]
  rfl

end AlgebraicGeometry.Scheme.Hom
