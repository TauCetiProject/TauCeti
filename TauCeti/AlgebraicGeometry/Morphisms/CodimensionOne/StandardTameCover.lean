/-!
# Ramification of standard covers in codimension one

Let `f` be a nonzerodivisor in a Noetherian ring `A` with `A/(f)` reduced. Adjoining
an `e`-th root of `f` for an exponent invertible in `A` gives a cover of
`D(f)` that is tamely ramified in codimension one over `Spec A`. If `f` is not a unit, the cover
is unramified in codimension one only for `e = 1`, since adjoining an `e`-th root of `f` has
ramification index `e` at the minimal primes of `(f)`.

At a codimension-one point `ξ ∉ D(f)`, the local ring `𝒪_{Spec A, ξ}` is a discrete valuation
ring with uniformizer `f`, and the residue field of every point of the cover over its generic
point is generated by an `e`-th root of `f`. So both statements follow from the Kummer case,
`TauCeti.IsDiscreteValuationRing.isTamelyRamifiedWRT_iff_of_pow_eq_of_irreducible` and
`TauCeti.IsDiscreteValuationRing.isUnramifiedWRT_iff_of_pow_eq_of_irreducible`.

## Main results

* `TauCeti.AlgebraicGeometry.standardTameCover_isTamelyRamifiedInCodimOne`: for `e` invertible in
  `A`, the standard cover of `D(f)` is tamely ramified over `Spec A` in codimension one.
* `TauCeti.AlgebraicGeometry.standardTameCover_isUnramifiedInCodimOne_iff`: for `f` not a unit and
  `e ≠ 0`, the standard cover of `D(f)` is unramified over `Spec A` in codimension one iff `e = 1`.

## References

* [Stacks Project, Example 58.31.4](https://stacks.math.columbia.edu/tag/0EYF).
-/

public section

open CategoryTheory AlgebraicGeometry Polynomial IntermediateField

namespace TauCeti.AlgebraicGeometry

universe u

variable {A : Type u} [CommRing A]

/-- At a codimension-one point `ξ ∉ D(f)` and a point `y` of the restricted standard cover whose
image generizes `ξ`, the residue field `κ(y)` is generated over the fraction field of the discrete
valuation ring `𝒪_{Spec A, ξ}` by an `e`-th root of a uniformizer. So `κ(y)` is tamely ramified
with respect to `𝒪_{Spec A, ξ}` iff `e` is invertible in its residue field, and unramified iff
`e = 1`. -/
private theorem isTamelyRamifiedWRT_iff_and_isUnramifiedWRT_iff [IsNoetherianRing A]
    {f : A} (hf : f ∈ nonZeroDivisors A) [IsReduced (A ⧸ Ideal.span {f})] {e : ℕ}
    {p : Spec (.of (standardTameCover A f e)) ⟶ Spec (.of A)}
    (hp : p = Spec.map (CommRingCat.ofHom (algebraMap A (standardTameCover A f e))))
    {U : (Spec (.of A)).Opens} (hU : U = PrimeSpectrum.basicOpen f)
    (ξ : CodimensionOnePoint (Spec (.of A))) (hξ : (ξ : Spec (.of A)) ∉ U) (y : (p ⁻¹ᵁ U).toScheme)
    (sp : (p ∣_ U ≫ U.ι) y ⤳ ξ) :
    letI := ((Spec (.of A)).presheaf.stalkSpecializes sp ≫ (Spec (.of A)).residue _ ≫
      (p ∣_ U ≫ U.ι).residueFieldMap y).hom.toAlgebra
    (TauCeti.Algebra.IsTamelyRamifiedWRT ((Spec (.of A)).presheaf.stalk ξ)
        ((p ⁻¹ᵁ U).toScheme.residueField y) ↔
      IsUnit ((e : ℕ) : (Spec (.of A)).presheaf.stalk ξ ⧸
        IsLocalRing.maximalIdeal ((Spec (.of A)).presheaf.stalk ξ))) ∧
    (TauCeti.Algebra.IsUnramifiedWRT ((Spec (.of A)).presheaf.stalk ξ)
        ((p ⁻¹ᵁ U).toScheme.residueField y) ↔ e = 1) := by
  subst hp hU
  let S := Spec (.of A)
  let p := Spec.map (CommRingCat.ofHom (algebraMap A (standardTameCover A f e)))
  let U : S.Opens := PrimeSpectrum.basicOpen f
  let q := (p ∣_ U) ≫ U.ι
  let g := (p ⁻¹ᵁ U).ι
  have hq : g ≫ p = q := (morphismRestrict_ι p U).symm
  -- The reduced divisor makes its codimension-one local ring a DVR.
  let R := S.presheaf.stalk ξ
  let : Algebra A R := StructureSheaf.stalkAlgebra A ξ.val
  have : (ξ : Spec (.of A)).asIdeal.IsPrime := ξ.val.isPrime
  have : IsLocalization.AtPrime R ξ.val.asIdeal := StructureSheaf.IsLocalization.to_stalk A ξ.val
  have hmin : ξ.val.asIdeal ∈ (Ideal.span {f}).minimalPrimes :=
    Ideal.mem_minimalPrimes_of_height_le ((Ideal.span_singleton_le_iff_mem _).2 (not_not.mp hξ))
      (by rw [(idealHeight_eq_coheight (.of A) ξ).trans ξ.property]
          exact Ideal.one_le_height_span_singleton_of_mem_nonZeroDivisors hf)
  have : IsRegularLocalRing R := isRegularLocalRing_of_mem_minimalPrimes R hf hmin
  have : IsDiscreteValuationRing R := CodimensionOnePoint.isDiscreteValuationRing_stalk ξ
  -- Specialization gives the fraction field `K` of `R` and its extension to `L`.
  let K := S.residueField (q y)
  let L := (p ⁻¹ᵁ U : Scheme).residueField y
  let : Algebra R K := (S.presheaf.stalkSpecializes sp ≫ S.residue _).hom.toAlgebra
  let : Algebra K L := (q.residueFieldMap y).hom.toAlgebra
  let : Algebra R L :=
    (S.presheaf.stalkSpecializes sp ≫ S.residue _ ≫ q.residueFieldMap y).hom.toAlgebra
  have : IsScalarTower R K L := .of_algebraMap_eq fun _ ↦ by
    simp only [RingHom.algebraMap_toAlgebra, CommRingCat.hom_comp, RingHom.comp_apply]
  have hne : q y ≠ ξ := fun eq ↦ hξ (eq ▸ ((p ∣_ U) y).property)
  have : IsFractionRing R K := Scheme.isFractionRing_residueField_of_specializes sp hne
  let φ := ((Scheme.ΓSpecIso _).inv ≫ (Spec _).Γevaluation (g y) ≫ g.residueFieldMap y).hom
  -- The root generates `L` over `K`, with its power equal to the local parameter.
  have hα : φ (AdjoinRoot.root (X ^ e - C f)) ^ e = algebraMap R L (algebraMap A R f) := by
    rw [← map_pow, AdjoinRoot.root_X_pow_sub_C_pow, ← AdjoinRoot.algebraMap_eq]
    have hnat : φ (algebraMap A _ f) = q.residueFieldMap y
        (((Scheme.ΓSpecIso (.of A)).inv ≫ S.Γevaluation (q y)) f) :=
      congr($(g.Γevaluation_naturality_of_Spec _ hq y).hom f)
    rw [Scheme.Spec.Γevaluation_eq_toStalk_stalkSpecializes (.of A) sp] at hnat
    have hstalk : algebraMap A R f = StructureSheaf.toStalk A ξ.val f :=
      StructureSheaf.stalkAlgebra_map A ξ.val f
    -- The stalk maps use both scheme and structure-sheaf carriers, matched by using!.
    simpa only [RingHom.algebraMap_toAlgebra, CommRingCat.hom_comp, RingHom.comp_apply,
      CommRingCat.comp_apply, hstalk] using! hnat
  have hgen : K⟮φ (AdjoinRoot.root (X ^ e - C f))⟯ = ⊤ := by
    simpa only [Set.image_singleton] using
      g.adjoin_residueField_eq_top_of_isIso_residueFieldMap hq y
        (AdjoinRoot.adjoinRoot_eq_top (f := X ^ e - C f))
  have hπ := irreducible_algebraMap_of_mem_minimalPrimes R hf hmin
  exact ⟨IsDiscreteValuationRing.isTamelyRamifiedWRT_iff_of_pow_eq_of_irreducible hπ hα hgen,
    IsDiscreteValuationRing.isUnramifiedWRT_iff_of_pow_eq_of_irreducible hπ hα hgen⟩

/-- If `f` is a nonzerodivisor with reduced principal quotient and `e` is invertible in `A`,
the standard root cover restricted to `D(f)` is tamely ramified over `Spec A` in codimension
one. -/
@[stacks 0EYF "tameness in codimension one"]
theorem standardTameCover_isTamelyRamifiedInCodimOne [IsNoetherianRing A]
    {f : A} (hf : f ∈ nonZeroDivisors A) [IsReduced (A ⧸ Ideal.span {f})]
    {e : ℕ} (heunit : IsUnit (e : A)) :
    (Spec.map (CommRingCat.ofHom (algebraMap A (standardTameCover A f e))) ∣_
      PrimeSpectrum.basicOpen f).IsTamelyRamifiedInCodimOne := by
  refine (Scheme.Hom.isTamelyRamifiedInCodimOne_def _).mpr fun ξ hξ y sp ↦
    (isTamelyRamifiedWRT_iff_and_isUnramifiedWRT_iff hf rfl rfl ξ hξ y sp).1.mpr ?_
  let : Algebra A ((Spec (.of A)).presheaf.stalk ξ) := StructureSheaf.stalkAlgebra A ξ.val
  simpa only [map_natCast] using (heunit.map (algebraMap A ((Spec (.of A)).presheaf.stalk ξ))).map
    (Ideal.Quotient.mk (IsLocalRing.maximalIdeal _))

/-- **A standard cover is unramified in codimension one only for `e = 1`.** Let `f` be a nonunit
nonzerodivisor of a Noetherian ring `A` with `A/(f)` reduced, and `e ≠ 0`. The standard root cover
`A[x]/(x^e − f)` restricted to `D(f)` is unramified over `Spec A` in codimension one iff `e = 1`.
So for `e ≥ 2` invertible in `A` the cover is tamely ramified in codimension one
(`TauCeti.AlgebraicGeometry.standardTameCover_isTamelyRamifiedInCodimOne`) but not unramified. -/
theorem standardTameCover_isUnramifiedInCodimOne_iff [IsNoetherianRing A]
    {f : A} (hf : f ∈ nonZeroDivisors A) (hfu : ¬IsUnit f) [IsReduced (A ⧸ Ideal.span {f})]
    {e : ℕ} (he : e ≠ 0) :
    (Spec.map (CommRingCat.ofHom (algebraMap A (standardTameCover A f e))) ∣_
      PrimeSpectrum.basicOpen f).IsUnramifiedInCodimOne ↔ e = 1 := by
  refine ⟨fun h ↦ ?_, fun he1 ↦ (Scheme.Hom.isUnramifiedInCodimOne_def _).mpr fun ξ hξ y sp ↦
    (isTamelyRamifiedWRT_iff_and_isUnramifiedWRT_iff hf rfl rfl ξ hξ y sp).2.mpr he1⟩
  replace h := (Scheme.Hom.isUnramifiedInCodimOne_def _).mp h
  -- A minimal prime `𝔪` of `(f)` is a codimension-one point outside `D(f)`.
  have : Nontrivial A := not_subsingleton_iff_nontrivial.mp fun _ ↦ hfu (isUnit_of_subsingleton f)
  obtain ⟨𝔪, h𝔪⟩ := (Ideal.span {f}).nonempty_minimalPrimes
    (by rwa [Ne, Ideal.span_singleton_eq_top])
  have : 𝔪.IsPrime := h𝔪.1.1
  have hht : 𝔪.height = 1 := Ideal.height_eq_one_of_mem_minimalPrimes_span_singleton hf h𝔪
  let ξ : CodimensionOnePoint (Spec (.of A)) :=
    ⟨⟨𝔪, this⟩, (idealHeight_eq_coheight (.of A) ⟨𝔪, this⟩).symm.trans hht⟩
  have hξ : (ξ : Spec (.of A)) ∉ PrimeSpectrum.basicOpen f := fun h ↦
    h ((Ideal.span_singleton_le_iff_mem _).mp h𝔪.1.2)
  -- A minimal prime `𝔭 ⊆ 𝔪` of `A` avoids the nonzerodivisor `f`, so lies in `D(f)`.
  obtain ⟨𝔭, h𝔭, h𝔭𝔪⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ 𝔪)
  have h𝔭p : 𝔭.IsPrime := h𝔭.1.1
  have hf𝔭 : f ∉ 𝔭 := fun hf𝔭 ↦
    Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes h𝔭) hf𝔭 hf
  -- The cover is integral and injective, so some point of it lies over `𝔭`.
  have hmonic := monic_X_pow_sub_C f he
  have := AdjoinRoot.isIntegral_of_monic hmonic
  have := AdjoinRoot.faithfulSMul_of_monic_of_degree_pos hmonic
    (by rw [degree_X_pow_sub_C (Nat.pos_of_ne_zero he)]; exact_mod_cast Nat.pos_of_ne_zero he)
  obtain ⟨y, hy⟩ := Algebra.IsIntegral.comap_surjective A (standardTameCover A f e) ⟨𝔭, h𝔭p⟩
  let p := Spec.map (CommRingCat.ofHom (algebraMap A (standardTameCover A f e)))
  let U : (Spec (.of A)).Opens := PrimeSpectrum.basicOpen f
  -- `Spec.map_apply` is applied as a term: `rw` cannot find it, as `y` is typed as a prime.
  have hpy : p y = ⟨𝔭, h𝔭p⟩ := (Spec.map_apply
    (CommRingCat.ofHom (algebraMap A (standardTameCover A f e))) y).trans hy
  have hyU : p y ∈ U := by
    rw [hpy]
    exact hf𝔭
  have hgy : ((p ⁻¹ᵁ U).ι ≫ p) ⟨y, hyU⟩ = ⟨𝔭, h𝔭p⟩ := (Scheme.Hom.comp_apply _ _ _).trans hpy
  have sp : (p ∣_ U ≫ U.ι) ⟨y, hyU⟩ ⤳ (ξ : Spec (.of A)) := by
    rw [morphismRestrict_ι, hgy]
    exact (PrimeSpectrum.le_iff_specializes _ _).mp h𝔭𝔪
  exact (isTamelyRamifiedWRT_iff_and_isUnramifiedWRT_iff hf rfl rfl ξ hξ ⟨y, hyU⟩ sp).2.mp
    (h ξ hξ _ sp)

end TauCeti.AlgebraicGeometry
