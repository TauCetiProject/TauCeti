module

public import Mathlib.FieldTheory.Finite.GaloisField
public import Mathlib.FieldTheory.PurelyInseparable.Basic
public import TauCeti.AlgebraicGeometry.Morphisms.UniversalHomeomorphism.Basic

/-!
# Examples of universal homeomorphisms

This file tests the notion of universal homeomorphism of schemes against the standard examples
and non-examples, using the affine criterion
`TauCeti.AlgebraicGeometry.IsUniversalHomeomorphism.SpecMap_iff`.

* For a field extension `L / K`, the morphism `Spec L ⟶ Spec K` is always a homeomorphism (both
  spaces are points), but it is a universal homeomorphism iff `L / K` is purely inseparable. In
  particular `Spec 𝔽_{p²} ⟶ Spec 𝔽_p` is a homeomorphism that is not a universal one.
* The normalization `Spec k[t] ⟶ Spec k[t², t³]` of the cuspidal cubic is a universal
  homeomorphism, for any commutative ring `k`.
* The normalization `Spec k[t] ⟶ Spec k[t² - 1, t³ - t]` of the nodal cubic over a field in which
  `2 ≠ 0` is not universally injective, hence not a universal homeomorphism: the two points
  `t = 1` and `t = -1` lie over the node.

## References

* [Stacks Project, Section 29.46](https://stacks.math.columbia.edu/tag/04DC), universal
  homeomorphisms.
* [Stacks Project, Lemma 29.10.2](https://stacks.math.columbia.edu/tag/01S4), the field-valued
  criterion for universal injectivity.
-/

public section

open CategoryTheory Polynomial _root_.AlgebraicGeometry

universe u

namespace TauCeti.AlgebraicGeometry

section Field

variable (K L : Type u) [Field K] [Field L] [Algebra K L]

/-- For a field extension `L / K`, the morphism `Spec L ⟶ Spec K` is a homeomorphism: both
spaces are points. -/
theorem isHomeomorph_Spec_algebraMap :
    IsHomeomorph (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
  convert (Homeomorph.homeomorphOfUnique (Spec (.of L)) (Spec (.of K))).isHomeomorph
  exact Subsingleton.elim _ _

/-- For a field extension `L / K`, the morphism `Spec L ⟶ Spec K` is a universal homeomorphism
iff `L / K` is purely inseparable. -/
theorem isUniversalHomeomorphism_Spec_algebraMap_iff :
    IsUniversalHomeomorphism (Spec.map (CommRingCat.ofHom (algebraMap K L))) ↔
      IsPurelyInseparable K L := by
  rw [IsUniversalHomeomorphism.SpecMap_iff, CommRingCat.hom_ofHom]
  refine ⟨fun ⟨_, h, _⟩ ↦ ?_, fun _ ↦ ⟨fun x ↦ Algebra.IsIntegral.isIntegral x,
    fun M _ ↦ IsPurelyInseparable.injective_comp_algebraMap K L M,
    fun _ ↦ ⟨default, Subsingleton.elim _ _⟩⟩⟩
  rw [isPurelyInseparable_iff_subsingleton_emb]
  exact ⟨fun f g ↦ AlgHom.toRingHom_injective <| h (AlgebraicClosure L) <| by
    simp only [AlgHom.comp_algebraMap]⟩

/-- `Spec 𝔽_{p²} ⟶ Spec 𝔽_p` is a homeomorphism (see `isHomeomorph_Spec_algebraMap`) but not a
universal homeomorphism: the extension `𝔽_{p²} / 𝔽_p` is separable of degree `2`, so it is not
purely inseparable. -/
theorem not_isUniversalHomeomorphism_Spec_galoisField_two (p : ℕ) [Fact p.Prime] :
    ¬ IsUniversalHomeomorphism
      (Spec.map (CommRingCat.ofHom (algebraMap (ZMod p) (GaloisField p 2)))) := by
  rw [isUniversalHomeomorphism_Spec_algebraMap_iff]
  intro _
  have hs := IsPurelyInseparable.surjective_algebraMap_of_isSeparable (ZMod p) (GaloisField p 2)
  have := Module.finrank_of_bijective_algebraMap
    ⟨(algebraMap (ZMod p) (GaloisField p 2)).injective, hs⟩
  rw [GaloisField.finrank p two_ne_zero] at this
  exact absurd this (by norm_num)

end Field

section Cusp

variable (k : Type u) [CommRing k]

/-- The normalization `Spec k[t] ⟶ Spec k[t², t³]` of the cuspidal cubic is a universal
homeomorphism, for every commutative ring `k`. -/
theorem isUniversalHomeomorphism_cusp_normalization :
    IsUniversalHomeomorphism (Spec.map (CommRingCat.ofHom
      (algebraMap (Algebra.adjoin k {(X : k[X]) ^ 2, X ^ 3}) k[X]))) := by
  set A := Algebra.adjoin k {(X : k[X]) ^ 2, X ^ 3}
  have h₂ : (X : k[X]) ^ 2 ∈ A := Algebra.subset_adjoin (by simp)
  have h₃ : (X : k[X]) ^ 3 ∈ A := Algebra.subset_adjoin (by simp)
  rw [IsUniversalHomeomorphism.SpecMap_iff, CommRingCat.hom_ofHom]
  have hint : (algebraMap A k[X]).IsIntegral := by
    -- `t` is integral over `A` since `t²` lies in `A`, and `k[t]` is generated by `t` over `k`
    have hX : IsIntegral A (X : k[X]) :=
      IsIntegral.of_pow two_pos (isIntegral_algebraMap (x := (⟨X ^ 2, h₂⟩ : A)))
    have : Algebra.adjoin k {(X : k[X])} ≤ (integralClosure A k[X]).restrictScalars k :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr hX)
    rw [Polynomial.adjoin_X] at this
    exact fun x ↦ (mem_integralClosure_iff A k[X]).mp
      ((Subalgebra.mem_restrictScalars k).mp (this Algebra.mem_top))
  refine ⟨hint, fun K _ g₁ g₂ hg ↦ ?_, hint.comap_surjective Subtype.val_injective⟩
  have hA (a : k[X]) (ha : a ∈ A) : g₁ a = g₂ a := congr($hg ⟨a, ha⟩)
  refine Polynomial.ringHom_ext (fun c ↦ hA _ (Subalgebra.algebraMap_mem A c)) ?_
  -- `g(t)` is determined by `g(t)²` and `g(t)³` in the field `K`
  have e₂ : g₁ X ^ 2 = g₂ X ^ 2 := by simpa using hA _ h₂
  have e₃ : g₁ X ^ 3 = g₂ X ^ 3 := by simpa using hA _ h₃
  by_cases h : g₁ X = 0
  · rw [h, zero_pow two_ne_zero, eq_comm, pow_eq_zero_iff two_ne_zero] at e₂
    rw [h, e₂]
  · have h' : g₁ X ^ 2 ≠ 0 := pow_ne_zero 2 h
    calc g₁ X = g₁ X ^ 3 / g₁ X ^ 2 := by field_simp
      _ = g₂ X ^ 3 / g₂ X ^ 2 := by rw [e₂, e₃]
      _ = g₂ X := by field_simp [e₂ ▸ h']

end Cusp

section Node

variable (k : Type u) [Field k]

/-- The normalization `Spec k[t] ⟶ Spec k[t² - 1, t³ - t]` of the nodal cubic is not universally
injective when `2 ≠ 0` in `k`: the `k`-points `t = 1` and `t = -1` both lie over the node. -/
theorem not_universallyInjective_node_normalization (h2 : (2 : k) ≠ 0) :
    ¬ UniversallyInjective (Spec.map (CommRingCat.ofHom
      (algebraMap (Algebra.adjoin k {(X : k[X]) ^ 2 - 1, X ^ 3 - X}) k[X]))) := by
  set A := Algebra.adjoin k {(X : k[X]) ^ 2 - 1, X ^ 3 - X}
  rw [UniversallyInjective.SpecMap_iff, CommRingCat.hom_ofHom]
  intro h
  -- evaluation at `1` and at `-1` agree on the generators of `A`, hence on `A`
  have hA : A ≤ AlgHom.equalizer (aeval (1 : k)) (aeval (-1 : k)) :=
    Algebra.adjoin_le (by simp [Set.insert_subset_iff]; norm_num)
  have := h k (a₁ := (aeval (1 : k)).toRingHom) (a₂ := (aeval (-1 : k)).toRingHom)
    (RingHom.ext fun a ↦ hA a.2)
  have h1 := congr($this X)
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_X] at h1
  exact h2 (by linear_combination h1)

/-- The normalization `Spec k[t] ⟶ Spec k[t² - 1, t³ - t]` of the nodal cubic is not a universal
homeomorphism when `2 ≠ 0` in `k`. -/
theorem not_isUniversalHomeomorphism_node_normalization (h2 : (2 : k) ≠ 0) :
    ¬ IsUniversalHomeomorphism (Spec.map (CommRingCat.ofHom
      (algebraMap (Algebra.adjoin k {(X : k[X]) ^ 2 - 1, X ^ 3 - X}) k[X]))) :=
  fun _ ↦ not_universallyInjective_node_normalization k h2 inferInstance

end Node

end TauCeti.AlgebraicGeometry
