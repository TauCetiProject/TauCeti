import TauCeti.AlgebraicGeometry.Morphisms.Flat.Basic

/-!
# Quotient sheaves of pre-relations through the graphs of a torsor

Let `q : U ⟶ M` be a morphism of schemes whose kernel pair is a disjoint union of graphs: a family
`ρ : ι → (U ⟶ U)` such that the square with `Sigma.desc (fun _ ↦ 𝟙 U)`, `Sigma.desc ρ` and `q`
is a pullback. Two points `a, b` of `U` with `a ≫ q = b ≫ q` then lie, Zariski locally, on one of
the graphs: locally `b = a ≫ ρ i`. If each `ρ i` is the identity, or comes from a pre-relation
`s t : R ⟶ U` in one of the two directions, the sieve `quotientSheaf.relSieve s t a b` is an
fppf covering (`TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.relSieve_mem_of_isPullback`), and
for an fppf covering `q` the quotient sheaf `U/R` is `h_M`
(`TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.isoOfIsPullback`), by the site-level criterion
`TauCeti.CategoryTheory.quotientSheaf.isIso_desc_of_relSieve_mem`.

The main instance is a finite étale `G`-torsor `B` over `A` (`TauCeti.Algebra.IsFiniteEtaleTorsor`):
`Spec B ×_{Spec A} Spec B` is the disjoint union of the graphs of the automorphisms
`specComap B G g` (`TauCeti.AffineInvariantQuotient.isPullback_specComap_of_isFiniteEtaleTorsor`,
from the torsor square `TauCeti.AffineInvariantQuotient.isPullback_of_free`). If every element of
`G` is `1`, `σ` or `σ⁻¹`, for instance if `G` has order two, the pre-relation `(𝟙, σ)`, which
need not be reflexive, already has quotient sheaf `h_{Spec A}`
(`TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.torsorIso`). For a quadratic Galois extension
`L / K` this is the relation generated by the nontrivial automorphism of `Spec L` over `Spec K`.

## Main results

* `TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.relSieve_mem_of_isPullback`: the sieve along
  which two points with the same image are equal or related is an fppf covering.
* `TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.isoOfIsPullback`: the quotient sheaf is `h_M`.
* `TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.torsorIso`: `Spec B/(𝟙, σ) ≅ h_{Spec A}`.
-/

public section

open CategoryTheory Limits

namespace TauCeti.AlgebraicGeometry.Spaces

open _root_.AlgebraicGeometry TauCeti.AffineInvariantQuotient

universe u v

variable {R U M : Scheme.{u}} {s t : R ⟶ U}

/-- **Points of a kernel pair made of graphs are locally related.** Suppose that the kernel pair
of `q : U ⟶ M` is the disjoint union of the graphs of `ρ i : U ⟶ U`, and that each `ρ i` is the
identity or comes from the pre-relation `(t, s)` in one of the two directions. Then for any two
points `a, b` of `U` with `a ≫ q = b ≫ q`, the sieve along which they become equal or related is
an fppf covering. -/
theorem quotientSheaf.relSieve_mem_of_isPullback {ι : Type v} [Small.{u} ι] {q : U ⟶ M}
    {ρ : ι → (U ⟶ U)} (hpb : IsPullback (Sigma.desc fun _ ↦ 𝟙 U) (Sigma.desc ρ) q q)
    (hρ : ∀ i, ρ i = 𝟙 U ∨ (∃ r : U ⟶ R, r ≫ t = 𝟙 U ∧ r ≫ s = ρ i) ∨
      ∃ r : U ⟶ R, r ≫ t = ρ i ∧ r ≫ s = 𝟙 U)
    {T : Scheme.{u}} (a b : T ⟶ U) (hab : a ≫ q = b ≫ q) :
    TauCeti.CategoryTheory.quotientSheaf.relSieve s t a b ∈ Scheme.fppfTopology T := by
  have hcov := Scheme.zariskiTopology_le_fppfTopology _
    (sigmaOpenCover fun _ : ι ↦ U).mem_grothendieckTopology
  refine Scheme.fppfTopology.superset_covering ?_
    (Scheme.fppfTopology.pullback_stable (hpb.lift a b hab) hcov)
  intro T' g hg
  obtain ⟨i, c, hc⟩ : ∃ (i : ι) (c : T' ⟶ U),
      g ≫ hpb.lift a b hab = c ≫ Sigma.ι (fun _ : ι ↦ U) i :=
    (Sieve.mem_ofArrows_iff _ _ _).1 hg
  have ha : g ≫ a = c := by
    rw [← hpb.lift_fst a b hab, ← Category.assoc, hc]
    simp
  have hb : g ≫ b = c ≫ ρ i := by
    rw [← hpb.lift_snd a b hab, ← Category.assoc, hc]
    simp
  rw [TauCeti.CategoryTheory.quotientSheaf.mem_relSieve, ha, hb]
  rcases hρ i with h | ⟨r, h₁, h₂⟩ | ⟨r, h₁, h₂⟩
  · exact Or.inl (by simp [h])
  · exact Or.inr (Or.inl ⟨c ≫ r, by simp [h₁], by simp [h₂]⟩)
  · exact Or.inr (Or.inr ⟨c ≫ r, by simp [h₁], by simp [h₂]⟩)

/-- **Quotient by a pre-relation through the graphs of a kernel pair.** Let `q : U ⟶ M` be an fppf
covering, invariant for the pre-relation `(t, s)`, whose kernel pair is the disjoint union of the
graphs of `ρ i : U ⟶ U`, each the identity or coming from the pre-relation in one of the two
directions. Then the quotient sheaf `U/R` is `h_M`. -/
noncomputable def quotientSheaf.isoOfIsPullback {ι : Type v} [Small.{u} ι] (q : U ⟶ M) [Flat q]
    [LocallyOfFinitePresentation q] [Surjective q] (hq : t ≫ q = s ≫ q) {ρ : ι → (U ⟶ U)}
    (hpb : IsPullback (Sigma.desc fun _ ↦ 𝟙 U) (Sigma.desc ρ) q q)
    (hρ : ∀ i, ρ i = 𝟙 U ∨ (∃ r : U ⟶ R, r ≫ t = 𝟙 U ∧ r ≫ s = ρ i) ∨
      ∃ r : U ⟶ R, r ≫ t = ρ i ∧ r ≫ s = 𝟙 U) :
    quotientSheaf s t ≅ Scheme.fppfTopology.uliftYoneda.{u + 1}.obj M :=
  TauCeti.CategoryTheory.quotientSheaf.isoOfRelSieveMem.{u + 1} hq
    (Sheaf.isLocallySurjective_uliftYoneda_map_of_mem
      (Precoverage.generate_mem_toGrothendieck q.singleton_mem_fppfPrecoverage))
    (fun _ a b hab ↦ quotientSheaf.relSieve_mem_of_isPullback hpb hρ a b hab)

/-- The isomorphism `quotientSheaf.isoOfIsPullback` is the factorisation of `h q` through the
quotient sheaf. -/
theorem quotientSheaf.isoOfIsPullback_hom {ι : Type v} [Small.{u} ι] (q : U ⟶ M) [Flat q]
    [LocallyOfFinitePresentation q] [Surjective q] (hq : t ≫ q = s ≫ q) {ρ : ι → (U ⟶ U)}
    (hpb : IsPullback (Sigma.desc fun _ ↦ 𝟙 U) (Sigma.desc ρ) q q)
    (hρ : ∀ i, ρ i = 𝟙 U ∨ (∃ r : U ⟶ R, r ≫ t = 𝟙 U ∧ r ≫ s = ρ i) ∨
      ∃ r : U ⟶ R, r ≫ t = ρ i ∧ r ≫ s = 𝟙 U) :
    (quotientSheaf.isoOfIsPullback q hq hpb hρ).hom =
      TauCeti.CategoryTheory.quotientSheaf.desc (Scheme.fppfTopology.uliftYoneda.{u + 1}.map q)
        (TauCeti.CategoryTheory.quotientSheaf.uliftYoneda_map_condition hq) := by
  unfold quotientSheaf.isoOfIsPullback
  exact TauCeti.CategoryTheory.quotientSheaf.isoOfRelSieveMem_hom _ _ _

/-- The projection onto the quotient sheaf, followed by `quotientSheaf.isoOfIsPullback`, is the
map `h q`. -/
@[reassoc (attr := simp)]
theorem quotientSheaf.π_isoOfIsPullback_hom {ι : Type v} [Small.{u} ι] (q : U ⟶ M) [Flat q]
    [LocallyOfFinitePresentation q] [Surjective q] (hq : t ≫ q = s ≫ q) {ρ : ι → (U ⟶ U)}
    (hpb : IsPullback (Sigma.desc fun _ ↦ 𝟙 U) (Sigma.desc ρ) q q)
    (hρ : ∀ i, ρ i = 𝟙 U ∨ (∃ r : U ⟶ R, r ≫ t = 𝟙 U ∧ r ≫ s = ρ i) ∨
      ∃ r : U ⟶ R, r ≫ t = ρ i ∧ r ≫ s = 𝟙 U) :
    TauCeti.CategoryTheory.quotientSheaf.π Scheme.fppfTopology s t ≫
        (quotientSheaf.isoOfIsPullback q hq hpb hρ).hom =
      Scheme.fppfTopology.uliftYoneda.{u + 1}.map q :=
  TauCeti.CategoryTheory.quotientSheaf.π_isoOfRelSieveMem_hom _ _ _

section Torsor

open TauCeti.Algebra

variable {A B : Type u} {G : Type v} [CommRing A] [CommRing B] [Algebra A B] [Group G]
  [MulSemiringAction G B] [SMulCommClass G A B] [Finite G]

/-- **The quotient sheaf of a torsor by one generator.** Let `B` be a finite étale `G`-torsor over
`A` and `σ ∈ G` such that every element of `G` is `1`, `σ` or `σ⁻¹`; for instance `G` of order
two and `σ ≠ 1`. The quotient sheaf of the pre-relation `(𝟙, specComap B G σ)` on `Spec B`, which
need not be reflexive, is `h_{Spec A}`. -/
noncomputable def quotientSheaf.torsorIso [h : IsFiniteEtaleTorsor G A B] (σ : G)
    (hσ : ∀ g : G, g = 1 ∨ g = σ ∨ g = σ⁻¹) :
    quotientSheaf (𝟙 (Spec (.of B))) (specComap B G σ) ≅
      Scheme.fppfTopology.uliftYoneda.{u + 1}.obj (Spec (.of A)) :=
  have := h.faithfullyFlat
  have := h.etale
  quotientSheaf.isoOfIsPullback (Spec.algebraMap A B) (by simp)
    (isPullback_specComap_of_isFiniteEtaleTorsor B G A) fun g ↦ by
      rcases hσ g with rfl | rfl | rfl
      · exact Or.inl (specComap_one B G)
      · exact Or.inr (Or.inr ⟨𝟙 _, by simp, by simp⟩)
      · exact Or.inr (Or.inl ⟨specComap B G σ⁻¹, by simp [← specComap_mul, specComap_one], by simp⟩)

/-- The isomorphism `quotientSheaf.torsorIso` is the factorisation of `h (Spec B ⟶ Spec A)`
through the quotient sheaf. -/
theorem quotientSheaf.torsorIso_hom [h : IsFiniteEtaleTorsor G A B] (σ : G)
    (hσ : ∀ g : G, g = 1 ∨ g = σ ∨ g = σ⁻¹) :
    (quotientSheaf.torsorIso σ hσ).hom =
      TauCeti.CategoryTheory.quotientSheaf.desc
        (Scheme.fppfTopology.uliftYoneda.{u + 1}.map (Spec.algebraMap A B))
        (TauCeti.CategoryTheory.quotientSheaf.uliftYoneda_map_condition
          (by simp)) := by
  have := h.faithfullyFlat
  have := h.etale
  unfold quotientSheaf.torsorIso
  exact quotientSheaf.isoOfIsPullback_hom _ _ _ _

/-- The projection onto the quotient sheaf of `(𝟙, σ)`, followed by `quotientSheaf.torsorIso`, is
the map induced by `Spec B ⟶ Spec A`. -/
@[reassoc (attr := simp)]
theorem quotientSheaf.π_torsorIso_hom [h : IsFiniteEtaleTorsor G A B] (σ : G)
    (hσ : ∀ g : G, g = 1 ∨ g = σ ∨ g = σ⁻¹) :
    TauCeti.CategoryTheory.quotientSheaf.π Scheme.fppfTopology (𝟙 (Spec (.of B)))
        (specComap B G σ) ≫ (quotientSheaf.torsorIso σ hσ).hom =
      Scheme.fppfTopology.uliftYoneda.{u + 1}.map (Spec.algebraMap A B) := by
  have := h.faithfullyFlat
  have := h.etale
  unfold quotientSheaf.torsorIso
  exact quotientSheaf.π_isoOfIsPullback_hom _ _ _ _

end Torsor

end TauCeti.AlgebraicGeometry.Spaces
