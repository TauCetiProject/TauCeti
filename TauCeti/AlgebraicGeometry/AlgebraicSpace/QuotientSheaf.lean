module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Mathlib.CategoryTheory.Limits.Types.Pullbacks
public import Mathlib.CategoryTheory.Sites.Canonical
public import Mathlib.CategoryTheory.Sites.LeftExact
public import Mathlib.Logic.Function.Coequalizer
public import TauCeti.CategoryTheory.EquivalenceRelation

/-!
# The quotient sheaf of a pre-relation of schemes

Let `s t : R ⟶ U` be a pair of morphisms of schemes, a *pre-relation* on `U`: a point `r` of `R`
relates `t r` to `s r`. The *quotient sheaf* `U/R` is the fppf sheafification of the presheaf
coequaliser `T ↦ U(T)/R(T)`, the quotient of `U(T)` by the equivalence relation generated by the
image of `R(T)` (Stacks, Definition 39.20.1 (02VG)). This file constructs it with its projection
`π : h_U ⟶ U/R`, shows that `π` is the coequaliser of `h_R ⇉ h_U` in fppf sheaves, and shows that
`R` is the kernel pair of `π` when `(t, s)` is an equivalence relation (Stacks, Lemma 39.20.4
(045Y), together with the injectivity of `R ⟶ U × U`).

Mathlib's type-valued sheafification for the big fppf site of `Scheme.{u}` produces sheaves of
`Type (u + 1)`, since the site is a large category. The quotient sheaf is therefore a sheaf of
`Type (u + 1)`, and the representable sheaves are the universe-lifted ones
`Scheme.fppfTopology.uliftYoneda`.

## Main definitions

* `TauCeti.AlgebraicGeometry.Spaces.quotientPresheaf s t`: the presheaf `T ↦ U(T)/R(T)`.
* `TauCeti.AlgebraicGeometry.Spaces.quotientSheaf s t`: its fppf sheafification `U/R`.
* `TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.π s t`: the projection `h_U ⟶ U/R`.
* `TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.desc`: the factorisation of an `R`-invariant
  map `h_U ⟶ F` to an fppf sheaf through `U/R`.

## Main results

* `TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.isColimit`: `π` is the coequaliser of
  `h_R ⇉ h_U` in fppf sheaves.
* `TauCeti.AlgebraicGeometry.Spaces.quotientSheaf.kernelPair`: for an equivalence relation,
  `h_R ⇉ h_U` is the kernel pair of `π`, that is, `h_R = h_U ×_{U/R} h_U`.
* `TauCeti.AlgebraicGeometry.Spaces.quotientPresheaf.π_app_eq_iff`: for an equivalence relation,
  two `T`-points of `U` have the same class in the presheaf quotient exactly when they are related
  by a `T`-point of `R`.

## Implementation notes

The kernel pair is computed in presheaves, where it is the pointwise statement
`quotientPresheaf.π_app_eq_iff`, and carried to sheaves because sheafification preserves finite
limits. This replaces the local argument of Stacks, Lemma 39.20.4.

## References

* [Stacks Project, Definition 39.20.1](https://stacks.math.columbia.edu/tag/02VG)
* [Stacks Project, Lemma 39.20.4](https://stacks.math.columbia.edu/tag/045Y)
-/

public section

open CategoryTheory Limits Opposite TauCeti.CategoryTheory

namespace TauCeti.AlgebraicGeometry.Spaces

open _root_.AlgebraicGeometry

universe u

variable {R U : Scheme.{u}} (s t : R ⟶ U)

/-- The presheaf quotient `T ↦ U(T)/R(T)` of a pre-relation `s t : R ⟶ U`: the quotient of the
`T`-points of `U` by the equivalence relation generated by `t r ~ s r` for `T`-points `r` of `R`
(Stacks, Definition 39.20.1 (02VG), before sheafification). -/
@[expose] noncomputable def quotientPresheaf : Scheme.{u}ᵒᵖ ⥤ Type u where
  obj T := Function.Coequalizer (fun r : unop T ⟶ R ↦ r ≫ t) (fun r ↦ r ≫ s)
  map f := TypeCat.ofHom <| Quot.map (fun a ↦ f.unop ≫ a) <| by
    rintro _ _ ⟨r⟩
    rw [← Category.assoc, ← Category.assoc]
    exact .intro _
  map_id _ := by
    ext x
    induction x using Quot.ind
    exact congrArg (Quot.mk _) (Category.id_comp _)
  map_comp _ _ := by
    ext x
    induction x using Quot.ind
    exact congrArg (Quot.mk _) (Category.assoc _ _ _)

/-- The projection `h_U ⟶ U/R` of presheaves, sending a `T`-point of `U` to its class. -/
@[expose] noncomputable def quotientPresheaf.π : yoneda.obj U ⟶ quotientPresheaf s t where
  app _ := TypeCat.ofHom (Function.Coequalizer.mk _ _)
  naturality _ _ _ := rfl

variable {s t}

/-- When the relation `t r ~ s r` on `T`-points of `U` is an equivalence relation (for instance
when `(t, s)` is an equivalence relation, by `EquivalenceRelation.equivalence_ofPairHom`), two
`T`-points of `U` have the same class in the presheaf quotient exactly when they are `t r` and
`s r` for a `T`-point `r` of `R`. -/
theorem quotientPresheaf.π_app_eq_iff {T : Scheme.{u}ᵒᵖ}
    (h : _root_.Equivalence (Rel.ofPairHom t s (unop T))) (a b : unop T ⟶ U) :
    (quotientPresheaf.π s t).app T a = (quotientPresheaf.π s t).app T b ↔
      ∃ r : unop T ⟶ R, r ≫ t = a ∧ r ≫ s = b := by
  have e : Function.Coequalizer.Rel (fun r : unop T ⟶ R ↦ r ≫ t) (fun r ↦ r ≫ s) =
      Rel.ofPairHom t s (unop T) := by
    ext a b
    rw [Rel.ofPairHom_iff]
    exact ⟨fun ⟨r⟩ ↦ ⟨r, rfl, rfl⟩, fun ⟨r, ha, hb⟩ ↦ ha ▸ hb ▸ .intro r⟩
  refine Quot.eq.trans ?_
  rw [e, h.eqvGen_iff, Rel.ofPairHom_iff]

section Sheaf

variable (s t)

/-- The projection `h_U ⟶ U/R` onto the universe-lifted presheaf quotient, whose sheafification
is `quotientSheaf.π`. -/
@[expose] noncomputable def quotientPresheaf.uliftπ :
    (Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U).obj ⟶
      quotientPresheaf s t ⋙ uliftFunctor.{u + 1} where
  app T := TypeCat.ofHom fun a ↦ ULift.up ((quotientPresheaf.π s t).app T a.down)
  naturality _ _ _ := rfl

/-- The projection onto the universe-lifted presheaf quotient coequalises `h_R ⇉ h_U`. -/
theorem quotientPresheaf.uliftπ_condition :
    (Scheme.fppfTopology.uliftYoneda.{u + 1}.map t).hom ≫ quotientPresheaf.uliftπ s t =
      (Scheme.fppfTopology.uliftYoneda.{u + 1}.map s).hom ≫ quotientPresheaf.uliftπ s t := by
  ext T ⟨r⟩
  exact congrArg ULift.up (Function.Coequalizer.condition _ _ r)

variable {s t} in
/-- The factorisation through the universe-lifted presheaf quotient of a natural transformation
out of `h_U` which agrees on `t r` and `s r` for every point `r` of `R`. -/
noncomputable def quotientPresheaf.uliftDesc {P : Scheme.{u}ᵒᵖ ⥤ Type (u + 1)}
    (φ : (Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U).obj ⟶ P)
    (hφ : (Scheme.fppfTopology.uliftYoneda.{u + 1}.map t).hom ≫ φ =
      (Scheme.fppfTopology.uliftYoneda.{u + 1}.map s).hom ≫ φ) :
    quotientPresheaf s t ⋙ uliftFunctor.{u + 1} ⟶ P where
  app T := TypeCat.ofHom fun x ↦
    Function.Coequalizer.desc (fun r : unop T ⟶ R ↦ r ≫ t) (fun r ↦ r ≫ s)
    (fun a ↦ φ.app T (ULift.up a))
    (funext fun r ↦ ConcreteCategory.congr_hom (NatTrans.congr_app hφ T)
      (ULift.up r : ULift.{u + 1} (unop T ⟶ R))) x.down
  naturality T T' f := by
    ext ⟨x⟩
    induction x using Quot.ind
    exact ConcreteCategory.congr_hom (φ.naturality f) _

variable {s t} in
/-- The component of `quotientPresheaf.uliftDesc φ hφ` at `T` descends `φ.app T` along the
pointwise coequaliser. -/
theorem quotientPresheaf.uliftDesc_app_apply {P : Scheme.{u}ᵒᵖ ⥤ Type (u + 1)}
    (φ : (Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U).obj ⟶ P)
    (hφ : (Scheme.fppfTopology.uliftYoneda.{u + 1}.map t).hom ≫ φ =
      (Scheme.fppfTopology.uliftYoneda.{u + 1}.map s).hom ≫ φ) (T : Scheme.{u}ᵒᵖ)
    (a : unop T ⟶ U) :
    (quotientPresheaf.uliftDesc φ hφ).app T (ULift.up ((quotientPresheaf.π s t).app T a)) =
      φ.app T (ULift.up a) :=
  (rfl)

variable {s t} in
/-- The factorisation through the universe-lifted presheaf quotient, composed with the
projection, is the original natural transformation. -/
@[reassoc (attr := simp)]
theorem quotientPresheaf.uliftπ_uliftDesc {P : Scheme.{u}ᵒᵖ ⥤ Type (u + 1)}
    (φ : (Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U).obj ⟶ P)
    (hφ : (Scheme.fppfTopology.uliftYoneda.{u + 1}.map t).hom ≫ φ =
      (Scheme.fppfTopology.uliftYoneda.{u + 1}.map s).hom ≫ φ) :
    quotientPresheaf.uliftπ s t ≫ quotientPresheaf.uliftDesc φ hφ = φ :=
  (rfl)

/-- Morphisms out of the universe-lifted presheaf quotient agree when they agree after the
projection. -/
theorem quotientPresheaf.uliftπ_hom_ext {P : Scheme.{u}ᵒᵖ ⥤ Type (u + 1)}
    {f g : quotientPresheaf s t ⋙ uliftFunctor.{u + 1} ⟶ P}
    (hfg : quotientPresheaf.uliftπ s t ≫ f = quotientPresheaf.uliftπ s t ≫ g) : f = g := by
  ext T ⟨x⟩
  induction x using Quot.ind
  exact ConcreteCategory.congr_hom (NatTrans.congr_app hfg T) _

variable {s t} in
/-- For an equivalence relation `(t, s)`, the universe-lifted `h_R ⇉ h_U` is the kernel pair of
the projection onto the universe-lifted presheaf quotient. -/
theorem quotientPresheaf.isKernelPair_uliftπ (h : IsEquivalenceRelation t s) :
    IsKernelPair (quotientPresheaf.uliftπ s t) (Scheme.fppfTopology.uliftYoneda.{u + 1}.map t).hom
      (Scheme.fppfTopology.uliftYoneda.{u + 1}.map s).hom := by
  have w := quotientPresheaf.uliftπ_condition s t
  refine ⟨⟨w⟩, ⟨evaluationJointlyReflectsLimits _ fun T ↦
    (isLimitMapConePullbackConeEquiv _ w).symm ?_⟩⟩
  refine IsPullback.isLimit ((Types.isPullback_iff _ _ _ _).2 ⟨?_, ?_, ?_⟩)
  · exact NatTrans.congr_app w T
  · rintro ⟨r⟩ ⟨r'⟩ ⟨ht, hs⟩
    exact congrArg ULift.up (h.hom_ext (congrArg ULift.down ht) (congrArg ULift.down hs))
  · rintro ⟨a⟩ ⟨b⟩ hab
    obtain ⟨r, ht, hs⟩ := (quotientPresheaf.π_app_eq_iff (h.equivalence_ofPairHom _) a b).1
      (congrArg ULift.down hab)
    exact ⟨ULift.up r, congrArg ULift.up ht, congrArg ULift.up hs⟩

/-- The quotient sheaf `U/R` of a pre-relation `s t : R ⟶ U`: the fppf sheafification of the
presheaf quotient `T ↦ U(T)/R(T)` (Stacks, Definition 39.20.1 (02VG)). It is a sheaf of
`Type (u + 1)`, where Mathlib's sheafification for the big fppf site lands. -/
noncomputable abbrev quotientSheaf : Sheaf Scheme.fppfTopology.{u} (Type (u + 1)) :=
  (presheafToSheaf Scheme.fppfTopology (Type (u + 1))).obj
    (quotientPresheaf s t ⋙ uliftFunctor.{u + 1})

/-- The projection `π : h_U ⟶ U/R` onto the quotient sheaf, sending a `T`-point of `U` to its
class. -/
@[expose] noncomputable def quotientSheaf.π :
    Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U ⟶ quotientSheaf s t :=
  (sheafificationIso (Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U)).hom ≫
    (presheafToSheaf Scheme.fppfTopology (Type (u + 1))).map (quotientPresheaf.uliftπ s t)

/-- On underlying presheaves, the projection onto the quotient sheaf is the projection onto the
presheaf quotient followed by the unit of sheafification. -/
theorem quotientSheaf.π_hom :
    (quotientSheaf.π s t).hom =
      quotientPresheaf.uliftπ s t ≫ toSheafify Scheme.fppfTopology _ := by
  rw [quotientSheaf.π, ObjectProperty.FullSubcategory.comp_hom, sheafificationIso_hom_hom,
    isoSheafify_hom, toSheafify_naturality]

/-- The projection onto the quotient sheaf coequalises `h_R ⇉ h_U`. -/
@[reassoc]
theorem quotientSheaf.condition :
    Scheme.fppfTopology.uliftYoneda.map t ≫ quotientSheaf.π s t =
      Scheme.fppfTopology.uliftYoneda.map s ≫ quotientSheaf.π s t := by
  ext1
  simp only [ObjectProperty.FullSubcategory.comp_hom, quotientSheaf.π_hom]
  rw [reassoc_of% quotientPresheaf.uliftπ_condition s t]

variable {s t}

/-- A morphism `φ : h_U ⟶ F` to an fppf sheaf which agrees on `t r` and `s r` for every point `r`
of `R` factors through the quotient sheaf. -/
noncomputable def quotientSheaf.desc {F : Sheaf Scheme.fppfTopology.{u} (Type (u + 1))}
    (φ : Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U ⟶ F)
    (hφ : Scheme.fppfTopology.uliftYoneda.map t ≫ φ =
      Scheme.fppfTopology.uliftYoneda.map s ≫ φ) :
    quotientSheaf s t ⟶ F :=
  ObjectProperty.homMk <| sheafifyLift Scheme.fppfTopology
    (quotientPresheaf.uliftDesc φ.hom (congrArg (·.hom) hφ)) F.property

/-- The factorisation through the quotient sheaf is the sheafified lift of the factorisation
through the universe-lifted presheaf quotient. -/
theorem quotientSheaf.desc_def {F : Sheaf Scheme.fppfTopology.{u} (Type (u + 1))}
    (φ : Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U ⟶ F)
    (hφ : Scheme.fppfTopology.uliftYoneda.map t ≫ φ =
      Scheme.fppfTopology.uliftYoneda.map s ≫ φ) :
    quotientSheaf.desc φ hφ = ObjectProperty.homMk (sheafifyLift Scheme.fppfTopology
      (quotientPresheaf.uliftDesc φ.hom (congrArg (·.hom) hφ)) F.property) :=
  (rfl)

/-- The factorisation through the quotient sheaf, composed with the projection, is the original
morphism. -/
@[reassoc (attr := simp)]
theorem quotientSheaf.π_desc {F : Sheaf Scheme.fppfTopology.{u} (Type (u + 1))}
    (φ : Scheme.fppfTopology.uliftYoneda.{u + 1}.obj U ⟶ F)
    (hφ : Scheme.fppfTopology.uliftYoneda.map t ≫ φ =
      Scheme.fppfTopology.uliftYoneda.map s ≫ φ) :
    quotientSheaf.π s t ≫ quotientSheaf.desc φ hφ = φ := by
  ext1
  rw [ObjectProperty.FullSubcategory.comp_hom, quotientSheaf.π_hom, Category.assoc,
    quotientSheaf.desc_def, ObjectProperty.homMk_hom, toSheafify_sheafifyLift,
    quotientPresheaf.uliftπ_uliftDesc]

/-- Morphisms out of the quotient sheaf agree when they agree after the projection. -/
theorem quotientSheaf.hom_ext {F : Sheaf Scheme.fppfTopology.{u} (Type (u + 1))}
    {f g : quotientSheaf s t ⟶ F}
    (hfg : quotientSheaf.π s t ≫ f = quotientSheaf.π s t ≫ g) : f = g := by
  ext1
  refine sheafify_hom_ext _ _ _ F.property (quotientPresheaf.uliftπ_hom_ext s t ?_)
  simpa only [ObjectProperty.FullSubcategory.comp_hom, quotientSheaf.π_hom, Category.assoc]
    using congrArg (·.hom) hfg

variable (s t) in
/-- The quotient sheaf is the coequaliser of `h_R ⇉ h_U` in fppf sheaves. -/
noncomputable def quotientSheaf.isColimit :
    IsColimit (Cofork.ofπ (quotientSheaf.π s t) (quotientSheaf.condition s t)) :=
  Cofork.IsColimit.mk' _ fun c ↦ ⟨quotientSheaf.desc c.π c.condition,
    quotientSheaf.π_desc _ _, fun hm ↦ quotientSheaf.hom_ext (by simpa using hm)⟩

/-- For an equivalence relation `(t, s)`, `h_R ⇉ h_U` is the kernel pair of the projection onto
the quotient sheaf: `h_R = h_U ×_{U/R} h_U` (Stacks, Lemma 39.20.4 (045Y), and the injectivity of
`R ⟶ U × U`). -/
theorem quotientSheaf.kernelPair (h : IsEquivalenceRelation t s) :
    IsKernelPair (quotientSheaf.π s t) (Scheme.fppfTopology.uliftYoneda.{u + 1}.map t)
      (Scheme.fppfTopology.uliftYoneda.map s) :=
  ((presheafToSheaf Scheme.fppfTopology (Type (u + 1))).map_isPullback
    (quotientPresheaf.isKernelPair_uliftπ h)).of_iso' (sheafificationIso _) (sheafificationIso _)
    (sheafificationIso _) (Iso.refl _)
    ((sheafificationNatIso Scheme.fppfTopology (Type (u + 1))).hom.naturality
      (Scheme.fppfTopology.uliftYoneda.{u + 1}.map t)).symm
    ((sheafificationNatIso Scheme.fppfTopology (Type (u + 1))).hom.naturality
      (Scheme.fppfTopology.uliftYoneda.{u + 1}.map s)).symm
    (Category.comp_id (quotientSheaf.π s t)).symm
    (Category.comp_id (quotientSheaf.π s t)).symm

end Sheaf

end TauCeti.AlgebraicGeometry.Spaces
