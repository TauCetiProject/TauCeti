module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Mathlib.CategoryTheory.Limits.Constructions.Over.Basic
public import Mathlib.CategoryTheory.Sites.Over
public import TauCeti.CategoryTheory.Sites.Precoverage

/-!
# Small covering families in the big fppf site

Every covering sieve of the big fppf site `Over S` of a scheme `S : Scheme.{u}` contains a
covering sieve generated by a family indexed by a type in `Type u`. This lets constructions
using small covering families handle arbitrary covering sieves of this site.
-/

public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme

variable (S : Scheme.{u})

/-- Every covering sieve of the fppf topology on `Over S` contains a covering sieve generated by a
family indexed by a type in `Type u`. -/
theorem exists_ofArrows_le_of_mem_fppfTopology_over {U : Over S} {R : Sieve U}
    (hR : R ∈ (fppfTopology.over S) U) :
    ∃ (ι : Type u) (X : ι → Over S) (f : ∀ i, X i ⟶ U),
      Sieve.ofArrows X f ∈ (fppfTopology.over S) U ∧ Sieve.ofArrows X f ≤ R := by
  have : Precoverage.Small.{u} fppfPrecoverage :=
    inferInstanceAs (Precoverage.Small.{u} (precoverage _))
  rw [over_toGrothendieck_eq_toGrothendieck_comap_forget] at hR ⊢
  exact Precoverage.exists_ofArrows_le_of_mem_toGrothendieck _ hR

end AlgebraicGeometry.Scheme
