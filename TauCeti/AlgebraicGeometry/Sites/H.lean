/-!
# The finite-type h-site

The finite-type h-site of a scheme `S` has finite-type `S`-schemes as objects and is generated
by Zariski covering families and proper surjections whose sources are finite type over `S`.
For a quasi-separated base this generated topology agrees with the topology restricted from
the big h-site. The comparison uses affine refinements of Zariski covering families.

Finite type refers to quasi-compact morphisms locally of finite type.

The family-level comparison is `ofArrows_mem_finiteTypeHTopology_iff`.
The generator criterion is `ofArrows_mem_finiteTypeHPrecoverage_iff`.
`FiniteType.ofArrows_mem_finiteTypeHTopology_of_isOpenImmersion` introduces Zariski
covering families without assuming that the base is quasi-separated, and
`FiniteType.generate_singleton_mem_finiteTypeHTopology` introduces proper surjections.
Between quasi-separated bases, `Hom.finiteTypeHTopology_coverPreserving_pullback` shows that
change of base preserves covers.
-/

public section

open CategoryTheory
universe u v
namespace AlgebraicGeometry.Scheme

open TauCeti.AlgebraicGeometry.Scheme

/-- The generating families for the finite-type h-site. -/
def finiteTypeHPrecoverage (S : Scheme.{u}) : Precoverage (S.FiniteType) :=
  hPrecoverage.comap
    (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S ⋙ Over.forget S)

/-- The finite-type generating precoverage is the comap of the big generating precoverage. -/
lemma finiteTypeHPrecoverage_def (S : Scheme.{u}) :
    finiteTypeHPrecoverage S = hPrecoverage.comap
      (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S ⋙
        Over.forget S) := by
  rfl

private lemma map_finiteType_family {S : Scheme.{u}} {X : S.FiniteType}
    {ι : Type v} {Y : ι → S.FiniteType} (f : ∀ i, Y i ⟶ X) :
    (Presieve.ofArrows Y f).map
      (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S ⋙
        Over.forget S) =
      Presieve.ofArrows (fun i ↦ (Y i).left) (fun i ↦ (f i).left) := by
  rw [Presieve.map_ofArrows]
  rfl

/-- The h-topology generated by Zariski covers and proper surjections in finite-type schemes
over the base. -/
def finiteTypeHTopology (S : Scheme.{u}) : GrothendieckTopology (S.FiniteType) :=
  (finiteTypeHPrecoverage S).toGrothendieck

/-- Exact membership in the generating precoverage is detected by mapping the presieve to
schemes: the image is a Zariski covering family or a nonempty family of proper surjections. -/
lemma _root_.TauCeti.AlgebraicGeometry.Scheme.mem_finiteTypeHPrecoverage_iff
    {S : Scheme.{u}} {X : S.FiniteType} {R : Presieve X} :
    R ∈ finiteTypeHPrecoverage S X ↔
      R.map (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S ⋙
        Over.forget S) ∈ hPrecoverage X.left := Iff.rfl

/-- An indexed family generates the finite-type h-site precisely when it is a jointly
surjective family of open immersions or a nonempty family of proper surjections. -/
@[simp]
lemma _root_.TauCeti.AlgebraicGeometry.Scheme.ofArrows_mem_finiteTypeHPrecoverage_iff
    {S : Scheme.{u}} {X : S.FiniteType} {ι : Type v} {Y : ι → S.FiniteType}
    (f : ∀ i, Y i ⟶ X) :
    Presieve.ofArrows Y f ∈ S.finiteTypeHPrecoverage X ↔
      ((∀ x : X.left, ∃ i, x ∈ Set.range (f i).left) ∧
        ∀ i, IsOpenImmersion (f i).left) ∨
      (Nonempty ι ∧ ∀ i, IsProper (f i).left ∧ Surjective (f i).left) := by
  rw [mem_finiteTypeHPrecoverage_iff, map_finiteType_family]
  exact ofArrows_mem_hPrecoverage_iff

/-- The finite-type h-topology is generated by its Zariski and proper-surjection families. -/
lemma finiteTypeHTopology_eq_toGrothendieck (S : Scheme.{u}) :
    finiteTypeHTopology S = (finiteTypeHPrecoverage S).toGrothendieck := by rfl

/-- A proper surjection of finite-type schemes over the base is an h-cover in the finite-type
site. -/
lemma FiniteType.generate_singleton_mem_finiteTypeHTopology {S : Scheme.{u}} {X Y : S.FiniteType}
    (f : X ⟶ Y) [IsProper f.left] [Surjective f.left] :
    Sieve.generate (Presieve.singleton f) ∈ S.finiteTypeHTopology Y := by
  apply Precoverage.generate_mem_toGrothendieck
  rw [mem_finiteTypeHPrecoverage_iff, Presieve.map_singleton,
    MorphismProperty.Over.forget_comp_forget_map]
  exact f.left.singleton_mem_hPrecoverage

/-- A jointly surjective family of open immersions in finite-type schemes over any base is
an h-cover in the finite-type site. -/
lemma FiniteType.ofArrows_mem_finiteTypeHTopology_of_isOpenImmersion
    {S : Scheme.{u}} {X : S.FiniteType} {ι : Type v} {Y : ι → S.FiniteType}
    (f : ∀ i, Y i ⟶ X) [∀ i, IsOpenImmersion (f i).left]
    (hf : ∀ x : X.left, ∃ i, x ∈ Set.range (f i).left) :
    Sieve.ofArrows Y f ∈ S.finiteTypeHTopology X := by
  apply Precoverage.generate_mem_toGrothendieck
  apply (ofArrows_mem_finiteTypeHPrecoverage_iff f).mpr
  exact Or.inl ⟨hf, fun i ↦ (inferInstance : IsOpenImmersion (f i).left)⟩

/-- The finite-type h-topology is the least topology containing jointly surjective families
of open immersions and singleton proper surjections, over an arbitrary base. -/
lemma finiteTypeHTopology_le_iff
    (S : Scheme.{u}) (J : GrothendieckTopology S.FiniteType) :
    S.finiteTypeHTopology ≤ J ↔
      (∀ ⦃X : S.FiniteType⦄ ⦃ι : Type (u + 1)⦄ ⦃Y : ι → S.FiniteType⦄
        (f : ∀ i, Y i ⟶ X),
        (∀ i, IsOpenImmersion (f i).left) →
        (∀ x : X.left, ∃ i, x ∈ Set.range (f i).left) → Sieve.ofArrows Y f ∈ J X) ∧
      ∀ ⦃X Y : S.FiniteType⦄ (f : X ⟶ Y), IsProper f.left → Surjective f.left →
        Sieve.generate (Presieve.singleton f) ∈ J Y := by
  constructor
  · intro h
    constructor
    · intro X ι Y f hf hs
      let := hf
      exact h _ (FiniteType.ofArrows_mem_finiteTypeHTopology_of_isOpenImmersion f hs)
    · intro X Y f hf hs
      let := hf
      let := hs
      exact h _ (FiniteType.generate_singleton_mem_finiteTypeHTopology f)
  · rintro ⟨hZ, hP⟩
    rw [finiteTypeHTopology_eq_toGrothendieck, Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
    intro X R hR
    obtain ⟨ι, Y, f, rfl⟩ := R.exists_eq_ofArrows
    rw [ofArrows_mem_finiteTypeHPrecoverage_iff] at hR
    rw [GrothendieckTopology.mem_toPrecoverage_iff]
    rcases hR with ⟨hs, hf⟩ | ⟨⟨i⟩, hf⟩
    · exact hZ f hf hs
    · exact J.superset_covering
        (Sieve.generate_mono ((Presieve.singleton_le_iff (f i)).mpr ⟨i⟩))
        (hP (f i) (hf i).1 (hf i).2)

private lemma exists_finiteType_zariski_refinement (S : Scheme.{u}) [QuasiSeparatedSpace S]
    {X : S.FiniteType} {ι : Type v} (Y : ι → Over S)
    (f : ∀ i, Y i ⟶ ((MorphismProperty.Over.forget _ ⊤ S).obj X))
    (hR : (∀ x : X.left, ∃ i, x ∈ Set.range (f i).left) ∧
      ∀ i, IsOpenImmersion (f i).left) :
    ∃ r : Presieve X,
      r.map (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S) ∈
      (hPrecoverage.over S) ((MorphismProperty.Over.forget _ ⊤ S).obj X) ∧
        r.map (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S) ≤
          (Sieve.generate (Presieve.ofArrows Y f)).arrows := by
  -- The affine refinement comparison uses an index universe containing the scheme universe.
  let 𝒰 : OpenCover.{max u v} X.left :=
    Cover.mkOfCovers (ULift.{u} ι) (fun i ↦ (Y i.down).left)
      (fun i ↦ (f i.down).left)
      (fun x ↦ by obtain ⟨i, y, hy⟩ := hR.1 x; exact ⟨⟨i⟩, y, hy⟩)
      (fun i ↦ hR.2 i.down)
  let 𝒜 := OpenCover.affineRefinement.{u, max u v} 𝒰
  let ρ := OpenCover.fromAffineRefinement.{u, v} 𝒰
  let Z (j : 𝒜.I₀) : S.FiniteType :=
    letI : IsAffine (𝒜.openCover.X j) := isAffine_affineOpenCover X.left 𝒜 j
    FiniteType.mk (𝒜.f j ≫ X.hom)
  let g (j : 𝒜.I₀) : Z j ⟶ X := MorphismProperty.Over.homMk (𝒜.f j) rfl
  refine ⟨Presieve.ofArrows Z g, ?_, ?_⟩
  · change Presieve.ofArrows Z g ∈ ((hPrecoverage.over S).comap
      (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S)) X
    rw [← Precoverage.comap_comp, Precoverage.mem_comap_iff, map_finiteType_family]
    exact (mem_hPrecoverage_iff).mpr (Or.inl 𝒜.openCover.mem₀)
  · rw [Presieve.map_ofArrows, ← Sieve.generate_le_iff]
    apply (Sieve.overEquiv _).le_iff_le.mp
    rw [Sieve.overEquiv_ofArrows, Sieve.overEquiv_ofArrows]
    -- The underlying scheme family of `Z` and `g` is the affine refinement.
    change Sieve.ofArrows 𝒜.openCover.X 𝒜.openCover.f ≤
      Sieve.ofArrows (fun i ↦ (Y i).left) (fun i ↦ (f i).left)
    have h := ρ.sieve₀_le_sieve₀
    change Sieve.ofArrows 𝒜.openCover.X 𝒜.openCover.f ≤
      Sieve.generate (Presieve.ofArrows
        ((fun i ↦ (Y i).left) ∘ ULift.down) (fun i ↦ (f i.down).left)) at h
    rw [Presieve.ofArrows_comp_eq_of_surjective (fun i ↦ (f i).left)
      ULift.down_surjective] at h
    exact h

private lemma exists_finiteType_proper_refinement (S : Scheme.{u}) {X : S.FiniteType}
    {Y : Over S} (f : Y ⟶ ((MorphismProperty.Over.forget _ ⊤ S).obj X))
    (hp : IsProper f.left ∧ Surjective f.left) :
    ∃ r : Presieve X,
      r.map (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S) ∈
      (hPrecoverage.over S) ((MorphismProperty.Over.forget _ ⊤ S).obj X) ∧
        r.map (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S) ≤
          (Sieve.generate (Presieve.singleton f)).arrows := by
  let : MorphismProperty.IsStableUnderComposition
      (@LocallyOfFiniteType ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) :=
    .inf (P := @LocallyOfFiniteType) (Q := @QuasiCompact)
  have hle : Scheme.precoverage (@IsProper ⊓ @Surjective) ≤
      (@LocallyOfFiniteType ⊓ @QuasiCompact : MorphismProperty Scheme.{u}).precoverage := by
    refine le_trans inf_le_right (MorphismProperty.precoverage_monotone ?_)
    intro Z W g hg
    let := hg.1
    exact ⟨inferInstance, inferInstance⟩
  have hf : Presieve.singleton f ∈
      (Scheme.precoverage (@IsProper ⊓ @Surjective)).over S _ := by
    rw [Precoverage.mem_comap_iff, Presieve.map_singleton, Over.forget_map,
      Scheme.singleton_mem_precoverage_iff]
    exact ⟨hp.2.surj, hp⟩
  obtain ⟨r, hr⟩ := MorphismProperty.exists_map_eq_of_presieve _ hle hf
  refine ⟨r, ?_, ?_⟩
  · rw [hr, Precoverage.mem_comap_iff, Presieve.map_singleton, Over.forget_map]
    let := hp.1
    let := hp.2
    exact f.left.singleton_mem_hPrecoverage
  · rw [hr]
    exact Sieve.le_generate _

private lemma exists_finiteType_h_refinement (S : Scheme.{u}) [QuasiSeparatedSpace S]
    {X : S.FiniteType} {R : Presieve ((MorphismProperty.Over.forget _ ⊤ S).obj X)}
    (hR : R ∈ (hPrecoverage.over S) ((MorphismProperty.Over.forget _ ⊤ S).obj X)) :
    ∃ r : Presieve X,
      r.map (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S) ∈
      (hPrecoverage.over S) ((MorphismProperty.Over.forget _ ⊤ S).obj X) ∧
        r.map (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S) ≤
          (Sieve.generate R).arrows := by
  obtain ⟨ι, Y, f, rfl⟩ := R.exists_eq_ofArrows
  rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows,
    ofArrows_mem_hPrecoverage_iff] at hR
  simp only [Over.forget_map] at hR
  rcases hR with hR | ⟨⟨i⟩, hR⟩
  · exact exists_finiteType_zariski_refinement S Y f hR
  · obtain ⟨r, hr, hle⟩ := exists_finiteType_proper_refinement S (f i) (hR i)
    exact ⟨r, hr, hle.trans (Sieve.generate_mono
      (by rw [Presieve.singleton_le_iff]; exact ⟨i⟩))⟩

private lemma finiteTypeHTopology_eq_comap_toGrothendieck (S : Scheme.{u}) :
    finiteTypeHTopology S =
      ((hPrecoverage.over S).toCoverage.toPrecoverage.comap
        (MorphismProperty.Over.forget
          (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S)).toGrothendieck := by
  rw [finiteTypeHTopology_eq_toGrothendieck, finiteTypeHPrecoverage_def,
    Precoverage.comap_comp, Precoverage.toCoverage_toPrecoverage]

private lemma hTopology_over_eq_toGrothendieck (S : Scheme.{u}) :
    hTopology.over S = (hPrecoverage.over S).toCoverage.toGrothendieck := by
  rw [hTopology_eq_toGrothendieck, over_toGrothendieck_eq_toGrothendieck_comap_forget,
    Precoverage.toGrothendieck_toCoverage]

private lemma finiteType_h_refine_generators (S : Scheme.{u}) [QuasiSeparatedSpace S]
    {X : S.FiniteType}
    {R : Presieve ((MorphismProperty.Over.forget _ ⊤ S).obj X)}
    (hR : R ∈ (hPrecoverage.over S).toCoverage _) :
    ∃ T : Sieve X,
      T ∈ ((hPrecoverage.over S).toCoverage.toPrecoverage.comap
        (MorphismProperty.Over.forget
          (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S)).toGrothendieck X ∧
      T.functorPushforward (MorphismProperty.Over.forget _ ⊤ S) ∈
        (hPrecoverage.over S).toCoverage.toGrothendieck _ ∧
      T ≤ (Sieve.generate R).functorPullback
        (MorphismProperty.Over.forget _ ⊤ S) := by
  obtain ⟨Q, hQ, hle⟩ := exists_finiteType_h_refinement S hR
  refine ⟨Sieve.generate Q, Precoverage.generate_mem_toGrothendieck hQ, ?_, ?_⟩
  · rw [← Sieve.generate_map_eq_functorPushforward]
    exact Coverage.Saturate.of _ _ hQ
  · rw [Sieve.generate_le_iff]
    exact fun Z g hg ↦ hle _ _ ⟨hg⟩

/-- Over a quasi-separated base, the generated finite-type h-topology equals the topology
restricted from the big h-site of schemes over the base. -/
theorem finiteTypeHTopology_eq_restrictedTopology (S : Scheme.{u}) [QuasiSeparatedSpace S] :
    finiteTypeHTopology S =
      Functor.restrictedTopology
        (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S)
        (hTopology.over S) := by
  rw [finiteTypeHTopology_eq_comap_toGrothendieck, hTopology_over_eq_toGrothendieck]
  exact Coverage.toGrothendieck_comap_eq_restrictedTopology_of_refine_generators
    (hPrecoverage.over S).toCoverage
    (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S)
    (finiteType_h_refine_generators S)

/-- Over a quasi-separated base, a sieve in the finite-type h-site is covering exactly when
its pushforward to all schemes over the base is covering for the big h-topology. -/
theorem mem_finiteTypeHTopology_iff (S : Scheme.{u}) [QuasiSeparatedSpace S]
    {X : S.FiniteType} {R : Sieve X} :
    R ∈ finiteTypeHTopology S X ↔
      R.functorPushforward
        (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S) ∈
          hTopology.over S ((MorphismProperty.Over.forget _ ⊤ S).obj X) := by
  rw [finiteTypeHTopology_eq_comap_toGrothendieck, hTopology_over_eq_toGrothendieck]
  exact Coverage.mem_toGrothendieck_comap_iff_of_refine_generators
    (hPrecoverage.over S).toCoverage
    (MorphismProperty.Over.forget (@LocallyOfFiniteType ⊓ @QuasiCompact) ⊤ S)
    (finiteType_h_refine_generators S)

/-- Over a quasi-separated base, a family of finite-type schemes generates an h-cover
exactly when its underlying family of scheme morphisms generates a big h-cover. -/
theorem _root_.TauCeti.AlgebraicGeometry.Scheme.ofArrows_mem_finiteTypeHTopology_iff
    {S : Scheme.{u}} [QuasiSeparatedSpace S]
    {X : S.FiniteType} {ι : Type v} {Y : ι → S.FiniteType} (f : ∀ i, Y i ⟶ X) :
    Sieve.ofArrows Y f ∈ S.finiteTypeHTopology X ↔
      Sieve.ofArrows (fun i ↦ (Y i).left) (fun i ↦ (f i).left) ∈ hTopology X.left := by
  rw [mem_finiteTypeHTopology_iff, GrothendieckTopology.mem_over_iff]
  change ((Sieve.ofArrows Y f).functorPushforward
    (MorphismProperty.Over.forget _ ⊤ S)).functorPushforward (Over.forget S) ∈ _ ↔ _
  rw [← Sieve.functorPushforward_comp, ← Sieve.generate_map_eq_functorPushforward,
    map_finiteType_family]
  -- The object of the composite forgetful functor is `X.left`.
  rfl

/-- Change of base along any scheme morphism preserves finite-type h-covers between
quasi-separated bases. The functor is Mathlib's base change on morphism-property over-categories. -/
theorem Hom.finiteTypeHTopology_coverPreserving_pullback {S T : Scheme.{u}}
    [QuasiSeparatedSpace S] [QuasiSeparatedSpace T] (f : S ⟶ T) :
    CoverPreserving (finiteTypeHTopology T) (finiteTypeHTopology S)
      (MorphismProperty.Over.pullback
        (@LocallyOfFiniteType ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) ⊤ f) where
  cover_preserve {X R} hR := by
    rw [mem_finiteTypeHTopology_iff] at hR ⊢
    rw [← Sieve.functorPushforward_comp]
    -- Both composites use the same pullback of the underlying scheme over the base.
    change (R.functorPushforward (MorphismProperty.Over.forget _ ⊤ T ⋙
      Over.pullback f)) ∈ _
    rw [Sieve.functorPushforward_comp]
    exact (GrothendieckTopology.coverPreserving_overPullback hTopology f).cover_preserve hR

end AlgebraicGeometry.Scheme
