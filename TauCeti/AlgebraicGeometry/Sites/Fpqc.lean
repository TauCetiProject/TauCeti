module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import Mathlib.CategoryTheory.Comma.Over.Pullback
public import Mathlib.CategoryTheory.Sites.Over
public import TauCeti.AlgebraicGeometry.Sites.Etale.Subcanonical
public import TauCeti.CategoryTheory.Sites.ComparableTopologies
public import TauCeti.CategoryTheory.Sites.Over.Basic

/-!
# Covering sieves of the fppf topology, and fppf and fpqc sheaves are étale sheaves

Every point of a scheme lies in the image of some member of any fppf covering sieve, since the
sieve contains a jointly surjective fppf covering family. Zariski coverings are fppf coverings,
since open immersions are flat and locally of finite presentation. On the big fppf site of a
scheme `S`, the base change `T ×_S S' ⟶ T` of a surjective flat morphism `p : S' ⟶ S`, locally
of finite presentation, generates a covering sieve of `T`.

The étale topology is coarser than the fppf topology, since étale morphisms are flat and locally
of finite presentation, and hence also coarser than the fpqc topology. So on the big site
`Over S` of a scheme `S` the identity functor is continuous from the étale to the fppf and to the
fpqc topology, and Mathlib's `sheafPushforwardContinuous` regards fppf and fpqc sheaves on
`Over S` as étale sheaves. The forgetful functor `S.Etale ⥤ Over S` from the small étale site is
therefore also continuous for the fpqc topology on `Over S`, so a sheaf on the big fpqc site over
`S` restricts to a sheaf on the small étale site of `S`.

## Main results

* `AlgebraicGeometry.Scheme.exists_mem_range_of_mem_fppfTopology`: fppf covering sieves of a
  scheme are jointly surjective.
* `AlgebraicGeometry.Scheme.zariskiTopology_le_fppfTopology`: Zariski coverings are fppf
  coverings.
* `AlgebraicGeometry.Scheme.Hom.generate_singleton_counit_mem_fppfTopology_over`: the base change
  `T ×_S S' ⟶ T` of an fppf morphism generates a covering sieve of the big fppf site.
* `AlgebraicGeometry.Scheme.etaleTopology_le_fppfTopology`: étale coverings are fppf coverings.
* the instances `(𝟭 (Over S)).IsContinuous (etaleTopology.over S) (fppfTopology.over S)` and
  `(𝟭 (Over S)).IsContinuous (etaleTopology.over S) (fpqcTopology.over S)`.
* `AlgebraicGeometry.Scheme.restrictSmallEtale S`: the restriction functor from sheaves on the big
  fpqc site over `S` to sheaves on the small étale site of `S`.
-/

public section

open CategoryTheory

namespace AlgebraicGeometry.Scheme

universe v u

/-- **Fppf covers are jointly surjective.** Every point of a scheme lies in the image of some
member of any fppf covering sieve. -/
theorem exists_mem_range_of_mem_fppfTopology {T : Scheme.{u}} {S : Sieve T}
    (hS : S ∈ fppfTopology T) (t : T) :
    ∃ (Y : Scheme.{u}) (g : Y ⟶ T), S g ∧ t ∈ Set.range g := by
  have : fppfPrecoverage.HasIsos := ⟨fun f _ ↦ f.singleton_mem_fppfPrecoverage⟩
  rw [Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hS
  obtain ⟨R, ⟨hsurj, -⟩, hRS⟩ := hS
  obtain ⟨_, _, hg, ht⟩ := hsurj t
  cases hg with
  | @of Y g hg => exact ⟨Y, g, hRS Y g hg, ht⟩

/-- **Zariski coverings are fppf coverings**: the big Zariski topology is coarser than the big
fppf topology, as open immersions are flat and locally of finite presentation. Combined with
`AlgebraicGeometry.Scheme.Cover.mem_grothendieckTopology`, the sieve generated by an open cover is
an fppf covering sieve. -/
theorem zariskiTopology_le_fppfTopology : zariskiTopology.{u} ≤ fppfTopology.{u} :=
  Precoverage.toGrothendieck_mono zariskiPrecoverage_le_fppfPrecoverage

/-- **Étale coverings are fppf coverings**: the big étale topology is coarser than the big fppf
topology, as étale morphisms are flat and locally of finite presentation. -/
theorem etaleTopology_le_fppfTopology : etaleTopology.{u} ≤ fppfTopology.{u} :=
  Precoverage.toGrothendieck_mono (precoverage_mono fun _ _ _ _ ↦ ⟨inferInstance, inferInstance⟩)

/-- Every sheaf on the big fppf site `Over S` is a sheaf for the étale topology, which is
coarser. -/
instance (S : Scheme.{u}) :
    (𝟭 (Over S)).IsContinuous (etaleTopology.over S) (fppfTopology.over S) :=
  TauCeti.CategoryTheory.isContinuous_id_of_le
    (GrothendieckTopology.over_mono etaleTopology_le_fppfTopology S)

/-- Every sheaf on the big fpqc site `Over S` is a sheaf for the étale topology, which is
coarser. -/
instance (S : Scheme.{u}) :
    (𝟭 (Over S)).IsContinuous (etaleTopology.over S) (fpqcTopology.over S) :=
  TauCeti.CategoryTheory.isContinuous_id_of_le <| GrothendieckTopology.over_mono
    (etaleTopology_le_proetaleTopology.trans proetaleTopology_le_fpqcTopology) S

/-- The forgetful functor from the small étale site of `S` to the big site `Over S` is continuous
for the small étale topology and the fpqc topology on `Over S`: it is continuous for the étale
topology on `Over S`, which is coarser than the fpqc topology. -/
instance isContinuous_etaleForget_fpqcTopology (S : Scheme.{u}) :
    (Etale.forget S).IsContinuous (smallEtaleTopology S) (fpqcTopology.over S) :=
  Functor.isContinuous_comp (Etale.forget S) (𝟭 (Over S)) (smallEtaleTopology S)
    (etaleTopology.over S) (fpqcTopology.over S)

/-- The restriction of sheaves on the big fpqc site over `S` to the small étale site of `S`, along
the forgetful functor `S.Etale ⥤ Over S`. -/
noncomputable abbrev restrictSmallEtale (S : Scheme.{u}) {A : Type*} [Category.{v} A] :
    Sheaf (fpqcTopology.over S) A ⥤ Sheaf (smallEtaleTopology S) A :=
  (Etale.forget S).sheafPushforwardContinuous A (smallEtaleTopology S) (fpqcTopology.over S)

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme.Hom

open Limits

universe u

variable {S S' : Scheme.{u}} (p : S' ⟶ S)

/-- The base change `T ×_S S' ⟶ T` of a surjective flat morphism `p : S' ⟶ S`, locally of finite
presentation, generates a covering sieve of `T` on the big fppf site of `S`. -/
theorem generate_singleton_counit_mem_fppfTopology_over [Surjective p] [Flat p]
    [LocallyOfFinitePresentation p] (T : Over S) :
    Sieve.generate (.singleton ((Over.mapPullbackAdj p).counit.app T)) ∈
      (fppfTopology.over S) T := by
  rw [← Presieve.ofArrows_pUnit.{0}, GrothendieckTopology.mem_over_iff,
    Sieve.overEquiv_ofArrows]
  refine Precoverage.generate_mem_toGrothendieck ?_
  rw [Presieve.ofArrows_pUnit, Over.mapPullbackAdj_counit_app]
  exact (pullback.fst T.hom p).singleton_mem_fppfPrecoverage

end AlgebraicGeometry.Scheme.Hom
