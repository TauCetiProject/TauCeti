module

public import Mathlib.AlgebraicGeometry.Morphisms.Proper
public import Mathlib.AlgebraicGeometry.Sites.BigZariski

/-!
# The big h-topology

The h-topology on schemes is generated by Zariski covering families and proper surjective
morphisms. We follow the convention of Orgogozo in ILO, Exposé XII-A, §2.1.3. The Stacks Project
calls this the ph-topology in Tag 0DBC.

The generating precoverage allows any nonempty family of proper surjections. This gives the
same topology as singleton proper surjections, and makes the precoverage stable under arbitrary
choices of pullback squares, even for families with repeated arrows.

## References

* Fabrice Orgogozo, *Descente cohomologique orientée*, Exposé XII-A, §2.1.3,
  Astérisque **363–364** (2014), <https://www.numdam.org/item/AST_2014__363-364__235_0/>.
-/

public section

universe u v

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

/-- The h-topology is generated by Zariski covering presieves and nonempty presieves
consisting of proper surjections. Allowing several proper surjections ensures stability under
arbitrary choices of pullback squares without changing the topology generated by singletons. -/
def hPrecoverage : Precoverage Scheme.{u} where
  coverings X := {R | R ∈ zariskiPrecoverage X ∨
    (∃ (Y : Scheme.{u}) (f : Y ⟶ X), R f) ∧
      ∀ ⦃Y : Scheme.{u}⦄ ⦃f : Y ⟶ X⦄, R f → IsProper f ∧ Surjective f}

/-- Membership in the generating precoverage for the h-topology. -/
lemma mem_hPrecoverage_iff {X : Scheme.{u}} {R : Presieve X} :
    R ∈ hPrecoverage X ↔ R ∈ zariskiPrecoverage X ∨
      (∃ (Y : Scheme.{u}) (f : Y ⟶ X), R f) ∧
        ∀ ⦃Y : Scheme.{u}⦄ ⦃f : Y ⟶ X⦄, R f → IsProper f ∧ Surjective f :=
  Iff.rfl

/-- A family is a generator if it is a Zariski covering or is a nonempty family of proper
surjections. -/
lemma ofArrows_mem_hPrecoverage_iff {X : Scheme.{u}} {ι : Type v} {Y : ι → Scheme.{u}}
    {f : ∀ i, Y i ⟶ X} :
    Presieve.ofArrows Y f ∈ hPrecoverage X ↔
      ((∀ x, ∃ i, x ∈ Set.range (f i)) ∧ ∀ i, IsOpenImmersion (f i)) ∨
        Nonempty ι ∧ ∀ i, IsProper (f i) ∧ Surjective (f i) := by
  rw [mem_hPrecoverage_iff, ofArrows_mem_precoverage_iff]
  constructor
  · rintro (h | ⟨⟨Z, g, ⟨i⟩⟩, h⟩)
    · exact Or.inl h
    · exact Or.inr ⟨⟨i⟩, fun i ↦ h ⟨i⟩⟩
  · rintro (h | ⟨⟨i⟩, h⟩)
    · exact Or.inl h
    · exact Or.inr ⟨⟨Y i, f i, ⟨i⟩⟩, fun _ _ ⟨i⟩ ↦ h i⟩

/-- A singleton proper surjection belongs to the generating h-precoverage. -/
lemma Hom.singleton_mem_hPrecoverage {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f]
    [Surjective f] : Presieve.singleton f ∈ hPrecoverage Y :=
  mem_hPrecoverage_iff.mpr <| Or.inr
    ⟨⟨X, f, .mk⟩, fun _ _ ⟨⟩ ↦ ⟨inferInstance, inferInstance⟩⟩

instance : hPrecoverage.{u}.IsStableUnderBaseChange where
  mem_coverings_of_isPullback {ι} S X f hf Y g P p₁ p₂ h := by
    rw [mem_hPrecoverage_iff] at hf ⊢
    rcases hf with hf | ⟨⟨Z, a, ha⟩, hf⟩
    · exact Or.inl (Precoverage.mem_coverings_of_isPullback f hf g p₁ p₂ h)
    · obtain ⟨i⟩ := ha
      refine Or.inr ⟨⟨_, p₁ i, ⟨i⟩⟩, ?_⟩
      rintro W a ⟨j⟩
      exact ⟨MorphismProperty.of_isPullback (h j).flip (hf ⟨j⟩).1,
        MorphismProperty.of_isPullback (h j).flip (hf ⟨j⟩).2⟩

/-- The h-topology on the category of all schemes, generated by Zariski covers and proper
surjections. -/
def hTopology : GrothendieckTopology Scheme.{u} :=
  hPrecoverage.toGrothendieck

/-- The h-topology is generated by its base-change-stable precoverage. -/
lemma hTopology_eq_toGrothendieck :
    hTopology.{u} = hPrecoverage.toGrothendieck := by
  rfl

/-- The h-topology contains the Zariski topology. -/
lemma zariskiTopology_le_hTopology : zariskiTopology.{u} ≤ hTopology := by
  rw [zariskiTopology, grothendieckTopology, Precoverage.toGrothendieck_eq_sInf]
  exact sInf_le (fun _ _ h ↦ .of _ _ (Or.inl h))

/-- Every proper surjection is an h-cover. -/
lemma Hom.singleton_mem_hTopology {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f]
    [Surjective f] : Sieve.generate (Presieve.singleton f) ∈ hTopology Y :=
  Precoverage.generate_mem_toGrothendieck f.singleton_mem_hPrecoverage

/-- The h-topology is the least topology containing Zariski covers and singleton proper
surjections. -/
lemma hTopology_le_iff (J : GrothendieckTopology Scheme.{u}) :
    hTopology ≤ J ↔ zariskiTopology ≤ J ∧
      ∀ ⦃X Y : Scheme.{u}⦄ (f : X ⟶ Y), IsProper f → Surjective f →
        Sieve.generate (Presieve.singleton f) ∈ J Y := by
  constructor
  · intro h
    refine ⟨zariskiTopology_le_hTopology.trans h, ?_⟩
    intro X Y f hf hs
    let := hf
    let := hs
    exact h _ f.singleton_mem_hTopology
  · rintro ⟨hZ, hP⟩
    rw [hTopology, Precoverage.toGrothendieck_eq_sInf]
    apply sInf_le
    intro X R hR
    rcases hR with hR | ⟨⟨Y, f, hf⟩, hR⟩
    · exact hZ _ (Precoverage.generate_mem_toGrothendieck hR)
    · exact J.superset_covering (Sieve.generate_mono ((Presieve.singleton_le_iff f).mpr hf))
        (hP f (hR hf).1 (hR hf).2)

/-- Every h-covering sieve is jointly surjective on scheme points. -/
lemma hTopology_le_jointlySurjectiveTopology :
    hTopology.{u} ≤ jointlySurjectiveTopology := by
  rw [hTopology, jointlySurjectiveTopology_eq_toGrothendieck_jointlySurjectivePretopology,
    jointlySurjectivePretopology, Precoverage.toGrothendieck_toPretopology_eq_toGrothendieck]
  apply Precoverage.toGrothendieck_mono
  rintro X R (hR | ⟨⟨Y, f, hf⟩, hR⟩)
  · exact hR.1
  · rw [Presieve.mem_comap_jointlySurjectivePrecoverage_iff]
    exact fun x ↦ ⟨Y, f, hf, (hR hf).2.surj x⟩

/-- Every point lifts along some arrow of an h-covering sieve. -/
lemma exists_preimage_of_mem_hTopology {X : Scheme.{u}} {R : Sieve X}
    (hR : R ∈ hTopology X) (x : X) :
    ∃ (Y : Scheme.{u}) (f : Y ⟶ X), R f ∧ x ∈ Set.range f :=
  (Presieve.mem_comap_jointlySurjectivePrecoverage_iff Scheme.forget).mp
    (hTopology_le_jointlySurjectiveTopology _ hR) x


/-- Every h-covering family is jointly surjective on scheme points. -/
lemma jointlySurjective_of_mem_hTopology {X : Scheme.{u}} {ι : Type v}
    {Y : ι → Scheme.{u}} {f : ∀ i, Y i ⟶ X}
    (h : Sieve.ofArrows Y f ∈ hTopology X) (x : X) :
    ∃ i, x ∈ Set.range (f i) := by
  obtain ⟨Z, g, ⟨W, a, b, ⟨i⟩, e⟩, z, hz⟩ := exists_preimage_of_mem_hTopology h x
  exact ⟨i, a z, by rw [← Scheme.Hom.comp_apply, e, hz]⟩

private lemma exists_finite_refinement_of_mem_hPrecoverage {X : Scheme.{u}} [CompactSpace X]
    {R : Presieve X} (hR : R ∈ hPrecoverage X) :
    ∃ (ι : Type u) (_ : Finite ι) (Y : ι → Scheme.{u}) (f : ∀ i, Y i ⟶ X),
      (∀ i, CompactSpace (Y i)) ∧ (∀ i, Sieve.generate R (f i)) ∧
        Sieve.ofArrows Y f ∈ hTopology X := by
  classical
  rcases hR with hR | ⟨⟨Y, f, hf⟩, hR⟩
  · obtain ⟨(𝒰 : OpenCover.{u + 1} X), rfl⟩ := exists_cover_of_mem_pretopology hR
    let 𝒜 := OpenCover.affineRefinement.{u, u + 1} 𝒰
    let 𝒱 := 𝒜.openCover.finiteSubcover
    let : ∀ i, IsAffine (𝒜.openCover.X i) := fun i ↦ isAffine_affineOpenCover X 𝒜 i
    refine ⟨𝒱.I₀, inferInstance, 𝒱.X, 𝒱.f, ?_, ?_, ?_⟩
    · intro i
      exact compactSpace_of_isAffine (𝒜.openCover.finiteSubcover.X i)
    · intro i
      exact ⟨_, _, _, ⟨_⟩, ((OpenCover.fromAffineRefinement.{u, u + 1} 𝒰).w₀ _).symm⟩
    · exact zariskiTopology_le_hTopology _ 𝒱.mem_grothendieckTopology
  · have := (hR hf).1
    have := (hR hf).2
    refine ⟨PUnit, inferInstance, fun _ ↦ Y, fun _ ↦ f, ?_, ?_, ?_⟩
    · exact fun _ ↦ QuasiCompact.compactSpace_of_compactSpace f
    · exact fun _ ↦ Sieve.le_generate R _ _ hf
    · simpa only [Sieve.ofArrows, Presieve.ofArrows_pUnit] using f.singleton_mem_hTopology

/-- Every h-covering sieve of a quasi-compact scheme admits a finite jointly surjective
h-covering refinement by quasi-compact schemes. -/
lemma exists_finite_refinement_of_mem_hTopology {X : Scheme.{u}} [CompactSpace X]
    {R : Sieve X} (hR : R ∈ hTopology X) :
    ∃ (ι : Type u) (_ : Finite ι) (Y : ι → Scheme.{u}) (f : ∀ i, Y i ⟶ X),
      (∀ i, CompactSpace (Y i)) ∧ (∀ i, R (f i)) ∧
        Sieve.ofArrows Y f ∈ hTopology X ∧ ∀ x, ∃ i, x ∈ Set.range (f i) := by
  classical
  suffices ∃ (ι : Type u) (_ : Finite ι) (Y : ι → Scheme.{u}) (f : ∀ i, Y i ⟶ X),
      (∀ i, CompactSpace (Y i)) ∧ (∀ i, R (f i)) ∧ Sieve.ofArrows Y f ∈ hTopology X by
    obtain ⟨ι, hι, Y, f, hY, hf, hcov⟩ := this
    exact ⟨ι, hι, Y, f, hY, hf, hcov, jointlySurjective_of_mem_hTopology hcov⟩
  rw [hTopology_eq_toGrothendieck, ← Precoverage.toGrothendieck_toCoverage,
    Coverage.mem_toGrothendieck] at hR
  suffices ∀ (_ : CompactSpace X),
      ∃ (ι : Type u) (_ : Finite ι) (Y : ι → Scheme.{u}) (f : ∀ i, Y i ⟶ X),
        (∀ i, CompactSpace (Y i)) ∧ (∀ i, R (f i)) ∧
          Sieve.ofArrows Y f ∈ hTopology X from this inferInstance
  induction hR with
  | of X R hR => exact fun _ ↦ exists_finite_refinement_of_mem_hPrecoverage hR
  | top X =>
    intro hX
    refine ⟨PUnit, inferInstance, fun _ ↦ X, fun _ ↦ 𝟙 X, fun _ ↦ hX, fun _ ↦ trivial, ?_⟩
    simpa only [Sieve.ofArrows, Presieve.ofArrows_pUnit,
      Sieve.generate_of_singleton_isSplitEpi] using hTopology.top_mem X
  | transitive X R S _ _ ihR ihS =>
    intro hX
    obtain ⟨ι, hι, Y, f, hY, hf, hfcov⟩ := ihR hX
    choose σ hσ Z g hZ hg hgcov using fun i ↦ ihS (hf i) (hY i)
    let : ∀ i, Finite (σ i) := hσ
    refine ⟨Σ i, σ i, inferInstance, fun p ↦ Z p.1 p.2,
      fun p ↦ g p.1 p.2 ≫ f p.1, fun p ↦ hZ p.1 p.2, fun p ↦ hg p.1 p.2, ?_⟩
    rw [Sieve.ofArrows, ← Presieve.bindOfArrows_ofArrows]
    exact hTopology.bindOfArrows hfcov hgcov

end AlgebraicGeometry.Scheme
