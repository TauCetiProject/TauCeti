module

public import Mathlib.AlgebraicGeometry.Sites.SheafQuasiCompact
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.Basic
public import TauCeti.AlgebraicGeometry.Sites.Big.FaithfullyFlat
public import TauCeti.AlgebraicGeometry.Sites.Big.Zariski
public import TauCeti.CategoryTheory.Sites.Over

/-!
# The big fpqc sheaf of a quasi-coherent module

Let `S` be a scheme and `F` a quasi-coherent `𝒪_S`-module. This file proves that the presheaf of
modules `AlgebraicGeometry.Scheme.Modules.bigPresheaf F : (T, h) ↦ Γ(T, h^* F)` on the big site
`Over S` is a sheaf for the fpqc topology
(`AlgebraicGeometry.Scheme.Modules.isSheaf_bigPresheaf_fpqcTopology`; Stacks, Lemma 35.8.1), and
hence for every coarser topology, such as the Zariski, étale and fppf topologies
(`AlgebraicGeometry.Scheme.Modules.isSheaf_bigPresheaf_of_le`). This defines the module
`F^a = bigSheaf F` over the big structure sheaf `T ↦ Γ(T, 𝒪_T)`, and the functor
`bigSheafFunctor S` from quasi-coherent `𝒪_S`-modules to these big-site modules.

The proof moves the presheaf from `Over S` to the category of all schemes: the presheaf
`T ↦ Σ (h : T ⟶ S), Γ(T, h^* F)` (`CategoryTheory.Over.sigmaPresheaf`) is a sheaf for a
subcanonical topology exactly when `bigPresheaf F` is a sheaf for the induced topology on
`Over S` (`CategoryTheory.Over.isSheaf_over_iff_isSheaf_sigmaPresheaf`). Mathlib's
`AlgebraicGeometry.isSheaf_type_propQCTopology_iff` (Stacks, Tag 022H) then reduces the fpqc sheaf
property of that presheaf to the Zariski sheaf property
(`AlgebraicGeometry.Scheme.Modules.isSheaf_bigPresheaf_zariskiTopology`) and descent along a
single faithfully flat map of affine schemes
(`AlgebraicGeometry.Scheme.Modules.isSheafFor_bigPresheaf_singleton_of_flat_of_surjective`).

## Main declarations

* `AlgebraicGeometry.Scheme.Modules.isSheaf_bigPresheaf_fpqcTopology`: `bigPresheaf F` is a
  sheaf for the fpqc topology on `Over S`.
* `AlgebraicGeometry.Scheme.Modules.isSheaf_bigPresheaf_of_le`: the same for every topology
  coarser than the fpqc topology.
* `AlgebraicGeometry.Scheme.Modules.bigSheaf`: the module `F^a` on the big fpqc site of `S`, an
  object of `SheafOfModules (bigRingCatSheaf S)`.
* `AlgebraicGeometry.Scheme.bigSheafFunctor`: the functor `F ↦ F^a` on quasi-coherent
  `𝒪_S`-modules.

## References

* The Stacks Project, Section 35.8, *Quasi-coherent sheaves and topologies*,
  [Lemma 35.8.1 (023M)](https://stacks.math.columbia.edu/tag/023M), and
  [Tag 022H](https://stacks.math.columbia.edu/tag/022H).
-/

public section

open CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Scheme

namespace Modules

variable {S : Scheme.{u}} (F : S.Modules) [F.IsQuasicoherent]

/-- The presheaf `T ↦ Σ (h : T ⟶ S), Γ(T, h^* F)` on schemes attached to `bigPresheaf F`
satisfies the sheaf condition for a single faithfully flat morphism `Spec R' ⟶ Spec R`. -/
private lemma isSheafFor_sigmaPresheaf_bigPresheaf_singleton {R R' : CommRingCat.{u}}
    (f : R ⟶ R') [Flat (Spec.map f)] [Surjective (Spec.map f)] :
    Presieve.IsSheafFor
      (Over.sigmaPresheaf (F.bigPresheaf.presheaf ⋙ CategoryTheory.forget AddCommGrpCat))
      (.singleton (Spec.map f)) := by
  rw [Presieve.isSheafFor_iff_generate, ← Presieve.ofArrows_pUnit.{0}]
  refine Over.isSheafFor_sigmaPresheaf (Sieve.ofArrows _ fun _ ↦ Spec.map f) ?_ fun h ↦ ?_
  · refine GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (J := fpqcTopology) _ _ ?_
    rw [Sieve.ofArrows, Presieve.ofArrows_pUnit, fpqcTopology_eq_propQCTopology]
    exact (Spec.map f).generate_singleton_mem_propQCTopology (P := @Flat) inferInstance
  · -- Over `(Spec R, h)`, the sieve is generated by the single morphism `Spec.map f` over `S`.
    let g : Over.mk (Spec.map f ≫ h) ⟶ Over.mk h := Over.homMk (Spec.map f) rfl
    have hsieve :
        (Sieve.overEquiv (Over.mk h)).symm (Sieve.ofArrows _ fun _ : PUnit.{1} ↦ Spec.map f) =
          Sieve.ofArrows _ fun _ : PUnit.{1} ↦ g :=
      (Sieve.overEquiv _).symm_apply_eq.mpr
        (Sieve.overEquiv_ofArrows (fun _ : PUnit.{1} ↦ Over.mk (Spec.map f ≫ h)) fun _ ↦ g).symm
    rw [hsieve, Sieve.ofArrows, ← Presieve.isSheafFor_iff_generate, Presieve.ofArrows_pUnit]
    have : IsAffine (Over.mk h).left := inferInstanceAs (IsAffine (Spec R))
    have : IsAffine (Over.mk (Spec.map f ≫ h)).left := inferInstanceAs (IsAffine (Spec R'))
    have : Flat g.left := inferInstanceAs (Flat (Spec.map f))
    have : Surjective g.left := inferInstanceAs (Surjective (Spec.map f))
    exact isSheafFor_bigPresheaf_singleton_of_flat_of_surjective F g

/-- **fpqc descent of sections of quasi-coherent modules.** For a quasi-coherent `𝒪_S`-module `F`,
the presheaf `(T, h) ↦ Γ(T, h^* F)` underlying `bigPresheaf F` is a sheaf for the fpqc topology on
the big site `Over S` (Stacks, Lemma 35.8.1). -/
theorem isSheaf_bigPresheaf_fpqcTopology :
    Presheaf.IsSheaf (fpqcTopology.over S) F.bigPresheaf.presheaf := by
  refine Presheaf.isSheaf_of_isSheaf_comp _ _ (CategoryTheory.forget AddCommGrpCat.{u}) ?_
  have hS (J : GrothendieckTopology Scheme.{u}) [J.Subcanonical] :
      Presieve.IsSheaf J (yoneda.obj S) :=
    GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _
  -- Default instance search does not match Mathlib's generic source-locality instance here;
  -- apply that existing instance explicitly rather than declaring a specialized copy for `Flat`.
  have : IsZariskiLocalAtSource @Flat.{u} :=
    HasRingHomProperty.instIsZariskiLocalAtSource (Q := @RingHom.Flat)
  rw [isSheaf_iff_isSheaf_of_type, Over.isSheaf_over_iff_isSheaf_sigmaPresheaf _ (hS _)]
  -- Rewrite the topology of the sheaf condition on `Scheme`, leaving `fpqcTopology` inside
  -- `bigPresheaf` unchanged: its module coefficients use the existing big structure sheaf.
  -- Rewriting those implicit occurrences makes the motive for `bigRingCatSheaf.obj` ill-typed.
  rw (occs := .pos [1]) [fpqcTopology_eq_propQCTopology]
  refine (isSheaf_type_propQCTopology_iff (P := @Flat) _).mpr ⟨?_, fun f hf hs ↦ ?_⟩
  · rw [← Over.isSheaf_over_iff_isSheaf_sigmaPresheaf _ (hS _), ← isSheaf_iff_isSheaf_of_type]
    exact Presheaf.isSheaf_comp_of_isSheaf _ _ _ (isSheaf_bigPresheaf_zariskiTopology F)
  · have : Flat (Spec.map f) := hf
    exact isSheafFor_sigmaPresheaf_bigPresheaf_singleton F f

/-- For a quasi-coherent `𝒪_S`-module `F`, the presheaf `(T, h) ↦ Γ(T, h^* F)` underlying
`bigPresheaf F` is a sheaf for every topology on schemes coarser than the fpqc topology, such as
the Zariski, étale and fppf topologies. -/
theorem isSheaf_bigPresheaf_of_le {J : GrothendieckTopology Scheme.{u}} (hJ : J ≤ fpqcTopology) :
    Presheaf.IsSheaf (J.over S) F.bigPresheaf.presheaf :=
  fun E ↦ Presieve.isSheaf_of_le _ (fun _ _ hR ↦ hJ _ hR) (isSheaf_bigPresheaf_fpqcTopology F E)

/-- The module `F^a : (T, h) ↦ Γ(T, h^* F)` on the big fpqc site of `S` attached to a
quasi-coherent `𝒪_S`-module `F`, a module over the big structure sheaf `T ↦ Γ(T, 𝒪_T)`. -/
-- Exposed so that the morphisms of `bigSheafFunctor` have the underlying presheaf types.
@[expose]
noncomputable def bigSheaf : SheafOfModules.{u} (bigRingCatSheaf S) where
  val := F.bigPresheaf
  isSheaf := isSheaf_bigPresheaf_fpqcTopology F

/-- The underlying presheaf of modules of `bigSheaf F` is `bigPresheaf F`. -/
@[simp]
lemma bigSheaf_val : (bigSheaf F).val = F.bigPresheaf :=
  rfl

end Modules

open TauCeti.AlgebraicGeometry in
/-- The functor `F ↦ F^a = bigSheaf F` from quasi-coherent `𝒪_S`-modules to modules over the big
structure sheaf of `S` on the big fpqc site. A morphism `φ : F ⟶ G` acts on `Γ(T, h^* F)` through
`h^* φ`. -/
-- Exposed so that `bigSheafFunctor_map_val` compares morphisms of the same presheaves.
@[expose]
noncomputable def bigSheafFunctor (S : Scheme.{u}) :
    QuasicoherentSheaf S ⥤ SheafOfModules.{u} (bigRingCatSheaf S) where
  obj F := Modules.bigSheaf F.obj
  map φ := ⟨(bigPresheafFunctor S).map φ.hom⟩
  map_id F := SheafOfModules.Hom.ext ((bigPresheafFunctor S).map_id F.obj)
  map_comp φ ψ := SheafOfModules.Hom.ext ((bigPresheafFunctor S).map_comp φ.hom ψ.hom)

open TauCeti.AlgebraicGeometry in
/-- The value of `bigSheafFunctor S` on a quasi-coherent module `F` is `bigSheaf F`. -/
@[simp]
lemma bigSheafFunctor_obj (S : Scheme.{u}) (F : QuasicoherentSheaf S) :
    (bigSheafFunctor S).obj F = Modules.bigSheaf F.obj :=
  rfl

open TauCeti.AlgebraicGeometry in
/-- A morphism `φ : F ⟶ G` of quasi-coherent modules acts on the big-site modules through
`bigPresheafFunctor`, that is, through `h^* φ` on `Γ(T, h^* F)`. -/
@[simp]
lemma bigSheafFunctor_map_val {S : Scheme.{u}} {F G : QuasicoherentSheaf S} (φ : F ⟶ G) :
    ((bigSheafFunctor S).map φ).val = (bigPresheafFunctor S).map φ.hom :=
  rfl

end AlgebraicGeometry.Scheme
