module

public import Mathlib.AlgebraicGeometry.Sites.Etale
public import TauCeti.AlgebraicGeometry.Sites.Small
public import TauCeti.CategoryTheory.Sites.Precoverage

/-!
# Covering sieves of the étale sites

Every covering sieve of the big étale site `Over S` of a scheme `S : Scheme.{u}` contains a
covering sieve generated by a family indexed by a type in `Type u`. This lets constructions
using small covering families handle arbitrary covering sieves of this site.

On the small étale site of the empty scheme every sieve covers
(`AlgebraicGeometry.Scheme.smallEtaleTopology_eq_top_of_isEmpty`), and every covering sieve of the
terminal object `Etale.mk (𝟙 S)` yields a `Type u`-indexed jointly surjective family of nonempty
étale `S`-schemes (`AlgebraicGeometry.Scheme.exists_etaleCover_of_mem_smallEtaleTopology_terminal`).
-/

public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme

variable (S : Scheme.{u})

/-- Every covering sieve of the étale topology on `Over S` contains a covering sieve generated by
a family indexed by a type in `Type u`. -/
theorem exists_ofArrows_le_of_mem_etaleTopology_over {U : Over S} {R : Sieve U}
    (hR : R ∈ (etaleTopology.over S) U) :
    ∃ (ι : Type u) (X : ι → Over S) (f : ∀ i, X i ⟶ U),
      Sieve.ofArrows X f ∈ (etaleTopology.over S) U ∧ Sieve.ofArrows X f ≤ R := by
  -- The instances for `precoverage P` are not found for `P = @Etale` directly, whose binders differ
  -- from those of `MorphismProperty`, so they are instantiated by hand.
  have := (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] ↦
    (inferInstance : (precoverage P).IsStableUnderBaseChange)) @Etale
  have := (fun (P : MorphismProperty Scheme.{u}) ↦
    (inferInstance : Precoverage.Small.{u} (precoverage P))) @Etale
  rw [over_toGrothendieck_eq_toGrothendieck_comap_forget] at hR ⊢
  exact Precoverage.exists_ofArrows_le_of_mem_toGrothendieck _ hR

/-- On the small étale site of the empty scheme `S`, every sieve covers. -/
theorem smallEtaleTopology_eq_top_of_isEmpty [IsEmpty S] : smallEtaleTopology S = ⊤ :=
  smallGrothendieckTopology_eq_top_of_isEmpty S

/-- A covering sieve on the terminal étale `S`-scheme `Etale.mk (𝟙 S)` yields a `Type u`-indexed
jointly surjective family of nonempty étale `S`-schemes whose morphisms to `Etale.mk (𝟙 S)` lie in
the sieve. -/
theorem exists_etaleCover_of_mem_smallEtaleTopology_terminal {S : Scheme.{u}}
    {R : Sieve (Etale.mk (𝟙 S))} (hR : R ∈ smallEtaleTopology S (Etale.mk (𝟙 S))) :
    ∃ (ι : Type u) (U : ι → Scheme.{u}) (u : ∀ i, U i ⟶ S) (hu : ∀ i, Etale (u i)),
      (∀ i, Nonempty (U i)) ∧
        (∀ i, ∃ g : @Etale.mk S (U i) (u i) (hu i) ⟶ Etale.mk (𝟙 S), R g) ∧
        (⋃ i, Set.range (u i) = .univ) := by
  obtain ⟨ι', V, g', heq⟩ := R.exists_eq_ofArrows
  have hcov := (ofArrows_mem_smallEtaleTopology_iff g').mp (heq ▸ hR)
  have hg' (j : ι') : ((g' j).left : (V j).left ⟶ S) = (V j).hom :=
    (Category.comp_id _).symm.trans (CategoryTheory.Over.w ((Etale.forget S).map (g' j)))
  choose idx hidx using fun s : S ↦ Set.mem_iUnion.mp (hcov ▸ Set.mem_univ s)
  refine ⟨S, fun s ↦ (V (idx s)).left, fun s ↦ (V (idx s)).hom, fun s ↦ (V (idx s)).prop,
    fun s ↦ ?_, fun s ↦ ?_, Set.eq_univ_of_forall fun s ↦ ?_⟩
  · obtain ⟨z, -⟩ := hidx s
    exact ⟨z⟩
  · exact ⟨g' (idx s), heq.symm ▸ Sieve.ofArrows_mk V g' (idx s)⟩
  · obtain ⟨z, hz⟩ := hidx s
    exact Set.mem_iUnion.mpr ⟨s, z, (congrArg (fun f : (V (idx s)).left ⟶ S ↦ f z)
      (hg' (idx s)).symm).trans hz⟩

end AlgebraicGeometry.Scheme
