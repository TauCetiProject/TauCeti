module

public import TauCeti.AlgebraicGeometry.Curves.StableReduction.Fibers
public import TauCeti.AlgebraicGeometry.Curves.StableReduction.Model.NumericalType
public import TauCeti.AlgebraicGeometry.Curves.StableReduction.Picard.DegreeZero
public import TauCeti.AlgebraicGeometry.IntersectionNumber.Specialization

/-!
# Specialization of line bundles to the Picard group of a numerical type

Let `X` be a regular Noetherian integral scheme, proper and flat over a local ring `R` of dimension
at most one whose maximal ideal is generated by a nonzerodivisor `π`, with residue field `k`,
connected special fibre `X_s`, reduced special fibre `X_{s,red} = V(√(ker(𝒪_X → (X_s)_* 𝒪_{X_s})))`,
all points of codimension at most two, generic point away from the closed point, and
finite-dimensional `H¹` on each component of the special fibre. Let
`T = toBase.specialFiberNumericalType hX hη hC hπ hreg hconn`, with weights `wᵢ = [κᵢ : k]` and
multiplicities `mᵢ`.

Following [Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y), the
multidegree homomorphisms `Pic(X) → Pic(X_s) → Pic(X_{s,red}) → (T.Component → ℤ)` from
`TauCeti.AlgebraicGeometry.IntersectionNumber.Specialization`
(`AlgebraicGeometry.Scheme.Hom.reducedSpecialFiberMultidegree`,
`AlgebraicGeometry.Scheme.Hom.specialFiberMultidegreeOnFiber`, and
`AlgebraicGeometry.Scheme.Hom.specialFiberMultidegree`) descend modulo `T.principalDivisors` to
**specialization** homomorphisms `Pic(X) → Pic(X_s) → Pic(X_{s,red}) → T.Pic` killing all
vertical component bundles `𝒪_X(Cⱼ)`, matching `i ↦ (a · Cᵢ)_k` under `T.picToCoker`
([Tag 0CE7](https://stacks.math.columbia.edu/tag/0CE7)), having numerical total degree
`∑ᵢ mᵢ (a · Cᵢ)_k` (so degree-zero classes land in the finite torsion group
`T.degreeZeroSubgroup`), and factoring through `Pic(X_K) → T.Pic` via the identification of
`T.Pic` with the cokernel of `specialFiberWeightedIntersectionMatrix`.

## Main definitions and results

* `AlgebraicGeometry.Scheme.Hom.specialFiberNumericalType_weightedIntersection`,
  `specialFiberNumericalTypePicEquiv`: identification of `T.weightedIntersection` with
  `specialFiberWeightedIntersectionMatrix` and of `T.Pic` with its cokernel.
* `AlgebraicGeometry.Scheme.Hom.reducedSpecialFiberPicSpecialization`,
  `specialFiberPicSpecialization`, `totalSpecialFiberPicSpecialization`,
  `genericFiberPicSpecialization`, and uniformizer-free `TauCeti.Model` counterparts
  (`reducedSpecialFiberPicSpecialization`, `specialFiberPicSpecialization`,
  `totalPicSpecialization`, `genericFiberPicSpecialization`).
* `AlgebraicGeometry.Scheme.Hom.totalSpecialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf`,
  `mem_ker_totalSpecialFiberPicSpecialization_iff`, `picToCoker_totalSpecialFiberPicSpecialization`,
  `degree_totalSpecialFiberPicSpecialization`, and
  `totalSpecialFiberPicSpecialization_mem_degreeZeroSubgroup_iff`.

## References

* [The Stacks Project, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y),
  [Tag 0CE7](https://stacks.math.columbia.edu/tag/0CE7); Q. Liu, *Algebraic Geometry and Arithmetic
  Curves*, Section 9.1.
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing Order
open Set.Finite (mem_toFinset)
open scoped Matrix
open TauCeti TauCeti.AlgebraicGeometry
open AlgebraicGeometry.Scheme.IdealSheafData (vanishingIdeal inclusion
  isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular)

universe u

namespace AlgebraicGeometry.Scheme.Hom

section LocalRing

variable {R : Type u} [CommRing R] [IsLocalRing R] [Ring.DimensionLEOne R]
  {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))
  [IsIntegral X] [IsNoetherian X] [TauCeti.AlgebraicGeometry.IsRegular X]
  [IsProper toBase] [Flat toBase]
  (hX : ∀ x : X, coheight x ≤ 2) (hη : toBase (genericPoint X) ≠ closedPoint R)
  (hC : toBase.HasFiniteDimensionalSpecialFiberComponentTrivialCohomologyOne)
  {π : R} (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π)
  (hconn : _root_.IsPreconnected (toBase ⁻¹' {closedPoint R}))

/-- The weighted intersection matrix of `specialFiberNumericalType` coincides with
`specialFiberWeightedIntersectionMatrix`. -/
theorem specialFiberNumericalType_weightedIntersection :
    (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).weightedIntersection =
      toBase.specialFiberWeightedIntersectionMatrix hX hη := by
  ext i j
  exact (NumericalType.weightedIntersection_apply _ i j).trans
    (toBase.specialFiberWeightedIntersectionMatrix_apply hX hη i j).symm

/-- The principal-divisor submodule of `specialFiberNumericalType` equals the row space of
`specialFiberWeightedIntersectionMatrix`. -/
theorem specialFiberNumericalType_principalDivisors :
    (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).principalDivisors =
      LinearMap.range (toBase.specialFiberWeightedIntersectionMatrix hX hη).vecMulLinear := by
  have h : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).principalDivisors =
      LinearMap.range (toBase.specialFiberNumericalType hX hη hC hπ hreg
        hconn).weightedIntersection.vecMulLinear := by
    ext d
    exact (NumericalType.mem_principalDivisors_iff _).trans
      (by simp only [LinearMap.mem_range, Matrix.vecMulLinear_apply])
  exact h.trans (congrArg (fun M ↦ LinearMap.range M.vecMulLinear)
    (toBase.specialFiberNumericalType_weightedIntersection hX hη hC hπ hreg hconn))

/-- Linear equivalence identifying `T.Pic` with the cokernel of
`specialFiberWeightedIntersectionMatrix`. -/
def specialFiberNumericalTypePicEquiv :
    (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Pic ≃ₗ[ℤ]
      (((toBase.finite_setOf_base_eq_closedPoint
            (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset → ℤ) ⧸
        LinearMap.range (toBase.specialFiberWeightedIntersectionMatrix hX hη).vecMulLinear) :=
  Submodule.quotEquivOfEq _ _
    (toBase.specialFiberNumericalType_principalDivisors hX hη hC hπ hreg hconn)

@[simp]
theorem specialFiberNumericalTypePicEquiv_mk
    (d : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component → ℤ) :
    toBase.specialFiberNumericalTypePicEquiv hX hη hC hπ hreg hconn (Submodule.Quotient.mk d) =
      Submodule.Quotient.mk d :=
  Submodule.quotEquivOfEq_mk _ _ _ d

@[simp]
theorem specialFiberNumericalTypePicEquiv_symm_mk
    (d : (toBase.finite_setOf_base_eq_closedPoint
      (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset → ℤ) :
    (toBase.specialFiberNumericalTypePicEquiv hX hη hC hπ hreg hconn).symm
        (Submodule.Quotient.mk d) =
      Submodule.Quotient.mk d :=
  (toBase.specialFiberNumericalTypePicEquiv hX hη hC hπ hreg hconn).symm_apply_eq.mpr
    (toBase.specialFiberNumericalTypePicEquiv_mk hX hη hC hπ hreg hconn d).symm

/-! ### Specialization to the Picard group of the numerical type -/

/-- **Specialization of line bundles from the reduced special fibre** to `T.Pic`
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)). -/
def reducedSpecialFiberPicSpecialization :
    Additive (LineBundleClass (specialFiberι R toBase).ker.radical.subscheme) →+
      (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Pic :=
  (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).principalDivisors.mkQ.toAddMonoidHom
    |>.comp (toBase.reducedSpecialFiberMultidegree hX hη
      toBase.specialFiberCohomologyFiniteDimensional_zero
      hC.finiteDimensional_one)

/-- `reducedSpecialFiberPicSpecialization` sends `a` to the quotient class of its multidegree. -/
theorem reducedSpecialFiberPicSpecialization_apply
    (a : Additive (LineBundleClass (specialFiberι R toBase).ker.radical.subscheme)) :
    toBase.reducedSpecialFiberPicSpecialization hX hη hC hπ hreg hconn a =
      Submodule.Quotient.mk (toBase.reducedSpecialFiberMultidegree hX hη
        toBase.specialFiberCohomologyFiniteDimensional_zero
        hC.finiteDimensional_one a) := by
  rw [reducedSpecialFiberPicSpecialization]
  -- `AddMonoidHom.comp_apply` fails at reducible transparency because
  -- `(specialFiberNumericalType ...).Component` unifies with the `Finset` subtype only at
  -- default transparency; `rfl` closes through `AddMonoidHom.comp`, `LinearMap.toAddMonoidHom`,
  -- and `Submodule.mkQ`.
  rfl

/-- **Specialization of line bundles from the special fibre** to `T.Pic`
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)). -/
def specialFiberPicSpecialization :
    Additive (LineBundleClass (specialFiber R toBase).left) →+
      (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Pic :=
  (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).principalDivisors.mkQ.toAddMonoidHom
    |>.comp (toBase.specialFiberMultidegreeOnFiber hX hη
      toBase.specialFiberCohomologyFiniteDimensional_zero
      hC.finiteDimensional_one)

/-- `specialFiberPicSpecialization` sends `a` to the quotient class of its multidegree. -/
theorem specialFiberPicSpecialization_apply
    (a : Additive (LineBundleClass (specialFiber R toBase).left)) :
    toBase.specialFiberPicSpecialization hX hη hC hπ hreg hconn a =
      Submodule.Quotient.mk (toBase.specialFiberMultidegreeOnFiber hX hη
        toBase.specialFiberCohomologyFiniteDimensional_zero
        hC.finiteDimensional_one a) := by
  rw [specialFiberPicSpecialization]
  -- `AddMonoidHom.comp_apply` fails at reducible transparency because
  -- `(specialFiberNumericalType ...).Component` unifies with the `Finset` subtype only at
  -- default transparency; `rfl` closes through `AddMonoidHom.comp`, `LinearMap.toAddMonoidHom`,
  -- and `Submodule.mkQ`.
  rfl

/-- `specialFiberPicSpecialization` factors through pullback to `(X_s)_red`. -/
theorem specialFiberPicSpecialization_eq_comp :
    toBase.specialFiberPicSpecialization hX hη hC hπ hreg hconn =
      (toBase.reducedSpecialFiberPicSpecialization hX hη hC hπ hreg hconn).comp
        (MonoidHom.toAdditive (LineBundleClass.pullbackHom
          (subschemeToSpecialFiber (specialFiberι R toBase).ker.le_radical))) := by
  refine AddMonoidHom.ext fun a ↦ ?_
  simp only [specialFiberPicSpecialization_apply, AddMonoidHom.comp_apply,
    reducedSpecialFiberPicSpecialization_apply, MonoidHom.toAdditive_apply_apply,
    LineBundleClass.pullbackHom_apply]
  exact congrArg Submodule.Quotient.mk
    (toBase.specialFiberMultidegreeOnFiber_eq_reducedSpecialFiberMultidegree_pullback hX hη
      toBase.specialFiberCohomologyFiniteDimensional_zero
      hC.finiteDimensional_one a.toMul)

/-- Pulling a line-bundle class on `X_s` back to `(X_s)_red` preserves its class in `T.Pic`. -/
@[simp]
theorem reducedSpecialFiberPicSpecialization_pullback
    (a : LineBundleClass (specialFiber R toBase).left) :
    toBase.reducedSpecialFiberPicSpecialization hX hη hC hπ hreg hconn (Additive.ofMul
        (LineBundleClass.pullback
          (subschemeToSpecialFiber (specialFiberι R toBase).ker.le_radical) a)) =
      toBase.specialFiberPicSpecialization hX hη hC hπ hreg hconn (Additive.ofMul a) := by
  rw [specialFiberPicSpecialization_eq_comp, AddMonoidHom.comp_apply,
    MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply]

/-- **Specialization of line bundles from the total space** `X` to `T.Pic`
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)). -/
def totalSpecialFiberPicSpecialization :
    Additive (LineBundleClass X) →+
      (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Pic :=
  (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).principalDivisors.mkQ.toAddMonoidHom
    |>.comp (toBase.specialFiberMultidegree hX hη
      toBase.specialFiberCohomologyFiniteDimensional_zero
      hC.finiteDimensional_one)

/-- `totalSpecialFiberPicSpecialization` sends `a` to the quotient class of its multidegree. -/
theorem totalSpecialFiberPicSpecialization_apply (a : Additive (LineBundleClass X)) :
    toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn a =
      Submodule.Quotient.mk (toBase.specialFiberMultidegree hX hη
        toBase.specialFiberCohomologyFiniteDimensional_zero
        hC.finiteDimensional_one a) := by
  rw [totalSpecialFiberPicSpecialization]
  -- `AddMonoidHom.comp_apply` fails at reducible transparency because
  -- `(specialFiberNumericalType ...).Component` unifies with the `Finset` subtype only at
  -- default transparency; `rfl` closes through `AddMonoidHom.comp`, `LinearMap.toAddMonoidHom`,
  -- and `Submodule.mkQ`.
  rfl

/-- `totalSpecialFiberPicSpecialization` factors through pullback to `X_s`. -/
theorem totalSpecialFiberPicSpecialization_eq_comp :
    toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn =
      (toBase.specialFiberPicSpecialization hX hη hC hπ hreg hconn).comp
        (MonoidHom.toAdditive (LineBundleClass.pullbackHom (specialFiberι R toBase))) := by
  refine AddMonoidHom.ext fun a ↦ ?_
  simp only [totalSpecialFiberPicSpecialization_apply, AddMonoidHom.comp_apply,
    specialFiberPicSpecialization_apply, MonoidHom.toAdditive_apply_apply,
    LineBundleClass.pullbackHom_apply]
  exact congrArg Submodule.Quotient.mk
    (toBase.specialFiberMultidegree_eq_specialFiberMultidegreeOnFiber_pullback hX hη
      toBase.specialFiberCohomologyFiniteDimensional_zero
      hC.finiteDimensional_one a.toMul)

/-- Pulling a line-bundle class on `X` back to `X_s` preserves its class in `T.Pic` (not `@[simp]`
because `specialFiber` is an `Over.pullback` abbreviation, so `simp` unfolds the LHS). -/
theorem specialFiberPicSpecialization_pullback (a : LineBundleClass X) :
    toBase.specialFiberPicSpecialization hX hη hC hπ hreg hconn
        (Additive.ofMul (LineBundleClass.pullback (specialFiberι R toBase) a)) =
      toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn (Additive.ofMul a) := by
  rw [totalSpecialFiberPicSpecialization_eq_comp, AddMonoidHom.comp_apply,
    MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply]

/-- Pulling a line-bundle class on `X` back to `(X_s)_red` preserves its class in `T.Pic`. -/
@[simp]
theorem reducedSpecialFiberPicSpecialization_pullback_subschemeι (a : LineBundleClass X) :
    toBase.reducedSpecialFiberPicSpecialization hX hη hC hπ hreg hconn
        (Additive.ofMul
          (LineBundleClass.pullback (specialFiberι R toBase).ker.radical.subschemeι a)) =
      toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn (Additive.ofMul a) := by
  rw [reducedSpecialFiberPicSpecialization_apply, totalSpecialFiberPicSpecialization_apply,
    toBase.reducedSpecialFiberMultidegree_pullback_subschemeι]

/-- **Vertical components vanish in `Pic(T)`.** `𝒪_X(Cⱼ)` maps to `0` under
`totalSpecialFiberPicSpecialization`
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)). -/
theorem totalSpecialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf
    (j : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component) :
    toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn (Additive.ofMul
        (LineBundleClass.mk (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
          hX j.val.property).toInvertibleSheaf)⁻¹) = 0 := by
  rw [totalSpecialFiberPicSpecialization_apply]
  refine (Submodule.Quotient.mk_eq_zero _).mpr ?_
  rw [(toBase.specialFiberMultidegree_inv_mk_toInvertibleSheaf hX hη
      toBase.specialFiberCohomologyFiniteDimensional_zero
      hC.finiteDimensional_one j).trans
    (congrFun
      (toBase.specialFiberNumericalType_weightedIntersection hX hη hC hπ hreg hconn).symm j)]
  exact (NumericalType.mem_principalDivisors_iff _).mpr ⟨Pi.single j 1, by ext; simp⟩

/-- Simp normal form of `totalSpecialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf`
after `LineBundleClass.inv_mk`. -/
@[simp]
theorem totalSpecialFiberPicSpecialization_ofMul_mk_toInvertibleSheaf_dual
    (j : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component) :
    toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn (Additive.ofMul
        (LineBundleClass.mk (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
          hX j.val.property).toInvertibleSheaf.dual)) = 0 := by
  rw [← LineBundleClass.inv_mk,
    totalSpecialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf]

/-- The ideal-sheaf bundle `𝒪_X(-Cⱼ)` maps to `0` under `totalSpecialFiberPicSpecialization`. -/
@[simp]
theorem totalSpecialFiberPicSpecialization_ofMul_mk_toInvertibleSheaf
    (j : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component) :
    toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn (Additive.ofMul
        (LineBundleClass.mk (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
          hX j.val.property).toInvertibleSheaf)) = 0 := by
  rw [← neg_eq_zero, ← map_neg, ← ofMul_inv,
    totalSpecialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf]

/-- `a ∈ ker reducedSpecialFiberPicSpecialization` iff its multidegree is principal. -/
theorem mem_ker_reducedSpecialFiberPicSpecialization_iff
    {a : Additive (LineBundleClass (specialFiberι R toBase).ker.radical.subscheme)} :
    a ∈ AddMonoidHom.ker (toBase.reducedSpecialFiberPicSpecialization hX hη hC hπ hreg hconn) ↔
      toBase.reducedSpecialFiberMultidegree hX hη
          toBase.specialFiberCohomologyFiniteDimensional_zero
          hC.finiteDimensional_one a ∈
        (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).principalDivisors := by
  rw [AddMonoidHom.mem_ker, reducedSpecialFiberPicSpecialization_apply]
  exact Submodule.Quotient.mk_eq_zero _

/-- A class in `Pic(X)` lies in `ker totalSpecialFiberPicSpecialization` iff its multidegree matches
a vertical component product `∏ j, 𝒪_X(Cⱼ) ^ v j`. -/
theorem mem_ker_totalSpecialFiberPicSpecialization_iff {a : Additive (LineBundleClass X)} :
    a ∈ AddMonoidHom.ker (toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn) ↔
      ∃ v : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component → ℤ,
        toBase.specialFiberMultidegree hX hη
            toBase.specialFiberCohomologyFiniteDimensional_zero
            hC.finiteDimensional_one a =
          toBase.specialFiberMultidegree hX hη
            toBase.specialFiberCohomologyFiniteDimensional_zero
            hC.finiteDimensional_one
            (Additive.ofMul (∏ j, (LineBundleClass.mk
              (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
                hX j.val.property).toInvertibleSheaf)⁻¹ ^ v j)) := by
  rw [AddMonoidHom.mem_ker, totalSpecialFiberPicSpecialization_apply]
  refine (Submodule.Quotient.mk_eq_zero _).trans
    ((NumericalType.mem_principalDivisors_iff _).trans (exists_congr fun v ↦ ?_))
  rw [toBase.specialFiberNumericalType_weightedIntersection hX hη hC hπ hreg hconn]
  have hmul := (toBase.specialFiberMultidegree_prod_zpow hX hη
    toBase.specialFiberCohomologyFiniteDimensional_zero hC.finiteDimensional_one v).symm
  exact ⟨fun h ↦ h.symm.trans hmul, fun h ↦ hmul.trans h.symm⟩

/-- Under `T.picToCoker : T.Pic →ₗ[ℤ] T.Coker`
([Stacks, Tag 0CE7](https://stacks.math.columbia.edu/tag/0CE7)),
`totalSpecialFiberPicSpecialization a` maps to the class of `i ↦ (a · Cᵢ)_k`. -/
theorem picToCoker_totalSpecialFiberPicSpecialization (a : Additive (LineBundleClass X)) :
    (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).picToCoker
        (toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn a) =
      Submodule.Quotient.mk fun i ↦
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            ((mem_toFinset _).mp i.property))
        LineBundleClass.intersectionNumber (ResidueField R)
          (vanishingIdeal ⟨closure {(i.val : X)}, isClosed_closure⟩).subschemeι a.toMul := by
  rw [totalSpecialFiberPicSpecialization_apply]
  refine (NumericalType.picToCoker_mk _ _).trans
    (congrArg Submodule.Quotient.mk (funext fun i ↦ ?_))
  exact (NumericalType.weightScaling_apply _ _ i).trans <|
    (congrArg (_ * ·)
      (by exact_mod_cast toBase.specialFiberNumericalType_weight hX hη hC hπ hreg hconn i)).trans
      (toBase.specialFiberMultidegree_mul_specialFiberWeight hX hη
        toBase.specialFiberCohomologyFiniteDimensional_zero
        hC.finiteDimensional_one a i)

/-! ### Numerical total degree and the degree-zero subgroup -/

/-- The numerical total degree of `reducedSpecialFiberPicSpecialization a` is `∑ᵢ mᵢ (a · Cᵢ)_k`. -/
theorem degree_reducedSpecialFiberPicSpecialization
    (a : Additive (LineBundleClass (specialFiberι R toBase).ker.radical.subscheme)) :
    (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).degree
        (toBase.reducedSpecialFiberPicSpecialization hX hη hC hπ hreg hconn a) =
      ∑ i : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component,
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            ((mem_toFinset _).mp i.property))
        ((toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).multiplicity i : ℤ) *
          LineBundleClass.intersectionNumber (ResidueField R)
            (inclusion (toBase.radical_ker_specialFiberι_le_vanishingIdeal_closure_singleton
              ((mem_toFinset _).mp i.property))) a.toMul := by
  rw [reducedSpecialFiberPicSpecialization_apply]
  refine (NumericalType.degree_mk _ _).trans ((NumericalType.totalDegree_apply _ _).trans ?_)
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [mul_left_comm]
  exact congrArg (_ * ·) <|
    (congrArg (_ * ·)
      (by exact_mod_cast toBase.specialFiberNumericalType_weight hX hη hC hπ hreg hconn i)).trans
      (toBase.reducedSpecialFiberMultidegree_mul_specialFiberWeight hX hη
        toBase.specialFiberCohomologyFiniteDimensional_zero
        hC.finiteDimensional_one a i)

/-- The numerical total degree of `specialFiberPicSpecialization a` is `∑ᵢ mᵢ (a · Cᵢ)_k`. -/
theorem degree_specialFiberPicSpecialization
    (a : Additive (LineBundleClass (specialFiber R toBase).left)) :
    (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).degree
        (toBase.specialFiberPicSpecialization hX hη hC hπ hreg hconn a) =
      ∑ i : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component,
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            ((mem_toFinset _).mp i.property))
        ((toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).multiplicity i : ℤ) *
          LineBundleClass.intersectionNumber (ResidueField R)
            (subschemeToSpecialFiber (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
              ((mem_toFinset _).mp i.property))) a.toMul := by
  rw [specialFiberPicSpecialization_eq_comp, AddMonoidHom.comp_apply,
    degree_reducedSpecialFiberPicSpecialization]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  let := subschemeOverResidueField (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
    ((mem_toFinset _).mp i.property))
  rw [MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply,
    LineBundleClass.intersectionNumber_pullback, TauCeti.inclusion_subschemeToSpecialFiber]

/-- The numerical total degree of `totalSpecialFiberPicSpecialization a` is `∑ᵢ mᵢ (a · Cᵢ)_k`. -/
theorem degree_totalSpecialFiberPicSpecialization (a : Additive (LineBundleClass X)) :
    (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).degree
        (toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn a) =
      ∑ i : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component,
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            ((mem_toFinset _).mp i.property))
        ((toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).multiplicity i : ℤ) *
          LineBundleClass.intersectionNumber (ResidueField R)
            (vanishingIdeal ⟨closure {(i.val : X)}, isClosed_closure⟩).subschemeι a.toMul := by
  rw [totalSpecialFiberPicSpecialization_eq_comp, AddMonoidHom.comp_apply,
    degree_specialFiberPicSpecialization]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  let := subschemeOverResidueField (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
    ((mem_toFinset _).mp i.property))
  rw [MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply,
    LineBundleClass.intersectionNumber_pullback, subschemeToSpecialFiber_specialFiberι]

/-- `totalSpecialFiberPicSpecialization a ∈ T.degreeZeroSubgroup` iff `∑ᵢ mᵢ (a · Cᵢ)_k = 0`. -/
theorem totalSpecialFiberPicSpecialization_mem_degreeZeroSubgroup_iff
    {a : Additive (LineBundleClass X)} :
    toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn a ∈
        (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).degreeZeroSubgroup ↔
      (∑ i : (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Component,
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            ((mem_toFinset _).mp i.property))
        ((toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).multiplicity i : ℤ) *
          LineBundleClass.intersectionNumber (ResidueField R)
            (vanishingIdeal ⟨closure {(i.val : X)}, isClosed_closure⟩).subschemeι a.toMul) = 0 := by
  rw [NumericalType.mem_degreeZeroSubgroup, degree_totalSpecialFiberPicSpecialization]

end LocalRing

section GenericFiber

variable {R : Type u} (K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [CommRing K] [Algebra R K] [IsFractionRing R K] {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))
  [IsIntegral X] [IsNoetherian X] [TauCeti.AlgebraicGeometry.IsRegular X]
  [IsProper toBase] [Flat toBase]
  (hX : ∀ x : X, coheight x ≤ 2) (hη : toBase (genericPoint X) ≠ closedPoint R)
  (hC : toBase.HasFiniteDimensionalSpecialFiberComponentTrivialCohomologyOne)
  {π : R} (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π)
  (hconn : _root_.IsPreconnected (toBase ⁻¹' {closedPoint R}))

/-- **Specialization of line bundles from the generic fibre** `X_K` to `T.Pic`
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y);
[Tag 0CEI](https://stacks.math.columbia.edu/tag/0CEI)), transporting
`specialFiberPicardSpecialization` along `specialFiberNumericalTypePicEquiv`. -/
def genericFiberPicSpecialization :
    Additive (LineBundleClass (genericFiber R K toBase).left) →+
      (toBase.specialFiberNumericalType hX hη hC hπ hreg hconn).Pic :=
  (toBase.specialFiberNumericalTypePicEquiv hX hη hC hπ hreg hconn).symm.toAddMonoidHom.comp
    (toBase.specialFiberPicardSpecialization K hX hη
      toBase.specialFiberCohomologyFiniteDimensional_zero
      hC.finiteDimensional_one)

/-- `genericFiberPicSpecialization` sends the generic-fibre restriction of `a : LineBundleClass X`
to `totalSpecialFiberPicSpecialization a` (not `@[simp]` because `genericFiber` is an
`Over.pullback` abbreviation, so `simp` unfolds the LHS). -/
theorem genericFiberPicSpecialization_pullback (a : LineBundleClass X) :
    toBase.genericFiberPicSpecialization K hX hη hC hπ hreg hconn
        (Additive.ofMul (LineBundleClass.pullback (genericFiberι R K toBase) a)) =
      toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn (Additive.ofMul a) := by
  rw [genericFiberPicSpecialization, AddMonoidHom.comp_apply, LinearMap.toAddMonoidHom_coe,
    LinearEquiv.coe_coe,
    toBase.specialFiberPicardSpecialization_pullback K hX hη
      toBase.specialFiberCohomologyFiniteDimensional_zero
      hC.finiteDimensional_one a,
    specialFiberNumericalTypePicEquiv_symm_mk, totalSpecialFiberPicSpecialization_apply]

/-- `totalSpecialFiberPicSpecialization` factors through restriction to the generic fibre `X_K`. -/
theorem totalSpecialFiberPicSpecialization_eq_comp_genericFiber :
    toBase.totalSpecialFiberPicSpecialization hX hη hC hπ hreg hconn =
      (toBase.genericFiberPicSpecialization K hX hη hC hπ hreg hconn).comp
        (MonoidHom.toAdditive (LineBundleClass.pullbackHom (genericFiberι R K toBase))) := by
  refine AddMonoidHom.ext fun a ↦ ?_
  simp only [AddMonoidHom.comp_apply, MonoidHom.toAdditive_apply_apply,
    LineBundleClass.pullbackHom_apply]
  exact (toBase.genericFiberPicSpecialization_pullback K hX hη hC hπ hreg hconn a.toMul).symm

/-- A line-bundle class `b` on `X_K` lies in `ker genericFiberPicSpecialization` iff it extends to
a class `a` on `X` of special-fibre multidegree zero. -/
theorem mem_ker_genericFiberPicSpecialization_iff
    {b : LineBundleClass (genericFiber R K toBase).left} :
    Additive.ofMul b ∈
        AddMonoidHom.ker (toBase.genericFiberPicSpecialization K hX hη hC hπ hreg hconn) ↔
      ∃ a : LineBundleClass X,
        LineBundleClass.pullback (genericFiberι R K toBase) a = b ∧
          toBase.specialFiberMultidegree hX hη
            toBase.specialFiberCohomologyFiniteDimensional_zero
            hC.finiteDimensional_one (Additive.ofMul a) = 0 := by
  rw [AddMonoidHom.mem_ker, genericFiberPicSpecialization, AddMonoidHom.comp_apply,
    LinearMap.toAddMonoidHom_coe, LinearEquiv.coe_coe, LinearEquiv.map_eq_zero_iff]
  exact toBase.mem_ker_specialFiberPicardSpecialization_iff K hX hη
    toBase.specialFiberCohomologyFiniteDimensional_zero
    hC.finiteDimensional_one

end GenericFiber

end AlgebraicGeometry.Scheme.Hom

namespace TauCeti.Model

attribute [local instance] Model.isNoetherian_total

variable {R K : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K] {C : Scheme.{u}} {toK : C ⟶ Spec (.of K)}
  (M : Model R K C toK) [M.IsProper] [IsIntegral M.total]
  [TauCeti.AlgebraicGeometry.IsRegular M.total] [ConnectedSpace (specialFiber R M.toBase).left]
  (hX : ∀ x : M.total, coheight x ≤ 2)
  (hC : M.toBase.HasFiniteDimensionalSpecialFiberComponentTrivialCohomologyOne)

/-- Linear equivalence identifying `(M.numericalType hX hC).Pic` with the cokernel of
`M.toBase.specialFiberWeightedIntersectionMatrix`. -/
def numericalTypePicEquiv :
    (M.numericalType hX hC).Pic ≃ₗ[ℤ]
      (((M.toBase.finite_setOf_base_eq_closedPoint (IsDiscreteValuationRing.not_a_field R)
            (M.toBase.base_genericPoint_ne_closedPoint
              (IsDiscreteValuationRing.not_a_field R))).toFinset → ℤ) ⧸
        LinearMap.range (M.toBase.specialFiberWeightedIntersectionMatrix hX
          (M.toBase.base_genericPoint_ne_closedPoint
            (IsDiscreteValuationRing.not_a_field R))).vecMulLinear) :=
  M.toBase.specialFiberNumericalTypePicEquiv hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint

/-- `M.numericalTypePicEquiv` acts as the identity on quotient classes. -/
@[simp]
theorem numericalTypePicEquiv_mk (d : (M.numericalType hX hC).Component → ℤ) :
    M.numericalTypePicEquiv hX hC (Submodule.Quotient.mk d) = Submodule.Quotient.mk d :=
  M.toBase.specialFiberNumericalTypePicEquiv_mk hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint d

/-- `(M.numericalTypePicEquiv hX hC).symm` acts as the identity on quotient classes. -/
@[simp]
theorem numericalTypePicEquiv_symm_mk
    (d : (M.toBase.finite_setOf_base_eq_closedPoint (IsDiscreteValuationRing.not_a_field R)
      (M.toBase.base_genericPoint_ne_closedPoint
        (IsDiscreteValuationRing.not_a_field R))).toFinset → ℤ) :
    (M.numericalTypePicEquiv hX hC).symm (Submodule.Quotient.mk d) =
      Submodule.Quotient.mk d :=
  M.toBase.specialFiberNumericalTypePicEquiv_symm_mk hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint d

/-- Uniformizer-free specialization from the reduced special fibre of `M` to
`(M.numericalType hX hC).Pic` ([Stacks, Tag 0C5Y](https://stacks.math.columbia.edu/tag/0C5Y)). -/
def reducedSpecialFiberPicSpecialization :
    Additive (LineBundleClass (specialFiberι R M.toBase).ker.radical.subscheme) →+
      (M.numericalType hX hC).Pic :=
  M.toBase.reducedSpecialFiberPicSpecialization hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint

/-- `M.reducedSpecialFiberPicSpecialization` sends `a` to the quotient class of its
multidegree. -/
theorem reducedSpecialFiberPicSpecialization_apply
    (a : Additive (LineBundleClass (specialFiberι R M.toBase).ker.radical.subscheme)) :
    M.reducedSpecialFiberPicSpecialization hX hC a =
      Submodule.Quotient.mk (M.toBase.reducedSpecialFiberMultidegree hX
        (M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R))
        M.toBase.specialFiberCohomologyFiniteDimensional_zero
        hC.finiteDimensional_one a) := by
  rw [reducedSpecialFiberPicSpecialization]
  exact M.toBase.reducedSpecialFiberPicSpecialization_apply ..

/-- Uniformizer-free specialization from the special fibre of `M` to
`(M.numericalType hX hC).Pic`
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)). -/
def specialFiberPicSpecialization :
    Additive (LineBundleClass (specialFiber R M.toBase).left) →+ (M.numericalType hX hC).Pic :=
  M.toBase.specialFiberPicSpecialization hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint

/-- `M.specialFiberPicSpecialization` sends `a` to the quotient class of its multidegree. -/
theorem specialFiberPicSpecialization_apply
    (a : Additive (LineBundleClass (specialFiber R M.toBase).left)) :
    M.specialFiberPicSpecialization hX hC a =
      Submodule.Quotient.mk (M.toBase.specialFiberMultidegreeOnFiber hX
        (M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R))
        M.toBase.specialFiberCohomologyFiniteDimensional_zero
        hC.finiteDimensional_one a) := by
  rw [specialFiberPicSpecialization]; exact M.toBase.specialFiberPicSpecialization_apply ..

/-- `M.specialFiberPicSpecialization` factors through pullback to the reduced special fibre. -/
theorem specialFiberPicSpecialization_eq_comp :
    M.specialFiberPicSpecialization hX hC =
      (M.reducedSpecialFiberPicSpecialization hX hC).comp (MonoidHom.toAdditive
        (LineBundleClass.pullbackHom
          (subschemeToSpecialFiber (specialFiberι R M.toBase).ker.le_radical))) :=
  M.toBase.specialFiberPicSpecialization_eq_comp hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint

/-- Pulling a class on `(specialFiber R M.toBase).left` back to `(X_s)_red` preserves its class in
`(M.numericalType hX hC).Pic`. -/
@[simp]
theorem reducedSpecialFiberPicSpecialization_pullback
    (a : LineBundleClass (specialFiber R M.toBase).left) :
    M.reducedSpecialFiberPicSpecialization hX hC (Additive.ofMul (LineBundleClass.pullback
        (subschemeToSpecialFiber (specialFiberι R M.toBase).ker.le_radical) a)) =
      M.specialFiberPicSpecialization hX hC (Additive.ofMul a) :=
  M.toBase.reducedSpecialFiberPicSpecialization_pullback hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint a

/-- Uniformizer-free specialization from `M.total` to `(M.numericalType hX hC).Pic`
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)). -/
def totalPicSpecialization :
    Additive (LineBundleClass M.total) →+ (M.numericalType hX hC).Pic :=
  M.toBase.totalSpecialFiberPicSpecialization hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint

/-- `M.totalPicSpecialization` sends `a` to the quotient class of its multidegree. -/
theorem totalPicSpecialization_apply (a : Additive (LineBundleClass M.total)) :
    M.totalPicSpecialization hX hC a =
      Submodule.Quotient.mk (M.toBase.specialFiberMultidegree hX
        (M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R))
        M.toBase.specialFiberCohomologyFiniteDimensional_zero
        hC.finiteDimensional_one a) := by
  rw [totalPicSpecialization]; exact M.toBase.totalSpecialFiberPicSpecialization_apply ..

/-- `M.totalPicSpecialization` factors through pullback to the special fibre. -/
theorem totalPicSpecialization_eq_comp :
    M.totalPicSpecialization hX hC =
      (M.specialFiberPicSpecialization hX hC).comp
        (MonoidHom.toAdditive (LineBundleClass.pullbackHom (specialFiberι R M.toBase))) :=
  M.toBase.totalSpecialFiberPicSpecialization_eq_comp hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint

/-- Pulling a class on `M.total` back to the special fibre preserves its class in
`(M.numericalType hX hC).Pic` (not `@[simp]` because `specialFiber` is an `Over.pullback`
abbreviation, so `simp` unfolds the LHS). -/
theorem specialFiberPicSpecialization_pullback (a : LineBundleClass M.total) :
    M.specialFiberPicSpecialization hX hC
        (Additive.ofMul (LineBundleClass.pullback (specialFiberι R M.toBase) a)) =
      M.totalPicSpecialization hX hC (Additive.ofMul a) :=
  M.toBase.specialFiberPicSpecialization_pullback hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint a

/-- Pulling a class on `M.total` back to `(X_s)_red` preserves its class in
`(M.numericalType hX hC).Pic`. -/
@[simp]
theorem reducedSpecialFiberPicSpecialization_pullback_subschemeι (a : LineBundleClass M.total) :
    M.reducedSpecialFiberPicSpecialization hX hC (Additive.ofMul
        (LineBundleClass.pullback (specialFiberι R M.toBase).ker.radical.subschemeι a)) =
      M.totalPicSpecialization hX hC (Additive.ofMul a) :=
  M.toBase.reducedSpecialFiberPicSpecialization_pullback_subschemeι hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint a

/-- Uniformizer-free specialization from the prescribed generic fibre `C` of `M` to
`(M.numericalType hX hC).Pic` ([Stacks, Tag 0C5Y](https://stacks.math.columbia.edu/tag/0C5Y);
[Tag 0CEI](https://stacks.math.columbia.edu/tag/0CEI)). -/
def genericFiberPicSpecialization :
    Additive (LineBundleClass C) →+ (M.numericalType hX hC).Pic :=
  (M.toBase.genericFiberPicSpecialization K hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint).comp
    (MonoidHom.toAdditive (LineBundleClass.pullbackHom M.genericFiberIso.hom.left))

/-- `M.genericFiberPicSpecialization` sends `Additive.ofMul b` to
`M.toBase.genericFiberPicSpecialization` applied to the pullback of `b` along
`M.genericFiberIso.hom.left` (not `@[simp]` so `genericFiberPicSpecialization_pullback` stays in
simp normal form). -/
theorem genericFiberPicSpecialization_apply (b : LineBundleClass C) :
    M.genericFiberPicSpecialization hX hC (Additive.ofMul b) =
      M.toBase.genericFiberPicSpecialization K hX
        (M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R)) hC
        TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
        TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
        M.isPreconnected_preimage_closedPoint
        (Additive.ofMul (LineBundleClass.pullback M.genericFiberIso.hom.left b)) := by
  rw [genericFiberPicSpecialization]
  have h : (MonoidHom.toAdditive (LineBundleClass.pullbackHom M.genericFiberIso.hom.left))
      (Additive.ofMul b) =
      Additive.ofMul (LineBundleClass.pullback M.genericFiberIso.hom.left b) := by
    rw [MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply]
  exact congrArg (M.toBase.genericFiberPicSpecialization K hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint) h

/-- `M.genericFiberPicSpecialization` sends the generic-fibre restriction of
`a : LineBundleClass M.total` to `M.totalPicSpecialization a`. -/
@[simp]
theorem genericFiberPicSpecialization_pullback (a : LineBundleClass M.total) :
    M.genericFiberPicSpecialization hX hC
        (Additive.ofMul (LineBundleClass.pullback M.genericι a)) =
      M.totalPicSpecialization hX hC (Additive.ofMul a) := by
  rw [genericFiberPicSpecialization_apply, LineBundleClass.pullback_comp,
    Model.genericFiberIso_hom_left_genericι, M.toBase.genericFiberPicSpecialization_pullback K,
    totalPicSpecialization]
  -- `rw` checks syntactic equality at reducible transparency; `rfl` closes `M.numericalType`
  -- against `specialFiberNumericalType`.
  rfl

/-- `M.totalPicSpecialization` factors through restriction to the prescribed generic fibre `C`. -/
theorem totalPicSpecialization_eq_comp_genericFiber :
    M.totalPicSpecialization hX hC =
      (M.genericFiberPicSpecialization hX hC).comp
        (MonoidHom.toAdditive (LineBundleClass.pullbackHom M.genericι)) := by
  refine AddMonoidHom.ext fun a ↦ ?_
  simp only [AddMonoidHom.comp_apply, MonoidHom.toAdditive_apply_apply,
    LineBundleClass.pullbackHom_apply]
  exact (M.genericFiberPicSpecialization_pullback hX hC a.toMul).symm

/-- A line-bundle class `b` on `C` lies in `ker (M.genericFiberPicSpecialization hX hC)` iff it
extends to a class `a` on `M.total` of special-fibre multidegree zero. -/
theorem mem_ker_genericFiberPicSpecialization_iff {b : LineBundleClass C} :
    Additive.ofMul b ∈ AddMonoidHom.ker (M.genericFiberPicSpecialization hX hC) ↔
      ∃ a : LineBundleClass M.total,
        LineBundleClass.pullback M.genericι a = b ∧
          M.toBase.specialFiberMultidegree hX
            (M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R))
            M.toBase.specialFiberCohomologyFiniteDimensional_zero
            hC.finiteDimensional_one (Additive.ofMul a) = 0 := by
  refine (Iff.trans (by
      rw [AddMonoidHom.mem_ker, genericFiberPicSpecialization_apply, AddMonoidHom.mem_ker]
      -- `(M.numericalType hX hC).Pic` unifies with `(specialFiberNumericalType ...).Pic` at
      -- default transparency.
      rfl)
    (M.toBase.mem_ker_genericFiberPicSpecialization_iff K hX _ hC
      TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
      TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
      M.isPreconnected_preimage_closedPoint)).trans ?_
  refine exists_congr fun a ↦ and_congr_left fun _ ↦ ?_
  rw [← (LineBundleClass.pullbackEquiv ((Over.forget _).mapIso M.genericFiberIso)).injective.eq_iff]
  simp only [LineBundleClass.pullbackEquiv_apply, Functor.mapIso_hom, Over.forget_map,
    LineBundleClass.pullback_comp, Model.genericFiberIso_hom_left_genericι]

/-- On `M.total`, `𝒪_{M.total}(Cⱼ)` maps to `0` in `(M.numericalType hX hC).Pic`. -/
theorem totalPicSpecialization_ofMul_inv_mk_toInvertibleSheaf
    (j : (M.numericalType hX hC).Component) :
    M.totalPicSpecialization hX hC (Additive.ofMul (LineBundleClass.mk
        (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
          hX j.val.property).toInvertibleSheaf)⁻¹) = 0 :=
  M.toBase.totalSpecialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf
    hX _ hC
    TauCeti.IsDiscreteValuationRing.maximalIdeal_eq_span_exists_irreducible_choose
    TauCeti.IsDiscreteValuationRing.isSMulRegular_exists_irreducible_choose
    M.isPreconnected_preimage_closedPoint j

/-- Simp normal form of `totalPicSpecialization_ofMul_inv_mk_toInvertibleSheaf` after
`LineBundleClass.inv_mk`. -/
@[simp]
theorem totalPicSpecialization_ofMul_mk_toInvertibleSheaf_dual
    (j : (M.numericalType hX hC).Component) :
    M.totalPicSpecialization hX hC (Additive.ofMul (LineBundleClass.mk
        (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
          hX j.val.property).toInvertibleSheaf.dual)) = 0 :=
  M.toBase.totalSpecialFiberPicSpecialization_ofMul_mk_toInvertibleSheaf_dual
    hX _ hC
