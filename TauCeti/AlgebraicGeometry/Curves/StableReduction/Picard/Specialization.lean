module

public import TauCeti.AlgebraicGeometry.Curves.StableReduction.Model.NumericalType
public import TauCeti.AlgebraicGeometry.Curves.StableReduction.Picard.DegreeZero
public import TauCeti.AlgebraicGeometry.IdealSheaf.Reduced

/-!
# Specialization of line bundles to the Picard group of a numerical type

Let `X` be a proper regular integral scheme over a local ring `R` of dimension at most one whose
maximal ideal is generated by a nonzerodivisor `π`, with residue field `k`, connected special fibre
`X_s`, reduced special fibre `X_{s,red} = X_s.nilradical.subscheme`, all points of codimension at
most two, and finite-dimensional `H⁰` and `H¹` of the structure sheaf of every irreducible component
`Cᵢ` of `X_s`. Let `T = toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg` be the numerical type of
the special fibre, with weights `wᵢ = [κᵢ : k]` and multiplicities `mᵢ`.

Following [Stacks, Lemma 55.9.5 (Tag 0C9V)](https://stacks.math.columbia.edu/tag/0C9V), every
reduced component `Cᵢ` embeds into `X_{s,red}` compatibly with `X_{s,red} ↪ X_s ↪ X`. A line-bundle
class `a` on `X_{s,red}` (and hence, by pullback, on `X_s` or on `X`) has an intersection number
`(a · Cᵢ)_k` over `k` divisible by `wᵢ`; dividing by `wᵢ` records the degree over the constant field
`κᵢ` of `a|_{Cᵢ}` and defines additive **multidegree** homomorphisms

`Pic(X) → Pic(X_s) → Pic(X_{s,red}) → (T.Component → ℤ)`.

On `X`, the invertible sheaf `𝒪_X(Cⱼ)` of a component `Cⱼ` has multidegree `i ↦ aⱼᵢ / wᵢ`, the
`j`-th row of `T.weightedIntersection`, which lies in `T.principalDivisors`. Composing with the
quotient `T.principalDivisors.mkQ` therefore yields functorial **specialization** homomorphisms

`Pic(X) → Pic(X_s) → Pic(X_{s,red}) → T.Pic`

killing the line bundles of all vertical components `Cⱼ`, matching the unweighted intersection
tuple `i ↦ (a · Cᵢ)_k` under `T.picToCoker : T.Pic ↪ T.Coker`, and sending a class `a` to a class
of numerical total degree `∑ᵢ mᵢ (a · Cᵢ)_k`. For a proper regular `TauCeti.Model` over a discrete
valuation ring, `TauCeti.Model` provides uniformizer-free counterparts targeting
`(M.numericalType hX h₀ h₁).Pic`.

## Main definitions

* `AlgebraicGeometry.Scheme.Hom.reducedSpecialFiberMultidegree`,
  `AlgebraicGeometry.Scheme.Hom.specialFiberSubschemeMultidegree`,
  `AlgebraicGeometry.Scheme.Hom.specialFiberMultidegree`: the constant-field multidegree
  homomorphisms on `X_{s,red}`, `X_s`, and `X`.
* `AlgebraicGeometry.Scheme.Hom.reducedSpecialFiberPicSpecialization`,
  `AlgebraicGeometry.Scheme.Hom.specialFiberSubschemePicSpecialization`,
  `AlgebraicGeometry.Scheme.Hom.specialFiberPicSpecialization`: the specialization homomorphisms
  into `T.Pic` ([Stacks, Tag 0C9V](https://stacks.math.columbia.edu/tag/0C9V)).
* `TauCeti.Model.reducedSpecialFiberMultidegree`,
  `TauCeti.Model.specialFiberSubschemeMultidegree`, `TauCeti.Model.specialFiberMultidegree`,
  `TauCeti.Model.reducedSpecialFiberPicSpecialization`,
  `TauCeti.Model.specialFiberSubschemePicSpecialization`,
  `TauCeti.Model.specialFiberPicSpecialization`: uniformizer-free counterparts for a proper regular
  model over a discrete valuation ring.

## Main results

* `AlgebraicGeometry.Scheme.Hom.specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf` and
  `AlgebraicGeometry.Scheme.Hom.specialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf`:
  the line bundle `𝒪_X(Cⱼ)` of the `j`-th component has multidegree `T.weightedIntersection j` and
  vanishes in `T.Pic`.
* `AlgebraicGeometry.Scheme.Hom.mem_ker_specialFiberPicSpecialization_iff`: a class in `Pic(X)`
  maps to zero in `T.Pic` if and only if its multidegree coincides with that of a `ℤ`-linear
  combination of the vertical component bundles `𝒪_X(Cⱼ)`.
* `AlgebraicGeometry.Scheme.Hom.picToCoker_specialFiberPicSpecialization`: under `T.picToCoker`,
  the specialization of `a` is the class of `i ↦ (a · Cᵢ)_k` in `T.Coker`.
* `AlgebraicGeometry.Scheme.Hom.degree_specialFiberPicSpecialization` and
  `AlgebraicGeometry.Scheme.Hom.mem_degreeZeroSubgroup_specialFiberPicSpecialization_iff`: the
  numerical total degree of the specialization of `a` is `∑ᵢ mᵢ (a · Cᵢ)_k`, so `a` lands in
  `T.degreeZeroSubgroup` if and only if `∑ᵢ mᵢ (a · Cᵢ)_k = 0`.

## References

* [The Stacks Project, Lemma 55.9.5 (Tag 0C9V)](https://stacks.math.columbia.edu/tag/0C9V) and
  [Lemma 55.9.11 (Tag 0CE7)](https://stacks.math.columbia.edu/tag/0CE7).
* Q. Liu, *Algebraic Geometry and Arithmetic Curves*, Section 9.1.
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing Order
open scoped Matrix
open TauCeti TauCeti.AlgebraicGeometry
open AlgebraicGeometry.Scheme.IdealSheafData (vanishingIdeal
  isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular)

universe u

namespace AlgebraicGeometry.Scheme.Hom

section LocalRing

variable {R : Type u} [CommRing R] [IsLocalRing R] [Ring.DimensionLEOne R]
  {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))
  [IsIntegral X] [IsNoetherian X] [TauCeti.AlgebraicGeometry.IsRegular X]
  [IsProper toBase] [Flat toBase] [ConnectedSpace (specialFiber R toBase).left]
  (hX : ∀ x : X, coheight x ≤ 2)
  (h₀ : toBase.HasFiniteSpecialFiberCohomology 0)
  (h₁ : toBase.HasFiniteSpecialFiberCohomology 1)
  {π : R} (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π)

/-! ### Multidegrees on the reduced special fibre, special fibre, and total space -/

/-- The **constant-field multidegree** of a line-bundle class on the reduced special fibre
`X_{s,red} = (specialFiber R toBase).left.nilradical.subscheme`: at a component `Cᵢ` of the special
fibre, it is `(a · Cᵢ)_k / wᵢ`, the degree of `a|_{Cᵢ}` over the constant field `κᵢ` of `Cᵢ`. -/
def reducedSpecialFiberMultidegree :
    Additive (LineBundleClass (specialFiber R toBase).left.nilradical.subscheme) →+
      (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component → ℤ where
  toFun a i :=
    letI := subschemeOverResidueField
      (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
        (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
    LineBundleClass.intersectionNumber (ResidueField R)
      (subschemeToSpecialFiber
        (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (toBase.base_eq_closedPoint_of_specialFiberNumericalType
            hX h₀ h₁ hπ hreg i))).liftNilradicalSubscheme a.toMul /
      ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weight i : ℤ)
  map_zero' := by
    funext i
    let hI := toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i)
    let := subschemeOverResidueField hI
    exact (congrArg
      (· / ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weight i : ℤ))
      (LineBundleClass.intersectionNumber_one (ResidueField R)
        (subschemeToSpecialFiber hI).liftNilradicalSubscheme)).trans (Int.zero_ediv _)
  map_add' a b := by
    funext i
    let hi := toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i
    let hI := toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hi
    let := subschemeOverResidueField hI
    have := isProper_subschemeOverResidueField hI
    have := toBase.relativeDimensionLE_subscheme_vanishingIdeal_closure_singleton hX
      (fun h ↦ one_ne_zero (i.1.2.symm.trans (coheight_eq_zero.mpr h))) hi
    have := h₀ i.1 hi
    have := h₁ i.1 hi
    have hw : ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weight i : ℤ) =
        (toBase.specialFiberWeight hi : ℤ) := by
      exact_mod_cast toBase.coe_specialFiberNumericalType_weight hX h₀ h₁ hπ hreg i
    have hdvd : ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weight i : ℤ) ∣
        LineBundleClass.intersectionNumber (ResidueField R)
          (subschemeToSpecialFiber hI).liftNilradicalSubscheme a.toMul := by
      rw [hw]
      exact toBase.specialFiberWeight_dvd_intersectionNumber hi _ a.toMul
    simp only [toMul_add, LineBundleClass.intersectionNumber_mul_of_isIntegral, Pi.add_apply]
    exact Int.add_ediv_of_dvd_left hdvd

/-- Coordinates of `reducedSpecialFiberMultidegree`. -/
theorem reducedSpecialFiberMultidegree_apply
    (a : Additive (LineBundleClass (specialFiber R toBase).left.nilradical.subscheme))
    (i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg a i =
      letI := subschemeOverResidueField
        (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
      LineBundleClass.intersectionNumber (ResidueField R)
        (subschemeToSpecialFiber
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType
              hX h₀ h₁ hπ hreg i))).liftNilradicalSubscheme a.toMul /
        ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weight i : ℤ) :=
  (rfl)

/-- Rescaling `reducedSpecialFiberMultidegree` by the component weights recovers the intersection
numbers over the residue field. -/
theorem weightScaling_reducedSpecialFiberMultidegree
    (a : Additive (LineBundleClass (specialFiber R toBase).left.nilradical.subscheme))
    (i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    letI := subschemeOverResidueField
      (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
        (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
    (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weightScaling
        (toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg a) i =
      LineBundleClass.intersectionNumber (ResidueField R)
        (subschemeToSpecialFiber
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType
              hX h₀ h₁ hπ hreg i))).liftNilradicalSubscheme a.toMul := by
  let hi := toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i
  let := subschemeOverResidueField
    (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton hi)
  have hw : ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weight i : ℤ) =
      (toBase.specialFiberWeight hi : ℤ) := by
    exact_mod_cast toBase.coe_specialFiberNumericalType_weight hX h₀ h₁ hπ hreg i
  rw [NumericalType.weightScaling_apply, reducedSpecialFiberMultidegree_apply, hw]
  exact Int.ediv_mul_cancel (toBase.specialFiberWeight_dvd_intersectionNumber hi _ a.toMul)

/-- The **constant-field multidegree** of a line-bundle class on the special fibre
`X_s = (specialFiber R toBase).left`, obtained by pulling back to the reduced special fibre
`X_{s,red}`. -/
def specialFiberSubschemeMultidegree :
    Additive (LineBundleClass (specialFiber R toBase).left) →+
      (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component → ℤ :=
  (toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg).comp
    (MonoidHom.toAdditive
      (LineBundleClass.pullbackHom (specialFiber R toBase).left.nilradical.subschemeι))

/-- `specialFiberSubschemeMultidegree` factors through pullback to `X_{s,red}`. -/
theorem specialFiberSubschemeMultidegree_eq_comp :
    toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg =
      (toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg).comp
        (MonoidHom.toAdditive
          (LineBundleClass.pullbackHom (specialFiber R toBase).left.nilradical.subschemeι)) :=
  (rfl)

/-- Pulling a line-bundle class on `X_s` back to `X_{s,red}` preserves its multidegree. -/
theorem reducedSpecialFiberMultidegree_pullback
    (a : LineBundleClass (specialFiber R toBase).left) :
    toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg
        (Additive.ofMul
          (LineBundleClass.pullback (specialFiber R toBase).left.nilradical.subschemeι a)) =
      toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg (Additive.ofMul a) := by
  rw [specialFiberSubschemeMultidegree_eq_comp, AddMonoidHom.comp_apply,
    MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply]

/-- Coordinates of `specialFiberSubschemeMultidegree`. -/
theorem specialFiberSubschemeMultidegree_apply
    (a : Additive (LineBundleClass (specialFiber R toBase).left))
    (i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg a i =
      letI := subschemeOverResidueField
        (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
      LineBundleClass.intersectionNumber (ResidueField R)
        (subschemeToSpecialFiber
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i)))
        a.toMul /
        ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weight i : ℤ) := by
  let := subschemeOverResidueField
    (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
  rw [specialFiberSubschemeMultidegree_eq_comp, AddMonoidHom.comp_apply,
    reducedSpecialFiberMultidegree_apply, MonoidHom.toAdditive_apply_apply, toMul_ofMul,
    LineBundleClass.pullbackHom_apply, LineBundleClass.intersectionNumber_pullback,
    liftNilradicalSubscheme_subschemeι]

/-- Rescaling `specialFiberSubschemeMultidegree` by the component weights recovers the intersection
numbers over the residue field. -/
theorem weightScaling_specialFiberSubschemeMultidegree
    (a : Additive (LineBundleClass (specialFiber R toBase).left))
    (i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    letI := subschemeOverResidueField
      (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
        (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
    (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weightScaling
        (toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg a) i =
      LineBundleClass.intersectionNumber (ResidueField R)
        (subschemeToSpecialFiber
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i)))
        a.toMul := by
  let := subschemeOverResidueField
    (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
  rw [specialFiberSubschemeMultidegree_eq_comp, AddMonoidHom.comp_apply,
    toBase.weightScaling_reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg _ i,
    MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply,
    LineBundleClass.intersectionNumber_pullback, liftNilradicalSubscheme_subschemeι]

/-- The **constant-field multidegree** of a line-bundle class on the total space `X`, obtained by
pulling back to the special fibre `X_s`. -/
def specialFiberMultidegree :
    Additive (LineBundleClass X) →+
      (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component → ℤ :=
  (toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg).comp
    (MonoidHom.toAdditive (LineBundleClass.pullbackHom (specialFiberι R toBase)))

/-- `specialFiberMultidegree` factors through pullback to `X_s`. -/
theorem specialFiberMultidegree_eq_comp :
    toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg =
      (toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg).comp
        (MonoidHom.toAdditive (LineBundleClass.pullbackHom (specialFiberι R toBase))) :=
  (rfl)

/-- Pulling a line-bundle class on `X` back to `X_s` preserves its multidegree. -/
theorem specialFiberSubschemeMultidegree_pullback (a : LineBundleClass X) :
    toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg
        (Additive.ofMul (LineBundleClass.pullback (specialFiberι R toBase) a)) =
      toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg (Additive.ofMul a) := by
  rw [specialFiberMultidegree_eq_comp, AddMonoidHom.comp_apply,
    MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply]

/-- Coordinates of `specialFiberMultidegree`: at `i`, the intersection number `(a · Cᵢ)_k` divided
by the weight `wᵢ`. -/
@[simp]
theorem specialFiberMultidegree_apply
    (a : Additive (LineBundleClass X))
    (i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg a i =
      letI := subschemeOverResidueField
        (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
      LineBundleClass.intersectionNumber (ResidueField R)
        (vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subschemeι a.toMul /
        ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weight i : ℤ) := by
  let := subschemeOverResidueField
    (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
  rw [specialFiberMultidegree_eq_comp, AddMonoidHom.comp_apply,
    specialFiberSubschemeMultidegree_apply, MonoidHom.toAdditive_apply_apply, toMul_ofMul,
    LineBundleClass.pullbackHom_apply, LineBundleClass.intersectionNumber_pullback,
    subschemeToSpecialFiber_specialFiberι]

/-- Rescaling `specialFiberMultidegree` by the component weights recovers the intersection numbers
`(a · Cᵢ)_k` over the residue field. -/
theorem weightScaling_specialFiberMultidegree
    (a : Additive (LineBundleClass X))
    (i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    letI := subschemeOverResidueField
      (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
        (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
    (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weightScaling
        (toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg a) i =
      LineBundleClass.intersectionNumber (ResidueField R)
        (vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subschemeι a.toMul := by
  let := subschemeOverResidueField
    (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
  rw [specialFiberMultidegree_eq_comp, AddMonoidHom.comp_apply,
    toBase.weightScaling_specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg _ i,
    MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply,
    LineBundleClass.intersectionNumber_pullback, subschemeToSpecialFiber_specialFiberι]

/-- **Multidegree of a vertical component.** The invertible sheaf `𝒪_X(Cⱼ)` associated to the
`j`-th component of the special fibre has multidegree equal to the `j`-th row of the weighted
intersection matrix `T.weightedIntersection`
([Stacks, Tag 0C9V](https://stacks.math.columbia.edu/tag/0C9V)). -/
theorem specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf
    (j : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg
        (Additive.ofMul (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)⁻¹) =
      (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weightedIntersection j := by
  let T := toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg
  funext i
  rw [specialFiberMultidegree_apply, toMul_ofMul,
    ← toBase.specialFiberNumericalType_intersection_apply hX h₀ h₁ hπ hreg i j,
    T.intersection_comm i j, ← T.weightedIntersection_apply j i]

/-- The ideal-sheaf line bundle `𝒪_X(-Cⱼ)` of the `j`-th component of the special fibre has
multidegree `-T.weightedIntersection j`. -/
@[simp]
theorem specialFiberMultidegree_ofMul_mk_toInvertibleSheaf
    (j : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg
        (Additive.ofMul (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)) =
      -(toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weightedIntersection j := by
  rw [← neg_inj, ← map_neg, ← ofMul_inv,
    specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf, neg_neg]

/-- A `ℤ`-linear combination of the vertical component line bundles `𝒪_X(Cⱼ)` with coefficients `v`
has multidegree `v ᵥ* T.weightedIntersection`. -/
theorem specialFiberMultidegree_sum_smul_eq_vecMul
    (v : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component → ℤ) :
    toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg
        (∑ j, v j • Additive.ofMul (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)⁻¹) =
      v ᵥ* (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).weightedIntersection := by
  rw [map_sum]
  simp only [map_zsmul, specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf]
  funext i
  simp [Matrix.vecMul, dotProduct]

/-- The multidegree of `𝒪_X(Cⱼ)` is a principal multidegree of the numerical type. -/
theorem specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf_mem_principalDivisors
    (j : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg
        (Additive.ofMul (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)⁻¹) ∈
      (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).principalDivisors := by
  rw [specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf,
    NumericalType.mem_principalDivisors_iff]
  exact ⟨Pi.single j 1, by ext; simp⟩

/-! ### Specialization to the Picard group of the numerical type -/

/-- **Specialization of line bundles from the reduced special fibre** to the Picard group of the
numerical type ([Stacks, Tag 0C9V](https://stacks.math.columbia.edu/tag/0C9V)). -/
def reducedSpecialFiberPicSpecialization :
    Additive (LineBundleClass (specialFiber R toBase).left.nilradical.subscheme) →+
      (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Pic :=
  (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).principalDivisors.mkQ.toAddMonoidHom.comp
    (toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg)

/-- `reducedSpecialFiberPicSpecialization` sends `a` to the quotient class of its multidegree. -/
theorem reducedSpecialFiberPicSpecialization_apply
    (a : Additive (LineBundleClass (specialFiber R toBase).left.nilradical.subscheme)) :
    toBase.reducedSpecialFiberPicSpecialization hX h₀ h₁ hπ hreg a =
      Submodule.Quotient.mk (toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg a) :=
  (rfl)

/-- **Specialization of line bundles from the special fibre** to the Picard group of the numerical
type ([Stacks, Tag 0C9V](https://stacks.math.columbia.edu/tag/0C9V)). -/
def specialFiberSubschemePicSpecialization :
    Additive (LineBundleClass (specialFiber R toBase).left) →+
      (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Pic :=
  (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).principalDivisors.mkQ.toAddMonoidHom.comp
    (toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg)

/-- `specialFiberSubschemePicSpecialization` sends `a` to the quotient class of its multidegree. -/
theorem specialFiberSubschemePicSpecialization_apply
    (a : Additive (LineBundleClass (specialFiber R toBase).left)) :
    toBase.specialFiberSubschemePicSpecialization hX h₀ h₁ hπ hreg a =
      Submodule.Quotient.mk (toBase.specialFiberSubschemeMultidegree hX h₀ h₁ hπ hreg a) :=
  (rfl)

/-- `specialFiberSubschemePicSpecialization` factors through pullback to `X_{s,red}`. -/
theorem specialFiberSubschemePicSpecialization_eq_comp :
    toBase.specialFiberSubschemePicSpecialization hX h₀ h₁ hπ hreg =
      (toBase.reducedSpecialFiberPicSpecialization hX h₀ h₁ hπ hreg).comp
        (MonoidHom.toAdditive
          (LineBundleClass.pullbackHom (specialFiber R toBase).left.nilradical.subschemeι)) :=
  (rfl)

/-- Pulling a line-bundle class on `X_s` back to `X_{s,red}` preserves its class in `T.Pic`. -/
theorem reducedSpecialFiberPicSpecialization_pullback
    (a : LineBundleClass (specialFiber R toBase).left) :
    toBase.reducedSpecialFiberPicSpecialization hX h₀ h₁ hπ hreg
        (Additive.ofMul
          (LineBundleClass.pullback (specialFiber R toBase).left.nilradical.subschemeι a)) =
      toBase.specialFiberSubschemePicSpecialization hX h₀ h₁ hπ hreg (Additive.ofMul a) := by
  rw [specialFiberSubschemePicSpecialization_eq_comp, AddMonoidHom.comp_apply,
    MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply]

/-- **Specialization of line bundles from the total space** `X` to the Picard group of the
numerical type ([Stacks, Tag 0C9V](https://stacks.math.columbia.edu/tag/0C9V)). -/
def specialFiberPicSpecialization :
    Additive (LineBundleClass X) →+
      (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Pic :=
  (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).principalDivisors.mkQ.toAddMonoidHom.comp
    (toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg)

/-- `specialFiberPicSpecialization` sends `a` to the quotient class of its multidegree. -/
theorem specialFiberPicSpecialization_apply (a : Additive (LineBundleClass X)) :
    toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg a =
      Submodule.Quotient.mk (toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg a) :=
  (rfl)

/-- `specialFiberPicSpecialization` factors through pullback to the special fibre `X_s`. -/
theorem specialFiberPicSpecialization_eq_comp :
    toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg =
      (toBase.specialFiberSubschemePicSpecialization hX h₀ h₁ hπ hreg).comp
        (MonoidHom.toAdditive (LineBundleClass.pullbackHom (specialFiberι R toBase))) :=
  (rfl)

/-- Pulling a line-bundle class on `X` back to `X_s` preserves its class in `T.Pic`. -/
theorem specialFiberSubschemePicSpecialization_pullback (a : LineBundleClass X) :
    toBase.specialFiberSubschemePicSpecialization hX h₀ h₁ hπ hreg
        (Additive.ofMul (LineBundleClass.pullback (specialFiberι R toBase) a)) =
      toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg (Additive.ofMul a) := by
  rw [specialFiberPicSpecialization_eq_comp, AddMonoidHom.comp_apply,
    MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply]

/-- **Vertical components vanish in `Pic(T)`.** The line bundle `𝒪_X(Cⱼ)` of every irreducible
component `Cⱼ` of the special fibre maps to `0` under `specialFiberPicSpecialization`
([Stacks, Tag 0C9V](https://stacks.math.columbia.edu/tag/0C9V)). -/
theorem specialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf
    (j : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg
        (Additive.ofMul (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)⁻¹) = 0 := by
  rw [specialFiberPicSpecialization_apply, Submodule.Quotient.mk_eq_zero]
  exact toBase.specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf_mem_principalDivisors
    hX h₀ h₁ hπ hreg j

/-- The ideal-sheaf line bundle `𝒪_X(-Cⱼ)` of every irreducible component `Cⱼ` of the special fibre
maps to `0` under `specialFiberPicSpecialization`. -/
@[simp]
theorem specialFiberPicSpecialization_ofMul_mk_toInvertibleSheaf
    (j : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component) :
    toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg
        (Additive.ofMul (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)) = 0 := by
  rw [← neg_eq_zero, ← map_neg, ← ofMul_inv,
    specialFiberPicSpecialization_ofMul_inv_mk_toInvertibleSheaf]

/-- A line-bundle class on `X_{s,red}` lies in the kernel of `reducedSpecialFiberPicSpecialization`
if and only if its multidegree belongs to `T.principalDivisors`. -/
theorem mem_ker_reducedSpecialFiberPicSpecialization_iff
    {a : Additive (LineBundleClass (specialFiber R toBase).left.nilradical.subscheme)} :
    a ∈ AddMonoidHom.ker (toBase.reducedSpecialFiberPicSpecialization hX h₀ h₁ hπ hreg) ↔
      toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg a ∈
        (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).principalDivisors := by
  rw [AddMonoidHom.mem_ker, reducedSpecialFiberPicSpecialization_apply,
    Submodule.Quotient.mk_eq_zero]

/-- A line-bundle class on `X` lies in the kernel of `specialFiberPicSpecialization` if and only if
it has the same multidegree on the special fibre as a `ℤ`-linear combination of the vertical
component bundles `𝒪_X(Cⱼ)`. -/
theorem mem_ker_specialFiberPicSpecialization_iff {a : Additive (LineBundleClass X)} :
    a ∈ AddMonoidHom.ker (toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg) ↔
      ∃ v : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component → ℤ,
        toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg a =
          toBase.specialFiberMultidegree hX h₀ h₁ hπ hreg
            (∑ j, v j • Additive.ofMul (LineBundleClass.mk
              (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
                hX j.1.2).toInvertibleSheaf)⁻¹) := by
  rw [AddMonoidHom.mem_ker, specialFiberPicSpecialization_apply, Submodule.Quotient.mk_eq_zero,
    NumericalType.mem_principalDivisors_iff]
  refine exists_congr fun v ↦ ?_
  rw [toBase.specialFiberMultidegree_sum_smul_eq_vecMul hX h₀ h₁ hπ hreg v, eq_comm]

/-- Under the injective comparison map `T.picToCoker : T.Pic →ₗ[ℤ] T.Coker` of
[Stacks, Tag 0CE7](https://stacks.math.columbia.edu/tag/0CE7), `specialFiberPicSpecialization a`
maps to the class of the unweighted intersection tuple `i ↦ (a · Cᵢ)_k`. -/
theorem picToCoker_specialFiberPicSpecialization (a : Additive (LineBundleClass X)) :
    (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).picToCoker
        (toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg a) =
      Submodule.Quotient.mk fun i ↦
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
        LineBundleClass.intersectionNumber (ResidueField R)
          (vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subschemeι a.toMul := by
  rw [specialFiberPicSpecialization_apply, NumericalType.picToCoker_mk]
  congr 1
  funext i
  exact toBase.weightScaling_specialFiberMultidegree hX h₀ h₁ hπ hreg a i

/-! ### Numerical total degree and the degree-zero subgroup -/

/-- The numerical total degree of `reducedSpecialFiberPicSpecialization a` is the
multiplicity-weighted sum `∑ᵢ mᵢ (a · Cᵢ)_k` of its intersection numbers over the residue field. -/
theorem degree_reducedSpecialFiberPicSpecialization
    (a : Additive (LineBundleClass (specialFiber R toBase).left.nilradical.subscheme)) :
    (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).degree
        (toBase.reducedSpecialFiberPicSpecialization hX h₀ h₁ hπ hreg a) =
      ∑ i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component,
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
        ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).multiplicity i : ℤ) *
          LineBundleClass.intersectionNumber (ResidueField R)
            (subschemeToSpecialFiber
              (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
                (toBase.base_eq_closedPoint_of_specialFiberNumericalType
                  hX h₀ h₁ hπ hreg i))).liftNilradicalSubscheme a.toMul := by
  let T := toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg
  rw [reducedSpecialFiberPicSpecialization_apply, T.degree_mk, T.totalDegree_apply]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  have hscale := toBase.weightScaling_reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg a i
  rw [T.weightScaling_apply] at hscale
  calc toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg a i *
        ((T.multiplicity i : ℤ) * (T.weight i : ℤ))
      = (T.multiplicity i : ℤ) *
          (toBase.reducedSpecialFiberMultidegree hX h₀ h₁ hπ hreg a i * (T.weight i : ℤ)) := by
        ring
    _ = _ := by rw [hscale]

/-- The numerical total degree of `specialFiberSubschemePicSpecialization a` is
`∑ᵢ mᵢ (a · Cᵢ)_k`. -/
theorem degree_specialFiberSubschemePicSpecialization
    (a : Additive (LineBundleClass (specialFiber R toBase).left)) :
    (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).degree
        (toBase.specialFiberSubschemePicSpecialization hX h₀ h₁ hπ hreg a) =
      ∑ i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component,
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
        ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).multiplicity i : ℤ) *
          LineBundleClass.intersectionNumber (ResidueField R)
            (subschemeToSpecialFiber
              (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
                (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i)))
            a.toMul := by
  rw [specialFiberSubschemePicSpecialization_eq_comp, AddMonoidHom.comp_apply,
    degree_reducedSpecialFiberPicSpecialization]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  let := subschemeOverResidueField
    (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
  rw [MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply,
    LineBundleClass.intersectionNumber_pullback, liftNilradicalSubscheme_subschemeι]

/-- The numerical total degree of `specialFiberPicSpecialization a` is `∑ᵢ mᵢ (a · Cᵢ)_k`. -/
theorem degree_specialFiberPicSpecialization (a : Additive (LineBundleClass X)) :
    (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).degree
        (toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg a) =
      ∑ i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component,
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
        ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).multiplicity i : ℤ) *
          LineBundleClass.intersectionNumber (ResidueField R)
            (vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subschemeι a.toMul := by
  rw [specialFiberPicSpecialization_eq_comp, AddMonoidHom.comp_apply,
    degree_specialFiberSubschemePicSpecialization]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  let := subschemeOverResidueField
    (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
  rw [MonoidHom.toAdditive_apply_apply, toMul_ofMul, LineBundleClass.pullbackHom_apply,
    LineBundleClass.intersectionNumber_pullback, subschemeToSpecialFiber_specialFiberι]

/-- `specialFiberPicSpecialization a` belongs to the finite torsion subgroup
`T.degreeZeroSubgroup` if and only if `∑ᵢ mᵢ (a · Cᵢ)_k = 0`. -/
theorem mem_degreeZeroSubgroup_specialFiberPicSpecialization_iff
    {a : Additive (LineBundleClass X)} :
    toBase.specialFiberPicSpecialization hX h₀ h₁ hπ hreg a ∈
        (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).degreeZeroSubgroup ↔
      (∑ i : (toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).Component,
        letI := subschemeOverResidueField
          (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX h₀ h₁ hπ hreg i))
        ((toBase.specialFiberNumericalType hX h₀ h₁ hπ hreg).multiplicity i : ℤ) *
          LineBundleClass.intersectionNumber (ResidueField R)
            (vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subschemeι a.toMul) = 0 := by
  rw [NumericalType.mem_degreeZeroSubgroup, degree_specialFiberPicSpecialization]

end LocalRing

end AlgebraicGeometry.Scheme.Hom

namespace TauCeti.Model

variable {R K : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K]
  {C : Scheme.{u}} {toK : C ⟶ Spec (.of K)}
  (M : Model R K C toK) [M.IsProper] [IsIntegral M.total]
  [TauCeti.AlgebraicGeometry.IsRegular M.total] [ConnectedSpace (specialFiber R M.toBase).left]
  (hX : ∀ x : M.total, coheight x ≤ 2)
  (h₀ : M.toBase.HasFiniteSpecialFiberCohomology 0)
  (h₁ : M.toBase.HasFiniteSpecialFiberCohomology 1)

/-- Uniformizer-free constant-field multidegree on the reduced special fibre of `M`. -/
def reducedSpecialFiberMultidegree :
    Additive (LineBundleClass (specialFiber R M.toBase).left.nilradical.subscheme) →+
      (M.numericalType hX h₀ h₁).Component → ℤ :=
  let hπ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.reducedSpecialFiberMultidegree hX h₀ h₁
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ)
    (IsSMulRegular.of_ne_zero hπ.ne_zero)

/-- Coordinates of `M.reducedSpecialFiberMultidegree`. -/
theorem reducedSpecialFiberMultidegree_apply
    (a : Additive (LineBundleClass (specialFiber R M.toBase).left.nilradical.subscheme))
    (i : (M.numericalType hX h₀ h₁).Component) :
    M.reducedSpecialFiberMultidegree hX h₀ h₁ a i =
      letI := subschemeOverResidueField
        (M.toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (M.base_eq_closedPoint_of_numericalType hX h₀ h₁ i))
      LineBundleClass.intersectionNumber (ResidueField R)
        (subschemeToSpecialFiber
          (M.toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (M.base_eq_closedPoint_of_numericalType hX h₀ h₁ i))).liftNilradicalSubscheme a.toMul /
        ((M.numericalType hX h₀ h₁).weight i : ℤ) :=
  (rfl)

/-- Uniformizer-free constant-field multidegree on the special fibre of `M`. -/
def specialFiberSubschemeMultidegree :
    Additive (LineBundleClass (specialFiber R M.toBase).left) →+
      (M.numericalType hX h₀ h₁).Component → ℤ :=
  let hπ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.specialFiberSubschemeMultidegree hX h₀ h₁
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ)
    (IsSMulRegular.of_ne_zero hπ.ne_zero)

/-- `M.specialFiberSubschemeMultidegree` factors through pullback to the reduced special fibre. -/
theorem specialFiberSubschemeMultidegree_eq_comp :
    M.specialFiberSubschemeMultidegree hX h₀ h₁ =
      (M.reducedSpecialFiberMultidegree hX h₀ h₁).comp
        (MonoidHom.toAdditive
          (LineBundleClass.pullbackHom (specialFiber R M.toBase).left.nilradical.subschemeι)) :=
  (rfl)

/-- Coordinates of `M.specialFiberSubschemeMultidegree`. -/
theorem specialFiberSubschemeMultidegree_apply
    (a : Additive (LineBundleClass (specialFiber R M.toBase).left))
    (i : (M.numericalType hX h₀ h₁).Component) :
    M.specialFiberSubschemeMultidegree hX h₀ h₁ a i =
      letI := subschemeOverResidueField
        (M.toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (M.base_eq_closedPoint_of_numericalType hX h₀ h₁ i))
      LineBundleClass.intersectionNumber (ResidueField R)
        (subschemeToSpecialFiber
          (M.toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
            (M.base_eq_closedPoint_of_numericalType hX h₀ h₁ i))) a.toMul /
        ((M.numericalType hX h₀ h₁).weight i : ℤ) :=
  let hπ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.specialFiberSubschemeMultidegree_apply hX h₀ h₁
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ)
    (IsSMulRegular.of_ne_zero hπ.ne_zero) a i

/-- Uniformizer-free constant-field multidegree on the total space `M.total`. -/
def specialFiberMultidegree :
    Additive (LineBundleClass M.total) →+ (M.numericalType hX h₀ h₁).Component → ℤ :=
  let hπ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.specialFiberMultidegree hX h₀ h₁
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ)
    (IsSMulRegular.of_ne_zero hπ.ne_zero)

/-- `M.specialFiberMultidegree` factors through pullback to the special fibre. -/
theorem specialFiberMultidegree_eq_comp :
    M.specialFiberMultidegree hX h₀ h₁ =
      (M.specialFiberSubschemeMultidegree hX h₀ h₁).comp
        (MonoidHom.toAdditive (LineBundleClass.pullbackHom (specialFiberι R M.toBase))) :=
  (rfl)

/-- Coordinates of `M.specialFiberMultidegree`. -/
@[simp]
theorem specialFiberMultidegree_apply
    (a : Additive (LineBundleClass M.total))
    (i : (M.numericalType hX h₀ h₁).Component) :
    M.specialFiberMultidegree hX h₀ h₁ a i =
      letI := subschemeOverResidueField
        (M.toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (M.base_eq_closedPoint_of_numericalType hX h₀ h₁ i))
      LineBundleClass.intersectionNumber (ResidueField R)
        (vanishingIdeal ⟨closure {(i.1 : M.total)}, isClosed_closure⟩).subschemeι a.toMul /
        ((M.numericalType hX h₀ h₁).weight i : ℤ) :=
  let hπ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.specialFiberMultidegree_apply hX h₀ h₁
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ)
    (IsSMulRegular.of_ne_zero hπ.ne_zero) a i

/-- On `M.total`, the line bundle `𝒪_{M.total}(Cⱼ)` has multidegree
`(M.numericalType hX h₀ h₁).weightedIntersection j`. -/
theorem specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf
    (j : (M.numericalType hX h₀ h₁).Component) :
    M.specialFiberMultidegree hX h₀ h₁
        (Additive.ofMul (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)⁻¹) =
      (M.numericalType hX h₀ h₁).weightedIntersection j :=
  let hπ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.specialFiberMultidegree_ofMul_inv_mk_toInvertibleSheaf hX h₀ h₁
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ)
    (IsSMulRegular.of_ne_zero hπ.ne_zero) j

/-- On `M.total`, the ideal-sheaf line bundle `𝒪_{M.total}(-Cⱼ)` has multidegree
`-(M.numericalType hX h₀ h₁).weightedIntersection j`. -/
@[simp]
theorem specialFiberMultidegree_ofMul_mk_toInvertibleSheaf
    (j : (M.numericalType hX h₀ h₁).Component) :
    M.specialFiberMultidegree hX h₀ h₁
        (Additive.ofMul (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
