/-!
# The numerical type of a proper regular model

Let `R` be a local ring of Krull dimension at most one whose maximal ideal is generated by a
nonzerodivisor `π`, with residue field `k`, and let `X` be a regular Noetherian integral scheme,
proper and flat over `R`, with connected special fibre and all points of codimension at most two.
Every reduced component `Cᵢ` of the special fibre has `k`-finite-dimensional `H⁰` and `H¹`
(`Scheme.Hom.finiteDimensional_cohomology_trivial_subscheme_closure_singleton`), giving a
`TauCeti.NumericalType` (`AlgebraicGeometry.Scheme.Hom.specialFiberNumericalType`,
[Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)) with components `Cᵢ`,
multiplicities `mᵢ = ord_{Cᵢ}(π)`, weights `wᵢ = [κᵢ : k]`, intersections `aᵢⱼ = (Cⱼ · Cᵢ)_k`, and
genera `gᵢ = dim_{κᵢ} H¹(Cᵢ, 𝒪_{Cᵢ})` (`wᵢ gᵢ = dim_k H¹(Cᵢ, 𝒪_{Cᵢ})`), independent of `π`
(`specialFiberNumericalType_congr`). For a proper regular integral `TauCeti.Model` over a DVR,
`TauCeti.Model.numericalType` packages this without choosing a uniformizer.

## References

* [The Stacks Project, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y) and
  [Definition 55.3.1 (Tag 0C6Z)](https://stacks.math.columbia.edu/tag/0C6Z); Q. Liu, *Algebraic
  Geometry and Arithmetic Curves*, Section 9.1.
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing Order
open TauCeti TauCeti.AlgebraicGeometry TauCeti.AlgebraicGeometry.Scheme.Modules
open AlgebraicGeometry.Scheme.IdealSheafData (vanishingIdeal)

universe u

namespace AlgebraicGeometry.Scheme.Hom

section LocalRing

variable {R : Type u} [CommRing R] [IsLocalRing R] [Ring.DimensionLEOne R]
  {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))
  [IsIntegral X] [IsNoetherian X] [TauCeti.AlgebraicGeometry.IsRegular X]
  [IsProper toBase] [Flat toBase] [ConnectedSpace (specialFiber R toBase).left]

/-- **The numerical type of a proper regular model**
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)). Let `X` be a
regular Noetherian integral scheme, proper and flat over a local ring `R` of dimension at most one
whose maximal ideal is generated by a nonzerodivisor `π`, with connected special fibre and all
points of codimension at most two. Its special fibre defines a `TauCeti.NumericalType`; the body is
exposed so `Component` is definitionally the finite subtype of codimension-one points of `X` lying
in the special fibre. -/
@[expose]
def specialFiberNumericalType (hX : ∀ x : X, coheight x ≤ 2)
    {π : R} (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π) :
    NumericalType.{u} :=
  have hπm : π ∈ maximalIdeal R := hπ ▸ Ideal.mem_span_singleton_self π
  have hη : toBase (genericPoint X) ≠ closedPoint R :=
    toBase.base_genericPoint_ne_closedPoint_of_isSMulRegular hπm hreg
  have hR : maximalIdeal R ≠ ⊥ := toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη
  have hπ0 : π ≠ 0 := toBase.ne_zero_of_base_ne_closedPoint hη hπ
  letI : DecidableEq (toBase.finite_setOf_base_eq_closedPoint hR hη).toFinset := Classical.decEq _
  letI : Nonempty (toBase.finite_setOf_base_eq_closedPoint hR hη).toFinset :=
    ((Set.Finite.toFinset_nonempty _).mpr (toBase.nonempty_setOf_base_eq_closedPoint hη)).to_subtype
  { Component := (toBase.finite_setOf_base_eq_closedPoint hR hη).toFinset
    multiplicity i := ⟨toBase.specialFiberMultiplicity π i,
      toBase.specialFiberMultiplicity_pos hη hπm hπ0 i ((Set.Finite.mem_toFinset _).mp i.2)⟩
    weight i := ⟨toBase.specialFiberWeight ((Set.Finite.mem_toFinset _).mp i.2),
      toBase.specialFiberWeight_pos _
        (toBase.finiteDimensional_cohomology_trivial_subscheme_closure_singleton hX
          ((Set.Finite.mem_toFinset _).mp i.2) 0)⟩
    intersection := toBase.specialFiberIntersectionMatrix hX hη
    intersection_isSymm := toBase.specialFiberIntersectionMatrix_isSymm hX hη
    offDiagonal_nonneg _ _ hij := toBase.specialFiberIntersectionMatrix_nonneg_of_ne hX hη hij
    connected := toBase.specialFiberIntersectionMatrix_reflTransGen hX hη
      ((connectedSpace_specialFiber_iff_isPreconnected R toBase).mp inferInstance)
    fiber_relation i := by
      simpa only [Matrix.mulVec, dotProduct, mul_comm, PNat.mk_coe, Pi.zero_apply] using
        congrFun (toBase.specialFiberIntersectionMatrix_mulVec_specialFiberMultiplicity
          hX hη hπ hreg) i
    weight_dvd i j := toBase.specialFiberWeight_dvd_specialFiberIntersectionMatrix hX hη i j
    genus i := Module.finrank Γ((vanishingIdeal ⟨closure {((i : CodimensionOnePoint X) : X)},
        isClosed_closure⟩).subscheme, ⊤)
      (Cohomology (InvertibleSheaf.trivial (vanishingIdeal
        ⟨closure {((i : CodimensionOnePoint X) : X)}, isClosed_closure⟩).subscheme).obj 1) }

section Projections

variable (hX : ∀ x : X, coheight x ≤ 2)
  {π : R} (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π)

/-- The component type of `specialFiberNumericalType` is the finite subtype of codimension-one
points of `X` lying in the special fibre. -/
theorem specialFiberNumericalType_Component (hη : toBase (genericPoint X) ≠ closedPoint R) :
    (toBase.specialFiberNumericalType hX hπ hreg).Component =
      ↥(toBase.finite_setOf_base_eq_closedPoint
        (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset := (rfl)

/-- Every component of `specialFiberNumericalType` lies over the closed point of `Spec R`. -/
theorem base_eq_closedPoint_of_specialFiberNumericalType
    (i : (toBase.specialFiberNumericalType hX hπ hreg).Component) :
    toBase (i.1 : X) = closedPoint R := (Set.Finite.mem_toFinset _).mp i.2

/-- The multiplicity of the `i`-th component in `specialFiberNumericalType`, in `ℕ`. -/
@[simp]
theorem coe_specialFiberNumericalType_multiplicity
    (i : (toBase.specialFiberNumericalType hX hπ hreg).Component) :
    ((toBase.specialFiberNumericalType hX hπ hreg).multiplicity i : ℕ) =
      toBase.specialFiberMultiplicity π i.1 := (rfl)

/-- The weight of the `i`-th component in `specialFiberNumericalType`, in `ℕ`. -/
@[simp]
theorem coe_specialFiberNumericalType_weight
    (i : (toBase.specialFiberNumericalType hX hπ hreg).Component) :
    ((toBase.specialFiberNumericalType hX hπ hreg).weight i : ℕ) =
      toBase.specialFiberWeight
        (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX hπ hreg i) := (rfl)

/-- The intersection matrix of `specialFiberNumericalType` is `specialFiberIntersectionMatrix`. -/
theorem specialFiberNumericalType_intersection (hη : toBase (genericPoint X) ≠ closedPoint R) :
    (toBase.specialFiberNumericalType hX hπ hreg).intersection =
      toBase.specialFiberIntersectionMatrix hX hη := (rfl)

/-- The `(i, j)`-entry of the intersection matrix of `specialFiberNumericalType`. -/
@[simp]
theorem specialFiberNumericalType_intersection_apply
    (i j : (toBase.specialFiberNumericalType hX hπ hreg).Component) :
    (toBase.specialFiberNumericalType hX hπ hreg).intersection i j =
      letI := subschemeOverResidueField
        (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX hπ hreg i))
      LineBundleClass.intersectionNumber (ResidueField R)
        (vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subschemeι
        (LineBundleClass.mk
          (Scheme.IdealSheafData.isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)⁻¹ :=
  toBase.specialFiberIntersectionMatrix_apply hX _ i j

/-- Genus of the `i`-th component in `specialFiberNumericalType`: `dim_{κᵢ} H¹(Cᵢ, 𝒪_{Cᵢ})`. -/
@[simp]
theorem specialFiberNumericalType_genus
    (i : (toBase.specialFiberNumericalType hX hπ hreg).Component) :
    (toBase.specialFiberNumericalType hX hπ hreg).genus i =
      Module.finrank Γ((vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subscheme, ⊤)
        (Cohomology (InvertibleSheaf.trivial
          (vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subscheme).obj 1) := (rfl)

/-- On every component `Cᵢ`, `wᵢ * gᵢ = dim_k H¹(Cᵢ, 𝒪_{Cᵢ})`. -/
theorem weight_mul_genus_specialFiberNumericalType
    (i : (toBase.specialFiberNumericalType hX hπ hreg).Component) :
    letI := subschemeOverResidueField (toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
      (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX hπ hreg i))
    ((toBase.specialFiberNumericalType hX hπ hreg).weight i : ℕ) *
        (toBase.specialFiberNumericalType hX hπ hreg).genus i =
      Module.finrank (ResidueField R) (Cohomology (InvertibleSheaf.trivial
        (vanishingIdeal ⟨closure {(i.1 : X)}, isClosed_closure⟩).subscheme).obj 1) :=
  toBase.specialFiberWeight_mul_finrank_cohomology_one
    (toBase.base_eq_closedPoint_of_specialFiberNumericalType hX hπ hreg i)

/-- **Uniformizer independence of `specialFiberNumericalType`.** Any two nonzerodivisor generators
of `maximalIdeal R` define the same `TauCeti.NumericalType`. -/
theorem specialFiberNumericalType_congr {π' : R}
    (hπ' : maximalIdeal R = Ideal.span {π'}) (hreg' : IsSMulRegular R π') :
    toBase.specialFiberNumericalType hX hπ hreg = toBase.specialFiberNumericalType hX hπ' hreg' :=
  let T := toBase.specialFiberNumericalType hX hπ hreg
  (T.reindex_refl).symm.trans (T.reindex_eq (T' := toBase.specialFiberNumericalType hX hπ' hreg')
    (Equiv.refl T.Component)
    (fun i ↦ PNat.eq (toBase.specialFiberMultiplicity_congr (hπ.symm.trans hπ') i.1).symm)
    (fun _ ↦ rfl) (fun _ _ ↦ rfl) fun _ ↦ rfl)

/-- The special fibre is reduced iff every component has multiplicity `1` in
`specialFiberNumericalType`. -/
theorem isReduced_specialFiber_iff_multiplicity_eq_one :
    IsReduced (specialFiber R toBase).left ↔
      ∀ i, (toBase.specialFiberNumericalType hX hπ hreg).multiplicity i = 1 := by
  have hη := toBase.base_genericPoint_ne_closedPoint_of_isSMulRegular
    (hπ ▸ Ideal.mem_span_singleton_self π) hreg
  rw [toBase.isReduced_specialFiber_iff_specialFiberMultiplicity_eq_one_of_isRegular hX hη hπ]
  exact ⟨fun h i ↦ PNat.eq (h i.1 ((Set.Finite.mem_toFinset _).mp i.2)),
    fun h x hx ↦ congrArg PNat.val (h ⟨x, (Set.Finite.mem_toFinset _).mpr hx⟩)⟩

end Projections

end LocalRing

end AlgebraicGeometry.Scheme.Hom

namespace TauCeti.Model

variable {R K : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K] {C : Scheme.{u}} {toK : C ⟶ Spec (.of K)}
  (M : Model R K C toK) [M.IsProper] [IsIntegral M.total]
  [TauCeti.AlgebraicGeometry.IsRegular M.total] [ConnectedSpace (specialFiber R M.toBase).left]
  (hX : ∀ x : M.total, coheight x ≤ 2)

/-- **The numerical type of a proper regular model** over a discrete valuation ring
([Stacks, Section 55.9 (Tag 0C5Y)](https://stacks.math.columbia.edu/tag/0C5Y)), independent of a
uniformizer (`TauCeti.Model.numericalType_eq_specialFiberNumericalType`). The body is exposed so
`Component` is definitionally the finite subtype of codimension-one points of `M.total` lying in
the special fibre. -/
@[expose]
def numericalType : NumericalType.{u} :=
  let hπ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.specialFiberNumericalType hX ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp
    hπ) (IsSMulRegular.of_ne_zero hπ.ne_zero)

/-- For any uniformizer `π` of `R`, `M.numericalType` equals `specialFiberNumericalType`. -/
theorem numericalType_eq_specialFiberNumericalType {π : R} (hπ : maximalIdeal R = Ideal.span {π}) :
    M.numericalType hX = M.toBase.specialFiberNumericalType hX hπ (.of_ne_zero
      (M.toBase.ne_zero_of_base_ne_closedPoint
        (M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R)) hπ)) :=
  let hπ₀ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.specialFiberNumericalType_congr hX
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ₀) (.of_ne_zero hπ₀.ne_zero) hπ _

/-- The component type of `M.numericalType` is the finite subtype of codimension-one points of
`M.total` lying in the special fibre. -/
theorem numericalType_Component :
    (M.numericalType hX).Component =
      ↥(M.toBase.finite_setOf_base_eq_closedPoint (IsDiscreteValuationRing.not_a_field R)
        (M.toBase.base_genericPoint_ne_closedPoint
          (IsDiscreteValuationRing.not_a_field R))).toFinset := (rfl)

/-- Every component of `M.numericalType` lies over `closedPoint R`. -/
theorem base_eq_closedPoint_of_numericalType (i : (M.numericalType hX).Component) :
    M.toBase (i.1 : M.total) = closedPoint R := (Set.Finite.mem_toFinset _).mp i.2

/-- For any generator `π` of `maximalIdeal R`, `((M.numericalType hX).multiplicity i : ℕ)` is
`M.toBase.specialFiberMultiplicity π i`. -/
theorem coe_numericalType_multiplicity {π : R} (hπ : maximalIdeal R = Ideal.span {π})
    (i : (M.numericalType hX).Component) :
    ((M.numericalType hX).multiplicity i : ℕ) = M.toBase.specialFiberMultiplicity π i.1 :=
  M.toBase.specialFiberMultiplicity_congr (((IsDiscreteValuationRing.irreducible_iff_uniformizer
    _).mp (IsDiscreteValuationRing.exists_irreducible R).choose_spec).symm.trans hπ) i.1

/-- The weight of the `i`-th component in `M.numericalType`, in `ℕ`. -/
@[simp]
theorem coe_numericalType_weight (i : (M.numericalType hX).Component) :
    ((M.numericalType hX).weight i : ℕ) =
      M.toBase.specialFiberWeight (M.base_eq_closedPoint_of_numericalType hX i) := (rfl)

/-- The intersection matrix of `M.numericalType` is `M.toBase.specialFiberIntersectionMatrix`. -/
theorem numericalType_intersection :
    (M.numericalType hX).intersection = M.toBase.specialFiberIntersectionMatrix hX
      (M.toBase.base_genericPoint_ne_closedPoint (IsDiscreteValuationRing.not_a_field R)) := (rfl)

/-- The `(i, j)`-entry of the intersection matrix of `M.numericalType`. -/
@[simp]
theorem numericalType_intersection_apply (i j : (M.numericalType hX).Component) :
    (M.numericalType hX).intersection i j =
      letI := subschemeOverResidueField
        (M.toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
          (M.base_eq_closedPoint_of_numericalType hX i))
      LineBundleClass.intersectionNumber (ResidueField R)
        (vanishingIdeal ⟨closure {(i.1 : M.total)}, isClosed_closure⟩).subschemeι
        (LineBundleClass.mk
          (Scheme.IdealSheafData.isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular
            hX j.1.2).toInvertibleSheaf)⁻¹ :=
  M.toBase.specialFiberIntersectionMatrix_apply hX _ i j

/-- The genus of the `i`-th component in `M.numericalType` is `dim_{κᵢ} H¹(Cᵢ, 𝒪_{Cᵢ})`. -/
@[simp]
theorem numericalType_genus (i : (M.numericalType hX).Component) :
    (M.numericalType hX).genus i =
      Module.finrank Γ((vanishingIdeal ⟨closure {(i.1 : M.total)}, isClosed_closure⟩).subscheme, ⊤)
        (Cohomology (InvertibleSheaf.trivial
          (vanishingIdeal ⟨closure {(i.1 : M.total)}, isClosed_closure⟩).subscheme).obj 1) := (rfl)

/-- On every component `Cᵢ` of `M`, `wᵢ * gᵢ = dim_k H¹(Cᵢ, 𝒪_{Cᵢ})`. -/
theorem weight_mul_genus_numericalType (i : (M.numericalType hX).Component) :
    letI := subschemeOverResidueField
      (M.toBase.ker_specialFiberι_le_vanishingIdeal_closure_singleton
        (M.base_eq_closedPoint_of_numericalType hX i))
    ((M.numericalType hX).weight i : ℕ) * (M.numericalType hX).genus i =
      Module.finrank (ResidueField R) (Cohomology (InvertibleSheaf.trivial
        (vanishingIdeal ⟨closure {(i.1 : M.total)}, isClosed_closure⟩).subscheme).obj 1) :=
  M.toBase.specialFiberWeight_mul_finrank_cohomology_one
    (M.base_eq_closedPoint_of_numericalType hX i)

/-- The special fibre of `M` is reduced iff every component has multiplicity `1` in
`M.numericalType`. -/
theorem isReduced_specialFiber_iff_multiplicity_eq_one :
    IsReduced (specialFiber R M.toBase).left ↔ ∀ i, (M.numericalType hX).multiplicity i = 1 :=
  let hπ₀ := (IsDiscreteValuationRing.exists_irreducible R).choose_spec
  M.toBase.isReduced_specialFiber_iff_multiplicity_eq_one hX
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hπ₀) (.of_ne_zero hπ₀.ne_zero)

end TauCeti.Model

end
