module

public import TauCeti.AlgebraicGeometry.Curves.PlaneCurve.Smooth
public import TauCeti.AlgebraicGeometry.WeilDivisor.Scheme.RiemannRoch.Finiteness
public import TauCeti.AlgebraicGeometry.WeilDivisor.Scheme.SerreDuality

import TauCeti.AlgebraicGeometry.Morphisms.Separated
import TauCeti.FieldTheory.FunctionField.PlaneCurve.Projective

/-!
# The genus of a smooth projective plane curve

Let `G ∈ k[X₀, X₁, X₂]` be an irreducible homogeneous polynomial of degree `d` over a field `k`,
and suppose that every point of `G = 0` over an algebraically closed extension of `k` has a
nonzero partial derivative of `G`. Then the projective plane curve
`C = TauCeti.AlgebraicGeometry.projectivePlaneCurve hG` is a regular proper curve over `k`, and
this file computes its genus:

`dim_k H¹(C, 𝒪_C) = g(k(C)) = (d - 1)(d - 2) / 2`,

where `k(C)` is the function field of the scheme `C` and `g(k(C))` its genus in the sense of
Riemann's theorem. Moreover `k` is the exact constant field of `k(C)`. No hypothesis is placed on
`k`, its characteristic, or the degree `d`.

The function field of `C` is the field of fractions of the coordinate ring
`k[Y₀, Y₁] ⧸ (G|_{Xᵢ = 1})` of any standard chart `D₊(Xᵢ)` with `Xᵢ` not divisible by `G`
(`TauCeti.AlgebraicGeometry.projectivePlaneCurve.functionFieldEquiv`). The classes `x` and `y` of
the two affine coordinates generate it and satisfy the dehomogenized equation, and since `k(C)` is
not algebraic over `k` one of them is transcendental. The genus and the constant field of a field
generated by such a pair are those of a smooth plane curve
(`TauCeti.genus_eq_of_isHomogeneous_of_aeval_insertNth_eq_zero`,
`TauCeti.isIntegrallyClosedIn_of_isHomogeneous_of_aeval_insertNth_eq_zero`). With exact constants,
the cohomological genus of a regular proper curve is the genus of its function field
(`TauCeti.AlgebraicGeometry.SchemeWeilDivisor.genus_eq_genus_functionField`).

## Main results

All in the namespace `TauCeti.AlgebraicGeometry.projectivePlaneCurve`:

* `isIntegrallyClosedIn_functionField`: `k` is the exact constant field of the function field.
* `genus_functionField`: the function field has genus `(d - 1)(d - 2) / 2`.
* `genus_eq`: the genus `dim_k H¹(C, 𝒪_C)` of the curve is `(d - 1)(d - 2) / 2`.

## References

* W. Fulton, *Algebraic Curves*, Sections 5.1 and 8.3.
* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Exercise I.7.2.
-/

public section

open CategoryTheory AlgebraicGeometry MvPolynomial

open scoped IntermediateField

universe u

namespace TauCeti.AlgebraicGeometry.projectivePlaneCurve

variable {k : Type u} [Field k] {K : Type*} [Field K] [Algebra k K] [IsAlgClosed K]
  {G : MvPolynomial (Fin 3) k} {d : ℕ} (hG : G.IsHomogeneous d)
  (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ j, aeval b (pderiv j G) ≠ 0)
  [Fact (Irreducible G)]

include hsm in
/-- In a standard chart `D₊(Xᵢ)` with `Xᵢ` not divisible by `G`, the two affine coordinates
`x` and `y` generate the function field of the curve, one of them is transcendental, and the point
with homogeneous coordinates `x` and `y` in the remaining positions and `1` at position `i` lies
on `G = 0`. -/
private theorem exists_affine_coordinates :
    ∃ (i : Fin 3) (x y : (projectivePlaneCurve hG).functionField),
      (Transcendental k x ∨ Transcendental k y) ∧ k⟮x, y⟯ = ⊤ ∧
        aeval (i.insertNth 1 ![x, y]) G = 0 := by
  obtain ⟨i, hi⟩ := exists_not_dvd_X (G := G) Fact.out
  have := isDomain_quotient_dehomogenize hG hi
  let A := MvPolynomial (Fin 2) k ⧸ Ideal.span {dehomogenize i G}
  -- The coordinate ring of the chart maps into the function field through its fraction field.
  let ι : A →ₐ[k] (projectivePlaneCurve hG).functionField :=
    (functionFieldEquiv hG i hi).symm.toAlgHom.comp (IsScalarTower.toAlgHom k A (FractionRing A))
  let φ := ι.comp (Ideal.Quotient.mkₐ k (Ideal.span {dehomogenize i G}))
  let x := φ (X 0)
  let y := φ (X 1)
  have hφ : φ = aeval ![x, y] := by
    ext j
    fin_cases j <;> simp [x, y]
  -- The function field is the field of fractions of `A`, which `x` and `y` generate.
  have hmem (a : A) : ι a ∈ k⟮x, y⟯ := by
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective k _ a
    have : φ p ∈ (aeval (R := k) ![x, y]).range := by
      rw [hφ]
      exact AlgHom.mem_range_self _ p
    rw [aeval_range, Matrix.range_cons_cons_empty] at this
    exact IntermediateField.algebra_adjoin_le_adjoin k _ this
  have hgen : k⟮x, y⟯ = ⊤ := by
    refine eq_top_iff.mpr fun z _ ↦ ?_
    obtain ⟨a, b, -, hab⟩ := IsFractionRing.div_surjective (A := A) (functionFieldEquiv hG i hi z)
    rw [← (functionFieldEquiv hG i hi).symm_apply_apply z, ← hab, map_div₀]
    exact div_mem (hmem a) (hmem b)
  -- If `x` and `y` were algebraic, so would be the field they generate.
  have hxy : Transcendental k x ∨ Transcendental k y := by
    by_contra! hc
    have := IntermediateField.isAlgebraic_adjoin (K := k) (S := {x, y}) (by
      rintro _ (rfl | rfl)
      exacts [(not_not.mp hc.1).isIntegral, (not_not.mp hc.2).isIntegral])
    rw [hgen] at this
    have : Algebra.IsAlgebraic k (projectivePlaneCurve hG).functionField :=
      IntermediateField.topEquiv.isAlgebraic
    obtain ⟨t, ht⟩ := (isFunctionField hG hsm).exists_transcendental
    exact ht (Algebra.IsAlgebraic.isAlgebraic t)
  refine ⟨i, x, y, hxy, hgen, ?_⟩
  rw [← aeval_dehomogenize, ← hφ, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.mk_singleton_self, map_zero]

include hsm in
/-- **The constant field of a smooth projective plane curve**: for an irreducible nonsingular
homogeneous plane equation, `k` is the exact constant field of the function field of the curve. -/
theorem isIntegrallyClosedIn_functionField :
    IsIntegrallyClosedIn k (projectivePlaneCurve hG).functionField := by
  obtain ⟨i, x, y, hxy, hgen, h⟩ := exists_affine_coordinates hG hsm
  exact isIntegrallyClosedIn_of_isHomogeneous_of_aeval_insertNth_eq_zero hG hsm i hxy hgen h

include hsm in
/-- **The genus of the function field of a smooth projective plane curve**: for an irreducible
nonsingular homogeneous plane equation of degree `d`, the function field of the curve has genus
`(d - 1)(d - 2) / 2`. -/
theorem genus_functionField :
    genus k (projectivePlaneCurve hG).functionField = (d - 1) * (d - 2) / 2 := by
  obtain ⟨i, x, y, hxy, hgen, h⟩ := exists_affine_coordinates hG hsm
  exact genus_eq_of_isHomogeneous_of_aeval_insertNth_eq_zero hG hsm i hxy hgen h

include hsm in
/-- **The genus of a smooth projective plane curve** (Fulton, *Algebraic Curves*, Section 8.3): for
an irreducible nonsingular homogeneous plane equation of degree `d`, the genus
`dim_k H¹(C, 𝒪_C)` of the curve `C` is `(d - 1)(d - 2) / 2`. -/
theorem genus_eq :
    haveI := isCurveOver hG hsm
    haveI := isDiscreteValuationRing_stalk hG hsm
    haveI := finiteDimensional_cohomology_one_trivial_of_isProper k
      (X := projectivePlaneCurve hG) (Scheme.IsCurveOver.topologicalKrullDim_eq_one k)
    (projectivePlaneCurve hG).genus k = (d - 1) * (d - 2) / 2 := by
  have := isCurveOver hG hsm
  have := isDiscreteValuationRing_stalk hG hsm
  let _ : IsNoetherian (projectivePlaneCurve hG) := Scheme.IsCurveOver.isNoetherian k _
  have : (projectivePlaneCurve hG).IsSeparated :=
    Scheme.IsSeparated.of_isSeparated (projectivePlaneCurve hG ↘ Spec (.of k))
  rw [SchemeWeilDivisor.genus_eq_genus_functionField
    (Scheme.IsCurveOver.valuativeCriterion_existence k _)
    (Scheme.IsCurveOver.coheight_le_one (k := k)) (isFunctionField hG hsm)
    (isIntegrallyClosedIn_functionField hG hsm)]
  exact genus_functionField hG hsm

end TauCeti.AlgebraicGeometry.projectivePlaneCurve
