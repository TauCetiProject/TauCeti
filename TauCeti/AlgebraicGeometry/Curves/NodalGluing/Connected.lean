module

public import TauCeti.AlgebraicGeometry.Curves.NodalGluing.Basic
public import Mathlib.Topology.Connected.TotallyDisconnected

/-!
# Connected components of a nodal normalization quotient

The connected components of a curve obtained by identifying flag pairs are exactly the
connected components of its dual graph, provided each normalization component is connected.
Here graph connectivity is expressed by the equivalence relation generated by the pairs of
component indices carrying a node. This permits loops and multiple edges.

`mem_connectedComponent_mk_iff` identifies the component of every point of the quotient.
`preconnectedSpace_gluedCurve_iff` and `connectedSpace_gluedCurve_iff` give the resulting
connectivity criteria, including the nonemptiness condition in the latter. No finiteness,
compactness or separation assumptions are needed for these statements.

The construction uses the existing `GluedCurve` quotient and its lifting property. To separate
different graph components, the component index descends to the discrete quotient of the
vertex set by edge chains.

## References

* E. Arbarello, M. Cornalba and P. A. Griffiths, *Geometry of Algebraic Curves, Volume II*,
  Chapter X, for the normalization and dual graph of a nodal curve.
-/

public noncomputable section

open Set Topology

namespace TauCeti.NodalGluing

variable {ι Flag : Type*} {X : ι → Type*} [∀ i, TopologicalSpace (X i)]
  (d : FlagPairData ι Flag X)

/-- Points in the same connected component of the glued curve lie on normalization
components joined by a chain of nodes. This direction does not require the normalization
components themselves to be connected. -/
theorem eqvGen_of_mem_connectedComponent_mk {x y : Σ i, X i}
    (h : Quotient.mk (gluedRelSetoid d) y ∈
      connectedComponent (Quotient.mk (gluedRelSetoid d) x)) :
    Relation.EqvGen (fun i j ↦ ∃ f, d.fst f = i ∧ d.snd f = j) x.1 y.1 := by
  let r : ι → ι → Prop := fun i j ↦ ∃ f, d.fst f = i ∧ d.snd f = j
  let C := Quotient (Relation.EqvGen.setoid r)
  let : TopologicalSpace C := ⊥
  let : DiscreteTopology C := ⟨rfl⟩
  let g : (Σ i, X i) → C := fun x ↦ Quotient.mk _ x.1
  have hg : ∀ f, g (fstPoint d f) = g (sndPoint d f) := by
    intro f
    rw [fstPoint_def, sndPoint_def]
    exact Quotient.sound (Relation.EqvGen.rel _ _ ⟨f, rfl, rfl⟩)
  have hc : Continuous (GluedCurve.lift d g hg) :=
    GluedCurve.continuous_lift d g hg (continuous_sigma fun _ ↦ by
      dsimp only [g]
      exact continuous_const)
  have heq := isPreconnected_connectedComponent.constant hc.continuousOn
    (x := Quotient.mk (gluedRelSetoid d) x) mem_connectedComponent h
  simp only [GluedCurve.lift_mk] at heq
  exact Quotient.exact heq

/-- All points of one normalization component have the same connected component downstairs. -/
theorem connectedComponent_mk_eq (i : ι) [PreconnectedSpace (X i)] (x y : X i) :
    connectedComponent (Quotient.mk (gluedRelSetoid d) ⟨i, x⟩) =
      connectedComponent (Quotient.mk (gluedRelSetoid d) ⟨i, y⟩) := by
  have hc : Continuous (fun z : X i ↦ Quotient.mk (gluedRelSetoid d) ⟨i, z⟩) :=
    continuous_quotient_mk'.comp continuous_sigmaMk
  exact connectedComponent_eq
    ((isPreconnected_range hc).subset_connectedComponent ⟨x, rfl⟩ ⟨y, rfl⟩)

variable [∀ i, PreconnectedSpace (X i)] [∀ i, Nonempty (X i)]

/-- A chain of nodes identifies the connected components containing any points on its two
endpoint normalization components. -/
theorem connectedComponent_mk_eq_of_eqvGen {i j : ι}
    (h : Relation.EqvGen (fun i j ↦ ∃ f, d.fst f = i ∧ d.snd f = j) i j)
    (x : X i) (y : X j) :
    connectedComponent (Quotient.mk (gluedRelSetoid d) ⟨i, x⟩) =
      connectedComponent (Quotient.mk (gluedRelSetoid d) ⟨j, y⟩) := by
  induction h with
  | rel i j h =>
    obtain ⟨f, rfl, rfl⟩ := h
    calc
      _ = connectedComponent (Quotient.mk (gluedRelSetoid d) (fstPoint d f)) := by
        rw [fstPoint_def]
        exact connectedComponent_mk_eq d _ x _
      _ = connectedComponent (Quotient.mk (gluedRelSetoid d) (sndPoint d f)) := by
        rw [mk_fstPoint, mk_sndPoint]
      _ = _ := by
        rw [sndPoint_def]
        exact connectedComponent_mk_eq d _ _ y
  | refl i => exact connectedComponent_mk_eq d i x y
  | symm i j h ih => exact (ih y x).symm
  | trans i j k h₁ h₂ ih₁ ih₂ =>
    exact (ih₁ x (Classical.arbitrary (X j))).trans (ih₂ (Classical.arbitrary (X j)) y)

/-- Two points of the normalization descend into the same connected component exactly when
their component indices are joined by a chain of nodes. -/
theorem mem_connectedComponent_mk_iff (x y : Σ i, X i) :
    Quotient.mk (gluedRelSetoid d) y ∈
      connectedComponent (Quotient.mk (gluedRelSetoid d) x) ↔
    Relation.EqvGen (fun i j ↦ ∃ f, d.fst f = i ∧ d.snd f = j) x.1 y.1 := by
  refine ⟨eqvGen_of_mem_connectedComponent_mk d, fun h ↦ ?_⟩
  rw [connectedComponent_mk_eq_of_eqvGen d h x.2 y.2]
  exact mem_connectedComponent

/-- The glued curve is preconnected exactly when its dual graph is preconnected. Empty
normalizations are allowed here. -/
theorem preconnectedSpace_gluedCurve_iff :
    PreconnectedSpace (GluedCurve d) ↔
      ∀ i j, Relation.EqvGen (fun i j ↦ ∃ f, d.fst f = i ∧ d.snd f = j) i j := by
  rw [preconnectedSpace_iff_connectedComponent]
  constructor
  · intro h i j
    exact (mem_connectedComponent_mk_iff d
      ⟨i, Classical.arbitrary (X i)⟩ ⟨j, Classical.arbitrary (X j)⟩).mp (by rw [h]; trivial)
  · intro h x
    apply Set.eq_univ_of_forall
    induction x using Quotient.inductionOn with | _ x => ?_
    intro y
    induction y using Quotient.inductionOn with | _ y => ?_
    exact (mem_connectedComponent_mk_iff d x y).mpr (h x.1 y.1)

/-- The glued curve is connected exactly when the vertex set is nonempty and every two
vertices are joined by a chain of nodes. -/
theorem connectedSpace_gluedCurve_iff :
    ConnectedSpace (GluedCurve d) ↔ Nonempty ι ∧
      ∀ i j, Relation.EqvGen (fun i j ↦ ∃ f, d.fst f = i ∧ d.snd f = j) i j := by
  constructor
  · intro h
    obtain ⟨z⟩ := h.toNonempty
    obtain ⟨⟨i, x⟩, rfl⟩ := Quotient.mk_surjective z
    exact ⟨⟨i⟩, (preconnectedSpace_gluedCurve_iff d).mp h.toPreconnectedSpace⟩
  · rintro ⟨hi, h⟩
    let : Nonempty ι := hi
    let : PreconnectedSpace (GluedCurve d) := (preconnectedSpace_gluedCurve_iff d).mpr h
    exact ⟨⟨Quotient.mk _ ⟨Classical.choice hi, Classical.arbitrary _⟩⟩⟩

end TauCeti.NodalGluing
