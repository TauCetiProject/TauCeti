namespace TauCeti.AlgebraicGeometry

section ClosedPoint

variable {A L : Type u} [CommRing A] [IsLocalRing A] [Field L] [Algebra A L]
  [IsLocalHom (algebraMap A L)]

/-- If the closed fibre `κ ⊗[A] B` of `A → B` is a finite étale `κ`-algebra, then the base change of
`Spec B ⟶ Spec A` along a field-valued point of the closed point of `Spec A` is finite étale, of
the same rank. -/
private theorem etale_isFinite_finrank_of_isPullback_SpecMap {B : Type u} [CommRing B]
    [Algebra A B] [Algebra.Etale (ResidueField A) (ResidueField A ⊗[A] B)]
    [Module.Finite (ResidueField A) (ResidueField A ⊗[A] B)] {P : Scheme.{u}}
    {fst : P ⟶ Spec (.of B)} {snd : P ⟶ Spec (.of L)}
    (h : IsPullback fst snd (Spec.map (CommRingCat.ofHom (algebraMap A B)))
      (Spec.map (CommRingCat.ofHom (algebraMap A L)))) :
    Etale snd ∧ IsFinite snd ∧ ∀ y, snd.finrank y =
      Module.finrank (ResidueField A) (ResidueField A ⊗[A] B) := by
  -- The base change `L ⊗[A] B` is the base change of the closed fibre along `κ → L`.
  let := (ResidueField.lift (algebraMap A L)).toAlgebra
  have : IsScalarTower A (ResidueField A) L := .of_algebraMap_eq fun a ↦ by
    simp [RingHom.algebraMap_toAlgebra]
  let e : L ⊗[ResidueField A] (ResidueField A ⊗[A] B) ≃ₐ[L] L ⊗[A] B :=
    Algebra.TensorProduct.cancelBaseChange A (ResidueField A) L L B
  have : Algebra.Etale L (L ⊗[A] B) := .of_equiv e
  have : Module.Finite L (L ⊗[A] B) := .equiv e.toLinearEquiv
  have hsnd := h.isoIsPullback_hom_snd _ _
    (isPullback_SpecMap_of_isPushout _ _ _ _ (CommRingCat.isPushout_tensorProduct A L B)).flip
  have : Etale (Spec.map (CommRingCat.ofHom (algebraMap L (L ⊗[A] B)))) :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (RingHom.etale_algebraMap.mpr inferInstance)
  have : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap L (L ⊗[A] B)))) :=
    (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr inferInstance)
  refine ⟨hsnd ▸ inferInstance, hsnd ▸ inferInstance, fun y ↦ ?_⟩
  rw [← hsnd, Scheme.Hom.finrank_comp_left_of_isIso]
  refine (Scheme.Hom.finrank_SpecMap_algebraMap L (L ⊗[A] B) y).trans ?_
  rw [Module.rankAtStalk_eq_finrank_of_free, ← e.toLinearEquiv.finrank_eq,
    Module.finrank_baseChange]
  exact Pi.natCast_apply _ _

/-- Let `I = (a, b)` with `b² ∈ a I`, so that the chart `Spec A[I/a]` is the whole blowup of
`Spec A` along `V(I)`. If the closed fibre `κ ⊗[A] A[I/a]` is a finite étale `κ`-algebra, then the
base change of the blowup along a field-valued point of the closed point of `Spec A` is finite
étale, of the same rank. -/
private theorem etale_isFinite_finrank_of_isPullback_toSpecCoeff {I : Ideal A} {a b : A}
    (hI : I = Ideal.span {a, b}) (hb : b ^ 2 ∈ Ideal.span {a} * I)
    [Algebra.Etale (ResidueField A) (ResidueField A ⊗[A] I.affineBlowup a (Localization.Away a))]
    [Module.Finite (ResidueField A) (ResidueField A ⊗[A] I.affineBlowup a (Localization.Away a))]
    {P : Scheme.{u}} {fst : P ⟶ Proj (grade I)} {snd : P ⟶ Spec (.of L)}
    (h : IsPullback fst snd (Proj.toSpecCoeff (grade I))
      (Spec.map (CommRingCat.ofHom (algebraMap A L)))) :
    Etale snd ∧ IsFinite snd ∧ ∀ y, snd.finrank y = Module.finrank (ResidueField A)
      (ResidueField A ⊗[A] I.affineBlowup a (Localization.Away a)) := by
  have ha : a ∈ I := hI ▸ Ideal.subset_span (Set.mem_insert _ _)
  have := isIso_affineBlowupι_of_sq_mem (Localization.Away a) ha hI.symm hb
  have hι : affineBlowupι (Localization.Away a) ha ≫ Proj.toSpecCoeff (grade I) =
      Spec.map (CommRingCat.ofHom (algebraMap A (I.affineBlowup a (Localization.Away a)))) := by
    rw [toSpecCoeff_reesAlgebra, affineBlowupι_toSpecZero]
  refine etale_isFinite_finrank_of_isPullback_SpecMap (fst := fst ≫ inv (affineBlowupι _ ha)) ?_
  refine h.of_iso (Iso.refl _) (asIso (affineBlowupι _ ha)).symm (Iso.refl _) (Iso.refl _)
    (by simp) (by simp) ?_ (by simp)
  simp [← hι]

end ClosedPoint

section Node

variable {K : Type u} [Field K] {X : Scheme.{u}} [X.Over (Spec (.of K))]

/-- **The singular ideal at a node.** Let `W` be a standard syntomic affine chart of a nodal curve
`X` over `K`, and `q` a prime of `Γ(X, W)` containing the ideal `J` of the singular subscheme.
Then `J` generates the maximal ideal of the localization `A` at `q`, it is generated there by two
elements `a, b` with `b² ∈ a (J A)`, and the closed fibre of the chart `Spec A[J A/a]` of the
blowup is an étale algebra of dimension two over the residue field. -/
private theorem exists_etale_tensor_affineBlowup_singularLocus_ideal
    (hnodal : AtWorstNodalOfRelativeDimensionOne (X ↘ Spec (.of K))) (W : X.affineOpens)
    (hstd : IsStandardSyntomicOfRelativeDimension 1
      ((X ↘ Spec (.of K)).appLE ⊤ W (by simp)).hom)
    (q : Ideal Γ(X, W)) [q.IsPrime]
    (hq : letI := hnodal.syntomic; (X.singularLocus K).ideal W ≤ q) :
    letI := hnodal.syntomic
    ∃ a b : Localization.AtPrime q,
      ((X.singularLocus K).ideal W).map (algebraMap Γ(X, W) (Localization.AtPrime q)) =
        Ideal.span {a, b} ∧
      b ^ 2 ∈ Ideal.span {a} *
        ((X.singularLocus K).ideal W).map (algebraMap Γ(X, W) (Localization.AtPrime q)) ∧
      Module.finrank (ResidueField (Localization.AtPrime q))
        (ResidueField (Localization.AtPrime q) ⊗[Localization.AtPrime q]
          (((X.singularLocus K).ideal W).map (algebraMap Γ(X, W) (Localization.AtPrime q))
            ).affineBlowup a (Localization.Away a)) = 2 ∧
      Algebra.Etale (ResidueField (Localization.AtPrime q))
        (ResidueField (Localization.AtPrime q) ⊗[Localization.AtPrime q]
          (((X.singularLocus K).ideal W).map (algebraMap Γ(X, W) (Localization.AtPrime q))
            ).affineBlowup a (Localization.Away a)) := by
  have : SyntomicOfRelativeDimension 1 (X ↘ Spec (.of K)) := hnodal.syntomic
  -- `Γ(X, W)` is a standard syntomic `K`-algebra of relative dimension one, presented by `c + 1`
  -- generators and `c` relations.
  let : Algebra K Γ(X, W) := ((X.baseRingToStructurePresheaf K).app (op W.1)).hom.toAlgebra
  have : Algebra.IsStandardSyntomicOfRelativeDimension 1 K Γ(X, W) := by
    refine (isStandardSyntomicOfRelativeDimension_iff 1 _).mp ?_
    rw [Scheme.baseRingToStructurePresheaf_app_eq_appLE, CommRingCat.hom_comp]
    exact (isStandardSyntomicOfRelativeDimension_respectsIso 1).right _
      (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv hstd
  obtain ⟨ι, σ, _, _, P, hcard⟩ :=
    Algebra.IsStandardSyntomicOfRelativeDimension.exists_presentation (n := 1) (R := K)
      (S := Γ(X, W))
  have := Fintype.ofFinite ι
  have := Fintype.ofFinite σ
  have hP : Fintype.card σ + 1 = Fintype.card ι := by
    rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card, hcard, add_comm]
  have : Algebra.FinitePresentation K Γ(X, W) :=
    Algebra.IsStandardSyntomicOfRelativeDimension.finitePresentation (n := 1)
  have hJ := X.singularLocus_ideal (R := K) W
  have : Algebra.FormallyUnramified K (Γ(X, W) ⧸ fittingIdeal Γ(X, W) Ω[Γ(X, W)⁄K] 1) :=
    hJ ▸ X.formallyUnramified_quotient_singularLocus_ideal hnodal W
  rw [hJ] at hq ⊢
  -- The singular ideal generates the maximal ideal of `A`, since the singular subscheme is
  -- unramified over `K`.
  let A := Localization.AtPrime q
  have : Algebra.EssFiniteType Γ(X, W) A := .of_isLocalization A q.primeCompl
  have : Algebra.EssFiniteType K A := .comp K Γ(X, W) A
  have hfit : fittingIdeal A Ω[A⁄K] 1 =
      (fittingIdeal Γ(X, W) Ω[Γ(X, W)⁄K] 1).map (algebraMap Γ(X, W) A) :=
    (KaehlerDifferential.isBaseChange_of_formallyEtale K Γ(X, W) A).fittingIdeal_eq_map 1
  have : Algebra.FormallyUnramified K (A ⧸ fittingIdeal A Ω[A⁄K] 1) :=
    formallyUnramified_localization_quotient_fittingIdeal q.primeCompl
  have hne : fittingIdeal A Ω[A⁄K] 1 ≠ ⊤ := by
    rw [hfit]
    exact ne_top_of_le_ne_top (maximalIdeal.isMaximal A).ne_top
      ((Ideal.map_mono hq).trans Localization.AtPrime.map_eq_maximalIdeal.le)
  rw [← hfit, Ideal.eq_maximalIdeal_of_formallyUnramified_quotient K hne]
  exact P.exists_etale_tensor_affineBlowup_of_formallyUnramified hP q hq

/-- **The blowup of a nodal curve along its singular subscheme, over a field-valued point of
the singular subscheme.** Let `X` be a nodal curve over a field `K`, and `t` a field-valued point
of its singular subscheme. The base change of the blowup of `X` along the singular subscheme to
`t` is finite étale of rank two. -/
private theorem etale_isFinite_finrank_of_isPullback_blowupToBase
    (hnodal : AtWorstNodalOfRelativeDimensionOne (X ↘ Spec (.of K))) {L : Type u} [Field L]
    (t : Spec (.of L) ⟶ (letI := hnodal.syntomic; (X.singularLocus K).subscheme))
    {P : Scheme.{u}} {fst : P ⟶ (letI := hnodal.syntomic; (X.singularLocus K).blowup)}
    {snd : P ⟶ Spec (.of L)}
    (h : letI := hnodal.syntomic
      IsPullback fst snd (X.singularLocus K).blowupToBase (t ≫ (X.singularLocus K).subschemeι)) :
    Etale snd ∧ IsFinite snd ∧ ∀ y, snd.finrank y = 2 := by
  have : SyntomicOfRelativeDimension 1 (X ↘ Spec (.of K)) := hnodal.syntomic
  obtain ⟨pt⟩ : Nonempty (Spec (.of L)) := inferInstance
  obtain ⟨W, hxW, _, hstd⟩ :=
    SyntomicOfRelativeDimension.exists_isStandardSyntomicOfRelativeDimension_appLE_top 1
      (X ↘ Spec (.of K)) ((t ≫ (X.singularLocus K).subschemeι) pt)
  -- The point `t` is the spectrum of a homomorphism `ψ₀ : Γ(X, W) → L`.
  have hu : Set.range (t ≫ (X.singularLocus K).subschemeι) ⊆ Set.range W.1.ι := by
    rintro _ ⟨y, rfl⟩
    simpa [Subsingleton.elim y pt] using hxW
  obtain ⟨ψ₀, hψ₀⟩ := Spec.map_surjective
    (IsOpenImmersion.lift W.1.ι (t ≫ (X.singularLocus K).subschemeι) hu ≫ W.2.isoSpec.hom)
  replace hψ₀ : Spec.map ψ₀ ≫ W.2.fromSpec = t ≫ (X.singularLocus K).subschemeι := by
    rw [hψ₀, ← W.2.isoSpec_inv_ι, Category.assoc, Iso.hom_inv_id_assoc, IsOpenImmersion.lift_fac]
  -- Its kernel `q` contains the ideal of the singular subscheme.
  let q := RingHom.ker ψ₀.hom
  have : q.IsPrime := RingHom.ker_isPrime _
  have hq : (X.singularLocus K).ideal W ≤ q := by
    intro r hr
    have hx : (t ≫ (X.singularLocus K).subschemeι) pt ∈
        Set.range (X.singularLocus K).subschemeι := ⟨t pt, rfl⟩
    rw [(X.singularLocus K).range_subschemeι] at hx
    by_contra hne
    refine (X.mem_zeroLocus_iff _ _).mp
      (((X.singularLocus K).mem_support_iff_of_mem hxW).mp hx) r hr ?_
    have hpt : pt ∈ (Spec.map ψ₀ ≫ W.2.fromSpec) ⁻¹ᵁ X.basicOpen r := by
      rw [Scheme.Hom.comp_preimage, W.2.fromSpec_preimage_basicOpen, SpecMap_preimage_basicOpen]
      refine (PrimeSpectrum.mem_basicOpen _ _).mpr ?_
      rwa [@Ideal.eq_bot_of_prime _ _ pt.asIdeal pt.isPrime, Ideal.mem_bot]
    rwa [hψ₀] at hpt
  -- `ψ₀` factors through a local homomorphism from the localization `A` of `Γ(X, W)` at `q`.
  let A := Localization.AtPrime q
  let := ψ₀.hom.toAlgebra
  have hunit (y : q.primeCompl) : IsUnit (algebraMap Γ(X, W) L y) :=
    isUnit_iff_ne_zero.mpr fun hy ↦ y.2 (RingHom.mem_ker.mpr hy)
  let := (IsLocalization.lift (M := q.primeCompl) (S := A) hunit).toAlgebra
  have : IsScalarTower Γ(X, W) A L :=
    .of_algebraMap_eq fun r ↦ (IsLocalization.lift_eq (M := q.primeCompl) (S := A) hunit r).symm
  have : IsLocalHom (algebraMap A L) := by
    refine ⟨fun z hz ↦ ?_⟩
    obtain ⟨⟨r, y⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
    rw [IsLocalization.AtPrime.isUnit_mk'_iff A q]
    intro hr
    have hspec := congrArg (algebraMap A L) (IsLocalization.mk'_spec A r y)
    rw [map_mul, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply,
      RingHom.algebraMap_toAlgebra ψ₀.hom, RingHom.mem_ker.mp hr] at hspec
    exact hz.ne_zero ((mul_eq_zero.mp hspec).resolve_right (hunit y).ne_zero)
  -- Blowing up commutes with the flat base change to `Spec A`, so the base change of the blowup
  -- to `t` is that of the blowup of `Spec A` along the maximal ideal.
  have hbot : Spec.map (CommRingCat.ofHom (algebraMap A L)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap Γ(X, W) A)) ≫ W.2.fromSpec =
        t ≫ (X.singularLocus K).subschemeι := by
    rw [← hψ₀, ← Category.assoc, ← Spec.map_comp]
    congr 2
    ext r
    exact (IsScalarTower.algebraMap_apply Γ(X, W) A L r).symm
  have hsq := (isPullback_affineBlowup_of_flat ((X.singularLocus K).ideal W) A).paste_horiz
    ((X.singularLocus K).isPullback_blowupChart_fromSpec W.2).flip
  obtain ⟨a, b, hm, hb, hrank, het⟩ :=
    exists_etale_tensor_affineBlowup_singularLocus_ideal hnodal W hstd q hq
  have : Module.Finite (ResidueField A) (ResidueField A ⊗[A]
      (((X.singularLocus K).ideal W).map (algebraMap Γ(X, W) A)).affineBlowup a
        (Localization.Away a)) :=
    Module.finite_of_finrank_pos (by rw [hrank]; norm_num)
  obtain ⟨h₁, h₂, h₃⟩ := etale_isFinite_finrank_of_isPullback_toSpecCoeff hm hb
    (IsPullback.of_right' (hbot ▸ h) hsq)
  exact ⟨h₁, h₂, fun y ↦ (h₃ y).trans hrank⟩

end Node

end TauCeti.AlgebraicGeometry

namespace AlgebraicGeometry.Scheme

open TauCeti.AlgebraicGeometry

section BranchScheme

variable (R : Type u) [CommRing R] (X : Scheme.{u}) [X.Over (Spec (.of R))]
  [Flat (X ↘ Spec (.of R))] [LocallyOfFinitePresentation (X ↘ Spec (.of R))]
  [PureRelativeDimension 1 (X ↘ Spec (.of R))]

/-- The **branch scheme** of a relative curve `X` over `R`: the scheme-theoretic inverse image
`Sing(X/R) ×_X Bl X` of the singular subscheme `Sing(X/R)` in the blowup `Bl X` of `X` along
`Sing(X/R)`. For a nodal curve over a field it is finite étale of rank two over the singular
subscheme (`AlgebraicGeometry.Scheme.finrank_branchSchemeToSingularLocus`): its points over a node
are the tangent directions of the two branches through it. -/
def branchScheme : Scheme.{u} :=
  pullback (X.singularLocus R).subschemeι (X.singularLocus R).blowupToBase

/-- The projection of the branch scheme to the singular subscheme. -/
def branchSchemeToSingularLocus : X.branchScheme R ⟶ (X.singularLocus R).subscheme :=
  pullback.fst _ _

/-- The inclusion of the branch scheme into the blowup along the singular subscheme. -/
def branchSchemeToBlowup : X.branchScheme R ⟶ (X.singularLocus R).blowup :=
  pullback.snd _ _

/-- The two maps out of the branch scheme agree in `X`. -/
@[reassoc]
theorem branchSchemeToSingularLocus_subschemeι :
    X.branchSchemeToSingularLocus R ≫ (X.singularLocus R).subschemeι =
      X.branchSchemeToBlowup R ≫ (X.singularLocus R).blowupToBase :=
  pullback.condition

/-- The branch scheme is the inverse image of the singular subscheme in the blowup along it. -/
theorem isPullback_branchScheme :
    IsPullback (X.branchSchemeToSingularLocus R) (X.branchSchemeToBlowup R)
      (X.singularLocus R).subschemeι (X.singularLocus R).blowupToBase :=
  IsPullback.of_hasPullback _ _

end BranchScheme

variable {K : Type u} [Field K] (X : Scheme.{u}) [X.Over (Spec (.of K))]

/-- The base change of the branch scheme of a nodal curve over a field to a field-valued point of
its singular subscheme is finite étale of rank two. -/
private theorem etale_isFinite_finrank_pullback_snd_branchSchemeToSingularLocus
    (hnodal : AtWorstNodalOfRelativeDimensionOne (X ↘ Spec (.of K))) {L : Type u} [Field L]
    (t : Spec (.of L) ⟶ (letI := hnodal.syntomic; (X.singularLocus K).subscheme)) :
    letI := hnodal.syntomic
    Etale (pullback.snd (X.branchSchemeToSingularLocus K) t) ∧
      IsFinite (pullback.snd (X.branchSchemeToSingularLocus K) t) ∧
      ∀ y, (pullback.snd (X.branchSchemeToSingularLocus K) t).finrank y = 2 := by
  have : SyntomicOfRelativeDimension 1 (X ↘ Spec (.of K)) := hnodal.syntomic
  exact etale_isFinite_finrank_of_isPullback_blowupToBase hnodal t
    ((IsPullback.of_hasPullback _ t).paste_horiz (X.isPullback_branchScheme K).flip)

/-- The branch scheme of a nodal curve over a field is proper over its singular subscheme: it is
a base change of the blowup along an ideal sheaf of finite type. -/
private theorem isProper_branchSchemeToSingularLocus
    (hnodal : AtWorstNodalOfRelativeDimensionOne (X ↘ Spec (.of K))) :
    letI := hnodal.syntomic
    IsProper (X.branchSchemeToSingularLocus K) := by
  have : SyntomicOfRelativeDimension 1 (X ↘ Spec (.of K)) := hnodal.syntomic
  have := LocallyOfFiniteType.isLocallyNoetherian (X ↘ Spec (.of K))
  have := (X.singularLocus K).isProper_blowupToBase fun U ↦
    have := IsLocallyNoetherian.component_noetherian U
    IsNoetherian.noetherian _
  exact MorphismProperty.of_isPullback (X.isPullback_branchScheme K).flip this

/-- **The branches of a nodal curve over a field are étale over its nodes.** The branch scheme of
a nodal curve over a field is étale over the singular subscheme. -/
theorem etale_branchSchemeToSingularLocus
    (hnodal : AtWorstNodalOfRelativeDimensionOne (X ↘ Spec (.of K))) :
    letI := hnodal.syntomic
    Etale (X.branchSchemeToSingularLocus K) := by
  have : SyntomicOfRelativeDimension 1 (X ↘ Spec (.of K)) := hnodal.syntomic
  have : LocallyOfFiniteType (X.branchSchemeToSingularLocus K) :=
    have := X.isProper_branchSchemeToSingularLocus hnodal
    inferInstance
  -- Unramifiedness is checked on the base changes to field-valued points.
  have : FormallyUnramified (X.branchSchemeToSingularLocus K) :=
    (X.branchSchemeToSingularLocus K).formallyUnramified_of_formallyUnramified_baseChange_field
      fun L _ t ↦
        have := (etale_isFinite_finrank_pullback_snd_branchSchemeToSingularLocus X hnodal t).1
        inferInstance
  -- Over the field `K` flatness is automatic, so the branch scheme is étale over `K`; since the
  -- singular subscheme is unramified over `K`, it is étale over the singular subscheme.
  have : Etale ((X.singularLocus K).subschemeι ≫ (X ↘ Spec (.of K))) :=
    X.etale_singularLocus_subschemeι_comp hnodal
  have : FormallyUnramified (X.branchSchemeToSingularLocus K ≫
      (X.singularLocus K).subschemeι ≫ (X ↘ Spec (.of K))) :=
    MorphismProperty.comp_mem _ _ _ ‹_› inferInstance
  have : Etale (X.branchSchemeToSingularLocus K ≫
      (X.singularLocus K).subschemeι ≫ (X ↘ Spec (.of K))) :=
    .of_formallyUnramified_of_flat _
  exact .of_comp _ ((X.singularLocus K).subschemeι ≫ (X ↘ Spec (.of K)))

/-- **The branches of a nodal curve over a field are finite over its nodes.** The branch scheme of
a nodal curve over a field is finite over the singular subscheme. -/
theorem isFinite_branchSchemeToSingularLocus
    (hnodal : AtWorstNodalOfRelativeDimensionOne (X ↘ Spec (.of K))) :
    letI := hnodal.syntomic
    IsFinite (X.branchSchemeToSingularLocus K) := by
  have : SyntomicOfRelativeDimension 1 (X ↘ Spec (.of K)) := hnodal.syntomic
  have := X.isProper_branchSchemeToSingularLocus hnodal
  have := X.etale_branchSchemeToSingularLocus hnodal
  exact IsFinite.of_isProper_of_locallyQuasiFinite _

/-- **Every node of a nodal curve over a field has two branches.** The branch scheme of a nodal
curve over a field has rank two over every point of the singular subscheme. -/
theorem finrank_branchSchemeToSingularLocus
    (hnodal : AtWorstNodalOfRelativeDimensionOne (X ↘ Spec (.of K)))
    (s : (letI := hnodal.syntomic; (X.singularLocus K).subscheme)) :
    letI := hnodal.syntomic
    (X.branchSchemeToSingularLocus K).finrank s = 2 := by
  have : SyntomicOfRelativeDimension 1 (X ↘ Spec (.of K)) := hnodal.syntomic
  have := X.isFinite_branchSchemeToSingularLocus hnodal
  have := X.etale_branchSchemeToSingularLocus hnodal
  let t := (X.singularLocus K).subscheme.fromSpecResidueField s
  obtain ⟨y⟩ : Nonempty (Spec ((X.singularLocus K).subscheme.residueField s)) := inferInstance
  rw [← (X.singularLocus K).subscheme.fromSpecResidueField_apply s y,
    ← Scheme.Hom.finrank_of_isPullback _ _ _ _ (IsPullback.of_hasPullback _ t)]
  exact (etale_isFinite_finrank_pullback_snd_branchSchemeToSingularLocus X hnodal t).2.2 y

end AlgebraicGeometry.Scheme
