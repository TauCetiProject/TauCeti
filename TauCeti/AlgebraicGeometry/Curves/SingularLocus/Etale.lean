module

public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import TauCeti.AlgebraicGeometry.Curves.SingularLocus.Basic

/-!
# The singular locus along étale morphisms

Let `g : X' ⟶ X` be an étale morphism of relative curves over `Spec R`. Then the relative singular
locus of `X'` is the inverse image of that of `X`: `Sing(X'/R) = g⁻¹ Sing(X/R)`, as ideal sheaves
and hence as closed subschemes. On affine charts `V ⊆ g⁻¹ U`, the ring map `Γ(X, U) → Γ(X', V)`
is étale, so `Ω[Γ(X', V)⁄R]` is the base change of `Ω[Γ(X, U)⁄R]`, and first Fitting ideals
commute with base change.

Open immersions are étale, so this includes the restriction of the singular locus to open
subschemes. Étale neighbourhoods are the charts in which the local normal form of a node is
stated.

## Main results

* `AlgebraicGeometry.Scheme.singularLocus_ideal_eq_map_of_etale`: on affine charts
  `V ⊆ g⁻¹ U`, the singular ideal of `X'` is the extension of that of `X`.
* `AlgebraicGeometry.Scheme.singularLocus_eq_comap_of_etale`: `Sing(X'/R) = g⁻¹ Sing(X/R)`.
* `AlgebraicGeometry.Scheme.isPullback_singularLocus_subschemeι_of_etale`: the singular subscheme
  of `X'` is the base change `Sing(X/R) ×_X X'`.

## References

* [Stacks Project, Tag 0C3C](https://stacks.math.columbia.edu/tag/0C3C): Fitting ideals of
  quasi-coherent modules and their pullback.
* [Stacks Project, Tag 0C58](https://stacks.math.columbia.edu/tag/0C58): families of nodal
  curves.
-/

public section

open CategoryTheory AlgebraicGeometry Opposite TauCeti.AlgebraicGeometry

namespace TauCeti

universe u

noncomputable section

variable {R : Type u} [CommRing R] {X X' : Scheme.{u}}
  [X.Over (Spec (.of R))] [X'.Over (Spec (.of R))]
  (g : X' ⟶ X) [Etale g] [g.IsOver (Spec (.of R))]
  [Flat (X ↘ Spec (.of R))] [LocallyOfFinitePresentation (X ↘ Spec (.of R))]
  [PureRelativeDimension 1 (X ↘ Spec (.of R))]
  [Flat (X' ↘ Spec (.of R))] [LocallyOfFinitePresentation (X' ↘ Spec (.of R))]
  [PureRelativeDimension 1 (X' ↘ Spec (.of R))]

/-- For an étale morphism `g : X' ⟶ X` of relative curves over `Spec R` and affine opens
`V ⊆ g⁻¹ U`, the singular ideal of `X'` on `V` is generated by the image of the singular ideal of
`X` on `U`. -/
theorem _root_.AlgebraicGeometry.Scheme.singularLocus_ideal_eq_map_of_etale
    (U : X.affineOpens) (V : X'.affineOpens) (e : V.1 ≤ g ⁻¹ᵁ U.1) :
    (X'.singularLocus R).ideal V = ((X.singularLocus R).ideal U).map (g.appLE U V e).hom := by
  let : Algebra R Γ(X, U) := ((X.baseRingToStructurePresheaf R).app (op U.1)).hom.toAlgebra
  let : Algebra R Γ(X', V) := ((X'.baseRingToStructurePresheaf R).app (op V.1)).hom.toAlgebra
  let : Algebra Γ(X, U) Γ(X', V) := (g.appLE U V e).hom.toAlgebra
  -- The base ring maps to `Γ(X', V)` through `Γ(X, U)`, since `g` lies over `Spec R`.
  have : IsScalarTower R Γ(X, U) Γ(X', V) := .of_algebraMap_eq fun r ↦ by
    rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra,
      Scheme.Hom.appLE, CommRingCat.comp_apply,
      Scheme.Modules.app_baseRingToStructurePresheaf, ← CommRingCat.comp_apply,
      ← (X'.baseRingToStructurePresheaf R).naturality (homOfLE e).op, Functor.const_obj_map]
    simp
  have : Algebra.Etale Γ(X, U) Γ(X', V) := g.etale_appLE U.2 V.2 e
  have := finiteType_sections_of_locallyOfFiniteType R X U
  have := finiteType_sections_of_locallyOfFiniteType R X' V
  rw [Scheme.singularLocus_ideal, Scheme.singularLocus_ideal]
  exact (KaehlerDifferential.isBaseChange_of_formallyEtale R Γ(X, U) Γ(X', V)).fittingIdeal_eq_map 1

/-- **The singular locus commutes with étale morphisms.** If `g : X' ⟶ X` is an étale morphism of
relative curves over `Spec R`, then the singular locus of `X'` is the inverse image under `g` of
the singular locus of `X`. For the closed subschemes, see
`AlgebraicGeometry.Scheme.isPullback_singularLocus_subschemeι_of_etale`. -/
theorem _root_.AlgebraicGeometry.Scheme.singularLocus_eq_comap_of_etale :
    X'.singularLocus R = (X.singularLocus R).comap g := by
  -- Compare both ideal sheaves on a cover of `X'` by affine opens mapping into affine opens.
  have charts (x : X') : ∃ (U : X.Opens) (V : X'.Opens),
      IsAffineOpen U ∧ IsAffineOpen V ∧ x ∈ V ∧ V ≤ g ⁻¹ᵁ U := by
    obtain ⟨U, hU, hxU, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
      (U := ⊤) (x := g x) (by simp)
    obtain ⟨V, hV, hxV, hVU⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      X'.isBasis_affineOpens (U := g ⁻¹ᵁ U) (x := x) hxU
    exact ⟨U, V, hU, hV, hxV, hVU⟩
  choose U V hU hV hx e using charts
  let 𝒰 : X'.OpenCover := Scheme.Cover.mkOfCovers X' (fun x ↦ Spec Γ(X', V x))
    (fun x ↦ (hV x).fromSpec) (fun x ↦ ⟨x, by
      have hmem : x ∈ Set.range (hV x).fromSpec := (hV x).range_fromSpec.symm ▸ hx x
      simpa only [Set.mem_range] using hmem⟩)
  refine Scheme.IdealSheafData.ext_of_comap_openCover 𝒰 fun x ↦ ?_
  -- `rw` cannot reduce the cover's dependent index and object projections together, so restate
  -- the goal using the chosen chart maps.
  change (X'.singularLocus R).comap (hV x).fromSpec =
    ((X.singularLocus R).comap g).comap (hV x).fromSpec
  rw [Scheme.IdealSheafData.comap_fromSpec_eq_ofIdealTop,
    Scheme.IdealSheafData.comap_comap_fromSpec_eq_ofIdealTop _ g (hU x) (hV x) (e x),
    Scheme.singularLocus_ideal_eq_map_of_etale g ⟨U x, hU x⟩ ⟨V x, hV x⟩ (e x)]

/-- **The singular subscheme commutes with étale morphisms.** If `g : X' ⟶ X` is an étale
morphism of relative curves over `Spec R`, then `Sing(X'/R)` is the base change
`Sing(X/R) ×_X X'` of the closed subscheme `Sing(X/R)`. -/
theorem _root_.AlgebraicGeometry.Scheme.isPullback_singularLocus_subschemeι_of_etale :
    IsPullback (X'.singularLocus R).subschemeι
      ((X'.singularLocus R).subschemeMap (X.singularLocus R) g
        (Scheme.IdealSheafData.le_map_iff_comap_le.mpr
          (Scheme.singularLocus_eq_comap_of_etale g).ge))
      g (X.singularLocus R).subschemeι :=
  isPullback_of_isClosedImmersion _ _ _ _ (by simp) (by
    rw [Scheme.IdealSheafData.ker_subschemeι, Scheme.IdealSheafData.ker_subschemeι,
      Scheme.singularLocus_eq_comap_of_etale g])

end

end TauCeti
