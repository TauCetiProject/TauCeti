/-!
# Smoothing nodes of dual graphs

Smoothing a node of a nodal curve replaces the local equation `xy = 0` by `xy = t` with `t ≠ 0`.
The two branches of the node then become one annulus, so the components carrying them merge into
one component. Smoothing a set `S` of nodes therefore glues together the components joined by the
nodes in `S`; the remaining nodes stay nodes, and the markings stay on the component they lay on.

This file describes the effect on dual graphs. For a finite set `S` of edges of a dual graph `G`:

* `TauCeti.DualGraph.SmoothingRel G S` relates the two endpoints of every edge in `S`, and
  `TauCeti.DualGraph.smoothingVertex G S` sends a vertex of `G` to its class in the quotient by
  the equivalence relation it generates.
* `TauCeti.DualGraph.smoothingComponent G S x` is the part of `G` that is smoothed into the class
  `x`: the vertices in `x`, the edges of `S` joining them and the markings on them. It is
  connected, so it is a dual graph.
* `TauCeti.DualGraph.smoothing G S` is the dual graph of the smoothed curve. Its vertices are the
  classes, its edges are the edges of `G` outside `S`, and the genus of the class `x` is the
  arithmetic genus of `smoothingComponent G S x`: a smoothed component is a smoothing of that
  subcurve, and smoothing preserves arithmetic genus.

## Main results

* `TauCeti.DualGraph.genus_smoothing_add_card`: the genus of a smoothed component is
  `∑ g(v) + #(S-edges in x) + 1 - #(vertices in x)`, summing over the vertices `v` in `x`.
* `TauCeti.DualGraph.arithmeticGenus_smoothing`: smoothing preserves the arithmetic genus
  `∑ g(v) + b₁` of the graph.
* `TauCeti.DualGraph.genus_smoothing_singleton_of_ne` and
  `TauCeti.DualGraph.genus_smoothing_singleton_of_eq`: smoothing one node joining two different
  components gives a component whose genus is the sum of theirs, and smoothing a self-node raises
  the genus of its component by one.
* `TauCeti.DualGraph.genus_smoothing_of_forall_endpoint_ne`: components meeting no node of `S`
  are untouched.
* `TauCeti.DualGraph.genus_smoothing_univ`: smoothing every node gives a smooth curve whose genus
  is the arithmetic genus of `G`.
* `TauCeti.DualGraph.logCanonicalDegree_smoothing`: the log-canonical degree of a smoothed
  component is the sum of the log-canonical degrees of the components it is made of. Hence
  smoothing preserves stability and semistability (`TauCeti.DualGraph.IsStable.smoothing`,
  `TauCeti.DualGraph.IsSemistable.smoothing`).

A different way to remove a node is to cut it open into two markings, which undoes clutching; its
effect on the invariants is computed in `TauCeti.AlgebraicGeometry.Curves.DualGraph.Clutching`.

## Implementation notes

The quotient is `Quot (SmoothingRel G S)`. It is finite because `G.Vertex` is, and it is given the
classical decidable equality. The edges of the smoothing are the subtype `{e // e ∉ S}`.

## References

* E. Arbarello, M. Cornalba and P. A. Griffiths, *Geometry of Algebraic Curves, Volume II*,
  Chapter X, for nodal curves and their dual graphs.
* J. W. Robbin and D. A. Salamon, *A construction of the Deligne–Mumford orbifold*, J. Eur.
  Math. Soc. 8 (2006), 611–699, for nodal Riemann surfaces and the smoothing `xy = t` of their
  nodes.
-/

public section

namespace TauCeti

namespace DualGraph

open Finset

universe u v

variable {ι : Type v} (G : DualGraph.{u} ι) (S : Finset G.Edge)

/-! ### The components of a smoothing -/

/-- The relation joining the two endpoints of each edge in `S`. When the nodes in `S` are
smoothed, the components related by its equivalence closure merge into one component. -/
def SmoothingRel (v w : G.Vertex) : Prop :=
  ∃ e ∈ S, G.endpoint e 0 = v ∧ G.endpoint e 1 = w

/-- The component of the curve smoothed along `S` that contains the component `v` of `G`: the
class of `v` for the equivalence relation generated by `SmoothingRel G S`. -/
def smoothingVertex (v : G.Vertex) : Quot (G.SmoothingRel S) :=
  Quot.mk _ v

noncomputable instance : Fintype (Quot (G.SmoothingRel S)) :=
  Fintype.ofFinite _

noncomputable instance : DecidableEq (Quot (G.SmoothingRel S)) :=
  Classical.decEq _

lemma smoothingRel_iff {v w : G.Vertex} :
    G.SmoothingRel S v w ↔ ∃ e ∈ S, G.endpoint e 0 = v ∧ G.endpoint e 1 = w :=
  Iff.rfl

lemma smoothingVertex_surjective : Function.Surjective (G.smoothingVertex S) :=
  Quot.mk_surjective

/-- Two components of `G` end up on the same component of the smoothing exactly when they are
related by the equivalence relation generated by the nodes in `S`. -/
theorem smoothingVertex_eq_smoothingVertex_iff {v w : G.Vertex} :
    G.smoothingVertex S v = G.smoothingVertex S w ↔ Relation.EqvGen (G.SmoothingRel S) v w :=
  ⟨Quot.eqvGen_exact, Quot.eqvGen_sound⟩

/-- The two branches of a smoothed node lie on the same component of the smoothing. -/
theorem smoothingVertex_endpoint {e : G.Edge} (he : e ∈ S) (i j : Fin 2) :
    G.smoothingVertex S (G.endpoint e i) = G.smoothingVertex S (G.endpoint e j) := by
  have h : G.smoothingVertex S (G.endpoint e 0) = G.smoothingVertex S (G.endpoint e 1) :=
    Quot.sound ⟨e, he, rfl, rfl⟩
  fin_cases i <;> fin_cases j <;> simp [h]

variable {G S} in
/-- A function on the components of `G` that agrees on the two branches of every node in `S`
descends to the components of the curve smoothed along `S`. -/
def smoothingVertexLift {α : Sort*} (f : G.Vertex → α)
    (hf : ∀ e ∈ S, f (G.endpoint e 0) = f (G.endpoint e 1)) : Quot (G.SmoothingRel S) → α :=
  Quot.lift f fun _ _ ⟨e, he, h₀, h₁⟩ ↦ h₀ ▸ h₁ ▸ hf e he

variable {G S} in
@[simp]
lemma smoothingVertexLift_smoothingVertex {α : Sort*} (f : G.Vertex → α)
    (hf : ∀ e ∈ S, f (G.endpoint e 0) = f (G.endpoint e 1)) (v : G.Vertex) :
    smoothingVertexLift f hf (G.smoothingVertex S v) = f v := by
  simp [smoothingVertexLift, smoothingVertex]

variable {G S} in
/-- A function on the components of `G` that agrees on the two branches of every node in `S`
takes the same value on components of `G` lying on the same component of the smoothing. -/
lemma apply_eq_apply_of_smoothingVertex_eq {α : Sort*} (f : G.Vertex → α)
    (hf : ∀ e ∈ S, f (G.endpoint e 0) = f (G.endpoint e 1)) {v w : G.Vertex}
    (h : G.smoothingVertex S v = G.smoothingVertex S w) : f v = f w := by
  simpa using congrArg (smoothingVertexLift f hf) h

/-- To prove a property of every component of the smoothing, it suffices to prove it for the
component containing each component of `G`. -/
@[elab_as_elim]
theorem smoothingVertex_induction_on {p : Quot (G.SmoothingRel S) → Prop}
    (x : Quot (G.SmoothingRel S)) (h : ∀ v, p (G.smoothingVertex S v)) : p x :=
  Quot.ind h x

/-- The part of `G` that is smoothed into the component `x`: the components of `G` in the class
`x`, the nodes of `S` joining them and the markings on them. It is connected, since `x` is a
class of the equivalence relation generated by these nodes. -/
noncomputable abbrev smoothingComponent (x : Quot (G.SmoothingRel S)) :
    DualGraph.{u} {i : ι // G.smoothingVertex S (G.marking i) = x} where
  Vertex := {v // G.smoothingVertex S v = x}
  vertexNonempty := by
    obtain ⟨v, hv⟩ := G.smoothingVertex_surjective S x
    exact ⟨⟨v, hv⟩⟩
  Edge := {e // e ∈ S ∧ G.smoothingVertex S (G.endpoint e 0) = x}
  endpoint e i := ⟨G.endpoint e.1 i, (G.smoothingVertex_endpoint S e.2.1 i 0).trans e.2.2⟩
  genus v := G.genus v
  marking i := ⟨G.marking i, i.2⟩
  connected := by
    rintro ⟨v, hv⟩ ⟨w, hw⟩
    have h := (G.smoothingVertex_eq_smoothingVertex_iff S).mp (hv.trans hw.symm)
    induction h with
    | rel a b hab =>
      obtain ⟨e, he, rfl, rfl⟩ := hab
      exact .single ⟨⟨e, he, hv⟩, .inl ⟨rfl, rfl⟩⟩
    | refl => exact .refl
    | symm a b _ ih =>
      exact Relation.ReflTransGen.mono (fun _ _ h ↦ h.imp fun _ h ↦ h.symm) _ _ (ih hw hv).swap
    | trans a b c hab _ ih₁ ih₂ =>
      have hb := ((G.smoothingVertex_eq_smoothingVertex_iff S).mpr hab).symm.trans hv
      exact (ih₁ hv hb).trans (ih₂ hb hw)

@[simp]
lemma endpoint_smoothingComponent (x : Quot (G.SmoothingRel S))
    (e : (G.smoothingComponent S x).Edge) (i : Fin 2) :
    (G.smoothingComponent S x).endpoint e i =
      ⟨G.endpoint e.1 i, (G.smoothingVertex_endpoint S e.2.1 i 0).trans e.2.2⟩ :=
  rfl

@[simp]
lemma genus_smoothingComponent (x : Quot (G.SmoothingRel S))
    (v : (G.smoothingComponent S x).Vertex) :
    (G.smoothingComponent S x).genus v = G.genus v.1 :=
  rfl

@[simp]
lemma marking_smoothingComponent (x : Quot (G.SmoothingRel S))
    (i : {i : ι // G.smoothingVertex S (G.marking i) = x}) :
    (G.smoothingComponent S x).marking i = ⟨G.marking i, i.2⟩ :=
  rfl

/-! ### The smoothed graph -/

/-- The dual graph of the curve obtained from a curve with dual graph `G` by smoothing the nodes
in `S`. Its vertices are the classes of the vertices of `G` under the equivalence relation
generated by the edges in `S`, its edges are the edges of `G` outside `S`, and the genus of a
class `x` is the arithmetic genus of the part `smoothingComponent G S x` smoothed into it. -/
noncomputable abbrev smoothing : DualGraph.{u} ι where
  Vertex := Quot (G.SmoothingRel S)
  vertexNonempty := by
    obtain ⟨v⟩ := G.vertexNonempty
    exact ⟨G.smoothingVertex S v⟩
  Edge := {e // e ∉ S}
  endpoint e i := G.smoothingVertex S (G.endpoint e.1 i)
  genus x := (G.smoothingComponent S x).arithmeticGenus
  marking i := G.smoothingVertex S (G.marking i)
  connected := by
    refine G.connected_of_surjective
      (f := fun (e : {e // e ∉ S}) i ↦ G.smoothingVertex S (G.endpoint e.1 i))
      (G.smoothingVertex S) (G.smoothingVertex_surjective S) fun e ↦ ?_
    by_cases he : e ∈ S
    · exact .inl (G.smoothingVertex_endpoint S he 0 1)
    · exact .inr ⟨⟨e, he⟩, .inl ⟨rfl, rfl⟩⟩

@[simp]
lemma endpoint_smoothing (e : (G.smoothing S).Edge) (i : Fin 2) :
    (G.smoothing S).endpoint e i = G.smoothingVertex S (G.endpoint e.1 i) :=
  rfl

lemma genus_smoothing (x : (G.smoothing S).Vertex) :
    (G.smoothing S).genus x = (G.smoothingComponent S x).arithmeticGenus :=
  rfl

@[simp]
lemma marking_smoothing (i : ι) :
    (G.smoothing S).marking i = G.smoothingVertex S (G.marking i) :=
  rfl

/-- Smoothing removes exactly the smoothed nodes. -/
lemma card_edge_smoothing : Fintype.card (G.smoothing S).Edge + #S = Fintype.card G.Edge := by
  rw [Fintype.card_subtype_compl, Fintype.card_coe]
  have := S.card_le_univ
  omega

/-- The number of smoothed components is at most one more than the number of remaining nodes. -/
theorem card_vertex_smoothing_add_card_le :
    Fintype.card (G.smoothing S).Vertex + #S ≤ Fintype.card G.Edge + 1 := by
  have := (G.smoothing S).card_vertex_le_card_edge_add_one
  have := G.card_edge_smoothing S
  omega

/-- **Genus of a smoothed component.** The genus of the component `x` of the smoothing, plus the
number of components of `G` in `x`, is the sum of their genera plus the number of nodes of `S`
in `x` plus one. That is, it is `∑ g(v) + b₁` of the part of `G` smoothed into `x`. -/
theorem genus_smoothing_add_card (x : (G.smoothing S).Vertex) :
    (G.smoothing S).genus x + #{v | G.smoothingVertex S v = x} =
      ∑ v with G.smoothingVertex S v = x, G.genus v +
        #{e ∈ S | G.smoothingVertex S (G.endpoint e 0) = x} + 1 := by
  have h := (G.smoothingComponent S x).arithmeticGenus_add_card_vertex
  have hsum : ∑ v, (G.smoothingComponent S x).genus v =
      ∑ v with G.smoothingVertex S v = x, G.genus v :=
    (sum_subtype _ (by simp) _).symm
  have hedge : Fintype.card (G.smoothingComponent S x).Edge =
      #{e ∈ S | G.smoothingVertex S (G.endpoint e 0) = x} := by
    rw [Fintype.card_subtype]
    congr 1
    ext e
    simp
  rw [Fintype.card_subtype, hsum, hedge] at h
  rwa [genus_smoothing]

/-- **Smoothing preserves the arithmetic genus.** The first Betti number lost by smoothing the
nodes in `S` reappears in the genera of the smoothed components. -/
@[simp]
theorem arithmeticGenus_smoothing : (G.smoothing S).arithmeticGenus = G.arithmeticGenus := by
  have hX := (G.smoothing S).arithmeticGenus_add_card_vertex
  have hG := G.arithmeticGenus_add_card_vertex
  have hE := G.card_edge_smoothing S
  have hV : ∑ x : (G.smoothing S).Vertex, #{v | G.smoothingVertex S v = x} =
      Fintype.card G.Vertex :=
    (card_eq_sum_card_fiberwise (s := univ) (t := univ) (f := G.smoothingVertex S)
      (by simp)).symm.trans card_univ
  have hS : ∑ x : (G.smoothing S).Vertex, #{e ∈ S | G.smoothingVertex S (G.endpoint e 0) = x} =
      #S :=
    (card_eq_sum_card_fiberwise (s := S) (t := univ)
      (f := fun e ↦ G.smoothingVertex S (G.endpoint e 0)) (by simp)).symm
  -- Sum the genus formula over all components of the smoothing.
  have h : ∑ x, (G.smoothing S).genus x + Fintype.card G.Vertex =
      ∑ v, G.genus v + #S + Fintype.card (G.smoothing S).Vertex := by
    simpa [sum_add_distrib, hV, hS, sum_fiberwise] using
      sum_congr rfl fun x (_ : x ∈ univ) ↦ G.genus_smoothing_add_card S x
  omega

/-- A count of objects lying over components in the class `x`, split over those components. -/
private lemma card_filter_smoothingVertex_eq_sum {α : Type*} [Fintype α] (f : α → G.Vertex)
    (x : Quot (G.SmoothingRel S)) :
    #{a | G.smoothingVertex S (f a) = x} = ∑ v with G.smoothingVertex S v = x, #{a | f a = v} := by
  simpa using (sum_card_fiberwise_eq_card_filter univ {v | G.smoothingVertex S v = x} f).symm

/-- The valence of a smoothed component is the total valence of the components of `G` in it,
minus the two branches of each smoothed node joining them. -/
theorem valence_smoothing_add (x : (G.smoothing S).Vertex) :
    (G.smoothing S).valence x + 2 * #{e ∈ S | G.smoothingVertex S (G.endpoint e 0) = x} =
      ∑ v with G.smoothingVertex S v = x, G.valence v := by
  have hG : ∑ v with G.smoothingVertex S v = x, G.valence v =
      ∑ e, #{i | G.smoothingVertex S (G.endpoint e i) = x} := by
    simp_rw [valence_eq_sum]
    rw [sum_comm]
    exact sum_congr rfl fun e _ ↦ (G.card_filter_smoothingVertex_eq_sum S (G.endpoint e) x).symm
  -- Both branches of a smoothed node lie on the same smoothed component.
  have hS : ∑ e ∈ S, #{i | G.smoothingVertex S (G.endpoint e i) = x} =
      2 * #{e ∈ S | G.smoothingVertex S (G.endpoint e 0) = x} := by
    rw [card_filter, mul_sum]
    refine sum_congr rfl fun e he ↦ ?_
    simp_rw [G.smoothingVertex_endpoint S he _ 0]
    split_ifs <;> simp [*]
  -- The nodes outside `S` are the edges of the smoothing, and contribute its valence at `x`.
  have hX : ∑ e ∈ Sᶜ, #{i | G.smoothingVertex S (G.endpoint e i) = x} =
      (G.smoothing S).valence x :=
    (sum_subtype Sᶜ (fun _ ↦ mem_compl) _).trans (valence_eq_sum _ x).symm
  have h := sum_add_sum_compl S fun e ↦ #{i | G.smoothingVertex S (G.endpoint e i) = x}
  omega

/-- The markings on a smoothed component are those on the components of `G` in it. -/
theorem numMarkings_smoothing [Fintype ι] (x : (G.smoothing S).Vertex) :
    (G.smoothing S).numMarkings x = ∑ v with G.smoothingVertex S v = x, G.numMarkings v := by
  simp only [numMarkings_def]
  exact G.card_filter_smoothingVertex_eq_sum S G.marking x

/-- The log-canonical degree of a smoothed component is the sum of the log-canonical degrees of
the components of `G` in it. -/
theorem logCanonicalDegree_smoothing [Fintype ι] (x : (G.smoothing S).Vertex) :
    (G.smoothing S).logCanonicalDegree x =
      ∑ v with G.smoothingVertex S v = x, G.logCanonicalDegree v := by
  have h₁ := G.genus_smoothing_add_card S x
  have h₂ := G.valence_smoothing_add S x
  have h₃ := G.numMarkings_smoothing S x
  simp only [logCanonicalDegree_def, sum_add_distrib, sum_sub_distrib, ← mul_sum, sum_const,
    nsmul_eq_mul]
  zify at h₁ h₂ h₃
  linarith

variable {G} in
/-- Smoothing nodes of a stable graph gives a stable graph. -/
theorem IsStable.smoothing [Fintype ι] (hG : G.IsStable) : (G.smoothing S).IsStable := by
  rw [isStable_iff] at hG ⊢
  intro x
  obtain ⟨v, rfl⟩ := G.smoothingVertex_surjective S x
  rw [logCanonicalDegree_smoothing]
  exact sum_pos (fun w _ ↦ hG w) ⟨v, by simp⟩

variable {G} in
/-- Smoothing nodes of a semistable graph gives a semistable graph. -/
theorem IsSemistable.smoothing [Fintype ι] (hG : G.IsSemistable) :
    (G.smoothing S).IsSemistable := by
  rw [isSemistable_iff] at hG ⊢
  intro x
  rw [logCanonicalDegree_smoothing]
  exact sum_nonneg fun w _ ↦ hG w

/-! ### Components away from the smoothed nodes -/

/-- A component of `G` carrying no branch of a node of `S` is alone in its class. -/
theorem smoothingVertex_eq_iff_of_forall_endpoint_ne {v w : G.Vertex}
    (hv : ∀ e ∈ S, ∀ i, G.endpoint e i ≠ v) :
    G.smoothingVertex S w = G.smoothingVertex S v ↔ w = v := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ rfl⟩
  simpa using apply_eq_apply_of_smoothingVertex_eq (· = v)
    (fun e he ↦ propext (iff_of_false (hv e he 0) (hv e he 1))) h

/-- Smoothing does not change the genus of a component carrying no branch of a smoothed node. -/
theorem genus_smoothing_of_forall_endpoint_ne {v : G.Vertex}
    (hv : ∀ e ∈ S, ∀ i, G.endpoint e i ≠ v) :
    (G.smoothing S).genus (G.smoothingVertex S v) = G.genus v := by
  have h := G.genus_smoothing_add_card S (G.smoothingVertex S v)
  have hfib : ({w | G.smoothingVertex S w = G.smoothingVertex S v} : Finset G.Vertex) = {v} := by
    ext w
    simp [G.smoothingVertex_eq_iff_of_forall_endpoint_ne S hv]
  have hedge : ({e ∈ S | G.smoothingVertex S (G.endpoint e 0) = G.smoothingVertex S v} :
      Finset G.Edge) = ∅ := by
    ext e
    simp only [G.smoothingVertex_eq_iff_of_forall_endpoint_ne S hv, mem_filter,
      Finset.notMem_empty, iff_false, not_and]
    exact fun he ↦ hv e he 0
  rw [hfib, hedge, sum_singleton, card_singleton, card_empty] at h
  omega

/-! ### Smoothing one node -/

section Singleton

variable {G} {e : G.Edge}

/-- Smoothing the single node `e` merges exactly the components carrying its two branches. -/
theorem smoothingVertex_singleton_eq_iff {w : G.Vertex} :
    G.smoothingVertex {e} w = G.smoothingVertex {e} (G.endpoint e 0) ↔
      w = G.endpoint e 0 ∨ w = G.endpoint e 1 := by
  constructor
  · intro h
    simpa using apply_eq_apply_of_smoothingVertex_eq
      (fun w ↦ w = G.endpoint e 0 ∨ w = G.endpoint e 1)
      (fun e' he' ↦ by rw [mem_singleton.mp he']; simp) h
  · rintro (rfl | rfl)
    · rfl
    · exact G.smoothingVertex_endpoint {e} (mem_singleton_self e) 1 0

private lemma genus_smoothing_singleton_add_card :
    (G.smoothing {e}).genus (G.smoothingVertex {e} (G.endpoint e 0)) +
        #{G.endpoint e 0, G.endpoint e 1} =
      ∑ v ∈ {G.endpoint e 0, G.endpoint e 1}, G.genus v + 2 := by
  have h := G.genus_smoothing_add_card {e} (G.smoothingVertex {e} (G.endpoint e 0))
  have hfib : ({w | G.smoothingVertex {e} w = G.smoothingVertex {e} (G.endpoint e 0)} :
      Finset G.Vertex) = {G.endpoint e 0, G.endpoint e 1} := by
    ext w
    simp [smoothingVertex_singleton_eq_iff]
  simp only [hfib, filter_singleton, card_singleton, ite_true] at h
  omega

/-- Smoothing a node joining two different components merges them into one component whose genus
is the sum of their genera. -/
theorem genus_smoothing_singleton_of_ne (he : G.endpoint e 0 ≠ G.endpoint e 1) :
    (G.smoothing {e}).genus (G.smoothingVertex {e} (G.endpoint e 0)) =
      G.genus (G.endpoint e 0) + G.genus (G.endpoint e 1) := by
  have h := G.genus_smoothing_singleton_add_card (e := e)
  rw [card_pair he, sum_pair he] at h
  omega

/-- Smoothing a self-node raises the genus of its component by one. -/
theorem genus_smoothing_singleton_of_eq (he : G.endpoint e 0 = G.endpoint e 1) :
    (G.smoothing {e}).genus (G.smoothingVertex {e} (G.endpoint e 0)) =
      G.genus (G.endpoint e 0) + 1 := by
  have h := G.genus_smoothing_singleton_add_card (e := e)
  rw [← he, pair_eq_singleton, card_singleton, sum_singleton] at h
  omega

end Singleton

/-! ### Smoothing every node -/

/-- Smoothing every node leaves a single component, since the graph is connected. -/
theorem smoothingVertex_univ_eq (v w : G.Vertex) :
    G.smoothingVertex univ v = G.smoothingVertex univ w := by
  rw [smoothingVertex_eq_smoothingVertex_iff, ← Relation.EqvGen.reflTransGen_symmGen]
  refine .mono (fun _ _ ⟨e, h⟩ ↦ ?_) _ _ (G.connected v w)
  obtain ⟨h₀, h₁⟩ | ⟨h₀, h₁⟩ := h
  exacts [.inl ⟨e, mem_univ e, h₀, h₁⟩, .inr ⟨e, mem_univ e, h₀, h₁⟩]

/-- Smoothing every node gives a graph with a single vertex. -/
theorem card_vertex_smoothing_univ : Fintype.card (G.smoothing univ).Vertex = 1 := by
  obtain ⟨v⟩ := G.vertexNonempty
  refine Fintype.card_eq_one_iff.mpr ⟨G.smoothingVertex univ v, fun x ↦ ?_⟩
  obtain ⟨w, rfl⟩ := G.smoothingVertex_surjective univ x
  exact G.smoothingVertex_univ_eq w v

/-- Smoothing every node gives a smooth curve whose genus is the arithmetic genus of `G`. -/
theorem genus_smoothing_univ (x : (G.smoothing univ).Vertex) :
    (G.smoothing univ).genus x = G.arithmeticGenus := by
  have h := G.arithmeticGenus_smoothing univ
  have hE := G.card_edge_smoothing univ
  have hV := G.card_vertex_smoothing_univ
  have hX := (G.smoothing univ).arithmeticGenus_add_card_vertex
  have : Subsingleton (G.smoothing univ).Vertex := Fintype.card_le_one_iff_subsingleton.mp hV.le
  rw [Fintype.sum_subsingleton _ x] at hX
  rw [card_univ] at hE
  omega

end DualGraph

end TauCeti
