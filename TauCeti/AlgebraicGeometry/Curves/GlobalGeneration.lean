module

public import Mathlib.AlgebraicGeometry.AlgClosed.Basic
public import TauCeti.AlgebraicGeometry.Curves.Basic
public import TauCeti.AlgebraicGeometry.Curves.HighDegree
public import TauCeti.AlgebraicGeometry.RationalPoint.Basic
public import TauCeti.AlgebraicGeometry.WeilDivisor.Scheme.GlobalGeneration

/-!
# Global generation in high degree on smooth proper curves

Over an algebraically closed field, a line bundle of degree at least `2g` on a smooth proper
geometrically connected curve is generated by global sections. At a closed point, subtracting
that point leaves a line bundle of degree greater than `2g - 2`, whose first cohomology
vanishes. Restriction to the residue field is therefore surjective. The resulting nonvanishing
loci cover all closed points and hence the entire Jacobson scheme.

This is the generation input for morphisms defined by complete linear systems and for divisor
charts of Picard functors. The statement uses the Euler-characteristic degree and the genus
`dim H¹(X, 𝒪_X)`. No chosen rational point is needed. Descent of global generation to arbitrary
ground fields is not treated here.

## References

* R. Hartshorne, *Algebraic Geometry*, Chapter IV, Corollary 3.2(a).
-/

public section

open CategoryTheory AlgebraicGeometry Order
open Module (finrank)

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

universe u

variable {k : Type u} [Field k] [IsAlgClosed k] {X : Scheme.{u}}
  [X.Over (Spec (.of k))] [IsProper (X ↘ Spec (.of k))]
  [SmoothOfRelativeDimension 1 (X ↘ Spec (.of k))]
  [GeometricallyConnected (X ↘ Spec (.of k))]

/-- A line bundle of degree at least twice the genus on a smooth proper geometrically connected
curve over an algebraically closed field is generated by global sections. -/
theorem isGloballyGenerated_of_smooth_of_two_mul_genus_le_eulerDegree (L : InvertibleSheaf X)
    (hL : 2 * (finrank k (Scheme.Modules.Cohomology (trivial X).obj 1) : ℤ) ≤ L.eulerDegree k) :
    L.IsGloballyGenerated := by
  have := SmoothOfRelativeDimension.smooth 1 (X ↘ Spec (.of k))
  obtain ⟨hI, h⟩ := high_degree_hypotheses_of_smooth (k := k) (X := X)
  have := hI
  obtain ⟨hDVR, hcoheight, hF, hk⟩ := h
  have := hDVR
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian (X ↘ Spec (.of k))
  have : CompactSpace X := compactSpace_of_universallyClosed (X ↘ Spec (.of k))
  have : IsNoetherian X := {}
  have hdim : topologicalKrullDim X = 1 :=
    topologicalKrullDim_eq_of_smoothOfRelativeDimension (X ↘ Spec (.of k))
  have : X.IsCurveOver k := { topologicalKrullDim_eq_one := hdim }
  have := finiteDimensional_cohomology_one_trivial_of_isProper k hdim
  have : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace (X ↘ Spec (.of k))
  obtain ⟨D, ⟨e⟩⟩ := SchemeWeilDivisor.exists_nonempty_iso_sheaf hcoheight L
  let N := SchemeWeilDivisor.toInvertibleSheaf hcoheight D
  have e' : L.obj ≅ N.obj :=
    e ≪≫ (eqToIso (SchemeWeilDivisor.toInvertibleSheaf_obj hcoheight D)).symm
  apply (isGloballyGenerated_iff_of_iso e').mpr
  apply (isGloballyGenerated_iff_forall_isClosed (L := N)).mpr
  intro x hx
  have hs := pointOfClosedPoint_comp (X ↘ Spec (.of k)) x hx
  have happ := pointOfClosedPoint_apply (X ↘ Spec (.of k)) x hx (IsLocalRing.closedPoint k)
  have hcodim := Scheme.IsCurveOver.coheight_section_eq_one k hs
  rw [happ] at hcodim
  let y : CodimensionOnePoint X := ⟨x, hcodim⟩
  have hres := residueDegree_eq_one_of_section hs (IsLocalRing.closedPoint k)
  rw [happ] at hres
  apply SchemeWeilDivisor.exists_section_mem_nonvanishingLocus_of_high_degree k hcoheight hF hk D y
  rw [hres, ← eulerDegree_eq_relativeDegree k hcoheight e]
  omega

end TauCeti.AlgebraicGeometry.InvertibleSheaf
