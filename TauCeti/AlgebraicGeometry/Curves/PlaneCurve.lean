/-!
# Projective plane curves

Let `R` be a commutative ring and `G ∈ R[X₀, X₁, X₂]` a homogeneous polynomial of degree `d`. The
**projective plane curve** `G = 0` is the scheme

`C_G = Proj (R[X₀, X₁, X₂] ⧸ (G))`,

with the grading of the homogeneous coordinate ring by total degree. It is a scheme over `Spec R`
through the degree-zero part of the coordinate ring, which is a quotient of `R`, and it is proper
over `R`.

It is covered by the three standard affine charts `D₊(Xᵢ)`. By
`HomogeneousIdeal.awayEquivDehomogenize`, the functions on `D₊(Xᵢ)` form the affine coordinate ring

`R[Y₀, Y₁] ⧸ (G|_{Xᵢ = 1})`

of the dehomogenized equation, in the remaining coordinates taken in increasing order: for `i = 2`
this is `R[x, y] ⧸ (G(x, y, 1))`. On each chart, the functions pulled back from `Spec R` are the
constants.

Over a field `k`, the curve of an irreducible `G` is an integral scheme, and its function field is,
as a `k`-algebra, the fraction field of the coordinate ring of each chart `D₊(Xᵢ)` with `Xᵢ` not
divisible by `G`. This holds for every chart once `d ≥ 2` (`MvPolynomial.IsHomogeneous.not_dvd_X`).
It identifies the function field of the projective curve with the field of rational functions of
an affine equation `G(x, y, 1) = 0`, the form in which the function-field theory of plane curves
states its results.

## Main definitions

* `TauCeti.AlgebraicGeometry.projectivePlaneCurve.ideal hG`: the homogeneous ideal `(G)`.
* `TauCeti.AlgebraicGeometry.projectivePlaneCurve hG`: the projective plane curve `G = 0`.
* `TauCeti.AlgebraicGeometry.projectivePlaneCurve.chartSectionsEquiv hG i`: the functions on the
  chart `D₊(Xᵢ)` are `R[Y₀, Y₁] ⧸ (G|_{Xᵢ = 1})`.
* `TauCeti.AlgebraicGeometry.projectivePlaneCurve.functionFieldEquiv hG i hi`: over a field `k`,
  for irreducible `G` (supplied as `Fact (Irreducible G)`) and `Xᵢ` not divisible by `G`, the
  function field of the curve is the fraction field of `k[Y₀, Y₁] ⧸ (G|_{Xᵢ = 1})`, as a
  `k`-algebra.

## Main results

* the instance `IsProper (projectivePlaneCurve hG ↘ Spec (.of R))`: plane curves are proper.
* `TauCeti.AlgebraicGeometry.projectivePlaneCurve.iSup_basicOpen_eq_top`: the three standard
  charts cover the curve.
* `TauCeti.AlgebraicGeometry.projectivePlaneCurve.chartSectionsEquiv_appLE`: on a chart, the
  functions pulled back from `Spec R` are the constants.
* the instance `TauCeti.AlgebraicGeometry.projectivePlaneCurve.isIntegral`: over a field, the curve
  of an irreducible `G` is integral.
* `TauCeti.AlgebraicGeometry.projectivePlaneCurve.functionFieldEquiv_germToFunctionField_mk`: the
  identification of function fields sends the rational function `p / Xᵢᵐ` on `D₊(Xᵢ)` to the
  class of `p` with `Xᵢ` set to `1`.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Proposition II.2.5 and
  Exercise I.2.9.
* W. Fulton, *Algebraic Curves*, Chapter 4, Sections 2 and 3, and Chapter 5, Section 1.
-/

public section

open CategoryTheory AlgebraicGeometry MvPolynomial HomogeneousLocalization

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

namespace TauCeti.AlgebraicGeometry

section CommRing

variable {R : Type u} [CommRing R] {G : MvPolynomial (Fin 3) R} {d : ℕ}

/-- The homogeneous ideal `(G)` of `R[X₀, X₁, X₂]` generated by a homogeneous polynomial `G`. -/
noncomputable def projectivePlaneCurve.ideal (hG : G.IsHomogeneous d) :
    HomogeneousIdeal (homogeneousSubmodule (Fin 3) R) where
  toSubmodule := Ideal.span {G}
  is_homogeneous' := Ideal.homogeneous_span _ _ (by rintro _ rfl; exact ⟨d, hG⟩)

@[simp]
theorem projectivePlaneCurve.toIdeal_ideal (hG : G.IsHomogeneous d) :
    (projectivePlaneCurve.ideal hG).toIdeal = Ideal.span {G} :=
  (rfl)

/-- **The projective plane curve** `G = 0` of a homogeneous polynomial `G ∈ R[X₀, X₁, X₂]`: the
`Proj` of the homogeneous coordinate ring `R[X₀, X₁, X₂] ⧸ (G)`, graded by total degree. -/
noncomputable abbrev projectivePlaneCurve (hG : G.IsHomogeneous d) : Scheme.{u} :=
  Proj (projectivePlaneCurve.ideal hG).quotientGrading

namespace projectivePlaneCurve

variable (hG : G.IsHomogeneous d)

/-- The structure morphism of the projective plane curve to `Spec R`: the structure morphism of
`Proj` to the spectrum of the degree-zero part, followed by the inclusion of that spectrum, a
quotient of `R`. -/
noncomputable def over : projectivePlaneCurve hG ⟶ Spec (.of R) :=
  Proj.toSpecZero _ ≫ Spec.map (CommRingCat.ofHom (algebraMap R ((ideal hG).quotientGrading 0)))

/-- The projective plane curve is a scheme over `Spec R`. -/
noncomputable instance : (projectivePlaneCurve hG).Over (Spec (.of R)) where
  hom := over hG

/-- The structure morphism of the projective plane curve as a scheme over `Spec R` is `over`. -/
theorem over_eq : projectivePlaneCurve hG ↘ Spec (.of R) = over hG :=
  (rfl)

/-- **Projective plane curves are proper.** -/
instance : IsProper (projectivePlaneCurve hG ↘ Spec (.of R)) := by
  have := IsClosedImmersion.spec_of_surjective
    (CommRingCat.ofHom (algebraMap R ((ideal hG).quotientGrading 0)))
    (ideal hG).surjective_algebraMap_quotientGrading_zero
  rw [over_eq, over]
  infer_instance

/-- **The three standard charts `D₊(Xᵢ)` cover the projective plane curve.** -/
theorem iSup_basicOpen_eq_top :
    ⨆ i, Proj.basicOpen (ideal hG).quotientGrading (Ideal.Quotient.mk (ideal hG).toIdeal (X i)) =
      ⊤ :=
  Proj.iSup_basicOpen_eq_top _ _ (ideal hG).irrelevant_le_span_range_mk_X

/-- Setting `Xᵢ = 1` in the ideal `(G)` gives the ideal generated by the dehomogenized equation. -/
theorem map_dehomogenize_ideal (i : Fin 3) :
    (ideal hG).toIdeal.map (dehomogenize i) = Ideal.span {dehomogenize i G} := by
  rw [toIdeal_ideal, Ideal.map_span, Set.image_singleton]

/-- **The functions on the chart `D₊(Xᵢ)`** form the coordinate ring `R[Y₀, Y₁] ⧸ (G|_{Xᵢ = 1})` of
the dehomogenized equation, in the remaining coordinates taken in increasing order. -/
noncomputable def chartSectionsEquiv (i : Fin 3) :
    Γ(projectivePlaneCurve hG,
        Proj.basicOpen (ideal hG).quotientGrading (Ideal.Quotient.mk (ideal hG).toIdeal (X i))) ≃+*
      MvPolynomial (Fin 2) R ⧸ Ideal.span {dehomogenize i G} :=
  (Proj.basicOpenIsoAway _ _ ((ideal hG).mk_X_mem_quotientGrading i) one_pos
    ).commRingCatIsoToRingEquiv.symm.trans <|
    (((ideal hG).awayEquivDehomogenize i).trans
      (Ideal.quotientEquivAlgOfEq R (map_dehomogenize_ideal hG i))).toRingEquiv

/-- On the chart `D₊(Xᵢ)`, `chartSectionsEquiv` agrees with the chart isomorphism
`HomogeneousIdeal.awayEquivDehomogenize` on the fractions `Proj.awayToSection a`. -/
theorem chartSectionsEquiv_awayToSection (i : Fin 3)
    (a : Away (ideal hG).quotientGrading (Ideal.Quotient.mk (ideal hG).toIdeal (X i))) :
    chartSectionsEquiv hG i (Proj.awayToSection _ _ a) =
      Ideal.quotientEquivAlgOfEq R (map_dehomogenize_ideal hG i)
        ((ideal hG).awayEquivDehomogenize i a) :=
  -- `Proj.awayToSection` is the forward map of `Proj.basicOpenIsoAway`, whose inverse cancels it
  congrArg (fun a ↦ Ideal.quotientEquivAlgOfEq R (map_dehomogenize_ideal hG i)
    ((ideal hG).awayEquivDehomogenize i a)) ((Proj.basicOpenIsoAway _ _
      ((ideal hG).mk_X_mem_quotientGrading i) one_pos).commRingCatIsoToRingEquiv.symm_apply_apply a)

/-- On the chart `D₊(Xᵢ)`, `chartSectionsEquiv` sends the function `p / Xᵢᵐ` to the class of `p`
with `Xᵢ` set to `1`. -/
theorem chartSectionsEquiv_awayToSection_mk (i : Fin 3) {m : ℕ} {p : MvPolynomial (Fin 3) R}
    (hp : Ideal.Quotient.mk (ideal hG).toIdeal p ∈ (ideal hG).quotientGrading (m • 1)) :
    chartSectionsEquiv hG i (Proj.awayToSection _ _
        (Away.mk _ ((ideal hG).mk_X_mem_quotientGrading i) m _ hp)) =
      Ideal.Quotient.mk _ (dehomogenize i p) := by
  rw [chartSectionsEquiv_awayToSection, HomogeneousIdeal.awayEquivDehomogenize_mk,
    Ideal.quotientEquivAlgOfEq_mk]

/-- On the chart `D₊(Xᵢ)`, the functions pulled back from `Spec R` along the structure morphism are
the constants of `R[Y₀, Y₁] ⧸ (G|_{Xᵢ = 1})`. -/
theorem chartSectionsEquiv_appLE (i : Fin 3) (a : Γ(Spec (.of R), ⊤)) :
    chartSectionsEquiv hG i ((projectivePlaneCurve hG ↘ Spec (.of R)).appLE ⊤ _ le_top a) =
      algebraMap R _ ((Scheme.ΓSpecIso (.of R)).hom a) := by
  have h : (projectivePlaneCurve hG ↘ Spec (.of R)).appLE ⊤
      (Proj.basicOpen _ (Ideal.Quotient.mk (ideal hG).toIdeal (X i))) le_top =
        (Scheme.ΓSpecIso _).hom ≫ CommRingCat.ofHom (algebraMap R (Away _ _)) ≫
          Proj.awayToSection _ _ := by
    refine (Scheme.Hom.appLE_comp_appLE (Proj.toSpecZero _) _ ⊤ ⊤ _ le_top le_top).symm.trans ?_
    -- The `show` reads `appLE ⊤ ⊤` as `appTop` through `appLE_eq_app`, relying on the
    -- definitional equality `f ⁻¹ᵁ ⊤ = ⊤` (`Scheme.Hom.preimage_top`, proved by `rfl`).
    rw [Proj.toSpecZero_appLE_basicOpen _ ((ideal hG).mk_X_mem_quotientGrading i) one_pos,
      show Scheme.Hom.appLE _ ⊤ ⊤ _ = Scheme.Hom.appTop _ from Scheme.Hom.appLE_eq_app _,
      ← Category.assoc, Scheme.ΓSpecIso_naturality, Category.assoc,
      ← Category.assoc (CommRingCat.ofHom _), ← CommRingCat.ofHom_comp,
      ← HomogeneousLocalization.algebraMap_eq_comp]
  rw [h, CommRingCat.comp_apply, CommRingCat.comp_apply, CommRingCat.ofHom_apply,
    chartSectionsEquiv_awayToSection, AlgEquiv.commutes, AlgEquiv.commutes]

/-- The class of `Xᵢ` in the homogeneous coordinate ring is nonzero exactly when `G` does not divide
`Xᵢ`. -/
theorem mk_X_ne_zero_iff {hG : G.IsHomogeneous d} {i : Fin 3} :
    Ideal.Quotient.mk (ideal hG).toIdeal (X i) ≠ 0 ↔ ¬ G ∣ X i := by
  rw [ne_eq, Ideal.Quotient.eq_zero_iff_mem, toIdeal_ideal, Ideal.mem_span_singleton]

end projectivePlaneCurve

end CommRing

/-! ### Integrality -/

namespace projectivePlaneCurve

variable {k : Type u} [Field k] {G : MvPolynomial (Fin 3) k} {d : ℕ} {hG : G.IsHomogeneous d}

/-- The homogeneous coordinate ring of an irreducible `G` is a domain. -/
theorem isDomain_quotient (hirr : Irreducible G) :
    IsDomain (MvPolynomial (Fin 3) k ⧸ (ideal hG).toIdeal) := by
  rw [toIdeal_ideal, Ideal.Quotient.isDomain_iff_prime, Ideal.span_singleton_prime hirr.ne_zero]
  exact hirr.prime

/-- **The projective plane curve of an irreducible polynomial is integral.** -/
instance isIntegral [Fact (Irreducible G)] : IsIntegral (projectivePlaneCurve hG) := by
  have := isDomain_quotient (hG := hG) Fact.out
  -- `G` divides at most one coordinate: otherwise it would be associated to both `X₀` and `X₁`
  obtain ⟨i, hi⟩ : ∃ i : Fin 3, ¬ G ∣ X i := by
    by_contra! h
    have h₀ := (Fact.out : Irreducible G).associated_of_dvd (prime_X (i := 0)).irreducible (h 0)
    have h₁ := (Fact.out : Irreducible G).associated_of_dvd (prime_X (i := 1)).irreducible (h 1)
    exact absurd (X_dvd_X.mp (h₀.symm.trans h₁).dvd) (by decide)
  refine Proj.isIntegral_of_isDomain _ fun h ↦ (mk_X_ne_zero_iff (hG := hG)).mpr hi ?_
  have := HomogeneousIdeal.mem_irrelevant_of_mem _ one_pos ((ideal hG).mk_X_mem_quotientGrading i)
  rwa [h, ← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at this

/-! ### The function field -/

variable [Fact (Irreducible G)] {i : Fin 3}

/-- On a chart `D₊(Xᵢ)` of the curve of an irreducible `G` with `Xᵢ` not divisible by `G`, the
degree-zero part of the localization away from `Xᵢ` is a domain. -/
theorem isDomain_away (hi : ¬ G ∣ X i) :
    IsDomain (Away (ideal hG).quotientGrading (Ideal.Quotient.mk (ideal hG).toIdeal (X i))) := by
  have := isDomain_quotient (hG := hG) Fact.out
  have : IsDomain (Localization.Away (Ideal.Quotient.mk (ideal hG).toIdeal (X i))) :=
    IsLocalization.isDomain_localization
      (powers_le_nonZeroDivisors_of_noZeroDivisors (mk_X_ne_zero_iff.mpr hi))
  exact Function.Injective.isDomain (algebraMap (Away _ _)
    (Localization.Away (Ideal.Quotient.mk (ideal hG).toIdeal (X i)))) (val_injective _)

/-- On the curve of an irreducible `G`, a chart `D₊(Xᵢ)` with `Xᵢ` not divisible by `G` is
nonempty. -/
theorem nonempty_basicOpen (hi : ¬ G ∣ X i) :
    Nonempty (Proj.basicOpen (ideal hG).quotientGrading
      (Ideal.Quotient.mk (ideal hG).toIdeal (X i))) :=
  have := isDomain_away (hG := hG) hi
  -- the chart is the spectrum of `A_(Xᵢ)`, which is a nonzero ring
  .map (Proj.basicOpenIsoSpec _ _ ((ideal hG).mk_X_mem_quotientGrading i) one_pos).inv.base <|
    PrimeSpectrum.nonempty_iff_nontrivial.mpr (inferInstanceAs (Nontrivial (Away _ _)))

/-- The coordinate ring `k[Y₀, Y₁] ⧸ (G|_{Xᵢ = 1})` of a chart `D₊(Xᵢ)` of the curve of an
irreducible homogeneous `G`, with `Xᵢ` not divisible by `G`, is a domain. -/
theorem isDomain_quotient_dehomogenize (hG : G.IsHomogeneous d) (hi : ¬ G ∣ X i) :
    IsDomain (MvPolynomial (Fin 2) k ⧸ Ideal.span {dehomogenize i G}) :=
  have := isDomain_away (hG := hG) hi
  (((ideal hG).awayEquivDehomogenize i).trans
    (Ideal.quotientEquivAlgOfEq k (map_dehomogenize_ideal hG i))).symm.injective.isDomain _

/-- On the curve of an irreducible `G`, the function field is the fraction field of the functions
on a chart `D₊(Xᵢ)` with `Xᵢ` not divisible by `G`. -/
theorem isFractionRing_functionField (hi : ¬ G ∣ X i) :
    haveI := nonempty_basicOpen (hG := hG) hi
    IsFractionRing Γ(projectivePlaneCurve hG,
        Proj.basicOpen (ideal hG).quotientGrading (Ideal.Quotient.mk (ideal hG).toIdeal (X i)))
      (projectivePlaneCurve hG).functionField :=
  have := nonempty_basicOpen (hG := hG) hi
  -- the function field of an integral scheme is the fraction field of the sections over any
  -- nonempty affine open
  functionField_isFractionRing_of_isAffineOpen (projectivePlaneCurve hG) _ <|
    Proj.isAffineOpen_basicOpen _ _ ((ideal hG).mk_X_mem_quotientGrading i) one_pos

variable (hG i) in
/-- **The function field of a projective plane curve.** For an irreducible `G` and a coordinate
`Xᵢ` not divisible by `G`, the function field of the curve `G = 0` is, as a `k`-algebra, the
fraction field of the coordinate ring `k[Y₀, Y₁] ⧸ (G|_{Xᵢ = 1})` of the affine chart `D₊(Xᵢ)`. -/
noncomputable def functionFieldEquiv (hi : ¬ G ∣ X i) :
    (projectivePlaneCurve hG).functionField ≃ₐ[k]
      FractionRing (MvPolynomial (Fin 2) k ⧸ Ideal.span {dehomogenize i G}) :=
  have := nonempty_basicOpen (hG := hG) hi
  have := isDomain_quotient_dehomogenize hG hi
  have := isFractionRing_functionField (hG := hG) hi
  AlgEquiv.ofRingEquiv (f := IsFractionRing.ringEquivOfRingEquiv (chartSectionsEquiv hG i))
    fun c ↦ by
      -- the constants of the function field come from the constants on the chart `D₊(Xᵢ)`
      rw [Scheme.algebraMap_functionField_eq_baseRingToFunctionField,
        Scheme.baseRingToFunctionField_eq_comp_appLE k _
          (Proj.basicOpen _ (Ideal.Quotient.mk (ideal hG).toIdeal (X i))), RingHom.comp_apply]
      refine (IsFractionRing.ringEquivOfRingEquiv_algebraMap _ _).trans ?_
      rw [CommRingCat.hom_comp, RingHom.comp_apply, chartSectionsEquiv_appLE, Iso.inv_hom_id_apply,
        ← IsScalarTower.algebraMap_apply]

/-- On the chart `D₊(Xᵢ)`, `functionFieldEquiv` sends the rational function `p / Xᵢᵐ` to the class
of `p` with `Xᵢ` set to `1`. -/
theorem functionFieldEquiv_germToFunctionField_mk (hi : ¬ G ∣ X i) {m : ℕ}
    {p : MvPolynomial (Fin 3) k}
    (hp : Ideal.Quotient.mk (ideal hG).toIdeal p ∈ (ideal hG).quotientGrading (m • 1)) :
    haveI := nonempty_basicOpen (hG := hG) hi
    functionFieldEquiv hG i hi ((projectivePlaneCurve hG).germToFunctionField _
        (Proj.awayToSection _ _ (Away.mk _ ((ideal hG).mk_X_mem_quotientGrading i) m _ hp))) =
      algebraMap _ _ (Ideal.Quotient.mk (Ideal.span {dehomogenize i G}) (dehomogenize i p)) := by
  have := nonempty_basicOpen (hG := hG) hi
  have := isDomain_quotient_dehomogenize hG hi
  have := isFractionRing_functionField (hG := hG) hi
  -- the germ map is the algebra map of the fraction field structure
  exact (IsFractionRing.ringEquivOfRingEquiv_algebraMap _ _).trans <|
    congrArg _ (chartSectionsEquiv_awayToSection_mk hG i hp)

end projectivePlaneCurve

end TauCeti.AlgebraicGeometry
