module

public import TauCeti.Algebra.Category.ModuleCat.Sheaf.FiniteType
public import TauCeti.AlgebraicGeometry.Modules.FiniteType
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Sections
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Surjective

/-!
# Cone algebras and abelian cones

A *cone* over a scheme `X`, in the sense of Fulton and of Behrend–Fantechi, is the relative
spectrum `C = Spec_X (⨁ₙ Aₙ)` of a graded quasicoherent `𝒪_X`-algebra `A = ⨁ₙ Aₙ` such that

* the unit `𝒪_X ⟶ A₀` is an isomorphism,
* the degree-one component `A₁` is of finite type, and
* `A` is generated by `A₁` as an `𝒪_X`-algebra.

We call such graded algebras *cone algebras* (`GradedQuasicoherentAlgebra.IsConeAlgebra`).
The grading is part of the structure: it gives the cone its vertex `A ⟶ A₀ = 𝒪_X` and its
contraction action of the multiplicative monoid `𝔸¹`. The conditions exclude, for instance,
`𝒪_X × 𝒪_X` placed in degree zero (its unit is not an isomorphism) and the symmetric algebra of an
infinite-rank free sheaf (its degree-one component is not of finite type). Morphisms of cones are
morphisms of graded algebras in the opposite direction, so cone algebras are not given a separate
category here.

The basic example is the *abelian cone* `C(F) = Spec_X (Sym F)` of a quasicoherent sheaf `F`:
its graded symmetric algebra is a cone algebra exactly when `F` is of finite type
(`isConeAlgebra_gradedSymmetricAlgebra_iff`). When `F` is finite locally free, `C(F)` is the
vector bundle whose sheaf of linear functions is `F`.

Every cone sits in an abelian cone, its *abelian hull* `C(A₁)`: the morphism of graded algebras
`Sym A₁ ⟶ A` extending the identity of `A₁` (`gradedSymmetricAlgebraLift (𝟙 A₁)`) is an
isomorphism in degree zero and an epimorphism in every degree
(`IsConeAlgebra.epi_gradedSymmetricAlgebraLift`), so it exhibits `C` as a closed subcone of
`C(A₁)`. Closed subcones of a cone are the graded quotients of its cone algebra that are
isomorphisms in degree zero, and these are again cone algebras (`IsConeAlgebra.of_epi`).
Altogether, cone algebras are exactly the graded quasicoherent algebras with `A₀ = 𝒪_X` and `A₁`
of finite type that are graded quotients of `Sym A₁`
(`isConeAlgebra_iff_epi_gradedSymmetricAlgebraLift`).

Cones and their abelian hulls are the local building blocks of the intrinsic normal cone: the
normal cone `C_X Y` of a closed immersion with ideal sheaf `I`, for `I/I²` of finite type, is a
cone whose abelian hull is the normal sheaf `N_X Y = C(I/I²)`.

## Main declarations

* `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra.IsConeAlgebra`: graded quasicoherent
  algebras with `A₀ = 𝒪_X`, `A₁` of finite type, generated in degree one.
* `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra.IsConeAlgebra.of_epi` and
  `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra.IsConeAlgebra.of_iso`: graded quotients
  that are isomorphisms in degree zero, in particular isomorphic graded algebras, of cone algebras
  are cone algebras.

In the namespace `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra`:

* `isConeAlgebra_gradedSymmetricAlgebra_iff`: the abelian cone `C(F)` of a quasicoherent sheaf
  `F` is a cone exactly when `F` is of finite type.
* `IsConeAlgebra.epi_gradedSymmetricAlgebraLift`: the abelian hull morphism `Sym A₁ ⟶ A` is an
  epimorphism in every degree.
* `isConeAlgebra_iff_epi_gradedSymmetricAlgebraLift`: the characterization of cone algebras as
  graded quotients of `Sym A₁`.

## References

* K. Behrend and B. Fantechi, *The intrinsic normal cone*, Invent. Math. 128 (1997), §1
  (cones and abelian cones).
* W. Fulton, *Intersection Theory*, 2nd ed., Appendix B.5 (cones).
-/

public section

open CategoryTheory

namespace TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra

open _root_.AlgebraicGeometry

universe u

variable {X : Scheme.{u}}

/-- A graded quasicoherent algebra `A = ⨁ₙ Aₙ` on `X` is a *cone algebra* if its unit
`𝒪_X ⟶ A₀` is an isomorphism, its degree-one component `A₁` is of finite type, and it is
generated in degree one. The relative spectrum `Spec_X (⨁ₙ Aₙ)` of a cone algebra is a cone over
`X` in the sense of Fulton and of Behrend–Fantechi. -/
structure IsConeAlgebra (A : GradedQuasicoherentAlgebra X) : Prop where
  /-- The unit `𝒪_X ⟶ A₀` is an isomorphism. -/
  isIso_one : IsIso A.obj.toMon.one
  /-- The degree-one component `A₁` is of finite type. -/
  isFiniteType_one : (A.obj.X 1).IsFiniteType
  /-- `A` is generated by `A₁` over `A₀ = 𝒪_X`. -/
  isGeneratedInDegreeOne : A.obj.IsGeneratedInDegreeOne

variable {A B : GradedQuasicoherentAlgebra X}

namespace IsConeAlgebra

/-- **Closed subcones.** If `A` is a cone algebra and `f : A ⟶ B` is a morphism of graded
quasicoherent algebras which is an isomorphism in degree zero and an epimorphism in every degree,
then `B` is a cone algebra. Geometrically, `Spec_X B` is then a closed subcone of the cone
`Spec_X A`. -/
theorem of_epi (hA : A.IsConeAlgebra) (f : A ⟶ B) [IsIso (f.hom.hom.hom 0)]
    [∀ n, Epi (f.hom.hom.hom n)] : B.IsConeAlgebra where
  isIso_one := by
    have := hA.isIso_one
    rw [← Mon.one_map f.hom.hom]
    infer_instance
  -- The components of `f` are stated through `A.obj.toMon.X`, which typeclass search does not
  -- unfold to `A.obj.X`, so the instances are passed explicitly.
  isFiniteType_one :=
    @Scheme.Modules.isFiniteType_of_epi _ _ _ (f.hom.hom.hom 1) (‹∀ n, Epi (f.hom.hom.hom n)› 1)
      hA.isFiniteType_one
  isGeneratedInDegreeOne := CommMon.IsGeneratedInDegreeOne.of_epi f.hom hA.isGeneratedInDegreeOne

/-- A graded quasicoherent algebra isomorphic to a cone algebra is a cone algebra. -/
theorem of_iso (hA : A.IsConeAlgebra) (e : A ≅ B) : B.IsConeAlgebra :=
  hA.of_epi e.hom

end IsConeAlgebra

/-- Being a cone algebra is invariant under isomorphism of graded quasicoherent algebras. -/
theorem isConeAlgebra_iff_of_iso (e : A ≅ B) : A.IsConeAlgebra ↔ B.IsConeAlgebra :=
  ⟨fun h ↦ h.of_iso e, fun h ↦ h.of_iso e.symm⟩

/-- **Abelian cones.** The graded symmetric algebra `Sym F` of a quasicoherent sheaf `F` is a cone
algebra exactly when `F` is of finite type; its relative spectrum is then the abelian cone
`C(F) = Spec_X (Sym F)`. -/
@[simp]
theorem isConeAlgebra_gradedSymmetricAlgebra_iff (F : QuasicoherentSheaf X) :
    ((gradedSymmetricAlgebra X).obj F).IsConeAlgebra ↔ F.obj.IsFiniteType := by
  -- The degree-one component `Sym¹ F` is identified with `F`, and finite type is transported
  -- along this identification.
  let e : ((gradedSymmetricAlgebra X).obj F).obj.X 1 ≅ F.obj :=
    eqToIso (gradedSymmetricAlgebra_obj_obj_X F 1) ≪≫
      (SheafOfModules.symmetricPowerOneIso X.sheaf).app F.obj
  refine ⟨fun h ↦ ?_, fun h ↦ ⟨inferInstance, ?_, isGeneratedInDegreeOne_gradedSymmetricAlgebra F⟩⟩
  · have := h.isFiniteType_one
    exact SheafOfModules.IsFiniteType.of_iso (R := X.ringCatSheaf) e
  · exact SheafOfModules.IsFiniteType.of_iso (R := X.ringCatSheaf) e.symm

/-- **The abelian hull.** For a cone algebra `A`, the morphism `Sym A₁ ⟶ A` extending the identity
of `A₁` is an epimorphism in every degree. Geometrically, the cone `Spec_X A` is a closed subcone
of its abelian hull, the abelian cone `C(A₁) = Spec_X (Sym A₁)`. -/
theorem IsConeAlgebra.epi_gradedSymmetricAlgebraLift (hA : A.IsConeAlgebra) (n : ℕ) :
    Epi ((gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom.hom.hom n) := by
  rcases n.eq_zero_or_pos with rfl | hn
  · have := hA.isIso_one
    have := isIso_gradedSymmetricAlgebraLift_zero A
    infer_instance
  · exact A.epi_gradedSymmetricAlgebraLift hA.isGeneratedInDegreeOne n hn

/-- **Cone algebras are the graded quotients of abelian cone algebras.** A graded quasicoherent
algebra `A` is a cone algebra if and only if its unit `𝒪_X ⟶ A₀` is an isomorphism, its
degree-one component `A₁` is of finite type, and the morphism `Sym A₁ ⟶ A` extending the identity
of `A₁` is an epimorphism in every degree. -/
theorem isConeAlgebra_iff_epi_gradedSymmetricAlgebraLift :
    A.IsConeAlgebra ↔ IsIso A.obj.toMon.one ∧ (A.obj.X 1).IsFiniteType ∧
      ∀ n, Epi ((gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom.hom.hom n) := by
  refine ⟨fun h ↦ ⟨h.isIso_one, h.isFiniteType_one, h.epi_gradedSymmetricAlgebraLift⟩, ?_⟩
  rintro ⟨h₀, h₁, hepi⟩
  have hA₁ : (degreeOne.obj A).obj.IsFiniteType := by rwa [degree_obj_obj]
  have := isIso_gradedSymmetricAlgebraLift_zero A
  exact ((isConeAlgebra_gradedSymmetricAlgebra_iff _).mpr hA₁).of_epi
    (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A)))

end TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra
