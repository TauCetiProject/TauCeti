module

public import TauCeti.AlgebraicGeometry.Modules.AffineRestriction
public import TauCeti.AlgebraicGeometry.Modules.GradedAlgebra.Sections
public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.RingTheory.RingHom.FiniteType
public import Mathlib.RingTheory.TensorProduct.IsBaseChangePi

/-!
# Graded rings of sections over nested affine opens

Let `A = ⨁ₙ Aₙ` be a graded algebra on a scheme `X` whose homogeneous components are
quasicoherent, and let `V ≤ U` be affine opens of `X`. Restriction of sections exhibits the graded
ring `⨁ n, Γ(Aₙ, V)` as the base change of `⨁ n, Γ(Aₙ, U)` along the restriction of functions
`Γ(X, U) → Γ(X, V)`: the square of commutative rings

```
Γ(X, U) ──→ ⨁ n, Γ(Aₙ, U)
   │               │
   ↓               ↓
Γ(X, V) ──→ ⨁ n, Γ(Aₙ, V)
```

is a pushout. In each degree this is the base change of sections of a quasicoherent module
(`Scheme.Modules.isBaseChange_sectionsRestriction`), and base change commutes with direct sums.

So the affine graded charts of `A` are compatible with restriction to smaller affine opens, not
only to basic opens (`CategoryTheory.CommMon.isBaseChange_restrictGradedSections`). As
consequences, restriction to a smaller affine open preserves finite generation of the graded ring
of sections over the ring of regular functions, and generation in degree one: if
`⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0` and `1`, equivalently by
`Γ(A₁, U)` as an algebra over `Γ(A₀, U)`, then the same holds over `V`. Generation in degree one is
the condition under which the twisting sheaf `𝒪(1)` of the relative `Proj` of `A` is invertible.

## Main statements

* `CategoryTheory.CommMon.isPushout_restrictGradedSections`: for affine opens `V ≤ U`, the square
  above is a pushout of commutative rings.
* `CategoryTheory.CommMon.finiteType_gradedSections_of_le`: finite generation of the graded ring of
  sections over the ring of regular functions passes from `U` to `V`.
* `CategoryTheory.CommMon.adjoin_gradedSectionsGrading_zero_union_one_eq_top_of_le`: generation in
  degree one passes from `U` to `V`.

## References

* [The Stacks Project, Section 27.15, Relative Proj](https://stacks.math.columbia.edu/tag/01NS)
* R. Hartshorne, *Algebraic Geometry*, Proposition II.5.2 and Section II.7.
-/

public section

open CategoryTheory Opposite DirectSum AlgebraicGeometry

namespace TauCeti

universe u

noncomputable section

variable {X : Scheme.{u}} (A : CommMon (GradedObject ℕ X.Modules)) {U V : X.Opens}

/-- **Graded rings of sections over nested affine opens.** For a graded algebra `A` with
quasicoherent homogeneous components and affine opens `V ≤ U`, restriction of sections exhibits
`⨁ n, Γ(Aₙ, V)` as the base change of `⨁ n, Γ(Aₙ, U)` along `Γ(X, U) → Γ(X, V)`. -/
theorem _root_.CategoryTheory.CommMon.isPushout_restrictGradedSections
    [∀ n, (A.X n).IsQuasicoherent] (hU : IsAffineOpen U) (hV : IsAffineOpen V) (hVU : V ≤ U) :
    IsPushout (X.presheaf.map (homOfLE hVU).op)
      (CommRingCat.ofHom (algebraMap Γ(X, U) (⨁ n, Γ(A.X n, U))))
      (CommRingCat.ofHom (algebraMap Γ(X, V) (⨁ n, Γ(A.X n, V))))
      (CommRingCat.ofHom (A.restrictGradedSections (homOfLE hVU))) := by
  let := (X.presheaf.map (homOfLE hVU).op).hom.toAlgebra
  -- Each `Γ(Aₙ, V)` is a `Γ(X, U)`-module by restriction of scalars, and restriction of sections
  -- is a base change in each degree.
  let _ (n : ℕ) : Module Γ(X, U) Γ(A.X n, V) := Module.compHom _ (algebraMap Γ(X, U) Γ(X, V))
  -- By definition of `Module.compHom`, `r` acts through its restriction to `V`.
  have _ (n : ℕ) : IsScalarTower Γ(X, U) Γ(X, V) Γ(A.X n, V) := .of_algebraMap_smul fun _ _ ↦ rfl
  let ρ (n : ℕ) : Γ(A.X n, U) →ₗ[Γ(X, U)] Γ(A.X n, V) :=
    { toFun := (A.X n).presheaf.map (homOfLE hVU).op
      map_add' := map_add _
      map_smul' := fun r x ↦ (A.X n).map_smul _ r x }
  have hρ := IsBaseChange.directSum fun n ↦
    (A.X n).isBaseChange_sectionsRestriction hU hV hVU (fun _ ↦ rfl) (ρ n) fun _ ↦ rfl
  -- The `Γ(X, U)`-algebra structure on `⨁ n, Γ(Aₙ, V)` whose module structure is the direct sum of
  -- the restrictions of scalars.
  let : Algebra Γ(X, U) (⨁ n, Γ(A.X n, V)) := Algebra.ofModule
    (fun r x y ↦ by rw [← algebraMap_smul Γ(X, V) r, ← algebraMap_smul Γ(X, V) r, smul_mul_assoc])
    (fun r x y ↦ by rw [← algebraMap_smul Γ(X, V) r, ← algebraMap_smul Γ(X, V) r, mul_smul_comm])
  let := (A.restrictGradedSections (homOfLE hVU)).toAlgebra
  have : IsScalarTower Γ(X, U) (⨁ n, Γ(A.X n, U)) (⨁ n, Γ(A.X n, V)) :=
    .of_algebraMap_eq fun r ↦ by
      rw [RingHom.algebraMap_toAlgebra, CommMon.restrictGradedSections_algebraMap,
        Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
      exact (algebraMap_smul Γ(X, V) r (1 : ⨁ n, Γ(A.X n, V))).symm
  have : Algebra.IsPushout Γ(X, U) Γ(X, V) (⨁ n, Γ(A.X n, U)) (⨁ n, Γ(A.X n, V)) := by
    refine ⟨?_⟩
    convert hρ using 1
    refine LinearMap.ext fun x ↦ DFinsupp.ext fun n ↦ ?_
    exact A.restrictGradedSections_apply (homOfLE hVU) x n
  exact CommRingCat.isPushout_iff_isPushout.mpr this

/-- Finite generation of a graded ring of sections over the ring of regular functions passes to
smaller affine opens: the graded ring over `V` is the base change of the graded ring over `U`
(`CategoryTheory.CommMon.isPushout_restrictGradedSections`). -/
theorem _root_.CategoryTheory.CommMon.finiteType_gradedSections_of_le
    [∀ n, (A.X n).IsQuasicoherent] (hU : IsAffineOpen U) (hV : IsAffineOpen V) (hVU : V ≤ U)
    [Algebra.FiniteType Γ(X, U) (⨁ n, Γ(A.X n, U))] :
    Algebra.FiniteType Γ(X, V) (⨁ n, Γ(A.X n, V)) := by
  rw [← RingHom.finiteType_algebraMap]
  exact (RingHom.isStableUnderCobaseChange_toMorphismProperty_iff.mpr
    RingHom.finiteType_isStableUnderBaseChange).of_isPushout
      (A.isPushout_restrictGradedSections hU hV hVU)
      (RingHom.finiteType_algebraMap.mpr inferInstance)

/-- **Generation in degree one passes to smaller affine opens.** If the graded ring of sections
`⨁ n, Γ(Aₙ, U)` over an affine open `U` is generated by its homogeneous elements of degrees `0`
and `1`, that is, by `Γ(A₁, U)` as an algebra over `Γ(A₀, U)`, then so is the graded ring of
sections over every affine open `V ≤ U`. -/
theorem _root_.CategoryTheory.CommMon.adjoin_gradedSectionsGrading_zero_union_one_eq_top_of_le
    [∀ n, (A.X n).IsQuasicoherent] (hU : IsAffineOpen U) (hV : IsAffineOpen V) (hVU : V ≤ U)
    (h : Algebra.adjoin Γ(X, U)
      ((A.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.X n, U))) ∪ A.gradedSectionsGrading U 1) = ⊤) :
    Algebra.adjoin Γ(X, V)
      ((A.gradedSectionsGrading V 0 : Set (⨁ n, Γ(A.X n, V))) ∪ A.gradedSectionsGrading V 1) =
      ⊤ := by
  let := (X.presheaf.map (homOfLE hVU).op).hom.toAlgebra
  let := (A.restrictGradedSections (homOfLE hVU)).toAlgebra
  let : Algebra Γ(X, U) (⨁ n, Γ(A.X n, V)) :=
    ((algebraMap Γ(X, V) (⨁ n, Γ(A.X n, V))).comp (algebraMap Γ(X, U) Γ(X, V))).toAlgebra
  have : IsScalarTower Γ(X, U) Γ(X, V) (⨁ n, Γ(A.X n, V)) := .of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower Γ(X, U) (⨁ n, Γ(A.X n, U)) (⨁ n, Γ(A.X n, V)) :=
    .of_algebraMap_eq fun r ↦ (A.restrictGradedSections_algebraMap (homOfLE hVU) r).symm
  have hpo : Algebra.IsPushout Γ(X, U) Γ(X, V) (⨁ n, Γ(A.X n, U)) (⨁ n, Γ(A.X n, V)) :=
    CommRingCat.isPushout_iff_isPushout.mp (A.isPushout_restrictGradedSections hU hV hVU)
  let T := (A.gradedSectionsGrading V 0 : Set (⨁ n, Γ(A.X n, V))) ∪ A.gradedSectionsGrading V 1
  -- Restriction maps the generators of degrees `0` and `1` over `U` into those over `V`, hence the
  -- whole graded ring over `U` into the subalgebra they generate over `V`.
  have hle : Algebra.adjoin Γ(X, U)
      ((A.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.X n, U))) ∪ A.gradedSectionsGrading U 1) ≤
      ((Algebra.adjoin Γ(X, V) T).restrictScalars Γ(X, U)).comap
        (IsScalarTower.toAlgHom Γ(X, U) (⨁ n, Γ(A.X n, U)) (⨁ n, Γ(A.X n, V))) :=
    Algebra.adjoin_le_iff.mpr fun y hy ↦ by
      rw [SetLike.mem_coe, Subalgebra.mem_comap, Subalgebra.mem_restrictScalars,
        IsScalarTower.toAlgHom_apply, RingHom.algebraMap_toAlgebra,
        ← CommMon.restrictGradedSectionsGradedHom_apply]
      exact Algebra.subset_adjoin <| hy.imp
        (A.restrictGradedSectionsGradedHom (homOfLE hVU)).map_mem
        (A.restrictGradedSectionsGradedHom (homOfLE hVU)).map_mem
  have hmap (y : ⨁ n, Γ(A.X n, U)) :
      A.restrictGradedSections (homOfLE hVU) y ∈ Algebra.adjoin Γ(X, V) T :=
    hle (h ▸ Algebra.mem_top)
  -- The graded ring over `V` is spanned over `Γ(X, V)` by restrictions of sections over `U`.
  refine eq_top_iff.mpr fun x _ ↦ hpo.out.inductionOn x (fun y ↦ hmap y) (fun s z hz ↦ ?_)
    fun _ _ h₁ h₂ ↦ add_mem h₁ h₂
  exact Subalgebra.smul_mem _ hz s

end

end TauCeti
