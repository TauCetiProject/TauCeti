module

public import TauCeti.AlgebraicGeometry.Modules.GradedAlgebra.Sections
public import TauCeti.AlgebraicGeometry.Modules.Sheaf
public import TauCeti.RingTheory.GradedAlgebra.Degree.One

/-!
# Graded algebras generated in degree one

A graded algebra `A` on a scheme `X` is generated in degree one
(`CategoryTheory.CommMon.IsGeneratedInDegreeOne`) if over every affine open `U` of `X` the graded
ring of sections `⨁ n, Γ(Aₙ, U)` is generated by `Γ(A₁, U)` as an algebra over `Γ(A₀, U)`, or
equivalently by its homogeneous elements of degrees `0` and `1` as an algebra over `Γ(X, U)`.

Let `φ : B ⟶ A` be a morphism of graded algebras on a scheme `X` that is an epimorphism of
quasicoherent module sheaves `B₁ ⟶ A₁` in degree one. Over an affine open `U` of `X` over which
the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0`
and `1`, every section of `Aₙ` with `n > 0` is a sum of products of sections of `A₁`
(`TauCeti.GradedAlgebra.mem_closure_grade_one`), and
the sections of `A₁` over `U` are images of sections of `B₁`
(`CategoryTheory.CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi`). Hence `φ` is
surjective in every positive degree on sections over `U`, and an epimorphism in every positive
degree if this holds over every affine open.

## Main definitions

* `CategoryTheory.CommMon.IsGeneratedInDegreeOne A`: over every affine open `U` of `X`, the ring
  `⨁ n, Γ(Aₙ, U)` is generated by `Γ(A₁, U)` as an algebra over `Γ(A₀, U)`.

## Main results

* `CategoryTheory.CommMon.isGeneratedInDegreeOne_iff_adjoin_zero_union_one_eq_top`: `A` is
  generated in degree one if and only if over every affine open `U` the ring `⨁ n, Γ(Aₙ, U)` is
  generated by `Γ(A₀, U) ∪ Γ(A₁, U)` as an algebra over `Γ(X, U)`.
* `CategoryTheory.CommMon.isGeneratedInDegreeOne_of_adjoin_eq_top`: `A` is generated in degree
  one if over every affine open `U` the ring `⨁ n, Γ(Aₙ, U)` is generated by `Γ(A₁, U)` as an
  algebra over `Γ(X, U)`.
* `CategoryTheory.CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi_one`: over an affine
  open over which `A` is generated in degree one, `φ` maps `⨁ n, Γ(Bₙ, U)` onto every homogeneous
  component of positive degree of `⨁ n, Γ(Aₙ, U)`.
* `CategoryTheory.CommMon.epi_hom_hom_of_epi_one`: if `A` is generated in degree one,
  `φ : Bₙ ⟶ Aₙ` is an epimorphism of module sheaves for every `n > 0`.
-/

public section

open CategoryTheory DirectSum TauCeti

namespace CategoryTheory.CommMon

open _root_.AlgebraicGeometry

universe u

section IsGeneratedInDegreeOne

variable {X : Scheme.{u}} (A : CommMon (GradedObject ℕ X.Modules))

/-- A graded algebra `A` on `X` is **generated in degree one** if over every affine open `U` of
`X` the ring `⨁ n, Γ(Aₙ, U)` is generated by its degree-one part `Γ(A₁, U)` as an algebra over its
degree-zero part `Γ(A₀, U)`. -/
def IsGeneratedInDegreeOne : Prop :=
  ∀ U : X.Opens, IsAffineOpen U →
    Algebra.adjoin (A.gradedSectionsGrading U 0)
      (A.gradedSectionsGrading U 1 : Set (⨁ n, Γ(A.X n, U))) = ⊤

variable {A}

/-- A graded algebra is generated in degree one if and only if over every affine open its sections
are generated by the degree-one sections over the degree-zero sections. -/
theorem isGeneratedInDegreeOne_iff :
    A.IsGeneratedInDegreeOne ↔ ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin (A.gradedSectionsGrading U 0)
        (A.gradedSectionsGrading U 1 : Set (⨁ n, Γ(A.X n, U))) = ⊤ :=
  Iff.rfl

/-- A graded algebra `A` on `X` is generated in degree one if and only if over every affine open
`U` of `X` the ring `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0` and `1`
as an algebra over `Γ(X, U)`. -/
theorem isGeneratedInDegreeOne_iff_adjoin_zero_union_one_eq_top :
    A.IsGeneratedInDegreeOne ↔ ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin Γ(X, U) ((A.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.X n, U))) ∪
        A.gradedSectionsGrading U 1) = ⊤ :=
  forall₂_congr fun _ _ ↦ (GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff _).symm

/-- A graded algebra `A` on `X` is generated in degree one if over every affine open `U` of `X` the
ring `⨁ n, Γ(Aₙ, U)` is generated by its degree-one part `Γ(A₁, U)` as an algebra over
`Γ(X, U)`. -/
theorem isGeneratedInDegreeOne_of_adjoin_eq_top
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin Γ(X, U) (A.gradedSectionsGrading U 1 : Set (⨁ n, Γ(A.X n, U))) = ⊤) :
    A.IsGeneratedInDegreeOne :=
  CommMon.isGeneratedInDegreeOne_iff_adjoin_zero_union_one_eq_top.mpr fun U hU ↦
    top_le_iff.mp ((h U hU).ge.trans (Algebra.adjoin_mono Set.subset_union_right))

end IsGeneratedInDegreeOne

variable {X : Scheme.{u}} {A B : CommMon (GradedObject ℕ X.Modules)} (φ : B ⟶ A)
  [Epi (φ.hom.hom 1)]

/-- **A morphism that is an epimorphism in degree one is surjective in positive degrees on affine
sections.** Over an affine open `U` of `X` over which `⨁ n, Γ(Aₙ, U)` is generated by its
homogeneous elements of degrees `0` and `1`, a morphism `φ : B ⟶ A` of graded algebras that is an
epimorphism of quasicoherent module sheaves in degree one maps `⨁ n, Γ(Bₙ, U)` onto every
homogeneous component of positive degree of `⨁ n, Γ(Aₙ, U)`. -/
theorem grade_subset_range_gradedSectionsGradedHom_of_epi_one
    [(A.X 1).IsQuasicoherent] [(B.X 1).IsQuasicoherent] (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.X n, U))) ∪
      A.gradedSectionsGrading U 1) = ⊤)
    (i : ℕ) (hi : 0 < i) :
    (A.gradedSectionsGrading U i : Set (⨁ n, Γ(A.X n, U))) ⊆
      Set.range (CommMon.gradedSectionsGradedHom φ U) := by
  have hle : Subsemiring.closure (A.gradedSectionsGrading U 1 : Set _) ≤
      (CommMon.gradedSectionsMap φ U).range.toSubsemiring :=
    Subsemiring.closure_le.mpr fun _ hx ↦ by
      obtain ⟨y, hy⟩ := CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi φ U hU 1 hx
      exact ⟨y, (CommMon.gradedSectionsGradedHom_apply φ U y).symm.trans hy⟩
  intro x hx
  obtain ⟨y, hy⟩ := hle
    (GradedAlgebra.mem_closure_grade_one _ hi
      ((GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff _).mp h) hx)
  exact ⟨y, (CommMon.gradedSectionsGradedHom_apply φ U y).trans hy⟩

/-- **A morphism that is an epimorphism in degree one is an epimorphism in positive degrees.** If
`A` is generated in degree one, then a morphism `φ : B ⟶ A` of graded quasicoherent algebras that
is an epimorphism `B₁ ⟶ A₁` is an epimorphism `Bₙ ⟶ Aₙ` of module sheaves for every `n > 0`. -/
theorem epi_hom_hom_of_epi_one
    [(A.X 1).IsQuasicoherent] [(B.X 1).IsQuasicoherent] (h : A.IsGeneratedInDegreeOne)
    (i : ℕ) (hi : 0 < i) :
    Epi (φ.hom.hom i) := by
  refine Scheme.Modules.Hom.epi_of_surjective_on_affineOpens _ fun U hU x ↦ ?_
  obtain ⟨y, hy⟩ := CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi_one φ U hU
    (CommMon.isGeneratedInDegreeOne_iff_adjoin_zero_union_one_eq_top.mp h U hU)
    i hi (DirectSum.mem_summand.mpr ⟨x, rfl⟩)
  refine ⟨y i, ?_⟩
  have := congrArg (· i) hy
  simp only [CommMon.gradedSectionsGradedHom_apply, CommMon.gradedSectionsMap_apply] at this
  exact this.trans (DirectSum.of_eq_same (β := fun i ↦ Γ(A.X i, U)) i x)

end CategoryTheory.CommMon
