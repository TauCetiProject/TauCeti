module

public import TauCeti.Algebra.Category.ModuleCat.Sheaf.Free.Basic
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GeneratingSections
public import TauCeti.AlgebraicGeometry.Modules.Tensor.Product

/-!
# Linear combinations of global functions

A family `f : ι → Γ(X, ⊤)` of global functions on a scheme `X` defines the morphism of
`𝒪_X`-modules

  `⨁ᵢ 𝒪_X ⟶ 𝒪_X`, `(gᵢ) ↦ Σ fᵢ gᵢ`,

out of the free `𝒪_X`-module on `ι`, the coproduct of copies of `𝒪_X` indexed by `ι`. It is the
morphism attached to the family of global sections `f` of `𝒪_X` by
`SheafOfModules.freeHomEquiv`. When `ι` is finite, on sections over an open `U` its image is the
ideal of `Γ(X, U)` generated by the restrictions of the `fᵢ`. For an arbitrary family, if the basic
opens `X_{fᵢ}` cover `X`, then these restrictions generate the unit ideal on every affine open, so
the morphism is an epimorphism. This is the surjection whose kernel enters Serre's criterion for
affineness: if the first cohomology of that kernel vanishes, then `1` lifts to a global section of
the free module, that is, the `fᵢ` generate the unit ideal of `Γ(X, ⊤)`.

## Main declarations

* `TauCeti.AlgebraicGeometry.Scheme.Modules.linearCombination`: the morphism `⨁ᵢ 𝒪_X ⟶ 𝒪_X`,
  `(gᵢ) ↦ Σ fᵢ gᵢ`, for an arbitrary family.
* `TauCeti.AlgebraicGeometry.Scheme.Modules.linearCombination_app_freeSection`: its value on the
  tautological section `eᵢ` of the free module is the restriction of `fᵢ`.
* `TauCeti.AlgebraicGeometry.Scheme.Modules.linearCombination_app_sum_smul`: for a finite family,
  its value on `Σ aᵢ eᵢ` is `Σ aᵢ fᵢ`.
* `TauCeti.AlgebraicGeometry.Scheme.Modules.exists_coefficients_linearCombination_app_eq_sum`: for
  a finite family, every value over an open `U` is a combination `Σ aᵢ fᵢ` with `aᵢ ∈ Γ(X, U)`.
* `TauCeti.AlgebraicGeometry.Scheme.Modules.epi_linearCombination`: it is an epimorphism when the
  basic opens of the `fᵢ` cover `X`.

## References

* The Stacks Project, Lemma 30.3.1 (01XF), proof of (2) implies (1).
-/

public section

open CategoryTheory TopologicalSpace AlgebraicGeometry

universe u

noncomputable section

namespace TauCeti.AlgebraicGeometry.Scheme.Modules

open _root_.AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}} {ι : Type u}

/-- The morphism `⨁ᵢ 𝒪_X ⟶ 𝒪_X`, `(gᵢ) ↦ Σ fᵢ gᵢ`, out of the free `𝒪_X`-module on `ι`, attached
to a family `f` of global functions: it sends the `i`-th basis element to `f i`. -/
def linearCombination (f : ι → Γ(X, ⊤)) :
    Hom (SheafOfModules.free (R := X.ringCatSheaf) ι) (SheafOfModules.unit X.ringCatSheaf) :=
  (SheafOfModules.freeHomEquiv _).symm fun i ↦
    (sectionsEquivTop (SheafOfModules.unit X.ringCatSheaf)).symm (f i)

/-- The family of sections of `𝒪_X` attached by `linearCombination f` to the basis elements is the
family of global sections `f`. -/
@[simp]
lemma freeHomEquiv_linearCombination (f : ι → Γ(X, ⊤)) :
    SheafOfModules.freeHomEquiv _ (linearCombination f) = fun i ↦
      (sectionsEquivTop (SheafOfModules.unit X.ringCatSheaf)).symm (f i) :=
  (SheafOfModules.freeHomEquiv _).apply_symm_apply _

/-- Over an open `U`, `linearCombination f` sends the `i`-th tautological section `eᵢ` of the free
module to the restriction of `f i` to `U`. -/
@[simp]
lemma linearCombination_app_freeSection (f : ι → Γ(X, ⊤)) (U : X.Opens) (i : ι) :
    (linearCombination f).app U
        ((SheafOfModules.freeSection (R := X.ringCatSheaf) i).eval (.op U)) =
      (X.presheaf.map U.leTop.op (f i) : Γ(X, U)) :=
  congrArg (fun s : (SheafOfModules.unit X.ringCatSheaf).sections ↦ s.eval (.op U))
    (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection
      (fun k ↦ (sectionsEquivTop (SheafOfModules.unit X.ringCatSheaf)).symm (f k)) i) |>.trans
    (sectionsEquivTop_symm_val (SheafOfModules.unit X.ringCatSheaf) (f i) U)

variable [Fintype ι]

/-- Over an open `U`, `linearCombination f` sends `Σ aᵢ eᵢ`, for the tautological sections `eᵢ`
of the free module on the finite type `ι`, to `Σ aᵢ fᵢ`. The coefficients are sections of the ring
sheaf `X.ringCatSheaf`, whose ring over `U` is `Γ(X, U)`. -/
@[simp]
lemma linearCombination_app_sum_smul (f : ι → Γ(X, ⊤)) (U : X.Opens)
    (a : ι → X.ringCatSheaf.obj.obj (.op U)) :
    (linearCombination f).app U
        (∑ k, a k • (SheafOfModules.freeSection (R := X.ringCatSheaf) k).eval (.op U)) =
      ∑ k, a k * X.ringCatSheaf.obj.map U.leTop.op (f k) :=
  -- The scalar action of `Γ(X, U)` on the unit module is multiplication.
  (TauCeti.SheafOfModules.freeHomEquiv_symm_val_app_sum_smul
    (fun k ↦ (sectionsEquivTop (SheafOfModules.unit X.ringCatSheaf)).symm (f k)) (.op U) a).trans
      (Finset.sum_congr rfl fun k _ ↦ congrArg (a k * ·)
        (sectionsEquivTop_symm_val (SheafOfModules.unit X.ringCatSheaf) (f k) U))

/-- Over an open `U`, `linearCombination f` sends every section of the free module on the finite
type `ι` to a combination `Σ aᵢ fᵢ` with coefficients `aᵢ ∈ Γ(X, U)`. -/
lemma exists_coefficients_linearCombination_app_eq_sum (f : ι → Γ(X, ⊤)) (U : X.Opens)
    (c : Γ(SheafOfModules.free (R := X.ringCatSheaf) ι, U)) :
    ∃ a : ι → Γ(X, U), (linearCombination f).app U c =
      (∑ k, a k * X.presheaf.map U.leTop.op (f k) : Γ(X, U)) := by
  obtain ⟨a, rfl⟩ := TauCeti.SheafOfModules.exists_eq_sum_smul_freeSection
    (R := X.ringCatSheaf) (I := ι) (Y := .op U) c
  -- `X.ringCatSheaf.obj.obj (.op U)` is `Γ(X, U)` viewed as a ring.
  exact ⟨a, linearCombination_app_sum_smul f U a⟩

omit [Fintype ι] in
/-- If the basic opens of global functions `fᵢ` cover `X`, then `(gᵢ) ↦ Σ fᵢ gᵢ` is an
epimorphism `⨁ᵢ 𝒪_X ⟶ 𝒪_X`: on an affine open `U` the restrictions of the `fᵢ` generate the unit
ideal of `Γ(X, U)`. -/
theorem epi_linearCombination (f : ι → Γ(X, ⊤)) (hf : ⨆ i, X.basicOpen (f i) = ⊤) :
    Epi (C := X.Modules) (linearCombination f) :=
  epi_freeHomEquiv_symm_of_span_eq_top (SheafOfModules.unit X.ringCatSheaf) f
    (V := fun U : X.affineOpens ↦ (U : X.Opens)) (fun U ↦ U.property) (iSup_affineOpens_eq_top X)
    fun U ↦ by
      -- The unit module has `Γ(X, U)` itself as sections, so the span is an ideal.
      change Ideal.span (Set.range fun i ↦ X.presheaf.map (homOfLE le_top : U.val ⟶ ⊤).op (f i)) = ⊤
      rw [← U.property.self_le_iSup_basicOpen_iff]
      intro x hx
      obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hf.ge (Set.mem_univ x) : x ∈ ⨆ i, X.basicOpen (f i))
      refine Opens.mem_iSup.mpr ⟨⟨_, i, rfl⟩, ?_⟩
      rw [Scheme.basicOpen_res]
      exact ⟨hx, hi⟩

end TauCeti.AlgebraicGeometry.Scheme.Modules
