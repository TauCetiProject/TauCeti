/-!
# The symmetric algebra of a quasicoherent sheaf is free

For a quasicoherent sheaf `F` on a scheme `X`, the symmetric algebra `Sym F = ⨁ₙ Symⁿ F` is the
direct-sum algebra of the graded symmetric algebra of `F`:

`symmetricAlgebra X : QuasicoherentSheaf X ⥤ QuasicoherentAlgebra X`.

Forgetting the grading, `Sym F` is the free commutative `𝒪_X`-algebra on `F`: a morphism of
`𝒪_X`-modules `φ : F ⟶ B` into any commutative `𝒪_X`-algebra `B` extends uniquely to a morphism of
commutative `𝒪_X`-algebras `Sym F ⟶ B` (`symmetricAlgebraHomEquiv`). The algebra `B` need not be
quasicoherent; this is what makes the statement applicable to the algebras of regular functions
`q_* 𝒪_T` of arbitrary schemes `q : T ⟶ X`, and so to the universal property of the relative
spectrum `Spec_X (Sym F)` (Stacks Project, Tag 01M1).

The extension is built in each degree as for the graded universal property
(`TauCeti.AlgebraicGeometry.gradedSymmetricAlgebraAdjunction`), with the ring of sections
`Γ(B, U)` in place of the graded ring of sections of a graded algebra: over each open `U` the
universal property of the symmetric algebra of the `Γ(X, U)`-module `Γ(F, U)` gives an algebra map
`Sym Γ(F, U) → Γ(B, U)`, whose degree-`n` parts are sheafified
(`TauCeti.SheafOfModules.symmetricPowerLift`) and assembled over the summands of `⨁ₙ Symⁿ F`.
Uniqueness holds because `Sym F` is generated by its unit and by `F` in degree one.

## Main declarations

* `TauCeti.AlgebraicGeometry.symmetricAlgebra`: the symmetric algebra of a quasicoherent sheaf,
  as a quasicoherent algebra;
* `TauCeti.AlgebraicGeometry.symmetricAlgebraι`: the inclusion `F ⟶ Sym F` of the summand of
  degree one, natural in `F` (`symmetricAlgebraι_naturality`);
* `TauCeti.AlgebraicGeometry.symmetricAlgebra_hom_ext`: algebra morphisms out of `Sym F` are
  determined on `F`;
* `TauCeti.AlgebraicGeometry.symmetricAlgebraLift`: the algebra morphism `Sym F ⟶ B` extending a
  module morphism `F ⟶ B` (`symmetricAlgebraι_comp_lift`), natural on both sides
  (`symmetricAlgebraLift_comp`, `symmetricAlgebra_map_comp_lift`);
* `TauCeti.AlgebraicGeometry.symmetricAlgebraHomEquiv`: the universal property
  `(Sym F ⟶ B) ≃ (F ⟶ B)`.

## References

* The Stacks Project, [Tag 01M1](https://stacks.math.columbia.edu/tag/01M1).
-/

public section

open CategoryTheory Limits MonoidalCategory Opposite MonObj

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry GradedQuasicoherentAlgebra

universe u

noncomputable section

section Sections

variable {X : Scheme.{u}} {F : X.Modules} {B : CommMon X.Modules}

/-- Over an open `U`, the algebra map `Sym Γ(F, U) → Γ(B, U)` extending the sections
`Γ(F, U) → Γ(B, U)` of `φ`. -/
private def sectionsLift (φ : F ⟶ B.X) (U : X.Opens) :
    SymmetricAlgebra Γ(X, U) (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val (op U))
      →ₐ[Γ(X, U)] Γ(B.X, U) :=
  SymmetricAlgebra.lift ((Scheme.Modules.sectionsFunctor U).map φ).hom

private lemma sectionsLift_ι (φ : F ⟶ B.X) (U : X.Opens)
    (m : PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val (op U)) :
    sectionsLift φ U (SymmetricAlgebra.ι _ _ m) = φ.app U m :=
  SymmetricAlgebra.lift_ι_apply _ m

/-- The degree-`n` part `Symⁿ Γ(F, U) → Γ(B, U)` of the extension on sections. -/
private def presheafLiftApp (φ : F ⟶ B.X) (n : ℕ) (U : X.Opens) :
    (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val (op U)).symmetricPower n ⟶
      (Scheme.Modules.sectionsFunctor U).obj B.X :=
  ConcreteCategory.ofHom (C := ModuleCat (X.presheaf.obj (op U)))
    ((sectionsLift φ U).toLinearMap ∘ₗ
      (SymmetricAlgebra.homogeneousSubmodule Γ(X, U)
        (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val (op U)) n).subtype)

private lemma presheafLiftApp_apply (φ : F ⟶ B.X) (n : ℕ) (U : X.Opens)
    (x : (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val (op U)).symmetricPower n) :
    presheafLiftApp φ n U x = sectionsLift φ U x.1 :=
  (rfl)

/-- The extension on sections commutes with restriction. -/
private lemma sectionsLift_restrict (φ : F ⟶ B.X) {U V : X.Opens} (f : V ⟶ U) :
    (sectionsLift φ V : SymmetricAlgebra Γ(X, V)
        (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val (op V)) →+* _).comp
      (SymmetricAlgebra.mapₛₗ
        ((ModuleCat.semilinearMapAddEquiv (X.presheaf.map f.op).hom _ _).symm
          (PresheafOfModulesOfCommRing.map (R := X.presheaf) F.val f.op))) =
      (B.restrictSections f).comp (sectionsLift φ U : SymmetricAlgebra Γ(X, U)
        (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val (op U)) →+* _) := by
  refine SymmetricAlgebra.ringHom_ext (RingHom.ext fun r ↦ ?_) fun m ↦ ?_
  · simpa using (B.restrictSections_algebraMap f r).symm
  · simp only [RingHom.comp_apply, SymmetricAlgebra.mapₛₗ_ι]
    erw [sectionsLift_ι, sectionsLift_ι, CommMon.restrictSections_apply]
    exact PresheafOfModules.naturality_apply φ.val f.op m

/-- The degree-`n` part of the extension, as a morphism of presheaves of modules
`Symⁿ F.val ⟶ B.val` out of the presheaf symmetric power. -/
private def presheafLift (φ : F ⟶ B.X) (n : ℕ) :
    (PresheafOfModulesOfCommRing.symmetricPower (R := X.presheaf) n).obj F.val ⟶ B.X.val :=
  PresheafOfModulesOfCommRing.homMk (fun U ↦ presheafLiftApp φ n U.unop)
    (fun {U V} f ↦ by
      ext x
      -- Restriction of scalars and the sections of the presheaves are `rfl`-wrappers that `rw`
      -- does not see through.
      erw [ModuleCat.comp_apply, ModuleCat.restrictScalars.map_apply, ModuleCat.comp_apply,
        presheafLiftApp_apply, presheafLiftApp_apply,
        PresheafOfModulesOfCommRing.coe_symmetricPower_obj_map_apply]
      exact (RingHom.congr_fun (sectionsLift_restrict φ f.unop) x.1).trans
        (B.restrictSections_apply f.unop _))

private lemma presheafLift_app_apply (φ : F ⟶ B.X) (n : ℕ) (U : X.Opensᵒᵖ)
    (x : (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val U).symmetricPower n) :
    (presheafLift φ n).app U x = sectionsLift φ U.unop x.1 :=
  (rfl)

variable (X) in
/-- The inclusion of `𝒪_X`-modules into presheaves of modules over the commutative structure
presheaf, the form in which its lax monoidal structure is used here. -/
private abbrev forgetPresheaf : X.Modules ⥤ PresheafOfModulesOfCommRing.{u} X.presheaf :=
  SheafOfModules.forget _

private instance : (forgetPresheaf X).LaxMonoidal :=
  TauCeti.SheafOfModules.forgetLaxMonoidal X.sheaf

/-- On a pure tensor `x ⊗ₜ y` of sections over `U`, the tensor product of the degree-`i` and
degree-`j` parts of the extension, followed by the multiplication of `B`, is the product of the
images of `x` and `y` in the ring of sections of `B` (`CommMon.sections_mul_def`). -/
private lemma presheafLift_tensorHom_comp_mul_app_tmul (φ : F ⟶ B.X) (i j : ℕ)
    (U : X.Opensᵒᵖ)
    (x : (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val U).symmetricPower i)
    (y : (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val U).symmetricPower j) :
    ((presheafLift φ i ⊗ₘ presheafLift φ j) ≫
        Functor.LaxMonoidal.μ (forgetPresheaf X) B.X B.X ≫
          (forgetPresheaf X).map μ[B.X]).app U (x ⊗ₜ y) =
      sectionsLift φ U.unop x.1 * sectionsLift φ U.unop y.1 :=
  (rfl)

/-- The extension is multiplicative on sections. -/
private lemma presheafLift_mul (φ : F ⟶ B.X) (i j : ℕ) :
    (presheafLift φ i ⊗ₘ presheafLift φ j) ≫
        Functor.LaxMonoidal.μ (forgetPresheaf X) B.X B.X ≫ (forgetPresheaf X).map μ[B.X] =
      PresheafOfModulesOfCommRing.symmetricPowerMul F.val i j ≫ presheafLift φ (i + j) := by
  ext1 U
  refine ModuleCat.MonoidalCategory.tensor_ext fun x y ↦ ?_
  refine (presheafLift_tensorHom_comp_mul_app_tmul φ i j U x y).trans ?_
  refine Eq.trans ?_ (presheafLift_app_apply φ (i + j) U
    ((PresheafOfModulesOfCommRing.symmetricPowerMul F.val i j).app U (x ⊗ₜ y))).symm
  -- The sections of the presheaf symmetric power are those of `ModuleCat.symmetricPower` only up
  -- to `rfl`.
  erw [PresheafOfModulesOfCommRing.symmetricPowerMul_app,
    ModuleCat.symmetricPower.coe_mul_tmul, map_mul]

/-- The extension is unital on sections. -/
private lemma presheafLift_one (φ : F ⟶ B.X) :
    (PresheafOfModulesOfCommRing.symmetricPowerZeroIso X.presheaf).inv.app F.val ≫
        presheafLift φ 0 =
      η[B.X].val := by
  ext1 U
  -- `PresheafOfModulesOfCommRing.symmetricPowerZeroIso` is stated over `X.presheaf`, the
  -- composite over the ring presheaf of `X.ringCatSheaf`.
  erw [PresheafOfModules.comp_app, PresheafOfModulesOfCommRing.symmetricPowerZeroIso_inv_app_app]
  ext
  refine Eq.trans (presheafLift_app_apply φ 0 U _) ?_
  refine (congrArg (fun z ↦ sectionsLift φ U.unop z)
    (ModuleCat.symmetricPower.coe_iso₀_inv_apply _ 1)).trans ?_
  refine (map_one (sectionsLift φ U.unop)).trans ?_
  rw [← map_one (algebraMap Γ(X, U.unop) Γ(B.X, U.unop)), CommMon.sections_algebraMap_def,
    Scheme.Modules.sectionsFunctor_ε]
  exact Scheme.Modules.Hom.app_apply η[B.X] U.unop _

/-- In degree one, the extension restricts to `φ` along `Sym¹ F.val ≅ F.val`. -/
private lemma presheafLift_degreeOne (φ : F ⟶ B.X) :
    (PresheafOfModulesOfCommRing.symmetricPowerOneIso X.presheaf).inv.app F.val ≫
        presheafLift φ 1 = φ.val := by
  ext1 U
  -- As in `presheafLift_one`.
  erw [PresheafOfModules.comp_app, PresheafOfModulesOfCommRing.symmetricPowerOneIso_inv_app_app]
  ext m
  refine Eq.trans (presheafLift_app_apply φ 1 U _) ?_
  refine (congrArg (fun z ↦ sectionsLift φ U.unop z)
    (ModuleCat.symmetricPower.coe_iso₁_inv_apply
      (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.val U) m)).trans ?_
  exact (sectionsLift_ι φ U.unop m).trans (Scheme.Modules.Hom.app_apply φ U.unop m)

variable (F) in
/-- The symmetric power `Symⁿ F`, typed as an `𝒪_X`-module so that the monoidal structure of
`X.Modules` applies to it. -/
private abbrev symPow (n : ℕ) : X.Modules :=
  (SheafOfModules.symmetricPower X.sheaf n).obj F

/-- The degree-`n` component `Symⁿ F ⟶ B` of the extension of `φ`. -/
private def liftDegree (φ : F ⟶ B.X) (n : ℕ) : symPow F n ⟶ B.X :=
  TauCeti.SheafOfModules.symmetricPowerLift (R := X.sheaf) (presheafLift φ n)

private lemma liftDegree_mul (φ : F ⟶ B.X) (i j : ℕ) :
    (liftDegree φ i ⊗ₘ liftDegree φ j) ≫ μ[B.X] =
      (SheafOfModules.symmetricPowerMul F i j : symPow F i ⊗ symPow F j ⟶ symPow F (i + j)) ≫
        liftDegree φ (i + j) :=
  TauCeti.SheafOfModules.symmetricPowerLift_mul (R := X.sheaf) (B := fun _ ↦ B.X)
    (presheafLift φ) (fun _ _ ↦ μ[B.X]) (presheafLift_mul φ) i j

private lemma liftDegree_one (φ : F ⟶ B.X) :
    ((SheafOfModules.symmetricPowerZeroIso X.sheaf).inv.app F : 𝟙_ X.Modules ⟶ symPow F 0) ≫
      liftDegree φ 0 = η[B.X] :=
  TauCeti.SheafOfModules.symmetricPowerZeroIso_inv_app_comp_symmetricPowerLift (R := X.sheaf)
    (presheafLift_one φ)

private lemma liftDegree_degreeOne (φ : F ⟶ B.X) :
    ((SheafOfModules.symmetricPowerOneIso X.sheaf).inv.app F : F ⟶ symPow F 1) ≫
      liftDegree φ 1 = φ :=
  TauCeti.SheafOfModules.symmetricPowerOneIso_inv_app_comp_symmetricPowerLift (R := X.sheaf)
    (presheafLift_degreeOne φ)

end Sections

/-! ### The universal property -/

variable (X : Scheme.{u})

/-- The symmetric algebra `Sym F = ⨁ₙ Symⁿ F` of a quasicoherent sheaf `F`, as a quasicoherent
commutative `𝒪_X`-algebra: the direct-sum algebra of the graded symmetric algebra. -/
abbrev symmetricAlgebra : QuasicoherentSheaf X ⥤ QuasicoherentAlgebra X :=
  gradedSymmetricAlgebra X ⋙ toQuasicoherentAlgebra

variable {X} {F : QuasicoherentSheaf X} {B : CommMon X.Modules}

/-- The identification of `F` with the degree-one component `Sym¹ F` of its graded symmetric
algebra, as `𝒪_X`-modules. -/
private def degreeOneIso (F : QuasicoherentSheaf X) :
    F.obj ≅ ((gradedSymmetricAlgebra X).obj F).obj.X 1 :=
  (ObjectProperty.ι _).mapIso ((gradedSymmetricAlgebraDegreeOneIso X).app F).symm ≪≫
    eqToIso (degree_obj_obj _ 1)

private lemma degreeOneIso_hom (F : QuasicoherentSheaf X) :
    (degreeOneIso F).hom =
      ((gradedSymmetricAlgebraDegreeOneIso X).inv.app F).hom ≫ eqToHom (degree_obj_obj _ 1) :=
  (rfl)

/-- The inclusion `F ≅ Sym¹ F ⟶ Sym F` of a quasicoherent sheaf into its symmetric algebra, as
the summand of degree one. -/
def symmetricAlgebraι (F : QuasicoherentSheaf X) : F.obj ⟶ ((symmetricAlgebra X).obj F).obj.X :=
  (degreeOneIso F).hom ≫ ιTotal _ 1

/-- The inclusion `F ⟶ Sym F` is the identification `F ≅ Sym¹ F` of
`gradedSymmetricAlgebraDegreeOneIso` followed by the inclusion of the summand of degree one. -/
theorem symmetricAlgebraι_def (F : QuasicoherentSheaf X) :
    symmetricAlgebraι F = ((gradedSymmetricAlgebraDegreeOneIso X).inv.app F).hom ≫
      eqToHom (degree_obj_obj _ 1) ≫ ιTotal _ 1 :=
  Category.assoc _ _ _

/-- The direct-sum algebra `Sym F` is generated by `F`: morphisms of commutative `𝒪_X`-algebras
out of it agree as soon as they agree on `F`. -/
theorem symmetricAlgebra_hom_ext {f g : ((symmetricAlgebra X).obj F).obj ⟶ B}
    (h : symmetricAlgebraι F ≫ f.hom.hom = symmetricAlgebraι F ≫ g.hom.hom) : f = g := by
  refine CommMon.hom_ext _ _ (toQuasicoherentAlgebra_hom_ext fun n ↦ ?_)
  -- `Sym F` is generated by its unit and by `F` in degree one: induct on the degree, using that
  -- the unit `𝒪_X ⟶ Sym⁰ F` and the multiplications `Symⁿ F ⊗ Sym¹ F ⟶ Symⁿ⁺¹ F` are
  -- epimorphisms.
  have h₁ : ιTotal _ 1 ≫ f.hom.hom = ιTotal _ 1 ≫ g.hom.hom := by
    refine (Iso.cancel_iso_hom_left (degreeOneIso F) _ _).1 ?_
    exact (Category.assoc _ _ _).symm.trans (h.trans (Category.assoc _ _ _))
  induction n with
  | zero =>
    have h₀ : ((gradedSymmetricAlgebra X).obj F).obj.toMon.one ≫ ιTotal _ 0 =
        η[((symmetricAlgebra X).obj F).obj.X] := by
      rw [one_toQuasicoherentAlgebra, Mon.one_eq]
      exact Category.assoc _ _ _
    have key (k : ((symmetricAlgebra X).obj F).obj ⟶ B) :
        ((gradedSymmetricAlgebra X).obj F).obj.toMon.one ≫ ιTotal _ 0 ≫ k.hom.hom = η[B.X] :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ k.hom.hom) h₀).trans (IsMonHom.one_hom k.hom.hom))
    exact (cancel_epi ((gradedSymmetricAlgebra X).obj F).obj.toMon.one).1
      ((key f).trans (key g).symm)
  | succ n ih =>
    have hm : ((gradedSymmetricAlgebra X).obj F).obj.toMon.mul n 1 ≫ ιTotal _ (n + 1) =
        (ιTotal _ n ⊗ₘ ιTotal _ 1) ≫ μ[((symmetricAlgebra X).obj F).obj.X] := by
      rw [ιTotal_tensorHom_ιTotal_mul, Mon.mul_eq]
      exact Category.assoc _ _ _
    have key (k : ((symmetricAlgebra X).obj F).obj ⟶ B) :
        ((gradedSymmetricAlgebra X).obj F).obj.toMon.mul n 1 ≫ ιTotal _ (n + 1) ≫ k.hom.hom =
          ((ιTotal _ n ≫ k.hom.hom) ⊗ₘ (ιTotal _ 1 ≫ k.hom.hom)) ≫ μ[B.X] :=
      (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ k.hom.hom) hm).trans
        ((Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) (IsMonHom.mul_hom k.hom.hom)).trans
          (tensorHom_comp_tensorHom_assoc _ _ _ _ _))))
    exact (cancel_epi (((gradedSymmetricAlgebra X).obj F).obj.toMon.mul n 1)).1 ((key f).trans
      ((congrArg₂ (fun a b ↦ (a ⊗ₘ b) ≫ μ[B.X]) ih h₁).trans (key g).symm))

/-- The morphism `Sym F ⟶ B` on summands. -/
private def liftTotal (φ : F.obj ⟶ B.X) : ((symmetricAlgebra X).obj F).obj.X ⟶ B.X :=
  Cofan.IsColimit.desc (isColimitιTotal ((gradedSymmetricAlgebra X).obj F))
    fun n ↦ eqToHom (gradedSymmetricAlgebra_obj_obj_X F n) ≫ liftDegree φ n

private lemma ιTotal_liftTotal (φ : F.obj ⟶ B.X) (n : ℕ) :
    ιTotal _ n ≫ liftTotal φ = eqToHom (gradedSymmetricAlgebra_obj_obj_X F n) ≫ liftDegree φ n :=
  Cofan.IsColimit.fac (isColimitιTotal ((gradedSymmetricAlgebra X).obj F)) _ n

private lemma one_liftTotal (φ : F.obj ⟶ B.X) :
    η[((symmetricAlgebra X).obj F).obj.X] ≫ liftTotal φ = η[B.X] := by
  have h : (GradedObject.Monoidal.tensorUnit₀ (C := X.Modules)).inv ≫
      η[((gradedSymmetricAlgebra X).obj F).obj.X] 0 =
        ((gradedSymmetricAlgebra X).obj F).obj.toMon.one :=
    (Mon.one_eq ((gradedSymmetricAlgebra X).obj F).obj.toMon).symm
  rw [one_toQuasicoherentAlgebra_assoc, ιTotal_liftTotal, reassoc_of% h,
    one_gradedSymmetricAlgebra]
  -- The transports of `one_gradedSymmetricAlgebra` are composed partly in
  -- `SheafOfModules X.ringCatSheaf` and partly in `X.Modules`, whose category instances agree
  -- only up to unfolding, so they are cancelled with `erw`.
  erw [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  exact liftDegree_one φ

-- Stated in `X.Modules`: for the transports of `mul_gradedSymmetricAlgebra`, whose sources are
-- typed in `SheafOfModules X.ringCatSheaf`, the generic monoidal rewrites time out.
private lemma eqToHom_tensorHom_eqToHom {M M' N N' : X.Modules} (h : M = M') (h' : N = N') :
    (eqToHom h ⊗ₘ eqToHom h') = eqToHom (congrArg₂ (· ⊗ ·) h h') := by
  subst h h'
  simp

private lemma mul_liftTotal (φ : F.obj ⟶ B.X) :
    μ[((symmetricAlgebra X).obj F).obj.X] ≫ liftTotal φ =
      (liftTotal φ ⊗ₘ liftTotal φ) ≫ μ[B.X] := by
  refine toQuasicoherentAlgebra_tensor_hom_ext fun i j ↦ ?_
  have h : GradedObject.Monoidal.ιTensorObj _ _ i j (i + j) rfl ≫
      μ[((gradedSymmetricAlgebra X).obj F).obj.X] (i + j) =
        ((gradedSymmetricAlgebra X).obj F).obj.toMon.mul i j :=
    (Mon.mul_eq ((gradedSymmetricAlgebra X).obj F).obj.toMon i j).symm
  rw [ιTotal_tensorHom_ιTotal_mul_assoc, reassoc_of% h, ιTotal_liftTotal,
    tensorHom_comp_tensorHom_assoc, ιTotal_liftTotal, ιTotal_liftTotal]
  -- As in `one_liftTotal`, the transports of `mul_gradedSymmetricAlgebra` are cancelled with
  -- `erw`.
  erw [← tensorHom_comp_tensorHom_assoc, liftDegree_mul, mul_gradedSymmetricAlgebra,
    Category.assoc, Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  exact congrArg (· ≫ _) (eqToHom_tensorHom_eqToHom _ _).symm

/-- The morphism of commutative `𝒪_X`-algebras `Sym F ⟶ B` extending a morphism of
`𝒪_X`-modules `φ : F ⟶ B` (`symmetricAlgebraι_comp_lift`). The target `B` need not be
quasicoherent. -/
def symmetricAlgebraLift (φ : F.obj ⟶ B.X) : ((symmetricAlgebra X).obj F).obj ⟶ B :=
  CommMon.homMk (Mon.Hom.mk' (liftTotal φ) (one_liftTotal φ) (mul_liftTotal φ))

private lemma symmetricAlgebraLift_hom_hom (φ : F.obj ⟶ B.X) :
    (symmetricAlgebraLift φ).hom.hom = liftTotal φ :=
  (rfl)

/-- The extension `symmetricAlgebraLift φ` restricts to `φ` on `F`. -/
@[simp, reassoc]
theorem symmetricAlgebraι_comp_lift (φ : F.obj ⟶ B.X) :
    symmetricAlgebraι F ≫ (symmetricAlgebraLift φ).hom.hom = φ := by
  rw [symmetricAlgebraLift_hom_hom, symmetricAlgebraι, degreeOneIso_hom,
    gradedSymmetricAlgebraDegreeOneIso_inv_app_hom]
  -- As in `one_liftTotal`, the transports are cancelled with `erw`.
  erw [Category.assoc, Category.assoc, Category.assoc, ιTotal_liftTotal, eqToHom_trans_assoc,
    eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  exact liftDegree_degreeOne φ

variable (F B) in
/-- **The universal property of the symmetric algebra**: morphisms of commutative
`𝒪_X`-algebras `Sym F ⟶ B` correspond to morphisms of `𝒪_X`-modules `F ⟶ B`, by restriction
along `symmetricAlgebraι` and by `symmetricAlgebraLift`. -/
def symmetricAlgebraHomEquiv : (((symmetricAlgebra X).obj F).obj ⟶ B) ≃ (F.obj ⟶ B.X) where
  toFun f := symmetricAlgebraι F ≫ f.hom.hom
  invFun := symmetricAlgebraLift
  left_inv _ := symmetricAlgebra_hom_ext (symmetricAlgebraι_comp_lift _)
  right_inv := symmetricAlgebraι_comp_lift

-- Not a `simp` lemma: `simp` unfolds the functor composite `symmetricAlgebra X` in the type of
-- the bijection, so the left-hand side is not in simp-normal form; `symmetricAlgebraι_comp_lift`
-- and `symmetricAlgebraLift_comp` are the simp lemmas of this interface.
/-- The bijection `symmetricAlgebraHomEquiv` restricts a morphism `Sym F ⟶ B` to `F`. -/
theorem symmetricAlgebraHomEquiv_apply (f : ((symmetricAlgebra X).obj F).obj ⟶ B) :
    symmetricAlgebraHomEquiv F B f = symmetricAlgebraι F ≫ f.hom.hom :=
  (rfl)

/-- The inverse bijection of `symmetricAlgebraHomEquiv` is `symmetricAlgebraLift`. -/
theorem symmetricAlgebraHomEquiv_symm_apply (φ : F.obj ⟶ B.X) :
    (symmetricAlgebraHomEquiv F B).symm φ = symmetricAlgebraLift φ :=
  (rfl)

/-- Postcomposing `symmetricAlgebraLift φ` with a morphism of commutative `𝒪_X`-algebras `f`
extends `φ` followed by `f`. -/
@[simp, reassoc]
theorem symmetricAlgebraLift_comp {B' : CommMon X.Modules} (φ : F.obj ⟶ B.X) (f : B ⟶ B') :
    symmetricAlgebraLift φ ≫ f = symmetricAlgebraLift (φ ≫ f.hom.hom) :=
  symmetricAlgebra_hom_ext ((Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ f.hom.hom) (symmetricAlgebraι_comp_lift φ)).trans
      (symmetricAlgebraι_comp_lift _).symm))

/-- The inclusion `F ⟶ Sym F` is natural in `F`. -/
@[reassoc]
theorem symmetricAlgebraι_naturality {F' : QuasicoherentSheaf X} (g : F' ⟶ F) :
    g.hom ≫ symmetricAlgebraι F =
      symmetricAlgebraι F' ≫ ((symmetricAlgebra X).map g).hom.hom.hom := by
  have h := congrArg (fun f ↦ f.hom) ((gradedSymmetricAlgebraDegreeOneIso X).inv.naturality g)
  rw [ObjectProperty.FullSubcategory.comp_hom, ObjectProperty.FullSubcategory.comp_hom,
    Functor.id_map, Functor.comp_map, degree_map_hom] at h
  rw [symmetricAlgebraι, symmetricAlgebraι, degreeOneIso_hom, degreeOneIso_hom]
  -- The morphisms of quasicoherent sheaves `g.hom` and the components of
  -- `gradedSymmetricAlgebraDegreeOneIso` are typed in `SheafOfModules X.ringCatSheaf`, the
  -- remaining factors in `X.Modules`; the two category instances agree only up to unfolding, so
  -- the rewrites need `erw`.
  erw [Category.assoc, Category.assoc, Category.assoc, ιTotal_toQuasicoherentAlgebra_map,
    ← Category.assoc g.hom, h, Category.assoc, Category.assoc, Category.assoc,
    eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  -- The two sides now differ only in the category instances through which the composites are
  -- typed.
  rfl

/-- Precomposing `symmetricAlgebraLift φ` with the map `Sym F' ⟶ Sym F` induced by a morphism
`g : F' ⟶ F` extends `g ≫ φ`. The left-hand side is stated with `symmetricAlgebra X` unfolded
to the direct-sum algebra of the graded symmetric algebra, its simp-normal form. -/
@[simp, reassoc]
theorem symmetricAlgebra_map_comp_lift {F' : QuasicoherentSheaf X} (g : F' ⟶ F)
    (φ : F.obj ⟶ B.X) :
    (toQuasicoherentAlgebra.map ((gradedSymmetricAlgebra X).map g)).hom ≫ symmetricAlgebraLift φ =
      symmetricAlgebraLift (g.hom ≫ φ) :=
  symmetricAlgebra_hom_ext ((Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ _) (symmetricAlgebraι_naturality g).symm).trans ((Category.assoc _ _ _).trans
      ((congrArg (g.hom ≫ ·) (symmetricAlgebraι_comp_lift φ)).trans
        (symmetricAlgebraι_comp_lift _).symm))))

end

