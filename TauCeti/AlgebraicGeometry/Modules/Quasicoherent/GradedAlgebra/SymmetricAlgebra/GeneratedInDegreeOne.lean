module

public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Adjunction
public import TauCeti.RingTheory.GradedAlgebra.DegreeOne

/-!
# `Sym A₁ ⟶ A` is surjective in positive degrees when `A` is generated in degree one

Let `A` be a graded quasicoherent algebra on a scheme `X`, and let `Sym A₁ ⟶ A` be the morphism of
graded quasicoherent algebras extending the identity of the degree-one component `A₁`
(`TauCeti.AlgebraicGeometry.gradedSymmetricAlgebraLift`). Suppose that `A` is generated in degree
one: over every affine open `U` of `X`, the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by
its homogeneous elements of degrees `0` and `1`, that is, by `Γ(A₁, U)` as an algebra over
`Γ(A₀, U)`. Then `Sym A₁ ⟶ A` is surjective in every positive degree on sections over every affine
open, hence an epimorphism of module sheaves in every positive degree: since `A₀ · A₁ ⊆ A₁`, every
section of `Aₙ` with `n > 0` is a polynomial in sections of `A₁` with coefficients in `Γ(X, U)`
(`TauCeti.GradedAlgebra.mem_adjoin_grade_one_of_adjoin_grade_zero_union_grade_one_eq_top`), and
`Sym A₁ ⟶ A` is the identity in degree one.

## Main results

In the namespace `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra`:

* `grade_subset_range_gradedSymmetricAlgebraLift`: over an affine open over which `A` is generated
  in degree one, `Sym A₁ ⟶ A` maps the sections of `Sym A₁` onto every homogeneous component of
  positive degree of `⨁ n, Γ(Aₙ, U)`.
* `epi_gradedSymmetricAlgebraLift`: if `A` is generated in degree one, `Symⁿ A₁ ⟶ Aₙ` is an
  epimorphism of module sheaves for every `n > 0`.
-/

public section

open CategoryTheory DirectSum

namespace TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra

open _root_.AlgebraicGeometry

universe u

noncomputable section

variable {X : Scheme.{u}} (A : GradedQuasicoherentAlgebra X)

/-- **`Sym A₁ ⟶ A` is surjective in positive degrees on affine sections.** Over an affine open `U`
of `X` over which `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0` and `1`,
the morphism `Sym A₁ ⟶ A` extending the identity of `A₁` maps `⨁ n, Γ(Symⁿ A₁, U)` onto every
homogeneous component of positive degree of `⨁ n, Γ(Aₙ, U)`. -/
theorem grade_subset_range_gradedSymmetricAlgebraLift (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤)
    (i : ℕ) (hi : 0 < i) :
    (A.obj.gradedSectionsGrading U i : Set (⨁ n, Γ(A.obj.X n, U))) ⊆
      Set.range (CommMon.gradedSectionsGradedHom
        (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom U) := by
  have := epi_gradedSymmetricAlgebraLift_one A (𝟙 _)
  have hle : Algebra.adjoin Γ(X, U) (A.obj.gradedSectionsGrading U 1 : Set _) ≤
      (CommMon.gradedSectionsMap (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom
        U).range := Algebra.adjoin_le fun _ hy ↦ by
    obtain ⟨y, rfl⟩ := CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi
      (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom U hU 1 hy
    exact ⟨y, (CommMon.gradedSectionsGradedHom_apply _ U y).symm⟩
  intro x hx
  obtain ⟨y, hy⟩ :=
    hle (GradedAlgebra.mem_adjoin_grade_one_of_adjoin_grade_zero_union_grade_one_eq_top _ h hi hx)
  exact ⟨y, (CommMon.gradedSectionsGradedHom_apply _ U y).trans hy⟩

/-- **`Sym A₁ ⟶ A` is an epimorphism in every positive degree.** If over every affine open `U` of
`X` the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees
`0` and `1`, then the morphism `Symⁿ A₁ ⟶ Aₙ` of module sheaves is an epimorphism for every
`n > 0`. -/
theorem epi_gradedSymmetricAlgebraLift
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
        A.obj.gradedSectionsGrading U 1) = ⊤)
    (i : ℕ) (hi : 0 < i) :
    Epi ((gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom.hom.hom i) := by
  refine Scheme.Modules.Hom.epi_of_surjective_on_affineOpens _ fun U hU x ↦ ?_
  obtain ⟨y, hy⟩ := grade_subset_range_gradedSymmetricAlgebraLift A U hU (h U hU) i hi
    (DirectSum.mem_summand.mpr ⟨x, rfl⟩)
  refine ⟨y i, ?_⟩
  have := congrArg (· i) hy
  simp only [CommMon.gradedSectionsGradedHom_apply, CommMon.gradedSectionsMap_apply] at this
  exact this.trans (DirectSum.of_eq_same (β := fun i ↦ Γ(A.obj.X i, U)) i x)

end

end TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra
