module

public import TauCeti.AlgebraicGeometry.Modules.GradedAlgebra.DegreeOne
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.Pullback
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Adjunction
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Pullback

/-!
# `Sym A₁ ⟶ A` is surjective in positive degrees when `A` is generated in degree one

Let `A` be a graded quasicoherent algebra on a scheme `X`, and let `Sym A₁ ⟶ A` be the morphism of
graded quasicoherent algebras extending the identity of the degree-one component `A₁`
(`TauCeti.AlgebraicGeometry.gradedSymmetricAlgebraLift`). It is an epimorphism in degree one, being
split by `A₁ ≅ Sym¹ A₁`. Suppose that `A` is generated in degree one: over every affine open `U`
of `X`, the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of
degrees `0` and `1`, that is, by `Γ(A₁, U)` as an algebra over `Γ(A₀, U)`. Then `Sym A₁ ⟶ A` is
surjective in every positive degree on sections over every affine open, hence an epimorphism of
module sheaves in every positive degree
(`CategoryTheory.CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi_one`). If moreover the
unit `𝒪_X ⟶ A₀` is an epimorphism, then the morphism of direct sums `⨁ₙ Symⁿ A₁ ⟶ ⨁ₙ Aₙ` is an
epimorphism, so that the relative spectrum of `⨁ₙ Aₙ` is a closed subscheme of that of
`⨁ₙ Symⁿ A₁`.

This last property is stable under pullback along a morphism of schemes `f : Y ⟶ X`. The degree-one
component of `f^* A` is `f^* A₁`, and through `f^* (Sym A₁) ≅ Sym (f^* A₁)`
(`TauCeti.AlgebraicGeometry.pullbackSymmetricAlgebraIso`) and `f^* (⨁ₙ Aₙ) ≅ ⨁ₙ f^* Aₙ`
(`TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra.pullbackToQuasicoherentAlgebraIso`) the
morphism `⨁ₙ Symⁿ (f^* A₁) ⟶ ⨁ₙ f^* Aₙ` is the pullback of `⨁ₙ Symⁿ A₁ ⟶ ⨁ₙ Aₙ`, and pulling
back preserves epimorphisms.

## Main results

In the namespace `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra`:

* `epi_gradedSymmetricAlgebraLift_one`: `Sym A₁ ⟶ A` is an epimorphism in degree one.
* `grade_subset_range_gradedSymmetricAlgebraLift`: over an affine open over which `A` is generated
  in degree one, `Sym A₁ ⟶ A` maps the sections of `Sym A₁` onto every homogeneous component of
  positive degree of `⨁ n, Γ(Aₙ, U)`.
* `epi_gradedSymmetricAlgebraLift`: if `A` is generated in degree one, `Symⁿ A₁ ⟶ Aₙ` is an
  epimorphism of module sheaves for every `n > 0`.
* `epi_toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift`: if moreover the unit `𝒪_X ⟶ A₀` is
  an epimorphism, then so is the morphism of direct sums `⨁ₙ Symⁿ A₁ ⟶ ⨁ₙ Aₙ`.
* `symmetricAlgebraι_comp_toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift`: on the generators
  `F` of `Sym F`, the morphism of direct sums induced by the extension of `φ : F ⟶ A₁` is `φ`
  followed by the inclusion of `A₁`.
* `toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift_pullback`: the morphism of direct sums
  `⨁ₙ Symⁿ (f^* A₁) ⟶ ⨁ₙ f^* Aₙ` is the pullback of `⨁ₙ Symⁿ A₁ ⟶ ⨁ₙ Aₙ`, up to the canonical
  isomorphisms.
* `epi_toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift_pullback`: if `⨁ₙ Symⁿ A₁ ⟶ ⨁ₙ Aₙ`
  is an epimorphism, then so is `⨁ₙ Symⁿ (f^* A₁) ⟶ ⨁ₙ f^* Aₙ`.
-/

public section

open CategoryTheory DirectSum

namespace TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra

open _root_.AlgebraicGeometry

universe u

variable {X : Scheme.{u}} (A : GradedQuasicoherentAlgebra X)

/-- The morphism `Sym A₁ ⟶ A` extending the identity of `A₁` is an epimorphism in degree one: it
is split by `A₁ ≅ Sym¹ A₁`. -/
theorem epi_gradedSymmetricAlgebraLift_one :
    Epi ((gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom.hom.hom 1) :=
  -- For `FullSubcategory` morphisms, `.hom` preserves composition and identities
  -- definitionally. Applying it to the splitting identity gives a section in modules.
  epi_hom_hom_of_epi_degree_map _ 1 (SplitEpi.epi ⟨_, congrArg (·.hom)
    (gradedSymmetricAlgebraDegreeOneIso_inv_app_comp_degreeOne_map_lift (𝟙 (degreeOne.obj A)))⟩)

/-- **`Sym A₁ ⟶ A` is surjective in positive degrees on affine sections.** Over an affine open `U`
of `X` over which `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0` and `1`,
the morphism `Sym A₁ ⟶ A` extending the identity of `A₁` maps `⨁ n, Γ(Symⁿ A₁, U)` onto every
homogeneous component of positive degree of `⨁ n, Γ(Aₙ, U)`. -/
theorem grade_subset_range_gradedSymmetricAlgebraLift (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤)
    (i : ℕ) (hi : 0 < i) :
    (A.obj.gradedSectionsGrading U i : Set (⨁ n, Γ(A.obj.X n, U))) ⊆
      Set.range (CommMon.gradedSectionsGradedHom
        (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom U) :=
  have := epi_gradedSymmetricAlgebraLift_one A
  CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi_one _ U hU h i hi

/-- **`Sym A₁ ⟶ A` is an epimorphism in every positive degree.** If `A` is generated in degree
one, then the morphism `Symⁿ A₁ ⟶ Aₙ` of module sheaves is an epimorphism for every `n > 0`. -/
theorem epi_gradedSymmetricAlgebraLift (h : A.obj.IsGeneratedInDegreeOne) (i : ℕ) (hi : 0 < i) :
    Epi ((gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom.hom.hom i) :=
  have := epi_gradedSymmetricAlgebraLift_one A
  CommMon.epi_hom_hom_of_epi_one _ h i hi

/-- **`Sym A₁ ⟶ A` is an epimorphism of direct sums.** If `A` is generated in degree one and its
unit `𝒪_X ⟶ A₀` is an epimorphism, then the morphism `⨁ₙ Symⁿ A₁ ⟶ ⨁ₙ Aₙ` of quasicoherent
algebras extending the identity of `A₁` is an epimorphism of module sheaves. -/
theorem epi_toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift [Epi A.obj.toMon.one]
    (h : A.obj.IsGeneratedInDegreeOne) :
    Epi (toQuasicoherentAlgebra.map
      (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A)))).hom.hom.hom :=
  epi_toQuasicoherentAlgebra_map _ fun i hi ↦ epi_gradedSymmetricAlgebraLift A h i hi

/-! ### Pullback -/

variable {A} in
/-- On the generators `F` of `Sym F`, the morphism of direct sums `⨁ₙ Symⁿ F ⟶ ⨁ₙ Aₙ` induced by
the extension of `φ : F ⟶ A₁` is `φ` followed by the inclusion of the summand `A₁`. -/
theorem symmetricAlgebraι_comp_toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift
    {F : QuasicoherentSheaf X} (φ : F ⟶ degreeOne.obj A) :
    symmetricAlgebraι F ≫ (toQuasicoherentAlgebra.map (gradedSymmetricAlgebraLift φ)).hom.hom.hom =
      φ.hom ≫ eqToHom (degree_obj_obj A 1) ≫ ιTotal A 1 := by
  have h := congrArg (·.hom) (gradedSymmetricAlgebraDegreeOneIso_inv_app_comp_degreeOne_map_lift φ)
  simp only [ObjectProperty.FullSubcategory.comp_hom, degree_map_hom] at h
  rw [symmetricAlgebraι_def]
  -- On the summand `Sym¹ F`, the morphism of direct sums is the degree-one component of the
  -- extension (`ιTotal_toQuasicoherentAlgebra_map`), whose restriction along `F ≅ Sym¹ F` is `φ`
  -- (`h`). The composites are typed partly in `SheafOfModules X.ringCatSheaf` and partly in
  -- `X.Modules`, which `rw` does not identify, so the associativity steps are chained as terms.
  refine (Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) ((Category.assoc _ _ _).trans
    (congrArg (_ ≫ ·) (ιTotal_toQuasicoherentAlgebra_map _ 1)))).trans ?_)
  rw [← h]
  exact ((Category.assoc _ _ _).trans (congrArg (_ ≫ ·) ((Category.assoc _ _ _).trans
    (congrArg (_ ≫ ·) ((Category.assoc _ _ _).trans (congrArg (_ ≫ ·)
      ((eqToHom_trans_assoc _ _ _).trans ((congrArg (· ≫ _) (eqToHom_refl _ _)).trans
        (Category.id_comp _))))))))).symm

variable {Y : Scheme.{u}} (f : Y ⟶ X)

/-- **`Sym A₁ ⟶ A` commutes with pullback.** For a morphism of schemes `f : Y ⟶ X`, the morphism
`⨁ₙ Symⁿ (f^* A₁) ⟶ ⨁ₙ f^* Aₙ` extending the identity of the degree-one component of `f^* A` is
the pullback of `⨁ₙ Symⁿ A₁ ⟶ ⨁ₙ Aₙ`, through the identification of the degree-one component of
`f^* A` with `f^* A₁` (`pullbackDegreeIso`), the isomorphism `Sym (f^* A₁) ≅ f^* (Sym A₁)`
(`pullbackSymmetricAlgebraIso`) and the isomorphism `f^* (⨁ₙ Aₙ) ≅ ⨁ₙ f^* Aₙ`
(`pullbackToQuasicoherentAlgebraIso`). -/
theorem toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift_pullback :
    toQuasicoherentAlgebra.map
        (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj ((pullback f).obj A)))) =
      (symmetricAlgebra Y).map ((pullbackDegreeIso f 1).hom.app A) ≫
        (pullbackSymmetricAlgebraIso f (degreeOne.obj A)).inv ≫
          (QuasicoherentAlgebra.pullback f).map
            (toQuasicoherentAlgebra.map (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A)))) ≫
            (pullbackToQuasicoherentAlgebraIso f).hom.app A := by
  -- Both sides are morphisms of algebras out of `Sym (f^* A₁)`, so it suffices to compare them on
  -- the generators. There each of the four factors on the right is computed by a known lemma, and
  -- the chain is assembled for abstract modules: the carriers of quasicoherent algebras are typed
  -- partly in `SheafOfModules _.ringCatSheaf` and partly in `_.Modules`, which `rw` does not
  -- identify.
  refine ObjectProperty.hom_ext _ (symmetricAlgebra_hom_ext ?_)
  have key {P S0 S1 S2 S3 N Q B1 : Y.Modules} {Fo SymF TA A1 : X.Modules}
      (Φ : X.Modules ⥤ Y.Modules)
      (sι' : P ⟶ S0) (SA' : S0 ⟶ S1) (I2' : S1 ⟶ S2) (PT' : S2 ⟶ S3) (T' : SymF ⟶ TA)
      (Q' : S3 ⟶ N) (gh : P ⟶ Q) (sι : Q ⟶ S1) (sιF : Fo ⟶ SymF) (ιA : A1 ⟶ TA) (ι1 : B1 ⟶ N)
      (hg : P = Q) (he1 : Q = Φ.obj Fo) (he2 : Φ.obj SymF = S2) (he3 : S2 = Φ.obj SymF)
      (he4 : Φ.obj TA = S3) (he5 : Fo = A1) (he6 : Φ.obj A1 = B1) (he0 : P = B1)
      (hgh : gh = eqToHom hg) (hnat : gh ≫ sι = sι' ≫ SA')
      (hI : sι ≫ I2' = eqToHom he1 ≫ Φ.map sιF ≫ eqToHom he2)
      (hPT : PT' = eqToHom he3 ≫ Φ.map T' ≫ eqToHom he4)
      (hT : sιF ≫ T' = 𝟙 Fo ≫ eqToHom he5 ≫ ιA)
      (hQ : Φ.map ιA ≫ eqToHom he4 ≫ Q' = eqToHom he6 ≫ ι1) :
      𝟙 P ≫ eqToHom he0 ≫ ι1 = sι' ≫ SA' ≫ I2' ≫ PT' ≫ Q' := by
    subst hg he1 he2 he4 he5 he6 hgh hPT
    simp only [eqToHom_refl, Category.id_comp] at hnat hI hT hQ ⊢
    rw [← reassoc_of% hnat, reassoc_of% hI]
    simp [← Functor.map_comp_assoc, hT, hQ]
  exact (symmetricAlgebraι_comp_toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift _).trans
    (key (Scheme.Modules.pullback f) (sι := symmetricAlgebraι _) (sιF := symmetricAlgebraι _)
      (ιA := ιTotal A 1) (ι1 := ιTotal _ 1)
      (hgh := pullbackDegreeIso_hom_app_hom f 1 A) (hnat := symmetricAlgebraι_naturality _)
      (hI := symmetricAlgebraι_comp_pullbackSymmetricAlgebraIso_inv f _)
      (hPT := QuasicoherentAlgebra.pullback_map_hom_hom_hom f _)
      (hT := symmetricAlgebraι_comp_toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift _)
      (hQ := pullback_map_ιTotal_pullbackToQuasicoherentAlgebraIso_hom_app f A 1) ..)

/-- **Surjectivity of `Sym A₁ ⟶ A` is stable under pullback.** If `⨁ₙ Symⁿ A₁ ⟶ ⨁ₙ Aₙ` is an
epimorphism, then so is `⨁ₙ Symⁿ (f^* A₁) ⟶ ⨁ₙ f^* Aₙ` for every morphism of schemes
`f : Y ⟶ X`. -/
theorem epi_toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift_pullback
    (h : Epi (toQuasicoherentAlgebra.map
      (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A)))).hom.hom.hom) :
    Epi (toQuasicoherentAlgebra.map
      (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj ((pullback f).obj A))))).hom.hom.hom := by
  -- The `Epi` instances of the factors are supplied by hand: the carriers of quasicoherent
  -- algebras are typed partly in `SheafOfModules _.ringCatSheaf`, where typeclass search does not
  -- find the instances stated in `_.Modules`.
  rw [toQuasicoherentAlgebra_map_gradedSymmetricAlgebraLift_pullback]
  refine epi_comp' (QuasicoherentAlgebra.epi_hom_hom_hom_of_isIso _)
    (epi_comp' (QuasicoherentAlgebra.epi_hom_hom_hom_of_isIso _)
      (epi_comp' ?_ (QuasicoherentAlgebra.epi_hom_hom_hom_of_isIso _)))
  rw [QuasicoherentAlgebra.pullback_map_hom_hom_hom]
  exact epi_comp' (eqToIso (QuasicoherentAlgebra.pullback_obj_X f _)).isIso_hom.epi_of_iso
    (epi_comp' (@Functor.map_epi _ _ _ _ (Scheme.Modules.pullback f) _ _ _ _ h)
      (eqToIso (QuasicoherentAlgebra.pullback_obj_X f _).symm).isIso_hom.epi_of_iso)

end TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra
