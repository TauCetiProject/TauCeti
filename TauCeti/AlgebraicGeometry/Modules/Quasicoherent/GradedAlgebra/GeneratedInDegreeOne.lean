/-!
# Graded quasicoherent algebras generated in degree one

A graded quasicoherent algebra `A` on a scheme `X` is generated in degree one if over every affine
open `U` of `X` the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous
elements of degrees `0` and `1`, that is, by `Γ(A₁, U)` as an algebra over `Γ(A₀, U)`.

A morphism `φ : B ⟶ A` of graded quasicoherent algebras that is an epimorphism in degree one is
then surjective in every positive degree: since `A₀ · A₁ ⊆ A₁`, every section of `Aₙ` with `n > 0`
is a polynomial in sections of `A₁` with coefficients in `Γ(X, U)`
(`TauCeti.GradedAlgebra.mem_adjoin_grade_one_of_adjoin_grade_zero_union_grade_one_eq_top`), and
these are images of sections of `B₁`. The main example is the morphism `Sym A₁ ⟶ A` extending the
identity of `A₁`, an epimorphism in degree one by
`TauCeti.AlgebraicGeometry.epi_gradedSymmetricAlgebraLift_one`.

## Main definitions

* `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra.IsGeneratedInDegreeOne`: the graded ring
  of sections over every affine open is generated in degrees `0` and `1`.

## Main results

In the namespace `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra`:

* `isGeneratedInDegreeOne_iff`: equivalently, `Γ(A₁, U)` generates `⨁ n, Γ(Aₙ, U)` as an algebra
  over `Γ(A₀, U)` for every affine open `U`.
* `grade_subset_range_gradedSectionsGradedHom_of_epi_one`: over an affine open over which `A` is
  generated in degree one, a morphism `B ⟶ A` that is an epimorphism in degree one maps the
  sections of `B` onto every homogeneous component of positive degree of `⨁ n, Γ(Aₙ, U)`.
* `epi_hom_of_epi_one`: if `A` is generated in degree one, a morphism `B ⟶ A` that is an
  epimorphism in degree one is an epimorphism `Bₙ ⟶ Aₙ` of module sheaves for every `n > 0`.

## References

* [The Stacks Project, Lemma 27.11.3 (01N0)](https://stacks.math.columbia.edu/tag/01N0)
-/

public section

open CategoryTheory DirectSum

namespace TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra

open _root_.AlgebraicGeometry

universe u

variable {X : Scheme.{u}}

/-- A graded quasicoherent algebra `A` is **generated in degree one** if over every affine open
`U` of `X` the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of
degrees `0` and `1`. -/
structure IsGeneratedInDegreeOne (A : GradedQuasicoherentAlgebra X) : Prop where
  /-- Over every affine open `U`, `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of
  degrees `0` and `1` as a `Γ(X, U)`-algebra. -/
  adjoin_grade_zero_union_grade_one_eq_top (U : X.Opens) (hU : IsAffineOpen U) :
    Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤

/-- A graded quasicoherent algebra `A` is generated in degree one if and only if over every affine
open `U`, `Γ(A₁, U)` generates `⨁ n, Γ(Aₙ, U)` as an algebra over `Γ(A₀, U)`. -/
theorem isGeneratedInDegreeOne_iff {A : GradedQuasicoherentAlgebra X} :
    A.IsGeneratedInDegreeOne ↔ ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin (A.obj.gradedSectionsGrading U 0)
        (A.obj.gradedSectionsGrading U 1 : Set (⨁ n, Γ(A.obj.X n, U))) = ⊤ :=
  ⟨fun h U hU ↦ (GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff _).mp
    (h.adjoin_grade_zero_union_grade_one_eq_top U hU),
    fun h ↦ ⟨fun U hU ↦ (GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff _).mpr
      (h U hU)⟩⟩

variable {A B : GradedQuasicoherentAlgebra X} (φ : B ⟶ A) [Epi (φ.hom.hom.hom 1)]

/-- **An epimorphism in degree one is surjective in positive degrees on affine sections.** Over an
affine open `U` of `X` over which `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of
degrees `0` and `1`, a morphism `φ : B ⟶ A` that is an epimorphism `B₁ ⟶ A₁` maps
`⨁ n, Γ(Bₙ, U)` onto every homogeneous component of positive degree of `⨁ n, Γ(Aₙ, U)`. -/
theorem grade_subset_range_gradedSectionsGradedHom_of_epi_one (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤)
    (i : ℕ) (hi : 0 < i) :
    (A.obj.gradedSectionsGrading U i : Set (⨁ n, Γ(A.obj.X n, U))) ⊆
      Set.range (CommMon.gradedSectionsGradedHom φ.hom U) := by
  have hle : Algebra.adjoin Γ(X, U) (A.obj.gradedSectionsGrading U 1 : Set _) ≤
      (CommMon.gradedSectionsMap φ.hom U).range := by
    refine Algebra.adjoin_le fun y hy ↦ ?_
    obtain ⟨z, hz⟩ := CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi φ.hom U hU 1 hy
    exact ⟨z, (CommMon.gradedSectionsGradedHom_apply _ U z).symm.trans hz⟩
  intro x hx
  obtain ⟨y, hy⟩ := hle
    (GradedAlgebra.mem_adjoin_grade_one_of_adjoin_grade_zero_union_grade_one_eq_top _ h hi hx)
  exact ⟨y, (CommMon.gradedSectionsGradedHom_apply _ U y).trans hy⟩

/-- **An epimorphism in degree one onto an algebra generated in degree one is an epimorphism in
every positive degree.** If `A` is generated in degree one and `φ : B ⟶ A` is an epimorphism
`B₁ ⟶ A₁`, then `φ` is an epimorphism `Bₙ ⟶ Aₙ` of module sheaves for every `n > 0`. -/
theorem epi_hom_of_epi_one (hA : A.IsGeneratedInDegreeOne) (i : ℕ) (hi : 0 < i) :
    Epi (φ.hom.hom.hom i) := by
  refine Scheme.Modules.Hom.epi_of_surjective_on_affineOpens _ fun U hU x ↦ ?_
  obtain ⟨y, hy⟩ := grade_subset_range_gradedSectionsGradedHom_of_epi_one φ U hU
    (hA.adjoin_grade_zero_union_grade_one_eq_top U hU) i hi (DirectSum.mem_summand.mpr ⟨x, rfl⟩)
  refine ⟨y i, ?_⟩
  have := congrArg (· i) hy
  simp only [CommMon.gradedSectionsGradedHom_apply, CommMon.gradedSectionsMap_apply] at this
  exact this.trans (DirectSum.of_eq_same (β := fun i ↦ Γ(A.obj.X i, U)) i x)

end TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra
