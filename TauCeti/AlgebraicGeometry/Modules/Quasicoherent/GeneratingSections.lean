/-!
# Global sections generating a quasi-coherent module

A family `s` of global sections of an `𝒪_X`-module `M` generates `M` if the morphism
`𝒪_X^{(I)} ⟶ M` it defines out of the free module is an epimorphism; this is the condition in
Mathlib's `SheafOfModules.GeneratingSections`. For a quasi-coherent `M` it can be checked on an
affine open cover: it suffices that over each member `V` of the cover, the restrictions of the
sections `s` span `Γ(V, M)` as a `Γ(V, 𝒪_X)`-module. Indeed, over a basic open `D(f) ⊆ V`, every
section of `M` is a section over `V` divided by a power of `f`.

This is how global generation is verified in Serre's theorem on twists by an ample line bundle,
where generating sections are produced chart by chart.

## Main results

* `AlgebraicGeometry.Scheme.Modules.Hom.epi_of_forall_surjective_app`: a morphism into a
  quasi-coherent module that is surjective on sections over each member of an affine open cover is
  an epimorphism.
* `AlgebraicGeometry.Scheme.Modules.epi_freeHomEquiv_symm_of_span_eq_top` and
  `AlgebraicGeometry.Scheme.Modules.generatingSectionsOfSpanEqTop`: global sections of a
  quasi-coherent module whose restrictions span the sections over each member of an affine open
  cover generate the module and package into a `SheafOfModules.GeneratingSections`.
* `AlgebraicGeometry.Scheme.Modules.exists_epi_biproduct_of_generatingSections`: finite global
  generation of `F ⊗ P` with `P ⊗ Q ≅ 𝒪_X` yields an epimorphism `(⨁_{Fin k} Q) ⟶ F`.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Section II.5, the definition of a
  sheaf generated by global sections and the proof of Theorem II.5.17.
-/

public section

open CategoryTheory Limits MonoidalCategory AlgebraicGeometry Opposite TopologicalSpace

namespace AlgebraicGeometry.Scheme.Modules

universe u

variable {X : Scheme.{u}}

/-- **Epimorphisms onto a quasi-coherent module are detected on an affine open cover.** A
morphism `φ : F ⟶ M` into a quasi-coherent `𝒪_X`-module is an epimorphism if it is surjective on
sections over each member `V i` of an affine open cover of `X`. -/
theorem Hom.epi_of_forall_surjective_app {F M : X.Modules} [M.IsQuasicoherent] (φ : F ⟶ M)
    {ι : Type*} {V : ι → X.Opens} (hV : ∀ i, IsAffineOpen (V i)) (hcov : ⨆ i, V i = ⊤)
    (hφ : ∀ i, Function.Surjective (φ.app (V i))) : Epi φ := by
  -- A section `m` of `M` near `x` is, on a basic open `D(f) ⊆ V i` around `x`, a section over
  -- `V i` divided by a power of `f`, hence in the image of `φ` over `D(f)`.
  have : Sheaf.IsLocallySurjective
      ((TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf X).map φ) := by
    constructor
    intro U m x hx
    obtain ⟨i, hxi⟩ := Opens.mem_iSup.mp (hcov.symm ▸ Opens.mem_top x : x ∈ ⨆ i, V i)
    obtain ⟨f, hfU, hxf⟩ := (hV i).exists_basicOpen_le ⟨x, hx⟩ hxi
    have hD : X.basicOpen f ≤ V i := X.basicOpen_le f
    obtain ⟨n, y, hy⟩ := M.exists_pow_smul_eq_map (hV i) f rfl hD
      (M.presheaf.map (homOfLE hfU).op m)
    obtain ⟨z, rfl⟩ := hφ i y
    obtain ⟨u, hu⟩ : IsUnit (X.presheaf.map (homOfLE hD).op f ^ n) :=
      (X.toRingedSpace.isUnit_res_basicOpen f).pow n
    refine ⟨X.basicOpen f, homOfLE hfU, ⟨(↑u⁻¹ : Γ(X, X.basicOpen f)) •
      F.presheaf.map (homOfLE hD).op z, ?_⟩, hxf⟩
    -- The underlying sheaf of abelian groups has the sections and restriction maps of `M`, on
    -- which `φ` acts through `Hom.app`.
    change φ.app _ _ = M.presheaf.map _ m
    have hnat : φ.app _ (F.presheaf.map (homOfLE hD).op z) =
        M.presheaf.map (homOfLE hD).op (φ.app (V i) z) :=
      φ.mapPresheaf.naturality_apply _ z
    rw [Hom.app_smul, hnat, ← hy, ← hu, smul_smul, Units.inv_mul, one_smul]
  exact (TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf X).epi_of_epi_map
    (Sheaf.epi_of_isLocallySurjective _)

/-- **Global generation from spanning on an affine open cover.** Let `M` be a quasi-coherent
`𝒪_X`-module and `s` a family of global sections of `M`. If over each member `V i` of an affine
open cover of `X` the restrictions of the sections `s` span `Γ(V i, M)` as a `Γ(V i, 𝒪_X)`-module,
then the sections `s` generate `M`: the morphism `𝒪_X^{(I)} ⟶ M` that they define is an
epimorphism. -/
theorem epi_freeHomEquiv_symm_of_span_eq_top (M : X.Modules) [M.IsQuasicoherent] {I : Type u}
    (s : I → Γ(M, ⊤)) {ι : Type*} {V : ι → X.Opens} (hV : ∀ i, IsAffineOpen (V i))
    (hcov : ⨆ i, V i = ⊤)
    (hs : ∀ i, Submodule.span Γ(X, V i)
      (Set.range fun k ↦ M.presheaf.map (homOfLE le_top : V i ⟶ ⊤).op (s k)) = ⊤) :
    @Epi X.Modules _ (SheafOfModules.free I) M
      (M.freeHomEquiv.symm fun k ↦ M.sectionsEquivTop.symm (s k)) := by
  let F : X.Modules := SheafOfModules.free I
  let φ : F ⟶ M := M.freeHomEquiv.symm fun k ↦ M.sectionsEquivTop.symm (s k)
  refine φ.epi_of_forall_surjective_app hV hcov fun i y ↦ φ.exists_app_eq_of_mem_span ?_
    (hs i ▸ Submodule.mem_top)
  -- The restriction of `s k` to `V i` is the image of the restriction of the `k`-th generator.
  rintro _ ⟨k, rfl⟩
  refine ⟨F.presheaf.map (homOfLE le_top : V i ⟶ ⊤).op
    (F.sectionsEquivTop (SheafOfModules.freeSection k)), ?_⟩
  exact (φ.mapPresheaf.naturality_apply _ _).trans
    (congrArg _ (app_freeHomEquiv_symm_freeSection M s k))

section GlobalGeneration

variable (E : X.Modules) [E.IsQuasicoherent] {ι : Type*} {U : ι → X.Opens}
  (hU : ∀ i, IsAffineOpen (U i)) (hcover : ⨆ i, U i = ⊤) {I : Type u}

section

variable (σ : I → Γ(E, ⊤))
  (hspan : ∀ i, Submodule.span Γ(X, U i)
    (Set.range fun k ↦ E.presheaf.map (U i).leTop.op (σ k)) = ⊤)

/-- If a family of global sections of a quasi-coherent module `E` spans `Γ(E, U i)` over every
member `U i` of an affine open cover of `X`, then it defines a `GeneratingSections` of `E`. -/
-- Exposed so the dependent field `.s` accepts indices `k : I` directly in public signatures,
-- matching `SheafOfModules.GeneratingSections.biprod`.
@[expose]
noncomputable def generatingSectionsOfSpanEqTop : E.GeneratingSections where
  I := I
  s k := E.sectionsEquivTop.symm (σ k)
  epi := epi_freeHomEquiv_symm_of_span_eq_top E σ hU hcover hspan

/-- The indexing type of `generatingSectionsOfSpanEqTop` is `I`. -/
@[simp]
theorem generatingSectionsOfSpanEqTop_I :
    (generatingSectionsOfSpanEqTop E hU hcover σ hspan).I = I := (rfl)

/-- The generating sections of `generatingSectionsOfSpanEqTop` correspond to `σ` via
`sectionsEquivTop.symm`. -/
@[simp]
theorem generatingSectionsOfSpanEqTop_s (k : I) :
    (generatingSectionsOfSpanEqTop E hU hcover σ hspan).s k = E.sectionsEquivTop.symm (σ k) := (rfl)

/-- The generating morphism of `generatingSectionsOfSpanEqTop` is the morphism out of `free I`
induced by `σ`. -/
@[simp]
theorem generatingSectionsOfSpanEqTop_π :
    (generatingSectionsOfSpanEqTop E hU hcover σ hspan).π =
      (SheafOfModules.freeHomEquiv E).symm fun k ↦ E.sectionsEquivTop.symm (σ k) := (rfl)

end

/-- `generatingSectionsOfSpanEqTop` indexed by a finite type is of finite type. -/
instance isFiniteType_generatingSectionsOfSpanEqTop [Finite I] (σ : I → Γ(E, ⊤))
    (hspan : ∀ i, Submodule.span Γ(X, U i)
      (Set.range fun k ↦ E.presheaf.map (U i).leTop.op (σ k)) = ⊤) :
    (generatingSectionsOfSpanEqTop E hU hcover σ hspan).IsFiniteType where
  finite := ‹Finite I›

end GlobalGeneration

/-- If `F ⊗ P` is generated by finitely many global sections and `P ⊗ Q ≅ 𝒪_X`, then `F` is a
quotient of a finite biproduct of copies of `Q`. -/
theorem exists_epi_biproduct_of_generatingSections {F P Q : X.Modules}
    (e : P ⊗ Q ≅ 𝟙_ X.Modules) (G : (F ⊗ P).GeneratingSections) [hG : G.IsFiniteType] :
    ∃ (k : ℕ) (p : (⨁ fun _ : Fin k ↦ Q) ⟶ F), Epi p := by
  have : Finite G.I := hG.finite
  have : Fintype G.I := .ofFinite G.I
  obtain ⟨k, ⟨ek⟩⟩ := Finite.exists_equiv_fin G.I
  have : (tensorRight Q).IsEquivalence :=
    MonoidalCategory.isEquivalence_tensorRight_of_iso (β_ Q P ≪≫ e)
  have : (tensorRight Q).Additive := Functor.additive_of_preserves_binary_products _
  have hbp : HasBiproduct (C := X.Modules) fun _ : G.I ↦ 𝟙_ X.Modules :=
    HasBiproduct.of_hasCoproduct _
  let e₀ : Iso (C := X.Modules) (@biproduct G.I X.Modules _ _ (fun _ : G.I ↦ 𝟙_ X.Modules) hbp)
      (SheafOfModules.free G.I) :=
    TauCeti.SheafOfModules.biproductIsoFree (R := X.sheaf) G.I
  let eFin : (⨁ fun _ : Fin k ↦ (𝟙_ X.Modules : X.Modules)) ≅
      (SheafOfModules.free G.I : X.Modules) :=
    biproduct.whiskerEquiv (f := fun _ : Fin k ↦ (𝟙_ X.Modules : X.Modules))
      (g := fun _ : G.I ↦ (𝟙_ X.Modules : X.Modules)) ek.symm (fun _ ↦ Iso.refl _) ≪≫
    (biproduct.isColimit (C := X.Modules)
      (fun _ : G.I ↦ (𝟙_ X.Modules : X.Modules))).coconePointUniqueUpToIso
      (@biproduct.isColimit G.I X.Modules _ _ (fun _ : G.I ↦ 𝟙_ X.Modules) hbp) ≪≫ e₀
  let q : (⨁ fun _ : Fin k ↦ (𝟙_ X.Modules : X.Modules)) ⟶ F ⊗ P := eFin.hom ≫ G.π
  have : Epi q := @epi_comp X.Modules _ _ _ _ eFin.hom
    (@IsIso.epi_of_iso _ _ _ _ eFin.hom (Iso.isIso_hom eFin)) G.π G.epi
  exact ⟨k, (biproduct.mapIso fun _ : Fin k ↦ (λ_ Q).symm).hom ≫
    ((tensorRight Q).mapBiproduct fun _ : Fin k ↦ (𝟙_ X.Modules : X.Modules)).inv ≫
    (tensorRight Q).map q ≫ (α_ F P Q).hom ≫ F ◁ e.hom ≫ (ρ_ F).hom, inferInstance⟩

end AlgebraicGeometry.Scheme.Modules
