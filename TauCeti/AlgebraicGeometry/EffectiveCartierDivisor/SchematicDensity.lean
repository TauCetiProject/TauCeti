module

public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.SchemeTheoreticallyDominant

/-!
# The complement of an effective Cartier divisor is scheme-theoretically dense

Let `D` be an effective Cartier divisor on a scheme `X`, given by an ideal sheaf `I`. Its open
complement `X ∖ D` is scheme-theoretically dense in `X`: the inclusion of `X ∖ D` is
scheme-theoretically dominant, so the scheme-theoretic closure of `X ∖ D` is all of `X`, with its
nilpotents. Locally, on an affine open `U` where `I` is generated by a nonzerodivisor `a`, the
complement contains the basic open `D(a)`, and restriction from `U` to `D(a)` is the localization
`Γ(X, U) ⟶ Γ(X, U)_a`, which is injective because `a` is a nonzerodivisor. No reducedness,
Noetherianity or finiteness hypothesis on `X` is needed.

This is what makes the complement of the exceptional divisor of a blowup dense in the blowup,
and so identifies the strict transform of a closed subscheme with a scheme-theoretic closure.

## Main results

* `IsEffectiveCartier.isSchemeTheoreticallyDominant_support_compl_ι`, in the namespace
  `AlgebraicGeometry.Scheme.IdealSheafData`: the inclusion of the complement of an effective
  Cartier divisor is scheme-theoretically dominant.

## References

* [The Stacks Project, Section 01WQ](https://stacks.math.columbia.edu/tag/01WQ), *Effective Cartier
  divisors*: the lemma that the complement of an effective Cartier divisor is scheme-theoretically
  dense.
-/

public section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} {I : X.IdealSheafData}

/-- **The complement of an effective Cartier divisor is scheme-theoretically dense**: the
inclusion of the open complement of the support of an effective Cartier divisor is
scheme-theoretically dominant. -/
theorem IsEffectiveCartier.isSchemeTheoreticallyDominant_support_compl_ι
    (hI : I.IsEffectiveCartier) :
    IsSchemeTheoreticallyDominant (Scheme.Opens.ι I.support.compl) := by
  choose U hxU a ha hUa using (isEffectiveCartier_iff I).mp hI
  rw [isSchemeTheoreticallyDominant_iff]
  refine ext_of_iSup_eq_top U (eq_top_iff.mpr fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr
    ⟨x, hxU x⟩) fun x ↦ le_antisymm (fun s hs ↦ ?_) bot_le
  -- A section on `U x` vanishing on the complement of `I` vanishes on `D(a x) ⊆ U x`.
  have hle : X.basicOpen (a x) ≤ I.support.compl := by
    -- membership in `I.support.compl` is by definition non-membership in `I.support`
    intro y hy hyI
    have hyU : y ∈ (U x).1 := X.basicOpen_le (a x) hy
    rw [SetLike.mem_coe, mem_support_iff_of_mem hyU, hUa x, Scheme.mem_zeroLocus_iff] at hyI
    exact hyI (a x) (Ideal.mem_span_singleton_self _) hy
  have hs0 : X.presheaf.map (homOfLE (X.basicOpen_le (a x))).op s = 0 := by
    let ι := Scheme.Opens.ι I.support.compl
    have hs' := ι.ideal_ker_le (U x) hs
    rw [RingHom.mem_ker, Scheme.Opens.ι_app] at hs'
    -- `D(a x)` lies in the part of `U x` that meets the complement of the support.
    have h : X.basicOpen (a x) ≤ ι ''ᵁ ι ⁻¹ᵁ (U x).1 := fun y hy ↦
      ⟨⟨y, hle hy⟩, X.basicOpen_le (a x) hy, rfl⟩
    rw [show homOfLE (X.basicOpen_le (a x)) = homOfLE h ≫ homOfLE (ι.image_preimage_le (U x).1)
      from Subsingleton.elim _ _, op_comp, Functor.map_comp, CommRingCat.comp_apply]
    exact (congrArg _ hs').trans (map_zero _)
  -- Restriction to `D(a x)` is the localization at the nonzerodivisor `a x`, hence injective.
  have := (U x).2.isLocalization_basicOpen (a x)
  refine (IsLocalization.injective_iff_isRegular (Submonoid.powers (a x))
    (S := Γ(X, X.basicOpen (a x)))).mpr ?_ (hs0.trans (map_zero _).symm)
  rintro ⟨_, n, rfl⟩
  exact ((Commute.isRegular_iff (Commute.all _)).mpr (ha x).isLeftRegular).pow n

end AlgebraicGeometry.Scheme.IdealSheafData
