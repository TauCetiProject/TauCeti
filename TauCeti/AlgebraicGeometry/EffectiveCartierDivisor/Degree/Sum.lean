/-!
# The degree of a sum of relative effective Cartier divisors

The degree of a relative effective Cartier divisor `D` on `X` over `S`, finite over `S`, is the
rank of `D ⟶ S`. This file proves that the degree is additive: `deg (D + E) = deg D + deg E`,
where the sum `D + E` is cut out by the product of the ideal sheaves
(`Scheme.IdealSheafData.IsRelativeEffectiveCartier.finrank_mul_subschemeι_comp`). Consequently the
sum of divisors of degrees `d` and `e` on the base changes of a proper relative curve has degree
`d + e` (`TauCeti.AlgebraicGeometry.mul_mem_relativeEffectiveCartierDegreeSubfunctor_obj`), so
addition of divisors restricts to the fixed-degree functors `Div^d_{X/S}`. Together with the empty
divisor having degree zero, this gives the degrees of multiples and of finite sums of divisors
(`TauCeti.AlgebraicGeometry.pow_mem_relativeEffectiveCartierDegreeSubfunctor_obj` and
`TauCeti.AlgebraicGeometry.prod_mem_relativeEffectiveCartierDegreeSubfunctor_obj`).
More generally, the rank of any finite sum of relative effective Cartier divisors whose total
divisor is finite over the base is the sum of their ranks
(`TauCeti.AlgebraicGeometry.finrank_prod_subschemeι_comp`).

Since ranks of finite flat morphisms and relative effective Cartier divisors are both compatible
with base change, the statement reduces to the fibres, that is, to a scheme `Y` over a field `K`
(`Scheme.IdealSheafData.IsEffectiveCartier.finrank_mul_subschemeι_comp_of_field`). There the
closed subscheme `Z = V(I * J)` is finite over `K`, so it is affine with a finite-dimensional ring
of global sections `B`, and `V(I)` and `V(J)` are cut out of `Z` by ideals `𝔞` and `𝔟` of `B`. Near
every point of `Z`, on an affine chart `U` of `Y` where `I = (α)` for a nonzerodivisor `α`, the
sections of `Z` are `Γ(Y, U) ⧸ (α) J(U)`, the ideal `𝔞` is generated by `α`, and the annihilator of
`α` is `𝔟`. The local criterion `TauCeti.finrank_quotient_add_finrank_quotient_of_forall` then
gives `dim B = dim (B ⧸ 𝔞) + dim (B ⧸ 𝔟)`. Only `I` needs to be effective Cartier over a field;
the second ideal sheaf `J` is arbitrary.

## References

* The Stacks Project, *Divisors*, Section *Effective Cartier divisors*: the sum of effective
  Cartier divisors.
* S. Kleiman, *The Picard scheme*, in *Fundamental Algebraic Geometry: Grothendieck's FGA
  Explained*, Section 9.3.
* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §1.1.
-/

public section

open CategoryTheory Limits

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {Y : Scheme.{u}}

/-- Let `α` be a nonzerodivisor generating `I(U)` on an affine open `U`. In the sections
`Γ(Y, U) ⧸ (α) J(U)` of `V(I * J)` over `U`, the annihilator of `α` is generated by `J(U)`. -/
private lemma annihilator_span_singleton_subschemeι_app {I J : Y.IdealSheafData}
    {U : Y.affineOpens} {α : Γ(Y, U)} (hα : IsSMulRegular Γ(Y, U) α)
    (hIα : I.ideal U = Ideal.span {α}) :
    (Ideal.span {((I * J).subschemeι.app U).hom α}).annihilator =
      (J.ideal U).map ((I * J).subschemeι.app U).hom := by
  let f := ((I * J).subschemeι.app U).hom
  have hf : Function.Surjective f := (I * J).subschemeι_app_surjective U
  have hker : RingHom.ker f = Ideal.span {α} * J.ideal U := by
    rw [ker_subschemeι_app, ideal_mul, Pi.mul_apply, hIα]
  apply Ideal.comap_injective_of_surjective f hf
  rw [Ideal.comap_map_of_surjective' f hf, hker, sup_eq_left.mpr Ideal.mul_le_right]
  ext x
  rw [Ideal.mem_comap, Ideal.span, Submodule.mem_annihilator_span_singleton, smul_eq_mul,
    ← map_mul, ← RingHom.mem_ker, hker, Ideal.mem_span_singleton_mul]
  constructor
  · rintro ⟨j, hj, hjx⟩
    rwa [← hα.isLeftRegular (hjx.trans (mul_comm x α))]
  · exact fun hx ↦ ⟨x, hx, mul_comm _ _⟩

/-- Let `I` be an effective Cartier divisor and `J` an ideal sheaf on `Y` such that the closed
subscheme `Z = V(I * J)` is affine, with closed subschemes `V(I)` and `V(J)`. At the stalk of every
point `z` of `Z`, the ideal of `V(I)` in `Γ(Z, ⊤)` is generated by an element whose annihilator is
the ideal of `V(J)`: a local equation of `I`. -/
private lemma exists_map_ker_inclusion_appTop_eq_span_singleton {I J : Y.IdealSheafData}
    (hI : I.IsEffectiveCartier) (hIle : I * J ≤ I) (hJle : I * J ≤ J)
    [IsAffine (I * J).subscheme] (z : (I * J).subscheme) :
    ∃ a : (I * J).subscheme.presheaf.stalk z,
      (RingHom.ker (inclusion hIle).appTop.hom).map
          ((I * J).subscheme.presheaf.germ ⊤ z trivial).hom = Ideal.span {a} ∧
        (RingHom.ker (inclusion hJle).appTop.hom).map
          ((I * J).subscheme.presheaf.germ ⊤ z trivial).hom = (Ideal.span {a}).annihilator := by
  -- Choose an affine chart `U` around `z` on which `I = (α)`; its preimage `V` in `Z` is an affine
  -- open with sections `Γ(Y, U) ⧸ (α) J(U)`, and the stalk at `z` is a localization of them.
  obtain ⟨U, hzU, α, hα, hIα⟩ := (isEffectiveCartier_iff I).mp hI ((I * J).subschemeι z)
  have hV : IsAffineOpen ((I * J).subschemeι ⁻¹ᵁ U.1) := U.2.preimage _
  let _ : Algebra Γ((I * J).subscheme, (I * J).subschemeι ⁻¹ᵁ U.1)
      ((I * J).subscheme.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk _ ⟨z, hzU⟩
  have := hV.isLocalization_stalk ⟨z, hzU⟩
  have hgerm : ((I * J).subscheme.presheaf.germ ⊤ z trivial).hom =
      (algebraMap Γ((I * J).subscheme, (I * J).subschemeι ⁻¹ᵁ U.1)
        ((I * J).subscheme.presheaf.stalk z)).comp
        ((I * J).subscheme.presheaf.map (homOfLE le_top).op).hom :=
    (congrArg CommRingCat.Hom.hom
      ((I * J).subscheme.presheaf.germ_res (homOfLE le_top) z hzU)).symm
  -- The kernels on `Z` restrict to the kernels over `V`.
  have hres {I' : Y.IdealSheafData} (h : I * J ≤ I') :
      (RingHom.ker (inclusion h).appTop.hom).map
        ((I * J).subscheme.presheaf.map (homOfLE le_top).op).hom =
      RingHom.ker ((inclusion h).app ((I * J).subschemeι ⁻¹ᵁ U.1)).hom := by
    have := (inclusion h).ker.map_ideal' (U := ⟨_, hV⟩)
      (V := ⟨⊤, isAffineOpen_top _⟩) (homOfLE le_top).op
    rwa [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply] at this
  refine ⟨algebraMap _ _ (((I * J).subschemeι.app U).hom α), ?_, ?_⟩
  · rw [hgerm, ← Ideal.map_map, hres, ker_inclusion_app, hIα, Ideal.map_span, Ideal.map_span,
      Set.image_singleton, Set.image_singleton]
  · rw [hgerm, ← Ideal.map_map, hres, ker_inclusion_app,
      ← annihilator_span_singleton_subschemeι_app hα hIα,
      IsLocalization.map_annihilator_span_singleton (hV.primeIdealOf ⟨z, hzU⟩).asIdeal.primeCompl]

/-- **Additivity of degree over a field.** Let `I` be an effective Cartier divisor and `J` any
ideal sheaf on a scheme `Y` over a field `K`, such that the closed subscheme `V(I * J)` is finite
over `K`. Then the degree of `V(I * J)` over `K` is the sum of the degrees of `V(I)` and `V(J)`. -/
theorem IsEffectiveCartier.finrank_mul_subschemeι_comp_of_field {K : Type u} [Field K]
    (f : Y ⟶ Spec (.of K)) {I : Y.IdealSheafData} (hI : I.IsEffectiveCartier)
    (J : Y.IdealSheafData) [IsFinite ((I * J).subschemeι ≫ f)] (s : Spec (.of K)) :
    ((I * J).subschemeι ≫ f).finrank s =
      (I.subschemeι ≫ f).finrank s + (J.subschemeι ≫ f).finrank s := by
  -- `V(I * J)` contains `V(I)` and `V(J)` as closed subschemes, through `iI` and `iJ`.
  have hIle : I * J ≤ I := mul_le_of_le_one_right bot_le le_top
  have hJle : I * J ≤ J := mul_le_of_le_one_left bot_le le_top
  let iI := inclusion hIle
  let iJ := inclusion hJle
  have : IsAffine (I * J).subscheme := isAffine_of_isAffineHom ((I * J).subschemeι ≫ f)
  -- All global sections are `K`-algebras through the structure map of `V(I * J)`.
  let : Algebra K Γ((I * J).subscheme, ⊤) :=
    ((Scheme.ΓSpecIso (.of K)).inv ≫ ((I * J).subschemeι ≫ f).appTop).hom.toAlgebra
  let : Algebra K Γ(I.subscheme, ⊤) :=
    (iI.appTop.hom.comp (algebraMap K Γ((I * J).subscheme, ⊤))).toAlgebra
  let : Algebra K Γ(J.subscheme, ⊤) :=
    (iJ.appTop.hom.comp (algebraMap K Γ((I * J).subscheme, ⊤))).toAlgebra
  have hI' : I.subschemeι ≫ f = iI ≫ (I * J).subschemeι ≫ f := by
    rw [← Category.assoc, inclusion_subschemeι]
  have hJ' : J.subschemeι ≫ f = iJ ≫ (I * J).subschemeι ≫ f := by
    rw [← Category.assoc, inclusion_subschemeι]
  have : Module.Finite K Γ((I * J).subscheme, ⊤) := ((I * J).subschemeι ≫ f).moduleFinite_appTop rfl
  rw [hI', hJ', ((I * J).subschemeι ≫ f).finrank_eq_finrank_of_field rfl s,
    (iI ≫ (I * J).subschemeι ≫ f).finrank_eq_finrank_of_field
      (by rw [Scheme.Hom.comp_appTop]; rfl) s,
    (iJ ≫ (I * J).subschemeι ≫ f).finrank_eq_finrank_of_field
      (by rw [Scheme.Hom.comp_appTop]; rfl) s]
  -- The global sections of `V(I)` and `V(J)` are quotients of those of `V(I * J)`.
  let φI : Γ((I * J).subscheme, ⊤) →ₐ[K] Γ(I.subscheme, ⊤) :=
    { iI.appTop.hom with commutes' := fun _ ↦ rfl }
  let φJ : Γ((I * J).subscheme, ⊤) →ₐ[K] Γ(J.subscheme, ⊤) :=
    { iJ.appTop.hom with commutes' := fun _ ↦ rfl }
  have hφI : Function.Surjective φI := iI.app_surjective ⊤ (isAffineOpen_top _)
  have hφJ : Function.Surjective φJ := iJ.app_surjective ⊤ (isAffineOpen_top _)
  rw [← (Ideal.quotientKerAlgEquivOfSurjective hφI).toLinearEquiv.finrank_eq,
    ← (Ideal.quotientKerAlgEquivOfSurjective hφJ).toLinearEquiv.finrank_eq]
  -- Check the local criterion at the stalk of every point of `V(I * J)`.
  have hZ := isAffineOpen_top (I * J).subscheme
  let _ (q : PrimeSpectrum Γ((I * J).subscheme, ⊤)) :
      Algebra Γ((I * J).subscheme, ⊤) ((I * J).subscheme.presheaf.stalk (hZ.fromSpec q)) :=
    TopCat.Presheaf.algebra_section_stalk (U := ⊤) _ ⟨hZ.fromSpec q, trivial⟩
  have (q : PrimeSpectrum Γ((I * J).subscheme, ⊤)) :
      IsLocalization.AtPrime ((I * J).subscheme.presheaf.stalk (hZ.fromSpec q)) q.asIdeal :=
    hZ.isLocalization_stalk' q trivial
  refine (TauCeti.finrank_quotient_add_finrank_quotient_of_forall (RingHom.ker φI)
    (RingHom.ker φJ) (fun q ↦ (I * J).subscheme.presheaf.stalk (hZ.fromSpec q))
    fun q ↦ ?_).symm
  -- `φI` and `φJ` are the maps of global sections of the inclusions, recorded as `K`-linear.
  have hkerI : RingHom.ker φI = RingHom.ker iI.appTop.hom := rfl
  have hkerJ : RingHom.ker φJ = RingHom.ker iJ.appTop.hom := rfl
  rw [hkerI, hkerJ]
  exact exists_map_ker_inclusion_appTop_eq_span_singleton hI hIle hJle (hZ.fromSpec q)

/-- **The degree of a sum of relative effective Cartier divisors is the sum of the degrees.** If
`I` and `J` are relative effective Cartier divisors on `X` over `S` and the closed subscheme of
`I * J`, the divisor `D + E`, is finite over `S`, then its rank over `S` is the sum of the ranks of
the closed subschemes of `I` and `J`. -/
theorem IsRelativeEffectiveCartier.finrank_mul_subschemeι_comp {S X : Scheme.{u}} {f : X ⟶ S}
    {I J : X.IdealSheafData} (hI : I.IsRelativeEffectiveCartier f)
    (hJ : J.IsRelativeEffectiveCartier f) [IsFinite ((I * J).subschemeι ≫ f)] :
    ((I * J).subschemeι ≫ f).finrank =
      (I.subschemeι ≫ f).finrank + (J.subschemeι ≫ f).finrank := by
  have hIle : I * J ≤ I := mul_le_of_le_one_right bot_le le_top
  have hJle : I * J ≤ J := mul_le_of_le_one_left bot_le le_top
  have : IsFinite (I.subschemeι ≫ f) := by
    rw [← inclusion_subschemeι hIle, Category.assoc]; infer_instance
  have : IsFinite (J.subschemeι ≫ f) := by
    rw [← inclusion_subschemeι hJle, Category.assoc]; infer_instance
  have := hI.flat
  have := hJ.flat
  have := (TauCeti.isRelativeEffectiveCartier_mul hI hJ).flat
  -- Compute the ranks at `t` on the fibre over the residue field of `t`.
  funext t
  let h := S.fromSpecResidueField t
  have H := IsPullback.of_hasPullback f h
  let s : Spec (S.residueField t) := IsLocalRing.closedPoint _
  have hs : h s = t := S.fromSpecResidueField_apply t s
  have : IsFinite (((I * J).comap (pullback.fst f h)).subschemeι ≫ pullback.snd f h) := by
    rw [← comapPullbackFstIso_hom_snd]; infer_instance
  rw [Pi.add_apply, ← hs, ← finrank_comap_of_isPullback (I * J) f _ _ h H,
    ← finrank_comap_of_isPullback I f _ _ h H, ← finrank_comap_of_isPullback J f _ _ h H]
  rw [comap_mul] at this ⊢
  exact IsEffectiveCartier.finrank_mul_subschemeι_comp_of_field (K := S.residueField t)
    (pullback.snd f h) (hI.comap h).isEffectiveCartier _ s

end AlgebraicGeometry.Scheme.IdealSheafData

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry

/-- Ranks add for a finite sum of relative effective Cartier divisors whose total divisor is
finite over the base. -/
theorem finrank_prod_subschemeι_comp
    {X S : Scheme.{u}} {f : X ⟶ S}
    {ι : Type*} (s : Finset ι) (I : ι → X.IdealSheafData)
    (hI : ∀ i ∈ s, (I i).IsRelativeEffectiveCartier f)
    [hfinite : IsFinite ((∏ i ∈ s, I i).subschemeι ≫ f)] :
    ((∏ i ∈ s, I i).subschemeι ≫ f).finrank = ∑ i ∈ s, ((I i).subschemeι ≫ f).finrank := by
  classical
  induction s using Finset.induction_on generalizing hfinite with
  | empty =>
    have : IsFinite ((1 : X.IdealSheafData).subschemeι ≫ f) := by
      simpa only [Finset.prod_empty] using ‹IsFinite ((∏ i ∈ ∅, I i).subschemeι ≫ f)›
    simp only [Finset.prod_empty, Finset.sum_empty]
    have hrel : (1 : X.IdealSheafData).IsRelativeEffectiveCartier f := by simp
    have := hrel.flat
    funext t
    rw [Pi.zero_apply, Scheme.Hom.finrank_eq_zero_iff_notMem_range]
    rintro ⟨z, -⟩
    exact isEmptyElim (α := (⊤ : X.IdealSheafData).subscheme) z
  | insert a s ha ih =>
    rw [Finset.prod_insert ha] at hfinite
    have hle : I a * ∏ i ∈ s, I i ≤ ∏ i ∈ s, I i :=
      mul_le_of_le_one_left bot_le le_top
    have : IsFinite ((∏ i ∈ s, I i).subschemeι ≫ f) := by
      rw [← Scheme.IdealSheafData.inclusion_subschemeι hle, Category.assoc]
      infer_instance
    have hrel := TauCeti.isRelativeEffectiveCartier_prod
      (fun i hi ↦ hI i (Finset.mem_insert_of_mem hi))
    rw [Finset.prod_insert ha, Finset.sum_insert ha,
      (hI a (Finset.mem_insert_self _ _)).finrank_mul_subschemeι_comp hrel,
      ih (fun i hi ↦ hI i (Finset.mem_insert_of_mem hi))]

variable {S X : Scheme.{u}} (f : X ⟶ S) [IsProper f] [RelativeDimensionLE 1 f]

/-- **Degrees add under addition of divisors.** On the base changes of a proper relative curve,
the sum of relative effective Cartier divisors of degrees `d` and `e` has degree `d + e`. -/
lemma mul_mem_relativeEffectiveCartierDegreeSubfunctor_obj {d e : ℕ} {T : (Over S)ᵒᵖ}
    {D E : (relativeEffectiveCartierSubfunctor f).toFunctor.obj T}
    (hD : D ∈ (relativeEffectiveCartierDegreeSubfunctor f d).obj T)
    (hE : E ∈ (relativeEffectiveCartierDegreeSubfunctor f e).obj T) :
    D * E ∈ (relativeEffectiveCartierDegreeSubfunctor f (d + e)).obj T := by
  have hrelD := (mem_relativeEffectiveCartierSubfunctor_obj_iff f).mp D.2
  have hrelE := (mem_relativeEffectiveCartierSubfunctor_obj_iff f).mp E.2
  have hrel := TauCeti.isRelativeEffectiveCartier_mul hrelD hrelE
  have := hrel.isFinite
  rw [mem_relativeEffectiveCartierDegreeSubfunctor_obj_iff] at hD hE ⊢
  -- The divisor `D * E` is cut out by the product of the ideal sheaves of `D` and `E`.
  refine (hrelD.finrank_mul_subschemeι_comp hrelE).trans ?_
  rw [hD, hE]
  rfl

/-- **The empty divisor has degree zero.** On the base changes of a proper relative curve, the
identity of the monoid of relative effective Cartier divisors lies in `Div⁰_{X/S}`. -/
lemma one_mem_relativeEffectiveCartierDegreeSubfunctor_zero_obj (T : (Over S)ᵒᵖ) :
    (1 : (relativeEffectiveCartierSubfunctor f).toFunctor.obj T) ∈
      (relativeEffectiveCartierDegreeSubfunctor f 0).obj T := by
  have hrel := (mem_relativeEffectiveCartierSubfunctor_obj_iff f).mp
    (1 : (relativeEffectiveCartierSubfunctor f).toFunctor.obj T).2
  have := hrel.flat
  have := hrel.isFinite
  rw [mem_relativeEffectiveCartierDegreeSubfunctor_obj_iff]
  funext t
  rw [Scheme.Hom.finrank_eq_zero_iff_notMem_range]
  -- The identity is cut out by the unit ideal sheaf `⊤`, whose closed subscheme is empty.
  rintro ⟨z, -⟩
  exact isEmptyElim (α := (⊤ : (pullback T.unop.hom f).IdealSheafData).subscheme) z

/-- **Degrees multiply under repeated addition.** On the base changes of a proper relative curve,
`n` times a relative effective Cartier divisor of degree `d` has degree `n * d`. -/
lemma pow_mem_relativeEffectiveCartierDegreeSubfunctor_obj {d : ℕ} {T : (Over S)ᵒᵖ}
    {D : (relativeEffectiveCartierSubfunctor f).toFunctor.obj T}
    (hD : D ∈ (relativeEffectiveCartierDegreeSubfunctor f d).obj T) (n : ℕ) :
    D ^ n ∈ (relativeEffectiveCartierDegreeSubfunctor f (n * d)).obj T := by
  induction n with
  | zero => simpa using one_mem_relativeEffectiveCartierDegreeSubfunctor_zero_obj f T
  | succ n ih =>
    rw [pow_succ, Nat.succ_mul]
    exact mul_mem_relativeEffectiveCartierDegreeSubfunctor_obj f ih hD

/-- **Degrees add over finite sums of divisors.** On the base changes of a proper relative curve,
if `D i` has degree `d i` for every `i ∈ s`, then the sum of the `D i`, written multiplicatively as
`∏ i ∈ s, D i`, has degree `∑ i ∈ s, d i`. -/
lemma prod_mem_relativeEffectiveCartierDegreeSubfunctor_obj {ι : Type*} (s : Finset ι)
    {d : ι → ℕ} {T : (Over S)ᵒᵖ} {D : ι → (relativeEffectiveCartierSubfunctor f).toFunctor.obj T}
    (hD : ∀ i ∈ s, D i ∈ (relativeEffectiveCartierDegreeSubfunctor f (d i)).obj T) :
    ∏ i ∈ s, D i ∈ (relativeEffectiveCartierDegreeSubfunctor f (∑ i ∈ s, d i)).obj T := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using one_mem_relativeEffectiveCartierDegreeSubfunctor_zero_obj f T
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha]
    exact mul_mem_relativeEffectiveCartierDegreeSubfunctor_obj f (hD a (s.mem_insert_self a))
      (ih fun i hi ↦ hD i (Finset.mem_insert_of_mem hi))

end TauCeti.AlgebraicGeometry
