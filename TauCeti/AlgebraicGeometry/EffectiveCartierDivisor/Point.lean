module

public import Mathlib.AlgebraicGeometry.Noetherian
public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Basic
public import TauCeti.AlgebraicGeometry.IdealSheaf.Stalk
import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Stalk
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import TauCeti.Algebra.Regular.SMul

/-!
# Effective Cartier divisors through a point of the local ring

An effective Cartier divisor `I` on a scheme `X` has principal stalk ideals: at every point `x`
the ideal `I_x` of the local ring `𝒪_{X,x}` is generated by a nonzerodivisor
(`AlgebraicGeometry.Scheme.IdealSheafData.IsEffectiveCartier.exists_stalkIdeal_eq_span_singleton`).
If `I_x` is the maximal ideal of `𝒪_{X,x}`, as for the ideal of a closed point, and `𝒪_{X,x}` is
noetherian, Krull's principal ideal theorem then bounds the dimension of `𝒪_{X,x}` by one. So the
ideal of a closed point of a surface, such as the origin of `𝔸²`, is not an effective Cartier
divisor on any open neighbourhood of the point.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.IsEffectiveCartier.exists_stalkIdeal_eq_span_singleton`:
  the stalk ideals of an effective Cartier divisor are generated by nonzerodivisors.
* `AlgebraicGeometry.Scheme.IdealSheafData.exists_stalkIdeal_eq_span_singleton_of_comap`: the
  same at the points of an open immersion along which `I` pulls back to an effective Cartier
  divisor.
* `AlgebraicGeometry.Scheme.IdealSheafData.ringKrullDim_stalk_le_one_of_comap`: if moreover the
  stalk ideal at such a point is the maximal ideal of a noetherian local ring, that local ring has
  dimension at most one.
-/

public section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X Y : Scheme.{u}}

/-- **The stalk ideals of an effective Cartier divisor are principal.** At every point `x`, the
ideal `I_x` of `𝒪_{X,x}` is generated by a nonzerodivisor. -/
theorem IsEffectiveCartier.exists_stalkIdeal_eq_span_singleton {I : X.IdealSheafData}
    (hI : I.IsEffectiveCartier) (x : X) :
    ∃ a : X.presheaf.stalk x, IsSMulRegular (X.presheaf.stalk x) a ∧
      I.stalkIdeal x = Ideal.span {a} := by
  obtain ⟨U, hxU, -⟩ := hI.locallyPrincipal x
  obtain ⟨a, ha, hIa⟩ := hI.exists_map_germ_eq_span_singleton U hxU
  exact ⟨a, ha, (I.stalkIdeal_eq_map U x hxU).trans hIa⟩

/-- Let `f : Y ⟶ X` be an open immersion along which `I` pulls back to an effective Cartier
divisor. Then the stalk ideal of `I` at every point of the image of `f` is generated by a
nonzerodivisor. -/
theorem exists_stalkIdeal_eq_span_singleton_of_comap {I : X.IdealSheafData} (f : Y ⟶ X)
    [IsOpenImmersion f] (hI : (I.comap f).IsEffectiveCartier) (y : Y) :
    ∃ a : X.presheaf.stalk (f y), IsSMulRegular (X.presheaf.stalk (f y)) a ∧
      I.stalkIdeal (f y) = Ideal.span {a} := by
  -- Transport the generator of the stalk ideal at `y` along the inverse of the stalk map.
  obtain ⟨b, hb, hIb⟩ := hI.exists_stalkIdeal_eq_span_singleton y
  let e : X.presheaf.stalk (f y) ≃+* Y.presheaf.stalk y :=
    (asIso (f.stalkMap y)).commRingCatIsoToRingEquiv
  refine ⟨e.symm b, (TauCeti.isSMulRegular_map_iff e.symm b).mpr hb, ?_⟩
  have h : (I.stalkIdeal (f y)).map (e : X.presheaf.stalk (f y) →+* Y.presheaf.stalk y) =
      Ideal.span {b} := by
    rw [← hIb, stalkIdeal_comap]
    rfl
  rw [← Ideal.map_of_equiv (I := I.stalkIdeal (f y)) e, h, Ideal.map_span, Set.image_singleton]
  rfl

/-- **The ideal of a point of a surface is not Cartier.** Let `f : Y ⟶ X` be an open immersion
along which `I` pulls back to an effective Cartier divisor, and `y` a point of `Y` at which the
stalk ideal of `I` is the maximal ideal of the noetherian local ring `𝒪_{X,f(y)}`. Then
`𝒪_{X,f(y)}` has Krull dimension at most one, by Krull's principal ideal theorem. -/
theorem ringKrullDim_stalk_le_one_of_comap {I : X.IdealSheafData} (f : Y ⟶ X) [IsOpenImmersion f]
    (hI : (I.comap f).IsEffectiveCartier) (y : Y)
    [IsNoetherianRing (X.presheaf.stalk (f y))]
    (hy : I.stalkIdeal (f y) = maximalIdeal (X.presheaf.stalk (f y))) :
    ringKrullDim (X.presheaf.stalk (f y)) ≤ 1 := by
  obtain ⟨a, -, ha⟩ := exists_stalkIdeal_eq_span_singleton_of_comap f hI y
  rw [hy] at ha
  have hna : ¬ IsUnit a := (mem_maximalIdeal a).mp (ha ▸ Ideal.mem_span_singleton_self a)
  rw [← maximalIdeal_height_eq_ringKrullDim, ha]
  exact_mod_cast Ideal.height_span_singleton_le_one hna

end AlgebraicGeometry.Scheme.IdealSheafData
