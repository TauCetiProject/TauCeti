module

public import TauCeti.AlgebraicGeometry.AffineScheme.Factorial
public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Stalk

/-!
# Effective Cartier complements of affine opens

On a separated integral locally Noetherian scheme with factorial local rings, the reduced
complement of a nonempty affine open is an effective Cartier divisor. Its stalk ideals are
generated by nonzero elements. The criterion
`Scheme.IdealSheafData.isEffectiveCartier_of_exists_map_germ_eq_span_singleton` turns these
stalk equations into regular equations on affine neighbourhoods.

This supplies Cartier complements for translated affine covers in projectivity arguments
for algebraic groups.

## References

* The Stacks Project, Tag 0BCW.
-/

public section

universe u

open CategoryTheory TopologicalSpace Opposite

namespace AlgebraicGeometry

private theorem exists_ne_zero_map_vanishingIdeal_compl_eq_span (R : CommRingCat.{u}) [IsDomain R]
    [IsNoetherianRing R] {U : (Spec R).Opens} (hW : IsAffineOpen U)
    (hne : (U : Set (Spec R)).Nonempty) (prime : Ideal R) [prime.IsPrime] (S : Type u) [CommRing S]
    [Algebra R S] [IsLocalization.AtPrime S prime] [UniqueFactorizationMonoid S] :
    ∃ a : S, a ≠ 0 ∧
      (PrimeSpectrum.vanishingIdeal (U : Set (Spec R))ᶜ).map
        (algebraMap R S) = Ideal.span {a} := by
  have : IsDomain S := IsLocalization.isDomain_of_atPrime S prime
  have : IsNoetherianRing S := IsLocalization.isNoetherianRing prime.primeCompl S inferInstance
  let ringMap : R ⟶ CommRingCat.of S := CommRingCat.ofHom (algebraMap R S)
  have hinj : Function.Injective (algebraMap R S) :=
    IsLocalization.injective S prime.primeCompl_le_nonZeroDivisors
  obtain ⟨a, hf0, hf⟩ :=
    IsAffineOpen.exists_vanishingIdeal_compl_eq_span_singleton (CommRingCat.of S)
    (hW.preimage (Spec.map ringMap)) ⟨⟨⊥, Ideal.isPrime_bot⟩,
      PrimeSpectrum.mem_of_isOpen_of_asIdeal_eq_bot U.isOpen hne
        (Ideal.comap_bot_of_injective _ hinj)⟩
  have hf' : (PrimeSpectrum.vanishingIdeal (U : Set (Spec R))ᶜ).map
      (algebraMap R S) = Ideal.span {a} := by
    have hz := PrimeSpectrum.zeroLocus_vanishingIdeal_compl_of_isOpen U.isOpen
    have hpre : (Spec.map ringMap ⁻¹ᵁ U : Set (Spec (.of S)))ᶜ =
        PrimeSpectrum.comap (algebraMap R S) ⁻¹'
          PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal (U : Set (Spec R))ᶜ) := by
      -- On points `Spec.map ringMap` is contraction along `algebraMap R S`, and
      -- preimages commute with complements.
      exact congrArg (fun Z ↦ PrimeSpectrum.comap (algebraMap R S) ⁻¹' Z) hz.symm
    calc
      _ = ((PrimeSpectrum.vanishingIdeal (U : Set (Spec R))ᶜ).map
          (algebraMap R S)).radical :=
        (congrArg (Ideal.map (algebraMap R S))
          (PrimeSpectrum.isRadical_vanishingIdeal _).radical.symm).trans
            (IsLocalization.map_radical prime.primeCompl S
              (PrimeSpectrum.vanishingIdeal (U : Set (Spec R))ᶜ))
      _ = PrimeSpectrum.vanishingIdeal
          (PrimeSpectrum.comap (algebraMap R S) ⁻¹'
            PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal (U : Set (Spec R))ᶜ)) := by
        rw [PrimeSpectrum.preimage_comap_zeroLocus, ← PrimeSpectrum.zeroLocus_span,
          ← Ideal.map, PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical]
      _ = _ := (congrArg PrimeSpectrum.vanishingIdeal hpre.symm).trans hf
  exact ⟨a, hf0, hf'⟩

/-- The reduced complement of a nonempty affine open on a separated integral locally
Noetherian scheme with factorial local rings is an effective Cartier divisor. -/
@[stacks 0BCW]
theorem Scheme.isEffectiveCartier_vanishingIdeal_compl_of_isAffineOpen
    (X : Scheme.{u}) [IsLocallyNoetherian X]
    [X.IsSeparated] [IsIntegral X]
    (hX : ∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x))
    {U : X.Opens} (hU : IsAffineOpen U) (hne : (U : Set X).Nonempty) :
    (IdealSheafData.vanishingIdeal
      ⟨(U : Set X)ᶜ, U.isOpen.isClosed_compl⟩).IsEffectiveCartier := by
  refine IdealSheafData.isEffectiveCartier_of_exists_map_germ_eq_span_singleton fun x ↦ ?_
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
  have : Nonempty V := ⟨⟨x, hxV⟩⟩
  have : IsAffineHom hV.fromSpec := IsAffineHom.of_comp hV.fromSpec (Limits.terminal.from X)
  have hWne : (hV.fromSpec ⁻¹ᵁ U : Set (Spec Γ(X, V))).Nonempty := by
    obtain ⟨z, hzU, hzV⟩ := nonempty_preirreducible_inter U.isOpen V.isOpen hne ⟨x, hxV⟩
    obtain ⟨z', rfl⟩ : z ∈ Set.range hV.fromSpec := hV.range_fromSpec ▸ hzV
    exact ⟨z', hzU⟩
  have := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
  have := hV.isLocalization_stalk ⟨x, hxV⟩
  have := hX x
  let P := (hV.primeIdealOf ⟨x, hxV⟩).asIdeal
  have : UniqueFactorizationMonoid (Localization.AtPrime P) :=
    (IsLocalization.algEquiv P.primeCompl (X.presheaf.stalk x)
      (Localization.AtPrime P)).toMulEquiv.uniqueFactorizationMonoid inferInstance
  obtain ⟨a, ha, hgen⟩ := exists_ne_zero_map_vanishingIdeal_compl_eq_span Γ(X, V)
    (hU.preimage hV.fromSpec) hWne P (Localization.AtPrime P)
  have hideal : (IdealSheafData.vanishingIdeal
      ⟨(U : Set X)ᶜ, U.isOpen.isClosed_compl⟩).ideal ⟨V, hV⟩ =
      PrimeSpectrum.vanishingIdeal (hV.fromSpec ⁻¹' (U : Set X))ᶜ := by
    rw [IdealSheafData.vanishingIdeal_ideal, Closeds.coe_mk]
    -- Both affine-open presentations use `hV.fromSpec`; inverse images commute with complements.
    rfl
  refine ⟨⟨V, hV⟩, hxV, ?_⟩
  apply X.exists_map_germ_eq_span_singleton_of_localizationAtPrime
    ⟨V, hV⟩ hxV P rfl (IsSMulRegular.of_ne_zero ha)
  rw [hideal]
  convert hgen using 1
  -- The affine-open subtype and its underlying open give the same localization map.
  rfl

end AlgebraicGeometry
