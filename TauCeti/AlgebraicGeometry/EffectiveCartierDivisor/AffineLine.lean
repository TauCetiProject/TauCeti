module

public import Mathlib.RingTheory.IsAdjoinRoot
public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Relative

/-!
# Monic equations for divisors on the relative affine line

A monic polynomial over an arbitrary ring cuts out a relative effective Cartier divisor on
`Spec R[X]` over `Spec R`. Its closed subscheme is finite free of degree equal to the degree of
the polynomial. Lower coefficients give distinct divisors, and arbitrary change of the
coefficient ring pulls back the divisor by applying that homomorphism to each coefficient.

Together with the finite free quotient chart, these are the equations and base-change rules
for parameterizing divisors on the affine line. No reducedness, characteristic, or
separability assumption is imposed, and a constant monic equation gives the empty divisor.

## References

* The Stacks Project, *Hilbert scheme of points*, Section 44.2, Tag 0B94.
* The Stacks Project, *Effective Cartier divisors*, Tag 01WQ.
-/

public section

open AlgebraicGeometry CategoryTheory Polynomial

universe u

namespace Polynomial

variable {R : Type u} [CommRing R]

/-- The ideal sheaf of the zero scheme of a polynomial on `Spec R[X]`, using the closed
immersion `Spec (R[X]/(p)) ⟶ Spec R[X]`. -/
noncomputable def zeroIdealSheaf (p : R[X]) : (Spec (.of R[X])).IdealSheafData :=
  (Spec.map (CommRingCat.ofHom (AdjoinRoot.mk p))).ker

/-- The zero ideal sheaf is generated by the polynomial, transported to global sections. -/
lemma zeroIdealSheaf_eq_ofIdealTop (p : R[X]) :
    p.zeroIdealSheaf = Scheme.IdealSheafData.ofIdealTop
      ((Ideal.span {p}).map (Scheme.ΓSpecIso (.of R[X])).inv.hom) := by
  rw [zeroIdealSheaf, Scheme.Hom.ker_Spec_map]
  congr 2
  exact (AdjoinRoot.isAdjoinRoot p).ker_map

/-- The zero polynomial defines the whole affine line. -/
@[simp]
lemma zeroIdealSheaf_zero : (0 : R[X]).zeroIdealSheaf = ⊥ := by
  simp only [zeroIdealSheaf_eq_ofIdealTop, Ideal.span_singleton_zero, Ideal.map_bot]
  exact (Scheme.IdealSheafData.equivOfIsAffine (X := Spec (.of R[X]))).symm.map_zero

/-- The unit polynomial defines the empty divisor. -/
@[simp]
lemma zeroIdealSheaf_one : (1 : R[X]).zeroIdealSheaf = ⊤ := by
  simp only [zeroIdealSheaf_eq_ofIdealTop, Ideal.span_singleton_one, Ideal.map_top]
  exact (Scheme.IdealSheafData.equivOfIsAffine (X := Spec (.of R[X]))).symm.toOrderIso.map_top

/-- Multiplying equations multiplies their zero ideal sheaves, adding the corresponding
effective Cartier divisors when the equations are regular. -/
@[simp]
lemma zeroIdealSheaf_mul (p q : R[X]) :
    (p * q).zeroIdealSheaf = p.zeroIdealSheaf * q.zeroIdealSheaf := by
  simp only [zeroIdealSheaf_eq_ofIdealTop, ← Ideal.span_singleton_mul_span_singleton,
    Ideal.map_mul, Scheme.IdealSheafData.ofIdealTop_mul]

/-- The closed subscheme defined by a polynomial is its affine quotient scheme. -/
noncomputable def zeroSchemeIsoAdjoinRoot (p : R[X]) :
    p.zeroIdealSheaf.subscheme ≅ Spec (.of (AdjoinRoot p)) := by
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom (AdjoinRoot.mk p))) :=
    IsClosedImmersion.spec_of_surjective _ AdjoinRoot.mk_surjective
  exact (asIso (Spec.map (CommRingCat.ofHom (AdjoinRoot.mk p))).toImage).symm

/-- The quotient-scheme identification preserves the closed immersion in the affine line. -/
@[reassoc (attr := simp)]
lemma zeroSchemeIsoAdjoinRoot_inv_subschemeι (p : R[X]) :
    p.zeroSchemeIsoAdjoinRoot.inv ≫ p.zeroIdealSheaf.subschemeι =
      Spec.map (CommRingCat.ofHom (AdjoinRoot.mk p)) := by
  simp only [zeroSchemeIsoAdjoinRoot, Iso.symm_inv, asIso_hom,
    zeroIdealSheaf, Scheme.Hom.toImage_imageι]

private lemma zeroSchemeIsoAdjoinRoot_inv_comp (p : R[X]) :
    p.zeroSchemeIsoAdjoinRoot.inv ≫ p.zeroIdealSheaf.subschemeι ≫
      Spec.map (CommRingCat.ofHom (algebraMap R R[X])) =
        Spec.map (CommRingCat.ofHom (algebraMap R (AdjoinRoot p))) := by
  rw [zeroSchemeIsoAdjoinRoot_inv_subschemeι_assoc, ← Spec.map_comp]
  -- The algebra map to the quotient is the composite of the coefficient embedding and
  -- the polynomial quotient projection.
  rfl

/-- A monic equation cuts out a relative effective Cartier divisor on the affine line. -/
theorem Monic.isRelativeEffectiveCartier_zeroIdealSheaf {p : R[X]} (hp : p.Monic) :
    p.zeroIdealSheaf.IsRelativeEffectiveCartier
      (Spec.map (CommRingCat.ofHom (algebraMap R R[X]))) := by
  rw [Scheme.IdealSheafData.isRelativeEffectiveCartier_iff]
  refine ⟨?_, ?_⟩
  · rw [zeroIdealSheaf_eq_ofIdealTop, Ideal.map_span, Set.image_singleton]
    apply Scheme.IdealSheafData.isEffectiveCartier_ofIdealTop_span_singleton
    intro U
    exact (isAffineOpen_top _).isSMulRegular_map le_top
      (Scheme.isSMulRegular_ΓSpecIso_inv hp.isRegular.left.isSMulRegular)
  · have := hp.free_adjoinRoot
    have hflat : Flat (Spec.map (CommRingCat.ofHom (algebraMap R (AdjoinRoot p)))) :=
      Flat.SpecMap_iff.mpr <|
        (RingHom.flat_algebraMap_iff (R := R) (S := AdjoinRoot p)).mpr inferInstance
    rw [← zeroSchemeIsoAdjoinRoot_inv_comp] at hflat
    let := hflat
    rw [← p.zeroSchemeIsoAdjoinRoot.hom_inv_id_assoc
      (p.zeroIdealSheaf.subschemeι ≫ Spec.map (CommRingCat.ofHom (algebraMap R R[X])))]
    infer_instance

/-- The zero scheme of a monic polynomial is finite over the coefficient ring. -/
theorem Monic.isFinite_zeroIdealSheaf {p : R[X]} (hp : p.Monic) :
    IsFinite (p.zeroIdealSheaf.subschemeι ≫
      Spec.map (CommRingCat.ofHom (algebraMap R R[X]))) := by
  have := hp.finite_adjoinRoot
  have hfinite : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap R (AdjoinRoot p)))) :=
    (IsFinite.SpecMap_iff _).mpr <| RingHom.finite_algebraMap.mpr inferInstance
  rw [← zeroSchemeIsoAdjoinRoot_inv_comp] at hfinite
  let := hfinite
  rw [← p.zeroSchemeIsoAdjoinRoot.hom_inv_id_assoc
    (p.zeroIdealSheaf.subschemeι ≫ Spec.map (CommRingCat.ofHom (algebraMap R R[X])))]
  infer_instance

/-- The zero scheme of a monic polynomial has constant degree equal to its polynomial degree
over the coefficient ring. -/
theorem Monic.finrank_zeroIdealSheaf {p : R[X]} (hp : p.Monic) [Nontrivial R] :
    (p.zeroIdealSheaf.subschemeι ≫
      Spec.map (CommRingCat.ofHom (algebraMap R R[X]))).finrank = fun _ ↦ p.natDegree := by
  have := hp.free_adjoinRoot
  have := hp.finite_adjoinRoot
  have := hp.isRelativeEffectiveCartier_zeroIdealSheaf.flat
  have := hp.isFinite_zeroIdealSheaf
  rw [← Scheme.Hom.finrank_comp_left_of_isIso p.zeroSchemeIsoAdjoinRoot.inv,
    zeroSchemeIsoAdjoinRoot_inv_comp]
  funext x
  have hrank : Module.finrank R (AdjoinRoot p) = p.natDegree := (AdjoinRoot.powerBasis' hp).finrank
  have hlocal : Module.rankAtStalk (AdjoinRoot p) x = Module.finrank R (AdjoinRoot p) :=
    congrFun (Module.rankAtStalk_eq_finrank_of_free (R := R) (M := AdjoinRoot p)) x
  exact (Scheme.Hom.finrank_SpecMap_algebraMap R (AdjoinRoot p) x).trans (hlocal.trans hrank)

/-- Extension of the coefficient ring pulls back the zero scheme by mapping the polynomial's
coefficients. The coefficient homomorphism need not be flat or injective. -/
@[simp]
lemma zeroIdealSheaf_map {S : Type u} [CommRing S] (φ : R →+* S) (p : R[X]) :
    p.zeroIdealSheaf.comap (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom φ))) =
      (p.map φ).zeroIdealSheaf := by
  simp only [zeroIdealSheaf_eq_ofIdealTop, Scheme.IdealSheafData.comap_ofIdealTop,
    Ideal.map_span, Set.image_singleton]
  have h := congr($(Scheme.ΓSpecIso_inv_naturality
    (CommRingCat.ofHom (Polynomial.mapRingHom φ))).hom p)
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
    Polynomial.coe_mapRingHom] at h
  exact congrArg (fun a ↦ Scheme.IdealSheafData.ofIdealTop (Ideal.span {a})) h.symm

/-- Two monic polynomials define the same zero scheme on the relative affine line exactly
when they agree, without a fixed-degree or reducedness assumption. -/
@[simp]
theorem Monic.zeroIdealSheaf_eq_iff {p q : R[X]} (hp : p.Monic) (hq : q.Monic) :
    p.zeroIdealSheaf = q.zeroIdealSheaf ↔ p = q := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ rfl⟩
  nontriviality R
  have htop := congrArg Scheme.IdealSheafData.equivOfIsAffine h
  simp only [Polynomial.zeroIdealSheaf_eq_ofIdealTop,
    Scheme.IdealSheafData.equivOfIsAffine_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
    homOfLE_refl, CategoryTheory.op_id, CategoryTheory.Functor.map_id,
    CommRingCat.hom_id, Ideal.map_id] at htop
  have hmap := congrArg (Ideal.map (Scheme.ΓSpecIso (.of R[X])).hom.hom) htop
  have hid : (Scheme.ΓSpecIso (.of R[X])).hom.hom.comp
      (Scheme.ΓSpecIso (.of R[X])).inv.hom = RingHom.id R[X] := by
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_id] using
      congrArg CommRingCat.Hom.hom (Scheme.ΓSpecIso (.of R[X])).inv_hom_id
  simp only [Ideal.map_map, hid, Ideal.map_id] at hmap
  have hpq : p ∣ q := Ideal.span_singleton_le_span_singleton.mp hmap.symm.le
  have hqp : q ∣ p := Ideal.span_singleton_le_span_singleton.mp hmap.le
  exact eq_of_monic_of_dvd_of_natDegree_le hq hp hqp (hp.natDegree_le_of_dvd hq.ne_zero hpq)

end Polynomial
