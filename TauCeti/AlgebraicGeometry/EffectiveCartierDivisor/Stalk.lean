module

public import Mathlib.AlgebraicGeometry.Noetherian
public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Basic
import Mathlib.RingTheory.Flat.Localization
import TauCeti.RingTheory.Localization.Away.Basic
import TauCeti.RingTheory.Localization.Ideal

/-!
# Effective Cartier divisors on locally noetherian schemes are detected on stalks

An ideal sheaf `I` on a scheme `X` is an effective Cartier divisor when it is generated by a
nonzerodivisor near every point. This file compares this with the corresponding condition on the
local rings `𝒪_{X,x}`, where the stalk of `I` at a point `x` of an affine open `U` is the ideal
of `𝒪_{X,x}` generated by the image of `I(U)`.

On an arbitrary scheme, the stalks of an effective Cartier divisor are generated by
nonzerodivisors, since `𝒪_{X,x}` is a flat localization of `Γ(X, U)`. On a locally noetherian
scheme the converse holds: an equation of the stalk can be taken in `I(U)`, and it generates `I`
and is a nonzerodivisor on a basic open neighbourhood of `x` in `U`
(`Ideal.exists_notMem_smul_le_span_singleton_of_map_eq`).

This is how a divisor is recognised from local algebra at a single point, for instance from the
local rings of a fibre in the fibrewise criterion for relative effective Cartier divisors.

## Main results

* `Scheme.IdealSheafData.IsEffectiveCartier.exists_map_germ_eq_span_singleton`: the stalk of an
  effective Cartier divisor is generated by a nonzerodivisor.
* `Scheme.IdealSheafData.isEffectiveCartier_of_exists_map_germ_eq_span_singleton`: on a locally
  noetherian scheme, an ideal sheaf whose stalks are generated by nonzerodivisors is an effective
  Cartier divisor.
* `Scheme.IdealSheafData.isEffectiveCartier_iff_forall_exists_map_germ_eq_span_singleton`: the
  resulting characterization of effective Cartier divisors on locally noetherian schemes.

## References

* The Stacks Project, *Divisors*, Section *Effective Cartier divisors*: on a locally noetherian
  scheme, a closed subscheme is an effective Cartier divisor if and only if its ideal is generated
  by a nonzerodivisor in every local ring.
-/

public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- **The stalks of an effective Cartier divisor are principal.** If `I` is an effective Cartier
divisor, then at every point `x` of an affine open `U` the ideal of the local ring `𝒪_{X,x}`
generated by `I(U)` is generated by a nonzerodivisor. -/
theorem IsEffectiveCartier.exists_map_germ_eq_span_singleton {I : X.IdealSheafData}
    (hI : I.IsEffectiveCartier) (U : X.affineOpens) {x : X} (hx : x ∈ U.1) :
    ∃ a : X.presheaf.stalk x, IsSMulRegular (X.presheaf.stalk x) a ∧
      (I.ideal U).map (X.presheaf.germ U x hx).hom = Ideal.span {a} := by
  obtain ⟨V, hVU, hxV, b, hb, hVb⟩ := hI.exists_eq_span_singleton_le U.1 hx
  -- The stalk is a localization of `Γ(X, V)` through the germ map, hence flat over it.
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
  have := V.2.isLocalization_stalk ⟨x, hxV⟩
  have := IsLocalization.flat (X.presheaf.stalk x)
    (V.2.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl
  refine ⟨X.presheaf.germ V x hxV b, hb.of_flat, ?_⟩
  rw [← X.presheaf.germ_res (homOfLE hVU) x hxV, CommRingCat.hom_comp, ← Ideal.map_map,
    I.map_ideal' (U := V) (V := U) (homOfLE hVU).op, hVb, Ideal.map_span, Set.image_singleton]

/-- **Effective Cartier divisors on locally noetherian schemes are detected on stalks.** Let `I`
be an ideal sheaf on a locally noetherian scheme. If every point `x` lies in an affine open `U`
such that the ideal of `𝒪_{X,x}` generated by `I(U)` is generated by a nonzerodivisor, then `I`
is an effective Cartier divisor. -/
theorem isEffectiveCartier_of_exists_map_germ_eq_span_singleton [IsLocallyNoetherian X]
    {I : X.IdealSheafData}
    (h : ∀ x : X, ∃ (U : X.affineOpens) (hx : x ∈ U.1) (a : X.presheaf.stalk x),
      IsSMulRegular (X.presheaf.stalk x) a ∧
        (I.ideal U).map (X.presheaf.germ U x hx).hom = Ideal.span {a}) :
    I.IsEffectiveCartier := by
  refine (isEffectiveCartier_iff I).mpr fun x ↦ ?_
  obtain ⟨U, hx, a, ha, hIa⟩ := h x
  -- The stalk is the localization of the noetherian ring `Γ(X, U)` at the prime of `x`.
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hx⟩
  have := U.2.isLocalization_stalk ⟨x, hx⟩
  have : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian U
  -- Write `a = t / s` with `t ∈ I(U)`; then the image of `t` is also a generator.
  obtain ⟨⟨⟨t, htI⟩, s⟩, hts⟩ := (IsLocalization.mem_map_algebraMap_iff
    (U.2.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl (X.presheaf.stalk x)).mp
    (hIa ▸ Ideal.mem_span_singleton_self a)
  have hs : IsUnit (algebraMap Γ(X, U) (X.presheaf.stalk x) s) :=
    IsLocalization.map_units (X.presheaf.stalk x) s
  have hIt : (I.ideal U).map (algebraMap Γ(X, U) (X.presheaf.stalk x)) =
      Ideal.span {algebraMap Γ(X, U) (X.presheaf.stalk x) t} := by
    rw [← hts, Ideal.span_singleton_mul_right_unit hs]
    exact hIa
  have ht : IsSMulRegular (X.presheaf.stalk x) (algebraMap Γ(X, U) (X.presheaf.stalk x) t) :=
    hts ▸ ha.mul (hs.isSMulRegular _)
  -- Spread the equation of the stalk to a basic open `D(r) ∋ x` of `U`.
  obtain ⟨r, hrP, hrI, hrt⟩ := Ideal.exists_notMem_smul_le_span_singleton_of_map_eq
    (P := (U.2.primeIdealOf ⟨x, hx⟩).asIdeal) _ hIt ht
  have := U.2.isLocalization_basicOpen r
  refine ⟨X.affineBasicOpen r, ?_, _, (IsLocalization.Away.isSMulRegular_algebraMap hrt :
    IsSMulRegular Γ(X, X.basicOpen r) (algebraMap Γ(X, U) _ t)), ?_⟩
  · exact (X.mem_basicOpen r x hx).mpr
      ((IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk x) _ r).mpr hrP)
  · rw [← I.map_ideal_basicOpen]
    exact Ideal.map_algebraMap_away_eq_span_singleton htI hrI

/-- **Stalkwise characterization of effective Cartier divisors.** On a locally noetherian scheme,
an ideal sheaf `I` is an effective Cartier divisor if and only if, at every point `x` of every
affine open `U`, the ideal of the local ring `𝒪_{X,x}` generated by `I(U)` is generated by a
nonzerodivisor. -/
theorem isEffectiveCartier_iff_forall_exists_map_germ_eq_span_singleton [IsLocallyNoetherian X]
    (I : X.IdealSheafData) :
    I.IsEffectiveCartier ↔ ∀ (U : X.affineOpens) (x : X) (hx : x ∈ U.1),
      ∃ a : X.presheaf.stalk x, IsSMulRegular (X.presheaf.stalk x) a ∧
        (I.ideal U).map (X.presheaf.germ U x hx).hom = Ideal.span {a} := by
  refine ⟨fun hI U x hx ↦ hI.exists_map_germ_eq_span_singleton U hx, fun h ↦
    isEffectiveCartier_of_exists_map_germ_eq_span_singleton fun x ↦ ?_⟩
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  exact ⟨⟨U, hU⟩, hxU, h ⟨U, hU⟩ x hxU⟩

end AlgebraicGeometry.Scheme.IdealSheafData
