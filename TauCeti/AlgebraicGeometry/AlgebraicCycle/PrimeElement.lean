module

public import TauCeti.AlgebraicGeometry.AlgebraicCycle.Principal
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.UniqueFactorizationDomain.Ideal

/-!
# The principal cycle of a prime element

Let `R` be a Noetherian domain and `p ∈ R` a prime element. The ideal `(p)` is a point of
`Spec R` of codimension one (`AlgebraicCycle.coheight_eq_one_of_prime`, by Krull's principal ideal
theorem), and the principal cycle of `p`, viewed as a rational function on `Spec R`, is the
point cycle of `(p)` (`AlgebraicCycle.div_eq_single_of_prime`): `p` is a uniformizer of the local
ring at `(p)`, and a unit in the local ring at every other codimension-one point.

If `R` is moreover a unique factorization domain, every codimension-one point of `Spec R` is of
this form (`Ideal.IsPrime.exists_mem_prime_of_ne_bot`), so every Weil divisor on `Spec R` is
principal and the divisor class group of `Spec R` is trivial
(`SchemeWeilDivisor.subsingleton_classGroup_of_uniqueFactorizationMonoid`).
-/

public section

open _root_.AlgebraicGeometry Order CategoryTheory

universe u

namespace TauCeti.AlgebraicGeometry

variable {R : CommRingCat.{u}}

namespace AlgebraicCycle

/-- The maximal ideal of the local ring of `Spec R` at `x` is generated by the image of a
generator of `x`. -/
lemma maximalIdeal_stalk_eq_span {x : Spec R} {p : R} (hx : x.asIdeal = Ideal.span {p}) :
    IsLocalRing.maximalIdeal ((Spec R).presheaf.stalk x) =
      Ideal.span {StructureSheaf.toStalk R x p} := by
  let _ : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
  have := x.isPrime
  have : IsLocalization.AtPrime ((Spec R).presheaf.stalk x) x.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk R x
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal x.asIdeal, hx, Ideal.map_span,
    Set.image_singleton]
  rfl

variable [IsDomain R]

/-- The algebra map `R → K(Spec R)` factors through the stalk at every point of `Spec R`. -/
lemma algebraMap_stalk_toStalk (x : Spec R) (r : R) :
    algebraMap ((Spec R).presheaf.stalk x) (Spec R).functionField
        (StructureSheaf.toStalk R x r) = algebraMap R (Spec R).functionField r := by
  rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra]
  exact StructureSheaf.toStalk_stalkSpecializes_apply _ r

variable [IsNoetherianRing R] {p : R}

/-- The point `(p)` of `Spec R` of a prime element `p` of a Noetherian domain has codimension one:
its height is at least one since `p ≠ 0`, and at most one by Krull's principal ideal theorem. -/
lemma coheight_eq_one_of_prime (hp : Prime p) {x : Spec R} (hx : x.asIdeal = Ideal.span {p}) :
    coheight x = 1 := by
  rw [← idealHeight_eq_coheight, hx]
  have : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp.ne_zero).mpr hp
  refine le_antisymm ?_ (Ideal.one_le_height_span_singleton_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero hp.ne_zero))
  refine Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {p}) _ ?_
  rw [Ideal.minimalPrimes_eq_subsingleton_self]
  exact Set.mem_singleton _

omit [IsNoetherianRing R] in
/-- A codimension-one point of `Spec R` containing a prime element `p` is the point `(p)`. -/
lemma asIdeal_eq_span_of_prime (hp : Prime p) {y : Spec R} (hy : coheight y = 1)
    (hpy : p ∈ y.asIdeal) : y.asIdeal = Ideal.span {p} :=
  have := y.isPrime
  Ideal.eq_span_singleton_of_height_eq_one (by rw [idealHeight_eq_coheight, hy]) hpy hp

/-- **The principal cycle of a prime element.** On the spectrum of a Noetherian domain `R`, the
principal cycle of a prime element `p`, viewed as a rational function, is the point cycle `[x]` of
the point `x = (p)`: `p` generates the maximal ideal of the local ring at `x`, and it is a unit in
the local ring at every other codimension-one point. -/
theorem div_eq_single_of_prime [DecidableEq (Spec R)] (hp : Prime p) {x : Spec R}
    (hx : x.asIdeal = Ideal.span {p}) {r : (Spec R).functionFieldˣ}
    (hr : (r : (Spec R).functionField) = algebraMap R (Spec R).functionField p) :
    div r = Function.locallyFinsuppWithin.single x 1 := by
  ext y
  rw [div_apply, Function.locallyFinsuppWithin.single_apply, hr]
  by_cases hy : coheight y = 1
  · have hb : StructureSheaf.toStalk R y p ≠ 0 := fun h ↦ IsFractionRing.to_map_eq_zero_iff.not.mpr
      hp.ne_zero (by rw [← algebraMap_stalk_toStalk y, h]; exact map_zero _)
    rw [← algebraMap_stalk_toStalk y]
    split_ifs with h
    · subst h
      refine Scheme.ord_algebraMap_stalk_eq_one hy (specializes_refl _) ?_
      rw [TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.hom_id, Ideal.comap_id]
      exact maximalIdeal_stalk_eq_span hx
    · rw [Scheme.ord_algebraMap_stalk_eq_zero_iff hy (specializes_refl _) hb,
        TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.hom_id, Ideal.comap_id]
      let _ : Algebra R ((Spec R).presheaf.stalk y) := StructureSheaf.stalkAlgebra R y
      have := y.isPrime
      have : IsLocalization.AtPrime ((Spec R).presheaf.stalk y) y.asIdeal :=
        StructureSheaf.IsLocalization.to_stalk R y
      exact fun hmem ↦ h (PrimeSpectrum.ext ((asIdeal_eq_span_of_prime hp hy
        ((IsLocalization.AtPrime.to_map_mem_maximal_iff _ y.asIdeal p).mp hmem)).trans hx.symm))
  · have hyx : y ≠ x := by
      rintro rfl
      exact hy (coheight_eq_one_of_prime hp hx)
    rw [Scheme.ord_eq_zero_of_coheight_neq_one hy, ite_eq_right hyx]

end AlgebraicCycle

namespace SchemeWeilDivisor

open WeilDivisor

variable [IsDomain R] [IsNoetherianRing R]

/-- On the spectrum of a Noetherian domain, the principal Weil divisor of a prime element `p` is
the point divisor of the point `(p)`. -/
theorem principalDivisor_eq_ofPoint_of_prime {p : R} (hp : Prime p) {x : Spec R}
    (hx : x.asIdeal = Ideal.span {p}) {r : (Spec R).functionFieldˣ}
    (hr : (r : (Spec R).functionField) = algebraMap R (Spec R).functionField p) :
    (OrderSystem.ofScheme (Spec R)).principalDivisor (Additive.ofMul r) =
      ofPoint ⟨x, AlgebraicCycle.coheight_eq_one_of_prime hp hx⟩ := by
  classical
  apply toAlgebraicCycle_injective
  rw [AlgebraicCycle.toAlgebraicCycle_principalDivisor,
    AlgebraicCycle.div_eq_single_of_prime hp hx hr]
  ext y
  rw [Function.locallyFinsuppWithin.single_apply]
  by_cases hy : coheight y = 1
  · rw [toAlgebraicCycle_apply _ ⟨y, hy⟩]
    split_ifs with h
    · subst h
      exact (coeff_ofPoint_self _).symm
    · exact (coeff_ofPoint_of_ne fun h' ↦ h (congrArg Subtype.val h')).symm
  · have hyx : y ≠ x := by
      rintro rfl
      exact hy (AlgebraicCycle.coheight_eq_one_of_prime hp hx)
    rw [toAlgebraicCycle_apply_of_coheight_ne_one _ _ hy, ite_eq_right hyx]

variable [UniqueFactorizationMonoid R]

/-- On the spectrum of a Noetherian unique factorization domain, the point divisor of every
codimension-one point is principal: the point is `(p)` for a prime element `p`. -/
theorem ofPoint_mem_principalSubgroup (x : CodimensionOnePoint (Spec R)) :
    ofPoint x ∈ (OrderSystem.ofScheme (Spec R)).principalSubgroup := by
  have h1 : x.val.asIdeal.height = 1 := by rw [idealHeight_eq_coheight]; exact x.property
  obtain ⟨p, hpx, hp⟩ :=
    x.val.isPrime.exists_mem_prime_of_ne_bot (Ideal.ne_bot_of_height_eq_one h1)
  have hx := AlgebraicCycle.asIdeal_eq_span_of_prime hp x.property hpx
  exact (OrderSystem.mem_principalSubgroup _).mpr
    ⟨_, principalDivisor_eq_ofPoint_of_prime hp hx (r := Units.mk0 _
      (IsFractionRing.to_map_eq_zero_iff.not.mpr hp.ne_zero)) rfl⟩

/-- On the spectrum of a Noetherian unique factorization domain, every Weil divisor is principal.
-/
theorem principalSubgroup_eq_top :
    (OrderSystem.ofScheme (Spec R)).principalSubgroup = ⊤ := by
  refine (AddSubgroup.eq_top_iff' _).mpr fun D ↦ ?_
  induction D using Finsupp.induction_linear with
  | zero => exact zero_mem _
  | add D E hD hE => exact add_mem hD hE
  | single x n =>
    rw [single_eq_zsmul_ofPoint]
    exact zsmul_mem (ofPoint_mem_principalSubgroup x) n

/-- **The divisor class group of a unique factorization domain is trivial.** On the spectrum of a
Noetherian unique factorization domain the divisor class group `Cl(Spec R)` is trivial. -/
instance subsingleton_classGroup_of_uniqueFactorizationMonoid :
    Subsingleton (OrderSystem.ofScheme (Spec R)).ClassGroup := by
  refine ⟨fun a b ↦ ?_⟩
  induction a using QuotientAddGroup.induction_on
  induction b using QuotientAddGroup.induction_on
  rw [QuotientAddGroup.eq, principalSubgroup_eq_top]
  exact AddSubgroup.mem_top _

end SchemeWeilDivisor

end TauCeti.AlgebraicGeometry
