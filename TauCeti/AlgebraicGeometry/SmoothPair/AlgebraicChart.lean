module

public import Mathlib.RingTheory.RingHom.Etale
public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.TensorProduct.Quotient
public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import Mathlib.Algebra.MvPolynomial.Division
public import Mathlib.Algebra.Squarefree.Basic
public import TauCeti.RingTheory.Smooth.GeometricallyReduced

/-!
# Relative algebraic normal crossings charts

An algebraic normal crossings chart presents a boundary ideal as the product of distinct
coordinates of an étale map to affine space over the given field. The ideal, not merely its
vanishing locus, is retained. These charts are the algebraic input to constructing analytic
smooth pairs by analytification.

The boundary generator is a non-zero-divisor and the boundary ideal is radical, including
for charts on the zero ring. Identity charts give the coordinate hyperplane models. In
particular the zero ideal of a nonzero ring and a doubled coordinate hyperplane cannot have
such a chart.

## References

* H. Diao, K.-W. Lan, R. Liu, X. Zhu, *Logarithmic adic spaces: some foundational results*,
  §2.3, Example 2.3.17, for the coordinate-boundary description.
-/

public section

namespace TauCeti.SmoothPair

open MvPolynomial
open scoped TensorProduct

variable (K : Type*) [Field K]

/-- A relative normal crossings chart for `I`: an étale coordinate map over the specified
scalar map, with `I` generated by a product of distinct coordinates. Zero boundary
coordinates mean the unit ideal, hence empty boundary. -/
structure AlgebraicChart {R : Type*} [CommRing R] (σ : K →+* R) (I : Ideal R) where
  /-- The dimension of the affine coordinate space. -/
  n : ℕ
  /-- The number of boundary coordinates. -/
  r : ℕ
  /-- Boundary coordinates are among the affine coordinates. -/
  le : r ≤ n
  /-- The coordinate homomorphism. -/
  coord : MvPolynomial (Fin n) K →+* R
  /-- The coordinates respect the specified ground-field map. -/
  coord_comp_C : coord.comp MvPolynomial.C = σ
  /-- The coordinate homomorphism is étale. -/
  etale : coord.Etale
  /-- Equality of boundary ideals, without taking radicals. -/
  ideal_eq : I = Ideal.span {coord (∏ i : Fin r, X (Fin.castLE le i))}

/-- The coordinate hyperplane model, with the identity as coordinate homomorphism.
The body is exposed so its dimension-indexed coordinate map accepts polynomials in `Fin n`. -/
@[expose] noncomputable def modelAlgebraicChart (n r : ℕ) (hr : r ≤ n) :
    AlgebraicChart K (C : K →+* MvPolynomial (Fin n) K)
      (Ideal.span {∏ i : Fin r, X (Fin.castLE hr i)}) where
  n := n
  r := r
  le := hr
  coord := RingHom.id _
  coord_comp_C := rfl
  etale := RingHom.Etale.of_bijective Function.bijective_id
  ideal_eq := rfl

variable {K} {R : Type*} [CommRing R] {σ : K →+* R} {I : Ideal R}

/-- The model has the specified ambient dimension. -/
@[simp] theorem modelAlgebraicChart_n (n r : ℕ) (hr : r ≤ n) :
    (modelAlgebraicChart K n r hr).n = n := (rfl)

/-- The model has the specified number of boundary coordinates. -/
@[simp] theorem modelAlgebraicChart_r (n r : ℕ) (hr : r ≤ n) :
    (modelAlgebraicChart K n r hr).r = r := (rfl)

/-- The model coordinate map fixes every polynomial. -/
@[simp] theorem modelAlgebraicChart_coord (n r : ℕ) (hr : r ≤ n)
    (f : MvPolynomial (Fin n) K) : (modelAlgebraicChart K n r hr).coord f = f := (rfl)

namespace AlgebraicChart

/-- The displayed local equation of the boundary. -/
noncomputable def generator (c : AlgebraicChart K σ I) : R :=
  c.coord (∏ i : Fin c.r, X (Fin.castLE c.le i))

/-- The local equation is the product of the images of the boundary coordinates. -/
theorem generator_eq_prod (c : AlgebraicChart K σ I) :
    c.generator = ∏ i : Fin c.r, c.coord (X (Fin.castLE c.le i)) := by
  simp only [generator, map_prod]

/-- The boundary ideal is principal, with the specified coordinate-product generator. -/
theorem ideal_eq_span_generator (c : AlgebraicChart K σ I) :
    I = Ideal.span {c.generator} := c.ideal_eq

/-- Membership in the boundary ideal is divisibility by its local equation. -/
theorem mem_ideal_iff (c : AlgebraicChart K σ I) {x : R} :
    x ∈ I ↔ c.generator ∣ x := by
  simp only [c.ideal_eq_span_generator, Ideal.mem_span_singleton]

/-- A chart without boundary coordinates has empty boundary. -/
theorem ideal_eq_top_of_r_eq_zero (c : AlgebraicChart K σ I) (hr : c.r = 0) : I = ⊤ := by
  have hg : c.generator = 1 := by
    rw [c.generator_eq_prod]
    exact Finset.prod_eq_one fun i _ ↦ Fin.elim0 (hr ▸ i)
  simp only [c.ideal_eq_span_generator, hg, Ideal.span_singleton_one]

/-- The local equation is a non-zero-divisor, so the boundary is Cartier. -/
theorem generator_mem_nonZeroDivisors (c : AlgebraicChart K σ I) :
    c.generator ∈ nonZeroDivisors R := by
  let A := MvPolynomial (Fin c.n) K
  let _ := c.coord.toAlgebra
  let _ : Algebra.Etale A R := c.etale
  have hprod : (∏ i : Fin c.r, X (R := K) (Fin.castLE c.le i)) ∈ nonZeroDivisors A := by
    rw [mem_nonZeroDivisors_iff_ne_zero]
    exact Finset.prod_ne_zero_iff.mpr fun i _ ↦ X_ne_zero _
  have h := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := R) hprod
  rw [mem_nonZeroDivisors_iff_left]
  intro x hx
  apply h
  simpa only [Algebra.smul_def, c.coord.algebraMap_toAlgebra, mul_zero, generator] using hx

/-- A coordinate boundary is reduced. The coordinate product is squarefree, and its
quotient remains reduced under the étale coordinate map. -/
theorem isRadical (c : AlgebraicChart K σ I) : I.IsRadical := by
  classical
  let A := MvPolynomial (Fin c.n) K
  let J : Ideal A := Ideal.span {∏ i : Fin c.r, X (Fin.castLE c.le i)}
  have hsq : Squarefree (∏ i : Fin c.r, X (R := K) (Fin.castLE c.le i)) := by
    apply Finset.squarefree_prod_of_pairwise_isCoprime
    · intro i _ j _ hij
      apply prime_X.irreducible.isRelPrime_iff_not_dvd.mpr
      simpa only [X_dvd_X] using fun h ↦ hij ((Fin.castLE_injective c.le) h)
    · intro i _
      exact prime_X.squarefree
  have hJ : J.IsRadical := isRadical_iff_span_singleton.mp hsq.isRadical
  let _ : IsReduced (A ⧸ J) := (Ideal.isRadical_iff_quotient_reduced J).mp hJ
  let _ := c.coord.toAlgebra
  let _ : Algebra.Etale A R := c.etale
  have hred : IsReduced ((A ⧸ J) ⊗[A] R) :=
    isReduced_of_smooth (A ⧸ J) ((A ⧸ J) ⊗[A] R)
  let _ := hred
  let e := (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R J).toRingEquiv.trans
    (Algebra.TensorProduct.comm A R (A ⧸ J)).toRingEquiv
  have hquot : IsReduced (R ⧸ J.map (algebraMap A R)) :=
    isReduced_of_injective e e.injective
  have hmap : J.map (algebraMap A R) = I := by
    simp only [J, Ideal.map_span, Set.image_singleton]
    exact c.ideal_eq.symm
  rw [← hmap, Ideal.isRadical_iff_quotient_reduced]
  exact hquot

/-- A nonzero ambient ring cannot have its whole space as coordinate boundary. -/
theorem ideal_ne_bot [Nontrivial R] (c : AlgebraicChart K σ I) : I ≠ ⊥ := by
  intro hI
  have hz : c.generator = 0 := Ideal.span_singleton_eq_bot.mp
    (c.ideal_eq_span_generator.symm.trans hI)
  have h := c.generator_mem_nonZeroDivisors
  exact one_ne_zero ((mem_nonZeroDivisors_iff_left.mp h) 1 (by simp [hz]))

/-- The full boundary has no algebraic normal crossings chart on a nonzero ring. -/
instance [Nontrivial R] : IsEmpty (AlgebraicChart K σ (⊥ : Ideal R)) :=
  ⟨fun c ↦ c.ideal_ne_bot rfl⟩

end AlgebraicChart

/-- The model equation is the product of its distinct boundary coordinates. -/
@[simp] theorem generator_modelAlgebraicChart (n r : ℕ) (hr : r ≤ n) :
    (modelAlgebraicChart K n r hr).generator = ∏ i : Fin r, X (Fin.castLE hr i) := (rfl)

end TauCeti.SmoothPair
