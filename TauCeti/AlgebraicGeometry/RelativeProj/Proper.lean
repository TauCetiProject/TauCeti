module

public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.Proper
public import TauCeti.AlgebraicGeometry.RelativeProj.Basic

/-!
# Properness of the relative `Proj`

Let `A = ⨁ₙ Aₙ` be a graded algebra on a scheme `X` with quasi-coherent homogeneous components, and
let `Proj_X(A) ⟶ X` be its relative `Proj` (`CategoryTheory.CommMon.relativeProjToBase`). Over an
affine open `U` of `X` this morphism is the coefficient morphism
`Proj (⨁ n, Γ(Aₙ, U)) ⟶ Spec Γ(X, U)`, so every property of morphisms that is local on the target
can be checked on these charts
(`CategoryTheory.CommMon.relativeProjToBase_iff_forall_isAffineOpen`). Combined with the
corresponding properties of the projective spectrum of a graded ring, in
`TauCeti.AlgebraicGeometry.ProjectiveSpectrum.Proper`, this gives:

* the relative `Proj` is always separated over `X`;
* it is quasi-compact over `X` when `⨁ n, Γ(Aₙ, U)` is a finitely generated `Γ(A₀, U)`-algebra for
  every affine open `U`;
* it is locally of finite type over `X` when `A` is of finite type, that is, when `⨁ n, Γ(Aₙ, U)`
  is a finitely generated `Γ(X, U)`-algebra for every affine open `U`;
* it is proper over `X` when moreover `A₀` is finite, that is, when `Γ(A₀, U)` is a finite
  `Γ(X, U)`-module for every affine open `U`. This covers the case `A₀ = 𝒪_X` of blowups and of
  `Proj` of section algebras of invertible sheaves.

## Main results

* `CategoryTheory.CommMon.relativeProjToBase_iff_forall_isAffineOpen`: a property of morphisms that
  is local on the target holds for `Proj_X(A) ⟶ X` exactly when it holds for every chart
  `Proj (⨁ n, Γ(Aₙ, U)) ⟶ Spec Γ(X, U)`.
* `CategoryTheory.CommMon.isSeparated_relativeProjToBase`: the relative `Proj` is separated.
* `CategoryTheory.CommMon.quasiCompact_relativeProjToBase`: the relative `Proj` of an algebra of
  finite type over its degree-zero part is quasi-compact.
* `CategoryTheory.CommMon.locallyOfFiniteType_relativeProjToBase`: the relative `Proj` of an
  algebra of finite type is locally of finite type.
* `CategoryTheory.CommMon.isProper_relativeProjToBase`: the relative `Proj` of an algebra of finite
  type with finite degree-zero part is proper.

## References

* [Stacks Project, Tag 01NS, Relative Proj](https://stacks.math.columbia.edu/tag/01NS)
* R. Hartshorne, *Algebraic Geometry*, Proposition II.7.10, for the case of an algebra with
  `A₀ = 𝒪_X` generated by a coherent `A₁` over a Noetherian scheme.
-/

public section

open CategoryTheory Limits AlgebraicGeometry DirectSum

namespace CategoryTheory.CommMon

universe u

variable {X : Scheme.{u}} (A : CommMon (GradedObject ℕ X.Modules)) [∀ n, (A.X n).IsQuasicoherent]

/-- A property of morphisms that is local on the target holds for the structure morphism of the
relative `Proj` exactly when it holds for the coefficient morphism
`Proj (⨁ n, Γ(Aₙ, U)) ⟶ Spec Γ(X, U)` over every affine open `U` of `X`. -/
theorem relativeProjToBase_iff_forall_isAffineOpen (P : MorphismProperty Scheme.{u})
    [IsZariskiLocalAtTarget P] :
    P A.relativeProjToBase ↔
      ∀ U : X.Opens, IsAffineOpen U → P (Proj.toSpecCoeff (A.gradedSectionsGrading U)) := by
  rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := P) _ (iSup_affineOpens_eq_top X),
    Subtype.forall]
  refine forall₂_congr fun U hU ↦ ?_
  -- Over `U`, the chart `Proj (⨁ n, Γ(Aₙ, U))` and the preimage of `U` are both pullbacks of the
  -- structure morphism along `U ⟶ X`, so the restriction is the chart's coefficient morphism up to
  -- isomorphisms on both sides.
  have h := A.isPullback_relativeProjCover ⟨U, hU⟩
  have h' := isPullback_morphismRestrict A.relativeProjToBase U
  rw [← P.cancel_left_of_respectsIso (h.isoIsPullback _ _ h').hom,
    h.isoIsPullback_hom_fst _ _ h', P.cancel_right_of_respectsIso]

/-- **The relative `Proj` is separated** over the base. -/
instance isSeparated_relativeProjToBase : IsSeparated A.relativeProjToBase :=
  (A.relativeProjToBase_iff_forall_isAffineOpen @IsSeparated).mpr fun _ _ ↦ inferInstance

variable {A}

/-- The relative `Proj` of a graded algebra of finite type over its degree-zero part is
quasi-compact over the base. -/
theorem quasiCompact_relativeProjToBase (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.FiniteType (A.gradedSectionsGrading U 0) (⨁ n, Γ(A.X n, U))) :
    QuasiCompact A.relativeProjToBase :=
  -- Instance search cannot use Mathlib's instance `HasAffineProperty @QuasiCompact _`: its affine
  -- property is stored at a dependent function type, not at `AffineTargetMorphismProperty`, so it
  -- cannot be assigned to that out-parameter. The instance is therefore supplied explicitly.
  have : IsZariskiLocalAtTarget @QuasiCompact.{u} :=
    @HasAffineProperty.instIsZariskiLocalAtTarget _ _
      instHasAffinePropertyQuasiCompactCompactSpaceCarrierCarrierCommRingCat
  (A.relativeProjToBase_iff_forall_isAffineOpen @QuasiCompact).mpr fun U hU ↦
    have := h U hU
    inferInstance

/-- The relative `Proj` of a graded algebra of finite type is locally of finite type over the
base. -/
theorem locallyOfFiniteType_relativeProjToBase
    (h : ∀ U : X.Opens, IsAffineOpen U → Algebra.FiniteType Γ(X, U) (⨁ n, Γ(A.X n, U))) :
    LocallyOfFiniteType A.relativeProjToBase :=
  -- Instance search cannot assign the bare `@LocallyOfFiniteType`, whose type is a dependent
  -- function type, to an argument of type `MorphismProperty Scheme`. Restating it at that type
  -- lets instance search find Mathlib's instance.
  have : IsZariskiLocalAtTarget @LocallyOfFiniteType.{u} :=
    inferInstanceAs <|
      IsZariskiLocalAtTarget (show MorphismProperty Scheme from @LocallyOfFiniteType)
  (A.relativeProjToBase_iff_forall_isAffineOpen @LocallyOfFiniteType).mpr fun U hU ↦
    have := h U hU
    inferInstance

/-- **The relative `Proj` is proper.** If the graded algebra `A` is of finite type and its
degree-zero part `A₀` is finite over `X`, then `Proj_X(A) ⟶ X` is proper. -/
theorem isProper_relativeProjToBase
    (h : ∀ U : X.Opens, IsAffineOpen U → Algebra.FiniteType Γ(X, U) (⨁ n, Γ(A.X n, U)))
    (h₀ : ∀ U : X.Opens, IsAffineOpen U → Module.Finite Γ(X, U) Γ(A.X 0, U)) :
    IsProper A.relativeProjToBase :=
  (A.relativeProjToBase_iff_forall_isAffineOpen @IsProper).mpr fun U hU ↦
    have := h U hU
    have := h₀ U hU
    -- the degree-zero summand of `⨁ n, Γ(Aₙ, U)` is the image of `Γ(A₀, U)`
    have : Module.Finite Γ(X, U) (A.gradedSectionsGrading U 0) := by
      rw [gradedSectionsGrading, summand_def]
      infer_instance
    inferInstance

end CategoryTheory.CommMon
