module

public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.BaseChange
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.BaseChange

/-!
# Affine charts of relative Proj under base change

Let `g : X ⟶ Y` be a morphism of schemes and `A = ⨁ₙ Aₙ` a graded quasicoherent algebra on `Y`.
For affine opens `U` of `Y` and `V ≤ g⁻¹ U` of `X`, the graded sections of `g^* A` over `V`
are obtained from those of `A` over `U` by extending coefficients along
`g.appLE U V : Γ(Y, U) → Γ(X, V)`.

The base-change theorem `GradedQuasicoherentAlgebra.isBaseChange_pullbackGradedSections` and base
change for projective spectra give cartesian squares

`Proj (⨁ n, Γ(g^* Aₙ, V)) ⟶ Proj (⨁ n, Γ(Aₙ, U))`, `Spec Γ(X, V) ⟶ Spec Γ(Y, U)`.

These are the affine charts needed to compare the relative Proj of `g^* A` with the base change
of the relative Proj of `A`. There is no flatness, finite-generation or degree-one-generation
hypothesis, and the degree-zero component of `A` need not be the structure sheaf.

## Main declarations

* `GradedQuasicoherentAlgebra.irrelevant_le_map_pullbackGradedSectionsGradedHom`: the irrelevant
  ideal of the pulled-back graded sections is contained in the image ideal, so `Proj.map` exists.
* `GradedQuasicoherentAlgebra.isPullback_proj_pullbackGradedSections`: the square of projective
  spectra and coefficient spectra is cartesian.

## References

* [The Stacks Project, Lemma 27.16.10](https://stacks.math.columbia.edu/tag/01O3).

The chart comparison is adapted from split 2 of the relative Proj base-change formalization in
`roed-math/TauCeti-w2-fresh`, at
`lookahead/SchemeAndStackFoundations/relative-proj-base-change`.
-/

public section

open CategoryTheory DirectSum

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry

universe u

noncomputable section

namespace GradedQuasicoherentAlgebra

variable {X Y : Scheme.{u}} (A : GradedQuasicoherentAlgebra Y) (g : X ⟶ Y) {U : Y.Opens}
  {V : X.Opens} (hV : V ≤ g ⁻¹ᵁ U)

/-- For affine opens `U` of `Y` and `V ≤ g⁻¹ U` of `X`, the irrelevant ideal of the sections of
`g^* A` over `V` is contained in the ideal generated by the pullback of the irrelevant ideal of the
sections of `A` over `U`, so that `Proj.map` gives
`Proj (⨁ n, Γ(g^* Aₙ, V)) ⟶ Proj (⨁ n, Γ(Aₙ, U))`. -/
theorem irrelevant_le_map_pullbackGradedSectionsGradedHom (hU : IsAffineOpen U)
    (hV' : IsAffineOpen V) :
    HomogeneousIdeal.irrelevant (((pullback g).obj A).obj.gradedSectionsGrading V) ≤
      (HomogeneousIdeal.irrelevant (A.obj.gradedSectionsGrading U)).map
        (A.pullbackGradedSectionsGradedHom g hV) := by
  let := (g.appLE U V hV).hom.toAlgebra
  let := algebraPullbackGradedSections g A hV
  have := isScalarTower_pullbackGradedSections g A hV
  exact HomogeneousIdeal.irrelevant_le_map_of_isBaseChange _ _ _
    (isBaseChange_pullbackGradedSections g A hV hU hV')

/-- **The charts of the relative `Proj` of a pulled-back graded algebra.** For affine opens `U` of
`Y` and `V ≤ g⁻¹ U` of `X`, the square

`Proj (⨁ n, Γ(g^* Aₙ, V)) ⟶ Proj (⨁ n, Γ(Aₙ, U))`, `Spec Γ(X, V) ⟶ Spec Γ(Y, U)`

formed by pullback of sections and the coefficient projections is cartesian. -/
theorem isPullback_proj_pullbackGradedSections (hU : IsAffineOpen U) (hV' : IsAffineOpen V) :
    IsPullback (Proj.map (A.pullbackGradedSectionsGradedHom g hV)
        (A.irrelevant_le_map_pullbackGradedSectionsGradedHom g hV hU hV'))
      (Proj.toSpecCoeff (((pullback g).obj A).obj.gradedSectionsGrading V))
      (Proj.toSpecCoeff (A.obj.gradedSectionsGrading U)) (Spec.map (g.appLE U V hV)) := by
  let := (g.appLE U V hV).hom.toAlgebra
  let := algebraPullbackGradedSections g A hV
  have := isScalarTower_pullbackGradedSections g A hV
  exact Proj.isPullback_map_of_isBaseChange _ _ _
    (isBaseChange_pullbackGradedSections g A hV hU hV')

end GradedQuasicoherentAlgebra

end

end TauCeti.AlgebraicGeometry
