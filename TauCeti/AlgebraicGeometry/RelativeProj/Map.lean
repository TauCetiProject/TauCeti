/-!
# Functoriality of the relative `Proj`

Let `φ : B ⟶ A` be a morphism of graded algebras on a scheme `X` with quasi-coherent homogeneous
components. Over every affine open `U` of `X`, `φ` induces a graded ring homomorphism
`⨁ n, Γ(Bₙ, U) → ⨁ n, Γ(Aₙ, U)` (`CategoryTheory.CommMon.gradedSectionsGradedHom`). When the
irrelevant ideal of the target is contained in the ideal generated by the image of the irrelevant
ideal of the source (`CategoryTheory.CommMon.IrrelevantLeMap φ`, which holds for instance when `φ`
is an isomorphism), these give morphisms of projective spectra
`Proj (⨁ n, Γ(Aₙ, U)) ⟶ Proj (⨁ n, Γ(Bₙ, U))`, compatible with restriction, which glue to a
morphism `Proj_X(A) ⟶ Proj_X(B)` over `X`.

If `φ` is surjective in every positive degree on sections over affine opens, this morphism is a
closed immersion (Stacks, Lemma 27.11.3 (01N0), on affine charts): over the chart of `Proj_X(B)`
above an affine open `U` it is the closed immersion `Proj (⨁ n, Γ(Aₙ, U)) ⟶ Proj (⨁ n, Γ(Bₙ, U))`
of `AlgebraicGeometry.Proj.isClosedImmersion_map_of_grade_subset_range`.

## Main definitions

* `CategoryTheory.CommMon.IrrelevantLeMap φ`: the irrelevant-ideal condition on `φ`.
* `CategoryTheory.CommMon.relativeProjMap φ hφ`: the morphism `Proj_X(A) ⟶ Proj_X(B)` induced by
  `φ : B ⟶ A`.
* `CategoryTheory.CommMon.relativeProjIso e`: the isomorphism `Proj_X(A) ≅ Proj_X(B)` induced by an
  isomorphism `e : A ≅ B` of graded algebras.

## Main results

* `CategoryTheory.CommMon.relativeProjMap_relativeProjToBase`: the morphism lies over `X`.
* `CategoryTheory.CommMon.ι_relativeProjMap`: on the chart over `U`, the morphism of relative
  `Proj`s is the morphism of projective spectra, with the charts written as the coprojections of
  the gluing diagrams, as glued modules on the relative `Proj` use them.
* `CategoryTheory.CommMon.relativeProjMap_id` and `CategoryTheory.CommMon.relativeProjMap_comp`:
  the construction is contravariantly functorial.
* `CategoryTheory.CommMon.irrelevantLeMap_of_isIso`: an isomorphism of graded algebras satisfies
  the irrelevant-ideal condition.
* `CategoryTheory.CommMon.isPullback_relativeProjMap`: over the chart of `Proj_X(B)` above an
  affine open `U`, the morphism is `Proj (⨁ n, Γ(Aₙ, U)) ⟶ Proj (⨁ n, Γ(Bₙ, U))`.
* `CategoryTheory.CommMon.isClosedImmersion_relativeProjMap`: a morphism surjective in positive
  degrees on affine sections induces a closed immersion of relative `Proj`s.
* `CategoryTheory.CommMon.isClosedImmersion_relativeProjMap_of_epi`: so does a morphism that is an
  epimorphism of module sheaves in every positive degree.

## References

* [The Stacks Project, Lemma 27.11.3 (01N0)](https://stacks.math.columbia.edu/tag/01N0)
* [The Stacks Project, Section 27.15, Relative Proj](https://stacks.math.columbia.edu/tag/01NS)
-/

public section

open CategoryTheory Limits DirectSum

namespace TauCeti

open _root_.AlgebraicGeometry

universe u

noncomputable section

variable {X : Scheme.{u}} {A B : CommMon (GradedObject ℕ X.Modules)}

/-- The condition on a morphism of graded algebras `φ : A ⟶ B` under which it induces a morphism
of relative `Proj`s `Proj_X(B) ⟶ Proj_X(A)`: over every affine open `U`, the irrelevant ideal of
`⨁ n, Γ(Bₙ, U)` is contained in the ideal generated by the image of the irrelevant ideal of
`⨁ n, Γ(Aₙ, U)`. -/
abbrev _root_.CategoryTheory.CommMon.IrrelevantLeMap (φ : A ⟶ B) : Prop :=
  ∀ U : X.Opens, IsAffineOpen U →
    HomogeneousIdeal.irrelevant (B.gradedSectionsGrading U) ≤
      (HomogeneousIdeal.irrelevant (A.gradedSectionsGrading U)).map
        (CommMon.gradedSectionsGradedHom φ U)

/-- **An isomorphism of graded algebras satisfies the irrelevant-ideal condition**, since it is
surjective on the graded rings of sections. -/
theorem _root_.CategoryTheory.CommMon.irrelevantLeMap_of_isIso (φ : A ⟶ B) [IsIso φ] :
    CommMon.IrrelevantLeMap φ := fun U _ ↦
  HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _ fun _ _ y _ ↦
    ⟨CommMon.gradedSectionsGradedHom (inv φ) U y, by
      rw [← GradedRingHom.comp_apply, ← CommMon.gradedSectionsGradedHom_comp, IsIso.inv_hom_id,
        CommMon.gradedSectionsGradedHom_id, GradedRingHom.id_apply]⟩

section Map

open Scheme.AffineZariskiSite

variable [∀ n, (A.X n).IsQuasicoherent] [∀ n, (B.X n).IsQuasicoherent] (φ : B ⟶ A)
  (hφ : CommMon.IrrelevantLeMap φ)

/-- The morphisms of projective spectra `Proj (⨁ n, Γ(Aₙ, U)) ⟶ Proj (⨁ n, Γ(Bₙ, U))` induced by a
morphism `φ : B ⟶ A` of graded algebras, natural in the affine open `U`. -/
def _root_.CategoryTheory.CommMon.relativeProjFunctorMap :
    A.relativeProjFunctor ⟶ B.relativeProjFunctor where
  app U := Proj.map (CommMon.gradedSectionsGradedHom φ U.toOpens) (hφ U.toOpens U.2)
  naturality _ _ _ := (Proj.map_comp _ _ _ _).symm.trans <| (Proj.map_congr
    (CommMon.gradedSectionsGradedHom_comp_restrictGradedSectionsGradedHom φ _).symm _ _).trans
      (Proj.map_comp _ _ _ _)

/-- The components of `CategoryTheory.CommMon.relativeProjFunctorMap` are the morphisms of
projective spectra induced by `φ`. -/
theorem _root_.CategoryTheory.CommMon.relativeProjFunctorMap_app (U : X.AffineZariskiSite) :
    (CommMon.relativeProjFunctorMap φ hφ).app U =
      Proj.map (CommMon.gradedSectionsGradedHom φ U.toOpens) (hφ U.toOpens U.2) :=
  (rfl)

/-- The morphisms induced by `φ` lie over the coefficient rings `Γ(X, U)`. -/
theorem _root_.CategoryTheory.CommMon.relativeProjFunctorMap_app_toSpecCoeff
    (U : X.AffineZariskiSite) :
    (CommMon.relativeProjFunctorMap φ hφ).app U ≫
        Proj.toSpecCoeff (B.gradedSectionsGrading U.toOpens) =
      Proj.toSpecCoeff (A.gradedSectionsGrading U.toOpens) :=
  Proj.map_toSpecCoeff (f := CommMon.gradedSectionsGradedHom φ U.toOpens) (hf := hφ U.toOpens U.2)
    (hR := fun r ↦ Subtype.ext <| by simp)

/-- The morphisms induced by `φ` lie over the coefficient rings `Γ(X, U)`, composed with a further
morphism. This is stated separately because the projective spectra are the charts of the relative
`Proj`s only after unfolding, which defeats the reassociation in `@[reassoc]`. -/
theorem _root_.CategoryTheory.CommMon.relativeProjFunctorMap_app_toSpecCoeff_assoc
    (U : X.AffineZariskiSite) {Y : Scheme.{u}} (g : Spec Γ(X, U.toOpens) ⟶ Y) :
    (CommMon.relativeProjFunctorMap φ hφ).app U ≫
        Proj.toSpecCoeff (B.gradedSectionsGrading U.toOpens) ≫ g =
      Proj.toSpecCoeff (A.gradedSectionsGrading U.toOpens) ≫ g :=
  (Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ g) (CommMon.relativeProjFunctorMap_app_toSpecCoeff φ hφ U))

/-- The morphism of relative `Proj`s `Proj_X(A) ⟶ Proj_X(B)` induced by a morphism `φ : B ⟶ A` of
graded algebras, glued from the morphisms `Proj (⨁ n, Γ(Aₙ, U)) ⟶ Proj (⨁ n, Γ(Bₙ, U))` over the
affine opens `U` of `X`. -/
def _root_.CategoryTheory.CommMon.relativeProjMap : A.relativeProj ⟶ B.relativeProj :=
  colimMap (CommMon.relativeProjFunctorMap φ hφ)

/-- On the chart over an affine open `U`, the morphism of relative `Proj`s induced by `φ` is the
morphism of projective spectra induced by `φ`. -/
@[reassoc]
theorem _root_.CategoryTheory.CommMon.relativeProjCover_f_relativeProjMap
    (U : X.AffineZariskiSite) :
    A.relativeProjCover.f U ≫ CommMon.relativeProjMap φ hφ =
      (CommMon.relativeProjFunctorMap φ hφ).app U ≫ B.relativeProjCover.f U :=
  ι_colimMap _ _

/-- On the chart over an affine open `U`, the morphism of relative `Proj`s induced by `φ` is the
morphism of projective spectra induced by `φ`, with the charts written as the coprojections of the
gluing diagrams. -/
theorem _root_.CategoryTheory.CommMon.ι_relativeProjMap (U : X.AffineZariskiSite) :
    colimit.ι A.relativeProjGluingData.functor U ≫ CommMon.relativeProjMap φ hφ =
      Proj.map (CommMon.gradedSectionsGradedHom φ U.toOpens) (hφ U.toOpens U.2) ≫
        colimit.ι B.relativeProjGluingData.functor U :=
  (CommMon.relativeProjCover_f_relativeProjMap φ hφ U).trans
    (congrArg (· ≫ _) (CommMon.relativeProjFunctorMap_app φ hφ U))

/-- **The morphism of relative `Proj`s induced by `φ` lies over `X`.** -/
@[reassoc (attr := simp)]
theorem _root_.CategoryTheory.CommMon.relativeProjMap_relativeProjToBase :
    CommMon.relativeProjMap φ hφ ≫ B.relativeProjToBase = A.relativeProjToBase :=
  A.relativeProjCover.hom_ext _ _ fun (U : X.AffineZariskiSite) ↦ by
    have h := A.relativeProjCover_f_relativeProjToBase U
    rw [← CommMon.relativeProjFunctorMap_app_toSpecCoeff_assoc φ hφ U] at h
    exact (CommMon.relativeProjCover_f_relativeProjMap_assoc φ hφ U _).trans
      ((congrArg (_ ≫ ·) (B.relativeProjCover_f_relativeProjToBase U)).trans h.symm)

/-- **Over an affine open `U` of `X`, the morphism of relative `Proj`s induced by `φ` is
`Proj (⨁ n, Γ(Aₙ, U)) ⟶ Proj (⨁ n, Γ(Bₙ, U))`**: the chart of `Proj_X(A)` over `U` is the
preimage of the chart of `Proj_X(B)` over `U`. -/
theorem _root_.CategoryTheory.CommMon.isPullback_relativeProjMap (U : X.AffineZariskiSite) :
    IsPullback (A.relativeProjCover.f U) ((CommMon.relativeProjFunctorMap φ hφ).app U)
      (CommMon.relativeProjMap φ hφ) (B.relativeProjCover.f U) := by
  refine (IsPullback.of_right ?_ (CommMon.relativeProjCover_f_relativeProjMap φ hφ U).symm
    (B.isPullback_relativeProjCover U)).flip
  have h := A.isPullback_relativeProjCover U
  rw [← CommMon.relativeProjFunctorMap_app_toSpecCoeff_assoc φ hφ U,
    ← CommMon.relativeProjMap_relativeProjToBase φ hφ] at h
  exact h

end Map

section Functoriality

variable {C : CommMon (GradedObject ℕ X.Modules)} [∀ n, (A.X n).IsQuasicoherent]
  [∀ n, (B.X n).IsQuasicoherent] [∀ n, (C.X n).IsQuasicoherent]

/-- The identity of a graded algebra induces the identity on the projective spectra of its
sections. -/
@[simp]
theorem _root_.CategoryTheory.CommMon.relativeProjFunctorMap_id
    (h : CommMon.IrrelevantLeMap (𝟙 A)) :
    CommMon.relativeProjFunctorMap (𝟙 A) h = 𝟙 A.relativeProjFunctor := by
  ext U
  exact (Proj.map_congr (CommMon.gradedSectionsGradedHom_id U.toOpens) _ _).trans Proj.map_id

/-- The morphisms of projective spectra induced by a composite of morphisms of graded algebras
are the composites of the induced morphisms. -/
theorem _root_.CategoryTheory.CommMon.relativeProjFunctorMap_comp (φ : C ⟶ B) (ψ : B ⟶ A)
    (hφ : CommMon.IrrelevantLeMap φ) (hψ : CommMon.IrrelevantLeMap ψ)
    (hφψ : CommMon.IrrelevantLeMap (φ ≫ ψ)) :
    CommMon.relativeProjFunctorMap (φ ≫ ψ) hφψ =
      CommMon.relativeProjFunctorMap ψ hψ ≫ CommMon.relativeProjFunctorMap φ hφ := by
  ext U
  exact (Proj.map_congr (CommMon.gradedSectionsGradedHom_comp φ ψ U.toOpens) _ _).trans
    (Proj.map_comp _ _ _ _)

/-- **The identity of a graded algebra induces the identity of its relative `Proj`.** -/
@[simp]
theorem _root_.CategoryTheory.CommMon.relativeProjMap_id
    (h : CommMon.IrrelevantLeMap (𝟙 A)) :
    CommMon.relativeProjMap (𝟙 A) h = 𝟙 A.relativeProj :=
  A.relativeProjCover.hom_ext _ _ fun (U : X.AffineZariskiSite) ↦
    (CommMon.relativeProjCover_f_relativeProjMap (𝟙 A) h U).trans <| by
      rw [CommMon.relativeProjFunctorMap_id]
      exact (Category.id_comp _).trans (Category.comp_id _).symm

/-- **The morphism of relative `Proj`s induced by a composite of morphisms of graded algebras is
the composite of the induced morphisms.** -/
theorem _root_.CategoryTheory.CommMon.relativeProjMap_comp (φ : C ⟶ B) (ψ : B ⟶ A)
    (hφ : CommMon.IrrelevantLeMap φ) (hψ : CommMon.IrrelevantLeMap ψ)
    (hφψ : CommMon.IrrelevantLeMap (φ ≫ ψ)) :
    CommMon.relativeProjMap (φ ≫ ψ) hφψ =
      CommMon.relativeProjMap ψ hψ ≫ CommMon.relativeProjMap φ hφ :=
  A.relativeProjCover.hom_ext _ _ fun (U : X.AffineZariskiSite) ↦
    (CommMon.relativeProjCover_f_relativeProjMap (φ ≫ ψ) hφψ U).trans <| by
      rw [CommMon.relativeProjFunctorMap_comp φ ψ hφ hψ hφψ,
        CommMon.relativeProjCover_f_relativeProjMap_assoc ψ hψ U]
      -- the charts are `Proj (⨁ n, Γ(Bₙ, U))` only after unfolding, so `rw` cannot reassociate
      exact ((Category.assoc _ _ _).trans
        (congrArg (_ ≫ ·) (CommMon.relativeProjCover_f_relativeProjMap φ hφ U).symm)).trans
          (Category.assoc _ _ _).symm

end Functoriality

section Isomorphism

variable [∀ n, (A.X n).IsQuasicoherent] [∀ n, (B.X n).IsQuasicoherent]

/-- The **isomorphism of relative `Proj`s** `Proj_X(A) ≅ Proj_X(B)` induced by an isomorphism of
graded algebras `e : A ≅ B`. Its forward morphism is induced by `e.inv`, since the relative `Proj`
is contravariant. -/
def _root_.CategoryTheory.CommMon.relativeProjIso (e : A ≅ B) :
    A.relativeProj ≅ B.relativeProj where
  hom := CommMon.relativeProjMap e.inv (CommMon.irrelevantLeMap_of_isIso e.inv)
  inv := CommMon.relativeProjMap e.hom (CommMon.irrelevantLeMap_of_isIso e.hom)
  hom_inv_id := by
    rw [← CommMon.relativeProjMap_comp _ _ _ _ (CommMon.irrelevantLeMap_of_isIso _)]
    simp only [Iso.hom_inv_id, CommMon.relativeProjMap_id]
  inv_hom_id := by
    rw [← CommMon.relativeProjMap_comp _ _ _ _ (CommMon.irrelevantLeMap_of_isIso _)]
    simp only [Iso.inv_hom_id, CommMon.relativeProjMap_id]

/-- The forward morphism of `CategoryTheory.CommMon.relativeProjIso e` is induced by `e.inv`. -/
@[simp]
theorem _root_.CategoryTheory.CommMon.relativeProjIso_hom (e : A ≅ B) :
    (CommMon.relativeProjIso e).hom =
      CommMon.relativeProjMap e.inv (CommMon.irrelevantLeMap_of_isIso e.inv) := by
  rfl

/-- The inverse of `CategoryTheory.CommMon.relativeProjIso e` is induced by `e.hom`. -/
@[simp]
theorem _root_.CategoryTheory.CommMon.relativeProjIso_inv (e : A ≅ B) :
    (CommMon.relativeProjIso e).inv =
      CommMon.relativeProjMap e.hom (CommMon.irrelevantLeMap_of_isIso e.hom) := by
  rfl

end Isomorphism

section ClosedImmersion

variable [∀ n, (A.X n).IsQuasicoherent] [∀ n, (B.X n).IsQuasicoherent] (φ : B ⟶ A)
  (hφ : ∀ U : X.Opens, IsAffineOpen U → ∀ i, 0 < i →
    (A.gradedSectionsGrading U i : Set (⨁ n, Γ(A.X n, U))) ⊆
      Set.range (CommMon.gradedSectionsGradedHom φ U))
include hφ

/-- **A morphism of graded algebras surjective in positive degrees induces a closed immersion of
relative `Proj`s**: if `φ : B ⟶ A` maps `⨁ n, Γ(Bₙ, U)` onto every homogeneous component of
positive degree of `⨁ n, Γ(Aₙ, U)` for every affine open `U` of `X`, then
`Proj_X(A) ⟶ Proj_X(B)` is a closed immersion. -/
@[stacks 01N0]
theorem _root_.CategoryTheory.CommMon.isClosedImmersion_relativeProjMap :
    IsClosedImmersion (CommMon.relativeProjMap φ fun U hU ↦
      HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _ (hφ U hU)) := by
  refine IsZariskiLocalAtTarget.of_openCover B.relativeProjCover fun U ↦ ?_
  have h := CommMon.isPullback_relativeProjMap φ (fun U hU ↦
    HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _ (hφ U hU)) U
  have : IsClosedImmersion ((CommMon.relativeProjFunctorMap φ fun U hU ↦
      HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _ (hφ U hU)).app U) :=
    Proj.isClosedImmersion_map_of_grade_subset_range _ _ (hφ U.toOpens U.2)
  exact Eq.mpr (congrArg IsClosedImmersion h.isoPullback_inv_snd.symm)
    ((MorphismProperty.cancel_left_of_respectsIso @IsClosedImmersion h.isoPullback.inv _).mpr this)

end ClosedImmersion

section Epi

variable [∀ n, (A.X n).IsQuasicoherent] [∀ n, (B.X n).IsQuasicoherent] (φ : B ⟶ A)
  (hφ : ∀ i, 0 < i → Epi (φ.hom.hom i))
include hφ

/-- **A morphism of graded algebras that is an epimorphism in positive degrees induces a closed
immersion of relative `Proj`s**: if `φ : B ⟶ A` is an epimorphism `Bₙ ⟶ Aₙ` of module sheaves for
every `n > 0`, then `Proj_X(A) ⟶ Proj_X(B)` is a closed immersion. -/
@[stacks 01N0]
theorem _root_.CategoryTheory.CommMon.isClosedImmersion_relativeProjMap_of_epi :
    IsClosedImmersion (CommMon.relativeProjMap φ fun U hU ↦
      HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _ fun i hi ↦
        have := hφ i hi
        CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi φ U hU i) :=
  CommMon.isClosedImmersion_relativeProjMap φ fun U hU i hi ↦
    have := hφ i hi
    CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi φ U hU i

end Epi

end

