module

public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Adjunction
public import TauCeti.AlgebraicGeometry.RelativeProj.Map
public import TauCeti.RingTheory.GradedAlgebra.DegreeOne

/-!
# The relative `Proj` of an algebra generated in degree one embeds in `Proj_X(Sym A₁)`

Let `A` be a graded quasicoherent algebra on a scheme `X`, and let `Sym A₁ ⟶ A` be the morphism of
graded quasicoherent algebras extending the identity of the degree-one component `A₁`
(`TauCeti.AlgebraicGeometry.gradedSymmetricAlgebraLift`). Suppose that `A` is generated in degree
one: over every affine open `U` of `X`, the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by
its homogeneous elements of degrees `0` and `1`, that is, by `Γ(A₁, U)` as an algebra over
`Γ(A₀, U)`. Then:

* `Sym A₁ ⟶ A` is surjective in every positive degree on sections over every affine open, hence an
  epimorphism of module sheaves in every positive degree: since
  `A₀ · A₁ ⊆ A₁`, every section of `Aₙ` with `n > 0` is a polynomial in sections of `A₁` with
  coefficients in `Γ(X, U)`
  (`TauCeti.GradedAlgebra.mem_adjoin_grade_one_of_adjoin_grade_zero_union_grade_one_eq_top`),
  and `Sym A₁ ⟶ A` is the identity in degree one;
* the induced morphism `Proj_X(A) ⟶ Proj_X(Sym A₁)` over `X` is a closed immersion (Stacks, Lemma
  27.11.3 (01N0), on affine charts), by `CategoryTheory.CommMon.isClosedImmersion_relativeProjMap`.

## Main results

In the namespace `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra`:

* `grade_subset_range_gradedSymmetricAlgebraLift`: over an affine open over which `A` is generated
  in degree one, `Sym A₁ ⟶ A` maps the sections of `Sym A₁` onto every homogeneous component of
  positive degree of `⨁ n, Γ(Aₙ, U)`.
* `epi_gradedSymmetricAlgebraLift_one`: the morphism `Sym F ⟶ A` extending an epimorphism
  `F ⟶ A₁` is an epimorphism in degree one.
* `exists_mem_basicOpen_gradedSymmetricAlgebraLift`: over an affine open over which `A` is
  generated in degree one, the standard opens of the images of the degree-one sections of `Sym A₁`
  cover the chart `Proj (⨁ n, Γ(Aₙ, U))`.
* `epi_gradedSymmetricAlgebraLift`: if `A` is generated in degree one, `Symⁿ A₁ ⟶ Aₙ` is an
  epimorphism of module sheaves for every `n > 0`.
* `isClosedImmersion_relativeProjMap_gradedSymmetricAlgebraLift`: if `A` is generated in degree
  one, `Proj_X(A) ⟶ Proj_X(Sym A₁)` is a closed immersion.

## References

* [The Stacks Project, Lemma 27.11.3 (01N0)](https://stacks.math.columbia.edu/tag/01N0)
-/

public section

open CategoryTheory DirectSum

namespace TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra

open _root_.AlgebraicGeometry

universe u

noncomputable section

variable {X : Scheme.{u}} (A : GradedQuasicoherentAlgebra X)

/-- The morphism `Sym F ⟶ A` extending an epimorphism `φ : F ⟶ A₁` is an epimorphism in degree
one: its degree-one component is `φ`, through `F ≅ Sym¹ F`. -/
theorem epi_gradedSymmetricAlgebraLift_one {F : QuasicoherentSheaf X} (φ : F ⟶ degreeOne.obj A)
    [hφ : Epi φ.hom] :
    Epi ((gradedSymmetricAlgebraLift φ).hom.hom.hom 1) := by
  have h := congrArg (·.hom) (gradedSymmetricAlgebraDegreeOneIso_inv_app_comp_degreeOne_map_lift φ)
  simp only [ObjectProperty.FullSubcategory.comp_hom, degree_map_hom] at h
  -- The transports are morphisms of `SheafOfModules X.ringCatSheaf`, whose category instance is
  -- identified with that of `X.Modules` only by unfolding, so typeclass search does not find
  -- their instances; they are supplied by hand, as in `epi_one_gradedSymmetricAlgebra`.
  have he {P Q : X.Modules} (p : P = Q) : IsIso (eqToHom p) := (eqToIso p).isIso_hom
  exact (@epi_comp_iff_of_isIso _ _ _ _ _ _ _ (he _)).mp
    ((@epi_comp_iff_of_epi _ _ _ _ _ _ (@IsIso.epi_of_iso _ _ _ _ _ (he _)) _).mp
      (@epi_of_epi_fac _ _ _ _ _ _ _ _ hφ h))

/-- **`Sym A₁ ⟶ A` is surjective in positive degrees on affine sections.** Over an affine open `U`
of `X` over which `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0` and `1`,
the morphism `Sym A₁ ⟶ A` extending the identity of `A₁` maps `⨁ n, Γ(Symⁿ A₁, U)` onto every
homogeneous component of positive degree of `⨁ n, Γ(Aₙ, U)`. -/
theorem grade_subset_range_gradedSymmetricAlgebraLift (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤)
    (i : ℕ) (hi : 0 < i) :
    (A.obj.gradedSectionsGrading U i : Set (⨁ n, Γ(A.obj.X n, U))) ⊆
      Set.range (CommMon.gradedSectionsGradedHom
        (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom U) := by
  have := epi_gradedSymmetricAlgebraLift_one A (𝟙 _)
  have hle : Algebra.adjoin Γ(X, U) (A.obj.gradedSectionsGrading U 1 : Set _) ≤
      (CommMon.gradedSectionsMap (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom
        U).range := Algebra.adjoin_le fun _ hy ↦ by
    obtain ⟨y, rfl⟩ := CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi
      (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom U hU 1 hy
    exact ⟨y, (CommMon.gradedSectionsGradedHom_apply _ U y).symm⟩
  intro x hx
  obtain ⟨y, hy⟩ :=
    hle (GradedAlgebra.mem_adjoin_grade_one_of_adjoin_grade_zero_union_grade_one_eq_top _ h hi hx)
  exact ⟨y, (CommMon.gradedSectionsGradedHom_apply _ U y).trans hy⟩

/-- **The standard opens of the images of the degree-one sections of `Sym A₁` cover the charts.**
Over an affine open `U` over which `A` is generated in degree one, every point of
`Proj (⨁ n, Γ(Aₙ, U))` lies in `D₊(a)` for the image `a` of a section of `Sym A₁` of degree one. -/
theorem exists_mem_basicOpen_gradedSymmetricAlgebraLift (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤)
    (y : Proj (A.obj.gradedSectionsGrading U)) :
    ∃ b ∈ ((gradedSymmetricAlgebra X).obj (degreeOne.obj A)).obj.gradedSectionsGrading U 1,
      y ∈ Proj.basicOpen _ (CommMon.gradedSectionsGradedHom
        (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom U b) := by
  obtain ⟨⟨_, ha⟩, hya⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((Proj.iSup_basicOpen_eq_top_of_adjoin_eq_top _
      ((GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff _).mp h)).ge
        (Set.mem_univ y))
  obtain ⟨a, rfl⟩ := DirectSum.mem_summand.mp ha
  obtain ⟨z, rfl⟩ := @Scheme.Modules.Hom.app_surjective_of_epi_of_isAffineOpen _
    (((gradedSymmetricAlgebra X).obj (degreeOne.obj A)).obj.X 1) (A.obj.X 1)
    ((gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom.hom.hom 1)
    (epi_gradedSymmetricAlgebraLift_one A (𝟙 _)) _ _ U hU a
  refine ⟨DirectSum.of _ 1 z, CommMon.of_mem_gradedSectionsGrading _ 1 z, ?_⟩
  rwa [CommMon.gradedSectionsGradedHom_apply, CommMon.gradedSectionsMap_of]

/-- **`Sym A₁ ⟶ A` is an epimorphism in every positive degree.** If over every affine open `U` of
`X` the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees
`0` and `1`, then the morphism `Symⁿ A₁ ⟶ Aₙ` of module sheaves is an epimorphism for every
`n > 0`. -/
theorem epi_gradedSymmetricAlgebraLift
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
        A.obj.gradedSectionsGrading U 1) = ⊤)
    (i : ℕ) (hi : 0 < i) :
    Epi ((gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom.hom.hom i) := by
  refine Scheme.Modules.Hom.epi_of_surjective_on_affineOpens _ fun U hU x ↦ ?_
  obtain ⟨y, hy⟩ := grade_subset_range_gradedSymmetricAlgebraLift A U hU (h U hU) i hi
    (DirectSum.mem_summand.mpr ⟨x, rfl⟩)
  refine ⟨y i, ?_⟩
  have := congrArg (· i) hy
  simp only [CommMon.gradedSectionsGradedHom_apply, CommMon.gradedSectionsMap_apply] at this
  exact this.trans (DirectSum.of_eq_same (β := fun i ↦ Γ(A.obj.X i, U)) i x)

/-- **The relative `Proj` of an algebra generated in degree one is a closed subscheme of
`Proj_X(Sym A₁)`.** If over every affine open `U` of `X` the graded ring of sections
`⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0` and `1`, then the morphism
`Proj_X(A) ⟶ Proj_X(Sym A₁)` over `X` induced by `Sym A₁ ⟶ A` is a closed immersion. -/
theorem isClosedImmersion_relativeProjMap_gradedSymmetricAlgebraLift
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
        A.obj.gradedSectionsGrading U 1) = ⊤) :
    IsClosedImmersion (CommMon.relativeProjMap
      (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom fun U hU ↦
        HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _
          (grade_subset_range_gradedSymmetricAlgebraLift A U hU (h U hU))) :=
  CommMon.isClosedImmersion_relativeProjMap _
    fun U hU ↦ grade_subset_range_gradedSymmetricAlgebraLift A U hU (h U hU)

end

end TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra
