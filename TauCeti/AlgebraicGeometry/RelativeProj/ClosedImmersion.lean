module

public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.GeneratedInDegreeOne
public import TauCeti.AlgebraicGeometry.RelativeProj.Map

/-!
# The relative `Proj` of an algebra generated in degree one embeds in `Proj_X(Sym A₁)`

Let `A` be a graded quasicoherent algebra on a scheme `X`, let `φ : F ⟶ A₁` be an epimorphism from
a quasicoherent sheaf onto the degree-one component of `A`, and let `Sym F ⟶ A` be the morphism of
graded quasicoherent algebras extending `φ`
(`TauCeti.AlgebraicGeometry.gradedSymmetricAlgebraLift`); for `φ` the identity of `A₁` this is
`Sym A₁ ⟶ A`. Suppose that `A` is generated in degree one: over every affine open `U` of `X`, the
graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0`
and `1`, that is, by `Γ(A₁, U)` as an algebra over `Γ(A₀, U)`. Then:

* `Sym F ⟶ A` is surjective in every positive degree on sections over every affine open
  (`grade_subset_range_gradedSymmetricAlgebraLift`, from the module
  `SymmetricAlgebra.GeneratedInDegreeOne` on graded quasicoherent algebras);
* the induced morphism `Proj_X(A) ⟶ Proj_X(Sym F)` over `X` is a closed immersion (Stacks, Lemma
  27.11.3 (01N0), on affine charts), by `CategoryTheory.CommMon.isClosedImmersion_relativeProjMap`.
  In particular `Proj_X(A)` is a closed subscheme of `Proj_X(Sym A₁)`.

## Main results

In the namespace `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra`:

* `exists_mem_basicOpen_gradedSymmetricAlgebraLift`: over an affine open over which `A` is
  generated in degree one, the standard opens of the images of the degree-one sections of `Sym F`
  cover the chart `Proj (⨁ n, Γ(Aₙ, U))`.
* `isClosedImmersion_relativeProjMap_gradedSymmetricAlgebraLift`: if `A` is generated in degree
  one, `Proj_X(A) ⟶ Proj_X(Sym F)` is a closed immersion.

## References

* [The Stacks Project, Lemma 27.11.3 (01N0)](https://stacks.math.columbia.edu/tag/01N0)
-/

public section

open CategoryTheory DirectSum

namespace TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra

open _root_.AlgebraicGeometry

universe u

noncomputable section

variable {X : Scheme.{u}} (A : GradedQuasicoherentAlgebra X) {F : QuasicoherentSheaf X}
  (φ : F ⟶ degreeOne.obj A) [Epi φ.hom]

/-- **The standard opens of the images of the degree-one sections of `Sym F` cover the charts.**
Over an affine open `U` over which `A` is generated in degree one, every point of
`Proj (⨁ n, Γ(Aₙ, U))` lies in `D₊(a)`, where `a` is the image of a degree-one section of `Sym F`
under the morphism `Sym F ⟶ A` extending an epimorphism `φ : F ⟶ A₁`. -/
theorem exists_mem_basicOpen_gradedSymmetricAlgebraLift (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤)
    (y : Proj (A.obj.gradedSectionsGrading U)) :
    ∃ b ∈ ((gradedSymmetricAlgebra X).obj F).obj.gradedSectionsGrading U 1,
      y ∈ Proj.basicOpen _ (CommMon.gradedSectionsGradedHom
        (gradedSymmetricAlgebraLift φ).hom U b) := by
  obtain ⟨⟨_, ha⟩, hya⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((Proj.iSup_basicOpen_eq_top_of_adjoin_eq_top _
      ((GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff _).mp h)).ge
        (Set.mem_univ y))
  have := epi_gradedSymmetricAlgebraLift_one A φ
  obtain ⟨b, hb⟩ := CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi
    (gradedSymmetricAlgebraLift φ).hom U hU 1 ha
  obtain ⟨a, rfl⟩ := DirectSum.mem_summand.mp ha
  -- `b` need not be homogeneous, but its degree-one component also maps to `a`
  refine ⟨DirectSum.of _ 1 (b 1), CommMon.of_mem_gradedSectionsGrading _ 1 _, ?_⟩
  have hb1 := congrArg (· 1) hb
  simp only [CommMon.gradedSectionsGradedHom_apply, CommMon.gradedSectionsMap_apply,
    DirectSum.of_eq_same] at hb1
  rwa [CommMon.gradedSectionsGradedHom_apply, CommMon.gradedSectionsMap_of, hb1]

/-- **The relative `Proj` of an algebra generated in degree one is a closed subscheme of
`Proj_X(Sym F)`.** If over every affine open `U` of `X` the graded ring of sections
`⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0` and `1`, then for an
epimorphism `φ : F ⟶ A₁`, the morphism `Proj_X(A) ⟶ Proj_X(Sym F)` over `X` induced by the
morphism `Sym F ⟶ A` extending `φ` is a closed immersion; for `φ = 𝟙 A₁` this embeds `Proj_X(A)`
in `Proj_X(Sym A₁)`. -/
theorem isClosedImmersion_relativeProjMap_gradedSymmetricAlgebraLift
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
        A.obj.gradedSectionsGrading U 1) = ⊤) :
    IsClosedImmersion (CommMon.relativeProjMap
      (gradedSymmetricAlgebraLift φ).hom fun U hU ↦
        HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _
          (grade_subset_range_gradedSymmetricAlgebraLift A φ U hU (h U hU))) :=
  CommMon.isClosedImmersion_relativeProjMap _
    fun U hU ↦ grade_subset_range_gradedSymmetricAlgebraLift A φ U hU (h U hU)

end

end TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra
