module

public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Surjective
public import TauCeti.AlgebraicGeometry.RelativeProj.Map

/-!
# The relative `Proj` of an algebra generated in degree one embeds in `Proj_X(Sym A₁)`

Let `φ : B ⟶ A` be a morphism of graded quasicoherent algebras on a scheme `X` that is an
epimorphism `B₁ ⟶ A₁` in degree one, and suppose that `A` is generated in degree one: over every
affine open `U` of `X`, the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its
homogeneous elements of degrees `0` and `1`, that is, by `Γ(A₁, U)` as an algebra over
`Γ(A₀, U)`. Then `φ` is surjective in every positive degree on affine sections
(`CategoryTheory.CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi_one`), so:

* the standard opens `D₊(φ b)` of the images of the degree-one sections `b` of `B` cover each
  chart `Proj (⨁ n, Γ(Aₙ, U))`;
* the induced morphism `Proj_X(A) ⟶ Proj_X(B)` over `X` is a closed immersion (Stacks, Lemmas
  27.11.3 and 27.11.5 (01N0, 01N1), on affine charts), by
  `CategoryTheory.CommMon.isClosedImmersion_relativeProjMap`.

The main example is the morphism `Sym A₁ ⟶ A` of graded quasicoherent algebras extending the
identity of `A₁` (`TauCeti.AlgebraicGeometry.gradedSymmetricAlgebraLift`), an epimorphism in degree
one (`TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra.epi_gradedSymmetricAlgebraLift_one`):
the relative `Proj` of an algebra generated in degree one is a closed subscheme of
`Proj_X(Sym A₁)`.

## Main results

* `CategoryTheory.CommMon.exists_mem_basicOpen_gradedSectionsGradedHom_of_epi_one`: over an affine
  open over which `A` is generated in degree one, the standard opens of the images of the
  degree-one sections of `B` cover the chart `Proj (⨁ n, Γ(Aₙ, U))`.
* `CategoryTheory.CommMon.isClosedImmersion_relativeProjMap_of_epi_one`: if `A` is generated in
  degree one, `Proj_X(A) ⟶ Proj_X(B)` is a closed immersion.

In the namespace `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra`, for `Sym A₁ ⟶ A`:

* `exists_mem_basicOpen_gradedSymmetricAlgebraLift`: over an affine open over which `A` is
  generated in degree one, the standard opens of the images of the degree-one sections of `Sym A₁`
  cover the chart `Proj (⨁ n, Γ(Aₙ, U))`.
* `isClosedImmersion_relativeProjMap_gradedSymmetricAlgebraLift`: if `A` is generated in degree
  one, `Proj_X(A) ⟶ Proj_X(Sym A₁)` is a closed immersion.

## References

* [The Stacks Project, Lemma 27.11.3 (01N0)](https://stacks.math.columbia.edu/tag/01N0)
* [The Stacks Project, Lemma 27.11.5 (01N1)](https://stacks.math.columbia.edu/tag/01N1)
-/

public section

open CategoryTheory DirectSum

namespace TauCeti

open _root_.AlgebraicGeometry

universe u

variable {X : Scheme.{u}}

section General

variable {A B : CommMon (GradedObject ℕ X.Modules)} (φ : B ⟶ A) [Epi (φ.hom.hom 1)]

/-- **The standard opens of the images of degree-one sections cover the charts.** Over an affine
open `U` over which `A` is generated in degree one, a morphism `φ : B ⟶ A` of graded algebras
that is an epimorphism of quasicoherent module sheaves in degree one has the following property:
every point of `Proj (⨁ n, Γ(Aₙ, U))` lies in `D₊(φ b)` for a section `b` of `B` of degree one. -/
theorem _root_.CategoryTheory.CommMon.exists_mem_basicOpen_gradedSectionsGradedHom_of_epi_one
    [(A.X 1).IsQuasicoherent] [(B.X 1).IsQuasicoherent] (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.X n, U))) ∪
      A.gradedSectionsGrading U 1) = ⊤)
    (y : Proj (A.gradedSectionsGrading U)) :
    ∃ b ∈ B.gradedSectionsGrading U 1,
      y ∈ Proj.basicOpen _ (CommMon.gradedSectionsGradedHom φ U b) := by
  obtain ⟨⟨_, ha⟩, hya⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((Proj.iSup_basicOpen_eq_top_of_adjoin_eq_top _
      ((GradedAlgebra.adjoin_grade_zero_union_grade_one_eq_top_iff _).mp h)).ge
        (Set.mem_univ y))
  obtain ⟨b, hb⟩ := CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi φ U hU 1 ha
  -- the degree-one component of `b` is mapped to the degree-one component of `φ b`, which is `φ b`
  refine ⟨_, SetLike.coe_mem (decompose (B.gradedSectionsGrading U) b 1), ?_⟩
  rwa [GradedRingHom.map_directSumDecompose, hb, decompose_of_mem_same _ ha]

/-- **A morphism that is an epimorphism in degree one onto an algebra generated in degree one
induces a closed immersion of relative `Proj`s.** If `φ : B ⟶ A` is an epimorphism `B₁ ⟶ A₁` of
module sheaves and over every affine open `U` of `X` the graded ring of sections `⨁ n, Γ(Aₙ, U)`
is generated by its homogeneous elements of degrees `0` and `1`, then `Proj_X(A) ⟶ Proj_X(B)` over
`X` is a closed immersion. -/
@[stacks 01N1]
theorem _root_.CategoryTheory.CommMon.isClosedImmersion_relativeProjMap_of_epi_one
    [∀ n, (A.X n).IsQuasicoherent] [∀ n, (B.X n).IsQuasicoherent]
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin Γ(X, U) ((A.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.X n, U))) ∪
        A.gradedSectionsGrading U 1) = ⊤) :
    IsClosedImmersion (CommMon.relativeProjMap φ fun U hU ↦
      HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _
        (CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi_one φ U hU (h U hU))) :=
  CommMon.isClosedImmersion_relativeProjMap φ fun U hU ↦
    CommMon.grade_subset_range_gradedSectionsGradedHom_of_epi_one φ U hU (h U hU)

end General

namespace AlgebraicGeometry.GradedQuasicoherentAlgebra

variable (A : GradedQuasicoherentAlgebra X)

/-- **The standard opens of the images of the degree-one sections of `Sym A₁` cover the charts.**
Over an affine open `U` over which `A` is generated in degree one, every point of
`Proj (⨁ n, Γ(Aₙ, U))` lies in `D₊(a)` for the image `a` of a section of `Sym A₁` of degree one. -/
theorem exists_mem_basicOpen_gradedSymmetricAlgebraLift (U : X.Opens) (hU : IsAffineOpen U)
    (h : Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤)
    (y : Proj (A.obj.gradedSectionsGrading U)) :
    ∃ b ∈ ((gradedSymmetricAlgebra X).obj (degreeOne.obj A)).obj.gradedSectionsGrading U 1,
      y ∈ Proj.basicOpen _ (CommMon.gradedSectionsGradedHom
        (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom U b) :=
  have := epi_gradedSymmetricAlgebraLift_one A
  CommMon.exists_mem_basicOpen_gradedSectionsGradedHom_of_epi_one _ U hU h y

/-- **The relative `Proj` of an algebra generated in degree one is a closed subscheme of
`Proj_X(Sym A₁)`.** If over every affine open `U` of `X` the graded ring of sections
`⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of degrees `0` and `1`, then the morphism
`Proj_X(A) ⟶ Proj_X(Sym A₁)` over `X` induced by `Sym A₁ ⟶ A` is a closed immersion. -/
@[stacks 01N1]
theorem isClosedImmersion_relativeProjMap_gradedSymmetricAlgebraLift
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
        A.obj.gradedSectionsGrading U 1) = ⊤) :
    IsClosedImmersion (CommMon.relativeProjMap
      (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom
      fun U hU ↦ HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _
        (grade_subset_range_gradedSymmetricAlgebraLift A U hU (h U hU))) :=
  have := epi_gradedSymmetricAlgebraLift_one A
  CommMon.isClosedImmersion_relativeProjMap_of_epi_one _ h

end AlgebraicGeometry.GradedQuasicoherentAlgebra

end TauCeti
