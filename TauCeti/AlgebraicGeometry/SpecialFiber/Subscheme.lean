module

public import Mathlib.AlgebraicGeometry.Morphisms.Proper
public import TauCeti.AlgebraicGeometry.Fibers
public import TauCeti.AlgebraicGeometry.IdealSheaf.OfIdealTop
public import TauCeti.AlgebraicGeometry.IdealSheaf.VanishingIdeal
public import TauCeti.AlgebraicGeometry.SpecialFiber.Basic
import TauCeti.AlgebraicGeometry.SpecialFiber.Components

/-!
# The special fibre as the zero scheme of the maximal ideal

Let `X → Spec R` be a scheme over a local ring `R` with maximal ideal `𝔪`. Its special fibre is the
base change `X ×_{Spec R} Spec (R ⧸ 𝔪)`, a closed subscheme of `X`. This file identifies that closed
subscheme: its ideal sheaf is the quasi-coherent ideal sheaf `𝔪·𝒪_X` generated by the pullbacks of
the elements of `𝔪`. When `𝔪 = (π)` is principal, for instance when `R` is a discrete valuation
ring and `π` a uniformizer, the special fibre is therefore the zero scheme `V(π)` of the single
global function `π` pulled back to `X`.

The identification `X_s = V(π)` holds for every scheme over `R`: this file places no hypothesis on
`X`. Whether `V(π)` is an effective Cartier divisor is a separate question, which depends on `X`:
it is one exactly when the pullback of `π` is a non-zero-divisor locally on `X`, as it is when `π`
is a non-zero-divisor of `R` (for instance a uniformizer of a discrete valuation ring) and `X` is
flat over `R`, and it fails for instance for `X = Spec (R ⧸ 𝔪)`, where `π` pulls back to zero and
`X_s = X`. For a discrete valuation ring and an integral, locally Noetherian `X` flat over
`R`, this file and `TauCeti.AlgebraicGeometry.SpecialFiber.Components` give the two halves of
`X_s = div_X(π)`: the Weil divisor of `π` is supported on the components of `X_s` with their
multiplicities, and the closed subscheme cut out by the equation `π` is `X_s` itself.
`TauCeti.AlgebraicGeometry.SpecialFiber.EffectiveCartier` proves that, for `X` flat over `R` and
`π` a nonzerodivisor, `X_s` is an effective Cartier divisor with trivial ideal sheaf. Comparing
this effective Cartier divisor with the Weil divisor of `π` is not done here.

This file also constructs the **reduced special fibre** `X_{s,red}` (`TauCeti.reducedSpecialFiber`),
the reduced induced closed subscheme on `toBase ⁻¹' {closedPoint R}`, together with its
factorization through `X_s` (`TauCeti.reducedSpecialFiberToSpecialFiber`), the universal
factorization criterion for morphisms from reduced schemes
(`TauCeti.existsUnique_comp_reducedSpecialFiberι_iff`), and the closed-subscheme embedding
`TauCeti.subschemeToReducedSpecialFiber`.

## Main results

* `TauCeti.ker_specialFiberι`: the ideal sheaf of the special fibre is `𝔪·𝒪_X`;
* `TauCeti.ker_specialFiberι_eq_ofIdealTop_span`: when `𝔪 = (π)`, it is the ideal sheaf generated
  by the pullback of `π`;
* `TauCeti.specialFiberIsoSubscheme`: the special fibre is isomorphic over `X` to the zero scheme
  of `𝔪·𝒪_X`, and `TauCeti.isPullback_subschemeι_specialFiber` records the resulting pullback
  square.
* `TauCeti.subschemeToSpecialFiber`: a closed subscheme of `X` contained in the special fibre,
  that is, whose ideal sheaf contains `𝔪·𝒪_X`, is a closed subscheme of the special fibre,
  compatibly with closed-subscheme inclusions (`TauCeti.inclusion_subschemeToSpecialFiber`);
* `TauCeti.subschemeOverResidueField`: such a closed subscheme is a scheme over the residue field
  of `R`, proper when `X` is proper over `R`
  (`TauCeti.isProper_subschemeOverResidueField`). Two such closed subschemes have the same
  structure morphism on their intersection (`TauCeti.pullback_fst_subschemeToSpecialFiber`). For
  instance, the irreducible components of the special fibre, with their reduced structures, are
  schemes over the residue field in this way.
* `TauCeti.reducedSpecialFiber`, `TauCeti.reducedSpecialFiberToSpecialFiber`, and
  `TauCeti.isIso_reducedSpecialFiberToSpecialFiber_iff`: the reduced special fibre `X_{s,red}`,
  its closed immersion into `X_s`, and equivalence of `X_{s,red} ≅ X_s` with `IsReduced X_s`.
* `TauCeti.existsUnique_comp_reducedSpecialFiberι_iff` and
  `TauCeti.subschemeToReducedSpecialFiber`: universal property of `X_{s,red}` for morphisms from
  reduced schemes and closed subschemes whose ideal sheaf contains
  `(reducedSpecialFiberι R toBase).ker`.

## References

* [The Stacks Project, Section 55.9](https://stacks.math.columbia.edu/tag/0C9U), the special fibre
  of a regular model as the divisor of a uniformizer.
-/

public section

noncomputable section

open CategoryTheory Limits AlgebraicGeometry IsLocalRing

namespace TauCeti

universe u

variable (R : Type u) [CommRing R] [IsLocalRing R] {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))

/-- **The special fibre is cut out by the maximal ideal.** The ideal sheaf of the special fibre of
a scheme over a local ring is the ideal sheaf `𝔪·𝒪_X` generated by the pullbacks of the elements of
the maximal ideal `𝔪` of the base. -/
theorem ker_specialFiberι :
    (specialFiberι R toBase).ker =
      Scheme.IdealSheafData.ofIdealTop
        ((maximalIdeal R).map (toBase.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom)) := by
  have := isClosedImmersion_Spec_map_residue R
  rw [specialFiberι, Scheme.Hom.ker_pullback_fst_Spec_map, CommRingCat.hom_ofHom,
    ResidueField.algebraMap_eq, ker_residue]

variable {R}

/-- **The special fibre is the zero scheme of a uniformizer.** If the maximal ideal of the base is
generated by `π`, the ideal sheaf of the special fibre is generated by the pullback of `π`: the
special fibre is the zero scheme `V(π)` of the pullback of `π` to the total space. -/
theorem ker_specialFiberι_eq_ofIdealTop_span {π : R} (hπ : maximalIdeal R = Ideal.span {π}) :
    (specialFiberι R toBase).ker =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.span {toBase.appTop ((Scheme.ΓSpecIso (.of R)).inv π)}) := by
  rw [ker_specialFiberι, hπ, Ideal.map_span, Set.image_singleton, RingHom.comp_apply]

variable (R)

/-- The special fibre of a scheme over a local ring is isomorphic, as a closed subscheme of the
total space, to the zero scheme of the ideal sheaf `𝔪·𝒪_X` generated by the maximal ideal of the
base. -/
noncomputable def specialFiberIsoSubscheme :
    (specialFiber R toBase).left ≅
      (Scheme.IdealSheafData.ofIdealTop
        ((maximalIdeal R).map
          (toBase.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom))).subscheme :=
  haveI := isClosedImmersion_specialFiberι R toBase
  have h := (Scheme.IdealSheafData.ker_subschemeι _).trans (ker_specialFiberι R toBase).symm
  haveI := IsClosedImmersion.isIso_lift _ (specialFiberι R toBase) h
  asIso (IsClosedImmersion.lift _ (specialFiberι R toBase) h.le)

/-- The identification of the special fibre with the zero scheme of `𝔪·𝒪_X` is compatible with the
inclusions into the total space. -/
@[reassoc (attr := simp)]
lemma specialFiberIsoSubscheme_hom_subschemeι :
    (specialFiberIsoSubscheme R toBase).hom ≫
        (Scheme.IdealSheafData.ofIdealTop
          ((maximalIdeal R).map
            (toBase.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom))).subschemeι =
      specialFiberι R toBase :=
  IsClosedImmersion.lift_fac _ _ _

/-- The inverse identification of the zero scheme of `𝔪·𝒪_X` with the special fibre is compatible
with the inclusions into the total space. -/
@[reassoc (attr := simp)]
lemma specialFiberIsoSubscheme_inv_specialFiberι :
    (specialFiberIsoSubscheme R toBase).inv ≫ specialFiberι R toBase =
      (Scheme.IdealSheafData.ofIdealTop
        ((maximalIdeal R).map
          (toBase.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom))).subschemeι := by
  rw [Iso.inv_comp_eq, specialFiberIsoSubscheme_hom_subschemeι]

/-- The zero scheme of `𝔪·𝒪_X`, with its inclusion into the total space and its induced morphism
to the spectrum of the residue field, is a pullback of `X → Spec R` and `Spec (R ⧸ 𝔪) → Spec R`:
it is the special fibre. -/
theorem isPullback_subschemeι_specialFiber :
    IsPullback
      (Scheme.IdealSheafData.ofIdealTop
        ((maximalIdeal R).map
          (toBase.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom))).subschemeι
      ((specialFiberIsoSubscheme R toBase).inv ≫ (specialFiber R toBase).hom)
      toBase (Spec.map (CommRingCat.ofHom (algebraMap R (ResidueField R)))) :=
  (isPullback_specialFiber R toBase).of_iso (specialFiberIsoSubscheme R toBase) (Iso.refl _)
    (Iso.refl _) (Iso.refl _)
    ((Category.comp_id _).trans (specialFiberIsoSubscheme_hom_subschemeι R toBase).symm)
    (by rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]) (by simp) (by simp)

section ResidueField

variable {R toBase}

/-- A closed subscheme of `X` contained in the special fibre, in the sense that its ideal sheaf
contains the ideal sheaf `𝔪·𝒪_X` of the special fibre, is a closed subscheme of the special
fibre. -/
noncomputable def subschemeToSpecialFiber {I : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) : I.subscheme ⟶ (specialFiber R toBase).left :=
  haveI := isClosedImmersion_specialFiberι R toBase
  IsClosedImmersion.lift _ I.subschemeι (by rwa [Scheme.IdealSheafData.ker_subschemeι])

/-- The inclusion of a closed subscheme contained in the special fibre factors through the special
fibre. -/
@[reassoc (attr := simp)]
lemma subschemeToSpecialFiber_specialFiberι {I : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) :
    subschemeToSpecialFiber hI ≫ specialFiberι R toBase = I.subschemeι :=
  haveI := isClosedImmersion_specialFiberι R toBase
  IsClosedImmersion.lift_fac _ _ _

/-- A closed subscheme contained in the special fibre is a closed subscheme of the special
fibre. -/
lemma isClosedImmersion_subschemeToSpecialFiber {I : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) : IsClosedImmersion (subschemeToSpecialFiber hI) := by
  have := isClosedImmersion_specialFiberι R toBase
  have : IsClosedImmersion (subschemeToSpecialFiber hI ≫ specialFiberι R toBase) := by
    rw [subschemeToSpecialFiber_specialFiberι]
    infer_instance
  exact .of_comp_isClosedImmersion _ (specialFiberι R toBase)

/-- Composing an inclusion of closed subschemes contained in the special fibre with
`subschemeToSpecialFiber` gives `subschemeToSpecialFiber` on the smaller subscheme. -/
@[reassoc (attr := simp)]
lemma inclusion_subschemeToSpecialFiber {I J : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) (hIJ : I ≤ J) :
    Scheme.IdealSheafData.inclusion hIJ ≫ subschemeToSpecialFiber hI =
      subschemeToSpecialFiber (hI.trans hIJ) := by
  have := isClosedImmersion_specialFiberι R toBase
  rw [← cancel_mono (specialFiberι R toBase), Category.assoc,
    subschemeToSpecialFiber_specialFiberι, Scheme.IdealSheafData.inclusion_subschemeι,
    subschemeToSpecialFiber_specialFiberι]

/-- Two closed subschemes contained in the special fibre induce the same morphism to the special
fibre on their intersection. -/
@[reassoc]
lemma pullback_fst_subschemeToSpecialFiber {I J : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) (hJ : (specialFiberι R toBase).ker ≤ J) :
    pullback.fst I.subschemeι J.subschemeι ≫ subschemeToSpecialFiber hI =
      pullback.snd I.subschemeι J.subschemeι ≫ subschemeToSpecialFiber hJ := by
  have := isClosedImmersion_specialFiberι R toBase
  rw [← cancel_mono (specialFiberι R toBase)]
  simp only [Category.assoc, subschemeToSpecialFiber_specialFiberι, pullback.condition]

/-- A closed subscheme of `X` contained in the special fibre is a scheme over the residue field of
`R`, through the special fibre. -/
noncomputable abbrev subschemeOverResidueField {I : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) : I.subscheme.Over (Spec (.of (ResidueField R))) :=
  ⟨subschemeToSpecialFiber hI ≫ (specialFiber R toBase).hom⟩

/-- The structure morphism of a closed subscheme contained in the special fibre is its
factorization through the special fibre and then the spectrum of the residue field. -/
lemma subschemeOverResidueField_over {I : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) :
    letI := subschemeOverResidueField hI
    I.subscheme ↘ Spec (.of (ResidueField R)) =
      subschemeToSpecialFiber hI ≫ (specialFiber R toBase).hom := rfl

/-- For a closed subscheme contained in the special fibre, the structure morphisms to `Spec R`
and to the spectrum of the residue field are compatible. -/
lemma subschemeOverResidueField_comp {I : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) :
    letI := subschemeOverResidueField hI
    (I.subscheme ↘ Spec (.of (ResidueField R))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (ResidueField R))) = I.subschemeι ≫ toBase := by
  rw [subschemeOverResidueField_over, Category.assoc, ← specialFiberι_toBase R toBase,
    ← Category.assoc, subschemeToSpecialFiber_specialFiberι]

/-- A closed subscheme of a proper scheme over `R` contained in the special fibre is proper over the
residue field. -/
lemma isProper_subschemeOverResidueField [IsProper toBase] {I : X.IdealSheafData}
    (hI : (specialFiberι R toBase).ker ≤ I) :
    letI := subschemeOverResidueField hI
    IsProper (I.subscheme ↘ Spec (.of (ResidueField R))) := by
  have := isClosedImmersion_subschemeToSpecialFiber hI
  exact inferInstanceAs (IsProper (subschemeToSpecialFiber hI ≫ pullback.snd toBase _))

end ResidueField

section ReducedSpecialFiber

variable (R : Type u) [CommRing R] [IsLocalRing R] {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))

/-- The **reduced special fibre** `X_{s,red}` of a scheme `X` over a local ring `R`: the reduced
induced closed subscheme on the preimage of the closed point of `Spec R`, realized as the closed
subscheme cut out by `(specialFiberι R toBase).ker.radical`. -/
noncomputable def reducedSpecialFiber : Scheme.{u} :=
  (specialFiberι R toBase).ker.radical.subscheme

/-- The reduced special fibre `X_{s,red}` is a reduced scheme. -/
instance isReduced_reducedSpecialFiber : IsReduced (reducedSpecialFiber R toBase) := by
  rw [reducedSpecialFiber, ← Scheme.IdealSheafData.vanishingIdeal_support]
  infer_instance

/-- The canonical closed immersion `X_{s,red} ⟶ X` of the reduced special fibre into the total
space. -/
noncomputable def reducedSpecialFiberι : reducedSpecialFiber R toBase ⟶ X :=
  (specialFiberι R toBase).ker.radical.subschemeι

/-- The canonical inclusion `X_{s,red} ⟶ X` is a closed immersion. -/
instance isClosedImmersion_reducedSpecialFiberι :
    IsClosedImmersion (reducedSpecialFiberι R toBase) :=
  inferInstanceAs (IsClosedImmersion (specialFiberι R toBase).ker.radical.subschemeι)

/-- As a set, the image of the reduced special fibre in `X` is the preimage of the closed point. -/
@[simp]
theorem range_reducedSpecialFiberι :
    Set.range (reducedSpecialFiberι R toBase) = toBase ⁻¹' {closedPoint R} := by
  have := isClosedImmersion_specialFiberι R toBase
  refine (Scheme.IdealSheafData.range_subschemeι (specialFiberι R toBase).ker.radical).trans ?_
  rw [Scheme.IdealSheafData.support_radical, Scheme.Hom.support_ker, range_specialFiberι R toBase,
    IsClosed.closure_eq]
  exact (isClosed_singleton_closedPoint R).preimage toBase.continuous

/-- The ideal sheaf of the reduced special fibre equals `(specialFiberι R toBase).ker.radical`. -/
lemma ker_reducedSpecialFiberι_eq_radical :
    (reducedSpecialFiberι R toBase).ker = (specialFiberι R toBase).ker.radical := by
  unfold reducedSpecialFiberι
  exact Scheme.IdealSheafData.ker_subschemeι (specialFiberι R toBase).ker.radical

/-- The ideal sheaf of the reduced special fibre is `(specialFiberι R toBase).ker.radical`, which
equals the vanishing ideal of the preimage of the closed point. -/
theorem ker_reducedSpecialFiberι :
    (reducedSpecialFiberι R toBase).ker =
      Scheme.IdealSheafData.vanishingIdeal
        ⟨toBase ⁻¹' {closedPoint R},
          (isClosed_singleton_closedPoint R).preimage toBase.continuous⟩ := by
  rw [ker_reducedSpecialFiberι_eq_radical, ← Scheme.IdealSheafData.vanishingIdeal_support]
  congr 1; ext1
  rw [← Scheme.IdealSheafData.support_radical, ← Scheme.IdealSheafData.range_subschemeι]
  exact range_reducedSpecialFiberι R toBase

variable {R toBase} in
/-- A closed subset of `X` lies in the special fibre if and only if its vanishing ideal contains
the ideal sheaf of the reduced special fibre. -/
theorem ker_reducedSpecialFiberι_le_vanishingIdeal_iff {Z : TopologicalSpace.Closeds X} :
    (reducedSpecialFiberι R toBase).ker ≤ Scheme.IdealSheafData.vanishingIdeal Z ↔
      (Z : Set X) ⊆ toBase ⁻¹' {closedPoint R} := by
  rw [ker_reducedSpecialFiberι, ← Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal,
    ← SetLike.coe_subset_coe, Scheme.IdealSheafData.coe_support_vanishingIdeal]
  -- Unfolds `(⟨toBase ⁻¹' {closedPoint R}, _⟩ : Set X)` (`Closeds.coe_mk`) and
  -- `↥(Spec (.of R)) ≡ PrimeSpectrum R`.
  rfl

/-- The ideal sheaf of the scheme-theoretic special fibre is contained in that of the reduced
special fibre. -/
theorem ker_specialFiberι_le_ker_reducedSpecialFiberι :
    (specialFiberι R toBase).ker ≤ (reducedSpecialFiberι R toBase).ker :=
  (specialFiberι R toBase).ker.le_radical.trans_eq
    (ker_reducedSpecialFiberι_eq_radical R toBase).symm

/-- A morphism `f : Y ⟶ X` from a reduced scheme factors uniquely through
`reducedSpecialFiberι R toBase` if and only if its set-theoretic image lies over the closed point
of `Spec R`. -/
theorem existsUnique_comp_reducedSpecialFiberι_iff {Y : Scheme.{u}} [IsReduced Y] (f : Y ⟶ X) :
    (∃! g : Y ⟶ reducedSpecialFiber R toBase, g ≫ reducedSpecialFiberι R toBase = f) ↔
      Set.range f ⊆ toBase ⁻¹' {closedPoint R} := by
  have := isClosedImmersion_reducedSpecialFiberι R toBase
  refine ⟨?_, fun hf ↦ ?_⟩
  · rintro ⟨g, hg, -⟩ _ ⟨y, rfl⟩
    rw [← hg, Scheme.Hom.comp_apply, ← range_reducedSpecialFiberι R toBase]
    exact ⟨g y, rfl⟩
  · have hker : (reducedSpecialFiberι R toBase).ker ≤ f.ker := by
      rw [ker_reducedSpecialFiberι]
      exact Scheme.IdealSheafData.vanishingIdeal_le_ker_of_range_subset f hf
    refine ⟨IsClosedImmersion.lift (reducedSpecialFiberι R toBase) f hker,
      IsClosedImmersion.lift_fac _ _ _, fun g hg ↦ ?_⟩
    rw [← cancel_mono (reducedSpecialFiberι R toBase), hg, IsClosedImmersion.lift_fac]

/-- The canonical closed immersion `X_{s,red} ⟶ X_s` of the reduced special fibre into the
scheme-theoretic special fibre. -/
noncomputable def reducedSpecialFiberToSpecialFiber :
    reducedSpecialFiber R toBase ⟶ (specialFiber R toBase).left :=
  subschemeToSpecialFiber (specialFiberι R toBase).ker.le_radical

/-- The inclusion of the reduced special fibre into the total space factors through the
scheme-theoretic special fibre. -/
@[reassoc (attr := simp)]
lemma reducedSpecialFiberToSpecialFiber_specialFiberι :
    reducedSpecialFiberToSpecialFiber R toBase ≫ specialFiberι R toBase =
      reducedSpecialFiberι R toBase :=
  subschemeToSpecialFiber_specialFiberι _

/-- The canonical morphism `X_{s,red} ⟶ X_s` is a closed immersion. -/
instance isClosedImmersion_reducedSpecialFiberToSpecialFiber :
    IsClosedImmersion (reducedSpecialFiberToSpecialFiber R toBase) :=
  isClosedImmersion_subschemeToSpecialFiber _

/-- The reduced special fibre is a scheme over the residue field of `R`, through the special
fibre. -/
noncomputable instance reducedSpecialFiberOverResidueField :
    (reducedSpecialFiber R toBase).Over (Spec (.of (ResidueField R))) :=
  ⟨reducedSpecialFiberToSpecialFiber R toBase ≫ (specialFiber R toBase).hom⟩

/-- The structure morphism of `X_{s,red}` over the residue field factors through `X_{s,red} ⟶ X_s`.
-/
lemma reducedSpecialFiber_over :
    reducedSpecialFiber R toBase ↘ Spec (.of (ResidueField R)) =
      reducedSpecialFiberToSpecialFiber R toBase ≫ (specialFiber R toBase).hom :=
  rfl

/-- When `X` is proper over `Spec R`, its reduced special fibre is proper over the residue field. -/
instance isProper_reducedSpecialFiber [IsProper toBase] :
    IsProper (reducedSpecialFiber R toBase ↘ Spec (.of (ResidueField R))) := by
  rw [reducedSpecialFiber_over]
  exact isProper_subschemeOverResidueField (specialFiberι R toBase).ker.le_radical

/-- The canonical closed immersion `X_{s,red} ⟶ X_s` is an isomorphism if and only if the
scheme-theoretic special fibre `X_s` is reduced. -/
theorem isIso_reducedSpecialFiberToSpecialFiber_iff :
    IsIso (reducedSpecialFiberToSpecialFiber R toBase) ↔
      IsReduced (specialFiber R toBase).left := by
  refine ⟨fun _ ↦ (ObjectProperty.prop_iff_of_iso (IsReduced ·)
    (asIso (reducedSpecialFiberToSpecialFiber R toBase))).mp inferInstance, fun _ ↦ ?_⟩
  have : Surjective (reducedSpecialFiberToSpecialFiber R toBase) := ⟨fun y ↦ ?_⟩
  · exact isIso_of_isClosedImmersion_of_surjective (reducedSpecialFiberToSpecialFiber R toBase)
  · have hy : specialFiberι R toBase y ∈ Set.range (reducedSpecialFiberι R toBase) := by
      rw [range_reducedSpecialFiberι, ← range_specialFiberι R toBase]
      exact ⟨y, rfl⟩
    obtain ⟨x, hx⟩ := hy
    have := isClosedImmersion_specialFiberι R toBase
    refine ⟨x, (specialFiberι R toBase).isClosedEmbedding.injective ?_⟩
    rw [← Scheme.Hom.comp_apply, reducedSpecialFiberToSpecialFiber_specialFiberι, hx]

section Subscheme

variable {R toBase}

/-- A closed subscheme of `X` whose ideal sheaf contains `(reducedSpecialFiberι R toBase).ker`
embeds as a closed subscheme of the reduced special fibre `X_{s,red}`. -/
noncomputable def subschemeToReducedSpecialFiber {I : X.IdealSheafData}
    (hI : (reducedSpecialFiberι R toBase).ker ≤ I) :
    I.subscheme ⟶ reducedSpecialFiber R toBase :=
  Scheme.IdealSheafData.inclusion
    ((ker_reducedSpecialFiberι_eq_radical R toBase).symm.trans_le hI)

/-- The inclusion of a closed subscheme whose ideal sheaf contains
`(reducedSpecialFiberι R toBase).ker` factors through `X_{s,red}`. -/
@[reassoc (attr := simp)]
lemma subschemeToReducedSpecialFiber_reducedSpecialFiberι {I : X.IdealSheafData}
    (hI : (reducedSpecialFiberι R toBase).ker ≤ I) :
    subschemeToReducedSpecialFiber hI ≫ reducedSpecialFiberι R toBase = I.subschemeι :=
  Scheme.IdealSheafData.inclusion_subschemeι _

/-- A closed subscheme of `X` whose ideal sheaf contains `(reducedSpecialFiberι R toBase).ker`
is a closed subscheme of `X_{s,red}`. -/
instance isClosedImmersion_subschemeToReducedSpecialFiber {I : X.IdealSheafData}
    (hI : (reducedSpecialFiberι R toBase).ker ≤ I) :
    IsClosedImmersion (subschemeToReducedSpecialFiber hI) :=
  inferInstanceAs (IsClosedImmersion (Scheme.IdealSheafData.inclusion _))

/-- Composing the inclusion into `X_{s,red}` with `X_{s,red} ⟶ X_s` recovers the inclusion into
`X_s`. -/
@[reassoc (attr := simp)]
lemma subschemeToReducedSpecialFiber_reducedSpecialFiberToSpecialFiber {I : X.IdealSheafData}
    (hI : (reducedSpecialFiberι R toBase).ker ≤ I) :
    subschemeToReducedSpecialFiber hI ≫ reducedSpecialFiberToSpecialFiber R toBase =
      subschemeToSpecialFiber
        ((ker_specialFiberι_le_ker_reducedSpecialFiberι R toBase).trans hI) := by
  have := isClosedImmersion_specialFiberι R toBase
  rw [← cancel_mono (specialFiberι R toBase), Category.assoc,
    reducedSpecialFiberToSpecialFiber_specialFiberι,
    subschemeToReducedSpecialFiber_reducedSpecialFiberι, subschemeToSpecialFiber_specialFiberι]

