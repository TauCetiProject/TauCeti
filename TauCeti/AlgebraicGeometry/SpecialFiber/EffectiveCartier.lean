module

public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Invertible
public import TauCeti.AlgebraicGeometry.SpecialFiber.Subscheme

/-!
# The special fibre of a flat scheme is an effective Cartier divisor

Let `R` be a local ring whose maximal ideal is generated by a nonzerodivisor `π`, for instance a
discrete valuation ring with a uniformizer `π`, and let `X → Spec R` be flat. The special fibre
`X_s` is the zero scheme of the pullback of `π` to `X`
(`TauCeti.ker_specialFiberι_eq_ofIdealTop_span`). By flatness the pullback of `π` stays a
nonzerodivisor on every affine open of `X`, so `X_s` is an effective Cartier divisor on `X`, with
the single global equation `π`. Its ideal sheaf `𝒪_X(-X_s)` is therefore trivial: multiplication
by `π` is an isomorphism `𝒪_X ≅ 𝒪_X(-X_s)`.

This is the scheme-theoretic half of the description `X_s = div_X(π) = ∑ᵢ mᵢ [Cᵢ]` of the special
fibre of a model of a curve over a discrete valuation ring, whose Weil-divisor half is
`AlgebraicGeometry.Scheme.Hom.mem_support_principalDivisor_appTop`. Identifying this effective
Cartier divisor with the Weil divisor `∑ᵢ mᵢ [Cᵢ]` is not done here. The triviality of
`𝒪_X(X_s)` is what makes the special fibre numerically trivial on its own components, the source
of the relations `∑ⱼ aᵢⱼ mⱼ = 0` satisfied by the intersection matrix of the components.

## Main results

* `TauCeti.isEffectiveCartier_ker_specialFiberι`: the special fibre of a flat scheme over `R` is an
  effective Cartier divisor;
  `TauCeti.isEffectiveCartier_ker_specialFiberι_of_isDiscreteValuationRing` is the case of a
  discrete valuation ring, where no uniformizer needs to be chosen.
* `TauCeti.unitIsoKerSpecialFiberι`: multiplication by `π` trivializes the ideal sheaf of the
  special fibre, `𝒪_X ≅ 𝒪_X(-X_s)` (`TauCeti.sheafι_app_unitIsoKerSpecialFiberι_hom`).

## References

* [The Stacks Project, Section 55.9](https://stacks.math.columbia.edu/tag/0C9U), where the special
  fibre of a regular model is the effective Cartier divisor of a uniformizer.
* Q. Liu, *Algebraic Geometry and Arithmetic Curves*, Section 8.3, on the special fibre of an
  arithmetic surface as a principal divisor.
-/

public section

noncomputable section

open CategoryTheory Opposite AlgebraicGeometry IsLocalRing

namespace TauCeti

universe u

section Local

variable {R : Type u} [CommRing R] {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R)) [Flat toBase]
  {π : R} [IsLocalRing R]

omit [Flat toBase] in
/-- On every affine open `U`, the ideal of the special fibre is generated by the pullback of a
generator `π` of the maximal ideal. -/
private lemma ideal_ker_specialFiberι (hπ : maximalIdeal R = Ideal.span {π}) (U : X.affineOpens) :
    (specialFiberι R toBase).ker.ideal U = Ideal.span
      {X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op
        (toBase.appTop ((Scheme.ΓSpecIso (.of R)).inv π))} := by
  rw [ker_specialFiberι_eq_ofIdealTop_span toBase hπ, Scheme.IdealSheafData.ofIdealTop_ideal,
    Ideal.map_span, Set.image_singleton]

/-- **The special fibre is an effective Cartier divisor.** If the maximal ideal of the local ring
`R` is generated by a nonzerodivisor `π` and `X` is flat over `R`, then the special fibre of `X`
is an effective Cartier divisor on `X`, cut out by the pullback of `π`. -/
theorem isEffectiveCartier_ker_specialFiberι (hπ : maximalIdeal R = Ideal.span {π})
    (hreg : IsSMulRegular R π) : (specialFiberι R toBase).ker.IsEffectiveCartier := by
  rw [ker_specialFiberι_eq_ofIdealTop_span toBase hπ]
  exact toBase.isEffectiveCartier_ofIdealTop_span_appTop (Scheme.isSMulRegular_ΓSpecIso_inv hreg)

/-- **The ideal sheaf of the special fibre is trivial.** If the maximal ideal of the local ring
`R` is generated by a nonzerodivisor `π` and `X` is flat over `R`, then multiplication by the
pullback of `π` is an isomorphism `𝒪_X ≅ 𝒪_X(-X_s)` onto the ideal sheaf of the special fibre
(`sheafι_app_unitIsoKerSpecialFiberι_hom`). -/
def unitIsoKerSpecialFiberι (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π) :
    SheafOfModules.unit X.ringCatSheaf ≅ (specialFiberι R toBase).ker.sheaf :=
  (specialFiberι R toBase).ker.unitIsoOfForallIdealEqSpan
    (toBase.isSMulRegular_map_appTop_ΓSpecIso_inv hreg) (ideal_ker_specialFiberι toBase hπ)

/-- The trivialization `unitIsoKerSpecialFiberι` is multiplication by `π`: composed with the
inclusion of the ideal sheaf of the special fibre into `𝒪_X`, it sends a function `r` over `V`
to the product of `r` with the restriction of the pullback of `π`. -/
@[simp]
lemma sheafι_app_unitIsoKerSpecialFiberι_hom (hπ : maximalIdeal R = Ideal.span {π})
    (hreg : IsSMulRegular R π) (V : X.Opens) (r : Γ(X, V)) :
    Scheme.Modules.Hom.app (specialFiberι R toBase).ker.sheafι V
        ((unitIsoKerSpecialFiberι toBase hπ hreg).hom.val.app (op V) r) =
      X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op
        (toBase.appTop ((Scheme.ΓSpecIso (.of R)).inv π)) * r :=
  Scheme.IdealSheafData.sheafι_app_unitIsoOfForallIdealEqSpan_hom _ _ _ V r

end Local

section DiscreteValuationRing

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] {X : Scheme.{u}}
  (toBase : X ⟶ Spec (.of R)) [Flat toBase]

/-- **The special fibre over a discrete valuation ring is an effective Cartier divisor.** The
special fibre of a scheme flat over a discrete valuation ring is an effective Cartier divisor,
cut out by the pullback of any uniformizer. -/
theorem isEffectiveCartier_ker_specialFiberι_of_isDiscreteValuationRing :
    (specialFiberι R toBase).ker.IsEffectiveCartier := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  exact isEffectiveCartier_ker_specialFiberι toBase
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ)
    (IsSMulRegular.of_ne_zero hπ.ne_zero)

end DiscreteValuationRing

end TauCeti

end
