module

public import TauCeti.AlgebraicGeometry.CartierDivisor.Excision
public import TauCeti.AlgebraicGeometry.SpecialFiber.Components

/-!
# Generic-fibre Picard excision over a discrete valuation ring

For a Noetherian locally factorial integral scheme `toBase : X ⟶ Spec R` over a DVR `R` with
fraction field `K` whose generic point lies outside the special fibre, this file specializes
open-immersion Picard excision (`TauCeti.AlgebraicGeometry.CartierDivisor.Excision`) to the
generic fibre `genericFiberι R K toBase`:

* `AlgebraicGeometry.Scheme.Hom.pullback_genericFiberι_surjective`: `Pic(X) → Pic(X_K)` is
  surjective.
* `AlgebraicGeometry.Scheme.Hom.pullback_genericFiberι_eq_one_iff`: `ker(Pic(X) → Pic(X_K))` is
  generated by `primeDivisorClass` of the special-fibre components `C_i`.
* `AlgebraicGeometry.Scheme.Hom.pullback_genericFiberι_surjective_of_isRegular` and
  `AlgebraicGeometry.Scheme.Hom.pullback_genericFiberι_eq_one_iff_of_isRegular`: specializations
  to regular schemes of dimension at most two.

## References

* R. Hartshorne, *Algebraic Geometry*, Chapter II, Proposition 6.5(c);
  [Stacks, Tag 0BE9](https://stacks.math.columbia.edu/tag/0BE9) and
  [Tag 02RX](https://stacks.math.columbia.edu/tag/02RX).
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing Order TauCeti TauCeti.AlgebraicGeometry
open TauCeti.AlgebraicGeometry.LineBundleClass (pullback primeDivisorClass)
open AlgebraicGeometry.Scheme.IdealSheafData
  (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular)

universe u

namespace AlgebraicGeometry.Scheme.Hom

variable {R : Type u} (K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [CommRing K] [Algebra R K] [IsFractionRing R K] {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R))
  [IsIntegral X] [IsNoetherian X]

/-- Surjectivity of `Pic(X) → Pic(X_K)` on a Noetherian locally factorial integral scheme over a
DVR `R`. -/
theorem pullback_genericFiberι_surjective
    [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] :
    Function.Surjective (pullback (genericFiberι R K toBase)) :=
  have := isOpenImmersion_genericFiberι R K toBase
  LineBundleClass.pullback_surjective_of_isOpenImmersion (genericFiberι R K toBase)

/-- Kernel of `Pic(X) → Pic(X_K)` on a Noetherian locally factorial integral scheme over a DVR `R`
whose generic point lies outside the special fibre: `a` restricts to `1` iff it is a product of
powers of the component classes `[𝒪_X(C_i)]`. -/
theorem pullback_genericFiberι_eq_one_iff
    [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)]
    (hη : toBase (genericPoint X) ≠ closedPoint R) {a : LineBundleClass X} :
    pullback (genericFiberι R K toBase) a = 1 ↔
      ∃ v : (toBase.finite_setOf_base_eq_closedPoint
          (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset → ℤ,
        a = ∏ i, primeDivisorClass i.val ^ v i :=
  have := isOpenImmersion_genericFiberι R K toBase
  LineBundleClass.pullback_eq_one_iff_exists_prod_of_isOpenImmersion (genericFiberι R K toBase)
    fun _ ↦ by rw [range_genericFiberι_of_isDiscreteValuationRing]; simp

/-- Surjectivity of `Pic(X) → Pic(X_K)` on a regular Noetherian integral scheme of dimension at
most two over a DVR `R`. -/
theorem pullback_genericFiberι_surjective_of_isRegular
    [TauCeti.AlgebraicGeometry.IsRegular X] (hX : ∀ x : X, coheight x ≤ 2) :
    Function.Surjective (pullback (genericFiberι R K toBase)) :=
  have := fun x ↦ TauCeti.AlgebraicGeometry.IsRegular.uniqueFactorizationMonoid_stalk x (hX x)
  toBase.pullback_genericFiberι_surjective K

/-- Exact kernel of `Pic(X) → Pic(X_K)` on a regular Noetherian integral scheme of dimension at
most two over a DVR `R` with generic point outside the special fibre. -/
theorem pullback_genericFiberι_eq_one_iff_of_isRegular
    [TauCeti.AlgebraicGeometry.IsRegular X] (hX : ∀ x : X, coheight x ≤ 2)
    (hη : toBase (genericPoint X) ≠ closedPoint R) {a : LineBundleClass X} :
    pullback (genericFiberι R K toBase) a = 1 ↔
      ∃ v : (toBase.finite_setOf_base_eq_closedPoint
          (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset → ℤ,
        a = ∏ i, (LineBundleClass.mk
          (isEffectiveCartier_vanishingIdeal_closure_singleton_of_isRegular hX
            i.val.property).toInvertibleSheaf)⁻¹ ^ v i := by
  have := fun x ↦ TauCeti.AlgebraicGeometry.IsRegular.uniqueFactorizationMonoid_stalk x (hX x)
  simpa only [LineBundleClass.primeDivisorClass_def] using
    toBase.pullback_genericFiberι_eq_one_iff K hη (a := a)

end AlgebraicGeometry.Scheme.Hom

end
