module

public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Factorial
public import TauCeti.AlgebraicGeometry.SpecialFiber.Divisor
public import TauCeti.AlgebraicGeometry.SpecialFiber.Subscheme

/-!
# The special fibre of a regular model as a sum of its components

Let `R` be a local ring of dimension at most one whose maximal ideal is generated by an
element `π`, for instance a discrete valuation ring with a uniformizer, and let `X` be a regular
Noetherian integral scheme over `R` all of whose points have codimension at most two, such as a
regular model of a curve over `R`. Suppose that the generic point of `X` does not map to the
closed point. The special fibre `X_s` is the zero scheme of the pullback of `π`
(`TauCeti.ker_specialFiberι_eq_ofIdealTop_span`), and its irreducible components `Cᵢ` are the
closures of the finitely many codimension-one points of `X` over the closed point, with
multiplicities `mᵢ = ord_{Cᵢ}(π)`
(`AlgebraicGeometry.Scheme.Hom.principalDivisor_eq_sum_specialFiber` records
`div(π) = Σ mᵢ [Cᵢ]` as Weil divisors).

This file proves the same decomposition for ideal sheaves, that is, for effective Cartier
divisors:

`𝒪_X(-X_s) = ∏ᵢ 𝒪_X(-Cᵢ)^{mᵢ}`,

where `𝒪_X(-Cᵢ)` is the ideal sheaf of `Cᵢ` with its reduced induced structure, an effective
Cartier divisor because `X` is locally factorial. It is the special case `f = π` of the
decomposition of principal divisors on locally factorial schemes,
`AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop_span_singleton_eq_prod_vanishingIdeal`.
Since `𝒪_X(-X_s)` is trivial for `X` flat over `R`, this is the linear equivalence
`Σⱼ mⱼ Cⱼ ∼ 0`. When the components are proper curves over the residue field, for instance for a
proper regular model of a curve, taking degrees on each `Cᵢ` gives the relation
`Σⱼ mⱼ (Cᵢ · Cⱼ) = 0` between their intersection numbers.

## Main results

* `AlgebraicGeometry.Scheme.Hom.ker_specialFiberι_eq_prod_vanishingIdeal`: the ideal sheaf of the
  special fibre is the product of the ideal sheaves of its components, raised to their
  multiplicities.

## References

* [The Stacks Project, Section 55.9](https://stacks.math.columbia.edu/tag/0C5Y), the special
  fibre of a regular model as the effective Cartier divisor `Σ mᵢ Cᵢ`.
* Q. Liu, *Algebraic Geometry and Arithmetic Curves*, Section 9.1, the special fibre as a divisor
  on a regular fibred surface.
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing Order

namespace TauCeti

universe u

variable {R : Type u} [CommRing R] [IsLocalRing R] [Ring.DimensionLEOne R]
  {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R)) [IsIntegral X] [IsNoetherian X]
  [TauCeti.AlgebraicGeometry.IsRegular X]

/-- **The special fibre of a regular model is the sum of its components.** Let `X` be a regular
Noetherian integral scheme over a local ring `R` of dimension at most one, with all points of
codimension at most two and generic point away from the closed point, and let the maximal ideal
of `R` be generated by `π`. Then the ideal sheaf of the special fibre is the product, over the
finitely many components `Cᵢ` of the special fibre, of the ideal sheaves of the `Cᵢ` with their
reduced structures raised to the multiplicities `mᵢ = ord_{Cᵢ}(π)`. -/
theorem _root_.AlgebraicGeometry.Scheme.Hom.ker_specialFiberι_eq_prod_vanishingIdeal
    (hX : ∀ x : X, coheight x ≤ 2)
    (hη : toBase (genericPoint X) ≠ closedPoint R) {π : R}
    (hπ : maximalIdeal R = Ideal.span {π}) :
    (specialFiberι R toBase).ker = ∏ η ∈ (toBase.finite_setOf_base_eq_closedPoint
        (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset,
      Scheme.IdealSheafData.vanishingIdeal ⟨closure {(η : X)}, isClosed_closure⟩ ^
        toBase.specialFiberMultiplicity π η := by
  have hπm : π ∈ maximalIdeal R := hπ ▸ Ideal.mem_span_singleton_self π
  -- If `R` is a field, then the generic point maps to the closed point, the only point of `Spec R`.
  have hπ0 := toBase.ne_zero_of_base_ne_closedPoint hη hπ
  have := fun x ↦ TauCeti.AlgebraicGeometry.IsRegular.uniqueFactorizationMonoid_stalk x (hX x)
  rw [ker_specialFiberι_eq_ofIdealTop_span toBase hπ,
    Scheme.IdealSheafData.ofIdealTop_span_singleton_eq_prod_vanishingIdeal
      (toBase.appTop_ΓSpecIso_inv_ne_zero hη hπm hπ0) _ fun η hpos ↦ by
        rw [Set.Finite.mem_toFinset, Set.mem_ofPred_eq]
        exact (toBase.ord_germToFunctionField_appTop_pos_iff hη hπm hπ0 η.2).mp hpos]
  refine Finset.prod_congr rfl fun η _ ↦ ?_
  rw [← toBase.specialFiberMultiplicity_coe π η, Int.toNat_natCast]

end TauCeti
