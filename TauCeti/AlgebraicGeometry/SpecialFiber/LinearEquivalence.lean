module

public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.TensorProduct
public import TauCeti.AlgebraicGeometry.SpecialFiber.Decomposition
public import TauCeti.AlgebraicGeometry.SpecialFiber.EffectiveCartier
public import TauCeti.AlgebraicGeometry.SpecialFiber.Vertical

/-!
# The special fibre is linearly equivalent to zero

Let `R` be a local ring of dimension at most one whose maximal ideal is generated by a
nonzerodivisor `π`, for instance a discrete valuation ring with a uniformizer, and let `X` be a
Noetherian locally factorial integral scheme, flat over `R`, whose generic point lies outside the
special fibre. The special fibre is the effective Cartier divisor `X_s = Σᵢ mᵢ Cᵢ`, where the `Cᵢ`
are its irreducible components with their reduced structures and `mᵢ` their multiplicities
(`AlgebraicGeometry.Scheme.Hom.ker_specialFiberι_eq_prod_vanishingIdeal`), and its ideal sheaf is
trivial, generated by the global function `π`
(`TauCeti.mk_toInvertibleSheaf_ker_specialFiberι`). Hence the divisor `Σᵢ mᵢ Cᵢ` is linearly
equivalent to zero: in the Picard group of `X`,

`∏ᵢ [𝒪_X(Cᵢ)] ^ mᵢ = 1`.

Taking degrees on proper curves gives the numerical triviality of the special fibre, in
`TauCeti.AlgebraicGeometry.IntersectionNumber.SpecialFiber`.

## Main results

* `AlgebraicGeometry.Scheme.Hom.prod_inv_mk_toInvertibleSheaf_vanishingIdeal_pow_eq_one`: the
  divisor `Σᵢ mᵢ Cᵢ` of the special fibre is linearly equivalent to zero.
* `AlgebraicGeometry.Scheme.Hom.multiplicity_mem_ker_verticalLineBundleLinear`: the multiplicity
  vector lies in `ker verticalLineBundleLinear`.

## References

* [The Stacks Project, Section 55.9](https://stacks.math.columbia.edu/tag/0C5Y), where the special
  fibre of a regular model is the effective Cartier divisor of a uniformizer.
* Q. Liu, *Algebraic Geometry and Arithmetic Curves*, Section 9.1, on the special fibre as a
  principal divisor on a regular fibred surface.
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing Order
open TauCeti TauCeti.AlgebraicGeometry
open AlgebraicGeometry.Scheme.IdealSheafData (vanishingIdeal
  isEffectiveCartier_vanishingIdeal_closure_singleton)

universe u

namespace AlgebraicGeometry.Scheme.Hom

variable {R : Type u} [CommRing R] [IsLocalRing R] [Ring.DimensionLEOne R]
  {X : Scheme.{u}} (toBase : X ⟶ Spec (.of R)) [Flat toBase] [IsIntegral X] [IsNoetherian X]
  [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)]

/-- **The special fibre is linearly equivalent to zero.** Let `X` be a Noetherian locally factorial
integral scheme, flat over a local ring `R` of dimension at most one whose maximal ideal is
generated by a nonzerodivisor `π`, with generic point away from the closed point. Then the divisor
`Σᵢ mᵢ Cᵢ` of the components `Cᵢ` of the special fibre, with their multiplicities `mᵢ`, is linearly
equivalent to zero: `∏ᵢ [𝒪_X(Cᵢ)] ^ mᵢ = 1` in the Picard group of `X`. -/
theorem prod_inv_mk_toInvertibleSheaf_vanishingIdeal_pow_eq_one
    (hη : toBase (genericPoint X) ≠ closedPoint R) {π : R}
    (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π) :
    ∏ η ∈ (toBase.finite_setOf_base_eq_closedPoint
        (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset,
      (LineBundleClass.mk (isEffectiveCartier_vanishingIdeal_closure_singleton
        η.property).toInvertibleSheaf)⁻¹ ^ toBase.specialFiberMultiplicity π η = 1 := by
  have hC (η : CodimensionOnePoint X) :=
    isEffectiveCartier_vanishingIdeal_closure_singleton η.property
  -- The ideal sheaf `𝒪_X(-X_s) = ∏ᵢ 𝒪_X(-Cᵢ) ^ mᵢ` has trivial class.
  have h := mk_toInvertibleSheaf_ker_specialFiberι toBase hπ hreg
    (isEffectiveCartier_ker_specialFiberι toBase hπ hreg)
  rw [LineBundleClass.mk_toInvertibleSheaf_congr _
      (isEffectiveCartier_prod fun η _ ↦ isEffectiveCartier_pow (hC η) _)
      (toBase.ker_specialFiberι_eq_prod_vanishingIdeal hη hπ),
    LineBundleClass.mk_toInvertibleSheaf_prod _ fun η _ ↦ isEffectiveCartier_pow (hC η) _,
    Finset.prod_attach _ fun η ↦
      LineBundleClass.mk (isEffectiveCartier_pow (hC η) _).toInvertibleSheaf,
    Finset.prod_congr rfl fun η _ ↦ LineBundleClass.mk_toInvertibleSheaf_pow (hC η) _] at h
  simp only [inv_pow, Finset.prod_inv_distrib, h, inv_one]

/-- The multiplicity vector `i ↦ mᵢ` lies in `ker verticalLineBundleLinear` since
`div(π) = ∑ᵢ mᵢ Cᵢ` is principal and therefore defines the trivial line bundle. -/
theorem multiplicity_mem_ker_verticalLineBundleLinear
    (hη : toBase (genericPoint X) ≠ closedPoint R) {π : R}
    (hπ : maximalIdeal R = Ideal.span {π}) (hreg : IsSMulRegular R π) :
    (fun i : (toBase.finite_setOf_base_eq_closedPoint
        (toBase.maximalIdeal_ne_bot_of_base_ne_closedPoint hη) hη).toFinset ↦
      (toBase.specialFiberMultiplicity π i : ℤ)) ∈
      LinearMap.ker (toBase.verticalLineBundleLinear hη) := by
  rw [LinearMap.mem_ker]
  refine Additive.toMul.injective ?_
  rw [toMul_verticalLineBundleLinear_apply, toMul_zero]
  refine (Finset.prod_congr rfl fun i _ ↦ ?_).trans ((Finset.prod_coe_sort _ fun η ↦
    (LineBundleClass.mk (isEffectiveCartier_vanishingIdeal_closure_singleton
      η.property).toInvertibleSheaf)⁻¹ ^ toBase.specialFiberMultiplicity π η).trans
    (toBase.prod_inv_mk_toInvertibleSheaf_vanishingIdeal_pow_eq_one hη hπ hreg))
  rw [zpow_natCast]

end AlgebraicGeometry.Scheme.Hom
