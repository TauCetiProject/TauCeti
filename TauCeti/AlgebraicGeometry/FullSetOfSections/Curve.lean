/-!
# Full sets of sections on smooth curves and sums of section divisors

Let `f : X ⟶ S` be a separated smooth morphism of relative dimension one, `Z ⊆ X` a closed
subscheme finite locally free over `S`, and `s₁, …, s_r` sections of `Z ⟶ S` inducing sections
`xᵢ = sᵢ ≫ i : S ⟶ X` of `f`. Each `xᵢ` cuts out a relative effective Cartier divisor `[xᵢ]` on `X`
with ideal sheaf `xᵢ.ker`, and their sum `[x₁] + ⋯ + [x_r]` has ideal sheaf `∏ k, xₖ.ker`.

Following Katz–Mazur, Theorem 1.8.3, `s₁, …, s_r` form a **full set of sections** of `Z ⟶ S` if and
only if `Z` equals `[x₁] + ⋯ + [x_r]` as a closed subscheme of `X`
(`isFullSetOfSections_subschemeι_comp_iff`, `isFullSetOfSections_iff_ker_eq_prod_ker`), with no
properness assumption on `f` and no reducedness assumption on `S`. Consequently, at most one finite
locally free closed subscheme of `X` admits a given family of sections as a full set
(`eq_of_isFullSetOfSections`), and `fullSetLocus` coincides scheme-theoretically with
`equalityLocus` (`fullSetLocus_subschemeι_comp_eq_equalityLocus`, `fullSetLocus_eq_equalityLocus`).

## Proof outline

Both directions reduce to `S = Spec R` for a local ring `R`, where every closed subscheme finite
over `S` has semilocal coordinate ring
(`TauCeti.IsLocalRing.finite_maximalSpectrum_of_module_finite`).

* **Divisor sum implies full set of sections** (`isFullSetOfSections_prod_ker`): inducting on the
  sections over `Spec R`, multiplying `D'` by `I₁ = xₐ.ker` gives stalkwise principal kernels with
  stalkwise annihilators (`IsEffectiveCartier.exists_map_ker_inclusion_appTop_eq_span_singleton`).
  Semilocality patches these to a single global equation `u`
  (`Ideal.exists_eq_span_singleton_and_annihilator_of_isLocalRing`), and
  `TauCeti.IsFullSetOfSections.optionElim_of_ker_span_singleton` completes the induction step.
* **Full set of sections implies divisor sum** (`eq_prod_ker_of_isFullSetOfSections`): pulling back
  along `φ : Spec R ⟶ X` and its graph section `δ` produces a locally principal ideal on `Z`
  generated by `u`, whose section values have product `Norm(u) = 0` on `I.comap δ`. Containment
  `∏ k, xₖ.ker ≤ I` then upgrades to equality by matching ranks `Fintype.card ι`
  (`IsFullSetOfSections.finrank_eq_card`, `finrank_prod_ker`).

## Main definitions

* `TauCeti.AlgebraicGeometry.prodKerSection`: the canonical lift of `x i : S ⟶ X` to a section of
  the closed subscheme of `∏ k, (x k).ker`.

## Main results

* `TauCeti.AlgebraicGeometry.isFullSetOfSections_prod_ker`: the lifted sections form a full set of
  sections of `V(∏ k, (x k).ker) ⟶ S`.
* `TauCeti.AlgebraicGeometry.eq_prod_ker_of_isFullSetOfSections`: if `s` is a full set of sections
  of `V(I) ⟶ S`, then `I = ∏ k, (s k ≫ I.subschemeι).ker`.
* `TauCeti.AlgebraicGeometry.isFullSetOfSections_subschemeι_comp_iff` and
  `TauCeti.AlgebraicGeometry.isFullSetOfSections_iff_ker_eq_prod_ker`: **Katz–Mazur, Theorem
  1.8.3** (for ideal sheaves and for closed immersions).
* `TauCeti.AlgebraicGeometry.eq_of_isFullSetOfSections`: uniqueness of a finite locally free closed
  subscheme of a smooth separated curve admitting a given family of sections as a full set.
* `TauCeti.AlgebraicGeometry.fullSetLocus_subschemeι_comp_eq_equalityLocus` and
  `TauCeti.AlgebraicGeometry.fullSetLocus_eq_equalityLocus`: equality of the full-set locus and the
  divisor equality locus on `S`.

## References

* N. M. Katz, B. Mazur, *Arithmetic Moduli of Elliptic Curves*, Annals of Mathematics Studies
  108, Princeton University Press, 1985, Theorem 1.8.3 and §§1.8–1.9.
-/

public section

open CategoryTheory Limits Opposite

universe u

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry Scheme.IdealSheafData

/-! ### Pullback helper and sums of section divisors -/

private lemma isPullback_subschemeMap_of_eq {X S X' S' : Scheme.{u}} {f : X ⟶ S}
    {pX : X' ⟶ X} {f' : X' ⟶ S'} {t : S' ⟶ S} {D : X.IdealSheafData} {D' : X'.IdealSheafData}
    (hD' : D' = D.comap pX) (H : IsPullback pX f' f t) :
    IsPullback (subschemeMap D' D pX (hD' ▸ D.le_map_comap pX))
      (D'.subschemeι ≫ f') (D.subschemeι ≫ f) t := by
  subst hD'; exact D.isPullback_subschemeMap_comap f H

section ProdKerSection

variable {X S : Scheme.{u}} {f : X ⟶ S}

private lemma finset_prod_ker_le_ker {ι : Type*} (x : ι → (S ⟶ X)) {t : Finset ι} {i : ι}
    (hi : i ∈ t) : ∏ k ∈ t, (x k).ker ≤ (x i).ker := by
  classical
  rw [← Finset.mul_prod_erase t _ hi]; exact mul_le_of_le_one_right bot_le le_top

/-- Each section in a finite family lies on the closed subscheme cut out by the product of their
kernels. -/
theorem prod_ker_le_ker {ι : Type*} [Fintype ι] (x : ι → (S ⟶ X)) (i : ι) :
    ∏ k, (x k).ker ≤ (x i).ker :=
  finset_prod_ker_le_ker x (Finset.mem_univ i)

private noncomputable def finsetProdKerSection {ι : Type*} (x : ι → (S ⟶ X)) (t : Finset ι)
    (i : ↥t) : S ⟶ (∏ k ∈ t, (x k).ker).subscheme :=
  IsClosedImmersion.lift (∏ k ∈ t, (x k).ker).subschemeι (x i.1)
    ((ker_subschemeι _).trans_le (finset_prod_ker_le_ker x i.2))

@[reassoc (attr := simp)]
private lemma finsetProdKerSection_subschemeι {ι : Type*} (x : ι → (S ⟶ X)) (t : Finset ι)
    (i : ↥t) : finsetProdKerSection x t i ≫ (∏ k ∈ t, (x k).ker).subschemeι = x i.1 :=
  IsClosedImmersion.lift_fac _ _ _

private lemma finsetProdKerSection_comp {ι : Type*} {x : ι → (S ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 S)
    (t : Finset ι) (i : ↥t) :
    finsetProdKerSection x t i ≫ ((∏ k ∈ t, (x k).ker).subschemeι ≫ f) = 𝟙 S := by
  rw [← Category.assoc, finsetProdKerSection_subschemeι, hx]

/-- The canonical lift of a section `x i : S ⟶ X` in a finite family to a section of the closed
subscheme cut out by `∏ k, (x k).ker`. -/
noncomputable def prodKerSection {ι : Type*} [Fintype ι] (x : ι → (S ⟶ X)) (i : ι) :
    S ⟶ (∏ k, (x k).ker).subscheme :=
  IsClosedImmersion.lift (∏ k, (x k).ker).subschemeι (x i)
    ((ker_subschemeι _).trans_le (prod_ker_le_ker x i))

/-- Composing `prodKerSection x i` with the closed immersion into `X` recovers `x i`. -/
@[reassoc (attr := simp)]
theorem prodKerSection_subschemeι {ι : Type*} [Fintype ι] (x : ι → (S ⟶ X)) (i : ι) :
    prodKerSection x i ≫ (∏ k, (x k).ker).subschemeι = x i :=
  IsClosedImmersion.lift_fac _ _ _

/-- `prodKerSection x i` is a section of `V(∏ k, (x k).ker) ⟶ S`. -/
@[reassoc]
theorem prodKerSection_comp {ι : Type*} [Fintype ι] {x : ι → (S ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 S)
    (i : ι) : prodKerSection x i ≫ ((∏ k, (x k).ker).subschemeι ≫ f) = 𝟙 S := by
  rw [← Category.assoc, prodKerSection_subschemeι, hx]

end ProdKerSection

section SectionDivisor

variable {X S : Scheme.{u}} {f : X ⟶ S} [IsSeparated f] [SmoothOfRelativeDimension 1 f]

/-- A finite product of section kernels on a separated smooth curve is a relative effective Cartier
divisor. -/
theorem isRelativeEffectiveCartier_prod_ker_finset {ι : Type*} {x : ι → (S ⟶ X)}
    (hx : ∀ i, x i ≫ f = 𝟙 S) (t : Finset ι) :
    (∏ i ∈ t, (x i).ker).IsRelativeEffectiveCartier f :=
  TauCeti.isRelativeEffectiveCartier_prod fun i _ ↦
    Scheme.Hom.isRelativeEffectiveCartier_ker_of_smoothOfRelativeDimension (x i) (hx i)

/-- The divisor sum of a finite family of sections of a separated smooth curve is a relative
effective Cartier divisor. -/
theorem isRelativeEffectiveCartier_prod_ker {ι : Type*} [Fintype ι] {x : ι → (S ⟶ X)}
    (hx : ∀ i, x i ≫ f = 𝟙 S) : (∏ i, (x i).ker).IsRelativeEffectiveCartier f :=
  isRelativeEffectiveCartier_prod_ker_finset hx Finset.univ

/-- The closed subscheme cut out by a finite product of section kernels on a separated smooth curve
is finite over the base, with no properness assumption on the curve. -/
theorem isFinite_prod_ker_finset {ι : Type*} {x : ι → (S ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 S)
    (t : Finset ι) : IsFinite ((∏ i ∈ t, (x i).ker).subschemeι ≫ f) := by
  have : Smooth f := SmoothOfRelativeDimension.smooth 1 f
  refine isFinite_prod_subschemeι_comp t
    (fun i _ ↦ Scheme.Hom.isRelativeEffectiveCartier_ker_of_smoothOfRelativeDimension (x i) (hx i))
    fun i _ ↦ ?_
  have := Scheme.Hom.isClosedImmersion_of_comp_eq_id (x i) (hx i)
  have := Scheme.Hom.isIso_ker_subschemeι_comp (x i) (hx i)
  infer_instance

/-- The closed subscheme cut out by the divisor sum of a finite family of sections of a separated
smooth curve is finite over the base. -/
theorem isFinite_prod_ker {ι : Type*} [Fintype ι] {x : ι → (S ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 S) :
    IsFinite ((∏ i, (x i).ker).subschemeι ≫ f) :=
  isFinite_prod_ker_finset hx Finset.univ

/-- The closed subscheme cut out by a finite product of section kernels on a separated smooth curve
is flat over the base. -/
theorem flat_prod_ker_finset {ι : Type*} {x : ι → (S ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 S)
    (t : Finset ι) : Flat ((∏ i ∈ t, (x i).ker).subschemeι ≫ f) :=
  (isRelativeEffectiveCartier_prod_ker_finset hx t).flat

/-- The closed subscheme cut out by the divisor sum of a finite family of sections of a separated
smooth curve is flat over the base. -/
theorem flat_prod_ker {ι : Type*} [Fintype ι] {x : ι → (S ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 S) :
    Flat ((∏ i, (x i).ker).subschemeι ≫ f) :=
  flat_prod_ker_finset hx Finset.univ

/-- The closed subscheme cut out by a finite product of section kernels on a separated smooth curve
is locally of finite presentation over the base. -/
theorem locallyOfFinitePresentation_prod_ker_finset {ι : Type*} {x : ι → (S ⟶ X)}
    (hx : ∀ i, x i ≫ f = 𝟙 S) (t : Finset ι) :
    LocallyOfFinitePresentation ((∏ i ∈ t, (x i).ker).subschemeι ≫ f) := by
  have : Smooth f := SmoothOfRelativeDimension.smooth 1 f
  exact TauCeti.locallyOfFinitePresentation_subschemeι_comp_of_isEffectiveCartier
    (isRelativeEffectiveCartier_prod_ker_finset hx t).isEffectiveCartier

/-- The closed subscheme cut out by the divisor sum of a finite family of sections of a separated
smooth curve is locally of finite presentation over the base. -/
theorem locallyOfFinitePresentation_prod_ker {ι : Type*} [Fintype ι] {x : ι → (S ⟶ X)}
    (hx : ∀ i, x i ≫ f = 𝟙 S) :
    LocallyOfFinitePresentation ((∏ i, (x i).ker).subschemeι ≫ f) :=
  locallyOfFinitePresentation_prod_ker_finset hx Finset.univ

/-- The closed subscheme of a finite product of section kernels has constant rank `t.card` over the
base. -/
theorem finrank_prod_ker_finset {ι : Type*} {x : ι → (S ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 S)
    (t : Finset ι) (p : S) : ((∏ i ∈ t, (x i).ker).subschemeι ≫ f).finrank p = t.card := by
  have (i : ι) := Scheme.Hom.isClosedImmersion_of_comp_eq_id (x i) (hx i)
  have := isFinite_prod_ker_finset hx t
  simpa [fun i ↦ Scheme.Hom.finrank_ker_comp_eq_one_of_comp_eq_id (x i) (hx i)] using
    congrFun (finrank_prod_subschemeι_comp t (fun i ↦ (x i).ker) fun i _ ↦
      Scheme.Hom.isRelativeEffectiveCartier_ker_of_smoothOfRelativeDimension (x i) (hx i)) p

/-- The closed subscheme of the divisor sum of a finite family of sections has constant rank
`Fintype.card ι` over the base. -/
@[simp]
theorem finrank_prod_ker {ι : Type*} [Fintype ι] {x : ι → (S ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 S)
    (p : S) : ((∏ i, (x i).ker).subschemeι ≫ f).finrank p = Fintype.card ι :=
  finrank_prod_ker_finset hx Finset.univ p

end SectionDivisor

/-! ### Divisor sum implies full set of sections -/

private lemma exists_ker_span_singleton_and_annihilator_of_isLocalRing
    {R : Type u} [CommRing R] [IsLocalRing R] {X : Scheme.{u}} (f : X ⟶ Spec (.of R))
    {I₁ D' : X.IdealSheafData} (hCartier : I₁.IsEffectiveCartier)
    (hI₁ : I₁ * D' ≤ I₁) (hD' : I₁ * D' ≤ D') [IsFinite ((I₁ * D').subschemeι ≫ f)] :
    haveI : IsAffine (I₁ * D').subscheme := isAffine_of_isAffineHom ((I₁ * D').subschemeι ≫ f)
    ∃ u : Γ((I₁ * D').subscheme, ⊤),
      RingHom.ker (inclusion hI₁).appTop.hom = Ideal.span {u} ∧
        RingHom.ker (inclusion hD').appTop.hom = (Ideal.span {u}).annihilator := by
  let Z := (I₁ * D').subscheme
  let g := (I₁ * D').subschemeι ≫ f
  have : IsAffine Z := isAffine_of_isAffineHom g
  let : Algebra R Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop).hom.toAlgebra
  have : Module.Finite R Γ(Z, ⊤) := g.moduleFinite_appTop rfl
  refine Ideal.exists_eq_span_singleton_and_annihilator_of_isLocalRing R
    (RingHom.ker (inclusion hI₁).appTop.hom) (RingHom.ker (inclusion hD').appTop.hom) fun M _ ↦ ?_
  let y : PrimeSpectrum Γ(Z, ⊤) := ⟨M, inferInstance⟩
  let z : Z := (isAffineOpen_top Z).fromSpec y
  let := TopCat.Presheaf.algebra_section_stalk Z.presheaf (⟨z, trivial⟩ : (⊤ : Z.Opens))
  have : IsLocalization M.primeCompl (Z.presheaf.stalk z) :=
    (isAffineOpen_top Z).isLocalization_stalk' y trivial
  let e := IsLocalization.algEquiv M.primeCompl (Localization.AtPrime M) (Z.presheaf.stalk z)
  have hgerm : (Z.presheaf.germ ⊤ z trivial).hom = algebraMap Γ(Z, ⊤) (Z.presheaf.stalk z) :=
    Z.presheaf.stalk_open_algebraMap (⟨z, trivial⟩ : (⊤ : Z.Opens))
  obtain ⟨a, ha₁, ha₂⟩ :=
    IsEffectiveCartier.exists_map_ker_inclusion_appTop_eq_span_singleton hCartier hI₁ hD' z
  rw [hgerm] at ha₁ ha₂
  exact ⟨e.symm a, e.map_eq_span_singleton_and_annihilator ha₁ ha₂⟩

private lemma isFullSetOfSections_insert_of_ker_span_singleton
    {Y Z Z' : Scheme.{u}} [IsAffine Y] [IsAffine Z]
    (g : Z ⟶ Y) [IsFinite g] [Flat g] [LocallyOfFinitePresentation g]
    (g' : Z' ⟶ Y) [IsFinite g'] [Flat g'] [LocallyOfFinitePresentation g']
    (hloc : IsLocalRing Γ(Y, ⊤)) (ι_map : Z' ⟶ Z) [IsClosedImmersion ι_map] (hιg : ι_map ≫ g = g')
    {ι : Type*} [DecidableEq ι] {a : ι} {t : Finset ι} (ha : a ∉ t)
    {s : ↥(insert a t) → (Y ⟶ Z)} (hs : ∀ k, s k ≫ g = 𝟙 Y)
    {s' : ↥t → (Y ⟶ Z')} (hs' : ∀ j, s' j ≫ g' = 𝟙 Y)
    (hcomp : ∀ j : ↥t, s' j ≫ ι_map = s ⟨j.1, Finset.mem_insert_of_mem j.2⟩) {u : Γ(Z, ⊤)}
    (hker_sa : RingHom.ker (s ⟨a, Finset.mem_insert_self a t⟩).appTop.hom = Ideal.span {u})
    (hann : RingHom.ker ι_map.appTop.hom = (Ideal.span {u}).annihilator)
    (ih : IsFullSetOfSections g' s' hs') : IsFullSetOfSections g s hs := by
  let U : Y.affineOpens := ⟨⊤, isAffineOpen_top Y⟩
  let : Algebra Γ(Y, U) Γ(Z, g ⁻¹ᵁ U) := (g.app U).hom.toAlgebra
  let : Algebra Γ(Y, U) Γ(Z', g' ⁻¹ᵁ U) := (g'.app U).hom.toAlgebra
  have : IsLocalRing Γ(Y, U) := hloc
  have : Module.Finite Γ(Y, U) Γ(Z', g' ⁻¹ᵁ U) := g'.finite_app U U.2
  have := g'.projective_app U
  have : Module.Free Γ(Y, U) Γ(Z', g' ⁻¹ᵁ U) := Module.free_of_flat_of_isLocalRing
  let π : Γ(Z, g ⁻¹ᵁ U) →ₐ[Γ(Y, U)] Γ(Z', g' ⁻¹ᵁ U) :=
    { (ι_map.app ⊤).hom with commutes' r := congr(($hιg).appTop.hom r) }
  have hπ : Function.Surjective π := ι_map.app_surjective ⊤ (isAffineOpen_top Z)
  have hker_σa : RingHom.ker (sectionAlgHom g (hs ⟨a, Finset.mem_insert_self a t⟩) ⊤) =
      Ideal.span {(u : Γ(Z, g ⁻¹ᵁ ⊤))} :=
    SetLike.ext fun b ↦
      have hb := sectionAlgHom_top_apply g (hs ⟨a, Finset.mem_insert_self a t⟩) b
      have hmem : (b : Γ(Z, ⊤)) ∈ RingHom.ker (s ⟨a, Finset.mem_insert_self a t⟩).appTop.hom ↔
          (b : Γ(Z, ⊤)) ∈ Ideal.span {u} := Iff.of_eq (congrArg ((b : Γ(Z, ⊤)) ∈ ·) hker_sa)
      ⟨fun h0 ↦ hmem.mp (RingHom.mem_ker.mpr (hb.symm.trans (RingHom.mem_ker.mp h0))),
        fun hm ↦ RingHom.mem_ker.mpr (hb.trans (RingHom.mem_ker.mp (hmem.mpr hm)))⟩
  have hopt := ((isFullSetOfSections_iff_of_isAffine g' s' hs').1 ih)
    |>.optionElim_of_ker_span_singleton hπ hker_σa hann
  rw [isFullSetOfSections_iff_of_isAffine,
    ← TauCeti.isFullSetOfSections_comp_equiv_iff (Finset.subtypeInsertEquivOption ha).symm]
  refine (Iff.of_eq (congrArg TauCeti.IsFullSetOfSections (funext fun o ↦ AlgHom.ext fun b ↦ ?_))).1
    hopt
  cases o with
  | none => rfl
  | some j =>
    exact (sectionAlgHom_top_apply g' (hs' j) (π b)).trans
      ((congr(($(hcomp j)).appTop.hom b)).trans
        (sectionAlgHom_top_apply g (hs ⟨j.1, Finset.mem_insert_of_mem j.2⟩) b).symm)

private lemma isFullSetOfSections_mul_ker_of_isLocalRing
    {R : Type u} [CommRing R] [IsLocalRing R] {X : Scheme.{u}} {f : X ⟶ Spec (.of R)}
    [IsSeparated f] [SmoothOfRelativeDimension 1 f] {ι : Type*} [DecidableEq ι]
    {x : ι → (Spec (.of R) ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 _) {a : ι} {t : Finset ι} (ha : a ∉ t)
    (ih : IsFullSetOfSections ((∏ k ∈ t, (x k).ker).subschemeι ≫ f)
      (finsetProdKerSection x t) (finsetProdKerSection_comp hx t)) :
    IsFullSetOfSections ((∏ k ∈ insert a t, (x k).ker).subschemeι ≫ f)
      (finsetProdKerSection x (insert a t)) (finsetProdKerSection_comp hx (insert a t)) := by
  let I₁ := (x a).ker; let D' := ∏ k ∈ t, (x k).ker; let M := I₁ * D'
  have hins : ∏ k ∈ insert a t, (x k).ker = M := Finset.prod_insert ha
  have hI₁ : M ≤ I₁ := mul_le_of_le_one_right bot_le le_top
  have hD' : M ≤ D' := mul_le_of_le_one_left bot_le le_top
  have := isFinite_prod_ker_finset hx t; have := flat_prod_ker_finset hx t
  have := locallyOfFinitePresentation_prod_ker_finset hx t
  have : IsFinite (M.subschemeι ≫ f) := hins ▸ isFinite_prod_ker_finset hx (insert a t)
  have : Flat (M.subschemeι ≫ f) := hins ▸ flat_prod_ker_finset hx (insert a t)
  have : LocallyOfFinitePresentation (M.subschemeι ≫ f) :=
    hins ▸ locallyOfFinitePresentation_prod_ker_finset hx (insert a t)
  have : IsAffine M.subscheme := isAffine_of_isAffineHom (M.subschemeι ≫ f)
  have : IsClosedImmersion (inclusion hD') :=
    have : IsClosedImmersion (inclusion hD' ≫ M.subschemeι) :=
      (inclusion_subschemeι hD').symm ▸ inferInstance
    .of_comp_isClosedImmersion (inclusion hD') M.subschemeι
  obtain ⟨u, hu₁, hu₂⟩ := exists_ker_span_singleton_and_annihilator_of_isLocalRing f
    (Scheme.Hom.isRelativeEffectiveCartier_ker_of_smoothOfRelativeDimension
      (x a) (hx a)).isEffectiveCartier hI₁ hD'
  let sM (k : ↥(insert a t)) : Spec (.of R) ⟶ M.subscheme :=
    finsetProdKerSection x (insert a t) k ≫ inclusion hins.ge
  have hsM (k : ↥(insert a t)) : sM k ≫ (M.subschemeι ≫ f) = 𝟙 _ := by
    simp [sM, inclusion_subschemeι_assoc, hx]
  have hker_sa : RingHom.ker (sM ⟨a, Finset.mem_insert_self a t⟩).appTop.hom = Ideal.span {u} := by
    have hsa : (sM ⟨a, Finset.mem_insert_self a t⟩).ker = (inclusion hI₁).ker := by
      rw [← Scheme.Hom.comap_ker_comp_of_isClosedImmersion _ M.subschemeι]
      simp [sM, inclusion_subschemeι, finsetProdKerSection_subschemeι, I₁]
    have htop := congrArg (fun K : M.subscheme.IdealSheafData ↦ K.ideal ⟨⊤, isAffineOpen_top _⟩) hsa
    rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply] at htop
    exact htop.trans hu₁
  have hM : IsFullSetOfSections (M.subschemeι ≫ f) sM hsM :=
    isFullSetOfSections_insert_of_ker_span_singleton (M.subschemeι ≫ f) (D'.subschemeι ≫ f)
      (Scheme.ΓSpecIso (.of R)).symm.commRingCatIsoToRingEquiv.isLocalRing (inclusion hD')
      (inclusion_subschemeι_assoc hD' f) ha hsM (finsetProdKerSection_comp hx t)
      (fun j ↦ by simp [← cancel_mono M.subschemeι, sM, D', inclusion_subschemeι]) hker_sa hu₂ ih
  have : IsIso (inclusion hins.ge) :=
    IsClosedImmersion.isIso_of_ker_eq _ M.subschemeι (inclusion hins.ge)
      (inclusion_subschemeι hins.ge) (by simp [hins])
  exact (isFullSetOfSections_of_iso (M.subschemeι ≫ f) sM hsM (asIso (inclusion hins.ge))
    (inclusion_subschemeι_assoc hins.ge f) (finsetProdKerSection_comp hx (insert a t))
    fun _ ↦ rfl).2 hM

private lemma isFullSetOfSections_finsetProdKerSection_of_isLocalRing
    {R : Type u} [CommRing R] [IsLocalRing R] {X : Scheme.{u}} {f : X ⟶ Spec (.of R)}
    [IsSeparated f] [SmoothOfRelativeDimension 1 f] {ι : Type*}
    {x : ι → (Spec (.of R) ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 _) (t : Finset ι) :
    IsFullSetOfSections ((∏ k ∈ t, (x k).ker).subschemeι ≫ f)
      (finsetProdKerSection x t) (finsetProdKerSection_comp hx t) := by
  classical
  induction t using Finset.induction_on with
  | empty =>
    let D₀ := ∏ k ∈ (∅ : Finset ι), (x k).ker
    have := isFinite_prod_ker_finset hx (∅ : Finset ι)
    have := flat_prod_ker_finset hx (∅ : Finset ι)
    have := locallyOfFinitePresentation_prod_ker_finset hx (∅ : Finset ι)
    have hD₀ : D₀ = ⊤ := Finset.prod_empty
    have : IsEmpty D₀.subscheme := hD₀ ▸ inferInstance
    have hbot : ((D₀.subschemeι ≫ f) ⁻¹ᵁ ⊤) = ⊥ := by ext z; exact isEmptyElim z
    have : Subsingleton Γ(D₀.subscheme, (D₀.subschemeι ≫ f) ⁻¹ᵁ ⊤) := hbot ▸ inferInstance
    rw [isFullSetOfSections_iff_of_isAffine]
    let := ((D₀.subschemeι ≫ f).app ⊤).hom.toAlgebra
    exact TauCeti.isFullSetOfSections_of_subsingleton _
  | insert a t ha ih => exact isFullSetOfSections_mul_ker_of_isLocalRing hx ha ih

private lemma isFullSetOfSections_prodKerSection_of_isLocalRing
    {R : Type u} [CommRing R] [IsLocalRing R] {X : Scheme.{u}} {f : X ⟶ Spec (.of R)}
    [IsSeparated f] [SmoothOfRelativeDimension 1 f] {ι : Type*} [Fintype ι]
    {x : ι → (Spec (.of R) ⟶ X)} (hx : ∀ i, x i ≫ f = 𝟙 _) :
    IsFullSetOfSections ((∏ k, (x k).ker).subschemeι ≫ f)
      (prodKerSection x) (prodKerSection_comp hx) := by
  let D' := ∏ k, (x k).ker
  have := isFinite_prod_ker hx; have := flat_prod_ker hx
  have := locallyOfFinitePresentation_prod_ker hx
  let e : (Finset.univ : Finset ι) ≃ ι := Equiv.subtypeUnivEquiv Finset.mem_univ
  have hfin := isFullSetOfSections_finsetProdKerSection_of_isLocalRing hx Finset.univ
  rw [isFullSetOfSections_iff] at hfin ⊢; intro U
  let := ((D'.subschemeι ≫ f).app U).hom.toAlgebra
  have hsec {σ₁ σ₂ : Spec (.of R) ⟶ D'.subscheme} (h : σ₁ = σ₂)
      (h₁ : σ₁ ≫ (D'.subschemeι ≫ f) = 𝟙 _) (h₂ : σ₂ ≫ (D'.subschemeι ≫ f) = 𝟙 _) :
      sectionAlgHom (D'.subschemeι ≫ f) h₁ U = sectionAlgHom (D'.subschemeι ≫ f) h₂ U :=
    h ▸ rfl
  have heq : (fun i ↦ sectionAlgHom (D'.subschemeι ≫ f) (prodKerSection_comp hx i) U) =
      (fun j ↦ sectionAlgHom (D'.subschemeι ≫ f)
        (finsetProdKerSection_comp hx Finset.univ j) U) ∘ e.symm :=
    funext fun i ↦ hsec (by
      rw [← cancel_mono D'.subschemeι, prodKerSection_subschemeι, finsetProdKerSection_subschemeι]
      rfl) _ _
  rw [heq, TauCeti.isFullSetOfSections_comp_equiv_iff]; exact hfin U

/-- **Sections of a smooth separated curve form a full set of sections of their divisor sum**
(Katz–Mazur, Theorem 1.8.3, `(⇐)`). -/
theorem isFullSetOfSections_prod_ker {X S : Scheme.{u}} {f : X ⟶ S} [IsSeparated f]
    [SmoothOfRelativeDimension 1 f] {ι : Type*} [Fintype ι] {x : ι → (S ⟶ X)}
    (hx : ∀ i, x i ≫ f = 𝟙 S) :
    IsFullSetOfSections ((∏ k, (x k).ker).subschemeι ≫ f)
      (prodKerSection x) (prodKerSection_comp hx) := by
  let D := ∏ k, (x k).ker
  have := isFinite_prod_ker hx; have := flat_prod_ker hx
  have := locallyOfFinitePresentation_prod_ker hx
  rw [isFullSetOfSections_iff_fullSetLocus_eq_bot (D.subschemeι ≫ f)]
  refine eq_bot_of_le_ker_Spec_isLocalRing fun R _ _ t ↦ ?_
  let f' := Limits.pullback.fst t f; let pX := Limits.pullback.snd t f
  let x' : ι → (Spec (.of R) ⟶ Limits.pullback t f) :=
    fun i ↦ baseChangeSection f (x i) (hx i) (Over.mk t)
  have hx' (i : ι) : x' i ≫ f' = 𝟙 _ := baseChangeSection_fst f (x i) (hx i) (Over.mk t)
  have hker (i : ι) : (x' i).ker = (x i).ker.comap pX := by
    have := Scheme.Hom.isClosedImmersion_of_comp_eq_id (x i) (hx i)
    have hid : IsPullback (x' i ≫ f') t t (x i ≫ f) := by rw [hx' i, hx i]; exact .id_horiz t
    exact ker_eq_comap_of_isPullback (x i)
      (IsPullback.of_right hid (baseChangeSection_snd f (x i) (hx i) (Over.mk t))
        (IsPullback.of_hasPullback t f))
  let D' := ∏ k, (x' k).ker
  have hD' : D' = D.comap pX := by rw [comap_prod]; exact Finset.prod_congr rfl fun i _ ↦ hker i
  have H_D := isPullback_subschemeMap_of_eq hD' (IsPullback.of_hasPullback t f).flip
  have := isFinite_prod_ker hx'; have := flat_prod_ker hx'
  have := locallyOfFinitePresentation_prod_ker hx'
  have hs' (i : ι) :
      prodKerSection x' i ≫ subschemeMap D' D pX (hD' ▸ D.le_map_comap pX) =
        t ≫ prodKerSection x i := by
    rw [← cancel_mono D.subschemeι, Category.assoc, subschemeMap_subschemeι,
      prodKerSection_subschemeι_assoc, Category.assoc, prodKerSection_subschemeι]
    exact baseChangeSection_snd f (x i) (hx i) (Over.mk t)
  rw [fullSetLocus_le_ker_iff_of_isPullback (D.subschemeι ≫ f) (prodKerSection x)
    (prodKerSection_comp hx) H_D (prodKerSection_comp hx') hs']
  exact isFullSetOfSections_prodKerSection_of_isLocalRing hx'

/-! ### Full set of sections implies divisor sum -/

private lemma exists_eq_ofIdealTop_span_singleton_of_stalkIdeal
    {R : Type u} [CommRing R] [IsLocalRing R] {Z : Scheme.{u}} [IsAffine Z]
    (g : Z ⟶ Spec (.of R)) [IsFinite g] (J_sheaf : Z.IdealSheafData)
    (hstalk : ∀ z : Z, ∃ a : Z.presheaf.stalk z, J_sheaf.stalkIdeal z = Ideal.span {a}) :
    ∃ u : Γ(Z, ⊤), J_sheaf = ofIdealTop (Ideal.span {u}) := by
  let : Algebra R Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop).hom.toAlgebra
  have : Module.Finite R Γ(Z, ⊤) := g.moduleFinite_appTop rfl
  let J : Ideal Γ(Z, ⊤) := J_sheaf.ideal ⟨⊤, isAffineOpen_top Z⟩
  obtain ⟨u, hu⟩ : ∃ u : Γ(Z, ⊤), J = Ideal.span {u} := by
    refine Ideal.exists_eq_span_singleton_of_isLocalRing R J fun M _ ↦ ?_
    let y : PrimeSpectrum Γ(Z, ⊤) := ⟨M, inferInstance⟩
    let z : Z := (isAffineOpen_top Z).fromSpec y
    let := TopCat.Presheaf.algebra_section_stalk Z.presheaf (⟨z, trivial⟩ : (⊤ : Z.Opens))
    have : IsLocalization M.primeCompl (Z.presheaf.stalk z) :=
      (isAffineOpen_top Z).isLocalization_stalk' y trivial
    let e := IsLocalization.algEquiv M.primeCompl (Z.presheaf.stalk z) (Localization.AtPrime M)
    have hgerm : (Z.presheaf.germ ⊤ z trivial).hom = algebraMap Γ(Z, ⊤) (Z.presheaf.stalk z) :=
      Z.presheaf.stalk_open_algebraMap (⟨z, trivial⟩ : (⊤ : Z.Opens))
    have he : e.toRingHom.comp (Z.presheaf.germ ⊤ z trivial).hom =
        algebraMap Γ(Z, ⊤) (Localization.AtPrime M) := by rw [hgerm]; exact RingHom.ext e.commutes
    obtain ⟨a, ha⟩ := hstalk z
    refine ⟨e a, ?_⟩
    rw [← he, ← Ideal.map_map, ← J_sheaf.stalkIdeal_eq_map ⟨⊤, isAffineOpen_top Z⟩ z trivial,
      ha, Ideal.map_span, Set.image_singleton]
    rfl
  exact ⟨u, (equivOfIsAffine.symm_apply_apply J_sheaf).symm.trans (congrArg ofIdealTop hu)⟩

private lemma prod_comap_ofIdealTop_span_singleton {Y Z : Scheme.{u}} (g : Z ⟶ Y)
    {ι : Type*} {s : ι → (Y ⟶ Z)} (hs : ∀ i, s i ≫ g = 𝟙 Y) (t : Finset ι) (u : Γ(Z, ⊤)) :
    ∏ i ∈ t, (ofIdealTop (Ideal.span {u})).comap (s i) =
      ofIdealTop (Ideal.span {∏ i ∈ t, sectionAlgHom g (hs i) ⊤ u}) := by
  classical
  induction t using Finset.induction_on with
  | empty => ext U : 2; simp [Ideal.map_top]
  | insert a t ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha, ih, comap_ofIdealTop, Ideal.map_span,
      Set.image_singleton, ← ofIdealTop_mul, Ideal.span_singleton_mul_span_singleton,
      sectionAlgHom_top_apply g (hs a) u]

private lemma prod_comap_ofIdealTop_span_le_ker
    {Y Z W : Scheme.{u}} [IsAffine Y] (g : Z ⟶ Y) [IsFinite g] [Flat g]
    [LocallyOfFinitePresentation g] (hloc : IsLocalRing Γ(Y, ⊤))
    {ι : Type*} [Fintype ι] {s : ι → (Y ⟶ Z)} (hs : ∀ i, s i ≫ g = 𝟙 Y)
    (hfull : IsFullSetOfSections g s hs) (u : Γ(Z, ⊤))
    {ℓ : W ⟶ Z} {w : W ⟶ Y} [IsClosedImmersion w] (hℓg : ℓ ≫ g = w)
    (hu : ofIdealTop (Ideal.span {u}) ≤ ℓ.ker) :
    ∏ i, (ofIdealTop (Ideal.span {u})).comap (s i) ≤ w.ker := by
  let U : Y.affineOpens := ⟨⊤, isAffineOpen_top Y⟩
  let : Algebra Γ(Y, U) Γ(Z, g ⁻¹ᵁ U) := (g.app U).hom.toAlgebra
  have : IsLocalRing Γ(Y, U) := hloc
  have : Module.Finite Γ(Y, U) Γ(Z, g ⁻¹ᵁ U) := g.finite_app U U.2
  have := g.projective_app U
  have : Module.Free Γ(Y, U) Γ(Z, g ⁻¹ᵁ U) := Module.free_of_flat_of_isLocalRing
  let u' : Γ(Z, g ⁻¹ᵁ U) := u
  rw [prod_comap_ofIdealTop_span_singleton g hs Finset.univ u,
    ← ((isFullSetOfSections_iff g s hs).1 hfull U).norm_eq_prod u', ofIdealTop_le_ker_iff,
    Ideal.span_singleton_le_iff_mem]
  have hℓu : ℓ.appTop.hom u = 0 :=
    (ofIdealTop_le_ker_iff ℓ (Ideal.span {u})).mp hu (Ideal.mem_span_singleton_self u)
  let : Algebra Γ(Y, U) Γ(W, w ⁻¹ᵁ U) := (w.app U).hom.toAlgebra
  have hw_surj : Function.Surjective (Algebra.ofId Γ(Y, U) Γ(W, w ⁻¹ᵁ U)) := w.app_surjective U U.2
  let eW := (Ideal.quotientKerAlgEquivOfSurjective hw_surj).symm
  let τ : Γ(Z, g ⁻¹ᵁ U) →ₐ[Γ(Y, U)] Γ(W, w ⁻¹ᵁ U) :=
    { (ℓ.app ⊤).hom with commutes' r := congr(($hℓg).appTop.hom r) }
  exact TauCeti.Algebra.norm_mem_ideal_of_algHom_quotient (eW.toAlgHom.comp τ)
    ((map_eq_zero_iff eW eW.injective).mpr hℓu)

private lemma comap_prod_ker_le_comap_of_isLocalRing
    {R : Type u} [CommRing R] [IsLocalRing R] {X : Scheme.{u}} {f : X ⟶ Spec (.of R)}
    [IsSeparated f] [SmoothOfRelativeDimension 1 f] {I : X.IdealSheafData}
    [IsFinite (I.subschemeι ≫ f)] [Flat (I.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (I.subschemeι ≫ f)] {ι : Type*} [Fintype ι]
    {s : ι → (Spec (.of R) ⟶ I.subscheme)} (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 _)
    (hfull : IsFullSetOfSections (I.subschemeι ≫ f) s hs)
    {δ : Spec (.of R) ⟶ X} (hδ : δ ≫ f = 𝟙 _) :
    (∏ i, (s i ≫ I.subschemeι).ker).comap δ ≤ I.comap δ := by
  have : IsAffine I.subscheme := isAffine_of_isAffineHom (I.subschemeι ≫ f)
  have hCartier : δ.ker.IsEffectiveCartier :=
    (Scheme.Hom.isRelativeEffectiveCartier_ker_of_smoothOfRelativeDimension δ hδ).isEffectiveCartier
  obtain ⟨u, hu⟩ := exists_eq_ofIdealTop_span_singleton_of_stalkIdeal (I.subschemeι ≫ f)
    (δ.ker.comap I.subschemeι) fun z ↦ by
      obtain ⟨V, hzV, α, -, hα⟩ := (isEffectiveCartier_iff δ.ker).mp hCartier (I.subschemeι z)
      refine ⟨(I.subschemeι.stalkMap z).hom ((X.presheaf.germ V.1 _ hzV).hom α), ?_⟩
      rw [δ.ker.stalkIdeal_comap, δ.ker.stalkIdeal_eq_map V _ hzV, hα, Ideal.map_span,
        Set.image_singleton, Ideal.map_span, Set.image_singleton]
  have hcomm (i : ι) : (s i ≫ I.subschemeι).ker.comap δ =
      (ofIdealTop (Ideal.span {u})).comap (s i) := by
    have hx₀ : (s i ≫ I.subschemeι) ≫ f = 𝟙 _ := by rw [Category.assoc, hs i]
    have := Scheme.Hom.isClosedImmersion_of_comp_eq_id δ hδ
    have := Scheme.Hom.isClosedImmersion_of_comp_eq_id (s i ≫ I.subschemeι) hx₀
    rw [Scheme.Hom.ker_comap_section_comm hδ hx₀, comap_comp, hu]
  rw [comap_prod]; simp_rw [hcomm]
  let K := I.comap δ
  let ℓ : K.subscheme ⟶ I.subscheme := subschemeMap K I δ (I.le_map_comap δ)
  have hℓg : ℓ ≫ (I.subschemeι ≫ f) = K.subschemeι := by
    rw [← Category.assoc, subschemeMap_subschemeι, Category.assoc, hδ, Category.comp_id]
  have hle : ofIdealTop (Ideal.span {u}) ≤ ℓ.ker := by
    rw [← hu, ← le_map_iff_comap_le, map_ker, subschemeMap_subschemeι]
    exact Scheme.Hom.le_ker_comp K.subschemeι δ
  rw [← (I.comap δ).ker_subschemeι]
  exact prod_comap_ofIdealTop_span_le_ker (I.subschemeι ≫ f)
    (Scheme.ΓSpecIso (.of R)).symm.commRingCatIsoToRingEquiv.isLocalRing hs hfull u hℓg hle

section PullbackSubscheme

variable {X S X' S' : Scheme.{u}} {f : X ⟶ S} {pX : X' ⟶ X} {f' : X' ⟶ S'} {t : S' ⟶ S}

private noncomputable def pullbackSubschemeSection (H : IsPullback pX f' f t)
    (I : X.IdealSheafData) {ι : Type*} (s : ι → (S ⟶ I.subscheme))
    (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 S) (i : ι) : S' ⟶ (I.comap pX).subscheme :=
  (I.isPullback_subschemeMap_comap f H).flip.lift (𝟙 S') (t ≫ s i) (by simp [hs i])

private lemma pullbackSubschemeSection_comp (H : IsPullback pX f' f t)
    (I : X.IdealSheafData) {ι : Type*} (s : ι → (S ⟶ I.subscheme))
    (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 S) (i : ι) :
    pullbackSubschemeSection H I s hs i ≫ ((I.comap pX).subschemeι ≫ f') = 𝟙 S' :=
  (I.isPullback_subschemeMap_comap f H).flip.lift_fst _ _ _

private lemma pullbackSubschemeSection_subschemeMap (H : IsPullback pX f' f t)
    (I : X.IdealSheafData) {ι : Type*} (s : ι → (S ⟶ I.subscheme))
    (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 S) (i : ι) :
    pullbackSubschemeSection H I s hs i ≫ subschemeMap (I.comap pX) I pX (I.le_map_comap pX) =
      t ≫ s i :=
  (I.isPullback_subschemeMap_comap f H).flip.lift_snd _ _ _

private lemma prod_ker_pullbackSubschemeSection [IsSeparated f] (H : IsPullback pX f' f t)
    (I : X.IdealSheafData) {ι : Type*} [Fintype ι] (s : ι → (S ⟶ I.subscheme))
    (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 S) :
    ∏ i, (pullbackSubschemeSection H I s hs i ≫ (I.comap pX).subschemeι).ker =
      (∏ i, (s i ≫ I.subschemeι).ker).comap pX := by
  rw [comap_prod]; refine Finset.prod_congr rfl fun i _ ↦ ?_
  have hx : (s i ≫ I.subschemeι) ≫ f = 𝟙 S := by rw [Category.assoc, hs i]
  have hx' : (pullbackSubschemeSection H I s hs i ≫ (I.comap pX).subschemeι) ≫ f' = 𝟙 S' := by
    rw [Category.assoc, pullbackSubschemeSection_comp H I s hs i]
  have := Scheme.Hom.isClosedImmersion_of_comp_eq_id (s i ≫ I.subschemeι) hx
  have hcomm : (pullbackSubschemeSection H I s hs i ≫ (I.comap pX).subschemeι) ≫ pX =
      t ≫ (s i ≫ I.subschemeι) := by
    rw [Category.assoc, ← subschemeMap_subschemeι (I.comap pX) I pX (I.le_map_comap pX),
      ← Category.assoc, pullbackSubschemeSection_subschemeMap, Category.assoc]
  have hid : IsPullback ((pullbackSubschemeSection H I s hs i ≫ (I.comap pX).subschemeι) ≫ f')
      t t ((s i ≫ I.subschemeι) ≫ f) := by rw [hx', hx]; exact .id_horiz t
  exact ker_eq_comap_of_isPullback (s i ≫ I.subschemeι) (IsPullback.of_right hid hcomm H.flip)

end PullbackSubscheme

section MainTheorem

variable {X S : Scheme.{u}} {f : X ⟶ S} [IsSeparated f] [SmoothOfRelativeDimension 1 f]
  {ι : Type*} [Fintype ι]

/-- If `s` is a full set of sections of a finite locally free closed subscheme `V(I) ⊆ X` of a
separated smooth curve `X ⟶ S`, then `V(I)` contains the divisor sum of the sections `s i`:
`∏ i, (s i ≫ I.subschemeι).ker ≤ I`. -/
theorem prod_ker_le_of_isFullSetOfSections {I : X.IdealSheafData}
    [IsFinite (I.subschemeι ≫ f)] [Flat (I.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (I.subschemeι ≫ f)]
    {s : ι → (S ⟶ I.subscheme)} (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 S)
    (hfull : IsFullSetOfSections (I.subschemeι ≫ f) s hs) :
    ∏ i, (s i ≫ I.subschemeι).ker ≤ I := by
  refine le_of_comap_Spec_isLocalRing fun R _ _ φ ↦ ?_
  let t := φ ≫ f; let f' := Limits.pullback.fst t f; let pX := Limits.pullback.snd t f
  have H : IsPullback pX f' f t := (IsPullback.of_hasPullback t f).flip
  have H_I := I.isPullback_subschemeMap_comap f H
  let _ : IsFinite ((I.comap pX).subschemeι ≫ f') :=
    MorphismProperty.of_isPullback H_I inferInstance
  let _ : Flat ((I.comap pX).subschemeι ≫ f') := MorphismProperty.of_isPullback H_I inferInstance
  let _ : LocallyOfFinitePresentation ((I.comap pX).subschemeι ≫ f') :=
    MorphismProperty.of_isPullback H_I inferInstance
  have hfull' : IsFullSetOfSections ((I.comap pX).subschemeι ≫ f')
      (pullbackSubschemeSection H I s hs) (pullbackSubschemeSection_comp H I s hs) := by
    rw [← fullSetLocus_le_ker_iff_of_isPullback (I.subschemeι ≫ f) s hs H_I
      (pullbackSubschemeSection_comp H I s hs) (pullbackSubschemeSection_subschemeMap H I s hs),
      (isFullSetOfSections_iff_fullSetLocus_eq_bot _ _ _).1 hfull]
    exact bot_le
  have hδφ : graphSection (T := Over.mk t) (Over.homMk φ rfl) ≫ pX = φ :=
    graphSection_snd (T := Over.mk t) (Over.homMk φ rfl)
  rw [← hδφ, comap_comp, comap_comp, ← prod_ker_pullbackSubschemeSection H I s hs]
  exact comap_prod_ker_le_comap_of_isLocalRing (pullbackSubschemeSection_comp H I s hs) hfull'
    (graphSection_fst (T := Over.mk t) (Over.homMk φ rfl))

/-- **Full set of sections implies divisor sum** (Katz–Mazur, Theorem 1.8.3, `(⇒)`). If `s` is a
full set of sections of a finite locally free closed subscheme `V(I) ⊆ X` of a separated smooth
curve `X ⟶ S`, then `I = ∏ i, (s i ≫ I.subschemeι).ker`. -/
theorem eq_prod_ker_of_isFullSetOfSections {I : X.IdealSheafData}
    [IsFinite (I.subschemeι ≫ f)] [Flat (I.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (I.subschemeι ≫ f)]
    {s : ι → (S ⟶ I.subscheme)} (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 S)
    (hfull : IsFullSetOfSections (I.subschemeι ≫ f) s hs) :
    I = ∏ i, (s i ≫ I.subschemeι).ker := by
  have hx (i : ι) : (s i ≫ I.subschemeι) ≫ f = 𝟙 S := by rw [Category.assoc, hs i]
  have := isFinite_prod_ker hx; have := flat_prod_ker hx
  refine (eq_of_le_of_finrank_eq (prod_ker_le_of_isFullSetOfSections hs hfull) f ?_).symm
  ext p; rw [finrank_prod_ker hx p, hfull.finrank_eq_card p]

/-- **Katz–Mazur, Theorem 1.8.3** (ideal-sheaf form). Let `f : X ⟶ S` be a separated smooth morphism
of relative dimension one and `I` an ideal sheaf on `X` cutting out a closed subscheme finite
locally free over `S`. Sections `s : ι → (S ⟶ I.subscheme)` of `V(I) ⟶ S` form a full set of
sections if and only if `I` is the product of the kernels of the induced sections
`s i ≫ I.subschemeι` of `f`. -/
theorem isFullSetOfSections_subschemeι_comp_iff {I : X.IdealSheafData}
    [IsFinite (I.subschemeι ≫ f)] [Flat (I.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (I.subschemeι ≫ f)]
    {s : ι → (S ⟶ I.subscheme)} (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 S) :
    IsFullSetOfSections (I.subschemeι ≫ f) s hs ↔
      I = ∏ i, (s i ≫ I.subschemeι).ker := by
  refine ⟨eq_prod_ker_of_isFullSetOfSections hs, fun hI ↦ ?_⟩
  have hx (i : ι) : (s i ≫ I.subschemeι) ≫ f = 𝟙 S := by rw [Category.assoc, hs i]
  let D := ∏ i, (s i ≫ I.subschemeι).ker
  have := isFinite_prod_ker hx; have := flat_prod_ker hx
  have := locallyOfFinitePresentation_prod_ker hx
  have : IsIso (inclusion hI.ge) :=
    IsClosedImmersion.isIso_of_ker_eq I.subschemeι D.subschemeι (inclusion hI.ge)
      (inclusion_subschemeι hI.ge) (by simp [hI, D])
  have hse (i : ι) : s i ≫ inclusion hI.ge = prodKerSection (fun k ↦ s k ≫ I.subschemeι) i := by
    rw [← cancel_mono D.subschemeι, Category.assoc, inclusion_subschemeι,
      prodKerSection_subschemeι]
  exact (isFullSetOfSections_of_iso (D.subschemeι ≫ f) (prodKerSection _) (prodKerSection_comp hx)
    (asIso (inclusion hI.ge)) (inclusion_subschemeι_assoc hI.ge f) hs hse).2
    (isFullSetOfSections_prod_ker hx)

/-- **Katz–Mazur, Theorem 1.8.3** (closed-immersion form). Let `f : X ⟶ S` be a separated smooth
morphism of relative dimension one and `i : Z ⟶ X` a closed immersion such that `i ≫ f : Z ⟶ S` is
finite locally free. Sections `s : ι → (S ⟶ Z)` of `i ≫ f` form a full set of sections if and only
if `i.ker = ∏ k, (s k ≫ i).ker`. -/
theorem isFullSetOfSections_iff_ker_eq_prod_ker {Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsFinite (i ≫ f)] [Flat (i ≫ f)] [LocallyOfFinitePresentation (i ≫ f)]
    {s : ι → (S ⟶ Z)} (hs : ∀ k, s k ≫ (i ≫ f) = 𝟙 S) :
    IsFullSetOfSections (i ≫ f) s hs ↔ i.ker = ∏ k, (s k ≫ i).ker := by
  let e : Z ≅ i.ker.subscheme := asIso i.toImage
  have heg : e.hom ≫ (i.ker.subschemeι ≫ f) = i ≫ f := i.toImage_imageι_assoc f
  have heinv : e.inv ≫ (i ≫ f) = i.ker.subschemeι ≫ f := (Iso.inv_comp_eq e).mpr heg.symm
  have : IsFinite (i.ker.subschemeι ≫ f) := heinv ▸ inferInstance
  have : Flat (i.ker.subschemeι ≫ f) := heinv ▸ inferInstance
  have : LocallyOfFinitePresentation (i.ker.subschemeι ≫ f) := heinv ▸ inferInstance
  have hs' (k : ι) : (s k ≫ e.hom) ≫ (i.ker.subschemeι ≫ f) = 𝟙 S := by
    rw [Category.assoc, heg, hs k]
  have hker (k : ι) : (s k ≫ e.hom) ≫ i.ker.subschemeι = s k ≫ i := by
    rw [Category.assoc]; exact congrArg (s k ≫ ·) i.toImage_imageι
  rw [isFullSetOfSections_of_iso (i.ker.subschemeι ≫ f) (fun k ↦ s k ≫ e.hom) hs' e heg hs
    (fun _ ↦ rfl), isFullSetOfSections_subschemeι_comp_iff hs']
  simp_rw [hker]

/-- **Uniqueness of the closed subscheme admitting a full set of sections**: on a separated smooth
curve `X ⟶ S`, at most one finite locally free closed subscheme can admit a given family of
sections of `X ⟶ S` as a full set of sections. -/
theorem eq_of_isFullSetOfSections {I₁ I₂ : X.IdealSheafData}
    [IsFinite (I₁.subschemeι ≫ f)] [Flat (I₁.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (I₁.subschemeι ≫ f)]
    [IsFinite (I₂.subschemeι ≫ f)] [Flat (I₂.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (I₂.subschemeι ≫ f)]
    {s₁ : ι → (S ⟶ I₁.subscheme)} {s₂ : ι → (S ⟶ I₂.subscheme)}
    (hs₁ : ∀ i, s₁ i ≫ (I₁.subschemeι ≫ f) = 𝟙 S)
    (hs₂ : ∀ i, s₂ i ≫ (I₂.subschemeι ≫ f) = 𝟙 S)
    (h₁ : IsFullSetOfSections (I₁.subschemeι ≫ f) s₁ hs₁)
    (h₂ : IsFullSetOfSections (I₂.subschemeι ≫ f) s₂ hs₂)
    (hcomp : ∀ i, s₁ i ≫ I₁.subschemeι = s₂ i ≫ I₂.subschemeι) :
    I₁ = I₂ := by
  rw [eq_prod_ker_of_isFullSetOfSections hs₁ h₁, eq_prod_ker_of_isFullSetOfSections hs₂ h₂]
  simp_rw [hcomp]

/-- **On a separated smooth curve, the full-set locus equals the divisor equality locus**
(ideal-sheaf form). -/
theorem fullSetLocus_subschemeι_comp_eq_equalityLocus {I : X.IdealSheafData}
    [IsFinite (I.subschemeι ≫ f)] [Flat (I.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (I.subschemeι ≫ f)]
    {s : ι → (S ⟶ I.subscheme)} (hs : ∀ i, s i ≫ (I.subschemeι ≫ f) = 𝟙 S) :
    letI := isFinite_prod_ker (f := f) (x := fun i ↦ s i ≫ I.subschemeι)
      fun i ↦ by rw [Category.assoc, hs i]
    letI := flat_prod_ker (f := f) (x := fun i ↦ s i ≫ I.subschemeι)
      fun i ↦ by rw [Category.assoc, hs i]
    letI := locallyOfFinitePresentation_prod_ker (f := f) (x := fun i ↦ s i ≫ I.subschemeι)
      fun i ↦ by rw [Category.assoc, hs i]
    fullSetLocus (I.subschemeι ≫ f) s hs =
      equalityLocus f I (∏ i, (s i ≫ I.subschemeι).ker) := by
  have hx (i : ι) : (s i ≫ I.subschemeι) ≫ f = 𝟙 S := by rw [Category.assoc, hs i]
  let _ := isFinite_prod_ker hx; let _ := flat_prod_ker hx
  let _ := locallyOfFinitePresentation_prod_ker hx
  let D := ∏ i, (s i ≫ I.subschemeι).ker
  have key {T' : Scheme.{u}} (r : T' ⟶ S) :
      fullSetLocus (I.subschemeι ≫ f) s hs ≤ r.ker ↔ equalityLocus f I D ≤ r.ker := by
    let f' := Limits.pullback.fst r f; let pX := Limits.pullback.snd r f
    have H : IsPullback pX f' f r := (IsPullback.of_hasPullback r f).flip
    have H_I := I.isPullback_subschemeMap_comap f H
    let _ : IsFinite ((I.comap pX).subschemeι ≫ f') :=
      MorphismProperty.of_isPullback H_I inferInstance
    let _ : Flat ((I.comap pX).subschemeι ≫ f') := MorphismProperty.of_isPullback H_I inferInstance
    let _ : LocallyOfFinitePresentation ((I.comap pX).subschemeι ≫ f') :=
      MorphismProperty.of_isPullback H_I inferInstance
    rw [fullSetLocus_le_ker_iff_of_isPullback (I.subschemeι ≫ f) s hs H_I
      (pullbackSubschemeSection_comp H I s hs) (pullbackSubschemeSection_subschemeMap H I s hs),
      isFullSetOfSections_subschemeι_comp_iff, prod_ker_pullbackSubschemeSection H I s hs,
      equalityLocus_le_ker_iff_of_isPullback I D H]
  exact le_antisymm
    (((key (equalityLocus f I D).subschemeι).2 (ker_subschemeι _).ge).trans (ker_subschemeι _).le)
    (((key (fullSetLocus (I.subschemeι ≫ f) s hs).subschemeι).1 (ker_subschemeι _).ge).trans
      (ker_subschemeι _).le)

/-- **On a separated smooth curve, the full-set locus equals the divisor equality locus**
(closed-immersion form). -/
theorem fullSetLocus_eq_equalityLocus {Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsFinite (i ≫ f)] [Flat (i ≫ f)] [LocallyOfFinitePresentation (i ≫ f)]
    {s : ι → (S ⟶ Z)} (hs : ∀ k, s k ≫ (i ≫ f) = 𝟙 S) :
    letI : IsFinite (i.ker.subschemeι ≫ f) :=
      ((Iso.inv_comp_eq (asIso i.toImage)).mpr (i.toImage_imageι_assoc f).symm) ▸ inferInstance
    letI : Flat (i.ker.subschemeι ≫ f) :=
      ((Iso.inv_comp_eq (asIso i.toImage)).mpr (i.toImage_imageι_assoc f).symm) ▸ inferInstance
    letI : LocallyOfFinitePresentation (i.ker.subschemeι ≫ f) :=
      ((Iso.inv_comp_eq (asIso i.toImage)).mpr (i.toImage_imageι_assoc f).symm) ▸ inferInstance
    letI := isFinite_prod_ker (f := f) (x := fun k ↦ s k ≫ i)
      fun k ↦ by rw [Category.assoc, hs k]
    letI := flat_prod_ker (f := f) (x := fun k ↦ s k ≫ i)
      fun k ↦ by rw [Category.assoc, hs k]
    letI := locallyOfFinitePresentation_prod_ker (f := f) (x := fun k ↦ s k ≫ i)
      fun k ↦ by rw [Category.assoc, hs k]
    fullSetLocus (i ≫ f) s hs = equalityLocus f i.ker (∏ k, (s k ≫ i).ker) := by
  let e : Z ≅ i.ker.subscheme := asIso i.toImage
  have heg : e.hom ≫ (i.ker.subschemeι ≫ f) = i ≫ f := i.toImage_imageι_assoc f
  have heinv : e.inv ≫ (i ≫ f) = i.ker.subschemeι ≫ f := (Iso.inv_comp_eq e).mpr heg.symm
  let _ : IsFinite (i.ker.subschemeι ≫ f) := heinv ▸ inferInstance
  let _ : Flat (i.ker.subschemeι ≫ f) := heinv ▸ inferInstance
  let _ : LocallyOfFinitePresentation (i.ker.subschemeι ≫ f) := heinv ▸ inferInstance
  have hs' (k : ι) : (s k ≫ e.hom) ≫ (i.ker.subschemeι ≫ f) = 𝟙 S := by
    rw [Category.assoc, heg, hs k]
  have hker (k : ι) : (s k ≫ e.hom) ≫ i.ker.subschemeι = s k ≫ i := by
    rw [Category.assoc]; exact congrArg (s k ≫ ·) i.toImage_imageι
  rw [fullSetLocus_of_iso (i.ker.subschemeι ≫ f) (fun k ↦ s k ≫ e.hom) hs' e heg hs
    (fun _ ↦ rfl), fullSetLocus_subschemeι_comp_eq_equalityLocus hs']
  congr 1; simp_rw [hker]

end MainTheorem

