namespace TauCeti.CAff

/-! ### Rational coverings, the rational coverage, and `ratTopology` -/

/-- A finite family of rational data `(T i, s i)` on `X : CAff` is a *rational covering* if every
`T i` spans an open ideal in `X.ring` and the rational subsets `R(T i / s i)` cover `Spa(X)`. -/
structure IsRationalCovering (X : CAff.{u}) {ι : Type*} [Finite ι]
    (T : ι → Finset X.ring) (s : ι → X.ring) : Prop where
  /-- Each numerator set generates an open ideal in `X.ring`. -/
  isOpen_span : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)
  /-- The rational subsets `R(T i / s i)` cover `Spa(X)`. -/
  iUnion_eq_univ :
    (⋃ i, Subtype.val ⁻¹' rationalSubset X.pair.plus (T i) (s i) :
      Set ↥(ValuationSpectrum.spa X.pair.plus)) = Set.univ

/-- An empty family is a rational covering of `X` if and only if `X.ring` is trivial. -/
@[simp]
theorem isRationalCovering_empty_iff (X : CAff.{u}) {ι : Type*} [IsEmpty ι]
    (T : ι → Finset X.ring) (s : ι → X.ring) :
    IsRationalCovering X T s ↔ Subsingleton X.ring :=
  ⟨fun h ↦ (isEmpty_spa_iff X).mp ⟨fun w ↦ by
      have hw : w ∈ (Set.univ : Set ↥(ValuationSpectrum.spa X.pair.plus)) := Set.mem_univ w
      rwa [← h.iUnion_eq_univ, Set.iUnion_of_empty] at hw⟩,
    fun hsub ↦ ⟨fun i ↦ IsEmpty.elim ‹_› i,
      Set.eq_univ_of_forall fun w ↦ ((isEmpty_spa_iff X).mpr hsub).elim w⟩⟩

open scoped Classical in
/-- Along any morphism `ψ : X ⟶ Y` in `CAff` whose images of the numerator ideals `Ideal.span (T i)`
are open in `Y.ring`, a rational covering `(T i, s i)` of `X` pulls back directly to a rational
covering `(ψ '' T i, ψ (s i))` of `Y`. -/
theorem IsRationalCovering.pullback_of_isOpen {X Y : CAff.{u}} (ψ : X ⟶ Y)
    {ι : Type*} [Finite ι] {T : ι → Finset X.ring} {s : ι → X.ring}
    (hcov : IsRationalCovering X T s)
    (hopen : ∀ i, IsOpen (Ideal.span ((T i).image ψ.toRingHom : Set Y.ring) : Set Y.ring)) :
    IsRationalCovering Y (fun i ↦ (T i).image ψ.toRingHom) (fun i ↦ ψ.toRingHom (s i)) where
  isOpen_span := hopen
  iUnion_eq_univ := by
    simp only [← Pair.Hom.spaComap_preimage_rationalSubset]
    rw [← Set.preimage_iUnion, hcov.iUnion_eq_univ, Set.preimage_univ]

open scoped Classical in
/-- Along an adic morphism `ψ : X ⟶ Y` in `CAff`, a rational covering `(T i, s i)` of `X` pulls
back directly to a rational covering `(ψ '' T i, ψ (s i))` of `Y`. Without `[IsAdicHom ψ.toRingHom]`
or an explicit openness hypothesis on the mapped numerator ideals, the mapped ideal need not be open
in `Y.ring`; general base change in `rationalCoverage` instead refines the open preimages by
rational subsets of `Spa(Y)`. -/
theorem IsRationalCovering.pullback {X Y : CAff.{u}} (ψ : X ⟶ Y) [IsAdicHom ψ.toRingHom]
    {ι : Type*} [Finite ι] {T : ι → Finset X.ring} {s : ι → X.ring}
    (hcov : IsRationalCovering X T s) :
    IsRationalCovering Y (fun i ↦ (T i).image ψ.toRingHom) (fun i ↦ ψ.toRingHom (s i)) :=
  hcov.pullback_of_isOpen ψ fun i ↦ by
    rw [Finset.coe_image, ← Ideal.map_span]
    exact IsAdicHom.isOpen_map ‹_› (hcov.isOpen_span i)

/-- The presieve on `op X` in `CAff.{u}ᵒᵖ` formed by the canonical rational localizations
`op (X.rationalLocalization (T i) (s i) (hT i)) ⟶ op X`. -/
def rationalCoverPresieve (X : CAff.{u}) {ι : Type*} (T : ι → Finset X.ring)
    (s : ι → X.ring) (hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)) :
    Presieve (op X) :=
  Presieve.ofArrows (fun i ↦ op (X.rationalLocalization (T i) (s i) (hT i)))
    (fun i ↦ (X.rationalLocalizationHom (T i) (s i) (hT i)).op)

/-- Defining equation of `CAff.rationalCoverPresieve`. -/
theorem rationalCoverPresieve_eq_ofArrows (X : CAff.{u}) {ι : Type*} (T : ι → Finset X.ring)
    (s : ι → X.ring) (hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)) :
    X.rationalCoverPresieve T s hT =
      Presieve.ofArrows (fun i ↦ op (X.rationalLocalization (T i) (s i) (hT i)))
        (fun i ↦ (X.rationalLocalizationHom (T i) (s i) (hT i)).op) := by
  rfl

/-- Each canonical rational localization morphism belongs to `X.rationalCoverPresieve T s hT`. -/
@[simp]
theorem rationalCoverPresieve_mk {X : CAff.{u}} {ι : Type*} {T : ι → Finset X.ring}
    {s : ι → X.ring} {hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)} (i : ι) :
    X.rationalCoverPresieve T s hT (X.rationalLocalizationHom (T i) (s i) (hT i)).op :=
  Presieve.ofArrows.mk i

/-- A rational cover presieve over an empty index type is the empty presieve `⊥`. -/
@[simp]
theorem rationalCoverPresieve_of_isEmpty (X : CAff.{u}) {ι : Type*} [IsEmpty ι]
    (T : ι → Finset X.ring) (s : ι → X.ring)
    (hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)) :
    X.rationalCoverPresieve T s hT = ⊥ := by
  rw [rationalCoverPresieve_eq_ofArrows, Presieve.ofArrows_of_isEmpty]

/-- Membership characterization for `X.rationalCoverPresieve T s hT`. -/
theorem mem_rationalCoverPresieve_iff {X : CAff.{u}} {ι : Type*} {T : ι → Finset X.ring}
    {s : ι → X.ring} {hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)}
    {Z : CAff.{u}ᵒᵖ} {g : Z ⟶ op X} :
    X.rationalCoverPresieve T s hT g ↔
      ∃ (i : ι) (h : op (X.rationalLocalization (T i) (s i) (hT i)) = Z),
        g = eqToHom h.symm ≫ (X.rationalLocalizationHom (T i) (s i) (hT i)).op := by
  rw [rationalCoverPresieve_eq_ofArrows]
  refine ⟨fun hg ↦ Presieve.ofArrows_surj _ _ hg, ?_⟩
  rintro ⟨i, rfl, rfl⟩
  simpa using Presieve.ofArrows.mk i

/-- **The rational coverage on `CAffᵒᵖ`.** Covering presieves of `op X` are the presieves
`X.rationalCoverPresieve T s` attached to finite rational coverings `(T, s)` of `X`. This
coverage is pullback-stable along arbitrary (not necessarily adic) morphisms in `CAffᵒᵖ`. -/
def rationalCoverage : Coverage (CAff.{u}ᵒᵖ) where
  coverings U :=
    {R | ∃ (ι : Type u) (_ : Finite ι) (T : ι → Finset (unop U).ring)
      (s : ι → (unop U).ring) (hcov : IsRationalCovering (unop U) T s),
      R = (unop U).rationalCoverPresieve T s hcov.isOpen_span}
  pullback := by
    -- Cover each open preimage `ψ.spaComap⁻¹(R(T i / s i))` by rational subsets of `Spa(Y₀)`,
    -- extract a finite subcover by quasi-compactness of `Spa(Y₀)`, and lift each piece via the
    -- universal property of rational localization.
    rintro U V f R ⟨ι, _, T, s, hcov, rfl⟩
    let X₀ := unop U; let Y₀ := unop V; let ψ : X₀ ⟶ Y₀ := f.unop
    obtain ⟨𝒲, h𝒲_rat, h𝒲_fin, h𝒲_sub, h𝒲_cov⟩ :=
      exists_finite_spaRationalFamily_refinement (univ_mem_spaRationalFamily Y₀.pair.plus)
        (fun i ↦ ψ.spaComap ⁻¹'
          (Subtype.val ⁻¹' rationalSubset X₀.pair.plus (T i) (s i)))
        (fun i ↦ (isOpen_val_preimage_rationalSubset X₀.pair.plus (T i) (s i)).preimage
          ψ.continuous_spaComap)
        (fun w _ ↦ by
          obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov.iUnion_eq_univ ▸ Set.mem_univ (ψ.spaComap w))
          exact Set.mem_iUnion.mpr ⟨i, hi⟩)
    have : Finite ↥𝒲 := h𝒲_fin.to_subtype
    choose idx hsub using fun k : ↥𝒲 ↦ h𝒲_sub k.val k.property
    choose T' s' hT' hW_eq using fun k : ↥𝒲 ↦ mem_spaRationalFamily_iff.mp (h𝒲_rat k.property)
    have hcovY : IsRationalCovering Y₀ T' s' :=
      { isOpen_span := hT'
        iUnion_eq_univ := Set.eq_univ_of_forall fun w ↦ by
          obtain ⟨W, hW, hwW⟩ := Set.mem_sUnion.mp (h𝒲_cov (Set.mem_univ w))
          exact Set.mem_iUnion.mpr ⟨⟨W, hW⟩, hW_eq ⟨W, hW⟩ ▸ hwW⟩ }
    refine ⟨Y₀.rationalCoverPresieve T' s' hcovY.isOpen_span,
      ⟨↥𝒲, inferInstance, T', s', hcovY, rfl⟩, fun Z g hg ↦ ?_⟩
    obtain ⟨k, rfl, rfl⟩ := mem_rationalCoverPresieve_iff.mp hg
    let hφX := isRationalLocalization_rationalLocalizationHom X₀ (T (idx k))
      (s (idx k)) (hcov.isOpen_span (idx k))
    let φY := Y₀.rationalLocalizationHom (T' k) (s' k) (hcovY.isOpen_span k)
    let χ := hφX.lift (ψ ≫ φY) fun u ↦ by
      rw [comp_spaComap]
      exact hsub k (hW_eq k ▸
        ((isRationalLocalization_rationalLocalizationHom Y₀ _ _
          (hcovY.isOpen_span k)).mapsTo_spaComap u))
    exact ⟨_, χ.op, _, rationalCoverPresieve_mk (idx k), by
      rw [eqToHom_refl, Category.id_comp, ← op_comp, hφX.fac, op_comp]; rfl⟩

/-- Membership in `CAff.rationalCoverage (op X)`: a presieve belongs to the rational coverage on
`op X` if and only if it is `X.rationalCoverPresieve T s` for a finite rational covering `(T, s)`.
-/
theorem mem_rationalCoverage_iff {X : CAff.{u}} {R : Presieve (op X)} :
    R ∈ rationalCoverage (op X) ↔
      ∃ (ι : Type u) (_ : Finite ι) (T : ι → Finset X.ring) (s : ι → X.ring)
        (hcov : IsRationalCovering X T s),
        R = X.rationalCoverPresieve T s hcov.isOpen_span :=
  Iff.rfl

/-- Every finite rational covering presieve of `X` belongs to `CAff.rationalCoverage (op X)`,
regardless of the universe of the index type `ι`. -/
theorem rationalCoverPresieve_mem_rationalCoverage (X : CAff.{u}) {ι : Type*} [Finite ι]
    (T : ι → Finset X.ring) (s : ι → X.ring) (hcov : IsRationalCovering X T s) :
    X.rationalCoverPresieve T s hcov.isOpen_span ∈ rationalCoverage (op X) := by
  classical
  let e : ULift.{u} (Fin (Nat.card ι)) ≃ ι :=
    Equiv.ulift.{u}.trans (Finite.equivFin ι).symm
  have hcov' : IsRationalCovering X (T ∘ e) (s ∘ e) :=
    { isOpen_span := fun k ↦ hcov.isOpen_span (e k)
      iUnion_eq_univ := (e.surjective.iUnion_comp
        (fun i ↦ (Subtype.val ⁻¹' rationalSubset X.pair.plus (T i) (s i) :
          Set ↥(ValuationSpectrum.spa X.pair.plus)))).trans hcov.iUnion_eq_univ }
  refine ⟨ULift.{u} (Fin (Nat.card ι)), inferInstance, T ∘ e, s ∘ e, hcov', ?_⟩
  rw [rationalCoverPresieve_eq_ofArrows, rationalCoverPresieve_eq_ofArrows]
  exact (Presieve.ofArrows_comp_eq_of_surjective
    (fun i ↦ (X.rationalLocalizationHom (T i) (s i) (hcov.isOpen_span i)).op) e.surjective).symm

/-- **The rational Grothendieck topology on `CAffᵒᵖ`**, generated by `CAff.rationalCoverage`. -/
def ratTopology : GrothendieckTopology (CAff.{u}ᵒᵖ) :=
  rationalCoverage.toGrothendieck

/-- Defining equation of `CAff.ratTopology`. -/
theorem ratTopology_eq : ratTopology.{u} = rationalCoverage.{u}.toGrothendieck := by
  rfl

/-- Any family of rational localizations `(φ i : X ⟶ Y i)` for `(T i, s i)` generates the same
sieve on `op X` as `X.rationalCoverPresieve T s`. -/
theorem sieve_ofArrows_eq_generate_rationalCoverPresieve {X : CAff.{u}} {ι : Type*}
    {Y : ι → CAff.{u}} {φ : ∀ i, X ⟶ Y i} {T : ι → Finset X.ring} {s : ι → X.ring}
    (hφ : ∀ i, IsRationalLocalization (φ i) (T i) (s i)) :
    Sieve.ofArrows (fun i ↦ op (Y i)) (fun i ↦ (φ i).op) =
      Sieve.generate (X.rationalCoverPresieve T s fun i ↦ (hφ i).isOpen_span) := by
  refine le_antisymm ?_ ?_
  · rw [Sieve.generate_le_iff]
    rintro Z _ ⟨i⟩
    exact ⟨_, (hφ i).isoCanonical.hom.op,
      (X.rationalLocalizationHom (T i) (s i) (hφ i).isOpen_span).op,
      rationalCoverPresieve_mk i,
      by rw [← op_comp, IsRationalLocalization.rationalLocalizationHom_comp_isoCanonical_hom]⟩
  · rw [Sieve.generate_le_iff, rationalCoverPresieve_eq_ofArrows]
    rintro Z _ ⟨i⟩
    exact ⟨_, (hφ i).isoCanonical.inv.op, (φ i).op, Presieve.ofArrows.mk i,
      by rw [← op_comp, IsRationalLocalization.comp_isoCanonical_inv]⟩

/-- A `Type*`-valued presheaf on `CAff.{u}ᵒᵖ` satisfies `Presieve.IsSheafFor` on a family of
rational localizations `(φ i : X ⟶ Y i)` for `(T i, s i)` if and only if it satisfies
`Presieve.IsSheafFor` on `X.rationalCoverPresieve T s`. -/
theorem isSheafFor_ofArrows_iff_rationalCoverPresieve {X : CAff.{u}} {ι : Type*}
    {Y : ι → CAff.{u}} {φ : ∀ i, X ⟶ Y i} {T : ι → Finset X.ring} {s : ι → X.ring}
    (hφ : ∀ i, IsRationalLocalization (φ i) (T i) (s i))
    (P : (CAff.{u}ᵒᵖ)ᵒᵖ ⥤ Type*) :
    Presieve.IsSheafFor P (Presieve.ofArrows (fun i ↦ op (Y i)) fun i ↦ (φ i).op) ↔
      Presieve.IsSheafFor P (X.rationalCoverPresieve T s fun i ↦ (hφ i).isOpen_span) := by
  have hgen : (Sieve.ofArrows (fun i ↦ op (Y i)) fun i ↦ (φ i).op).arrows =
      (Sieve.generate (X.rationalCoverPresieve T s fun i ↦ (hφ i).isOpen_span)).arrows :=
    congrArg Sieve.arrows (sieve_ofArrows_eq_generate_rationalCoverPresieve hφ)
  exact ((Presieve.isSheafFor_iff_generate (R := Presieve.ofArrows _ _)).trans
    (iff_of_eq (congrArg (Presieve.IsSheafFor P) hgen))).trans
    (Presieve.isSheafFor_iff_generate (R := X.rationalCoverPresieve _ _ _)).symm

/-- A presheaf `F : (CAff.{u}ᵒᵖ)ᵒᵖ ⥤ D` valued in any category `D` is a sheaf for
`CAff.ratTopology` if and only if for every `E : D`, `F ⋙ coyoneda.obj (op E)` satisfies
`Presieve.IsSheafFor` on every finite family of rational localizations `(φ i : X ⟶ Y i)` whose
rational subsets cover `Spa(X)`. -/
theorem isSheaf_iff {D : Type*} [Category D] (F : (CAff.{u}ᵒᵖ)ᵒᵖ ⥤ D) :
    Presheaf.IsSheaf ratTopology.{u} F ↔
      ∀ (E : D) (X : CAff.{u}) {ι : Type u} [Finite ι] {Y : ι → CAff.{u}}
        (φ : ∀ i, X ⟶ Y i) (T : ι → Finset X.ring) (s : ι → X.ring),
        (∀ i, IsRationalLocalization (φ i) (T i) (s i)) →
        (⋃ i, Subtype.val ⁻¹' rationalSubset X.pair.plus (T i) (s i) :
          Set ↥(ValuationSpectrum.spa X.pair.plus)) = Set.univ →
        Presieve.IsSheafFor (F ⋙ coyoneda.obj (op E))
          (Presieve.ofArrows (fun i ↦ op (Y i)) fun i ↦ (φ i).op) := by
  refine forall_congr' fun E ↦ ?_
  rw [ratTopology_eq, Presieve.isSheaf_coverage]
  refine ⟨fun h X ι _ Y φ T s hφ hcov ↦ ?_, fun h U R hR ↦ ?_⟩
  · exact (isSheafFor_ofArrows_iff_rationalCoverPresieve hφ _).mpr <|
      h (R := X.rationalCoverPresieve T s fun i ↦ (hφ i).isOpen_span)
        ⟨ι, ‹_›, T, s, ⟨fun i ↦ (hφ i).isOpen_span, hcov⟩, rfl⟩
  · rcases U with ⟨X⟩
    rcases hR with ⟨ι, _, T, s, hcov, rfl⟩
    rw [rationalCoverPresieve_eq_ofArrows]
    exact h X (fun i ↦ X.rationalLocalizationHom (T i) (s i) (hcov.isOpen_span i)) T s
      (fun i ↦ isRationalLocalization_rationalLocalizationHom X (T i) (s i) (hcov.isOpen_span i))
      hcov.iUnion_eq_univ

private theorem exists_mem_range_spaComap_of_saturate {U : CAff.{u}ᵒᵖ} {S : Sieve U}
    (hS : Coverage.Saturate rationalCoverage U S)
    (v : ValuationSpectrum.spa (unop U).pair.plus) :
    ∃ (Y : CAff.{u}) (φ : unop U ⟶ Y), S φ.op ∧ v ∈ Set.range φ.spaComap := by
  induction hS with
  | of U R hR =>
    obtain ⟨ι, _, T, s, hcov, rfl⟩ := hR
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov.iUnion_eq_univ ▸ Set.mem_univ v)
    let φ := (unop U).rationalLocalizationHom (T i) (s i) (hcov.isOpen_span i)
    refine ⟨_, φ, ⟨_, 𝟙 _, φ.op, rationalCoverPresieve_mk i, Category.id_comp _⟩, ?_⟩
    rwa [(isRationalLocalization_rationalLocalizationHom (unop U) _ _ _).range_spaComap]
  | top U => exact ⟨unop U, 𝟙 _, trivial, v, by rw [id_spaComap]; rfl⟩
  | transitive U R S _ _ ihR ihS =>
    obtain ⟨Y, φ, hφ, w, rfl⟩ := ihR v
    obtain ⟨Z, ψ, hψ, u, rfl⟩ := ihS hφ w
    exact ⟨Z, φ ≫ ψ, hψ, u, by rw [comp_spaComap]; rfl⟩

open scoped Classical in
/-- The sieve generated by any family of open-span rational data covering `Spa(X)` (not
necessarily finite) is covering in `CAff.ratTopology (op X)`. -/
theorem generate_rationalCoverPresieve_mem_ratTopology {X : CAff.{u}} {ι : Type*}
    {T : ι → Finset X.ring} {s : ι → X.ring}
    (hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring))
    (hcov : (⋃ i, Subtype.val ⁻¹' rationalSubset X.pair.plus (T i) (s i) :
      Set ↥(ValuationSpectrum.spa X.pair.plus)) = Set.univ) :
    Sieve.generate (X.rationalCoverPresieve T s hT) ∈ ratTopology (op X) := by
  have hsup : (⨆ i, spaBasicOpen X.pair.plus (T i) (s i)) = ⊤ :=
    Opens.ext <| by
      rw [Opens.coe_iSup, Opens.coe_top]
      refine Set.eq_univ_of_forall fun w ↦ Set.mem_iUnion.mpr ?_
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov ▸ Set.mem_univ w)
      exact ⟨i, mem_spaBasicOpen.mpr hi⟩
  obtain ⟨t, ht⟩ := exists_finite_subcover_spaRationalOpens
    (top_mem_spaRationalOpens X.pair.plus) hsup
  have hcov_sub : IsRationalCovering X (fun k : ↥t ↦ T k.val) (fun k : ↥t ↦ s k.val) :=
    { isOpen_span := fun k ↦ hT k.val
      iUnion_eq_univ := Set.eq_univ_of_forall fun w ↦ by
        obtain ⟨k, hk⟩ := Opens.mem_iSup.mp (ht ▸ Opens.mem_top w)
        exact Set.mem_iUnion.mpr ⟨k, mem_spaBasicOpen.mp hk⟩ }
  refine ratTopology.superset_covering ?_
    (Coverage.Saturate.of (op X) _ (rationalCoverPresieve_mem_rationalCoverage X _ _ hcov_sub))
  rw [Sieve.generate_le_iff]
  rintro Z g ⟨k⟩
  exact Sieve.le_generate _ _ _ (rationalCoverPresieve_mk k.val)

/-- The sieve generated by any covering family of rational localizations `(φ i : X ⟶ Y i)` (not
necessarily finite) is covering in `CAff.ratTopology (op X)`. -/
theorem sieve_ofArrows_mem_ratTopology {X : CAff.{u}} {ι : Type*}
    {Y : ι → CAff.{u}} {φ : ∀ i, X ⟶ Y i} {T : ι → Finset X.ring} {s : ι → X.ring}
    (hφ : ∀ i, IsRationalLocalization (φ i) (T i) (s i))
    (hcov : (⋃ i, Subtype.val ⁻¹' rationalSubset X.pair.plus (T i) (s i) :
      Set ↥(ValuationSpectrum.spa X.pair.plus)) = Set.univ) :
    Sieve.ofArrows (fun i ↦ op (Y i)) (fun i ↦ (φ i).op) ∈ ratTopology (op X) := by
  rw [sieve_ofArrows_eq_generate_rationalCoverPresieve hφ]
  exact generate_rationalCoverPresieve_mem_ratTopology (fun i ↦ (hφ i).isOpen_span) hcov

/-- Every covering sieve in `CAff.ratTopology (op X)` is jointly surjective on `Spa(X)`. -/
theorem exists_mem_range_spaComap_of_mem_ratTopology {X : CAff.{u}} {S : Sieve (op X)}
    (hS : S ∈ ratTopology (op X)) (v : ValuationSpectrum.spa X.pair.plus) :
    ∃ (Y : CAff.{u}) (φ : X ⟶ Y), S φ.op ∧ v ∈ Set.range φ.spaComap :=
  exists_mem_range_spaComap_of_saturate hS v

/-- The empty sieve `⊥` covers `op X` in `CAff.ratTopology` if and only if `X.ring` is trivial. -/
@[simp]
theorem bot_mem_ratTopology_iff (X : CAff.{u}) :
    (⊥ : Sieve (op X)) ∈ ratTopology (op X) ↔ Subsingleton X.ring := by
  refine ⟨fun hbot ↦ (isEmpty_spa_iff X).mp ⟨fun v ↦ by
      obtain ⟨_, _, hmem, -⟩ := exists_mem_range_spaComap_of_mem_ratTopology hbot v; exact hmem⟩,
    fun hsub ↦ ?_⟩
  have hcov : IsRationalCovering X (fun _ : PEmpty.{u + 1} ↦ ∅) (fun _ ↦ 0) :=
    (isRationalCovering_empty_iff X _ _).mpr hsub
  simpa only [rationalCoverPresieve_of_isEmpty, Sieve.generate_bot] using
    generate_rationalCoverPresieve_mem_ratTopology hcov.isOpen_span hcov.iUnion_eq_univ

/-! ### Rational sheafiness -/

/-- An object `X : CAff.{u}` is *rational-sheafy* if for every rational localization `φ : X ⟶ Y`
in `CAff.{u}` and every covering presieve `R ∈ rationalCoverage (op Y)`, the global-ring presheaf
`CAff.globalSections` satisfies `Presieve.IsSheafFor CAff.globalSections R`. -/
def IsRationalSheafy (X : CAff.{u}) : Prop :=
  ∀ ⦃Y : CAff.{u}⦄ (φ : X ⟶ Y) (T₀ : Finset X.ring) (s₀ : X.ring),
    IsRationalLocalization φ T₀ s₀ →
    ∀ R ∈ rationalCoverage (op Y), Presieve.IsSheafFor globalSections R

/-- Unfolding characterization of `CAff.IsRationalSheafy`. -/
theorem isRationalSheafy_iff (X : CAff.{u}) :
    X.IsRationalSheafy ↔
      ∀ ⦃Y : CAff.{u}⦄ (φ : X ⟶ Y) (T₀ : Finset X.ring) (s₀ : X.ring),
        IsRationalLocalization φ T₀ s₀ →
        ∀ R ∈ rationalCoverage (op Y), Presieve.IsSheafFor globalSections R :=
  Iff.rfl

/-- Elimination rule for `CAff.IsRationalSheafy` on a rational localization and any finite
covering family of rational localizations `(ψ i : Y ⟶ Z i)`. -/
theorem IsRationalSheafy.isSheafFor {X Y : CAff.{u}} (hX : X.IsRationalSheafy)
    {φ : X ⟶ Y} {T₀ : Finset X.ring} {s₀ : X.ring}
    (hφ : IsRationalLocalization φ T₀ s₀)
    {ι : Type*} [Finite ι] {Z : ι → CAff.{u}} (ψ : ∀ i, Y ⟶ Z i)
    {T : ι → Finset Y.ring} {s : ι → Y.ring}
    (hψ : ∀ i, IsRationalLocalization (ψ i) (T i) (s i))
    (hcov : (⋃ i, Subtype.val ⁻¹' rationalSubset Y.pair.plus (T i) (s i) :
      Set ↥(ValuationSpectrum.spa Y.pair.plus)) = Set.univ) :
    Presieve.IsSheafFor globalSections
      (Presieve.ofArrows (fun i ↦ op (Z i)) fun i ↦ (ψ i).op) := by
  rw [isSheafFor_ofArrows_iff_rationalCoverPresieve hψ]
  exact hX φ T₀ s₀ hφ _
    (rationalCoverPresieve_mem_rationalCoverage Y T s ⟨fun i ↦ (hψ i).isOpen_span, hcov⟩)

/-- Rational sheafiness passes along any rational localization `φ : X ⟶ Y` in `CAff`. -/
theorem IsRationalLocalization.isRationalSheafy {X Y : CAff.{u}} {φ : X ⟶ Y}
    {T₀ : Finset X.ring} {s₀ : X.ring} (hφ : IsRationalLocalization φ T₀ s₀)
    (hX : X.IsRationalSheafy) : Y.IsRationalSheafy := by
  intro Z ψ T₁ s₁ hψ R hR
  obtain ⟨T', s', -, hcomp⟩ := hφ.exists_comp hψ
  exact hX (φ ≫ ψ) T' s' hcomp R hR

