namespace TauCeti.CAff

/-! ### Rational localizations in `CAff` -/

/-- A morphism `φ : X ⟶ Y` in `CAff` is a *rational localization* of `X` for `(T, s)` if `T` spans
an open ideal in `X.ring`, `φ.spaComap` maps `Spa(Y)` into `R(T/s)`, and `φ` is initial among
morphisms `ψ : X ⟶ Z` in `CAff` whose pullback on `Spa` lands in `R(T/s)`. -/
structure IsRationalLocalization {X Y : CAff.{u}} (φ : X ⟶ Y)
    (T : Finset X.ring) (s : X.ring) : Prop where
  /-- The numerator set `T` generates an open ideal in `X.ring`. -/
  isOpen_span : IsOpen (Ideal.span (T : Set X.ring) : Set X.ring)
  /-- Every point of `Spa(Y)` pulls back along `φ` into `R(T/s)`. -/
  mapsTo_spaComap : ∀ w : ValuationSpectrum.spa Y.pair.plus,
    (φ.spaComap w).val ∈ rationalSubset X.pair.plus T s
  /-- Any morphism `ψ : X ⟶ Z` mapping `Spa(Z)` into `R(T/s)` factors uniquely through `φ`. -/
  existsUnique_factorization : ∀ ⦃Z : CAff.{u}⦄ (ψ : X ⟶ Z),
    (∀ w : ValuationSpectrum.spa Z.pair.plus,
      (ψ.spaComap w).val ∈ rationalSubset X.pair.plus T s) →
    ∃! χ : Y ⟶ Z, φ ≫ χ = ψ

/-- The canonical completed rational localization `(A⟨T/s⟩, A_U⁺)` of `X : CAff` at `(T, s)` when
`T` spans an open ideal in `X.ring`. -/
noncomputable def rationalLocalization (X : CAff.{u}) (T : Finset X.ring) (s : X.ring)
    (hT : IsOpen (Ideal.span (T : Set X.ring) : Set X.ring)) : CAff.{u} :=
  let P := X.pairOfDefinition
  let hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hT
  letI := locUniformSpace P T s (Localization.Away s) hden
  letI := isUniformAddGroup_locUniformSpace P T s (Localization.Away s) hden
  letI := isTopologicalRing_locUniformSpace P T s (Localization.Away s) hden
  letI := isHuberRing_completion_locTopology P T s (Localization.Away s) hden
  CAff.of (P.rationalLocalizationPair X.pair X.ringOfDefinition_le_plus T s
    (Localization.Away s) hden)

/-- The canonical structure morphism `X ⟶ X.rationalLocalization T s hT` in `CAff`. -/
noncomputable def rationalLocalizationHom (X : CAff.{u}) (T : Finset X.ring) (s : X.ring)
    (hT : IsOpen (Ideal.span (T : Set X.ring) : Set X.ring)) :
    X ⟶ X.rationalLocalization T s hT :=
  let P := X.pairOfDefinition
  let hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hT
  letI := locUniformSpace P T s (Localization.Away s) hden
  letI := isUniformAddGroup_locUniformSpace P T s (Localization.Away s) hden
  letI := isTopologicalRing_locUniformSpace P T s (Localization.Away s) hden
  letI := isHuberRing_completion_locTopology P T s (Localization.Away s) hden
  P.toCompletionLocHom X.pair X.ringOfDefinition_le_plus T s (Localization.Away s) hden

private theorem rationalLocalization_eq_completedPlusPair {X : CAff.{u}} (T : Finset X.ring)
    (s : X.ring) (hT : IsOpen (Ideal.span (T : Set X.ring) : Set X.ring)) :
    let P := X.pairOfDefinition
    let hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hT
    letI := locUniformSpace P T s (Localization.Away s) hden
    letI := isUniformAddGroup_locUniformSpace P T s (Localization.Away s) hden
    letI := isTopologicalRing_locUniformSpace P T s (Localization.Away s) hden
    letI := isHuberRing_completion_locTopology P T s (Localization.Away s) hden
    X.rationalLocalization T s hT =
      CAff.of
        ⟨completedPlusSubring P X.pair.plus T s (Localization.Away s) hden,
          isRingOfIntegralElements_completedPlusSubring P X.pair.plus
            (fun j _ ↦ X.ringOfDefinition_le_plus j.property)
            X.pair.isRingOfIntegralElements.isPowerBounded_of_mem
            T s (Localization.Away s) hden⟩ := by
  let P := X.pairOfDefinition
  let hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hT
  let _ := locUniformSpace P T s (Localization.Away s) hden
  let _ := isUniformAddGroup_locUniformSpace P T s (Localization.Away s) hden
  let _ := isTopologicalRing_locUniformSpace P T s (Localization.Away s) hden
  let _ := isHuberRing_completion_locTopology P T s (Localization.Away s) hden
  exact congrArg CAff.of <| Pair.ext <|
    P.rationalLocalizationPair_plus X.pair X.ringOfDefinition_le_plus T s _ _

private theorem toRingHom_eqToHom_comp_eqToHom_apply {A B : Type u}
    [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsHuberRing A]
    [CompleteSpace A] [T0Space A]
    [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B]
    [CompleteSpace B] [T0Space B]
    {S₁ S₁' : Pair A} {S₂ S₂' : Pair B}
    (h₁ : CAff.of S₁ = CAff.of S₁') (h₂ : CAff.of S₂ = CAff.of S₂')
    (f : CAff.of S₁' ⟶ CAff.of S₂') (a : A) :
    (eqToHom h₁ ≫ f ≫ eqToHom h₂.symm).toRingHom a = f.toRingHom a := by
  have hp₁ : S₁ = S₁' := by injection h₁
  have hp₂ : S₂ = S₂' := by injection h₂
  cases hp₁; cases hp₂; simp

private theorem rationalLocalizationHom_comp_pairHomOfRationalSubsetSubset {X : CAff.{u}}
    {T : Finset X.ring} {s : X.ring} (hT : IsOpen (Ideal.span (T : Set X.ring) : Set X.ring))
    {T' : Finset X.ring} {s' : X.ring} (hT' : IsOpen (Ideal.span (T' : Set X.ring) : Set X.ring))
    (hsub : rationalSubset X.pair.plus T' s' ⊆ rationalSubset X.pair.plus T s) :
    let P := X.pairOfDefinition
    let hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hT
    let hden' := hasDenominatorPower_of_isOpen_span P T' s' (Localization.Away s') hT'
    letI := locUniformSpace P T s (Localization.Away s) hden
    letI := isUniformAddGroup_locUniformSpace P T s (Localization.Away s) hden
    letI := isTopologicalRing_locUniformSpace P T s (Localization.Away s) hden
    letI := isHuberRing_completion_locTopology P T s (Localization.Away s) hden
    letI := locUniformSpace P T' s' (Localization.Away s') hden'
    letI := isUniformAddGroup_locUniformSpace P T' s' (Localization.Away s') hden'
    letI := isTopologicalRing_locUniformSpace P T' s' (Localization.Away s') hden'
    letI := isHuberRing_completion_locTopology P T' s' (Localization.Away s') hden'
    X.rationalLocalizationHom T s hT ≫
        (eqToHom (rationalLocalization_eq_completedPlusPair T s hT) ≫
          pairHomOfRationalSubsetSubset P X.pair.plus
            (fun j _ ↦ X.ringOfDefinition_le_plus j.property)
            X.pair.isRingOfIntegralElements.isPowerBounded_of_mem
            T s (Localization.Away s) hden T' s' (Localization.Away s') hden' hsub ≫
          eqToHom (rationalLocalization_eq_completedPlusPair T' s' hT').symm) =
      X.rationalLocalizationHom T' s' hT' := by
  let P := X.pairOfDefinition
  let hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hT
  let hden' := hasDenominatorPower_of_isOpen_span P T' s' (Localization.Away s') hT'
  let _ := locUniformSpace P T s (Localization.Away s) hden
  let _ := isUniformAddGroup_locUniformSpace P T s (Localization.Away s) hden
  let _ := isTopologicalRing_locUniformSpace P T s (Localization.Away s) hden
  let _ := isHuberRing_completion_locTopology P T s (Localization.Away s) hden
  let _ := locUniformSpace P T' s' (Localization.Away s') hden'
  let _ := isUniformAddGroup_locUniformSpace P T' s' (Localization.Away s') hden'
  let _ := isTopologicalRing_locUniformSpace P T' s' (Localization.Away s') hden'
  let _ := isHuberRing_completion_locTopology P T' s' (Localization.Away s') hden'
  refine Pair.Hom.ext (RingHom.ext fun x ↦ ?_)
  rw [comp_toRingHom, RingHom.comp_apply]
  refine (toRingHom_eqToHom_comp_eqToHom_apply
    (rationalLocalization_eq_completedPlusPair T s hT)
    (rationalLocalization_eq_completedPlusPair T' s' hT') _ _).trans ?_
  rw [pairHomOfRationalSubsetSubset_toRingHom]
  dsimp only [rationalLocalizationHom]
  rw [P.toRingHom_toCompletionLocHom, P.toRingHom_toCompletionLocHom]
  exact DFunLike.congr_fun (ringHomOfRationalSubsetSubset_comp_toCompletionLoc P X.pair.plus
    X.pair.isRingOfIntegralElements.isPowerBounded_of_mem
    T s (Localization.Away s) hden T' s' (Localization.Away s') hden' hsub) x

/-- **Wedhorn Lemma 8.1 and Proposition 8.2 in `CAff`**: the canonical morphism
`X.rationalLocalizationHom T s hT` satisfies `IsRationalLocalization`. -/
theorem isRationalLocalization_rationalLocalizationHom (X : CAff.{u}) (T : Finset X.ring)
    (s : X.ring) (hT : IsOpen (Ideal.span (T : Set X.ring) : Set X.ring)) :
    IsRationalLocalization (X.rationalLocalizationHom T s hT) T s := by
  let P := X.pairOfDefinition
  let hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hT
  let _ := locUniformSpace P T s (Localization.Away s) hden
  have _ := isUniformAddGroup_locUniformSpace P T s (Localization.Away s) hden
  have _ := isTopologicalRing_locUniformSpace P T s (Localization.Away s) hden
  have _ := isHuberRing_completion_locTopology P T s (Localization.Away s) hden
  have hplus : (X.rationalLocalization T s hT).pair.plus =
      completedPlusSubring P X.pair.plus T s (Localization.Away s) hden := by
    dsimp only [rationalLocalization]
    exact P.rationalLocalizationPair_plus X.pair X.ringOfDefinition_le_plus T s
      (Localization.Away s) hden
  have hhom : (X.rationalLocalizationHom T s hT).toRingHom =
      toCompletionLoc P T s (Localization.Away s) hden := by
    dsimp only [rationalLocalizationHom]
    exact P.toRingHom_toCompletionLocHom X.pair X.ringOfDefinition_le_plus T s
      (Localization.Away s) hden
  refine ⟨hT, fun w ↦ ?_, fun {Z} ψ hψ ↦ ?_⟩
  · rw [Pair.Hom.spaComap_val, hhom]
    exact spaComapLoc_val P X.pair.plus T s (Localization.Away s) hden ⟨w.val, hplus ▸ w.property⟩ ▸
      spaComapLoc_mem_rationalSubset P X.pair.plus T s (Localization.Away s) hden
        ⟨w.val, hplus ▸ w.property⟩
  · have hfac : ∀ w ∈ ValuationSpectrum.spa Z.pair.plus,
        comap ψ.toRingHom w ∈ rationalSubset X.pair.plus T s := fun w hw ↦ by
      simpa only [Pair.Hom.spaComap_val] using hψ ⟨w, hw⟩
    obtain ⟨g, ⟨hg_cont, hg_comp⟩, hg_uniq⟩ :=
      existsUnique_continuous_ringHom_of_forall_comap_mem_rationalSubset P X.pair.plus T s
        (Localization.Away s) hden Z.pair.plus Z.pair.isRingOfIntegralElements
        ψ.continuous_toRingHom.continuousAt hfac
    have hg_plus : ∀ a ∈ completedPlusSubring P X.pair.plus T s (Localization.Away s) hden,
        g a ∈ Z.pair.plus := by
      intro a ha
      refine Z.pair.isRingOfIntegralElements.mem_of_forall_vle_one fun w hw ↦ ?_
      have hw' : comap g w ∈ ValuationSpectrum.spa
          (completedPlusSubring P X.pair.plus T s (Localization.Away s) hden) :=
        comap_mem_spa_completedPlusSubring P X.pair.plus T s (Localization.Away s) hden g hg_cont
          ((mem_spa_iff _ _).mp hw).1 (by rw [hg_comp]; exact hfac w hw)
      have hw_le := ((mem_spa_iff _ _).mp hw').2 a ha
      rwa [comap_vle, map_one] at hw_le
    refine ⟨⟨g, hg_cont, fun a ha ↦ hg_plus a (hplus ▸ ha)⟩,
      Pair.Hom.ext (by rw [comp_toRingHom, hhom]; exact hg_comp),
      fun χ hχ ↦ Pair.Hom.ext ?_⟩
    refine hg_uniq χ.toRingHom ⟨χ.continuous_toRingHom, ?_⟩
    have hχ' := congrArg Pair.Hom.toRingHom hχ
    rwa [comp_toRingHom, hhom] at hχ'

namespace IsRationalLocalization

/-- Any two rational localizations of `X` for the same `(T, s)` are canonically isomorphic. -/
noncomputable def iso {X Y₁ Y₂ : CAff.{u}} {φ₁ : X ⟶ Y₁} {φ₂ : X ⟶ Y₂}
    {T : Finset X.ring} {s : X.ring}
    (h₁ : IsRationalLocalization φ₁ T s) (h₂ : IsRationalLocalization φ₂ T s) :
    Y₁ ≅ Y₂ where
  hom := (h₁.existsUnique_factorization φ₂ h₂.mapsTo_spaComap).choose
  inv := (h₂.existsUnique_factorization φ₁ h₁.mapsTo_spaComap).choose
  hom_inv_id := (h₁.existsUnique_factorization φ₁ h₁.mapsTo_spaComap).unique (by
    rw [← Category.assoc, (h₁.existsUnique_factorization φ₂ h₂.mapsTo_spaComap).choose_spec.1,
      (h₂.existsUnique_factorization φ₁ h₁.mapsTo_spaComap).choose_spec.1]) (Category.comp_id φ₁)
  inv_hom_id := (h₂.existsUnique_factorization φ₂ h₂.mapsTo_spaComap).unique (by
    rw [← Category.assoc, (h₂.existsUnique_factorization φ₁ h₁.mapsTo_spaComap).choose_spec.1,
      (h₁.existsUnique_factorization φ₂ h₂.mapsTo_spaComap).choose_spec.1]) (Category.comp_id φ₂)

@[reassoc (attr := simp)]
theorem comp_iso_hom {X Y₁ Y₂ : CAff.{u}} {φ₁ : X ⟶ Y₁} {φ₂ : X ⟶ Y₂}
    {T : Finset X.ring} {s : X.ring}
    (h₁ : IsRationalLocalization φ₁ T s) (h₂ : IsRationalLocalization φ₂ T s) :
    φ₁ ≫ (h₁.iso h₂).hom = φ₂ :=
  (h₁.existsUnique_factorization φ₂ h₂.mapsTo_spaComap).choose_spec.1

@[reassoc (attr := simp)]
theorem comp_iso_inv {X Y₁ Y₂ : CAff.{u}} {φ₁ : X ⟶ Y₁} {φ₂ : X ⟶ Y₂}
    {T : Finset X.ring} {s : X.ring}
    (h₁ : IsRationalLocalization φ₁ T s) (h₂ : IsRationalLocalization φ₂ T s) :
    φ₂ ≫ (h₁.iso h₂).inv = φ₁ :=
  (h₂.existsUnique_factorization φ₁ h₁.mapsTo_spaComap).choose_spec.1

/-- Canonical isomorphism between `X.rationalLocalization T s hφ.isOpen_span` and any rational
localization `Y` of `X` for `(T, s)`. -/
noncomputable def isoCanonical {X Y : CAff.{u}} {φ : X ⟶ Y} {T : Finset X.ring} {s : X.ring}
    (hφ : IsRationalLocalization φ T s) :
    X.rationalLocalization T s hφ.isOpen_span ≅ Y :=
  (isRationalLocalization_rationalLocalizationHom X T s hφ.isOpen_span).iso hφ

@[reassoc (attr := simp)]
theorem rationalLocalizationHom_comp_isoCanonical_hom {X Y : CAff.{u}} {φ : X ⟶ Y}
    {T : Finset X.ring} {s : X.ring} (hφ : IsRationalLocalization φ T s) :
    X.rationalLocalizationHom T s hφ.isOpen_span ≫ hφ.isoCanonical.hom = φ :=
  comp_iso_hom _ hφ

private theorem isOpenEmbedding_and_range_spaComap {X Y : CAff.{u}} {φ : X ⟶ Y}
    {T : Finset X.ring} {s : X.ring} (hφ : IsRationalLocalization φ T s) :
    IsOpenEmbedding φ.spaComap ∧
      Set.range φ.spaComap = Subtype.val ⁻¹' rationalSubset X.pair.plus T s := by
  let P := X.pairOfDefinition
  let hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hφ.isOpen_span
  let _ := locUniformSpace P T s (Localization.Away s) hden
  have _ := isUniformAddGroup_locUniformSpace P T s (Localization.Away s) hden
  have _ := isTopologicalRing_locUniformSpace P T s (Localization.Away s) hden
  have _ := isHuberRing_completion_locTopology P T s (Localization.Away s) hden
  have hplus : (X.rationalLocalization T s hφ.isOpen_span).pair.plus =
      completedPlusSubring P X.pair.plus T s (Localization.Away s) hden := by
    dsimp only [rationalLocalization]
    exact P.rationalLocalizationPair_plus X.pair X.ringOfDefinition_le_plus T s
      (Localization.Away s) hden
  have hhom : (X.rationalLocalizationHom T s hφ.isOpen_span).toRingHom =
      toCompletionLoc P T s (Localization.Away s) hden := by
    dsimp only [rationalLocalizationHom]
    exact P.toRingHom_toCompletionLocHom X.pair X.ringOfDefinition_le_plus T s
      (Localization.Away s) hden
  let eSet : ↥(ValuationSpectrum.spa (X.rationalLocalization T s hφ.isOpen_span).pair.plus) ≃ₜ
      ↥(ValuationSpectrum.spa
        (completedPlusSubring P X.pair.plus T s (Localization.Away s) hden)) :=
    Homeomorph.setCongr (congrArg ValuationSpectrum.spa hplus)
  have hcomp : φ.spaComap =
      (X.rationalLocalizationHom T s hφ.isOpen_span).spaComap ∘ hφ.isoCanonical.hom.spaComap := by
    rw [← comp_spaComap, rationalLocalizationHom_comp_isoCanonical_hom]
  have hloc : (X.rationalLocalizationHom T s hφ.isOpen_span).spaComap =
      spaComapLoc P X.pair.plus T s (Localization.Away s) hden ∘ eSet :=
    funext fun w ↦ Subtype.ext <|
      (Pair.Hom.spaComap_val _ w).trans <|
        (congrArg (comap · w.val) hhom).trans <|
          (spaComapLoc_val P X.pair.plus T s (Localization.Away s) hden (eSet w)).symm
  let he := TopCat.homeoOfIso (spa.mapIso hφ.isoCanonical.op)
  have he_surj : Function.Surjective hφ.isoCanonical.hom.spaComap := he.surjective
  refine ⟨?_, ?_⟩
  · rw [hcomp, hloc]
    exact (isOpenEmbedding_spaComapLoc P X.pair.plus X.ringOfDefinition_le_plus T s
      (Localization.Away s) hden).comp (eSet.isOpenEmbedding.comp he.isOpenEmbedding)
  · rw [hcomp, hloc, Set.range_comp, he_surj.range_eq, Set.image_univ,
      Set.range_comp, eSet.surjective.range_eq, Set.image_univ,
      range_spaComapLoc P X.pair.plus X.ringOfDefinition_le_plus T s (Localization.Away s) hden]
    exact Set.ext fun _ ↦ mem_spaBasicOpen

/-- Any rational localization `φ : X ⟶ Y` for `(T, s)` induces an open embedding
`Spa(Y) → Spa(X)`. -/
theorem isOpenEmbedding_spaComap {X Y : CAff.{u}} {φ : X ⟶ Y} {T : Finset X.ring} {s : X.ring}
    (hφ : IsRationalLocalization φ T s) : IsOpenEmbedding φ.spaComap :=
  hφ.isOpenEmbedding_and_range_spaComap.1

/-- The image of `Spa(Y) → Spa(X)` for any rational localization `φ : X ⟶ Y` at `(T, s)` is the
rational subset `R(T/s)`. -/
theorem range_spaComap {X Y : CAff.{u}} {φ : X ⟶ Y} {T : Finset X.ring} {s : X.ring}
    (hφ : IsRationalLocalization φ T s) :
    Set.range φ.spaComap = Subtype.val ⁻¹' rationalSubset X.pair.plus T s :=
  hφ.isOpenEmbedding_and_range_spaComap.2

end IsRationalLocalization

/-- The identity morphism `𝟙 X` is a rational localization of `X` for `({1}, 1)`. -/
theorem isRationalLocalization_id_one (X : CAff.{u}) :
    IsRationalLocalization (𝟙 X) {1} 1 where
  isOpen_span := by simp
  mapsTo_spaComap w := by
    rw [id_spaComap, id_eq, rationalSubset_singleton_one]; exact w.property
  existsUnique_factorization {Z} ψ _ := ⟨ψ, Category.id_comp ψ, fun χ hχ ↦ by simpa using hχ⟩

/-- For an open numerator ideal `(T)`, the identity `𝟙 X` is a rational localization at `(T, 0)`
if and only if `X.ring` is trivial. -/
theorem isRationalLocalization_id_zero_iff (X : CAff.{u}) (T : Finset X.ring)
    (hT : IsOpen (Ideal.span (T : Set X.ring) : Set X.ring)) :
    IsRationalLocalization (𝟙 X) T 0 ↔ Subsingleton X.ring := by
  refine ⟨fun h ↦ (isEmpty_spa_iff X).mp ?_, fun hsub ↦
    ⟨hT, fun w ↦ ((isEmpty_spa_iff X).mpr hsub).elim w, fun {Z} ψ _ ↦
      ⟨ψ, Category.id_comp ψ, fun χ hχ ↦ by simpa using hχ⟩⟩⟩
  rw [spa_obj]
  refine ⟨fun w ↦ ?_⟩
  have hw := h.mapsTo_spaComap w
  rw [id_spaComap, id_eq] at hw
  exact ((mem_rationalSubset_iff X.pair.plus T 0 w.val).mp hw).2.2
    (w.val.toValuativeRel.vle_refl 0)

/-! ### Rational coverings, the rational coverage, and `ratTopology` -/

/-- A finite family of rational data `(T i, s i)` on `X : CAff` is a *rational covering* if every
`T i` spans an open ideal in `X.ring` and the rational subsets `R(T i / s i)` cover `Spa(X)`. -/
structure IsRationalCovering (X : CAff.{u}) {ι : Type*} [Finite ι]
    (T : ι → Finset X.ring) (s : ι → X.ring) : Prop where
  /-- Each numerator set generates an open ideal in `X.ring`. -/
  isOpen_span : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)
  /-- The rational subsets `R(T i / s i)` cover `Spa(X)`. -/
  iUnion_eq_univ :
    (⋃ i, Subtype.val ⁻¹' rationalSubset X.pair.plus (T i) (s i) :
      Set ↥(ValuationSpectrum.spa X.pair.plus)) = Set.univ

/-- An empty family is a rational covering of `X` if and only if `X.ring` is trivial. -/
theorem isRationalCovering_empty_iff (X : CAff.{u}) {ι : Type*} [IsEmpty ι]
    (T : ι → Finset X.ring) (s : ι → X.ring) :
    IsRationalCovering X T s ↔ Subsingleton X.ring :=
  ⟨fun h ↦ (isEmpty_spa_iff X).mp ⟨fun w ↦ by
      have hw : w ∈ (Set.univ : Set ↥(ValuationSpectrum.spa X.pair.plus)) := Set.mem_univ w
      rwa [← h.iUnion_eq_univ, Set.iUnion_of_empty] at hw⟩,
    fun hsub ↦ ⟨fun i ↦ IsEmpty.elim ‹_› i,
      Set.eq_univ_of_forall fun w ↦ ((isEmpty_spa_iff X).mpr hsub).elim w⟩⟩

open scoped Classical in
/-- Along an adic morphism `ψ : X ⟶ Y` in `CAff`, a rational covering `(T i, s i)` of `X` pulls
back directly to a rational covering `(ψ '' T i, ψ (s i))` of `Y`. Without `[IsAdicHom ψ.toRingHom]`
the mapped ideal need not be open in `Y.ring`; general base change in `rationalCoverage` instead
refines the open preimages by rational subsets of `Spa(Y)`. -/
theorem IsRationalCovering.pullback {X Y : CAff.{u}} (ψ : X ⟶ Y) [IsAdicHom ψ.toRingHom]
    {ι : Type*} [Finite ι] {T : ι → Finset X.ring} {s : ι → X.ring}
    (hcov : IsRationalCovering X T s) :
    IsRationalCovering Y (fun i ↦ (T i).image ψ.toRingHom) (fun i ↦ ψ.toRingHom (s i)) where
  isOpen_span i := by
    rw [Finset.coe_image, ← Ideal.map_span]
    exact IsAdicHom.isOpen_map ‹_› (hcov.isOpen_span i)
  iUnion_eq_univ := by
    simp only [← Pair.Hom.spaComap_preimage_rationalSubset]
    rw [← Set.preimage_iUnion, hcov.iUnion_eq_univ, Set.preimage_univ]

/-- The presieve on `op X` in `CAff.{u}ᵒᵖ` formed by the canonical rational localizations
`op (X.rationalLocalization (T i) (s i) (hT i)) ⟶ op X`. -/
def rationalCoverPresieve (X : CAff.{u}) {ι : Type u} (T : ι → Finset X.ring)
    (s : ι → X.ring) (hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)) :
    Presieve (op X) :=
  Presieve.ofArrows (fun i ↦ op (X.rationalLocalization (T i) (s i) (hT i)))
    (fun i ↦ (X.rationalLocalizationHom (T i) (s i) (hT i)).op)

/-- Defining equation of `CAff.rationalCoverPresieve`. -/
theorem rationalCoverPresieve_eq_ofArrows (X : CAff.{u}) {ι : Type u} (T : ι → Finset X.ring)
    (s : ι → X.ring) (hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)) :
    X.rationalCoverPresieve T s hT =
      Presieve.ofArrows (fun i ↦ op (X.rationalLocalization (T i) (s i) (hT i)))
        (fun i ↦ (X.rationalLocalizationHom (T i) (s i) (hT i)).op) := by
  rfl

/-- Each canonical rational localization morphism belongs to `X.rationalCoverPresieve T s hT`. -/
theorem rationalCoverPresieve_mk {X : CAff.{u}} {ι : Type u} {T : ι → Finset X.ring}
    {s : ι → X.ring} {hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)} (i : ι) :
    X.rationalCoverPresieve T s hT (X.rationalLocalizationHom (T i) (s i) (hT i)).op := by
  exact Presieve.ofArrows.mk i

/-- Membership characterization for `X.rationalCoverPresieve T s hT`. -/
theorem mem_rationalCoverPresieve_iff {X : CAff.{u}} {ι : Type u} {T : ι → Finset X.ring}
    {s : ι → X.ring} {hT : ∀ i, IsOpen (Ideal.span (T i : Set X.ring) : Set X.ring)}
    {Z : CAff.{u}ᵒᵖ} {g : Z ⟶ op X} :
    X.rationalCoverPresieve T s hT g ↔
      ∃ (i : ι) (h : op (X.rationalLocalization (T i) (s i) (hT i)) = Z),
        g = eqToHom h.symm ≫ (X.rationalLocalizationHom (T i) (s i) (hT i)).op := by
  rw [rationalCoverPresieve_eq_ofArrows]
  refine ⟨fun hg ↦ Presieve.ofArrows_surj _ _ hg, ?_⟩
  rintro ⟨i, rfl, rfl⟩
  simpa using Presieve.ofArrows.mk i

/-- **The rational coverage on `CAffᵒᵖ`.** Covering presieves of `op X` are the presieves
`X.rationalCoverPresieve T s` attached to finite rational coverings `(T, s)` of `X`. Pullback
stability along an arbitrary morphism `f : op Y ⟶ op X` (corresponding to `ψ : X ⟶ Y`, not
necessarily adic) covers each open preimage `ψ.spaComap⁻¹(R(T i / s i))` by rational subsets of
`Spa(Y)`, extracts a finite subcover by quasi-compactness of `Spa(Y)`, and lifts each piece via
the universal property of rational localization. -/
def rationalCoverage : Coverage (CAff.{u}ᵒᵖ) where
  coverings U :=
    {R | ∃ (ι : Type u) (_ : Finite ι) (T : ι → Finset (unop U).ring)
      (s : ι → (unop U).ring) (hcov : IsRationalCovering (unop U) T s),
      R = (unop U).rationalCoverPresieve T s hcov.isOpen_span}
  pullback := by
    rintro U V f R ⟨ι, _, T, s, hcov, rfl⟩
    let X₀ := unop U; let Y₀ := unop V; let ψ : X₀ ⟶ Y₀ := f.unop
    obtain ⟨𝒲, h𝒲_rat, h𝒲_fin, h𝒲_sub, h𝒲_cov⟩ :=
      exists_finite_spaRationalFamily_refinement (univ_mem_spaRationalFamily Y₀.pair.plus)
        (fun i ↦ ψ.spaComap ⁻¹'
          (Subtype.val ⁻¹' rationalSubset X₀.pair.plus (T i) (s i)))
        (fun i ↦ (isOpen_val_preimage_rationalSubset X₀.pair.plus (T i) (s i)).preimage
          ψ.continuous_spaComap)
        (fun w _ ↦ by
          obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov.iUnion_eq_univ ▸ Set.mem_univ (ψ.spaComap w))
          exact Set.mem_iUnion.mpr ⟨i, hi⟩)
    have : Finite ↥𝒲 := h𝒲_fin.to_subtype
    choose idx hsub using fun k : ↥𝒲 ↦ h𝒲_sub k.val k.property
    choose T' s' hT' hW_eq using fun k : ↥𝒲 ↦ mem_spaRationalFamily_iff.mp (h𝒲_rat k.property)
    have hcovY : IsRationalCovering Y₀ T' s' :=
      { isOpen_span := hT'
        iUnion_eq_univ := Set.eq_univ_of_forall fun w ↦ by
          obtain ⟨W, hW, hwW⟩ := Set.mem_sUnion.mp (h𝒲_cov (Set.mem_univ w))
          exact Set.mem_iUnion.mpr ⟨⟨W, hW⟩, hW_eq ⟨W, hW⟩ ▸ hwW⟩ }
    refine ⟨Y₀.rationalCoverPresieve T' s' hcovY.isOpen_span,
      ⟨↥𝒲, inferInstance, T', s', hcovY, rfl⟩, fun Z g hg ↦ ?_⟩
    obtain ⟨k, rfl, rfl⟩ := mem_rationalCoverPresieve_iff.mp hg
    let φX := X₀.rationalLocalizationHom (T (idx k)) (s (idx k)) (hcov.isOpen_span (idx k))
    let φY := Y₀.rationalLocalizationHom (T' k) (s' k) (hcovY.isOpen_span k)
    obtain ⟨χ, hχ, -⟩ := (isRationalLocalization_rationalLocalizationHom X₀ (T (idx k))
      (s (idx k)) (hcov.isOpen_span (idx k))).existsUnique_factorization (ψ ≫ φY) fun u ↦ by
      rw [comp_spaComap]
      exact hsub k (hW_eq k ▸
        ((isRationalLocalization_rationalLocalizationHom Y₀ _ _
          (hcovY.isOpen_span k)).mapsTo_spaComap u))
    exact ⟨_, χ.op, φX.op, rationalCoverPresieve_mk (idx k), by
      rw [eqToHom_refl, Category.id_comp, ← op_comp, hχ, op_comp]; rfl⟩

/-- Membership in `CAff.rationalCoverage (op X)`: a presieve belongs to the rational coverage on
`op X` if and only if it is `X.rationalCoverPresieve T s` for a finite rational covering `(T, s)`.
-/
theorem mem_rationalCoverage_iff {X : CAff.{u}} {R : Presieve (op X)} :
    R ∈ rationalCoverage (op X) ↔
      ∃ (ι : Type u) (_ : Finite ι) (T : ι → Finset X.ring) (s : ι → X.ring)
        (hcov : IsRationalCovering X T s),
        R = X.rationalCoverPresieve T s hcov.isOpen_span :=
  Iff.rfl

/-- **The rational Grothendieck topology on `CAffᵒᵖ`**, generated by `CAff.rationalCoverage`. -/
def ratTopology : GrothendieckTopology (CAff.{u}ᵒᵖ) :=
  rationalCoverage.toGrothendieck

private theorem exists_mem_range_spaComap_of_saturate {U : CAff.{u}ᵒᵖ} {S : Sieve U}
    (hS : Coverage.Saturate rationalCoverage U S)
    (v : ValuationSpectrum.spa (unop U).pair.plus) :
    ∃ (Y : CAff.{u}) (φ : unop U ⟶ Y), S φ.op ∧ v ∈ Set.range φ.spaComap := by
  induction hS with
  | of U R hR =>
    obtain ⟨ι, _, T, s, hcov, rfl⟩ := hR
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov.iUnion_eq_univ ▸ Set.mem_univ v)
    let φ := (unop U).rationalLocalizationHom (T i) (s i) (hcov.isOpen_span i)
    refine ⟨_, φ, ⟨_, 𝟙 _, φ.op, rationalCoverPresieve_mk i, Category.id_comp _⟩, ?_⟩
    rwa [(isRationalLocalization_rationalLocalizationHom (unop U) _ _ _).range_spaComap]
  | top U => exact ⟨unop U, 𝟙 _, trivial, v, by rw [id_spaComap]; rfl⟩
  | transitive U R S _ _ ihR ihS =>
    obtain ⟨Y, φ, hφ, w, rfl⟩ := ihR v
    obtain ⟨Z, ψ, hψ, u, rfl⟩ := ihS hφ w
    exact ⟨Z, φ ≫ ψ, hψ, u, by rw [comp_spaComap]; rfl⟩

/-- The sieve generated by any rational covering of `X` is covering in `CAff.ratTopology (op X)`. -/
theorem generate_rationalCoverPresieve_mem_ratTopology {X : CAff.{u}} {ι : Type u} [Finite ι]
    {T : ι → Finset X.ring} {s : ι → X.ring} (hcov : IsRationalCovering X T s) :
    Sieve.generate (X.rationalCoverPresieve T s hcov.isOpen_span) ∈ ratTopology (op X) :=
  Coverage.Saturate.of (op X) _ ⟨ι, ‹_›, T, s, hcov, rfl⟩

/-- Every covering sieve in `CAff.ratTopology (op X)` is jointly surjective on `Spa(X)`. -/
theorem exists_mem_range_spaComap_of_mem_ratTopology {X : CAff.{u}} {S : Sieve (op X)}
    (hS : S ∈ ratTopology (op X)) (v : ValuationSpectrum.spa X.pair.plus) :
    ∃ (Y : CAff.{u}) (φ : X ⟶ Y), S φ.op ∧ v ∈ Set.range φ.spaComap :=
  exists_mem_range_spaComap_of_saturate hS v

/-- The empty sieve `⊥` covers `op X` in `CAff.ratTopology` if and only if `X.ring` is trivial. -/
theorem bot_mem_ratTopology_iff (X : CAff.{u}) :
    (⊥ : Sieve (op X)) ∈ ratTopology (op X) ↔ Subsingleton X.ring := by
  refine ⟨fun hbot ↦ (isEmpty_spa_iff X).mp ⟨fun v ↦ by
      obtain ⟨_, _, hmem, -⟩ := exists_mem_range_spaComap_of_mem_ratTopology hbot v; exact hmem⟩,
    fun hsub ↦ ?_⟩
  have hcov : IsRationalCovering X (fun _ : PEmpty.{u + 1} ↦ ∅) (fun _ ↦ 0) :=
    (isRationalCovering_empty_iff X _ _).mpr hsub
  have hgen : Sieve.generate (X.rationalCoverPresieve
      (fun _ : PEmpty.{u + 1} ↦ ∅) (fun _ ↦ 0) hcov.isOpen_span) = ⊥ := by
    rw [rationalCoverPresieve_eq_ofArrows, Presieve.ofArrows_of_isEmpty, Sieve.generate_bot]
  exact hgen ▸ Coverage.Saturate.of (op X) _ ⟨PEmpty.{u + 1}, inferInstance, _, _, hcov, rfl⟩

/-! ### Comparison with the adic-spectrum structure presheaf -/

/-- **Gluing of `CAff.globalSections` on a rational covering presieve vs.
`presentationLimitPresheaf`.**
For *any* complete Hausdorff Huber pair `Y : CAff.{u}` (Tate or not) and any family of open-span
rational data `(T i, s i)` on `Y`, `CAff.globalSections` satisfies `Presieve.IsSheafFor` on
`Y.rationalCoverPresieve T s hT` if and only if the underlying presheaf of sets of
`presentationLimitPresheaf Y.pairOfDefinition Y.pair.plus` satisfies `Presieve.IsSheafFor` on the
family of rational opens `spaBasicOpen Y.pair.plus (T i) (s i) ≤ ⊤`. -/
theorem isSheafFor_globalSections_rationalCoverPresieve_iff (Y : CAff.{u}) {ι : Type u}
    (T : ι → Finset Y.ring) (s : ι → Y.ring)
    (hT : ∀ i, IsOpen (Ideal.span (T i : Set Y.ring) : Set Y.ring)) :
    Presieve.IsSheafFor globalSections (Y.rationalCoverPresieve T s hT) ↔
      (Presieve.ofArrows (fun i ↦ spaBasicOpen Y.pair.plus (T i) (s i))
        fun i ↦ homOfLE le_top).IsSheafFor
          (presentationLimitPresheaf Y.pairOfDefinition Y.pair.plus ⋙
            TopCommRingCat.isCompleteSeparated.ι ⋙ forget _root_.TopCommRingCat) := by
  let P := Y.pairOfDefinition
  have hAplus : ∀ ⦃a⦄, a ∈ Y.pair.plus → IsPowerBounded a :=
    Y.pair.isRingOfIntegralElements.isPowerBounded_of_mem
  let U (i : ι) : Opens ↥(ValuationSpectrum.spa Y.pair.plus) :=
    spaBasicOpen Y.pair.plus (T i) (s i)
  let p (i : ι) : Presentation P :=
    ⟨T i, s i, hasDenominatorPower_of_isOpen_span P (T i) (s i) (Localization.Away (s i)) (hT i)⟩
  -- Equivalence `eTop : Y.ring ≃ presentationLimit Y.pair.plus ⊤` via
  -- `presentationLimitTopIso.symm`.
  let eTop : Y.ring ≃ presentationLimit (P := P) Y.pair.plus ⊤ :=
    ((forget _root_.TopCommRingCat).mapIso
      (eqToIso (CompleteSeparatedTopCommRingCat.of_obj Y.ring).symm) ≪≫
      (TopCommRingCat.isCompleteSeparated.ι ⋙ forget _root_.TopCommRingCat).mapIso
        (presentationLimitTopIso (P := P) Y.pair.plus hAplus).symm).toEquiv
  -- Equivalence `ePiece i : presentationLimit (U i) ≃ (Y.rationalLocalization ...).ring`.
  let ePiece (i : ι) :
      presentationLimit (P := P) Y.pair.plus (U i) ≃
        (Y.rationalLocalization (T i) (s i) (hT i)).ring :=
    Equiv.ofBijective _ (bijective_presentationLimitRationalIso_hom (P := P) Y.pair.plus
      hAplus (p i) (hT i))
  have hePiece_top (i : ι) (b : Y.ring) :
      ePiece i ((presentationLimitMap (P := P) (le_top : U i ≤ ⊤)).hom.val (eTop b)) =
        (Y.rationalLocalizationHom (T i) (s i) (hT i)).toRingHom b := by
    change (eqToHom (completionLocObj_obj P (p i).num (p i).den _
          (p i).hasDenominatorPower)).val
        ((presentationLimitRationalIso Y.pair.plus hAplus (p i) (hT i)).hom.hom.val
          ((presentationLimitMap (P := P) le_top).hom.val
            ((presentationLimitTopIso (P := P) Y.pair.plus hAplus).inv.hom.val
              ((eqToHom (CompleteSeparatedTopCommRingCat.of_obj Y.ring).symm).val b)))) = _
    rw [presentationLimitTopIso_inv, rationalIso_map_top_apply Y.pair.plus hAplus (p i) (hT i)]
    dsimp only [rationalLocalizationHom]
    rw [P.toRingHom_toCompletionLocHom]
    exact congrArg (toCompletionLoc P (p i).num (p i).den _ (p i).hasDenominatorPower)
      ((eqToIso (CompleteSeparatedTopCommRingCat.of_obj Y.ring).symm).hom_inv_id_apply b)
  -- Key bridge on overlaps: for any presentation `(T', s', hT')` of `U i ⊓ U j`, the comparison
  -- morphism `Yᵢ ⟶ W₀` built via `pairHomOfRationalSubsetSubset` agrees with `presentationLimitMap`
  -- under `ePiece` via `presentationLimitRationalIsoInCommRingCat_inv_comp_map_comp_hom`.
  have hoverlap_hom {i : ι} {T' : Finset Y.ring} {s' : Y.ring}
      (hT' : IsOpen (Ideal.span (T' : Set Y.ring) : Set Y.ring))
      (hsub : spaBasicOpen Y.pair.plus T' s' ≤ U i)
      (z : presentationLimit (P := P) Y.pair.plus (U i)) :
      let q : Presentation P :=
        ⟨T', s', hasDenominatorPower_of_isOpen_span P T' s' (Localization.Away s') hT'⟩
      let hden := hasDenominatorPower_of_isOpen_span P (T i) (s i) (Localization.Away (s i)) (hT i)
      letI := locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
      letI := isUniformAddGroup_locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
      letI := isTopologicalRing_locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
      letI := isHuberRing_completion_locTopology P (T i) (s i) (Localization.Away (s i)) hden
      letI := locUniformSpace P T' s' (Localization.Away s') q.hasDenominatorPower
      letI := isUniformAddGroup_locUniformSpace P T' s' (Localization.Away s') q.hasDenominatorPower
      letI := isTopologicalRing_locUniformSpace P T' s' (Localization.Away s') q.hasDenominatorPower
      letI := isHuberRing_completion_locTopology P T' s' (Localization.Away s')
        q.hasDenominatorPower
      let r : Y.rationalLocalization (T i) (s i) (hT i) ⟶ Y.rationalLocalization T' s' hT' :=
        eqToHom (rationalLocalization_eq_completedPlusPair (T i) (s i) (hT i)) ≫
          pairHomOfRationalSubsetSubset P Y.pair.plus
            (fun j _ ↦ Y.ringOfDefinition_le_plus j.property)
            hAplus (T i) (s i) _ hden T' s' _ q.hasDenominatorPower
            (spaBasicOpen_le_spaBasicOpen_iff.mp hsub) ≫
          eqToHom (rationalLocalization_eq_completedPlusPair T' s' hT').symm
      r.toRingHom (ePiece i z) =
        (eqToHom (completionLocObj_obj P q.num q.den _ q.hasDenominatorPower)).val
          (((presentationLimitRationalIso (P := P) Y.pair.plus hAplus q hT').hom).hom.val
            ((presentationLimitMap (P := P) hsub).hom.val z)) := by
    intro q hden r
    let _ := locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
    let _ := isUniformAddGroup_locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
    let _ := isTopologicalRing_locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
    let _ := isHuberRing_completion_locTopology P (T i) (s i) (Localization.Away (s i)) hden
    let _ := locUniformSpace P T' s' (Localization.Away s') q.hasDenominatorPower
    let _ := isUniformAddGroup_locUniformSpace P T' s' (Localization.Away s') q.hasDenominatorPower
    let _ := isTopologicalRing_locUniformSpace P T' s' (Localization.Away s') q.hasDenominatorPower
    let _ := isHuberRing_completion_locTopology P T' s' (Localization.Away s') q.hasDenominatorPower
    have hEq := presentationLimitRationalIsoInCommRingCat_inv_comp_map_comp_hom
      hAplus (p i) q (hT i) hT' hsub
    have h1 := congrArg
      (fun f ↦ (presentationLimitRationalIsoInCommRingCat hAplus (p i) (hT i)).hom ≫ f ≫
        q.completionLocObjCommRingCatIso.hom) hEq
    rw [← Category.assoc (presentationLimitRationalIsoInCommRingCat hAplus (p i) (hT i)).hom,
      Iso.hom_inv_id_assoc,
      map_homOfRationalSubsetSubset_comp_completionLocObjCommRingCatIso_hom hAplus
        (spaBasicOpen_le_spaBasicOpen_iff.mp hsub),
      presentationLimitRationalIsoInCommRingCat_hom,
      presentationLimitRationalIsoInCommRingCat_hom,
      ← Category.assoc ((presentationLimitPresheafInCommRingCat P Y.pair.plus).map
        (homOfLE hsub).op),
      presentationLimitPresheafInCommRingCat_map P Y.pair.plus (homOfLE hsub).op]
      at h1
    have hz := congrArg (fun f : _ ⟶ CommRingCat.of _ ↦ f.hom
      ((eqToHom (presentationLimitPresheafInCommRingCat_obj P Y.pair.plus
        (op (U i))).symm).hom z)) h1
    simp only [Category.assoc, CommRingCat.hom_comp, RingHom.comp_apply] at hz
    simp only [Functor.comp_map, ObjectProperty.ι_map,
      Presentation.completionLocObjCommRingCatIso_hom] at hz
    have hcancel1 : (eqToHom (presentationLimitPresheafInCommRingCat_obj P Y.pair.plus
          (op (U i)))).hom
        ((eqToHom (presentationLimitPresheafInCommRingCat_obj P Y.pair.plus
          (op (U i))).symm).hom z) = z :=
      (eqToIso (presentationLimitPresheafInCommRingCat_obj P Y.pair.plus
        (op (U i))).symm).hom_inv_id_apply z
    rw [hcancel1] at hz
    dsimp only [r]
    refine (toRingHom_eqToHom_comp_eqToHom_apply
      (rationalLocalization_eq_completedPlusPair (T i) (s i) (hT i))
      (rationalLocalization_eq_completedPlusPair T' s' hT') _ _).trans ?_
    rw [pairHomOfRationalSubsetSubset_toRingHom]
    exact hz.symm
  -- Shared presentation and comparison morphisms on pairwise overlaps `U i ⊓ U j`.
  have hmap_comp {U₁ U₂ U₃ : Opens ↥(ValuationSpectrum.spa Y.pair.plus)}
      (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃) (z : presentationLimit (P := P) Y.pair.plus U₃) :
      (presentationLimitMap (P := P) (h₁₂.trans h₂₃)).hom.val z =
        (presentationLimitMap (P := P) h₁₂).hom.val
          ((presentationLimitMap (P := P) h₂₃).hom.val z) := by
    rw [← presentationLimitMap_comp (P := P) h₂₃ h₁₂]; rfl
  choose T' s' hT' hUij using fun i j ↦ mem_spaRationalOpens_iff_exists_spaBasicOpen.mp <|
    inf_mem_spaRationalOpens (spaBasicOpen_mem_spaRationalOpens (hT i))
      (spaBasicOpen_mem_spaRationalOpens (hT j))
  -- Compatibility equivalence between `CAffᵒᵖ` arrows and `U i ⊓ U j` restrictions.
  have hcompat_iff (x : ∀ i, presentationLimit (P := P) Y.pair.plus (U i)) :
      Presieve.Arrows.Compatible globalSections
        (fun i ↦ (Y.rationalLocalizationHom (T i) (s i) (hT i)).op)
        (fun i ↦ ePiece i (x i)) ↔
      ∀ i j, (presentationLimitMap (P := P) (inf_le_left : U i ⊓ U j ≤ U i)).hom.val (x i) =
        (presentationLimitMap (P := P) (inf_le_right : U i ⊓ U j ≤ U j)).hom.val (x j) := by
    let r₁ (i j : ι) :
        Y.rationalLocalization (T i) (s i) (hT i) ⟶
          Y.rationalLocalization (T' i j) (s' i j) (hT' i j) :=
      let hden := hasDenominatorPower_of_isOpen_span P (T i) (s i) (Localization.Away (s i)) (hT i)
      let hden' := hasDenominatorPower_of_isOpen_span P (T' i j) (s' i j)
        (Localization.Away (s' i j)) (hT' i j)
      letI := locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
      letI := isUniformAddGroup_locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
      letI := isTopologicalRing_locUniformSpace P (T i) (s i) (Localization.Away (s i)) hden
      letI := isHuberRing_completion_locTopology P (T i) (s i) (Localization.Away (s i)) hden
      letI := locUniformSpace P (T' i j) (s' i j) (Localization.Away (s' i j)) hden'
      letI := isUniformAddGroup_locUniformSpace P (T' i j) (s' i j)
        (Localization.Away (s' i j)) hden'
      letI := isTopologicalRing_locUniformSpace P (T' i j) (s' i j)
        (Localization.Away (s' i j)) hden'
      letI := isHuberRing_completion_locTopology P (T' i j) (s' i j)
        (Localization.Away (s' i j)) hden'
      eqToHom (rationalLocalization_eq_completedPlusPair (T i) (s i) (hT i)) ≫
        pairHomOfRationalSubsetSubset P Y.pair.plus
          (fun k _ ↦ Y.ringOfDefinition_le_plus k.property)
          hAplus (T i) (s i) _ hden (T' i j) (s' i j) _ hden'
          (spaBasicOpen_le_spaBasicOpen_iff.mp ((hUij i j).symm.le.trans inf_le_left)) ≫
        eqToHom (rationalLocalization_eq_completedPlusPair (T' i j) (s' i j) (hT' i j)).symm
    let r₂ (i j : ι) :
        Y.rationalLocalization (T j) (s j) (hT j) ⟶
          Y.rationalLocalization (T' i j) (s' i j) (hT' i j) :=
      let hden := hasDenominatorPower_of_isOpen_span P (T j) (s j) (Localization.Away (s j)) (hT j)
      let hden' := hasDenominatorPower_of_isOpen_span P (T' i j) (s' i j)
        (Localization.Away (s' i j)) (hT' i j)
      letI := locUniformSpace P (T j) (s j) (Localization.Away (s j)) hden
      letI := isUniformAddGroup_locUniformSpace P (T j) (s j) (Localization.Away (s j)) hden
      letI := isTopologicalRing_locUniformSpace P (T j) (s j) (Localization.Away (s j)) hden
      letI := isHuberRing_completion_locTopology P (T j) (s j) (Localization.Away (s j)) hden
      letI := locUniformSpace P (T' i j) (s' i j) (Localization.Away (s' i j)) hden'
      letI := isUniformAddGroup_locUniformSpace P (T' i j) (s' i j)
        (Localization.Away (s' i j)) hden'
      letI := isTopologicalRing_locUniformSpace P (T' i j) (s' i j)
        (Localization.Away (s' i j)) hden'
      letI := isHuberRing_completion_locTopology P (T' i j) (s' i j)
        (Localization.Away (s' i j)) hden'
      eqToHom (rationalLocalization_eq_completedPlusPair (T j) (s j) (hT j)) ≫
        pairHomOfRationalSubsetSubset P Y.pair.plus
          (fun k _ ↦ Y.ringOfDefinition_le_plus k.property)
          hAplus (T j) (s j) _ hden (T' i j) (s' i j) _ hden'
          (spaBasicOpen_le_spaBasicOpen_iff.mp ((hUij i j).symm.le.trans inf_le_right)) ≫
        eqToHom (rationalLocalization_eq_completedPlusPair (T' i j) (s' i j) (hT' i j)).symm
    have hr₁ (i j : ι) :
        Y.rationalLocalizationHom (T i) (s i) (hT i) ≫ r₁ i j =
          Y.rationalLocalizationHom (T' i j) (s' i j) (hT' i j) :=
      rationalLocalizationHom_comp_pairHomOfRationalSubsetSubset (hT i) (hT' i j)
        (spaBasicOpen_le_spaBasicOpen_iff.mp ((hUij i j).symm.le.trans inf_le_left))
    have hr₂ (i j : ι) :
        Y.rationalLocalizationHom (T j) (s j) (hT j) ≫ r₂ i j =
          Y.rationalLocalizationHom (T' i j) (s' i j) (hT' i j) :=
      rationalLocalizationHom_comp_pairHomOfRationalSubsetSubset (hT j) (hT' i j)
        (spaBasicOpen_le_spaBasicOpen_iff.mp ((hUij i j).symm.le.trans inf_le_right))
    refine ⟨fun hcompat i j ↦ ?_, fun hcompat i j Z g₁ g₂ hg ↦ ?_⟩
    · let q : Presentation P :=
        ⟨T' i j, s' i j,
          hasDenominatorPower_of_isOpen_span P (T' i j) (s' i j) (Localization.Away (s' i j))
            (hT' i j)⟩
      have heval : (r₁ i j).toRingHom (ePiece i (x i)) = (r₂ i j).toRingHom (ePiece j (x j)) :=
        hcompat i j (op (Y.rationalLocalization (T' i j) (s' i j) (hT' i j)))
          (r₁ i j).op (r₂ i j).op (by rw [← op_comp, ← op_comp, hr₁ i j, hr₂ i j])
      rw [hoverlap_hom (hT' i j) ((hUij i j).symm.le.trans inf_le_left) (x i),
        hoverlap_hom (hT' i j) ((hUij i j).symm.le.trans inf_le_right) (x j)] at heval
      have hinj := (bijective_presentationLimitRationalIso_hom (P := P) Y.pair.plus
        hAplus q (hT' i j)).injective heval
      rw [hmap_comp (hUij i j).symm.le inf_le_left,
        hmap_comp (hUij i j).symm.le inf_le_right] at hinj
      have _ : IsIso (presentationLimitMap (P := P) (hUij i j).symm.le) :=
        ⟨presentationLimitMap (P := P) (hUij i j).le,
          by rw [presentationLimitMap_comp, presentationLimitMap_refl],
          by rw [presentationLimitMap_comp, presentationLimitMap_refl]⟩
      exact (ConcreteCategory.bijective_of_isIso
        (TopCommRingCat.isCompleteSeparated.ι.map
          (presentationLimitMap (P := P) (hUij i j).symm.le))).injective hinj
    · rcases Z with ⟨Z⟩
      let h₁ := g₁.unop; let h₂ := g₂.unop
      have hcomm : Y.rationalLocalizationHom (T i) (s i) (hT i) ≫ h₁ =
          Y.rationalLocalizationHom (T j) (s j) (hT j) ≫ h₂ := Quiver.Hom.op_inj hg
      have hφi := isRationalLocalization_rationalLocalizationHom Y (T i) (s i) (hT i)
      have hφj := isRationalLocalization_rationalLocalizationHom Y (T j) (s j) (hT j)
      obtain ⟨χ, hχ, -⟩ := (isRationalLocalization_rationalLocalizationHom Y (T' i j) (s' i j)
          (hT' i j)).existsUnique_factorization (Y.rationalLocalizationHom (T i) (s i) (hT i) ≫ h₁)
        fun w ↦ mem_spaBasicOpen.mp <| hUij i j ▸ ⟨by
          rw [comp_spaComap]; exact mem_spaBasicOpen.mpr (hφi.mapsTo_spaComap _),
        by rw [hcomm, comp_spaComap]; exact mem_spaBasicOpen.mpr (hφj.mapsTo_spaComap _)⟩
      have hh₁ : r₁ i j ≫ χ = h₁ := (hφi.existsUnique_factorization _ fun w ↦ by
        rw [comp_spaComap]; exact hφi.mapsTo_spaComap _).unique
          (by rw [← Category.assoc, hr₁ i j, hχ]) rfl
      have hh₂ : r₂ i j ≫ χ = h₂ := (hφj.existsUnique_factorization _ fun w ↦ by
        rw [comp_spaComap]; exact hφj.mapsTo_spaComap _).unique
          (by rw [← Category.assoc, hr₂ i j, hχ, hcomm]) rfl
      have heq : h₁.toRingHom (ePiece i (x i)) = h₂.toRingHom (ePiece j (x j)) := by
        rw [← hh₁, ← hh₂, comp_toRingHom (r₁ i j) χ, comp_toRingHom (r₂ i j) χ,
          RingHom.comp_apply, RingHom.comp_apply]
        refine congrArg χ.toRingHom ?_
        rw [hoverlap_hom (hT' i j) ((hUij i j).symm.le.trans inf_le_left) (x i),
          hoverlap_hom (hT' i j) ((hUij i j).symm.le.trans inf_le_right) (x j),
          hmap_comp (hUij i j).symm.le inf_le_left,
          hmap_comp (hUij i j).symm.le inf_le_right, hcompat i j]
      -- `globalSections` is `@[expose]`, so `globalSections.obj (op (op Z))` is definitionally
      -- `Z.ring` (`globalSections_obj`) and `globalSections.map g.op` is `g.unop.toRingHom`
      -- (`globalSections_map_apply`).
      exact heq
  -- Assemble the `IsSheafFor` equivalence using `eTop` and `ePiece`.
  rw [rationalCoverPresieve_eq_ofArrows, Presieve.isSheafFor_arrows_iff,
    isSheafFor_ofArrows_iff_existsUnique_presentationLimitMap P (fun i ↦ (le_top : U i ≤ ⊤))]
  refine ⟨fun hO x hx ↦ ?_, fun hLim y hy ↦ ?_⟩
  · obtain ⟨b, hb, hbu⟩ := hO (fun i ↦ ePiece i (x i)) ((hcompat_iff x).mpr hx)
    refine ⟨eTop b, fun i ↦ (ePiece i).injective ((hePiece_top i b).trans (hb i)), fun a ha ↦ ?_⟩
    rw [← eTop.apply_symm_apply a]
    refine congrArg eTop (hbu (eTop.symm a) fun i ↦ ?_)
    rw [globalSections_map_apply, ← hePiece_top, eTop.apply_symm_apply, ha i]
  · let y' : ∀ i, (Y.rationalLocalization (T i) (s i) (hT i)).ring := y
    have hy_eq : (fun i ↦ (ePiece i ((ePiece i).symm (y' i)) :
        globalSections.obj (op (op (Y.rationalLocalization (T i) (s i) (hT i)))))) = y :=
      funext fun i ↦ (ePiece i).apply_symm_apply (y' i)
    obtain ⟨a, ha, hau⟩ := hLim (fun i ↦ (ePiece i).symm (y' i))
      ((hcompat_iff (fun i ↦ (ePiece i).symm (y' i))).mp (hy_eq.symm ▸ hy))
    refine ⟨(eTop.symm a : Y.ring), fun i ↦ ?_, fun b hb ↦ ?_⟩
    · rw [globalSections_map_apply, ← hePiece_top, eTop.apply_symm_apply, ha i,
        Equiv.apply_symm_apply]
    · let b₀ : Y.ring := b
      have hb₀ : b₀ = eTop.symm a := by
        rw [← eTop.symm_apply_apply b₀]
        refine congrArg eTop.symm (hau (eTop b₀) fun i ↦ (ePiece i).injective ?_)
        rw [hePiece_top, Equiv.apply_symm_apply]
        exact (globalSections_map_apply _ b₀).symm.trans (hb i)
      -- `globalSections.obj (op (op Y))` is definitionally `Y.ring` (`globalSections_obj Y`).
      exact hb₀

/-- Topological sheafiness (`IsSheafyForEveryPresentation`) passes along any rational localization
`φ : X ⟶ Y` in `CAff`, without any Tate hypothesis. -/
theorem IsRationalLocalization.isSheafyForEveryPresentation {X Y : CAff.{u}} {φ : X ⟶ Y}
    {T₀ : Finset X.ring} {s₀ : X.ring} (hφ : IsRationalLocalization φ T₀ s₀)
    (hX : IsSheafyForEveryPresentation X.pair.plus) :
    IsSheafyForEveryPresentation Y.pair.plus := by
  let P := X.pairOfDefinition
  let hden := hasDenominatorPower_of_isOpen_span P T₀ s₀ (Localization.Away s₀) hφ.isOpen_span
  let _ := locUniformSpace P T₀ s₀ (Localization.Away s₀) hden
  let _ := isUniformAddGroup_locUniformSpace P T₀ s₀ (Localization.Away s₀) hden
  let _ := isTopologicalRing_locUniformSpace P T₀ s₀ (Localization.Away s₀) hden
  let _ := isHuberRing_completion_locTopology P T₀ s₀ (Localization.Away s₀) hden
  have hP₀ : IsSheafyForEveryPresentation
      (P.rationalLocalizationPair X.pair X.ringOfDefinition_le_plus T₀ s₀
        (Localization.Away s₀) hden).plus := by
    rw [isSheafyForEveryPresentation_iff_isRingOfIntegralElements_and_isSheaf
      (completionLocalization P T₀ s₀ (Localization.Away s₀) hden)]
    exact ⟨(P.rationalLocalizationPair X.pair X.ringOfDefinition_le_plus T₀ s₀
        (Localization.Away s₀) hden).isRingOfIntegralElements,
      isSheaf_presentationLimitPresheaf_rationalLocalizationPair P X.pair
        X.ringOfDefinition_le_plus T₀ s₀ (Localization.Away s₀) hden hφ.isOpen_span
        (hX.isSheaf P X.ringOfDefinition_le_plus)⟩
  let Y₀ := X.rationalLocalization T₀ s₀ hφ.isOpen_span
  have hY₀ : IsSheafyForEveryPresentation Y₀.pair.plus := hP₀
  let eIso := hφ.isoCanonical
  let eRing : Y₀.ring ≃+* Y.ring := (ringPresheaf.mapIso eIso.op.op).commRingCatIsoToRingEquiv
  have hplus : Y₀.pair.plus.map (eRing : Y₀.ring →+* Y.ring) = Y.pair.plus := by
    ext y
    exact ⟨fun ⟨x, hx, hxy⟩ ↦ hxy ▸ eIso.hom.map_mem_plus x hx,
      fun hy ↦ ⟨eIso.inv.toRingHom y, eIso.inv.map_mem_plus y hy, eRing.right_inv y⟩⟩
  exact (isSheafyForEveryPresentation_iff_of_ringEquiv eRing
    (by exact eIso.hom.continuous_toRingHom)
    (by exact eIso.inv.continuous_toRingHom) hplus).mp hY₀

/-- An object `X : CAff.{u}` is *rational-sheafy* if for every rational localization `φ : X ⟶ Y`
in `CAff.{u}` and every covering presieve `R ∈ rationalCoverage (op Y)`, the global-ring presheaf
`CAff.globalSections` satisfies `Presieve.IsSheafFor CAff.globalSections R`. -/
def IsRationalSheafy (X : CAff.{u}) : Prop :=
  ∀ ⦃Y : CAff.{u}⦄ (φ : X ⟶ Y) (T₀ : Finset X.ring) (s₀ : X.ring),
    IsRationalLocalization φ T₀ s₀ →
    ∀ R ∈ rationalCoverage (op Y), Presieve.IsSheafFor globalSections R

/-- Unfolding characterization of `CAff.IsRationalSheafy`. -/
theorem isRationalSheafy_iff (X : CAff.{u}) :
    X.IsRationalSheafy ↔
      ∀ ⦃Y : CAff.{u}⦄ (φ : X ⟶ Y) (T₀ : Finset X.ring) (s₀ : X.ring),
        IsRationalLocalization φ T₀ s₀ →
        ∀ R ∈ rationalCoverage (op Y), Presieve.IsSheafFor globalSections R :=
  Iff.rfl

/-- Elimination rule for `CAff.IsRationalSheafy` on a rational localization and rational covering
presieve. -/
theorem IsRationalSheafy.isSheafFor {X Y : CAff.{u}} (hX : X.IsRationalSheafy)
    {φ : X ⟶ Y} {T₀ : Finset X.ring} {s₀ : X.ring}
    (hφ : IsRationalLocalization φ T₀ s₀) {R : Presieve (op Y)}
    (hR : R ∈ rationalCoverage (op Y)) :
    Presieve.IsSheafFor globalSections R :=
  hX φ T₀ s₀ hφ R hR

/-- Every topologically sheafy complete Hausdorff Huber pair `X : CAff.{u}` is rational-sheafy
(without any Tate hypothesis). -/
theorem IsRationalSheafy.of_isSheafyForEveryPresentation {X : CAff.{u}}
    (hX : IsSheafyForEveryPresentation X.pair.plus) : X.IsRationalSheafy := by
  rintro Y φ T₀ s₀ hφ R ⟨ι, _, T, s, hcov, rfl⟩
  have hsheaf_set := Presheaf.isSheaf_comp_of_isSheaf _ _
    (TopCommRingCat.isCompleteSeparated.ι ⋙ forget _root_.TopCommRingCat)
    ((hφ.isSheafyForEveryPresentation hX).isSheaf Y.pairOfDefinition Y.ringOfDefinition_le_plus)
  rw [isSheafFor_globalSections_rationalCoverPresieve_iff, Presieve.isSheafFor_iff_generate]
  refine hsheaf_set.isSheafFor _ ?_
  let U : ι → Opens ↥(ValuationSpectrum.spa Y.pair.plus) :=
    fun i ↦ spaBasicOpen Y.pair.plus (T i) (s i)
  have hsup : (⨆ i, U i) = ⊤ := Opens.ext <| Set.eq_univ_iff_forall.mpr fun x ↦ by
    obtain ⟨i, hxi⟩ := Set.mem_iUnion.mp (hcov.iUnion_eq_univ ▸ Set.mem_univ x)
    exact Opens.mem_iSup.mpr ⟨i, mem_spaBasicOpen.mpr hxi⟩
  have key {W' : Opens ↥(ValuationSpectrum.spa Y.pair.plus)} (e : (⨆ i, U i) = W') :
      Sieve.generate (Presieve.ofArrows U fun i ↦ homOfLE ((le_iSup U i).trans_eq e)) ∈
        Opens.grothendieckTopology _ W' := by
    cases e
    convert TopCat.Presheaf.presieveOfCovering.mem_grothendieckTopology (X := TopCat.of _) U
    funext Z f
    exact propext ⟨fun ⟨k⟩ ↦ ⟨k, rfl⟩,
      fun ⟨k, hk⟩ ↦ by subst hk; rw [Subsingleton.elim f (homOfLE (le_iSup U k))]; exact .mk k⟩
  exact key hsup

/-- **Equivalence of site-theoretic and topological sheafiness for complete Tate Huber pairs.**
For a complete Hausdorff Tate Huber pair `X : CAff.{u}`, `X.IsRationalSheafy` holds if and only if
`X.pair.plus` satisfies `IsSheafyForEveryPresentation` (the structure presheaf of `Spa(X)` is a
sheaf of complete separated topological rings). -/
theorem isRationalSheafy_iff_isSheafyForEveryPresentation (X : CAff.{u}) [IsTateRing X.ring] :
    X.IsRationalSheafy ↔ IsSheafyForEveryPresentation X.pair.plus := by
  refine ⟨fun hrat ↦ ?_, IsRationalSheafy.of_isSheafyForEveryPresentation⟩
  rw [isSheafyForEveryPresentation_iff_isRingOfIntegralElements_and_isSheaf X.pairOfDefinition]
  refine ⟨X.pair.isRingOfIntegralElements, ?_⟩
  let P := X.pairOfDefinition
  have hAplus := X.pair.isRingOfIntegralElements.isPowerBounded_of_mem
  refine isSheaf_presentationLimitPresheaf_of_isSheafFor_finite_rationalOpens P hAplus
    fun {W} {κ} hfin {V} hW hV hcov ↦ ?_
  obtain ⟨T₀, s₀, hT₀, rfl⟩ := mem_spaRationalOpens_iff_exists_spaBasicOpen.mp hW
  let hden₀ := hasDenominatorPower_of_isOpen_span P T₀ s₀ (Localization.Away s₀) hT₀
  let _ := locUniformSpace P T₀ s₀ (Localization.Away s₀) hden₀
  have _ := isUniformAddGroup_locUniformSpace P T₀ s₀ (Localization.Away s₀) hden₀
  have _ := isTopologicalRing_locUniformSpace P T₀ s₀ (Localization.Away s₀) hden₀
  have _ := isHuberRing_completion_locTopology P T₀ s₀ (Localization.Away s₀) hden₀
  let Y := X.rationalLocalization T₀ s₀ hT₀
  have hVW (k : κ) : V k ≤ spaBasicOpen X.pair.plus T₀ s₀ := (le_iSup V k).trans_eq hcov
  -- Transport `IsSheafFor` along `j : Spa(Y) → Spa(X)` via Wedhorn Remark 8.4.
  rw [isSheafFor_ofArrows_iff_locOpensComap P X.pair.plus T₀ s₀ (Localization.Away s₀) hden₀
    hAplus hT₀ hW le_rfl hV hVW]
  let Q₀ := completionLocalization P T₀ s₀ (Localization.Away s₀) hden₀
  let Bplus := completedPlusSubring P X.pair.plus T₀ s₀ (Localization.Away s₀) hden₀
  have hY_plus : Y.pair.plus = Bplus :=
    P.rationalLocalizationPair_plus X.pair X.ringOfDefinition_le_plus T₀ s₀
      (Localization.Away s₀) hden₀
  choose T' s' hT' hU'_eq using fun k ↦ mem_spaRationalOpens_iff_exists_spaBasicOpen.mp <|
    locOpensComap_mem_spaRationalOpens P X.pair.plus T₀ s₀ (Localization.Away s₀) hden₀ (hV k)
  have htop_loc : locOpensComap P X.pair.plus T₀ s₀ (Localization.Away s₀) hden₀
      (spaBasicOpen X.pair.plus T₀ s₀) = ⊤ :=
    le_antisymm le_top fun w _ ↦ (mem_locOpensComap P X.pair.plus T₀ s₀ _ hden₀ _ w).mpr <|
      mem_spaBasicOpen.mpr (spaComapLoc_mem_rationalSubset P X.pair.plus T₀ s₀ _ hden₀ w)
  have hcovY : IsRationalCovering Y T' s' :=
    { isOpen_span := hT'
      iUnion_eq_univ := Set.eq_univ_of_forall fun w ↦ by
        let w' : ↥(ValuationSpectrum.spa Bplus) := ⟨w.val, hY_plus ▸ w.property⟩
        obtain ⟨k, hwk⟩ := Opens.mem_iSup.mp <| hcov ▸ mem_spaBasicOpen.mpr
          (spaComapLoc_mem_rationalSubset P X.pair.plus T₀ s₀ (Localization.Away s₀) hden₀ w')
        have hw' : w'.val ∈ rationalSubset Bplus (T' k) (s' k) :=
          mem_spaBasicOpen.mp <| hU'_eq k ▸
            (mem_locOpensComap P X.pair.plus T₀ s₀ (Localization.Away s₀) hden₀ (V k) w').mpr hwk
        exact Set.mem_iUnion.mpr ⟨k, show w.val ∈ rationalSubset Y.pair.plus (T' k) (s' k) from
          congrArg (rationalSubset · (T' k) (s' k)) hY_plus ▸ hw'⟩ }
  -- Apply `hrat` to the rational localization `X ⟶ Y` and the rational cover `(T', s')`.
  have hLim_Q₀ := (isSheafFor_presentationLimitPresheaf_comp_iff_of_pairOfDefinition
    Y.pairOfDefinition Q₀ Y.pair.plus
    (TopCommRingCat.isCompleteSeparated.ι ⋙ forget _root_.TopCommRingCat) _).mp <|
    (isSheafFor_globalSections_rationalCoverPresieve_iff Y T' s' hcovY.isOpen_span).mp <|
      hrat (X.rationalLocalizationHom T₀ s₀ hT₀) T₀ s₀
        (isRationalLocalization_rationalLocalizationHom X T₀ s₀ hT₀) _
        ⟨κ, hfin, T', s', hcovY, rfl⟩
  rw [hY_plus] at hLim_Q₀
  have hcongr {α : Type u} [TopologicalSpace α] (F : (Opens α)ᵒᵖ ⥤ Type u)
      {W₁ W₂ : Opens α} (hW' : W₁ = W₂) {U₁ U₂ : κ → Opens α} (hU' : U₁ = U₂)
      (h₁ : ∀ k, U₁ k ≤ W₁) (h₂ : ∀ k, U₂ k ≤ W₂) :
      (Presieve.ofArrows U₁ fun k ↦ homOfLE (h₁ k)).IsSheafFor F ↔
        (Presieve.ofArrows U₂ fun k ↦ homOfLE (h₂ k)).IsSheafFor F := by
    subst hW' hU'; rfl
  exact (hcongr _ htop_loc (funext hU'_eq) _ _).mpr hLim_Q₀

end TauCeti.CAff

