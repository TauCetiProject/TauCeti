module

public import TauCeti.AlgebraicGeometry.AdicSpace.ValuationSpectrum.Basic
public import TauCeti.RingTheory.Valuation.Coarsen

/-!
# Lifting vertical generizations along ring maps

A point `x` of `Spv A` is a *vertical generization* of `x₀` when `x ⤳ x₀` and both have the same
support. This file shows that vertical generizations lift along every ring map `φ : A →+* B`: if
`x₀` is the pullback of `y ∈ Spv B` and `x` is a vertical generization of `x₀`, then some
generization of `y` pulls back to `x`
(`TauCeti.ValuationSpectrum.exists_specializes_comap_eq`). No finiteness or integrality of `φ`
is needed.

The lift is a coarsening. Write `w` for a valuation representing `y`, with values in `Δ₀`. The
quotients `w(φ c) / w(φ d)` with `x(c) = x(d) ≠ 0` and `w(φ c) ≥ w(φ d)` form a multiplicatively
closed set of units of `Δ₀`; let `H` be the convex subgroup it generates. Coarsening `w` by `H`
gives a generization of `y` (`TauCeti.ValuationSpectrum.ofValuation_coarsenByUnits_specializes`),
and it pulls back to `x` (`TauCeti.ValuationSpectrum.comap_ofValuation_coarsenByUnits_eq`). The
key point is that an element of `H` is bounded by one of the generating quotients, and a bound by
such a quotient between values of elements of `A` is seen by `x`.

## Main results

* `TauCeti.ValuationSpectrum.ofValuation_coarsenByUnits_specializes`: a coarsening of a valuation
  is a generization of it.
* `TauCeti.ValuationSpectrum.comap_ofValuation_coarsenByUnits_eq`: a vertical generization of the
  pullback of `ofValuation w` is the pullback of a coarsening of `w`.
* `TauCeti.ValuationSpectrum.exists_specializes_comap_eq`: vertical generizations lift along ring
  maps.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Chapter 4, for vertical
  generizations as coarsenings by convex subgroups.
-/

public section

namespace TauCeti.ValuationSpectrum

open Valuation

variable {A B : Type*} [CommRing A] [CommRing B]
  {Δ₀ : Type*} [LinearOrderedCommGroupWithZero Δ₀]

/-- **A coarsening is a generization.** Coarsening a valuation `w` by a convex subgroup of the
units of its value monoid gives a point of `Spv B` that specializes to `ofValuation w`. -/
theorem ofValuation_coarsenByUnits_specializes (w : Valuation B Δ₀) (H : ConvexSubgroup Δ₀ˣ) :
    ofValuation (w.coarsenByUnits H) ⤳ ofValuation w := by
  refine specializes_of_forall_mem_basicOpen fun f s hfs ↦ ?_
  rw [mem_basicOpen_iff, vle_ofValuation, vle_ofValuation, map_zero, le_zero_iff] at hfs ⊢
  rw [coarsenByUnits_apply, coarsenByUnits_apply, map_eq_zero]
  exact ⟨coarsenMapOfValueGroup_monotone H hfs.1, hfs.2⟩

/-- The set of units generating the convex subgroup by which `w` is coarsened: the quotients
`w(φ c) / w(φ d) ≥ 1` with `x(c) = x(d) ≠ 0`. -/
private def liftSet (φ : A →+* B) (w : Valuation B Δ₀) (x : Spv A) : Set Δ₀ˣ :=
  {σ | 1 ≤ σ ∧ ∃ c d : A, x.valuation c = x.valuation d ∧ x.valuation d ≠ 0 ∧
    (σ : Δ₀) * w (φ d) = w (φ c)}

variable {φ : A →+* B} {w : Valuation B Δ₀} {x : Spv A}

/-- On a vertical generization `x` of the pullback of `w`, the supports agree: `x(a) = 0` iff
`w(φ a) = 0`. -/
private theorem valuation_eq_zero_iff_of_supp_eq
    (hsupp : x.supp = (comap φ (ofValuation w)).supp) (a : A) :
    x.valuation a = 0 ↔ w (φ a) = 0 := by
  rw [supp_comap, supp_ofValuation, supp_eq_valuation_supp] at hsupp
  simpa only [Ideal.mem_comap, Valuation.mem_supp_iff, eq_iff_iff] using congrArg (a ∈ ·) hsupp

/-- On a vertical generization `x` of the pullback of `w`, comparisons of `w` at images of
elements of `A` hold at `x`. -/
private theorem valuation_le_of_le (hx : x ⤳ comap φ (ofValuation w))
    (hsupp : x.supp = (comap φ (ofValuation w)).supp) {a b : A} (hab : w (φ a) ≤ w (φ b)) :
    x.valuation a ≤ x.valuation b := by
  rcases eq_or_ne (w (φ b)) 0 with hb | hb
  · rw [(valuation_eq_zero_iff_of_supp_eq hsupp a).mpr (le_zero_iff.mp (hb ▸ hab))]
    exact zero_le
  · rw [valuation_le_iff]
    refine vle_of_specializes hx (by rwa [comap_vle, vle_ofValuation]) ?_
    rwa [comap_vle, vle_ofValuation, map_zero, map_zero, le_zero_iff]

private theorem one_mem_liftSet : (1 : Δ₀ˣ) ∈ liftSet φ w x :=
  ⟨le_rfl, 1, 1, rfl, by simp, by simp⟩

private theorem mul_mem_liftSet {σ τ : Δ₀ˣ} (hσ : σ ∈ liftSet φ w x) (hτ : τ ∈ liftSet φ w x) :
    σ * τ ∈ liftSet φ w x := by
  obtain ⟨hσ1, c, d, hcd, hd, hσ⟩ := hσ
  obtain ⟨hτ1, c', d', hcd', hd', hτ⟩ := hτ
  refine ⟨one_le_mul hσ1 hτ1, c * c', d * d', by simp [hcd, hcd'], by simp [hd, hd'], ?_⟩
  rw [map_mul, map_mul, Units.val_mul, map_mul, map_mul, ← hσ, ← hτ, mul_mul_mul_comm]

/-- An element of the convex subgroup generated by `liftSet` that is a quotient of values of
images of elements of `A` is seen by `x`. -/
private theorem valuation_le_of_mem_closure (hx : x ⤳ comap φ (ofValuation w))
    (hsupp : x.supp = (comap φ (ofValuation w)).supp) {a b : A} (ha : w (φ a) ≠ 0)
    (hb : w (φ b) ≠ 0)
    (hmem : (Units.mk0 _ hb)⁻¹ * Units.mk0 _ ha ∈ ConvexSubgroup.closure (liftSet φ w x)) :
    x.valuation a ≤ x.valuation b := by
  rw [ConvexSubgroup.mem_closure_of_nonempty_of_mul_mem_of_one_le ⟨1, one_mem_liftSet⟩
    (fun _ hσ _ hτ ↦ mul_mem_liftSet hσ hτ) (fun _ hσ ↦ hσ.1)] at hmem
  obtain ⟨σ, ⟨-, c, d, hcd, hd, hσ⟩, -, hle⟩ := hmem
  -- `w(φ a) ≤ σ w(φ b)`, so `w(φ (a d)) ≤ w(φ (b c))`
  rw [inv_mul_le_iff_le_mul, ← Units.val_le_val, Units.val_mul, Units.val_mk0,
    Units.val_mk0] at hle
  have hwd : w (φ (a * d)) ≤ w (φ (b * c)) := by
    rw [map_mul, map_mul, map_mul, map_mul, ← hσ, ← mul_assoc]
    exact mul_le_mul_left hle _
  have hxd := valuation_le_of_le hx hsupp hwd
  rw [map_mul, map_mul, hcd] at hxd
  exact le_of_mul_le_mul_right hxd (zero_lt_iff.mpr hd)

/-- **Vertical generizations are pullbacks of coarsenings.** Let `x` be a vertical generization of
the pullback along `φ` of the point of `Spv B` defined by a valuation `w`: `x` specializes to it
and has the same support. Then `x` is the pullback of the coarsening of `w` by a convex subgroup
of the units of the value monoid of `w`. -/
theorem comap_ofValuation_coarsenByUnits_eq (hx : x ⤳ comap φ (ofValuation w))
    (hsupp : x.supp = (comap φ (ofValuation w)).supp) :
    ∃ H : ConvexSubgroup Δ₀ˣ, comap φ (ofValuation (w.coarsenByUnits H)) = x := by
  refine ⟨ConvexSubgroup.closure (liftSet φ w x), ext' fun a b ↦ ?_⟩
  rw [comap_vle, vle_ofValuation, coarsenByUnits_apply, coarsenByUnits_apply,
    ← valuation_le_iff]
  have hzero := valuation_eq_zero_iff_of_supp_eq hsupp
  rcases eq_or_ne (w (φ a)) 0 with ha | ha
  · rw [ha, (hzero a).mpr ha, map_zero]
    exact iff_of_true zero_le zero_le
  rcases eq_or_ne (w (φ b)) 0 with hb | hb
  · rw [hb, (hzero b).mpr hb, map_zero, le_zero_iff, le_zero_iff, map_eq_zero, hzero]
  rw [coarsenMapOfValueGroup_le_iff _ ha hb]
  refine ⟨fun h ↦ h.elim (fun h ↦ valuation_le_of_le hx hsupp h)
    (valuation_le_of_mem_closure hx hsupp ha hb), fun h ↦ ?_⟩
  refine (le_or_gt (w (φ a)) (w (φ b))).imp id fun hlt ↦ ConvexSubgroup.subset_closure _ ?_
  -- `w(φ b) < w(φ a)` forces `x(a) = x(b)`, so the quotient is a generator
  refine ⟨?_, a, b, le_antisymm h (valuation_le_of_le hx hsupp hlt.le), mt (hzero b).mp hb, ?_⟩
  · rw [le_inv_mul_iff_mul_le, mul_one, ← Units.val_le_val, Units.val_mk0, Units.val_mk0]
    exact hlt.le
  · simp [mul_right_comm _ (w (φ a)), hb]

/-- **Vertical generizations lift along ring maps.** If `x ∈ Spv A` specializes to the pullback
of `y ∈ Spv B` along `φ` and has the same support, then some generization of `y` pulls back to
`x`. -/
theorem exists_specializes_comap_eq {y : Spv B} (hx : x ⤳ comap φ y)
    (hsupp : x.supp = (comap φ y).supp) : ∃ y' : Spv B, y' ⤳ y ∧ comap φ y' = x := by
  rw [← ofValuation_valuation y] at hx hsupp ⊢
  obtain ⟨H, hH⟩ := comap_ofValuation_coarsenByUnits_eq hx hsupp
  exact ⟨_, ofValuation_coarsenByUnits_specializes _ H, hH⟩

end TauCeti.ValuationSpectrum
