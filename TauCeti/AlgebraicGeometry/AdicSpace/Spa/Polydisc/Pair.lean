/-! ### Coordinate variables and the polydisc plus subring -/

section PlusSubring

/-- **The `i`-th coordinate variable `Tᵢ` in the completed restricted power-series algebra
`A⟨T₁, …, Tₙ⟩`.** -/
noncomputable abbrev Pair.polydiscVar (n : ℕ) (A : Type*) [CommRing A] [TopologicalSpace A]
    [NonarchimedeanRing A] (i : Fin n) : restrictedMvPowerSeriesCompletion n A :=
  ((weightedX (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight i :
    weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight) :
      restrictedMvPowerSeriesCompletion n A)

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]

/-- **The plus subring `A⁺⟨T₁, …, Tₙ⟩` inside `A⟨T₁, …, Tₙ⟩`**: the topological closure of the
subring generated by the image of `A⁺` and the coordinate variables `T₁, …, Tₙ`. -/
noncomputable def Pair.polydiscPlus (S : Pair A) (n : ℕ) :
    Subring (restrictedMvPowerSeriesCompletion n A) :=
  (Subring.closure (algebraMap A (restrictedMvPowerSeriesCompletion n A) '' S.plus ∪
    Set.range (Pair.polydiscVar n A))).topologicalClosure

/-- Unfolding equation for `TauCeti.Huber.Pair.polydiscPlus`. -/
theorem Pair.polydiscPlus_def (S : Pair A) (n : ℕ) :
    S.polydiscPlus n =
      (Subring.closure (algebraMap A (restrictedMvPowerSeriesCompletion n A) '' S.plus ∪
        Set.range (Pair.polydiscVar n A))).topologicalClosure :=
  (rfl)

/-- Every constant from `A⁺` lies in `S.polydiscPlus n`. -/
theorem Pair.algebraMap_mem_polydiscPlus (S : Pair A) (n : ℕ) {a : A} (ha : a ∈ S.plus) :
    algebraMap A (restrictedMvPowerSeriesCompletion n A) a ∈ S.polydiscPlus n :=
  Subring.le_topologicalClosure _
    (Subring.subset_closure (Or.inl ⟨a, ha, rfl⟩))

/-- Every coordinate variable `Tᵢ` lies in `S.polydiscPlus n`. -/
theorem Pair.polydiscVar_mem_polydiscPlus (S : Pair A) (n : ℕ) (i : Fin n) :
    Pair.polydiscVar n A i ∈ S.polydiscPlus n :=
  Subring.le_topologicalClosure _
    (Subring.subset_closure (Or.inr ⟨i, rfl⟩))

/-- `S.polydiscPlus n` is the smallest closed subring of `A⟨T₁, …, Tₙ⟩` containing the constants
from `A⁺` and the coordinate variables `T₁, …, Tₙ`. -/
theorem Pair.polydiscPlus_le (S : Pair A) {n : ℕ}
    {Q : Subring (restrictedMvPowerSeriesCompletion n A)}
    (hQ : IsClosed (Q : Set (restrictedMvPowerSeriesCompletion n A)))
    (hC : ∀ a ∈ S.plus, algebraMap A (restrictedMvPowerSeriesCompletion n A) a ∈ Q)
    (hX : ∀ i, Pair.polydiscVar n A i ∈ Q) :
    S.polydiscPlus n ≤ Q := by
  rw [Pair.polydiscPlus_def]
  refine Subring.topologicalClosure_minimal _ (Subring.closure_le.mpr ?_) hQ
  rintro _ (⟨a, ha, rfl⟩ | ⟨i, rfl⟩)
  · exact hC a ha
  · exact hX i

/-- A continuous ring homomorphism out of `A⟨T₁, …, Tₙ⟩` carrying `A⁺` and the coordinate variables
into an open (hence closed) subring `R` carries all of `S.polydiscPlus n` into `R`. -/
theorem Pair.polydiscPlus_le_comap_of_isOpen {C : Type*} [CommRing C] [TopologicalSpace C]
    [IsTopologicalAddGroup C] (S : Pair A) {n : ℕ} {R : Subring C} (hR : IsOpen (R : Set C))
    {ψ : restrictedMvPowerSeriesCompletion n A →+* C} (hψ : Continuous ψ)
    (hC : ∀ a ∈ S.plus, ψ (algebraMap A (restrictedMvPowerSeriesCompletion n A) a) ∈ R)
    (hX : ∀ i, ψ (Pair.polydiscVar n A i) ∈ R) :
    S.polydiscPlus n ≤ R.comap ψ :=
  S.polydiscPlus_le ((R.toAddSubgroup.isClosed_of_isOpen hR).preimage hψ) hC hX

/-- A continuous ring homomorphism out of `A⟨T₁, …, Tₙ⟩` carrying `A⁺` and the coordinate variables
into `U.plus` carries all of `S.polydiscPlus n` into `U.plus`. -/
theorem Pair.polydiscPlus_le_comap {C : Type*} [CommRing C] [TopologicalSpace C]
    [IsTopologicalRing C] [IsHuberRing C] (S : Pair A) (U : Pair C) {n : ℕ}
    {ψ : restrictedMvPowerSeriesCompletion n A →+* C} (hψ : Continuous ψ)
    (hC : ∀ a ∈ S.plus, ψ (algebraMap A (restrictedMvPowerSeriesCompletion n A) a) ∈ U.plus)
    (hX : ∀ i, ψ (Pair.polydiscVar n A i) ∈ U.plus) :
    S.polydiscPlus n ≤ U.plus.comap ψ :=
  S.polydiscPlus_le_comap_of_isOpen U.isRingOfIntegralElements.isOpen hψ hC hX

end PlusSubring

/-! ### Integral closedness and the Huber pair `S.polydisc n` -/

section CompleteBase

variable {A : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]
  [IsHuberRing A]

omit [IsUniformAddGroup A] in
/-- Every polynomial with coefficients in `S.plus` maps into the unclosed generator subring of
`S.polydiscPlus n` under completion. -/
private theorem coe_weightedPolynomialHom_mem_closure (S : Pair A) (n : ℕ)
    (p : MvPolynomial (Fin n) A)
    (hp : ∀ ν, p.coeff ν ∈ weightMul (fun _ : Fin n ↦ ({1} : Set A)) ν S.plus.toAddSubgroup) :
    ((weightedPolynomialHom (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight p :
      weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight) :
      restrictedMvPowerSeriesCompletion n A) ∈
      Subring.closure
        (algebraMap A (restrictedMvPowerSeriesCompletion n A) '' S.plus ∪
          Set.range (Pair.polydiscVar n A)) := by
  let Q : Subring
      (weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight) :=
    (Subring.closure (algebraMap A (restrictedMvPowerSeriesCompletion n A) '' S.plus ∪
      Set.range (Pair.polydiscVar n A))).comap Completion.coeRingHom
  have hQ_C : ∀ a ∈ S.plus,
      weightedC (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight a ∈ Q := fun a ha ↦ by
    rw [Subring.mem_comap]
    exact algebraMap_completion_weightedRestrictedSubring_apply n A
      isWeightFamily_one_weight a ▸ Subring.subset_closure (Or.inl ⟨a, ha, rfl⟩)
  have hQ_X : ∀ i, ∀ t ∈ ({1} : Set A),
      weightedC (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight t *
        weightedX (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight i ∈ Q := by
    intro i t ht
    obtain rfl : t = 1 := Set.mem_singleton_iff.mp ht
    rw [map_one, one_mul, Subring.mem_comap]
    exact Subring.subset_closure (Or.inr ⟨i, rfl⟩)
  have hmemQ : weightedPolynomialHom (fun _ : Fin n ↦ ({1} : Set A))
      isWeightFamily_one_weight p ∈ Q := by
    rw [p.as_sum, map_sum]
    exact sum_mem fun ν _ ↦ weightedPolynomialHom_monomial_mem_of_mem_weightMul
      isWeightFamily_one_weight hQ_C
      (weightedPolynomialHom_monomial_mem isWeightFamily_one_weight hQ_X) (hp ν)
  exact hmemQ

/-- **Under `restrictedMvPowerSeriesCompletionEquiv`, `S.polydiscPlus n` maps onto the
coefficientwise subring `A⁺⟨T₁, …, Tₙ⟩`.** -/
theorem Pair.map_polydiscPlus_equiv (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    (S.polydiscPlus n).map
        (restrictedMvPowerSeriesCompletionEquiv n A :
          restrictedMvPowerSeriesCompletion n A →+*
            weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight) =
      weightedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight S.plus := by
  let e := restrictedMvPowerSeriesCompletionEquiv n A
  have he : Continuous ⇑e :=
    (uniformContinuous_restrictedMvPowerSeriesCompletionEquiv (k := n) (A := A)).continuous
  refine le_antisymm ?_ ?_
  · rw [Subring.map_le_iff_le_comap]
    refine S.polydiscPlus_le_comap_of_isOpen
      (isOpen_weightedSubring isWeightFamily_one_weight S.isRingOfIntegralElements.isOpen) he
      (fun a ha ↦ ?_) (fun i ↦ ?_)
    · rw [RingEquiv.coe_toRingHom, algebraMap_completion_weightedRestrictedSubring_apply,
        restrictedMvPowerSeriesCompletionEquiv_coe]
      exact (weightedC_mem_weightedSubring isWeightFamily_one_weight).mpr ha
    · rw [RingEquiv.coe_toRingHom, Pair.polydiscVar, restrictedMvPowerSeriesCompletionEquiv_coe]
      simpa only [map_one, one_mul] using
        weightedC_mul_weightedX_mem_weightedSubring (hT := isWeightFamily_one_weight)
          (R := S.plus) (i := i) (Set.mem_singleton (1 : A))
  · intro f hf
    refine Subring.mem_map.mpr ⟨(f : restrictedMvPowerSeriesCompletion n A), ?_,
      restrictedMvPowerSeriesCompletionEquiv_coe f⟩
    rw [Pair.polydiscPlus_def, ← SetLike.mem_coe, Subring.topologicalClosure_coe]
    set P₀ := Subring.closure
      (algebraMap A (restrictedMvPowerSeriesCompletion n A) '' S.plus ∪
        Set.range (Pair.polydiscVar n A))
    have hf_cl : f ∈ closure
        {g : weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight |
          (g : restrictedMvPowerSeriesCompletion n A) ∈ P₀} := by
      rw [mem_closure_iff_nhds]
      intro V hV
      rw [← nhds_translation_add_neg f, Filter.mem_comap] at hV
      obtain ⟨W, hW, hWV⟩ := hV
      obtain ⟨U, -, hU⟩ :=
        (hasBasis_nhds_zero_weightedTopology (k := n) (A := A)
          isWeightFamily_one_weight).mem_iff.mp hW
      obtain ⟨p, hp, hfp⟩ :=
        exists_mvPolynomial_sub_mem_weightedNhd_of_mem_weightedSubring isWeightFamily_one_weight
          hf U
      have hpf : weightedPolynomialHom _ isWeightFamily_one_weight p - f ∈
          weightedNhd _ isWeightFamily_one_weight U.toAddSubgroup := by
        simpa only [neg_sub] using
          (weightedNhd _ isWeightFamily_one_weight U.toAddSubgroup).neg_mem hfp
      exact ⟨weightedPolynomialHom _ isWeightFamily_one_weight p,
        hWV (hU (by simpa only [SetLike.mem_coe, sub_eq_add_neg] using hpf)),
        coe_weightedPolynomialHom_mem_closure S n p hp⟩
    exact image_closure_subset_closure_image
      (Completion.continuous_coe _) (Set.mem_image_of_mem _ hf_cl) |>
      closure_mono (by rintro _ ⟨g, hg, rfl⟩; exact hg)

/-- **`S.polydiscPlus n` is a ring of integral elements of `A⟨T₁, …, Tₙ⟩`.** -/
theorem Pair.isRingOfIntegralElements_polydiscPlus
    (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    IsRingOfIntegralElements (Pair.polydiscPlus S n) := by
  let e := restrictedMvPowerSeriesCompletionEquiv n A
  have he : Continuous ⇑e :=
    (uniformContinuous_restrictedMvPowerSeriesCompletionEquiv (k := n) (A := A)).continuous
  have he_symm : Continuous ⇑e.symm :=
    (uniformContinuous_restrictedMvPowerSeriesCompletionEquiv_symm (k := n) (A := A)).continuous
  have hmap :
      (weightedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight S.plus).map
        e.symm.toRingHom = S.polydiscPlus n := by
    rw [← S.map_polydiscPlus_equiv n, Subring.map_map]
    have hid : e.symm.toRingHom.comp (e : _ →+* _) = RingHom.id _ := by ext x; simp [e]
    rw [hid, Subring.map_id]
  rw [← hmap]
  exact (isRingOfIntegralElements_weightedSubring_one_weight S.isRingOfIntegralElements).map
    e.symm he_symm he

/-- **`S.polydiscPlus n` is the locus of elements of valuation at most `1` across
`spa (S.polydiscPlus n)`** (Scholze, *Étale cohomology of diamonds*, §24, after Proposition 24.4;
Scholze–Weinstein, *Berkeley lectures*, Lemma 10.5.8). -/
theorem Pair.coe_polydiscPlus_eq_setOf_forall_vle_one
    (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    (Pair.polydiscPlus S n : Set (restrictedMvPowerSeriesCompletion n A)) =
      {h | ∀ v ∈ spa (Pair.polydiscPlus S n), v.toValuativeRel.vle h 1} := by
  have hInt := S.isRingOfIntegralElements_polydiscPlus n
  have := hInt.isIntegrallyClosedIn
  exact coe_eq_setOf_forall_vle_one hInt.isOpen

/-- An element of `A⟨T₁, …, Tₙ⟩` lies in `S.polydiscPlus n` if and only if it has valuation at most
`1` at every point of `spa (S.polydiscPlus n)`. -/
theorem Pair.mem_polydiscPlus_iff_forall_vle_one
    (S : Pair A) [CompleteSpace A] [T0Space A] {n : ℕ}
    {h : restrictedMvPowerSeriesCompletion n A} :
    h ∈ S.polydiscPlus n ↔ ∀ v ∈ spa (S.polydiscPlus n), v.toValuativeRel.vle h 1 := by
  rw [← SetLike.mem_coe, S.coe_polydiscPlus_eq_setOf_forall_vle_one n, Set.mem_ofPred_eq]

/-- Over a complete Hausdorff base, `S.polydiscPlus n` agrees with the plus ring of the completed
trivial-weight pair `(S.weighted isWeightFamily_one_weight).completion`. -/
theorem Pair.polydiscPlus_eq_weighted_completion_plus
    (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    S.polydiscPlus n = (S.weighted (k := n) isWeightFamily_one_weight).completion.plus := by
  have hInt := S.isRingOfIntegralElements_polydiscPlus n
  have := hInt.isIntegrallyClosedIn
  let W := (S.weighted (k := n) isWeightFamily_one_weight).completion
  refine le_antisymm ?_ ?_
  · refine S.polydiscPlus_le
      (W.plus.toAddSubgroup.isClosed_of_isOpen W.isRingOfIntegralElements.isOpen)
      (fun a ha ↦ ?_) (fun i ↦ ?_)
    · rw [algebraMap_completion_weightedRestrictedSubring_apply]
      exact S.weightedC_mem_weighted_completion_plus isWeightFamily_one_weight ha
    · simpa only [Pair.polydiscVar, map_one, one_mul, Completion.coe_one, Completion.coe_mul] using
        S.weightedC_mul_weightedX_mem_weighted_completion_plus (k := n)
          isWeightFamily_one_weight (i := i) (Set.mem_singleton (1 : A))
  · refine S.weighted_completion_plus_le isWeightFamily_one_weight
      ((S.polydiscPlus n).toAddSubgroup.isClosed_of_isOpen hInt.isOpen)
      (fun a ha ↦ ?_) (fun i t ht ↦ ?_)
    · rw [← algebraMap_completion_weightedRestrictedSubring_apply]
      exact S.algebraMap_mem_polydiscPlus n ha
    · obtain rfl : t = 1 := Set.mem_singleton_iff.mp ht
      rw [map_one, one_mul]
      exact S.polydiscVar_mem_polydiscPlus n i

/-- **The affinoid relative closed unit polydisc `(A⟨T₁, …, Tₙ⟩, A⁺⟨T₁, …, Tₙ⟩)`** over a complete
Hausdorff Huber pair `S = (A, A⁺)`. -/
noncomputable def Pair.polydisc (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    Pair (restrictedMvPowerSeriesCompletion n A) where
  plus := Pair.polydiscPlus S n
  isRingOfIntegralElements := S.isRingOfIntegralElements_polydiscPlus n

@[simp]
theorem Pair.polydisc_plus (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    (S.polydisc n).plus = S.polydiscPlus n :=
  (rfl)

/-- Every constant from `A⁺` lies in `(S.polydisc n).plus`. -/
theorem Pair.algebraMap_mem_polydisc_plus (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ)
    {a : A} (ha : a ∈ S.plus) :
    algebraMap A (restrictedMvPowerSeriesCompletion n A) a ∈ (S.polydisc n).plus :=
  S.algebraMap_mem_polydiscPlus n ha

/-- Every coordinate variable `Tᵢ` lies in `(S.polydisc n).plus`. -/
theorem Pair.polydiscVar_mem_polydisc_plus (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ)
    (i : Fin n) :
    Pair.polydiscVar n A i ∈ (S.polydisc n).plus :=
  S.polydiscVar_mem_polydiscPlus n i

/-- `S.polydisc n` coincides as a Huber pair with
`(S.weighted isWeightFamily_one_weight).completion`. -/
theorem Pair.polydisc_eq_weighted_completion (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    S.polydisc n = (S.weighted (k := n) isWeightFamily_one_weight).completion :=
  Pair.ext (S.polydiscPlus_eq_weighted_completion_plus n)

/-- **The structure morphism `S → S.polydisc n`** corresponding to the projection
`Spa(A⟨T₁, …, Tₙ⟩, A⁺⟨T₁, …, Tₙ⟩) → Spa(A, A⁺)`. -/
noncomputable def Pair.polydisc.proj (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    Pair.Hom S (Pair.polydisc S n) where
  toRingHom := algebraMap A (restrictedMvPowerSeriesCompletion n A)
  continuous_toRingHom := continuous_algebraMap_restrictedMvPowerSeriesCompletion n A
  map_mem_plus _ ha := S.algebraMap_mem_polydiscPlus n ha

@[simp]
theorem Pair.polydisc.toRingHom_proj (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    (Pair.polydisc.proj S n).toRingHom =
      algebraMap A (restrictedMvPowerSeriesCompletion n A) :=
  (rfl)

theorem Pair.polydisc.proj_toRingHom_apply (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ)
    (a : A) :
    (Pair.polydisc.proj S n).toRingHom a =
      algebraMap A (restrictedMvPowerSeriesCompletion n A) a :=
  (rfl)

/-! ### Universal property of the relative closed polydisc -/

/-- Two morphisms of Huber pairs out of `S.polydisc n` into a Hausdorff Huber pair are equal as
soon as they agree after precomposition with `proj S n` and take the same value on every coordinate
variable `Tᵢ`. -/
theorem Pair.polydisc.hom_ext {C : Type*} [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
    [IsHuberRing C] [T0Space C] {S : Pair A} [CompleteSpace A] [T0Space A] {n : ℕ} {U : Pair C}
    {h₁ h₂ : Pair.Hom (S.polydisc n) U}
    (hproj : h₁.comp (Pair.polydisc.proj S n) = h₂.comp (Pair.polydisc.proj S n))
    (hvar : ∀ i, h₁.toRingHom (Pair.polydiscVar n A i) =
      h₂.toRingHom (Pair.polydiscVar n A i)) :
    h₁ = h₂ := by
  apply Pair.Hom.ext
  refine completion_weightedRestrictedSubring_ringHom_ext_of_continuous isWeightFamily_one_weight
    h₁.continuous_toRingHom h₂.continuous_toRingHom (fun a ↦ ?_) hvar
  simpa only [← algebraMap_completion_weightedRestrictedSubring_apply,
    ← Pair.polydisc.proj_toRingHom_apply S n, ← RingHom.comp_apply, ← Pair.Hom.toRingHom_comp]
    using congrArg (fun f : Pair.Hom S U ↦ f.toRingHom a) hproj

section UniversalProperty

variable {C : Type*} [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C]
  [IsHuberRing C] [CompleteSpace C] [T0Space C]

omit [IsUniformAddGroup A] [IsUniformAddGroup C] [CompleteSpace C] [T0Space C] in
/-- Auxiliary weight-boundedness witness: every tuple in `U.plus` is weight-bounded for the trivial
weight `{1}`. -/
private theorem isWeightBounded_of_mem_plus {S : Pair A} {U : Pair C} (z : Pair.Hom S U) {n : ℕ}
    (t : Fin n → U.plus) :
    IsWeightBounded z.toRingHom (fun _ : Fin n ↦ ({1} : Set A)) (fun i ↦ (t i : C)) :=
  (isWeightBounded_one_weight_iff_forall_isPowerBounded _ _).mpr fun i ↦
    U.isRingOfIntegralElements.isPowerBounded_of_mem (t i).2

/-- **Evaluation of `S.polydisc n` at a tuple `t : Fin n → U.plus`** along a base morphism
`z : Pair.Hom S U` into a complete Hausdorff Huber pair `U`. -/
noncomputable def Pair.polydisc.evalHom {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair C}
    (z : Pair.Hom S U) {n : ℕ} (t : Fin n → U.plus) :
    Pair.Hom (S.polydisc n) U where
  toRingHom := weightedEvalHomCompletion isWeightFamily_one_weight
    z.continuous_toRingHom.continuousAt (isWeightBounded_of_mem_plus z t)
  continuous_toRingHom := continuous_weightedEvalHomCompletion isWeightFamily_one_weight
    z.continuous_toRingHom.continuousAt (isWeightBounded_of_mem_plus z t)
  map_mem_plus := S.polydiscPlus_le_comap U
    (continuous_weightedEvalHomCompletion isWeightFamily_one_weight
      z.continuous_toRingHom.continuousAt (isWeightBounded_of_mem_plus z t))
    (fun a ha ↦ by
      rw [algebraMap_completion_weightedRestrictedSubring_apply, weightedEvalHomCompletion_coe,
        weightedEvalHom_weightedC]
      exact z.map_mem_plus a ha)
    (fun i ↦ by
      rw [Pair.polydiscVar, weightedEvalHomCompletion_coe, weightedEvalHom_weightedX]
      exact (t i).2)

@[simp]
theorem Pair.polydisc.toRingHom_evalHom_weightedC {S : Pair A} [CompleteSpace A] [T0Space A]
    {U : Pair C} (z : Pair.Hom S U) {n : ℕ} (t : Fin n → U.plus) (a : A) :
    (Pair.polydisc.evalHom z t).toRingHom
        ((weightedC (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight a :
          weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight) :
          restrictedMvPowerSeriesCompletion n A) =
      z.toRingHom a := by
  rw [Pair.polydisc.evalHom, weightedEvalHomCompletion_coe, weightedEvalHom_weightedC]

theorem Pair.polydisc.toRingHom_evalHom_algebraMap {S : Pair A} [CompleteSpace A] [T0Space A]
    {U : Pair C} (z : Pair.Hom S U) {n : ℕ} (t : Fin n → U.plus) (a : A) :
    (Pair.polydisc.evalHom z t).toRingHom
        (algebraMap A (restrictedMvPowerSeriesCompletion n A) a) =
      z.toRingHom a := by
  rw [algebraMap_completion_weightedRestrictedSubring_apply,
    Pair.polydisc.toRingHom_evalHom_weightedC]

@[simp]
theorem Pair.polydisc.toRingHom_evalHom_polydiscVar {S : Pair A} [CompleteSpace A] [T0Space A]
    {U : Pair C} (z : Pair.Hom S U) {n : ℕ} (t : Fin n → U.plus) (i : Fin n) :
    (Pair.polydisc.evalHom z t).toRingHom (Pair.polydiscVar n A i) = (t i : C) := by
  rw [Pair.polydisc.evalHom, Pair.polydiscVar, weightedEvalHomCompletion_coe,
    weightedEvalHom_weightedX]

@[simp]
theorem Pair.polydisc.evalHom_comp_proj {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair C}
    (z : Pair.Hom S U) {n : ℕ} (t : Fin n → U.plus) :
    (Pair.polydisc.evalHom z t).comp (Pair.polydisc.proj S n) = z := by
  apply Pair.Hom.ext
  ext a
  simp

/-- **Universal property of the affinoid relative closed unit polydisc.** Given a morphism of
Huber pairs `z : Pair.Hom S U` into a complete Hausdorff Huber pair `U = (C, C⁺)` and a tuple
`t : Fin n → U.plus`, there is a unique morphism `h : Pair.Hom (S.polydisc n) U` extending `z`
along `proj S n` and sending each coordinate `Tᵢ` to `tᵢ`. -/
theorem Pair.polydisc.existsUnique_hom {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair C}
    (z : Pair.Hom S U) (n : ℕ) (t : Fin n → U.plus) :
    ∃! h : Pair.Hom (Pair.polydisc S n) U,
      h.comp (Pair.polydisc.proj S n) = z ∧
        ∀ i, h.toRingHom (Pair.polydiscVar n A i) = (t i : C) := by
  refine ⟨Pair.polydisc.evalHom z t,
    ⟨Pair.polydisc.evalHom_comp_proj z t, Pair.polydisc.toRingHom_evalHom_polydiscVar z t⟩,
    fun h ⟨hproj, hvar⟩ ↦ Pair.polydisc.hom_ext ?_ ?_⟩
  · rw [hproj, Pair.polydisc.evalHom_comp_proj]
  · intro i
    rw [hvar i, Pair.polydisc.toRingHom_evalHom_polydiscVar]

/-- **Morphisms `S.polydisc n → U` over `z : Pair.Hom S U` correspond bijectively to coordinate
tuples `Fin n → U.plus`.** -/
noncomputable def Pair.polydisc.homEquiv {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair C}
    (z : Pair.Hom S U) (n : ℕ) :
    {h : Pair.Hom (S.polydisc n) U // h.comp (Pair.polydisc.proj S n) = z} ≃
      (Fin n → U.plus) where
  toFun h i := ⟨h.1.toRingHom (Pair.polydiscVar n A i),
    h.1.map_mem_plus _ (S.polydiscVar_mem_polydiscPlus n i)⟩
  invFun t := ⟨Pair.polydisc.evalHom z t, Pair.polydisc.evalHom_comp_proj z t⟩
  left_inv h := Subtype.ext <| Pair.polydisc.hom_ext
    ((Pair.polydisc.evalHom_comp_proj z _).trans h.2.symm)
    fun i ↦ Pair.polydisc.toRingHom_evalHom_polydiscVar z _ i
  right_inv t := funext fun i ↦ Subtype.ext <|
    Pair.polydisc.toRingHom_evalHom_polydiscVar z t i

@[simp]
theorem Pair.polydisc.homEquiv_apply {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair C}
    (z : Pair.Hom S U) (n : ℕ)
    (h : {h : Pair.Hom (S.polydisc n) U // h.comp (Pair.polydisc.proj S n) = z}) (i : Fin n) :
    (Pair.polydisc.homEquiv z n h i : C) = h.1.toRingHom (Pair.polydiscVar n A i) :=
  (rfl)

@[simp]
theorem Pair.polydisc.homEquiv_symm_apply {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair C}
    (z : Pair.Hom S U) (n : ℕ) (t : Fin n → U.plus) :
    (Pair.polydisc.homEquiv z n).symm t =
      ⟨Pair.polydisc.evalHom z t, Pair.polydisc.evalHom_comp_proj z t⟩ :=
  (rfl)

end UniversalProperty

/-! ### Functoriality, translations, zero variables, and iterated polydiscs -/

/-- **Functoriality of `Pair.polydisc` in the base Huber pair**, acting coefficientwise and sending
each coordinate `Tᵢ` to `Tᵢ`. -/
noncomputable def Pair.polydisc.map {B : Type*} [CommRing B] [UniformSpace B]
    [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B] [CompleteSpace B] [T0Space B]
    {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair B} (f : Pair.Hom S U) (n : ℕ) :
    Pair.Hom (S.polydisc n) (U.polydisc n) :=
  Pair.polydisc.evalHom ((Pair.polydisc.proj U n).comp f)
    fun i ↦ ⟨Pair.polydiscVar n B i, U.polydiscVar_mem_polydiscPlus n i⟩

@[simp]
theorem Pair.polydisc.map_comp_proj {B : Type*} [CommRing B] [UniformSpace B]
    [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B] [CompleteSpace B] [T0Space B]
    {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair B} (f : Pair.Hom S U) (n : ℕ) :
    (Pair.polydisc.map f n).comp (Pair.polydisc.proj S n) =
      (Pair.polydisc.proj U n).comp f :=
  Pair.polydisc.evalHom_comp_proj _ _

@[simp]
theorem Pair.polydisc.toRingHom_map_polydiscVar {B : Type*} [CommRing B] [UniformSpace B]
    [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B] [CompleteSpace B] [T0Space B]
    {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair B} (f : Pair.Hom S U) (n : ℕ)
    (i : Fin n) :
    (Pair.polydisc.map f n).toRingHom (Pair.polydiscVar n A i) = Pair.polydiscVar n B i :=
  Pair.polydisc.toRingHom_evalHom_polydiscVar _ _ i

@[simp]
theorem Pair.polydisc.map_id (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    Pair.polydisc.map (Pair.Hom.id S) n = Pair.Hom.id (S.polydisc n) := by
  refine Pair.polydisc.hom_ext ?_ fun i ↦ ?_
  · rw [Pair.polydisc.map_comp_proj, Pair.Hom.comp_id, Pair.Hom.id_comp]
  · simp

@[simp]
theorem Pair.polydisc.map_comp {B C : Type*} [CommRing B] [UniformSpace B] [IsUniformAddGroup B]
    [IsTopologicalRing B] [IsHuberRing B] [CompleteSpace B] [T0Space B] [CommRing C]
    [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsHuberRing C] [CompleteSpace C]
    [T0Space C] {S : Pair A} [CompleteSpace A] [T0Space A] {U : Pair B} {V : Pair C}
    (f : Pair.Hom S U) (g : Pair.Hom U V) (n : ℕ) :
    (Pair.polydisc.map g n).comp (Pair.polydisc.map f n) = Pair.polydisc.map (g.comp f) n := by
  refine Pair.polydisc.hom_ext ?_ fun i ↦ ?_
  · rw [Pair.Hom.comp_assoc, Pair.polydisc.map_comp_proj, ← Pair.Hom.comp_assoc,
      Pair.polydisc.map_comp_proj, Pair.polydisc.map_comp_proj, Pair.Hom.comp_assoc]
  · simp

/-- **Coordinate translation `Tᵢ ↦ Tᵢ + aᵢ` on `S.polydisc n`** for a tuple `a : Fin n → S.plus`.
This is the completed Huber-pair analogue of `TauCeti.ValuationSpectrum.taylorHom` and Mathlib's
`Polynomial.taylor`. -/
noncomputable def Pair.polydisc.taylorHom (S : Pair A) [CompleteSpace A] [T0Space A] {n : ℕ}
    (a : Fin n → S.plus) : Pair.Hom (S.polydisc n) (S.polydisc n) :=
  Pair.polydisc.evalHom (Pair.polydisc.proj S n) fun i ↦
    ⟨Pair.polydiscVar n A i +
        algebraMap A (restrictedMvPowerSeriesCompletion n A) (a i : A),
      add_mem (S.polydiscVar_mem_polydisc_plus n i)
        (S.algebraMap_mem_polydisc_plus n (a i).2)⟩

@[simp]
theorem Pair.polydisc.taylorHom_comp_proj (S : Pair A) [CompleteSpace A] [T0Space A] {n : ℕ}
    (a : Fin n → S.plus) :
    (Pair.polydisc.taylorHom S a).comp (Pair.polydisc.proj S n) =
      Pair.polydisc.proj S n :=
  Pair.polydisc.evalHom_comp_proj _ _

@[simp]
theorem Pair.polydisc.toRingHom_taylorHom_weightedC (S : Pair A) [CompleteSpace A] [T0Space A]
    {n : ℕ} (a : Fin n → S.plus) (c : A) :
    (Pair.polydisc.taylorHom S a).toRingHom
        ((weightedC (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight c :
          weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set A)) isWeightFamily_one_weight) :
          restrictedMvPowerSeriesCompletion n A) =
      algebraMap A (restrictedMvPowerSeriesCompletion n A) c := by
  simpa only [Pair.polydisc.taylorHom, Pair.polydisc.proj_toRingHom_apply] using
    Pair.polydisc.toRingHom_evalHom_weightedC (Pair.polydisc.proj S n) _ c

theorem Pair.polydisc.toRingHom_taylorHom_algebraMap (S : Pair A) [CompleteSpace A] [T0Space A]
    {n : ℕ} (a : Fin n → S.plus) (c : A) :
    (Pair.polydisc.taylorHom S a).toRingHom
        (algebraMap A (restrictedMvPowerSeriesCompletion n A) c) =
      algebraMap A (restrictedMvPowerSeriesCompletion n A) c := by
  simpa only [Pair.polydisc.taylorHom, Pair.polydisc.proj_toRingHom_apply] using
    Pair.polydisc.toRingHom_evalHom_algebraMap (Pair.polydisc.proj S n) _ c

@[simp]
theorem Pair.polydisc.toRingHom_taylorHom_polydiscVar (S : Pair A) [CompleteSpace A] [T0Space A]
    {n : ℕ} (a : Fin n → S.plus) (i : Fin n) :
    (Pair.polydisc.taylorHom S a).toRingHom (Pair.polydiscVar n A i) =
      Pair.polydiscVar n A i +
        algebraMap A (restrictedMvPowerSeriesCompletion n A) (a i : A) :=
  Pair.polydisc.toRingHom_evalHom_polydiscVar _ _ i

@[simp]
theorem Pair.polydisc.taylorHom_zero (S : Pair A) [CompleteSpace A] [T0Space A] (n : ℕ) :
    Pair.polydisc.taylorHom S (0 : Fin n → S.plus) = Pair.Hom.id (S.polydisc n) := by
  refine Pair.polydisc.hom_ext ?_ fun i ↦ ?_
  · rw [Pair.polydisc.taylorHom_comp_proj, Pair.Hom.id_comp]
  · simp

@[simp]
theorem Pair.polydisc.taylorHom_comp_taylorHom (S : Pair A) [CompleteSpace A] [T0Space A]
    {n : ℕ} (a b : Fin n → S.plus) :
    (Pair.polydisc.taylorHom S a).comp (Pair.polydisc.taylorHom S b) =
      Pair.polydisc.taylorHom S (a + b) := by
  refine Pair.polydisc.hom_ext ?_ fun i ↦ ?_
  · rw [Pair.Hom.comp_assoc, Pair.polydisc.taylorHom_comp_proj,
      Pair.polydisc.taylorHom_comp_proj, Pair.polydisc.taylorHom_comp_proj]
  · simp only [Pair.Hom.toRingHom_comp, RingHom.comp_apply,
      Pair.polydisc.toRingHom_taylorHom_polydiscVar, map_add, Pi.add_apply, Subring.coe_add,
      Pair.polydisc.toRingHom_taylorHom_algebraMap, add_assoc]

/-- **The inverse morphism `S.polydisc 0 → S` of `proj S 0`** in zero variables. -/
noncomputable def Pair.polydisc.zeroInvHom (S : Pair A) [CompleteSpace A] [T0Space A] :
    Pair.Hom (S.polydisc 0) S :=
  Pair.polydisc.evalHom (Pair.Hom.id S) Fin.elim0

@[simp]
theorem Pair.polydisc.zeroInvHom_comp_proj (S : Pair A) [CompleteSpace A] [T0Space A] :
    (Pair.polydisc.zeroInvHom S).comp (Pair.polydisc.proj S 0) = Pair.Hom.id S :=
  Pair.polydisc.evalHom_comp_proj _ _

@[simp]
theorem Pair.polydisc.proj_comp_zeroInvHom (S : Pair A) [CompleteSpace A] [T0Space A] :
    (Pair.polydisc.proj S 0).comp (Pair.polydisc.zeroInvHom S) =
      Pair.Hom.id (S.polydisc 0) := by
  refine Pair.polydisc.hom_ext ?_ fun i ↦ i.elim0
  rw [Pair.Hom.comp_assoc, Pair.polydisc.zeroInvHom_comp_proj, Pair.Hom.comp_id, Pair.Hom.id_comp]

/-- **Splitting `S.polydisc (m + n) → (S.polydisc m).polydisc n`**, sending the first `m`
coordinates to the base coordinates of `S.polydisc m` and the last `n` coordinates to the fibre
coordinates. -/
noncomputable def Pair.polydisc.splitHom (S : Pair A) [CompleteSpace A] [T0Space A] (m n : ℕ) :
    Pair.Hom (S.polydisc (m + n)) ((S.polydisc m).polydisc n) :=
  Pair.polydisc.evalHom ((Pair.polydisc.proj (S.polydisc m) n).comp (Pair.polydisc.proj S m))
    (Fin.addCases
      (fun i ↦ ⟨(Pair.polydisc.proj (S.polydisc m) n).toRingHom (Pair.polydiscVar m A i),
        (Pair.polydisc.proj (S.polydisc m) n).map_mem_plus _
          (S.polydiscVar_mem_polydiscPlus m i)⟩)
      (fun j ↦ ⟨Pair.polydiscVar n (restrictedMvPowerSeriesCompletion m A) j,
        (S.polydisc m).polydiscVar_mem_polydiscPlus n j⟩))

/-- **Joining `(S.polydisc m).polydisc n → S.polydisc (m + n)`**, inverse to `splitHom`. -/
noncomputable def Pair.polydisc.joinHom (S : Pair A) [CompleteSpace A] [T0Space A] (m n : ℕ) :
    Pair.Hom ((S.polydisc m).polydisc n) (S.polydisc (m + n)) :=
  Pair.polydisc.evalHom
    (Pair.polydisc.evalHom (Pair.polydisc.proj S (m + n))
      fun i ↦ ⟨Pair.polydiscVar (m + n) A (Fin.castAdd n i),
        S.polydiscVar_mem_polydiscPlus (m + n) (Fin.castAdd n i)⟩)
    fun j ↦ ⟨Pair.polydiscVar (m + n) A (Fin.natAdd m j),
      S.polydiscVar_mem_polydiscPlus (m + n) (Fin.natAdd m j)⟩

@[simp]
theorem Pair.polydisc.splitHom_comp_proj (S : Pair A) [CompleteSpace A] [T0Space A] (m n : ℕ) :
    (Pair.polydisc.splitHom S m n).comp (Pair.polydisc.proj S (m + n)) =
      (Pair.polydisc.proj (S.polydisc m) n).comp (Pair.polydisc.proj S m) :=
  Pair.polydisc.evalHom_comp_proj _ _

@[simp]
theorem Pair.polydisc.toRingHom_splitHom_castAdd (S : Pair A) [CompleteSpace A] [T0Space A]
    (m n : ℕ) (i : Fin m) :
    (Pair.polydisc.splitHom S m n).toRingHom (Pair.polydiscVar (m + n) A (Fin.castAdd n i)) =
      (Pair.polydisc.proj (S.polydisc m) n).toRingHom (Pair.polydiscVar m A i) := by
  simp [Pair.polydisc.splitHom]

@[simp]
theorem Pair.polydisc.toRingHom_splitHom_natAdd (S : Pair A) [CompleteSpace A] [T0Space A]
    (m n : ℕ) (j : Fin n) :
    (Pair.polydisc.splitHom S m n).toRingHom (Pair.polydiscVar (m + n) A (Fin.natAdd m j)) =
      Pair.polydiscVar n (restrictedMvPowerSeriesCompletion m A) j := by
  simp [Pair.polydisc.splitHom]

@[simp]
theorem Pair.polydisc.toRingHom_joinHom_polydiscVar (S : Pair A) [CompleteSpace A] [T0Space A]
    (m n : ℕ) (j : Fin n) :
    (Pair.polydisc.joinHom S m n).toRingHom
        (Pair.polydiscVar n (restrictedMvPowerSeriesCompletion m A) j) =
      Pair.polydiscVar (m + n) A (Fin.natAdd m j) :=
  Pair.polydisc.toRingHom_evalHom_polydiscVar _ _ j

@[simp]
theorem Pair.polydisc.toRingHom_joinHom_weightedC_polydiscVar (S : Pair A) [CompleteSpace A]
    [T0Space A] (m n : ℕ) (i : Fin m) :
    (Pair.polydisc.joinHom S m n).toRingHom
        ((weightedC (fun _ : Fin n ↦ ({1} : Set (restrictedMvPowerSeriesCompletion m A)))
          isWeightFamily_one_weight (Pair.polydiscVar m A i) :
          weightedRestrictedSubring _ isWeightFamily_one_weight) :
          restrictedMvPowerSeriesCompletion n (restrictedMvPowerSeriesCompletion m A)) =
      Pair.polydiscVar (m + n) A (Fin.castAdd n i) := by
  rw [Pair.polydisc.joinHom, Pair.polydisc.toRingHom_evalHom_weightedC,
    Pair.polydisc.toRingHom_evalHom_polydiscVar]

theorem Pair.polydisc.joinHom_comp_proj_toRingHom_polydiscVar (S : Pair A) [CompleteSpace A]
    [T0Space A] (m n : ℕ) (i : Fin m) :
    ((Pair.polydisc.joinHom S m n).comp (Pair.polydisc.proj (S.polydisc m) n)).toRingHom
        (Pair.polydiscVar m A i) =
      Pair.polydiscVar (m + n) A (Fin.castAdd n i) := by
  simp

@[simp]
theorem Pair.polydisc.joinHom_comp_proj_comp_proj (S : Pair A) [CompleteSpace A] [T0Space A]
    (m n : ℕ) :
    ((Pair.polydisc.joinHom S m n).comp (Pair.polydisc.proj (S.polydisc m) n)).comp
        (Pair.polydisc.proj S m) =
      Pair.polydisc.proj S (m + n) := by
  rw [Pair.polydisc.joinHom, Pair.polydisc.evalHom_comp_proj, Pair.polydisc.evalHom_comp_proj]

@[simp]
theorem Pair.polydisc.joinHom_comp_splitHom (S : Pair A) [CompleteSpace A] [T0Space A]
    (m n : ℕ) :
    (Pair.polydisc.joinHom S m n).comp (Pair.polydisc.splitHom S m n) =
      Pair.Hom.id (S.polydisc (m + n)) := by
  refine Pair.polydisc.hom_ext ?_ fun l ↦ ?_
  · rw [Pair.Hom.comp_assoc, Pair.polydisc.splitHom_comp_proj, ← Pair.Hom.comp_assoc,
      Pair.polydisc.joinHom_comp_proj_comp_proj, Pair.Hom.id_comp]
  · refine Fin.addCases (fun i ↦ ?_) (fun j ↦ ?_) l
    · rw [Pair.Hom.toRingHom_comp, RingHom.comp_apply, Pair.polydisc.toRingHom_splitHom_castAdd,
        ← RingHom.comp_apply, ← Pair.Hom.toRingHom_comp,
        Pair.polydisc.joinHom_comp_proj_toRingHom_polydiscVar, Pair.Hom.toRingHom_id,
        RingHom.id_apply]
    · simp

@[simp]
theorem Pair.polydisc.splitHom_comp_joinHom (S : Pair A) [CompleteSpace A] [T0Space A]
    (m n : ℕ) :
    (Pair.polydisc.splitHom S m n).comp (Pair.polydisc.joinHom S m n) =
      Pair.Hom.id ((S.polydisc m).polydisc n) := by
  refine Pair.polydisc.hom_ext ?_ fun j ↦ ?_
  · rw [Pair.Hom.comp_assoc, Pair.Hom.id_comp]
    refine Pair.polydisc.hom_ext ?_ fun i ↦ ?_
    · rw [Pair.Hom.comp_assoc, Pair.polydisc.joinHom_comp_proj_comp_proj,
        Pair.polydisc.splitHom_comp_proj]
    · rw [Pair.Hom.toRingHom_comp, RingHom.comp_apply,
        Pair.polydisc.joinHom_comp_proj_toRingHom_polydiscVar,
        Pair.polydisc.toRingHom_splitHom_castAdd]
  · simp

end CompleteBase

/-! ### Comparison with `closedPolydisc` over a complete nonarchimedean field -/

section NormedField

open scoped NNReal

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]

/-- Over a nontrivially normed ultrametric field `K`, the power-bounded subring of `K⟨T₁, …, Tₙ⟩`
is the subring `K°⟨T₁, …, Tₙ⟩` of series with power-bounded coefficients. -/
theorem weightedSubring_powerBoundedSubring_eq (n : ℕ) :
    weightedSubring (fun _ : Fin n ↦ ({1} : Set K)) isWeightFamily_one_weight
        (powerBoundedSubring K) =
      powerBoundedSubring
        (weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set K)) isWeightFamily_one_weight) := by
  refine le_antisymm (weightedSubring_le_powerBoundedSubring isWeightFamily_one_weight le_rfl)
    fun f hf ↦ ?_
  let vK : Valuation K ℝ≥0 :=
    { toFun := fun x ↦ ‖x‖₊
      map_zero' := nnnorm_zero
      map_one' := nnnorm_one
      map_mul' := nnnorm_mul
      map_add_le_max' := IsUltrametricDist.nnnorm_add_le_max }
  have hvK_apply (x : K) : vK x = ‖x‖₊ := rfl
  have hvK : vK.IsContinuous := Valuation.isContinuous_of_forall_isOpen_lt fun γ ↦ by
    convert Metric.isOpen_ball (x := (0 : K)) (ε := (γ : ℝ)) using 1
    ext a
    simp [hvK_apply, Metric.mem_ball, ← NNReal.coe_lt_coe]
  let W := weightedGaussValuation n hvK
  have hWf : W f ≤ 1 := by
    by_contra! hgt
    have hnhds : {g | W g < 1} ∈ nhds 0 :=
      (by simpa only [map_one] using
        (W.isContinuous_def.mp (isContinuous_weightedGaussValuation hvK)) 1 : IsOpen _).mem_nhds
        (by simp)
    obtain ⟨V, hV0, hVU⟩ :=
      isBounded_iff.mp (isPowerBounded_iff.mp (mem_powerBoundedSubring.mp hf)) _ hnhds
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp <|
      ((continuous_weightedC isWeightFamily_one_weight).continuousAt
        (x := (0 : K))).preimage_mem_nhds (by simpa only [map_zero] using hV0)
    obtain ⟨c, hc0, hcε⟩ := NormedField.exists_norm_lt K hε
    have hc_pos : (0 : ℝ≥0) < ‖c‖₊ := nnnorm_pos.mpr (norm_pos_iff.mp hc0)
    obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt (‖c‖₊⁻¹) hgt
    have hlt1 : W (weightedC _ isWeightFamily_one_weight c * f ^ m) < 1 :=
      hVU ⟨_, hball (mem_ball_zero_iff.mpr hcε), f ^ m, ⟨m, rfl⟩, rfl⟩
    rw [map_mul, map_pow, weightedGaussValuation_weightedC, hvK_apply] at hlt1
    have h1lt : 1 < ‖c‖₊ * W f ^ m := by
      rw [mul_comm]
      exact (inv_lt_iff_one_lt_mul₀ hc_pos).mp hm
    exact not_lt_of_ge hlt1.le h1lt
  rw [mem_weightedSubring, mem_weightedNhd]
  intro ν
  rw [weightMul_one_weight, Subring.mem_toAddSubgroup, mem_powerBoundedSubring,
    isPowerBounded_iff_norm_le_one]
  exact NNReal.coe_le_one.mpr ((coeff_le_weightedGaussValuation hvK f ν).trans hWf)

/-- **Over a complete nontrivially normed ultrametric field `K`, the adic spectrum of
`(Pair.powerBounded K).polydisc n` is homeomorphic to `closedPolydisc n K`.** -/
noncomputable def Pair.polydisc.closedPolydiscHomeomorph [CompleteSpace K] (n : ℕ) :
    spa ((Pair.powerBounded K).polydiscPlus n) ≃ₜ closedPolydisc n K := by
  let e := restrictedMvPowerSeriesCompletionEquiv n K
  have he : Continuous ⇑e :=
    (uniformContinuous_restrictedMvPowerSeriesCompletionEquiv (k := n) (A := K)).continuous
  have hplus :
      ((Pair.powerBounded K).polydiscPlus n).map (e : _ →+* _) =
        powerBoundedSubring (weightedRestrictedSubring
          (fun _ : Fin n ↦ ({1} : Set K)) isWeightFamily_one_weight) := by
    rw [(Pair.powerBounded K).map_polydiscPlus_equiv n, Pair.powerBounded_plus,
      weightedSubring_powerBoundedSubring_eq n]
  let h₁ : Pair.Hom (Pair.powerBounded K |>.polydisc n)
      (Pair.powerBounded
        (weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set K)) isWeightFamily_one_weight)) :=
    { toRingHom := e.toRingHom
      continuous_toRingHom := he
      map_mem_plus := fun f hf ↦ by
        rw [Pair.powerBounded_plus, ← hplus]
        exact ⟨f, hf, rfl⟩ }
  let h₂ : Pair.Hom
      (Pair.powerBounded
        (weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set K)) isWeightFamily_one_weight))
      (Pair.powerBounded K |>.polydisc n) :=
    { toRingHom := Completion.coeRingHom
      continuous_toRingHom := Completion.continuous_coe _
      map_mem_plus := fun g hg ↦ by
        rw [Pair.powerBounded_plus, ← hplus] at hg
        obtain ⟨f, hf, rfl⟩ := hg
        rw [Pair.polydisc_plus]
        change ((e f : weightedRestrictedSubring _ _) :
          restrictedMvPowerSeriesCompletion n K) ∈ _
        rwa [← restrictedMvPowerSeriesCompletionEquiv_symm_apply, e.symm_apply_apply] }
  exact
    { toFun := fun v ↦ ⟨(h₂.spaComap ⟨v.1, v.2⟩).1, by
        simpa only [closedPolydisc_def, Pair.powerBounded_plus] using
          (h₂.spaComap ⟨v.1, v.2⟩).2⟩
      invFun := fun w ↦ ⟨(h₁.spaComap ⟨w.1, by
          simpa only [closedPolydisc_def, Pair.powerBounded_plus] using w.2⟩).1,
        (h₁.spaComap ⟨w.1, by
          simpa only [closedPolydisc_def, Pair.powerBounded_plus] using w.2⟩).2⟩
      left_inv := fun v ↦ Subtype.ext <| by
        simp only [Pair.Hom.spaComap_val, h₁, h₂]
        rw [← Function.comp_apply (f := ValuationSpectrum.comap _), ← ValuationSpectrum.comap_comp]
        have hid : Completion.coeRingHom.comp e.toRingHom = RingHom.id _ := by
          ext x
          change ((e x : weightedRestrictedSubring _ _) :
            restrictedMvPowerSeriesCompletion n K) = x
          rw [← restrictedMvPowerSeriesCompletionEquiv_symm_apply, e.symm_apply_apply]
        rw [hid, ValuationSpectrum.comap_id, id]
      right_inv := fun w ↦ Subtype.ext <| by
        simp only [Pair.Hom.spaComap_val, h₁, h₂]
        rw [← Function.comp_apply (f := ValuationSpectrum.comap _), ← ValuationSpectrum.comap_comp]
        have hid : e.toRingHom.comp Completion.coeRingHom = RingHom.id _ := by ext x; simp [e]
        rw [hid, ValuationSpectrum.comap_id, id]
      continuous_toFun :=
        (h₂.continuous_spaComap.comp
          (continuous_subtype_val.subtype_mk fun v ↦ v.2)).subtype_val.subtype_mk fun v ↦ by
            simpa only [Function.comp_apply, closedPolydisc_def, Pair.powerBounded_plus] using
              (h₂.spaComap ⟨v.1, v.2⟩).2
      continuous_invFun :=
        (h₁.continuous_spaComap.comp
          (continuous_subtype_val.subtype_mk fun w ↦ by
            simpa only [closedPolydisc_def, Pair.powerBounded_plus] using
              w.2)).subtype_val.subtype_mk fun w ↦
          (h₁.spaComap ⟨w.1, by
            simpa only [closedPolydisc_def, Pair.powerBounded_plus] using w.2⟩).2 }

/-- `closedPolydiscHomeomorph` acts on underlying points of `Spv` by pullback along
`Completion.coeRingHom`. -/
@[simp]
theorem Pair.polydisc.coe_closedPolydiscHomeomorph_apply [CompleteSpace K] (n : ℕ)
    (v : spa ((Pair.powerBounded K).polydiscPlus n)) :
    (Pair.polydisc.closedPolydiscHomeomorph n v :
        Spv (weightedRestrictedSubring (fun _ : Fin n ↦ ({1} : Set K))
          isWeightFamily_one_weight)) =
      comap Completion.coeRingHom v.1 := by
  simp [closedPolydiscHomeomorph]

/-- The inverse of `closedPolydiscHomeomorph` acts on underlying points of `Spv` by pullback along
`restrictedMvPowerSeriesCompletionEquiv`. -/
@[simp]
theorem Pair.polydisc.coe_closedPolydiscHomeomorph_symm_apply [CompleteSpace K] (n : ℕ)
    (w : closedPolydisc n K) :
    ((Pair.polydisc.closedPolydiscHomeomorph n).symm w :
        Spv (restrictedMvPowerSeriesCompletion n K)) =
      comap (restrictedMvPowerSeriesCompletionEquiv n K).toRingHom w.1 := by
  simp [closedPolydiscHomeomorph]

end NormedField

end TauCeti.Huber
