module

public import TauCeti.AlgebraicGeometry.AdicSpace.Spa.Polydisc.Basic
public import Mathlib.FieldTheory.IsAlgClosed.Basic

import TauCeti.RingTheory.Huber.Normed
import TauCeti.RingTheory.Huber.Restricted.OneVariable
import TauCeti.RingTheory.Huber.WeightedRestrictedSeries.PowerBounded
import TauCeti.RingTheory.PowerSeries.Weierstrass.Ideal

/-!
# The points of the closed unit disc with nonzero support

Let `K` be a complete nonarchimedean normed field and `K⟨T⟩` the coordinate ring of the closed unit
disc `closedPolydisc 1 K`. The points of the disc fall into two kinds according to their support.
A point with trivial support is not classical
(`TauCeti.ValuationSpectrum.ne_classicalPoint_of_supp_eq_bot`). This file shows that, when `K` is
algebraically closed, every point with nonzero support is a classical point `x_a : f ↦ |f(a)|`
for some `a` with `‖a‖ ≤ 1`. These are the points of type (1) in Wedhorn's description of the
closed unit disc (Example 7.57). The points of his other types (2) to (5) have trivial support;
they are not classified here.

The algebraic input is the remainder theorem in `K⟨T⟩`: for `‖a‖ ≤ 1`, `T - a` divides
`f - f(a)` for every `f`, so the kernel of evaluation at `a` is the ideal generated by `T - a`.
This is Weierstrass division by `T - a`, which is distinguished of degree `1` at the unit radius.
It follows that a point whose support contains `T - a` compares two series as
the norm compares their values at `a`, which is how the classical point at `a` compares them.

For the classification, a nonzero prime ideal of `K⟨T⟩` is generated by a monic polynomial
(Weierstrass preparation). Over an algebraically closed field that polynomial is a product of
linear factors, one of which, `T - a`, lies in the support. The bound `‖a‖ ≤ 1` comes from the point
itself: it is at most one on `T`, and it gives `T` and `a` the same value. Without algebraic
closedness the monic generator need not have a root in `K`, and the points with nonzero support
correspond to the closed points of `Spec K⟨T⟩`, which need not be `K`-rational.

## Main results

* `TauCeti.ValuationSpectrum.weightedX_sub_weightedC_dvd_sub_weightedC_evalAtHom`: the
  remainder theorem `T - a ∣ f - f(a)` in `K⟨T⟩`.
* `TauCeti.ValuationSpectrum.ker_evalAtHom_eq_span_weightedX_sub_weightedC`: the kernel of
  evaluation at `a` is the ideal generated by `T - a`.
* `TauCeti.ValuationSpectrum.supp_classicalPoint_eq_span_weightedX_sub_weightedC`: the support of
  the classical point at `a` is that ideal.
* `TauCeti.ValuationSpectrum.eq_classicalPoint_of_weightedX_sub_weightedC_mem_supp`: a point of the
  closed unit disc whose support contains `T - a` is the classical point at `a`.
* `TauCeti.ValuationSpectrum.isClosed_singleton_classicalPoint`: consequently the classical
  points are closed.
* `TauCeti.ValuationSpectrum.exists_weightedX_sub_weightedC_mem_supp`: over an algebraically
  closed field, a point with nonzero support kills `T - a` for some `a` with `‖a‖ ≤ 1`.
* `TauCeti.ValuationSpectrum.supp_ne_bot_iff_exists_eq_classicalPoint`: over an algebraically
  closed field, the points of the closed unit disc with nonzero support are exactly the classical
  points.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Example 7.57.
* Bosch, Güntzer, Remmert, *Non-Archimedean Analysis*, §5.2.2 and §5.2.6, for Weierstrass division
  and preparation and the ideals of the Tate algebra.
-/

public section

namespace TauCeti.ValuationSpectrum

open TauCeti.Huber

variable {K : Type*} [NormedField K] [IsUltrametricDist K] [NonarchimedeanRing K] [CompleteSpace K]

/-- **The remainder theorem in `K⟨T⟩`.** For `a` in the closed unit disc (power-bounded, that is
`‖a‖ ≤ 1`), `T - a` divides `f - f(a)` for every restricted power series `f` in one variable over
a complete nonarchimedean field. This is the analogue of Mathlib's
`Polynomial.X_sub_C_dvd_sub_C_eval`. -/
theorem weightedX_sub_weightedC_dvd_sub_weightedC_evalAtHom (a : Fin 1 → K)
    (ha : ∀ i, IsPowerBounded (a i))
    (f : weightedRestrictedSubring (fun _ : Fin 1 ↦ ({1} : Set K)) isWeightFamily_one_weight) :
    weightedX _ isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight (a 0) ∣
      f - weightedC _ isWeightFamily_one_weight (evalAtHom a ha f) := by
  -- Weierstrass division by `T - a`, which is distinguished of degree `1` at the unit radius
  have hlin : ((weightedRestrictedSubringOneEquiv (weightedX (fun _ : Fin 1 ↦ ({1} : Set K))
      isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight (a 0)) :
        PowerSeries.IsRestricted.subring (R := K) 1) : PowerSeries K) =
          PowerSeries.X - PowerSeries.C (a 0) := by
    simp
  obtain ⟨q, r, hr, hqr⟩ := (hlin ▸ TauCeti.PowerSeries.isMulDistinguished_X_sub_C one_pos
    (isPowerBounded_iff_norm_le_one.mp (ha 0))).exists_mul_add_eq_subring one_pos
      (weightedRestrictedSubringOneEquiv f)
  -- the remainder has no coefficient in positive degree, so it is the constant `r₀`
  set r₀ := PowerSeries.coeff 0 (r : PowerSeries K)
  have hrC : r = weightedRestrictedSubringOneEquiv (weightedC _ isWeightFamily_one_weight r₀) := by
    refine Subtype.ext (PowerSeries.ext fun n ↦ ?_)
    rw [coe_weightedRestrictedSubringOneEquiv_weightedC, PowerSeries.coeff_C]
    rcases n with _ | n
    · rfl
    · simpa using hr (n + 1) (by omega)
  have hf : f = weightedRestrictedSubringOneEquiv.symm q *
      (weightedX _ isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight (a 0)) +
        weightedC _ isWeightFamily_one_weight r₀ :=
    weightedRestrictedSubringOneEquiv.injective (by
      rw [map_add, map_mul, RingEquiv.apply_symm_apply, ← hrC, hqr])
  -- evaluating at `a` kills the multiple of `T - a` and leaves `r₀`
  have heval : evalAtHom a ha f = r₀ := by
    rw [hf]
    simp
  refine ⟨weightedRestrictedSubringOneEquiv.symm q, ?_⟩
  rw [heval, hf, add_sub_cancel_right, mul_comm]

/-- **The kernel of evaluation at `a` is generated by `T - a`** in the coordinate ring `K⟨T⟩` of
the closed unit disc over a complete nonarchimedean field. This is the analogue of Mathlib's
`Polynomial.ker_evalRingHom`. -/
theorem ker_evalAtHom_eq_span_weightedX_sub_weightedC (a : Fin 1 → K)
    (ha : ∀ i, IsPowerBounded (a i)) :
    RingHom.ker (evalAtHom a ha) = Ideal.span {(weightedX (fun _ : Fin 1 ↦ ({1} : Set K))
      isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight (a 0))} := by
  refine le_antisymm (fun f hf ↦ ?_) (Ideal.span_le.mpr ?_)
  · have h := weightedX_sub_weightedC_dvd_sub_weightedC_evalAtHom a ha f
    rw [RingHom.mem_ker.mp hf, map_zero, sub_zero] at h
    exact Ideal.mem_span_singleton.mpr h
  · simp

/-- **The support of the classical point at `a` is generated by `T - a`**, for every point `x` of
`Spa (K, K°)` over a complete nonarchimedean field. -/
theorem supp_classicalPoint_eq_span_weightedX_sub_weightedC (x : spa (powerBoundedSubring K))
    (a : Fin 1 → K) (ha : ∀ i, IsPowerBounded (a i)) :
    (classicalPoint x a ha).1.supp = Ideal.span {(weightedX (fun _ : Fin 1 ↦ ({1} : Set K))
      isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight (a 0))} := by
  -- `x` has trivial support, since it compares elements of `K` by their norms
  rw [← ker_evalAtHom_eq_span_weightedX_sub_weightedC a ha]
  ext f
  rw [mem_supp_iff, classicalPoint_vle, map_zero, vle_iff_norm_le_of_mem_spa x.2, norm_zero,
    norm_le_zero_iff, RingHom.mem_ker]

/-- A point of the closed unit disc whose support contains `T - a` has the same value on `f` as
on the constant `f(a)`. -/
private theorem valuation_eq_valuation_weightedC_evalAtHom (v : closedPolydisc 1 K)
    (a : Fin 1 → K) (ha : ∀ i, IsPowerBounded (a i))
    (hv : weightedX _ isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight (a 0) ∈
      v.1.supp)
    (f : weightedRestrictedSubring (fun _ : Fin 1 ↦ ({1} : Set K)) isWeightFamily_one_weight) :
    v.1.valuation f = v.1.valuation (weightedC _ isWeightFamily_one_weight (evalAtHom a ha f)) := by
  obtain ⟨g, hg⟩ := weightedX_sub_weightedC_dvd_sub_weightedC_evalAtHom a ha f
  conv_lhs => rw [← sub_add_cancel f (weightedC _ _ (evalAtHom a ha f)), hg, add_comm]
  exact Valuation.map_add_supp _ _
    (supp_eq_valuation_supp v.1 ▸ Ideal.mul_mem_right _ _ hv)

/-- **A point of the closed unit disc whose support contains `T - a` is the classical point at
`a`**, built from any point `x` of `Spa (K, K°)`, over a complete nonarchimedean field. -/
theorem eq_classicalPoint_of_weightedX_sub_weightedC_mem_supp (v : closedPolydisc 1 K)
    (a : Fin 1 → K) (ha : ∀ i, IsPowerBounded (a i))
    (hv : weightedX _ isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight (a 0) ∈
      v.1.supp)
    (x : spa (powerBoundedSubring K)) : v = classicalPoint x a ha := by
  -- both points compare `f` and `g` as the norm compares `f(a)` and `g(a)`
  refine Subtype.ext (ext' fun f g ↦ ?_)
  rw [classicalPoint_vle, vle_iff_norm_le_of_mem_spa x.2, ← closedPolydisc_vle_weightedC_iff v,
    ← valuation_le_iff, ← valuation_le_iff, valuation_eq_valuation_weightedC_evalAtHom v a ha hv f,
    valuation_eq_valuation_weightedC_evalAtHom v a ha hv g]

/-- **The classical points of the closed unit disc are closed**, over a complete nonarchimedean
field: the classical point at `a` is the only point whose support contains `T - a`, and the locus
of points whose support contains a given ideal is closed. These are the points of type (1) in
Wedhorn's Example 7.57. -/
theorem isClosed_singleton_classicalPoint (x : spa (powerBoundedSubring K)) (a : Fin 1 → K)
    (ha : ∀ i, IsPowerBounded (a i)) :
    IsClosed ({classicalPoint x a ha} : Set (closedPolydisc 1 K)) := by
  set s := weightedX (fun _ : Fin 1 ↦ ({1} : Set K)) isWeightFamily_one_weight 0 -
    weightedC _ isWeightFamily_one_weight (a 0)
  have hset : ({classicalPoint x a ha} : Set (closedPolydisc 1 K)) =
      Subtype.val ⁻¹' {v | Ideal.span {s} ≤ v.supp} := by
    ext v
    rw [Set.mem_singleton_iff, Set.mem_preimage, Set.mem_ofPred_eq,
      Ideal.span_singleton_le_iff_mem]
    refine ⟨?_, fun hv ↦ eq_classicalPoint_of_weightedX_sub_weightedC_mem_supp v a ha hv x⟩
    rintro rfl
    rw [supp_classicalPoint_eq_span_weightedX_sub_weightedC]
    exact Ideal.mem_span_singleton_self s
  have h := isClosed_support_locus (powerBoundedSubring _) (Ideal.span {s})
  rw [← closedPolydisc_def] at h
  rwa [hset]

/-- **A point of the closed unit disc with nonzero support kills some `T - a` with `‖a‖ ≤ 1`**,
over an algebraically closed complete nonarchimedean field. -/
theorem exists_weightedX_sub_weightedC_mem_supp [IsAlgClosed K] (v : closedPolydisc 1 K)
    (hv : v.1.supp ≠ ⊥) :
    ∃ a : K, ‖a‖ ≤ 1 ∧
      weightedX _ isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight a ∈
        v.1.supp := by
  classical
  -- the support, as a nonzero prime ideal of Mathlib's restricted power series ring
  set p := v.1.supp.comap (weightedRestrictedSubringOneEquiv (R := K)).symm.toRingHom with hp
  have hp0 : p ≠ ⊥ := by
    rw [hp, RingEquiv.toRingHom_eq_coe, Ideal.comap_coe, Ideal.comap_symm]
    exact (Ideal.map_eq_bot_iff_of_injective weightedRestrictedSubringOneEquiv.injective).not.mpr hv
  -- it is generated by a monic polynomial, which splits into linear factors
  obtain ⟨g, ω, _n, hω, -, hgω, hspan⟩ :=
    TauCeti.PowerSeries.exists_isMonicOfDegree_span_singleton_eq one_pos hp0
  have hg : TauCeti.PowerSeries.polynomialToRestricted 1 ω ∈ p := by
    have : g = TauCeti.PowerSeries.polynomialToRestricted 1 ω := Subtype.ext (by simpa using hgω)
    rw [← this, ← hspan]
    exact Ideal.mem_span_singleton_self g
  rw [← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hω.monic
    IsAlgClosed.card_roots_eq_natDegree, map_multiset_prod, Multiset.map_map] at hg
  -- one linear factor `T - a` lies in the support
  obtain ⟨_, hmem, hlin⟩ := (Ideal.IsPrime.comap _).multiset_prod_mem_iff_exists_mem _ |>.mp hg
  obtain ⟨a, -, rfl⟩ := Multiset.mem_map.mp hmem
  have hsupp : weightedX _ isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight a ∈
      v.1.supp := by
    have heq : weightedRestrictedSubringOneEquiv (weightedX (fun _ : Fin 1 ↦ ({1} : Set K))
        isWeightFamily_one_weight 0 - weightedC _ isWeightFamily_one_weight a) =
          TauCeti.PowerSeries.polynomialToRestricted 1 (Polynomial.X - Polynomial.C a) :=
      Subtype.ext (by simp)
    simpa [hp, ← heq] using hlin
  refine ⟨a, ?_, hsupp⟩
  -- `v` is at most one on `T` and gives `T` and `a` the same value
  have hT : v.1.toValuativeRel.vle (weightedX (fun _ : Fin 1 ↦ ({1} : Set K))
      isWeightFamily_one_weight 0) 1 :=
    ((mem_closedPolydisc_iff 1 K v.1).mp v.2).2 _
      (mem_powerBoundedSubring.mpr (isPowerBounded_weightedX_one_weight 0))
  have hTa : v.1.valuation (weightedX (fun _ : Fin 1 ↦ ({1} : Set K))
      isWeightFamily_one_weight 0) = v.1.valuation (weightedC _ isWeightFamily_one_weight a) := by
    rw [← sub_add_cancel (weightedX _ _ 0) (weightedC _ _ a), add_comm]
    exact Valuation.map_add_supp _ _ (supp_eq_valuation_supp v.1 ▸ hsupp)
  rw [← norm_one (α := K), ← closedPolydisc_vle_weightedC_iff v, map_one, ← valuation_le_iff,
    ← hTa, valuation_le_iff]
  exact hT

/-- **The points of the closed unit disc with nonzero support are exactly the classical points**,
over an algebraically closed complete nonarchimedean field: the points of type (1) in Wedhorn's
description of the closed unit disc (Example 7.57). -/
theorem supp_ne_bot_iff_exists_eq_classicalPoint [IsAlgClosed K] (v : closedPolydisc 1 K) :
    v.1.supp ≠ ⊥ ↔ ∃ (x : spa (powerBoundedSubring K)) (a : Fin 1 → K)
      (ha : ∀ i, IsPowerBounded (a i)), v = classicalPoint x a ha := by
  refine ⟨fun hv ↦ ?_, ?_⟩
  · obtain ⟨a, ha, hmem⟩ := exists_weightedX_sub_weightedC_mem_supp v hv
    -- a point of `Spa (K, K°)`: the pullback of `v` along the constant embedding
    exact ⟨⟨_, comap_weightedC_mem_spa v⟩, fun _ ↦ a, fun _ ↦ isPowerBounded_iff_norm_le_one.mpr ha,
      eq_classicalPoint_of_weightedX_sub_weightedC_mem_supp v _ _ hmem _⟩
  · rintro ⟨x, a, ha, rfl⟩ h
    exact ne_classicalPoint_of_supp_eq_bot _ h x a ha rfl

end TauCeti.ValuationSpectrum
