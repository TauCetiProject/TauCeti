/-!
# Adic homomorphisms and the analytic locus

**Wedhorn, *Adic Spaces* (arXiv:1910.05934v1), Lemma 7.46(2).**

Let `φ : A → B` be a continuous homomorphism of Huber rings carrying `A⁺` into `B⁺`, and write
`f = Spa(φ) : Spa(B, B⁺) → Spa(A, A⁺)`, which on points is `ValuationSpectrum.comap φ`. Wedhorn's
Lemma 7.46 states that

1. `f` maps non-analytic points to non-analytic points, and if `φ` is adic it also maps analytic
   points to analytic points;
2. if `B` is complete and `f` maps analytic points to analytic points, then `φ` is adic.

Part (1) is in `TauCeti/AlgebraicGeometry/AdicSpace/Spa/Analytic.lean`; this file proves part (2).
So over a complete target, adicness of `φ` is detected on the adic spectrum. This is the affinoid
input to the notion of an adic morphism of adic spaces, which asks exactly that analytic points
go to analytic points.

Part (2) rests on a description of the open ideals of a complete Huber pair by its analytic
points: an ideal `𝔞` is open exactly when no analytic point of `Spa(B, B⁺)` has its support
containing `𝔞`.

## Main results

* `TauCeti.ValuationSpectrum.isOpen_iff_forall_mem_spaAnalytic_not_le_supp` : over a complete
  Huber ring, an ideal is open exactly when it lies in the support of no analytic point.
* `TauCeti.ValuationSpectrum.isAdicHom_iff_forall_isAnalyticPoint_comap` : **Lemma 7.46**, over
  a complete target a continuous homomorphism is adic exactly when pullback preserves analytic
  points of `Spa(B, B⁺)`.
* `TauCeti.ValuationSpectrum.isAdicHom_of_mapsTo_spaAnalytic` : **Lemma 7.46(2)**, in the form
  `f(Spa(B, B⁺)ᵃ) ⊆ Spa(A, A⁺)ᵃ`.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Lemmas 7.45 and 7.46.
* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217
  (1994), Proposition 3.2.

## Provenance

Developed here; no external formalization is followed. Wedhorn derives Lemma 7.46(2) from his
Lemma 7.45; the openness criterion here instead reuses the coarsening construction behind
Proposition 7.18(1) in `TauCeti/RingTheory/Huber/Continuous/ValuativeCriterion.lean`.
-/

public section

namespace TauCeti.ValuationSpectrum

open TauCeti TauCeti.Huber

section Complete

variable {B : Type*} [CommRing B] [UniformSpace B] [T2Space B] [CompleteSpace B]
  [IsTopologicalRing B] [IsUniformAddGroup B] [IsHuberRing B]

/-- In the complete ring `B`, an element of the ideal of `B⁺` generated by an ideal of definition
inside `B⁺` never lies in a prime ideal together with `1` minus it: such an element is
topologically nilpotent, so `1` minus it is a unit. -/
private theorem one_sub_notMem_of_mem_map_idealOfDefinition {Bplus : Subring B}
    (hle : Bplus ≤ powerBoundedSubring B) {Q : PairOfDefinition B}
    (hQ : Q.ringOfDefinition ≤ Bplus) (𝔭 : Ideal B) [𝔭.IsPrime] {y : Bplus}
    (hy : y ∈ Q.idealOfDefinition.map (Subring.inclusion hQ)) : 1 - (y : B) ∉ 𝔭 := by
  have hJ : Q.idealOfDefinition.map (Subring.inclusion hQ) ≤
      (topologicallyNilpotentIdeal B).comap (Subring.inclusion hle) :=
    Ideal.map_le_iff_le_comap.mpr fun s hs ↦
      mem_topologicallyNilpotentIdeal.mpr (Q.isTopologicallyNilpotent_of_mem_idealOfDefinition hs)
  have hnil : IsTopologicallyNilpotent (y : B) := mem_topologicallyNilpotentIdeal.mp (hJ hy)
  exact fun hmem ↦ (inferInstance : 𝔭.IsPrime).ne_top (Ideal.eq_top_of_isUnit_mem _ hmem
    hnil.isUnit_one_sub)

/-- **A valuation subring adapted to `B⁺` and an ideal of definition, modulo a prime.** Let `B` be
complete, `B⁺ ⊆ B°` a subring containing the ring of definition of `Q`, and `𝔭` a prime ideal.
Writing `g : B → Frac(B ⧸ 𝔭)` for the canonical map, some valuation subring of the fraction field
contains `g(B⁺)` and has valuation `< 1` on `g` of the ideal of definition. -/
private theorem exists_valuationSubring_of_isPrime {Bplus : Subring B}
    (hle : Bplus ≤ powerBoundedSubring B) {Q : PairOfDefinition B}
    (hQ : Q.ringOfDefinition ≤ Bplus) (𝔭 : Ideal B) [𝔭.IsPrime] :
    ∃ V : ValuationSubring (FractionRing (B ⧸ 𝔭)),
      (∀ b ∈ Bplus, algebraMap (B ⧸ 𝔭) _ (Ideal.Quotient.mk 𝔭 b) ∈ V) ∧
        ∀ s ∈ Q.idealOfDefinition,
          V.valuation (algebraMap (B ⧸ 𝔭) _ (Ideal.Quotient.mk 𝔭 (s : B))) < 1 := by
  set g : B →+* FractionRing (B ⧸ 𝔭) := (algebraMap (B ⧸ 𝔭) _).comp (Ideal.Quotient.mk 𝔭)
  set gp : Bplus →+* Bplus.map g :=
    (g.comp Bplus.subtype).codRestrict _ fun b ↦ Subring.mem_map.mpr ⟨b, b.2, rfl⟩
  have hgp : Function.Surjective gp := by
    rintro ⟨x, hx⟩
    obtain ⟨b, hb, rfl⟩ := Subring.mem_map.mp hx
    exact ⟨⟨b, hb⟩, rfl⟩
  set J : Ideal Bplus := Q.idealOfDefinition.map (Subring.inclusion hQ)
  -- the image of `J` is proper: otherwise `1 - y ∈ 𝔭` for some `y ∈ J`
  have hJ : J.map gp ≠ ⊤ := by
    intro htop
    obtain ⟨y, hy, hgy⟩ := (Ideal.mem_map_iff_of_surjective gp hgp).mp
      (htop ▸ Submodule.mem_top : (1 : Bplus.map g) ∈ J.map gp)
    refine one_sub_notMem_of_mem_map_idealOfDefinition hle hQ 𝔭 hy ?_
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← (IsFractionRing.injective (B ⧸ 𝔭)
      (FractionRing (B ⧸ 𝔭))).eq_iff, map_zero]
    have hgy' : algebraMap (B ⧸ 𝔭) (FractionRing (B ⧸ 𝔭)) (Ideal.Quotient.mk 𝔭 (y : B)) = 1 :=
      congrArg Subtype.val hgy
    simp only [map_sub, map_one, hgy', sub_self]
  obtain ⟨V, hV, hnon⟩ := Ideal.image_subset_nonunits_valuationSubring _ hJ
  refine ⟨V, fun b hb ↦ hV (Subring.mem_map.mpr ⟨b, hb, rfl⟩), fun s hs ↦ ?_⟩
  refine (ValuationSubring.mem_nonunits_iff V).mp (hnon ⟨gp (Subring.inclusion hQ s), ?_, rfl⟩)
  exact Ideal.mem_map_of_mem gp (Ideal.mem_map_of_mem _ hs)

/-- **An analytic point supported above a prime that misses the ideal of definition.** Let `B` be
complete, `B⁺ ⊆ B°` a subring containing the ring of definition of `Q`, and `𝔭` a prime
ideal not containing some element `t` of the ideal of definition. Then some analytic point of
`Spa(B, B⁺)` has support containing `𝔭`. -/
private theorem exists_mem_spaAnalytic_le_supp_of_notMem {Bplus : Subring B}
    (hle : Bplus ≤ powerBoundedSubring B) {Q : PairOfDefinition B}
    (hQ : Q.ringOfDefinition ≤ Bplus) (𝔭 : Ideal B) [𝔭.IsPrime] {t : Q.ringOfDefinition}
    (ht : t ∈ Q.idealOfDefinition) (ht𝔭 : (t : B) ∉ 𝔭) :
    ∃ v ∈ spaAnalytic Bplus, 𝔭 ≤ v.supp := by
  classical
  set mk := Ideal.Quotient.mk 𝔭
  set ι := algebraMap (B ⧸ 𝔭) (FractionRing (B ⧸ 𝔭))
  obtain ⟨V, hBV, hIV⟩ := exists_valuationSubring_of_isPrime hle hQ 𝔭
  -- the image pair of definition, and the valuation on its ring of definition
  set Q' : PairOfDefinition (B ⧸ 𝔭) := Q.map mk (QuotientRing.isOpenQuotientMap_mk 𝔭)
  set f₀ : Q.ringOfDefinition →+* Q'.ringOfDefinition :=
    (mk.comp Q.ringOfDefinition.subtype).codRestrict Q'.ringOfDefinition fun a ↦
      Q.map_ringOfDefinition mk _ ▸ Subring.mem_map.mpr ⟨a, a.2, rfl⟩
  have hf₀ : Function.Surjective f₀ := by
    rintro ⟨x, hx⟩
    obtain ⟨a, ha, rfl⟩ := Subring.mem_map.mp (Q.map_ringOfDefinition mk _ ▸ hx)
    exact ⟨⟨a, ha⟩, rfl⟩
  have hI' : Q'.idealOfDefinition = Q.idealOfDefinition.map f₀ :=
    Q.map_idealOfDefinition mk _
  set w₀ : Valuation (B ⧸ 𝔭) V.ValueGroup := V.valuation.comap ι
  set v₀ : Valuation Q'.ringOfDefinition V.ValueGroup := w₀.comap Q'.ringOfDefinition.subtype
  have hv₀le : ∀ a : Q'.ringOfDefinition, v₀ a ≤ 1 := fun a ↦ by
    obtain ⟨b, rfl⟩ := hf₀ a
    exact (V.valuation_le_one_iff _).mpr (hBV _ (hQ b.2))
  have hv₀lt : ∀ s ∈ Q'.idealOfDefinition, v₀ s < 1 := fun s hs ↦ by
    rw [hI'] at hs
    obtain ⟨s', hs', rfl⟩ := (Ideal.mem_map_iff_of_surjective f₀ hf₀).mp hs
    exact hIV s' hs'
  -- some generator of the image ideal of definition has nonzero value, since `t ∉ 𝔭`
  obtain ⟨S, hS⟩ := Q'.fg_idealOfDefinition
  have hSI : ∀ s ∈ S, s ∈ Q'.idealOfDefinition := fun s hs ↦ hS ▸ Ideal.subset_span hs
  obtain ⟨s₁, hs₁S, hs₁⟩ : ∃ s ∈ S, v₀ s ≠ 0 := by
    by_contra! h
    have hsupp : Q'.idealOfDefinition ≤ v₀.supp := by
      rw [← hS, Ideal.span_le]
      exact fun s hs ↦ (Valuation.mem_supp_iff v₀ s).mpr (h s hs)
    have hzero : v₀ (f₀ t) = 0 :=
      (Valuation.mem_supp_iff v₀ _).mp (hsupp (hI' ▸ Ideal.mem_map_of_mem f₀ ht))
    -- `v₀ (f₀ t)` is by definition the value of `V` at the image of `t` in the fraction field
    have hι : ι (mk t) = 0 := V.valuation.zero_iff.mp hzero
    exact ht𝔭 (Ideal.Quotient.eq_zero_iff_mem.mp
      ((map_eq_zero_iff ι (IsFractionRing.injective (B ⧸ 𝔭) _)).mp hι))
  obtain ⟨t₀, ht₀S, ht₀max⟩ := S.exists_max_image v₀ ⟨s₁, hs₁S⟩
  -- coarsen along the dominating generator `t₀` and extend to a continuous point of `B ⧸ 𝔭`
  obtain ⟨w, hwc, ht₀w, hcmp⟩ := Q'.exists_continuous_coarsened_extension_of_valuation v₀ hv₀le hS
    (hSI t₀ ht₀S) (fun s hs ↦ ht₀max s hs) (hv₀lt t₀ (hSI t₀ ht₀S))
    (lt_of_lt_of_le (zero_lt_iff.mpr hs₁) (ht₀max s₁ hs₁S)).ne'
  have hwan : IsAnalyticPoint w :=
    (isAnalyticPoint_iff_exists_mem_extendedIdealOfDefinition_notMem_supp Q' w).mpr
      ⟨t₀, by rw [Q'.extendedIdealOfDefinition_def]; exact Ideal.mem_map_of_mem _ (hSI t₀ ht₀S),
        ht₀w⟩
  refine ⟨comap mk w, (mem_spaAnalytic_iff _ _).mpr
    ⟨(mem_spa_iff _ _).mpr ⟨hwc.comap continuous_quotient_mk', fun b hb ↦ ?_⟩,
      hwan.comap (IsAdicHom.of_isOpenQuotientMap (QuotientRing.isOpenQuotientMap_mk 𝔭))⟩,
    self_le_supp_comap 𝔭 w⟩
  rw [comap_vle, map_one]
  exact (hcmp w₀ (fun _ ↦ rfl) (mk b)).mpr ((V.valuation_le_one_iff _).mpr (hBV b hb))

/-- **Open ideals of a complete Huber pair, by analytic points.** Let `B` be a complete Huber ring
and `B⁺ ⊆ B°` a subring. An ideal `𝔞` of `B` is open exactly when no analytic point of
`Spa(B, B⁺)` has support containing `𝔞`. -/
theorem isOpen_iff_forall_mem_spaAnalytic_not_le_supp {Bplus : Subring B}
    (hle : Bplus ≤ powerBoundedSubring B) (𝔞 : Ideal B) :
    IsOpen (𝔞 : Set B) ↔ ∀ v ∈ spaAnalytic Bplus, ¬ 𝔞 ≤ v.supp := by
  -- An open prime ideal is the support of no analytic point. Conversely, if `𝔞` is not open,
  -- some element `t` of an ideal of definition lies outside a prime `𝔭 ⊇ 𝔞`; enlarging `B⁺` by
  -- the ring of definition, a valuation subring of `Frac(B ⧸ 𝔭)` bounded on `B⁺` and `< 1` on the
  -- ideal of definition exists because `1 - y` is a unit of the complete ring `B` for every `y`
  -- in the ideal it generates. Coarsening it along the generator of largest value
  -- (`PairOfDefinition.exists_continuous_coarsened_extension_of_valuation`) gives an analytic
  -- point of `Spa(B, B⁺)` supported on a prime containing `𝔭`.
  refine ⟨fun h𝔞 v hv h𝔞v ↦ (isAnalyticPoint_def v).mp ((mem_spaAnalytic_iff _ _).mp hv).2
    (Submodule.isOpen_mono h𝔞v h𝔞), fun h ↦ ?_⟩
  by_contra h𝔞
  obtain ⟨Q⟩ := IsHuberRing.nonempty_pairOfDefinition (A := B)
  rw [Q.isOpen_iff_le_radical, Q.extendedIdealOfDefinition_def, Ideal.map_le_iff_le_comap,
    IsConcreteLE.not_le_iff_exists] at h𝔞
  obtain ⟨t, ht, ht𝔞⟩ := h𝔞
  rw [Ideal.mem_comap, Ideal.radical_eq_sInf, Submodule.mem_sInf] at ht𝔞
  push Not at ht𝔞
  obtain ⟨𝔭, ⟨h𝔞𝔭, h𝔭⟩, ht𝔭⟩ := ht𝔞
  -- enlarge `B⁺` by the ring of definition; this only shrinks the analytic locus
  obtain ⟨v, hv, h𝔭v⟩ := exists_mem_spaAnalytic_le_supp_of_notMem
    (sup_le hle Q.le_powerBoundedSubring) le_sup_right 𝔭 ht ht𝔭
  exact h v (spaAnalytic_antitone le_sup_left hv) (h𝔞𝔭.trans h𝔭v)

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]

/-- **Wedhorn Lemma 7.46.** Let `φ : A → B` be a continuous homomorphism of Huber rings with `B`
complete, and `B⁺ ⊆ B°` a subring. Then `φ` is adic exactly when the pullback of every
analytic point of `Spa(B, B⁺)` is analytic.

No plus ring of `A` enters: whether a pulled-back point is analytic does not depend on one. -/
theorem isAdicHom_iff_forall_isAnalyticPoint_comap {φ : A →+* B} (hφ : Continuous φ)
    {Bplus : Subring B} (hle : Bplus ≤ powerBoundedSubring B) :
    IsAdicHom φ ↔ ∀ v ∈ spaAnalytic Bplus, IsAnalyticPoint (comap φ v) := by
  refine ⟨fun hadic v hv ↦ ((mem_spaAnalytic_iff _ _).mp hv).2.comap hadic, fun h ↦ ?_⟩
  refine IsAdicHom.of_continuous_isOpen_map hφ fun I hI ↦ ?_
  refine (isOpen_iff_forall_mem_spaAnalytic_not_le_supp hle _).mpr fun v hv hIv ↦
    (isAnalyticPoint_def _).mp (h v hv) ?_
  rw [supp_comap]
  exact Submodule.isOpen_mono (Ideal.map_le_iff_le_comap.mp hIv) hI

/-- **Wedhorn Lemma 7.46(2).** Let `φ : A → B` be a continuous homomorphism of Huber rings with
`B` complete, and `B⁺ ⊆ B°` a subring. If `Spa(φ)` maps the analytic points of `Spa(B, B⁺)`
to analytic points of `Spa(A, A⁺)`, then `φ` is adic. -/
theorem isAdicHom_of_mapsTo_spaAnalytic {φ : A →+* B} (hφ : Continuous φ) {Aplus : Subring A}
    {Bplus : Subring B} (hle : Bplus ≤ powerBoundedSubring B)
    (h : Set.MapsTo (comap φ) (spaAnalytic Bplus) (spaAnalytic Aplus)) : IsAdicHom φ :=
  (isAdicHom_iff_forall_isAnalyticPoint_comap hφ hle).mpr fun _ hv ↦
    ((mem_spaAnalytic_iff _ _).mp (h hv)).2

end Complete

end TauCeti.ValuationSpectrum
