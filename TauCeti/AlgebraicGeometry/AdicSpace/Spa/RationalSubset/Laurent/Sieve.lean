module

public import TauCeti.AlgebraicGeometry.AdicSpace.Spa.RationalSubset.Laurent.Basic
public import TauCeti.AlgebraicGeometry.AdicSpace.Spa.StructurePresheaf.LaurentCover.Basic
public import Mathlib.CategoryTheory.Sites.Sieves.Basic

/-!
# The sieve of a finite Laurent cover

For a finite set `T ⊆ A` and an open `W` of `Spa(A, A⁺)`, `laurentSieve Aplus T W`
consists of the opens inside a piece of the Laurent cover of `W` generated by `T`.
The membership, empty-cover, pullback, and insert lemmas describe this sieve independently
of the sheaf condition.
-/

public section

open CategoryTheory TopologicalSpace TauCeti.Huber

namespace TauCeti.ValuationSpectrum

/-! ### The Laurent sieve -/

section Sieve

variable {A : Type*} [CommRing A] [UniformSpace A] (Aplus : Subring A)

/-- **The sieve of the Laurent cover** of an open `W ⊆ Spa(A, A⁺)` generated by a finite set `T`:
the opens `V ≤ W` on which every `t ∈ T` has a fixed sign, `V ≤ {|t| ≤ 1}` or `V ≤ {|t| ≥ 1}`
(`laurentCoverOpen Aplus t true` and `laurentCoverOpen Aplus t false`). Equivalently, these are
the opens `V ≤ W` contained in one of the pieces `laurentPiece Aplus (↑) J`, `J ⊆ T`, of the
Laurent cover (`laurentSieve_apply_iff_exists_laurentPiece`). -/
def laurentSieve (T : Finset A) (W : Opens ↥(spa Aplus)) : Sieve W where
  arrows V _ := ∀ t ∈ T, ∃ b, V ≤ laurentCoverOpen Aplus t b
  downward_closed hV g t ht := (hV t ht).imp fun _ h ↦ g.le.trans h

variable {Aplus}

/-- Membership in the Laurent sieve. -/
@[simp]
theorem laurentSieve_apply {T : Finset A} {W V : Opens ↥(spa Aplus)} (g : V ⟶ W) :
    laurentSieve Aplus T W g ↔ ∀ t ∈ T, ∃ b, V ≤ laurentCoverOpen Aplus t b :=
  Iff.rfl

/-- **The Laurent sieve consists of the opens inside a piece of the Laurent cover**: an open
`V ≤ W` lies in `laurentSieve Aplus T W` exactly when it is contained in the piece
`laurentPiece Aplus (↑) J` for some set `J ⊆ T` of generators of sign `≥ 1`. -/
theorem laurentSieve_apply_iff_exists_laurentPiece {T : Finset A} {W V : Opens ↥(spa Aplus)}
    (g : V ⟶ W) : laurentSieve Aplus T W g ↔
      ∃ J : Set T, (V : Set ↥(spa Aplus)) ⊆ Subtype.val ⁻¹' laurentPiece Aplus (↑) J := by
  classical
  simp_rw [val_preimage_laurentPiece_eq_iInter, Set.subset_iInter_iff, laurentSieve_apply]
  constructor
  · intro h
    choose b hb using fun t : T ↦ h t t.2
    refine ⟨{t | b t = false}, fun t v hv ↦ ?_⟩
    have hv := mem_spaBasicOpen.mp (hb t hv)
    split_ifs with ht <;> simp_all
  · rintro ⟨J, hJ⟩ t ht
    refine ⟨decide (⟨t, ht⟩ ∉ J), fun v hv ↦ mem_spaBasicOpen.mpr ?_⟩
    have hv := hJ ⟨t, ht⟩ hv
    split_ifs at hv with htJ <;> simpa [htJ] using hv

/-- The Laurent cover generated by the empty set is the trivial cover. -/
@[simp]
theorem laurentSieve_empty (W : Opens ↥(spa Aplus)) : laurentSieve Aplus ∅ W = ⊤ := by
  ext
  simp

/-- The Laurent sieve of `W` restricts to the Laurent sieve of any `V ≤ W`. -/
@[simp]
theorem laurentSieve_pullback (T : Finset A) {W V : Opens ↥(spa Aplus)} (g : V ⟶ W) :
    (laurentSieve Aplus T W).pullback g = laurentSieve Aplus T V :=
  Sieve.ext fun _ _ ↦ Iff.rfl

/-- On an open where `a` has a fixed sign, adding `a` to the generators does not change the Laurent
sieve. -/
theorem laurentSieve_insert_of_le [DecidableEq A] {T : Finset A} {a : A}
    {V : Opens ↥(spa Aplus)} {b : Bool} (h : V ≤ laurentCoverOpen Aplus a b) :
    laurentSieve Aplus (insert a T) V = laurentSieve Aplus T V := by
  ext Z g
  simp only [laurentSieve_apply, Finset.forall_mem_insert, and_iff_right_iff_imp]
  exact fun _ ↦ ⟨b, g.le.trans h⟩

end Sieve

end TauCeti.ValuationSpectrum
