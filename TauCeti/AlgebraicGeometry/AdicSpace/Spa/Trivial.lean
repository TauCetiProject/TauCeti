module

public import TauCeti.AlgebraicGeometry.AdicSpace.RestrictToIdeal
public import TauCeti.AlgebraicGeometry.AdicSpace.Spa.RationalSubset.Laurent.Basic
public import TauCeti.AlgebraicGeometry.AdicSpace.Spa.Spectral

/-!
# The trivial points of `Spa(A, A⁺)`

A point of `Spa(A, A⁺)` is *trivial* if its valuation takes only the values `0` and `1`. A trivial
valuation is determined by its support, and it is continuous exactly when its support is open
(`trivialSection_mem_spa_iff`). So the subspace `X_triv` of trivial points is identified with the
set `Spf A` of open prime ideals of `A`, with the subspace topology of `Spec A`
(`spaTrivialHomeomorph`, which rests on Wedhorn's Remark 4.6(2), `isEmbedding_trivialSection`).

Over a Huber ring, `X_triv` is pro-constructible in `Spa(A, A⁺)`: the condition that the value of
`a` lies in `{0, 1}` is the union of the closed set `{x : x(a) = 0}` and the rational subset
`{x : x(a) = 1}`, and `X_triv` is the intersection of these conditions over all `a`. Hence `X_triv`
is spectral and its inclusion into `Spa(A, A⁺)` is a spectral map.

For the plus ring `A⁺ = A`, every value of a point `x` of `X = Spa(A, A)` is at most `1`, so the
characteristic subgroup `cΓ_x`, generated by the values at least `1`, is trivial. The restriction
`x|cΓ_x` (`restrictToIdeal` along the unit ideal) is then the trivial valuation with support
`{a : x(a) < 1}`. This gives Wedhorn's retraction `r : X → X_triv` (`spaTrivialRetraction`), and
`r` is spectral: the preimage of the basic open `D(s)` of `Spf A` is the rational subset
`{x : x(s) = 1}`.

The statements about `X_triv` and its spectrality hold for every plus ring `A⁺`; Wedhorn states
them for `Spa(A, A)` with `A` an adic ring with a finitely generated ideal of definition, where
`Spf A` is the closed subset `V(I)` of `Spec A`.

## Main definitions

* `TauCeti.ValuationSpectrum.spaTrivial`: the subspace `X_triv` of trivial points of
  `Spa(A, A⁺)`.
* `TauCeti.ValuationSpectrum.spaTrivialHomeomorph`: the homeomorphism from `Spf A`, the open primes
  of `A` with the topology of `Spec A`, onto `X_triv`.
* `TauCeti.ValuationSpectrum.spaTrivialRetraction`: Wedhorn's retraction
  `r : Spa(A, A) → X_triv`, `x ↦ x|cΓ_x`.

## Main results

* `TauCeti.ValuationSpectrum.isProConstructible_spaTrivial`: `X_triv` is pro-constructible in
  `Spa(A, A⁺)`; hence it is spectral (an instance) and its inclusion is spectral
  (`isSpectralMap_subtypeVal_spaTrivial`).
* `TauCeti.ValuationSpectrum.vle_spaTrivialRetraction_iff`: `r(x)` is the trivial valuation with
  support `{a : x(a) < 1}` (`mem_supp_spaTrivialRetraction_iff`).
* `TauCeti.ValuationSpectrum.spaTrivialRetraction_coe`: `r` fixes `X_triv` pointwise.
* `TauCeti.ValuationSpectrum.isSpectralMap_spaTrivialRetraction`: `r` is a spectral map.

## References

* T. Wedhorn, *Adic Spaces*, arXiv:1910.05934v1, Remark 4.6, Definition 4.13 (the characteristic
  subgroup), Example 7.59 and Remark 9.37.
* R. Huber, *Bewertungsspektrum und rigide Geometrie*, Regensburger Math. Schriften 23 (1993),
  (3.7.1), which Wedhorn cites for Example 7.59.
-/

public section

namespace TauCeti.ValuationSpectrum

open TauCeti Topology

variable {A : Type*} [CommRing A] [TopologicalSpace A]

/-! ### The trivial points -/

/-- **Wedhorn's `X_triv`**: the points of `Spa(A, A⁺)` represented by a trivial valuation, that is,
by a valuation with values in `{0, 1}`. -/
def spaTrivial (Aplus : Subring A) : Set (spa Aplus) :=
  Subtype.val ⁻¹' Set.range trivialSection

/-- A point of `Spa(A, A⁺)` is trivial when its valuation is in the image of `trivialSection`. -/
@[simp]
theorem mem_spaTrivial_iff {Aplus : Subring A} {x : spa Aplus} :
    x ∈ spaTrivial Aplus ↔ (x : Spv A) ∈ Set.range trivialSection :=
  Iff.rfl

/-- The support of a trivial point of `Spa(A, A⁺)` is open, since its trivial valuation is
continuous. -/
private theorem isOpen_supp_of_mem_spaTrivial {Aplus : Subring A} {x : spa Aplus}
    (hx : x ∈ spaTrivial Aplus) : IsOpen ((suppFun (x : Spv A)).asIdeal : Set A) := by
  obtain ⟨p, hp⟩ := hx
  rw [← hp, suppFun_trivialSection, ← trivialSection_mem_spa_iff Aplus, hp]
  exact x.2

/-- **Wedhorn's identification `X_triv = Spf A`**: the trivial points of `Spa(A, A⁺)` are, through
their supports, the open prime ideals of `A`, with the subspace topology of `Spec A`. The map
sends an open prime to its trivial valuation. -/
noncomputable def spaTrivialHomeomorph (Aplus : Subring A) :
    {p : PrimeSpectrum A // IsOpen (p.asIdeal : Set A)} ≃ₜ spaTrivial Aplus where
  toFun p := ⟨⟨trivialSection p, (trivialSection_mem_spa_iff Aplus p).mpr p.2⟩, p, rfl⟩
  invFun x := ⟨suppFun x, isOpen_supp_of_mem_spaTrivial x.2⟩
  left_inv p := Subtype.ext (suppFun_trivialSection p.1)
  right_inv x := by
    obtain ⟨p, hp⟩ := x.2
    exact Subtype.ext (Subtype.ext (by simp only [← hp, suppFun_trivialSection]))
  continuous_toFun :=
    ((continuous_trivialSection.comp continuous_subtype_val).subtype_mk _).subtype_mk _
  continuous_invFun :=
    (continuous_suppFun.comp (continuous_subtype_val.comp continuous_subtype_val)).subtype_mk _

/-- `spaTrivialHomeomorph` sends an open prime to its trivial valuation. -/
@[simp]
theorem coe_spaTrivialHomeomorph_apply (Aplus : Subring A)
    (p : {p : PrimeSpectrum A // IsOpen (p.asIdeal : Set A)}) :
    ((spaTrivialHomeomorph Aplus p : spa Aplus) : Spv A) = trivialSection p :=
  (rfl)

/-- The inverse of `spaTrivialHomeomorph` sends a trivial point to its support. -/
@[simp]
theorem coe_spaTrivialHomeomorph_symm_apply (Aplus : Subring A) (x : spaTrivial Aplus) :
    ((spaTrivialHomeomorph Aplus).symm x : PrimeSpectrum A) = suppFun x :=
  (rfl)

section Huber

variable [IsTopologicalRing A] [Huber.IsHuberRing A]

/-- **Wedhorn, Example 7.59**: the trivial points form a pro-constructible subset of
`Spa(A, A⁺)`. A point is trivial when, for every `a`, either `x(a) = 0`, a closed condition, or
`x(a) = 1`, which cuts out the rational subset `R({1}/a) ∩ R({a, 1}/1)`. -/
theorem isProConstructible_spaTrivial (Aplus : Subring A) :
    IsProConstructible (spaTrivial Aplus) := by
  have heq : spaTrivial Aplus = ⋂ a : A, ((Subtype.val ⁻¹' basicOpen a a)ᶜ ∪
      Subtype.val ⁻¹' laurentPiece Aplus (fun _ : Bool ↦ a) {true}) := by
    ext x
    simp only [mem_spaTrivial_iff, mem_range_trivialSection_iff, Set.mem_iInter, Set.mem_union,
      Set.mem_compl_iff, Set.mem_preimage, basicOpen_self, Set.mem_ofPred_eq, not_not,
      mem_laurentPiece_iff, x.2, true_and, Bool.forall_bool, Set.mem_singleton_iff,
      Bool.false_eq_true, IsEmpty.forall_iff, not_true_eq_false,
      not_false_eq_true, forall_const, and_true]
    exact forall_congr' fun a ↦ or_congr_right and_comm
  rw [heq]
  refine IsProConstructible.iInter fun a ↦ IsProConstructible.union ?_ ?_
  · exact ((isOpen_basicOpen a a).preimage continuous_subtype_val).isClosed_compl.isProConstructible
  · have hmem := val_preimage_laurentPiece_mem_spaRationalFamily Aplus (fun _ : Bool ↦ a) {true}
    exact (isCompact_of_mem_spaRationalFamily hmem).isProConstructible
      ((isTopologicalBasis_spaRationalFamily Aplus).isOpen hmem)

/-- **Wedhorn, Example 7.59**: the subspace of trivial points of `Spa(A, A⁺)` is spectral. -/
instance (Aplus : Subring A) : SpectralSpace ↥(spaTrivial Aplus) :=
  (isProConstructible_spaTrivial Aplus).spectralSpace

/-- **Wedhorn, Example 7.59**: the inclusion of the trivial points into `Spa(A, A⁺)` is a spectral
map. -/
theorem isSpectralMap_subtypeVal_spaTrivial (Aplus : Subring A) :
    IsSpectralMap ((↑) : spaTrivial Aplus → spa Aplus) :=
  (isProConstructible_spaTrivial Aplus).isSpectralMap_subtypeVal

end Huber

/-! ### The retraction of `Spa(A, A)` onto its trivial points -/

omit [TopologicalSpace A] in
/-- A point of `Spv(A, A)` whose values are all at most `1` is trivial. Its characteristic group
is everything, so each nonzero value lies between `g⁻¹` and `g` for an attained value `1 ≤ g`;
since `g ≤ 1` as well, `g = 1` and the value is `1`. -/
private theorem mem_range_trivialSection_of_mem_spvOfIdeal_top {v : Spv A}
    {hfg : ∃ J : Ideal A, J.FG ∧ (⊤ : Ideal A).radical = J.radical} (hv : v ∈ spvOfIdeal ⊤ hfg)
    (h1 : ∀ a : A, v.toValuativeRel.vle a 1) : v ∈ Set.range trivialSection := by
  have hfull := Valuation.hasFullCharacteristicGroup_iff_characteristicSubgroup_eq_top.mpr
    (mem_spvOfIdeal_top_iff.mp hv)
  refine (mem_range_trivialSection_iff v).mpr fun a ↦ ?_
  simp only [← valuation_le_iff, map_zero, map_one] at h1 ⊢
  rcases eq_or_ne (v.valuation a) 0 with h0 | h0
  · exact Or.inl h0.le
  refine Or.inr ⟨?_, h1 a⟩
  have hpos : 0 < v.valuation.restrict a := zero_lt_iff.mpr fun h ↦
    h0 (v.valuation.restrict_eq_zero_iff.mp h)
  obtain ⟨b, hinv, hle⟩ := Valuation.hasFullCharacteristicGroup_iff.mp hfull _ hpos
  have hb : v.valuation.restrict b ≤ 1 := by
    simpa using v.valuation.restrict_le_iff.mpr ((h1 b).trans_eq (map_one v.valuation).symm)
  have ha : v.valuation.restrict 1 ≤ v.valuation.restrict a := by
    rw [map_one]
    exact ((one_le_inv₀ (hpos.trans_le hle)).mpr hb).trans hinv
  simpa using v.valuation.restrict_le_iff.mp ha

/-- The restriction `x|cΓ_x` of a point of `Spa(A, A)` to its characteristic subgroup is a trivial
valuation. -/
private theorem restrictToIdeal_top_mem_range_trivialSection {x : Spv A}
    (hx : x ∈ spa (⊤ : Subring A)) (hfg : ∃ J : Ideal A, J.FG ∧ (⊤ : Ideal A).radical = J.radical) :
    restrictToIdeal x ⊤ hfg ∈ Set.range trivialSection :=
  mem_range_trivialSection_of_mem_spvOfIdeal_top (restrictToIdeal_mem_spvOfIdeal x ⊤ hfg)
    fun a ↦ by
      simpa only [← valuation_le_iff, map_one] using
        valuation_le_one_of_mem_spa (restrictToIdeal_mem_spa hx ⊤ hfg) (Subring.mem_top a)

/-- **Wedhorn's retraction `r : Spa(A, A) → X_triv`** (Example 7.59), `x ↦ x|cΓ_x`: the
restriction of a point to its characteristic subgroup, which is `restrictToIdeal` along the unit
ideal. On `Spa(A, A)` it is the trivial valuation with support `{a : x(a) < 1}`
(`vle_spaTrivialRetraction_iff`). -/
noncomputable def spaTrivialRetraction (x : spa (⊤ : Subring A)) : spaTrivial (⊤ : Subring A) :=
  ⟨⟨restrictToIdeal x ⊤ ⟨⊤, Ideal.fg_top A, rfl⟩,
    restrictToIdeal_mem_spa x.2 ⊤ ⟨⊤, Ideal.fg_top A, rfl⟩⟩,
    restrictToIdeal_top_mem_range_trivialSection x.2 ⟨⊤, Ideal.fg_top A, rfl⟩⟩

/-- `r(x)` is the point `restrictToIdeal x ⊤` of `Spv A`. -/
theorem coe_spaTrivialRetraction (x : spa (⊤ : Subring A)) :
    ((spaTrivialRetraction x : spa (⊤ : Subring A)) : Spv A) =
      restrictToIdeal x ⊤ ⟨⊤, Ideal.fg_top A, rfl⟩ :=
  (rfl)

/-- The restricted valuation `x|cΓ_x` on `Spa(A, A)` vanishes exactly where `x(a) < 1`: values at
least `1` survive the restriction, and a surviving value of a trivial valuation is `1`. -/
private theorem restrictToIdeal_top_eq_zero_iff {x : Spv A} (hx : x ∈ spa (⊤ : Subring A))
    (hfg : ∃ J : Ideal A, J.FG ∧ (⊤ : Ideal A).radical = J.radical) (a : A) :
    x.valuation.restrictToIdeal ⊤ hfg a = 0 ↔ ¬ x.toValuativeRel.vle 1 a := by
  have hone {c : A} (hc : x.toValuativeRel.vle 1 c) : 1 ≤ x.valuation.restrictToIdeal ⊤ hfg c :=
    Valuation.one_le_restrictToIdeal _ ⊤ hfg <| by
      simpa using x.valuation.restrict_le_iff.mpr ((valuation_le_iff x 1 c).mpr hc)
  refine ⟨fun h hc ↦ (zero_lt_one.trans_le (hone hc)).ne' h, fun hc ↦ by_contra fun h ↦ hc ?_⟩
  -- `x|cΓ_x` is trivial and nonzero at `a`, so it compares `1 ≤ a`, which it inherits from `x`
  obtain hr | ⟨hr, -⟩ :=
    (mem_range_trivialSection_iff _).mp (restrictToIdeal_top_mem_range_trivialSection hx hfg) a
  · exact absurd (by simpa using (vle_restrictToIdeal x ⊤ hfg a 0).mp hr) h
  · obtain h1 | ⟨-, h1⟩ := (vle_restrictToIdeal x ⊤ hfg 1 a).mp hr
    · exact absurd h1 (zero_lt_one.trans_le (hone (x.toValuativeRel.vle_refl 1))).ne'
    · exact h1

/-- **The retraction, explicitly**: `r(x)(a) ≤ r(x)(b)` exactly when `x(a) < 1` or `x(b) = 1`. So
`r(x)` is the trivial valuation whose support is `{a : x(a) < 1}`. -/
@[simp]
theorem vle_spaTrivialRetraction_iff (x : spa (⊤ : Subring A)) (a b : A) :
    ((spaTrivialRetraction x : spa (⊤ : Subring A)) : Spv A).toValuativeRel.vle a b ↔
      ¬ (x : Spv A).toValuativeRel.vle 1 a ∨ (x : Spv A).toValuativeRel.vle 1 b := by
  have ha1 : (x : Spv A).toValuativeRel.vle a 1 := by
    simpa only [← valuation_le_iff, map_one] using
      valuation_le_one_of_mem_spa x.2 (Subring.mem_top a)
  rw [coe_spaTrivialRetraction, vle_restrictToIdeal, ne_eq, restrictToIdeal_top_eq_zero_iff x.2,
    restrictToIdeal_top_eq_zero_iff x.2, not_not]
  exact or_congr_right ⟨fun h ↦ h.1, fun h ↦ ⟨h, x.1.toValuativeRel.vle_trans ha1 h⟩⟩

/-- **The support of `r(x)`** is `{a : x(a) < 1}`. -/
theorem mem_supp_spaTrivialRetraction_iff (x : spa (⊤ : Subring A)) (a : A) :
    a ∈ ((spaTrivialRetraction x : spa (⊤ : Subring A)) : Spv A).supp ↔
      ¬ (x : Spv A).toValuativeRel.vle 1 a := by
  simp [x.1.toValuativeRel.not_vle_one_zero]

/-- **`r` is a retraction**: it fixes every trivial point. -/
@[simp]
theorem spaTrivialRetraction_coe (y : spaTrivial (⊤ : Subring A)) :
    spaTrivialRetraction (y : spa (⊤ : Subring A)) = y := by
  obtain ⟨⟨v, hv⟩, p, hp⟩ := y
  obtain rfl : trivialSection p = v := hp
  have h1 : (1 : A) ∉ p.asIdeal := (Ideal.ne_top_iff_one _).mp p.isPrime.ne_top
  refine Subtype.ext (Subtype.ext (ext' fun a b ↦ ?_))
  simp only [vle_spaTrivialRetraction_iff, trivialSection_vle_iff, h1, false_or]
  tauto

/-- **`r` is continuous**: the preimage of the basic open `Spv(A)(f/s)` is the rational subset
`R({1}/s) = {x : x(s) = 1}`. -/
theorem continuous_spaTrivialRetraction :
    Continuous (spaTrivialRetraction (A := A)) := by
  refine (Continuous.subtype_mk ?_ _).subtype_mk _
  refine continuous_generateFrom_iff.mpr fun _ ⟨f, s, hU⟩ ↦ ?_
  have hpre : (fun x : spa (⊤ : Subring A) ↦
      ((spaTrivialRetraction x : spa (⊤ : Subring A)) : Spv A)) ⁻¹' basicOpen f s =
        Subtype.val ⁻¹' rationalSubset ⊤ {1} s := by
    ext x
    simp only [Set.mem_preimage, mem_basicOpen_iff, vle_spaTrivialRetraction_iff,
      x.1.toValuativeRel.not_vle_one_zero, or_false, not_not,
      mem_rationalSubset_singleton_one_iff x.2]
    exact ⟨And.right, fun h ↦ ⟨Or.inr h, h⟩⟩
  rw [hU]
  convert isOpen_val_preimage_rationalSubset (⊤ : Subring A) {1} s using 1
  exact hpre

/-- **Wedhorn, Example 7.59**: `r` is a spectral map. Through `Spf A ≃ X_triv`, the preimage of
the basic open `D(s)` of `Spf A` is the rational subset `R({1}/s)`, which is quasi-compact. -/
theorem isSpectralMap_spaTrivialRetraction [IsTopologicalRing A] [Huber.IsHuberRing A] :
    IsSpectralMap (spaTrivialRetraction (A := A)) := by
  let e := spaTrivialHomeomorph (⊤ : Subring A)
  have hr : spaTrivialRetraction (A := A) = e ∘ (e.symm ∘ spaTrivialRetraction) := by
    ext1 x
    simp
  rw [hr]
  refine e.isProperMap.isSpectralMap.comp (isSpectralMap_of_isTopologicalBasis
    (IsInducing.subtypeVal.isTopologicalBasis PrimeSpectrum.isTopologicalBasis_basic_opens)
    (e.symm.continuous.comp continuous_spaTrivialRetraction) ?_)
  rintro _ ⟨_, ⟨s, rfl⟩, rfl⟩
  have hpre : (e.symm ∘ spaTrivialRetraction) ⁻¹'
      (Subtype.val ⁻¹' (PrimeSpectrum.basicOpen s : Set (PrimeSpectrum A))) =
        Subtype.val ⁻¹' rationalSubset ⊤ {1} s := by
    ext x
    simp only [Set.mem_preimage, Function.comp_apply, e, coe_spaTrivialHomeomorph_symm_apply,
      SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, suppFun_asIdeal,
      mem_supp_spaTrivialRetraction_iff, not_not, mem_rationalSubset_singleton_one_iff x.2]
  have hopen : IsOpen (Ideal.span ((({1} : Finset A)) : Set A) : Set A) := by
    rw [(Ideal.eq_top_iff_one _).mpr (Ideal.subset_span (by simp))]
    exact isOpen_univ
  have hcomp := isCompact_of_mem_spaRationalFamily (Aplus := ⊤)
    (mem_spaRationalFamily_iff.mpr ⟨{1}, s, hopen, rfl⟩)
  rw [← hpre] at hcomp
  exact hcomp

end TauCeti.ValuationSpectrum
