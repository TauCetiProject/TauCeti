module

public import TauCeti.AlgebraicGeometry.AdicSpace.Spa.StructurePresheaf.StandardCover.Basic
public import TauCeti.AlgebraicGeometry.AdicSpace.Spa.StructurePresheaf.LaurentCover.FiniteTopology

/-!
# Continuous gluing for standard rational covers generated by units

On a rational open of the adic spectrum of a strongly noetherian Tate ring, the topology on
sections is induced by restriction to a standard rational cover generated by units. Compatible
continuous ring homomorphisms into the sections on the pieces therefore glue continuously.

The Laurent cover generated by all ratios of the generators refines the standard cover. Its
restriction maps factor continuously through those of the standard cover, so the inducing
property for Laurent covers implies the inducing property here. This supplies the unit-generated
case of the topological reduction from Laurent covers to rational covers. No completeness or
Hausdorffness assumption on the original ring is needed.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Lemma 8.34(iii) and
  Remark 8.20.
* S. Bosch, U. Güntzer, R. Remmert, *Non-Archimedean Analysis*, §8.2.2, Lemma 3.
-/

public section

open CategoryTheory TopologicalSpace Topology Opposite TauCeti.Huber

universe v

namespace TauCeti.ValuationSpectrum

variable {A : Type v} [CommRing A] [UniformSpace A] [IsTopologicalRing A] [IsTateRing A]
  [IsStronglyNoetherian A] (P : PairOfDefinition A) {Aplus : Subring A}

/-- Sections on a rational open carry the topology induced by restriction to the sieve of a
standard rational cover generated by a nonempty finite set of units. -/
theorem isInducing_presentationLimitPresheafMap_standardSieve_of_isUnit
    (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a) {T : Finset A} (hT : T.Nonempty)
    (hu : ∀ t ∈ T, IsUnit t) {W : Opens ↥(spa Aplus)} (hW : W ∈ spaRationalOpens Aplus) :
    let S := Sieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
      fun _ ↦ homOfLE inf_le_left
    IsInducing fun (x : (presentationLimitPresheaf P Aplus).obj (op W))
      (g : (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // S f }) ↦
        ((presentationLimitPresheaf P Aplus).map g.2.1.op).hom.1 x := by
  classical
  let F := presentationLimitPresheaf P Aplus
  let S := Sieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
    fun _ ↦ homOfLE inf_le_left
  let f : T × T → A := fun p ↦ (p.1 : A) * Ring.inverse (p.2 : A)
  let R : Finset A := Finset.univ.image f
  -- Each arrow of the refining Laurent sieve also belongs to the standard sieve.
  have hRS : laurentSieve Aplus R W ≤ S :=
    laurentSieve_mul_inverse_le_ofArrows_inf_spaBasicOpen hT hu W
  let j (g : (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // laurentSieve Aplus R W f }) :
      (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // S f } :=
    ⟨g.1, g.2.1, hRS g.2.1 g.2.2⟩
  -- Projection to the Laurent coordinates is continuous for the product topologies.
  let q := fun z : (g : (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // S f }) → F.obj (op g.1) ↦
    fun g ↦ z (j g)
  apply IsInducing.of_comp (g := q) (continuous_pi fun g ↦ (F.map g.2.1.op).hom.2)
    (continuous_pi fun g ↦ continuous_apply (j g))
  exact isInducing_presentationLimitPresheafMap_laurentSieve P hAplus R hW

/-- The presentation-limit presheaf of topological commutative rings satisfies the sheaf
condition for every standard rational cover of a rational open generated by units. Compatible
continuous ring homomorphisms from any topological commutative ring into sections on the pieces
glue to a unique continuous ring homomorphism into sections on the original open. -/
theorem isSheafFor_ofArrows_inf_spaBasicOpen_of_isUnit_topCommRingCat
    (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a) {T : Finset A} (hT : T.Nonempty)
    (hu : ∀ t ∈ T, IsUnit t) {W : Opens ↥(spa Aplus)} (hW : W ∈ spaRationalOpens Aplus)
    (E : _root_.TopCommRingCat.{v}) :
    (Presieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
      fun _ ↦ homOfLE inf_le_left).IsSheafFor
        (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι ⋙
          coyoneda.obj (op E)) := by
  rw [Presieve.isSheafFor_iff_generate]
  exact TopCommRingCat.isSheafFor_of_isSheafFor_forget
    (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι)
    (Sieve.ofArrows _ _)
    ((Presieve.isSheafFor_iff_generate _).mp
      (isSheafFor_ofArrows_inf_spaBasicOpen_of_isUnit P hAplus hT hu hW))
    (isInducing_presentationLimitPresheafMap_standardSieve_of_isUnit P hAplus hT hu hW) E

end TauCeti.ValuationSpectrum
