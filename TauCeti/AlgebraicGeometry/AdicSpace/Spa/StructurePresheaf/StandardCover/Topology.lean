variable {A : Type v} [CommRing A] [UniformSpace A] [IsTopologicalRing A] [IsTateRing A]
  (P : PairOfDefinition A) {Aplus : Subring A}
  {C : ∀ (A : Type v) [CommRing A] [UniformSpace A] [IsTopologicalRing A] [IsTateRing A], Prop}

/-- Over a Tate ring satisfying a predicate with `ContinuousLaurentGluing`, sections on a
rational open carry the topology induced by restriction to the sieve of a standard rational cover
generated by a nonempty finite set of units. -/
theorem isInducing_presentationLimitPresheafMap_standardSieve_of_isUnit
    (hC : ContinuousLaurentGluing C) (hA : C A) (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a)
    {T : Finset A} (hT : T.Nonempty)
    (hu : ∀ t ∈ T, IsUnit t) {W : Opens ↥(spa Aplus)} (hW : W ∈ spaRationalOpens Aplus) :
    let S := Sieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
      fun _ ↦ homOfLE inf_le_left
    IsInducing fun (x : (presentationLimitPresheaf P Aplus).obj (op W))
      (g : (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // S f }) ↦
        ((presentationLimitPresheaf P Aplus).map g.2.1.op).hom.1 x := by
  classical
  let F := presentationLimitPresheaf P Aplus
  let S := Sieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
    fun _ ↦ homOfLE inf_le_left
  let f : T × T → A := fun p ↦ (p.1 : A) * Ring.inverse (p.2 : A)
  let R : Finset A := Finset.univ.image f
  -- Each arrow of the refining Laurent sieve also belongs to the standard sieve.
  have hRS : laurentSieve Aplus R W ≤ S :=
    laurentSieve_mul_inverse_le_ofArrows_inf_spaBasicOpen hT hu W
  let j (g : (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // laurentSieve Aplus R W f }) :
      (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // S f } :=
    ⟨g.1, g.2.1, hRS g.2.1 g.2.2⟩
  -- Projection to the Laurent coordinates is continuous for the product topologies.
  let q := fun z : (g : (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // S f }) → F.obj (op g.1) ↦
    fun g ↦ z (j g)
  apply IsInducing.of_comp (g := q) (continuous_pi fun g ↦ (F.map g.2.1.op).hom.2)
    (continuous_pi fun g ↦ continuous_apply (j g))
  exact isInducing_presentationLimitPresheafMap_laurentSieve_of_isInducing P
    (hC.isInducing_inf_laurentCoverOpen P hA hAplus) R hW

/-- Over a Tate ring satisfying a predicate with `ContinuousLaurentGluing`, the presentation-limit
presheaf of topological commutative rings satisfies the sheaf condition for every standard rational
cover of a rational open generated by units. Compatible continuous ring homomorphisms from any
topological commutative ring into sections on the pieces glue to a unique continuous ring
homomorphism into sections on the original open. -/
theorem isSheafFor_ofArrows_inf_spaBasicOpen_of_isUnit_topCommRingCat
    (hC : ContinuousLaurentGluing C) (hA : C A) (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a)
    {T : Finset A} (hT : T.Nonempty)
    (hu : ∀ t ∈ T, IsUnit t) {W : Opens ↥(spa Aplus)} (hW : W ∈ spaRationalOpens Aplus)
    (E : _root_.TopCommRingCat.{v}) :
    (Presieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
      fun _ ↦ homOfLE inf_le_left).IsSheafFor
        (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι ⋙
          coyoneda.obj (op E)) := by
  rw [Presieve.isSheafFor_iff_generate]
  exact TopCommRingCat.isSheafFor_of_isSheafFor_forget
    (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι)
    (Sieve.ofArrows _ _)
    ((Presieve.isSheafFor_iff_generate _).mp
      (isSheafFor_ofArrows_inf_spaBasicOpen_of_isUnit_of_isSheafFor hT hu hW _ fun R _ hV ↦
        isSheafFor_laurentSieve_of_isSheafFor
          (hC.isSheafFor_ofArrows_inf_laurentCoverOpen P hA hAplus) R hV))
    (isInducing_presentationLimitPresheafMap_standardSieve_of_isUnit P hC hA hAplus hT hu hW) E

omit [IsTateRing A] in
/-- Restriction to opens `V i ≤ W` is inducing on sections of the presentation-limit presheaf as
soon as it is inducing on presentation limits. -/
theorem isInducing_restrictionMap_of_isInducing_presentationLimitMap {ι : Type*}
    {W : Opens ↥(spa Aplus)} {V : ι → Opens ↥(spa Aplus)} (h : ∀ i, V i ≤ W)
    (hl : IsInducing fun (x : presentationLimit (P := P) Aplus W) (i : ι) ↦
      (presentationLimitMap (P := P) (h i)).hom.1 x) :
    IsInducing fun (x : (presentationLimitPresheaf P Aplus).obj (op W)) (i : ι) ↦
      ((presentationLimitPresheaf P Aplus).map (homOfLE (h i)).op).hom.1 x := by
  let G := TopCommRingCat.isCompleteSeparated.ι ⋙ forget₂ _root_.TopCommRingCat TopCat
  let e (V : Opens ↥(spa Aplus)) :
      (presentationLimitPresheaf P Aplus).obj (op V) ≃ₜ presentationLimit (P := P) Aplus V :=
    TopCat.homeoOfIso (G.mapIso (eqToIso (presentationLimitPresheaf_obj P Aplus (op V))))
  have e_apply (V : Opens ↥(spa Aplus)) (x : (presentationLimitPresheaf P Aplus).obj (op V)) :
      e V x = (eqToHom (presentationLimitPresheaf_obj P Aplus (op V))).hom.1 x := rfl
  exact ((e W).isInducing_pi_iff_of_homeomorph (fun i ↦ e (V i)) fun x i ↦ by
    rw [e_apply, e_apply]
    exact eqToHom_apply_presentationLimitPresheaf_map_apply P (h i) x).mpr hl

section Completion

variable (U : Finset A) (s : A) (S : Type v) [CommRing S] [Algebra A S] [IsLocalization.Away s S]
  (hden : HasDenominatorPower P U s S)

/-- The pieces `R(U/s) ∩ R(T/t)` of a standard rational cover of `R(U/s)` are rational opens when
some generator becomes a unit in the completed coordinate ring `A⟨U/s⟩`. -/
private theorem inf_spaBasicOpen_mem_spaRationalOpens_of_isUnit
    (hP : P.ringOfDefinition ≤ Aplus) (hU : IsOpen (Ideal.span (U : Set A) : Set A))
    {T : Finset A} (hT : T.Nonempty)
    (hu : letI := locUniformSpace P U s S hden
      letI := isUniformAddGroup_locUniformSpace P U s S hden
      letI := isTopologicalRing_locUniformSpace P U s S hden
      ∀ t ∈ T, IsUnit (toCompletionLoc P U s S hden t)) (t : T) :
    spaBasicOpen Aplus U s ⊓ spaBasicOpen Aplus T t ∈ spaRationalOpens Aplus := by
  classical
  let _ := locUniformSpace P U s S hden
  have _ := isUniformAddGroup_locUniformSpace P U s S hden
  have _ := isTopologicalRing_locUniformSpace P U s S hden
  have _ := isTateRing_completion_locTopology_of_isTateRing P U s S hden
  obtain ⟨t₀, ht₀⟩ := hT
  rw [← spaComapLoc_functor_obj_locOpensComap P Aplus hP U s S hden inf_le_left]
  refine spaComapLoc_functor_obj_mem_spaRationalOpens P Aplus hP U s S hden hU _ ?_
  rw [locOpensComap_inf, locOpensComap_spaBasicOpen P Aplus U s S hden T]
  exact inf_mem_spaRationalOpens
    (locOpensComap_mem_spaRationalOpens P Aplus U s S hden (spaBasicOpen_mem_spaRationalOpens hU))
    (spaBasicOpen_mem_spaRationalOpens <| by
      rw [Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Finset.mem_image_of_mem _ ht₀))
        (hu t₀ ht₀)]
      exact isOpen_univ)

omit [IsTateRing A] in
open scoped Classical in
/-- Pulling back the standard cover of `R(U/s)` generated by `T` to the completed coordinate ring
`A⟨U/s⟩` gives the standard cover generated by the images of `T`. -/
private theorem ofArrows_locOpensComap_eq_ofArrows_image (T : Finset A) :
    letI := locUniformSpace P U s S hden
    letI := isUniformAddGroup_locUniformSpace P U s S hden
    letI := isTopologicalRing_locUniformSpace P U s S hden
    Sieve.ofArrows
      (fun t : T ↦ locOpensComap P Aplus U s S hden
        (spaBasicOpen Aplus U s ⊓ spaBasicOpen Aplus T t))
      (fun t ↦ homOfLE (locOpensComap_mono P Aplus U s S hden
        (inf_le_left : spaBasicOpen Aplus U s ⊓ spaBasicOpen Aplus T t ≤ _))) =
      Sieve.ofArrows
        (fun t : T.image (toCompletionLoc P U s S hden) ↦
          locOpensComap P Aplus U s S hden (spaBasicOpen Aplus U s) ⊓
            spaBasicOpen (completedPlusSubring P Aplus U s S hden)
              (T.image (toCompletionLoc P U s S hden)) t)
        (fun _ ↦ homOfLE inf_le_left) := by
  classical
  let _ := locUniformSpace P U s S hden
  have _ := isUniformAddGroup_locUniformSpace P U s S hden
  have _ := isTopologicalRing_locUniformSpace P U s S hden
  have hpull (t : T) : locOpensComap P Aplus U s S hden
      (spaBasicOpen Aplus U s ⊓ spaBasicOpen Aplus T t) =
        locOpensComap P Aplus U s S hden (spaBasicOpen Aplus U s) ⊓
          spaBasicOpen (completedPlusSubring P Aplus U s S hden)
            (T.image (toCompletionLoc P U s S hden)) (toCompletionLoc P U s S hden t) := by
    rw [locOpensComap_inf, locOpensComap_spaBasicOpen P Aplus U s S hden T]
  let a : T → T.image (toCompletionLoc P U s S hden) := fun t ↦
    ⟨toCompletionLoc P U s S hden t, Finset.mem_image_of_mem _ t.2⟩
  ext V g
  simp only [Sieve.mem_ofArrows_iff]
  constructor
  · rintro ⟨t, e, rfl⟩
    exact ⟨a t, e ≫ eqToHom (hpull t), Subsingleton.elim _ _⟩
  · rintro ⟨⟨_, hb⟩, e, rfl⟩
    obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hb
    exact ⟨⟨t, ht⟩, e ≫ eqToHom (hpull ⟨t, ht⟩).symm, Subsingleton.elim _ _⟩

omit [IsTateRing A] in
/-- Over the completed coordinate ring `A⟨U/s⟩`, restriction to the pullbacks of the generating
pieces of a standard cover of `R(U/s)` is inducing on presentation limits whenever it is inducing
on sections of the presheaf. This transports Wedhorn's Remark 8.4 along the isomorphisms
`presentationLimitLocIso`. -/
private theorem isInducing_presentationLimitMap_pieces_of_completion
    (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a)
    (hU : IsOpen (Ideal.span (U : Set A) : Set A)) {T : Finset A}
    (hrat : ∀ t : T, spaBasicOpen Aplus U s ⊓ spaBasicOpen Aplus T t ∈ spaRationalOpens Aplus)
    (hB : letI := locUniformSpace P U s S hden
      letI := isUniformAddGroup_locUniformSpace P U s S hden
      letI := isTopologicalRing_locUniformSpace P U s S hden
      IsInducing fun (x : (presentationLimitPresheaf (completionLocalization P U s S hden)
          (completedPlusSubring P Aplus U s S hden)).obj
          (op (locOpensComap P Aplus U s S hden (spaBasicOpen Aplus U s)))) (t : T) ↦
        ((presentationLimitPresheaf (completionLocalization P U s S hden)
          (completedPlusSubring P Aplus U s S hden)).map
          (homOfLE (locOpensComap_mono P Aplus U s S hden
            (inf_le_left : spaBasicOpen Aplus U s ⊓ spaBasicOpen Aplus T t ≤ _))).op).hom.1 x) :
    IsInducing fun (x : presentationLimit (P := P) Aplus (spaBasicOpen Aplus U s)) (t : T) ↦
      (presentationLimitMap (P := P)
        (inf_le_left : spaBasicOpen Aplus U s ⊓ spaBasicOpen Aplus T t ≤ _)).hom.1 x := by
  classical
  let _ := locUniformSpace P U s S hden
  have _ := isUniformAddGroup_locUniformSpace P U s S hden
  have _ := isTopologicalRing_locUniformSpace P U s S hden
  let FB := presentationLimitPresheaf (completionLocalization P U s S hden)
    (completedPlusSubring P Aplus U s S hden)
  let G := TopCommRingCat.isCompleteSeparated.ι ⋙ forget₂ _root_.TopCommRingCat TopCat
  let eB (V : Opens ↥(spa (completedPlusSubring P Aplus U s S hden))) :
      FB.obj (op V) ≃ₜ presentationLimit (P := completionLocalization P U s S hden)
        (completedPlusSubring P Aplus U s S hden) V :=
    TopCat.homeoOfIso (G.mapIso (eqToIso (presentationLimitPresheaf_obj
      (completionLocalization P U s S hden) (completedPlusSubring P Aplus U s S hden) (op V))))
  let σ (V : Opens ↥(spa Aplus)) (hV : V ∈ spaRationalOpens Aplus)
      (hVW : V ≤ spaBasicOpen Aplus U s) :
      presentationLimit (P := P) Aplus V ≃ₜ
        presentationLimit (P := completionLocalization P U s S hden)
          (completedPlusSubring P Aplus U s S hden) (locOpensComap P Aplus U s S hden V) :=
    TopCat.homeoOfIso (G.mapIso
      (presentationLimitLocIso P Aplus U s S hden hAplus hU V hV hVW))
  let pieces (t : T) := spaBasicOpen Aplus U s ⊓ spaBasicOpen Aplus T t
  have eB_apply (V : Opens ↥(spa (completedPlusSubring P Aplus U s S hden)))
      (x : FB.obj (op V)) : eB V x = (eqToHom (presentationLimitPresheaf_obj
        (completionLocalization P U s S hden) (completedPlusSubring P Aplus U s S hden)
        (op V))).hom.1 x := rfl
  have σ_apply (V : Opens ↥(spa Aplus)) (hV : V ∈ spaRationalOpens Aplus)
      (hVW : V ≤ spaBasicOpen Aplus U s) (x : presentationLimit (P := P) Aplus V) :
      σ V hV hVW x =
        (presentationLimitLocIso P Aplus U s S hden hAplus hU V hV hVW).hom.hom.1 x := rfl
  -- Pass from the presheaf over the completed coordinate ring to its presentation limits.
  have hBpl : IsInducing fun
      (x : presentationLimit (P := completionLocalization P U s S hden)
        (completedPlusSubring P Aplus U s S hden)
        (locOpensComap P Aplus U s S hden (spaBasicOpen Aplus U s))) (t : T) ↦
      (presentationLimitMap (P := completionLocalization P U s S hden)
        (locOpensComap_mono P Aplus U s S hden
          (inf_le_left : pieces t ≤ spaBasicOpen Aplus U s))).hom.1 x :=
    ((eB _).isInducing_pi_iff_of_homeomorph (fun t ↦ eB (locOpensComap P Aplus U s S hden
      (pieces t))) fun x t ↦ by
        rw [eB_apply, eB_apply]
        exact eqToHom_apply_presentationLimitPresheaf_map_apply
          (completionLocalization P U s S hden)
          (locOpensComap_mono P Aplus U s S hden inf_le_left) x).mp hB
  -- Transport along Remark 8.4 to the presentation limits over `P`.
  exact ((σ (spaBasicOpen Aplus U s) (spaBasicOpen_mem_spaRationalOpens hU)
    le_rfl).isInducing_pi_iff_of_homeomorph
    (fun t ↦ σ (pieces t) (hrat t) inf_le_left) fun x t ↦ by
      rw [σ_apply, σ_apply]
      exact presentationLimitLocIso_hom_presentationLimitMap_apply P Aplus U s S hden hAplus
        hU (spaBasicOpen_mem_spaRationalOpens hU) (hrat t) le_rfl inf_le_left x).mpr hBpl

end Completion

/-- Over a Tate ring satisfying a predicate with `ContinuousLaurentGluing`, sections on a
rational open carry the topology induced by restriction to a standard rational cover whose
generators vanish nowhere on that open. -/
theorem isInducing_presentationLimitPresheafMap_standardSieve
    (hC : ContinuousLaurentGluing C) (hA : C A) (hP : P.ringOfDefinition ≤ Aplus)
    (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a) {T : Finset A} (hT : T.Nonempty)
    {W : Opens ↥(spa Aplus)} (hW : W ∈ spaRationalOpens Aplus)
    (hTW : ∀ t ∈ T, ∀ v ∈ W, t ∉ supp (v : Spv A)) :
    let S := Sieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
      fun _ ↦ homOfLE inf_le_left
    IsInducing fun (x : (presentationLimitPresheaf P Aplus).obj (op W))
      (g : (V : Opens ↥(spa Aplus)) × { f : V ⟶ W // S f }) ↦
        ((presentationLimitPresheaf P Aplus).map g.2.1.op).hom.1 x := by
  classical
  have _ : IsHuberRing A := ⟨⟨P⟩⟩
  -- Write `W` as a rational open `R(U / s)` and equip its completed coordinate ring `B`.
  obtain ⟨U, s, hU, hWU⟩ := mem_spaRationalFamily_iff.mp (mem_spaRationalOpens.mp hW)
  obtain rfl : W = spaBasicOpen Aplus U s :=
    Opens.ext (hWU.trans (Set.ext fun _ ↦ mem_spaBasicOpen.symm))
  have hden := hasDenominatorPower_of_isOpen_span P U s (Localization.Away s) hU
  let _ := locUniformSpace P U s _ hden
  have _ := isUniformAddGroup_locUniformSpace P U s _ hden
  have _ := isTopologicalRing_locUniformSpace P U s _ hden
  have _ := isTateRing_completion_locTopology_of_isTateRing P U s _ hden
  have hCB : C (UniformSpace.Completion (Localization.Away s)) :=
    hC.completion_localization P U s hU hA
  -- The generators become units in `B`, and the standard cover pulls back to the
  -- unit-generated standard cover of `Spa B`, whose pieces are rational in `Spa A`.
  have hu : ∀ t ∈ T, IsUnit (toCompletionLoc P U s _ hden t) := fun t ht ↦
    (isUnit_toCompletionLoc_iff_forall_notMem_supp P Aplus hP hAplus U s _ hden t).2
      fun v hv ↦ hTW t ht ⟨v, rationalSubset_subset_spa Aplus U s hv⟩ (mem_spaBasicOpen.mpr hv)
  -- Apply the unit-generated case over `B` and reindex its generators by `T`.
  have hB := isInducing_presentationLimitPresheafMap_standardSieve_of_isUnit
    (completionLocalization P U s _ hden) hC hCB
    (isPowerBounded_of_mem_completedPlusSubring P Aplus hAplus U s _ hden) (hT.image _)
    (Finset.forall_mem_image.mpr hu)
    (W := locOpensComap P Aplus U s _ hden (spaBasicOpen Aplus U s))
    (locOpensComap_mem_spaRationalOpens P Aplus U s _ hden hW)
  dsimp only at hB
  rw [← ofArrows_locOpensComap_eq_ofArrows_image P U s _ hden T] at hB
  -- Recover the full standard sieve from its generating arrows.
  exact (TopCommRingCat.isInducing_restrictionMap_ofArrows_iff
    (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι) _ _).mpr
    (isInducing_restrictionMap_of_isInducing_presentationLimitMap P (fun t : T ↦ inf_le_left)
      (isInducing_presentationLimitMap_pieces_of_completion P U s _ hden hAplus hU
        (inf_spaBasicOpen_mem_spaRationalOpens_of_isUnit P U s _ hden hP hU hT hu)
        ((TopCommRingCat.isInducing_restrictionMap_ofArrows_iff
          (presentationLimitPresheaf (completionLocalization P U s _ hden)
            (completedPlusSubring P Aplus U s _ hden) ⋙ TopCommRingCat.isCompleteSeparated.ι)
          _ _).mp hB)))

/-- Over a Tate ring satisfying a predicate with `ContinuousLaurentGluing`, the presentation-limit
presheaf of topological commutative rings satisfies the sheaf condition for a standard rational
cover whose generators vanish nowhere on the rational open. -/
theorem isSheafFor_ofArrows_inf_spaBasicOpen_topCommRingCat
    (hC : ContinuousLaurentGluing C) (hA : C A) (hP : P.ringOfDefinition ≤ Aplus)
    (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a) {T : Finset A} (hT : T.Nonempty)
    {W : Opens ↥(spa Aplus)} (hW : W ∈ spaRationalOpens Aplus)
    (hTW : ∀ t ∈ T, ∀ v ∈ W, t ∉ supp (v : Spv A))
    (E : _root_.TopCommRingCat.{v}) :
    (Presieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
      fun _ ↦ homOfLE inf_le_left).IsSheafFor
        (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι ⋙
          coyoneda.obj (op E)) := by
  rw [Presieve.isSheafFor_iff_generate]
  exact TopCommRingCat.isSheafFor_of_isSheafFor_forget
    (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι)
    (Sieve.ofArrows _ _)
    ((Presieve.isSheafFor_iff_generate _).mp
      (isSheafFor_ofArrows_inf_spaBasicOpen_of_laurentGluing P hC.toLaurentGluing hA hP hAplus hT
        hW hTW))
    (isInducing_presentationLimitPresheafMap_standardSieve P hC hA hP
      hAplus hT hW hTW) E

/-! ### Standard covers generated by the unit ideal -/

/-- **Wedhorn's Lemma 8.34(ii), with topology, on a Laurent piece.** Over a Tate ring satisfying a
predicate with `ContinuousLaurentGluing`, the presentation-limit presheaf of topological
commutative rings satisfies the sheaf condition for the restriction of a standard cover to a
rational subset of a Laurent piece. -/
theorem isSheafFor_ofArrows_inf_spaBasicOpen_of_subset_laurentPiece_topCommRingCat
    (hC : ContinuousLaurentGluing C) (hA : C A) (hP : P.ringOfDefinition ≤ Aplus)
    (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a)
    {T : Finset A} (hT : T.Nonempty) {ϖ : Aˣ}
    (hϖ : ∀ v ∈ spa Aplus, ∃ t ∈ T, v.toValuativeRel.vlt (ϖ : A) t) {J : Set T}
    {V : Opens ↥(spa Aplus)} (hV : V ∈ spaRationalOpens Aplus)
    (hVJ : (V : Set ↥(spa Aplus)) ⊆
      Subtype.val ⁻¹' laurentPiece Aplus (fun t : T ↦ (ϖ⁻¹ : Aˣ) * (t : A)) J)
    (E : _root_.TopCommRingCat.{v}) :
    (Presieve.ofArrows (fun t : T ↦ V ⊓ spaBasicOpen Aplus T t)
      fun _ ↦ homOfLE inf_le_left).IsSheafFor
        (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι ⋙
          coyoneda.obj (op E)) := by
  apply isSheafFor_ofArrows_inf_spaBasicOpen_of_subset_laurentPiece_of_isSheafFor hT hϖ hVJ
  intro T' hT' hT'V
  exact isSheafFor_ofArrows_inf_spaBasicOpen_topCommRingCat P hC hA hP
    hAplus hT' hV hT'V E

/-- **Wedhorn's Lemma 8.34(ii), with topology.** Over a Tate ring satisfying a predicate with
`ContinuousLaurentGluing`, the presentation-limit presheaf of topological commutative rings
satisfies the sheaf condition for a standard rational cover generated by a nonempty finite set
spanning the unit ideal. Thus compatible continuous ring homomorphisms into the rings of sections
on the cover glue uniquely and continuously. -/
theorem isSheafFor_ofArrows_inf_spaBasicOpen_of_span_eq_top_topCommRingCat
    (hC : ContinuousLaurentGluing C) (hA : C A) (hP : P.ringOfDefinition ≤ Aplus)
    (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a) {T : Finset A} (hT : T.Nonempty)
    (hspan : Ideal.span (T : Set A) = ⊤) {W : Opens ↥(spa Aplus)}
    (hW : W ∈ spaRationalOpens Aplus) (E : _root_.TopCommRingCat.{v}) :
    (Presieve.ofArrows (fun t : T ↦ W ⊓ spaBasicOpen Aplus T t)
      fun _ ↦ homOfLE inf_le_left).IsSheafFor
        (presentationLimitPresheaf P Aplus ⋙ TopCommRingCat.isCompleteSeparated.ι ⋙
          coyoneda.obj (op E)) := by
  apply isSheafFor_ofArrows_inf_spaBasicOpen_of_span_eq_top_of_isSheafFor hT hspan hW
  · intro T' hT' V hV hT'V
    exact isSheafFor_ofArrows_inf_spaBasicOpen_topCommRingCat P hC hA hP
      hAplus hT' hV hT'V E
  · intro R V hV
    exact isSheafFor_laurentSieve_topCommRingCat P hC hA hAplus R hV E

end TauCeti.ValuationSpectrum
