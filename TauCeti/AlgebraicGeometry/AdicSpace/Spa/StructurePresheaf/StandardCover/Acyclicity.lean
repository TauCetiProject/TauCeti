module

public import TauCeti.AlgebraicGeometry.AdicSpace.Spa.StructurePresheaf.StandardCover.Cech

/-!
# Acyclicity of unit-ideal standard rational covers

For a strongly noetherian Tate ring `A`, a finite nonempty set `T` generating the unit ideal
and a rational open `W` of `Spa(A, A⁺)`, the standard cover `(W ∩ R(T/t))_{t ∈ T}` has an
exact augmented Čech complex for the structure presheaf, in every degree.

This removes the nowhere-vanishing condition on the individual generators. Such acyclicity
is the input for passing from standard covers to arbitrary rational covers by refinement.
The pair of definition has its ring of definition contained in `A⁺`, and `A⁺` consists of
power-bounded elements; completeness and separatedness of `A` are not required, since the
structure presheaf uses separated completions.

## References

* T. Wedhorn, *Adic Spaces* (arXiv:1910.05934v1), Lemma 8.34(ii), (iii).
* S. Bosch, U. Güntzer, R. Remmert, *Non-Archimedean Analysis*, §8.2.2, Lemma 4.
-/

public section

open CategoryTheory Limits TopologicalSpace TauCeti.Huber TauCeti.CategoryTheory

universe v

namespace TauCeti.ValuationSpectrum

variable {A : Type v} [CommRing A] [UniformSpace A] [IsTopologicalRing A] [IsTateRing A]
  [IsStronglyNoetherian A] (P : PairOfDefinition A) {Aplus : Subring A}

/-- **Wedhorn's Lemma 8.34(ii) in all degrees.** The standard rational cover of a rational open
`W` generated by a nonempty finite set spanning the unit ideal is acyclic for the structure
presheaf of a strongly noetherian Tate pair. The generators need not individually be units or
vanish nowhere on `W`. The ring `A` need not be complete or Hausdorff. -/
theorem quasiIso_cechAugmentation_inf_spaBasicOpen_of_span_eq_top
    (hP : P.ringOfDefinition ≤ Aplus)
    (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a) {T : Finset A} (hT : T.Nonempty)
    (hspan : Ideal.span (T : Set A) = ⊤) {W : Opens ↥(spa Aplus)}
    (hW : W ∈ spaRationalOpens Aplus) :
    QuasiIso (cechAugmentation
      (fun t : T ↦ (⟨W ⊓ spaBasicOpen Aplus T t, Set.mem_Iic.2 inf_le_left⟩ : Set.Iic W))
      isTerminalTop (presentationLimitAddCommGrpPresheaf P Aplus W)) :=
  quasiIso_cechAugmentation_inf_spaBasicOpen_of_span_eq_top_of_quasiIso P hAplus hT hspan hW
    fun hT' _ hY hvan ↦ quasiIso_cechAugmentation_inf_spaBasicOpen P hP hAplus hT' hY hvan

end TauCeti.ValuationSpectrum
