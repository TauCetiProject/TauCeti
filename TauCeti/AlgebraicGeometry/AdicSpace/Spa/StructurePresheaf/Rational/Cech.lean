/-!
# The Čech complexes of rational covers of rational subsets

Let `A` be a strongly noetherian Tate ring, `P` a pair of definition whose ring of definition
lies in `A⁺`, and `A⁺` a subring of power-bounded elements. This file proves that every nonempty
cover of a rational subset `W ⊆ Spa(A, A⁺)` by rational subsets is acyclic for the structure
presheaf: its augmented Čech complex, as a presheaf of abelian groups on the opens contained in
`W`, is exact in every degree
(`TauCeti.ValuationSpectrum.quasiIso_cechAugmentation_spaRationalOpens_of_iSup_eq`). This is the
all-degree form of Wedhorn's Lemma 8.34 for an arbitrary rational cover; the degree-zero statement
is `TauCeti.ValuationSpectrum.isSheafFor_ofArrows_spaRationalOpens_of_iSup_eq`. The cover may be
infinite, and `A` need not be complete. Only Čech acyclicity is treated here, not the vanishing of
sheaf cohomology.

The proof has two steps, as in degree zero.

* Over a complete Hausdorff Tate ring with `A⁺` a ring of integral elements, every rational
  cover of the whole adic spectrum has a standard rational refinement (Wedhorn's Lemma 7.54). The
  original cover is acyclic as soon as standard covers generated by the unit ideal are acyclic on
  every rational open: the comparison uses the acyclicity of the standard refinement after
  restriction to every finite intersection of members of the original cover
  (`quasiIso_cechAugmentation_rationalCover_of_standardCover`). Over a strongly noetherian Tate
  ring that input is Wedhorn's Lemma 8.34(ii) in all degrees,
  `quasiIso_cechAugmentation_inf_spaBasicOpen_of_span_eq_top`.
* Write `W = R(T/s)` and `B = A⟨T/s⟩`. Wedhorn's Remark 8.4
  (`quasiIso_cechAugmentation_iff_locOpensComap`) transports acyclicity to the pullbacks of the
  members along `j : Spa(B, A_U⁺) → Spa(A, A⁺)`, which cover all of `Spa(B, A_U⁺)`. The ring `B`
  is again a strongly noetherian Tate ring, now complete and Hausdorff, and `A_U⁺` is a ring of
  integral elements of `B`, so the first step applies.

## Main results

* `TauCeti.ValuationSpectrum.quasiIso_cechAugmentation_rationalCover_of_standardCover`: over a
  complete Hausdorff Tate ring, acyclicity of rational covers of the whole adic spectrum reduces
  to acyclicity of unit-ideal standard covers of rational opens.
* `TauCeti.ValuationSpectrum.quasiIso_cechAugmentation_spaRationalOpens_of_iSup_eq`: over a
  strongly noetherian Tate ring, every nonempty cover of a rational subset by rational subsets is
  acyclic for the structure presheaf.

## References

* [T. Wedhorn, *Adic Spaces*][wedhorn_adic] (arXiv:1910.05934v1), Remark 8.4, Lemma 7.54 and
  Lemma 8.34.
* R. Huber, *A generalization of formal schemes and rigid analytic varieties*, Math. Z. 217 (1994),
  Lemma 2.6 and Theorem 2.5.
-/

public section

open CategoryTheory Limits TopologicalSpace TauCeti.Huber TauCeti.Huber.PairOfDefinition
  TauCeti.CategoryTheory

universe v

namespace TauCeti.ValuationSpectrum

variable {A : Type v} [CommRing A] [UniformSpace A] [IsTopologicalRing A] [IsTateRing A]
  (P : PairOfDefinition A) {Aplus : Subring A}

/-- A finite product of rational opens in the category of opens contained in `W` is rational.
The product is their intersection. -/
private theorem prod_mem_spaRationalOpens {W : Opens ↥(spa Aplus)} {n : ℕ}
    (U : Fin (n + 1) → Set.Iic W) (hU : ∀ i, (U i).1 ∈ spaRationalOpens Aplus) :
    (∏ᶜ U).1 ∈ spaRationalOpens Aplus := by
  let V : Set.Iic W := ⟨Finset.univ.inf fun i ↦ (U i).1, Set.mem_Iic.2
    ((Finset.inf_le (Finset.mem_univ (0 : Fin (n + 1)))).trans (Set.mem_Iic.1 (U 0).2))⟩
  have hV : V ⟶ ∏ᶜ U := Pi.lift fun i ↦ homOfLE (Subtype.mk_le_mk.2
    (Finset.inf_le (Finset.mem_univ i)))
  have e : (∏ᶜ U).1 = Finset.univ.inf fun i ↦ (U i).1 :=
    le_antisymm (Finset.le_inf fun i _ ↦ Subtype.coe_le_coe.2 (leOfHom (Pi.π U i)))
      (Subtype.coe_le_coe.2 (leOfHom hV) : V.1 ≤ (∏ᶜ U).1)
  rw [e]
  exact finsetInf_mem_spaRationalOpens _ fun i _ ↦ hU i

section Complete

variable [IsUniformAddGroup A] [CompleteSpace A] [T2Space A]

/-- **All-degree rational-cover refinement.** Let `A` be a complete Hausdorff Tate ring and
`A⁺` a ring of integral elements. Suppose that on every rational open the standard cover
generated by any nonempty finite set spanning the unit ideal has exact augmented Čech complex.
Then every nonempty family of rational opens covering `Spa(A, A⁺)` has exact augmented
Čech complex. Lemma 7.54 supplies a finite standard refinement. -/
theorem quasiIso_cechAugmentation_rationalCover_of_standardCover
    (hplus : IsRingOfIntegralElements Aplus)
    (hstandard : ∀ (S : Finset A), S.Nonempty → Ideal.span (S : Set A) = ⊤ →
      ∀ {W : Opens ↥(spa Aplus)}, W ∈ spaRationalOpens Aplus →
        QuasiIso (cechAugmentation
          (fun s : S ↦ (⟨W ⊓ spaBasicOpen Aplus S s,
            Set.mem_Iic.2 inf_le_left⟩ : Set.Iic W))
          isTerminalTop (presentationLimitAddCommGrpPresheaf P Aplus W)))
    {ι : Type v} [Nonempty ι] (U : ι → Opens ↥(spa Aplus))
    (hU : ∀ i, U i ∈ spaRationalOpens Aplus) (hcov : ⨆ i, U i = ⊤) :
    QuasiIso (cechAugmentation
      (fun i ↦ (⟨U i, Set.mem_Iic.2 le_top⟩ : Set.Iic (⊤ : Opens ↥(spa Aplus))))
      isTerminalTop (presentationLimitAddCommGrpPresheaf P Aplus ⊤)) := by
  classical
  obtain ⟨S, hS, hSU⟩ := exists_span_eq_top_forall_rationalSubset_subset_of_isOpen_of_iUnion_eq_univ
    Aplus hplus (fun i ↦ (U i : Set ↥(spa Aplus))) (fun i ↦ (U i).isOpen) (by
      rw [← Opens.coe_iSup, hcov, Opens.coe_top])
  rcases S.eq_empty_or_nonempty with hSempty | hSne
  · subst S
    have hspa : spa Aplus = ∅ := by
      simpa using spa_eq_biUnion_rationalSubset_of_span_eq_top Aplus hS
    obtain ⟨i⟩ := ‹Nonempty ι›
    exact quasiIso_cechAugmentation_of_hom _ isTerminalTop _ (i₀ := i)
      (homOfLE (Subtype.mk_le_mk.2 (by
        intro x _
        exact False.elim (by simpa [hspa] using x.2))))
  let V : S → Set.Iic (⊤ : Opens ↥(spa Aplus)) := fun s ↦
    ⟨spaBasicOpen Aplus S s, Set.mem_Iic.2 le_top⟩
  let U' : ι → Set.Iic (⊤ : Opens ↥(spa Aplus)) := fun i ↦
    ⟨U i, Set.mem_Iic.2 le_top⟩
  apply quasiIso_cechAugmentation_of_quasiIso_prod_of_hom
    (U := U') (V := V) isTerminalTop (presentationLimitAddCommGrpPresheaf P Aplus ⊤)
  · have hfamily :
        (fun s : S ↦ (⟨⊤ ⊓ spaBasicOpen Aplus S s,
          Set.mem_Iic.2 inf_le_left⟩ : Set.Iic (⊤ : Opens ↥(spa Aplus)))) = V := by
        funext s
        apply Subtype.ext
        simp [V]
    have hv := hstandard S hSne hS (top_mem_spaRationalOpens Aplus)
    rw [hfamily] at hv
    exact hv
  · intro n a
    let Y : Set.Iic (⊤ : Opens ↥(spa Aplus)) := ∏ᶜ fun j ↦ U' (a j)
    have hY : Y.1 ∈ spaRationalOpens Aplus :=
      prod_mem_spaRationalOpens (fun j ↦ U' (a j)) (fun j ↦ hU (a j))
    rw [quasiIso_cechAugmentation_prod_iff P Y]
    simpa only [V] using hstandard S hSne hS hY
  · intro s
    obtain ⟨i, hi⟩ := hSU s s.2
    exact ⟨i, ⟨homOfLE (Subtype.mk_le_mk.2 (fun x hx ↦
      hi (mem_spaBasicOpen.mp hx)))⟩⟩

/-- The case of a cover of the whole adic spectrum of a complete Hausdorff ring, with `A⁺` a ring
of integral elements: `quasiIso_cechAugmentation_rationalCover_of_standardCover` applies, with
standard covers handled by `quasiIso_cechAugmentation_inf_spaBasicOpen_of_span_eq_top`. The open
`W` is `⊤`, but is kept as a variable so that the lemma applies to opens that are only
propositionally `⊤`. -/
private theorem quasiIso_cechAugmentation_spaRationalOpens_of_iSup_eq_top
    [IsStronglyNoetherian A] (hP : P.ringOfDefinition ≤ Aplus)
    (hplus : IsRingOfIntegralElements Aplus) {W : Opens ↥(spa Aplus)} (hW : W = ⊤) {ι : Type v}
    [Nonempty ι] (U : ι → Set.Iic W)
    (hU : ∀ i, (U i).1 ∈ spaRationalOpens Aplus) (hcov : ⨆ i, (U i).1 = W) :
    QuasiIso (cechAugmentation U isTerminalTop
      (presentationLimitAddCommGrpPresheaf P Aplus W)) := by
  subst hW
  exact quasiIso_cechAugmentation_rationalCover_of_standardCover P hplus
    (fun _ hS hspan _ hW ↦ quasiIso_cechAugmentation_inf_spaBasicOpen_of_span_eq_top P hP
      hplus.isPowerBounded_of_mem hS hspan hW) (fun i ↦ (U i).1) hU hcov

end Complete

/-- **Wedhorn's Lemma 8.34: rational covers of rational subsets are acyclic.** Let `A` be a
strongly noetherian Tate ring, `P` a pair of definition whose ring of definition lies in `A⁺`,
`A⁺` a subring of power-bounded elements and `W` a rational subset of `Spa(A, A⁺)`. Let `U` be a
nonempty family of rational subsets of `W` whose union is `W`. The augmented Čech complex of the
structure presheaf, as a presheaf of abelian groups on the opens contained in `W`, for `U` is
exact in every degree.

`A` itself need not be complete, and the family may be infinite. The degree-zero statement is
`isSheafFor_ofArrows_spaRationalOpens_of_iSup_eq`. -/
theorem quasiIso_cechAugmentation_spaRationalOpens_of_iSup_eq [IsStronglyNoetherian A]
    (hP : P.ringOfDefinition ≤ Aplus) (hAplus : ∀ ⦃a⦄, a ∈ Aplus → IsPowerBounded a)
    {W : Opens ↥(spa Aplus)} (hW : W ∈ spaRationalOpens Aplus) {ι : Type v} [Nonempty ι]
    (U : ι → Set.Iic W) (hU : ∀ i, (U i).1 ∈ spaRationalOpens Aplus) (hcov : ⨆ i, (U i).1 = W) :
    QuasiIso (cechAugmentation U isTerminalTop
      (presentationLimitAddCommGrpPresheaf P Aplus W)) := by
  obtain ⟨T, s, hT, hWT⟩ := mem_spaRationalFamily_iff.mp (mem_spaRationalOpens.mp hW)
  obtain rfl : W = spaBasicOpen Aplus T s :=
    Opens.ext (hWT.trans (Set.ext fun _ ↦ mem_spaBasicOpen.symm))
  -- `B = A⟨T/s⟩` is a complete Hausdorff strongly noetherian Tate ring, and `A_U⁺` is a ring of
  -- integral elements of `B`
  have hden := hasDenominatorPower_of_isOpen_span P T s (Localization.Away s) hT
  let _ := locUniformSpace P T s _ hden
  have _ := isUniformAddGroup_locUniformSpace P T s _ hden
  have _ := isTopologicalRing_locUniformSpace P T s _ hden
  have _ := isTateRing_completion_locTopology_of_isTateRing P T s _ hden
  have _ : IsStronglyNoetherian (UniformSpace.Completion (Localization.Away s)) :=
    laurentGluing_isStronglyNoetherian.completion_localization P T s hT
      (inferInstanceAs (IsStronglyNoetherian A))
  -- transport to the pullbacks along `Spa(B, A_U⁺) → Spa(A, A⁺)` (Wedhorn's Remark 8.4), which
  -- cover `Spa(B, A_U⁺)`
  rw [quasiIso_cechAugmentation_iff_locOpensComap P T s _ hden hAplus hP hT le_rfl U]
  refine quasiIso_cechAugmentation_spaRationalOpens_of_iSup_eq_top
    (completionLocalization P T s _ hden)
    (completionLocalization_ringOfDefinition_le_completedPlusSubring P Aplus hP T s _ hden)
    (isRingOfIntegralElements_completedPlusSubring P Aplus (fun j _ ↦ hP j.2) hAplus T s _ hden)
    (locOpensComap_spaBasicOpen_self P Aplus T s _ hden) _
    (fun i ↦ locOpensComap_mem_spaRationalOpens P Aplus T s _ hden (hU i)) ?_
  refine (SetLike.ext fun v ↦ ?_ : _ = locOpensComap P Aplus T s _ hden (⨆ i, (U i).1)).trans
    (congrArg _ hcov)
  simp

end TauCeti.ValuationSpectrum
