module

public import TauCeti.AlgebraicGeometry.Blowup.ExceptionalDivisor
public import TauCeti.AlgebraicGeometry.IdealSheaf.Colon
import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.FinitePresentation
import TauCeti.RingTheory.Ideal.Colon

/-!
# Colon ideals by the exceptional divisor on blowup charts

On the blowup `Bl_I X ⟶ X` of a scheme `X` along an ideal sheaf `I`, the exceptional divisor
`I.comap I.blowupToBase` is an effective Cartier divisor. This file computes the pullback to an
affine blowup chart `Spec Γ(X, U)[I(U)/a] ⟶ Bl_I X` of the colon ideal sheaf
`(L.comap I.blowupToBase).colon (I.comap I.blowupToBase)` for any ideal sheaf `L` that is locally
principal inside `I` on `U`:

* `AlgebraicGeometry.Scheme.IdealSheafData.comap_affineBlowupι_blowupChart_colon`: if `L(U) = (b)`
  and `L(U) ≤ I(U)`, the colon pulls back to the principal ideal generated by `b / a`.
* `AlgebraicGeometry.Scheme.IdealSheafData.comap_affineBlowupι_blowupChart_colon_eq_top`: when
  `L(U) = (a)`, the colon pulls back to the unit ideal sheaf `⊤` on the `a`-chart.
-/

public section

noncomputable section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

open TauCeti.AlgebraicGeometry

variable {X : Scheme.{u}}

/-- On the affine chart `Spec Γ(X, U)[I(U)/a]` over an affine open `U` where `a ∈ I(U)` and
`L(U) ≤ I(U)` is generated by `b`, the residual ideal `(L.comap p : I.comap p)` on `Bl_I X` pulls
back to the principal ideal generated by `b / a`. -/
theorem comap_affineBlowupι_blowupChart_colon (I L : X.IdealSheafData)
    {U : X.Opens} (hU : IsAffineOpen U) (hLI : L.ideal ⟨U, hU⟩ ≤ I.ideal ⟨U, hU⟩)
    {a b : Γ(X, U)} (S : Type u) [CommRing S] [Algebra Γ(X, U) S] [IsLocalization.Away a S]
    (ha : a ∈ I.ideal ⟨U, hU⟩) (hL : L.ideal ⟨U, hU⟩ = Ideal.span {b}) :
    ((L.comap I.blowupToBase).colon (I.comap I.blowupToBase)).comap
        (affineBlowupι S ha ≫ I.blowupChart hU) =
      ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso
            (.of ((I.ideal ⟨U, hU⟩).affineBlowup a S))).inv
          (⟨TauCeti.Localization.divBy (S := S) b a,
            Ideal.divBy_mem_affineBlowup (hLI (hL ▸ Ideal.subset_span rfl))⟩ :
            (I.ideal ⟨U, hU⟩).affineBlowup a S)}) := by
  let φ := affineBlowupι S ha ≫ I.blowupChart hU
  let B := (I.ideal ⟨U, hU⟩).affineBlowup a S
  let e := (Scheme.ΓSpecIso (.of B)).inv
  have hb : b ∈ I.ideal ⟨U, hU⟩ := hLI (hL ▸ Ideal.subset_span rfl)
  have hreg : IsLeftRegular (e (algebraMap Γ(X, U) B a)) :=
    (Scheme.isSMulRegular_ΓSpecIso_inv
      (Ideal.isRegular_algebraMap_affineBlowup (I := I.ideal ⟨U, hU⟩)
        (a := a) (S := S)).left.isSMulRegular).isLeftRegular
  have hmul : e (algebraMap Γ(X, U) B a) *
      e ⟨TauCeti.Localization.divBy (S := S) b a, Ideal.divBy_mem_affineBlowup hb⟩ =
      e (algebraMap Γ(X, U) B b) :=
    (map_mul e.hom _ _).symm.trans (congrArg e.hom
      (Ideal.algebraMap_mul_algHom_divBy (AlgHom.id Γ(X, U) B) hb))
  have hLchart : (L.comap I.blowupToBase).comap φ =
      ofIdealTop (Ideal.span {e (algebraMap Γ(X, U) B b)}) := by
    rw [comap_affineBlowupι_blowupChart hU S ha, hL, Ideal.map_span, Set.image_singleton,
      Ideal.map_span, Set.image_singleton]
  have hIchart : (I.comap I.blowupToBase).comap φ =
      ofIdealTop (Ideal.span {e (algebraMap Γ(X, U) B a)}) := by
    rw [comap_affineBlowupι_blowupChart hU S ha, Ideal.map_algebraMap_affineBlowup (S := S) ha,
      Ideal.map_span, Set.image_singleton]
  rw [comap_colon_of_isOpenImmersion _ _ I.isEffectiveCartier_comap_blowupToBase.fg_ideal φ,
    hLchart, hIchart, ofIdealTop_colon_ofIdealTop, Ideal.colon_span, ← hmul]
  exact congrArg ofIdealTop (Ideal.span_mul_colon_singleton hreg _)

/-- On the affine chart `Spec Γ(X, U)[I(U)/a]` over an affine open `U` where `a ∈ I(U)` and
`L(U) = (a)`, the residual ideal `(L.comap p : I.comap p)` on `Bl_I X` pulls back to the unit
ideal sheaf `⊤`. -/
theorem comap_affineBlowupι_blowupChart_colon_eq_top (I L : X.IdealSheafData)
    {U : X.Opens} (hU : IsAffineOpen U) {a : Γ(X, U)} (S : Type u) [CommRing S]
    [Algebra Γ(X, U) S] [IsLocalization.Away a S] (ha : a ∈ I.ideal ⟨U, hU⟩)
    (hL : L.ideal ⟨U, hU⟩ = Ideal.span {a}) :
    ((L.comap I.blowupToBase).colon (I.comap I.blowupToBase)).comap
        (affineBlowupι S ha ≫ I.blowupChart hU) = ⊤ := by
  have hLI : L.ideal ⟨U, hU⟩ ≤ I.ideal ⟨U, hU⟩ := by
    rw [hL, Ideal.span_singleton_le_iff_mem]
    exact ha
  rw [comap_affineBlowupι_blowupChart_colon I L hU hLI S ha hL]
  have h1 : (⟨TauCeti.Localization.divBy (S := S) a a,
      Ideal.divBy_mem_affineBlowup ha⟩ : (I.ideal ⟨U, hU⟩).affineBlowup a S) = 1 :=
    Subtype.ext (TauCeti.Localization.divBy_self (S := S) a)
  rw [h1, map_one, Ideal.span_singleton_one]
  exact OrderIso.map_top equivOfIsAffine.symm.toOrderIso

end AlgebraicGeometry.Scheme.IdealSheafData
