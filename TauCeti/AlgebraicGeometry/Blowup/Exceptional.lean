module

public import TauCeti.AlgebraicGeometry.Blowup.AffineCharts
public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Basic
import TauCeti.Algebra.Regular.SMul

/-!
# The exceptional divisor of an affine blowup

On the blowup `Proj R[It]` of `Spec R` along an ideal `I`, the inverse image of the centre
is an effective Cartier divisor. No finiteness, reducedness, or nonzerodivisor hypothesis on
`I` is needed. On the chart `Spec R[I/a]`, its ideal is generated by the image of `a`, which
is a nonzerodivisor even when `a` is a zerodivisor in `R`.

This file also provides the affine chart-cover criterion `isEffectiveCartier_of_affineBlowupι`
and proves that the inverse image of any principal effective Cartier divisor `V(d)` on `Spec R`
along `Proj R[It] ⟶ Spec R` remains an effective Cartier divisor.

## Main results

* `TauCeti.AlgebraicGeometry.isEffectiveCartier_of_affineBlowupι`: chart-cover criterion for an
  ideal sheaf on `Proj R[It]` to be effective Cartier.
* `TauCeti.AlgebraicGeometry.comap_affineBlowupι_eq_ofIdealTop`: on the chart `Spec R[I/a]`, the
  exceptional divisor is cut out by the single equation `a`.
* `TauCeti.AlgebraicGeometry.isEffectiveCartier_comap_toSpecZero_reesAlgebra`: the exceptional
  divisor of `Proj R[It] ⟶ Spec R` is an effective Cartier divisor.
* `Ideal.isEffectiveCartier_comap_toSpecCoeff_span_singleton`: pullback of a principal effective
  Cartier divisor `V(d)` along `Proj R[It] ⟶ Spec R` is an effective Cartier divisor.

## References

* The Stacks Project, Section *Blowing up*, Tag 01OF, Lemma 31.32.4.
-/

public section

noncomputable section

open CategoryTheory AlgebraicGeometry reesAlgebra
open AlgebraicGeometry.Scheme.IdealSheafData

namespace TauCeti.AlgebraicGeometry

universe u

variable {R : Type u} [CommRing R]

/-- **Affine blowup chart-cover criterion for effective Cartier divisors.** An ideal sheaf `K` on
`Proj R[It]` is an effective Cartier divisor if, for every generator `s i` in a generating family
of `I`, `K` restricts on the affine blowup chart `Spec R[I/s i]` to a principal ideal generated by
a regular element. -/
theorem isEffectiveCartier_of_affineBlowupι {I : Ideal R} {K : (Proj (grade I)).IdealSheafData}
    {ι : Type*} {s : ι → R} (hs : Ideal.span (Set.range s) = I)
    (hchart : ∀ i, ∃ r : I.affineBlowup (s i) (Localization.Away (s i)),
      IsSMulRegular (I.affineBlowup (s i) (Localization.Away (s i))) r ∧
      K.comap (affineBlowupι (Localization.Away (s i))
        (hs ▸ Ideal.subset_span ⟨i, rfl⟩)) =
        ofIdealTop (Ideal.span
          {(Scheme.ΓSpecIso (.of (I.affineBlowup (s i) (Localization.Away (s i))))).inv r})) :
    K.IsEffectiveCartier := by
  rw [isEffectiveCartier_iff_exists_isOpenImmersion]
  intro x
  obtain ⟨i, hx⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((iSup_opensRange_affineBlowupι hs).ge (Set.mem_univ x))
  obtain ⟨r, hr, hK⟩ := hchart i
  exact ⟨_, inferInstance, affineBlowupι (Localization.Away (s i)) _, inferInstance, hx,
    (Scheme.ΓSpecIso (.of _)).inv r, Scheme.isSMulRegular_ΓSpecIso_inv hr, hK⟩

variable {I : Ideal R}

/-- **The exceptional divisor on an affine chart.** For `a ∈ I`, the inverse image of the centre
`V(I)` on the chart `Spec R[I/a] ⟶ Proj R[It]` is the zero scheme of the single function `a`. -/
theorem comap_affineBlowupι_eq_ofIdealTop {a : R} (S : Type u) [CommRing S] [Algebra R S]
    [IsLocalization.Away a S] (ha : a ∈ I) :
    (ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap
        (affineBlowupι S ha ≫ Proj.toSpecZero (grade I) ≫
          Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom) =
      ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of _)).inv (algebraMap R (I.affineBlowup a S) a)}) := by
  rw [← toSpecCoeff_reesAlgebra, comap_comp, comap_affineBlowupι_toSpecCoeff S ha I,
    Ideal.map_algebraMap_affineBlowup (S := S) ha, Ideal.map_span, Set.image_singleton]

variable (I) in
/-- **The exceptional divisor is an effective Cartier divisor.** The inverse image of the centre
`V(I)` under the blowup `Proj R[It] ⟶ Spec R` is an effective Cartier divisor on `Proj R[It]`. -/
theorem isEffectiveCartier_comap_toSpecZero_reesAlgebra :
    ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap
      (Proj.toSpecZero (grade I) ≫
        Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom)).IsEffectiveCartier := by
  refine isEffectiveCartier_of_affineBlowupι (s := ((↑) : I → R))
    (by rw [Subtype.range_coe, Ideal.span_eq]) fun a ↦
      ⟨algebraMap R _ a.val,
        (Ideal.isRegular_algebraMap_affineBlowup (I := I) (a := a.val)
          (S := Localization.Away a.val)).left.isSMulRegular, ?_⟩
  rw [← comap_comp]
  exact comap_affineBlowupι_eq_ofIdealTop _ a.property

end TauCeti.AlgebraicGeometry

namespace Ideal

open AlgebraicGeometry AlgebraicGeometry.Scheme.IdealSheafData TauCeti TauCeti.AlgebraicGeometry

universe u

/-- On the affine blowup `Proj R[It] ⟶ Spec R` along an arbitrary ideal `I`, the inverse image of
any principal effective Cartier divisor `V(d)` (with `d` regular in `R`) is again an effective
Cartier divisor, with equation `d` on every affine blowup chart `Spec R[I/a]`. -/
theorem isEffectiveCartier_comap_toSpecCoeff_span_singleton {R : Type u} [CommRing R]
    (I : Ideal R) {d : R} (hd : IsSMulRegular R d) :
    ((ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of R)).inv d})).comap
      (Proj.toSpecCoeff (grade I))).IsEffectiveCartier := by
  refine isEffectiveCartier_of_affineBlowupι (s := ((↑) : I → R))
    (by rw [Subtype.range_coe, Ideal.span_eq]) fun a ↦
      ⟨algebraMap R _ d, Ideal.isSMulRegular_algebraMap_affineBlowup hd, ?_⟩
  rw [← Set.image_singleton, ← Ideal.map_span,
    comap_affineBlowupι_toSpecCoeff (Localization.Away a.val) a.property (Ideal.span {d})]
  simp only [Ideal.map_span, Set.image_singleton]

end Ideal
