/-!
# The universal property of the blowup

Let `I` be an ideal of a commutative ring `R` and let `π : Proj R[It] ⟶ Spec R` be the blowup of
`Spec R` along `V(I)`. This file proves its universal property: a morphism `f : T ⟶ Spec R` along
which the centre pulls back to an effective Cartier divisor, that is, for which the ideal sheaf
`I·𝒪_T` is locally generated by a nonzerodivisor, factors through `π`, and the factorization is
unique. No finiteness hypothesis on `I` and no hypothesis on `T` is needed.

*Uniqueness.* Locally on `T`, say on an affine open `Spec B` where `I B = a B` with `a` a
nonzerodivisor, the open `D(a) = Spec B_a` is scheme-theoretically dense, because `B → B_a` is
injective. Over `D(a)` the ideal `I` generates the unit ideal, so `D(a)` maps into the complement
of the centre, over which `π` is an isomorphism
(`TauCeti.AlgebraicGeometry.isIso_morphismRestrict_toSpecZero_reesAlgebra_of_disjoint_zeroLocus`).
Two lifts therefore agree on `D(a)`, and hence on `Spec B`, since `Proj R[It]` is separated over
`Spec R`.

*Existence.* On such an affine open, the elements `c ∈ B` with `c a = i` for some `i ∈ I`
generate the unit ideal (`Ideal.span_setOf_mul_eq_eq_top`). On the basic open `D(c)`, the image
of `i` is a nonzerodivisor generating `I B_c`, so the universal property of the affine blowup
algebra `R[I/i]` (`Ideal.affineBlowupLift`) gives a morphism into the chart
`Spec R[I/i] ⟶ Proj R[It]`. These local lifts agree on overlaps by uniqueness and glue.

*The blowup along an ideal sheaf.* The same universal property holds for the blowup
`Bl_I X ⟶ X` of an arbitrary scheme `X` along an arbitrary ideal sheaf `I`
(`AlgebraicGeometry.Scheme.IdealSheafData.blowup`): a morphism `f : T ⟶ X` along which the ideal
sheaf `I.comap f` of the inverse image of `V(I)` is effective Cartier factors uniquely through
`Bl_I X`. Over an affine open `V` of `X`, the blowup is the blowup of `Spec Γ(X, V)` along
`V(I(V))` (`AlgebraicGeometry.Scheme.IdealSheafData.isPullback_blowupChart`), and the inverse image
of `V(I)` on `V` is cut out by `I(V)`
(`AlgebraicGeometry.Scheme.IdealSheafData.comap_fromSpec_eq_ofIdealTop`). So on `f⁻¹ V` the affine
universal property gives a lift through the chart over `V`, unique among all lifts into the
blowup, and these lifts glue. Again no finiteness hypothesis on `I` is needed.

Together with the fact that the centre pulls back to an effective Cartier divisor on the blowup
itself, this characterizes the blowup as the terminal morphism along which the centre becomes an
effective Cartier divisor.

## Main definitions

* `TauCeti.AlgebraicGeometry.projReesAlgebraLift f hf`: the morphism `T ⟶ Proj R[It]` lifting
  `f : T ⟶ Spec R`, when the centre pulls back to an effective Cartier divisor on `T`.
* `AlgebraicGeometry.Scheme.IdealSheafData.blowupLift I f hf`: the morphism `T ⟶ Bl_I X` lifting
  `f : T ⟶ X`, when `I.comap f` is an effective Cartier divisor on `T`.

## Main results

* `TauCeti.AlgebraicGeometry.projReesAlgebraLift_toSpecZero`: the lift is a morphism over `Spec R`.
* `TauCeti.AlgebraicGeometry.projReesAlgebra_hom_ext`: two morphisms `T ⟶ Proj R[It]` over `Spec R`
  agree when the centre pulls back to an effective Cartier divisor on `T`.
* `TauCeti.AlgebraicGeometry.existsUnique_comp_toSpecZero_reesAlgebra_eq_of_isEffectiveCartier`:
  the universal property of the blowup of `Spec R` along `V(I)`.
* `AlgebraicGeometry.Scheme.IdealSheafData.blowupLift_blowupToBase`,
  `AlgebraicGeometry.Scheme.IdealSheafData.blowup_hom_ext` and
  `AlgebraicGeometry.Scheme.IdealSheafData.existsUnique_comp_blowupToBase_eq_of_isEffectiveCartier`:
  the same statements for the blowup of a scheme along an ideal sheaf;
  `AlgebraicGeometry.Scheme.IdealSheafData.comp_blowupLift` is the naturality of the lift in `T`.

## References

* [The Stacks Project, Section *Blowing up*](https://stacks.math.columbia.edu/tag/01OF), the
  universal property of blowing up.
* [The Stacks Project, Lemma 0806](https://stacks.math.columbia.edu/tag/0806), the universal
  property of the blowing up of a scheme along a quasi-coherent sheaf of ideals.
* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Proposition II.7.14.
-/

public section

noncomputable section

open CategoryTheory reesAlgebra

universe u

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry Scheme.IdealSheafData

variable {R : Type u} [CommRing R] {I : Ideal R}

/-- Away from the centre, the blowup is an isomorphism, so two morphisms into it over `Spec R` agree
when the common composite `k` avoids `V(I)`. -/
private theorem eq_of_comp_eq_of_forall_not_le {Y : Scheme.{u}} {k : Y ⟶ Spec (.of R)}
    (hk : ∀ y, ¬I ≤ (k y).asIdeal) {g₁ g₂ : Y ⟶ Proj (grade I)}
    (h₁ : g₁ ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom = k)
    (h₂ : g₂ ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom = k) :
    g₁ = g₂ := by
  set π := Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom
  let U : (Spec (.of R)).Opens :=
    ⟨(PrimeSpectrum.zeroLocus (I : Set R))ᶜ, (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl⟩
  have hU : Disjoint (α := Set (PrimeSpectrum R)) (U : Set (Spec (.of R)))
      (PrimeSpectrum.zeroLocus (I : Set R)) :=
    disjoint_compl_left
  have := isIso_morphismRestrict_toSpecZero_reesAlgebra_of_disjoint_zeroLocus hU
  have hrange (g : Y ⟶ Proj (grade I)) (hg : g ≫ π = k) :
      Set.range g ⊆ Set.range (π ⁻¹ᵁ U).ι := by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι, SetLike.mem_coe, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply,
      hg]
    -- By definition of `U`, `k y ∈ U` unfolds to `k y ∉ V(I)`, that is `¬I ≤ (k y).asIdeal`.
    exact hk y
  rw [← IsOpenImmersion.lift_fac (π ⁻¹ᵁ U).ι g₁ (hrange g₁ h₁),
    ← IsOpenImmersion.lift_fac (π ⁻¹ᵁ U).ι g₂ (hrange g₂ h₂)]
  congr 1
  rw [← cancel_mono (π ∣_ U), ← cancel_mono U.ι]
  simp only [Category.assoc, morphismRestrict_ι, IsOpenImmersion.lift_fac_assoc]
  exact h₁.trans h₂.symm

/-- Uniqueness of lifts on an affine scheme `Spec B` on which `I B` is generated by a
nonzerodivisor `a`: the scheme-theoretically dense open `D(a)` maps away from the centre. -/
private theorem eq_of_comp_eq_SpecMap {B : CommRingCat.{u}} {ψ : CommRingCat.of R ⟶ B} {a : B}
    (ha : IsSMulRegular B a) (hIa : I.map ψ.hom = Ideal.span {a}) {g₁ g₂ : Spec B ⟶ Proj (grade I)}
    (h₁ : g₁ ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom =
      Spec.map ψ)
    (h₂ : g₂ ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom =
      Spec.map ψ) :
    g₁ = g₂ := by
  let ι := Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away a)))
  have : IsSchemeTheoreticallyDominant ι := by
    rw [isSchemeTheoreticallyDominant_SpecMap_iff]
    exact IsLocalization.injective (Localization.Away a)
      (Submonoid.powers_le.mpr (isRegular_iff_mem_nonZeroDivisors.mp
        ((Commute.isRegular_iff (Commute.all _)).mpr ha.isLeftRegular)))
  refine TauCeti.ext_of_isSchemeTheoreticallyDominant ι _ (h₁.trans h₂.symm) ?_
  refine eq_of_comp_eq_of_forall_not_le (k := ι ≫ Spec.map ψ) (fun y hy ↦ ?_)
    (by rw [Category.assoc, h₁]) (by rw [Category.assoc, h₂])
  -- On `Spec B_a`, the ideal generated by `I` contains the unit `a`.
  rw [← Spec.map_comp, Spec.map_apply] at hy
  have hy' : (I.map ψ.hom).map (algebraMap B (Localization.Away a)) ≤ y.asIdeal := by
    rw [Ideal.map_map]
    exact Ideal.map_le_iff_le_comap.mpr hy
  rw [hIa, Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem] at hy'
  exact y.isPrime.ne_top
    (Ideal.eq_top_of_isUnit_mem _ hy' (IsLocalization.Away.algebraMap_isUnit a))

variable {T : Scheme.{u}}

/-- **Uniqueness in the universal property of the blowup.** Two morphisms `T ⟶ Proj R[It]` over
`Spec R` are equal if the centre `V(I)` pulls back to an effective Cartier divisor on `T`. -/
theorem projReesAlgebra_hom_ext {g₁ g₂ : T ⟶ Proj (grade I)}
    (h : g₁ ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom =
      g₂ ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom)
    (hf : ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap
      (g₁ ≫ Proj.toSpecZero (grade I) ≫
        Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom)).IsEffectiveCartier) :
    g₁ = g₂ := by
  refine Scheme.hom_ext_of_forall _ _ fun x ↦ ?_
  obtain ⟨U, hxU, a, ha, hUa⟩ := (isEffectiveCartier_iff _).mp hf x
  rw [ideal_comap_ofIdealTop_map_ΓSpecIso_inv] at hUa
  have hU : IsAffineOpen U.1 := U.2
  refine ⟨U.1, hxU, ?_⟩
  rw [← cancel_epi hU.isoSpec.inv, ← Category.assoc, ← Category.assoc, hU.isoSpec_inv_ι]
  exact eq_of_comp_eq_SpecMap ha hUa (by rw [Category.assoc, hU.fromSpec_comp_eq_SpecMap])
    (by rw [Category.assoc, ← h, hU.fromSpec_comp_eq_SpecMap])

/-- A lift through the chart `Spec R[I/i] ⟶ Proj R[It]`, for a ring map `R → B` along which `i`
becomes a nonzerodivisor generating `I B`. -/
private theorem exists_comp_eq_SpecMap {B : CommRingCat.{u}} (ψ : CommRingCat.of R ⟶ B) {i : R}
    (hi : i ∈ I) (hreg : IsSMulRegular B (ψ i)) (hspan : I.map ψ.hom ≤ Ideal.span {ψ i}) :
    ∃ g : Spec B ⟶ Proj (grade I),
      g ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom =
        Spec.map ψ := by
  let : Algebra R B := ψ.hom.toAlgebra
  let φ := Ideal.affineBlowupLift I i (Localization.Away i) hspan hreg.isLeftRegular
  refine ⟨Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ affineBlowupι (Localization.Away i) hi, ?_⟩
  rw [Category.assoc, affineBlowupι_toSpecZero, ← Spec.map_comp]
  congr 1
  ext r
  exact φ.commutes r

/-- Every point of `T` has an open neighbourhood over which `f` lifts to the blowup. -/
private theorem exists_lift_of_mem {f : T ⟶ Spec (.of R)}
    (hf : ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap f).IsEffectiveCartier)
    (x : T) :
    ∃ V : T.Opens, x ∈ V ∧ ∃ g : V.toScheme ⟶ Proj (grade I),
      g ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom =
        V.ι ≫ f := by
  obtain ⟨U, hxU, a, ha, hUa⟩ := (isEffectiveCartier_iff _).mp hf x
  rw [ideal_comap_ofIdealTop_map_ΓSpecIso_inv] at hUa
  set ψ := (Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ U le_top
  have hcover := _root_.AlgebraicGeometry.iSup_basicOpen_of_span_eq_top U.1 _
    (Ideal.span_setOf_mul_eq_eq_top ha hUa)
  obtain ⟨c, ⟨i, hi, hci⟩, hxc⟩ : ∃ c ∈ {c | ∃ i ∈ I, c * a = ψ i}, x ∈ T.basicOpen c := by
    have hx : x ∈ ⨆ c ∈ {c | ∃ i ∈ I, c * a = ψ i}, T.basicOpen c := by
      rw [hcover]
      exact hxU
    simpa only [TopologicalSpace.Opens.mem_iSup, exists_prop] using hx
  have hV : IsAffineOpen (T.basicOpen c) := U.2.basicOpen c
  have hVU : T.basicOpen c ≤ U.1 := T.basicOpen_le c
  set ρ := T.presheaf.map (homOfLE hVU).op
  have hψV : ψ ≫ ρ = (Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ (T.basicOpen c) le_top := by
    rw [Category.assoc]
    exact congrArg _ (f.appLE_map _ _)
  have hunit : IsUnit (ρ c) := T.toRingedSpace.isUnit_res_basicOpen c
  have hi' : (ψ ≫ ρ) i = ρ c * ρ a := by
    rw [CommRingCat.comp_apply, ← hci, map_mul]
  obtain ⟨g, hg⟩ := exists_comp_eq_SpecMap (ψ ≫ ρ) hi
    (by rw [hi']; exact (hunit.isSMulRegular _).mul (U.2.isSMulRegular_map hVU ha))
    (by
      rw [CommRingCat.hom_comp, ← Ideal.map_map, hUa, Ideal.map_span, Set.image_singleton, hi',
        Ideal.span_singleton_le_span_singleton]
      exact hunit.mul_left_dvd.mpr dvd_rfl)
  refine ⟨T.basicOpen c, hxc, hV.isoSpec.hom ≫ g, ?_⟩
  rw [Category.assoc, hg, hψV, ← hV.fromSpec_comp_eq_SpecMap f, ← hV.isoSpec_inv_ι,
    Category.assoc, Iso.hom_inv_id_assoc]

/-- Existence in the universal property, by gluing the local lifts. -/
private theorem exists_comp_projReesAlgebra_eq {f : T ⟶ Spec (.of R)}
    (hf : ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap f).IsEffectiveCartier) :
    ∃ g : T ⟶ Proj (grade I),
      g ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom = f := by
  choose V hxV g hg using exists_lift_of_mem hf
  -- The local lifts agree on overlaps, by uniqueness over the overlap.
  have compat (x y : T) : Limits.pullback.fst (V x).ι (V y).ι ≫ g x =
      Limits.pullback.snd (V x).ι (V y).ι ≫ g y := by
    have key : (Limits.pullback.fst (V x).ι (V y).ι ≫ g x) ≫ Proj.toSpecZero (grade I) ≫
        Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom =
          (Limits.pullback.fst (V x).ι (V y).ι ≫ (V x).ι) ≫ f := by
      rw [Category.assoc, hg, Category.assoc]
    refine projReesAlgebra_hom_ext ?_ ?_
    · rw [key, Category.assoc, Category.assoc, hg, Limits.pullback.condition_assoc]
    · rw [key, comap_comp]
      exact hf.comap _
  let 𝒰 := T.openCoverOfIsOpenCover V
    (eq_top_iff.mpr fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxV x⟩)
  refine ⟨𝒰.glueMorphisms g compat, 𝒰.hom_ext _ _ fun x ↦ ?_⟩
  exact (𝒰.ι_glueMorphisms_assoc g compat x _).trans (hg x)

variable (I) in
/-- **The universal property of the blowup: the lift.** If the centre `V(I)` pulls back to an
effective Cartier divisor on `T` along `f : T ⟶ Spec R`, this is the morphism `T ⟶ Proj R[It]`
over `Spec R` lifting `f` (`projReesAlgebraLift_toSpecZero`). It is the only such morphism
(`eq_projReesAlgebraLift`). This is the scheme-level counterpart of the chart lift
`Ideal.affineBlowupLift`. -/
def projReesAlgebraLift (f : T ⟶ Spec (.of R))
    (hf : ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap f).IsEffectiveCartier) :
    T ⟶ Proj (grade I) :=
  (exists_comp_projReesAlgebra_eq hf).choose

/-- The lift `projReesAlgebraLift I f hf` is a morphism over `Spec R`. -/
@[reassoc]
theorem projReesAlgebraLift_toSpecZero (f : T ⟶ Spec (.of R))
    (hf : ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap f).IsEffectiveCartier) :
    projReesAlgebraLift I f hf ≫ Proj.toSpecZero (grade I) ≫
      Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom = f :=
  (exists_comp_projReesAlgebra_eq hf).choose_spec

/-- Every morphism `T ⟶ Proj R[It]` over `Spec R` lifting `f` is the lift `projReesAlgebraLift`. -/
theorem eq_projReesAlgebraLift {f : T ⟶ Spec (.of R)}
    (hf : ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap f).IsEffectiveCartier)
    {g : T ⟶ Proj (grade I)}
    (hg : g ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom = f) :
    g = projReesAlgebraLift I f hf :=
  projReesAlgebra_hom_ext (hg.trans (projReesAlgebraLift_toSpecZero f hf).symm) (hg ▸ hf)

/-- **The universal property of the blowup of an affine scheme.** A morphism `f : T ⟶ Spec R`
along which the centre `V(I)` pulls back to an effective Cartier divisor factors uniquely through
the blowup `Proj R[It] ⟶ Spec R`. -/
theorem existsUnique_comp_toSpecZero_reesAlgebra_eq_of_isEffectiveCartier {f : T ⟶ Spec (.of R)}
    (hf : ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap f).IsEffectiveCartier) :
    ∃! g : T ⟶ Proj (grade I),
      g ≫ Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom = f :=
  ⟨projReesAlgebraLift I f hf, projReesAlgebraLift_toSpecZero f hf,
    fun _ hg ↦ eq_projReesAlgebraLift hf hg⟩

end TauCeti.AlgebraicGeometry

/-! ### The blowup of a scheme along an ideal sheaf -/

namespace AlgebraicGeometry.Scheme.IdealSheafData

open TauCeti.AlgebraicGeometry

variable {X T : Scheme.{u}} (I : X.IdealSheafData)

/-- **Uniqueness in the universal property of the blowup along an ideal sheaf.** Two morphisms
`T ⟶ Bl_I X` over `X` are equal if the centre `V(I)` pulls back to an effective Cartier divisor
on `T`. -/
theorem blowup_hom_ext {g₁ g₂ : T ⟶ I.blowup}
    (h : g₁ ≫ I.blowupToBase = g₂ ≫ I.blowupToBase)
    (hf : (I.comap (g₁ ≫ I.blowupToBase)).IsEffectiveCartier) : g₁ = g₂ := by
  set f := g₁ ≫ I.blowupToBase
  refine Scheme.hom_ext_of_forall _ _ fun x ↦ ?_
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (show f x ∈ ⊤ from trivial)
  refine ⟨f ⁻¹ᵁ V, hxV, ?_⟩
  -- On `f⁻¹ V`, both morphisms land in the affine chart of the blowup over `V`.
  have hrange (g : T ⟶ I.blowup) (hg : g ≫ I.blowupToBase = f) :
      Set.range ((f ⁻¹ᵁ V).ι ≫ g) ⊆ Set.range (I.blowupChart hV) := by
    rintro _ ⟨y, rfl⟩
    rw [← Scheme.Hom.coe_opensRange, opensRange_blowupChart, SetLike.mem_coe,
      Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, Category.assoc, hg]
    exact y.2
  have hlift (g : T ⟶ I.blowup) (hg : g ≫ I.blowupToBase = f) :
      (IsOpenImmersion.lift (I.blowupChart hV) _ (hrange g hg) ≫
          Proj.toSpecZero (reesAlgebra.grade (I.ideal ⟨V, hV⟩)) ≫
            Spec.map (reesAlgebra.gradeZeroEquiv (I.ideal ⟨V, hV⟩)).toCommRingCatIso.hom) ≫
              hV.fromSpec =
        (f ⁻¹ᵁ V).ι ≫ f := by
    rw [Category.assoc, ← toSpecCoeff_reesAlgebra, ← blowupChart_blowupToBase,
      IsOpenImmersion.lift_fac_assoc, Category.assoc, hg]
  rw [← IsOpenImmersion.lift_fac (I.blowupChart hV) _ (hrange g₁ rfl),
    ← IsOpenImmersion.lift_fac (I.blowupChart hV) _ (hrange g₂ h.symm)]
  congr 1
  refine projReesAlgebra_hom_ext ?_ ?_
  · rw [← cancel_mono hV.fromSpec]
    exact (hlift g₁ rfl).trans (hlift g₂ h.symm).symm
  · have hc := hf.comap (f ⁻¹ᵁ V).ι
    rw [← comap_comp, ← hlift g₁ rfl, comap_comp, comap_fromSpec_eq_ofIdealTop] at hc
    -- `hc` is the goal up to the eta rule `CommRingCat.of Γ(X, V) = Γ(X, V)`, which `rw` cannot
    -- see through: the affine universal property is stated over `Spec (.of R)`.
    exact hc

/-- Over an affine open `V` of `X`, a morphism `f : T ⟶ X` along which the centre pulls back to an
effective Cartier divisor lifts to the blowup on `f⁻¹ V`, through the affine chart over `V`. -/
private theorem exists_comp_blowupToBase_eq_of_isAffineOpen {f : T ⟶ X}
    (hf : (I.comap f).IsEffectiveCartier) {V : X.Opens} (hV : IsAffineOpen V) :
    ∃ g : (f ⁻¹ᵁ V).toScheme ⟶ I.blowup, g ≫ I.blowupToBase = (f ⁻¹ᵁ V).ι ≫ f := by
  set f' : (f ⁻¹ᵁ V).toScheme ⟶ Spec Γ(X, V) := (f ∣_ V) ≫ hV.isoSpec.hom
  have hf' : f' ≫ hV.fromSpec = (f ⁻¹ᵁ V).ι ≫ f := by
    rw [Category.assoc, ← hV.isoSpec_inv_ι, Iso.hom_inv_id_assoc, morphismRestrict_ι]
  have hc : ((ofIdealTop ((I.ideal ⟨V, hV⟩).map (Scheme.ΓSpecIso Γ(X, V)).inv.hom)).comap
      f').IsEffectiveCartier := by
    rw [← comap_fromSpec_eq_ofIdealTop, ← comap_comp, hf', comap_comp]
    exact hf.comap _
  refine ⟨projReesAlgebraLift _ f' hc ≫ I.blowupChart hV, ?_⟩
  rw [Category.assoc, blowupChart_blowupToBase, toSpecCoeff_reesAlgebra, Category.assoc,
    projReesAlgebraLift_toSpecZero_assoc, hf']

/-- Existence in the universal property, by gluing the lifts over the affine opens of `X`. -/
private theorem exists_comp_blowupToBase_eq {f : T ⟶ X} (hf : (I.comap f).IsEffectiveCartier) :
    ∃ g : T ⟶ I.blowup, g ≫ I.blowupToBase = f := by
  choose g hg using fun V : X.affineOpens ↦ I.exists_comp_blowupToBase_eq_of_isAffineOpen hf V.2
  -- The local lifts agree on overlaps, by uniqueness over the overlap.
  have compat (V W : X.affineOpens) :
      Limits.pullback.fst (f ⁻¹ᵁ V.1).ι (f ⁻¹ᵁ W.1).ι ≫ g V =
        Limits.pullback.snd (f ⁻¹ᵁ V.1).ι (f ⁻¹ᵁ W.1).ι ≫ g W := by
    have key : (Limits.pullback.fst (f ⁻¹ᵁ V.1).ι (f ⁻¹ᵁ W.1).ι ≫ g V) ≫ I.blowupToBase =
        (Limits.pullback.fst (f ⁻¹ᵁ V.1).ι (f ⁻¹ᵁ W.1).ι ≫ (f ⁻¹ᵁ V.1).ι) ≫ f := by
      rw [Category.assoc, hg, Category.assoc]
    refine I.blowup_hom_ext ?_ ?_
    · rw [key, Category.assoc, Category.assoc, hg, Limits.pullback.condition_assoc]
    · rw [key, comap_comp]
      exact hf.comap _
  have hcover : ⨆ V : X.affineOpens, f ⁻¹ᵁ V.1 = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, iSup_affineOpens_eq_top, Scheme.Hom.preimage_top]
  let 𝒰 := T.openCoverOfIsOpenCover (fun V : X.affineOpens ↦ f ⁻¹ᵁ V.1) hcover
  exact ⟨𝒰.glueMorphisms g compat, 𝒰.hom_ext _ _ fun V ↦
    (𝒰.ι_glueMorphisms_assoc g compat V _).trans (hg V)⟩

/-- **The universal property of the blowup along an ideal sheaf: the lift.** If the centre `V(I)`
pulls back to an effective Cartier divisor on `T` along `f : T ⟶ X`, this is the morphism
`T ⟶ Bl_I X` over `X` lifting `f` (`blowupLift_blowupToBase`). It is the only such morphism
(`eq_blowupLift`). -/
def blowupLift (f : T ⟶ X) (hf : (I.comap f).IsEffectiveCartier) : T ⟶ I.blowup :=
  (I.exists_comp_blowupToBase_eq hf).choose

/-- The lift `I.blowupLift f hf` is a morphism over `X`. -/
@[reassoc (attr := simp)]
theorem blowupLift_blowupToBase (f : T ⟶ X) (hf : (I.comap f).IsEffectiveCartier) :
    I.blowupLift f hf ≫ I.blowupToBase = f :=
  (I.exists_comp_blowupToBase_eq hf).choose_spec

/-- Every morphism `T ⟶ Bl_I X` over `X` lifting `f` is the lift `blowupLift`. -/
theorem eq_blowupLift {f : T ⟶ X} (hf : (I.comap f).IsEffectiveCartier) {g : T ⟶ I.blowup}
    (hg : g ≫ I.blowupToBase = f) : g = I.blowupLift f hf :=
  I.blowup_hom_ext (hg.trans (I.blowupLift_blowupToBase f hf).symm) (hg ▸ hf)

/-- **The universal property of the blowup along an ideal sheaf.** A morphism `f : T ⟶ X` along
which the centre `V(I)` pulls back to an effective Cartier divisor factors uniquely through the
blowup `Bl_I X ⟶ X`. -/
theorem existsUnique_comp_blowupToBase_eq_of_isEffectiveCartier {f : T ⟶ X}
    (hf : (I.comap f).IsEffectiveCartier) : ∃! g : T ⟶ I.blowup, g ≫ I.blowupToBase = f :=
  ⟨I.blowupLift f hf, I.blowupLift_blowupToBase f hf, fun _ hg ↦ I.eq_blowupLift hf hg⟩

/-- The lift to the blowup is natural in the source: precomposing the lift of `f` with
`h : T' ⟶ T` gives the lift of `h ≫ f`. -/
theorem comp_blowupLift {T' : Scheme.{u}} (h : T' ⟶ T) (f : T ⟶ X)
    (hf : (I.comap f).IsEffectiveCartier) (hhf : (I.comap (h ≫ f)).IsEffectiveCartier) :
    h ≫ I.blowupLift f hf = I.blowupLift (h ≫ f) hhf :=
  I.eq_blowupLift hhf (by rw [Category.assoc, blowupLift_blowupToBase])

end AlgebraicGeometry.Scheme.IdealSheafData
