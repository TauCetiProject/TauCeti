module

public import TauCeti.AlgebraicGeometry.Blowup.UniversalProperty
import TauCeti.Algebra.Regular.SMul
import TauCeti.AlgebraicGeometry.Blowup.BaseChange

/-!
# The exceptional divisor of a blowup

Let `I` be an ideal of a commutative ring `R` and let `π : Proj R[It] ⟶ Spec R` be the blowup of
`Spec R` along `V(I)`. The *exceptional divisor* is the inverse image `π⁻¹(V(I))`, the closed
subscheme of `Proj R[It]` cut out by the ideal sheaf `I·𝒪_{Proj R[It]}`. This file proves that it
is an effective Cartier divisor. On the affine chart `Spec R[I/a]` of an element `a ∈ I`, it is
the principal divisor of the nonzerodivisor `a`, because `I·R[I/a] = a·R[I/a]`
(`Ideal.map_algebraMap_affineBlowup`, `Ideal.isRegular_algebraMap_affineBlowup`), and these charts
cover the blowup.

Together with the universal property of `TauCeti/AlgebraicGeometry/Blowup/UniversalProperty.lean`,
this characterizes the blowup: `π` is the terminal morphism to `Spec R` along which the centre
pulls back to an effective Cartier divisor. In particular the lift of `π` itself is the identity,
and `π` is an isomorphism exactly when `V(I)` is already an effective Cartier divisor on `Spec R`,
for instance when `I` is generated by a single nonzerodivisor: blowing up an effective Cartier
divisor changes nothing.

The same holds for the blowup `Bl_I X ⟶ X` of an arbitrary scheme `X` along an arbitrary ideal
sheaf `I` (`AlgebraicGeometry.Scheme.IdealSheafData.blowup`). Over an affine open `U` of `X`, the
exceptional divisor restricted to the chart `Proj Γ(X, U)[I(U)t]` is the exceptional divisor of the
affine blowup of `Spec Γ(X, U)` along `V(I(U))`, and these charts cover `Bl_I X`. Since being an
effective Cartier divisor is local, the exceptional divisor of `Bl_I X` is an effective Cartier
divisor. With the universal property of the blowup along an ideal sheaf, `Bl_I X ⟶ X` is thus the
terminal morphism to `X` along which `V(I)` becomes an effective Cartier divisor, and it is an
isomorphism exactly when `V(I)` is already one.

## Main results

The results on affine blowups are in the namespace `TauCeti.AlgebraicGeometry`.

* `comap_affineBlowupι_eq_ofIdealTop`: on the chart `Spec R[I/a]`, the exceptional divisor is cut
  out by the single equation `a`.
* `isEffectiveCartier_comap_toSpecZero_reesAlgebra`: the exceptional divisor of the blowup is an
  effective Cartier divisor.
* `projReesAlgebraLift_eq_id`: the lift of the blowup morphism through itself is the
  identity.
* `isIso_toSpecZero_reesAlgebra_iff`: the blowup morphism is an isomorphism if and only if the
  centre is an effective Cartier divisor.
* `isIso_toSpecZero_reesAlgebra_span_singleton`: blowing up the ideal generated by a
  nonzerodivisor gives an isomorphism.

The results on the blowup along an ideal sheaf are in the namespace
`AlgebraicGeometry.Scheme.IdealSheafData`.

* `comap_blowupChart_comap_blowupToBase`: on the chart over an affine open `U`, the exceptional
  divisor of `Bl_I X` is the exceptional divisor of the blowup of `Spec Γ(X, U)` along `V(I(U))`.
* `isEffectiveCartier_comap_blowupToBase`: the exceptional divisor of `Bl_I X` is an effective
  Cartier divisor.
* `blowupLift_eq_id`: the lift of `Bl_I X ⟶ X` through itself is the identity.
* `isIso_blowupToBase_iff`: `Bl_I X ⟶ X` is an isomorphism if and only if `V(I)` is an effective
  Cartier divisor on `X`.

## References

* [The Stacks Project, Section *Blowing up*](https://stacks.math.columbia.edu/tag/01OF), the
  lemmas that the exceptional divisor is an effective Cartier divisor, that it is cut out by `a`
  on the affine chart of `a`, and that blowing up an effective Cartier divisor is an isomorphism.
* [The Stacks Project, Lemma 0806](https://stacks.math.columbia.edu/tag/0806), the universal
  property of the blowing up of a scheme along a quasi-coherent sheaf of ideals.
* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Proposition II.7.13(b).
-/

public section

noncomputable section

open CategoryTheory reesAlgebra

universe u

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry Scheme.IdealSheafData

variable {R : Type u} [CommRing R] {I : Ideal R}

/-- **The exceptional divisor on an affine chart.** For `a ∈ I`, the inverse image of the centre
`V(I)` on the chart `Spec R[I/a] ⟶ Proj R[It]` is the zero scheme of the single function `a`. -/
theorem comap_affineBlowupι_eq_ofIdealTop {a : R} (S : Type u) [CommRing S] [Algebra R S]
    [IsLocalization.Away a S] (ha : a ∈ I) :
    (ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap
        (affineBlowupι S ha ≫ Proj.toSpecZero (grade I) ≫
          Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom) =
      ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of _)).inv (algebraMap R (I.affineBlowup a S) a)}) := by
  rw [affineBlowupι_toSpecZero, comap_ofIdealTop, Ideal.map_map, ← CommRingCat.hom_comp,
    ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.hom_comp, ← Ideal.map_map, CommRingCat.hom_ofHom,
    Ideal.map_algebraMap_affineBlowup (S := S) ha, Ideal.map_span, Set.image_singleton]

variable (I) in
/-- **The exceptional divisor is an effective Cartier divisor.** The inverse image of the centre
`V(I)` under the blowup `Proj R[It] ⟶ Spec R` is an effective Cartier divisor on `Proj R[It]`. -/
theorem isEffectiveCartier_comap_toSpecZero_reesAlgebra :
    ((ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap
      (Proj.toSpecZero (grade I) ≫
        Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom)).IsEffectiveCartier := by
  rw [isEffectiveCartier_iff_exists_isOpenImmersion]
  intro x
  -- The charts of the elements of `I` cover the blowup.
  have hcover := iSup_opensRange_affineBlowupι (I := I) (s := ((↑) : I → R))
    (by rw [Subtype.range_coe, Ideal.span_eq])
  obtain ⟨⟨a, ha⟩, hx⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcover.ge (Set.mem_univ x))
  have hreg := (Ideal.isRegular_algebraMap_affineBlowup (I := I) (a := a)
    (S := Localization.Away a)).left.isSMulRegular
  refine ⟨_, inferInstance, affineBlowupι (Localization.Away a) ha, inferInstance, hx,
    (Scheme.ΓSpecIso _).inv (algebraMap R (I.affineBlowup a (Localization.Away a)) a),
    (isSMulRegular_map_iff (Scheme.ΓSpecIso _).symm.commRingCatIsoToRingEquiv _).mpr hreg, ?_⟩
  rw [← comap_comp]
  exact comap_affineBlowupι_eq_ofIdealTop _ ha

/-- **The blowup is its own lift.** The lift of the blowup morphism `Proj R[It] ⟶ Spec R` through
itself, given by the universal property, is the identity. -/
theorem projReesAlgebraLift_eq_id :
    projReesAlgebraLift I _ (isEffectiveCartier_comap_toSpecZero_reesAlgebra I) = 𝟙 _ :=
  (eq_projReesAlgebraLift _ (Category.id_comp _)).symm

/-- **Blowing up an effective Cartier divisor changes nothing.** The blowup
`Proj R[It] ⟶ Spec R` is an isomorphism if and only if the centre `V(I)` is an effective Cartier
divisor on `Spec R`. -/
theorem isIso_toSpecZero_reesAlgebra_iff :
    IsIso (Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom) ↔
      (ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).IsEffectiveCartier := by
  set π := Proj.toSpecZero (grade I) ≫ Spec.map (gradeZeroEquiv I).toCommRingCatIso.hom
  set J := ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)
  constructor
  · intro _
    -- Pull the exceptional divisor back along the isomorphism `π⁻¹`.
    have h := (isEffectiveCartier_comap_toSpecZero_reesAlgebra I).comap (inv π)
    rwa [← comap_comp, IsIso.inv_hom_id, comap_id] at h
  · intro hJ
    have hJ' : (J.comap (𝟙 _)).IsEffectiveCartier := by rwa [comap_id]
    -- The lift of the identity of `Spec R` is an inverse of `π`.
    refine ⟨projReesAlgebraLift I (𝟙 _) hJ', ?_, projReesAlgebraLift_toSpecZero _ hJ'⟩
    refine projReesAlgebra_hom_ext ?_ ?_
    · rw [Category.assoc, projReesAlgebraLift_toSpecZero, Category.comp_id, Category.id_comp]
    · rw [Category.assoc, projReesAlgebraLift_toSpecZero, Category.comp_id]
      exact isEffectiveCartier_comap_toSpecZero_reesAlgebra I

/-- **Blowing up a nonzerodivisor changes nothing.** If `a` is a nonzerodivisor of `R`, the blowup
of `Spec R` along `V(a)` is an isomorphism. -/
theorem isIso_toSpecZero_reesAlgebra_span_singleton {a : R} (ha : IsSMulRegular R a) :
    IsIso (Proj.toSpecZero (grade (Ideal.span {a})) ≫
      Spec.map (gradeZeroEquiv (Ideal.span {a})).toCommRingCatIso.hom) := by
  rw [isIso_toSpecZero_reesAlgebra_iff, Ideal.map_span, Set.image_singleton]
  have h := Scheme.Hom.isEffectiveCartier_ofIdealTop_span_appTop (𝟙 (Spec (.of R)))
    ((isSMulRegular_map_iff (Scheme.ΓSpecIso (.of R)).symm.commRingCatIsoToRingEquiv a).mpr ha)
  rwa [Scheme.Hom.id_appTop] at h

end TauCeti.AlgebraicGeometry

/-! ### The blowup of a scheme along an ideal sheaf -/

namespace AlgebraicGeometry.Scheme.IdealSheafData

open TauCeti.AlgebraicGeometry

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- **The exceptional divisor on an affine chart.** Over an affine open `U` of `X`, the inverse
image of the centre `V(I)` under the blowup `Bl_I X ⟶ X`, restricted to the chart
`Proj Γ(X, U)[I(U)t]` over `U`, is the exceptional divisor of the blowup of `Spec Γ(X, U)` along
`V(I(U))`. -/
theorem comap_blowupChart_comap_blowupToBase {U : X.Opens} (hU : IsAffineOpen U) :
    (I.comap I.blowupToBase).comap (I.blowupChart hU) =
      (ofIdealTop ((I.ideal ⟨U, hU⟩).map (Scheme.ΓSpecIso Γ(X, U)).inv.hom)).comap
        (Proj.toSpecCoeff (grade (I.ideal ⟨U, hU⟩))) := by
  rw [← comap_comp, blowupChart_blowupToBase, comap_comp, comap_fromSpec_eq_ofIdealTop]

/-- **The exceptional divisor is an effective Cartier divisor.** The inverse image of the centre
`V(I)` under the blowup `Bl_I X ⟶ X` along an arbitrary ideal sheaf `I` is an effective Cartier
divisor on `Bl_I X`. -/
theorem isEffectiveCartier_comap_blowupToBase : (I.comap I.blowupToBase).IsEffectiveCartier := by
  refine isEffectiveCartier_of_forall_exists_isOpenImmersion _ fun x ↦ ?_
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (show I.blowupToBase x ∈ ⊤ from trivial)
  refine ⟨_, I.blowupChart hU, inferInstance, ?_, ?_⟩
  · rw [← Scheme.Hom.coe_opensRange, opensRange_blowupChart]
    exact hxU
  · rw [comap_blowupChart_comap_blowupToBase, toSpecCoeff_reesAlgebra]
    exact isEffectiveCartier_comap_toSpecZero_reesAlgebra (I.ideal ⟨U, hU⟩)

/-- **The blowup is its own lift.** The lift of the blowup morphism `Bl_I X ⟶ X` through itself,
given by the universal property, is the identity. -/
@[simp]
theorem blowupLift_eq_id :
    I.blowupLift I.blowupToBase I.isEffectiveCartier_comap_blowupToBase = 𝟙 _ :=
  (I.eq_blowupLift _ (Category.id_comp _)).symm

/-- **Blowing up an effective Cartier divisor changes nothing.** The blowup `Bl_I X ⟶ X` is an
isomorphism if and only if the centre `V(I)` is an effective Cartier divisor on `X`. -/
theorem isIso_blowupToBase_iff : IsIso I.blowupToBase ↔ I.IsEffectiveCartier := by
  constructor
  · intro _
    -- Pull the exceptional divisor back along the isomorphism `(Bl_I X ⟶ X)⁻¹`.
    have h := I.isEffectiveCartier_comap_blowupToBase.comap (inv I.blowupToBase)
    rwa [← comap_comp, IsIso.inv_hom_id, comap_id] at h
  · intro hI
    have hI' : (I.comap (𝟙 X)).IsEffectiveCartier := by rwa [comap_id]
    -- The lift of the identity of `X` is an inverse of the blowup morphism.
    refine ⟨I.blowupLift (𝟙 X) hI', ?_, I.blowupLift_blowupToBase _ hI'⟩
    refine I.blowup_hom_ext ?_ ?_
    · rw [Category.assoc, blowupLift_blowupToBase, Category.comp_id, Category.id_comp]
    · rw [Category.assoc, blowupLift_blowupToBase, Category.comp_id]
      exact I.isEffectiveCartier_comap_blowupToBase

end AlgebraicGeometry.Scheme.IdealSheafData
