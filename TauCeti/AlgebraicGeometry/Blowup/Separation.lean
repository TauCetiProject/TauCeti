module

public import TauCeti.AlgebraicGeometry.Blowup.Restriction
public import TauCeti.AlgebraicGeometry.IdealSheaf.Affine
public import Mathlib.AlgebraicGeometry.Noetherian
import TauCeti.AlgebraicGeometry.Blowup.BaseChange

/-!
# Separating closed subsets by a blowup

Blowing up the intersection of two closed subschemes separates the closures of their
inverse images away from that intersection. On a locally Noetherian scheme this gives a
proper blowup separating any two disjoint closed subsets of an open subscheme, without
changing that open. This is the separation step used when gluing compactifications.

The separation assertion is topological: no reduced structure is imposed on the blowup
or on its ambient scheme.

The affine argument uses charts indexed by generators from either ideal. On a chart
indexed by an element of the first ideal, its zero locus has no points away from the
exceptional divisor, so its strict-transform support misses that entire chart.

## References

* The Stacks Project, Section 38.33, *Nagata compactification*, Tag 0F41.
* The Stacks Project, Section 31.32, *Blowing up*, Tag 01OF.
-/

public section

noncomputable section

open CategoryTheory TopologicalSpace
open AlgebraicGeometry

universe u

namespace Ideal

open TauCeti.AlgebraicGeometry

variable {R : Type u} [CommRing R]

private theorem disjoint_chart_closure_preimage_zeroLocus_sdiff
    (I K : Ideal R) {a : R} (ha : a ∈ I) (haK : a ∈ K) :
    Disjoint (Set.range (affineBlowupι (Localization.Away a) haK))
      (closure ((Proj.toSpecCoeff (reesAlgebra.grade K)) ⁻¹'
        (PrimeSpectrum.zeroLocus (I : Set R) \ PrimeSpectrum.zeroLocus (K : Set R)))) := by
  apply Disjoint.closure_right _
    (affineBlowupι (Localization.Away a) haK).isOpenEmbedding.isOpen_range
  refine Set.disjoint_left.mpr ?_
  rintro _ ⟨x, rfl⟩ ⟨hxI, hxK⟩
  have hbase : Proj.toSpecCoeff (reesAlgebra.grade K)
      (affineBlowupι (Localization.Away a) haK x) =
      Spec.map (CommRingCat.ofHom (algebraMap R (K.affineBlowup a (Localization.Away a)))) x := by
    rw [← Scheme.Hom.comp_apply, toSpecCoeff_reesAlgebra, affineBlowupι_toSpecZero]
  rw [hbase] at hxI hxK
  -- Rewriting through the scheme carrier of Spec requires default transparency.
  erw [PrimeSpectrum.mem_zeroLocus, Spec.map_apply, PrimeSpectrum.comap_asIdeal,
    SetLike.coe_subset_coe] at hxI hxK
  apply hxK
  -- Again use default transparency for the ideal of the Spec point. The image of K
  -- on this chart is generated by a, reducing containment to the membership hxI ha.
  erw [← Ideal.map_le_iff_le_comap,
    Ideal.map_algebraMap_affineBlowup (S := Localization.Away a) haK,
    Ideal.span_singleton_le_iff_mem]
  exact hxI ha

/-- Blowing up `I + J` separates the closures of the inverse images of `V(I)` and `V(J)`
after their intersection is removed. No finite-generation hypothesis is needed. -/
theorem disjoint_closure_preimage_zeroLocus_sdiff_blowup (I J : Ideal R) :
    Disjoint
      (closure ((Proj.toSpecCoeff (reesAlgebra.grade (I ⊔ J))) ⁻¹'
        (PrimeSpectrum.zeroLocus (I : Set R) \
          PrimeSpectrum.zeroLocus ((I ⊔ J : Ideal R) : Set R))))
      (closure ((Proj.toSpecCoeff (reesAlgebra.grade (I ⊔ J))) ⁻¹'
        (PrimeSpectrum.zeroLocus (J : Set R) \
          PrimeSpectrum.zeroLocus ((I ⊔ J : Ideal R) : Set R)))) := by
  let s : ↥((I : Set R) ∪ (J : Set R)) → R := Subtype.val
  have hs : Ideal.span (Set.range s) = I ⊔ J := by
    rw [Subtype.range_coe, Ideal.span_union, Ideal.span_eq, Ideal.span_eq]
  have hcover := iSup_opensRange_affineBlowupι hs
  refine Set.disjoint_left.mpr fun x hxI hxJ ↦ ?_
  obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcover.ge (Set.mem_univ x))
  have hrange : x ∈ Set.range (affineBlowupι (Localization.Away (s a))
      (hs ▸ (Ideal.subset_span (Set.mem_range_self a) : s a ∈ Ideal.span (Set.range s)))) := by
    rw [← Scheme.Hom.coe_opensRange]
    exact hxa
  rcases a.2 with ha | ha
  · exact Set.disjoint_left.mp
      (disjoint_chart_closure_preimage_zeroLocus_sdiff I (I ⊔ J) ha _) hrange hxI
  · exact Set.disjoint_left.mp
      (disjoint_chart_closure_preimage_zeroLocus_sdiff J (I ⊔ J) ha _) hrange hxJ

end Ideal

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- The blowup of the intersection of two closed subschemes separates the closures of
their inverse images away from that intersection, on an arbitrary scheme. -/
theorem disjoint_closure_preimage_support_sdiff_blowup (I J : X.IdealSheafData) :
    Disjoint
      (closure ((I ⊔ J).blowupToBase ⁻¹'
        ((I.support : Set X) \ (I ⊔ J).support)))
      (closure ((I ⊔ J).blowupToBase ⁻¹'
        ((J.support : Set X) \ (I ⊔ J).support))) := by
  refine Set.disjoint_left.mpr fun x hxI hxJ ↦ ?_
  -- Specify the whole base as the open in which to choose an affine neighbourhood.
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
    (show (I ⊔ J).blowupToBase x ∈ ⊤ from trivial)
  have hxrange : x ∈ Set.range ((I ⊔ J).blowupChart hU) := by
    rw [← Scheme.Hom.coe_opensRange, opensRange_blowupChart]
    exact hxU
  obtain ⟨y, rfl⟩ := hxrange
  have hpre (L : X.IdealSheafData) :
      (I ⊔ J).blowupChart hU ⁻¹'
          ((I ⊔ J).blowupToBase ⁻¹' ((L.support : Set X) \ (I ⊔ J).support)) =
        (Proj.toSpecCoeff (reesAlgebra.grade ((I ⊔ J).ideal ⟨U, hU⟩))) ⁻¹'
          (PrimeSpectrum.zeroLocus (L.ideal ⟨U, hU⟩ : Set Γ(X, U)) \
            PrimeSpectrum.zeroLocus ((I ⊔ J).ideal ⟨U, hU⟩ : Set Γ(X, U))) := by
    ext z
    have hbase := congrArg (fun f : _ ⟶ X ↦ f z)
      ((I ⊔ J).blowupChart_blowupToBase hU)
    simp only [Scheme.Hom.comp_apply] at hbase
    simp only [Set.mem_preimage, Set.mem_sdiff, hbase]
    exact and_congr (Set.ext_iff.mp (L.fromSpec_preimage_support hU) _)
      (not_congr (Set.ext_iff.mp ((I ⊔ J).fromSpec_preimage_support hU) _))
  have hopen := ((I ⊔ J).blowupChart hU).isOpenEmbedding.isOpenMap
  have hyI := hopen.preimage_closure_subset_closure_preimage hxI
  have hyJ := hopen.preimage_closure_subset_closure_preimage hxJ
  rw [hpre] at hyI hyJ
  exact Set.disjoint_left.mp
    (Ideal.disjoint_closure_preimage_zeroLocus_sdiff_blowup
      (I.ideal ⟨U, hU⟩) (J.ideal ⟨U, hU⟩)) hyI hyJ

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry.Scheme.Opens

open Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- Two disjoint closed subsets of an open subscheme of a locally Noetherian scheme can
be separated by a proper blowup whose centre misses that open. The closures upstairs
are taken in the whole blowup, not merely in its unchanged open subscheme. -/
theorem exists_blowup_separating (U : X.Opens) [IsLocallyNoetherian X]
    (Z₁ Z₂ : Closeds U.toScheme) (hZ : Disjoint Z₁ Z₂) :
    ∃ I : X.IdealSheafData,
      IsProper I.blowupToBase ∧
      Disjoint (U : Set X) (I.support : Set X) ∧
      IsIso (I.blowupToBase ∣_ U) ∧
      Disjoint
        (closure (I.blowupToBase ⁻¹' (U.ι '' (Z₁ : Set U.toScheme))))
        (closure (I.blowupToBase ⁻¹' (U.ι '' (Z₂ : Set U.toScheme)))) := by
  let I := vanishingIdeal (Closeds.closure (U.ι '' (Z₁ : Set U.toScheme)))
  let J := vanishingIdeal (Closeds.closure (U.ι '' (Z₂ : Set U.toScheme)))
  have hsI : (I.support : Set X) = closure (U.ι '' (Z₁ : Set U.toScheme)) := by
    simp [I]
  have hsJ : (J.support : Set X) = closure (U.ι '' (Z₂ : Set U.toScheme)) := by
    simp [J]
  have hpre (Z : Closeds U.toScheme) :
      U.ι ⁻¹' closure (U.ι '' (Z : Set U.toScheme)) = Z :=
    U.ι.isOpenEmbedding.isOpenMap.preimage_closure_image
      U.ι.isOpenEmbedding.injective U.ι.continuous _ Z.isClosed
  have hU : Disjoint (U : Set X) ((I ⊔ J).support : Set X) := by
    refine Set.disjoint_left.mpr fun x hxU hx ↦ ?_
    have hs : ((I ⊔ J).support : Set X) =
        closure (U.ι '' (Z₁ : Set U.toScheme)) ∩
          closure (U.ι '' (Z₂ : Set U.toScheme)) := by
      simp only [support_sup, Closeds.coe_inf, hsI, hsJ]
    rw [hs] at hx
    let y : U.toScheme := ⟨x, hxU⟩
    have hy : y ∈ Z₁ ⊓ Z₂ :=
      ⟨(Set.ext_iff.mp (hpre Z₁) y).mp hx.1, (Set.ext_iff.mp (hpre Z₂) y).mp hx.2⟩
    exact hZ.le_bot hy
  have hsub (Z : Closeds U.toScheme) :
      U.ι '' (Z : Set U.toScheme) ⊆
        closure (U.ι '' (Z : Set U.toScheme)) \ (I ⊔ J).support := by
    rintro _ ⟨z, hz, rfl⟩
    exact ⟨subset_closure ⟨z, hz, rfl⟩, Set.disjoint_left.mp hU z.2⟩
  refine ⟨I ⊔ J, (I ⊔ J).isProper_blowupToBase (fun V ↦ ?_), hU,
    (I ⊔ J).isIso_blowupToBase_restrict_of_disjoint_support hU, ?_⟩
  · have := IsLocallyNoetherian.component_noetherian V
    exact IsNoetherian.noetherian _
  · have hsep := I.disjoint_closure_preimage_support_sdiff_blowup J
    rw [hsI, hsJ] at hsep
    exact hsep.mono (closure_mono (Set.preimage_mono (hsub Z₁)))
      (closure_mono (Set.preimage_mono (hsub Z₂)))

end AlgebraicGeometry.Scheme.Opens
