module

public import Mathlib.Topology.Algebra.Module.ClosedSubmodule
public import TauCeti.Statistics.Semiparametric.MeanZero
import TauCeti.Analysis.InnerProductSpace.Projection.Ortho

/-!
# Tangent spaces in `L²(P)`

Given a tangent set `T ⊆ L²(P)` of score functions, its tangent space `tangentSpace P T` is the
closed linear span of `T` in `Lp ℝ 2 P`, represented as a `ClosedSubmodule ℝ (Lp ℝ 2 P)`
(van der Vaart, *Asymptotic Statistics*, 1998, §25.2, pp. 360–362).

## Main definitions

* `TauCeti.tangentSpace`: the closed linear span of a set `T ⊆ Lp ℝ 2 P`.

## Main results

* `TauCeti.tangentSpace_le_iff`, `TauCeti.tangentSpace_mono`: universal property (`tangentSpace P T
  ≤ K ↔ T ⊆ K`) and monotonicity in `T`.
* `TauCeti.tangentSpace_empty`, `TauCeti.tangentSpace_eq_self`,
  `TauCeti.tangentSpace_toSubmodule_eq_self`: the tangent space of `∅` is `⊥`, and a closed
  submodule is its own tangent space.
* `TauCeti.tangentSpace_le_meanZeroL2`: if `T ⊆ meanZeroL2 P`, then
  `(tangentSpace P T).toSubmodule ≤ meanZeroL2 P`.
* `TauCeti.mem_orthogonal_tangentSpace_iff`: orthogonality to `tangentSpace P T` is equivalent to
  orthogonality to every element of `T`.
* `TauCeti.tangentSpace_union`, `TauCeti.tangentSpace_union_toSubmodule`: the tangent space of a
  union is the join in `ClosedSubmodule` (the closure of the algebraic sum).
* `TauCeti.tangentSpace_union_toSubmodule_of_isOrtho`,
  `TauCeti.starProjection_tangentSpace_union_of_isOrtho`: when the two tangent spaces are
  mutually orthogonal, no closure is needed and their orthogonal projections add.
-/

public section

noncomputable section

open MeasureTheory

namespace TauCeti

variable {X : Type*} [MeasurableSpace X] (P : Measure X)

/-- The tangent space generated by a tangent set `T ⊆ Lp ℝ 2 P`: the closure of its linear span. -/
def tangentSpace (T : Set (Lp ℝ 2 P)) : ClosedSubmodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ T).closure

/-- Definitional restatement of `tangentSpace P T` as `(Submodule.span ℝ T).closure`. -/
theorem tangentSpace_def (T : Set (Lp ℝ 2 P)) :
    tangentSpace P T = (Submodule.span ℝ T).closure :=
  (rfl)

/-- The underlying submodule of `tangentSpace P T` is `(Submodule.span ℝ T).topologicalClosure`. -/
theorem tangentSpace_toSubmodule_eq (T : Set (Lp ℝ 2 P)) :
    (tangentSpace P T).toSubmodule = (Submodule.span ℝ T).topologicalClosure :=
  (rfl)

/-- Every element of a tangent set lies in the tangent space it generates. -/
theorem subset_tangentSpace (T : Set (Lp ℝ 2 P)) : T ⊆ (tangentSpace P T : Set (Lp ℝ 2 P)) :=
  Submodule.subset_span.trans (Submodule.le_topologicalClosure _)

/-- Universal property of `tangentSpace P T`: a closed submodule contains `tangentSpace P T` if and
only if it contains `T`. -/
@[simp]
theorem tangentSpace_le_iff {T : Set (Lp ℝ 2 P)} {K : ClosedSubmodule ℝ (Lp ℝ 2 P)} :
    tangentSpace P T ≤ K ↔ T ⊆ K := by
  rw [tangentSpace, Submodule.closure_le, Submodule.span_le]
  rfl

/-- The tangent space is monotone in the generating set. -/
theorem tangentSpace_mono {T T' : Set (Lp ℝ 2 P)} (h : T ⊆ T') :
    tangentSpace P T ≤ tangentSpace P T' :=
  (tangentSpace_le_iff P).2 (h.trans (subset_tangentSpace P T'))

/-- The tangent space of the empty set is `⊥`. -/
@[simp]
theorem tangentSpace_empty : tangentSpace P ∅ = ⊥ := by
  ext x
  simp [tangentSpace]

/-- A closed submodule is its own tangent space. -/
@[simp]
theorem tangentSpace_eq_self (K : ClosedSubmodule ℝ (Lp ℝ 2 P)) :
    tangentSpace P (K : Set (Lp ℝ 2 P)) = K := by
  rw [tangentSpace, ← ClosedSubmodule.coe_toSubmodule, Submodule.span_eq,
    ClosedSubmodule.closure_toSubmodule_eq]

/-- The underlying submodule of the tangent space of a closed submodule is that submodule. -/
theorem tangentSpace_toSubmodule_eq_self {K : Submodule ℝ (Lp ℝ 2 P)}
    (hK : IsClosed (K : Set (Lp ℝ 2 P))) :
    (tangentSpace P (K : Set (Lp ℝ 2 P))).toSubmodule = K := by
  simp [tangentSpace_toSubmodule_eq, hK.submodule_topologicalClosure_eq]

/-- If every score in `T` has mean zero, then `tangentSpace P T` lies inside `meanZeroL2 P`. -/
theorem tangentSpace_le_meanZeroL2 [IsFiniteMeasure P] {T : Set (Lp ℝ 2 P)}
    (hT : T ⊆ meanZeroL2 P) : (tangentSpace P T).toSubmodule ≤ meanZeroL2 P :=
  Submodule.topologicalClosure_minimal _ (Submodule.span_le.2 hT) (isClosed_meanZeroL2 P)

/-- An element of `Lp ℝ 2 P` is orthogonal to `tangentSpace P T` if and only if it is orthogonal to
every element of `T`. -/
theorem mem_orthogonal_tangentSpace_iff {T : Set (Lp ℝ 2 P)} {f : Lp ℝ 2 P} :
    f ∈ (tangentSpace P T).toSubmoduleᗮ ↔ ∀ g ∈ T, inner ℝ g f = 0 := by
  rw [tangentSpace_toSubmodule_eq, Submodule.orthogonal_closure, Submodule.mem_orthogonal]
  refine ⟨fun h g hg ↦ h g (Submodule.subset_span hg), fun h u hu ↦ ?_⟩
  refine Submodule.span_induction (fun g hg ↦ h g hg) (by simp) (fun x y _ _ hx hy ↦ ?_)
    (fun a x _ hx ↦ ?_) hu
  · rw [inner_add_left, hx, hy, add_zero]
  · rw [inner_smul_left, hx, mul_zero]

/-- The tangent space of a union is the join of the two tangent spaces in `ClosedSubmodule`. -/
theorem tangentSpace_union (T T' : Set (Lp ℝ 2 P)) :
    tangentSpace P (T ∪ T') = tangentSpace P T ⊔ tangentSpace P T' := by
  refine le_antisymm ?_ (sup_le (tangentSpace_mono P Set.subset_union_left)
    (tangentSpace_mono P Set.subset_union_right))
  rw [tangentSpace_le_iff]
  rintro x (hx | hx)
  · exact (le_sup_left : tangentSpace P T ≤ _) (subset_tangentSpace P T hx)
  · exact (le_sup_right : tangentSpace P T' ≤ _) (subset_tangentSpace P T' hx)

/-- The underlying submodule of `tangentSpace P (T ∪ T')` is the topological closure of the sum of
the two tangent spaces. -/
theorem tangentSpace_union_toSubmodule (T T' : Set (Lp ℝ 2 P)) :
    (tangentSpace P (T ∪ T')).toSubmodule =
      ((tangentSpace P T).toSubmodule ⊔ (tangentSpace P T').toSubmodule).topologicalClosure := by
  rw [tangentSpace_union]
  rfl

/-- If two tangent spaces are mutually orthogonal, the tangent space of the union is their
algebraic sum without taking a closure. -/
theorem tangentSpace_union_toSubmodule_of_isOrtho {T T' : Set (Lp ℝ 2 P)}
    (h : (tangentSpace P T).toSubmodule ⟂ (tangentSpace P T').toSubmodule) :
    (tangentSpace P (T ∪ T')).toSubmodule =
      (tangentSpace P T).toSubmodule ⊔ (tangentSpace P T').toSubmodule := by
  rw [tangentSpace_union, ClosedSubmodule.toSubmodule_sup_of_isOrtho h]

/-- If two tangent spaces are mutually orthogonal, the orthogonal projection onto the tangent space
of their union is the sum of the two orthogonal projections. -/
theorem starProjection_tangentSpace_union_of_isOrtho {T T' : Set (Lp ℝ 2 P)}
    (h : (tangentSpace P T).toSubmodule ⟂ (tangentSpace P T').toSubmodule) :
    (tangentSpace P (T ∪ T')).toSubmodule.starProjection =
      (tangentSpace P T).toSubmodule.starProjection +
        (tangentSpace P T').toSubmodule.starProjection := by
  simpa only [tangentSpace_union] using ClosedSubmodule.starProjection_sup_of_isOrtho h

end TauCeti
