module

public import TauCeti.Combinatorics.Graph.Stallings.Flower
public import TauCeti.Combinatorics.Graph.Stallings.Fold.Termination
public import TauCeti.Combinatorics.Graph.Stallings.Core

/-!
# Stallings graphs of finitely generated subgroups

Starting with the flower of a finite list of words, a finite sequence of folds produces a
folded graph. Taking its based core gives a finite connected folded core graph which reads
exactly the subgroup generated by the words. The construction chooses a terminal fold
sequence; uniqueness up to based labelled isomorphism is a separate property of folded cores.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*,
  Section 3, Proposition 3.8, and Section 7, Proposition 7.1.
-/

public section

namespace TauCeti.StallingsGraph

universe u

variable {α : Type u}

/-- A terminal finite folding of the flower of a list of words. -/
noncomputable def foldedFlower (ws : List (List (α × Bool))) :
    TauCeti.StallingsGraph α :=
  Classical.choose (TauCeti.StallingsGraph.exists_foldSequence_isFolded
    (TauCeti.StallingsGraph.flower ws))

/-- The chosen folding is reached from the flower by finitely many folds. -/
theorem flower_foldSequence (ws : List (List (α × Bool))) :
    TauCeti.StallingsGraph.FoldSequence (TauCeti.StallingsGraph.flower ws)
      (foldedFlower ws) :=
  (Classical.choose_spec (TauCeti.StallingsGraph.exists_foldSequence_isFolded
    (TauCeti.StallingsGraph.flower ws))).1

/-- The chosen terminal folding has no two equally labelled outgoing darts. -/
theorem foldedFlower_isFolded (ws : List (List (α × Bool))) :
    (foldedFlower ws).IsFolded :=
  (Classical.choose_spec (TauCeti.StallingsGraph.exists_foldSequence_isFolded
    (TauCeti.StallingsGraph.flower ws))).2

/-- The based core of a terminal folding of the flower. Its base vertex is retained,
including when it lies at the end of a stem. -/
noncomputable def stallingsGraph (ws : List (List (α × Bool))) :
    TauCeti.StallingsGraph α :=
  (foldedFlower ws).core

/-- The Stallings graph has finitely many vertices. -/
instance stallingsGraph_finite_vertex (ws : List (List (α × Bool))) :
    Finite (stallingsGraph ws).graph.V := by
  let _ : Finite (foldedFlower ws).graph.V :=
    (flower_foldSequence ws).finite_V
  exact inferInstanceAs (Finite ((foldedFlower ws).core.graph.V))

/-- The Stallings graph has finitely many darts. -/
instance stallingsGraph_finite_dart (ws : List (List (α × Bool))) :
    Finite (stallingsGraph ws).graph.E := by
  let _ : Finite (foldedFlower ws).graph.E :=
    (flower_foldSequence ws).finite_E
  exact inferInstanceAs (Finite ((foldedFlower ws).core.graph.E))

/-- The Stallings graph is folded. -/
theorem stallingsGraph_isFolded (ws : List (List (α × Bool))) :
    (stallingsGraph ws).IsFolded :=
  (foldedFlower_isFolded ws).core

/-- Every vertex of the Stallings graph lies on a reduced based closed path. -/
theorem stallingsGraph_isCore (ws : List (List (α × Bool))) :
    (stallingsGraph ws).graph.IsCore (stallingsGraph ws).base :=
  (foldedFlower ws).core_isCore

/-- The Stallings graph is connected, including for the empty list of words. -/
theorem stallingsGraph_connected (ws : List (List (α × Bool))) :
    (stallingsGraph ws).graph.Connected := by
  have h := ((stallingsGraph ws).graph.isCore_iff (stallingsGraph ws).base).mp
    (stallingsGraph_isCore ws) |>.1
  apply (TauCeti.SerreGraph.connected_iff (stallingsGraph ws).graph).mpr
  refine ⟨⟨(stallingsGraph ws).base⟩, ?_⟩
  rw [TauCeti.SerreGraph.preconnected_iff]
  intro a b
  obtain ⟨pa⟩ := h a
  obtain ⟨pb⟩ := h b
  exact ⟨pa.reverse.comp pb⟩

/-- The subgroup read at the base of the Stallings graph is generated by the input words. -/
theorem subgroup_stallingsGraph (ws : List (List (α × Bool))) :
    (stallingsGraph ws).subgroup (stallingsGraph ws).base =
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} := by
  simpa only [stallingsGraph, TauCeti.StallingsGraph.core_base] using
    ((TauCeti.StallingsGraph.core_subgroup (foldedFlower ws)).trans
      ((TauCeti.StallingsGraph.FoldSequence.subgroup_base
        (flower_foldSequence ws)).trans (TauCeti.StallingsGraph.flower_subgroup ws)))

/-- The Stallings graph of the empty generating list accepts the trivial subgroup. -/
@[simp] theorem subgroup_stallingsGraph_nil (α : Type u) :
    (stallingsGraph ([] : List (List (α × Bool)))).subgroup
      (stallingsGraph ([] : List (List (α × Bool)))).base = ⊥ := by
  rw [subgroup_stallingsGraph]
  simp

end TauCeti.StallingsGraph
