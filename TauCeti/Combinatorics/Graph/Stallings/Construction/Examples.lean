module

public import TauCeti.Combinatorics.Graph.Stallings.Certificate
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.SetTheory.Cardinal.Finite
public import Mathlib.Tactic.FinCases

/-!
# Three Stallings graphs

The Stallings graphs of three small lists of words over letters `a`, `b`, `c` are identified
with explicit labelled graphs.

* For `[a b, a c]` with `b ≠ c` it has two vertices and three edges: an `a`-edge from the base
  vertex to the other vertex, and a `b`-edge and a `c`-edge back. The `a`-edge is a spanning
  tree (`StallingsGraph.abAcTree`). For every spanning tree containing the `a`-edge, the tree
  loops through the positive edges outside it read `a b` and `a c`
  (`StallingsGraph.image_treeLoopWord_ab_ac`), so these words freely generate the subgroup
  (`StallingsGraph.lift_ab_ac_injective`). The element `b⁻¹ c` is read by crossing the `b`-edge
  backwards and the `c`-edge forwards: it lies in the subgroup, with the expression
  `(a b)⁻¹ (a c)` and no other (`StallingsGraph.lift_ab_ac_eq_inv_mul_iff`).
* For `[a², a³]` it is a single loop labelled `a`, since these words generate the subgroup
  generated by `a`.
* For `[b a b⁻¹]` with `a ≠ b` it is a loop labelled `a` joined to the base vertex by a
  `b`-edge. The base vertex has degree one and is kept: the graph does not accept `a`, whereas
  the loop alone does.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*,
  Section 3, Proposition 3.8, Section 6, Lemma 6.1, and Section 7, Propositions 7.1 and 7.2.
-/

public section

namespace TauCeti.StallingsGraph

open SerreGraph

variable {α : Type*} (a b c : α)

/-! ### The words `a b` and `a c` -/

/-- The graph with an `a`-edge out of the base vertex and a `b`-edge and a `c`-edge back. -/
private abbrev abAc : StallingsGraph α :=
  ofDigraph (0 : Fin 2) ![0, 1, 1] ![1, 0, 0] ![a, b, c]

private theorem abAc_isFolded (hbc : b ≠ c) : (abAc a b c).IsFolded := by
  rw [ofDigraph_isFolded_iff]
  constructor <;> intro i j <;> fin_cases i <;> fin_cases j <;> simp [hbc, hbc.symm]

private theorem abAc_isCore : (abAc a b c).graph.IsCore (0 : Fin 2) := by
  apply ofDigraph_isCore
  · intro v
    fin_cases v
    · exact ((abAc a b c).graph.exists_path_darts_eq [] rfl).nonempty
    · exact ((abAc a b c).graph.exists_path_darts_eq [(0, true)] rfl).nonempty
  · intro i
    fin_cases i
    · exact (abAc a b c).graph.mem_coreDarts_of_isChain _ (l := [(0, true), (1, true)]) rfl
        (by simp) (by simp)
    · exact (abAc a b c).graph.mem_coreDarts_of_isChain _ (l := [(0, true), (1, true)]) rfl
        (by simp) (by simp)
    · exact (abAc a b c).graph.mem_coreDarts_of_isChain _ (l := [(0, true), (2, true)]) rfl
        (by simp) (by simp)

/-- The Stallings graph of the words `a b` and `a c`, for `b ≠ c`, has two vertices and three
edges: an `a`-edge from the base vertex to the other vertex, and a `b`-edge and a `c`-edge
back. -/
theorem nonempty_iso_stallingsGraph_ab_ac (hbc : b ≠ c) :
    Nonempty (Iso (stallingsGraph [[(a, true), (b, true)], [(a, true), (c, true)]])
      (ofDigraph (0 : Fin 2) ![0, 1, 1] ![1, 0, 0] ![a, b, c])) := by
  refine nonempty_iso_stallingsGraph_ofDigraph (abAc_isFolded a b c hbc) (abAc_isCore a b c)
    ?_ ![1, FreeGroup.of a] (one_mem _) ?_
  · simp only [List.forall_mem_cons, List.not_mem_nil, false_imp_iff, implies_true, and_true]
    exact ⟨(abAc a b c).mk_map_label_mem_subgroup [(0, true), (1, true)] rfl,
      (abAc a b c).mk_map_label_mem_subgroup [(0, true), (2, true)] rfl⟩
  · intro i
    fin_cases i
    · simp
    · exact Subgroup.subset_closure ⟨[(a, true), (b, true)], by simp, by simp [FreeGroup.of]⟩
    · exact Subgroup.subset_closure ⟨[(a, true), (c, true)], by simp, by simp [FreeGroup.of]⟩

/-- The Stallings graph of the words `a b` and `a c`, for `b ≠ c`, has two vertices. -/
theorem natCard_vertex_stallingsGraph_ab_ac (hbc : b ≠ c) :
    Nat.card (stallingsGraph [[(a, true), (b, true)], [(a, true), (c, true)]]).graph.V = 2 := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_ab_ac a b c hbc
  simpa using Nat.card_congr f.vertexEquiv

/-- The Stallings graph of the words `a b` and `a c`, for `b ≠ c`, has three edges, that is,
six darts. -/
theorem natCard_dart_stallingsGraph_ab_ac (hbc : b ≠ c) :
    Nat.card (stallingsGraph [[(a, true), (b, true)], [(a, true), (c, true)]]).graph.E = 6 := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_ab_ac a b c hbc
  simpa using Nat.card_congr f.dartEquiv

private theorem abAc_restrict_isTree :
    ((abAc a b c).graph.restrict {e | e.1 = 0} fun _ h => h).IsTree := by
  set Γ := (abAc a b c).graph.restrict {e | e.1 = 0} fun _ h => h
  refine (SerreGraph.isTree_iff _).mpr ⟨(SerreGraph.connected_iff _).mpr ⟨⟨0⟩,
    (SerreGraph.preconnected_iff _).mpr fun u v => ?_⟩, (SerreGraph.isAcyclic_iff _).mpr
    fun u p hp => ?_⟩
  · fin_cases u <;> fin_cases v
    · exact (Γ.exists_path_darts_eq [] rfl).nonempty
    · exact (Γ.exists_path_darts_eq [⟨(0, true), rfl⟩] rfl).nonempty
    · exact (Γ.exists_path_darts_eq [⟨(0, false), rfl⟩] rfl).nonempty
    · exact (Γ.exists_path_darts_eq [] rfl).nonempty
  · -- Each vertex is the origin of exactly one tree dart. So a closed path of one dart would be
    -- a loop, and in a longer reduced path the dart after `e` would be the reverse of `e`.
    cases p with
    | nil => rfl
    | cons p f =>
      cases p with
      | nil =>
        obtain ⟨⟨⟨i, s⟩, hi⟩, h1, h2⟩ := f
        obtain rfl : i = 0 := hi
        have h := h1.trans h2.symm
        cases s <;> simp [Γ, SerreGraph.tgt_def] at h
      | cons p e =>
        refine absurd ?_ ((SerreGraph.Path.isReduced_cons_cons _ p e f).mp hp).2
        obtain ⟨⟨⟨i, s⟩, hi⟩, h1, h2⟩ := e
        obtain ⟨⟨⟨j, t⟩, hj⟩, h3, h4⟩ := f
        obtain rfl : i = 0 := hi
        obtain rfl : j = 0 := hj
        have h := h3.trans h2.symm
        apply Subtype.ext
        cases s <;> cases t <;> first | rfl | simp [Γ, SerreGraph.tgt_def] at h

/-- The spanning tree formed by the `a`-edge in the graph with an `a`-edge out of the base
vertex and a `b`-edge and a `c`-edge back. -/
def abAcTree : (ofDigraph (0 : Fin 2) ![0, 1, 1] ![1, 0, 0] ![a, b, c]).graph.SpanningTree where
  darts := {e | e.1 = 0}
  rev_mem _ h := h
  isTree := abAc_restrict_isTree a b c

@[simp] theorem abAcTree_darts : (abAcTree a b c).darts = {e | e.1 = 0} := (rfl)

private theorem read_path_of_mem {T : (abAc a b c).graph.SpanningTree}
    (hT : ((0 : Fin 3), true) ∈ T.darts) : (abAc a b c).read (T.path 0 1) = FreeGroup.of a :=
  (congrArg (abAc a b c).read (T.path_src_tgt (e := ((0 : Fin 3), true)) hT)).trans
    (by rw [read_toPath]; simp [← FreeGroup.of.eq_1])

private theorem treeLoopWord_of_mem {T : (abAc a b c).graph.SpanningTree}
    (hT : ((0 : Fin 3), true) ∈ T.darts) {e : (abAc a b c).graph.E} {x : α}
    (hs : (abAc a b c).graph.src e = 1) (ht : (abAc a b c).graph.tgt e = 0)
    (hl : (abAc a b c).label e = (x, true)) :
    (abAc a b c).treeLoopWord T 0 e = FreeGroup.of a * FreeGroup.of x := by
  rw [treeLoopWord_eq, hs, ht, T.path_self, read_nil, mul_one, read_path_of_mem a b c hT, hl,
    ← FreeGroup.of.eq_1]

/-- In the graph with an `a`-edge out of the base vertex and a `b`-edge and a `c`-edge back, let
`T` be a spanning tree containing the `a`-edge, such as `StallingsGraph.abAcTree`. The tree
loops through the positive edges outside `T` read `a b` and `a c`. For `b ≠ c` this graph is
the Stallings graph of `[a b, a c]` and is folded, so these words form the free basis
`StallingsGraph.freeGroupBasis` of its accepted subgroup for `T` and the orientation by forward
edges. -/
theorem image_treeLoopWord_ab_ac
    {T : (ofDigraph (0 : Fin 2) ![0, 1, 1] ![1, 0, 0] ![a, b, c]).graph.SpanningTree}
    (hT : ((0 : Fin 3), true) ∈ T.darts) :
    (ofDigraph (0 : Fin 2) ![0, 1, 1] ![1, 0, 0] ![a, b, c]).treeLoopWord T 0 ''
        ({e | e.2 = true} \ T.darts) =
      {FreeGroup.of a * FreeGroup.of b, FreeGroup.of a * FreeGroup.of c} := by
  have hb := treeLoopWord_of_mem a b c hT (e := ((1 : Fin 3), true)) (x := b) rfl rfl rfl
  have hc := treeLoopWord_of_mem a b c hT (e := ((2 : Fin 3), true)) (x := c) rfl rfl rfl
  -- Tree darts have trivial tree-loop words, so the `b`- and `c`-edges lie outside `T`.
  have hne : ∀ x : α, FreeGroup.of a * FreeGroup.of x ≠ 1 := fun x h => by
    simpa [← ofAdd_add] using congrArg (FreeGroup.lift fun _ => Multiplicative.ofAdd (1 : ℤ)) h
  have h1 : ((1 : Fin 3), true) ∉ T.darts := fun h => hne b (hb ▸ treeLoopWord_eq_one _ T 0 h)
  have h2 : ((2 : Fin 3), true) ∉ T.darts := fun h => hne c (hc ▸ treeLoopWord_eq_one _ T 0 h)
  have hO : ({e | e.2 = true} \ T.darts : Set (abAc a b c).graph.E) =
      {((1 : Fin 3), true), ((2 : Fin 3), true)} := by
    ext ⟨i, s⟩
    fin_cases i <;> cases s <;> simp [hT, h1, h2]
  rw [hO, Set.image_pair, hb, hc]

/-- For distinct letters `b` and `c`, the words `a b` and `a c` freely generate a subgroup of the
free group. -/
theorem lift_ab_ac_injective (hbc : b ≠ c) :
    Function.Injective (FreeGroup.lift ![FreeGroup.of a * FreeGroup.of b,
      FreeGroup.of a * FreeGroup.of c]) := by
  let O : Set (abAc a b c).graph.E := {e | e.2 = true}
  have hO : (abAc a b c).graph.IsOrientation O :=
    (SerreGraph.isOrientation_iff _ _).mpr <| by rintro ⟨i, _ | _⟩ <;> simp [O]
  -- The positive `b`- and `c`-edges are the darts outside the tree.
  let φ : Fin 2 → ↥(O \ (abAcTree a b c).darts) := fun i =>
    ⟨(i.succ, true), rfl, Fin.succ_ne_zero i⟩
  have hφ : Function.Injective φ := fun i j h => Fin.succ_injective _ (congrArg (·.1.1) h)
  have key : FreeGroup.lift ![FreeGroup.of a * FreeGroup.of b, FreeGroup.of a * FreeGroup.of c] =
      (FreeGroup.lift fun e : ↥(O \ (abAcTree a b c).darts) =>
        (abAc a b c).treeLoopWord (abAcTree a b c) 0 e.1).comp (FreeGroup.map φ) := by
    ext i
    simp only [FreeGroup.lift_apply_of, MonoidHom.comp_apply, FreeGroup.map.of]
    fin_cases i <;> exact (treeLoopWord_of_mem a b c (T := abAcTree a b c) rfl rfl rfl rfl).symm
  rw [key]
  exact ((abAc a b c).lift_treeLoopWord_injective _ 0 (abAc_isFolded a b c hbc) hO).comp
    (FreeGroup.map_injective hφ)

/-- For distinct letters `b` and `c`, the element `b⁻¹ c` lies in the subgroup generated by
`a b` and `a c`, with the expression `(a b)⁻¹ (a c)` in these free generators and with no
other. -/
theorem lift_ab_ac_eq_inv_mul_iff (hbc : b ≠ c) {x : FreeGroup (Fin 2)} :
    FreeGroup.lift ![FreeGroup.of a * FreeGroup.of b, FreeGroup.of a * FreeGroup.of c] x =
        (FreeGroup.of b)⁻¹ * FreeGroup.of c ↔
      x = (FreeGroup.of 0)⁻¹ * FreeGroup.of 1 := by
  rw [← (lift_ab_ac_injective a b c hbc).eq_iff]
  simp [mul_assoc]

/-! ### The words `a²` and `a³` -/

/-- The graph with one vertex and one loop labelled `a`. -/
private abbrev petal : StallingsGraph α :=
  ofDigraph () (fun _ : Unit => ()) (fun _ => ()) fun _ => a

private theorem petal_isCore : (petal a).graph.IsCore () := by
  apply ofDigraph_isCore
  · exact fun _ => ((petal a).graph.exists_path_darts_eq [] rfl).nonempty
  · exact fun _ => (petal a).graph.mem_coreDarts_of_isChain _ (l := [((), true)]) rfl
      (by simp) (by simp)

/-- The Stallings graph of the words `a²` and `a³` is a single loop labelled `a`: these words
generate the same subgroup as `a`. -/
theorem nonempty_iso_stallingsGraph_sq_cube :
    Nonempty (Iso (stallingsGraph
        [[(a, true), (a, true)], [(a, true), (a, true), (a, true)]])
      (ofDigraph () (fun _ : Unit => ()) (fun _ => ()) fun _ => a)) := by
  refine nonempty_iso_stallingsGraph_ofDigraph
    ((ofDigraph_isFolded_iff _ _ _ _).mpr ⟨fun _ _ _ _ => rfl, fun _ _ _ _ => rfl⟩)
    (petal_isCore a) ?_ (fun _ => 1) (one_mem _) fun _ => ?_
  · simp only [List.forall_mem_cons, List.not_mem_nil, false_imp_iff, implies_true, and_true]
    exact ⟨(petal a).mk_map_label_mem_subgroup [((), true), ((), true)] rfl,
      (petal a).mk_map_label_mem_subgroup [((), true), ((), true), ((), true)] rfl⟩
  · have h₂ : FreeGroup.of a * FreeGroup.of a ∈ Subgroup.closure {g : FreeGroup α | ∃ w ∈
        [[(a, true), (a, true)], [(a, true), (a, true), (a, true)]], FreeGroup.mk w = g} :=
      Subgroup.subset_closure ⟨[(a, true), (a, true)], by simp, by simp [FreeGroup.of]⟩
    have h₃ : FreeGroup.of a * FreeGroup.of a * FreeGroup.of a ∈ Subgroup.closure
        {g : FreeGroup α | ∃ w ∈
          [[(a, true), (a, true)], [(a, true), (a, true), (a, true)]], FreeGroup.mk w = g} :=
      Subgroup.subset_closure
        ⟨[(a, true), (a, true), (a, true)], by simp, by simp [FreeGroup.of]⟩
    simpa [mul_assoc] using Subgroup.mul_mem _ h₃ (Subgroup.inv_mem _ h₂)

/-! ### The word `b a b⁻¹` -/

/-- The graph with a `b`-edge from the base vertex to a second vertex carrying a loop
labelled `a`. -/
private abbrev lollipop : StallingsGraph α :=
  ofDigraph (0 : Fin 2) ![0, 1] ![1, 1] ![b, a]

private theorem lollipop_isFolded (hab : a ≠ b) : (lollipop a b).IsFolded := by
  rw [ofDigraph_isFolded_iff]
  constructor <;> intro i j <;> fin_cases i <;> fin_cases j <;> simp [hab, hab.symm]

private theorem lollipop_isCore : (lollipop a b).graph.IsCore (0 : Fin 2) := by
  apply ofDigraph_isCore
  · intro v
    fin_cases v
    · exact ((lollipop a b).graph.exists_path_darts_eq [] rfl).nonempty
    · exact ((lollipop a b).graph.exists_path_darts_eq [(0, true)] rfl).nonempty
  · intro i
    fin_cases i <;>
      exact (lollipop a b).graph.mem_coreDarts_of_isChain _
        (l := [(0, true), (1, true), (0, false)]) rfl (by simp) (by simp)

/-- The graph of `b a b⁻¹` does not accept `a` at its base vertex: no loop labelled `a` is
attached there. -/
private theorem of_notMem_subgroup_lollipop (hab : a ≠ b) :
    FreeGroup.of a ∉ (lollipop a b).subgroup (0 : Fin 2) := by
  classical
  intro h
  obtain ⟨p, hp, hr⟩ := (lollipop a b).mem_subgroup_iff_exists_reduced_path.mp h
  have hw : (lollipop a b).word p = [(a, true)] := by
    rw [← (lollipop_isFolded a b hab).toWord_read_eq_word _ p hp, hr, FreeGroup.toWord_of]
  rw [word_eq_map_darts, List.map_eq_singleton_iff] at hw
  obtain ⟨e, he, hl⟩ := hw
  have hs := Path.src_eq_of_mem_head?_darts _ p (e := e) (by simp [he])
  obtain ⟨i, s⟩ := e
  fin_cases i <;> cases s <;> simp_all

/-- The Stallings graph of the word `b a b⁻¹`, for `a ≠ b`, is a loop labelled `a` joined to
the base vertex by a `b`-edge. -/
theorem nonempty_iso_stallingsGraph_conj (hab : a ≠ b) :
    Nonempty (Iso (stallingsGraph [[(b, true), (a, true), (b, false)]])
      (ofDigraph (0 : Fin 2) ![0, 1] ![1, 1] ![b, a])) := by
  refine nonempty_iso_stallingsGraph_ofDigraph (lollipop_isFolded a b hab)
    (lollipop_isCore a b) ?_ ![1, FreeGroup.of b] (one_mem _) ?_
  · simp only [List.forall_mem_cons, List.not_mem_nil, false_imp_iff, implies_true, and_true]
    exact (lollipop a b).mk_map_label_mem_subgroup [(0, true), (1, true), (0, false)] rfl
  · intro i
    fin_cases i
    · simp
    · exact Subgroup.subset_closure ⟨[(b, true), (a, true), (b, false)], by simp,
        by simp [FreeGroup.of, FreeGroup.inv_mk, FreeGroup.invRev]⟩

/-- The Stallings graph of the word `b a b⁻¹`, for `a ≠ b`, has two vertices: its base vertex
is kept although it has degree one. -/
theorem natCard_vertex_stallingsGraph_conj (hab : a ≠ b) :
    Nat.card (stallingsGraph [[(b, true), (a, true), (b, false)]]).graph.V = 2 := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_conj a b hab
  simpa using Nat.card_congr f.vertexEquiv

/-- The Stallings graph of the word `b a b⁻¹`, for `a ≠ b`, does not accept `a`. Deleting its
base vertex, which has degree one, would leave a single loop labelled `a` and change the
accepted subgroup. -/
theorem of_notMem_subgroup_stallingsGraph_conj (hab : a ≠ b) :
    FreeGroup.of a ∉ (stallingsGraph [[(b, true), (a, true), (b, false)]]).subgroup
      (stallingsGraph [[(b, true), (a, true), (b, false)]]).base := by
  obtain ⟨f⟩ := nonempty_iso_stallingsGraph_conj a b hab
  rw [f.subgroup_eq]
  exact of_notMem_subgroup_lollipop a b hab

end TauCeti.StallingsGraph
