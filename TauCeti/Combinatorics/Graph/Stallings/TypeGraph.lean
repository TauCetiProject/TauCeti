/-!
# Type graphs and conjugacy of subgroups of free groups

The type graph of a labelled graph is its part that does not depend on a base vertex: the darts
on cyclically reduced closed paths and the vertices carrying such a path. For a based core this
is the type of Kapovich and Myasnikov. When two distinct darts leave the base vertex nothing is
removed (`StallingsGraph.nonempty_unbasedIso_typeGraph_self`); otherwise, unless the core is
acyclic, exactly the path hanging from the base vertex is removed
(`SerreGraph.IsCore.notMem_cyclicDarts_iff`, `SerreGraph.IsCore.notMem_cyclicVertices_iff`). When
there is no cyclically reduced closed path, as for the graph of the trivial subgroup, the base
vertex alone is kept.

In terms of degrees, as Kapovich and Myasnikov define it: the base vertex of a core is deleted
exactly when it has degree one (`StallingsGraph.base_mem_typeVertices_iff`), and nothing is
deleted otherwise, that is when every vertex has degree at least two or the core is a single
vertex (`StallingsGraph.nonempty_unbasedIso_typeGraph_self_of_degree_ne_one`); the latter happens
for a folded core exactly when it accepts the trivial subgroup
(`StallingsGraph.IsFolded.subgroup_eq_bot_iff_isAcyclic`). When the base vertex has degree one,
the vertices deleted are those of the path from it to the first vertex of degree at least three,
other than that vertex (`StallingsGraph.notMem_typeVertices_iff_of_three_le_degree`).

The type graph has no distinguished vertex. Since labelled graphs carry a base vertex,
`StallingsGraph.typeGraph` takes the vertex to be used as a parameter, and type graphs are
compared by isomorphisms that need not preserve it.

## Main results

* `StallingsGraph.typeGraph_subgroup`: the type graph accepts the same subgroup as the ambient
  graph at each of its vertices;
* `StallingsGraph.typeGraph_isCore`: the type graph of a preconnected graph is a core at each of
  its vertices;
* `StallingsGraph.notMem_typeVertices_iff_of_three_le_degree`: the type graph of a core whose
  base vertex has degree one omits exactly the path to the first vertex of degree at least three;
* `StallingsGraph.nonempty_unbasedIso_typeGraph_self_of_degree_ne_one`: otherwise the core is its
  own type graph;
* `StallingsGraph.UnbasedIso.nonempty_unbasedIso_typeGraph`: isomorphic labelled graphs have
  isomorphic type graphs, whatever their base vertices;
* `StallingsGraph.nonempty_unbasedIso_typeGraph_iff`: two folded preconnected labelled graphs
  have isomorphic type graphs if and only if they accept conjugate subgroups;
* `Subgroup.nonempty_unbasedIso_typeGraph_subgroupGraph_iff`: two subgroups of a free group are
  conjugate if and only if the type graphs of their subgroup graphs are isomorphic;
* `StallingsGraph.nonempty_unbasedIso_typeGraph_subgroupGraph_zpowers_mul_comm` and
  `StallingsGraph.not_nonempty_iso_subgroupGraph_zpowers_of_mul_of`: the subgroup graphs of the
  cyclic subgroups generated by `a b` and by `b a` are not isomorphic as based graphs, but their
  type graphs are.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*, Section 7,
  Definition 7.3, Remark 7.4, Lemmas 7.5 and 7.6 and Proposition 7.7.
-/
public section

namespace TauCeti.StallingsGraph

variable {α : Type*} (S : StallingsGraph α)

/-- The vertices of the type graph: those on a nonempty cyclically reduced closed path, or the
base vertex alone when the graph is acyclic. -/
def typeVertices : Set S.graph.V :=
  {a | a ∈ S.graph.cyclicVertices ∨ S.graph.IsAcyclic ∧ a = S.base}

theorem mem_typeVertices_iff (a : S.graph.V) :
    a ∈ S.typeVertices ↔ a ∈ S.graph.cyclicVertices ∨ S.graph.IsAcyclic ∧ a = S.base := Iff.rfl

theorem typeVertices_eq_cyclicVertices (h : ¬ S.graph.IsAcyclic) :
    S.typeVertices = S.graph.cyclicVertices := by
  ext a
  simp [mem_typeVertices_iff, h]

/-- In an acyclic graph, the type graph keeps the base vertex alone. -/
theorem typeVertices_eq_singleton (h : S.graph.IsAcyclic) : S.typeVertices = {S.base} := by
  ext a
  simp [mem_typeVertices_iff, h, S.graph.cyclicVertices_eq_empty_iff.mpr h]

theorem typeVertices_nonempty : S.typeVertices.Nonempty := by
  by_cases h : S.graph.IsAcyclic
  · exact ⟨S.base, Or.inr ⟨h, rfl⟩⟩
  · rw [S.typeVertices_eq_cyclicVertices h]
    exact Set.nonempty_iff_ne_empty.mpr (mt S.graph.cyclicVertices_eq_empty_iff.mp h)

theorem src_mem_typeVertices {e : S.graph.E} (he : e ∈ S.graph.cyclicDarts) :
    S.graph.src e ∈ S.typeVertices :=
  Or.inl (S.graph.src_mem_cyclicVertices he)

/-- If the base vertex of a based core belongs to the type graph, then so does every vertex. The
base belongs to it when it lies on a cyclically reduced closed path, in particular when two
distinct darts leave it, and when the core is acyclic. -/
theorem typeVertices_eq_univ (hS : S.graph.IsCore S.base) (h : S.base ∈ S.typeVertices) :
    S.typeVertices = Set.univ := by
  refine Set.eq_univ_of_forall fun a => ?_
  rcases h with h | ⟨h, -⟩
  · exact Or.inl (hS.cyclicVertices_eq_univ h ▸ Set.mem_univ a)
  · exact Or.inr ⟨h, hS.eq_of_isAcyclic h a⟩

/-- A reduced closed path at a vertex of the type graph only traverses darts on cyclically
reduced closed paths. -/
theorem mem_cyclicDarts_of_mem_typeVertices {a : S.graph.V} (ha : a ∈ S.typeVertices)
    {p : S.graph.Path a a} (hp : SerreGraph.Path.IsReduced S.graph p) {e : S.graph.E}
    (he : e ∈ SerreGraph.Path.darts S.graph p) : e ∈ S.graph.cyclicDarts := by
  rcases ha with ha | ⟨h, -⟩
  · exact S.graph.mem_cyclicDarts_of_isReduced ha ha hp he
  · rw [S.graph.isAcyclic_iff.mp h a p hp] at he
    simp at he

/-- The underlying graph of the type graph: the subgraph on the darts on cyclically reduced
closed paths and the vertices `S.typeVertices`. -/
abbrev typeSubgraph : SerreGraph :=
  S.graph.subgraph S.typeVertices S.graph.cyclicDarts (fun _ => S.src_mem_typeVertices)
    fun e => (S.graph.rev_mem_cyclicDarts_iff e).mpr

/-- The type graph, based at one of its vertices `u`: the graph `S.typeSubgraph` with the labels
of the ambient graph. -/
@[expose] def typeGraph (u : S.typeVertices) : StallingsGraph α where
  graph := S.typeSubgraph
  base := u
  label := fun e => S.label e.1
  label_rev := fun e => S.label_rev e.1

@[simp] theorem typeGraph_graph (u : S.typeVertices) : (S.typeGraph u).graph = S.typeSubgraph :=
  (rfl)

@[simp] theorem typeGraph_base (u : S.typeVertices) : (S.typeGraph u).base = u := (rfl)

@[simp] theorem typeGraph_label (u : S.typeVertices) (e : (S.typeGraph u).graph.E) :
    (S.typeGraph u).label e = S.label e.1 := (rfl)

instance (u : S.typeVertices) [Finite S.typeVertices] : Finite (S.typeGraph u).graph.V :=
  inferInstanceAs (Finite S.typeSubgraph.V)

instance (u : S.typeVertices) [Finite S.graph.cyclicDarts] : Finite (S.typeGraph u).graph.E :=
  inferInstanceAs (Finite S.typeSubgraph.E)

/-- The type graphs at two vertices differ only in their base vertex. -/
@[simp] theorem typeGraph_withBase (u v : S.typeVertices) :
    (S.typeGraph u).withBase v = S.typeGraph v := (rfl)

/-- Inclusion of the type graph into the ambient graph, based at the same vertex. -/
def typeInclusion (u : S.typeVertices) : (S.typeGraph u).Hom (S.withBase u.1) where
  graphHom := (S.graph.subgraphInclusion _ _ _ _ : S.typeSubgraph.Hom S.graph)
  map_base := rfl
  map_label := fun _ => rfl

@[simp] theorem typeInclusion_graphHom (u : S.typeVertices) :
    (S.typeInclusion u).graphHom =
      (S.graph.subgraphInclusion _ _ _ _ : S.typeSubgraph.Hom S.graph) := (rfl)

/-- The type graph of a folded graph is folded. -/
theorem IsFolded.typeGraph (hS : S.IsFolded) (u : S.typeVertices) : (S.typeGraph u).IsFolded :=
  (S.typeGraph u).isFolded_def.mpr fun e f hs hl =>
    Subtype.ext ((S.isFolded_def.mp hS) e.1 f.1 (congrArg Subtype.val hs) hl)

/-- The type graph of a preconnected graph is a core at each of its vertices. -/
theorem typeGraph_isCore (hS : S.graph.Preconnected) (u : S.typeVertices) :
    (S.typeGraph u).graph.IsCore (S.typeGraph u).base := by
  by_cases h : S.graph.IsAcyclic
  · -- The type graph is the base vertex alone, without darts.
    have hV := S.typeVertices_eq_singleton h
    obtain ⟨u, hu⟩ := u
    obtain rfl : u = S.base := by simpa [hV] using hu
    refine (SerreGraph.isCore_iff _ _).mpr
      ⟨fun ⟨a, ha⟩ => ?_, fun e => absurd e.2 (by simp [h.cyclicDarts_eq_empty])⟩
    obtain rfl : a = S.base := by simpa [hV] using ha
    exact ⟨.nil⟩
  · -- The type graph is the based core at `u`, up to rewriting its vertex and dart sets.
    have hu : u.1 ∈ S.graph.cyclicVertices := S.typeVertices_eq_cyclicVertices h ▸ u.2
    have key : ∀ (A : Set S.graph.V) (D : Set S.graph.E) hsrc hrev (hu : u.1 ∈ A),
        S.graph.coreVertices u.1 = A → S.graph.coreDarts u.1 = D →
          (S.graph.subgraph A D hsrc hrev).IsCore ⟨u.1, hu⟩ := by
      rintro _ _ _ _ _ rfl rfl
      exact S.graph.core_isCore u.1
    exact (key _ _ _ _ u.2 ((hS.coreVertices_eq_cyclicVertices hu).trans
      (S.typeVertices_eq_cyclicVertices h).symm) (hS.coreDarts_eq_cyclicDarts hu) :
        S.typeSubgraph.IsCore u)

/-- The type graph of a preconnected graph is connected. -/
theorem typeGraph_connected (hS : S.graph.Preconnected) (u : S.typeVertices) :
    (S.typeGraph u).graph.Connected :=
  (S.typeGraph_isCore hS u).connected

/-- The type graph accepts, at each of its vertices, the same subgroup as the ambient graph. -/
@[simp] theorem typeGraph_subgroup (u a : S.typeVertices) :
    (S.typeGraph u).subgroup a = S.subgroup a.1 := by
  refine le_antisymm ?_ fun g hg => ?_
  · exact ((S.typeInclusion u).subgroup_le_subgroup_mapV a).trans (S.subgroup_withBase u.1 a.1).le
  · obtain ⟨p, hp, rfl⟩ := S.mem_subgroup_iff_exists_reduced_path.mp hg
    obtain ⟨q, hq⟩ : ∃ q : S.typeSubgraph.Path a a, _ := S.graph.exists_subgraph_path _ _ _ _ p
      (fun e he => S.mem_cyclicDarts_of_mem_typeVertices a.2 hp he) a.2 a.2
    -- The graph morphism underlying `typeInclusion` is this subgraph inclusion.
    exact (S.typeGraph u).mem_subgroup_iff.mpr ⟨q, ((S.typeInclusion u).read_mapPath q).symm.trans
      ((S.read_withBase u.1 _).trans (congrArg S.read hq))⟩

/-- A based core whose base vertex belongs to the type graph is its own type graph. This holds
when the base lies on a cyclically reduced closed path, in particular when two distinct darts
leave it, and when the core is acyclic. -/
theorem nonempty_unbasedIso_typeGraph_self (hS : S.graph.IsCore S.base)
    (h : S.base ∈ S.typeVertices) (u : S.typeVertices) :
    Nonempty (UnbasedIso (S.typeGraph u) S) :=
  ⟨{ vertexEquiv := Equiv.subtypeUnivEquiv fun a => S.typeVertices_eq_univ hS h ▸ Set.mem_univ a
     dartEquiv := Equiv.subtypeUnivEquiv fun e => h.elim
       (fun h => hS.cyclicDarts_eq_univ h ▸ Set.mem_univ e)
       fun h => (hS.isEmpty_of_isAcyclic h.1).elim e
     map_src := fun _ => rfl
     map_rev := fun _ => rfl
     map_label := fun _ => rfl }⟩

/-! ### The type graph in terms of degrees -/

/-- The base vertex of a based core is deleted in its type graph exactly when it has degree
one. -/
theorem base_mem_typeVertices_iff (hS : S.graph.IsCore S.base) :
    S.base ∈ S.typeVertices ↔ S.graph.degree S.base ≠ 1 := by
  rw [mem_typeVertices_iff, ← hS.two_le_degree_iff_mem_cyclicVertices,
    ← hS.degree_eq_zero_iff_isAcyclic, and_iff_left rfl]
  refine ⟨?_, fun h => ?_⟩
  · rintro (h | h) h1 <;> rw [h1] at h <;> revert h <;> decide
  · by_contra h'
    obtain ⟨h₂, h₀⟩ := not_or.mp h'
    exact h₀ (Order.lt_one_iff.mp (lt_of_le_of_ne
      (Order.le_of_lt_add_one (lt_of_not_ge h₂ : S.graph.degree S.base < 1 + 1)) h))

/-- A based core whose base vertex does not have degree one is its own type graph: either every
vertex has degree at least two, or the core is the base vertex alone. -/
theorem nonempty_unbasedIso_typeGraph_self_of_degree_ne_one (hS : S.graph.IsCore S.base)
    (h : S.graph.degree S.base ≠ 1) (u : S.typeVertices) :
    Nonempty (UnbasedIso (S.typeGraph u) S) :=
  S.nonempty_unbasedIso_typeGraph_self hS ((S.base_mem_typeVertices_iff hS).mpr h) u

/-- **The type graph deletes the hanging path.** Let the base vertex of a based core have degree
at most one, and let `q` be a path from it to the first vertex of degree at least three: every
vertex that `q` leaves, other than the base vertex, has degree at most two. The vertices outside
the type graph are exactly the vertices of `q` other than its end. The darts outside the type
graph are the darts of `q` and their reverses
(`SerreGraph.IsCore.notMem_cyclicDarts_iff_of_three_le_degree`). -/
theorem notMem_typeVertices_iff_of_three_le_degree (hS : S.graph.IsCore S.base)
    (hv : S.graph.degree S.base ≤ 1) {w : S.graph.V} {q : S.graph.Path S.base w}
    (hq : ∀ e ∈ SerreGraph.Path.darts S.graph q, S.graph.src e ≠ S.base →
      S.graph.degree (S.graph.src e) ≤ 2) (hw : 3 ≤ S.graph.degree w) (a : S.graph.V) :
    a ∉ S.typeVertices ↔ ∃ e ∈ SerreGraph.Path.darts S.graph q, S.graph.src e = a := by
  have hvC : S.base ∉ S.graph.cyclicVertices := fun h =>
    absurd ((hS.two_le_degree_iff_mem_cyclicVertices.mpr h).trans hv) (by decide)
  have hwC := hS.mem_cyclicVertices_of_three_le_degree hw
  rw [S.typeVertices_eq_cyclicVertices fun h =>
    (S.graph.cyclicVertices_eq_empty_iff.mpr h ▸ hwC : w ∈ (∅ : Set S.graph.V))]
  exact hS.notMem_cyclicVertices_iff hwC
    (fun _ he => SerreGraph.src_notMem_cyclicVertices_of_degree_le_two hvC hq he) a

/-! ### Invariance under isomorphisms -/

section Invariance

variable {S} {T : StallingsGraph α}

private theorem UnbasedIso.dartEquiv_mem_cyclicDarts (f : UnbasedIso S T) {e : S.graph.E}
    (he : e ∈ S.graph.cyclicDarts) : f.dartEquiv e ∈ T.graph.cyclicDarts := by
  simpa using f.toGraphHom.map_mem_cyclicDarts _ f.toGraphHom_mapE_injective he

private theorem UnbasedIso.vertexEquiv_mem_cyclicVertices (f : UnbasedIso S T) {a : S.graph.V}
    (ha : a ∈ S.graph.cyclicVertices) : f.vertexEquiv a ∈ T.graph.cyclicVertices := by
  simpa using f.toGraphHom.map_mem_cyclicVertices _ f.toGraphHom_mapE_injective ha

/-- An isomorphism of labelled graphs preserves the darts on cyclically reduced closed paths. -/
@[simp] theorem UnbasedIso.dartEquiv_mem_cyclicDarts_iff (f : UnbasedIso S T) (e : S.graph.E) :
    f.dartEquiv e ∈ T.graph.cyclicDarts ↔ e ∈ S.graph.cyclicDarts :=
  ⟨fun h => by simpa using f.symm.dartEquiv_mem_cyclicDarts h, f.dartEquiv_mem_cyclicDarts⟩

/-- An isomorphism of labelled graphs preserves the vertices on cyclically reduced closed
paths. -/
@[simp] theorem UnbasedIso.vertexEquiv_mem_cyclicVertices_iff (f : UnbasedIso S T) (a : S.graph.V) :
    f.vertexEquiv a ∈ T.graph.cyclicVertices ↔ a ∈ S.graph.cyclicVertices :=
  ⟨fun h => by simpa using f.symm.vertexEquiv_mem_cyclicVertices h,
    f.vertexEquiv_mem_cyclicVertices⟩

/-- Isomorphic labelled graphs are acyclic together. -/
theorem UnbasedIso.isAcyclic_iff (f : UnbasedIso S T) :
    S.graph.IsAcyclic ↔ T.graph.IsAcyclic := by
  rw [← SerreGraph.cyclicVertices_eq_empty_iff, ← SerreGraph.cyclicVertices_eq_empty_iff,
    Set.eq_empty_iff_forall_notMem, Set.eq_empty_iff_forall_notMem]
  exact ⟨fun h a ha => h _ ((f.symm.vertexEquiv_mem_cyclicVertices_iff a).mpr ha),
    fun h a ha => h _ ((f.vertexEquiv_mem_cyclicVertices_iff a).mpr ha)⟩

/-- Isomorphic labelled graphs have isomorphic type graphs, whatever their base vertices. -/
theorem UnbasedIso.nonempty_unbasedIso_typeGraph (f : UnbasedIso S T) (u : S.typeVertices)
    (u' : T.typeVertices) : Nonempty (UnbasedIso (S.typeGraph u) (T.typeGraph u')) := by
  by_cases h : S.graph.IsAcyclic
  · -- Both type graphs are a single vertex without darts.
    have h' := f.isAcyclic_iff.mp h
    have hSV : Subsingleton S.typeVertices := by rw [S.typeVertices_eq_singleton h]; infer_instance
    have hTV : Subsingleton T.typeVertices := by rw [T.typeVertices_eq_singleton h']; infer_instance
    have hS : IsEmpty S.graph.cyclicDarts := by simp [h.cyclicDarts_eq_empty]
    have hT : IsEmpty T.graph.cyclicDarts := by simp [h'.cyclicDarts_eq_empty]
    exact ⟨{
      vertexEquiv := @equivOfSubsingletonOfSubsingleton _ _ hSV hTV (fun _ => u') (fun _ => u)
      dartEquiv := @Equiv.equivOfIsEmpty _ _ hS hT
      map_src := fun e => hS.elim e
      map_rev := fun e => hS.elim e
      map_label := fun e => hS.elim e }⟩
  · have h' : ¬ T.graph.IsAcyclic := mt f.isAcyclic_iff.mpr h
    exact ⟨{
      vertexEquiv := f.vertexEquiv.subtypeEquiv fun a => by
        rw [S.typeVertices_eq_cyclicVertices h, T.typeVertices_eq_cyclicVertices h']
        exact (f.vertexEquiv_mem_cyclicVertices_iff a).symm
      dartEquiv := f.dartEquiv.subtypeEquiv fun e => (f.dartEquiv_mem_cyclicDarts_iff e).symm
      map_src := fun e => Subtype.ext (f.map_src e.1)
      map_rev := fun e => Subtype.ext (f.map_rev e.1)
      map_label := fun e => f.map_label e.1 }⟩

end Invariance

/-- The based core contains every vertex of the type graph of a preconnected graph. -/
theorem typeVertices_subset_coreVertices (hS : S.graph.Preconnected) :
    S.typeVertices ⊆ S.graph.coreVertices S.base := by
  rintro a (ha | ⟨-, rfl⟩)
  · exact hS.cyclicVertices_subset_coreVertices _ ha
  · simp

/-- A vertex of the based core of a preconnected graph belongs to the type graph of the core
exactly when it belongs to the type graph of the ambient graph. -/
theorem mem_typeVertices_core_iff (hS : S.graph.Preconnected) (a : S.core.graph.V) :
    a ∈ S.core.typeVertices ↔ a.1 ∈ S.typeVertices := by
  rw [mem_typeVertices_iff, mem_typeVertices_iff]
  exact or_congr (S.graph.mem_cyclicVertices_core_iff S.base a)
    (and_congr (hS.isAcyclic_core_iff S.base) Subtype.ext_iff)

/-- Passing to the based core of a preconnected graph does not change the type graph. -/
theorem nonempty_unbasedIso_typeGraph_core (hS : S.graph.Preconnected) (u : S.core.typeVertices)
    (u' : S.typeVertices) :
    Nonempty (UnbasedIso (S.core.typeGraph u) (S.typeGraph u')) := by
  let g : (S.core.typeGraph u).Hom
      (S.typeGraph ⟨u.1.1, (S.mem_typeVertices_core_iff hS u.1).mp u.2⟩) := {
    graphHom := {
      mapV := fun a => ⟨a.1.1, (S.mem_typeVertices_core_iff hS a.1).mp a.2⟩
      mapE := fun e => ⟨e.1.1, (S.graph.mem_cyclicDarts_core_iff S.base e.1).mp e.2⟩
      map_src := fun _ => rfl
      map_rev := fun _ => rfl }
    map_base := rfl
    map_label := fun _ => rfl }
  have hV : Function.Bijective g.graphHom.mapV :=
    ⟨fun a b h => by
      have h' : (g.graphHom.mapV a).1 = (g.graphHom.mapV b).1 := congrArg Subtype.val h
      exact Subtype.ext (Subtype.ext h'), fun a =>
      ⟨⟨⟨a.1, S.typeVertices_subset_coreVertices hS a.2⟩,
        (S.mem_typeVertices_core_iff hS _).mpr a.2⟩, rfl⟩⟩
  have hE : Function.Bijective g.graphHom.mapE :=
    ⟨fun a b h => by
      have h' : (g.graphHom.mapE a).1 = (g.graphHom.mapE b).1 := congrArg Subtype.val h
      exact Subtype.ext (Subtype.ext h'), fun e =>
      ⟨⟨⟨e.1, hS.cyclicDarts_subset_coreDarts S.base e.2⟩,
        (S.graph.mem_cyclicDarts_core_iff S.base _).mpr e.2⟩, rfl⟩⟩
  exact ⟨(g.toIso hV hE).toUnbasedIso.withBase u u'⟩

variable {S} {T : StallingsGraph α}

/-- If the type graphs of two preconnected labelled graphs are isomorphic, the subgroups
accepted at the base vertices are conjugate. -/
theorem UnbasedIso.exists_subgroup_eq_map_conj {u : S.typeVertices} {u' : T.typeVertices}
    (f : UnbasedIso (S.typeGraph u) (T.typeGraph u')) (hS : S.graph.Preconnected)
    (hT : T.graph.Preconnected) :
    ∃ g : FreeGroup α,
      T.subgroup T.base = (S.subgroup S.base).map (MulAut.conj g).toMonoidHom := by
  obtain ⟨p⟩ := S.graph.preconnected_iff.mp hS S.base u.1
  obtain ⟨q⟩ := T.graph.preconnected_iff.mp hT (f.vertexEquiv u).1 T.base
  have h : S.subgroup u.1 = T.subgroup (f.vertexEquiv u).1 :=
    (S.typeGraph_subgroup u u).symm.trans
      ((f.subgroup_eq u).trans (T.typeGraph_subgroup u' (f.vertexEquiv u)))
  refine ⟨(T.read q)⁻¹ * (S.read p)⁻¹, ?_⟩
  rw [T.subgroup_conj q, ← h, S.subgroup_conj p, Subgroup.map_map]
  congr 1
  ext x
  simp [mul_assoc]

/-- Folded based cores accepting conjugate subgroups have isomorphic type graphs: both are
based cores of the coset graph of one of the subgroups, at two of its vertices. -/
private theorem nonempty_unbasedIso_typeGraph_of_isCore (hS : S.IsFolded) (hT : T.IsFolded)
    (hSc : S.graph.IsCore S.base) (hTc : T.graph.IsCore T.base) {g : FreeGroup α}
    (h : T.subgroup T.base = (S.subgroup S.base).map (MulAut.conj g).toMonoidHom)
    (u : S.typeVertices) (u' : T.typeVertices) :
    Nonempty (UnbasedIso (S.typeGraph u) (T.typeGraph u')) := by
  let C := (S.subgroup S.base).cosetGraph
  have hC : C.graph.Preconnected :=
    (C.graph.connected_iff.mp (Subgroup.cosetGraph_connected _)).2
  -- The vertex `w` of the coset graph at which the conjugate subgroup is accepted.
  obtain ⟨w, hw⟩ : ∃ w, T.subgroup T.base = C.subgroup w := by
    obtain ⟨p, hp⟩ := Subgroup.cosetGraph_exists_path_read (S.subgroup S.base) C.base g⁻¹
    exact ⟨_, by rw [C.subgroup_conj p, hp, inv_inv, Subgroup.cosetGraph_subgroup, h]⟩
  obtain ⟨fS⟩ : Nonempty (Iso S C.core) := by
    have := nonempty_iso_subgroupGraph hS hSc
    rwa [Subgroup.subgroupGraph_def] at this
  obtain ⟨fT⟩ : Nonempty (Iso T (C.withBase w).core) :=
    (nonempty_iso_iff_subgroup_eq hT
      (((isFolded_withBase C w).mpr (Subgroup.cosetGraph_isFolded _)).core) hTc
      (core_isCore _)).mpr
      (hw.trans ((C.withBase w).core_subgroup.trans (C.subgroup_withBase w w)).symm)
  -- Compare all type graphs with the type graph of the coset graph.
  obtain ⟨u₁⟩ := C.core.typeVertices_nonempty.to_subtype
  obtain ⟨u₂⟩ := C.typeVertices_nonempty.to_subtype
  obtain ⟨u₃⟩ := (C.withBase w).typeVertices_nonempty.to_subtype
  obtain ⟨u₄⟩ := (C.withBase w).core.typeVertices_nonempty.to_subtype
  obtain ⟨f₁⟩ := fS.toUnbasedIso.nonempty_unbasedIso_typeGraph u u₁
  obtain ⟨f₂⟩ := C.nonempty_unbasedIso_typeGraph_core hC u₁ u₂
  obtain ⟨f₃⟩ := ((UnbasedIso.refl C).withBase w C.base).nonempty_unbasedIso_typeGraph u₃ u₂
  obtain ⟨f₄⟩ := (C.withBase w).nonempty_unbasedIso_typeGraph_core hC u₄ u₃
  obtain ⟨f₅⟩ := fT.toUnbasedIso.nonempty_unbasedIso_typeGraph u' u₄
  exact ⟨f₁.trans (f₂.trans (f₃.symm.trans (f₄.symm.trans f₅.symm)))⟩

/-- Folded preconnected labelled graphs accepting conjugate subgroups at their base vertices have
isomorphic type graphs. -/
theorem nonempty_unbasedIso_typeGraph_of_subgroup_eq_map_conj (hS : S.IsFolded) (hT : T.IsFolded)
    (hSc : S.graph.Preconnected) (hTc : T.graph.Preconnected) {g : FreeGroup α}
    (h : T.subgroup T.base = (S.subgroup S.base).map (MulAut.conj g).toMonoidHom)
    (u : S.typeVertices) (u' : T.typeVertices) :
    Nonempty (UnbasedIso (S.typeGraph u) (T.typeGraph u')) := by
  -- Pass to the based cores, which have the same type graphs and accepted subgroups.
  obtain ⟨s⟩ := S.core.typeVertices_nonempty.to_subtype
  obtain ⟨t⟩ := T.core.typeVertices_nonempty.to_subtype
  obtain ⟨f₁⟩ := S.nonempty_unbasedIso_typeGraph_core hSc s u
  obtain ⟨f₂⟩ := T.nonempty_unbasedIso_typeGraph_core hTc t u'
  obtain ⟨f⟩ := nonempty_unbasedIso_typeGraph_of_isCore hS.core hT.core S.core_isCore
    T.core_isCore (g := g) (by simpa using h) s t
  exact ⟨f₁.symm.trans (f.trans f₂)⟩

/-- **Conjugacy criterion.** Two folded preconnected labelled graphs have isomorphic type graphs
if and only if the subgroups they accept at their base vertices are conjugate. -/
theorem nonempty_unbasedIso_typeGraph_iff (hS : S.IsFolded) (hT : T.IsFolded)
    (hSc : S.graph.Preconnected) (hTc : T.graph.Preconnected) (u : S.typeVertices)
    (u' : T.typeVertices) :
    Nonempty (UnbasedIso (S.typeGraph u) (T.typeGraph u')) ↔
      ∃ g : FreeGroup α,
        T.subgroup T.base = (S.subgroup S.base).map (MulAut.conj g).toMonoidHom :=
  ⟨fun ⟨f⟩ => f.exists_subgroup_eq_map_conj hSc hTc,
    fun ⟨_, h⟩ => nonempty_unbasedIso_typeGraph_of_subgroup_eq_map_conj hS hT hSc hTc h u u'⟩

end TauCeti.StallingsGraph

namespace Subgroup

open TauCeti StallingsGraph

variable {α : Type*}

/-- **Conjugacy of subgroups of a free group.** Two subgroups are conjugate if and only if the
type graphs of their subgroup graphs are isomorphic as labelled graphs. -/
theorem nonempty_unbasedIso_typeGraph_subgroupGraph_iff (H K : Subgroup (FreeGroup α))
    (u : H.subgroupGraph.typeVertices) (u' : K.subgroupGraph.typeVertices) :
    Nonempty (UnbasedIso (H.subgroupGraph.typeGraph u) (K.subgroupGraph.typeGraph u')) ↔
      ∃ g : FreeGroup α, K = H.map (MulAut.conj g).toMonoidHom := by
  simpa using nonempty_unbasedIso_typeGraph_iff H.subgroupGraph_isFolded
    K.subgroupGraph_isFolded (H.subgroupGraph.graph.connected_iff.mp H.subgroupGraph_connected).2
    (K.subgroupGraph.graph.connected_iff.mp K.subgroupGraph_connected).2 u u'

end Subgroup

namespace TauCeti.StallingsGraph

open Subgroup

variable {α : Type*}

/-- The cyclic subgroups generated by `g * h` and by `h * g` have isomorphic type graphs. -/
theorem nonempty_unbasedIso_typeGraph_subgroupGraph_zpowers_mul_comm (g h : FreeGroup α)
    (u : (zpowers (g * h)).subgroupGraph.typeVertices)
    (u' : (zpowers (h * g)).subgroupGraph.typeVertices) :
    Nonempty (UnbasedIso ((zpowers (g * h)).subgroupGraph.typeGraph u)
      ((zpowers (h * g)).subgroupGraph.typeGraph u')) :=
  (nonempty_unbasedIso_typeGraph_subgroupGraph_iff _ _ u u').mpr
    ⟨g⁻¹, by rw [MonoidHom.map_zpowers]; simp⟩

/-- For distinct letters `a` and `b`, the subgroup graphs of the cyclic subgroups generated by
`a b` and by `b a` are not isomorphic as based labelled graphs. -/
theorem not_nonempty_iso_subgroupGraph_zpowers_of_mul_of {a b : α} (hab : a ≠ b) :
    ¬ Nonempty (Iso (zpowers (FreeGroup.of a * FreeGroup.of b)).subgroupGraph
      (zpowers (FreeGroup.of b * FreeGroup.of a)).subgroupGraph) := by
  rintro ⟨f⟩
  have h := f.subgroup_eq
  rw [subgroupGraph_subgroup, subgroupGraph_subgroup] at h
  exact subgroup_basepoint hab (by rw [twoCycle_subgroup_base, twoCycle_subgroup_mid, h])

end TauCeti.StallingsGraph
