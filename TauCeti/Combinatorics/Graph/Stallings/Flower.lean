/-!
# The flower of a finite list of words

A word contributes a polygonal petal whose successive darts carry its letters. All petals
meet at one base vertex. This is the finite graph from which folding constructs the Stallings
graph of the subgroup generated by the words.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*,
  Section 3, Proposition 3.8.
-/

public section

namespace TauCeti.StallingsGraph

variable {α : Type*}

/-- Vertices of the flower: `none` is the base vertex and `some ⟨i, j⟩` is the
`(j+1)`st interior vertex of petal `i`. -/
@[expose] def FlowerVertex (ws : List (List (α × Bool))) :=
  Option (Σ i : Fin ws.length, Fin (ws[i].length - 1))

/-- The signed darts of the petals. The Boolean selects the forward or reverse direction. -/
@[expose] def FlowerDart (ws : List (List (α × Bool))) :=
  (Σ i : Fin ws.length, Fin ws[i].length) × Bool

/-- The vertex at position `k` on petal `i`; positions outside the interior map to the base. -/
@[expose] def flowerPos (ws : List (List (α × Bool))) (i : Fin ws.length)
    (k : ℕ) : FlowerVertex ws :=
  if h : 0 < k ∧ k < ws[i].length then
    some ⟨i, ⟨k - 1, by omega⟩⟩ else none

/-- The based labelled flower with one polygonal petal per word. Empty words contribute no
edges, and a one-letter word contributes a loop at the base vertex. -/
@[expose] def flower (ws : List (List (α × Bool))) : StallingsGraph α where
  graph := {
    V := FlowerVertex ws
    E := FlowerDart ws
    src := fun e => if e.2 then flowerPos ws e.1.1 e.1.2.val
      else flowerPos ws e.1.1 (e.1.2.val + 1)
    rev := fun e => (e.1, !e.2)
    rev_rev := by intro ⟨e, b⟩; cases b <;> rfl
    rev_ne := by
      intro ⟨e, b⟩ h
      have hb := congrArg Prod.snd h
      cases b <;> simp at hb
  }
  base := none
  label := fun e => if e.2 then ws[e.1.1][e.1.2.val] else
    (ws[e.1.1][e.1.2.val].1, !ws[e.1.1][e.1.2.val].2)
  label_rev := by
    intro ⟨e, b⟩
    cases b <;> simp

@[simp] theorem flower_base (ws : List (List (α × Bool))) :
    (flower ws).base = none := rfl

@[simp] theorem flower_src_forward (ws : List (List (α × Bool)))
    (i : Fin ws.length) (j : Fin ws[i].length) :
    (flower ws).graph.src (⟨i, j⟩, true) = flowerPos ws i j.val := rfl

@[simp] theorem flower_src_reverse (ws : List (List (α × Bool)))
    (i : Fin ws.length) (j : Fin ws[i].length) :
    (flower ws).graph.src (⟨i, j⟩, false) = flowerPos ws i (j.val + 1) := rfl

@[simp] theorem flower_label_forward (ws : List (List (α × Bool)))
    (i : Fin ws.length) (j : Fin ws[i].length) :
    (flower ws).label (⟨i, j⟩, true) = ws[i][j.val] := rfl

@[simp] theorem flowerPos_zero (ws : List (List (α × Bool))) (i : Fin ws.length) :
    flowerPos ws i 0 = none := by
  exact dite_eq_right (by omega)

@[simp] theorem flowerPos_length (ws : List (List (α × Bool))) (i : Fin ws.length) :
    flowerPos ws i ws[i.val].length = none := by
  simp only [flowerPos, Fin.getElem_fin]
  exact dite_eq_right (by omega)

/-- An interior position is the corresponding vertex of its petal. -/
theorem flowerPos_of_pos_of_lt (ws : List (List (α × Bool))) (i : Fin ws.length)
    (k : ℕ) (h0 : 0 < k) (hk : k < ws[i].length) :
    flowerPos ws i k = some ⟨i, ⟨k - 1, by omega⟩⟩ := by
  exact dite_eq_left ⟨h0, hk⟩

@[simp] theorem flower_tgt_forward (ws : List (List (α × Bool)))
    (i : Fin ws.length) (j : Fin ws[i].length) :
    (flower ws).graph.tgt (⟨i, j⟩, true) = flowerPos ws i (j.val + 1) := by
  exact ((flower ws).graph.tgt_def (⟨i, j⟩, true)).trans (by rfl)

@[simp] theorem flower_tgt_reverse (ws : List (List (α × Bool)))
    (i : Fin ws.length) (j : Fin ws[i].length) :
    (flower ws).graph.tgt (⟨i, j⟩, false) = flowerPos ws i j.val := by
  exact ((flower ws).graph.tgt_def (⟨i, j⟩, false)).trans (by rfl)

@[simp] theorem flower_label_reverse (ws : List (List (α × Bool)))
    (i : Fin ws.length) (j : Fin ws[i].length) :
    (flower ws).label (⟨i, j⟩, false) =
      (ws[i][j.val].1, !ws[i][j.val].2) := rfl

/-- The forward dart at position `k` on petal `i`. -/
def flowerForwardHom (ws : List (List (α × Bool))) (i : Fin ws.length)
    (k : ℕ) (hk : k < ws[i].length) :
    @Quiver.Hom (flower ws).graph.V (flower ws).graph.toQuiver
      (flowerPos ws i k) (flowerPos ws i (k + 1)) :=
  ⟨(⟨i, ⟨k, hk⟩⟩, true),
    flower_src_forward ws i ⟨k, hk⟩, flower_tgt_forward ws i ⟨k, hk⟩⟩

/-- The one-edge path traversing the `k`th letter of petal `i`. -/
def flowerForward (ws : List (List (α × Bool))) (i : Fin ws.length)
    (k : ℕ) (hk : k < ws[i].length) :
    (flower ws).graph.Path (flowerPos ws i k) (flowerPos ws i (k + 1)) :=
  (flowerForwardHom ws i k hk).toPath

@[simp] theorem flower_word_forward (ws : List (List (α × Bool)))
    (i : Fin ws.length) (k : ℕ) (hk : k < ws[i].length) :
    (flower ws).word (flowerForward ws i k hk) = [ws[i][k]] := by
  simpa only [flowerForward, flowerForwardHom, flower_label_forward] using
    (flower ws).word_toPath (flowerForwardHom ws i k hk)

/-- Each prefix of a petal is read by a path from the base to its corresponding vertex. -/
theorem exists_flower_prefix (ws : List (List (α × Bool)))
    (i : Fin ws.length) (k : ℕ) (hk : k ≤ ws[i].length) :
    ∃ p : (flower ws).graph.Path (flower ws).base (flowerPos ws i k),
      (flower ws).word p = (ws[i]).take k := by
  induction k with
  | zero =>
      refine ⟨.nil, ?_⟩
      exact (flower ws).word_nil _
  | succ k ih =>
      have hk' : k ≤ ws[i].length := by omega
      have hlt : k < ws[i].length := by omega
      obtain ⟨p, hp⟩ := ih hk'
      refine ⟨p.comp (flowerForward ws i k hlt), ?_⟩
      rw [(flower ws).word_comp p (flowerForward ws i k hlt), hp,
        flower_word_forward]
      exact List.take_concat_get' _ _ hlt

/-- Every input word is read by a loop around its petal. -/
theorem mk_mem_flower_subgroup (ws : List (List (α × Bool)))
    (i : Fin ws.length) :
    FreeGroup.mk ws[i] ∈ (flower ws).subgroup (flower ws).base := by
  have hloop := exists_flower_prefix ws i ws[i].length le_rfl
  have hlen : ws[i].length = ws[i.val].length := by simp only [Fin.getElem_fin]
  rw [hlen, flowerPos_length] at hloop
  rw [← flower_base ws] at hloop
  obtain ⟨p, hp⟩ := hloop
  apply (flower ws).mem_subgroup_iff.mpr
  refine ⟨p, ?_⟩
  rw [(flower ws).read_eq_mk_word, hp]
  simp only [Fin.getElem_fin, List.take_length]

/-- The subgroup generated by the input words is accepted by their flower. -/
theorem closure_le_flower_subgroup (ws : List (List (α × Bool))) :
    Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} ≤
      (flower ws).subgroup (flower ws).base := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨w, hw, rfl⟩
  obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hw
  exact mk_mem_flower_subgroup ws i

private def flowerPotential (ws : List (List (α × Bool))) :
    FlowerVertex ws → FreeGroup α
  | none => 1
  | some ⟨i, j⟩ => FreeGroup.mk ((ws[i]).take (j.val + 1))

private theorem flowerPotential_pos (ws : List (List (α × Bool)))
    (i : Fin ws.length) (k : ℕ) (hk : k ≤ ws[i].length) :
    flowerPotential ws (flowerPos ws i k) =
      if k = ws[i].length then 1 else FreeGroup.mk ((ws[i]).take k) := by
  by_cases hlast : k = ws[i].length
  · simp [flowerPos, flowerPotential, hlast]
  · by_cases hzero : k = 0
    · subst k
      simp [flowerPos, flowerPotential, FreeGroup.one_eq_mk]
    · have h0 : 0 < k := by omega
      have hlt : k < ws[i].length := by omega
      have hpos := flowerPos_of_pos_of_lt ws i k h0 hlt
      rw [hpos]
      simp only [flowerPotential, ite_eq_right hlast]
      have heq : k - 1 + 1 = k := by omega
      rw [heq]

private theorem flowerPotential_step (ws : List (List (α × Bool)))
    (i : Fin ws.length) (j : Fin ws[i].length) :
    flowerPotential ws (flowerPos ws i j.val) * FreeGroup.mk [ws[i][j.val]] *
      (flowerPotential ws (flowerPos ws i (j.val + 1)))⁻¹ ∈
        Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} := by
  let H := Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g}
  have hj : j.val ≤ ws[i].length := Nat.le_of_lt j.isLt
  have hj1 : j.val + 1 ≤ ws[i].length := by omega
  rw [flowerPotential_pos ws i j.val hj,
    flowerPotential_pos ws i (j.val + 1) hj1]
  have hn : j.val ≠ ws[i].length := by omega
  rw [ite_eq_right hn]
  by_cases hlast : j.val + 1 = ws[i].length
  · rw [ite_eq_left hlast]
    simp only [inv_one, mul_one]
    rw [FreeGroup.mul_mk, List.take_concat_get' _ _ j.isLt, hlast, List.take_length]
    apply Subgroup.subset_closure
    exact ⟨ws[i], by simp, rfl⟩
  · rw [ite_eq_right hlast]
    rw [FreeGroup.mul_mk, List.take_concat_get' _ _ j.isLt]
    simpa only [mul_inv_cancel] using (Subgroup.one_mem H)

private theorem flowerPotential_edge (ws : List (List (α × Bool)))
    (e : (flower ws).graph.E) :
    flowerPotential ws ((flower ws).graph.src e) * FreeGroup.mk [(flower ws).label e] *
      (flowerPotential ws ((flower ws).graph.tgt e))⁻¹ ∈
        Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} := by
  obtain ⟨⟨i, j⟩, b⟩ := e
  cases b with
  | true =>
      simpa only [flower_src_forward, flower_tgt_forward, flower_label_forward] using
        flowerPotential_step ws i j
  | false =>
      have h := (Subgroup.inv_mem _ (flowerPotential_step ws i j))
      have hlabel : FreeGroup.mk [(flower ws).label (⟨i, j⟩, false)] =
          (FreeGroup.mk [ws[i][j.val]])⁻¹ := by
        simp [flower_label_reverse, FreeGroup.inv_mk, FreeGroup.invRev]
      simp only [flower_src_reverse, flower_tgt_reverse, hlabel]
      convert h using 1
      simp only [mul_inv_rev, inv_inv, mul_assoc]

private theorem flowerPotential_path (ws : List (List (α × Bool)))
    {a b : (flower ws).graph.V} (p : (flower ws).graph.Path a b) :
    flowerPotential ws a * (flower ws).read p * (flowerPotential ws b)⁻¹ ∈
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} := by
  induction p with
  | nil =>
      simpa only [(flower ws).read_nil, mul_one, mul_inv_cancel] using
        (Subgroup.one_mem (Subgroup.closure {g : FreeGroup α |
          ∃ w ∈ ws, FreeGroup.mk w = g}))
  | @cons b c p e ih =>
      have he := flowerPotential_edge ws e.1
      rw [e.2.1, e.2.2] at he
      have h := (Subgroup.closure {g : FreeGroup α |
        ∃ w ∈ ws, FreeGroup.mk w = g}).mul_mem ih he
      simpa only [(flower ws).read_cons, mul_assoc, inv_mul_cancel_left] using h

/-- The flower accepts exactly the subgroup generated by its input words. -/
theorem flower_subgroup (ws : List (List (α × Bool))) :
    (flower ws).subgroup (flower ws).base =
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} := by
  apply le_antisymm
  · intro g hg
    obtain ⟨p, rfl⟩ := (flower ws).mem_subgroup_iff.mp hg
    have h := flowerPotential_path ws p
    simpa only [flower_base, flowerPotential, one_mul, inv_one, mul_one] using h
  · exact closure_le_flower_subgroup ws

/-- The flower has finitely many vertices, regardless of the alphabet. -/
instance flower_finite_vertex (ws : List (List (α × Bool))) :
    Finite (flower ws).graph.V := by
  exact inferInstanceAs (Finite (Option (Σ i : Fin ws.length, Fin (ws[i].length - 1))))

/-- The flower has finitely many darts, regardless of the alphabet. -/
instance flower_finite_dart (ws : List (List (α × Bool))) :
    Finite (flower ws).graph.E := by
  exact inferInstanceAs (Finite ((Σ i : Fin ws.length, Fin ws[i].length) × Bool))

/-- Every vertex of the flower is reachable by a path from the base vertex. -/
theorem flower_reachable (ws : List (List (α × Bool)))
    (v : (flower ws).graph.V) : Nonempty ((flower ws).graph.Path (flower ws).base v) := by
  cases v with
  | none => exact ⟨.nil⟩
  | some p =>
      obtain ⟨i, j⟩ := p
      have hj : j.val + 1 < ws[i].length := by omega
      have hpos : flowerPos ws i (j.val + 1) = some ⟨i, j⟩ := by
        rw [flowerPos_of_pos_of_lt ws i (j.val + 1) (by omega) hj]
        congr 1
      have hk : j.val + 1 ≤ ws[i].length := by omega
      obtain ⟨p, -⟩ := exists_flower_prefix ws i (j.val + 1) hk
      simpa only [hpos] using (⟨p⟩ :
        Nonempty ((flower ws).graph.Path (flower ws).base
          (flowerPos ws i (j.val + 1))))

/-- The flower is connected, even for an empty list of words. -/
theorem flower_connected (ws : List (List (α × Bool))) :
    SerreGraph.Connected (flower ws).graph := by
  apply (SerreGraph.connected_iff (flower ws).graph).mpr
  refine ⟨⟨(flower ws).base⟩, ?_⟩
  rw [SerreGraph.preconnected_iff]
  intro a b
  obtain ⟨pa⟩ := flower_reachable ws a
  obtain ⟨pb⟩ := flower_reachable ws b
  exact ⟨pa.reverse.comp pb⟩

/-- The flower of an empty list accepts only the identity. -/
@[simp] theorem flower_nil_subgroup (α : Type*) :
    (flower ([] : List (List (α × Bool)))).subgroup none = ⊥ := by
  rw [← flower_base, flower_subgroup]
  simp

end TauCeti.StallingsGraph
