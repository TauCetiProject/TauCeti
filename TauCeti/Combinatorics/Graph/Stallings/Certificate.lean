module

public import TauCeti.Combinatorics.Graph.Stallings.Basis
public import TauCeti.Combinatorics.Graph.Stallings.Construction
public import TauCeti.Combinatorics.Graph.Stallings.Coset.Comparison
public import TauCeti.Combinatorics.Graph.Stallings.OfDigraph

/-!
# Recognising the Stallings graph of a list of words

The Stallings graph of a finite list of words is produced by a chosen sequence of folds, so
it is not given by an explicit formula. It is nevertheless determined up to based labelled
isomorphism: a folded based core graph is isomorphic to it as soon as it accepts the subgroup
generated by the words. This file gives criteria for that equality which can be checked on an
explicit graph.

That the graph accepts every word of the list is witnessed by closed paths. For the converse
inclusion, assign to every vertex `v` a group element `r v`, with `r` of the base vertex in the
subgroup `H` generated by the words. If `r (src e) * label e * (r (tgt e))⁻¹` lies in `H` for
one dart `e` of each reversal pair, then every closed path at the base reads an element of `H`
(`StallingsGraph.subgroup_le_of_forall_dart`). When `r v` is the reading of the path from the
base to `v` in a spanning tree, these elements are the tree-loop words, which gives the
criterion in terms of a spanning tree.

## Main statements

* `StallingsGraph.nonempty_iso_stallingsGraph_of_forall_dart`: the recognition criterion for
  `stallingsGraph ws` in terms of group elements at the vertices.
* `StallingsGraph.nonempty_iso_stallingsGraph_of_treeLoopWord`: the criterion in terms of the
  tree-loop words of a spanning tree.
* `StallingsGraph.nonempty_iso_stallingsGraph_ofDigraph`: the criterion for a graph presented
  by its positive edges.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*,
  Section 3, Proposition 3.8; Section 5, Theorem 5.2; Section 6, Lemma 6.1.
-/

public section

namespace TauCeti.StallingsGraph

variable {α : Type*} {S : StallingsGraph α} {ws : List (List (α × Bool))}

/-- A folded based core graph accepting every word of a list, and nothing outside the subgroup
they generate, is isomorphic to the Stallings graph of the list. -/
private theorem nonempty_iso_stallingsGraph_of_le (hS : S.IsFolded)
    (hc : S.graph.IsCore S.base) (hws : ∀ w ∈ ws, FreeGroup.mk w ∈ S.subgroup S.base)
    (h : S.subgroup S.base ≤
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g}) :
    Nonempty (Iso (stallingsGraph ws) S) := by
  rw [nonempty_iso_iff_subgroup_eq (stallingsGraph_isFolded ws) hS (stallingsGraph_isCore ws) hc,
    subgroup_stallingsGraph]
  refine le_antisymm ((Subgroup.closure_le _).mpr ?_) h
  rintro _ ⟨w, hw, rfl⟩
  exact hws w hw

/-- A folded based core graph is isomorphic to the Stallings graph of a list of words as soon
as it accepts every word of the list and there are group elements `r v` at its vertices, with
`r` of the base vertex in the subgroup generated by the words, such that
`r (src e) * label e * (r (tgt e))⁻¹` lies in that subgroup for one dart `e` of each reversal
pair. -/
theorem nonempty_iso_stallingsGraph_of_forall_dart (hS : S.IsFolded)
    (hc : S.graph.IsCore S.base) (hws : ∀ w ∈ ws, FreeGroup.mk w ∈ S.subgroup S.base)
    (r : S.graph.V → FreeGroup α) {O : Set S.graph.E} (hO : ∀ e, e ∈ O ∨ S.graph.rev e ∈ O)
    (hr : r S.base ∈ Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g})
    (h : ∀ e ∈ O, r (S.graph.src e) * FreeGroup.mk [S.label e] * (r (S.graph.tgt e))⁻¹ ∈
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g}) :
    Nonempty (Iso (stallingsGraph ws) S) :=
  nonempty_iso_stallingsGraph_of_le hS hc hws (S.subgroup_le_of_forall_dart r hO h hr)

/-- A folded based core graph is isomorphic to the Stallings graph of a list of words as soon
as it accepts every word of the list and, for some spanning tree and orientation, the
tree-loop word of every positive dart outside the tree lies in the subgroup generated by the
words. -/
theorem nonempty_iso_stallingsGraph_of_treeLoopWord (hS : S.IsFolded)
    (hc : S.graph.IsCore S.base) (hws : ∀ w ∈ ws, FreeGroup.mk w ∈ S.subgroup S.base)
    (T : S.graph.SpanningTree) {O : Set S.graph.E} (hO : S.graph.IsOrientation O)
    (h : ∀ e ∈ O \ T.darts, S.treeLoopWord T S.base e ∈
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g}) :
    Nonempty (Iso (stallingsGraph ws) S) := by
  refine nonempty_iso_stallingsGraph_of_le hS hc hws ?_
  rw [← S.range_lift_treeLoopWord T S.base hO]
  apply FreeGroup.range_lift_le
  rintro _ ⟨e, rfl⟩
  exact h e.1 e.2

/-- The recognition criterion for a graph presented by its positive edges: a folded core graph
of this form is isomorphic to the Stallings graph of a list of words as soon as it accepts
every word of the list and there are group elements `r v` at its vertices, with `r` of the
base vertex in the subgroup generated by the words, such that
`r (src i) * label i * (r (tgt i))⁻¹` lies in that subgroup for every edge `i`. -/
theorem nonempty_iso_stallingsGraph_ofDigraph {V ι : Type*} {base : V} {src tgt : ι → V}
    {label : ι → α} (hS : (ofDigraph base src tgt label).IsFolded)
    (hc : (ofDigraph base src tgt label).graph.IsCore base)
    (hws : ∀ w ∈ ws, FreeGroup.mk w ∈ (ofDigraph base src tgt label).subgroup base)
    (r : V → FreeGroup α)
    (hr : r base ∈ Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g})
    (h : ∀ i, r (src i) * FreeGroup.of (label i) * (r (tgt i))⁻¹ ∈
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g}) :
    Nonempty (Iso (stallingsGraph ws) (ofDigraph base src tgt label)) := by
  refine nonempty_iso_stallingsGraph_of_forall_dart (O := {e | e.2 = true}) hS hc hws r ?_ hr ?_
  · rintro ⟨i, _ | _⟩
    · exact Or.inr rfl
    · exact Or.inl rfl
  · rintro ⟨i, b⟩ rfl
    exact h i

end TauCeti.StallingsGraph
