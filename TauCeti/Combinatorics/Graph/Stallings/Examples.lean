module

public import TauCeti.Combinatorics.Graph.Stallings.Flower
public import TauCeti.Combinatorics.Graph.Stallings.Folded
public import TauCeti.GroupTheory.FreeGroup.Reduce
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
# Small labelled graphs and the subgroups they accept

Three labelled graphs that separate the notions around the subgroup accepted by a labelled
graph.

* `StallingsGraph.edge a` is a single edge labelled `a`. Its underlying graph is a tree, so it
  accepts the trivial subgroup at both vertices (`StallingsGraph.edge_subgroup_bot`).
* `StallingsGraph.twoLoops a` has one vertex and two loops, both labelled `a`. It is not folded,
  and crossing the first loop and then the second one backwards is a reduced path whose label
  `a a⁻¹` is not freely reduced (`StallingsGraph.unfolded_reads_nonreduced`). So reduced paths
  of a graph that is not folded need not have freely reduced labels.
* `StallingsGraph.twoCycle a b` is the cycle of length two with edges labelled `a` and `b`. It
  accepts the cyclic subgroups generated by `a b` and by `b a` at its two vertices. These are
  conjugate, and distinct when `a ≠ b` (`StallingsGraph.subgroup_basepoint`): the accepted
  subgroup depends on the base vertex.

The last two graphs are flowers, so their accepted subgroups at the base vertex come from
`StallingsGraph.flower_subgroup`.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*, Sections 2–3.
-/

public section

namespace TauCeti
namespace StallingsGraph

variable {α : Type*}

/-! ### A single edge -/

/-- The segment whose dart from the vertex `true` to the vertex `false` is labelled by `a`,
based at `true`. -/
@[expose] def edge (a : α) : StallingsGraph α where
  graph := SerreGraph.segment
  base := true
  label e := (a, e)
  label_rev _ := rfl

@[simp] theorem edge_graph (a : α) : (edge a).graph = SerreGraph.segment := rfl

@[simp] theorem edge_base (a : α) : (edge a).base = true := rfl

@[simp] theorem edge_label (a : α) (e : (edge a).graph.E) : (edge a).label e = (a, e) := rfl

/-- A single labelled edge accepts the trivial subgroup at both of its vertices. -/
theorem edge_subgroup_bot (a : α) (v : (edge a).graph.V) : (edge a).subgroup v = ⊥ :=
  (edge a).subgroup_eq_bot_of_isAcyclic (SerreGraph.IsTree.isAcyclic _ SerreGraph.segment_isTree) v

/-! ### Two loops with the same label -/

/-- The graph with one vertex and two loops, both labelled by `a`: the flower of the one-letter
word `a` taken twice. -/
abbrev twoLoops (a : α) : StallingsGraph α := flower [[(a, true)], [(a, true)]]

/-- The first loop of `twoLoops a`, traversed forwards. -/
private def twoLoopsFst (a : α) :
    @Quiver.Hom (twoLoops a).graph.V (twoLoops a).graph.toQuiver
      (twoLoops a).base (twoLoops a).base :=
  ⟨(⟨⟨0, Nat.zero_lt_two⟩, ⟨0, Nat.zero_lt_one⟩⟩, true), rfl, rfl⟩

/-- The second loop of `twoLoops a`, traversed backwards. -/
private def twoLoopsSnd (a : α) :
    @Quiver.Hom (twoLoops a).graph.V (twoLoops a).graph.toQuiver
      (twoLoops a).base (twoLoops a).base :=
  ⟨(⟨⟨1, Nat.one_lt_two⟩, ⟨0, Nat.zero_lt_one⟩⟩, false), rfl, rfl⟩

/-- In the graph with two loops labelled `a`, the first loop followed by the reverse of the
second is a reduced closed path with label `a a⁻¹`, which is not freely reduced. -/
theorem unfolded_reads_nonreduced (a : α) :
    ∃ p : (twoLoops a).graph.Path (twoLoops a).base (twoLoops a).base,
      SerreGraph.Path.IsReduced (twoLoops a).graph p ∧
        (twoLoops a).word p = [(a, true), (a, false)] := by
  refine ⟨(Quiver.Path.nil.cons (twoLoopsFst a)).cons (twoLoopsSnd a), ?_, ?_⟩
  · refine (SerreGraph.Path.isReduced_cons_cons _ _ _ _).mpr
      ⟨SerreGraph.Path.isReduced_toPath _ (twoLoopsFst a), fun h => ?_⟩
    exact Nat.one_ne_zero
      (congrArg (fun e : FlowerDart [[(a, true)], [(a, true)]] => e.1.1.val) h)
  · rw [word_cons, word_cons, word_nil]
    rfl

/-- The graph with two loops carrying the same label is not folded. -/
theorem twoLoops_not_isFolded (a : α) : ¬(twoLoops a).IsFolded := by
  intro h
  obtain ⟨p, hp, hw⟩ := unfolded_reads_nonreduced a
  have hred : FreeGroup.IsReduced [(a, true), (a, false)] := hw ▸ h.isReduced_word _ p hp
  simp [FreeGroup.IsReduced] at hred

/-! ### The cycle of length two -/

/-- The cycle of length two with edges labelled `a` and `b`: the flower of the single word
`a b`. Its base vertex is the origin of the edge labelled `a`. -/
abbrev twoCycle (a b : α) : StallingsGraph α := flower [[(a, true), (b, true)]]

/-- The vertex of the cycle of length two other than the base vertex: the terminus of the edge
labelled `a`. -/
abbrev twoCycleMid (a b : α) : (twoCycle a b).graph.V :=
  flowerPos [[(a, true), (b, true)]] ⟨0, Nat.zero_lt_one⟩ 1

variable (a b : α)

/-- At its base vertex, the cycle of length two labelled `a`, `b` accepts the cyclic subgroup
generated by `a b`. -/
theorem twoCycle_subgroup_base :
    (twoCycle a b).subgroup (twoCycle a b).base =
      Subgroup.zpowers (FreeGroup.of a * FreeGroup.of b) := by
  rw [flower_subgroup, Subgroup.zpowers_eq_closure]
  congr 1
  ext g
  simp [FreeGroup.of, eq_comm]

/-- The subgroups accepted at the two vertices of the cycle of length two are conjugate by the
label `a` of the edge from the base vertex to the other vertex. -/
theorem twoCycle_subgroup_mid_eq_map_conj :
    (twoCycle a b).subgroup (twoCycleMid a b) =
      ((twoCycle a b).subgroup (twoCycle a b).base).map
        (MulAut.conj (FreeGroup.of a)⁻¹).toMonoidHom := by
  obtain ⟨p, hp⟩ := exists_flower_prefix [[(a, true), (b, true)]] ⟨0, Nat.zero_lt_one⟩ 1
    (Nat.le_succ 1)
  have hread : (twoCycle a b).read p = FreeGroup.of a :=
    ((twoCycle a b).read_eq_mk_word p).trans (congrArg FreeGroup.mk hp)
  rw [← hread]
  exact (twoCycle a b).subgroup_conj p

/-- At its non-base vertex, the cycle of length two labelled `a`, `b` accepts the cyclic subgroup
generated by `b a`. -/
theorem twoCycle_subgroup_mid :
    (twoCycle a b).subgroup (twoCycleMid a b) =
      Subgroup.zpowers (FreeGroup.of b * FreeGroup.of a) := by
  rw [twoCycle_subgroup_mid_eq_map_conj, twoCycle_subgroup_base, MonoidHom.map_zpowers]
  congr 1
  simp

variable {a b}

/-- In the cycle of length two labelled `a`, `b` with `a ≠ b`, the subgroups accepted at the two
vertices are distinct, although they are conjugate. -/
theorem subgroup_basepoint (hab : a ≠ b) :
    (twoCycle a b).subgroup (twoCycle a b).base ≠ (twoCycle a b).subgroup (twoCycleMid a b) := by
  rw [twoCycle_subgroup_base, twoCycle_subgroup_mid]
  intro h
  -- Otherwise `b a` would be a power of `a b`, so the two would commute.
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp
    (h ▸ Subgroup.mem_zpowers (FreeGroup.of b * FreeGroup.of a))
  have hc : Commute (FreeGroup.of a * FreeGroup.of b) (FreeGroup.of b * FreeGroup.of a) :=
    hn ▸ (Commute.refl _).zpow_right n
  -- Both sides of `a b b a = b a a b` are reduced words, so they are equal letter by letter.
  have hw : [(a, true), (b, true), (b, true), (a, true)] =
      [(b, true), (a, true), (a, true), (b, true)] :=
    FreeGroup.IsReduced.eq_of_mk_eq (by simp [FreeGroup.IsReduced])
      (by simp [FreeGroup.IsReduced]) (by simpa [FreeGroup.of] using hc.eq)
  exact hab (congrArg Prod.fst (List.head_eq_of_cons_eq hw))

end StallingsGraph
end TauCeti
