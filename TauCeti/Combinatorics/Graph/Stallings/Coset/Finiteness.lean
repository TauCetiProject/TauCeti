public import TauCeti.Combinatorics.Graph.Stallings.Construction
public import TauCeti.Combinatorics.Graph.Stallings.Coset.Comparison

/-!
# Finite subgroup graphs and finitely generated subgroups

A folded based core graph is finite exactly when the subgroup it accepts is finitely
generated, and it is then isomorphic to the Stallings graph of any finite list of words
generating that subgroup. In particular the Stallings graph of a list of words depends,
up to based labelled isomorphism, only on the subgroup generated by the words: it is
unchanged by permuting the list, by inverting a word and by multiplying one word by another.
At the other extreme, the Stallings graph of the empty list is, up to based labelled
isomorphism, the graph with one vertex and no darts.

These statements are given for an arbitrary folded based core and then specialised to the
canonical subgroup graph `Subgroup.subgroupGraph`.

## References

* I. Kapovich and A. Myasnikov, *Stallings foldings and subgroups of free groups*,
  Section 3, Proposition 3.8; Section 5, Theorem 5.2, Definition 5.3 and Lemma 5.4;
  Section 7, Proposition 7.1.
-/

public section

namespace TauCeti.StallingsGraph

variable {α : Type*} {S : StallingsGraph α} {ws ws' : List (List (α × Bool))}

/-- The Stallings graph of a list of words is characterised among folded based cores by the
subgroup it accepts: a folded based core is isomorphic to it exactly when it accepts the
subgroup generated by the words. -/
theorem nonempty_iso_stallingsGraph_iff (hS : S.IsFolded) (hc : S.graph.IsCore S.base) :
    Nonempty (Iso (stallingsGraph ws) S) ↔
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} =
        S.subgroup S.base := by
  rw [nonempty_iso_iff_subgroup_eq (stallingsGraph_isFolded ws) hS (stallingsGraph_isCore ws) hc,
    subgroup_stallingsGraph]

/-- A folded based core accepting a finitely generated subgroup is isomorphic to the Stallings
graph of a finite list of words. -/
theorem exists_nonempty_iso_stallingsGraph (hS : S.IsFolded) (hc : S.graph.IsCore S.base)
    (h : (S.subgroup S.base).FG) :
    ∃ ws : List (List (α × Bool)), Nonempty (Iso (stallingsGraph ws) S) := by
  obtain ⟨ws, hws⟩ := exists_subgroup_stallingsGraph_eq h
  exact ⟨ws, (nonempty_iso_iff_subgroup_eq (stallingsGraph_isFolded ws) hS
    (stallingsGraph_isCore ws) hc).mpr hws⟩

/-- A folded based core has finitely many darts exactly when the subgroup it accepts is
finitely generated. No finiteness of the alphabet is assumed. -/
theorem IsFolded.finite_dart_iff_fg (hS : S.IsFolded) (hc : S.graph.IsCore S.base) :
    Finite S.graph.E ↔ (S.subgroup S.base).FG := by
  refine ⟨fun _ => S.subgroup_fg S.base, fun h => ?_⟩
  obtain ⟨ws, ⟨f⟩⟩ := exists_nonempty_iso_stallingsGraph hS hc h
  exact Finite.of_equiv _ f.dartEquiv

/-- A folded based core accepting a finitely generated subgroup has finitely many vertices. -/
theorem IsFolded.finite_vertex_of_fg (hS : S.IsFolded) (hc : S.graph.IsCore S.base)
    (h : (S.subgroup S.base).FG) : Finite S.graph.V := by
  obtain ⟨ws, ⟨f⟩⟩ := exists_nonempty_iso_stallingsGraph hS hc h
  exact Finite.of_equiv _ f.vertexEquiv

/-- Over a finite alphabet, a folded based core has finitely many vertices exactly when the
subgroup it accepts is finitely generated. The alphabet must be finite: the rose on an
infinite alphabet has one vertex and accepts the whole free group. -/
theorem IsFolded.finite_vertex_iff_fg [Finite α] (hS : S.IsFolded)
    (hc : S.graph.IsCore S.base) : Finite S.graph.V ↔ (S.subgroup S.base).FG :=
  ⟨fun _ => (hS.finite_dart_iff_fg hc).mp hS.finite_E, hS.finite_vertex_of_fg hc⟩

/-! ### Invariance of the Stallings graph of a list of words -/

/-- The Stallings graphs of two lists of words are isomorphic exactly when the lists generate
the same subgroup. -/
theorem nonempty_iso_stallingsGraph_iff_closure_eq :
    Nonempty (Iso (stallingsGraph ws) (stallingsGraph ws')) ↔
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} =
        Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws', FreeGroup.mk w = g} := by
  rw [nonempty_iso_stallingsGraph_iff (stallingsGraph_isFolded ws') (stallingsGraph_isCore ws'),
    subgroup_stallingsGraph]

/-- Two lists of words each of whose members lies in the subgroup generated by the other list
have isomorphic Stallings graphs. -/
theorem nonempty_iso_stallingsGraph_of_forall_mem_closure
    (h : ∀ w ∈ ws, FreeGroup.mk w ∈
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws', FreeGroup.mk w = g})
    (h' : ∀ w ∈ ws', FreeGroup.mk w ∈
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g}) :
    Nonempty (Iso (stallingsGraph ws) (stallingsGraph ws')) := by
  refine nonempty_iso_stallingsGraph_iff_closure_eq.mpr (le_antisymm ?_ ?_) <;>
    rw [Subgroup.closure_le]
  · rintro _ ⟨w, hw, rfl⟩
    exact h w hw
  · rintro _ ⟨w, hw, rfl⟩
    exact h' w hw

/-- Permuting a list of words does not change its Stallings graph. -/
theorem nonempty_iso_stallingsGraph_of_perm (h : ws.Perm ws') :
    Nonempty (Iso (stallingsGraph ws) (stallingsGraph ws')) :=
  nonempty_iso_stallingsGraph_iff_closure_eq.mpr (by simp only [h.mem_iff])

/-- Replacing the first word of a list by its formal inverse does not change the Stallings
graph. Together with `nonempty_iso_stallingsGraph_of_perm`, any word of the list may be
inverted. -/
theorem nonempty_iso_stallingsGraph_cons_invRev (w : List (α × Bool))
    (ws : List (List (α × Bool))) :
    Nonempty (Iso (stallingsGraph (FreeGroup.invRev w :: ws)) (stallingsGraph (w :: ws))) := by
  have key : ∀ v : List (α × Bool), ∀ u ∈ FreeGroup.invRev v :: ws, FreeGroup.mk u ∈
      Subgroup.closure {g : FreeGroup α | ∃ w ∈ v :: ws, FreeGroup.mk w = g} := by
    simp only [List.forall_mem_cons]
    refine fun v => ⟨?_, fun u hu => Subgroup.subset_closure ⟨u, List.mem_cons_of_mem _ hu, rfl⟩⟩
    rw [← FreeGroup.inv_mk]
    exact Subgroup.inv_mem _ (Subgroup.subset_closure ⟨v, List.mem_cons_self, rfl⟩)
  exact nonempty_iso_stallingsGraph_of_forall_mem_closure (key w)
    (by simpa only [FreeGroup.invRev_invRev] using key (FreeGroup.invRev w))

/-- Multiplying the first word of a list on the right by the second word does not change the
Stallings graph. Together with `nonempty_iso_stallingsGraph_of_perm`, any word of the list may
be multiplied on the right by any other word of the list. -/
theorem nonempty_iso_stallingsGraph_cons_append (w v : List (α × Bool))
    (ws : List (List (α × Bool))) :
    Nonempty (Iso (stallingsGraph ((w ++ v) :: v :: ws)) (stallingsGraph (w :: v :: ws))) := by
  apply nonempty_iso_stallingsGraph_of_forall_mem_closure <;>
    simp only [List.forall_mem_cons]
  · refine ⟨?_, Subgroup.subset_closure ⟨v, by simp, rfl⟩,
      fun u hu => Subgroup.subset_closure ⟨u, by simp [hu], rfl⟩⟩
    rw [← FreeGroup.mul_mk]
    exact Subgroup.mul_mem _ (Subgroup.subset_closure ⟨w, by simp, rfl⟩)
      (Subgroup.subset_closure ⟨v, by simp, rfl⟩)
  · refine ⟨?_, Subgroup.subset_closure ⟨v, by simp, rfl⟩,
      fun u hu => Subgroup.subset_closure ⟨u, by simp [hu], rfl⟩⟩
    rw [← mul_inv_cancel_right (FreeGroup.mk w) (FreeGroup.mk v), FreeGroup.mul_mk]
    exact Subgroup.mul_mem _ (Subgroup.subset_closure ⟨w ++ v, by simp, rfl⟩)
      (Subgroup.inv_mem _ (Subgroup.subset_closure ⟨v, by simp, rfl⟩))

/-! ### The empty list of words -/

/-- The Stallings graph of the empty list of words is the based labelled graph with one vertex
and no darts: it is isomorphic to every such graph. -/
theorem nonempty_iso_stallingsGraph_nil [IsEmpty S.graph.E] [Subsingleton S.graph.V] :
    Nonempty (Iso (stallingsGraph ([] : List (List (α × Bool)))) S) := by
  refine (nonempty_iso_stallingsGraph_iff (S.isFolded_def.mpr fun e => isEmptyElim e)
    ((S.graph.isCore_iff S.base).mpr ⟨fun a => ?_, fun e => isEmptyElim e⟩)).mpr
    (by simp)
  rw [Subsingleton.elim a S.base]
  exact ⟨.nil⟩

end TauCeti.StallingsGraph

namespace Subgroup

open TauCeti StallingsGraph

variable {α : Type*} (H : Subgroup (FreeGroup α))

/-- The canonical graph of a subgroup is isomorphic to the Stallings graph of a list of words
exactly when the words generate the subgroup. -/
theorem nonempty_iso_stallingsGraph_subgroupGraph_iff {ws : List (List (α × Bool))} :
    Nonempty (Iso (stallingsGraph ws) H.subgroupGraph) ↔
      closure {g : FreeGroup α | ∃ w ∈ ws, FreeGroup.mk w = g} = H := by
  rw [nonempty_iso_stallingsGraph_iff H.subgroupGraph_isFolded H.subgroupGraph_isCore,
    subgroupGraph_subgroup]

/-- The canonical graph of a subgroup of a free group has finitely many darts exactly when
the subgroup is finitely generated. No finiteness of the alphabet is assumed. -/
@[simp] theorem subgroupGraph_finite_dart_iff_fg : Finite H.subgroupGraph.graph.E ↔ H.FG := by
  rw [H.subgroupGraph_isFolded.finite_dart_iff_fg H.subgroupGraph_isCore, subgroupGraph_subgroup]

/-- The canonical graph of a finitely generated subgroup has finitely many darts. -/
instance subgroupGraph_finite_dart_of_fg [H.FG] : Finite H.subgroupGraph.graph.E :=
  (subgroupGraph_finite_dart_iff_fg H).mpr ‹_›

/-- The canonical graph of a finitely generated subgroup has finitely many vertices. -/
instance subgroupGraph_finite_vertex_of_fg [H.FG] : Finite H.subgroupGraph.graph.V :=
  H.subgroupGraph_isFolded.finite_vertex_of_fg H.subgroupGraph_isCore
    (by rwa [subgroupGraph_subgroup])

/-- Over a finite alphabet, the canonical graph of a subgroup has finitely many vertices
exactly when the subgroup is finitely generated. -/
@[simp] theorem subgroupGraph_finite_vertex_iff_fg [Finite α] :
    Finite H.subgroupGraph.graph.V ↔ H.FG := by
  rw [H.subgroupGraph_isFolded.finite_vertex_iff_fg H.subgroupGraph_isCore,
    subgroupGraph_subgroup]

end Subgroup
