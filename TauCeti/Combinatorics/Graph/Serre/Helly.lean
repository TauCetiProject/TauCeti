module

public import TauCeti.Combinatorics.Graph.Serre.Convex
public import TauCeti.Combinatorics.Graph.Serre.Dist
public import Mathlib.Data.Finset.Insert

/-!
# Helly's theorem for subtrees

In a tree, finitely many convex sets of vertices that pairwise intersect have a common vertex.
This is the combinatorial input to Serre's lemma that a group generated by finitely many elliptic
automorphisms of a tree, whose pairwise products are elliptic, fixes a vertex.

The proof goes through shortest paths between two sets of vertices. In a preconnected graph, two
nonempty sets of vertices are joined by a reduced path that meets the first set only at its start
and the second only at its end (`SerreGraph.Preconnected.exists_isReduced_path`, in the file on
distances).
When the second set is convex, continuing such a path by a reduced path inside that set never
backtracks (`SerreGraph.IsConvex.isReduced_comp`), so the end of the path lies on the reduced
path from its start to every vertex of the convex set. For three pairwise intersecting convex
sets, this puts the end of a shortest path from the intersection of the first two to the third in
all three (`SerreGraph.IsTree.inter_inter_nonempty`); induction on the number of sets gives
Helly's theorem (`SerreGraph.IsTree.helly_theorem`).

## References

* J.-P. Serre, *Trees*, Chapter I, §6.5.
-/

public section

namespace TauCeti
namespace SerreGraph

variable {Γ : SerreGraph}

/-- In a tree, three pairwise intersecting convex sets of vertices have a common vertex. -/
theorem IsTree.inter_inter_nonempty (h : Γ.IsTree) {A B C : Set Γ.V} (hA : Γ.IsConvex A)
    (hB : Γ.IsConvex B) (hC : Γ.IsConvex C) (hAB : (A ∩ B).Nonempty) (hAC : (A ∩ C).Nonempty)
    (hBC : (B ∩ C).Nonempty) : (A ∩ B ∩ C).Nonempty := by
  -- Join `A ∩ B` to `C` by a shortest path; its end lies in `A` and in `B`.
  obtain ⟨x, hx, y, hy, p, hp, hpC⟩ :=
    (Γ.connected_iff.mp h.connected).2.exists_isReduced_path hAB (hAC.mono Set.inter_subset_right)
  have hnear : ∀ D : Set Γ.V, Γ.IsConvex D → x ∈ D → (D ∩ C).Nonempty → y ∈ D := by
    rintro D hD hxD ⟨d, hdD, hdC⟩
    obtain ⟨q, hq, -⟩ := h.existsUnique_isReduced y d
    have hpq := hC.isReduced_comp hy hdC hp
      (fun e he => (hpC e (List.mem_of_mem_getLast? he)).2) hq
    cases hl : (Path.darts Γ p).getLast? with
    | none => exact Path.eq_of_darts_eq_nil Γ p (List.getLast?_eq_none_iff.mp hl) ▸ hxD
    | some e =>
      rw [← Path.tgt_eq_of_mem_getLast?_darts Γ p hl]
      exact hD.tgt_mem hxD hdD hpq (by
        rw [Path.darts_comp]
        exact List.mem_append_left _ (List.mem_of_mem_getLast? hl))
  exact ⟨y, ⟨hnear A hA hx.1 hAC, hnear B hB hx.2 hBC⟩, hy⟩

/-- **Helly's theorem for subtrees.** In a tree, finitely many pairwise intersecting convex sets
of vertices have a common vertex. -/
theorem IsTree.helly_theorem (h : Γ.IsTree) {ι : Type*} {F : ι → Set Γ.V} {s : Finset ι}
    (h_convex : ∀ i ∈ s, Γ.IsConvex (F i))
    (h_inter : ∀ i ∈ s, ∀ j ∈ s, (F i ∩ F j).Nonempty) : (⋂ i ∈ s, F i).Nonempty := by
  classical
  -- Strengthen the statement to the intersections with a nonempty convex set `C` that meets
  -- every member of the family, and absorb one member into `C` at a time.
  suffices key : ∀ C : Set Γ.V, Γ.IsConvex C → C.Nonempty → (∀ i ∈ s, (C ∩ F i).Nonempty) →
      (C ∩ ⋂ i ∈ s, F i).Nonempty by
    simpa using key Set.univ isConvex_univ
      ((Γ.connected_iff.mp h.connected).1.elim fun v => ⟨v, trivial⟩)
      fun i hi => by simpa using (h_inter i hi i hi)
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s _ ih =>
    intro C hC _ hCF
    have hs_convex : ∀ i ∈ s, Γ.IsConvex (F i) := fun i hi =>
      h_convex i (Finset.mem_insert_of_mem hi)
    have hs_inter : ∀ i ∈ s, ∀ j ∈ s, (F i ∩ F j).Nonempty := fun i hi j hj =>
      h_inter i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj)
    have ha_convex := h_convex a (Finset.mem_insert_self a s)
    obtain ⟨v, hv⟩ := ih hs_convex hs_inter (C ∩ F a) (hC.inter ha_convex)
      (hCF a (Finset.mem_insert_self a s)) fun i hi =>
        h.inter_inter_nonempty hC ha_convex (hs_convex i hi)
          (hCF a (Finset.mem_insert_self a s)) (hCF i (Finset.mem_insert_of_mem hi))
          (h_inter a (Finset.mem_insert_self a s) i (Finset.mem_insert_of_mem hi))
    refine ⟨v, hv.1.1, ?_⟩
    simp only [Finset.mem_insert, Set.iInter_iInter_eq_or_left, Set.mem_inter_iff]
    exact ⟨hv.1.2, hv.2⟩

end SerreGraph
end TauCeti
