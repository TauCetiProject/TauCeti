module

public import TauCeti.Combinatorics.Graph.Serre.Path

/-!
# Reduction of paths in a Serre graph

Removing an immediate reversal does not change the endpoints of a path. Repeatedly doing so
produces a reduced path in the same backtrack homotopy class. This normalisation is the first
step in constructing the path group of a graph; it keeps the two directions of a loop distinct.

## References

* J.-P. Serre, *Trees*, Chapter I, §2.2.
-/

public section

namespace TauCeti.SerreGraph

variable (Γ : SerreGraph)

namespace Path

private theorem endpoint_eq_of_reverse_val {b c d : Γ.V} (f : Quiver.Hom d b)
    (e : Quiver.Hom b c) (h : e.1 = Γ.rev f.1) : c = d := by
  calc
    c = Γ.tgt e.1 := e.2.2.symm
    _ = Γ.tgt (Γ.rev f.1) := by rw [h]
    _ = d := by simpa only [Γ.tgt_rev] using f.2.1

private theorem hom_eq_reverse_of_val_eq {b d : Γ.V} (f : Quiver.Hom d b)
    (e : Quiver.Hom b d) (h : e.1 = Γ.rev f.1) : e = Quiver.reverse f := by
  apply Subtype.ext
  simpa only [Γ.reverse_val] using h

/-- Backtrack homotopy of paths with fixed endpoints, generated by deleting an edge followed
by its reverse. -/
inductive Homotopic {a : Γ.V} : ∀ {b : Γ.V}, Γ.Path a b → Γ.Path a b → Prop
  | refl (p) : Homotopic p p
  | symm {p q} : Homotopic p q → Homotopic q p
  | trans {p q r} : Homotopic p q → Homotopic q r → Homotopic p r
  | cons {b c} {p q : Γ.Path a b} (h : Homotopic p q) (e : Quiver.Hom b c) :
      Homotopic (p.cons e) (q.cons e)
  | backtrack {b c} (p : Γ.Path a b) (e : Quiver.Hom b c) :
      Homotopic ((p.cons e).cons (Quiver.reverse e)) p

/-- Append one dart to a reduced path, removing its last dart when they backtrack. -/
noncomputable def reduceSnoc {a b c : Γ.V} (p : Γ.Path a b) (e : Quiver.Hom b c) :
    Γ.Path a c := by
  classical
  cases p with
  | nil => exact e.toPath
  | @cons d _ q f =>
    by_cases h : e.1 = Γ.rev f.1
    · cases endpoint_eq_of_reverse_val Γ f e h
      exact q
    · exact (q.cons f).cons e

@[simp] theorem reduceSnoc_nil {a c : Γ.V} (e : Quiver.Hom a c) :
    reduceSnoc Γ (Quiver.Path.nil : Γ.Path a a) e = e.toPath := by
  simp [reduceSnoc]

/-- Appending a reverse dart cancels the last dart of any path. -/
@[simp] theorem reduceSnoc_cons_reverse {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) :
    reduceSnoc Γ (p.cons e) (Quiver.reverse e) = p := by
  simp [reduceSnoc, Γ.reverse_val]

/-- Appending a dart that does not reverse the last one retains both darts. -/
theorem reduceSnoc_cons_of_ne {a b c d : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) (f : Quiver.Hom c d) (h : f.1 ≠ Γ.rev e.1) :
    reduceSnoc Γ (p.cons e) f = (p.cons e).cons f := by
  simp [reduceSnoc, h]

/-- Free reduction of a path, retaining its endpoints. -/
noncomputable def reduce {a : Γ.V} : ∀ {b : Γ.V}, Γ.Path a b → Γ.Path a b
  | _, .nil => .nil
  | _, .cons p e => reduceSnoc Γ (reduce p) e

theorem reduce_nil (a : Γ.V) :
    reduce Γ (Quiver.Path.nil : Γ.Path a a) = .nil := by simp [reduce]

@[simp] theorem reduce_cons {a b c : Γ.V} (p : Γ.Path a b) (e : Quiver.Hom b c) :
    reduce Γ (p.cons e) = reduceSnoc Γ (reduce Γ p) e := by simp [reduce]

/-- The output of one reduced append has no immediate backtrack. -/
theorem isReduced_reduceSnoc {a b c : Γ.V} (p : Γ.Path a b)
    (hp : IsReduced Γ p) (e : Quiver.Hom b c) :
    IsReduced Γ (reduceSnoc Γ p e) := by
  classical
  cases p with
  | nil => simpa only [reduceSnoc_nil] using isReduced_toPath Γ e
  | @cons d _ q f =>
    by_cases h : e.1 = Γ.rev f.1
    · cases endpoint_eq_of_reverse_val Γ f e h
      simp only [reduceSnoc, dite_eq_left h]
      cases q with
      | nil => exact isReduced_nil Γ _
      | cons q g => exact ((isReduced_cons_cons Γ q g f).mp hp).1
    · simpa only [reduceSnoc_cons_of_ne Γ q f e h] using
        (isReduced_cons_cons Γ q f e).mpr ⟨hp, h⟩

/-- Every path reduces to a path with no immediate backtracking. -/
@[simp] theorem isReduced_reduce {a b : Γ.V} (p : Γ.Path a b) :
    IsReduced Γ (reduce Γ p) := by
  induction p with
  | nil => exact isReduced_nil Γ _
  | cons p e ih => exact isReduced_reduceSnoc Γ (reduce Γ p) ih e

/-- A reduced path is fixed by appending a dart and reducing just that append. -/
theorem reduceSnoc_eq_cons {a b c : Γ.V} (p : Γ.Path a b) (e : Quiver.Hom b c)
    (h : IsReduced Γ (p.cons e)) : reduceSnoc Γ p e = p.cons e := by
  classical
  cases p with
  | nil => simp [Quiver.Hom.toPath]
  | cons p f =>
    have hne := ((isReduced_cons_cons Γ p f e).mp h).2
    exact reduceSnoc_cons_of_ne Γ p f e hne

/-- Reduction fixes precisely the already reduced paths. -/
@[simp] theorem reduce_eq_self_of_isReduced {a b : Γ.V} (p : Γ.Path a b)
    (hp : IsReduced Γ p) : reduce Γ p = p := by
  induction p with
  | nil => rfl
  | cons p e ih =>
    cases p with
    | nil => simp only [reduce_cons, reduce_nil, reduceSnoc_nil, Quiver.Hom.toPath]
    | cons p f =>
      have hprev := ((isReduced_cons_cons Γ p f e).mp hp).1
      rw [reduce_cons, ih hprev]
      exact reduceSnoc_eq_cons Γ (p.cons f) e hp

/-- Reducing an already reduced path leaves it unchanged. -/
theorem reduce_idem {a b : Γ.V} (p : Γ.Path a b) :
    reduce Γ (reduce Γ p) = reduce Γ p :=
  reduce_eq_self_of_isReduced Γ _ (isReduced_reduce Γ p)

/-- Appending one dart is homotopic to its reduced append. -/
theorem homotopic_reduceSnoc {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) : Homotopic Γ (p.cons e) (reduceSnoc Γ p e) := by
  classical
  cases p with
  | nil => simpa only [reduceSnoc_nil, Quiver.Hom.toPath] using
      (Homotopic.refl (Quiver.Path.nil.cons e) : Homotopic Γ _ _)
  | @cons d _ q f =>
    by_cases h : e.1 = Γ.rev f.1
    · cases endpoint_eq_of_reverse_val Γ f e h
      have hef := hom_eq_reverse_of_val_eq Γ f e h
      subst e
      simpa only [reduceSnoc_cons_reverse] using Homotopic.backtrack q f
    · simpa only [reduceSnoc_cons_of_ne Γ q f e h] using
        (Homotopic.refl ((q.cons f).cons e) : Homotopic Γ _ _)

/-- Cancelling a dart and its reverse after a reduced prefix returns that prefix. -/
theorem reduceSnoc_reverse {a b c : Γ.V} (p : Γ.Path a b)
    (hp : IsReduced Γ p) (e : Quiver.Hom b c) :
    reduceSnoc Γ (reduceSnoc Γ p e) (Quiver.reverse e) = p := by
  classical
  cases p with
  | nil =>
    simp [reduceSnoc, Quiver.Hom.toPath]
  | @cons d b' q f =>
    by_cases h : e.1 = Γ.rev f.1
    · cases endpoint_eq_of_reverse_val Γ f e h
      have hef := hom_eq_reverse_of_val_eq Γ f e h
      subst e
      rw [reduceSnoc_cons_reverse, Quiver.reverse_reverse]
      exact reduceSnoc_eq_cons Γ q f hp
    · rw [reduceSnoc_cons_of_ne Γ q f e h, reduceSnoc_cons_reverse]

/-- Inserting a backtrack does not change a path's reduced form. -/
@[simp] theorem reduce_backtrack {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) :
    reduceSnoc Γ (reduceSnoc Γ (reduce Γ p) e) (Quiver.reverse e) = reduce Γ p := by
  exact reduceSnoc_reverse Γ (reduce Γ p) (isReduced_reduce Γ p) e

/-- Backtrack-homotopic paths have the same reduced form. -/
theorem Homotopic.reduce_eq {a b : Γ.V} {p q : Γ.Path a b}
    (h : Homotopic Γ p q) : reduce Γ p = reduce Γ q := by
  induction h with
  | refl p => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | cons h e ih => simp only [reduce_cons, ih]
  | backtrack p e => exact reduce_backtrack Γ p e

/-- Two reduced paths in the same backtrack homotopy class are equal. -/
theorem Homotopic.eq_of_isReduced {a b : Γ.V} {p q : Γ.Path a b}
    (h : Homotopic Γ p q) (hp : IsReduced Γ p) (hq : IsReduced Γ q) : p = q := by
  simpa only [reduce_eq_self_of_isReduced Γ p hp,
    reduce_eq_self_of_isReduced Γ q hq] using h.reduce_eq Γ

/-- Every path is backtrack homotopic to its reduced path. -/
theorem homotopic_reduce {a b : Γ.V} (p : Γ.Path a b) :
    Homotopic Γ p (reduce Γ p) := by
  induction p with
  | nil => exact .refl _
  | cons p e ih =>
    exact (Homotopic.cons ih e).trans (homotopic_reduceSnoc Γ (reduce Γ p) e)

/-- Backtrack homotopy is exactly equality of reduced paths. -/
theorem homotopic_iff_reduce_eq {a b : Γ.V} {p q : Γ.Path a b} :
    Homotopic Γ p q ↔ reduce Γ p = reduce Γ q := by
  constructor
  · exact Homotopic.reduce_eq Γ
  · intro h
    exact (homotopic_reduce Γ p).trans
      (by simpa only [h] using (homotopic_reduce Γ q).symm)

/-- A path is reduced precisely when normalisation leaves it unchanged. -/
theorem isReduced_iff_reduce_eq {a b : Γ.V} (p : Γ.Path a b) :
    IsReduced Γ p ↔ reduce Γ p = p := by
  constructor
  · exact reduce_eq_self_of_isReduced Γ p
  · intro h
    rw [← h]
    exact isReduced_reduce Γ p

/-- Opposite directions of a rose petal remain distinct under path homotopy. -/
theorem rose_not_homotopic_reverse {α : Type*} (a : α) :
    ¬ Homotopic (rose α) ((rose α).dart (a, true)).toPath
        ((rose α).dart (a, false)).toPath := by
  intro h
  have heq := h.eq_of_isReduced (rose α)
    (isReduced_toPath (rose α) _)
    (isReduced_toPath (rose α) _)
  have he : (rose α).dart (a, true) = (rose α).dart (a, false) := by
    injection heq
  have hv : ((rose α).dart (a, true)).1 = ((rose α).dart (a, false)).1 :=
    congrArg (fun e => e.1) he
  rw [SerreGraph.dart_val (rose α) (a, true), SerreGraph.dart_val (rose α) (a, false)] at hv
  exact (by decide : true ≠ false) (congrArg Prod.snd hv)

end Path
end TauCeti.SerreGraph
