module

public import TauCeti.Combinatorics.Graph.Serre.Path

/-!
# Reduction of paths in a Serre graph

Adjacent reverse darts cancel in an edge path. Scanning a path from left to right gives a
reduced path with the same endpoints. Backtrack homotopy is generated by inserting or deleting
such pairs, and two paths are homotopic exactly when their reduced forms agree. In particular,
every homotopy class has a unique reduced representative. Reduction is compatible with
concatenation and reversal, providing the normal form used to build graph path groups.

## References

* J.-P. Serre, *Trees*, Chapter I, §§2.1–2.3.
-/

public section

namespace TauCeti.SerreGraph
variable (Γ : SerreGraph) [DecidableEq Γ.E]

private def push {a b c : Γ.V} (q : Γ.Path a b) (e : Quiver.Hom b c) : Γ.Path a c :=
  match q with
  | .nil => e.toPath
  | .cons r f =>
      if h : e.1 = Γ.rev f.1 then
        have hcb : c = _ := by
          rw [← e.2.2, h, Γ.tgt_rev, f.2.1]
        hcb ▸ r
      else
        (r.cons f).cons e

omit [DecidableEq Γ.E] in
private theorem isReduced_prefix {a b c : Γ.V} (q : Γ.Path a b)
    (e : Quiver.Hom b c) (h : Path.IsReduced Γ (q.cons e)) :
    Path.IsReduced Γ q := by
  cases q with
  | nil => exact Path.isReduced_nil Γ _
  | cons q f => exact (Path.isReduced_cons_cons Γ q f e).mp h |>.1

private theorem isReduced_push {a b c : Γ.V} (q : Γ.Path a b)
    (e : Quiver.Hom b c) (hq : Path.IsReduced Γ q) :
    Path.IsReduced Γ (push Γ q e) := by
  cases q with
  | nil => simp [push]
  | @cons d _ r f =>
    by_cases h : e.1 = Γ.rev f.1
    · simp only [push, dite_eq_left h]
      have hcb : c = d := by rw [← e.2.2, h, Γ.tgt_rev, f.2.1]
      cases hcb
      exact isReduced_prefix Γ r f hq
    · simp only [push, dite_eq_right h, Path.isReduced_cons_cons]
      exact ⟨hq, h⟩

/-- Remove adjacent reverse darts by scanning a path from left to right. -/
def Path.reduce {a b : Γ.V} : Γ.Path a b → Γ.Path a b
  | .nil => .nil
  | .cons q e => push Γ (Path.reduce q) e

/-- The empty path is already reduced. -/
theorem Path.reduce_nil (a : Γ.V) :
    Path.reduce Γ (Quiver.Path.nil : Γ.Path a a) = Quiver.Path.nil := (rfl)

/-- A one-dart path is already reduced. -/
theorem Path.reduce_toPath {a b : Γ.V} (e : Quiver.Hom a b) :
    Path.reduce Γ e.toPath = e.toPath := (rfl)

/-- The reduction algorithm produces a path without adjacent reverse darts. -/
@[simp] theorem Path.isReduced_reduce {a b : Γ.V} (p : Γ.Path a b) :
    Path.IsReduced Γ (Path.reduce Γ p) := by
  induction p with
  | nil => simp [Path.reduce]
  | cons q e ih => exact isReduced_push Γ (Path.reduce Γ q) e ih

private theorem push_eq_cons_of_isReduced {a b c : Γ.V} (q : Γ.Path a b)
    (e : Quiver.Hom b c) (h : Path.IsReduced Γ (q.cons e)) :
    push Γ q e = q.cons e := by
  cases q with
  | nil => rfl
  | @cons d _ r f =>
    have hne : e.1 ≠ Γ.rev f.1 := ((Path.isReduced_cons_cons Γ r f e).mp h).2
    simp [push, hne]

/-- Reduction fixes paths that have no adjacent reverse darts. -/
@[simp] theorem Path.reduce_eq_self_of_isReduced {a b : Γ.V} (p : Γ.Path a b)
    (h : Path.IsReduced Γ p) : Path.reduce Γ p = p := by
  induction p with
  | nil => rfl
  | cons q e ih =>
    rw [Path.reduce, ih (isReduced_prefix Γ q e h)]
    exact push_eq_cons_of_isReduced Γ q e h

private theorem push_reverse {a b c : Γ.V} (q : Γ.Path a b)
    (e : Quiver.Hom b c) (hq : Path.IsReduced Γ q) :
    push Γ (push Γ q e) (Quiver.reverse e) = q := by
  cases q with
  | nil =>
    simp [push, Quiver.Hom.toPath]
  | @cons d _ r f =>
    by_cases h : e.1 = Γ.rev f.1
    · have hcb : c = d := by rw [← e.2.2, h, Γ.tgt_rev, f.2.1]
      cases hcb
      have he : e = Quiver.reverse f := Subtype.ext (by simpa only [reverse_val] using h)
      subst e
      simpa only [push, dite_eq_left h, Quiver.reverse_reverse] using
        push_eq_cons_of_isReduced Γ r f hq
    · simp [push, h]

/-- A terminal dart followed by its reverse disappears under reduction. -/
@[simp] theorem Path.reduce_backtrack {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) :
    Path.reduce Γ ((p.cons e).cons (Quiver.reverse e)) = Path.reduce Γ p := by
  simp only [Path.reduce]
  exact push_reverse Γ (Path.reduce Γ p) e (Path.isReduced_reduce Γ p)

/-- Combinatorial homotopy generated by deleting adjacent reverse darts. -/
inductive Path.Homotopic {a : Γ.V} : ∀ {b : Γ.V}, Γ.Path a b → Γ.Path a b → Prop
  | refl (p : Γ.Path a b) : Homotopic p p
  | symm {p q : Γ.Path a b} : Homotopic p q → Homotopic q p
  | trans {p q r : Γ.Path a b} : Homotopic p q → Homotopic q r → Homotopic p r
  | cons {b c : Γ.V} {p q : Γ.Path a b} (h : Homotopic p q)
      (e : Quiver.Hom b c) : Homotopic (p.cons e) (q.cons e)
  | backtrack {b c : Γ.V} (p : Γ.Path a b) (e : Quiver.Hom b c) :
      Homotopic ((p.cons e).cons (Quiver.reverse e)) p

attribute [refl] Path.Homotopic.refl
attribute [symm] Path.Homotopic.symm
attribute [trans] Path.Homotopic.trans

omit [DecidableEq Γ.E] in
/-- Backtrack homotopy is an equivalence relation on paths with fixed endpoints. -/
theorem Path.Homotopic.equivalence (a b : Γ.V) :
    Equivalence (Path.Homotopic Γ (a := a) (b := b)) :=
  ⟨Path.Homotopic.refl, Path.Homotopic.symm, Path.Homotopic.trans⟩

omit [DecidableEq Γ.E] in
/-- The backtrack-homotopy relation on paths with fixed endpoints. -/
def Path.Homotopic.setoid (a b : Γ.V) : Setoid (Γ.Path a b) where
  r := Path.Homotopic Γ
  iseqv := Path.Homotopic.equivalence Γ a b

/-- Backtrack-homotopic paths have the same reduced form. -/
theorem Path.Homotopic.reduce_eq {a b : Γ.V} {p q : Γ.Path a b}
    (h : Path.Homotopic Γ p q) : Path.reduce Γ p = Path.reduce Γ q := by
  induction h with
  | refl p => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2
  | cons _ e ih => simp only [Path.reduce, ih]
  | backtrack p e => exact Path.reduce_backtrack Γ p e

private theorem push_homotopic_cons {a b c : Γ.V} (q : Γ.Path a b)
    (e : Quiver.Hom b c) :
    Path.Homotopic Γ (push Γ q e) (q.cons e) := by
  cases q with
  | nil => exact .refl _
  | @cons d _ r f =>
    by_cases h : e.1 = Γ.rev f.1
    · have hcb : c = d := by rw [← e.2.2, h, Γ.tgt_rev, f.2.1]
      cases hcb
      have he : e = Quiver.reverse f := Subtype.ext (by simpa only [reverse_val] using h)
      subst e
      simpa only [push, dite_eq_left h] using
        (Path.Homotopic.backtrack r f).symm
    · simp only [push, dite_eq_right h]
      exact .refl _

/-- Every path is homotopic to its reduced normal form. -/
theorem Path.homotopic_reduce {a b : Γ.V} (p : Γ.Path a b) :
    Path.Homotopic Γ p (Path.reduce Γ p) := by
  induction p with
  | nil => exact .refl _
  | cons q e ih =>
    apply Path.Homotopic.trans (Path.Homotopic.cons ih e)
    exact (push_homotopic_cons Γ (Path.reduce Γ q) e).symm

omit [DecidableEq Γ.E] in
/-- A reduced path is the unique reduced representative of its backtrack-homotopy class. -/
theorem Path.eq_of_homotopic_of_isReduced {a b : Γ.V} {p q : Γ.Path a b}
    (h : Path.Homotopic Γ p q) (hp : Path.IsReduced Γ p)
    (hq : Path.IsReduced Γ q) : p = q := by
  classical
  simpa only [Path.reduce_eq_self_of_isReduced Γ p hp,
    Path.reduce_eq_self_of_isReduced Γ q hq] using h.reduce_eq

/-- Reduction is idempotent. -/
theorem Path.reduce_reduce {a b : Γ.V} (p : Γ.Path a b) :
    Path.reduce Γ (Path.reduce Γ p) = Path.reduce Γ p :=
  Path.reduce_eq_self_of_isReduced Γ _ (Path.isReduced_reduce Γ p)

/-- Equality of reduced forms characterizes backtrack homotopy. -/
theorem Path.homotopic_iff_reduce_eq {a b : Γ.V} (p q : Γ.Path a b) :
    Path.Homotopic Γ p q ↔ Path.reduce Γ p = Path.reduce Γ q := by
  constructor
  · exact Path.Homotopic.reduce_eq Γ
  · intro h
    exact (Path.homotopic_reduce Γ p).trans (h ▸ (Path.homotopic_reduce Γ q).symm)

omit [DecidableEq Γ.E] in
/-- Appending the same path preserves backtrack homotopy. -/
theorem Path.Homotopic.comp_right {a b c : Γ.V} {p q : Γ.Path a b}
    (h : Path.Homotopic Γ p q) (r : Γ.Path b c) :
    Path.Homotopic Γ (p.comp r) (q.comp r) := by
  induction r with
  | nil => simpa using h
  | cons r e ih =>
    simpa only [Quiver.Path.comp_cons] using ih.cons e

omit [DecidableEq Γ.E] in
/-- Prepending the same path preserves backtrack homotopy. -/
theorem Path.Homotopic.comp_left {a b c : Γ.V} (r : Γ.Path a b)
    {p q : Γ.Path b c} (h : Path.Homotopic Γ p q) :
    Path.Homotopic Γ (r.comp p) (r.comp q) := by
  induction h with
  | refl p => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2
  | cons _ e ih => simpa only [Quiver.Path.comp_cons] using ih.cons e
  | backtrack p e =>
    simpa only [Quiver.Path.comp_cons] using
      (Path.Homotopic.backtrack (r.comp p) e)

/-- Normalizing factors before concatenation does not change the reduced path. -/
theorem Path.reduce_comp {a b c : Γ.V} (p : Γ.Path a b) (q : Γ.Path b c) :
    Path.reduce Γ (p.comp q) =
      Path.reduce Γ ((Path.reduce Γ p).comp (Path.reduce Γ q)) := by
  apply (Path.homotopic_iff_reduce_eq Γ _ _).mp
  exact (Path.Homotopic.comp_right Γ (Path.homotopic_reduce Γ p) q).trans
    (Path.Homotopic.comp_left Γ (Path.reduce Γ p) (Path.homotopic_reduce Γ q))

omit [DecidableEq Γ.E] in
/-- Reversing paths preserves backtrack homotopy. -/
theorem Path.Homotopic.reverse {a b : Γ.V} {p q : Γ.Path a b}
    (h : Path.Homotopic Γ p q) :
    Path.Homotopic Γ p.reverse q.reverse := by
  induction h with
  | refl p => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2
  | cons _ e ih =>
    simpa only [Quiver.Path.reverse] using
      (Path.Homotopic.comp_left Γ (Quiver.reverse e).toPath ih)
  | backtrack p e =>
    have h := Path.Homotopic.comp_right Γ
      (Path.Homotopic.backtrack (Quiver.Path.nil) e) p.reverse
    simpa only [← Quiver.Path.comp_toPath_eq_cons, Quiver.Path.nil_comp,
      Quiver.Path.comp_assoc, Quiver.Path.reverse, Quiver.reverse_reverse] using h

/-- Reduction commutes with path reversal. -/
@[simp] theorem Path.reduce_reverse {a b : Γ.V} (p : Γ.Path a b) :
    Path.reduce Γ p.reverse = (Path.reduce Γ p).reverse := by
  have h := Path.Homotopic.reverse Γ (Path.homotopic_reduce Γ p)
  rw [Path.homotopic_iff_reduce_eq] at h
  simpa only [Path.reduce_eq_self_of_isReduced Γ _
    ((Path.isReduced_reverse Γ _).2 (Path.isReduced_reduce Γ p))] using h

end TauCeti.SerreGraph
