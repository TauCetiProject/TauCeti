public import TauCeti.Combinatorics.Graph.Serre.Path

/-!
# Reduction of Serre paths

Deleting an edge immediately followed by its reverse generates path homotopy. Every path
has a canonical reduced representative with the same endpoints, and two paths are homotopic
exactly when these representatives agree. In particular, reduced representatives are unique.

The stack algorithm follows the idea of Mathlib’s `FreeGroup.reduce`, now with dependent
path endpoints. It processes the darts in order, cancelling against the final dart of the reduced
prefix. The endpoint indices retain the original vertices throughout the construction.

## References

* J.-P. Serre, *Trees*, Chapter I, §§2.1–2.2.
-/

public section

namespace TauCeti.SerreGraph

variable (Γ : SerreGraph)

namespace Path

/-- Path homotopy generated by inserting or deleting an immediate backtrack. The `cons`
constructor permits the elementary move at any position in the path. -/
inductive Homotopic {a : Γ.V} : {b : Γ.V} → Γ.Path a b → Γ.Path a b → Prop
  | refl {b} (p : Γ.Path a b) : Homotopic p p
  | symm {b} {p q : Γ.Path a b} : Homotopic p q → Homotopic q p
  | trans {b} {p q r : Γ.Path a b} : Homotopic p q → Homotopic q r → Homotopic p r
  | cons {b c} {p q : Γ.Path a b} (h : Homotopic p q) (e : Quiver.Hom b c) :
      Homotopic (p.cons e) (q.cons e)
  | backtrack {b c} (p : Γ.Path a b) (e : Quiver.Hom b c) :
      Homotopic ((p.cons e).cons (Quiver.reverse e)) p

/-- Homotopy is preserved by placing a fixed path before the paths being compared. -/
theorem Homotopic.comp_left {a b c : Γ.V} {q r : Γ.Path b c}
    (h : Homotopic Γ q r) (p : Γ.Path a b) :
    Homotopic Γ (p.comp q) (p.comp r) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | cons h e ih => exact ih.cons e
  | backtrack q e => exact .backtrack (p.comp q) e

/-- Homotopy is preserved by appending a fixed path. -/
theorem Homotopic.comp_right {a b c : Γ.V} {p q : Γ.Path a b}
    (h : Homotopic Γ p q) (r : Γ.Path b c) :
    Homotopic Γ (p.comp r) (q.comp r) := by
  induction r with
  | nil => exact h
  | cons r e ih => exact ih.cons e

/-- Concatenating homotopic paths preserves homotopy. -/
theorem Homotopic.comp {a b c : Γ.V} {p q : Γ.Path a b} {r s : Γ.Path b c}
    (h : Homotopic Γ p q) (k : Homotopic Γ r s) :
    Homotopic Γ (p.comp r) (q.comp s) :=
  (h.comp_right Γ r).trans (k.comp_left Γ q)

/-- Reversing homotopic paths preserves homotopy. -/
theorem Homotopic.reverse {a b : Γ.V} {p q : Γ.Path a b}
    (h : Homotopic Γ p q) : Homotopic Γ p.reverse q.reverse := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | cons h e ih => exact ih.comp_left Γ (Quiver.reverse e).toPath
  | backtrack p e =>
    simpa [← Quiver.Path.comp_assoc, Quiver.Hom.toPath] using
      (Homotopic.backtrack (Γ := Γ) Quiver.Path.nil e).comp_right Γ p.reverse

private theorem endpoint_eq {b c d : Γ.V} (e : Quiver.Hom b c)
    (f : Quiver.Hom c d) (h : f.1 = Γ.rev e.1) : b = d := by
  calc
    b = Γ.tgt (Γ.rev e.1) := by simp [e.2.1]
    _ = Γ.tgt f.1 := congrArg Γ.tgt h.symm
    _ = d := f.2.2

open Classical in
private noncomputable def push {a : Γ.V} : {b c : Γ.V} →
    Γ.Path a b → Quiver.Hom b c → Γ.Path a c
  | _, _, .nil, e => .cons .nil e
  | _, _, .cons p e, f =>
      if h : f.1 = Γ.rev e.1 then (endpoint_eq Γ e f h) ▸ p else (p.cons e).cons f

private theorem push_nil {a b : Γ.V} (e : Quiver.Hom a b) :
    push Γ Quiver.Path.nil e = e.toPath := rfl

private theorem push_cancel {a b c : Γ.V} (p : Γ.Path a b) (e : Quiver.Hom b c) :
    push Γ (p.cons e) (Quiver.reverse e) = p := by
  simp [push, reverse_val]

private theorem push_keep {a b c d : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) (f : Quiver.Hom c d) (h : f.1 ≠ Γ.rev e.1) :
    push Γ (p.cons e) f = (p.cons e).cons f := by
  simp [push, h]

private theorem isReduced_push {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) (hp : IsReduced Γ p) : IsReduced Γ (push Γ p e) := by
  cases p with
  | nil => exact isReduced_toPath Γ e
  | @cons b d p f =>
    by_cases h : e.1 = Γ.rev f.1
    · have hd := endpoint_eq Γ f e h
      subst c
      have he : e = Quiver.reverse f := Subtype.ext (by simpa using h)
      subst e
      rw [push_cancel]
      cases p with
      | nil => exact isReduced_nil Γ a
      | cons p g => exact (isReduced_cons_cons Γ p g f).mp hp |>.1
    · rw [push_keep Γ p f e h]
      exact (isReduced_cons_cons Γ p f e).mpr ⟨hp, h⟩

private theorem push_eq_cons {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) (hp : IsReduced Γ (p.cons e)) :
    push Γ p e = p.cons e := by
  cases p with
  | nil => rfl
  | cons p f => exact push_keep Γ p f e ((isReduced_cons_cons Γ p f e).mp hp).2

private theorem push_reverse {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) (hp : IsReduced Γ p) :
    push Γ (push Γ p e) (Quiver.reverse e) = p := by
  cases p with
  | nil => exact push_cancel Γ Quiver.Path.nil e
  | @cons b d p f =>
    by_cases h : e.1 = Γ.rev f.1
    · have hd := endpoint_eq Γ f e h
      subst c
      have he : e = Quiver.reverse f := Subtype.ext (by simpa using h)
      subst e
      rw [push_cancel, Quiver.reverse_reverse]
      exact push_eq_cons Γ p f hp
    · rw [push_keep Γ p f e h, push_cancel]

private theorem homotopic_push {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) : Homotopic Γ (p.cons e) (push Γ p e) := by
  cases p with
  | nil => exact .refl _
  | @cons b d p f =>
    by_cases h : e.1 = Γ.rev f.1
    · have hd := endpoint_eq Γ f e h
      subst c
      have he : e = Quiver.reverse f := Subtype.ext (by simpa using h)
      subst e
      rw [push_cancel]
      exact .backtrack p f
    · rw [push_keep Γ p f e h]
      exact .refl _

/-- The canonical reduced representative of a path, obtained by cancelling backtracks. -/
noncomputable def reduce {a : Γ.V} : {b : Γ.V} → Γ.Path a b → Γ.Path a b
  | _, .nil => .nil
  | _, .cons p e => push Γ (reduce p) e

@[simp] theorem reduce_nil (a : Γ.V) :
    reduce Γ (Quiver.Path.nil : Γ.Path a a) = Quiver.Path.nil := by rfl

/-- Reduction always produces a path without immediate reversal. -/
@[simp↓] theorem isReduced_reduce {a b : Γ.V} (p : Γ.Path a b) : IsReduced Γ (reduce Γ p) := by
  induction p with
  | nil => exact isReduced_nil Γ _
  | cons p e ih => exact isReduced_push Γ (reduce Γ p) e ih

/-- Reduction fixes a path which already has no immediate reversal. -/
theorem IsReduced.reduce_eq {a b : Γ.V} {p : Γ.Path a b} (hp : IsReduced Γ p) :
    reduce Γ p = p := by
  induction p with
  | nil => rfl
  | cons p e ih =>
    cases p with
    | nil => rfl
    | cons p f =>
      rw [isReduced_cons_cons] at hp
      rw [reduce, ih hp.1]
      exact push_keep Γ p f e hp.2

@[simp↓] theorem reduce_toPath {a b : Γ.V} (e : Quiver.Hom a b) :
    reduce Γ e.toPath = e.toPath := (isReduced_toPath Γ e).reduce_eq

@[simp] theorem reduce_reduce {a b : Γ.V} (p : Γ.Path a b) :
    reduce Γ (reduce Γ p) = reduce Γ p := (isReduced_reduce Γ p).reduce_eq

/-- A path and its reduction differ by insertion or deletion of backtracks. -/
theorem homotopic_reduce {a b : Γ.V} (p : Γ.Path a b) :
    Homotopic Γ p (reduce Γ p) := by
  induction p with
  | nil => exact .refl _
  | cons p e ih => exact (ih.cons e).trans (homotopic_push Γ (reduce Γ p) e)

/-- Appending an immediate backtrack does not change the reduced representative. -/
@[simp] theorem reduce_backtrack {a b c : Γ.V} (p : Γ.Path a b)
    (e : Quiver.Hom b c) :
    reduce Γ ((p.cons e).cons (Quiver.reverse e)) = reduce Γ p :=
  push_reverse Γ (reduce Γ p) e (isReduced_reduce Γ p)

/-- Homotopic paths have the same reduced representative. -/
theorem Homotopic.reduce_eq {a b : Γ.V} {p q : Γ.Path a b}
    (h : Homotopic Γ p q) : reduce Γ p = reduce Γ q := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | cons h e ih => exact congrArg (fun q => push Γ q e) ih
  | backtrack p e => exact reduce_backtrack Γ p e

/-- Reduction completely classifies homotopy by backtracks. -/
theorem homotopic_iff_reduce_eq {a b : Γ.V} (p q : Γ.Path a b) :
    Homotopic Γ p q ↔ reduce Γ p = reduce Γ q := by
  refine ⟨fun h => h.reduce_eq, fun h => ?_⟩
  exact (homotopic_reduce Γ p).trans (h ▸ (homotopic_reduce Γ q).symm)

/-- Reducing both paths before concatenation leaves the final reduced path unchanged. -/
theorem reduce_comp {a b c : Γ.V} (p : Γ.Path a b) (q : Γ.Path b c) :
    reduce Γ ((reduce Γ p).comp (reduce Γ q)) = reduce Γ (p.comp q) :=
  ((homotopic_reduce Γ p).comp Γ (homotopic_reduce Γ q)).reduce_eq.symm

/-- Homotopic reduced paths agree. -/
theorem Homotopic.eq_of_isReduced {a b : Γ.V} {p q : Γ.Path a b}
    (h : Homotopic Γ p q) (hp : IsReduced Γ p) (hq : IsReduced Γ q) : p = q := by
  simpa only [hp.reduce_eq, hq.reduce_eq] using h.reduce_eq

/-- Reversing a reduced representative gives the representative of the reversed path. -/
@[simp] theorem reduce_reverse {a b : Γ.V} (p : Γ.Path a b) :
    reduce Γ p.reverse = (reduce Γ p).reverse := by
  have h := (homotopic_reduce Γ p).reverse Γ
  have hr := (isReduced_reverse Γ (reduce Γ p)).mpr (isReduced_reduce Γ p)
  exact h.reduce_eq.trans hr.reduce_eq

/-- Every homotopy class has exactly one reduced representative with the same endpoints. -/
theorem existsUnique_reduced {a b : Γ.V} (p : Γ.Path a b) :
    ∃! q : Γ.Path a b, Homotopic Γ p q ∧ IsReduced Γ q := by
  refine ⟨reduce Γ p, ⟨homotopic_reduce Γ p, isReduced_reduce Γ p⟩, ?_⟩
  intro q hq
  exact (Homotopic.eq_of_isReduced Γ ((homotopic_reduce Γ p).symm.trans hq.1)
    (isReduced_reduce Γ p) hq.2).symm

end Path

end TauCeti.SerreGraph
