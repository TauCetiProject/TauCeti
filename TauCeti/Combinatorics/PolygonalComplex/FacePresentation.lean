/-!
# Face presentations of polygonal complexes

Let `C` be a polygonal complex and `T` a set of darts of its one-skeleton. The face
presentation `PolygonalComplex.FacePresentation C T` is the group generated by the darts of the
one-skeleton subject to the relations of the graph presentation
`SerreGraph.GraphPresentation` (a dart and its reverse are mutually inverse, and the darts of
`T` are trivial), together with one relator for every face: the product of its sides, in order
(`PolygonalComplex.faceRelator`).

For the darts of a spanning tree `T` the face presentation is the combinatorial fundamental
group of the complex. Read from its first corner, a face is a closed path
`PolygonalComplex.facePath` in the one-skeleton; joining its starting vertex to a base vertex
`v` by the tree path of `T` gives a based loop at `v`. The face presentation is the reduced path
group of the one-skeleton at `v` modulo the normal closure of these based face loops
(`PolygonalComplex.facePresentationEquivQuotient`); in the presentation the tree darts of the
connecting paths disappear, leaving the face relators. This is the combinatorial form of the
description of the fundamental group of a space obtained by attaching 2-cells. The construction
itself makes sense for every set of darts; only this comparison uses a spanning tree.

A one-vertex polygon whose face is attached along a word `w` in the petals of a rose has the
one-relator face group `⟨α | w⟩` (`PolygonalComplex.polygonFacePresentationEquiv`); the only
spanning tree of a rose has no darts. For the standard surface models this gives the expected
groups: the face group of the disc is trivial, that of the torus is the genus-one surface group
`S⁺(1, 0) = ⟨a, b | [a, b]⟩`, and that of the projective plane is `S⁻(1, 0) = ⟨c | c ^ 2⟩`.

## Main definitions

* `TauCeti.PolygonalComplex.facePath`: the closed path along the sides of a face.
* `TauCeti.PolygonalComplex.faceRelator`: the product of the sides of a face in the free group
  on the darts.
* `TauCeti.PolygonalComplex.faceRelators`: the graph relators and the face relators.
* `TauCeti.PolygonalComplex.FacePresentation`: the presented group.
* `TauCeti.PolygonalComplex.FacePresentation.lift`: its universal property.
* `TauCeti.PolygonalComplex.facePresentationEquivQuotient`: the isomorphism with the path group
  modulo the normal closure of the based face loops.
* `TauCeti.PolygonalComplex.polygonFacePresentationEquiv`: the face group of a one-vertex polygon
  is the one-relator group of its word.

## Main results

* `TauCeti.SurfaceModel.instSubsingletonFacePresentationDisc`: the face group of the disc is
  trivial.
* `TauCeti.SurfaceModel.nonempty_facePresentation_torus_mulEquiv_orientable`,
  `TauCeti.SurfaceModel.nonempty_facePresentation_projectivePlane_mulEquiv_nonorientable`: the
  face groups of the torus and of the projective plane are the surface groups `S⁺(1, 0)` and
  `S⁻(1, 0)`.

## References

* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, §1.2, Proposition 1.26
  (attaching 2-cells along based loops) and the presentations of the closed surfaces after it.
* J. Gallier, D. Xu, *A Guide to the Classification Theorem for Compact Surfaces*, Springer, 2013,
  §6.6, Definition 6.7 (closed edge paths modulo cancelling `a a⁻¹` and deleting face boundaries)
  and the presentations of the closed surfaces, the disc and the projective plane after it.
-/

public section

universe u v w

namespace TauCeti

namespace PolygonalComplex

variable (C : PolygonalComplex.{u, v, w})

/-! ### Face paths and face relators -/

-- The sides of a face, read from its first corner, form a closed path.
private theorem exists_path_darts_eq_ofFn_side (f : C.Face) :
    ∃ p : C.graph.Path (C.cornerVertex ⟨f, ⟨0, C.sides_pos f⟩⟩)
        (C.cornerVertex ⟨f, ⟨0, C.sides_pos f⟩⟩),
      SerreGraph.Path.darts C.graph p = List.ofFn (C.side f) := by
  refine SerreGraph.exists_path_darts_eq C.graph _ (List.ext_getElem (by simp) fun i h₁ h₂ => ?_)
  simp only [List.length_cons, List.length_map, List.length_ofFn] at h₁
  rcases i with _ | i
  · rw [List.getElem_cons_zero, List.getElem_append_left (by simpa using C.sides_pos f),
      List.getElem_map, List.getElem_ofFn, ← src_outgoing, outgoing_def]
  · rw [List.getElem_cons_succ, List.getElem_map, List.getElem_ofFn]
    by_cases hi : i + 1 < C.sides f
    · rw [List.getElem_append_left (by simpa using hi), List.getElem_map, List.getElem_ofFn]
      exact C.tgt_side_eq_src_side (by dsimp only; split_ifs <;> lia)
    · rw [List.getElem_append_right (by simp; lia), List.getElem_singleton, ← src_outgoing,
        outgoing_def]
      exact C.tgt_side_eq_src_side (by dsimp only; split_ifs <;> lia)

/-- The boundary path of a face: the closed path at its first corner whose darts are the sides
of the face, in order. -/
noncomputable def facePath (f : C.Face) :
    C.graph.Path (C.cornerVertex ⟨f, ⟨0, C.sides_pos f⟩⟩)
      (C.cornerVertex ⟨f, ⟨0, C.sides_pos f⟩⟩) :=
  (C.exists_path_darts_eq_ofFn_side f).choose

/-- The darts of the boundary path of a face are its sides, in order. -/
@[simp] theorem darts_facePath (f : C.Face) :
    SerreGraph.Path.darts C.graph (C.facePath f) = List.ofFn (C.side f) :=
  (C.exists_path_darts_eq_ofFn_side f).choose_spec

/-- The boundary path of a face has one dart for each side. -/
@[simp] theorem length_facePath (f : C.Face) : (C.facePath f).length = C.sides f := by
  rw [← SerreGraph.Path.length_darts, darts_facePath, List.length_ofFn]

/-- The relator of a face: the product of the generators given by its sides, in order. -/
def faceRelator (f : C.Face) : FreeGroup C.graph.E :=
  ((List.ofFn (C.side f)).map FreeGroup.of).prod

theorem faceRelator_def (f : C.Face) :
    C.faceRelator f = ((List.ofFn (C.side f)).map FreeGroup.of).prod := (rfl)

/-- The relators of the face presentation killing a set `T` of darts: the relators `e * rev e`
and the relators `e` for `e ∈ T` of the graph presentation, and the relator of every face. -/
def faceRelators (T : Set C.graph.E) : Set (FreeGroup C.graph.E) :=
  C.graph.graphRelators T ∪ Set.range C.faceRelator

theorem faceRelators_def (T : Set C.graph.E) :
    C.faceRelators T = C.graph.graphRelators T ∪ Set.range C.faceRelator := (rfl)

variable {C} in
theorem mem_faceRelators_iff {T : Set C.graph.E} {r : FreeGroup C.graph.E} :
    r ∈ C.faceRelators T ↔ r ∈ C.graph.graphRelators T ∨ ∃ f, C.faceRelator f = r :=
  Iff.rfl

/-- The face presentation of a polygonal complex killing a set `T` of darts: the group generated
by the darts, in which a dart and its reverse are mutually inverse, the darts of `T` are trivial,
and the sides of every face multiply to the identity. For the darts of a spanning tree of the
one-skeleton this is the combinatorial fundamental group of the complex. -/
abbrev FacePresentation (T : Set C.graph.E) : Type v :=
  PresentedGroup (C.faceRelators T)

namespace FacePresentation

variable {C} {T : Set C.graph.E}

/-- Reversing a dart inverts its generator. -/
@[simp] theorem of_rev (e : C.graph.E) :
    (PresentedGroup.of (C.graph.rev e) : C.FacePresentation T) = (PresentedGroup.of e)⁻¹ :=
  eq_inv_of_mul_eq_one_right <| (map_mul (PresentedGroup.mk _) _ _).symm.trans
    (PresentedGroup.one_of_mem
      (Or.inl (SerreGraph.mem_graphRelators_iff.2 (Or.inl ⟨e, rfl⟩))))

/-- The darts of `T` are trivial. -/
@[simp] theorem of_eq_one {e : C.graph.E} (he : e ∈ T) :
    (PresentedGroup.of e : C.FacePresentation T) = 1 :=
  PresentedGroup.one_of_mem (Or.inl (SerreGraph.mem_graphRelators_iff.2 (Or.inr ⟨e, he, rfl⟩)))

/-- The relator of every face is trivial. -/
@[simp] theorem mk_faceRelator (f : C.Face) :
    PresentedGroup.mk (C.faceRelators T) (C.faceRelator f) = 1 :=
  PresentedGroup.one_of_mem (Or.inr ⟨f, rfl⟩)

/-- The sides of every face multiply to the identity. -/
@[simp] theorem prod_ofFn_of_comp_side (f : C.Face) :
    (List.ofFn (PresentedGroup.of ∘ C.side f)).prod = (1 : C.FacePresentation T) := by
  rw [← List.map_ofFn, ← mk_faceRelator (T := T) f, faceRelator_def, map_list_prod, List.map_map]
  -- `PresentedGroup.of` is by definition the class of the free generator.
  rfl

section lift

variable {H : Type*} [Group H] (h : C.graph.E → H) (hT : ∀ e ∈ T, h e = 1)
  (hrev : ∀ e, h (C.graph.rev e) = (h e)⁻¹) (hface : ∀ f, ((List.ofFn (C.side f)).map h).prod = 1)

include hT hrev hface in
/-- The universal property of the face presentation: elements `h e` of a group with `h e = 1`
for `e ∈ T`, `h (rev e) = (h e)⁻¹`, and whose products along the sides of every face are trivial
define a homomorphism sending the dart `e` to `h e`. -/
def lift : C.FacePresentation T →* H :=
  PresentedGroup.toGroup (f := h) <| by
    rintro r (hr | ⟨f, rfl⟩)
    · obtain ⟨e, rfl⟩ | ⟨e, he, rfl⟩ := SerreGraph.mem_graphRelators_iff.1 hr
      · simp [hrev]
      · simp [hT e he]
    · simpa [faceRelator_def, map_list_prod, List.map_map, Function.comp_def] using hface f

@[simp] theorem lift_of (e : C.graph.E) : lift h hT hrev hface (PresentedGroup.of e) = h e :=
  PresentedGroup.toGroup.of _

@[simp] theorem lift_mk (r : FreeGroup C.graph.E) :
    lift h hT hrev hface (PresentedGroup.mk _ r) = FreeGroup.lift h r :=
  PresentedGroup.toGroup_mk _ r

end lift

end FacePresentation

/-! ### The face presentation as a quotient of the path group -/

variable (T : C.graph.SpanningTree) (v : C.graph.V)

-- Based at `v` through the tree, the boundary path of a face is the class of its relator in the
-- graph presentation.
private theorem pathGroupEquivGraphPresentation_basedPath_facePath (f : C.Face) :
    T.pathGroupEquivGraphPresentation v (T.basedPath v (C.facePath f)) =
      PresentedGroup.mk (C.graph.graphRelators T.darts) (C.faceRelator f) := by
  rw [T.pathGroupEquivGraphPresentation_basedPath, darts_facePath, faceRelator_def,
    map_list_prod, List.map_map]
  -- `PresentedGroup.of` is by definition the class of the free generator.
  rfl

/-- **The face presentation is the path group modulo the face loops.** The face presentation of
`C` relative to a spanning tree `T` is isomorphic to the reduced path group of the one-skeleton
at `v` modulo the normal closure of the boundary paths of the faces, each based at `v` by the
tree paths to and from its first corner. A dart corresponds to its based tree loop. -/
noncomputable def facePresentationEquivQuotient :
    C.FacePresentation T.darts ≃* SerreGraph.PathGroup C.graph v ⧸
      Subgroup.normalClosure (Set.range fun f => T.basedPath v (C.facePath f)) :=
  -- The face relators are the union of the graph relators and the face relators proper; the first
  -- isomorphism records this, so that the quotient description applies.
  (PresentedGroup.equivOfNormalClosureEq (congrArg _ (C.faceRelators_def T.darts))).trans <|
  (PresentedGroup.unionEquivQuotient _ _).trans <|
    QuotientGroup.congr _ _ (T.pathGroupEquivGraphPresentation v).symm <| by
      rw [Subgroup.map_normalClosure _ _ (MulEquiv.surjective _), ← Set.range_comp,
        ← Set.range_comp]
      refine congrArg _ (congrArg Set.range (funext fun f => ?_))
      exact (MulEquiv.symm_apply_eq _).2
        (pathGroupEquivGraphPresentation_basedPath_facePath C T v f).symm

/-- The class of a word in the darts corresponds to the class of the same word in the based tree
loops. -/
@[simp] theorem facePresentationEquivQuotient_mk (r : FreeGroup C.graph.E) :
    C.facePresentationEquivQuotient T v (PresentedGroup.mk _ r) =
      ↑(FreeGroup.lift (T.loop v) r) := by
  -- `simp` cannot match words of the face presentation against the words of the union
  -- presentation (the relator sets agree only after unfolding `faceRelators`), so the three
  -- isomorphisms are evaluated one at a time.
  rw [facePresentationEquivQuotient, MulEquiv.trans_apply, MulEquiv.trans_apply,
    PresentedGroup.equivOfNormalClosureEq_mk, PresentedGroup.unionEquivQuotient_mk,
    QuotientGroup.congr_mk]
  exact congrArg _ (FreeGroup.lift_unique
    ((T.pathGroupEquivGraphPresentation v).symm.toMonoidHom.comp (PresentedGroup.mk _))
    (T.pathGroupEquivGraphPresentation_symm_of v))

/-- The generator of a dart corresponds to the class of its based tree loop. -/
@[simp] theorem facePresentationEquivQuotient_of (e : C.graph.E) :
    C.facePresentationEquivQuotient T v (PresentedGroup.of e) = ↑(T.loop v e) :=
  (C.facePresentationEquivQuotient_mk T v (FreeGroup.of e)).trans
    (congrArg _ FreeGroup.lift_apply_of)

/-- The class of the based tree loop of a dart corresponds to its generator. -/
@[simp] theorem facePresentationEquivQuotient_symm_loop (e : C.graph.E) :
    (C.facePresentationEquivQuotient T v).symm ↑(T.loop v e) = PresentedGroup.of e := by
  rw [MulEquiv.symm_apply_eq, facePresentationEquivQuotient_of]

/-- Based at `v` through the tree, a path corresponds to the product of the generators of its
darts. -/
@[simp] theorem facePresentationEquivQuotient_symm_basedPath {a b : C.graph.V}
    (p : C.graph.Path a b) :
    (C.facePresentationEquivQuotient T v).symm ↑(T.basedPath v p) =
      ((SerreGraph.Path.darts C.graph p).map PresentedGroup.of).prod := by
  rw [MulEquiv.symm_apply_eq, map_list_prod, T.basedPath_eq_prod_loop, ← QuotientGroup.mk'_apply,
    map_list_prod]
  simp [Function.comp_def]

/-- The class of a closed path at `v` corresponds to the product of the generators of its
darts. -/
@[simp] theorem facePresentationEquivQuotient_symm_ofPath (p : C.graph.Path v v) :
    (C.facePresentationEquivQuotient T v).symm ↑(SerreGraph.PathGroup.ofPath p) =
      ((SerreGraph.Path.darts C.graph p).map PresentedGroup.of).prod := by
  rw [← T.basedPath_self, facePresentationEquivQuotient_symm_basedPath]

/-! ### Polygons -/

section Polygon

variable {α : Type u} (w : List (α × Bool)) (hw : w ≠ [])

-- Read in the petals of the rose, the face relator of the polygon with word `w` is `w`.
private theorem roseGraphPresentationEquivFreeGroup_mk_faceRelator_polygon :
    SerreGraph.roseGraphPresentationEquivFreeGroup α
        (PresentedGroup.mk _ ((polygon w hw).faceRelator ())) = FreeGroup.mk w := by
  rw [SerreGraph.roseGraphPresentationEquivFreeGroup_mk, faceRelator_def, map_list_prod,
    List.map_map, ← MonoidHom.id_apply _ (FreeGroup.mk w), MonoidHom.apply_freeGroup_mk]
  -- The sides of the face are the letters of `w`, read as darts of the rose.
  exact congrArg List.prod ((congrArg (List.map _) (List.ofFn_getElem (xs := w))).trans
    (List.map_congr_left fun _ _ => FreeGroup.lift_apply_of))

/-- **The face group of a one-vertex polygon is a one-relator group.** The face presentation of
the polygon with word `w` on the rose with petals `α`, killing no darts, is `⟨α | w⟩`: the dart
`(a, true)` is the generator `a` and `(a, false)` is its inverse. -/
noncomputable def polygonFacePresentationEquiv :
    (polygon w hw).FacePresentation ∅ ≃* PresentedGroup {FreeGroup.mk w} :=
  -- The face presentation is the graph presentation of the rose modulo the face relator; the
  -- graph presentation of the rose is free on the petals, and the free group modulo `w` is the
  -- group presented by `w`.
  (PresentedGroup.equivOfNormalClosureEq (congrArg _ ((polygon w hw).faceRelators_def ∅))).trans <|
  (PresentedGroup.unionEquivQuotient _ _).trans <|
  (QuotientGroup.congr _ (Subgroup.normalClosure (PresentedGroup.mk ∅ '' {FreeGroup.mk w}))
    ((SerreGraph.roseGraphPresentationEquivFreeGroup α).trans
      PresentedGroup.emptyEquivFreeGroup.symm) <| by
    rw [Subgroup.map_normalClosure _ _ (MulEquiv.surjective _), ← Set.range_comp,
      ← Set.range_comp, Set.range_unique, Set.image_singleton, Function.comp_apply,
      Function.comp_apply, MonoidHom.coe_ofClass, MulEquiv.trans_apply,
      roseGraphPresentationEquivFreeGroup_mk_faceRelator_polygon,
      PresentedGroup.emptyEquivFreeGroup_symm_apply]).trans <|
  (PresentedGroup.unionEquivQuotient ∅ {FreeGroup.mk w}).symm.trans <|
    PresentedGroup.equivOfNormalClosureEq (congrArg _ (Set.empty_union _))

/-- The class of a word in the darts of the polygon corresponds to the class of the word in the
petals obtained by reading `(a, true)` as `a` and `(a, false)` as `a⁻¹`. -/
@[simp] theorem polygonFacePresentationEquiv_mk (r : FreeGroup (polygon w hw).graph.E) :
    polygonFacePresentationEquiv w hw (PresentedGroup.mk _ r) =
      PresentedGroup.mk _
        (FreeGroup.lift (fun e => cond e.2 (FreeGroup.of e.1) (FreeGroup.of e.1)⁻¹) r) := by
  rw [polygonFacePresentationEquiv, MulEquiv.trans_apply, MulEquiv.trans_apply,
    MulEquiv.trans_apply, MulEquiv.trans_apply, PresentedGroup.equivOfNormalClosureEq_mk,
    PresentedGroup.unionEquivQuotient_mk, QuotientGroup.congr_mk, MulEquiv.trans_apply,
    SerreGraph.roseGraphPresentationEquivFreeGroup_mk,
    PresentedGroup.emptyEquivFreeGroup_symm_apply, PresentedGroup.unionEquivQuotient_symm_mk,
    PresentedGroup.equivOfNormalClosureEq_mk]

/-- A dart of the polygon corresponds to its petal or to the inverse of its petal. -/
@[simp] theorem polygonFacePresentationEquiv_of (e : (polygon w hw).graph.E) :
    polygonFacePresentationEquiv w hw (PresentedGroup.of e) =
      cond e.2 (PresentedGroup.of e.1) (PresentedGroup.of e.1)⁻¹ := by
  rw [PresentedGroup.of, polygonFacePresentationEquiv_mk, FreeGroup.lift_apply_of]
  obtain ⟨a, _ | _⟩ := e
  exacts [map_inv _ _, rfl]

/-- A petal corresponds to its positive dart. -/
@[simp] theorem polygonFacePresentationEquiv_symm_of (a : α) :
    (polygonFacePresentationEquiv w hw).symm (PresentedGroup.of a) =
      PresentedGroup.of (rels := (polygon w hw).faceRelators ∅) (a, true) :=
  (MulEquiv.symm_apply_eq _).2 (polygonFacePresentationEquiv_of w hw (a, true)).symm

/-- The class of a word in the petals corresponds to the same word in the positive darts. -/
@[simp] theorem polygonFacePresentationEquiv_symm_mk (r : FreeGroup α) :
    (polygonFacePresentationEquiv w hw).symm (PresentedGroup.mk _ r) =
      FreeGroup.lift
        (fun a => PresentedGroup.of (rels := (polygon w hw).faceRelators ∅) (a, true)) r :=
  FreeGroup.lift_unique ((polygonFacePresentationEquiv w hw).symm.toMonoidHom.comp
    (PresentedGroup.mk _)) (polygonFacePresentationEquiv_symm_of w hw)

end Polygon

-- A complex equal to a polygon has, relative to any spanning tree, the one-relator face group of
-- the polygon: its one-skeleton is a rose, whose only spanning tree has no darts.
private theorem nonempty_facePresentation_mulEquiv_of_eq_polygon {α : Type u} {w : List (α × Bool)}
    {hw : w ≠ []} {C : PolygonalComplex.{0, u, 0}} (hC : C = polygon w hw)
    (T : C.graph.SpanningTree) :
    Nonempty (C.FacePresentation T.darts ≃* PresentedGroup {FreeGroup.mk w}) := by
  subst hC
  rw [Subsingleton.elim T (SerreGraph.roseTree α), SerreGraph.roseTree_darts]
  exact ⟨polygonFacePresentationEquiv w hw⟩

-- A complex equal to the polygon with the one-letter word `a` has trivial face group, whatever
-- darts it kills: the face relation kills the petal, and with it its reverse.
private theorem subsingleton_facePresentation_of_eq_polygon_singleton
    {C : PolygonalComplex.{0, 0, 0}} (hC : C = polygon [((), true)] (List.cons_ne_nil _ _))
    (T : Set C.graph.E) : Subsingleton (C.FacePresentation T) := by
  subst hC
  -- The face of the disc has the single side `((), true)`, so its relator is that generator.
  have h : (PresentedGroup.of ((), true) : FacePresentation _ T) = 1 :=
    FacePresentation.mk_faceRelator (T := T) ()
  have hof : MonoidHom.id (FacePresentation _ T) = 1 := PresentedGroup.ext fun
    | ((), true) => h
    | ((), false) => (FacePresentation.of_rev (T := T) ((), true)).trans (inv_eq_one.2 h)
  exact subsingleton_of_forall_eq 1 fun x => DFunLike.congr_fun hof x

end PolygonalComplex

/-! ### The face groups of the standard surface models -/

namespace SurfaceModel

open PolygonalComplex

/-- The face group of the disc is trivial, whatever darts it kills: its face relation kills the
generator of its single edge, the boundary loop. -/
instance instSubsingletonFacePresentationDisc (T : Set disc.graph.E) :
    Subsingleton (disc.FacePresentation T) :=
  subsingleton_facePresentation_of_eq_polygon_singleton disc_toPolygonalComplex T

-- The torus relator `a b a⁻¹ b⁻¹` presents the genus-one surface group, with `a` and `b`
-- corresponding to the inverses of the surface generators.
private noncomputable def torusRelatorEquiv :
    PresentedGroup {FreeGroup.mk [((0 : Fin 2), true), (1, true), (0, false), (1, false)]} ≃*
      SurfaceGroup.Orientable 1 0 :=
  PresentedGroup.equivOfGeneratorWords
    ![(FreeGroup.of (.a 0))⁻¹, (FreeGroup.of (.b 0))⁻¹]
    (fun | .a _ => (FreeGroup.of 0)⁻¹ | .b _ => (FreeGroup.of 1)⁻¹ | .peripheral j => j.elim0)
    (by
      rintro _ rfl
      refine PresentedGroup.one_of_mem ?_
      simp [FreeGroup.lift_mk, SurfaceGroup.orientableRelator_def,
        SurfaceGroup.orientableWord_def, mul_assoc])
    (by
      rintro _ rfl
      refine PresentedGroup.one_of_mem ?_
      rw [Set.mem_singleton_iff, ← FreeGroup.lift_of_apply (FreeGroup.mk _), FreeGroup.lift_mk]
      simp [SurfaceGroup.orientableRelator_def, SurfaceGroup.orientableWord_def, mul_assoc])
    (fun i => by fin_cases i <;> simp [PresentedGroup.of])
    (fun
      | .a i => by fin_cases i; simp [PresentedGroup.of]
      | .b i => by fin_cases i; simp [PresentedGroup.of]
      | .peripheral j => j.elim0)

/-- The face group of the torus `a b a⁻¹ b⁻¹` relative to a spanning tree is the genus-one
surface group `S⁺(1, 0) = ⟨a, b | [a, b]⟩`. -/
theorem nonempty_facePresentation_torus_mulEquiv_orientable (T : torus.graph.SpanningTree) :
    Nonempty (torus.FacePresentation T.darts ≃* SurfaceGroup.Orientable 1 0) := by
  obtain ⟨e⟩ := nonempty_facePresentation_mulEquiv_of_eq_polygon torus_toPolygonalComplex T
  exact ⟨e.trans torusRelatorEquiv⟩

-- The projective plane relator `a a` presents `S⁻(1, 0)`.
private noncomputable def projectivePlaneRelatorEquiv :
    PresentedGroup {FreeGroup.mk [((), true), ((), true)]} ≃* SurfaceGroup.Nonorientable 1 0 :=
  PresentedGroup.equivOfGeneratorWords (fun _ => FreeGroup.of (.c 0))
    (fun | .c _ => FreeGroup.of () | .peripheral j => j.elim0)
    (by
      rintro _ rfl
      refine PresentedGroup.one_of_mem ?_
      simp [FreeGroup.lift_mk, SurfaceGroup.nonorientableRelator_def,
        SurfaceGroup.nonorientableWord_def, pow_two])
    (by
      rintro _ rfl
      refine PresentedGroup.one_of_mem ?_
      rw [Set.mem_singleton_iff, ← FreeGroup.lift_of_apply (FreeGroup.mk _), FreeGroup.lift_mk]
      simp [SurfaceGroup.nonorientableRelator_def, SurfaceGroup.nonorientableWord_def, pow_two])
    (fun _ => by simp [PresentedGroup.of])
    (fun
      | .c i => by fin_cases i; simp [PresentedGroup.of]
      | .peripheral j => j.elim0)

/-- The face group of the projective plane `a a` relative to a spanning tree is
`S⁻(1, 0) = ⟨c | c ^ 2⟩`. -/
theorem nonempty_facePresentation_projectivePlane_mulEquiv_nonorientable
    (T : projectivePlane.graph.SpanningTree) :
    Nonempty (projectivePlane.FacePresentation T.darts ≃* SurfaceGroup.Nonorientable 1 0) := by
  obtain ⟨e⟩ :=
    nonempty_facePresentation_mulEquiv_of_eq_polygon projectivePlane_toPolygonalComplex T
  exact ⟨e.trans projectivePlaneRelatorEquiv⟩

end SurfaceModel

