import TauCeti.GroupTheory.Perm.PermCongr

/-!
# Bipartite ribbon graphs as finite group actions

The category of finite bipartite ribbon graphs is equivalent to
`Action FintypeCat (FreeGroup (Fin 2))` by `TauCeti.BipartiteRibbonGraph.edgeEquivalence`.
Its forward functor `TauCeti.BipartiteRibbonGraph.edgeFunctor` acts on the edges, with free
generators `0` and `1` acting by the black and white rotations. This classifies bipartite
ribbon graphs, including dessins d'enfants, by pairs of permutations up to simultaneous
relabeling of the edge set. The graph is connected exactly when the edge action is nonempty and
transitive, as stated in
`TauCeti.BipartiteRibbonGraph.isConnected_iff_nonempty_and_isPretransitive_edgeFunctor_obj`.

The forward action uses `FreeGroup.lift`. The inverse functor reconstructs each object with
`Action.toBipartiteRibbonGraph`, which uses `Equiv.Perm.bipartiteRibbonGraph` to recover
vertices as cycles of the generators.

## References

* S. K. Lando and A. K. Zvonkin, *Graphs on Surfaces and Their Applications*, Encyclopaedia of
  Mathematical Sciences 141, Springer, 2004, §1.3 and §1.5.
-/

public section

open CategoryTheory

namespace TauCeti.BipartiteRibbonGraph

universe u

private def edgeRepresentation (Γ : BipartiteRibbonGraph.{u}) :
    FreeGroup (Fin 2) →* Equiv.Perm Γ.E := FreeGroup.lift ![Γ.rotB, Γ.rotW]

private abbrev edgeAction (Γ : BipartiteRibbonGraph.{u}) :
    Action FintypeCat.{u} (FreeGroup (Fin 2)) :=
  letI := MulAction.compHom Γ.E (edgeRepresentation Γ)
  Action.FintypeCat.ofMulAction _ (FintypeCat.of Γ.E)

/-- The representation evaluates a free generator by the corresponding vertex rotation. -/
private theorem edgeRepresentation_of_apply (Γ : BipartiteRibbonGraph.{u}) (i : Fin 2) (x : Γ.E) :
    edgeRepresentation Γ (FreeGroup.of i) x = (![Γ.rotB, Γ.rotW] i) x := by
  rw [edgeRepresentation, FreeGroup.lift_apply_of]

private theorem edgeRepresentation_comm {Γ Δ : BipartiteRibbonGraph.{u}} (f : Γ.Hom Δ)
    (g : FreeGroup (Fin 2)) (x : Γ.E) :
    f.edge (edgeRepresentation Γ g x) = edgeRepresentation Δ g (f.edge x) := by
  induction g using FreeGroup.induction_on generalizing x with
  | one => simp
  | of i =>
    simp only [edgeRepresentation_of_apply]
    revert i
    simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one]
    exact ⟨f.map_rotB x, f.map_rotW x⟩
  | inv_of i ih =>
    simpa only [map_inv, Equiv.Perm.inv_def] using
      Function.Semiconj.inverses_right ih (Equiv.apply_symm_apply _) (Equiv.symm_apply_apply _) x
  | mul g h hg hh => simp only [map_mul, Equiv.Perm.mul_apply, hg, hh]

/-- The edge functor sends the two free generators to the black and white rotations. -/
def edgeFunctor :
    BipartiteRibbonGraph.{u} ⥤ Action FintypeCat.{u} (FreeGroup (Fin 2)) where
  obj := edgeAction
  map {Γ Δ} f :=
    ⟨FintypeCat.homMk (X := FintypeCat.of Γ.E) (Y := FintypeCat.of Δ.E) f.edge,
      fun g ↦ FintypeCat.hom_ext _ _ (edgeRepresentation_comm f g)⟩
  map_id _ := Action.hom_ext _ _ (FintypeCat.hom_ext _ _ id_edge_apply)
  map_comp f g := Action.hom_ext _ _ (FintypeCat.hom_ext _ _ (comp_edge_apply f g))

private theorem edgeFunctor_obj_ρ_apply (Γ : BipartiteRibbonGraph.{u})
    (g : FreeGroup (Fin 2)) (x : Γ.E) :
    ((edgeFunctor.obj Γ).ρ g).asHom x = edgeRepresentation Γ g x := by
  let := MulAction.compHom Γ.E (edgeRepresentation Γ)
  exact (Action.FintypeCat.ofMulAction_apply (H := FintypeCat.of Γ.E) g x).trans
    ((MulAction.compHom_smul_def (edgeRepresentation Γ) g x).trans (Equiv.Perm.smul_def _ _))

/-- Identify the finite carrier of the edge action with the graph's edge type for transport. -/
@[simp] theorem edgeFunctor_obj_V (Γ : BipartiteRibbonGraph.{u}) :
    (edgeFunctor.obj Γ).V = FintypeCat.of Γ.E := (rfl)

/-- Identify the underlying type of the edge action with the edge type of the graph. -/
def edgeEquiv (Γ : BipartiteRibbonGraph.{u}) : (edgeFunctor.obj Γ).V ≃ Γ.E :=
  -- The carrier is definitionally `Γ.E`, as `edgeFunctor_obj_V` records.
  Equiv.refl _

/-- The edge action evaluates any free-group element via the representation generated by the two
rotations. -/
theorem edgeEquiv_edgeFunctor_obj_ρ_apply (Γ : BipartiteRibbonGraph.{u})
    (g : FreeGroup (Fin 2)) (x : Γ.E) :
    Γ.edgeEquiv (((edgeFunctor.obj Γ).ρ g).asHom (Γ.edgeEquiv.symm x)) =
      (FreeGroup.lift ![Γ.rotB, Γ.rotW] g) x :=
  edgeFunctor_obj_ρ_apply Γ g x

/-- The generators act on the graph's edges by the black and white rotations, respectively. -/
@[simp] theorem edgeEquiv_edgeFunctor_obj_ρ_of_apply (Γ : BipartiteRibbonGraph.{u})
    (i : Fin 2) (x : Γ.E) :
    Γ.edgeEquiv (((edgeFunctor.obj Γ).ρ (FreeGroup.of i)).asHom (Γ.edgeEquiv.symm x)) =
      (![Γ.rotB, Γ.rotW] i) x := by
  rw [edgeEquiv_edgeFunctor_obj_ρ_apply, FreeGroup.lift_apply_of]

/-- The edge functor acts on morphisms by their edge maps. -/
@[simp] theorem edgeEquiv_edgeFunctor_map_hom_apply {Γ Δ : BipartiteRibbonGraph.{u}}
    (f : Γ ⟶ Δ) (x : Γ.E) :
    Δ.edgeEquiv ((edgeFunctor.map f).hom (Γ.edgeEquiv.symm x)) = f.edge x := by
  exact FintypeCat.homMk_apply (X := FintypeCat.of Γ.E) (Y := FintypeCat.of Δ.E) f.edge x

private noncomputable def edgeFunctorPreimage {Γ Δ : BipartiteRibbonGraph.{u}}
    (f : edgeFunctor.obj Γ ⟶ edgeFunctor.obj Δ) : Γ ⟶ Δ := by
  let e : Γ.E → Δ.E := fun x ↦ Δ.edgeEquiv (f.hom (Γ.edgeEquiv.symm x))
  have h (i : Fin 2) (x : Γ.E) : e ((![Γ.rotB, Γ.rotW] i) x) =
      (![Δ.rotB, Δ.rotW] i) (e x) := by
    have hc : f.hom (((edgeFunctor.obj Γ).ρ (FreeGroup.of i)).asHom (Γ.edgeEquiv.symm x)) =
        ((edgeFunctor.obj Δ).ρ (FreeGroup.of i)).asHom (f.hom (Γ.edgeEquiv.symm x)) := by
      simpa only [FintypeCat.comp_apply] using
        ConcreteCategory.congr_hom (f.comm (FreeGroup.of i)) (Γ.edgeEquiv.symm x)
    rw [← edgeEquiv_edgeFunctor_obj_ρ_of_apply, ← edgeEquiv_edgeFunctor_obj_ρ_of_apply]
    simpa only [e, Equiv.symm_apply_apply] using congrArg Δ.edgeEquiv hc
  exact Hom.ofEdge e (fun x ↦ by simpa only [Matrix.cons_val_zero] using h 0 x)
    (fun x ↦ by simpa only [Matrix.cons_val_one, Matrix.cons_val_zero] using h 1 x)

private theorem edgeFunctorPreimage_edge_apply {Γ Δ : BipartiteRibbonGraph.{u}}
    (f : edgeFunctor.obj Γ ⟶ edgeFunctor.obj Δ) (x : Γ.E) :
    (edgeFunctorPreimage f).edge x = Δ.edgeEquiv (f.hom (Γ.edgeEquiv.symm x)) := by
  exact congrFun (Hom.ofEdge_edge (Γ := Γ) (Δ := Δ) _ _ _) x

/-- The edge functor is fully faithful. An equivariant edge map extends uniquely to a graph
morphism, with vertex maps induced through the endpoint maps. -/
noncomputable def fullyFaithfulEdgeFunctor : edgeFunctor.{u}.FullyFaithful where
  preimage := edgeFunctorPreimage
  map_preimage {Γ Δ} f := by
    refine Action.hom_ext _ _ (FintypeCat.hom_ext _ _ fun x ↦ Δ.edgeEquiv.injective ?_)
    simpa only [Equiv.symm_apply_apply, edgeFunctorPreimage_edge_apply] using
      edgeEquiv_edgeFunctor_map_hom_apply (edgeFunctorPreimage f) (Γ.edgeEquiv x)
  preimage_map f := hom_ext (funext fun x ↦
    (edgeFunctorPreimage_edge_apply (edgeFunctor.map f) x).trans
      (edgeEquiv_edgeFunctor_map_hom_apply f x))

/-- The preimage of an action morphism has the same underlying edge map. -/
@[simp] theorem fullyFaithfulEdgeFunctor_preimage_edge_apply {Γ Δ : BipartiteRibbonGraph.{u}}
    (f : edgeFunctor.obj Γ ⟶ edgeFunctor.obj Δ) (x : Γ.E) :
    (fullyFaithfulEdgeFunctor.preimage f).edge x = Δ.edgeEquiv (f.hom (Γ.edgeEquiv.symm x)) :=
  edgeFunctorPreimage_edge_apply f x

/-- The ribbon graph whose black and white vertices are the cycles of the two generators of a
finite free-group action. -/
noncomputable def _root_.Action.toBipartiteRibbonGraph
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    BipartiteRibbonGraph.{u} := by
  classical
  let := FintypeCat.fintype (X := A.V)
  let ρ := MulAction.toPermHom (FreeGroup (Fin 2)) A.V
  exact (ρ (FreeGroup.of 0)).bipartiteRibbonGraph (ρ (FreeGroup.of 1))

/-- The edges of the reconstructed graph are the elements of the original action. -/
theorem _root_.Action.toBipartiteRibbonGraph_E
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    A.toBipartiteRibbonGraph.E = A.V := (rfl)

/-- Identify the edges of the reconstructed graph with the elements of the original action. -/
noncomputable def _root_.Action.toBipartiteRibbonGraphEdgeEquiv
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    A.toBipartiteRibbonGraph.E ≃ A.V :=
  Equiv.cast A.toBipartiteRibbonGraph_E

/-- The black vertices of the reconstructed graph are the cycles of generator `0`. -/
noncomputable def _root_.Action.toBipartiteRibbonGraphBlackEquiv
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    A.toBipartiteRibbonGraph.B ≃
      Quotient (Equiv.Perm.SameCycle.setoid
        (MulAction.toPermHom (FreeGroup (Fin 2)) A.V (FreeGroup.of 0))) :=
  Equiv.refl _

/-- The white vertices of the reconstructed graph are the cycles of generator `1`. -/
noncomputable def _root_.Action.toBipartiteRibbonGraphWhiteEquiv
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    A.toBipartiteRibbonGraph.W ≃
      Quotient (Equiv.Perm.SameCycle.setoid
        (MulAction.toPermHom (FreeGroup (Fin 2)) A.V (FreeGroup.of 1))) :=
  Equiv.refl _

/-- The black endpoint is the cycle of the edge under generator `0`. -/
@[simp] theorem _root_.Action.toBipartiteRibbonGraphBlackEquiv_blackEnd
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) (x : A.toBipartiteRibbonGraph.E) :
    A.toBipartiteRibbonGraphBlackEquiv (A.toBipartiteRibbonGraph.blackEnd x) =
      Quotient.mk _ (A.toBipartiteRibbonGraphEdgeEquiv x) := (rfl)

/-- The white endpoint is the cycle of the edge under generator `1`. -/
@[simp] theorem _root_.Action.toBipartiteRibbonGraphWhiteEquiv_whiteEnd
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) (x : A.toBipartiteRibbonGraph.E) :
    A.toBipartiteRibbonGraphWhiteEquiv (A.toBipartiteRibbonGraph.whiteEnd x) =
      Quotient.mk _ (A.toBipartiteRibbonGraphEdgeEquiv x) := (rfl)

private theorem edgeRepresentation_ofAction (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    edgeRepresentation A.toBipartiteRibbonGraph = MulAction.toPermHom (FreeGroup (Fin 2)) A.V := by
  classical
  apply FreeGroup.ext_hom
  intro i
  rw [edgeRepresentation, FreeGroup.lift_apply_of]
  revert i
  simp only [Fin.forall_fin_two, Action.toBipartiteRibbonGraph,
    Equiv.Perm.rotB_bipartiteRibbonGraph, Equiv.Perm.rotW_bipartiteRibbonGraph]
  exact ⟨Matrix.cons_val_zero _ _, (Matrix.cons_val_one _ _).trans (Matrix.cons_val_zero _ _)⟩

private theorem ofAction_edgeRepresentation_apply
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) (g : FreeGroup (Fin 2))
    (x : A.toBipartiteRibbonGraph.E) :
    A.toBipartiteRibbonGraphEdgeEquiv (edgeRepresentation A.toBipartiteRibbonGraph g x) =
      (A.ρ g).asHom (A.toBipartiteRibbonGraphEdgeEquiv x) := by
  -- The edge type is definitionally the carrier, as recorded by `Action.toBipartiteRibbonGraph_E`.
  have h := congrArg (fun p : FreeGroup (Fin 2) →* Equiv.Perm A.V ↦ p g x)
    (edgeRepresentation_ofAction A)
  exact h.trans (A.toPermHom_apply_eq_ρ g x)

/-- The black rotation of the reconstructed graph is the action of generator `0`. -/
@[simp] theorem _root_.Action.toBipartiteRibbonGraphEdgeEquiv_rotB_apply
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2)))
    (x : A.toBipartiteRibbonGraph.E) :
    A.toBipartiteRibbonGraphEdgeEquiv (A.toBipartiteRibbonGraph.rotB x) =
      (A.ρ (FreeGroup.of 0)).asHom (A.toBipartiteRibbonGraphEdgeEquiv x) := by
  simpa only [edgeRepresentation_of_apply, Matrix.cons_val_zero] using
    ofAction_edgeRepresentation_apply A (FreeGroup.of 0) x

/-- The white rotation of the reconstructed graph is the action of generator `1`. -/
@[simp] theorem _root_.Action.toBipartiteRibbonGraphEdgeEquiv_rotW_apply
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2)))
    (x : A.toBipartiteRibbonGraph.E) :
    A.toBipartiteRibbonGraphEdgeEquiv (A.toBipartiteRibbonGraph.rotW x) =
      (A.ρ (FreeGroup.of 1)).asHom (A.toBipartiteRibbonGraphEdgeEquiv x) := by
  simpa only [edgeRepresentation_of_apply, Matrix.cons_val_one,
    Matrix.cons_val_zero] using
    ofAction_edgeRepresentation_apply A (FreeGroup.of 1) x

/-- The edge action on the reconstructed graph recovers the input action. -/
noncomputable def _root_.Action.toBipartiteRibbonGraphEdgeIso
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    edgeFunctor.obj A.toBipartiteRibbonGraph ≅ A :=
  Action.mkIso (FintypeCat.equivEquivIso
    (A.toBipartiteRibbonGraph.edgeEquiv.trans A.toBipartiteRibbonGraphEdgeEquiv))
    (fun g ↦ FintypeCat.hom_ext _ _ fun x ↦ by
      simp only [FintypeCat.comp_apply, FintypeCat.equivEquivIso_apply_hom, FintypeCat.homMk_apply,
        Equiv.trans_apply]
      have h := edgeEquiv_edgeFunctor_obj_ρ_apply A.toBipartiteRibbonGraph g
        (A.toBipartiteRibbonGraph.edgeEquiv x)
      rw [Equiv.symm_apply_apply] at h
      exact (congrArg A.toBipartiteRibbonGraphEdgeEquiv h).trans
        (ofAction_edgeRepresentation_apply A g (A.toBipartiteRibbonGraph.edgeEquiv x)))

/-- The comparison with the original action sends an edge to the corresponding carrier point. -/
@[simp] theorem _root_.Action.toBipartiteRibbonGraphEdgeIso_hom_apply
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2)))
    (x : (edgeFunctor.obj A.toBipartiteRibbonGraph).V) :
    A.toBipartiteRibbonGraphEdgeIso.hom.hom x =
      A.toBipartiteRibbonGraphEdgeEquiv (A.toBipartiteRibbonGraph.edgeEquiv x) := by
  unfold Action.toBipartiteRibbonGraphEdgeIso
  rw [Action.mkIso_hom_hom _ _, FintypeCat.equivEquivIso_apply_hom, FintypeCat.homMk_apply,
    Equiv.trans_apply]

/-- The inverse comparison sends a carrier point to the corresponding edge-action point. -/
@[simp] theorem _root_.Action.toBipartiteRibbonGraphEdgeIso_inv_apply
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) (x : A.V) :
    A.toBipartiteRibbonGraphEdgeIso.inv.hom x =
      A.toBipartiteRibbonGraph.edgeEquiv.symm (A.toBipartiteRibbonGraphEdgeEquiv.symm x) := by
  apply (A.toBipartiteRibbonGraph.edgeEquiv.trans A.toBipartiteRibbonGraphEdgeEquiv).injective
  simpa only [Equiv.trans_apply, Equiv.apply_symm_apply, FintypeCat.comp_apply,
    FintypeCat.id_apply, Action.toBipartiteRibbonGraphEdgeIso_hom_apply] using
    congrArg (fun f : A.V ⟶ A.V ↦ f x) (Action.inv_hom_hom A.toBipartiteRibbonGraphEdgeIso)

/-- Every finite action is isomorphic to the edge action of a ribbon graph, which completes the
fully faithful edge functor to an equivalence available through typeclass inference. -/
instance : edgeFunctor.{u}.IsEquivalence where
  faithful := fullyFaithfulEdgeFunctor.faithful
  full := fullyFaithfulEdgeFunctor.full
  essSurj.mem_essImage A := ⟨A.toBipartiteRibbonGraph, ⟨A.toBipartiteRibbonGraphEdgeIso⟩⟩

private noncomputable def reconstructionFunctor :
    Action FintypeCat.{u} (FreeGroup (Fin 2)) ⥤ BipartiteRibbonGraph.{u} where
  obj A := A.toBipartiteRibbonGraph
  map {A B} f := fullyFaithfulEdgeFunctor.preimage
    (A.toBipartiteRibbonGraphEdgeIso.hom ≫ f ≫ B.toBipartiteRibbonGraphEdgeIso.inv)
  map_id A := by
    rw [Category.id_comp, Iso.hom_inv_id, Functor.FullyFaithful.preimage_id]
  map_comp f g := by
    rw [← Functor.FullyFaithful.preimage_comp]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]

/-- Bipartite ribbon graphs are equivalent to finite actions of the free group on two generators.
The inverse reconstructs the graph from the cycles of the two generators. -/
noncomputable def edgeEquivalence :
    BipartiteRibbonGraph.{u} ≌ Action FintypeCat.{u} (FreeGroup (Fin 2)) where
  functor := edgeFunctor
  inverse := reconstructionFunctor
  unitIso := NatIso.ofComponents
    (fun Γ ↦ fullyFaithfulEdgeFunctor.preimageIso
      (edgeFunctor.obj Γ).toBipartiteRibbonGraphEdgeIso.symm) (by
    intro Γ Δ f
    apply fullyFaithfulEdgeFunctor.map_injective
    -- The two projected maps of the reconstruction functor are fully faithful preimages.
    dsimp only [Functor.id_map, Functor.comp_map, reconstructionFunctor]
    simp only [Functor.map_comp, Functor.FullyFaithful.preimageIso_hom, Iso.symm_hom,
      Functor.FullyFaithful.map_preimage, Iso.inv_hom_id_assoc])
  counitIso := NatIso.ofComponents Action.toBipartiteRibbonGraphEdgeIso (by
    intro A B f
    dsimp only [Functor.comp_map, Functor.id_map, reconstructionFunctor]
    simp only [Functor.FullyFaithful.map_preimage, Category.assoc, Iso.inv_hom_id,
      Category.comp_id])
  functor_unitIso_comp Γ := by
    -- Reduce both natural isomorphism components, including their functor object indices.
    dsimp only [NatIso.ofComponents, Functor.id_obj, Functor.comp_obj]
    let e := (edgeFunctor.obj Γ).toBipartiteRibbonGraphEdgeIso
    have h : edgeFunctor.map (fullyFaithfulEdgeFunctor.preimageIso e.symm).hom ≫ e.hom =
        𝟙 (edgeFunctor.obj Γ) := by
      rw [Functor.FullyFaithful.preimageIso_hom, Functor.FullyFaithful.map_preimage,
        Iso.symm_hom, Iso.inv_hom_id]
    exact h

/-- The forward functor of the equivalence is the edge functor. -/
@[simp] theorem edgeEquivalence_functor : edgeEquivalence.{u}.functor = edgeFunctor := (rfl)

/-- The inverse functor reconstructs the graph of the two generator permutations. -/
@[simp] theorem _root_.Action.edgeEquivalence_inverse_obj
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    edgeEquivalence.inverse.obj A = A.toBipartiteRibbonGraph := (rfl)

/-- On edges, the inverse equivalence acts by the underlying map of the action morphism,
transported along the identifications with the reconstructed graphs. -/
@[simp] theorem _root_.Action.edgeEquivalence_inverse_map_edge_apply
    {A B : Action FintypeCat.{u} (FreeGroup (Fin 2))} (f : A ⟶ B)
    (x : (edgeEquivalence.inverse.obj A).E) :
    (edgeEquivalence.inverse.map f).edge x =
      cast (congrArg BipartiteRibbonGraph.E B.edgeEquivalence_inverse_obj.symm)
        (B.toBipartiteRibbonGraphEdgeEquiv.symm (f.hom (A.toBipartiteRibbonGraphEdgeEquiv
          (cast (congrArg BipartiteRibbonGraph.E A.edgeEquivalence_inverse_obj) x)))) := by
  -- The object equalities in the casts are reflexive by the definition of the inverse.
  let y : A.toBipartiteRibbonGraph.E := x
  have h : (fullyFaithfulEdgeFunctor.preimage
        (A.toBipartiteRibbonGraphEdgeIso.hom ≫
          f ≫ B.toBipartiteRibbonGraphEdgeIso.inv)).edge y =
      B.toBipartiteRibbonGraphEdgeEquiv.symm (f.hom (A.toBipartiteRibbonGraphEdgeEquiv y)) := by
    simp only [fullyFaithfulEdgeFunctor_preimage_edge_apply, Action.comp_hom, FintypeCat.comp_apply,
      Action.toBipartiteRibbonGraphEdgeIso_hom_apply,
      Action.toBipartiteRibbonGraphEdgeIso_inv_apply, Equiv.apply_symm_apply]
  exact h

/-- The counit compares the edge action of the reconstructed graph with the input action. -/
@[simp] theorem _root_.Action.edgeEquivalence_counitIso_app
    (A : Action FintypeCat.{u} (FreeGroup (Fin 2))) :
    edgeEquivalence.counitIso.app A =
      eqToIso (by
        rw [Functor.comp_obj, edgeEquivalence_functor, Action.edgeEquivalence_inverse_obj]) ≪≫
        A.toBipartiteRibbonGraphEdgeIso := (rfl)

/-- The unit lifts the inverse of the action comparison to an isomorphism of graphs. -/
@[simp] theorem edgeEquivalence_unitIso_app (Γ : BipartiteRibbonGraph.{u}) :
    edgeEquivalence.unitIso.app Γ =
      fullyFaithfulEdgeFunctor.preimageIso (edgeFunctor.obj Γ).toBipartiteRibbonGraphEdgeIso.symm ≪≫
        eqToIso (by
          rw [Functor.comp_obj, edgeEquivalence_functor, Action.edgeEquivalence_inverse_obj]) := by
  -- The target object of the unit is definitionally the reconstruction of the edge action.
  have h := CategoryTheory.Iso.trans_refl
    (fullyFaithfulEdgeFunctor.preimageIso (edgeFunctor.obj Γ).toBipartiteRibbonGraphEdgeIso.symm)
  exact h.symm

/-- A graph is connected exactly when its edge action is nonempty and transitive. -/
theorem isConnected_iff_nonempty_and_isPretransitive_edgeFunctor_obj
    {Γ : BipartiteRibbonGraph.{u}} :
    Γ.IsConnected ↔ Nonempty (edgeFunctor.obj Γ).V ∧
      MulAction.IsPretransitive (FreeGroup (Fin 2)) (edgeFunctor.obj Γ).V := by
  have hρ : Γ.edgeEquiv.permCongrHom.toMonoidHom.comp
      (MulAction.toPermHom (FreeGroup (Fin 2)) (edgeFunctor.obj Γ).V) = edgeRepresentation Γ := by
    refine MonoidHom.ext fun g ↦ Equiv.ext fun x ↦ ?_
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Equiv.permCongrHom_coe,
      Equiv.permCongr_apply, Action.toPermHom_apply_eq_ρ]
    exact edgeEquiv_edgeFunctor_obj_ρ_apply Γ g x
  have hr : (edgeRepresentation Γ).range = Γ.rotationGroup := by
    rw [edgeRepresentation, FreeGroup.range_lift_eq_closure, Matrix.range_cons_cons_empty,
      Γ.closure_pair_eq_rotationGroup]
  have h := Γ.edgeEquiv.isPretransitive_map_permCongrHom_iff
    (MulAction.toPermHom (FreeGroup (Fin 2)) (edgeFunctor.obj Γ).V).range
  rw [← MonoidHom.range_comp, hρ, hr, MulAction.isPretransitive_range_toPermHom_iff] at h
  exact Γ.isConnected_def.trans (and_congr Γ.edgeEquiv.symm.nonempty_congr h)

end TauCeti.BipartiteRibbonGraph
