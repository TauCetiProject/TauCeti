module

public import TauCeti.Algebra.Order.BigOperators.Sum.Min
public import TauCeti.Combinatorics.Enumerative.Partition.Conjugate
public import Mathlib.Data.Multiset.Fintype
public import Mathlib.Logic.Relation

/-!
# Dominance of partitions is generated by moving single boxes

Moving the last box of a row of a Young diagram to the end of a weakly longer row produces a
partition that dominates the original one. Conversely, every dominance relation between two
partitions of `n` is obtained by a finite sequence of such moves. This is the integer form of
Muirhead's lemma on majorization; the moves include the covering relations of the dominance
order described by Brylawski.

The comparison is made through the column counts `∑ᵢ min k λᵢ` of a partition `λ`, the number
of boxes in its first `k` columns (`Nat.Partition.dominates_iff_forall_sum_map_min_le`). Moving
a box from a row of length `b + 1` to a row of length `a ≥ b + 1` lowers the column count by one
exactly for `b < k ≤ a`. The key step, `Finset.exists_ne_forall_sum_min_lt` (in
`TauCeti.Algebra.Order.BigOperators.Sum.Min`), finds such a move in the presence of a strict
inequality of column counts, and is stated for arbitrary finite families of lengths. For the
Jordan-chain lengths of a nilpotent endomorphism, the column count is the dimension of the kernel
of the `k`-th power, so this step reduces the converse of the rank criterion for nilpotent orbit
closures (Gerstenhaber's theorem) to single box moves.

## Main definitions and results

* `Nat.Partition.IsBoxMove ν μ`: `μ` is obtained from `ν` by moving one box from a row to a
  weakly longer row.
* `Nat.Partition.sum_map_min_add_of_parts_add_eq`: the exact effect of a box move on the column
  counts.
* `Nat.Partition.IsBoxMove.strictlyDominates`: a box move produces a strictly dominating
  partition.
* `Nat.Partition.dominates_iff_reflTransGen_isBoxMove` and
  `Nat.Partition.strictlyDominates_iff_transGen_isBoxMove`: dominance is the reflexive
  transitive closure of box moves, and strict dominance its transitive closure.

## References

* R. F. Muirhead, *Some methods applicable to identities and inequalities of symmetric
  algebraic functions of n letters*, Proc. Edinburgh Math. Soc. **21** (1903), 144–157.
* T. Brylawski, *The lattice of integer partitions*, Discrete Math. **6** (1973), 201–219.
* I. G. Macdonald, *Symmetric Functions and Hall Polynomials*, 2nd ed., Oxford, 1995, I.1.16.
* M. Gerstenhaber, *On dominance and varieties of commuting matrices*, Ann. of Math. **73**
  (1961), 324–348.
-/

public section

namespace Nat.Partition

variable {n : ℕ}

/-- `ν.IsBoxMove μ` says that `μ` is obtained from `ν` by moving one box from a row to a weakly
longer row: two parts `a` and `b + 1` of `ν` with `b < a` are replaced by `a + 1` and `b`, the
part `b` being dropped when it is zero. -/
def IsBoxMove (ν μ : n.Partition) : Prop :=
  ∃ a b, b < a ∧ μ.parts + {a, b + 1} = ν.parts + ({a + 1, b} : Multiset ℕ).filter (· ≠ 0)

/-- The defining description of a box move. -/
theorem isBoxMove_iff {ν μ : n.Partition} :
    ν.IsBoxMove μ ↔
      ∃ a b, b < a ∧ μ.parts + {a, b + 1} = ν.parts + ({a + 1, b} : Multiset ℕ).filter (· ≠ 0) :=
  Iff.rfl

/-- Moving a box from a row of length `b + 1` to a row of length `a` lowers the number of boxes in
the first `k` columns by one for `b < k ≤ a`, and leaves it unchanged otherwise. -/
theorem sum_map_min_add_of_parts_add_eq {ν μ : n.Partition} {a b : ℕ} (hba : b < a)
    (h : μ.parts + {a, b + 1} = ν.parts + ({a + 1, b} : Multiset ℕ).filter (· ≠ 0)) (k : ℕ) :
    (μ.parts.map (min k)).sum + (if b < k ∧ k ≤ a then 1 else 0) =
      (ν.parts.map (min k)).sum := by
  have hsum := congrArg (fun m : Multiset ℕ => (m.map (min k)).sum) h
  have hfilter : ((({a + 1, b} : Multiset ℕ).filter (· ≠ 0)).map (min k)).sum =
      min k (a + 1) + min k b := by
    rcases Nat.eq_zero_or_pos b with rfl | hb
    · simp [Multiset.filter_singleton]
    · simp [Multiset.filter_singleton, hb.ne']
  simp only [Multiset.map_add, Multiset.sum_add, hfilter] at hsum
  simp only [Multiset.insert_eq_cons, Multiset.map_cons, Multiset.map_singleton,
    Multiset.sum_cons, Multiset.sum_singleton] at hsum
  split_ifs <;> omega

/-- A box move produces a strictly dominating partition. -/
theorem IsBoxMove.strictlyDominates {ν μ : n.Partition} (h : ν.IsBoxMove μ) :
    μ.StrictlyDominates ν := by
  obtain ⟨a, b, hba, heq⟩ := h
  have hcol := sum_map_min_add_of_parts_add_eq hba heq
  refine strictlyDominates_iff.mpr ⟨dominates_iff_forall_sum_map_min_le.mpr fun k => ?_, ?_⟩
  · have := hcol k
    omega
  · rintro rfl
    have := hcol a
    simp [hba] at this

/-- A box move produces a dominating partition. -/
theorem IsBoxMove.dominates {ν μ : n.Partition} (h : ν.IsBoxMove μ) : μ.Dominates ν :=
  (strictlyDominates_iff.mp h.strictlyDominates).1

/-- If `μ` strictly dominates `ν`, then some box move of `ν` is still dominated by `μ`. -/
theorem StrictlyDominates.exists_isBoxMove {μ ν : n.Partition} (h : μ.StrictlyDominates ν) :
    ∃ ξ, ν.IsBoxMove ξ ∧ μ.Dominates ξ := by
  classical
  obtain ⟨hdom, hne⟩ := strictlyDominates_iff.mp h
  have hle := dominates_iff_forall_sum_map_min_le.mp hdom
  -- Index the parts of `ν` and `μ` by `Multiset.toEnumFinset` to apply the family statement.
  have hmin (ξ : n.Partition) (k : ℕ) :
      (ξ.parts.map (min k)).sum = ∑ x ∈ ξ.parts.toEnumFinset, min k x.1 :=
    Multiset.sum_map_eq_sum_toEnumFinset _ _
  have hlt : ∃ k, (μ.parts.map (min k)).sum < (ν.parts.map (min k)).sum := by
    by_contra! hge
    exact hne (hdom.antisymm (dominates_iff_forall_sum_map_min_le.mpr hge))
  obtain ⟨x, hx, y, hy, hxy, hyx, hint⟩ :=
    Finset.exists_ne_forall_sum_min_lt (s := ν.parts.toEnumFinset) (t := μ.parts.toEnumFinset)
      (a := Prod.fst) (b := Prod.fst)
      (by rw [← Multiset.sum_eq_sum_toEnumFinset, ← Multiset.sum_eq_sum_toEnumFinset,
        μ.parts_sum, ν.parts_sum])
      (fun k => by simpa only [hmin] using hle k)
      (by simpa only [hmin] using hlt)
  simp only [← hmin] at hint
  -- The two chosen parts `x.1 = a` and `y.1 = b + 1` of `ν`.
  obtain ⟨b, hb⟩ : ∃ b, y.1 = b + 1 :=
    Nat.exists_eq_add_one.mpr (ν.parts_pos (Multiset.mem_of_mem_toEnumFinset hy))
  obtain ⟨a, ha⟩ : ∃ a, x.1 = a := ⟨_, rfl⟩
  rw [ha] at hyx hint
  have hpair : ({a, b + 1} : Multiset ℕ) ≤ ν.parts := by
    have := Multiset.map_fst_le_of_subset_toEnumFinset (m := ν.parts) (s := {x, y})
      (Finset.insert_subset hx (Finset.singleton_subset_iff.mpr hy))
    rwa [Finset.insert_val_of_notMem (by simpa using hxy), Multiset.map_cons,
      Finset.singleton_val, Multiset.map_singleton, ha, hb, ← Multiset.insert_eq_cons] at this
  have hsum : (ν.parts - {a, b + 1} + {a + 1, b}).sum = n := by
    have hsplit := congrArg Multiset.sum (tsub_add_cancel_of_le hpair)
    simp only [Multiset.sum_add, Multiset.insert_eq_cons, Multiset.sum_cons,
      Multiset.sum_singleton, ν.parts_sum] at hsplit ⊢
    omega
  let ξ : n.Partition := ofSums n (ν.parts - {a, b + 1} + {a + 1, b}) hsum
  have hmove : ξ.parts + {a, b + 1} = ν.parts + ({a + 1, b} : Multiset ℕ).filter (· ≠ 0) := by
    have hpos : (ν.parts - {a, b + 1}).filter (· ≠ 0) = ν.parts - {a, b + 1} :=
      Multiset.filter_eq_self.mpr fun i hi =>
        (ν.parts_pos (Multiset.mem_of_le (Multiset.sub_le_self _ _) hi)).ne'
    -- `ξ.parts` unfolds to the defining multiset of `ofSums` with its zero parts filtered out.
    change (ν.parts - {a, b + 1} + {a + 1, b}).filter (· ≠ 0) + {a, b + 1} = _
    rw [Multiset.filter_add, hpos, add_right_comm, tsub_add_cancel_of_le hpair]
  have hba : b < a := by omega
  refine ⟨ξ, ⟨a, b, hba, hmove⟩, dominates_iff_forall_sum_map_min_le.mpr fun k => ?_⟩
  have hcol := sum_map_min_add_of_parts_add_eq hba hmove k
  split_ifs at hcol with hk
  · have := hint k (by omega) hk.2
    omega
  · exact (hle k).trans_eq hcol.symm

/-- **Dominance is generated by box moves.** A partition `μ` dominates `ν` exactly when `μ` is
obtained from `ν` by a finite sequence of box moves. -/
theorem dominates_iff_reflTransGen_isBoxMove {μ ν : n.Partition} :
    μ.Dominates ν ↔ Relation.ReflTransGen IsBoxMove ν μ := by
  refine ⟨fun h => ?_, fun h => ?_⟩
  · -- Induct on `ν`, ordered by strict dominance, which is well founded on the finite type.
    induction ν using (Finite.wellFounded_of_trans_of_irrefl
      (StrictlyDominates (n := n))).induction with
    | _ ν ih =>
      by_cases hνμ : ν = μ
      · subst hνμ
        exact Relation.ReflTransGen.refl
      · obtain ⟨ξ, hmove, hξ⟩ := (strictlyDominates_iff.mpr ⟨h, Ne.symm hνμ⟩).exists_isBoxMove
        exact Relation.ReflTransGen.head hmove (ih ξ hmove.strictlyDominates hξ)
  · induction h with
    | refl => exact dominates_refl ν
    | tail _ hmove ih => exact hmove.dominates.trans ih

/-- **Strict dominance is generated by box moves.** A partition `μ` strictly dominates `ν` exactly
when `μ` is obtained from `ν` by a nonempty finite sequence of box moves. -/
theorem strictlyDominates_iff_transGen_isBoxMove {μ ν : n.Partition} :
    μ.StrictlyDominates ν ↔ Relation.TransGen IsBoxMove ν μ := by
  rw [Relation.TransGen.head'_iff]
  refine ⟨fun h => ?_, fun ⟨ξ, hmove, hξ⟩ => ?_⟩
  · obtain ⟨ξ, hmove, hξ⟩ := h.exists_isBoxMove
    exact ⟨ξ, hmove, dominates_iff_reflTransGen_isBoxMove.mp hξ⟩
  · have hμξ := dominates_iff_reflTransGen_isBoxMove.mpr hξ
    obtain ⟨hξν, hne⟩ := strictlyDominates_iff.mp hmove.strictlyDominates
    refine strictlyDominates_iff.mpr ⟨hμξ.trans hξν, ?_⟩
    rintro rfl
    exact hne (hξν.antisymm hμξ)

end Nat.Partition
