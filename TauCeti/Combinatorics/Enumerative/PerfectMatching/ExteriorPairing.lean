module

public import TauCeti.Combinatorics.Enumerative.PerfectMatching
public import TauCeti.GroupTheory.Perm.SumCongr

/-!
# The exterior pairing of a set of endpoints

Let `M` be a perfect matching of `β ⊕ γ` and `X` a perfect matching of `β`. Read the pairs of `M`
and of `X` as the edges of a graph: a point of `β` meets one edge of each kind, a point of `γ`
only an edge of `M`. Its components are circles inside `β` and paths whose two ends lie in `γ`,
so the paths pair off the points of `γ`: this is the *exterior pairing* `π`. Closing the graph
by a pairing `μ` of `γ` turns it into a union of circles, the classes of the equivalence relation
generated by `Equiv.Perm.sumCongr X μ` and `M`, each counted twice by the orbits of their product.
The circles inside `β` do not depend on `μ`, and the paths close up as the circles of `μ * π`.

`TauCeti.PerfectMatching.exists_orbitCount_sumCongr_mul_add` states this without following paths:
there are a pairing `π` of `γ` and a number `r` such that
`orbitCount (Perm.sumCongr X μ * M) + 2 r = |β| + orbitCount (μ * π)` for every permutation `μ` of
`γ`. The proof cuts off the arcs of `X` one at a time
(`TauCeti.PerfectMatching.orbitCount_mul_reconnect`): reconnecting `M` so that it joins the two
ends of an arc of `X` adds a two-point circle, whatever `μ` is. Once every arc of `X` is an arc of
`M`, the matching `M` is `Equiv.Perm.sumCongr X π`.

For four endpoints, closing by `μ` gives one more circle when `μ` is the exterior pairing than
otherwise (`TauCeti.IsPerfectMatching.orbitCount_mul_fin_four`). This is how the circles or
components through a crossing of a diagram change when the crossing is replaced by one of the
three pairings of its four slots.
-/

public section

namespace TauCeti.PerfectMatching

open Equiv Equiv.Perm Finset

variable {β γ : Type*}

/-- **The exterior pairing.** For perfect matchings `M` of `β ⊕ γ` and `X` of `β`, there are a
perfect matching `π` of `γ` and a number `r` such that closing `M` and `X` by any permutation `μ`
of `γ` has, up to the constant `|β| - 2 r`, as many orbits as `μ * π`: the paths formed by the
arcs of `M` and `X` join the points of `γ` in pairs, according to `π`, and the circles avoiding
`γ` do not depend on `μ`. -/
theorem exists_orbitCount_sumCongr_mul_add [Finite β] [Finite γ] (M : PerfectMatching (β ⊕ γ))
    {X : Perm β} (hX : IsPerfectMatching X) :
    ∃ (π : PerfectMatching γ) (r : ℕ), ∀ μ : Perm γ,
      orbitCount (Perm.sumCongr X μ * M.val) + 2 * r = Nat.card β + orbitCount (μ * π.val) := by
  classical
  cases nonempty_fintype β
  -- Induct on the number of arcs of `X` that are not arcs of `M`, counted by their points.
  induction hk : #{b | M.val (.inl b) ≠ .inl (X b)} using Nat.strong_induction_on
    generalizing M with
  | _ k ih =>
  by_cases hbad : ∃ b, M.val (.inl b) ≠ .inl (X b)
  · obtain ⟨b, hb⟩ := hbad
    -- Cut off the arc of `X` at `b`: the reconnected matching contains it, and every arc of `X`
    -- that `M` already contained.
    set M' := M.reconnect (.inl b) (.inl (X b))
    have hXb : (Sum.inl (X b) : β ⊕ γ) ≠ .inl b := by simpa using hX.apply_ne b
    have hgood (x : β) (hx : M.val (.inl x) = .inl (X x)) : M'.val (.inl x) = .inl (X x) := by
      have hxb : x ≠ b := by rintro rfl; exact hb hx
      have hxXb : x ≠ X b := by
        rintro rfl
        exact hb (M.apply_eq_of_apply_eq (by rw [hx, hX.apply_apply]))
      exact reconnect_val_of_val_eq hx (by simpa using hxb) (by simpa using hxXb)
        (by simpa using fun h ↦ hxXb (by rw [← h, hX.apply_apply]))
        (by simpa using fun h ↦ hxb (X.injective h))
    have hlt : #{b | M'.val (.inl b) ≠ .inl (X b)} < k := by
      rw [← hk]
      refine card_lt_card (ssubset_iff_of_subset ?_ |>.2 ⟨b, by simpa using hb, ?_⟩)
      · intro x hx
        simp only [mem_filter, mem_univ, true_and] at hx ⊢
        exact fun h ↦ hx (hgood x h)
      · simpa using reconnect_val_self hXb
    obtain ⟨π, r, h⟩ := ih _ hlt M' rfl
    refine ⟨π, r + 1, fun μ ↦ ?_⟩
    have hcut := M.orbitCount_mul_reconnect (T := Perm.sumCongr X μ) (a := .inl b)
      (by simp [hX.apply_apply]) (by simpa using hX.apply_ne b) (by simpa using hb)
    rw [Perm.sumCongr_apply, Sum.map_inl] at hcut
    rw [← h μ, hcut]
    ring
  · -- Every arc of `X` is an arc of `M`, so `M` is `X` together with a pairing of `γ`.
    simp only [not_exists, not_not] at hbad
    obtain ⟨π, hπ⟩ := exists_val_eq_sumCongr M hbad
    refine ⟨π, 0, fun μ ↦ ?_⟩
    have hXX : X * X = 1 := Equiv.ext hX.apply_apply
    rw [hπ, Perm.sumCongr_mul, hXX, orbitCount_sumCongr, orbitCount_one]
    ring

end TauCeti.PerfectMatching
