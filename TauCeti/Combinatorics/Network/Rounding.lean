module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas
public import Mathlib.Algebra.Order.Archimedean.Real.Basic
public import Mathlib.Algebra.Order.Floor.Ring
public import Mathlib.Data.Rat.Floor
public import TauCeti.Combinatorics.Network.Hoffman

/-!
# Rounding assignments with integral excess

An assignment on a finite directed multigraph whose excesses are integers can be rounded
arrowwise to integers without changing any excess.  Each rounded value lies between the floor
and ceiling of the original value.  Consequently, integer lower and upper bounds, circulations,
and flows of prescribed integer value are preserved.

The existence proof applies the additive-subgroup integrality part of Hoffman's feasibility
theorem to the floor and ceiling bounds.  The original assignment witnesses feasibility over the
ambient ordered ring, and the integral witness is then recovered from the subgroup generated by
one.

## References

* D. P. Bertsekas, *Linear Network Optimization*, Section 1.1.3 and Exercises 2.4--2.6.
-/

public section

namespace TauCeti

universe u v w

variable {V : Type u} {Q : V → V → Type v} {R : Type w}
variable [Fintype V] [∀ x y, Fintype (Q x y)]
variable [Ring R] [LinearOrder R] [IsOrderedAddMonoid R] [FloorRing R]

/-- An assignment with integer excesses has an integer rounding with the same excesses, bounded
on each arrow by the floor and ceiling of its original value. -/
theorem exists_integerRounding (f : Assignment Q R) (b : V → ℤ)
    (hb : ∀ x, excessAt f x = (b x : R)) :
    ∃ g : Assignment Q ℤ, (∀ x, excessAt g x = b x) ∧
      ∀ ⦃x y⦄ (e : Q x y), ⌊f e⌋ ≤ g e ∧ g e ≤ ⌈f e⌉ := by
  classical
  let lo : Assignment Q R := fun _ _ e ↦ (⌊f e⌋ : R)
  let hi : Assignment Q R := fun _ _ e ↦ (⌈f e⌉ : R)
  let bR : V → R := fun x ↦ b x
  have hlo : lo ≤ hi := fun _ _ e ↦ by
    simpa only [lo, hi, Int.cast_le] using Int.floor_le_ceil (f e)
  have hf : ExcessFlow lo hi bR := ⟨f, ⟨fun _ _ e ↦ Int.floor_le (f e),
    fun _ _ e ↦ Int.le_ceil (f e)⟩, funext hb⟩
  have hlo_mem : ∀ ⦃x y⦄ (e : Q x y), lo e ∈ AddSubgroup.zmultiples (1 : R) :=
    fun _ _ e ↦ by simpa only [lo] using AddSubgroup.intCast_mem_zmultiples_one (R := R) ⌊f e⌋
  have hhi_mem : ∀ ⦃x y⦄ (e : Q x y), hi e ∈ AddSubgroup.zmultiples (1 : R) :=
    fun _ _ e ↦ by simpa only [hi] using AddSubgroup.intCast_mem_zmultiples_one (R := R) ⌈f e⌉
  have hb_mem : ∀ x, bR x ∈ AddSubgroup.zmultiples (1 : R) :=
    fun x ↦ AddSubgroup.intCast_mem_zmultiples_one (R := R) (b x)
  obtain ⟨h, hh⟩ := (ExcessFlow.exists_mem_iff hlo (AddSubgroup.zmultiples (1 : R))
    hlo_mem hhi_mem hb_mem).2 ((ExcessFlow.nonempty_iff hlo).1 ⟨hf⟩)
  let g : Assignment Q ℤ := fun _ _ e ↦ ⌊h.val e⌋
  have hcast : ∀ ⦃x y⦄ (e : Q x y), (g e : R) = h.val e := fun _ _ e ↦ by
    apply (Int.floor_eq_self_iff_mem (h.val e)).2
    obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp (hh e)
    exact ⟨n, by simpa using hn⟩
  refine ⟨g, ?_, fun x y e ↦ ?_⟩
  · intro x
    apply Int.cast_injective (α := R)
    have hmap : g.map (Int.castAddHom R) = h.val := by
      funext a c e
      exact hcast e
    calc
      ((excessAt g x : ℤ) : R) = excessAt (g.map (Int.castAddHom R)) x := by
        simpa using map_excessAt (Int.castAddHom R) g x
      _ = excessAt h.val x := by rw [hmap]
      _ = (b x : R) := by rw [h.excessAt_eq]
  · constructor
    · apply (FloorRing.intCast_le_iff (α := R)).mp
      rw [hcast e]
      exact h.mem_Icc.1 x y e
    · apply (FloorRing.intCast_le_iff (α := R)).mp
      rw [hcast e]
      exact h.mem_Icc.2 x y e

/-- Integer lower and upper bounds respected by an assignment are also respected by an integer
rounding with the same prescribed integer excess. -/
theorem exists_integerRounding_mem_Icc (lo hi : Assignment Q ℤ) (f : Assignment Q R)
    (b : V → ℤ) (hf : f ∈ Set.Icc (lo.map (Int.castAddHom R)) (hi.map (Int.castAddHom R)))
    (hb : ∀ x, excessAt f x = (b x : R)) :
    ∃ g : Assignment Q ℤ, g ∈ Set.Icc lo hi ∧ ∀ x, excessAt g x = b x := by
  obtain ⟨g, hgex, hg⟩ := exists_integerRounding f b hb
  refine ⟨g, ⟨fun x y e ↦ ?_, fun x y e ↦ ?_⟩, hgex⟩
  · exact (Int.le_floor.mpr (by simpa using hf.1 x y e)).trans (hg e).1
  · exact (hg e).2.trans (Int.ceil_le.mpr (by simpa using hf.2 x y e))

/-- A circulation over the ambient ordered ring can be rounded arrowwise to an integer
circulation between its floor and ceiling. -/
theorem exists_integerRounding_isCirculation (f : Assignment Q R) (hf : IsCirculation f) :
    ∃ g : Assignment Q ℤ, IsCirculation g ∧
      ∀ ⦃x y⦄ (e : Q x y), ⌊f e⌋ ≤ g e ∧ g e ≤ ⌈f e⌉ := by
  obtain ⟨g, hgex, hg⟩ := exists_integerRounding f 0 fun x ↦ by
    rw [(isCirculation_iff f).1 hf x]
    simp
  exact ⟨g, (isCirculation_iff g).2 hgex, hg⟩

/-- A flow between integer capacities and of prescribed integer value has an integer-valued flow
of the same value. -/
theorem Flow.exists_integerRounding {cap : Assignment Q ℤ} {s t : V}
    (f : Flow (cap.map (Int.castAddHom R)) s t) (q : ℤ) (hq : f.val = (q : R)) :
    ∃ g : Flow cap s t, g.val = q := by
  classical
  let b : V → ℤ := fun x ↦ if x = s then -q else if x = t then q else 0
  have hb : ∀ x, excessAt f.toFun x = (b x : R) := by
    intro x
    by_cases hxs : x = s
    · subst x
      rw [f.excessAt_source, hq]
      simp [b]
    · by_cases hxt : x = t
      · subst x
        rw [← BoundedFlow.val_def, hq]
        simp [b, hxs]
      · rw [f.conserve x hxs hxt]
        simp [b, hxs, hxt]
  obtain ⟨g, hgmem, hgex⟩ := exists_integerRounding_mem_Icc 0 cap f.toFun b
    (by simpa only [Assignment.map_zero] using f.mem_Icc) hb
  have hqnonneg : 0 ≤ q := by
    have hnonneg : (0 : R) ≤ f.val := by
      rw [BoundedFlow.val_def]
      exact f.excessAt_sink_nonneg
    rw [hq] at hnonneg
    exact_mod_cast hnonneg
  have hqzero (hst : s = t) : q = 0 := by
    apply Int.cast_injective (α := R)
    rw [Int.cast_zero, ← hq, f.val_eq_zero_of_eq hst]
  have hbt : b t = q := by
    by_cases hts : t = s
    · simp [b, hts, hqzero hts.symm]
    · simp [b, hts]
  let F : Flow cap s t :=
    { toFun := g
      mem_Icc := hgmem
      conserve := fun x hxs hxt ↦ by simp [hgex x, b, hxs, hxt]
      excessAt_sink_nonneg := by rw [hgex t, hbt]; exact hqnonneg }
  exact ⟨F, by simp [BoundedFlow.val_def, F, hgex t, hbt]⟩

/-- Rational assignments with integer excess admit integer roundings. -/
theorem exists_integerRounding_rat (f : Assignment Q ℚ) (b : V → ℤ)
    (hb : ∀ x, excessAt f x = (b x : ℚ)) :
    ∃ g : Assignment Q ℤ, (∀ x, excessAt g x = b x) ∧
      ∀ ⦃x y⦄ (e : Q x y), ⌊f e⌋ ≤ g e ∧ g e ≤ ⌈f e⌉ :=
  exists_integerRounding f b hb

/-- Real assignments with integer excess admit integer roundings. -/
theorem exists_integerRounding_real (f : Assignment Q ℝ) (b : V → ℤ)
    (hb : ∀ x, excessAt f x = (b x : ℝ)) :
    ∃ g : Assignment Q ℤ, (∀ x, excessAt g x = b x) ∧
      ∀ ⦃x y⦄ (e : Q x y), ⌊f e⌋ ≤ g e ∧ g e ≤ ⌈f e⌉ :=
  exists_integerRounding f b hb

/-! ### Fractional circulation examples -/

-- Opposite half-unit arrows form a rational circulation. Its integer rounding stays between
-- zero and one on both nonloop arrows and is zero on the loops.
example :
    let Q : Bool → Bool → Type := fun _ _ ↦ Unit
    let f : Assignment Q ℚ := fun x y _ ↦ if x = y then 0 else 1 / 2
    ∃ g : Assignment Q ℤ, IsCirculation g ∧
      ∀ ⦃x y⦄ (e : Q x y), ⌊@f x y e⌋ ≤ @g x y e ∧ @g x y e ≤ ⌈@f x y e⌉ := by
  dsimp only
  apply exists_integerRounding_isCirculation
  rw [isCirculation_iff]
  intro x
  cases x <;> norm_num [excessAt_def, Fintype.sum_bool]

-- The same two-arrow circulation over the reals exercises the real specialization and its
-- explicit floor and ceiling bounds.
example :
    let Q : Bool → Bool → Type := fun _ _ ↦ Unit
    let f : Assignment Q ℝ := fun x y _ ↦ if x = y then 0 else 1 / 2
    ∃ g : Assignment Q ℤ, IsCirculation g ∧
      ∀ ⦃x y⦄ (e : Q x y), ⌊@f x y e⌋ ≤ @g x y e ∧ @g x y e ≤ ⌈@f x y e⌉ := by
  dsimp only
  apply exists_integerRounding_isCirculation
  rw [isCirculation_iff]
  intro x
  cases x <;> norm_num [excessAt_def, Fintype.sum_bool]

end TauCeti
