/-!
# Termination of augmentation for capacities in a cyclic subgroup

An *augmentation step* `TauCeti.Flow.AugmentationStep` takes an ordinary `s`–`t` flow `f` to the
flow obtained by augmenting `f` along a path from `s` to `t` in its residual network, all of whose
arrows have positive residual capacity, by the bottleneck of that path. A flow between distinct
terminals is maximum exactly when it admits no augmentation step, and augmentation steps preserve
arrow values in any additive subgroup of the coefficients that contains the capacities.

For capacities in the cyclic subgroup `AddSubgroup.zmultiples d` generated by some `d > 0`, this
forces termination. The capacity leaving the source is a natural multiple `m • d`, and the value
of a flow with arrow values in the subgroup is a multiple `n • d` with `n ≤ m`. An augmentation
step from such a flow raises the value by at least `d` and stays in the subgroup, so every
sequence of augmentation steps starting from such a flow is finite, whichever augmenting paths
are chosen. Starting from the zero flow, it ends at a maximum flow with arrow values in the
subgroup. No Archimedean hypothesis on the coefficients is needed.

Every flow over `ℤ` has arrow values in `AddSubgroup.zmultiples 1`, and finitely many rationals
lie in `AddSubgroup.zmultiples (1 / D)` for a common denominator `D`, so over `ℤ` and over `ℚ`
every sequence of augmentation steps terminates and maximum flows exist. For capacities outside a
cyclic subgroup augmentation sequences need not terminate.

## Main results

* `TauCeti.Flow.AugmentationStep.val_add_le`: for capacities and arrow values in
  `AddSubgroup.zmultiples d`, an augmentation step raises the value by at least `d`.
* `TauCeti.Flow.exists_val_eq_nsmul`: the value of a flow with arrow values in
  `AddSubgroup.zmultiples d` is `n • d` for some `n` at most the multiple `m` with
  `m • d` the capacity leaving the source.
* `TauCeti.Flow.acc_augmentationStep`: every sequence of augmentation steps from a flow with arrow
  values in `AddSubgroup.zmultiples d` terminates.
* `TauCeti.Flow.exists_isMaximum_mem_zmultiples`: there is a maximum flow with arrow values in
  `AddSubgroup.zmultiples d`.
* `TauCeti.Flow.acc_augmentationStep_int`, `TauCeti.Flow.acc_augmentationStep_rat`,
  `TauCeti.Flow.exists_isMaximum_int` and `TauCeti.Flow.exists_isMaximum_rat`: termination and
  existence of maximum flows over `ℤ` and over `ℚ`.

## References

* L. R. Ford, D. R. Fulkerson, *Maximal flow through a network*, Canadian J. Math. 8 (1956).
* R. K. Ahuja, T. L. Magnanti, J. B. Orlin, *Network Flows: Theory, Algorithms, and
  Applications*, Prentice Hall, 1993 (the labeling algorithm and its termination).
-/

public section

namespace TauCeti

open Finset

universe u v w

variable {V : Type u} {Q : V → V → Type v} {K : Type w}

variable [Fintype V] [∀ v w, Fintype (Q v w)]

section LinearOrder

variable [AddCommGroup K] [LinearOrder K] [IsOrderedAddMonoid K]

omit [Fintype V] in
/-- For nonnegative capacities in `AddSubgroup.zmultiples d` with `d > 0`, the total capacity of
the arrows from `S` to `T` is a natural multiple of `d`. -/
theorem exists_arrowSum_eq_nsmul {cap : Assignment Q K} {d : K} (hd : 0 < d)
    (hcap : ∀ ⦃x y⦄ (e : Q x y), cap e ∈ AddSubgroup.zmultiples d) (hcap₀ : 0 ≤ cap)
    (S T : Finset V) : ∃ m : ℕ, arrowSum cap S T = m • d :=
  (exists_nsmul_eq_of_mem_zmultiples hd (arrowSum_mem hcap S T)
    (by simpa using arrowSum_mono hcap₀ S T)).imp fun _ h ↦ h.symm

namespace Flow

variable {cap : Assignment Q K} {s t : V} {f g : Flow cap s t} {d : K}

/-- For capacities in `AddSubgroup.zmultiples d` with `d > 0`, an augmentation step from a flow
with arrow values in that subgroup raises the value by at least `d`. -/
theorem AugmentationStep.val_add_le (hst : s ≠ t) (hd : 0 < d)
    (hcap : ∀ ⦃x y⦄ (e : Q x y), cap e ∈ AddSubgroup.zmultiples d)
    (hf : ∀ ⦃x y⦄ (e : Q x y), f.toFun e ∈ AddSubgroup.zmultiples d)
    (h : AugmentationStep f g) : f.val + d ≤ g.val := by
  have hmem : g.val - f.val ∈ AddSubgroup.zmultiples d :=
    sub_mem (g.val_mem fun _ _ ↦ h.toFun_mem _ hcap hf) (f.val_mem hf)
  have := le_of_mem_zmultiples hd hmem (sub_pos.2 (h.val_lt hst))
  rwa [le_sub_iff_add_le'] at this

/-- If the capacity leaving the source is `m • d` with `d > 0`, then the value of a flow with
arrow values in `AddSubgroup.zmultiples d` is `n • d` for some `n ≤ m`. -/
theorem exists_val_eq_nsmul [DecidableEq V] (hst : s ≠ t) (hd : 0 < d) {m : ℕ}
    (hm : arrowSum cap {s} {s}ᶜ = m • d)
    (hf : ∀ ⦃x y⦄ (e : Q x y), f.toFun e ∈ AddSubgroup.zmultiples d) :
    ∃ n ≤ m, f.val = n • d := by
  obtain ⟨n, hn⟩ := exists_nsmul_eq_of_mem_zmultiples hd (f.val_mem hf) f.val_nonneg
  have hle : n • d ≤ m • d := by
    rw [hn, ← hm]
    exact f.val_le_arrowSum (mem_singleton_self s) (by simpa using hst.symm)
  exact ⟨n, (nsmul_le_nsmul_iff_left hd).1 hle, hn.symm⟩

/-- For capacities in `AddSubgroup.zmultiples d` with `d > 0`, the relation "`g` has larger value
than `f`" is well-founded on the flows with arrow values in that subgroup: their values lie in a
finite set. -/
theorem wellFounded_val_gt (hst : s ≠ t) (hd : 0 < d)
    (hcap : ∀ ⦃x y⦄ (e : Q x y), cap e ∈ AddSubgroup.zmultiples d) :
    WellFounded fun g f : {f : Flow cap s t // ∀ ⦃x y⦄ (e : Q x y),
      f.toFun e ∈ AddSubgroup.zmultiples d} ↦ f.1.val < g.1.val := by
  classical
  refine ⟨fun f ↦ ?_⟩
  obtain ⟨m, hm⟩ := exists_arrowSum_eq_nsmul hd hcap
    (fun x y e ↦ (f.1.nonneg e).trans (f.1.le_upper e)) {s} {s}ᶜ
  have hT (g : {f : Flow cap s t // ∀ ⦃x y⦄ (e : Q x y), f.toFun e ∈ AddSubgroup.zmultiples d}) :
      g.1.val ∈ (range (m + 1)).image (· • d) := by
    obtain ⟨n, hn, h⟩ := g.1.exists_val_eq_nsmul hst hd hm g.2
    exact mem_image.2 ⟨n, mem_range.2 (Nat.lt_succ_of_le hn), h.symm⟩
  exact (InvImage.wf (fun g ↦ (⟨g.1.val, hT g⟩ : (range (m + 1)).image (· • d)))
    wellFounded_gt).apply f

/-- **Termination of augmentation.** For capacities in `AddSubgroup.zmultiples d` with `d > 0`,
every sequence of augmentation steps starting from a flow with arrow values in that subgroup is
finite, whichever augmenting paths are chosen. -/
theorem acc_augmentationStep (hst : s ≠ t) (hd : 0 < d)
    (hcap : ∀ ⦃x y⦄ (e : Q x y), cap e ∈ AddSubgroup.zmultiples d)
    (hf : ∀ ⦃x y⦄ (e : Q x y), f.toFun e ∈ AddSubgroup.zmultiples d) :
    Acc (fun g f ↦ AugmentationStep f g) f :=
  (wellFounded_val_gt hst hd hcap).induction (C := fun f ↦ Acc (fun g f ↦ AugmentationStep f g) f.1)
    ⟨f, hf⟩ fun f ih ↦ .intro _ fun g (h : AugmentationStep f.1 g) ↦
      ih ⟨g, fun _ _ ↦ h.toFun_mem _ hcap f.2⟩ (h.val_lt hst)

/-- **Existence of maximum flows for capacities in a cyclic subgroup.** For nonnegative
capacities in `AddSubgroup.zmultiples d` with `d > 0`, there is a maximum flow between distinct
terminals whose arrow values lie in that subgroup. -/
theorem exists_isMaximum_mem_zmultiples (hst : s ≠ t) (hd : 0 < d)
    (hcap : ∀ ⦃x y⦄ (e : Q x y), cap e ∈ AddSubgroup.zmultiples d) (hcap₀ : 0 ≤ cap) :
    ∃ f : Flow cap s t,
      f.IsMaximum ∧ ∀ ⦃x y⦄ (e : Q x y), f.toFun e ∈ AddSubgroup.zmultiples d := by
  obtain ⟨⟨f, hf⟩, -, hmax⟩ := (wellFounded_val_gt hst hd hcap).has_min Set.univ
    ⟨⟨zero hcap₀, fun _ _ _ ↦ by simp⟩, trivial⟩
  exact ⟨f, (isMaximum_iff_forall_not_augmentationStep hst).2 fun g h ↦
    hmax ⟨g, fun _ _ ↦ h.toFun_mem _ hcap hf⟩ trivial (h.val_lt hst), hf⟩

end Flow

end LinearOrder

/-! ### Integer and rational capacities -/

namespace Flow

variable {s t : V}

/-- **Termination of augmentation over `ℤ`.** Every sequence of augmentation steps starting from
an integer flow between distinct terminals is finite. -/
theorem acc_augmentationStep_int {cap : Assignment Q ℤ} (hst : s ≠ t) (f : Flow cap s t) :
    Acc (fun g f ↦ AugmentationStep f g) f :=
  acc_augmentationStep hst one_pos (by simp [Int.zmultiples_one]) (by simp [Int.zmultiples_one])

/-- **Existence of maximum flows over `ℤ`.** For nonnegative integer capacities there is a maximum
flow between distinct terminals. -/
theorem exists_isMaximum_int {cap : Assignment Q ℤ} (hst : s ≠ t) (hcap₀ : 0 ≤ cap) :
    ∃ f : Flow cap s t, f.IsMaximum :=
  (exists_isMaximum_mem_zmultiples hst one_pos (by simp [Int.zmultiples_one]) hcap₀).imp
    fun _ h ↦ h.1

/-- **Termination of augmentation over `ℚ`.** Every sequence of augmentation steps starting from
a rational flow between distinct terminals is finite: the capacities and the arrow values of the
flow lie in the cyclic subgroup generated by the reciprocal of a common denominator. -/
theorem acc_augmentationStep_rat {cap : Assignment Q ℚ} (hst : s ≠ t) (f : Flow cap s t) :
    Acc (fun g f ↦ AugmentationStep f g) f := by
  obtain ⟨D, hD, h⟩ := Rat.exists_forall_mem_zmultiples_inv
    (Sum.elim (fun a : Σ x y, Q x y ↦ cap a.2.2) fun a : Σ x y, Q x y ↦ f.toFun a.2.2)
  exact acc_augmentationStep hst (inv_pos.2 (Nat.cast_pos.2 hD))
    (fun x y e ↦ h (.inl ⟨x, y, e⟩)) fun x y e ↦ h (.inr ⟨x, y, e⟩)

/-- **Existence of maximum flows over `ℚ`.** For nonnegative rational capacities there is a
maximum flow between distinct terminals. -/
theorem exists_isMaximum_rat {cap : Assignment Q ℚ} (hst : s ≠ t) (hcap₀ : 0 ≤ cap) :
    ∃ f : Flow cap s t, f.IsMaximum := by
  obtain ⟨D, hD, h⟩ := Rat.exists_forall_mem_zmultiples_inv fun a : Σ x y, Q x y ↦ cap a.2.2
  exact (exists_isMaximum_mem_zmultiples hst (inv_pos.2 (Nat.cast_pos.2 hD))
    (fun x y e ↦ h ⟨x, y, e⟩) hcap₀).imp fun _ h ↦ h.1

end Flow

end TauCeti
