import Mathlib.Tactic.IntervalCases
import Mathlib.Tactic.Linarith

/-!
# Coboundary constants of the complete complex on four vertices

On `complete (Fin 4)` there are six edges and four triangles, so the cost of a gauge and the
defect of a cochain are explicit finite sums (`TauCeti.Cochain.cost_complete_fin_four`,
`TauCeti.Cochain.defect_complete_fin_four`). With binary coefficients `Equiv.Perm (Fin 2)` and the
moved-point norm, every cochain has a gauge of cost at most half its defect, and the cochain with
a single transposition edge has defect `4` and gauge distance `2`. Hence:

* `TauCeti.h1_complete_fin_four_movedNorm_fin_two`: `h1 (complete (Fin 4)) (movedNorm (Fin 2)) = 2`;
* `TauCeti.h1Sym_complete_fin_four_lt_h1_movedNorm_fin_two`: the same-degree permutation constant
  `h1Sym (complete (Fin 4)) = 4 / 3` lies strictly below this binary constant. So on four
  vertices the comparison `h1Sym X ≤ h1 X (movedNorm (Fin 2))` of Chapman and Lubotzky is strict.

The constant is unchanged by a norm-preserving isomorphism of coefficient groups
(`TauCeti.h1_congr_mulEquiv`) and by positive rescaling of the norm. On a group of order two or
three every group norm is a positive multiple of a moved-point norm, so the constant depends only
on the order of the group:

* `TauCeti.h1_complete_fin_four_of_card_eq_two`: it is `2` for every group of order two, in
  particular for the subgroup `{1, t}` generated by a swap `t`, with the restricted moved-point
  norm (`TauCeti.h1_complete_fin_four_zpowers_of_isSwap`);
* `TauCeti.h1_complete_fin_four_of_card_eq_three`: it is `3 / 2` for every group of order three.
  For the alternating group `A₃ ≤ Perm (Fin 3)` with the restricted moved-point norm
  (`TauCeti.h1_complete_fin_four_alternatingGroup`), every cochain has a gauge of cost at most two
  thirds of its defect, and the cochain carrying a `3`-cycle `c` on `(1, 3)` and `c⁻¹` on `(2, 3)`
  has defect `9` and gauge distance `6`;
* `TauCeti.h1_complete_fin_four_movedNorm_lt_comp_subtype`: hence no subgroup of `Perm (Fin 3)`
  other than `⊥` and `⊤` attains the value `4 / 3` of `Perm (Fin 3)` itself.

## References

* Jeromie Beasley, *The Permutation Coboundary Constant of the Complete Complex Is k/3 for Every
  k≥4*, version 7, Zenodo, doi:10.5281/zenodo.23245792, Proposition 5 (the binary, `Sym(3)` and
  coefficient-subgroup constants on four vertices) and §3.1 (the cyclic-subgroup witness; its
  defect and gauge distance are `9` and `6`, not the printed `6` and `4`, with the same ratio).
* M. Chapman and A. Lubotzky, *Stability of homomorphisms, coverings and cocycles II: examples,
  applications and open problems*, arXiv:2311.06706v3, Adv. Math. 463 (2025), 110117,
  footnote 2 (the comparison with `𝔽₂` coefficients).
-/

public section

open Finset Equiv Equiv.Perm

namespace TauCeti

open TwoComplex

namespace Cochain

variable {G : Type*} [Group G]

/-- On `complete (Fin 4)`, the cost of a gauge is the sum of its six edge terms. -/
theorem cost_complete_fin_four (ℓ : GroupNorm G) (α : Cochain (complete (Fin 4)) G)
    (β : Fin 4 → G) :
    α.cost ℓ β = ℓ ((β 0)⁻¹ * α 0 1 * β 1) + ℓ ((β 0)⁻¹ * α 0 2 * β 2) +
      ℓ ((β 0)⁻¹ * α 0 3 * β 3) + ℓ ((β 1)⁻¹ * α 1 2 * β 2) + ℓ ((β 1)⁻¹ * α 1 3 * β 3) +
      ℓ ((β 2)⁻¹ * α 2 3 * β 3) := by
  rw [cost_complete, sum_filter, Fintype.sum_prod_type]
  simp [Fin.sum_univ_four]
  ring

/-- On `complete (Fin 4)`, the defect of a cochain is the sum of the holonomy norms of its four
triangles. -/
theorem defect_complete_fin_four (ℓ : GroupNorm G) (α : Cochain (complete (Fin 4)) G) :
    α.defect ℓ = ℓ (α.holonomy 0 1 2) + ℓ (α.holonomy 0 1 3) + ℓ (α.holonomy 0 2 3) +
      ℓ (α.holonomy 1 2 3) := by
  rw [defect_complete, sum_filter, Fintype.sum_prod_type]
  simp [Fintype.sum_prod_type, Fin.sum_univ_four]

end Cochain

/-- Every binary cochain on `complete (Fin 4)` has a gauge costing at most half its defect. -/
private theorem Cochain.exists_two_mul_cost_le_defect_fin_four
    (α : Cochain (complete (Fin 4)) (Perm (Fin 2))) :
    ∃ β : Fin 4 → Perm (Fin 2),
      2 * α.cost (movedNorm (Fin 2)) β ≤ α.defect (movedNorm (Fin 2)) := by
  -- the claim only depends on the six edge values `α u v`, `u < v`, so it is a finite check
  have key : ∀ a₀₁ a₀₂ a₀₃ a₁₂ a₁₃ a₂₃ : Perm (Fin 2), ∃ b₀ b₁ b₂ b₃ : Perm (Fin 2),
      2 * (#(b₀⁻¹ * a₀₁ * b₁).support + #(b₀⁻¹ * a₀₂ * b₂).support +
        #(b₀⁻¹ * a₀₃ * b₃).support + #(b₁⁻¹ * a₁₂ * b₂).support + #(b₁⁻¹ * a₁₃ * b₃).support +
        #(b₂⁻¹ * a₂₃ * b₃).support) ≤
      #(a₀₁ * a₁₂ * a₀₂⁻¹).support + #(a₀₁ * a₁₃ * a₀₃⁻¹).support +
        #(a₀₂ * a₂₃ * a₀₃⁻¹).support + #(a₁₂ * a₂₃ * a₁₃⁻¹).support := by
    decide +kernel
  obtain ⟨b₀, b₁, b₂, b₃, h⟩ := key (α 0 1) (α 0 2) (α 0 3) (α 1 2) (α 1 3) (α 2 3)
  refine ⟨![b₀, b₁, b₂, b₃], ?_⟩
  rw [Cochain.cost_complete_fin_four, Cochain.defect_complete_fin_four]
  simp only [Cochain.holonomy_def, α.apply_swap 0 2, α.apply_swap 0 3, α.apply_swap 1 3,
    movedNorm_apply, Matrix.cons_val]
  exact_mod_cast h

/-- The binary cochain on `complete (Fin 4)` carrying the transposition on the edge `(0, 1)`. -/
private noncomputable def oneEdge : Cochain (complete (Fin 4)) (Perm (Fin 2)) :=
  Cochain.singleEdge _ 0 1 (swap 0 1)

private theorem defect_oneEdge : oneEdge.defect (movedNorm (Fin 2)) = 4 := by
  rw [Cochain.defect_complete_fin_four]
  norm_num [oneEdge, Cochain.holonomy_def, movedNorm_apply]

private theorem two_le_cost_oneEdge (β : Fin 4 → Perm (Fin 2)) :
    2 ≤ oneEdge.cost (movedNorm (Fin 2)) β := by
  rw [Cochain.cost_complete_fin_four]
  have key : ∀ b₀ b₁ b₂ b₃ : Perm (Fin 2), 2 ≤ #(b₀⁻¹ * swap 0 1 * b₁).support +
      #(b₀⁻¹ * b₂).support + #(b₀⁻¹ * b₃).support + #(b₁⁻¹ * b₂).support + #(b₁⁻¹ * b₃).support +
      #(b₂⁻¹ * b₃).support := by
    decide
  simpa [oneEdge, movedNorm_apply] using (Nat.cast_le (α := ℝ)).mpr (key (β 0) (β 1) (β 2) (β 3))

/-- The binary coboundary constant of the complete complex on four vertices is `2`, attained by
a single transposition edge, with defect `4` and gauge distance `2`. -/
theorem h1_complete_fin_four_movedNorm_fin_two :
    h1 (complete (Fin 4)) (movedNorm (Fin 2)) = 2 := by
  have hD : (2 : ℝ) ≤ oneEdge.gaugeDist (movedNorm (Fin 2)) :=
    (oneEdge.le_gaugeDist_iff _).mpr two_le_cost_oneEdge
  have hpos : 0 < oneEdge.gaugeDist (movedNorm (Fin 2)) := two_pos.trans_le hD
  refine le_antisymm ((h1_le_div hpos).trans ?_) (le_h1_of_forall ⟨oneEdge, hpos⟩ fun α hα => ?_)
  · rw [defect_oneEdge, div_le_iff₀ hpos]
    linarith
  · obtain ⟨β, hβ⟩ := α.exists_two_mul_cost_le_defect_fin_four
    rw [le_div_iff₀ hα]
    linarith [α.gaugeDist_le_cost (movedNorm (Fin 2)) β]

/-- On four vertices the same-degree permutation constant `h1Sym (complete (Fin 4)) = 4 / 3` lies
strictly below the binary constant `h1 (complete (Fin 4)) (movedNorm (Fin 2)) = 2`. -/
theorem h1Sym_complete_fin_four_lt_h1_movedNorm_fin_two :
    h1Sym (complete (Fin 4)) < h1 (complete (Fin 4)) (movedNorm (Fin 2)) := by
  rw [h1Sym_complete (by simp), h1_complete_fin_four_movedNorm_fin_two]
  norm_num

/-! ### Coefficient groups of order two and three -/

section SmallCoefficients

variable {G : Type*} [Group G]

/-- For every group norm on a group of order two, the coboundary constant of `complete (Fin 4)` is
`2`: the group is isomorphic to `Perm (Fin 2)`, and the norm is a positive multiple of the
moved-point norm. -/
theorem h1_complete_fin_four_of_card_eq_two (hG : Nat.card G = 2) (ℓ : GroupNorm G) :
    h1 (complete (Fin 4)) ℓ = 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let e : G ≃* Perm (Fin 2) :=
    mulEquivOfPrimeCardEq hG (by simp [Nat.card_eq_fintype_card, Fintype.card_perm])
  have hr : 0 < ℓ (e.symm (swap 0 1)) / 2 :=
    div_pos (map_pos_of_ne_one ℓ (by simp [swap_eq_one_iff])) two_pos
  have he : ∀ g, (movedNorm (Fin 2)).smulOfPos hr (e g) = ℓ g := by
    intro g
    obtain h | h : e g = 1 ∨ e g = swap 0 1 := by generalize e g = σ; revert σ; decide
    · simp [e.map_eq_one_iff.mp h]
    · simp [movedNorm_apply, e.eq_symm_apply.mpr h]
  rw [h1_congr_mulEquiv _ e he, h1_smulOfPos, h1_complete_fin_four_movedNorm_fin_two]

/-- On a swap `t`, the subgroup `{1, t}` with the restricted moved-point norm has coboundary
constant `2` on `complete (Fin 4)`. -/
theorem h1_complete_fin_four_zpowers_of_isSwap {α : Type*} [Fintype α] [DecidableEq α]
    {t : Perm α} (ht : t.IsSwap) :
    h1 (complete (Fin 4)) ((movedNorm α).comp (Subgroup.zpowers t).subtype_injective) = 2 :=
  h1_complete_fin_four_of_card_eq_two (by rw [Nat.card_zpowers, ht.orderOf]) _

/-- The `3`-cycle `finRotate 3`, as an element of the alternating group of `Fin 3`. -/
private def rotThree : alternatingGroup (Fin 3) :=
  ⟨finRotate 3, mem_alternatingGroup.mpr (by decide)⟩

private theorem eq_one_or_eq_rotThree_or_eq_inv :
    ∀ σ : alternatingGroup (Fin 3), σ = 1 ∨ σ = rotThree ∨ σ = rotThree⁻¹ := by
  decide

private theorem card_support_rotThree : #(rotThree : Perm (Fin 3)).support = 3 := by decide

private theorem rotThree_inv_mul_inv : rotThree⁻¹ * rotThree⁻¹ = rotThree := by decide

/-- Every `A₃`-valued cochain on `complete (Fin 4)` has a gauge costing at most two thirds of its
defect, for the restricted moved-point norm. -/
private theorem Cochain.exists_three_mul_cost_le_two_mul_defect_alternatingGroup
    (α : Cochain (complete (Fin 4)) (alternatingGroup (Fin 3))) :
    ∃ β : Fin 4 → alternatingGroup (Fin 3),
      3 * α.cost ((movedNorm (Fin 3)).comp (alternatingGroup (Fin 3)).subtype_injective) β ≤
        2 * α.defect ((movedNorm (Fin 3)).comp (alternatingGroup (Fin 3)).subtype_injective) := by
  -- After the star gauge at `0` the edges at `0` carry `1`, so the claim only depends on the
  -- three remaining edge values; it is then a finite check.
  have key : ∀ x y z : alternatingGroup (Fin 3), ∃ b₁ b₂ b₃ : alternatingGroup (Fin 3),
      3 * (#(b₁ : Perm (Fin 3)).support + #(b₂ : Perm (Fin 3)).support +
        #(b₃ : Perm (Fin 3)).support + #((b₁⁻¹ * x * b₂ : alternatingGroup (Fin 3)) :
          Perm (Fin 3)).support +
        #((b₁⁻¹ * y * b₃ : alternatingGroup (Fin 3)) : Perm (Fin 3)).support +
        #((b₂⁻¹ * z * b₃ : alternatingGroup (Fin 3)) : Perm (Fin 3)).support) ≤
      2 * (#(x : Perm (Fin 3)).support + #(y : Perm (Fin 3)).support +
        #(z : Perm (Fin 3)).support +
        #((x * z * y⁻¹ : alternatingGroup (Fin 3)) : Perm (Fin 3)).support) := by
    decide +kernel
  set α' := α.starGauge 0 • α with hα'
  have h0 : ∀ v : Fin 4, v ≠ 0 → α' 0 v = 1 := fun v hv => by
    rw [hα', α.starGauge_smul_apply_of_adj 0 ((adj_complete 0 v).mpr hv.symm)]
    simp
  obtain ⟨b₁, b₂, b₃, h⟩ := key (α' 1 2) (α' 1 3) (α' 2 3)
  refine ⟨α.starGauge 0 * ![1, b₁, b₂, b₃], ?_⟩
  rw [← Cochain.cost_smul, ← Cochain.defect_smul
    (GroupNorm.isConjInvariant_comp isConjInvariant_movedNorm _) α (α.starGauge 0),
    ← hα', Cochain.cost_complete_fin_four, Cochain.defect_complete_fin_four]
  simp only [Cochain.holonomy_def, α'.apply_swap 0 2, α'.apply_swap 0 3, α'.apply_swap 1 3,
    h0 1 (by decide), h0 2 (by decide), h0 3 (by decide), GroupNorm.comp_apply,
    Subgroup.coe_subtype, movedNorm_apply, Matrix.cons_val, inv_one, one_mul, mul_one]
  exact_mod_cast h

/-- The edge values of `rotWitness`: `finRotate 3` on `(1, 3)`, its inverse on `(2, 3)` and `1`
elsewhere. -/
private def rotWitnessFn (u v : Fin 4) : alternatingGroup (Fin 3) :=
  if u = 1 ∧ v = 3 then rotThree else if u = 2 ∧ v = 3 then rotThree⁻¹ else 1

/-- The `A₃`-valued cochain on `complete (Fin 4)` carrying `finRotate 3` on `(1, 3)`, its inverse on
`(2, 3)` and `1` elsewhere. -/
private noncomputable def rotWitness : Cochain (complete (Fin 4)) (alternatingGroup (Fin 3)) :=
  Cochain.ofLt _ rotWitnessFn

private theorem rotWitness_apply {u v : Fin 4} (h : u < v) : rotWitness u v = rotWitnessFn u v :=
  Cochain.ofLt_apply_of_lt _ ((adj_complete u v).mpr h.ne) h

private theorem defect_rotWitness :
    rotWitness.defect ((movedNorm (Fin 3)).comp (alternatingGroup (Fin 3)).subtype_injective) =
      9 := by
  -- the four holonomies are `1`, `rotThree`, `rotThree⁻¹` and `rotThree⁻¹ * rotThree⁻¹ = rotThree`,
  -- and each `3`-cycle moves all three points
  norm_num [Cochain.defect_complete_fin_four, rotWitness, Cochain.holonomy_ofLt_complete,
    rotWitnessFn, movedNorm_apply, rotThree_inv_mul_inv, card_support_rotThree]

private theorem six_le_cost_rotWitness (β : Fin 4 → alternatingGroup (Fin 3)) :
    6 ≤ rotWitness.cost ((movedNorm (Fin 3)).comp (alternatingGroup (Fin 3)).subtype_injective)
      β := by
  simp only [Cochain.cost_complete_fin_four, rotWitness_apply, Fin.reduceLT, GroupNorm.comp_apply,
    Subgroup.coe_subtype, movedNorm_apply]
  -- the six support cardinalities only depend on the four gauge values; it is a finite check
  norm_cast
  generalize β 0 = b₀, β 1 = b₁, β 2 = b₂, β 3 = b₃
  revert b₀ b₁ b₂ b₃
  decide +kernel

/-- With the restricted moved-point norm, the alternating group `A₃ ≤ Perm (Fin 3)` has coboundary
constant `3 / 2` on `complete (Fin 4)`. It is attained by the cochain carrying a `3`-cycle `c` on
`(1, 3)` and `c⁻¹` on `(2, 3)`, with defect `9` and gauge distance `6`. -/
theorem h1_complete_fin_four_alternatingGroup :
    h1 (complete (Fin 4))
      ((movedNorm (Fin 3)).comp (alternatingGroup (Fin 3)).subtype_injective) = 3 / 2 := by
  set ℓ := (movedNorm (Fin 3)).comp (alternatingGroup (Fin 3)).subtype_injective
  have hD : (6 : ℝ) ≤ rotWitness.gaugeDist ℓ :=
    (rotWitness.le_gaugeDist_iff ℓ).mpr six_le_cost_rotWitness
  have hpos : 0 < rotWitness.gaugeDist ℓ := by linarith
  refine le_antisymm ((h1_le_div hpos).trans ?_)
    (le_h1_of_forall ⟨rotWitness, hpos⟩ fun α hα => ?_)
  · rw [defect_rotWitness, div_le_iff₀ hpos]
    linarith
  · obtain ⟨β, hβ⟩ := α.exists_three_mul_cost_le_two_mul_defect_alternatingGroup
    rw [le_div_iff₀ hα]
    linarith [α.gaugeDist_le_cost ℓ β]

/-- For every group norm on a group of order three, the coboundary constant of `complete (Fin 4)`
is `3 / 2`: the group is isomorphic to `A₃`, and the norm is a positive multiple of the restricted
moved-point norm, since it takes the same value on the two non-identity elements. -/
theorem h1_complete_fin_four_of_card_eq_three (hG : Nat.card G = 3) (ℓ : GroupNorm G) :
    h1 (complete (Fin 4)) ℓ = 3 / 2 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let e : G ≃* alternatingGroup (Fin 3) :=
    mulEquivOfPrimeCardEq hG (by rw [Nat.card_eq_fintype_card]; decide)
  have hr : 0 < ℓ (e.symm rotThree) / 3 :=
    div_pos (map_pos_of_ne_one ℓ (by simpa using (show rotThree ≠ 1 by decide))) three_pos
  set ℓ' := ((movedNorm (Fin 3)).comp (alternatingGroup (Fin 3)).subtype_injective).smulOfPos hr
  have hrot : ∀ g, e g = rotThree → ℓ' (e g) = ℓ g := fun g h => by
    simp [ℓ', movedNorm_apply, e.eq_symm_apply.mpr h, card_support_rotThree]
  have he : ∀ g, ℓ' (e g) = ℓ g := by
    intro g
    rcases eq_one_or_eq_rotThree_or_eq_inv (e g) with h | h | h
    · simp [e.map_eq_one_iff.mp h]
    · exact hrot g h
    · simpa using hrot g⁻¹ (by simp [h])
  rw [h1_congr_mulEquiv _ e he, h1_smulOfPos, h1_complete_fin_four_alternatingGroup]

/-- Every subgroup `H` of `Perm (Fin 3)` other than `⊥` and `⊤`, with the restricted moved-point
norm, has a coboundary constant on `complete (Fin 4)` strictly above the value `4 / 3` of
`Perm (Fin 3)`: such an `H` has order two or three, with constant `2` or `3 / 2`. These subgroups
are exactly the nontrivial commutative subgroups of `Perm (Fin 3)`. -/
theorem h1_complete_fin_four_movedNorm_lt_comp_subtype (H : Subgroup (Perm (Fin 3)))
    (hbot : H ≠ ⊥) (htop : H ≠ ⊤) :
    h1 (complete (Fin 4)) (movedNorm (Fin 3)) <
      h1 (complete (Fin 4)) ((movedNorm (Fin 3)).comp H.subtype_injective) := by
  have hcard : Nat.card (Perm (Fin 3)) = 6 := by
    simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  have hdvd : Nat.card H ∣ 6 := hcard ▸ H.card_subgroup_dvd_card
  have hone : Nat.card H ≠ 1 := fun h => hbot (Subgroup.eq_bot_of_card_eq H h)
  have h6 : Nat.card H ≠ 6 := fun h => htop (Subgroup.eq_top_of_card_eq H (h.trans hcard.symm))
  have h23 : Nat.card H = 2 ∨ Nat.card H = 3 := by
    have := Nat.le_of_dvd (by norm_num) hdvd
    interval_cases hH : Nat.card H <;> simp_all
  rw [h1_complete_fin_four]
  rcases h23 with h | h
  · rw [h1_complete_fin_four_of_card_eq_two h]
    norm_num
  · rw [h1_complete_fin_four_of_card_eq_three h]
    norm_num

end SmallCoefficients

end TauCeti
