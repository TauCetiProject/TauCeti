/-!
# The triangular lattice and its unit rhombi

The vertices of the size-`n` triangle are nonnegative barycentric triples of sum `n`.
`Vertex.rotate` and `Vertex.reflect` give its dihedral symmetries, `Vertex.edgePoint`
parameterizes the three sides along the clockwise perimeter `A → B → C → A`, `Vertex.ofYZ` gives
the two-variable chart `(y, z) ↦ (n - y - z, y, z)`, and `Vertex.ofChart` gives the product chart
`(i, j) ↦ (n - j, j - i, i)` (`0 ≤ i ≤ j ≤ n`). The planar embedding sends `(x,y,z)` to
`(z + y/2, √3*y/2)`, so the corners `(n,0,0)`, `(0,n,0)`, `(0,0,n)` occur clockwise.

`IsRhombus a b c d` records a unit rhombus in perimeter order, with **obtuse** corners
`a,c`. Its short diagonal has barycentric squared length 2, its long diagonal has squared length 6
(`Vertex.sqDist_eq_six_iff`), its diagonals are orthogonal (`IsRhombus.diagonal_inner_eq_zero`),
and its acute corners uniquely determine its unordered pair of obtuse corners
(`IsRhombus.obtuse_eq_or_eq`); the planar squared lengths are respectively 1 and 3. `IsUnitStep` and
`HasStep` characterize unit rhombi generated by two unit lattice edge steps
(`isRhombus_of_hasStep_iff`), `isRhombus_ofYZ_step` exhibits each elementary `(y, z)` cell as a
unit rhombus, and `isRhombus_ofChart_diag_y`, `isRhombus_ofChart_diag_z`, and
`isRhombus_ofChart_diag_x` exhaust all unit rhombi in the product chart up to corner swaps
(`IsRhombus.elim_ofChart`). This ordering is intended for the hive inequality
`h b + h d ≤ h a + h c`.

The convention follows Knutson–Tao, *The honeycomb model of GLₙ(ℂ) tensor products I*,
Appendix 2. This file contains only lattice geometry, not hive inequalities.
-/

public section

open scoped BigOperators

namespace TauCeti.Hive

/-- A nonnegative barycentric lattice point in the triangle of side length `n`. -/
@[ext]
structure Vertex (n : ℕ) where
  /-- The coordinate at the first corner. -/
  x : ℕ
  /-- The coordinate at the second corner. -/
  y : ℕ
  /-- The coordinate at the third corner. -/
  z : ℕ
  /-- The barycentric coordinates have the prescribed sum. -/
  sum_eq : x + y + z = n
  deriving DecidableEq

namespace Vertex

variable {n : ℕ}

/-- The barycentric coordinates, indexed in the order `x,y,z`. -/
def coord (p : Vertex n) : Fin 3 → ℕ := ![p.x, p.y, p.z]

@[simp] theorem coord_zero (p : Vertex n) : p.coord 0 = p.x := (rfl)
@[simp] theorem coord_one (p : Vertex n) : p.coord 1 = p.y := (rfl)
@[simp] theorem coord_two (p : Vertex n) : p.coord 2 = p.z := (rfl)

/-- Identify vertices with the computably enumerated triples of sum `n`. -/
def equivAntidiagonalTuple : Vertex n ≃ ↥(Finset.Nat.antidiagonalTuple 3 n) where
  toFun p := ⟨p.coord, by
    rw [Finset.Nat.mem_antidiagonalTuple]
    simpa [coord, Fin.sum_univ_succ, add_assoc] using p.sum_eq⟩
  invFun t := ⟨t.1 0, t.1 1, t.1 2, by
    have ht := Finset.Nat.mem_antidiagonalTuple.mp t.2
    simpa [Fin.sum_univ_succ, add_assoc] using ht⟩
  left_inv p := by ext <;> rfl
  right_inv t := by
    apply Subtype.ext
    funext i
    fin_cases i <;> rfl

@[simp] theorem equivAntidiagonalTuple_apply (p : Vertex n) :
    (equivAntidiagonalTuple p).val = p.coord := (rfl)

instance : Fintype (Vertex n) := Fintype.ofEquiv _ equivAntidiagonalTuple.symm

/-- The corner `A = (n,0,0)`. Its rotations are `B = (0,n,0)` and `C = (0,0,n)`;
their coordinates simplify using `rotate_x`, `rotate_y`, and `rotate_z`. -/
def cornerA (n : ℕ) : Vertex n := ⟨n, 0, 0, by omega⟩

@[simp] theorem cornerA_x (n : ℕ) : (cornerA n).x = n := (rfl)
@[simp] theorem cornerA_y (n : ℕ) : (cornerA n).y = 0 := (rfl)
@[simp] theorem cornerA_z (n : ℕ) : (cornerA n).z = 0 := (rfl)

/-- Clockwise rotation by one third of a turn: `(x,y,z) ↦ (z,x,y)`. -/
def rotate (p : Vertex n) : Vertex n := ⟨p.z, p.x, p.y, by have := p.sum_eq; omega⟩

/-- Reflection fixing `A` and interchanging the other two corners. -/
def reflect (p : Vertex n) : Vertex n := ⟨p.x, p.z, p.y, by have := p.sum_eq; omega⟩

@[simp] theorem rotate_x (p : Vertex n) : p.rotate.x = p.z := (rfl)
@[simp] theorem rotate_y (p : Vertex n) : p.rotate.y = p.x := (rfl)
@[simp] theorem rotate_z (p : Vertex n) : p.rotate.z = p.y := (rfl)
@[simp] theorem reflect_x (p : Vertex n) : p.reflect.x = p.x := (rfl)
@[simp] theorem reflect_y (p : Vertex n) : p.reflect.y = p.z := (rfl)
@[simp] theorem reflect_z (p : Vertex n) : p.reflect.z = p.y := (rfl)

/-- Three clockwise rotations return to the original vertex. -/
@[simp] theorem rotate_rotate_rotate (p : Vertex n) : p.rotate.rotate.rotate = p := by
  ext <;> rfl

/-- Reflection is an involution. -/
@[simp] theorem reflect_reflect (p : Vertex n) : p.reflect.reflect = p := by
  ext <;> rfl

/-- Clockwise rotation is injective; its inverse is two clockwise rotations. -/
theorem rotate_injective : Function.Injective (rotate (n := n)) := by
  intro p q h
  simpa using congrArg (fun r => r.rotate.rotate) h

/-- Reflection is injective. -/
theorem reflect_injective : Function.Injective (reflect (n := n)) :=
  Function.Involutive.injective reflect_reflect

@[simp] theorem reflect_cornerA (n : ℕ) : (cornerA n).reflect = cornerA n := by
  ext <;> rfl

/-- Reflection conjugates clockwise rotation to counterclockwise rotation. -/
@[simp] theorem reflect_rotate (p : Vertex n) :
    p.rotate.reflect = p.reflect.rotate.rotate := by
  ext <;> rfl

/-- Add barycentric coordinates, embedding translated lattice triangles. -/
def add {m : ℕ} (p : Vertex n) (q : Vertex m) : Vertex (n + m) :=
  ⟨p.x + q.x, p.y + q.y, p.z + q.z, by have := p.sum_eq; have := q.sum_eq; omega⟩

@[simp] theorem add_x {m : ℕ} (p : Vertex n) (q : Vertex m) : (p.add q).x = p.x + q.x := (rfl)
@[simp] theorem add_y {m : ℕ} (p : Vertex n) (q : Vertex m) : (p.add q).y = p.y + q.y := (rfl)
@[simp] theorem add_z {m : ℕ} (p : Vertex n) (q : Vertex m) : (p.add q).z = p.z + q.z := (rfl)

/-- Squared length in the ambient barycentric integer coordinates. -/
def sqDist (p q : Vertex n) : ℤ :=
  ((p.x : ℤ) - q.x) ^ 2 + ((p.y : ℤ) - q.y) ^ 2 + ((p.z : ℤ) - q.z) ^ 2

theorem sqDist_def (p q : Vertex n) :
    sqDist p q = ((p.x : ℤ) - q.x) ^ 2 + ((p.y : ℤ) - q.y) ^ 2 + ((p.z : ℤ) - q.z) ^ 2 := (rfl)

@[simp] theorem sqDist_self (p : Vertex n) : sqDist p p = 0 := by simp [sqDist]

/-- Barycentric squared distance vanishes exactly at equal vertices. -/
@[simp] theorem sqDist_eq_zero_iff (p q : Vertex n) : sqDist p q = 0 ↔ p = q := by
  constructor
  · intro h
    rw [sqDist, add_eq_zero_iff_of_nonneg (add_nonneg (sq_nonneg _) (sq_nonneg _))
      (sq_nonneg _), add_eq_zero_iff_of_nonneg (sq_nonneg _) (sq_nonneg _)] at h
    simp only [sq_eq_zero_iff, sub_eq_zero, Int.natCast_inj] at h
    exact Vertex.ext h.1.1 h.1.2 h.2
  · rintro rfl
    exact sqDist_self p

/-- Barycentric squared distance is symmetric. -/
theorem sqDist_comm (p q : Vertex n) : sqDist p q = sqDist q p := by
  unfold sqDist
  ring

@[simp] theorem sqDist_rotate (p q : Vertex n) : sqDist p.rotate q.rotate = sqDist p q := by
  simp only [sqDist, rotate_x, rotate_y, rotate_z]
  ring

@[simp] theorem sqDist_reflect (p q : Vertex n) :
    sqDist p.reflect q.reflect = sqDist p q := by
  simp only [sqDist, reflect_x, reflect_y, reflect_z]
  ring

/-- Translation of a lattice triangle preserves barycentric squared distances. -/
@[simp] theorem sqDist_add_left {m : ℕ} (p : Vertex m) (q r : Vertex n) :
    sqDist (p.add q) (p.add r) = sqDist q r := by
  simp only [sqDist, add_x, add_y, add_z, Nat.cast_add]
  ring

/-- Two vertices in `Δₙ` have barycentric squared distance `6` (the long-diagonal squared length of
a unit rhombus) if and only if their coordinate difference `d - b` is one of the six permutations
of `(-2, 1, 1)` and `(2, -1, -1)`. -/
theorem sqDist_eq_six_iff (b d : Vertex n) :
    b.sqDist d = 6 ↔
      ((d.x : ℤ) - b.x = -1 ∧ (d.y : ℤ) - b.y = 2 ∧ (d.z : ℤ) - b.z = -1) ∨
      ((d.x : ℤ) - b.x = 1 ∧ (d.y : ℤ) - b.y = -2 ∧ (d.z : ℤ) - b.z = 1) ∨
      ((d.x : ℤ) - b.x = -1 ∧ (d.y : ℤ) - b.y = -1 ∧ (d.z : ℤ) - b.z = 2) ∨
      ((d.x : ℤ) - b.x = 1 ∧ (d.y : ℤ) - b.y = 1 ∧ (d.z : ℤ) - b.z = -2) ∨
      ((d.x : ℤ) - b.x = -2 ∧ (d.y : ℤ) - b.y = 1 ∧ (d.z : ℤ) - b.z = 1) ∨
      ((d.x : ℤ) - b.x = 2 ∧ (d.y : ℤ) - b.y = -1 ∧ (d.z : ℤ) - b.z = -1) := by
  have hdz : (d.z : ℤ) - b.z = -((d.x : ℤ) - b.x) - ((d.y : ℤ) - b.y) := by
    have := b.sum_eq; have := d.sum_eq; omega
  rw [sqDist_comm, sqDist_def]
  refine ⟨fun hsq => ?_, fun h => ?_⟩
  · have hbnd {u v w : ℤ} (hu : u ^ 2 + v ^ 2 + w ^ 2 = 6) : -2 ≤ u ∧ u ≤ 2 :=
      ⟨by by_contra _; linarith [sq_nonneg (u + 3), sq_nonneg v, sq_nonneg w,
          (by ring : (u + 3) ^ 2 = u ^ 2 + 6 * u + 9), (by omega : u ≤ -3)],
       by by_contra _; linarith [sq_nonneg (u - 3), sq_nonneg v, sq_nonneg w,
          (by ring : (u - 3) ^ 2 = u ^ 2 - 6 * u + 9), (by omega : 3 ≤ u)]⟩
    have hbx := hbnd hsq
    have hby := hbnd (by linarith :
      ((d.y : ℤ) - b.y) ^ 2 + ((d.x : ℤ) - b.x) ^ 2 + ((d.z : ℤ) - b.z) ^ 2 = 6)
    rcases (by omega : (d.x : ℤ) - b.x = -2 ∨ (d.x : ℤ) - b.x = -1 ∨ (d.x : ℤ) - b.x = 0 ∨
        (d.x : ℤ) - b.x = 1 ∨ (d.x : ℤ) - b.x = 2) with hx | hx | hx | hx | hx <;>
      rcases (by omega : (d.y : ℤ) - b.y = -2 ∨ (d.y : ℤ) - b.y = -1 ∨ (d.y : ℤ) - b.y = 0 ∨
        (d.y : ℤ) - b.y = 1 ∨ (d.y : ℤ) - b.y = 2) with hy | hy | hy | hy | hy <;>
      (rw [hdz, hx, hy] at hsq; norm_num at hsq) <;> omega
  · rcases h with ⟨hx, hy, hz⟩ | ⟨hx, hy, hz⟩ | ⟨hx, hy, hz⟩ | ⟨hx, hy, hz⟩ |
        ⟨hx, hy, hz⟩ | ⟨hx, hy, hz⟩ <;> (rw [hx, hy, hz]; norm_num)

/-- The equilateral planar realization of the triangular lattice. -/
noncomputable def plane (p : Vertex n) : EuclideanSpace ℝ (Fin 2) :=
  !₂[(p.z : ℝ) + p.y / 2, Real.sqrt 3 * p.y / 2]

@[simp] theorem plane_zero (p : Vertex n) :
    p.plane 0 = (p.z : ℝ) + p.y / 2 := by simp [plane]

@[simp] theorem plane_one (p : Vertex n) :
    p.plane 1 = Real.sqrt 3 * p.y / 2 := by simp [plane]

/-- Planar squared distances are half the barycentric squared distances. -/
theorem dist_plane_sq (p q : Vertex n) :
    dist p.plane q.plane ^ 2 = (sqDist p q : ℝ) / 2 := by
  have hp : (p.x : ℝ) + p.y + p.z = n := by exact_mod_cast p.sum_eq
  have hq : (q.x : ℝ) + q.y + q.z = n := by exact_mod_cast q.sum_eq
  have hs : Real.sqrt 3 ^ 2 = (3 : ℝ) := Real.sq_sqrt (by norm_num)
  have hdelta : (p.x : ℝ) - q.x = -((p.y - q.y) + (p.z - q.z)) := by
    linarith [hp, hq]
  simp only [EuclideanSpace.dist_sq_eq, Fin.sum_univ_two, plane_zero, plane_one,
    Real.dist_eq, sq_abs, sqDist, Int.cast_add, Int.cast_pow, Int.cast_sub,
    Int.cast_natCast]
  rw [hdelta]
  linear_combination ((p.y : ℝ) - q.y) ^ 2 / 4 * hs

/-- The planar realization does not identify distinct lattice vertices. -/
theorem plane_injective : Function.Injective (plane (n := n)) := by
  intro p q h
  have hd := dist_plane_sq p q
  rw [h, dist_self] at hd
  have hz : (sqDist p q : ℝ) = 0 := by simpa using hd.symm
  exact (sqDist_eq_zero_iff p q).mp (by exact_mod_cast hz)

end Vertex

namespace Vertex

/-- The `k`-th lattice point along side `s` of the clockwise perimeter `A → B → C → A`:
`s = 0` traverses `A → B`, `s = 1` traverses `B → C`, and `s = 2` traverses `C → A`. -/
def edgePoint (n : ℕ) (s : Fin 3) (k : Fin (n + 1)) : Vertex n :=
  match s with
  | ⟨0, _⟩ => ⟨n - k.val, k.val, 0, by omega⟩
  | ⟨1, _⟩ => ⟨0, n - k.val, k.val, by omega⟩
  | ⟨2, _⟩ => ⟨k.val, 0, n - k.val, by omega⟩

@[simp] theorem edgePoint_zero_x (n : ℕ) (k : Fin (n + 1)) :
    (edgePoint n 0 k).x = n - k.val := (rfl)
@[simp] theorem edgePoint_zero_y (n : ℕ) (k : Fin (n + 1)) : (edgePoint n 0 k).y = k.val := (rfl)
@[simp] theorem edgePoint_zero_z (n : ℕ) (k : Fin (n + 1)) : (edgePoint n 0 k).z = 0 := (rfl)
@[simp] theorem edgePoint_one_x (n : ℕ) (k : Fin (n + 1)) : (edgePoint n 1 k).x = 0 := (rfl)
@[simp] theorem edgePoint_one_y (n : ℕ) (k : Fin (n + 1)) :
    (edgePoint n 1 k).y = n - k.val := (rfl)
@[simp] theorem edgePoint_one_z (n : ℕ) (k : Fin (n + 1)) : (edgePoint n 1 k).z = k.val := (rfl)
@[simp] theorem edgePoint_two_x (n : ℕ) (k : Fin (n + 1)) : (edgePoint n 2 k).x = k.val := (rfl)
@[simp] theorem edgePoint_two_y (n : ℕ) (k : Fin (n + 1)) : (edgePoint n 2 k).y = 0 := (rfl)
@[simp] theorem edgePoint_two_z (n : ℕ) (k : Fin (n + 1)) :
    (edgePoint n 2 k).z = n - k.val := (rfl)

@[simp] theorem edgePoint_zero_zero (n : ℕ) : edgePoint n 0 0 = cornerA n := by ext <;> simp
@[simp] theorem edgePoint_two_last (n : ℕ) : edgePoint n 2 (Fin.last n) = cornerA n := by
  ext <;> simp

/-- Each side ends where the next clockwise side begins. -/
@[simp] theorem edgePoint_add_one_zero (n : ℕ) (s : Fin 3) :
    edgePoint n (s + 1) 0 = edgePoint n s (Fin.last n) := by
  fin_cases s <;> ext <;> simp [edgePoint]

/-- Clockwise rotation advances the side index `s` by `1` in `Fin 3`. -/
@[simp] theorem rotate_edgePoint (n : ℕ) (s : Fin 3) (k : Fin (n + 1)) :
    (edgePoint n s k).rotate = edgePoint n (s + 1) k := by fin_cases s <;> ext <;> simp [edgePoint]

/-- Reflection across `A` reverses both the side index (`0 ↔ 2`, fixing `1`) and position. -/
@[simp] theorem reflect_edgePoint (n : ℕ) (s : Fin 3) (k : Fin (n + 1)) :
    (edgePoint n s k).reflect = edgePoint n s.rev k.rev := by
  fin_cases s <;> ext <;> simp [edgePoint, Fin.val_rev] <;> omega

/-- Points along any single side of the perimeter are indexed injectively by `Fin (n + 1)`. -/
theorem edgePoint_injective (n : ℕ) (s : Fin 3) : Function.Injective (edgePoint n s) := by
  intro j k h; fin_cases s
  · exact Fin.ext (congrArg Vertex.y h)
  · exact Fin.ext (congrArg Vertex.z h)
  · exact Fin.ext (congrArg Vertex.x h)

/-- Construct a lattice vertex `(n - y - z, y, z)` from nonnegative `(y, z)` with `y + z ≤ n`. -/
def ofYZ (n : ℕ) (y z : ℕ) (h : y + z ≤ n) : Vertex n := ⟨n - y - z, y, z, by omega⟩

@[simp] theorem ofYZ_x (n y z : ℕ) (h : y + z ≤ n) : (ofYZ n y z h).x = n - y - z := (rfl)
@[simp] theorem ofYZ_y (n y z : ℕ) (h : y + z ≤ n) : (ofYZ n y z h).y = y := (rfl)
@[simp] theorem ofYZ_z (n y z : ℕ) (h : y + z ≤ n) : (ofYZ n y z h).z = z := (rfl)

@[simp] theorem ofYZ_eq_iff {n y₁ z₁ y₂ z₂ : ℕ} {h₁ : y₁ + z₁ ≤ n} {h₂ : y₂ + z₂ ≤ n} :
    ofYZ n y₁ z₁ h₁ = ofYZ n y₂ z₂ h₂ ↔ y₁ = y₂ ∧ z₁ = z₂ :=
  ⟨fun h => ⟨congrArg Vertex.y h, congrArg Vertex.z h⟩, fun ⟨hy, hz⟩ => by subst hy; subst hz; rfl⟩

@[simp] theorem ofYZ_y_z {n : ℕ} (p : Vertex n) :
    ofYZ n p.y p.z (by have := p.sum_eq; omega) = p := by ext <;> simp; have := p.sum_eq; omega

@[simp] theorem ofYZ_zero_zero (n : ℕ) : ofYZ n 0 0 (Nat.zero_le n) = cornerA n := by ext <;> simp

/-- Setting `z = 0` in the `(y, z)` chart gives the `y`-th vertex along side `A → B`. -/
theorem ofYZ_zero_right (n y : ℕ) (hy : y ≤ n) :
    ofYZ n y 0 (by omega) = edgePoint n 0 ⟨y, by omega⟩ := by ext <;> simp

/-- Setting `y = 0` in the `(y, z)` chart gives the `(n - z)`-th vertex along side `C → A`. -/
theorem ofYZ_zero_left (n z : ℕ) (hz : z ≤ n) :
    ofYZ n 0 z (by omega) = edgePoint n 2 ⟨n - z, by omega⟩ := by ext <;> simp; omega

/-- Setting `y = n - z` in the `(y, z)` chart gives the `z`-th vertex along side `B → C`. -/
theorem ofYZ_sub_left (n z : ℕ) (hz : z ≤ n) :
    ofYZ n (n - z) z (by omega) = edgePoint n 1 ⟨z, by omega⟩ := by ext <;> simp; omega

/-- Product-chart parameterization `(i, j) ↦ (n - j, j - i, i)` of `Vertex n` for `0 ≤ i ≤ j ≤ n`,
with inverse `p ↦ (p.z, n - p.x)`. -/
def ofChart (n i j : ℕ) (hij : i ≤ j) (hj : j ≤ n) : Vertex n :=
  ⟨n - j, j - i, i, by omega⟩

@[simp] theorem ofChart_x (n i j : ℕ) (hij : i ≤ j) (hj : j ≤ n) :
    (ofChart n i j hij hj).x = n - j := (rfl)

@[simp] theorem ofChart_y (n i j : ℕ) (hij : i ≤ j) (hj : j ≤ n) :
    (ofChart n i j hij hj).y = j - i := (rfl)

@[simp] theorem ofChart_z (n i j : ℕ) (hij : i ≤ j) (hj : j ≤ n) :
    (ofChart n i j hij hj).z = i := (rfl)

@[simp]
theorem ofChart_eq_iff {n i₁ j₁ i₂ j₂ : ℕ} {hi₁ : i₁ ≤ j₁} {hj₁ : j₁ ≤ n}
    {hi₂ : i₂ ≤ j₂} {hj₂ : j₂ ≤ n} :
    ofChart n i₁ j₁ hi₁ hj₁ = ofChart n i₂ j₂ hi₂ hj₂ ↔ i₁ = i₂ ∧ j₁ = j₂ := by
  refine ⟨fun h => ⟨congrArg Vertex.z h, ?_⟩, fun ⟨hi, hj⟩ => by subst hi; subst hj; rfl⟩
  have hx := congrArg Vertex.x h; simp only [ofChart_x] at hx; omega

/-- Every lattice vertex `p : Vertex n` is recovered in the product chart at `(p.z, n - p.x)`. -/
@[simp]
theorem ofChart_z_sub_x {n : ℕ} (p : Vertex n) :
    ofChart n p.z (n - p.x) (by have := p.sum_eq; omega) (Nat.sub_le n p.x) = p := by
  have hp := p.sum_eq; ext <;> simp <;> omega

/-- A vertex `p : Vertex n` with `p.z = i` and `p.x + j = n` equals `ofChart n i j hij hj`. -/
theorem eq_ofChart_of_z_x {n i j : ℕ} {p : Vertex n} {hij : i ≤ j} {hj : j ≤ n}
    (hz : p.z = i) (hx : p.x + j = n) :
    p = ofChart n i j hij hj := by
  have := p.sum_eq; ext <;> simp <;> omega

theorem ofChart_eq_ofYZ (n i j : ℕ) (hij : i ≤ j) (hj : j ≤ n) :
    ofChart n i j hij hj = ofYZ n (j - i) i (by omega) := by
  ext <;> simp; omega

@[simp] theorem ofChart_zero_zero (n : ℕ) : ofChart n 0 0 le_rfl (Nat.zero_le n) = cornerA n := by
  ext <;> simp

/-- Setting `i = 0` gives the `j`-th vertex along side `A → B` (`s = 0`). -/
theorem ofChart_zero_left (n j : ℕ) (hj : j ≤ n) :
    ofChart n 0 j (Nat.zero_le j) hj = edgePoint n 0 ⟨j, by omega⟩ := by ext <;> simp

/-- Setting `j = n` gives the `i`-th vertex along side `B → C` (`s = 1`). -/
theorem ofChart_right (n i : ℕ) (hi : i ≤ n) :
    ofChart n i n hi le_rfl = edgePoint n 1 ⟨i, by omega⟩ := by ext <;> simp

/-- Setting `i = j` gives the `(n - j)`-th vertex along side `C → A` (`s = 2`). -/
theorem ofChart_self (n j : ℕ) (hj : j ≤ n) :
    ofChart n j j le_rfl hj = edgePoint n 2 ⟨n - j, by omega⟩ := by ext <;> simp; omega

/-- Rotating `(n - j, j - i, i)` clockwise twice gives `(j - i, i, n - j)`. -/
theorem rotate_rotate_ofChart (n i j : ℕ) (hij : i ≤ j) (hj : j ≤ n) :
    (ofChart n i j hij hj).rotate.rotate = ⟨j - i, i, n - j, by omega⟩ := by ext <;> simp

end Vertex

/-- A unit rhombus in perimeter order, with `a,c` the obtuse (short-diagonal) corners.
All squared distances here use barycentric coordinates. -/
structure IsRhombus {n : ℕ} (a b c d : Vertex n) : Prop where
  /-- The diagonals have the same midpoint. -/
  midpoint_x : a.x + c.x = b.x + d.x
  /-- The diagonals have the same midpoint. -/
  midpoint_y : a.y + c.y = b.y + d.y
  /-- The diagonals have the same midpoint. -/
  midpoint_z : a.z + c.z = b.z + d.z
  /-- The diagonal joining the obtuse corners is short. -/
  short : a.sqDist c = 2
  /-- The diagonal joining the acute corners is long. -/
  long : b.sqDist d = 6
  /-- The first side is a unit lattice edge. -/
  side_ab : a.sqDist b = 2
  /-- The second side is a unit lattice edge. -/
  side_bc : b.sqDist c = 2
  /-- The third side is a unit lattice edge. -/
  side_cd : c.sqDist d = 2
  /-- The fourth side is a unit lattice edge. -/
  side_da : d.sqDist a = 2

instance {n : ℕ} (a b c d : Vertex n) : Decidable (IsRhombus a b c d) :=
  decidable_of_iff
    (a.x + c.x = b.x + d.x ∧ a.y + c.y = b.y + d.y ∧ a.z + c.z = b.z + d.z ∧
      a.sqDist c = 2 ∧ b.sqDist d = 6 ∧ a.sqDist b = 2 ∧ b.sqDist c = 2 ∧
      c.sqDist d = 2 ∧ d.sqDist a = 2)
    ⟨fun ⟨hx, hy, hz, hs, hl, hab, hbc, hcd, hda⟩ =>
        ⟨hx, hy, hz, hs, hl, hab, hbc, hcd, hda⟩,
      fun h => ⟨h.midpoint_x, h.midpoint_y, h.midpoint_z, h.short, h.long,
        h.side_ab, h.side_bc, h.side_cd, h.side_da⟩⟩

namespace IsRhombus

variable {n : ℕ} {a b c d : Vertex n}

/-- Clockwise rotation preserves unit rhombi and their obtuse-corner ordering. -/
theorem rotate (h : IsRhombus a b c d) :
    IsRhombus a.rotate b.rotate c.rotate d.rotate where
  midpoint_x := h.midpoint_z
  midpoint_y := h.midpoint_x
  midpoint_z := h.midpoint_y
  short := by simpa using h.short
  long := by simpa using h.long
  side_ab := by simpa using h.side_ab
  side_bc := by simpa using h.side_bc
  side_cd := by simpa using h.side_cd
  side_da := by simpa using h.side_da

/-- Reflection preserves unit rhombi and their obtuse-corner ordering. -/
theorem reflect (h : IsRhombus a b c d) :
    IsRhombus a.reflect b.reflect c.reflect d.reflect where
  midpoint_x := h.midpoint_x
  midpoint_y := h.midpoint_z
  midpoint_z := h.midpoint_y
  short := by simpa using h.short
  long := by simpa using h.long
  side_ab := by simpa using h.side_ab
  side_bc := by simpa using h.side_bc
  side_cd := by simpa using h.side_cd
  side_da := by simpa using h.side_da

/-- Reverse the perimeter ordering without changing the short diagonal. -/
theorem reverse (h : IsRhombus a b c d) : IsRhombus a d c b where
  midpoint_x := by have := h.midpoint_x; omega
  midpoint_y := by have := h.midpoint_y; omega
  midpoint_z := by have := h.midpoint_z; omega
  short := h.short
  long := by rw [Vertex.sqDist_comm]; exact h.long
  side_ab := by rw [Vertex.sqDist_comm]; exact h.side_da
  side_bc := by rw [Vertex.sqDist_comm]; exact h.side_cd
  side_cd := by rw [Vertex.sqDist_comm]; exact h.side_bc
  side_da := by rw [Vertex.sqDist_comm]; exact h.side_ab

/-- A half-turn of the perimeter ordering exchanges both pairs of opposite corners. -/
theorem swap_opposite (h : IsRhombus a b c d) : IsRhombus c d a b where
  midpoint_x := by have := h.midpoint_x; omega
  midpoint_y := by have := h.midpoint_y; omega
  midpoint_z := by have := h.midpoint_z; omega
  short := by rw [Vertex.sqDist_comm]; exact h.short
  long := by rw [Vertex.sqDist_comm]; exact h.long
  side_ab := h.side_cd
  side_bc := h.side_da
  side_cd := h.side_ab
  side_da := h.side_bc

/-- A triangle admitting a unit rhombus has side length at least two. -/
theorem two_le (h : IsRhombus a b c d) : 2 ≤ n := by
  by_contra hn
  have hb := b.sum_eq
  have hd := d.sum_eq
  have hx : ((b.x : ℤ) - d.x) ^ 2 ≤ 1 := by
    simpa using (sq_le_sq' (a := (b.x : ℤ) - d.x) (b := 1) (by omega) (by omega))
  have hy : ((b.y : ℤ) - d.y) ^ 2 ≤ 1 := by
    simpa using (sq_le_sq' (a := (b.y : ℤ) - d.y) (b := 1) (by omega) (by omega))
  have hz : ((b.z : ℤ) - d.z) ^ 2 ≤ 1 := by
    simpa using (sq_le_sq' (a := (b.z : ℤ) - d.z) (b := 1) (by omega) (by omega))
  have hl := h.long
  simp only [Vertex.sqDist] at hl
  omega

/-- The planar squared lengths of the two diagonals are 1 and 3. -/
theorem diagonal_dist_sq (h : IsRhombus a b c d) :
    dist a.plane c.plane ^ 2 = 1 ∧ dist b.plane d.plane ^ 2 = 3 := by
  norm_num [Vertex.dist_plane_sq, h.short, h.long]

/-- Translating a rhombus into a larger triangle preserves it. -/
theorem add {m : ℕ} (h : IsRhombus a b c d) (p : Vertex m) :
    IsRhombus (p.add a) (p.add b) (p.add c) (p.add d) where
  midpoint_x := by simp only [Vertex.add_x]; have := h.midpoint_x; omega
  midpoint_y := by simp only [Vertex.add_y]; have := h.midpoint_y; omega
  midpoint_z := by simp only [Vertex.add_z]; have := h.midpoint_z; omega
  short := by simpa using h.short
  long := by simpa using h.long
  side_ab := by simpa using h.side_ab
  side_bc := by simpa using h.side_bc
  side_cd := by simpa using h.side_cd
  side_da := by simpa using h.side_da

/-- The long and short diagonals of a unit rhombus are orthogonal in barycentric coordinates. -/
theorem diagonal_inner_eq_zero (h : IsRhombus a b c d) :
    ((d.x : ℤ) - b.x) * ((c.x : ℤ) - a.x) + ((d.y : ℤ) - b.y) * ((c.y : ℤ) - a.y) +
      ((d.z : ℤ) - b.z) * ((c.z : ℤ) - a.z) = 0 := by
  have hmx : (a.x : ℤ) + c.x = (b.x : ℤ) + d.x := by exact_mod_cast h.midpoint_x
  have hmy : (a.y : ℤ) + c.y = (b.y : ℤ) + d.y := by exact_mod_cast h.midpoint_y
  have hmz : (a.z : ℤ) + c.z = (b.z : ℤ) + d.z := by exact_mod_cast h.midpoint_z
  have hab := h.side_ab; rw [Vertex.sqDist_def] at hab
  have hbc := Vertex.sqDist_comm b c ▸ h.side_bc; rw [Vertex.sqDist_def] at hbc
  have hax : 2 * ((a.x : ℤ) - b.x) = ((d.x : ℤ) - b.x) - ((c.x : ℤ) - a.x) := by omega
  have hay : 2 * ((a.y : ℤ) - b.y) = ((d.y : ℤ) - b.y) - ((c.y : ℤ) - a.y) := by omega
  have haz : 2 * ((a.z : ℤ) - b.z) = ((d.z : ℤ) - b.z) - ((c.z : ℤ) - a.z) := by omega
  have hcx : 2 * ((c.x : ℤ) - b.x) = ((d.x : ℤ) - b.x) + ((c.x : ℤ) - a.x) := by omega
  have hcy : 2 * ((c.y : ℤ) - b.y) = ((d.y : ℤ) - b.y) + ((c.y : ℤ) - a.y) := by omega
  have hcz : 2 * ((c.z : ℤ) - b.z) = ((d.z : ℤ) - b.z) + ((c.z : ℤ) - a.z) := by omega
  have hab4 : (((d.x : ℤ) - b.x) - ((c.x : ℤ) - a.x)) ^ 2 +
      (((d.y : ℤ) - b.y) - ((c.y : ℤ) - a.y)) ^ 2 +
      (((d.z : ℤ) - b.z) - ((c.z : ℤ) - a.z)) ^ 2 = 8 := by
    rw [← hax, ← hay, ← haz]; linear_combination 4 * hab
  have hbc4 : (((d.x : ℤ) - b.x) + ((c.x : ℤ) - a.x)) ^ 2 +
      (((d.y : ℤ) - b.y) + ((c.y : ℤ) - a.y)) ^ 2 +
      (((d.z : ℤ) - b.z) + ((c.z : ℤ) - a.z)) ^ 2 = 8 := by
    rw [← hcx, ← hcy, ← hcz]; linear_combination 4 * hbc
  have horth4 : 4 * (((d.x : ℤ) - b.x) * ((c.x : ℤ) - a.x) +
      ((d.y : ℤ) - b.y) * ((c.y : ℤ) - a.y) + ((d.z : ℤ) - b.z) * ((c.z : ℤ) - a.z)) = 0 := by
    linear_combination hbc4 - hab4
  omega

private theorem obtuse_eq_of_inner_eq_two {a' c' : Vertex n}
    (h : IsRhombus a b c d) (h' : IsRhombus a' b c' d)
    (hip : ((c.x : ℤ) - a.x) * ((c'.x : ℤ) - a'.x) +
      ((c.y : ℤ) - a.y) * ((c'.y : ℤ) - a'.y) +
      ((c.z : ℤ) - a.z) * ((c'.z : ℤ) - a'.z) = 2) :
    a = a' ∧ c = c' := by
  have hd2 : ((c.x : ℤ) - a.x) ^ 2 + ((c.y : ℤ) - a.y) ^ 2 + ((c.z : ℤ) - a.z) ^ 2 = 2 := by
    simpa [Vertex.sqDist_def] using (Vertex.sqDist_comm a c).symm.trans h.short
  have hd'2 :
      ((c'.x : ℤ) - a'.x) ^ 2 + ((c'.y : ℤ) - a'.y) ^ 2 + ((c'.z : ℤ) - a'.z) ^ 2 = 2 := by
    simpa [Vertex.sqDist_def] using (Vertex.sqDist_comm a' c').symm.trans h'.short
  have hdiff : (((c.x : ℤ) - a.x) - ((c'.x : ℤ) - a'.x)) ^ 2 +
      (((c.y : ℤ) - a.y) - ((c'.y : ℤ) - a'.y)) ^ 2 +
      (((c.z : ℤ) - a.z) - ((c'.z : ℤ) - a'.z)) ^ 2 = 0 := by
    linear_combination hd2 + hd'2 - 2 * hip
  rw [add_eq_zero_iff_of_nonneg (add_nonneg (sq_nonneg _) (sq_nonneg _)) (sq_nonneg _),
    add_eq_zero_iff_of_nonneg (sq_nonneg _) (sq_nonneg _)] at hdiff
  simp only [sq_eq_zero_iff, sub_eq_zero] at hdiff
  have := h.midpoint_x; have := h.midpoint_y; have := h.midpoint_z
  have := h'.midpoint_x; have := h'.midpoint_y; have := h'.midpoint_z
  exact ⟨by ext <;> omega, by ext <;> omega⟩

/-- **Acute-diagonal uniqueness**: two unit rhombi sharing the same acute corners `(b, d)` have the
same obtuse corners up to swapping them. -/
theorem obtuse_eq_or_eq {a' c' : Vertex n} (h : IsRhombus a b c d) (h' : IsRhombus a' b c' d) :
    (a = a' ∧ c = c') ∨ (a = c' ∧ c = a') := by
  let wx : ℤ := (d.x : ℤ) - b.x
  let wy : ℤ := (d.y : ℤ) - b.y
  let wz : ℤ := (d.z : ℤ) - b.z
  let dx : ℤ := (c.x : ℤ) - a.x
  let dy : ℤ := (c.y : ℤ) - a.y
  let dz : ℤ := (c.z : ℤ) - a.z
  let dx' : ℤ := (c'.x : ℤ) - a'.x
  let dy' : ℤ := (c'.y : ℤ) - a'.y
  let dz' : ℤ := (c'.z : ℤ) - a'.z
  let nw : ℤ := wx ^ 2 + wy ^ 2 + wz ^ 2
  let nd : ℤ := dx ^ 2 + dy ^ 2 + dz ^ 2
  let nd' : ℤ := dx' ^ 2 + dy' ^ 2 + dz' ^ 2
  let ow : ℤ := wx * dx + wy * dy + wz * dz
  let ow' : ℤ := wx * dx' + wy * dy' + wz * dz'
  let ip : ℤ := dx * dx' + dy * dy' + dz * dz'
  have hwz : wz = -wx - wy := by have := b.sum_eq; have := d.sum_eq; omega
  have hdz : dz = -dx - dy := by have := a.sum_eq; have := c.sum_eq; omega
  have hdz' : dz' = -dx' - dy' := by have := a'.sum_eq; have := c'.sum_eq; omega
  have hw2 : nw = 6 := by
    simpa [Vertex.sqDist_def, nw, wx, wy, wz] using (Vertex.sqDist_comm b d).symm.trans h.long
  have hd2 : nd = 2 := by
    simpa [Vertex.sqDist_def, nd, dx, dy, dz] using (Vertex.sqDist_comm a c).symm.trans h.short
  have hd'2 : nd' = 2 := by
    simpa [Vertex.sqDist_def, nd', dx', dy', dz'] using
      (Vertex.sqDist_comm a' c').symm.trans h'.short
  have horth : ow = 0 := h.diagonal_inner_eq_zero
  have horth' : ow' = 0 := h'.diagonal_inner_eq_zero
  -- In the 2D trace-zero plane `x + y + z = 0`, any three vectors satisfy `det(G(w, d, d')) = 0`;
  -- orthogonality `ow = ow' = 0` with `nw = 6`, `nd = nd' = 2` reduces this identity to `ip² = 4`.
  have hgram : nw * (nd * nd' - ip ^ 2) - nd' * ow ^ 2 - nd * ow' ^ 2 + 2 * ip * ow * ow' = 0 := by
    dsimp only [nw, nd, nd', ow, ow', ip]; rw [hwz, hdz, hdz']; ring
  rw [hw2, hd2, hd'2, horth, horth'] at hgram
  rcases mul_eq_zero.mp (by linarith : (ip - 2) * (ip + 2) = 0) with hip | hip
  · exact Or.inl (h.obtuse_eq_of_inner_eq_two h' (by linarith))
  · exact Or.inr (h.obtuse_eq_of_inner_eq_two h'.swap_opposite.reverse
      (by dsimp only [ip, dx, dy, dz, dx', dy', dz'] at hip; linear_combination -hip))

/-- Two unit rhombi sharing the same acute corners `(b, d)` have equal sums at their obtuse corners
for any function into a commutative additive semigroup. -/
theorem add_obtuse_eq {R : Type*} [AddCommSemigroup R] {a' c' : Vertex n}
    (h : IsRhombus a b c d) (h' : IsRhombus a' b c' d) (f : Vertex n → R) :
    f a + f c = f a' + f c' := by
  rcases h.obtuse_eq_or_eq h' with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · rfl
  · exact add_comm _ _

end IsRhombus

@[simp] theorem isRhombus_rotate_iff {n : ℕ} {a b c d : Vertex n} :
    IsRhombus a.rotate b.rotate c.rotate d.rotate ↔ IsRhombus a b c d := by
  constructor
  · intro h
    simpa using h.rotate.rotate
  · exact IsRhombus.rotate

@[simp] theorem isRhombus_reflect_iff {n : ℕ} {a b c d : Vertex n} :
    IsRhombus a.reflect b.reflect c.reflect d.reflect ↔ IsRhombus a b c d := by
  constructor
  · intro h
    simpa using h.reflect
  · exact IsRhombus.reflect

@[simp] theorem isRhombus_add_left_iff {m n : ℕ} (p : Vertex m) {a b c d : Vertex n} :
    IsRhombus (p.add a) (p.add b) (p.add c) (p.add d) ↔ IsRhombus a b c d := by
  constructor
  · intro h
    exact {
      midpoint_x := by have := h.midpoint_x; simp only [Vertex.add_x] at this; omega
      midpoint_y := by have := h.midpoint_y; simp only [Vertex.add_y] at this; omega
      midpoint_z := by have := h.midpoint_z; simp only [Vertex.add_z] at this; omega
      short := by simpa using h.short
      long := by simpa using h.long
      side_ab := by simpa using h.side_ab
      side_bc := by simpa using h.side_bc
      side_cd := by simpa using h.side_cd
      side_da := by simpa using h.side_da }
  · exact fun h => h.add p

/-- The finite type of ordered unit rhombi in the size-`n` triangular lattice.
The first and third entries are always the obtuse corners. -/
abbrev Rhombus (n : ℕ) :=
  {t : Vertex n × Vertex n × Vertex n × Vertex n // IsRhombus t.1 t.2.1 t.2.2.1 t.2.2.2}

/-- The size-two rhombus adjacent to `A`, with obtuse corners at the midpoints of
`AB` and `CA`. Rotation gives the other two orientations; translation embeds it
in every larger triangular lattice. -/
theorem isRhombus_at_cornerA :
    IsRhombus (⟨1, 1, 0, rfl⟩ : Vertex 2) (Vertex.cornerA 2)
      ⟨1, 0, 1, rfl⟩ ⟨0, 1, 1, rfl⟩ := by
  constructor <;> norm_num [Vertex.sqDist]

/-- An elementary `(y, z)`-unit cell inside `Δₙ` forms a unit rhombus with obtuse corners
`(y + 1, z)` and `(y, z + 1)` and acute corners `(y, z)` and `(y + 1, z + 1)`. -/
theorem isRhombus_ofYZ_step {n y z : ℕ} (h : (y + 1) + (z + 1) ≤ n) :
    IsRhombus (Vertex.ofYZ n (y + 1) z (by omega)) (Vertex.ofYZ n y z (by omega))
      (Vertex.ofYZ n y (z + 1) (by omega)) (Vertex.ofYZ n (y + 1) (z + 1) h) := by
  have hx00 : ((n - y - z : ℕ) : ℤ) = (n : ℤ) - y - z := by omega
  have hx10 : ((n - (y + 1) - z : ℕ) : ℤ) = (n : ℤ) - y - z - 1 := by omega
  have hx01 : ((n - y - (z + 1) : ℕ) : ℤ) = (n : ℤ) - y - z - 1 := by omega
  have hx11 : ((n - (y + 1) - (z + 1) : ℕ) : ℤ) = (n : ℤ) - y - z - 2 := by omega
  refine ⟨by simp; omega, by simp; omega, by simp, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals
    rw [Vertex.sqDist_def]
    simp only [Vertex.ofYZ_x, Vertex.ofYZ_y, Vertex.ofYZ_z, hx00, hx10, hx01, hx11, Nat.cast_add,
      Nat.cast_one]; ring

/-- First product-chart unit-rhombus family (`0 ≤ i < j < n`, long diagonal along `y`), with obtuse
corners `(i, j)` and `(i + 1, j + 1)` and acute corners `(i + 1, j)` and `(i, j + 1)`. -/
theorem isRhombus_ofChart_diag_y {n i j : ℕ} (hij : i < j) (hj : j < n) :
    IsRhombus (Vertex.ofChart n i j hij.le hj.le)
      (Vertex.ofChart n (i + 1) j hij hj.le)
      (Vertex.ofChart n (i + 1) (j + 1) (Nat.succ_le_succ hij.le) hj)
      (Vertex.ofChart n i (j + 1) (by omega) hj) := by
  convert (isRhombus_ofYZ_step (n := n) (y := i) (z := n - j - 1) (by omega)).rotate.swap_opposite
    using 1 <;> (ext <;> simp <;> omega)

/-- Second product-chart unit-rhombus family (`0 ≤ i < j < n`, long diagonal along `z`), with
obtuse corners `(i + 1, j)` and `(i + 1, j + 1)` and acute corners `(i, j)` and
`(i + 2, j + 1)`. -/
theorem isRhombus_ofChart_diag_z {n i j : ℕ} (hij : i < j) (hj : j < n) :
    IsRhombus (Vertex.ofChart n (i + 1) j hij hj.le)
      (Vertex.ofChart n i j hij.le hj.le)
      (Vertex.ofChart n (i + 1) (j + 1) (Nat.succ_le_succ hij.le) hj)
      (Vertex.ofChart n (i + 2) (j + 1) (Nat.succ_le_succ hij) hj) := by
  convert (isRhombus_ofYZ_step (n := n) (y := n - j - 1) (z := j - i - 1)
    (by omega)).rotate.rotate.reverse using 1 <;> (ext <;> simp <;> omega)

/-- Third product-chart unit-rhombus family (`0 ≤ i ≤ j`, `j + 2 ≤ n`, long diagonal along `x`),
with obtuse corners `(i, j + 1)` and `(i + 1, j + 1)` and acute corners `(i, j)` and
`(i + 1, j + 2)`. -/
theorem isRhombus_ofChart_diag_x {n i j : ℕ} (hij : i ≤ j) (hj : j + 2 ≤ n) :
    IsRhombus (Vertex.ofChart n i (j + 1) (by omega) (by omega))
      (Vertex.ofChart n i j hij (by omega))
      (Vertex.ofChart n (i + 1) (j + 1) (Nat.succ_le_succ hij) (by omega))
      (Vertex.ofChart n (i + 1) (j + 2) (by omega) hj) := by
  convert isRhombus_ofYZ_step (n := n) (y := j - i) (z := i) (by omega)
    using 1 <;> (ext <;> simp <;> omega)

/-- **Product-chart elimination for `IsRhombus`**: every unit rhombus in `Δₙ` belongs to one of the
three product-chart families (`isRhombus_ofChart_diag_y`, `isRhombus_ofChart_diag_z`,
`isRhombus_ofChart_diag_x`) up to swapping its obtuse corners `(a, c)` and swapping its acute
corners `(b, d)`. -/
theorem IsRhombus.elim_ofChart {n : ℕ} {P : Vertex n → Vertex n → Vertex n → Vertex n → Prop}
    (hsym_obtuse : ∀ {a b c d}, P a b c d → P c b a d)
    (hsym_acute : ∀ {a b c d}, P a b c d → P a d c b)
    (hy : ∀ i j (hij : i < j) (hj : j < n),
      P (Vertex.ofChart n i j hij.le hj.le)
        (Vertex.ofChart n (i + 1) j hij hj.le)
        (Vertex.ofChart n (i + 1) (j + 1) (Nat.succ_le_succ hij.le) hj)
        (Vertex.ofChart n i (j + 1) (by omega) hj))
    (hz : ∀ i j (hij : i < j) (hj : j < n),
      P (Vertex.ofChart n (i + 1) j hij hj.le)
        (Vertex.ofChart n i j hij.le hj.le)
        (Vertex.ofChart n (i + 1) (j + 1) (Nat.succ_le_succ hij.le) hj)
        (Vertex.ofChart n (i + 2) (j + 1) (Nat.succ_le_succ hij) hj))
    (hx : ∀ i j (hij : i ≤ j) (hj : j + 2 ≤ n),
      P (Vertex.ofChart n i (j + 1) (by omega) (by omega))
        (Vertex.ofChart n i j hij (by omega))
        (Vertex.ofChart n (i + 1) (j + 1) (Nat.succ_le_succ hij) (by omega))
        (Vertex.ofChart n (i + 1) (j + 2) (by omega) hj))
    {a b c d : Vertex n} (hr : IsRhombus a b c d) : P a b c d := by
  have hmatch {a b b' c d d' a' c' : Vertex n} (hr : IsRhombus a b c d)
      (hb : b = b') (hd : d = d') (hr' : IsRhombus a' b' c' d') (hp : P a' b' c' d') :
      P a b c d := by
    subst hb; subst hd
    rcases hr'.obtuse_eq_or_eq hr with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hp
    · exact hsym_obtuse hp
  have hpos {a b c d : Vertex n} (hr : IsRhombus a b c d)
      (hcase : ((d.x : ℤ) - b.x = -1 ∧ (d.y : ℤ) - b.y = 2 ∧ (d.z : ℤ) - b.z = -1) ∨
        ((d.x : ℤ) - b.x = -1 ∧ (d.y : ℤ) - b.y = -1 ∧ (d.z : ℤ) - b.z = 2) ∨
        ((d.x : ℤ) - b.x = -2 ∧ (d.y : ℤ) - b.y = 1 ∧ (d.z : ℤ) - b.z = 1)) :
      P a b c d := by
    have := b.sum_eq; have := d.sum_eq
    rcases hcase with ⟨_, _, _⟩ | ⟨_, _, _⟩ | ⟨_, _, _⟩
    · have hij : b.z - 1 < n - b.x := by omega
      have hj : n - b.x < n := by omega
      exact hmatch hr (Vertex.eq_ofChart_of_z_x (by omega) (by omega))
        (Vertex.eq_ofChart_of_z_x (by omega) (by omega))
        (isRhombus_ofChart_diag_y hij hj) (hy (b.z - 1) (n - b.x) hij hj)
    · have hij : b.z < n - b.x := by omega
      have hj : n - b.x < n := by omega
      exact hmatch hr (Vertex.eq_ofChart_of_z_x rfl (by omega))
        (Vertex.eq_ofChart_of_z_x (by omega) (by omega))
        (isRhombus_ofChart_diag_z hij hj) (hz b.z (n - b.x) hij hj)
    · have hij : b.z ≤ n - b.x := by omega
      have hj : n - b.x + 2 ≤ n := by omega
      exact hmatch hr (Vertex.eq_ofChart_of_z_x rfl (by omega))
        (Vertex.eq_ofChart_of_z_x (by omega) (by omega))
        (isRhombus_ofChart_diag_x hij hj) (hx b.z (n - b.x) hij hj)
  rcases (Vertex.sqDist_eq_six_iff b d).mp hr.long with
    ⟨hx', hy', hz'⟩ | ⟨_, _, _⟩ | ⟨hx', hy', hz'⟩ | ⟨_, _, _⟩ | ⟨hx', hy', hz'⟩ | ⟨_, _, _⟩
  · exact hpos hr (Or.inl ⟨hx', hy', hz'⟩)
  · exact hsym_acute (hpos hr.reverse (Or.inl ⟨by omega, by omega, by omega⟩))
  · exact hpos hr (Or.inr (Or.inl ⟨hx', hy', hz'⟩))
  · exact hsym_acute (hpos hr.reverse (Or.inr (Or.inl ⟨by omega, by omega, by omega⟩)))
  · exact hpos hr (Or.inr (Or.inr ⟨hx', hy', hz'⟩))
  · exact hsym_acute (hpos hr.reverse (Or.inr (Or.inr ⟨by omega, by omega, by omega⟩)))

/-- A vector `v : Fin 3 → ℤ` is a **unit lattice edge step** if `∑ vᵢ = 0` and `∑ vᵢ² = 2`. -/
def IsUnitStep (v : Fin 3 → ℤ) : Prop := (∑ i, v i) = 0 ∧ (∑ i, v i ^ 2) = 2

theorem isUnitStep_iff {v : Fin 3 → ℤ} :
    IsUnitStep v ↔ (∑ i, v i) = 0 ∧ (∑ i, v i ^ 2) = 2 := Iff.rfl

/-- Vertex `q` is obtained from `p` by translating along `v : Fin 3 → ℤ` in barycentric coords. -/
def HasStep {n : ℕ} (p q : Vertex n) (v : Fin 3 → ℤ) : Prop :=
  ∀ i, (q.coord i : ℤ) = (p.coord i : ℤ) + v i

theorem hasStep_iff {n : ℕ} {p q : Vertex n} {v : Fin 3 → ℤ} :
    HasStep p q v ↔ ∀ i, (q.coord i : ℤ) = (p.coord i : ℤ) + v i := Iff.rfl

/-- Translating along `v` gives barycentric squared distance `∑ i, v i ^ 2`. -/
theorem sqDist_of_hasStep {n : ℕ} {p q : Vertex n} {v : Fin 3 → ℤ} (h : HasStep p q v) :
    p.sqDist q = ∑ i, v i ^ 2 := by
  have h0 := h 0; have h1 := h 1; have h2 := h 2
  simp only [Vertex.coord_zero, Vertex.coord_one, Vertex.coord_two] at h0 h1 h2
  rw [Vertex.sqDist_def, Fin.sum_univ_three, h0, h1, h2]; ring

/-- Four lattice points `p`, `pv = p + v`, `pw = p + w`, `pvw = p + v + w` generated by two unit
steps `v, w` form a unit rhombus `(pv, p, pw, pvw)` iff `∑ i, v i * w i = 1`. -/
theorem isRhombus_of_hasStep_iff {n : ℕ} {p pv pw pvw : Vertex n} {v w : Fin 3 → ℤ}
    (hv : IsUnitStep v) (hw : IsUnitStep w)
    (hpv : HasStep p pv v) (hpw : HasStep p pw w) (hpvw : HasStep p pvw (v + w)) :
    IsRhombus pv p pw pvw ↔ (∑ i, v i * w i) = 1 := by
  have hpv0 := hpv 0; have hpv1 := hpv 1; have hpv2 := hpv 2
  have hpw0 := hpw 0; have hpw1 := hpw 1; have hpw2 := hpw 2
  have hpvw0 := hpvw 0; have hpvw1 := hpvw 1; have hpvw2 := hpvw 2
  simp only [Vertex.coord_zero, Vertex.coord_one, Vertex.coord_two, Pi.add_apply]
    at hpv0 hpv1 hpv2 hpw0 hpw1 hpw2 hpvw0 hpvw1 hpvw2
  have hv2 : v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 = 2 := by simpa [Fin.sum_univ_three] using hv.2
  have hw2 : w 0 ^ 2 + w 1 ^ 2 + w 2 ^ 2 = 2 := by simpa [Fin.sum_univ_three] using hw.2
  have hshort : pv.sqDist pw = 4 - 2 * (v 0 * w 0 + v 1 * w 1 + v 2 * w 2) := by
    rw [Vertex.sqDist_def, hpv0, hpv1, hpv2, hpw0, hpw1, hpw2]; linear_combination hv2 + hw2
  have hlong : p.sqDist pvw = 4 + 2 * (v 0 * w 0 + v 1 * w 1 + v 2 * w 2) := by
    rw [Vertex.sqDist_def, hpvw0, hpvw1, hpvw2]; linear_combination hv2 + hw2
  refine ⟨fun hr => ?_, fun hdot => ?_⟩
  · have hs := hr.short; rw [hshort] at hs
    simpa [Fin.sum_univ_three] using (by omega : v 0 * w 0 + v 1 * w 1 + v 2 * w 2 = 1)
  · have hdot' : v 0 * w 0 + v 1 * w 1 + v 2 * w 2 = 1 := by simpa [Fin.sum_univ_three] using hdot
    have hs1 : HasStep pw pvw v := fun i => by fin_cases i <;> simp <;> omega
    have hs2 : HasStep pv pvw w := fun i => by fin_cases i <;> simp <;> omega
    exact ⟨by omega, by omega, by omega, by omega, by omega,
      by rw [Vertex.sqDist_comm, sqDist_of_hasStep hpv]; exact hv.2,
      by rw [sqDist_of_hasStep hpw]; exact hw.2,
      by rw [sqDist_of_hasStep hs1]; exact hv.2,
      by rw [Vertex.sqDist_comm, sqDist_of_hasStep hs2]; exact hw.2⟩

end TauCeti.Hive
