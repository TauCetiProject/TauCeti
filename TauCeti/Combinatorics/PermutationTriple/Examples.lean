import Mathlib.Tactic.Linarith

/-!
# Examples of permutation triples

This file names the small permutation triples that serve as test cases for the theory of
three-point covers, and computes their invariants: connectedness, cycle data, Euler
characteristic, genus, orders, geometry type, monodromy group and automorphism group.

* `TauCeti.PermutationTriple.cyclicTriple n`: for `n ≠ 0`, the monodromy of `z ↦ zⁿ`, totally
  ramified over `0` and `∞` and unramified over `1`. For `n ≠ 0` it is connected of genus zero,
  with cyclic monodromy of order `n`, hence regular; it is spherical in every degree.
  `cyclicTriple 0` is the formal empty triple, which is not connected, and `cyclicTriple 1` is
  the trivial triple, the identity cover of the sphere. Disjoint sums of two such triples are
  disconnected, with Euler characteristic `4`, and relabeling `cyclicTriple 4` gives a different
  but isomorphic triple.
* `TauCeti.PermutationTriple.chebyshevTriple`: the monodromy of `z ↦ 4z(1 - z)`, a connected
  genus-zero triple whose component over `0` is the identity. Being unramified over a point is
  allowed.
* `TauCeti.PermutationTriple.torusTriple`: a degree-four triple with cycle data `[4], [4], [2, 2]`.
  It is connected of genus one and Euclidean; its automorphism group equals its cyclic monodromy
  group of order four, so it is regular; and `{0, 2}` is a nontrivial block, so its
  monodromy action is imprimitive. Its quotient by this block is the degree-two triple unramified
  over `∞`.
* `TauCeti.PermutationTriple.s3Triple`: a degree-three genus-zero triple whose monodromy group is
  the whole symmetric group and whose automorphism group is trivial, so it is not regular.

## References

* S. K. Lando, A. K. Zvonkin, *Graphs on Surfaces and Their Applications*, Encyclopaedia of
  Mathematical Sciences 141, Springer 2004, §1.1 and §1.5.
* E. Girondo, G. González-Diez, *Introduction to Compact Riemann Surfaces and Dessins d'Enfants*,
  London Mathematical Society Student Texts 79, Cambridge University Press 2012, §4.
-/

public section

namespace TauCeti

open Equiv Equiv.Perm MulAction

open scoped Pointwise

namespace PermutationTriple

variable {m n : ℕ}

/-! ### The cyclic triple -/

/-- The cyclic triple of degree `n`: the sheets are rotated cyclically around `0` and in the
opposite direction around `∞`, and are not permuted around `1`. For `n ≠ 0` it is the monodromy
triple of the cover `z ↦ zⁿ` of the sphere; `cyclicTriple 0` is the formal empty triple. -/
def cyclicTriple (n : ℕ) : PermutationTriple n where
  σ0 := finRotate n
  σ1 := 1
  σinf := (finRotate n)⁻¹
  product_eq_one := by group

@[simp] theorem cyclicTriple_σ0 : (cyclicTriple n).σ0 = finRotate n := (rfl)

@[simp] theorem cyclicTriple_σ1 : (cyclicTriple n).σ1 = 1 := (rfl)

@[simp] theorem cyclicTriple_σinf : (cyclicTriple n).σinf = (finRotate n)⁻¹ := (rfl)

/-- The cyclic triple of degree one is the trivial triple. -/
@[simp] theorem cyclicTriple_one : cyclicTriple 1 = 1 :=
  Subsingleton.elim _ _

/-- The monodromy group of the cyclic triple is generated by cyclic rotation. -/
theorem monodromyGroup_cyclicTriple :
    (cyclicTriple n).monodromyGroup = Subgroup.zpowers (finRotate n) := by
  rw [← closure_pair_eq_monodromyGroup, cyclicTriple_σ0, cyclicTriple_σ1, Set.pair_comm,
    Subgroup.closure_insert_one, Subgroup.zpowers_eq_closure]

/-- The monodromy group of the cyclic triple of degree `n ≠ 0` has order `n`. -/
theorem card_monodromyGroup_cyclicTriple (hn : n ≠ 0) :
    Nat.card (cyclicTriple n).monodromyGroup = n := by
  rw [monodromyGroup_cyclicTriple, Nat.card_zpowers, orderOf_finRotate hn]

/-- The cyclic triple is connected exactly when it has at least one sheet. -/
@[simp] theorem isConnected_cyclicTriple_iff : (cyclicTriple n).IsConnected ↔ n ≠ 0 :=
  ⟨IsConnected.ne_zero, fun hn =>
    isConnected_iff.mpr ⟨hn, isPretransitive_of_finRotate_mem (σ0_mem_monodromyGroup _)⟩⟩

/-- The cyclic triple of degree `n ≠ 0` is regular: its monodromy group has order `n`. -/
theorem isRegular_cyclicTriple (hn : n ≠ 0) : (cyclicTriple n).IsRegular :=
  isRegular_iff_card_monodromyGroup.mpr
    ⟨isConnected_cyclicTriple_iff.mpr hn, card_monodromyGroup_cyclicTriple hn⟩

/-- The cyclic triple is totally ramified over `0` and `∞` and unramified over `1`. -/
theorem cycleData_cyclicTriple (hn : n ≠ 0) :
    (cyclicTriple n).cycleData = ({n}, Multiset.replicate n 1, {n}) := by
  simp [Prod.ext_iff, parts_partition_finRotate hn]

/-- The cyclic triple has one cycle over `0` and over `∞`, and `n` fixed points over `1`. -/
theorem cycleCounts_cyclicTriple (hn : n ≠ 0) : (cyclicTriple n).cycleCounts = (1, n, 1) := by
  simp [cycleCounts_eq_card_cycleData, cycleData_cyclicTriple hn]

/-- The cover `z ↦ zⁿ` is a sphere: its Euler characteristic is `2`. -/
theorem eulerChar_cyclicTriple (hn : n ≠ 0) : (cyclicTriple n).eulerChar = 2 := by
  rw [eulerChar_eq_cycleCounts, cycleCounts_cyclicTriple hn]
  push_cast
  ring

/-- The cyclic triple of positive degree has genus zero. -/
theorem genus_cyclicTriple (hn : n ≠ 0) : (cyclicTriple n).genus = 0 := by
  rw [genus_def, eulerChar_cyclicTriple hn]
  norm_num

/-- The orders of the components of the cyclic triple are `(n, 1, n)`. -/
theorem orderTriple_cyclicTriple (hn : n ≠ 0) : (cyclicTriple n).orderTriple = (n, 1, n) := by
  simp [Prod.ext_iff, orderOf_finRotate hn]

/-- The cyclic triple is spherical in every degree, its component over `1` having order one. -/
@[simp] theorem geometryType_cyclicTriple : (cyclicTriple n).geometryType = .spherical := by
  rw [geometryType_eq_spherical_iff, cyclicTriple_σ1, orderOf_one, Nat.cast_one, inv_one]
  have h0 : (0 : ℚ) < (orderOf (cyclicTriple n).σ0 : ℚ)⁻¹ :=
    inv_pos.mpr (Nat.cast_pos.mpr (orderOf_pos _))
  have hinf : (0 : ℚ) < (orderOf (cyclicTriple n).σinf : ℚ)⁻¹ :=
    inv_pos.mpr (Nat.cast_pos.mpr (orderOf_pos _))
  linarith

/-! ### A disconnected triple, and an isomorphic pair -/

/-- The disjoint sum of two cyclic triples of positive degree covers two spheres, so its Euler
characteristic is `4`. -/
theorem eulerChar_disjointSum_cyclicTriple (hm : m ≠ 0) (hn : n ≠ 0) :
    ((cyclicTriple m).disjointSum (cyclicTriple n)).eulerChar = 4 := by
  rw [eulerChar_disjointSum, eulerChar_cyclicTriple hm, eulerChar_cyclicTriple hn]
  norm_num

/-- Relabeling the sheets of `cyclicTriple 4` by a transposition changes the triple. -/
theorem swap_smul_cyclicTriple_four_ne :
    (swap 0 1 : Perm (Fin 4)) • cyclicTriple 4 ≠ cyclicTriple 4 := by
  intro h
  have h0 := congrArg σ0 h
  rw [smul_σ0, cyclicTriple_σ0] at h0
  revert h0
  decide

/-! ### A triple unramified over `0` -/

/-- The monodromy triple of `z ↦ 4z(1 - z)`: the two sheets are exchanged around `1` and `∞` and
not around `0`. -/
def chebyshevTriple : PermutationTriple 2 where
  σ0 := 1
  σ1 := swap 0 1
  σinf := swap 0 1
  product_eq_one := by decide

@[simp] theorem chebyshevTriple_σ0 : chebyshevTriple.σ0 = 1 := (rfl)

@[simp] theorem chebyshevTriple_σ1 : chebyshevTriple.σ1 = swap 0 1 := (rfl)

@[simp] theorem chebyshevTriple_σinf : chebyshevTriple.σinf = swap 0 1 := (rfl)

/-- The triple of `z ↦ 4z(1 - z)` is connected. -/
theorem isConnected_chebyshevTriple : chebyshevTriple.IsConnected := by
  -- On two sheets the rotation is the transposition around `1`, which lies in the monodromy group;
  -- a monodromy group containing the rotation is transitive.
  have hrot : finRotate 2 = chebyshevTriple.σ1 := by decide
  exact isConnected_iff.mpr ⟨two_ne_zero,
    isPretransitive_of_finRotate_mem (hrot ▸ chebyshevTriple.σ1_mem_monodromyGroup)⟩

/-- The triple of `z ↦ 4z(1 - z)` has two unramified sheets over `0`, and one double point over each
of `1` and `∞`. -/
theorem cycleData_chebyshevTriple : chebyshevTriple.cycleData = ({1, 1}, {2}, {2}) := by
  simp only [Prod.ext_iff, cycleData_σ0, cycleData_σ1, cycleData_σinf, chebyshevTriple_σ0,
    chebyshevTriple_σ1, chebyshevTriple_σinf]
  decide

/-- The cover `z ↦ 4z(1 - z)` is a sphere: its Euler characteristic is `2`. -/
theorem eulerChar_chebyshevTriple : chebyshevTriple.eulerChar = 2 := by
  rw [eulerChar_eq_cycleCounts, cycleCounts_eq_card_cycleData, cycleData_chebyshevTriple]
  norm_num

/-- The triple of `z ↦ 4z(1 - z)` has genus zero. -/
theorem genus_chebyshevTriple : chebyshevTriple.genus = 0 := by
  rw [genus_def, eulerChar_chebyshevTriple]
  norm_num

/-- The orders of the components of the triple of `z ↦ 4z(1 - z)` are `(1, 2, 2)`. -/
theorem orderTriple_chebyshevTriple : chebyshevTriple.orderTriple = (1, 2, 2) := by
  rw [orderTriple_eq_lcm_cycleData, cycleData_chebyshevTriple]
  decide

/-! ### The torus triple -/

/-- A degree-four triple of genus one: cyclic rotation around both `0` and `1`, and hence the
square of the inverse rotation around `∞`. -/
def torusTriple : PermutationTriple 4 where
  σ0 := finRotate 4
  σ1 := finRotate 4
  σinf := (finRotate 4 ^ 2)⁻¹
  product_eq_one := by group

@[simp] theorem torusTriple_σ0 : torusTriple.σ0 = finRotate 4 := (rfl)

@[simp] theorem torusTriple_σ1 : torusTriple.σ1 = finRotate 4 := (rfl)

@[simp] theorem torusTriple_σinf : torusTriple.σinf = (finRotate 4 ^ 2)⁻¹ := (rfl)

/-- The monodromy group of the torus triple is generated by cyclic rotation. -/
theorem monodromyGroup_torusTriple :
    torusTriple.monodromyGroup = Subgroup.zpowers (finRotate 4) := by
  rw [← closure_pair_eq_monodromyGroup, torusTriple_σ0, torusTriple_σ1, Set.pair_eq_singleton,
    Subgroup.zpowers_eq_closure]

/-- The monodromy group of the torus triple is cyclic of order four. -/
theorem card_monodromyGroup_torusTriple : Nat.card torusTriple.monodromyGroup = 4 := by
  rw [monodromyGroup_torusTriple, Nat.card_zpowers, orderOf_finRotate four_ne_zero]

/-- The torus triple is connected. -/
theorem isConnected_torusTriple : torusTriple.IsConnected :=
  isConnected_iff.mpr
    ⟨four_ne_zero, isPretransitive_of_finRotate_mem torusTriple.σ0_mem_monodromyGroup⟩

/-- The torus triple is totally ramified over `0` and `1`, and has two double points over `∞`. -/
theorem cycleData_torusTriple : torusTriple.cycleData = ({4}, {4}, {2, 2}) := by
  simp only [Prod.ext_iff, cycleData_σ0, cycleData_σ1, cycleData_σinf, torusTriple_σ0,
    torusTriple_σ1, torusTriple_σinf]
  decide

/-- The torus triple has one cycle over each of `0` and `1`, and two over `∞`. -/
theorem cycleCounts_torusTriple : torusTriple.cycleCounts = (1, 1, 2) := by
  simp [cycleCounts_eq_card_cycleData, cycleData_torusTriple]

/-- The torus triple has Euler characteristic zero. -/
theorem eulerChar_torusTriple : torusTriple.eulerChar = 0 := by
  rw [eulerChar_eq_cycleCounts, cycleCounts_torusTriple]
  norm_num

/-- The torus triple has genus one. -/
theorem genus_torusTriple : torusTriple.genus = 1 := by
  rw [genus_def, eulerChar_torusTriple]
  norm_num

/-- The orders of the components of the torus triple are `(4, 4, 2)`. -/
theorem orderTriple_torusTriple : torusTriple.orderTriple = (4, 4, 2) := by
  rw [orderTriple_eq_lcm_cycleData, cycleData_torusTriple]
  decide

/-- The torus triple is Euclidean: `1/4 + 1/4 + 1/2 = 1`. -/
theorem geometryType_torusTriple : torusTriple.geometryType = .euclidean := by
  have h := orderTriple_torusTriple
  simp only [Prod.ext_iff, orderTriple_σ0, orderTriple_σ1, orderTriple_σinf] at h
  rw [geometryType_eq_euclidean_iff, h.1, h.2.1, h.2.2]
  norm_num

/-- The automorphism group of the torus triple is its whole monodromy group. -/
theorem automorphismGroup_torusTriple :
    torusTriple.automorphismGroup = torusTriple.monodromyGroup := by
  refine (Subgroup.eq_of_le_of_card_ge ?_ ?_).symm
  · rw [monodromyGroup_torusTriple, Subgroup.zpowers_le, mem_automorphismGroup_iff]
    simp
  · rw [card_monodromyGroup_torusTriple]
    exact Nat.le_of_dvd four_pos
      (card_automorphismGroup_dvd isConnected_torusTriple.isPretransitive)

/-- The torus triple is regular: its monodromy group has order equal to the degree `4`. -/
theorem isRegular_torusTriple : torusTriple.IsRegular :=
  isRegular_iff_card_monodromyGroup.mpr ⟨isConnected_torusTriple, card_monodromyGroup_torusTriple⟩

/-- The pair `{0, 2}` is a block for the monodromy action of the torus triple. -/
theorem isBlock_torusTriple : IsBlock torusTriple.monodromyGroup ({0, 2} : Set (Fin 4)) := by
  -- A permutation commuting with the rotation maps its orbit `{0, 2}` under the square of the
  -- rotation to another such orbit; this is checked on the `24` permutations of `Fin 4`.
  have key : ∀ g : Perm (Fin 4), g * finRotate 4 = finRotate 4 * g →
      g • ({0, 2} : Finset (Fin 4)) = {0, 2} ∨ Disjoint (g • ({0, 2} : Finset (Fin 4))) {0, 2} := by
    decide
  rw [isBlock_iff_smul_eq_or_disjoint]
  rintro ⟨g, hg⟩
  rw [monodromyGroup_torusTriple, Subgroup.mem_zpowers_iff] at hg
  obtain ⟨k, rfl⟩ := hg
  have hB : ({0, 2} : Set (Fin 4)) = ((({0, 2} : Finset (Fin 4))) : Set (Fin 4)) := by simp
  simp only [← Set.image_smul, Subgroup.smul_def]
  rw [Set.image_smul, hB, ← Finset.coe_smul_finset, Finset.coe_inj, Finset.disjoint_coe]
  exact key _ (Commute.self_zpow _ k).eq.symm

/-- The monodromy action of the torus triple is imprimitive. -/
theorem not_isPreprimitive_torusTriple : ¬ IsPreprimitive torusTriple.monodromyGroup (Fin 4) := by
  intro h
  rcases h.isTrivialBlock_of_isBlock isBlock_torusTriple with h | h
  · exact absurd (h (Set.mem_insert 0 _) (Set.mem_insert_of_mem 0 rfl)) (by decide)
  · have h1 := Set.eq_univ_iff_forall.mp h 1
    revert h1
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    decide

/-- The block `{0, 2}` of the Euclidean genus-one triple has two translates. -/
theorem card_orbit_torusTriple :
    Nat.card (orbit torusTriple.monodromyGroup ({0, 2} : Set (Fin 4))) = 2 := by
  have h := ncard_mul_eq_of_isBlock isConnected_torusTriple.isPretransitive isBlock_torusTriple
    ⟨0, by simp⟩ (Finite.equivFin (orbit torusTriple.monodromyGroup ({0, 2} : Set (Fin 4))))
  rw [Set.ncard_pair (by decide)] at h
  omega

/-- The quotient of the Euclidean genus-one triple `torusTriple` by its block `{0, 2}`, for any
numbering of the two translates, is the degree-two triple with components `(0 1)`, `(0 1)`, `1`:
the double cover of the sphere branched over `0` and `1` only. -/
theorem blockQuotient_torusTriple
    (e : orbit torusTriple.monodromyGroup ({0, 2} : Set (Fin 4)) ≃ Fin 2) :
    torusTriple.blockQuotient {0, 2} e = ofTwo (swap 0 1) (swap 0 1) := by
  have hperm : ∀ σ : Perm (Fin 2), σ ≠ 1 → σ = swap 0 1 := by decide
  have hB : ({0, 2} : Set (Fin 4)) ∈ orbit torusTriple.monodromyGroup ({0, 2} : Set (Fin 4)) :=
    mem_orbit_self _
  have hrot : finRotate 4 '' ({0, 2} : Set (Fin 4)) ≠ {0, 2} := by
    rw [Set.image_pair]
    intro h
    have : (1 : Fin 4) ∈ ({0, 2} : Set (Fin 4)) := h ▸ by simp [finRotate_apply]
    simp at this
  -- Both generating components move the translate `{0, 2}`, so neither is the identity of
  -- `Perm (Fin 2)`.
  have hne (σ : Perm (Fin 2))
      (hσ : (e.symm (σ (e ⟨_, hB⟩)) : Set (Fin 4)) = finRotate 4 '' {0, 2}) : σ ≠ 1 := by
    rintro rfl
    simp only [Perm.one_apply, symm_apply_apply] at hσ
    exact hrot hσ.symm
  refine ext_of_two ?_ ?_
  · rw [ofTwo_σ0]
    refine hperm _ (hne _ ?_)
    rw [coe_symm_blockQuotient_σ0, symm_apply_apply, torusTriple_σ0]
  · rw [ofTwo_σ1]
    refine hperm _ (hne _ ?_)
    rw [coe_symm_blockQuotient_σ1, symm_apply_apply, torusTriple_σ1]

/-! ### A triple with symmetric monodromy -/

/-- A degree-three triple whose monodromy group is all of `S₃`: a three-cycle around `0` and a
transposition around `1`. -/
def s3Triple : PermutationTriple 3 where
  σ0 := finRotate 3
  σ1 := swap 0 1
  σinf := swap 1 2
  product_eq_one := by decide

@[simp] theorem s3Triple_σ0 : s3Triple.σ0 = finRotate 3 := (rfl)

@[simp] theorem s3Triple_σ1 : s3Triple.σ1 = swap 0 1 := (rfl)

@[simp] theorem s3Triple_σinf : s3Triple.σinf = swap 1 2 := (rfl)

/-- The monodromy group of `s3Triple` is the whole symmetric group. -/
@[simp] theorem monodromyGroup_s3Triple : s3Triple.monodromyGroup = ⊤ := by
  -- `closure_cycle_adjacent_swap` generates everything from a full cycle `σ` and the adjacent
  -- transposition `swap x (σ x)`, so the transposition `swap 0 1` is rewritten into that shape.
  have h1 : (1 : Fin 3) = finRotate 3 0 := by decide
  rw [← closure_pair_eq_monodromyGroup, s3Triple_σ0, s3Triple_σ1, h1]
  exact closure_cycle_adjacent_swap isCycle_finRotate support_finRotate 0

/-- The triple `s3Triple` is connected. -/
theorem isConnected_s3Triple : s3Triple.IsConnected :=
  isConnected_iff.mpr
    ⟨three_ne_zero, isPretransitive_of_finRotate_mem s3Triple.σ0_mem_monodromyGroup⟩

/-- The triple `s3Triple` is totally ramified over `0`, and has one double point and one
unramified sheet over each of `1` and `∞`. -/
theorem cycleData_s3Triple : s3Triple.cycleData = ({3}, {2, 1}, {2, 1}) := by
  simp only [Prod.ext_iff, cycleData_σ0, cycleData_σ1, cycleData_σinf, s3Triple_σ0, s3Triple_σ1,
    s3Triple_σinf]
  decide

/-- The triple `s3Triple` has Euler characteristic `2`. -/
theorem eulerChar_s3Triple : s3Triple.eulerChar = 2 := by
  rw [eulerChar_eq_cycleCounts, cycleCounts_eq_card_cycleData, cycleData_s3Triple]
  norm_num

/-- The triple `s3Triple` has genus zero. -/
theorem genus_s3Triple : s3Triple.genus = 0 := by
  rw [genus_def, eulerChar_s3Triple]
  norm_num

/-- The orders of the components of `s3Triple` are `(3, 2, 2)`. -/
theorem orderTriple_s3Triple : s3Triple.orderTriple = (3, 2, 2) := by
  rw [orderTriple_eq_lcm_cycleData, cycleData_s3Triple]
  decide

/-- The automorphism group of `s3Triple` is trivial. -/
@[simp] theorem automorphismGroup_s3Triple : s3Triple.automorphismGroup = ⊥ := by
  rw [eq_bot_iff]
  intro τ hτ
  rw [mem_automorphismGroup_iff, s3Triple_σ0, s3Triple_σ1] at hτ
  have h : ∀ τ : Perm (Fin 3),
      τ * finRotate 3 * τ⁻¹ = finRotate 3 → τ * swap 0 1 * τ⁻¹ = swap 0 1 → τ = 1 := by
    decide
  exact Subgroup.mem_bot.mpr (h τ hτ.1 hτ.2)

/-- The triple `s3Triple` is not regular: its automorphism group is trivial, of order `1 ≠ 3`. -/
theorem not_isRegular_s3Triple : ¬s3Triple.IsRegular := by
  rw [isRegular_iff_card_automorphismGroup, automorphismGroup_s3Triple,
    Subgroup.card_eq_one.mpr rfl]
  omega

end PermutationTriple

end TauCeti
