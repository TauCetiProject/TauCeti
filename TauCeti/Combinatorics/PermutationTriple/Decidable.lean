module

public import TauCeti.Combinatorics.PermutationTriple.Basic
public import TauCeti.GroupTheory.GroupAction.Orbit.Finset

/-!
# Deciding connectedness of a permutation triple

A permutation triple is connected when its monodromy group, the subgroup of `Equiv.Perm (Fin n)`
generated by its first two components, acts transitively on the `n` sheets. Transitivity of a
subgroup given by generators carries no `Decidable` instance as stated, so this file computes
the monodromy orbit
of each sheet as a finset by closing under the two generators, `Finset.orbitFinset`, and proves
that connectedness is the statement that every such orbit is the whole of `Fin n`. That statement
is a Boolean computation, and it gives the `Decidable` instance for `IsConnected` which every
enumeration of connected triples filters by. The same closure applied to the group itself presents
the monodromy group as a finset of permutations, with its order as the cardinality of that finset.

## Main definitions

* `TauCeti.PermutationTriple.monodromyOrbitFinset`: the monodromy orbit of a sheet, as a finset.
* `TauCeti.PermutationTriple.monodromyFinset`: the monodromy group, as a finset of permutations.

## Main results

* `TauCeti.PermutationTriple.coe_monodromyOrbitFinset`: the finset is the monodromy orbit.
* `TauCeti.PermutationTriple.isConnected_iff_forall_monodromyOrbitFinset_eq_univ`: a triple is
  connected exactly when its degree is nonzero and every sheet's computed orbit is everything.
* the `Decidable` instance for `TauCeti.PermutationTriple.IsConnected`.
* `TauCeti.PermutationTriple.coe_monodromyFinset`,
  `TauCeti.PermutationTriple.card_monodromyFinset`: the finset is the monodromy group, and its
  cardinality is the order of the monodromy group.
-/

public section

namespace TauCeti

namespace PermutationTriple

open Equiv MulAction

variable {n : ℕ} (t : PermutationTriple n)

/-- The two components generating the monodromy group, as a finset. Its coercion to a set is the
generating set of `TauCeti.PermutationTriple.monodromyGroup`, by `Finset.coe_pair`. -/
@[expose] def generators : Finset (Perm (Fin n)) :=
  {t.σ0, t.σ1}

@[simp]
theorem coe_generators : (t.generators : Set (Perm (Fin n))) = {t.σ0, t.σ1} :=
  Finset.coe_pair

theorem closure_generators_eq_monodromyGroup :
    Subgroup.closure (t.generators : Set (Perm (Fin n))) = t.monodromyGroup := by
  rw [coe_generators, closure_pair_eq_monodromyGroup]

/-! ### Monodromy orbits, computed -/

/-- The monodromy orbit of the sheet `i`, as a finset: the closure of `{i}` under the two
generating permutations, computed by `Finset.orbitFinset`. -/
@[expose] def monodromyOrbitFinset (i : Fin n) : Finset (Fin n) :=
  t.generators.orbitFinset i

/-- The computed monodromy orbit of a sheet is its orbit under the monodromy group. -/
@[simp]
theorem coe_monodromyOrbitFinset (i : Fin n) :
    (t.monodromyOrbitFinset i : Set (Fin n)) = orbit t.monodromyGroup i := by
  rw [monodromyOrbitFinset, Finset.coe_orbitFinset, closure_generators_eq_monodromyGroup]

@[simp]
theorem mem_monodromyOrbitFinset {i j : Fin n} :
    j ∈ t.monodromyOrbitFinset i ↔ j ∈ orbit t.monodromyGroup i := by
  rw [← Finset.mem_coe, coe_monodromyOrbitFinset]

/-- A triple is connected exactly when its degree is nonzero and the computed monodromy orbit of
every sheet is the whole of `Fin n`. Both conjuncts are decidable. -/
theorem isConnected_iff_forall_monodromyOrbitFinset_eq_univ :
    t.IsConnected ↔ n ≠ 0 ∧ ∀ i, t.monodromyOrbitFinset i = Finset.univ := by
  rw [isConnected_iff]
  refine and_congr_right fun _ => ?_
  rw [← closure_generators_eq_monodromyGroup]
  exact Finset.isPretransitive_closure_iff_forall_orbitFinset_eq_univ t.generators

/-- Connectedness of a permutation triple is decidable, by computing the monodromy orbits. -/
instance : Decidable t.IsConnected :=
  decidable_of_iff _ (isConnected_iff_forall_monodromyOrbitFinset_eq_univ t).symm

/-! ### The monodromy group, computed -/

/-- The monodromy group of a triple, as a finset of permutations: the closure of `{1}` under
left multiplication by the two generating permutations, computed by `Finset.closureFinset`. -/
@[expose] def monodromyFinset : Finset (Perm (Fin n)) :=
  t.generators.closureFinset

@[simp]
theorem mem_monodromyFinset {g : Perm (Fin n)} : g ∈ t.monodromyFinset ↔ g ∈ t.monodromyGroup := by
  rw [monodromyFinset, Finset.mem_closureFinset, closure_generators_eq_monodromyGroup]

/-- The computed finset of permutations is the monodromy group. -/
@[simp]
theorem coe_monodromyFinset : (t.monodromyFinset : Set (Perm (Fin n))) = t.monodromyGroup := by
  rw [monodromyFinset, Finset.coe_closureFinset, closure_generators_eq_monodromyGroup]

/-- The order of the monodromy group is the cardinality of the computed finset. -/
@[simp]
theorem card_monodromyFinset : t.monodromyFinset.card = Nat.card t.monodromyGroup := by
  rw [monodromyFinset, Finset.card_closureFinset, closure_generators_eq_monodromyGroup]

end PermutationTriple

end TauCeti
