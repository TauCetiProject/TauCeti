module

public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.GroupTheory.GroupAction.Quotient
public import Mathlib.GroupTheory.Perm.Fin
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Permutation triples

A *permutation triple* of degree `n` is a triple `(σ0, σ1, σinf)` of permutations of `Fin n`
subject to `σinf * σ1 * σ0 = 1`. Such triples are the combinatorial shadow of a covering of the
sphere branched over three points: `σ0`, `σ1` and `σinf` are the monodromy permutations of the
`n` sheets around the three branch points, and the relation records that the three loops
compose to a nullhomotopic loop. They are the three-point case of Lando–Zvonkin's
constellations, and the same data as a hypermap or a bipartite ribbon graph.

This file sets up the carrier and the symmetry attached to it.

* `TauCeti.PermutationTriple`: the carrier, with `TauCeti.PermutationTriple.ofTwo` building a
  triple from its first two components — the third is determined — and
  `TauCeti.PermutationTriple.equivPair` recording that this is a bijection.
* `TauCeti.PermutationTriple.equivOppositeConvention`: componentwise inversion is a bijection
  onto the triples of the opposite composition convention `σ0 * σ1 * σinf = 1`. Sources differ
  on which of the two relations they impose, and this is the translation between them.
* the simultaneous conjugation `MulAction` of `Equiv.Perm (Fin n)`: relabeling the `n` sheets.
  Two triples are *isomorphic* when they lie in one orbit, that is, when they are related by
  `MulAction.orbitRel`.
* `TauCeti.PermutationTriple.monodromyGroup`: the subgroup generated by the components.
* `TauCeti.PermutationTriple.IsConnected`: the monodromy group is transitive on the sheets, and
  there is at least one sheet. The degree hypothesis is part of the definition, since
  transitivity is vacuous on `Fin 0`.
* `TauCeti.PermutationTriple.automorphismGroup`: the stabilizer of a triple under relabeling,
  equivalently the centralizer of its monodromy group. For a connected triple it acts freely on
  the sheets, so its order divides the degree.
* `TauCeti.PermutationTriple.cyclicTriple`: when `n ≠ 0`, the connected triple of `z ↦ z ^ n`,
  whose monodromy group is generated by `finRotate n`.

## Implementation notes

The relation is imposed in the order `σinf * σ1 * σ0 = 1`, so that with Mathlib's convention
`(σ * τ) x = σ (τ x)` the monodromy of a composite loop is the product of the monodromies in the
same order. The reverse convention is common in the literature and in databases of such triples;
`TauCeti.PermutationTriple.equivOppositeConvention` translates between the two, and
`Equiv.Perm.cycleType_inv` says that the translation preserves cycle types.

## References

* S. K. Lando, A. K. Zvonkin, *Graphs on Surfaces and Their Applications*, Encyclopaedia of
  Mathematical Sciences 141, Springer 2004, §1.1 and §1.5 (constellations and hypermaps).
* E. Girondo, G. González-Diez, *Introduction to Compact Riemann Surfaces and Dessins d'Enfants*,
  London Mathematical Society Student Texts 79, Cambridge University Press 2012, §4.

The formal prototype in `TauCetiRoadmap/BelyiMaps/Suggested.lean` was adapted for the declarations
and proof structure in this file.
-/

open Equiv

public section

namespace TauCeti

/-- A permutation triple of degree `n`: three permutations of the `n` sheets, one for each of the
three branch points, whose product in the order `σinf * σ1 * σ0` is the identity. -/
@[ext]
structure PermutationTriple (n : ℕ) where
  /-- The monodromy around the first branch point. -/
  σ0 : Perm (Fin n)
  /-- The monodromy around the second branch point. -/
  σ1 : Perm (Fin n)
  /-- The monodromy around the third branch point. -/
  σinf : Perm (Fin n)
  /-- The three monodromies compose to the identity. -/
  product_eq_one : σinf * σ1 * σ0 = 1

namespace PermutationTriple

variable {n : ℕ}

/-! ### The carrier -/

/-- The triple with prescribed first two components, the third being forced. -/
def ofTwo (σ0 σ1 : Perm (Fin n)) : PermutationTriple n where
  σ0 := σ0
  σ1 := σ1
  σinf := (σ1 * σ0)⁻¹
  product_eq_one := by group

@[simp] theorem ofTwo_σ0 (σ0 σ1 : Perm (Fin n)) : (ofTwo σ0 σ1).σ0 = σ0 := (rfl)

@[simp] theorem ofTwo_σ1 (σ0 σ1 : Perm (Fin n)) : (ofTwo σ0 σ1).σ1 = σ1 := (rfl)

@[simp] theorem ofTwo_σinf (σ0 σ1 : Perm (Fin n)) : (ofTwo σ0 σ1).σinf = (σ1 * σ0)⁻¹ := (rfl)

variable (t : PermutationTriple n)

/-- The third component of a triple is determined by the first two. -/
theorem σinf_eq_inv : t.σinf = (t.σ1 * t.σ0)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← mul_assoc, t.product_eq_one])

theorem σinf_eq_inv_mul_inv : t.σinf = t.σ0⁻¹ * t.σ1⁻¹ := by
  rw [t.σinf_eq_inv, mul_inv_rev]

theorem σ1_mul_σ0_eq_σinf_inv : t.σ1 * t.σ0 = t.σinf⁻¹ := by
  rw [t.σinf_eq_inv, inv_inv]

/-- The defining relation, rotated: the three components may be cycled, though not permuted
arbitrarily. -/
theorem σ0_mul_σinf_mul_σ1_eq_one : t.σ0 * t.σinf * t.σ1 = 1 := by
  rw [t.σinf_eq_inv]; group

/-- The defining relation, rotated the other way. -/
theorem σ1_mul_σ0_mul_σinf_eq_one : t.σ1 * t.σ0 * t.σinf = 1 := by
  rw [t.σinf_eq_inv]; group

variable {t}

/-- Two triples agreeing in their first two components are equal. -/
theorem ext_of_two {t t' : PermutationTriple n} (h0 : t.σ0 = t'.σ0) (h1 : t.σ1 = t'.σ1) :
    t = t' := by
  ext1
  · exact h0
  · exact h1
  · rw [t.σinf_eq_inv, t'.σinf_eq_inv, h0, h1]

/-- A permutation triple is the same thing as a pair of permutations. -/
def equivPair (n : ℕ) : PermutationTriple n ≃ Perm (Fin n) × Perm (Fin n) where
  toFun t := (t.σ0, t.σ1)
  invFun p := ofTwo p.1 p.2
  left_inv _ := ext_of_two rfl rfl
  right_inv _ := rfl

@[simp] theorem equivPair_apply (t : PermutationTriple n) :
    equivPair n t = (t.σ0, t.σ1) := (rfl)

@[simp] theorem equivPair_symm_apply (p : Perm (Fin n) × Perm (Fin n)) :
    (equivPair n).symm p = ofTwo p.1 p.2 := (rfl)

/-- Transport a permutation triple along an equivalence of its sheet labels. -/
def transport {m : ℕ} (e : Fin n ≃ Fin m) : PermutationTriple n ≃ PermutationTriple m where
  toFun t :=
    { σ0 := e.permCongrHom t.σ0
      σ1 := e.permCongrHom t.σ1
      σinf := e.permCongrHom t.σinf
      product_eq_one := by rw [← map_mul, ← map_mul, t.product_eq_one, map_one] }
  invFun t :=
    { σ0 := e.permCongrHom.symm t.σ0
      σ1 := e.permCongrHom.symm t.σ1
      σinf := e.permCongrHom.symm t.σinf
      product_eq_one := by rw [← map_mul, ← map_mul, t.product_eq_one, map_one] }
  left_inv t := by ext1 <;> exact e.permCongrHom.symm_apply_apply _
  right_inv t := by ext1 <;> exact e.permCongrHom.apply_symm_apply _

@[simp] theorem transport_apply_σ0 {m : ℕ} (e : Fin n ≃ Fin m) (t : PermutationTriple n) :
    (transport e t).σ0 = e.permCongrHom t.σ0 := (rfl)

@[simp] theorem transport_apply_σ1 {m : ℕ} (e : Fin n ≃ Fin m) (t : PermutationTriple n) :
    (transport e t).σ1 = e.permCongrHom t.σ1 := (rfl)

@[simp] theorem transport_apply_σinf {m : ℕ} (e : Fin n ≃ Fin m) (t : PermutationTriple n) :
    (transport e t).σinf = e.permCongrHom t.σinf := (rfl)

instance : Fintype (PermutationTriple n) := Fintype.ofEquiv _ (equivPair n).symm

instance : DecidableEq (PermutationTriple n) := (equivPair n).decidableEq

/-- The trivial triple, with all three monodromies the identity: the `n`-sheeted trivial cover. -/
instance : One (PermutationTriple n) := ⟨⟨1, 1, 1, by group⟩⟩

@[simp] theorem one_σ0 : (1 : PermutationTriple n).σ0 = 1 := rfl

@[simp] theorem one_σ1 : (1 : PermutationTriple n).σ1 = 1 := rfl

@[simp] theorem one_σinf : (1 : PermutationTriple n).σinf = 1 := rfl

instance : Inhabited (PermutationTriple n) := ⟨1⟩

/-- In degrees `0` and `1` there is nothing to choose. -/
instance [Subsingleton (Fin n)] : Subsingleton (PermutationTriple n) :=
  ⟨fun _ _ => ext_of_two (Equiv.ext fun _ => Subsingleton.elim _ _)
    (Equiv.ext fun _ => Subsingleton.elim _ _)⟩

/-- Componentwise inversion is a bijection from the triples of this file onto the triples for the
opposite composition convention `σ0 * σ1 * σinf = 1`, which is the one imposed by sources that
compose permutations from left to right.

It preserves cycle types componentwise, by `Equiv.Perm.cycleType_inv`, and it preserves the
monodromy group, by `TauCeti.PermutationTriple.closure_inv_pair_eq_monodromyGroup`;
connectedness and the automorphism group are read off the monodromy group, by
`TauCeti.PermutationTriple.automorphismGroup_eq_centralizer_monodromyGroup`, so they are
preserved too. -/
def equivOppositeConvention (n : ℕ) : PermutationTriple n ≃
    {p : Perm (Fin n) × Perm (Fin n) × Perm (Fin n) // p.1 * p.2.1 * p.2.2 = 1} where
  toFun t := ⟨(t.σ0⁻¹, t.σ1⁻¹, t.σinf⁻¹), by rw [t.σinf_eq_inv, inv_inv]; group⟩
  invFun p :=
    { σ0 := p.1.1⁻¹
      σ1 := p.1.2.1⁻¹
      σinf := p.1.2.2⁻¹
      product_eq_one := by
        have h : (p.1.1 * p.1.2.1 * p.1.2.2)⁻¹ = 1 := by rw [p.2, inv_one]
        simpa [mul_inv_rev, mul_assoc] using h }
  left_inv t := by ext1 <;> simp
  right_inv p := by ext1; simp

@[simp] theorem equivOppositeConvention_apply_coe :
    (equivOppositeConvention n t).1 = (t.σ0⁻¹, t.σ1⁻¹, t.σinf⁻¹) := (rfl)

/-! ### Relabeling the sheets -/

/-- Relabeling the sheets by `τ` conjugates all three components simultaneously. -/
instance : SMul (Perm (Fin n)) (PermutationTriple n) where
  smul τ t :=
    { σ0 := MulAut.conj τ t.σ0
      σ1 := MulAut.conj τ t.σ1
      σinf := MulAut.conj τ t.σinf
      product_eq_one := by rw [← map_mul, ← map_mul, t.product_eq_one, map_one] }

@[simp] theorem smul_σ0 (τ : Perm (Fin n)) (t : PermutationTriple n) :
    (τ • t).σ0 = τ * t.σ0 * τ⁻¹ := rfl

@[simp] theorem smul_σ1 (τ : Perm (Fin n)) (t : PermutationTriple n) :
    (τ • t).σ1 = τ * t.σ1 * τ⁻¹ := rfl

@[simp] theorem smul_σinf (τ : Perm (Fin n)) (t : PermutationTriple n) :
    (τ • t).σinf = τ * t.σinf * τ⁻¹ := rfl

instance : MulAction (Perm (Fin n)) (PermutationTriple n) where
  one_smul t := by ext1 <;> simp
  mul_smul τ υ t := by ext1 <;> simp [mul_assoc]

/-- Relabeling commutes with constructing a triple from its first two components. -/
@[simp] theorem smul_ofTwo (τ σ0 σ1 : Perm (Fin n)) :
    τ • ofTwo σ0 σ1 = ofTwo (τ * σ0 * τ⁻¹) (τ * σ1 * τ⁻¹) :=
  ext_of_two rfl rfl

/-- Relabel a triple satisfying the opposite composition convention. -/
def relabelOppositeConvention (τ : Perm (Fin n))
    (p : {q : Perm (Fin n) × Perm (Fin n) × Perm (Fin n) // q.1 * q.2.1 * q.2.2 = 1}) :
    {q : Perm (Fin n) × Perm (Fin n) × Perm (Fin n) // q.1 * q.2.1 * q.2.2 = 1} :=
  ⟨(τ * p.1.1 * τ⁻¹, τ * p.1.2.1 * τ⁻¹, τ * p.1.2.2 * τ⁻¹), by
    dsimp only
    calc
      _ = τ * (p.1.1 * p.1.2.1 * p.1.2.2) * τ⁻¹ := by group
      _ = 1 := by rw [p.2]; simp⟩

/-- The opposite-convention equivalence commutes with relabeling the sheets. -/
@[simp] theorem equivOppositeConvention_smul (τ : Perm (Fin n)) (t : PermutationTriple n) :
    equivOppositeConvention n (τ • t) =
      relabelOppositeConvention τ (equivOppositeConvention n t) := by
  ext <;> simp [relabelOppositeConvention, mul_assoc]

/-- Isomorphism of permutation triples is simultaneous conjugacy. -/
def Equivalent (t t' : PermutationTriple n) : Prop :=
  MulAction.orbitRel (Perm (Fin n)) (PermutationTriple n) t t'

/-- Isomorphism of triples — relabeling the sheets — is decidable, by searching the finitely many
relabelings. -/
instance : DecidableRel (@Equivalent n) :=
  fun t t' => decidable_of_iff (∃ τ : Perm (Fin n), τ • t' = t)
    (by simpa [Equivalent] using
      (MulAction.mem_orbit_iff.symm.trans MulAction.orbitRel_apply.symm :
        (∃ τ : Perm (Fin n), τ • t' = t) ↔
          MulAction.orbitRel (Perm (Fin n)) (PermutationTriple n) t t'))

/-- Isomorphism classes of degree-`n` permutation triples. -/
def IsoClass (n : ℕ) : Type :=
  MulAction.orbitRel.Quotient (Perm (Fin n)) (PermutationTriple n)

/-! ### The monodromy group -/

/-- The monodromy group of a triple: the subgroup of permutations of the sheets generated by the
components. The third component is redundant, by
`TauCeti.PermutationTriple.closure_triple_eq_monodromyGroup`. -/
def monodromyGroup (t : PermutationTriple n) : Subgroup (Perm (Fin n)) :=
  Subgroup.closure {t.σ0, t.σ1}

variable (t)

@[simp] theorem σ0_mem_monodromyGroup : t.σ0 ∈ t.monodromyGroup :=
  Subgroup.subset_closure (by simp)

@[simp] theorem σ1_mem_monodromyGroup : t.σ1 ∈ t.monodromyGroup :=
  Subgroup.subset_closure (by simp)

@[simp] theorem σinf_mem_monodromyGroup : t.σinf ∈ t.monodromyGroup := by
  rw [t.σinf_eq_inv]
  exact inv_mem (mul_mem t.σ1_mem_monodromyGroup t.σ0_mem_monodromyGroup)

/-- The subgroup generated by all three components equals the monodromy group. -/
theorem closure_triple_eq_monodromyGroup :
    Subgroup.closure {t.σ0, t.σ1, t.σinf} = t.monodromyGroup :=
  le_antisymm (Subgroup.closure_le _ |>.mpr (by
    rintro x (rfl | rfl | rfl) <;> simp))
    (Subgroup.closure_mono (by intro x hx; simp only [Set.mem_insert_iff] at hx ⊢; tauto))

variable {t}

/-- The two generators may be replaced by their inverses: this is the invariance of the monodromy
group under the translation `TauCeti.PermutationTriple.equivOppositeConvention` of conventions. -/
theorem closure_inv_pair_eq_monodromyGroup :
    Subgroup.closure {t.σ0⁻¹, t.σ1⁻¹} = t.monodromyGroup := by
  rw [monodromyGroup, ← Subgroup.closure_inv ({t.σ0, t.σ1} : Set (Perm (Fin n)))]
  simp

/-- Relabeling the sheets conjugates the monodromy group. In particular isomorphic triples have
conjugate monodromy groups. -/
theorem monodromyGroup_smul (τ : Perm (Fin n)) (t : PermutationTriple n) :
    (τ • t).monodromyGroup = t.monodromyGroup.map (MulAut.conj τ).toMonoidHom := by
  rw [monodromyGroup, monodromyGroup, MonoidHom.map_closure]
  congr 1
  simp [Set.image_insert_eq]

/-! ### Connectedness and automorphisms -/

/-- A triple is connected when it has at least one sheet and its monodromy group is transitive on
the sheets — the combinatorial form of connectedness of the associated cover. The degree
hypothesis is not redundant: transitivity holds vacuously on `Fin 0`. -/
def IsConnected (t : PermutationTriple n) : Prop :=
  n ≠ 0 ∧ MulAction.IsPretransitive t.monodromyGroup (Fin n)

theorem isConnected_iff :
    t.IsConnected ↔ n ≠ 0 ∧ MulAction.IsPretransitive t.monodromyGroup (Fin n) := Iff.rfl

theorem IsConnected.ne_zero (ht : t.IsConnected) : n ≠ 0 := ht.1

theorem IsConnected.isPretransitive (ht : t.IsConnected) :
    MulAction.IsPretransitive t.monodromyGroup (Fin n) := ht.2

/-- Connectedness only depends on the isomorphism class of a triple. -/
@[simp] theorem isConnected_smul_iff (τ : Perm (Fin n)) (t : PermutationTriple n) :
    (τ • t).IsConnected ↔ t.IsConnected := by
  have key : ∀ (υ : Perm (Fin n)) (s : PermutationTriple n),
      s.IsConnected → (υ • s).IsConnected := by
    refine fun υ s hs => ⟨hs.ne_zero, ⟨fun i j => ?_⟩⟩
    obtain ⟨g, hg⟩ := hs.isPretransitive.exists_smul_eq (υ⁻¹ i) (υ⁻¹ j)
    refine ⟨⟨MulAut.conj υ g, ?_⟩, ?_⟩
    · rw [monodromyGroup_smul]
      exact ⟨g, g.2, rfl⟩
    · simpa [Subgroup.smul_def, Perm.smul_def] using congrArg υ hg
  refine ⟨fun h => ?_, key τ t⟩
  simpa using key τ⁻¹ _ h

/-- Translating to the opposite convention preserves connectedness. -/
theorem isConnected_equivOppositeConvention_iff (t : PermutationTriple n) :
    (n ≠ 0 ∧ MulAction.IsPretransitive
      (Subgroup.closure
        {(equivOppositeConvention n t).1.1, (equivOppositeConvention n t).1.2.1}) (Fin n)) ↔
      t.IsConnected := by
  change (n ≠ 0 ∧ MulAction.IsPretransitive
    (Subgroup.closure {t.σ0⁻¹, t.σ1⁻¹}) (Fin n)) ↔ t.IsConnected
  rw [closure_inv_pair_eq_monodromyGroup, isConnected_iff]

/-- The automorphism group of a triple: the deck transformations of the associated cover, that is,
the relabelings that fix the triple. -/
def automorphismGroup (t : PermutationTriple n) : Subgroup (Perm (Fin n)) :=
  MulAction.stabilizer (Perm (Fin n)) t

theorem mem_automorphismGroup_iff {τ : Perm (Fin n)} :
    τ ∈ t.automorphismGroup ↔ τ * t.σ0 * τ⁻¹ = t.σ0 ∧ τ * t.σ1 * τ⁻¹ = t.σ1 := by
  rw [automorphismGroup, MulAction.mem_stabilizer_iff]
  refine ⟨fun h => ⟨?_, ?_⟩, fun h => ext_of_two ?_ ?_⟩
  · rw [← smul_σ0 τ t, h]
  · rw [← smul_σ1 τ t, h]
  · rw [smul_σ0, h.1]
  · rw [smul_σ1, h.2]

/-- The automorphism group is the simultaneous centralizer of the two generating components. -/
theorem automorphismGroup_eq_centralizer :
    t.automorphismGroup = Subgroup.centralizer {t.σ0, t.σ1} := by
  ext τ
  rw [mem_automorphismGroup_iff, Subgroup.mem_centralizer_iff]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, forall_eq_or_imp, forall_eq,
    mul_inv_eq_iff_eq_mul]
  exact and_congr eq_comm eq_comm

/-- The automorphism group is the centralizer of the monodromy group. Together with
`TauCeti.PermutationTriple.isConnected_iff` this says that a triple enters both notions only
through its monodromy group. -/
theorem automorphismGroup_eq_centralizer_monodromyGroup :
    t.automorphismGroup = Subgroup.centralizer (t.monodromyGroup : Set (Perm (Fin n))) := by
  rw [automorphismGroup_eq_centralizer, monodromyGroup, Subgroup.centralizer_closure]

/-- Relabeling the sheets conjugates the automorphism group. -/
theorem automorphismGroup_smul (τ : Perm (Fin n)) (t : PermutationTriple n) :
    (τ • t).automorphismGroup = t.automorphismGroup.map (MulAut.conj τ).toMonoidHom :=
  MulAction.stabilizer_smul_eq_stabilizer_map_conj τ t

/-- Translating to the opposite convention preserves the automorphism group, represented on the
opposite side as the simultaneous centralizer of its first two components. -/
theorem automorphismGroup_equivOppositeConvention (t : PermutationTriple n) :
    Subgroup.centralizer
      ({(equivOppositeConvention n t).1.1, (equivOppositeConvention n t).1.2.1} :
        Set (Perm (Fin n))) = t.automorphismGroup := by
  change Subgroup.centralizer ({t.σ0⁻¹, t.σ1⁻¹} : Set (Perm (Fin n))) =
    t.automorphismGroup
  calc
    _ = Subgroup.centralizer
        (Subgroup.closure ({t.σ0⁻¹, t.σ1⁻¹} : Set (Perm (Fin n))) :
          Set (Perm (Fin n))) :=
      (Subgroup.centralizer_closure ({t.σ0⁻¹, t.σ1⁻¹} : Set (Perm (Fin n)))).symm
    _ = Subgroup.centralizer (t.monodromyGroup : Set (Perm (Fin n))) := by
      rw [closure_inv_pair_eq_monodromyGroup]
    _ = t.automorphismGroup :=
      (automorphismGroup_eq_centralizer_monodromyGroup (t := t)).symm

/-- An automorphism of a triple with pretransitive monodromy fixing a sheet is the identity. -/
theorem eq_one_of_mem_automorphismGroup_of_apply_eq
    (ht : MulAction.IsPretransitive t.monodromyGroup (Fin n)) {τ : Perm (Fin n)}
    (hτ : τ ∈ t.automorphismGroup) {i : Fin n} (hi : τ i = i) : τ = 1 := by
  have hcomm : ∀ g ∈ t.monodromyGroup, g * τ = τ * g :=
    Subgroup.mem_centralizer_iff.mp
      (automorphismGroup_eq_centralizer_monodromyGroup (t := t) ▸ hτ)
  refine Equiv.ext fun j => ?_
  obtain ⟨g, hg⟩ := ht.exists_smul_eq i j
  have hgj : (g : Perm (Fin n)) i = j := hg
  calc τ j = (τ * (g : Perm (Fin n))) i := by rw [Perm.mul_apply, hgj]
    _ = ((g : Perm (Fin n)) * τ) i := by rw [hcomm _ g.2]
    _ = j := by rw [Perm.mul_apply, hi, hgj]
    _ = (1 : Perm (Fin n)) j := by rw [Perm.one_apply]

/-- The order of the automorphism group divides the degree when the monodromy action is
pretransitive. -/
theorem card_automorphismGroup_dvd
    (ht : MulAction.IsPretransitive t.monodromyGroup (Fin n)) :
    Nat.card t.automorphismGroup ∣ n := by
  have hfree : ∀ i : Fin n, MulAction.stabilizer t.automorphismGroup i = ⊥ := by
    intro i
    refine eq_bot_iff.mpr fun τ hτ => ?_
    rw [Subgroup.mem_bot, Subtype.ext_iff]
    exact eq_one_of_mem_automorphismGroup_of_apply_eq ht τ.2 (i := i) hτ
  have hcard := Nat.card_congr (MulAction.selfEquivOrbitsQuotientProd hfree)
  rw [Nat.card_prod, Nat.card_eq_fintype_card, Fintype.card_fin] at hcard
  exact ⟨_, hcard.trans (mul_comm _ _)⟩

/-! ### The cyclic triple -/

/-- The triple of the `n`-sheeted cover `z ↦ z ^ n`: the sheets are cycled once around `0`,
nothing happens around `1`, and they are cycled back around `∞`. -/
def cyclicTriple (n : ℕ) : PermutationTriple n := ofTwo (finRotate n) 1

@[simp] theorem cyclicTriple_σ0 : (cyclicTriple n).σ0 = finRotate n := (rfl)

@[simp] theorem cyclicTriple_σ1 : (cyclicTriple n).σ1 = 1 := (rfl)

@[simp] theorem cyclicTriple_σinf : (cyclicTriple n).σinf = (finRotate n)⁻¹ := by
  rw [cyclicTriple, ofTwo_σinf, one_mul]

/-- The monodromy group of the cyclic triple is generated by `finRotate n`. -/
theorem monodromyGroup_cyclicTriple :
    (cyclicTriple n).monodromyGroup = Subgroup.zpowers (finRotate n) := by
  rw [monodromyGroup, Subgroup.zpowers_eq_closure, cyclicTriple_σ0, cyclicTriple_σ1,
    Set.pair_comm, Subgroup.closure_insert_one]

/-- The cyclic triple is connected in every nonzero degree. -/
theorem isConnected_cyclicTriple (hn : n ≠ 0) : (cyclicTriple n).IsConnected := by
  refine ⟨hn, ⟨fun i j => ?_⟩⟩
  have hmem : ∀ k : ℤ, finRotate n ^ k ∈ (cyclicTriple n).monodromyGroup := fun k =>
    monodromyGroup_cyclicTriple ▸ Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) k
  match n, i, j with
  | 0, i, _ => exact i.elim0
  | 1, _, _ => exact ⟨1, Subsingleton.elim _ _⟩
  | (m + 2), i, j =>
    have hsupp : ∀ k : Fin (m + 2), finRotate (m + 2) k ≠ k := fun k =>
      Perm.mem_support.mp (by rw [support_finRotate]; exact Finset.mem_univ k)
    obtain ⟨k, hk⟩ := isCycle_finRotate.sameCycle (hsupp i) (hsupp j)
    exact ⟨⟨finRotate (m + 2) ^ k, hmem k⟩, hk⟩

end PermutationTriple

end TauCeti
