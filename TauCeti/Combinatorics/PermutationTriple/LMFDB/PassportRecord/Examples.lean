/-!
# Examples of passport records

Two passport rows are certified: the primitive passport `3T2-3_2.1_2.1` of `s3Triple`, with
trivial automorphism group, and the imprimitive passport `4T1-4_4_2.2` of `torusTriple`, whose
primitivization block `{0, 2}` has two translates and whose automorphism group is generated by the
rotation. In both rows the stored order triple is not sorted, so it differs from the search triple.
The map row `2T1-2_2_1.1-a` certifies the primitivization of the second row: the quotient of
`torusTriple` by the translates of its block is the double cover of the sphere branched over `0`
and `1`.

The stored geometry type is not a function of the stored genus. The triples of the frozen
records `4T4-3.1_3.1_3.1-a` and `4T5-4_4_3.1-a` have genus zero with Euclidean geometry and
genus one with hyperbolic geometry, while `torusTriple` has genus one with Euclidean geometry.

## References

* LMFDB, [Belyi map records of degree at most four](https://www.lmfdb.org/Belyi/?deg=1-4).
-/

open Equiv MulAction
open scoped Pointwise

public section

namespace TauCeti
namespace PermutationTriple
namespace LMFDB

/-! ### The primitive passport `3T2-3_2.1_2.1` -/

/-- The passport row of `s3Triple`. It is primitive, so its primitivization block is a single
sheet, and its automorphism group is trivial, so it needs no generators. The label strings, the
automorphism-group name and the two aggregations are carrier data that validity does not read. -/
@[expose] def s3PassportRecord : PassportRecord 3 where
  plabel := "3T2-3_2.1_2.1"
  deg := 3
  group := 2
  abc := (3, 2, 2)
  sortedAbc := (2, 2, 3)
  lambdas := ({3}, {2, 1}, {2, 1})
  g := 0
  geomtype := .spherical
  passSize := 1
  numOrbits := 1
  maxdegbf := 1
  isPrimitive := true
  primitivization := "3T2-3_2.1_2.1-a"
  primitivizationBlock := {0}
  autGroup := "C1"
  autGroupGenerators := []
  triples := [s3Triple]

/-- The passport row of `s3Triple` is valid for the passport of `s3Triple`. -/
theorem isValidAt_s3PassportRecord :
    s3PassportRecord.IsValidAt ⟨s3Triple, isConnected_s3Triple⟩ where
  deg_eq := rfl
  mem_triples := List.mem_singleton_self _
  hasPassport_of_mem_triples s hs := by
    obtain rfl := List.mem_singleton.mp hs
    exact ⟨isConnected_s3Triple, ConnectedTriple.hasPassport_passportOf _⟩
  lambdas_eq := cycleData_s3Triple.symm
  abc_eq := orderTriple_s3Triple.symm
  sortedAbc_eq := (Multiset.eq_sort_iff _).mpr ⟨by decide, by decide⟩
  g_eq := genus_s3Triple.symm
  geomtype_eq := by
    dsimp only [s3PassportRecord]
    rw [← computedGeometryType_eq]
    decide +kernel
  exists_transitiveGroupLabel := ⟨⟨1, by simp⟩, rfl, by
    rw [monodromyGroup_s3Triple, ← referenceSubgroup_three_one]
    exact transitiveGroupLabel_referenceSubgroup 3 _⟩
  passSize_eq :=
    (ConnectedTriple.passportSize_passportOf_of_degree_le_four (by norm_num) _).symm
  isPrimitive_eq_true_iff := iff_of_true rfl isPrimitive_s3Triple
  isBlock_primitivizationBlock := by
    simp only [s3PassportRecord, Finset.coe_singleton]
    exact IsBlock.of_subsingleton Set.subsingleton_singleton
  primitivizationBlock_nonempty := Finset.singleton_nonempty _
  deg_eq_one_of_primitivizationBlock_eq_univ h := absurd h (by decide)
  eq_or_eq_univ_of_primitivizationBlock_subset C hC hsub := by
    rcases ((isPrimitive_iff _).mp isPrimitive_s3Triple).isTrivialBlock_of_isBlock hC with hC | hC
    · left
      simp only [s3PassportRecord, Finset.coe_singleton] at hsub ⊢
      exact hC.eq_singleton_of_mem (hsub rfl)
    · exact Or.inr hC
  closure_autGroupGenerators := by
    simp [s3PassportRecord]

/-- In the passport row of `s3Triple` the stored order triple `(3, 2, 2)` is not sorted, so it
differs from the search triple `(2, 2, 3)`. -/
theorem s3PassportRecord_abc_ne_sortedAbc :
    s3PassportRecord.abc ≠ s3PassportRecord.sortedAbc := by
  decide

/-! ### The imprimitive passport `4T1-4_4_2.2` -/

/-- The passport row of `torusTriple`. It is imprimitive: the block `{0, 2}` certifies its
primitivization, a double cover of the sphere. Its automorphism group is generated by the
rotation `finRotate 4`. The label strings, the automorphism-group name and the two aggregations
are carrier data that validity does not read. -/
@[expose] def torusPassportRecord : PassportRecord 4 where
  plabel := "4T1-4_4_2.2"
  deg := 4
  group := 1
  abc := (4, 4, 2)
  sortedAbc := (2, 4, 4)
  lambdas := ({4}, {4}, {2, 2})
  g := 1
  geomtype := .euclidean
  passSize := 1
  numOrbits := 1
  maxdegbf := 1
  isPrimitive := false
  primitivization := "2T1-2_2_1.1-a"
  primitivizationBlock := {0, 2}
  autGroup := "C4"
  autGroupGenerators := [finRotate 4]
  triples := [torusTriple]

/-- The passport row of `torusTriple` is valid for the passport of `torusTriple`. -/
theorem isValidAt_torusPassportRecord :
    torusPassportRecord.IsValidAt ⟨torusTriple, isConnected_torusTriple⟩ where
  deg_eq := rfl
  mem_triples := List.mem_singleton_self _
  hasPassport_of_mem_triples s hs := by
    obtain rfl := List.mem_singleton.mp hs
    exact ⟨isConnected_torusTriple, ConnectedTriple.hasPassport_passportOf _⟩
  lambdas_eq := cycleData_torusTriple.symm
  abc_eq := orderTriple_torusTriple.symm
  sortedAbc_eq := (Multiset.eq_sort_iff _).mpr ⟨by decide, by decide⟩
  g_eq := genus_torusTriple.symm
  geomtype_eq := geometryType_torusTriple.symm
  exists_transitiveGroupLabel := ⟨⟨0, by simp⟩, rfl, by
    rw [monodromyGroup_torusTriple, ← referenceSubgroup_index_zero_eq_zpowers]
    exact transitiveGroupLabel_referenceSubgroup 4 _⟩
  passSize_eq := (ConnectedTriple.passportSize_passportOf_of_degree_le_four le_rfl _).symm
  isPrimitive_eq_true_iff := iff_of_false Bool.false_ne_true not_isPrimitive_torusTriple
  isBlock_primitivizationBlock := by
    simp only [torusPassportRecord, Finset.coe_pair]
    exact isBlock_torusTriple
  primitivizationBlock_nonempty := Finset.insert_nonempty _ _
  deg_eq_one_of_primitivizationBlock_eq_univ h := absurd h (by decide)
  eq_or_eq_univ_of_primitivizationBlock_subset C hC hsub := by
    classical
    -- Every subset of the four sheets containing `{0, 2}` is checked against the finite block
    -- test.
    have key : ∀ D : Finset (Fin 4), torusTriple.isBlockBool D = true → {0, 2} ⊆ D →
        D = {0, 2} ∨ D = Finset.univ := by
      decide
    rw [← Set.coe_toFinset C] at hC hsub ⊢
    simp only [torusPassportRecord, Finset.coe_subset] at hsub ⊢
    rcases key C.toFinset ((isBlockBool_eq_true_iff _ _).mpr hC) hsub with h | h
    · exact Or.inl (by rw [h])
    · exact Or.inr (by rw [h, Finset.coe_univ])
  closure_autGroupGenerators := by
    simp only [torusPassportRecord, List.mem_singleton, Set.ofPred_eq_eq_singleton,
      automorphismGroup_torusTriple, monodromyGroup_torusTriple, Subgroup.zpowers_eq_closure]

/-- In the passport row of `torusTriple` the stored order triple `(4, 4, 2)` is not sorted, so it
differs from the search triple `(2, 4, 4)`. -/
theorem torusPassportRecord_abc_ne_sortedAbc :
    torusPassportRecord.abc ≠ torusPassportRecord.sortedAbc := by
  decide

/-! ### Recognizing the group components -/

namespace PassportRecord

/-- The nonabelian degree-three example is displayed as `3T2`, not `3T1`. -/
@[simp] theorem groupString_s3PassportRecord : s3PassportRecord.groupString = "3T2" := by
  decide +kernel

/-- The torus example is displayed as `4T1`, despite its positive genus. -/
@[simp] theorem groupString_torusPassportRecord : torusPassportRecord.groupString = "4T1" := by
  decide +kernel

-- These clients use the parser output as a certificate of the actual monodromy group.
example : TransitiveGroupLabel (⟨1, by simp⟩ : TransitiveGroupIndex 3)
    s3Triple.monodromyGroup :=
  isValidAt_s3PassportRecord.transitiveGroupLabel_of_parse_groupString (by
    rw [parseTransitiveGroupLabel_eq_some_iff, groupString_s3PassportRecord,
      transitiveGroupLabelString_def]
    decide)

example : TransitiveGroupLabel (⟨0, by simp⟩ : TransitiveGroupIndex 4)
    torusTriple.monodromyGroup :=
  isValidAt_torusPassportRecord.transitiveGroupLabel_of_parse_groupString (by
    rw [parseTransitiveGroupLabel_eq_some_iff, groupString_torusPassportRecord,
      transitiveGroupLabelString_def]
    decide)

end PassportRecord

/-! ### The primitivization `2T1-2_2_1.1-a` of `4T1-4_4_2.2` -/

/-- The stored triple of the map row `2T1-2_2_1.1-a`, in the database's convention: the
transposition over `0` and over `1`, and the identity over `∞`. -/
@[expose] def doubleCoverStoredTriple : StoredTriple 2 := ⟨(swap 0 1, swap 0 1, 1), by decide⟩

/-- The map row `2T1-2_2_1.1-a`: the double cover of the sphere branched over `0` and `1`, defined
over `ℚ`, whose base field is stored as the root `1` of `X - 1`. It has no associated curve. The
equations and the labels of related objects are left empty, since validity does not read them. -/
@[expose] def doubleCoverBelyiRecord : BelyiRecord 2 where
  label := "2T1-2_2_1.1-a"
  plabel := "2T1-2_2_1.1"
  deg := 2
  lambdas := ({2}, {2}, {1, 1})
  g := 0
  orbitSize := 1
  baseField := [-1, 1]
  embeddings := [(1, 0)]
  triples := [doubleCoverStoredTriple]
  triplesCyc := [([[0, 1]], [[0, 1]], [])]
  curve := ""
  map := ""
  planeModel := ""
  planeConstant := ""
  curveLabel := none
  friends := []
  storedEmbeddingCount_eq_triplesLength := rfl

/-- The double cover branched over `0` and `1`, in this library's convention. -/
private def doubleCoverTriple : PermutationTriple 2 := ⟨swap 0 1, swap 0 1, 1, by decide⟩

private theorem toTriple_doubleCoverStoredTriple :
    doubleCoverStoredTriple.toTriple = doubleCoverTriple := by
  ext <;> simp [doubleCoverStoredTriple, doubleCoverTriple]

/-- The map row `2T1-2_2_1.1-a` certifies the stored primitivization of the passport row of
`torusTriple`: the quotient of `torusTriple` by the translates `{0, 2}` and `{1, 3}` of the stored
block is the double cover branched over `0` and `1`. -/
theorem isPrimitivizationOf_torusPassportRecord :
    doubleCoverBelyiRecord.IsPrimitivizationOf torusPassportRecord
      ⟨torusTriple, isConnected_torusTriple⟩ := by
  have := isConnected_torusTriple.isPretransitive
  have hBc : (torusPassportRecord.primitivizationBlock : Set (Fin 4)) = {0, 2} := by
    simp [torusPassportRecord]
  have hcard : Nat.card (orbit torusTriple.monodromyGroup
      (torusPassportRecord.primitivizationBlock : Set (Fin 4))) = 2 := by
    have h := (hBc ▸ isBlock_torusTriple).ncard_block_mul_ncard_orbit_eq (by simp [hBc])
    rw [hBc, Set.ncard_pair (by decide), Nat.card_fin] at h
    rw [hBc, Nat.card_coe_set_eq]
    omega
  let e := Finite.equivFinOfCardEq hcard
  refine ⟨rfl, e, ?_⟩
  set Q : ConnectedTriple 2 :=
    ⟨torusTriple.blockQuotient _ e, torusTriple.isConnected_blockQuotient _ e⟩
  -- The quotient is the double cover branched over `0` and `1` computed in
  -- `blockQuotient_torusTriple`, once the stored block is identified with `{0, 2}`.
  have hQ : Q.1.cycleData = ({2}, {2}, {1, 1}) := by
    have key : ∀ (B : Set (Fin 4)) (_ : B = {0, 2})
        (e : orbit torusTriple.monodromyGroup B ≃ Fin 2),
        torusTriple.blockQuotient B e = ofTwo (swap 0 1) (swap 0 1) := by
      rintro _ rfl e
      exact blockQuotient_torusTriple e
    rw [Subtype.coe_mk, key _ hBc e]
    decide
  -- In degree two the cycle data classify connected triples, so the stored triple lies in the
  -- passport of the quotient.
  have hs0 : doubleCoverStoredTriple.toTriple.IsConnected := by
    rw [toTriple_doubleCoverStoredTriple]
    decide
  have hs0Q : PassportSpec.HasPassport ⟨_, hs0⟩ Q.passportOf := by
    refine (PassportSpec.hasPassport_iff_of_equivalent (ConnectedIsoClass.mk_eq_mk_iff.mp
      (ConnectedIsoClass.mk_eq_mk_iff_equivalent.mpr ?_)) _).mpr Q.hasPassport_passportOf
    refine (equivalent_iff_cycleData_eq_of_degree_le_four (by norm_num) ⟨_, hs0⟩ Q).mpr ?_
    rw [hQ, Subtype.coe_mk, toTriple_doubleCoverStoredTriple]
    decide
  exact
    { deg_eq := rfl
      orbitSize_eq := by
        rw [BelyiRecord.storedEmbeddingCount_def]
        rfl
      triples_ne_nil := List.cons_ne_nil _ _
      hasPassport s hs := by
        obtain rfl := List.mem_singleton.mp hs
        exact ⟨hs0, hs0Q⟩
      forall₂_isCycleNotation := .cons ⟨⟨by decide, by decide, by decide⟩,
        ⟨by decide, by decide, by decide⟩, Perm.isCycleNotation_nil_iff.mpr rfl⟩ .nil
      lambdas_eq := by
        rw [ConnectedTriple.passportOf_lam0, ConnectedTriple.passportOf_lam1,
          ConnectedTriple.passportOf_laminf, hQ]
        rfl
      g_eq s hs := by
        obtain rfl := List.mem_singleton.mp hs
        rw [toTriple_doubleCoverStoredTriple, ← computedGenus_eq]
        decide }

/-! ### Geometry type is not a function of genus -/

/-- The triple of the frozen record `4T4-3.1_3.1_3.1-a`, with cycle data
`([3, 1], [3, 1], [3, 1])`. -/
def genusZeroEuclideanTriple : PermutationTriple 4 := ofTwo c[0, 1, 2]⁻¹ c[0, 2, 3]⁻¹

/-- The triple `genusZeroEuclideanTriple` is connected. -/
theorem isConnected_genusZeroEuclideanTriple : genusZeroEuclideanTriple.IsConnected := by
  decide

/-- The triple `genusZeroEuclideanTriple` has genus zero. -/
theorem genus_genusZeroEuclideanTriple : genusZeroEuclideanTriple.genus = 0 := by
  rw [← computedGenus_eq]
  decide

/-- The triple `genusZeroEuclideanTriple` is Euclidean: its orders are `(3, 3, 3)`. -/
theorem geometryType_genusZeroEuclideanTriple :
    genusZeroEuclideanTriple.geometryType = .euclidean := by
  rw [← computedGeometryType_eq]
  decide +kernel

/-- The triple of the frozen record `4T5-4_4_3.1-a`, with cycle data `([4], [4], [3, 1])`. -/
def genusOneHyperbolicTriple : PermutationTriple 4 := ofTwo c[0, 1, 2, 3]⁻¹ c[0, 2, 3, 1]⁻¹

/-- The triple `genusOneHyperbolicTriple` is connected. -/
theorem isConnected_genusOneHyperbolicTriple : genusOneHyperbolicTriple.IsConnected := by
  decide

/-- The triple `genusOneHyperbolicTriple` has genus one. -/
theorem genus_genusOneHyperbolicTriple : genusOneHyperbolicTriple.genus = 1 := by
  rw [← computedGenus_eq]
  decide

/-- The triple `genusOneHyperbolicTriple` is hyperbolic: its orders are `(4, 4, 3)`. -/
theorem geometryType_genusOneHyperbolicTriple :
    genusOneHyperbolicTriple.geometryType = .hyperbolic := by
  rw [← computedGeometryType_eq]
  decide +kernel

/-- No function of the genus computes the geometry type of connected degree-four triples:
`torusTriple` and `genusOneHyperbolicTriple` both have genus one, but the first is Euclidean
and the second hyperbolic. -/
theorem not_exists_geometryType_eq_comp_genus :
    ¬ ∃ f : ℕ → GeometryType, ∀ t : ConnectedTriple 4, t.1.geometryType = f t.1.genus := by
  rintro ⟨f, hf⟩
  have hE := hf ⟨torusTriple, isConnected_torusTriple⟩
  have hH := hf ⟨genusOneHyperbolicTriple, isConnected_genusOneHyperbolicTriple⟩
  rw [geometryType_torusTriple, genus_torusTriple] at hE
  rw [geometryType_genusOneHyperbolicTriple, genus_genusOneHyperbolicTriple, ← hE] at hH
  exact absurd hH (by decide)

