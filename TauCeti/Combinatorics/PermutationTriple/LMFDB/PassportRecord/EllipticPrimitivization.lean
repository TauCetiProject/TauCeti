/-! ### The elliptic passport `3T1-3_3_3` -/

/-- The stored triple of the map row `3T1-3_3_3-a`, in the database's convention: the rotation
`(0 1 2)` over each of `0`, `1` and `∞`. -/
@[expose] def cyclicThreeStoredTriple : StoredTriple 3 :=
  ⟨(finRotate 3, finRotate 3, finRotate 3), by decide⟩

/-- The stored triple of `3T1-3_3_3-a` denotes the triple whose components over `0` and `1` are the
inverse rotation. -/
theorem toTriple_cyclicThreeStoredTriple :
    cyclicThreeStoredTriple.toTriple = ofTwo (finRotate 3)⁻¹ (finRotate 3)⁻¹ :=
  ext_of_two (by simp [cyclicThreeStoredTriple]) (by simp [cyclicThreeStoredTriple])

/-- The cyclic triple of degree three is connected. -/
theorem isConnected_toTriple_cyclicThreeStoredTriple :
    cyclicThreeStoredTriple.toTriple.IsConnected := by
  rw [toTriple_cyclicThreeStoredTriple]
  decide

/-- The stored triple of `3T1-3_3_3-a` is isomorphic to the cyclic triple `cyclicPowTriple 3 1`:
relabeling the sheets by the reversal `i ↦ 2 - i` turns the inverse rotation into the rotation. -/
theorem equivalent_toTriple_cyclicThreeStoredTriple :
    cyclicThreeStoredTriple.toTriple.Equivalent (cyclicPowTriple 3 1) := by
  rw [toTriple_cyclicThreeStoredTriple]
  exact equivalent_iff_exists_smul_eq.2
    ⟨Fin.revPerm, ext_of_two (by simp only [smul_σ0, ofTwo_σ0, cyclicPowTriple_σ0]; decide)
      (by simp only [smul_σ1, ofTwo_σ1, cyclicPowTriple_σ1]; decide)⟩

/-- The triple of `3T1-3_3_3-a` has a three-cycle over each of `0`, `1` and `∞`, as does the
isomorphic cyclic triple `cyclicPowTriple 3 1`. -/
theorem cycleData_toTriple_cyclicThreeStoredTriple :
    cyclicThreeStoredTriple.toTriple.cycleData = ({3}, {3}, {3}) :=
  (cycleData_eq_of_equivalent equivalent_toTriple_cyclicThreeStoredTriple).trans
    (cycleData_cyclicPowTriple (by decide) (by decide))

/-- The triple of `3T1-3_3_3-a` has genus one, as does the isomorphic cyclic triple
`cyclicPowTriple 3 1`. -/
theorem genus_toTriple_cyclicThreeStoredTriple : cyclicThreeStoredTriple.toTriple.genus = 1 :=
  (genus_eq_of_equivalent equivalent_toTriple_cyclicThreeStoredTriple).trans
    (genus_cyclicPowTriple (by decide) (by decide))

/-- The passport row `3T1-3_3_3`: monodromy `C₃`, totally ramified over `0`, `1` and `∞`, of genus
one and Euclidean. It is primitive, its degree being prime, so its primitivization block is a single
sheet, and its automorphism group is generated by the rotation `finRotate 3`. The label strings,
the automorphism-group name and the two aggregations are carrier data that validity does not
read. -/
@[expose] def cyclicThreePassportRecord : PassportRecord 3 where
  plabel := "3T1-3_3_3"
  deg := 3
  group := 1
  abc := (3, 3, 3)
  sortedAbc := (3, 3, 3)
  lambdas := ({3}, {3}, {3})
  g := 1
  geomtype := .euclidean
  passSize := 1
  numOrbits := 1
  maxdegbf := 1
  isPrimitive := true
  primitivization := "3T1-3_3_3-a"
  primitivizationBlock := {0}
  autGroup := "C3"
  autGroupGenerators := [finRotate 3]
  triples := [cyclicThreeStoredTriple.toTriple]

/-- The passport row `3T1-3_3_3` is valid for the passport of its stored triple. Its invariants are
those of the isomorphic cyclic triple `cyclicPowTriple 3 1`. -/
theorem isValidAt_cyclicThreePassportRecord :
    cyclicThreePassportRecord.IsValidAt
      ⟨cyclicThreeStoredTriple.toTriple, isConnected_toTriple_cyclicThreeStoredTriple⟩ := by
  have he := equivalent_toTriple_cyclicThreeStoredTriple
  have hmono : cyclicThreeStoredTriple.toTriple.monodromyGroup =
      (cyclicPowTriple 3 1).monodromyGroup := by
    rw [StoredTriple.monodromyGroup_toTriple, monodromyGroup_cyclicPowTriple]
    simp only [cyclicThreeStoredTriple, Set.pair_eq_singleton, ← Subgroup.zpowers_eq_closure]
  have hord := (orderTriple_eq_of_equivalent he).trans
    (orderTriple_cyclicPowTriple (by decide) (by decide))
  have hprim := isConnected_toTriple_cyclicThreeStoredTriple.isPrimitive_of_prime Nat.prime_three
  exact
    { deg_eq := rfl
      mem_triples := List.mem_singleton_self _
      hasPassport_of_mem_triples s hs := by
        obtain rfl := List.mem_singleton.mp hs
        exact ⟨isConnected_toTriple_cyclicThreeStoredTriple,
          ConnectedTriple.hasPassport_passportOf _⟩
      lambdas_eq := cycleData_toTriple_cyclicThreeStoredTriple.symm
      abc_eq := hord.symm
      sortedAbc_eq := (Multiset.eq_sort_iff _).mpr ⟨by decide, by decide⟩
      g_eq := genus_toTriple_cyclicThreeStoredTriple.symm
      geomtype_eq := by
        simp only [Prod.ext_iff, orderTriple_σ0, orderTriple_σ1, orderTriple_σinf] at hord
        dsimp only [cyclicThreePassportRecord]
        rw [eq_comm, geometryType_eq_euclidean_iff, hord.1, hord.2.1, hord.2.2]
        norm_num
      exists_transitiveGroupLabel := ⟨⟨0, by simp⟩, rfl, by
        rw [hmono, monodromyGroup_cyclicPowTriple, ← referenceSubgroup_index_zero_eq_zpowers]
        exact transitiveGroupLabel_referenceSubgroup 3 _⟩
      passSize_eq :=
        (ConnectedTriple.passportSize_passportOf_of_degree_le_four (by norm_num) _).symm
      isPrimitive_eq_true_iff := iff_of_true rfl hprim
      isBlock_primitivizationBlock := by
        simp only [cyclicThreePassportRecord, Finset.coe_singleton]
        exact IsBlock.of_subsingleton Set.subsingleton_singleton
      primitivizationBlock_nonempty := Finset.singleton_nonempty _
      deg_eq_one_of_primitivizationBlock_eq_univ h := absurd h (by decide)
      eq_or_eq_univ_of_primitivizationBlock_subset C hC hsub := by
        rcases ((isPrimitive_iff _).mp hprim).isTrivialBlock_of_isBlock hC with hC | hC
        · left
          simp only [cyclicThreePassportRecord, Finset.coe_singleton] at hsub ⊢
          exact hC.eq_singleton_of_mem (hsub rfl)
        · exact Or.inr hC
      closure_autGroupGenerators := by
        rw [automorphismGroup_eq_centralizer_monodromyGroup, hmono,
          ← automorphismGroup_eq_centralizer_monodromyGroup]
        simp only [cyclicThreePassportRecord, List.mem_singleton, Set.ofPred_eq_eq_singleton,
          automorphismGroup_cyclicPowTriple, Subgroup.zpowers_eq_closure] }

/-- The map row `3T1-3_3_3-a`: the cyclic cover of degree three, whose curve has genus one, with
base field stored as the root `1` of `X - 1`. The equations, the curve
link and the labels of related objects are carrier data that validity does not read, and are left
empty rather than reproduced; in particular `curveLabel` does not record the link of the stored row
to an elliptic curve. -/
@[expose] def cyclicThreeBelyiRecord : BelyiRecord 3 where
  label := "3T1-3_3_3-a"
  plabel := "3T1-3_3_3"
  deg := 3
  lambdas := ({3}, {3}, {3})
  g := 1
  orbitSize := 1
  baseField := [-1, 1]
  embeddings := [(1, 0)]
  triples := [cyclicThreeStoredTriple]
  triplesCyc := [([[0, 1, 2]], [[0, 1, 2]], [[0, 1, 2]])]
  curve := ""
  map := ""
  planeModel := ""
  planeConstant := ""
  curveLabel := none
  friends := []
  storedEmbeddingCount_eq_triplesLength := rfl

/-- The map row `3T1-3_3_3-a` is valid for every passport containing its stored triple. -/
theorem isValidFor_cyclicThreeBelyiRecord {P : PassportSpec 3}
    (hP : PassportSpec.HasPassport
      ⟨cyclicThreeStoredTriple.toTriple, isConnected_toTriple_cyclicThreeStoredTriple⟩ P) :
    cyclicThreeBelyiRecord.IsValidFor P :=
  BelyiRecord.isValidFor_of_triples_eq_singleton rfl rfl rfl rfl
    ⟨⟨by decide, by decide, by decide⟩, ⟨by decide, by decide, by decide⟩,
      ⟨by decide, by decide, by decide⟩⟩ _ hP cycleData_toTriple_cyclicThreeStoredTriple.symm
    genus_toTriple_cyclicThreeStoredTriple.symm

/-! ### The labels `3T1-3_3_3` and `3T1-3_3_3-a` -/

/-- The full label `3T1-3_3_3` has the group `3T1` and the partition `[3]` at each branch
point. -/
theorem PassportRecord.parsePassportLabel_cyclicThreePassportRecord :
    parsePassportLabel 3 cyclicThreePassportRecord.plabel =
      some ⟨⟨0, by simp⟩, {3}, {3}, {3}⟩ := by
  rw [parsePassportLabel_eq_some_iff]
  refine ⟨"3T1", "3_3_3", "3", "3", "3", by decide +kernel,
    by decide +kernel, ?_, ?_, ?_, ?_⟩
  · simp only [parseTransitiveGroupLabel_eq_some_iff, transitiveGroupLabelString_def]
    decide +kernel
  all_goals exact parseCyclePartition_eq_some_iff.mpr ⟨[3], by decide +kernel, rfl, by simp, rfl⟩

/-- The stored label of the passport row `3T1-3_3_3` agrees with its certified fields. -/
theorem PassportRecord.hasValidLabel_cyclicThreePassportRecord :
    cyclicThreePassportRecord.HasValidLabel := by
  rw [PassportRecord.hasValidLabel_iff_of_parse
    PassportRecord.parsePassportLabel_cyclicThreePassportRecord]
  exact ⟨by simp [PassportLabel.groupNumber_def, cyclicThreePassportRecord], rfl⟩

/-- The map label `3T1-3_3_3-a` parses to the passport `3T1-3_3_3` and the orbit `a`. -/
theorem BelyiRecord.parseMapLabel_cyclicThreeBelyiRecord :
    parseMapLabel 3 cyclicThreeBelyiRecord.label = some (⟨⟨0, by simp⟩, {3}, {3}, {3}⟩, "a") := by
  rw [parseMapLabel_eq_some_iff_append]
  exact ⟨cyclicThreePassportRecord.plabel, by decide +kernel, by decide, by decide,
    PassportRecord.parsePassportLabel_cyclicThreePassportRecord⟩

/-- The stored label of the map row `3T1-3_3_3-a` extends its passport label and agrees with its
stored partitions. -/
theorem BelyiRecord.hasValidLabel_cyclicThreeBelyiRecord : cyclicThreeBelyiRecord.HasValidLabel :=
  (BelyiRecord.hasValidLabel_iff_of_parse BelyiRecord.parseMapLabel_cyclicThreeBelyiRecord).mpr
    ⟨by decide +kernel, rfl⟩

/-! ### The genus-two row `6T6-6_6_3.3-a` -/

/-- A representative of the passport `6T6-6_6_3.3`, used as the stored triple of the map row
`6T6-6_6_3.3-a` and written in the database's convention: the rotation `(0 1 2 3 4 5)` over `0`, the
six-cycle `(0 1 5 3 4 2)` over `1`, and `(0 1 2)(3 4 5)` over `∞`. It is not checked against the
literal stored permutations of the frozen record. -/
@[expose] def genusTwoStoredTriple : StoredTriple 6 :=
  ⟨(finRotate 6, [0, 1, 5, 3, 4, 2].formPerm, [0, 1, 2].formPerm * [3, 4, 5].formPerm), by decide⟩

/-- The representative triple of `6T6-6_6_3.3-a` denotes the triple whose components over `0` and
`1` are the inverses of the stored ones. -/
theorem toTriple_genusTwoStoredTriple :
    genusTwoStoredTriple.toTriple = ofTwo (finRotate 6)⁻¹ [0, 1, 5, 3, 4, 2].formPerm⁻¹ :=
  ext_of_two (by simp [genusTwoStoredTriple]) (by simp [genusTwoStoredTriple])

/-- The triple of `6T6-6_6_3.3-a` is connected. -/
theorem isConnected_toTriple_genusTwoStoredTriple : genusTwoStoredTriple.toTriple.IsConnected := by
  rw [toTriple_genusTwoStoredTriple]
  decide

/-- The genus-two triple has a six-cycle over each of `0` and `1`, and two three-cycles over
`∞`. -/
theorem cycleData_toTriple_genusTwoStoredTriple :
    genusTwoStoredTriple.toTriple.cycleData = ({6}, {6}, {3, 3}) := by
  rw [toTriple_genusTwoStoredTriple]
  decide

/-- The triple of `6T6-6_6_3.3-a` has genus two. -/
theorem genus_toTriple_genusTwoStoredTriple : genusTwoStoredTriple.toTriple.genus = 2 := by
  rw [← computedGenus_eq, toTriple_genusTwoStoredTriple]
  decide

/-- The triple of `6T6-6_6_3.3-a` is hyperbolic: its orders are `(6, 6, 3)`. -/
theorem geometryType_toTriple_genusTwoStoredTriple :
    genusTwoStoredTriple.toTriple.geometryType = .hyperbolic := by
  rw [← computedGeometryType_eq, toTriple_genusTwoStoredTriple]
  decide +kernel

/-- The map row `6T6-6_6_3.3-a`: a cover of degree six whose curve has genus two, with base field
stored as the root `1` of `X - 1`. Its triple, and the cycle notation writing it, are the
representative `genusTwoStoredTriple` of the passport, not necessarily the literal stored
permutations. The equations, the curve link and the labels of related objects
are carrier data that validity does not read, and are left empty rather than reproduced; in
particular `curveLabel` does not record the link of the stored row to a genus-two curve. -/
@[expose] def genusTwoBelyiRecord : BelyiRecord 6 where
  label := "6T6-6_6_3.3-a"
  plabel := "6T6-6_6_3.3"
  deg := 6
  lambdas := ({6}, {6}, {3, 3})
  g := 2
  orbitSize := 1
  baseField := [-1, 1]
  embeddings := [(1, 0)]
  triples := [genusTwoStoredTriple]
  triplesCyc := [([[0, 1, 2, 3, 4, 5]], [[0, 1, 5, 3, 4, 2]], [[0, 1, 2], [3, 4, 5]])]
  curve := ""
  map := ""
  planeModel := ""
  planeConstant := ""
  curveLabel := none
  friends := []
  storedEmbeddingCount_eq_triplesLength := rfl

/-- The map row `6T6-6_6_3.3-a` is valid for every passport containing its stored triple. -/
theorem isValidFor_genusTwoBelyiRecord {P : PassportSpec 6}
    (hP : PassportSpec.HasPassport
      ⟨genusTwoStoredTriple.toTriple, isConnected_toTriple_genusTwoStoredTriple⟩ P) :
    genusTwoBelyiRecord.IsValidFor P :=
  BelyiRecord.isValidFor_of_triples_eq_singleton rfl rfl rfl rfl
    ⟨⟨by decide, by decide, by decide⟩, ⟨by decide, by decide, by decide⟩,
      ⟨by decide, by decide, by decide⟩⟩ _ hP cycleData_toTriple_genusTwoStoredTriple.symm
    genus_toTriple_genusTwoStoredTriple.symm

/-! ### The primitivization of `6T6-6_6_3.3` -/

/-- The involution `r³` of the six sheets, for the rotation `r`, is an automorphism of the triple
of `6T6-6_6_3.3-a`. -/
theorem finRotate_pow_three_mem_automorphismGroup_toTriple_genusTwoStoredTriple :
    finRotate 6 ^ 3 ∈ genusTwoStoredTriple.toTriple.automorphismGroup := by
  rw [mem_automorphismGroup_iff, toTriple_genusTwoStoredTriple]
  decide

/-- The automorphism group of the triple of `6T6-6_6_3.3-a` is generated by the involution `r³`:
an automorphism commutes with the component `r⁻¹` over `0`, so it is a power of `r`, and among
these only `1` and `r³` commute with the component over `1`. -/
theorem automorphismGroup_toTriple_genusTwoStoredTriple :
    genusTwoStoredTriple.toTriple.automorphismGroup = Subgroup.zpowers (finRotate 6 ^ 3) := by
  refine le_antisymm (fun τ hτ ↦ ?_)
    (Subgroup.zpowers_le.mpr
      finRotate_pow_three_mem_automorphismGroup_toTriple_genusTwoStoredTriple)
  rw [automorphismGroup_eq_centralizer_monodromyGroup, Subgroup.mem_centralizer_iff] at hτ
  have h0 := hτ _ genusTwoStoredTriple.toTriple.σ0_mem_monodromyGroup
  have h1 := hτ _ genusTwoStoredTriple.toTriple.σ1_mem_monodromyGroup
  rw [toTriple_genusTwoStoredTriple, ofTwo_σ0] at h0
  rw [toTriple_genusTwoStoredTriple, ofTwo_σ1] at h1
  -- Commuting with `r⁻¹`, the automorphism lies in the centralizer `⟨r⟩` of the cyclic triple.
  have hr : τ ∈ (cyclicTriple 6).automorphismGroup := by
    rw [automorphismGroup_eq_centralizer_monodromyGroup, monodromyGroup_cyclicTriple,
      Subgroup.mem_centralizer_iff]
    rintro _ ⟨k, rfl⟩
    exact ((Commute.inv_left_iff.mp h0).zpow_left k).eq
  rw [automorphismGroup_cyclicTriple, mem_zpowers_iff_mem_range_orderOf,
    orderOf_finRotate (by decide), Finset.mem_image] at hr
  obtain ⟨k, hk, rfl⟩ := hr
  have key : ∀ k < 6, [0, 1, 5, 3, 4, 2].formPerm⁻¹ * finRotate 6 ^ k =
      finRotate 6 ^ k * [0, 1, 5, 3, 4, 2].formPerm⁻¹ →
        finRotate 6 ^ k = 1 ∨ finRotate 6 ^ k = finRotate 6 ^ 3 := by
    decide
  rcases key k (Finset.mem_range.mp hk) h1 with h | h
  · rw [h]
    exact one_mem _
  · rw [h]
    exact Subgroup.mem_zpowers _

/-- Every element of the monodromy group commutes with the automorphism `r³`. -/
private theorem mul_finRotate_pow_three_comm {g : Perm (Fin 6)}
    (hg : g ∈ genusTwoStoredTriple.toTriple.monodromyGroup) :
    g * finRotate 6 ^ 3 = finRotate 6 ^ 3 * g := by
  have h := finRotate_pow_three_mem_automorphismGroup_toTriple_genusTwoStoredTriple
  rw [automorphismGroup_eq_centralizer_monodromyGroup, Subgroup.mem_centralizer_iff] at h
  exact h g hg

/-- The translates of `{0, 3}` under the monodromy group are the pairs `{a, r³ a}`. -/
private theorem exists_eq_pair_of_mem_orbit {C : Set (Fin 6)}
    (hC : C ∈ orbit genusTwoStoredTriple.toTriple.monodromyGroup ({0, 3} : Set (Fin 6))) :
    ∃ a, C = {a, (finRotate 6 ^ 3) a} := by
  obtain ⟨g, rfl⟩ := hC
  refine ⟨(g : Perm (Fin 6)) 0, ?_⟩
  have h3 : (g : Perm (Fin 6)) 3 = (finRotate 6 ^ 3) ((g : Perm (Fin 6)) 0) := by
    have h03 : (finRotate 6 ^ 3) 0 = 3 := by decide
    rw [← h03, ← Perm.mul_apply, mul_finRotate_pow_three_comm g.2, Perm.mul_apply]
  simp only [Set.smul_set_insert, Set.smul_set_singleton, Subgroup.smul_def, Perm.smul_def, h3]

/-- The pair `{0, 3}` is a block of the monodromy action of the triple of `6T6-6_6_3.3-a`: its
translates are the orbits of the automorphism `r³`. -/
theorem isBlock_toTriple_genusTwoStoredTriple :
    IsBlock genusTwoStoredTriple.toTriple.monodromyGroup ({0, 3} : Set (Fin 6)) := by
  rw [isBlock_iff_smul_eq_or_disjoint]
  intro g
  obtain ⟨a, ha⟩ : ∃ a, g • ({0, 3} : Set (Fin 6)) = {a, (finRotate 6 ^ 3) a} :=
    exists_eq_pair_of_mem_orbit ⟨g, rfl⟩
  rw [ha]
  have key : ∀ a : Fin 6, ({a, (finRotate 6 ^ 3) a} : Finset (Fin 6)) = {0, 3} ∨
      Disjoint ({a, (finRotate 6 ^ 3) a} : Finset (Fin 6)) {0, 3} := by
    decide
  rcases key a with h | h
  · left
    simpa only [Finset.coe_pair] using congrArg ((↑) : Finset (Fin 6) → Set (Fin 6)) h
  · right
    simpa only [Finset.coe_pair] using Finset.disjoint_coe.mpr h

/-- The pair `{0, 3}` has three translates. -/
private theorem natCard_orbit_pair :
    Nat.card (orbit genusTwoStoredTriple.toTriple.monodromyGroup ({0, 3} : Set (Fin 6))) = 3 := by
  have := isConnected_toTriple_genusTwoStoredTriple.isPretransitive
  have h := isBlock_toTriple_genusTwoStoredTriple.ncard_block_mul_ncard_orbit_eq
    (Set.insert_nonempty _ _)
  rw [Set.ncard_pair (by decide), Nat.card_fin] at h
  rw [Nat.card_coe_set_eq]
  omega

/-- On the three translates of `{0, 3}`, each component of the triple of `6T6-6_6_3.3-a` is a
three-cycle, for any numbering of the translates. -/
theorem cycleData_blockQuotient_toTriple_genusTwoStoredTriple
    (e : orbit genusTwoStoredTriple.toTriple.monodromyGroup ({0, 3} : Set (Fin 6)) ≃ Fin 3) :
    (genusTwoStoredTriple.toTriple.blockQuotient _ e).cycleData = ({3}, {3}, {3}) := by
  -- A permutation of three points without fixed points is a three-cycle.
  have hfree : ∀ σ : Perm (Fin 3), (∀ i, σ i ≠ i) → σ.computedCycleType = {3} := by decide
  -- A component moving every pair `{a, r³ a}` fixes no translate.
  have hmove (σ : Perm (Fin 6)) (τ : Perm (Fin 3)) (hσ : ∀ a, σ a ≠ a ∧ σ a ≠ (finRotate 6 ^ 3) a)
      (hτ : ∀ i, (e.symm (τ i) : Set (Fin 6)) = σ '' (e.symm i : Set (Fin 6))) (i : Fin 3) :
      τ i ≠ i := by
    intro h
    obtain ⟨a, ha⟩ := exists_eq_pair_of_mem_orbit (e.symm i).2
    have hi := hτ i
    rw [h, ha] at hi
    rcases Set.image_subset_iff.mp hi.symm.subset (Set.mem_insert a _) with h' | h'
    exacts [(hσ a).1 h', (hσ a).2 h']
  -- Every component moves every pair `{a, r³ a}`.
  have hσ : ∀ σ ∈ [genusTwoStoredTriple.toTriple.σ0, genusTwoStoredTriple.toTriple.σ1,
      genusTwoStoredTriple.toTriple.σinf], ∀ a, σ a ≠ a ∧ σ a ≠ (finRotate 6 ^ 3) a := by
    rw [toTriple_genusTwoStoredTriple]
    simp only [List.forall_mem_cons, List.not_mem_nil, IsEmpty.forall_iff, implies_true, and_true]
    decide
  rw [cycleData, hfree _ (hmove _ _ (hσ _ (by simp)) (coe_symm_blockQuotient_σ0 _ _ e)),
    hfree _ (hmove _ _ (hσ _ (by simp)) (coe_symm_blockQuotient_σ1 _ _ e)),
    hfree _ (hmove _ _ (hσ _ (by simp)) (coe_symm_blockQuotient_σinf _ _ e))]

/-- The quotient of the triple of `6T6-6_6_3.3-a` by the translates of `{0, 3}` is isomorphic to
the cyclic triple of `3T1-3_3_3-a`. -/
theorem equivalent_blockQuotient_toTriple_genusTwoStoredTriple
    (e : orbit genusTwoStoredTriple.toTriple.monodromyGroup ({0, 3} : Set (Fin 6)) ≃ Fin 3) :
    (genusTwoStoredTriple.toTriple.blockQuotient _ e).Equivalent
      cyclicThreeStoredTriple.toTriple :=
  (equivalent_iff_cycleData_eq_of_degree_le_four (by norm_num)
    ⟨_, genusTwoStoredTriple.toTriple.isConnected_blockQuotient _ e⟩
    ⟨_, isConnected_toTriple_cyclicThreeStoredTriple⟩).mpr
    (by rw [cycleData_blockQuotient_toTriple_genusTwoStoredTriple,
      cycleData_toTriple_cyclicThreeStoredTriple])

/-- The block `{0, 3}` of the triple of `6T6-6_6_3.3-a` is maximal: every block containing it is
`{0, 3}` or the set of all sheets, since the quotient has prime degree. -/
theorem eq_or_eq_univ_of_isBlock_toTriple_genusTwoStoredTriple {D : Set (Fin 6)}
    (hD : IsBlock genusTwoStoredTriple.toTriple.monodromyGroup D) (hsub : {0, 3} ⊆ D) :
    D = {0, 3} ∨ D = Set.univ := by
  have := isConnected_toTriple_genusTwoStoredTriple.isPretransitive
  let e := Finite.equivFinOfCardEq natCard_orbit_pair
  exact (isPrimitive_blockQuotient_iff e this isBlock_toTriple_genusTwoStoredTriple
    (Set.insert_nonempty _ _)).mp
    ((genusTwoStoredTriple.toTriple.isConnected_blockQuotient _ e).isPrimitive_of_prime
      Nat.prime_three) D hD hsub

/-- The triple of `6T6-6_6_3.3-a` is imprimitive. -/
theorem not_isPrimitive_toTriple_genusTwoStoredTriple :
    ¬ genusTwoStoredTriple.toTriple.IsPrimitive := by
  rw [isPrimitive_iff]
  intro h
  rcases h.isTrivialBlock_of_isBlock isBlock_toTriple_genusTwoStoredTriple with h | h
  · exact absurd (h (Set.mem_insert 0 _) (Set.mem_insert_of_mem 0 rfl)) (by decide)
  · have h1 : (1 : Fin 6) ∈ ({0, 3} : Set (Fin 6)) := h ▸ Set.mem_univ 1
    simp at h1

/-- The passport row `6T6-6_6_3.3`, with the representative `genusTwoStoredTriple` as its triple;
its primitivization block `{0, 3}` and automorphism-group generator `r³` refer to the sheet
numbering of this representative, not necessarily to that of the frozen record. Its partitions,
genus, geometry type and primitivity flag are the invariants of this triple
(`cycleData_toTriple_genusTwoStoredTriple`, `genus_toTriple_genusTwoStoredTriple`,
`geometryType_toTriple_genusTwoStoredTriple` and `not_isPrimitive_toTriple_genusTwoStoredTriple`).
The block is maximal (`eq_or_eq_univ_of_isBlock_toTriple_genusTwoStoredTriple`), and
`isPrimitivizationOf_genusTwoPassportRecord` certifies the primitivization through it. The
generator `r³` generates the automorphism group (`automorphismGroup_toTriple_genusTwoStoredTriple`).
The group number and the passport size are not certified here, and the label strings, the
automorphism-group name and the two aggregations are carrier data. -/
@[expose] def genusTwoPassportRecord : PassportRecord 6 where
  plabel := "6T6-6_6_3.3"
  deg := 6
  group := 6
  abc := (6, 6, 3)
  sortedAbc := (3, 6, 6)
  lambdas := ({6}, {6}, {3, 3})
  g := 2
  geomtype := .hyperbolic
  passSize := 1
  numOrbits := 1
  maxdegbf := 1
  isPrimitive := false
  primitivization := "3T1-3_3_3-a"
  primitivizationBlock := {0, 3}
  autGroup := "C2"
  autGroupGenerators := [finRotate 6 ^ 3]
  triples := [genusTwoStoredTriple.toTriple]

/-- The map row `3T1-3_3_3-a` certifies the stored primitivization of the passport row
`6T6-6_6_3.3`: the quotient of its representative triple by the three translates of the block
`{0, 3}` is the cyclic triple of degree three. -/
theorem isPrimitivizationOf_genusTwoPassportRecord :
    cyclicThreeBelyiRecord.IsPrimitivizationOf genusTwoPassportRecord
      ⟨genusTwoStoredTriple.toTriple, isConnected_toTriple_genusTwoStoredTriple⟩ := by
  have hB : (genusTwoPassportRecord.primitivizationBlock : Set (Fin 6)) = {0, 3} := by
    simp [genusTwoPassportRecord]
  refine ⟨rfl, ?_⟩
  -- The stored block is `{0, 3}`, generalized so that the type of its translates can be rewritten;
  -- numbering the three translates, the quotient is isomorphic to the cyclic triple.
  have key : ∀ (B : Set (Fin 6)) (_ : B = {0, 3}),
      ∃ e : orbit genusTwoStoredTriple.toTriple.monodromyGroup B ≃ Fin 3,
        cyclicThreeBelyiRecord.IsValidFor (ConnectedTriple.passportOf
          ⟨genusTwoStoredTriple.toTriple.blockQuotient _ e,
            genusTwoStoredTriple.toTriple.isConnected_blockQuotient _ e⟩) := by
    rintro _ rfl
    let e := Finite.equivFinOfCardEq natCard_orbit_pair
    refine ⟨e, isValidFor_cyclicThreeBelyiRecord ?_⟩
    exact (PassportSpec.hasPassport_iff_of_equivalent (ConnectedIsoClass.mk_eq_mk_iff.mp
      (ConnectedIsoClass.mk_eq_mk_iff_equivalent.mpr
        (equivalent_blockQuotient_toTriple_genusTwoStoredTriple e))) _).mp
      (ConnectedTriple.hasPassport_passportOf _)
  exact key _ hB

