module

public import TauCeti.Combinatorics.PermutationTriple.LMFDB.BelyiRecord.Basic
public import TauCeti.Combinatorics.PermutationTriple.LMFDB.PassportRecord.Label

/-!
# Certifying the label of a Belyi-map record

A map label is a passport label, a hyphen, and an identifier of the Galois orbit
(`TauCeti.PermutationTriple.LMFDB.parseMapLabel_eq_some_iff_append`). The validity predicate
`TauCeti.PermutationTriple.LMFDB.BelyiRecord.IsValidFor` leaves both stored labels of a map row
unconstrained. `TauCeti.PermutationTriple.LMFDB.BelyiRecord.HasValidLabel` is the additional
finite certificate: the stored map label is the stored passport label followed by an orbit
identifier, it parses, and its partitions are the stored partitions. The parser is indexed by the
degree, which validity identifies with the stored degree.

For a valid row, the certificate makes the partitions of the label those of the row's passport.
A map row stores no transitive-group number, so the group component of its label is the one
component that the row does not certify by itself. It is read off the stored permutations: the
label is a mathematical label of the passport exactly when its transitive-group index labels the
group generated by the first two stored components of any stored triple. It is also supplied by a
valid passport row whose certified label is the same string: the map label is then a mathematical
label of exactly those passports that contain the reference triple of the passport row.

The orbit identifier is returned as external data. It enumerates the Galois orbits inside a
passport in an order chosen by the database, and no mathematical meaning is assigned to it.

## Main definitions

* `TauCeti.PermutationTriple.LMFDB.BelyiRecord.HasValidLabel`: the stored map label extends the
  stored passport label, parses, and agrees with the stored partitions.

## Main results

* `TauCeti.PermutationTriple.LMFDB.BelyiRecord.HasValidLabel.parsePassportLabel_plabel`: the
  passport component of a certified map label is the stored passport label.
* `TauCeti.PermutationTriple.LMFDB.BelyiRecord.IsValidFor.hasLabel_iff_transitiveGroupLabel`
  and `TauCeti.PermutationTriple.LMFDB.BelyiRecord.IsValidFor.hasLabel_iff_closure`: for a valid
  row, only the group component of a certified label remains to be checked, against the reference
  group of the passport or against the stored permutations.
* `TauCeti.PermutationTriple.LMFDB.BelyiRecord.HasValidLabel.hasLabel_iff_hasPassport`: a map label
  sharing its passport label with a certified valid passport row labels exactly the passports of
  that row.

## References

* LMFDB, *Belyi map labels*, https://www.lmfdb.org/knowledge/show/belyi.label.
* M. Musty, S. Schiavone, J. Sijsling, J. Voight, *A database of Belyi maps*, §2.
-/

public section

namespace TauCeti.PermutationTriple.LMFDB.BelyiRecord

variable {n : ℕ} {r : BelyiRecord n} {L : PassportLabel n} {orbit : String}

/-- The stored map label is the stored passport label followed by a hyphen and an orbit
identifier, it parses, and its partitions are the stored partitions. This is separate from
`IsValidFor`, which does not constrain the label strings. -/
def HasValidLabel (r : BelyiRecord n) : Prop :=
  ∃ L : PassportLabel n, ∃ orbit : String, parseMapLabel n r.label = some (L, orbit) ∧
    r.label = r.plabel ++ "-" ++ orbit ∧ (L.lam0, L.lam1, L.laminf) = r.lambdas

/-- A label certificate supplies a successful parse of the map label whose passport component is
the stored passport label and whose partitions are the stored partitions. -/
theorem hasValidLabel_iff :
    r.HasValidLabel ↔ ∃ L : PassportLabel n, ∃ orbit : String,
      parseMapLabel n r.label = some (L, orbit) ∧ r.label = r.plabel ++ "-" ++ orbit ∧
        (L.lam0, L.lam1, L.laminf) = r.lambdas := (Iff.rfl)

/-- After a successful parse, certifying the label means precisely checking the stored passport
label and the stored partitions; in particular the parsed output is not an additional choice. -/
theorem hasValidLabel_iff_of_parse (hL : parseMapLabel n r.label = some (L, orbit)) :
    r.HasValidLabel ↔
      r.label = r.plabel ++ "-" ++ orbit ∧ (L.lam0, L.lam1, L.laminf) = r.lambdas := by
  refine ⟨fun ⟨L', orbit', hL', hrest⟩ => ?_, fun h => ⟨L, orbit, hL, h⟩⟩
  obtain ⟨rfl, rfl⟩ := Prod.ext_iff.mp (Option.some.inj (hL.symm.trans hL'))
  exact hrest

/-- The label certificate is decidable by parsing and comparing finite data. -/
instance : Decidable r.HasValidLabel :=
  match h : parseMapLabel n r.label with
  | none => isFalse fun hr => by
      obtain ⟨_, _, hL, -⟩ := hr
      rw [h] at hL
      cases hL
  | some (L, orbit) => decidable_of_iff
      (r.label = r.plabel ++ "-" ++ orbit ∧ (L.lam0, L.lam1, L.laminf) = r.lambdas)
      (hasValidLabel_iff_of_parse h).symm

namespace HasValidLabel

/-- The passport component of a certified map label is the stored passport label: it parses to
the passport data of the map label. -/
theorem parsePassportLabel_plabel (hr : r.HasValidLabel)
    (hL : parseMapLabel n r.label = some (L, orbit)) :
    parsePassportLabel n r.plabel = some L := by
  obtain ⟨p, hp, -, -, hpL⟩ := parseMapLabel_eq_some_iff_append.mp hL
  have hplabel := ((hasValidLabel_iff_of_parse hL).mp hr).1
  rw [hp, String.append_left_inj, String.append_left_inj] at hplabel
  rwa [← hplabel]

/-- A map label whose passport label is the certified label of a valid passport row labels exactly
the passports containing the reference triple of that row. The group component of the map label,
which a map row does not certify by itself, is thereby certified by the passport row. -/
theorem hasLabel_iff_hasPassport (hr : r.HasValidLabel)
    (hL : parseMapLabel n r.label = some (L, orbit)) {p : PassportRecord n}
    {t : ConnectedTriple n} (hp : p.IsValidAt t) (hpl : p.HasValidLabel)
    (hplabel : r.plabel = p.plabel) (P : PassportSpec n) :
    P.HasLabel L ↔ PassportSpec.HasPassport t P :=
  hp.hasLabel_iff_hasPassport hpl (hplabel ▸ hr.parsePassportLabel_plabel hL) P

end HasValidLabel

namespace IsValidFor

variable {P : PassportSpec n}

/-- The partitions of a certified label of a valid row are those of its passport. -/
theorem partitions_eq_of_hasValidLabel (h : r.IsValidFor P) (hr : r.HasValidLabel)
    (hL : parseMapLabel n r.label = some (L, orbit)) :
    (L.lam0, L.lam1, L.laminf) = (P.lam0, P.lam1, P.laminf) :=
  ((hasValidLabel_iff_of_parse hL).mp hr).2.trans h.lambdas_eq

/-- For a valid row, a certified label is a mathematical label of the passport exactly when its
transitive-group index labels the reference group: its partitions are already certified. -/
theorem hasLabel_iff_transitiveGroupLabel (h : r.IsValidFor P) (hr : r.HasValidLabel)
    (hL : parseMapLabel n r.label = some (L, orbit)) :
    P.HasLabel L ↔ TransitiveGroupLabel L.group P.G := by
  have hparts := h.partitions_eq_of_hasValidLabel hr hL
  simp only [Prod.mk.injEq] at hparts
  obtain ⟨h0, h1, hinf⟩ := hparts
  rw [PassportSpec.hasLabel_iff, h0, h1, hinf]
  exact and_iff_left ⟨rfl, rfl, rfl⟩

/-- For a valid row, a certified label is a mathematical label of the passport exactly when its
transitive-group index labels the group generated by the first two stored components of a stored
triple. Only finite data of the row enter the right-hand side. -/
theorem hasLabel_iff_closure (h : r.IsValidFor P) (hr : r.HasValidLabel)
    (hL : parseMapLabel n r.label = some (L, orbit)) {s : StoredTriple n} (hs : s ∈ r.triples) :
    P.HasLabel L ↔ TransitiveGroupLabel L.group (Subgroup.closure {s.1.1, s.1.2.1}) := by
  obtain ⟨hc, hP⟩ := h.hasPassport s hs
  have hparts : s.toTriple.cycleData = (L.lam0, L.lam1, L.laminf) :=
    (h.lambdas_eq_cycleData hs).symm.trans ((hasValidLabel_iff_of_parse hL).mp hr).2.symm
  rw [PassportSpec.hasLabel_iff_of_hasPassport hP, StoredTriple.monodromyGroup_toTriple, hparts]
  exact and_iff_left ⟨rfl, rfl, rfl⟩

end IsValidFor

end TauCeti.PermutationTriple.LMFDB.BelyiRecord
