public import TauCeti.Combinatorics.PermutationTriple.Passport.Class
public import TauCeti.GroupTheory.GroupAction.FinRotate
public import TauCeti.GroupTheory.Perm.OrbitCount.FinRotate

/-!
# Passports with cyclic monodromy of prime degree

Let `r = finRotate n` be cyclic rotation of `Fin n`. The triple `(r, r ^ k, (r ^ (k + 1))⁻¹)` is
`TauCeti.PermutationTriple.cyclicPowTriple n k`; its monodromy group is the cyclic group generated
by `r`. When `k` and `k + 1` are coprime to `n`, each of its three components is a single
`n`-cycle, so the triple lies in the passport `TauCeti.PassportSpec.cyclicTotallyRamified n`:
reference group `⟨r⟩` and cycle partition `[n]` over each of `0`, `1` and `∞`.

For a prime `p` this passport is classified completely. A triple in it can be relabeled so that
its component over `0` is `r`; its monodromy group then has order `p` and contains `r`, so it is
`⟨r⟩`, and the component over `1` is `r ^ k` with `k` neither `0` nor `p - 1`, since neither the
component over `1` nor that over `∞` is the identity. Conversely, a relabeling fixing `r`
commutes with every power of `r`, so the triples with `1 ≤ k ≤ p - 2` are pairwise
non-isomorphic. Hence the passport has exactly `p - 2` isomorphism classes.

In degree `5` this gives the passport with monodromy `C₅` and ordered cycle partitions
`([5], [5], [5])`, whose three classes are represented by `(r, r, r³)`, `(r, r², r²)` and
`(r, r³, r)`. In particular a passport does not determine the isomorphism class of a triple.

## Main declarations

* `TauCeti.PermutationTriple.cyclicPowTriple`: the triple `(r, r ^ k, (r ^ (k + 1))⁻¹)`.
* `TauCeti.PassportSpec.cyclicTotallyRamified`: the passport `(⟨r⟩, [n], [n], [n])`.
* `TauCeti.PassportSpec.classSet_cyclicTotallyRamified`: for prime `p`, its isomorphism classes
  are those of `cyclicPowTriple p k` for `1 ≤ k ≤ p - 2`.
* `TauCeti.PassportSpec.passportSize_cyclicTotallyRamified`: for prime `p`, it has `p - 2`
  isomorphism classes.
* `TauCeti.PassportSpec.passportSize_cyclicTotallyRamified_five`: the degree-`5` passport has
  three isomorphism classes.

## References

* S. K. Lando, A. K. Zvonkin, *Graphs on Surfaces and Their Applications*, Encyclopaedia of
  Mathematical Sciences 141, Springer 2004, §1.5.
-/

open Equiv Equiv.Perm

public section

namespace TauCeti

namespace PermutationTriple

variable {n k : ℕ}

/-- The triple `(r, r ^ k, (r ^ (k + 1))⁻¹)` of degree `n`, where `r = finRotate n` is cyclic
rotation of `Fin n`. -/
def cyclicPowTriple (n k : ℕ) : PermutationTriple n :=
  ofTwo (finRotate n) (finRotate n ^ k)

@[simp] theorem cyclicPowTriple_σ0 : (cyclicPowTriple n k).σ0 = finRotate n := (rfl)

@[simp] theorem cyclicPowTriple_σ1 : (cyclicPowTriple n k).σ1 = finRotate n ^ k := (rfl)

@[simp] theorem cyclicPowTriple_σinf :
    (cyclicPowTriple n k).σinf = (finRotate n ^ (k + 1))⁻¹ := by
  rw [cyclicPowTriple, ofTwo_σinf, pow_succ]

/-- For `k < n`, the component of `cyclicPowTriple n k` over `∞` is the power
`r ^ (n - 1 - k)` of cyclic rotation `r`. -/
theorem cyclicPowTriple_σinf_of_lt (hk : k < n) :
    (cyclicPowTriple n k).σinf = finRotate n ^ (n - 1 - k) := by
  rw [cyclicPowTriple_σinf, inv_eq_iff_mul_eq_one, ← pow_add,
    show k + 1 + (n - 1 - k) = n by omega]
  simpa [orderOf_finRotate (by omega : n ≠ 0)] using pow_orderOf_eq_one (finRotate n)

/-- The monodromy group of `cyclicPowTriple n k` is the cyclic group generated by rotation. -/
theorem monodromyGroup_cyclicPowTriple :
    (cyclicPowTriple n k).monodromyGroup = Subgroup.zpowers (finRotate n) := by
  rw [← closure_pair_eq_monodromyGroup, cyclicPowTriple_σ0, cyclicPowTriple_σ1]
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨Subgroup.mem_zpowers _, Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _⟩
  · exact Subgroup.zpowers_le.mpr (Subgroup.subset_closure (Set.mem_insert _ _))

/-- The triple `cyclicPowTriple n k` is connected when it has at least one sheet. -/
theorem isConnected_cyclicPowTriple (hn : n ≠ 0) : (cyclicPowTriple n k).IsConnected :=
  isConnected_iff.mpr ⟨hn, isPretransitive_of_finRotate_mem (σ0_mem_monodromyGroup _)⟩

/-- Each component of `cyclicPowTriple n k` is a single `n`-cycle when `k` and `k + 1` are
coprime to `n`. -/
theorem cycleData_cyclicPowTriple (hn : n ≠ 0) (hk : k.Coprime n) (hk' : (k + 1).Coprime n) :
    (cyclicPowTriple n k).cycleData = ({n}, {n}, {n}) := by
  simp only [Prod.ext_iff, cycleData_σ0, cycleData_σ1, cycleData_σinf, cyclicPowTriple_σ0,
    cyclicPowTriple_σ1, cyclicPowTriple_σinf, parts_partition_inv,
    parts_partition_finRotate hn, parts_partition_finRotate_pow hn hk,
    parts_partition_finRotate_pow hn hk', and_self]

end PermutationTriple

namespace ConnectedIsoClass

open PermutationTriple

variable {n : ℕ}

/-- For exponents below the degree, the triples `cyclicPowTriple n j` and `cyclicPowTriple n k`
are isomorphic only when `j = k`: a relabeling fixing the rotation `r` commutes with its
powers. -/
theorem mk_cyclicPowTriple_eq_mk_cyclicPowTriple_iff (hn : n ≠ 0) {j k : ℕ} (hj : j < n)
    (hk : k < n) :
    mk ⟨cyclicPowTriple n j, isConnected_cyclicPowTriple hn⟩ =
        mk ⟨cyclicPowTriple n k, isConnected_cyclicPowTriple hn⟩ ↔ j = k := by
  refine ⟨fun h => ?_, fun h => h ▸ rfl⟩
  obtain ⟨τ, hτ⟩ := mk_eq_mk_iff_exists_smul.mp h
  have hτ' := congrArg Subtype.val hτ
  rw [ConnectedTriple.coe_smul] at hτ'
  have h0 := congrArg PermutationTriple.σ0 hτ'
  have h1 := congrArg PermutationTriple.σ1 hτ'
  simp only [smul_σ0, smul_σ1, cyclicPowTriple_σ0, cyclicPowTriple_σ1] at h0 h1
  rw [← conj_pow, h0] at h1
  have hord := orderOf_finRotate hn
  exact (pow_injOn_Iio_orderOf (x := finRotate n) (by rw [hord]; exact hj)
    (by rw [hord]; exact hk) h1.symm)

end ConnectedIsoClass

namespace PassportSpec

open PermutationTriple

variable {n p : ℕ}

/-- The passport of degree `n` with reference monodromy group the cyclic group generated by
rotation of `Fin n`, and with the single part `n` in each of its three cycle partitions: the
covers it describes are totally ramified over each of `0`, `1` and `∞`. -/
def cyclicTotallyRamified (n : ℕ) : PassportSpec n where
  G := Subgroup.zpowers (finRotate n)
  lam0 := {n}
  lam1 := {n}
  laminf := {n}

@[simp] theorem cyclicTotallyRamified_G :
    (cyclicTotallyRamified n).G = Subgroup.zpowers (finRotate n) := (rfl)

@[simp] theorem cyclicTotallyRamified_lam0 : (cyclicTotallyRamified n).lam0 = {n} := (rfl)

@[simp] theorem cyclicTotallyRamified_lam1 : (cyclicTotallyRamified n).lam1 = {n} := (rfl)

@[simp] theorem cyclicTotallyRamified_laminf : (cyclicTotallyRamified n).laminf = {n} := (rfl)

/-- The triple `cyclicPowTriple n k` has the passport `cyclicTotallyRamified n` when `k` and
`k + 1` are coprime to `n`. -/
theorem hasPassport_cyclicPowTriple (hn : n ≠ 0) {k : ℕ} (hk : k.Coprime n)
    (hk' : (k + 1).Coprime n) :
    HasPassport ⟨cyclicPowTriple n k, isConnected_cyclicPowTriple hn⟩
      (cyclicTotallyRamified n) := by
  have hc := cycleData_cyclicPowTriple hn hk hk'
  refine (hasPassport_iff _ _).mpr ⟨⟨1, ?_⟩, ?_, ?_, ?_⟩
  · simp [monodromyGroup_cyclicPowTriple]
  · rw [hc, cyclicTotallyRamified_lam0]
  · rw [hc, cyclicTotallyRamified_lam1]
  · rw [hc, cyclicTotallyRamified_laminf]

/-- A triple in the passport `cyclicTotallyRamified p` of prime degree whose component over `0`
is the rotation `r` is `(r, r ^ k)` for some `1 ≤ k ≤ p - 2`. -/
theorem exists_eq_cyclicPowTriple_of_hasPassport (hp : p.Prime) {s : ConnectedTriple p}
    (hs : HasPassport s (cyclicTotallyRamified p)) (h0 : s.1.σ0 = finRotate p) :
    ∃ k, 1 ≤ k ∧ k ≤ p - 2 ∧ s.1 = cyclicPowTriple p k := by
  classical
  obtain ⟨⟨τ, hτ⟩, -, h1, hinf⟩ := (hasPassport_iff _ _).mp hs
  rw [cycleData_σ1, cyclicTotallyRamified_lam1] at h1
  rw [cycleData_σinf, cyclicTotallyRamified_laminf] at hinf
  have hord : orderOf (finRotate p) = p := orderOf_finRotate hp.ne_zero
  -- The monodromy group has order `p` and contains `r`, so it is generated by `r`.
  have hcard : Nat.card s.1.monodromyGroup = p := by
    rw [← Subgroup.card_map_of_injective (f := (MulAut.conj τ).toMonoidHom)
      (MulAut.conj τ).injective, hτ, cyclicTotallyRamified_G, Nat.card_zpowers, hord]
  have hle : Subgroup.zpowers (finRotate p) ≤ s.1.monodromyGroup :=
    Subgroup.zpowers_le.mpr (h0 ▸ σ0_mem_monodromyGroup _)
  have heq := Subgroup.eq_of_le_of_card_ge hle (by rw [hcard, Nat.card_zpowers, hord])
  have hmem : s.1.σ1 ∈ Subgroup.zpowers (finRotate p) := heq ▸ σ1_mem_monodromyGroup _
  obtain ⟨k, hk, hk1⟩ := Finset.mem_image.mp (mem_zpowers_iff_mem_range_orderOf.mp hmem)
  rw [Finset.mem_range, hord] at hk
  have hsk : s.1 = cyclicPowTriple p k := ext_of_two h0 hk1.symm
  -- Neither the component over `1` nor the one over `∞` is the identity, which has `p` parts.
  have hne : (1 : Perm (Fin p)).partition.parts ≠ {p} := fun h => by
    have := congrArg Multiset.card h
    rw [parts_partition_one, Multiset.card_replicate, Fintype.card_fin,
      Multiset.card_singleton] at this
    exact hp.one_lt.ne' this
  have hk0 : k ≠ 0 := by
    rintro rfl
    rw [← hk1, pow_zero] at h1
    exact hne h1
  have hkp : k ≠ p - 1 := by
    rintro rfl
    rw [hsk, cyclicPowTriple_σinf_of_lt (by omega), show p - 1 - (p - 1) = 0 by omega,
      pow_zero] at hinf
    exact hne hinf
  exact ⟨k, by omega, by omega, hsk⟩

/-- For prime `p`, the isomorphism classes in the passport `cyclicTotallyRamified p` are those of
the triples `(r, r ^ k, (r ^ (k + 1))⁻¹)` with `1 ≤ k ≤ p - 2`. -/
theorem classSet_cyclicTotallyRamified (hp : p.Prime) :
    (cyclicTotallyRamified p).classSet =
      (Finset.Icc 1 (p - 2)).image fun k =>
        ConnectedIsoClass.mk ⟨cyclicPowTriple p k, isConnected_cyclicPowTriple hp.ne_zero⟩ := by
  ext c
  obtain ⟨t, rfl⟩ := ConnectedIsoClass.mk_surjective c
  rw [mem_classSet, ConnectedIsoClass.hasPassport_mk, Finset.mem_image]
  constructor
  · intro ht
    -- Relabel so that the component over `0` is the rotation `r`.
    have hconj : IsConj (finRotate p) t.1.σ0 := by
      refine partition_eq_of_isConj.mpr (Nat.Partition.ext ?_)
      rw [parts_partition_finRotate hp.ne_zero, ← cycleData_σ0, ((hasPassport_iff _ _).mp ht).2.1,
        cyclicTotallyRamified_lam0]
    obtain ⟨υ, hυ⟩ := isConj_iff.mp hconj
    have hs0 : (υ⁻¹ • t).1.σ0 = finRotate p := by
      rw [ConnectedTriple.coe_smul, smul_σ0, ← hυ]
      group
    obtain ⟨k, hk1, hk2, hk⟩ := exists_eq_cyclicPowTriple_of_hasPassport hp
      ((hasPassport_smul_iff υ⁻¹ t _).mpr ht) hs0
    refine ⟨k, Finset.mem_Icc.mpr ⟨hk1, hk2⟩, ?_⟩
    exact ConnectedIsoClass.mk_eq_mk_iff_exists_smul.mpr ⟨υ⁻¹, Subtype.ext hk⟩
  · rintro ⟨k, hk, hkt⟩
    refine (hasPassport_iff_of_equivalent (ConnectedIsoClass.mk_eq_mk_iff.mp hkt) _).mp ?_
    obtain ⟨hk1, hk2⟩ := Finset.mem_Icc.mp hk
    exact hasPassport_cyclicPowTriple hp.ne_zero
      (Nat.coprime_of_lt_prime (by omega) (by omega) hp).symm
      (Nat.coprime_of_lt_prime (by omega) (by omega) hp).symm

/-- For prime `p`, the passport `cyclicTotallyRamified p` has exactly `p - 2` isomorphism
classes. -/
theorem passportSize_cyclicTotallyRamified (hp : p.Prime) :
    (cyclicTotallyRamified p).passportSize = p - 2 := by
  rw [passportSize_def, classSet_cyclicTotallyRamified hp, Finset.card_image_of_injOn,
    Nat.card_Icc, Nat.add_sub_cancel]
  intro j hj k hk hjk
  rw [Finset.coe_Icc, Set.mem_Icc] at hj hk
  exact (ConnectedIsoClass.mk_cyclicPowTriple_eq_mk_cyclicPowTriple_iff hp.ne_zero
    (by omega) (by omega)).mp hjk

/-- The passport of degree `5` with monodromy `C₅` and cycle partitions `([5], [5], [5])` has
three isomorphism classes, represented by `(r, r, r³)`, `(r, r², r²)` and `(r, r³, r)` for the
rotation `r`. -/
theorem classSet_cyclicTotallyRamified_five :
    (cyclicTotallyRamified 5).classSet =
      {ConnectedIsoClass.mk ⟨cyclicPowTriple 5 1, isConnected_cyclicPowTriple (by decide)⟩,
        ConnectedIsoClass.mk ⟨cyclicPowTriple 5 2, isConnected_cyclicPowTriple (by decide)⟩,
        ConnectedIsoClass.mk ⟨cyclicPowTriple 5 3, isConnected_cyclicPowTriple (by decide)⟩} := by
  rw [classSet_cyclicTotallyRamified Nat.prime_five,
    show Finset.Icc 1 (5 - 2) = {1, 2, 3} by decide, Finset.image_insert, Finset.image_insert,
    Finset.image_singleton]

/-- The passport of degree `5` with monodromy `C₅` and cycle partitions `([5], [5], [5])` has
size three. -/
theorem passportSize_cyclicTotallyRamified_five : (cyclicTotallyRamified 5).passportSize = 3 :=
  passportSize_cyclicTotallyRamified Nat.prime_five

end PassportSpec

end TauCeti
