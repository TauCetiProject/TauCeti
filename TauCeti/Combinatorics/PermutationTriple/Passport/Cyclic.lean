/-!
# Totally ramified passports with cyclic monodromy

Let `r = finRotate n` be cyclic rotation of `Fin n`. The triple `(r, r ^ k, (r ^ (k + 1))⁻¹)` is
`TauCeti.PermutationTriple.cyclicPowTriple n k`; its monodromy group is the cyclic group generated
by `r`. When `k` and `k + 1` are coprime to `n`, each of its three components is a single
`n`-cycle, so the triple lies in the passport `TauCeti.PassportSpec.cyclicTotallyRamified n`:
reference group `⟨r⟩` and cycle partition `[n]` over each of `0`, `1` and `∞`.

For every nonzero `n` this passport is classified completely. A triple in it can be relabeled so
that its component over `0` is `r`; its monodromy group then has order `n` and contains `r`, so it
is `⟨r⟩`, and the component over `1` is `r ^ k` for a unique `k < n`. The other two cycle
partitions say exactly that `k` and `k + 1` are coprime to `n`. Conversely, a relabeling fixing
`r` commutes with every power of `r`, so distinct such exponents below `n` give non-isomorphic
triples. For prime `p`, these exponents are precisely those satisfying `1 ≤ k ≤ p - 2`, and the
passport therefore has exactly `p - 2` isomorphism classes.

In degree `5` this gives the passport with monodromy `C₅` and ordered cycle partitions
`([5], [5], [5])`, whose three classes are represented by `(r, r, r³)`, `(r, r², r²)` and
`(r, r³, r)`. In particular a passport does not determine the isomorphism class of a triple.

## Main declarations

* `TauCeti.PermutationTriple.cyclicPowTriple`: the triple `(r, r ^ k, (r ^ (k + 1))⁻¹)`.
* `TauCeti.PassportSpec.cyclicTotallyRamified`: the passport `(⟨r⟩, [n], [n], [n])`.
* `TauCeti.PassportSpec.classSet_cyclicTotallyRamified`: for nonzero `n`, its isomorphism classes
  are indexed by the `k < n` for which `k` and `k + 1` are coprime to `n`.
* `TauCeti.PassportSpec.passportSize_cyclicTotallyRamified`: for prime `p`, it has `p - 2`
  isomorphism classes.
* `TauCeti.PassportSpec.passportSize_cyclicTotallyRamified_five`: the degree-`5` passport has
  three isomorphism classes.

## References

* S. K. Lando, A. K. Zvonkin, *Graphs on Surfaces and Their Applications*, Encyclopaedia of
  Mathematical Sciences 141, Springer 2004, §1.5.
-/

open Equiv Equiv.Perm

public section

namespace TauCeti

namespace ConnectedIsoClass

open PermutationTriple

variable {n : ℕ}

/-- For exponents below the degree, the triples `cyclicPowTriple n j` and `cyclicPowTriple n k`
are isomorphic only when `j = k`: a relabeling fixing the rotation `r` commutes with its
powers. -/
theorem mk_cyclicPowTriple_eq_mk_cyclicPowTriple_iff {j k : ℕ} (hj : j < n) (hk : k < n) :
    mk ⟨cyclicPowTriple n j, isConnected_cyclicPowTriple
      (Nat.ne_of_gt (Nat.lt_of_le_of_lt (Nat.zero_le j) hj))⟩ =
        mk ⟨cyclicPowTriple n k, isConnected_cyclicPowTriple
          (Nat.ne_of_gt (Nat.lt_of_le_of_lt (Nat.zero_le j) hj))⟩ ↔ j = k := by
  have hn : n ≠ 0 := by omega
  refine ⟨fun h => ?_, fun h => h ▸ rfl⟩
  obtain ⟨τ, hτ⟩ := mk_eq_mk_iff_exists_smul.mp h
  have hτ' := congrArg Subtype.val hτ
  rw [ConnectedTriple.coe_smul] at hτ'
  have h0 := congrArg PermutationTriple.σ0 hτ'
  have h1 := congrArg PermutationTriple.σ1 hτ'
  simp only [smul_σ0, smul_σ1, cyclicPowTriple_σ0, cyclicPowTriple_σ1] at h0 h1
  rw [← conj_pow, h0] at h1
  have hord := orderOf_finRotate hn
  exact (pow_injOn_Iio_orderOf (x := finRotate n) (by rw [hord]; exact hj)
    (by rw [hord]; exact hk) h1.symm)

end ConnectedIsoClass

namespace PassportSpec

open PermutationTriple

variable {n p : ℕ}

/-- The passport of degree `n` with reference monodromy group the cyclic group generated by
rotation of `Fin n`, and with the single part `n` in each of its three cycle partitions: the
covers it describes are totally ramified over each of `0`, `1` and `∞`. -/
def cyclicTotallyRamified (n : ℕ) : PassportSpec n where
  G := Subgroup.zpowers (finRotate n)
  lam0 := {n}
  lam1 := {n}
  laminf := {n}

@[simp] theorem cyclicTotallyRamified_G :
    (cyclicTotallyRamified n).G = Subgroup.zpowers (finRotate n) := (rfl)

@[simp] theorem cyclicTotallyRamified_lam0 : (cyclicTotallyRamified n).lam0 = {n} := (rfl)

@[simp] theorem cyclicTotallyRamified_lam1 : (cyclicTotallyRamified n).lam1 = {n} := (rfl)

@[simp] theorem cyclicTotallyRamified_laminf : (cyclicTotallyRamified n).laminf = {n} := (rfl)

/-- The totally ramified cyclic passport is admissible exactly in nonzero degree. -/
@[simp] theorem isAdmissible_cyclicTotallyRamified :
    (cyclicTotallyRamified n).IsAdmissible ↔ n ≠ 0 := by
  rw [isAdmissible_iff_partition]
  constructor
  · exact fun h => h.1
  · intro hn
    refine ⟨hn, isPretransitive_of_finRotate_mem (Subgroup.mem_zpowers _), ?_⟩
    intro i
    fin_cases i <;> simp <;> omega

/-- The triple `cyclicPowTriple n k` has the passport `cyclicTotallyRamified n` when `k` and
`k + 1` are coprime to `n`. -/
theorem hasPassport_cyclicPowTriple {k : ℕ} (hk : k.Coprime n) (hk' : (k + 1).Coprime n) :
    HasPassport ⟨cyclicPowTriple n k, isConnected_cyclicPowTriple (by
      rintro rfl
      rw [Nat.coprime_zero_right] at hk hk'
      omega)⟩
      (cyclicTotallyRamified n) := by
  have hc := cycleData_cyclicPowTriple hk hk'
  refine (hasPassport_iff _ _).mpr ⟨⟨1, ?_⟩, ?_, ?_, ?_⟩
  · simp [monodromyGroup_cyclicPowTriple]
  · rw [hc, cyclicTotallyRamified_lam0]
  · rw [hc, cyclicTotallyRamified_lam1]
  · rw [hc, cyclicTotallyRamified_laminf]

/-- A triple in the passport `cyclicTotallyRamified n` whose component over `0` is rotation is
`(r, r ^ k)` for a unique-range exponent whose two relevant powers are full cycles. -/
theorem exists_eq_cyclicPowTriple_of_hasPassport {s : ConnectedTriple n}
    (hs : HasPassport s (cyclicTotallyRamified n)) (h0 : s.1.σ0 = finRotate n) :
    ∃ k, k < n ∧ k.Coprime n ∧ (k + 1).Coprime n ∧ s.1 = cyclicPowTriple n k := by
  classical
  have hn : n ≠ 0 := s.2.ne_zero
  obtain ⟨⟨τ, hτ⟩, -, h1, hinf⟩ := (hasPassport_iff _ _).mp hs
  rw [cycleData_σ1, cyclicTotallyRamified_lam1] at h1
  rw [cycleData_σinf, cyclicTotallyRamified_laminf] at hinf
  have hord : orderOf (finRotate n) = n := orderOf_finRotate hn
  -- The monodromy group has order `n` and contains `r`, so it is generated by `r`.
  have hcard : Nat.card s.1.monodromyGroup = n := by
    rw [← Subgroup.card_map_of_injective (f := (MulAut.conj τ).toMonoidHom)
      (MulAut.conj τ).injective, hτ, cyclicTotallyRamified_G, Nat.card_zpowers, hord]
  have hle : Subgroup.zpowers (finRotate n) ≤ s.1.monodromyGroup :=
    Subgroup.zpowers_le.mpr (h0 ▸ σ0_mem_monodromyGroup _)
  have heq := Subgroup.eq_of_le_of_card_ge hle (by rw [hcard, Nat.card_zpowers, hord])
  have hmem : s.1.σ1 ∈ Subgroup.zpowers (finRotate n) := heq ▸ σ1_mem_monodromyGroup _
  obtain ⟨k, hk, hk1⟩ := Finset.mem_image.mp (mem_zpowers_iff_mem_range_orderOf.mp hmem)
  rw [Finset.mem_range, hord] at hk
  have hsk : s.1 = cyclicPowTriple n k :=
    ext_of_two (by simpa using h0) (by simpa using hk1.symm)
  have hkcop : k.Coprime n := (parts_partition_finRotate_pow_eq_singleton_iff hn).mp (by rwa [hk1])
  have hk'cop : (k + 1).Coprime n := by
    apply (parts_partition_finRotate_pow_eq_singleton_iff hn).mp
    rw [← parts_partition_inv, ← cyclicPowTriple_σinf, ← hsk]
    exact hinf
  exact ⟨k, hk, hkcop, hk'cop, hsk⟩

/-- In nonzero degree, the isomorphism classes in `cyclicTotallyRamified n` are indexed by the
exponents `k < n` for which both `k` and `k + 1` are coprime to `n`. -/
theorem classSet_cyclicTotallyRamified (hn : n ≠ 0) :
    (cyclicTotallyRamified n).classSet =
      ((Finset.range n).filter fun k => k.Coprime n ∧ (k + 1).Coprime n).image fun k =>
        ConnectedIsoClass.mk ⟨cyclicPowTriple n k, isConnected_cyclicPowTriple hn⟩ := by
  ext c
  obtain ⟨t, rfl⟩ := ConnectedIsoClass.mk_surjective c
  rw [mem_classSet, ConnectedIsoClass.hasPassport_mk, Finset.mem_image]
  constructor
  · intro ht
    -- Relabel so that the component over `0` is the rotation `r`.
    have hconj : IsConj (finRotate n) t.1.σ0 := by
      refine partition_eq_of_isConj.mpr (Nat.Partition.ext ?_)
      rw [parts_partition_finRotate hn, ← cycleData_σ0, ((hasPassport_iff _ _).mp ht).2.1,
        cyclicTotallyRamified_lam0]
    obtain ⟨υ, hυ⟩ := isConj_iff.mp hconj
    have hs0 : (υ⁻¹ • t).1.σ0 = finRotate n := by
      rw [ConnectedTriple.coe_smul, smul_σ0, ← hυ]
      group
    obtain ⟨k, hk, hkcop, hk'cop, hkt⟩ := exists_eq_cyclicPowTriple_of_hasPassport
      ((hasPassport_smul_iff υ⁻¹ t _).mpr ht) hs0
    refine ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hk, hkcop, hk'cop⟩, ?_⟩
    exact ConnectedIsoClass.mk_eq_mk_iff_exists_smul.mpr ⟨υ⁻¹, Subtype.ext hkt⟩
  · rintro ⟨k, hk, hkt⟩
    refine (hasPassport_iff_of_equivalent (ConnectedIsoClass.mk_eq_mk_iff.mp hkt) _).mp ?_
    obtain ⟨-, hkcop, hk'cop⟩ := Finset.mem_filter.mp hk
    exact hasPassport_cyclicPowTriple hkcop hk'cop

/-- For prime `p`, the general cyclic classification is indexed by the interval
`1 ≤ k ≤ p - 2`. -/
theorem classSet_cyclicTotallyRamified_of_prime (hp : p.Prime) :
    (cyclicTotallyRamified p).classSet =
      (Finset.Icc 1 (p - 2)).image fun k =>
        ConnectedIsoClass.mk ⟨cyclicPowTriple p k, isConnected_cyclicPowTriple hp.ne_zero⟩ := by
  rw [classSet_cyclicTotallyRamified hp.ne_zero]
  congr 1
  ext k
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Icc]
  constructor
  · rintro ⟨hklt, hkcop, hk'cop⟩
    have hk0 : k ≠ 0 := by
      rintro rfl
      have : p = 1 := by simpa [Nat.Coprime] using hkcop
      exact hp.ne_one this
    have hkp : k + 1 ≠ p := by
      intro h
      have : p = 1 := by simpa [h, Nat.Coprime] using hk'cop
      exact hp.ne_one this
    omega
  · rintro ⟨hk1, hk2⟩
    exact ⟨by omega,
      (Nat.coprime_of_lt_prime (by omega) (by omega) hp).symm,
      (Nat.coprime_of_lt_prime (by omega) (by omega) hp).symm⟩

/-- For prime `p`, the passport `cyclicTotallyRamified p` has exactly `p - 2` isomorphism
classes. -/
theorem passportSize_cyclicTotallyRamified (hp : p.Prime) :
    (cyclicTotallyRamified p).passportSize = p - 2 := by
  rw [passportSize_def, classSet_cyclicTotallyRamified_of_prime hp, Finset.card_image_of_injOn,
    Nat.card_Icc, Nat.add_sub_cancel]
  intro j hj k hk hjk
  rw [Finset.coe_Icc, Set.mem_Icc] at hj hk
  exact (ConnectedIsoClass.mk_cyclicPowTriple_eq_mk_cyclicPowTriple_iff
    (by omega) (by omega)).mp hjk

/-- The passport of degree `5` with monodromy `C₅` and cycle partitions `([5], [5], [5])` has
three isomorphism classes, represented by `(r, r, r³)`, `(r, r², r²)` and `(r, r³, r)` for the
rotation `r`. -/
theorem classSet_cyclicTotallyRamified_five :
    (cyclicTotallyRamified 5).classSet =
      {ConnectedIsoClass.mk ⟨cyclicPowTriple 5 1, isConnected_cyclicPowTriple (by decide)⟩,
        ConnectedIsoClass.mk ⟨cyclicPowTriple 5 2, isConnected_cyclicPowTriple (by decide)⟩,
        ConnectedIsoClass.mk ⟨cyclicPowTriple 5 3, isConnected_cyclicPowTriple (by decide)⟩} := by
  have hIcc : Finset.Icc 1 (5 - 2) = {1, 2, 3} := by decide
  rw [classSet_cyclicTotallyRamified_of_prime Nat.prime_five, hIcc, Finset.image_insert,
    Finset.image_insert, Finset.image_singleton]

/-- The passport of degree `5` with monodromy `C₅` and cycle partitions `([5], [5], [5])` has
size three. -/
theorem passportSize_cyclicTotallyRamified_five : (cyclicTotallyRamified 5).passportSize = 3 :=
  passportSize_cyclicTotallyRamified Nat.prime_five

end PassportSpec

end TauCeti
