module

public import Mathlib.Algebra.Group.Equiv.TypeTags
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas
public import Mathlib.Algebra.Group.TypeTags.Hom
public import Mathlib.GroupTheory.NoncommPiCoprod

/-!
# Homomorphisms out of `ℤ^ι`

A homomorphism out of the free abelian group `ι → Multiplicative ℤ` on a finite type `ι` is
determined by the images of the standard generators `Pi.mulSingle i (ofAdd 1)`
(`MonoidHom.pi_ext_mint`), and any family of pairwise commuting elements `τ i` of a group `K` is
the image of the standard generators under `TauCeti.zpowersPiHom τ`, built from Mathlib's
`MonoidHom.noncommPiCoprod` and `zpowersHom`.

The additive counterparts (`AddMonoidHom.pi_ext_int`, `TauCeti.zmultiplesPiHom`) handle `ι → ℤ`,
and both directions package into universal property equivalences (`zpowersPiHomEquiv`,
`zmultiplesPiHomEquiv`) and commutative isomorphisms (`zpowersPiHomMulEquiv`,
`zmultiplesPiHomAddEquiv`).

## Main declarations

* `MonoidHom.pi_ext_mint`: homomorphisms out of `ι → Multiplicative ℤ` agreeing on the standard
  generators are equal.
* `TauCeti.zpowersPiHom τ`: the homomorphism `(ι → Multiplicative ℤ) →* K` sending the `i`-th
  standard generator to `τ i`.
* `TauCeti.commute_zpowersPiHom`: an element commuting with every `τ i` commutes with the image of
  `zpowersPiHom τ`.
* `AddMonoidHom.pi_ext_int`, `TauCeti.zmultiplesPiHom`, `TauCeti.addCommute_zmultiplesPiHom`:
  additive counterparts for `ι → ℤ`, linked via `TauCeti.toMultiplicative_zmultiplesPiHom`.
* `TauCeti.zpowersPiHomEquiv`, `TauCeti.zmultiplesPiHomEquiv`, `TauCeti.zpowersPiHomMulEquiv`,
  `TauCeti.zmultiplesPiHomAddEquiv`: universal property equivalences and commutative isomorphisms.
-/

public section

open scoped BigOperators

variable {ι : Type*}

namespace MonoidHom

/-- Homomorphisms out of `ι → Multiplicative ℤ` agree when they agree on the standard
generators. -/
theorem pi_ext_mint [Finite ι] [DecidableEq ι] {M : Type*} [Monoid M]
    {f g : (ι → Multiplicative ℤ) →* M}
    (h : ∀ i, f (Pi.mulSingle i (.ofAdd 1)) = g (Pi.mulSingle i (.ofAdd 1))) : f = g :=
  pi_ext fun i x => by
    simpa using DFunLike.congr_fun
      (ext_mint (f := f.comp (mulSingle (fun _ => Multiplicative ℤ) i))
        (g := g.comp (mulSingle (fun _ => Multiplicative ℤ) i)) (h i)) x

end MonoidHom

namespace AddMonoidHom

/-- Additive homomorphisms out of `ι → ℤ` agree when they agree on the standard generators. -/
theorem pi_ext_int [Finite ι] [DecidableEq ι] {M : Type*} [AddMonoid M]
    {f g : (ι → ℤ) →+ M} (h : ∀ i, f (Pi.single i 1) = g (Pi.single i 1)) : f = g :=
  pi_ext fun i x => by
    simpa using DFunLike.congr_fun
      (ext_int (f := f.comp (single (fun _ => ℤ) i)) (g := g.comp (single (fun _ => ℤ) i)) (h i)) x

end AddMonoidHom

namespace TauCeti

section Multiplicative

variable [Fintype ι] {K : Type*} [Group K]

/-- The homomorphism `(ι → Multiplicative ℤ) →* K` sending the `i`-th standard generator to `τ i`,
for pairwise commuting `τ i`. -/
def zpowersPiHom (τ : ι → K) (hτ : ∀ i j, Commute (τ i) (τ j)) :
    (ι → Multiplicative ℤ) →* K :=
  MonoidHom.noncommPiCoprod (fun i => zpowersHom K (τ i)) <| by
    intro i j _ x y
    simpa only [zpowersHom_apply] using (hτ i j).zpow_zpow x.toAdd y.toAdd

@[simp] theorem zpowersPiHom_mulSingle [DecidableEq ι] (τ : ι → K)
    (hτ : ∀ i j, Commute (τ i) (τ j)) (i : ι) (n : Multiplicative ℤ) :
    zpowersPiHom τ hτ (Pi.mulSingle i n) = τ i ^ n.toAdd :=
  -- `simp` does not unify the `ι`-indexed family of `noncommPiCoprod_mulSingle` with the constant
  -- family `ι → Multiplicative ℤ`, so apply it directly.
  (MonoidHom.noncommPiCoprod_mulSingle _ i _).trans (by simp)

/-- `zpowersPiHom` evaluates on `v` as the noncommutative product of `τ i ^ (v i).toAdd`. -/
theorem zpowersPiHom_apply (τ : ι → K) (hτ : ∀ i j, Commute (τ i) (τ j))
    (v : ι → Multiplicative ℤ) : zpowersPiHom τ hτ v = Finset.univ.noncommProd
      (fun i => τ i ^ (v i).toAdd) (fun i _ j _ _ => (hτ i j).zpow_zpow _ _) :=
  MonoidHom.noncommPiCoprod_apply _ v

/-- Postcomposing `zpowersPiHom τ` with a group homomorphism `f` gives `zpowersPiHom (f ∘ τ)`. -/
theorem comp_zpowersPiHom {L : Type*} [Group L] (f : K →* L) (τ : ι → K)
    (hτ : ∀ i j, Commute (τ i) (τ j))
    (hτ' : ∀ i j, Commute (f (τ i)) (f (τ j)) := fun i j => (hτ i j).map f) :
    f.comp (zpowersPiHom τ hτ) = zpowersPiHom (f ∘ τ) hτ' := by
  classical exact MonoidHom.pi_ext_mint fun _ => by simp

/-- The image of `zpowersPiHom τ` is the subgroup generated by the `τ i`. -/
theorem range_zpowersPiHom (τ : ι → K) (hτ : ∀ i j, Commute (τ i) (τ j)) :
    (zpowersPiHom τ hτ).range = Subgroup.closure (Set.range τ) := by
  refine (MonoidHom.noncommPiCoprod_range _).trans ?_
  simp [Subgroup.range_zpowersHom, Subgroup.zpowers_eq_closure, ← Subgroup.closure_iUnion]

/-- `zpowersPiHom τ` is surjective if and only if the `τ i` generate `K`. -/
theorem surjective_zpowersPiHom_iff (τ : ι → K) (hτ : ∀ i j, Commute (τ i) (τ j)) :
    Function.Surjective (zpowersPiHom τ hτ) ↔ Subgroup.closure (Set.range τ) = ⊤ := by
  rw [← MonoidHom.range_eq_top, range_zpowersPiHom]

/-- An element commuting with every `τ i` commutes with the whole image of `zpowersPiHom τ`. -/
theorem commute_zpowersPiHom {τ : ι → K} {hτ : ∀ i j, Commute (τ i) (τ j)} {x : K}
    (hx : ∀ i, Commute x (τ i)) (v : ι → Multiplicative ℤ) :
    Commute x (zpowersPiHom τ hτ v) :=
  MonoidHom.commute_noncommPiCoprod _ (fun i k => by
    simpa only [zpowersHom_apply] using (hx i).zpow_right k.toAdd) v

variable [DecidableEq ι]

/-- **Universal property of `ι → Multiplicative ℤ`:** homomorphisms `(ι → Multiplicative ℤ) →* K`
correspond bijectively to families of pairwise commuting elements of `K`. -/
def zpowersPiHomEquiv :
    {τ : ι → K // ∀ i j, Commute (τ i) (τ j)} ≃ ((ι → Multiplicative ℤ) →* K) where
  toFun τ := zpowersPiHom τ.1 τ.2
  invFun f := ⟨fun i => f (Pi.mulSingle i (.ofAdd 1)), fun i j =>
    (eq_or_ne i j).elim (· ▸ Commute.refl _) fun h =>
      (Pi.mulSingle_commute h (.ofAdd 1) (.ofAdd 1)).map f⟩
  left_inv _ := Subtype.ext <| funext fun _ => by simp
  right_inv _ := MonoidHom.pi_ext_mint fun _ => by simp

@[simp] theorem zpowersPiHomEquiv_apply (τ : {τ : ι → K // ∀ i j, Commute (τ i) (τ j)}) :
    zpowersPiHomEquiv τ = zpowersPiHom τ.1 τ.2 := (rfl)
@[simp] theorem zpowersPiHomEquiv_symm_apply (f : (ι → Multiplicative ℤ) →* K) (i : ι) :
    (zpowersPiHomEquiv.symm f).1 i = f (Pi.mulSingle i (.ofAdd 1)) := (rfl)

end Multiplicative

section Additive

variable [Fintype ι] {A : Type*} [AddGroup A]

/-- The additive homomorphism `(ι → ℤ) →+ A` sending the `i`-th standard generator to `τ i`,
for pairwise additively commuting `τ i`. -/
def zmultiplesPiHom (τ : ι → A) (hτ : ∀ i j, AddCommute (τ i) (τ j)) : (ι → ℤ) →+ A :=
  AddMonoidHom.noncommPiCoprod (fun i => zmultiplesHom A (τ i)) fun i j _ x y => by
    simpa only [zmultiplesHom_apply] using (hτ i j).zsmul_zsmul x y

@[simp] theorem zmultiplesPiHom_single [DecidableEq ι] (τ : ι → A)
    (hτ : ∀ i j, AddCommute (τ i) (τ j)) (i : ι) (n : ℤ) :
    zmultiplesPiHom τ hτ (Pi.single i n) = n • τ i :=
  (AddMonoidHom.noncommPiCoprod_single _ i _).trans (by simp)

/-- `zmultiplesPiHom` evaluates on `v` as the noncommutative sum of `v i • τ i`. -/
theorem zmultiplesPiHom_apply (τ : ι → A) (hτ : ∀ i j, AddCommute (τ i) (τ j)) (v : ι → ℤ) :
    zmultiplesPiHom τ hτ v = Finset.univ.noncommSum
      (fun i => v i • τ i) (fun i _ j _ _ => (hτ i j).zsmul_zsmul _ _) :=
  AddMonoidHom.noncommPiCoprod_apply _ v

/-- Postcomposing `zmultiplesPiHom τ` with `f : A →+ B` gives `zmultiplesPiHom (f ∘ τ)`. -/
theorem comp_zmultiplesPiHom {B : Type*} [AddGroup B] (f : A →+ B) (τ : ι → A)
    (hτ : ∀ i j, AddCommute (τ i) (τ j))
    (hτ' : ∀ i j, AddCommute (f (τ i)) (f (τ j)) := fun i j => (hτ i j).map f) :
    f.comp (zmultiplesPiHom τ hτ) = zmultiplesPiHom (f ∘ τ) hτ' := by
  classical exact AddMonoidHom.pi_ext_int fun _ => by simp

/-- The image of `zmultiplesPiHom τ` is the additive subgroup generated by the `τ i`. -/
theorem range_zmultiplesPiHom (τ : ι → A) (hτ : ∀ i j, AddCommute (τ i) (τ j)) :
    (zmultiplesPiHom τ hτ).range = AddSubgroup.closure (Set.range τ) :=
  (AddMonoidHom.noncommPiCoprod_range _).trans <| by
    simp [AddSubgroup.range_zmultiplesHom, AddSubgroup.zmultiples_eq_closure,
      ← AddSubgroup.closure_iUnion]

/-- `zmultiplesPiHom τ` is surjective if and only if the `τ i` generate `A`. -/
theorem surjective_zmultiplesPiHom_iff (τ : ι → A) (hτ : ∀ i j, AddCommute (τ i) (τ j)) :
    Function.Surjective (zmultiplesPiHom τ hτ) ↔ AddSubgroup.closure (Set.range τ) = ⊤ := by
  rw [← AddMonoidHom.range_eq_top, range_zmultiplesPiHom]

/-- An element additively commuting with each `τ i` commutes with the image of `zmultiplesPiHom`. -/
theorem addCommute_zmultiplesPiHom {τ : ι → A} {hτ : ∀ i j, AddCommute (τ i) (τ j)} {x : A}
    (hx : ∀ i, AddCommute x (τ i)) (v : ι → ℤ) : AddCommute x (zmultiplesPiHom τ hτ v) :=
  AddMonoidHom.addCommute_noncommPiCoprod _ (fun i k => by
    simpa only [zmultiplesHom_apply] using (hx i).zsmul_right k) v

/-- `zmultiplesPiHom` and `zpowersPiHom` correspond under `toMultiplicative` and
`MulEquiv.funMultiplicative`. -/
theorem toMultiplicative_zmultiplesPiHom (τ : ι → A) {hτ : ∀ i j, AddCommute (τ i) (τ j)}
    {hτ' : ∀ i j, Commute (Multiplicative.ofAdd (τ i)) (Multiplicative.ofAdd (τ j))} :
    (zmultiplesPiHom τ hτ).toMultiplicative =
      (zpowersPiHom (fun i => Multiplicative.ofAdd (τ i)) hτ').comp
        (MulEquiv.funMultiplicative ι ℤ).toMonoidHom := by
  classical
  have h : (zmultiplesPiHom τ hτ).toMultiplicative.comp
      (MulEquiv.funMultiplicative ι ℤ).symm.toMonoidHom =
      zpowersPiHom (fun i => Multiplicative.ofAdd (τ i)) hτ' :=
    MonoidHom.pi_ext_mint fun _ => by simp [Pi.mulSingle_multiplicativeOfAdd_eq (M := fun _ => ℤ)]
  simpa [MonoidHom.comp_assoc] using
    congrArg (·.comp (MulEquiv.funMultiplicative ι ℤ).toMonoidHom) h

variable [DecidableEq ι]

/-- **Universal property of `ι → ℤ`:** additive homomorphisms `(ι → ℤ) →+ A` correspond bijectively
to families of pairwise additively commuting elements of `A`. -/
def zmultiplesPiHomEquiv : {τ : ι → A // ∀ i j, AddCommute (τ i) (τ j)} ≃ ((ι → ℤ) →+ A) where
  toFun τ := zmultiplesPiHom τ.1 τ.2
  invFun f := ⟨fun i => f (Pi.single i 1), fun i j =>
    (eq_or_ne i j).elim (· ▸ AddCommute.refl _) fun h => (Pi.single_addCommute h 1 1).map f⟩
  left_inv _ := Subtype.ext <| funext fun _ => by simp
  right_inv _ := AddMonoidHom.pi_ext_int fun _ => by simp

@[simp] theorem zmultiplesPiHomEquiv_apply (τ : {τ : ι → A // ∀ i j, AddCommute (τ i) (τ j)}) :
    zmultiplesPiHomEquiv τ = zmultiplesPiHom τ.1 τ.2 := (rfl)
@[simp] theorem zmultiplesPiHomEquiv_symm_apply (f : (ι → ℤ) →+ A) (i : ι) :
    (zmultiplesPiHomEquiv.symm f).1 i = f (Pi.single i 1) := (rfl)

end Additive

section Commutative

variable [Fintype ι] {G : Type*} [CommGroup G] {B : Type*} [AddCommGroup B]

/-- On a commutative group, `zpowersPiHom` evaluates to `∏ i, τ i ^ (v i).toAdd`. -/
theorem zpowersPiHom_apply_eq_prod (τ : ι → G) (hτ : ∀ i j, Commute (τ i) (τ j))
    (v : ι → Multiplicative ℤ) : zpowersPiHom τ hτ v = ∏ i, τ i ^ (v i).toAdd :=
  (zpowersPiHom_apply τ hτ v).trans (Finset.noncommProd_eq_prod _ _)

/-- On an additive commutative group, `zmultiplesPiHom` evaluates to `∑ i, v i • τ i`. -/
theorem zmultiplesPiHom_apply_eq_sum (τ : ι → B) (hτ : ∀ i j, AddCommute (τ i) (τ j))
    (v : ι → ℤ) : zmultiplesPiHom τ hτ v = ∑ i, v i • τ i :=
  (zmultiplesPiHom_apply τ hτ v).trans (Finset.noncommSum_eq_sum _ _)

variable [DecidableEq ι]

/-- Evaluating on standard generators identifies `(ι → G)` with `((ι → Multiplicative ℤ) →* G)`. -/
def zpowersPiHomMulEquiv : (ι → G) ≃* ((ι → Multiplicative ℤ) →* G) where
  toFun τ := zpowersPiHom τ fun _ _ => Commute.all _ _
  invFun f i := f (Pi.mulSingle i (.ofAdd 1))
  left_inv _ := funext fun _ => by simp
  right_inv _ := MonoidHom.pi_ext_mint fun _ => by simp
  map_mul' _ _ := MonoidHom.pi_ext_mint fun _ => by simp

@[simp] theorem zpowersPiHomMulEquiv_apply (τ : ι → G) :
    zpowersPiHomMulEquiv τ = zpowersPiHom τ fun _ _ => Commute.all _ _ := (rfl)
@[simp] theorem zpowersPiHomMulEquiv_symm_apply (f : (ι → Multiplicative ℤ) →* G) (i : ι) :
    zpowersPiHomMulEquiv.symm f i = f (Pi.mulSingle i (.ofAdd 1)) := (rfl)

/-- Evaluating on standard generators identifies `(ι → B)` with `((ι → ℤ) →+ B)`. -/
def zmultiplesPiHomAddEquiv : (ι → B) ≃+ ((ι → ℤ) →+ B) where
  toFun τ := zmultiplesPiHom τ fun _ _ => AddCommute.all _ _
  invFun f i := f (Pi.single i 1)
  left_inv _ := funext fun _ => by simp
  right_inv _ := AddMonoidHom.pi_ext_int fun _ => by simp
  map_add' _ _ := AddMonoidHom.pi_ext_int fun _ => by simp

@[simp] theorem zmultiplesPiHomAddEquiv_apply (τ : ι → B) :
    zmultiplesPiHomAddEquiv τ = zmultiplesPiHom τ fun _ _ => AddCommute.all _ _ := (rfl)
@[simp] theorem zmultiplesPiHomAddEquiv_symm_apply (f : (ι → ℤ) →+ B) (i : ι) :
    zmultiplesPiHomAddEquiv.symm f i = f (Pi.single i 1) := (rfl)

end Commutative

end TauCeti
