/-!
# Representatives of the cyclic centralizers of a group

Call an element `g ≠ 1` of a group `G` *self-centralizing* when its centralizer is the cyclic
group it generates. The cyclic centralizers of nontrivial elements are exactly the subgroups
generated by self-centralizing elements: if `C_G(g) = ⟨c⟩` with `g ≠ 1`, then `c ≠ 1` and
`C_G(c) = ⟨c⟩`. To extend all cyclic centralizers of `G`, Myasnikov and Remeslennikov choose
a set of representatives of the conjugacy classes of these centralizers. This is recorded as a set
`S` of self-centralizing elements, one generator for each chosen centralizer: every
self-centralizing element has a conjugate generating the same subgroup as some `s ∈ S`, and no
two different elements of `S` generate conjugate subgroups, so that this `s` is unique. In a
torsion-free group the first condition says that the element is conjugate to `s` or to `s⁻¹`.
The centralizer `G` of the identity counts only when it is also the centralizer of a nontrivial
element, as in a cyclic group `G = ⟨c⟩` with `c ≠ 1`.

## Main definitions

* `TauCeti.IsCyclicCentralizerRepresentatives S`: `S` is such a set of representatives.

## Main results

* `TauCeti.IsCyclicCentralizerRepresentatives.existsUnique_centralizer_conj_eq_zpowers`: a
  nontrivial element with a cyclic centralizer has a conjugate whose centralizer is generated by
  a representative, and this representative is unique.
* `TauCeti.exists_isCyclicCentralizerRepresentatives`: every group has a set of representatives.
* `TauCeti.exists_isCyclicCentralizerRepresentatives_superset`: a set of self-centralizing
  elements generating pairwise non-conjugate subgroups extends to one.
* `MulEquiv.isCyclicCentralizerRepresentatives_image`: transport along an isomorphism.
* `TauCeti.isCyclicCentralizerRepresentatives_empty_iff`: the empty set is one exactly when no
  nontrivial element has a cyclic centralizer, as in `ℤ²`.
* `TauCeti.isCyclicCentralizerRepresentatives_iff_eq_empty`: in a trivial group, the empty set
  is the only one.
* `TauCeti.isCyclicCentralizerRepresentatives_singleton_of_zpowers_eq_top`: in a nontrivial
  cyclic group, such as `ℤ`, any generator alone is one.

## References

* A. Myasnikov, V. Remeslennikov, D. Serbin, *Regular free length functions on Lyndon's free
  `ℤ[t]`-group `F^{ℤ[t]}`*, Contemp. Math. 378 (2005), 37–77, §2.1.
* A. Myasnikov, V. Remeslennikov, *Exponential groups II: extensions of centralizers and tensor
  completion of CSA-groups*, Internat. J. Algebra Comput. 6 (1996), 687–711.
-/

public section

open Subgroup
open scoped Pointwise

namespace TauCeti

variable {G H : Type*} [Group G] [Group H]

/-- A set `S` of elements of a group is a *set of representatives of the cyclic centralizers*
when its elements are nontrivial and generate their own centralizers, every nontrivial element
generating its own centralizer has a conjugate that generates the same subgroup as some `s ∈ S`,
and no two different elements of `S` generate conjugate subgroups. -/
structure IsCyclicCentralizerRepresentatives (S : Set G) : Prop where
  /-- The representatives are not the identity. -/
  ne_one : ∀ s ∈ S, s ≠ 1
  /-- A representative generates its centralizer. -/
  centralizer_eq_zpowers : ∀ s ∈ S, centralizer {s} = zpowers s
  /-- Every nontrivial element generating its centralizer has a conjugate that generates the
  same subgroup as a representative. -/
  exists_zpowers_conj_eq : ∀ g : G, g ≠ 1 → centralizer {g} = zpowers g →
    ∃ s ∈ S, ∃ x : G, zpowers (x * g * x⁻¹) = zpowers s
  /-- Different representatives do not generate conjugate subgroups. -/
  eq_of_zpowers_conj_eq : ∀ s ∈ S, ∀ t ∈ S, ∀ x : G, zpowers (x * s * x⁻¹) = zpowers t → s = t

namespace IsCyclicCentralizerRepresentatives

variable {S : Set G}

/-- The identity is not a representative of the cyclic centralizers. -/
@[grind →]
theorem one_notMem (hS : IsCyclicCentralizerRepresentatives S) : (1 : G) ∉ S :=
  fun h ↦ hS.ne_one 1 h rfl

/-- If the centralizer of a nontrivial element `g` is cyclic, then it is conjugate to the
subgroup generated by exactly one representative `s`. -/
theorem existsUnique_centralizer_conj_eq_zpowers (hS : IsCyclicCentralizerRepresentatives S)
    {g : G} (hg : g ≠ 1) (hcyc : IsCyclic (centralizer {g})) :
    ∃! s ∈ S, ∃ x : G, centralizer {x * g * x⁻¹} = zpowers s := by
  have hcen (x a : G) : centralizer {x * a * x⁻¹} = (centralizer {a}).map (MulAut.conj x) := by
    simp [MulEquiv.map_centralizer]
  have hzp (x a : G) : zpowers (x * a * x⁻¹) = (zpowers a).map (MulAut.conj x) := by
    simp [MonoidHom.map_zpowers]
  obtain ⟨c, hc⟩ := (centralizer {g}).isCyclic_iff_exists_zpowers_eq.1 hcyc
  obtain ⟨s, hs, x, hx⟩ := hS.exists_zpowers_conj_eq c
    (ne_one_of_mem_zpowers hg (hc.ge (mem_centralizer_singleton_iff.2 rfl)))
    (centralizer_singleton_eq_zpowers_of_centralizer_le hc.ge)
  have hxs : centralizer {x * g * x⁻¹} = zpowers s := by rw [hcen, ← hc, ← hzp, hx]
  refine ⟨s, ⟨hs, x, hxs⟩, fun t ⟨ht, y, hy⟩ ↦ hS.eq_of_zpowers_conj_eq t ht s hs (x * y⁻¹) ?_⟩
  have hxy : x * y⁻¹ * (y * g * y⁻¹) * (x * y⁻¹)⁻¹ = x * g * x⁻¹ := by
    simp [mul_assoc]
  rw [hzp, ← hy, ← hcen, hxy, hxs]

end IsCyclicCentralizerRepresentatives

/-- A set of nontrivial elements generating their centralizers, no two of which generate
conjugate subgroups, extends to a set of representatives of the cyclic centralizers. -/
theorem exists_isCyclicCentralizerRepresentatives_superset {T : Set G} (h1 : ∀ s ∈ T, s ≠ 1)
    (hT : ∀ s ∈ T, centralizer {s} = zpowers s)
    (hconj : ∀ s ∈ T, ∀ t ∈ T, ∀ x : G, zpowers (x * s * x⁻¹) = zpowers t → s = t) :
    ∃ S : Set G, T ⊆ S ∧ IsCyclicCentralizerRepresentatives S := by
  -- `f g` is the conjugacy class of the subgroup generated by `g`; a set of representatives is a
  -- set of self-centralizing elements on which `f` is injective with the largest possible image.
  let f (g : G) : Set (Subgroup G) := MulAction.orbit (ConjAct G) (zpowers g)
  have hf (g t : G) : f g = f t ↔ ∃ x : G, zpowers (x * t * x⁻¹) = zpowers g := by
    simp [f, MulAction.orbit_eq_iff, mem_orbit_conjAct_iff, MonoidHom.map_zpowers]
  obtain ⟨S, hTS, hSK, himage, hinj⟩ := Set.InjOn.exists_subset_injOn_subset_range_eq
    (f := f) (s := {g | g ≠ 1 ∧ centralizer {g} = zpowers g})
    (fun s hs t ht hst ↦ ((hf s t).1 hst).elim fun x hx ↦ (hconj t ht s hs x hx).symm)
    (fun s hs ↦ ⟨h1 s hs, hT s hs⟩)
  refine ⟨S, hTS, ⟨fun s hs ↦ (hSK hs).1, fun s hs ↦ (hSK hs).2, fun g hg hcg ↦ ?_,
    fun s hs t ht x hx ↦ hinj hs ht ((hf t s).2 ⟨x, hx⟩).symm⟩⟩
  obtain ⟨s, hs, hsg⟩ : f g ∈ f '' S := himage ▸ Set.mem_image_of_mem f ⟨hg, hcg⟩
  exact ⟨s, hs, (hf s g).1 hsg⟩

/-- Every group has a set of representatives of its cyclic centralizers. -/
theorem exists_isCyclicCentralizerRepresentatives (G : Type*) [Group G] :
    ∃ S : Set G, IsCyclicCentralizerRepresentatives S :=
  (exists_isCyclicCentralizerRepresentatives_superset (T := (∅ : Set G)) (by simp) (by simp)
    (by simp)).imp fun _ ↦ And.right

/-- The image of a set of representatives of the cyclic centralizers under an isomorphism is
one. -/
theorem IsCyclicCentralizerRepresentatives.image_mulEquiv {S : Set G}
    (hS : IsCyclicCentralizerRepresentatives S) (e : G ≃* H) :
    IsCyclicCentralizerRepresentatives (e '' S) := by
  have hmap (K L : Subgroup G) : K.map (e : G →* H) = L.map e ↔ K = L :=
    (map_injective e.injective).eq_iff
  have hz (a b : G) : zpowers (e a) = zpowers (e b) ↔ zpowers a = zpowers b := by
    simpa [MonoidHom.map_zpowers] using hmap (zpowers a) (zpowers b)
  have hc (g : G) : centralizer {e g} = zpowers (e g) ↔ centralizer {g} = zpowers g := by
    simpa [MonoidHom.map_zpowers, MulEquiv.map_centralizer] using hmap (centralizer {g}) (zpowers g)
  have hconj (x g : G) : e x * e g * (e x)⁻¹ = e (x * g * x⁻¹) := by simp
  refine ⟨?_, ?_, fun g hg hcg ↦ ?_, ?_⟩
  · rintro _ ⟨s, hs, rfl⟩
    simpa using hS.ne_one s hs
  · rintro _ ⟨s, hs, rfl⟩
    exact (hc s).2 (hS.centralizer_eq_zpowers s hs)
  · obtain ⟨g, rfl⟩ := e.surjective g
    obtain ⟨s, hs, x, hx⟩ := hS.exists_zpowers_conj_eq g (by simpa using hg) ((hc g).1 hcg)
    exact ⟨e s, Set.mem_image_of_mem e hs, e x, by rwa [hconj, hz]⟩
  · rintro _ ⟨s, hs, rfl⟩ _ ⟨t, ht, rfl⟩ x hx
    obtain ⟨x, rfl⟩ := e.surjective x
    exact congrArg e (hS.eq_of_zpowers_conj_eq s hs t ht x (by rwa [hconj, hz] at hx))

/-- The empty set is a set of representatives of the cyclic centralizers exactly when no
nontrivial element has a cyclic centralizer, as in the trivial group or in `ℤ²`. -/
theorem isCyclicCentralizerRepresentatives_empty_iff :
    IsCyclicCentralizerRepresentatives (∅ : Set G) ↔
      ∀ g : G, g ≠ 1 → ¬IsCyclic (centralizer {g}) :=
  ⟨fun h g hg hcyc ↦ (h.existsUnique_centralizer_conj_eq_zpowers hg hcyc).exists.elim
      fun _ hs ↦ hs.1,
    fun h ↦ ⟨by simp, by simp, fun g hg hcg ↦ (h g hg (hcg ▸ inferInstance)).elim, by simp⟩⟩

/-- In a trivial group, the empty set is the only set of representatives of the cyclic
centralizers. -/
@[simp]
theorem isCyclicCentralizerRepresentatives_iff_eq_empty [Subsingleton G] {S : Set G} :
    IsCyclicCentralizerRepresentatives S ↔ S = ∅ := by
  refine ⟨fun hS ↦ Set.eq_empty_of_forall_notMem fun s hs ↦
    hS.ne_one s hs (Subsingleton.elim s 1), ?_⟩
  rintro rfl
  exact isCyclicCentralizerRepresentatives_empty_iff.2 fun g hg ↦ (hg (Subsingleton.elim g 1)).elim

/-- In a cyclic group, a nontrivial generator alone is a set of representatives of the cyclic
centralizers. -/
theorem isCyclicCentralizerRepresentatives_singleton_of_zpowers_eq_top {g : G} (hg : g ≠ 1)
    (htop : zpowers g = ⊤) : IsCyclicCentralizerRepresentatives {g} := by
  have hcent (x : G) : centralizer {x} = ⊤ := by
    refine eq_top_iff.2 fun y _ ↦ mem_centralizer_singleton_iff.2 ?_
    obtain ⟨a, rfl⟩ := mem_zpowers_iff.1 (htop ▸ mem_top x)
    obtain ⟨b, rfl⟩ := mem_zpowers_iff.1 (htop ▸ mem_top y)
    exact (Commute.zpow_zpow_self g b a).eq
  exact ⟨by simpa using hg, by simp [hcent, htop],
    fun h _ hch ↦ ⟨g, Set.mem_singleton g, 1, by simpa [htop, hcent] using hch.symm⟩, by simp⟩

/-- In `ℤ`, the generator `1` alone is a set of representatives of the cyclic centralizers. -/
example : IsCyclicCentralizerRepresentatives {Multiplicative.ofAdd (1 : ℤ)} :=
  isCyclicCentralizerRepresentatives_singleton_of_zpowers_eq_top (by decide) <|
    eq_top_iff.2 fun x _ ↦ mem_zpowers_iff.2 ⟨x.toAdd, by simp [← ofAdd_zsmul]⟩

/-- In `ℤ²`, the empty set is a set of representatives of the cyclic centralizers: every
centralizer is the whole group, which is not cyclic. -/
example : IsCyclicCentralizerRepresentatives (∅ : Set (Multiplicative (ℤ × ℤ))) :=
  isCyclicCentralizerRepresentatives_empty_iff.2 fun g _ hcyc ↦ by
    have hg : centralizer {g} = ⊤ := by simp [CommGroup.center_eq_top]
    exact not_isAddCyclic_prod_of_infinite_nontrivial ℤ ℤ <| isCyclic_multiplicative_iff.1 <|
      topEquiv.isCyclic.1 (hg ▸ hcyc)

end TauCeti

namespace MulEquiv

open TauCeti

variable {G H : Type*} [Group G] [Group H]

/-- A group isomorphism carries a set to a set of representatives of the cyclic centralizers
exactly when the set is one. -/
@[simp]
theorem isCyclicCentralizerRepresentatives_image (e : G ≃* H) {S : Set G} :
    IsCyclicCentralizerRepresentatives (e '' S) ↔ IsCyclicCentralizerRepresentatives S :=
  ⟨fun h ↦ by simpa [Set.image_image] using h.image_mulEquiv e.symm, fun h ↦ h.image_mulEquiv e⟩

end MulEquiv
