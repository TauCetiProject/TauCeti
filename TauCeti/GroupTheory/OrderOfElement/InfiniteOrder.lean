module

public import Mathlib.GroupTheory.OrderOfElement

/-!
# Exponents along an element of infinite order

If `u` has infinite order in a group `G`, the powers of `u` act freely on `G` by right
multiplication, so choosing a point in each left coset of the subgroup generated by `u` gives an
exponent function `k : G → ℤ` with `k (x * u) = k x + 1`.

## Main results

* `TauCeti.exists_apply_mul_eq_add_one_of_not_isOfFinOrder`: the exponent function.
-/

public section

namespace TauCeti

open Function

/-- If `u` has infinite order, there is an exponent function `k : G → ℤ` with
`k (x * u) = k x + 1` for every `x`. -/
theorem exists_apply_mul_eq_add_one_of_not_isOfFinOrder {G : Type*} [Group G] {u : G}
    (hu : ¬IsOfFinOrder u) : ∃ k : G → ℤ, ∀ x, k (x * u) = k x + 1 := by
  have hinj : Injective fun n : ℤ ↦ u ^ n := injective_zpow_iff_not_isOfFinOrder.mpr hu
  have hex (x : G) : ∃ n : ℤ, x = (QuotientGroup.mk x : G ⧸ Subgroup.zpowers u).out * u ^ n := by
    obtain ⟨⟨_, m, rfl⟩, hm⟩ := QuotientGroup.mk_out_eq_mul (Subgroup.zpowers u) x
    refine ⟨-m, ?_⟩
    rw [hm, mul_assoc, zpow_neg, mul_inv_cancel, mul_one]
  choose e he using hex
  refine ⟨e, fun x ↦ ?_⟩
  have hmk : (QuotientGroup.mk (x * u) : G ⧸ Subgroup.zpowers u) = QuotientGroup.mk x :=
    QuotientGroup.mk_mul_of_mem _ (Subgroup.mem_zpowers u)
  have h1 := he (x * u)
  rw [hmk] at h1
  have hpow : u ^ e (x * u) = u ^ (e x + 1) := by
    apply mul_left_cancel (a := (QuotientGroup.mk x : G ⧸ Subgroup.zpowers u).out)
    calc _ = x * u := h1.symm
      _ = (QuotientGroup.mk x : G ⧸ Subgroup.zpowers u).out * u ^ e x * u := by rw [← he x]
      _ = _ := by rw [zpow_add_one, mul_assoc]
  exact hinj hpow

end TauCeti
