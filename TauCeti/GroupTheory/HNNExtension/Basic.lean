import TauCeti.Algebra.Group.Subgroup.ZPowers

/-!
# Conjugating the base group by the stable letter of an HNN extension

Let `HNNExtension G A B φ` be the HNN extension of `G` along an isomorphism `φ : A ≃* B` of
subgroups, with stable letter `t`, so that `t * a * t⁻¹ = φ a` for `a ∈ A`. For `u = ±1` write
`toSubgroup A B u` for the associated subgroup of `t ^ u`, which is `A` for `u = 1` and `B` for
`u = -1`; then `x ↦ t ^ (-u) * x * t ^ u` maps `toSubgroup A B (-u)` onto `toSubgroup A B u`.
Britton's lemma (Mathlib's `HNNExtension.ReducedWord.map_fst_eq_and_of_prod_eq`) shows that a
reduced word starting with the letter `t ^ u` conjugates an element `c` of `G` back into `G` only
if its head conjugates `c` into `toSubgroup A B (-u)`. In particular `t * g * t⁻¹` lies in `G`
exactly when `g ∈ A`, and `t⁻¹ * g * t` lies in `G` exactly when `g ∈ B`. Consequently `g ∈ G`
commutes with `t` exactly when `g ∈ A` and `φ g = g`; for the HNN extension along the identity of
`A`, exactly when `g ∈ A`. Since `G` and `t` generate the HNN extension, `g` is central in it
exactly when it is moreover central in `G`.

This controls commutation transitivity in an HNN extension along the identity of `A`. If `c ∈ A`
is nontrivial then `t` commutes with `c`, so if commutation is transitive through `c` then every
element of `G` commuting with `c` commutes with `t` and therefore lies in `A`. Extensions of
centralizers `⟨G, t | [c, t] = 1, c ∈ C_G(u)⟩` therefore have to use the full centralizer
`C_G(u)`: for `u ≠ 1`, replacing it by a smaller subgroup `A ∋ u` with `C_G(u) ⊄ A` produces a
group that is not commutative transitive, hence not CSA. In a torsion-free group this happens
for `A = zpowers u` whenever `u` is a nontrivial proper power, since a root of `u` commutes with
`u` without lying in `zpowers u`.

Conversely, the stable letter can be used to make two elements conjugate: if `a, b ∈ G` have the
same order, the HNN extension of `G` along the isomorphism `⟨a⟩ ≃* ⟨b⟩`, `a ↦ b`, is a group
containing `G` in which `a` and `b` are conjugate. In a torsion-free group all nontrivial elements
have infinite order, so any two of them become conjugate, and at most two such extensions make a
given element a product of a conjugate of `c` and a conjugate of `c'`, for any nontrivial `c` and
`c'`.

## Main results

* `HNNExtension.exists_reducedWord_head_eq_prod_mul`: multiplying the product of a nonempty reduced
  word on the right by an element of `G` gives the product of a reduced word with the same head.
* `HNNExtension.head_inv_mul_mul_head_mem_toSubgroup`: a reduced word starting with `t ^ u`
  conjugates `c ∈ G` back into `G` only if its head conjugates `c` into the associated subgroup of
  `t ^ (-u)`.
* `HNNExtension.exists_t_zpow_conj_eq_of`: `t ^ u` conjugates the associated subgroup of
  `t ^ (-u)` into that of `t ^ u`.
* `HNNExtension.t_mul_of_mul_inv_t_mem_range_iff`: `t * g * t⁻¹ ∈ G ↔ g ∈ A`.
* `HNNExtension.inv_t_mul_of_mul_t_mem_range_iff`: `t⁻¹ * g * t ∈ G ↔ g ∈ B`.
* `HNNExtension.commute_of_t_iff`: `g` commutes with `t` iff `g ∈ A` and `φ g = g`.
* `HNNExtension.commute_of_t_iff_mem`: along the identity of `A`, `g` commutes with `t` iff
  `g ∈ A`.
* `HNNExtension.of_mem_center_iff`: `g` is central in the HNN extension iff it is central in `G`,
  lies in `A` and is fixed by `φ`; for instance the generator of `⟨a, t | t a t⁻¹ = a⟩` is
  central (`HNNExtension.of_ofAdd_one_mem_center`).
* `HNNExtension.centralizer_le_of_isCommTransitive`: if the HNN extension along the identity of
  `A` is commutative transitive, then `A` contains the centralizer in `G` of each of its
  nontrivial elements.
* `HNNExtension.not_isCommTransitive_zpowers_of_isProperPower`: the HNN extension along the
  identity of the cyclic subgroup generated by a proper power of infinite order is not commutative
  transitive.
* `HNNExtension.exists_injective_isConj_of_orderOf_eq`: two elements of the same order become
  conjugate in a group containing `G`.
* `HNNExtension.exists_injective_isConj_of_ne_one`: two nontrivial elements of a torsion-free
  group `G` become conjugate in some group containing `G`.
* `HNNExtension.exists_injective_conj_mul_conj_eq`: for nontrivial `c` and `c'` in a torsion-free
  group `G`, each element of `G` is a product of a conjugate of `c` and a conjugate of `c'` in some
  group containing `G`.

## References

* R. C. Lyndon, P. E. Schupp, *Combinatorial Group Theory*, Springer (1977), Chapter IV, §2
  (Britton's lemma) and Theorem 2.1 (the base group embeds in an HNN extension).
* O. Kharlampovich, A. Myasnikov, *Irreducible affine varieties over a free group. I*,
  J. Algebra 200 (1998), §1, Definition 5 (free extensions of centralizers).
-/

public section

open Subgroup

namespace HNNExtension

variable {G : Type*} [Group G] {A B : Subgroup G} {φ : A ≃* B}

/-- Multiplying the product of a reduced word with at least one letter on the right by an element
of the base group gives the product of a reduced word with the same head. -/
theorem exists_reducedWord_head_eq_prod_mul (w : NormalWord.ReducedWord G A B)
    (hw : w.toList ≠ []) (c : G) : ∃ w' : NormalWord.ReducedWord G A B,
      w'.head = w.head ∧ w'.prod φ = w.prod φ * of c := by
  obtain ⟨L, p, hL⟩ := (List.eq_nil_or_concat w.toList).resolve_left hw
  have hchain := w.chain
  rw [hL, List.concat_eq_append, List.isChain_append] at hchain
  refine ⟨⟨w.head, L ++ [(p.1, p.2 * c)], List.isChain_append.2
    ⟨hchain.1, List.isChain_singleton _, fun a ha b hb => ?_⟩⟩, rfl, ?_⟩
  · obtain rfl : b = (p.1, p.2 * c) := by simpa using hb.symm
    exact hchain.2.2 a ha p (by simp)
  · simp [NormalWord.ReducedWord.prod, hL, mul_assoc]

/-- If a reduced word starts with the letter `t ^ u`, its product conjugates an element `c` of the
base group back into the base group only if its head conjugates `c` into the associated subgroup
of `t ^ (-u)`. -/
theorem head_inv_mul_mul_head_mem_toSubgroup {w : NormalWord.ReducedWord G A B} {u : ℤˣ} {g : G}
    {L : List (ℤˣ × G)} (hw : w.toList = (u, g) :: L) {c : G}
    (hc : (w.prod φ)⁻¹ * of c * w.prod φ ∈ (of : G →* HNNExtension G A B φ).range) :
    w.head⁻¹ * c * w.head ∈ toSubgroup A B (-u) := by
  obtain ⟨c', hc'⟩ := hc
  obtain ⟨w', hw'h, hw'⟩ := exists_reducedWord_head_eq_prod_mul (φ := φ) w (by simp [hw]) c'
  have h := (ReducedWord.map_fst_eq_and_of_prod_eq φ (w₁ := { w with head := c * w.head })
    (w₂ := w') ?_).2 u (by simp [hw])
  · simpa [hw'h, mul_assoc] using inv_mem h
  · rw [hw', hc']
    simp only [NormalWord.ReducedWord.prod, map_mul]
    group

/-- Conjugating by `t ^ u` carries the associated subgroup of `t ^ (-u)` into the associated
subgroup of `t ^ u`. -/
theorem exists_t_zpow_conj_eq_of (u : ℤˣ) {x : G} (hx : x ∈ toSubgroup A B (-u)) :
    ∃ y ∈ toSubgroup A B u,
      (t : HNNExtension G A B φ) ^ (-(u : ℤ)) * of x * t ^ (u : ℤ) = of y := by
  rcases Int.units_eq_one_or u with rfl | rfl
  · exact ⟨φ.symm ⟨x, hx⟩, (φ.symm ⟨x, hx⟩).property, by simp [equiv_symm_eq_conj]⟩
  · have hx' : x ∈ A := by simpa using hx
    exact ⟨φ ⟨x, hx'⟩, (φ ⟨x, hx'⟩).property, by simp [equiv_eq_conj]⟩

/-- The stable letter conjugates `g` into the base group exactly when `g ∈ A`. -/
theorem t_mul_of_mul_inv_t_mem_range_iff {g : G} :
    t * of g * t⁻¹ ∈ (of : G →* HNNExtension G A B φ).range ↔ g ∈ A := by
  refine ⟨fun h => ?_, fun hg => ⟨φ ⟨g, hg⟩, equiv_eq_conj (φ := φ) ⟨g, hg⟩⟩⟩
  -- `t⁻¹` is the product of the reduced word with head `1` and the single letter `t ^ (-1)`.
  simpa using head_inv_mul_mul_head_mem_toSubgroup (c := g)
    (w := ⟨1, [(-1, 1)], List.isChain_singleton _⟩) rfl
    (by simpa [NormalWord.ReducedWord.prod] using h)

/-- The inverse of the stable letter conjugates `g` into the base group exactly when `g ∈ B`. -/
theorem inv_t_mul_of_mul_t_mem_range_iff {g : G} :
    t⁻¹ * of g * t ∈ (of : G →* HNNExtension G A B φ).range ↔ g ∈ B := by
  refine ⟨fun h => ?_, fun hg => ⟨φ.symm ⟨g, hg⟩, equiv_symm_eq_conj (φ := φ) ⟨g, hg⟩⟩⟩
  -- `t` is the product of the reduced word with head `1` and the single letter `t ^ 1`.
  simpa using head_inv_mul_mul_head_mem_toSubgroup (c := g)
    (w := ⟨1, [(1, 1)], List.isChain_singleton _⟩) rfl
    (by simpa [NormalWord.ReducedWord.prod] using h)

/-- An element of the base group commutes with the stable letter exactly when it lies in `A`
and is fixed by `φ`. -/
theorem commute_of_t_iff {g : G} :
    Commute (of g : HNNExtension G A B φ) t ↔ ∃ hg : g ∈ A, (φ ⟨g, hg⟩ : G) = g := by
  have key : Commute (of g : HNNExtension G A B φ) t ↔
      (t * of g * t⁻¹ : HNNExtension G A B φ) = of g := by
    rw [mul_inv_eq_iff_eq_mul, commute_iff_eq, eq_comm]
  rw [key]
  constructor
  · intro h
    have hg : g ∈ A := t_mul_of_mul_inv_t_mem_range_iff.1 ⟨g, h.symm⟩
    refine ⟨hg, of_injective (φ := φ) ?_⟩
    rw [equiv_eq_conj (φ := φ) ⟨g, hg⟩, h]
  · rintro ⟨hg, hφ⟩
    rw [← equiv_eq_conj (φ := φ) ⟨g, hg⟩, hφ]

/-- In the HNN extension along the identity of `A`, an element of the base group commutes with
the stable letter exactly when it lies in `A`. -/
@[simp]
theorem commute_of_t_iff_mem {g : G} :
    Commute (of g : HNNExtension G A A (MulEquiv.refl A)) t ↔ g ∈ A := by
  simp [commute_of_t_iff]

/-- An element of the base group is central in the HNN extension exactly when it is central in
the base group, lies in `A` and is fixed by `φ`. -/
theorem of_mem_center_iff {z : G} :
    of z ∈ center (HNNExtension G A B φ) ↔ z ∈ center G ∧ ∃ hz : z ∈ A, (φ ⟨z, hz⟩ : G) = z := by
  refine ⟨fun h => ⟨mem_center_iff.2 fun g => of_injective (φ := φ) ?_,
    commute_of_t_iff.1 (mem_center_iff.1 h t).symm⟩, fun ⟨hz, hzt⟩ => mem_center_iff.2 fun x => ?_⟩
  · simpa using mem_center_iff.1 h (of g)
  · induction x using induction_on with
    | of g => simpa using congrArg of (mem_center_iff.1 hz g)
    | t => exact (commute_of_t_iff.2 hzt).symm
    | mul x y hx hy => exact (Commute.mul_left hx hy).eq
    | inv x hx => exact (Commute.inv_left hx).eq

/-- In the HNN extension `⟨a, t | t a t⁻¹ = a⟩` of an infinite cyclic group `⟨a⟩` along the
identity of `⟨a⟩`, the generator `a` is central. -/
theorem of_ofAdd_one_mem_center :
    of (Multiplicative.ofAdd (1 : ℤ)) ∈ center
      (HNNExtension (Multiplicative ℤ) ⊤ ⊤ (MulEquiv.refl _)) :=
  of_mem_center_iff.2 ⟨mem_center_iff.2 fun g => mul_comm g _, mem_top _, rfl⟩

/-- If the HNN extension along the identity of `A` is commutative transitive, then `A` contains
the centralizer in `G` of each of its nontrivial elements. -/
theorem centralizer_le_of_isCommTransitive
    (h : Group.IsCommTransitive (HNNExtension G A A (MulEquiv.refl A))) {c : G} (hcA : c ∈ A)
    (hc : c ≠ 1) : centralizer {c} ≤ A := by
  intro x hx
  rw [← commute_of_t_iff_mem]
  -- `of x` commutes with `of c ≠ 1`, which commutes with `t`.
  refine (Group.isCommTransitive_iff _).1 h _ (of c) _ ?_ ?_ (commute_of_t_iff_mem.2 hcA)
  · rwa [Ne, map_eq_one_iff _ (of_injective (φ := MulEquiv.refl A))]
  · exact ((commute_iff_eq x c).2 (mem_centralizer_singleton_iff.1 hx)).map of

/-- The HNN extension along the identity of `zpowers u` for a proper power `u` of infinite order
is not commutative transitive: a root of `u` commutes with `u`, and `u` with the stable letter,
but the root does not commute with the stable letter. In a torsion-free group, every nontrivial
element has infinite order. -/
theorem not_isCommTransitive_zpowers_of_isProperPower {u : G}
    (hu : TauCeti.IsProperPower u) (hfin : ¬IsOfFinOrder u) :
    ¬ Group.IsCommTransitive
      (HNNExtension G (zpowers u) (zpowers u) (MulEquiv.refl (zpowers u))) := fun h =>
  TauCeti.not_isProperPower_of_zpowers_eq_centralizer hfin
    (le_antisymm (zpowers_le_centralizer_singleton u) (centralizer_le_of_isCommTransitive h
      (mem_zpowers _) fun hu1 => hfin (hu1 ▸ IsOfFinOrder.one))) hu

section Conjugate

universe u

variable {G : Type u} [Group G]

/-- Two elements of the same order of a group `G` are conjugate in a group containing `G`: the HNN
extension of `G` along the isomorphism `⟨a⟩ ≃* ⟨b⟩`, `a ↦ b`, whose stable letter conjugates `a`
to `b`. -/
theorem exists_injective_isConj_of_orderOf_eq {a b : G} (h : orderOf a = orderOf b) :
    ∃ (P : Type u) (_ : Group P) (ι : G →* P), Function.Injective ι ∧ IsConj (ι a) (ι b) := by
  refine ⟨HNNExtension G _ _ (zpowersMulEquivOfOrderOfEq h), inferInstance, of, of_injective _,
    isConj_iff.2 ⟨t, ?_⟩⟩
  simpa using (equiv_eq_conj (φ := zpowersMulEquivOfOrderOfEq h) ⟨a, mem_zpowers a⟩).symm

variable [IsMulTorsionFree G]

/-- Two nontrivial elements of a torsion-free group `G` are conjugate in a group containing `G`,
since both have infinite order. -/
theorem exists_injective_isConj_of_ne_one {a b : G} (ha : a ≠ 1) (hb : b ≠ 1) :
    ∃ (P : Type u) (_ : Group P) (ι : G →* P), Function.Injective ι ∧ IsConj (ι a) (ι b) :=
  exists_injective_isConj_of_orderOf_eq <| by
    rw [orderOf_eq_zero (not_isOfFinOrder_of_isMulTorsionFree ha),
      orderOf_eq_zero (not_isOfFinOrder_of_isMulTorsionFree hb)]

/-- For nontrivial elements `c`, `c'` of a torsion-free group `G`, each `g ∈ G` is the product of
a conjugate of `c` and a conjugate of `c'` in some group containing `G` (depending on `g`). -/
theorem exists_injective_conj_mul_conj_eq {c c' : G} (hc : c ≠ 1) (hc' : c' ≠ 1) (g : G) :
    ∃ (P : Type u) (_ : Group P) (ι : G →* P), Function.Injective ι ∧
      ∃ k k' : P, k * ι c * k⁻¹ * (k' * ι c' * k'⁻¹) = ι g := by
  rcases eq_or_ne c g with rfl | hg
  · -- `g = c`: conjugate `c` to `c²` and then `c'` to `c⁻¹`
    obtain ⟨P₁, _, ι₁, hι₁, hk₁⟩ :=
      exists_injective_isConj_of_ne_one hc ((pow_eq_one_iff_left two_ne_zero).not.2 hc)
    obtain ⟨k₁, hk₁⟩ := isConj_iff.1 hk₁
    obtain ⟨P, _, ι₂, hι₂, hk₂⟩ := exists_injective_isConj_of_orderOf_eq (a := ι₁ c')
      (b := ι₁ c⁻¹) (by
        rw [orderOf_injective ι₁ hι₁, orderOf_injective ι₁ hι₁,
          orderOf_eq_zero (not_isOfFinOrder_of_isMulTorsionFree hc'),
          orderOf_eq_zero (not_isOfFinOrder_of_isMulTorsionFree (inv_ne_one.2 hc))])
    obtain ⟨k₂, hk₂⟩ := isConj_iff.1 hk₂
    refine ⟨P, _, ι₂.comp ι₁, hι₂.comp hι₁, ι₂ k₁, k₂, ?_⟩
    calc ι₂ k₁ * (ι₂.comp ι₁) c * (ι₂ k₁)⁻¹ * (k₂ * (ι₂.comp ι₁) c' * k₂⁻¹)
        = ι₂ (k₁ * ι₁ c * k₁⁻¹) * (k₂ * ι₂ (ι₁ c') * k₂⁻¹) := by simp
      _ = (ι₂.comp ι₁) c := by rw [hk₁, hk₂]; simp [sq, mul_assoc]
  · obtain ⟨P, _, ι, hι, hk⟩ := exists_injective_isConj_of_ne_one hc' (inv_mul_eq_one.not.2 hg)
    obtain ⟨k, hk⟩ := isConj_iff.1 hk
    exact ⟨P, _, ι, hι, 1, k, by simp [hk]⟩

end Conjugate

end HNNExtension
