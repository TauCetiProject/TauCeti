module

public import Mathlib.GroupTheory.HNNExtension
public import Mathlib.GroupTheory.PushoutI

/-!
# Doubles embed in HNN extensions

For a subgroup `A` of a group `G`, the *double* of `G` along `A` is the amalgamated product
`G ∗_A G` of two copies of `G` along `A`, here `Monoid.PushoutI fun _ : Bool => A.subtype`. It
embeds in the HNN extension `⟨G, t | t a t⁻¹ = a, a ∈ A⟩` of `G` along the identity of `A`: the
first copy of `G` maps identically, the second is conjugated by `t`, and the image is the subgroup
generated by `G` and `t G t⁻¹`. For `A` the centralizer of an element `u`, the HNN extension is the
extension `G ∗_A (A × ⟨t⟩)` of the centralizer of `u`. This is how Champetier and Guirardel prove
that the double of a free group along a maximal cyclic subgroup is fully residually free
(Corollary 3.6, due to B. Baumslag), which applies to the closed orientable surface group of genus
two.

## Main definitions

* `HNNExtension.ofDouble A`: the homomorphism `G ∗_A G →* ⟨G, t | t a t⁻¹ = a, a ∈ A⟩`.

## Main results

* `HNNExtension.ofDouble_injective`: the double `G ∗_A G` embeds in the HNN extension.
* `HNNExtension.range_ofDouble`: its image is the subgroup generated by `G` and `t G t⁻¹`.

## Implementation notes

Injectivity does not go through normal forms. The HNN extension acts on the double, `g ∈ G` by
left multiplication by the first copy of `g` and `t` by the automorphism exchanging the two copies,
which fixes `A`. Through `ofDouble`, every element of the double acts by left multiplication by
itself, so it is recovered as the image of `1`.

## References

* B. Baumslag, *Residually free groups*, Proc. London Math. Soc. (3) 17 (1967), 402–418.
* C. Champetier, V. Guirardel, *Limit groups as limits of free groups*, Israel J. Math. 146
  (2005), §3.2, Corollary 3.6 and its proof.
-/

public section

namespace HNNExtension

variable {G : Type*} [Group G] (A : Subgroup G)

/-- The homomorphism from the double `G ∗_A G` of `G` along `A` to the HNN extension
`⟨G, t | t a t⁻¹ = a, a ∈ A⟩` of `G` along the identity of `A`: the first copy of `G` maps
identically and the second is conjugated by the stable letter, `g ↦ t * g * t⁻¹`. -/
def ofDouble :
    Monoid.PushoutI (fun _ : Bool => A.subtype) →* HNNExtension G A A (MulEquiv.refl A) :=
  Monoid.PushoutI.lift (fun b => cond b ((MulAut.conj t).toMonoidHom.comp of) of)
    (of.comp A.subtype) fun b => by
      cases b <;> ext <;> simp [t_mul_of]

@[simp]
theorem ofDouble_of_false (g : G) : ofDouble A (Monoid.PushoutI.of false g) = of g := by
  simp [ofDouble]

@[simp]
theorem ofDouble_of_true (g : G) : ofDouble A (Monoid.PushoutI.of true g) = t * of g * t⁻¹ := by
  simp [ofDouble]

@[simp]
theorem ofDouble_base (a : A) : ofDouble A (Monoid.PushoutI.base _ a) = of (a : G) := by
  simp [ofDouble]

/-- The two copies of an element of `A` agree in the double `G ∗_A G`. -/
private theorem pushoutI_of_true_coe (a : A) :
    (Monoid.PushoutI.of (φ := fun _ : Bool => A.subtype) true (a : G)) =
      Monoid.PushoutI.of false (a : G) :=
  (Monoid.PushoutI.of_apply_eq_base _ true a).trans
    (Monoid.PushoutI.of_apply_eq_base _ false a).symm

/-- The automorphism of the double `G ∗_A G` exchanging its two copies of `G`. -/
private def swap :
    Monoid.PushoutI (fun _ : Bool => A.subtype) →* Monoid.PushoutI (fun _ : Bool => A.subtype) :=
  Monoid.PushoutI.lift (fun b => Monoid.PushoutI.of (φ := fun _ : Bool => A.subtype) (!b))
    (Monoid.PushoutI.base _) fun b => Monoid.PushoutI.of_comp_eq_base (!b)

private theorem swap_of (b : Bool) (g : G) :
    swap A (Monoid.PushoutI.of b g) = Monoid.PushoutI.of (!b) g := by
  simp [swap]

private theorem swap_swap (x : Monoid.PushoutI (fun _ : Bool => A.subtype)) :
    swap A (swap A x) = x := by
  have h : (swap A).comp (swap A) = .id _ :=
    Monoid.PushoutI.hom_ext_nonempty fun b => MonoidHom.ext fun g => by simp [swap_of]
  exact DFunLike.congr_fun h x

/-- The double `G ∗_A G` embeds in the HNN extension of `G` along the identity of `A`. This holds
for every subgroup `A`; Champetier and Guirardel use it for a maximal cyclic subgroup of a free
group. -/
theorem ofDouble_injective : Function.Injective (ofDouble A) := by
  -- The HNN extension acts on the double: `G` by left multiplication through the first copy,
  -- the stable letter by exchanging the two copies.
  let τ : Equiv.Perm (Monoid.PushoutI (fun _ : Bool => A.subtype)) :=
    Function.Involutive.toPerm (swap A) (swap_swap A)
  have hτ (z) : τ z = swap A z := rfl
  have hτ' (z) : τ.symm z = swap A z := rfl
  let Φ : HNNExtension G A A (MulEquiv.refl A) →* Equiv.Perm _ :=
    lift ((MulAction.toPermHom _ _).comp (Monoid.PushoutI.of (φ := fun _ : Bool => A.subtype)
      false)) τ fun a => Equiv.ext fun z => by
        simp [hτ, swap_of, pushoutI_of_true_coe]
  -- Through `ofDouble`, every element of the double acts by left multiplication.
  have hΦ : Φ.comp (ofDouble A) = MulAction.toPermHom _ _ :=
    Monoid.PushoutI.hom_ext_nonempty fun b => MonoidHom.ext fun g => Equiv.ext fun z => by
      cases b <;> simp [Φ, hτ, hτ', swap_of, swap_swap]
  refine Function.Injective.of_comp (f := Φ) ?_
  rw [← MonoidHom.coe_comp, hΦ, MulAction.coe_toPermHom]
  exact MulAction.toPerm_injective

/-- The image of the double `G ∗_A G` in the HNN extension is the subgroup generated by `G` and
`t G t⁻¹`. -/
theorem range_ofDouble :
    (ofDouble A).range = of.range ⊔ of.range.map (MulAut.conj t).toMonoidHom := by
  refine le_antisymm ?_ (sup_le ?_ ?_)
  · rintro _ ⟨x, rfl⟩
    induction x using Monoid.PushoutI.induction_on with
    | of b g =>
      cases b
      · exact Subgroup.mem_sup_left ⟨g, (ofDouble_of_false A g).symm⟩
      · exact Subgroup.mem_sup_right ⟨of g, ⟨g, rfl⟩, by simp⟩
    | base a => exact Subgroup.mem_sup_left ⟨a, (ofDouble_base A a).symm⟩
    | mul x y hx hy => simpa only [map_mul] using mul_mem hx hy
  · rintro _ ⟨g, rfl⟩
    exact ⟨Monoid.PushoutI.of false g, ofDouble_of_false A g⟩
  · rintro _ ⟨_, ⟨g, rfl⟩, rfl⟩
    exact ⟨Monoid.PushoutI.of true g, by simp⟩

end HNNExtension
