module

public import TauCeti.GroupTheory.HNNExtension
public import TauCeti.GroupTheory.HNNExtension.DehnTwist
public import Mathlib.GroupTheory.FreeGroup.Reduce

/-!
# The HNN extension of a free group along a basis element

For a basis element `a` of the free group `F(α)`, the HNN extension of `F(α)` along the identity
of the cyclic subgroup `⟨a⟩` is `⟨α, t ∣ t⁻¹ a t = a⟩`: the stable letter `t` commutes with `a`.
(Mathlib writes the defining relation of an HNN extension as `t a t⁻¹ = φ(a)`; for `φ` the
identity this is the same relation.) For `α = {a, b}` this is `⟨a, b, t ∣ t⁻¹ a t = a⟩`.

This group illustrates Britton's lemma and Dehn twists of HNN extensions.

* Britton's lemma cannot shorten `t⁻¹ b t` for a basis element `b ≠ a`, since `b ∉ ⟨a⟩`: the
  element `t⁻¹ b t` does not lie in `F(α)`. On the other hand `t⁻¹ a² t` reduces to `a²`, and more
  generally `t⁻¹ aᵏ t = aᵏ`.
* The Dehn twist by `a`, which fixes `F(α)` and sends `t` to `t a`, is an automorphism, with
  inverse the twist sending `t` to `t a⁻¹`.

## Main definitions

* `TauCeti.BasisHNNExtension`: the HNN extension `⟨α, t ∣ t⁻¹ a t = a⟩`.
* `TauCeti.BasisHNNExtension.twist`: its Dehn twist `t ↦ t a` by `a`.

## Main results

* `TauCeti.BasisHNNExtension.inv_t_mul_of_mul_t_notMem_range`: `t⁻¹ b t ∉ F(α)` for `b ≠ a`.
* `TauCeti.BasisHNNExtension.inv_t_mul_of_zpow_mul_t`: `t⁻¹ aᵏ t = aᵏ`.
* `TauCeti.BasisHNNExtension.twist_symm_t`: the inverse twist sends `t` to `t a⁻¹`.

## References

* R. C. Lyndon, P. E. Schupp, *Combinatorial Group Theory*, Springer (1977), Chapter IV, §2
  (Britton's lemma).
* V. Guirardel and G. Levitt, *JSJ decompositions of groups*, §5.1.4 and §9 (Dehn twists).
-/

public section

open HNNExtension Subgroup

namespace TauCeti

/-- The HNN extension `⟨α, t ∣ t⁻¹ a t = a⟩` of the free group on `α` along the identity of the
cyclic subgroup `⟨a⟩` generated by the basis element `a`. -/
abbrev BasisHNNExtension {α : Type*} (a : α) : Type _ :=
  HNNExtension (FreeGroup α) (zpowers (FreeGroup.of a)) (zpowers (FreeGroup.of a))
    (MulEquiv.refl _)

namespace BasisHNNExtension

variable {α : Type*} {a b : α}

/-- Britton's lemma cannot shorten `t⁻¹ b t` for a basis element `b ≠ a`: since `b ∉ ⟨a⟩`, the
element `t⁻¹ b t` of `⟨α, t ∣ t⁻¹ a t = a⟩` does not lie in the free group `F(α)`. -/
theorem inv_t_mul_of_mul_t_notMem_range (hab : a ≠ b) :
    (t⁻¹ * of (FreeGroup.of b) * t : BasisHNNExtension a) ∉
      (of : FreeGroup α →* BasisHNNExtension a).range := by
  rw [inv_t_mul_of_mul_t_mem_range_iff, mem_zpowers_iff]
  rintro ⟨k, hk⟩
  -- `aᵏ = b¹` in the free group forces `1 = 0`.
  exact one_ne_zero (FreeGroup.eq_of_of_zpow_eq_of_zpow hab (hk.trans (zpow_one _).symm)).2

/-- In `⟨α, t ∣ t⁻¹ a t = a⟩` conjugation by `t` fixes every power of `a`: `t⁻¹ aᵏ t = aᵏ`. -/
theorem inv_t_mul_of_zpow_mul_t (k : ℤ) :
    (t⁻¹ * of (FreeGroup.of a ^ k) * t : BasisHNNExtension a) = of (FreeGroup.of a ^ k) :=
  (equiv_symm_eq_conj (φ := MulEquiv.refl _) ⟨_, zpow_mem_zpowers _ k⟩).symm

variable (a) in
/-- The Dehn twist of `⟨α, t ∣ t⁻¹ a t = a⟩` by `a`: the automorphism fixing the free group
`F(α)` and sending `t` to `t a`. -/
def twist : MulAut (BasisHNNExtension a) :=
  dehnTwist (MulEquiv.refl _) ⟨FreeGroup.of a,
    le_centralizer (H := zpowers (FreeGroup.of a)) (mem_zpowers _)⟩

/-- The twist by `a` fixes the free group `F(α)`. -/
@[simp] theorem twist_of (g : FreeGroup α) : twist a (of g : BasisHNNExtension a) = of g :=
  dehnTwist_of ..

/-- The twist by `a` sends `t` to `t a`. -/
@[simp] theorem twist_t : twist a (t : BasisHNNExtension a) = t * of (FreeGroup.of a) :=
  dehnTwist_t ..

/-- The inverse of the twist by `a` fixes the free group `F(α)`. -/
@[simp] theorem twist_symm_of (g : FreeGroup α) :
    (twist a).symm (of g : BasisHNNExtension a) = of g := by
  rw [MulEquiv.symm_apply_eq, twist_of]

/-- The inverse of the twist by `a` sends `t` to `t a⁻¹`. -/
@[simp] theorem twist_symm_t :
    (twist a).symm (t : BasisHNNExtension a) = t * (of (FreeGroup.of a))⁻¹ := by
  rw [MulEquiv.symm_apply_eq, map_mul, map_inv, twist_t, twist_of, mul_inv_cancel_right]

end BasisHNNExtension

end TauCeti
