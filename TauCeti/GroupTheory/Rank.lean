module

public import Mathlib.GroupTheory.Rank
public import Mathlib.LinearAlgebra.Dimension.Free
import Mathlib.Algebra.EuclideanDomain.Int

/-!
# The rank of a free abelian group and of a join of subgroups

A finitely generated free abelian group `M` is generated by the vectors of a `ℤ`-basis, so its
minimal number of generators `AddGroup.rank M` is at most `finrank ℤ M`. This bounds the number of
generators of a quotient of a lattice, such as the discriminant group of a full lattice.

The join of two finitely generated subgroups is generated by the union of two generating sets, so
its rank is at most the sum of the two ranks.

## Main statements

* `AddGroup.rank_le_finrank`: `AddGroup.rank M ≤ finrank ℤ M` for a finitely generated free
  abelian group `M`.
* `Subgroup.rank_sup_le`: `rank (H ⊔ K) ≤ rank H + rank K` for finitely generated subgroups
  (`AddSubgroup.rank_sup_le` for additive subgroups).
-/

public section

namespace AddGroup

open Module

/-- A finitely generated free abelian group is generated by `finrank ℤ M` elements, the vectors of
a basis. -/
theorem rank_le_finrank (M : Type*) [AddCommGroup M] [AddGroup.FG M] [Module.Free ℤ M] :
    AddGroup.rank M ≤ finrank ℤ M := by
  classical
  have : Module.Finite ℤ M := Module.Finite.iff_addGroup_fg.mpr inferInstance
  let b := Module.finBasis ℤ M
  refine (AddGroup.rank_le (S := Finset.univ.image b) ?_).trans
    (Finset.card_image_le.trans (by simp))
  simp [← Submodule.span_int_eq_addSubgroupClosure, b.span_eq]

end AddGroup

namespace Subgroup

/-- The rank of the join of two finitely generated subgroups is at most the sum of their ranks. -/
@[to_additive /-- The rank of the join of two finitely generated additive subgroups is at most the
sum of their ranks. -/]
theorem rank_sup_le {G : Type*} [Group G] (H K : Subgroup G) [Group.FG H] [Group.FG K] :
    Group.rank ↥(H ⊔ K) ≤ Group.rank H + Group.rank K := by
  classical
  obtain ⟨S, hS, hSc⟩ := Group.rank_spec H
  obtain ⟨T, hT, hTc⟩ := Group.rank_spec K
  -- the images in `G` of minimal generating sets of `H` and `K` generate `H ⊔ K`
  have h : closure ↑(S.image H.subtype ∪ T.image K.subtype) = H ⊔ K := by
    simp [closure_union, ← MonoidHom.map_closure, hSc, hTc, ← MonoidHom.range_eq_map, -coe_subtype]
  rw [← rank_congr h, ← hS, ← hT]
  exact (rank_closure_finset_le_card _).trans
    ((Finset.card_union_le _ _).trans (add_le_add Finset.card_image_le Finset.card_image_le))

end Subgroup
