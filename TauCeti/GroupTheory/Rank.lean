module

public import Mathlib.Algebra.Module.SpanRank
public import Mathlib.GroupTheory.Rank
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import Mathlib.LinearAlgebra.Dimension.Free
import Mathlib.Algebra.EuclideanDomain.Int

/-!
# Bounds and characterizations for `Group.rank` and `AddGroup.rank`

A finitely generated free abelian group `M` is generated by the vectors of a `ℤ`-basis, so its
minimal number of generators `AddGroup.rank M` is at most `finrank ℤ M`. More generally, for any
finitely generated abelian group `M`, additive-subgroup generation agrees with `ℤ`-submodule span,
identifying `AddGroup.rank M` with `(⊤ : Submodule ℤ M).spanFinrank`.

This file also records subadditivity of `Group.rank` under joins of subgroups and finite direct
products, together with the rank of cyclic groups.

## Main statements

* `AddGroup.rank_eq_spanFinrank_top`: `AddGroup.rank M = (⊤ : Submodule ℤ M).spanFinrank` for a
  finitely generated abelian group `M`.
* `AddGroup.rank_le_finrank`: `AddGroup.rank M ≤ finrank ℤ M` for a finitely generated free
  abelian group `M`.
* `Subgroup.rank_sup_le`: `rank (H ⊔ K) ≤ rank H + rank K` for finitely generated subgroups
  (`AddSubgroup.rank_sup_le` for additive subgroups).
* `Group.rank_prod_le` and `Group.rank_pi_le`: subadditivity of `Group.rank` on binary and finite
  products (`AddGroup.rank_prod_le` and `AddGroup.rank_pi_le` for additive groups).
* `Group.rank_le_one_of_isCyclic` and `Group.rank_eq_one_of_isCyclic`: cyclic groups have rank at
  most `1`, and rank `1` when nontrivial.
-/

public section

namespace Group

/-- The rank of the direct product of two finitely generated groups is at most the sum of their
ranks. -/
@[to_additive rank_prod_le
  /-- The rank of the direct product of two finitely generated additive groups is at most the sum
  of their ranks. -/]
theorem rank_prod_le (G : Type*) (H : Type*) [Group G] [Group H] [Group.FG G] [Group.FG H] :
    Group.rank (G × H) ≤ Group.rank G + Group.rank H := by
  classical
  obtain ⟨S, hS, hSc⟩ := Group.rank_spec G
  obtain ⟨T, hT, hTc⟩ := Group.rank_spec H
  refine (Group.rank_le (S := S.image (MonoidHom.inl G H) ∪ T.image (MonoidHom.inr G H)) ?_).trans
    ?_
  · simp only [Finset.coe_union, Finset.coe_image, Subgroup.closure_union, ← MonoidHom.map_closure,
      hSc, hTc, ← MonoidHom.range_eq_map, eq_top_iff]
    rintro ⟨g, h⟩ _
    have hgh : (g, h) = (g, 1) * (1, h) := by simp
    rw [hgh]
    exact Subgroup.mul_mem_sup ⟨g, rfl⟩ ⟨h, rfl⟩
  · rw [← hS, ← hT]
    exact (Finset.card_union_le _ _).trans (add_le_add Finset.card_image_le Finset.card_image_le)

@[to_additive]
private theorem rank_pi_fin_le :
    ∀ (n : ℕ) (G : Fin n → Type*) [∀ i, Group (G i)] [∀ i, Group.FG (G i)],
      Group.rank (∀ i, G i) ≤ ∑ i, Group.rank (G i)
  | 0, G, _, _ => by rw [Group.rank_eq_zero]; simp
  | n + 1, G, _, _ => by
      let eG : (∀ i : Fin (n + 1), G i) ≃* G 0 × ∀ i : Fin n, G i.succ :=
        { toEquiv := (Fin.consEquiv G).symm
          map_mul' := fun _ _ ↦ rfl }
      calc Group.rank (∀ i : Fin (n + 1), G i)
          = Group.rank (G 0 × ∀ i : Fin n, G i.succ) := Group.rank_congr eG
        _ ≤ Group.rank (G 0) + Group.rank (∀ i : Fin n, G i.succ) := Group.rank_prod_le _ _
        _ ≤ Group.rank (G 0) + ∑ i : Fin n, Group.rank (G i.succ) :=
            add_le_add_right (rank_pi_fin_le n fun i ↦ G i.succ) _
        _ = ∑ i : Fin (n + 1), Group.rank (G i) :=
            (Fin.sum_univ_succ fun i ↦ Group.rank (G i)).symm

/-- The rank of a finite product of finitely generated groups is at most the sum of their ranks. -/
@[to_additive /-- The rank of a finite product of finitely generated additive groups is at most the
sum of their ranks. -/]
theorem rank_pi_le {ι : Type*} [Fintype ι] (G : ι → Type*) [∀ i, Group (G i)]
    [∀ i, Group.FG (G i)] :
    Group.rank (∀ i, G i) ≤ ∑ i, Group.rank (G i) := by
  classical
  let e := (Fintype.equivFin ι).symm
  let eG : (∀ i, G i) ≃* ∀ j, G (e j) :=
    { toEquiv := Equiv.piCongrLeft' G e.symm
      map_mul' := fun _ _ ↦ rfl }
  exact (Group.rank_congr eG).trans_le
    ((rank_pi_fin_le (Fintype.card ι) fun j ↦ G (e j)).trans_eq
      (e.sum_comp fun i ↦ Group.rank (G i)))

/-- Every cyclic group is finitely generated. -/
@[to_additive /-- Every cyclic additive group is finitely generated. -/]
instance (priority := 100) instFGOfIsCyclic (G : Type*) [Group G] [hG : IsCyclic G] :
    Group.FG G := by
  obtain ⟨g, hg⟩ := hG.1
  refine isMulFG_iff.mpr ⟨{g}, ?_⟩
  rw [Finset.coe_singleton, ← Subgroup.zpowers_eq_closure, eq_top_iff]
  intro x _
  exact Subgroup.mem_zpowers_iff.mpr (hg x)

/-- A cyclic group has rank at most `1`. -/
@[to_additive rank_le_one_of_isAddCyclic /-- A cyclic additive group has rank at most `1`. -/]
theorem rank_le_one_of_isCyclic (G : Type*) [Group G] [hG : IsCyclic G] :
    Group.rank G ≤ 1 := by
  obtain ⟨g, hg⟩ := hG.1
  refine (Group.rank_le (S := {g}) ?_).trans_eq (Finset.card_singleton g)
  rw [Finset.coe_singleton, ← Subgroup.zpowers_eq_closure, eq_top_iff]
  intro x _
  exact Subgroup.mem_zpowers_iff.mpr (hg x)

/-- A nontrivial cyclic group has rank `1`. -/
@[to_additive rank_eq_one_of_isAddCyclic
  /-- A nontrivial cyclic additive group has rank `1`. -/]
theorem rank_eq_one_of_isCyclic (G : Type*) [Group G] [IsCyclic G] [Nontrivial G] :
    Group.rank G = 1 :=
  le_antisymm (rank_le_one_of_isCyclic G) (rank_pos G)

end Group

namespace AddGroup

open Module

/-- For a finitely generated abelian group `M`, `AddGroup.rank M` equals the minimum number of
`ℤ`-module generators `(⊤ : Submodule ℤ M).spanFinrank`. -/
theorem rank_eq_spanFinrank_top (M : Type*) [AddCommGroup M] [AddGroup.FG M] :
    AddGroup.rank M = (⊤ : Submodule ℤ M).spanFinrank := by
  classical
  have hfin : Module.Finite ℤ M := Module.Finite.iff_addGroup_fg.mpr inferInstance
  apply le_antisymm
  · obtain ⟨S, hScard, hS⟩ := hfin.fg_top.exists_span_finset_card_eq_spanFinrank
    have hS' : AddSubgroup.closure (S : Set M) = ⊤ := by
      rw [← Submodule.span_int_eq_addSubgroupClosure, hS]
      rfl
    exact (AddGroup.rank_le hS').trans_eq hScard
  · obtain ⟨S, hScard, hS⟩ := AddGroup.rank_spec M
    have hspan : Submodule.span ℤ (S : Set M) = ⊤ :=
      Submodule.toAddSubgroup_injective (by rw [Submodule.span_int_eq_addSubgroupClosure, hS]; rfl)
    calc (⊤ : Submodule ℤ M).spanFinrank
        = (Submodule.span ℤ (S : Set M)).spanFinrank := by rw [hspan]
      _ ≤ (S : Set M).ncard := Submodule.spanFinrank_span_le_ncard_of_finite S.finite_toSet
      _ = S.card := Set.ncard_coe_finset S
      _ = AddGroup.rank M := hScard

/-- A finitely generated free abelian group is generated by `finrank ℤ M` elements, the vectors of
a basis. -/
theorem rank_le_finrank (M : Type*) [AddCommGroup M] [AddGroup.FG M] [Module.Free ℤ M] :
    AddGroup.rank M ≤ finrank ℤ M := by
  classical
  have : Module.Finite ℤ M := Module.Finite.iff_addGroup_fg.mpr inferInstance
  let b := Module.finBasis ℤ M
  refine (AddGroup.rank_le (S := Finset.univ.image b) ?_).trans
    (Finset.card_image_le.trans (by simp))
  simp [← Submodule.span_int_eq_addSubgroupClosure, b.span_eq]

end AddGroup

namespace Subgroup

/-- The rank of the join of two finitely generated subgroups is at most the sum of their ranks. -/
@[to_additive /-- The rank of the join of two finitely generated additive subgroups is at most the
sum of their ranks. -/]
theorem rank_sup_le {G : Type*} [Group G] (H K : Subgroup G) [Group.FG H] [Group.FG K] :
    Group.rank ↥(H ⊔ K) ≤ Group.rank H + Group.rank K := by
  classical
  obtain ⟨S, hS, hSc⟩ := Group.rank_spec H
  obtain ⟨T, hT, hTc⟩ := Group.rank_spec K
  -- the images in `G` of minimal generating sets of `H` and `K` generate `H ⊔ K`
  have h : closure ↑(S.image H.subtype ∪ T.image K.subtype) = H ⊔ K := by
    simp [closure_union, ← MonoidHom.map_closure, hSc, hTc, ← MonoidHom.range_eq_map, -coe_subtype]
  rw [← rank_congr h, ← hS, ← hT]
  exact (rank_closure_finset_le_card _).trans
    ((Finset.card_union_le _ _).trans (add_le_add Finset.card_image_le Finset.card_image_le))

end Subgroup
