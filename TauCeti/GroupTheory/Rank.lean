/-!
# Rank of finitely generated abelian and cyclic groups

`Group.rank G` and `AddGroup.rank M` count the minimal size of a generating set. For a finitely
generated abelian group `M`, subgroup generation agrees with `ℤ`-submodule span, identifying
`AddGroup.rank M` with `(⊤ : Submodule ℤ M).spanFinrank`. Through this bridge:

* a finitely generated free abelian group has `AddGroup.rank M = finrank ℤ M`;
* a finite-dimensional vector space over `ZMod p` has `AddGroup.rank V = finrank (ZMod p) V`;
* `(ι → ZMod (p ^ k))` for prime `p` and `k ≥ 1` has rank `Fintype.card ι`;
* a finite product of finite abelian groups of pairwise coprime orders has rank equal to the
  supremum of the factor ranks.

## Main statements

* `Group.rank_le_one_of_isCyclic`, `Group.rank_of_isCyclic`: cyclic groups are finitely generated of
  rank at most `1`, and `1` when nontrivial.
* `AddGroup.rank_eq_spanFinrank_top`: `AddGroup.rank M = (⊤ : Submodule ℤ M).spanFinrank`.
* `AddGroup.rank_eq_finrank`: `AddGroup.rank M = finrank ℤ M` for a finitely generated free abelian
  group `M`.
* `AddGroup.rank_eq_finrank_zmod`: `AddGroup.rank V = finrank (ZMod p) V` for a finitely generated
  `𝔽_p`-vector space `V`.
* `AddGroup.rank_pi_zmod_prime_pow`: `AddGroup.rank (ι → ZMod (p ^ k)) = Fintype.card ι` for prime
  `p` and `0 < k`.
* `AddGroup.rank_pi_eq_sup_of_coprime_card`, `AddGroup.rank_prod_eq_max_of_coprime_card`: the rank
  of a coprime product of finite abelian groups is the maximum of the factor ranks.
-/

public section

namespace Group

/-- Every cyclic group is finitely generated, since a single generator spans it. -/
@[to_additive /-- Every additive cyclic group is finitely generated, since a single generator spans
it. -/]
instance (priority := 100) instFGOfIsCyclic {G : Type*} [Group G] [IsCyclic G] : Group.FG G := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := G)
  refine Group.fg_iff.mpr ⟨{g}, ?_, Set.finite_singleton g⟩
  rw [← Subgroup.zpowers_eq_closure, eq_top_iff]
  exact fun x _ ↦ hg x

/-- A cyclic group is generated by a single element, so its rank is at most `1`. -/
@[to_additive /-- An additive cyclic group is generated by a single element, so its rank is at
most `1`. -/]
theorem rank_le_one_of_isCyclic (G : Type*) [Group G] [IsCyclic G] :
    Group.rank G ≤ 1 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := G)
  refine (Group.rank_le (S := {g}) ?_).trans (by simp)
  rw [Finset.coe_singleton, ← Subgroup.zpowers_eq_closure, eq_top_iff]
  exact fun x _ ↦ hg x

/-- A nontrivial cyclic group has rank `1`. -/
@[to_additive /-- A nontrivial additive cyclic group has rank `1`. -/]
theorem rank_of_isCyclic (G : Type*) [Group G] [Nontrivial G] [IsCyclic G] :
    Group.rank G = 1 :=
  le_antisymm (rank_le_one_of_isCyclic G) (Group.rank_pos G)

/-- The rank of a product of two finitely generated groups is at most the sum of their ranks. -/
@[to_additive rank_prod_le /-- The rank of a product of two finitely generated additive groups is
at most the sum of their ranks. -/]
theorem rank_prod_le (G H : Type*) [Group G] [Group H] [Group.FG G] [Group.FG H] :
    Group.rank (G × H) ≤ Group.rank G + Group.rank H := by
  classical
  obtain ⟨S, hScard, hS⟩ := Group.rank_spec G
  obtain ⟨T, hTcard, hT⟩ := Group.rank_spec H
  let U : Finset (G × H) := S.image (MonoidHom.inl G H) ∪ T.image (MonoidHom.inr G H)
  have hU : Subgroup.closure (U : Set (G × H)) = ⊤ := by
    rw [Finset.coe_union, Finset.coe_image, Finset.coe_image, Subgroup.closure_union,
      ← MonoidHom.map_closure, ← MonoidHom.map_closure, hS, hT, eq_top_iff]
    rintro ⟨g, h⟩ _
    have hg : (g, (1 : H)) ∈ Subgroup.map (MonoidHom.inl G H) ⊤ := ⟨g, trivial, rfl⟩
    have hh : ((1 : G), h) ∈ Subgroup.map (MonoidHom.inr G H) ⊤ := ⟨h, trivial, rfl⟩
    simpa using mul_mem (Subgroup.mem_sup_left hg) (Subgroup.mem_sup_right hh)
  calc Group.rank (G × H) ≤ U.card := Group.rank_le hU
    _ ≤ (S.image (MonoidHom.inl G H)).card + (T.image (MonoidHom.inr G H)).card :=
      Finset.card_union_le _ _
    _ ≤ S.card + T.card := Nat.add_le_add Finset.card_image_le Finset.card_image_le
    _ = Group.rank G + Group.rank H := by rw [hScard, hTcard]

end Group

namespace AddGroup

open Module

/-- For a finitely generated abelian group, `AddGroup.rank` equals the `ℤ`-submodule `spanFinrank`
of `⊤`, since additive subgroup closure and `ℤ`-linear span coincide. -/
theorem rank_eq_spanFinrank_top (M : Type*) [AddCommGroup M] [AddGroup.FG M] :
    AddGroup.rank M = (⊤ : Submodule ℤ M).spanFinrank := by
  classical
  have : Module.Finite ℤ M := Module.Finite.iff_addGroup_fg.mpr inferInstance
  apply le_antisymm
  · obtain ⟨S, hScard, hSspan⟩ :=
      (Module.Finite.fg_top (R := ℤ) (M := M)).exists_span_finset_card_eq_spanFinrank
    refine (AddGroup.rank_le (S := S) ?_).trans_eq hScard
    rw [← Submodule.span_int_eq_addSubgroupClosure, hSspan]
    rfl
  · obtain ⟨S, hScard, hScl⟩ := AddGroup.rank_spec M
    have hspan : Submodule.span ℤ (S : Set M) = ⊤ := by
      rw [← Submodule.toAddSubgroup_inj, Submodule.span_int_eq_addSubgroupClosure, hScl]
      rfl
    rw [← hScard, ← Set.ncard_coe_finset S, ← hspan]
    exact Submodule.spanFinrank_span_le_ncard_of_finite S.finite_toSet

/-- The minimal number of generators of a finitely generated free abelian group equals its
`ℤ`-rank. -/
theorem rank_eq_finrank (M : Type*) [AddCommGroup M] [AddGroup.FG M] [Module.Free ℤ M] :
    AddGroup.rank M = finrank ℤ M := by
  have : Module.Finite ℤ M := Module.Finite.iff_addGroup_fg.mpr inferInstance
  rw [rank_eq_spanFinrank_top, ← Module.finrank_eq_spanFinrank_of_free]

/-- A finitely generated free abelian group is generated by `finrank ℤ M` elements, the vectors of
a basis. -/
theorem rank_le_finrank (M : Type*) [AddCommGroup M] [AddGroup.FG M] [Module.Free ℤ M] :
    AddGroup.rank M ≤ finrank ℤ M :=
  (rank_eq_finrank M).le

/-- For a finitely generated vector space over `ZMod p`, its additive group rank equals its
dimension over `ZMod p`: `ℤ`-submodules and `ZMod p`-subspaces have the same minimal generating-set
sizes along the surjective quotient map `ℤ →+* ZMod p`. -/
theorem rank_eq_finrank_zmod {p : ℕ} [Fact p.Prime] (V : Type*) [AddCommGroup V] [AddGroup.FG V]
    [Module (ZMod p) V] :
    AddGroup.rank V = finrank (ZMod p) V := by
  have : Module.Finite ℤ V := Module.Finite.iff_addGroup_fg.mpr inferInstance
  have : Module.Finite (ZMod p) V := .of_restrictScalars_finite ℤ (ZMod p) V
  rw [rank_eq_spanFinrank_top]
  -- View the top `ℤ`-submodule as the scalar restriction of the top `ZMod p`-subspace.
  change ((⊤ : Submodule (ZMod p) V).restrictScalars ℤ).spanFinrank = finrank (ZMod p) V
  rw [Submodule.spanFinrank_restrictScalars_eq (R := ℤ) (S := ZMod p) ZMod.intCast_surjective,
    ← Module.finrank_eq_spanFinrank_of_free]

/-- `ZMod n` has additive group rank `0` when `n = 1` and `1` otherwise. -/
@[simp]
theorem rank_zmod (n : ℕ) : AddGroup.rank (ZMod n) = if n = 1 then 0 else 1 := by
  split_ifs with hn
  · subst hn
    exact AddGroup.rank_eq_zero (ZMod 1)
  · rcases eq_or_ne n 0 with rfl | hn0
    · exact AddGroup.rank_of_isAddCyclic (ZMod 0)
    · have : Fact (1 < n) := ⟨Nat.one_lt_iff_ne_zero_and_ne_one.mpr ⟨hn0, hn⟩⟩
      exact AddGroup.rank_of_isAddCyclic (ZMod n)

/-- `ZMod n` has additive group rank `1` whenever `n ≠ 1`. -/
theorem rank_zmod_of_ne_one {n : ℕ} (hn : n ≠ 1) : AddGroup.rank (ZMod n) = 1 := by
  rw [rank_zmod, ite_eq_right hn]

/-- A finite product `(ι → ZMod n)` is generated by the `Fintype.card ι` standard coordinate
generators `Pi.single i 1`. -/
theorem rank_pi_zmod_le (ι : Type*) [Fintype ι] (n : ℕ) :
    AddGroup.rank (ι → ZMod n) ≤ Fintype.card ι := by
  classical
  rw [rank_eq_spanFinrank_top]
  have : Module.Finite ℤ (ι → ZMod n) := Module.Finite.iff_addGroup_fg.mpr inferInstance
  refine (Module.Finite.fg_top.spanFinrank_le_iff_exists_fin_generating_family
    (Fintype.card ι)).mpr ?_
  let e := (Fintype.equivFin ι).symm
  refine ⟨fun k ↦ Pi.single (e k) 1, eq_top_iff.mpr fun x _ ↦ ?_⟩
  rw [← Finset.univ_sum_single x]
  refine Submodule.sum_mem _ fun i _ ↦ ?_
  obtain ⟨m, hm⟩ := ZMod.intCast_surjective (x i)
  have hsingle :
      (Pi.single i (m : ZMod n) : ι → ZMod n) = m • (Pi.single i (1 : ZMod n) : ι → ZMod n) := by
    ext j
    by_cases hij : j = i
    · subst hij
      simp
    · simp [hij]
  rw [← hm, hsingle]
  exact Submodule.smul_mem _ m (Submodule.subset_span ⟨e.symm i, by simp⟩)

/-- A homogeneous prime-power product `ι → ZMod (p ^ k)` with `p` prime and `0 < k` has additive
group rank `Fintype.card ι`: the coordinate generators give the upper bound, and reduction modulo
`p` onto the `ZMod p`-vector space `ι → ZMod p` gives the lower bound. -/
theorem rank_pi_zmod_prime_pow (ι : Type*) [Fintype ι] {p k : ℕ} (hp : p.Prime) (hk : 0 < k) :
    AddGroup.rank (ι → ZMod (p ^ k)) = Fintype.card ι := by
  have : Fact p.Prime := ⟨hp⟩
  apply le_antisymm (rank_pi_zmod_le ι (p ^ k))
  let q : ZMod (p ^ k) →+ ZMod p := (ZMod.castHom (dvd_pow_self p hk.ne') (ZMod p)).toAddMonoidHom
  have hq : Function.Surjective q := ZMod.castHom_surjective (dvd_pow_self p hk.ne')
  let Q : (ι → ZMod (p ^ k)) →+ (ι → ZMod p) :=
    AddMonoidHom.pi fun i ↦ q.comp (Pi.evalAddMonoidHom _ i)
  have hQ : Function.Surjective Q := fun y ↦
    ⟨fun i ↦ Function.surjInv hq (y i), funext fun i ↦ Function.surjInv_eq hq (y i)⟩
  calc Fintype.card ι = finrank (ZMod p) (ι → ZMod p) := (Module.finrank_pi (ZMod p)).symm
    _ = AddGroup.rank (ι → ZMod p) := (rank_eq_finrank_zmod (ι → ZMod p)).symm
    _ ≤ AddGroup.rank (ι → ZMod (p ^ k)) := AddGroup.rank_le_of_surjective Q hQ

/-- `ZMod (p ^ k) × ZMod (p ^ k)` has additive group rank `2` for prime `p` and `0 < k`. -/
theorem rank_prod_zmod_prime_pow {p k : ℕ} (hp : p.Prime) (hk : 0 < k) :
    AddGroup.rank (ZMod (p ^ k) × ZMod (p ^ k)) = 2 := by
  have he := AddGroup.rank_congr (LinearEquiv.finTwoArrow ℤ (ZMod (p ^ k))).symm.toAddEquiv
  rw [he, rank_pi_zmod_prime_pow (Fin 2) hp hk, Fintype.card_fin]

/-- For finite abelian groups of pairwise coprime orders, the minimal number of generators of their
product equals the supremum of the minimal numbers of generators of the factors. -/
theorem rank_pi_eq_sup_of_coprime_card {ι : Type*} [Fintype ι] (M : ι → Type*)
    [∀ i, AddCommGroup (M i)] [∀ i, Finite (M i)]
    (hcop : Pairwise fun i j ↦ (Nat.card (M i)).Coprime (Nat.card (M j))) :
    AddGroup.rank (∀ i, M i) = Finset.univ.sup fun i ↦ AddGroup.rank (M i) := by
  simp_rw [rank_eq_spanFinrank_top]
  exact TauCeti.AddCommGroup.spanFinrank_pi_eq_sup_of_coprime_card M hcop

private def prodFamily (A : Type u) (B : Type v) : Bool → Type (max u v)
  | true => ULift.{v} A
  | false => ULift.{u} B

private instance {A : Type u} {B : Type v} [AddCommGroup A] [AddCommGroup B] (b : Bool) :
    AddCommGroup (prodFamily A B b) := by
  cases b <;> dsimp [prodFamily] <;> infer_instance

private instance {A : Type u} {B : Type v} [Finite A] [Finite B] (b : Bool) :
    Finite (prodFamily A B b) := by
  cases b <;> dsimp [prodFamily] <;> infer_instance

/-- For two finite abelian groups of coprime orders, the minimal number of generators of `A × B` is
`max (AddGroup.rank A) (AddGroup.rank B)`. -/
theorem rank_prod_eq_max_of_coprime_card (A : Type u) (B : Type v) [AddCommGroup A] [AddCommGroup B]
    [Finite A] [Finite B] (hcop : (Nat.card A).Coprime (Nat.card B)) :
    AddGroup.rank (A × B) = max (AddGroup.rank A) (AddGroup.rank B) := by
  let e : A × B ≃+ ∀ b, prodFamily A B b :=
    { toFun := fun x b ↦ match b with | true => ULift.up x.1 | false => ULift.up x.2
      invFun := fun f ↦ ((f true).down, (f false).down)
      left_inv := fun ⟨_, _⟩ ↦ rfl
      right_inv := fun f ↦ funext fun b ↦ by cases b <;> rfl
      map_add' := fun x y ↦ funext fun b ↦ by cases b <;> rfl }
  have hcopM : Pairwise fun i j ↦ (Nat.card (prodFamily A B i)).Coprime
      (Nat.card (prodFamily A B j)) := by
    intro i j hij
    cases i <;> cases j
    · exact absurd rfl hij
    · simpa [prodFamily] using hcop.symm
    · simpa [prodFamily] using hcop
    · exact absurd rfl hij
  have hA : AddGroup.rank (ULift.{v} A) = AddGroup.rank A :=
    AddGroup.rank_congr AddEquiv.ulift
  have hB : AddGroup.rank (ULift.{u} B) = AddGroup.rank B :=
    AddGroup.rank_congr AddEquiv.ulift
  rw [AddGroup.rank_congr e, rank_pi_eq_sup_of_coprime_card (prodFamily A B) hcopM]
  have huniv : (Finset.univ : Finset Bool) = {true, false} := by decide
  rw [huniv, Finset.sup_insert, Finset.sup_singleton]
  exact congrArg₂ max hA hB

end AddGroup
