/-!
# Generator rank of groups and abelian groups

This file develops basic properties of `Group.rank` and `AddGroup.rank`, the minimal number of
generators of a finitely generated group:

* Cyclic groups are finitely generated of generator rank at most `1` (`1` when nontrivial);
  conversely, a finitely generated group is cyclic if and only if its generator rank is at most `1`.
* Generator rank is subadditive on binary and finite indexed products (`Group.rank_prod_le`,
  `Group.rank_pi_le`).
* On a finitely generated abelian group `M`, `AddGroup.rank M` agrees with the `ℤ`-submodule
  generator number `(⊤ : Submodule ℤ M).spanFinrank` (`AddGroup.rank_eq_spanFinrank_top`).
* On a finitely generated free abelian group `M`, `AddGroup.rank M = finrank ℤ M`
  (`AddGroup.rank_eq_finrank`).
* On a finitely generated `ZMod p`-vector space `V` for prime `p`,
  `AddGroup.rank V = finrank (ZMod p) V` (`AddGroup.rank_eq_finrank_zmod`).

## Main statements

* `Group.rank_le_one_iff_isCyclic`, `AddGroup.rank_le_one_iff_isAddCyclic`
* `Group.rank_prod_le`, `Group.rank_pi_le`
* `AddGroup.rank_eq_spanFinrank_top`
* `AddGroup.rank_eq_finrank`, `AddGroup.rank_le_finrank`
* `AddGroup.rank_zmod`, `AddGroup.rank_eq_finrank_zmod`
-/

public section

namespace Group

/-- Every cyclic group is finitely generated. -/
@[to_additive /-- Every cyclic additive group is finitely generated. -/]
instance (priority := 100) instFGOfIsCyclic (G : Type*) [Group G] [IsCyclic G] : Group.FG G := by
  obtain ⟨g, hg⟩ := exists_zpow_surjective G
  refine Group.fg_iff.mpr ⟨{g}, eq_top_iff.mpr fun x _ ↦ ?_, Set.finite_singleton g⟩
  obtain ⟨k, rfl⟩ := hg x
  exact zpow_mem (Subgroup.subset_closure (Set.mem_singleton g)) k

/-- A cyclic group is generated by at most one element. -/
@[to_additive rank_le_one_of_isAddCyclic
  /-- A cyclic additive group is generated by at most one element. -/]
theorem rank_le_one_of_isCyclic (G : Type*) [Group G] [IsCyclic G] : Group.rank G ≤ 1 := by
  obtain ⟨g, hg⟩ := exists_zpow_surjective G
  refine (Group.rank_le (S := {g}) ?_).trans (by simp)
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨k, rfl⟩ := hg x
  exact zpow_mem (Subgroup.subset_closure (by simp)) k

/-- A nontrivial cyclic group has generator rank `1`. -/
@[to_additive rank_eq_one_of_isAddCyclic
  /-- A nontrivial cyclic additive group has generator rank `1`. -/]
theorem rank_eq_one_of_isCyclic (G : Type*) [Group G] [IsCyclic G] [Nontrivial G] :
    Group.rank G = 1 :=
  le_antisymm (rank_le_one_of_isCyclic G) (Group.rank_pos G)

/-- A finitely generated group has generator rank at most `1` if and only if it is cyclic. -/
@[to_additive rank_le_one_iff_isAddCyclic
  /-- A finitely generated additive group has generator rank at most `1` if and only if it is
  cyclic. -/]
theorem rank_le_one_iff_isCyclic (G : Type*) [Group G] [Group.FG G] :
    Group.rank G ≤ 1 ↔ IsCyclic G := by
  refine ⟨fun h ↦ ?_, fun _ ↦ rank_le_one_of_isCyclic G⟩
  obtain ⟨S, hScard, hS⟩ := Group.rank_spec G
  have hle : S.card ≤ 1 := hScard.trans_le h
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hle with h0 | h1
  · rw [Finset.card_eq_zero] at h0
    subst h0
    have : Subsingleton G := by
      simpa [subsingleton_iff_bot_eq_top] using hS
    infer_instance
  · obtain ⟨g, rfl⟩ := Finset.card_eq_one.mp h1
    refine ⟨g, fun x ↦ ?_⟩
    have hx : x ∈ Subgroup.zpowers g := by
      rw [Subgroup.zpowers_eq_closure, ← Finset.coe_singleton, hS]
      trivial
    exact Subgroup.mem_zpowers_iff.mp hx

/-- The generator rank of a product of two finitely generated groups is at most the sum of their
generator ranks. -/
@[to_additive rank_prod_le
  /-- The generator rank of a product of two finitely generated additive groups is at most the sum
  of their generator ranks. -/]
theorem rank_prod_le (G H : Type*) [Group G] [Group H] [Group.FG G] [Group.FG H] :
    Group.rank (G × H) ≤ Group.rank G + Group.rank H := by
  classical
  obtain ⟨S, hScard, hS⟩ := Group.rank_spec G
  obtain ⟨T, hTcard, hT⟩ := Group.rank_spec H
  let U : Finset (G × H) := S.image (MonoidHom.inl G H) ∪ T.image (MonoidHom.inr G H)
  refine (Group.rank_le (S := U) ?_).trans ?_
  · rw [Finset.coe_union, Subgroup.closure_union, Finset.coe_image, Finset.coe_image,
      ← MonoidHom.map_closure, ← MonoidHom.map_closure, hS, hT]
    refine eq_top_iff.mpr fun ⟨g, h⟩ _ ↦ ?_
    have hg : (g, (1 : H)) ∈ (⊤ : Subgroup G).map (MonoidHom.inl G H) := ⟨g, trivial, rfl⟩
    have hh : ((1 : G), h) ∈ (⊤ : Subgroup H).map (MonoidHom.inr G H) := ⟨h, trivial, rfl⟩
    simpa using Subgroup.mul_mem_sup hg hh
  · calc U.card
      _ ≤ (S.image (MonoidHom.inl G H)).card + (T.image (MonoidHom.inr G H)).card :=
        Finset.card_union_le _ _
      _ ≤ S.card + T.card := add_le_add Finset.card_image_le Finset.card_image_le
      _ = Group.rank G + Group.rank H := by rw [hScard, hTcard]

/-- The generator rank of a finite indexed product of finitely generated groups is at most the sum
of the generator ranks of the factors. -/
@[to_additive /-- The generator rank of a finite indexed product of finitely generated additive
groups is at most the sum of the generator ranks of the factors. -/]
theorem rank_pi_le {ι : Type*} [Fintype ι] (G : ι → Type*) [∀ i, Group (G i)]
    [∀ i, Group.FG (G i)] :
    Group.rank (∀ i, G i) ≤ ∑ i, Group.rank (G i) := by
  classical
  choose S hScard hS using fun i ↦ Group.rank_spec (G i)
  let U : Finset (∀ i, G i) := Finset.univ.biUnion fun i ↦ (S i).image (MonoidHom.mulSingle G i)
  refine (Group.rank_le (S := U) ?_).trans ?_
  · rw [Finset.coe_biUnion, Finset.coe_univ, Set.biUnion_univ, Subgroup.closure_iUnion]
    simp_rw [Finset.coe_image, ← MonoidHom.map_closure, hS]
    refine eq_top_iff.mpr fun x _ ↦ ?_
    rw [← Finset.noncommProd_mulSingle x]
    exact Subgroup.noncommProd_mem _ _ fun i _ ↦
      Subgroup.mem_iSup_of_mem i ⟨x i, trivial, rfl⟩
  · calc U.card
      _ ≤ ∑ i, ((S i).image (MonoidHom.mulSingle G i)).card := Finset.card_biUnion_le
      _ ≤ ∑ i, (S i).card := Finset.sum_le_sum fun i _ ↦ Finset.card_image_le
      _ = ∑ i, Group.rank (G i) := by simp_rw [hScard]

end Group

namespace AddGroup

open Module

/-- On a finitely generated abelian group `M`, `AddGroup.rank M` agrees with the `ℤ`-submodule
generator number `(⊤ : Submodule ℤ M).spanFinrank`. -/
theorem rank_eq_spanFinrank_top (M : Type*) [AddCommGroup M] [AddGroup.FG M] :
    AddGroup.rank M = (⊤ : Submodule ℤ M).spanFinrank := by
  classical
  have : Module.Finite ℤ M := Module.Finite.iff_addGroup_fg.mpr inferInstance
  have hfg : (⊤ : Submodule ℤ M).FG := Module.Finite.fg_top
  apply le_antisymm
  · obtain ⟨S, hScard, hS⟩ := hfg.exists_span_finset_card_eq_spanFinrank
    refine (AddGroup.rank_le (S := S) ?_).trans_eq hScard
    rw [← Submodule.span_int_eq_addSubgroupClosure, hS]
    rfl
  · obtain ⟨S, hScard, hS⟩ := AddGroup.rank_spec M
    have hspan : Submodule.span ℤ (S : Set M) = ⊤ :=
      Submodule.toAddSubgroup_injective (by rw [Submodule.span_int_eq_addSubgroupClosure, hS]; rfl)
    rw [← hspan, ← hScard]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite S.finite_toSet).trans_eq
      (Set.ncard_coe_finset S)

/-- The minimal number of generators of a finitely generated free abelian group equals its
`ℤ`-module `finrank`. -/
theorem rank_eq_finrank (M : Type*) [AddCommGroup M] [AddGroup.FG M] [Module.Free ℤ M] :
    AddGroup.rank M = finrank ℤ M := by
  rw [rank_eq_spanFinrank_top, Module.finrank_eq_spanFinrank_of_free]

/-- A finitely generated free abelian group is generated by `finrank ℤ M` elements, the vectors of
a basis. -/
theorem rank_le_finrank (M : Type*) [AddCommGroup M] [AddGroup.FG M] [Module.Free ℤ M] :
    AddGroup.rank M ≤ finrank ℤ M :=
  (rank_eq_finrank M).le

/-- The trivial cyclic group `ZMod 1` has generator rank `0`. -/
@[simp]
theorem rank_zmod_one : AddGroup.rank (ZMod 1) = 0 :=
  rank_eq_zero (ZMod 1)

/-- For `n ≠ 1`, the cyclic group `ZMod n` (including `ZMod 0 = ℤ`) has generator rank `1`. -/
theorem rank_zmod_of_ne_one {n : ℕ} (hn : n ≠ 1) : AddGroup.rank (ZMod n) = 1 := by
  rcases eq_or_ne n 0 with rfl | hn0
  · exact rank_eq_one_of_isAddCyclic (ZMod 0)
  · have : Fact (1 < n) := ⟨Nat.one_lt_iff_ne_zero_and_ne_one.mpr ⟨hn0, hn⟩⟩
    exact rank_eq_one_of_isAddCyclic (ZMod n)

/-- The generator rank of `ZMod n` is `0` for `n = 1` and `1` otherwise. -/
theorem rank_zmod (n : ℕ) : AddGroup.rank (ZMod n) = if n = 1 then 0 else 1 := by
  split_ifs with hn
  · subst hn
    exact rank_zmod_one
  · exact rank_zmod_of_ne_one hn

/-- On a finitely generated vector space over `ZMod p` for prime `p`, the additive generator rank
equals the `ZMod p`-dimension. -/
theorem rank_eq_finrank_zmod {p : ℕ} [Fact p.Prime] (V : Type*) [AddCommGroup V]
    [Module (ZMod p) V] [AddGroup.FG V] :
    AddGroup.rank V = finrank (ZMod p) V := by
  rw [rank_eq_spanFinrank_top, Module.finrank_eq_spanFinrank_of_free]
  exact Submodule.spanFinrank_restrictScalars_eq ZMod.intCast_surjective (⊤ : Submodule (ZMod p) V)

end AddGroup
