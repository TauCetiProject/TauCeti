module

public import Mathlib.GroupTheory.FinitelyPresentedGroup

/-!
# Finite normal generation of kernels does not depend on the generators

Let `f : P →* G` and `g : Q →* G` be two homomorphisms onto the same group that factor through
each other, say `f ∘ h = g` and `g ∘ k = f`. If `k ∘ h` fixes all but finitely many elements of a
generating set of `Q`, and the kernel of `f` is the normal closure of a finite set, then so is the
kernel of `g`: it is normally generated by the images under `k` of the relators of `f`, together
with the finitely many elements `t⁻¹ * k (h t)`. This is the Tietze-transformation argument
showing that finite presentability does not depend on the generating set, stated so that it also
applies to presentations over groups that are not free.

## Main results

* `Subgroup.IsFinitelyNormallyGenerated.ker_of_comp_eq`: the transfer of finite normal generation
  between the kernels of two homomorphisms factoring through each other.
* `Subgroup.IsFinitelyNormallyGenerated.ker_of_ker_comp`: finite normal generation of the kernel
  of `f ∘ π` passes to the kernel of `f` when `π` is surjective.
* `Group.IsFinitelyPresented.isFinitelyNormallyGenerated_ker`: a homomorphism from a finitely
  generated group onto a finitely presented group has a finitely normally generated kernel.

## References

* R. C. Lyndon and P. E. Schupp, *Combinatorial Group Theory*, Chapter II, §2
  (Tietze transformations).
-/

public section

open Function

variable {G P Q : Type*} [Group G] [Group P] [Group Q]

namespace Subgroup.IsFinitelyNormallyGenerated

/-- Let `f : P →* G` and `g : Q →* G` factor through each other via `h : Q →* P` and
`k : P →* Q`, and suppose that `k ∘ h` fixes all but finitely many elements of a generating set
`T` of `Q`. If the kernel of `f` is the normal closure of a finite set, then so is the kernel
of `g`. -/
theorem ker_of_comp_eq {f : P →* G} {g : Q →* G} (hf : f.ker.IsFinitelyNormallyGenerated)
    (h : Q →* P) (k : P →* Q) (hfh : ∀ q, f (h q) = g q) (hgk : ∀ p, g (k p) = f p) {T : Set Q}
    (hT : closure T = ⊤) (hfin : {t ∈ T | k (h t) ≠ t}.Finite) :
    g.ker.IsFinitelyNormallyGenerated := by
  obtain ⟨R, hR, hRf⟩ := hf
  refine ⟨k '' R ∪ (fun t => t⁻¹ * k (h t)) '' {t ∈ T | k (h t) ≠ t},
    (hR.image _).union (hfin.image _), le_antisymm (normalClosure_le_normal ?_) fun q hq => ?_⟩
  · rintro x (⟨r, hr, rfl⟩ | ⟨t, -, rfl⟩)
    · have hr' : r ∈ f.ker := hRf ▸ subset_normalClosure hr
      simpa [MonoidHom.mem_ker, hgk] using hr'
    · simp [MonoidHom.mem_ker, hgk, hfh]
  · set N := normalClosure (k '' R ∪ (fun t => t⁻¹ * k (h t)) '' {t ∈ T | k (h t) ≠ t})
    have key : (QuotientGroup.mk' N).comp (k.comp h) = QuotientGroup.mk' N := by
      refine MonoidHom.eq_of_eqOn_dense hT fun t ht => ?_
      by_cases hkt : k (h t) = t
      · simp [hkt]
      · exact (QuotientGroup.eq.2 (subset_normalClosure (Or.inr ⟨t, ⟨ht, hkt⟩, rfl⟩))).symm
    have hle : normalClosure R ≤ N.comap k :=
      normalClosure_le_normal fun r hr => subset_normalClosure (Or.inl ⟨r, hr, rfl⟩)
    have hq' : k (h q) ∈ N := hle (hRf ▸ by simpa [MonoidHom.mem_ker, hfh] using hq)
    rw [← QuotientGroup.eq_one_iff] at hq' ⊢
    rw [← hq']
    exact (DFunLike.congr_fun key q).symm

/-- If the kernel of `f ∘ π` is the normal closure of a finite set and `π` is surjective, then
the kernel of `f` is the normal closure of a finite set. -/
theorem ker_of_ker_comp {f : P →* G} {π : Q →* P} (hπ : Surjective π)
    (h : (f.comp π).ker.IsFinitelyNormallyGenerated) : f.ker.IsFinitelyNormallyGenerated := by
  rw [← MonoidHom.comap_ker] at h
  simpa [map_comap_eq_self_of_surjective hπ] using h.map hπ

end Subgroup.IsFinitelyNormallyGenerated

namespace Group.IsFinitelyPresented

/-- A homomorphism from a finitely generated group onto a finitely presented group has a kernel
which is the normal closure of a finite set. -/
theorem isFinitelyNormallyGenerated_ker [IsFinitelyPresented G] [Group.FG Q] {g : Q →* G}
    (hg : Surjective g) : g.ker.IsFinitelyNormallyGenerated := by
  obtain ⟨n, φ, hφ, hker⟩ := IsFinitelyPresented.out (G := G)
  obtain ⟨α, _, π, hπ⟩ := Group.fg_iff_exists_freeGroup_hom_surjective_finite.mp ‹Group.FG Q›
  have hc : Surjective (g.comp π) := hg.comp hπ
  have hh : φ.comp (FreeGroup.lift fun a => surjInv hφ (g (π (.of a)))) = g.comp π := by
    ext a; simp [surjInv_eq hφ]
  have hk : (g.comp π).comp (FreeGroup.lift fun i => surjInv hc (φ (.of i))) = φ := by
    ext i; simpa using surjInv_eq hc (φ (.of i))
  exact .ker_of_ker_comp hπ <| hker.ker_of_comp_eq _ _ (DFunLike.congr_fun hh)
    (DFunLike.congr_fun hk) (FreeGroup.closure_range_of α)
    ((Set.finite_range _).subset (Set.sep_subset _ _))

end Group.IsFinitelyPresented
