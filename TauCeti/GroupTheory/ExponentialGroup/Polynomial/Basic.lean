/-!
# Groups with exponents in the polynomial ring `ℤ[t]`

The ring `ℤ[t]` is generated by the indeterminate, so a `ℤ[t]`-group structure on a group `G` is
determined by its `t`-th power `g ↦ g ^ t`. Conversely a map `T : G → G` that commutes with
conjugation and is multiplicative on commuting elements is the `t`-th power of a `ℤ[t]`-group
structure, with `g ^ (∑ nᵢ tⁱ) = ∏ (Tⁱ g) ^ nᵢ`. For `T g = g ^ m` this is `g ^ p = g ^ p(m)`.

## Main definitions

* `TauCeti.IsExponentialGroup.polynomialPow T`: the exponentiation
  `g ^ (∑ nᵢ tⁱ) = ∏ (Tⁱ g) ^ nᵢ`. It is not an instance.

## Main results

* `TauCeti.IsExponentialGroup.polynomialPow_monomial`: `g ^ (a tⁿ) = (Tⁿ g) ^ a`, with the
  special cases `polynomialPow_zero`, `polynomialPow_one`, `polynomialPow_intCast` (or
  `polynomialPow_C`), `polynomialPow_X` and `polynomialPow_X_pow`.
* `TauCeti.IsExponentialGroup.polynomialPow_eq_prod` and
  `TauCeti.IsExponentialGroup.polynomialPow_eq_aeval`: in a commutative group the exponentiation
  is a product over the support, and for an endomorphism `τ` it is the `ℤ[t]`-module structure in
  which `t` acts by `τ`, written multiplicatively.
* `TauCeti.IsExponentialGroup.isExponentialGroup_polynomialPow`: this is a `ℤ[t]`-group structure
  when `T` commutes with conjugation and is multiplicative on commuting elements.
* `TauCeti.IsExponentialGroup.eq_polynomialPow`: every `ℤ[t]`-group structure is the one
  determined by its `t`-th power; `pow_eq_polynomialPow` is the pointwise statement.
* `TauCeti.IsExponentialGroup.polynomialPow_zpow`: for `T g = g ^ m` it is `g ^ p = g ^ p(m)`.
* `MonoidHom.map_polynomialPow`: a homomorphism `φ` with `φ ∘ T' = T ∘ φ` commutes with the
  exponentiations determined by `T'` and `T`.
* `TauCeti.IsExponentialGroup.pow_mem_of_pow_X_mem`: in a `ℤ[t]`-group, a subgroup closed under
  the `t`-th power is closed under every exponent.
* `MonoidHom.map_pow_of_map_pow_X`: a homomorphism of `ℤ[t]`-groups that commutes with the
  `t`-th power commutes with every exponent.

## Implementation notes

The exponentiation `polynomialPow T` is the product over the support of the polynomial in
increasing order of the exponents; for a map `T` as above the factors commute. To prove the
axioms, two commuting elements are placed in a commutative subgroup that `T` maps to itself, the
centralizer of their centralizer. There `T` is an endomorphism `τ`, and the exponentiation is,
written multiplicatively, the `ℤ[t]`-module in which `t` acts by `τ`: the module of Mathlib's
`Module.AEval'`, whose action formula `p • m = aeval τ p m` is used here directly, through
`Polynomial.aeval` and `Module.compHom`. That module is a `ℤ[t]`-group by
`TauCeti.IsExponentialGroup.MultiplicativePow.instIsExponentialGroup`.

## References

* A. G. Myasnikov, V. N. Remeslennikov, *Exponential groups. II. Extensions of centralizers and
  tensor completion of CSA-groups*, Internat. J. Algebra Comput. 6 (1996), Definition 1 and §2.
* A. G. Myasnikov, V. N. Remeslennikov, D. E. Serbin, *Regular free length functions on Lyndon's
  free `ℤ[t]`-group `F^{ℤ[t]}`*, §2.1.
-/

public section

open Polynomial

namespace TauCeti.IsExponentialGroup

variable {G : Type*} [Group G]

/-- The exponentiation by integer polynomials determined by a map `T : G → G`, to be thought of as
the `t`-th power: `g ^ (∑ nᵢ tⁱ) = ∏ (Tⁱ g) ^ nᵢ`, the product in increasing order of `i`. It is
not an instance. -/
@[instance_reducible]
noncomputable def polynomialPow (T : G → G) : Pow G ℤ[X] :=
  ⟨fun g p => (p.support.sort.map fun i => T^[i] g ^ p.coeff i).prod⟩

/-- The defining formula of `polynomialPow`. -/
theorem polynomialPow_def (T : G → G) (g : G) (p : ℤ[X]) :
    letI := polynomialPow T
    g ^ p = (p.support.sort.map fun i => T^[i] g ^ p.coeff i).prod :=
  (rfl)

/-- The exponentiation determined by `T` takes the monomial `a tⁿ` to `(Tⁿ g) ^ a`. -/
@[simp]
theorem polynomialPow_monomial (T : G → G) (g : G) (n : ℕ) (a : ℤ) :
    letI := polynomialPow T
    g ^ monomial n a = T^[n] g ^ a := by
  rcases eq_or_ne a 0 with rfl | ha
  · simp [polynomialPow_def]
  · simp [polynomialPow_def, support_monomial n ha]

/-- The exponentiation determined by `T` takes the zero polynomial to `1`. -/
@[simp]
theorem polynomialPow_zero (T : G → G) (g : G) :
    letI := polynomialPow T
    g ^ (0 : ℤ[X]) = 1 := by
  simp [polynomialPow_def]

/-- The exponentiation determined by `T` takes an integer `a` to `g ^ a`. -/
@[simp]
theorem polynomialPow_intCast (T : G → G) (g : G) (a : ℤ) :
    letI := polynomialPow T
    g ^ (a : ℤ[X]) = g ^ a := by
  simpa using polynomialPow_monomial T g 0 a

/-- The exponentiation determined by `T` takes the constant polynomial `a` to `g ^ a`. -/
theorem polynomialPow_C (T : G → G) (g : G) (a : ℤ) :
    letI := polynomialPow T
    g ^ C a = g ^ a := by
  simp

/-- The exponentiation determined by `T` takes the polynomial `1` to `g`. -/
@[simp]
theorem polynomialPow_one (T : G → G) (g : G) :
    letI := polynomialPow T
    g ^ (1 : ℤ[X]) = g := by
  simpa using polynomialPow_intCast T g 1

/-- The `tⁿ`-th power of the exponentiation determined by `T` is the `n`-th iterate of `T`. -/
@[simp]
theorem polynomialPow_X_pow (T : G → G) (g : G) (n : ℕ) :
    letI := polynomialPow T
    g ^ (X ^ n : ℤ[X]) = T^[n] g := by
  simpa [monomial_one_right_eq_X_pow] using polynomialPow_monomial T g n 1

/-- The `t`-th power of the exponentiation determined by `T` is `T`. -/
@[simp]
theorem polynomialPow_X (T : G → G) (g : G) :
    letI := polynomialPow T
    g ^ (X : ℤ[X]) = T g := by
  simpa using polynomialPow_X_pow T g 1

end TauCeti.IsExponentialGroup

namespace MonoidHom

open TauCeti TauCeti.IsExponentialGroup

variable {G H : Type*} [Group G] [Group H]

/-- A homomorphism `φ` with `φ ∘ T' = T ∘ φ` commutes with the exponentiations determined by `T'`
and `T`. -/
theorem map_polynomialPow {T : G → G} {T' : H → H} (φ : H →* G)
    (hφ : ∀ x, φ (T' x) = T (φ x)) (x : H) (p : ℤ[X]) :
    letI := polynomialPow T
    letI := polynomialPow T'
    φ (x ^ p) = φ x ^ p := by
  simp [polynomialPow_def, map_list_prod, Function.comp_def,
    Function.Semiconj.iterate_right hφ _ _]

end MonoidHom

namespace TauCeti.IsExponentialGroup

variable {G : Type*} [Group G]

section CommGroup

variable {Z : Type*} [CommGroup Z]

/-- In a commutative group, the exponentiation determined by `T` is a product over the support. -/
theorem polynomialPow_eq_prod (T : Z → Z) (z : Z) (p : ℤ[X]) :
    letI := polynomialPow T
    z ^ p = ∏ i ∈ p.support, T^[i] z ^ p.coeff i := by
  rw [polynomialPow_def, ((p.support.sort_perm_toList _).map _).prod_eq, Finset.prod_map_toList]

/-- In a commutative group, the exponentiation determined by an endomorphism `τ` is the
`ℤ[t]`-module structure in which `t` acts by `τ`, written multiplicatively. -/
theorem polynomialPow_eq_aeval (τ : Z →* Z) (z : Z) (p : ℤ[X]) :
    letI := polynomialPow τ
    z ^ p = (aeval τ.toAdditive.toIntLinearMap p (.ofMul z)).toMul := by
  have hit (n : ℕ) : (τ.toAdditive.toIntLinearMap ^ n) (.ofMul z) = .ofMul (τ^[n] z) := by
    rw [pow_apply_eq_iterate]
    exact (Function.Semiconj.iterate_right (f := Additive.ofMul) (ga := τ) (fun _ => by simp) n
      z).symm
  simp [polynomialPow_eq_prod, aeval_endomorphism, Polynomial.sum_def, hit]

end CommGroup

open scoped MultiplicativePow in
/-- In a group whose elements commute, the exponentiation determined by an endomorphism `τ` is a
`ℤ[t]`-group structure: it is the `ℤ[t]`-module structure in which `t` acts by `τ`, written
multiplicatively. -/
private theorem isExponentialGroup_polynomialPow_of_comm {Z : Type*} [Group Z]
    (hZ : ∀ x y : Z, x * y = y * x) (τ : Z →* Z) :
    letI := polynomialPow τ
    IsExponentialGroup ℤ[X] Z := by
  let : CommGroup Z := { (inferInstance : Group Z) with mul_comm := hZ }
  let : Module ℤ[X] (Additive Z) := .compHom _ (aeval τ.toAdditive.toIntLinearMap).toRingHom
  -- a polynomial `p` acts on `Additive Z` by the evaluation of `p` at `τ`
  have hsmul (p : ℤ[X]) (x : Additive Z) : p • x = aeval τ.toAdditive.toIntLinearMap p x := rfl
  have hpow (z : Z) (p : ℤ[X]) : (letI := polynomialPow τ; z ^ p) =
      (Multiplicative.ofAdd (Additive.ofMul z) ^ p).toAdd.toMul := by
    rw [Multiplicative.multiplicativePow_def, toAdd_ofAdd, toAdd_ofAdd, hsmul,
      polynomialPow_eq_aeval]
  have h : polynomialPow τ = (MultiplicativePow.instPow : Pow (Multiplicative (Additive Z)) ℤ[X]) :=
    congrArg Pow.mk (funext₂ hpow)
  rw [h]
  exact MultiplicativePow.instIsExponentialGroup (A := ℤ[X]) (M := Additive Z)

section Hyp

variable {T : G → G}

/-- Two commuting elements lie in a commutative subgroup `Z` that `T` maps to itself, namely the
centralizer of their centralizer. The exponentiation determined by the endomorphism `T` of `Z` is
a `ℤ[t]`-group structure on `Z`, and the exponentiation determined by `T` restricts to it. -/
private theorem exists_commutative_subgroup (hconj : ∀ g h : G, T (g * h * g⁻¹) = g * T h * g⁻¹)
    (hmul : ∀ g h : G, Commute g h → T (g * h) = T g * T h) {g h : G} (hc : Commute g h) :
    ∃ (Z : Subgroup G) (_ : Pow Z ℤ[X]) (_ : IsExponentialGroup ℤ[X] Z) (zg zh : Z),
      (zg : G) = g ∧ (zh : G) = h ∧ Commute zg zh ∧ ∀ (z : Z) (p : ℤ[X]),
        letI := polynomialPow T; ↑(z ^ p) = (z : G) ^ p := by
  have hcomm := Set.centralizer_centralizer_comm_of_comm (Set.pairwise_pair_of_symm_of_refl.2 hc)
  set Z := Subgroup.centralizer (Set.centralizer ({g, h} : Set G))
  have hT (x : G) (hx : x ∈ Z) : T x ∈ Z := Subgroup.mem_centralizer_iff.2 fun y hy =>
    Commute.apply_right_of_conj (Subgroup.mem_centralizer_iff.1 hx y hy) (hconj y x)
  let τ : Z →* Z :=
    { toFun x := ⟨T x, hT x x.property⟩
      map_one' := Subtype.ext (by simpa using hmul 1 1 (Commute.one_left 1))
      map_mul' x y := Subtype.ext (hmul x y (hcomm _ x.property _ y.property)) }
  have hZ (x y : Z) : x * y = y * x := Subtype.ext (hcomm _ x.property _ y.property)
  exact ⟨Z, polynomialPow τ, isExponentialGroup_polynomialPow_of_comm hZ τ,
    ⟨g, Set.subset_centralizer_centralizer (by simp)⟩,
    ⟨h, Set.subset_centralizer_centralizer (by simp)⟩, rfl, rfl, hZ _ _,
    Z.subtype.map_polynomialPow fun _ => rfl⟩

/-- A map `T : G → G` that commutes with conjugation and is multiplicative on commuting elements
makes `G` a `ℤ[t]`-group, by `g ^ (∑ nᵢ tⁱ) = ∏ (Tⁱ g) ^ nᵢ`. -/
theorem isExponentialGroup_polynomialPow (hconj : ∀ g h : G, T (g * h * g⁻¹) = g * T h * g⁻¹)
    (hmul : ∀ g h : G, Commute g h → T (g * h) = T g * T h) :
    letI := polynomialPow T
    IsExponentialGroup ℤ[X] G := by
  let := polynomialPow T
  refine
    { pow_one g := polynomialPow_one T g
      pow_add g p q := ?_
      pow_mul g p q := ?_
      conj_pow k h p := ?_
      mul_pow {g h} hc p := ?_ }
  -- `pow_add`, `pow_mul` and `mul_pow` hold in a commutative subgroup containing the elements
  · obtain ⟨Z, _, _, z, -, rfl, -, -, e⟩ := exists_commutative_subgroup hconj hmul (.refl g)
    simpa [e] using congrArg Subtype.val (IsExponentialGroup.pow_add z p q)
  · obtain ⟨Z, _, _, z, -, rfl, -, -, e⟩ := exists_commutative_subgroup hconj hmul (.refl g)
    simpa [e] using congrArg Subtype.val (IsExponentialGroup.pow_mul z p q)
  · simpa using ((MulAut.conj k).toMonoidHom.map_polynomialPow (T := T) (T' := T)
      (fun x => by simpa using (hconj k x).symm) h p).symm
  · obtain ⟨Z, _, _, zg, zh, rfl, rfl, hc, e⟩ := exists_commutative_subgroup hconj hmul hc
    simpa [e] using congrArg Subtype.val (IsExponentialGroup.mul_pow hc p)

end Hyp

/-- In a `ℤ[t]`-group, every power `g ^ p` is the power for the exponentiation determined by the
`t`-th power. -/
theorem pow_eq_polynomialPow [Pow G ℤ[X]] [IsExponentialGroup ℤ[X] G] (g : G) (p : ℤ[X]) :
    g ^ p = (letI := polynomialPow fun g : G => g ^ (X : ℤ[X]); g ^ p) := by
  let T (g : G) := g ^ (X : ℤ[X])
  have hT := isExponentialGroup_polynomialPow (T := T) (IsExponentialGroup.conj_pow · · X)
    fun _ _ hc => IsExponentialGroup.mul_pow hc X
  -- both exponentiations agree on constants and respect sums and multiplication by `t`
  induction p using Polynomial.induction_on with
  | C a => rw [polynomialPow_C, eq_intCast C a, pow_intCast]
  | add p q hp hq =>
    rw [IsExponentialGroup.pow_add, hp, hq, @IsExponentialGroup.pow_add _ _ _ _ _ hT]
  | monomial n a ih =>
    rw [pow_succ, ← mul_assoc, IsExponentialGroup.pow_mul g _ X, ih,
      @IsExponentialGroup.pow_mul _ _ _ _ _ hT g _ X, polynomialPow_X]

/-- Every `ℤ[t]`-group structure is the exponentiation determined by its `t`-th power. -/
theorem eq_polynomialPow [inst : Pow G ℤ[X]] [IsExponentialGroup ℤ[X] G] :
    inst = polynomialPow fun g : G => g ^ (X : ℤ[X]) :=
  congrArg Pow.mk (funext₂ pow_eq_polynomialPow)

/-- The exponentiation determined by the `m`-th power map is `g ^ p = g ^ p(m)`. -/
@[simp]
theorem polynomialPow_zpow (m : ℤ) (g : G) (p : ℤ[X]) :
    letI := polynomialPow fun g : G => g ^ m
    g ^ p = g ^ p.eval m := by
  -- transport from `Multiplicative ℤ`, where the endomorphism `τ` is the scalar `m`
  let τ := zpowGroupHom (α := Multiplicative ℤ) m
  have hτ : τ.toAdditive.toIntLinearMap = algebraMap ℤ _ m := LinearMap.ext fun x => by simp [τ]
  have h := (zpowersHom G g).map_polynomialPow (T := fun g : G => g ^ m) (T' := τ)
    (fun x => map_zpow _ x m) (.ofAdd 1) p
  rw [polynomialPow_eq_aeval, hτ, aeval_algebraMap_apply_eq_algebraMap_eval,
    Module.algebraMap_end_apply] at h
  simpa using h.symm

/-- In a `ℤ[t]`-group, a subgroup closed under the `t`-th power is closed under every exponent. -/
theorem pow_mem_of_pow_X_mem [Pow G ℤ[X]] [IsExponentialGroup ℤ[X] G] {S : Subgroup G}
    (hS : ∀ g ∈ S, g ^ (X : ℤ[X]) ∈ S) {g : G} (hg : g ∈ S) (p : ℤ[X]) : g ^ p ∈ S := by
  -- the inclusion of `S` commutes with the exponentiation determined by the restricted `t`-th power
  have h := S.subtype.map_polynomialPow (T := fun g : G => g ^ (X : ℤ[X]))
    (T' := fun x : S => ⟨x ^ (X : ℤ[X]), hS x x.property⟩) (fun _ => rfl) ⟨g, hg⟩ p
  rw [pow_eq_polynomialPow g p]
  exact h ▸ Subtype.property _

end TauCeti.IsExponentialGroup

namespace MonoidHom

open TauCeti TauCeti.IsExponentialGroup

variable {G H : Type*} [Group G] [Group H]

/-- A homomorphism of `ℤ[t]`-groups that commutes with the `t`-th power commutes with every
exponent. -/
theorem map_pow_of_map_pow_X [Pow G ℤ[X]] [IsExponentialGroup ℤ[X] G] [Pow H ℤ[X]]
    [IsExponentialGroup ℤ[X] H] (ψ : G →* H)
    (hψ : ∀ g : G, ψ (g ^ (X : ℤ[X])) = ψ g ^ (X : ℤ[X])) (g : G) (p : ℤ[X]) :
    ψ (g ^ p) = ψ g ^ p := by
  rw [pow_eq_polynomialPow g p, pow_eq_polynomialPow (ψ g) p]
  exact ψ.map_polynomialPow hψ g p

end MonoidHom
