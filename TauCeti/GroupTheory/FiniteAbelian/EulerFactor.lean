/-!
# Products of linear Euler factors over characters of finite commutative groups

Let `G` be a finite commutative group and `R` an integral domain with enough roots of unity for the
exponent of `G`. At an element `g ∈ G` of order `f`, the restriction of characters `G →* Rˣ` to the
cyclic subgroup `⟨g⟩` is surjective, each character of `⟨g⟩` has `#G / f` extensions to `G`, and as
`ψ` ranges over `⟨g⟩ →* Rˣ` the value `ψ g` ranges once over the `f`-th roots of unity in `R`.
Factoring `1 - X ^ f` over those roots gives the polynomial identity

`∏ φ : G →* Rˣ, (1 - C (φ g) * X) = (1 - X ^ orderOf g) ^ (Nat.card G / orderOf g)`

in `R[X]`, and evaluating at `z : R` gives the scalar product formula. Applied to the unit group
`(ZMod m)ˣ` and the Frobenius class of an unramified prime, this is the local comparison matching
the product of Dirichlet Euler factors with the splitting of that prime in a cyclotomic field.

## Main results

* `IsPrimitiveRoot.prod_one_sub_pow_mul_X`: for a primitive `n`-th root of unity `ζ` in a domain
  with `0 < n`, `∏ i ∈ range n, (1 - C (ζ ^ i) * X) = 1 - X ^ n` in `R[X]`.
* `IsPrimitiveRoot.prod_one_sub_pow_mul`: the evaluated form
  `∏ i ∈ range n, (1 - ζ ^ i * z) = 1 - z ^ n`.
* `CommGroup.prod_one_sub_C_monoidHom_mul_X`: for a finite commutative group `G` and `g : G`,
  `∏ φ : G →* Rˣ, (1 - C (φ g) * X) = (1 - X ^ orderOf g) ^ (Nat.card G / orderOf g)`.
* `CommGroup.prod_one_sub_monoidHom_mul`: the evaluated form
  `∏ φ : G →* Rˣ, (1 - φ g * z) = (1 - z ^ orderOf g) ^ (Nat.card G / orderOf g)`.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, Lemma 4.2 and Theorem 4.3.
* J. Neukirch, *Algebraic Number Theory*, Chapter VII, §5.
-/

public section

open Polynomial

namespace IsPrimitiveRoot

variable {R : Type*} [CommRing R] [IsDomain R]

/-- **Reciprocal cyclotomic factorization of `1 - X ^ n`.** If `ζ` is a primitive `n`-th root of
unity in an integral domain `R` and `0 < n`, then `1 - X ^ n` is the product over `i < n` of the
linear Euler factors `1 - C (ζ ^ i) * X` in `R[X]`. The positivity hypothesis `0 < n` is needed
because at `n = 0` the empty product is `1` while `1 - X ^ 0 = 0`. -/
theorem prod_one_sub_pow_mul_X {n : ℕ} {ζ : R} (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) :
    ∏ i ∈ Finset.range n, (1 - C (ζ ^ i) * X) = 1 - X ^ n := by
  let u : Rˣ := (hζ.isUnit hn.ne').unit
  have hu : IsPrimitiveRoot u n := IsPrimitiveRoot.coe_units_iff.mp (by simpa [u] using hζ)
  have hη : IsPrimitiveRoot ((u⁻¹ : Rˣ) : R) n := IsPrimitiveRoot.coe_units_iff.mpr hu.inv
  -- Evaluating `X ^ n - 1 = ∏ (X - ζ ^ i)` at `0` pins down the product of `-ζ ^ i` as `-1`.
  have hprod_ζ := X_pow_sub_C_eq_prod hζ hn (one_pow n)
  have hprod_η := X_pow_sub_C_eq_prod hη hn (one_pow n)
  simp only [mul_one, C_1] at hprod_ζ hprod_η
  have hzero : ∏ i ∈ Finset.range n, -(ζ ^ i) = -1 := by
    have h0 := congrArg (Polynomial.eval 0) hprod_ζ
    simpa [hn.ne', eval_prod] using h0.symm
  -- Each factor `1 - ζ ^ i X` is `(-ζ ^ i) * (X - (u⁻¹) ^ i)`.
  have hterm (i : ℕ) :
      (1 : R[X]) - C (ζ ^ i) * X = C (-(ζ ^ i)) * (X - C (((u⁻¹ : Rˣ) : R) ^ i)) := by
    have hmul : ζ ^ i * ((u⁻¹ : Rˣ) : R) ^ i = 1 := by
      have hu1 : ζ * ((u⁻¹ : Rˣ) : R) = 1 := by
        simp [u]
      rw [← mul_pow, hu1, one_pow]
    rw [mul_sub, ← C_mul, neg_mul, hmul]
    simp [sub_eq_add_neg, add_comm]
  simp_rw [hterm, Finset.prod_mul_distrib, ← map_prod, hzero, ← hprod_η]
  simp [sub_eq_add_neg, add_comm]

/-- **Scalar product of `1 - ζ ^ i * z` over the powers of a primitive root.** For `0 < n` and a
primitive `n`-th root of unity `ζ` in an integral domain `R`, the product of `1 - ζ ^ i * z` over
`i < n` equals `1 - z ^ n`. -/
theorem prod_one_sub_pow_mul {n : ℕ} {ζ : R} (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) (z : R) :
    ∏ i ∈ Finset.range n, (1 - ζ ^ i * z) = 1 - z ^ n := by
  have h := congrArg (Polynomial.eval z) (hζ.prod_one_sub_pow_mul_X hn)
  simpa [eval_prod] using h

end IsPrimitiveRoot

namespace CommGroup

variable {G : Type*} [CommGroup G] [Finite G] {R : Type*} [CommRing R] [IsDomain R]

/-- On a cyclic group generated by `g`, the product of `1 - C (ψ g) * X` over all characters
`ψ : H →* Rˣ` is `1 - X ^ #H`. -/
private theorem prod_one_sub_C_monoidHom_mul_X_of_generator {H : Type*} [CommGroup H] [Finite H]
    [HasEnoughRootsOfUnity R (Nat.card H)] {g : H} (hg : ∀ x : H, x ∈ Subgroup.zpowers g) :
    ∏ ψ : H →* Rˣ, (1 - C ((ψ g : Rˣ) : R) * X) = 1 - X ^ Nat.card H := by
  classical
  have : NeZero (Nat.card H) := ⟨Nat.card_pos.ne'⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot R (Nat.card H)
  let u : Rˣ := (hζ.isUnit (NeZero.ne _)).unit
  have hu : IsPrimitiveRoot u (Nat.card H) :=
    IsPrimitiveRoot.coe_units_iff.mp (by simpa [u] using hζ)
  -- `ψ ↦ ψ g` identifies `H →* Rˣ` with `μ_{#H}(R)`, and `i ↦ u ^ i` parametrizes `μ_{#H}(R)`.
  let e : (H →* Rˣ) ≃ rootsOfUnity (Nat.card H) R :=
    ((IsCyclic.monoidHomMulEquivRootsOfUnityOfGenerator hg Rˣ).trans
      (rootsOfUnityUnitsMulEquiv R (Nat.card H))).toEquiv
  have : Fintype (rootsOfUnity (Nat.card H) R) := Fintype.ofFinite _
  have he (ψ : H →* Rˣ) : ((e ψ : rootsOfUnity (Nat.card H) R) : Rˣ) = ψ g := by
    ext
    simp [e, IsCyclic.monoidHomMulEquivRootsOfUnityOfGenerator, rootsOfUnityUnitsMulEquiv]
  simp_rw [← he]
  rw [e.prod_comp (fun μ : rootsOfUnity (Nat.card H) R ↦ (1 : R[X]) - C ((μ : Rˣ) : R) * X),
    ← hζ.prod_one_sub_pow_mul_X Nat.card_pos]
  symm
  have hmem (i : ℕ) : u ^ i ∈ rootsOfUnity (Nat.card H) R := by
    rw [mem_rootsOfUnity, ← pow_mul, mul_comm, pow_mul, hu.pow_eq_one, one_pow]
  refine Finset.prod_nbij (fun i ↦ ⟨u ^ i, hmem i⟩)
    (fun _ _ ↦ Finset.mem_univ _) (fun i hi j hj hij ↦ ?_) (fun μ _ ↦ ?_) (fun i _ ↦ ?_)
  · exact hu.injOn_pow (Finset.mem_coe.mpr hi) (Finset.mem_coe.mpr hj) (Subtype.mk.inj hij)
  · obtain ⟨i, hi, hμ⟩ := hu.eq_pow_of_mem_rootsOfUnity μ.prop
    exact ⟨i, Finset.mem_range.mpr hi, Subtype.ext hμ⟩
  · simp [u, Units.val_pow_eq_pow_val, IsUnit.unit_spec]

variable [HasEnoughRootsOfUnity R (Monoid.exponent G)]

/-- **Product of linear Euler factors over the character group.** For a finite commutative group
`G`, an integral domain `R` with enough roots of unity for `Monoid.exponent G`, and `g : G`, the
product of `1 - C (φ g) * X` over all characters `φ : G →* Rˣ` equals
`(1 - X ^ orderOf g) ^ (Nat.card G / orderOf g)` in `R[X]`. -/
theorem prod_one_sub_C_monoidHom_mul_X (g : G) :
    ∏ φ : G →* Rˣ, (1 - C ((φ g : Rˣ) : R) * X) =
      (1 - X ^ orderOf g) ^ (Nat.card G / orderOf g) := by
  let H : Subgroup G := Subgroup.zpowers g
  let gen : H := ⟨g, Subgroup.mem_zpowers g⟩
  have hgen : ∀ x : H, x ∈ Subgroup.zpowers gen := fun ⟨x, hx⟩ ↦ by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    exact ⟨k, Subtype.ext (by simp [gen])⟩
  have hcardH : Nat.card H = orderOf g := Nat.card_zpowers g
  have hdvd : Nat.card H ∣ Monoid.exponent G := hcardH ▸ Monoid.order_dvd_exponent g
  have : NeZero (Monoid.exponent G) := ⟨Monoid.exponent_ne_zero_of_finite⟩
  have : HasEnoughRootsOfUnity R (Nat.card H) := HasEnoughRootsOfUnity.of_dvd R hdvd
  -- Restrict characters from `G` to `H = ⟨g⟩`; each fiber has size `#(G ⧸ H) = #G / orderOf g`.
  have hquot : Nat.card (G ⧸ H) = Nat.card G / orderOf g := by
    rw [H.card_eq_card_quotient_mul_card_subgroup, hcardH,
      Nat.mul_div_cancel _ (isOfFinOrder_of_finite g).orderOf_pos]
  have hprod := (MonoidHom.domRestrictHom H Rˣ).prod_comp_of_surjective
    (MonoidHom.domRestrict_surjective R H)
    (fun ψ : H →* Rˣ ↦ (1 : R[X]) - C ((ψ gen : Rˣ) : R) * X)
  simpa only [MonoidHom.domRestrictHom_apply, MonoidHom.domRestrict_apply,
    prod_one_sub_C_monoidHom_mul_X_of_generator hgen, card_domRestrictHom_ker R H, hcardH, hquot]
    using hprod

/-- **Evaluated product of `1 - φ g * z` over the character group.** For `g : G` and `z : R`, the
product of `1 - φ g * z` over all characters `φ : G →* Rˣ` is
`(1 - z ^ orderOf g) ^ (Nat.card G / orderOf g)`. -/
theorem prod_one_sub_monoidHom_mul (g : G) (z : R) :
    ∏ φ : G →* Rˣ, (1 - ((φ g : Rˣ) : R) * z) =
      (1 - z ^ orderOf g) ^ (Nat.card G / orderOf g) := by
  have h := congrArg (Polynomial.eval z) (prod_one_sub_C_monoidHom_mul_X (R := R) g)
  simpa [eval_prod] using h

end CommGroup
