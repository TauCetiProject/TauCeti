module

public import TauCeti.GroupTheory.FiniteAbelian.Duality
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Characters of a common kernel quotient with two quadratic twists

The characters trivial on the common kernel of `ψ`, `α` and `β` are generated by those
three characters. When `α` and `β` are quadratic and have separate detecting elements on
which `ψ` is trivial, each surviving character is a unique power of `ψ` times a choice of the
two twists. The evaluations at the detecting elements distinguish the untwisted family from
its three translates. In Frobenius-restricted Riesz averages the detecting elements come from
the inertia groups at the auxiliary primes.

The application to kept and non-kept characters comes from Levent Alpöge's
`Formalism.HC.Level.ofSub` and `Formalism.HC.HostRaw.Kept` in his formalization of the
Riemann hypothesis for Dirichlet L-functions.
-/

public section

namespace MonoidHom

open Subgroup

variable {G M : Type*} [CommGroup G] [Finite G] [CommMonoid M]
  [HasEnoughRootsOfUnity M (Monoid.exponent G)]

/-- The two binary exponents of a value `u ≠ 1` give different powers. This reads a twist
index off the value of the twist at its detecting element. -/
private theorem pow_finTwo_val_injective {N : Type*} [Monoid N] {u : N} (hu : u ≠ 1) :
    Function.Injective fun i : Fin 2 ↦ u ^ i.val := by
  intro i j h
  fin_cases i <;> fin_cases j <;> simp_all [eq_comm]

/-- The surviving characters of a two-twist family are precisely the products of a power of
`ψ` and a binary power of each quadratic factor. The factors need not be independent for
this membership criterion. -/
theorem mem_dual_inf_ker_iff_exists_pow_mul (ψ α β χ : G →* Mˣ)
    (hα : α ^ 2 = 1) (hβ : β ^ 2 = 1) :
    χ ∈ (CommGroup.subgroupOrderIsoSubgroupMonoidHom G M (ψ.ker ⊓ α.ker ⊓ β.ker)).ofDual ↔
      ∃ l : Fin (orderOf ψ), ∃ i j : Fin 2, ψ ^ l.val * α ^ i.val * β ^ j.val = χ := by
  let D := CommGroup.subgroupOrderIsoSubgroupMonoidHom G M
  have hdual (H K : Subgroup G) : (D (H ⊓ K)).ofDual = (D H).ofDual ⊔ (D K).ofDual :=
    congrArg OrderDual.ofDual (D.map_inf H K)
  rw [hdual, hdual, ψ.dual_ker_eq_zpowers, α.dual_ker_eq_zpowers, β.dual_ker_eq_zpowers]
  have powerIndex {φ : G →* Mˣ} {n : ℕ} (hφ : φ ^ n = 1) (hn : 0 < n) (ξ : zpowers φ) :
      ∃ k : Fin n, φ ^ k.val = ξ.val := by
    let hfin : IsOfFinOrder φ := isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, hφ⟩
    let k := (finEquivZPowers hfin).symm ξ
    exact ⟨k.castLE (Nat.le_of_dvd hn (orderOf_dvd_iff_pow_eq_one.mpr hφ)),
      pow_finEquivZPowers_symm_apply hfin ξ⟩
  constructor
  · intro hχ
    obtain ⟨v, hv, w, hw, rfl⟩ := mem_sup.mp hχ
    obtain ⟨u, hu, t, ht, rfl⟩ := mem_sup.mp hv
    obtain ⟨l, hl⟩ := powerIndex (pow_orderOf_eq_one ψ) (orderOf_pos ψ) ⟨u, hu⟩
    obtain ⟨i, hi⟩ := powerIndex hα (by decide) ⟨t, ht⟩
    obtain ⟨j, hj⟩ := powerIndex hβ (by decide) ⟨w, hw⟩
    exact ⟨l, i, j, by rw [hl, hi, hj]⟩
  · rintro ⟨l, i, j, rfl⟩
    exact mul_mem_sup (mul_mem_sup (pow_mem (mem_zpowers ψ) _) (pow_mem (mem_zpowers α) _))
      (pow_mem (mem_zpowers β) _)

/-- If each quadratic factor has a detecting element in the kernels of the other factor and
of `ψ`, the power and the two twist indices of a surviving character are unique. -/
noncomputable def dualInfKerEquiv (ψ α β : G →* Mˣ) (hα : α ^ 2 = 1) (hβ : β ^ 2 = 1)
    {q d : G} (hqψ : ψ q = 1) (hqα : α q ≠ 1) (hqβ : β q = 1)
    (hdψ : ψ d = 1) (hdα : α d = 1) (hdβ : β d ≠ 1) :
    (Fin (orderOf ψ) × Fin 2 × Fin 2) ≃
      (CommGroup.subgroupOrderIsoSubgroupMonoidHom G M (ψ.ker ⊓ α.ker ⊓ β.ker)).ofDual := by
  refine Equiv.ofBijective (fun p ↦ ⟨ψ ^ p.1.val * α ^ p.2.1.val * β ^ p.2.2.val,
    (ψ.mem_dual_inf_ker_iff_exists_pow_mul α β _ hα hβ).mpr ⟨p.1, p.2.1, p.2.2, rfl⟩⟩)
    ⟨?_, ?_⟩
  · rintro ⟨l, i, j⟩ ⟨l', i', j'⟩ h
    have he := congrArg Subtype.val h
    have hi : i = i' := pow_finTwo_val_injective hqα <| by
      simpa only [mul_apply, pow_apply, hqψ, hqβ, one_pow, one_mul, mul_one] using
        DFunLike.congr_fun he q
    have hj : j = j' := pow_finTwo_val_injective hdβ <| by
      simpa only [mul_apply, pow_apply, hdψ, hdα, one_pow, one_mul] using DFunLike.congr_fun he d
    subst i'
    subst j'
    have hl : l = l' := Fin.ext <| pow_injOn_Iio_orderOf l.isLt l'.isLt
      (mul_right_cancel (mul_right_cancel he))
    simp [hl]
  · intro χ
    obtain ⟨l, i, j, he⟩ := (ψ.mem_dual_inf_ker_iff_exists_pow_mul α β χ hα hβ).mp χ.property
    exact ⟨(l, i, j), Subtype.ext he⟩

/-- The parametrization multiplies the chosen power of `ψ` by the two selected twists. -/
@[simp] theorem coe_dualInfKerEquiv_apply (ψ α β : G →* Mˣ) (hα : α ^ 2 = 1) (hβ : β ^ 2 = 1)
    {q d : G} (hqψ : ψ q = 1) (hqα : α q ≠ 1) (hqβ : β q = 1)
    (hdψ : ψ d = 1) (hdα : α d = 1) (hdβ : β d ≠ 1)
    (p : Fin (orderOf ψ) × Fin 2 × Fin 2) :
    (ψ.dualInfKerEquiv α β hα hβ hqψ hqα hqβ hdψ hdα hdβ p : G →* Mˣ) =
      ψ ^ p.1.val * α ^ p.2.1.val * β ^ p.2.2.val := (rfl)

/-- Separate detecting elements make the family of surviving characters four times the size
of the untwisted family. -/
theorem card_dual_inf_ker (ψ α β : G →* Mˣ) (hα : α ^ 2 = 1) (hβ : β ^ 2 = 1)
    {q d : G} (hqψ : ψ q = 1) (hqα : α q ≠ 1) (hqβ : β q = 1)
    (hdψ : ψ d = 1) (hdα : α d = 1) (hdβ : β d ≠ 1) :
    Nat.card (CommGroup.subgroupOrderIsoSubgroupMonoidHom G M (ψ.ker ⊓ α.ker ⊓ β.ker)).ofDual =
      4 * orderOf ψ := by
  rw [← Nat.card_congr (ψ.dualInfKerEquiv α β hα hβ hqψ hqα hqβ hdψ hdα hdβ)]
  simp [Nat.mul_comm]

/-- Among the survivors, triviality on both detecting elements singles out the powers of `ψ`.
In the Frobenius application these are the characters kept after removing the auxiliary twists. -/
theorem mem_zpowers_iff_apply_eq_one_of_mem_dual_inf_ker (ψ α β χ : G →* Mˣ)
    (hα : α ^ 2 = 1) (hβ : β ^ 2 = 1) {q d : G}
    (hqψ : ψ q = 1) (hqα : α q ≠ 1) (hqβ : β q = 1)
    (hdψ : ψ d = 1) (hdα : α d = 1) (hdβ : β d ≠ 1)
    (hχ : χ ∈ (CommGroup.subgroupOrderIsoSubgroupMonoidHom G M
      (ψ.ker ⊓ α.ker ⊓ β.ker)).ofDual) :
    χ ∈ zpowers ψ ↔ χ q = 1 ∧ χ d = 1 := by
  constructor
  · rintro ⟨n, rfl⟩
    simp [hqψ, hdψ]
  · obtain ⟨l, i, j, rfl⟩ := (ψ.mem_dual_inf_ker_iff_exists_pow_mul α β χ hα hβ).mp hχ
    rintro ⟨hq, hd⟩
    simp only [mul_apply, pow_apply, hqψ, hqβ, hdψ, hdα, one_pow, one_mul, mul_one] at hq hd
    have hi : i = 0 := pow_finTwo_val_injective hqα <| by simpa using hq
    have hj : j = 0 := pow_finTwo_val_injective hdβ <| by simpa using hd
    simp [hi, hj]

/-- Exactly three of the four twist choices are discarded, so the count of non-kept
characters is three times the order of `ψ`. -/
theorem card_notMem_zpowers_of_dual_inf_ker (ψ α β : G →* Mˣ)
    (hα : α ^ 2 = 1) (hβ : β ^ 2 = 1) {q d : G}
    (hqψ : ψ q = 1) (hqα : α q ≠ 1) (hqβ : β q = 1)
    (hdψ : ψ d = 1) (hdα : α d = 1) (hdβ : β d ≠ 1) :
    Nat.card {χ : (CommGroup.subgroupOrderIsoSubgroupMonoidHom G M
        (ψ.ker ⊓ α.ker ⊓ β.ker)).ofDual // (χ : G →* Mˣ) ∉ zpowers ψ} =
      3 * orderOf ψ := by
  classical
  let S := (CommGroup.subgroupOrderIsoSubgroupMonoidHom G M (ψ.ker ⊓ α.ker ⊓ β.ker)).ofDual
  have hle : zpowers ψ ≤ S := by
    rw [← ψ.dual_ker_eq_zpowers]
    exact (CommGroup.subgroupOrderIsoSubgroupMonoidHom G M).monotone
      (inf_le_left.trans inf_le_left)
  let e : {χ : S // (χ : G →* Mˣ) ∈ zpowers ψ} ≃ zpowers ψ :=
    Equiv.subtypeSubtypeEquivSubtype (fun h ↦ hle h)
  let : Fintype S := Fintype.ofFinite _
  let : Fintype {χ : S // (χ : G →* Mˣ) ∈ zpowers ψ} := Fintype.ofFinite _
  let : Fintype {χ : S // (χ : G →* Mˣ) ∉ zpowers ψ} := Fintype.ofFinite _
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype_compl (fun χ : S ↦ (χ : G →* Mˣ) ∈ zpowers ψ),
    ← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, Nat.card_congr e, Nat.card_zpowers]
  have h := ψ.card_dual_inf_ker α β hα hβ hqψ hqα hqβ hdψ hdα hdβ
  calc
    _ = 4 * orderOf ψ - orderOf ψ := congrArg (· - orderOf ψ) h
    _ = _ := by omega

end MonoidHom
