/-!
# Finitely generated torsion-free abelian groups are free abelian

An abelian group without torsion that is generated by a finite set `s` is isomorphic to `ℤᵏ` for
some `k ≤ #s`. This is the torsion-free case of the structure theorem for finitely generated
abelian groups, with the bound on the rank by the number of generators made explicit: viewed as
a `ℤ`-module the group is finitely generated and torsion-free, hence free over the principal ideal
domain `ℤ`, and its rank is at most the size of any spanning set.

Applied to a subgroup, it says that finitely many pairwise commuting elements of a torsion-free
group generate a free abelian group whose rank is at most their number. For two elements this
gives the trivial group, `ℤ` or `ℤ²`, the abelian half of the classification of two-generated
subgroups of residually free groups.

## Main results

* `CommGroup.equiv_multiplicative_fin_int_of_isMulTorsionFree`: a torsion-free abelian group
  generated by a finite set `s` is isomorphic to `Multiplicative (Fin k → ℤ)` with `k ≤ #s`.
* `Subgroup.exists_mulEquiv_closure_of_pairwise_commute`: finitely many pairwise commuting elements
  of a torsion-free group generate a subgroup isomorphic to `Multiplicative (Fin k → ℤ)`, with `k`
  at most their number.
-/

public section

/-- A torsion-free abelian group generated by a finite set `s` is free abelian of rank at most
`#s`. -/
theorem CommGroup.equiv_multiplicative_fin_int_of_isMulTorsionFree {A : Type*} [CommGroup A]
    [IsMulTorsionFree A] {s : Finset A} (hs : Subgroup.closure (s : Set A) = ⊤) :
    ∃ k ≤ s.card, Nonempty (A ≃* Multiplicative (Fin k → ℤ)) := by
  classical
  have := IsMulTorsionFree.hasUniqueRoots (M := A)
  -- View `A` as a `ℤ`-module spanned by the elements of `s`.
  let v : s → Additive A := fun x => Additive.ofMul (x : A)
  have hspan : Submodule.span ℤ (Set.range v) = ⊤ := by
    have hv : Set.range v = Additive.toMul ⁻¹' (s : Set A) := by
      ext x
      exact ⟨fun ⟨y, hy⟩ => hy ▸ y.2, fun hx => ⟨⟨_, hx⟩, rfl⟩⟩
    rw [← Submodule.toAddSubgroup_inj, Submodule.span_int_eq_addSubgroupClosure,
      Submodule.top_toAddSubgroup, hv, ← Subgroup.toAddSubgroup_closure, hs, map_top]
  obtain ⟨n, b⟩ := Module.basisOfFiniteTypeTorsionFree hspan
  refine ⟨n, ?_, ⟨AddEquiv.toMultiplicativeRight b.equivFun.toAddEquiv⟩⟩
  have := finrank_range_le_card (R := ℤ) v
  rw [Set.finrank, hspan, finrank_top, Module.finrank_eq_card_basis b, Fintype.card_fin] at this
  simpa using this

open scoped IsMulCommutative in
/-- Finitely many pairwise commuting elements of a torsion-free group generate a free abelian
group of rank at most their number. -/
theorem Subgroup.exists_mulEquiv_closure_of_pairwise_commute {G : Type*} [Group G]
    [IsMulTorsionFree G] {s : Finset G} (hs : (s : Set G).Pairwise Commute) :
    ∃ k ≤ s.card, Nonempty (closure (s : Set G) ≃* Multiplicative (Fin k → ℤ)) := by
  classical
  have := isMulCommutative_closure hs
  -- The elements of `s`, as elements of the subgroup they generate, generate it.
  let t : Finset (closure (s : Set G)) := s.attach.image fun x => ⟨x.1, subset_closure x.2⟩
  have ht : closure (t : Set (closure (s : Set G))) = ⊤ := by
    rw [eq_top_iff, ← map_subtype_le_map_subtype, MonoidHom.map_closure, ← MonoidHom.range_eq_map,
      range_subtype]
    refine closure_le _ |>.mpr fun x hx => subset_closure ?_
    exact ⟨⟨x, subset_closure hx⟩, by simpa [t] using hx, rfl⟩
  obtain ⟨k, hk, he⟩ := CommGroup.equiv_multiplicative_fin_int_of_isMulTorsionFree ht
  exact ⟨k, hk.trans (Finset.card_image_le.trans s.card_attach.le), he⟩
