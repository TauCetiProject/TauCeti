module

public import Mathlib.GroupTheory.IsPerfect

/-!
# Perfectness from coprime power relations

A group generated by two elements is perfect when the generators and their product satisfy
power relations with pairwise coprime exponents. No finiteness or positivity assumption is
needed. This criterion applies both to triangle groups and to finite presentations with
additional relations.
-/

public section

namespace TauCeti

/-- A two-generator group with pairwise coprime power relations on the generators and their
product is perfect. -/
theorem isPerfect_of_coprime_pow_eq_one {G : Type*} [Group G] {x y : G} {a b c : ℕ}
    (hgen : Subgroup.closure ({x, y} : Set G) = ⊤)
    (hx : x ^ a = 1) (hy : y ^ b = 1) (hxy : (x * y) ^ c = 1)
    (hab : a.Coprime b) (hac : a.Coprime c) (hbc : b.Coprime c) : Group.IsPerfect G := by
  let f : G →* Group.Abelianization G := Group.Abelianization.of
  have hfxa : f x ^ a = 1 := by rw [← map_pow, hx, map_one]
  have hfyb : f y ^ b = 1 := by rw [← map_pow, hy, map_one]
  have hfxy : (f x * f y) ^ c = 1 := by rw [← map_mul, ← map_pow, hxy, map_one]
  -- In the abelianization, eliminating the other generator gives a second annihilating
  -- exponent for each generator. Coprimality forces both orders to be one.
  have hfxbc : f x ^ (b * c) = 1 := by
    have h := congrArg (fun t => t ^ b) hfxy
    simpa only [mul_pow, pow_right_comm _ c b, hfyb, one_pow, mul_one, ← pow_mul] using h
  have hfyac : f y ^ (a * c) = 1 := by
    have h := congrArg (fun t => t ^ a) hfxy
    simpa only [mul_pow, pow_right_comm _ c a, hfxa, one_pow, one_mul, ← pow_mul] using h
  have hfx : f x = 1 := orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes (hab.mul_right hac)
      (orderOf_dvd_of_pow_eq_one hfxa) (orderOf_dvd_of_pow_eq_one hfxbc))
  have hfy : f y = 1 := orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes (hab.symm.mul_right hbc)
      (orderOf_dvd_of_pow_eq_one hfyb) (orderOf_dvd_of_pow_eq_one hfyac))
  have hf : f = 1 := MonoidHom.eq_of_eqOn_dense hgen (by
    intro g hg
    rcases hg with rfl | hg
    · exact hfx
    · exact Set.mem_singleton_iff.mp hg ▸ hfy)
  constructor
  rw [← Group.Abelianization.ker_of]
  exact (congrArg MonoidHom.ker hf).trans MonoidHom.ker_one

end TauCeti
