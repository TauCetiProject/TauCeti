module

public import Mathlib.GroupTheory.PushoutI
public import TauCeti.GroupTheory.SurfaceGroup.Basic
import Mathlib.Tactic.Group

/-!
# Gluing orientable surface groups along a boundary curve

Cutting the compact orientable surface of genus `g₁ + g₂` with `m₁ + m₂` boundary components
along a separating simple closed curve leaves a surface of genus `g₁` with `m₁ + 1` boundary
components and a surface of genus `g₂` with `m₂ + 1` boundary components, each having the curve
as its last boundary component. Dually, the surface group is the pushout of the two pieces over
`ℤ`:

`S⁺(g₁ + g₂, m₁ + m₂) ≃* S⁺(g₁, m₁ + 1) ∗_ℤ S⁺(g₂, m₂ + 1)`,

where the generator of `ℤ` goes to the last peripheral element `q₁` of the first piece and to the
inverse `q₂⁻¹` of the last peripheral element of the second piece: the two copies of the curve
carry opposite orientations.

On presentations this is a Tietze transformation. Write `a, b, p` for the generators of the first
piece and `a', b', p'` for those of the second, and `P = p₁ ⋯ p_{m₁}`. The relations of the pieces
say `q₁ = W⁻¹` and `q₂ = W'⁻¹` for the words `W = [a₁, b₁] ⋯ [a_{g₁}, b_{g₁}] p₁ ⋯ p_{m₁}` and
`W' = [a'₁, b'₁] ⋯ p'_{m₂}`, so the amalgamation `q₁ = q₂⁻¹` becomes the single relation
`W W' = 1`. The product `W W'` is the surface word of `S⁺(g₁ + g₂, m₁ + m₂)` in the generators
`a, P a' P⁻¹`, `b, P b' P⁻¹`, `p, p'` (`TauCeti.SurfaceGroup.orientableWord_mul_orientableWord`).
Under the isomorphism the peripheral elements of `S⁺(g₁ + g₂, m₁ + m₂)` are exactly the remaining
peripheral elements `p₁, …, p_{m₁}, p'₁, …, p'_{m₂}` of the two pieces.

No injectivity of the maps from `ℤ` is assumed: the isomorphism with the pushout holds for all
`g₁, m₁, g₂, m₂`. When one piece is a disc (`S⁺(0, 1)`, which is trivial) the pushout is the
quotient of the other piece by its last boundary element, not an amalgamated product over a
subgroup isomorphic to `ℤ`.

## Main definitions

* `TauCeti.SurfaceGroup.Orientable.GluingFactor`: the two pieces `S⁺(g₁, m₁ + 1)` and
  `S⁺(g₂, m₂ + 1)` as a `Bool`-indexed family.
* `TauCeti.SurfaceGroup.Orientable.gluingMaps`: the maps `ℤ → S⁺(gᵢ, mᵢ + 1)` sending the
  generator to `q₁` and to `q₂⁻¹`.
* `TauCeti.SurfaceGroup.Orientable.equivPushoutI`: the isomorphism
  `S⁺(g₁ + g₂, m₁ + m₂) ≃* Monoid.PushoutI (gluingMaps g₁ m₁ g₂ m₂)`.

## Main results

* `TauCeti.SurfaceGroup.Orientable.equivPushoutI_symm_base`: the edge group `ℤ` maps onto the
  cyclic subgroup of `S⁺(g₁ + g₂, m₁ + m₂)` generated by the separating curve
  `([a₁, b₁] ⋯ [a_{g₁}, b_{g₁}] p₁ ⋯ p_{m₁})⁻¹`.
* `TauCeti.SurfaceGroup.Orientable.equivPushoutI_symm_base_genusTwo` and
  `TauCeti.SurfaceGroup.Orientable.pushoutI_of_false_inv_a_mul_inv_b_mul_a_mul_b_genusTwo`:
  `S⁺(2, 0)` is `S⁺(1, 1) ∗_ℤ S⁺(1, 1)` along the separating curve `[a₁, b₁] = [b₂, a₂]`.

## References

* V. Guirardel, G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §5.1.2 (an
  essential two-sided simple closed curve on a surface defines a cyclic splitting of its
  fundamental group relative to the boundary subgroups).
* J.-P. Serre, *Trees*, Springer, 1980, Chapter I, §1.1 (amalgams and their universal property).
-/

public section

namespace TauCeti

namespace SurfaceGroup

namespace Orientable

variable (g₁ m₁ g₂ m₂ : ℕ)

/-- The two pieces of the orientable surface of genus `g₁ + g₂` with `m₁ + m₂` boundary
components cut along a separating curve, as a `Bool`-indexed family: `S⁺(g₁, m₁ + 1)` at `false`
and `S⁺(g₂, m₂ + 1)` at `true`. -/
abbrev GluingFactor (b : Bool) : Type := cond b (Orientable g₂ (m₂ + 1)) (Orientable g₁ (m₁ + 1))

-- `inferInstanceAs` would rebuild the group structure from new auxiliary definitions; keeping
-- the instances of `Orientable` lets `simp` and `rw` identify each factor with its piece.
instance (b : Bool) : Group (GluingFactor g₁ m₁ g₂ m₂ b) :=
  Bool.rec (motive := fun b ↦ Group (GluingFactor g₁ m₁ g₂ m₂ b))
    (inferInstance : Group (Orientable g₁ (m₁ + 1)))
    (inferInstance : Group (Orientable g₂ (m₂ + 1))) b

/-- The maps from the edge group `ℤ` into the two pieces: the generator goes to the last
peripheral element of `S⁺(g₁, m₁ + 1)` and to the inverse of the last peripheral element of
`S⁺(g₂, m₂ + 1)`, the two sides of the separating curve. -/
def gluingMaps : ∀ b, Multiplicative ℤ →* GluingFactor g₁ m₁ g₂ m₂ b
  | false => zpowersHom _ (peripheral g₁ (m₁ + 1) (Fin.last m₁))
  | true => zpowersHom _ (peripheral g₂ (m₂ + 1) (Fin.last m₂))⁻¹

@[simp]
theorem gluingMaps_false :
    gluingMaps g₁ m₁ g₂ m₂ false = zpowersHom _ (peripheral g₁ (m₁ + 1) (Fin.last m₁)) := (rfl)

@[simp]
theorem gluingMaps_true :
    gluingMaps g₁ m₁ g₂ m₂ true = zpowersHom _ (peripheral g₂ (m₂ + 1) (Fin.last m₂))⁻¹ := (rfl)

/-- **The two sides of the glued curve.** In `S⁺(g₁, m₁ + 1) ∗_ℤ S⁺(g₂, m₂ + 1)` the last
peripheral element of the first piece is the inverse of the last peripheral element of the
second. -/
theorem pushoutI_of_false_peripheral_last_eq_inv :
    Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (peripheral g₁ (m₁ + 1) (Fin.last m₁)) =
      (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true
        (peripheral g₂ (m₂ + 1) (Fin.last m₂)))⁻¹ := by
  simpa using (Monoid.PushoutI.of_apply_eq_base (gluingMaps g₁ m₁ g₂ m₂) false (.ofAdd 1)).trans
    (Monoid.PushoutI.of_apply_eq_base _ true _).symm

/-! ### The two homomorphisms -/

/-- The product `p₁ ⋯ p_{m₁}` of the peripheral elements of the first piece other than the glued
one. -/
private abbrev boundaryProd : Orientable g₁ (m₁ + 1) :=
  (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod

/-- The product `p₁ ⋯ p_{m₁}` of the peripheral elements of `S⁺(g₁ + g₂, m₁ + m₂)` coming from
the first piece. -/
private abbrev boundaryProd' : Orientable (g₁ + g₂) (m₁ + m₂) :=
  (List.ofFn fun j : Fin m₁ ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)).prod

/-- The word `[a₁, b₁] ⋯ [a_{g₁}, b_{g₁}] p₁ ⋯ p_{m₁}` of the first piece in
`S⁺(g₁ + g₂, m₁ + m₂)`: the inverse of the separating curve. -/
private abbrev firstWord : Orientable (g₁ + g₂) (m₁ + m₂) :=
  orientableWord (fun i ↦ a (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i))
    (fun i ↦ b _ _ (Fin.castAdd g₂ i)) fun j ↦ peripheral _ _ (Fin.castAdd m₂ j)

/-- The word `[a'₁, b'₁] ⋯ [a'_{g₂}, b'_{g₂}] p'₁ ⋯ p'_{m₂}` of the second piece in
`S⁺(g₁ + g₂, m₁ + m₂)`, with `a'ᵢ = P⁻¹ a_{g₁ + i} P` and `b'ᵢ = P⁻¹ b_{g₁ + i} P` for
`P = p₁ ⋯ p_{m₁}`. -/
private abbrev secondWord : Orientable (g₁ + g₂) (m₁ + m₂) :=
  orientableWord
    (fun i ↦ (boundaryProd' g₁ m₁ g₂ m₂)⁻¹ * a (g₁ + g₂) (m₁ + m₂) (Fin.natAdd g₁ i) *
      boundaryProd' g₁ m₁ g₂ m₂)
    (fun i ↦ (boundaryProd' g₁ m₁ g₂ m₂)⁻¹ * b _ _ (Fin.natAdd g₁ i) * boundaryProd' g₁ m₁ g₂ m₂)
    fun j ↦ peripheral _ _ (Fin.natAdd m₁ j)

/-- The surface relation of `S⁺(g₁ + g₂, m₁ + m₂)` is the product of the words of the two
pieces. -/
private theorem firstWord_mul_secondWord : firstWord g₁ m₁ g₂ m₂ * secondWord g₁ m₁ g₂ m₂ = 1 := by
  rw [firstWord, secondWord, orientableWord_mul_orientableWord]
  simp only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one, Fin.append_castAdd_natAdd]
  exact orientableWord_a_b_peripheral _ _

/-- The map `S⁺(g₁ + g₂, m₁ + m₂) → S⁺(g₁, m₁ + 1) ∗_ℤ S⁺(g₂, m₂ + 1)`. -/
private def toPushoutI :
    Orientable (g₁ + g₂) (m₁ + m₂) →* Monoid.PushoutI (gluingMaps g₁ m₁ g₂ m₂) :=
  lift
    (Fin.append (fun i ↦ Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (a g₁ (m₁ + 1) i))
      fun i ↦ Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁) *
        Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true (a g₂ (m₂ + 1) i) *
          (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁))⁻¹)
    (Fin.append (fun i ↦ Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (b g₁ (m₁ + 1) i))
      fun i ↦ Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁) *
        Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true (b g₂ (m₂ + 1) i) *
          (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁))⁻¹)
    (Fin.append
      (fun j ↦ Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
        (peripheral g₁ (m₁ + 1) j.castSucc))
      fun j ↦ Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true
        (peripheral g₂ (m₂ + 1) j.castSucc)) <| by
    have hP : (List.ofFn fun j ↦ Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
        (peripheral g₁ (m₁ + 1) j.castSucc)).prod =
        Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁) := by
      simp [boundaryProd, map_list_prod, List.map_ofFn, Function.comp_def]
    -- The words of the pieces live in the `Bool`-indexed factors, whose group instances `simp`
    -- does not identify with those of `Orientable`; `rw` matches them up to unfolding.
    rw [← hP, ← orientableWord_mul_orientableWord, ← map_orientableWord, ← map_orientableWord,
      orientableWord_peripheral_castSucc, orientableWord_peripheral_castSucc, map_inv, map_inv,
      pushoutI_of_false_peripheral_last_eq_inv, inv_inv, mul_inv_cancel]

/-- The map `S⁺(g₁, m₁ + 1) → S⁺(g₁ + g₂, m₁ + m₂)` of the first piece. -/
private def ofFirst : Orientable g₁ (m₁ + 1) →* Orientable (g₁ + g₂) (m₁ + m₂) :=
  lift (fun i ↦ a _ _ (Fin.castAdd g₂ i)) (fun i ↦ b _ _ (Fin.castAdd g₂ i))
    (Fin.snoc (α := fun _ ↦ Orientable (g₁ + g₂) (m₁ + m₂))
      (fun j ↦ peripheral _ _ (Fin.castAdd m₂ j)) (firstWord g₁ m₁ g₂ m₂)⁻¹)
    (by rw [orientableWord_snoc, mul_inv_cancel])

/-- The map `S⁺(g₂, m₂ + 1) → S⁺(g₁ + g₂, m₁ + m₂)` of the second piece. -/
private def ofSecond : Orientable g₂ (m₂ + 1) →* Orientable (g₁ + g₂) (m₁ + m₂) :=
  lift
    (fun i ↦ (boundaryProd' g₁ m₁ g₂ m₂)⁻¹ * a _ _ (Fin.natAdd g₁ i) * boundaryProd' g₁ m₁ g₂ m₂)
    (fun i ↦ (boundaryProd' g₁ m₁ g₂ m₂)⁻¹ * b _ _ (Fin.natAdd g₁ i) * boundaryProd' g₁ m₁ g₂ m₂)
    (Fin.snoc (α := fun _ ↦ Orientable (g₁ + g₂) (m₁ + m₂))
      (fun j ↦ peripheral _ _ (Fin.natAdd m₁ j)) (secondWord g₁ m₁ g₂ m₂)⁻¹)
    (by rw [orientableWord_snoc, mul_inv_cancel])

private theorem ofFirst_peripheral_last :
    ofFirst g₁ m₁ g₂ m₂ (peripheral g₁ (m₁ + 1) (Fin.last m₁)) = (firstWord g₁ m₁ g₂ m₂)⁻¹ := by
  simp [ofFirst]

private theorem ofSecond_inv_peripheral_last :
    ofSecond g₁ m₁ g₂ m₂ (peripheral g₂ (m₂ + 1) (Fin.last m₂))⁻¹ = (firstWord g₁ m₁ g₂ m₂)⁻¹ := by
  rw [map_inv, ofSecond, lift_peripheral, Fin.snoc_last, inv_inv]
  exact eq_inv_of_mul_eq_one_right (firstWord_mul_secondWord g₁ m₁ g₂ m₂)

/-- The map `S⁺(g₁, m₁ + 1) ∗_ℤ S⁺(g₂, m₂ + 1) → S⁺(g₁ + g₂, m₁ + m₂)`. -/
private def ofPushoutI :
    Monoid.PushoutI (gluingMaps g₁ m₁ g₂ m₂) →* Orientable (g₁ + g₂) (m₁ + m₂) :=
  Monoid.PushoutI.lift
    (fun b ↦ Bool.rec (motive := fun b ↦ GluingFactor g₁ m₁ g₂ m₂ b →* _)
      (ofFirst g₁ m₁ g₂ m₂) (ofSecond g₁ m₁ g₂ m₂) b)
    (zpowersHom _ (firstWord g₁ m₁ g₂ m₂)⁻¹) fun b ↦ by
      cases b <;> refine MonoidHom.ext_mint ?_ <;>
        simp only [gluingMaps_false, gluingMaps_true, MonoidHom.coe_comp, Function.comp_apply,
          zpowersHom_apply, toAdd_ofAdd, zpow_one]
      -- The factor homomorphisms are stated through the `Bool`-indexed family; the lemmas about
      -- `ofFirst` and `ofSecond` close the goals up to unfolding that family.
      · exact ofFirst_peripheral_last g₁ m₁ g₂ m₂
      · exact ofSecond_inv_peripheral_last g₁ m₁ g₂ m₂

/-! ### The values of the two homomorphisms on generators -/

section values

variable {g₁ m₁ g₂ m₂}

private theorem toPushoutI_a_castAdd (i : Fin g₁) :
    toPushoutI g₁ m₁ g₂ m₂ (a _ _ (Fin.castAdd g₂ i)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (a g₁ (m₁ + 1) i) := by
  simp [toPushoutI]

private theorem toPushoutI_b_castAdd (i : Fin g₁) :
    toPushoutI g₁ m₁ g₂ m₂ (b _ _ (Fin.castAdd g₂ i)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (b g₁ (m₁ + 1) i) := by
  simp [toPushoutI]

private theorem toPushoutI_a_natAdd (i : Fin g₂) :
    toPushoutI g₁ m₁ g₂ m₂ (a _ _ (Fin.natAdd g₁ i)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁) *
        Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true (a g₂ (m₂ + 1) i) *
          (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁))⁻¹ := by
  simp [toPushoutI]

private theorem toPushoutI_b_natAdd (i : Fin g₂) :
    toPushoutI g₁ m₁ g₂ m₂ (b _ _ (Fin.natAdd g₁ i)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁) *
        Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true (b g₂ (m₂ + 1) i) *
          (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁))⁻¹ := by
  simp [toPushoutI]

private theorem toPushoutI_peripheral_castAdd (j : Fin m₁) :
    toPushoutI g₁ m₁ g₂ m₂ (peripheral _ _ (Fin.castAdd m₂ j)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
        (peripheral g₁ (m₁ + 1) j.castSucc) := by
  simp [toPushoutI]

private theorem toPushoutI_peripheral_natAdd (j : Fin m₂) :
    toPushoutI g₁ m₁ g₂ m₂ (peripheral _ _ (Fin.natAdd m₁ j)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true
        (peripheral g₂ (m₂ + 1) j.castSucc) := by
  simp [toPushoutI]

private theorem toPushoutI_boundaryProd' : toPushoutI g₁ m₁ g₂ m₂ (boundaryProd' g₁ m₁ g₂ m₂) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (boundaryProd g₁ m₁) := by
  simp only [boundaryProd', boundaryProd, map_list_prod, List.map_ofFn, Function.comp_def,
    toPushoutI_peripheral_castAdd]

private theorem ofPushoutI_of_false (x : Orientable g₁ (m₁ + 1)) :
    ofPushoutI g₁ m₁ g₂ m₂ (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false x) =
      ofFirst g₁ m₁ g₂ m₂ x :=
  Monoid.PushoutI.lift_of ..

private theorem ofPushoutI_of_true (x : Orientable g₂ (m₂ + 1)) :
    ofPushoutI g₁ m₁ g₂ m₂ (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true x) =
      ofSecond g₁ m₁ g₂ m₂ x :=
  Monoid.PushoutI.lift_of ..

end values

/-! ### The isomorphism -/

private theorem ofPushoutI_comp_toPushoutI :
    (ofPushoutI g₁ m₁ g₂ m₂).comp (toPushoutI g₁ m₁ g₂ m₂) = MonoidHom.id _ := by
  refine hom_ext (Fin.addCases ?_ ?_) (Fin.addCases ?_ ?_) (Fin.addCases ?_ ?_) <;> intro i <;>
    simp [toPushoutI_a_castAdd, toPushoutI_b_castAdd, toPushoutI_peripheral_castAdd,
      toPushoutI_a_natAdd, toPushoutI_b_natAdd, toPushoutI_peripheral_natAdd, ofPushoutI_of_false,
      ofPushoutI_of_true, ofFirst, ofSecond, boundaryProd, map_list_prod, List.map_ofFn,
      Function.comp_def, mul_assoc]

private theorem toPushoutI_firstWord : toPushoutI g₁ m₁ g₂ m₂ (firstWord g₁ m₁ g₂ m₂) =
      (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
        (peripheral g₁ (m₁ + 1) (Fin.last m₁)))⁻¹ := by
  rw [firstWord, map_orientableWord, ← map_inv, ← orientableWord_peripheral_castSucc,
    map_orientableWord]
  simp only [toPushoutI_a_castAdd, toPushoutI_b_castAdd, toPushoutI_peripheral_castAdd]

private theorem toPushoutI_secondWord : toPushoutI g₁ m₁ g₂ m₂ (secondWord g₁ m₁ g₂ m₂) =
      (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true
        (peripheral g₂ (m₂ + 1) (Fin.last m₂)))⁻¹ := by
  rw [secondWord, map_orientableWord, ← map_inv, ← orientableWord_peripheral_castSucc,
    map_orientableWord]
  simp only [map_mul, map_inv, toPushoutI_boundaryProd', toPushoutI_a_natAdd,
    toPushoutI_b_natAdd, toPushoutI_peripheral_natAdd, mul_assoc, inv_mul_cancel_left,
    inv_mul_cancel, mul_one]

private theorem ofPushoutI_comp_of_false :
    (ofPushoutI g₁ m₁ g₂ m₂).comp (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false) =
      ofFirst g₁ m₁ g₂ m₂ :=
  MonoidHom.ext ofPushoutI_of_false

private theorem ofPushoutI_comp_of_true :
    (ofPushoutI g₁ m₁ g₂ m₂).comp (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true) =
      ofSecond g₁ m₁ g₂ m₂ :=
  MonoidHom.ext ofPushoutI_of_true

private theorem toPushoutI_comp_ofFirst : (toPushoutI g₁ m₁ g₂ m₂).comp (ofFirst g₁ m₁ g₂ m₂) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false := by
  refine hom_ext (fun i ↦ ?_) (fun i ↦ ?_) (Fin.lastCases ?_ fun j ↦ ?_) <;>
    simp [ofFirst, toPushoutI_a_castAdd, toPushoutI_b_castAdd, toPushoutI_firstWord,
      toPushoutI_peripheral_castAdd]

private theorem toPushoutI_comp_ofSecond : (toPushoutI g₁ m₁ g₂ m₂).comp (ofSecond g₁ m₁ g₂ m₂) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true := by
  refine hom_ext (fun i ↦ ?_) (fun i ↦ ?_) (Fin.lastCases ?_ fun j ↦ ?_) <;>
    simp [ofSecond, toPushoutI_boundaryProd', toPushoutI_a_natAdd, toPushoutI_b_natAdd,
      toPushoutI_secondWord, toPushoutI_peripheral_natAdd, mul_assoc]

private theorem toPushoutI_comp_ofPushoutI :
    (toPushoutI g₁ m₁ g₂ m₂).comp (ofPushoutI g₁ m₁ g₂ m₂) = MonoidHom.id _ := by
  refine Monoid.PushoutI.hom_ext_nonempty fun b ↦ ?_
  rw [MonoidHom.comp_assoc, MonoidHom.id_comp]
  cases b
  · rw [ofPushoutI_comp_of_false, toPushoutI_comp_ofFirst]
  · rw [ofPushoutI_comp_of_true, toPushoutI_comp_ofSecond]

/-- **Gluing orientable surface groups along a separating curve.** The orientable surface group
`S⁺(g₁ + g₂, m₁ + m₂)` is the pushout `S⁺(g₁, m₁ + 1) ∗_ℤ S⁺(g₂, m₂ + 1)` of the two pieces over
`ℤ`, whose generator goes to the last peripheral element `q₁` of the first piece and to `q₂⁻¹`
for the last peripheral element `q₂` of the second. No injectivity of these maps is assumed.

Write `a, b, p` for the generators of `S⁺(g₁ + g₂, m₁ + m₂)`, `a', b', p'` for those of the first
piece and `a'', b'', p''` for those of the second. The isomorphism sends `aᵢ, bᵢ` to `a'ᵢ, b'ᵢ`
for `i ≤ g₁`, `a_{g₁ + i}, b_{g₁ + i}` to `P a''ᵢ P⁻¹, P b''ᵢ P⁻¹` with `P = p'₁ ⋯ p'_{m₁}`, and
the peripheral elements `pⱼ` and `p_{m₁ + j}` to the peripheral elements `p'ⱼ` and `p''ⱼ`. -/
def equivPushoutI : Orientable (g₁ + g₂) (m₁ + m₂) ≃* Monoid.PushoutI (gluingMaps g₁ m₁ g₂ m₂) :=
  MonoidHom.toMulEquiv (toPushoutI g₁ m₁ g₂ m₂) (ofPushoutI g₁ m₁ g₂ m₂)
    (ofPushoutI_comp_toPushoutI g₁ m₁ g₂ m₂) (toPushoutI_comp_ofPushoutI g₁ m₁ g₂ m₂)

variable {g₁ m₁ g₂ m₂}

/-! ### The isomorphism on generators

The `simp` lemmas here and in the next section do not index the sums `g₁ + g₂` and `m₁ + m₂` in
the type of `equivPushoutI`, so that they still apply once `simp` has evaluated these sums, as it
does for numerals. -/

@[simp]
theorem equivPushoutI_a_castAdd (i : Fin g₁) :
    DFunLike.coe (F := no_index _) (α := no_index _) (equivPushoutI g₁ m₁ g₂ m₂)
        (a (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.castAdd g₂ i)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (a g₁ (m₁ + 1) i) :=
  toPushoutI_a_castAdd i

@[simp]
theorem equivPushoutI_b_castAdd (i : Fin g₁) :
    DFunLike.coe (F := no_index _) (α := no_index _) (equivPushoutI g₁ m₁ g₂ m₂)
        (b (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.castAdd g₂ i)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (b g₁ (m₁ + 1) i) :=
  toPushoutI_b_castAdd i

/-- The generator `a_{g₁ + i}` of the glued surface goes to `P a''ᵢ P⁻¹`, where `a''ᵢ` is the
generator of the second piece and `P = p'₁ ⋯ p'_{m₁}` is the product of the remaining peripheral
elements of the first piece. -/
@[simp]
theorem equivPushoutI_a_natAdd (i : Fin g₂) :
    DFunLike.coe (F := no_index _) (α := no_index _) (equivPushoutI g₁ m₁ g₂ m₂)
        (a (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.natAdd g₁ i)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod *
        Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true (a g₂ (m₂ + 1) i) *
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod)⁻¹ :=
  toPushoutI_a_natAdd i

/-- The generator `b_{g₁ + i}` of the glued surface goes to `P b''ᵢ P⁻¹`, where `b''ᵢ` is the
generator of the second piece and `P = p'₁ ⋯ p'_{m₁}` is the product of the remaining peripheral
elements of the first piece. -/
@[simp]
theorem equivPushoutI_b_natAdd (i : Fin g₂) :
    DFunLike.coe (F := no_index _) (α := no_index _) (equivPushoutI g₁ m₁ g₂ m₂)
        (b (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.natAdd g₁ i)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod *
        Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true (b g₂ (m₂ + 1) i) *
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod)⁻¹ :=
  toPushoutI_b_natAdd i

/-- The first `m₁` peripheral elements of the glued surface are the remaining peripheral elements
of the first piece. -/
@[simp]
theorem equivPushoutI_peripheral_castAdd (j : Fin m₁) :
    DFunLike.coe (F := no_index _) (α := no_index _) (equivPushoutI g₁ m₁ g₂ m₂)
        (peripheral (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.castAdd m₂ j)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
        (peripheral g₁ (m₁ + 1) j.castSucc) :=
  toPushoutI_peripheral_castAdd j

/-- The last `m₂` peripheral elements of the glued surface are the remaining peripheral elements
of the second piece. -/
@[simp]
theorem equivPushoutI_peripheral_natAdd (j : Fin m₂) :
    DFunLike.coe (F := no_index _) (α := no_index _) (equivPushoutI g₁ m₁ g₂ m₂)
        (peripheral (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.natAdd m₁ j)) =
      Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true
        (peripheral g₂ (m₂ + 1) j.castSucc) :=
  toPushoutI_peripheral_natAdd j

/-! ### The inverse isomorphism on the generators of the pieces -/

@[simp]
theorem equivPushoutI_symm_of_false_a (i : Fin g₁) :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (a g₁ (m₁ + 1) i)) =
      a (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i) := by
  simp [equivPushoutI, ofPushoutI_of_false, ofFirst]

@[simp]
theorem equivPushoutI_symm_of_false_b (i : Fin g₁) :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false (b g₁ (m₁ + 1) i)) =
      b (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i) := by
  simp [equivPushoutI, ofPushoutI_of_false, ofFirst]

@[simp]
theorem equivPushoutI_symm_of_false_peripheral_castSucc (j : Fin m₁) :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
          (peripheral g₁ (m₁ + 1) j.castSucc)) =
      peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j) := by
  simp [equivPushoutI, ofPushoutI_of_false, ofFirst]

/-- The glued curve, the last boundary component of the first piece, is
`([a₁, b₁] ⋯ [a_{g₁}, b_{g₁}] p₁ ⋯ p_{m₁})⁻¹` in the glued surface. -/
@[simp]
theorem equivPushoutI_symm_of_false_peripheral_last :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false
          (peripheral g₁ (m₁ + 1) (Fin.last m₁))) =
      (orientableWord (fun i ↦ a (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i))
        (fun i ↦ b _ _ (Fin.castAdd g₂ i)) fun j ↦ peripheral _ _ (Fin.castAdd m₂ j))⁻¹ := by
  simp [equivPushoutI, ofPushoutI_of_false, ofFirst]

/-- The generator `a''ᵢ` of the second piece is `P⁻¹ a_{g₁ + i} P` in the glued surface, where
`P = p₁ ⋯ p_{m₁}`. -/
@[simp]
theorem equivPushoutI_symm_of_true_a (i : Fin g₂) :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true (a g₂ (m₂ + 1) i)) =
      (List.ofFn fun j : Fin m₁ ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)).prod⁻¹ *
        a (g₁ + g₂) (m₁ + m₂) (Fin.natAdd g₁ i) *
        (List.ofFn fun j : Fin m₁ ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)).prod := by
  simp [equivPushoutI, ofPushoutI_of_true, ofSecond]

/-- The generator `b''ᵢ` of the second piece is `P⁻¹ b_{g₁ + i} P` in the glued surface, where
`P = p₁ ⋯ p_{m₁}`. -/
@[simp]
theorem equivPushoutI_symm_of_true_b (i : Fin g₂) :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true (b g₂ (m₂ + 1) i)) =
      (List.ofFn fun j : Fin m₁ ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)).prod⁻¹ *
        b (g₁ + g₂) (m₁ + m₂) (Fin.natAdd g₁ i) *
        (List.ofFn fun j : Fin m₁ ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)).prod := by
  simp [equivPushoutI, ofPushoutI_of_true, ofSecond]

@[simp]
theorem equivPushoutI_symm_of_true_peripheral_castSucc (j : Fin m₂) :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true
          (peripheral g₂ (m₂ + 1) j.castSucc)) =
      peripheral (g₁ + g₂) (m₁ + m₂) (Fin.natAdd m₁ j) := by
  simp [equivPushoutI, ofPushoutI_of_true, ofSecond]

/-- The glued curve, seen as the last boundary component of the second piece, is
`[a₁, b₁] ⋯ [a_{g₁}, b_{g₁}] p₁ ⋯ p_{m₁}` in the glued surface: the inverse of its image from the
first piece. -/
@[simp]
theorem equivPushoutI_symm_of_true_peripheral_last :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true
          (peripheral g₂ (m₂ + 1) (Fin.last m₂))) =
      orientableWord (fun i ↦ a (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i))
        (fun i ↦ b _ _ (Fin.castAdd g₂ i)) fun j ↦ peripheral _ _ (Fin.castAdd m₂ j) := by
  rw [← inv_inv (Monoid.PushoutI.of true _), ← pushoutI_of_false_peripheral_last_eq_inv, map_inv,
    equivPushoutI_symm_of_false_peripheral_last, inv_inv]

/-- **The edge group is the separating curve.** The image of `n : ℤ` from the edge group of the
pushout is the `n`-th power of the separating curve
`([a₁, b₁] ⋯ [a_{g₁}, b_{g₁}] p₁ ⋯ p_{m₁})⁻¹` of `S⁺(g₁ + g₂, m₁ + m₂)`. -/
@[simp]
theorem equivPushoutI_symm_base (n : Multiplicative ℤ) :
    DFunLike.coe (F := no_index _) (MulEquiv.symm (M := no_index _) (equivPushoutI g₁ m₁ g₂ m₂))
        (Monoid.PushoutI.base (gluingMaps g₁ m₁ g₂ m₂) n) =
      (orientableWord (fun i ↦ a (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i))
        (fun i ↦ b _ _ (Fin.castAdd g₂ i)) fun j ↦ peripheral _ _ (Fin.castAdd m₂ j))⁻¹ ^
          n.toAdd := by
  rw [← Monoid.PushoutI.of_apply_eq_base _ false]
  simp

/-! ### The genus-two surface group -/

/-- **`S⁺(2, 0) = S⁺(1, 1) ∗_ℤ S⁺(1, 1)` along a separating curve.** Cutting the closed surface of
genus two along the curve separating its handles, the generator of the edge group of the pushout
`equivPushoutI 1 0 1 0` is the commutator `[b₁, a₁]` of the first handle. -/
theorem equivPushoutI_symm_base_genusTwo :
    (equivPushoutI 1 0 1 0).symm (Monoid.PushoutI.base _ (.ofAdd 1)) =
      (b 2 0 0)⁻¹ * (a 2 0 0)⁻¹ * b 2 0 0 * a 2 0 0 := by
  simp [orientableWord_def, mul_assoc]

/-- **`S⁺(2, 0) = S⁺(1, 1) ∗_ℤ S⁺(1, 1)` along `[a₁, b₁] = [b₂, a₂]`.** In the pushout of two
copies of the one-holed torus `S⁺(1, 1)` along their boundary curves with opposite orientations,
the commutator `[a₁, b₁]` of the first factor equals the commutator `[b₂, a₂]` of the second. -/
theorem pushoutI_of_false_inv_a_mul_inv_b_mul_a_mul_b_genusTwo :
    Monoid.PushoutI.of (φ := gluingMaps 1 0 1 0) false
        ((a 1 1 0)⁻¹ * (b 1 1 0)⁻¹ * a 1 1 0 * b 1 1 0) =
      Monoid.PushoutI.of (φ := gluingMaps 1 0 1 0) true
        ((b 1 1 0)⁻¹ * (a 1 1 0)⁻¹ * b 1 1 0 * a 1 1 0) := by
  have h : (a 1 1 0)⁻¹ * (b 1 1 0)⁻¹ * a 1 1 0 * b 1 1 0 = (peripheral 1 1 (Fin.last 0))⁻¹ := by
    simpa [orientableWord_def] using orientableWord_peripheral_castSucc 1 0
  have h' : (b 1 1 0)⁻¹ * (a 1 1 0)⁻¹ * b 1 1 0 * a 1 1 0 = peripheral 1 1 (Fin.last 0) := by
    rw [← inv_inv (peripheral 1 1 _), ← h]
    group
  rw [h, h', map_inv, pushoutI_of_false_peripheral_last_eq_inv, inv_inv]

