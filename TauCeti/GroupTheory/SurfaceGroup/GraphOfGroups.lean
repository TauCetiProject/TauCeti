public import TauCeti.GroupTheory.SurfaceGroup.Gluing
public import TauCeti.GroupTheory.SurfaceGroup.HNN

/-!
# Surface groups as fundamental groups of one-edge graphs of groups

Cutting a compact surface along an essential two-sided simple closed curve splits its fundamental
group over the infinite cyclic subgroup of the curve: the surface group is the fundamental group
of a graph of groups with one edge, whose vertex groups are the fundamental groups of the pieces,
whose edge group `ℤ` is the boundary subgroup of the cut curve in each piece, and whose
peripheral structure is formed by the remaining boundary subgroups of the pieces. This file
records these one-edge graphs of groups for the standard presentations of
`TauCeti.GroupTheory.SurfaceGroup.Basic`.

* A separating curve on `S⁺(g₁ + g₂, m₁ + m₂)` gives the segment of groups
  `TauCeti.SurfaceGroup.Orientable.separatingSegment` with vertex groups `S⁺(g₁, m₁ + 1)` and
  `S⁺(g₂, m₂ + 1)`; the edge group `ℤ` goes to the last peripheral elements `q₁` and `q₂⁻¹` (the
  two sides of the curve carry opposite orientations). Its fundamental group is the amalgam of
  `TauCeti.SurfaceGroup.Orientable.equivPushoutI`.
* A non-separating curve on `S⁺(g + 1, m)` gives the loop of groups
  `TauCeti.SurfaceGroup.Orientable.nonseparatingLoop` with vertex group `S⁺(g, m + 2)`; its
  fundamental group is the HNN extension of `TauCeti.SurfaceGroup.Orientable.equivHNNExtension`.
* A separating curve on the nonorientable surface `S⁻(g₁ + g₂, m₁ + m₂)` gives the segment of
  groups `TauCeti.SurfaceGroup.Nonorientable.separatingSegment` with vertex groups
  `S⁻(g₁, m₁ + 1)` and `S⁻(g₂, m₂ + 1)`, glued as in the orientable case. A piece with `gᵢ = 0`
  is a sphere with holes.

The vertex groups are required not to be discs, `gᵢ ≠ 0 ∨ mᵢ ≠ 0`: exactly then the boundary maps
from `ℤ` are injective (`TauCeti.SurfaceGroup.Orientable.isOfFinOrder_peripheral_iff`), as the
edge maps of a graph of groups must be. Gluing a disc is a quotient by a boundary element, not an
amalgam over `ℤ`.

For the nonorientable separating curve the isomorphism is a Tietze transformation, as for
`TauCeti.SurfaceGroup.Orientable.equivPushoutI`: the relations `W₁ q₁ = 1` and `W₂ q₂ = 1` of the
pieces, with the amalgamation `q₁ = q₂⁻¹`, become the single relation `W₁ W₂ = 1`, which is the
relation of `S⁻(g₁ + g₂, m₁ + m₂)` once the crosscap generators of the second piece are
conjugated by `P = p₁ ⋯ p_{m₁}` (`TauCeti.SurfaceGroup.nonorientableWord_mul_nonorientableWord`).

The fundamental groups are taken relative to a nonempty set of darts for the segment and to the
empty set (its maximal tree) for the loop, as in `TauCeti.GraphOfGroups.π₁Tree.equivPushoutI` and
`TauCeti.GraphOfGroups.π₁Tree.equivHNNExtension`.

## Main definitions

* `TauCeti.SurfaceGroup.Orientable.separatingSegment`,
  `TauCeti.SurfaceGroup.Orientable.nonseparatingLoop` and
  `TauCeti.SurfaceGroup.Nonorientable.separatingSegment`: the one-edge graphs of groups.
* `TauCeti.SurfaceGroup.Orientable.equivπ₁TreeSeparatingSegment`,
  `TauCeti.SurfaceGroup.Orientable.equivπ₁TreeNonseparatingLoop` and
  `TauCeti.SurfaceGroup.Nonorientable.equivπ₁TreeSeparatingSegment`: the surface groups as their
  fundamental groups.

## Main results

* `TauCeti.SurfaceGroup.Orientable.range_map_zpowers_peripheral_equivπ₁TreeSeparatingSegment`,
  `TauCeti.SurfaceGroup.Orientable.range_map_zpowers_peripheral_equivπ₁TreeNonseparatingLoop` and
  `TauCeti.SurfaceGroup.Nonorientable.range_map_zpowers_peripheral_equivπ₁TreeSeparatingSegment`:
  the boundary subgroups of the surface group are the cyclic subgroups generated by the images of
  the boundary elements of the vertex groups other than the sides of the cut curve.
* `TauCeti.SurfaceGroup.Orientable.π₁Tree_of_false_inv_a_mul_inv_b_mul_a_mul_b_genusTwo` and
  `TauCeti.SurfaceGroup.Orientable.edge_mul_of_peripheral_mul_inv_edge_genusTwo`: the closed
  surface group `S⁺(2, 0)` as the fundamental group of the segment `S⁺(1, 1) — ℤ — S⁺(1, 1)` with
  `[a₁, b₁] = [b₂, a₂]`, and of the loop on `S⁺(1, 2) ≅ F₃` with `t p₁ t⁻¹ = [a, b] p₁`.
* `TauCeti.SurfaceGroup.Nonorientable.π₁Tree_of_true_c_sq_kleinBottle`: the Klein bottle
  `S⁻(2, 0)` as the fundamental group of the segment of two Möbius bands `S⁻(1, 1)`, with
  `c₂² = c₁⁻²`.

## References

* V. Guirardel, G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §5.1.2 (an
  essential two-sided simple closed curve on a surface defines a cyclic splitting of its
  fundamental group relative to the boundary subgroups).
* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Cambridge University Press, 2002, §1.B, Example 1B.14 (closed surfaces cut along a circle as
  graphs of groups; the Klein bottle from two Möbius bands).
* J.-P. Serre, *Trees*, Springer, 1980, Chapter I, §4.1 and §5.1 (amalgams and HNN extensions as
  fundamental groups of segments and loops of groups).
-/

public section

namespace TauCeti

namespace SurfaceGroup

open GraphOfGroups

namespace Orientable

/-! ### A separating curve: a segment of groups -/

variable (g₁ m₁ g₂ m₂ : ℕ) (h₁ : g₁ ≠ 0 ∨ m₁ ≠ 0) (h₂ : g₂ ≠ 0 ∨ m₂ ≠ 0)

include h₁ h₂ in
/-- Neither piece is a disc, so that the maps `gluingMaps` amalgamated by `equivPushoutI`, onto the
boundary subgroups of the last peripheral elements of the two pieces, are injective. -/
theorem gluingMaps_injective (b : Bool) : Function.Injective (gluingMaps g₁ m₁ g₂ m₂ b) := by
  cases b
  · rw [gluingMaps_false]
    exact zpowersHom_peripheral_injective (h₁.imp_right fun _ ↦ by omega) _
  · rw [gluingMaps_true]
    exact zpowersHom_inv_peripheral_injective (h₂.imp_right fun _ ↦ by omega) _

/-- The segment of groups of a separating curve on the orientable surface of genus `g₁ + g₂` with
`m₁ + m₂` boundary components: vertex groups `S⁺(g₁, m₁ + 1)` at `false` and `S⁺(g₂, m₂ + 1)` at
`true`, edge group `ℤ`, and boundary maps `gluingMaps`, `n ↦ q₁ ^ n` and `n ↦ q₂ ^ (-n)`, onto the
boundary subgroups of the last peripheral elements `q₁` and `q₂` of the two pieces. Neither piece
is a disc, so that both maps are injective. -/
abbrev separatingSegment : GraphOfGroups.{0, 0, 0, 0} SerreGraph.segment :=
  segment (gluingMaps g₁ m₁ g₂ m₂ false) (gluingMaps g₁ m₁ g₂ m₂ true)
    (gluingMaps_injective g₁ m₁ g₂ m₂ h₁ h₂ false) (gluingMaps_injective g₁ m₁ g₂ m₂ h₁ h₂ true)

variable {T : Set SerreGraph.segment.E}

/-- `TauCeti.GraphOfGroups.π₁Tree.equivPushoutI` for `separatingSegment`, followed by
`TauCeti.GraphOfGroups.segmentPushoutIEquiv` to the amalgam of `equivPushoutI`. -/
private noncomputable def π₁TreeEquivPushoutI (hT : T.Nonempty) :
    π₁Tree (separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T ≃* Monoid.PushoutI (gluingMaps g₁ m₁ g₂ m₂) :=
  (π₁Tree.equivPushoutI _ _ _ _ hT).trans
    (segmentPushoutIEquiv (gluingMaps g₁ m₁ g₂ m₂) (gluingMaps_injective g₁ m₁ g₂ m₂ h₁ h₂))

/-- `π₁TreeEquivPushoutI` is the identity on the vertex groups. -/
@[simp]
private theorem π₁TreeEquivPushoutI_symm_of (hT : T.Nonempty) (b : Bool)
    (x : GluingFactor g₁ m₁ g₂ m₂ b) :
    (π₁TreeEquivPushoutI g₁ m₁ g₂ m₂ h₁ h₂ hT).symm (Monoid.PushoutI.of b x) =
      π₁Tree.of T b x := by
  rw [π₁TreeEquivPushoutI, MulEquiv.symm_trans_apply, segmentPushoutIEquiv_symm_of]
  cases b
  · rw [segmentVertexEquiv_symm_false_apply]
    exact π₁Tree.equivPushoutI_symm_of hT false x
  · rw [segmentVertexEquiv_symm_true_apply]
    exact π₁Tree.equivPushoutI_symm_of hT true x

/-- **Cutting along a separating curve, as a graph of groups.** The orientable surface group
`S⁺(g₁ + g₂, m₁ + m₂)` is the fundamental group of the segment of groups `separatingSegment`,
relative to any nonempty set of darts. It is `equivPushoutI` followed by the identification
`TauCeti.GraphOfGroups.π₁Tree.equivPushoutI` of the amalgam `S⁺(g₁, m₁ + 1) ∗_ℤ S⁺(g₂, m₂ + 1)`
with the fundamental group of the segment. -/
noncomputable def equivπ₁TreeSeparatingSegment (hT : T.Nonempty) :
    Orientable (g₁ + g₂) (m₁ + m₂) ≃* π₁Tree (separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T :=
  (equivPushoutI g₁ m₁ g₂ m₂).trans (π₁TreeEquivPushoutI g₁ m₁ g₂ m₂ h₁ h₂ hT).symm

variable {g₁ m₁ g₂ m₂ h₁ h₂} {hT : T.Nonempty}

@[simp]
theorem equivπ₁TreeSeparatingSegment_a_castAdd (i : Fin g₁) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (a (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.castAdd g₂ i)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false (a g₁ (m₁ + 1) i) := by
  simp [equivπ₁TreeSeparatingSegment]

@[simp]
theorem equivπ₁TreeSeparatingSegment_b_castAdd (i : Fin g₁) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (b (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.castAdd g₂ i)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false (b g₁ (m₁ + 1) i) := by
  simp [equivπ₁TreeSeparatingSegment]

/-- The handle generator `a_{g₁ + i}` goes to `P a''ᵢ P⁻¹`, where `a''ᵢ` is the generator of the
second piece and `P = p'₁ ⋯ p'_{m₁}` is the product of the remaining peripheral elements of the
first piece. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_a_natAdd (i : Fin g₂) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (a (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.natAdd g₁ i)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod *
        π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true (a g₂ (m₂ + 1) i) *
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod)⁻¹ := by
  simp [equivπ₁TreeSeparatingSegment]

/-- The handle generator `b_{g₁ + i}` goes to `P b''ᵢ P⁻¹`, where `b''ᵢ` is the generator of the
second piece and `P = p'₁ ⋯ p'_{m₁}`. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_b_natAdd (i : Fin g₂) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (b (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.natAdd g₁ i)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod *
        π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true (b g₂ (m₂ + 1) i) *
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod)⁻¹ := by
  simp [equivπ₁TreeSeparatingSegment]

/-- The first `m₁` peripheral elements are the remaining peripheral elements of the first
piece. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_peripheral_castAdd (j : Fin m₁) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (peripheral (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.castAdd m₂ j)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
        (peripheral g₁ (m₁ + 1) j.castSucc) := by
  simp [equivπ₁TreeSeparatingSegment]

/-- The last `m₂` peripheral elements are the remaining peripheral elements of the second
piece. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_peripheral_natAdd (j : Fin m₂) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (peripheral (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.natAdd m₁ j)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true
        (peripheral g₂ (m₂ + 1) j.castSucc) := by
  simp [equivπ₁TreeSeparatingSegment]

/-- On the first vertex group the inverse isomorphism is that of `equivPushoutI`, whose values on
the generators are given by the `equivPushoutI_symm_of_false_*` lemmas. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_symm_of_false (x : Orientable g₁ (m₁ + 1)) :
    DFunLike.coe (F := no_index _)
        (MulEquiv.symm (M := no_index _) (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT))
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false x) =
      (equivPushoutI g₁ m₁ g₂ m₂).symm
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) false x) := by
  rw [MulEquiv.symm_apply_eq]
  simp [equivπ₁TreeSeparatingSegment]

/-- On the second vertex group the inverse isomorphism is that of `equivPushoutI`, whose values on
the generators are given by the `equivPushoutI_symm_of_true_*` lemmas. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_symm_of_true (x : Orientable g₂ (m₂ + 1)) :
    DFunLike.coe (F := no_index _)
        (MulEquiv.symm (M := no_index _) (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT))
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true x) =
      (equivPushoutI g₁ m₁ g₂ m₂).symm
        (Monoid.PushoutI.of (φ := gluingMaps g₁ m₁ g₂ m₂) true x) := by
  rw [MulEquiv.symm_apply_eq]
  simp [equivπ₁TreeSeparatingSegment]

/-- **The peripheral structure of a surface cut along a separating curve.** The boundary
subgroups `⟨pⱼ⟩` of `S⁺(g₁ + g₂, m₁ + m₂)` correspond, under `equivπ₁TreeSeparatingSegment`, to
the cyclic subgroups of the fundamental group generated by the remaining boundary elements of the
two vertex groups, all but the two sides of the cut curve. -/
theorem range_map_zpowers_peripheral_equivπ₁TreeSeparatingSegment :
    Set.range (fun j ↦ (Subgroup.zpowers (peripheral (g₁ + g₂) (m₁ + m₂) j)).map
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT).toMonoidHom) =
      Set.range (fun j : Fin m₁ ↦ Subgroup.zpowers
          (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
            (peripheral g₁ (m₁ + 1) j.castSucc))) ∪
        Set.range (fun j : Fin m₂ ↦ Subgroup.zpowers
          (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true
            (peripheral g₂ (m₂ + 1) j.castSucc))) := by
  ext H
  simp only [Set.mem_union, Set.mem_range, MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom]
  constructor
  · rintro ⟨j, rfl⟩
    induction j using Fin.addCases with
    | left j => exact .inl ⟨j, by simp⟩
    | right j => exact .inr ⟨j, by simp⟩
  · rintro (⟨j, rfl⟩ | ⟨j, rfl⟩)
    · exact ⟨Fin.castAdd m₂ j, by simp⟩
    · exact ⟨Fin.natAdd m₁ j, by simp⟩

/-- **`S⁺(2, 0)` as the fundamental group of the segment `S⁺(1, 1) — ℤ — S⁺(1, 1)`.** The boundary
curve of the first one-holed torus, the image of the edge group, is the separating curve
`[b₁, a₁]` of the closed surface of genus two. -/
theorem equivπ₁TreeSeparatingSegment_symm_of_false_peripheral_genusTwo (hT : T.Nonempty) :
    (equivπ₁TreeSeparatingSegment 1 0 1 0 (.inl one_ne_zero) (.inl one_ne_zero) hT).symm
        (π₁Tree.of T false (peripheral 1 1 0)) =
      (b 2 0 0)⁻¹ * (a 2 0 0)⁻¹ * b 2 0 0 * a 2 0 0 := by
  rw [equivπ₁TreeSeparatingSegment_symm_of_false, ← equivPushoutI_symm_base_genusTwo,
    ← Monoid.PushoutI.of_apply_eq_base _ false]
  simp

/-- **`S⁺(2, 0)` along `[a₁, b₁] = [b₂, a₂]`.** In the fundamental group of the segment of two
one-holed tori `S⁺(1, 1)`, glued along their boundary curves with opposite orientations, the
commutator `[a₁, b₁]` of the first vertex group equals the commutator `[b₂, a₂]` of the second. -/
theorem π₁Tree_of_false_inv_a_mul_inv_b_mul_a_mul_b_genusTwo (hT : T.Nonempty) :
    π₁Tree.of (𝔸 := separatingSegment 1 0 1 0 (.inl one_ne_zero) (.inl one_ne_zero)) T false
        ((a 1 1 0)⁻¹ * (b 1 1 0)⁻¹ * a 1 1 0 * b 1 1 0) =
      π₁Tree.of T true ((b 1 1 0)⁻¹ * (a 1 1 0)⁻¹ * b 1 1 0 * a 1 1 0) := by
  refine (equivπ₁TreeSeparatingSegment 1 0 1 0 _ _ hT).symm.injective ?_
  rw [equivπ₁TreeSeparatingSegment_symm_of_false, equivπ₁TreeSeparatingSegment_symm_of_true]
  exact congrArg _ pushoutI_of_false_inv_a_mul_inv_b_mul_a_mul_b_genusTwo

/-! ### A non-separating curve: a loop of groups -/

variable (g m : ℕ)

/-- The loop of groups of a non-separating curve on the orientable surface of genus `g + 1` with
`m` boundary components: vertex group `S⁺(g, m + 2)`, edge group `ℤ`, and boundary maps
`curveFst` and `curveSnd` onto the boundary subgroups of the last two peripheral elements, the
two sides of the curve. -/
abbrev nonseparatingLoop : GraphOfGroups.{0, 0, 0, 0} (SerreGraph.rose Unit) :=
  loop (curveFst g m) (curveSnd g m) (curveFst_injective g m) (curveSnd_injective g m)

/-- **Cutting along a non-separating curve, as a graph of groups.** The orientable surface group
`S⁺(g + 1, m)` is the fundamental group of the loop of groups `nonseparatingLoop`, relative to
its maximal tree `∅`: `equivHNNExtension` followed by the identification of the HNN extension
with the fundamental group of the loop. -/
noncomputable def equivπ₁TreeNonseparatingLoop :
    Orientable (g + 1) m ≃* π₁Tree (nonseparatingLoop g m) ∅ :=
  (equivHNNExtension g m).trans (π₁Tree.equivHNNExtension _ _ _ _).symm

variable {g m}

/-- The first generator `a₁` of the cut handle goes to the dart `((), false)`, the stable letter of
the HNN extension. -/
@[simp]
theorem equivπ₁TreeNonseparatingLoop_a_zero :
    equivπ₁TreeNonseparatingLoop g m (a (g + 1) m 0) = π₁Tree.edge ∅ ((), false) := by
  simp [equivπ₁TreeNonseparatingLoop]

/-- The second generator `b₁` of the cut handle, the non-separating curve, goes to the last
peripheral element of the vertex group. -/
@[simp]
theorem equivπ₁TreeNonseparatingLoop_b_zero :
    equivπ₁TreeNonseparatingLoop g m (b (g + 1) m 0) =
      π₁Tree.of (𝔸 := nonseparatingLoop g m) ∅ () (peripheral g (m + 2) (Fin.last (m + 1))) := by
  simp [equivπ₁TreeNonseparatingLoop]

@[simp]
theorem equivπ₁TreeNonseparatingLoop_a_succ (i : Fin g) :
    equivπ₁TreeNonseparatingLoop g m (a (g + 1) m i.succ) =
      π₁Tree.of (𝔸 := nonseparatingLoop g m) ∅ () (a g (m + 2) i) := by
  simp [equivπ₁TreeNonseparatingLoop]

@[simp]
theorem equivπ₁TreeNonseparatingLoop_b_succ (i : Fin g) :
    equivπ₁TreeNonseparatingLoop g m (b (g + 1) m i.succ) =
      π₁Tree.of (𝔸 := nonseparatingLoop g m) ∅ () (b g (m + 2) i) := by
  simp [equivπ₁TreeNonseparatingLoop]

/-- The peripheral elements of `S⁺(g + 1, m)` are the remaining peripheral elements of the vertex
group. -/
@[simp]
theorem equivπ₁TreeNonseparatingLoop_peripheral (j : Fin m) :
    equivπ₁TreeNonseparatingLoop g m (peripheral (g + 1) m j) =
      π₁Tree.of (𝔸 := nonseparatingLoop g m) ∅ () (peripheral g (m + 2) j.castSucc.castSucc) := by
  simp [equivπ₁TreeNonseparatingLoop]

/-- On the vertex group the inverse isomorphism is that of `equivHNNExtension`, whose values on
the generators are given by the `equivHNNExtension_symm_of_*` lemmas. -/
@[simp]
theorem equivπ₁TreeNonseparatingLoop_symm_of (x : Orientable g (m + 2)) :
    (equivπ₁TreeNonseparatingLoop g m).symm (π₁Tree.of (𝔸 := nonseparatingLoop g m) ∅ () x) =
      (equivHNNExtension g m).symm (HNNExtension.of x) := by
  simp [equivπ₁TreeNonseparatingLoop]

@[simp]
theorem equivπ₁TreeNonseparatingLoop_symm_edge_false :
    (equivπ₁TreeNonseparatingLoop g m).symm (π₁Tree.edge ∅ ((), false)) = a (g + 1) m 0 := by
  simp [equivπ₁TreeNonseparatingLoop]

/-- **The peripheral structure of a surface cut along a non-separating curve.** The boundary
subgroups `⟨pⱼ⟩` of `S⁺(g + 1, m)` correspond, under `equivπ₁TreeNonseparatingLoop`, to the cyclic
subgroups generated by the boundary elements of the vertex group other than the two sides of the
cut curve. -/
theorem range_map_zpowers_peripheral_equivπ₁TreeNonseparatingLoop :
    Set.range (fun j ↦ (Subgroup.zpowers (peripheral (g + 1) m j)).map
        (equivπ₁TreeNonseparatingLoop g m).toMonoidHom) =
      Set.range (fun j : Fin m ↦ Subgroup.zpowers
          (π₁Tree.of (𝔸 := nonseparatingLoop g m) ∅ ()
            (peripheral g (m + 2) j.castSucc.castSucc))) := by
  ext H
  simp [MonoidHom.map_zpowers]

/-- **`S⁺(2, 0)` as the fundamental group of a loop on `S⁺(1, 2) ≅ F₃`.** In the fundamental group
of `nonseparatingLoop 1 0`, onto which `equivπ₁TreeNonseparatingLoop 1 0` maps `S⁺(2, 0)`, the
dart `((), false)` conjugates `p₁` to `[a, b] p₁`; the vertex group `S⁺(1, 2)` is free on
`a, b, p₁` (`TauCeti.SurfaceGroup.Orientable.freeBasis`). -/
theorem edge_mul_of_peripheral_mul_inv_edge_genusTwo :
    π₁Tree.edge ∅ ((), false) * π₁Tree.of (𝔸 := nonseparatingLoop 1 0) ∅ () (peripheral 1 2 0) *
        (π₁Tree.edge ∅ ((), false))⁻¹ =
      π₁Tree.of (𝔸 := nonseparatingLoop 1 0) ∅ ()
        ((a 1 2 0)⁻¹ * (b 1 2 0)⁻¹ * a 1 2 0 * b 1 2 0 * peripheral 1 2 0) := by
  have h := congrArg (π₁Tree.equivHNNExtension _ _ _ _).symm t_mul_of_peripheral_mul_inv_t_genusTwo
  rwa [map_mul, map_mul, map_inv, π₁Tree.equivHNNExtension_symm_t,
    π₁Tree.equivHNNExtension_symm_of, π₁Tree.equivHNNExtension_symm_of] at h

end Orientable

namespace Nonorientable

/-! ### A separating curve on a nonorientable surface -/

variable (g₁ m₁ g₂ m₂ : ℕ) (h₁ : g₁ ≠ 0 ∨ m₁ ≠ 0) (h₂ : g₂ ≠ 0 ∨ m₂ ≠ 0)

/-- The segment of groups of a separating curve on the nonorientable surface `S⁻(g₁ + g₂, m₁ + m₂)`:
vertex groups `S⁻(g₁, m₁ + 1)` at `false` and `S⁻(g₂, m₂ + 1)` at `true`, edge group `ℤ`, and
boundary maps `n ↦ q₁ ^ n` and `n ↦ q₂ ^ (-n)` onto the boundary subgroups of the last
peripheral elements `q₁` and `q₂` of the two pieces. Neither piece is a disc, so that both maps
are injective. -/
abbrev separatingSegment : GraphOfGroups.{0, 0, 0, 0} SerreGraph.segment :=
  segment (zpowersHom _ (peripheral g₁ (m₁ + 1) (Fin.last m₁)))
    (zpowersHom _ (peripheral g₂ (m₂ + 1) (Fin.last m₂))⁻¹)
    (zpowersHom_peripheral_injective (h₁.imp_right fun _ ↦ by omega) _)
    (zpowersHom_inv_peripheral_injective (h₂.imp_right fun _ ↦ by omega) _)

variable {T : Set SerreGraph.segment.E}

/-- The vertex group `S⁻(g₁, m₁ + 1)` of `separatingSegment` in its fundamental group. -/
private noncomputable def ofFst :
    Nonorientable g₁ (m₁ + 1) →* π₁Tree (separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T :=
  π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false

/-- The vertex group `S⁻(g₂, m₂ + 1)` of `separatingSegment` in its fundamental group. -/
private noncomputable def ofSnd :
    Nonorientable g₂ (m₂ + 1) →* π₁Tree (separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T :=
  π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true

private theorem ofFst_apply (x : Nonorientable g₁ (m₁ + 1)) :
    ofFst g₁ m₁ g₂ m₂ h₁ h₂ (T := T) x = π₁Tree.of T false x := rfl

private theorem ofSnd_apply (x : Nonorientable g₂ (m₂ + 1)) :
    ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (T := T) x = π₁Tree.of T true x := rfl

/-- The two sides of the cut curve in the fundamental group of the segment. -/
private theorem ofSnd_inv_peripheral_last (hT : T.Nonempty) :
    ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (T := T) (peripheral g₂ (m₂ + 1) (Fin.last m₂))⁻¹ =
      ofFst g₁ m₁ g₂ m₂ h₁ h₂ (peripheral g₁ (m₁ + 1) (Fin.last m₁)) := by
  have h : ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (T := T)
      (zpowersHom _ (peripheral g₂ (m₂ + 1) (Fin.last m₂))⁻¹ (.ofAdd 1)) =
      ofFst g₁ m₁ g₂ m₂ h₁ h₂ (zpowersHom _ (peripheral g₁ (m₁ + 1) (Fin.last m₁)) (.ofAdd 1)) :=
    π₁Tree.of_true_eq_of_false hT _
  simpa using h

/-- The product `p₁ ⋯ p_{m₁}` of the peripheral elements of the first piece other than the cut
one. -/
private abbrev boundaryProd : Nonorientable g₁ (m₁ + 1) :=
  (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod

/-- The product `p₁ ⋯ p_{m₁}` of the peripheral elements of `S⁻(g₁ + g₂, m₁ + m₂)` coming from the
first piece. -/
private abbrev boundaryProd' : Nonorientable (g₁ + g₂) (m₁ + m₂) :=
  (List.ofFn fun j : Fin m₁ ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)).prod

/-- The word `c₁² ⋯ c_{g₁}² p₁ ⋯ p_{m₁}` of the first piece in `S⁻(g₁ + g₂, m₁ + m₂)`: the inverse
of the separating curve. -/
private abbrev firstWord : Nonorientable (g₁ + g₂) (m₁ + m₂) :=
  nonorientableWord (fun i ↦ c (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i))
    fun j ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)

/-- The word of the second piece in `S⁻(g₁ + g₂, m₁ + m₂)`, in the crosscap elements
`P⁻¹ c_{g₁ + i} P` for `P = p₁ ⋯ p_{m₁}`. -/
private abbrev secondWord : Nonorientable (g₁ + g₂) (m₁ + m₂) :=
  nonorientableWord
    (fun i ↦ (boundaryProd' g₁ m₁ g₂ m₂)⁻¹ * c (g₁ + g₂) (m₁ + m₂) (Fin.natAdd g₁ i) *
      boundaryProd' g₁ m₁ g₂ m₂)
    fun j ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.natAdd m₁ j)

/-- The relation of `S⁻(g₁ + g₂, m₁ + m₂)` is the product of the words of the two pieces. -/
private theorem firstWord_mul_secondWord :
    firstWord g₁ m₁ g₂ m₂ * secondWord g₁ m₁ g₂ m₂ = 1 := by
  rw [firstWord, secondWord, nonorientableWord_mul_nonorientableWord]
  simp only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one, Fin.append_castAdd_natAdd]
  exact nonorientableWord_c_peripheral _ _

/-- The map `S⁻(g₁ + g₂, m₁ + m₂) → π₁(separatingSegment)`. -/
private noncomputable def toπ₁Tree (hT : T.Nonempty) :
    Nonorientable (g₁ + g₂) (m₁ + m₂) →* π₁Tree (separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T :=
  lift
    (Fin.append (fun i ↦ ofFst g₁ m₁ g₂ m₂ h₁ h₂ (c g₁ (m₁ + 1) i)) fun i ↦
      ofFst g₁ m₁ g₂ m₂ h₁ h₂ (boundaryProd g₁ m₁) * ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (c g₂ (m₂ + 1) i) *
        (ofFst g₁ m₁ g₂ m₂ h₁ h₂ (boundaryProd g₁ m₁))⁻¹)
    (Fin.append (fun j ↦ ofFst g₁ m₁ g₂ m₂ h₁ h₂ (peripheral g₁ (m₁ + 1) j.castSucc))
      fun j ↦ ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (peripheral g₂ (m₂ + 1) j.castSucc)) <| by
    have hP : (List.ofFn fun j ↦ ofFst g₁ m₁ g₂ m₂ h₁ h₂ (T := T)
        (peripheral g₁ (m₁ + 1) j.castSucc)).prod =
        ofFst g₁ m₁ g₂ m₂ h₁ h₂ (boundaryProd g₁ m₁) := by
      simp [boundaryProd, map_list_prod, List.map_ofFn, Function.comp_def]
    rw [← hP, ← nonorientableWord_mul_nonorientableWord, ← map_nonorientableWord,
      ← map_nonorientableWord, nonorientableWord_peripheral_castSucc,
      nonorientableWord_peripheral_castSucc, ofSnd_inv_peripheral_last g₁ m₁ g₂ m₂ h₁ h₂ hT,
      ← map_mul, inv_mul_cancel, map_one]

/-- The map `S⁻(g₁, m₁ + 1) → S⁻(g₁ + g₂, m₁ + m₂)` of the first piece. -/
private def ofFirst : Nonorientable g₁ (m₁ + 1) →* Nonorientable (g₁ + g₂) (m₁ + m₂) :=
  lift (fun i ↦ c _ _ (Fin.castAdd g₂ i))
    (Fin.snoc (α := fun _ ↦ Nonorientable (g₁ + g₂) (m₁ + m₂))
      (fun j ↦ peripheral _ _ (Fin.castAdd m₂ j)) (firstWord g₁ m₁ g₂ m₂)⁻¹)
    (by rw [nonorientableWord_snoc, mul_inv_cancel])

/-- The map `S⁻(g₂, m₂ + 1) → S⁻(g₁ + g₂, m₁ + m₂)` of the second piece. -/
private def ofSecond : Nonorientable g₂ (m₂ + 1) →* Nonorientable (g₁ + g₂) (m₁ + m₂) :=
  lift (fun i ↦ (boundaryProd' g₁ m₁ g₂ m₂)⁻¹ * c _ _ (Fin.natAdd g₁ i) * boundaryProd' g₁ m₁ g₂ m₂)
    (Fin.snoc (α := fun _ ↦ Nonorientable (g₁ + g₂) (m₁ + m₂))
      (fun j ↦ peripheral _ _ (Fin.natAdd m₁ j)) (secondWord g₁ m₁ g₂ m₂)⁻¹)
    (by rw [nonorientableWord_snoc, mul_inv_cancel])

/-- The two sides of the cut curve agree in `S⁻(g₁ + g₂, m₁ + m₂)`. -/
private theorem ofSecond_zpowersHom_inv (n : Multiplicative ℤ) :
    ofSecond g₁ m₁ g₂ m₂ (zpowersHom _ (peripheral g₂ (m₂ + 1) (Fin.last m₂))⁻¹ n) =
      ofFirst g₁ m₁ g₂ m₂ (zpowersHom _ (peripheral g₁ (m₁ + 1) (Fin.last m₁)) n) := by
  simp [ofFirst, ofSecond, ← eq_inv_of_mul_eq_one_left (firstWord_mul_secondWord g₁ m₁ g₂ m₂)]

/-- The map `π₁(separatingSegment) → S⁻(g₁ + g₂, m₁ + m₂)`, trivial on the darts. -/
private noncomputable def ofπ₁Tree :
    π₁Tree (separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T →* Nonorientable (g₁ + g₂) (m₁ + m₂) :=
  π₁Tree.lift
    (fun b : SerreGraph.segment.V ↦ Bool.rec
      (motive := fun b : SerreGraph.segment.V ↦
        (separatingSegment g₁ m₁ g₂ m₂ h₁ h₂).vertexGroup b →* _)
      (ofFirst g₁ m₁ g₂ m₂) (ofSecond g₁ m₁ g₂ m₂) b) 1
    (fun _ _ ↦ rfl) (fun _ ↦ by simp) fun e c ↦ by
      simp only [Pi.one_apply, one_mul, inv_one, mul_one]
      cases e
      · simp only [segment_ω_false, segment_α_false]
        exact ofSecond_zpowersHom_inv g₁ m₁ g₂ m₂ c
      · simp only [segment_ω_true, segment_α_true]
        exact (ofSecond_zpowersHom_inv g₁ m₁ g₂ m₂ c).symm

private theorem ofπ₁Tree_comp_ofFst :
    (ofπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂).comp (ofFst g₁ m₁ g₂ m₂ h₁ h₂ (T := T)) = ofFirst g₁ m₁ g₂ m₂ := by
  unfold ofπ₁Tree ofFst
  exact π₁Tree.lift_comp_of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) _ _ _ _ _ false

private theorem ofπ₁Tree_comp_ofSnd :
    (ofπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂).comp (ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (T := T)) =
      ofSecond g₁ m₁ g₂ m₂ := by
  unfold ofπ₁Tree ofSnd
  exact π₁Tree.lift_comp_of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) _ _ _ _ _ true

@[simp]
private theorem ofπ₁Tree_ofFst (x : Nonorientable g₁ (m₁ + 1)) :
    ofπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ (ofFst g₁ m₁ g₂ m₂ h₁ h₂ (T := T) x) = ofFirst g₁ m₁ g₂ m₂ x :=
  DFunLike.congr_fun (ofπ₁Tree_comp_ofFst g₁ m₁ g₂ m₂ h₁ h₂) x

@[simp]
private theorem ofπ₁Tree_ofSnd (x : Nonorientable g₂ (m₂ + 1)) :
    ofπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ (ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (T := T) x) = ofSecond g₁ m₁ g₂ m₂ x :=
  DFunLike.congr_fun (ofπ₁Tree_comp_ofSnd g₁ m₁ g₂ m₂ h₁ h₂) x

@[simp]
private theorem ofFirst_boundaryProd :
    ofFirst g₁ m₁ g₂ m₂ (boundaryProd g₁ m₁) = boundaryProd' g₁ m₁ g₂ m₂ := by
  simp [ofFirst, boundaryProd, boundaryProd', map_list_prod, List.map_ofFn, Function.comp_def]

variable {g₁ m₁ g₂ m₂ h₁ h₂}

@[simp]
private theorem toπ₁Tree_c_castAdd (hT : T.Nonempty) (i : Fin g₁) :
    toπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ hT (c (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i)) =
      ofFst g₁ m₁ g₂ m₂ h₁ h₂ (c g₁ (m₁ + 1) i) := by
  simp [toπ₁Tree]

@[simp]
private theorem toπ₁Tree_c_natAdd (hT : T.Nonempty) (i : Fin g₂) :
    toπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ hT (c (g₁ + g₂) (m₁ + m₂) (Fin.natAdd g₁ i)) =
      ofFst g₁ m₁ g₂ m₂ h₁ h₂ (boundaryProd g₁ m₁) * ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (c g₂ (m₂ + 1) i) *
        (ofFst g₁ m₁ g₂ m₂ h₁ h₂ (boundaryProd g₁ m₁))⁻¹ := by
  simp [toπ₁Tree]

@[simp]
private theorem toπ₁Tree_peripheral_castAdd (hT : T.Nonempty) (j : Fin m₁) :
    toπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ hT (peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)) =
      ofFst g₁ m₁ g₂ m₂ h₁ h₂ (peripheral g₁ (m₁ + 1) j.castSucc) := by
  simp [toπ₁Tree]

@[simp]
private theorem toπ₁Tree_peripheral_natAdd (hT : T.Nonempty) (j : Fin m₂) :
    toπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ hT (peripheral (g₁ + g₂) (m₁ + m₂) (Fin.natAdd m₁ j)) =
      ofSnd g₁ m₁ g₂ m₂ h₁ h₂ (peripheral g₂ (m₂ + 1) j.castSucc) := by
  simp [toπ₁Tree]

private theorem toπ₁Tree_boundaryProd' (hT : T.Nonempty) :
    toπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ hT (boundaryProd' g₁ m₁ g₂ m₂) =
      ofFst g₁ m₁ g₂ m₂ h₁ h₂ (boundaryProd g₁ m₁) := by
  simp [boundaryProd, boundaryProd', map_list_prod, List.map_ofFn, Function.comp_def]

private theorem toπ₁Tree_comp_ofFirst (hT : T.Nonempty) :
    (toπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ hT).comp (ofFirst g₁ m₁ g₂ m₂) = ofFst g₁ m₁ g₂ m₂ h₁ h₂ := by
  refine hom_ext (fun i ↦ by simp [ofFirst]) (Fin.lastCases ?_ fun j ↦ by simp [ofFirst])
  rw [MonoidHom.comp_apply, ofFirst, lift_peripheral, Fin.snoc_last, map_inv, firstWord,
    map_nonorientableWord]
  simp only [toπ₁Tree_c_castAdd, toπ₁Tree_peripheral_castAdd]
  rw [← map_nonorientableWord, nonorientableWord_peripheral_castSucc, map_inv, inv_inv]

private theorem toπ₁Tree_comp_ofSecond (hT : T.Nonempty) :
    (toπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ hT).comp (ofSecond g₁ m₁ g₂ m₂) = ofSnd g₁ m₁ g₂ m₂ h₁ h₂ := by
  refine hom_ext (fun i ↦ ?_) (Fin.lastCases ?_ fun j ↦ by simp [ofSecond])
  · simp [ofSecond, toπ₁Tree_boundaryProd', mul_assoc]
  rw [MonoidHom.comp_apply, ofSecond, lift_peripheral, Fin.snoc_last, map_inv, secondWord,
    map_nonorientableWord]
  simp only [map_mul, map_inv, toπ₁Tree_c_natAdd, toπ₁Tree_peripheral_natAdd,
    toπ₁Tree_boundaryProd', mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one]
  rw [← map_nonorientableWord, nonorientableWord_peripheral_castSucc, map_inv, inv_inv]

variable (g₁ m₁ g₂ m₂ h₁ h₂)

/-- **Cutting a nonorientable surface along a separating curve, as a graph of groups.** The
nonorientable surface group `S⁻(g₁ + g₂, m₁ + m₂)` is the fundamental group of the segment of
groups `separatingSegment`, relative to any nonempty set of darts.

Write `c, p` for the generators of `S⁻(g₁ + g₂, m₁ + m₂)`, `c', p'` for those of the first piece
and `c'', p''` for those of the second. The isomorphism sends `cᵢ` to `c'ᵢ` for `i ≤ g₁`,
`c_{g₁ + i}` to `P c''ᵢ P⁻¹` with `P = p'₁ ⋯ p'_{m₁}`, and the peripheral elements `pⱼ` and
`p_{m₁ + j}` to `p'ⱼ` and `p''ⱼ`. -/
noncomputable def equivπ₁TreeSeparatingSegment (hT : T.Nonempty) :
    Nonorientable (g₁ + g₂) (m₁ + m₂) ≃* π₁Tree (separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T :=
  MonoidHom.toMulEquiv (toπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂ hT) (ofπ₁Tree g₁ m₁ g₂ m₂ h₁ h₂)
    (hom_ext (Fin.addCases (fun i ↦ by simp [ofFirst])
        fun i ↦ by simp [ofSecond, mul_assoc])
      (Fin.addCases (fun j ↦ by simp [ofFirst]) fun j ↦ by simp [ofSecond]))
    (π₁Tree.hom_ext (fun b ↦ MonoidHom.ext fun x ↦ by
        cases b
        · exact (congrArg _ (ofπ₁Tree_ofFst _ _ _ _ _ _ x)).trans
            (DFunLike.congr_fun (toπ₁Tree_comp_ofFirst hT) x)
        · exact (congrArg _ (ofπ₁Tree_ofSnd _ _ _ _ _ _ x)).trans
            (DFunLike.congr_fun (toπ₁Tree_comp_ofSecond hT) x))
      fun e ↦ by simp [ofπ₁Tree, π₁Tree.edge_segment_eq_one hT])

variable {g₁ m₁ g₂ m₂ h₁ h₂} {hT : T.Nonempty}

@[simp]
theorem equivπ₁TreeSeparatingSegment_c_castAdd (i : Fin g₁) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (c (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.castAdd g₂ i)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false (c g₁ (m₁ + 1) i) :=
  toπ₁Tree_c_castAdd hT i

/-- The crosscap generator `c_{g₁ + i}` goes to `P c''ᵢ P⁻¹`, where `c''ᵢ` is the generator of the
second piece and `P = p'₁ ⋯ p'_{m₁}`. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_c_natAdd (i : Fin g₂) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (c (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.natAdd g₁ i)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod *
        π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true (c g₂ (m₂ + 1) i) *
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
          (List.ofFn fun j : Fin m₁ ↦ peripheral g₁ (m₁ + 1) j.castSucc).prod)⁻¹ :=
  toπ₁Tree_c_natAdd hT i

@[simp]
theorem equivπ₁TreeSeparatingSegment_peripheral_castAdd (j : Fin m₁) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (peripheral (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.castAdd m₂ j)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
        (peripheral g₁ (m₁ + 1) j.castSucc) :=
  toπ₁Tree_peripheral_castAdd hT j

@[simp]
theorem equivπ₁TreeSeparatingSegment_peripheral_natAdd (j : Fin m₂) :
    DFunLike.coe (F := no_index _) (α := no_index _)
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT)
        (peripheral (no_index (g₁ + g₂)) (no_index (m₁ + m₂)) (Fin.natAdd m₁ j)) =
      π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true
        (peripheral g₂ (m₂ + 1) j.castSucc) :=
  toπ₁Tree_peripheral_natAdd hT j

@[simp]
theorem equivπ₁TreeSeparatingSegment_symm_of_false_c (i : Fin g₁) :
    DFunLike.coe (F := no_index _)
        (MulEquiv.symm (M := no_index _) (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT))
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false (c g₁ (m₁ + 1) i)) =
      c (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i) :=
  (ofπ₁Tree_ofFst _ _ _ _ _ _ _).trans (by simp [ofFirst])

@[simp]
theorem equivπ₁TreeSeparatingSegment_symm_of_false_peripheral_castSucc (j : Fin m₁) :
    DFunLike.coe (F := no_index _)
        (MulEquiv.symm (M := no_index _) (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT))
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
          (peripheral g₁ (m₁ + 1) j.castSucc)) =
      peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j) :=
  (ofπ₁Tree_ofFst _ _ _ _ _ _ _).trans (by simp [ofFirst])

/-- The crosscap generator `c''ᵢ` of the second piece is `P⁻¹ c_{g₁ + i} P` with
`P = p₁ ⋯ p_{m₁}`. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_symm_of_true_c (i : Fin g₂) :
    DFunLike.coe (F := no_index _)
        (MulEquiv.symm (M := no_index _) (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT))
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true (c g₂ (m₂ + 1) i)) =
      (List.ofFn fun j : Fin m₁ ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)).prod⁻¹ *
        c (g₁ + g₂) (m₁ + m₂) (Fin.natAdd g₁ i) *
        (List.ofFn fun j : Fin m₁ ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j)).prod :=
  (ofπ₁Tree_ofSnd _ _ _ _ _ _ _).trans (by simp [ofSecond])

@[simp]
theorem equivπ₁TreeSeparatingSegment_symm_of_true_peripheral_castSucc (j : Fin m₂) :
    DFunLike.coe (F := no_index _)
        (MulEquiv.symm (M := no_index _) (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT))
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true
          (peripheral g₂ (m₂ + 1) j.castSucc)) =
      peripheral (g₁ + g₂) (m₁ + m₂) (Fin.natAdd m₁ j) :=
  (ofπ₁Tree_ofSnd _ _ _ _ _ _ _).trans (by simp [ofSecond])

/-- The last boundary element of the second piece is the inverse of the separating curve. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_symm_of_true_peripheral_last :
    DFunLike.coe (F := no_index _)
        (MulEquiv.symm (M := no_index _) (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT))
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true
          (peripheral g₂ (m₂ + 1) (Fin.last m₂))) =
      nonorientableWord (fun i ↦ c (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i))
        fun j ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j) :=
  (ofπ₁Tree_ofSnd _ _ _ _ _ _ _).trans <| by
    simp [ofSecond, inv_eq_of_mul_eq_one_left (firstWord_mul_secondWord g₁ m₁ g₂ m₂)]

/-- **The edge group is the separating curve.** The last boundary element of the first piece is
the separating curve `(c₁² ⋯ c_{g₁}² p₁ ⋯ p_{m₁})⁻¹` of `S⁻(g₁ + g₂, m₁ + m₂)`. -/
@[simp]
theorem equivπ₁TreeSeparatingSegment_symm_of_false_peripheral_last :
    DFunLike.coe (F := no_index _)
        (MulEquiv.symm (M := no_index _) (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT))
        (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
          (peripheral g₁ (m₁ + 1) (Fin.last m₁))) =
      (nonorientableWord (fun i ↦ c (g₁ + g₂) (m₁ + m₂) (Fin.castAdd g₂ i))
        fun j ↦ peripheral (g₁ + g₂) (m₁ + m₂) (Fin.castAdd m₂ j))⁻¹ :=
  (ofπ₁Tree_ofFst _ _ _ _ _ _ _).trans (by simp [ofFirst])

/-- **The peripheral structure of a nonorientable surface cut along a separating curve.** The
boundary subgroups `⟨pⱼ⟩` of `S⁻(g₁ + g₂, m₁ + m₂)` correspond, under
`equivπ₁TreeSeparatingSegment`, to the cyclic subgroups generated by the remaining boundary
elements of the two vertex groups. -/
theorem range_map_zpowers_peripheral_equivπ₁TreeSeparatingSegment :
    Set.range (fun j ↦ (Subgroup.zpowers (peripheral (g₁ + g₂) (m₁ + m₂) j)).map
        (equivπ₁TreeSeparatingSegment g₁ m₁ g₂ m₂ h₁ h₂ hT).toMonoidHom) =
      Set.range (fun j : Fin m₁ ↦ Subgroup.zpowers
          (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T false
            (peripheral g₁ (m₁ + 1) j.castSucc))) ∪
        Set.range (fun j : Fin m₂ ↦ Subgroup.zpowers
          (π₁Tree.of (𝔸 := separatingSegment g₁ m₁ g₂ m₂ h₁ h₂) T true
            (peripheral g₂ (m₂ + 1) j.castSucc))) := by
  ext H
  simp only [Set.mem_union, Set.mem_range, MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom]
  constructor
  · rintro ⟨j, rfl⟩
    induction j using Fin.addCases with
    | left j => exact .inl ⟨j, by simp⟩
    | right j => exact .inr ⟨j, by simp⟩
  · rintro (⟨j, rfl⟩ | ⟨j, rfl⟩)
    · exact ⟨Fin.castAdd m₂ j, by simp⟩
    · exact ⟨Fin.natAdd m₁ j, by simp⟩

/-- **The Klein bottle from two Möbius bands.** In the fundamental group of the segment of two
Möbius bands `S⁻(1, 1)` (onto which `equivπ₁TreeSeparatingSegment 1 0 1 0` maps the Klein bottle
group `S⁻(2, 0)`), the square of the core curve of the second band is the inverse of that of the
first: `c₂² = c₁⁻²`. -/
theorem π₁Tree_of_true_c_sq_kleinBottle (hT : T.Nonempty) :
    π₁Tree.of (𝔸 := separatingSegment 1 0 1 0 (.inl one_ne_zero) (.inl one_ne_zero)) T true
        (c 1 1 0 ^ 2 : Nonorientable 1 1) =
      (π₁Tree.of (𝔸 := separatingSegment 1 0 1 0 (.inl one_ne_zero) (.inl one_ne_zero)) T false
        (c 1 1 0 ^ 2 : Nonorientable 1 1))⁻¹ := by
  -- In the Möbius band `S⁻(1, 1)` the relation `c² p = 1` gives `c² = p⁻¹`.
  have hc : c 1 1 0 ^ 2 = (peripheral 1 1 (Fin.last 0))⁻¹ := by
    have h := nonorientableWord_c_peripheral 1 1
    simp only [nonorientableWord_def, List.ofFn_succ, List.ofFn_zero, List.prod_cons,
      List.prod_nil, mul_one] at h
    exact eq_inv_of_mul_eq_one_left h
  rw [hc, ← ofFst_apply, ← ofSnd_apply, ofSnd_inv_peripheral_last 1 0 1 0 _ _ hT, map_inv,
    inv_inv]

