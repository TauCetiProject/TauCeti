/-!
# Orientable surface groups as HNN extensions along a non-separating curve

Cutting the compact orientable surface of genus `g + 1` with `m` boundary components along a
non-separating simple closed curve leaves a surface of genus `g` with `m + 2` boundary components,
two of which are the two sides of the curve. Dually, the surface group `S⁺(g + 1, m)` is an HNN
extension of `S⁺(g, m + 2)` that identifies these two boundary curves:

`S⁺(g + 1, m) ≃* S⁺(g, m + 2) ∗_ℤ`,

where the edge group `ℤ` goes to the boundary subgroups generated by the last two peripheral
elements `x = p_{m+1}` and `y = p_{m+2}` of `S⁺(g, m + 2)`, by `n ↦ x ^ n` and `n ↦ y ^ (-n)`
(`TauCeti.SurfaceGroup.Orientable.curveFst` and `TauCeti.SurfaceGroup.Orientable.curveSnd`), and
the stable letter `t` satisfies `t x t⁻¹ = y⁻¹`: the two sides of the curve carry opposite
orientations. Both maps are injective because a surface with at least two boundary components is
not a disc (`TauCeti.SurfaceGroup.Orientable.zpowersHom_peripheral_injective`), so these are the
monomorphic edge maps of a loop of groups, and the HNN extension is taken along their
identification `TauCeti.GraphOfGroups.loopEquiv`, as for the fundamental group of a loop of
groups.

On presentations this is a Tietze transformation. Write `a₁, b₁` for the first handle of
`S⁺(g + 1, m)`, `W = [a₂, b₂] ⋯ [a_{g+1}, b_{g+1}]` and `P = p₁ ⋯ p_m`. The defining relation
`[a₁, b₁] W P = 1` is equivalent to its cyclic permutation `W P [a₁, b₁] = 1`, that is
`W P x y = 1` for `x = a₁⁻¹ b₁⁻¹ a₁` and `y = b₁`, and `x` is determined by `a₁ x a₁⁻¹ = y⁻¹`.
This is the relation of `S⁺(g, m + 2)` in the generators `a₂, b₂, …, p₁, …, p_m, x, y`, together
with the HNN relation for the stable letter `t = a₁`. Under the isomorphism the peripheral elements
`p₁, …, p_m` of `S⁺(g + 1, m)` are exactly the remaining peripheral elements of `S⁺(g, m + 2)`, and
the non-separating curve is `b₁ = p_{m+2}`.

## Main definitions

* `TauCeti.SurfaceGroup.Orientable.curveFst` and `TauCeti.SurfaceGroup.Orientable.curveSnd`: the
  two boundary maps `ℤ → S⁺(g, m + 2)` onto the sides of the cut curve.
* `TauCeti.SurfaceGroup.Orientable.equivHNNExtension`: the isomorphism of `S⁺(g + 1, m)` with the
  HNN extension of `S⁺(g, m + 2)` along these two maps.

## Main results

* `TauCeti.SurfaceGroup.Orientable.t_mul_of_peripheral_mul_inv_t`: in the HNN extension, the
  stable letter conjugates `p_{m+1}` to `p_{m+2}⁻¹`.
* `TauCeti.SurfaceGroup.Orientable.t_mul_of_peripheral_mul_inv_t_genusTwo`: in the HNN extension
  of `S⁺(1, 2)` onto which `equivHNNExtension 1 0` maps the closed surface group `S⁺(2, 0)`, the
  stable letter conjugates `p₁` to `[a, b] p₁`; since `S⁺(1, 2)` is free on `a, b, p₁`
  (`TauCeti.SurfaceGroup.Orientable.freeBasis`), this exhibits `S⁺(2, 0)` as an HNN extension of
  a free group of rank three.

## References

* V. Guirardel, G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §5.1.2 (an
  essential two-sided simple closed curve on a surface defines a cyclic splitting of its
  fundamental group relative to the boundary subgroups).
* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Cambridge University Press, 2002, §1.B, Example 1B.13 (HNN extensions as fundamental groups of
  loops of groups).
* J.-P. Serre, *Trees*, Springer, 1980, Chapter I, §5.1 (HNN extensions as fundamental groups of
  loops of groups).
-/

public section

namespace TauCeti

namespace SurfaceGroup

namespace Orientable

open HNNExtension (t)

variable (g m : ℕ)

/-- The boundary map `ℤ → S⁺(g, m + 2)` onto the first side of the cut curve: `n ↦ x ^ n` for the
penultimate peripheral element `x = p_{m+1}`. -/
def curveFst : Multiplicative ℤ →* Orientable g (m + 2) :=
  zpowersHom _ (peripheral g (m + 2) (Fin.last m).castSucc)

/-- The boundary map `ℤ → S⁺(g, m + 2)` onto the second side of the cut curve, with the opposite
orientation: `n ↦ y ^ (-n)` for the last peripheral element `y = p_{m+2}`. -/
def curveSnd : Multiplicative ℤ →* Orientable g (m + 2) :=
  zpowersHom _ (peripheral g (m + 2) (Fin.last (m + 1)))⁻¹

variable {g m}

@[simp]
theorem curveFst_apply (n : Multiplicative ℤ) :
    curveFst g m n = peripheral g (m + 2) (Fin.last m).castSucc ^ n.toAdd := (rfl)

@[simp]
theorem curveSnd_apply (n : Multiplicative ℤ) :
    curveSnd g m n = peripheral g (m + 2) (Fin.last (m + 1)) ^ (-n.toAdd) := by
  simp [curveSnd]

/-- The image of `curveFst` is the boundary subgroup generated by `p_{m+1}`. -/
theorem range_curveFst :
    (curveFst g m).range = Subgroup.zpowers (peripheral g (m + 2) (Fin.last m).castSucc) :=
  Subgroup.range_zpowersHom _

/-- The image of `curveSnd` is the boundary subgroup generated by `p_{m+2}`. -/
theorem range_curveSnd :
    (curveSnd g m).range = Subgroup.zpowers (peripheral g (m + 2) (Fin.last (m + 1))) := by
  rw [curveSnd, Subgroup.range_zpowersHom, Subgroup.zpowers_inv]

variable (g m)

/-- The boundary map onto the first side of the cut curve is injective: `p_{m+1}` has infinite
order, since a surface with `m + 2` boundary components is not a disc. -/
theorem curveFst_injective : Function.Injective (curveFst g m) :=
  zpowersHom_peripheral_injective (Or.inr (by omega)) _

/-- The boundary map onto the second side of the cut curve is injective: `p_{m+2}` has infinite
order, since a surface with `m + 2` boundary components is not a disc. -/
theorem curveSnd_injective : Function.Injective (curveSnd g m) := fun x y hxy ↦
  Multiplicative.toAdd.injective <| injective_zpow_iff_not_isOfFinOrder.2
    (isOfFinOrder_inv_iff.not.2 (not_isOfFinOrder_peripheral (Or.inr (by omega)) _)) hxy

variable {g m}

/-- **The two sides of the cut curve.** In the HNN extension of `S⁺(g, m + 2)` along `curveFst`
and `curveSnd`, the stable letter conjugates the penultimate peripheral element `p_{m+1}` to the
inverse of the last one, `p_{m+2}⁻¹`. -/
theorem t_mul_of_peripheral_mul_inv_t :
    (t : HNNExtension (Orientable g (m + 2)) (curveFst g m).range (curveSnd g m).range
        (GraphOfGroups.loopEquiv _ _ (curveFst_injective g m) (curveSnd_injective g m))) *
      HNNExtension.of (peripheral g (m + 2) (Fin.last m).castSucc) * t⁻¹ =
      (HNNExtension.of (peripheral g (m + 2) (Fin.last (m + 1))))⁻¹ := by
  have h := HNNExtension.equiv_eq_conj
    (φ := GraphOfGroups.loopEquiv _ _ (curveFst_injective g m) (curveSnd_injective g m))
    (MonoidHom.ofInjective (curveFst_injective g m) (.ofAdd 1))
  rw [GraphOfGroups.loopEquiv_ofInjective] at h
  simpa [MonoidHom.ofInjective_apply] using h.symm

/-! ### The two homomorphisms -/

/-- The HNN extension of `S⁺(g, m + 2)` along `curveFst` and `curveSnd`. -/
private abbrev HNN (g m : ℕ) : Type :=
  HNNExtension (Orientable g (m + 2)) (curveFst g m).range (curveSnd g m).range
    (GraphOfGroups.loopEquiv _ _ (curveFst_injective g m) (curveSnd_injective g m))

/-- The cyclic permutation `x y W P = 1` of the relation `W P x y = 1` of `S⁺(g, m + 2)`, where
`x = p_{m+1}`, `y = p_{m+2}`, `W` is the product of the commutators and `P = p₁ ⋯ p_m`. -/
private theorem relation_rotate :
    peripheral g (m + 2) (Fin.last m).castSucc * peripheral g (m + 2) (Fin.last (m + 1)) *
      ((List.ofFn fun i ↦
          (a g (m + 2) i)⁻¹ * (b g (m + 2) i)⁻¹ * a g (m + 2) i * b g (m + 2) i).prod *
        (List.ofFn fun j : Fin m ↦ peripheral g (m + 2) j.castSucc.castSucc).prod) = 1 := by
  have h := orientableWord_a_b_peripheral g (m + 2)
  rw [orientableWord_def, List.ofFn_succ', List.prod_concat, List.ofFn_succ', List.prod_concat]
    at h
  exact mul_eq_one_comm.1 (by simpa only [mul_assoc] using h)

/-- The map `S⁺(g + 1, m) → S⁺(g, m + 2) ∗_ℤ`: `a₁ ↦ t`, `b₁ ↦ p'_{m+2}`, and the other
generators to the corresponding generators of `S⁺(g, m + 2)`. -/
private noncomputable def toHNN : Orientable (g + 1) m →* HNN g m :=
  lift (Fin.cons t fun i ↦ HNNExtension.of (a g (m + 2) i))
    (Fin.cons (HNNExtension.of (peripheral g (m + 2) (Fin.last (m + 1))))
      fun i ↦ HNNExtension.of (b g (m + 2) i))
    (fun j ↦ HNNExtension.of (peripheral g (m + 2) j.castSucc.castSucc)) <| by
    have hx : (t : HNN g m)⁻¹ * (HNNExtension.of (peripheral g (m + 2) (Fin.last (m + 1))))⁻¹ * t =
        HNNExtension.of (peripheral g (m + 2) (Fin.last m).castSucc) := by
      rw [← t_mul_of_peripheral_mul_inv_t]
      group
    rw [orientableWord_def, List.ofFn_succ, List.prod_cons]
    simp only [Fin.cons_zero, Fin.cons_succ, hx]
    simpa [map_list_prod, List.map_ofFn, Function.comp_def, mul_assoc] using
      congrArg (HNNExtension.of : Orientable g (m + 2) →* HNN g m) relation_rotate

/-- The relation of `S⁺(g, m + 2)` holds for `a_{i+1}, b_{i+1}, p₁, …, p_m, a₁⁻¹ b₁⁻¹ a₁, b₁` in
`S⁺(g + 1, m)`: it is a cyclic permutation of the relation of `S⁺(g + 1, m)`. -/
private theorem orientableWord_succ_snoc_snoc :
    orientableWord (fun i ↦ a (g + 1) m i.succ) (fun i ↦ b (g + 1) m i.succ)
      (Fin.snoc (α := fun _ ↦ Orientable (g + 1) m)
        (Fin.snoc (α := fun _ ↦ Orientable (g + 1) m) (peripheral (g + 1) m)
          ((a (g + 1) m 0)⁻¹ * (b (g + 1) m 0)⁻¹ * a (g + 1) m 0))
        (b (g + 1) m 0)) = 1 := by
  have h := orientableWord_a_b_peripheral (g + 1) m
  rw [orientableWord_def, List.ofFn_succ, List.prod_cons] at h
  rw [orientableWord_snoc, orientableWord_snoc, orientableWord_def]
  simpa only [mul_assoc] using mul_eq_one_comm.1 ((mul_assoc _ _ _).symm.trans h)

/-- The map `S⁺(g, m + 2) → S⁺(g + 1, m)` of the base group: `a'ᵢ ↦ a_{i+1}`, `b'ᵢ ↦ b_{i+1}`,
`p'ⱼ ↦ pⱼ` for `j ≤ m`, `p'_{m+1} ↦ a₁⁻¹ b₁⁻¹ a₁` and `p'_{m+2} ↦ b₁`. -/
private def ofBase : Orientable g (m + 2) →* Orientable (g + 1) m :=
  lift (fun i ↦ a (g + 1) m i.succ) (fun i ↦ b (g + 1) m i.succ)
    (Fin.snoc (α := fun _ ↦ Orientable (g + 1) m)
      (Fin.snoc (α := fun _ ↦ Orientable (g + 1) m) (peripheral (g + 1) m)
        ((a (g + 1) m 0)⁻¹ * (b (g + 1) m 0)⁻¹ * a (g + 1) m 0))
      (b (g + 1) m 0))
    orientableWord_succ_snoc_snoc

/-- The map `S⁺(g, m + 2) ∗_ℤ → S⁺(g + 1, m)`, sending the stable letter to `a₁`. -/
private noncomputable def ofHNN : HNN g m →* Orientable (g + 1) m :=
  HNNExtension.lift ofBase (a (g + 1) m 0) fun c ↦ by
    obtain ⟨n, rfl⟩ := (MonoidHom.ofInjective (curveFst_injective g m)).surjective c
    rw [GraphOfGroups.loopEquiv_ofInjective]
    have h : SemiconjBy (a (g + 1) m 0) ((a (g + 1) m 0)⁻¹ * (b (g + 1) m 0)⁻¹ * a (g + 1) m 0)
        (b (g + 1) m 0)⁻¹ := by
      simp [SemiconjBy, mul_assoc]
    simp only [MonoidHom.ofInjective_apply, curveFst_apply, curveSnd_apply, ← inv_zpow', map_zpow,
      map_inv, ofBase, lift_peripheral, Fin.snoc_castSucc, Fin.snoc_last]
    exact h.zpow_right _

private theorem ofHNN_comp_toHNN : ofHNN.comp toHNN = MonoidHom.id (Orientable (g + 1) m) := by
  refine hom_ext (Fin.cases ?_ fun i ↦ ?_) (Fin.cases ?_ fun i ↦ ?_) fun j ↦ ?_ <;>
    simp [toHNN, ofHNN, ofBase]

private theorem toHNN_comp_ofHNN : toHNN.comp ofHNN = MonoidHom.id (HNN g m) := by
  -- On the peripheral elements of `S⁺(g, m + 2)` the cases are `p'_{m+2}`, `p'_{m+1}` (where
  -- `a₁⁻¹ b₁⁻¹ a₁` returns as `t⁻¹ (p'_{m+2})⁻¹ t = p'_{m+1}`) and the remaining `p'ⱼ`.
  refine HNNExtension.hom_ext (hom_ext (fun i ↦ ?_) (fun i ↦ ?_)
    (Fin.lastCases ?_ (Fin.lastCases ?_ fun j ↦ ?_))) ?_ <;>
    simp [toHNN, ofHNN, ofBase, ← t_mul_of_peripheral_mul_inv_t, mul_assoc]

variable (g m)

/-- **Cutting an orientable surface group along a non-separating curve.** The orientable surface
group `S⁺(g + 1, m)` is the HNN extension of `S⁺(g, m + 2)` identifying its last two boundary
curves with opposite orientations: the edge group `ℤ` goes to `p_{m+1}` and to `p_{m+2}⁻¹`
(`curveFst`, `curveSnd`), and the stable letter conjugates the first image to the second.

Write `a, b, p` for the generators of `S⁺(g + 1, m)` and `a', b', p'` for those of `S⁺(g, m + 2)`.
The isomorphism sends the first handle `a₁, b₁` to the stable letter `t` and to `p'_{m+2}`, the
other handles `a_{i+1}, b_{i+1}` to `a'ᵢ, b'ᵢ`, and the peripheral elements `pⱼ` to `p'ⱼ`; the
element `p'_{m+1}` corresponds to `a₁⁻¹ b₁⁻¹ a₁`. -/
noncomputable def equivHNNExtension :
    Orientable (g + 1) m ≃* HNNExtension (Orientable g (m + 2)) (curveFst g m).range
      (curveSnd g m).range
      (GraphOfGroups.loopEquiv _ _ (curveFst_injective g m) (curveSnd_injective g m)) :=
  MonoidHom.toMulEquiv toHNN ofHNN ofHNN_comp_toHNN toHNN_comp_ofHNN

variable {g m}

/-! ### The isomorphism on generators -/

/-- The first generator `a₁` of the cut handle goes to the stable letter. -/
@[simp]
theorem equivHNNExtension_a_zero : equivHNNExtension g m (a (g + 1) m 0) = t := by
  simp [equivHNNExtension, toHNN]

/-- The second generator `b₁` of the cut handle, the non-separating curve, goes to the last
peripheral element of `S⁺(g, m + 2)`. -/
@[simp]
theorem equivHNNExtension_b_zero :
    equivHNNExtension g m (b (g + 1) m 0) =
      HNNExtension.of (peripheral g (m + 2) (Fin.last (m + 1))) := by
  simp [equivHNNExtension, toHNN]

@[simp]
theorem equivHNNExtension_a_succ (i : Fin g) :
    equivHNNExtension g m (a (g + 1) m i.succ) = HNNExtension.of (a g (m + 2) i) := by
  simp [equivHNNExtension, toHNN]

@[simp]
theorem equivHNNExtension_b_succ (i : Fin g) :
    equivHNNExtension g m (b (g + 1) m i.succ) = HNNExtension.of (b g (m + 2) i) := by
  simp [equivHNNExtension, toHNN]

/-- The peripheral elements of `S⁺(g + 1, m)` are the remaining peripheral elements of
`S⁺(g, m + 2)`. -/
@[simp]
theorem equivHNNExtension_peripheral (j : Fin m) :
    equivHNNExtension g m (peripheral (g + 1) m j) =
      HNNExtension.of (peripheral g (m + 2) j.castSucc.castSucc) := by
  simp [equivHNNExtension, toHNN]

@[simp]
theorem equivHNNExtension_symm_t : (equivHNNExtension g m).symm t = a (g + 1) m 0 := by
  simp [equivHNNExtension, ofHNN]

@[simp]
theorem equivHNNExtension_symm_of_a (i : Fin g) :
    (equivHNNExtension g m).symm (HNNExtension.of (a g (m + 2) i)) = a (g + 1) m i.succ := by
  simp [equivHNNExtension, ofHNN, ofBase]

@[simp]
theorem equivHNNExtension_symm_of_b (i : Fin g) :
    (equivHNNExtension g m).symm (HNNExtension.of (b g (m + 2) i)) = b (g + 1) m i.succ := by
  simp [equivHNNExtension, ofHNN, ofBase]

@[simp]
theorem equivHNNExtension_symm_of_peripheral_castSucc_castSucc (j : Fin m) :
    (equivHNNExtension g m).symm (HNNExtension.of (peripheral g (m + 2) j.castSucc.castSucc)) =
      peripheral (g + 1) m j := by
  simp [equivHNNExtension, ofHNN, ofBase]

/-- The first side `p_{m+1}` of the cut curve is `a₁⁻¹ b₁⁻¹ a₁` in `S⁺(g + 1, m)`. -/
@[simp]
theorem equivHNNExtension_symm_of_peripheral_castSucc_last :
    (equivHNNExtension g m).symm
        (HNNExtension.of (peripheral g (m + 2) (Fin.last m).castSucc)) =
      (a (g + 1) m 0)⁻¹ * (b (g + 1) m 0)⁻¹ * a (g + 1) m 0 := by
  simp [equivHNNExtension, ofHNN, ofBase]

/-- The second side `p_{m+2}` of the cut curve is the curve `b₁` of `S⁺(g + 1, m)`. -/
@[simp]
theorem equivHNNExtension_symm_of_peripheral_last :
    (equivHNNExtension g m).symm (HNNExtension.of (peripheral g (m + 2) (Fin.last (m + 1)))) =
      b (g + 1) m 0 := by
  simp [equivHNNExtension, ofHNN, ofBase]

/-! ### The genus-two surface group -/

/-- **The HNN relation for the genus-two surface group.** In the HNN extension of `S⁺(1, 2)` onto
which `equivHNNExtension 1 0` maps `S⁺(2, 0)`, the stable letter conjugates `p₁` to `[a, b] p₁`,
where `a = a₁` and `b = b₁` are the handle generators of `S⁺(1, 2)`. Since `S⁺(1, 2)` is free on
`a, b, p₁` (`TauCeti.SurfaceGroup.Orientable.freeBasis`), this is the presentation
`⟨a, b, p, t | t p t⁻¹ = [a, b] p⟩` of `S⁺(2, 0)` as an HNN extension of a free group of rank
three, along the non-separating curve `b₁` of `S⁺(2, 0)`. -/
theorem t_mul_of_peripheral_mul_inv_t_genusTwo :
    (t : HNNExtension (Orientable 1 2) (curveFst 1 0).range (curveSnd 1 0).range
        (GraphOfGroups.loopEquiv _ _ (curveFst_injective 1 0) (curveSnd_injective 1 0))) *
      HNNExtension.of (peripheral 1 2 0) * t⁻¹ =
      HNNExtension.of ((a 1 2 0)⁻¹ * (b 1 2 0)⁻¹ * a 1 2 0 * b 1 2 0 * peripheral 1 2 0) := by
  have h := t_mul_of_peripheral_mul_inv_t (g := 1) (m := 0)
  rw [← map_inv, peripheral_last, inv_inv] at h
  simpa [mul_assoc] using h

end Orientable

end SurfaceGroup

end TauCeti
