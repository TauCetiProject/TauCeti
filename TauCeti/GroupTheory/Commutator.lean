/-!
# Normalizers and commutators tested on generating sets

Subgroups presented by generators are controlled by inspecting generators only. Conjugation and
commutation are not preserved by products, so the first two results below carry an auxiliary
normalizing hypothesis. The last result uses a commutator relation to propagate membership along
an ordered finite index set.

Mathlib has `Subgroup.le_normalizer_closure_iff`, which tests the *conjugated* subgroup on
generators but still quantifies over the whole conjugating subgroup, and `Subgroup.commutator_le`,
which quantifies over both subgroups. Neither reduces a comparison to generators on both sides.

## Main results

* `TauCeti.closure_le_normalizer_closure`: a subgroup generated by `X` normalizes a subgroup
  generated by `Y` as soon as the generators of `X` conjugate those of `Y` into it, in both
  directions.
* `TauCeti.commutator_closure_closure_le`: the commutator of two subgroups presented by generators
  lies in a subgroup normalized by both, as soon as the commutators of the generators do.
* `TauCeti.commutator_closure_le_iff`: for a normal target, the commutator of a subgroup with a
  subgroup presented by generators is tested on those generators.
* `TauCeti.commutator_le_iff_map_mk'_eq_bot`: `⁅A, B⁆ ≤ N` for a normal `N` says that the images
  of `A` and `B` in `G ⧸ N` commute.
* `QuotientGroup.commute_mk_iff`: two classes in `G ⧸ N` commute exactly when the commutator of
  representatives lies in `N`.
* `TauCeti.commutatorElement_pow_right_mem_iff`: when `⁅a, y⁆` commutes with `y` modulo a normal
  `N`, the commutator `⁅a, y ^ n⁆` lies in `N` exactly when `⁅a, y⁆ ^ n` does.
* `TauCeti.commutatorElement_mul_mul_eq_mul_of_commute`: the commutator of two paired products
  splits into the product of their same-position commutators when the required cross terms commute.
* `Commute.mul_pow_eq_pow_mul_pow_mul_commutatorElement_pow_choose_two`: the binomial formula
  `(a * b) ^ n = a ^ n * b ^ n * ⁅b, a⁆ ^ (n choose 2)` when `⁅b, a⁆` commutes with `a` and `b`.
* `TauCeti.commutatorElement_pow_left_of_commute`, `TauCeti.commutatorElement_pow_right_of_commute`:
  the collection formulas `⁅a ^ n, b⁆ = ⁅a, b⁆ ^ n * ⁅a, ⁅a, b⁆⁆ ^ (n choose 2)` and
  `⁅a, b ^ n⁆ = ⁅a, b⁆ ^ n * ⁅b, ⁅a, b⁆⁆ ^ (n choose 2)` when the iterated commutator commutes
  with `⁅a, b⁆` and with the powered input, for instance when it is central.
* `TauCeti.commute_commutatorElement_of_inv_mul_mul_mem_zpowers`: two elements conjugating `g`
  into `⟨g⟩` have a commutator that centralizes `g`.
* `Subgroup.mem_of_adjacent_of_commutator`: a structure-constant-one family indexed by ordered
  pairs of `Fin m` is generated by its adjacent members.

## References

* R. W. Carter, *Simple Groups of Lie Type*, §5.3.
-/

public section

namespace TauCeti

open Subgroup
open scoped commutatorElement

variable {G : Type*} [Group G] {X Y : Set G} {N : Subgroup G}

/-- The commutator of two paired products splits into the product of the same-position
commutators when the cross terms and the resulting commutators commute as required. -/
theorem commutatorElement_mul_mul_eq_mul_of_commute {a b c d : G}
    (hbc : Commute b c) (had : Commute a d)
    (hcbd : Commute c ⁅b, d⁆) (habd : Commute a ⁅b, d⁆)
    (hcomm : Commute ⁅a, c⁆ ⁅b, d⁆) :
    ⁅a * b, c * d⁆ = ⁅a, c⁆ * ⁅b, d⁆ := by
  have hcbd_conj : c * ⁅b, d⁆ * c⁻¹ = ⁅b, d⁆ := by
    rw [hcbd.eq]
    group
  have habd_conj : a * ⁅b, d⁆ * a⁻¹ = ⁅b, d⁆ := by
    rw [habd.eq]
    group
  rw [commutatorElement_mul_left_eq_conj_mul,
    commutatorElement_mul_right_eq_mul_conj, hbc.commutator_eq,
    commutatorElement_mul_right_eq_mul_conj, had.commutator_eq]
  simp only [one_mul, mul_one, hcbd_conj, habd_conj, mul_inv_cancel_right]
  exact hcomm.eq.symm

/-- **The binomial formula of nilpotency class two**: when the commutator `⁅b, a⁆` commutes with
`a` and with `b`, for instance when it is central,
`(a * b) ^ n = a ^ n * b ^ n * ⁅b, a⁆ ^ (n choose 2)`. -/
theorem _root_.Commute.mul_pow_eq_pow_mul_pow_mul_commutatorElement_pow_choose_two {a b : G}
    (ha : Commute a ⁅b, a⁆) (hb : Commute b ⁅b, a⁆) (n : ℕ) :
    (a * b) ^ n = a ^ n * b ^ n * ⁅b, a⁆ ^ n.choose 2 := by
  -- Powers of the commutator commute with every product of powers of `a` and `b`.
  have hc (i j k : ℕ) : Commute (a ^ i * b ^ j) (⁅b, a⁆ ^ k) :=
    (ha.pow_pow i k).mul_left (hb.pow_pow j k)
  induction n with
  | zero => simp
  | succ n ih =>
    -- Pulling `b` through `a ^ n` produces the commutator `⁅b, a ^ n⁆ = ⁅b, a⁆ ^ n`.
    have hA : b * a ^ n = ⁅b, a⁆ ^ n * a ^ n * b := by
      rw [ha.commutatorElement_pow_right, commutatorElement_def]; group
    have h2 : (n + 1).choose 2 = n + n.choose 2 := by
      simpa using Nat.choose_succ_succ' n 1
    calc (a * b) ^ (n + 1)
        = a * (b * a ^ n) * b ^ n * ⁅b, a⁆ ^ n.choose 2 := by
          rw [pow_succ', ih]; simp only [mul_assoc]
      _ = a * (⁅b, a⁆ ^ n * (a ^ n * b ^ (n + 1))) * ⁅b, a⁆ ^ n.choose 2 := by
          rw [hA, pow_succ' b]; simp only [mul_assoc]
      _ = a * (a ^ n * b ^ (n + 1) * ⁅b, a⁆ ^ n) * ⁅b, a⁆ ^ n.choose 2 := by
          rw [(hc n (n + 1) n).symm.eq]
      _ = a ^ (n + 1) * b ^ (n + 1) * ⁅b, a⁆ ^ (n + 1).choose 2 := by
          rw [h2, pow_succ' a, pow_add ⁅b, a⁆]; simp only [mul_assoc]

/-- **Collection of a power in the left input**: when the iterated commutator `⁅a, ⁅a, b⁆⁆`
commutes with `a` and with `⁅a, b⁆`, for instance when it is central,
`⁅a ^ n, b⁆ = ⁅a, b⁆ ^ n * ⁅a, ⁅a, b⁆⁆ ^ (n choose 2)`. -/
theorem commutatorElement_pow_left_of_commute {a b : G}
    (ha : Commute a ⁅a, ⁅a, b⁆⁆) (hc : Commute ⁅a, b⁆ ⁅a, ⁅a, b⁆⁆) (n : ℕ) :
    ⁅a ^ n, b⁆ = ⁅a, b⁆ ^ n * ⁅a, ⁅a, b⁆⁆ ^ n.choose 2 := by
  -- Write `a = c * t` with `c = ⁅a, b⁆` and `t = b * a * b⁻¹`, so that `⁅t, c⁆ = ⁅a, ⁅a, b⁆⁆`
  -- commutes with `c` and `t` and the binomial formula applies to `a ^ n = (c * t) ^ n`.
  let c := ⁅a, b⁆
  let t := b * a * b⁻¹
  let d := ⁅a, c⁆
  have hct : c * t = a := by
    dsimp [c, t]
    rw [commutatorElement_def]
    group
  have hcd : Commute c d := hc
  have ht : Commute t d := by
    have : t = c⁻¹ * a := by rw [← hct]; group
    rw [this]
    exact hcd.inv_left.mul_left ha
  have htc : ⁅t, c⁆ = d := by
    calc
      ⁅t, c⁆ = c⁻¹ * d * c := by
        dsimp [c, t, d]
        simp only [commutatorElement_def]
        group
      _ = d := by rw [hcd.inv_left.eq]; group
  have hpow := Commute.mul_pow_eq_pow_mul_pow_mul_commutatorElement_pow_choose_two
    (a := c) (b := t) (by rwa [htc]) (by rwa [htc]) n
  rw [hct, htc] at hpow
  have ht_pow : t ^ n = b * a ^ n * b⁻¹ :=
    (map_pow (MulAut.conj b) a n).symm
  calc
    ⁅a ^ n, b⁆ = a ^ n * (t ^ n)⁻¹ := by rw [ht_pow, commutatorElement_def]; group
    _ = c ^ n * t ^ n * d ^ n.choose 2 * (t ^ n)⁻¹ := by rw [hpow]
    _ = c ^ n * d ^ n.choose 2 := by
      rw [mul_assoc (c ^ n) (t ^ n), ((ht.pow_left n).pow_right (n.choose 2)).eq]
      group

/-- **Collection of a power in the right input**: when the iterated commutator `⁅b, ⁅a, b⁆⁆`
commutes with `b` and with `⁅a, b⁆`, for instance when it is central,
`⁅a, b ^ n⁆ = ⁅a, b⁆ ^ n * ⁅b, ⁅a, b⁆⁆ ^ (n choose 2)`. -/
theorem commutatorElement_pow_right_of_commute {a b : G}
    (hb : Commute b ⁅b, ⁅a, b⁆⁆) (hc : Commute ⁅a, b⁆ ⁅b, ⁅a, b⁆⁆) (n : ℕ) :
    ⁅a, b ^ n⁆ = ⁅a, b⁆ ^ n * ⁅b, ⁅a, b⁆⁆ ^ n.choose 2 := by
  -- Invert the left-input formula for `⁅b ^ n, a⁆`; the iterated commutator changes sign.
  have hswap : ⁅b, ⁅b, a⁆⁆ = ⁅b, ⁅a, b⁆⁆⁻¹ := by
    rw [← commutatorElement_inv a b]
    calc
      ⁅b, ⁅a, b⁆⁻¹⁆ = ⁅a, b⁆⁻¹ * ⁅b, ⁅a, b⁆⁆⁻¹ * ⁅a, b⁆ := by
        generalize ⁅a, b⁆ = c
        simp only [commutatorElement_def]
        group
      _ = ⁅b, ⁅a, b⁆⁆⁻¹ := by
        rw [hc.inv_left.inv_right.eq, mul_assoc, inv_mul_cancel, mul_one]
  have hleft := commutatorElement_pow_left_of_commute (a := b) (b := a)
    (by rw [hswap]; exact hb.inv_right)
    (by rw [hswap, ← commutatorElement_inv a b]; exact hc.inv_left.inv_right) n
  calc
    ⁅a, b ^ n⁆ = (⁅b, ⁅b, a⁆⁆ ^ n.choose 2)⁻¹ * (⁅b, a⁆ ^ n)⁻¹ := by
      simpa only [commutatorElement_inv, mul_inv_rev] using congrArg Inv.inv hleft
    _ = ⁅b, ⁅a, b⁆⁆ ^ n.choose 2 * ⁅a, b⁆ ^ n := by
      rw [hswap, ← inv_pow, inv_inv, ← inv_pow, commutatorElement_inv]
    _ = ⁅a, b⁆ ^ n * ⁅b, ⁅a, b⁆⁆ ^ n.choose 2 :=
      ((hc.pow_left n).pow_right (n.choose 2)).eq.symm

/-- If `x` and `y` both conjugate `g` into the cyclic subgroup it generates, then their
commutator `⁅x, y⁆` centralizes `g`. Such elements act on `⟨g⟩` through power maps, and power maps
commute with each other. -/
theorem commute_commutatorElement_of_inv_mul_mul_mem_zpowers {g x y : G}
    (hx : x⁻¹ * g * x ∈ zpowers g) (hy : y⁻¹ * g * y ∈ zpowers g) : Commute ⁅x, y⁆ g := by
  obtain ⟨i, hi⟩ := mem_zpowers_iff.1 hx
  obtain ⟨k, hk⟩ := mem_zpowers_iff.1 hy
  have hpow : ∀ (z : G) (m : ℤ), z⁻¹ * g ^ m * z = (z⁻¹ * g * z) ^ m := fun z m ↦ by
    simpa using (conj_zpow (a := z⁻¹) (b := g) (i := m)).symm
  -- Conjugating `g` by `y * x` and by `x * y` both give `g ^ (i * k)`.
  have hxk : x⁻¹ * g ^ k * x = g ^ (i * k) := by
    rw [hpow, ← hi, ← zpow_mul]
  have hyi : y⁻¹ * g ^ i * y = g ^ (i * k) := by
    rw [hpow, ← hk, ← zpow_mul, mul_comm i k]
  have key : (y * x)⁻¹ * g * (y * x) = (x * y)⁻¹ * g * (x * y) := by
    calc (y * x)⁻¹ * g * (y * x) = x⁻¹ * (y⁻¹ * g * y) * x := by group
      _ = g ^ (i * k) := by rw [← hk, hxk]
      _ = y⁻¹ * (x⁻¹ * g * x) * y := by rw [← hi, hyi]
      _ = (x * y)⁻¹ * g * (x * y) := by group
  rw [commute_iff_eq, commutatorElement_def]
  calc x * y * x⁻¹ * y⁻¹ * g = x * y * ((y * x)⁻¹ * g * (y * x)) * (y * x)⁻¹ := by group
    _ = x * y * ((x * y)⁻¹ * g * (x * y)) * (y * x)⁻¹ := by rw [key]
    _ = g * (x * y * x⁻¹ * y⁻¹) := by group

/-- Conjugating the subgroup generated by `Y` by an element that conjugates the generators of `Y`
into that subgroup lands back inside it. -/
private theorem map_conj_closure_le {g : G} (h : ∀ y ∈ Y, g * y * g⁻¹ ∈ closure Y) :
    (closure Y).map (MulAut.conj g) ≤ closure Y := by
  rw [MonoidHom.map_closure, MonoidHom.coe_coe, closure_le]
  rintro - ⟨y, hy, rfl⟩
  exact h y hy

/-- A subgroup generated by `X` normalizes a subgroup generated by `Y` as soon as every generator
of `X` conjugates every generator of `Y` into the latter, in both directions.

Both directions are genuinely needed: for an infinitely generated subgroup, a single inclusion
`g (closure Y) g⁻¹ ≤ closure Y` does not place `g` in the normalizer. When `X` is closed under
inverses the second hypothesis is the first one read at `x⁻¹`. -/
theorem closure_le_normalizer_closure
    (h : ∀ x ∈ X, ∀ y ∈ Y, x * y * x⁻¹ ∈ closure Y)
    (hinv : ∀ x ∈ X, ∀ y ∈ Y, x⁻¹ * y * x ∈ closure Y) :
    closure X ≤ normalizer (closure Y : Set G) := by
  rw [closure_le]
  intro x hx
  have hle := map_conj_closure_le (h x hx)
  have hle' : (closure Y).map (MulAut.conj x⁻¹) ≤ closure Y :=
    map_conj_closure_le fun y hy => by simpa using hinv x hx y hy
  rw [SetLike.mem_coe, mem_normalizer_iff_map_conj_eq]
  refine le_antisymm hle fun y hy => ⟨x⁻¹ * y * x, ?_, ?_⟩
  · simpa using hle' ⟨y, hy, rfl⟩
  · rw [MonoidHom.coe_coe, MulAut.conj_apply]
    group

/-- Commutators of generators control the commutator subgroup, provided the target subgroup is
normalized by both factors.

The normalizing hypotheses are what makes the induction go through: expanding `⁅x, y₁ y₂⁆` and
`⁅x₁ x₂, y⁆` produces conjugates of commutators by elements of `closure Y` and of `closure X`
respectively. -/
theorem commutator_closure_closure_le
    (hX : closure X ≤ normalizer (N : Set G)) (hY : closure Y ≤ normalizer (N : Set G))
    (h : ∀ x ∈ X, ∀ y ∈ Y, ⁅x, y⁆ ∈ N) :
    ⁅closure X, closure Y⁆ ≤ N := by
  -- Conjugation by an element of either subgroup preserves `N`.
  have hconjX : ∀ x ∈ closure X, ∀ n ∈ N, x * n * x⁻¹ ∈ N :=
    fun x hx n hn => ((mem_normalizer_iff (H := N)).mp (hX hx) n).mp hn
  have hconjY : ∀ y ∈ closure Y, ∀ n ∈ N, y * n * y⁻¹ ∈ N :=
    fun y hy n hn => ((mem_normalizer_iff (H := N)).mp (hY hy) n).mp hn
  -- Fix a generator of `X` and induct over the second factor.
  have hgen : ∀ x ∈ X, ∀ y ∈ closure Y, ⁅x, y⁆ ∈ N := by
    intro x hx y hy
    induction hy using closure_induction with
    | mem y hy => exact h x hx y hy
    | one => simp
    | mul a b ha _ hxa hxb =>
      have hsplit : ⁅x, a⁆ * a * ⁅x, b⁆ * a⁻¹ = ⁅x, a⁆ * (a * ⁅x, b⁆ * a⁻¹) := by group
      rw [commutatorElement_mul_right_eq_mul_conj, hsplit]
      exact mul_mem hxa (hconjY a ha _ hxb)
    | inv a ha hxa =>
      rw [commutatorElement_inv_right]
      simpa using hconjY a⁻¹ (inv_mem ha) _ (commutatorElement_inv x a ▸ inv_mem hxa)
  -- Now induct over the first factor.
  rw [Subgroup.commutator_le]
  intro p hp q hq
  induction hp using closure_induction with
  | mem x hx => exact hgen x hx q hq
  | one => simp
  | mul a b ha _ hxa hxb =>
    rw [commutatorElement_mul_left_eq_conj_mul]
    exact mul_mem (hconjX a ha _ hxb) hxa
  | inv a ha hxa =>
    rw [commutatorElement_inv_left]
    simpa using hconjX a⁻¹ (inv_mem ha) _ (commutatorElement_inv a q ▸ inv_mem hxa)

/-- For a normal target, the commutator of a subgroup `A` with the subgroup generated by `Y` is
tested on the generators: `⁅A, closure Y⁆ ≤ N` exactly when `⁅a, y⁆ ∈ N` for all `a ∈ A` and
`y ∈ Y`. -/
theorem commutator_closure_le_iff [N.Normal] {A : Subgroup G} :
    ⁅A, closure Y⁆ ≤ N ↔ ∀ a ∈ A, ∀ y ∈ Y, ⁅a, y⁆ ∈ N := by
  refine ⟨fun h a ha y hy ↦ h (commutator_mem_commutator ha (subset_closure hy)), fun h ↦ ?_⟩
  have hle := commutator_closure_closure_le (X := (A : Set G)) (Y := Y) (N := N)
    (by rw [closure_eq, normalizer_eq_top]; exact le_top)
    (by rw [normalizer_eq_top]; exact le_top) fun a ha y hy ↦ h a ha y hy
  rwa [closure_eq] at hle

/-- For a normal subgroup `N`, the commutator `⁅A, B⁆` lies in `N` exactly when the images of `A`
and `B` in the quotient `G ⧸ N` commute. -/
theorem commutator_le_iff_map_mk'_eq_bot {A B : Subgroup G} [N.Normal] :
    ⁅A, B⁆ ≤ N ↔ ⁅A.map (QuotientGroup.mk' N), B.map (QuotientGroup.mk' N)⁆ = ⊥ := by
  rw [← map_commutator, map_eq_bot_iff, QuotientGroup.ker_mk']

/-- Two classes in `G ⧸ N` commute exactly when the commutator of representatives lies in `N`. -/
theorem _root_.QuotientGroup.commute_mk_iff [N.Normal] {a b : G} :
    Commute (a : G ⧸ N) (b : G ⧸ N) ↔ ⁅a, b⁆ ∈ N := by
  rw [← commutatorElement_eq_one_iff_commute, ← QuotientGroup.mk'_apply N a,
    ← QuotientGroup.mk'_apply N b, ← map_commutatorElement, QuotientGroup.mk'_apply,
    QuotientGroup.eq_one_iff]

/-- If the commutator `⁅a, y⁆` commutes with `y` modulo a normal subgroup `N`, then modulo `N` the
commutator `⁅a, y ^ n⁆` is the power `⁅a, y⁆ ^ n`: one lies in `N` exactly when the other does. -/
theorem commutatorElement_pow_right_mem_iff [N.Normal] {a y : G} (h : ⁅⁅a, y⁆, y⁆ ∈ N) (n : ℕ) :
    ⁅a, y ^ n⁆ ∈ N ↔ ⁅a, y⁆ ^ n ∈ N := by
  set π := QuotientGroup.mk' N
  -- Membership in `N` is vanishing under the quotient map.
  have hmem (x : G) : x ∈ N ↔ π x = 1 := (QuotientGroup.eq_one_iff x).symm
  -- The hypothesis says that `⁅π a, π y⁆` commutes with `π y` in the quotient.
  have hcomm : Commute ⁅π a, π y⁆ (π y) := by
    simpa only [map_commutatorElement, commutatorElement_eq_one_iff_commute] using (hmem _).mp h
  -- `Commute.commutatorElement_pow_right` in the quotient, pulled back along `π`.
  have key : π ⁅a, y ^ n⁆ = π (⁅a, y⁆ ^ n) := by
    simpa only [map_commutatorElement, map_pow] using
      (hcomm.symm.commutatorElement_pow_right n).symm
  rw [hmem, hmem, key]

end TauCeti

/-! ## Pair-indexed families generated by adjacent members -/

namespace Subgroup

open scoped commutatorElement

variable {G : Type*} [Group G] {P : Type*} [One P]

/-- Suppose elements `xᵢⱼ(a)` indexed by distinct pairs in `Fin m` satisfy the relation

```text
⁅xᵢⱼ(a), xⱼₖ(1)⁆ = xᵢₖ(a).
```

If a subgroup contains `xᵢⱼ(a)` whenever `i` and `j` are adjacent, in both orientations, then it
contains every `xᵢⱼ(a)`. -/
theorem mem_of_adjacent_of_commutator (H : Subgroup G)
    (x : ∀ {i j : Fin m}, i ≠ j → P → G)
    (hcomm : ∀ {i j k : Fin m} (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a : P),
      ⁅x hij a, x hjk 1⁆ = x hik a)
    (hadjacent : ∀ {i j : Fin m} (hij : i ≠ j) (a : P),
      i.val + 1 = j.val ∨ j.val + 1 = i.val → x hij a ∈ H)
    {i j : Fin m} (hij : i ≠ j) (a : P) : x hij a ∈ H := by
  let Q : ℕ → Prop := fun d =>
    ∀ (i j : Fin m) (hij : i ≠ j), Nat.dist i.val j.val = d → ∀ a : P, x hij a ∈ H
  suffices ∀ d, Q d by
    exact this (Nat.dist i.val j.val) i j hij rfl a
  intro d
  induction d using Nat.strong_induction_on with
  | h d ih =>
      intro i j hij hdist a
      by_cases hforward : i.val + 1 = j.val
      · exact hadjacent hij a (Or.inl hforward)
      by_cases hbackward : j.val + 1 = i.val
      · exact hadjacent hij a (Or.inr hbackward)
      have hval : i.val ≠ j.val := Fin.val_ne_of_ne hij
      let k : Fin m := if h : i.val < j.val then
        ⟨i.val + 1, by omega⟩ else ⟨i.val - 1, by omega⟩
      have hik : i ≠ k := by
        dsimp only [k]
        split_ifs with h <;> simp only [Fin.ext_iff, ne_eq] <;> omega
      have hkj : k ≠ j := by
        dsimp only [k]
        split_ifs with h <;> simp only [Fin.ext_iff, ne_eq] <;> omega
      have hdist_ik : Nat.dist i.val k.val < Nat.dist i.val j.val := by
        dsimp only [k]
        split_ifs with h <;> simp only [Nat.dist] <;> omega
      have hdist_kj : Nat.dist k.val j.val < Nat.dist i.val j.val := by
        dsimp only [k]
        split_ifs with h <;> simp only [Nat.dist] <;> omega
      rw [hdist] at hdist_ik hdist_kj
      have hik_mem := ih (Nat.dist i.val k.val) hdist_ik i k hik rfl a
      have hkj_mem := ih (Nat.dist k.val j.val) hdist_kj k j hkj rfl 1
      rw [← hcomm hik hkj hij a, commutatorElement_def]
      exact H.mul_mem (H.mul_mem (H.mul_mem hik_mem hkj_mem) (H.inv_mem hik_mem))
        (H.inv_mem hkj_mem)

end Subgroup
