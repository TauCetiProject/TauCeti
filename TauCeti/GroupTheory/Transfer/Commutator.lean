/-!
# The transfer into the commutator subgroup is trivial

Let `G` be a group whose commutator subgroup `G'` is finitely generated and of finite index, for
instance a finite group. **Furtwängler's theorem**, the group-theoretic form of the principal ideal
theorem of class field theory, says that the transfer `V : G → G' ⧸ G''` is trivial; equivalently,
the transfer into `G'` of every homomorphism from `G'` to a commutative group is trivial
(`MonoidHom.transfer_commutator_eq_one`).

Artin reduced the principal ideal theorem to this statement: if `H` is the Hilbert class field of
a number field `K` and `H'` that of `H`, then `G = Gal(H'/K)` has `G' = Gal(H'/H)`, and the
transfer `G^{ab} → G'` corresponds under the Artin map to the extension of ideals from `K` to `H`.

## Proof

The proof is the one of Artin and Tate, in the form given by Ferrand. Put `Q = G^{ab}` and
`A = G' ⧸ G''`, a `Q`-module by conjugation (`Abelianization.of_smul_of`). Quotient
representatives `out q ∈ G` give the factor set `f(σ, τ) = out σ · out τ · out (στ)⁻¹` of the
extension `G ⧸ G''` of `Q` by `A`, a `2`-cocycle, and the transfer of a representative is a
column sum of it (`MonoidHom.transfer_eq_prod_mul_out`):

`V(out p) = ∑_{q ∈ Q} f(q, p)`.

Let `B` be the splitting module of the class of `f` (`Rep.splittingModule`), an extension of the
augmentation ideal `I_Q` by `A` in which `f` is the coboundary of a cochain `ψ`. Then
`∑_q f(q, p)` is `∑_q (q ψ(p) - ψ(qp) + ψ(q)) = N ψ(p)` for the norm `N = ∑_q q`. Commutators in
`G` have classes in `I_Q B`, because `f(σ, τ) - f(τ, σ)` is the class of `⁅out σ, out τ⁆`; as
`A` is generated by commutators, `A ⊆ I_Q B`. Artin and Tate's lemma
(`Rep.norm_eq_zero_of_ker_le_coinvariantsKer`) then makes `N` vanish on `B`, so the transfer of
each representative is trivial. The transfer kills `G'`, which completes the proof.

## Main results

* `MonoidHom.transfer_commutator_eq_one`: the transfer of a homomorphism from `G'` to a
  commutative group is trivial.

## Implementation notes

The splitting module and the coefficient module `A` are representations over `ℤ`, so `G` lives
in `Type`, as for `TauCeti.FactorSet.cohomologyClass`.

## References

* Ph. Furtwängler, *Beweis des Hauptidealsatzes für die Klassenkörper algebraischer Zahlkörper*,
  Abh. Math. Sem. Hamburg 7 (1929).
* E. Artin and J. Tate, *Class Field Theory*, Chapter XIII.
* D. Ferrand, *La démonstration par Artin–Tate du théorème de l'idéal principal* (2011).
* J. Neukirch, *Algebraic Number Theory*, Chapter VI, Theorem 7.6.
-/

public section

namespace TauCeti.CommutatorTransfer

open Abelianization
open scoped commutatorElement

variable {G : Type} [Group G]

/-- The chosen representative in `G` of an element of `G^{ab}`. -/
private noncomputable abbrev out (q : Abelianization G) : G := (q : G ⧸ commutator G).out

private theorem of_out (q : Abelianization G) : of (out q) = q := QuotientGroup.out_eq' q

private theorem mem_commutator_of_of_eq_one {g : G} (h : of g = 1) : g ∈ commutator G :=
  ker_of (G := G) ▸ MonoidHom.mem_ker.2 h

private theorem out_mul_out_mul_inv_mem (σ τ : Abelianization G) :
    out σ * out τ * (out (σ * τ))⁻¹ ∈ commutator G :=
  mem_commutator_of_of_eq_one (by simp [of_out])

private theorem smul_of (q : Abelianization G) (n : commutator G) :
    q • of n = of (MulAut.conjNormal (out q) n) := by
  conv_lhs => rw [← of_out q]
  exact of_smul_of _ n

/-- The factor set of the extension `G ⧸ G''` of `G^{ab}` by `G' ⧸ G''`, read off the chosen
representatives. -/
private noncomputable def factorSet (p : Abelianization G × Abelianization G) :
    Abelianization (commutator G) :=
  of ⟨out p.1 * out p.2 * (out (p.1 * p.2))⁻¹, out_mul_out_mul_inv_mem p.1 p.2⟩

private theorem isMulCocycle₂_factorSet :
    groupCohomology.IsMulCocycle₂ (factorSet (G := G)) := by
  intro g h j
  simp only [factorSet, smul_of, ← map_mul, mul_assoc g h j]
  conv_lhs => rw [map_mul, mul_comm, ← map_mul]
  congr 1
  ext
  simp only [Subgroup.coe_mul, MulAut.conjNormal_apply, mul_assoc]
  group

/-- **`G' ⧸ G''` is generated, as a `G^{ab}`-module, by the commutators of representatives.**
A subgroup of `G' ⧸ G''` that is stable under `G^{ab}` and contains every `q • α / α` and every
`f(σ, τ) / f(τ, σ)` is everything. -/
private theorem eq_top_of_forall_mem (S : Subgroup (Abelianization (commutator G)))
    (hsmul : ∀ (q : Abelianization G) {α}, α ∈ S → q • α ∈ S)
    (hsub : ∀ (q : Abelianization G) (α), q • α / α ∈ S)
    (hf : ∀ σ τ : Abelianization G, factorSet (σ, τ) / factorSet (τ, σ) ∈ S) : S = ⊤ := by
  -- The class of `⁅x, y⁆` lies in `S`: with `x = s a` and `y = t b` for the representatives `s`,
  -- `t` of the classes of `x`, `y` and `a, b ∈ G'`, the commutator is
  -- `s ⁅a, y⁆ s⁻¹ · ⁅s, t⁆ · t ⁅s, b⁆ t⁻¹`, and `⁅s, t⁆` has class `f([x], [y]) / f([y], [x])`.
  have key (x y : G) : of (⟨⁅x, y⁆, Subgroup.commutator_mem_commutator (Subgroup.mem_top x)
      (Subgroup.mem_top y)⟩ : commutator G) ∈ S := by
    set s := out (of x)
    set t := out (of y)
    have ha : s⁻¹ * x ∈ commutator G := mem_commutator_of_of_eq_one (by simp [s, of_out])
    have hb : t⁻¹ * y ∈ commutator G := mem_commutator_of_of_eq_one (by simp [t, of_out])
    let a : commutator G := ⟨s⁻¹ * x, ha⟩
    let b : commutator G := ⟨t⁻¹ * y, hb⟩
    let F₁ : commutator G := ⟨_, out_mul_out_mul_inv_mem (of x) (of y)⟩
    let F₂ : commutator G := ⟨_, out_mul_out_mul_inv_mem (of y) (of x)⟩
    have hid : (⟨⁅x, y⁆, Subgroup.commutator_mem_commutator (Subgroup.mem_top x)
        (Subgroup.mem_top y)⟩ : commutator G) =
        MulAut.conjNormal s (a * MulAut.conjNormal y a⁻¹) * (F₁ * F₂⁻¹) *
          MulAut.conjNormal t (MulAut.conjNormal s b * b⁻¹) := by
      ext
      simp only [a, b, F₁, F₂, s, t, commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv,
        MulAut.conjNormal_apply, mul_comm (of y) (of x)]
      group
    have h₁ : of (MulAut.conjNormal s (a * MulAut.conjNormal y a⁻¹)) ∈ S := by
      rw [← of_smul_of, map_mul, map_inv (MulAut.conjNormal y), map_inv (of : commutator G →* _),
        ← of_smul_of, ← div_eq_mul_inv, ← inv_div]
      exact hsmul _ (S.inv_mem (hsub _ _))
    have h₂ : of (F₁ * F₂⁻¹) ∈ S := by
      rw [map_mul, map_inv, ← div_eq_mul_inv]
      exact hf (of x) (of y)
    have h₃ : of (MulAut.conjNormal t (MulAut.conjNormal s b * b⁻¹)) ∈ S := by
      rw [← of_smul_of, map_mul, ← of_smul_of, map_inv (of : commutator G →* _),
        ← div_eq_mul_inv]
      exact hsmul _ (hsub _ _)
    rw [hid, map_mul, map_mul]
    exact S.mul_mem (S.mul_mem h₁ h₂) h₃
  -- Commutators generate `G'`, and their classes generate `G' ⧸ G''`.
  have hall (n : commutator G) : of n ∈ S := by
    have hT : commutator G ≤ (S.comap (of : commutator G →* _)).map (commutator G).subtype := by
      refine commutator_eq_closure (G := G) |>.le.trans <| (Subgroup.closure_le _).2 ?_
      rintro _ ⟨x, y, rfl⟩
      exact ⟨_, key x y, rfl⟩
    obtain ⟨n', hn', hn'eq⟩ := hT n.2
    rwa [show n' = n from Subtype.ext hn'eq] at hn'
  exact eq_top_iff.2 fun α _ ↦ QuotientGroup.induction_on α hall

variable (G) in
/-- The coefficient module `G' ⧸ G''` of `G^{ab}`, as an integral representation. -/
private noncomputable abbrev coefficients : Rep ℤ (Abelianization G) :=
  Rep.ofMulDistribMulAction (Abelianization G) (Abelianization (commutator G))

/-- An element of `G' ⧸ G''` as an element of the coefficient module. -/
private abbrev toCoeff (α : Abelianization (commutator G)) : coefficients G :=
  Additive.ofMul (α := Abelianization (commutator G)) α

private theorem toCoeff_mul (α β : Abelianization (commutator G)) :
    toCoeff (α * β) = toCoeff α + toCoeff β := (rfl)

private theorem toCoeff_one : toCoeff (1 : Abelianization (commutator G)) = 0 := (rfl)

private theorem toCoeff_inv (α : Abelianization (commutator G)) :
    toCoeff α⁻¹ = -toCoeff α := (rfl)

private theorem toCoeff_div (α β : Abelianization (commutator G)) :
    toCoeff (α / β) = toCoeff α - toCoeff β := (rfl)

private theorem ρ_toCoeff (q : Abelianization G) (α : Abelianization (commutator G)) :
    (coefficients G).ρ q (toCoeff α) = toCoeff (q • α) := (rfl)

/-- The factor set as a `2`-cocycle. -/
private noncomputable abbrev cocycle : groupCohomology.cocycles₂ (coefficients G) :=
  groupCohomology.cocyclesOfIsMulCocycle₂ isMulCocycle₂_factorSet

/-- The splitting module of the extension `G ⧸ G''` of `G^{ab}` by `G' ⧸ G''`. -/
private noncomputable abbrev splitting (G : Type) [Group G] : Rep ℤ (Abelianization G) :=
  Rep.splittingModule (coefficients G) (groupCohomology.H2π _ cocycle)

/-- In the splitting module the factor set is the coboundary of a cochain `ψ`. -/
private theorem exists_coboundary_eq_factorSet : ∃ ψ : Abelianization G → splitting G,
    ∀ σ τ, (splitting G).ρ σ (ψ τ) - ψ (σ * τ) + ψ σ =
      (Rep.splittingModuleIncl (coefficients G) (groupCohomology.H2π _ cocycle)).hom
        (toCoeff (factorSet (σ, τ))) := by
  have h := Rep.map_splittingModuleIncl_eq_zero (coefficients G) (groupCohomology.H2π _ cocycle)
  rw [groupCohomology.H2π_comp_map_apply, groupCohomology.H2π_eq_zero_iff] at h
  obtain ⟨ψ, hψ⟩ := h
  refine ⟨ψ, fun σ τ ↦ ?_⟩
  have h := congrFun hψ (σ, τ)
  -- `mapCocycles₂` applies the coefficient map to the values of the cocycle.
  have hmap : groupCohomology.mapCocycles₂ (MonoidHom.id _)
      (Rep.splittingModuleIncl (coefficients G) (groupCohomology.H2π _ cocycle)) cocycle (σ, τ) =
      (Rep.splittingModuleIncl (coefficients G) (groupCohomology.H2π _ cocycle)).hom
        (toCoeff (factorSet (σ, τ))) := rfl
  rwa [groupCohomology.d₁₂_hom_apply, hmap] at h

/-- `G' ⧸ G''` lies in `I_Q B` inside the splitting module `B`. -/
private theorem incl_mem_coinvariantsKer (a : coefficients G) :
    (Rep.splittingModuleIncl (coefficients G) (groupCohomology.H2π _ cocycle)).hom a ∈
      Representation.Coinvariants.ker (splitting G).ρ := by
  obtain ⟨ψ, hψ⟩ := exists_coboundary_eq_factorSet (G := G)
  set j := (Rep.splittingModuleIncl (coefficients G) (groupCohomology.H2π _ cocycle)).hom
  set K := Representation.Coinvariants.ker (splitting G).ρ
  let S : Subgroup (Abelianization (commutator G)) :=
    { carrier := {α | j (toCoeff α) ∈ K}
      mul_mem' {α β} hα hβ := by
        simpa only [Set.mem_ofPred_eq, toCoeff_mul, map_add] using K.add_mem hα hβ
      one_mem' := by simp only [Set.mem_ofPred_eq, toCoeff_one, map_zero, K.zero_mem]
      inv_mem' {α} hα := by
        simpa only [Set.mem_ofPred_eq, toCoeff_inv, map_neg] using K.neg_mem hα }
  have hmem (α) : α ∈ S ↔ j (toCoeff α) ∈ K := Iff.rfl
  have hj (q : Abelianization G) (α : Abelianization (commutator G)) :
      j (toCoeff (q • α)) = (splitting G).ρ q (j (toCoeff α)) := by
    rw [← ρ_toCoeff, Rep.hom_comm_apply]
  have hS : S = ⊤ := by
    refine eq_top_of_forall_mem S (fun q α hα ↦ ?_) (fun q α ↦ ?_) (fun σ τ ↦ ?_)
    · rw [hmem] at hα ⊢
      rw [hj, ← sub_add_cancel ((splitting G).ρ q _) (j (toCoeff α))]
      exact K.add_mem (Representation.Coinvariants.sub_mem_ker q _) hα
    · rw [hmem, toCoeff_div, map_sub, hj]
      exact Representation.Coinvariants.sub_mem_ker q _
    · -- `f(σ, τ) - f(τ, σ) = (σ ψ(τ) - ψ(τ)) - (τ ψ(σ) - ψ(σ))` because `στ = τσ`.
      rw [hmem, toCoeff_div, map_sub, ← hψ, ← hψ, mul_comm τ σ]
      have : (splitting G).ρ σ (ψ τ) - ψ (σ * τ) + ψ σ -
          ((splitting G).ρ τ (ψ σ) - ψ (σ * τ) + ψ τ) =
          ((splitting G).ρ σ (ψ τ) - ψ τ) - ((splitting G).ρ τ (ψ σ) - ψ σ) := by abel
      rw [this]
      exact K.sub_mem (Representation.Coinvariants.sub_mem_ker _ _)
        (Representation.Coinvariants.sub_mem_ker _ _)
  -- The underlying group of the coefficient module is `G' ⧸ G''`.
  change j (toCoeff (show Abelianization (commutator G) from a)) ∈ K
  exact (hmem _).1 (hS ▸ Subgroup.mem_top _)

variable [Group.FG (commutator G)] [(commutator G).FiniteIndex]

attribute [local instance] Subgroup.fintypeQuotientOfFiniteIndex

private theorem transfer_of_eq_one (g : G) :
    (Abelianization.of : commutator G →* Abelianization (commutator G)).transfer g = 1 := by
  classical
  let _ : Fintype (Abelianization G) := (commutator G).fintypeQuotientOfFiniteIndex
  set u := groupCohomology.H2π (coefficients G) cocycle
  obtain ⟨ψ, hψ⟩ := exists_coboundary_eq_factorSet (G := G)
  set j := (Rep.splittingModuleIncl (coefficients G) u).hom
  have hj : Function.Injective j := fun a a' h ↦ by
    simpa [j] using congrArg (fun y ↦ (Rep.splittingModuleEquiv _ u y).2) h
  -- The norm of the splitting module vanishes.
  have hker_eq : LinearMap.ker (Rep.splittingModuleProj (coefficients G) u).hom.toLinearMap =
      LinearMap.range j.toLinearMap := by
    ext y
    simp only [LinearMap.mem_ker, LinearMap.mem_range,
      Representation.IntertwiningMap.toLinearMap_apply, Rep.splittingModuleProj_apply]
    refine ⟨fun hy ↦ ⟨(Rep.splittingModuleEquiv _ u y).2,
      (Rep.splittingModuleEquiv _ u).injective ?_⟩, ?_⟩
    · ext <;> simp [j, hy]
    · rintro ⟨a, rfl⟩
      simp [j]
  have : Group.FG (Abelianization (commutator G)) :=
    Group.fg_of_surjective (f := Abelianization.of) QuotientGroup.mk_surjective
  have : Module.Finite ℤ (Additive (Abelianization (commutator G))) :=
    Module.Finite.iff_addGroup_fg.2 (GroupFG.iff_add_fg.1 this)
  have hnorm : (splitting G).ρ.norm = 0 := by
    refine Rep.norm_eq_zero_of_ker_le_coinvariantsKer (splitting G)
      (Rep.splittingModuleProj (coefficients G) u)
      (fun y ↦ ⟨Rep.splittingModuleMk _ u y 0, by simp⟩) ?_ ?_
    · rw [hker_eq, LinearMap.range_eq_map]
      exact (Module.Finite.fg_top (R := ℤ) (M := Additive (Abelianization (commutator G)))).map _
    · rw [hker_eq]
      rintro _ ⟨a, rfl⟩
      exact incl_mem_coinvariantsKer a
  -- The transfer of a representative `out p` is the column sum `∑_q f(q, p) = N ψ(p) = 0`.
  have hrep (p : Abelianization G) :
      (Abelianization.of : commutator G →* Abelianization (commutator G)).transfer (out p) = 1 := by
    rw [MonoidHom.transfer_eq_prod_mul_out]
    trans ∏ q : Abelianization G, factorSet (q, p)
    · refine Fintype.prod_congr _ _ fun q ↦ ?_
      simp only [factorSet, out]
      congr 1
      ext
      exact congrArg (fun x : G ⧸ commutator G ↦ q.out * out p * (q * x).out⁻¹)
        (QuotientGroup.out_eq' p)
    have hsum (s : Finset (Abelianization G)) :
        toCoeff (∏ q ∈ s, factorSet (q, p)) = ∑ q ∈ s, toCoeff (factorSet (q, p)) := by
      induction s using Finset.induction_on with
      | empty => exact toCoeff_one
      | insert a s ha ih => rw [Finset.prod_insert ha, Finset.sum_insert ha, toCoeff_mul, ih]
    apply Additive.ofMul.injective
    apply hj
    -- Read the product in the coefficient module, whose underlying group is `Additive A`.
    change j (toCoeff (∏ q : Abelianization G, factorSet (q, p))) = j (toCoeff 1)
    rw [hsum, map_sum, toCoeff_one, map_zero]
    simp only [← hψ, Finset.sum_add_distrib, Finset.sum_sub_distrib]
    rw [Fintype.sum_equiv (Equiv.mulRight p) (fun q ↦ ψ (q * p)) ψ fun _ ↦ rfl, sub_add_cancel]
    have h := congrArg (fun f : Module.End ℤ (splitting G) ↦ f (ψ p)) hnorm
    simpa [Representation.norm, LinearMap.sum_apply] using h
  -- Every element is a representative times an element of `G'`, which the transfer kills.
  have hmem : (out (of g))⁻¹ * g ∈ commutator G := mem_commutator_of_of_eq_one (by simp [of_out])
  rw [← mul_inv_cancel_left (out (of g)) g, map_mul, hrep, one_mul]
  exact Abelianization.commutator_subset_ker _ hmem

end TauCeti.CommutatorTransfer

/-- **Furtwängler's theorem**, the group-theoretic principal ideal theorem: if the commutator
subgroup `G'` of `G` is finitely generated and of finite index (for instance if `G` is finite),
the transfer `G → A` of every homomorphism `ϕ : G' →* A` to a commutative group is trivial. For
`ϕ` the abelianization map, this says that the transfer `G → G' ⧸ G''` is trivial. -/
theorem MonoidHom.transfer_commutator_eq_one {G : Type} [Group G] [Group.FG (commutator G)]
    [(commutator G).FiniteIndex] {A : Type*} [CommGroup A] (ϕ : commutator G →* A) :
    ϕ.transfer = 1 := by
  have hϕ : ϕ = (Abelianization.lift ϕ).comp Abelianization.of := by
    ext
    simp
  ext g
  rw [hϕ, MonoidHom.transfer_comp, MonoidHom.comp_apply,
    TauCeti.CommutatorTransfer.transfer_of_eq_one, map_one, MonoidHom.one_apply]
