/-!
# Minimal normal subgroups

A minimal normal subgroup of a group `G` (`Subgroup.IsMinimalNormal`) is a nontrivial normal
subgroup containing no normal subgroup of `G` other than `⊥` and itself. This file proves the
structure theorem for finite minimal normal subgroups: such a subgroup `N` is isomorphic to a
direct power `S^k` of a simple group `S`, and to `(ZMod p)^k` for a prime `p` when `N` is solvable.
Chief factors are minimal normal subgroups of quotients, so this is the description of the chief
factors of a finite group, and in the solvable case the input for the socle and the solvable
radical. The file also shows that a nontrivial finite normal subgroup contains a minimal normal
subgroup, and that a solvable minimal normal subgroup is commutative.

The proof works in the modular lattice `NormalSubgroup N` of normal subgroups of `N`. An
atom `A` of that lattice is a minimal normal subgroup of `N`, and so are its images under the
automorphisms of `N` induced by conjugation in `G`. The supremum of these conjugates is normalized
by `G`, so by minimality of `N` it is all of `N`. Modularity lets us extract an independent
subfamily of conjugates which still generates `N`; distinct members meet trivially and hence
commute elementwise, so `N` is their internal direct product. Each member `T` is simple, because
`N = T ⊔ C` for a subgroup `C` centralizing `T`, so that every normal subgroup of `T` is normal
in `N`.

## Main results

* `Subgroup.IsMinimalNormal.isSimpleGroup_of_sup_centralizer_eq_top`: a minimal normal subgroup
  which together with its centralizer generates the whole group is a simple group.
* `Subgroup.isSimpleGroup_of_isMinimalNormal_of_iSup_eq_top`: if `G` is generated by pairwise
  disjoint minimal normal subgroups, each of them is a simple group.
* `Subgroup.IsMinimalNormal.iSup_map_conjNormal_eq_top`: the `G`-conjugates of a nontrivial
  subgroup of a minimal normal subgroup `N` generate `N`.
* `Subgroup.IsMinimalNormal.exists_mulEquiv_pi`: a finite minimal normal subgroup `N` is isomorphic
  to `Fin k → S` for a simple minimal normal subgroup `S` of `N`.
* `Subgroup.IsMinimalNormal.exists_prime_mulEquiv_pi_zmod`: a finite solvable minimal normal
  subgroup is isomorphic to `(ZMod p)^k` for a prime `p`.
* `Subgroup.IsMinimalNormal.prime_exponent`: a finite solvable minimal normal subgroup has prime
  exponent.
* `Subgroup.IsMinimalNormal.isMulCommutative`: a solvable minimal normal subgroup is commutative.
* `Subgroup.isMinimalNormal_top_iff`: the whole group is minimal normal exactly when it is simple.
* `Subgroup.exists_isMinimalNormal_le`: a nontrivial finite normal subgroup contains a minimal
  normal subgroup.

## References

* D. J. S. Robinson, *A Course in the Theory of Groups*, 2nd ed., Graduate Texts in Mathematics 80,
  Springer, 1996, 3.3.15.
-/

public section

open Function Subgroup TauCeti

variable {G : Type*} [Group G]

namespace Subgroup.IsMinimalNormal

variable {N : Subgroup G}

/-- A minimal normal subgroup `N` such that `N` and its centralizer generate `G` is a simple
group. -/
theorem isSimpleGroup_of_sup_centralizer_eq_top (hN : N.IsMinimalNormal)
    (h : N ⊔ centralizer (N : Set G) = ⊤) : IsSimpleGroup N := by
  have : Nontrivial N := (nontrivial_iff_ne_bot N).2 hN.ne_bot
  refine ⟨fun U hU ↦ ?_⟩
  -- `U` is normalized by `N` and by the centralizer of `N`, hence is normal in `G`.
  have hle : U.map N.subtype ≤ N := map_subtype_le U
  have hUN : ((U.map N.subtype).subgroupOf N).Normal := by
    rwa [← comap_subtype, comap_map_eq_self_of_injective N.subtype_injective]
  have hnorm : (U.map N.subtype).Normal := by
    rw [← normalizer_eq_top_iff, eq_top_iff, ← h]
    exact sup_le (le_normalizer_of_normal_subgroupOf hle)
      ((centralizer_le hle).trans (centralizer_le_normalizer _))
  rcases hN.eq_bot_or_eq hnorm hle with h0 | h1
  · exact Or.inl ((map_eq_bot_iff_of_injective _ N.subtype_injective).1 h0)
  · refine Or.inr (map_injective N.subtype_injective ?_)
    rw [h1, ← MonoidHom.range_eq_map, range_subtype]

/-- **Solvable minimal normal subgroups are commutative.** -/
theorem isMulCommutative [Group.IsSolvable N] (hN : N.IsMinimalNormal) : IsMulCommutative N := by
  -- The commutator subgroup `⁅N, N⁆` is normal in `G` and, as `N` is solvable, properly contained
  -- in `N`, so it is trivial.
  have := hN.normal
  have : Nontrivial N := (nontrivial_iff_ne_bot N).2 hN.ne_bot
  have hlt : ⁅N, N⁆ < N := by
    rw [← N.range_subtype, MonoidHom.range_eq_map, ← map_commutator, map_subtype_lt_map_subtype]
    exact Group.IsSolvable.commutator_lt_top_of_nontrivial N
  rw [← commutator_self_eq_bot_iff]
  exact (hN.eq_bot_or_eq inferInstance (commutator_le_left N N)).resolve_right hlt.ne

end Subgroup.IsMinimalNormal

/-- The whole group is a minimal normal subgroup of itself exactly when it is a simple group. -/
theorem Subgroup.isMinimalNormal_top_iff : (⊤ : Subgroup G).IsMinimalNormal ↔ IsSimpleGroup G := by
  refine ⟨fun h ↦ ?_, fun h ↦ isMinimalNormal_iff.2 ⟨normal_top, top_ne_bot, fun M _ _ ↦
    IsSimpleGroup.eq_bot_or_eq_top_of_normal M⟩⟩
  have : Nontrivial G := nontrivial_iff.1 (nontrivial_of_ne _ _ h.ne_bot)
  exact ⟨fun M hM ↦ h.eq_bot_or_eq hM le_top⟩

/-- A nontrivial finite normal subgroup `M`, for instance any nontrivial normal subgroup of a
finite group, contains a minimal normal subgroup. -/
theorem Subgroup.exists_isMinimalNormal_le {M : Subgroup G} [M.Normal] [Finite M] (hM : M ≠ ⊥) :
    ∃ N : Subgroup G, N.IsMinimalNormal ∧ N ≤ M := by
  induction h : Nat.card M using Nat.strong_induction_on generalizing M with
  | _ n ih =>
    by_cases hmin : M.IsMinimalNormal
    · exact ⟨M, hmin, le_rfl⟩
    -- Otherwise `M` contains a nontrivial normal subgroup `K` of `G` other than `M` itself.
    obtain ⟨K, hKM, hK, hKbot, hKne⟩ : ∃ K ≤ M, K.Normal ∧ K ≠ ⊥ ∧ K ≠ M := by
      simpa [isMinimalNormal_iff, ‹M.Normal›, hM, not_or] using hmin
    have := hK
    have : Finite K := Finite.of_injective _ (inclusion_injective hKM)
    obtain ⟨N, hN, hNK⟩ := ih _ (h ▸ card_lt_of_lt (lt_of_le_of_ne hKM hKne)) hKbot rfl
    exact ⟨N, hN, hNK.trans hKM⟩

/-- If `G` is generated by a family of pairwise disjoint minimal normal subgroups, then each member
of the family is a simple group. -/
theorem Subgroup.isSimpleGroup_of_isMinimalNormal_of_iSup_eq_top {ι : Type*}
    {H : ι → Subgroup G} (hH : ∀ i, (H i).IsMinimalNormal) (hdisj : Pairwise (Disjoint on H))
    (htop : ⨆ i, H i = ⊤) (i : ι) : IsSimpleGroup (H i) := by
  -- The other members of the family centralize `H i`.
  refine (hH i).isSimpleGroup_of_sup_centralizer_eq_top (eq_top_iff.2 ?_)
  rw [← htop]
  refine iSup_le fun j ↦ ?_
  obtain rfl | hij := eq_or_ne i j
  · exact le_sup_left
  · exact le_sup_of_le_right fun y hy ↦ mem_centralizer_iff.2 fun x hx ↦
      (pairwise_commute_of_normal_of_pairwiseDisjoint (fun k ↦ (hH k).normal) hdisj hij
        x y hx hy).eq

namespace Subgroup.IsMinimalNormal

variable {N : Subgroup G}

/-- The conjugates under `G` of a nontrivial subgroup `A` of a minimal normal subgroup `N` of `G`
generate `N`. -/
theorem iSup_map_conjNormal_eq_top [N.Normal] (hN : N.IsMinimalNormal) {A : Subgroup N}
    (hA : A ≠ ⊥) : ⨆ g : G, A.map ((MulAut.conjNormal g : MulAut N) : N →* N) = ⊤ := by
  set K := ⨆ g : G, A.map ((MulAut.conjNormal g : MulAut N) : N →* N)
  -- `K` is normalized by `G`, so its image in `G` is a nontrivial normal subgroup inside `N`.
  have hK : ∀ g : G, K.map ((MulAut.conjNormal g : MulAut N) : N →* N) ≤ K := fun g ↦ by
    rw [map_iSup]
    refine iSup_le fun h ↦ le_iSup_of_le (g * h) (le_of_eq ?_)
    rw [map_map]
    congr 1
    ext x
    simp [MulAut.mul_apply]
  have hKn : (K.map N.subtype).Normal := ⟨fun x hx g ↦ by
    obtain ⟨k, hk, rfl⟩ := mem_map.1 hx
    exact mem_map.2 ⟨MulAut.conjNormal g k, hK g (mem_map_of_mem _ hk),
      MulAut.conjNormal_apply g k⟩⟩
  have hAK : A ≤ K := le_iSup_of_le 1 (by simp [MulAut.one_def])
  have hKbot : K.map N.subtype ≠ ⊥ := by
    rw [Ne, map_eq_bot_iff_of_injective _ N.subtype_injective]
    exact fun h ↦ hA (eq_bot_iff.2 (h ▸ hAK))
  have hKN := (hN.eq_bot_or_eq hKn (map_subtype_le K)).resolve_left hKbot
  rw [← comap_map_eq_self_of_injective N.subtype_injective K, hKN, comap_subtype, subgroupOf_self]

/-- **Minimal normal subgroups of finite groups are direct powers of simple groups.** A finite
minimal normal subgroup `N` of a group, for instance any minimal normal subgroup of a finite group,
is isomorphic to `Fin k → S`, where `S` is a minimal normal subgroup of `N` which is a simple
group. -/
theorem exists_mulEquiv_pi [Finite N] (hN : N.IsMinimalNormal) :
    ∃ S : Subgroup N, S.IsMinimalNormal ∧ IsSimpleGroup S ∧
      ∃ k : ℕ, Nonempty (N ≃* (Fin k → S)) := by
  classical
  have := hN.normal
  have : Nontrivial N := (nontrivial_iff_ne_bot N).2 hN.ne_bot
  have hNtop : (⊤ : NormalSubgroup N) ≠ ⊥ := by
    rw [Ne, ← Subtype.coe_inj, CompleteSublattice.coe_top, CompleteSublattice.coe_bot]
    exact top_ne_bot
  -- A minimal normal subgroup `A` of `N`, that is, an atom of the lattice of normal subgroups.
  obtain ⟨A, hA, -⟩ := (eq_bot_or_exists_atom_le (⊤ : NormalSubgroup N)).resolve_left hNtop
  have hAm := NormalSubgroup.isAtom_iff_isMinimalNormal.1 hA
  -- Its conjugates `f g` under `G` are minimal normal in `N`.
  let φ : G →* MulAut N := MulAut.conjNormal
  have hf : ∀ g, ((A : Subgroup N).map (φ g : N →* N)).IsMinimalNormal :=
    fun g ↦ hAm.map_mulEquiv (φ g)
  let f : G → NormalSubgroup N := fun g ↦ ⟨_, mem_normalSubgroups.2 (hf g).normal⟩
  -- An independent subfamily `t` of the finitely many conjugates still generates `N`.
  have : Fintype (NormalSubgroup N) := Fintype.ofFinite _
  obtain ⟨t, hts, hind, hsup⟩ := exists_subset_supIndep_sup_eq_of_isAtom (N := id)
    (Set.range f).toFinset fun x hx ↦ by
      obtain ⟨g, rfl⟩ := Set.mem_toFinset.1 hx
      exact NormalSubgroup.isAtom_iff_isMinimalNormal.2 (hf g)
  choose g hg using fun x : t ↦ Set.mem_toFinset.1 (hts x.property)
  let H : t → Subgroup N := fun x ↦ (x : NormalSubgroup N)
  have hH : ∀ x, (H x).IsMinimalNormal := fun x ↦ by simpa [H, ← hg x] using hf (g x)
  have htop : ⨆ x, H x = ⊤ := by
    refine eq_top_iff.2 ((iSup_map_conjNormal_eq_top hN hAm.ne_bot).ge.trans (iSup_le fun g ↦ ?_))
    -- `f g` lies below the supremum of `t`, which in `Subgroup N` is the supremum of `H`.
    have hfg : f g ≤ t.sup id := hsup ▸ Finset.le_sup (f := id) (Set.mem_toFinset.2 ⟨g, rfl⟩)
    have hle : (A : Subgroup N).map (φ g : N →* N) ≤
        ((t.sup id : NormalSubgroup N) : Subgroup N) := Subtype.coe_le_coe.2 hfg
    rw [NormalSubgroup.coe_finset_sup] at hle
    exact hle.trans (Finset.sup_le fun x hx ↦ le_iSup H ⟨x, hx⟩)
  have hdisj : Pairwise (Disjoint on H) := fun x y hxy ↦ CompleteSublattice.disjoint_iff.1
    (hind.pairwiseDisjoint x.property y.property (Subtype.coe_injective.ne hxy))
  let eN := mulEquivPiOfISupIndep (fun x ↦ (hH x).normal)
    (CompleteSublattice.iSupIndep_coe_iff.2 (iSupIndep_comp_coe_iff_supIndep.2 hind)) htop
  -- Each member of the family is isomorphic to `A`, and is a simple group.
  let e : ∀ x, H x ≃* A := fun x ↦ (MulEquiv.subgroupCongr congr(Subtype.val $(hg x)).symm).trans
    ((A : Subgroup N).equivMapOfInjective _ (φ (g x)).injective).symm
  obtain ⟨x⟩ : Nonempty t := by
    by_contra h
    rw [not_nonempty_iff] at h
    exact top_ne_bot (α := Subgroup N) (htop.symm.trans (iSup_of_empty _))
  have := isSimpleGroup_of_isMinimalNormal_of_iSup_eq_top hH hdisj htop x
  exact ⟨A, hAm, (e x).symm.isSimpleGroup, Fintype.card t, ⟨eN.symm.trans
    ((MulEquiv.piCongrRight e).trans (MulEquiv.arrowCongr (Fintype.equivFin t) (.refl _)))⟩⟩

/-- **Minimal normal subgroups of finite solvable groups are elementary abelian.** A finite solvable
minimal normal subgroup of a group, for instance any minimal normal subgroup of a finite solvable
group, is isomorphic to `(ZMod p)^k` for a prime `p`. -/
theorem exists_prime_mulEquiv_pi_zmod [Finite N] [Group.IsSolvable N] (hN : N.IsMinimalNormal) :
    ∃ p : ℕ, p.Prime ∧ ∃ k : ℕ, Nonempty (N ≃* (Fin k → Multiplicative (ZMod p))) := by
  obtain ⟨S, -, hS, k, ⟨e⟩⟩ := hN.exists_mulEquiv_pi
  -- The simple group `S` is solvable, hence commutative of prime order, hence cyclic.
  have : IsMulCommutative S := ⟨⟨IsSimpleGroup.comm_iff_isSolvable.2 inferInstance⟩⟩
  have hp : (Nat.card S).Prime := Group.is_simple_iff_prime_card.1 hS
  exact ⟨Nat.card S, hp, k, ⟨e.trans (MulEquiv.arrowCongr (Equiv.refl _)
    (zmodCyclicMulEquiv (isCyclic_of_prime_card rfl (hp := ⟨hp⟩))).symm)⟩⟩

/-- A finite solvable minimal normal subgroup has prime exponent: it is elementary abelian. -/
theorem prime_exponent [Finite N] [Group.IsSolvable N] (hN : N.IsMinimalNormal) :
    (Monoid.exponent N).Prime := by
  obtain ⟨p, hp, k, ⟨e⟩⟩ := hN.exists_prime_mulEquiv_pi_zmod
  have : Nontrivial N := (nontrivial_iff_ne_bot N).2 hN.ne_bot
  -- Every element of `(ZMod p)^k` is killed by `p`.
  have hdvd : Monoid.exponent N ∣ p := Monoid.exponent_dvd_of_forall_pow_eq_one fun x ↦
    e.injective <| funext fun i ↦ by
      rw [map_pow, map_one, Pi.pow_apply, Pi.one_apply, ← toAdd_eq_zero, toAdd_pow, nsmul_eq_mul,
        ZMod.natCast_self, zero_mul]
  exact (hp.eq_one_or_self_of_dvd _ hdvd).resolve_left (Monoid.one_lt_exponent).ne' ▸ hp

end Subgroup.IsMinimalNormal
