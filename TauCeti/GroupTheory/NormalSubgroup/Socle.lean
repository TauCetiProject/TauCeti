module

public import Mathlib.Data.Nat.Squarefree
public import Mathlib.GroupTheory.Exponent
public import TauCeti.GroupTheory.NormalSubgroup.MinimalNormal

/-!
# The socle of a group

The socle `Subgroup.socle G` of a group `G` is the join of its minimal normal subgroups. It is a
characteristic subgroup, and for a finite group it is the internal direct product of finitely many
minimal normal subgroups, since these are the atoms of the modular lattice of normal subgroups. A
finite group has trivial socle only when it is trivial, and a simple group is its own socle.

Two distinct minimal normal subgroups meet trivially and so commute elementwise. Hence the socle
is commutative exactly when every minimal normal subgroup is. This holds in a solvable group, whose
minimal normal subgroups are commutative; when `G` is moreover finite, its minimal normal
subgroups are elementary abelian, so the exponent of the socle is squarefree.

## Main definitions

* `Subgroup.socle G`: the join of the minimal normal subgroups of `G`.

## Main results

* `Subgroup.socle_le_iff`: the universal property of the socle as a join.
* `Subgroup.map_socle`: a group isomorphism maps the socle onto the socle.
* `Subgroup.characteristic_socle`: the socle is a characteristic subgroup.
* `Subgroup.socle_eq_bot_iff`: a finite group has trivial socle exactly when it is trivial.
* `Subgroup.socle_eq_top`: the socle of a simple group is the whole group.
* `Subgroup.exists_iSupIndep_iSup_eq_socle`: the socle of a finite group is the join of an
  independent finite family of minimal normal subgroups.
* `Subgroup.isMulCommutative_socle_iff`: the socle is commutative exactly when every minimal normal
  subgroup is.
* `Subgroup.isMulCommutative_socle`: the socle of a solvable group is commutative.
* `Subgroup.squarefree_exponent_socle`: the socle of a finite solvable group has squarefree
  exponent.

## References

* D. J. S. Robinson, *A Course in the Theory of Groups*, 2nd ed., Graduate Texts in Mathematics 80,
  Springer, 1996, 3.3.15 and 3.3.16.
-/

public section

namespace Subgroup

variable {G : Type*} [Group G]

variable (G) in
/-- The **socle** of a group `G`: the join of the minimal normal subgroups of `G`. -/
def socle : Subgroup G :=
  sSup {N | N.IsMinimalNormal}

theorem socle_def : socle G = sSup {N : Subgroup G | N.IsMinimalNormal} :=
  (rfl)

/-- Every minimal normal subgroup lies in the socle. -/
theorem le_socle {N : Subgroup G} (hN : N.IsMinimalNormal) : N ≤ socle G :=
  le_sSup hN

/-- The socle lies in a subgroup `H` exactly when every minimal normal subgroup does. -/
theorem socle_le_iff {H : Subgroup G} :
    socle G ≤ H ↔ ∀ N : Subgroup G, N.IsMinimalNormal → N ≤ H :=
  sSup_le_iff

/-- The socle is generated by the elements of the minimal normal subgroups. -/
theorem socle_eq_closure :
    socle G = closure {x | ∃ N : Subgroup G, N.IsMinimalNormal ∧ x ∈ N} :=
  le_antisymm (socle_le_iff.2 fun _ hN _ hx ↦ subset_closure ⟨_, hN, hx⟩)
    (closure_le _ |>.2 fun _ ⟨_, hN, hx⟩ ↦ le_socle hN hx)

private theorem map_socle_le {G' : Type*} [Group G'] (e : G ≃* G') :
    (socle G).map (e : G →* G') ≤ socle G' :=
  map_le_iff_le_comap.2 <| socle_le_iff.2 fun _ hN ↦
    map_le_iff_le_comap.1 (le_socle (hN.map_mulEquiv e))

/-- A group isomorphism maps the socle onto the socle. -/
theorem map_socle {G' : Type*} [Group G'] (e : G ≃* G') :
    (socle G).map (e : G →* G') = socle G' := by
  refine le_antisymm (map_socle_le e) ?_
  -- Pull the socle of `G'` back along `e` and push it forward again.
  calc socle G' = ((socle G').map (e.symm : G' →* G)).map (e : G →* G') := by
        simp [map_map]
    _ ≤ (socle G).map (e : G →* G') := map_mono (map_socle_le e.symm)

/-- The socle is a characteristic subgroup, hence a normal subgroup. -/
instance characteristic_socle : (socle G).Characteristic :=
  characteristic_iff_map_eq.2 map_socle

/-- A finite group has trivial socle exactly when it is trivial. -/
theorem socle_eq_bot_iff [Finite G] : socle G = ⊥ ↔ Subsingleton G := by
  refine ⟨fun h ↦ ?_, fun _ ↦ Subsingleton.elim _ _⟩
  by_contra hG
  rw [not_subsingleton_iff_nontrivial] at hG
  obtain ⟨N, hN, -⟩ := exists_isMinimalNormal_le (M := (⊤ : Subgroup G)) top_ne_bot
  exact hN.ne_bot (eq_bot_iff.2 (h ▸ le_socle hN))

/-- The socle of a simple group is the whole group. -/
@[simp]
theorem socle_eq_top [IsSimpleGroup G] : socle G = ⊤ :=
  top_le_iff.1 (le_socle (isMinimalNormal_top_iff.2 inferInstance))

/-- **The socle is a direct product of minimal normal subgroups.** The socle of a finite group is
the join of an independent finite family of minimal normal subgroups; equivalently, it is their
internal direct product. -/
theorem exists_iSupIndep_iSup_eq_socle [Finite G] :
    ∃ (k : ℕ) (N : Fin k → Subgroup G), (∀ i, (N i).IsMinimalNormal) ∧ iSupIndep N ∧
      ⨆ i, N i = socle G := by
  rw [socle_def]
  exact exists_iSupIndep_iSup_eq_sSup_of_isMinimalNormal (Set.toFinite _) fun _ ↦ Set.mem_ofPred.1

/-- The socle is commutative exactly when every minimal normal subgroup is commutative. -/
theorem isMulCommutative_socle_iff :
    IsMulCommutative (socle G) ↔ ∀ N : Subgroup G, N.IsMinimalNormal → IsMulCommutative N := by
  refine ⟨fun h N hN ↦ ?_, fun h ↦ ?_⟩
  · rw [← le_centralizer_iff_isMulCommutative] at h ⊢
    exact (le_socle hN).trans (h.trans (centralizer_le (le_socle hN)))
  · -- Distinct minimal normal subgroups commute elementwise.
    rw [socle_eq_closure]
    refine isMulCommutative_closure ?_
    rintro x ⟨N, hN, hx⟩ y ⟨M, hM, hy⟩ -
    obtain rfl | hne := eq_or_ne N M
    · have := h N hN
      exact setLike_mul_comm hx hy
    · exact hN.commute_of_ne hM hne hx hy

/-- **The socle of a solvable group is commutative.** -/
instance isMulCommutative_socle [Group.IsSolvable G] : IsMulCommutative (socle G) :=
  isMulCommutative_socle_iff.2 fun _ hN ↦ hN.isMulCommutative

/-- **The socle of a finite solvable group has squarefree exponent.** -/
theorem squarefree_exponent_socle [Finite G] [Group.IsSolvable G] :
    Squarefree (Monoid.exponent (socle G)) := by
  -- The socle is a commutative group generated by elements of prime order, so its exponent
  -- divides the product of the primes dividing the order of `G`.
  suffices h : ∀ x ∈ socle G, x ^ ∏ p ∈ (Nat.card G).primeFactors, p = 1 from
    (Nat.squarefree_prod_primeFactors (Nat.card G)).squarefree_of_dvd
      (Monoid.exponent_dvd_of_forall_pow_eq_one fun g ↦ Subtype.ext (by simpa using h g g.property))
  intro x hx
  rw [socle_eq_closure] at hx
  induction hx using closure_induction with
  | mem x hx =>
    -- An element of a minimal normal subgroup `N` has order dividing the prime exponent of `N`,
    -- which divides the order of `G`.
    obtain ⟨N, hN, hxN⟩ := hx
    have hp := hN.prime_exponent
    refine orderOf_dvd_iff_pow_eq_one.1 ((orderOf_dvd_of_pow_eq_one
      (pow_exponent_eq_one hxN)).trans (Finset.dvd_prod_of_mem (fun q ↦ q) ?_))
    exact Nat.mem_primeFactors.2 ⟨hp, Group.exponent_dvd_nat_card.trans
      (card_subgroup_dvd_card N), Nat.card_pos.ne'⟩
  | one => exact one_pow _
  | mul x y hx hy ihx ihy =>
    rw [← socle_eq_closure] at hx hy
    rw [Commute.mul_pow (setLike_mul_comm hx hy), ihx, ihy, one_mul]
  | inv x _ ih => rw [inv_pow, ih, inv_one]

end Subgroup
