/-!
# Tits's simplicity criterion for the normal closure of a split unipotent subgroup

Let `G` carry a Tits system `(B, N)` with irreducible Weyl group, and let `U` be a solvable
subgroup normalized by `B` with `B ≤ U (B ∩ N)`. Neither `U ≤ B` nor equality is assumed; the
split case `B = U (B ∩ N)`, as for the unipotent radical of the Borel subgroup of a split BN-pair,
is the main example. Put

```text
Z  = ⋂_{g : G} g B g⁻¹,        H⁺ = normal closure of U in G.
```

The group `G` itself need not be perfect or generated by the conjugates of `U`: for the finite
groups of Lie type, `G` is the group of fixed points of a Steinberg endomorphism and `H⁺` is the
subgroup generated by its root subgroups, typically the derived subgroup. This file proves
**Tits's simplicity criterion** for `H⁺`, under the assumption that `H⁺` is perfect:

* every normal subgroup of `H⁺` lies in `Z ∩ H⁺` or is all of `H⁺`;
* if moreover `Z ∩ U = 1`, then `Z ∩ H⁺` is the centre of `H⁺`;
* hence `H⁺ / (Z ∩ H⁺)` is simple whenever it is nontrivial, and when `H⁺ = [G, G]` the derived
  central quotient `[G, G] / Z([G, G])` is simple whenever it is nontrivial;
* if `Z ∩ U = 1`, then `H⁺ / (Z ∩ H⁺)` is nontrivial as soon as `U ≠ 1`. When `H⁺ = [G, G]`,
  the derived central quotient is nontrivial as soon as `U ≠ 1`, for any perfect `[G, G]`
  (`TauCeti.Group.IsPerfect.nontrivial_quotient_center`).

Either `H⁺ ≤ Z`, and everything is degenerate, or `H⁺ B = G` by Tits's theorem on normal
subgroups. In the second case `G = H⁺ (B ∩ N)`, so `(B, N)` pulls back to a Tits system on `H⁺`
(`TauCeti.TitsSystem.comap`) with the same Weyl group and simple reflections, in which the
conjugates of `U` generate. Tits's simplicity theorem for that Tits system gives the first
statement, because the normal core of `B ∩ H⁺` in `H⁺` is `Z ∩ H⁺`. If `Z ∩ U = 1`, then `Z`
commutes with `U`, hence with each conjugate of `U`, so `Z ∩ H⁺` is central; conversely the centre
of the perfect group `H⁺` cannot be all of `H⁺` unless `H⁺` is trivial.

## Main results

* `TauCeti.TitsSystem.le_normalCore_subgroupOf_or_eq_top_of_normal`: the normal-subgroup theorem
  for `H⁺`.
* `TauCeti.TitsSystem.center_normalClosure_eq_normalCore_subgroupOf`: the centre of `H⁺` is
  `Z ∩ H⁺` when `Z ∩ U = 1`.
* `TauCeti.TitsSystem.isSimpleGroup_quotient_normalCore_subgroupOf`: `H⁺ / (Z ∩ H⁺)` is simple
  whenever it is nontrivial.
* `TauCeti.TitsSystem.isSimpleGroup_derivedCentralQuotient`: if `H⁺ = [G, G]`, the derived central
  quotient of `G` is simple whenever it is nontrivial.
* `TauCeti.TitsSystem.nontrivial_quotient_normalCore_subgroupOf`: `H⁺ / (Z ∩ H⁺)` is nontrivial
  when `Z ∩ U = 1` and `U ≠ 1`.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Chapter IV, §2, no. 7.
* B. Conrad, handout on Tits systems for Math 249B (Stanford, Winter 2016), Theorem 2.4.
* R. W. Carter, *Simple Groups of Lie Type* (1972), Chapter 11.
-/

public section

namespace TauCeti.TitsSystem

universe u

variable {G : Type u} [Group G] (T : TitsSystem G)

/-! ### The normal closure of a split unipotent subgroup -/

variable {U : Subgroup G}

/-- If `Z = ⋂ g B g⁻¹` meets `U ≠ 1` trivially, then the quotient `H⁺ / (Z ∩ H⁺)` of the normal
closure `H⁺` of `U` is nontrivial, since otherwise `U ≤ H⁺ ≤ Z`. -/
theorem nontrivial_quotient_normalCore_subgroupOf (hZU : T.subgroupB.normalCore ⊓ U = ⊥)
    (hU : U ≠ ⊥) :
    Nontrivial (Subgroup.normalClosure (U : Set G) ⧸
      T.subgroupB.normalCore.subgroupOf (Subgroup.normalClosure (U : Set G))) :=
  QuotientGroup.nontrivial_subgroupOf_of_inf_eq_bot Subgroup.le_normalClosure hZU hU

variable (hirr : T.IsIrreducible) [Group.IsSolvable U]
  (hBU : T.subgroupB ≤ Subgroup.normalizer (U : Set G))
  (hsplit : T.subgroupB ≤ U ⊔ T.subgroupB ⊓ T.subgroupN)

include hirr hBU hsplit

/-- **Tits's theorem on normal subgroups of the normal closure of `U`.** Suppose the Weyl group is
irreducible, `U` is a solvable subgroup normalized by `B` with `B ≤ U (B ∩ N)`, and the normal
closure `H⁺` of `U` is perfect. Then every normal subgroup of `H⁺` either lies in `Z ∩ H⁺`, where
`Z = ⋂ g B g⁻¹` is the normal core of `B`, or is all of `H⁺`. -/
theorem le_normalCore_subgroupOf_or_eq_top_of_normal
    [Group.IsPerfect (Subgroup.normalClosure (U : Set G))] :
    ∀ (K : Subgroup (Subgroup.normalClosure (U : Set G))) [K.Normal],
      K ≤ T.subgroupB.normalCore.subgroupOf (Subgroup.normalClosure (U : Set G)) ∨ K = ⊤ := by
  set P := Subgroup.normalClosure (U : Set G)
  intro K _
  rcases T.le_normalCore_or_sup_eq_top_of_normal hirr P with hP | hP
  · exact Or.inl fun x _ ↦ Subgroup.mem_subgroupOf.mpr (hP x.2)
  -- Now `G = P B ≤ P (B ∩ N)` since `U ≤ P`, so `(B, N)` pulls back to an irreducible Tits
  -- system on `P`.
  have hf : ∀ g : G, ∃ x : P, ∃ t ∈ T.subgroupB ⊓ T.subgroupN, P.subtype x * t = g := by
    have htop : P ⊔ T.subgroupB ⊓ T.subgroupN = ⊤ :=
      top_le_iff.mp (hP ▸ sup_le le_sup_left (hsplit.trans
        (sup_le_sup_right Subgroup.le_normalClosure _)))
    intro g
    obtain ⟨x, hx, t, ht, rfl⟩ := Subgroup.mem_sup_of_normal_left.mp (htop ▸ Subgroup.mem_top g)
    exact ⟨⟨x, hx⟩, t, ht, rfl⟩
  have hUP : U ≤ P := Subgroup.le_normalClosure
  have : Group.IsSolvable (U.subgroupOf P) :=
    Group.isSolvable_of_isSolvable_injective (f := (Subgroup.subgroupOfEquivOfLe hUP).toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hUP).injective
  -- `B ∩ P` normalizes `U`, read in `P`.
  have hBU' : (T.comap P.subtype hf).subgroupB ≤ Subgroup.normalizer (U.subgroupOf P : Set P) :=
    fun b hb ↦ Subgroup.mem_normalizer_iff.mpr fun x ↦ by
      rw [comap_subgroupB, Subgroup.mem_comap] at hb
      simpa [Subgroup.mem_subgroupOf] using Subgroup.mem_normalizer_iff.mp (hBU hb) x
  -- The conjugates of `U` by elements of `P` generate `P`, since `P` and the normalizer of `U`
  -- together contain `P B = G`.
  have hU' : Subgroup.normalClosure (U.subgroupOf P : Set P) = ⊤ :=
    Subgroup.normalClosure_subgroupOf_normalClosure_eq_top
      (eq_top_iff.mpr (hP.ge.trans (sup_le_sup_left hBU _)))
  -- The normal core of `B ∩ P` in `P` is `Z ∩ P`.
  exact ((T.comap P.subtype hf).le_normalCore_or_eq_top_of_normal
    ((T.isIrreducible_comap_iff P.subtype hf).mpr hirr) hBU' hU' K).imp_left
    fun hK ↦ hK.trans (T.normalCore_comap_subgroupB P.subtype hf).le

/-- **The centre of the normal closure of `U`.** Under the hypotheses of
`TauCeti.TitsSystem.le_normalCore_subgroupOf_or_eq_top_of_normal`, if moreover `Z ∩ U = 1`, then
the centre of the normal closure `H⁺` of `U` is `Z ∩ H⁺`. -/
theorem center_normalClosure_eq_normalCore_subgroupOf
    [Group.IsPerfect (Subgroup.normalClosure (U : Set G))]
    (hZU : T.subgroupB.normalCore ⊓ U = ⊥) :
    Subgroup.center (Subgroup.normalClosure (U : Set G)) =
      T.subgroupB.normalCore.subgroupOf (Subgroup.normalClosure (U : Set G)) := by
  set P := Subgroup.normalClosure (U : Set G)
  refine le_antisymm ?_ fun x hx ↦ Subgroup.mem_center_iff.mpr fun y ↦ Subtype.ext ?_
  · rcases T.le_normalCore_subgroupOf_or_eq_top_of_normal hirr hBU hsplit
      (Subgroup.center P) with h | h
    · exact h
    -- A perfect commutative group is trivial.
    have : IsMulCommutative P := Subgroup.center_eq_top_iff.mp h
    intro x _
    rw [Subsingleton.elim x 1]
    exact one_mem _
  -- `Z` centralizes `U`, so `U` lies in the normal subgroup centralizing `Z`, and so does `P`.
  have hZ : T.subgroupB.normalCore ≤ Subgroup.centralizer (P : Set G) :=
    Subgroup.le_centralizer_iff.mpr (Subgroup.normalClosure_le_normal
      (Subgroup.le_centralizer_iff.mp (TauCeti.le_centralizer_of_le_normalizer_of_inf_eq_bot
        (T.subgroupB.normalCore_le.trans hBU) hZU)))
  exact Subgroup.mem_centralizer_iff.mp (hZ (Subgroup.mem_subgroupOf.mp hx)) y y.2

/-- **Tits's simplicity criterion for the normal closure of `U`.** Under the hypotheses of
`TauCeti.TitsSystem.le_normalCore_subgroupOf_or_eq_top_of_normal`, the quotient `H⁺ / (Z ∩ H⁺)`
of the normal closure `H⁺` of `U` by its intersection with `Z = ⋂ g B g⁻¹` is simple whenever it is
nontrivial. -/
theorem isSimpleGroup_quotient_normalCore_subgroupOf
    [Group.IsPerfect (Subgroup.normalClosure (U : Set G))]
    [Nontrivial (Subgroup.normalClosure (U : Set G) ⧸
      T.subgroupB.normalCore.subgroupOf (Subgroup.normalClosure (U : Set G)))] :
    IsSimpleGroup (Subgroup.normalClosure (U : Set G) ⧸
      T.subgroupB.normalCore.subgroupOf (Subgroup.normalClosure (U : Set G))) := by
  set P := Subgroup.normalClosure (U : Set G)
  set Z := T.subgroupB.normalCore.subgroupOf P
  have hπ := QuotientGroup.mk'_surjective Z
  refine { eq_bot_or_eq_top_of_normal := fun K hK ↦ ?_ }
  have := hK.comap (QuotientGroup.mk' Z)
  rcases T.le_normalCore_subgroupOf_or_eq_top_of_normal hirr hBU hsplit
    (K.comap (QuotientGroup.mk' Z)) with h | h
  · refine Or.inl (eq_bot_iff.mpr fun x hx ↦ ?_)
    obtain ⟨g, rfl⟩ := hπ x
    exact (QuotientGroup.eq_one_iff g).mpr (h hx)
  · rw [← Subgroup.map_comap_eq_self_of_surjective hπ K, h, Subgroup.map_top_of_surjective _ hπ]
    exact Or.inr rfl

/-- **Simplicity of the derived central quotient from a split Tits system.** Suppose the Weyl group
is irreducible, `U` is a solvable subgroup normalized by `B` with `B ≤ U (B ∩ N)` and
`Z ∩ U = 1` for `Z = ⋂ g B g⁻¹`, the normal closure of `U` is the derived subgroup `[G, G]`, and
`[G, G]` is perfect. Then the derived central quotient `[G, G] / Z([G, G])` is simple whenever it
is nontrivial. -/
theorem isSimpleGroup_derivedCentralQuotient (hZU : T.subgroupB.normalCore ⊓ U = ⊥)
    (hU : Subgroup.normalClosure (U : Set G) = commutator G) [Group.IsPerfect (commutator G)]
    [Nontrivial (DerivedCentralQuotient G)] : IsSimpleGroup (DerivedCentralQuotient G) := by
  -- Replace `[G, G]` by the normal closure of `U`, where the criterion applies.
  suffices key : ∀ P : Subgroup G, Subgroup.normalClosure (U : Set G) = P →
      ∀ [Group.IsPerfect P] [Nontrivial (P ⧸ Subgroup.center P)],
        IsSimpleGroup (P ⧸ Subgroup.center P) from key _ hU
  rintro P rfl _ _
  let e := QuotientGroup.quotientMulEquivOfEq
    (T.center_normalClosure_eq_normalCore_subgroupOf hirr hBU hsplit hZU)
  have : Nontrivial (Subgroup.normalClosure (U : Set G) ⧸
      T.subgroupB.normalCore.subgroupOf (Subgroup.normalClosure (U : Set G))) :=
    e.symm.toEquiv.nontrivial
  have := T.isSimpleGroup_quotient_normalCore_subgroupOf hirr hBU hsplit
  exact IsSimpleGroup.isSimpleGroup_of_surjective e.symm.toMonoidHom e.symm.surjective

end TauCeti.TitsSystem

end
