module

public import TauCeti.GroupTheory.TitsSystem.Coxeter

import TauCeti.GroupTheory.DoubleCoset.TwoCell

/-!
# Tits systems of rank one

A Tits system of rank one has a single simple reflection `s`, and its Bruhat decomposition reads
`G = B ∪ B s B`. Conversely, this two-cell decomposition already supplies the generation and
multiplication axioms of a Tits system. This file records that construction.

Let `B` and `N` be subgroups of `G`, with `B ∩ N` normal in `N`, and let `n ∈ N` be an element such
that

* every element of `N` lies in `B` or in `n B`, so the Weyl group `N / (B ∩ N)` is generated by the
  class of `n`;
* `n² ∈ B`, and `n B n⁻¹ ≠ B`;
* every element of `G` lies in `B` or in the double coset `B n B`.

Then `TauCeti.TitsSystem.ofRankOne` is a Tits system with `B`, `N` and the single simple reflection
`n (B ∩ N)`. Its Coxeter system is irreducible, having only one generator, which is the
irreducibility hypothesis of Tits's simplicity theorem
`TauCeti.TitsSystem.le_normalCore_or_eq_top_of_normal`. Applying that theorem additionally requires
`G` to be perfect and a solvable subgroup normalized by `B` whose conjugates generate `G`.

These are the Tits systems of the finite groups of Lie rank one, such as `SL₂(q)`, the unitary
groups `SU₃(q)`, the Suzuki groups and the Ree groups `²G₂(q)`, where `B` is the stabilizer of a
point in a doubly transitive action and `n` exchanges that point with a second one. The subgroup
`N` may be taken as small as the cyclic group generated by `n`.

## Main definitions and results

* `TauCeti.TitsSystem.ofRankOne`: the Tits system defined by a two-cell Bruhat decomposition.
* `TauCeti.TitsSystem.ofRankOne_simple`: its only simple reflection is the class of `n`.
* `TauCeti.TitsSystem.isIrreducible_ofRankOne`: it is irreducible.

## References

* J. E. Humphreys, *Linear Algebraic Groups* (1975), Section 29.1.
-/

public section

open scoped Pointwise

namespace TauCeti.TitsSystem

universe u

variable {G : Type u} [Group G] (B N : Subgroup G) [(B.subgroupOf N).Normal] (n : N)

/-- **The Tits system of a two-cell Bruhat decomposition.** If `B ∩ N` is normal in `N`, every
element of `N` lies in `B` or in `n B`, `n² ∈ B`, `n B n⁻¹ ≠ B`, and every element of `G` lies in
`B` or in `B n B`, then `B` and `N` form a Tits system whose only simple reflection is the class
of `n`. -/
def ofRankOne (hn : (n : G) * n ∈ B) (hN : ∀ x ∈ N, x ∈ B ∨ (n : G)⁻¹ * x ∈ B)
    (hconj : ∃ b ∈ B, (n : G) * b * (n : G)⁻¹ ∉ B)
    (hbruhat : ∀ g : G, g ∈ B ∨ g ∈ DoubleCoset.doubleCoset (n : G) B B) : TitsSystem G where
  subgroupB := B
  subgroupN := N
  closure_subgroupB_union_subgroupN := by
    refine eq_top_iff.mpr fun g _ ↦ ?_
    rcases hbruhat g with hg | hg
    · exact Subgroup.subset_closure (Or.inl hg)
    · obtain ⟨x, hx, y, hy, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
      exact mul_mem (mul_mem (Subgroup.subset_closure (Or.inl hx))
        (Subgroup.subset_closure (Or.inr n.2))) (Subgroup.subset_closure (Or.inl hy))
  intersection_normal := inferInstance
  simple := {QuotientGroup.mk n}
  closure_simple := by
    refine eq_top_iff.mpr fun x _ ↦ ?_
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective x
    rcases hN x x.2 with hx | hx
    · rw [(QuotientGroup.eq_one_iff x).mpr (Subgroup.mem_subgroupOf.mpr hx)]
      exact one_mem _
    · rw [← (QuotientGroup.eq (s := B.subgroupOf N) (a := n) (b := x)).mpr
        (Subgroup.mem_subgroupOf.mpr (by simpa using hx))]
      exact Subgroup.subset_closure rfl
  exists_simpleRep_sq_mem s hs := ⟨n, hs.symm, Subgroup.mem_subgroupOf.mpr hn⟩
  mul_doubleCoset_subset s hs := ⟨n, hs.symm, fun w ↦
    B.doubleCoset_mul_doubleCoset_subset_union hn (hN w w.2) hbruhat⟩
  exists_conj_not_mem s hs := by
    obtain ⟨b, hb, hnb⟩ := hconj
    exact ⟨n, hs.symm, ⟨b, hb⟩, hnb⟩

variable {B N n} {hn : (n : G) * n ∈ B} {hN : ∀ x ∈ N, x ∈ B ∨ (n : G)⁻¹ * x ∈ B}
  {hconj : ∃ b ∈ B, (n : G) * b * (n : G)⁻¹ ∉ B}
  {hbruhat : ∀ g : G, g ∈ B ∨ g ∈ DoubleCoset.doubleCoset (n : G) B B}

/-- The subgroup `B` of the Tits system of a two-cell decomposition is `B`. -/
@[simp]
theorem ofRankOne_subgroupB : (ofRankOne B N n hn hN hconj hbruhat).subgroupB = B :=
  (rfl)

/-- The subgroup `N` of the Tits system of a two-cell decomposition is `N`. -/
@[simp]
theorem ofRankOne_subgroupN : (ofRankOne B N n hn hN hconj hbruhat).subgroupN = N :=
  (rfl)

/-- The only simple reflection of the Tits system of a two-cell decomposition is the class of
`n`. -/
@[simp]
theorem ofRankOne_simple :
    (ofRankOne B N n hn hN hconj hbruhat).simple =
      {QuotientGroup.mk ⟨(n : G), by rw [ofRankOne_subgroupN]; exact n.2⟩} :=
  (rfl)

/-- **A Tits system of rank one is irreducible.** -/
theorem isIrreducible_ofRankOne : (ofRankOne B N n hn hN hconj hbruhat).IsIrreducible :=
  isIrreducible_of_subsingleton_simple _ (by
    rw [ofRankOne_simple]
    exact Set.subsingleton_singleton)

end TauCeti.TitsSystem
