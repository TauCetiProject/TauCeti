module

public import TauCeti.GroupTheory.TitsSystem.Parabolic.Basic
import TauCeti.GroupTheory.TitsSystem.Comap
import TauCeti.GroupTheory.QuotientGroup.Map

/-!
# The Tits system of a standard parabolic

For a Tits system `(B, N)` and a selection `J` of its simple reflections, the standard
parabolic `P_J` inherits the Tits system `(B, N ∩ P_J)`. Its Weyl group is canonically the
subgroup `W_J` generated by `J`, and its simple reflections correspond exactly to `J`.
The Bruhat cells are the preimages of the ambient cells under `P_J → G`.

This permits Bruhat decomposition and the other Tits-system constructions to be applied
inside a parabolic, without a field, finiteness, or sphericality assumption.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Chapter IV, §2, no. 5.
* T. A. Springer, *Linear Algebraic Groups*, second edition (1998), §8.3.

The construction uses the standard-parabolic Bruhat decomposition and the quotient-map and
cell-preimage arguments of `TauCeti.GroupTheory.TitsSystem.Comap`.
-/

public section

open scoped Pointwise

namespace TauCeti.TitsSystem

universe u

variable {G : Type u} [Group G] (T : TitsSystem G) (J : Set T.simple)

private theorem parabolicIntersection_eq_comap :
    (T.subgroupB.subgroupOf (T.standardParabolic J)).subgroupOf
        (T.subgroupN.subgroupOf (T.standardParabolic J)) =
      T.intersection.comap ((T.standardParabolic J).subtype.subgroupComap T.subgroupN) := by
  ext n
  exact Iff.rfl

private instance parabolicIntersectionNormal :
    ((T.subgroupB.subgroupOf (T.standardParabolic J)).subgroupOf
      (T.subgroupN.subgroupOf (T.standardParabolic J))).Normal := by
  rw [parabolicIntersection_eq_comap]
  exact Subgroup.Normal.comap inferInstance _

/-- The injective map from the parabolic Weyl quotient to the ambient Weyl group. -/
private noncomputable def parabolicWeylHom :
    (T.subgroupN.subgroupOf (T.standardParabolic J)) ⧸
        (T.subgroupB.subgroupOf (T.standardParabolic J)).subgroupOf
          (T.subgroupN.subgroupOf (T.standardParabolic J)) →* T.WeylGroup :=
  QuotientGroup.map _ _ ((T.standardParabolic J).subtype.subgroupComap T.subgroupN)
    (T.parabolicIntersection_eq_comap J).le

private theorem parabolicWeylHom_mk (n : T.subgroupN.subgroupOf (T.standardParabolic J)) :
    T.parabolicWeylHom J (QuotientGroup.mk n) =
      QuotientGroup.mk ((T.standardParabolic J).subtype.subgroupComap T.subgroupN n) :=
  QuotientGroup.map_mk _ _ _ _ _

private theorem parabolicWeylHom_injective : Function.Injective (T.parabolicWeylHom J) :=
  TauCeti.QuotientGroup.map_injective_of_eq_comap _ _ (T.parabolicIntersection_eq_comap J)

private theorem range_parabolicWeylHom :
    (T.parabolicWeylHom J).range = Subgroup.closure (Subtype.val '' J) := by
  ext w
  constructor
  · rintro ⟨q, rfl⟩
    obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective q
    rw [T.parabolicWeylHom_mk]
    exact (T.coe_mem_standardParabolic_iff J
      ((T.standardParabolic J).subtype.subgroupComap T.subgroupN n)).mp n.val.property
  · intro hw
    obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective w
    have hn := (T.coe_mem_standardParabolic_iff J n).mpr hw
    exact ⟨QuotientGroup.mk ⟨⟨n, hn⟩, n.property⟩, T.parabolicWeylHom_mk J _⟩

private theorem closure_parabolicSimple :
    Subgroup.closure (T.parabolicWeylHom J ⁻¹' (Subtype.val '' J)) = ⊤ := by
  apply Subgroup.map_injective (T.parabolicWeylHom_injective J)
  rw [MonoidHom.map_closure, Set.image_preimage_eq_of_subset, ← MonoidHom.range_eq_map,
    T.range_parabolicWeylHom]
  intro s hs
  have hmem : s ∈ (T.parabolicWeylHom J).range := by
    rw [T.range_parabolicWeylHom]
    exact Subgroup.subset_closure hs
  exact hmem

private theorem parabolic_preimage_doubleCoset
    (n : T.subgroupN.subgroupOf (T.standardParabolic J)) :
    (T.standardParabolic J).subtype ⁻¹'
        DoubleCoset.doubleCoset ((n : T.standardParabolic J) : G) T.subgroupB T.subgroupB =
      DoubleCoset.doubleCoset (n : T.standardParabolic J)
        (T.subgroupB.subgroupOf (T.standardParabolic J))
        (T.subgroupB.subgroupOf (T.standardParabolic J)) := by
  apply T.preimage_doubleCoset ?_ n.property
  intro b hb
  exact ⟨⟨b, T.subgroupB_le_standardParabolic J hb⟩, 1, ⟨one_mem _, one_mem _⟩,
    mul_one _⟩

/-- The Tits system `(B, N ∩ P_J)` on a standard parabolic. Its simple reflections are
those whose ambient Weyl classes are selected by `J`. -/
noncomputable def parabolicTitsSystem : TitsSystem (T.standardParabolic J) where
  subgroupB := T.subgroupB.subgroupOf (T.standardParabolic J)
  subgroupN := T.subgroupN.subgroupOf (T.standardParabolic J)
  closure_subgroupB_union_subgroupN := by
    refine eq_top_iff.mpr fun z _ ↦ ?_
    obtain ⟨w, hw, hz⟩ := T.mem_standardParabolic_iff.mp z.property
    obtain ⟨n, hn, hz⟩ := T.mem_bruhatCell_iff.mp hz
    have hnP : (n : G) ∈ T.standardParabolic J :=
      (T.coe_mem_standardParabolic_iff J n).mpr (hn ▸ hw)
    obtain ⟨b, hb, b', hb', he⟩ := DoubleCoset.mem_doubleCoset.mp hz
    let bP : T.standardParabolic J := ⟨b, T.subgroupB_le_standardParabolic J hb⟩
    let bP' : T.standardParabolic J := ⟨b', T.subgroupB_le_standardParabolic J hb'⟩
    let nP : T.standardParabolic J := ⟨n, hnP⟩
    have hz : bP * nP * bP' = z := Subtype.ext he.symm
    rw [← hz]
    exact mul_mem (mul_mem (Subgroup.subset_closure (Or.inl hb))
      (Subgroup.subset_closure (Or.inr n.property))) (Subgroup.subset_closure (Or.inl hb'))
  intersection_normal := inferInstance
  simple := T.parabolicWeylHom J ⁻¹' (Subtype.val '' J)
  closure_simple := T.closure_parabolicSimple J
  exists_simpleRep_sq_mem s hs := by
    obtain ⟨r, rfl⟩ := QuotientGroup.mk_surjective s
    refine ⟨r, rfl, ?_⟩
    have hs' : T.parabolicWeylHom J (QuotientGroup.mk r) ∈ T.simple := by
      obtain ⟨s, _, hs⟩ := hs
      exact hs ▸ s.property
    apply (QuotientGroup.eq_one_iff (r * r)).mp
    apply T.parabolicWeylHom_injective J
    simpa only [QuotientGroup.mk_mul, map_mul, map_one] using T.simple_sq_eq_one hs'
  mul_doubleCoset_subset s hs := by
    obtain ⟨r, rfl⟩ := QuotientGroup.mk_surjective s
    refine ⟨r, rfl, fun w ↦ ?_⟩
    have hs' : T.parabolicWeylHom J (QuotientGroup.mk r) ∈ T.simple := by
      obtain ⟨s, _, hs⟩ := hs
      exact hs ▸ s.property
    have hmul := T.bruhatCell_mul_subset_union_of_mem_simple hs'
      (QuotientGroup.mk ((T.standardParabolic J).subtype.subgroupComap T.subgroupN w))
    simp only [parabolicWeylHom_mk, ← QuotientGroup.mk_mul, bruhatCell_mk,
      Subgroup.coe_mul] at hmul
    intro z hz
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp hz
    rw [← T.parabolic_preimage_doubleCoset J r] at ha
    rw [← T.parabolic_preimage_doubleCoset J w] at hb
    have h := hmul (Set.mul_mem_mul ha hb)
    rw [← T.parabolic_preimage_doubleCoset J (r * w),
      ← T.parabolic_preimage_doubleCoset J w]
    exact h
  exists_conj_not_mem s hs := by
    obtain ⟨s₀, hs₀, he⟩ := hs
    obtain ⟨r, hr, b, hb⟩ := T.exists_conj_not_mem _ s₀.property
    have hrP : (r : G) ∈ T.standardParabolic J := by
      apply (T.coe_mem_standardParabolic_iff J r).mpr
      rw [hr]
      exact Subgroup.subset_closure ⟨s₀, hs₀, rfl⟩
    let rP : T.subgroupN.subgroupOf (T.standardParabolic J) := ⟨⟨r, hrP⟩, r.property⟩
    refine ⟨rP, T.parabolicWeylHom_injective J ?_,
      ⟨⟨b, T.subgroupB_le_standardParabolic J b.property⟩, b.property⟩, hb⟩
    exact (T.parabolicWeylHom_mk J rP).trans (hr.trans he)

/-- The distinguished subgroup of the induced Tits system is the original `B`, read inside
`P_J`. -/
@[simp]
theorem parabolicTitsSystem_subgroupB :
    (T.parabolicTitsSystem J).subgroupB =
      T.subgroupB.subgroupOf (T.standardParabolic J) := (rfl)

/-- The subgroup `N` of the induced Tits system is `N ∩ P_J`, read inside `P_J`. -/
@[simp]
theorem parabolicTitsSystem_subgroupN :
    (T.parabolicTitsSystem J).subgroupN =
      T.subgroupN.subgroupOf (T.standardParabolic J) := (rfl)

/-- The Weyl group of the induced Tits system is the subgroup generated by the selected
simple reflections in the ambient Weyl group. -/
noncomputable def parabolicWeylGroupMulEquiv :
    (T.parabolicTitsSystem J).WeylGroup ≃* Subgroup.closure (Subtype.val '' J) :=
  (MonoidHom.ofInjective (T.parabolicWeylHom_injective J)).trans
    (MulEquiv.subgroupCongr (T.range_parabolicWeylHom J))

/-- On a normalizer representative, the Weyl-group identification is the ambient quotient
map. The formula is independent of the representative chosen. -/
@[simp]
theorem coe_parabolicWeylGroupMulEquiv_mk
    (n : (T.parabolicTitsSystem J).subgroupN) :
    (T.parabolicWeylGroupMulEquiv J (QuotientGroup.mk n) : T.WeylGroup) =
      QuotientGroup.mk (⟨((n : T.standardParabolic J) : G), by
        simpa only [parabolicTitsSystem_subgroupN, Subgroup.mem_subgroupOf] using n.property⟩ :
        T.subgroupN) :=
  T.parabolicWeylHom_mk J n

/-- The simple reflections of the induced system correspond exactly to the selection `J`
in the ambient Weyl group. -/
@[simp]
theorem parabolicTitsSystem_simple :
    (T.parabolicTitsSystem J).simple =
      (fun w ↦ (T.parabolicWeylGroupMulEquiv J w : T.WeylGroup)) ⁻¹' (Subtype.val '' J) :=
  (rfl)

/-- Bruhat cells inside the parabolic are precisely the preimages of their ambient cells. -/
@[simp]
theorem parabolicTitsSystem_bruhatCell (w : (T.parabolicTitsSystem J).WeylGroup) :
    (T.parabolicTitsSystem J).bruhatCell w =
      (T.standardParabolic J).subtype ⁻¹'
        T.bruhatCell (T.parabolicWeylGroupMulEquiv J w : T.WeylGroup) := by
  obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective w
  rw [coe_parabolicWeylGroupMulEquiv_mk, bruhatCell_mk, bruhatCell_mk,
    parabolicTitsSystem_subgroupB]
  exact (T.parabolic_preimage_doubleCoset J n).symm

end TauCeti.TitsSystem
