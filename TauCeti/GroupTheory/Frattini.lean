module

public import Mathlib.GroupTheory.Frattini
public import Mathlib.GroupTheory.PGroup
public import TauCeti.GroupTheory.QuotientGroup.MulAut
import Mathlib.GroupTheory.GroupAction.Quotient

/-!
# Automorphisms acting trivially modulo the Frattini subgroup

Assume `IsCoatomic (Subgroup G)`. The Frattini subgroup consists of non-generators
(`frattini_nongenerating`), so a family that agrees with a generating family modulo a subgroup
`N ≤ frattini G` generates `G` again. This file uses that fact to bound the group of automorphisms
of `G` that act trivially modulo `N`.

Fix a family `s : ι → G` generating `G`, with `ι` finite. An automorphism `α` that fixes every class
modulo `N` permutes the families `y : ι → G` with `y i ≡ s i` modulo `N`, of which there are
`Nat.card N ^ Nat.card ι`. Each of these families generates `G`, so an automorphism fixing one of
them is the identity. A group `H` of such automorphisms therefore acts freely on these families,
every orbit has `Nat.card H` elements, and `Nat.card H` divides `Nat.card N ^ Nat.card ι`.

For a finite `p`-group `P` this says that the kernel of `MulAut P →* MulAut (P ⧸ frattini P)` is
a `p`-group. This finite statement is the input to the corresponding statement for a topologically
finitely generated pro-`p` group, whose continuous automorphisms acting trivially on its Frattini
quotient form a pro-`p` group, obtained by passing to the limit over finite quotients.

## Main statements

* `TauCeti.closure_range_eq_top_of_le_frattini`: a family agreeing modulo `N ≤ frattini G` with
  a generating family generates, assuming `IsCoatomic (Subgroup G)`.
* `TauCeti.card_dvd_card_pow_of_le_frattini`: a group of automorphisms acting trivially modulo
  `N ≤ frattini G` has order dividing `Nat.card N ^ Nat.card ι` whenever `G` is generated by a
  family indexed by the finite type `ι` and `IsCoatomic (Subgroup G)` holds.
* `TauCeti.isPGroup_of_le_frattini`: if `G` is finite and `N ≤ frattini G` is a `p`-group, every
  group of automorphisms acting trivially modulo `N` is a `p`-group.
* `IsPGroup.isPGroup_ker_mapQuotient_frattini`: the automorphisms of a finite `p`-group acting
  trivially on its Frattini quotient form a `p`-group.

## References

* D. Gorenstein, *Finite Groups*, Chapter 5, §1.
* B. Huppert, *Endliche Gruppen I*, Kapitel III, §3.
-/

public section

namespace TauCeti

open Subgroup

variable {G : Type*} [Group G] {ι : Type*} {N : Subgroup G}

/-- A family agreeing with a generating family modulo a subgroup of the Frattini subgroup
generates the group, assuming `IsCoatomic (Subgroup G)`. -/
theorem closure_range_eq_top_of_le_frattini [IsCoatomic (Subgroup G)] {s y : ι → G}
    (hs : closure (Set.range s) = ⊤) (hN : N ≤ frattini G)
    (hy : ∀ i, (y i : G ⧸ N) = s i) : closure (Set.range y) = ⊤ := by
  refine frattini_nongenerating (eq_top_iff.mpr ?_)
  rw [← hs, closure_le]
  rintro _ ⟨i, rfl⟩
  rw [← mul_inv_cancel_left (y i) (s i)]
  exact mul_mem_sup (subset_closure ⟨i, rfl⟩) (hN (QuotientGroup.eq.mp (hy i)))

variable {H : Subgroup (MulAut G)}

/-- The families lifting `s` modulo `N`, permuted by every group of automorphisms that fix each
class modulo `N`. -/
private def liftsMod (s : ι → G) (N : Subgroup G) (H : Subgroup (MulAut G))
    (hH : ∀ α ∈ H, ∀ x : G, (α x : G ⧸ N) = x) : SubMulAction H (ι → G) where
  carrier := {y | ∀ i, (y i : G ⧸ N) = s i}
  smul_mem' α y hy i := by
    rw [Pi.smul_apply, Subgroup.smul_def, MulAut.smul_def, hH α α.2, hy i]

private theorem mem_liftsMod {s : ι → G} {hH : ∀ α ∈ H, ∀ x : G, (α x : G ⧸ N) = x}
    {y : ι → G} : y ∈ liftsMod s N H hH ↔ ∀ i, (y i : G ⧸ N) = s i :=
  Iff.rfl

/-- The lifts of `s` modulo `N` are parametrized by the families of elements of `N`. -/
private def liftsModEquiv (s : ι → G) (hH : ∀ α ∈ H, ∀ x : G, (α x : G ⧸ N) = x) :
    liftsMod s N H hH ≃ (ι → N) where
  toFun y i := ⟨(y.1 i)⁻¹ * s i, QuotientGroup.eq.mp (mem_liftsMod.mp y.2 i)⟩
  invFun n := ⟨fun i ↦ s i * (n i : G)⁻¹, mem_liftsMod.mpr fun i ↦ QuotientGroup.eq.mpr (by simp)⟩
  left_inv y := by
    ext i
    simp
  right_inv n := by
    ext i
    simp

/-- **Automorphisms acting trivially modulo a subgroup of the Frattini subgroup.** If `G` is
generated by a family indexed by a finite type `ι`, `N ≤ frattini G`, and
`IsCoatomic (Subgroup G)` holds, then the order of a group of automorphisms of `G` fixing every
class modulo `N` divides `Nat.card N ^ Nat.card ι`. -/
theorem card_dvd_card_pow_of_le_frattini [IsCoatomic (Subgroup G)] [Finite ι] {s : ι → G}
    (hs : closure (Set.range s) = ⊤) (hN : N ≤ frattini G)
    (hH : ∀ α ∈ H, ∀ x : G, (α x : G ⧸ N) = x) :
    Nat.card H ∣ Nat.card N ^ Nat.card ι := by
  -- `H` acts freely on the lifts of `s`: each lift generates, so its stabilizer is trivial.
  have hfree (y : liftsMod s N H hH) : MulAction.stabilizer H y = ⊥ := by
    refine eq_bot_iff.mpr fun α hα ↦ mem_bot.mpr (Subtype.ext (MulEquiv.toMonoidHom_injective ?_))
    refine MonoidHom.eq_of_eqOn_dense
      (closure_range_eq_top_of_le_frattini hs hN (mem_liftsMod.mp y.2)) ?_
    rintro _ ⟨i, rfl⟩
    simpa [Subgroup.smul_def, MulAut.smul_def] using
      congrFun (congrArg Subtype.val (MulAction.mem_stabilizer_iff.mp hα)) i
  have hcard := Nat.card_congr (MulAction.selfEquivOrbitsQuotientProd hfree)
  rw [Nat.card_prod, Nat.card_congr (liftsModEquiv s hH), Nat.card_fun] at hcard
  exact Dvd.intro_left _ hcard.symm

/-- **Automorphisms acting trivially modulo a `p`-subgroup of the Frattini subgroup.** If `G` is
finite and `N ≤ frattini G` is a `p`-group, then every group of automorphisms of `G` fixing each
class modulo `N` is a `p`-group. -/
theorem isPGroup_of_le_frattini [Finite G] {p : ℕ} [hp : Fact p.Prime] (hN : N ≤ frattini G)
    (hNp : IsPGroup p N) (hH : ∀ α ∈ H, ∀ x : G, (α x : G ⧸ N) = x) : IsPGroup p H := by
  obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp hNp
  have hdvd := card_dvd_card_pow_of_le_frattini (s := id) (by simp) hN hH
  rw [hk, ← pow_mul] at hdvd
  obtain ⟨m, -, hm⟩ := (Nat.dvd_prime_pow hp.out).mp hdvd
  exact IsPGroup.of_card hm

/-- **The automorphisms of a finite `p`-group acting trivially on its Frattini quotient form a
`p`-group.** -/
theorem _root_.IsPGroup.isPGroup_ker_mapQuotient_frattini [Finite G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) : IsPGroup p (MulAut.mapQuotient (frattini G)).ker :=
  isPGroup_of_le_frattini le_rfl (hG.to_subgroup _) fun _ hα ↦
    (MulAut.mem_ker_mapQuotient_iff _).mp hα

end TauCeti
