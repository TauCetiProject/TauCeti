module

public import TauCeti.GroupTheory.Presentation.PowerConjugate.Basic

/-!
# Bounded normal forms from power-conjugate relations

For generators `x₀, …, xₙ₋₁` with triangular power-conjugate relations and positive power
bounds `mᵢ`, every element of the generated subgroup has an expression
`xₙ₋₁ ^ eₙ₋₁ * … * x₀ ^ e₀`, with `eᵢ < mᵢ`. The descending order agrees with the cyclic
extension convention `h * x ^ k` of `Subgroup.mem_sup_zpowers_iff_exists_mul_pow`.

`powerConjugateNormalForm` evaluates these bounded exponent tuples in the actual generated
subgroup. Its surjectivity turns universal checks on that subgroup into finite checks on
tuples, for example when certifying conjugacy coverage in a Sylow subgroup. No consistency
or uniqueness of the expressions is assumed. The tuples give unique normal forms exactly
when the subgroup order attains the product of the power bounds.

The ambient group need not be finite. In a presented group, the relations must be proved
in that presented group; their validity in a finite permutation image alone does not suffice.

## References

* D. F. Holt, B. Eick and E. A. O'Brien, *Handbook of Computational Group Theory*,
  Chapter 8, for power-conjugate presentations and collection.
-/

public section

namespace TauCeti

variable {G : Type*} [Group G]

/-- Evaluate bounded exponents in descending generator order, as an element of the subgroup
generated by `x`. This map is defined even without power-conjugate relations; those relations
ensure that it is surjective. -/
def powerConjugateNormalForm {n : ℕ} (x : Fin n → G) (m : Fin n → ℕ)
    (e : ∀ i, Fin (m i)) : Subgroup.closure (Set.range x) :=
  ⟨(List.ofFn fun i ↦ x i ^ (e i : ℕ)).reverse.prod, by
    apply Subgroup.list_prod_mem
    intro g hg
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp (List.mem_reverse.mp hg)
    exact Subgroup.pow_mem _ (Subgroup.subset_closure (Set.mem_range_self i)) _⟩

/-- The underlying element is the product of the bounded powers in descending order. -/
@[simp]
theorem coe_powerConjugateNormalForm {n : ℕ} (x : Fin n → G) (m : Fin n → ℕ)
    (e : ∀ i, Fin (m i)) :
    (powerConjugateNormalForm x m e : G) =
      (List.ofFn fun i ↦ x i ^ (e i : ℕ)).reverse.prod := (rfl)

/-- Separate the power of the first generator from the normal form on the remaining generators.
The first generator occurs on the right. -/
theorem coe_powerConjugateNormalForm_succ {n : ℕ} (x : Fin (n + 1) → G)
    (m : Fin (n + 1) → ℕ) (e : ∀ i, Fin (m i)) :
    (powerConjugateNormalForm x m e : G) =
      (powerConjugateNormalForm (fun i ↦ x i.succ) (fun i ↦ m i.succ)
        (fun i ↦ e i.succ) : G) * x 0 ^ (e 0 : ℕ) := by
  simp [List.ofFn_succ]

/-- **Existence of bounded power-conjugate normal forms.** Positive triangular power bounds and
one-sided conjugation relations imply that every element of the generated subgroup is the
descending product of powers with the given exponent bounds. No uniqueness is assumed. -/
theorem surjective_powerConjugateNormalForm {n : ℕ} (x : Fin n → G)
    (m : Fin n → ℕ) (hm : ∀ i, 0 < m i)
    (hpow : ∀ i : Fin n, x i ^ m i ∈ generatorSuffix x ((i : ℕ) + 1))
    (hconj : ∀ i j : Fin n, i < j →
      x i * x j * (x i)⁻¹ ∈ generatorSuffix x ((i : ℕ) + 1)) :
    Function.Surjective (powerConjugateNormalForm x m) := by
  induction n with
  | zero =>
    intro g
    refine ⟨(fun i ↦ i.elim0), Subtype.ext ?_⟩
    have hg : (g : G) = 1 := by simpa using g.property
    simp [hg]
  | succ n ih =>
    have hpow' (i : Fin n) :
        x i.succ ^ m i.succ ∈ generatorSuffix (fun j ↦ x j.succ) ((i : ℕ) + 1) := by
      simpa only [← generatorSuffix_succ, Fin.val_succ] using hpow i.succ
    have hconj' (i j : Fin n) (hij : i < j) :
        x i.succ * x j.succ * (x i.succ)⁻¹ ∈
          generatorSuffix (fun j ↦ x j.succ) ((i : ℕ) + 1) := by
      simpa only [← generatorSuffix_succ, Fin.val_succ] using
        hconj i.succ j.succ (by simpa using hij)
    have htail := ih (fun i ↦ x i.succ) (fun i ↦ m i.succ) (fun i ↦ hm i.succ)
      hpow' hconj'
    have heq : generatorSuffix x 1 = Subgroup.closure (Set.range (fun i : Fin n ↦ x i.succ)) := by
      rw [generatorSuffix_succ, generatorSuffix_zero]
    have : Finite (generatorSuffix x 1) := heq ▸
      finite_closure_of_power_conjugate _ _ (fun i ↦ hm i.succ) hpow' hconj'
    -- Finiteness of the suffix turns the one-sided conjugation relations into normalization.
    have hnorm : x 0 ∈ Subgroup.normalizer (generatorSuffix x 1) := by
      apply mem_normalizer_generatorSuffix
      intro j hj
      simpa using hconj 0 j (by
        simp only [Fin.lt_def, Fin.val_zero]
        omega)
    intro g
    have hg : (g : G) ∈ generatorSuffix x 1 ⊔ Subgroup.zpowers (x 0) :=
      closure_range_eq_generatorSuffix_sup_zpowers x ▸ g.property
    obtain ⟨h, k, hk⟩ :=
      ((generatorSuffix x 1).mem_sup_zpowers_iff_exists_mul_pow (hm 0) hnorm (hpow 0)).mp hg
    obtain ⟨e, he⟩ := htail ⟨h, heq ▸ h.property⟩
    refine ⟨Fin.cons k e, Subtype.ext ?_⟩
    rw [coe_powerConjugateNormalForm_succ]
    simpa only [Fin.cons_zero, Fin.cons_succ, he] using hk

/-- Membership in the generated subgroup is equivalent to the existence of a bounded
descending power expression. This form supports proofs about elements given in the ambient
group, without constructing a subgroup element first. -/
theorem mem_closure_iff_exists_powerConjugateNormalForm {n : ℕ} (x : Fin n → G)
    (m : Fin n → ℕ) (hm : ∀ i, 0 < m i)
    (hpow : ∀ i : Fin n, x i ^ m i ∈ generatorSuffix x ((i : ℕ) + 1))
    (hconj : ∀ i j : Fin n, i < j →
      x i * x j * (x i)⁻¹ ∈ generatorSuffix x ((i : ℕ) + 1)) {g : G} :
    g ∈ Subgroup.closure (Set.range x) ↔
      ∃ e : ∀ i, Fin (m i), (powerConjugateNormalForm x m e : G) = g := by
  constructor
  · intro hg
    obtain ⟨e, he⟩ := surjective_powerConjugateNormalForm x m hm hpow hconj ⟨g, hg⟩
    exact ⟨e, congrArg Subtype.val he⟩
  · rintro ⟨e, rfl⟩
    exact (powerConjugateNormalForm x m e).property

/-- **Uniqueness of bounded normal forms is equivalent to attaining the order bound.**
Under the triangular power-conjugate relations, distinct exponent tuples represent distinct
elements exactly when the generated subgroup has order equal to the product of the bounds. -/
theorem injective_powerConjugateNormalForm_iff {n : ℕ} (x : Fin n → G)
    (m : Fin n → ℕ) (hm : ∀ i, 0 < m i)
    (hpow : ∀ i : Fin n, x i ^ m i ∈ generatorSuffix x ((i : ℕ) + 1))
    (hconj : ∀ i j : Fin n, i < j →
      x i * x j * (x i)⁻¹ ∈ generatorSuffix x ((i : ℕ) + 1)) :
    Function.Injective (powerConjugateNormalForm x m) ↔
      Nat.card (Subgroup.closure (Set.range x)) = ∏ i, m i := by
  have hsurj := surjective_powerConjugateNormalForm x m hm hpow hconj
  have hc : Nat.card (∀ i, Fin (m i)) = ∏ i, m i := by simp
  constructor
  · intro hinj
    exact (Nat.card_eq_of_bijective _ ⟨hinj, hsurj⟩).symm.trans hc
  · intro hcard
    exact (hsurj.bijective_of_nat_card_le (by rw [hc, hcard])).1

end TauCeti

namespace MonoidHom

open TauCeti

variable {G H : Type*} [Group G] [Group H]

/-- Evaluation of normal forms commutes with a group homomorphism. In particular, a normal-form
identity checked in a presented group remains valid in each of its images. -/
theorem map_powerConjugateNormalForm {n : ℕ} (f : G →* H) (x : Fin n → G)
    (m : Fin n → ℕ) (e : ∀ i, Fin (m i)) :
    f (powerConjugateNormalForm x m e : G) =
      (powerConjugateNormalForm (f ∘ x) m e : H) := by
  simp only [coe_powerConjugateNormalForm, ← List.prod_hom, List.map_reverse, List.map_ofFn,
    Function.comp_def, map_pow]

end MonoidHom
