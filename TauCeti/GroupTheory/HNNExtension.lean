module

public import Mathlib.GroupTheory.HNNExtension
public import TauCeti.GroupTheory.ProperPower
public import TauCeti.GroupTheory.CSA

/-!
# Commuting with the stable letter of an HNN extension

In the HNN extension `⟨G, t | t a t⁻¹ = φ a, a ∈ A⟩`, an element `g` of the base group commutes
with the stable letter `t` exactly when `g ∈ A` and `φ g = g` (`HNNExtension.commute_of_t_iff`).
One direction is the defining relation; the other is Britton's lemma
(`HNNExtension.ReducedWord.toList_eq_nil_of_mem_of_range`) applied to the reduced word
`g t g⁻¹ t⁻¹`.

Along the identity of `A`, the HNN extension is isomorphic to the amalgamated product
`G ∗_A (A × ℤ)`, which extends `A` by a new central letter. There `g` commutes with `t` exactly
when `g ∈ A`. Hence if the extension is commutative transitive, `A` contains the centralizer of
each of its nonidentity elements (`HNNExtension.centralizer_le_of_isCommTransitive`): the
subgroup being extended must be closed under taking centralizers. For a torsion-free group and
the cyclic subgroup generated by a nonidentity proper power `y ^ n`, this fails, because `y`
commutes with `y ^ n` without lying in `zpowers (y ^ n)`
(`HNNExtension.not_isCommTransitive_zpowers_of_isProperPower`). This is why an extension of a
centralizer must use the full centralizer `C_G(u)` rather than `zpowers u`.

## Main results

* `HNNExtension.commute_of_t_iff`: `of g` commutes with `t` iff `g ∈ A` and `φ g = g`.
* `HNNExtension.commute_of_t_iff_mem`: along the identity of `A`, `of g` commutes with `t` iff
  `g ∈ A`.
* `HNNExtension.centralizer_le_of_isCommTransitive`: if the HNN extension along the identity of
  `A` is commutative transitive, then `centralizer {c} ≤ A` for every nonidentity `c ∈ A`.
* `HNNExtension.not_isCommTransitive_zpowers_of_isProperPower`: over a torsion-free group, the HNN
  extension along the identity of the cyclic subgroup generated by a nonidentity proper power is
  not commutative transitive.

## References

* R. C. Lyndon, P. E. Schupp, *Combinatorial Group Theory*, Springer (1977), Chapter IV, §2
  (Britton's lemma).
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §2.5 (extensions of centralizers use the full centralizer).
-/

public section

open Subgroup

namespace HNNExtension

open NormalWord

variable {G : Type*} [Group G] {A B : Subgroup G} {φ : A ≃* B}

/-- An element of the base group commutes with the stable letter `t` of an HNN extension exactly
when it lies in `A` and is fixed by `φ`. -/
theorem commute_of_t_iff {g : G} :
    Commute (of g : HNNExtension G A B φ) t ↔ ∃ hg : g ∈ A, (φ ⟨g, hg⟩ : G) = g := by
  refine ⟨fun h => ?_, fun ⟨hg, hφ⟩ => ?_⟩
  · by_cases hg : g ∈ A
    · refine ⟨hg, of_injective (φ := φ) (mul_right_cancel (b := t) ?_)⟩
      rw [← t_mul_of]
      exact h.eq.symm
    · -- Otherwise `g t g⁻¹ t⁻¹` is a reduced word, and Britton's lemma shows it is not `1`.
      let w : ReducedWord G A B :=
        { head := g
          toList := [(1, g⁻¹), (-1, 1)]
          chain := by simp [hg] }
      have hw : w.prod φ = 1 := by
        simp [ReducedWord.prod, w, ← mul_assoc, h.eq]
      simpa [w] using ReducedWord.toList_eq_nil_of_mem_of_range φ w (hw ▸ one_mem _)
  · have h := t_mul_of (φ := φ) ⟨g, hg⟩
    rw [hφ] at h
    exact h.symm

/-- Along the identity of `A`, an element of the base group commutes with the stable letter `t`
exactly when it lies in `A`. -/
@[simp]
theorem commute_of_t_iff_mem {g : G} :
    Commute (of g : HNNExtension G A A (MulEquiv.refl A)) t ↔ g ∈ A := by
  simp [commute_of_t_iff]

/-- If the HNN extension of `G` along the identity of `A`, a presentation of the amalgamated
product `G ∗_A (A × ℤ)`, is commutative transitive, then `A` contains the centralizer of each of its
nonidentity elements. -/
theorem centralizer_le_of_isCommTransitive
    (h : Group.IsCommTransitive (HNNExtension G A A (MulEquiv.refl A))) {c : G} (hc : c ∈ A)
    (hc1 : c ≠ 1) : centralizer {c} ≤ A := fun g hg => by
  rw [mem_centralizer_singleton_iff] at hg
  rw [← commute_of_t_iff_mem]
  refine (Group.isCommTransitive_iff _).1 h _ (of c) _ ?_ (Commute.map hg of)
    (commute_of_t_iff_mem.2 hc)
  rwa [Ne, ← map_one of, (of_injective (φ := MulEquiv.refl A)).eq_iff]

/-- Over a torsion-free group, extending the cyclic subgroup generated by a nonidentity proper
power `u` by a new central letter does not give a commutative transitive group: a root of `u`
commutes with `u`, and `u` with the new letter, but the root does not commute with the new letter.
-/
theorem not_isCommTransitive_zpowers_of_isProperPower [IsMulTorsionFree G] {u : G}
    (hu : Group.IsProperPower u) (hu1 : u ≠ 1) :
    ¬ Group.IsCommTransitive
      (HNNExtension G (zpowers u) (zpowers u) (MulEquiv.refl (zpowers u))) := fun h =>
  Group.not_isProperPower_of_zpowers_eq_centralizer hu1
    (le_antisymm (zpowers_le.2 (mem_centralizer_singleton_iff.2 rfl))
      (centralizer_le_of_isCommTransitive h (mem_zpowers _) hu1)) hu

end HNNExtension
