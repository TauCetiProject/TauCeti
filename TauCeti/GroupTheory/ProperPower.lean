module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Subgroup
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import TauCeti.Algebra.Group.ProperPower
import TauCeti.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Proper powers, cyclic subgroups and centralizers

A cyclic subgroup is generated by each of its elements that is not a proper power
(`Subgroup.zpowers_eq_of_not_isProperPower`). An element of infinite order that generates a
centralizer is not a proper power (`Monoid.not_isProperPower_of_zpowers_eq_centralizer`); in
particular the generator of `Multiplicative ℤ` is not one (`Monoid.not_isProperPower_ofAdd_one`).

The predicate `Monoid.IsProperPower` and its elementary API are in
`TauCeti.Algebra.Group.ProperPower`.
-/

public section

section Group

variable {G : Type*} [Group G]

open Monoid

/-- A cyclic subgroup is generated by each of its elements that is not a proper power. -/
theorem Subgroup.zpowers_eq_of_not_isProperPower {S : Subgroup G}
    [IsCyclic S] {u : G} (hu : u ∈ S) (hp : ¬IsProperPower u) : Subgroup.zpowers u = S := by
  obtain ⟨t, rfl⟩ := S.isCyclic_iff_exists_zpowers_eq.1 ‹_›
  obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.1 hu
  obtain rfl | rfl := Int.natAbs_eq_iff.1 (natAbs_eq_one_of_not_isProperPower_zpow hp) <;> simp

namespace Monoid

/-- An element of infinite order generating the centralizer of some element is not a proper
power. In a torsion-free group, every nontrivial element has infinite order. -/
theorem not_isProperPower_of_zpowers_eq_centralizer {x r : G} (hr : ¬IsOfFinOrder r)
    (hc : Subgroup.zpowers r = Subgroup.centralizer {x}) : ¬IsProperPower r := by
  rw [isProperPower_iff]
  rintro ⟨s, n, hn, rfl⟩
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1
    (hc ▸ Subgroup.mem_centralizer_singleton_iff.2 rfl : x ∈ _)
  have hs : s ∈ Subgroup.zpowers (s ^ n) :=
    hc ▸ Subgroup.mem_centralizer_singleton_iff.2 ((Commute.self_pow s n).zpow_right m).eq
  have hn1 : n = 1 := by
    simpa only [orderOf_eq_zero fun h => hr h.pow, Nat.gcd_zero_right] using
      mem_zpowers_pow_iff.mp hs
  omega

end Monoid

end Group

namespace Monoid

/-- The generator of the additive integers, viewed multiplicatively, is not a proper power: it has
infinite order and generates the centralizer of the identity. -/
@[simp] theorem not_isProperPower_ofAdd_one :
    ¬IsProperPower (Multiplicative.ofAdd (1 : ℤ)) := by
  refine not_isProperPower_of_zpowers_eq_centralizer (x := 1) Int.not_isOfFinOrder_ofAdd_one ?_
  ext y
  simp only [Subgroup.mem_centralizer_singleton_iff, Commute.one_right, iff_true]
  exact Int.mem_zpowers_ofAdd_one y

end Monoid
