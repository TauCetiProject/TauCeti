module

public import Mathlib.Data.ZMod.Defs
public import Mathlib.GroupTheory.Abelianization.Defs
import Mathlib.Data.ZMod.Basic

/-!
# Cyclic abelianizations

If the abelianization of a group `G` is generated by the class of a single element `t` whose
`n`-th power is trivial there, then a character `χ : G → ℤ/n` with `χ t = 1` induces an
isomorphism `Gᵃᵇ ≅ ℤ/n` (`Group.Abelianization.lift_bijective_of_generator`). This is how
abelianizations of presented groups such as `SL(2, ℤ)` are computed: a presentation bounds the
abelianization from above by a cyclic group, and a character realizes the bound.
-/

public section

namespace Group.Abelianization

/-- **A cyclic abelianization is detected by a character**: if the class of `t` generates the
abelianization of `G` and has order dividing `n`, a character `χ : G → ℤ/n` with `χ t = 1`
induces an isomorphism on the abelianization. -/
theorem lift_bijective_of_generator {G : Type*} [Group G] {n : ℕ} [NeZero n]
    (χ : G →* Multiplicative (ZMod n)) {t : G} (hχ : χ t = Multiplicative.ofAdd 1)
    (ht : of t ^ n = 1) (hgen : ∀ x, x ∈ Subgroup.zpowers (of t)) :
    Function.Bijective (lift χ) := by
  constructor
  · refine (injective_iff_map_eq_one _).2 fun x hx ↦ ?_
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hgen x)
    simp only [map_zpow, lift_apply_of, hχ, ← ofAdd_zsmul, zsmul_one, ofAdd_eq_one,
      ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
    obtain ⟨m, rfl⟩ := hx
    rw [zpow_mul, zpow_natCast, ht, one_zpow]
  · intro y
    refine ⟨of t ^ (Multiplicative.toAdd y).val, ?_⟩
    rw [map_pow, lift_apply_of, hχ, ← ofAdd_nsmul, nsmul_one, ZMod.natCast_zmod_val, ofAdd_toAdd]

end Group.Abelianization
