module

public import TauCeti.GroupTheory.GroupExtension.FactorSetOfSection
public import TauCeti.GroupTheory.SpecificGroups.Cyclic.Log

/-!
# Power sections for extensions with finite cyclic quotient

Let `1 → M → E → G → 1` be a group extension whose quotient `G` is finite cyclic, generated by
`g` of order `n`, and let `e : E` be any lift of `g` (`S.rightHom e = g`). Then `e ^ n` lies in
the kernel `S.inl.range` (`GroupExtension.pow_orderOf_mem_range_inl`), so `S.inl a = e ^ n` for a
unique `a : M`.

The **power section** `GroupExtension.cyclicPowerSection` sends `gⁱ ↦ eⁱ` for `0 ≤ i < n`, using
`TauCeti.cyclicLog`. It is normalized (`σ 1 = 1`), and its bare factor set is literally the
multiplicative carry cocycle of `a`: `a` when `i + j ≥ n` and `1` otherwise
(`TauCeti.GroupExtension.factorSetFun_cyclicPowerSection`).

No abelian-kernel or cohomological assumptions are required here; see
`TauCeti.GroupTheory.GroupExtension.Cyclic.Cohomology` for the resulting description of the
extension class in `H²(G, M)`.

## Main definitions

* `GroupExtension.cyclicPowerSection`: the normalized power section `gⁱ ↦ eⁱ` (`0 ≤ i < orderOf g`).

## Main results

* `GroupExtension.cyclicPowerSection_apply`, `GroupExtension.cyclicPowerSection_one`,
  `GroupExtension.cyclicPowerSection_pow`: evaluation of the power section.
* `TauCeti.GroupExtension.factorSetFun_cyclicPowerSection`: the factor set of the power section is
  the carry cocycle of `a`, where `S.inl a = e ^ orderOf g`.

## References

* K. S. Brown, *Cohomology of Groups*, Graduate Texts in Mathematics 87, Springer (1982),
  Chapter IV, §3.
* D. J. S. Robinson, *A Course in the Theory of Groups*, 2nd ed., Graduate Texts in Mathematics
  80, Springer (1996), §11.1 (extensions with cyclic quotient).
-/

public section

open TauCeti (cyclicLog pow_cyclicLog cyclicLog_lt cyclicLog_one cyclicLog_pow cyclicLog_mul)

namespace GroupExtension

section PowerSection

variable {M E G : Type*} [Group M] [Group E] [Group G] [Finite G]
  (S : GroupExtension M E G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)

/-- **The power section of an extension with finite cyclic quotient.** Given a lift `e : E` of a
generator `g` of `G`, send each `x = gⁱ` (`0 ≤ i < orderOf g`) to `eⁱ`. -/
noncomputable def cyclicPowerSection {e : E} (he : S.rightHom e = g) : S.Section where
  toFun x := e ^ cyclicLog g hg x
  rightInverse_rightHom x := by
    rw [map_pow, he, pow_cyclicLog]

/-- Evaluating the power section at `x` yields `e ^ cyclicLog g hg x`. -/
@[simp]
theorem cyclicPowerSection_apply {e : E} (he : S.rightHom e = g) (x : G) :
    S.cyclicPowerSection g hg he x = e ^ cyclicLog g hg x :=
  (rfl)

/-- The power section is normalized: it sends `1` to `1`. -/
theorem cyclicPowerSection_one {e : E} (he : S.rightHom e = g) :
    S.cyclicPowerSection g hg he 1 = 1 := by
  simp

/-- Evaluating the power section at `g ^ i` yields `e ^ (i % orderOf g)`. -/
theorem cyclicPowerSection_pow {e : E} (he : S.rightHom e = g) (i : ℕ) :
    S.cyclicPowerSection g hg he (g ^ i) = e ^ (i % orderOf g) := by
  rw [cyclicPowerSection_apply, cyclicLog_pow]

end PowerSection

end GroupExtension

namespace TauCeti.GroupExtension

section FactorSetFun

variable {M E G : Type*} [Group M] [Group E] [Group G] [Finite G]
  {S : GroupExtension M E G} {g : G} (hg : ∀ x, x ∈ Subgroup.zpowers g)

/-- **The factor set of the power section is the multiplicative carry cocycle.** If `e` lifts `g`
and `S.inl a = e ^ orderOf g`, then the bare factor set of `S.cyclicPowerSection g hg he` takes
the value `a` when the exponents of `x` and `y` carry past `orderOf g`, and `1` otherwise. -/
theorem factorSetFun_cyclicPowerSection {e : E} (he : S.rightHom e = g) {a : M}
    (ha : S.inl a = e ^ orderOf g) (x y : G) :
    factorSetFun (S.cyclicPowerSection g hg he) (x, y) =
      if orderOf g ≤ cyclicLog g hg x + cyclicLog g hg y then a else 1 := by
  apply S.inl_injective
  rw [inl_factorSetFun]
  simp only [GroupExtension.cyclicPowerSection_apply, cyclicLog_mul, ← pow_add]
  have hx := cyclicLog_lt g hg x
  have hy := cyclicLog_lt g hg y
  split_ifs with h
  · have hpow : e ^ (cyclicLog g hg x + cyclicLog g hg y) =
        e ^ orderOf g * e ^ (cyclicLog g hg x + cyclicLog g hg y - orderOf g) := by
      rw [← pow_add, Nat.add_sub_of_le h]
    rw [Nat.mod_eq_sub_mod h, Nat.mod_eq_of_lt (by omega), hpow, mul_inv_cancel_right, ha]
  · rw [Nat.mod_eq_of_lt (by omega), mul_inv_cancel, map_one]

end FactorSetFun

end TauCeti.GroupExtension
