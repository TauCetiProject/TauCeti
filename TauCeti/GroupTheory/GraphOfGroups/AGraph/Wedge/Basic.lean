module

public import TauCeti.GroupTheory.GraphOfGroups.AGraph.Basic
public import TauCeti.GroupTheory.GraphOfGroups.NormalForm

/-!
# The wedge of a family of closed paths of a graph of groups

Let `𝔸` be a graph of groups and `p` a family of closed alternating `𝔸`-paths
`g₀, e₁, g₁, …, e_k, g_k` at a vertex `v₀`, for instance one path for each element of a finite
subset `S` of `π₁(𝔸, v₀)`. The wedge of `p`, the `S`-wedge of Kapovich, Weidmann and Myasnikov, is
the `𝔸`-graph with a base vertex `u₀` of type `v₀`, whose vertex group is the subgroup `K ≤ A_{v₀}`
generated by the paths of length zero, and, for every path of length `k ≥ 1`, a circle through `u₀`
subdivided into `k` edges, of types `e₁, …, e_k`, whose labels read the path around the circle; a
path of length one gives a loop at `u₀`. The other vertices have trivial vertex groups.

The wedge represents the subgroup generated by the classes of the paths. It is the first term of
the sequences of folds which compute the splitting induced on a finitely generated subgroup of
`π₁(𝔸, v₀)`; its complexity, which bounds the complexity of the folded graph at the end of such a
sequence when the edge groups are trivial, is computed in
`TauCeti.GroupTheory.GraphOfGroups.AGraph.Wedge.Complexity`, and its circles, with their types and
labels, are described in `TauCeti.GroupTheory.GraphOfGroups.AGraph.Wedge.Circle`.

The construction and its theorems do not require the paths to be reduced. Reducing the paths does
not change the represented subgroup, but it can change the wedge and its complexity: the closed path
`1, e, 1, e⁻¹, 1` gives a circle with two edges and complexity one, while its reduction `1` gives no
circle and complexity zero.

## Main definitions

* `TauCeti.GraphOfGroups.AGraph.wedgeGroup`: the subgroup `K` generated by the paths of length zero.
* `TauCeti.GraphOfGroups.AGraph.wedge`: the wedge of a family of closed alternating paths.

## Main results

* `TauCeti.GraphOfGroups.AGraph.isFinite_wedge`: the wedge is a finite `𝔸`-graph when finitely
  many paths have positive length and its base vertex group is finitely generated, for instance for
  a finite family.
* `TauCeti.GraphOfGroups.AGraph.subgroup_wedge`: the wedge represents the subgroup generated by the
  classes of the paths.
* `TauCeti.GraphOfGroups.AGraph.card_geomEdge_wedge`: the number of edges of the wedge is the sum of
  the lengths of the paths.

## References

* I. Kapovich, R. Weidmann, A. Myasnikov, *Foldings, graphs of groups and the membership problem*,
  Internat. J. Algebra Comput. 15 (2005), §5, Definition 5.1 and Lemma 5.3.
-/

public section

universe u v w x u'

namespace TauCeti

namespace GraphOfGroups

variable {Γ : SerreGraph.{u, v}} {𝔸 : GraphOfGroups.{u, v, w, x} Γ}

/-! ### Paths indexed from the front -/

variable (𝔸) in
/-- An alternating `𝔸`-path `g₀, e₀, g₁, e₁, …, g_n, e_n, h` from `x` to `y` with `n + 1` darts,
indexed from the front. Its vertices are `x = c₀, c₁, …, c_n` followed by `y`, where
`c = Fin.cons x vt`; the dart `e_j` runs from `c_j` to `c_{j+1}` for `j < n`, and the last dart
`e_n` from `c_n` to `y`. -/
private structure IndexedPath (x y : Γ.V) (n : ℕ) where
  /-- The vertices `c_1, …, c_n` reached by the first `n` darts. -/
  vt : Fin n → Γ.V
  /-- The first `n` darts. -/
  dt : ∀ j : Fin n,
    (Fin.cons x vt : Fin (n + 1) → Γ.V) j.castSucc ⟶ (Fin.cons x vt : Fin (n + 1) → Γ.V) j.succ
  /-- The vertex group elements before the first `n` darts. -/
  lab : ∀ j : Fin n, 𝔸.vertexGroup ((Fin.cons x vt : Fin (n + 1) → Γ.V) j.castSucc)
  /-- The last dart. -/
  lastDart : (Fin.cons x vt : Fin (n + 1) → Γ.V) (Fin.last n) ⟶ y
  /-- The vertex group element before the last dart. -/
  lastLab : 𝔸.vertexGroup ((Fin.cons x vt : Fin (n + 1) → Γ.V) (Fin.last n))
  /-- The vertex group element after the last dart. -/
  endLab : 𝔸.vertexGroup y

namespace IndexedPath

variable {x y z : Γ.V} {n : ℕ}

/-- The initial segments `g₀, e₀, …, g_{k-1}, e_{k-1}` of an indexed path, from `x` to `c_k`. -/
private def pre (t : IndexedPath 𝔸 x y n) :
    ∀ k : Fin (n + 1), 𝔸.Path ⟨x⟩ ⟨(Fin.cons x t.vt : Fin (n + 1) → Γ.V) k⟩ :=
  Fin.induction (motive := fun k => 𝔸.Path ⟨x⟩ ⟨(Fin.cons x t.vt : Fin (n + 1) → Γ.V) k⟩)
    .nil fun j p => (p.cons (Letter.vertex (t.lab j))).cons (Letter.dart (t.dt j))

/-- The initial segment of length `0` is empty. -/
private theorem pre_zero (t : IndexedPath 𝔸 x y n) : t.pre 0 = .nil :=
  rfl

/-- The initial segment of length `j + 1` is that of length `j` followed by `g_j, e_j`. -/
private theorem pre_succ (t : IndexedPath 𝔸 x y n) (j : Fin n) :
    t.pre j.succ =
      ((t.pre j.castSucc).cons (Letter.vertex (t.lab j))).cons (Letter.dart (t.dt j)) :=
  rfl

/-- The `𝔸`-path spelled by an indexed path. -/
private def toPath (t : IndexedPath 𝔸 x y n) : 𝔸.Path ⟨x⟩ ⟨y⟩ :=
  (((t.pre (Fin.last n)).cons (Letter.vertex t.lastLab)).cons (Letter.dart t.lastDart)).cons
    (Letter.vertex t.endLab)

/-- The indexed path `g, e, h` with a single dart. -/
private def single (g : 𝔸.vertexGroup x) (e : x ⟶ y) (h : 𝔸.vertexGroup y) :
    IndexedPath 𝔸 x y 0 where
  vt := Fin.elim0
  dt j := j.elim0
  lab j := j.elim0
  lastDart := e
  lastLab := g
  endLab := h

/-- Prepending a vertex group element `g` and a dart `e` to an indexed path. -/
private def step (g : 𝔸.vertexGroup x) (e : x ⟶ z) (t : IndexedPath 𝔸 z y n) :
    IndexedPath 𝔸 x y (n + 1) where
  vt := Fin.cons z t.vt
  dt := Fin.cons e t.dt
  lab := Fin.cons g t.lab
  lastDart := t.lastDart
  lastLab := t.lastLab
  endLab := t.endLab

/-- The indexed path `g, e, h` spells `g e h`. -/
private theorem toPath_single (g : 𝔸.vertexGroup x) (e : x ⟶ y) (h : 𝔸.vertexGroup y) :
    (single g e h).toPath = ((Path.ofVertex g).comp (Path.ofDart e)).comp (Path.ofVertex h) := by
  rw [Path.comp_ofDart, Path.comp_ofVertex, Path.ofVertex_eq_nil_cons]
  rfl

/-- The initial segments of `step g e t` are `g e` followed by those of `t`. -/
private theorem pre_step_succ (g : 𝔸.vertexGroup x) (e : x ⟶ z) (t : IndexedPath 𝔸 z y n)
    (k : Fin (n + 1)) :
    (step g e t).pre k.succ = ((Path.ofVertex g).comp (Path.ofDart e)).comp (t.pre k) := by
  induction k using Fin.induction with
  | zero =>
    rw [Path.comp_ofDart, Path.ofVertex_eq_nil_cons]
    rfl
  | succ k ih =>
    rw [pre_succ, pre_succ t, Quiver.Path.comp_cons, Quiver.Path.comp_cons, ← ih]
    -- The two sides differ by the indices `k.succ.castSucc` and `k.castSucc.succ`, and by the
    -- entries of `Fin.cons` at a successor; these agree by definition.
    rfl

/-- The path spelled by `step g e t` is `g e` followed by the path spelled by `t`. -/
private theorem toPath_step (g : 𝔸.vertexGroup x) (e : x ⟶ z) (t : IndexedPath 𝔸 z y n) :
    (step g e t).toPath = ((Path.ofVertex g).comp (Path.ofDart e)).comp t.toPath :=
  congrArg (fun p => ((p.cons (Letter.vertex t.lastLab)).cons (Letter.dart t.lastDart)).cons
    (Letter.vertex t.endLab)) (pre_step_succ g e t (Fin.last n))

/-- Prepending an alternating path `p` from `x` to `z`, without its last element, to an indexed
path from `z` to `y`. -/
private def prepend : ∀ {z : Γ.V} {n : ℕ}, 𝔸.AlternatingPath x z → IndexedPath 𝔸 z y n →
    Σ n', IndexedPath 𝔸 x y n'
  | _, n, .single _, t => ⟨n, t⟩
  | _, _, .cons p e _, t => prepend p (step p.last e t)

/-- Prepending an alternating path of length `k` adds `k` darts. -/
private theorem prepend_fst (p : 𝔸.AlternatingPath x z) (t : IndexedPath 𝔸 z y n) :
    (prepend p t).1 = n + p.length := by
  induction p generalizing n with
  | single g => rw [prepend, AlternatingPath.length_single, add_zero]
  | cons p e g ih =>
    rw [prepend, ih, AlternatingPath.length_cons]
    omega

/-- The path spelled by `prepend p t` is `p`, without its last element, followed by `t`. -/
private theorem toPath_prepend_homotopic (p : 𝔸.AlternatingPath x z) (t : IndexedPath 𝔸 z y n) :
    Path.Homotopic (prepend p t).2.toPath ((p.setLast 1).toPath.comp t.toPath) := by
  induction p generalizing n with
  | single g =>
    simpa only [prepend, AlternatingPath.setLast_single, AlternatingPath.toPath_single,
      Quiver.Path.nil_comp] using (Path.Homotopic.ofVertex_one.comp_right t.toPath).symm
  | cons p e g ih =>
    refine (ih (step p.last e t)).trans ?_
    rw [toPath_step, AlternatingPath.setLast_cons, AlternatingPath.toPath_cons,
      Quiver.Path.comp_assoc]
    refine (AlternatingPath.toPath_setLast_one_comp_homotopic p _).trans ?_
    rw [← Quiver.Path.comp_assoc, Path.comp_ofDart]
    exact (Path.Homotopic.one _).symm.comp_right _

/-- The indexed path of an alternating path of positive length. -/
private def ofAlternatingPath : ∀ {y : Γ.V} (p : 𝔸.AlternatingPath x y), p.length ≠ 0 →
    Σ n, IndexedPath 𝔸 x y n
  | _, .single g, h => absurd (AlternatingPath.length_single g) h
  | _, .cons q e g, _ => prepend q (single q.last e g)

/-- The indexed path of an alternating path of length `k` has `k` darts. -/
private theorem ofAlternatingPath_fst_add_one (p : 𝔸.AlternatingPath x y) (h : p.length ≠ 0) :
    (ofAlternatingPath p h).1 + 1 = p.length := by
  cases p with
  | single g => exact absurd (AlternatingPath.length_single g) h
  | cons q e g => rw [ofAlternatingPath, prepend_fst, AlternatingPath.length_cons, zero_add]

/-- The indexed path of an alternating path spells the same path. -/
private theorem toPath_ofAlternatingPath_homotopic (p : 𝔸.AlternatingPath x y)
    (h : p.length ≠ 0) : Path.Homotopic (ofAlternatingPath p h).2.toPath p.toPath := by
  cases p with
  | single g => exact absurd (AlternatingPath.length_single g) h
  | cons q e g =>
    refine (toPath_prepend_homotopic q _).trans ?_
    rw [toPath_single, Quiver.Path.comp_assoc]
    refine (AlternatingPath.toPath_setLast_one_comp_homotopic q _).trans ?_
    rw [AlternatingPath.toPath_cons, ← Quiver.Path.comp_assoc, Path.comp_ofDart,
      Path.comp_ofVertex]
    exact .refl _

end IndexedPath

/-- Appending the letters `g, d, h` to a path. -/
private theorem homotopic_comp_ofVertex_ofDart_ofVertex {x : 𝔸.LetterVertex} {a b : Γ.V}
    (p : 𝔸.Path x ⟨a⟩) (g : 𝔸.vertexGroup a) (d : a ⟶ b) (h : 𝔸.vertexGroup b) :
    Path.Homotopic (p.comp (((Path.ofVertex g).comp (Path.ofDart d)).comp (Path.ofVertex h)))
      (((p.cons (Letter.vertex g)).cons (Letter.dart d)).cons (Letter.vertex h)) := by
  rw [← Quiver.Path.comp_assoc, ← Quiver.Path.comp_assoc, Path.comp_ofVertex, Path.comp_ofDart,
    Path.comp_ofVertex]
  exact .refl _

/-! ### The wedge of a family of indexed paths -/

namespace AGraph

variable {v₀ : Γ.V} {ι : Type u'} (n : ι → ℕ)

/-- The vertex at position `k` of the `i`-th circle of the wedge: the base vertex `none` at
position `0`, and the vertex `some ⟨i, j⟩` at position `j + 1`. -/
private def wedgePos (i : ι) : Fin (n i + 1) → Option (Σ i, Fin (n i)) :=
  Fin.cons none fun j => some ⟨i, j⟩

/-- The sources of the darts of the wedge. The `i`-th circle has the darts `⟨i, some j⟩` from
position `j` to position `j + 1` and the dart `⟨i, none⟩` from position `n i` back to the base
vertex; the second component `false` marks the reverse darts. -/
private abbrev wedgeSrc : (Σ i, Option (Fin (n i))) × Bool → Option (Σ i, Fin (n i))
  | (⟨i, some j⟩, true) => wedgePos n i j.castSucc
  | (⟨i, some j⟩, false) => some ⟨i, j⟩
  | (⟨i, none⟩, true) => wedgePos n i (Fin.last (n i))
  | (⟨_, none⟩, false) => none

/-- The underlying graph of the wedge: circles with `n i + 1` edges, glued at a base vertex. A
circle with one edge is a loop at the base vertex. -/
private abbrev wedgeGraph : SerreGraph.{u', u'} where
  V := Option (Σ i, Fin (n i))
  E := (Σ i, Option (Fin (n i))) × Bool
  src := wedgeSrc n
  rev e := (e.1, !e.2)
  rev_rev e := by simp
  rev_ne e := by
    obtain ⟨d, _ | _⟩ := e <;> simp

variable {n}

/-- The types of the vertices of the wedge. -/
private def wedgeTyp (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) : Option (Σ i, Fin (n i)) → Γ.V
  | none => v₀
  | some ⟨i, j⟩ => (t i).vt j

/-- The types of the darts of the wedge. -/
private def wedgeDartTyp (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) :
    (Σ i, Option (Fin (n i))) × Bool → Γ.E
  | (⟨i, some j⟩, true) => ((t i).dt j).1
  | (⟨i, some j⟩, false) => Γ.rev ((t i).dt j).1
  | (⟨i, none⟩, true) => (t i).lastDart.1
  | (⟨i, none⟩, false) => Γ.rev (t i).lastDart.1

/-- The type of the vertex at position `k` of the `i`-th circle. -/
private theorem wedgeTyp_wedgePos (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) (i : ι)
    (k : Fin (n i + 1)) :
    wedgeTyp t (wedgePos n i k) = (Fin.cons v₀ (t i).vt : Fin (n i + 1) → Γ.V) k := by
  cases k using Fin.cases <;> rfl

/-- The type map of the wedge. -/
private abbrev wedgeHom (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) : (wedgeGraph n).Hom Γ where
  mapV := wedgeTyp t
  mapE := wedgeDartTyp t
  map_src
    | (⟨i, some j⟩, true) => ((t i).dt j).2.1.trans (wedgeTyp_wedgePos t i j.castSucc).symm
    | (⟨i, some j⟩, false) => (Γ.src_rev _).trans ((t i).dt j).2.2
    | (⟨i, none⟩, true) => (t i).lastDart.2.1.trans (wedgeTyp_wedgePos t i (Fin.last (n i))).symm
    | (⟨i, none⟩, false) => (Γ.src_rev _).trans (t i).lastDart.2.2
  map_rev
    | (⟨_, some _⟩, true) | (⟨_, none⟩, true) => rfl
    | (⟨_, some _⟩, false) | (⟨_, none⟩, false) => (Γ.rev_rev _).symm

/-- The start labels of the darts of the wedge: the elements `g_j` of the circles before their
darts, and the inverse of the last element after the last dart of a circle. -/
private def wedgeLabel (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) :
    ∀ f : (Σ i, Option (Fin (n i))) × Bool, 𝔸.vertexGroup (Γ.src (wedgeDartTyp t f))
  | (⟨i, some j⟩, true) => MulEquiv.cast (M := 𝔸.vertexGroup) ((t i).dt j).2.1.symm ((t i).lab j)
  | (⟨_, some _⟩, false) => 1
  | (⟨i, none⟩, true) => MulEquiv.cast (M := 𝔸.vertexGroup) (t i).lastDart.2.1.symm (t i).lastLab
  | (⟨i, none⟩, false) => MulEquiv.cast (M := 𝔸.vertexGroup)
      (((t i).lastDart.2.2.symm.trans (Γ.src_rev _).symm)) (t i).endLab⁻¹

/-- The wedge of the circles `t i` at a base vertex with vertex group `K`. -/
private abbrev circleWedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) (K : Subgroup (𝔸.vertexGroup v₀)) :
    AGraph.{u, v, w, x, u', u'} 𝔸 v₀ where
  graph := wedgeGraph n
  typ := wedgeHom t
  base := none
  typ_base := rfl
  grp
    | none => K
    | some _ => ⊥
  labelα := wedgeLabel t

/-- The `𝔹`-paths along the `i`-th circle of the wedge, from the base vertex to the vertex at
position `k`. -/
private def circlePath (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) (K : Subgroup (𝔸.vertexGroup v₀))
    (i : ι) :
    ∀ k : Fin (n i + 1), (circleWedge t K).toGraphOfGroups.Path ⟨none⟩ ⟨wedgePos n i k⟩ :=
  Fin.induction (motive := fun k => (circleWedge t K).toGraphOfGroups.Path ⟨none⟩ ⟨wedgePos n i k⟩)
    .nil fun j p => p.cons (Letter.dart ((circleWedge t K).graph.dart (⟨i, some j⟩, true)))

/-- The path to position `j + 1` of a circle is the path to position `j` followed by the dart
`⟨i, some j⟩`. -/
private theorem circlePath_succ (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : ι) (j : Fin (n i)) :
    circlePath t K i j.succ = (circlePath t K i j.castSucc).cons
      (Letter.dart ((circleWedge t K).graph.dart (⟨i, some j⟩, true))) :=
  rfl

/-- The `𝔹`-paths from the base vertex of the wedge to its vertices. -/
private def basePath (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) (K : Subgroup (𝔸.vertexGroup v₀)) :
    ∀ u : (circleWedge t K).graph.V,
      (circleWedge t K).toGraphOfGroups.Path ⟨(circleWedge t K).base⟩ ⟨u⟩
  | none => .nil
  | some ⟨i, j⟩ => circlePath t K i j.succ

/-- The chosen path to the vertex at position `k` of the `i`-th circle runs along that circle. -/
private theorem basePath_wedgePos (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : ι) (k : Fin (n i + 1)) :
    basePath t K (wedgePos n i k) = circlePath t K i k := by
  cases k using Fin.cases <;> rfl

/-- The loop around the `i`-th circle of the wedge. -/
private def circleLoop (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) (K : Subgroup (𝔸.vertexGroup v₀))
    (i : ι) :
    (circleWedge t K).toGraphOfGroups.Path ⟨(circleWedge t K).base⟩ ⟨(circleWedge t K).base⟩ :=
  (circlePath t K i (Fin.last (n i))).cons
    (Letter.dart ((circleWedge t K).graph.dart (⟨i, none⟩, true)))

/-- The base vertex of the wedge has type `v₀`, by definition of `wedgeTyp`, so `π₁Hom` reads a
loop at the base vertex without transport. -/
private theorem π₁Hom_mk_circleWedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀))
    (q : (circleWedge t K).toGraphOfGroups.Path ⟨(circleWedge t K).base⟩
      ⟨(circleWedge t K).base⟩) :
    (circleWedge t K).π₁Hom (π₁.mk q) = π₁.mk ((circleWedge t K).pathMap q) :=
  (π₁Hom_mk _ q).trans ((MulEquiv.cast_apply _ _).trans (cast_eq _ _))

/-- The base vertex of the wedge has type `v₀`, by definition of `wedgeTyp`, so composing with the
transport along `typ_base` does nothing. -/
private theorem toMonoidHom_cast_typ_base_circleWedge_comp (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) {G : Type*} [Group G]
    (f : G →* π₁ 𝔸 ((circleWedge t K).typ.mapV (circleWedge t K).base)) :
    (MulEquiv.cast (M := π₁ 𝔸) (circleWedge t K).typ_base).toMonoidHom.comp f = f :=
  MonoidHom.ext fun g => (MonoidHom.comp_apply _ _ g).trans <|
    (congrFun (MulEquiv.coe_toMonoidHom _) _).trans ((MulEquiv.cast_apply _ _).trans (cast_eq _ _))

/-- The dart `⟨i, some k⟩` of the wedge reads the letters `g_k, e_k, 1` of the `i`-th indexed
path. -/
private theorem letterPath_chain (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : ι) (k : Fin (n i)) :
    (circleWedge t K).letterPath (Letter.dart ((circleWedge t K).graph.dart (⟨i, some k⟩, true))) =
      ((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (wedgeTyp_wedgePos t i k.castSucc).symm
        ((t i).lab k))).comp (Path.ofDart (⟨((t i).dt k).1,
          ((t i).dt k).2.1.trans (wedgeTyp_wedgePos t i k.castSucc).symm, ((t i).dt k).2.2⟩ :
            wedgeTyp t (wedgePos n i k.castSucc) ⟶ (t i).vt k))).comp (Path.ofVertex 1) := by
  -- The labels of the dart and of its reverse are transports of `g_k` and `1`, by definition of
  -- `wedgeLabel`.
  refine letterPath_dart_eq _ _ ?_ rfl ((cast_labelω _ _).trans (inv_eq_one.2 (map_one _)))
  rw [MulEquiv.cast_apply, MulEquiv.cast_apply]
  exact (congrArg _ (MulEquiv.cast_apply _ _)).trans (cast_cast _ _ _)

/-- The dart `⟨i, none⟩` of the wedge reads the last letters `g_n, e_n, h` of the `i`-th indexed
path. -/
private theorem letterPath_last (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : ι) :
    (circleWedge t K).letterPath (Letter.dart ((circleWedge t K).graph.dart (⟨i, none⟩, true))) =
      ((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup)
        (wedgeTyp_wedgePos t i (Fin.last (n i))).symm (t i).lastLab)).comp
          (Path.ofDart (⟨(t i).lastDart.1,
            (t i).lastDart.2.1.trans (wedgeTyp_wedgePos t i (Fin.last (n i))).symm,
              (t i).lastDart.2.2⟩ : wedgeTyp t (wedgePos n i (Fin.last (n i))) ⟶ v₀))).comp
        (Path.ofVertex (t i).endLab) := by
  -- The labels of the dart and of its reverse are transports of `g_n` and `h⁻¹`, by definition of
  -- `wedgeLabel`.
  refine letterPath_dart_eq _ _ ?_ rfl ((cast_labelω _ _).trans (inv_eq_iff_eq_inv.2 ?_))
  · rw [MulEquiv.cast_apply, MulEquiv.cast_apply]
    exact (congrArg _ (MulEquiv.cast_apply _ _)).trans (cast_cast _ _ _)
  · rw [MulEquiv.cast_apply]
    exact ((congrArg _ (MulEquiv.cast_apply _ _)).trans (cast_cast _ _ _)).trans (cast_eq _ _)

/-- At position `0` both sides of `wedgeTyp_wedgePos` are `v₀`, by definition of `wedgeTyp`,
`wedgePos` and `Fin.cons`, so transporting along it is the identity. -/
private theorem cast_wedgeTyp_wedgePos_zero (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) (i : ι)
    (g : 𝔸.vertexGroup ((Fin.cons v₀ (t i).vt : Fin (n i + 1) → Γ.V) 0)) :
    MulEquiv.cast (M := 𝔸.vertexGroup) (wedgeTyp_wedgePos t i 0).symm g = g :=
  (MulEquiv.cast_apply _ _).trans (cast_eq _ g)

/-- At position `j + 1` both sides of `wedgeTyp_wedgePos` are `c_{j+1}`, by definition of
`wedgeTyp`, `wedgePos` and `Fin.cons`, so transporting along it is the identity. -/
private theorem cast_wedgeTyp_wedgePos_succ (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i)) (i : ι)
    (j : Fin (n i)) (g : 𝔸.vertexGroup ((Fin.cons v₀ (t i).vt : Fin (n i + 1) → Γ.V) j.succ)) :
    MulEquiv.cast (M := 𝔸.vertexGroup) (wedgeTyp_wedgePos t i j.succ).symm g = g :=
  (MulEquiv.cast_apply _ _).trans (cast_eq _ g)

/-- Along a circle, the path map reads the initial segments of the indexed path: reading the path
to position `k` and then letters `g, d, h` is reading the `k`-th initial segment and then
`g, d, h`. -/
private theorem pathMap_circlePath_homotopic (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : ι) (k : Fin (n i + 1)) :
    ∀ {y : Γ.V} (g : 𝔸.vertexGroup ((Fin.cons v₀ (t i).vt : Fin (n i + 1) → Γ.V) k))
      (d : (Fin.cons v₀ (t i).vt : Fin (n i + 1) → Γ.V) k ⟶ y) (h : 𝔸.vertexGroup y),
      Path.Homotopic (((circleWedge t K).pathMap (circlePath t K i k)).comp
        (((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (wedgeTyp_wedgePos t i k).symm g)).comp
          (Path.ofDart (⟨d.1, d.2.1.trans (wedgeTyp_wedgePos t i k).symm, d.2.2⟩ :
            wedgeTyp t (wedgePos n i k) ⟶ y))).comp (Path.ofVertex h)))
        (((((t i).pre k).cons (Letter.vertex g)).cons (Letter.dart d)).cons (Letter.vertex h)) := by
  induction k using Fin.induction with
  | zero =>
    intro y g d h
    -- The path to position `0` is the empty path at the base vertex.
    have h₀ : (circleWedge t K).pathMap (circlePath t K i 0) = .nil := pathMap_nil _
    rw [h₀, IndexedPath.pre_zero, cast_wedgeTyp_wedgePos_zero]
    exact homotopic_comp_ofVertex_ofDart_ofVertex .nil g d h
  | succ j ih =>
    intro y g d h
    -- The path to position `j + 1` is the path to position `j` followed by the dart `⟨i, some j⟩`.
    have e : (circleWedge t K).pathMap (circlePath t K i j.succ) =
        ((circleWedge t K).pathMap (circlePath t K i j.castSucc)).comp _ :=
      (pathMap_cons _ _ _).trans (congrArg _ (letterPath_chain t K i j))
    rw [e, IndexedPath.pre_succ, cast_wedgeTyp_wedgePos_succ]
    exact (((ih ((t i).lab j) ((t i).dt j) 1).trans (Path.Homotopic.one _)).comp_right _).trans
      (homotopic_comp_ofVertex_ofDart_ofVertex _ g d h)

/-- The loop around the `i`-th circle reads the `i`-th indexed path. -/
private theorem π₁Hom_mk_circleLoop (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : ι) :
    (circleWedge t K).π₁Hom (π₁.mk (circleLoop t K i)) = π₁.mk (t i).toPath := by
  have e : (circleWedge t K).pathMap (circleLoop t K i) =
      ((circleWedge t K).pathMap (circlePath t K i (Fin.last (n i)))).comp _ :=
    (pathMap_cons _ _ _).trans (congrArg _ (letterPath_last t K i))
  rw [π₁Hom_mk_circleWedge, e]
  -- The right-hand side `(t i).toPath` is the last initial segment followed by `g_n, e_n, h`, by
  -- definition of `IndexedPath.toPath`.
  exact π₁.mk_eq_mk_iff.2
    (pathMap_circlePath_homotopic t K i (Fin.last (n i)) (t i).lastLab (t i).lastDart (t i).endLab)

/-- The wedge is connected: the paths `basePath` reach every vertex from the base vertex. -/
private theorem connected_circleWedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) : (circleWedge t K).graph.Connected := by
  -- The vertices of the wedge reduce to `Option _`, which hides the quiver of the underlying
  -- graph.
  let _ : Quiver (circleWedge t K).graph.V := SerreGraph.toQuiver _
  exact (SerreGraph.connected_iff _).2 ⟨⟨none⟩, SerreGraph.preconnected_of_forall_nonempty_path _
    none fun u => ⟨Path.edgePath (basePath t K u)⟩⟩

/-- The wedge is a finite `𝔸`-graph when it has finitely many circles and its base vertex group
is finitely generated. -/
private theorem isFinite_circleWedge [Finite ι] (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (hK : K.FG) : (circleWedge t K).IsFinite := by
  -- The darts of the wedge are the pairs of a dart of a circle and a Boolean, and its vertex groups
  -- are `K` and `⊥`, by definition.
  refine ⟨inferInstanceAs (Finite ((Σ i, Option (Fin (n i))) × Bool)),
    connected_circleWedge t K, ?_⟩
  rintro (_ | _)
  exacts [hK, Subgroup.FG.bot]

/-- Along the `i`-th circle, the path to the end of the dart `⟨i, some k⟩` is the path to its
start followed by the dart. -/
private theorem basePath_tgt (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : ι) (k : Fin (n i)) :
    basePath t K ((circleWedge t K).graph.tgt (⟨i, some k⟩, true)) =
      (basePath t K ((circleWedge t K).graph.src (⟨i, some k⟩, true))).cons
        (Letter.dart ((circleWedge t K).graph.dart (⟨i, some k⟩, true))) :=
  (circlePath_succ t K i k).trans (congrArg (fun p : (circleWedge t K).toGraphOfGroups.Path
    ⟨none⟩ ⟨wedgePos n i k.castSucc⟩ => p.cons (Letter.dart ((circleWedge t K).graph.dart
      (⟨i, some k⟩, true)))) (basePath_wedgePos t K i k.castSucc).symm)

/-- The loop `γ_{o(f)} f γ_{t(f)}⁻¹` of the reverse `f = (d, false)` of a dart `(d, true)` of the
wedge is the inverse of the loop of `(d, true)`. -/
private theorem mk_dartLoop_false (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (d : Σ i, Option (Fin (n i))) :
    π₁.mk (((basePath t K ((circleWedge t K).graph.src (d, false))).comp
      (Path.ofDart ((circleWedge t K).graph.dart (d, false)))).comp
        (basePath t K ((circleWedge t K).graph.tgt (d, false))).reverse) =
      (π₁.mk (((basePath t K ((circleWedge t K).graph.src (d, true))).comp
        (Path.ofDart ((circleWedge t K).graph.dart (d, true)))).comp
          (basePath t K ((circleWedge t K).graph.tgt (d, true))).reverse))⁻¹ := by
  -- The dart `(d, false)` is the reverse of the dart `(d, true)`.
  have h : Path.ofDart (𝔸 := (circleWedge t K).toGraphOfGroups)
      ((circleWedge t K).graph.dart (d, false)) = (Path.ofDart
        (a := (circleWedge t K).graph.tgt (d, false)) (b := (circleWedge t K).graph.src (d, false))
          ((circleWedge t K).graph.dart (d, true))).reverse :=
    (congrArg Path.ofDart ((circleWedge t K).graph.eq_reverse_of_val_eq_rev
      ((SerreGraph.dart_val _ _).trans (congrArg (circleWedge t K).graph.rev
        (SerreGraph.dart_val _ (d, true))).symm))).trans (Path.reverse_ofDart _).symm
  rw [← π₁.mk_reverse, h]
  conv_rhs => rw [Quiver.Path.reverse_comp, Quiver.Path.reverse_comp, Quiver.Path.reverse_reverse]
  rw [Quiver.Path.comp_assoc]
  rfl

/-- The loop `γ_{o(f)} f γ_{t(f)}⁻¹` of the last dart `f` of the `i`-th circle of the wedge reads
the `i`-th indexed path. -/
private theorem π₁Hom_mk_dartLoop_none (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : ι) :
    (circleWedge t K).π₁Hom (π₁.mk (((basePath t K ((circleWedge t K).graph.src
      (⟨i, none⟩, true))).comp (Path.ofDart ((circleWedge t K).graph.dart (⟨i, none⟩, true)))).comp
        (basePath t K ((circleWedge t K).graph.tgt (⟨i, none⟩, true))).reverse)) =
      π₁.mk (t i).toPath := by
  have h₁ : basePath t K ((circleWedge t K).graph.src (⟨i, none⟩, true)) =
      circlePath t K i (Fin.last (n i)) :=
    basePath_wedgePos t K i (Fin.last (n i))
  have h₂ : basePath t K ((circleWedge t K).graph.tgt (⟨i, none⟩, true)) = .nil := rfl
  rw [h₁, h₂, Path.comp_ofDart, ← π₁Hom_mk_circleLoop t K i]
  -- The path read is `circleLoop t K i` followed by the reverse of the empty path, which is the
  -- empty path, by definition.
  rfl

/-- The loops `γ_{o(f)} f γ_{t(f)}⁻¹` of the darts `(d, true)` of the wedge: trivial for the darts
inside a circle, and the loop around the circle for its last dart. -/
private theorem π₁Hom_mk_dartLoop_true_mem (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) (d : Σ i, Option (Fin (n i))) :
    (circleWedge t K).π₁Hom (π₁.mk (((basePath t K ((circleWedge t K).graph.src (d, true))).comp
      (Path.ofDart ((circleWedge t K).graph.dart (d, true)))).comp
        (basePath t K ((circleWedge t K).graph.tgt (d, true))).reverse)) ∈
      Subgroup.closure (Set.range fun i => π₁.mk (t i).toPath) := by
  obtain ⟨i, _ | k⟩ := d
  · rw [π₁Hom_mk_dartLoop_none]
    exact Subgroup.subset_closure ⟨i, rfl⟩
  · rw [basePath_tgt, Path.comp_ofDart, π₁.mk_eq_mk_iff.2 (Path.Homotopic.comp_reverse _),
      π₁.mk_nil, map_one]
    exact one_mem _

/-- The conjugates of the vertex groups of the wedge along the paths `basePath` generate the image
of `K`. -/
private theorem iSup_range_circleWedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) :
    ⨆ u, ((circleWedge t K).π₁Hom.comp (π₁.vertexHom (basePath t K u))).range =
      K.map (π₁.vertexHom Quiver.Path.nil) := by
  -- The vertex groups are `K` at the base vertex `none`, where `basePath` is the empty path, and
  -- `⊥` elsewhere, by definition.
  have h : ((circleWedge t K).π₁Hom.comp (π₁.vertexHom (basePath t K none))).range =
      K.map (π₁.vertexHom Quiver.Path.nil) := by
    rw [range_π₁Hom_comp_vertexHom, toMonoidHom_cast_typ_base_circleWedge_comp]
    exact congrArg (fun q => K.map (π₁.vertexHom q)) (pathMap_nil _)
  refine le_antisymm (iSup_le ?_) (h.ge.trans (le_iSup_of_le none le_rfl))
  rintro (_ | z)
  · exact h.le
  · rw [range_π₁Hom_comp_vertexHom]
    exact (Subgroup.map_bot _).le.trans bot_le

/-- The wedge represents the subgroup generated by `K` and the classes of its circles
(Kapovich, Weidmann and Myasnikov, Lemma 5.3). -/
private theorem subgroup_circleWedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) :
    (circleWedge t K).subgroup = K.map (π₁.vertexHom Quiver.Path.nil) ⊔
      Subgroup.closure (Set.range fun i => π₁.mk (t i).toPath) := by
  rw [subgroup_eq_sup _ (basePath t K), iSup_range_circleWedge]
  refine congrArg _ (le_antisymm ((Subgroup.closure_le _).2 ?_) ((Subgroup.closure_le _).2 ?_))
  · rintro _ ⟨⟨d, _ | _⟩, rfl⟩ <;> beta_reduce
    · rw [mk_dartLoop_false, map_inv]
      exact inv_mem (π₁Hom_mk_dartLoop_true_mem t K d)
    · exact π₁Hom_mk_dartLoop_true_mem t K d
  · rintro _ ⟨i, rfl⟩
    exact Subgroup.subset_closure ⟨(⟨i, none⟩, true), π₁Hom_mk_dartLoop_none t K i⟩

/-- The wedge has one geometric edge for each dart `(d, true)`. -/
private theorem card_geomEdge_circleWedge_eq (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) :
    Nat.card (circleWedge t K).graph.GeomEdge = Nat.card (Σ i, Option (Fin (n i))) :=
  -- The darts and their reversal are those of the rose on the edges of the circles.
  Nat.card_congr <| (SerreGraph.GeomEdge.congr (circleWedge t K).graph (Δ := SerreGraph.rose _)
    (Equiv.refl _) fun _ => rfl).trans (SerreGraph.roseGeomEdgeEquiv _)

/-- The wedge has `∑ i, (n i + 1)` geometric edges. -/
private theorem card_geomEdge_circleWedge [Fintype ι] (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) :
    Nat.card (circleWedge t K).graph.GeomEdge = ∑ i, (n i + 1) := by
  rw [card_geomEdge_circleWedge_eq, Nat.card_sigma]
  simp

/-- The wedge has `∑ i, n i + 1` vertices. -/
private theorem card_V_circleWedge [Fintype ι] (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) : Nat.card (circleWedge t K).graph.V = ∑ i, n i + 1 := by
  -- The vertices of the wedge are `Option (Σ i, Fin (n i))`, by definition.
  have h : Nat.card (circleWedge t K).graph.V = Nat.card (Option (Σ i, Fin (n i))) := rfl
  rw [h, Finite.card_option, Nat.card_sigma]
  simp

/-- The rank of the underlying graph of the wedge is the number of its circles. -/
private theorem card_V_circleWedge_add_card [Finite ι] (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) :
    Nat.card (circleWedge t K).graph.V + Nat.card ι =
      Nat.card (circleWedge t K).graph.GeomEdge + 1 := by
  have := Fintype.ofFinite ι
  rw [card_V_circleWedge, card_geomEdge_circleWedge, Finset.sum_add_distrib, Finset.sum_const,
    Finset.card_univ, Nat.card_eq_fintype_card, smul_eq_mul, mul_one]
  omega

/-- The vertex groups of the wedge away from the base vertex are trivial. -/
private theorem grp_circleWedge_of_ne (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i))
    (K : Subgroup (𝔸.vertexGroup v₀)) {u : (circleWedge t K).graph.V} (hu : u ≠ none) :
    (circleWedge t K).grp u = ⊥ := by
  rcases u with _ | z
  exacts [absurd rfl hu, rfl]

/-! ### The wedge of a family of closed alternating paths -/

/-- The base vertex group of the wedge of a family `p` of closed alternating paths at `v₀`: the
subgroup of the vertex group `A_{v₀}` generated by the paths of length zero. -/
def wedgeGroup (p : ι → 𝔸.AlternatingPath v₀ v₀) : Subgroup (𝔸.vertexGroup v₀) :=
  Subgroup.closure {g | ∃ i, p i = .single g}

theorem wedgeGroup_def (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    wedgeGroup p = Subgroup.closure {g | ∃ i, p i = .single g} :=
  (rfl)

/-- A path of length zero lies in the base vertex group of the wedge. -/
theorem mem_wedgeGroup_of_eq_single {p : ι → 𝔸.AlternatingPath v₀ v₀} {i : ι}
    {g : 𝔸.vertexGroup v₀} (h : p i = .single g) : g ∈ wedgeGroup p :=
  Subgroup.subset_closure ⟨i, h⟩

/-- The base vertex group of the wedge lies in `H` exactly when the paths of length zero do. -/
@[simp] theorem wedgeGroup_le {p : ι → 𝔸.AlternatingPath v₀ v₀}
    {H : Subgroup (𝔸.vertexGroup v₀)} : wedgeGroup p ≤ H ↔ ∀ i g, p i = .single g → g ∈ H := by
  rw [wedgeGroup_def, Subgroup.closure_le]
  exact ⟨fun h i g hi => h ⟨i, hi⟩, fun h _ ⟨i, hi⟩ => h i _ hi⟩

/-- The base vertex group of the wedge is trivial exactly when every path of length zero is `1`. -/
@[simp] theorem wedgeGroup_eq_bot_iff {p : ι → 𝔸.AlternatingPath v₀ v₀} :
    wedgeGroup p = ⊥ ↔ ∀ i g, p i = .single g → g = 1 := by
  rw [← le_bot_iff, wedgeGroup_le]
  simp only [Subgroup.mem_bot]

/-- The base vertex group of the wedge of the empty family is trivial. -/
@[simp] theorem wedgeGroup_of_isEmpty [IsEmpty ι] (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    wedgeGroup p = ⊥ :=
  wedgeGroup_eq_bot_iff.2 fun i => isEmptyElim i

/-- The base vertex group of the wedge of a family of paths `g i` of length zero is generated by
the elements `g i`. -/
@[simp] theorem wedgeGroup_single (g : ι → 𝔸.vertexGroup v₀) :
    wedgeGroup (fun i => (.single (g i) : 𝔸.AlternatingPath v₀ v₀)) =
      Subgroup.closure (Set.range g) := by
  rw [wedgeGroup_def]
  congr 1
  ext h
  simp [eq_comm]

/-- The paths of length zero are the elements `g` of the paths `single g`. -/
private theorem setOf_eq_single_eq_range (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    {g | ∃ i, p i = .single g} = Set.range fun c : {i // (p i).length = 0} => (p c).last := by
  ext g
  refine ⟨fun ⟨i, hi⟩ => ⟨⟨i, by rw [hi, AlternatingPath.length_single]⟩, ?_⟩, ?_⟩
  · exact (congrArg AlternatingPath.last hi).trans (AlternatingPath.last_single g)
  · rintro ⟨⟨i, hi⟩, rfl⟩
    obtain ⟨g, hg⟩ := AlternatingPath.length_eq_zero_iff.1 hi
    exact ⟨i, by simp [hg]⟩

/-- The base vertex group of the wedge is generated by the paths of length zero. -/
private theorem wedgeGroup_eq_closure_range (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    wedgeGroup p = Subgroup.closure (Set.range fun c : {i // (p i).length = 0} => (p c).last) :=
  (wedgeGroup_def p).trans (congrArg _ (setOf_eq_single_eq_range p))

/-- The base vertex group of the wedge is finitely generated when finitely many paths have length
zero, for instance for a finite family. -/
theorem fg_wedgeGroup (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length = 0}] :
    (wedgeGroup p).FG := by
  rw [wedgeGroup_eq_closure_range]
  infer_instance

instance (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length = 0}] :
    Group.FG (wedgeGroup p) :=
  fg_wedgeGroup p

/-- The base vertex group of the wedge has rank at most the number of paths of length zero, which
generate it, when this number is finite. -/
theorem rank_wedgeGroup_le (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length = 0}] :
    Group.rank (wedgeGroup p) ≤ Nat.card {i // (p i).length = 0} :=
  (Subgroup.rank_congr (wedgeGroup_eq_closure_range p)).trans_le <|
    (Subgroup.rank_closure_finite_le_nat_card _).trans (Finite.card_range_le _)

/-- The circles of the wedge: the indexed paths of the paths of positive length. -/
private abbrev wedgeCircles (p : ι → 𝔸.AlternatingPath v₀ v₀) (c : {i // (p i).length ≠ 0}) :
    IndexedPath 𝔸 v₀ v₀ (IndexedPath.ofAlternatingPath (p c) c.2).1 :=
  (IndexedPath.ofAlternatingPath (p c) c.2).2

/-- The wedge of a family `p` of closed alternating `𝔸`-paths at `v₀`, the `S`-wedge of Kapovich,
Weidmann and Myasnikov: a base vertex of type `v₀` with vertex group `wedgeGroup p`, generated by
the paths of length zero, and, for every path `g₀, e₁, g₁, …, e_k, g_k` of length `k ≥ 1`, a circle
through the base vertex with `k` edges, of types `e₁, …, e_k` and with labels `(g₀, e₁, 1)`, …,
`(g_{k-2}, e_{k-1}, 1)`, `(g_{k-1}, e_k, g_k)`, whose other vertices have trivial vertex groups. A
path of length one gives a loop at the base vertex. -/
def wedge (p : ι → 𝔸.AlternatingPath v₀ v₀) : AGraph.{u, v, w, x, u', u'} 𝔸 v₀ :=
  circleWedge (wedgeCircles p) (wedgeGroup p)

/-- The vertex group of the wedge at its base vertex is `wedgeGroup p`, read in `A_{[u₀]}`. -/
@[simp] theorem grp_wedge_base (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    (wedge p).grp (wedge p).base =
      (wedgeGroup p).comap (MulEquiv.cast (M := 𝔸.vertexGroup) (wedge p).typ_base : _ →* _) := by
  ext g
  rw [Subgroup.mem_comap, MonoidHom.coe_ofClass, MulEquiv.cast_apply]
  -- The base vertex has type `v₀` and group `wedgeGroup p`, by definition of `wedge`, so the
  -- transport along `typ_base` is the identity.
  exact iff_of_eq (congrArg (· ∈ wedgeGroup p) (cast_eq _ g)).symm

/-- The vertex group of the wedge at its base vertex, read in `A_{v₀}`, is `wedgeGroup p`. -/
theorem map_grp_wedge_base (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    ((wedge p).grp (wedge p).base).map
      (MulEquiv.cast (M := 𝔸.vertexGroup) (wedge p).typ_base : _ →* _) = wedgeGroup p := by
  rw [grp_wedge_base, Subgroup.map_comap_eq_self_of_surjective (MulEquiv.surjective _)]

/-- The vertex groups of the wedge away from its base vertex are trivial. -/
theorem grp_wedge_of_ne_base (p : ι → 𝔸.AlternatingPath v₀ v₀) {u : (wedge p).graph.V}
    (hu : u ≠ (wedge p).base) : (wedge p).grp u = ⊥ :=
  grp_circleWedge_of_ne _ _ hu

/-- The underlying graph of the wedge is connected. -/
theorem connected_wedge (p : ι → 𝔸.AlternatingPath v₀ v₀) : (wedge p).graph.Connected :=
  connected_circleWedge _ _

/-- The wedge has finitely many darts when finitely many paths have positive length: its darts
are the pairs of an edge of a circle and an orientation, by definition. -/
instance (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length ≠ 0}] :
    Finite (wedge p).graph.E :=
  inferInstanceAs (Finite ((Σ c : {i // (p i).length ≠ 0},
    Option (Fin (IndexedPath.ofAlternatingPath (p c) c.2).1)) × Bool))

/-- The wedge has finitely many vertices when finitely many paths have positive length: its
vertices are the base vertex and the inner vertices of the circles, by definition. -/
instance (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length ≠ 0}] :
    Finite (wedge p).graph.V :=
  inferInstanceAs (Finite (Option (Σ c : {i // (p i).length ≠ 0},
    Fin (IndexedPath.ofAlternatingPath (p c) c.2).1)))

instance (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length ≠ 0}] :
    Finite (wedge p).graph.GeomEdge :=
  Finite.of_surjective _ (SerreGraph.toGeomEdge_surjective _)

/-- The wedge is a finite `𝔸`-graph when finitely many paths have positive length and its base
vertex group is finitely generated, for instance for a finite family. -/
theorem isFinite_wedge (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length ≠ 0}]
    [Group.FG (wedgeGroup p)] : (wedge p).IsFinite :=
  isFinite_circleWedge _ _ ((Group.fg_iff_subgroup_fg _).1 inferInstance)

/-- The wedge represents the subgroup generated by the image of its base vertex group and by the
classes of the paths of positive length. -/
theorem subgroup_wedge_eq_sup (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    (wedge p).subgroup = (wedgeGroup p).map (π₁.vertexHom Quiver.Path.nil) ⊔
      Subgroup.closure (Set.range fun c : {i // (p i).length ≠ 0} => π₁.mk (p c).toPath) :=
  (subgroup_circleWedge _ _).trans (congrArg (fun s => _ ⊔ Subgroup.closure (Set.range s))
    (funext fun c => π₁.mk_eq_mk_iff.2 (IndexedPath.toPath_ofAlternatingPath_homotopic _ c.2)))

/-- The wedge of a family of closed alternating paths represents the subgroup of `π₁(𝔸, v₀)`
generated by the classes of the paths (Kapovich, Weidmann and Myasnikov, Lemma 5.3). -/
@[simp] theorem subgroup_wedge (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    (wedge p).subgroup = Subgroup.closure (Set.range fun i => π₁.mk (p i).toPath) := by
  rw [subgroup_wedge_eq_sup, wedgeGroup_def, MonoidHom.map_closure, ← Subgroup.closure_union]
  congr 1
  ext s
  simp only [Set.mem_union, Set.mem_image, Set.mem_ofPred_eq, Set.mem_range]
  constructor
  · rintro (⟨g, ⟨i, hi⟩, rfl⟩ | ⟨c, rfl⟩)
    · exact ⟨i, by rw [hi, AlternatingPath.toPath_single, π₁.vertexHom_nil_apply]⟩
    · exact ⟨c, rfl⟩
  · rintro ⟨i, rfl⟩
    by_cases h : (p i).length = 0
    · obtain ⟨g, hg⟩ := AlternatingPath.length_eq_zero_iff.1 h
      exact .inl ⟨g, ⟨i, hg⟩, by rw [hg, AlternatingPath.toPath_single, π₁.vertexHom_nil_apply]⟩
    · exact .inr ⟨⟨i, h⟩, rfl⟩

instance (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length ≠ 0}]
    [Group.FG (wedgeGroup p)] : Group.FG (wedge p).subgroup := by
  rw [subgroup_wedge_eq_sup]
  infer_instance

/-- The number of edges of the wedge is the sum of the lengths of the paths: a path of length `k`
gives a circle with `k` edges. When infinitely many paths have positive length, both sides are
`0` by convention. -/
@[simp] theorem card_geomEdge_wedge (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    Nat.card (wedge p).graph.GeomEdge = ∑ᶠ i, (p i).length := by
  rcases fintypeOrInfinite {i // (p i).length ≠ 0} with _ | hinf
  · exact (card_geomEdge_circleWedge _ _).trans <| (finsum_eq_sum_of_fintype _).symm.trans <|
      (finsum_congr fun c : {i // (p i).length ≠ 0} =>
        IndexedPath.ofAlternatingPath_fst_add_one (p c) c.2).trans <|
      (finsum_set_coe_eq_finsum_mem (Function.support fun i => (p i).length)).trans
        (finsum_mem_support _)
  · -- Infinitely many paths of positive length: infinitely many edges, and both sides are `0`.
    rw [wedge, card_geomEdge_circleWedge_eq, Nat.card_eq_zero_of_infinite,
      finsum_of_infinite_support (Set.infinite_coe_iff.1 hinf)]

/-- The rank of the underlying graph of the wedge is its number of circles, the number of paths of
positive length, when this number is finite: the wedge has as many edges plus one as it has
vertices and circles. -/
theorem card_V_wedge_add_card (p : ι → 𝔸.AlternatingPath v₀ v₀)
    [Finite {i // (p i).length ≠ 0}] :
    Nat.card (wedge p).graph.V + Nat.card {i // (p i).length ≠ 0} =
      Nat.card (wedge p).graph.GeomEdge + 1 :=
  card_V_circleWedge_add_card _ _

