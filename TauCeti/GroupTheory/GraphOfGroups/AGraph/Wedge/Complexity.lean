import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic.FinCases

/-!
# The complexity of the wedge of a finite family of closed paths

The complexity of an `𝔸`-graph is the rank of its underlying graph plus the sum of the ranks of its
vertex groups. The wedge of a finite family `p` of closed alternating `𝔸`-paths at `v₀` has as
complexity the number of paths of positive length, its circles, plus the rank of its base vertex
group, which is generated by the paths of length zero. This is at most the number of paths and at
least the rank of the subgroup the wedge represents. So every finite subset `S` of `π₁(𝔸, v₀)`
generates the subgroup represented by a finite `𝔸`-graph of complexity at most `#S`, the wedge of
one path in each class of `S`, and the bound can be strict: for `a, a², b` in `⟨a⟩ ∗ ⟨b⟩`, based at
the vertex of `⟨a⟩`, the wedge has one circle and base vertex group `⟨a⟩`, so its complexity is
two.

## Main results

* `TauCeti.GraphOfGroups.AGraph.complexity_wedge`: the complexity of the wedge is the number of
  paths of positive length plus the rank of its base vertex group.
* `TauCeti.GraphOfGroups.AGraph.complexity_wedge_le_card`,
  `TauCeti.GraphOfGroups.AGraph.rank_subgroup_wedge_le_complexity`,
  `TauCeti.GraphOfGroups.AGraph.complexity_wedge_eq_card`: the complexity is at most the number of
  paths and at least the rank of the represented subgroup, hence equal to the number of paths when
  no smaller family generates that subgroup.
* `TauCeti.GraphOfGroups.AGraph.exists_isFinite_subgroup_eq_closure_complexity_le_card`: every
  finite subset `S` of `π₁(𝔸, v₀)` generates the subgroup represented by a finite `𝔸`-graph of
  complexity at most `#S`.

## References

* I. Kapovich, R. Weidmann, A. Myasnikov, *Foldings, graphs of groups and the membership problem*,
  Internat. J. Algebra Comput. 15 (2005), §5, Definition 5.1 and Lemma 5.3; §6, Definition 6.1 and
  the proof of Theorem 6.2.
-/

public section

universe u v w x u'

namespace TauCeti

namespace GraphOfGroups

namespace AGraph

variable {Γ : SerreGraph.{u, v}} {𝔸 : GraphOfGroups.{u, v, w, x} Γ} {v₀ : Γ.V} {ι : Type u'}

/-- The vertex group of the wedge at its base vertex has the rank of `wedgeGroup p`. -/
private theorem rankGrp_wedge_base (p : ι → 𝔸.AlternatingPath v₀ v₀) [Group.FG (wedgeGroup p)] :
    (wedge p).rankGrp (wedge p).base = Group.rank (wedgeGroup p) := by
  let e : (wedge p).grp (wedge p).base ≃* wedgeGroup p :=
    ((MulEquiv.cast (M := 𝔸.vertexGroup) (wedge p).typ_base).subgroupMap _).trans
      (MulEquiv.subgroupCongr (map_grp_wedge_base p))
  have : Group.FG ((wedge p).grp (wedge p).base) := IsMulFG.of_surjective e.symm e.symm.surjective
  rw [rankGrp_eq]
  exact Group.rank_congr e

/-- The vertex groups of the wedge away from its base vertex have rank zero. -/
private theorem rankGrp_wedge_of_ne_base (p : ι → 𝔸.AlternatingPath v₀ v₀) {z : (wedge p).graph.V}
    (hz : z ≠ (wedge p).base) : (wedge p).rankGrp z = 0 := by
  have : Group.FG ((wedge p).grp z) := by
    rw [grp_wedge_of_ne_base p hz]
    infer_instance
  rw [rankGrp_eq, Subgroup.rank_congr (grp_wedge_of_ne_base p hz)]
  exact Group.rank_eq_zero _

/-- The complexity of the wedge of a family of closed alternating paths with finitely many paths
of positive length and a finitely generated base vertex group is the number of paths of positive
length plus the rank of the base vertex group, which is generated by the paths of length zero
(Kapovich, Weidmann and Myasnikov, Definitions 5.1 and 6.1). -/
theorem complexity_wedge (p : ι → 𝔸.AlternatingPath v₀ v₀) [Finite {i // (p i).length ≠ 0}]
    [Group.FG (wedgeGroup p)] :
    (wedge p).complexity = Nat.card {i // (p i).length ≠ 0} + Group.rank (wedgeGroup p) := by
  have h := card_V_wedge_add_card p
  rw [complexity_def, finsum_eq_single _ _ fun z hz => rankGrp_wedge_of_ne_base p hz,
    rankGrp_wedge_base]
  omega

/-- The complexity of the wedge of a finite family of closed alternating paths is at most the number
of paths. -/
theorem complexity_wedge_le_card [Finite ι] (p : ι → 𝔸.AlternatingPath v₀ v₀) :
    (wedge p).complexity ≤ Nat.card ι := by
  have h₁ := rank_wedgeGroup_le p
  have h₂ : Nat.card ι = Nat.card {i // (p i).length = 0} + Nat.card {i // (p i).length ≠ 0} :=
    (Nat.card_congr (Equiv.sumCompl fun i => (p i).length = 0)).symm.trans Nat.card_sum
  rw [complexity_wedge]
  omega

/-- The subgroup represented by the wedge of a family of closed alternating paths with finitely
many paths of positive length and a finitely generated base vertex group is generated by at most as
many elements as the complexity of the wedge: generators of the base vertex group and the classes of
the paths of positive length. -/
theorem rank_subgroup_wedge_le_complexity (p : ι → 𝔸.AlternatingPath v₀ v₀)
    [Finite {i // (p i).length ≠ 0}] [Group.FG (wedgeGroup p)] :
    Group.rank (wedge p).subgroup ≤ (wedge p).complexity := by
  obtain ⟨T, hT, hK⟩ := Group.rank_spec (wedgeGroup p)
  set f := (π₁.vertexHom (Quiver.Path.nil : 𝔸.Path ⟨v₀⟩ ⟨v₀⟩)).comp (wedgeGroup p).subtype
  set R := Set.range fun c : {i // (p i).length ≠ 0} => π₁.mk (p c).toPath
  have h : (wedge p).subgroup = Subgroup.closure (f '' T ∪ R) := by
    rw [subgroup_wedge_eq_sup, Subgroup.closure_union, ← MonoidHom.map_closure, hK,
      ← MonoidHom.range_eq_map, MonoidHom.range_comp, Subgroup.range_subtype]
  have h₁ : Nat.card ↥(f '' T ∪ R) ≤ T.card + Nat.card {i // (p i).length ≠ 0} :=
    (Set.card_union_le _ _).trans (add_le_add ((Finite.card_image_le f).trans_eq
      (Nat.card_eq_finsetCard T)) (Finite.card_range_le _))
  rw [Subgroup.rank_congr h, complexity_wedge]
  have h₂ := Subgroup.rank_closure_finite_le_nat_card (f '' T ∪ R)
  omega

/-- The complexity of the wedge of a finite family of closed alternating paths is the number of
paths when no smaller family generates the subgroup they generate. -/
theorem complexity_wedge_eq_card [Finite ι] (p : ι → 𝔸.AlternatingPath v₀ v₀)
    (h : Nat.card ι ≤ Group.rank (wedge p).subgroup) : (wedge p).complexity = Nat.card ι :=
  (complexity_wedge_le_card p).antisymm (h.trans (rank_subgroup_wedge_le_complexity p))

/-- For every finite subset `S` of `π₁(𝔸, v₀)` there is a finite `𝔸`-graph which represents the
subgroup generated by `S` and has complexity at most `#S`: the wedge of a family of closed
alternating paths, one in the class of each element of `S` (Kapovich, Weidmann and Myasnikov,
Definition 5.1 and Lemma 5.3 for the represented subgroup, Definition 6.1 and the proof of
Theorem 6.2 for the complexity). -/
theorem exists_isFinite_subgroup_eq_closure_complexity_le_card (𝔸 : GraphOfGroups.{u, v, w, x} Γ)
    (v₀ : Γ.V) (S : Finset (π₁ 𝔸 v₀)) :
    ∃ B : AGraph.{u, v, w, x, 0, 0} 𝔸 v₀, B.IsFinite ∧
      B.subgroup = Subgroup.closure (S : Set (π₁ 𝔸 v₀)) ∧ B.complexity ≤ S.card := by
  -- Every element of `π₁(𝔸, v₀)` is the class of an alternating path: its normal word.
  let q (s : π₁ 𝔸 v₀) := (π₁.normalWordEquiv (fun _ _ _ => default) v₀ s).toAlternatingPath
  have hq (s : π₁ 𝔸 v₀) : π₁.mk (q s).toPath = s := by
    rw [← NormalWord.toPath_def, ← π₁.normalWordEquiv_symm_apply (fun _ _ _ => default) v₀,
      Equiv.symm_apply_apply]
  refine ⟨wedge fun i : Fin S.card => q (S.equivFin.symm i), isFinite_wedge _, ?_,
    (complexity_wedge_le_card _).trans_eq (Nat.card_fin _)⟩
  rw [subgroup_wedge]
  simp_rw [hq]
  exact congrArg Subgroup.closure
    ((EquivLike.range_comp Subtype.val S.equivFin.symm).trans (by simp))

/-- The wedge of `a, a², b`, for a nontrivial element `a` of the vertex group `A_{v₀}` and a closed
path `b` of positive length, has complexity two although it is the wedge of three paths: its base
vertex group `⟨a, a²⟩ = ⟨a⟩` has rank one and it has one circle. In `⟨a⟩ ∗ ⟨b⟩`, based at the
vertex of `⟨a⟩`, this is the wedge of the generating set `{a, a², b}`. -/
example (a : 𝔸.vertexGroup v₀) (ha : a ≠ 1) (b : 𝔸.AlternatingPath v₀ v₀) (hb : b.length ≠ 0) :
    (wedge ![.single a, .single (a ^ 2), b]).complexity = 2 := by
  have hK : wedgeGroup ![.single a, .single (a ^ 2), b] =
      Subgroup.closure (({a} : Finset (𝔸.vertexGroup v₀)) : Set (𝔸.vertexGroup v₀)) := by
    rw [Finset.coe_singleton]
    refine le_antisymm (wedgeGroup_le.2 fun i g hi => ?_) ((Subgroup.closure_le _).2
      (Set.singleton_subset_iff.2 (mem_wedgeGroup_of_eq_single (i := 0) rfl)))
    fin_cases i
    · exact AlternatingPath.single.inj hi ▸ Subgroup.subset_closure rfl
    · exact AlternatingPath.single.inj hi ▸ pow_mem (Subgroup.subset_closure rfl) 2
    · exact absurd (AlternatingPath.length_eq_zero_iff.2 ⟨g, hi⟩) hb
  have h₁ : Group.rank (wedgeGroup ![.single a, .single (a ^ 2), b]) ≤ 1 :=
    (Subgroup.rank_congr hK).trans_le (Subgroup.rank_closure_finset_le_card {a})
  have : Nontrivial (wedgeGroup ![.single a, .single (a ^ 2), b]) :=
    ⟨⟨a, mem_wedgeGroup_of_eq_single (i := 0) rfl⟩, 1, fun h => ha (congrArg Subtype.val h)⟩
  have h₂ := Group.rank_pos (G := wedgeGroup ![.single a, .single (a ^ 2), b])
  have h₃ : Nat.card {i : Fin 3 // (![.single a, .single (a ^ 2), b] i).length ≠ 0} = 1 := by
    refine Nat.card_eq_one_iff_unique.2 ⟨⟨?_⟩, ⟨⟨2, hb⟩⟩⟩
    rintro ⟨i, hi⟩ ⟨j, hj⟩
    fin_cases i <;> fin_cases j <;> first | rfl | exact absurd (AlternatingPath.length_single _) ‹_›
  rw [complexity_wedge, h₃]
  omega

end AGraph

end GraphOfGroups

end TauCeti
