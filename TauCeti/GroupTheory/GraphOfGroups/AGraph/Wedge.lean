module

public import TauCeti.GroupTheory.GraphOfGroups.AGraph
public import TauCeti.GroupTheory.GraphOfGroups.NormalForm

/-!
# The wedge of a finite set of elements of the fundamental group

Let `𝔸` be a graph of groups and `S` a finite subset of `π₁(𝔸, v₀)`. Write every element `s ∈ S`
as the class of an alternating `𝔸`-path `g₀, e₁, g₁, …, e_k, g_k` at `v₀`. The `S`-wedge of
Kapovich, Weidmann and Myasnikov is the `𝔸`-graph with a base vertex `u₀` of type `v₀`, whose vertex
group is the subgroup `K ≤ A_{v₀}` generated by the elements `s` with `k = 0`, and, for every `s`
with `k ≥ 1`, a circle through `u₀` subdivided into `k` edges, of types `e₁, …, e_k`, whose labels
read `s` around the circle; the other vertices have trivial vertex groups. It represents the
subgroup `⟨S⟩`, and its complexity, the rank of its underlying graph plus the sum of the ranks of
its vertex groups, is the number of circles plus the rank of `K`, hence at most `#S`.

Here every circle has at least two edges: an element written with a single dart `e`, a loop of the
underlying graph at `v₀`, is written as `g₀ e g₁ e 1 e⁻¹ 1` instead.

## Main results

* `TauCeti.GraphOfGroups.AGraph.exists_wedge`: for every finite subset `S` of `π₁(𝔸, v₀)` there is
  a finite `𝔸`-graph representing the subgroup generated by `S`, with complexity at most `#S`.

## References

* I. Kapovich, R. Weidmann, A. Myasnikov, *Foldings, graphs of groups and the membership problem*,
  Internat. J. Algebra Comput. 15 (2005), §5, Definition 5.1 and Lemma 5.3; §6, Definition 6.1 and
  the proof of Theorem 6.2.
-/

public section

universe u v w x u' v'

namespace TauCeti

namespace GraphOfGroups

variable {Γ : SerreGraph.{u, v}} {𝔸 : GraphOfGroups.{u, v, w, x} Γ}

/-! ### Paths indexed from the front -/

variable (𝔸) in
/-- An alternating `𝔸`-path `g₀, e₀, g₁, e₁, …, g_n, e_n, h` from `x` to `y` with `n + 1` darts,
indexed from the front. Its vertices are `x = c₀, c₁, …, c_n` followed by `y`, where
`c = Fin.cons x vt`; the dart `e_j` runs from `c_j` to `c_{j+1}` for `j < n`, and the last dart
`e_n` from `c_n` to `y`. -/
private structure IndexedPath (x y : Γ.V) (n : ℕ) where
  /-- The vertices `c_1, …, c_n` reached by the first `n` darts. -/
  vt : Fin n → Γ.V
  /-- The first `n` darts. -/
  dt : ∀ j : Fin n,
    (Fin.cons x vt : Fin (n + 1) → Γ.V) j.castSucc ⟶ (Fin.cons x vt : Fin (n + 1) → Γ.V) j.succ
  /-- The vertex group elements before the first `n` darts. -/
  lab : ∀ j : Fin n, 𝔸.vertexGroup ((Fin.cons x vt : Fin (n + 1) → Γ.V) j.castSucc)
  /-- The last dart. -/
  lastDart : (Fin.cons x vt : Fin (n + 1) → Γ.V) (Fin.last n) ⟶ y
  /-- The vertex group element before the last dart. -/
  lastLab : 𝔸.vertexGroup ((Fin.cons x vt : Fin (n + 1) → Γ.V) (Fin.last n))
  /-- The vertex group element after the last dart. -/
  endLab : 𝔸.vertexGroup y

namespace IndexedPath

variable {x y z : Γ.V} {n : ℕ}

/-- The initial segments `g₀, e₀, …, g_{k-1}, e_{k-1}` of an indexed path, from `x` to `c_k`. -/
private def pre (t : IndexedPath 𝔸 x y n) :
    ∀ k : Fin (n + 1), 𝔸.Path ⟨x⟩ ⟨(Fin.cons x t.vt : Fin (n + 1) → Γ.V) k⟩ :=
  Fin.induction (motive := fun k => 𝔸.Path ⟨x⟩ ⟨(Fin.cons x t.vt : Fin (n + 1) → Γ.V) k⟩)
    .nil fun j p => (p.cons (Letter.vertex (t.lab j))).cons (Letter.dart (t.dt j))

/-- The `𝔸`-path spelled by an indexed path. -/
private def toPath (t : IndexedPath 𝔸 x y n) : 𝔸.Path ⟨x⟩ ⟨y⟩ :=
  (((t.pre (Fin.last n)).cons (Letter.vertex t.lastLab)).cons (Letter.dart t.lastDart)).cons
    (Letter.vertex t.endLab)

/-- The indexed path `g, e, h` with a single dart. -/
private def single (g : 𝔸.vertexGroup x) (e : x ⟶ y) (h : 𝔸.vertexGroup y) :
    IndexedPath 𝔸 x y 0 where
  vt := Fin.elim0
  dt j := j.elim0
  lab j := j.elim0
  lastDart := e
  lastLab := g
  endLab := h

/-- Prepending a vertex group element `g` and a dart `e` to an indexed path. -/
private def step (g : 𝔸.vertexGroup x) (e : x ⟶ z) (t : IndexedPath 𝔸 z y n) :
    IndexedPath 𝔸 x y (n + 1) where
  vt := Fin.cons z t.vt
  dt := Fin.cons e t.dt
  lab := Fin.cons g t.lab
  lastDart := t.lastDart
  lastLab := t.lastLab
  endLab := t.endLab

/-- The indexed path `g, e, h` spells `g e h`. -/
private theorem toPath_single (g : 𝔸.vertexGroup x) (e : x ⟶ y) (h : 𝔸.vertexGroup y) :
    (single g e h).toPath = ((Path.ofVertex g).comp (Path.ofDart e)).comp (Path.ofVertex h) := by
  rw [Path.comp_ofDart, Path.comp_ofVertex, Path.ofVertex_eq_nil_cons]
  rfl

/-- The initial segments of `step g e t` are `g e` followed by those of `t`. -/
private theorem pre_step_succ (g : 𝔸.vertexGroup x) (e : x ⟶ z) (t : IndexedPath 𝔸 z y n)
    (k : Fin (n + 1)) :
    (step g e t).pre k.succ = ((Path.ofVertex g).comp (Path.ofDart e)).comp (t.pre k) := by
  induction k using Fin.induction with
  | zero =>
    rw [Path.comp_ofDart, Path.ofVertex_eq_nil_cons]
    rfl
  | succ k ih =>
    -- `Fin.induction` at `k.succ.succ` appends two letters to the path at `k.castSucc.succ`.
    change (((step g e t).pre k.castSucc.succ).cons _).cons _ = _
    rw [ih]
    rfl

/-- The path spelled by `step g e t` is `g e` followed by the path spelled by `t`. -/
private theorem toPath_step (g : 𝔸.vertexGroup x) (e : x ⟶ z) (t : IndexedPath 𝔸 z y n) :
    (step g e t).toPath = ((Path.ofVertex g).comp (Path.ofDart e)).comp t.toPath :=
  congrArg (fun p => ((p.cons (Letter.vertex t.lastLab)).cons (Letter.dart t.lastDart)).cons
    (Letter.vertex t.endLab)) (pre_step_succ g e t (Fin.last n))

/-- Reading `p` without its last element `g`, then `g` and a path `r`, is reading `p` and `r`. -/
private theorem toPath_setLast_one_comp_homotopic {y' : 𝔸.LetterVertex} (p : 𝔸.AlternatingPath x z)
    (r : 𝔸.Path ⟨z⟩ y') :
    Path.Homotopic ((p.setLast 1).toPath.comp ((Path.ofVertex p.last).comp r))
      (p.toPath.comp r) := by
  have h := (AlternatingPath.toPath_setLast_mul_homotopic (p.setLast 1) p.last).symm
  rw [AlternatingPath.last_setLast, one_mul, AlternatingPath.setLast_setLast,
    AlternatingPath.setLast_last] at h
  rw [← Quiver.Path.comp_assoc, Path.comp_ofVertex]
  exact h.comp_right r

/-- Prepending an alternating path `p` from `x` to `z`, without its last element, to an indexed
path from `z` to `y`. -/
private theorem exists_toPath_homotopic_comp {z : Γ.V} (p : 𝔸.AlternatingPath x z)
    (t : IndexedPath 𝔸 z y n) : ∃ (n' : ℕ) (t' : IndexedPath 𝔸 x y n'),
      Path.Homotopic t'.toPath ((p.setLast 1).toPath.comp t.toPath) := by
  induction p generalizing n with
  | single g =>
    refine ⟨n, t, ?_⟩
    simpa only [AlternatingPath.setLast_single, AlternatingPath.toPath_single,
      Quiver.Path.nil_comp] using (Path.Homotopic.ofVertex_one.comp_right t.toPath).symm
  | cons p e g ih =>
    obtain ⟨n', t', h⟩ := ih (step p.last e t)
    refine ⟨n', t', h.trans ?_⟩
    rw [toPath_step, AlternatingPath.setLast_cons, AlternatingPath.toPath_cons,
      Quiver.Path.comp_assoc]
    refine (toPath_setLast_one_comp_homotopic p _).trans ?_
    rw [← Quiver.Path.comp_assoc, Path.comp_ofDart]
    exact (Path.Homotopic.one _).symm.comp_right _

/-- An indexed path `g, e, h` with a single dart, a loop, is homotopic to the indexed path
`g, e, h, e, 1, e⁻¹, 1` with three darts. -/
private theorem exists_toPath_homotopic_single (g : 𝔸.vertexGroup x) (e : x ⟶ x)
    (h : 𝔸.vertexGroup x) :
    ∃ t' : IndexedPath 𝔸 x x 2, Path.Homotopic t'.toPath (single g e h).toPath := by
  refine ⟨step g e (step h e (single 1 (Quiver.reverse e) 1)), ?_⟩
  rw [toPath_step, toPath_step, toPath_single, toPath_single]
  simp only [Path.comp_ofVertex, Path.comp_ofDart, Quiver.Path.comp_cons]
  exact (Path.Homotopic.one _).trans (((Path.Homotopic.one _).cons _).trans
    (Path.Homotopic.dart_reverse _ _))

end IndexedPath

/-- Every element of `π₁(𝔸, a)` outside the vertex group `A_a` is the class of an indexed path
with at least two darts. -/
private theorem exists_indexedPath {a : Γ.V} (s : π₁ 𝔸 a)
    (hs : s ∉ Set.range (π₁.vertexHom (Quiver.Path.nil : 𝔸.Path ⟨a⟩ ⟨a⟩))) :
    ∃ c : Σ n, IndexedPath 𝔸 a a (n + 1), π₁.mk c.2.toPath = s := by
  obtain ⟨p, rfl⟩ := π₁.mk_surjective s
  -- An alternating path homotopic to `p`: its normal form for some choice of transversals.
  obtain ⟨q, hq⟩ : ∃ q : 𝔸.AlternatingPath a a, Path.Homotopic q.toPath p :=
    ⟨_, NormalWord.toPath_def (normalForm (fun _ _ _ => default) p) ▸
      toPath_normalForm_homotopic _ p⟩
  cases q with
  | single g =>
    refine absurd ⟨g, ?_⟩ hs
    rw [π₁.vertexHom_nil_apply, ← AlternatingPath.toPath_single]
    exact π₁.mk_eq_mk_iff.2 hq
  | cons q e g =>
    obtain ⟨n, t, ht⟩ := IndexedPath.exists_toPath_homotopic_comp q (.single q.last e g)
    have key : Path.Homotopic t.toPath p := by
      refine ht.trans (Path.Homotopic.trans ?_ hq)
      rw [IndexedPath.toPath_single, Quiver.Path.comp_assoc]
      refine (IndexedPath.toPath_setLast_one_comp_homotopic q _).trans ?_
      rw [AlternatingPath.toPath_cons, ← Quiver.Path.comp_assoc, Path.comp_ofDart,
        Path.comp_ofVertex]
      exact .refl _
    cases n with
    | zero =>
      obtain ⟨t', ht'⟩ :=
        IndexedPath.exists_toPath_homotopic_single (x := a) t.lastLab t.lastDart t.endLab
      exact ⟨⟨1, t'⟩, π₁.mk_eq_mk_iff.2 (ht'.trans key)⟩
    | succ n => exact ⟨⟨n, t⟩, π₁.mk_eq_mk_iff.2 key⟩

/-- Transport of vertex group elements along two equalities of vertices. -/
private theorem mulEquiv_cast_cast {a b c : Γ.V} (h₁ : a = b) (h₂ : b = c) (g : 𝔸.vertexGroup a) :
    MulEquiv.cast (M := 𝔸.vertexGroup) h₂ (MulEquiv.cast (M := 𝔸.vertexGroup) h₁ g) =
      MulEquiv.cast (M := 𝔸.vertexGroup) (h₁.trans h₂) g := by
  subst h₁ h₂
  rfl

/-- Appending the letters `g, d, h` to a path. -/
private theorem homotopic_comp_ofVertex_ofDart_ofVertex {x : 𝔸.LetterVertex} {a b : Γ.V}
    (p : 𝔸.Path x ⟨a⟩) (g : 𝔸.vertexGroup a) (d : a ⟶ b) (h : 𝔸.vertexGroup b) :
    Path.Homotopic (p.comp (((Path.ofVertex g).comp (Path.ofDart d)).comp (Path.ofVertex h)))
      (((p.cons (Letter.vertex g)).cons (Letter.dart d)).cons (Letter.vertex h)) := by
  rw [← Quiver.Path.comp_assoc, ← Quiver.Path.comp_assoc, Path.comp_ofVertex, Path.comp_ofDart,
    Path.comp_ofVertex]
  exact .refl _

/-! ### The wedge -/

namespace AGraph

variable {v₀ : Γ.V} {m : ℕ} (n : Fin m → ℕ)

/-- The vertex at position `k` of the `i`-th circle of the wedge: the base vertex `none` at
position `0`, and the vertex `some ⟨i, j⟩` at position `j + 1`. -/
private def wedgePos (i : Fin m) : Fin (n i + 2) → Option (Σ i, Fin (n i + 1)) :=
  Fin.cons none fun j => some ⟨i, j⟩

/-- The sources of the darts of the wedge. The `i`-th circle has the darts `⟨i, some j⟩` from
position `j` to position `j + 1` and the dart `⟨i, none⟩` from position `n i + 1` back to the base
vertex; the second component `false` marks the reverse darts. -/
private abbrev wedgeSrc : (Σ i, Option (Fin (n i + 1))) × Bool → Option (Σ i, Fin (n i + 1))
  | (⟨i, some j⟩, true) => wedgePos n i j.castSucc
  | (⟨i, some j⟩, false) => some ⟨i, j⟩
  | (⟨i, none⟩, true) => some ⟨i, Fin.last (n i)⟩
  | (⟨_, none⟩, false) => none

/-- The underlying graph of the wedge: circles with `n i + 2` edges, glued at a base vertex. -/
private abbrev wedgeGraph : SerreGraph.{0, 0} where
  V := Option (Σ i, Fin (n i + 1))
  E := (Σ i, Option (Fin (n i + 1))) × Bool
  src := wedgeSrc n
  rev e := (e.1, !e.2)
  rev_rev e := by simp
  rev_ne e := by
    obtain ⟨d, _ | _⟩ := e <;> simp

variable {n}

/-- The types of the vertices of the wedge. -/
private def wedgeTyp (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) : Option (Σ i, Fin (n i + 1)) → Γ.V
  | none => v₀
  | some ⟨i, j⟩ => (t i).vt j

/-- The types of the darts of the wedge. -/
private def wedgeDart (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) :
    (Σ i, Option (Fin (n i + 1))) × Bool → Γ.E
  | (⟨i, some j⟩, true) => ((t i).dt j).1
  | (⟨i, some j⟩, false) => Γ.rev ((t i).dt j).1
  | (⟨i, none⟩, true) => (t i).lastDart.1
  | (⟨i, none⟩, false) => Γ.rev (t i).lastDart.1

/-- The type of the vertex at position `k` of the `i`-th circle. -/
private theorem wedgeTyp_wedgePos (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) (i : Fin m)
    (k : Fin (n i + 2)) :
    wedgeTyp t (wedgePos n i k) = (Fin.cons v₀ (t i).vt : Fin (n i + 2) → Γ.V) k := by
  cases k using Fin.cases <;> rfl

/-- The type map of the wedge. -/
private abbrev wedgeHom (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) : (wedgeGraph n).Hom Γ where
  mapV := wedgeTyp t
  mapE := wedgeDart t
  map_src
    | (⟨i, some j⟩, true) => ((t i).dt j).2.1.trans (wedgeTyp_wedgePos t i j.castSucc).symm
    | (⟨i, some j⟩, false) => (Γ.src_rev _).trans ((t i).dt j).2.2
    | (⟨i, none⟩, true) => (t i).lastDart.2.1
    | (⟨i, none⟩, false) => (Γ.src_rev _).trans (t i).lastDart.2.2
  map_rev
    | (⟨_, some _⟩, true) | (⟨_, none⟩, true) => rfl
    | (⟨_, some _⟩, false) | (⟨_, none⟩, false) => (Γ.rev_rev _).symm

/-- The start labels of the darts of the wedge: the elements `g_j` of the circles before their
darts, and the inverse of the last element after the last dart of a circle. -/
private def wedgeLabel (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) :
    ∀ f : (Σ i, Option (Fin (n i + 1))) × Bool, 𝔸.vertexGroup (Γ.src (wedgeDart t f))
  | (⟨i, some j⟩, true) => MulEquiv.cast (M := 𝔸.vertexGroup) ((t i).dt j).2.1.symm ((t i).lab j)
  | (⟨_, some _⟩, false) => 1
  | (⟨i, none⟩, true) => MulEquiv.cast (M := 𝔸.vertexGroup) (t i).lastDart.2.1.symm (t i).lastLab
  | (⟨i, none⟩, false) => MulEquiv.cast (M := 𝔸.vertexGroup)
      (((t i).lastDart.2.2.symm.trans (Γ.src_rev _).symm)) (t i).endLab⁻¹

/-- The wedge of the circles `t i` at a base vertex with vertex group `K`. -/
private abbrev wedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) (K : Subgroup (𝔸.vertexGroup v₀)) :
    AGraph.{u, v, w, x, 0, 0} 𝔸 v₀ where
  graph := wedgeGraph n
  typ := wedgeHom t
  base := none
  typ_base := rfl
  grp
    | none => K
    | some _ => ⊥
  labelα := wedgeLabel t

/-- The `𝔹`-paths along the `i`-th circle of the wedge, from the base vertex to the vertex at
position `k`. -/
private def circlePath (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) (K : Subgroup (𝔸.vertexGroup v₀))
    (i : Fin m) :
    ∀ k : Fin (n i + 2), (wedge t K).toGraphOfGroups.Path ⟨none⟩ ⟨wedgePos n i k⟩ :=
  Fin.induction (motive := fun k => (wedge t K).toGraphOfGroups.Path ⟨none⟩ ⟨wedgePos n i k⟩)
    .nil fun j p => p.cons (Letter.dart ((wedge t K).graph.dart (⟨i, some j⟩, true)))

/-- The `𝔹`-paths from the base vertex of the wedge to its vertices. -/
private def basePath (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) (K : Subgroup (𝔸.vertexGroup v₀)) :
    ∀ u : (wedge t K).graph.V, (wedge t K).toGraphOfGroups.Path ⟨(wedge t K).base⟩ ⟨u⟩
  | none => .nil
  | some ⟨i, j⟩ => circlePath t K i j.succ

/-- The loop around the `i`-th circle of the wedge. -/
private def circleLoop (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1)) (K : Subgroup (𝔸.vertexGroup v₀))
    (i : Fin m) :
    (wedge t K).toGraphOfGroups.Path ⟨(wedge t K).base⟩ ⟨(wedge t K).base⟩ :=
  (basePath t K ((wedge t K).graph.src (⟨i, none⟩, true))).cons
    (Letter.dart ((wedge t K).graph.dart (⟨i, none⟩, true)))

/-- The letters read along a dart of an `𝔸`-graph, from equalities for its three parts. -/
private theorem letterPath_dart_eq {B : AGraph.{u, v, w, x, u', v'} 𝔸 v₀} (f : B.graph.E)
    {g : 𝔸.vertexGroup (B.typ.mapV (B.graph.src f))}
    {d : B.typ.mapV (B.graph.src f) ⟶ B.typ.mapV (B.graph.tgt f)}
    {h : 𝔸.vertexGroup (B.typ.mapV (B.graph.tgt f))}
    (hg : MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_src f) (B.labelα f) = g)
    (hd : B.typ.mapE f = d.1)
    (hh : MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_tgt _ f) (B.labelω f) = h) :
    B.letterPath (Letter.dart (B.graph.dart f)) =
      ((Path.ofVertex g).comp (Path.ofDart d)).comp (Path.ofVertex h) := by
  obtain rfl : B.typ.toPrefunctor.map (B.graph.dart f) = d := Subtype.ext
    (((SerreGraph.Hom.toPrefunctor_map_val _ _).trans (congrArg _ (SerreGraph.dart_val _ _))).trans
      hd)
  subst hg hh
  exact B.letterPath_dart f

/-- The dart `⟨i, some k⟩` of the wedge reads the letters `g_k, e_k, 1` of the `i`-th indexed
path. -/
private theorem letterPath_chain (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : Fin m) (k : Fin (n i + 1)) :
    (wedge t K).letterPath (Letter.dart ((wedge t K).graph.dart (⟨i, some k⟩, true))) =
      ((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (wedgeTyp_wedgePos t i k.castSucc).symm
        ((t i).lab k))).comp (Path.ofDart (⟨((t i).dt k).1,
          ((t i).dt k).2.1.trans (wedgeTyp_wedgePos t i k.castSucc).symm, ((t i).dt k).2.2⟩ :
            wedgeTyp t (wedgePos n i k.castSucc) ⟶ (t i).vt k))).comp (Path.ofVertex 1) := by
  refine letterPath_dart_eq _ (mulEquiv_cast_cast _ _ _) rfl ?_
  -- The start label of the reverse dart is `1`.
  rw [labelω_def, map_inv, show (wedge t K).labelα ((wedge t K).graph.rev (⟨i, some k⟩, true)) = 1
    from rfl, map_one, map_one, inv_one]
  rfl

/-- The dart `⟨i, none⟩` of the wedge reads the last letters `g_{n+1}, e_{n+1}, h` of the `i`-th
indexed path. -/
private theorem letterPath_last (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : Fin m) :
    (wedge t K).letterPath (Letter.dart ((wedge t K).graph.dart (⟨i, none⟩, true))) =
      ((Path.ofVertex (t i).lastLab).comp (Path.ofDart (t i).lastDart)).comp
        (Path.ofVertex (t i).endLab) := by
  refine letterPath_dart_eq _ (mulEquiv_cast_cast _ _ _) rfl ?_
  -- The start label of the reverse dart is the inverse of the end label.
  rw [labelω_def, map_inv, show (wedge t K).labelα ((wedge t K).graph.rev (⟨i, none⟩, true)) =
    MulEquiv.cast (M := 𝔸.vertexGroup) ((t i).lastDart.2.2.symm.trans (Γ.src_rev _).symm)
      (t i).endLab⁻¹ from rfl]
  exact (congrArg (·⁻¹) ((congrArg (MulEquiv.cast (M := 𝔸.vertexGroup) _)
    (mulEquiv_cast_cast _ _ _)).trans (mulEquiv_cast_cast _ _ _))).trans (inv_inv _)

/-- Along a circle, the path map reads the initial segments of the indexed path. -/
private theorem pathMap_circlePath_homotopic (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : Fin m) (j : Fin (n i + 1)) :
    Path.Homotopic ((wedge t K).pathMap (circlePath t K i j.succ)) ((t i).pre j.succ) := by
  induction j using Fin.induction with
  | zero =>
    -- The path along the circle to position `1` is the first dart; `Fin.induction` unfolds it.
    change Path.Homotopic ((wedge t K).pathMap (Quiver.Path.nil.cons
      (Letter.dart ((wedge t K).graph.dart (⟨i, some 0⟩, true))))) _
    rw [pathMap_cons, pathMap_nil, Quiver.Path.nil_comp, letterPath_chain, Path.comp_ofDart,
      Path.comp_ofVertex, Path.ofVertex_eq_nil_cons]
    exact Path.Homotopic.one _
  | succ j ih =>
    -- `Fin.induction` at `j.succ.succ` appends the dart `⟨i, some j.succ⟩` to the path at
    -- `j.succ.castSucc`, which is `j.castSucc.succ` by definition.
    change Path.Homotopic ((wedge t K).pathMap ((circlePath t K i j.succ.castSucc).cons
      (Letter.dart ((wedge t K).graph.dart (⟨i, some j.succ⟩, true))))) _
    rw [pathMap_cons, letterPath_chain]
    exact (ih.comp_right _).trans ((homotopic_comp_ofVertex_ofDart_ofVertex _ _ _ _).trans
      (Path.Homotopic.one _))

/-- The loop around the `i`-th circle reads the `i`-th indexed path. -/
private theorem π₁Hom_mk_circleLoop (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : Fin m) :
    (wedge t K).π₁Hom (π₁.mk (circleLoop t K i)) = π₁.mk (t i).toPath := by
  rw [π₁Hom_mk]
  refine π₁.mk_eq_mk_iff.2 ?_
  have e : (wedge t K).pathMap (circleLoop t K i) =
      ((wedge t K).pathMap (circlePath t K i (Fin.last (n i)).succ)).comp
        (((Path.ofVertex (t i).lastLab).comp (Path.ofDart (t i).lastDart)).comp
          (Path.ofVertex (t i).endLab)) :=
    (pathMap_cons _ _ _).trans (congrArg
      ((wedge t K).pathMap (circlePath t K i (Fin.last (n i)).succ)).comp (letterPath_last t K i))
  rw [e]
  exact ((pathMap_circlePath_homotopic t K i _).comp_right _).trans
    (homotopic_comp_ofVertex_ofDart_ofVertex _ _ _ _)

/-- The wedge is a finite `𝔸`-graph when its base vertex group is finitely generated. -/
private theorem isFinite_wedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (hK : K.FG) : (wedge t K).IsFinite := by
  -- The vertices of the wedge reduce to `Option _`, so instance search does not find the quiver
  -- of the underlying graph by itself.
  let _ : Quiver (wedge t K).graph.V := SerreGraph.toQuiver _
  refine ⟨inferInstanceAs (Finite ((Σ i, Option (Fin (n i + 1))) × Bool)),
    (SerreGraph.connected_iff _).2
      ⟨⟨none⟩, SerreGraph.preconnected_of_forall_nonempty_path _ none ?_⟩, ?_⟩
  · rintro (_ | ⟨i, j⟩)
    · exact ⟨.nil⟩
    · exact Fin.induction
        (motive := fun k => Nonempty ((wedge t K).graph.Path none (wedgePos n i k))) ⟨.nil⟩
        (fun k ⟨p⟩ => ⟨p.cons ((wedge t K).graph.dart (⟨i, some k⟩, true))⟩) j.succ
  · rintro (_ | _)
    · exact hK
    · exact Subgroup.FG.bot

/-- Along the `i`-th circle, the path to the end of the dart `⟨i, some k⟩` is the path to its
start followed by the dart. -/
private theorem basePath_tgt (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (i : Fin m) (k : Fin (n i + 1)) :
    basePath t K ((wedge t K).graph.tgt (⟨i, some k⟩, true)) =
      (basePath t K ((wedge t K).graph.src (⟨i, some k⟩, true))).cons
        (Letter.dart ((wedge t K).graph.dart (⟨i, some k⟩, true))) := by
  cases k using Fin.cases <;> rfl

/-- Reading the reverse `(d, false)` of a dart `(d, true)` of the wedge. -/
private theorem ofDart_wedge_false (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (d : Σ i, Option (Fin (n i + 1))) :
    Path.ofDart (𝔸 := (wedge t K).toGraphOfGroups) ((wedge t K).graph.dart (d, false)) =
      (Path.ofDart (a := (wedge t K).graph.tgt (d, false)) (b := (wedge t K).graph.src (d, false))
        ((wedge t K).graph.dart (d, true))).reverse := by
  refine (congrArg Path.ofDart (Subtype.ext ?_)).trans (Path.reverse_ofDart _).symm
  have h := (SerreGraph.reverse_val (wedge t K).graph ((wedge t K).graph.dart (d, true))).trans
    (congrArg (wedge t K).graph.rev (SerreGraph.dart_val (wedge t K).graph (d, true)))
  rw [SerreGraph.dart_val]
  exact h.symm

/-- The loop `γ_{o(f)} f γ_{t(f)}⁻¹` of the reverse `f = (d, false)` of a dart `(d, true)` of the
wedge is the inverse of the loop of `(d, true)`. -/
private theorem mk_dartLoop_false (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (d : Σ i, Option (Fin (n i + 1))) :
    π₁.mk (((basePath t K ((wedge t K).graph.src (d, false))).comp
      (Path.ofDart ((wedge t K).graph.dart (d, false)))).comp
        (basePath t K ((wedge t K).graph.tgt (d, false))).reverse) =
      (π₁.mk (((basePath t K ((wedge t K).graph.src (d, true))).comp
        (Path.ofDart ((wedge t K).graph.dart (d, true)))).comp
          (basePath t K ((wedge t K).graph.tgt (d, true))).reverse))⁻¹ := by
  rw [← π₁.mk_reverse]
  refine congrArg π₁.mk ((congrArg (fun p =>
    ((basePath t K ((wedge t K).graph.src (d, false))).comp p).comp
      (basePath t K ((wedge t K).graph.tgt (d, false))).reverse)
        (ofDart_wedge_false t K d)).trans ?_)
  conv_rhs => rw [Quiver.Path.reverse_comp, Quiver.Path.reverse_comp, Quiver.Path.reverse_reverse]
  rw [Quiver.Path.comp_assoc]
  rfl

/-- The loops `γ_{o(f)} f γ_{t(f)}⁻¹` of the darts `(d, true)` of the wedge: trivial for the darts
inside a circle, and the loop around the circle for its last dart. -/
private theorem π₁Hom_mk_dartLoop_true_mem (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) (d : Σ i, Option (Fin (n i + 1))) :
    (wedge t K).π₁Hom (π₁.mk (((basePath t K ((wedge t K).graph.src (d, true))).comp
      (Path.ofDart ((wedge t K).graph.dart (d, true)))).comp
        (basePath t K ((wedge t K).graph.tgt (d, true))).reverse)) ∈
      Subgroup.closure (Set.range fun i => π₁.mk (t i).toPath) := by
  obtain ⟨i, _ | k⟩ := d
  · have h : basePath t K ((wedge t K).graph.tgt (⟨i, none⟩, true)) = .nil := rfl
    rw [h, Path.comp_ofDart]
    -- The path read is the loop around the `i`-th circle, by definition of `circleLoop`.
    change (wedge t K).π₁Hom (π₁.mk ((circleLoop t K i).comp Quiver.Path.nil)) ∈ _
    rw [Quiver.Path.comp_nil, π₁Hom_mk_circleLoop]
    exact Subgroup.subset_closure ⟨i, rfl⟩
  · rw [basePath_tgt, Path.comp_ofDart, π₁.mk_eq_mk_iff.2 (Path.Homotopic.comp_reverse _),
      π₁.mk_nil, map_one]
    exact one_mem _

/-- The wedge represents the subgroup generated by `K` and the classes of its circles
(Kapovich, Weidmann and Myasnikov, Lemma 5.3). -/
private theorem subgroup_wedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) :
    (wedge t K).subgroup = K.map (π₁.vertexHom Quiver.Path.nil) ⊔
      Subgroup.closure (Set.range fun i => π₁.mk (t i).toPath) := by
  refine le_antisymm ?_ (sup_le ?_ ((Subgroup.closure_le _).2 ?_))
  · rw [subgroup_eq_sup _ (basePath t K)]
    refine sup_le (iSup_le fun u => ?_) ((Subgroup.closure_le _).2 ?_)
    · rintro _ ⟨g, rfl⟩
      rcases u with _ | ⟨i, j⟩
      · have h : basePath t K none = .nil := rfl
        rw [MonoidHom.comp_apply, π₁Hom_vertexHom, h, pathMap_nil]
        exact Subgroup.mem_sup_left ⟨g.1, g.2, (rfl)⟩
      · have : g = 1 := Subtype.ext (Subgroup.mem_bot.1 g.2)
        rw [this, map_one]
        exact one_mem _
    · rintro _ ⟨⟨d, _ | _⟩, rfl⟩ <;> beta_reduce
      · refine Subgroup.mem_sup_right ?_
        rw [mk_dartLoop_false, map_inv]
        exact inv_mem (π₁Hom_mk_dartLoop_true_mem t K d)
      · exact Subgroup.mem_sup_right (π₁Hom_mk_dartLoop_true_mem t K d)
  · rintro _ ⟨g, hg, rfl⟩
    rw [subgroup_def]
    refine ⟨π₁.vertexHom (Quiver.Path.nil : (wedge t K).toGraphOfGroups.Path ⟨none⟩ ⟨none⟩)
      ⟨g, hg⟩, ?_⟩
    rw [π₁Hom_vertexHom, pathMap_nil]
    rfl
  · rintro _ ⟨i, rfl⟩
    rw [subgroup_def]
    exact ⟨π₁.mk (circleLoop t K i), π₁Hom_mk_circleLoop t K i⟩

/-- The wedge has `∑ i, (n i + 2)` geometric edges: one for each dart `(d, true)`. -/
private theorem card_geomEdge_wedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) : Nat.card (wedge t K).graph.GeomEdge = ∑ i, (n i + 2) := by
  have hO : (wedge t K).graph.IsOrientation {e | e.2 = true} := by
    rw [SerreGraph.isOrientation_iff]
    rintro ⟨d, _ | _⟩ <;> simp
  -- A dart `(d, true)` of the orientation is determined by `d`.
  let e : {e : (wedge t K).graph.E | e.2 = true} ≃ Σ i, Option (Fin (n i + 1)) :=
    ⟨fun e => e.1.1, fun d => ⟨(d, true), rfl⟩, fun e => Subtype.ext (Prod.ext rfl e.2.symm),
      fun _ => rfl⟩
  rw [← Nat.card_congr (Equiv.ofBijective _ hO.bijective_toGeomEdge), Nat.card_congr e,
    Nat.card_sigma]
  simp

/-- The complexity of the wedge is the number of its circles plus the rank of `K`. -/
private theorem complexity_wedge (t : ∀ i, IndexedPath 𝔸 v₀ v₀ (n i + 1))
    (K : Subgroup (𝔸.vertexGroup v₀)) [Group.FG K] : (wedge t K).complexity = m + Group.rank K := by
  have hV : Nat.card (wedge t K).graph.V = ∑ i, (n i + 1) + 1 := by
    rw [show (wedge t K).graph.V = Option (Σ i, Fin (n i + 1)) from rfl, Finite.card_option,
      Nat.card_sigma]
    simp
  have hR : ∑ᶠ z, (wedge t K).rankGrp z = Group.rank K := by
    have : Group.FG ((wedge t K).grp none) := ‹Group.FG K›
    rw [finsum_eq_single _ none]
    · exact (wedge t K).rankGrp_eq none
    · rintro (_ | z) hz
      · exact absurd rfl hz
      · have : Group.FG ((wedge t K).grp (some z)) := inferInstanceAs (Group.FG (⊥ : Subgroup _))
        rw [(wedge t K).rankGrp_eq (some z)]
        exact Group.rank_eq_zero _
  have hE : ∑ i, (n i + 2) = ∑ i, (n i + 1) + m := by
    simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      smul_eq_mul, mul_one]
    omega
  rw [complexity_def, card_geomEdge_wedge, hV, hR, hE]
  omega

/-- A finite set of elements of `π₁(𝔸, v₀)` outside the vertex group `A_{v₀}` is the set of
classes of a family of indexed paths with at least two darts, indexed by `Fin`. -/
private theorem exists_indexedPath_family (U : Finset (π₁ 𝔸 v₀))
    (hU : ∀ s ∈ U, s ∉ Set.range (π₁.vertexHom (Quiver.Path.nil : 𝔸.Path ⟨v₀⟩ ⟨v₀⟩))) :
    ∃ c : Fin U.card → Σ n, IndexedPath 𝔸 v₀ v₀ (n + 1),
      Set.range (fun i => π₁.mk (c i).2.toPath) = U := by
  choose c hc using fun i => exists_indexedPath _ (hU _ (U.equivFin.symm i).2)
  refine ⟨c, Set.ext fun x => ?_⟩
  simp only [hc, Set.mem_range, Finset.mem_coe]
  exact ⟨by rintro ⟨i, rfl⟩; exact (U.equivFin.symm i).2,
    fun h => ⟨U.equivFin ⟨x, h⟩, by simp⟩⟩

/-- A finite subset `S` of `π₁(𝔸, v₀)` generates the subgroup represented by a finite `𝔸`-graph,
the `S`-wedge, whose complexity is at most `#S` (Kapovich, Weidmann and Myasnikov, Lemma 5.3). -/
theorem exists_wedge (𝔸 : GraphOfGroups.{u, v, w, x} Γ) (v₀ : Γ.V) (S : Finset (π₁ 𝔸 v₀)) :
    ∃ B : AGraph.{u, v, w, x, 0, 0} 𝔸 v₀, B.IsFinite ∧
      B.subgroup = Subgroup.closure (S : Set (π₁ 𝔸 v₀)) ∧ B.complexity ≤ S.card := by
  classical
  -- The elements of `S` in the vertex group `A_{v₀}` generate the base vertex group, through their
  -- preimages in `A_{v₀}`; each of the others gives a circle.
  set f := π₁.vertexHom (Quiver.Path.nil : 𝔸.Path ⟨v₀⟩ ⟨v₀⟩)
  have hf : Set.InjOn f (f ⁻¹' S) := (π₁.vertexHom_injective _).injOn
  obtain ⟨c, hc⟩ := exists_indexedPath_family (S.filter (· ∉ Set.range f))
    fun _ hs => (Finset.mem_filter.1 hs).2
  refine ⟨wedge (fun i => (c i).2) (Subgroup.closure (S.preimage f hf)),
    isFinite_wedge _ _ inferInstance, ?_, ?_⟩
  · rw [subgroup_wedge, MonoidHom.map_closure, ← Subgroup.closure_union, Finset.coe_preimage,
      Set.image_preimage_eq_inter_range, hc, Finset.coe_filter]
    exact congrArg _ (Set.inter_union_sdiff _ _)
  · have h₁ := Subgroup.rank_closure_finset_le_card (S.preimage f hf)
    have h₂ := Finset.card_preimage S f hf
    have h₃ := S.card_filter_add_card_filter_not (· ∈ Set.range f)
    rw [complexity_wedge]
    omega

end AGraph

