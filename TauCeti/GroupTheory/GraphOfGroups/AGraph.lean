/-!
# Graphs labelled by a graph of groups

Let `𝔸` be a graph of groups over a Serre graph `Γ` and `v₀` a vertex of `Γ`. An `𝔸`-graph `B`
based at a vertex of type `v₀` consists of a Serre graph with a base vertex `u₀` and

* a graph morphism `[·]` to `Γ`, the *type* map, with `[u₀] = v₀`;
* for every vertex `u` a subgroup `B_u` of the vertex group `A_[u]`;
* for every dart `f` an element `f_α` of the vertex group `A_{o([f])}`.

The element `f_ω ∈ A_{t([f])}` at the other end of `f` is `((f⁻¹)_α)⁻¹`, so that the condition
`(f⁻¹)_α = (f_ω)⁻¹` of Kapovich, Weidmann and Myasnikov holds by construction; the dart `f` carries
the label `(f_α, [f], f_ω)`.

Reading the labels along paths, an `𝔸`-graph approximates a subgroup of the fundamental group of
`𝔸`. Its graph of groups `𝔹` has the underlying graph of `B`, the vertex groups `B_u` and trivial
edge groups; this is the graph of groups defined by the `𝔸`-graph when `𝔸` has trivial edge groups,
in which case every edge group `B_f ≤ A_[f]` of the general construction is trivial. A `𝔹`-path is
sent to an `𝔸`-path letter by letter: an element `b ∈ B_u` is read as `b ∈ A_[u]`, and a dart `f`
is read as the three letters `f_α, [f], f_ω`. Merging consecutive vertex group letters gives the
path `μ(p)` of Kapovich, Weidmann and Myasnikov. The path map preserves homotopy, so it induces a
homomorphism `ν : π₁(𝔹, u₀) →* π₁(𝔸, v₀)`, whose image is the subgroup `L(B, u₀)` represented by
the `𝔸`-graph. This subgroup only depends on the paths of `𝔹`, not on its edge groups, so it is
defined for every graph of groups `𝔸`.

An `𝔸`-graph is folded when no two distinct darts issuing from a vertex have labels equivalent
under the vertex group and the edge group, and the vertex groups at the two ends of every dart cut
out the same subgroup of the edge group. The complexity of a finite connected `𝔸`-graph is the
rank of its underlying graph plus the sum of the ranks of its vertex groups.

## Main definitions

* `TauCeti.GraphOfGroups.AGraph`: an `𝔸`-graph with a base vertex of type `v₀`.
* `TauCeti.GraphOfGroups.AGraph.toGraphOfGroups`: its graph of groups with trivial edge groups.
* `TauCeti.GraphOfGroups.AGraph.pathMap`: the path map from `𝔹`-paths to `𝔸`-paths.
* `TauCeti.GraphOfGroups.AGraph.π₁Hom`: the homomorphism `ν : π₁(𝔹, u₀) →* π₁(𝔸, v₀)`.
* `TauCeti.GraphOfGroups.AGraph.subgroup`: the subgroup `L(B, u₀)` of `π₁(𝔸, v₀)` represented by
  the `𝔸`-graph.
* `TauCeti.GraphOfGroups.AGraph.IsFolded`: folded `𝔸`-graphs.
* `TauCeti.GraphOfGroups.AGraph.IsFinite`: finite connected `𝔸`-graphs with finitely generated
  vertex groups.
* `TauCeti.GraphOfGroups.AGraph.complexity`: the complexity of an `𝔸`-graph.
* `TauCeti.GraphOfGroups.AGraph.segment`: the `𝔸`-graph with a single edge of label `(a, e, b)`
  over the graph of groups of an amalgamated product.

## Main results

* `TauCeti.GraphOfGroups.Path.Homotopic.pathMap`: the path map preserves homotopy.
* `TauCeti.GraphOfGroups.AGraph.mem_subgroup_iff`: `L(B, u₀)` consists of the elements read along
  the closed `𝔹`-paths at `u₀`.
* `TauCeti.GraphOfGroups.AGraph.subgroup_eq_sup`: for any choice of `𝔹`-paths `γ_u` from `u₀` to
  every vertex `u`, the subgroup `L(B, u₀)` is generated by the images under `ν` of the conjugates
  `γ_u B_u γ_u⁻¹` and of the loops `γ_{o(f)} f γ_{t(f)}⁻¹`.
* `TauCeti.GraphOfGroups.AGraph.segment_subgroup`: the single edge `(a, e, b)` between vertices with
  groups `P₀ ≤ P` and `Q₀ ≤ Q` represents the subgroup `⟨P₀, (a e b) Q₀ (a e b)⁻¹⟩` of the path
  model `π₁(𝔸, v₀)` of the amalgamated product `P ∗_C Q`.
* `TauCeti.GraphOfGroups.AGraph.segment_isFolded_iff`: the single edge is folded exactly when
  `f⁻¹(a⁻¹ P₀ a) = g⁻¹(b Q₀ b⁻¹)` in `C`.
* `TauCeti.GraphOfGroups.AGraph.segment_isFinite_iff`,
  `TauCeti.GraphOfGroups.AGraph.segment_complexity`: the single edge is finite exactly when `P₀`
  and `Q₀` are finitely generated, and then its complexity is `rank P₀ + rank Q₀`.

## References

* I. Kapovich, R. Weidmann, A. Myasnikov, *Foldings, graphs of groups and the membership problem*,
  Internat. J. Algebra Comput. 15 (2005), §3, Definition 3.1, Convention 3.2, Definition 3.3,
  Example 3.4, Convention 3.5, Definition 3.6, Proposition 3.7, Remark 3.8 and Lemma 3.9; §4,
  Definition 4.1 and Example 4.4; §6, Definition 6.1.
-/

public section

universe u v w x u' v'

namespace TauCeti

namespace GraphOfGroups

variable {Γ : SerreGraph.{u, v}}

/-- An `𝔸`-graph based at a vertex of type `v₀`: a Serre graph with a base vertex and a graph
morphism `[·]` to `Γ`, the type map, sending the base vertex to `v₀`, a subgroup `B_u` of the vertex
group `A_[u]` for every vertex `u`, and an element `f_α ∈ A_{o([f])}` for every dart `f`. The
element `f_ω` at the end of `f` is `AGraph.labelω`. -/
structure AGraph (𝔸 : GraphOfGroups.{u, v, w, x} Γ) (v₀ : Γ.V) where
  /-- The underlying graph. -/
  graph : SerreGraph.{u', v'}
  /-- The type map `[·]` from the underlying graph to `Γ`. -/
  typ : graph.Hom Γ
  /-- The base vertex `u₀`. -/
  base : graph.V
  /-- The base vertex has type `v₀`. -/
  typ_base : typ.mapV base = v₀
  /-- The vertex group `B_u ≤ A_[u]` of a vertex `u`. -/
  grp : ∀ z : graph.V, Subgroup (𝔸.vertexGroup (typ.mapV z))
  /-- The element `f_α ∈ A_{o([f])}` at the start of a dart `f`. -/
  labelα : ∀ f : graph.E, 𝔸.vertexGroup (Γ.src (typ.mapE f))

namespace AGraph

variable {𝔸 : GraphOfGroups.{u, v, w, x} Γ} {v₀ : Γ.V} (B : AGraph.{u, v, w, x, u', v'} 𝔸 v₀)

/-- The element `f_ω ∈ A_{t([f])}` at the end of a dart `f`: the inverse of the element `(f⁻¹)_α`
at the start of the reverse dart, read through `[f⁻¹] = [f]⁻¹`. -/
def labelω (f : B.graph.E) : 𝔸.vertexGroup (Γ.tgt (B.typ.mapE f)) :=
  (MulEquiv.cast (M := 𝔸.vertexGroup) ((congrArg Γ.src (B.typ.map_rev f)).trans (Γ.src_rev _))
    (B.labelα (B.graph.rev f)))⁻¹

theorem labelω_def (f : B.graph.E) : B.labelω f =
    (MulEquiv.cast (M := 𝔸.vertexGroup) ((congrArg Γ.src (B.typ.map_rev f)).trans (Γ.src_rev _))
      (B.labelα (B.graph.rev f)))⁻¹ :=
  (rfl)

/-- The label condition `(f⁻¹)_α = (f_ω)⁻¹`, read through `o([f⁻¹]) = t([f])`. -/
theorem labelα_rev (f : B.graph.E) :
    MulEquiv.cast (M := 𝔸.vertexGroup) ((congrArg Γ.src (B.typ.map_rev f)).trans (Γ.src_rev _))
      (B.labelα (B.graph.rev f)) = (B.labelω f)⁻¹ :=
  (inv_inv _).symm

/-- Start labels of equal darts agree after transport to a common vertex group. -/
private theorem cast_labelα_congr {e₁ e₂ : B.graph.E} (h : e₁ = e₂) {a : Γ.V}
    (h₁ : Γ.src (B.typ.mapE e₁) = a) (h₂ : Γ.src (B.typ.mapE e₂) = a) :
    MulEquiv.cast (M := 𝔸.vertexGroup) h₁ (B.labelα e₁) =
      MulEquiv.cast (M := 𝔸.vertexGroup) h₂ (B.labelα e₂) := by
  subst h
  rfl

/-- End labels of equal darts agree after transport to a common vertex group. -/
private theorem cast_labelω_congr {e₁ e₂ : B.graph.E} (h : e₁ = e₂) {a : Γ.V}
    (h₁ : Γ.tgt (B.typ.mapE e₁) = a) (h₂ : Γ.tgt (B.typ.mapE e₂) = a) :
    MulEquiv.cast (M := 𝔸.vertexGroup) h₁ (B.labelω e₁) =
      MulEquiv.cast (M := 𝔸.vertexGroup) h₂ (B.labelω e₂) := by
  subst h
  rfl

/-- The label condition `(f⁻¹)_ω = (f_α)⁻¹`, read through `t([f⁻¹]) = o([f])`. -/
theorem labelω_rev (f : B.graph.E) : MulEquiv.cast (M := 𝔸.vertexGroup)
    ((congrArg Γ.tgt (B.typ.map_rev f)).trans (Γ.tgt_rev _)) (B.labelω (B.graph.rev f)) =
      (B.labelα f)⁻¹ := by
  rw [← inv_inj, inv_inv, ← map_inv, ← B.labelα_rev, MulEquiv.cast_apply, MulEquiv.cast_apply]
  -- Both sides are transports of `labelα (rev (rev f))`, and `rev (rev f) = f`.
  exact eq_of_heq ((cast_heq _ _).trans ((cast_heq _ _).trans
    (congr_arg_heq B.labelα (B.graph.rev_rev f))))

/-! ### The graph of groups of an `𝔸`-graph -/

/-- The graph of groups of an `𝔸`-graph: the underlying graph, the vertex groups `B_u` and trivial
edge groups. When `𝔸` has trivial edge groups this is the graph of groups defined by the
`𝔸`-graph, whose edge group `B_f` is a subgroup of the trivial group `A_[f]`. -/
abbrev toGraphOfGroups : GraphOfGroups.{u', v', w, 0} B.graph where
  vertexGroup z := B.grp z
  edgeGroup _ := Unit
  ω _ := 1
  ω_injective _ _ _ _ := Subsingleton.elim _ _

@[simp] theorem toGraphOfGroups_ω (e : B.graph.E)
    (c : B.toGraphOfGroups.edgeGroup (B.graph.toGeomEdge e)) : B.toGraphOfGroups.ω e c = 1 :=
  (rfl)

@[simp] theorem toGraphOfGroups_α (e : B.graph.E)
    (c : B.toGraphOfGroups.edgeGroup (B.graph.toGeomEdge e)) : B.toGraphOfGroups.α e c = 1 := by
  rw [α_apply, toGraphOfGroups_ω, map_one]

/-! ### The path map -/

/-- The `𝔸`-path read along a letter of a `𝔹`-path: an element `b ∈ B_u` is read as the letter
`b ∈ A_[u]`, and a dart `f` as the letters `f_α, [f], f_ω`. -/
def letterPath : ∀ {x y : B.toGraphOfGroups.LetterVertex}, B.toGraphOfGroups.Letter x y →
    𝔸.Path ⟨B.typ.mapV x.as⟩ ⟨B.typ.mapV y.as⟩
  | _, _, .vertex g => Path.ofVertex g.1
  | _, _, .dart f =>
    ((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup)
        ((B.typ.map_src f.1).trans (congrArg B.typ.mapV f.2.1)) (B.labelα f.1))).comp
      (Path.ofDart (a := B.typ.mapV _) (b := B.typ.mapV _) (B.typ.toPrefunctor.map f))).comp
      (Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup)
        ((B.typ.map_tgt _ f.1).trans (congrArg B.typ.mapV f.2.2)) (B.labelω f.1)))

@[simp] theorem letterPath_vertex {a : B.graph.V} (g : B.grp a) :
    B.letterPath (Letter.vertex (𝔸 := B.toGraphOfGroups) g) =
      Path.ofVertex (g : 𝔸.vertexGroup _) :=
  (rfl)

@[simp] theorem letterPath_dart (e : B.graph.E) :
    B.letterPath (Letter.dart (𝔸 := B.toGraphOfGroups) (B.graph.dart e)) =
      ((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_src e) (B.labelα e))).comp
        (Path.ofDart (a := B.typ.mapV _) (b := B.typ.mapV _)
          (B.typ.toPrefunctor.map (B.graph.dart e)))).comp
        (Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_tgt _ e) (B.labelω e))) := by
  rw [letterPath, B.cast_labelα_congr (B.graph.dart_val e) _ (B.typ.map_src e),
    B.cast_labelω_congr (B.graph.dart_val e) _ (B.typ.map_tgt _ e)]

/-- The `𝔸`-path read along the dart letter of an arrow `f : a ⟶ b` of the underlying graph: the
letters `f_α, [f], f_ω`, read through `o(f) = a` and `t(f) = b`. -/
theorem letterPath_dart_arrow {a b : B.graph.V} (f : a ⟶ b) :
    B.letterPath (Letter.dart (𝔸 := B.toGraphOfGroups) f) =
      ((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup)
          ((B.typ.map_src f.1).trans (congrArg B.typ.mapV f.2.1)) (B.labelα f.1))).comp
        (Path.ofDart (a := B.typ.mapV _) (b := B.typ.mapV _) (B.typ.toPrefunctor.map f))).comp
        (Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup)
          ((B.typ.map_tgt _ f.1).trans (congrArg B.typ.mapV f.2.2)) (B.labelω f.1))) :=
  (rfl)

/-- The path map: the `𝔸`-path read along a `𝔹`-path, letter by letter. -/
def pathMap {x : B.toGraphOfGroups.LetterVertex} :
    ∀ {y : B.toGraphOfGroups.LetterVertex}, B.toGraphOfGroups.Path x y →
      𝔸.Path ⟨B.typ.mapV x.as⟩ ⟨B.typ.mapV y.as⟩
  | _, .nil => .nil
  | _, .cons p l => (pathMap p).comp (B.letterPath l)

section pathMap

variable {x y z : B.toGraphOfGroups.LetterVertex}

@[simp] theorem pathMap_nil : B.pathMap (Quiver.Path.nil : B.toGraphOfGroups.Path x x) = .nil :=
  (rfl)

@[simp] theorem pathMap_cons (p : B.toGraphOfGroups.Path x y) (l : B.toGraphOfGroups.Letter y z) :
    B.pathMap (p.cons l) = (B.pathMap p).comp (B.letterPath l) :=
  (rfl)

@[simp] theorem pathMap_comp (p : B.toGraphOfGroups.Path x y) (q : B.toGraphOfGroups.Path y z) :
    B.pathMap (p.comp q) = (B.pathMap p).comp (B.pathMap q) := by
  induction q with
  | nil => simp
  | cons q l ih => simp [ih, Quiver.Path.comp_assoc]

@[simp] theorem pathMap_ofVertex {a : B.graph.V} (g : B.grp a) :
    B.pathMap (Path.ofVertex (𝔸 := B.toGraphOfGroups) g) =
      Path.ofVertex (g : 𝔸.vertexGroup _) := by
  have h := Path.comp_ofVertex (𝔸 := B.toGraphOfGroups) Quiver.Path.nil g
  rw [Quiver.Path.nil_comp] at h
  rw [h, pathMap_cons, pathMap_nil, Quiver.Path.nil_comp, letterPath_vertex]

@[simp] theorem pathMap_ofDart (e : B.graph.E) :
    B.pathMap (Path.ofDart (𝔸 := B.toGraphOfGroups) (B.graph.dart e)) =
      ((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_src e) (B.labelα e))).comp
        (Path.ofDart (a := B.typ.mapV _) (b := B.typ.mapV _)
          (B.typ.toPrefunctor.map (B.graph.dart e)))).comp
        (Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_tgt _ e) (B.labelω e))) := by
  have h := Path.comp_ofDart (𝔸 := B.toGraphOfGroups) Quiver.Path.nil (B.graph.dart e)
  rw [Quiver.Path.nil_comp] at h
  rw [h, pathMap_cons, pathMap_nil, Quiver.Path.nil_comp, letterPath_dart]

/-- The start label of a reversed arrow, transported to its source, is the inverse of the end
label of the arrow. -/
private theorem cast_labelα_reverse {a b : B.graph.V} (f : a ⟶ b) :
    MulEquiv.cast (M := 𝔸.vertexGroup)
        ((B.typ.map_src _).trans (congrArg B.typ.mapV (Quiver.reverse f).2.1))
        (B.labelα (Quiver.reverse f).1) =
      (MulEquiv.cast (M := 𝔸.vertexGroup) ((B.typ.map_tgt _ f.1).trans (congrArg B.typ.mapV f.2.2))
        (B.labelω f.1))⁻¹ := by
  rw [← map_inv, ← B.labelα_rev, MulEquiv.cast_apply, MulEquiv.cast_apply, MulEquiv.cast_apply]
  -- Both sides are transports of `labelα (rev f)`.
  exact eq_of_heq ((cast_heq _ _).trans ((congr_arg_heq B.labelα
    (B.graph.reverse_val f)).trans ((cast_heq _ _).trans (cast_heq _ _)).symm))

/-- The end label of a reversed arrow, transported to its target, is the inverse of the start
label of the arrow. -/
private theorem cast_labelω_reverse {a b : B.graph.V} (f : a ⟶ b) :
    MulEquiv.cast (M := 𝔸.vertexGroup)
        ((B.typ.map_tgt _ _).trans (congrArg B.typ.mapV (Quiver.reverse f).2.2))
        (B.labelω (Quiver.reverse f).1) =
      (MulEquiv.cast (M := 𝔸.vertexGroup) ((B.typ.map_src f.1).trans (congrArg B.typ.mapV f.2.1))
        (B.labelα f.1))⁻¹ := by
  rw [← map_inv, ← B.labelω_rev, MulEquiv.cast_apply, MulEquiv.cast_apply, MulEquiv.cast_apply]
  -- Both sides are transports of `labelω (rev f)`.
  exact eq_of_heq ((cast_heq _ _).trans ((congr_arg_heq B.labelω
    (B.graph.reverse_val f)).trans ((cast_heq _ _).trans (cast_heq _ _)).symm))

/-- Reading the reverse of a letter gives the reverse path. -/
theorem letterPath_reverse (l : B.toGraphOfGroups.Letter x y) :
    B.letterPath (Quiver.reverse (V := B.toGraphOfGroups.LetterVertex) l) =
      (B.letterPath l).reverse := by
  cases l with
  | vertex g =>
    rw [Letter.reverse_vertex, letterPath_vertex, letterPath_vertex, Path.reverse_ofVertex,
      Subgroup.coe_inv]
  | dart f =>
    rw [Letter.reverse_dart, letterPath, letterPath, cast_labelα_reverse, cast_labelω_reverse,
      Prefunctor.map_reverse]
    simp only [Quiver.Path.reverse_comp, Path.reverse_ofVertex, Quiver.Path.comp_assoc,
      Path.reverse_ofDart (a := B.typ.mapV _) (b := B.typ.mapV _) (B.typ.toPrefunctor.map f)]
    -- The endpoints of `Quiver.reverse (B.typ.toPrefunctor.map f)` are `obj b, obj a` on the left
    -- and `mapV b, mapV a` on the right; they agree only after unfolding `Hom.toPrefunctor`.
    rfl

/-- The path map commutes with reversal. -/
@[simp] theorem pathMap_reverse (p : B.toGraphOfGroups.Path x y) :
    B.pathMap p.reverse = (B.pathMap p).reverse := by
  induction p with
  | nil => rfl
  | cons p l ih =>
    rw [Quiver.Path.reverse, pathMap_comp, ih, pathMap_cons, Quiver.Path.reverse_comp,
      Quiver.Hom.toPath, pathMap_cons, pathMap_nil, Quiver.Path.nil_comp, letterPath_reverse]

end pathMap

end AGraph

/-- The path map of an `𝔸`-graph sends homotopic `𝔹`-paths to homotopic `𝔸`-paths. -/
theorem Path.Homotopic.pathMap {𝔸 : GraphOfGroups.{u, v, w, x} Γ} {v₀ : Γ.V}
    (B : AGraph.{u, v, w, x, u', v'} 𝔸 v₀) {x y : B.toGraphOfGroups.LetterVertex}
    {p q : B.toGraphOfGroups.Path x y} (h : p.Homotopic q) :
    (B.pathMap p).Homotopic (B.pathMap q) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | cons _ l ih =>
    rw [AGraph.pathMap_cons, AGraph.pathMap_cons]
    exact ih.comp_right _
  | mul p g h =>
    simp only [AGraph.pathMap_cons, AGraph.letterPath_vertex, Path.comp_ofVertex]
    exact .mul _ _ _
  | one p =>
    simp only [AGraph.pathMap_cons, AGraph.letterPath_vertex, Path.comp_ofVertex]
    exact .one _
  | dart_reverse p f =>
    rw [AGraph.pathMap_cons, AGraph.pathMap_cons, ← Letter.reverse_dart,
      AGraph.letterPath_reverse, Quiver.Path.comp_assoc]
    simpa using (Homotopic.comp_reverse (B.letterPath (Letter.dart f))).comp_left (B.pathMap p)
  | dart_ω e c p =>
    rw [AGraph.pathMap_cons, AGraph.pathMap_cons, AGraph.pathMap_cons, AGraph.pathMap_cons,
      AGraph.toGraphOfGroups_ω, AGraph.toGraphOfGroups_α, AGraph.letterPath_vertex,
      AGraph.letterPath_vertex, Path.comp_ofVertex, Path.comp_ofVertex]
    exact (Homotopic.one _).trans ((Homotopic.one _).comp_right _).symm

namespace AGraph

variable {𝔸 : GraphOfGroups.{u, v, w, x} Γ} {v₀ : Γ.V} (B : AGraph.{u, v, w, x, u', v'} 𝔸 v₀)

/-! ### The represented subgroup -/

/-- The homomorphism `ν : π₁(𝔹, u₀) →* π₁(𝔸, v₀)` induced by the path map, read through
`[u₀] = v₀`. When `𝔸` has trivial edge groups, `𝔹 = B.toGraphOfGroups` is the graph of groups
defined by the `𝔸`-graph; for other `𝔸` its domain is the fundamental group of the graph of groups
with trivial edge groups, which has the same closed paths and hence the same image, but `ν` is then
not the homomorphism of Kapovich, Weidmann and Myasnikov. -/
def π₁Hom : π₁ B.toGraphOfGroups B.base →* π₁ 𝔸 v₀ :=
  (MulEquiv.cast (M := π₁ 𝔸) B.typ_base).toMonoidHom.comp
    { toFun := π₁.lift (fun p => π₁.mk (B.pathMap p)) fun _ _ h =>
        π₁.mk_eq_mk_iff.2 (h.pathMap B)
      map_one' := by
        rw [← π₁.mk_nil, π₁.lift_mk, pathMap_nil, π₁.mk_nil]
      map_mul' x y := π₁.induction_on x fun p => π₁.induction_on y fun q => by
        rw [← π₁.mk_comp, π₁.lift_mk, π₁.lift_mk, π₁.lift_mk, pathMap_comp, π₁.mk_comp] }

@[simp] theorem π₁Hom_mk (p : B.toGraphOfGroups.Path ⟨B.base⟩ ⟨B.base⟩) :
    B.π₁Hom (π₁.mk p) = MulEquiv.cast (M := π₁ 𝔸) B.typ_base (π₁.mk (B.pathMap p)) :=
  congrArg (MulEquiv.cast (M := π₁ 𝔸) B.typ_base) (π₁.lift_mk ..)

/-- The homomorphism `ν` sends the conjugate `p b p⁻¹` of `b ∈ B_u` to the conjugate of `b ∈ A_[u]`
by the path read along `p`. -/
@[simp] theorem π₁Hom_vertexHom {u : B.graph.V} (p : B.toGraphOfGroups.Path ⟨B.base⟩ ⟨u⟩)
    (g : B.grp u) : B.π₁Hom (π₁.vertexHom p g) =
      MulEquiv.cast (M := π₁ 𝔸) B.typ_base (π₁.vertexHom (B.pathMap p) (g : 𝔸.vertexGroup _)) := by
  rw [π₁.vertexHom_apply, π₁Hom_mk, pathMap_comp, pathMap_comp, pathMap_reverse, pathMap_ofVertex,
    π₁.vertexHom_apply]

/-- The image under `ν` of the conjugates `p B_u p⁻¹` of a vertex group by a `𝔹`-path `p`: the
conjugates of `B_u ≤ A_[u]` by the path read along `p`, read through `[u₀] = v₀`. -/
theorem range_π₁Hom_comp_vertexHom {u : B.graph.V} (p : B.toGraphOfGroups.Path ⟨B.base⟩ ⟨u⟩) :
    (B.π₁Hom.comp (π₁.vertexHom p)).range =
      (B.grp u).map ((MulEquiv.cast (M := π₁ 𝔸) B.typ_base).toMonoidHom.comp
        (π₁.vertexHom (B.pathMap p))) := by
  rw [show B.π₁Hom.comp (π₁.vertexHom p) = ((MulEquiv.cast (M := π₁ 𝔸) B.typ_base).toMonoidHom.comp
      (π₁.vertexHom (B.pathMap p))).comp (B.grp u).subtype from
    MonoidHom.ext fun c => B.π₁Hom_vertexHom p c, MonoidHom.range_comp, Subgroup.range_subtype]

/-- The subgroup `L(B, u₀)` of `π₁(𝔸, v₀)` represented by an `𝔸`-graph: the image of `ν`, which
consists of the elements read along the closed `𝔹`-paths at the base vertex. -/
def subgroup : Subgroup (π₁ 𝔸 v₀) :=
  B.π₁Hom.range

theorem subgroup_def : B.subgroup = B.π₁Hom.range :=
  (rfl)

/-- An element of `π₁(𝔸, v₀)` lies in `L(B, u₀)` exactly when it is the class of the `𝔸`-path read
along some closed `𝔹`-path at the base vertex `u₀` (Kapovich, Weidmann and Myasnikov,
Definition 3.6), transported along `[u₀] = v₀`. -/
theorem mem_subgroup_iff {g : π₁ 𝔸 v₀} : g ∈ B.subgroup ↔
    ∃ p : B.toGraphOfGroups.Path ⟨B.base⟩ ⟨B.base⟩,
      MulEquiv.cast (M := π₁ 𝔸) B.typ_base (π₁.mk (B.pathMap p)) = g := by
  rw [subgroup_def, MonoidHom.mem_range]
  constructor
  · rintro ⟨x, rfl⟩
    exact π₁.induction_on x fun p => ⟨p, (B.π₁Hom_mk p).symm⟩
  · rintro ⟨p, rfl⟩
    exact ⟨π₁.mk p, B.π₁Hom_mk p⟩

/-- The induction behind `subgroup_eq_sup`: for a `𝔹`-path `p` from `u₀` to `x`, the element
`γ_{u₀} p γ_x⁻¹` of `π₁(𝔹, u₀)` lies in every subgroup containing the generators. -/
private theorem mk_conj_mem (γ : ∀ u : B.graph.V, B.toGraphOfGroups.Path ⟨B.base⟩ ⟨u⟩)
    {H : Subgroup (π₁ B.toGraphOfGroups B.base)} (hV : ∀ u, (π₁.vertexHom (γ u)).range ≤ H)
    (hE : ∀ e : B.graph.E, π₁.mk (((γ (B.graph.src e)).comp (Path.ofDart (B.graph.dart e))).comp
      (γ (B.graph.tgt e)).reverse) ∈ H) {x : B.toGraphOfGroups.LetterVertex}
    (p : B.toGraphOfGroups.Path ⟨B.base⟩ x) :
    π₁.mk (((γ B.base).comp p).comp (γ x.as).reverse) ∈ H := by
  induction p with
  | nil =>
    convert H.one_mem using 1
    simp
  | cons p l ih =>
    cases l with
    | vertex g =>
      rw [← Path.comp_ofVertex, ← Quiver.Path.comp_assoc, π₁.mk_comp_comp_reverse _ (γ _)]
      exact H.mul_mem ih (hV _ ⟨g, π₁.vertexHom_apply _ _⟩)
    | dart f =>
      obtain ⟨e, rfl, rfl⟩ := f
      rw [(Subtype.ext (B.graph.dart_val e).symm :
          (⟨e, rfl, rfl⟩ : B.graph.src e ⟶ B.graph.tgt e) = B.graph.dart e),
        ← Path.comp_ofDart, ← Quiver.Path.comp_assoc, π₁.mk_comp_comp_reverse _ (γ _)]
      exact H.mul_mem ih (hE e)

/-- Every element of `π₁(𝔹, u₀)` lies in a subgroup containing the generators of
`subgroup_eq_sup`. -/
private theorem mem_of_generators (γ : ∀ u : B.graph.V, B.toGraphOfGroups.Path ⟨B.base⟩ ⟨u⟩)
    {H : Subgroup (π₁ B.toGraphOfGroups B.base)} (hV : ∀ u, (π₁.vertexHom (γ u)).range ≤ H)
    (hE : ∀ e : B.graph.E, π₁.mk (((γ (B.graph.src e)).comp (Path.ofDart (B.graph.dart e))).comp
      (γ (B.graph.tgt e)).reverse) ∈ H) (g : π₁ B.toGraphOfGroups B.base) : g ∈ H := by
  refine π₁.induction_on g fun p => ?_
  -- With `c` the class of `γ_{u₀}`, the induction gives `c p c⁻¹` and `c c c⁻¹`.
  have h₁ := B.mk_conj_mem γ hV hE p
  have h₂ := B.mk_conj_mem γ hV hE (γ B.base)
  simp only [π₁.mk_comp, π₁.mk_reverse, mul_inv_cancel_right] at h₁ h₂
  convert mul_mem (mul_mem (inv_mem h₂) h₁) h₂ using 1
  simp [mul_assoc]

/-- Generators of the represented subgroup. For any family of `𝔹`-paths `γ_u` from the base vertex
`u₀` to every vertex `u`, the subgroup `L(B, u₀)` is generated by the images under `ν` of the
conjugates `γ_u B_u γ_u⁻¹` of the vertex groups and of the loops `γ_{o(f)} f γ_{t(f)}⁻¹`. -/
theorem subgroup_eq_sup (γ : ∀ u : B.graph.V, B.toGraphOfGroups.Path ⟨B.base⟩ ⟨u⟩) :
    B.subgroup = (⨆ u, (B.π₁Hom.comp (π₁.vertexHom (γ u))).range) ⊔
      Subgroup.closure (Set.range fun e : B.graph.E => B.π₁Hom (π₁.mk
        (((γ (B.graph.src e)).comp (Path.ofDart (B.graph.dart e))).comp
          (γ (B.graph.tgt e)).reverse))) := by
  refine le_antisymm ?_ (sup_le (iSup_le fun u => ?_)
    ((Subgroup.closure_le _).2 (Set.range_subset_iff.2 fun e => ⟨_, rfl⟩)))
  swap
  · rw [MonoidHom.range_comp]
    exact Subgroup.map_le_range _ _
  rintro _ ⟨g, rfl⟩
  rw [← Subgroup.mem_comap]
  refine B.mem_of_generators γ (fun u => ?_) (fun e => ?_) g
  · rw [← Subgroup.map_le_iff_le_comap, ← MonoidHom.range_comp]
    exact le_sup_of_le_left (le_iSup_of_le u le_rfl)
  · exact Subgroup.mem_comap.2
      (Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_range_self e)))

/-! ### Folded and finite `𝔸`-graphs -/

/-- The vertex group at the start of a dart `f`, as a subgroup of the vertex group `A_{o([f])}`. -/
def grpSrc (f : B.graph.E) : Subgroup (𝔸.vertexGroup (Γ.src (B.typ.mapE f))) :=
  (B.grp (B.graph.src f)).comap (MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_src f)).toMonoidHom

theorem mem_grpSrc {f : B.graph.E} {c : 𝔸.vertexGroup (Γ.src (B.typ.mapE f))} :
    c ∈ B.grpSrc f ↔
      MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_src f) c ∈ B.grp (B.graph.src f) :=
  Iff.rfl

/-- The vertex group at the end of a dart `f`, as a subgroup of the vertex group `A_{t([f])}`. -/
def grpTgt (f : B.graph.E) : Subgroup (𝔸.vertexGroup (Γ.tgt (B.typ.mapE f))) :=
  (B.grp (B.graph.tgt f)).comap (MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_tgt _ f)).toMonoidHom

theorem mem_grpTgt {f : B.graph.E} {c : 𝔸.vertexGroup (Γ.tgt (B.typ.mapE f))} :
    c ∈ B.grpTgt f ↔
      MulEquiv.cast (M := 𝔸.vertexGroup) (B.typ.map_tgt _ f) c ∈ B.grp (B.graph.tgt f) :=
  Iff.rfl

/-- A folded `𝔸`-graph. Two darts `f₁`, `f₂` issuing from the same vertex `z`, with the same type
`e` and with `(f₂)_α = a' (f₁)_α α_e(c)` for some `a' ∈ B_z` and `c ∈ A_e`, are equal; and for
every dart `f` with label `(a, e, b)` the vertex groups `B_{o(f)}` and `B_{t(f)}` cut out the same
subgroup `α_e⁻¹(a⁻¹ B_{o(f)} a) = ω_e⁻¹(b B_{t(f)} b⁻¹)` of the edge group `A_e`. -/
structure IsFolded : Prop where
  /-- Two darts from the same vertex with equivalent labels are equal. -/
  eq_of_label : ∀ f₁ f₂ : B.graph.E, B.graph.src f₁ = B.graph.src f₂ →
    ∀ he : B.typ.mapE f₂ = B.typ.mapE f₁,
      (∃ a' ∈ B.grpSrc f₁, ∃ c : 𝔸.edgeGroup (Γ.toGeomEdge (B.typ.mapE f₁)),
        MulEquiv.cast (M := fun e => 𝔸.vertexGroup (Γ.src e)) he (B.labelα f₂) =
          a' * B.labelα f₁ * 𝔸.α (B.typ.mapE f₁) c) → f₁ = f₂
  /-- The vertex groups at the two ends of a dart cut out the same subgroup of the edge
  group. -/
  comap_eq : ∀ f : B.graph.E,
    ((B.grpSrc f).map (MulAut.conj (B.labelα f)⁻¹).toMonoidHom).comap (𝔸.α (B.typ.mapE f)) =
      ((B.grpTgt f).map (MulAut.conj (B.labelω f)).toMonoidHom).comap (𝔸.ω (B.typ.mapE f))

/-- A finite `𝔸`-graph: its underlying graph is connected with finitely many darts, hence finite
(`AGraph.IsFinite.finite_V`), and its vertex groups are finitely generated. -/
structure IsFinite : Prop where
  /-- Finitely many darts. -/
  finite_E : Finite B.graph.E
  /-- The underlying graph is connected. -/
  connected : B.graph.Connected
  /-- The vertex groups are finitely generated. -/
  fg : ∀ z, (B.grp z).FG

variable {B} in
/-- A finite `𝔸`-graph has finitely many vertices: every vertex other than the base vertex is the
target of the last dart of a path from the base vertex. -/
theorem IsFinite.finite_V (h : B.IsFinite) : Finite B.graph.V := by
  have := h.finite_E
  refine Set.finite_univ_iff.1 (((Set.finite_range B.graph.tgt).insert B.base).subset
    fun z _ => ?_)
  obtain ⟨p⟩ := (SerreGraph.preconnected_iff _).1 ((SerreGraph.connected_iff _).1 h.connected).2
    B.base z
  cases p with
  | nil => exact Set.mem_insert _ _
  | cons _ e => exact Set.mem_insert_of_mem _ ⟨e.1, e.2.2⟩

open scoped Classical in
/-- The rank of the vertex group `B_z`, the minimal number of generators, or `0` when it is not
finitely generated. -/
noncomputable def rankGrp (z : B.graph.V) : ℕ :=
  if h : (B.grp z).FG then @Group.rank (B.grp z) _ ((Group.fg_iff_subgroup_fg _).2 h) else 0

theorem rankGrp_eq (z : B.graph.V) [Group.FG (B.grp z)] : B.rankGrp z = Group.rank (B.grp z) := by
  simp [rankGrp, (Group.fg_iff_subgroup_fg _).1 ‹_›]

theorem rankGrp_of_not_fg {z : B.graph.V} (h : ¬ (B.grp z).FG) : B.rankGrp z = 0 := by
  simp [rankGrp, h]

variable {B} in
/-- The rank of a vertex group depends only on its isomorphism type. -/
theorem rankGrp_congr {Γ' : SerreGraph} {𝔸' : GraphOfGroups Γ'} {v₀' : Γ'.V} {B' : AGraph 𝔸' v₀'}
    {z : B.graph.V} {z' : B'.graph.V} (e : B.grp z ≃* B'.grp z') :
    B.rankGrp z = B'.rankGrp z' := by
  by_cases h : (B.grp z).FG
  · have : Group.FG (B.grp z) := (Group.fg_iff_subgroup_fg _).2 h
    have : Group.FG (B'.grp z') := (isMulFG_congr e).1 this
    rw [rankGrp_eq, rankGrp_eq, Group.rank_congr e]
  · have h' : ¬ (B'.grp z').FG := fun h' => h ((Group.fg_iff_subgroup_fg _).1
      ((isMulFG_congr e).2 ((Group.fg_iff_subgroup_fg _).2 h')))
    rw [rankGrp_of_not_fg _ h, rankGrp_of_not_fg _ h']

/-- The complexity of an `𝔸`-graph: the rank `#E - #V + 1` of its underlying graph, for a finite
connected graph with `#E` geometric edges and `#V` vertices, plus the sum of the ranks of its vertex
groups. -/
noncomputable def complexity : ℕ :=
  (Nat.card B.graph.GeomEdge + 1 - Nat.card B.graph.V) + ∑ᶠ z, B.rankGrp z

theorem complexity_def :
    B.complexity = (Nat.card B.graph.GeomEdge + 1 - Nat.card B.graph.V) + ∑ᶠ z, B.rankGrp z :=
  (rfl)

/-! ### A single edge over an amalgamated product -/

section segment

variable {P Q : Type w} {C : Type x} [Group P] [Group Q] [Group C] (f : C →* P) (g : C →* Q)
  (hf : Function.Injective f) (hg : Function.Injective g)
  (P₀ : Subgroup P) (Q₀ : Subgroup Q) (a : P) (b : Q)

/-- The `𝔸`-graph with a single edge of label `(a, e, b)` over the graph of groups `𝔸` of an
amalgamated product `P ∗_C Q`: its vertices `false` and `true` have the types of the vertices of
`P` and `Q` and the groups `P₀ ≤ P` and `Q₀ ≤ Q`, its base vertex is `false`, of type `o(e)`, and
its dart `false` has type the dart `e` from the vertex of `P` to the vertex of `Q`, with `f_α = a`
and `f_ω = b`. The body is exposed, so that the Booleans are accepted as the vertices and the darts
of its graph. -/
@[expose] def segment :
    AGraph.{0, 0, w, x, 0, 0} (GraphOfGroups.segment f g hf hg) (SerreGraph.segment.src false) where
  graph := SerreGraph.segment
  typ :=
    { mapV := id
      mapE := id
      map_src _ := rfl
      map_rev _ := rfl }
  base := false
  typ_base := rfl
  grp
    | false => P₀
    | true => Q₀
  labelα
    | false => a
    | true => (b⁻¹ : Q)

@[simp] theorem segment_graph : (segment f g hf hg P₀ Q₀ a b).graph = SerreGraph.segment :=
  rfl

@[simp] theorem segment_typ_mapV (u : (segment f g hf hg P₀ Q₀ a b).graph.V) :
    (segment f g hf hg P₀ Q₀ a b).typ.mapV u = u :=
  rfl

@[simp] theorem segment_typ_mapE (e : (segment f g hf hg P₀ Q₀ a b).graph.E) :
    (segment f g hf hg P₀ Q₀ a b).typ.mapE e = e :=
  rfl

@[simp] theorem segment_base : (segment f g hf hg P₀ Q₀ a b).base = false :=
  rfl

@[simp] theorem segment_grp_false : (segment f g hf hg P₀ Q₀ a b).grp false = P₀ :=
  rfl

@[simp] theorem segment_grp_true : (segment f g hf hg P₀ Q₀ a b).grp true = Q₀ :=
  rfl

@[simp] theorem segment_labelα_false : (segment f g hf hg P₀ Q₀ a b).labelα false = a :=
  rfl

@[simp] theorem segment_labelα_true : (segment f g hf hg P₀ Q₀ a b).labelα true = b⁻¹ :=
  rfl

@[simp] theorem segment_labelω_false : (segment f g hf hg P₀ Q₀ a b).labelω false = b :=
  inv_inv b

@[simp] theorem segment_labelω_true : (segment f g hf hg P₀ Q₀ a b).labelω true = a⁻¹ :=
  (rfl)

/-- The `𝔹`-paths from the base vertex of the single edge: empty to `false`, and the dart `false`
to `true`. -/
private def segmentPath : ∀ u : (segment f g hf hg P₀ Q₀ a b).graph.V,
    (segment f g hf hg P₀ Q₀ a b).toGraphOfGroups.Path ⟨(segment f g hf hg P₀ Q₀ a b).base⟩ ⟨u⟩
  | false => .nil
  | true => Path.ofDart ((segment f g hf hg P₀ Q₀ a b).graph.dart false)

private theorem segmentPath_false : segmentPath f g hf hg P₀ Q₀ a b false = .nil :=
  rfl

private theorem segmentPath_true : segmentPath f g hf hg P₀ Q₀ a b true =
    Path.ofDart ((segment f g hf hg P₀ Q₀ a b).graph.dart false) :=
  rfl

/-- The reverse of the dart `false` of the single edge is its dart `true`. -/
private theorem segment_reverse_ofDart :
    (Path.ofDart (𝔸 := (segment f g hf hg P₀ Q₀ a b).toGraphOfGroups)
      ((segment f g hf hg P₀ Q₀ a b).graph.dart false)).reverse =
        Path.ofDart ((segment f g hf hg P₀ Q₀ a b).graph.dart true) := by
  rw [Path.reverse_ofDart]
  refine congrArg Path.ofDart (Subtype.ext ?_)
  rw [SerreGraph.reverse_val, SerreGraph.dart_val (segment f g hf hg P₀ Q₀ a b).graph false,
    SerreGraph.dart_val (segment f g hf hg P₀ Q₀ a b).graph true]
  exact SerreGraph.segment_rev false

/-- Both dart loops `γ_{o(e)} e γ_{t(e)}⁻¹` of the single edge are homotopic to the empty
path. -/
private theorem segmentPath_loop (e : (segment f g hf hg P₀ Q₀ a b).graph.E) :
    Path.Homotopic
      (((segmentPath f g hf hg P₀ Q₀ a b ((segment f g hf hg P₀ Q₀ a b).graph.src e)).comp
        (Path.ofDart ((segment f g hf hg P₀ Q₀ a b).graph.dart e))).comp
          (segmentPath f g hf hg P₀ Q₀ a b ((segment f g hf hg P₀ Q₀ a b).graph.tgt e)).reverse)
      .nil := by
  cases e
  · dsimp only [segment_graph, SerreGraph.segment_src, SerreGraph.segment_tgt, Bool.not_false,
      segmentPath_false, segmentPath_true]
    exact Path.Homotopic.comp_comp_reverse .nil _
  · rw [← segment_reverse_ofDart]
    dsimp only [segment_graph, SerreGraph.segment_src, SerreGraph.segment_tgt, Bool.not_true,
      segmentPath_false, segmentPath_true]
    exact Path.Homotopic.comp_reverse _

/-- The dart of the single edge reads its label `(a, e, b)`. -/
private theorem segment_pathMap_ofDart :
    (segment f g hf hg P₀ Q₀ a b).pathMap
        (Path.ofDart ((segment f g hf hg P₀ Q₀ a b).graph.dart false)) =
      ((Path.ofVertex a).comp (Path.ofDart (SerreGraph.segment.dart false))).comp
        (Path.ofVertex b) :=
  ((segment f g hf hg P₀ Q₀ a b).pathMap_ofDart false).trans <| congrArg₂
    (fun (x : SerreGraph.segment.src false ⟶ SerreGraph.segment.tgt false) (y : Q) =>
      ((Path.ofVertex (𝔸 := GraphOfGroups.segment f g hf hg)
        (a := SerreGraph.segment.src false) a).comp (Path.ofDart x)).comp
          (Path.ofVertex (𝔸 := GraphOfGroups.segment f g hf hg)
            (a := SerreGraph.segment.tgt false) y))
    (Subtype.ext rfl) (inv_inv b)

/-- The single edge `(a, e, b)` between vertices with groups `P₀ ≤ P` and `Q₀ ≤ Q` represents the
subgroup `⟨P₀, (a e b) Q₀ (a e b)⁻¹⟩` of `π₁(𝔸, v₀)`, the fundamental group (in the path model) of
the graph of groups of the amalgamated product `P ∗_C Q`, based at the vertex of `P`. -/
theorem segment_subgroup : (segment f g hf hg P₀ Q₀ a b).subgroup =
    P₀.map (π₁.vertexHom Quiver.Path.nil) ⊔
      Q₀.map (π₁.vertexHom (((Path.ofVertex a).comp
        (Path.ofDart (SerreGraph.segment.dart false))).comp (Path.ofVertex b))) := by
  -- By `range_π₁Hom_comp_vertexHom`: by definition `B_{false} = P₀`, `segmentPath false` is empty
  -- and so is its image under the path map, and `typ_base` is `rfl`. A vertex of
  -- `SerreGraph.segment` is a Boolean only after unfolding, so the two sides are compared by
  -- unfolding rather than by rewriting at the vertex `false`.
  have hP : ((segment f g hf hg P₀ Q₀ a b).π₁Hom.comp
      (π₁.vertexHom (segmentPath f g hf hg P₀ Q₀ a b false))).range =
        P₀.map (π₁.vertexHom Quiver.Path.nil) :=
    range_π₁Hom_comp_vertexHom _ _
  have hQ : ((segment f g hf hg P₀ Q₀ a b).π₁Hom.comp
      (π₁.vertexHom (segmentPath f g hf hg P₀ Q₀ a b true))).range =
        Q₀.map (π₁.vertexHom (((Path.ofVertex a).comp
          (Path.ofDart (SerreGraph.segment.dart false))).comp (Path.ofVertex b))) :=
    (range_π₁Hom_comp_vertexHom _ _).trans (congrArg (fun p : (GraphOfGroups.segment f g hf hg).Path
      ⟨SerreGraph.segment.src false⟩ ⟨SerreGraph.segment.tgt false⟩ => Q₀.map (π₁.vertexHom p))
        (segment_pathMap_ofDart f g hf hg P₀ Q₀ a b))
  rw [subgroup_eq_sup (segment f g hf hg P₀ Q₀ a b) (segmentPath f g hf hg P₀ Q₀ a b)]
  refine le_antisymm (sup_le (iSup_le fun u => ?_) ((Subgroup.closure_le _).2 ?_))
    (sup_le (le_sup_of_le_left (le_iSup_of_le false hP.ge))
      (le_sup_of_le_left (le_iSup_of_le true hQ.ge)))
  · cases u
    · exact hP.le.trans le_sup_left
    · exact hQ.le.trans le_sup_right
  · rintro _ ⟨e, rfl⟩
    beta_reduce
    rw [π₁.mk_eq_mk_iff.2 (segmentPath_loop f g hf hg P₀ Q₀ a b e), π₁.mk_nil, map_one]
    exact one_mem _

/-- The single edge `(a, e, b)` is folded exactly when its vertex groups cut out the same subgroup
`f⁻¹(a⁻¹ P₀ a) = g⁻¹(b Q₀ b⁻¹)` of the edge group `C` (Kapovich, Weidmann and Myasnikov,
Example 4.4): its two darts issue from distinct vertices, and the condition at the dart `e⁻¹` is
the mirror image of the condition at `e`. -/
theorem segment_isFolded_iff : (segment f g hf hg P₀ Q₀ a b).IsFolded ↔
    (P₀.map (MulAut.conj a⁻¹).toMonoidHom).comap f =
      (Q₀.map (MulAut.conj b).toMonoidHom).comap g := by
  -- The conditions at the darts `false` and `true`. By definition, the dart `false` has the
  -- groups `P₀`, `Q₀` at its ends and the labels `a`, `b⁻¹⁻¹`, and the dart `true` the groups
  -- `Q₀`, `P₀` and the labels `b⁻¹`, `a⁻¹`; the darts are their own types.
  have key : (segment f g hf hg P₀ Q₀ a b).IsFolded ↔
      (P₀.map (MulAut.conj a⁻¹).toMonoidHom).comap ((GraphOfGroups.segment f g hf hg).α false) =
          (Q₀.map (MulAut.conj b⁻¹⁻¹).toMonoidHom).comap
            ((GraphOfGroups.segment f g hf hg).ω false) ∧
        (Q₀.map (MulAut.conj b⁻¹⁻¹).toMonoidHom).comap ((GraphOfGroups.segment f g hf hg).α true) =
          (P₀.map (MulAut.conj a⁻¹).toMonoidHom).comap
            ((GraphOfGroups.segment f g hf hg).ω true) := by
    refine ⟨fun h => ⟨h.comap_eq false, h.comap_eq true⟩, fun h => ⟨?_, fun e => ?_⟩⟩
    · -- Distinct darts issue from distinct vertices: the source of the dart `e` is `e`.
      intro f₁ f₂ hs _ _
      exact (SerreGraph.segment_src f₁).symm.trans (hs.trans (SerreGraph.segment_src f₂))
    · cases e
      exacts [h.1, h.2]
  rw [key, segment_α_false, segment_ω_false, segment_α_true, segment_ω_true, inv_inv]
  exact ⟨And.left, fun h => ⟨h, h.symm⟩⟩

/-- The single edge is a finite `𝔸`-graph exactly when its vertex groups are finitely
generated. -/
theorem segment_isFinite_iff : (segment f g hf hg P₀ Q₀ a b).IsFinite ↔ P₀.FG ∧ Q₀.FG := by
  -- The vertex groups `B_{false} = P₀` and `B_{true} = Q₀` are subgroups of the vertex groups `P`
  -- and `Q` of `𝔸` only after unfolding, so finite generation is transported by `exact`.
  refine ⟨fun h => ⟨h.fg false, h.fg true⟩, fun h => ⟨?_, ?_, ?_⟩⟩
  · rw [segment_graph]
    exact inferInstanceAs (Finite Bool)
  · rw [segment_graph]
    exact SerreGraph.IsTree.connected _ SerreGraph.segment_isTree
  · rintro (_ | _)
    exacts [h.1, h.2]

/-- The complexity of the single edge is `rank P₀ + rank Q₀`: its underlying graph is a tree. -/
theorem segment_complexity [Group.FG P₀] [Group.FG Q₀] :
    (segment f g hf hg P₀ Q₀ a b).complexity = Group.rank P₀ + Group.rank Q₀ := by
  -- The underlying graph is `SerreGraph.segment`: one geometric edge and the two vertices `Bool`.
  have hE : Nat.card (segment f g hf hg P₀ Q₀ a b).graph.GeomEdge = 1 := by
    rw [segment_graph]
    exact Nat.card_unique
  have hV : Nat.card (segment f g hf hg P₀ Q₀ a b).graph.V = 2 := by
    rw [segment_graph, Nat.card_congr SerreGraph.segmentVEquiv, Nat.card_eq_fintype_card,
      Fintype.card_bool]
  -- The vertex groups are `P₀` and `Q₀`, and the vertices are the Booleans, by definition.
  have : Group.FG ((segment f g hf hg P₀ Q₀ a b).grp false) := ‹Group.FG P₀›
  have : Group.FG ((segment f g hf hg P₀ Q₀ a b).grp true) := ‹Group.FG Q₀›
  let _ : Fintype (segment f g hf hg P₀ Q₀ a b).graph.V := inferInstanceAs (Fintype Bool)
  have hR : ∑ᶠ z, (segment f g hf hg P₀ Q₀ a b).rankGrp z = Group.rank P₀ + Group.rank Q₀ :=
    (finsum_eq_sum_of_fintype _).trans ((Fintype.sum_bool _).trans
      ((add_comm _ _).trans (congrArg₂ (· + ·) (rankGrp_eq (segment f g hf hg P₀ Q₀ a b) false)
        (rankGrp_eq (segment f g hf hg P₀ Q₀ a b) true))))
  rw [complexity_def, hE, hV, hR]
  omega

end segment

