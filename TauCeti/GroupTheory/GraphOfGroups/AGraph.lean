module

public import TauCeti.GroupTheory.GraphOfGroups.Path

/-!
# Graphs labelled by a graph of groups

Let `𝔸` be a graph of groups over a Serre graph `Γ`. An `𝔸`-graph on a Serre graph `Δ` consists
of

* a graph morphism `[·] : Δ → Γ`, the *type* map;
* for every vertex `u` of `Δ` a subgroup `B_u` of the vertex group `A_[u]`;
* for every dart `f` of `Δ` an element `f_α ∈ A_[o(f)]`.

The element `f_ω ∈ A_[t(f)]` at the other end of `f` is `((f⁻¹)_α)⁻¹`, so that the condition
`(f⁻¹)_α = (f_ω)⁻¹` of Kapovich, Weidmann and Myasnikov holds by construction; the dart `f` carries
the label `(f_α, [f], f_ω)`.

Reading the labels along paths, an `𝔸`-graph approximates a subgroup of the fundamental group of
`𝔸`. Its graph of groups `𝔹` has the underlying graph `Δ`, the vertex groups `B_u` and trivial edge
groups; this is the graph of groups defined by the `𝔸`-graph when `𝔸` has trivial edge groups, in
which case every edge group `B_f ≤ A_[f]` of the general construction is trivial. A `𝔹`-path is
sent to an `𝔸`-path letter by letter: an element `b ∈ B_u` is read as `b ∈ A_[u]`, and a dart `f`
is read as the three letters `f_α, [f], f_ω`. Merging consecutive vertex group letters gives the
path `μ(p)` of Kapovich, Weidmann and Myasnikov. The path map preserves homotopy, so it induces a
homomorphism `ν : π₁(𝔹, u₀) →* π₁(𝔸, [u₀])`, whose image is the subgroup `L(B, u₀)` represented by
the `𝔸`-graph at the base vertex `u₀`. This subgroup only depends on the paths of `𝔹`, not on its
edge groups, so it is defined for every graph of groups `𝔸`.

## Main definitions

* `TauCeti.GraphOfGroups.AGraph`: an `𝔸`-graph on a Serre graph.
* `TauCeti.GraphOfGroups.AGraph.toGraphOfGroups`: its graph of groups with trivial edge groups.
* `TauCeti.GraphOfGroups.AGraph.pathMap`: the path map from `𝔹`-paths to `𝔸`-paths.
* `TauCeti.GraphOfGroups.AGraph.π₁Hom`: the homomorphism `ν : π₁(𝔹, u₀) →* π₁(𝔸, [u₀])`.
* `TauCeti.GraphOfGroups.AGraph.subgroup`: the subgroup `L(B, u₀)` of `π₁(𝔸, [u₀])` represented by
  the `𝔸`-graph.
* `TauCeti.GraphOfGroups.AGraph.segment`: the `𝔸`-graph with a single edge of label `(a, e, b)`
  over the graph of groups of an amalgamated product.

## Main results

* `TauCeti.GraphOfGroups.Path.Homotopic.pathMap`: the path map preserves homotopy.
* `TauCeti.GraphOfGroups.AGraph.subgroup_eq_sup`: for any choice of `𝔹`-paths `γ_u` from `u₀` to
  every vertex `u`, the subgroup `L(B, u₀)` is generated by the conjugates `γ_u B_u γ_u⁻¹` and the
  loops `γ_{o(f)} f γ_{t(f)}⁻¹`, read in `π₁(𝔸, [u₀])`.
* `TauCeti.GraphOfGroups.AGraph.segment_subgroup`: the single edge `(a, e, b)` between vertices with
  groups `P₀ ≤ P` and `Q₀ ≤ Q` represents the subgroup `⟨P₀, (a e b) Q₀ (a e b)⁻¹⟩` of the path
  model `π₁(𝔸, v₀)` of the amalgamated product `P ∗_C Q`.

## References

* I. Kapovich, R. Weidmann, A. Myasnikov, *Foldings, graphs of groups and the membership problem*,
  Internat. J. Algebra Comput. 15 (2005), §3, Definition 3.1, Convention 3.2, Definition 3.3,
  Example 3.4, Convention 3.5, Definition 3.6, Proposition 3.7, Remark 3.8 and Lemma 3.9.
-/

public section

universe u v w x u' v'

namespace TauCeti

namespace GraphOfGroups

variable {Γ : SerreGraph.{u, v}} (𝔸 : GraphOfGroups.{u, v, w, x} Γ)

/-- An `𝔸`-graph on a Serre graph `Δ`: a graph morphism `[·] : Δ → Γ`, the type map, a subgroup
`B_u` of the vertex group `A_[u]` for every vertex `u` of `Δ`, and an element `f_α ∈ A_[o(f)]`
for every dart `f` of `Δ`. The element `f_ω` at the end of `f` is `AGraph.labelω`. -/
structure AGraph (Δ : SerreGraph.{u', v'}) where
  /-- The type map `[·] : Δ → Γ`. -/
  type : Δ.Hom Γ
  /-- The vertex group `B_u ≤ A_[u]` of a vertex `u`. -/
  vertexSubgroup : ∀ u : Δ.V, Subgroup (𝔸.vertexGroup (type.mapV u))
  /-- The element `f_α ∈ A_[o(f)]` at the start of a dart `f`. -/
  labelα : ∀ f : Δ.E, 𝔸.vertexGroup (type.mapV (Δ.src f))

namespace AGraph

variable {𝔸} {Δ : SerreGraph.{u', v'}} (B : 𝔸.AGraph Δ)

/-- The element `f_ω ∈ A_[t(f)]` at the end of a dart `f`: the inverse of the element `(f⁻¹)_α`
at the start of the reverse dart. -/
def labelω (f : Δ.E) : 𝔸.vertexGroup (B.type.mapV (Δ.tgt f)) :=
  (B.labelα (Δ.rev f))⁻¹

theorem labelω_def (f : Δ.E) : B.labelω f = (B.labelα (Δ.rev f))⁻¹ :=
  (rfl)

/-- The label condition `(f⁻¹)_α = (f_ω)⁻¹`. -/
@[simp] theorem labelα_rev (f : Δ.E) : B.labelα (Δ.rev f) = (B.labelω f)⁻¹ :=
  (inv_inv (B.labelα (Δ.rev f))).symm

/-- Start labels of equal darts agree after transport to a common vertex group. -/
private theorem cast_labelα_congr {e₁ e₂ : Δ.E} (h : e₁ = e₂) {a : Γ.V}
    (h₁ : B.type.mapV (Δ.src e₁) = a) (h₂ : B.type.mapV (Δ.src e₂) = a) :
    MulEquiv.cast (M := 𝔸.vertexGroup) h₁ (B.labelα e₁) =
      MulEquiv.cast (M := 𝔸.vertexGroup) h₂ (B.labelα e₂) := by
  subst h
  rfl

/-- End labels of equal darts agree after transport to a common vertex group. -/
private theorem cast_labelω_congr {e₁ e₂ : Δ.E} (h : e₁ = e₂) {a : Γ.V}
    (h₁ : B.type.mapV (Δ.tgt e₁) = a) (h₂ : B.type.mapV (Δ.tgt e₂) = a) :
    MulEquiv.cast (M := 𝔸.vertexGroup) h₁ (B.labelω e₁) =
      MulEquiv.cast (M := 𝔸.vertexGroup) h₂ (B.labelω e₂) := by
  subst h
  rfl

/-- The label condition `(f⁻¹)_ω = (f_α)⁻¹`, read through `t(f⁻¹) = o(f)`. -/
theorem labelω_rev (f : Δ.E) : MulEquiv.cast (M := 𝔸.vertexGroup)
    (congrArg B.type.mapV (Δ.tgt_rev f)) (B.labelω (Δ.rev f)) = (B.labelα f)⁻¹ :=
  -- `labelω (rev f)` is `(labelα (rev (rev f)))⁻¹`; transport along `rev (rev f) = f`.
  (map_inv _ _).trans (congrArg (·⁻¹) (B.cast_labelα_congr (Δ.rev_rev f) _ rfl))

/-! ### The graph of groups of an `𝔸`-graph -/

/-- The graph of groups of an `𝔸`-graph: the underlying graph `Δ`, the vertex groups `B_u` and
trivial edge groups. When `𝔸` has trivial edge groups this is the graph of groups defined by the
`𝔸`-graph, whose edge group `B_f` is a subgroup of the trivial group `A_[f]`. -/
abbrev toGraphOfGroups : GraphOfGroups.{u', v', w, 0} Δ where
  vertexGroup u := B.vertexSubgroup u
  edgeGroup _ := Unit
  ω _ := 1
  ω_injective _ _ _ _ := Subsingleton.elim _ _

@[simp] theorem toGraphOfGroups_ω (e : Δ.E) (c : B.toGraphOfGroups.edgeGroup (Δ.toGeomEdge e)) :
    B.toGraphOfGroups.ω e c = 1 :=
  (rfl)

@[simp] theorem toGraphOfGroups_α (e : Δ.E) (c : B.toGraphOfGroups.edgeGroup (Δ.toGeomEdge e)) :
    B.toGraphOfGroups.α e c = 1 := by
  rw [α_apply, toGraphOfGroups_ω, map_one]

/-! ### The path map -/

/-- The type `[f] : [a] ⟶ [b]` of an arrow `f : a ⟶ b` of `Δ`: the image of `f` under the type
map, as an arrow between the types of its endpoints. -/
def typeArrow {a b : Δ.V} (f : a ⟶ b) : B.type.mapV a ⟶ B.type.mapV b :=
  B.type.toPrefunctor.map f

@[simp] theorem typeArrow_val {a b : Δ.V} (f : a ⟶ b) : (B.typeArrow f).1 = B.type.mapE f.1 :=
  (rfl)

theorem typeArrow_reverse {a b : Δ.V} (f : a ⟶ b) : B.typeArrow (Quiver.reverse f) =
    Quiver.reverse (B.typeArrow f) :=
  Prefunctor.map_reverse ..

/-- The `𝔸`-path read along a letter of a `𝔹`-path: an element `b ∈ B_u` is read as the letter
`b ∈ A_[u]`, and a dart `f` as the letters `f_α, [f], f_ω`. -/
def letterPath : ∀ {x y : B.toGraphOfGroups.LetterVertex}, B.toGraphOfGroups.Letter x y →
    𝔸.Path ⟨B.type.mapV x.as⟩ ⟨B.type.mapV y.as⟩
  | _, _, .vertex g => Path.ofVertex g.1
  | _, _, .dart f =>
    ((Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (congrArg B.type.mapV f.2.1)
        (B.labelα f.1))).comp (Path.ofDart (B.typeArrow f))).comp
      (Path.ofVertex (MulEquiv.cast (M := 𝔸.vertexGroup) (congrArg B.type.mapV f.2.2)
        (B.labelω f.1)))

@[simp] theorem letterPath_vertex {a : Δ.V} (g : B.vertexSubgroup a) :
    B.letterPath (Letter.vertex (𝔸 := B.toGraphOfGroups) g) = Path.ofVertex (g : 𝔸.vertexGroup _) :=
  (rfl)

@[simp] theorem letterPath_dart (e : Δ.E) :
    B.letterPath (Letter.dart (𝔸 := B.toGraphOfGroups) (Δ.dart e)) =
      ((Path.ofVertex (B.labelα e)).comp (Path.ofDart (B.typeArrow (Δ.dart e)))).comp
        (Path.ofVertex (B.labelω e)) := by
  rw [letterPath, B.cast_labelα_congr (Δ.dart_val e) _ rfl,
    B.cast_labelω_congr (Δ.dart_val e) _ rfl]
  rfl

/-- The path map: the `𝔸`-path read along a `𝔹`-path, letter by letter. -/
def pathMap {x : B.toGraphOfGroups.LetterVertex} :
    ∀ {y : B.toGraphOfGroups.LetterVertex}, B.toGraphOfGroups.Path x y →
      𝔸.Path ⟨B.type.mapV x.as⟩ ⟨B.type.mapV y.as⟩
  | _, .nil => .nil
  | _, .cons p l => (pathMap p).comp (B.letterPath l)

section pathMap

variable {x y z : B.toGraphOfGroups.LetterVertex}

@[simp] theorem pathMap_nil : B.pathMap (Quiver.Path.nil : B.toGraphOfGroups.Path x x) = .nil :=
  (rfl)

@[simp] theorem pathMap_cons (p : B.toGraphOfGroups.Path x y) (l : B.toGraphOfGroups.Letter y z) :
    B.pathMap (p.cons l) = (B.pathMap p).comp (B.letterPath l) :=
  (rfl)

@[simp] theorem pathMap_comp (p : B.toGraphOfGroups.Path x y) (q : B.toGraphOfGroups.Path y z) :
    B.pathMap (p.comp q) = (B.pathMap p).comp (B.pathMap q) := by
  induction q with
  | nil => simp
  | cons q l ih => simp [ih, Quiver.Path.comp_assoc]

@[simp] theorem pathMap_ofVertex {a : Δ.V} (g : B.vertexSubgroup a) :
    B.pathMap (Path.ofVertex (𝔸 := B.toGraphOfGroups) g) = Path.ofVertex (g : 𝔸.vertexGroup _) := by
  have h := Path.comp_ofVertex (𝔸 := B.toGraphOfGroups) Quiver.Path.nil g
  rw [Quiver.Path.nil_comp] at h
  rw [h, pathMap_cons, pathMap_nil, Quiver.Path.nil_comp, letterPath_vertex]

@[simp] theorem pathMap_ofDart (e : Δ.E) :
    B.pathMap (Path.ofDart (𝔸 := B.toGraphOfGroups) (Δ.dart e)) =
      ((Path.ofVertex (B.labelα e)).comp (Path.ofDart (B.typeArrow (Δ.dart e)))).comp
        (Path.ofVertex (B.labelω e)) := by
  have h := Path.comp_ofDart (𝔸 := B.toGraphOfGroups) Quiver.Path.nil (Δ.dart e)
  rw [Quiver.Path.nil_comp] at h
  rw [h, pathMap_cons, pathMap_nil, Quiver.Path.nil_comp, letterPath_dart]

/-- The start label of a reversed arrow, transported to its source, is the inverse of the end
label of the arrow. -/
private theorem cast_labelα_reverse {a b : Δ.V} (f : a ⟶ b) :
    MulEquiv.cast (M := 𝔸.vertexGroup) (congrArg B.type.mapV (Quiver.reverse f).2.1)
        (B.labelα (Quiver.reverse f).1) =
      (MulEquiv.cast (M := 𝔸.vertexGroup) (congrArg B.type.mapV f.2.2) (B.labelω f.1))⁻¹ := by
  obtain ⟨e, rfl, rfl⟩ := f
  have key : ∀ r : Δ.tgt e ⟶ Δ.src e, r.1 = Δ.rev e →
      MulEquiv.cast (M := 𝔸.vertexGroup) (congrArg B.type.mapV r.2.1) (B.labelα r.1) =
        (B.labelω e)⁻¹ := by
    rintro ⟨r, h, -⟩ (rfl : r = Δ.rev e)
    exact B.labelα_rev e
  exact key _ (Δ.reverse_val _)

/-- The end label of a reversed arrow, transported to its target, is the inverse of the start
label of the arrow. -/
private theorem cast_labelω_reverse {a b : Δ.V} (f : a ⟶ b) :
    MulEquiv.cast (M := 𝔸.vertexGroup) (congrArg B.type.mapV (Quiver.reverse f).2.2)
        (B.labelω (Quiver.reverse f).1) =
      (MulEquiv.cast (M := 𝔸.vertexGroup) (congrArg B.type.mapV f.2.1) (B.labelα f.1))⁻¹ := by
  obtain ⟨e, rfl, rfl⟩ := f
  have key : ∀ r : Δ.tgt e ⟶ Δ.src e, r.1 = Δ.rev e →
      MulEquiv.cast (M := 𝔸.vertexGroup) (congrArg B.type.mapV r.2.2) (B.labelω r.1) =
        (B.labelα e)⁻¹ := by
    rintro ⟨r, -, h⟩ (rfl : r = Δ.rev e)
    exact B.labelω_rev e
  exact key _ (Δ.reverse_val _)

/-- Reading the reverse of a letter gives the reverse path. -/
theorem letterPath_reverse (l : B.toGraphOfGroups.Letter x y) :
    B.letterPath (Quiver.reverse (V := B.toGraphOfGroups.LetterVertex) l) =
      (B.letterPath l).reverse := by
  cases l with
  | vertex g =>
    rw [Letter.reverse_vertex, letterPath_vertex, letterPath_vertex, Path.reverse_ofVertex]
    rfl
  | dart f =>
    rw [Letter.reverse_dart, letterPath, letterPath, cast_labelα_reverse, cast_labelω_reverse,
      typeArrow_reverse]
    simp only [Quiver.Path.reverse_comp, Path.reverse_ofVertex, Path.reverse_ofDart,
      Quiver.Path.comp_assoc]

/-- The path map commutes with reversal. -/
@[simp] theorem pathMap_reverse (p : B.toGraphOfGroups.Path x y) :
    B.pathMap p.reverse = (B.pathMap p).reverse := by
  induction p with
  | nil => rfl
  | cons p l ih =>
    rw [Quiver.Path.reverse, pathMap_comp, ih, pathMap_cons, Quiver.Path.reverse_comp,
      Quiver.Hom.toPath, pathMap_cons, pathMap_nil, Quiver.Path.nil_comp, letterPath_reverse]

end pathMap

end AGraph

variable {𝔸} in
/-- The path map of an `𝔸`-graph sends homotopic `𝔹`-paths to homotopic `𝔸`-paths. -/
theorem Path.Homotopic.pathMap {Δ : SerreGraph.{u', v'}} (B : 𝔸.AGraph Δ)
    {x y : B.toGraphOfGroups.LetterVertex} {p q : B.toGraphOfGroups.Path x y} (h : p.Homotopic q) :
    (B.pathMap p).Homotopic (B.pathMap q) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | cons _ l ih =>
    rw [AGraph.pathMap_cons, AGraph.pathMap_cons]
    exact ih.comp_right _
  | mul p g h =>
    simp only [AGraph.pathMap_cons, AGraph.letterPath_vertex, Path.comp_ofVertex]
    exact .mul _ _ _
  | one p =>
    simp only [AGraph.pathMap_cons, AGraph.letterPath_vertex, Path.comp_ofVertex]
    exact .one _
  | dart_reverse p f =>
    rw [AGraph.pathMap_cons, AGraph.pathMap_cons, ← Letter.reverse_dart,
      AGraph.letterPath_reverse, Quiver.Path.comp_assoc]
    simpa using (Homotopic.comp_reverse (B.letterPath (Letter.dart f))).comp_left (B.pathMap p)
  | dart_ω e c p =>
    rw [AGraph.pathMap_cons, AGraph.pathMap_cons, AGraph.pathMap_cons, AGraph.pathMap_cons,
      AGraph.toGraphOfGroups_ω, AGraph.toGraphOfGroups_α, AGraph.letterPath_vertex,
      AGraph.letterPath_vertex, Path.comp_ofVertex, Path.comp_ofVertex]
    exact (Homotopic.one _).trans ((Homotopic.one _).comp_right _).symm

namespace AGraph

variable {𝔸} {Δ : SerreGraph.{u', v'}} (B : 𝔸.AGraph Δ)

/-! ### The represented subgroup -/

/-- The homomorphism `ν : π₁(𝔹, u₀) →* π₁(𝔸, [u₀])` induced by the path map. When `𝔸` has trivial
edge groups, `𝔹 = B.toGraphOfGroups` is the graph of groups defined by the `𝔸`-graph; for other `𝔸`
its domain is the fundamental group of the graph of groups with trivial edge groups, which has the
same closed paths and hence the same image. -/
def π₁Hom (u₀ : Δ.V) : π₁ B.toGraphOfGroups u₀ →* π₁ 𝔸 (B.type.mapV u₀) where
  toFun := π₁.lift (fun p => π₁.mk (B.pathMap p)) fun _ _ h =>
    π₁.mk_eq_mk_iff.2 (h.pathMap B)
  map_one' := by
    rw [← π₁.mk_nil, π₁.lift_mk, pathMap_nil, π₁.mk_nil]
  map_mul' x y := π₁.induction_on x fun p => π₁.induction_on y fun q => by
    rw [← π₁.mk_comp, π₁.lift_mk, π₁.lift_mk, π₁.lift_mk, pathMap_comp, π₁.mk_comp]

variable {u₀ : Δ.V}

@[simp] theorem π₁Hom_mk (p : B.toGraphOfGroups.Path ⟨u₀⟩ ⟨u₀⟩) :
    B.π₁Hom u₀ (π₁.mk p) = π₁.mk (B.pathMap p) :=
  π₁.lift_mk ..

/-- The homomorphism `ν` sends the conjugate `p b p⁻¹` of `b ∈ B_u` to the conjugate of `b ∈ A_[u]`
by the path read along `p`. -/
@[simp] theorem π₁Hom_vertexHom {u : Δ.V} (p : B.toGraphOfGroups.Path ⟨u₀⟩ ⟨u⟩)
    (g : B.vertexSubgroup u) : B.π₁Hom u₀ (π₁.vertexHom p g) =
      π₁.vertexHom (B.pathMap p) (g : 𝔸.vertexGroup _) := by
  rw [π₁.vertexHom_apply, π₁Hom_mk, pathMap_comp, pathMap_comp, pathMap_reverse, pathMap_ofVertex,
    π₁.vertexHom_apply]

/-- The subgroup `L(B, u₀)` of `π₁(𝔸, [u₀])` represented by an `𝔸`-graph at a base vertex `u₀`: the
image of `ν`, which consists of the elements read along the closed `𝔹`-paths at `u₀`. -/
def subgroup (u₀ : Δ.V) : Subgroup (π₁ 𝔸 (B.type.mapV u₀)) :=
  (B.π₁Hom u₀).range

theorem subgroup_def : B.subgroup u₀ = (B.π₁Hom u₀).range :=
  (rfl)

@[simp] theorem mem_subgroup_iff {g : π₁ 𝔸 (B.type.mapV u₀)} :
    g ∈ B.subgroup u₀ ↔ ∃ p : B.toGraphOfGroups.Path ⟨u₀⟩ ⟨u₀⟩, π₁.mk (B.pathMap p) = g := by
  rw [subgroup_def, MonoidHom.mem_range]
  constructor
  · rintro ⟨x, rfl⟩
    exact π₁.induction_on x fun p => ⟨p, (B.π₁Hom_mk p).symm⟩
  · rintro ⟨p, rfl⟩
    exact ⟨π₁.mk p, B.π₁Hom_mk p⟩

theorem mk_pathMap_mem_subgroup (p : B.toGraphOfGroups.Path ⟨u₀⟩ ⟨u₀⟩) :
    π₁.mk (B.pathMap p) ∈ B.subgroup u₀ :=
  B.mem_subgroup_iff.2 ⟨p, rfl⟩

/-- The vertex group `B_u`, conjugated by the path read along a `𝔹`-path from `u₀` to `u`, lies in
the represented subgroup. -/
theorem map_vertexSubgroup_le_subgroup {u : Δ.V} (p : B.toGraphOfGroups.Path ⟨u₀⟩ ⟨u⟩) :
    (B.vertexSubgroup u).map (π₁.vertexHom (B.pathMap p)) ≤ B.subgroup u₀ := by
  rintro _ ⟨g, hg, rfl⟩
  exact ⟨π₁.vertexHom p ⟨g, hg⟩, B.π₁Hom_vertexHom p ⟨g, hg⟩⟩

/-- A path followed by a path and its reverse is homotopic to the first path. -/
private theorem homotopic_comp_comp_reverse {x y z : 𝔸.LetterVertex} (q : 𝔸.Path x y)
    (p : 𝔸.Path y z) : Path.Homotopic ((q.comp p).comp p.reverse) q := by
  simpa only [Quiver.Path.comp_assoc, Quiver.Path.comp_nil] using
    (Path.Homotopic.comp_reverse p).comp_left q

/-- Splitting a path `q r t⁻¹` through an intermediate path `s` with the same ends as `q`: in
`π₁(𝔸, a)`, `q r t⁻¹ = (q s⁻¹) (s r t⁻¹)`. -/
private theorem mk_comp_comp_reverse {a b c : Γ.V} (q s : 𝔸.Path ⟨a⟩ ⟨b⟩) (r : 𝔸.Path ⟨b⟩ ⟨c⟩)
    (t : 𝔸.Path ⟨a⟩ ⟨c⟩) : π₁.mk ((q.comp r).comp t.reverse) =
      π₁.mk (q.comp s.reverse) * π₁.mk ((s.comp r).comp t.reverse) := by
  rw [← π₁.mk_comp, π₁.mk_eq_mk_iff]
  simpa only [Quiver.Path.comp_assoc] using
    (Path.Homotopic.comp_reverse_comp_comp q s (r.comp t.reverse)).symm

/-- The induction behind `subgroup_eq_sup`: for a `𝔹`-path `p` from `u₀` to `x`, the element
read along `γ_{u₀} p γ_x⁻¹` lies in every subgroup containing the generators. -/
private theorem mk_conj_mem (γ : ∀ u : Δ.V, B.toGraphOfGroups.Path ⟨u₀⟩ ⟨u⟩)
    {H : Subgroup (π₁ 𝔸 (B.type.mapV u₀))}
    (hV : ∀ u, (B.vertexSubgroup u).map (π₁.vertexHom (B.pathMap (γ u))) ≤ H)
    (hE : ∀ e : Δ.E, π₁.mk (B.pathMap (((γ (Δ.src e)).comp (Path.ofDart (Δ.dart e))).comp
      (γ (Δ.tgt e)).reverse)) ∈ H) {x : B.toGraphOfGroups.LetterVertex}
    (p : B.toGraphOfGroups.Path ⟨u₀⟩ x) :
    π₁.mk (((B.pathMap (γ u₀)).comp (B.pathMap p)).comp (B.pathMap (γ x.as)).reverse) ∈ H := by
  induction p with
  | nil =>
    convert H.one_mem using 1
    simp
  | cons p l ih =>
    cases l with
    | vertex g =>
      rw [pathMap_cons, letterPath_vertex, ← Quiver.Path.comp_assoc,
        mk_comp_comp_reverse _ (B.pathMap (γ _))]
      exact H.mul_mem ih (hV _ ⟨g.1, g.2, π₁.vertexHom_apply _ _⟩)
    | dart f =>
      obtain ⟨e, rfl, rfl⟩ := f
      rw [(Subtype.ext (Δ.dart_val e).symm : (⟨e, rfl, rfl⟩ : Δ.src e ⟶ Δ.tgt e) = Δ.dart e),
        pathMap_cons, ← Quiver.Path.comp_assoc,
        mk_comp_comp_reverse _ (B.pathMap (γ _))]
      refine H.mul_mem ih ?_
      simpa only [pathMap_comp, pathMap_reverse, pathMap_ofDart, letterPath_dart] using hE e

/-- A subgroup containing the generators of `subgroup_eq_sup` contains the represented
subgroup. -/
private theorem subgroup_le (γ : ∀ u : Δ.V, B.toGraphOfGroups.Path ⟨u₀⟩ ⟨u⟩)
    {H : Subgroup (π₁ 𝔸 (B.type.mapV u₀))}
    (hV : ∀ u, (B.vertexSubgroup u).map (π₁.vertexHom (B.pathMap (γ u))) ≤ H)
    (hE : ∀ e : Δ.E, π₁.mk (B.pathMap (((γ (Δ.src e)).comp (Path.ofDart (Δ.dart e))).comp
      (γ (Δ.tgt e)).reverse)) ∈ H) : B.subgroup u₀ ≤ H := by
  rintro _ ⟨g, rfl⟩
  refine π₁.induction_on g fun p => ?_
  -- With `c` the element read along `γ_{u₀}`, the induction gives `c [p] c⁻¹` and `c c c⁻¹`.
  have h₁ := B.mk_conj_mem γ hV hE p
  have h₂ := B.mk_conj_mem γ hV hE (γ u₀)
  simp only [π₁.mk_comp, π₁.mk_reverse, mul_inv_cancel_right] at h₁ h₂
  rw [π₁Hom_mk]
  convert mul_mem (mul_mem (inv_mem h₂) h₁) h₂ using 1
  simp [mul_assoc]

/-- Generators of the represented subgroup. For any family of `𝔹`-paths `γ_u` from `u₀` to every
vertex `u`, the subgroup `L(B, u₀)` is generated by the conjugates of the vertex groups `B_u` by the
paths read along `γ_u` and by the elements read along the loops `γ_{o(f)} f γ_{t(f)}⁻¹`. -/
theorem subgroup_eq_sup (γ : ∀ u : Δ.V, B.toGraphOfGroups.Path ⟨u₀⟩ ⟨u⟩) :
    B.subgroup u₀ = (⨆ u, (B.vertexSubgroup u).map (π₁.vertexHom (B.pathMap (γ u)))) ⊔
      Subgroup.closure (Set.range fun e : Δ.E => π₁.mk (B.pathMap
        (((γ (Δ.src e)).comp (Path.ofDart (Δ.dart e))).comp (γ (Δ.tgt e)).reverse))) := by
  refine le_antisymm (B.subgroup_le γ (fun u => le_sup_of_le_left (le_iSup_of_le u le_rfl))
    fun e => Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_range_self e)))
    (sup_le (iSup_le fun u => B.map_vertexSubgroup_le_subgroup (γ u)) ?_)
  rw [Subgroup.closure_le]
  rintro _ ⟨e, rfl⟩
  exact B.mk_pathMap_mem_subgroup _

/-! ### A single edge over an amalgamated product -/

/-- The `𝔹`-paths from the vertex `false` of an `𝔸`-graph on the segment: empty to `false`, and
the dart `false` to `true`. -/
private def segmentPath (B : 𝔸.AGraph SerreGraph.segment) (u : SerreGraph.segment.V) :
    B.toGraphOfGroups.Path ⟨false⟩ ⟨u⟩ :=
  Bool.rec (motive := fun u => B.toGraphOfGroups.Path ⟨false⟩ ⟨u⟩) .nil
    (Path.ofDart (SerreGraph.segment.dart false)) u

-- The vertices and darts of `SerreGraph.segment` are Booleans only up to unfolding, so the
-- arguments about the segment use definitional unfolding (`exact`) rather than rewriting.
/-- Both dart loops `γ_{o e} e γ_{t e}⁻¹` of the segment are homotopic to the empty path. -/
private theorem segmentPath_loop (B : 𝔸.AGraph SerreGraph.segment) (e : SerreGraph.segment.E) :
    Path.Homotopic (((B.segmentPath (SerreGraph.segment.src e)).comp
      (Path.ofDart (SerreGraph.segment.dart e))).comp
        (B.segmentPath (SerreGraph.segment.tgt e)).reverse) .nil := by
  cases e
  · exact homotopic_comp_comp_reverse .nil _
  · have key : ∀ r : B.toGraphOfGroups.Path ⟨true⟩ ⟨false⟩,
        (Path.ofDart (SerreGraph.segment.dart false)).reverse = r →
          Path.Homotopic (((Path.ofDart (SerreGraph.segment.dart false)).comp r).comp .nil)
            .nil := by
      rintro r rfl
      exact Path.Homotopic.comp_reverse _
    exact key _ ((Path.reverse_ofDart _).trans (congrArg Path.ofDart (Subtype.ext
      ((SerreGraph.reverse_val _ _).trans ((congrArg SerreGraph.segment.rev
        (SerreGraph.dart_val _ _)).trans (SerreGraph.dart_val _ _).symm)))))

/-- An `𝔸`-graph on the segment represents, at `false`, the subgroup generated by its vertex group
at `false` and the conjugate of its vertex group at `true` by the label of the dart `false`. -/
private theorem subgroup_false_of_segment (B : 𝔸.AGraph SerreGraph.segment) :
    B.subgroup false = (B.vertexSubgroup false).map (π₁.vertexHom .nil) ⊔
      (B.vertexSubgroup true).map
        (π₁.vertexHom (B.pathMap (Path.ofDart (SerreGraph.segment.dart false)))) := by
  refine (B.subgroup_eq_sup B.segmentPath).trans <| le_antisymm
    (sup_le (iSup_le fun u => ?_) ((Subgroup.closure_le _).2 ?_))
    (sup_le (le_sup_of_le_left (le_iSup_of_le false le_rfl))
      (le_sup_of_le_left (le_iSup_of_le true le_rfl)))
  · cases u
    · exact le_sup_left
    · exact le_sup_right
  · rintro _ ⟨e, rfl⟩
    exact SetLike.mem_coe.2 ((congrArg (· ∈ _) ((π₁.mk_eq_mk_iff.2
      ((B.segmentPath_loop e).pathMap B)).trans π₁.mk_nil)).mpr (one_mem _))

section segment

variable {P Q : Type w} {C : Type x} [Group P] [Group Q] [Group C] (f : C →* P) (g : C →* Q)
  (hf : Function.Injective f) (hg : Function.Injective g)

/-- The `𝔸`-graph with a single edge of label `(a, e, b)` over the graph of groups `𝔸` of an
amalgamated product `P ∗_C Q`: its vertices `false` and `true` have the types of the vertices of
`P` and `Q` and the groups `P₀ ≤ P` and `Q₀ ≤ Q`, and its dart `false` has type the dart `e` from
the vertex of `P` to the vertex of `Q`, with `f_α = a` and `f_ω = b`. -/
@[expose] def segment (P₀ : Subgroup P) (Q₀ : Subgroup Q) (a : P) (b : Q) :
    (GraphOfGroups.segment f g hf hg).AGraph SerreGraph.segment where
  type :=
    { mapV := id
      mapE := id
      map_src _ := rfl
      map_rev _ := rfl }
  vertexSubgroup
    | false => P₀
    | true => Q₀
  labelα
    | false => a
    | true => (b⁻¹ : Q)

/-- The dart of the single edge reads its label `(a, e, b)`. -/
private theorem segment_pathMap_ofDart (P₀ : Subgroup P) (Q₀ : Subgroup Q) (a : P) (b : Q) :
    (segment f g hf hg P₀ Q₀ a b).pathMap (Path.ofDart (SerreGraph.segment.dart false)) =
      ((Path.ofVertex a).comp (Path.ofDart (SerreGraph.segment.dart false))).comp
        (Path.ofVertex b) :=
  ((segment f g hf hg P₀ Q₀ a b).pathMap_ofDart false).trans <| congrArg₂
    (fun (x : SerreGraph.segment.src false ⟶ SerreGraph.segment.tgt false) (y : Q) =>
      ((Path.ofVertex (𝔸 := GraphOfGroups.segment f g hf hg)
        (a := SerreGraph.segment.src false) a).comp (Path.ofDart x)).comp
          (Path.ofVertex (𝔸 := GraphOfGroups.segment f g hf hg)
            (a := SerreGraph.segment.tgt false) y))
    (Subtype.ext rfl) (inv_inv b)

/-- The single edge `(a, e, b)` between vertices with groups `P₀ ≤ P` and `Q₀ ≤ Q` represents the
subgroup `⟨P₀, (a e b) Q₀ (a e b)⁻¹⟩` of `π₁(𝔸, v₀)`, the fundamental group (in the path model) of
the graph of groups of the amalgamated product `P ∗_C Q`, based at the vertex of `P`. -/
theorem segment_subgroup (P₀ : Subgroup P) (Q₀ : Subgroup Q) (a : P) (b : Q) :
    (segment f g hf hg P₀ Q₀ a b).subgroup false = P₀.map (π₁.vertexHom Quiver.Path.nil) ⊔
      Q₀.map (π₁.vertexHom (((Path.ofVertex a).comp
        (Path.ofDart (SerreGraph.segment.dart false))).comp (Path.ofVertex b))) := by
  have hD := congrArg (fun p : (GraphOfGroups.segment f g hf hg).Path
    ⟨SerreGraph.segment.src false⟩ ⟨SerreGraph.segment.tgt false⟩ => Q₀.map (π₁.vertexHom p))
      (segment_pathMap_ofDart f g hf hg P₀ Q₀ a b)
  exact (subgroup_false_of_segment _).trans (le_antisymm (sup_le le_sup_left
    (le_sup_of_le_right hD.le)) (sup_le le_sup_left (le_sup_of_le_right hD.ge)))

end segment

end AGraph

end GraphOfGroups

end TauCeti
