module

public import TauCeti.GroupTheory.GraphOfGroups.Presentation

/-!
# The fundamental group of a restriction of a graph of groups

For a graph of groups `𝔸` over a Serre graph `Γ` and a reversal-closed set `S` of darts, the
restriction `𝔸.restrict S hS` over the subgraph `Γ.restrict S hS` keeps every vertex group of `𝔸`,
and the edge groups and boundary monomorphisms of the darts in `S`.

The inclusion of the subgraph induces a homomorphism of fundamental groups. In the presented
model, if `T'` is a set of darts of the subgraph each of which lies in a set `T` of darts of `Γ` up
to reversal, then `TauCeti.GraphOfGroups.π₁Tree.restrictInclusion` maps `π₁(𝔸|_S, T')` to
`π₁(𝔸, T)`, sending each vertex group identically and each dart to itself. It is surjective when
every dart outside `S` lies in `T` up to reversal, since `π₁(𝔸, T)` is generated by the vertex
groups and the darts and such a dart is trivial in `π₁(𝔸, T)`. Restricting to all darts gives
back `π₁(𝔸, T)`.

Unlike a subgraph of groups in the sense of a connected subgraph with its own vertices, the
restriction keeps every vertex of `Γ`; this is the form needed for a maximal tree, which contains
every vertex.

## Main definitions

* `TauCeti.GraphOfGroups.π₁Tree.restrictInclusion`: the homomorphism `π₁(𝔸|_S, T') →* π₁(𝔸, T)`.
* `TauCeti.GraphOfGroups.π₁Tree.restrictUnivEquiv`: restricting to all darts does not change
  `π₁(𝔸, T)`.

## Main results

* `TauCeti.GraphOfGroups.π₁Tree.restrictInclusion_surjective`: the induced homomorphism is
  surjective when every dart outside `S` lies in `T` up to reversal.

## References

* J.-P. Serre, *Trees*, Chapter I, §4.4 and §5.1.
* I. Kapovich, R. Weidmann, A. Myasnikov, *Foldings, graphs of groups and the membership problem*,
  Internat. J. Algebra Comput. 15 (2005), §2, Convention 2.1 and Proposition 2.4.
-/

public section

universe u v w x

namespace TauCeti

namespace GraphOfGroups

namespace π₁Tree

variable {Γ : SerreGraph.{u, v}} {𝔸 : GraphOfGroups.{u, v, w, x} Γ}
  {S : Set Γ.E} {hS : ∀ e ∈ S, Γ.rev e ∈ S} {T : Set Γ.E} {T' : Set (Γ.restrict S hS).E}

variable (𝔸) in
/-- The homomorphism `π₁(𝔸|_S, T') →* π₁(𝔸, T)` induced by the inclusion of the subgraph
`Γ.restrict S hS`, for a set `T'` of darts of the subgraph each of which lies in `T` up to
reversal: it is the identity on each vertex group and sends each dart to itself. -/
def restrictInclusion (hT : ∀ e ∈ T', (e : Γ.E) ∈ T ∨ Γ.rev e ∈ T) :
    π₁Tree (𝔸.restrict S hS) T' →* π₁Tree 𝔸 T :=
  lift (fun v => of T v) (fun e => edge T e.1)
    (fun e he => (hT e he).elim edge_eq_one edge_eq_one_of_rev_mem)
    (fun e => edge_rev (T := T) e.1) fun e c => by
      rw [restrict_ω_apply, restrict_α_apply]
      exact edge_mul_of_ω_mul_edge_inv e.1 _

section restrictInclusion

variable (hT : ∀ e ∈ T', (e : Γ.E) ∈ T ∨ Γ.rev e ∈ T)

@[simp] theorem restrictInclusion_of (v : Γ.V) (a : (𝔸.restrict S hS).vertexGroup v) :
    restrictInclusion 𝔸 hT (of T' v a) = of T v a :=
  lift_of ..

@[simp] theorem restrictInclusion_comp_of (v : Γ.V) :
    (restrictInclusion 𝔸 hT).comp (of T' v) = of T v :=
  lift_comp_of ..

@[simp] theorem restrictInclusion_edge (e : (Γ.restrict S hS).E) :
    restrictInclusion 𝔸 hT (edge T' e) = edge T e.1 :=
  lift_edge ..

/-- The homomorphism induced by the inclusion of a subgraph is surjective when every dart outside
the subgraph lies in `T` up to reversal. -/
theorem restrictInclusion_surjective (hST : ∀ e ∉ S, e ∈ T ∨ Γ.rev e ∈ T) :
    Function.Surjective (restrictInclusion 𝔸 hT) := by
  have hrange : (restrictInclusion 𝔸 hT).range =
      (⨆ v, (of T v).range) ⊔ Subgroup.closure (Set.range fun e : S => edge T e.1) :=
    range_lift ..
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← iSup_range_of_sup_closure_range_edge, hrange]
  refine sup_le_sup_left ((Subgroup.closure_le _).2 ?_) _
  rintro _ ⟨e, rfl⟩
  by_cases he : e ∈ S
  · exact Subgroup.subset_closure ⟨⟨e, he⟩, rfl⟩
  · simp [(hST e he).elim edge_eq_one edge_eq_one_of_rev_mem]

end restrictInclusion

/-- The defining relation of a dart of the restriction, in terms of the boundary maps of `𝔸`. -/
private theorem edge_mul_of_ω_mul_edge_inv_restrict (e : (Γ.restrict S hS).E)
    (c : 𝔸.edgeGroup (Γ.toGeomEdge e.1)) :
    edge T' e * of (𝔸 := 𝔸.restrict S hS) T' (Γ.tgt e.1) (𝔸.ω e.1 c) * (edge T' e)⁻¹ =
      of (𝔸 := 𝔸.restrict S hS) T' (Γ.src e.1) (𝔸.α e.1 c) := by
  have h := edge_mul_of_ω_mul_edge_inv (𝔸 := 𝔸.restrict S hS) (T := T') e
    ((MulEquiv.cast (M := 𝔸.edgeGroup) (SerreGraph.GeomEdge.lift_toGeomEdge _ _ _ e)).symm c)
  rwa [restrict_ω_apply, restrict_α_apply, MulEquiv.apply_symm_apply] at h

/-- A dart of `Γ`, as a dart of the restriction of `Γ` to all of its darts. -/
private abbrev univDart (e : Γ.E) : (Γ.restrict Set.univ fun e _ => Set.mem_univ (Γ.rev e)).E :=
  ⟨e, Set.mem_univ e⟩

variable (𝔸 T) in
/-- Restricting a graph of groups to all of its darts does not change its fundamental group:
`π₁(𝔸|_E, T) ≃* π₁(𝔸, T)`, by the homomorphism induced by the inclusion. -/
def restrictUnivEquiv :
    π₁Tree (𝔸.restrict Set.univ fun e _ => Set.mem_univ (Γ.rev e)) (Subtype.val ⁻¹' T) ≃*
      π₁Tree 𝔸 T :=
  MonoidHom.toMulEquiv (restrictInclusion 𝔸 fun _ he => Or.inl he)
    (lift (fun v => of (𝔸 := 𝔸.restrict _ _) _ v) (fun e => edge _ (univDart e))
      (fun _ he => edge_eq_one he) (fun e => edge_rev (univDart e))
      fun e => edge_mul_of_ω_mul_edge_inv_restrict (univDart e))
    (hom_ext (fun v => by ext; simp) fun e => by simp)
    (hom_ext (fun v => by
      ext a
      simp only [MonoidHom.comp_apply, lift_of, MonoidHom.id_apply]
      exact restrictInclusion_of ..) fun e => by simp)

@[simp] theorem restrictUnivEquiv_apply
    (g : π₁Tree (𝔸.restrict Set.univ fun e _ => Set.mem_univ (Γ.rev e)) (Subtype.val ⁻¹' T)) :
    restrictUnivEquiv 𝔸 T g = restrictInclusion 𝔸 (fun _ he => Or.inl he) g :=
  (rfl)

@[simp] theorem restrictUnivEquiv_symm_of (v : Γ.V) (a : 𝔸.vertexGroup v) :
    (restrictUnivEquiv 𝔸 T).symm (of T v a) =
      of (𝔸 := 𝔸.restrict Set.univ fun e _ => Set.mem_univ (Γ.rev e)) (Subtype.val ⁻¹' T) v a :=
  lift_of ..

@[simp] theorem restrictUnivEquiv_symm_edge (e : Γ.E) :
    (restrictUnivEquiv 𝔸 T).symm (edge T e) =
      edge (𝔸 := 𝔸.restrict Set.univ fun e _ => Set.mem_univ (Γ.rev e)) (Subtype.val ⁻¹' T)
        ⟨e, Set.mem_univ e⟩ :=
  lift_edge ..

end π₁Tree

end GraphOfGroups

end TauCeti
