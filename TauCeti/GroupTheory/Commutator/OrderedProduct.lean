module

public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Algebra.Group.Submonoid.BigOperators
public import Mathlib.Data.Finset.Max
public import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.Tactic.Group

/-!
# Ordered products of subgroups with graded commutators

Let `X r` be subgroups of a group `G`, indexed by a finite set `S` and graded by a height
`ht : ι → κ` with values in a linear order. Suppose that the commutator of any two of them lies in
the subgroup generated by those of strictly greater height:

```text
⁅X r, X s⁆ ≤ ⨆ { X q | q ∈ S, max (ht r) (ht s) < ht q }.
```

Then the subgroup generated by all `X r` is the product of the `X r` taken **in any fixed order**:
for every enumeration `l` of `S` without repetitions, every element of `⨆ r ∈ S, X r` is an ordered
product `∏_{r ∈ l} f r` with `f r ∈ X r`
(`TauCeti.mem_biSup_iff_exists_list_prod_map`).

For the positive root subgroups `X_α` of a Chevalley group, graded by the height of roots, the
hypothesis is the Chevalley commutator formula: `⁅X_α, X_β⁆` lies in the subgroup generated by the
`X_{iα + jβ}` with `i, j > 0`, all of height greater than those of `α` and `β`, and `X_α` is
abelian. The conclusion is then the existence half of the normal form `∏_{α > 0} x_α(u_α)` of the
unipotent radical in an arbitrary order of the positive roots, and the same statement for any
closed set of positive roots. The uniqueness half is a separate, matrix-theoretic statement.

## Main results

* `TauCeti.mem_biSup_iff_exists_list_prod_map`: under the graded commutator hypothesis, the
  subgroup generated by the `X r` with `r ∈ S` consists of the ordered products along any
  enumeration of `S`.
* `TauCeti.exists_list_prod_map_mul_eq_of_mem_sup`: the same decomposition modulo a subgroup `Z`
  normalized by every `X r`, under the commutator hypothesis taken modulo `Z`.

## Implementation notes

The statement modulo `Z` is proved first, by induction on `S`. For an index `m` of maximal height,
the hypothesis says that `X m` commutes with every `X r` modulo `Z`, so a factor of `X m` can be
moved to the position of `m` in `l` at the cost of an element of `Z`. The commutators of the
remaining subgroups are only controlled modulo `X m ⊔ Z`, which is the subgroup used for the
induction on `S.erase m`.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, AMS University Lecture Series 66 (2016),
  Chapter 3, Lemma 17.
* R. W. Carter, *Simple Groups of Lie Type*, Wiley (1972), Theorem 5.3.3.
-/

public section

open Subgroup
open scoped commutatorElement

namespace TauCeti

variable {G ι κ : Type*} [Group G] [LinearOrder κ] {X : ι → Subgroup G} {ht : ι → κ}

/-- An element `y` whose commutators with the factors of a product lie in a subgroup `Z`
normalized by those factors can be moved from the right of the product to its left, at the cost
of a right factor in `Z`. -/
private theorem exists_list_prod_mul_eq_mul_list_prod_mul {Z : Subgroup G} {y : G} :
    ∀ as : List G, (∀ a ∈ as, a ∈ normalizer (Z : Set G) ∧ ⁅a⁻¹, y⁻¹⁆ ∈ Z) →
      ∃ c ∈ Z, as.prod * y = y * as.prod * c
  | [], _ => ⟨1, Z.one_mem, by simp⟩
  | a :: as, h => by
    have h' : ∀ b ∈ as, b ∈ normalizer (Z : Set G) ∧ ⁅b⁻¹, y⁻¹⁆ ∈ Z :=
      fun b hb => h b (List.mem_cons_of_mem a hb)
    obtain ⟨c, hc, hcy⟩ := exists_list_prod_mul_eq_mul_list_prod_mul as h'
    have hP : as.prod⁻¹ ∈ normalizer (Z : Set G) :=
      inv_mem (list_prod_mem fun b hb => (h' b hb).1)
    refine ⟨as.prod⁻¹ * ⁅a⁻¹, y⁻¹⁆ * as.prod⁻¹⁻¹ * c,
      mul_mem ((mem_normalizer_iff.mp hP _).mp (h a List.mem_cons_self).2) hc, ?_⟩
    rw [List.prod_cons, mul_assoc, hcy, commutatorElement_def]
    group

/-- **Ordered products of subgroups with graded commutators, modulo a subgroup.** Let `Z` be a
subgroup normalized by every `X r`, `r ∈ S`, and suppose that modulo `Z` the commutator of any two
of the `X r` lies in the subgroup generated by those of strictly greater height. Then for every
enumeration `l` of `S` without repetitions, every element of `(⨆ r ∈ S, X r) ⊔ Z` is an ordered
product `∏_{r ∈ l} f r` with `f r ∈ X r`, followed by an element of `Z`.

The case `Z = ⊥` is `TauCeti.mem_biSup_iff_exists_list_prod_map`. -/
theorem exists_list_prod_map_mul_eq_of_mem_sup {S : Finset ι} {Z : Subgroup G}
    (hnorm : ∀ r ∈ S, X r ≤ normalizer (Z : Set G))
    (hcomm : ∀ r ∈ S, ∀ s ∈ S,
      ⁅X r, X s⁆ ≤ (⨆ q ∈ {q ∈ S | max (ht r) (ht s) < ht q}, X q) ⊔ Z)
    {l : List ι} (hl : l.Nodup) (hlS : ∀ r, r ∈ l ↔ r ∈ S) {g : G} (hg : g ∈ (⨆ r ∈ S, X r) ⊔ Z) :
    ∃ f : ι → G, (∀ r, f r ∈ X r) ∧ ∃ z ∈ Z, (l.map f).prod * z = g := by
  classical
  induction S using Finset.strongInduction generalizing Z l g with
  | H S ih =>
  rcases S.eq_empty_or_nonempty with rfl | hne
  · obtain rfl : l = [] := List.eq_nil_iff_forall_not_mem.mpr fun r hr =>
      absurd hr (by simpa using hlS r)
    refine ⟨1, fun r => one_mem _, g, ?_, one_mul g⟩
    simpa using hg
  -- Remove an index `m` of maximal height; its subgroup commutes with every `X r` modulo `Z`.
  obtain ⟨m, hm, hmax⟩ := S.exists_max_image ht hne
  have hcommZ : ∀ r ∈ S, ⁅X r, X m⁆ ≤ Z := fun r hr =>
    (hcomm r hr m hm).trans <| sup_le (iSup₂_le fun q hq => by
      obtain ⟨hqS, hlt⟩ := Finset.mem_filter.mp hq
      exact absurd ((le_max_right _ _).trans_lt hlt) (not_lt.mpr (hmax q hqS))) le_rfl
  have hmono : ∀ T T' : Finset ι, (∀ q ∈ T, q ≠ m → q ∈ T') →
      (⨆ q ∈ T, X q) ⊔ Z ≤ (⨆ q ∈ T', X q) ⊔ (X m ⊔ Z) := by
    intro T T' hTT'
    refine sup_le (iSup₂_le fun q hq => ?_) (le_sup_right.trans le_sup_right)
    by_cases hqm : q = m
    · exact hqm ▸ le_sup_left.trans le_sup_right
    · exact (le_iSup₂ (f := fun q _ => X q) q (hTT' q hq hqm)).trans le_sup_left
  -- The hypotheses for `S.erase m` and the enlarged error term `X m ⊔ Z`.
  have hnorm' : ∀ r ∈ S.erase m, X r ≤ normalizer ((X m ⊔ Z : Subgroup G) : Set G) := by
    intro r hr
    have hrS := Finset.mem_of_mem_erase hr
    refine le_normalizer_iff.mpr fun x hx k hk => ?_
    suffices X m ⊔ Z ≤ (X m ⊔ Z).comap (MulAut.conj x).toMonoidHom from this hk
    refine sup_le (fun y hy => ?_) (fun z hz => ?_) <;>
      simp only [mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    · have hxy : x * y * x⁻¹ = ⁅x, y⁆ * y := by rw [commutatorElement_def]; group
      rw [hxy]
      exact mul_mem (mem_sup_right (hcommZ r hrS (commutator_mem_commutator hx hy)))
        (mem_sup_left hy)
    · exact mem_sup_right ((mem_normalizer_iff.mp (hnorm r hrS hx) z).mp hz)
  have hcomm' : ∀ r ∈ S.erase m, ∀ s ∈ S.erase m,
      ⁅X r, X s⁆ ≤ (⨆ q ∈ {q ∈ S.erase m | max (ht r) (ht s) < ht q}, X q) ⊔ (X m ⊔ Z) :=
    fun r hr s hs => (hcomm r (Finset.mem_of_mem_erase hr) s (Finset.mem_of_mem_erase hs)).trans
      (hmono _ _ fun q hq hqm => by
        simp only [Finset.mem_filter, Finset.mem_erase] at hq ⊢
        exact ⟨⟨hqm, hq.1⟩, hq.2⟩)
  have hlS' : ∀ r, r ∈ l.erase m ↔ r ∈ S.erase m := fun r => by
    rw [hl.mem_erase_iff, Finset.mem_erase, hlS]
  have hg' := hmono S (S.erase m) (fun q hq hqm => Finset.mem_erase.mpr ⟨hqm, hq⟩) hg
  obtain ⟨f, hf, w, hw, rfl⟩ :=
    ih _ (Finset.erase_ssubset hm) hnorm' hcomm' (hl.erase m) hlS' hg'
  -- Split the error term as `y * z` and move `y` to the position of `m` in `l`.
  rw [← SetLike.mem_coe, coe_mul_of_left_le_normalizer_right _ _ (hnorm m hm)] at hw
  obtain ⟨y, hy, z, hz, rfl⟩ := hw
  obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem ((hlS m).mpr hm)
  have hm₁₂ : m ∉ l₁ ++ l₂ := (List.nodup_cons.mp (List.nodup_middle.mp hl)).1
  have hm₁ : m ∉ l₁ := fun h => hm₁₂ (List.mem_append_left _ h)
  have hm₂ : m ∉ l₂ := fun h => hm₁₂ (List.mem_append_right _ h)
  obtain ⟨c, hc, hcy⟩ := exists_list_prod_mul_eq_mul_list_prod_mul (Z := Z) (y := y)
    (l₂.map f) fun a ha => by
      obtain ⟨q, hq, rfl⟩ := List.mem_map.mp ha
      have hqS : q ∈ S := (hlS q).mp (List.mem_append_right _ (List.mem_cons_of_mem m hq))
      exact ⟨hnorm q hqS (hf q),
        hcommZ q hqS (commutator_mem_commutator (inv_mem (hf q)) (inv_mem hy))⟩
  have hupdate : ∀ l' : List ι, m ∉ l' → l'.map (Function.update f m y) = l'.map f :=
    fun l' hl' => List.map_congr_left fun q hq =>
      Function.update_of_ne (fun hqm => hl' (by rwa [← hqm])) _ _
  refine ⟨Function.update f m y, fun r => ?_, c * z, mul_mem hc hz, ?_⟩
  · rcases eq_or_ne r m with rfl | hrm
    · simpa using hy
    · simpa [Function.update_of_ne hrm] using hf r
  · rw [List.erase_append_right _ hm₁, List.erase_cons_head, List.map_append, List.map_cons,
      List.prod_append, List.prod_cons, List.map_append, List.prod_append, hupdate l₁ hm₁,
      hupdate l₂ hm₂, Function.update_self]
    calc (l₁.map f).prod * (y * (l₂.map f).prod) * (c * z)
        = (l₁.map f).prod * (y * (l₂.map f).prod * c) * z := by group
      _ = (l₁.map f).prod * (l₂.map f).prod * (y * z) := by rw [← hcy]; group

/-- **Ordered products of subgroups with graded commutators** (Steinberg). Let the subgroups
`X r`, `r ∈ S`, be graded by a height `ht` so that the commutator of any two of them lies in the
subgroup generated by those of strictly greater height. Then for every enumeration `l` of `S`
without repetitions, the subgroup they generate consists exactly of the ordered products
`∏_{r ∈ l} f r` with `f r ∈ X r`.

For the positive root subgroups of a Chevalley group graded by the height of roots, this is the
existence of the expression `∏_{α > 0} x_α(u_α)` in any fixed order of the positive roots. -/
theorem mem_biSup_iff_exists_list_prod_map {S : Finset ι}
    (hcomm : ∀ r ∈ S, ∀ s ∈ S, ⁅X r, X s⁆ ≤ ⨆ q ∈ {q ∈ S | max (ht r) (ht s) < ht q}, X q)
    {l : List ι} (hl : l.Nodup) (hlS : ∀ r, r ∈ l ↔ r ∈ S) {g : G} :
    g ∈ ⨆ r ∈ S, X r ↔ ∃ f : ι → G, (∀ r, f r ∈ X r) ∧ (l.map f).prod = g := by
  constructor
  · intro hg
    obtain ⟨f, hf, z, hz, rfl⟩ := exists_list_prod_map_mul_eq_of_mem_sup (Z := ⊥)
      (fun _ _ => le_normalizer_of_normal) (fun r hr s hs => by simpa using hcomm r hr s hs)
      hl hlS (by simpa using hg)
    exact ⟨f, hf, by simp [(mem_bot.mp hz)]⟩
  · rintro ⟨f, hf, rfl⟩
    refine list_prod_mem fun a ha => ?_
    obtain ⟨r, hr, rfl⟩ := List.mem_map.mp ha
    exact le_iSup₂ (f := fun r _ => X r) r ((hlS r).mp hr) (hf r)

end TauCeti
