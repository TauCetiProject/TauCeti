/-!
# Merzljakov's theorem with an inequation

Let `F = F(A)` be a free group and `S ⊆ F[X]` a system that every point of `F` solves, such as
the empty system. If `T(X, Y) = 1 ∧ W(X, Y) ≠ 1`, for one equation `T`, is compatible with `S`,
that is `∀X ∃Y (T = 1 ∧ W ≠ 1)` holds in `F`, then it has a solution at the generic point of `S`:
there are words `Y(X) ∈ F[X]` such that `T(X, Y(X)) = 1` and `W(X, Y(X)) ≠ 1` hold at the generic
point (`TauCeti.GroupAlgGeom.Lift.hasLiftNe_of_V_eq_univ`).

The hypothesis on `S` is satisfied by the empty system, the case of the implicit function theorem
for regular NTQ systems whose levels are all empty. No hypothesis on the rank of `F` is needed.

## Proof outline

For a free group on at least two letters this is Merzljakov's theorem for one block of
quantifiers, together with the fact that the formal solution of its proof takes, at one tuple of
Merzljakov words, the values of the witnesses chosen there
(`FreeGroup.exists_formalSolution_lift_eq_of_skolem`). For a free group of rank at most one, `F` is
commutative and the statement is a fact about linear equations over `ℤ`: solutions `Y(0)` over the
point `0` and `Y(eₓ)` over the basis points `eₓ` give the affine formal solution
`Y(X) = Y(0) + Σₓ xₓ (Y(eₓ) - Y(0))`, at which `W` does not vanish since it does not vanish at `0`.

## Main results

* `TauCeti.GroupAlgGeom.Lift.hasLiftNe_of_V_eq_univ`: Merzljakov's theorem with an inequation.

## References

* [IFT] O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra
  290 (2005), §4.4, Merzljakov's Theorem and Theorem 4, and §7.6, the proof of Theorem 11.
-/

public section

namespace TauCeti.GroupAlgGeom.Lift

open Monoid.Coprod

variable {A X Y : Type*}

section Words

/-- Evaluation of a word over `F(A)` is evaluation of the corresponding word of the free group on
the variables and the letters of `A`. -/
private theorem eval_id_eq_lift {Z : Type*} (p : Z → FreeGroup A) (u : GX (FreeGroup A) Z) :
    eval (.id _) p u = FreeGroup.lift (Sum.elim p .of)
      (GX.mulEquivFreeGroupSum (FreeGroupBasis.ofFreeGroup A) Z u) := by
  rw [GX.eval_eq_lift_mulEquivFreeGroupSum (FreeGroupBasis.ofFreeGroup A)]
  simp [Function.comp_def]

variable {t W : GX (FreeGroup A) (X ⊕ Y)}

/-- Over a free group on at least two letters: words solving `T` at every point and not killing
`W` at one point, by Merzljakov's theorem with the values of the formal solution. -/
private theorem exists_wordMap_of_nontrivial [Nontrivial A]
    (h : ∀ v : X → FreeGroup A, ∃ w : Y → FreeGroup A,
      eval (.id _) (Sum.elim v w) t = 1 ∧ eval (.id _) (Sum.elim v w) W ≠ 1) :
    ∃ y : Y → GX (FreeGroup A) X, (∀ θ, eval (.id _) (Sum.elim θ (wordMap (.id _) y θ)) t = 1) ∧
      ∃ v, eval (.id _) (Sum.elim v (wordMap (.id _) y v)) W ≠ 1 := by
  obtain ⟨a, b, hab⟩ := exists_pair_ne A
  choose w hw hW using h
  obtain ⟨y, g, hy, hg⟩ := FreeGroup.exists_formalSolution_lift_eq_of_skolem hab
    (GX.mulEquivFreeGroupSum (FreeGroupBasis.ofFreeGroup A) _ t) w
    fun x => by rw [← eval_id_eq_lift]; exact hw x
  have hwm (θ : X → FreeGroup A) : wordMap (.id _)
      (fun j => (GX.mulEquivFreeGroupSum (FreeGroupBasis.ofFreeGroup A) X).symm (y j)) θ =
        fun j => FreeGroup.lift (Sum.elim θ .of) (y j) :=
    funext fun j => by simp [eval_id_eq_lift]
  refine ⟨fun j => (GX.mulEquivFreeGroupSum (FreeGroupBasis.ofFreeGroup A) X).symm (y j),
    fun θ => ?_, g, ?_⟩
  · have hcomp : (FreeGroup.lift (Sum.elim θ .of)).comp
        (FreeGroup.lift (Sum.elim (Sum.elim (.of ∘ Sum.inl) y) (.of ∘ Sum.inr))) =
        FreeGroup.lift (Sum.elim (Sum.elim θ fun j => FreeGroup.lift (Sum.elim θ .of) (y j)) .of) :=
      FreeGroup.ext_hom _ _ fun z => by rcases z with (x | j) | c <;> simp
    rw [hwm, eval_id_eq_lift, ← hcomp, MonoidHom.comp_apply, hy, map_one]
  · rw [hwm, eval_id_eq_lift, funext hg, ← eval_id_eq_lift]
    exact hW g

/-- Over a commutative group `K` generated by `c`, with finitely many variables `X`: if `t` vanishes
at the point `x ↦ 1`, `y ↦ p₀ y`, and at the points `x ↦ c`, `y ↦ p₀ y * c ^ N x y` (all other
variables `x'` sent to `1`), then it vanishes at every point `θ`, `y ↦ p₀ y * ∏ₓ θ x ^ N x y`:
evaluation at these points is a homomorphism in `θ`. -/
private theorem eval_sumElim_mul_prod_eq_one {G K : Type*} [Group G] [CommGroup K] [Fintype X]
    [DecidableEq X] {ι : G →* K} {c : K} (hc : ∀ q : K, ∃ n : ℤ, c ^ n = q) (N : X → Y → ℤ)
    {t : GX G (X ⊕ Y)} {p₀ : Y → K} (h₀ : eval ι (Sum.elim 1 p₀) t = 1)
    (h : ∀ x, eval ι (Sum.elim (Pi.mulSingle x c) (p₀ * fun j => c ^ N x j)) t = 1) (θ : X → K) :
    eval ι (Sum.elim θ (p₀ * fun j => ∏ x, θ x ^ N x j)) t = 1 := by
  let P (θ : X → K) : X ⊕ Y → K := Sum.elim θ (p₀ * fun j => ∏ x, θ x ^ N x j)
  have hP₁ : eval ι (P 1) t = 1 := by simpa [P, Pi.mul_def] using h₀
  -- in a commutative group, `P (θ * θ') = P θ * (P 1)⁻¹ * P θ'` and evaluation respects this
  let L : (X → K) →* K := MonoidHom.mk' (fun θ => eval ι (P θ) t) fun θ θ' => by
    have hP : P (θ * θ') = P θ * (P 1)⁻¹ * P θ' := by
      ext (x | j) <;> simp [P, mul_zpow, Finset.prod_mul_distrib, mul_assoc, mul_left_comm]
    simp [hP, eval_mul_inv_mul, hP₁]
  have hL : L = 1 := MonoidHom.functions_ext _ L 1 fun x q => by
    obtain ⟨n, rfl⟩ := hc q
    have hx : L (Pi.mulSingle x c) = 1 := by
      refine (congrArg (eval ι · t) ?_).trans (h x)
      ext (x' | j)
      · rfl
      · simp only [P, Sum.elim_inr, Pi.mul_apply]
        rw [Finset.prod_eq_single x (fun x' _ hx' => by simp [Pi.mulSingle_eq_of_ne hx'])
          (by simp), Pi.mulSingle_eq_same]
    rw [Pi.mulSingle_zpow, map_zpow, hx, one_zpow, MonoidHom.one_apply]
  exact DFunLike.congr_fun hL θ

open scoped IsMulCommutative in
/-- Over a free group of rank at most one, with finitely many variables `X`: the free group is
cyclic, and the solutions over `1` and over the basis points give an affine formal solution. -/
private theorem exists_wordMap_of_subsingleton_of_finite [Subsingleton A] [Finite X]
    (h : ∀ v : X → FreeGroup A, ∃ w : Y → FreeGroup A,
      eval (.id _) (Sum.elim v w) t = 1 ∧ eval (.id _) (Sum.elim v w) W ≠ 1) :
    ∃ y : Y → GX (FreeGroup A) X, (∀ θ, eval (.id _) (Sum.elim θ (wordMap (.id _) y θ)) t = 1) ∧
      ∃ v, eval (.id _) (Sum.elim v (wordMap (.id _) y v)) W ≠ 1 := by
  classical
  have := Fintype.ofFinite X
  have : IsMulCommutative (FreeGroup A) := FreeGroup.isMulCommutative_iff_subsingleton.2 ‹_›
  -- `F(A)` is cyclic, generated by some `c`
  obtain ⟨c, hc⟩ := exists_zpow_surjective (FreeGroup A)
  replace hc (q : FreeGroup A) : ∃ n : ℤ, c ^ n = q := hc q
  choose w hw hW using h
  -- the exponents `N x j` with `c ^ N x j = w eₓ j / w 1 j`, where `eₓ` is `c` at `x`, `1` at
  -- the other variables
  choose N hN using fun x j => hc (w (Pi.mulSingle x c) j * (w 1 j)⁻¹)
  have hwx (x : X) : w (Pi.mulSingle x c) = w 1 * fun j => c ^ N x j :=
    funext fun j => by rw [Pi.mul_apply, hN, mul_comm (w 1 j), inv_mul_cancel_right]
  -- the affine formal solution `y j = w 1 j * ∏ x, x ^ N x j`
  let y (j : Y) : GX (FreeGroup A) X := inl (w 1 j) *
    (Finset.univ.toList.map fun x => (inr (FreeGroup.of x) : GX (FreeGroup A) X) ^ N x j).prod
  have hy (θ : X → FreeGroup A) :
      wordMap (.id _) y θ = w 1 * fun j => ∏ x, θ x ^ N x j :=
    funext fun j => by simp [y, map_list_prod, List.map_map, Function.comp_def,
      Finset.prod_map_toList]
  refine ⟨y, fun θ => ?_, 1, ?_⟩
  · rw [hy]
    exact eval_sumElim_mul_prod_eq_one hc N (hw 1) (fun x => hwx x ▸ hw _) θ
  · rw [hy]
    convert hW 1 using 3
    ext (_ | _) <;> simp

/-- Over a free group of rank at most one: reduction to finitely many variables `X`. -/
private theorem exists_wordMap_of_subsingleton [Subsingleton A]
    (h : ∀ v : X → FreeGroup A, ∃ w : Y → FreeGroup A,
      eval (.id _) (Sum.elim v w) t = 1 ∧ eval (.id _) (Sum.elim v w) W ≠ 1) :
    ∃ y : Y → GX (FreeGroup A) X, (∀ θ, eval (.id _) (Sum.elim θ (wordMap (.id _) y θ)) t = 1) ∧
      ∃ v, eval (.id _) (Sum.elim v (wordMap (.id _) y v)) W ≠ 1 := by
  classical
  obtain ⟨X₀, hX₀⟩ := GX.exists_finset_forall_mem_range_map_sumMap_left {t, W}
  obtain ⟨t₀, rfl⟩ := hX₀ t (by simp)
  obtain ⟨W₀, rfl⟩ := hX₀ W (by simp)
  -- points over `X₀` extend by `1` to points over `X`
  have hext (v₀ : X₀ → FreeGroup A) : Function.extend ((↑) : X₀ → X) v₀ 1 ∘ (↑) = v₀ :=
    funext fun x => Subtype.val_injective.extend_apply _ _ x
  have hcomp (v : X → FreeGroup A) (w : Y → FreeGroup A) :
      Sum.elim v w ∘ Sum.map ((↑) : X₀ → X) id = Sum.elim (v ∘ (↑)) w := by
    ext (x | j) <;> rfl
  obtain ⟨y₀, hy₀, v₀, hv₀⟩ := exists_wordMap_of_subsingleton_of_finite (t := t₀) (W := W₀)
    fun v₀ => by
      obtain ⟨w, hw, hW⟩ := h (Function.extend (↑) v₀ 1)
      rw [eval_map, MonoidHom.comp_id, hcomp, hext] at hw hW
      exact ⟨w, hw, hW⟩
  have hwm (θ : X → FreeGroup A) :
      wordMap (.id _) (fun j => Monoid.Coprod.map (.id _) (FreeGroup.map (↑)) (y₀ j)) θ =
        wordMap (.id _) y₀ (θ ∘ (↑)) :=
    funext fun j => by simp [eval_map]
  refine ⟨fun j => Monoid.Coprod.map (.id _) (FreeGroup.map (↑)) (y₀ j), fun θ => ?_,
    Function.extend (↑) v₀ 1, ?_⟩
  · rw [eval_map, MonoidHom.comp_id, hcomp, hwm]
    exact hy₀ _
  · rw [eval_map, MonoidHom.comp_id, hcomp, hwm, hext]
    exact hv₀

/-- Words solving `T` at every point and not killing `W` at one point. -/
private theorem exists_wordMap (h : ∀ v : X → FreeGroup A, ∃ w : Y → FreeGroup A,
      eval (.id _) (Sum.elim v w) t = 1 ∧ eval (.id _) (Sum.elim v w) W ≠ 1) :
    ∃ y : Y → GX (FreeGroup A) X, (∀ θ, eval (.id _) (Sum.elim θ (wordMap (.id _) y θ)) t = 1) ∧
      ∃ v, eval (.id _) (Sum.elim v (wordMap (.id _) y v)) W ≠ 1 :=
  (subsingleton_or_nontrivial A).elim (fun _ => exists_wordMap_of_subsingleton h)
    fun _ => exists_wordMap_of_nontrivial h

end Words

/-- **Merzljakov's theorem with an inequation.** Let `S` be a system over a free group `F(A)`
that every point solves. If `T = 1 ∧ W ≠ 1`, for one equation `T` and one inequation `W ≠ 1`, is
compatible with `S`, it has a solution at the generic point of `S`. For `S = ∅` this is
Merzljakov's theorem in the form with one equation and one inequation, for a free group `F(A)` of
any rank. -/
theorem hasLiftNe_of_V_eq_univ {S : Set (GX (FreeGroup A) X)}
    (hS : V (.id (FreeGroup A)) S = Set.univ) {t W : GX (FreeGroup A) (X ⊕ Y)}
    (h : IsCompatibleNe (.id _) S {t} W) : HasLiftNe (.id _) S {t} W := by
  obtain ⟨y, hy, v, hv⟩ := exists_wordMap (t := t) (W := W) fun v => by
    obtain ⟨w, hw, hW⟩ := isCompatibleNe_iff.1 h v (hS ▸ Set.mem_univ v)
    exact ⟨w, by simpa using hw, hW⟩
  -- at the generic point `μ` of `S`, a word vanishes exactly when it vanishes at every point
  let κ := CoordGroup.coeff (.id (FreeGroup A)) S
  let μ := CoordGroup.genericPoint (.id (FreeGroup A)) S
  have hμ (u : GX (FreeGroup A) (X ⊕ Y)) : eval κ (Sum.elim μ (wordMap κ y μ)) u = 1 ↔
      ∀ θ, eval (.id _) (Sum.elim θ (wordMap (.id _) y θ)) u = 1 := by
    simp [κ, μ, eval_sumElim_wordMap, CoordGroup.eval_genericPoint, QuotientGroup.eq_one_iff,
      mem_Rad, hS]
  exact hasLiftNe_iff.2 ⟨wordMap κ y μ, mem_V.2 fun _ hu => (Set.mem_singleton_iff.1 hu).symm ▸
    (hμ t).2 hy, fun h1 => hv ((hμ W).1 h1 v)⟩

end TauCeti.GroupAlgGeom.Lift
