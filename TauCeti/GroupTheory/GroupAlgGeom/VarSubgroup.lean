module

public import TauCeti.GroupTheory.GroupAlgGeom.ReducedWord
import Mathlib.Algebra.Group.Submonoid.BigOperators
import Mathlib.GroupTheory.FreeGroup.Reduce

/-!
# Words of `G[X]` in a subset of the variables

For a set `s` of variables, the words of the free `G`-group `G[X]` that involve only the
coefficients and the variables of `s` form a subgroup, the image of `G[s] → G[X]`. It is generated
by the coefficients and the variables of `s`, it determines `s`, the value of such a word at a point
depends only on the coordinates of the point in `s`, and substituting such words for the variables
of a word of this kind gives again a word of this kind.

Constraints of this kind express the dependence of the witnesses of a positive sentence on the
universally quantified variables: in a formal solution of `∀ x₀ ∃ y₀ … ∀ x_{k-1} ∃ y_{k-1} (S = 1)`
the word substituted for `y i` lies in the subgroup of the variables `x₀, …, x_i`.

## Main definitions

* `TauCeti.GroupAlgGeom.GX.varSubgroup G s`: the subgroup of `G[X]` of words in the coefficients
  and the variables of a set `s ⊆ X`.

## Main results

* `TauCeti.GroupAlgGeom.GX.varSubgroup_eq_closure`: it is generated by the coefficients and the
  variables of `s`.
* `TauCeti.GroupAlgGeom.GX.mem_varSubgroup_iff_occVars_subset`: a word belongs to `varSubgroup G s`
  exactly when all of its occurring variables belong to `s`.
* `TauCeti.GroupAlgGeom.GX.varSubgroup_le_varSubgroup_iff`: `varSubgroup G s ≤ varSubgroup G t`
  exactly when `s ⊆ t`.
* `TauCeti.GroupAlgGeom.GX.eval_eq_eval_of_mem_varSubgroup`,
  `TauCeti.GroupAlgGeom.GX.eval_congr`: the value of a word of `varSubgroup G s` depends only on
  the values of the variables of `s`, and the value of any word depends only on its occurring
  variables.
* `TauCeti.GroupAlgGeom.GX.eval_mem_varSubgroup`: `varSubgroup` is closed under substitution.

## References

* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §4.4.
-/

public section

namespace TauCeti.GroupAlgGeom

open Monoid.Coprod FreeGroup

variable {G H X : Type*} [Group G] [Group H]

namespace GX

variable (G) in
/-- The subgroup `G[s]` of `G[X]` of the words in the coefficients and the variables of a set
`s ⊆ X`: the image of `G[s] → G[X]`. -/
def varSubgroup (s : Set X) : Subgroup (GX G X) :=
  (Monoid.Coprod.map (MonoidHom.id G) (FreeGroup.map ((↑) : s → X))).range

variable {s : Set X} {w : GX G X}

/-- A word lies in `G[s]` exactly when it is the image of a word of the free `G`-group on `s`. -/
theorem mem_varSubgroup_iff :
    w ∈ varSubgroup G s ↔
      ∃ u : GX G s, Monoid.Coprod.map (MonoidHom.id G) (FreeGroup.map (↑)) u = w :=
  Iff.rfl

/-- `G[s]` is generated by the coefficients and the variables of `s`. -/
theorem varSubgroup_eq_closure (s : Set X) :
    varSubgroup G s =
      Subgroup.closure (Set.range (inl : G → GX G X) ∪ (fun x => inr (of x)) '' s) := by
  rw [varSubgroup, range_eq, map_comp_inl, map_comp_inr]
  simp [MonoidHom.range_comp, FreeGroup.range_map, MonoidHom.map_closure, Set.image_image,
    Subgroup.closure_union, ← MonoidHom.coe_range]

/-- Coefficients lie in `G[s]`. -/
@[simp]
theorem inl_mem_varSubgroup (s : Set X) (g : G) : inl g ∈ varSubgroup G s :=
  ⟨inl g, by simp⟩

/-- The variables of `s` lie in `G[s]`. -/
theorem inr_of_mem_varSubgroup {x : X} (hx : x ∈ s) : inr (of x) ∈ varSubgroup G s :=
  ⟨inr (of ⟨x, hx⟩), by simp⟩

/-- The value of a word in the coefficients and the variables of `s` depends only on the values
of the variables of `s`. -/
theorem eval_eq_eval_of_mem_varSubgroup (hw : w ∈ varSubgroup G s) (ι : G →* H) {v v' : X → H}
    (h : Set.EqOn v v' s) : eval ι v w = eval ι v' w := by
  obtain ⟨u, rfl⟩ := hw
  have hv : v ∘ ((↑) : s → X) = v' ∘ (↑) := funext fun x => h x.property
  rw [eval_map, eval_map, hv]

/-- A variable lies in `G[s]` exactly when it belongs to `s`. -/
@[simp]
theorem inr_of_mem_varSubgroup_iff {x : X} : inr (of x) ∈ varSubgroup G s ↔ x ∈ s := by
  classical
  refine ⟨fun h => by_contra fun hx => ?_, inr_of_mem_varSubgroup⟩
  have := eval_eq_eval_of_mem_varSubgroup h (1 : G →* FreeGroup X)
    (v := of) (v' := fun y => if y ∈ s then of y else 1) fun y hy => by simp [hy]
  simp [hx] at this

/-- Substituting words in the coefficients and the variables of `t` for the variables of a word
in the coefficients and the variables of `s` gives a word in the coefficients and the variables
of `t`. -/
theorem eval_mem_varSubgroup {Y : Type*} {t : Set Y} (hw : w ∈ varSubgroup G s)
    {v : X → GX G Y} (hv : ∀ x ∈ s, v x ∈ varSubgroup G t) : eval inl v w ∈ varSubgroup G t := by
  obtain ⟨u, rfl⟩ := hw
  rw [eval_map]
  refine (range_eq (eval (inl.comp (MonoidHom.id G)) (v ∘ (↑)))).le.trans
    (sup_le ?_ ?_) ⟨u, rfl⟩
  · rintro _ ⟨g, rfl⟩
    simp
  · rw [eval_comp_inr]
    exact FreeGroup.range_lift_le (Set.range_subset_iff.2 fun x => hv x x.property)

variable (G) in
/-- Enlarging the set of variables enlarges the subgroup of words in them. -/
theorem varSubgroup_monotone : Monotone (varSubgroup G : Set X → Subgroup (GX G X)) := by
  intro s t hst
  simp only [varSubgroup_eq_closure]
  exact Subgroup.closure_mono (Set.union_subset_union_right _ (Set.image_mono hst))

/-- The words in the variables of `s` are words in the variables of `t` exactly when `s ⊆ t`. -/
@[simp]
theorem varSubgroup_le_varSubgroup_iff {t : Set X} :
    varSubgroup G s ≤ varSubgroup G t ↔ s ⊆ t :=
  ⟨fun h _ hx => inr_of_mem_varSubgroup_iff.1 (h (inr_of_mem_varSubgroup hx)),
    fun h => varSubgroup_monotone G h⟩

variable (G) in
/-- Distinct sets of variables give distinct subgroups of words. -/
theorem varSubgroup_injective : Function.Injective (varSubgroup G : Set X → Subgroup (GX G X)) :=
  fun _ _ h =>
    (varSubgroup_le_varSubgroup_iff.1 h.le).antisymm (varSubgroup_le_varSubgroup_iff.1 h.ge)

/-- Two sets of variables give the same subgroup of words exactly when they are equal. -/
@[simp]
theorem varSubgroup_inj {t : Set X} : varSubgroup G s = varSubgroup G t ↔ s = t :=
  (varSubgroup_injective G).eq_iff

/-- The words in no variables are the coefficients. -/
theorem varSubgroup_empty : varSubgroup G (∅ : Set X) = (inl : G →* GX G X).range := by
  rw [varSubgroup_eq_closure, Set.image_empty, Set.union_empty, ← MonoidHom.coe_range,
    Subgroup.closure_eq]

/-- The words in all the variables are all of `G[X]`. -/
@[simp]
theorem varSubgroup_univ : varSubgroup G (Set.univ : Set X) = ⊤ := by
  refine (Subgroup.eq_top_iff' _).2 fun w => ?_
  induction w using Monoid.Coprod.induction_on with
  | inl g => exact inl_mem_varSubgroup _ g
  | inr w =>
    induction w using FreeGroup.induction_on with
    | one => simp
    | of x => exact inr_of_mem_varSubgroup (Set.mem_univ x)
    | inv_of x _ => simp
    | mul x y hx hy => simpa using mul_mem hx hy
  | mul x y hx hy => exact mul_mem hx hy

/-- The words in the variables of `s` are all of `G[X]` exactly when `s` contains every
variable. -/
@[simp]
theorem varSubgroup_eq_top_iff : varSubgroup G s = ⊤ ↔ s = Set.univ := by
  rw [← varSubgroup_univ, varSubgroup_inj]

/-- A word of `G[X]` belongs to `GX.varSubgroup G s` if and only if every variable occurring in
it belongs to `s`. -/
theorem mem_varSubgroup_iff_occVars_subset :
    w ∈ varSubgroup G s ↔ (occVars w : Set X) ⊆ s := by
  refine ⟨fun hw x hx => ?_, fun hs => ?_⟩
  · rw [varSubgroup_eq_closure] at hw
    induction hw using Subgroup.closure_induction with
    | mem u hu => rcases hu with ⟨g, rfl⟩ | ⟨y, hy, rfl⟩ <;> simp_all
    | one => simp at hx
    | mul u v _ _ hu hv =>
      exact (occVars_mul_subset u v hx).elim (fun h => hu h) (fun h => hv h)
    | inv u _ hu => exact hu (by simpa using hx)
  · rw [← prod_reducedWord w]
    refine list_prod_mem <| List.forall_mem_map.2 fun a ha => ?_
    rcases a with g | ⟨x, b⟩
    · simp
    · have hx : x ∈ s := hs <| mem_occVars_iff.2 <| by
        rw [occurrences_eq_countVar_reducedWord]; exact fun h0 => countVar_eq_zero.1 h0 b ha
      cases b <;> simp [inr_of_mem_varSubgroup hx]

/-- The value of `w ∈ G[X]` at a point depends only on the coordinates of the variables that occur
in `w` (simultaneously across all occurring variables, without requiring `DecidableEq X`; for a
single avoided variable see `GX.eval_congr_of_mem_avoiding`). -/
theorem eval_congr (ι : G →* H) {w : GX G X} {v v' : X → H}
    (h : ∀ x, occurrences x w ≠ 0 → v x = v' x) : eval ι v w = eval ι v' w :=
  eval_eq_eval_of_mem_varSubgroup (mem_varSubgroup_iff_occVars_subset.2 (coe_occVars w).le) ι h

end GX

end TauCeti.GroupAlgGeom
