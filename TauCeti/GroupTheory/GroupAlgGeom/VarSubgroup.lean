module

public import TauCeti.GroupTheory.GroupAlgGeom.Basic

/-!
# Words of `G[X]` in a subset of the variables

For a set `s` of variables, the words of the free `G`-group `G[X]` that involve only the
coefficients and the variables of `s` form a subgroup, the image of `G[s] → G[X]`. It is generated
by the coefficients and the variables of `s`, and the value of such a word at a point depends only
on the coordinates of the point in `s`.

Constraints of this kind express the dependence of the witnesses of a positive sentence on the
universally quantified variables: in a formal solution of `∀ x₀ ∃ y₀ … ∀ x_{k-1} ∃ y_{k-1} (S = 1)`
the word substituted for `y i` lies in the subgroup of the variables `x₀, …, x_i`.

## Main definitions

* `TauCeti.GroupAlgGeom.GX.varSubgroup G s`: the subgroup of `G[X]` of words in the coefficients
  and the variables of a set `s ⊆ X`.

## Main results

* `TauCeti.GroupAlgGeom.GX.varSubgroup_eq_closure`: it is generated by the coefficients and the
  variables of `s`.
* `TauCeti.GroupAlgGeom.GX.eval_eq_eval_of_mem_varSubgroup`: the value of a word of
  `varSubgroup G s` depends only on the values of the variables of `s`.

## References

* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §4.4.
-/

public section

namespace TauCeti.GroupAlgGeom

open Monoid.Coprod FreeGroup

variable {G H X : Type*} [Group G] [Group H]

namespace GX

variable (G) in
/-- The subgroup `G[s]` of `G[X]` of the words in the coefficients and the variables of a set
`s ⊆ X`: the image of `G[s] → G[X]`. -/
def varSubgroup (s : Set X) : Subgroup (GX G X) :=
  (Monoid.Coprod.map (MonoidHom.id G) (FreeGroup.map ((↑) : s → X))).range

variable {s : Set X} {w : GX G X}

/-- A word lies in `G[s]` exactly when it is the image of a word of the free `G`-group on `s`. -/
theorem mem_varSubgroup_iff :
    w ∈ varSubgroup G s ↔
      ∃ u : GX G s, Monoid.Coprod.map (MonoidHom.id G) (FreeGroup.map (↑)) u = w :=
  Iff.rfl

/-- `G[s]` is generated by the coefficients and the variables of `s`. -/
theorem varSubgroup_eq_closure (s : Set X) :
    varSubgroup G s =
      Subgroup.closure (Set.range (inl : G → GX G X) ∪ (fun x => inr (of x)) '' s) := by
  rw [varSubgroup, range_eq, map_comp_inl, map_comp_inr]
  simp [MonoidHom.range_comp, FreeGroup.range_map, MonoidHom.map_closure, Set.image_image,
    Subgroup.closure_union, ← MonoidHom.coe_range]

/-- Coefficients lie in `G[s]`. -/
@[simp]
theorem inl_mem_varSubgroup (s : Set X) (g : G) : inl g ∈ varSubgroup G s :=
  ⟨inl g, by simp⟩

/-- The variables of `s` lie in `G[s]`. -/
theorem inr_of_mem_varSubgroup {x : X} (hx : x ∈ s) : inr (of x) ∈ varSubgroup G s :=
  ⟨inr (of ⟨x, hx⟩), by simp⟩

variable (G) in
/-- Enlarging the set of variables enlarges the subgroup of words in them. -/
theorem varSubgroup_mono : Monotone (varSubgroup G : Set X → Subgroup (GX G X)) := by
  intro s t hst
  simp only [varSubgroup_eq_closure]
  exact Subgroup.closure_mono (Set.union_subset_union_right _ (Set.image_mono hst))

/-- The words in all the variables are all of `G[X]`. -/
@[simp]
theorem varSubgroup_univ : varSubgroup G (Set.univ : Set X) = ⊤ := by
  refine (Subgroup.eq_top_iff' _).2 fun w => ?_
  induction w using Monoid.Coprod.induction_on with
  | inl g => exact inl_mem_varSubgroup _ g
  | inr w =>
    induction w using FreeGroup.induction_on with
    | one => simp
    | of x => exact inr_of_mem_varSubgroup (Set.mem_univ x)
    | inv_of x hx => simpa using inv_mem hx
    | mul x y hx hy => simpa using mul_mem hx hy
  | mul x y hx hy => exact mul_mem hx hy

/-- The value of a word in the coefficients and the variables of `s` depends only on the values
of the variables of `s`. -/
theorem eval_eq_eval_of_mem_varSubgroup (hw : w ∈ varSubgroup G s) (ι : G →* H) {v v' : X → H}
    (h : Set.EqOn v v' s) : eval ι v w = eval ι v' w := by
  obtain ⟨u, rfl⟩ := hw
  have hv : v ∘ ((↑) : s → X) = v' ∘ (↑) := funext fun x => h x.2
  rw [eval_map, eval_map, hv]

end GX

end TauCeti.GroupAlgGeom
