/-!
# `G`-groups and the free `G`-group `G[X]`

Algebraic geometry over a group `G` studies equations with coefficients in `G`. An equation in the
variables `X` is an element of the free product `G[X] = G ∗ F(X)` of `G` with the free group on
`X`, and a solution in a group `H` receiving the coefficients through `ι : G →* H` is a point
`v : X → H` at which the evaluation `G[X] →* H` sends the equation to `1`.

A `G`-group is a group `H` with an injective homomorphism `G →* H`, and a `G`-homomorphism is a
homomorphism commuting with the coefficient maps. Quotients of `G[X]` (coordinate groups of
systems of equations) carry a coefficient map which need not be injective, so `G`-homomorphisms
and evaluation are set up here for arbitrary coefficient homomorphisms; the bundled `GGroup` adds
injectivity.

## Main definitions

* `TauCeti.GroupAlgGeom.GGroup`: a group with an embedding of `G`.
* `TauCeti.GroupAlgGeom.GHom ιH ιK`: homomorphisms `H →* K` with `φ ∘ ιH = ιK`.
* `TauCeti.GroupAlgGeom.GX G X`: the free `G`-group `G[X] = Monoid.Coprod G (FreeGroup X)`.
* `TauCeti.GroupAlgGeom.eval ι v`: evaluation `G[X] →* H` at a point `v : X → H`.
* `TauCeti.GroupAlgGeom.wordMap ι w`: the map on tuples defined by substituting words `w`.
* `TauCeti.GroupAlgGeom.homEquiv ι`: `G[X]` is free on `X` among groups under `G`:
  `G`-homomorphisms `G[X] → H` correspond to points `X → H`.
* `TauCeti.GroupAlgGeom.sumExtend Y σ`: the extension of a `G`-homomorphism
  `σ : G[X'] → G[X]` to `G[X' ⊔ Y] → G[X ⊔ Y]` by the identity on further variables `Y`.

## Main results

* `TauCeti.GroupAlgGeom.range_eval`, `TauCeti.GroupAlgGeom.eval_surjective_iff`: the range of an
  evaluation is generated by the image of the coefficients and the values of the variables.
* `MonoidHom.comp_eval`, `TauCeti.GroupAlgGeom.map_eval`: homomorphisms and `G`-homomorphisms
  commute with evaluation.
* `TauCeti.GroupAlgGeom.eval_comp_eval`, `TauCeti.GroupAlgGeom.evalGHom_comp_evalGHom`,
  `TauCeti.GroupAlgGeom.eval_sumElim_wordMap`: evaluating after word substitution is evaluation at
  the substituted tuple.
* `TauCeti.GroupAlgGeom.wordMap_wordMap`: composition of word maps is word substitution.
* `TauCeti.GroupAlgGeom.wordMap_inr_of`, `TauCeti.GroupAlgGeom.wordMap_sumElim`: the tuple of
  variables `f y` maps `v` to `v ∘ f`, and the word map of a tuple of words indexed by a sum is the
  pair of the word maps of its two parts.
* `TauCeti.GroupAlgGeom.sumExtend_surjective_iff`, `TauCeti.GroupAlgGeom.sumExtend_bijective_iff`,
  `TauCeti.GroupAlgGeom.eval_sumExtend`: the extension of `σ` is surjective, respectively a change
  of coordinates, exactly when `σ` is, and acts on points by the word map of `σ` on the
  coordinates in `X`, leaving those in `Y` unchanged.
* `TauCeti.GroupAlgGeom.GX.closure_image_inl_union_range_inr_of`: `G[X]` is generated by a
  generating set of `G` together with the variables.
* `TauCeti.GroupAlgGeom.GX.exists_finset_forall_mem_range_map_sumMap`,
  `TauCeti.GroupAlgGeom.GX.exists_finset_forall_mem_range_map_freeGroupMap`: finitely many words
  involve finitely many further variables and finitely many letters of a free coefficient group.
* `TauCeti.GroupAlgGeom.GX.exists_finset_forall_mem_range_map_sumMap_left`: finitely many words
  involve finitely many of the variables `X` of `G[X ⊔ Y]`.
* `TauCeti.GroupAlgGeom.GX.equivOfIsEmpty`, `TauCeti.GroupAlgGeom.GX.equivFreeGroup`: `G[∅] ≅ G`
  and, for trivial `G`, `G[X] ≅ F(X)`, under which evaluation is `FreeGroup.lift`.
* `TauCeti.GroupAlgGeom.GX.not_commute_inl_inr_of`: a nontrivial coefficient does not commute
  with a variable, so the inclusions of `G` and `F(X)` do not commute in `G[X]`.
* `TauCeti.GroupAlgGeom.GX.not_commute_inr_of_inr_of`: two distinct variables do not commute.
* `TauCeti.GroupAlgGeom.GX.map_map`: renamings of the variables compose.
* `TauCeti.GroupAlgGeom.GHom.mem_range_of_pow_mem_range`: if a group with unique roots admits a
  `G`-homomorphism back to `G`, the image of `G` in it is closed under roots.
* `TauCeti.GroupAlgGeom.mapsTo_wordMap_id`, `TauCeti.GroupAlgGeom.mapsTo_wordMap_comp`: the tuple
  of variables maps every set of points to itself, and word maps between sets of points compose
  by substitution of the defining words.

## References

* G. Baumslag, A. Myasnikov, V. Remeslennikov, *Algebraic geometry over groups I. Algebraic sets
  and ideal theory*, J. Algebra 219 (1999), §§1–2.
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §2.2.
-/

public section

namespace TauCeti.GroupAlgGeom

open Monoid.Coprod

universe u v

variable {G H K L : Type*} [Group G] [Group H] [Group K] [Group L]

/-! ### `G`-homomorphisms -/

/-- A `G`-homomorphism between groups receiving `G` through `ιH` and `ιK`: a homomorphism
`φ : H →* K` with `φ ∘ ιH = ιK`. -/
structure GHom (ιH : G →* H) (ιK : G →* K) extends H →* K where
  /-- A `G`-homomorphism fixes the coefficients. -/
  map_coeff' : ∀ g, toFun (ιH g) = ιK g

/-- Reinterpret a `G`-homomorphism as a monoid homomorphism. -/
add_decl_doc GHom.toMonoidHom

namespace GHom

variable {ιH : G →* H} {ιK : G →* K} {ιL : G →* L}

instance : FunLike (GHom ιH ιK) H K where
  coe φ := φ.toFun
  coe_injective φ ψ h := by
    obtain ⟨⟨⟨_, _⟩, _⟩, _⟩ := φ
    obtain ⟨⟨⟨_, _⟩, _⟩, _⟩ := ψ
    congr

instance : MonoidHomClass (GHom ιH ιK) H K where
  map_mul φ := φ.map_mul'
  map_one φ := φ.map_one'

@[simp]
theorem toMonoidHom_eq_coe (φ : GHom ιH ιK) : φ.toMonoidHom = (φ : H →* K) := rfl

@[simp]
theorem coe_mk (φ : H →* K) (h : ∀ g, φ.toFun (ιH g) = ιK g) : ⇑(⟨φ, h⟩ : GHom ιH ιK) = φ :=
  rfl

@[ext]
theorem ext {φ ψ : GHom ιH ιK} (h : ∀ x, φ x = ψ x) : φ = ψ :=
  DFunLike.ext _ _ h

theorem toMonoidHom_injective : Function.Injective ((↑) : GHom ιH ιK → H →* K) :=
  Function.Injective.of_comp (f := DFunLike.coe) DFunLike.coe_injective

@[simp]
theorem map_coeff (φ : GHom ιH ιK) (g : G) : φ (ιH g) = ιK g :=
  φ.map_coeff' g

@[simp]
theorem comp_coeff (φ : GHom ιH ιK) : (φ : H →* K).comp ιH = ιK :=
  MonoidHom.ext φ.map_coeff

variable (ιH) in
/-- The identity `G`-homomorphism. -/
protected def id : GHom ιH ιH where
  toMonoidHom := .id H
  map_coeff' _ := rfl

@[simp]
theorem coe_id : ⇑(GHom.id ιH) = id := (rfl)

/-- The composite of two `G`-homomorphisms. -/
def comp (ψ : GHom ιK ιL) (φ : GHom ιH ιK) : GHom ιH ιL where
  toMonoidHom := ψ.toMonoidHom.comp φ.toMonoidHom
  map_coeff' g := by simp

@[simp]
theorem coe_comp (ψ : GHom ιK ιL) (φ : GHom ιH ιK) : ⇑(ψ.comp φ) = ψ ∘ φ := (rfl)

@[simp]
theorem id_comp (φ : GHom ιH ιK) : (GHom.id ιK).comp φ = φ := (rfl)

@[simp]
theorem comp_id (φ : GHom ιH ιK) : φ.comp (GHom.id ιH) = φ := (rfl)

variable {M : Type*} [Group M] {ιM : G →* M} in
theorem comp_assoc (χ : GHom ιL ιM) (ψ : GHom ιK ιL) (φ : GHom ιH ιK) :
    (χ.comp ψ).comp φ = χ.comp (ψ.comp φ) := (rfl)

/-- The inverse of a bijective coefficient-preserving homomorphism preserves coefficients. -/
noncomputable def symmOfBijective (φ : GHom ιH ιK) (hφ : Function.Bijective φ) :
    GHom ιK ιH where
  toMonoidHom := (MulEquiv.ofBijective φ.toMonoidHom hφ).symm.toMonoidHom
  map_coeff' g := by
    apply hφ.1
    rw [φ.map_coeff g]
    exact MulEquiv.ofBijective_apply_symm_apply φ.toMonoidHom hφ

@[simp]
theorem apply_symmOfBijective_apply (φ : GHom ιH ιK) (hφ : Function.Bijective φ) (x : K) :
    φ (φ.symmOfBijective hφ x) = x := by
  exact MulEquiv.ofBijective_apply_symm_apply φ.toMonoidHom hφ

@[simp]
theorem symmOfBijective_apply_apply (φ : GHom ιH ιK) (hφ : Function.Bijective φ) (x : H) :
    φ.symmOfBijective hφ (φ x) = x := by
  exact (MulEquiv.ofBijective φ.toMonoidHom hφ).symm_apply_apply x

theorem symmOfBijective_injective (φ : GHom ιH ιK) (hφ : Function.Bijective φ) :
    Function.Injective (φ.symmOfBijective hφ) :=
  Function.LeftInverse.injective (g := φ) (φ.apply_symmOfBijective_apply hφ)

@[simp]
theorem comp_symmOfBijective (φ : GHom ιH ιK) (hφ : Function.Bijective φ) :
    φ.comp (φ.symmOfBijective hφ) = GHom.id ιK := by
  ext x
  exact φ.apply_symmOfBijective_apply hφ x

@[simp]
theorem symmOfBijective_comp (φ : GHom ιH ιK) (hφ : Function.Bijective φ) :
    (φ.symmOfBijective hφ).comp φ = GHom.id ιH := by
  ext x
  exact φ.symmOfBijective_apply_apply hφ x

/-- A group isomorphism commuting with the coefficient maps, as a `G`-homomorphism. -/
def ofMulEquiv (e : H ≃* K) (he : ∀ g, e (ιH g) = ιK g) : GHom ιH ιK where
  toMonoidHom := e.toMonoidHom
  map_coeff' := he

@[simp]
theorem coe_ofMulEquiv (e : H ≃* K) (he : ∀ g, e (ιH g) = ιK g) : ⇑(ofMulEquiv e he) = e := (rfl)

theorem ofMulEquiv_bijective (e : H ≃* K) (he : ∀ g, e (ιH g) = ιK g) :
    Function.Bijective (ofMulEquiv e he) := by
  simpa using e.bijective

@[simp]
theorem symmOfBijective_ofMulEquiv (e : H ≃* K) (he : ∀ g, e (ιH g) = ιK g)
    (h : Function.Bijective (ofMulEquiv e he)) :
    (ofMulEquiv e he).symmOfBijective h =
      ofMulEquiv e.symm fun g => e.symm_apply_eq.2 (he g).symm := by
  ext x
  apply h.1
  simp

section Retraction

variable [HasUniqueRoots H] {h : H} {n : ℕ}

/-- A coefficient-preserving homomorphism `φ : H → G` from a group with unique roots back to the
coefficients fixes the roots of coefficients: if `hⁿ` is a coefficient for some `n ≠ 0`, then
`ιH (φ h) = h`. -/
theorem coeff_apply_eq_self_of_pow_mem_range (φ : GHom ιH (.id G)) (hn : n ≠ 0)
    (hh : h ^ n ∈ ιH.range) : ιH (φ h) = h := by
  -- Both sides are `n`-th roots of `hⁿ`.
  obtain ⟨g, hg⟩ := hh
  refine pow_left_injective hn ?_
  simp only [← map_pow, ← hg, map_coeff, MonoidHom.id_apply]

/-- If a group `H` with unique roots admits a coefficient-preserving homomorphism back to the
coefficients, then the image of the coefficients contains every element of `H` having a nonzero
power in it. -/
theorem mem_range_of_pow_mem_range (φ : GHom ιH (.id G)) (hn : n ≠ 0) (hh : h ^ n ∈ ιH.range) :
    h ∈ ιH.range :=
  ⟨φ h, φ.coeff_apply_eq_self_of_pow_mem_range hn hh⟩

/-- A retract of a group with unique roots is closed under roots: if there is a retraction
`φ : H → F` onto the subgroup `F`, that is, a homomorphism fixing `F` pointwise, then every `h`
with `hⁿ ∈ F` for some `n ≠ 0` lies in `F`. -/
theorem mem_of_pow_mem {F : Subgroup H} (φ : GHom F.subtype (.id F)) (hn : n ≠ 0)
    (hh : h ^ n ∈ F) : h ∈ F := by
  simpa using φ.mem_range_of_pow_mem_range hn (by simpa using hh)

end Retraction

end GHom

/-! ### `G`-groups -/

/-- A `G`-group: a group together with an injective homomorphism from `G`, its coefficients.
Homomorphisms between `G`-groups `H` and `K` are `GHom H.coeff K.coeff`. -/
structure GGroup (G : Type u) [Group G] where
  /-- The underlying type. -/
  carrier : Type v
  [instGroup : Group carrier]
  /-- The coefficient embedding. -/
  coeff : G →* carrier
  coeff_injective : Function.Injective coeff

namespace GGroup

variable {G : Type u} [Group G]

instance : CoeSort (GGroup.{u, v} G) (Type v) := ⟨carrier⟩

attribute [instance] instGroup

/-- `G` is a `G`-group through the identity. -/
@[expose] def self (G : Type u) [Group G] : GGroup.{u, u} G :=
  ⟨G, .id G, Function.injective_id⟩

@[simp]
theorem coeff_self : (self G).coeff = .id G := rfl

end GGroup

/-! ### The free `G`-group `G[X]` and evaluation -/

variable (G) in
/-- The free `G`-group `G[X] = G ∗ F(X)` on a type of variables `X`; its coefficients are the left
inclusion `Monoid.Coprod.inl`, and the variable `x` is `inr (FreeGroup.of x)`. Its elements are
the equations over `G` in the variables `X`. -/
abbrev GX (X : Type*) : Type _ := Monoid.Coprod G (FreeGroup X)

variable {X : Type*}

variable (G X) in
/-- `G[X]` as a `G`-group. -/
@[expose] def GGroup.free : GGroup G := ⟨GX G X, inl, inl_injective⟩

@[simp]
theorem GGroup.coeff_free : (GGroup.free G X).coeff = inl := rfl

/-- `G[X]` is generated by a generating set of the coefficients together with the variables. -/
theorem GX.closure_image_inl_union_range_inr_of {T : Set G} (hT : Subgroup.closure T = ⊤) :
    Subgroup.closure (inl '' T ∪ Set.range fun x => (inr (FreeGroup.of x) : GX G X)) = ⊤ := by
  simp [Subgroup.closure_union, Set.range_comp', ← MonoidHom.map_closure, hT,
    ← MonoidHom.range_eq_map]

/-- Finitely many words in `G[X ⊕ Y]` involve only finitely many of the variables `Y`. -/
theorem GX.exists_finset_forall_mem_range_map_sumMap {Y : Type*} (s : Finset (GX G (X ⊕ Y))) :
    ∃ Z : Finset Y, ∀ w ∈ s,
      w ∈ (Monoid.Coprod.map (.id G) (FreeGroup.map (Sum.map id ((↑) : Z → Y)))).range := by
  classical
  -- the subgroups generated by the coefficients, the variables `X` and finitely many variables
  -- `Z ⊆ Y`; they form a directed family generating `G[X ⊔ Y]`
  let K (Z : Finset Y) : Subgroup (GX G (X ⊕ Y)) := Subgroup.closure (Set.range inl ∪
    (Set.range fun x => inr (FreeGroup.of (Sum.inl x))) ∪
      (fun y => inr (FreeGroup.of (Sum.inr y))) '' (Z : Set Y))
  have hK : Monotone K := fun _ _ h =>
    Subgroup.closure_mono (Set.union_subset_union_right _ (Set.image_mono (by exact_mod_cast h)))
  have htop : ⨆ Z, K Z = ⊤ := by
    rw [eq_top_iff, ← closure_image_inl_union_range_inr_of Subgroup.closure_univ,
      Subgroup.closure_le]
    rintro _ (⟨g, -, rfl⟩ | ⟨x | y, rfl⟩)
    · exact Subgroup.mem_iSup_of_mem ∅ (Subgroup.subset_closure (.inl (.inl ⟨g, rfl⟩)))
    · exact Subgroup.mem_iSup_of_mem ∅ (Subgroup.subset_closure (.inl (.inr ⟨x, rfl⟩)))
    · exact Subgroup.mem_iSup_of_mem {y} (Subgroup.subset_closure (.inr ⟨y, by simp, rfl⟩))
  choose Z hZ using fun w => (Subgroup.mem_iSup_of_directed hK.directed_le).1
    (htop ▸ Subgroup.mem_top w)
  refine ⟨s.biUnion Z, fun w hw => ?_⟩
  refine (Subgroup.closure_le _).2 ?_ (hK (Finset.subset_biUnion_of_mem Z hw) (hZ w))
  rintro _ ((⟨g, rfl⟩ | ⟨x, rfl⟩) | ⟨y, hy, rfl⟩)
  exacts [⟨inl g, rfl⟩, ⟨inr (FreeGroup.of (Sum.inl x)), rfl⟩,
    ⟨inr (FreeGroup.of (Sum.inr ⟨y, hy⟩)), rfl⟩]

/-- Finitely many words over a free group `F(A)` involve only finitely many letters of `A`. -/
theorem GX.exists_finset_forall_mem_range_map_freeGroupMap {A : Type*}
    (s : Finset (GX (FreeGroup A) X)) :
    ∃ A₀ : Finset A, ∀ w ∈ s,
      w ∈ (Monoid.Coprod.map (FreeGroup.map ((↑) : A₀ → A)) (FreeGroup.map id)).range := by
  classical
  -- the subgroups generated by finitely many letters `A₀ ⊆ A` and the variables; they form a
  -- directed family generating `F(A)[X]`
  let K (A₀ : Finset A) : Subgroup (GX (FreeGroup A) X) := Subgroup.closure
    ((fun a => inl (FreeGroup.of a)) '' (A₀ : Set A) ∪ Set.range fun x => inr (FreeGroup.of x))
  have hK : Monotone K := fun _ _ h =>
    Subgroup.closure_mono (Set.union_subset_union_left _ (Set.image_mono (by exact_mod_cast h)))
  have htop : ⨆ A₀, K A₀ = ⊤ := by
    rw [eq_top_iff, ← closure_image_inl_union_range_inr_of (FreeGroup.closure_range_of A),
      Subgroup.closure_le]
    rintro _ (⟨_, ⟨a, rfl⟩, rfl⟩ | ⟨x, rfl⟩)
    · exact Subgroup.mem_iSup_of_mem {a} (Subgroup.subset_closure (.inl ⟨a, by simp, rfl⟩))
    · exact Subgroup.mem_iSup_of_mem ∅ (Subgroup.subset_closure (.inr ⟨x, rfl⟩))
  choose A₀ hA₀ using fun w => (Subgroup.mem_iSup_of_directed hK.directed_le).1
    (htop ▸ Subgroup.mem_top w)
  refine ⟨s.biUnion A₀, fun w hw => ?_⟩
  refine (Subgroup.closure_le _).2 ?_ (hK (Finset.subset_biUnion_of_mem A₀ hw) (hA₀ w))
  rintro _ (⟨a, ha, rfl⟩ | ⟨x, rfl⟩)
  exacts [⟨inl (FreeGroup.of ⟨a, ha⟩), rfl⟩, ⟨inr (FreeGroup.of x), rfl⟩]

/-- Finitely many words in `G[X ⊕ Y]` involve only finitely many of the variables `X`. -/
theorem GX.exists_finset_forall_mem_range_map_sumMap_left {Y : Type*}
    (s : Finset (GX G (X ⊕ Y))) : ∃ X₀ : Finset X, ∀ w ∈ s,
      w ∈ (Monoid.Coprod.map (.id G) (FreeGroup.map (Sum.map ((↑) : X₀ → X) id))).range := by
  classical
  -- the subgroups generated by the coefficients, the variables `Y` and finitely many variables
  -- `X₀ ⊆ X`; they form a directed family generating `G[X ⊔ Y]`
  let K (X₀ : Finset X) : Subgroup (GX G (X ⊕ Y)) := Subgroup.closure (Set.range inl ∪
    (Set.range fun y => inr (FreeGroup.of (Sum.inr y))) ∪
      (fun x => inr (FreeGroup.of (Sum.inl x))) '' (X₀ : Set X))
  have hK : Monotone K := fun _ _ h =>
    Subgroup.closure_mono (Set.union_subset_union_right _ (Set.image_mono (by exact_mod_cast h)))
  have htop : ⨆ X₀, K X₀ = ⊤ := by
    rw [eq_top_iff, ← closure_image_inl_union_range_inr_of Subgroup.closure_univ,
      Subgroup.closure_le]
    rintro _ (⟨g, -, rfl⟩ | ⟨x | y, rfl⟩)
    · exact Subgroup.mem_iSup_of_mem ∅ (Subgroup.subset_closure (.inl (.inl ⟨g, rfl⟩)))
    · exact Subgroup.mem_iSup_of_mem {x} (Subgroup.subset_closure (.inr ⟨x, by simp, rfl⟩))
    · exact Subgroup.mem_iSup_of_mem ∅ (Subgroup.subset_closure (.inl (.inr ⟨y, rfl⟩)))
  choose X₀ hX₀ using fun w => (Subgroup.mem_iSup_of_directed hK.directed_le).1
    (htop ▸ Subgroup.mem_top w)
  refine ⟨s.biUnion X₀, fun w hw => (Subgroup.closure_le _).2 ?_
    (hK (Finset.subset_biUnion_of_mem X₀ hw) (hX₀ w))⟩
  rintro _ ((⟨g, rfl⟩ | ⟨y, rfl⟩) | ⟨x, hx, rfl⟩)
  exacts [⟨inl g, rfl⟩, ⟨inr (FreeGroup.of (Sum.inr y)), rfl⟩,
    ⟨inr (FreeGroup.of (Sum.inl ⟨x, hx⟩)), rfl⟩]

/-- Evaluation `w ↦ w(v)` of `G[X]` at a point `v : X → H`, for a group `H` receiving the
coefficients through `ι`: coefficients go to their images under `ι` and the variable `x` goes
to `v x`. -/
def eval (ι : G →* H) (v : X → H) : GX G X →* H :=
  lift ι (FreeGroup.lift v)

variable (ι : G →* H) (v : X → H)

@[simp]
theorem eval_inl (g : G) : eval ι v (inl g) = ι g :=
  lift_apply_inl _ _ g

@[simp]
theorem eval_inr (w : FreeGroup X) : eval ι v (inr w) = FreeGroup.lift v w :=
  lift_apply_inr _ _ w

theorem eval_inr_of (x : X) : eval ι v (inr (FreeGroup.of x)) = v x := by
  simp

@[simp]
theorem eval_comp_inl : (eval ι v).comp inl = ι :=
  MonoidHom.ext (eval_inl ι v)

@[simp]
theorem eval_comp_inr : (eval ι v).comp inr = FreeGroup.lift v :=
  MonoidHom.ext (eval_inr ι v)

/-- Evaluating at the generic point, the tuple of variables of `G[X]`, is the identity. -/
@[simp]
theorem eval_inl_inr_of : eval (inl : G →* GX G X) (fun x => inr (FreeGroup.of x)) = .id _ :=
  hom_ext (by simp) (FreeGroup.ext_hom _ _ fun _ => by simp)

/-- A homomorphism out of `G[X]` is determined by its restriction to the coefficients and its
values on the variables: it is evaluation at those values. -/
theorem eq_eval (f : GX G X →* H) : f = eval (f.comp inl) (fun x => f (inr (FreeGroup.of x))) :=
  hom_ext (by simp) (FreeGroup.ext_hom _ _ fun _ => by simp)

/-- The range of an evaluation is generated by the image of the coefficients and the values of
the variables. -/
theorem range_eval :
    (eval ι v).range = Subgroup.closure (Set.range ι ∪ Set.range v) := by
  rw [range_eq, eval_comp_inl, eval_comp_inr, FreeGroup.range_lift_eq_closure,
    Subgroup.closure_union, ← MonoidHom.coe_range, Subgroup.closure_eq]

/-- An evaluation is surjective exactly when the image of the coefficients and the values of the
variables generate the target. -/
theorem eval_surjective_iff :
    Function.Surjective (eval ι v) ↔ Subgroup.closure (Set.range ι ∪ Set.range v) = ⊤ := by
  rw [← MonoidHom.range_eq_top, range_eval]

/-- Evaluation as a `G`-homomorphism from the free `G`-group `G[X]`. -/
def evalGHom : GHom (inl : G →* GX G X) ι where
  toMonoidHom := eval ι v
  map_coeff' := eval_inl ι v

@[simp]
theorem coe_evalGHom : ⇑(evalGHom ι v) = eval ι v := (rfl)

/-- `G[X]` is the free `G`-group on `X`: `G`-homomorphisms `G[X] → H` correspond to points
`X → H`, by restriction to the variables and by evaluation. -/
def homEquiv : GHom (inl : G →* GX G X) ι ≃ (X → H) where
  toFun φ x := φ (inr (FreeGroup.of x))
  invFun v := evalGHom ι v
  left_inv φ := by
    refine GHom.ext fun w => ?_
    simpa using (DFunLike.congr_fun (eq_eval (φ : GX G X →* H)) w).symm
  right_inv v := funext fun x => eval_inr_of ι v x

@[simp]
theorem homEquiv_apply (φ : GHom (inl : G →* GX G X) ι) (x : X) :
    homEquiv ι φ x = φ (inr (FreeGroup.of x)) := (rfl)

@[simp]
theorem homEquiv_symm_apply : (homEquiv ι).symm v = evalGHom ι v := (rfl)

/-- A `G`-homomorphism out of `G[X]` is determined by its values on the variables. -/
@[ext]
theorem GX.gHom_ext {φ ψ : GHom (inl : G →* GX G X) ι}
    (h : ∀ x, φ (inr (FreeGroup.of x)) = ψ (inr (FreeGroup.of x))) : φ = ψ :=
  (homEquiv ι).injective (funext h)

/-- Two homomorphisms out of `G[X]` agreeing on the coefficients and on the variables are
equal. -/
theorem GX.ext_hom {M F : Type*} [Monoid M] [FunLike F (GX G X) M]
    [MonoidHomClass F (GX G X) M] {φ ψ : F} (hinl : ∀ g, φ (inl g) = ψ (inl g))
    (hinr : ∀ x, φ (inr (FreeGroup.of x)) = ψ (inr (FreeGroup.of x))) : φ = ψ :=
  DFunLike.ext _ _ <| DFunLike.congr_fun (f := (φ : GX G X →* M)) (g := ψ) <|
    hom_ext (MonoidHom.ext hinl) (FreeGroup.ext_hom _ _ hinr)

/-- Evaluation at the tuple of variables of `G[X]` is the identity `G`-homomorphism. -/
@[simp]
theorem evalGHom_inl_inr_of :
    evalGHom (inl : G →* GX G X) (fun x => inr (FreeGroup.of x)) =
      GHom.id (inl : G →* GX G X) :=
  GX.gHom_ext _ fun x => by simp

variable {ι v}

/-- A homomorphism out of `G[X]` that restricts to `ι` on the coefficients is evaluation at its
values on the variables. -/
theorem eval_eq_of_comp_inl {f : GX G X →* H} (hf : f.comp inl = ι) :
    eval ι (fun x => f (inr (FreeGroup.of x))) = f :=
  hf ▸ (eq_eval f).symm

/-- If no coefficient survives, every word evaluates to `1` at the trivial tuple. -/
@[simp]
theorem eval_one_one : eval (1 : G →* H) (1 : X → H) = 1 :=
  eval_eq_of_comp_inl (f := 1) rfl

/-- In a commutative group a word is a constant times a homomorphism of the tuple of values, so
evaluation is compatible with the operation `(u, v, w) ↦ u * v⁻¹ * w` on tuples. -/
theorem eval_mul_inv_mul {A : Type*} [CommGroup A] (ι : G →* A) (u v w : X → A) (s : GX G X) :
    eval ι (u * v⁻¹ * w) s = eval ι u s * (eval ι v s)⁻¹ * eval ι w s := by
  have h : eval ι (u * v⁻¹ * w) = eval ι u * (eval ι v)⁻¹ * eval ι w :=
    hom_ext (MonoidHom.ext fun g => by simp) (FreeGroup.ext_hom _ _ fun x => by simp)
  simp [h]

/-- In a commutative group, evaluating a word at `v` is evaluating it at `u` times evaluating it,
with all coefficients replaced by `1`, at `v / u`. -/
theorem eval_eq_eval_mul_eval_one_div {A : Type*} [CommGroup A] (ι : G →* A) (u v : X → A)
    (s : GX G X) : eval ι v s = eval ι u s * eval 1 (v / u) s :=
  DFunLike.congr_fun (hom_ext (MonoidHom.ext fun g => by simp)
    (FreeGroup.ext_hom _ _ fun x => by simp) : eval ι v = eval ι u * eval 1 (v / u)) s

/-- Homomorphisms commute with evaluation: `f ∘ eval ι v = eval (f ∘ ι) (f ∘ v)`. -/
theorem _root_.MonoidHom.comp_eval (f : H →* K) {ι : G →* H} {v : X → H} :
    f.comp (eval ι v) = eval (f.comp ι) (f ∘ v) :=
  hom_ext (by simp [MonoidHom.comp_assoc]) (FreeGroup.ext_hom _ _ fun _ => by simp)

/-- Homomorphisms commute with evaluation: `f (w(v)) = w(f ∘ v)`, the coefficients being moved
along `f`. -/
theorem hom_eval {F : Type*} [FunLike F H K] [MonoidHomClass F H K] (f : F) (w : GX G X) :
    f (eval ι v w) = eval ((f : H →* K).comp ι) (f ∘ v) w :=
  DFunLike.congr_fun (f : H →* K).comp_eval w

/-- `G`-homomorphisms commute with evaluation, as homomorphisms out of `G[X]`. -/
theorem comp_eval {ιK : G →* K} (φ : GHom ι ιK) :
    (φ : H →* K).comp (eval ι v) = eval ιK (φ ∘ v) := by
  rw [MonoidHom.comp_eval, φ.comp_coeff, MonoidHom.coe_ofClass]

/-- The word map determined by a tuple of words. -/
def wordMap {Y : Type*} (ι : G →* H) (w : Y → GX G X) (v : X → H) : Y → H :=
  fun y => eval ι v (w y)

/-- Evaluating the word map at a coordinate evaluates its defining word. -/
@[simp]
theorem wordMap_apply {Y : Type*} (w : Y → GX G X) (v : X → H) (y : Y) :
    wordMap ι w v y = eval ι v (w y) := by
  simp [wordMap]

/-- Substituting words for variables and then evaluating agrees with evaluation of the
substituted tuple. -/
theorem eval_comp_eval {Y : Type*} (w : Y → GX G X) (v : X → H) :
    (eval ι v).comp (eval (inl : G →* GX G X) w) =
      eval ι (wordMap ι w v) := by
  rw [MonoidHom.comp_eval, eval_comp_inl]
  rfl

/-- Substituting words for variables and then evaluating at `v` is, as a `G`-homomorphism,
evaluation at the values of the words at `v`. -/
@[simp]
theorem evalGHom_comp_evalGHom {Y : Type*} (w : Y → GX G X) (v : X → H) :
    (evalGHom ι v).comp (evalGHom inl w) = evalGHom ι fun y => eval ι v (w y) :=
  GX.gHom_ext _ fun y => by simp

/-- Composition of word maps is substitution of the defining words. -/
theorem wordMap_wordMap {Y Z : Type*} (w : Y → GX G X) (u : Z → GX G Y) (v : X → H) :
    wordMap ι u (wordMap ι w v) =
      wordMap ι (fun z => eval (inl : G →* GX G X) w (u z)) v := by
  funext z
  exact (DFunLike.congr_fun (eval_comp_eval w v) (u z)).symm

/-- The tuple of variables `f y` maps a tuple `v` to `v ∘ f`. -/
-- Low priority, so that `wordMap_id` rewrites the tuple of all variables to `v` itself rather
-- than to `v ∘ fun x => x`.
@[simp low]
theorem wordMap_inr_of {Y : Type*} (f : Y → X) (v : X → H) :
    wordMap ι (fun y => inr (FreeGroup.of (f y))) v = v ∘ f := by
  funext y
  simp

/-- The identity word homomorphism leaves tuples unchanged. -/
@[simp] theorem wordMap_id (v : X → H) :
    wordMap ι (fun x => inr (FreeGroup.of x)) v = v :=
  wordMap_inr_of id v

/-- The word map of a tuple of words indexed by `Y ⊕ Z` is the pair of the word maps of its two
parts. -/
@[simp]
theorem wordMap_sumElim {Y Z : Type*} (w : Y → GX G X) (w' : Z → GX G X) (v : X → H) :
    wordMap ι (Sum.elim w w') v = Sum.elim (wordMap ι w v) (wordMap ι w' v) :=
  Sum.comp_elim (eval ι v) w w'

/-- Evaluating a word `u(X, Y)` at the point `v` extended to `Y` by the values `w(v)` of words
`w : Y → G[X]` is evaluating at `v` the word `u(X, w(X))` obtained by substituting `w` for `Y`. -/
theorem eval_sumElim_wordMap {Y : Type*} (w : Y → GX G X) (v : X → H) (u : GX G (X ⊕ Y)) :
    eval ι (Sum.elim v (wordMap ι w v)) u =
      eval ι v (eval (inl : G →* GX G X) (Sum.elim (fun x => inr (FreeGroup.of x)) w) u) := by
  rw [← MonoidHom.comp_apply, eval_comp_eval, wordMap_sumElim, wordMap_id]

/-- Evaluation after a word map is composition with the word homomorphism. -/
theorem eval_wordMap (σ : GHom (inl : G →* GX G Y) (inl : G →* GX G X)) (v : X → H) :
    eval ι (wordMap ι (fun y => σ (inr (FreeGroup.of y))) v) =
      (eval ι v).comp σ.toMonoidHom := by
  rw [← eval_comp_eval]
  congr 1
  exact eval_eq_of_comp_inl σ.comp_coeff

variable (ι) in
/-- The tuple of variables maps every set of points to itself. -/
theorem mapsTo_wordMap_id (s : Set (X → H)) :
    Set.MapsTo (wordMap ι fun x => inr (FreeGroup.of x)) s s :=
  fun v hv => by rwa [wordMap_id]

/-- Substituting one tuple of words into another composes the corresponding word maps between
sets of points. -/
theorem mapsTo_wordMap_comp {Y Z : Type*} {s : Set (X → H)} {t : Set (Y → H)}
    {r : Set (Z → H)} {w : Y → GX G X} {u : Z → GX G Y} (hu : Set.MapsTo (wordMap ι u) t r)
    (hw : Set.MapsTo (wordMap ι w) s t) :
    Set.MapsTo (wordMap ι fun z => eval (inl : G →* GX G X) w (u z)) s r := by
  intro v hv
  rw [← wordMap_wordMap]
  exact hu (hw hv)

/-- Changing one of the words of a tuple changes the corresponding coordinate of its word
map. -/
theorem wordMap_update {Y : Type*} [DecidableEq Y] (w : Y → GX G X) (y : Y) (c : GX G X)
    (v : X → H) :
    wordMap ι (Function.update w y c) v = Function.update (wordMap ι w v) y (eval ι v c) :=
  Function.comp_update (eval ι v) w y c

/-- Word maps compose in the opposite order to word homomorphisms. -/
theorem wordMap_comp (σ : GHom (inl : G →* GX G Z) (inl : G →* GX G Y))
    (τ : GHom (inl : G →* GX G Y) (inl : G →* GX G X)) (v : X → H) :
    wordMap ι (fun z => (τ.comp σ) (inr (FreeGroup.of z))) v =
      wordMap ι (fun y => σ (inr (FreeGroup.of y)))
        (wordMap ι (fun x => τ (inr (FreeGroup.of x))) v) := by
  rw [wordMap_wordMap]
  congr 1
  funext z
  simp only [GHom.coe_comp, Function.comp_apply]
  exact (DFunLike.congr_fun (eval_eq_of_comp_inl τ.comp_coeff)
    (σ (inr (FreeGroup.of z)))).symm

/-- `G`-homomorphisms commute with evaluation: `φ (w(v)) = w(φ ∘ v)`. -/
@[simp]
theorem map_eval {ιK : G →* K} (φ : GHom ι ιK) (w : GX G X) :
    φ (eval ι v w) = eval ιK (φ ∘ v) w :=
  DFunLike.congr_fun (comp_eval φ) w

/-- Changing the coefficients along `f : K →* G` and renaming the variables along `e : Y → X`
before evaluating at `v` is evaluation at `v ∘ e` with coefficients `ι ∘ f`. -/
theorem eval_comp_map {Y : Type*} (f : K →* G) (e : Y → X) :
    (eval ι v).comp (Monoid.Coprod.map f (FreeGroup.map e)) = eval (ι.comp f) (v ∘ e) :=
  hom_ext (MonoidHom.ext fun _ => by simp) (FreeGroup.ext_hom _ _ fun _ => by simp)

@[simp]
theorem eval_map {Y : Type*} (f : K →* G) (e : Y → X) (w : GX K Y) :
    eval ι v (Monoid.Coprod.map f (FreeGroup.map e) w) = eval (ι.comp f) (v ∘ e) w :=
  DFunLike.congr_fun (eval_comp_map f e) w

/-- Renaming the variables along `e` and then along `e'` is renaming them along `e' ∘ e`, with the
composite change of coefficients. -/
theorem GX.map_map {Y Z : Type*} (f : K →* G) (f' : G →* L) (e : Y → X) (e' : X → Z)
    (w : GX K Y) :
    Monoid.Coprod.map f' (FreeGroup.map e') (Monoid.Coprod.map f (FreeGroup.map e) w) =
      Monoid.Coprod.map (f'.comp f) (FreeGroup.map (e' ∘ e)) w := by
  rw [Monoid.Coprod.map_map]
  congr 2
  exact FreeGroup.ext_hom _ _ fun _ => rfl

/-! ### Extending a word homomorphism by further variables -/

section SumExtend

variable {X' Y : Type*}

variable (Y) in
/-- The extension of a `G`-homomorphism `σ : G[X'] → G[X]` to a `G`-homomorphism
`G[X' ⊔ Y] → G[X ⊔ Y]` that is the identity on the further variables `Y`. -/
def sumExtend (σ : GHom (inl : G →* GX G X') (inl : G →* GX G X)) :
    GHom (inl : G →* GX G (X' ⊕ Y)) (inl : G →* GX G (X ⊕ Y)) :=
  evalGHom inl (Sum.elim
    (fun x' => Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl) (σ (inr (FreeGroup.of x'))))
    fun y => inr (FreeGroup.of (Sum.inr y)))

variable (σ : GHom (inl : G →* GX G X') (inl : G →* GX G X))

/-- The extension of `σ` sends a variable `x'` to `σ x'`, read in `G[X ⊔ Y]`. -/
@[simp]
theorem sumExtend_inr_of_inl (x' : X') : sumExtend Y σ (inr (FreeGroup.of (Sum.inl x'))) =
    Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl) (σ (inr (FreeGroup.of x'))) := by
  simp [sumExtend]

/-- The extension of `σ` fixes the further variables `Y`. -/
@[simp]
theorem sumExtend_inr_of_inr (y : Y) : sumExtend Y σ (inr (FreeGroup.of (Sum.inr y))) =
    inr (FreeGroup.of (Sum.inr y)) := by
  simp [sumExtend]

/-- The extension of `σ` restricts to `σ` on the words in the variables `X'`. -/
@[simp]
theorem sumExtend_map_inl (w : GX G X') :
    sumExtend Y σ (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl) w) =
      Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl) (σ w) := by
  have h : (sumExtend Y σ : GX G (X' ⊕ Y) →* GX G (X ⊕ Y)).comp
      (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl)) =
      (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl)).comp (σ : GX G X' →* GX G X) :=
    hom_ext (MonoidHom.ext fun g => by simp) (FreeGroup.ext_hom _ _ fun x' => by simp)
  exact DFunLike.congr_fun h w

/-- The extension of `σ` fixes the words in the further variables `Y`. -/
@[simp]
theorem sumExtend_map_inr (w : GX G Y) :
    sumExtend Y σ (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inr) w) =
      Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inr) w := by
  have h : (sumExtend Y σ : GX G (X' ⊕ Y) →* GX G (X ⊕ Y)).comp
      (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inr)) =
      Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inr) :=
    hom_ext (MonoidHom.ext fun g => by simp) (FreeGroup.ext_hom _ _ fun y => by simp)
  exact DFunLike.congr_fun h w

/-- The extension of `σ` restricts to `σ` on the coefficient-free words in the variables `X'`. -/
@[simp]
theorem sumExtend_inr_map_inl (u : FreeGroup X') :
    sumExtend Y σ (inr (FreeGroup.map Sum.inl u)) =
      Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl) (σ (inr u)) := by
  simpa using sumExtend_map_inl (Y := Y) σ (inr u)

/-- The extension of `σ` fixes the coefficient-free words in the further variables `Y`. -/
@[simp]
theorem sumExtend_inr_map_inr (u : FreeGroup Y) :
    sumExtend Y σ (inr (FreeGroup.map Sum.inr u)) = inr (FreeGroup.map Sum.inr u) := by
  simpa using sumExtend_map_inr σ (inr u)

variable (Y X) in
/-- The extension of the identity is the identity. -/
@[simp]
theorem sumExtend_id : sumExtend Y (GHom.id (inl : G →* GX G X)) =
    GHom.id (inl : G →* GX G (X ⊕ Y)) :=
  GX.gHom_ext _ fun u => by cases u <;> simp

/-- The composite of the extensions of `σ` and of `τ` is the extension of `σ ∘ τ`. -/
@[simp]
theorem sumExtend_comp_sumExtend {X'' : Type*}
    (τ : GHom (inl : G →* GX G X'') (inl : G →* GX G X')) :
    (sumExtend Y σ).comp (sumExtend Y τ) = sumExtend Y (σ.comp τ) :=
  GX.gHom_ext _ fun u => by cases u <;> simp

/-- Applying the extensions of `τ` and of `σ` in turn is applying the extension of `σ ∘ τ`. -/
@[simp]
theorem sumExtend_apply_sumExtend {X'' : Type*}
    (τ : GHom (inl : G →* GX G X'') (inl : G →* GX G X')) (u : GX G (X'' ⊕ Y)) :
    sumExtend Y σ (sumExtend Y τ u) = sumExtend Y (σ.comp τ) u := by
  rw [← sumExtend_comp_sumExtend, GHom.coe_comp, Function.comp_apply]

/-- The extension of `σ` acts on points by the word map of `σ` on the coordinates in `X` and
leaves the coordinates in `Y` unchanged. -/
@[simp]
theorem wordMap_sumExtend (v : X → H) (w : Y → H) :
    wordMap ι (fun u => sumExtend Y σ (inr (FreeGroup.of u))) (Sum.elim v w) =
      Sum.elim (wordMap ι (fun x' => σ (inr (FreeGroup.of x'))) v) w := by
  funext u
  cases u <;> simp

/-- Evaluating the image of a word under the extension of `σ` at `(v, w)` is evaluating the word
at the transformed point. -/
@[simp]
theorem eval_sumExtend (v : X → H) (w : Y → H) (u : GX G (X' ⊕ Y)) :
    eval ι (Sum.elim v w) (sumExtend Y σ u) =
      eval ι (Sum.elim (wordMap ι (fun x' => σ (inr (FreeGroup.of x'))) v) w) u := by
  rw [← wordMap_sumExtend, eval_wordMap]
  simp

variable {σ}

/-- The extension of a surjective `G`-homomorphism by the identity on further variables is
surjective. -/
theorem sumExtend_surjective (hσ : Function.Surjective σ) :
    Function.Surjective (sumExtend Y σ) := by
  -- A section of `σ`, defined on the variables of the free `G`-group `G[X]`.
  let τ := evalGHom (inl : G →* GX G X') fun x => Function.surjInv hσ (inr (FreeGroup.of x))
  have hτ : σ.comp τ = GHom.id _ := GX.gHom_ext _ fun x => by
    simp [τ, Function.surjInv_eq hσ]
  exact fun u => ⟨sumExtend Y τ u, by simp [hτ]⟩

/-- The extension of a change of coordinates by the identity on further variables is a change of
coordinates. -/
theorem sumExtend_bijective (hσ : Function.Bijective σ) : Function.Bijective (sumExtend Y σ) :=
  ⟨Function.LeftInverse.injective (g := sumExtend Y (σ.symmOfBijective hσ)) fun u => by simp,
    sumExtend_surjective hσ.2⟩

/-- The extension of `σ` by the identity on further variables is surjective exactly when `σ` is. -/
@[simp]
theorem sumExtend_surjective_iff :
    Function.Surjective (sumExtend Y σ) ↔ Function.Surjective σ := by
  refine ⟨fun h v => ?_, sumExtend_surjective⟩
  -- Deleting the variables `Y` retracts `G[X ⊔ Y]` onto `G[X]` and intertwines the extension of
  -- `σ` with `σ`.
  have hρ (u : GX G (X' ⊕ Y)) :
      eval inl (Sum.elim (fun x => inr (FreeGroup.of x)) 1) (sumExtend Y σ u) =
        σ (eval inl (Sum.elim (fun x' => inr (FreeGroup.of x')) 1) u) := by
    rw [eval_sumExtend, map_eval]
    exact congrArg (eval (inl : G →* GX G X) · u) (funext fun z => by cases z <;> simp)
  obtain ⟨u, hu⟩ := h (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl) v)
  exact ⟨_, by rw [← hρ, hu]; simp⟩

/-- The extension of `σ` by the identity on further variables is a change of coordinates exactly
when `σ` is. -/
@[simp]
theorem sumExtend_bijective_iff : Function.Bijective (sumExtend Y σ) ↔ Function.Bijective σ := by
  refine ⟨fun h => ⟨fun a b hab => ?_, sumExtend_surjective_iff.1 h.2⟩, sumExtend_bijective⟩
  simpa using congrArg (eval inl (Sum.elim (fun x' => inr (FreeGroup.of x')) 1)) <|
    h.1 (a₁ := Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl) a)
      (a₂ := Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inl) b) (by simp [hab])

/-- The inverse of the extension of a change of coordinates is the extension of its inverse. -/
@[simp]
theorem symmOfBijective_sumExtend (h : Function.Bijective (sumExtend Y σ)) :
    (sumExtend Y σ).symmOfBijective h =
      sumExtend Y (σ.symmOfBijective (sumExtend_bijective_iff.1 h)) :=
  GHom.ext fun u => h.1 (by simp)

end SumExtend

/-! ### Degenerate cases and noncommutativity of `G[X]` -/

namespace GX

/-- With no variables, `G[X]` is `G`. -/
def equivOfIsEmpty [IsEmpty X] : GX G X ≃* G :=
  (MulEquiv.coprodCongr (.refl G) (MulEquiv.ofUnique (N := PUnit.{1}))).trans
    (MulEquiv.coprodPUnit G)

@[simp]
theorem equivOfIsEmpty_apply [IsEmpty X] (w : GX G X) : equivOfIsEmpty w = fst w := by
  induction w using induction_on with
  | inl g => simp [equivOfIsEmpty]
  | inr w => simp [Subsingleton.elim w 1]
  | mul x y hx hy => simp [hx, hy]

@[simp]
theorem equivOfIsEmpty_symm_apply [IsEmpty X] (g : G) :
    (equivOfIsEmpty (X := X)).symm g = inl g := by
  simp [MulEquiv.symm_apply_eq]

variable (G X) in
/-- Over trivial coefficients, `G[X]` is the free group `F(X)`. -/
def equivFreeGroup [Subsingleton G] : GX G X ≃* FreeGroup X :=
  letI := uniqueOfSubsingleton (1 : G)
  (MulEquiv.coprodCongr (MulEquiv.ofUnique (N := PUnit.{1})) (.refl _)).trans
    (MulEquiv.punitCoprod (FreeGroup X))

@[simp]
theorem equivFreeGroup_apply [Subsingleton G] (w : GX G X) : equivFreeGroup G X w = snd w := by
  induction w using induction_on with
  | inl g => simp [Subsingleton.elim g 1]
  | inr w => simp [equivFreeGroup]
  | mul x y hx hy => simp [hx, hy]

@[simp]
theorem equivFreeGroup_symm_apply [Subsingleton G] (w : FreeGroup X) :
    (equivFreeGroup G X).symm w = inr w := by
  simp [MulEquiv.symm_apply_eq]

/-- Over trivial coefficients, evaluation is `FreeGroup.lift` through `G[X] ≅ F(X)`. -/
theorem eval_eq_lift_equivFreeGroup [Subsingleton G] (ι : G →* H) (v : X → H) (w : GX G X) :
    eval ι v w = FreeGroup.lift v (equivFreeGroup G X w) := by
  have : eval ι v = (FreeGroup.lift v).comp (equivFreeGroup G X).toMonoidHom :=
    hom_ext (MonoidHom.ext fun g => by simp [Subsingleton.elim g 1])
      (FreeGroup.ext_hom _ _ fun _ => by simp)
  exact DFunLike.congr_fun this w

/-- A nontrivial coefficient does not commute with a variable in `G[X]`; in particular the
inclusions of `G` and `F(X)` do not commute, unlike in the direct product `G × F(X)`. -/
theorem not_commute_inl_inr_of {a : G} (ha : a ≠ 1) (x : X) :
    ¬Commute (inl a : GX G X) (inr (FreeGroup.of x)) := by
  classical
  intro h
  -- Separate the two in the permutations of `Option G`: `G` acts by left multiplication on `G`,
  -- and the variable acts as the transposition of `none` and `some 1`.
  let f : GX G X →* Equiv.Perm (Option G) :=
    eval (MulAction.toPermHom G (Option G)) fun _ => Equiv.swap none (some 1)
  have := congrArg (fun σ : Equiv.Perm (Option G) => σ none) (congrArg f h.eq)
  exact ha (by simpa [f] using this)

/-- Two distinct variables do not commute in `G[X]`. -/
theorem not_commute_inr_of_inr_of {x y : X} (hxy : x ≠ y) :
    ¬Commute (inr (FreeGroup.of x) : GX G X) (inr (FreeGroup.of y)) := fun h =>
  hxy <| FreeGroup.eq_of_commute_of_of <| congrArg snd h.eq

end GX

/-! ### Examples -/

section Examples

open FreeGroup

/-- Over `G = F(a, b)` with one variable `x`, the commutator `x a x⁻¹ a⁻¹` vanishes at `x = a²`
but not at `x = b`. -/
theorem eval_commutator :
    let a : FreeGroup (Fin 2) := of 0
    let w : GX (FreeGroup (Fin 2)) Unit := inr (of ()) * inl a * (inr (of ()))⁻¹ * (inl a)⁻¹
    eval (.id _) (fun _ => a ^ 2) w = 1 ∧ eval (.id _) (fun _ => of 1) w ≠ 1 := by
  simp only [_root_.map_mul, _root_.map_inv, eval_inl, eval_inr, lift_apply_of, MonoidHom.id_apply]
  exact ⟨by group, by decide⟩

end Examples

