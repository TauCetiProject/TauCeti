/-!
# Radicals of products of two and three squares

Over a nonabelian fully residually free group, the equation `x² y² = 1` has radical
`ncl(x y)`. The equation `x² y² z² = 1` has radical generated by `x y z` and the pairwise
commutators. Thus their coordinate groups are respectively the free products of the
coefficient group with an infinite cyclic group and with a free abelian group of rank two.
The product relations are essential: commutation alone does not imply either equation.

The two-squares solution-set comparison needs only unique roots. The three-squares comparison
uses Vaught's condition and torsion-freeness. For the reverse radical inclusions, free groups
over the coefficients and free abelian free factors are separated by the coefficient group.

## References

* O. Kharlampovich, A. Myasnikov, *Irreducible affine varieties over a free group. I*,
  J. Algebra 200 (1998), §3, low-genus nonorientable forms.
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*,
  J. Algebra 290 (2005), §2.7, Theorem 2 (4)–(5). The presentations here include the product
  relations missing from the printed formulas.
-/

public section

open Monoid.Coprod Subgroup Group
open scoped commutatorElement

namespace TauCeti.GroupAlgGeom.Quadratic

variable {G H X : Type*} [Group G] [Group H]

/-- In a group with unique roots, `x² y² = 1` is equivalent to `x y = 1`, including when
`x` and `y` denote the same variable. -/
theorem V_sq_mul_sq [HasUniqueRoots H] (ι : G →* H) (x y : X) :
    V ι {(inr (FreeGroup.of x) : GX G X) ^ 2 * inr (FreeGroup.of y) ^ 2} =
      V ι {inr (FreeGroup.of x) * inr (FreeGroup.of y)} := by
  ext v
  simp [mul_eq_one_iff_eq_inv, ← inv_pow, pow_left_inj two_ne_zero]

/-- Over a nonabelian CSA group with big powers, the radical of `x² y² = 1` in its two
variables is the normal closure of `x y`. -/
theorem Rad_sq_mul_sq (hBP : IsBP G) (hCSA : IsCSA G) (hG : ¬IsMulCommutative G) :
    Rad (.id G) {(inr (FreeGroup.of 0) : GX G (Fin 2)) ^ 2 * inr (FreeGroup.of 1) ^ 2} =
      normalClosure {inr (FreeGroup.of 0) * inr (FreeGroup.of 1)} := by
  have := hBP.isMulTorsionFree
  have := hCSA.isCommTransitive.hasUniqueRoots
  let S : Set (GX G (Fin 2)) := {inr (FreeGroup.of 0) * inr (FreeGroup.of 1)}
  let t : GX G Unit := inr (FreeGroup.of ())
  let p : Fin 2 → GX G Unit := ![t, t⁻¹]
  let f := eval (inl : G →* GX G Unit) p
  have hS : normalClosure S ≤ f.ker := normalClosure_le_normal (by simp [S, f, p])
  -- Modulo `x y`, the map `x ↦ t`, `y ↦ t⁻¹` has inverse `t ↦ x`.
  let q := QuotientGroup.mk' (normalClosure S)
  let j := eval (q.comp inl) (fun _ : Unit => q (inr (FreeGroup.of 0)))
  have hxy : q (inr (FreeGroup.of 1)) = (q (inr (FreeGroup.of 0)))⁻¹ := by
    apply eq_inv_of_mul_eq_one_right
    have hrel : q (inr (FreeGroup.of 0) * inr (FreeGroup.of 1)) = 1 :=
      (QuotientGroup.eq_one_iff _).2 (subset_normalClosure (Set.mem_singleton _))
    simpa using hrel
  have hj : j.comp f = q := by
    apply GX.ext_hom
    · intro g
      simp [j, f]
    · intro i
      fin_cases i <;> simp [j, f, p, t, hxy]
  have hker : f.ker = normalClosure S := by
    apply le_antisymm _ hS
    intro w hw
    apply (QuotientGroup.eq_one_iff w).1
    exact (DFunLike.congr_fun hj w).symm.trans (by
      simpa using congrArg j (MonoidHom.mem_ker.mp hw))
  have heval : (evalGHom (inl : G →* GX G Unit) p : GX G (Fin 2) →* GX G Unit) = f :=
    DFunLike.ext _ _ fun w => congrFun (coe_evalGHom _ _) w
  have hrad := (GX.isDiscriminatedBy (X := Unit) hBP hCSA hG).isSeparatedBy.Rad_ker_eq
    (evalGHom (inl : G →* GX G Unit) p)
  rw [heval, hker, Rad_normalClosure] at hrad
  rw [Rad_def, V_sq_mul_sq, ← Rad_def]
  exact hrad

/-- In a torsion-free Vaught group, the three-squares equation is equivalent to the
product relation together with pairwise commutation. -/
theorem V_sq_mul_sq_mul_sq [IsMulTorsionFree H] (hV : IsVaught H) (ι : G →* H) (x y z : X) :
    V ι {(inr (FreeGroup.of x) : GX G X) ^ 2 * inr (FreeGroup.of y) ^ 2 *
        inr (FreeGroup.of z) ^ 2} =
      V ι {inr (FreeGroup.of x) * inr (FreeGroup.of y) * inr (FreeGroup.of z),
        ⁅(inr (FreeGroup.of x) : GX G X), inr (FreeGroup.of y)⁆,
        ⁅(inr (FreeGroup.of x) : GX G X), inr (FreeGroup.of z)⁆,
        ⁅(inr (FreeGroup.of y) : GX G X), inr (FreeGroup.of z)⁆} := by
  ext v
  simp only [mem_V, Set.mem_singleton_iff, forall_eq, Set.mem_insert_iff,
    forall_eq_or_imp, map_mul, map_pow, eval_inr_of, map_commutatorElement,
    commutatorElement_eq_one_iff_commute]
  constructor
  · intro h
    obtain ⟨hxy, hxz, hyz⟩ := (isVaught_iff H).mp hV _ _ _ h
    refine ⟨?_, hxy, hxz, hyz⟩
    apply (pow_eq_one_iff_left two_ne_zero).1
    rwa [(hxz.mul_left hyz).mul_pow, hxy.mul_pow]
  · rintro ⟨h, hxy, hxz, hyz⟩
    rw [← hxy.mul_pow, ← (hxz.mul_left hyz).mul_pow, h, one_pow]

/-- The universal commuting solution of `x² y² z² = 1`: send `x` and `y` to the two
standard generators of a free abelian free factor, and `z` to the inverse of their product. -/
def threeSquaresMap (G : Type*) [Group G] :
    GX G (Fin 3) →* Monoid.Coprod G (Fin 2 → Multiplicative ℤ) :=
  eval inl ![inr (Pi.mulSingle 0 (.ofAdd 1)), inr (Pi.mulSingle 1 (.ofAdd 1)),
    (inr (Pi.mulSingle 0 (.ofAdd 1)) * inr (Pi.mulSingle 1 (.ofAdd 1)))⁻¹]

/-- The universal solution fixes the coefficients. -/
@[simp] theorem threeSquaresMap_inl (g : G) : threeSquaresMap G (inl g) = inl g := by
  simp [threeSquaresMap]

/-- The first variable becomes the first abelian generator. -/
@[simp] theorem threeSquaresMap_inr_of_zero :
    threeSquaresMap G (inr (FreeGroup.of 0)) = inr (Pi.mulSingle 0 (.ofAdd 1)) := by
  simp [threeSquaresMap]

/-- The second variable becomes the second abelian generator. -/
@[simp] theorem threeSquaresMap_inr_of_one :
    threeSquaresMap G (inr (FreeGroup.of 1)) = inr (Pi.mulSingle 1 (.ofAdd 1)) := by
  simp [threeSquaresMap]

/-- The third variable becomes the inverse product of the two abelian generators. -/
@[simp] theorem threeSquaresMap_inr_of_two :
    threeSquaresMap G (inr (FreeGroup.of 2)) =
      (inr (Pi.mulSingle 0 (.ofAdd 1)) * inr (Pi.mulSingle 1 (.ofAdd 1)))⁻¹ := by
  simp [threeSquaresMap]

/-- Every element of the coefficient group with a free abelian factor is represented by the
universal commuting three-squares solution. -/
theorem threeSquaresMap_surjective : Function.Surjective (threeSquaresMap G) := by
  intro w
  induction w using Monoid.Coprod.induction_on with
  | inl g => exact ⟨inl g, threeSquaresMap_inl g⟩
  | inr v =>
    refine ⟨inr (FreeGroup.of 0) ^ (v 0).toAdd * inr (FreeGroup.of 1) ^ (v 1).toAdd, ?_⟩
    simp only [map_mul, map_zpow, threeSquaresMap_inr_of_zero, threeSquaresMap_inr_of_one]
    rw [← map_zpow, ← map_zpow, ← map_mul]
    congr 1
    ext i
    fin_cases i <;> simp
  | mul a b ha hb =>
    obtain ⟨a', rfl⟩ := ha
    obtain ⟨b', rfl⟩ := hb
    exact ⟨a' * b', map_mul _ _ _⟩

/-- The relations of the universal commuting three-squares solution are exactly the product
relation and the pairwise commutators, with no relations imposed on the coefficients. -/
theorem ker_threeSquaresMap :
    (threeSquaresMap G).ker = normalClosure
      {(inr (FreeGroup.of 0) : GX G (Fin 3)) * inr (FreeGroup.of 1) * inr (FreeGroup.of 2),
        ⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 1)⁆,
        ⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆,
        ⁅(inr (FreeGroup.of 1) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆} := by
  let S : Set (GX G (Fin 3)) :=
    {inr (FreeGroup.of 0) * inr (FreeGroup.of 1) * inr (FreeGroup.of 2),
      ⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 1)⁆,
      ⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆,
      ⁅(inr (FreeGroup.of 1) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆}
  have hS : normalClosure S ≤ (threeSquaresMap G).ker := by
    apply normalClosure_le_normal
    simp only [S, Set.insert_subset_iff, Set.singleton_subset_iff]
    have hc (a b : Fin 2 → Multiplicative ℤ) : Commute (inr a :
        Monoid.Coprod G (Fin 2 → Multiplicative ℤ)) (inr b) := (Commute.all a b).map inr
    simp [commutatorElement_eq_one_iff_commute, hc]
  let q := QuotientGroup.mk' (normalClosure S)
  have hc : Commute (q (inr (FreeGroup.of 0))) (q (inr (FreeGroup.of 1))) := by
    rw [← commutatorElement_eq_one_iff_commute, ← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).2 (subset_normalClosure (by simp [S]))
  let r : Fin 2 → GX G (Fin 3) ⧸ normalClosure S :=
    ![q (inr (FreeGroup.of 0)), q (inr (FreeGroup.of 1))]
  have hr : ∀ i j, Commute (r i) (r j) := by
    intro i j
    fin_cases i <;> fin_cases j <;> simp [r, hc, hc.symm, Commute.refl]
  -- The commuting classes of `x` and `y` give an inverse modulo the displayed relations.
  let j := Monoid.Coprod.lift (q.comp inl) (zpowersPiHom r hr)
  have hz : q (inr (FreeGroup.of 2)) =
      (q (inr (FreeGroup.of 0)) * q (inr (FreeGroup.of 1)))⁻¹ := by
    apply eq_inv_of_mul_eq_one_right
    have hrel : q (inr (FreeGroup.of 0) * inr (FreeGroup.of 1) * inr (FreeGroup.of 2)) = 1 :=
      (QuotientGroup.eq_one_iff _).2 (subset_normalClosure (by simp [S]))
    simpa using hrel
  have hj : j.comp (threeSquaresMap G) = q := by
    apply GX.ext_hom
    · intro g; simp [j]
    · intro i
      fin_cases i <;> simp [j, r, hz]
  apply le_antisymm _ hS
  intro w hw
  apply (QuotientGroup.eq_one_iff w).1
  exact (DFunLike.congr_fun hj w).symm.trans (by
    simpa using congrArg j (MonoidHom.mem_ker.mp hw))

/-- Over a nonabelian CSA BP group satisfying Vaught's condition, the radical of
`x² y² z² = 1` is generated by `x y z` and all three pairwise commutators. -/
theorem Rad_sq_mul_sq_mul_sq (hBP : IsBP G) (hCSA : IsCSA G) (hV : IsVaught G)
    (hG : ¬IsMulCommutative G) :
    Rad (MonoidHom.id G)
      {(inr (FreeGroup.of 0) : GX G (Fin 3)) ^ 2 * inr (FreeGroup.of 1) ^ 2 *
        inr (FreeGroup.of 2) ^ 2} =
      normalClosure
        {inr (FreeGroup.of 0) * inr (FreeGroup.of 1) * inr (FreeGroup.of 2),
          ⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 1)⁆,
          ⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆,
          ⁅(inr (FreeGroup.of 1) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆} := by
  have := hBP.isMulTorsionFree
  obtain ⟨u, v, huv⟩ : ∃ u v : G, ¬Commute u v := by
    simpa [isMulCommutative_iff, commute_iff_eq] using hG
  have hu : u ≠ 1 := by rintro rfl; exact huv (Commute.one_left _)
  have hv : v ∉ centralizer {u} := fun h => huv (mem_centralizer_singleton_iff.1 h).symm
  -- Embed the free abelian free factor into a full-centralizer extension, separated by `G`.
  let f : GHom (inl : G →* Monoid.Coprod G (Fin 2 → Multiplicative ℤ))
      (LimitGroup.CentralizerExt.of : G →* LimitGroup.CentralizerExt u 2) :=
    ⟨LimitGroup.CentralizerExt.coprodPiLift u (.id G) (.id _) v 0, fun g => by simp⟩
  have hf : Function.Injective f := LimitGroup.CentralizerExt.coprodPiLift_injective 0
    Function.injective_id Function.injective_id (hCSA.centralizer_isTISubgroup u) hv
  have hsep := ((LimitGroup.CentralizerExt.isDiscriminatedBy (n := 2) hBP hCSA hu).of_injective
    f hf).isSeparatedBy
  have hrad : Rad (.id G) ((threeSquaresMap G).ker : Set (GX G (Fin 3))) =
      (threeSquaresMap G).ker := hsep.Rad_ker_eq
        ⟨threeSquaresMap G, fun g => threeSquaresMap_inl g⟩
  rw [ker_threeSquaresMap, Rad_normalClosure] at hrad
  rw [Rad_def, V_sq_mul_sq_mul_sq hV, ← Rad_def]
  exact hrad

/-- Pairwise commutation alone does not impose the three-squares equation. In particular,
the product relation cannot be dropped from its radical presentation. -/
theorem sq_mul_sq_mul_sq_notMem_normalClosure_commutators :
    (inr (FreeGroup.of 0) : GX G (Fin 3)) ^ 2 * inr (FreeGroup.of 1) ^ 2 *
        inr (FreeGroup.of 2) ^ 2 ∉ normalClosure
      {⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 1)⁆,
        ⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆,
        ⁅(inr (FreeGroup.of 1) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆} := by
  let f := eval (1 : G →* Multiplicative ℤ) (fun _ : Fin 3 => Multiplicative.ofAdd 1)
  have hker : normalClosure
      {⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 1)⁆,
        ⁅(inr (FreeGroup.of 0) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆,
        ⁅(inr (FreeGroup.of 1) : GX G (Fin 3)), inr (FreeGroup.of 2)⁆} ≤ f.ker := by
    apply normalClosure_le_normal
    simp [Set.subset_def, commutatorElement_eq_one_iff_commute, Commute.all]
  intro h
  have heq := congrArg Multiplicative.toAdd (MonoidHom.mem_ker.mp (hker h))
  norm_num [f] at heq

end TauCeti.GroupAlgGeom.Quadratic
