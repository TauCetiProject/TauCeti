/-!
# A standard quadratic equation over the free factor of its first atom

Let `S = r₁ r₂ ⋯ r_k d = 1` be a standard quadratic equation over a group `G` with `k ≥ 2` atoms,
and let `Q₁` be the variables of its first atom `r₁` (`Standard.headVars`): `{x₁, y₁}` for a
commutator, `{x₁}` for a square and `{z₁}` for a conjugate of a coefficient. Read over the free
product `G ∗ F(Q₁)`, the conjugate `r₂ ⋯ r_k (d r₁) = 1` of `S` is again a standard quadratic
equation (`Standard.tail`): its atoms are `r₂, …, r_k` (`Standard.atoms_eq_cons_tail`), its
constant is `d r₁ ∈ G ∗ F(Q₁)` (`Standard.constant_tail`), which is not trivial, and it has one
atom less and genus one less, or zero (`Standard.atomicRank_tail`, `Standard.genus_tail`). A
non-orientable equation of genus one becomes an orientable equation of genus zero
(`Standard.isOrientable_tail_iff`).

The two equations have the same solutions, the variables of `Q₁` being read as coefficients
(`Standard.mem_V_tail_iff`), and the same group: `G_S ≃* (G ∗ F(Q₁))_{S'}` for `S'` the tail
(`Standard.systemGroupEquivTail`), under which the coefficients `G ∗ F(Q₁)` go to the subgroup of
`G_S` generated by `G` and `Q₁`. This is Proposition 1 of [VAR-I] for `i = 1`, the case used in
the induction on the atomic rank of [VAR-I], Theorem 4, and of [IFT], Proposition 5.

## Main definitions

* `TauCeti.GroupAlgGeom.Quadratic.Standard.headVars`: the variables of the first atom.
* `TauCeti.GroupAlgGeom.Quadratic.Standard.headAtom`: the first atom, as a word in them.
* `TauCeti.GroupAlgGeom.Quadratic.Standard.tail`: the equation `r₂ ⋯ r_k (d r₁) = 1` over
  `G ∗ F(Q₁)`.
* `TauCeti.GroupAlgGeom.Quadratic.Standard.systemGroupEquivTail`: `G_S ≃* (G ∗ F(Q₁))_{S'}`.

## Main results

* `TauCeti.GroupAlgGeom.Quadratic.Standard.sumComplEquiv_toWord`: read over `G ∗ F(Q₁)`, `S` is the
  conjugate of its tail by its first atom.
* `TauCeti.GroupAlgGeom.Quadratic.Standard.mem_V_tail_iff`: the solutions correspond.
* `TauCeti.GroupAlgGeom.Quadratic.Standard.sumComplEquiv_symm_toWord_tail_orientable_two`: the
  tail of `[x₁, y₁][x₂, y₂] = 1` is the one-commutator equation `[x₂, y₂] = [y₁, x₁]` over
  `G ∗ F(x₁, y₁)`, the reading of [IFT], §7.2, p. 99, with the two commutators exchanged.

## References

* [VAR-I] O. Kharlampovich, A. Myasnikov, *Irreducible affine varieties over a free group. I:
  Irreducibility of quadratic equations and Nullstellensatz*, J. Algebra 200 (1998), §1,
  Proposition 1, and §6, proof of Theorem 4.
* [IFT] O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra
  290 (2005), §7.2, proof of Proposition 5.
-/

public section

open Monoid.Coprod
open scoped commutatorElement

namespace TauCeti.GroupAlgGeom.Quadratic.Standard

variable {G H X : Type*} [Group G] [Group H]

/-! ### The first atom -/

/-- The variables of the first atom of a standard quadratic equation: `{x₁, y₁}` for a commutator
`[x₁, y₁]`, `{x₁}` for a square `x₁²`, and `{z₁}` for a conjugate `z₁⁻¹ c₁ z₁`. -/
def headVars : Standard G X → Set X
  | orientable (_ + 1) _ x y _ => {x 0, y 0}
  | orientableCoeff (_ + 1) _ _ x y _ _ _ _ _ _ => {x 0, y 0}
  | orientableCoeff 0 (_ + 1) _ _ _ z _ _ _ _ _ => {z 0}
  | nonorientable (_ + 1) _ x _ => {x 0}
  | nonorientableCoeff (_ + 1) _ _ x _ _ _ _ _ _ => {x 0}
  | orientable 0 .. => ∅
  | orientableCoeff 0 0 .. => ∅
  | nonorientable 0 .. => ∅
  | nonorientableCoeff 0 .. => ∅

section HeadVars

variable {n m : ℕ} {z : Fin m → X} {c : Fin m → G} {d : G}

@[simp]
theorem headVars_orientable (hn : 0 < n) {x y : Fin n → X} (inj : (Sum.elim x y).Injective) :
    (orientable (G := G) n hn x y inj).headVars = {x ⟨0, hn⟩, y ⟨0, hn⟩} := by
  cases n
  exacts [absurd hn (lt_irrefl 0), rfl]

@[simp]
theorem headVars_orientableCoeff (hnm : 0 < n + 1 + m) {x y : Fin (n + 1) → X}
    (inj : (Sum.elim (Sum.elim x y) z).Injective) (hc : ∀ j, c j ≠ 1) (hd : d ≠ 1) :
    (orientableCoeff (n + 1) m hnm x y z inj c hc d hd).headVars = {x 0, y 0} :=
  (rfl)

@[simp]
theorem headVars_orientableCoeff_zero {x y : Fin 0 → X} {z : Fin (m + 1) → X}
    {c : Fin (m + 1) → G} (hnm : 0 < 0 + (m + 1)) (inj : (Sum.elim (Sum.elim x y) z).Injective)
    (hc : ∀ j, c j ≠ 1) (hd : d ≠ 1) :
    (orientableCoeff 0 (m + 1) hnm x y z inj c hc d hd).headVars = {z 0} :=
  (rfl)

@[simp]
theorem headVars_nonorientable (hn : 0 < n) {x : Fin n → X} (inj : x.Injective) :
    (nonorientable (G := G) n hn x inj).headVars = {x ⟨0, hn⟩} := by
  cases n
  exacts [absurd hn (lt_irrefl 0), rfl]

@[simp]
theorem headVars_nonorientableCoeff (hn : 0 < n) {x : Fin n → X} (inj : (Sum.elim x z).Injective)
    (hc : ∀ j, c j ≠ 1) (hd : d ≠ 1) :
    (nonorientableCoeff n m hn x z inj c hc d hd).headVars = {x ⟨0, hn⟩} := by
  cases n
  exacts [absurd hn (lt_irrefl 0), rfl]

end HeadVars

/-- The first atom of a standard quadratic equation, as a word over `G` in the variables of the
first atom. -/
def headAtom : (S : Standard G X) → GX G S.headVars
  | orientable (n + 1) hn x y inj =>
    ⁅(inr (FreeGroup.of ⟨x 0, by simp⟩) :
        GX G (orientable (G := G) (n + 1) hn x y inj).headVars)⁻¹,
      (inr (FreeGroup.of ⟨y 0, by simp⟩) :
        GX G (orientable (G := G) (n + 1) hn x y inj).headVars)⁻¹⁆
  | orientableCoeff (n + 1) m hnm x y z inj c hc d hd =>
    ⁅(inr (FreeGroup.of ⟨x 0, by simp⟩) :
        GX G (orientableCoeff (n + 1) m hnm x y z inj c hc d hd).headVars)⁻¹,
      (inr (FreeGroup.of ⟨y 0, by simp⟩) :
        GX G (orientableCoeff (n + 1) m hnm x y z inj c hc d hd).headVars)⁻¹⁆
  | orientableCoeff 0 (_ + 1) _ _ _ z _ c _ _ _ =>
    (inr (FreeGroup.of ⟨z 0, by simp⟩))⁻¹ * inl (c 0) *
      inr (FreeGroup.of ⟨z 0, by simp⟩)
  | nonorientable (_ + 1) _ x _ => inr (FreeGroup.of ⟨x 0, by simp⟩) ^ 2
  | nonorientableCoeff (_ + 1) _ _ x _ _ _ _ _ _ =>
    inr (FreeGroup.of ⟨x 0, by simp⟩) ^ 2
  | orientable 0 .. => 1
  | orientableCoeff 0 0 .. => 1
  | nonorientable 0 .. => 1
  | nonorientableCoeff 0 .. => 1

/-- Every variable of the first atom is a variable of the equation. -/
theorem headVars_subset_vars (S : Standard G X) : S.headVars ⊆ S.vars := by
  rcases S with ⟨_ | n, hn, x, y, inj⟩ | ⟨_ | n, _ | m, hnm, x, y, z, inj, c, hc, d, hd⟩ |
    ⟨_ | n, hn, x, inj⟩ | ⟨_ | n, m, hn, x, z, inj, c, hc, d, hd⟩ <;>
    simp [headVars, Set.insert_subset_iff]

/-- The first atom of `S`, read in `G[X]`, is the first entry of the list of atoms. -/
theorem head?_atoms (S : Standard G X) :
    S.atoms.head? = some (Monoid.Coprod.map (.id G) (FreeGroup.map Subtype.val) S.headAtom) := by
  rcases S with ⟨_ | n, hn, x, y, inj⟩ | ⟨_ | n, _ | m, hnm, x, y, z, inj, c, hc, d, hd⟩ |
    ⟨_ | n, hn, x, inj⟩ | ⟨_ | n, m, hn, x, z, inj, c, hc, d, hd⟩
  all_goals first
    | exact absurd hn (lt_irrefl 0) | exact absurd hnm (lt_irrefl 0)
    | simp [headAtom, List.ofFn_succ, map_commutatorElement]

-- The first atom is not a coefficient: a variable of the first atom occurs in it.
private theorem headAtom_notMem_range_inl (S : Standard G X) :
    S.headAtom ∉ Set.range (inl : G →* GX G S.headVars) := by
  have hcomm {Q : Set X} {p q : Q} (hpq : p ≠ q) :
      ⁅(inr (FreeGroup.of p) : GX G Q)⁻¹, (inr (FreeGroup.of q) : GX G Q)⁻¹⁆ ∉
        Set.range (inl : G →* GX G Q) := by
    have hl : GX.IsReduced ([.inr (p, false), .inr (q, false), .inr (p, true), .inr (q, true)] :
        List (G ⊕ Q × Bool)) := by
      simp [hpq, hpq.symm]
    have := hl.occurrences_prod p
    rw [mem_range_inl_iff_forall_occurrences_eq_zero, not_forall]
    exact ⟨p, by simp_all [commutatorElement_def, mul_assoc, Ne.symm hpq]⟩
  have hsq {Q : Set X} (p : Q) :
      (inr (FreeGroup.of p) : GX G Q) ^ 2 ∉ Set.range (inl : G →* GX G Q) := by
    have hl : GX.IsReduced ([.inr (p, true), .inr (p, true)] : List (G ⊕ Q × Bool)) := by simp
    have := hl.occurrences_prod p
    rw [mem_range_inl_iff_forall_occurrences_eq_zero, not_forall]
    exact ⟨p, by simp_all [pow_two]⟩
  have hconj {Q : Set X} {c : G} (hc : c ≠ 1) (p : Q) :
      (inr (FreeGroup.of p) : GX G Q)⁻¹ * inl c * inr (FreeGroup.of p) ∉
        Set.range (inl : G →* GX G Q) := by
    rw [mem_range_inl_iff_forall_occurrences_eq_zero, not_forall]
    exact ⟨p, by simp [occurrences_inv_mul_inl_mul_self hc]⟩
  match S with
  | orientable (n + 1) hn x y inj =>
    exact hcomm fun h => Sum.inl_ne_inr (@inj (.inl 0) (.inr 0) (congrArg Subtype.val h))
  | orientableCoeff (n + 1) m hnm x y z inj c hc d hd =>
    exact hcomm fun h => by
      simpa using @inj (.inl (.inl 0)) (.inl (.inr 0)) (congrArg Subtype.val h)
  | orientableCoeff 0 (m + 1) hnm x y z inj c hc d hd => exact hconj (hc 0) _
  | nonorientable (n + 1) hn x inj => exact hsq _
  | nonorientableCoeff (n + 1) m hn x z inj c hc d hd => exact hsq _
  | orientable 0 hn _ _ _ => exact absurd hn (lt_irrefl 0)
  | orientableCoeff 0 0 hnm _ _ _ _ _ _ _ _ => exact absurd hnm (lt_irrefl 0)
  | nonorientable 0 hn _ _ => exact absurd hn (lt_irrefl 0)
  | nonorientableCoeff 0 _ hn _ _ _ _ _ _ _ => exact absurd hn (lt_irrefl 0)

/-- A coefficient times the first atom is never trivial. In particular the constant `d r₁` of the
tail of `S` is nontrivial. -/
theorem inl_mul_headAtom_ne_one (S : Standard G X) (g : G) :
    (inl g : GX G S.headVars) * S.headAtom ≠ 1 := fun h =>
  S.headAtom_notMem_range_inl ⟨g⁻¹, by rw [map_inv, eq_inv_of_mul_eq_one_right h]⟩

/-! ### The tail -/

/-- The tail of a standard quadratic equation `r₁ r₂ ⋯ r_k d = 1` with `k ≥ 2` atoms: the
standard quadratic equation `r₂ ⋯ r_k (d r₁) = 1` over `G ∗ F(Q₁)`, for `Q₁` the variables of the
first atom, in the other variables. Its atoms are `r₂, …, r_k` and its constant is `d r₁`. A
non-orientable equation of genus one has an orientable tail of genus zero. -/
def tail : (S : Standard G X) → 2 ≤ S.atomicRank → Standard (GX G S.headVars) ↥S.headVarsᶜ
  | orientable (n + 2) hn x y inj, _ =>
    orientableCoeff (n + 1) 0 (by omega)
      (fun i => ⟨x i.succ, inj.apply_notMem_pair (a := .inl i.succ) (b := .inl 0)
        (c := .inr 0) (by simp) (by simp)⟩)
      (fun i => ⟨y i.succ, inj.apply_notMem_pair (a := .inr i.succ) (b := .inl 0)
        (c := .inr 0) (by simp) (by simp)⟩) Fin.elim0
      (.of_val_eq (inj.comp (f := Sum.elim (Sum.map Fin.succ Fin.succ) Fin.elim0)
        ((Sum.map_injective.2 ⟨Fin.succ_injective _, Fin.succ_injective _⟩).sumElim
          (fun a => a.elim0) fun _ b => b.elim0))
        (by rintro ((a | a) | a) <;> first | rfl | exact a.elim0))
      Fin.elim0 (fun j => j.elim0) ((orientable (n + 2) hn x y inj).headAtom)
      (by simpa using inl_mul_headAtom_ne_one (orientable (n + 2) hn x y inj) (1 : G))
  | orientableCoeff (n + 1) m hnm x y z inj c hc d hd, h =>
    orientableCoeff n m (by simp [atomicRank_orientableCoeff] at h; omega)
      (fun i => ⟨x i.succ, inj.apply_notMem_pair (a := .inl (.inl i.succ))
        (b := .inl (.inl 0)) (c := .inl (.inr 0)) (by simp) (by simp)⟩)
      (fun i => ⟨y i.succ, inj.apply_notMem_pair (a := .inl (.inr i.succ))
        (b := .inl (.inl 0)) (c := .inl (.inr 0)) (by simp) (by simp)⟩)
      (fun j => ⟨z j, inj.apply_notMem_pair (a := .inr j)
        (b := .inl (.inl 0)) (c := .inl (.inr 0)) (by simp) (by simp)⟩)
      (.of_val_eq (inj.comp (f := Sum.map (Sum.map Fin.succ Fin.succ) id)
        (Sum.map_injective.2 ⟨Sum.map_injective.2 ⟨Fin.succ_injective _, Fin.succ_injective _⟩,
          Function.injective_id⟩))
        (by rintro ((a | a) | a) <;> rfl))
      (fun j => inl (c j)) (fun j => (map_ne_one_iff _ inl_injective).2 (hc j))
      (inl d * (orientableCoeff (n + 1) m hnm x y z inj c hc d hd).headAtom)
      (inl_mul_headAtom_ne_one _ d)
  | orientableCoeff 0 (m + 1) hnm x y z inj c hc d hd, h =>
    orientableCoeff 0 m (by simp [atomicRank_orientableCoeff] at h; omega)
      Fin.elim0 Fin.elim0
      (fun j => ⟨z j.succ, Set.mem_compl_singleton_iff.2
        (inj.ne (a₁ := .inr j.succ) (a₂ := .inr 0) (by simp))⟩)
      (.of_val_eq (inj.comp (f := Sum.map id Fin.succ)
        (Sum.map_injective.2 ⟨Function.injective_id, Fin.succ_injective _⟩))
        (by rintro ((a | a) | a) <;> first | rfl | exact a.elim0))
      (fun j => inl (c j.succ)) (fun j => (map_ne_one_iff _ inl_injective).2 (hc j.succ))
      (inl d * (orientableCoeff 0 (m + 1) hnm x y z inj c hc d hd).headAtom)
      (inl_mul_headAtom_ne_one _ d)
  | nonorientable (n + 2) hn x inj, _ =>
    nonorientableCoeff (n + 1) 0 (by omega)
      (fun i => ⟨x i.succ, Set.mem_compl_singleton_iff.2 (inj.ne (Fin.succ_ne_zero i))⟩) Fin.elim0
      (.of_val_eq (inj.comp (f := Sum.elim Fin.succ Fin.elim0)
        ((Fin.succ_injective _).sumElim (fun a => a.elim0) fun _ b => b.elim0))
        (by rintro (a | a) <;> first | rfl | exact a.elim0))
      Fin.elim0 (fun j => j.elim0) ((nonorientable (n + 2) hn x inj).headAtom)
      (by simpa using inl_mul_headAtom_ne_one (nonorientable (n + 2) hn x inj) (1 : G))
  | nonorientableCoeff (n + 2) m hn x z inj c hc d hd, _ =>
    nonorientableCoeff (n + 1) m (by omega)
      (fun i => ⟨x i.succ, Set.mem_compl_singleton_iff.2
        (inj.ne (a₁ := .inl i.succ) (a₂ := .inl 0) (by simp))⟩)
      (fun j => ⟨z j, Set.mem_compl_singleton_iff.2
        (inj.ne (a₁ := .inr j) (a₂ := .inl 0) (by simp))⟩)
      (.of_val_eq (inj.comp (f := Sum.map Fin.succ id)
        (Sum.map_injective.2 ⟨Fin.succ_injective _, Function.injective_id⟩))
        (by rintro (a | a) <;> rfl))
      (fun j => inl (c j)) (fun j => (map_ne_one_iff _ inl_injective).2 (hc j))
      (inl d * (nonorientableCoeff (n + 2) m hn x z inj c hc d hd).headAtom)
      (inl_mul_headAtom_ne_one _ d)
  | nonorientableCoeff 1 (m + 1) hn x z inj c hc d hd, _ =>
    orientableCoeff 0 (m + 1) (by omega) Fin.elim0 Fin.elim0
      (fun j => ⟨z j, Set.mem_compl_singleton_iff.2
        (inj.ne (a₁ := .inr j) (a₂ := .inl 0) (by simp))⟩)
      (.of_val_eq (inj.comp (f := Sum.map (Sum.elim Fin.elim0 Fin.elim0) id)
        (Sum.map_injective.2 ⟨fun a => by rcases a with a | a <;> exact a.elim0,
          Function.injective_id⟩))
        (by rintro ((a | a) | a) <;> first | rfl | exact a.elim0))
      (fun j => inl (c j)) (fun j => (map_ne_one_iff _ inl_injective).2 (hc j))
      (inl d * (nonorientableCoeff 1 (m + 1) hn x z inj c hc d hd).headAtom)
      (inl_mul_headAtom_ne_one _ d)
  | orientable 0 hn _ _ _, _ => absurd hn (lt_irrefl 0)
  | orientable 1 hn x y inj, h => absurd h (by simp [atomicRank_orientable])
  | orientableCoeff 0 0 hnm _ _ _ _ _ _ _ _, _ => absurd hnm (lt_irrefl 0)
  | nonorientable 0 hn _ _, _ => absurd hn (lt_irrefl 0)
  | nonorientable 1 hn x inj, h => absurd h (by simp [atomicRank_nonorientable])
  | nonorientableCoeff 0 _ hn _ _ _ _ _ _ _, _ => absurd hn (lt_irrefl 0)
  | nonorientableCoeff 1 0 hn x z inj c hc d hd, h =>
    absurd h (by simp [atomicRank_nonorientableCoeff])

-- Case analysis on a standard quadratic equation with at least two atoms, along the arms of
-- `tail`.
@[elab_as_elim]
private theorem tail_cases {motive : (S : Standard G X) → 2 ≤ S.atomicRank → Prop}
    (orient : ∀ n hn x y inj h, motive (orientable (n + 2) hn x y inj) h)
    (orientCoeff : ∀ n m hnm x y z inj c hc d hd h,
      motive (orientableCoeff (n + 1) m hnm x y z inj c hc d hd) h)
    (orientCoeffZero : ∀ m hnm x y z inj c hc d hd h,
      motive (orientableCoeff 0 (m + 1) hnm x y z inj c hc d hd) h)
    (nonorient : ∀ n hn x inj h, motive (nonorientable (n + 2) hn x inj) h)
    (nonorientCoeff : ∀ n m hn x z inj c hc d hd h,
      motive (nonorientableCoeff (n + 2) m hn x z inj c hc d hd) h)
    (nonorientCoeffOne : ∀ m hn x z inj c hc d hd h,
      motive (nonorientableCoeff 1 (m + 1) hn x z inj c hc d hd) h)
    (S : Standard G X) (h : 2 ≤ S.atomicRank) : motive S h := by
  rcases S with ⟨_ | _ | n, hn, x, y, inj⟩ | ⟨_ | n, _ | m, hnm, x, y, z, inj, c, hc, d, hd⟩ |
    ⟨_ | _ | n, hn, x, inj⟩ | ⟨_ | _ | n, _ | m, hn, x, z, inj, c, hc, d, hd⟩
  all_goals first
    | exact orient .. | exact orientCoeff .. | exact orientCoeffZero .. | exact nonorient ..
    | exact nonorientCoeff .. | exact nonorientCoeffOne .. | exact absurd hn (lt_irrefl 0)
    | exact absurd hnm (lt_irrefl 0) | simp at h

variable (S : Standard G X) (h : 2 ≤ S.atomicRank)

/-- The atoms of `S` are its first atom followed by the atoms of the tail, read in `G[X]`. -/
theorem atoms_eq_cons_tail :
    S.atoms = Monoid.Coprod.map (.id G) (FreeGroup.map Subtype.val) S.headAtom ::
      (S.tail h).atoms.map (GX.sumComplEquiv G S.headVars).symm := by
  refine (List.eq_cons_of_mem_head? S.head?_atoms).trans (congrArg _ ?_)
  induction S, h using tail_cases <;> simp [tail, List.ofFn_succ, Function.comp_def]

/-- The constant of the tail is the constant of `S` times the first atom. -/
@[simp]
theorem constant_tail : (S.tail h).constant = inl S.constant * S.headAtom := by
  induction S, h using tail_cases <;> simp [tail]

/-- The tail has one atom less. -/
theorem atomicRank_tail : (S.tail h).atomicRank + 1 = S.atomicRank := by
  induction S, h using tail_cases <;> simp [tail] <;> omega

/-- The tail has genus one less, or zero. -/
@[simp]
theorem genus_tail : (S.tail h).genus = S.genus - 1 := by
  induction S, h using tail_cases <;> simp [tail]

/-- The tail is orientable exactly when `S` is orientable or has genus one. -/
@[simp]
theorem isOrientable_tail_iff : (S.tail h).IsOrientable ↔ S.IsOrientable ∨ S.genus = 1 := by
  induction S, h using tail_cases <;> simp [tail]

-- The variables of the tail are variables of `S`.
private theorem image_val_vars_tail_subset : Subtype.val '' (S.tail h).vars ⊆ S.vars := by
  induction S, h using tail_cases <;> simp only [tail, vars_orientable, vars_orientableCoeff,
    vars_nonorientable, vars_nonorientableCoeff] <;> rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
  · rcases a with (a | a) | a
    exacts [⟨.inl a.succ, rfl⟩, ⟨.inr a.succ, rfl⟩, a.elim0]
  · rcases a with (a | a) | a
    exacts [⟨.inl (.inl a.succ), rfl⟩, ⟨.inl (.inr a.succ), rfl⟩, ⟨.inr a, rfl⟩]
  · rcases a with (a | a) | a
    exacts [a.elim0, a.elim0, ⟨.inr a.succ, rfl⟩]
  · rcases a with a | a
    exacts [⟨a.succ, rfl⟩, a.elim0]
  · rcases a with a | a
    exacts [⟨.inl a.succ, rfl⟩, ⟨.inr a, rfl⟩]
  · rcases a with (a | a) | a
    exacts [a.elim0, a.elim0, ⟨.inr a, rfl⟩]

-- The variables of `S` outside the first atom are variables of the tail.
private theorem vars_diff_headVars_subset :
    S.vars \ S.headVars ⊆ Subtype.val '' (S.tail h).vars := by
  induction S, h using tail_cases <;> simp only [tail, vars_orientable, vars_orientableCoeff,
    vars_nonorientable, vars_nonorientableCoeff] <;> rintro _ ⟨⟨b, rfl⟩, hb⟩
  · rcases b with i | i <;> cases i using Fin.cases
    exacts [(hb (by simp)).elim, ⟨_, ⟨.inl (.inl _), rfl⟩, rfl⟩,
      (hb (by simp)).elim, ⟨_, ⟨.inl (.inr _), rfl⟩, rfl⟩]
  · rcases b with (i | i) | j
    · cases i using Fin.cases
      exacts [(hb (by simp)).elim, ⟨_, ⟨.inl (.inl _), rfl⟩, rfl⟩]
    · cases i using Fin.cases
      exacts [(hb (by simp)).elim, ⟨_, ⟨.inl (.inr _), rfl⟩, rfl⟩]
    · exact ⟨_, ⟨.inr j, rfl⟩, rfl⟩
  · rcases b with (i | i) | j
    · exact i.elim0
    · exact i.elim0
    · cases j using Fin.cases
      exacts [(hb (by simp)).elim, ⟨_, ⟨.inr _, rfl⟩, rfl⟩]
  · cases b using Fin.cases
    exacts [(hb (by simp)).elim, ⟨_, ⟨.inl _, rfl⟩, rfl⟩]
  · rcases b with i | j
    · cases i using Fin.cases
      exacts [(hb (by simp)).elim, ⟨_, ⟨.inl _, rfl⟩, rfl⟩]
    · exact ⟨_, ⟨.inr j, rfl⟩, rfl⟩
  · rcases b with i | j
    · obtain rfl := Subsingleton.elim i 0
      exact (hb (by simp)).elim
    · exact ⟨_, ⟨.inr j, rfl⟩, rfl⟩

/-- The variables of the tail are those of `S` outside the first atom. -/
theorem image_val_vars_tail : Subtype.val '' (S.tail h).vars = S.vars \ S.headVars :=
  (Set.subset_sdiff.2 ⟨S.image_val_vars_tail_subset h, Set.disjoint_left.2
    fun _ ⟨x, _, hx⟩ hv => x.property (hx ▸ hv)⟩).antisymm (S.vars_diff_headVars_subset h)

/-- Read over `G ∗ F(Q₁)`, the equation `S = r₁ r₂ ⋯ r_k d` is the conjugate of its tail
`r₂ ⋯ r_k (d r₁)` by the first atom `r₁`. -/
theorem sumComplEquiv_toWord : GX.sumComplEquiv G S.headVars S.toWord =
    inl S.headAtom * (S.tail h).toWord * (inl S.headAtom)⁻¹ := by
  rw [toWord_def, toWord_def, S.atoms_eq_cons_tail h]
  simp [map_list_prod, mul_assoc]

/-- The values of the atoms of the tail at the restriction of a point `v` to the other variables,
the coefficients `G ∗ F(Q₁)` being evaluated at the restriction of `v` to `Q₁`, are the values at
`v` of the atoms `r₂, …, r_k` of `S`. -/
theorem map_eval_atoms_tail (ι : G →* H) (v : X → H) :
    (S.tail h).atoms.map (eval (eval ι fun q : S.headVars => v q) fun x : ↥S.headVarsᶜ => v x) =
      (S.atoms.map (eval ι v)).tail := by
  rw [S.atoms_eq_cons_tail h]
  simp [Function.comp_def]

/-- A point `v` solves `S` exactly when its restriction to the variables outside the first atom
solves the tail, the variables of the first atom being evaluated at `v`. -/
theorem mem_V_tail_iff (ι : G →* H) (v : X → H) :
    (fun x : ↥S.headVarsᶜ => v x) ∈ V (eval ι fun q : S.headVars => v q) {(S.tail h).toWord} ↔
      v ∈ V ι {S.toWord} := by
  simp only [mem_V, Set.forall_mem_singleton]
  rw [← (GX.sumComplEquiv G S.headVars).symm_apply_apply S.toWord, S.sumComplEquiv_toWord h,
    GX.eval_sumComplEquiv_symm, map_mul, map_mul, map_inv, mul_inv_eq_one, mul_eq_left]

/-- **The genus-two equation over the free factor of its first commutator.** Read in `G[X]`, the
tail of `[x₁, y₁][x₂, y₂] = 1` is the one-commutator equation `[x₂, y₂][x₁, y₁] = 1`, whose
constant `[x₁, y₁]` lies in `G ∗ F(x₁, y₁)`. -/
theorem sumComplEquiv_symm_toWord_tail_orientable_two {x y : Fin 2 → X}
    (inj : (Sum.elim x y).Injective) :
    (GX.sumComplEquiv G _).symm ((orientable 2 two_pos x y inj).tail
        (by simp [atomicRank_orientable])).toWord =
      ⁅(inr (FreeGroup.of (x 1)) : GX G X)⁻¹, (inr (FreeGroup.of (y 1)))⁻¹⁆ *
        ⁅(inr (FreeGroup.of (x 0)) : GX G X)⁻¹, (inr (FreeGroup.of (y 0)))⁻¹⁆ := by
  simp [tail, headAtom, toWord_def, map_commutatorElement]

/-! ### The group of the equation over `G ∗ F(Q₁)` -/

/-- **[VAR-I], Proposition 1, for the first atom.** The group `G_S` of a standard quadratic
equation with at least two atoms is the group of its tail over `G ∗ F(Q₁)`, for `Q₁` the variables
of the first atom: a word of `G[X]` goes to its reading over `G ∗ F(Q₁)`. -/
noncomputable def systemGroupEquivTail :
    SystemGroup G {S.toWord} ≃* SystemGroup (GX G S.headVars) {(S.tail h).toWord} :=
  (SystemGroup.sumComplEquiv S.headVars {S.toWord}).trans
    (QuotientGroup.quotientMulEquivOfEq (by
      rw [Set.image_singleton]
      refine (isConj_iff.2 ⟨(inl S.headAtom)⁻¹, ?_⟩).normalClosure_singleton_eq
      rw [S.sumComplEquiv_toWord h]
      simp [mul_assoc]))

@[simp]
theorem systemGroupEquivTail_mk (w : GX G X) :
    S.systemGroupEquivTail h (w : SystemGroup G {S.toWord}) =
      (GX.sumComplEquiv G S.headVars w : SystemGroup (GX G S.headVars) _) := by
  simp [systemGroupEquivTail]

@[simp]
theorem systemGroupEquivTail_symm_mk (w : GX (GX G S.headVars) ↥S.headVarsᶜ) :
    (S.systemGroupEquivTail h).symm (w : SystemGroup (GX G S.headVars) _) =
      ((GX.sumComplEquiv G S.headVars).symm w : SystemGroup G {S.toWord}) := by
  rw [MulEquiv.symm_apply_eq, systemGroupEquivTail_mk, MulEquiv.apply_symm_apply]

/-- The isomorphism `G_S ≃* (G ∗ F(Q₁))_{S'}` is a `G`-isomorphism. -/
theorem systemGroupEquivTail_coeff (g : G) :
    S.systemGroupEquivTail h (SystemGroup.coeff _ g) = SystemGroup.coeff _ (inl g) := by
  simp

end TauCeti.GroupAlgGeom.Quadratic.Standard
