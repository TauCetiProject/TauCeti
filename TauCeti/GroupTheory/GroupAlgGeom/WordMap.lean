/-!
# Word maps and coordinate-group homomorphisms

A map `V_H(S) → V_H(T)` between algebraic sets is a *morphism* if it is given at every point by a
tuple of coefficient words. A tuple of words that maps one algebraic set into another induces a
coefficient-preserving homomorphism in the opposite direction between their coordinate groups,
`CoordGroup.homOfMapsToWordMap`, contravariantly functorially. Conversely, every such
homomorphism is represented by a tuple of words, and two tuples represent the same homomorphism
precisely when their word maps agree at every point of the source algebraic set. This describes
polynomial maps without choosing presentations of coordinate functions.

In the other direction, a coefficient-preserving homomorphism `φ : Γ(T) → Γ(S)` of coordinate
groups induces the map `CoordGroup.comap φ : V_H(S) → V_H(T)`: a solution of `S`, viewed as a
homomorphism `Γ(S) → H`, is precomposed with `φ`. This is again functorial, and the morphisms
`V_H(S) → V_H(T)` correspond bijectively to the homomorphisms `Γ(T) → Γ(S)`. Consequently two
algebraic sets are isomorphic through mutually inverse morphisms exactly when their coordinate
groups are isomorphic by an isomorphism fixing the coefficients.

Everything holds for an arbitrary coefficient homomorphism `ι : G →* H`, including systems
without solutions, whose coordinate groups are trivial.

The two extreme algebraic sets behave as follows. Evaluation at a solution `v` maps the coordinate
group onto the subgroup of `H` generated by the coefficients and the coordinates of `v`; when `v` is
the only solution this map is injective, so the coordinate group of a point is that subgroup, and
every coefficient-preserving homomorphism to `H` is evaluation at `v`. The coordinate group of a
system without solutions, on the other hand, does not contain `G`: the coordinate group is a
`G`-group exactly when `ι` is injective and the algebraic set is nonempty.

For the commutator equation `[x, g] = 1` in one variable, whose solutions form the centralizer of
`ι g`, coefficient-preserving homomorphisms from the coordinate group to `H` correspond to that
centralizer; over a free group and a free generator `a` they correspond to the powers of `a`. The
change of coordinates `x ↦ x g` fixes the equation and so carries its solution set onto itself.

## Main definitions

* `TauCeti.GroupAlgGeom.IsWordMap`: a map between algebraic sets given by a tuple of words.
* `TauCeti.GroupAlgGeom.CoordGroup.comap`: the map of algebraic sets induced by a
  coordinate-group homomorphism.
* `TauCeti.GroupAlgGeom.CoordGroup.gHomEquivWordMap`: coefficient-preserving homomorphisms
  `Γ(T) → Γ(S)` correspond to morphisms `V_H(S) → V_H(T)`.
* `TauCeti.GroupAlgGeom.CoordGroup.gHomEquivCentralizer`,
  `TauCeti.GroupAlgGeom.CoordGroup.gHomEquivZPowers`: coefficient-preserving homomorphisms from
  the coordinate group of `[x, g] = 1` to `H` correspond to the centralizer of `ι g`, and over a
  free group `F` with a free generator `a`, those from the coordinate group of `[x, a] = 1` to `F`
  correspond to the powers of `a`.

## Main results

* `TauCeti.GroupAlgGeom.isWordMap_id`, `TauCeti.GroupAlgGeom.IsWordMap.comp`: morphisms of
  algebraic sets contain the identities and are closed under composition.
* `TauCeti.GroupAlgGeom.CoordGroup.comap_id`, `TauCeti.GroupAlgGeom.CoordGroup.comap_comp`:
  the map of algebraic sets induced by a coordinate-group homomorphism is contravariantly
  functorial.
* `TauCeti.GroupAlgGeom.CoordGroup.exists_wordMap_representation`,
  `TauCeti.GroupAlgGeom.CoordGroup.homOfMapsToWordMap_eq_iff`: every coordinate-group
  homomorphism comes from a word map, unique up to agreement on the algebraic set.
* `TauCeti.GroupAlgGeom.CoordGroup.exists_mulEquiv_iff_exists_equiv_isWordMap`: algebraic sets
  are isomorphic if and only if their coordinate groups are isomorphic over the coefficients.
* `TauCeti.GroupAlgGeom.CoordGroup.range_evalGHom`,
  `TauCeti.GroupAlgGeom.CoordGroup.evalGHom_injective_iff`,
  `TauCeti.GroupAlgGeom.CoordGroup.evalGHom_injective`,
  `TauCeti.GroupAlgGeom.CoordGroup.eq_evalGHom`: the coordinate group of a single point `v`
  is the subgroup generated by the coefficients and `v` (evaluation at a solution is injective
  exactly at a generic point), and its only coefficient-preserving homomorphism to `H` is
  evaluation at `v`.
* `TauCeti.GroupAlgGeom.CoordGroup.not_injective_coeff_of_V_eq_empty`,
  `TauCeti.GroupAlgGeom.CoordGroup.coeff_injective_iff`: the coordinate group of a system without
  solutions is not a `G`-group; in general it is one exactly when `ι` is injective and the system
  has a solution.
* `TauCeti.GroupAlgGeom.GX.evalGHom_inr_of_mul_inl_bijective`,
  `TauCeti.GroupAlgGeom.image_coordinateChangeEquiv_V_commutatorElement`: multiplying the
  variables on the right by coefficients is a change of coordinates, and `x ↦ x g` carries the
  solutions of `[x, g] = 1` onto themselves.

## References

* G. Baumslag, A. Myasnikov, V. Remeslennikov, *Algebraic geometry over groups I. Algebraic sets
  and ideal theory*, J. Algebra 219 (1999), §1.7 (the ideal of the empty set), §3.3, Corollary 6
  and Definitions 13 and 14, §3.4, Proposition 9 and Lemma 14, and §3.5, Theorem 4 and
  Corollary 9.
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §2.4.
-/

public section

namespace TauCeti.GroupAlgGeom

open Monoid.Coprod

variable {G H X Y Z : Type*} [Group G] [Group H]

/-! ### Morphisms of algebraic sets -/

section IsWordMap

variable {ι : G →* H} {S : Set (GX G X)} {T : Set (GX G Y)} {U : Set (GX G Z)}

/-- A map `V_H(S) → V_H(T)` between algebraic sets is a *morphism* if there is a tuple of
coefficient words `w : Y → G[X]` such that `f v = (w_y(v))_y` at every solution `v` of `S`. -/
def IsWordMap (f : V ι S → V ι T) : Prop :=
  ∃ w : Y → GX G X, ∀ v : V ι S, (f v : Y → H) = wordMap ι w v

/-- A map between algebraic sets is a morphism exactly when some tuple of words gives it at every
point. -/
theorem isWordMap_iff {f : V ι S → V ι T} :
    IsWordMap f ↔ ∃ w : Y → GX G X, ∀ v : V ι S, (f v : Y → H) = wordMap ι w v :=
  Iff.rfl

/-- The identity of an algebraic set is a morphism, given by the tuple of variables. -/
theorem isWordMap_id : IsWordMap (id : V ι S → V ι S) :=
  ⟨fun x => inr (FreeGroup.of x), fun v => (wordMap_id (ι := ι) v.1).symm⟩

/-- Morphisms of algebraic sets compose; the composite is given by substituting the first tuple
of words into the second. -/
theorem IsWordMap.comp {g : V ι T → V ι U} {f : V ι S → V ι T} (hg : IsWordMap g)
    (hf : IsWordMap f) : IsWordMap (g ∘ f) := by
  obtain ⟨u, hu⟩ := hg
  obtain ⟨w, hw⟩ := hf
  refine ⟨fun z => eval (inl : G →* GX G X) w (u z), fun v => ?_⟩
  rw [Function.comp_apply, hu, hw, wordMap_wordMap]

end IsWordMap

namespace CoordGroup

variable (ι : G →* H) (S : Set (GX G X)) (T : Set (GX G Y)) (U : Set (GX G Z))

/-! ### Coordinate-group homomorphisms are given by word maps -/

/-- Every coefficient-preserving coordinate-group homomorphism is represented by a tuple of
coefficient words, whose word map carries source solutions to target solutions. -/
theorem exists_wordMap_representation (φ : GHom (coeff ι T) (coeff ι S)) :
    ∃ w : Y → GX G X, ∃ hw : MapsToWordMap ι S T w,
      homOfMapsToWordMap ι S T w hw = φ := by
  classical
  have hsurj : ∀ y : Y, ∃ w : GX G X,
      (w : CoordGroup ι S) = φ ((inr (FreeGroup.of y) : GX G Y) : CoordGroup ι T) := by
    intro y
    exact QuotientGroup.mk_surjective _
  choose w hw using hsurj
  have hmap : MapsToWordMap ι S T w := by
    rw [mapsToWordMap_iff]
    intro v hv
    let ψ : GHom (coeff ι T) ι := (evalGHom v hv).comp φ
    have hcoords : wordMap ι w v = (homEquiv ι T ψ : Y → H) := by
      funext y
      simp only [wordMap_apply, homEquiv_apply_coe]
      rw [← evalGHom_mk (ι := ι) (S := S) hv (w y), hw y]
      exact (congrFun (GHom.coe_comp (evalGHom v hv) φ)
        ((inr (FreeGroup.of y) : GX G Y) : CoordGroup ι T)).symm
    rw [hcoords]
    exact (homEquiv ι T ψ).property
  refine ⟨w, hmap, ?_⟩
  apply gHom_ext
  intro y
  rw [homOfMapsToWordMap_mk, eval_inr_of, hw y]

/-- Two representing tuples induce the same coordinate-group homomorphism exactly when they
give the same function on the source algebraic set. -/
theorem homOfMapsToWordMap_eq_iff (w w' : Y → GX G X)
    (hw : MapsToWordMap ι S T w) (hw' : MapsToWordMap ι S T w') :
    homOfMapsToWordMap ι S T w hw = homOfMapsToWordMap ι S T w' hw' ↔
      ∀ v ∈ V ι S, wordMap ι w v = wordMap ι w' v := by
  constructor
  · intro h v hv
    have h' := congrArg (fun f : GHom (coeff ι T) (coeff ι S) =>
      (homEquiv ι T ((evalGHom v hv).comp f) : Y → H)) h
    exact (homEquiv_comp_homOfMapsToWordMap ι S T w hw ⟨v, hv⟩).symm.trans
      (h'.trans (homEquiv_comp_homOfMapsToWordMap ι S T w' hw' ⟨v, hv⟩))
  · intro h
    apply gHom_ext
    intro y
    simp only [homOfMapsToWordMap_mk, eval_inr_of]
    apply QuotientGroup.eq.mpr
    rw [mem_Rad]
    intro v hv
    have := congrFun (h v hv) y
    simpa only [wordMap_apply, map_mul, map_inv, inv_mul_eq_one] using this

/-! ### From coordinate-group homomorphisms to maps of algebraic sets -/

variable {ι S T U}

/-- A coefficient-preserving homomorphism `φ : Γ(T) → Γ(S)` maps solutions of `S` to solutions
of `T`: a solution of `S`, viewed as a homomorphism `Γ(S) → H`, is precomposed with `φ`. -/
def comap (φ : GHom (coeff ι T) (coeff ι S)) (v : V ι S) : V ι T :=
  homEquiv ι T ((evalGHom v.1 v.2).comp φ)

/-- Evaluation at `comap φ v` is evaluation at `v` precomposed with `φ`. -/
@[simp]
theorem evalGHom_comap (φ : GHom (coeff ι T) (coeff ι S)) (v : V ι S) :
    evalGHom (comap φ v : Y → H) (comap φ v).2 = (evalGHom v.1 v.2).comp φ :=
  (homEquiv ι T).symm_apply_apply _

/-- The coordinates of `comap φ v` are the values at `v` of the images of the variables
under `φ`. -/
@[simp]
theorem comap_apply_coe (φ : GHom (coeff ι T) (coeff ι S)) (v : V ι S) (y : Y) :
    (comap φ v : Y → H) y =
      evalGHom v.1 v.2 (φ ((inr (FreeGroup.of y) : GX G Y) : CoordGroup ι T)) := by
  simp [comap]

/-- The identity of a coordinate group induces the identity of the algebraic set. -/
@[simp]
theorem comap_id : comap (GHom.id (coeff ι S)) = id := by
  ext v x
  simp

/-- Pointwise form of `comap_comp`. -/
theorem comap_comp_apply (φ : GHom (coeff ι T) (coeff ι S)) (ψ : GHom (coeff ι U) (coeff ι T))
    (v : V ι S) : comap (φ.comp ψ) v = comap ψ (comap φ v) := by
  apply (homEquiv ι U).symm.injective
  simp [GHom.comp_assoc]

/-- A composite of coordinate-group homomorphisms induces the composite of the induced maps of
algebraic sets, in the opposite order. -/
@[simp]
theorem comap_comp (φ : GHom (coeff ι T) (coeff ι S)) (ψ : GHom (coeff ι U) (coeff ι T)) :
    comap (φ.comp ψ) = comap ψ ∘ comap φ :=
  funext (comap_comp_apply φ ψ)

/-- On a word map, `comap` of the induced homomorphism is that word map. -/
@[simp]
theorem comap_homOfMapsToWordMap (w : Y → GX G X) (hw : MapsToWordMap ι S T w) (v : V ι S) :
    (comap (homOfMapsToWordMap ι S T w hw) v : Y → H) = wordMap ι w v :=
  homEquiv_comp_homOfMapsToWordMap ι S T w hw v

/-- The map of algebraic sets induced by a coordinate-group homomorphism is a morphism. -/
theorem isWordMap_comap (φ : GHom (coeff ι T) (coeff ι S)) : IsWordMap (comap φ) := by
  obtain ⟨w, hw, rfl⟩ := exists_wordMap_representation ι S T φ
  exact ⟨w, comap_homOfMapsToWordMap w hw⟩

/-- A coordinate-group homomorphism is determined by the map it induces on algebraic sets. -/
theorem comap_injective :
    Function.Injective (comap : GHom (coeff ι T) (coeff ι S) → V ι S → V ι T) := by
  intro φ ψ h
  obtain ⟨w, hw, rfl⟩ := exists_wordMap_representation ι S T φ
  obtain ⟨w', hw', rfl⟩ := exists_wordMap_representation ι S T ψ
  refine (homOfMapsToWordMap_eq_iff ι S T w w' hw hw').2 fun v hv => ?_
  simpa using congrArg Subtype.val (congrFun h ⟨v, hv⟩)

/-- The morphisms `V_H(S) → V_H(T)` are exactly the maps induced by coefficient-preserving
homomorphisms `Γ(T) → Γ(S)`. -/
theorem isWordMap_iff_exists_comap_eq {f : V ι S → V ι T} :
    IsWordMap f ↔ ∃ φ : GHom (coeff ι T) (coeff ι S), comap φ = f := by
  refine ⟨fun ⟨w, hf⟩ => ?_, fun ⟨φ, hφ⟩ => hφ ▸ isWordMap_comap φ⟩
  have hw : MapsToWordMap ι S T w := (mapsToWordMap_iff ι S T w).2 fun v hv => by
    rw [← hf ⟨v, hv⟩]
    exact (f ⟨v, hv⟩).2
  exact ⟨homOfMapsToWordMap ι S T w hw, funext fun v =>
    Subtype.ext ((comap_homOfMapsToWordMap w hw v).trans (hf v).symm)⟩

variable (ι S T) in
/-- Coefficient-preserving homomorphisms `Γ(T) → Γ(S)` of coordinate groups correspond to
morphisms `V_H(S) → V_H(T)` of algebraic sets, by `comap`. -/
noncomputable def gHomEquivWordMap :
    GHom (coeff ι T) (coeff ι S) ≃ {f : V ι S → V ι T // IsWordMap f} :=
  Equiv.ofBijective (fun φ => ⟨comap φ, isWordMap_comap φ⟩)
    ⟨fun _ _ h => comap_injective (congrArg Subtype.val h),
      fun f => (isWordMap_iff_exists_comap_eq.1 f.2).imp fun _ hφ => Subtype.ext hφ⟩

/-- The morphism corresponding to a coordinate-group homomorphism is the map it induces. -/
@[simp]
theorem gHomEquivWordMap_apply (φ : GHom (coeff ι T) (coeff ι S)) :
    (gHomEquivWordMap ι S T φ : V ι S → V ι T) = comap φ :=
  (rfl)

/-- The coordinate-group homomorphism corresponding to a morphism induces that morphism. -/
@[simp]
theorem comap_gHomEquivWordMap_symm (f : {g : V ι S → V ι T // IsWordMap g}) :
    comap ((gHomEquivWordMap ι S T).symm f) = f :=
  congrArg Subtype.val ((gHomEquivWordMap ι S T).apply_symm_apply f)

/-- Two algebraic sets are isomorphic through mutually inverse morphisms exactly when their
coordinate groups are isomorphic by an isomorphism fixing the coefficients. -/
theorem exists_mulEquiv_iff_exists_equiv_isWordMap :
    (∃ e : CoordGroup ι T ≃* CoordGroup ι S, ∀ g, e (coeff ι T g) = coeff ι S g) ↔
      ∃ e : V ι S ≃ V ι T, IsWordMap e ∧ IsWordMap e.symm := by
  constructor
  · rintro ⟨e, he⟩
    let φ : GHom (coeff ι T) (coeff ι S) := ⟨e.toMonoidHom, he⟩
    let ψ : GHom (coeff ι S) (coeff ι T) :=
      ⟨e.symm.toMonoidHom, fun g => e.symm_apply_eq.2 (he g).symm⟩
    have h₁ : φ.comp ψ = GHom.id _ := GHom.ext fun x => by simp [φ, ψ]
    have h₂ : ψ.comp φ = GHom.id _ := GHom.ext fun x => by simp [φ, ψ]
    refine ⟨⟨comap φ, comap ψ, fun v => ?_, fun v => ?_⟩, isWordMap_comap φ, isWordMap_comap ψ⟩
    · rw [← comap_comp_apply, h₁, comap_id, id]
    · rw [← comap_comp_apply, h₂, comap_id, id]
  · rintro ⟨e, he, he'⟩
    obtain ⟨φ, hφ⟩ := isWordMap_iff_exists_comap_eq.1 he
    obtain ⟨ψ, hψ⟩ := isWordMap_iff_exists_comap_eq.1 he'
    have h₁ : φ.comp ψ = GHom.id _ := comap_injective (by
      rw [comap_comp, hφ, hψ, comap_id, e.symm_comp_self])
    have h₂ : ψ.comp φ = GHom.id _ := comap_injective (by
      rw [comap_comp, hφ, hψ, comap_id, e.self_comp_symm])
    exact ⟨MonoidHom.toMulEquiv φ ψ
      (MonoidHom.ext fun x => by simpa using DFunLike.congr_fun h₂ x)
      (MonoidHom.ext fun x => by simpa using DFunLike.congr_fun h₁ x), φ.map_coeff⟩

end CoordGroup

/-! ### Points of coordinate groups -/

namespace CoordGroup

variable {ι : G →* H} {S : Set (GX G X)} {v : X → H}

/-- Evaluation at a solution `v` maps the coordinate group onto the subgroup of `H` generated by
the coefficients and the coordinates of `v`. -/
theorem range_evalGHom (hv : v ∈ V ι S) :
    (evalGHom v hv : CoordGroup ι S →* H).range = ι.range ⊔ Subgroup.closure (Set.range v) := by
  -- The quotient map is surjective, so the range is that of evaluation on `G[X]`.
  have h : (evalGHom v hv : CoordGroup ι S →* H).comp (QuotientGroup.mk' _) = eval ι v :=
    MonoidHom.ext (evalGHom_mk hv)
  rw [MonoidHom.range_eq_map, ← MonoidHom.range_eq_top.2 (QuotientGroup.mk'_surjective (Rad ι S)),
    MonoidHom.map_range, h, Monoid.Coprod.range_eq, eval_comp_inl, eval_comp_inr,
    FreeGroup.range_lift_eq_closure]

/-- Evaluation at a solution `v` is injective on the coordinate group exactly when every equation
vanishing at `v` vanishes on all of `V_H(S)`, that is, when `v` is a generic point of `V_H(S)`. -/
theorem evalGHom_injective_iff (hv : v ∈ V ι S) :
    Function.Injective (evalGHom v hv) ↔ I ι {v} ≤ Rad ι S := by
  refine ⟨fun h w hw => (QuotientGroup.eq_one_iff w).1 (h ?_), fun h => ?_⟩
  · simpa using hw
  refine (injective_iff_map_eq_one _).2 fun q hq => ?_
  induction q using QuotientGroup.induction_on with
  | H w => exact (QuotientGroup.eq_one_iff w).2 (h (by simpa using hq))

/-- If `v` is the only solution of `S`, evaluation at `v` is injective on the coordinate group.
Together with `range_evalGHom`, this identifies `Γ({v})` with the subgroup of `H` generated by the
coefficients and the coordinates of `v`. -/
theorem evalGHom_injective (hv : v ∈ V ι S) (hS : V ι S ⊆ {v}) :
    Function.Injective (evalGHom v hv) :=
  (evalGHom_injective_iff hv).2 (I_antitone ι hS)

/-- If `v` is the only solution of `S`, every coefficient-preserving homomorphism `Γ(S) → H` is
evaluation at `v`. -/
theorem eq_evalGHom (hv : v ∈ V ι S) (hS : V ι S ⊆ {v}) (φ : GHom (coeff ι S) ι) :
    φ = evalGHom v hv := by
  refine (homEquiv ι S).injective (Subtype.ext ((hS (homEquiv ι S φ).2).trans ?_))
  funext x
  simp

/-- The coordinate group of a system without solutions in `H` is not a `G`-group: its coefficient
homomorphism is not injective. -/
theorem not_injective_coeff_of_V_eq_empty (hS : V ι S = ∅) :
    ¬Function.Injective (coeff ι S) := by
  intro h
  -- The radical is everything, so all coefficients become trivial and `G` must be trivial.
  have hG : ∀ g : G, g = 1 := fun g => h <| by simp [hS]
  -- Over trivial coefficients the constant point `1` solves every equation.
  have h1 : eval ι (1 : X → H) = 1 :=
    hom_ext (MonoidHom.ext fun g => by simp [hG g]) (FreeGroup.ext_hom _ _ fun x => by simp)
  exact hS.subset ((mem_V (v := 1)).2 fun s _ => by simp [h1])

/-- The coordinate group of `S` is a `G`-group, that is, its coefficient homomorphism is
injective, exactly when `ι` is injective and `S` has a solution in `H`. In particular, over a
`G`-group `H` the coordinate groups of nonempty algebraic sets are `G`-groups and that of the empty
set is not. -/
theorem coeff_injective_iff :
    Function.Injective (coeff ι S) ↔ Function.Injective ι ∧ (V ι S).Nonempty := by
  refine ⟨fun h => ⟨fun g g' hg => h ?_, ?_⟩, fun h => coeff_injective h.1 h.2⟩
  · -- Coefficients with the same image in `H` agree at every point, so they agree in `Γ(S)`.
    exact QuotientGroup.eq.2 (mem_Rad.2 fun v _ => by simp [hg])
  · exact Set.nonempty_iff_ne_empty.2 fun hS => not_injective_coeff_of_V_eq_empty hS h

end CoordGroup

/-! ### The commutator equation `[x, g] = 1` -/

section Commutator

open FreeGroup Subgroup
open scoped commutatorElement

/-- Right multiplication of every variable by a coefficient, `x ↦ x (g x)`, is a change of
coordinates of `G[X]`. -/
theorem GX.evalGHom_inr_of_mul_inl_bijective (g : X → G) :
    Function.Bijective (evalGHom (inl : G →* GX G X) fun x => inr (of x) * inl (g x)) := by
  set σ := evalGHom (inl : G →* GX G X) fun x => inr (of x) * inl (g x)
  -- The inverse multiplies every variable on the right by the inverse coefficient.
  set τ := evalGHom (inl : G →* GX G X) fun x => inr (of x) * inl (g x)⁻¹
  have h₁ : σ.comp τ = GHom.id _ := by
    ext x
    simp [σ, τ]
  have h₂ : τ.comp σ = GHom.id _ := by
    ext x
    simp [σ, τ]
  exact ⟨Function.LeftInverse.injective (g := τ) fun w => by simpa using DFunLike.congr_fun h₂ w,
    Function.RightInverse.surjective (g := τ) fun w => by simpa using DFunLike.congr_fun h₁ w⟩

/-- The change of coordinates `x ↦ x g` of `G[x]` fixes the commutator `[x, g]`. -/
theorem GX.evalGHom_inr_of_mul_inl_commutatorElement (g : G) :
    evalGHom (inl : G →* GX G Unit) (fun x => inr (of x) * inl g)
        ⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆ =
      ⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆ := by
  simp [commutatorElement_def]

variable (ι : G →* H)

/-- The change of coordinates `x ↦ x g` carries the solutions of `[x, g] = 1`, the centralizer of
`ι g`, onto themselves. -/
theorem image_coordinateChangeEquiv_V_commutatorElement (g : G) :
    coordinateChangeEquiv ι _ (GX.evalGHom_inr_of_mul_inl_bijective fun _ : Unit => g) ''
        V ι {⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆} =
      V ι {⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆} := by
  have hσ := GX.evalGHom_inr_of_mul_inl_bijective fun _ : Unit => g
  have hc := GX.evalGHom_inr_of_mul_inl_commutatorElement g
  -- The change of coordinates fixes the equation, so it fixes the system.
  have hpre : (evalGHom (inl : G →* GX G Unit) fun x => inr (of x) * inl g) ⁻¹'
      {⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆} =
      {⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆} :=
    Set.ext fun w => ⟨fun h => hσ.1 (h.trans hc.symm), fun h => (congrArg _ h).trans hc⟩
  ext v
  rw [Equiv.image_eq_preimage_symm, Set.mem_preimage, ← wordMap_mem_V_iff ι _ hσ.2,
    ← coordinateChangeEquiv_apply ι _ hσ, Equiv.apply_symm_apply, hpre]

namespace CoordGroup

/-- Coefficient-preserving homomorphisms to `H` from the coordinate group of the commutator
equation `[x, g] = 1` in one variable correspond to the elements of the centralizer of `ι g`, by
evaluation at `x`. -/
def gHomEquivCentralizer (g : G) :
    GHom (coeff ι {⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆}) ι ≃ centralizer {ι g} :=
  (homEquiv ι _).trans <| (Equiv.funUnique Unit H).subtypeEquiv fun v => by
    simp [V_singleton_commutatorElement]

@[simp]
theorem gHomEquivCentralizer_apply_coe (g : G)
    (φ : GHom (coeff ι {⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆}) ι) :
    (gHomEquivCentralizer ι g φ : H) = φ (inr (of ()) : GX G Unit) :=
  (rfl)

@[simp]
theorem gHomEquivCentralizer_symm_apply_mk (g : G) (h : centralizer {ι g}) (w : GX G Unit) :
    (gHomEquivCentralizer ι g).symm h
        (w : CoordGroup ι {⁅(inr (of ()) : GX G Unit), (inl g : GX G Unit)⁆}) =
      eval ι (fun _ => (h : H)) w :=
  (rfl)

/-- Over a free group `F`, coefficient-preserving homomorphisms to `F` from the coordinate group
of the commutator equation `[x, a] = 1`, for a free generator `a`, correspond to the powers of
`a`, by evaluation at `x`. -/
def gHomEquivZPowers {α : Type*} (a : α) : GHom (coeff (.id (FreeGroup α))
    {⁅(inr (of ()) : GX (FreeGroup α) Unit), (inl (of a) : GX (FreeGroup α) Unit)⁆})
    (.id (FreeGroup α)) ≃ zpowers (of a) :=
  (gHomEquivCentralizer (.id _) (of a)).trans <| Equiv.subtypeEquivRight fun h => by
    rw [MonoidHom.id_apply, centralizer_singleton_of]

@[simp]
theorem gHomEquivZPowers_apply_coe {α : Type*} (a : α) (φ : GHom (coeff (.id (FreeGroup α))
      {⁅(inr (of ()) : GX (FreeGroup α) Unit), (inl (of a) : GX (FreeGroup α) Unit)⁆})
      (.id (FreeGroup α))) :
    (gHomEquivZPowers a φ : FreeGroup α) = φ (inr (of ()) : GX (FreeGroup α) Unit) :=
  (rfl)

@[simp]
theorem gHomEquivZPowers_symm_apply_mk {α : Type*} (a : α) (h : zpowers (of a))
    (w : GX (FreeGroup α) Unit) :
    (gHomEquivZPowers a).symm h (w : CoordGroup (.id (FreeGroup α))
        {⁅(inr (of ()) : GX (FreeGroup α) Unit), (inl (of a) : GX (FreeGroup α) Unit)⁆}) =
      eval (.id (FreeGroup α)) (fun _ => (h : FreeGroup α)) w :=
  (rfl)

end CoordGroup

end Commutator

