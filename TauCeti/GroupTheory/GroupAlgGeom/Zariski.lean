/-!
# The Zariski topology of equations over groups

The Zariski topology on tuples in a group receiving coefficients from `G` is generated by
complements of solution sets of systems of equations over `G`. Thus every algebraic set is
closed, whether or not the coefficient group or the target group is a domain. A tuple whose
coordinates are coefficients is a closed point. Word maps are continuous because substitution
pulls an equation back to an equation.

The topology is attached to the coefficient homomorphism: different choices of coefficients
can give different closed sets on the same underlying group of points.

When the target is a domain over the coefficients and the coefficient image is nontrivial,
commutator equations make finite unions algebraic. In that case all closed sets are algebraic
and the closure of a set is the solution set of its ideal of vanishing equations. The
nontrivial-image condition makes the empty set algebraic; it can fail even for injective
coefficient maps when the coefficient group is trivial.

Without any domain hypothesis, the closure of an irreducible set `Y` is still the algebraic set
`V_H(I_H(Y))`, so every irreducible closed set is algebraic.

## References

* G. Baumslag, A. Myasnikov, V. Remeslennikov, *Algebraic geometry over groups I. Algebraic sets
  and ideal theory*, J. Algebra 219 (1999), §3.2, Theorem 3 and Lemma 11; §3.6,
  Proposition 10.
-/

public section

namespace TauCeti.GroupAlgGeom

open Monoid.Coprod
open scoped commutatorElement

variable {G H : Type*} [Group G] [Group H]

/-- The Zariski topology generated by the complements of algebraic sets over `G`. -/
@[instance_reducible] def zariskiTopology (ι : G →* H) (X : Type*) :
    TopologicalSpace (X → H) :=
  TopologicalSpace.generateFrom
    {U | ∃ S : Set (GX G X), U = (V ι S)ᶜ}

/-- The Zariski topology is generated by the complements of algebraic sets. -/
theorem zariskiTopology_def (ι : G →* H) (X : Type*) :
    zariskiTopology ι X = TopologicalSpace.generateFrom {U | ∃ S : Set (GX G X), U = (V ι S)ᶜ} :=
  (rfl)

variable {X : Type*} {ι : G →* H}

/-- The commutator equations defining the union of two algebraic sets over a domain. -/
def unionEquations (S T : Set (GX G X)) : Set (GX G X) :=
  {u | ∃ s ∈ S, ∃ t ∈ T, ∃ g : G, u = ⁅s, inl g * t * (inl g)⁻¹⁆}

/-- The equations in `unionEquations S T` are the commutators of one equation from each
system, conjugated by coefficients. -/
@[simp]
theorem mem_unionEquations {S T : Set (GX G X)} {u : GX G X} :
    u ∈ unionEquations S T ↔
      ∃ s ∈ S, ∃ t ∈ T, ∃ g : G, u = ⁅s, inl g * t * (inl g)⁻¹⁆ :=
  Iff.rfl

/-- Every solution of either system solves their commutator equations, in any group. -/
theorem union_subset_V_unionEquations (S T : Set (GX G X)) :
    V ι S ∪ V ι T ⊆ V ι (unionEquations S T) := by
  intro v hUnion
  rw [mem_V]
  intro u hu
  obtain ⟨s, hsS, t, htT, g, rfl⟩ := mem_unionEquations.mp hu
  rcases hUnion with hs | ht
  · simp [map_commutatorElement, (mem_V.mp hs) s hsS]
  · simp [map_commutatorElement, (mem_V.mp ht) t htT]

/-- Over a group with no zero divisors relative to its coefficients, finite unions of algebraic
sets are algebraic. -/
theorem V_unionEquations (hdom : IsGDomain ι) (S T : Set (GX G X)) :
    V ι (unionEquations S T) = V ι S ∪ V ι T := by
  apply Set.Subset.antisymm
  · intro v h
    by_contra hn
    simp only [Set.mem_union, not_or, not_forall, mem_V] at hn
    obtain ⟨s, hs, hvs⟩ := hn.1
    obtain ⟨t, ht, hvt⟩ := hn.2
    obtain ⟨g, hg⟩ := (isGDomain_iff ι).mp hdom _ _ hvs hvt
    have heq := (mem_V.mp h) _ (mem_unionEquations.mpr ⟨s, hs, t, ht, g, rfl⟩)
    apply hg
    exact commutatorElement_eq_one_iff_commute.mp (by simpa using heq)
  · exact union_subset_V_unionEquations S T

/-- The solution set of any system of equations is Zariski closed. -/
theorem isClosed_V (S : Set (GX G X)) :
    @IsClosed (X → H) (zariskiTopology ι X) (V ι S) := by
  have h : @IsOpen (X → H) (zariskiTopology ι X) (V ι S)ᶜ :=
    TopologicalSpace.isOpen_generateFrom_of_mem
      ⟨S, rfl⟩
  simpa only [compl_compl] using (@IsOpen.isClosed_compl (X → H) (zariskiTopology ι X) _ h)

/-- A map into a Zariski space is continuous exactly when every algebraic set has closed
preimage. This characterization does not require a domain or nontrivial coefficients. -/
theorem continuous_into_zariskiTopology_iff {A : Type*} [TopologicalSpace A]
    {f : A → (X → H)} :
    @Continuous A (X → H) _ (zariskiTopology ι X) f ↔
      ∀ S : Set (GX G X), IsClosed (f ⁻¹' V ι S) := by
  constructor
  · intro hf S
    exact (@continuous_iff_isClosed A (X → H) _ (zariskiTopology ι X) f).mp hf _ (isClosed_V S)
  · intro hf
    apply continuous_generateFrom_iff.mpr
    rintro U ⟨S, rfl⟩
    rw [Set.preimage_compl]
    exact (hf S).isOpen_compl

/-- A tuple of elements in the coefficient image is a closed point. -/
theorem isClosed_singleton_comp (g : X → G) :
    @IsClosed (X → H) (zariskiTopology ι X) ({(ι ∘ g : X → H)} : Set (X → H)) := by
  rw [singleton_comp_eq_V]
  exact isClosed_V _

/-- Surjective coefficients make every point closed, hence the Zariski topology is T1. -/
theorem t1Space_zariskiTopology (hι : Function.Surjective ι) (X : Type*) :
    @T1Space (X → H) (zariskiTopology ι X) := by
  refine @T1Space.mk (X → H) (zariskiTopology ι X) (fun v => ?_)
  choose g hg using fun x => hι (v x)
  have hv : (ι ∘ g : X → H) = v := funext hg
  simpa only [hv] using (isClosed_singleton_comp (ι := ι) g)

variable {Y : Type*}

/-- A tuple of words defines a continuous map in the Zariski topologies on tuples. -/
theorem continuous_wordMap (w : Y → GX G X) :
    @Continuous (X → H) (Y → H) (zariskiTopology ι X) (zariskiTopology ι Y)
      (wordMap ι w) := by
  let := zariskiTopology ι X
  exact continuous_into_zariskiTopology_iff.mpr fun S ↦ by
    rw [preimage_wordMap_V]
    exact isClosed_V _

/-- Over a domain with a nontrivial coefficient image, the generated closed sets are exactly
the algebraic sets. The nontrivial-image condition is needed for the empty closed set. -/
theorem isClosed_iff_V (hdom : IsGDomain ι) (hcoeff : ∃ g : G, ι g ≠ 1)
    (Y : Set (X → H)) :
    @IsClosed (X → H) (zariskiTopology ι X) Y ↔ ∃ S : Set (GX G X), Y = V ι S := by
  constructor
  · intro hY
    classical
    -- Algebraic sets satisfy the closed-set axioms. Compare this topology with the
    -- generated topology using Mathlib's universal property instead of induction.
    let T : TopologicalSpace (X → H) := TopologicalSpace.ofClosed
      (Set.range (V ι))
      (by
        obtain ⟨g, hg⟩ := hcoeff
        exact ⟨{inl g}, V_singleton_inl_eq_empty hg⟩)
      (by
        intro A hA
        choose F hF using fun Y : A ↦ hA Y.property
        refine ⟨⋃ Y : A, F Y, ?_⟩
        rw [V_iUnion, Set.sInter_eq_iInter]
        simp_rw [hF])
      (by
        rintro _ ⟨S, rfl⟩ _ ⟨U, rfl⟩
        exact ⟨unionEquations S U, V_unionEquations hdom S U⟩)
    have hle : T ≤ zariskiTopology ι X := TopologicalSpace.le_generateFrom_iff_subset_isOpen.mpr
      (by
        rintro _ ⟨S, rfl⟩
        -- Explicitly unfold the open-set predicate of `ofClosed` to complement membership.
        change (V ι S)ᶜᶜ ∈ Set.range (V ι)
        simpa only [compl_compl] using (Set.mem_range_self S))
    have hTY := hle _ hY.isOpen_compl
    obtain ⟨S, hS⟩ : Y ∈ Set.range (V ι) := by
      -- `T` declares complements of algebraic sets open; expose that predicate explicitly.
      change Yᶜᶜ ∈ Set.range (V ι) at hTY
      simpa only [compl_compl] using hTY
    exact ⟨S, hS.symm⟩
  · rintro ⟨S, rfl⟩
    exact isClosed_V S

/-- Over a domain with a nontrivial coefficient image, the Zariski closure is obtained by
imposing all equations that vanish on the set. -/
theorem closure_eq_V_I (hdom : IsGDomain ι) (hcoeff : ∃ g : G, ι g ≠ 1)
    (Y : Set (X → H)) :
    @closure (X → H) (zariskiTopology ι X) Y = V ι (I ι Y) := by
  apply Set.Subset.antisymm
  · exact @closure_minimal (X → H) (zariskiTopology ι X) Y (V ι (I ι Y))
      (subset_V_I Y) (isClosed_V _)
  · obtain ⟨S, hS⟩ := (isClosed_iff_V hdom hcoeff _).mp
      (@isClosed_closure (X → H) (zariskiTopology ι X) Y)
    have hYS : Y ⊆ V ι S := hS ▸ @subset_closure (X → H) (zariskiTopology ι X) Y
    have hSI : S ⊆ I ι Y := subset_I_iff.mpr hYS
    simpa only [hS] using (V_antitone ι hSI)

/-- The Zariski closure of an irreducible set is the algebraic set cut out by its ideal. No
domain hypothesis is needed. -/
theorem closure_eq_V_I_of_isIrreducible {Y : Set (X → H)}
    (hY : @IsIrreducible (X → H) (zariskiTopology ι X) Y) :
    @closure (X → H) (zariskiTopology ι X) Y = V ι (I ι Y) := by
  let := zariskiTopology ι X
  refine (closure_minimal (subset_V_I Y) (isClosed_V _)).antisymm fun v hv ↦ ?_
  let g : Set (Set (X → H)) := {U | ∃ S : Set (GX G X), U = (V ι S)ᶜ}
  have hopen {U : Set (X → H)} :
      @IsOpen _ (zariskiTopology ι X) U ↔ TopologicalSpace.GenerateOpen g U := by
    rw [zariskiTopology_def]
    rfl
  -- Every open set missing `Y` misses `V (I Y)`; argue by induction on generated open sets,
  -- using irreducibility for intersections.
  have key (U : Set (X → H)) (hU : TopologicalSpace.GenerateOpen g U) :
      Disjoint U Y → Disjoint U (V ι (I ι Y)) := by
    induction hU with
    | basic U hU =>
      obtain ⟨S, rfl⟩ := hU
      intro hUY
      have hYS : Y ⊆ V ι S := by simpa using hUY.subset_compl_left
      exact Set.disjoint_compl_left_iff_subset.2 (V_antitone ι (subset_I_iff.2 hYS))
    | univ => exact fun hUY ↦ absurd (Set.univ_disjoint.1 hUY) hY.nonempty.ne_empty
    | inter U₁ U₂ hU₁ hU₂ ih₁ ih₂ =>
      intro hUY
      by_cases h₁ : Disjoint U₁ Y
      · exact (ih₁ h₁).mono_left Set.inter_subset_left
      by_cases h₂ : Disjoint U₂ Y
      · exact (ih₂ h₂).mono_left Set.inter_subset_right
      rw [Set.not_disjoint_iff_nonempty_inter, Set.inter_comm] at h₁ h₂
      obtain ⟨w, hwY, hwU⟩ := hY.isPreirreducible U₁ U₂ (hopen.2 hU₁) (hopen.2 hU₂) h₁ h₂
      exact absurd hUY (Set.not_disjoint_iff.2 ⟨w, hwU, hwY⟩)
    | sUnion 𝒰 _ ih =>
      exact fun hUY ↦ Set.disjoint_sUnion_left.2 fun U hU ↦
        ih U hU (Set.disjoint_sUnion_left.1 hUY U hU)
  refine mem_closure_iff.2 fun U hU hvU ↦ Set.not_disjoint_iff_nonempty_inter.1 fun hUY ↦ ?_
  exact Set.disjoint_left.1 (key U (hopen.1 hU) hUY) hvU hv

/-- Every irreducible Zariski closed set is algebraic: it is cut out by its ideal. -/
theorem V_I_eq_of_isIrreducible_of_isClosed {Y : Set (X → H)}
    (hY : @IsIrreducible (X → H) (zariskiTopology ι X) Y)
    (hc : @IsClosed (X → H) (zariskiTopology ι X) Y) : V ι (I ι Y) = Y := by
  rw [← closure_eq_V_I_of_isIrreducible hY, @closure_eq_iff_isClosed _ (zariskiTopology ι X)]
  exact hc

end TauCeti.GroupAlgGeom
