/-!
# Variables read as coefficients

The free `G`-group on the variables `X ⊕ Y` is the free `G[Y]`-group on the variables `X`:
`G[X ⊕ Y] ≃* G[Y][X]` (`GX.sumEquiv`), the words in the coefficients and the variables `Y` becoming
coefficients. In the same way, for a set `Q` of variables of `X`, a word of `G[X]` is a word over
the coefficient group `G[Q]` in the other variables (`GX.sumComplEquiv : G[X] ≃* G[Q][Qᶜ]`), and
evaluating it at a point `v` is evaluating it at the restriction of `v` to `Qᶜ`, with the
coefficients evaluated at the restriction of `v` to `Q` (`GX.eval_sumComplEquiv_symm`).

A system `S` of equations over `G` in the variables `X` is therefore also a system over `G[Q]`
in the variables `Qᶜ`, and both readings present the same group:
`G_S ≃* G[Q]_S` (`SystemGroup.sumComplEquiv`). The coefficients `G[Q]` of the second reading go
to the subgroup of `G_S` generated by `G` and the variables of `Q`. This is how [VAR-I], §1, reads
a standard quadratic equation over `G` as an equation over the free product `G ∗ F(Qᵢ)` of `G`
with the free group on the variables of its first atoms (Proposition 1).

## Main definitions

* `TauCeti.GroupAlgGeom.GX.sumEquiv`: `G[X ⊕ Y] ≃* G[Y][X]`.
* `TauCeti.GroupAlgGeom.GX.sumComplEquiv`: `G[X] ≃* G[Q][Qᶜ]` for `Q : Set X`.
* `TauCeti.GroupAlgGeom.SystemGroup.sumComplEquiv`: `G_S ≃* G[Q]_S`.

## Main results

* `TauCeti.GroupAlgGeom.GX.eval_sumEquiv_symm`, `TauCeti.GroupAlgGeom.GX.eval_sumComplEquiv_symm`:
  evaluation in two stages.
* `TauCeti.GroupAlgGeom.SystemGroup.sumComplEquiv_mk`,
  `TauCeti.GroupAlgGeom.SystemGroup.sumComplEquiv_symm_mk`: the isomorphism `G_S ≃* G[Q]_S` is the
  reading of words.

## References

* [VAR-I] O. Kharlampovich, A. Myasnikov, *Irreducible affine varieties over a free group. I:
  Irreducibility of quadratic equations and Nullstellensatz*, J. Algebra 200 (1998), §1,
  Proposition 1.
-/

public section

open Monoid.Coprod

namespace TauCeti.GroupAlgGeom

variable {G H X Y : Type*} [Group G] [Group H]

namespace GX

/-! ### `G[X ⊕ Y] ≃* G[Y][X]` -/

section SumEquiv

variable (G X Y) in
/-- The free `G`-group on `X ⊕ Y` is the free `G[Y]`-group on `X`: a coefficient stays a
coefficient, a variable `Sum.inl x` becomes the variable `x`, and a variable `Sum.inr y` becomes
the coefficient `y ∈ G[Y]`. -/
noncomputable def sumEquiv : GX G (X ⊕ Y) ≃* GX (GX G Y) X :=
  MonoidHom.toMulEquiv
    (eval ((inl : GX G Y →* GX (GX G Y) X).comp inl)
      (Sum.elim (fun x => inr (FreeGroup.of x)) fun y => inl (inr (FreeGroup.of y))))
    (eval (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inr)) fun x => inr (FreeGroup.of (.inl x)))
    (hom_ext (MonoidHom.ext fun _ => by simp) (FreeGroup.ext_hom _ _ fun x => by cases x <;> simp))
    (hom_ext (hom_ext (MonoidHom.ext fun _ => by simp) (FreeGroup.ext_hom _ _ fun _ => by simp))
      (FreeGroup.ext_hom _ _ fun _ => by simp))

@[simp]
theorem sumEquiv_inl (g : G) : sumEquiv G X Y (inl g) = inl (inl g) := by
  simp [sumEquiv]

@[simp]
theorem sumEquiv_inr_of_inl (x : X) :
    sumEquiv G X Y (inr (FreeGroup.of (.inl x))) = inr (FreeGroup.of x) := by
  simp [sumEquiv]

@[simp]
theorem sumEquiv_inr_of_inr (y : Y) :
    sumEquiv G X Y (inr (FreeGroup.of (.inr y))) = inl (inr (FreeGroup.of y)) := by
  simp [sumEquiv]

@[simp]
theorem sumEquiv_symm_inl (w : GX G Y) :
    (sumEquiv G X Y).symm (inl w) = Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inr) w := by
  simp [sumEquiv]

@[simp]
theorem sumEquiv_symm_inr_of (x : X) :
    (sumEquiv G X Y).symm (inr (FreeGroup.of x)) = inr (FreeGroup.of (.inl x)) := by
  simp [sumEquiv]

/-- Evaluating at a point `v` the word of `G[X ⊕ Y]` given by a word of `G[Y][X]` evaluates the
latter at `v ∘ Sum.inl`, its coefficients being evaluated at `v ∘ Sum.inr`. -/
@[simp]
theorem eval_sumEquiv_symm (ι : G →* H) (v : X ⊕ Y → H) (w : GX (GX G Y) X) :
    eval ι v ((sumEquiv G X Y).symm w) = eval (eval ι (v ∘ Sum.inr)) (v ∘ Sum.inl) w := by
  induction w using induction_on with
  | inl u => simp
  | inr w => induction w using FreeGroup.induction_on <;> simp_all
  | mul u w hu hw => simp [hu, hw]

end SumEquiv

/-! ### `G[X] ≃* G[Q][Qᶜ]` -/

section SumComplEquiv

variable (G) in
open scoped Classical in
/-- For a set `Q` of variables, `G[X]` is the free `G[Q]`-group on the other variables: a
variable of `Q` becomes a coefficient, a variable `x ∉ Q` stays a variable. -/
noncomputable def sumComplEquiv (Q : Set X) : GX G X ≃* GX (GX G Q) ↥Qᶜ :=
  (renameEquiv G ((Equiv.Set.sumCompl Q).symm.trans (Equiv.sumComm _ _))).trans
    (sumEquiv G (↥Qᶜ) Q)

variable {Q : Set X}

@[simp]
theorem sumComplEquiv_inl (g : G) : sumComplEquiv G Q (inl g) = inl (inl g) := by
  simp [sumComplEquiv]

@[simp]
theorem sumComplEquiv_inr_of_of_mem {x : X} (hx : x ∈ Q) :
    sumComplEquiv G Q (inr (FreeGroup.of x)) = inl (inr (FreeGroup.of ⟨x, hx⟩)) := by
  classical
  simp [sumComplEquiv, Equiv.Set.sumCompl_symm_apply_of_mem hx]

@[simp]
theorem sumComplEquiv_inr_of_of_notMem {x : X} (hx : x ∉ Q) :
    sumComplEquiv G Q (inr (FreeGroup.of x)) = inr (FreeGroup.of ⟨x, hx⟩) := by
  classical
  simp [sumComplEquiv, Equiv.Set.sumCompl_symm_apply_of_notMem hx]

/-- A word in the coefficients and the variables of `Q` is read as a coefficient of `G[Q][Qᶜ]`. -/
@[simp]
theorem sumComplEquiv_map (w : GX G Q) :
    sumComplEquiv G Q (Monoid.Coprod.map (.id G) (FreeGroup.map Subtype.val) w) = inl w := by
  induction w using induction_on with
  | inl g => simp
  | inr w => induction w using FreeGroup.induction_on <;> simp_all
  | mul u w hu hw => simp [hu, hw]

@[simp]
theorem sumComplEquiv_symm_inl (w : GX G Q) :
    (sumComplEquiv G Q).symm (inl w) = Monoid.Coprod.map (.id G) (FreeGroup.map Subtype.val) w := by
  rw [MulEquiv.symm_apply_eq, sumComplEquiv_map]

@[simp]
theorem sumComplEquiv_symm_inr_of (x : ↥Qᶜ) :
    (sumComplEquiv G Q).symm (inr (FreeGroup.of x)) = inr (FreeGroup.of (x : X)) := by
  rw [MulEquiv.symm_apply_eq, sumComplEquiv_inr_of_of_notMem x.property]

/-- Evaluating at a point `v` the word of `G[X]` given by a word of `G[Q][Qᶜ]` evaluates the latter
at the restriction of `v` to `Qᶜ`, its coefficients being evaluated at the restriction of `v` to
`Q`. -/
@[simp]
theorem eval_sumComplEquiv_symm (ι : G →* H) (v : X → H) (w : GX (GX G Q) ↥Qᶜ) :
    eval ι v ((sumComplEquiv G Q).symm w) =
      eval (eval ι fun q : Q => v q) (fun x : ↥Qᶜ => v x) w := by
  induction w using induction_on with
  | inl u => simp [Function.comp_def]
  | inr w => induction w using FreeGroup.induction_on <;> simp_all
  | mul u w hu hw => simp [hu, hw]

end SumComplEquiv

end GX

/-! ### The group of a system read over `G[Q]` -/

namespace SystemGroup

variable (Q : Set X) (S : Set (GX G X))

/-- The group of a system `S` over `G` in the variables `X` is the group of the same system read
over `G[Q]` in the variables `Qᶜ`. -/
noncomputable def sumComplEquiv :
    SystemGroup G S ≃* SystemGroup (GX G Q) (GX.sumComplEquiv G Q '' S) :=
  QuotientGroup.congr _ _ (GX.sumComplEquiv G Q)
    (Subgroup.map_normalClosure _ _ (GX.sumComplEquiv G Q).surjective)

@[simp]
theorem sumComplEquiv_mk (w : GX G X) : sumComplEquiv Q S (w : SystemGroup G S) =
    (GX.sumComplEquiv G Q w : SystemGroup (GX G Q) _) :=
  QuotientGroup.congr_mk _ _ _ _ w

@[simp]
theorem sumComplEquiv_symm_mk (w : GX (GX G Q) ↥Qᶜ) :
    (sumComplEquiv Q S).symm (w : SystemGroup (GX G Q) _) =
      ((GX.sumComplEquiv G Q).symm w : SystemGroup G S) := by
  simp [sumComplEquiv]

/-- The isomorphism `G_S ≃* G[Q]_S` is a `G`-isomorphism. -/
theorem sumComplEquiv_coeff (g : G) : sumComplEquiv Q S (coeff S g) = coeff _ (inl g) := by
  simp

end SystemGroup

end TauCeti.GroupAlgGeom
