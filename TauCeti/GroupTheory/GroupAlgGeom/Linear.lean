/-!
# Linear groups are equationally Noetherian

Let `R` be a commutative Noetherian ring. Every subgroup of `GL n R`, and more generally every
group `H` with an injective homomorphism into `GL n R`, is equationally Noetherian over any
coefficients `ι : G →* H`: every system of equations in finitely many variables over `G` has a
finite subsystem with the same solutions in `H`. This is Theorem B1 of Baumslag, Myasnikov and
Remeslennikov, going back to Bryant and to Guba. Since free groups of finite rank embed in
`SL 2 ℤ`, it is the route to the equational Noetherianity of free groups of finite rank.

## Main results

* `TauCeti.GroupAlgGeom.isEquationallyNoetherian_generalLinearGroup`: `GL n R` is equationally
  Noetherian over any coefficients.
* `TauCeti.GroupAlgGeom.isEquationallyNoetherian_of_injective_generalLinearGroup`: so is every
  group with an injective homomorphism into `GL n R`.
* `TauCeti.GroupAlgGeom.isEquationallyNoetherian_specialLinearGroup`: in particular so is
  `SL n R`.

## Implementation notes

The proof turns equations over `GL n R` into polynomial equations over `R`. Fix a finite type of
variables `X`. The coordinate ring of `(GL n)^X` is the quotient `B` of the polynomial ring over
`R` in the entries of two matrices `Mₓ` and `Nₓ` per variable `x` by the entries of
`Mₓ Nₓ - 1`. It is Noetherian by the Hilbert basis theorem, and the images of the `Mₓ` are
invertible matrices over `B`. Evaluating an equation `w` at this generic point gives an
invertible matrix `w(M)` over `B`. A point `v : X → GL n R` specializes `B` to `R`, and
`w(v) = 1` exactly when the specialization kills the entries of `w(M) - 1`. The ideal generated
by these entries for all `w ∈ S` is finitely generated, so finitely many equations of `S`
already generate it, and they form the required finite subsystem.

## References

* G. Baumslag, A. Myasnikov, V. Remeslennikov, *Algebraic geometry over groups I. Algebraic sets
  and ideal theory*, J. Algebra 219 (1999), §2.2, Theorem B1.
* R. M. Bryant, *The verbal topology of a group*, J. Algebra 48 (1977).
* V. Guba, *Equivalence of infinite systems of equations in free groups and semigroups to finite
  subsystems*, Mat. Zametki 40 (1986).
-/

public section

namespace TauCeti.GroupAlgGeom

open Matrix

variable {G H X : Type*} [Group G] [Group H]

/-- If the equations `w` over `G` are recorded by sets `ψ w` in a Noetherian ring, in such a way
that the solutions of `w` are the points whose ideal contains `ψ w`, then every system `S` is
equivalent to a finite subsystem. Among the ideals generated by the sets `ψ w` for `w` in finite
subsystems of `S`, a maximal one already contains every `ψ w` with `w ∈ S`. -/
private theorem exists_finite_V_eq_of_isNoetherianRing {ι : G →* H} {B : Type*} [CommRing B]
    [IsNoetherianRing B] (ψ : GX G X → Set B)
    (hψ : ∀ v : X → H, ∃ J : Ideal B, ∀ w, eval ι v w = 1 ↔ ψ w ⊆ J) (S : Set (GX G X)) :
    ∃ S₀ ⊆ S, S₀.Finite ∧ V ι S₀ = V ι S := by
  -- The ideal generated by the equations of a subsystem `T`.
  let gen (T : Set (GX G X)) : Ideal B := ⨆ w ∈ T, Ideal.span (ψ w)
  obtain ⟨_, ⟨T, ⟨hTS, hT⟩, rfl⟩, hmax⟩ := set_has_maximal_iff_noetherian.2 inferInstance
    (gen '' {T | T ⊆ S ∧ T.Finite})
    ⟨_, Set.mem_image_of_mem _ ⟨Set.empty_subset S, Set.finite_empty⟩⟩
  refine ⟨T, hTS, hT, (V_antitone ι hTS).antisymm' fun v hv => mem_V.2 fun w hw => ?_⟩
  obtain ⟨J, hJ⟩ := hψ v
  -- By maximality, adding `w` to `T` does not enlarge the ideal.
  have heq : gen (insert w T) = gen T := by
    by_contra hne
    exact hmax _ ⟨insert w T, ⟨Set.insert_subset hw hTS, hT.insert w⟩, rfl⟩
      (lt_of_le_of_ne (biSup_mono fun u hu => Set.mem_insert_of_mem w hu) (Ne.symm hne))
  refine (hJ w).2 (Ideal.span_le.1 ?_)
  calc Ideal.span (ψ w) ≤ gen (insert w T) :=
        le_biSup (fun u => Ideal.span (ψ u)) (Set.mem_insert w T)
    _ = gen T := heq
    _ ≤ J := iSup₂_le fun u hu => Ideal.span_le.2 ((hJ u).1 (mem_V.1 hv u hu))

/-! ### The generic point of `(GL n)^X` -/

section Generic

variable (R n X : Type*) [CommRing R] [Fintype n] [DecidableEq n]

/-- The generic matrix with entries the variables `(b, x, i, j)`. Those with `b = true` are the
entries of a point of `(GL n)^X` and those with `b = false` the entries of its inverse. -/
private noncomputable abbrev genMatrix (b : Bool) (x : X) :
    Matrix n n (MvPolynomial (Bool × X × n × n) R) :=
  of fun i j => MvPolynomial.X (b, x, i, j)

/-- The ideal of relations of the coordinate ring of `(GL n)^X`, generated by the entries of
`Mₓ Nₓ - 1`, for the generic matrices `Mₓ` and `Nₓ`. -/
private noncomputable abbrev relIdeal : Ideal (MvPolynomial (Bool × X × n × n) R) :=
  Ideal.span (Set.range fun p : X × n × n =>
    (genMatrix R n X true p.1 * genMatrix R n X false p.1 - 1) p.2.1 p.2.2)

/-- The coordinate ring of `(GL n)^X`. -/
private abbrev CoordRing : Type _ :=
  MvPolynomial (Bool × X × n × n) R ⧸ relIdeal R n X

/-- The generic point of `(GL n)^X`, with coordinates in its coordinate ring. -/
private noncomputable def genPoint (x : X) : GL n (CoordRing R n X) :=
  have h : (Ideal.Quotient.mk _).mapMatrix (genMatrix R n X true x) *
      (Ideal.Quotient.mk _).mapMatrix (genMatrix R n X false x) = 1 := by
    rw [← sub_eq_zero, ← map_mul, ← map_one (Ideal.Quotient.mk (relIdeal R n X)).mapMatrix,
      ← map_sub]
    ext i j
    exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨(x, i, j), rfl⟩)
  ⟨_, _, h, mul_eq_one_comm.1 h⟩

variable {R n X}

/-- The coordinates of a point `v : X → GL n R`: the variable `(b, x, i, j)` is the entry `(i, j)`
of `v x` if `b = true`, and of its inverse if `b = false`. -/
private def coords (v : X → GL n R) (s : Bool × X × n × n) : R :=
  ((cond s.1 (v s.2.1) (v s.2.1)⁻¹ : GL n R) : Matrix n n R) s.2.2.1 s.2.2.2

/-- Evaluating the generic matrices at the coordinates of `v` gives `v x` and its inverse. -/
private theorem mapMatrix_eval_coords_genMatrix (v : X → GL n R) (b : Bool) (x : X) :
    (MvPolynomial.eval (coords v)).mapMatrix (genMatrix R n X b x) =
      ((cond b (v x) (v x)⁻¹ : GL n R) : Matrix n n R) := by
  ext
  simp [coords]

/-- The relations of the coordinate ring of `(GL n)^X` vanish at every point. -/
private theorem relIdeal_le_ker (v : X → GL n R) :
    relIdeal R n X ≤ RingHom.ker (MvPolynomial.eval (coords v)) := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨x, i, j⟩, rfl⟩
  have key : (MvPolynomial.eval (coords v)).mapMatrix
      (genMatrix R n X true x * genMatrix R n X false x - 1) = 0 := by
    rw [map_sub, map_mul, map_one, mapMatrix_eval_coords_genMatrix,
      mapMatrix_eval_coords_genMatrix]
    simp
  simpa using congrFun₂ key i j

/-- The specialization of the coordinate ring of `(GL n)^X` at a point `v : X → GL n R`, which
sends the generic point to `v`. -/
private noncomputable def specialize (v : X → GL n R) : CoordRing R n X →+* R :=
  Ideal.Quotient.lift _ (MvPolynomial.eval (coords v)) fun _ ha =>
    RingHom.mem_ker.1 (relIdeal_le_ker v ha)

/-- The specialization at `v` evaluates polynomials at the coordinates of `v`. -/
private theorem specialize_mk (v : X → GL n R) (p : MvPolynomial (Bool × X × n × n) R) :
    specialize v (Ideal.Quotient.mk _ p) = MvPolynomial.eval (coords v) p :=
  Ideal.Quotient.lift_mk _ _ _

/-- Specializing the generic point at `v` gives `v`. -/
private theorem map_specialize_comp_eval (ι : G →* GL n R) (v : X → GL n R) :
    (GeneralLinearGroup.map (specialize v)).comp
        (eval ((GeneralLinearGroup.map (algebraMap R (CoordRing R n X))).comp ι)
          (genPoint R n X)) = eval ι v := by
  rw [MonoidHom.comp_eval, ← MonoidHom.comp_assoc, ← GeneralLinearGroup.map_comp]
  have hR : (specialize v).comp (algebraMap R (CoordRing R n X)) = RingHom.id R := by
    ext r
    rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, specialize_mk,
      MvPolynomial.algebraMap_eq, MvPolynomial.eval_C, RingHom.id_apply]
  have hv : GeneralLinearGroup.map (specialize v) ∘ genPoint R n X = v := by
    ext x i j
    simp [genPoint, specialize_mk, coords]
  rw [hR, GeneralLinearGroup.map_id, MonoidHom.id_comp, hv]

end Generic

/-! ### Linear groups -/

variable {R n : Type*} [CommRing R] [IsNoetherianRing R] [Fintype n] [DecidableEq n]

/-- **Linear groups are equationally Noetherian.** Over a commutative Noetherian ring `R`, the
general linear group `GL n R` is equationally Noetherian over any coefficients: every system of
equations in finitely many variables has a finite subsystem with the same solutions in
`GL n R`. -/
theorem isEquationallyNoetherian_generalLinearGroup (ι : G →* GL n R) :
    IsEquationallyNoetherian ι := by
  refine isEquationallyNoetherian_iff.2 fun (Y : Type) _ S => ?_
  -- Evaluation at the generic point, and the entries of `w(M) - 1`.
  let Φ := eval ((GeneralLinearGroup.map (algebraMap R (CoordRing R n Y))).comp ι)
    (genPoint R n Y)
  refine exists_finite_V_eq_of_isNoetherianRing
    (fun w => Set.range fun p : n × n => (↑(Φ w) - 1 : Matrix n n (CoordRing R n Y)) p.1 p.2)
    (fun v => ⟨RingHom.ker (specialize v), fun w => ?_⟩) S
  rw [← map_specialize_comp_eval ι v, MonoidHom.comp_apply, ← Units.val_eq_one, ← Matrix.ext_iff,
    Set.range_subset_iff, Prod.forall]
  refine forall₂_congr fun i j => ?_
  dsimp only
  rw [GeneralLinearGroup.map_apply, SetLike.mem_coe, RingHom.mem_ker, Matrix.sub_apply, map_sub,
    sub_eq_zero]
  rcases eq_or_ne i j with rfl | h <;> simp [Φ, *]

/-- A group with an injective homomorphism into `GL n R`, for a commutative Noetherian ring `R`,
is equationally Noetherian over any coefficients. -/
theorem isEquationallyNoetherian_of_injective_generalLinearGroup (ι : G →* H)
    (ρ : H →* GL n R) (hρ : Function.Injective ρ) : IsEquationallyNoetherian ι :=
  (isEquationallyNoetherian_generalLinearGroup (ρ.comp ι)).of_injective ⟨ρ, fun _ => rfl⟩ hρ

/-- Over a commutative Noetherian ring `R`, the special linear group `SL n R` is equationally
Noetherian over any coefficients. -/
theorem isEquationallyNoetherian_specialLinearGroup (ι : G →* SpecialLinearGroup n R) :
    IsEquationallyNoetherian ι :=
  isEquationallyNoetherian_of_injective_generalLinearGroup ι SpecialLinearGroup.toGL
    SpecialLinearGroup.toGL_injective

end TauCeti.GroupAlgGeom
