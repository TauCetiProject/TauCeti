module

public import Mathlib.GroupTheory.Index
import TauCeti.Algebra.Group.Subgroup.ZPowers
import TauCeti.GroupTheory.SpecificGroups.Cyclic.Index

/-!
# The index of adjoining one normalizing element

The index of a subgroup in the subgroup generated by it and one normalizing element is the
period of that element modulo the original subgroup.
-/

public section

namespace Subgroup

variable {G : Type*} [Group G]

/-- The index after adjoining a normalizing element with a positive power in `H` equals
its least positive exponent taking it into `H`. -/
@[to_additive /-- The index after adjoining a normalizing element with a positive multiple
in `H` equals its least positive multiple taking it into `H`. -/]
theorem relIndex_sup_zpowers_eq_of_isLeast_pow_mem (H : Subgroup G) {z : G}
    (hz : z ∈ normalizer (H : Set G)) {n : ℕ}
    (hn : IsLeast {i : ℕ | 0 < i ∧ z ^ i ∈ H} n) : H.relIndex (H ⊔ zpowers z) = n := by
  have hdiv : H.relIndex (zpowers z) ∣ n :=
    (pow_mem_iff_index_dvd (H.subgroupOf (zpowers z)) (zpowers_mk_self_eq_top z) n).mp hn.1.2
  have : H.IsFiniteRelIndex (zpowers z) := ⟨fun hi ↦ hn.1.1.ne' (by simpa [hi] using hdiv)⟩
  let L := H ⊔ zpowers z
  have hH : H ≤ L := le_sup_left
  have hZ : zpowers z ≤ L := le_sup_right
  have hL : L ≤ normalizer (H : Set G) := sup_le le_normalizer (zpowers_le.mpr hz)
  have : (H.subgroupOf L).Normal := normal_subgroupOf_of_le_normalizer hL
  have hindex := relIndex_sup_left ((zpowers z).subgroupOf L) (H.subgroupOf L)
  rw [← subgroupOf_sup hH hZ, subgroupOf_self, relIndex_top_right, relIndex_subgroupOf hZ] at hindex
  exact hindex.trans ((isLeast_pow_mem_relIndex_zpowers z H).unique hn)

end Subgroup
