module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The range of a homomorphism into a cyclic group

The range of a homomorphism `f : G →* H` into a cyclic group is cyclic, so it is generated by
some value `f g`. For instance, a degree map `W →* Multiplicative ℤ` takes a Frobenius element
to a generator of its image.

## Main results

* `MonoidHom.exists_range_eq_zpowers`: the range is generated by some value of `f`.
-/

public section

namespace MonoidHom

/-- The range of a homomorphism into a cyclic group is generated by one of its values. -/
theorem exists_range_eq_zpowers {G H : Type*} [Group G] [Group H] [IsCyclic H] (f : G →* H) :
    ∃ g : G, f.range = Subgroup.zpowers (f g) := by
  obtain ⟨⟨_, g, rfl⟩, hg⟩ := IsCyclic.exists_generator (α := f.range)
  refine ⟨g, le_antisymm (fun x hx ↦ ?_) (Subgroup.zpowers_le.mpr ⟨g, rfl⟩)⟩
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hg ⟨x, hx⟩)
  exact Subgroup.mem_zpowers_iff.mpr ⟨k, congrArg Subtype.val hk⟩

end MonoidHom
