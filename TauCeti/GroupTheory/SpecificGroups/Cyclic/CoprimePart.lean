module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import TauCeti.GroupTheory.OrderOfElement.PPart
-- Non-public: `Subgroup.isLeast_pow_mem_relIndex_zpowers` converts the relative index computed
-- below into the membership `g ^ ordProj[p] (orderOf g) ∈ ⟨pFreePart p g⟩`, and nothing about
-- least elements survives into a statement here.
import TauCeti.GroupTheory.SpecificGroups.Cyclic.Index

/-!
# The `p`-free part of a cyclic group

Let `g` be an element of finite order `m` in a group, and `p` a prime. Write
`m = ordProj[p] m * ordCompl[p] m` for the factorisation of `m` into its `p`-power part and its
`p`-free part. Inside the cyclic group `⟨g⟩` the subgroup generated by the `p`-free part
`TauCeti.pFreePart p g` of `g` then has order `ordCompl[p] m`, hence order prime to `p` and index
`ordProj[p] m`, and it absorbs `ordProj[p] m`-th powers, so every element of `⟨g⟩` has a `p`-power
power inside it. It is the `p`-complement of `⟨g⟩`, which exists because a cyclic group is abelian
and so has a Hall subgroup for every set of primes; no general Hall theory is used here, the
generator making the subgroup explicit.

The subgroup is intrinsic to `⟨g⟩`: it consists of the elements of `⟨g⟩` whose order is prime to
`p`, so it does not depend on the chosen generator, and it is equally generated by
`g ^ ordProj[p] m`. For a finite cyclic subgroup `C` of a group the properties combine into the
single existence statement `TauCeti.exists_coprimePart_of_isCyclic`: `C` has a normal subgroup `D`
of order prime to `p` with `C / D` of `p`-power exponent, which is how the `p`-part of a cyclic
subgroup is stripped off inside a sum over the cyclic subgroups of a finite group.

## Main results

* `TauCeti.natCard_zpowers_pFreePart`: the subgroup generated by the `p`-free part of `g` has
  order `ordCompl[p] (orderOf g)`, and `TauCeti.not_dvd_natCard_zpowers_pFreePart`: that order is
  prime to `p`.
* `TauCeti.relIndex_zpowers_pFreePart`: its index in `⟨g⟩` is `ordProj[p] (orderOf g)`.
* `TauCeti.pow_ordProj_mem_zpowers_pFreePart_of_mem_zpowers`: raising any element of `⟨g⟩` to the
  power `ordProj[p] (orderOf g)` lands in it, so the quotient has `p`-power exponent.
* `TauCeti.zpowers_pFreePart_eq_zpowers_pow_ordProj`: it is generated by
  `g ^ ordProj[p] (orderOf g)`.
* `TauCeti.mem_zpowers_pFreePart_iff`: it consists exactly of the elements of `⟨g⟩` of order
  prime to `p`.
* `TauCeti.exists_coprimePart_of_isCyclic`: **the `p`-free part of a cyclic subgroup**, the four
  properties together, for a finite cyclic subgroup of a group.

## References

* J. Neukirch, A. Schmidt, K. Wingberg, *Cohomology of Number Fields*, 2nd ed., Springer (2008),
  (7.3.4), where the assembled statement is the group-theoretic input to the modular Artin
  induction theorem.
-/

public section

namespace TauCeti

open Subgroup

variable {G : Type*} [Group G] {p : ℕ} {g : G}

/-- The subgroup generated by the `p`-free part of `g` sits inside the one generated by `g`,
because the `p`-free part is a power of `g`. -/
theorem zpowers_pFreePart_le (p : ℕ) (g : G) :
    zpowers (pFreePart p g) ≤ zpowers g :=
  zpowers_le.mpr (pFreePart_mem_zpowers p g)

/-- **The order of the `p`-free part subgroup.** For an element of finite order it is the
`p`-free part `ordCompl[p] (orderOf g)` of the order of `g`. -/
theorem natCard_zpowers_pFreePart (hp : p.Prime) (hg : orderOf g ≠ 0) :
    Nat.card (zpowers (pFreePart p g)) = ordCompl[p] (orderOf g) := by
  rw [Nat.card_zpowers, orderOf_pFreePart hp hg]

/-- **The `p`-free part subgroup has order prime to `p`.** -/
theorem not_dvd_natCard_zpowers_pFreePart (hp : p.Prime) (hg : orderOf g ≠ 0) :
    ¬ p ∣ Nat.card (zpowers (pFreePart p g)) := by
  rw [natCard_zpowers_pFreePart hp hg]
  exact Nat.not_dvd_ordCompl hp hg

/-- **The index of the `p`-free part subgroup in `⟨g⟩`** is the `p`-power part
`ordProj[p] (orderOf g)` of the order of `g`: the two factors of `orderOf g` are the order of the
subgroup and its index. -/
@[simp]
theorem relIndex_zpowers_pFreePart (hp : p.Prime) (hg : orderOf g ≠ 0) :
    (zpowers (pFreePart p g)).relIndex (zpowers g) = ordProj[p] (orderOf g) := by
  have hmul := Subgroup.relIndex_mul_card (H := zpowers (pFreePart p g)) (K := zpowers g)
  rw [inf_eq_left.mpr (zpowers_pFreePart_le p g), natCard_zpowers_pFreePart hp hg,
    Nat.card_zpowers] at hmul
  exact Nat.eq_of_mul_eq_mul_right (Nat.ordCompl_pos p hg)
    (hmul.trans (Nat.ordProj_mul_ordCompl_eq_self (orderOf g) p).symm)

/-- **The `p`-free part subgroup absorbs `ordProj[p] (orderOf g)`-th powers of `g`.** Raising `g`
to the `p`-power part of its order lands in the subgroup generated by the `p`-free part of `g`. -/
theorem pow_ordProj_mem_zpowers_pFreePart (hp : p.Prime) (hg : orderOf g ≠ 0) :
    g ^ ordProj[p] (orderOf g) ∈ zpowers (pFreePart p g) := by
  have hrel := relIndex_zpowers_pFreePart hp hg
  have : (zpowers (pFreePart p g)).IsFiniteRelIndex (zpowers g) :=
    ⟨by rw [hrel]; exact (Nat.ordProj_pos (orderOf g) p).ne'⟩
  have hmem := (Subgroup.isLeast_pow_mem_relIndex_zpowers g (zpowers (pFreePart p g))).1.2
  rwa [hrel] at hmem

/-- **The quotient of `⟨g⟩` by its `p`-free part has `p`-power exponent.** Every element of `⟨g⟩`
raised to the power `ordProj[p] (orderOf g)` lies in the subgroup generated by the `p`-free part
of `g`. -/
theorem pow_ordProj_mem_zpowers_pFreePart_of_mem_zpowers (hp : p.Prime) (hg : orderOf g ≠ 0)
    {c : G} (hc : c ∈ zpowers g) :
    c ^ ordProj[p] (orderOf g) ∈ zpowers (pFreePart p g) := by
  obtain ⟨k, rfl⟩ := hc
  rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast]
  exact zpow_mem (pow_ordProj_mem_zpowers_pFreePart hp hg) k

/-- **The `p`-free part subgroup is generated by `g ^ ordProj[p] (orderOf g)`.** The `p`-free part
of `g` and the `ordProj[p] (orderOf g)`-th power of `g` generate the same subgroup, so either
spelling of the `p`-complement of `⟨g⟩` may be used. -/
theorem zpowers_pFreePart_eq_zpowers_pow_ordProj (hp : p.Prime) (hg : orderOf g ≠ 0) :
    zpowers (pFreePart p g) = zpowers (g ^ ordProj[p] (orderOf g)) := by
  have hle : zpowers (g ^ ordProj[p] (orderOf g)) ≤ zpowers (pFreePart p g) :=
    zpowers_le.mpr (pow_ordProj_mem_zpowers_pFreePart hp hg)
  have hcard : Nat.card (zpowers (g ^ ordProj[p] (orderOf g))) = ordCompl[p] (orderOf g) := by
    rw [Nat.card_zpowers, orderOf_pow_of_dvd (Nat.ordProj_pos (orderOf g) p).ne'
      (Nat.ordProj_dvd (orderOf g) p)]
  have hmul := Subgroup.relIndex_mul_card (H := zpowers (g ^ ordProj[p] (orderOf g)))
    (K := zpowers (pFreePart p g))
  rw [inf_eq_left.mpr hle, hcard, natCard_zpowers_pFreePart hp hg] at hmul
  refine le_antisymm (Subgroup.relIndex_eq_one.mp ?_) hle
  exact Nat.eq_of_mul_eq_mul_right (Nat.ordCompl_pos p hg) (hmul.trans (one_mul _).symm)

/-- **The `p`-free part subgroup is exactly the set of `p`-free elements of `⟨g⟩`.** An element
of `⟨g⟩` lies in it precisely when its order is prime to `p`, so the subgroup is intrinsic to
`⟨g⟩` and does not depend on the chosen generator. -/
@[simp]
theorem mem_zpowers_pFreePart_iff (hp : p.Prime) (hg : orderOf g ≠ 0) {x : G} :
    x ∈ zpowers (pFreePart p g) ↔ x ∈ zpowers g ∧ ¬ p ∣ orderOf x := by
  refine ⟨fun hx => ⟨zpowers_pFreePart_le p g hx, fun hdvd => ?_⟩, fun ⟨hxg, hx⟩ => ?_⟩
  · have hdvd' : orderOf x ∣ Nat.card (zpowers (pFreePart p g)) := by
      simpa using orderOf_dvd_natCard (⟨x, hx⟩ : zpowers (pFreePart p g))
    exact not_dvd_natCard_zpowers_pFreePart hp hg (hdvd.trans hdvd')
  · have hcop : Nat.Coprime (ordProj[p] (orderOf g)) (orderOf x) :=
      Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hp).mpr hx)
    exact zpowers_le.mpr (pow_ordProj_mem_zpowers_pFreePart_of_mem_zpowers hp hg hxg)
      (mem_zpowers_pow_iff.mpr hcop)

/-- **The `p`-free part of a cyclic subgroup.** A finite cyclic subgroup `C` of a group has a
subgroup `D` which is normal in `C`, has order prime to `p`, has relative index the `p`-power part
of `|C|`, and contains a `p`-power power of every element of `C`; concretely `D` is the subgroup
generated by the `p`-free part (`TauCeti.pFreePart`) of a generator of `C`. -/
theorem exists_coprimePart_of_isCyclic (hp : p.Prime) {C : Subgroup G} [Finite C] [IsCyclic C] :
    ∃ D : Subgroup G, D ≤ C ∧ (D.subgroupOf C).Normal ∧ ¬ p ∣ Nat.card D ∧
      (∀ c ∈ C, ∃ n : ℕ, c ^ p ^ n ∈ D) ∧ D.relIndex C = ordProj[p] (Nat.card C) := by
  obtain ⟨x, rfl⟩ : ∃ x : G, C = zpowers x := by
    obtain ⟨a, ha⟩ := isCyclic_iff_exists_zpowers_eq_top.mp (inferInstance : IsCyclic C)
    refine ⟨(a : G), le_antisymm (fun y hy => ?_) (zpowers_le.mpr a.2)⟩
    obtain ⟨k, hk⟩ := mem_zpowers_iff.mp (ha ▸ Subgroup.mem_top (⟨y, hy⟩ : C))
    exact ⟨k, by simpa using congrArg Subtype.val hk⟩
  have horder : orderOf x ≠ 0 := orderOf_ne_zero_iff.mpr (finite_zpowers.mp inferInstance)
  refine ⟨zpowers (pFreePart p x), zpowers_pFreePart_le p x, inferInstance,
    not_dvd_natCard_zpowers_pFreePart hp horder, fun c hc => ⟨(orderOf x).factorization p, ?_⟩, ?_⟩
  · exact pow_ordProj_mem_zpowers_pFreePart_of_mem_zpowers hp horder hc
  · rw [Nat.card_zpowers]
    exact relIndex_zpowers_pFreePart hp horder

end TauCeti
