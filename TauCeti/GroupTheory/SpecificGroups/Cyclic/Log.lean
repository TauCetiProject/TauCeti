module

public import Mathlib.GroupTheory.OrderOfElement

/-!
# Exponents with respect to a generator of a finite cyclic group

For a finite group `G` generated by `g`, every `x : G` is `g ^ i` for a unique `i < orderOf g`.
This file names that exponent and records how it interacts with powers, products and
homomorphisms of cyclic groups.

## Main definitions

* `TauCeti.cyclicLog g hg x`: the unique `i < orderOf g` with `g ^ i = x`.

## Main results

* `TauCeti.pow_cyclicLog`, `TauCeti.cyclicLog_lt`: the defining properties of `cyclicLog`.
* `TauCeti.cyclicLog_pow`: the exponent of `g ^ i` is `i % orderOf g`.
* `TauCeti.cyclicLog_mul`: exponents add modulo `orderOf g`.
* `TauCeti.cyclicLog_map`: a homomorphism sending `g` to `g' ^ d` multiplies exponents by `d`.
-/

public section

namespace TauCeti

variable {G : Type*} [Group G] [Finite G] (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)

/-- The exponent of `x` with respect to the generator `g` of a finite group: the unique
`i < orderOf g` with `g ^ i = x`. -/
noncomputable def cyclicLog (x : G) : ℕ :=
  ((finEquivZPowers (isOfFinOrder_of_finite g)).symm ⟨x, hg x⟩ : ℕ)

/-- `cyclicLog g hg x` is an exponent of `g` giving `x`. -/
@[simp]
theorem pow_cyclicLog (x : G) : g ^ cyclicLog g hg x = x :=
  pow_finEquivZPowers_symm_apply (isOfFinOrder_of_finite g) ⟨x, hg x⟩

/-- `cyclicLog g hg x` is reduced modulo the order of `g`. -/
theorem cyclicLog_lt (x : G) : cyclicLog g hg x < orderOf g :=
  ((finEquivZPowers (isOfFinOrder_of_finite g)).symm ⟨x, hg x⟩).2

/-- The exponent of `g ^ i` is `i` reduced modulo the order of `g`. -/
@[simp]
theorem cyclicLog_pow (i : ℕ) : cyclicLog g hg (g ^ i) = i % orderOf g :=
  congrArg Fin.val (finEquivZPowers_symm_apply (isOfFinOrder_of_finite g) i)

/-- Exponents with respect to `g` add modulo the order of `g`. -/
theorem cyclicLog_mul (x y : G) :
    cyclicLog g hg (x * y) = (cyclicLog g hg x + cyclicLog g hg y) % orderOf g := by
  rw [← cyclicLog_pow, pow_add, pow_cyclicLog, pow_cyclicLog]

/-- A homomorphism of finite cyclic groups sending the generator `g` to `g' ^ d` multiplies
exponents by `d`, modulo the order of `g'`. -/
theorem cyclicLog_map {G' : Type*} [Group G'] [Finite G'] (f : G →* G') {g' : G'}
    (hg' : ∀ x, x ∈ Subgroup.zpowers g') {d : ℕ} (hfg : f g = g' ^ d) (x : G) :
    cyclicLog g' hg' (f x) = d * cyclicLog g hg x % orderOf g' := by
  rw [← cyclicLog_pow, pow_mul, ← hfg, ← map_pow, pow_cyclicLog]

end TauCeti
