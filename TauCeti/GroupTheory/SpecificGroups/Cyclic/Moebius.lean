/-!
# Möbius inversion over the subgroups of a finite cyclic group

In a finite cyclic group the index is a bijection from the subgroups onto the divisors of the
order, and the subgroups above a fixed `H` are exactly those whose index divides the index of `H`.
Summing the number-theoretic Möbius function of the index over those subgroups is therefore the
divisor sum `∑_{e ∣ [Z : H]} μ e`, which is `1` when `H = ⊤` and `0` otherwise.

This is the only arithmetic input to Artin's induction identity: the Artin coefficient of a
subgroup is a Möbius sum over the cyclic subgroups above it, and the identity comes from summing
that coefficient over the subgroups containing a fixed element.  Because the coefficient is
indexed by *relative* index, the statement is recorded twice, once inside a cyclic group and once
for a cyclic subgroup `D` of an arbitrary finite group, where the relative index
`Subgroup.relIndex C D` is the index of `C.subgroupOf D`.

Neither statement asks for a chosen generator, so both are usable as stated; the generator enters
only in the proof, where it produces the subgroup of each prescribed index.

## Main results

* `Subgroup.index_zpowers_pow_of_dvd`: in a group generated by `g`, the subgroup generated by
  `g ^ n` has index `n` whenever `n` divides the order of `g`.
* `TauCeti.sum_moebius_index_of_le`: in a finite cyclic group,
  `∑_{H ≤ C} μ [Z : C] = if H = ⊤ then 1 else 0`.
* `TauCeti.sum_moebius_relIndex_of_le`: the same sum inside a cyclic subgroup `D` of a finite
  group, with the relative index and with `⊤` replaced by `D`.

## References

* J.-P. Serre, *Linear Representations of Finite Groups*, Springer GTM 42 (1977), Section 9.2.
-/

public section

namespace Subgroup

variable {G : Type*} [Group G] {g : G}

/-- **The subgroup generated by `g ^ n` has index `n`** when `g` generates the ambient group and
`n` divides the order of `g`.  This is the surjectivity half of the correspondence between the
subgroups of a finite cyclic group and the divisors of its order: Mathlib's
`IsCyclic.subgroup_eq_iff_index_eq` supplies injectivity. -/
@[to_additive /-- **The subgroup generated by `n • g` has index `n`** when `g` generates the ambient
additive group and `n` divides the additive order of `g`. -/]
theorem index_zpowers_pow_of_dvd (hg : zpowers g = ⊤) {n : ℕ} (hn : n ∣ orderOf g) :
    (zpowers (g ^ n)).index = n := by
  have h := Subgroup.index_zpowers_zpow hg (n : ℤ)
  rw [zpow_natCast] at h
  rw [h]
  simp [Int.gcd_natCast_natCast, Nat.gcd_eq_left hn]

end Subgroup

namespace TauCeti

open ArithmeticFunction

/-- The divisor sum of the Möbius function, read off `ArithmeticFunction.moebius_mul_coe_zeta`. -/
private theorem sum_divisors_moebius (n : ℕ) :
    ∑ d ∈ n.divisors, moebius d = if n = 1 then 1 else 0 := by
  have h := congrArg (fun f : ArithmeticFunction ℤ => f n) moebius_mul_coe_zeta
  simpa only [coe_mul_zeta_apply, one_apply] using h

section Cyclic

variable {Z : Type*} [Group Z] [Finite Z] [IsCyclic Z]

open scoped Classical in
/-- **Möbius inversion over the subgroups of a finite cyclic group.**  Summing `μ` of the index
over the subgroups containing `H` gives `1` exactly when `H` is the whole group.

The index is a bijection from the subgroups of a finite cyclic group onto the divisors of its
order, carrying `{C | H ≤ C}` onto the divisors of `[Z : H]`, so the sum is the divisor sum
`∑_{e ∣ [Z : H]} μ e`. -/
theorem sum_moebius_index_of_le (H : Subgroup Z) :
    ∑ᶠ (C : Subgroup Z) (_ : H ≤ C), moebius C.index = if H = ⊤ then 1 else 0 := by
  have _ : Fintype Z := Fintype.ofFinite Z
  obtain ⟨g, hgord⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := Z)
  have hg : Subgroup.zpowers g = ⊤ := by
    rw [← Subgroup.card_eq_iff_eq_top, Nat.card_zpowers, hgord]
  have hHne : H.index ≠ 0 := Subgroup.index_ne_zero_of_finite
  -- the subgroup of prescribed index, available for every divisor of `[Z : H]`
  set F : ℕ → Subgroup Z := fun e => Subgroup.zpowers (g ^ e)
  have hFindex {e : ℕ} (he : e ∣ H.index) : (F e).index = e :=
    Subgroup.index_zpowers_pow_of_dvd hg (he.trans (hgord ▸ H.index_dvd_card))
  have himage : Finset.univ.filter (fun C : Subgroup Z => H ≤ C) =
      (H.index).divisors.image F := by
    ext C
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image, Nat.mem_divisors]
    constructor
    · intro hHC
      have hdvd : C.index ∣ H.index := IsCyclic.subgroup_le_iff_index_dvd.mp hHC
      exact ⟨C.index, ⟨hdvd, hHne⟩,
        (IsCyclic.subgroup_eq_iff_index_eq.mpr (hFindex hdvd).symm).symm⟩
    · rintro ⟨e, ⟨he, -⟩, rfl⟩
      exact IsCyclic.subgroup_le_iff_index_dvd.mpr (by rw [hFindex he]; exact he)
  have hinj : ∀ e ∈ (H.index).divisors, ∀ e' ∈ (H.index).divisors, F e = F e' → e = e' := by
    intro e he e' he' h
    rw [Nat.mem_divisors] at he he'
    rw [← hFindex he.1, ← hFindex he'.1, h]
  rw [finsum_cond_eq_sum_of_cond_iff (t := Finset.univ.filter fun C : Subgroup Z => H ≤ C) _
      fun _ => by simp, himage, Finset.sum_image hinj,
    Finset.sum_congr rfl fun e he => by rw [hFindex (Nat.mem_divisors.mp he).1],
    sum_divisors_moebius]
  simp only [Subgroup.index_eq_one]

end Cyclic

section RelativeCyclic

variable {G : Type*} [Group G] [Finite G] {D H : Subgroup G}

open scoped Classical in
/-- **Möbius inversion over the subgroups of a cyclic subgroup.**  For a cyclic subgroup `D` of a
finite group and `H ≤ D`, summing `μ` of the relative index `Subgroup.relIndex C D` over the
subgroups `C` between `H` and `D` gives `1` exactly when `H = D`.

This is `TauCeti.sum_moebius_index_of_le` for the group `↥D`, transported along the
subgroup-of-a-subgroup correspondence, under which the relative index of `C` in `D` is the index
of `C.subgroupOf D`. -/
theorem sum_moebius_relIndex_of_le [IsCyclic D] (hHD : H ≤ D) :
    ∑ᶠ (C : Subgroup G) (_ : H ≤ C ∧ C ≤ D), moebius (C.relIndex D) =
      if H = D then 1 else 0 := by
  have _ : Fintype G := Fintype.ofFinite G
  have _ : Fintype D := Fintype.ofFinite D
  have htop : (H.subgroupOf D = ⊤) ↔ (H = D) := by
    rw [Subgroup.subgroupOf_eq_top]
    exact ⟨fun h => le_antisymm hHD h, fun h => h.ge⟩
  rw [finsum_cond_eq_sum_of_cond_iff
    (t := Finset.univ.filter fun C : Subgroup G => H ≤ C ∧ C ≤ D) _ fun _ => by simp]
  have key := sum_moebius_index_of_le (H.subgroupOf D)
  rw [finsum_cond_eq_sum_of_cond_iff
    (t := Finset.univ.filter fun C : Subgroup D => H.subgroupOf D ≤ C) _ fun _ => by simp] at key
  refine Eq.trans (Finset.sum_nbij' (fun C => C.subgroupOf D) (fun C' => C'.map D.subtype)
    ?_ ?_ ?_ ?_ ?_) (key.trans (if_congr htop rfl rfl))
  · intro C hC
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hC ⊢
    exact Subgroup.comap_mono hC.1
  · intro C' hC'
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hC' ⊢
    refine ⟨fun x hx => ⟨⟨x, hHD hx⟩, hC' hx, rfl⟩, Subgroup.map_subtype_le C'⟩
  · intro C hC
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hC
    exact Subgroup.map_subgroupOf_eq_of_le hC.2
  · intro C' _
    exact Subgroup.comap_map_eq_self_of_injective D.subtype_injective C'
  · intro C _
    rfl

end RelativeCyclic

end TauCeti
