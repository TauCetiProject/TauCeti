module

public import TauCeti.Algebra.AlgebraicGroup.Chevalley.Generation
public import TauCeti.Algebra.AlgebraicGroup.Chevalley.SimplyConnected
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Closure
import TauCeti.FieldTheory.IsAlgClosed.Units

/-!
# The canonical ambient group of a valid Lie-type index

For a valid Lie-type index `d`, with Dynkin type `t` and algebraically closed field
`K = TauCeti.ValidLieTypeIndex.Closure d`, the **canonical ambient group**
`TauCeti.ValidLieTypeIndex.CanonicalAmbientGroup d` is the group of `K`-points of the simply
connected Chevalley group scheme `G_sc(t)` (`TauCeti.DynkinType.chevalleyGroup`), the group scheme
over `ℤ` of the full-weight Chevalley datum. It depends only on the Dynkin type and the
characteristic of `d`: an untwisted and a graph-twisted index of the same type and characteristic
have the same canonical ambient group, and differ only in the Steinberg endomorphism to be
applied to it.

Unlike the represented ambient group `TauCeti.ValidLieTypeIndex.AmbientGroup`, which is assembled
by cases from seventeen explicit carriers, this group is one specialization of a single
construction. It carries

* the root subgroup `x_γ : K → Gᶜ_d` of every root `γ` of the numbered simply connected root
  datum (`TauCeti.ValidLieTypeIndex.canonicalRootSubgroup`), with additive parameter written in
  `Multiplicative K`; at the numbered simple roots `αᵢ` and their negatives these are the
  pinning maps `x_{±i}`;
* the split torus `T : (Fin t.rank → Kˣ) → Gᶜ_d`
  (`TauCeti.ValidLieTypeIndex.canonicalTorus`), parametrized in fundamental-weight coordinates:
  `T(s)` acts on a weight vector of weight `μ` by `μ(s) = ∏ⱼ sⱼ ^ μⱼ`.

Both maps are injective group homomorphisms, and the torus acts on each root subgroup through
its root, `T(s) x_γ(u) T(s)⁻¹ = x_γ(γ(s) u)`, with `γ` read in fundamental-weight coordinates.
The positive and negative simple root subgroups generate a subgroup containing every root
subgroup and the torus. That `Gᶜ_d` itself is generated by them, the geometric point-generation
theorem for `G_sc(t)` over an algebraically closed field, is not asserted here.

## Main definitions

* `TauCeti.ValidLieTypeIndex.CanonicalAmbientGroup`: the `K`-points of `G_sc(t)`.
* `TauCeti.ValidLieTypeIndex.canonicalRootSubgroup`: its root subgroup at every root.
* `TauCeti.ValidLieTypeIndex.canonicalTorus`: its split torus in fundamental-weight
  coordinates.

## Main results

* `TauCeti.ValidLieTypeIndex.canonicalRootSubgroup_injective` and
  `TauCeti.ValidLieTypeIndex.canonicalTorus_injective`: both maps are injective.
* `TauCeti.ValidLieTypeIndex.coe_canonicalTorus`: a torus point is the diagonal matrix of the
  weight characters on the numbered weight basis.
* `TauCeti.ValidLieTypeIndex.canonicalTorus_conj_canonicalRootSubgroup`: the pinning equation
  `T(s) x_γ(u) T(s)⁻¹ = x_γ(γ(s) u)`.
* `TauCeti.ValidLieTypeIndex.closure_canonicalRootSubgroup_union_range_canonicalTorus`: all root
  subgroups and the torus generate the same subgroup as the positive and negative simple root
  subgroups.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, AMS University Lecture Series 66 (2016),
  Chapters 2 and 3.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
-/

public section

namespace TauCeti.ValidLieTypeIndex

open _root_.TauCeti.DynkinType

noncomputable section

variable (d : ValidLieTypeIndex)

/-- **The canonical ambient group** of a valid Lie-type index: the points of the simply connected
Chevalley group scheme `G_sc(t)` of its Dynkin type `t` with values in the algebraic closure of its
prime field, a subgroup of `GLₙ` of that field for `n` the rank of the full-weight lattice. -/
abbrev CanonicalAmbientGroup : Type :=
  d.dynkinType.chevalleyGroup d.dynkinType_valid d.Closure

/-- **The root subgroup** `u ↦ x_γ(u)` of the canonical ambient group at a root `γ` of the
numbered simply connected root datum. At the numbered simple root `αᵢ`, the index
`d.dynkinType.simpleIndex d.dynkinType_valid i`, and at its negative these are the pinning maps
`x_{±i}`. -/
def canonicalRootSubgroup (γ : Fin d.dynkinType.numRoots) :
    Multiplicative d.Closure →* d.CanonicalAmbientGroup :=
  (d.dynkinType.scChevalleyDatum d.dynkinType_valid).rootSubgroupPoints γ d.Closure

/-- The canonical root subgroup is the root subgroup of the full-weight Chevalley datum. -/
theorem canonicalRootSubgroup_def (γ : Fin d.dynkinType.numRoots) :
    d.canonicalRootSubgroup γ =
      (d.dynkinType.scChevalleyDatum d.dynkinType_valid).rootSubgroupPoints γ d.Closure :=
  (rfl)

/-- **The split torus** of the canonical ambient group, parametrized in fundamental-weight
coordinates: the point with parameter `s : Fin t.rank → Kˣ` acts on each weight vector of the
full-weight lattice through the value of its weight at `s`. -/
def canonicalTorus : (Fin d.dynkinType.rank → d.Closureˣ) →* d.CanonicalAmbientGroup :=
  (d.dynkinType.scChevalleyDatum d.dynkinType_valid).torusPoints d.Closure

/-- The canonical torus is the torus of the full-weight Chevalley datum. -/
theorem canonicalTorus_def :
    d.canonicalTorus =
      (d.dynkinType.scChevalleyDatum d.dynkinType_valid).torusPoints d.Closure :=
  (rfl)

/-- **A canonical torus point is diagonal on the weight basis**: it scales the `j`-th vector of the
numbered weight basis of the full-weight lattice by the value at `s` of its weight. -/
@[simp]
theorem coe_canonicalTorus (s : Fin d.dynkinType.rank → d.Closureˣ) :
    (d.canonicalTorus s : Matrix.GeneralLinearGroup
        (Fin (d.dynkinType.scWeightBasisCard d.dynkinType_valid)) d.Closure) =
      diagGL fun j => torusCharacter s (d.dynkinType.scWeight d.dynkinType_valid j) := by
  have h := (d.dynkinType.scChevalleyDatum d.dynkinType_valid).coe_torusPoints d.Closure s
  rw [UniversalEnvelopingAlgebra.kostantTorusMatrix_apply] at h
  -- `canonicalTorus` is the datum torus, but its codomain is written as the canonical ambient
  -- group, so the datum lemma is applied to the unfolded map rather than rewritten into the goal.
  refine h.trans (congrArg diagGL (funext fun j => ?_))
  rw [scChevalleyDatum_coordinateWeight]

/-- **Every canonical root subgroup is injective.** -/
theorem canonicalRootSubgroup_injective (γ : Fin d.dynkinType.numRoots) :
    Function.Injective (d.canonicalRootSubgroup γ) :=
  d.dynkinType.scChevalleyDatum_rootSubgroupPoints_injective d.dynkinType_valid γ d.Closure

/-- **The canonical torus is injective**: the weights of the full-weight lattice span the whole
weight lattice. -/
theorem canonicalTorus_injective : Function.Injective d.canonicalTorus :=
  (d.dynkinType.scChevalleyDatum d.dynkinType_valid).torusPoints_injective d.Closure

/-- **The pinning equation.** Conjugation by the canonical torus point with parameter `s` carries
`x_γ(u)` to `x_γ(γ(s) u)`, where `γ(s) = ∏ⱼ sⱼ ^ γⱼ` for the root `γ` in fundamental-weight
coordinates. -/
theorem canonicalTorus_conj_canonicalRootSubgroup (γ : Fin d.dynkinType.numRoots)
    (s : Fin d.dynkinType.rank → d.Closureˣ) (u : d.Closure) :
    d.canonicalTorus s * d.canonicalRootSubgroup γ (Multiplicative.ofAdd u) *
        (d.canonicalTorus s)⁻¹ =
      d.canonicalRootSubgroup γ (Multiplicative.ofAdd
        ((torusCharacter s ((d.dynkinType.simplyConnectedRootDatum d.dynkinType_valid).root γ) :
          d.Closure) * u)) := by
  have h := (d.dynkinType.scChevalleyDatum d.dynkinType_valid).torusPoints_conj_rootSubgroupPoints γ
    d.Closure s u
  rw [scChevalleyDatum_coordinateRoot] at h
  -- As in `coe_canonicalTorus`, the datum equation is used at the unfolded canonical maps.
  exact h

/-- **The simple root subgroups generate the torus and every root subgroup.** In the canonical
ambient group, the subgroup generated by all root subgroups and the torus is the subgroup
generated by the positive and negative simple root subgroups. This is not the statement that
either subgroup is the whole canonical ambient group. -/
theorem closure_canonicalRootSubgroup_union_range_canonicalTorus :
    Subgroup.closure ((⋃ γ, Set.range (d.canonicalRootSubgroup γ)) ∪
        Set.range d.canonicalTorus) =
      Subgroup.closure (⋃ i : Fin d.dynkinType.rank,
        Set.range (d.canonicalRootSubgroup (d.dynkinType.simpleIndex d.dynkinType_valid i)) ∪
          Set.range (d.canonicalRootSubgroup
            ((d.dynkinType.simplyConnectedRootDatum d.dynkinType_valid).reflectionPerm
              (d.dynkinType.simpleIndex d.dynkinType_valid i)
              (d.dynkinType.simpleIndex d.dynkinType_valid i)))) := by
  dsimp only [CanonicalAmbientGroup, chevalleyGroup, canonicalRootSubgroup, canonicalTorus]
  -- Unfold the datum dimension when matching the canonical matrix group.
  erw [← ChevalleyDatum.rootTorusSubgroup_def]
  exact ChevalleyDatum.rootTorusSubgroup_eq_closure_rootSubgroup
    (d.dynkinType.scChevalleyDatum d.dynkinType_valid) d.Closure

end

end TauCeti.ValidLieTypeIndex
