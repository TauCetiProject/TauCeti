module

public import TauCeti.GroupTheory.SpecificGroups.CFSG.Suzuki.Generated

/-!
# The centre of a Suzuki group

`TauCeti.suzukiGroup n` is the subgroup of `GL₄(𝔽_(2^(2n+1)))` generated by the unipotent
matrices `u(a, b)` and the Weyl matrix `w`. This file proves that its centre is trivial. The
determinant-one calculations for the generators show that every group element has determinant one.
A separate linear-algebra computation shows that already the three generators `u(1, 0)`, `u(0, 1)`
and `w` have scalar commutant, so a matrix commuting with them is a multiple of the identity. A
central element of the Suzuki group is therefore a scalar `c` with `c ^ 4 = 1`, and
`(c - 1) ^ 4 = c ^ 4 - 1` in characteristic two, so `c = 1`.

Triviality of the centre is one of the two hypotheses of
`TauCeti.DerivedCentralQuotient.mulEquivOfCenterEqBot`, which identifies a perfect group with
trivial centre with its own derived central quotient. The other hypothesis, perfectness, is not
proved here, and neither simplicity nor the order of the group is asserted.

## Main results

* `TauCeti.Suzuki.eq_smul_one_of_commute`: a four-by-four matrix commuting with `u(1, 0)`,
  `u(0, 1)` and `w` is a scalar multiple of the identity matrix.
* `TauCeti.Suzuki.center_suzukiGroup_eq_bot`: the centre of a Suzuki group is trivial, at every
  parameter, including `n = 0`, where the group is the solvable group `Sz(2)`.

## References

* M. Suzuki, *On a class of doubly transitive groups*, Annals of Mathematics **75** (1962),
  105--145, for the generating matrices.
-/

public section

open Matrix

namespace TauCeti.Suzuki

variable (n : ℕ)

/-- **A matrix commuting with the generators `u(1, 0)`, `u(0, 1)` and `w` is scalar.** Three of
the generators of a Suzuki group already have scalar commutant in the full matrix algebra, so in
particular the centralizer of a Suzuki group consists of scalar matrices. -/
theorem eq_smul_one_of_commute {M : Matrix (Fin 4) (Fin 4) (GaloisField 2 (2 * n + 1))}
    (h₁ : Commute M (unipotentMatrix n 1 0)) (h₂ : Commute M (unipotentMatrix n 0 1))
    (hw : Commute M (weylMatrix n)) : M = M 0 0 • 1 := by
  have hz : (0 : GaloisField 2 (2 * n + 1)) ^ 2 ^ (n + 1) = 0 :=
    zero_pow (pow_ne_zero _ two_ne_zero)
  have e₁ : ∀ i j : Fin 4, (M * unipotentMatrix n 1 0) i j = (unipotentMatrix n 1 0 * M) i j :=
    fun i j => by rw [h₁.eq]
  have e₂ : ∀ i j : Fin 4, (M * unipotentMatrix n 0 1) i j = (unipotentMatrix n 0 1 * M) i j :=
    fun i j => by rw [h₂.eq]
  have ew : ∀ i j : Fin 4, (M * weylMatrix n) i j = (weylMatrix n * M) i j :=
    fun i j => by rw [hw.eq]
  -- Writing `mᵢⱼ` for `M i j`, the entries of the three commutation relations are linear
  -- relations among the `mᵢⱼ`, because the three generator matrices have entries `0` and `1`
  -- only. The fifteen entries used below, in the order they are used:
  --
  --   relation     entry    reads                              gives
  --   `M u₁ = u₁ M`  (0,1)  `m₀₁ + m₀₂ = m₀₁`                  `m₀₂ = 0`
  --   `M u₁ = u₁ M`  (0,2)  `m₀₂ + m₀₃ = m₀₂`                  `m₀₃ = 0`
  --   `M u₁ = u₁ M`  (0,0)  `m₀₀ + m₀₁ + m₀₂ + m₀₃ = m₀₀`      `m₀₁ = 0`
  --   `M u₁ = u₁ M`  (1,1)  `m₁₁ + m₁₂ = m₀₁ + m₁₁`            `m₁₂ = 0`
  --   `M u₁ = u₁ M`  (1,2)  `m₁₂ + m₁₃ = m₀₂ + m₁₂`            `m₁₃ = 0`
  --   `M u₁ = u₁ M`  (2,2)  `m₂₂ + m₂₃ = m₀₂ + m₁₂ + m₂₂`      `m₂₃ = 0`
  --   `M w = w M`    (0,0)  `m₀₃ = m₃₀`                        `m₃₀ = 0`
  --   `M w = w M`    (0,1)  `m₀₂ = m₃₁`                        `m₃₁ = 0`
  --   `M w = w M`    (1,1)  `m₁₂ = m₂₁`                        `m₂₁ = 0`
  --   `M w = w M`    (1,0)  `m₁₃ = m₂₀`                        `m₂₀ = 0`
  --   `M u₁ = u₁ M`  (3,1)  `m₃₁ + m₃₂ = m₀₁ + m₂₁ + m₃₁`      `m₃₂ = 0`
  --   `M u₂ = u₂ M`  (2,0)  `m₂₀ + m₂₂ + m₂₃ = m₀₀ + m₂₀`      `m₂₂ = m₀₀`
  --   `M u₁ = u₁ M`  (2,1)  `m₂₁ + m₂₂ = m₀₁ + m₁₁ + m₂₁`      `m₁₁ = m₀₀`
  --   `M u₁ = u₁ M`  (3,2)  `m₃₂ + m₃₃ = m₀₂ + m₂₂ + m₃₂`      `m₃₃ = m₀₀`
  --   `M u₂ = u₂ M`  (3,0)  `m₃₀ + m₃₂ + m₃₃ = m₀₀ + m₁₀ + m₃₀` `m₁₀ = 0`
  have m02 : M 0 2 = 0 := by
    have h := e₁ 0 1; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h; linear_combination h
  have m03 : M 0 3 = 0 := by
    have h := e₁ 0 2; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h; linear_combination h
  have m01 : M 0 1 = 0 := by
    have h := e₁ 0 0; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination h - m02 - m03
  have m12 : M 1 2 = 0 := by
    have h := e₁ 1 1; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination h + m01
  have m13 : M 1 3 = 0 := by
    have h := e₁ 1 2; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination h + m02
  have m23 : M 2 3 = 0 := by
    have h := e₁ 2 2; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination h + m02 + m12
  have m30 : M 3 0 = 0 := by
    have h := ew 0 0; simp [Matrix.mul_apply, Fin.sum_univ_four] at h
    linear_combination m03 - h
  have m31 : M 3 1 = 0 := by
    have h := ew 0 1; simp [Matrix.mul_apply, Fin.sum_univ_four] at h
    linear_combination m02 - h
  have m21 : M 2 1 = 0 := by
    have h := ew 1 1; simp [Matrix.mul_apply, Fin.sum_univ_four] at h
    linear_combination m12 - h
  have m20 : M 2 0 = 0 := by
    have h := ew 1 0; simp [Matrix.mul_apply, Fin.sum_univ_four] at h
    linear_combination m13 - h
  have m32 : M 3 2 = 0 := by
    have h := e₁ 3 1; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination h + m01 + m21
  have m22 : M 2 2 = M 0 0 := by
    have h := e₂ 2 0; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination h - m23
  have m11 : M 1 1 = M 0 0 := by
    have h := e₁ 2 1; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination m22 - h - m01
  have m33 : M 3 3 = M 0 0 := by
    have h := e₁ 3 2; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination h + m02 + m22
  have m10 : M 1 0 = 0 := by
    have h := e₂ 3 0; simp [Matrix.mul_apply, Fin.sum_univ_four, hz] at h
    linear_combination m32 + m33 - h
  ext i j
  fin_cases i <;> fin_cases j <;> simp_all

/-- **The centre of a Suzuki group is trivial.** This holds at every parameter, including `n = 0`,
where the group is the solvable group `Sz(2)`. -/
@[simp]
theorem center_suzukiGroup_eq_bot : Subgroup.center ↥(suzukiGroup n) = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  rintro ⟨g, hg⟩ hcentral
  rw [Subgroup.mem_center_iff] at hcentral
  -- A central element commutes with every element of the group, hence, after the subgroup and
  -- unit coercions, with the matrix of every generator.
  have hcomm : ∀ x ∈ suzukiGroup n,
      Commute (g : Matrix (Fin 4) (Fin 4) (GaloisField 2 (2 * n + 1)))
        (x : Matrix (Fin 4) (Fin 4) (GaloisField 2 (2 * n + 1))) := by
    intro x hx
    have hc : Commute (⟨g, hg⟩ : ↥(suzukiGroup n)) ⟨x, hx⟩ := (hcentral ⟨x, hx⟩).symm
    exact (hc.map (suzukiGroup n).subtype).map (Units.coeHom _)
  have hscalar := eq_smul_one_of_commute n
    (by simpa only [coe_unipotent] using hcomm _ (unipotent_mem_suzukiGroup (n := n) 1 0))
    (by simpa only [coe_unipotent] using hcomm _ (unipotent_mem_suzukiGroup (n := n) 0 1))
    (by simpa only [coe_weyl] using hcomm _ (weyl_mem_suzukiGroup (n := n)))
  -- The scalar is a fourth root of unity, so it is one.
  have hdet := det_eq_one_of_mem_suzukiGroup n hg
  rw [hscalar, Matrix.det_smul, Matrix.det_one, mul_one, Fintype.card_fin] at hdet
  have hone : (g : Matrix (Fin 4) (Fin 4) (GaloisField 2 (2 * n + 1))) 0 0 = 1 := by
    have h4 : ((g : Matrix (Fin 4) (Fin 4) (GaloisField 2 (2 * n + 1))) 0 0 - 1) ^ 2 ^ 2 = 0 := by
      rw [sub_pow_char_pow]
      norm_num [hdet]
    exact sub_eq_zero.mp (pow_eq_zero_iff (n := 2 ^ 2) (by norm_num) |>.mp h4)
  refine Subtype.ext (Units.ext ?_)
  rw [hscalar, hone, one_smul, OneMemClass.coe_one, Matrix.GeneralLinearGroup.coe_one]

end TauCeti.Suzuki
