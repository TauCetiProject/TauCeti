/-!
# The Suzuki groups are simple

Let `q = 2^(2m+1)` with `m ≠ 0` and let `G = Sz(q)` be `TauCeti.suzukiGroup m`, the subgroup of
`GL₄(𝔽_q)` generated by the lower unitriangular matrices `u(a, b)` and the antidiagonal Weyl
element `w`. This file proves that `G` is simple, and hence so is the Suzuki candidate group
`TauCeti.SuzukiLieIndex.Group` of every valid Suzuki index.

The proof applies Tits's simplicity theorem to a Tits system of rank one on `G`:

* `U = {u(a, b)}` is the **unipotent subgroup**; its elements satisfy `u⁴ = 1`, so `U` is a
  `2`-group and therefore solvable;
* `B = H U` is the **Borel subgroup**, the product of the torus `H = {h(κ)}` and `U`; the torus
  normalizes `U`, so `B` does;
* `N` is the group of order two generated by `w`.

The rank-one Bruhat decomposition `G = B ∪ B w B` is the content of the generation theorem
`TauCeti.SuzukiLieIndex.finiteFixedSubgroup_eq_suzukiGroup`, whose two cases
`TauCeti.SuzukiLieIndex.exists_eq_torus_mul_unipotent` and
`TauCeti.SuzukiLieIndex.exists_eq_unipotent_mul_weyl_mul_torus_mul_unipotent` put every element in
`B` or in `B w B`. The conjugate `w u(a, b) w` lies in `B` only for `u(a, b) = 1`, which is the
remaining axiom `w B w ≠ B`. Since `G` is perfect (`TauCeti.Suzuki.isPerfect_suzukiGroup`) and
the conjugates of `U` generate `G`, Tits's theorem shows that every normal subgroup of `G` is `G`
or lies in the normal core `Z` of `B`.

Finally `Z` is trivial. An element of `Z ∩ U` is conjugated into `B` by `w`, so it is trivial;
hence `Z`, which normalizes `U`, commutes with `U`. The centralizer of the normal subgroup `Z` is
normal and contains `U`, so it is all of `G`, and `Z` lies in the centre of `G`, which is trivial
(`TauCeti.Suzuki.center_suzukiGroup_eq_bot`).

## Main definitions and results

The subgroups `U` and `B = H U`, `TauCeti.Suzuki.unipotentSubgroup` and
`TauCeti.Suzuki.borelSubgroup`, are defined in the files on the generators and on the torus.

* `TauCeti.Suzuki.mem_borelSubgroupOf_or_mem_doubleCoset`: the Bruhat decomposition
  `Sz(q) = B ∪ B w B`.
* `TauCeti.Suzuki.titsSystem`: the Tits system `(B, ⟨w⟩)` of rank one on `Sz(q)`, whose only
  simple reflection is the class of `w` (`TauCeti.Suzuki.titsSystem_simple`), so that it is
  irreducible (`TauCeti.Suzuki.isIrreducible_titsSystem`).
* `TauCeti.Suzuki.normalCore_borelSubgroupOf`: the normal core of the Borel subgroup is trivial.
* `TauCeti.Suzuki.isSimpleGroup_suzukiGroup`: `Sz(q)` is simple for `m ≠ 0`.
* `TauCeti.SuzukiLieIndex.isSimpleGroup_group`: the candidate group of every valid Suzuki index
  is simple.

## References

* M. Suzuki, *On a class of doubly transitive groups*, Annals of Mathematics **75** (1962),
  105--145.
* R. A. Wilson, *The Finite Simple Groups*, Springer GTM 251 (2009), §4.2.
* J. E. Humphreys, *Linear Algebraic Groups* (1975), Section 29.5, for Tits's simplicity theorem.
-/

public section

noncomputable section

open Matrix

namespace TauCeti

namespace Suzuki

variable (m : ℕ)

/-! ## The Tits system of rank one -/

/-- **The rank-one Bruhat decomposition** `Sz(q) = B ∪ B w B`, for `m ≠ 0`. -/
theorem mem_borelSubgroupOf_or_mem_doubleCoset (hm : m ≠ 0) (g : suzukiGroup m) :
    g ∈ borelSubgroupOf m ∨
      g ∈ DoubleCoset.doubleCoset (weylOf m) (borelSubgroupOf m) (borelSubgroupOf m) := by
  have hvalid : (LieTypeIndex.suzuki m).Valid := by
    simpa [LieTypeIndex.valid_iff, LieTypeIndex.inStandardRange_iff,
      LieTypeIndex.isDuplicateRepresentative_iff, Nat.one_le_iff_ne_zero] using hm
  have hg : (g : GL (Fin 4) (GaloisField 2 (2 * m + 1))) ∈
      SuzukiLieIndex.finiteFixedSubgroup m hvalid := by
    rw [SuzukiLieIndex.finiteFixedSubgroup_eq_suzukiGroup]
    exact g.2
  by_cases h : ((g : GL (Fin 4) (GaloisField 2 (2 * m + 1))) :
      Matrix (Fin 4) (Fin 4) (GaloisField 2 (2 * m + 1))) 0 3 = 0
  · obtain ⟨κ, a, b, hκ⟩ := SuzukiLieIndex.exists_eq_torus_mul_unipotent hg h
    exact Or.inl (mem_borelSubgroup.mpr ⟨κ, a, b, hκ.symm⟩)
  · obtain ⟨a, b, κ, c, d, hκ⟩ :=
      SuzukiLieIndex.exists_eq_unipotent_mul_weyl_mul_torus_mul_unipotent hg h
    refine Or.inr (DoubleCoset.mem_doubleCoset.mpr
      ⟨⟨_, unipotent_mem_suzukiGroup a b⟩,
        unipotentSubgroup_le_borelSubgroup m (mem_unipotentSubgroup.mpr ⟨a, b, rfl⟩),
        ⟨_, borelSubgroup_le_suzukiGroup m (mem_borelSubgroup.mpr ⟨κ, c, d, rfl⟩)⟩,
        mem_borelSubgroup.mpr ⟨κ, c, d, rfl⟩, Subtype.ext hκ⟩)

/-- **The Tits system of rank one on `Sz(q)`**, for `m ≠ 0`: `B = H U` is the Borel subgroup and
`N` is the group of order two generated by the Weyl element `w`. -/
def titsSystem (hm : m ≠ 0) : TitsSystem (suzukiGroup m) :=
  TitsSystem.ofRankOne (borelSubgroupOf m) (Subgroup.zpowers (weylOf m))
    ⟨weylOf m, Subgroup.mem_zpowers _⟩ (by simp [weylOf_mul_weylOf, one_mem])
    (fun _ hx ↦ by
      rcases (Subgroup.mem_zpowers_iff_of_sq_eq_one (by rw [sq, weylOf_mul_weylOf])).mp hx
        with rfl | rfl
      · exact Or.inl (one_mem _)
      · exact Or.inr (by simp [one_mem]))
    ⟨⟨_, unipotent_mem_suzukiGroup 1 0⟩,
      unipotentSubgroup_le_borelSubgroup m (mem_unipotentSubgroup.mpr ⟨1, 0, rfl⟩),
      fun h ↦ one_ne_zero
      ((weyl_mul_unipotent_mul_weyl_mem_borelSubgroup_iff m).mp
        (by simpa using Subgroup.mem_subgroupOf.mp h)).1⟩
    (mem_borelSubgroupOf_or_mem_doubleCoset m hm)

/-- The subgroup `B` of the Tits system of `Sz(q)` is the Borel subgroup. -/
@[simp]
theorem titsSystem_subgroupB (hm : m ≠ 0) : (titsSystem m hm).subgroupB = borelSubgroupOf m :=
  TitsSystem.ofRankOne_subgroupB

/-- The subgroup `N` of the Tits system of `Sz(q)` is generated by the Weyl element. -/
@[simp]
theorem titsSystem_subgroupN (hm : m ≠ 0) :
    (titsSystem m hm).subgroupN = Subgroup.zpowers (weylOf m) :=
  TitsSystem.ofRankOne_subgroupN

/-- The only simple reflection of the Tits system of `Sz(q)` is the class of the Weyl element. -/
@[simp]
theorem titsSystem_simple (hm : m ≠ 0) :
    (titsSystem m hm).simple = {QuotientGroup.mk ⟨weylOf m, by
      rw [titsSystem_subgroupN]; exact Subgroup.mem_zpowers _⟩} :=
  TitsSystem.ofRankOne_simple

/-- **The Tits system of `Sz(q)` is irreducible**, having a single simple reflection. -/
theorem isIrreducible_titsSystem (hm : m ≠ 0) : (titsSystem m hm).IsIrreducible :=
  TitsSystem.isIrreducible_ofRankOne

/-! ## Simplicity -/

/-- **The normal core of the Borel subgroup of `Sz(q)` is trivial.** -/
theorem normalCore_borelSubgroupOf : (borelSubgroupOf m).normalCore = ⊥ := by
  set Z := (borelSubgroupOf m).normalCore
  have : Z.Normal := Subgroup.normalCore_normal _
  -- The Weyl element conjugates an element of `Z ∩ U` into `B`, so that element is trivial.
  have hZU : Z ⊓ unipotentSubgroupOf m = ⊥ := by
    refine eq_bot_iff.mpr fun y ⟨hyZ, hyU⟩ ↦ Subgroup.mem_bot.mpr ?_
    obtain ⟨a, b, hy⟩ := mem_unipotentSubgroup.mp (Subgroup.mem_subgroupOf.mp hyU)
    have h := Subgroup.normalCore_le _ (this.conj_mem y hyZ (weylOf m))
    rw [Subgroup.mem_subgroupOf] at h
    simp only [Subgroup.coe_mul, InvMemClass.coe_inv, weyl_inv, ← hy] at h
    obtain ⟨rfl, rfl⟩ := (weyl_mul_unipotent_mul_weyl_mem_borelSubgroup_iff m).mp h
    exact Subtype.ext (by simp [← hy])
  -- Hence `Z`, which is normal and normalizes `U`, commutes with `U`.
  have hcomm : unipotentSubgroupOf m ≤ Subgroup.centralizer (Z : Set (suzukiGroup m)) :=
    Subgroup.le_centralizer_iff.mp (le_centralizer_of_le_normalizer_of_inf_eq_bot
      ((Subgroup.normalCore_le _).trans (borelSubgroupOf_le_normalizer m)) hZU)
  -- The centralizer of the normal subgroup `Z` is normal and contains `U`, so it is everything.
  have htop : Subgroup.centralizer (Z : Set (suzukiGroup m)) = ⊤ :=
    eq_top_iff.mpr ((normalClosure_unipotentSubgroupOf m).symm.le.trans
      (Subgroup.normalClosure_le_normal hcomm))
  have hcenter := Subgroup.centralizer_eq_top_iff_subset.mp htop
  rw [← le_bot_iff, ← center_suzukiGroup_eq_bot m]
  exact hcenter

/-- **The Suzuki group `Sz(2^(2m+1))` is simple** for `m ≠ 0`. -/
theorem isSimpleGroup_suzukiGroup (hm : m ≠ 0) : IsSimpleGroup (suzukiGroup m) := by
  have := isPerfect_suzukiGroup hm
  have := (isPGroup_unipotentSubgroupOf m).isNilpotent
  have : Nontrivial (suzukiGroup m) := ⟨⟨weylOf m, 1, fun h ↦ by
    simpa using congrArg (fun g : suzukiGroup m ↦
      ((g : GL (Fin 4) (GaloisField 2 (2 * m + 1))) :
        Matrix (Fin 4) (Fin 4) (GaloisField 2 (2 * m + 1))) 0 0) h⟩⟩
  refine ⟨fun H _ ↦ ?_⟩
  rcases (titsSystem m hm).le_normalCore_or_eq_top_of_normal (isIrreducible_titsSystem m hm)
    (by simpa using borelSubgroupOf_le_normalizer m) (normalClosure_unipotentSubgroupOf m) H
    with h | h
  · rw [titsSystem_subgroupB, normalCore_borelSubgroupOf] at h
    exact Or.inl (le_bot_iff.mp h)
  · exact Or.inr h

end Suzuki

namespace SuzukiLieIndex

/-- **The candidate group of every valid Suzuki index is simple**: it is the generated Suzuki
group `Sz(2^(2m+1))`, and validity forces `m ≠ 0`. -/
theorem isSimpleGroup_group (m : ℕ) (hvalid : (LieTypeIndex.suzuki m).Valid) :
    IsSimpleGroup (of m hvalid).Group := by
  have hm : m ≠ 0 := by
    have h : 1 ≤ m :=
      (LieTypeIndex.inStandardRange_iff _).mp ((LieTypeIndex.valid_iff _).mp hvalid).1
    omega
  exact (groupEquivSuzukiGroup m hvalid).isSimpleGroup_congr.mpr
    (Suzuki.isSimpleGroup_suzukiGroup m hm)

end SuzukiLieIndex

end TauCeti
