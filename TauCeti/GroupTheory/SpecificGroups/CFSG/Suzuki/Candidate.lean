module

public import TauCeti.GroupTheory.SpecificGroups.CFSG.Suzuki.Center
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Suzuki.Generation
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Suzuki.Perfect

/-!
# The Suzuki candidate group is the group generated by the standard matrices

Two constructions of the Suzuki group `Sz(2^(2m+1))` sit side by side in Tau Ceti. One is
`TauCeti.SuzukiLieIndex.Group`, the derived subgroup of the fixed points of the Steinberg
endomorphism `τ ^ (2m+1)` of the rank-two symplectic carrier over an algebraic closure of `𝔽₂`,
modulo the centre of that derived subgroup. The other is `TauCeti.suzukiGroup m`, the subgroup of
`GL₄(𝔽_(2^(2m+1)))` generated by the standard unipotent matrices `u(a, b)` and the Weyl matrix
`w`. This file proves that the two are isomorphic, for every valid Suzuki index.

The fixed points are already known to be the generated group: scalar extension along the generator
embedding identifies `TauCeti.suzukiGroup m` with `TauCeti.SuzukiLieIndex.FixedPoints`. What
remains is that the two further steps of the fixed-point recipe do nothing here. The generated
group is perfect once `m ≠ 0`, which validity of the index forces, and its centre is trivial at
every parameter; both properties transport to the fixed points along that identification, and a
perfect group with trivial centre is its own derived subgroup modulo the centre of that derived
subgroup.

So the recipe returns the Steinberg fixed points unchanged on the Suzuki family, and the candidate
group of a valid Suzuki index is the generated Suzuki group. On underlying matrices the resulting
isomorphism is inverse to the generator embedding.

Neither group is asserted here to be finite or simple, and no order is computed: the statement is
an isomorphism between the two constructions and nothing more.

## Main definitions

* `TauCeti.SuzukiLieIndex.groupEquivFixedPoints`: the candidate group of a valid Suzuki index is
  its Steinberg fixed-point group, the derived-subgroup-modulo-centre step being trivial here.
* `TauCeti.SuzukiLieIndex.groupEquivSuzukiGroup`: the candidate group of a valid Suzuki index is
  the group generated by the standard Suzuki matrices.

## Main results

* `TauCeti.SuzukiLieIndex.instIsPerfectFixedPoints` and
  `TauCeti.SuzukiLieIndex.center_fixedPoints_eq_bot`: the Steinberg fixed points of a valid Suzuki
  index are perfect and have trivial centre.
* `TauCeti.SuzukiLieIndex.generatorEmbedding_groupEquivSuzukiGroup_mk`: on underlying matrices the
  isomorphism with the generated group is inverse to the generator embedding.

## References

* M. Suzuki, *On a class of doubly transitive groups*, Annals of Mathematics **75** (1962),
  105--145.
* R. A. Wilson, *The Finite Simple Groups*, Springer GTM 251 (2009), §4.2.
-/

public section

noncomputable section

open Matrix

namespace TauCeti.SuzukiLieIndex

variable {m : ℕ} {hvalid : (LieTypeIndex.suzuki m).Valid}

/-! ## The fixed points are perfect and centreless -/

/-- **The Steinberg fixed points of a valid Suzuki index are perfect.** Validity of the index
forces `1 ≤ m`, which is what the corresponding statement about the generated group needs: at
`m = 0` that group is the solvable Frobenius group `Sz(2)` of order twenty. -/
instance instIsPerfectFixedPoints : Group.IsPerfect (of m hvalid).FixedPoints := by
  have hm : m ≠ 0 := by
    have h : 1 ≤ m :=
      (LieTypeIndex.inStandardRange_iff _).mp ((LieTypeIndex.valid_iff _).mp hvalid).1
    omega
  have := Suzuki.isPerfect_suzukiGroup hm
  exact Group.IsPerfect.ofSurjective (f := (suzukiGroupEquivFixedPoints m hvalid).toMonoidHom)
    (suzukiGroupEquivFixedPoints m hvalid).surjective

/-- **The Steinberg fixed points of a valid Suzuki index have trivial centre**, the centre of the
generated Suzuki group being trivial at every parameter. -/
@[simp]
theorem center_fixedPoints_eq_bot : Subgroup.center (of m hvalid).FixedPoints = ⊥ := by
  rw [← Subgroup.map_center_eq (suzukiGroupEquivFixedPoints m hvalid),
    Suzuki.center_suzukiGroup_eq_bot m, Subgroup.map_bot]

/-! ## The candidate group -/

variable (m hvalid)

/-- **The fixed-point recipe is the identity on the Suzuki family**: the candidate group of a valid
Suzuki index is its Steinberg fixed-point group, which is perfect with trivial centre and so is its
own derived subgroup modulo the centre of that derived subgroup. -/
def groupEquivFixedPoints : (of m hvalid).Group ≃* (of m hvalid).FixedPoints :=
  DerivedCentralQuotient.mulEquivOfCenterEqBot center_fixedPoints_eq_bot

/-- The fixed-point equivalence sends the class represented by an element of the commutator
subgroup to that element of the fixed-point group. -/
@[simp]
theorem groupEquivFixedPoints_mk (x : ↥(commutator (of m hvalid).FixedPoints)) :
    groupEquivFixedPoints m hvalid (x : (of m hvalid).Group) =
      (x : (of m hvalid).FixedPoints) :=
  DerivedCentralQuotient.mulEquivOfCenterEqBot_mk center_fixedPoints_eq_bot x

/-- **The candidate group of a valid Suzuki index is the generated Suzuki group**: the derived
subgroup of the Steinberg fixed points of `²B₂(2^(2m+1))`, modulo the centre of that derived
subgroup, is the subgroup of `GL₄(𝔽_(2^(2m+1)))` generated by the standard unipotent matrices and
the Weyl matrix.

Neither side is asserted to be finite or simple. -/
def groupEquivSuzukiGroup : (of m hvalid).Group ≃* ↥(suzukiGroup m) :=
  (groupEquivFixedPoints m hvalid).trans (suzukiGroupEquivFixedPoints m hvalid).symm

/-- The Suzuki-group equivalence sends the class represented by an element of the commutator
subgroup to the corresponding element of the generated Suzuki group. -/
@[simp]
theorem groupEquivSuzukiGroup_mk (x : ↥(commutator (of m hvalid).FixedPoints)) :
    groupEquivSuzukiGroup m hvalid (x : (of m hvalid).Group) =
      (suzukiGroupEquivFixedPoints m hvalid).symm (x : (of m hvalid).FixedPoints) := by
  rw [groupEquivSuzukiGroup, MulEquiv.trans_apply, groupEquivFixedPoints_mk]

/-- Read backwards, the identification sends an element of the generated Suzuki group to the class
of the Steinberg fixed point it scalar-extends to; every fixed point lies in the derived subgroup,
the fixed points being perfect. -/
@[simp]
theorem groupEquivSuzukiGroup_symm_apply (g : ↥(suzukiGroup m)) :
    (groupEquivSuzukiGroup m hvalid).symm g =
      ((⟨suzukiGroupEquivFixedPoints m hvalid g, Group.IsPerfect.mem_commutator⟩ :
        ↥(commutator (of m hvalid).FixedPoints)) : (of m hvalid).Group) := by
  rw [MulEquiv.symm_apply_eq, groupEquivSuzukiGroup_mk, MulEquiv.symm_apply_apply]

/-- **The identification with the generated group is inverse to the generator embedding**: the
class of a Steinberg fixed point `x` goes to the element of the generated Suzuki group whose
coordinate change and scalar extension is `x`. -/
theorem generatorEmbedding_groupEquivSuzukiGroup_mk
    (x : ↥(commutator (of m hvalid).FixedPoints)) :
    generatorEmbedding m hvalid (groupEquivSuzukiGroup m hvalid (x : (of m hvalid).Group)) =
      (((x : (of m hvalid).FixedPoints) : (of m hvalid).toRankTwoBLieIndex.AmbientGroup) :
        GL (Fin 4) (of m hvalid).1.Closure) := by
  rw [groupEquivSuzukiGroup_mk, ← coe_coe_suzukiGroupEquivFixedPoints_apply m hvalid,
    MulEquiv.apply_symm_apply]

end TauCeti.SuzukiLieIndex
