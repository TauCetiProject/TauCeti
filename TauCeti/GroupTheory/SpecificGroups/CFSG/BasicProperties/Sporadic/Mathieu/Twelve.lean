/-! ### Kernel certificate checks -/

private theorem check_stage1 :
    checkRelators M12.presentation.generatorCount
      m12Rels [(131, wordA5)] stage1Parents stage1Steps = true := by
  rw [m12Rels, presentation_M12, Sporadic.m12Presentation_generatorCount,
    Sporadic.m12Presentation_relatorLetters]
  decide +kernel

private theorem check_stage2 :
    checkRelators M12.presentation.generatorCount
      (m12Rels ++ [wordA5, wordB6])
      [(77, wordAB6), (72, wordAAB11)]
      stage2Parents stage2Steps = true := by
  rw [m12Rels, presentation_M12, Sporadic.m12Presentation_generatorCount,
    Sporadic.m12Presentation_relatorLetters]
  decide +kernel

private theorem check_stage3 :
    checkRelators M12.presentation.generatorCount
      (m12Rels ++ [wordA5, wordB6, wordAB6, wordAAB11])
      [(25, wordConj)] stage3Parents stage3Steps = true := by
  rw [m12Rels, presentation_M12, Sporadic.m12Presentation_generatorCount,
    Sporadic.m12Presentation_relatorLetters]
  decide +kernel

private theorem run_stage4 :
    run M12.presentation.generatorCount
      m12Rels [wordH, wordK] stage4Parents stage4Steps = some 1728 := by
  rw [m12Rels, presentation_M12, Sporadic.m12Presentation_generatorCount,
    Sporadic.m12Presentation_relatorLetters]
  decide +kernel

/-! ### Upper bound on `M12.Group` -/

private abbrev m12Of : Fin M12.presentation.generatorCount → M12.Group :=
  PresentedGroup.of

private abbrev gA : M12.Group := m12Of ⟨0, by simp [presentation_M12]⟩
private abbrev gB : M12.Group := m12Of ⟨1, by simp [presentation_M12]⟩
private abbrev gH : M12.Group := gA * gB * gA
private abbrev gK : M12.Group := gB * gB * gA * gB⁻¹ * gB⁻¹

private theorem letter_zero : letter m12Of 0 = gA := by
  simpa [gA] using letter_two_mul m12Of ⟨0, by simp [presentation_M12]⟩

private theorem letter_one : letter m12Of 1 = gA⁻¹ := by
  simpa [gA] using letter_two_mul_add_one m12Of ⟨0, by simp [presentation_M12]⟩

private theorem letter_two : letter m12Of 2 = gB := by
  simpa [gB] using letter_two_mul m12Of ⟨1, by simp [presentation_M12]⟩

private theorem letter_three : letter m12Of 3 = gB⁻¹ := by
  simpa [gB] using letter_two_mul_add_one m12Of ⟨1, by simp [presentation_M12]⟩

private theorem wordValue_wordA5 : wordValue m12Of wordA5 = 1 :=
  M12.presentation.wordValue_eq_one_of_checkRelators check_stage1 (131, wordA5)
    (by simp)

private theorem wordValue_wordB6 : wordValue m12Of wordB6 = 1 := by
  have hr2 : wordValue m12Of (wordA5 ++ wordB6) = 1 :=
    M12.presentation.wordValue_relatorLetters_eq_one _ (by
      rw [presentation_M12, Sporadic.m12Presentation_relatorLetters]
      decide)
  rw [wordValue_append, wordValue_wordA5, one_mul] at hr2
  exact hr2

private theorem wordValue_rels2 : ∀ r ∈ m12Rels ++ [wordA5, wordB6], wordValue m12Of r = 1 := by
  intro r hr
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with hr | rfl | rfl
  · exact M12.presentation.wordValue_relatorLetters_eq_one r hr
  · exact wordValue_wordA5
  · exact wordValue_wordB6

private theorem wordValue_wordAB6 : wordValue m12Of wordAB6 = 1 :=
  SubgroupEnumeration.wordValue_eq_one_of_checkRelators wordValue_rels2 check_stage2
    (77, wordAB6) (by simp)

private theorem wordValue_wordAAB11 : wordValue m12Of wordAAB11 = 1 :=
  SubgroupEnumeration.wordValue_eq_one_of_checkRelators wordValue_rels2 check_stage2
    (72, wordAAB11) (by simp)

private theorem wordValue_rels3 :
    ∀ r ∈ m12Rels ++ [wordA5, wordB6, wordAB6, wordAAB11], wordValue m12Of r = 1 := by
  intro r hr
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with hr | rfl | rfl | rfl | rfl
  · exact M12.presentation.wordValue_relatorLetters_eq_one r hr
  · exact wordValue_wordA5
  · exact wordValue_wordB6
  · exact wordValue_wordAB6
  · exact wordValue_wordAAB11

private theorem wordValue_wordConj : wordValue m12Of wordConj = 1 :=
  SubgroupEnumeration.wordValue_eq_one_of_checkRelators wordValue_rels3 check_stage3
    (25, wordConj) (by simp)

private theorem gK_pow_five : gK ^ 5 = 1 := by
  have ha5 : gA ^ 5 = 1 := by
    have h := wordValue_wordA5
    simp only [wordA5, wordValue_cons, wordValue_nil, letter_zero, mul_one] at h
    simpa [pow_succ, mul_assoc] using h
  have hk : gK = MulAut.conj (gB * gB) gA := by
    simp [gK, MulAut.conj_apply, mul_assoc]
  rw [hk, ← map_pow, ha5, map_one]

private theorem gH_pow_eleven : gH ^ 11 = 1 := by
  have haab11 : (gA * gA * gB) ^ 11 = 1 := by
    have h := wordValue_wordAAB11
    simp only [wordAAB11, wordValue_cons, wordValue_nil, letter_zero, letter_two, mul_one] at h
    simpa [pow_succ, mul_assoc] using h
  have hh : gH = MulAut.conj gA⁻¹ (gA * gA * gB) := by
    simp [gH, mul_assoc]
  rw [hh, ← map_pow, haab11, map_one]

private theorem gK_conj_gH : gK * gH * gK⁻¹ = (gH ^ 2)⁻¹ := by
  have hc := wordValue_wordConj
  simp only [wordConj, wordValue_cons, wordValue_nil, letter_zero, letter_one, letter_two,
    letter_three, mul_one] at hc
  have hc' : gK * gH * gK⁻¹ * gH ^ 2 = 1 := by
    simpa [gK, gH, sq, mul_assoc] using hc
  exact eq_inv_of_mul_eq_one_left hc'

private def frobSubgroup : Subgroup M12.Group :=
  Subgroup.closure (Set.range (![gK, gH] : Fin 2 → M12.Group))

private theorem frobSubgroup_finite_and_card :
    Finite frobSubgroup ∧ Nat.card frobSubgroup ≤ 55 := by
  have hm : ∀ i : Fin 2, 0 < (![5, 11] : Fin 2 → ℕ) i := by
    intro i; fin_cases i <;> decide
  have hpow : ∀ i : Fin 2,
      (![gK, gH] : Fin 2 → M12.Group) i ^ (![5, 11] : Fin 2 → ℕ) i ∈
        generatorSuffix (![gK, gH] : Fin 2 → M12.Group) ((i : ℕ) + 1) := by
    intro i; fin_cases i
    · simp [gK_pow_five]
    · simp [gH_pow_eleven]
  have hconj : ∀ i j : Fin 2, i < j →
      (![gK, gH] : Fin 2 → M12.Group) i * (![gK, gH] : Fin 2 → M12.Group) j *
        ((![gK, gH] : Fin 2 → M12.Group) i)⁻¹ ∈
        generatorSuffix (![gK, gH] : Fin 2 → M12.Group) ((i : ℕ) + 1) := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> try exact absurd hij (by decide)
    simp only [Fin.zero_eta, Fin.mk_one, zero_add, Matrix.cons_val_zero,
      Matrix.cons_val_one, gK_conj_gH]
    have hh : gH ∈ generatorSuffix (![gK, gH] : Fin 2 → M12.Group) 1 :=
      apply_mem_generatorSuffix (![gK, gH] : Fin 2 → M12.Group) 1 le_rfl
    exact Subgroup.inv_mem _ (Subgroup.pow_mem _ hh 2)
  refine ⟨finite_closure_of_power_conjugate _ _ hm hpow hconj, ?_⟩
  simpa [frobSubgroup, Fin.prod_univ_two] using
    card_closure_le_of_power_conjugate _ _ hm hpow hconj

private theorem wordValue_subgens :
    ∀ s ∈ [wordH, wordK], wordValue m12Of s ∈ frobSubgroup := by
  intro s hs
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
  rcases hs with rfl | rfl
  · have : wordValue m12Of wordH = gH := by
      simp [wordH, wordValue_cons, wordValue_nil, letter_zero, letter_two, gH, mul_assoc]
    rw [this]
    exact Subgroup.subset_closure ⟨1, rfl⟩
  · have : wordValue m12Of wordK = gK := by
      simp [wordK, wordValue_cons, wordValue_nil, letter_zero, letter_two, letter_three, gK,
        mul_assoc]
    rw [this]
    exact Subgroup.subset_closure ⟨0, rfl⟩

/-- **The presented group of `M₁₂` is finite.** -/
instance finite_group_M12 : Finite M12.Group :=
  haveI : Finite frobSubgroup := frobSubgroup_finite_and_card.1
  haveI : frobSubgroup.FiniteIndex :=
    M12.presentation.finiteIndex_of_run wordValue_subgens run_stage4
  (Subgroup.finite_iff_finite_and_finiteIndex frobSubgroup).mpr ⟨inferInstance, inferInstance⟩

/-- **The presented group of `M₁₂` has at most `95040` elements.** -/
theorem natCard_group_M12_le : Nat.card M12.Group ≤ 95040 := by
  rw [← frobSubgroup.index_mul_card]
  exact (Nat.mul_le_mul (M12.presentation.index_le_of_run wordValue_subgens run_stage4)
    frobSubgroup_finite_and_card.2).trans (by decide)

end TauCeti.SporadicName

namespace TauCeti.Sporadic.M12

/-- The transcribed presentation of `M₁₂` is isomorphic to the canonical permutation model,
via the homomorphism sending its generators to `presentationImage`. -/
noncomputable def presentationEquiv : SporadicName.M12.Group ≃* Sporadic.M12 :=
  MulEquiv.ofBijective
    (SporadicName.M12.presentation.homOfClosureRangeEq
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩
      closure_range_presentationImage)
    ((SporadicName.M12.presentation.surjective_homOfClosureRangeEq
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩
      closure_range_presentationImage).bijective_of_nat_card_le
        (by simpa only [card_M12] using SporadicName.natCard_group_M12_le))

/-- The underlying permutation of the recognition equivalence is the canonical presentation
homomorphism. -/
@[simp]
theorem coe_presentationEquiv (g : SporadicName.M12.Group) :
    (presentationEquiv g : Equiv.Perm (Fin 12)) = presentationHom g := by
  dsimp only [presentationEquiv]
  rw [MulEquiv.ofBijective_apply, GroupPresentation.coe_homOfClosureRangeEq]
  refine DFunLike.congr_fun (PresentedGroup.ext fun i ↦ ?_) g
  rw [GroupPresentation.homEquiv_symm_apply_of, presentationHom_of]

end TauCeti.Sporadic.M12

namespace TauCeti.SporadicName

/-- The group defined by the transcribed presentation of `M₁₂` has exactly `95040` elements. -/
theorem natCard_group_M12 : Nat.card M12.Group = 95040 :=
  (Nat.card_congr Sporadic.M12.presentationEquiv.toEquiv).trans Sporadic.card_M12

/-- **The presented group of `M₁₂` is simple.** -/
