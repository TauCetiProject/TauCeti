/-- The degree-1600 ATLAS permutation model of the Tits group `²F₄(2)′`: the subgroup of
`Equiv.Perm (Fin 1600)` generated by the two standard generators `TitsGroup.a` and
`TitsGroup.b`. -/
def TitsGroup : Subgroup (Equiv.Perm (Fin 1600)) := Subgroup.closure {TitsGroup.a, TitsGroup.b}

/-- The model is generated by the two permutations `TitsGroup.a` and `TitsGroup.b`. -/
theorem titsGroup_def : TitsGroup = Subgroup.closure {TitsGroup.a, TitsGroup.b} := (rfl)

namespace TitsGroup

/-- The first generator lies in the model. -/
@[simp]
theorem a_mem : a ∈ TitsGroup := titsGroup_def ▸ Subgroup.subset_closure (by simp)

/-- The second generator lies in the model. -/
@[simp]
theorem b_mem : b ∈ TitsGroup := titsGroup_def ▸ Subgroup.subset_closure (by simp)

/-! ### Orders -/

/-- The first generator is an involution. -/
theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The second generator has order three. -/
theorem orderOf_b : orderOf b = 3 :=
  have : Fact (Nat.Prime 3) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The product of the two generators has order thirteen. -/
theorem orderOf_a_mul_b : orderOf (a * b) = 13 :=
  have : Fact (Nat.Prime 13) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### The presentation holds and generates the model -/

/-- The images in the permutation model of the generators of the ATLAS presentation of the Tits
group: `a` for the generator of index `0` and `b` for the generator of index `1`. -/
def presentationImage (i : Fin presentation.generatorCount) : Equiv.Perm (Fin 1600) :=
  if (i : ℕ) = 0 then a else b

/-- The assignment unfolded: `a` at index `0` and `b` otherwise. -/
theorem presentationImage_def (i : Fin presentation.generatorCount) :
    presentationImage i = if (i : ℕ) = 0 then a else b :=
  (rfl)

/-- The generator of index `0` goes to `a`. -/
@[simp]
theorem presentationImage_zero (h : 0 < presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = a := by
  simp [presentationImage]

/-- The generator of index `1` goes to `b`. -/
@[simp]
theorem presentationImage_one (h : 1 < presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = b := by
  simp [presentationImage]

/-- The assignment has precisely the two generators of the model as its values. -/
theorem range_presentationImage : Set.range presentationImage = {a, b} := by
  have h : presentation.generatorCount = 2 := by simp
  exact Set.range_ite_const ⟨⟨0, by omega⟩, rfl⟩ ⟨⟨1, by omega⟩, one_ne_zero⟩

/-- **The relators of the Tits group hold in the model.** All six relators of the ATLAS
presentation of the Tits group evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ presentation.transcribed, FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  simp only [presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, presentationImage_zero,
    presentationImage_one]
  decide +kernel

/-- The images of the presentation generators generate exactly the model. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = TitsGroup := by
  rw [range_presentationImage, titsGroup_def]

/-- The homomorphism from the group presented by the ATLAS presentation of the Tits group to
`Equiv.Perm (Fin 1600)` sending the presentation generators to `presentationImage`. -/
def presentationHom : presentation.Group →* Equiv.Perm (Fin 1600) :=
  presentation.homEquiv.symm ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

/-- The homomorphism unfolded: the extension of `presentationImage` given by
`GroupPresentation.homEquiv`. -/
theorem presentationHom_def :
    presentationHom =
      presentation.homEquiv.symm ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

/-- The homomorphism sends each generator of the presented group to its image. -/
@[simp]
theorem presentationHom_of (i : Fin presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model. -/
theorem range_presentationHom : presentationHom.range = TitsGroup :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

/-- **The presented Tits group maps onto the permutation model.** The group defined by the ATLAS
presentation of the Tits group has a surjective homomorphism onto `TitsGroup`. -/
theorem exists_surjective_titsGroup :
    ∃ f : presentation.Group →* TitsGroup, Function.Surjective f :=
  presentation.exists_surjective_of_closure_range_eq
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ closure_range_presentationImage

/-! ### Transitivity -/

