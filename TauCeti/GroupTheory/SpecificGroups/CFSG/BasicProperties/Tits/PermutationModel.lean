  Nat.bitField 8 t i

private theorem rank_lt :
    ∀ x : Fin 1600, x ≠ 0 → rank (a x) < rank x ∨ rank (b x) < rank x := by
  decide +kernel

/-- The model of the Tits group is transitive on its `1600` points. -/
instance instIsPretransitive : IsPretransitive TitsGroup (Fin 1600) := by
  rw [titsGroup_def]
  refine isPretransitive_closure_of_forall_exists_lt 0 rank fun x hx ↦ ?_
  rcases rank_lt x hx with h | h
  · exact ⟨a, by simp, by rwa [Equiv.Perm.smul_def]⟩
  · exact ⟨b, by simp, by rwa [Equiv.Perm.smul_def]⟩

end TitsGroup

/-- The model of the Tits group is nontrivial: it contains the involution `TitsGroup.a`. -/
instance : Nontrivial TitsGroup :=
  TitsGroup.nontrivial_iff_exists_ne_one.2
    ⟨TitsGroup.a, TitsGroup.a_mem, fun h ↦ by simpa [h] using TitsGroup.orderOf_a⟩

/-- The group presented by the ATLAS presentation of the Tits group is nontrivial, since it maps
onto the nontrivial permutation model. -/
instance : Nontrivial TitsGroup.presentation.Group :=
  TitsGroup.exists_surjective_titsGroup.choose_spec.nontrivial

/-- The model of the Tits group is perfect, as a quotient of the perfect group presented by the
ATLAS presentation. -/
instance isPerfect_titsGroup : Group.IsPerfect TitsGroup := by
  obtain ⟨f, hf⟩ := TitsGroup.exists_surjective_titsGroup
  exact Group.IsPerfect.ofSurjective hf

end TauCeti
