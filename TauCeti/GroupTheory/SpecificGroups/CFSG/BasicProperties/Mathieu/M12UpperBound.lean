private theorem step0 (a : Fin 4) (i : Fin 12) :
    ∃ j, (transversal0 j)⁻¹ * signedGenerator generators0 a *
      transversal0 i ∈ Subgroup.closure (Set.range generators1) := by
  have h : ∀ (a : Fin 4) (i : Fin 12) (x : Fin 12),
      signedGenerator generators0 a (transversal0 i x) =
        transversal0 targetIndices0[a][i]
          (evalWord generators1 residueWords0[a][i] x) := by
    decide +kernel
  have heq : signedGenerator generators0 a * transversal0 i =
      transversal0 targetIndices0[a][i] *
        evalWord generators1 residueWords0[a][i] := Equiv.ext (h a i)
  refine ⟨targetIndices0[a][i], ?_⟩
  rw [mul_assoc, heq, inv_mul_cancel_left]
  exact evalWord_mem _ _

private theorem bound0 : Nat.card (Subgroup.closure (Set.range generators0)) ≤
    12 * Nat.card (Subgroup.closure (Set.range generators1)) := by
  have h := Subgroup.natCard_closure_le_mul generators0 transversal0
    (Subgroup.closure (Set.range generators1))
    ⟨0, transversal0_zero⟩ ?_ ?_
  · simpa only [Nat.card_fin] using h
  · intro a i
    simpa only [signedGenerator_castAdd] using step0 (Fin.castAdd 2 a) i
  · intro a i
    simpa only [signedGenerator_natAdd] using step0 (Fin.natAdd 2 a) i

