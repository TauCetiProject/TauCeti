/-!
# The order of the M12 permutation image

A five-level Schreier cover bounds the subgroup generated by the checked degree-12
permutations. The representative counts are `12, 11, 10, 9, 8`; the terminal subgroup
is trivial. Each permutation is specified by its twelve point images and a checked
inverse. Two generators at each level require only 200 signed transitions. Each
Schreier residue is checked against a word in the next level's generators.

The finite-cover argument bounds the image by `95040`, and `M12LowerBound` supplies
the matching lower bound. No finiteness or order claim about the presented group follows
from the finite image. All table entries are checked by kernel reduction; neither the
point-orbit calculation nor its interpretation as a stabilizer chain is assumed.
-/

public section

namespace TauCeti.Sporadic.Mathieu

/-- Permutations from point-image tables with explicitly checked two-sided inverses. -/
private def tablePerms {n : ℕ} (p q : Vector (Vector (Fin 12) 12) n)
    (h : ∀ (i : Fin n) (x : Fin 12), p[i][q[i][x]] = x ∧ q[i][p[i][x]] = x)
    (i : Fin n) : Equiv.Perm (Fin 12) where
  toFun x := p[i][x]
  invFun x := q[i][x]
  left_inv x := (h i x).2
  right_inv x := (h i x).1

/-- The first half of the alphabet consists of generators, and the second of their inverses. -/
private def signedGenerator {n : ℕ} (s : Fin n → Equiv.Perm (Fin 12))
    (i : Fin (n + n)) : Equiv.Perm (Fin 12) :=
  if h : i.val < n then s ⟨i.val, h⟩ else (s ⟨i.val - n, by omega⟩)⁻¹

private theorem signedGenerator_castAdd {n : ℕ} (s : Fin n → Equiv.Perm (Fin 12))
    (i : Fin n) : signedGenerator s (Fin.castAdd n i) = s i := by
  simp [signedGenerator, i.isLt]

private theorem signedGenerator_natAdd {n : ℕ} (s : Fin n → Equiv.Perm (Fin 12))
    (i : Fin n) : signedGenerator s (Fin.natAdd n i) = (s i)⁻¹ := by
  simp [signedGenerator]

/-- Evaluate a signed word as a product, with permutation composition acting right to left. -/
private def evalWord {n : ℕ} (s : Fin n → Equiv.Perm (Fin 12))
    (w : List (Fin (n + n))) : Equiv.Perm (Fin 12) :=
  (w.map (signedGenerator s)).prod

private theorem evalWord_mem {n : ℕ} (s : Fin n → Equiv.Perm (Fin 12))
    (w : List (Fin (n + n))) : evalWord s w ∈ Subgroup.closure (Set.range s) := by
  apply Subgroup.list_prod_mem
  intro g hg
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hg
  unfold signedGenerator
  split
  · exact Subgroup.subset_closure ⟨_, rfl⟩
  · exact Subgroup.inv_mem _ (Subgroup.subset_closure ⟨_, rfl⟩)

