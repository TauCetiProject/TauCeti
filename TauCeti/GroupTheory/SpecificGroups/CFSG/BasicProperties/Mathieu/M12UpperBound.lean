private theorem generators5_closure :
    Subgroup.closure (Set.range generators5) = ⊥ := by
  simp only [Set.range_eq_empty, Subgroup.closure_empty]

private theorem image_le_closure :
    m12PermutationHom.range ≤ Subgroup.closure (Set.range generators0) := by
  have hgen := PresentedGroup.closure_range_of m12Presentation.relatorSet
  have hmap := congrArg (Subgroup.map m12PermutationHom) hgen
  rw [MonoidHom.map_closure, Subgroup.map_top, ← Set.range_comp] at hmap
  rw [← hmap, Subgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  rw [Function.comp_apply, m12PermutationHom_of]
  have hi : i.val < 2 := by simpa [GroupPresentation.generatorCount] using i.isLt
  have h : ∀ j : Fin 2,
      m12GeneratorImages ⟨j.val, by simpa [GroupPresentation.generatorCount] using j.isLt⟩ =
        generators0 j := by
    decide +kernel
  exact Subgroup.subset_closure ⟨⟨i.val, hi⟩, (h ⟨i.val, hi⟩).symm⟩

/-- The checked Schreier cover bounds the concrete M12 permutation image by 95040. -/
theorem m12PermutationHom_range_natCard_le : Nat.card m12PermutationHom.range ≤ 95040 := by
  have h := Nat.card_le_card_of_injective
    (Subgroup.inclusion image_le_closure) (Subgroup.inclusion_injective image_le_closure)
  have h5 : Nat.card (Subgroup.closure (Set.range generators5)) = 1 := by
    rw [generators5_closure]
    exact Subgroup.card_bot
  have h0 := bound0
  have h1 := bound1
  have h2 := bound2
  have h3 := bound3
  have h4 := bound4
  omega

/-- The image of the exact M12 presentation in the checked degree-12 action has order 95040. -/
theorem m12PermutationHom_range_natCard : Nat.card m12PermutationHom.range = 95040 :=
  le_antisymm m12PermutationHom_range_natCard_le m12PermutationHom_range_natCard_ge

