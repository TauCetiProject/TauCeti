  left_inv := by decide
  right_inv := by decide

/-- The generator `M24.b`, given by its tables of images and inverse images. -/
private def bTable : Equiv.Perm (Fin 24) where
  toFun := ![3, 20, 8, 5, 17, 0, 6, 7, 14, 4, 10, 11, 16, 1, 2, 12, 15, 9, 23, 19, 13, 21, 18, 22]
  invFun := ![5, 13, 14, 0, 9, 3, 6, 7, 2, 17, 10, 11, 15, 20, 8, 16, 12, 4, 22, 19, 1, 21, 23, 18]
  left_inv := by decide
  right_inv := by decide

/-- A permutation of `M24` fixing `0`, given by its tables of images and inverse images;
by `g1_eq` it is a word in the ATLAS generators. -/
