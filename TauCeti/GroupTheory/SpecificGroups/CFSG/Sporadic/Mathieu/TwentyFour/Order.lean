  toFun := ![0, 6, 12, 5, 15, 2, 13, 8, 3, 22, 4, 1, 9, 16, 7, 20, 14, 10, 17, 18, 11, 23, 21, 19]
  invFun := ![0, 11, 5, 8, 10, 3, 1, 14, 7, 12, 17, 20, 2, 6, 16, 4, 13, 18, 19, 23, 15, 22, 9, 21]
  left_inv := by decide
  right_inv := by decide

