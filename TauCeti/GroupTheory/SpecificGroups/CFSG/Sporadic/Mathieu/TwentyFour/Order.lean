private theorem g1_eq : g1 = bTable⁻¹ * aTable := by
  decide +kernel

private theorem h1_eq : h1 = bTable * aTable * bTable * aTable * bTable * aTable * bTable * aTable *
    bTable * aTable * bTable⁻¹ * aTable * bTable⁻¹ * aTable * bTable⁻¹ * aTable * bTable⁻¹ *
    aTable * bTable⁻¹ * aTable * bTable⁻¹ := by
  decide +kernel

private theorem g2_eq : g2 = h1 * g1 * h1 * g1⁻¹ * h1 := by
  decide +kernel

private theorem h2_eq : h2 = g1⁻¹ * g1⁻¹ * h1 * g1⁻¹ * h1 * g1 * g1 * g1 * g1 := by
  decide +kernel

private theorem g3_eq : g3 = g2 * h2 * g2⁻¹ * h2 * h2 * g2 * g2 := by
  decide +kernel

private theorem h3_eq : h3 = g2 * g2 * g2 * h2 * h2 * h2 * g2 := by
  decide +kernel

private theorem g4_eq : g4 = h3⁻¹ * h3⁻¹ * g3⁻¹ * g3⁻¹ * h3 * g3 * h3 := by
  decide +kernel

private theorem h4_eq : h4 = h3 * h3 * g3⁻¹ * g3⁻¹ * h3 * h3 := by
  decide +kernel

private theorem g5_eq : g5 = g4⁻¹ * h4 * h4 * g4⁻¹ := by
  decide +kernel

private theorem h5_eq : h5 = g4⁻¹ * h4 * g4 * h4 * g4⁻¹ * g4⁻¹ * h4 := by
  decide +kernel

private theorem k5_eq : k5 = h4⁻¹ * g4⁻¹ * h4 * g4⁻¹ * g4⁻¹ * h4⁻¹ * g4⁻¹ := by
  decide +kernel

private theorem g6_eq : g6 = g5 * h5 * h5 * k5⁻¹ := by
  decide +kernel

private theorem aTable_eq : aTable = a := by decide +kernel

private theorem bTable_eq : bTable = b := by decide +kernel

/-- The fourteen tables lie in `M24`. -/
private theorem tables_mem :
    aTable ∈ M24 ∧ bTable ∈ M24 ∧ g1 ∈ M24 ∧ h1 ∈ M24 ∧ g2 ∈ M24 ∧ h2 ∈ M24 ∧ g3 ∈ M24 ∧
      h3 ∈ M24 ∧ g4 ∈ M24 ∧ h4 ∈ M24 ∧ g5 ∈ M24 ∧ h5 ∈ M24 ∧ k5 ∈ M24 ∧ g6 ∈ M24 := by
  have ha : aTable ∈ M24 := aTable_eq ▸ a_mem
  have hb : bTable ∈ M24 := bTable_eq ▸ b_mem
  have hg1 : g1 ∈ M24 := by
    simp only [g1_eq, mul_mem_cancel_right ha, inv_mem_iff, hb]
  have hh1 : h1 ∈ M24 := by
    simp only [h1_eq, mul_mem_cancel_right ha, mul_mem_cancel_right hb,
      mul_mem_cancel_right (inv_mem hb), hb]
  have hg2 : g2 ∈ M24 := by
    simp only [g2_eq, mul_mem_cancel_right hg1, mul_mem_cancel_right (inv_mem hg1),
      mul_mem_cancel_right hh1, hh1]
  have hh2 : h2 ∈ M24 := by
    simp only [h2_eq, mul_mem_cancel_right hg1, mul_mem_cancel_right (inv_mem hg1),
      mul_mem_cancel_right hh1, inv_mem_iff, hg1]
  have hg3 : g3 ∈ M24 := by
    simp only [g3_eq, mul_mem_cancel_right hg2, mul_mem_cancel_right (inv_mem hg2),
      mul_mem_cancel_right hh2, hg2]
  have hh3 : h3 ∈ M24 := by
    simp only [h3_eq, mul_mem_cancel_right hg2, mul_mem_cancel_right hh2, hg2]
  have hg4 : g4 ∈ M24 := by
    simp only [g4_eq, mul_mem_cancel_right hg3, mul_mem_cancel_right (inv_mem hg3),
      mul_mem_cancel_right hh3, mul_mem_cancel_right (inv_mem hh3), inv_mem_iff, hh3]
  have hh4 : h4 ∈ M24 := by
    simp only [h4_eq, mul_mem_cancel_right (inv_mem hg3), mul_mem_cancel_right hh3, hh3]
  have hg5 : g5 ∈ M24 := by
    simp only [g5_eq, mul_mem_cancel_right (inv_mem hg4), mul_mem_cancel_right hh4, inv_mem_iff,
      hg4]
  have hh5 : h5 ∈ M24 := by
    simp only [h5_eq, mul_mem_cancel_right hg4, mul_mem_cancel_right (inv_mem hg4),
      mul_mem_cancel_right hh4, inv_mem_iff, hg4]
  have hk5 : k5 ∈ M24 := by
    simp only [k5_eq, mul_mem_cancel_right (inv_mem hg4), mul_mem_cancel_right hh4,
      mul_mem_cancel_right (inv_mem hh4), inv_mem_iff, hh4]
  have hg6 : g6 ∈ M24 := by
    simp only [g6_eq, mul_mem_cancel_right hh5, mul_mem_cancel_right (inv_mem hk5), hg5]
  exact ⟨ha, hb, hg1, hh1, hg2, hh2, hg3, hh3, hg4, hh4, hg5, hh5, hk5, hg6⟩

/-- Representatives along the base `0, 1, 2, 3, 4, 5, 6`: for `i < 7`, the list `transversal i`
consists of elements of `M24`, written as products of at most three of the tables above and their
inverses, that fix `0, …, i - 1` and send `i` to each point of its basic orbit, in increasing
order. -/
private def transversal : ℕ → List (Equiv.Perm (Fin 24))
  | 0 => [1, h1⁻¹ * aTable, g1 * bTable⁻¹, aTable, h1⁻¹ * bTable⁻¹, bTable⁻¹, h2 * bTable⁻¹,
      g2⁻¹ * bTable⁻¹, g1⁻¹ * aTable, h2⁻¹ * aTable, g2⁻¹ * aTable, g2 * aTable, h4⁻¹ * bTable⁻¹,
      h2⁻¹ * bTable⁻¹, h3 * bTable⁻¹, h1 * aTable, h3⁻¹ * aTable, k5⁻¹ * bTable⁻¹,
      g5 * g1⁻¹ * aTable, g3 * bTable⁻¹, h3⁻¹ * bTable⁻¹, h3 * aTable, h2 * aTable, h4 * bTable⁻¹]
  | 1 => [1, h1 * g1, h1, g1⁻¹ * h1⁻¹, h2⁻¹ * g1, g1, g3⁻¹ * g1⁻¹, g2 * g1⁻¹, h2⁻¹ * h1, h4 * g1⁻¹,
      g1⁻¹, g5⁻¹ * h1⁻¹, g1 * g1, g4⁻¹ * g1, h1⁻¹, h2 * g1⁻¹, g4 * g1, h2 * g1, h5 * g1,
      g1⁻¹ * g1⁻¹, h3⁻¹ * g1, g3 * g1, h2⁻¹ * h1⁻¹]
  | 2 => [1, h2⁻¹ * h2⁻¹, g2⁻¹ * g2⁻¹, h2⁻¹ * g2, g2, h4 * g2⁻¹, h5⁻¹ * g2⁻¹, g5⁻¹ * g2⁻¹,
      g4 * g2⁻¹, h3 * g2, g5 * h2, h2, g4⁻¹ * g2, g2 * g2, g4⁻¹ * h2, g4 * g2, h2 * g2, h5 * g2,
      g2⁻¹, h3⁻¹ * g2, h2⁻¹, h2 * g2⁻¹]
  | 3 => [1, h3 * g3⁻¹, g3, h5 * g3, h5⁻¹ * h3, g3 * h3, g3⁻¹, g5 * h3⁻¹, k5 * g3, h4⁻¹ * g3,
      g4⁻¹ * g3⁻¹, h3 * g3, g6 * h3, h3⁻¹, k5⁻¹ * g3, h5 * g3⁻¹, g3 * g3, h3⁻¹ * g3, h3,
      h5⁻¹ * g3⁻¹, h4 * g3]
  | 4 => [1, h4 * g4, h5⁻¹ * g4⁻¹, g6 * g4, g4 * g4, h4⁻¹ * g4, g4 * h4, g6 * h4⁻¹, g4, g5⁻¹ * g4,
      h5 * g4, g5 * g4, g4⁻¹ * g5⁻¹ * g4, g5 * g4⁻¹, g6⁻¹ * g4, g4⁻¹, h4, g5⁻¹ * h4⁻¹, h4⁻¹,
      h4⁻¹ * g4⁻¹]
  | 5 => [1, h5, k5 * g5⁻¹, h5⁻¹ * g5⁻¹, g5, k5, k5⁻¹ * h5⁻¹, k5 * g5, g6⁻¹ * g5, k5⁻¹ * g5⁻¹, k5⁻¹,
      h5 * g5, h5⁻¹, g5⁻¹, g5 * h5, h5⁻¹ * g5]
  | 6 => [1, g6⁻¹, g6]
  | _ => []

private theorem mem_transversal : ∀ i < 7, ∀ r ∈ transversal i, r ∈ M24 := by
  obtain ⟨ha, hb, hg1, hh1, hg2, hh2, hg3, hh3, hg4, hh4, hg5, hh5, hk5, hg6⟩ := tables_mem
  intro i hi
  interval_cases i <;>
  simp only [transversal, List.forall_mem_cons, List.not_mem_nil, IsEmpty.forall_iff, implies_true,
    mul_mem_cancel_right ha, mul_mem_cancel_right (inv_mem hb), mul_mem_cancel_right hg1,
    mul_mem_cancel_right (inv_mem hg1), mul_mem_cancel_right hh1,
    mul_mem_cancel_right (inv_mem hh1), mul_mem_cancel_right hg2,
    mul_mem_cancel_right (inv_mem hg2), mul_mem_cancel_right hh2,
    mul_mem_cancel_right (inv_mem hh2), mul_mem_cancel_right hg3,
    mul_mem_cancel_right (inv_mem hg3), mul_mem_cancel_right hh3,
    mul_mem_cancel_right (inv_mem hh3), mul_mem_cancel_right hg4,
    mul_mem_cancel_right (inv_mem hg4), mul_mem_cancel_right hh4,
    mul_mem_cancel_right (inv_mem hh4), mul_mem_cancel_right hg5,
    mul_mem_cancel_right (inv_mem hg5), mul_mem_cancel_right hh5,
    mul_mem_cancel_right (inv_mem hh5), inv_mem_iff, one_mem, ha, hb, hg1, hh1, hg2, hh2, hg3, hh3,
    hg4, hh4, hg5, hh5, hk5, hg6, and_self]

private theorem le_closure_tables : M24 ≤ Subgroup.closure {g | g ∈ [aTable, bTable]} := by
  rw [M24_def, aTable_eq, bTable_eq]
  exact Subgroup.closure_mono (by simp [Set.insert_subset_iff])

private theorem transversalCheck_eq_true :
    TauCeti.transversalCheck (Fin.ofNat 24) transversal 7 = true := by
  decide +kernel

private theorem sift_tables :
    [aTable, bTable].all (TauCeti.sift (Fin.ofNat 24) transversal 0 7 1) = true := by
  decide +kernel

/- Split the sifting checks by both levels `i` and `j`, so each kernel computation checks only
one pair of transversal lists and keeps its reduction cache small. The separate lemmas also keep
the total work of each proof within the default heartbeat budget. -/
private def siftPairCheck (i j : ℕ) : Bool :=
  (transversal j).all fun s ↦ (transversal i).all fun r ↦
    TauCeti.sift (Fin.ofNat 24) transversal i (7 - i) 1 (s * r)

private theorem siftPairCheck_0_0 : siftPairCheck 0 0 = true := by
  decide +kernel

