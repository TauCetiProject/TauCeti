module

public import TauCeti.GroupTheory.GroupAction.Simple.PrimeSucc
public import TauCeti.GroupTheory.IsPerfect
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Mathieu.TwentyFour.PermutationModel
public import TauCeti.GroupTheory.Subgroup.NormalGeneration

/-!
# Perfectness and simplicity of the permutation model of `M₂₄`

The canonical permutation model `TauCeti.Sporadic.M24` of the Mathieu group `M₂₄`, generated by
the two ATLAS permutations `a` and `b` of `Fin 24`, is perfect and simple.

Perfectness is read off from the orders `2`, `3` and `23` of `a`, `b` and `a * b`: they are
pairwise coprime, so every homomorphism from the model to a commutative group is trivial
(`TauCeti.isPerfect_of_coprime_pow_eq_one`). In a perfect group generated by two elements, their
product is a normal generator (`Subgroup.normalClosure_singleton_mul_eq_top`), so the normal
closure of `a * b` is the whole model.

Simplicity then follows from the criterion
`TauCeti.isSimpleGroup_of_normalClosure_eq_top_of_card_eq_succ` for transitive groups of degree
`p + 1`, applied with `p = 23`: the model acts faithfully and transitively on `24 = 23 + 1`
points, the two primes `2` and `3` divide `24`, and the element `a * b` of order `23` normally
generates the model. Neither the order of the model nor the structure of a point stabilizer
enters. This file concerns the permutation model, not the abstract presentation
`TauCeti.SporadicName.M24.Group`.

## Main results

* `TauCeti.Sporadic.isPerfect_M24`: the permutation model of `M₂₄` is perfect.
* `TauCeti.Sporadic.M24.normalClosure_a_mul_b_eq_top`: the element `a * b` of order `23`
  normally generates the model.
* `TauCeti.Sporadic.isSimpleGroup_M24`: the permutation model of `M₂₄` is simple.

## References

* J. D. Dixon and B. Mortimer, *Permutation Groups*, Graduate Texts in Mathematics 163, Springer,
  1996, §1.6, for normal subgroups of primitive permutation groups.
* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `M24G1-p24B0`, <https://brauer.maths.qmul.ac.uk/Atlas/v3/>, for the
  generators documented in the permutation-model module.
-/

public section

namespace TauCeti.Sporadic

/-- **The permutation model of `M₂₄` is perfect.** -/
instance isPerfect_M24 : Group.IsPerfect M24 :=
  isPerfect_of_coprime_pow_eq_one (a := 2) (b := 3) (c := 23) M24.closure_pair_eq_top
    (orderOf_dvd_iff_pow_eq_one.mp (by simp [Subgroup.orderOf_mk, M24.orderOf_a]))
    (orderOf_dvd_iff_pow_eq_one.mp (by simp [Subgroup.orderOf_mk, M24.orderOf_b]))
    (orderOf_dvd_iff_pow_eq_one.mp (by simp [Subgroup.orderOf_mk, M24.orderOf_a_mul_b]))
    (by decide) (by decide) (by decide)

namespace M24

/-- The element `a * b` of order `23` generates the model as a normal subgroup. -/
theorem normalClosure_a_mul_b_eq_top :
    Subgroup.normalClosure {(⟨a * b, mul_mem a_mem b_mem⟩ : M24)} = ⊤ := by
  simpa only [MulMemClass.mk_mul_mk] using
    Subgroup.normalClosure_singleton_mul_eq_top (⟨a, a_mem⟩ : M24) ⟨b, b_mem⟩ closure_pair_eq_top

end M24

/-- **The canonical `24`-point permutation model of `M₂₄` is simple.** -/
instance isSimpleGroup_M24 : IsSimpleGroup M24 :=
  isSimpleGroup_of_normalClosure_eq_top_of_card_eq_succ (X := Fin 24) (p := 23)
    (by decide) (by simp) Nat.prime_two Nat.prime_three (by decide) (by simp) (by simp) _
    (orderOf_dvd_iff_pow_eq_one.mp (by simp [Subgroup.orderOf_mk, M24.orderOf_a_mul_b]))
    M24.normalClosure_a_mul_b_eq_top

end TauCeti.Sporadic
