module

public import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Mathieu.TwentyFour.Order
public import TauCeti.InformationTheory.Coding.Binary.Golay.Automorphism

/-!
# Identification of `M₂₄` with the permutation automorphism group of the binary Golay code

The permutation model `TauCeti.Sporadic.M24` is generated by the ATLAS permutations `M24.a` and
`M24.b` on `Fin 24`, whereas the extended binary Golay code `TauCeti.BinaryGolay.code` is defined by
its systematic bordered reverse-circulant generator `[I₁₂ | B]` on `Fin 24`. The explicit coordinate
permutation `TauCeti.Sporadic.M24.golayCoordPerm` translates the ATLAS point numbering into the
systematic Golay numbering:

```text
golayCoordPerm = (6, 7, 16, 21, 14, 13, 18, 20)(8, 9, 10, 17, 12, 22, 19, 15, 11).
```

Reindexing `TauCeti.BinaryGolay.code` along `golayCoordPerm` yields the permutation-equivalent Golay
code `TauCeti.Sporadic.M24.golayCode`, preserved directly by `M24.a` and `M24.b`. Conjugating by
`golayCoordPerm` embeds `M24` into `AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup`.

Combining the exact order `Nat.card M24 = 244823040` (`TauCeti.Sporadic.card_M24`) with the octad
rigidity upper bound `Nat.card (AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup) ≤
244823040` (`TauCeti.BinaryGolay.natCard_permutationAut_code_toAddSubgroup_le`) forces equality of
the subgroups via `Subgroup.eq_of_le_of_card_ge`.

This produces explicit group isomorphisms between `M24` and both the coordinate-permutation
automorphism group `AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup` and the linear-code
permutation automorphism group `TauCeti.permutationAut BinaryGolay.code`, equivariant with respect
to `golayCoordPerm`, together with the direct linear automorphism isomorphism
`M24.golayCodePermutationAutEquiv` for `M24.golayCode`, and determines the exact order `244823040`
of the Golay permutation automorphism groups.

## Main declarations

* `TauCeti.Sporadic.M24.golayCoordPerm`: coordinate permutation identifying the ATLAS `M24`
  coordinates with the coordinates of `TauCeti.BinaryGolay.code`.
* `TauCeti.Sporadic.M24.golayCode`: the extended binary Golay code reindexed into `M24`'s ATLAS
  coordinates.
* `TauCeti.Sporadic.M24.map_permCongrHom_golayCoordPerm`: conjugating `M24` by `golayCoordPerm`
  gives `AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup`.
* `TauCeti.Sporadic.M24.eq_permutationAut_golayCode`: `M24` equals the coordinate permutation
  automorphism group of `M24.golayCode`.
* `TauCeti.Sporadic.M24.golayAdditivePermutationAutEquiv`: explicit group isomorphism
  `M24 ≃* AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup` compatible with
  `golayCoordPerm` on `Fin 24`.
* `TauCeti.Sporadic.M24.golayPermutationAutEquiv`: explicit group isomorphism
  `M24 ≃* TauCeti.permutationAut BinaryGolay.code` compatible with `golayCoordPerm` on ambient
  vectors.
* `TauCeti.Sporadic.M24.golayCodePermutationAutEquiv`: explicit group isomorphism
  `M24 ≃* TauCeti.permutationAut M24.golayCode` compatible with `M24`'s natural action on `Fin 24`.
* `TauCeti.BinaryGolay.natCard_permutationAut_code_toAddSubgroup`,
  `TauCeti.BinaryGolay.natCard_permutationAut_code`: the exact order `244823040`.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Springer,
  1999, Chapter 10, §2.
* W. C. Huffman and V. Pless, *Fundamentals of Error-Correcting Codes*, Cambridge University Press,
  2003, §10.2.
* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `M24G1-p24B0`.
-/

public section

namespace TauCeti.Sporadic

namespace M24

/-! ### Coordinate identification and the ATLAS-numbered Golay code -/

/-- The coordinate permutation sending the zero-based ATLAS coordinates of `M24` (`M24G1-p24B0`) to
the systematic coordinates of `TauCeti.BinaryGolay.code`. It fixes `0, 1, 2, 3, 4, 5, 23` and maps
`10` to `17`. Its body is exposed so importing modules can evaluate coordinate images in the
kernel. -/
@[expose] def golayCoordPerm : Equiv.Perm (Fin 24) :=
  c[6, 7, 16, 21, 14, 13, 18, 20] * c[8, 9, 10, 17, 12, 22, 19, 15, 11]

/-- Cycle decomposition of `golayCoordPerm`. -/
theorem golayCoordPerm_def :
    golayCoordPerm = c[6, 7, 16, 21, 14, 13, 18, 20] * c[8, 9, 10, 17, 12, 22, 19, 15, 11] :=
  (rfl)

/-- The extended binary Golay code in the coordinate numbering of `M24`, obtained by reindexing
`TauCeti.BinaryGolay.code` along `golayCoordPerm`. -/
noncomputable def golayCode : LinearCode (ZMod 2) (Fin 24) :=
  TauCeti.reindex TauCeti.BinaryGolay.code golayCoordPerm

/-- Unfolds `golayCode` as the reindexing of `BinaryGolay.code` along `golayCoordPerm`. -/
theorem golayCode_def : golayCode = TauCeti.reindex TauCeti.BinaryGolay.code golayCoordPerm :=
  (rfl)

/-- `M24.golayCode` is permutation equivalent to `TauCeti.BinaryGolay.code`. -/
theorem isPermutationEquivalent_golayCode :
    TauCeti.IsPermutationEquivalent golayCode TauCeti.BinaryGolay.code :=
  TauCeti.isPermutationEquivalent_reindex TauCeti.BinaryGolay.code golayCoordPerm

/-- Generator matrix of `M24.golayCode`, obtained by permuting the columns of
`TauCeti.BinaryGolay.generator` along `golayCoordPerm`. -/
def golayGenerator : Matrix (Fin 12) (Fin 24) (ZMod 2) :=
  TauCeti.BinaryGolay.generator.submatrix id golayCoordPerm

/-- Unfolds `golayGenerator` as a column-permuted submatrix of `BinaryGolay.generator`. -/
theorem golayGenerator_def :
    golayGenerator = TauCeti.BinaryGolay.generator.submatrix id golayCoordPerm :=
  (rfl)

/-- The row space of `golayGenerator` is `M24.golayCode`. -/
theorem generatedBy_golayGenerator : golayGenerator.generatedBy = golayCode := by
  rw [golayGenerator_def, Matrix.generatedBy_submatrix_equiv, ← TauCeti.BinaryGolay.code_def,
    ← TauCeti.reindex_def, ← golayCode_def]

/-! ### Subgroup inclusion and identification with `M24` -/

/-- Conjugating `M24.a` by `golayCoordPerm` gives a permutation automorphism of
`BinaryGolay.code`. -/
theorem permCongr_a_mem_permutationAut :
    golayCoordPerm.permCongr a ∈
      TauCeti.AdditiveCode.permutationAut TauCeti.BinaryGolay.code.toAddSubgroup := by
  decide +kernel

/-- Conjugating `M24.b` by `golayCoordPerm` gives a permutation automorphism of
`BinaryGolay.code`. -/
theorem permCongr_b_mem_permutationAut :
    golayCoordPerm.permCongr b ∈
      TauCeti.AdditiveCode.permutationAut TauCeti.BinaryGolay.code.toAddSubgroup := by
  decide +kernel

/-- `M24.a` preserves `M24.golayCode`. -/
theorem a_mem_permutationAut_golayCode :
    a ∈ TauCeti.AdditiveCode.permutationAut golayCode.toAddSubgroup := by
  rw [golayCode_def, TauCeti.AdditiveCode.mem_permutationAut_reindex_toAddSubgroup]
  exact permCongr_a_mem_permutationAut

/-- `M24.b` preserves `M24.golayCode`. -/
theorem b_mem_permutationAut_golayCode :
    b ∈ TauCeti.AdditiveCode.permutationAut golayCode.toAddSubgroup := by
  rw [golayCode_def, TauCeti.AdditiveCode.mem_permutationAut_reindex_toAddSubgroup]
  exact permCongr_b_mem_permutationAut

/-- Every permutation in `M24` preserves `M24.golayCode`. -/
theorem le_permutationAut_golayCode :
    M24 ≤ TauCeti.AdditiveCode.permutationAut golayCode.toAddSubgroup := by
  rw [M24_def, Subgroup.closure_le]
  rintro σ (rfl | rfl)
  · exact a_mem_permutationAut_golayCode
  · exact b_mem_permutationAut_golayCode

/-- Conjugating `M24` by `golayCoordPerm` lands inside the permutation automorphism group of
`BinaryGolay.code`. -/
theorem map_permCongrHom_golayCoordPerm_le :
    M24.map golayCoordPerm.permCongrHom.toMonoidHom ≤
      TauCeti.AdditiveCode.permutationAut TauCeti.BinaryGolay.code.toAddSubgroup := by
  rw [Subgroup.map_le_iff_le_comap]
  refine le_permutationAut_golayCode.trans fun σ hσ ↦ ?_
  rwa [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, Equiv.permCongrHom_coe,
    ← TauCeti.AdditiveCode.mem_permutationAut_reindex_toAddSubgroup, ← golayCode_def]

/-- **Conjugating `M24` by `golayCoordPerm` yields the full coordinate permutation automorphism
group of `TauCeti.BinaryGolay.code`.** -/
theorem map_permCongrHom_golayCoordPerm :
    M24.map golayCoordPerm.permCongrHom.toMonoidHom =
      TauCeti.AdditiveCode.permutationAut TauCeti.BinaryGolay.code.toAddSubgroup := by
  refine Subgroup.eq_of_le_of_card_ge map_permCongrHom_golayCoordPerm_le ?_
  rw [MulEquiv.toMonoidHom_eq_coe,
    ← Nat.card_congr (golayCoordPerm.permCongrHom.subgroupMap M24).toEquiv,
    TauCeti.Sporadic.card_M24]
  exact TauCeti.BinaryGolay.natCard_permutationAut_code_toAddSubgroup_le

/-- **`M24` is the full coordinate permutation automorphism group of `M24.golayCode`.** -/
theorem eq_permutationAut_golayCode :
    M24 = TauCeti.AdditiveCode.permutationAut golayCode.toAddSubgroup := by
  have hmap := map_permCongrHom_golayCoordPerm
  rw [MulEquiv.toMonoidHom_eq_coe] at hmap
  rw [golayCode_def, ← TauCeti.AdditiveCode.reindex_toAddSubgroup,
    TauCeti.AdditiveCode.permutationAut_reindex, ← Equiv.permCongrHom_symm,
    MulEquiv.toMonoidHom_eq_coe]
  exact ((Subgroup.map_symm_eq_iff_map_eq M24).mpr hmap).symm

/-! ### Explicit group isomorphisms and coordinate action compatibility -/

/-- Explicit group isomorphism from `M24` to the coordinate permutation automorphism group of
`TauCeti.BinaryGolay.code`, acting by conjugation along `golayCoordPerm`. -/
noncomputable def golayAdditivePermutationAutEquiv :
    M24 ≃* TauCeti.AdditiveCode.permutationAut TauCeti.BinaryGolay.code.toAddSubgroup :=
  (MulEquiv.subgroupCongr (by
    rw [TauCeti.AdditiveCode.reindex_toAddSubgroup, ← golayCode_def,
      ← eq_permutationAut_golayCode])).trans
    (TauCeti.AdditiveCode.reindexPermutationAutEquiv
      TauCeti.BinaryGolay.code.toAddSubgroup golayCoordPerm).symm

/-- `golayAdditivePermutationAutEquiv` conjugates underlying permutations along `golayCoordPerm`. -/
@[simp]
theorem coe_golayAdditivePermutationAutEquiv_apply (g : M24) :
    (golayAdditivePermutationAutEquiv g : Equiv.Perm (Fin 24)) =
      golayCoordPerm.permCongr (g : Equiv.Perm (Fin 24)) := by
  simp [golayAdditivePermutationAutEquiv]

/-- The inverse of `golayAdditivePermutationAutEquiv` conjugates underlying permutations along
`golayCoordPerm.symm`. -/
@[simp]
theorem coe_golayAdditivePermutationAutEquiv_symm_apply
    (h : TauCeti.AdditiveCode.permutationAut TauCeti.BinaryGolay.code.toAddSubgroup) :
    (golayAdditivePermutationAutEquiv.symm h : Equiv.Perm (Fin 24)) =
      golayCoordPerm.symm.permCongr (h : Equiv.Perm (Fin 24)) := by
  simp [golayAdditivePermutationAutEquiv]

/-- `golayCoordPerm` intertwines the action of `M24` on `Fin 24` with that of
`AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup` via
`golayAdditivePermutationAutEquiv`. -/
@[simp]
theorem golayAdditivePermutationAutEquiv_smul_golayCoordPerm (g : M24) (i : Fin 24) :
    golayAdditivePermutationAutEquiv g • golayCoordPerm i = golayCoordPerm (g • i) := by
  rw [Subgroup.smul_def, coe_golayAdditivePermutationAutEquiv_apply, Equiv.Perm.smul_def,
    Equiv.permCongr_apply, Equiv.symm_apply_apply, Subgroup.smul_def, Equiv.Perm.smul_def]

/-- Explicit group isomorphism from `M24` to the full linear permutation automorphism group
`TauCeti.permutationAut TauCeti.BinaryGolay.code`. -/
noncomputable def golayPermutationAutEquiv :
    M24 ≃* TauCeti.permutationAut TauCeti.BinaryGolay.code :=
  golayAdditivePermutationAutEquiv.trans
    (TauCeti.AdditiveCode.permutationAutToAddSubgroupMulEquiv TauCeti.BinaryGolay.code)

/-- `golayPermutationAutEquiv` sends `g : M24` to coordinate relabelling along
`(golayCoordPerm.permCongr g).symm`. -/
@[simp]
theorem coe_golayPermutationAutEquiv_apply (g : M24) :
    (golayPermutationAutEquiv g : (Fin 24 → ZMod 2) ≃ₗ[ZMod 2] (Fin 24 → ZMod 2)) =
      LinearEquiv.funCongrLeft (ZMod 2) (ZMod 2)
        (golayCoordPerm.permCongr (g : Equiv.Perm (Fin 24))).symm := by
  rw [golayPermutationAutEquiv, MulEquiv.trans_apply,
    TauCeti.AdditiveCode.coe_permutationAutToAddSubgroupMulEquiv_apply,
    coe_golayAdditivePermutationAutEquiv_apply]

/-- Compatibility of `golayPermutationAutEquiv` with the coordinate actions on `Fin 24`: applying
`golayPermutationAutEquiv g` to an ambient vector `x` transports coordinate `golayCoordPerm i` to
coordinate `golayCoordPerm (g • i)`. -/
theorem golayPermutationAutEquiv_apply_golayCoordPerm (g : M24) (x : Fin 24 → ZMod 2)
    (i : Fin 24) :
    (golayPermutationAutEquiv g : (Fin 24 → ZMod 2) ≃ₗ[ZMod 2] (Fin 24 → ZMod 2)) x
      (golayCoordPerm (g • i)) = x (golayCoordPerm i) := by
  have hi : (golayCoordPerm.permCongr (g : Equiv.Perm (Fin 24))).symm
      (golayCoordPerm (g • i)) = golayCoordPerm i := by
    apply (golayCoordPerm.permCongr (g : Equiv.Perm (Fin 24))).injective
    rw [Equiv.apply_symm_apply, Equiv.permCongr_apply, Equiv.symm_apply_apply,
      Subgroup.smul_def, Equiv.Perm.smul_def]
  rw [coe_golayPermutationAutEquiv_apply, LinearEquiv.funCongrLeft_apply,
    LinearMap.funLeft_apply, hi]

/-- Explicit group isomorphism from `M24` to the full linear permutation automorphism group of
`M24.golayCode`. -/
noncomputable def golayCodePermutationAutEquiv :
    M24 ≃* TauCeti.permutationAut golayCode :=
  (MulEquiv.subgroupCongr eq_permutationAut_golayCode).trans
    (TauCeti.AdditiveCode.permutationAutToAddSubgroupMulEquiv golayCode)

/-- `golayCodePermutationAutEquiv` sends `g : M24` directly to `LinearEquiv.funCongrLeft` along
`g.symm`. -/
@[simp]
theorem coe_golayCodePermutationAutEquiv_apply (g : M24) :
    (golayCodePermutationAutEquiv g : (Fin 24 → ZMod 2) ≃ₗ[ZMod 2] (Fin 24 → ZMod 2)) =
      LinearEquiv.funCongrLeft (ZMod 2) (ZMod 2) (g : Equiv.Perm (Fin 24)).symm := by
  rw [golayCodePermutationAutEquiv, MulEquiv.trans_apply,
    TauCeti.AdditiveCode.coe_permutationAutToAddSubgroupMulEquiv_apply,
    MulEquiv.subgroupCongr_apply]

/-- Compatibility of `golayCodePermutationAutEquiv` with the natural action of `M24` on `Fin 24`:
applying `golayCodePermutationAutEquiv g` to an ambient vector `x` transports coordinate `i` to
coordinate `g • i`. -/
theorem golayCodePermutationAutEquiv_apply_smul (g : M24) (x : Fin 24 → ZMod 2) (i : Fin 24) :
    (golayCodePermutationAutEquiv g : (Fin 24 → ZMod 2) ≃ₗ[ZMod 2] (Fin 24 → ZMod 2)) x
      (g • i) = x i := by
  rw [coe_golayCodePermutationAutEquiv_apply, LinearEquiv.funCongrLeft_apply,
    LinearMap.funLeft_apply, Subgroup.smul_def, Equiv.Perm.smul_def, Equiv.symm_apply_apply]

end M24

end TauCeti.Sporadic

namespace TauCeti.BinaryGolay

/-! ### Exact group orders -/

/-- **The coordinate permutation automorphism group of `BinaryGolay.code` has order `244823040`.**
-/
@[simp↓]
theorem natCard_permutationAut_code_toAddSubgroup :
    Nat.card (AdditiveCode.permutationAut code.toAddSubgroup) = 244823040 := by
  rw [← Nat.card_congr Sporadic.M24.golayAdditivePermutationAutEquiv.toEquiv,
    Sporadic.card_M24]

/-- **The linear permutation automorphism group of `BinaryGolay.code` has order `244823040`.** -/
@[simp↓]
theorem natCard_permutationAut_code :
    Nat.card (TauCeti.permutationAut code) = 244823040 := by
  rw [← AdditiveCode.natCard_permutationAut_toAddSubgroup,
    natCard_permutationAut_code_toAddSubgroup]

end TauCeti.BinaryGolay
