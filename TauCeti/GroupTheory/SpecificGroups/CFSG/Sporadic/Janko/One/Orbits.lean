private theorem orbitWords_apply : ∀ x, wordValue (orbitWords x) 0 = x := by
  decide +kernel

/-- The exact ATLAS first Janko model is transitive on its 266 points. -/
instance : IsPretransitive J1 (Fin 266) :=
  (isPretransitive_iff_base (0 : Fin 266)).mpr fun x =>
    ⟨⟨wordValue (orbitWords x), wordValue_mem _⟩, orbitWords_apply x⟩

/-- The point sequence `0, 1, 2, …` (modulo 266) used for the first Janko stabilizer chain.
The first three points are the prescribed points for the order calculation. -/
def pointSequence (i : ℕ) : Fin 266 := Fin.ofNat 266 i

/-- Evaluation of the point sequence modulo 266. -/
@[simp]
theorem pointSequence_apply (i : ℕ) : pointSequence i = Fin.ofNat 266 i := (rfl)

/-- The first basic orbit of the first Janko model has length 266. -/
@[simp]
theorem ncard_orbit_stabilizerChain_zero :
    (orbit (J1.stabilizerChain pointSequence 0) (0 : Fin 266)).ncard = 266 := by
  rw [Subgroup.stabilizerChain_zero]
  simp [orbit_eq_univ]

