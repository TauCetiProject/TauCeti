private def related (x y : Fin 266) : Bool := (relationRows x).testBit y.val

private theorem related_a : ∀ x y, related (a x) (a y) = related x y := by
  decide +kernel

private theorem related_b : ∀ x y, related (b x) (b y) = related x y := by
  decide +kernel

private theorem related_apply {g : Equiv.Perm (Fin 266)} (hg : g ∈ J1) :
    ∀ x y, related (g x) (g y) = related x y := by
  rw [J1_def] at hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with rfl | rfl
    · exact related_a
    · exact related_b
  | one => simp
  | mul g h _ _ hg hh =>
    intro x y
    rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hg, hh]
  | inv g _ hg =>
    intro x y
    simpa using (hg (g⁻¹ x) (g⁻¹ y)).symm

