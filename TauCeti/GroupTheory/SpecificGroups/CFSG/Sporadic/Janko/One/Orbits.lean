/-- The complete orbit of `1` under the stabilizer of `0` in the ATLAS model. -/
theorem orbit_stabilizerChain_one :
    orbit (J1.stabilizerChain pointSequence 1) (1 : Fin 266) =
      (↑(
        {1, 2, 4, 6, 9, 12, 13, 14, 17, 19, 21, 24, 27, 29, 31, 32, 34, 37, 39, 41, 42, 45, 49,
          51, 52, 54, 56, 57, 58, 61, 67, 69, 70, 72, 73, 79, 82, 84, 85, 87, 88, 89, 90, 98,
          101, 109, 112, 113, 114, 118, 121, 122, 123, 125, 127, 128, 130, 131, 135, 136, 137,
          139, 141, 143, 150, 152, 153, 160, 161, 162, 163, 165, 166, 169, 171, 172, 173, 179,
          181, 184, 185, 187, 192, 195, 199, 206, 207, 209, 211, 212, 213, 214, 216, 219, 220,
          222, 223, 225, 226, 227, 229, 230, 232, 234, 239, 241, 247, 254, 264, 265} :
        Finset (Fin 266)) : Set (Fin 266)) := by
  rw [← suborbit_eq, Subgroup.stabilizerChain_succ, Subgroup.stabilizerChain_zero]
  ext x
  constructor
  · rintro ⟨g, rfl⟩
    have hg0 : (g : Equiv.Perm (Fin 266)) 0 = 0 := mem_stabilizer_iff.mp g.2.2
    have h := related_apply g.2.1 0 1
    rw [hg0] at h
    exact (related_zero _).mp (h.trans (by decide +kernel))
  · intro hx
    obtain ⟨h0, h1⟩ := stabilizerWords_apply x hx
    exact mem_orbit_iff.mpr
      ⟨⟨wordValue (stabilizerWords x), wordValue_mem _, mem_stabilizer_iff.mpr h0⟩, h1⟩

/-- The second basic orbit along `0, 1` has length 110, strictly less than 265. -/
@[simp]
theorem ncard_orbit_stabilizerChain_one :
    (orbit (J1.stabilizerChain pointSequence 1) (1 : Fin 266)).ncard = 110 := by
  rw [orbit_stabilizerChain_one, Set.ncard_coe_finset]
  decide +kernel

/-- The order of the ATLAS first Janko model is 29260 times the order of its two-point
stabilizer. In particular, determining that remaining order to be 6 gives order 175560. -/
theorem card_eq_29260_mul_card_stabilizerChain :
    Nat.card J1 = 29260 * Nat.card (J1.stabilizerChain pointSequence 2) := by
  have h0 : pointSequence 0 = 0 := rfl
  have h1 : pointSequence 1 = 1 := rfl
  simpa only [Finset.prod_range_succ, Finset.range_zero, Finset.prod_empty, one_mul,
    h0, h1, ncard_orbit_stabilizerChain_zero, ncard_orbit_stabilizerChain_one,
    Nat.reduceMul] using
    (J1.prod_ncard_orbit_mul_card_stabilizerChain pointSequence 2).symm

