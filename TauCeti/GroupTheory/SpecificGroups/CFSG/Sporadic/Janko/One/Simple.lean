/-!
# Simplicity of the ATLAS permutation model of `J₁`

The canonical permutation model `TauCeti.Sporadic.J1` of the first Janko group, generated by the
two ATLAS permutations `a` and `b` of `Fin 266`, is simple. Its order
`175560 = 2³ · 3 · 5 · 7 · 11 · 19` is `TauCeti.Sporadic.card_J1`. The proof applies the
Sylow-local criterion `TauCeti.isSimpleGroup_of_card_eq_of_normalClosure_eq_top_of_isConj`: for
every prime `p` dividing the order it supplies a subgroup whose order is the full `p`-part of the
order, and shows that every element of order `p` in that subgroup is conjugate to an element
whose normal closure is the whole model.

* For `p = 2` the subgroup is generated by the three commuting involutions `t`, `u⁻¹ t u` and
  `u⁻² t u²`, where `t` is an explicit involution and `u = a * b` has order `7`. Bounded
  power-conjugate normal forms show that it has order `8`: the eight normal forms send the point
  `0` to eight distinct points. Each of its seven involutions is `u⁻ᵏ t uᵏ` for some `k < 7`.
* The odd primes divide the order exactly once, and the subgroups are generated by explicit
  words of orders `3`, `5`, `7`, `11` and `19`. A nontrivial element of such a cyclic subgroup of
  prime order generates it, so it has the same normal closure as the chosen generator.

Normal generation is certified by short identities: `b` is a product of three conjugates of `a`,
and `a` is a product of two conjugates of `t` and of each of the five odd-order generators.

Every identity between elements of the model is checked by the kernel at the points `0`, `1` and
`2` only. These points form a base of the model
(`TauCeti.Sporadic.J1.stabilizerChain_three_eq_bot`), so an element of the model is determined by
its values there (`Subgroup.eq_of_forall_smul_eq_of_stabilizerChain_eq_bot`). The words were
found by a computer search outside Lean; only their verification is part of the proof. This file
concerns the permutation model, not the abstract presentation `TauCeti.SporadicName.J1.Group`.

## Main results

* `TauCeti.Sporadic.isSimpleGroup_J1`: the ATLAS permutation model of `J₁` is simple.

## References

* Z. Janko, *A new finite simple group with abelian Sylow 2-subgroups and its characterization*,
  J. Algebra **3** (1966), 147–186, for the elementary abelian Sylow `2`-subgroup of order `8`.
* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `J1G1-p266B0`, <https://brauer.maths.qmul.ac.uk/Atlas/v3/spor/J1/>.
* D. F. Holt, B. Eick and E. A. O'Brien, *Handbook of Computational Group Theory*, Chapman &
  Hall/CRC, 2005, Chapters 4 and 8, for bases and power-conjugate normal forms.
-/

public section

namespace TauCeti.Sporadic.J1

/-! ### Words in the ATLAS generators -/

/-- The permutation of a word in the letters `0`, `1` and `2`, read as `a`, `b` and `b⁻¹`
and multiplied from left to right in Mathlib's composition convention. -/
private def word (l : List (Fin 3)) : Equiv.Perm (Fin 266) :=
  (l.map ![a, b, b⁻¹]).prod

private theorem word_mem (l : List (Fin 3)) : word l ∈ J1 := by
  apply Subgroup.list_prod_mem
  simp only [List.mem_map, forall_exists_index, and_imp, forall_apply_eq_imp_iff₂]
  intro i _
  fin_cases i
  · exact a_mem
  · exact b_mem
  · exact inv_mem b_mem

/-- The element of the model given by a word in `a`, `b` and `b⁻¹`. -/
private def elt (l : List (Fin 3)) : J1 := ⟨word l, word_mem l⟩

/-- Elements of the model are determined by their values at the base points `0`, `1`, `2`. -/
private theorem eq_of_apply_base {g h : J1}
    (hgh : ∀ i : Fin 3, (g : Equiv.Perm (Fin 266)) (Fin.ofNat 266 i) =
      (h : Equiv.Perm (Fin 266)) (Fin.ofNat 266 i)) :
    g = h := by
  refine Subtype.ext (Subgroup.eq_of_forall_smul_eq_of_stabilizerChain_eq_bot _ _
    stabilizerChain_three_eq_bot g.2 h.2 fun j hj ↦ ?_)
  simpa [pointSequence_apply] using hgh ⟨j, hj⟩

/-! ### Normal generation -/

/-- The generator `b` is a product of three conjugates of the involution `a`. -/
private theorem b_eq_mul_conj : elt [1] = (elt [1, 0])⁻¹ * elt [0] * elt [1, 0] *
    ((elt [1, 0, 2, 0])⁻¹ * elt [0] * elt [1, 0, 2, 0]) *
      ((elt [2, 0, 2, 0])⁻¹ * elt [0] * elt [2, 0, 2, 0]) :=
  eq_of_apply_base (by decide +kernel)

/-- An element normally generates the model as soon as `a` is a product of two of its
conjugates. -/
private theorem normalClosure_eq_top_of_eq {r : J1} (c₁ c₂ : List (Fin 3))
    (h : elt [0] = (elt c₁)⁻¹ * r * elt c₁ * ((elt c₂)⁻¹ * r * elt c₂)) :
    Subgroup.normalClosure {r} = ⊤ := by
  set N := Subgroup.normalClosure {r}
  have hconj (x : J1) (c : List (Fin 3)) (hx : x ∈ N) : (elt c)⁻¹ * x * elt c ∈ N := by
    simpa using Subgroup.normalClosure_normal.conj_mem _ hx (elt c)⁻¹
  have hr : r ∈ N := Subgroup.subset_normalClosure rfl
  have ha : elt [0] ∈ N := h ▸ mul_mem (hconj r c₁ hr) (hconj r c₂ hr)
  have hb : elt [1] ∈ N := b_eq_mul_conj ▸ mul_mem (mul_mem (hconj _ [1, 0] ha)
    (hconj _ [1, 0, 2, 0] ha)) (hconj _ [2, 0, 2, 0] ha)
  rw [eq_top_iff, ← Subgroup.map_le_map_iff_of_injective J1.subtype_injective,
    Subgroup.map_top, Subgroup.range_subtype, J1_le_iff]
  exact ⟨⟨_, ha, by simp [elt, word]⟩, ⟨_, hb, by simp [elt, word]⟩⟩

/-! ### A Sylow `2`-subgroup -/

/-- An involution of the model. -/
private def t : J1 :=
  elt [1, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1, 0, 2, 0, 2, 0, 1, 0, 2, 0, 2]

/-- The element `a * b`, of order `7`. -/
private def u : J1 := elt [0, 1]

/-- The conjugates of `t` by `1`, `u` and `u²`. They are commuting involutions generating a
subgroup of order `8`. -/
private def sylowTwoGen (i : Fin 3) : J1 := (u ^ (i : ℕ))⁻¹ * t * u ^ (i : ℕ)

/-- The subgroup generated by `sylowTwoGen`. -/
private def sylowTwo : Subgroup J1 := Subgroup.closure (Set.range sylowTwoGen)

private def sylowTwoForm (e : Fin 3 → Fin 2) : J1 :=
  (List.ofFn fun i ↦ sylowTwoGen i ^ (e i : ℕ)).reverse.prod

private theorem sylowTwoForm_eq (e : Fin 3 → Fin 2) :
    sylowTwoForm e = (powerConjugateNormalForm sylowTwoGen (fun _ ↦ 2) e : J1) :=
  (coe_powerConjugateNormalForm _ _ _).symm

private theorem sylowTwoGen_sq (i : Fin 3) : sylowTwoGen i ^ 2 = 1 := by
  fin_cases i <;> exact eq_of_apply_base (by decide +kernel)

private theorem sylowTwoGen_mul_mul_inv (i j : Fin 3) :
    sylowTwoGen i * sylowTwoGen j * (sylowTwoGen i)⁻¹ = sylowTwoGen j := by
  fin_cases i <;> fin_cases j <;> exact eq_of_apply_base (by decide +kernel)

private theorem sylowTwoGen_pow_mem (i : Fin 3) :
    sylowTwoGen i ^ 2 ∈ generatorSuffix sylowTwoGen ((i : ℕ) + 1) := by
  rw [sylowTwoGen_sq]
  exact Subgroup.one_mem _

private theorem sylowTwoGen_conj_mem (i j : Fin 3) (hij : i < j) :
    sylowTwoGen i * sylowTwoGen j * (sylowTwoGen i)⁻¹ ∈
      generatorSuffix sylowTwoGen ((i : ℕ) + 1) := by
  rw [sylowTwoGen_mul_mul_inv]
  exact apply_mem_generatorSuffix _ j hij

/-- The images of the point `0` under the eight normal forms, which are distinct. -/
private def sylowTwoImage : Fin 2 → Fin 2 → Fin 2 → Fin 266 :=
  ![![![0, 107], ![261, 16]], ![![71, 12], ![180, 236]]]

private theorem sylowTwoForm_apply_zero : ∀ x y z : Fin 2,
    (sylowTwoForm ![x, y, z] : Equiv.Perm (Fin 266)) 0 = sylowTwoImage x y z := by
  decide +kernel

private theorem eq_vecCons (e : Fin 3 → Fin 2) : e = ![e 0, e 1, e 2] :=
  (FinVec.etaExpand_eq e).symm

private theorem sylowTwoForm_injective : Function.Injective sylowTwoForm := by
  intro e f h
  have h0 := congrArg (fun g : J1 ↦ (g : Equiv.Perm (Fin 266)) 0) h
  rw [eq_vecCons e, eq_vecCons f] at h0 ⊢
  simp only [sylowTwoForm_apply_zero] at h0
  have key : ∀ x y z x' y' z' : Fin 2, sylowTwoImage x y z = sylowTwoImage x' y' z' →
      x = x' ∧ y = y' ∧ z = z' := by
    decide
  obtain ⟨h₀, h₁, h₂⟩ := key _ _ _ _ _ _ h0
  rw [h₀, h₁, h₂]

private theorem card_sylowTwo : Nat.card sylowTwo = 2 ^ 3 := by
  have h := (powerConjugateNormalForm_injective_iff sylowTwoGen (fun _ ↦ 2) (fun _ ↦ two_pos)
    sylowTwoGen_pow_mem sylowTwoGen_conj_mem).mp fun e f h ↦
      sylowTwoForm_injective (by simpa only [sylowTwoForm_eq] using congrArg Subtype.val h)
  simpa [sylowTwo] using h

private theorem sylowTwoForm_surjective (g : sylowTwo) : ∃ e, sylowTwoForm e = g := by
  obtain ⟨e, he⟩ := powerConjugateNormalForm_surjective sylowTwoGen (fun _ ↦ 2)
    (fun _ ↦ two_pos) sylowTwoGen_pow_mem sylowTwoGen_conj_mem g
  exact ⟨e, by simpa only [sylowTwoForm_eq] using congrArg Subtype.val he⟩

/-- The exponent `k` for which a nontrivial normal form is `u⁻ᵏ t uᵏ`. -/
private def fusionPower : Fin 2 → Fin 2 → Fin 2 → ℕ :=
  ![![![0, 2], ![1, 6]], ![![0, 3], ![5, 4]]]

-- Every nontrivial element of the Sylow subgroup is conjugate to `t` by a power of `u`.
private theorem isConj_sylowTwoForm (x y z : Fin 2) (h : sylowTwoForm ![x, y, z] ≠ 1) :
    IsConj t (sylowTwoForm ![x, y, z]) := by
  refine isConj_iff.mpr ⟨(u ^ fusionPower x y z)⁻¹, ?_⟩
  rw [inv_inv]
  fin_cases x <;> fin_cases y <;> fin_cases z
  · exact absurd (by simp [sylowTwoForm]) h
  all_goals exact (eq_of_apply_base (by decide +kernel)).symm

/-! ### Cyclic Sylow subgroups for the odd primes -/

/-- The five odd primes dividing the order. -/
private abbrev oddPrime : Fin 5 → ℕ := ![3, 5, 7, 11, 19]

/-- Elements of orders `3`, `5`, `7`, `11` and `19`. -/
private def oddGen : Fin 5 → J1 :=
  ![elt [1], elt [0, 1, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 2], elt [0, 1],
    elt [0, 1, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 2], elt [0, 1, 0, 2]]

private theorem oddGen_pow (i : Fin 5) : oddGen i ^ oddPrime i = 1 := by
  fin_cases i <;> exact eq_of_apply_base (by decide +kernel)

private theorem oddGen_ne_one (i : Fin 5) : oddGen i ≠ 1 := by
  fin_cases i <;> exact fun h ↦ absurd (congrArg (fun g : J1 ↦ (g : Equiv.Perm (Fin 266)) 0) h)
    (by decide +kernel)

private theorem orderOf_oddGen (i : Fin 5) : orderOf (oddGen i) = oddPrime i := by
  have : Fact (oddPrime i).Prime := ⟨by fin_cases i <;> norm_num⟩
  exact orderOf_eq_prime (oddGen_pow i) (oddGen_ne_one i)

/-! ### Normal generators -/

private theorem normalClosure_t : Subgroup.normalClosure {t} = ⊤ :=
  normalClosure_eq_top_of_eq [2, 0, 1, 0, 2, 0, 1, 0, 1] [0, 2, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2]
    (eq_of_apply_base (by decide +kernel))

private theorem normalClosure_oddGen (i : Fin 5) : Subgroup.normalClosure {oddGen i} = ⊤ := by
  fin_cases i
  · exact normalClosure_eq_top_of_eq [0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 2, 0, 2, 0, 1, 0, 2, 0, 1]
      [0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1]
      (eq_of_apply_base (by decide +kernel))
  · exact normalClosure_eq_top_of_eq [2, 0, 1, 0, 2, 0, 1, 0, 2, 0, 2, 0, 1, 0, 1]
      [2, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 1, 0, 2] (eq_of_apply_base (by decide +kernel))
  · exact normalClosure_eq_top_of_eq [1, 0, 1] [1, 0, 2] (eq_of_apply_base (by decide +kernel))
  · exact normalClosure_eq_top_of_eq [2, 0, 2, 0, 1] [1, 0, 2, 0, 2, 0, 1, 0, 1]
      (eq_of_apply_base (by decide +kernel))
  · exact normalClosure_eq_top_of_eq [2, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2]
      [2, 0, 1, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 1, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1, 0, 2,
        0, 2] (eq_of_apply_base (by decide +kernel))

/-! ### Coverage of the prime-order elements -/

private theorem isConj_of_mem_sylowTwo {g : J1} (hg : g ∈ sylowTwo) (horder : orderOf g = 2) :
    IsConj t g := by
  obtain ⟨e, he⟩ := sylowTwoForm_surjective ⟨g, hg⟩
  have he' : sylowTwoForm ![e 0, e 1, e 2] = g := by
    rw [← eq_vecCons]
    exact he
  rw [← he']
  refine isConj_sylowTwoForm _ _ _ fun h ↦ ?_
  rw [he'] at h
  simp [h] at horder

private theorem normalClosure_eq_top_of_mem_zpowers (i : Fin 5) {g : J1}
    (hg : g ∈ Subgroup.zpowers (oddGen i)) (horder : orderOf g = oddPrime i) :
    Subgroup.normalClosure {g} = ⊤ := by
  have heq : Subgroup.zpowers g = Subgroup.zpowers (oddGen i) :=
    Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hg)
      (by rw [Nat.card_zpowers, Nat.card_zpowers, horder, orderOf_oddGen])
  have hmem : oddGen i ∈ Subgroup.normalClosure {g} :=
    Subgroup.zpowers_le.mpr (Subgroup.subset_normalClosure rfl) (heq ▸ Subgroup.mem_zpowers _)
  exact top_unique ((normalClosure_oddGen i).symm.le.trans
    (Subgroup.normalClosure_le_normal (Set.singleton_subset_iff.mpr hmem)))

/-- The local subgroups of the simplicity proof, indexed by the prime: the elementary abelian
`sylowTwo` for `2` and the cyclic subgroups generated by `oddGen` for the odd primes. -/
private def localSubgroup (p : ℕ) : Subgroup J1 :=
  if p = 2 then sylowTwo else Subgroup.zpowers (oddGen
    (if p = 3 then 0 else if p = 5 then 1 else if p = 7 then 2 else if p = 11 then 3 else 4))

end TauCeti.Sporadic.J1

namespace TauCeti.Sporadic

open J1 in
/-- **The ATLAS permutation model of the first Janko group is simple.** -/
instance isSimpleGroup_J1 : IsSimpleGroup J1 := by
  have hfac : (Nat.card J1).primeFactorsList = [2, 2, 2, 3, 5, 7, 11, 19] := by
    simp [card_J1]
  have prime_cases (p : ℕ) (hp : p.Prime) (hd : p ∣ Nat.card J1) :
      p = 2 ∨ p = 3 ∨ p = 5 ∨ p = 7 ∨ p = 11 ∨ p = 19 := by
    have := (Nat.mem_primeFactorsList (by simp [card_J1])).mpr ⟨hp, hd⟩
    simpa [hfac] using this
  apply isSimpleGroup_of_card_eq_of_normalClosure_eq_top_of_isConj localSubgroup
    (s := {x | Subgroup.normalClosure {x} = ⊤})
  · intro p hp hd
    rw [← Nat.primeFactorsList_count_eq, hfac]
    rcases prime_cases p hp hd with rfl | rfl | rfl | rfl | rfl | rfl
    · simp [localSubgroup, card_sylowTwo]
    all_goals simp [localSubgroup, Nat.card_zpowers, orderOf_oddGen]
  · exact fun _ hx ↦ hx
  · intro p hp hd g hg
    rcases prime_cases p hp hd with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨t, normalClosure_t, isConj_of_mem_sylowTwo (by simpa [localSubgroup] using g.2)
      ((Subgroup.orderOf_coe g).trans hg)⟩
    all_goals refine ⟨g, ?_, IsConj.refl _⟩
    · exact normalClosure_eq_top_of_mem_zpowers 0 (by simpa [localSubgroup] using g.2)
        ((Subgroup.orderOf_coe g).trans hg)
    · exact normalClosure_eq_top_of_mem_zpowers 1 (by simpa [localSubgroup] using g.2)
        ((Subgroup.orderOf_coe g).trans hg)
    · exact normalClosure_eq_top_of_mem_zpowers 2 (by simpa [localSubgroup] using g.2)
        ((Subgroup.orderOf_coe g).trans hg)
    · exact normalClosure_eq_top_of_mem_zpowers 3 (by simpa [localSubgroup] using g.2)
        ((Subgroup.orderOf_coe g).trans hg)
    · exact normalClosure_eq_top_of_mem_zpowers 4 (by simpa [localSubgroup] using g.2)
        ((Subgroup.orderOf_coe g).trans hg)

end TauCeti.Sporadic
