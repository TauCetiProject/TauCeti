/-!
# Quaternion-group infrastructure

Mathlib equips `QuaternionGroup n` with a `Fintype` instance when `n` is nonzero, but converting
that instance to a list is noncomputable.  The Dixon--Schneider character-table algorithm needs a
list whose reduction can be evaluated by the kernel.  `TauCeti.quaternionElements` lists the two
constructors at every index and `TauCeti.mem_quaternionElements` proves that the list is exhaustive.

The elements `a i` form the cyclic rotation subgroup of index two.  Its coordinate equivalence with
`Multiplicative (ZMod (2 * n))` supplies its cyclicity, and conjugation by every `xa i` inverts it.
This is the subgroup from which the two-dimensional representations of a generalized quaternion
group are induced.  The file also records the exponent of `QuaternionGroup 2`, the quaternion
group of order eight, in the form used by its explicit Dixon-prime certificate.

Two generators `r` and `s` satisfying the dicyclic relations `r ^ (2 * n) = 1`, `s ^ 2 = r ^ n`, and
`s * r * s⁻¹ = r⁻¹` determine a homomorphism `TauCeti.quaternionHom : QuaternionGroup n →* G` whose
image is `Subgroup.closure {r, s}`; when `r` has exact order `2 * n` the homomorphism is injective.

For nonzero `n`, `QuaternionGroup.a n` is the unique element of `QuaternionGroup n` of order two
(`TauCeti.orderOf_eq_two_quaternionGroup_iff`), so every subgroup of even finite cardinality
contains it (`TauCeti.quaternionA_natCast_mem_of_even_card`), and the subgroup it generates admits
no complement (`TauCeti.not_exists_isComplement'_zpowers_quaternionA_natCast`).  The group
`QuaternionGroup n` is commutative if and only if `n = 1`
(`TauCeti.isMulCommutative_quaternionGroup_iff`); for `n ≠ 1` its centre is generated by `a n`, so
`Subgroup.center (QuaternionGroup n)` has a complement in `QuaternionGroup n` if and only if
`n ≤ 1` (`TauCeti.exists_isComplement'_center_quaternionGroup_iff`).

## Main definitions

* `TauCeti.quaternionElements`: a computable enumeration of `QuaternionGroup n`.
* `TauCeti.quaternionHom`: the homomorphism `QuaternionGroup n →* G` attached to elements `r` and
  `s` satisfying `r ^ (2 * n) = 1`, `s ^ 2 = r ^ n`, and `s * r * s⁻¹ = r⁻¹`.
* `TauCeti.quaternionGroupMulEquiv`: that homomorphism as an isomorphism when `orderOf r = 2 * n`
  and `{r, s}` generates `G`.
* `TauCeti.quaternionRotations`: the cyclic subgroup consisting of the elements `a i`.
* `TauCeti.quaternionRotationsMulEquiv`: its coordinate equivalence with
  `Multiplicative (ZMod (2 * n))`.

## Main results

* `TauCeti.mem_quaternionElements`: the enumeration contains every group element.
* `TauCeti.nat_card_quaternionGroup`: `Nat.card (QuaternionGroup n) = 4 * n` for every `n`.
* `TauCeti.range_quaternionHom` and `TauCeti.quaternionHom_injective`: image and injectivity of the
  dicyclic recognition homomorphism.
* `TauCeti.index_quaternionRotations` and `TauCeti.card_quaternionRotations`: the rotation subgroup
  has index two and cardinality `2 * n`.
* `TauCeti.conj_eq_inv_of_notMem_quaternionRotations`: an element outside the rotation subgroup
  conjugates every rotation to its inverse.
* `TauCeti.exponent_quaternionGroup_two`: `QuaternionGroup 2` has exponent four.
* `TauCeti.sq_eq_one_quaternionGroup_iff` and `TauCeti.orderOf_eq_two_quaternionGroup_iff`: for
  nonzero `n`, `QuaternionGroup.a n` is the unique element of order two.
* `TauCeti.quaternionA_natCast_mem_of_even_card`: for nonzero `n`, every subgroup of even
  cardinality contains `QuaternionGroup.a n`.
* `TauCeti.isMulCommutative_quaternionGroup_iff` and `TauCeti.center_quaternionGroup_eq_zpowers`:
  commutativity at `n = 1` and the centre `{1, a n}` for `n ≠ 1`.
* `TauCeti.exists_isComplement'_center_quaternionGroup_iff` and
  `TauCeti.not_exists_isComplement'_center_quaternionGroup`: the centre of `QuaternionGroup n`
  splits if and only if `n ≤ 1`.
-/

public section

namespace TauCeti

/-- The elements `a 0, xa 0, ..., a (2n-1), xa (2n-1)` of `QuaternionGroup n`.  For nonzero
`n` this lists all `4 * n` elements.  The body is exposed so downstream class-data computations
can reduce it in the kernel. -/
@[expose] def quaternionElements (n : ℕ) : List (QuaternionGroup n) :=
  (List.range (2 * n)).flatMap fun i : ℕ =>
    [QuaternionGroup.a (i : ZMod (2 * n)), QuaternionGroup.xa (i : ZMod (2 * n))]

/-- The enumeration `TauCeti.quaternionElements` exhausts `QuaternionGroup n` when `n` is
nonzero. -/
theorem mem_quaternionElements {n : ℕ} [NeZero n] (g : QuaternionGroup n) :
    g ∈ quaternionElements n := by
  cases g with
  | a i | xa i => exact List.mem_flatMap.mpr ⟨i.val, List.mem_range.mpr i.val_lt, by simp⟩

/-! ## The rotation subgroup -/

variable {n : ℕ}

/-- The parity of a quaternion-group element: `0` on `a i` and `1` on `xa i`. Written
multiplicatively so its kernel is the rotation subgroup. -/
def quaternionCosetParity (n : ℕ) : QuaternionGroup n →* Multiplicative (ZMod 2) where
  toFun
    | QuaternionGroup.a _ => 1
    | QuaternionGroup.xa _ => Multiplicative.ofAdd 1
  map_one' := rfl
  map_mul' := by
    rintro (i | i) (j | j) <;>
      simp only [QuaternionGroup.a_mul_a, QuaternionGroup.a_mul_xa, QuaternionGroup.xa_mul_a,
        QuaternionGroup.xa_mul_xa] <;>
      decide

@[simp]
theorem quaternionCosetParity_a (i : ZMod (2 * n)) :
    quaternionCosetParity n (QuaternionGroup.a i) = 1 :=
  (rfl)

@[simp]
theorem quaternionCosetParity_xa (i : ZMod (2 * n)) :
    quaternionCosetParity n (QuaternionGroup.xa i) = Multiplicative.ofAdd 1 :=
  (rfl)

/-- The quaternion coset parity is onto. -/
theorem quaternionCosetParity_surjective (n : ℕ) :
    Function.Surjective (quaternionCosetParity n) := by
  intro y
  fin_cases y
  exacts [⟨QuaternionGroup.a 0, rfl⟩, ⟨QuaternionGroup.xa 0, rfl⟩]

/-- The cyclic subgroup of `QuaternionGroup n` consisting of the elements `a i`, the kernel of
the coset parity. It is normal of index `2`, and `TauCeti.quaternionRotationsMulEquiv` identifies
it with `Multiplicative (ZMod (2 * n))`. -/
def quaternionRotations (n : ℕ) : Subgroup (QuaternionGroup n) :=
  (quaternionCosetParity n).ker

instance quaternionRotations_normal (n : ℕ) : (quaternionRotations n).Normal :=
  (quaternionCosetParity n).normal_ker

/-- Membership in the quaternion rotation subgroup is being an element `a i`. Use this
characterization explicitly; the constructor membership lemmas simplify without expanding the
carrier of the subgroup. -/
theorem mem_quaternionRotations_iff {g : QuaternionGroup n} :
    g ∈ quaternionRotations n ↔ ∃ i : ZMod (2 * n), g = QuaternionGroup.a i := by
  cases g with
  | a i => exact iff_of_true (by simp [quaternionRotations, MonoidHom.mem_ker]) ⟨i, rfl⟩
  | xa i =>
    refine iff_of_false (by simp [quaternionRotations, MonoidHom.mem_ker]) ?_
    rintro ⟨j, hj⟩
    simp at hj

/-- Every element `a i` belongs to the quaternion rotation subgroup. -/
@[simp]
theorem a_mem_quaternionRotations (i : ZMod (2 * n)) :
    QuaternionGroup.a i ∈ quaternionRotations n :=
  mem_quaternionRotations_iff.mpr ⟨i, rfl⟩

/-- No element `xa i` belongs to the quaternion rotation subgroup. -/
@[simp]
theorem xa_notMem_quaternionRotations (i : ZMod (2 * n)) :
    QuaternionGroup.xa i ∉ quaternionRotations n := fun h => by
  obtain ⟨j, hj⟩ := mem_quaternionRotations_iff.mp h
  simp at hj

/-- The quaternion rotation subgroup has index two. -/
@[simp]
theorem index_quaternionRotations (n : ℕ) : (quaternionRotations n).index = 2 := by
  rw [quaternionRotations, Subgroup.index_ker,
    MonoidHom.range_eq_top.mpr (quaternionCosetParity_surjective n)]
  simp

/-- The rotation subgroup has finite index, for every `n` -- including `n = 0`, where
`QuaternionGroup n` is infinite. -/
instance finiteIndex_quaternionRotations (n : ℕ) : (quaternionRotations n).FiniteIndex :=
  ⟨by simp⟩

/-- `QuaternionGroup n` has cardinality `4 * n` for every `n`, taking the value `0` on the infinite
dicyclic group `QuaternionGroup 0`. -/
@[simp]
theorem nat_card_quaternionGroup (n : ℕ) : Nat.card (QuaternionGroup n) = 4 * n := by
  rcases eq_zero_or_neZero n with rfl | hn
  · rw [Nat.card_congr QuaternionGroup.quaternionGroupZeroEquivDihedralGroupZero.toEquiv,
      DihedralGroup.nat_card]; rfl
  · rw [Nat.card_eq_fintype_card, QuaternionGroup.card]

/-- The rotation subgroup has cardinality `2 * n`, including the infinite case `n = 0`. -/
@[simp]
theorem card_quaternionRotations (n : ℕ) : Nat.card (quaternionRotations n) = 2 * n := by
  have h := (quaternionRotations n).card_mul_index
  rw [index_quaternionRotations, nat_card_quaternionGroup] at h
  omega

/-- Conjugation by an element outside the quaternion rotation subgroup inverts every rotation. -/
theorem conj_eq_inv_of_notMem_quaternionRotations {s g : QuaternionGroup n}
    (hs : s ∉ quaternionRotations n) (hg : g ∈ quaternionRotations n) :
    s * g * s⁻¹ = g⁻¹ := by
  obtain ⟨i, rfl⟩ := mem_quaternionRotations_iff.mp hg
  cases s with
  | a j => exact absurd (a_mem_quaternionRotations j) hs
  | xa j =>
    rw [mul_inv_eq_iff_eq_mul, eq_inv_mul_iff_mul_eq, ← mul_assoc, QuaternionGroup.a_mul_xa,
      QuaternionGroup.xa_mul_a, sub_add_cancel]

/-- Conjugation by an element outside the quaternion rotations, read inside the normal
subgroup. -/
@[simp]
theorem conjNormal_eq_inv_of_notMem_quaternionRotations {s : QuaternionGroup n}
    (hs : s ∉ quaternionRotations n) (x : quaternionRotations n) :
    MulAut.conjNormal s x = x⁻¹ :=
  Subtype.ext (by
    rw [MulAut.conjNormal_apply]
    simpa using conj_eq_inv_of_notMem_quaternionRotations hs x.2)

/-- The rotation index of a quaternion-group element: the index `i` of `a i`, and the junk value
`0` on `xa i`. The interface is `TauCeti.quaternionRotationsMulEquiv`, which reads the index off
an element of the rotation subgroup and so never meets the junk value. -/
private def quaternionRotationIndex : QuaternionGroup n → ZMod (2 * n)
  | QuaternionGroup.a i => i
  | QuaternionGroup.xa _ => 0

private theorem a_quaternionRotationIndex {g : QuaternionGroup n}
    (hg : g ∈ quaternionRotations n) :
    QuaternionGroup.a (quaternionRotationIndex g) = g := by
  obtain ⟨i, rfl⟩ := mem_quaternionRotations_iff.mp hg
  rfl

private theorem quaternionRotationIndex_mul {g h : QuaternionGroup n}
    (hg : g ∈ quaternionRotations n) (hh : h ∈ quaternionRotations n) :
    quaternionRotationIndex (g * h) = quaternionRotationIndex g + quaternionRotationIndex h := by
  obtain ⟨i, rfl⟩ := mem_quaternionRotations_iff.mp hg
  obtain ⟨j, rfl⟩ := mem_quaternionRotations_iff.mp hh
  rw [QuaternionGroup.a_mul_a]
  rfl

/-- The quaternion rotation subgroup is `ZMod (2 * n)` written multiplicatively. -/
def quaternionRotationsMulEquiv (n : ℕ) :
    quaternionRotations n ≃* Multiplicative (ZMod (2 * n)) where
  toFun x := Multiplicative.ofAdd (quaternionRotationIndex (x : QuaternionGroup n))
  invFun i := ⟨QuaternionGroup.a (Multiplicative.toAdd i), a_mem_quaternionRotations _⟩
  left_inv x := Subtype.ext (a_quaternionRotationIndex x.2)
  right_inv _ := rfl
  map_mul' x y := congrArg Multiplicative.ofAdd (quaternionRotationIndex_mul x.2 y.2)

@[simp]
theorem quaternionRotationsMulEquiv_a (i : ZMod (2 * n)) :
    quaternionRotationsMulEquiv n ⟨QuaternionGroup.a i, a_mem_quaternionRotations i⟩ =
      Multiplicative.ofAdd i :=
  (rfl)

@[simp]
theorem coe_quaternionRotationsMulEquiv_symm (i : Multiplicative (ZMod (2 * n))) :
    ((quaternionRotationsMulEquiv n).symm i : QuaternionGroup n) =
      QuaternionGroup.a (Multiplicative.toAdd i) :=
  (rfl)

/-- The rotation subgroup is cyclic, `Multiplicative (ZMod (2 * n))` being so. -/
instance isCyclic_quaternionRotations (n : ℕ) : IsCyclic (quaternionRotations n) :=
  isCyclic_of_surjective _ (quaternionRotationsMulEquiv n).symm.surjective

/-- The quaternion group of order eight has exponent four. -/
@[simp]
theorem exponent_quaternionGroup_two : Monoid.exponent (QuaternionGroup 2) = 4 := by
  rw [QuaternionGroup.exponent]
  decide

/-! ## Recognizing a dicyclic group

Two elements `r` and `s` of a group `G` satisfying `r ^ (2 * n) = 1`, `s ^ 2 = r ^ n`, and
`s * r * s⁻¹ = r⁻¹` determine a homomorphism `QuaternionGroup n →* G` sending `a i` to
`r ^ (ZMod.cast i : ℤ)` and `xa i` to `s * r ^ (ZMod.cast i : ℤ)`.  Taking representatives in `ℤ`
via `ZMod.lift` covers every `n : ℕ`, including `n = 0`.  When `r` has exact order `2 * n`, no
hypothesis on `s` beyond the defining relations is needed for injectivity: if `s` lay in the cyclic
subgroup generated by `r`, conjugation by `s` would fix `r`, forcing `r ^ 2 = 1`, hence `n = 1` and
`s ^ 2 = 1 = r`, contradicting `orderOf r = 2`. -/

section Recognition

variable {G : Type*} [Group G] {n : ℕ} {r s : G}

/-- The underlying function of `TauCeti.quaternionHom`. -/
private def quaternionFun (r s : G) : QuaternionGroup n → G
  | .a i => r ^ (ZMod.cast i : ℤ)
  | .xa i => s * r ^ (ZMod.cast i : ℤ)

private lemma quaternionFun_a (r s : G) (i : ZMod (2 * n)) :
    quaternionFun r s (.a i) = r ^ (ZMod.cast i : ℤ) := rfl

private lemma quaternionFun_xa (r s : G) (i : ZMod (2 * n)) :
    quaternionFun r s (.xa i) = s * r ^ (ZMod.cast i : ℤ) := rfl

/-- The homomorphism out of `QuaternionGroup n` determined by elements `r` and `s` satisfying the
dicyclic relations `r ^ (2 * n) = 1`, `s ^ 2 = r ^ n`, and `s * r * s⁻¹ = r⁻¹`. -/
def quaternionHom (hr : r ^ (2 * n) = 1) (hs : s ^ 2 = r ^ n) (hrs : s * r * s⁻¹ = r⁻¹) :
    QuaternionGroup n →* G where
  toFun := quaternionFun r s
  map_one' := by simp only [QuaternionGroup.one_def, quaternionFun_a, ZMod.cast_zero, zpow_zero]
  map_mul' := by
    let p : {f : ℤ →+ Additive G // f ↑(2 * n) = 0} :=
      ⟨zmultiplesHom (Additive G) (Additive.ofMul r),
        by simpa only [zmultiplesHom_apply, zsmul_eq_mul, natCast_zsmul, ← ofMul_pow, ofMul_one]
          using congrArg Additive.ofMul hr⟩
    let f := (ZMod.lift (2 * n) p).toMultiplicativeLeft
    have hf (i : ZMod (2 * n)) : f (Multiplicative.ofAdd i) = r ^ (ZMod.cast i : ℤ) := by
      have h := ZMod.lift_coe (2 * n) p (ZMod.cast i : ℤ)
      rw [ZMod.intCast_zmod_cast] at h
      simpa only [f, p, AddMonoidHom.coe_toMultiplicativeLeft, Function.comp_apply,
        toAdd_ofAdd, zmultiplesHom_apply, toMul_zsmul, toMul_ofMul] using congrArg Additive.toMul h
    have hadd (i j : ZMod (2 * n)) :
        r ^ (ZMod.cast (i + j) : ℤ) = r ^ (ZMod.cast i : ℤ) * r ^ (ZMod.cast j : ℤ) := by
      simpa only [← ofAdd_add, hf] using
        f.map_mul (Multiplicative.ofAdd i) (Multiplicative.ofAdd j)
    have hneg (i : ZMod (2 * n)) :
        r ^ (ZMod.cast (-i) : ℤ) = (r ^ (ZMod.cast i : ℤ))⁻¹ := by
      simpa only [← ofAdd_neg, hf] using f.map_inv (Multiplicative.ofAdd i)
    have hpow_n : r ^ (ZMod.cast (n : ZMod (2 * n)) : ℤ) = s * s := by
      have h := ZMod.lift_coe (2 * n) p (n : ℤ)
      rw [Int.cast_natCast] at h
      have h' : f (Multiplicative.ofAdd (n : ZMod (2 * n))) = r ^ n := by
        simpa only [f, p, AddMonoidHom.coe_toMultiplicativeLeft, Function.comp_apply,
          toAdd_ofAdd, zmultiplesHom_apply, toMul_zsmul, toMul_ofMul, zpow_natCast] using
          congrArg Additive.toMul h
      rw [← hf, h', ← hs, sq]
    have hmove (i : ZMod (2 * n)) :
        r ^ (ZMod.cast i : ℤ) * s = s * r ^ (ZMod.cast (-i) : ℤ) := by
      have hconj : s * r ^ (ZMod.cast (-i) : ℤ) * s⁻¹ = r ^ (ZMod.cast i : ℤ) := by
        rw [← conj_zpow, hrs, inv_zpow, hneg, inv_inv]
      rw [← hconj, inv_mul_cancel_right]
    rintro (i | i) (j | j)
    · rw [QuaternionGroup.a_mul_a, quaternionFun_a, quaternionFun_a, quaternionFun_a, hadd]
    · rw [QuaternionGroup.a_mul_xa, quaternionFun_xa, quaternionFun_a, quaternionFun_xa,
        ← mul_assoc, hmove, mul_assoc, ← hadd, neg_add_eq_sub]
    · rw [QuaternionGroup.xa_mul_a, quaternionFun_xa, quaternionFun_xa, quaternionFun_a,
        hadd, mul_assoc]
    · rw [QuaternionGroup.xa_mul_xa, quaternionFun_a, quaternionFun_xa, quaternionFun_xa,
        ← mul_assoc, mul_assoc s, hmove, ← mul_assoc, ← hpow_n, mul_assoc, ← hadd, ← hadd,
        sub_eq_add_neg, add_assoc, add_comm j (-i)]

/-- `TauCeti.quaternionHom` sends `a i` to `r ^ (ZMod.cast i : ℤ)`. -/
@[simp]
theorem quaternionHom_a (hr : r ^ (2 * n) = 1) (hs : s ^ 2 = r ^ n) (hrs : s * r * s⁻¹ = r⁻¹)
    (i : ZMod (2 * n)) :
    quaternionHom hr hs hrs (.a i) = r ^ (ZMod.cast i : ℤ) :=
  (rfl)

/-- `TauCeti.quaternionHom` sends `xa i` to `s * r ^ (ZMod.cast i : ℤ)`. -/
@[simp]
theorem quaternionHom_xa (hr : r ^ (2 * n) = 1) (hs : s ^ 2 = r ^ n) (hrs : s * r * s⁻¹ = r⁻¹)
    (i : ZMod (2 * n)) :
    quaternionHom hr hs hrs (.xa i) = s * r ^ (ZMod.cast i : ℤ) :=
  (rfl)

/-- The image of `TauCeti.quaternionHom` is the subgroup generated by `r` and `s`. -/
theorem range_quaternionHom (hr : r ^ (2 * n) = 1) (hs : s ^ 2 = r ^ n)
    (hrs : s * r * s⁻¹ = r⁻¹) :
    (quaternionHom hr hs hrs).range = Subgroup.closure {r, s} := by
  have hone : r ^ (ZMod.cast (1 : ZMod (2 * n)) : ℤ) = r := by
    conv_rhs => rw [← zpow_one r]
    rw [zpow_eq_zpow_iff_modEq]
    apply Int.ModEq.of_dvd ((orderOf_dvd_of_pow_eq_one hr).natCast)
    rw [← ZMod.intCast_eq_intCast_iff, ZMod.intCast_zmod_cast, Int.cast_one]
  have hrmem : r ∈ Subgroup.closure ({r, s} : Set G) := Subgroup.subset_closure (by simp)
  have hsmem : s ∈ Subgroup.closure ({r, s} : Set G) := Subgroup.subset_closure (by simp)
  refine le_antisymm ?_ ?_
  · rintro _ ⟨i | i, rfl⟩
    · simpa only [quaternionHom_a] using zpow_mem hrmem (ZMod.cast i : ℤ)
    · simpa only [quaternionHom_xa] using mul_mem hsmem (zpow_mem hrmem (ZMod.cast i : ℤ))
  · rw [Subgroup.closure_le]
    rintro x (rfl | rfl)
    · exact ⟨QuaternionGroup.a 1, by rw [quaternionHom_a, hone]⟩
    · exact ⟨QuaternionGroup.xa 0, by simp⟩

/-- **Dicyclic recognition criterion (injectivity).** If `r` has exact order `2 * n`,
`s ^ 2 = r ^ n`, and `s * r * s⁻¹ = r⁻¹`, then `TauCeti.quaternionHom` embeds `QuaternionGroup n`
into `G`. -/
theorem quaternionHom_injective (hs : s ^ 2 = r ^ n) (hrs : s * r * s⁻¹ = r⁻¹)
    (hn : orderOf r = 2 * n) :
    Function.Injective (quaternionHom (hn ▸ pow_orderOf_eq_one r) hs hrs) := by
  rw [injective_iff_map_eq_one]
  rintro (i | i) hi
  · rw [quaternionHom_a, ← zpow_zero r, zpow_eq_zpow_iff_modEq, hn,
      ← ZMod.intCast_eq_intCast_iff, ZMod.intCast_zmod_cast, Int.cast_zero] at hi
    rw [hi, QuaternionGroup.a_zero]
  · rw [quaternionHom_xa] at hi
    exfalso
    set m : ℤ := -(ZMod.cast i : ℤ)
    have hzpow : s = r ^ m := by
      rw [zpow_neg, eq_inv_iff_mul_eq_one]
      exact hi
    have hcomm : Commute s r := hzpow ▸ (Commute.refl r).zpow_left m
    have hinv : r⁻¹ = r := by rw [← hrs, hcomm.eq, mul_inv_cancel_right]
    have hr2 : r ^ 2 = 1 := by
      rw [sq]
      nth_rewrite 2 [← hinv]
      exact mul_inv_cancel r
    have hdvd : 2 * n ∣ 2 := hn ▸ orderOf_dvd_of_pow_eq_one hr2
    have hn1 : n = 1 := by
      have hle : 2 * n ≤ 2 := Nat.le_of_dvd (by decide) hdvd
      have hne : n ≠ 0 := by rintro rfl; simp at hdvd
      omega
    subst hn1
    have hs2 : s ^ 2 = 1 := by
      rw [hzpow, ← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hr2, one_zpow]
    have hr1 : r = 1 := by simpa only [pow_one, hs2] using hs.symm
    rw [hr1, orderOf_one] at hn
    omega

/-- **Dicyclic recognition criterion (bijectivity).** When `r` and `s` generate `G` and `r` has
exact order `2 * n`, `TauCeti.quaternionHom` is bijective. -/
theorem quaternionHom_bijective (hs : s ^ 2 = r ^ n) (hrs : s * r * s⁻¹ = r⁻¹)
    (hn : orderOf r = 2 * n) (hgen : Subgroup.closure ({r, s} : Set G) = ⊤) :
    Function.Bijective (quaternionHom (hn ▸ pow_orderOf_eq_one r) hs hrs) :=
  ⟨quaternionHom_injective hs hrs hn,
    MonoidHom.range_eq_top.mp (by rw [range_quaternionHom, hgen])⟩

/-- **Dicyclic recognition isomorphism.** A group generated by `r` and `s` with `orderOf r = 2 * n`,
`s ^ 2 = r ^ n`, and `s * r * s⁻¹ = r⁻¹` is isomorphic to `QuaternionGroup n`. -/
noncomputable def quaternionGroupMulEquiv (hs : s ^ 2 = r ^ n) (hrs : s * r * s⁻¹ = r⁻¹)
    (hn : orderOf r = 2 * n) (hgen : Subgroup.closure ({r, s} : Set G) = ⊤) :
    QuaternionGroup n ≃* G :=
  MulEquiv.ofBijective (quaternionHom (hn ▸ pow_orderOf_eq_one r) hs hrs)
    (quaternionHom_bijective hs hrs hn hgen)

@[simp]
theorem quaternionGroupMulEquiv_apply (hs : s ^ 2 = r ^ n) (hrs : s * r * s⁻¹ = r⁻¹)
    (hn : orderOf r = 2 * n) (hgen : Subgroup.closure ({r, s} : Set G) = ⊤)
    (x : QuaternionGroup n) :
    quaternionGroupMulEquiv hs hrs hn hgen x =
      quaternionHom (hn ▸ pow_orderOf_eq_one r) hs hrs x :=
  MulEquiv.ofBijective_apply _ _ x

/-- Existential form of `TauCeti.quaternionGroupMulEquiv`. -/
theorem nonempty_quaternionGroup_mulEquiv (hs : s ^ 2 = r ^ n) (hrs : s * r * s⁻¹ = r⁻¹)
    (hn : orderOf r = 2 * n) (hgen : Subgroup.closure ({r, s} : Set G) = ⊤) :
    Nonempty (QuaternionGroup n ≃* G) :=
  ⟨quaternionGroupMulEquiv hs hrs hn hgen⟩

end Recognition

/-! ## The unique involution, the centre, and non-splitting of the centre -/

section Center

open scoped IsMulCommutative

/-- For nonzero `n`, the central element `QuaternionGroup.a n` is not the identity. -/
@[simp]
theorem quaternionA_natCast_ne_one [NeZero n] :
    (QuaternionGroup.a n : QuaternionGroup n) ≠ 1 := by
  intro h
  have hsq : (QuaternionGroup.xa 0 : QuaternionGroup n) ^ 2 = 1 := by
    rw [QuaternionGroup.xa_sq, h]
  have hdvd := orderOf_dvd_of_pow_eq_one hsq
  rw [QuaternionGroup.orderOf_xa] at hdvd
  omega

/-- The element `QuaternionGroup.a n` squares to `1` for every `n`. -/
@[simp]
theorem quaternionA_natCast_sq (n : ℕ) : (QuaternionGroup.a n : QuaternionGroup n) ^ 2 = 1 := by
  rw [sq, QuaternionGroup.a_mul_a, ← Nat.cast_add, ← two_mul, ZMod.natCast_self,
    QuaternionGroup.a_zero]

/-- For nonzero `n`, `QuaternionGroup.a n` has order `2`. -/
@[simp]
theorem orderOf_quaternionA_natCast [NeZero n] :
    orderOf (QuaternionGroup.a n : QuaternionGroup n) = 2 :=
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  orderOf_eq_prime (quaternionA_natCast_sq n) quaternionA_natCast_ne_one

/-- The cyclic subgroup generated by `QuaternionGroup.a n` consists of `1` and `a n`. -/
@[simp]
theorem mem_zpowers_quaternionA_natCast_iff {g : QuaternionGroup n} :
    g ∈ Subgroup.zpowers (QuaternionGroup.a n : QuaternionGroup n) ↔
      g = 1 ∨ g = QuaternionGroup.a n :=
  Subgroup.mem_zpowers_iff_of_sq_eq_one (quaternionA_natCast_sq n)

/-- For nonzero `n`, the only elements of `QuaternionGroup n` satisfying `g ^ 2 = 1` are `1` and
`QuaternionGroup.a n`. -/
theorem sq_eq_one_quaternionGroup_iff [NeZero n] {g : QuaternionGroup n} :
    g ^ 2 = 1 ↔ g = 1 ∨ g = QuaternionGroup.a n := by
  refine ⟨fun hg => ?_, ?_⟩
  · cases g with
    | a i =>
      rw [sq, QuaternionGroup.a_mul_a, QuaternionGroup.one_def, QuaternionGroup.a.injEq] at hg
      have hval : (2 * i.val) % (2 * n) = 0 := by
        simpa [ZMod.val_add, two_mul] using congrArg ZMod.val hg
      obtain ⟨k, hk⟩ :=
        (Nat.mul_dvd_mul_iff_left (by decide : 0 < 2)).mp (Nat.dvd_of_mod_eq_zero hval)
      have hlt : i.val < 2 * n := i.val_lt
      rcases k with _ | _ | k
      · have hi0 : i = 0 := by simpa using hk
        exact Or.inl (by rw [hi0, QuaternionGroup.a_zero])
      · have hin : i = (n : ZMod (2 * n)) := by
          apply ZMod.val_injective
          rw [ZMod.val_natCast, Nat.mod_eq_of_lt (by have := NeZero.pos n; omega)]
          omega
        exact Or.inr (congrArg QuaternionGroup.a hin)
      · exfalso
        rw [hk] at hlt
        have hge : n * 2 ≤ n * (k + 1 + 1) := Nat.mul_le_mul_left n (by omega)
        omega
    | xa i =>
      rw [QuaternionGroup.xa_sq] at hg
      exact absurd hg quaternionA_natCast_ne_one
  · rintro (rfl | rfl)
    · exact one_pow 2
    · exact quaternionA_natCast_sq n

/-- **Unique involution of a generalized quaternion group.** For nonzero `n`, `QuaternionGroup.a n`
is the unique element of `QuaternionGroup n` of order `2`. -/
theorem orderOf_eq_two_quaternionGroup_iff [NeZero n] {g : QuaternionGroup n} :
    orderOf g = 2 ↔ g = QuaternionGroup.a n := by
  refine ⟨fun h => ?_, fun h => h ▸ orderOf_quaternionA_natCast⟩
  rcases sq_eq_one_quaternionGroup_iff.mp (h ▸ pow_orderOf_eq_one g) with rfl | hg
  · simp at h
  · exact hg

/-- For nonzero `n`, every subgroup of `QuaternionGroup n` of even cardinality contains the unique
involution `QuaternionGroup.a n`. -/
theorem quaternionA_natCast_mem_of_even_card [NeZero n] {H : Subgroup (QuaternionGroup n)}
    (hH : Even (Nat.card H)) : QuaternionGroup.a n ∈ H := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := H) 2 hH.two_dvd
  rw [Subgroup.orderOf_mk, orderOf_eq_two_quaternionGroup_iff] at hx
  exact hx ▸ x.2

/-- For nonzero `n`, the two-element subgroup generated by `QuaternionGroup.a n` has no complement
in `QuaternionGroup n`. -/
theorem not_exists_isComplement'_zpowers_quaternionA_natCast [NeZero n] :
    ¬ ∃ K : Subgroup (QuaternionGroup n),
      (Subgroup.zpowers (QuaternionGroup.a n : QuaternionGroup n)).IsComplement' K := by
  rintro ⟨K, hK⟩
  have hcard := hK.card_mul_card
  rw [Nat.card_zpowers, orderOf_quaternionA_natCast, nat_card_quaternionGroup] at hcard
  have heven : Even (Nat.card K) := ⟨n, by omega⟩
  have hmem : (QuaternionGroup.a n : QuaternionGroup n) ∈ K :=
    quaternionA_natCast_mem_of_even_card heven
  exact quaternionA_natCast_ne_one
    (Subgroup.disjoint_def.mp hK.disjoint (Subgroup.mem_zpowers _) hmem)

/-- The element `QuaternionGroup.a n` lies in the centre of `QuaternionGroup n` for every `n`. -/
@[simp]
theorem quaternionA_natCast_mem_center (n : ℕ) :
    QuaternionGroup.a n ∈ Subgroup.center (QuaternionGroup n) := by
  rw [Subgroup.mem_center_iff]
  have h2n : ((2 * n : ℕ) : ZMod (2 * n)) = 0 := ZMod.natCast_self (2 * n)
  rw [Nat.cast_mul, Nat.cast_two] at h2n
  rintro (i | i)
  · rw [QuaternionGroup.a_mul_a, QuaternionGroup.a_mul_a, add_comm]
  · rw [QuaternionGroup.xa_mul_a, QuaternionGroup.a_mul_xa]
    exact congrArg QuaternionGroup.xa (by linear_combination h2n)

/-- An element `QuaternionGroup.xa i` commutes with `QuaternionGroup.a 1` if and only if `n = 1`. -/
theorem commute_xa_a_one_iff {i : ZMod (2 * n)} :
    Commute (QuaternionGroup.xa i : QuaternionGroup n) (QuaternionGroup.a 1) ↔ n = 1 := by
  rw [commute_iff_eq, QuaternionGroup.xa_mul_a, QuaternionGroup.a_mul_xa, QuaternionGroup.xa.injEq]
  refine ⟨fun h => ?_, ?_⟩
  · have h2 : ((2 : ℕ) : ZMod (2 * n)) = 0 := by
      rw [Nat.cast_two]
      linear_combination h
    have hdvd : 2 * n ∣ 2 := (ZMod.natCast_eq_zero_iff 2 (2 * n)).mp h2
    have hle : 2 * n ≤ 2 := Nat.le_of_dvd (by decide) hdvd
    have hne : n ≠ 0 := by rintro rfl; simp at hdvd
    omega
  · rintro rfl
    have h2 : ((2 : ℕ) : ZMod (2 * 1)) = 0 := ZMod.natCast_self 2
    rw [Nat.cast_two] at h2
    linear_combination h2

/-- `QuaternionGroup n` is commutative if and only if `n = 1`, where it is cyclic of order `4`. -/
theorem isMulCommutative_quaternionGroup_iff :
    IsMulCommutative (QuaternionGroup n) ↔ n = 1 := by
  refine ⟨fun _ => commute_xa_a_one_iff.mp (Commute.all (QuaternionGroup.xa 0) _), ?_⟩
  rintro rfl
  have := QuaternionGroup.quaternionGroup_one_isCyclic
  infer_instance

/-- For `n ≠ 1`, the centre of `QuaternionGroup n` consists of `1` and `QuaternionGroup.a n`
(which coincide at `n = 0`). -/
theorem mem_center_quaternionGroup_iff (hn : n ≠ 1) {g : QuaternionGroup n} :
    g ∈ Subgroup.center (QuaternionGroup n) ↔ g = 1 ∨ g = QuaternionGroup.a n := by
  refine ⟨fun hg => ?_, ?_⟩
  · cases g with
    | a i =>
      have h := Subgroup.mem_center_iff.mp hg (QuaternionGroup.xa 0)
      simp only [QuaternionGroup.xa_mul_a, QuaternionGroup.a_mul_xa, zero_add, zero_sub,
        QuaternionGroup.xa.injEq] at h
      have hsq : (QuaternionGroup.a i : QuaternionGroup n) ^ 2 = 1 := by
        rw [sq, QuaternionGroup.a_mul_a, QuaternionGroup.one_def, QuaternionGroup.a.injEq]
        linear_combination h
      rcases eq_zero_or_neZero n with rfl | hne
      · rw [sq, QuaternionGroup.a_mul_a, QuaternionGroup.one_def, QuaternionGroup.a.injEq] at hsq
        have : CharZero (ZMod (2 * 0)) := ZMod.charZero
        have hi0 : i = 0 := by simpa [← two_mul] using hsq
        exact Or.inl (by rw [hi0, QuaternionGroup.a_zero])
      · exact sq_eq_one_quaternionGroup_iff.mp hsq
    | xa i =>
      exact absurd (commute_xa_a_one_iff.mp ((Subgroup.mem_center_iff.mp hg _).symm)) hn
  · rintro (rfl | rfl)
    · exact one_mem _
    · exact quaternionA_natCast_mem_center n

/-- For `n ≠ 1`, the centre of `QuaternionGroup n` is generated by `QuaternionGroup.a n`. -/
theorem center_quaternionGroup_eq_zpowers (hn : n ≠ 1) :
    Subgroup.center (QuaternionGroup n) =
      Subgroup.zpowers (QuaternionGroup.a n : QuaternionGroup n) := by
  ext g
  rw [mem_center_quaternionGroup_iff hn, mem_zpowers_quaternionA_natCast_iff]

/-- **Splitting of the centre of `QuaternionGroup n`.** The centre of `QuaternionGroup n` admits a
complement in `QuaternionGroup n` if and only if `n ≤ 1` (at `n = 0` the centre is trivial, and at
`n = 1` the group is cyclic so the centre is the whole group). -/
theorem exists_isComplement'_center_quaternionGroup_iff :
    (∃ K : Subgroup (QuaternionGroup n), (Subgroup.center (QuaternionGroup n)).IsComplement' K) ↔
      n ≤ 1 := by
  refine ⟨fun h => ?_, fun hn => ?_⟩
  · by_contra hle
    have hn1 : n ≠ 1 := by omega
    have : NeZero n := ⟨by omega⟩
    rw [center_quaternionGroup_eq_zpowers hn1] at h
    exact not_exists_isComplement'_zpowers_quaternionA_natCast h
  · rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hn with rfl | rfl
    · rw [center_quaternionGroup_eq_zpowers (by decide), Nat.cast_zero, QuaternionGroup.a_zero,
        Subgroup.zpowers_one_eq_bot]
      exact ⟨⊤, Subgroup.isComplement'_bot_top⟩
    · have : IsMulCommutative (QuaternionGroup 1) := isMulCommutative_quaternionGroup_iff.mpr rfl
      rw [Subgroup.center_eq_top]
      exact ⟨⊥, Subgroup.isComplement'_top_bot⟩

/-- For `2 ≤ n`, the centre of `QuaternionGroup n` has no complement in `QuaternionGroup n`. -/
theorem not_exists_isComplement'_center_quaternionGroup (hn : 2 ≤ n) :
    ¬ ∃ K : Subgroup (QuaternionGroup n), (Subgroup.center (QuaternionGroup n)).IsComplement' K :=
  fun h => by have := exists_isComplement'_center_quaternionGroup_iff.mp h; omega

end Center

end TauCeti
