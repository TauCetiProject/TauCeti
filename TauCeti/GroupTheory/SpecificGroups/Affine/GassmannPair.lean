module

public import Mathlib.NumberTheory.LegendreSymbol.ZModChar
public import TauCeti.GroupTheory.AlmostConjugate
public import TauCeti.GroupTheory.SpecificGroups.Affine.Basic
import Mathlib.Data.Nat.Totient

/-!
# A Gassmann pair in the affine group of `ZMod 8`

The affine group `Q = TauCeti.AffineGroup (ZMod 8)` is the semidirect product of `ZMod 8` by its
unit group `{1, 3, 5, 7}`, of order `32`; we write `(b, u)` for the map `x ↦ b + u x`, and the
conjugation formula `(a, u) (b, v) (a, u)⁻¹ = (u b + (1 - v) a, v)` is
`TauCeti.AffineGroup.toAdd_mul_mul_inv_left`. It contains two subgroups of order `4` that
complement the translations:

* `H₁ = TauCeti.affineLinearSubgroup (ZMod 8) = {(0, 1), (0, 3), (0, 5), (0, 7)}`, the linear
  maps fixing `0`;
* `H₂ = TauCeti.affineχ₈Subgroup = {(0, 1), (4, 3), (4, 5), (0, 7)}`, the graph of
  `u ↦ 2 (1 - χ₈ u)` for the quadratic character `χ₈` of `ℚ(√2)`.

Each element of `H₂` is conjugate in `Q` to the element of `H₁` with the same linear part (by a
translation), so `H₁` and `H₂` meet every conjugacy class of `Q` in the same number of elements:
they are almost conjugate. They are not conjugate: a conjugate of `H₁` by `(a, u)` consists of the
maps `((1 - v) a, v)`, and it would have to contain `(4, 3)` and `(4, 5)`, forcing
`a ≡ 2 (mod 4)` from `-2 a = 4` and `a` odd from `-4 a = 4`. Both subgroups have trivial normal
core, so `Q` acts faithfully on the eight cosets of each (`Subgroup.normalCore_eq_ker`), and `Q`
is generated by `(1, 1)`, `(0, 3)` and `(0, 5)`.

Pulling `H₁` and `H₂` back along a surjection of the fundamental group of a closed hyperbolic
surface onto `Q` gives two finite covers of degree `8`, which have the same Laplace spectrum by
Sunada's theorem; the three generators let a surface group of genus at least three map onto `Q`.

## Main statements

* `TauCeti.affineχ₈Subgroup` and `TauCeti.mem_affineχ₈Subgroup_iff`: the subgroup `H₂`.
* `TauCeti.card_affineGroup_zmod_eight`, `TauCeti.card_affineLinearSubgroup_zmod_eight`,
  `TauCeti.card_affineχ₈Subgroup`: `|Q| = 32` and `|H₁| = |H₂| = 4`.
* `TauCeti.almostConjugate_affineLinearSubgroup_affineχ₈Subgroup`: `H₁` and `H₂` are almost
  conjugate.
* `TauCeti.not_exists_conj_smul_affineLinearSubgroup_eq_affineχ₈Subgroup`: they are not
  conjugate.
* `TauCeti.closure_inl_one_inr_three_inr_five_eq_top`: `(1, 1)`, `(0, 3)` and `(0, 5)` generate
  `Q`.
* `TauCeti.normalCore_affineχ₈Subgroup`: `H₂` has trivial normal core; for `H₁` this is
  `TauCeti.normalCore_affineLinearSubgroup`, over every ring.

## References

* P. Buser, *Isospectral Riemann surfaces*, Ann. Inst. Fourier **36** (1986), 167–192.
* T. Sunada, *Riemannian coverings and isospectral manifolds*, Ann. of Math. **121** (1985),
  169–186.
-/

public section

open Pointwise ZMod

namespace TauCeti

/-- The section `u ↦ (2 (1 - χ₈ u), u)` of the affine group of `ZMod 8` over its linear part. It
is a homomorphism because `u ↦ 2 (1 - χ₈ u)` is a crossed homomorphism with values in `{0, 4}`. -/
private def affineχ₈Section : (ZMod 8)ˣ →* AffineGroup (ZMod 8) where
  toFun u := ⟨.ofAdd (2 * (1 - (χ₈ u : ZMod 8))), u⟩
  map_one' := by decide
  map_mul' u v := by
    refine AffineGroup.ext ?_ (by simp)
    simp only [SemidirectProduct.mul_left, toAdd_mul, affineAction_apply_toAdd, toAdd_ofAdd,
      Units.val_mul]
    revert u v
    decide

@[simp]
private theorem affineχ₈Section_left (u : (ZMod 8)ˣ) :
    (affineχ₈Section u).left.toAdd = 2 * (1 - (χ₈ u : ZMod 8)) :=
  rfl

@[simp]
private theorem affineχ₈Section_right (u : (ZMod 8)ˣ) : (affineχ₈Section u).right = u :=
  rfl

private theorem affineχ₈Section_injective : Function.Injective affineχ₈Section :=
  fun _ _ h ↦ congrArg SemidirectProduct.right h

/-- The subgroup `{(0, 1), (4, 3), (4, 5), (0, 7)}` of the affine group of `ZMod 8`: the graph of
`u ↦ 2 (1 - χ₈ u)` over the unit group. It is almost conjugate but not conjugate to the linear
factor `affineLinearSubgroup (ZMod 8)`. -/
def affineχ₈Subgroup : Subgroup (AffineGroup (ZMod 8)) :=
  affineχ₈Section.range

/-- An affine map `x ↦ b + u x` of `ZMod 8` lies in `affineχ₈Subgroup` exactly when
`b = 2 (1 - χ₈ u)`, that is, `b = 0` for `u = ±1` and `b = 4` for `u = ±3`. -/
@[simp]
theorem mem_affineχ₈Subgroup_iff (g : AffineGroup (ZMod 8)) :
    g ∈ affineχ₈Subgroup ↔ g.left.toAdd = 2 * (1 - (χ₈ g.right : ZMod 8)) := by
  constructor
  · rintro ⟨u, rfl⟩
    simp
  · intro hg
    exact ⟨g.right, AffineGroup.ext (by simp [hg]) (by simp)⟩

/-- The affine group of `ZMod 8` has order `32`. -/
theorem card_affineGroup_zmod_eight : Nat.card (AffineGroup (ZMod 8)) = 32 := by
  rw [SemidirectProduct.card, Nat.card_eq_fintype_card, Nat.card_eq_fintype_card,
    ZMod.card_units_eq_totient]
  decide

/-- The linear factor of the affine group of `ZMod 8` has order `4`. -/
theorem card_affineLinearSubgroup_zmod_eight : Nat.card (affineLinearSubgroup (ZMod 8)) = 4 := by
  rw [card_affineLinearSubgroup_eq_card_units, Nat.card_eq_fintype_card,
    ZMod.card_units_eq_totient]
  decide

/-- The subgroup `affineχ₈Subgroup` has order `4`. -/
theorem card_affineχ₈Subgroup : Nat.card affineχ₈Subgroup = 4 := by
  rw [affineχ₈Subgroup, ← Nat.card_congr (MonoidHom.ofInjective affineχ₈Section_injective).toEquiv,
    Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
  decide

/-- Each element `(0, u)` of the linear factor is conjugate, by a translation, to the element
`(2 (1 - χ₈ u), u)` of `affineχ₈Subgroup`. -/
private theorem isConj_inr_affineχ₈Section (u : (ZMod 8)ˣ) :
    IsConj (SemidirectProduct.inr u : AffineGroup (ZMod 8)) (affineχ₈Section u) := by
  obtain ⟨a, ha⟩ : ∃ a : ZMod 8, (1 - (u : ZMod 8)) * a = 2 * (1 - (χ₈ u : ZMod 8)) := by
    revert u
    decide
  refine isConj_iff.mpr
    ⟨SemidirectProduct.inl (.ofAdd a), AffineGroup.ext ?_ (by simp)⟩
  rw [AffineGroup.toAdd_mul_mul_inv_left]
  simpa using ha

/-- **The linear factor and `affineχ₈Subgroup` are almost conjugate** in the affine group of
`ZMod 8`: they meet every conjugacy class in the same number of elements. -/
theorem almostConjugate_affineLinearSubgroup_affineχ₈Subgroup :
    (affineLinearSubgroup (ZMod 8)).AlmostConjugate affineχ₈Subgroup := by
  rw [affineLinearSubgroup_def, affineχ₈Subgroup]
  refine Subgroup.almostConjugate_of_equiv_of_isConj
    ((MonoidHom.ofInjective SemidirectProduct.inr_injective).symm.trans
      (MonoidHom.ofInjective affineχ₈Section_injective)).toEquiv fun h ↦ ?_
  obtain ⟨u, rfl⟩ := (MonoidHom.ofInjective SemidirectProduct.inr_injective).surjective h
  simpa [MonoidHom.ofInjective_apply] using isConj_inr_affineχ₈Section u

/-- **The linear factor and `affineχ₈Subgroup` are not conjugate** in the affine group of
`ZMod 8`. -/
theorem not_exists_conj_smul_affineLinearSubgroup_eq_affineχ₈Subgroup :
    ¬ ∃ g : AffineGroup (ZMod 8), MulAut.conj g • affineLinearSubgroup (ZMod 8) =
      affineχ₈Subgroup := by
  rintro ⟨g, hg⟩
  -- The conjugates of `(0, 3)` and `(0, 5)` by `g = (a, u)` are `(-2 a, 3)` and `(-4 a, 5)`, and
  -- they would both have to have translation part `4`.
  have key (n : ℕ) (hn : n.Coprime 8) :
      (1 - (n : ZMod 8)) * g.left.toAdd = 2 * (1 - (χ₈ n : ZMod 8)) := by
    have hmem : MulAut.conj g • (SemidirectProduct.inr (unitOfCoprime n hn)) ∈ affineχ₈Subgroup :=
      hg ▸ Subgroup.smul_mem_pointwise_smul _ _ _
        ((mem_affineLinearSubgroup_iff _).mpr rfl)
    rw [MulAut.smul_def, MulAut.conj_apply, mem_affineχ₈Subgroup_iff,
      AffineGroup.toAdd_mul_mul_inv_left, AffineGroup.mul_mul_inv_right] at hmem
    simpa using hmem
  have h3 := key 3 (by norm_num)
  have h5 := key 5 (by norm_num)
  revert h3 h5
  generalize g.left.toAdd = a
  revert a
  decide

/-- **The affine group of `ZMod 8` is generated by `(1, 1)`, `(0, 3)` and `(0, 5)`**: the
translation `x ↦ x + 1` and the multiplications by `3` and by `5`. -/
theorem closure_inl_one_inr_three_inr_five_eq_top :
    Subgroup.closure ({SemidirectProduct.inl (.ofAdd 1),
      SemidirectProduct.inr (unitOfCoprime 3 (by norm_num)),
      SemidirectProduct.inr (unitOfCoprime 5 (by norm_num))} : Set (AffineGroup (ZMod 8))) = ⊤ := by
  set S : Subgroup (AffineGroup (ZMod 8)) := Subgroup.closure _
  have ht : SemidirectProduct.inl (.ofAdd 1) ∈ S := Subgroup.subset_closure (by simp)
  have h3 : SemidirectProduct.inr (unitOfCoprime 3 (by norm_num)) ∈ S :=
    Subgroup.subset_closure (by simp)
  have h5 : SemidirectProduct.inr (unitOfCoprime 5 (by norm_num)) ∈ S :=
    Subgroup.subset_closure (by simp)
  refine eq_top_iff.mpr fun g _ ↦ ?_
  rw [← SemidirectProduct.inl_left_mul_inr_right g]
  refine S.mul_mem ?_ ?_
  · -- The translation `x ↦ x + b` is the `b.val`-th power of `x ↦ x + 1`.
    have hb : g.left = (.ofAdd 1) ^ g.left.toAdd.val := by
      rw [← ofAdd_nsmul, nsmul_one, ZMod.natCast_zmod_val, ofAdd_toAdd]
    rw [hb, map_pow]
    exact S.pow_mem ht _
  · -- The four units are `1`, `3`, `5` and `3 * 5`.
    have hu : ∀ u : (ZMod 8)ˣ, u = 1 ∨ u = unitOfCoprime 3 (by norm_num) ∨
        u = unitOfCoprime 5 (by norm_num) ∨
          u = unitOfCoprime 3 (by norm_num) * unitOfCoprime 5 (by norm_num) := by
      decide
    rcases hu g.right with h | h | h | h <;> rw [h]
    · rw [map_one]
      exact S.one_mem
    · exact h3
    · exact h5
    · rw [map_mul]
      exact S.mul_mem h3 h5

/-- **`affineχ₈Subgroup` has trivial normal core**: conjugating a nonidentity element of it by the
translation `x ↦ x + 1` gives an element outside it. Equivalently (`Subgroup.normalCore_eq_ker`),
the affine group of `ZMod 8` acts faithfully on the cosets of `affineχ₈Subgroup`. -/
theorem normalCore_affineχ₈Subgroup : affineχ₈Subgroup.normalCore = ⊥ := by
  refine (Subgroup.eq_bot_iff_forall _).mpr fun g hg ↦ ?_
  have h₀ := (mem_affineχ₈Subgroup_iff g).mp (Subgroup.normalCore_le _ hg)
  have h₁ := (mem_affineχ₈Subgroup_iff _).mp (hg (SemidirectProduct.inl (.ofAdd 1)))
  rw [AffineGroup.toAdd_mul_mul_inv_left, AffineGroup.mul_mul_inv_right, ← h₀] at h₁
  -- Both elements have translation part `2 (1 - χ₈ v)`, so `1 - v = 0`.
  have hv : (g.right : ZMod 8) = 1 := by
    simp only [SemidirectProduct.left_inl, SemidirectProduct.right_inl, toAdd_ofAdd,
      Units.val_one, one_mul, mul_one, add_eq_left] at h₁
    exact (sub_eq_zero.mp h₁).symm
  have hv' : g.right = 1 := Units.ext hv
  refine AffineGroup.ext ?_ (by simpa using hv)
  rw [h₀, hv']
  decide

end TauCeti
