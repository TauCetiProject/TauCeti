/-!
# The monomial subgroup `2¹² : M₂₄` of `Co₀`

The canonical Leech lattice `Λ ⊆ ℚ^(Fin 24)` is glued from the Golay Construction B lattice `K`
along the odd shift `s = (-3/2, 1/2, …, 1/2)`, so that `Λ = K ∪ (s + K)`. Two kinds of signed
coordinate changes preserve it.

* For a Golay codeword `c`, the **sign change** `ε_c` negates the coordinates in the support of
  `c`. It preserves `K` because the Golay code is self-orthogonal, and it moves `s` by an element
  of `K` because the weight of `c` is divisible by four.
* For a coordinate permutation `σ` preserving the Golay code, the **coordinate permutation**
  `π_σ : x ↦ x ∘ σ⁻¹` preserves `K`, and it moves `s` by an even integer vector of coordinate sum
  zero, which lies in `K`.

Both are isometries of the halved dot product, so they lie in `Co₀ = Aut(Λ)`. They satisfy
`π_σ ε_c π_σ⁻¹ = ε_{σ • c}`, where `σ • c = c ∘ σ⁻¹` is the action of the Golay permutation
automorphism group on the code. Hence they assemble into a homomorphism from the semidirect
product `2¹² ⋊ Aut(𝒢)` of the Golay code by its permutation automorphism group, which is
injective: a sign change that is also a coordinate permutation fixes every coordinate vector, so
it is trivial. Since the code has `2¹² = 4096` words and its permutation automorphism group is
`M₂₄`, of order `244823040`, the image, the monomial subgroup of `Co₀`, has order
`4096 * 244823040 = 1002795171840`.

Conversely, every isometry of `Λ` that is a signed coordinate change lies in this subgroup: its
permutation preserves the Golay code, because it carries the `0`/`1` lifts of codewords, which lie
in `K`, to integer vectors of `Λ`; and its signs form a codeword, read off from the image of `s`
modulo two. So the monomial subgroup is exactly the group of signed coordinate isometries of `Λ`.

These are the monomial generators of `Co₀` used by Conway. That the full group is generated by
this subgroup and one further isometry is not proved here.

## Main declarations

* `TauCeti.Sporadic.Co0.signChangeHom`: the sign changes `ε_c`, as a homomorphism from the Golay
  code, written multiplicatively.
* `TauCeti.Sporadic.Co0.coordPermHom`: the coordinate permutations `π_σ` for the Golay permutation
  automorphisms `σ`.
* `TauCeti.Sporadic.Co0.coordPermHom_mul_signChangeHom_mul_inv`: the conjugation formula
  `π_σ ε_c π_σ⁻¹ = ε_{σ • c}`.
* `TauCeti.Sporadic.Co0.monomialHom`: the homomorphism from the semidirect product
  `2¹² ⋊ Aut(𝒢)`, and `TauCeti.Sporadic.Co0.monomialHom_injective`.
* `TauCeti.Sporadic.Co0.monomialSubgroup`: its image, with `monomialSubgroupEquiv` identifying it
  with the semidirect product and `TauCeti.Sporadic.Co0.natCard_monomialSubgroup`: its order
  `1002795171840`.
* `TauCeti.Sporadic.Co0.mem_monomialSubgroup_iff`: the monomial subgroup consists exactly of the
  isometries of `Λ` that are signed coordinate changes.
* `TauCeti.Sporadic.Co0.signChangeHom_ofAdd_one`: the sign change by the all-ones word is `-1`.

## References

* J. H. Conway, *A group of order 8,315,553,613,086,720,000*, Bull. London Math. Soc. **1**
  (1969), 79–88.
* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, Chapter 10, §3.
* R. A. Wilson, *The Finite Simple Groups*, §5.4.
-/

public section

namespace TauCeti.Sporadic

open IntegralLattice BinaryGolay

namespace Co0

/-! ### Signs and integer vectors -/

/-- The sign attached to a coordinate of a binary word: `1` off its support and `-1` on it. -/
private def wordSign (c : Fin 24 → ZMod 2) (i : Fin 24) : ℤˣ :=
  if c i = 0 then 1 else -1

/-- A rational vector of the Golay Construction B lattice is an integer vector. -/
private theorem exists_intCast_eq_of_mem {x : Fin 24 → ℚ}
    (hx : x ∈ constructionBLattice.carrier) : ∃ z : Fin 24 → ℤ, x = fun i ↦ (z i : ℚ) := by
  obtain ⟨z, -, rfl⟩ := (ConstructionA.mem_lattice 2).mp
    (ConstructionB.lattice_le BinaryGolay.code (constructionBLattice_carrier ▸ hx))
  exact ⟨z, rfl⟩

/-- A vector with a half-odd coordinate does not lie in the Golay Construction B lattice, whose
vectors are integral. -/
private theorem notMem_of_apply_eq_add_half {x : Fin 24 → ℚ} {j : Fin 24} {m : ℤ}
    (hx : x j = m + 1 / 2) : x ∉ constructionBLattice.carrier := by
  intro hK
  obtain ⟨z, rfl⟩ := exists_intCast_eq_of_mem hK
  have h2 : ((2 * z j : ℤ) : ℚ) = ((2 * m + 1 : ℤ) : ℚ) := by push_cast; linarith
  have := Int.cast_injective h2
  omega

/-- A linear map of the rational ambient space that preserves the Golay Construction B lattice
and moves the Leech shift by an element of it preserves the Leech lattice. -/
private theorem map_mem_leechLattice (f : (Fin 24 → ℚ) →ₗ[ℚ] Fin 24 → ℚ)
    (hK : ∀ x ∈ constructionBLattice.carrier, f x ∈ constructionBLattice.carrier)
    (hs : f leechShift - leechShift ∈ constructionBLattice.carrier) {x : Fin 24 → ℚ}
    (hx : x ∈ leechLattice.carrier) : f x ∈ leechLattice.carrier := by
  rw [mem_leechLattice_carrier_iff] at hx ⊢
  refine hx.imp (hK x) fun hx ↦ ?_
  have h := add_mem (hK _ hx) hs
  rwa [map_sub, sub_add_sub_cancel] at h

/-! ### Signed coordinate changes preserving the Leech lattice -/

/-- A signed coordinate change which, together with its inverse, preserves the Leech lattice is an
isometry of the Leech lattice. -/
private def ofSignedEquiv (u : Fin 24 → ℤˣ) (σ : Equiv.Perm (Fin 24))
    (h : ∀ x ∈ leechLattice.carrier, signedEquiv u σ x ∈ leechLattice.carrier)
    (h' : ∀ x ∈ leechLattice.carrier, (signedEquiv u σ).symm x ∈ leechLattice.carrier) :
    Co0 where
  toIsometryEquiv :=
    { toLinearEquiv := signedEquiv u σ
      map_app' x y := by simp }
  map_carrier := by
    apply le_antisymm
    · rintro _ ⟨x, hx, rfl⟩
      exact h x hx
    · intro x hx
      exact ⟨_, h' x hx, by simp⟩

private theorem ofSignedEquiv_apply (u : Fin 24 → ℤˣ) (σ : Equiv.Perm (Fin 24)) (h h')
    (x : Fin 24 → ℚ) : ofSignedEquiv u σ h h' x = signedEquiv u σ x := (rfl)

/-! #### Sign changes -/

/-- The sign change by a Golay codeword preserves the Golay Construction B lattice: the change in
the coordinate sum is twice the sum over the support of `c`, which is even because the code is
self-orthogonal. -/
private theorem signedEquiv_wordSign_mem {c : Fin 24 → ZMod 2} (hc : c ∈ BinaryGolay.code)
    {x : Fin 24 → ℚ} (hx : x ∈ constructionBLattice.carrier) :
    signedEquiv (wordSign c) (Equiv.refl _) x ∈ constructionBLattice.carrier := by
  obtain ⟨z, rfl⟩ := exists_intCast_eq_of_mem hx
  obtain ⟨hz, hsum⟩ :=
    (ConstructionB.intCast_mem_lattice _ z).mp (constructionBLattice_carrier ▸ hx)
  have heq : signedEquiv (wordSign c) (Equiv.refl _) (fun i ↦ (z i : ℚ)) =
      fun i ↦ ((z i - 2 * if c i = 0 then 0 else z i : ℤ) : ℚ) := by
    funext i
    simp only [signedEquiv_apply, Equiv.refl_symm, Equiv.refl_apply, wordSign]
    by_cases h : c i = 0 <;> simp [h]
    ring
  rw [heq, constructionBLattice_carrier, ConstructionB.intCast_mem_lattice]
  constructor
  · convert hz using 2 with i
    push_cast
    simp only [CharTwo.two_eq_zero, zero_mul, sub_zero]
  · -- The sum over the support of `c` reduces to the dot product of `c` with `z` modulo two.
    have hdot : ((∑ i, if c i = 0 then 0 else z i : ℤ) : ZMod 2) = 0 := by
      have h := (Submodule.isSelfOrthogonal_iff.mp isDoublyEven_code.isSelfOrthogonal) c hc _ hz
      rw [dotProduct] at h
      push_cast
      have hmul : ∀ a b : ZMod 2, (if a = 0 then 0 else b) = a * b := by decide
      simpa only [apply_ite (Int.cast : ℤ → ZMod 2), Int.cast_zero, hmul] using h
    obtain ⟨k, hk⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mp hdot
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum, hk]
    exact dvd_sub hsum ⟨k, by ring⟩

/-- The sign change by a Golay codeword moves the Leech shift by an element of the Golay
Construction B lattice: the difference is the integer vector which is `3` at the coordinate `0`
and `-1` at the other coordinates of the support of `c`, and `0` elsewhere. Its coordinate sum is
divisible by four because the weight of `c` is. -/
private theorem signedEquiv_wordSign_leechShift_sub_mem {c : Fin 24 → ZMod 2}
    (hc : c ∈ BinaryGolay.code) :
    signedEquiv (wordSign c) (Equiv.refl _) leechShift - leechShift ∈
      constructionBLattice.carrier := by
  set z : Fin 24 → ℤ := fun i ↦ (if c i = 0 then 0 else -1) + if i = 0 ∧ c i ≠ 0 then 4 else 0
  have heq : signedEquiv (wordSign c) (Equiv.refl _) leechShift - leechShift =
      fun i ↦ (z i : ℚ) := by
    funext i
    simp only [Pi.sub_apply, signedEquiv_apply, Equiv.refl_symm, Equiv.refl_apply, wordSign, z]
    by_cases hi : i = 0
    · subst hi
      split_ifs <;> simp_all
    · rw [leechShift_of_ne_zero hi]
      split_ifs <;> simp_all; norm_num
  rw [heq, constructionBLattice_carrier, ConstructionB.intCast_mem_lattice]
  constructor
  · convert hc using 1
    funext i
    by_cases h : c i = 0
    · simp [z, h]
    · have h1 : c i = 1 := ((by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) _).resolve_left h
      simp only [z, h, ite_false, ne_eq, not_false_eq_true, and_true]
      rw [h1]
      split_ifs <;> decide
  · have hcard : ∑ i, (if c i = 0 then (0 : ℤ) else -1) = -(hammingNorm c : ℤ) := by
      rw [Finset.sum_ite, Finset.sum_const_zero, Finset.sum_const, zero_add, smul_neg,
        nsmul_eq_mul, mul_one, hammingNorm]
    rw [Finset.sum_add_distrib, hcard]
    refine dvd_add (dvd_neg.mpr (Int.natCast_dvd_natCast.mpr
      (BinaryCode.isDoublyEven_iff.mp isDoublyEven_code c hc)))
      (Finset.dvd_sum fun i _ ↦ ?_)
    split_ifs
    · exact dvd_refl 4
    · exact dvd_zero 4

/-- The sign change by a codeword preserves the Leech lattice. -/
private theorem signedEquiv_wordSign_mem_leechLattice {c : Fin 24 → ZMod 2}
    (hc : c ∈ BinaryGolay.code) {x : Fin 24 → ℚ} (hx : x ∈ leechLattice.carrier) :
    signedEquiv (wordSign c) (Equiv.refl _) x ∈ leechLattice.carrier :=
  map_mem_leechLattice (signedEquiv (wordSign c) (Equiv.refl _)).toLinearMap
    (fun _ ↦ signedEquiv_wordSign_mem hc) (signedEquiv_wordSign_leechShift_sub_mem hc) hx

/-- A sign change is an involution. -/
private theorem signedEquiv_wordSign_symm_apply (c : Fin 24 → ZMod 2) (x : Fin 24 → ℚ) :
    (signedEquiv (wordSign c) (Equiv.refl _)).symm x =
      signedEquiv (wordSign c) (Equiv.refl _) x := by
  rw [LinearEquiv.symm_apply_eq, signedEquiv_signedEquiv]

/-! #### Coordinate permutations -/

/-- The coordinates of the Leech shift. -/
private theorem leechShift_apply (i : Fin 24) :
    leechShift i = if i = 0 then -(3 / 2) else 1 / 2 := by
  split_ifs with h
  · rw [h, leechShift_zero]
  · exact leechShift_of_ne_zero h

/-- A Golay permutation automorphism preserves the Golay Construction B lattice: it permutes the
coordinates of an integer vector, preserving its reduction modulo two in the code and its
coordinate sum. -/
private theorem signedEquiv_one_mem {σ : Equiv.Perm (Fin 24)}
    (hσ : σ ∈ AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup) {x : Fin 24 → ℚ}
    (hx : x ∈ constructionBLattice.carrier) :
    signedEquiv 1 σ x ∈ constructionBLattice.carrier := by
  obtain ⟨z, rfl⟩ := exists_intCast_eq_of_mem hx
  obtain ⟨hz, hsum⟩ :=
    (ConstructionB.intCast_mem_lattice _ z).mp (constructionBLattice_carrier ▸ hx)
  have heq : signedEquiv 1 σ (fun i ↦ (z i : ℚ)) = fun i ↦ ((z (σ.symm i) : ℤ) : ℚ) := by
    funext i
    simp [signedEquiv_apply]
  rw [heq, constructionBLattice_carrier, ConstructionB.intCast_mem_lattice,
    Equiv.sum_comp σ.symm z]
  exact ⟨AdditiveCode.comp_symm_mem_of_mem_permutationAut hσ hz, hsum⟩

/-- A coordinate permutation moves the Leech shift by the integer vector which is `2` at the
coordinate `0` and `-2` at the coordinate `σ 0` (and zero if they coincide). It is even with
coordinate sum zero, so it lies in the Golay Construction B lattice. -/
private theorem signedEquiv_one_leechShift_sub_mem (σ : Equiv.Perm (Fin 24)) :
    signedEquiv 1 σ leechShift - leechShift ∈ constructionBLattice.carrier := by
  have heq : signedEquiv 1 σ leechShift - leechShift = fun i ↦
      ((2 * ((if i = 0 then 1 else 0) - if i = σ 0 then 1 else 0) : ℤ) : ℚ) := by
    funext i
    simp only [Pi.sub_apply, signedEquiv_apply, Pi.one_apply, Units.val_one, Int.cast_one,
      one_mul, leechShift_apply, Equiv.symm_apply_eq]
    push_cast
    split_ifs <;> norm_num
  rw [heq, constructionBLattice_carrier, ConstructionB.intCast_mem_lattice, ← Finset.mul_sum,
    Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.sum_ite_eq']
  push_cast
  simp only [CharTwo.two_eq_zero, zero_mul, Finset.mem_univ, ite_true, sub_self,
    mul_zero, dvd_zero, and_true]
  exact zero_mem _

/-- A Golay permutation automorphism preserves the Leech lattice. -/
private theorem signedEquiv_one_mem_leechLattice {σ : Equiv.Perm (Fin 24)}
    (hσ : σ ∈ AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup) {x : Fin 24 → ℚ}
    (hx : x ∈ leechLattice.carrier) : signedEquiv 1 σ x ∈ leechLattice.carrier :=
  map_mem_leechLattice (signedEquiv 1 σ).toLinearMap (fun _ ↦ signedEquiv_one_mem hσ)
    (signedEquiv_one_leechShift_sub_mem σ) hx

/-- The inverse of a coordinate permutation is the permutation by the inverse. -/
private theorem signedEquiv_one_symm_apply (σ : Equiv.Perm (Fin 24)) (x : Fin 24 → ℚ) :
    (signedEquiv 1 σ).symm x = signedEquiv 1 σ⁻¹ x := by
  rw [LinearEquiv.symm_apply_eq]
  funext i
  simp [signedEquiv_apply, Equiv.Perm.inv_def]

/-! ### The sign changes and coordinate permutations as homomorphisms -/

/-- The sign change `ε_c` by a Golay codeword `c`, negating the coordinates in the support of `c`,
as an isometry of the Leech lattice. -/
private def signChange (c : BinaryGolay.code.toAddSubgroup) : Co0 :=
  ofSignedEquiv (wordSign c) (Equiv.refl _)
    (fun _ ↦ signedEquiv_wordSign_mem_leechLattice c.property)
    (fun x hx ↦ by
      rw [signedEquiv_wordSign_symm_apply]
      exact signedEquiv_wordSign_mem_leechLattice c.property hx)

private theorem signChange_apply (c : BinaryGolay.code.toAddSubgroup) (x : Fin 24 → ℚ)
    (i : Fin 24) :
    signChange c x i = if (c : Fin 24 → ZMod 2) i = 0 then x i else -x i := by
  rw [signChange, ofSignedEquiv_apply, signedEquiv_apply]
  by_cases h : (c : Fin 24 → ZMod 2) i = 0 <;> simp [wordSign, h]

/-- **The sign changes by Golay codewords.** The sign change `ε_c` by a codeword `c` negates the
coordinates in the support of `c`; it is an isometry of the Leech lattice, and `c ↦ ε_c` is a
homomorphism from the Golay code, written multiplicatively. -/
def signChangeHom : Multiplicative BinaryGolay.code.toAddSubgroup →* Co0 where
  toFun c := signChange c.toAdd
  map_one' := Isometry.ext fun x ↦ funext fun i ↦ by simp [signChange_apply]
  map_mul' c d := Isometry.ext fun x ↦ funext fun i ↦ by
    simp only [signChange_apply, Isometry.mul_apply, toAdd_mul, AddSubgroup.coe_add,
      Pi.add_apply]
    rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) ((c.toAdd : Fin 24 → ZMod 2) i) with h | h <;>
      rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) ((d.toAdd : Fin 24 → ZMod 2) i) with
        h' | h' <;>
      simp [h, h', CharTwo.add_self_eq_zero]

/-- The sign change `ε_c` negates exactly the coordinates in the support of `c`. -/
@[simp]
theorem signChangeHom_apply (c : Multiplicative BinaryGolay.code.toAddSubgroup)
    (x : Fin 24 → ℚ) (i : Fin 24) :
    signChangeHom c x i = if (c.toAdd : Fin 24 → ZMod 2) i = 0 then x i else -x i :=
  signChange_apply _ x i

/-- **The coordinate permutations by Golay permutation automorphisms.** For a coordinate
permutation `σ` preserving the Golay code, `π_σ : x ↦ x ∘ σ⁻¹` is an isometry of the Leech
lattice, and `σ ↦ π_σ` is a homomorphism. -/
def coordPermHom : AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup →* Co0 where
  toFun σ :=
    ofSignedEquiv 1 σ (fun _ ↦ signedEquiv_one_mem_leechLattice σ.property)
      (fun x hx ↦ by
        rw [signedEquiv_one_symm_apply]
        exact signedEquiv_one_mem_leechLattice (inv_mem σ.property) hx)
  map_one' := Isometry.ext fun x ↦ funext fun i ↦ by
    simp only [ofSignedEquiv_apply, signedEquiv_apply, Pi.one_apply, Units.val_one, Int.cast_one,
      one_mul, Isometry.one_apply, OneMemClass.coe_one]
    rfl
  map_mul' σ τ := Isometry.ext fun x ↦ funext fun i ↦ by
    simp [ofSignedEquiv_apply, signedEquiv_apply, Equiv.Perm.mul_def]

/-- The coordinate permutation `π_σ` sends `x` to `x ∘ σ⁻¹`. -/
@[simp]
theorem coordPermHom_apply (σ : AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup)
    (x : Fin 24 → ℚ) (i : Fin 24) : coordPermHom σ x i = x ((σ : Equiv.Perm (Fin 24)).symm i) := by
  simp [coordPermHom, ofSignedEquiv_apply, signedEquiv_apply]

/-- The action of the Golay permutation automorphisms on the code, `σ • c = c ∘ σ⁻¹`, written
multiplicatively. -/
noncomputable def codeAction : AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup →*
    MulAut (Multiplicative BinaryGolay.code.toAddSubgroup) where
  toFun σ := AddEquiv.toMultiplicative (DistribMulAction.toAddEquiv _ σ)
  map_one' := MulEquiv.ext fun c ↦ by simp
  map_mul' σ τ := MulEquiv.ext fun c ↦ by simp [mul_smul]

/-- The action of a Golay permutation automorphism on a codeword is `c ↦ c ∘ σ⁻¹`. -/
@[simp]
theorem codeAction_apply (σ : AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup)
    (c : Multiplicative BinaryGolay.code.toAddSubgroup) :
    codeAction σ c = Multiplicative.ofAdd (σ • c.toAdd) := (rfl)

/-- **The conjugation formula** `π_σ ε_c π_σ⁻¹ = ε_{σ • c}`. -/
theorem coordPermHom_mul_signChangeHom_mul_inv
    (σ : AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup)
    (c : Multiplicative BinaryGolay.code.toAddSubgroup) :
    coordPermHom σ * signChangeHom c * (coordPermHom σ)⁻¹ = signChangeHom (codeAction σ c) := by
  rw [← map_inv coordPermHom σ]
  refine Isometry.ext fun x ↦ funext fun i ↦ ?_
  simp only [Isometry.mul_apply, coordPermHom_apply, signChangeHom_apply, codeAction_apply,
    toAdd_ofAdd, AdditiveCode.coe_smul_permutationAut, Function.comp_apply, InvMemClass.coe_inv,
    Equiv.Perm.inv_def, Equiv.symm_symm, Equiv.apply_symm_apply]

/-! ### The monomial subgroup -/

/-- **The monomial isometries `2¹² : M₂₄` of the Leech lattice.** The sign changes and the
coordinate permutations assemble into a homomorphism from the semidirect product of the Golay
code, written multiplicatively, by its permutation automorphism group, sending `(c, σ)` to
`ε_c π_σ`. -/
noncomputable def monomialHom :
    Multiplicative BinaryGolay.code.toAddSubgroup ⋊[codeAction]
      AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup →* Co0 :=
  SemidirectProduct.lift signChangeHom coordPermHom fun σ ↦ MonoidHom.ext fun c ↦
    (coordPermHom_mul_signChangeHom_mul_inv σ c).symm

/-- The monomial isometry of `(c, σ)` is `ε_c π_σ`. -/
@[simp]
theorem monomialHom_apply
    (p : Multiplicative BinaryGolay.code.toAddSubgroup ⋊[codeAction]
      AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup) :
    monomialHom p = signChangeHom p.left * coordPermHom p.right := (rfl)

/-- **The monomial isometries are faithfully parametrized**: `(c, σ) ↦ ε_c π_σ` is injective. -/
theorem monomialHom_injective : Function.Injective monomialHom := by
  refine (injective_iff_map_eq_one _).mpr fun p hp ↦ ?_
  -- If `ε_c π_σ = 1`, evaluating it on `e_j` at the coordinate `σ j` shows that `σ` fixes `j`
  -- and that `c` vanishes at `j`.
  have key : ∀ j, (p.right : Equiv.Perm (Fin 24)) j = j ∧
      (p.left.toAdd : Fin 24 → ZMod 2) j = 0 := by
    intro j
    have h := congrFun (congrArg (fun e : Co0 ↦ e (Pi.single j 1)) hp)
      ((p.right : Equiv.Perm (Fin 24)) j)
    simp only [monomialHom_apply, Isometry.mul_apply, signChangeHom_apply, coordPermHom_apply,
      Equiv.symm_apply_apply, Pi.single_eq_same, Isometry.one_apply] at h
    by_cases hj : (p.right : Equiv.Perm (Fin 24)) j = j
    · rw [hj, Pi.single_eq_same] at h
      refine ⟨hj, ?_⟩
      by_contra hc
      rw [ite_eq_right hc] at h
      norm_num at h
    · rw [Pi.single_eq_of_ne hj] at h
      split_ifs at h <;> norm_num at h
  refine SemidirectProduct.ext ?_ ?_
  · exact Multiplicative.toAdd.injective (Subtype.ext (funext fun j ↦ (key j).2))
  · exact Subtype.ext (Equiv.ext fun j ↦ (key j).1)

/-- Distinct Golay codewords give distinct sign changes. -/
theorem signChangeHom_injective : Function.Injective signChangeHom := by
  have h := monomialHom_injective.comp SemidirectProduct.inl_injective
  rwa [show monomialHom ∘ SemidirectProduct.inl = signChangeHom from
    funext (SemidirectProduct.lift_inl _ _ _)] at h

/-- Distinct Golay permutation automorphisms give distinct coordinate permutations. -/
theorem coordPermHom_injective : Function.Injective coordPermHom := by
  have h := monomialHom_injective.comp SemidirectProduct.inr_injective
  rwa [show monomialHom ∘ SemidirectProduct.inr = coordPermHom from
    funext (SemidirectProduct.lift_inr _ _ _)] at h

/-- **The monomial subgroup of `Co₀`**, the image `2¹² : M₂₄` of `monomialHom`: the isometries
`ε_c π_σ` for Golay codewords `c` and Golay permutation automorphisms `σ`. -/
noncomputable def monomialSubgroup : Subgroup Co0 := monomialHom.range

/-- The monomial subgroup is the range of `monomialHom`. -/
theorem monomialSubgroup_def : monomialSubgroup = monomialHom.range := (rfl)

/-- The monomial subgroup is isomorphic to the semidirect product `2¹² ⋊ Aut(𝒢)` of the Golay
code by its permutation automorphism group, which is `M₂₄` by
`TauCeti.Sporadic.M24.golayAdditivePermutationAutEquiv`. -/
noncomputable def monomialSubgroupEquiv :
    Multiplicative BinaryGolay.code.toAddSubgroup ⋊[codeAction]
      AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup ≃* monomialSubgroup :=
  MonoidHom.ofInjective monomialHom_injective

/-- The equivalence `monomialSubgroupEquiv` is `monomialHom` with its codomain restricted. -/
@[simp]
theorem coe_monomialSubgroupEquiv_apply
    (p : Multiplicative BinaryGolay.code.toAddSubgroup ⋊[codeAction]
      AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup) :
    (monomialSubgroupEquiv p : Co0) = monomialHom p :=
  MonoidHom.ofInjective_apply _

/-- **The monomial subgroup of `Co₀` has order `2¹² * |M₂₄| = 1002795171840`.** -/
theorem natCard_monomialSubgroup : Nat.card monomialSubgroup = 1002795171840 := by
  rw [← Nat.card_congr monomialSubgroupEquiv.toEquiv,
    Nat.card_congr SemidirectProduct.equivProd, Nat.card_prod,
    BinaryGolay.natCard_permutationAut_code_toAddSubgroup]
  have h : Nat.card (Multiplicative BinaryGolay.code.toAddSubgroup) = 4096 :=
    BinaryGolay.natCard_code
  rw [h]

/-- **The sign change by the all-ones word is `-1`.** In particular `-1` lies in the monomial
subgroup. -/
theorem signChangeHom_ofAdd_one :
    signChangeHom (Multiplicative.ofAdd ⟨1, BinaryCode.one_mem_of_isSelfDual isSelfDual_code⟩) =
      Isometry.neg leechLattice :=
  Isometry.ext fun x ↦ funext fun i ↦ by simp

/-- The isometry `-1` lies in the monomial subgroup. -/
theorem neg_mem_monomialSubgroup : Isometry.neg leechLattice ∈ monomialSubgroup :=
  ⟨SemidirectProduct.inl
      (Multiplicative.ofAdd ⟨1, BinaryCode.one_mem_of_isSelfDual isSelfDual_code⟩), by
    rw [monomialHom_apply, SemidirectProduct.left_inl, SemidirectProduct.right_inl, map_one,
      mul_one, signChangeHom_ofAdd_one]⟩

/-! ### Every signed coordinate isometry is monomial -/

/-- A signed coordinate change preserving the Leech lattice permutes the coordinates by a Golay
permutation automorphism. Lifting a codeword `w` to its `0`/`1` integer vector gives a vector of
the Golay Construction B lattice, because the weight of `w` is divisible by four; its image is
an integer vector of the Leech lattice, which therefore lies in `K`, and reduces to `w ∘ σ⁻¹`
modulo two. -/
private theorem mem_permutationAut_of_signedEquiv {u : Fin 24 → ℤˣ} {σ : Equiv.Perm (Fin 24)}
    (h : ∀ x ∈ leechLattice.carrier, signedEquiv u σ x ∈ leechLattice.carrier) :
    σ ∈ AdditiveCode.permutationAut BinaryGolay.code.toAddSubgroup := by
  have key : ∀ w ∈ BinaryGolay.code, w ∘ σ.symm ∈ BinaryGolay.code := by
    intro w hw
    have hz : (fun i ↦ (((w i).val : ℤ) : ℚ)) ∈ constructionBLattice.carrier := by
      rw [constructionBLattice_carrier, ConstructionB.intCast_mem_lattice]
      refine ⟨by simpa using hw, ?_⟩
      have hsum : ∑ i, ((w i).val : ℤ) = (hammingNorm w : ℤ) := by
        rw [← sum_val_eq_hammingNorm, Nat.cast_sum]
      rw [hsum]
      exact Int.natCast_dvd_natCast.mpr (BinaryCode.isDoublyEven_iff.mp isDoublyEven_code w hw)
    have himg := h _ (constructionBLattice_carrier_le_leechLattice_carrier hz)
    set z : Fin 24 → ℤ := fun j ↦ (u (σ.symm j) : ℤ) * ((w (σ.symm j)).val : ℤ)
    have heq : signedEquiv u σ (fun i ↦ (((w i).val : ℤ) : ℚ)) = fun j ↦ (z j : ℚ) := by
      funext j
      simp [z, signedEquiv_apply]
    rw [heq, mem_leechLattice_carrier_iff] at himg
    rcases himg with himg | himg
    · convert ((ConstructionB.intCast_mem_lattice _ z).mp
        (constructionBLattice_carrier ▸ himg)).1 using 1
      funext j
      rcases Int.units_eq_one_or (u (σ.symm j)) with hu | hu <;> simp [z, hu]
    · -- The difference with the shift has the half-odd coordinate `z 1 - 1 / 2`.
      refine absurd himg (notMem_of_apply_eq_add_half (j := 1) (m := z 1 - 1) ?_)
      rw [Pi.sub_apply, leechShift_of_ne_zero (by decide)]
      push_cast
      ring
  refine AdditiveCode.mem_permutationAut.mpr
    (AddSubgroup.eq_of_le_of_card_ge (fun y hy ↦ ?_) (AdditiveCode.natCard_reindex _ _).ge)
  have hy' := key _ (AdditiveCode.mem_reindex.mp hy)
  simpa [Function.comp_def] using hy'

/-- The binary word of the signs of a signed coordinate change, read in the target coordinates:
`1` where the coordinate `j` receives a negated coordinate. -/
private def signWord (u : Fin 24 → ℤˣ) (σ : Equiv.Perm (Fin 24)) (j : Fin 24) : ZMod 2 :=
  if u (σ.symm j) = 1 then 0 else 1

/-- A signed coordinate change preserving the Leech lattice negates the coordinates of a Golay
codeword. The image of the shift `s` has half-odd coordinates, so it lies in `s + K`; the
coordinate `j` of the integer vector `ε s - s` is even when the sign at `j` is `1` and odd when
it is `-1`, since `2 s` has all coordinates `≡ 1 (mod 4)`. -/
private theorem signWord_mem {u : Fin 24 → ℤˣ} {σ : Equiv.Perm (Fin 24)}
    (h : ∀ x ∈ leechLattice.carrier, signedEquiv u σ x ∈ leechLattice.carrier) :
    signWord u σ ∈ BinaryGolay.code := by
  have himg := (mem_leechLattice_carrier_iff _).mp (h _ leechShift_mem_leechLattice_carrier)
  rcases himg with himg | himg
  · -- The image of the shift has the half-odd coordinate `± 1 / 2` at `σ 1`.
    have h1 : signedEquiv u σ leechShift (σ 1) = (u 1 : ℚ) * (1 / 2) := by
      rw [signedEquiv_apply, Equiv.symm_apply_apply, leechShift_of_ne_zero (by decide)]
    rcases Int.units_eq_one_or (u 1) with hu | hu <;> rw [hu] at h1
    · refine absurd himg (notMem_of_apply_eq_add_half (j := σ 1) (m := 0) ?_)
      rw [h1]
      push_cast
      ring
    · refine absurd himg (notMem_of_apply_eq_add_half (j := σ 1) (m := -1) ?_)
      rw [h1]
      push_cast
      ring
  · obtain ⟨y, hy⟩ := exists_intCast_eq_of_mem himg
    convert ((ConstructionB.intCast_mem_lattice _ y).mp
      (constructionBLattice_carrier ▸ hy ▸ himg)).1 using 1
    funext j
    have hj := congrFun hy j
    simp only [Pi.sub_apply, signedEquiv_apply] at hj
    rw [leechShift_apply, leechShift_apply] at hj
    have hval : ∀ n : ℤ, (y j : ℚ) = n → ((y j : ℤ) : ZMod 2) = (n : ZMod 2) := by
      intro n hn
      rw [Int.cast_injective hn]
    simp only [signWord]
    rcases Int.units_eq_one_or (u (σ.symm j)) with hu | hu <;>
      simp only [hu, ite_true, Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one,
        show (-1 : ℤˣ) ≠ 1 by decide, ite_false] at hj ⊢ <;>
      split_ifs at hj
    · rw [hval 0 (by push_cast; linarith)]; rfl
    · rw [hval (-2) (by push_cast; linarith)]; decide
    · rw [hval 2 (by push_cast; linarith)]; decide
    · rw [hval 0 (by push_cast; linarith)]; rfl
    · rw [hval 3 (by push_cast; linarith)]; decide
    · rw [hval 1 (by push_cast; linarith)]; decide
    · rw [hval 1 (by push_cast; linarith)]; decide
    · rw [hval (-1) (by push_cast; linarith)]; decide

/-- **The monomial subgroup is the group of signed coordinate isometries.** An isometry of the
Leech lattice lies in the monomial subgroup exactly when it is a signed coordinate change: then
its permutation preserves the Golay code and its signs form a codeword. -/
theorem mem_monomialSubgroup_iff (g : Co0) :
    g ∈ monomialSubgroup ↔
      ∃ (u : Fin 24 → ℤˣ) (σ : Equiv.Perm (Fin 24)), ∀ x, g x = signedEquiv u σ x := by
  constructor
  · rintro ⟨p, rfl⟩
    refine ⟨fun k ↦ wordSign (p.left.toAdd : Fin 24 → ZMod 2) ((p.right : Equiv.Perm _) k),
      p.right, fun x ↦ funext fun j ↦ ?_⟩
    simp only [monomialHom_apply, Isometry.mul_apply, signChangeHom_apply, coordPermHom_apply,
      signedEquiv_apply, Equiv.apply_symm_apply, wordSign]
    split_ifs <;> simp
  · rintro ⟨u, σ, hg⟩
    have h : ∀ x ∈ leechLattice.carrier, signedEquiv u σ x ∈ leechLattice.carrier := fun x hx ↦
      hg x ▸ g.map_carrier ▸ Submodule.mem_map_of_mem hx
    refine ⟨⟨Multiplicative.ofAdd ⟨signWord u σ, signWord_mem h⟩,
      ⟨σ, mem_permutationAut_of_signedEquiv h⟩⟩, Isometry.ext fun x ↦ funext fun j ↦ ?_⟩
    rw [hg]
    simp only [monomialHom_apply, Isometry.mul_apply, signChangeHom_apply, coordPermHom_apply,
      toAdd_ofAdd, signedEquiv_apply, signWord]
    rcases Int.units_eq_one_or (u (σ.symm j)) with hu | hu <;> simp [hu]

end Co0

end TauCeti.Sporadic
