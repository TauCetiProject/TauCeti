/- Every nonroot edge and its decreasing depth are kernel-checked.
Induction on depth then proves that every point is reachable from `0`. -/
private theorem orbitTree_step : ∀ i : Fin 276, i ≠ 0 →
    (orbitTree (orbitTree i).2.1).1 < (orbitTree i).1 ∧
      (if (orbitTree i).2.2 then a else b) (orbitTree i).2.1 = i := by
  decide +kernel

private theorem mem_orbit_zero (i : Fin 276) : i ∈ MulAction.orbit Co3 0 := by
  induction hn : (orbitTree i).1 using Nat.strong_induction_on generalizing i with
  | h n ih =>
    by_cases hi : i = 0
    · subst i
      exact MulAction.mem_orbit_self 0
    obtain ⟨hlt, heq⟩ := orbitTree_step i hi
    rw [hn] at hlt
    have hp := ih _ hlt _ rfl
    rw [← heq]
    split
    · exact MulAction.mem_orbit_of_mem_orbit (⟨a, a_mem⟩ : Co3) hp
    · exact MulAction.mem_orbit_of_mem_orbit (⟨b, b_mem⟩ : Co3) hp

/-- The model acts transitively on its 276 points. -/
instance instIsPretransitive : MulAction.IsPretransitive Co3 (Fin 276) :=
  (MulAction.isPretransitive_iff_base (G := Co3) 0).mpr fun i =>
    MulAction.mem_orbit_iff.mp (mem_orbit_zero i)

end Co3

/-- The model contains the nonidentity first file generator. -/
instance : Nontrivial Co3 :=
  Co3.nontrivial_iff_exists_ne_one.2 ⟨Co3.a, Co3.a_mem, by decide +kernel⟩

end TauCeti.Sporadic
