/-- The degree-276 ATLAS permutation model of the third Conway group. -/
def Co3 : Subgroup (Equiv.Perm (Fin 276)) := Subgroup.closure {Co3.a, Co3.b}

/-- The model is generated by the two file permutations. -/
theorem Co3_def : Co3 = Subgroup.closure {Co3.a, Co3.b} := (rfl)

namespace Co3

theorem a_mem : a ∈ Co3 := Co3_def ▸ Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ Co3 := Co3_def ▸ Subgroup.subset_closure (by simp)

/-! ### Transcription checks -/

private theorem direction_checks : b 0 = 203 ∧ b⁻¹ 0 = 81 ∧
    (a * b) 0 = 151 ∧ (b * a) 0 = 244 := by
  decide +kernel

/-- The first file generator has order three. -/
theorem orderOf_a : orderOf a = 3 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The second file generator has order four. -/
theorem orderOf_b : orderOf b = 4 :=
  orderOf_eq_prime_pow (p := 2) (n := 1) (by decide +kernel) (by decide +kernel)

/-- The product of the file generators has order fourteen. -/
theorem orderOf_a_mul_b : orderOf (a * b) = 14 := by
  apply orderOf_eq_of_pow_and_pow_div_prime (by decide) (by decide +kernel)
  intro p hp hdiv
  have h : p = 2 ∨ p = 7 := by
    have hpd : p ∣ 2 ∨ p ∣ 7 := hp.dvd_mul.mp hdiv
    rcases hpd with hpd | hpd
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp hpd)
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp hpd)
  rcases h with rfl | rfl <;> decide +kernel

