/-! ### Orders -/

/-- The first image is an involution. -/
theorem orderOf_imageA : orderOf imageA = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The second image has order five. -/
theorem orderOf_imageB : orderOf imageB = 5 :=
  have : Fact (Nat.Prime 5) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The product of the two images has order twenty-eight. -/
theorem orderOf_imageA_mul_imageB : orderOf (imageA * imageB) = 28 := by
  apply orderOf_eq_of_pow_and_pow_div_prime (by decide +kernel)
  intro p hp hdiv
  have h : p = 2 ∨ p = 7 := by
    have hpd : p ∣ 2 ^ 2 ∨ p ∣ 7 := hp.dvd_mul.mp hdiv
    rcases hpd with hpd | hpd
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp (hp.dvd_of_dvd_pow hpd))
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp hpd)
  rcases h with rfl | rfl <;> decide +kernel

/-! ### The images and the generators of the model as words in each other -/

/-- The first image as a word in the generators of the model. -/
theorem imageA_eq :
    imageA = a * a * b⁻¹ * a * a * a * b⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b * b * a * b * b * b * b * a *
      b * a⁻¹ * b⁻¹ * b⁻¹ * a * b * a⁻¹ * a⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ := by
  decide +kernel

/-- The second image as a word in the generators of the model. -/
theorem imageB_eq :
    imageB = b * a * b * a⁻¹ * b * b * a * b⁻¹ * a⁻¹ * a⁻¹ * b * a * a * b⁻¹ * a⁻¹ * b⁻¹ * b⁻¹ *
      b⁻¹ * a * b⁻¹ * b⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * b⁻¹ * b⁻¹ * a⁻¹ := by
  decide +kernel

/-- The first generator of the model as a word in the two images. -/
theorem a_eq :
    a = imageA * imageB * imageB * imageA * imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ * imageA *
      imageB * imageB * imageA * imageB * imageB * imageA * imageB * imageA * imageB * imageA *
      imageB⁻¹ * imageA * imageB * imageB * imageA * imageB * imageA * imageB⁻¹ * imageA *
      imageB⁻¹ * imageA * imageB⁻¹ * imageA * imageB * imageB * imageA * imageB * imageA * imageB *
      imageA * imageB * imageB * imageA * imageB * imageA * imageB * imageB * imageA * imageB *
      imageA * imageB * imageA * imageB * imageA * imageB⁻¹ * imageB⁻¹ * imageA := by
  decide +kernel

/-- The second generator of the model as a word in the two images. -/
theorem b_eq :
    b = imageB⁻¹ * imageA * imageB * imageB * imageA * imageB * imageB * imageA * imageB⁻¹ *
      imageA * imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ * imageA * imageB⁻¹ * imageA * imageB *
      imageA * imageB * imageA * imageB * imageA * imageB * imageA * imageB * imageB * imageA *
      imageB⁻¹ * imageB⁻¹ * imageA * imageB * imageA * imageB * imageA * imageB⁻¹ * imageA *
      imageB * imageA * imageB * imageA * imageB * imageA * imageB⁻¹ * imageB⁻¹ * imageA *
      imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ * imageA * imageB * imageA := by
  decide +kernel

/-! ### The assignment and the relators -/

/-- The images in the permutation model of the generators of the presentation of `Co₂`: `imageA`
for the generator of index `0` and `imageB` for the generator of index `1`. -/
noncomputable def presentationImage (i : Fin SporadicName.Co2.presentation.generatorCount) :
    Equiv.Perm (Fin 2300) :=
  if (i : ℕ) = 0 then imageA else imageB

/-- The assignment unfolded: `imageA` at index `0` and `imageB` otherwise. -/
theorem presentationImage_def (i : Fin SporadicName.Co2.presentation.generatorCount) :
    presentationImage i = if (i : ℕ) = 0 then imageA else imageB :=
  (rfl)

/-- The generator of index `0` goes to `imageA`. -/
@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.Co2.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageA := by
  simp [presentationImage]

/-- The generator of index `1` goes to `imageB`. -/
@[simp]
theorem presentationImage_one (h : 1 < SporadicName.Co2.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageB := by
  simp [presentationImage]

/-- The assignment has precisely the two chosen images as its values. -/
theorem range_presentationImage : Set.range presentationImage = {imageA, imageB} := by
  have h : SporadicName.Co2.presentation.generatorCount = 2 := by simp
  exact Set.range_ite_const ⟨⟨0, by omega⟩, rfl⟩ ⟨⟨1, by omega⟩, one_ne_zero⟩

/-- **The relators of `Co₂` hold in the model.** All ten transcribed relators of the presentation
of `Co₂` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.Co2.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.Co2.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_Co2`.
  suffices key : ∀ P : GroupPresentation, P = co2Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then imageA else imageB)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_Co2
  rintro P rfl
  simp only [co2Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  decide +kernel

/-! ### Generation and the surjection -/

/-- **The images generate the model.** The subgroup generated by the images `imageA` and `imageB`
of the presentation generators is the permutation model `Co2`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = Co2 := by
  rw [range_presentationImage, Co2_def]
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    have ha : a ∈ Subgroup.closure {a, b} := Subgroup.subset_closure (by simp)
    have hb : b ∈ Subgroup.closure {a, b} := Subgroup.subset_closure (by simp)
    -- Each image is a word in `a` and `b`; a word is peeled from the right.
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, imageA_eq, imageB_eq, mul_mem_cancel_right ha,
        mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem ha),
        mul_mem_cancel_right (inv_mem hb), ha, hb]
  · refine (Subgroup.closure_le _).mpr ?_
    have hA : imageA ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    have hB : imageB ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    -- Each generator of the model is a word in the two images.
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, a_eq, b_eq, mul_mem_cancel_right hA, mul_mem_cancel_right hB,
        mul_mem_cancel_right (inv_mem hB), inv_mem_iff, hA, hB]

/-- The homomorphism from the group presented by the presentation of `Co₂` to
`Equiv.Perm (Fin 2300)` sending the presentation generators to `presentationImage`. -/
noncomputable def presentationHom : SporadicName.Co2.Group →* Equiv.Perm (Fin 2300) :=
  SporadicName.Co2.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

/-- The homomorphism unfolded: the extension of `presentationImage` given by
`GroupPresentation.homEquiv`. -/
theorem presentationHom_def :
    presentationHom = SporadicName.Co2.presentation.homEquiv.symm
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

/-- The homomorphism sends each generator of the presented group to its chosen image. -/
@[simp]
theorem presentationHom_of (i : Fin SporadicName.Co2.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `Co2`. -/
theorem range_presentationHom : presentationHom.range = Co2 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end Co2

/-- **The presented group of `Co₂` maps onto the permutation model.** The group defined by the
presentation of `Co₂` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `Co2`. -/
theorem exists_surjective_Co2 :
    ∃ f : SporadicName.Co2.Group →* Co2, Function.Surjective f :=
  SporadicName.Co2.presentation.exists_surjective_of_closure_range_eq
    ⟨Co2.presentationImage, Co2.lift_presentationImage_toFreeGroup_eq_one⟩
    Co2.closure_range_presentationImage

/-- The group presented by the presentation of `Co₂` is nontrivial, since it maps onto the
nontrivial permutation model `Co2`. -/
instance : Nontrivial SporadicName.Co2.Group :=
  exists_surjective_Co2.choose_spec.nontrivial

end TauCeti.Sporadic
