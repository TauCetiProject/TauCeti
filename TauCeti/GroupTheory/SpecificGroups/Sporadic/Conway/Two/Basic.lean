/-- The permutation model of the second Conway group `Co₂`: the subgroup of
`Equiv.Perm (Fin 2300)` generated by `Co2.a` and `Co2.b`. -/
noncomputable def Co2 : Subgroup (Equiv.Perm (Fin 2300)) := Subgroup.closure {Co2.a, Co2.b}

/-- The model is generated by the two permutations `Co2.a` and `Co2.b`. -/
theorem Co2_def : Co2 = Subgroup.closure {Co2.a, Co2.b} := (rfl)

namespace Co2

/-- The first generator lies in the model. -/
theorem a_mem : a ∈ Co2 := Co2_def ▸ Subgroup.subset_closure (by simp)

/-- The second generator lies in the model. -/
theorem b_mem : b ∈ Co2 := Co2_def ▸ Subgroup.subset_closure (by simp)

/-! ### Generator orders -/

/-- The first generator has order twenty-three. -/
theorem orderOf_a : orderOf a = 23 :=
  have : Fact (Nat.Prime 23) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The second generator has order twenty-three. -/
theorem orderOf_b : orderOf b = 23 :=
  have : Fact (Nat.Prime 23) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

end Co2

/-- The permutation model `Co2` is nontrivial: it contains `Co2.a`, of order `23`. -/
instance : Nontrivial Co2 :=
  Co2.nontrivial_iff_exists_ne_one.2
    ⟨Co2.a, Co2.a_mem, fun h ↦ by simpa [h] using Co2.orderOf_a⟩

