private theorem tripleWord_spec : ∀ x : Fin 276, triangleParity (0, 1, x) = true →
    word (tripleWord x) 0 = 0 ∧ word (tripleWord x) 1 = 1 ∧ word (tripleWord x) 2 = x := by
  decide +kernel

private theorem mem_orbit_stabilizerChain_two_iff (x : Fin 276) :
    x ∈ orbit (Co3.stabilizerChain basePoint 2) (2 : Fin 276) ↔
      triangleParity (0, 1, x) = true := by
  constructor
  · rintro ⟨g, rfl⟩
    obtain ⟨hg, hfix⟩ := (Subgroup.mem_stabilizerChain_iff _ _).mp g.2
    have h0 : (g : Equiv.Perm (Fin 276)) 0 = 0 := by
      simpa only [basePoint_zero, Equiv.Perm.smul_def] using hfix 0 two_pos
    have h1 : (g : Equiv.Perm (Fin 276)) 1 = 1 := by
      simpa only [basePoint_one, Equiv.Perm.smul_def] using hfix 1 one_lt_two
    have h := orbit_subset_triangleParity (mem_orbit_iff.mpr ⟨⟨g, hg⟩, rfl⟩)
    simpa only [Set.mem_ofPred_eq, Subgroup.mk_smul, Prod.smul_mk, Equiv.Perm.smul_def, h0, h1,
      Subgroup.smul_def] using h
  · intro hx
    obtain ⟨h0, h1, h2⟩ := tripleWord_spec x hx
    have hmem : word (tripleWord x) ∈ Co3.stabilizerChain basePoint 2 := by
      refine (Subgroup.mem_stabilizerChain_iff _ _).mpr ⟨word_mem _, fun j hj ↦ ?_⟩
      interval_cases j
      · simpa only [basePoint_zero, Equiv.Perm.smul_def] using h0
      · simpa only [basePoint_one, Equiv.Perm.smul_def] using h1
    refine mem_orbit_iff.mpr ⟨⟨_, hmem⟩, ?_⟩
    simpa only [Subgroup.mk_smul, Equiv.Perm.smul_def] using h2

/-- The third basic orbit: the pointwise stabilizer of `0, 1` moves `2` to 162 of the 274 other
points. -/
theorem orbit_stabilizerChain_two :
    orbit (Co3.stabilizerChain basePoint 2) (2 : Fin 276) =
      (({2, 5, 8, 10, 12, 17, 19, 21, 26, 27, 28, 29, 31, 32, 33, 35, 36, 40, 41, 43, 46, 47, 48,
        51, 54, 56, 58, 59, 60, 61, 62, 63, 65, 66, 68, 69, 72, 73, 75, 76, 77, 78, 79, 80, 83, 84,
        85, 87, 88, 89, 91, 94, 95, 97, 98, 101, 102, 103, 104, 105, 111, 112, 114, 116, 118, 119,
        124, 125, 126, 127, 128, 129, 131, 133, 134, 135, 136, 139, 140, 141, 142, 144, 145, 146,
        147, 150, 151, 154, 155, 156, 158, 162, 163, 164, 165, 168, 171, 172, 174, 175, 176, 177,
        179, 180, 183, 184, 186, 187, 189, 191, 193, 194, 197, 198, 200, 201, 205, 206, 207, 210,
        212, 214, 215, 216, 217, 218, 219, 220, 221, 222, 224, 227, 228, 231, 233, 235, 236, 238,
        241, 242, 243, 245, 246, 247, 248, 249, 250, 251, 252, 253, 258, 259, 261, 262, 263, 265,
        266, 268, 269, 271, 273, 274} : Finset (Fin 276)) : Set (Fin 276)) := by
  ext x
  rw [mem_orbit_stabilizerChain_two_iff, Finset.mem_coe]
  revert x
  decide +kernel

/-- The third basic orbit has length 162. -/
@[simp]
theorem ncard_orbit_stabilizerChain_two :
    (orbit (Co3.stabilizerChain basePoint 2) (2 : Fin 276)).ncard = 162 := by
  rw [orbit_stabilizerChain_two, Set.ncard_coe_finset]
  decide +kernel

/-- The order of the ATLAS model of `Co₃` is `12295800 = 276 * 275 * 162` times the order of its
pointwise stabilizer of `0, 1, 2`. -/
theorem card_eq_12295800_mul_card_stabilizerChain :
    Nat.card Co3 = 12295800 * Nat.card (Co3.stabilizerChain basePoint 3) := by
  have h := Co3.prod_ncard_orbit_mul_card_stabilizerChain basePoint 3
  simp only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul] at h
  rw [basePoint_zero, basePoint_one, basePoint_two, ncard_orbit_stabilizerChain_zero,
    ncard_orbit_stabilizerChain_one, ncard_orbit_stabilizerChain_two] at h
  omega

