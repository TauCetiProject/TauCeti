/- The sets of points, encoded by bits, with respect to which `a` and `b` switch the graph. -/
private def switchA : ℕ :=
  5066307550451929870442301188166000599290770241799423708978748210161268017256706270

private def switchB : ℕ :=
  18278400262083617689057574473834376662942654463476109051084616110188406936597298104

private theorem adj_a : ∀ x y : Fin 276,
    adj (a x) (a y) = (adj x y ^^ switchA.testBit x.val ^^ switchA.testBit y.val) := by
  decide +kernel

private theorem adj_b : ∀ x y : Fin 276,
    adj (b x) (b y) = (adj x y ^^ switchB.testBit x.val ^^ switchB.testBit y.val) := by
  decide +kernel

/-- The parity of the number of edges of the graph among three points. -/
private def triangleParity (p : Fin 276 × Fin 276 × Fin 276) : Bool :=
  adj p.1 p.2.1 ^^ adj p.2.1 p.2.2 ^^ adj p.1 p.2.2

/-- Seidel switching preserves the parity of the number of edges among three points. -/
private theorem triangleParity_smul {g : Equiv.Perm (Fin 276)} {s : ℕ}
    (hg : ∀ x y, adj (g x) (g y) = (adj x y ^^ s.testBit x.val ^^ s.testBit y.val))
    (p : Fin 276 × Fin 276 × Fin 276) : triangleParity (g • p) = triangleParity p := by
  obtain ⟨x, y, z⟩ := p
  simp only [triangleParity, Prod.smul_mk, Equiv.Perm.smul_def, hg]
  -- Each switching bit occurs twice and cancels.
  cases s.testBit x.val <;> cases s.testBit y.val <;> cases s.testBit z.val <;> simp

private theorem orbit_subset_triangleParity :
    orbit Co3 ((0, 1, 2) : Fin 276 × Fin 276 × Fin 276) ⊆ {p | triangleParity p = true} := by
  rw [Co3_def]
  apply orbit_closure_subset_of_finite (Set.toFinite _) (by decide +kernel)
  rintro g (rfl | rfl) p hp
  · simpa only [Set.mem_ofPred_eq, triangleParity_smul adj_a] using hp
  · simpa only [Set.mem_ofPred_eq, triangleParity_smul adj_b] using hp

