/-- The third basic orbit has length 162. -/
@[simp]
theorem ncard_orbit_stabilizerChain_two :
    (orbit (Co3.stabilizerChain basePoint 2) (2 : Fin 276)).ncard = 162 := by
  rw [orbit_stabilizerChain_two, Set.ncard_coe_finset]
  decide +kernel

/-- The order of the ATLAS model of `Co₃` is `12295800 = 276 * 275 * 162` times the order of its
pointwise stabilizer of `0, 1, 2`. -/
theorem card_eq_12295800_mul_card_stabilizerChain :
    Nat.card Co3 = 12295800 * Nat.card (Co3.stabilizerChain basePoint 3) := by
  have h := Co3.prod_ncard_orbit_mul_card_stabilizerChain basePoint 3
  simp only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul] at h
  rw [basePoint_zero, basePoint_one, basePoint_two, ncard_orbit_stabilizerChain_zero,
    ncard_orbit_stabilizerChain_one, ncard_orbit_stabilizerChain_two] at h
  omega

/-! ### Graph automorphisms in the stabilizer of zero -/

private theorem triangleParity_smul_of_mem {g : Equiv.Perm (Fin 276)} (hg : g ∈ Co3) :
    ∀ p : Fin 276 × Fin 276 × Fin 276, triangleParity (g • p) = triangleParity p := by
  rw [Co3_def] at hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with rfl | rfl
    · exact triangleParity_smul adj_a
    · exact triangleParity_smul adj_b
  | one => simp
  | mul _ _ _ _ hx hy =>
    intro p
    rw [mul_smul, hx, hy]
  | inv x _ hx =>
    intro p
    simpa [smul_inv_smul] using (hx (x⁻¹ • p)).symm

private theorem adj_zero_left : ∀ x : Fin 276, adj 0 x = false := by
  decide +kernel

/-- Because `0` is isolated in `adj`, every element of `Co3` fixing `0` preserves `adj`. -/
private theorem adj_apply_of_fix_zero {g : Equiv.Perm (Fin 276)} (hg : g ∈ Co3) (h0 : g 0 = 0)
    (x y : Fin 276) : adj (g x) (g y) = adj x y := by
  have h := triangleParity_smul_of_mem hg (0, x, y)
  simpa only [triangleParity, Prod.smul_mk, Equiv.Perm.smul_def, h0, adj_zero_left,
    Bool.false_xor, Bool.xor_false] using h

private theorem apply_eq_of_mem_stabilizerChain {k : ℕ} {g : Equiv.Perm (Fin 276)}
    (hg : g ∈ Co3.stabilizerChain basePoint k) (x : Fin 276) (hx : x.val < k) :
    g x = x := by
  have h := ((Subgroup.mem_stabilizerChain_iff _ _).mp hg).2 x.val hx
  simpa only [basePoint, Fin.ofNat_eq_cast, Fin.cast_val_eq_self, Equiv.Perm.smul_def] using h

private theorem adj_apply_of_mem_stabilizerChain {k : ℕ} {g : Equiv.Perm (Fin 276)}
    (hg : g ∈ Co3.stabilizerChain basePoint k) (hk : 0 < k) (x y : Fin 276) :
    adj (g x) (g y) = adj x y :=
  adj_apply_of_fix_zero (Co3.stabilizerChain_le basePoint k hg)
    (apply_eq_of_mem_stabilizerChain hg 0 hk) x y

/- Equality as well as adjacency to each anchor is recorded, distinguishing fixed anchors from
other points with the same adjacency pattern. -/
private def profile (l : List (Fin 276)) (x : Fin 276) : List (Bool × Bool) :=
  l.map fun z ↦ (decide (x = z), adj z x)

private theorem profile_apply (g : Equiv.Perm (Fin 276))
    (hg : ∀ x y, adj (g x) (g y) = adj x y) (l : List (Fin 276))
    (hl : ∀ z ∈ l, g z = z) (x : Fin 276) :
    profile l (g x) = profile l x := by
  refine List.map_congr_left fun z hz ↦ ?_
  have hgz : g z = z := hl z hz
  have heq : (g x = z) ↔ x = z :=
    ⟨fun h ↦ g.injective (h.trans hgz.symm), fun h ↦ h ▸ hgz⟩
  exact Prod.ext (Bool.decide_congr heq) (by simpa only [hgz] using hg z x)

private theorem profile_apply_of_mem_stabilizerChain {k : ℕ} {g : Equiv.Perm (Fin 276)}
    (hg : g ∈ Co3.stabilizerChain basePoint k) (l : List (Fin 276))
    (hl : ∀ z ∈ l, z.val < k) (x : Fin 276) :
    profile l (g x) = profile l x := by
  cases l with
  | nil => rfl
  | cons z zs =>
    exact profile_apply g
      (adj_apply_of_mem_stabilizerChain hg (Nat.zero_lt_of_lt (hl z List.mem_cons_self)))
      (z :: zs) (fun w hw ↦ apply_eq_of_mem_stabilizerChain hg w (hl w hw)) x

/-! ### Words in the three-point stabilizer and remaining basic orbits -/

private def letterPerm (u v : Equiv.Perm (Fin 276)) : ℕ → Equiv.Perm (Fin 276)
  | 0 => u
  | 1 => u⁻¹
  | 2 => v
  | _ => v⁻¹

private def evalWord (u v : Equiv.Perm (Fin 276)) (w : List ℕ) : Equiv.Perm (Fin 276) :=
  (w.map (letterPerm u v)).prod

private theorem evalWord_mem {H : Subgroup (Equiv.Perm (Fin 276))}
    {u v : Equiv.Perm (Fin 276)} (hu : u ∈ H) (hv : v ∈ H) (w : List ℕ) :
    evalWord u v w ∈ H := by
  apply Subgroup.list_prod_mem
  intro g hg
  obtain ⟨t, _, rfl⟩ := List.mem_map.mp hg
  match t with
  | 0 => exact hu
  | 1 => exact inv_mem hu
  | 2 => exact hv
  | _ + 3 => exact inv_mem hv

