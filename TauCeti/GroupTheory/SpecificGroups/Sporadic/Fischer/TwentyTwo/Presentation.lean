/-! ### Orders -/

/-- The first image is an involution. -/
theorem orderOf_imageA : orderOf imageA = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The second image has order thirteen. -/
theorem orderOf_imageB : orderOf imageB = 13 :=
  have : Fact (Nat.Prime 13) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The product of the two images has order eleven. -/
theorem orderOf_imageA_mul_imageB : orderOf (imageA * imageB) = 11 :=
  have : Fact (Nat.Prime 11) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### The images and the generators of the model as words in each other -/

/-- The first image as a word of 29 letters in the generators of the model. -/
theorem imageA_eq :
    imageA = a⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * b⁻¹ * b⁻¹ * a⁻¹ * b * b * a⁻¹ * b * a * b * b * a * b *
      a⁻¹ * a⁻¹ * a⁻¹ * a⁻¹ * b⁻¹ * a * a * a * a * a * b⁻¹ * a := by
  decide +kernel

/-- The second image as a word of 28 letters in the generators of the model. -/
theorem imageB_eq :
    imageB = b * a⁻¹ * b * a⁻¹ * b⁻¹ * a * b * a * b⁻¹ * a * a * b⁻¹ * b⁻¹ * a * b * a * b * a⁻¹ *
      b⁻¹ * a⁻¹ * b * a⁻¹ * b * a⁻¹ * b * a * b * a⁻¹ := by
  decide +kernel

/-- The first generator of the model as a word of 46 letters in the two images. -/
theorem a_eq :
    a = imageA * imageB * imageA * imageB⁻¹ * imageA * imageB⁻¹ * imageA * imageB⁻¹ * imageA *
      imageB⁻¹ * imageB⁻¹ * imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ * imageA * imageB * imageA *
      imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ * imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ * imageA *
      imageB * imageA * imageB⁻¹ * imageB⁻¹ * imageA * imageB * imageB * imageA * imageB * imageA *
      imageB * imageB * imageB * imageA * imageB * imageA * imageB⁻¹ * imageB⁻¹ * imageA := by
  decide +kernel

/-- The second generator of the model as a word of 48 letters in the two images. -/
theorem b_eq :
    b = imageB * imageB * imageA * imageB⁻¹ * imageA * imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ *
      imageB⁻¹ * imageB⁻¹ * imageB⁻¹ * imageA * imageB⁻¹ * imageA * imageB * imageB * imageB *
      imageB * imageB * imageA * imageB⁻¹ * imageA * imageB * imageB * imageB * imageA * imageB⁻¹ *
      imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ * imageB⁻¹ * imageA * imageB⁻¹ * imageB⁻¹ * imageA *
      imageB * imageA * imageB⁻¹ * imageB⁻¹ * imageB⁻¹ * imageB⁻¹ * imageA * imageB⁻¹ * imageA *
      imageB⁻¹ * imageA := by
  decide +kernel

/-! ### The assignment and the relators -/

/-- The images in the permutation model of the generators of the presentation of `Fi₂₂`: `imageA`
for the generator of index `0` and `imageB` for the generator of index `1`. -/
def presentationImage (i : Fin SporadicName.Fi22.presentation.generatorCount) :
    Equiv.Perm (Fin 3510) :=
  if (i : ℕ) = 0 then imageA else imageB

/-- The assignment unfolded: `imageA` at index `0` and `imageB` otherwise. -/
theorem presentationImage_def (i : Fin SporadicName.Fi22.presentation.generatorCount) :
    presentationImage i = if (i : ℕ) = 0 then imageA else imageB :=
  (rfl)

/-- The generator of index `0` goes to `imageA`. -/
@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.Fi22.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageA := by
  simp [presentationImage]

/-- The generator of index `1` goes to `imageB`. -/
@[simp]
theorem presentationImage_one (h : 1 < SporadicName.Fi22.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageB := by
  simp [presentationImage]

/-- The assignment has precisely the two chosen images as its values. -/
theorem range_presentationImage : Set.range presentationImage = {imageA, imageB} := by
  have h : SporadicName.Fi22.presentation.generatorCount = 2 := by simp
  exact Set.range_ite_const ⟨⟨0, by omega⟩, rfl⟩ ⟨⟨1, by omega⟩, one_ne_zero⟩

/-- **The relators of `Fi₂₂` hold in the model.** All thirteen transcribed relators of the
presentation of `Fi₂₂` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.Fi22.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.Fi22.presentation`, so the statement
  -- is first abstracted over the presentation and then specialized along `presentation_Fi22`.
  suffices key : ∀ P : GroupPresentation, P = fi22Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then imageA else imageB)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_Fi22
  rintro P rfl
  simp only [fi22Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  decide +kernel

/-! ### Generation and the surjection -/

/-- **The images generate the model.** The subgroup generated by the images `imageA` and `imageB`
of the presentation generators is the permutation model `Fi22`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = Fi22 := by
  rw [range_presentationImage, Fi22_def]
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    have ha : a ∈ Subgroup.closure {a, b} := Subgroup.subset_closure (by simp)
    have hb : b ∈ Subgroup.closure {a, b} := Subgroup.subset_closure (by simp)
    -- Each image is a word in `a` and `b`; a word is peeled from the right.
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, imageA_eq, imageB_eq, mul_mem_cancel_right ha,
        mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem ha),
        mul_mem_cancel_right (inv_mem hb), inv_mem_iff, ha, hb]
  · refine (Subgroup.closure_le _).mpr ?_
    have hA : imageA ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    have hB : imageB ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    -- Each generator of the model is a word in the two images.
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, a_eq, b_eq, mul_mem_cancel_right hA, mul_mem_cancel_right hB,
        mul_mem_cancel_right (inv_mem hB), hA, hB]

/-- The homomorphism from the group presented by the presentation of `Fi₂₂` to
`Equiv.Perm (Fin 3510)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.Fi22.Group →* Equiv.Perm (Fin 3510) :=
  SporadicName.Fi22.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

/-- The homomorphism unfolded: the extension of `presentationImage` given by
`GroupPresentation.homEquiv`. -/
theorem presentationHom_def :
    presentationHom = SporadicName.Fi22.presentation.homEquiv.symm
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

/-- The homomorphism sends each generator of the presented group to its chosen image. -/
@[simp]
theorem presentationHom_of (i : Fin SporadicName.Fi22.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `Fi22`. -/
theorem range_presentationHom : presentationHom.range = Fi22 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end Fi22

/-- **The presented group of `Fi₂₂` maps onto the permutation model.** The group defined by the
presentation of `Fi₂₂` carried by `TauCeti.SporadicName.presentation` has a surjective
homomorphism onto `Fi22`. -/
theorem exists_surjective_Fi22 :
    ∃ f : SporadicName.Fi22.Group →* Fi22, Function.Surjective f :=
  SporadicName.Fi22.presentation.exists_surjective_of_closure_range_eq
    ⟨Fi22.presentationImage, Fi22.lift_presentationImage_toFreeGroup_eq_one⟩
    Fi22.closure_range_presentationImage

/-- The group presented by the presentation of `Fi₂₂` is nontrivial, since it maps onto the
nontrivial permutation model `Fi22`. -/
instance : Nontrivial SporadicName.Fi22.Group :=
  exists_surjective_Fi22.choose_spec.nontrivial

end TauCeti.Sporadic
