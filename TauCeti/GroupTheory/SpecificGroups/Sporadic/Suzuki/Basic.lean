/-- The permutation model of the Suzuki sporadic group `Suz`: the subgroup of
`Equiv.Perm (Fin 1782)` generated by `Suz.a`, `Suz.b`, `Suz.c`, `Suz.d`, `Suz.e` and `Suz.f`. -/
def Suz : Subgroup (Equiv.Perm (Fin 1782)) :=
  Subgroup.closure {Suz.a, Suz.b, Suz.c, Suz.d, Suz.e, Suz.f}

/-- The model is generated by the six permutations `Suz.a`, …, `Suz.f`. -/
theorem Suz_def : Suz = Subgroup.closure {Suz.a, Suz.b, Suz.c, Suz.d, Suz.e, Suz.f} := (rfl)

namespace Suz

/-- The first generator lies in the model. -/
theorem a_mem : a ∈ Suz := Suz_def ▸ Subgroup.subset_closure (by simp)

/-- The second generator lies in the model. -/
theorem b_mem : b ∈ Suz := Suz_def ▸ Subgroup.subset_closure (by simp)

/-- The third generator lies in the model. -/
theorem c_mem : c ∈ Suz := Suz_def ▸ Subgroup.subset_closure (by simp)

/-- The fourth generator lies in the model. -/
theorem d_mem : d ∈ Suz := Suz_def ▸ Subgroup.subset_closure (by simp)

/-- The fifth generator lies in the model. -/
theorem e_mem : e ∈ Suz := Suz_def ▸ Subgroup.subset_closure (by simp)

/-- The sixth generator lies in the model. -/
theorem f_mem : f ∈ Suz := Suz_def ▸ Subgroup.subset_closure (by simp)

/-! ### Generator orders -/

/-- The first generator has order three. -/
theorem orderOf_a : orderOf a = 3 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The second generator has order three. -/
theorem orderOf_b : orderOf b = 3 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The third generator has order three. -/
theorem orderOf_c : orderOf c = 3 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The fourth generator has order ten. -/
theorem orderOf_d : orderOf d = 10 := by
  apply orderOf_eq_of_pow_and_pow_div_prime (by decide +kernel)
  intro p hp hdiv
  have h : p = 2 ∨ p = 5 := by
    have hpd : p ∣ 2 ∨ p ∣ 5 := hp.dvd_mul.mp hdiv
    rcases hpd with hpd | hpd
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp hpd)
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp hpd)
  rcases h with rfl | rfl <;> decide +kernel

/-- The fifth generator has order three. -/
theorem orderOf_e : orderOf e = 3 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The sixth generator has order three. -/
theorem orderOf_f : orderOf f = 3 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

end Suz

/-- The permutation model `Suz` is nontrivial: it contains `Suz.a`, of order `3`. -/
instance : Nontrivial Suz :=
  Suz.nontrivial_iff_exists_ne_one.2
    ⟨Suz.a, Suz.a_mem, fun h ↦ by simpa [h] using Suz.orderOf_a⟩

end TauCeti.Sporadic
