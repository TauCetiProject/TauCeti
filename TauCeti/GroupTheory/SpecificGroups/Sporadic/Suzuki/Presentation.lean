/-! ### The images and the generators of the model as words in each other -/

/-- The image of the generator `a` as a word of 10 letters in the generators of the model. -/
theorem imageA_eq :
    imageA = c⁻¹ * a * c * d⁻¹ * e⁻¹ * c * b⁻¹ * d * a⁻¹ * e := by
  decide +kernel

/-- The image of the generator `b` as a word of 9 letters in the generators of the model. -/
theorem imageB_eq :
    imageB = f⁻¹ * c * d * a⁻¹ * c⁻¹ * d * a⁻¹ * c * f := by
  decide +kernel

/-- The image of the generator `c` as a word of 10 letters in the generators of the model. -/
theorem imageC_eq :
    imageC = c⁻¹ * d⁻¹ * c⁻¹ * a * c⁻¹ * d * d * e⁻¹ * a * c := by
  decide +kernel

/-- The image of the generator `d` as a word of 10 letters in the generators of the model. -/
theorem imageD_eq :
    imageD = a * b * e⁻¹ * d⁻¹ * e⁻¹ * d⁻¹ * b⁻¹ * e⁻¹ * d⁻¹ * a⁻¹ := by
  decide +kernel

/-- The image of the generator `e` as a word of 11 letters in the generators of the model. -/
theorem imageE_eq :
    imageE = d * c⁻¹ * d⁻¹ * b * d * e * d * a⁻¹ * d * d * c⁻¹ := by
  decide +kernel

/-- The image of the generator `f` as a word of 10 letters in the generators of the model. -/
theorem imageF_eq :
    imageF = e⁻¹ * d⁻¹ * d⁻¹ * b * c⁻¹ * b * e * d * a⁻¹ * c⁻¹ := by
  decide +kernel

/-- The image of the generator `g` as a word of 11 letters in the generators of the model. -/
theorem imageG_eq :
    imageG = c * f⁻¹ * a⁻¹ * b * c⁻¹ * a * b * c⁻¹ * a⁻¹ * f * c⁻¹ := by
  decide +kernel

/-- The first generator of the model as a word of 26 letters in the seven images. -/
theorem a_eq :
    a = imageC * imageD * imageB * imageC * imageA * imageB * imageA * imageC * imageD * imageF *
      imageB * imageC * imageD * imageC * imageB * imageA * imageE * imageD * imageC * imageF *
      imageB * imageA * imageC * imageB * imageD * imageC := by
  decide +kernel

/-- The second generator of the model as a word of 30 letters in the seven images. -/
theorem b_eq :
    b = imageD * imageB * imageC * imageD * imageE * imageD * imageB * imageC * imageD * imageC *
      imageB * imageC * imageD * imageC * imageF * imageB * imageA * imageC * imageD * imageC *
      imageB * imageE * imageD * imageC * imageD * imageC * imageB * imageA * imageB * imageF := by
  decide +kernel

/-- The third generator of the model as a word of 12 letters in the seven images. -/
theorem c_eq :
    c = imageA * imageB * imageA * imageB * imageC * imageE * imageD * imageC * imageB * imageA *
      imageB * imageA := by
  decide +kernel

/-- The fourth generator of the model as a word of 26 letters in the seven images. -/
theorem d_eq :
    d = imageC * imageB * imageF * imageD * imageC * imageD * imageC * imageB * imageE * imageD *
      imageC * imageB * imageA * imageD * imageC * imageB * imageE * imageD * imageF * imageB *
      imageC * imageD * imageC * imageB * imageE * imageF := by
  decide +kernel

/-- The fifth generator of the model as a word of 29 letters in the seven images. -/
theorem e_eq :
    e = imageC * imageD * imageC * imageD * imageE * imageD * imageB * imageC * imageD * imageA *
      imageB * imageA * imageC * imageB * imageE * imageD * imageC * imageF * imageB * imageA *
      imageC * imageB * imageD * imageC * imageB * imageE * imageD * imageC * imageD := by
  decide +kernel

/-- The sixth generator of the model as a word of 33 letters in the seven images. -/
theorem f_eq :
    f = imageB * imageF * imageB * imageA * imageB * imageC * imageD * imageC * imageB * imageF *
      imageD * imageA * imageB * imageA * imageC * imageB * imageE * imageD * imageC * imageB *
      imageD * imageC * imageE * imageD * imageC * imageB * imageF * imageG * imageB * imageA *
      imageC * imageB * imageG := by
  decide +kernel

/-! ### The assignment and the relators -/

/-- The images in the permutation model of the generators of the presentation of `Suz`: the
generators of index `0`, …, `6` go to `imageA`, …, `imageG`. -/
def presentationImage (i : Fin SporadicName.Suz.presentation.generatorCount) :
    Equiv.Perm (Fin 1782) :=
  [imageA, imageB, imageC, imageD, imageE, imageF, imageG].getD i 1

/-- The explicit assignment underlying `presentationImage`. -/
theorem presentationImage_def (i : Fin SporadicName.Suz.presentation.generatorCount) :
    presentationImage i = [imageA, imageB, imageC, imageD, imageE, imageF, imageG].getD i 1 :=
  (rfl)

/-- The generator of index `0` goes to `imageA`. -/
@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.Suz.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageA :=
  (rfl)

/-- The generator of index `1` goes to `imageB`. -/
@[simp]
theorem presentationImage_one (h : 1 < SporadicName.Suz.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageB :=
  (rfl)

/-- The generator of index `2` goes to `imageC`. -/
@[simp]
theorem presentationImage_two (h : 2 < SporadicName.Suz.presentation.generatorCount) :
    presentationImage ⟨2, h⟩ = imageC :=
  (rfl)

/-- The generator of index `3` goes to `imageD`. -/
@[simp]
theorem presentationImage_three (h : 3 < SporadicName.Suz.presentation.generatorCount) :
    presentationImage ⟨3, h⟩ = imageD :=
  (rfl)

/-- The generator of index `4` goes to `imageE`. -/
@[simp]
theorem presentationImage_four (h : 4 < SporadicName.Suz.presentation.generatorCount) :
    presentationImage ⟨4, h⟩ = imageE :=
  (rfl)

/-- The generator of index `5` goes to `imageF`. -/
@[simp]
theorem presentationImage_five (h : 5 < SporadicName.Suz.presentation.generatorCount) :
    presentationImage ⟨5, h⟩ = imageF :=
  (rfl)

/-- The generator of index `6` goes to `imageG`. -/
@[simp]
theorem presentationImage_six (h : 6 < SporadicName.Suz.presentation.generatorCount) :
    presentationImage ⟨6, h⟩ = imageG :=
  (rfl)

/-- The assignment has precisely the seven chosen images as its values. -/
theorem range_presentationImage :
    Set.range presentationImage =
      {imageA, imageB, imageC, imageD, imageE, imageF, imageG} := by
  have h : SporadicName.Suz.presentation.generatorCount = 7 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨⟨k, hk⟩, rfl⟩
    have hk' : k < 7 := h ▸ hk
    interval_cases k <;> simp
  · rintro (rfl | rfl | rfl | rfl | rfl | rfl | rfl)
    exacts [⟨⟨0, by omega⟩, rfl⟩, ⟨⟨1, by omega⟩, rfl⟩, ⟨⟨2, by omega⟩, rfl⟩,
      ⟨⟨3, by omega⟩, rfl⟩, ⟨⟨4, by omega⟩, rfl⟩, ⟨⟨5, by omega⟩, rfl⟩, ⟨⟨6, by omega⟩, rfl⟩]

/- The relators in five closed blocks, each small enough for instance synthesis to assemble its
decision procedure and for the kernel to evaluate it: the seven generators are involutions, the
seven labelled edges of the two Coxeter paths, the fourteen commuting pairs (those beginning with
`a` or `b`, then those beginning with `c`, `d` or `e`), and the six further relations. -/
private theorem relators_sq :
    imageA ^ 2 = 1 ∧ imageB ^ 2 = 1 ∧ imageC ^ 2 = 1 ∧ imageD ^ 2 = 1 ∧ imageE ^ 2 = 1 ∧
      imageF ^ 2 = 1 ∧ imageG ^ 2 = 1 := by
  decide +kernel

private theorem relators_edge :
    (imageA * imageB) ^ 5 = 1 ∧ (imageB * imageC) ^ 3 = 1 ∧ (imageC * imageD) ^ 8 = 1 ∧
      (imageD * imageE) ^ 3 = 1 ∧ (imageB * imageF) ^ 3 = 1 ∧ (imageF * imageG) ^ 4 = 1 ∧
      (imageG * imageB) ^ 3 = 1 := by
  decide +kernel

private theorem relators_commute_ab :
    (imageA * imageC) ^ 2 = 1 ∧ (imageA * imageD) ^ 2 = 1 ∧ (imageA * imageE) ^ 2 = 1 ∧
      (imageA * imageF) ^ 2 = 1 ∧ (imageA * imageG) ^ 2 = 1 ∧ (imageB * imageD) ^ 2 = 1 ∧
      (imageB * imageE) ^ 2 = 1 := by
  decide +kernel

private theorem relators_commute_cde :
    (imageC * imageE) ^ 2 = 1 ∧ (imageC * imageF) ^ 2 = 1 ∧ (imageC * imageG) ^ 2 = 1 ∧
      (imageD * imageF) ^ 2 = 1 ∧ (imageD * imageG) ^ 2 = 1 ∧ (imageE * imageF) ^ 2 = 1 ∧
      (imageE * imageG) ^ 2 = 1 := by
  decide +kernel

private theorem relators_mixed :
    imageA⁻¹ * (imageC * imageD) ^ 4 = 1 ∧ imageA⁻¹ * (imageF * imageG) ^ 2 = 1 ∧
      (imageA * imageB * imageC * imageF) ^ 5 = 1 ∧ (imageB * imageF * imageG) ^ 5 = 1 ∧
      ((imageB * imageC * imageD * imageC * imageD) ^ 5 * imageE) ^ 3 = 1 ∧
      (imageA * imageB * imageC * imageG) ^ 5 = 1 := by
  decide +kernel

/-- **The relators of `Suz` hold in the model.** All thirty-four transcribed relators of the
presentation of `Suz` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.Suz.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.Suz.presentation`, so the statement
  -- is first abstracted over the presentation and then specialized along `presentation_Suz`.
  suffices key : ∀ P : GroupPresentation, P = suzPresentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦
        [imageA, imageB, imageC, imageD, imageE, imageF, imageG].getD i 1) t.toFreeGroup = 1 from
    key _ SporadicName.presentation_Suz
  rintro P rfl
  obtain ⟨hA, hB, hC, hD, hE, hF, hG⟩ := relators_sq
  obtain ⟨hAB, hBC, hCD, hDE, hBF, hFG, hGB⟩ := relators_edge
  obtain ⟨hAC, hAD, hAE, hAF, hAG, hBD, hBE⟩ := relators_commute_ab
  obtain ⟨hCE, hCF, hCG, hDF, hDG, hEF, hEG⟩ := relators_commute_cde
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := relators_mixed
  simp only [suzPresentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_gen, List.getD_cons_succ, List.getD_cons_zero]
  exact ⟨hA, hB, hC, hD, hE, hF, hG, hAB, hBC, hCD, hDE, hBF, hFG, hGB, hAC, hAD, hAE, hAF, hAG,
    hBD, hBE, hCE, hCF, hCG, hDF, hDG, hEF, hEG, h1, h2, h3, h4, h5, h6⟩

/-! ### Generation and the surjection -/

/-- **The images generate the model.** The subgroup generated by the seven images of the
presentation generators is the permutation model `Suz`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = Suz := by
  rw [range_presentationImage, Suz_def]
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    have h : ∀ σ ∈ ({a, b, c, d, e, f} : Set (Equiv.Perm (Fin 1782))),
        σ ∈ Subgroup.closure ({a, b, c, d, e, f} : Set (Equiv.Perm (Fin 1782))) :=
      fun _ hσ ↦ Subgroup.subset_closure hσ
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, forall_eq_or_imp, forall_eq] at h
    obtain ⟨ha, hb, hc, hd, he, hf⟩ := h
    -- Each image is a word in the six generators; a word is peeled from the right.
    rintro σ (rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
    · simp only [SetLike.mem_coe, imageA_eq, imageB_eq, imageC_eq, imageD_eq, imageE_eq, imageF_eq,
        imageG_eq, mul_mem_cancel_right ha, mul_mem_cancel_right hb, mul_mem_cancel_right hc,
        mul_mem_cancel_right hd, mul_mem_cancel_right he, mul_mem_cancel_right hf,
        mul_mem_cancel_right (inv_mem ha), mul_mem_cancel_right (inv_mem hb),
        mul_mem_cancel_right (inv_mem hc), mul_mem_cancel_right (inv_mem hd),
        mul_mem_cancel_right (inv_mem he), mul_mem_cancel_right (inv_mem hf), inv_mem_iff, ha, hc,
        hd, he, hf]
  · refine (Subgroup.closure_le _).mpr ?_
    have h : ∀ σ ∈ ({imageA, imageB, imageC, imageD, imageE, imageF, imageG} :
        Set (Equiv.Perm (Fin 1782))), σ ∈ Subgroup.closure
          ({imageA, imageB, imageC, imageD, imageE, imageF, imageG} :
            Set (Equiv.Perm (Fin 1782))) :=
      fun _ hσ ↦ Subgroup.subset_closure hσ
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, forall_eq_or_imp, forall_eq] at h
    obtain ⟨hA, hB, hC, hD, hE, hF, hG⟩ := h
    -- Each generator of the model is a word in the seven images.
    rintro σ (rfl | rfl | rfl | rfl | rfl | rfl) <;>
    · simp only [SetLike.mem_coe, a_eq, b_eq, c_eq, d_eq, e_eq, f_eq, mul_mem_cancel_right hA,
        mul_mem_cancel_right hB, mul_mem_cancel_right hC, mul_mem_cancel_right hD,
        mul_mem_cancel_right hE, mul_mem_cancel_right hF, mul_mem_cancel_right hG, hA, hB, hC, hD]

/-- The homomorphism from the group presented by the presentation of `Suz` to
`Equiv.Perm (Fin 1782)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.Suz.Group →* Equiv.Perm (Fin 1782) :=
  SporadicName.Suz.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

/-- The homomorphism unfolded: the extension of `presentationImage` given by
`GroupPresentation.homEquiv`. -/
theorem presentationHom_def :
    presentationHom = SporadicName.Suz.presentation.homEquiv.symm
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

/-- The homomorphism sends each generator of the presented group to its chosen image. -/
@[simp]
theorem presentationHom_of (i : Fin SporadicName.Suz.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `Suz`. -/
theorem range_presentationHom : presentationHom.range = Suz :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end Suz

/-- **The presented group of `Suz` maps onto the permutation model.** The group defined by the
presentation of `Suz` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `Suz`. -/
theorem exists_surjective_Suz :
    ∃ f : SporadicName.Suz.Group →* Suz, Function.Surjective f :=
  SporadicName.Suz.presentation.exists_surjective_of_closure_range_eq
    ⟨Suz.presentationImage, Suz.lift_presentationImage_toFreeGroup_eq_one⟩
    Suz.closure_range_presentationImage

/-- The group presented by the presentation of `Suz` is nontrivial, since it maps onto the
nontrivial permutation model `Suz`. -/
instance : Nontrivial SporadicName.Suz.Group :=
  exists_surjective_Suz.choose_spec.nontrivial

end TauCeti.Sporadic
