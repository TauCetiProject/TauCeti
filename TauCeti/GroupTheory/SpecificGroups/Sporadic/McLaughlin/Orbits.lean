private theorem stabilizerWords_apply : ∀ x : Fin 275, related 0 x = true →
    wordValue (stabilizerWords x) 0 = 0 ∧ wordValue (stabilizerWords x) 1 = x := by
  decide +kernel

private theorem mem_orbit_stabilizer_iff (x : Fin 275) :
    x ∈ orbit ↥(McL ⊓ stabilizer (Equiv.Perm (Fin 275)) (0 : Fin 275)) (1 : Fin 275) ↔
      related 0 x = true := by
  constructor
  · rintro ⟨g, rfl⟩
    have h := related_apply g.property.1 0 1
    have hg0 : (g : Equiv.Perm (Fin 275)) 0 = 0 := g.property.2
    rw [hg0] at h
    exact h.trans (by decide +kernel)
  · intro hx
    obtain ⟨h0, h1⟩ := stabilizerWords_apply x hx
    exact ⟨⟨wordValue (stabilizerWords x), wordValue_mem _, h0⟩, h1⟩

