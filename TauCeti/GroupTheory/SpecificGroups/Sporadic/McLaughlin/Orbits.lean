    orbit ↥(McL ⊓ stabilizer (Equiv.Perm (Fin 275)) (0 : Fin 275)) (1 : Fin 275) =
  (({1, 2, 4, 5, 6, 7, 10, 11, 16, 17, 23, 24, 31, 33, 36, 37, 38, 40, 41, 45, 49, 51, 54,
