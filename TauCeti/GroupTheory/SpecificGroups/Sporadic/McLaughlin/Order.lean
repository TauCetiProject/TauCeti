private def letterN (l x : ℕ) : ℕ :=
  letterTable >>> (9 * (275 * l + x)) % 2 ^ 9

/- The three letters of the words below. -/
private def letter (l : ℕ) : Equiv.Perm (Fin 275) :=
  if l = 0 then a else if l = 1 then b else b⁻¹

private def invLetter (l : ℕ) : ℕ :=
  (3 - l) % 3

private theorem letter_mem (l : ℕ) : letter l ∈ McL := by
  unfold letter
  split_ifs
  · exact a_mem
  · exact b_mem
  · exact McL.inv_mem b_mem

private theorem letterN_zero : ∀ x : Fin 275, letterN 0 x.val = (a x).val := by
  decide +kernel

private theorem letterN_one : ∀ x : Fin 275, letterN 1 x.val = (b x).val := by
  decide +kernel

private theorem letterN_two : ∀ x : Fin 275, letterN 2 x.val = (b⁻¹ x).val := by
  decide +kernel

private theorem letterN_invLetter : (List.range 3).all (fun l ↦ (List.range 275).all fun x ↦
    letterN (invLetter l) (letterN l x) == x) = true := by
  decide +kernel

private theorem letter_apply {l : ℕ} (hl : l < 3) (x : Fin 275) :
    (letter l x).val = letterN l x.val := by
  interval_cases l
  · simp [letter, letterN_zero]
  · simp [letter, letterN_one]
  · simp [letter, letterN_two]

private theorem invLetter_lt (l : ℕ) : invLetter l < 3 :=
  Nat.mod_lt _ (by norm_num)

private theorem letter_mul_letter_invLetter {l : ℕ} (hl : l < 3) :
    letter (invLetter l) * letter l = 1 := by
  ext x
  have h := List.all_eq_true.mp (List.all_eq_true.mp letterN_invLetter l
    (List.mem_range.mpr hl)) x.val (List.mem_range.mpr x.isLt)
  rw [beq_iff_eq] at h
  rw [Equiv.Perm.mul_apply, letter_apply (invLetter_lt l), letter_apply hl, h, Equiv.Perm.one_apply]

private theorem letter_inv {l : ℕ} (hl : l < 3) : (letter l)⁻¹ = letter (invLetter l) :=
  (eq_inv_of_mul_eq_one_left (letter_mul_letter_invLetter hl)).symm

/- A word `w` lists letters in base `3`, least significant digit first, followed by a terminal
digit `1`; the first letter is the leftmost factor. The first argument is recursion fuel, enough
for words below `3 ^ 31`. -/
private def wordN : ℕ → ℕ → ℕ → ℕ
  | 0, _, x => x
  | n + 1, w, x => if w ≤ 1 then x else letterN (w % 3) (wordN n (w / 3) x)

private def wordInvN : ℕ → ℕ → ℕ → ℕ
  | 0, _, x => x
  | n + 1, w, x => if w ≤ 1 then x else wordInvN n (w / 3) (letterN (invLetter (w % 3)) x)

private def wordPerm : ℕ → ℕ → Equiv.Perm (Fin 275)
  | 0, _ => 1
  | n + 1, w => if w ≤ 1 then 1 else letter (w % 3) * wordPerm n (w / 3)

private theorem wordPerm_mem : ∀ n w, wordPerm n w ∈ McL
  | 0, _ => McL.one_mem
  | n + 1, w => by
    rw [wordPerm]
    split_ifs
    · exact McL.one_mem
    · exact McL.mul_mem (letter_mem _) (wordPerm_mem n _)

private theorem wordPerm_apply : ∀ n w (x : Fin 275), (wordPerm n w x).val = wordN n w x.val
  | 0, _, _ => rfl
  | n + 1, w, x => by
    rw [wordPerm, wordN]
    split_ifs
    · rfl
    · rw [Equiv.Perm.mul_apply, letter_apply (Nat.mod_lt _ (by norm_num)), wordPerm_apply n]

private theorem wordPerm_inv_apply :
    ∀ n w (x : Fin 275), ((wordPerm n w)⁻¹ x).val = wordInvN n w x.val
  | 0, _, _ => rfl
  | n + 1, w, x => by
    rw [wordPerm, wordInvN]
    split_ifs
    · rfl
    · rw [mul_inv_rev, Equiv.Perm.mul_apply, wordPerm_inv_apply n,
        letter_inv (Nat.mod_lt _ (by norm_num)), letter_apply (invLetter_lt _)]

/- Extra fuel does not change the value of a word. -/
private theorem wordPerm_succ_of_lt : ∀ n w, w < 3 ^ n → wordPerm (n + 1) w = wordPerm n w
  | 0, w, hw => by
    obtain rfl : w = 0 := by simpa using hw
    rfl
  | n + 1, w, hw => by
    conv_lhs => rw [wordPerm.eq_2]
    conv_rhs => rw [wordPerm.eq_2]
    rw [wordPerm_succ_of_lt n (w / 3) (by rw [pow_succ] at hw; omega)]

private theorem wordPerm_three_mul_add {w l : ℕ} (hw : 1 ≤ w) (hw' : w < 3 ^ 31) (hl : l < 3) :
    wordPerm 32 (3 * w + l) = letter l * wordPerm 32 w := by
  rw [wordPerm.eq_2]
  split_ifs with h
  · omega
  · rw [show (3 * w + l) % 3 = l by omega, show (3 * w + l) / 3 = w by omega,
      wordPerm_succ_of_lt 31 w hw']

