private def action (s i : ℕ) : ℕ :=
  actionTable >>> (11 * (2025 * s + i)) % 2 ^ 11

/- The `i`-th coclique is carried by the letter `s` to the coclique `action s i`. Along an edge
of the search tree this holds by construction, as one word extends the other by the letter `s` or
its inverse; otherwise it is checked pointwise. -/
private def stepCheck (s i : ℕ) : Bool :=
  action s i < 2025 && 1 ≤ cocliqueWord i && 1 ≤ cocliqueWord (action s i) &&
    (cocliqueWord (action s i) == 3 * cocliqueWord i + s ||
      cocliqueWord i == 3 * cocliqueWord (action s i) + invLetter s ||
      seedList.all fun x ↦ seedMask.testBit
        (wordInvN 32 (cocliqueWord (action s i)) (letterN s (wordN 32 (cocliqueWord i) x.val))))

-- The check runs in chunks of `225` cocliques to stay within the default resource budget.
private def stepChunk (s k : ℕ) : Bool :=
  (List.range 225).all fun j ↦ stepCheck s (225 * k + j)

private theorem stepChunk_a_zero : stepChunk 0 0 = true := by decide +kernel
private theorem stepChunk_a_one : stepChunk 0 1 = true := by decide +kernel
private theorem stepChunk_a_two : stepChunk 0 2 = true := by decide +kernel
private theorem stepChunk_a_three : stepChunk 0 3 = true := by decide +kernel
private theorem stepChunk_a_four : stepChunk 0 4 = true := by decide +kernel
private theorem stepChunk_a_five : stepChunk 0 5 = true := by decide +kernel
private theorem stepChunk_a_six : stepChunk 0 6 = true := by decide +kernel
private theorem stepChunk_a_seven : stepChunk 0 7 = true := by decide +kernel
private theorem stepChunk_a_eight : stepChunk 0 8 = true := by decide +kernel
private theorem stepChunk_b_zero : stepChunk 1 0 = true := by decide +kernel
private theorem stepChunk_b_one : stepChunk 1 1 = true := by decide +kernel
private theorem stepChunk_b_two : stepChunk 1 2 = true := by decide +kernel
private theorem stepChunk_b_three : stepChunk 1 3 = true := by decide +kernel
private theorem stepChunk_b_four : stepChunk 1 4 = true := by decide +kernel
private theorem stepChunk_b_five : stepChunk 1 5 = true := by decide +kernel
private theorem stepChunk_b_six : stepChunk 1 6 = true := by decide +kernel
private theorem stepChunk_b_seven : stepChunk 1 7 = true := by decide +kernel
private theorem stepChunk_b_eight : stepChunk 1 8 = true := by decide +kernel

private theorem stepCheck_eq_true {s : ℕ} (hs : s < 2) {i : ℕ} (hi : i < 2025) :
    stepCheck s i = true := by
  have h : ∀ k < 9, stepChunk s k = true := by
    intro k hk
    interval_cases s <;> interval_cases k
    exacts [stepChunk_a_zero, stepChunk_a_one, stepChunk_a_two, stepChunk_a_three,
      stepChunk_a_four, stepChunk_a_five, stepChunk_a_six, stepChunk_a_seven, stepChunk_a_eight,
      stepChunk_b_zero, stepChunk_b_one, stepChunk_b_two, stepChunk_b_three, stepChunk_b_four,
      stepChunk_b_five, stepChunk_b_six, stepChunk_b_seven, stepChunk_b_eight]
  have := List.all_eq_true.mp (h (i / 225) (by omega)) (i % 225)
    (List.mem_range.mpr (Nat.mod_lt _ (by norm_num)))
  rwa [Nat.div_add_mod] at this

private theorem letter_smul_coclique {s : ℕ} (hs : s < 2) {i : ℕ} (hi : i < 2025) :
    action s i < 2025 ∧ letter s • coclique i = coclique (action s i) := by
  have h := stepCheck_eq_true hs hi
  simp only [stepCheck, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at h
  obtain ⟨⟨⟨hlt, hwi⟩, hwj⟩, (htree | htree) | hpts⟩ := h
  · refine ⟨hlt, ?_⟩
    rw [coclique, coclique, htree, wordPerm_three_mul_add hwi (cocliqueWord_lt i) (by omega),
      mul_smul]
  · refine ⟨hlt, ?_⟩
    rw [coclique, coclique, htree, wordPerm_three_mul_add hwj (cocliqueWord_lt _)
      (invLetter_lt s), ← letter_inv (by omega), smul_smul, mul_inv_cancel_left]
  · refine ⟨hlt, Finset.eq_of_subset_of_card_le (fun y hy ↦ ?_) ?_⟩
    · obtain ⟨z, hz, rfl⟩ := Finset.mem_smul_finset.mp hy
      obtain ⟨x, hx, rfl⟩ := Finset.mem_smul_finset.mp hz
      rw [mem_coclique, Equiv.Perm.smul_def, Equiv.Perm.smul_def, letter_apply (by omega),
        wordPerm_apply]
      exact List.all_eq_true.mp hpts x (List.mem_toFinset.mp hx)
    · rw [Finset.card_smul_finset, card_coclique, card_coclique]

private def cocliques : Finset (Finset (Fin 275)) :=
  (Finset.range 2025).image coclique

private theorem letter_smul_cocliques {s : ℕ} (hs : s < 2) :
    letter s • cocliques = cocliques := by
  refine Finset.eq_of_subset_of_card_le (fun T hT ↦ ?_) (Finset.card_smul_finset _ _).ge
  obtain ⟨S, hS, rfl⟩ := Finset.mem_smul_finset.mp hT
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hS
  rw [Finset.mem_range] at hi
  exact Finset.mem_image.mpr
    ⟨action s i, Finset.mem_range.mpr (letter_smul_coclique hs hi).1,
      (letter_smul_coclique hs hi).2.symm⟩

private theorem le_stabilizer_cocliques :
    McL ≤ stabilizer (Equiv.Perm (Fin 275)) cocliques := by
  rw [McL_def, Subgroup.closure_le]
  rintro g (rfl | rfl) <;> rw [SetLike.mem_coe, mem_stabilizer_iff]
  · simpa [letter] using letter_smul_cocliques (s := 0) (by norm_num)
  · simpa [letter] using letter_smul_cocliques (s := 1) (by norm_num)

/-! ### Adjacency counts -/

private def adjacencyCount (p : ℕ) (T : Finset (Fin 275)) : ℕ :=
  (T.filter fun y ↦ related (Fin.ofNat 275 p) y).card

private theorem adjacencyCount_smul {g : Equiv.Perm (Fin 275)} (hg : g ∈ McL) {p : ℕ}
    (hgp : g (Fin.ofNat 275 p) = Fin.ofNat 275 p) (T : Finset (Fin 275)) :
    adjacencyCount p (g • T) = adjacencyCount p T := by
  rw [adjacencyCount, adjacencyCount, Finset.smul_finset_def, Finset.filter_image,
    Finset.card_image_of_injective _ (MulAction.injective g)]
  simp only [Equiv.Perm.smul_def, related_apply_of_apply_eq hg hgp]

/- The four adjacency counts of a coclique, as one number. -/
private def countCode (T : Finset (Fin 275)) : ℕ :=
  adjacencyCount 0 T + 32 * adjacencyCount 1 T + 1024 * adjacencyCount 2 T +
    32768 * adjacencyCount 3 T

private theorem countCode_smul {g : Equiv.Perm (Fin 275)} (hg : g ∈ McL)
    (hfix : ∀ p : ℕ, p < 4 → g (Fin.ofNat 275 p) = Fin.ofNat 275 p) (T : Finset (Fin 275)) :
    countCode (g • T) = countCode T := by
  simp only [countCode, adjacencyCount_smul hg (hfix 0 (by norm_num)),
    adjacencyCount_smul hg (hfix 1 (by norm_num)), adjacencyCount_smul hg (hfix 2 (by norm_num)),
    adjacencyCount_smul hg (hfix 3 (by norm_num))]

private def adjacencyCountN (p w : ℕ) : ℕ :=
  (seedList.filter fun x ↦ (relationRows (Fin.ofNat 275 p)).testBit (wordN 32 w x.val)).length

private def countCodeN (w : ℕ) : ℕ :=
  adjacencyCountN 0 w + 32 * adjacencyCountN 1 w + 1024 * adjacencyCountN 2 w +
    32768 * adjacencyCountN 3 w

private theorem adjacencyCount_coclique (p i : ℕ) :
    adjacencyCount p (coclique i) = adjacencyCountN p (cocliqueWord i) := by
  rw [adjacencyCount, coclique, Finset.smul_finset_def, Finset.filter_image,
    Finset.card_image_of_injective _ (MulAction.injective _), ← List.toFinset_filter,
    List.toFinset_card_of_nodup (seedList_nodup.filter _), adjacencyCountN]
  exact congrArg List.length (List.filter_congr fun x _ ↦ by
    rw [related, Equiv.Perm.smul_def, wordPerm_apply])

private theorem countCode_coclique (i : ℕ) :
    countCode (coclique i) = countCodeN (cocliqueWord i) := by
  simp only [countCode, countCodeN, adjacencyCount_coclique]

/-! ### The fifth basic orbit -/

/- The count codes of the cocliques through `4`. -/
private def codesAtFour : List ℕ :=
  [229607, 229616, 229895, 236775, 236784, 237063, 237072, 245991, 246000, 246279, 246288, 524519,
    524528, 524807, 524816, 531687, 531696, 531975, 531984, 540903, 541191, 541200]

private theorem countCode_of_four_mem :
    (List.range 2025).all (fun i ↦ !seedMask.testBit (wordInvN 32 (cocliqueWord i) 4) ||
      countCodeN (cocliqueWord i) ∈ codesAtFour) = true := by
  decide +kernel

/- Entry `y` is the index of a coclique through `y` whose count code is not in `codesAtFour`. -/
private def witnessTable : ℕ :=
  Nat.ofDigits (2 ^ 352)
    [0x00c024108210e20401905e0b61902d8d710a0c8298ad16e290950b401216c108b415a7f01900000000000000,
     0x0e20c82900d0200182e8d607c144068340a20d004834168034138210a21000480026a2580058e01c08404885,
     0x07e0840480e1ec0240484001a0180800e07c1c42883f0800846b83e0202a07b00901b2b00483f0a414844809,
     0x0200840305210a85c1fa17000041c203414c0381398d01c421c200e0202d0070061de0000800d00c09c2e852,
     0x00c0241f8270bc1001082101203813ab801c0fc1f83f04e0182983f0a2024048b706414c0300e07c1f004827,
     0x00c1bc1f00e1643501910b1de018448b400c3d8448060a20402f03475e1901080d01c0840683f1681c40680d,
     0x0640241a0400a6024030520420d01a07107c034200521023585a06f07c0400803f1ac0380483e0bc034073a8,
     0x08035c1a04001c0182000d04e0187b0b40420840693507c01803010064034138f50640fc2d82151a2b41a00d,
     0x00000000000000000000000000000000000003804cac0a63201a0347260181f0341ac0185683216e1f003034]

private def witness (y : ℕ) : ℕ :=
  witnessTable >>> (11 * y) % 2 ^ 11

private theorem witness_spec : (List.range 275).all (fun y ↦
    y < 4 || y ∈ [4, 37, 40, 102, 119] ||
    witness y < 2025 && seedMask.testBit (wordInvN 32 (cocliqueWord (witness y)) y) &&
      countCodeN (cocliqueWord (witness y)) ∉ codesAtFour) = true := by
  decide +kernel

/- An element of the McLaughlin model fixing `0, 1, 2, 3` sends `4` into
`{4, 37, 40, 102, 119}`. -/
private theorem apply_four_mem_of_mem_fixing {g : Equiv.Perm (Fin 275)}
    (hg : g ∈ McL ⊓ fixingSubgroup (Equiv.Perm (Fin 275)) ({0, 1, 2, 3} : Set (Fin 275))) :
    g 4 ∈ ({4, 37, 40, 102, 119} : Finset (Fin 275)) := by
  obtain ⟨hgM, hgfix⟩ := hg
  have hfix : ∀ p : ℕ, p < 4 → g (Fin.ofNat 275 p) = Fin.ofNat 275 p := by
    intro p hp
    have := (mem_fixingSubgroup_iff (Equiv.Perm (Fin 275))).mp hgfix (Fin.ofNat 275 p)
    interval_cases p <;> exact this (by decide)
  by_contra hout
  have hy4 : ¬ (g 4).val < 4 := by
    intro hlt
    have h := hfix (g 4).val hlt
    rw [Fin.ofNat_eq_cast, Fin.cast_val_eq_self, Equiv.apply_eq_iff_eq] at h
    rw [h] at hlt
    exact absurd hlt (by decide)
  have hyO : (g 4).val ∉ [4, 37, 40, 102, 119] := by
    intro hmem
    apply hout
    revert hmem
    generalize g 4 = y
    revert y
    decide +kernel
  have hw := List.all_eq_true.mp witness_spec (g 4).val (List.mem_range.mpr (g 4).isLt)
  simp only [Bool.or_eq_true, decide_eq_true_eq, hy4, hyO, false_or, Bool.and_eq_true,
    decide_eq_true_eq] at hw
  obtain ⟨⟨hwlt, hwmem⟩, hwcode⟩ := hw
  -- The coclique through `g 4` moves back to a coclique through `4` with the same counts.
  have hT : g⁻¹ • coclique (witness (g 4).val) ∈ cocliques := by
    rw [← mem_stabilizer_iff.mp (le_stabilizer_cocliques (McL.inv_mem hgM))]
    exact Finset.smul_mem_smul_finset
      (Finset.mem_image.mpr ⟨_, Finset.mem_range.mpr hwlt, rfl⟩)
  obtain ⟨i, hi, hTi⟩ := Finset.mem_image.mp hT
  have h4 : (4 : Fin 275) ∈ coclique i := by
    rw [hTi, ← Finset.inv_smul_mem_iff, inv_inv, Equiv.Perm.smul_def, mem_coclique]
    exact hwmem
  have hcode : countCode (coclique i) = countCode (coclique (witness (g 4).val)) := by
    rw [hTi, countCode_smul (McL.inv_mem hgM)]
    intro p hp
    rw [Equiv.Perm.inv_eq_iff_eq, hfix p hp]
  have hcheck := List.all_eq_true.mp countCode_of_four_mem i (Finset.mem_range.mp hi |>
    List.mem_range.mpr)
  have h4' := mem_coclique.mp h4
  simp only [Fin.coe_ofNat_eq_mod, Nat.reduceMod] at h4'
  simp only [h4', Bool.not_true, Bool.false_or, decide_eq_true_eq] at hcheck
  rw [countCode_coclique, countCode_coclique] at hcode
  exact hwcode (hcode ▸ hcheck)

/- A word of order five fixing `0, 1, 2, 3` and cycling `4, 102, 37, 119, 40`. -/
private def cycleWord : ℕ :=
  231633256448476

private theorem cycleWord_spec : ((List.range 4).all (fun p ↦ wordN 32 cycleWord p == p) &&
    wordN 32 cycleWord 4 == 102 && wordN 32 cycleWord 102 == 37 &&
    wordN 32 cycleWord 37 == 119 && wordN 32 cycleWord 119 == 40) = true := by
  decide +kernel

/-- The exact orbit of `4` under the pointwise stabilizer of `{0, 1, 2, 3}` in the ATLAS
model. -/
theorem orbit_fixing_zero_one_two_three_four :
    orbit ↥(McL ⊓ fixingSubgroup (Equiv.Perm (Fin 275)) ({0, 1, 2, 3} : Set (Fin 275)))
      (4 : Fin 275) = (({4, 37, 40, 102, 119} : Finset (Fin 275)) : Set (Fin 275)) := by
  set c := wordPerm 32 cycleWord
  have hc := cycleWord_spec
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.mem_range] at hc
  obtain ⟨⟨⟨⟨hc0, hc4⟩, hc102⟩, hc37⟩, hc119⟩ := hc
  have hval (x y : Fin 275) (h : wordN 32 cycleWord x.val = y.val) : c x = y :=
    Fin.ext ((wordPerm_apply _ _ x).trans h)
  have hmem :
      c ∈ McL ⊓ fixingSubgroup (Equiv.Perm (Fin 275)) ({0, 1, 2, 3} : Set (Fin 275)) := by
    refine ⟨wordPerm_mem _ _, (mem_fixingSubgroup_iff _).mpr ?_⟩
    rintro y (rfl | rfl | rfl | rfl) <;> exact hval _ _ (hc0 _ (by norm_num))
  ext y
  constructor
  · rintro ⟨g, rfl⟩
    exact Finset.mem_coe.mpr (apply_four_mem_of_mem_fixing g.property)
  · intro hy
    have h1 : c 4 = 102 := hval _ _ hc4
    have h2 : c 102 = 37 := hval _ _ hc102
    have h3 : c 37 = 119 := hval _ _ hc37
    have h4 : c 119 = 40 := hval _ _ hc119
    rw [Finset.coe_insert, Finset.coe_insert, Finset.coe_insert, Finset.coe_insert,
      Finset.coe_singleton] at hy
    rcases hy with rfl | rfl | rfl | rfl | rfl
    · exact mem_orbit_self _
    · exact ⟨⟨c ^ 2, pow_mem hmem 2⟩, by simp [pow_succ, h1, h2]⟩
    · exact ⟨⟨c ^ 4, pow_mem hmem 4⟩, by simp [pow_succ, h1, h2, h3, h4]⟩
    · exact ⟨⟨c, hmem⟩, by simp [h1]⟩
    · exact ⟨⟨c ^ 3, pow_mem hmem 3⟩, by simp [pow_succ, h1, h2, h3]⟩

/-- The fifth basic orbit in the ATLAS McLaughlin model has length five. -/
@[simp] theorem ncard_orbit_fixing_zero_one_two_three_four :
    (orbit ↥(McL ⊓ fixingSubgroup (Equiv.Perm (Fin 275)) ({0, 1, 2, 3} : Set (Fin 275)))
      (4 : Fin 275)).ncard = 5 := by
  rw [orbit_fixing_zero_one_two_three_four, Set.ncard_coe_finset]
  decide

/-- The pointwise stabilizer of `{0, 1, 2, 3}` in the exact ATLAS model has order ten. -/
-- Simplify the subgroup's order before its membership predicate expands the intersection.
@[simp↓] theorem card_fixing_zero_one_two_three :
    Nat.card ↥(McL ⊓ fixingSubgroup (Equiv.Perm (Fin 275)) ({0, 1, 2, 3} : Set (Fin 275))) =
      10 := by
  set F := McL ⊓ fixingSubgroup (Equiv.Perm (Fin 275)) ({0, 1, 2, 3} : Set (Fin 275))
  have h := F.ncard_orbit_mul_card_stabilizerChain_succ (fun _ ↦ (4 : Fin 275)) 0
  have h1 : F.stabilizerChain (fun _ ↦ (4 : Fin 275)) 1 =
      McL ⊓ fixingSubgroup (Equiv.Perm (Fin 275)) ({0, 1, 2, 3, 4} : Set (Fin 275)) := by
    ext g
    simp only [Subgroup.mem_stabilizerChain_iff, Nat.lt_one_iff, forall_eq, F, Subgroup.mem_inf,
      mem_fixingSubgroup_iff, Set.mem_insert_iff, Set.mem_singleton_iff, forall_eq_or_imp]
    tauto
  rw [Subgroup.stabilizerChain_zero, h1, ncard_orbit_fixing_zero_one_two_three_four,
    card_fixing_zero_one_two_three_four] at h
  omega

end TauCeti.Sporadic.McL

namespace TauCeti.Sporadic

/-- The ATLAS McLaughlin permutation model has order
`898128000 = 275 * 112 * 81 * 36 * 5 * 2`. -/
@[simp]
theorem card_McL : Nat.card McL = 898128000 := by
  rw [McL.card_eq_89812800_mul_card_fixingSubgroup, McL.card_fixing_zero_one_two_three]

/-- The group presented by the transcribed McLaughlin presentation, when finite, has at least
`898128000` elements, since it maps onto the model `McL`. Finiteness is a hypothesis: with the
junk value `Nat.card = 0` for infinite types, a surjection alone gives no lower bound. -/
theorem le_natCard_group_McL (h : 0 < Nat.card SporadicName.McL.Group) :
    898128000 ≤ Nat.card SporadicName.McL.Group := by
  have := Nat.finite_of_card_ne_zero h.ne'
  obtain ⟨f, hf⟩ := exists_surjective_McL
  exact card_McL ▸ Nat.card_le_card_of_surjective f hf

end TauCeti.Sporadic
