private def cocliqueWord (i : ℕ) : ℕ :=
  wordTable >>> (25 * i) % 2 ^ 25

private theorem cocliqueWord_lt (i : ℕ) : cocliqueWord i < 3 ^ 31 :=
  (Nat.mod_lt _ (by norm_num)).trans (by norm_num)

private def coclique (i : ℕ) : Finset (Fin 275) :=
  wordPerm 32 (cocliqueWord i) • seedList.toFinset

private theorem card_coclique (i : ℕ) : (coclique i).card = seedList.length := by
  rw [coclique, Finset.card_smul_finset, List.toFinset_card_of_nodup seedList_nodup]

private theorem mem_coclique {i : ℕ} {y : Fin 275} :
    y ∈ coclique i ↔ seedMask.testBit (wordInvN 32 (cocliqueWord i) y.val) = true := by
  rw [coclique, ← Finset.inv_smul_mem_iff, Equiv.Perm.smul_def, List.mem_toFinset,
    ← wordPerm_inv_apply, seedMask_testBit, decide_eq_true_iff]

