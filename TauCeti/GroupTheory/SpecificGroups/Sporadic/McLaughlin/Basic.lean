/-- The degree-275 ATLAS permutation model of the McLaughlin group. -/
def McL : Subgroup (Equiv.Perm (Fin 275)) := Subgroup.closure {McL.a, McL.b}

/-- The model is generated by the two file permutations. -/
theorem McL_def : McL = Subgroup.closure {McL.a, McL.b} := (rfl)

namespace McL

theorem a_mem : a ∈ McL := McL_def ▸ Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ McL := McL_def ▸ Subgroup.subset_closure (by simp)

/-! ### Direction and composition checks -/

private theorem direction_checks : b 0 = 23 ∧ b⁻¹ 0 = 154 ∧
    (a * b) 0 = 81 ∧ (b * a) 0 = 24 := by
  decide +kernel

/-! ### The presentation holds and generates the model -/

/-- The presentation generators go to the inverses of the file generators, correcting
for the source's order of composition. -/
def presentationImage (i : Fin SporadicName.McL.presentation.generatorCount) :
    Equiv.Perm (Fin 275) :=
  if (i : ℕ) = 0 then a⁻¹ else b⁻¹

@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.McL.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = a⁻¹ := by
  simp [presentationImage]

@[simp]
theorem presentationImage_one (h : 1 < SporadicName.McL.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = b⁻¹ := by
  simp [presentationImage]

/-- The assignment has precisely the two inverse file generators as its values. -/
theorem range_presentationImage : Set.range presentationImage = {a⁻¹, b⁻¹} := by
  have h : SporadicName.McL.presentation.generatorCount = 2 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    by_cases hi : (i : ℕ) = 0 <;> simp [presentationImage, hi]
  · rintro (rfl | rfl)
    · exact ⟨⟨0, by omega⟩, presentationImage_zero _⟩
    · exact ⟨⟨1, by omega⟩, presentationImage_one _⟩

/- Split the closed permutation checks so elaboration stays within the default resource
limits. All computations, including those in the generator definitions, are kernel-checked. -/
private abbrev x := a⁻¹
private abbrev y := b⁻¹
private abbrev s₁ := x * y
private abbrev s₂ := x * y ^ 2
private abbrev t₁ := x * y⁻¹
private abbrev t₂ := x * y⁻¹ ^ 2

private theorem relator0 : x ^ 2 = 1 := by decide +kernel
private theorem relator1 : y ^ 5 = 1 := by decide +kernel
private theorem relator2 : ⁅x⁻¹, y⁻¹⁆ ^ 5 = 1 := by decide +kernel
private theorem relator3 : s₁ ^ 11 = 1 := by decide +kernel
private theorem relator4 : s₂ ^ 12 = 1 := by decide +kernel
private theorem relator5 : ⁅x⁻¹, (y ^ 2)⁻¹⁆ ^ 6 = 1 := by decide +kernel
private theorem relator6 : (s₁ * t₂) ^ 7 = 1 := by decide +kernel
private theorem relator7 : ⁅x⁻¹, (y⁻¹ ^ 2 * s₁ * s₁ * s₂)⁻¹⁆ ^ 2 = 1 := by
  decide +kernel
private theorem relator8 :
    ⁅x⁻¹, (y⁻¹ ^ 2 * s₂ * t₁ * s₁ * s₂ ^ 2 * s₁ * t₁)⁻¹⁆ = 1 := by
  decide +kernel
private theorem relator9 : ⁅x⁻¹, (y * s₂ ^ 3)⁻¹⁆ ^ 2 = 1 := by decide +kernel
private theorem relator10 : ⁅x⁻¹, (y ^ 2 * s₁ * s₂ ^ 2)⁻¹⁆ ^ 2 = 1 := by decide +kernel
private theorem relator11 :
    s₁ * s₂ * t₂ * s₁ * t₁ * s₂ * (t₂ * s₁) ^ 2 * (s₂ * t₂ * s₂) ^ 2 = 1 := by
  decide +kernel
private theorem relator12 : ⁅x⁻¹, (y ^ 2 * s₂ * t₁ * s₂)⁻¹⁆ ^ 2 = 1 := by decide +kernel
private theorem relator13 : ⁅x⁻¹, (y ^ 2 * s₁)⁻¹⁆ ^ 4 = 1 := by decide +kernel
private theorem relator14 : ⁅x⁻¹, (y ^ 2 * s₂)⁻¹⁆ ^ 4 = 1 := by decide +kernel

/-- All fifteen transcribed McLaughlin relators hold on the inverse file generators. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.McL.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- Abstract the presentation first, because it occurs in the generator index type.
  suffices key : ∀ P : GroupPresentation, P = mclPresentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then a⁻¹ else b⁻¹)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_McL
  rintro P rfl
  simp only [mclPresentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  exact ⟨relator0, relator1, relator2, relator3, relator4, relator5, relator6, relator7,
    relator8, relator9, relator10, relator11, relator12, relator13, relator14⟩

/-- The images of the presentation generators generate exactly the ATLAS model. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = McL := by
  rw [range_presentationImage, McL_def]
  simpa only [Set.inv_insert, Set.inv_singleton] using
    Subgroup.closure_inv ({a, b} : Set (Equiv.Perm (Fin 275)))

/-- The homomorphism from the presented group sending its generators to the inverse
file permutations. -/
def presentationHom : SporadicName.McL.Group →* Equiv.Perm (Fin 275) :=
  SporadicName.McL.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

@[simp]
theorem presentationHom_of (i : Fin SporadicName.McL.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The permutation image of the presented group is exactly the model. -/
theorem range_presentationHom : presentationHom.range = McL :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end McL

/-- The presented McLaughlin group maps onto its ATLAS degree-275 permutation model. -/
theorem exists_surjective_McL :
    ∃ f : SporadicName.McL.Group →* McL, Function.Surjective f :=
  SporadicName.McL.presentation.exists_surjective_of_closure_range_eq
    ⟨McL.presentationImage, McL.lift_presentationImage_toFreeGroup_eq_one⟩
    McL.closure_range_presentationImage

/-- The model contains the nonidentity first file generator. -/
instance : Nontrivial McL :=
  McL.nontrivial_iff_exists_ne_one.2 ⟨McL.a, McL.a_mem, by decide +kernel⟩

/-- The presented group is nontrivial because it surjects onto the model. -/
instance : Nontrivial SporadicName.McL.Group :=
  exists_surjective_McL.choose_spec.nontrivial

end TauCeti.Sporadic
