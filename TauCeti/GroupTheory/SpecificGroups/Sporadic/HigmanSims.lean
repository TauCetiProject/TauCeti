-- Direction and multiplication checks, independently visible in the file image tables.
example : b 0 = 85 ∧ b⁻¹ 0 = 46 ∧ (a * b) 0 = 48 ∧ (b * a) 0 = 73 := by
  decide +kernel

end HS

/-- The Higman--Sims permutation model generated by the exact ATLAS files `HSG1-p100B0.m1`, `.m2`.
This is a finite permutation group, independently of any properties of its presentation. -/
def HS : Subgroup (Equiv.Perm (Fin 100)) := Subgroup.closure {HS.a, HS.b}

/-- The defining generators of the Higman--Sims permutation model. -/
theorem HS_def : HS = Subgroup.closure {HS.a, HS.b} := by rfl

namespace HS

/-- The first file generator belongs to the model. -/
@[simp]
theorem a_mem : a ∈ HS := by
  rw [HS_def]
  exact Subgroup.subset_closure (by simp)

/-- The second file generator belongs to the model. -/
@[simp]
theorem b_mem : b ∈ HS := by
  rw [HS_def]
  exact Subgroup.subset_closure (by simp)

/-- The model is nontrivial: its first generator moves point zero. -/
instance : Nontrivial HS := by
  refine ⟨⟨⟨a, a_mem⟩, 1, ?_⟩⟩
  intro h
  have := congrArg (fun g : HS => (g : Equiv.Perm (Fin 100)) 0) h
  norm_num [a, Function.Involutive.toPerm] at this

/-- Images of the two presentation generators, inverted to convert the source's product convention
into Mathlib's convention. -/
def generatorImages (i : Fin hsPresentation.generatorCount) : Equiv.Perm (Fin 100) :=
  if i.val = 0 then a⁻¹ else b⁻¹

/-- The explicit assignment underlying `generatorImages`. -/
@[simp]
theorem generatorImages_apply (i : Fin hsPresentation.generatorCount) :
    generatorImages i = if i.val = 0 then a⁻¹ else b⁻¹ := by rfl

-- Separate kernel computations keep each relator check within the default resource limits.
-- These syllables are evaluated at the inverse file generators.
private abbrev s1 := a⁻¹ * b⁻¹
private abbrev s2 := a⁻¹ * (b⁻¹) ^ 2
private abbrev sn1 := a⁻¹ * (b⁻¹)⁻¹
private abbrev sn2 := a⁻¹ * ((b⁻¹)⁻¹) ^ 2

private theorem relator1 : (a⁻¹) ^ 2 = 1 := by decide +kernel

private theorem relator2 : (b⁻¹) ^ 5 = 1 := by decide +kernel

private theorem relator3 : s1 ^ 11 = 1 := by decide +kernel

private theorem relator4 : s2 ^ 10 = 1 := by decide +kernel

private theorem relator5 : ⁅(a⁻¹)⁻¹, (b⁻¹)⁻¹⁆ ^ 5 = 1 := by decide +kernel

private theorem relator6 : ⁅(a⁻¹)⁻¹, (b⁻¹ * a⁻¹ * b⁻¹)⁻¹⁆ ^ 3 = 1 := by decide +kernel

private theorem relator7 : ⁅(a⁻¹)⁻¹, ((b⁻¹) ^ 2)⁻¹⁆ ^ 6 = 1 := by decide +kernel

private theorem relator8 :
    s1 * s1 * s2 * sn1 * sn2 * sn1 * s2 * s1 * s1 * sn2 ^ 4 = 1 := by
  decide +kernel

private theorem relator9 : s1 * (s2 * sn2 ^ 2) ^ 2 * s2 * s1 * s2 * (sn1 * s2) ^ 2 = 1 := by
  decide +kernel

private theorem relator10 :
    s1 * s1 * s2 ^ 2 * s1 * sn1 ^ 2 * s1 * s2 ^ 2 * s1 * s1 * sn2 * sn1 * sn2 = 1 := by
  decide +kernel

private theorem relator11 : (s1 * s1 * s2 * sn1 * sn2 * s1 * s1 * sn1) ^ 2 = 1 := by
  decide +kernel

private theorem relator12 :
    (s1 * s1 * s2) ^ 2 * s1 * s1 * sn1 * s1 * s1 * s2 ^ 3 * s1 * s1 * sn1 = 1 := by
  decide +kernel

private theorem relator13 :
    s1 * (s1 * s2) ^ 3 * s1 * s1 * s2 * sn1 * s1 * sn2 * s1 * sn1 * s2 = 1 := by
  decide +kernel

/-- All thirteen transcribed relators hold on the inverse ATLAS generators. -/
theorem relators_hold (t : Relator (Fin hsPresentation.generatorCount))
    (ht : t ∈ hsPresentation.transcribed) :
    FreeGroup.lift generatorImages t.toFreeGroup = 1 := by
  rw [hsPresentation_transcribed] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals
    simp only [Relator.lift_toFreeGroup, Relator.eval_pow, Relator.eval_mul, Relator.eval_inv,
      Relator.eval_gen, Relator.eval_comm, generatorImages_apply,
      ite_true, Nat.reduceEqDiff, ite_false]
  · exact relator1
  · exact relator2
  · exact relator3
  · exact relator4
  · exact relator5
  · exact relator6
  · exact relator7
  · exact relator8
  · exact relator9
  · exact relator10
  · exact relator11
  · exact relator12
  · exact relator13

/-- The presentation images generate exactly the file-generated carrier. -/
theorem closure_range_generatorImages : Subgroup.closure (Set.range generatorImages) = HS := by
  have hr : Set.range generatorImages = ({a, b} : Set (Equiv.Perm (Fin 100)))⁻¹ := by
    simpa only [← generatorImages_apply, Set.inv_insert, Set.inv_singleton] using
      (Set.range_ite_const (p := fun i : Fin hsPresentation.generatorCount => i.val = 0)
        (x := a⁻¹) (y := b⁻¹) ⟨⟨0, by simp⟩, rfl⟩ ⟨⟨1, by simp⟩, by decide⟩)
  rw [hr, Subgroup.closure_inv, ← HS_def]

/-- The homomorphism from the transcribed presentation to the ambient permutation group. -/
def presentationHom : hsPresentation.Group →* Equiv.Perm (Fin 100) :=
  hsPresentation.homEquiv.symm ⟨generatorImages, relators_hold⟩

/-- The presentation homomorphism has the prescribed generator images. -/
@[simp]
theorem presentationHom_of (i : Fin hsPresentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = generatorImages i := by
  simp [presentationHom]

/-- The range is the specified ATLAS model, not merely a subgroup satisfying the relators. -/
@[simp]
theorem range_presentationHom : presentationHom.range = HS := by
  have h := MonoidHom.map_closure presentationHom
    (Set.range (PresentedGroup.of : Fin hsPresentation.generatorCount → hsPresentation.Group))
  rw [PresentedGroup.closure_range_of, Subgroup.map_top, ← Set.range_comp] at h
  simpa only [Function.comp_def, presentationHom_of, closure_range_generatorImages] using h

end HS

/-- The CFSG presentation of `HS` surjects onto its exact ATLAS permutation model. -/
theorem exists_surjective_HS :
    ∃ f : SporadicName.HS.Group →* HS, Function.Surjective f := by
  apply (congrArg (fun P : GroupPresentation =>
    ∃ f : P.Group →* HS, Function.Surjective f) SporadicName.presentation_HS).mpr
  exact ⟨(MulEquiv.subgroupCongr HS.range_presentationHom).toMonoidHom.comp
    HS.presentationHom.rangeRestrict,
    (MulEquiv.subgroupCongr HS.range_presentationHom).surjective.comp
      HS.presentationHom.rangeRestrict_surjective⟩

/-- The transcribed Higman--Sims presentation does not collapse to the trivial group. -/
instance : Nontrivial SporadicName.HS.Group := by
  obtain ⟨f, hf⟩ := exists_surjective_HS
  exact Function.Surjective.nontrivial hf

end TauCeti.Sporadic
