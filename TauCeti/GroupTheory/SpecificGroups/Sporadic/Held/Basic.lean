/-- The permutation model of the Held group `He`: the subgroup of `Equiv.Perm (Fin 2058)`
generated by `He.a` and `He.b`. -/
noncomputable def He : Subgroup (Equiv.Perm (Fin 2058)) := Subgroup.closure {He.a, He.b}

/-- The model is generated by the two permutations `He.a` and `He.b`. -/
theorem He_def : He = Subgroup.closure {He.a, He.b} := (rfl)

namespace He

theorem a_mem : a ∈ He := He_def ▸ Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ He := He_def ▸ Subgroup.subset_closure (by simp)

/-! ### Generator orders -/

/-- The first generator is an involution. -/
theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The second generator has order seven. -/
theorem orderOf_b : orderOf b = 7 :=
  have : Fact (Nat.Prime 7) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The product of the two generators has order seventeen. -/
theorem orderOf_a_mul_b : orderOf (a * b) = 17 :=
  have : Fact (Nat.Prime 17) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### The presentation of the Held group holds in the model -/

/-- The images in the permutation model of the generators of the presentation of `He`: `a` for the
generator of index `0` and `b` for the generator of index `1`. -/
noncomputable def presentationImage (i : Fin SporadicName.He.presentation.generatorCount) :
    Equiv.Perm (Fin 2058) :=
  if (i : ℕ) = 0 then a else b

theorem presentationImage_def (i : Fin SporadicName.He.presentation.generatorCount) :
    presentationImage i = if (i : ℕ) = 0 then a else b :=
  (rfl)

@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.He.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = a := by
  simp [presentationImage]

@[simp]
theorem presentationImage_one (h : 1 < SporadicName.He.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = b := by
  simp [presentationImage]

theorem range_presentationImage : Set.range presentationImage = {a, b} := by
  have h : SporadicName.He.presentation.generatorCount = 2 := by simp
  exact Set.range_ite_const ⟨⟨0, by omega⟩, rfl⟩ ⟨⟨1, by omega⟩, one_ne_zero⟩

/-- **The relators of `He` hold in the model.** All seven transcribed relators of the
presentation of `He` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.He.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.He.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_He`.
  suffices key : ∀ P : GroupPresentation, P = hePresentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then a else b)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_He
  rintro P rfl
  simp only [hePresentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  decide +kernel

/-- **The images generate the model.** The subgroup generated by the images `a` and `b` of the
presentation generators is the permutation model `He`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = He := by
  rw [range_presentationImage, He_def]

/-- The homomorphism from the group presented by the presentation of `He` to
`Equiv.Perm (Fin 2058)` sending the presentation generators to `presentationImage`. -/
noncomputable def presentationHom : SporadicName.He.Group →* Equiv.Perm (Fin 2058) :=
  SporadicName.He.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

theorem presentationHom_def :
    presentationHom = SporadicName.He.presentation.homEquiv.symm
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

@[simp]
theorem presentationHom_of (i : Fin SporadicName.He.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `He`. -/
theorem range_presentationHom : presentationHom.range = He :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end He

/-- **The presented group of `He` maps onto the permutation model.** The group defined by the
presentation of `He` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `He`. -/
theorem exists_surjective_He :
    ∃ f : SporadicName.He.Group →* He, Function.Surjective f :=
  SporadicName.He.presentation.exists_surjective_of_closure_range_eq
    ⟨He.presentationImage, He.lift_presentationImage_toFreeGroup_eq_one⟩
    He.closure_range_presentationImage

/-- The permutation model `He` is nontrivial: it contains the involution `He.a`. -/
instance : Nontrivial He :=
  He.nontrivial_iff_exists_ne_one.2
    ⟨He.a, He.a_mem, fun h ↦ by simpa [h] using He.orderOf_a⟩

/-- The group presented by the presentation of `He` is nontrivial, since it maps onto the
nontrivial permutation model `He`. -/
instance : Nontrivial SporadicName.He.Group :=
  exists_surjective_He.choose_spec.nontrivial

end TauCeti.Sporadic
