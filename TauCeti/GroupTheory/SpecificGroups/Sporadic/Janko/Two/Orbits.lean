private theorem pairWord_spec : ∀ x ∈ secondOrbit,
    word (pairWord x) 0 = 0 ∧ word (pairWord x) 1 = x := by
  decide +kernel

private theorem orbit_stabilizer_eq_secondOrbit :
    orbit (J2.stabilizerChain basePoint 1) (basePoint 1) = secondOrbit := by
  have h0 : basePoint 0 = 0 := by decide +kernel
  have h1 : basePoint 1 = 1 := by decide +kernel
  rw [Subgroup.stabilizerChain_succ, Subgroup.stabilizerChain_zero, h0, h1]
  ext x
  constructor
  · rintro ⟨g, rfl⟩
    apply (mem_secondOrbit _).2
    have hfix : (g : Equiv.Perm (Fin 100)) 0 = 0 := by
      simpa only [Equiv.Perm.smul_def] using mem_stabilizer_iff.mp g.2.2
    simpa only [Subgroup.smul_def, Equiv.Perm.smul_def, hfix] using
      (orbital_apply g.2.1 0 1).trans (by decide +kernel)
  · intro hx
    have hw := pairWord_spec x hx
    have hfix : word (pairWord x) ∈ stabilizer (Equiv.Perm (Fin 100)) (0 : Fin 100) := by
      simpa only [mem_stabilizer_iff, Equiv.Perm.smul_def] using hw.1
    refine mem_orbit_iff.mpr ⟨⟨word (pairWord x), word_mem _, hfix⟩, ?_⟩
    simpa only [Subgroup.smul_def, Equiv.Perm.smul_def] using hw.2

/-- The orbit of `1` under the point stabilizer of `0` in the ATLAS model of `J₂`.
It has only 63 points rather than all 99 points different from `0`. -/
theorem orbit_stabilizer_zero_one :
    orbit (J2.stabilizerChain basePoint 1) (basePoint 1) =
      ({1, 2, 3, 6, 8, 9, 12, 13, 14, 15, 17, 19, 22, 23, 24, 25, 27, 28, 29, 30, 31, 32, 34,
        35, 37, 39, 40, 41, 42, 43, 45, 47, 49, 56, 57, 58, 62, 63, 64, 66, 67, 69, 70, 72, 73,
        74, 75, 76, 77, 81, 82, 85, 86, 88, 89, 90, 93, 94, 95, 96, 97, 98, 99} :
        Finset (Fin 100)) := by
  simpa only [secondOrbit] using orbit_stabilizer_eq_secondOrbit

/-- The second basic orbit, for the ordered base beginning `0, 1`, has length 63. -/
@[simp]
theorem ncard_orbit_stabilizer_zero_one :
    (orbit (J2.stabilizerChain basePoint 1) (basePoint 1)).ncard = 63 := by
  rw [orbit_stabilizer_eq_secondOrbit, Set.ncard_coe_finset]
  decide +kernel

/-- The first two basic orbits reduce the order of `J₂` to that of its two-point stabilizer.
No order for the remaining stabilizer is assumed. -/
theorem card_eq_mul_card_stabilizer_zero_one :
    Nat.card J2 = 6300 * Nat.card (J2.stabilizerChain basePoint 2) := by
  simpa only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul,
    ncard_orbit_zero, ncard_orbit_stabilizer_zero_one, Nat.reduceMul] using
    (J2.prod_ncard_orbit_mul_card_stabilizerChain basePoint 2).symm

/-! ### The third basic orbit -/

private def thirdOrbit : Finset (Fin 100) :=
  {2, 3, 6, 15, 19, 23, 30, 31, 32, 35, 37, 39, 41, 49, 56, 63, 64, 69, 74, 76, 85, 90, 95, 97}

private theorem mem_thirdOrbit : ∀ x : Fin 100,
    x ∈ thirdOrbit ↔ x ≠ 1 ∧ orbital 0 x = true ∧ orbital 1 x = false := by
  decide +kernel

-- Breadth-first search on ordered triples supplies words fixing `0, 1` and sending `2` to `x`.
-- Bits, least significant first, encode `a` as zero and `b` as one; the final one-bit is a marker.
-- Other entries are unused. The decoding uses the same word evaluator as the earlier witnesses.
private def tripleWord (x : Fin 100) : List (Fin 2) :=
  let code : ℕ := match x.val with
    | 2 => 1
    | 3 => 95303937743542
    | 6 => 763841372444341
    | 15 => 528800680645080493
    | 19 => 15108859229558454
    | 23 => 359492458
    | 30 => 193000964690897771
    | 31 => 939972193131
    | 32 => 30147829656922
    | 35 => 57356430763
    | 37 => 15390600217406827
    | 39 => 192365447056108970
    | 41 => 3121731710314
    | 49 => 1597980526992090
    | 56 => 766204598
    | 63 => 120583007983318
    | 64 => 29439145322
    | 69 => 23559688007083
    | 74 => 33132045242119595
    | 76 => 49947707092395
    | 85 => 30871449335412397
    | 90 => 1489123519850
    | 95 => 6277855663830
    | 97 => 94237679638230
    | _ => 1
  code.bits.dropLast.map (fun t ↦ if t then 1 else 0)

private theorem tripleWord_spec : ∀ x ∈ thirdOrbit,
    word (tripleWord x) 0 = 0 ∧ word (tripleWord x) 1 = 1 ∧ word (tripleWord x) 2 = x := by
  decide +kernel

/-- The third basic orbit of the ATLAS model of `J₂`: the points reachable from `2` while
fixing `0` and `1`. -/
theorem orbit_stabilizer_zero_one_two :
    orbit (J2.stabilizerChain basePoint 2) (basePoint 2) =
      ({2, 3, 6, 15, 19, 23, 30, 31, 32, 35, 37, 39, 41, 49, 56, 63, 64, 69, 74, 76, 85, 90, 95,
        97} : Finset (Fin 100)) := by
  -- Fold the literal finset to match the membership and word lemmas for the private data.
  change orbit (J2.stabilizerChain basePoint 2) (basePoint 2) = thirdOrbit
  have h0 : basePoint 0 = 0 := by decide +kernel
  have h1 : basePoint 1 = 1 := by decide +kernel
  have h2 : basePoint 2 = 2 := by decide +kernel
  rw [h2]
  ext x
  constructor
  · rintro ⟨g, rfl⟩
    obtain ⟨hg, hfix⟩ := (Subgroup.mem_stabilizerChain_iff _ _).mp g.property
    have hg0 : (g : Equiv.Perm (Fin 100)) 0 = 0 := by
      simpa only [h0, Equiv.Perm.smul_def] using hfix 0 (by decide)
    have hg1 : (g : Equiv.Perm (Fin 100)) 1 = 1 := by
      simpa only [h1, Equiv.Perm.smul_def] using hfix 1 (by decide)
    apply (mem_thirdOrbit _).mpr
    refine ⟨?_, ?_, ?_⟩
    · exact fun he ↦ (by decide : (2 : Fin 100) ≠ 1) (g.val.injective (he.trans hg1.symm))
    · simpa only [Subgroup.smul_def, Equiv.Perm.smul_def, hg0] using
        (orbital_apply hg 0 2).trans (by decide +kernel)
    · simpa only [Subgroup.smul_def, Equiv.Perm.smul_def, hg1] using
        (orbital_apply hg 1 2).trans (by decide +kernel)
  · intro hx
    obtain ⟨hw0, hw1, hw2⟩ := tripleWord_spec x hx
    refine mem_orbit_iff.mpr ⟨⟨word (tripleWord x), ?_⟩, hw2⟩
    apply (Subgroup.mem_stabilizerChain_iff _ _).mpr
    refine ⟨word_mem _, fun j hj ↦ ?_⟩
    have hj : j = 0 ∨ j = 1 := by omega
    rcases hj with rfl | rfl
    · simpa only [h0, Equiv.Perm.smul_def] using hw0
    · simpa only [h1, Equiv.Perm.smul_def] using hw1

/-- The third basic orbit, for the ordered base beginning `0, 1, 2`, has length 24. -/
@[simp]
theorem ncard_orbit_stabilizer_zero_one_two :
    (orbit (J2.stabilizerChain basePoint 2) (basePoint 2)).ncard = 24 := by
  rw [orbit_stabilizer_zero_one_two, Set.ncard_coe_finset]
  decide +kernel

/-- The first three basic orbits reduce the order of `J₂` to `151200` times the order of its
three-point stabilizer. No order or triviality of that stabilizer is assumed. -/
theorem card_eq_mul_card_stabilizer_zero_one_two :
    Nat.card J2 = 151200 * Nat.card (J2.stabilizerChain basePoint 3) := by
  simpa only [Finset.prod_range_succ, Finset.prod_range_zero, one_mul,
    ncard_orbit_zero, ncard_orbit_stabilizer_zero_one, ncard_orbit_stabilizer_zero_one_two,
    Nat.reduceMul] using
    (J2.prod_ncard_orbit_mul_card_stabilizerChain basePoint 3).symm

/-! ### Rigidity after the fourth point -/

