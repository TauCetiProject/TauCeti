module

public import Mathlib.GroupTheory.OrderOfElement
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Presentation

/-!
# The ATLAS permutation model of the second Janko group

`TauCeti.Sporadic.J2` is the subgroup of permutations of `Fin 100` generated by the
forward images of the ATLAS files `J2G1-p100B0.m1` and `J2G1-p100B0.m2`.
File point `i` becomes point `i - 1`. The tables include inverse images so that words
in either direction compute directly.

Stoytchev's presentation is not on the ATLAS standard generators. Its two generators
are sent to the order-seven permutations `J2.imageA` and `J2.imageB`. To describe these
in terms of the file generators, put
`c = b⁻¹ * a * b⁻¹ * a * b * a * b * a` and `y = c * b * c⁻¹`.
Then `imageA = y⁻¹ * a` and `imageB = a * y⁻¹`. All three transcribed relators,
including the chosen positive exponent in the last one, hold with Mathlib's
right-to-left composition. Explicit recovery words for both file generators prove
that these images generate exactly the model. Thus `exists_surjective_J2` gives a
surjection from the presented group onto this model, and both groups are nontrivial.
No order or simplicity of either group is asserted here.

The lift and range arguments use `GroupPresentation.homEquiv` and
`GroupPresentation.exists_surjective_of_closure_range_eq`.

## References

* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `J2G1-p100B0`, <https://brauer.maths.qmul.ac.uk/Atlas/v3/>.
  Forward image files:
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/J2/mtx/J2G1-p100B0.m1> and
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/J2/mtx/J2G1-p100B0.m2>.
* O. Stoytchev, *A Class of Efficient Presentations of Finite Simple Groups*,
  arXiv:2011.05660v1 (2020), Section 3, `n = 7`, order `604800` entry.
-/

public section

namespace TauCeti.Sporadic

/- Blocks of twenty images keep array lookup reduction small in kernel computations.
The concrete permutations are exposed so importing modules can compute with them. -/

/-- The first ATLAS generator, a fixed-point-free involution, with file labels decreased by one. -/
@[expose] def J2.a : Equiv.Perm (Fin 100) :=
  let f (i : Fin 100) : Fin 100 := (#[
    #[83, 19, 47, 55, 81, 66, 54, 40, 34, 39, 77, 99, 48, 36, 93, 75, 18, 43, 16, 1],
    #[33, 84, 91, 56, 74, 27, 63, 25, 89, 96, 37, 67, 68, 20, 8, 52, 13, 30, 60, 9],
    #[7, 72, 90, 17, 85, 80, 88, 2, 12, 92, 95, 71, 35, 73, 6, 3, 23, 98, 94, 62],
    #[38, 82, 59, 26, 69, 87, 5, 31, 32, 64, 86, 51, 41, 53, 24, 15, 97, 10, 79, 78],
    #[45, 4, 61, 0, 21, 44, 70, 65, 46, 28, 42, 22, 49, 14, 58, 50, 29, 76, 57, 11]] :
      Array (Array (Fin 100))) |>.getD (i.val / 20) #[] |>.getD (i.val % 20) 0
  { toFun := f
    invFun := f
    left_inv := by decide +kernel
    right_inv := by decide +kernel }

/-- The second ATLAS generator, of order three, with file labels decreased by one. -/
@[expose] def J2.b : Equiv.Perm (Fin 100) :=
  let f (i : Fin 100) : Fin 100 := (#[
    #[79, 8, 52, 22, 50, 36, 6, 26, 10, 61, 1, 64, 63, 60, 97, 72, 38, 4, 12, 96],
    #[95, 0, 77, 5, 14, 92, 59, 56, 70, 68, 11, 15, 16, 85, 27, 35, 23, 58, 32, 42],
    #[40, 67, 90, 41, 29, 84, 9, 75, 91, 65, 17, 13, 86, 94, 28, 53, 34, 19, 93, 7],
    #[51, 46, 73, 18, 30, 87, 20, 43, 44, 80, 54, 62, 31, 71, 69, 89, 48, 3, 99, 21],
    #[74, 33, 78, 83, 88, 81, 2, 49, 45, 47, 39, 76, 98, 37, 55, 66, 57, 24, 25, 82]] :
      Array (Array (Fin 100))) |>.getD (i.val / 20) #[] |>.getD (i.val % 20) 0
  let g (i : Fin 100) : Fin 100 := (#[
    #[21, 10, 86, 77, 17, 23, 6, 59, 1, 46, 8, 30, 18, 51, 24, 31, 32, 50, 63, 57],
    #[66, 79, 3, 36, 97, 98, 7, 34, 54, 44, 64, 72, 38, 81, 56, 35, 5, 93, 16, 90],
    #[40, 43, 39, 67, 68, 88, 61, 89, 76, 87, 4, 60, 2, 55, 70, 94, 27, 96, 37, 26],
    #[13, 9, 71, 12, 11, 49, 95, 41, 29, 74, 28, 73, 15, 62, 80, 47, 91, 22, 82, 0],
    #[69, 85, 99, 83, 45, 33, 52, 65, 84, 75, 42, 48, 25, 58, 53, 20, 19, 14, 92, 78]] :
      Array (Array (Fin 100))) |>.getD (i.val / 20) #[] |>.getD (i.val % 20) 0
  { toFun := f
    invFun := g
    left_inv := by decide +kernel
    right_inv := by decide +kernel }

/-- The degree-100 ATLAS permutation model of the second Janko group. -/
def J2 : Subgroup (Equiv.Perm (Fin 100)) := Subgroup.closure {J2.a, J2.b}

/-- The model is generated by the two file permutations. -/
theorem J2_def : J2 = Subgroup.closure {J2.a, J2.b} := (rfl)

namespace J2

theorem a_mem : a ∈ J2 := J2_def ▸ Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ J2 := J2_def ▸ Subgroup.subset_closure (by simp)

/-! ### Transcription checks -/

private theorem direction_checks : b 0 = 79 ∧ b⁻¹ 0 = 21 ∧
    (a * b) 0 = 78 ∧ (b * a) 0 = 83 := by
  decide +kernel

theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_b : orderOf b = 3 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_a_mul_b : orderOf (a * b) = 7 :=
  have : Fact (Nat.Prime 7) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### Images of Stoytchev's generators -/

/-- The image of Stoytchev's generator of index zero, an order-seven permutation.
Its forward and inverse tables allow direct computation of the relators. -/
@[expose] def imageA : Equiv.Perm (Fin 100) :=
  let f (i : Fin 100) : Fin 100 := (#[
    #[46, 38, 10, 77, 14, 57, 43, 0, 4, 97, 56, 11, 19, 34, 93, 50, 90, 89, 33, 81],
    #[88, 91, 69, 55, 21, 87, 47, 44, 54, 51, 17, 12, 86, 23, 82, 75, 26, 83, 78, 39],
    #[96, 27, 32, 65, 15, 71, 16, 31, 94, 60, 58, 98, 68, 85, 20, 95, 6, 80, 67, 74],
    #[48, 79, 66, 49, 84, 72, 76, 41, 18, 5, 35, 7, 2, 42, 40, 73, 9, 63, 8, 92],
    #[53, 36, 99, 24, 62, 22, 70, 37, 30, 28, 45, 25, 13, 1, 3, 52, 29, 64, 59, 61]] :
      Array (Array (Fin 100))) |>.getD (i.val / 20) #[] |>.getD (i.val % 20) 0
  let g (i : Fin 100) : Fin 100 := (#[
    #[7, 93, 72, 94, 8, 69, 56, 71, 78, 76, 2, 11, 31, 92, 4, 44, 46, 30, 68, 12],
    #[54, 24, 85, 33, 83, 91, 36, 41, 89, 96, 88, 47, 42, 18, 13, 70, 81, 87, 1, 39],
    #[74, 67, 73, 6, 27, 90, 0, 26, 60, 63, 15, 29, 95, 80, 28, 23, 10, 5, 50, 98],
    #[49, 99, 84, 77, 97, 43, 62, 58, 52, 22, 86, 45, 65, 75, 59, 35, 66, 3, 38, 61],
    #[57, 19, 34, 37, 64, 53, 32, 25, 20, 17, 16, 21, 79, 14, 48, 55, 40, 9, 51, 82]] :
      Array (Array (Fin 100))) |>.getD (i.val / 20) #[] |>.getD (i.val % 20) 0
  { toFun := f
    invFun := g
    left_inv := by decide +kernel
    right_inv := by decide +kernel }

/-- The image of Stoytchev's generator of index one, conjugate to `imageA` by the involution `a`.
Its body is exposed for computations with the presentation. -/
@[expose] def imageB : Equiv.Perm (Fin 100) := a * imageA * a

/-- The first presentation image as a word in the file generators. -/
theorem imageA_eq :
    imageA =
      (b⁻¹ * a * b⁻¹ * a * b * a * b * a) * b⁻¹ *
        (b⁻¹ * a * b⁻¹ * a * b * a * b * a)⁻¹ * a := by
  decide +kernel

theorem imageB_def : imageB = a * imageA * a := (rfl)

/-- The first file generator as a word in the presentation images. -/
theorem a_eq : a = imageA * imageB * imageA := by decide +kernel

/-- The second file generator as a word in the presentation images. -/
theorem b_eq : b = imageA * imageB⁻¹ * imageA * imageB⁻¹ * imageA * imageB⁻¹ *
    imageA * imageA * imageB⁻¹ * imageA * imageB⁻¹ * imageA * imageA *
    imageB⁻¹ * imageB⁻¹ * imageA * imageA * imageB⁻¹ * imageB⁻¹ * imageB⁻¹ := by
  decide +kernel

/-- The two-generator assignment for Stoytchev's presentation. -/
def presentationImage (i : Fin SporadicName.J2.presentation.generatorCount) :
    Equiv.Perm (Fin 100) :=
  if (i : ℕ) = 0 then imageA else imageB

@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.J2.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageA := by
  simp [presentationImage]

@[simp]
theorem presentationImage_one (h : 1 < SporadicName.J2.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageB := by
  simp [presentationImage]

/-- The assignment has precisely the two chosen images as its values. -/
theorem range_presentationImage : Set.range presentationImage = {imageA, imageB} := by
  have h : SporadicName.J2.presentation.generatorCount = 2 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    by_cases hi : (i : ℕ) = 0 <;> simp [presentationImage, hi]
  · rintro (rfl | rfl)
    · exact ⟨⟨0, by omega⟩, presentationImage_zero _⟩
    · exact ⟨⟨1, by omega⟩, presentationImage_one _⟩

/- Separate closed checks keep each computation within the default resource limits. -/
private theorem relator0 : imageA * imageB * imageA * (imageB * imageA * imageB)⁻¹ = 1 := by
  decide +kernel

private theorem relator1 : imageA * imageB ^ 2 * imageA * imageB⁻¹ ^ 5 = 1 := by
  decide +kernel

private theorem relator2 :
    (imageA * imageB⁻¹ * imageA * imageB⁻¹ ^ 3 * imageA ^ 3 * imageB⁻¹) ^ 3 * imageA ^ 7 = 1 := by
  decide +kernel

/-- All three transcribed Stoytchev relators hold at the chosen images. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.J2.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- Abstract the presentation first, because it occurs in the generator index type.
  suffices key : ∀ P : GroupPresentation, P = j2Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then imageA else imageB)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_J2
  rintro P rfl
  simp only [j2Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  exact ⟨relator0, relator1, relator2⟩

/-- The presentation images generate exactly the ATLAS model. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = J2 := by
  rw [range_presentationImage, J2_def]
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    have ha : a ∈ Subgroup.closure {a, b} := Subgroup.subset_closure (by simp)
    have hb : b ∈ Subgroup.closure {a, b} := Subgroup.subset_closure (by simp)
    have hA : imageA ∈ Subgroup.closure {a, b} := by
      rw [imageA_eq]
      have hc : b⁻¹ * a * b⁻¹ * a * b * a * b * a ∈ Subgroup.closure {a, b} := by
        simp only [mul_mem_cancel_right ha, mul_mem_cancel_right hb,
          mul_mem_cancel_right (inv_mem hb), inv_mem_iff, hb]
      exact mul_mem (mul_mem (mul_mem hc (inv_mem hb)) (inv_mem hc)) ha
    rintro σ (rfl | rfl)
    · exact hA
    · rw [imageB_def]
      exact mul_mem (mul_mem ha hA) ha
  · refine (Subgroup.closure_le _).mpr ?_
    have hA : imageA ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    have hB : imageB ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, a_eq, b_eq, mul_mem_cancel_right hA,
        mul_mem_cancel_right hB, mul_mem_cancel_right (inv_mem hB), hA]

/-- The homomorphism from the presented group extending the chosen assignment. -/
def presentationHom : SporadicName.J2.Group →* Equiv.Perm (Fin 100) :=
  SporadicName.J2.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

@[simp]
theorem presentationHom_of (i : Fin SporadicName.J2.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of the presented-group homomorphism is exactly the ATLAS model. -/
theorem range_presentationHom : presentationHom.range = J2 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end J2

/-- The presented second Janko group maps onto its ATLAS degree-100 permutation model. -/
theorem exists_surjective_J2 :
    ∃ f : SporadicName.J2.Group →* J2, Function.Surjective f :=
  SporadicName.J2.presentation.exists_surjective_of_closure_range_eq
    ⟨J2.presentationImage, J2.lift_presentationImage_toFreeGroup_eq_one⟩
    J2.closure_range_presentationImage

/-- The model contains the nonidentity first file generator. -/
instance : Nontrivial J2 :=
  J2.nontrivial_iff_exists_ne_one.2 ⟨J2.a, J2.a_mem, by decide +kernel⟩

/-- The presented group is nontrivial because it surjects onto the model. -/
instance : Nontrivial SporadicName.J2.Group :=
  exists_surjective_J2.choose_spec.nontrivial

end TauCeti.Sporadic
