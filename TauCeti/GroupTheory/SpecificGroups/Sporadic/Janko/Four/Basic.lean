      imageY⁻¹ * imageX * imageY⁻¹ * imageX * imageY⁻¹ * imageX * imageY * imageX * imageY *
      imageX * imageY⁻¹ * imageX * imageY⁻¹ * imageX * imageY⁻¹ * imageX * imageY⁻¹ * imageX *
      imageY⁻¹ * imageX * imageY * imageX * imageY * imageX * imageY⁻¹ * imageX * imageY * imageX *
      imageY⁻¹ * imageX * imageY⁻¹ * imageX * imageY * imageX * imageY * imageX * imageY * imageX *
      imageT * imageX * imageY * imageX * imageY * imageX * imageY * imageX * imageY⁻¹ * imageX *
      imageT * imageX * imageY * imageX * imageY * imageT * imageY * imageT * imageY * imageT *
      imageY⁻¹ * imageX * imageY⁻¹ * imageX * imageT * imageY⁻¹ * imageX * imageY⁻¹ * imageX *
      imageY * imageX * imageY⁻¹ * imageX * imageY * imageT * imageY * imageX * imageY⁻¹ *
      imageX := by
  simp only [b_def, imageX_def, imageY_def, imageT_def, ← map_inv, ← map_mul]
  exact congrArg _ (by decide +kernel)

/-! ### The assignment and the relators -/

/-- The images in the matrix model of the generators of the presentation of `J₄`: the generators
of index `0`, `1` and `2`, which are `x`, `y` and `t`, go to `imageX`, `imageY` and `imageT`. -/
def presentationImage (i : Fin SporadicName.J4.presentation.generatorCount) :
    GL (Fin 112) (ZMod 2) :=
  if (i : ℕ) = 0 then imageX else if (i : ℕ) = 1 then imageY else imageT

/-- The assignment unfolded: `imageX` at index `0`, `imageY` at index `1` and `imageT`
otherwise. -/
theorem presentationImage_def (i : Fin SporadicName.J4.presentation.generatorCount) :
    presentationImage i =
      if (i : ℕ) = 0 then imageX else if (i : ℕ) = 1 then imageY else imageT :=
  (rfl)

/-- The generator of index `0` goes to `imageX`. -/
@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.J4.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageX := by
  simp [presentationImage]

/-- The generator of index `1` goes to `imageY`. -/
@[simp]
theorem presentationImage_one (h : 1 < SporadicName.J4.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageY := by
  simp [presentationImage]

/-- The generator of index `2` goes to `imageT`. -/
@[simp]
theorem presentationImage_two (h : 2 < SporadicName.J4.presentation.generatorCount) :
    presentationImage ⟨2, h⟩ = imageT := by
  simp [presentationImage]

/-- The assignment has precisely the three chosen images as its values. -/
theorem range_presentationImage : Set.range presentationImage = {imageX, imageY, imageT} := by
  have h : SporadicName.J4.presentation.generatorCount = 3 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨⟨k, hk⟩, rfl⟩
    have hk' : k < 3 := h ▸ hk
    interval_cases k <;> simp
  · rintro (rfl | rfl | rfl)
    exacts [⟨⟨0, by omega⟩, presentationImage_zero _⟩, ⟨⟨1, by omega⟩, presentationImage_one _⟩,
      ⟨⟨2, by omega⟩, presentationImage_two _⟩]

/- The twelve relators are checked one at a time on the packed matrices, in the order of the
transcription. The commutators are those of the source, written with Mathlib's
`⁅g, h⁆ = g * h * g⁻¹ * h⁻¹` at inverted arguments, and a conjugate `r ^ s` of the source is
`s⁻¹ * r * s`. Here `packedX`, `packedY` and `packedT` are the packed matrices of the images of
`x`, `y` and `t`. -/
private theorem relator0 : packedX ^ 2 = 1 := by decide +kernel

private theorem relator1 : packedY ^ 3 = 1 := by decide +kernel

private theorem relator2 : (packedX * packedY) ^ 23 = 1 := by decide +kernel

private theorem relator3 : ⁅packedX⁻¹, packedY⁻¹⁆ ^ 12 = 1 := by decide +kernel

private theorem relator4 : ⁅packedX⁻¹, (packedY * packedX * packedY)⁻¹⁆ ^ 5 = 1 := by
  decide +kernel

private theorem relator5 :
    (packedX * packedY * packedX * packedY * packedX * packedY⁻¹) ^ 3 *
      (packedX * packedY * packedX * packedY⁻¹ * packedX * packedY⁻¹) ^ 3 = 1 := by
  decide +kernel

private theorem relator6 :
    (packedX * packedY * (packedX * packedY * packedX * packedY⁻¹) ^ 3) ^ 4 = 1 := by
  decide +kernel

private theorem relator7 : packedT ^ 2 = 1 := by decide +kernel

private theorem relator8 : ⁅packedT⁻¹, packedX⁻¹⁆ = 1 := by decide +kernel

private theorem relator9 :
    ⁅packedT⁻¹, (packedY * packedX * packedY * (packedX * packedY⁻¹) ^ 2 *
      (packedX * packedY) ^ 3)⁻¹⁆ = 1 := by
  decide +kernel

private theorem relator10 :
    (packedY * ((packedY * packedX * packedY⁻¹ * packedX * packedY * packedX * packedY⁻¹ *
      packedX)⁻¹ * packedT * (packedY * packedX * packedY⁻¹ * packedX * packedY * packedX *
        packedY⁻¹ * packedX))) ^ 3 = 1 := by
  decide +kernel

private theorem relator11 :
    ((packedY * packedX * packedY * packedX * packedY * packedX * packedY) ^ 3 * packedT *
      (((packedX * packedY) ^ 3 * packedY * (packedX * packedY) ^ 6 * packedY)⁻¹ * packedT *
        ((packedX * packedY) ^ 3 * packedY * (packedX * packedY) ^ 6 * packedY))) ^ 2 = 1 := by
  decide +kernel

/-- **The relators of `J₄` hold in the model.** All twelve transcribed relators of the
presentation of `J₄` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ r ∈ SporadicName.J4.presentation.transcribed,
      FreeGroup.lift presentationImage r.toFreeGroup = 1 := by
  -- The relators are evaluated on the packed matrices and transported along `BitMatrix.toGL`.
  -- The type of the assignment mentions `SporadicName.J4.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_J4`.
  suffices key : ∀ P : GroupPresentation, P = j4Presentation → ∀ r ∈ P.transcribed,
      r.eval (fun i : Fin P.generatorCount ↦
        if (i : ℕ) = 0 then packedX else if (i : ℕ) = 1 then packedY else packedT) = 1 by
    intro r hr
    have himage : presentationImage = BitMatrix.toGL (ZMod 2) ∘
        fun i : Fin SporadicName.J4.presentation.generatorCount ↦
          if (i : ℕ) = 0 then packedX else if (i : ℕ) = 1 then packedY else packedT := by
      funext i
      rw [presentationImage_def, Function.comp_apply]
      split_ifs
      exacts [imageX_def, imageY_def, imageT_def]
    rw [Relator.lift_toFreeGroup, himage, ← Relator.map_eval,
      key _ SporadicName.presentation_J4 r hr, map_one]
  rintro P rfl
  simp only [j4Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.eval_mul, Relator.eval_pow, Relator.eval_inv,
    Relator.eval_comm, Relator.eval_gen, one_ne_zero, OfNat.ofNat_ne_zero, OfNat.ofNat_ne_one,
    ↓reduceIte]
  exact ⟨relator0, relator1, relator2, relator3, relator4, relator5, relator6, relator7,
    relator8, relator9, relator10, relator11⟩

/-! ### Generation and the surjection -/

/-- **The images generate the model.** The subgroup generated by the three images of the
presentation generators is the matrix model `J4`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = J4 := by
  rw [range_presentationImage, J4_def]
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    have ha : a ∈ Subgroup.closure ({a, b} : Set (GL (Fin 112) (ZMod 2))) :=
      Subgroup.subset_closure (by simp)
    have hb : b ∈ Subgroup.closure ({a, b} : Set (GL (Fin 112) (ZMod 2))) :=
      Subgroup.subset_closure (by simp)
    -- Each image is a word in the two generators; a word is peeled from the right.
    rintro g (rfl | rfl | rfl) <;>
    · simp only [SetLike.mem_coe, imageX_eq, imageY_eq, imageT_eq, mul_mem_cancel_right ha,
        mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb), ha, hb, inv_mem_iff]
  · refine (Subgroup.closure_le _).mpr ?_
    have hx : imageX ∈
        Subgroup.closure ({imageX, imageY, imageT} : Set (GL (Fin 112) (ZMod 2))) :=
      Subgroup.subset_closure (by simp)
    have hy : imageY ∈
        Subgroup.closure ({imageX, imageY, imageT} : Set (GL (Fin 112) (ZMod 2))) :=
      Subgroup.subset_closure (by simp)
    have ht : imageT ∈
        Subgroup.closure ({imageX, imageY, imageT} : Set (GL (Fin 112) (ZMod 2))) :=
      Subgroup.subset_closure (by simp)
    -- Each generator of the model is a word in the three images.
    rintro g (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, a_eq, b_eq, mul_mem_cancel_right hx, mul_mem_cancel_right hy,
        mul_mem_cancel_right (inv_mem hy), mul_mem_cancel_right ht, hy, inv_mem_iff]

/-- The homomorphism from the group presented by the presentation of `J₄` to
`GL (Fin 112) (ZMod 2)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.J4.Group →* GL (Fin 112) (ZMod 2) :=
  SporadicName.J4.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

/-- The homomorphism unfolded: the extension of `presentationImage` given by
`GroupPresentation.homEquiv`. -/
theorem presentationHom_def :
    presentationHom = SporadicName.J4.presentation.homEquiv.symm
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

/-- The homomorphism sends each generator of the presented group to its chosen image. -/
@[simp]
theorem presentationHom_of (i : Fin SporadicName.J4.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the matrix model `J4`. -/
theorem range_presentationHom : presentationHom.range = J4 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end J4

/-- **The presented group of `J₄` maps onto the matrix model.** The group defined by the
presentation of `J₄` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `J4`. -/
theorem exists_surjective_J4 :
    ∃ f : SporadicName.J4.Group →* J4, Function.Surjective f :=
  SporadicName.J4.presentation.exists_surjective_of_closure_range_eq
    ⟨J4.presentationImage, J4.lift_presentationImage_toFreeGroup_eq_one⟩
    J4.closure_range_presentationImage

/-- The matrix model `J4` is nontrivial: its first generator is an involution. -/
instance : Nontrivial J4 :=
  J4.nontrivial_iff_exists_ne_one.2 ⟨J4.a, J4.a_mem, fun h ↦ by simpa [h] using J4.orderOf_a⟩

/-- The group presented by the presentation of `J₄` is nontrivial, since it maps onto the
nontrivial matrix model `J4`. -/
instance : Nontrivial SporadicName.J4.Group :=
  exists_surjective_J4.choose_spec.nontrivial

end TauCeti.Sporadic
