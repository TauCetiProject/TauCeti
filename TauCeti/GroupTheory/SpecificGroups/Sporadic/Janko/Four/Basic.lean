/-- The first generator of the matrix model of `J₄`: the first matrix of the ATLAS representation
`J4G1-f2r112B0`, an involution. -/
def a : GL (Fin 112) (ZMod 2) := BitMatrix.toGL (ZMod 2) packedA

/-- The second generator of the matrix model of `J₄`: the second matrix of the ATLAS
representation `J4G1-f2r112B0`, of order `4`. -/
def b : GL (Fin 112) (ZMod 2) := BitMatrix.toGL (ZMod 2) packedB

/-- The image of the generator `x` of the presentation of `J₄`, of index zero: an involution. -/
def imageX : GL (Fin 112) (ZMod 2) := BitMatrix.toGL (ZMod 2) packedX

/-- The image of the generator `y` of the presentation of `J₄`, of index one: a matrix of order
`3`. -/
def imageY : GL (Fin 112) (ZMod 2) := BitMatrix.toGL (ZMod 2) packedY

/-- The image of the generator `t` of the presentation of `J₄`, of index two: an involution. -/
def imageT : GL (Fin 112) (ZMod 2) := BitMatrix.toGL (ZMod 2) packedT

/-- The generator `a` is the invertible matrix of `packedA`. -/
theorem a_def : a = BitMatrix.toGL (ZMod 2) packedA := (rfl)

/-- The generator `b` is the invertible matrix of `packedB`. -/
theorem b_def : b = BitMatrix.toGL (ZMod 2) packedB := (rfl)

/-- The image of `x` is the invertible matrix of `packedX`. -/
theorem imageX_def : imageX = BitMatrix.toGL (ZMod 2) packedX := (rfl)

/-- The image of `y` is the invertible matrix of `packedY`. -/
theorem imageY_def : imageY = BitMatrix.toGL (ZMod 2) packedY := (rfl)

/-- The image of `t` is the invertible matrix of `packedT`. -/
theorem imageT_def : imageT = BitMatrix.toGL (ZMod 2) packedT := (rfl)

end J4

/-- The ATLAS matrix model of the fourth Janko group `J₄`: the subgroup of
`GL (Fin 112) (ZMod 2)` generated by the two matrices of the representation `J4G1-f2r112B0`. -/
def J4 : Subgroup (GL (Fin 112) (ZMod 2)) := Subgroup.closure {J4.a, J4.b}

/-- The model is the subgroup generated by its two generators. -/
theorem J4_def : J4 = Subgroup.closure {J4.a, J4.b} := (rfl)

namespace J4

/-- The first generator lies in the model. -/
theorem a_mem : a ∈ J4 := J4_def ▸ Subgroup.subset_closure (by simp)

/-- The second generator lies in the model. -/
theorem b_mem : b ∈ J4 := J4_def ▸ Subgroup.subset_closure (by simp)

/-- The tables follow the rows and columns of the ATLAS files: the first row of the first file
begins `0111`, its second row begins `0000`, and the first row of the second file begins `1001`. -/
private theorem entry_checks :
    (List.range 4).map (fun j ↦ (packedA : BitMatrix 112).toNat.testBit (112 * 0 + j)) =
        [false, true, true, true] ∧
      (List.range 4).map (fun j ↦ (packedA : BitMatrix 112).toNat.testBit (112 * 1 + j)) =
        [false, false, false, false] ∧
      (List.range 4).map (fun j ↦ (packedB : BitMatrix 112).toNat.testBit (112 * 0 + j)) =
        [true, false, false, true] := by
  decide +kernel

/-! ### Orders -/

/-- The first generator is an involution. -/
theorem orderOf_a : orderOf a = 2 :=
  (orderOf_injective _ BitMatrix.toGL_injective packedA).trans
    (orderOf_eq_prime (by decide +kernel) (by decide +kernel))

/-- The second generator has order four. -/
theorem orderOf_b : orderOf b = 4 :=
  (orderOf_injective _ BitMatrix.toGL_injective packedB).trans
    ((orderOf_eq_prime_pow (p := 2) (n := 1) (by decide +kernel) (by decide +kernel)).trans
      (by norm_num))

/-- The product of the two generators has order `37`. -/
theorem orderOf_a_mul_b : orderOf (a * b) = 37 :=
  haveI : Fact (Nat.Prime 37) := ⟨by decide⟩
  (congrArg orderOf (map_mul (BitMatrix.toGL (ZMod 2)) packedA packedB).symm).trans <|
    (orderOf_injective _ BitMatrix.toGL_injective (packedA * packedB)).trans
      (orderOf_eq_prime (by decide +kernel) (by decide +kernel))

/-- The image of `x` is an involution. -/
theorem orderOf_imageX : orderOf imageX = 2 :=
  (orderOf_injective _ BitMatrix.toGL_injective packedX).trans
    (orderOf_eq_prime (by decide +kernel) (by decide +kernel))

/-- The image of `y` has order three. -/
theorem orderOf_imageY : orderOf imageY = 3 :=
  (orderOf_injective _ BitMatrix.toGL_injective packedY).trans
    (orderOf_eq_prime (by decide +kernel) (by decide +kernel))

/-- The image of `t` is an involution. -/
theorem orderOf_imageT : orderOf imageT = 2 :=
  (orderOf_injective _ BitMatrix.toGL_injective packedT).trans
    (orderOf_eq_prime (by decide +kernel) (by decide +kernel))

