    imageX = b⁻¹ * a * b⁻¹ * a * b * a * b * a * b * b * a * b * a * b * b * a * b * a * b * b * a *
      b * a * b * b * a * b * a * b * a * b * a * b := by
  simp only [imageX_def, a_def, b_def, ← map_inv, ← map_mul]
  exact congrArg _ (by decide +kernel)

