  decide +kernel

/-! ### The relators -/

/-- Two permutations of the `6156` points are equal once they agree at the point `76 * q + r` for
all `q < 81` and `r < 76`. -/
private theorem ext_point {σ τ : Equiv.Perm (Fin 6156)}
    (h : ∀ (q : Fin 81) (r : Fin 76), σ (finProdFinEquiv (q, r)) = τ (finProdFinEquiv (q, r))) :
    σ = τ :=
  Equiv.ext <| (finProdFinEquiv (m := 81) (n := 76)).forall_congr_right.mp <| Prod.forall.mpr h

/- The eight relators are checked one at a time; the kernel evaluates each word at every point. -/
private theorem relator0 : a ^ 2 = 1 := ext_point (by decide +kernel)

private theorem relator1 : b ^ 3 = 1 := ext_point (by decide +kernel)

private theorem relator2 : ⁅a⁻¹, b⁻¹⁆ ^ 9 = 1 := ext_point (by decide +kernel)

private theorem relator3 : (a * b) ^ 19 = 1 := ext_point (by decide +kernel)

private theorem relator4 : ((a * b) ^ 6 * (a * b⁻¹) ^ 5) ^ 2 = 1 := ext_point (by decide +kernel)

private theorem relator5 :
    ((a * b * (a * b) * (a * b⁻¹)) ^ 2 * (a * b) * (a * b⁻¹) * (a * b⁻¹) * (a * b) *
      (a * b⁻¹)) ^ 2 = 1 :=
  ext_point (by decide +kernel)

private theorem relator6 :
    a * b * (a * b) * (a * b * (a * b⁻¹)) ^ 3 * (a * b) * (a * b) * (a * b * (a * b⁻¹)) ^ 4 *
      (a * b⁻¹) * (a * b * (a * b⁻¹)) ^ 3 = 1 :=
  ext_point (by decide +kernel)

private theorem relator7 : ((a * b) ^ 3 * (a * b * (a * b⁻¹)) ^ 2) ^ 4 = 1 :=
  ext_point (by decide +kernel)

/-! ### Orders -/

/-- The first generator is an involution. -/
theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime relator0 (DFunLike.ne_iff.mpr ⟨0, by decide +kernel⟩)

/-- The second generator has order three. -/
theorem orderOf_b : orderOf b = 3 :=
  orderOf_eq_prime relator1 (DFunLike.ne_iff.mpr ⟨0, by decide +kernel⟩)

/-- The product of the two generators has order nineteen. -/
theorem orderOf_a_mul_b : orderOf (a * b) = 19 :=
  have : Fact (Nat.Prime 19) := ⟨by decide⟩
  orderOf_eq_prime relator3 (DFunLike.ne_iff.mpr ⟨0, by decide +kernel⟩)

/-! ### The assignment and the surjection -/

/-- The images in the permutation model of the generators of the presentation of `J₃`: `a` for
the generator of index `0` and `b` for the generator of index `1`. -/
def presentationImage (i : Fin SporadicName.J3.presentation.generatorCount) :
    Equiv.Perm (Fin 6156) :=
  if (i : ℕ) = 0 then a else b

/-- The assignment unfolded: `a` at index `0` and `b` otherwise. -/
theorem presentationImage_def (i : Fin SporadicName.J3.presentation.generatorCount) :
    presentationImage i = if (i : ℕ) = 0 then a else b :=
  (rfl)

/-- The generator of index `0` goes to `a`. -/
@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.J3.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = a := by
  simp [presentationImage]

/-- The generator of index `1` goes to `b`. -/
@[simp]
theorem presentationImage_one (h : 1 < SporadicName.J3.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = b := by
  simp [presentationImage]

/-- The assignment has precisely the two generators of the model as its values. -/
theorem range_presentationImage : Set.range presentationImage = {a, b} := by
  have h : SporadicName.J3.presentation.generatorCount = 2 := by simp
  exact Set.range_ite_const ⟨⟨0, by omega⟩, rfl⟩ ⟨⟨1, by omega⟩, one_ne_zero⟩

/-- **The relators of `J₃` hold in the model.** All eight transcribed relators of the presentation
of `J₃` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.J3.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.J3.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_J3`.
  suffices key : ∀ P : GroupPresentation, P = j3Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then a else b)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_J3
  rintro P rfl
  simp only [j3Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  exact ⟨relator0, relator1, relator2, relator3, relator4, relator5, relator6, relator7⟩

/-- **The images generate the model.** The subgroup generated by the images of the presentation
generators is the permutation model `J3`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = J3 := by
  rw [range_presentationImage, J3_def]

/-- The homomorphism from the group presented by the presentation of `J₃` to
`Equiv.Perm (Fin 6156)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.J3.Group →* Equiv.Perm (Fin 6156) :=
  SporadicName.J3.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

/-- The homomorphism unfolded: the extension of `presentationImage` given by
`GroupPresentation.homEquiv`. -/
theorem presentationHom_def :
    presentationHom = SporadicName.J3.presentation.homEquiv.symm
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

/-- The homomorphism sends each generator of the presented group to its chosen image. -/
@[simp]
theorem presentationHom_of (i : Fin SporadicName.J3.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `J3`. -/
theorem range_presentationHom : presentationHom.range = J3 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end J3

/-- **The presented group of `J₃` maps onto the permutation model.** The group defined by the
presentation of `J₃` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `J3`. -/
theorem exists_surjective_J3 :
    ∃ f : SporadicName.J3.Group →* J3, Function.Surjective f :=
  SporadicName.J3.presentation.exists_surjective_of_closure_range_eq
    ⟨J3.presentationImage, J3.lift_presentationImage_toFreeGroup_eq_one⟩
    J3.closure_range_presentationImage

/-- The permutation model `J3` is nontrivial: it contains the involution `J3.a`. -/
instance : Nontrivial J3 :=
  J3.nontrivial_iff_exists_ne_one.2
    ⟨J3.a, J3.a_mem, fun h ↦ by simpa [h] using J3.orderOf_a⟩

/-- The group presented by the presentation of `J₃` is nontrivial, since it maps onto the
nontrivial permutation model `J3`. -/
instance : Nontrivial SporadicName.J3.Group :=
  exists_surjective_J3.choose_spec.nontrivial

end TauCeti.Sporadic
