module

public import TauCeti.GroupTheory.GroupAction.Simple.Basic
public import TauCeti.GroupTheory.IsPerfect
public import TauCeti.GroupTheory.SpecificGroups.Sporadic.Mathieu.TwentyThree.Basic
public import TauCeti.GroupTheory.Subgroup.NormalGeneration

/-!
# Perfectness and simplicity of the permutation model of `M₂₃`

The canonical permutation model `TauCeti.Sporadic.M23` of the Mathieu group `M₂₃`, generated by
the two ATLAS permutations `a` and `b` of `Fin 23`, is perfect and simple.

The orders `2`, `4` and `23` of `a`, `b` and `a * b` are not pairwise coprime, so perfectness is
read off from another pair of generators: `a` and `c = a⁻¹ * (a * b) ^ 4`, whose product is
`(a * b) ^ 4`. The element `c` has order dividing `15`, which is checked on the `23` points, and
the pair generates the model because `a * b`, whose order `23` is coprime to `4`, is a power of
`(a * b) ^ 4`, and `b = a⁻¹ * (a * b)`. As `2`, `15` and `23` are pairwise coprime, every
homomorphism from the model to a commutative group is trivial
(`TauCeti.isPerfect_of_coprime_pow_eq_one`). In a perfect group generated by two elements, their
product is a normal generator (`Subgroup.normalClosure_singleton_mul_eq_top`), so the normal
closure of `a * b` is the whole model.

Simplicity then follows from `TauCeti.isSimpleGroup_of_normalClosure_eq_top_of_prime_card`: the
model acts faithfully and transitively on the prime number `23` of points, `23 ^ 2` does not
divide its order `10200960`, and the element `a * b` of order `23` normally generates it. This
file concerns the permutation model, not the abstract presentation
`TauCeti.SporadicName.M23.Group`.

## Main results

* `TauCeti.Sporadic.isPerfect_M23`: the permutation model of `M₂₃` is perfect.
* `TauCeti.Sporadic.M23.normalClosure_a_mul_b_eq_top`: the element `a * b` of order `23`
  normally generates the model.
* `TauCeti.Sporadic.isSimpleGroup_M23`: the permutation model of `M₂₃` is simple.

## References

* J. D. Dixon and B. Mortimer, *Permutation Groups*, Graduate Texts in Mathematics 163, Springer,
  1996, §1.6, for normal subgroups of primitive permutation groups.
* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `M23G1-p23B0`, <https://brauer.maths.qmul.ac.uk/Atlas/v3/>, for the
  generators documented in the basic module.
-/

public section

namespace TauCeti.Sporadic

namespace M23

/-- The element `a⁻¹ * (a * b) ^ 4` of the model has order dividing `15`. -/
private theorem inv_a_mul_pow_four_pow_fifteen : (a⁻¹ * (a * b) ^ 4) ^ 15 = 1 := by
  rw [a_def, b_def]
  decide +kernel

/-- The copy of `a * b` in the carrier of the model has `23`-rd power `1`. -/
private theorem mk_a_mul_b_pow : (⟨a * b, mul_mem a_mem b_mem⟩ : M23) ^ 23 = 1 :=
  orderOf_dvd_iff_pow_eq_one.mp (by rw [Subgroup.orderOf_mk, orderOf_a_mul_b])

/-- The model is generated by `a` and `a⁻¹ * (a * b) ^ 4`, whose product is `(a * b) ^ 4`: a
pair of generators with the pairwise coprime orders `2`, `15` and `23`. -/
private theorem closure_coprime_pair_eq_top :
    Subgroup.closure
      ({⟨a, a_mem⟩, ⟨a, a_mem⟩⁻¹ * (⟨a, a_mem⟩ * ⟨b, b_mem⟩) ^ 4} : Set M23) = ⊤ := by
  have hcop : Nat.gcd 4 (orderOf ((⟨a, a_mem⟩ : M23) * ⟨b, b_mem⟩)) = 1 := by
    rw [MulMemClass.mk_mul_mk, Subgroup.orderOf_mk, orderOf_a_mul_b]
    norm_num
  set x : M23 := ⟨a, a_mem⟩
  set y : M23 := ⟨b, b_mem⟩
  set C := Subgroup.closure ({x, x⁻¹ * (x * y) ^ 4} : Set M23)
  have hx : x ∈ C := Subgroup.subset_closure (by simp)
  have hpow : (x * y) ^ 4 ∈ C := by
    have h := mul_mem hx (Subgroup.subset_closure (by simp) : x⁻¹ * (x * y) ^ 4 ∈ C)
    rwa [mul_inv_cancel_left] at h
  -- `a * b` has order `23`, which is coprime to `4`, so it is a power of `(a * b) ^ 4`.
  have hxy : x * y ∈ C := Subgroup.zpowers_le.mpr hpow (mem_zpowers_pow_iff.mpr hcop)
  rw [eq_top_iff, ← closure_pair_eq_top, Subgroup.closure_le]
  rintro _ (rfl | rfl)
  · exact hx
  · have h := mul_mem (inv_mem hx) hxy
    rwa [inv_mul_cancel_left] at h

end M23

/-- **The permutation model of `M₂₃` is perfect.** -/
instance isPerfect_M23 : Group.IsPerfect M23 :=
  isPerfect_of_coprime_pow_eq_one (a := 2) (b := 15) (c := 23) M23.closure_coprime_pair_eq_top
    (orderOf_dvd_iff_pow_eq_one.mp (by simp [Subgroup.orderOf_mk, M23.orderOf_a]))
    (Subtype.ext M23.inv_a_mul_pow_four_pow_fifteen)
    (by rw [mul_inv_cancel_left, MulMemClass.mk_mul_mk, ← pow_mul, mul_comm, pow_mul,
      M23.mk_a_mul_b_pow, one_pow])
    (by decide) (by decide) (by decide)

namespace M23

/-- The element `a * b` of order `23` generates the model as a normal subgroup. -/
theorem normalClosure_a_mul_b_eq_top :
    Subgroup.normalClosure {(⟨a * b, mul_mem a_mem b_mem⟩ : M23)} = ⊤ := by
  simpa only [MulMemClass.mk_mul_mk] using
    Subgroup.normalClosure_singleton_mul_eq_top (⟨a, a_mem⟩ : M23) ⟨b, b_mem⟩ closure_pair_eq_top

end M23

/-- **The canonical `23`-point permutation model of `M₂₃` is simple.** -/
instance isSimpleGroup_M23 : IsSimpleGroup M23 :=
  isSimpleGroup_of_normalClosure_eq_top_of_prime_card (X := Fin 23)
    (by simpa using (by decide : Nat.Prime 23)) (by rw [card_M23]; norm_num) _
    (by rw [Nat.card_eq_fintype_card, Fintype.card_fin]; exact M23.mk_a_mul_b_pow)
    M23.normalClosure_a_mul_b_eq_top

end TauCeti.Sporadic
