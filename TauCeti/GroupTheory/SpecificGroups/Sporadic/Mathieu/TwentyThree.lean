/-!
# The permutation model of `M₂₃`, its order, and the surjection from its presented group

This file defines the permutation model `TauCeti.Sporadic.M23` of the Mathieu group `M₂₃`: the
subgroup of `Equiv.Perm (Fin 23)` generated by the two permutations `M23.a` and `M23.b` of the
ATLAS files `M23G1-p23B0.m1` and `M23G1-p23B0.m2`. The files list the images of the points
`1, …, 23`; the point `i` of a file is the point `i - 1` of `Fin 23`, and each generator is written
as the product of its disjoint cycles in Mathlib's cycle notation. In the files' numbering,

```text
a = (1,2)(3,4)(7,8)(9,10)(13,14)(15,16)(19,20)(21,22),
b = (1,16,11,3)(2,9,21,12)(4,5,8,23)(6,22,14,18)(13,20)(15,17).
```

So `a` is an involution with seven fixed points and `b` has order `4` with three fixed points; the
orders `2`, `4` and `23` of `a`, `b` and `a * b` are recorded as a check on the transcription.
Reading the files as preimages instead of images would replace `b` by `b⁻¹`, which sends `0` to `2`
rather than `15`.

It then shows that the ATLAS presentation `M23G1-P1` carried by `TauCeti.SporadicName.presentation`
holds in the model. The presentation writes products left-to-right, whereas `Equiv.Perm` composes
permutations right-to-left (`(σ * τ) i = σ (τ i)`): at `(a, b)` the seventh transcribed relator
sends `0` to `16`, while sending index `0` to `a` and index `1` to `b⁻¹` makes all nine transcribed
relators evaluate to `1`. Since `{a, b⁻¹}` and `{a, b}` generate the same subgroup, extending this
assignment gives a homomorphism from `TauCeti.SporadicName.M23.Group` whose range is `M23`, hence a
surjection onto `M23`; in particular both `M23` and the presented group are nontrivial.

Finally it computes the order of the model, `10200960 = 2⁷ · 3² · 5 · 7 · 11 · 23`. Along the base
`0, 1, 2, 3, 4, 5` the model has basic orbits of lengths `23`, `22`, `21`, `20`, `3` and `16`: the
first four are those of a `4`-transitive group, and the pointwise stabilizer of `0, 1, 2, 3` has
order `48`, with an orbit of length `3` on `{4, 10, 16}` (completing `{0, 1, 2, 3}` to a heptad of
the Steiner system `S(4, 7, 23)`) and a regular orbit of length `16` on the remaining points when
`4` is also fixed. Only the identity of the model fixes all six base points, so `0, 1, 2, 3, 4, 5`
is a base and the order of `M23` is the product `23 * 22 * 21 * 20 * 3 * 16 = 10200960` of its
basic-orbit lengths. Through the surjection, the presented group has at least `10200960` elements
whenever it is finite.

## Main declarations

* `TauCeti.Sporadic.M23`: the permutation model of `M₂₃` on `23` points.
* `TauCeti.Sporadic.M23.presentationImage`: the images `a` and `b⁻¹` of the presentation
  generators.
* `TauCeti.Sporadic.M23.lift_presentationImage_toFreeGroup_eq_one`: all nine transcribed relators
  of the presentation of `M₂₃` evaluate to `1` at these images.
* `TauCeti.Sporadic.M23.closure_range_presentationImage`: the images generate the model.
* `TauCeti.Sporadic.M23.presentationHom`: the homomorphism from the presented group.
* `TauCeti.Sporadic.exists_surjective_M23`: the presented group maps onto the model.
* `TauCeti.Sporadic.card_M23`: the model has `10200960` elements.
* `TauCeti.Sporadic.M23.stabilizerChain_six_eq_bot`: the points `0, 1, 2, 3, 4, 5` form a base.
* `TauCeti.Sporadic.M23.isPretransitive`: the model acts transitively on the `23` points.
* `TauCeti.Sporadic.le_natCard_group_M23`: the presented group, when finite, has at least
  `10200960` elements.

## References

* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `M23G1-p23B0` and presentation `M23G1-P1`,
  <https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/M23G1-p23B0> and
  <https://brauer.maths.qmul.ac.uk/Atlas/v3/pres/M23G1-P1>; generator image files
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/M23/mtx/M23G1-p23B0.m1> and
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/M23/mtx/M23G1-p23B0.m2>.
* C. C. Sims, *Computational methods in the study of permutation groups*, in *Computational
  Problems in Abstract Algebra* (Oxford, 1967), Pergamon, Oxford, 1970, pp. 169–183.
* Á. Seress, *Permutation Group Algorithms*, Cambridge Tracts in Mathematics 152, Cambridge
  University Press, 2003, §4.1–§4.2.
-/

public section

namespace TauCeti.Sporadic

/-- The first generator of the permutation model of `M₂₃`, from the ATLAS file `M23G1-p23B0.m1`:
the involution `(1,2)(3,4)(7,8)(9,10)(13,14)(15,16)(19,20)(21,22)` of the file, shifted to the
points `0, …, 22`. -/
def M23.a : Equiv.Perm (Fin 23) :=
  c[0, 1] * c[2, 3] * c[6, 7] * c[8, 9] * c[12, 13] * c[14, 15] * c[18, 19] * c[20, 21]

/-- The second generator of the permutation model of `M₂₃`, from the ATLAS file `M23G1-p23B0.m2`:
the permutation `(1,16,11,3)(2,9,21,12)(4,5,8,23)(6,22,14,18)(13,20)(15,17)` of order `4` of the
file, shifted to the points `0, …, 22`. -/
def M23.b : Equiv.Perm (Fin 23) :=
  c[0, 15, 10, 2] * c[1, 8, 20, 11] * c[3, 4, 7, 22] * c[5, 21, 13, 17] * c[12, 19] * c[14, 16]

/-- The permutation model of the Mathieu group `M₂₃`: the subgroup of `Equiv.Perm (Fin 23)`
generated by the permutations `M23.a` and `M23.b` of the ATLAS files `M23G1-p23B0.m1` and
`M23G1-p23B0.m2`. -/
def M23 : Subgroup (Equiv.Perm (Fin 23)) := Subgroup.closure {M23.a, M23.b}

/-- The permutation model `M23` as the subgroup generated by `M23.a` and `M23.b`. -/
theorem M23_def : M23 = Subgroup.closure {M23.a, M23.b} :=
  (rfl)

namespace M23

theorem a_def :
    a = c[0, 1] * c[2, 3] * c[6, 7] * c[8, 9] * c[12, 13] * c[14, 15] * c[18, 19] * c[20, 21] :=
  (rfl)

theorem b_def :
    b = c[0, 15, 10, 2] * c[1, 8, 20, 11] * c[3, 4, 7, 22] * c[5, 21, 13, 17] * c[12, 19] *
      c[14, 16] :=
  (rfl)

theorem a_mem : a ∈ M23 := M23_def ▸ Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ M23 := M23_def ▸ Subgroup.subset_closure (by simp)

/-- The generator `M23.a`, given by its table of images; it is an involution. -/
private def aTable : Equiv.Perm (Fin 23) where
  toFun := ![1, 0, 3, 2, 4, 5, 7, 6, 9, 8, 10, 11, 13, 12, 15, 14, 16, 17, 19, 18, 21, 20, 22]
  invFun := ![1, 0, 3, 2, 4, 5, 7, 6, 9, 8, 10, 11, 13, 12, 15, 14, 16, 17, 19, 18, 21, 20, 22]
  left_inv := by decide
  right_inv := by decide

/-- The generator `M23.b`, given by its tables of images and inverse images. -/
private def bTable : Equiv.Perm (Fin 23) where
  toFun := ![15, 8, 0, 4, 7, 21, 6, 22, 20, 9, 2, 1, 19, 17, 16, 10, 14, 5, 18, 12, 11, 13, 3]
  invFun := ![2, 11, 10, 22, 3, 17, 6, 4, 1, 9, 15, 20, 19, 21, 16, 0, 14, 13, 18, 12, 8, 5, 7]
  left_inv := by decide
  right_inv := by decide

private theorem aTable_eq : aTable = a := by decide +kernel

private theorem bTable_eq : bTable = b := by decide +kernel

/-! ### Generator orders -/

/- The equations between explicit permutations of `Fin 23` in this file are closed by
`decide +kernel`: the elaborator's `decide` exhausts its recursion depth while evaluating
`Cycle.formPerm`, while the kernel checks each of them directly. -/

theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_b : orderOf b = 4 :=
  orderOf_eq_prime_pow (p := 2) (n := 1) (by decide +kernel) (by decide +kernel)

theorem orderOf_a_mul_b : orderOf (a * b) = 23 :=
  have : Fact (Nat.Prime 23) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### The presentation of `M₂₃` holds in the model -/

/-- The images in the permutation model of the generators of the presentation of `M₂₃`: `a` for
the generator of index `0` and `b⁻¹` for the generator of index `1`. -/
def presentationImage (i : Fin SporadicName.M23.presentation.generatorCount) :
    Equiv.Perm (Fin 23) :=
  if (i : ℕ) = 0 then a else b⁻¹

theorem presentationImage_def (i : Fin SporadicName.M23.presentation.generatorCount) :
    presentationImage i = if (i : ℕ) = 0 then a else b⁻¹ :=
  (rfl)

@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.M23.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = a := by
  simp [presentationImage]

@[simp]
theorem presentationImage_one (h : 1 < SporadicName.M23.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = b⁻¹ := by
  simp [presentationImage]

theorem range_presentationImage : Set.range presentationImage = {a, b⁻¹} := by
  have h : SporadicName.M23.presentation.generatorCount = 2 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    by_cases hi : (i : ℕ) = 0 <;> simp [presentationImage, hi]
  · rintro (rfl | rfl)
    · exact ⟨⟨0, by omega⟩, presentationImage_zero _⟩
    · exact ⟨⟨1, by omega⟩, presentationImage_one _⟩

/-- **The relators of `M₂₃` hold in the model.** All nine transcribed relators of the
presentation of `M₂₃` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.M23.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.M23.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_M23`.
  suffices key : ∀ P : GroupPresentation, P = m23Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then a else b⁻¹)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_M23
  rintro P rfl
  simp only [m23Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, one_ne_zero, ↓reduceIte, ← aTable_eq,
    ← bTable_eq]
  decide +kernel

/-- **The images generate the model.** The subgroup generated by the images `a` and `b⁻¹` of the
presentation generators is the permutation model `M23`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = M23 := by
  rw [range_presentationImage, M23_def, Set.insert_eq, Set.insert_eq, Subgroup.closure_union,
    Subgroup.closure_union, Subgroup.closure_singleton_inv]

/-- The homomorphism from the group presented by the presentation of `M₂₃` to
`Equiv.Perm (Fin 23)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.M23.Group →* Equiv.Perm (Fin 23) :=
  SporadicName.M23.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

theorem presentationHom_def :
    presentationHom = SporadicName.M23.presentation.homEquiv.symm
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

@[simp]
theorem presentationHom_of (i : Fin SporadicName.M23.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `M23`. -/
theorem range_presentationHom : presentationHom.range = M23 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end M23

/-- **The presented group of `M₂₃` maps onto the permutation model.** The group defined by the
presentation of `M₂₃` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `M23`. -/
theorem exists_surjective_M23 :
    ∃ f : SporadicName.M23.Group →* M23, Function.Surjective f :=
  SporadicName.M23.presentation.exists_surjective_of_closure_range_eq
    ⟨M23.presentationImage, M23.lift_presentationImage_toFreeGroup_eq_one⟩
    M23.closure_range_presentationImage

/-- The permutation model `M23` is nontrivial: it contains the involution `M23.a`. -/
instance : Nontrivial M23 :=
  M23.nontrivial_iff_exists_ne_one.2 ⟨M23.a, M23.a_mem, by decide +kernel⟩

/-- The group presented by the presentation of `M₂₃` is nontrivial, since it maps onto the
nontrivial permutation model `M23`. -/
instance : Nontrivial SporadicName.M23.Group :=
  exists_surjective_M23.choose_spec.nontrivial

/-! ### The order of the model -/

namespace M23

/- The kernel evaluates a permutation given by its tables of images and inverse images much faster
than a product of cycles or a long word, so the sifting computations below reuse `aTable` and
`bTable` together with twelve further elements of `M23` fixing initial segments of `0, 1, 2, 3, 4`.
Each table is checked once to be a word in the tables of earlier levels, and every transversal
representative is a product of at most three tables and their inverses. -/

/-- An involution of `M23` fixing `0`, given by its table of images; by `g1_eq` it is a word in
`aTable` and `bTable`. -/
private def g1 : Equiv.Perm (Fin 23) where
  toFun := ![0, 4, 2, 3, 1, 5, 6, 22, 21, 14, 16, 12, 11, 19, 9, 15, 10, 18, 17, 13, 20, 8, 7]
  invFun := ![0, 4, 2, 3, 1, 5, 6, 22, 21, 14, 16, 12, 11, 19, 9, 15, 10, 18, 17, 13, 20, 8, 7]
  left_inv := by decide
  right_inv := by decide

/-- A permutation of `M23` fixing `0`, given by its tables of images and inverse images; by `h1_eq`
it is a word in `aTable` and `bTable`. -/
private def h1 : Equiv.Perm (Fin 23) where
  toFun := ![0, 5, 1, 4, 7, 2, 10, 11, 18, 19, 6, 14, 21, 8, 15, 3, 22, 20, 13, 17, 16, 12, 9]
  invFun := ![0, 2, 5, 15, 3, 1, 10, 4, 13, 22, 6, 7, 21, 18, 11, 14, 20, 19, 8, 9, 17, 12, 16]
  left_inv := by decide
  right_inv := by decide

/-- An involution of `M23` fixing `0, 1`, given by its table of images; by `g2_eq` it is a word in
`g1` and `h1`. -/
private def g2 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 3, 2, 16, 5, 20, 21, 19, 18, 10, 22, 13, 12, 14, 15, 4, 17, 9, 8, 6, 7, 11]
  invFun := ![0, 1, 3, 2, 16, 5, 20, 21, 19, 18, 10, 22, 13, 12, 14, 15, 4, 17, 9, 8, 6, 7, 11]
  left_inv := by decide
  right_inv := by decide

/-- A permutation of `M23` fixing `0, 1`, given by its tables of images and inverse images; by
`h2_eq` it is a word in `g1` and `h1`. -/
private def h2 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 9, 2, 15, 7, 11, 18, 16, 12, 22, 8, 20, 14, 4, 5, 21, 6, 13, 17, 10, 19, 3]
  invFun := ![0, 1, 3, 22, 14, 15, 17, 5, 11, 2, 20, 6, 9, 18, 13, 4, 8, 19, 7, 21, 12, 16, 10]
  left_inv := by decide
  right_inv := by decide

/-- A permutation of `M23` fixing `0, 1, 2`, given by its tables of images and inverse images; by
`g3_eq` it is a word in `g2` and `h2`. -/
private def g3 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 11, 14, 15, 17, 5, 22, 3, 6, 20, 18, 9, 12, 16, 19, 8, 21, 7, 13, 4, 10]
  invFun := ![0, 1, 2, 9, 21, 7, 10, 19, 17, 13, 22, 3, 14, 20, 4, 5, 15, 6, 12, 16, 11, 18, 8]
  left_inv := by decide
  right_inv := by decide

/-- A permutation of `M23` fixing `0, 1, 2`, given by its tables of images and inverse images; by
`h3_eq` it is a word in `g2` and `h2`. -/
private def h3 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 16, 4, 22, 5, 7, 15, 19, 3, 13, 17, 21, 8, 14, 10, 20, 9, 18, 12, 11, 6]
  invFun := ![0, 1, 2, 10, 4, 6, 22, 7, 14, 18, 16, 21, 20, 11, 15, 8, 3, 12, 19, 9, 17, 13, 5]
  left_inv := by decide
  right_inv := by decide

/-- A permutation of `M23` of order `3` fixing `0, 1, 2, 3`, given by its tables of images and
inverse images; by `g4_eq` it is a word in `g3` and `h3`. -/
private def g4 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 10, 18, 9, 6, 8, 7, 16, 21, 11, 5, 22, 17, 4, 19, 13, 15, 14, 12, 20]
  invFun := ![0, 1, 2, 3, 16, 13, 7, 9, 8, 6, 4, 12, 21, 18, 20, 19, 10, 15, 5, 17, 22, 11, 14]
  left_inv := by decide
  right_inv := by decide

/-- An involution of `M23` fixing `0, 1, 2, 3, 4`, given by its table of images; by `g5_eq` it is a
word in `h3` and `g4`. -/
private def g5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 13, 19, 20, 18, 21, 10, 14, 17, 5, 11, 22, 16, 12, 8, 6, 7, 9, 15]
  invFun := ![0, 1, 2, 3, 4, 13, 19, 20, 18, 21, 10, 14, 17, 5, 11, 22, 16, 12, 8, 6, 7, 9, 15]
  left_inv := by decide
  right_inv := by decide

/-- An involution of `M23` fixing `0, 1, 2, 3, 4`, given by its table of images; by `h5_eq` it is a
word in `h3` and `g4`. -/
private def h5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 8, 11, 17, 5, 22, 10, 6, 20, 18, 19, 21, 16, 7, 13, 14, 12, 15, 9]
  invFun := ![0, 1, 2, 3, 4, 8, 11, 17, 5, 22, 10, 6, 20, 18, 19, 21, 16, 7, 13, 14, 12, 15, 9]
  left_inv := by decide
  right_inv := by decide

/-- An involution of `M23` fixing `0, 1, 2, 3, 4`, given by its table of images; by `j5_eq` it is a
word in `g3`, `h3` and `g4`. -/
private def j5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 11, 8, 9, 6, 7, 10, 5, 15, 14, 13, 12, 16, 22, 19, 18, 21, 20, 17]
  invFun := ![0, 1, 2, 3, 4, 11, 8, 9, 6, 7, 10, 5, 15, 14, 13, 12, 16, 22, 19, 18, 21, 20, 17]
  left_inv := by decide
  right_inv := by decide

/-- An involution of `M23` fixing `0, 1, 2, 3, 4`, given by its table of images; by `k5_eq` it is a
word in `g3`, `h3` and `g4`. -/
private def k5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 12, 21, 18, 20, 19, 10, 15, 5, 17, 22, 11, 16, 13, 7, 9, 8, 6, 14]
  invFun := ![0, 1, 2, 3, 4, 12, 21, 18, 20, 19, 10, 15, 5, 17, 22, 11, 16, 13, 7, 9, 8, 6, 14]
  left_inv := by decide
  right_inv := by decide

/-- The product `g5 * h5 * j5 * k5` fixing `0, 1, 2, 3, 4`, given by its table of images so every
representative of `transversal 5` is a product of at most two tables. -/
private def m5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 9, 17, 11, 22, 5, 10, 7, 19, 21, 20, 18, 16, 6, 15, 12, 14, 13, 8]
  invFun := ![0, 1, 2, 3, 4, 9, 17, 11, 22, 5, 10, 7, 19, 21, 20, 18, 16, 6, 15, 12, 14, 13, 8]
  left_inv := by decide
  right_inv := by decide

private theorem g1_eq : g1 = aTable * bTable * aTable * bTable⁻¹ * aTable := by
  decide +kernel

private theorem h1_eq : h1 = bTable⁻¹ * aTable * bTable * aTable * bTable * aTable * bTable := by
  decide +kernel

private theorem g2_eq : g2 = h1⁻¹ * g1 * h1 := by
  decide +kernel

private theorem h2_eq : h2 = h1 * g1 * h1 * g1 * h1 := by
  decide +kernel

private theorem g3_eq : g3 = g2 * h2⁻¹ := by
  decide +kernel

private theorem h3_eq : h3 = h2⁻¹ * g2 * h2⁻¹ * g2 * h2 * h2 := by
  decide +kernel

private theorem g4_eq : g4 = g3 * g3 * h3 * g3 := by
  decide +kernel

private theorem g5_eq : g5 = h3 * g4⁻¹ * h3 * g4⁻¹ := by
  decide +kernel

private theorem h5_eq : h5 = h3⁻¹ * g4 * h3⁻¹ * g4 := by
  decide +kernel

private theorem j5_eq : j5 = g3 * g4 * h3 * g3⁻¹ * h3⁻¹ := by
  decide +kernel

private theorem k5_eq : k5 = g3 * h3⁻¹ * g4⁻¹ * g3⁻¹ * h3 := by
  decide +kernel

private theorem m5_eq : m5 = g5 * h5 * j5 * k5 := by
  decide +kernel

/-- The fourteen tables lie in `M23`. -/
private theorem tables_mem :
    aTable ∈ M23 ∧ bTable ∈ M23 ∧ g1 ∈ M23 ∧ h1 ∈ M23 ∧ g2 ∈ M23 ∧ h2 ∈ M23 ∧ g3 ∈ M23 ∧
      h3 ∈ M23 ∧ g4 ∈ M23 ∧ g5 ∈ M23 ∧ h5 ∈ M23 ∧ j5 ∈ M23 ∧ k5 ∈ M23 ∧ m5 ∈ M23 := by
  have ha : aTable ∈ M23 := aTable_eq ▸ a_mem
  have hb : bTable ∈ M23 := bTable_eq ▸ b_mem
  have hg1 : g1 ∈ M23 := by
    simp only [g1_eq, mul_mem_cancel_right ha, mul_mem_cancel_right hb,
      mul_mem_cancel_right (inv_mem hb), ha]
  have hh1 : h1 ∈ M23 := by
    simp only [h1_eq, mul_mem_cancel_right ha, mul_mem_cancel_right hb, inv_mem_iff, hb]
  have hg2 : g2 ∈ M23 := by
    simp only [g2_eq, mul_mem_cancel_right hg1, mul_mem_cancel_right hh1, inv_mem_iff, hh1]
  have hh2 : h2 ∈ M23 := by
    simp only [h2_eq, mul_mem_cancel_right hg1, mul_mem_cancel_right hh1, hh1]
  have hg3 : g3 ∈ M23 := by
    simp only [g3_eq, mul_mem_cancel_right (inv_mem hh2), hg2]
  have hh3 : h3 ∈ M23 := by
    simp only [h3_eq, mul_mem_cancel_right hg2, mul_mem_cancel_right hh2,
      mul_mem_cancel_right (inv_mem hh2), inv_mem_iff, hh2]
  have hg4 : g4 ∈ M23 := by
    simp only [g4_eq, mul_mem_cancel_right hg3, mul_mem_cancel_right hh3, hg3]
  have hg5 : g5 ∈ M23 := by
    simp only [g5_eq, mul_mem_cancel_right hh3, mul_mem_cancel_right (inv_mem hg4), hh3]
  have hh5 : h5 ∈ M23 := by
    simp only [h5_eq, mul_mem_cancel_right hg4, mul_mem_cancel_right (inv_mem hh3), inv_mem_iff,
      hh3]
  have hj5 : j5 ∈ M23 := by
    simp only [j5_eq, mul_mem_cancel_right hg4, mul_mem_cancel_right hh3,
      mul_mem_cancel_right (inv_mem hg3), mul_mem_cancel_right (inv_mem hh3), hg3]
  have hk5 : k5 ∈ M23 := by
    simp only [k5_eq, mul_mem_cancel_right hh3, mul_mem_cancel_right (inv_mem hh3),
      mul_mem_cancel_right (inv_mem hg4), mul_mem_cancel_right (inv_mem hg3), hg3]
  have hm5 : m5 ∈ M23 := by
    simp only [m5_eq, mul_mem_cancel_right hh5, mul_mem_cancel_right hj5,
      mul_mem_cancel_right hk5, hg5]
  exact ⟨ha, hb, hg1, hh1, hg2, hh2, hg3, hh3, hg4, hg5, hh5, hj5, hk5, hm5⟩

/-- Representatives along the base `0, 1, 2, 3, 4, 5`: for `i < 6`, the list `transversal i`
consists of elements of `M23`, written as products of at most three of the tables above and their
inverses, that fix `0, …, i - 1` and send `i` to each point of its basic orbit, in increasing
order. -/
private def transversal : ℕ → List (Equiv.Perm (Fin 23))
  | 0 => [1, aTable, bTable⁻¹, aTable * bTable⁻¹, g1 * aTable, g3⁻¹ * bTable, g3 * bTable * bTable,
      bTable * g1 * aTable, bTable * aTable, h2 * bTable⁻¹, bTable * bTable, bTable⁻¹ * aTable,
      j5 * bTable, aTable * j5 * bTable, aTable * bTable, bTable, g3 * bTable, g4 * bTable,
      m5 * bTable, g4⁻¹ * bTable, aTable * h5 * bTable, h5 * bTable, g5 * bTable]
  | 1 => [1, h1⁻¹, h1⁻¹ * g1, g1, h1, h3⁻¹ * h1, g3⁻¹ * h1, h5 * h1, h2 * h1⁻¹, g4 * g1, j5 * h1,
      k5 * h1, g4⁻¹ * h1, g3 * g1, g3 * h1, g2 * g1, g1 * g4 * h1, g4 * h1, g1 * g4⁻¹ * h1,
      g2 * h3⁻¹ * h1, g3⁻¹ * g1, h3 * h1]
  | 2 => [1, g2, g2 * h3 * g2, m5 * h2, g4⁻¹ * h2, g4 * h2, g2 * h3 * h2, h2, h3⁻¹ * g2, g3 * g2,
      h2 * h2, g3⁻¹ * h2, g3⁻¹ * h2 * h2, g3 * m5 * h2, h3 * g2, g3 * g4⁻¹ * h2, g2 * h2,
      h3 * h2, g2 * g4⁻¹ * h2, g5 * h2, h2⁻¹ * g2]
  | 3 => [1, g4 * h3, j5 * g3, g3 * h3⁻¹, g4 * g3⁻¹, g3⁻¹ * g3⁻¹ * h3⁻¹, g3⁻¹, h3⁻¹, g3,
      g4⁻¹ * g3, g3⁻¹ * g3⁻¹, g5 * g3, g3⁻¹ * h3, h3, g3 * g3 * h3⁻¹, h3⁻¹ * g3⁻¹, g3 * h3,
      g3 * g3, g4 * g3, g3⁻¹ * h3⁻¹]
  | 4 => [1, g4, g4⁻¹]
  | 5 => [1, h5 * j5, j5 * m5, h5, m5, j5, k5, g5, g5 * j5, j5 * k5, g5 * k5, g5 * h5, k5 * m5,
      h5 * k5, g5 * m5, h5 * m5]
  | _ => []

private theorem mem_transversal : ∀ i < 6, ∀ r ∈ transversal i, r ∈ M23 := by
  obtain ⟨ha, hb, hg1, hh1, hg2, hh2, hg3, hh3, hg4, hg5, hh5, hj5, hk5, hm5⟩ := tables_mem
  intro i hi
  interval_cases i <;>
  simp only [transversal, List.forall_mem_cons, List.not_mem_nil, IsEmpty.forall_iff,
    implies_true, and_true, mul_mem_cancel_right ha, mul_mem_cancel_right hb,
    mul_mem_cancel_right (inv_mem hb), mul_mem_cancel_right hg1, mul_mem_cancel_right hh1,
    mul_mem_cancel_right (inv_mem hh1), mul_mem_cancel_right hg2, mul_mem_cancel_right hh2,
    mul_mem_cancel_right hg3, mul_mem_cancel_right (inv_mem hg3), mul_mem_cancel_right hh3,
    mul_mem_cancel_right (inv_mem hh3), mul_mem_cancel_right hg4,
    mul_mem_cancel_right (inv_mem hg4), mul_mem_cancel_right hh5, mul_mem_cancel_right hj5,
    mul_mem_cancel_right hk5, mul_mem_cancel_right hm5, inv_mem_iff, one_mem, ha, hb, hg1, hh1,
    hg2, hh2, hg3, hh3, hg4, hg5, hh5, hj5, hk5, hm5]

private theorem le_closure_tables : M23 ≤ Subgroup.closure {g | g ∈ [aTable, bTable]} := by
  rw [M23_def, aTable_eq, bTable_eq]
  exact Subgroup.closure_mono (by simp [Set.insert_subset_iff])

private theorem transversalCheck_eq_true :
    TauCeti.transversalCheck (Fin.ofNat 23) transversal 6 = true := by
  decide +kernel

private theorem sift_tables :
    [aTable, bTable].all (TauCeti.sift (Fin.ofNat 23) transversal 0 6 1) = true := by
  decide +kernel

/- Split the sifting checks by both levels `i` and `j`, so each kernel computation checks only
one pair of transversal lists and keeps its reduction cache small. -/
private def siftPairCheck (i j : ℕ) : Bool :=
  (transversal j).all fun s ↦ (transversal i).all fun r ↦
    TauCeti.sift (Fin.ofNat 23) transversal i (6 - i) 1 (s * r)

private theorem siftPairCheck_def (i j : ℕ) :
    ((transversal j).all fun s ↦ (transversal i).all fun r ↦
      TauCeti.sift (Fin.ofNat 23) transversal i (6 - i) 1 (s * r)) = siftPairCheck i j := rfl

private theorem siftPairCheck_0_0 : siftPairCheck 0 0 = true := by
  decide +kernel

private theorem siftPairCheck_0_1 : siftPairCheck 0 1 = true := by
  decide +kernel

private theorem siftPairCheck_0_2 : siftPairCheck 0 2 = true := by
  decide +kernel

private theorem siftPairCheck_0_3 : siftPairCheck 0 3 = true := by
  decide +kernel

private theorem siftPairCheck_0_4 : siftPairCheck 0 4 = true := by
  decide +kernel

private theorem siftPairCheck_0_5 : siftPairCheck 0 5 = true := by
  decide +kernel

private theorem siftPairCheck_1_1 : siftPairCheck 1 1 = true := by
  decide +kernel

private theorem siftPairCheck_1_2 : siftPairCheck 1 2 = true := by
  decide +kernel

private theorem siftPairCheck_1_3 : siftPairCheck 1 3 = true := by
  decide +kernel

private theorem siftPairCheck_1_4 : siftPairCheck 1 4 = true := by
  decide +kernel

private theorem siftPairCheck_1_5 : siftPairCheck 1 5 = true := by
  decide +kernel

private theorem siftPairCheck_2_2 : siftPairCheck 2 2 = true := by
  decide +kernel

private theorem siftPairCheck_2_3 : siftPairCheck 2 3 = true := by
  decide +kernel

private theorem siftPairCheck_2_4 : siftPairCheck 2 4 = true := by
  decide +kernel

private theorem siftPairCheck_2_5 : siftPairCheck 2 5 = true := by
  decide +kernel

private theorem siftPairCheck_3_3 : siftPairCheck 3 3 = true := by
  decide +kernel

private theorem siftPairCheck_3_4 : siftPairCheck 3 4 = true := by
  decide +kernel

private theorem siftPairCheck_3_5 : siftPairCheck 3 5 = true := by
  decide +kernel

private theorem siftPairCheck_4_4 : siftPairCheck 4 4 = true := by
  decide +kernel

private theorem siftPairCheck_4_5 : siftPairCheck 4 5 = true := by
  decide +kernel

private theorem siftPairCheck_5_5 : siftPairCheck 5 5 = true := by
  decide +kernel

private theorem siftCheck_eq_true :
    ∀ i < 6, TauCeti.siftCheck (Fin.ofNat 23) transversal 6 i = true := by
  intro i hi
  rw [TauCeti.siftCheck, List.all_eq_true]
  intro j hj
  simp only [List.mem_filter, List.mem_range, decide_eq_true_eq] at hj
  rw [siftPairCheck_def]
  obtain ⟨hj, hij⟩ := hj
  interval_cases i <;> interval_cases j
  exacts [siftPairCheck_0_0, siftPairCheck_0_1, siftPairCheck_0_2, siftPairCheck_0_3,
    siftPairCheck_0_4, siftPairCheck_0_5, siftPairCheck_1_1, siftPairCheck_1_2,
    siftPairCheck_1_3, siftPairCheck_1_4, siftPairCheck_1_5, siftPairCheck_2_2,
    siftPairCheck_2_3, siftPairCheck_2_4, siftPairCheck_2_5, siftPairCheck_3_3,
    siftPairCheck_3_4, siftPairCheck_3_5, siftPairCheck_4_4, siftPairCheck_4_5,
    siftPairCheck_5_5]

/-- **The points `0, 1, 2, 3, 4, 5` form a base of `M23`**: no element of `M23` other than `1`
fixes all of them. -/
theorem stabilizerChain_six_eq_bot : M23.stabilizerChain (Fin.ofNat 23) 6 = ⊥ :=
  Subgroup.stabilizerChain_eq_bot_of_siftCheck le_closure_tables
    transversalCheck_eq_true sift_tables siftCheck_eq_true

/-- The model acts transitively on the `23` points. -/
instance isPretransitive : MulAction.IsPretransitive M23 (Fin 23) := by
  have h : ∀ x : Fin 23, ∃ r ∈ transversal 0, r 0 = x := by decide +kernel
  refine MulAction.IsPretransitive.of_orbit (x₀ := 0) fun x ↦ ?_
  obtain ⟨r, hr, hx⟩ := h x
  exact ⟨⟨r, mem_transversal 0 (by decide) r hr⟩,
    by simpa only [Subgroup.mk_smul, Equiv.Perm.smul_def] using hx⟩

end M23

/-- **The order of `M₂₃`.** The permutation model `M23` has
`10200960 = 23 * 22 * 21 * 20 * 3 * 16` elements: along the base `0, 1, 2, 3, 4, 5` its basic
orbits have lengths `23`, `22`, `21`, `20`, `3` and `16`. -/
theorem card_M23 : Nat.card M23 = 10200960 := by
  rw [Subgroup.natCard_eq_prod_length_of_siftCheck M23.mem_transversal M23.le_closure_tables
    M23.transversalCheck_eq_true M23.sift_tables M23.siftCheck_eq_true]
  decide

/-- The group presented by the presentation of `M₂₃`, when finite, has at least `10200960`
elements, since it maps onto the model `M23`. Finiteness is a hypothesis: with the junk value
`Nat.card = 0` for infinite types, a surjection alone gives no lower bound. -/
theorem le_natCard_group_M23 (h : 0 < Nat.card SporadicName.M23.Group) :
    10200960 ≤ Nat.card SporadicName.M23.Group := by
  have := Nat.finite_of_card_ne_zero h.ne'
  obtain ⟨f, hf⟩ := exists_surjective_M23
  exact card_M23 ▸ Nat.card_le_card_of_surjective f hf

end TauCeti.Sporadic
