private def h5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 21, 12, 14, 15, 13, 10, 20, 6, 9, 7, 8, 16, 19, 22, 17, 11, 5, 18]
  invFun := ![0, 1, 2, 3, 4, 21, 12, 14, 15, 13, 10, 20, 6, 9, 7, 8, 16, 19, 22, 17, 11, 5, 18]
  left_inv := by decide
  right_inv := by decide

/-- An involution of `M23` fixing `0, 1, 2, 3, 4`, given by its table of images; by `k5_eq` it is a
word in earlier tables. -/
private def k5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 18, 14, 12, 13, 15, 10, 19, 7, 8, 6, 9, 16, 20, 5, 11, 17, 22, 21]
  invFun := ![0, 1, 2, 3, 4, 18, 14, 12, 13, 15, 10, 19, 7, 8, 6, 9, 16, 20, 5, 11, 17, 22, 21]
  left_inv := by decide
  right_inv := by decide

/-- An involution of `M23` fixing `0, 1, 2, 3, 4`, given by its table of images; by `l5_eq` it is a
word in earlier tables. -/
private def l5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 14, 18, 21, 19, 20, 10, 13, 22, 11, 5, 17, 16, 15, 6, 8, 9, 7, 12]
  invFun := ![0, 1, 2, 3, 4, 14, 18, 21, 19, 20, 10, 13, 22, 11, 5, 17, 16, 15, 6, 8, 9, 7, 12]
  left_inv := by decide
  right_inv := by decide

/-- The product `g5 * h5 * k5 * l5`, an involution fixing `0, 1, 2, 3, 4` given by its table of
images so that every five-point stabilizer representative is a product of at most two tables. -/
private def m5 : Equiv.Perm (Fin 23) where
  toFun := ![0, 1, 2, 3, 4, 20, 15, 13, 12, 14, 10, 21, 8, 7, 9, 6, 16, 18, 17, 22, 5, 11, 19]
  invFun := ![0, 1, 2, 3, 4, 20, 15, 13, 12, 14, 10, 21, 8, 7, 9, 6, 16, 18, 17, 22, 5, 11, 19]
  left_inv := by decide
  right_inv := by decide

private theorem g1_eq : g1 = aTable * bTable * aTable * bTable⁻¹ * aTable := by
  decide +kernel

private theorem h1_eq : h1 = bTable⁻¹ * aTable * bTable * aTable * bTable * aTable * bTable := by
  decide +kernel

private theorem g2_eq : g2 = h1⁻¹ * g1 * h1 := by
  decide +kernel

private theorem h2_eq : h2 = h1 * g1 * h1 * g1 * h1 := by
  decide +kernel

private theorem g3_eq : g3 = h2 * g2 := by
  decide +kernel

private theorem h3_eq : h3 = h2⁻¹ * h2⁻¹ * g2 * h2 * g2 * h2 := by
  decide +kernel

private theorem g4_eq : g4 = g3 * h3 * g3 * g3 := by
  decide +kernel

private theorem g5_eq : g5 = g4 * h3⁻¹ * g4 * h3⁻¹ := by
  decide +kernel

private theorem h5_eq : h5 = g3⁻¹ * g4 * g3 * g4 * h3 * g3 := by
  decide +kernel

private theorem k5_eq : k5 = h3 * g4 * h3⁻¹ * g4 * h3 := by
  decide +kernel

private theorem l5_eq : l5 = h3 * g4 * g3⁻¹ * g4⁻¹ * g3⁻¹ := by
  decide +kernel

private theorem m5_eq : m5 = g5 * h5 * k5 * l5 := by
  decide +kernel

/-- The fourteen tables lie in `M23`. -/
private theorem tables_mem :
    aTable ∈ M23 ∧ bTable ∈ M23 ∧ g1 ∈ M23 ∧ h1 ∈ M23 ∧ g2 ∈ M23 ∧ h2 ∈ M23 ∧ g3 ∈ M23 ∧
      h3 ∈ M23 ∧ g4 ∈ M23 ∧ g5 ∈ M23 ∧ h5 ∈ M23 ∧ k5 ∈ M23 ∧ l5 ∈ M23 ∧ m5 ∈ M23 := by
  have ha : aTable ∈ M23 := aTable_eq ▸ a_mem
  have hb : bTable ∈ M23 := bTable_eq ▸ b_mem
  have hg1 : g1 ∈ M23 := by
    simp only [g1_eq, mul_mem_cancel_right ha, mul_mem_cancel_right (inv_mem hb),
      mul_mem_cancel_right hb, ha]
  have hh1 : h1 ∈ M23 := by
    simp only [h1_eq, mul_mem_cancel_right hb, mul_mem_cancel_right ha, inv_mem_iff, hb]
  have hg2 : g2 ∈ M23 := by
    simp only [g2_eq, mul_mem_cancel_right hh1, mul_mem_cancel_right hg1, inv_mem_iff, hh1]
  have hh2 : h2 ∈ M23 := by
    simp only [h2_eq, mul_mem_cancel_right hh1, mul_mem_cancel_right hg1, hh1]
  have hg3 : g3 ∈ M23 := g3_eq ▸ mul_mem hh2 hg2
  have hh3 : h3 ∈ M23 := by
    simp only [h3_eq, mul_mem_cancel_right hh2, mul_mem_cancel_right hg2,
      mul_mem_cancel_right (inv_mem hh2), inv_mem_iff, hh2]
  have hg4 : g4 ∈ M23 := by
    simp only [g4_eq, mul_mem_cancel_right hg3, mul_mem_cancel_right hh3, hg3]
  have hg5 : g5 ∈ M23 := by
    simp only [g5_eq, mul_mem_cancel_right (inv_mem hh3), mul_mem_cancel_right hg4, hg4]
  have hh5 : h5 ∈ M23 := by
    simp only [h5_eq, mul_mem_cancel_right hg3, mul_mem_cancel_right hh3,
      mul_mem_cancel_right hg4, inv_mem_iff, hg3]
  have hk5 : k5 ∈ M23 := by
    simp only [k5_eq, mul_mem_cancel_right hh3, mul_mem_cancel_right hg4,
      mul_mem_cancel_right (inv_mem hh3), hh3]
  have hl5 : l5 ∈ M23 := by
    simp only [l5_eq, mul_mem_cancel_right (inv_mem hg3), mul_mem_cancel_right (inv_mem hg4),
      mul_mem_cancel_right hg4, hh3]
  have hm5 : m5 ∈ M23 := by
    simp only [m5_eq, mul_mem_cancel_right hl5, mul_mem_cancel_right hk5,
      mul_mem_cancel_right hh5, hg5]
  exact ⟨ha, hb, hg1, hh1, hg2, hh2, hg3, hh3, hg4, hg5, hh5, hk5, hl5, hm5⟩

/-- Representatives along the base `0, 1, 2, 3, 4, 5`: for `i < 6`, the list `transversal i`
consists of elements of `M23`, written as products of at most three of the tables above and their
inverses, that fix `0, …, i - 1` and send `i` to each point of its basic orbit, in increasing
order. -/
private def transversal : ℕ → List (Equiv.Perm (Fin 23))
  | 0 => [1, aTable, bTable⁻¹, aTable * bTable⁻¹, g1 * aTable, h1 * aTable, m5 * bTable,
      aTable * m5 * bTable, bTable * aTable, h2 * bTable⁻¹, bTable * bTable, bTable⁻¹ * aTable,
      bTable * g4 * bTable, bTable * g5 * bTable, aTable * bTable, bTable, g3⁻¹ * bTable,
      g4⁻¹ * bTable, aTable * g4 * bTable, g4 * bTable, aTable * g5 * bTable, g5 * bTable,
      bTable⁻¹ * aTable * bTable⁻¹]
  | 1 => [1, h1⁻¹, h1⁻¹ * g1, g1, h1, h3 * h1, h1 * g1, g5 * h1, h2 * h1⁻¹, g4⁻¹ * g1,
      h1 * h1 * g1, h1 * g3 * g1, g4 * h1, h2⁻¹ * g1, h2 * g1, g2 * g1, g1 * g4⁻¹ * h1,
      g4⁻¹ * h1, g1 * g4 * h1, m5 * h1, g3 * g1, h3⁻¹ * h1]
  | 2 => [1, g2, g2 * h3⁻¹ * g2, h2 * k5 * h2, g4 * h2, g4⁻¹ * h2, g2 * h3⁻¹ * h2, h2, h3 * g2,
      g3⁻¹ * g2, h2 * h2, g3 * h2, m5 * h2, k5 * h2, h3⁻¹ * g2, h2 * h3⁻¹ * h2, g2 * h2,
      h3⁻¹ * h2, l5 * h2, g2 * g4⁻¹ * h2, h2⁻¹ * g2]
  | 3 => [1, g4 * h3, g3 * g3 * h3⁻¹, g3⁻¹ * h3, g4⁻¹ * g3, g3 * g3 * h3, g3, h3, g3⁻¹,
      g4 * g3⁻¹, g3 * g3, m5 * g3, g3 * h3⁻¹, h3⁻¹, g3⁻¹ * g3⁻¹ * h3, h3 * g3, g3⁻¹ * h3⁻¹,
      g3⁻¹ * g3⁻¹, h3 * g3⁻¹, g3 * h3]
  | 4 => [1, g4⁻¹, g4]
  | 5 => [1, k5 * l5, h5 * l5, g5, l5 * m5, h5 * m5, g5 * m5, g5 * k5, l5, g5 * h5, k5 * m5, k5,
      g5 * l5, m5, h5, h5 * k5]
  | _ => []

private theorem mem_transversal : ∀ i < 6, ∀ r ∈ transversal i, r ∈ M23 := by
  obtain ⟨ha, hb, hg1, hh1, hg2, hh2, hg3, hh3, hg4, hg5, hh5, hk5, hl5, hm5⟩ := tables_mem
  intro i hi
  interval_cases i <;>
    simp only [transversal, List.forall_mem_cons, List.not_mem_nil, IsEmpty.forall_iff,
      implies_true, and_true, mul_mem_cancel_right ha, mul_mem_cancel_right hb,
      mul_mem_cancel_right (inv_mem hb), mul_mem_cancel_right hg1, mul_mem_cancel_right hh1,
      mul_mem_cancel_right (inv_mem hh1), mul_mem_cancel_right hg2, mul_mem_cancel_right hh2,
      mul_mem_cancel_right hg3, mul_mem_cancel_right (inv_mem hg3), mul_mem_cancel_right hh3,
      mul_mem_cancel_right (inv_mem hh3), mul_mem_cancel_right hg4,
      mul_mem_cancel_right (inv_mem hg4), mul_mem_cancel_right hg5, mul_mem_cancel_right hh5,
      mul_mem_cancel_right hk5, mul_mem_cancel_right hl5, mul_mem_cancel_right hm5, inv_mem_iff,
      ha, hb, hg1, hh1, hg2, hh2, hg3, hh3, hg4, hg5, hh5, hk5, hl5, hm5, one_mem]

private theorem le_closure_tables : M23 ≤ Subgroup.closure {g | g ∈ [aTable, bTable]} := by
  rw [M23_def, aTable_eq, bTable_eq]
  exact Subgroup.closure_mono (by simp [Set.insert_subset_iff])

private theorem transversalCheck_eq_true :
    TauCeti.transversalCheck (Fin.ofNat 23) transversal 6 = true := by
  decide +kernel

private theorem sift_tables :
    [aTable, bTable].all (TauCeti.sift (Fin.ofNat 23) transversal 0 6 1) = true := by
  decide +kernel

/- The sifting conditions are checked one level at a time: together they are `6572` sifts, too many
for a single kernel check within the default heartbeat budget. -/

private theorem siftCheck_0 : TauCeti.siftCheck (Fin.ofNat 23) transversal 6 0 = true := by
  decide +kernel

private theorem siftCheck_1 : TauCeti.siftCheck (Fin.ofNat 23) transversal 6 1 = true := by
  decide +kernel

private theorem siftCheck_2 : TauCeti.siftCheck (Fin.ofNat 23) transversal 6 2 = true := by
  decide +kernel

private theorem siftCheck_3 : TauCeti.siftCheck (Fin.ofNat 23) transversal 6 3 = true := by
  decide +kernel

private theorem siftCheck_4 : TauCeti.siftCheck (Fin.ofNat 23) transversal 6 4 = true := by
  decide +kernel

private theorem siftCheck_5 : TauCeti.siftCheck (Fin.ofNat 23) transversal 6 5 = true := by
  decide +kernel

private theorem siftCheck_eq_true :
    ∀ i < 6, TauCeti.siftCheck (Fin.ofNat 23) transversal 6 i = true := by
  intro i hi
  interval_cases i
  exacts [siftCheck_0, siftCheck_1, siftCheck_2, siftCheck_3, siftCheck_4, siftCheck_5]

/-- **The points `0, 1, 2, 3, 4, 5` form a base of `M23`**: no element of `M23` other than `1`
fixes all of them. -/
theorem stabilizerChain_six_eq_bot : M23.stabilizerChain (Fin.ofNat 23) 6 = ⊥ :=
  Subgroup.stabilizerChain_eq_bot_of_siftCheck le_closure_tables
    transversalCheck_eq_true sift_tables siftCheck_eq_true

end M23

/-- **The order of `M₂₃`.** The permutation model `M23` has
`10200960 = 23 * 22 * 21 * 20 * 3 * 16` elements: along the base `0, 1, 2, 3, 4, 5` its basic
orbits have lengths `23`, `22`, `21`, `20`, `3` and `16`. -/
theorem card_M23 : Nat.card M23 = 10200960 := by
  rw [Subgroup.natCard_eq_prod_length_of_siftCheck M23.mem_transversal M23.le_closure_tables
    M23.transversalCheck_eq_true M23.sift_tables M23.siftCheck_eq_true]
  decide

/-- The group presented by the presentation of `M₂₃`, when finite, has at least `10200960`
elements, since it maps onto the model `M23`. Finiteness is a hypothesis: with the junk value
`Nat.card = 0` for infinite types, a surjection alone gives no lower bound. -/
theorem le_natCard_group_M23 (h : 0 < Nat.card SporadicName.M23.Group) :
    10200960 ≤ Nat.card SporadicName.M23.Group := by
  have := Nat.finite_of_card_ne_zero h.ne'
  obtain ⟨f, hf⟩ := exists_surjective_M23
  exact card_M23 ▸ Nat.card_le_card_of_surjective f hf

end TauCeti.Sporadic
