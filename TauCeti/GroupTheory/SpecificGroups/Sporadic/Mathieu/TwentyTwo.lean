module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Perm.Cycle.Concrete
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Presentation

/-!
# The permutation model of `M₂₂` and the surjection from its presented group

This file defines the permutation model `TauCeti.Sporadic.M22` of the Mathieu group `M₂₂`: the
subgroup of `Equiv.Perm (Fin 22)` generated by the two permutations `M22.a` and `M22.b` of the
ATLAS files `M22G1-p22B0.m1` and `M22G1-p22B0.m2`. The files list the images of the points
`1, …, 22`; the point `i` of a file is the point `i - 1` of `Fin 22`, and each generator is written
as the product of its disjoint cycles in Mathlib's cycle notation. In the files' numbering,

```text
a = (1,13)(2,8)(3,16)(4,12)(6,22)(7,17)(9,10)(11,14),
b = (1,22,3,21)(2,18,4,13)(5,12)(6,11,7,15)(8,14,20,10)(17,19).
```

So `a` is an involution with six fixed points and `b` has order `4` with two fixed points; the
orders `2`, `4` and `11` of `a`, `b` and `a * b` are recorded as a check on the transcription.
Reading the files as preimages instead of images would replace `b` by `b⁻¹`, which sends `0` to
`20` rather than `21`.

It then shows that the presentation of `M₂₂` carried by `TauCeti.SporadicName.presentation`
(Conder–Havas–Ramsay, relators `a⁴ b A b A b`, `a² b A B a b² A B` and `b¹¹`) holds in the model.
Its generators `a` and `b` are sent to

```text
M22.imageA = c[0, 9, 1, 17, 19] * c[3, 7, 11, 6, 20] * c[4, 18, 15, 14, 21] * c[8, 13, 10, 16, 12]
M22.imageB = c[0, 5, 13, 19, 8, 9, 1, 17, 11, 4, 3] * c[2, 20, 12, 7, 10, 16, 18, 6, 14, 21, 15]
```

of orders `5` and `11`, on which all three transcribed relators evaluate to `1`, with products
composed as in Mathlib, `(σ * τ) i = σ (τ i)`. These two permutations generate the model:
`M22.imageA` and `M22.imageB = a * b` are words in the ATLAS generators, and the ATLAS generators
are words in `M22.imageA` and `M22.imageB`. Extending the assignment therefore gives a
homomorphism from `TauCeti.SporadicName.M22.Group` whose range is exactly the model, hence a
surjection onto it; in particular the presented group is nontrivial. The order of the model is not
computed here.

## Main declarations

* `TauCeti.Sporadic.M22`: the permutation model of `M₂₂` on `22` points.
* `TauCeti.Sporadic.M22.presentationImage`: the images of the presentation generators.
* `TauCeti.Sporadic.M22.lift_presentationImage_toFreeGroup_eq_one`: every transcribed relator of
  the presentation of `M₂₂` evaluates to `1` at these images.
* `TauCeti.Sporadic.M22.closure_range_presentationImage`: the images generate the model.
* `TauCeti.Sporadic.M22.presentationHom`: the homomorphism from the presented group.
* `TauCeti.Sporadic.exists_surjective_M22`: the presented group maps onto the model.

## References

* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `M22G1-p22B0`, <https://brauer.maths.qmul.ac.uk/Atlas/v3/>; generator
  image files <https://brauer.maths.qmul.ac.uk/Atlas/spor/M22/mtx/M22G1-p22B0.m1> and
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/M22/mtx/M22G1-p22B0.m2>.
* M. D. E. Conder, G. Havas and C. Ramsay, *Efficient presentations for the Mathieu simple group
  M22 and its cover*, in Finite Geometries, Groups, and Computation, Walter de Gruyter, Berlin,
  2006, 33–41, Section 3.4.
-/

public section

namespace TauCeti.Sporadic

/-- The first generator of the permutation model of `M₂₂`, from the ATLAS file `M22G1-p22B0.m1`:
the involution `(1,13)(2,8)(3,16)(4,12)(6,22)(7,17)(9,10)(11,14)` of the file, shifted to the
points `0, …, 21`. -/
def M22.a : Equiv.Perm (Fin 22) :=
  c[0, 12] * c[1, 7] * c[2, 15] * c[3, 11] * c[5, 21] * c[6, 16] * c[8, 9] * c[10, 13]

/-- The second generator of the permutation model of `M₂₂`, from the ATLAS file `M22G1-p22B0.m2`:
the permutation `(1,22,3,21)(2,18,4,13)(5,12)(6,11,7,15)(8,14,20,10)(17,19)` of order `4` of the
file, shifted to the points `0, …, 21`. -/
def M22.b : Equiv.Perm (Fin 22) :=
  c[0, 21, 2, 20] * c[1, 17, 3, 12] * c[4, 11] * c[5, 10, 6, 14] * c[7, 13, 19, 9] * c[16, 18]

/-- The permutation model of the Mathieu group `M₂₂`: the subgroup of `Equiv.Perm (Fin 22)`
generated by the permutations `M22.a` and `M22.b` of the ATLAS files `M22G1-p22B0.m1` and
`M22G1-p22B0.m2`. -/
def M22 : Subgroup (Equiv.Perm (Fin 22)) := Subgroup.closure {M22.a, M22.b}

namespace M22

theorem a_def :
    a = c[0, 12] * c[1, 7] * c[2, 15] * c[3, 11] * c[5, 21] * c[6, 16] * c[8, 9] * c[10, 13] :=
  (rfl)

theorem b_def :
    b = c[0, 21, 2, 20] * c[1, 17, 3, 12] * c[4, 11] * c[5, 10, 6, 14] * c[7, 13, 19, 9] *
      c[16, 18] :=
  (rfl)

/-- The permutation model `M22` is the subgroup generated by the ATLAS generators. This is the
unfolding lemma for `TauCeti.Sporadic.M22`, whose body is not exposed. -/
theorem M22_def : M22 = Subgroup.closure {a, b} := (rfl)

theorem a_mem : a ∈ M22 := Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ M22 := Subgroup.subset_closure (by simp)

/-! ### Generator orders -/

/- The equations between explicit permutations of `Fin 22` in this file are closed by
`decide +kernel`: the elaborator's `decide` exhausts its recursion depth while evaluating
`Cycle.formPerm`, while the kernel checks each of them directly. -/

theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_b : orderOf b = 4 :=
  orderOf_eq_prime_pow (p := 2) (n := 1) (by decide +kernel) (by decide +kernel)

theorem orderOf_a_mul_b : orderOf (a * b) = 11 :=
  have : Fact (Nat.Prime 11) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### The presentation of `M₂₂` holds in the model -/

/-- The image in the permutation model of the generator `a` (index `0`) of the presentation of
`M₂₂`: the permutation `c[0, 9, 1, 17, 19] * c[3, 7, 11, 6, 20] * c[4, 18, 15, 14, 21] *
c[8, 13, 10, 16, 12]` of order `5`. -/
def imageA : Equiv.Perm (Fin 22) :=
  c[0, 9, 1, 17, 19] * c[3, 7, 11, 6, 20] * c[4, 18, 15, 14, 21] * c[8, 13, 10, 16, 12]

/-- The image in the permutation model of the generator `b` (index `1`) of the presentation of
`M₂₂`: the permutation `c[0, 5, 13, 19, 8, 9, 1, 17, 11, 4, 3] *
c[2, 20, 12, 7, 10, 16, 18, 6, 14, 21, 15]` of order `11`, which is `a * b`. -/
def imageB : Equiv.Perm (Fin 22) :=
  c[0, 5, 13, 19, 8, 9, 1, 17, 11, 4, 3] * c[2, 20, 12, 7, 10, 16, 18, 6, 14, 21, 15]

theorem imageA_def :
    imageA = c[0, 9, 1, 17, 19] * c[3, 7, 11, 6, 20] * c[4, 18, 15, 14, 21] *
      c[8, 13, 10, 16, 12] :=
  (rfl)

theorem imageB_def :
    imageB = c[0, 5, 13, 19, 8, 9, 1, 17, 11, 4, 3] * c[2, 20, 12, 7, 10, 16, 18, 6, 14, 21, 15] :=
  (rfl)

/-- The images in the permutation model of the generators of the presentation of `M₂₂`: `imageA`
for the generator of index `0` and `imageB` for the generator of index `1`. -/
def presentationImage (i : Fin SporadicName.M22.presentation.generatorCount) :
    Equiv.Perm (Fin 22) :=
  if (i : ℕ) = 0 then imageA else imageB

@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.M22.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageA := by
  simp [presentationImage]

@[simp]
theorem presentationImage_one (h : 1 < SporadicName.M22.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageB := by
  simp [presentationImage]

theorem range_presentationImage : Set.range presentationImage = {imageA, imageB} := by
  have h : SporadicName.M22.presentation.generatorCount = 2 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    by_cases hi : (i : ℕ) = 0 <;> simp [presentationImage, hi]
  · rintro (rfl | rfl)
    · exact ⟨⟨0, by omega⟩, presentationImage_zero _⟩
    · exact ⟨⟨1, by omega⟩, presentationImage_one _⟩

/-- **The relators of `M₂₂` hold in the model.** All three transcribed relators of the
presentation of `M₂₂` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.M22.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.M22.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_M22`.
  suffices key : ∀ P : GroupPresentation, P = m22Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then imageA else imageB)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_M22
  rintro P rfl
  simp only [m22Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  decide +kernel

/-- `imageA` as a word in the ATLAS generators. -/
theorem imageA_eq :
    imageA = b * a * b⁻¹ * a * b⁻¹ * a * b⁻¹ * a * b⁻¹ * a * b * b * a * b * a * b⁻¹ := by
  decide +kernel

/-- `imageB` is the product `a * b` of the ATLAS generators. -/
theorem imageB_eq : imageB = a * b := by
  decide +kernel

/-- The ATLAS generator `a` as a word in the images of the presentation generators. -/
theorem a_eq :
    a = imageA⁻¹ * imageB⁻¹ * imageA⁻¹ * imageB * imageA⁻¹ * imageA⁻¹ * imageB * imageA *
      imageA := by
  decide +kernel

/-- The ATLAS generator `b` as a word in the images of the presentation generators. -/
theorem b_eq : b = a * imageB := by
  decide +kernel

/-- **The images generate the model.** The subgroup generated by the images of the presentation
generators is the permutation model `M22`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = M22 := by
  rw [range_presentationImage]
  refine le_antisymm (Subgroup.closure_le _ |>.2 ?_) (Subgroup.closure_le _ |>.2 ?_)
  · have ha := a_mem
    have hb := b_mem
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, imageA_eq, imageB_eq, mul_mem_cancel_right ha,
        mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb), ha, hb]
  · have hA : imageA ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    have hB : imageB ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    have ha : a ∈ Subgroup.closure {imageA, imageB} := by
      simp only [a_eq, mul_mem_cancel_right hA, mul_mem_cancel_right hB,
        mul_mem_cancel_right (inv_mem hA), mul_mem_cancel_right (inv_mem hB), inv_mem hA]
    rintro σ (rfl | rfl)
    · exact ha
    · simpa only [SetLike.mem_coe, b_eq] using mul_mem ha hB

/-- The homomorphism from the group presented by the presentation of `M₂₂` to
`Equiv.Perm (Fin 22)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.M22.Group →* Equiv.Perm (Fin 22) :=
  SporadicName.M22.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

@[simp]
theorem presentationHom_of (i : Fin SporadicName.M22.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `M22`. -/
theorem range_presentationHom : presentationHom.range = M22 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end M22

/-- **The presented group of `M₂₂` maps onto the permutation model.** The group defined by the
presentation of `M₂₂` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `M22`. -/
theorem exists_surjective_M22 :
    ∃ f : SporadicName.M22.Group →* M22, Function.Surjective f :=
  SporadicName.M22.presentation.exists_surjective_of_closure_range_eq
    ⟨M22.presentationImage, M22.lift_presentationImage_toFreeGroup_eq_one⟩
    M22.closure_range_presentationImage

/-- The permutation model `M22` is nontrivial: it contains the involution `M22.a`. -/
instance : Nontrivial M22 :=
  M22.nontrivial_iff_exists_ne_one.2 ⟨M22.a, M22.a_mem, by decide +kernel⟩

/-- The group presented by the presentation of `M₂₂` is nontrivial, since it maps onto the
nontrivial permutation model `M22`. -/
instance : Nontrivial SporadicName.M22.Group :=
  exists_surjective_M22.choose_spec.nontrivial

end TauCeti.Sporadic
