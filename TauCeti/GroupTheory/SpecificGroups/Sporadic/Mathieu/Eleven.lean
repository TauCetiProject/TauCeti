module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Perm.Cycle.Concrete
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Presentation

/-!
# The permutation model of `M₁₁` and the surjection from its presented group

This file defines the permutation model `TauCeti.Sporadic.M11` of the Mathieu group `M₁₁`: the
subgroup of `Equiv.Perm (Fin 11)` generated by the two permutations `M11.a` and `M11.b` of the
ATLAS files `M11G1-p11B0.m1` and `M11G1-p11B0.m2`. The files list the images of the points
`1, …, 11`; the point `i` of a file is the point `i - 1` of `Fin 11`, and each generator is written
as the product of its disjoint cycles in Mathlib's cycle notation. In the files' numbering,

```text
a = (2,10)(4,11)(5,7)(8,9),   b = (1,4,3,8)(2,5,6,9).
```

The generator orders `2`, `4` and `11` of `a`, `b` and `a * b` are recorded as a check on the
transcription.

It then shows that the presentation of `M₁₁` carried by `TauCeti.SporadicName.presentation`
(Campbell–Havas–Ramsay–Robertson, relators `b A³ b A b³` and `b a B A B A b a B a`) holds in the
model. Its generators `a` and `b` are sent to the two `11`-cycles

```text
M11.imageA = c[0, 2, 1, 5, 8, 9, 3, 7, 10, 4, 6]
M11.imageB = c[0, 10, 7, 9, 6, 8, 3, 2, 1, 4, 5]
```

on which both transcribed relators evaluate to `1`, with products composed as in Mathlib,
`(σ * τ) i = σ (τ i)`. These two permutations generate the model: `M11.imageA` and
`M11.imageB = b * a * b * a` are words in the ATLAS generators, and the ATLAS generators are words
in `M11.imageA` and `M11.imageB`. Extending the assignment therefore gives a homomorphism from
`TauCeti.SporadicName.M11.Group` whose range is exactly the model, hence a surjection onto it; in
particular the presented group is nontrivial. The order of the model is not computed here.

## Main declarations

* `TauCeti.Sporadic.M11`: the permutation model of `M₁₁` on `11` points.
* `TauCeti.Sporadic.M11.presentationImage`: the images of the presentation generators.
* `TauCeti.Sporadic.M11.lift_presentationImage_toFreeGroup`: every transcribed relator of the
  presentation of `M₁₁` evaluates to `1` at these images.
* `TauCeti.Sporadic.M11.closure_range_presentationImage`: the images generate the model.
* `TauCeti.Sporadic.M11.presentationHom`: the homomorphism from the presented group.
* `TauCeti.Sporadic.exists_surjective_M11`: the presented group maps onto the model.

## References

* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `M11G1-p11B0`, <https://brauer.maths.qmul.ac.uk/Atlas/v3/>.
* C. M. Campbell, G. Havas, C. Ramsay and E. F. Robertson, *Nice efficient presentations for all
  small simple groups and their covers*, LMS J. Comput. Math. 7 (2004), 266–283, Table 2.
-/

public section

namespace TauCeti.Sporadic

/-- The first generator of the permutation model of `M₁₁`, from the ATLAS file `M11G1-p11B0.m1`:
the involution `(2,10)(4,11)(5,7)(8,9)` of the file, shifted to the points `0, …, 10`. -/
def M11.a : Equiv.Perm (Fin 11) := c[1, 9] * c[3, 10] * c[4, 6] * c[7, 8]

/-- The second generator of the permutation model of `M₁₁`, from the ATLAS file `M11G1-p11B0.m2`:
the permutation `(1,4,3,8)(2,5,6,9)` of order `4` of the file, shifted to the points
`0, …, 10`. -/
def M11.b : Equiv.Perm (Fin 11) := c[0, 3, 2, 7] * c[1, 4, 5, 8]

/-- The permutation model of the Mathieu group `M₁₁`: the subgroup of `Equiv.Perm (Fin 11)`
generated by the permutations `M11.a` and `M11.b` of the ATLAS files `M11G1-p11B0.m1` and
`M11G1-p11B0.m2`. -/
def M11 : Subgroup (Equiv.Perm (Fin 11)) := Subgroup.closure {M11.a, M11.b}

namespace M11

theorem a_mem : a ∈ M11 := Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ M11 := Subgroup.subset_closure (by simp)

/-! ### Generator orders -/

/- The equations between explicit permutations of `Fin 11` in this file are closed by
`decide +kernel`: the elaborator's `decide` exhausts its recursion depth while evaluating
`Cycle.formPerm`, while the kernel checks each of them directly. -/

theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_b : orderOf b = 4 :=
  orderOf_eq_prime_pow (p := 2) (n := 1) (by decide +kernel) (by decide +kernel)

theorem orderOf_a_mul_b : orderOf (a * b) = 11 :=
  have : Fact (Nat.Prime 11) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### The presentation of `M₁₁` holds in the model -/

/-- The image in the permutation model of the generator `a` (index `0`) of the presentation of
`M₁₁`: the `11`-cycle `c[0, 2, 1, 5, 8, 9, 3, 7, 10, 4, 6]`. -/
def imageA : Equiv.Perm (Fin 11) := c[0, 2, 1, 5, 8, 9, 3, 7, 10, 4, 6]

/-- The image in the permutation model of the generator `b` (index `1`) of the presentation of
`M₁₁`: the `11`-cycle `c[0, 10, 7, 9, 6, 8, 3, 2, 1, 4, 5]`. -/
def imageB : Equiv.Perm (Fin 11) := c[0, 10, 7, 9, 6, 8, 3, 2, 1, 4, 5]

/-- The images in the permutation model of the generators of the presentation of `M₁₁`: `imageA`
for the generator of index `0` and `imageB` for the generator of index `1`. -/
def presentationImage (i : Fin SporadicName.M11.presentation.generatorCount) :
    Equiv.Perm (Fin 11) :=
  if (i : ℕ) = 0 then imageA else imageB

@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.M11.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageA := by
  simp [presentationImage]

@[simp]
theorem presentationImage_one (h : 1 < SporadicName.M11.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageB := by
  simp [presentationImage]

theorem range_presentationImage : Set.range presentationImage = {imageA, imageB} := by
  have h : SporadicName.M11.presentation.generatorCount = 2 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    by_cases hi : (i : ℕ) = 0 <;> simp [presentationImage, hi]
  · rintro (rfl | rfl)
    · exact ⟨⟨0, by omega⟩, presentationImage_zero _⟩
    · exact ⟨⟨1, by omega⟩, presentationImage_one _⟩

/-- **The relators of `M₁₁` hold in the model.** Both transcribed relators of the presentation of
`M₁₁` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup :
    ∀ t ∈ SporadicName.M11.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.M11.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_M11`.
  suffices key : ∀ P : GroupPresentation, P = m11Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then imageA else imageB)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_M11
  rintro P rfl
  simp only [m11Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  decide +kernel

/-- `imageA` as a word in the ATLAS generators. -/
theorem imageA_eq : imageA = a * b⁻¹ * a * b * a * b * a * b * a * b * b * a * b⁻¹ := by
  decide +kernel

/-- `imageB` as a word in the ATLAS generators. -/
theorem imageB_eq : imageB = b * a * b * a := by
  decide +kernel

/-- The ATLAS generator `a` as a word in the images of the presentation generators. -/
theorem a_eq : a = imageA⁻¹ * imageA⁻¹ * imageB⁻¹ * imageA * imageA * imageB * imageB := by
  decide +kernel

/-- The ATLAS generator `b` as a word in the images of the presentation generators. -/
theorem b_eq : b = imageA * imageB⁻¹ * imageA * imageB * imageA * imageA := by
  decide +kernel

/-- **The images generate the model.** The subgroup generated by the images of the presentation
generators is the permutation model `M11`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = M11 := by
  rw [range_presentationImage]
  refine le_antisymm (Subgroup.closure_le _ |>.2 ?_) (Subgroup.closure_le _ |>.2 ?_)
  · have ha := a_mem
    have hb := b_mem
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, imageA_eq, imageB_eq, mul_mem_cancel_right ha,
        mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb), ha, hb]
  · have hA : imageA ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    have hB : imageB ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, a_eq, b_eq, mul_mem_cancel_right hA, mul_mem_cancel_right hB,
        mul_mem_cancel_right (inv_mem hA), mul_mem_cancel_right (inv_mem hB), inv_mem hA, hA]

/-- The homomorphism from the group presented by the presentation of `M₁₁` to
`Equiv.Perm (Fin 11)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.M11.Group →* Equiv.Perm (Fin 11) :=
  SporadicName.M11.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup⟩

@[simp]
theorem presentationHom_of (i : Fin SporadicName.M11.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `M11`. -/
theorem range_presentationHom : presentationHom.range = M11 := by
  rw [MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of, MonoidHom.map_closure,
    ← Set.range_comp, ← closure_range_presentationImage]
  simp [Function.comp_def]

end M11

/-- **The presented group of `M₁₁` maps onto the permutation model.** The group defined by the
presentation of `M₁₁` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `M11`. -/
theorem exists_surjective_M11 :
    ∃ f : SporadicName.M11.Group →* M11, Function.Surjective f :=
  ⟨(MulEquiv.subgroupCongr M11.range_presentationHom).toMonoidHom.comp
      M11.presentationHom.rangeRestrict,
    by
      rw [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom]
      exact (MulEquiv.surjective _).comp M11.presentationHom.rangeRestrict_surjective⟩

/-- The permutation model `M11` is nontrivial: it contains the involution `M11.a`. -/
instance : Nontrivial M11 :=
  M11.nontrivial_iff_exists_ne_one.2 ⟨M11.a, M11.a_mem, by decide +kernel⟩

/-- The group presented by the presentation of `M₁₁` is nontrivial, since it maps onto the
nontrivial permutation model `M11`. -/
instance : Nontrivial SporadicName.M11.Group :=
  exists_surjective_M11.choose_spec.nontrivial

end TauCeti.Sporadic
