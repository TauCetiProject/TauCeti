private theorem tables_eq_words : ∀ i, tables i = ((tableWords i).map letters).prod := by
  simp only [letters, a_def, b_def]
  decide +kernel

private theorem tables_mem (i : Fin 67) : tables i ∈ M12 := by
  rw [tables_eq_words]
  apply Subgroup.list_prod_mem
  intro g hg
  obtain ⟨j, _, rfl⟩ := List.mem_map.mp hg
  fin_cases j
  · exact a_mem
  · exact b_mem
  · exact inv_mem b_mem

private def point (i : Fin 67) : M12 := ⟨tables i, tables_mem i⟩

private abbrev localLength : Fin 4 → ℕ := ![6, 3, 1, 1]
private abbrev localPrime : Fin 4 → ℕ := ![2, 3, 5, 11]

private def localIndex (t : Fin 4) (i : Fin (localLength t)) : Fin 67 :=
  ⟨(![0, 6, 9, 10] t : ℕ) + i, by fin_cases t <;> simp [localLength] at * <;> omega⟩

private def localGenerator (t : Fin 4) (i : Fin (localLength t)) : M12 := point (localIndex t i)

private def localSubgroup (t : Fin 4) : Subgroup M12 :=
  Subgroup.closure (Set.range (localGenerator t))

private def normalForm (t : Fin 4) (e : Fin (localLength t) → Fin (localPrime t)) : M12 :=
  (List.ofFn fun i ↦ localGenerator t i ^ (e i : ℕ)).reverse.prod

-- The certificate computes the public normal-form equation without unfolding its hidden body.
private theorem normalForm_eq (t : Fin 4) (e : Fin (localLength t) → Fin (localPrime t)) :
    normalForm t e = (powerConjugateNormalForm (localGenerator t)
      (fun _ ↦ localPrime t) e : M12) :=
  (coe_powerConjugateNormalForm _ _ _).symm

