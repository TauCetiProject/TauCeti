private theorem power_equations : ∀ t i, localGenerator t i ^ localPrime t = 1 := by
  decide +kernel

private theorem conjugation_equations : ∀ t i j, i < j →
    localGenerator t i * localGenerator t j * (localGenerator t i)⁻¹ =
      normalForm t (conjugationWitness t i j) := by
  decide +kernel

private theorem conjugation_prefix : ∀ (t : Fin 4) (i j k : Fin (localLength t)), i < j
  → (k : ℕ)
  < (i : ℕ) + 1 →
    (conjugationWitness t i j k : ℕ) = 0 := by
  decide +kernel

private theorem power_mem (t : Fin 4) (i : Fin (localLength t)) :
    localGenerator t i ^ localPrime t ∈ generatorSuffix (localGenerator t) ((i : ℕ) + 1) := by
  rw [power_equations]
  exact Subgroup.one_mem _

private theorem conjugation_mem (t : Fin 4) (i j : Fin (localLength t)) (hij : i < j) :
    localGenerator t i * localGenerator t j * (localGenerator t i)⁻¹ ∈
      generatorSuffix (localGenerator t) ((i : ℕ) + 1) := by
  rw [conjugation_equations t i j hij]
  rw [normalForm_eq]
  exact powerConjugateNormalForm_mem_generatorSuffix _ _ _ _
    (fun k hk ↦ conjugation_prefix t i j k hij hk)

private theorem prime_pos : ∀ t, 0 < localPrime t := by decide

private theorem normalForm_injective : ∀ t, Function.Injective (normalForm t) := by
  decide +kernel

private theorem card_localSubgroup (t : Fin 4) :
    Nat.card (localSubgroup t) = localPrime t ^ localLength t := by
  have h := (powerConjugateNormalForm_injective_iff (localGenerator t)
    (fun _ ↦ localPrime t) (fun _ ↦ prime_pos t) (power_mem t) (conjugation_mem t)).mp
      (fun e f h ↦ normalForm_injective t (by simpa only [normalForm_eq] using
        (congrArg Subtype.val h)))
  simpa [localSubgroup, Finset.prod_const] using h

private theorem normalForm_surjective (t : Fin 4) (g : localSubgroup t) :
    ∃ e, normalForm t e = (g : M12) := by
  obtain ⟨e, he⟩ := powerConjugateNormalForm_surjective (localGenerator t)
    (fun _ ↦ localPrime t) (fun _ ↦ prime_pos t) (power_mem t) (conjugation_mem t) g
  exact ⟨e, by simpa only [normalForm_eq] using congrArg Subtype.val he⟩

