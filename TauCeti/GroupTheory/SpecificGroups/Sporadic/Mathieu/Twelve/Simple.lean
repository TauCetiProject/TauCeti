private theorem local_coverage (t : Fin 4) (g : localSubgroup t)
    (hg : orderOf g = localPrime t) : ∃ i, IsConj (representative i) (g : M12) := by
  obtain ⟨e, he⟩ := normalForm_surjective t g
  have horder : orderOf (normalForm t e) = localPrime t := by
    rw [he]
    exact (Subgroup.orderOf_coe g).trans hg
  have hne : normalForm t e ≠ 1 := fun h ↦ by
    have hz := horder
    rw [h, orderOf_one] at hz
    have : localPrime t ≠ 1 := by fin_cases t <;> decide
    exact this hz.symm
  have hpow : normalForm t e ^ localPrime t = 1 := by
    rw [← horder, pow_orderOf_eq_one]
  refine ⟨fusionIndex t e, ?_⟩
  rw [← he]
  exact isConj_iff.mpr ⟨(fusionConjugator t e)⁻¹,
    by simpa using fusion_equations t e hne hpow⟩

end TauCeti.Sporadic.M12

namespace TauCeti.Sporadic

/-- The canonical twelve-point permutation model of the Mathieu group M₁₂ is simple. -/
instance isSimpleGroup_M12 : IsSimpleGroup M12 := by
  let P : ℕ → Subgroup M12 := fun p ↦
    if p = 2 then M12.localSubgroup 0 else
    if p = 3 then M12.localSubgroup 1 else
    if p = 5 then M12.localSubgroup 2 else M12.localSubgroup 3
  have prime_cases (p : ℕ) (hp : p.Prime) (hd : p ∣ Nat.card M12) :
      p = 2 ∨ p = 3 ∨ p = 5 ∨ p = 11 := by
    rw [card_M12] at hd
    have : p ∣ 2 ^ 6 * 3 ^ 3 * 5 * 11 := by simpa using hd
    rcases (hp.dvd_mul.mp this) with h | h
    · rcases hp.dvd_mul.mp h with h | h
      · rcases hp.dvd_mul.mp h with h | h
        · exact .inl (Nat.prime_dvd_prime_iff_eq hp (by decide) |>.mp (hp.dvd_of_dvd_pow h))
        · exact .inr (.inl (Nat.prime_dvd_prime_iff_eq hp (by decide) |>.mp
            (hp.dvd_of_dvd_pow h)))
      · exact .inr (.inr (.inl (Nat.prime_dvd_prime_iff_eq hp (by decide) |>.mp h)))
    · exact .inr (.inr (.inr (Nat.prime_dvd_prime_iff_eq hp (by decide) |>.mp h)))
  have factorization_order : Nat.factorization 95040 =
      Finsupp.single 2 6 + Finsupp.single 3 3 + Finsupp.single 5 1 + Finsupp.single 11 1 := by
    have h : Nat.factorization (2 ^ 6 * 3 ^ 3 * 5 * 11) =
        Finsupp.single 2 6 + Finsupp.single 3 3 + Finsupp.single 5 1 + Finsupp.single 11 1 := by
      rw [Nat.factorization_mul (by decide) (by decide),
        Nat.factorization_mul (by decide) (by decide),
        Nat.factorization_mul (by decide) (by decide),
        Nat.prime_two.factorization_pow, Nat.prime_three.factorization_pow,
        (by decide : Nat.Prime 5).factorization, (by decide : Nat.Prime 11).factorization]
    exact h
  apply TauCeti.isSimpleGroup_of_card_eq_of_normalClosure_eq_top_of_isConj P
    (s := Set.range M12.representative)
  · intro p hp hd
    rcases prime_cases p hp hd with rfl | rfl | rfl | rfl <;>
      simp [P, M12.card_localSubgroup, card_M12, M12.localPrime, M12.localLength]
    all_goals norm_num [factorization_order]
  · rintro _ ⟨i, rfl⟩
    exact M12.normalClosure_representative i
  · intro p hp hd g hg
    rcases prime_cases p hp hd with rfl | rfl | rfl | rfl
    all_goals
      obtain ⟨i, hi⟩ := M12.local_coverage _ g hg
      exact ⟨_, Set.mem_range_self i, hi⟩

end TauCeti.Sporadic
