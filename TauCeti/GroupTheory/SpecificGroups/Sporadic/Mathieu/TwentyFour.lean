module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Perm.Cycle.Concrete
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Presentation

/-!
# The permutation model of `M₂₄` and the surjection from its presented group

This file defines the permutation model `TauCeti.Sporadic.M24` of the Mathieu group `M₂₄`: the
subgroup of `Equiv.Perm (Fin 24)` generated by the two permutations `M24.a` and `M24.b` of the
ATLAS files `M24G1-p24B0.m1` and `M24G1-p24B0.m2`. The files list the images of the points
`1, …, 24`; the point `i` of a file is the point `i - 1` of `Fin 24`, and each generator is written
as the product of its disjoint cycles in Mathlib's cycle notation. In the files' numbering,

```text
a = (1,4)(2,7)(3,17)(5,13)(6,9)(8,15)(10,19)(11,18)(12,21)(14,16)(20,24)(22,23),
b = (1,4,6)(2,21,14)(3,9,15)(5,18,10)(13,17,16)(19,24,23).
```

So `a` is a fixed-point-free involution and `b` has order `3` with six fixed points; the orders
`2`, `3` and `23` of `a`, `b` and `a * b` are recorded as a check on the transcription. Reading the
files as preimages instead of images would replace `b` by `b⁻¹`, which sends `0` to `5` rather
than `3`. The bodies of the two generators are exposed, so that importing modules can evaluate
them in the kernel; the model itself is characterized by `TauCeti.Sporadic.M24_def`.

It then shows that the ATLAS presentation `M24G1-P1` carried by `TauCeti.SporadicName.presentation`
holds in the model. That presentation is on the standard generators of `M₂₄` and its words are
read left to right, while Mathlib composes permutations right to left, `(σ * τ) i = σ (τ i)`.
Reversing a word and inverting its letters exchanges the two conventions, so the presentation
generators are sent to `a⁻¹ = a` and `b⁻¹`. All seven transcribed relators evaluate to `1` at this
assignment. The convention matters: at the assignment `(a, b)` the sixth relator
`(ab ab ab⁻¹)³ (ab ab⁻¹ ab⁻¹)³` sends `0` to `20`, although the power relators `a²`, `b³` and
`(ab)²³` hold at both assignments.

Since `b = (b⁻¹)⁻¹`, the permutations `a` and `b⁻¹` generate the model. Extending the assignment
therefore gives a homomorphism from `TauCeti.SporadicName.M24.Group` whose range is exactly the
model, hence a surjection onto it; in particular the presented group is nontrivial. The order of
the model is not computed here.

## Main declarations

* `TauCeti.Sporadic.M24`: the permutation model of `M₂₄` on `24` points.
* `TauCeti.Sporadic.M24.presentationImage`: the images `a` and `b⁻¹` of the presentation
  generators.
* `TauCeti.Sporadic.M24.lift_presentationImage_toFreeGroup`: every transcribed relator of the
  presentation of `M₂₄` evaluates to `1` at these images.
* `TauCeti.Sporadic.M24.closure_range_presentationImage`: the images generate the model.
* `TauCeti.Sporadic.M24.presentationHom`: the homomorphism from the presented group.
* `TauCeti.Sporadic.exists_surjective_M24`: the presented group maps onto the model.

## References

* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `M24G1-p24B0` and presentation `M24G1-P1`,
  <https://brauer.maths.qmul.ac.uk/Atlas/v3/>; generator image files
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/M24/mtx/M24G1-p24B0.m1> and
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/M24/mtx/M24G1-p24B0.m2>.
-/

public section

namespace TauCeti.Sporadic

/-- The first generator of the permutation model of `M₂₄`, from the ATLAS file `M24G1-p24B0.m1`:
the fixed-point-free involution `(1,4)(2,7)(3,17)(5,13)(6,9)(8,15)(10,19)(11,18)(12,21)(14,16)
(20,24)(22,23)` of the file, shifted to the points `0, …, 23`. -/
@[expose] def M24.a : Equiv.Perm (Fin 24) :=
  c[0, 3] * c[1, 6] * c[2, 16] * c[4, 12] * c[5, 8] * c[7, 14] * c[9, 18] * c[10, 17] *
    c[11, 20] * c[13, 15] * c[19, 23] * c[21, 22]

/-- The second generator of the permutation model of `M₂₄`, from the ATLAS file `M24G1-p24B0.m2`:
the permutation `(1,4,6)(2,21,14)(3,9,15)(5,18,10)(13,17,16)(19,24,23)` of order `3` of the file,
shifted to the points `0, …, 23`. -/
@[expose] def M24.b : Equiv.Perm (Fin 24) :=
  c[0, 3, 5] * c[1, 20, 13] * c[2, 8, 14] * c[4, 17, 9] * c[12, 16, 15] * c[18, 23, 22]

/-- The permutation model of the Mathieu group `M₂₄`: the subgroup of `Equiv.Perm (Fin 24)`
generated by the permutations `M24.a` and `M24.b` of the ATLAS files `M24G1-p24B0.m1` and
`M24G1-p24B0.m2`. -/
def M24 : Subgroup (Equiv.Perm (Fin 24)) := Subgroup.closure {M24.a, M24.b}

/-- The model `M24` is the subgroup generated by `M24.a` and `M24.b`. The body of `M24` is not
exposed, so this equation is how importing modules reach the `Subgroup.closure` API. -/
theorem M24_def : M24 = Subgroup.closure {M24.a, M24.b} :=
  (rfl)

namespace M24

theorem a_mem : a ∈ M24 := M24_def ▸ Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ M24 := M24_def ▸ Subgroup.subset_closure (by simp)

/-! ### Generator orders -/

/- The equations between explicit permutations of `Fin 24` in this file are closed by
`decide +kernel`: the elaborator's `decide` exhausts its recursion depth while evaluating
`Cycle.formPerm`, while the kernel checks each of them directly. -/

theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_b : orderOf b = 3 :=
  have : Fact (Nat.Prime 3) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_a_mul_b : orderOf (a * b) = 23 :=
  have : Fact (Nat.Prime 23) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### The presentation of `M₂₄` holds in the model -/

/-- The images in the permutation model of the generators of the presentation of `M₂₄`: `a` for
the generator of index `0` and `b⁻¹` for the generator of index `1`. -/
def presentationImage (i : Fin SporadicName.M24.presentation.generatorCount) :
    Equiv.Perm (Fin 24) :=
  if (i : ℕ) = 0 then a else b⁻¹

@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.M24.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = a := by
  simp [presentationImage]

@[simp]
theorem presentationImage_one (h : 1 < SporadicName.M24.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = b⁻¹ := by
  simp [presentationImage]

theorem range_presentationImage : Set.range presentationImage = {a, b⁻¹} := by
  have h : SporadicName.M24.presentation.generatorCount = 2 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    by_cases hi : (i : ℕ) = 0 <;> simp [presentationImage, hi]
  · rintro (rfl | rfl)
    · exact ⟨⟨0, by omega⟩, presentationImage_zero _⟩
    · exact ⟨⟨1, by omega⟩, presentationImage_one _⟩

/-- **The relators of `M₂₄` hold in the model.** All seven transcribed relators of the
presentation of `M₂₄` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup :
    ∀ t ∈ SporadicName.M24.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.M24.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_M24`.
  suffices key : ∀ P : GroupPresentation, P = m24Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then a else b⁻¹)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_M24
  rintro P rfl
  simp only [m24Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  decide +kernel

/-- **The images generate the model.** The subgroup generated by the images `a` and `b⁻¹` of the
presentation generators is the permutation model `M24`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = M24 := by
  rw [range_presentationImage, M24_def, Set.insert_eq, Set.insert_eq, Subgroup.closure_union,
    Subgroup.closure_union, Subgroup.closure_singleton_inv]

/-- The homomorphism from the group presented by the presentation of `M₂₄` to
`Equiv.Perm (Fin 24)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.M24.Group →* Equiv.Perm (Fin 24) :=
  SporadicName.M24.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup⟩

@[simp]
theorem presentationHom_of (i : Fin SporadicName.M24.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `M24`. -/
theorem range_presentationHom : presentationHom.range = M24 := by
  rw [MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of, MonoidHom.map_closure,
    ← Set.range_comp, ← closure_range_presentationImage]
  simp [Function.comp_def]

end M24

/-- **The presented group of `M₂₄` maps onto the permutation model.** The group defined by the
presentation of `M₂₄` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `M24`. -/
theorem exists_surjective_M24 :
    ∃ f : SporadicName.M24.Group →* M24, Function.Surjective f :=
  ⟨(MulEquiv.subgroupCongr M24.range_presentationHom).toMonoidHom.comp
      M24.presentationHom.rangeRestrict,
    by
      rw [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom]
      exact (MulEquiv.surjective _).comp M24.presentationHom.rangeRestrict_surjective⟩

/-- The permutation model `M24` is nontrivial: it contains the involution `M24.a`. -/
instance : Nontrivial M24 :=
  M24.nontrivial_iff_exists_ne_one.2 ⟨M24.a, M24.a_mem, by decide +kernel⟩

/-- The group presented by the presentation of `M₂₄` is nontrivial, since it maps onto the
nontrivial permutation model `M24`. -/
instance : Nontrivial SporadicName.M24.Group :=
  exists_surjective_M24.choose_spec.nontrivial

end TauCeti.Sporadic
