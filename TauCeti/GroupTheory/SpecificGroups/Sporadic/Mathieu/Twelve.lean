module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Perm.Cycle.Concrete
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Presentation

/-!
# The permutation model of `M₁₂` and the surjection from its presented group

This file defines the permutation model `TauCeti.Sporadic.M12` of the Mathieu group `M₁₂`: the
subgroup of `Equiv.Perm (Fin 12)` generated by the two permutations `M12.a` and `M12.b` of the
ATLAS files `M12G1-p12aB0.m1` and `M12G1-p12aB0.m2`. The files list the images of the points
`1, …, 12`; the point `i` of a file is the point `i - 1` of `Fin 12`, and each generator is written
as the product of its disjoint cycles in Mathlib's cycle notation. In the files' numbering,

```text
a = (1,4)(3,10)(5,11)(6,12),   b = (1,8,9)(2,3,4)(5,12,11)(6,10,7).
```

So `a` is an involution with four fixed points and `b` has order `3` and no fixed points; the
orders `2`, `3` and `11` of `a`, `b` and `a * b` are recorded as a check on the transcription.
Reading the files as preimages instead of images would replace `b` by `b⁻¹`, which sends `0` to
`8` rather than `7`.

It then shows that the presentation of `M₁₂` carried by `TauCeti.SporadicName.presentation`
(Campbell–Havas–Ramsay–Robertson, relators `(B a)³`, `a⁵ b⁶` and `a b² a B a² b a² b²`) holds in
the model. Its generators `a` and `b` are sent to the permutations

```text
M12.imageA = c[0, 1, 7, 10, 4] * c[2, 11, 5, 6, 8]
M12.imageB = c[0, 7, 2] * c[1, 6, 11, 9, 3, 5] * c[4, 8]
```

of orders `5` and `6`, on which all three transcribed relators evaluate to `1`, with products
composed as in Mathlib, `(σ * τ) i = σ (τ i)`. These two permutations generate the model:
`M12.imageA` and `M12.imageB` are words in the ATLAS generators, and the ATLAS generators are words
in `M12.imageA` and `M12.imageB`. Extending the assignment therefore gives a homomorphism from
`TauCeti.SporadicName.M12.Group` whose range is exactly the model, hence a surjection onto it; in
particular the presented group is nontrivial. The order of the model is not computed here.

## Main declarations

* `TauCeti.Sporadic.M12`: the permutation model of `M₁₂` on `12` points.
* `TauCeti.Sporadic.M12.presentationImage`: the images of the presentation generators.
* `TauCeti.Sporadic.M12.lift_presentationImage_toFreeGroup_eq_one`: every transcribed relator of
  the presentation of `M₁₂` evaluates to `1` at these images.
* `TauCeti.Sporadic.M12.closure_range_presentationImage`: the images generate the model.
* `TauCeti.Sporadic.M12.presentationHom`: the homomorphism from the presented group.
* `TauCeti.Sporadic.exists_surjective_M12`: the presented group maps onto the model.

## References

* R. A. Wilson, R. A. Parker, J. N. Bray et al., *ATLAS of Finite Group Representations*,
  version 3, representation `M12G1-p12aB0`, <https://brauer.maths.qmul.ac.uk/Atlas/v3/>;
  generator image files
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/M12/mtx/M12G1-p12aB0.m1> and
  <https://brauer.maths.qmul.ac.uk/Atlas/spor/M12/mtx/M12G1-p12aB0.m2>.
* C. M. Campbell, G. Havas, C. Ramsay and E. F. Robertson, *Nice efficient presentations for all
  small simple groups and their covers*, LMS J. Comput. Math. 7 (2004), 266–283, Table 2.
-/

public section

namespace TauCeti.Sporadic

/-- The first generator of the permutation model of `M₁₂`, from the ATLAS file `M12G1-p12aB0.m1`:
the involution `(1,4)(3,10)(5,11)(6,12)` of the file, shifted to the points `0, …, 11`. -/
def M12.a : Equiv.Perm (Fin 12) := c[0, 3] * c[2, 9] * c[4, 10] * c[5, 11]

/-- The second generator of the permutation model of `M₁₂`, from the ATLAS file `M12G1-p12aB0.m2`:
the permutation `(1,8,9)(2,3,4)(5,12,11)(6,10,7)` of order `3` of the file, shifted to the points
`0, …, 11`. -/
def M12.b : Equiv.Perm (Fin 12) := c[0, 7, 8] * c[1, 2, 3] * c[4, 11, 10] * c[5, 9, 6]

/-- The permutation model of the Mathieu group `M₁₂`: the subgroup of `Equiv.Perm (Fin 12)`
generated by the permutations `M12.a` and `M12.b` of the ATLAS files `M12G1-p12aB0.m1` and
`M12G1-p12aB0.m2`. -/
def M12 : Subgroup (Equiv.Perm (Fin 12)) := Subgroup.closure {M12.a, M12.b}

namespace M12

theorem a_def : a = c[0, 3] * c[2, 9] * c[4, 10] * c[5, 11] := (rfl)

theorem b_def : b = c[0, 7, 8] * c[1, 2, 3] * c[4, 11, 10] * c[5, 9, 6] := (rfl)

/-- The permutation model `M12` is the subgroup generated by the ATLAS generators. This is the
unfolding lemma for `TauCeti.Sporadic.M12`, whose body is not exposed. -/
theorem M12_def : M12 = Subgroup.closure {a, b} := (rfl)

theorem a_mem : a ∈ M12 := Subgroup.subset_closure (by simp)

theorem b_mem : b ∈ M12 := Subgroup.subset_closure (by simp)

/-! ### Generator orders -/

/- The equations between explicit permutations of `Fin 12` in this file are closed by
`decide +kernel`: the elaborator's `decide` exhausts its recursion depth while evaluating
`Cycle.formPerm`, while the kernel checks each of them directly. -/

theorem orderOf_a : orderOf a = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_b : orderOf b = 3 :=
  have : Fact (Nat.Prime 3) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

theorem orderOf_a_mul_b : orderOf (a * b) = 11 :=
  have : Fact (Nat.Prime 11) := ⟨by decide⟩
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-! ### The presentation of `M₁₂` holds in the model -/

/-- The image in the permutation model of the generator `a` (index `0`) of the presentation of
`M₁₂`: the permutation `c[0, 1, 7, 10, 4] * c[2, 11, 5, 6, 8]` of order `5`. -/
def imageA : Equiv.Perm (Fin 12) := c[0, 1, 7, 10, 4] * c[2, 11, 5, 6, 8]

/-- The image in the permutation model of the generator `b` (index `1`) of the presentation of
`M₁₂`: the permutation `c[0, 7, 2] * c[1, 6, 11, 9, 3, 5] * c[4, 8]` of order `6`. -/
def imageB : Equiv.Perm (Fin 12) := c[0, 7, 2] * c[1, 6, 11, 9, 3, 5] * c[4, 8]

theorem imageA_def : imageA = c[0, 1, 7, 10, 4] * c[2, 11, 5, 6, 8] := (rfl)

theorem imageB_def : imageB = c[0, 7, 2] * c[1, 6, 11, 9, 3, 5] * c[4, 8] := (rfl)

/-- The images in the permutation model of the generators of the presentation of `M₁₂`: `imageA`
for the generator of index `0` and `imageB` for the generator of index `1`. -/
def presentationImage (i : Fin SporadicName.M12.presentation.generatorCount) :
    Equiv.Perm (Fin 12) :=
  if (i : ℕ) = 0 then imageA else imageB

@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.M12.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageA := by
  simp [presentationImage]

@[simp]
theorem presentationImage_one (h : 1 < SporadicName.M12.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageB := by
  simp [presentationImage]

theorem range_presentationImage : Set.range presentationImage = {imageA, imageB} := by
  have h : SporadicName.M12.presentation.generatorCount = 2 := by simp
  exact Set.range_ite_const ⟨⟨0, by omega⟩, rfl⟩ ⟨⟨1, by omega⟩, one_ne_zero⟩

/-- **The relators of `M₁₂` hold in the model.** All three transcribed relators of the
presentation of `M₁₂` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.M12.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.M12.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_M12`.
  suffices key : ∀ P : GroupPresentation, P = m12Presentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦ if (i : ℕ) = 0 then imageA else imageB)
        t.toFreeGroup = 1 from
    key _ SporadicName.presentation_M12
  rintro P rfl
  simp only [m12Presentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_gen, one_ne_zero, ↓reduceIte]
  decide +kernel

/-- `imageA` as a word in the ATLAS generators. -/
theorem imageA_eq :
    imageA = b⁻¹ * a * b * a * b * a * b * a * b⁻¹ * a * b * a * b * a := by
  decide +kernel

/-- `imageB` as a word in the ATLAS generators. -/
theorem imageB_eq : imageB = b⁻¹ * a * b * a * b * a * b⁻¹ * a * b * a := by
  decide +kernel

/-- The ATLAS generator `a` as a word in the images of the presentation generators. -/
theorem a_eq : a = imageA * imageB⁻¹ * imageA⁻¹ * imageB * imageB * imageB * imageA⁻¹ *
    imageB⁻¹ * imageA * imageA * imageB⁻¹ := by
  decide +kernel

/-- The ATLAS generator `b` as a word in the images of the presentation generators. -/
theorem b_eq : b = imageB⁻¹ * imageA * imageB * imageA⁻¹ * imageA⁻¹ * imageB * imageA⁻¹ *
    imageA⁻¹ * imageB⁻¹ * imageA⁻¹ := by
  decide +kernel

/-- **The images generate the model.** The subgroup generated by the images of the presentation
generators is the permutation model `M12`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = M12 := by
  rw [range_presentationImage]
  refine le_antisymm (Subgroup.closure_le _ |>.2 ?_) (Subgroup.closure_le _ |>.2 ?_)
  · have ha := a_mem
    have hb := b_mem
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, imageA_eq, imageB_eq, mul_mem_cancel_right ha,
        mul_mem_cancel_right hb, mul_mem_cancel_right (inv_mem hb), inv_mem hb]
  · have hA : imageA ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    have hB : imageB ∈ Subgroup.closure {imageA, imageB} := Subgroup.subset_closure (by simp)
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, a_eq, b_eq, mul_mem_cancel_right hA, mul_mem_cancel_right hB,
        mul_mem_cancel_right (inv_mem hA), mul_mem_cancel_right (inv_mem hB), inv_mem hB, hA]

/-- The homomorphism from the group presented by the presentation of `M₁₂` to
`Equiv.Perm (Fin 12)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.M12.Group →* Equiv.Perm (Fin 12) :=
  SporadicName.M12.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

@[simp]
theorem presentationHom_of (i : Fin SporadicName.M12.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `M12`. -/
theorem range_presentationHom : presentationHom.range = M12 :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

end M12

/-- **The presented group of `M₁₂` maps onto the permutation model.** The group defined by the
presentation of `M₁₂` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `M12`. -/
theorem exists_surjective_M12 :
    ∃ f : SporadicName.M12.Group →* M12, Function.Surjective f :=
  SporadicName.M12.presentation.exists_surjective_of_closure_range_eq
    ⟨M12.presentationImage, M12.lift_presentationImage_toFreeGroup_eq_one⟩
    M12.closure_range_presentationImage

/-- The permutation model `M12` is nontrivial: it contains the involution `M12.a`. -/
instance : Nontrivial M12 :=
  M12.nontrivial_iff_exists_ne_one.2 ⟨M12.a, M12.a_mem, by decide +kernel⟩

/-- The group presented by the presentation of `M₁₂` is nontrivial, since it maps onto the
nontrivial permutation model `M12`. -/
instance : Nontrivial SporadicName.M12.Group :=
  exists_surjective_M12.choose_spec.nontrivial

end TauCeti.Sporadic
