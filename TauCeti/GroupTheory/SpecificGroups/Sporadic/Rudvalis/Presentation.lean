/-- The image of `v` is its own inverse. -/
@[simp]
theorem imageV_inv : imageV⁻¹ = imageV :=
  -- `imageV` is built by `Function.Involutive.toPerm`, whose inverse function is the function
  -- itself.
  Equiv.ext fun _ ↦ rfl

/-- The image of `t` is its own inverse. -/
@[simp]
theorem imageT_inv : imageT⁻¹ = imageT :=
  -- `imageT` is built by `Function.Involutive.toPerm`, whose inverse function is the function
  -- itself.
  Equiv.ext fun _ ↦ rfl

/-! ### The images and the generators of the model as words in each other -/

/- An equation `σ = w` between a permutation given by a table and a word is checked as
`σ⁻¹ * w = 1`, one row of points at a time. -/

/-- The image of `v` is the square of the second generator of the model. -/
theorem imageV_eq : imageV = b * b :=
  inv_mul_eq_one.mp (Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel))

/-- The image of `t` as a word of 20 letters in the generators of the model. -/
theorem imageT_eq :
    imageT = a * b * b * a * b * b * a * b * a * b * b * a * b⁻¹ * a * b * b * a * b * b * a :=
  inv_mul_eq_one.mp (Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel))

/-- The image of `u` as a word of 52 letters in the generators of the model. -/
theorem imageU_eq :
    imageU = b * a * b * a * b * b * a * b⁻¹ * a * b * b * a * b * b * a * b * a * b * a * b * b *
      a * b⁻¹ * a * b * a * b⁻¹ * a * b⁻¹ * a * b * a * b * b * a * b * b * a * b⁻¹ * a * b * b *
      a * b * b * a * b * b * a * b * a * b⁻¹ :=
  inv_mul_eq_one.mp (Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel))

/-- The first generator of the model as a word of 31 letters in the three images. -/
theorem a_eq :
    a = imageV * imageT * imageU * imageT * imageU * imageU * imageT * imageU⁻¹ * imageT * imageU *
      imageT * imageU⁻¹ * imageT * imageV * imageU⁻¹ * imageT * imageU * imageT * imageU * imageV *
      imageU⁻¹ * imageT * imageU⁻¹ * imageT * imageV * imageT * imageU * imageU * imageT * imageV *
      imageU :=
  inv_mul_eq_one.mp (Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel))

/-- The second generator of the model as a word of 29 letters in the three images. -/
theorem b_eq :
    b = imageT * imageV * imageT * imageU * imageU * imageT * imageU * imageT * imageV * imageT *
      imageU * imageT * imageU⁻¹ * imageT * imageU * imageT * imageV * imageT * imageU * imageV *
      imageT * imageU * imageV * imageU⁻¹ * imageT * imageU⁻¹ * imageT * imageU * imageU :=
  inv_mul_eq_one.mp (Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel))

/-! ### The assignment and the relators -/

/-- The images in the permutation model of the generators of the presentation of `Ru`: the
generators of index `0`, `1` and `2`, which are `u`, `v` and `t`, go to `imageU`, `imageV` and
`imageT`. -/
def presentationImage (i : Fin SporadicName.Ru.presentation.generatorCount) :
    Equiv.Perm (Fin 4060) :=
  if (i : ℕ) = 0 then imageU else if (i : ℕ) = 1 then imageV else imageT

/-- The assignment unfolded: `imageU` at index `0`, `imageV` at index `1` and `imageT`
otherwise. -/
theorem presentationImage_def (i : Fin SporadicName.Ru.presentation.generatorCount) :
    presentationImage i =
      if (i : ℕ) = 0 then imageU else if (i : ℕ) = 1 then imageV else imageT :=
  (rfl)

/-- The generator of index `0` goes to `imageU`. -/
@[simp]
theorem presentationImage_zero (h : 0 < SporadicName.Ru.presentation.generatorCount) :
    presentationImage ⟨0, h⟩ = imageU := by
  simp [presentationImage]

/-- The generator of index `1` goes to `imageV`. -/
@[simp]
theorem presentationImage_one (h : 1 < SporadicName.Ru.presentation.generatorCount) :
    presentationImage ⟨1, h⟩ = imageV := by
  simp [presentationImage]

/-- The generator of index `2` goes to `imageT`. -/
@[simp]
theorem presentationImage_two (h : 2 < SporadicName.Ru.presentation.generatorCount) :
    presentationImage ⟨2, h⟩ = imageT := by
  simp [presentationImage]

/-- The assignment has precisely the three chosen images as its values. -/
theorem range_presentationImage :
    Set.range presentationImage = {imageU, imageV, imageT} := by
  have h : SporadicName.Ru.presentation.generatorCount = 3 := by simp
  ext σ
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨⟨k, hk⟩, rfl⟩
    have hk' : k < 3 := h ▸ hk
    interval_cases k <;> simp
  · rintro (rfl | rfl | rfl)
    exacts [⟨⟨0, by omega⟩, presentationImage_zero _⟩, ⟨⟨1, by omega⟩, presentationImage_one _⟩,
      ⟨⟨2, by omega⟩, presentationImage_two _⟩]

/- The twelve relators are checked one at a time, in the order of the transcription. The first two
say that the images of `v` and `t` are involutions, which their definitions already checked; for
each of the others the kernel evaluates the word at every point. The commutators are those of the
source, written with Mathlib's `⁅x, y⁆ = x * y * x⁻¹ * y⁻¹` at inverted arguments. -/
private theorem relator0 : imageV ^ 2 = 1 := by
  rw [pow_two, mul_eq_one_iff_eq_inv, imageV_inv]

private theorem relator1 : imageT ^ 2 = 1 := by
  rw [pow_two, mul_eq_one_iff_eq_inv, imageT_inv]

private theorem relator2 : imageU ^ 4 = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator3 : (imageU * imageV) ^ 7 = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator4 : (imageU ^ 2 * imageV) ^ 3 = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator5 : ⁅imageT⁻¹, (imageV * imageU * imageV)⁻¹⁆ = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator6 : ⁅imageT⁻¹, (imageU⁻¹ * imageV * imageU)⁻¹⁆ = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator7 : (imageU * imageT) ^ 10 = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator8 : (imageU * imageV * imageU * imageT) ^ 13 = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator9 :
    (imageU * ⁅imageT⁻¹, imageU⁻¹⁻¹⁆ *
      ⁅(imageU⁻¹ ^ 2 * imageT * imageU ^ 2)⁻¹, ⁅imageU⁻¹⁻¹, imageT⁻¹⁆⁻¹⁆) ^ 3 = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator10 :
    (imageU * (imageU * imageV)⁻¹ * imageT * (imageU * imageV) * (imageT * imageU ^ 2) ^ 4 *
      (imageU * imageV)⁻¹ * imageT * imageU * imageV) ^ 2 = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

private theorem relator11 :
    (imageU * imageV * imageT * imageV *
      ⁅((imageU * imageV)⁻¹ * imageT * imageU * imageV)⁻¹, imageU⁻¹⁆ ^ 2) ^ 2 = 1 :=
  Equiv.Perm.eq_one_of_rows (m := 58) (n := 70) _ (by decide +kernel)

/-- **The relators of `Ru` hold in the model.** All twelve transcribed relators of the
presentation of `Ru` evaluate to `1` at `presentationImage`. -/
theorem lift_presentationImage_toFreeGroup_eq_one :
    ∀ t ∈ SporadicName.Ru.presentation.transcribed,
      FreeGroup.lift presentationImage t.toFreeGroup = 1 := by
  -- The type of `presentationImage` mentions `SporadicName.Ru.presentation`, so the statement is
  -- first abstracted over the presentation and then specialized along `presentation_Ru`.
  suffices key : ∀ P : GroupPresentation, P = ruPresentation → ∀ t ∈ P.transcribed,
      FreeGroup.lift (fun i : Fin P.generatorCount ↦
        if (i : ℕ) = 0 then imageU else if (i : ℕ) = 1 then imageV else imageT)
          t.toFreeGroup = 1 from
    key _ SporadicName.presentation_Ru
  rintro P rfl
  simp only [ruPresentation_transcribed, List.mem_cons, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, Relator.lift_toFreeGroup, Relator.eval_mul, Relator.eval_pow,
    Relator.eval_inv, Relator.eval_comm, Relator.eval_gen, one_ne_zero, OfNat.ofNat_ne_zero,
    OfNat.ofNat_ne_one, ↓reduceIte]
  exact ⟨relator0, relator1, relator2, relator3, relator4, relator5, relator6, relator7,
    relator8, relator9, relator10, relator11⟩

/-! ### Orders of the images -/

/-- The image of `u` has order four. -/
theorem orderOf_imageU : orderOf imageU = 4 :=
  orderOf_eq_prime_pow (p := 2) (n := 1) (DFunLike.ne_iff.mpr ⟨0, by decide +kernel⟩)
    (by simpa using relator2)

/-- The image of `v` is an involution. -/
theorem orderOf_imageV : orderOf imageV = 2 :=
  orderOf_eq_prime relator0 (DFunLike.ne_iff.mpr ⟨0, by decide +kernel⟩)

/-- The image of `t` is an involution. -/
theorem orderOf_imageT : orderOf imageT = 2 :=
  orderOf_eq_prime relator1 (DFunLike.ne_iff.mpr ⟨0, by decide +kernel⟩)

/-! ### Generation and the surjection -/

/- Each image is a word in the two generators of the model; the word is peeled from the right. -/

/-- The image of `u` lies in the model. -/
@[simp]
theorem imageU_mem : imageU ∈ Ru := by
  simp only [imageU_eq, mul_mem_cancel_right a_mem, mul_mem_cancel_right b_mem,
    mul_mem_cancel_right (inv_mem b_mem), b_mem]

/-- The image of `v` lies in the model. -/
@[simp]
theorem imageV_mem : imageV ∈ Ru :=
  imageV_eq ▸ mul_mem b_mem b_mem

/-- The image of `t` lies in the model. -/
@[simp]
theorem imageT_mem : imageT ∈ Ru := by
  simp only [imageT_eq, mul_mem_cancel_right a_mem, mul_mem_cancel_right b_mem,
    mul_mem_cancel_right (inv_mem b_mem), a_mem]

/-- Every image of a presentation generator lies in the model. -/
@[simp]
theorem presentationImage_mem (i : Fin SporadicName.Ru.presentation.generatorCount) :
    presentationImage i ∈ Ru := by
  rw [presentationImage_def]
  split_ifs
  exacts [imageU_mem, imageV_mem, imageT_mem]

/-- **The images generate the model.** The subgroup generated by the three images of the
presentation generators is the permutation model `Ru`. -/
theorem closure_range_presentationImage :
    Subgroup.closure (Set.range presentationImage) = Ru := by
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    rintro _ ⟨i, rfl⟩
    exact presentationImage_mem i
  · rw [range_presentationImage, Ru_def]
    refine (Subgroup.closure_le _).mpr ?_
    have hU : imageU ∈ Subgroup.closure ({imageU, imageV, imageT} : Set (Equiv.Perm (Fin 4060))) :=
      Subgroup.subset_closure (by simp)
    have hV : imageV ∈ Subgroup.closure ({imageU, imageV, imageT} : Set (Equiv.Perm (Fin 4060))) :=
      Subgroup.subset_closure (by simp)
    have hT : imageT ∈ Subgroup.closure ({imageU, imageV, imageT} : Set (Equiv.Perm (Fin 4060))) :=
      Subgroup.subset_closure (by simp)
    -- Each generator of the model is a word in the three images.
    rintro σ (rfl | rfl) <;>
    · simp only [SetLike.mem_coe, a_eq, b_eq, mul_mem_cancel_right hU,
        mul_mem_cancel_right (inv_mem hU), mul_mem_cancel_right hV, mul_mem_cancel_right hT, hV, hT]

/-- The homomorphism from the group presented by the presentation of `Ru` to
`Equiv.Perm (Fin 4060)` sending the presentation generators to `presentationImage`. -/
def presentationHom : SporadicName.Ru.Group →* Equiv.Perm (Fin 4060) :=
  SporadicName.Ru.presentation.homEquiv.symm
    ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩

/-- The homomorphism unfolded: the extension of `presentationImage` given by
`GroupPresentation.homEquiv`. -/
theorem presentationHom_def :
    presentationHom = SporadicName.Ru.presentation.homEquiv.symm
      ⟨presentationImage, lift_presentationImage_toFreeGroup_eq_one⟩ :=
  (rfl)

/-- The homomorphism sends each generator of the presented group to its chosen image. -/
@[simp]
theorem presentationHom_of (i : Fin SporadicName.Ru.presentation.generatorCount) :
    presentationHom (PresentedGroup.of i) = presentationImage i :=
  GroupPresentation.homEquiv_symm_apply_of _ _ i

/-- The range of `presentationHom` is the permutation model `Ru`. -/
@[simp]
theorem range_presentationHom : presentationHom.range = Ru :=
  (GroupPresentation.range_homEquiv_symm _ _).trans closure_range_presentationImage

/-- Every value of `presentationHom` lies in the model. -/
@[simp]
theorem presentationHom_mem (g : SporadicName.Ru.Group) : presentationHom g ∈ Ru :=
  range_presentationHom ▸ MonoidHom.mem_range.mpr ⟨g, rfl⟩

end Ru

/-- **The presented group of `Ru` maps onto the permutation model.** The group defined by the
presentation of `Ru` carried by `TauCeti.SporadicName.presentation` has a surjective homomorphism
onto `Ru`. -/
theorem exists_surjective_Ru :
    ∃ f : SporadicName.Ru.Group →* Ru, Function.Surjective f :=
  SporadicName.Ru.presentation.exists_surjective_of_closure_range_eq
    ⟨Ru.presentationImage, Ru.lift_presentationImage_toFreeGroup_eq_one⟩
    Ru.closure_range_presentationImage

/-- The group presented by the presentation of `Ru` is nontrivial, since it maps onto the
nontrivial permutation model `Ru`. -/
instance : Nontrivial SporadicName.Ru.Group :=
  exists_surjective_Ru.choose_spec.nontrivial

end TauCeti.Sporadic
