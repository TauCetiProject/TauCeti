import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# Point stabilizers, Sylow `3`-subgroups, and complements of `kleinFour` in degree four

Let `α` be a finite type. The Klein four-subgroup `alternatingGroup.kleinFour α` of
`alternatingGroup α`, generated by permutations of cycle type `{2, 2}`, is unconditionally normal
in both `alternatingGroup α` and `Equiv.Perm α`. It is trivial if and only if `Nat.card α < 4`,
equals `⊤` for `5 ≤ Nat.card α`, and for `Nat.card α = 4` has cardinality `4` with every
nonidentity element having full support. Thus `kleinFour α` is abelian (equivalently a `2`-group,
and acting freely on `α`) precisely when `Nat.card α ≤ 4`, and acts transitively on `α` whenever
`4 ≤ Nat.card α`.

Specializing to `Nat.card α = 4`, orbit evaluation `v ↦ v • a` at any basepoint `a : α` is an
equivalence `kleinFour α ≃ α` (`alternatingGroup.kleinFourOrbitEquiv`), so `kleinFour α` acts
sharply transitively on `α`. Consequently, for each `a : α`, the point stabilizer
`MulAction.stabilizer (alternatingGroup α) a` is a complement of `kleinFour α` in
`alternatingGroup α` of cardinality `3`. Conversely, every subgroup of `alternatingGroup α` of
cardinality `3` is a `3`-group acting on the `4`-element type `α`, hence fixes a point by
`IsPGroup.nonempty_fixed_point_of_prime_not_dvd_card` and coincides with that point's stabilizer.
This identifies the four elements of `α`, the four point stabilizers, the four Sylow `3`-subgroups
of `alternatingGroup α`, and the four complements of `kleinFour α`.

Finally, a point stabilizer in `alternatingGroup α` is trivial if and only if `Nat.card α < 4`,
and whenever `4 ≤ Nat.card α`, distinct points of `α` have distinct stabilizers in
`alternatingGroup α` (`alternatingGroup.stabilizer_injective`), so each point stabilizer is
self-normalizing in `alternatingGroup α` (`alternatingGroup.normalizer_stabilizer`) and its image
in `Equiv.Perm α` has normalizer equal to `MulAction.stabilizer (Equiv.Perm α) a`
(`alternatingGroup.normalizer_map_subtype_stabilizer`).

## Main definitions

* `alternatingGroup.kleinFourOrbitEquiv`: the equivalence `kleinFour α ≃ α` sending `v` to `v • a`.
* `alternatingGroup.stabilizerThreeSylow`: the point stabilizer of `a : α` packaged as a
  `Sylow 3 (alternatingGroup α)`.
* `alternatingGroup.stabilizerThreeSylowEquiv`: the bijection `α ≃ Sylow 3 (alternatingGroup α)`.
* `alternatingGroup.kleinFourComplementEquiv`: the bijection
  `α ≃ {D : Subgroup (alternatingGroup α) // (kleinFour α).IsComplement' D}`.

## Main results

* `alternatingGroup.kleinFour_eq_bot_iff`, `alternatingGroup.kleinFour_eq_top_of_five_le_card`:
  `kleinFour α = ⊥ ↔ Nat.card α < 4`, and `kleinFour α = ⊤` when `5 ≤ Nat.card α`.
* `alternatingGroup.isMulCommutative_kleinFour_iff`, `alternatingGroup.isPGroup_two_kleinFour_iff`:
  `kleinFour α` is commutative (and is a `2`-group) if and only if `Nat.card α ≤ 4`.
* `alternatingGroup.smul_eq_self_iff_of_mem_kleinFour`: when `Nat.card α ≤ 4`, an element of
  `kleinFour α` fixes a point if and only if it is `1`.
* `alternatingGroup.isPretransitive_kleinFour`, `alternatingGroup.smul_left_injective_kleinFour`:
  `kleinFour α` acts transitively when `4 ≤ Nat.card α` and freely when `Nat.card α ≤ 4`.
* `alternatingGroup.isComplement'_kleinFour_stabilizer`: every point stabilizer complements
  `kleinFour α` in `alternatingGroup α` when `Nat.card α = 4`.
* `alternatingGroup.isComplement'_kleinFour_iff_exists_stabilizer`: when `Nat.card α = 4`, the
  complements of `kleinFour α` are precisely the point stabilizers
  `MulAction.stabilizer (alternatingGroup α) a`.
* `alternatingGroup.stabilizer_eq_bot_iff`, `alternatingGroup.stabilizer_injective`,
  `alternatingGroup.normalizer_stabilizer`, `alternatingGroup.normalizer_map_subtype_stabilizer`:
  triviality (`Nat.card α < 4`), injectivity, and normalizers of point stabilizers
  (`4 ≤ Nat.card α`).
-/

public section

open scoped Pointwise

namespace alternatingGroup

open Equiv Equiv.Perm

variable {α : Type*} [DecidableEq α] [Fintype α]

/-! ### Unconditional normality, commutativity, and action of `kleinFour α` -/

/-- Viewed in `Equiv.Perm α`, `kleinFour α` is normal in the full symmetric group for every finite
type `α`, since conjugation by any permutation preserves evenness and cycle type `{2, 2}`. -/
instance instNormalMapSubtypeKleinFour :
    ((kleinFour α).map (alternatingGroup α).subtype).Normal where
  conj_mem n hn σ := by
    have hle : (kleinFour α).map (alternatingGroup α).subtype ≤
        ((kleinFour α).map (alternatingGroup α).subtype).comap
          (MulAut.conj σ : Perm α →* Perm α) := by
      conv_lhs => rw [kleinFour, MonoidHom.map_closure]
      rw [Subgroup.closure_le]
      rintro _ ⟨x, hx, rfl⟩
      exact ⟨⟨σ * (x : Perm α) * σ⁻¹, alternatingGroup.normal.conj_mem _ x.property σ⟩,
        Subgroup.subset_closure (cycleType_conj.trans hx), rfl⟩
    exact hle hn

/-- `kleinFour α` is normal in `alternatingGroup α` for every finite type `α` (without any
cardinality assumption), since conjugation preserves cycle type `{2, 2}`. -/
instance instNormalKleinFour : (kleinFour α).Normal := by
  rw [← Subgroup.comap_map_eq_self_of_injective
    (alternatingGroup α).subtype_injective (kleinFour α)]
  infer_instance

omit [DecidableEq α] [Fintype α] in
private theorem exists_distinct_of_four_le_card (hα : 4 ≤ Nat.card α) {a b : α} (hab : a ≠ b) :
    ∃ c d : α, c ≠ a ∧ c ≠ b ∧ d ≠ a ∧ d ≠ b ∧ c ≠ d := by
  classical
  have : Finite α := Nat.finite_of_card_ne_zero (by omega)
  let _ := Fintype.ofFinite α
  have hcard : 4 ≤ Fintype.card α := by rwa [← Nat.card_eq_fintype_card]
  have hgt : 1 < (({a, b} : Finset α)ᶜ).card := by
    rw [Finset.card_compl, Finset.card_pair hab]
    omega
  obtain ⟨c, hc, d, hd, hcd⟩ := Finset.one_lt_card.mp hgt
  simp only [Finset.mem_compl, Finset.mem_insert, Finset.mem_singleton, not_or] at hc hd
  exact ⟨c, d, hc.1, hc.2, hd.1, hd.2, hcd⟩

/-- The action of `kleinFour α` on `α` is transitive whenever `4 ≤ Nat.card α`. -/
theorem isPretransitive_kleinFour (hα : 4 ≤ Nat.card α) :
    MulAction.IsPretransitive (kleinFour α) α where
  exists_smul_eq a b := by
    by_cases hab : a = b
    · exact ⟨1, by rw [one_smul, hab]⟩
    · obtain ⟨c, d, hca, hcb, hda, hdb, hcd⟩ := exists_distinct_of_four_le_card hα hab
      have hct : (swap a b * swap c d).cycleType = {2, 2} :=
        cycleType_swap_mul_swap_of_nodup (by
          simp [hab, hca.symm, hda.symm, hcb.symm, hdb.symm, hcd])
      have heven : swap a b * swap c d ∈ alternatingGroup α :=
        mem_alternatingGroup.mpr (by rw [map_mul, sign_swap hab, sign_swap hcd]; decide)
      refine ⟨⟨⟨swap a b * swap c d, heven⟩, Subgroup.subset_closure hct⟩, ?_⟩
      change (swap a b * swap c d) a = b
      rw [Perm.mul_apply, swap_apply_of_ne_of_ne hca.symm hda.symm, swap_apply_left]

/-- `kleinFour α` is trivial if and only if `Nat.card α < 4`. -/
theorem kleinFour_eq_bot_iff : kleinFour α = ⊥ ↔ Nat.card α < 4 := by
  refine ⟨fun hbot => ?_, fun hα => ?_⟩
  · by_contra hge
    have h4 : 4 ≤ Nat.card α := by omega
    have : Nontrivial α := Finite.one_lt_card_iff_nontrivial.mp (by omega)
    obtain ⟨a, b, hab⟩ := exists_pair_ne α
    have := isPretransitive_kleinFour h4
    obtain ⟨v, hv⟩ := MulAction.exists_smul_eq (kleinFour α) a b
    have hv1 : v = 1 := Subtype.ext (Subgroup.mem_bot.mp (hbot ▸ v.property))
    rw [hv1, one_smul] at hv
    exact hab hv
  · rw [kleinFour, eq_bot_iff, Subgroup.closure_le]
    intro g hg
    exfalso
    have hsum : (g : Perm α).support.card = 4 := by
      rw [← sum_cycleType, hg]
      decide
    have hle : (g : Perm α).support.card ≤ Nat.card α := by
      rw [Nat.card_eq_fintype_card]
      exact Finset.card_le_univ _
    omega

/-- When `5 ≤ Nat.card α`, `kleinFour α` is the entire alternating group `alternatingGroup α`
(by simplicity of `alternatingGroup α`). -/
theorem kleinFour_eq_top_of_five_le_card (hα : 5 ≤ Nat.card α) : kleinFour α = ⊤ :=
  (normal_subgroup_eq_bot_or_eq_top hα).resolve_left (by rw [kleinFour_eq_bot_iff]; omega)

/-- `kleinFour α` is commutative if and only if `Nat.card α ≤ 4`: it is trivial for
`Nat.card α < 4`, a Klein four-group for `Nat.card α = 4`, and equals the nonabelian simple group
`alternatingGroup α` for `5 ≤ Nat.card α`. -/
theorem isMulCommutative_kleinFour_iff :
    IsMulCommutative (kleinFour α) ↔ Nat.card α ≤ 4 := by
  refine ⟨fun hcomm => ?_, fun hα => ?_⟩
  · by_contra hgt
    have h5 : 5 ≤ Nat.card α := by omega
    have htop : kleinFour α = ⊤ := kleinFour_eq_top_of_five_le_card h5
    have hcommA : IsMulCommutative (alternatingGroup α) :=
      ⟨⟨fun x y => congrArg Subtype.val
        (hcomm.is_comm.comm ⟨x, htop ▸ Subgroup.mem_top x⟩ ⟨y, htop ▸ Subgroup.mem_top y⟩)⟩⟩
    have hle3 : Nat.card α ≤ 3 := isMulCommutative_iff_card_le_three.mp hcommA
    omega
  · rcases hα.eq_or_lt with hα4 | hαlt
    · exact (kleinFour_isKleinFour hα4).isMulCommutative
    · rw [kleinFour_eq_bot_iff.mpr hαlt]
      infer_instance

/-- `kleinFour α` is a `2`-group if and only if `Nat.card α ≤ 4`. -/
theorem isPGroup_two_kleinFour_iff : IsPGroup 2 (kleinFour α) ↔ Nat.card α ≤ 4 := by
  refine ⟨fun hp => ?_, fun hα => ?_⟩
  · by_contra hgt
    have h5 : 5 ≤ Nat.card α := by omega
    have : Nontrivial α := Finite.one_lt_card_iff_nontrivial.mp (by omega)
    obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hp
    rw [kleinFour_eq_top_of_five_le_card h5, Subgroup.card_top] at hn
    have h2 : 2 ^ (n + 1) = (Nat.card α).factorial := by
      rw [pow_succ', ← hn, two_mul_nat_card_alternatingGroup, Nat.card_perm]
    have h3 : 3 ∣ 2 ^ (n + 1) :=
      h2 ▸ dvd_trans (by decide : 3 ∣ Nat.factorial 5) (Nat.factorial_dvd_factorial h5)
    exact absurd (Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3) (by decide)
  · rcases hα.eq_or_lt with hα4 | hαlt
    · exact IsPGroup.of_card (n := 2) (kleinFour_card_of_card_eq_four hα4)
    · rw [kleinFour_eq_bot_iff.mpr hαlt]
      exact IsPGroup.of_bot

/-- When `Nat.card α ≤ 4`, an element of `kleinFour α` fixes a point of `α` if and only if it is
the identity: for `Nat.card α < 4` the subgroup is trivial, and for `Nat.card α = 4` every
nonidentity element has cycle type `{2, 2}` and hence full support. -/
theorem smul_eq_self_iff_of_mem_kleinFour (hα : Nat.card α ≤ 4) {g : alternatingGroup α}
    (hg : g ∈ kleinFour α) (a : α) : g • a = a ↔ g = 1 := by
  rcases hα.eq_or_lt with hα4 | hαlt
  · refine ⟨fun ha => ?_, fun h => by rw [h, one_smul]⟩
    rw [← SetLike.mem_coe, coe_kleinFour_of_card_eq_four hα4] at hg
    rcases hg with rfl | hct
    · rfl
    · exfalso
      have hcard : Fintype.card α = 4 := Nat.card_eq_fintype_card.symm.trans hα4
      have hsum : (g : Perm α).support.card = Fintype.card α := by
        rw [← sum_cycleType, hct, hcard]
        decide
      have huniv : (g : Perm α).support = Finset.univ := Finset.eq_univ_of_card _ hsum
      exact (mem_support.mp (huniv ▸ Finset.mem_univ a)) ha
  · rw [kleinFour_eq_bot_iff.mpr hαlt, Subgroup.mem_bot] at hg
    simp [hg]

/-- Every point stabilizer for the action of `kleinFour α` on a type with `Nat.card α ≤ 4` is
trivial. -/
theorem stabilizer_kleinFour_eq_bot (hα : Nat.card α ≤ 4) (a : α) :
    MulAction.stabilizer (kleinFour α) a = ⊥ := by
  ext v
  rw [MulAction.mem_stabilizer_iff, Subgroup.mem_bot, Subtype.ext_iff]
  exact smul_eq_self_iff_of_mem_kleinFour hα v.property a

/-- Orbit evaluation `v ↦ v • a` from `kleinFour α` to `α` is injective whenever
`Nat.card α ≤ 4`. -/
theorem smul_left_injective_kleinFour (hα : Nat.card α ≤ 4) (a : α) :
    Function.Injective (fun v : kleinFour α => v • a) := by
  intro v₁ v₂ (h : v₁ • a = v₂ • a)
  have hfix : ((v₁⁻¹ * v₂ : kleinFour α) : alternatingGroup α) • a = a := by
    rw [Subgroup.coe_mul, mul_smul, ← Subgroup.smul_def, ← Subgroup.smul_def, ← h, inv_smul_smul]
  have hone : ((v₁⁻¹ * v₂ : kleinFour α) : alternatingGroup α) = 1 :=
    (smul_eq_self_iff_of_mem_kleinFour hα (v₁⁻¹ * v₂).property a).mp hfix
  exact inv_mul_eq_one.mp (Subtype.ext hone)

/-- Orbit evaluation `v ↦ v • a` from `kleinFour α` to a `4`-element type `α` is bijective. -/
theorem bijective_kleinFour_smul (hα4 : Nat.card α = 4) (a : α) :
    Function.Bijective (fun v : kleinFour α => v • a) := by
  let _ := Fintype.ofFinite (kleinFour α)
  refine (Fintype.bijective_iff_injective_and_card _).mpr
    ⟨smul_left_injective_kleinFour hα4.le a, ?_⟩
  rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
    kleinFour_card_of_card_eq_four hα4, hα4]

/-- For `Nat.card α = 4` and a basepoint `a : α`, orbit evaluation `v ↦ v • a` identifies
`kleinFour α` with `α`. -/
noncomputable def kleinFourOrbitEquiv (hα4 : Nat.card α = 4) (a : α) : kleinFour α ≃ α :=
  Equiv.ofBijective (fun v => v • a) (bijective_kleinFour_smul hα4 a)

/-- `kleinFourOrbitEquiv hα4 a` evaluates on `v` as `v • a`. -/
@[simp]
theorem kleinFourOrbitEquiv_apply (hα4 : Nat.card α = 4) (a : α) (v : kleinFour α) :
    kleinFourOrbitEquiv hα4 a v = v • a := (rfl)

/-- The inverse of `kleinFourOrbitEquiv hα4 a` maps the basepoint `a` to `1`. -/
@[simp]
theorem kleinFourOrbitEquiv_symm_self (hα4 : Nat.card α = 4) (a : α) :
    (kleinFourOrbitEquiv hα4 a).symm a = 1 := by
  rw [Equiv.symm_apply_eq, kleinFourOrbitEquiv_apply, one_smul]

/-- Acting on `a` by `(kleinFourOrbitEquiv hα4 a).symm b` recovers `b`. -/
@[simp]
theorem kleinFourOrbitEquiv_symm_smul (hα4 : Nat.card α = 4) (a b : α) :
    (kleinFourOrbitEquiv hα4 a).symm b • a = b :=
  (kleinFourOrbitEquiv hα4 a).apply_symm_apply b

/-- `(kleinFourOrbitEquiv hα4 a).symm b = v` if and only if `v • a = b`. -/
theorem kleinFourOrbitEquiv_symm_eq_iff (hα4 : Nat.card α = 4) (a b : α) (v : kleinFour α) :
    (kleinFourOrbitEquiv hα4 a).symm b = v ↔ v • a = b :=
  (kleinFourOrbitEquiv hα4 a).symm_apply_eq.trans eq_comm

/-- For any two points `a, b : α` of a `4`-element type, there is a unique `v : kleinFour α`
sending `a` to `b`. -/
theorem existsUnique_kleinFour_smul_eq (hα4 : Nat.card α = 4) (a b : α) :
    ∃! v : kleinFour α, v • a = b :=
  (kleinFourOrbitEquiv hα4 a).bijective.existsUnique b

/-! ### Point stabilizers, Sylow `3`-subgroups, and complements of `kleinFour α` -/

/-- `kleinFour α` meets every point stabilizer trivially when `Nat.card α ≤ 4`. -/
theorem kleinFour_inf_stabilizer_eq_bot (hα : Nat.card α ≤ 4) (a : α) :
    kleinFour α ⊓ MulAction.stabilizer (alternatingGroup α) a = ⊥ := by
  rw [eq_bot_iff]
  rintro g ⟨hgK, hgS⟩
  exact Subgroup.mem_bot.mpr ((smul_eq_self_iff_of_mem_kleinFour hα hgK a).mp hgS)

/-- Every point stabilizer of `alternatingGroup α` is a complement of `kleinFour α` when
`Nat.card α = 4`. -/
theorem isComplement'_kleinFour_stabilizer (hα4 : Nat.card α = 4) (a : α) :
    (kleinFour α).IsComplement' (MulAction.stabilizer (alternatingGroup α) a) := by
  refine Subgroup.isComplement'_of_disjoint_and_mul_eq_univ
    (disjoint_iff.mpr (kleinFour_inf_stabilizer_eq_bot hα4.le a)) ?_
  rw [Set.eq_univ_iff_forall]
  intro g
  let v : kleinFour α := (kleinFourOrbitEquiv hα4 a).symm (g • a)
  refine ⟨v, v.property, (v : alternatingGroup α)⁻¹ * g, ?_, mul_inv_cancel_left _ _⟩
  rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff, mul_smul, inv_smul_eq_iff]
  exact (kleinFourOrbitEquiv_symm_smul hα4 a (g • a)).symm

/-- Every point stabilizer of `alternatingGroup α` has cardinality `3` when `Nat.card α = 4`. -/
theorem card_stabilizer_of_card_eq_four (hα4 : Nat.card α = 4) (a : α) :
    Nat.card (MulAction.stabilizer (alternatingGroup α) a) = 3 := by
  have hmul : Nat.card (kleinFour α) * Nat.card (MulAction.stabilizer (alternatingGroup α) a) =
      Nat.card (alternatingGroup α) :=
    (Nat.card_prod _ _).symm.trans
      (Nat.card_congr (isComplement'_kleinFour_stabilizer hα4 a).equiv.symm)
  rw [kleinFour_card_of_card_eq_four hα4, card_of_card_eq_four hα4] at hmul
  omega

private theorem eq_one_of_card_support_le_two {g : alternatingGroup α}
    (hle : (g : Perm α).support.card ≤ 2) : g = 1 := by
  have hne1 : (g : Perm α).support.card ≠ 1 := card_support_ne_one (g : Perm α)
  have hne2 : (g : Perm α).support.card ≠ 2 := by
    intro h2
    have hsign := (card_support_eq_two.mp h2).sign_eq
    have halt := mem_alternatingGroup.mp g.property
    rw [hsign] at halt
    exact absurd halt (by decide)
  have h0 : (g : Perm α).support.card = 0 := by omega
  exact Subtype.ext (support_eq_empty_iff.mp (Finset.card_eq_zero.mp h0))

/-- An even permutation of a type with `Nat.card α ≤ 4` fixing two distinct points is the
identity. -/
theorem eq_one_of_mem_stabilizer_of_mem_stabilizer (hα : Nat.card α ≤ 4) {a b : α}
    (hab : a ≠ b) {g : alternatingGroup α}
    (ha : g ∈ MulAction.stabilizer (alternatingGroup α) a)
    (hb : g ∈ MulAction.stabilizer (alternatingGroup α) b) : g = 1 := by
  refine eq_one_of_card_support_le_two ?_
  have hsub : (g : Perm α).support ⊆ ({a, b} : Finset α)ᶜ := by
    intro x hx
    rw [Finset.mem_compl, Finset.mem_insert, Finset.mem_singleton]
    rintro (rfl | rfl)
    · exact mem_support.mp hx ha
    · exact mem_support.mp hx hb
  have hcard : Fintype.card α ≤ 4 := by rwa [← Nat.card_eq_fintype_card]
  refine (Finset.card_le_card hsub).trans ?_
  rw [Finset.card_compl, Finset.card_pair hab]
  omega

/-- Distinct points of a type with `Nat.card α ≤ 4` have trivially intersecting stabilizers in
`alternatingGroup α`. -/
theorem stabilizer_inf_stabilizer_eq_bot (hα : Nat.card α ≤ 4) {a b : α} (hab : a ≠ b) :
    MulAction.stabilizer (alternatingGroup α) a ⊓
      MulAction.stabilizer (alternatingGroup α) b = ⊥ := by
  rw [eq_bot_iff]
  rintro g ⟨ha, hb⟩
  exact Subgroup.mem_bot.mpr (eq_one_of_mem_stabilizer_of_mem_stabilizer hα hab ha hb)

/-- Distinct points have distinct stabilizers in `alternatingGroup α` whenever
`4 ≤ Nat.card α`. -/
theorem stabilizer_injective (hα : 4 ≤ Nat.card α) :
    Function.Injective (MulAction.stabilizer (alternatingGroup α) : α → _) := by
  intro a b h
  by_contra hab
  obtain ⟨c, d, hca, hcb, hda, hdb, hcd⟩ := exists_distinct_of_four_le_card hα hab
  let g : alternatingGroup α :=
    ⟨swap b c * swap c d,
      mem_alternatingGroup.mpr (by rw [map_mul, sign_swap hcb.symm, sign_swap hcd]; decide)⟩
  have hga : g ∈ MulAction.stabilizer (alternatingGroup α) a := by
    change (swap b c * swap c d) a = a
    rw [Perm.mul_apply, swap_apply_of_ne_of_ne hca.symm hda.symm,
      swap_apply_of_ne_of_ne hab hca.symm]
  have hgb : g ∈ MulAction.stabilizer (alternatingGroup α) b := h ▸ hga
  change (swap b c * swap c d) b = b at hgb
  rw [Perm.mul_apply, swap_apply_of_ne_of_ne hcb.symm hdb.symm, swap_apply_left] at hgb
  exact hcb hgb

/-- A point stabilizer in `alternatingGroup α` is trivial if and only if `Nat.card α < 4`. -/
theorem stabilizer_eq_bot_iff (a : α) :
    MulAction.stabilizer (alternatingGroup α) a = ⊥ ↔ Nat.card α < 4 := by
  refine ⟨fun hbot => ?_, fun hα => ?_⟩
  · by_contra hge
    have h4 : 4 ≤ Nat.card α := by omega
    have : Nontrivial α := Finite.one_lt_card_iff_nontrivial.mp (by omega)
    obtain ⟨b, hba⟩ := exists_ne a
    have := isPretransitive_kleinFour h4
    obtain ⟨v, hva⟩ := MulAction.exists_smul_eq (kleinFour α) a b
    have hstab : MulAction.stabilizer (alternatingGroup α) b =
        MulAction.stabilizer (alternatingGroup α) a := by
      rw [← hva, Subgroup.smul_def, MulAction.stabilizer_smul_eq_stabilizer_map_conj,
        hbot, Subgroup.map_bot]
    exact hba (stabilizer_injective h4 hstab)
  · rw [eq_bot_iff]
    intro g hg
    refine Subgroup.mem_bot.mpr (eq_one_of_card_support_le_two ?_)
    have hsub : (g : Perm α).support ⊆ ({a} : Finset α)ᶜ := by
      intro x hx
      rw [Finset.mem_compl, Finset.mem_singleton]
      rintro rfl
      exact mem_support.mp hx hg
    have hcard : Fintype.card α < 4 := by rwa [← Nat.card_eq_fintype_card]
    refine (Finset.card_le_card hsub).trans ?_
    rw [Finset.card_compl, Finset.card_singleton]
    omega

/-- Every subgroup of `alternatingGroup α` of cardinality `3` is the stabilizer of a point when
`Nat.card α = 4`. -/
theorem eq_stabilizer_of_card_eq_three (hα4 : Nat.card α = 4)
    {D : Subgroup (alternatingGroup α)} (hD : Nat.card D = 3) :
    ∃ a : α, D = MulAction.stabilizer (alternatingGroup α) a := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hp : IsPGroup 3 D := IsPGroup.of_card (n := 1) (by simpa using hD)
  obtain ⟨a, ha⟩ := hp.nonempty_fixed_point_of_prime_not_dvd_card α (by rw [hα4]; decide)
  refine ⟨a, Subgroup.eq_of_le_of_card_ge (fun g hg => ?_) ?_⟩
  · exact ha ⟨g, hg⟩
  · rw [hD, card_stabilizer_of_card_eq_four hα4 a]

/-- A subgroup of `alternatingGroup α` has cardinality `3` if and only if it is a point stabilizer
when `Nat.card α = 4`. -/
theorem card_eq_three_iff_exists_stabilizer (hα4 : Nat.card α = 4)
    (D : Subgroup (alternatingGroup α)) :
    Nat.card D = 3 ↔ ∃ a : α, D = MulAction.stabilizer (alternatingGroup α) a := by
  refine ⟨eq_stabilizer_of_card_eq_three hα4, ?_⟩
  rintro ⟨a, rfl⟩
  exact card_stabilizer_of_card_eq_four hα4 a

private theorem pow_three_factorization_twelve : 3 ^ (Nat.factorization 12) 3 = 3 := by
  have h12 : 12 = 2 ^ 2 * 3 := by decide
  rw [h12, Nat.factorization_mul_apply_of_coprime (by decide),
    Nat.factorization_eq_zero_of_not_dvd (by decide), Nat.prime_three.factorization_self]
  simp

/-- Every Sylow `3`-subgroup of `alternatingGroup α` has cardinality `3` when
`Nat.card α = 4`. -/
theorem card_three_sylow_of_card_eq_four (hα4 : Nat.card α = 4)
    (P : Sylow 3 (alternatingGroup α)) : Nat.card P = 3 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  rw [Sylow.card_eq_multiplicity, card_of_card_eq_four hα4]
  exact pow_three_factorization_twelve

/-- The point stabilizer of `a : α` in `alternatingGroup α` packaged as a Sylow `3`-subgroup when
`Nat.card α = 4`. -/
noncomputable def stabilizerThreeSylow (hα4 : Nat.card α = 4) (a : α) :
    Sylow 3 (alternatingGroup α) :=
  letI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  Sylow.ofCard (MulAction.stabilizer (alternatingGroup α) a)
    (by rw [card_stabilizer_of_card_eq_four hα4 a, card_of_card_eq_four hα4]
        exact pow_three_factorization_twelve.symm)

/-- The underlying subgroup of `stabilizerThreeSylow hα4 a` is the point stabilizer of `a`. -/
@[simp]
theorem coe_stabilizerThreeSylow (hα4 : Nat.card α = 4) (a : α) :
    (stabilizerThreeSylow hα4 a : Subgroup (alternatingGroup α)) =
      MulAction.stabilizer (alternatingGroup α) a := (rfl)

/-- For `Nat.card α = 4`, `a ↦ stabilizerThreeSylow hα4 a` is a bijection between `α` and the
Sylow `3`-subgroups of `alternatingGroup α`. -/
noncomputable def stabilizerThreeSylowEquiv (hα4 : Nat.card α = 4) :
    α ≃ Sylow 3 (alternatingGroup α) :=
  Equiv.ofBijective (stabilizerThreeSylow hα4)
    ⟨fun a b h => stabilizer_injective hα4.ge (congrArg Sylow.toSubgroup h),
      fun P => by
        obtain ⟨a, ha⟩ := eq_stabilizer_of_card_eq_three hα4
          (card_three_sylow_of_card_eq_four hα4 P)
        exact ⟨a, Sylow.ext ha.symm⟩⟩

/-- `stabilizerThreeSylowEquiv hα4` sends `a` to `stabilizerThreeSylow hα4 a`. -/
@[simp]
theorem stabilizerThreeSylowEquiv_apply (hα4 : Nat.card α = 4) (a : α) :
    stabilizerThreeSylowEquiv hα4 a = stabilizerThreeSylow hα4 a := (rfl)

/-- A subgroup of `alternatingGroup α` complements `kleinFour α` if and only if it has
cardinality `3`, when `Nat.card α = 4`. -/
theorem isComplement'_kleinFour_iff_card_eq_three (hα4 : Nat.card α = 4)
    (D : Subgroup (alternatingGroup α)) :
    (kleinFour α).IsComplement' D ↔ Nat.card D = 3 := by
  refine ⟨fun h => ?_, fun hD => ?_⟩
  · have hmul : Nat.card (kleinFour α) * Nat.card D = Nat.card (alternatingGroup α) :=
      (Nat.card_prod _ _).symm.trans (Nat.card_congr h.equiv.symm)
    rw [kleinFour_card_of_card_eq_four hα4, card_of_card_eq_four hα4] at hmul
    omega
  · obtain ⟨a, rfl⟩ := eq_stabilizer_of_card_eq_three hα4 hD
    exact isComplement'_kleinFour_stabilizer hα4 a

/-- A subgroup of `alternatingGroup α` complements `kleinFour α` if and only if it is the
point stabilizer of some `a : α`, when `Nat.card α = 4`. -/
theorem isComplement'_kleinFour_iff_exists_stabilizer (hα4 : Nat.card α = 4)
    (D : Subgroup (alternatingGroup α)) :
    (kleinFour α).IsComplement' D ↔
      ∃ a : α, D = MulAction.stabilizer (alternatingGroup α) a :=
  (isComplement'_kleinFour_iff_card_eq_three hα4 D).trans
    (card_eq_three_iff_exists_stabilizer hα4 D)

/-- A subgroup of `alternatingGroup α` complements `kleinFour α` if and only if it is a Sylow
`3`-subgroup of `alternatingGroup α`, when `Nat.card α = 4`. -/
theorem isComplement'_kleinFour_iff_exists_sylow (hα4 : Nat.card α = 4)
    (D : Subgroup (alternatingGroup α)) :
    (kleinFour α).IsComplement' D ↔ ∃ P : Sylow 3 (alternatingGroup α), D = P := by
  rw [isComplement'_kleinFour_iff_exists_stabilizer hα4]
  refine ⟨?_, ?_⟩
  · rintro ⟨a, rfl⟩
    exact ⟨stabilizerThreeSylow hα4 a, rfl⟩
  · rintro ⟨P, rfl⟩
    obtain ⟨a, rfl⟩ := (stabilizerThreeSylowEquiv hα4).surjective P
    exact ⟨a, rfl⟩

/-- Point stabilizers parameterize all complements of `kleinFour α` in `alternatingGroup α` when
`Nat.card α = 4`. -/
noncomputable def kleinFourComplementEquiv (hα4 : Nat.card α = 4) :
    α ≃ {D : Subgroup (alternatingGroup α) // (kleinFour α).IsComplement' D} :=
  Equiv.ofBijective
    (fun a => ⟨MulAction.stabilizer (alternatingGroup α) a,
      isComplement'_kleinFour_stabilizer hα4 a⟩)
    ⟨fun a b h => stabilizer_injective hα4.ge (congrArg Subtype.val h),
      fun ⟨D, hD⟩ => by
        obtain ⟨a, rfl⟩ := (isComplement'_kleinFour_iff_exists_stabilizer hα4 D).mp hD
        exact ⟨a, rfl⟩⟩

/-- The underlying complement of `kleinFourComplementEquiv hα4 a` is the point stabilizer of `a`. -/
@[simp]
theorem kleinFourComplementEquiv_apply_coe (hα4 : Nat.card α = 4) (a : α) :
    (kleinFourComplementEquiv hα4 a).val = MulAction.stabilizer (alternatingGroup α) a := (rfl)

/-- `kleinFour α` has exactly `4` complements in `alternatingGroup α` when `Nat.card α = 4`. -/
theorem card_isComplement'_kleinFour (hα4 : Nat.card α = 4) :
    Nat.card {D : Subgroup (alternatingGroup α) // (kleinFour α).IsComplement' D} = 4 :=
  (Nat.card_congr (kleinFourComplementEquiv hα4).symm).trans hα4

/-! ### Normalizers of point stabilizers -/

/-- Every point stabilizer of `alternatingGroup α` is self-normalizing whenever
`4 ≤ Nat.card α`. -/
theorem normalizer_stabilizer (hα : 4 ≤ Nat.card α) (a : α) :
    Subgroup.normalizer (MulAction.stabilizer (alternatingGroup α) a) =
      MulAction.stabilizer (alternatingGroup α) a := by
  ext g
  rw [Subgroup.mem_normalizer_iff_map_conj_eq, ← MulEquiv.toMonoidHom_eq_coe,
    ← MulAction.stabilizer_smul_eq_stabilizer_map_conj,
    (stabilizer_injective hα).eq_iff, MulAction.mem_stabilizer_iff]

/-- In `Equiv.Perm α`, the normalizer of the image of `MulAction.stabilizer (alternatingGroup α) a`
is `MulAction.stabilizer (Equiv.Perm α) a` whenever `4 ≤ Nat.card α`. -/
theorem normalizer_map_subtype_stabilizer (hα : 4 ≤ Nat.card α) (a : α) :
    Subgroup.normalizer
      ((MulAction.stabilizer (alternatingGroup α) a).map (alternatingGroup α).subtype) =
      MulAction.stabilizer (Perm α) a := by
  have hmap (x : α) :
      (MulAction.stabilizer (alternatingGroup α) x).map (alternatingGroup α).subtype =
        MulAction.stabilizer (Perm α) x ⊓ alternatingGroup α := by
    rw [← MulAction.stabilizer_subgroupOf, Subgroup.subgroupOf_map_subtype]
  have hconj (σ : Perm α) :
      ((MulAction.stabilizer (alternatingGroup α) a).map (alternatingGroup α).subtype).map
          (MulAut.conj σ : Perm α →* Perm α) =
        (MulAction.stabilizer (alternatingGroup α) (σ • a)).map (alternatingGroup α).subtype := by
    rw [hmap a, hmap (σ • a), Subgroup.map_inf _ _ _ (MulAut.conj σ).injective,
      ← MulEquiv.toMonoidHom_eq_coe, ← MulAction.stabilizer_smul_eq_stabilizer_map_conj]
    congr 1
    exact Subgroup.Normal.conj_smul_eq_self σ (alternatingGroup α)
  ext σ
  rw [Subgroup.mem_normalizer_iff_map_conj_eq, hconj σ,
    (Subgroup.map_injective (alternatingGroup α).subtype_injective).eq_iff,
    (stabilizer_injective hα).eq_iff, MulAction.mem_stabilizer_iff]

end alternatingGroup
