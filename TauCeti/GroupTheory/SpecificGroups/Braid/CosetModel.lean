module

public import TauCeti.GroupTheory.SpecificGroups.Braid.TailSubgroup
public import Mathlib.GroupTheory.GroupAction.Quotient

/-!
# The braid-coset model of the arc complex

Let `D` be a disc with a marked boundary point `∗` and `n` marked interior points
`P_1, …, P_n`. A `q`-simplex of the arc complex of `D` is a family of `q + 1` disjoint arcs from
`∗` to distinct marked points. By Ellenberg–Venkatesh–Westerland (Proposition 5.6), the braid
group `B_n` acts transitively on the `q`-simplices for `q < n`, and the stabilizer of the standard
simplex, made of the straight arcs to `P_1, …, P_(q+1)`, is the braid group of the remaining
`n - q - 1` points, placed on the top strands. That geometric identification is not formalized
here; this file builds its combinatorial side. The `q`-simplices form the coset space

`A(n)_q = B_n ⧸ L_q`, `L_q = TauCeti.BraidGroup.tailSubgroup n (q + 1)`,

the subgroup generated by the elementary braids `σ j` with `q + 1 ≤ j`. Deleting the `i`-th arc
of a `q`-simplex is right multiplication by the ascending product
`s_(q,i) = σ i * σ (i + 1) * ⋯ * σ (q - 1)` (`TauCeti.BraidGroup.prodSigmaIco i q`) followed by
passage to the larger subgroup:

`∂_i (b L_q) = b s_(q,i) L_(q-1)`, `0 ≤ i ≤ q`,

so that in particular the last face `∂_q` is the projection `B_n ⧸ L_q → B_n ⧸ L_(q-1)`. This file
defines these faces on the coset spaces, shows that they are well defined and commute with the
left action of `B_n`, and proves the semi-simplicial identities `∂_i ∂_(j+1) = ∂_j ∂_i` for
`i ≤ j` in every degree in which the simplices exist, that is `q < n`. The coset spaces are
transitive `B_n`-sets by `MulAction.isPretransitive_quotient`.

Faces of `(q + 1)`-simplices are indexed as `TauCeti.BraidGroup.cosetFace q i` with
`i : Fin (q + 2)`, mapping `B_n ⧸ L_(q+1)` to `B_n ⧸ L_q`.

## Main definitions

* `TauCeti.BraidGroup.cosetFace q i`: the `i`-th face `B_n ⧸ L_(q+1) → B_n ⧸ L_q`.

## Main results

* `TauCeti.BraidGroup.cosetFace_mk`: `∂_i (b L_(q+1)) = b s_(q+1,i) L_q`.
* `TauCeti.BraidGroup.cosetFace_last`: the last face is the projection.
* `TauCeti.BraidGroup.cosetFace_smul`: the faces are `B_n`-equivariant.
* `TauCeti.BraidGroup.cosetFace_cosetFace`: the semi-simplicial identities.

## References

* J. S. Ellenberg, A. Venkatesh, C. Westerland, *Homological stability for Hurwitz spaces and the
  Cohen–Lenstra conjecture over function fields*, Ann. of Math. 183 (2016), 729–786, §5.2 and
  Proposition 5.3.
-/

public section

namespace TauCeti

namespace BraidGroup

variable {n : ℕ}

/-- The `i`-th face `b L_(q+1) ↦ b s_(q+1,i) L_q` of the braid-coset model, from
`B_n ⧸ L_(q+1)` to `B_n ⧸ L_q`, where `L_q = TauCeti.BraidGroup.tailSubgroup n (q + 1)` and
`s_(q+1,i) = σ i * ⋯ * σ q` is `TauCeti.BraidGroup.prodSigmaIco i (q + 1)`. It is well defined
because `s_(q+1,i)` commutes with `L_(q+1)`. -/
def cosetFace (q : ℕ) (i : Fin (q + 2)) :
    BraidGroup n ⧸ tailSubgroup n (q + 2) → BraidGroup n ⧸ tailSubgroup n (q + 1) :=
  Quotient.map' (· * prodSigmaIco i (q + 1)) fun b c h ↦ by
    rw [QuotientGroup.leftRel_apply] at h ⊢
    have hl := Subgroup.mem_centralizer_singleton_iff.1 <|
      tailSubgroup_le_centralizer_prodSigmaIco (n := n) i (q + 1) h
    rw [mul_inv_rev, mul_assoc, ← mul_assoc b⁻¹, hl.eq, ← mul_assoc, inv_mul_cancel, one_mul]
    exact tailSubgroup_antitone (Nat.le_succ _) h

/-- The `i`-th face of the coset of `b` is the coset of `b s_(q+1,i)`. -/
@[simp]
theorem cosetFace_mk (q : ℕ) (i : Fin (q + 2)) (b : BraidGroup n) :
    cosetFace q i (b : BraidGroup n ⧸ tailSubgroup n (q + 2)) =
      ((b * prodSigmaIco (n := n) i (q + 1) : BraidGroup n) :
        BraidGroup n ⧸ tailSubgroup n (q + 1)) :=
  (rfl)

/-- The last face is the projection `B_n ⧸ L_(q+1) → B_n ⧸ L_q`. -/
@[simp]
theorem cosetFace_last (q : ℕ) (x : BraidGroup n ⧸ tailSubgroup n (q + 2)) :
    cosetFace q (Fin.last (q + 1)) x =
      Subgroup.quotientMapOfLE (tailSubgroup_antitone (Nat.le_succ _)) x := by
  induction x using QuotientGroup.induction_on with
  | H b => simp

/-- The faces commute with the left action of the braid group. -/
theorem cosetFace_smul (q : ℕ) (i : Fin (q + 2)) (g : BraidGroup n)
    (x : BraidGroup n ⧸ tailSubgroup n (q + 2)) :
    cosetFace q i (g • x) = g • cosetFace q i x := by
  induction x using QuotientGroup.induction_on with
  | H b => simp only [MulAction.Quotient.smul_coe, cosetFace_mk, smul_eq_mul, mul_assoc]

/-- The semi-simplicial identities `∂_i ∂_(j+1) = ∂_j ∂_i` for `i ≤ j`, on the
`(q + 2)`-simplices, which exist when `q + 2 < n`. -/
theorem cosetFace_cosetFace {q : ℕ} (hq : q + 2 < n) {i j : Fin (q + 2)} (hij : i ≤ j)
    (x : BraidGroup n ⧸ tailSubgroup n (q + 3)) :
    cosetFace q i (cosetFace (q + 1) j.succ x) =
      cosetFace q j (cosetFace (q + 1) i.castSucc x) := by
  induction x using QuotientGroup.induction_on with
  | H b =>
    simp only [cosetFace_mk, Fin.val_succ, Fin.val_castSucc]
    -- Both sides are `b s_(q+2,j+1) s_(q+1,i)`, up to a final `σ (q + 1) ∈ L_q` on the right.
    have hcomm := prodSigmaIco_mul_prodSigmaIco (n := n) (a := i) (b := q + 1 + 1) (c := j)
      (d := q + 1) hij (by omega) (by omega)
    have hsucc := prodSigmaIco_succ (n := n) (a := i) (b := q + 1) (by omega) (by omega)
    rw [mul_assoc b (prodSigmaIco i (q + 1 + 1)), hcomm, hsucc, ← mul_assoc, ← mul_assoc,
      QuotientGroup.mk_mul_of_mem _ (sigma_mem_tailSubgroup le_rfl), mul_assoc]

end BraidGroup

end TauCeti
