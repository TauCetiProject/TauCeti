/-!
# The Hurwitz action of the braid group on tuples

For a group `G`, the Artin braid group `TauCeti.BraidGroup n` acts on the left on the `n`-tuples
`Fin n → G`: the elementary braid `σ i` replaces the adjacent entries `(a, b)` at the positions
`i, i + 1` by `(a * b * a⁻¹, a)`, the other entries unchanged; its inverse replaces `(a, b)` by
`(b, b⁻¹ * a * b)`. These moves satisfy far commutativity and the braid relation, so they define a
homomorphism `BraidGroup n →* Equiv.Perm (Fin n → G)`.

When the tuple is the monodromy of a `G`-cover of a disc branched at `n` points, read along a
standard system of loops, this action is the monodromy action of the braid group moving the
branch points, and its orbits are the connected components of the corresponding Hurwitz space.
The action preserves the three basic invariants of a tuple:

* its ordered product `g₀ * g₁ * ⋯ * g_(n-1)` (the boundary monodromy), exactly and not only up to
  conjugacy;
* the subgroup generated by its entries;
* the conjugacy classes of its entries, which a braid permutes along its underlying permutation of
  the strands; so the multiset of classes is invariant, and a pure braid preserves the class of
  each entry.

It is natural in `G`: a group homomorphism applied entrywise commutes with the action, so in
particular the action commutes with simultaneous conjugation and descends to tuples up to
conjugation.

## Main definitions

* `TauCeti.BraidGroup.hurwitzMoveFun i`: the positive Hurwitz move at the positions `i, i + 1`.
* `TauCeti.BraidGroup.hurwitzMoveInvFun i`: the inverse move.
* `TauCeti.BraidGroup.hurwitzMove i`: the move as a permutation of `Fin n → G`.
* `TauCeti.BraidGroup.hurwitzAction n G`: the Hurwitz action
  `BraidGroup n →* Equiv.Perm (Fin n → G)`.

## Main results

* `TauCeti.BraidGroup.hurwitzMove_comm` and `TauCeti.BraidGroup.hurwitzMove_braid`: the moves
  satisfy the braid-group relations.
* `TauCeti.BraidGroup.hurwitzAction_sigma`: the elementary braid `σ i` acts by the `i`-th move.
* `TauCeti.BraidGroup.hurwitzAction_iff` and `TauCeti.BraidGroup.hurwitzAction_comm`: a property
  of tuples preserved by every move is preserved by every braid, and a map of tuples intertwining
  each move with the image of `σ i` under a homomorphism of braid groups intertwines every braid.
* `TauCeti.BraidGroup.prod_ofFn_hurwitzAction`: the ordered product is invariant.
* `TauCeti.BraidGroup.closure_range_hurwitzAction`: the generated subgroup is invariant.
* `TauCeti.BraidGroup.isConj_hurwitzAction_apply`: the entries of a moved tuple are conjugate to
  the entries of the original tuple permuted by the underlying permutation of the braid, and
  `TauCeti.BraidGroup.map_conjClassesMk_hurwitzAction`: the multiset of conjugacy classes is
  invariant.
* `TauCeti.BraidGroup.comp_hurwitzAction`: naturality in `G`.

## Implementation notes

The move is the convention `(a, b) ↦ (a b a⁻¹, a)` of Ellenberg–Venkatesh–Westerland, (1.3.2).
Products are ordered from left to right, `List.ofFn s` taking the entries in increasing order of
position.

## References

* J. S. Ellenberg, A. Venkatesh, C. Westerland, *Homological stability for Hurwitz spaces and the
  Cohen–Lenstra conjecture over function fields*, Ann. of Math. 183 (2016), §§2.1–2.2 and (1.3.2).
* M. M. Wood, *An algebraic lifting invariant of Ellenberg, Venkatesh, and Westerland*, §3.
-/

public section

namespace TauCeti

namespace BraidGroup

variable {n : ℕ} {G : Type*} [Group G]

section Move

/-- The positive Hurwitz move on an `n`-tuple at the adjacent positions `i, i + 1` (zero-based):
the entries `(a, b)` there are replaced by `(a * b * a⁻¹, a)`, the other entries unchanged. -/
def hurwitzMoveFun (i : Fin (n - 1)) (s : Fin n → G) : Fin n → G := fun j =>
  if j = strand i then s (strand i) * s (strandSucc i) * (s (strand i))⁻¹
  else if j = strandSucc i then s (strand i) else s j

/-- The inverse Hurwitz move at the adjacent positions `i, i + 1`: the entries `(a, b)` there are
replaced by `(b, b⁻¹ * a * b)`, the other entries unchanged. -/
def hurwitzMoveInvFun (i : Fin (n - 1)) (s : Fin n → G) : Fin n → G := fun j =>
  if j = strand i then s (strandSucc i)
  else if j = strandSucc i then (s (strandSucc i))⁻¹ * s (strand i) * s (strandSucc i)
  else s j

variable (i : Fin (n - 1)) (s : Fin n → G)

/-- The move puts `a * b * a⁻¹` at the lower position `i`. -/
@[simp]
theorem hurwitzMoveFun_apply_strand :
    hurwitzMoveFun i s (strand i) = s (strand i) * s (strandSucc i) * (s (strand i))⁻¹ := by
  simp [hurwitzMoveFun]

/-- The move puts `a` at the upper position `i + 1`. -/
@[simp]
theorem hurwitzMoveFun_apply_strandSucc : hurwitzMoveFun i s (strandSucc i) = s (strand i) := by
  simp [hurwitzMoveFun, (strand_ne_strandSucc i).symm]

/-- The move leaves the entries away from the positions `i, i + 1` unchanged. -/
@[simp]
theorem hurwitzMoveFun_apply_of_ne {j : Fin n} (h₁ : j ≠ strand i) (h₂ : j ≠ strandSucc i) :
    hurwitzMoveFun i s j = s j := by
  simp [hurwitzMoveFun, h₁, h₂]

/-- The inverse move puts `b` at the lower position `i`. -/
@[simp]
theorem hurwitzMoveInvFun_apply_strand : hurwitzMoveInvFun i s (strand i) = s (strandSucc i) := by
  simp [hurwitzMoveInvFun]

/-- The inverse move puts `b⁻¹ * a * b` at the upper position `i + 1`. -/
@[simp]
theorem hurwitzMoveInvFun_apply_strandSucc :
    hurwitzMoveInvFun i s (strandSucc i) =
      (s (strandSucc i))⁻¹ * s (strand i) * s (strandSucc i) := by
  simp [hurwitzMoveInvFun, (strand_ne_strandSucc i).symm]

/-- The inverse move leaves the entries away from the positions `i, i + 1` unchanged. -/
@[simp]
theorem hurwitzMoveInvFun_apply_of_ne {j : Fin n} (h₁ : j ≠ strand i) (h₂ : j ≠ strandSucc i) :
    hurwitzMoveInvFun i s j = s j := by
  simp [hurwitzMoveInvFun, h₁, h₂]

/-- The positive Hurwitz move at the adjacent positions `i, i + 1`, as a permutation of the
`n`-tuples; its inverse is `hurwitzMoveInvFun i`. -/
def hurwitzMove : Equiv.Perm (Fin n → G) where
  toFun := hurwitzMoveFun i
  invFun := hurwitzMoveInvFun i
  left_inv s := by
    funext j
    by_cases h₁ : j = strand i
    · subst h₁; simp
    by_cases h₂ : j = strandSucc i
    · subst h₂; simp; group
    · simp [h₁, h₂]
  right_inv s := by
    funext j
    by_cases h₁ : j = strand i
    · subst h₁; simp; group
    by_cases h₂ : j = strandSucc i
    · subst h₂; simp
    · simp [h₁, h₂]

/-- The permutation `hurwitzMove i` applies the positive move. -/
@[simp]
theorem coe_hurwitzMove : ⇑(hurwitzMove i : Equiv.Perm (Fin n → G)) = hurwitzMoveFun i := (rfl)

/-- The inverse of `hurwitzMove i` applies the inverse move. -/
@[simp]
theorem coe_hurwitzMove_symm :
    ⇑(hurwitzMove i : Equiv.Perm (Fin n → G)).symm = hurwitzMoveInvFun i := (rfl)

/-- Hurwitz moves at positions two or more apart commute. -/
theorem hurwitzMove_comm {i j : Fin (n - 1)} (hij : (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) :
    (hurwitzMove i : Equiv.Perm (Fin n → G)) * hurwitzMove j =
      hurwitzMove j * hurwitzMove i := by
  have hnd := nodup_strand_strandSucc_strand_strandSucc hij
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil, not_or,
    or_false] at hnd
  obtain ⟨⟨h₁, h₂, h₃⟩, ⟨h₄, h₅⟩, h₆, -⟩ := hnd
  have := Ne.symm h₁; have := Ne.symm h₂; have := Ne.symm h₃
  have := Ne.symm h₄; have := Ne.symm h₅; have := Ne.symm h₆
  ext s x
  simp only [Equiv.Perm.mul_apply, coe_hurwitzMove]
  by_cases a₁ : x = strand i
  · subst a₁; simp [*]
  by_cases a₂ : x = strandSucc i
  · subst a₂; simp [*]
  by_cases a₃ : x = strand j
  · subst a₃; simp [*]
  by_cases a₄ : x = strandSucc j
  · subst a₄; simp [*]
  · simp [*]

/-- Hurwitz moves at overlapping adjacent positions satisfy the braid relation. -/
theorem hurwitzMove_braid {i j : Fin (n - 1)} (hij : (i : ℕ) + 1 = j) :
    (hurwitzMove i : Equiv.Perm (Fin n → G)) * hurwitzMove j * hurwitzMove i =
      hurwitzMove j * hurwitzMove i * hurwitzMove j := by
  have e : strand j = strandSucc i := strand_eq_strandSucc_of_succ hij
  have h₁ : strand i ≠ strandSucc i := strand_ne_strandSucc i
  have h₂ : strand i ≠ strandSucc j := strand_ne_strandSucc_of_succ hij
  have h₃ : strandSucc i ≠ strandSucc j := e ▸ strand_ne_strandSucc j
  have := h₁.symm; have := h₂.symm; have := h₃.symm
  ext s x
  -- The middle position is both `strandSucc i` and `strand j`; unfolding the moves lets `e`
  -- identify the two names.
  simp only [Equiv.Perm.mul_apply, coe_hurwitzMove]
  by_cases a₁ : x = strand i
  · subst a₁; simp [hurwitzMoveFun, *]; group
  by_cases a₂ : x = strandSucc i
  · subst a₂; simp [hurwitzMoveFun, *]
  by_cases a₃ : x = strandSucc j
  · subst a₃; simp [hurwitzMoveFun, *]
  · simp [hurwitzMoveFun, *]

end Move

section Action

variable (n G) in
/-- The Hurwitz action of the braid group `BraidGroup n` on the `n`-tuples `Fin n → G`: the
elementary braid `σ i` acts by the positive Hurwitz move `(a, b) ↦ (a * b * a⁻¹, a)` at the
positions `i, i + 1`. -/
def hurwitzAction : BraidGroup n →* Equiv.Perm (Fin n → G) :=
  lift hurwitzMove (fun h ↦ hurwitzMove_comm h) fun {_ _} h ↦ by
    rcases h with h | h
    · exact hurwitzMove_braid h
    · exact (hurwitzMove_braid h).symm

/-- The elementary braid `σ i` acts by the `i`-th Hurwitz move. -/
@[simp]
theorem hurwitzAction_sigma (i : Fin (n - 1)) :
    hurwitzAction n G (sigma i) = hurwitzMove i :=
  lift_sigma _ _ _ i

/-- A property of tuples preserved by every Hurwitz move is preserved by every braid. -/
theorem hurwitzAction_iff (P : (Fin n → G) → Prop)
    (h : ∀ i s, P (hurwitzMoveFun i s) ↔ P s) (b : BraidGroup n) (s : Fin n → G) :
    P (hurwitzAction n G b s) ↔ P s := by
  induction b using sigma_induction_on generalizing s with
  | sigma i => simpa using h i s
  | one => simp
  | mul b b' hb hb' => rw [map_mul, Equiv.Perm.mul_apply, hb, hb']
  | inv b hb => simpa using (hb ((hurwitzAction n G b)⁻¹ s)).symm

/-- A map of tuples intertwining each Hurwitz move with the action of the image of `σ i` under a
homomorphism of braid groups intertwines the actions of every braid. -/
theorem hurwitzAction_comm {m : ℕ} {H : Type*} [Group H] (φ : (Fin n → G) → Fin m → H)
    (f : BraidGroup n →* BraidGroup m)
    (h : ∀ i s, hurwitzAction m H (f (sigma i)) (φ s) = φ (hurwitzMoveFun i s))
    (b : BraidGroup n) (s : Fin n → G) :
    hurwitzAction m H (f b) (φ s) = φ (hurwitzAction n G b s) := by
  induction b using sigma_induction_on generalizing s with
  | sigma i => simpa using h i s
  | one => simp
  | mul b b' hb hb' => simp only [map_mul, Equiv.Perm.mul_apply, hb', hb]
  | inv b hb => rw [map_inv, map_inv, Equiv.Perm.inv_eq_iff_eq, hb]; simp

/-- The Hurwitz action is natural in the group: a homomorphism applied entrywise commutes with
it. In particular it commutes with simultaneous conjugation. -/
theorem comp_hurwitzAction {H : Type*} [Group H] (φ : G →* H) (b : BraidGroup n)
    (s : Fin n → G) : ⇑φ ∘ hurwitzAction n G b s = hurwitzAction n H b (⇑φ ∘ s) := by
  refine (hurwitzAction_comm (⇑φ ∘ ·) (MonoidHom.id _) (fun i s ↦ ?_) b s).symm
  funext j
  by_cases h₁ : j = strand i
  · subst h₁; simp
  by_cases h₂ : j = strandSucc i
  · subst h₂; simp
  · simp [h₁, h₂]

end Action

section Invariants

/-- The ordered product `s 0 * ⋯ * s (n - 1)` splits around the positions `i, i + 1`. -/
private theorem prod_ofFn_eq_take_mul (i : Fin (n - 1)) (s : Fin n → G) :
    (List.ofFn s).prod = ((List.ofFn s).take i).prod *
      (s (strand i) * (s (strandSucc i) * ((List.ofFn s).drop (i + 2)).prod)) := by
  have hi := i.isLt
  have e₁ : strand i = ⟨i, by omega⟩ := Fin.ext (val_strand i)
  have e₂ : strandSucc i = ⟨i + 1, by omega⟩ := Fin.ext (val_strandSucc i)
  rw [← List.prod_take_mul_prod_drop (List.ofFn s) i,
    List.drop_eq_getElem_cons (by simp; omega), List.drop_eq_getElem_cons (by simp; omega), e₁, e₂]
  simp

/-- A Hurwitz move preserves the ordered product of a tuple. -/
@[simp]
theorem prod_ofFn_hurwitzMoveFun (i : Fin (n - 1)) (s : Fin n → G) :
    (List.ofFn (hurwitzMoveFun i s)).prod = (List.ofFn s).prod := by
  have ht : (List.ofFn (hurwitzMoveFun i s)).take i = (List.ofFn s).take i := by
    refine List.ext_getElem (by simp) fun j h₁ h₂ ↦ ?_
    simp only [List.getElem_take, List.getElem_ofFn]
    simp only [List.length_take, List.length_ofFn] at h₁
    exact hurwitzMoveFun_apply_of_ne _ _ (Fin.ne_of_val_ne (by simp; omega))
      (Fin.ne_of_val_ne (by simp; omega))
  have hd : (List.ofFn (hurwitzMoveFun i s)).drop (i + 2) = (List.ofFn s).drop (i + 2) := by
    refine List.ext_getElem (by simp) fun j h₁ h₂ ↦ ?_
    simp only [List.getElem_drop, List.getElem_ofFn]
    exact hurwitzMoveFun_apply_of_ne _ _ (Fin.ne_of_val_ne (by simp; omega))
      (Fin.ne_of_val_ne (by simp; omega))
  rw [prod_ofFn_eq_take_mul i, prod_ofFn_eq_take_mul i s, ht, hd]
  simp [mul_assoc]

/-- The Hurwitz action preserves the ordered product of a tuple. -/
@[simp]
theorem prod_ofFn_hurwitzAction (b : BraidGroup n) (s : Fin n → G) :
    (List.ofFn (hurwitzAction n G b s)).prod = (List.ofFn s).prod :=
  hurwitzAction_iff (fun t ↦ (List.ofFn t).prod = (List.ofFn s).prod)
    (fun i t ↦ by rw [prod_ofFn_hurwitzMoveFun]) b s |>.2 rfl

/-- A Hurwitz move preserves the subgroup generated by the entries of a tuple. -/
@[simp]
theorem closure_range_hurwitzMoveFun (i : Fin (n - 1)) (s : Fin n → G) :
    Subgroup.closure (Set.range (hurwitzMoveFun i s)) = Subgroup.closure (Set.range s) := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    have mem : ∀ k, s k ∈ Subgroup.closure (Set.range s) := fun k ↦
      Subgroup.subset_closure ⟨k, rfl⟩
    by_cases h₁ : j = strand i
    · subst h₁; simpa using mul_mem (mul_mem (mem _) (mem _)) (inv_mem (mem _))
    by_cases h₂ : j = strandSucc i
    · subst h₂; simpa using mem _
    · simpa [h₁, h₂] using mem j
  · rw [Subgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    have mem : ∀ k, hurwitzMoveFun i s k ∈ Subgroup.closure (Set.range (hurwitzMoveFun i s)) :=
      fun k ↦ Subgroup.subset_closure ⟨k, rfl⟩
    have ha := mem (strandSucc i)
    rw [hurwitzMoveFun_apply_strandSucc] at ha
    by_cases h₁ : j = strand i
    · subst h₁; exact ha
    by_cases h₂ : j = strandSucc i
    · subst h₂
      have key : s (strandSucc i) =
          (s (strand i))⁻¹ * hurwitzMoveFun i s (strand i) * s (strand i) := by
        rw [hurwitzMoveFun_apply_strand]; group
      rw [key]
      exact mul_mem (mul_mem (inv_mem ha) (mem _)) ha
    · simpa [h₁, h₂] using mem j

/-- The Hurwitz action preserves the subgroup generated by the entries of a tuple. -/
@[simp]
theorem closure_range_hurwitzAction (b : BraidGroup n) (s : Fin n → G) :
    Subgroup.closure (Set.range (hurwitzAction n G b s)) = Subgroup.closure (Set.range s) :=
  hurwitzAction_iff (fun t ↦ Subgroup.closure (Set.range t) = Subgroup.closure (Set.range s))
    (fun i t ↦ by rw [closure_range_hurwitzMoveFun]) b s |>.2 rfl

/-- Each entry of a tuple after a Hurwitz move is conjugate to the entry of the original tuple at
the transposed position. -/
theorem isConj_hurwitzMoveFun_apply (i : Fin (n - 1)) (s : Fin n → G) (j : Fin n) :
    IsConj (hurwitzMoveFun i s j) (s (transposition i j)) := by
  by_cases h₁ : j = strand i
  · subst h₁
    rw [hurwitzMoveFun_apply_strand, transposition_apply_strand]
    exact (isConj_iff.2 ⟨s (strand i), rfl⟩).symm
  by_cases h₂ : j = strandSucc i
  · subst h₂
    rw [hurwitzMoveFun_apply_strandSucc, transposition_apply_strandSucc]
  · rw [hurwitzMoveFun_apply_of_ne i s h₁ h₂, transposition_eq_swap,
      Equiv.swap_apply_of_ne_of_ne h₁ h₂]

/-- Each entry of a tuple moved by a braid `b` is conjugate to the entry of the original tuple at
the position that the underlying permutation of `b` sends to it: braids permute the conjugacy
classes of the entries along their underlying permutations. -/
theorem isConj_hurwitzAction_apply (b : BraidGroup n) (s : Fin n → G) (j : Fin n) :
    IsConj (hurwitzAction n G b s j) (s ((permHom n b)⁻¹ j)) := by
  induction b using sigma_induction_on generalizing s j with
  | sigma i =>
    have hinv : (transposition i)⁻¹ = transposition i := by
      rw [transposition_eq_swap, Equiv.swap_inv]
    simpa [hinv] using isConj_hurwitzMoveFun_apply i s j
  | one =>
    simp only [map_one, inv_one, Equiv.Perm.one_apply]
    exact IsConj.refl _
  | mul b b' hb hb' =>
    simp only [map_mul, Equiv.Perm.mul_apply, mul_inv_rev]
    exact (hb _ j).trans (hb' s _)
  | inv b hb =>
    have := hb ((hurwitzAction n G b)⁻¹ s) (permHom n b j)
    simp only [map_inv, inv_inv, Equiv.Perm.coe_inv, Equiv.apply_symm_apply,
      Equiv.symm_apply_apply] at this ⊢
    exact this.symm

/-- A pure braid preserves the conjugacy class of each entry of a tuple. -/
theorem isConj_hurwitzAction_apply_of_mem_pureSubgroup {b : BraidGroup n}
    (hb : b ∈ pureSubgroup n) (s : Fin n → G) (j : Fin n) :
    IsConj (hurwitzAction n G b s j) (s j) := by
  simpa [(mem_pureSubgroup.1 hb)] using isConj_hurwitzAction_apply b s j

/-- The Hurwitz action preserves the multiset of conjugacy classes of the entries of a tuple. -/
theorem map_conjClassesMk_hurwitzAction (b : BraidGroup n) (s : Fin n → G) :
    Finset.univ.val.map (fun j ↦ ConjClasses.mk (hurwitzAction n G b s j)) =
      Finset.univ.val.map (fun j ↦ ConjClasses.mk (s j)) := by
  have h : (fun j ↦ ConjClasses.mk (hurwitzAction n G b s j)) =
      (fun j ↦ ConjClasses.mk (s j)) ∘ ⇑(permHom n b)⁻¹ :=
    funext fun j ↦ ConjClasses.mk_eq_mk_iff_isConj.2 (isConj_hurwitzAction_apply b s j)
  rw [h, ← Multiset.map_map, Multiset.map_univ_val_equiv]

end Invariants

end BraidGroup

