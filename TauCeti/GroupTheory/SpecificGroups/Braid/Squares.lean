module

public import Mathlib.GroupTheory.SpecificGroups.Alternating
public import TauCeti.GroupTheory.Perm.Coxeter
import TauCeti.GroupTheory.QuotientGroup.KerEquiv

/-!
# Square quotients of braid groups

Two normal subgroups of the braid group `B n` are generated by squares, and each has an explicit
quotient.

* **Squares of the generators.** The normal subgroup generated by the squares `σ i ^ 2` of the
  elementary braids is the pure braid group, the kernel of the strand permutation
  `TauCeti.BraidGroup.permHom n : B n →* Equiv.Perm (Fin n)`. So the symmetric group is the
  quotient of `B n` by the relations `σ i ^ 2 = 1`, the isomorphism being
  `TauCeti.BraidGroup.quotientPureSubgroupEquiv`. Equivalently, a homomorphism out of `B n`
  factors, necessarily uniquely, through the strand permutation exactly when it squares every
  elementary braid to `1`. This is the type-`A` case of the presentation of a Coxeter group as the
  quotient of its Artin-Tits group by the squares of the generators,
  `TauCeti.ArtinGroup.ker_toCoxeterGroup` and its universal property, applied to the Coxeter
  system `TauCeti.permCoxeterSystem n` of the symmetric group.
* **Squares of all elements.** The normal subgroup generated by all squares `b ^ 2` is the kernel
  of the exponent parity `TauCeti.ArtinGroup.exponentParity`, the exponent sum modulo `2`, and
  also the inverse image under the strand permutation of the alternating group, because the sign
  of the strand permutation of `b` is `(-1)` to the exponent sum of `b`. For `n ≥ 2` the quotient
  is the group of order two, every elementary braid mapping to its nonidentity element, and the
  isomorphism is Mathlib's `QuotientGroup.quotientKerEquivOfSurjective` for the exponent parity.
  The proof
  that the squares generate the whole kernel: in the quotient by the squares every element is an
  involution, so the braid relation `σ i σ j σ i = σ j σ i σ j` forces `σ i = σ j` there, and the
  quotient map is a power of the one common image, taken to the exponent sum.

The pure braid group is contained in the second subgroup, and the inclusion is strict exactly from
three strands on: the square of `σ i * σ j`, for two elementary braids sharing a strand, permutes
the strands by a three-cycle, so it is a square that is not pure. On two strands the exponent sum
identifies `B 2` with `ℤ` (`TauCeti.BraidGroup.exponentSum_bijective_two`), and both subgroups are
the braids of even exponent sum.

## Main results

* `TauCeti.BraidGroup.pureSubgroup_eq_normalClosure`: the pure braid group is normally generated by
  the squares of the elementary braids.
* `TauCeti.BraidGroup.pureSubgroup_le_ker_iff` and
  `TauCeti.BraidGroup.existsUnique_comp_permHom_eq_iff`: the universal property of the quotient
  by the generator squares.
* `TauCeti.BraidGroup.normalClosure_isSquare_eq_ker_exponentParity`: the squares normally
  generate the kernel of the exponent parity.
* `TauCeti.BraidGroup.ker_exponentParity_eq_comap_alternatingGroup`: that kernel consists of the
  braids whose strand permutation is even.
* `TauCeti.BraidGroup.ker_exponentParity_le_ker_iff` and
  `TauCeti.BraidGroup.existsUnique_comp_exponentParity_eq_iff`: the universal property of the
  quotient by the squares.
* `TauCeti.BraidGroup.pureSubgroup_lt_ker_exponentParity`: from three strands on, the pure braid
  group is strictly smaller, as `TauCeti.BraidGroup.sq_sigma_mul_sigma_notMem_pureSubgroup` shows.
* `TauCeti.BraidGroup.pureSubgroup_eq_ker_exponentParity_iff`: the two subgroups agree exactly
  for `n ≤ 2`.

## References

* J. S. Birman and T. E. Brendle, *Braids: a survey*, in Handbook of Knot Theory (2005), §1.
* C. Kassel and V. Turaev, *Braid Groups*, Springer GTM 247 (2008), §1.3 (the pure braid group
  and the permutation homomorphism).
* E. Brieskorn and K. Saito, *Artin-Gruppen und Coxeter-Gruppen*, Invent. Math. 17 (1972),
  245-271.
-/

public section

namespace TauCeti.BraidGroup

variable {n : ℕ} {G : Type*}

/-! ### The squares of the generators -/

/-- **The pure braid group is normally generated by the squares of the elementary braids.** So the
symmetric group on the strands is the quotient of the braid group by the relations `σ i ^ 2 = 1`.
-/
theorem pureSubgroup_eq_normalClosure (n : ℕ) :
    pureSubgroup n = Subgroup.normalClosure (Set.range fun i : Fin (n - 1) ↦ sigma i ^ 2) := by
  simp only [pureSubgroup_eq_ker, permHom_eq_toCoxeterGroup, ArtinGroup.ker_toCoxeterGroup,
    sigma_eq_gen]

/-- A homomorphism out of the braid group kills the pure braids exactly when it squares every
elementary braid to `1`. -/
theorem pureSubgroup_le_ker_iff [Monoid G] {f : BraidGroup n →* G} :
    pureSubgroup n ≤ f.ker ↔ ∀ i, f (sigma i) ^ 2 = 1 := by
  simpa only [pureSubgroup_eq_ker, permHom_eq_toCoxeterGroup, sigma_eq_gen] using
    ArtinGroup.ker_toCoxeterGroup_le_ker_iff (permCoxeterSystem n)

/-- **The universal property of the symmetric group as a quotient of the braid group.** A
homomorphism out of the braid group factors through the strand permutation, necessarily
uniquely, exactly when it squares every elementary braid to `1`. -/
theorem existsUnique_comp_permHom_eq_iff [Monoid G] {f : BraidGroup n →* G} :
    (∃! g : Equiv.Perm (Fin n) →* G, g.comp (permHom n) = f) ↔ ∀ i, f (sigma i) ^ 2 = 1 := by
  simpa only [permHom_eq_toCoxeterGroup, sigma_eq_gen] using
    ArtinGroup.existsUnique_comp_toCoxeterGroup_eq_iff (permCoxeterSystem n)

/-! ### Exponent parity and the alternating group -/

/-- **The braids of trivial exponent parity are those with an even strand permutation**: the kernel
of the exponent parity is the inverse image of the alternating group under the strand
permutation. -/
theorem ker_exponentParity_eq_comap_alternatingGroup (n : ℕ) :
    (ArtinGroup.exponentParity (CoxeterMatrix.A (n - 1))).ker =
      (alternatingGroup (Fin n)).comap (permHom n) := by
  ext b
  rw [MonoidHom.mem_ker, Subgroup.mem_comap, Equiv.Perm.mem_alternatingGroup,
    sign_permHom_eq_one_iff]

/-- Pure braids have trivial exponent parity. -/
theorem pureSubgroup_le_ker_exponentParity (n : ℕ) :
    pureSubgroup n ≤ (ArtinGroup.exponentParity (CoxeterMatrix.A (n - 1))).ker := by
  rw [pureSubgroup_eq_ker, permHom_eq_toCoxeterGroup]
  exact ArtinGroup.ker_toCoxeterGroup_le_ker_exponentParity (permCoxeterSystem n)

/-! ### The squares of all elements -/

/-- If a homomorphism out of the braid group sends every braid to an involution, it sends all the
elementary braids to the same element: the braid relation `a * c * a = c * a * c` between two
involutions whose product is an involution forces `a = c`. -/
private theorem map_sigma_eq_map_sigma {H : Type*} [Group H] {f : BraidGroup n →* H}
    (hf : ∀ b, f b * f b = 1)
    (i j : Fin (n - 1)) : f (sigma i) = f (sigma j) := by
  have hadj : ∀ i j : Fin (n - 1), (i : ℕ) + 1 = j → f (sigma i) = f (sigma j) := by
    intro i j h
    have hb := congrArg f (sigma_braid (Or.inl h))
    have hij := hf (sigma i * sigma j)
    have hcinv : (f (sigma j))⁻¹ = f (sigma j) := inv_eq_of_mul_eq_one_right (hf (sigma j))
    simp only [map_mul] at hb hij
    have h₁ : f (sigma i) * f (sigma j) * f (sigma i) = f (sigma j) := by
      have h := eq_inv_of_mul_eq_one_left (a := f (sigma i) * f (sigma j) * f (sigma i))
        (b := f (sigma j)) (by simpa only [mul_assoc] using hij)
      rwa [hcinv] at h
    rw [h₁, mul_assoc, eq_comm, mul_eq_left] at hb
    rw [← hcinv]
    exact eq_inv_of_mul_eq_one_left hb
  have hzero : ∀ (k : ℕ) (hk : k < n - 1),
      f (sigma ⟨k, hk⟩) = f (sigma ⟨0, by omega⟩) := by
    intro k
    induction k with
    | zero => intro hk; rfl
    | succ k ih => intro hk; rw [← hadj ⟨k, by omega⟩ ⟨k + 1, hk⟩ rfl, ih]
  exact (hzero i i.isLt).trans (hzero j j.isLt).symm

/-- **The squares normally generate the kernel of the exponent parity**: a braid is a product of
squares exactly when its exponent sum is even. -/
theorem normalClosure_isSquare_eq_ker_exponentParity (n : ℕ) :
    Subgroup.normalClosure {b : BraidGroup n | IsSquare b} =
      (ArtinGroup.exponentParity (CoxeterMatrix.A (n - 1))).ker := by
  set N := Subgroup.normalClosure {b : BraidGroup n | IsSquare b}
  refine le_antisymm (Subgroup.normalClosure_le_normal ?_) fun b hb ↦ ?_
  · rintro _ ⟨r, rfl⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker, map_mul, ← toAdd_eq_zero, toAdd_mul]
    exact CharTwo.add_self_eq_zero _
  rcases le_or_gt n 1 with hn | hn
  · rw [eq_one_of_le_one hn b]
    exact N.one_mem
  -- In the quotient by `N` every element is an involution, so the quotient map sends all the
  -- elementary braids to one involution `g`, and it is `g` to the exponent sum.
  have hsq : ∀ c, QuotientGroup.mk' N c * QuotientGroup.mk' N c = 1 := fun c ↦ by
    rw [← map_mul, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact Subgroup.subset_normalClosure ⟨c, rfl⟩
  set g := QuotientGroup.mk' N (sigma (n := n) ⟨0, by omega⟩)
  have hmk : QuotientGroup.mk' N =
      (zpowersHom _ g).comp (ArtinGroup.exponentSum (CoxeterMatrix.A (n - 1))) :=
    hom_ext fun i ↦ by simpa [g] using map_sigma_eq_map_sigma hsq i _
  obtain ⟨k, hk⟩ := (ArtinGroup.exponentParity_eq_one_iff _ b).1 (MonoidHom.mem_ker.1 hb)
  have hg : g * g = 1 := hsq _
  rw [← QuotientGroup.eq_one_iff, ← QuotientGroup.mk'_apply, hmk]
  simp [hk, ← two_mul, zpow_mul, pow_two, hg]

/-- **The universal property of the quotient by the squares.** A homomorphism out of the braid
group kills every braid of trivial exponent parity exactly when its image consists of
involutions. -/
theorem ker_exponentParity_le_ker_iff [MulOneClass G] {f : BraidGroup n →* G} :
    (ArtinGroup.exponentParity (CoxeterMatrix.A (n - 1))).ker ≤ f.ker ↔ ∀ b, f b * f b = 1 := by
  rw [← normalClosure_isSquare_eq_ker_exponentParity, ← Subgroup.normalClosure_subset_iff]
  refine ⟨fun h b ↦ ?_, fun h ↦ ?_⟩
  · simpa using h ⟨b, rfl⟩
  · rintro _ ⟨r, rfl⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker, map_mul]
    exact h r

/-- **The universal property of the group of order two as a quotient of the braid group.** From
two strands on, a homomorphism out of the braid group factors through the exponent parity,
necessarily uniquely, exactly when its image consists of involutions. -/
theorem existsUnique_comp_exponentParity_eq_iff [Monoid G] (hn : 2 ≤ n)
    {f : BraidGroup n →* G} :
    (∃! g : Multiplicative (ZMod 2) →* G,
      g.comp (ArtinGroup.exponentParity (CoxeterMatrix.A (n - 1))) = f) ↔
      ∀ b, f b * f b = 1 := by
  rw [← ker_exponentParity_le_ker_iff]
  have hsurj := exponentParity_surjective hn
  refine ⟨fun ⟨g, hg, _⟩ ↦ hg ▸ fun b hb ↦ ?_, fun h ↦ ?_⟩
  · rw [MonoidHom.mem_ker, MonoidHom.comp_apply, MonoidHom.mem_ker.1 hb, map_one]
  -- The factorization is the lift of `f` to the quotient by the kernel, composed with the first
  -- isomorphism theorem for the exponent parity.
  have hcomp : ((QuotientGroup.lift _ f h).comp
      (QuotientGroup.quotientKerEquivOfSurjective _ hsurj).symm.toMonoidHom).comp
        (ArtinGroup.exponentParity (CoxeterMatrix.A (n - 1))) = f :=
    MonoidHom.ext fun b ↦ by simp
  exact ⟨_, hcomp, fun g hg ↦ (MonoidHom.cancel_right hsurj).1 (hg.trans hcomp.symm)⟩

/-! ### Comparing the two subgroups -/

/-- The square of the product of two elementary braids sharing a strand is not a pure braid: their
product permutes the three strands involved cyclically, and so does its square. -/
theorem sq_sigma_mul_sigma_notMem_pureSubgroup {i j : Fin (n - 1)}
    (h : (i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i) :
    (sigma i * sigma j) ^ 2 ∉ pureSubgroup n := by
  intro hmem
  have hpure := mem_pureSubgroup.1 hmem
  rw [pow_two, map_mul, map_mul, permHom_sigma, permHom_sigma] at hpure
  -- The lowest of the three strands involved does not return to its place.
  rcases h with h | h
  · have h₁ := congrArg Fin.val (DFunLike.congr_fun hpure (strand i))
    simp only [Equiv.Perm.mul_apply, val_transposition_apply, Equiv.Perm.one_apply,
      val_strand] at h₁
    split_ifs at h₁ <;> omega
  · have h₁ := congrArg Fin.val (DFunLike.congr_fun hpure (strand j))
    simp only [Equiv.Perm.mul_apply, val_transposition_apply, Equiv.Perm.one_apply,
      val_strand] at h₁
    split_ifs at h₁ <;> omega

/-- The pure braid group is contained in the kernel of the exponent parity, strictly from three
strands on. -/
theorem pureSubgroup_lt_ker_exponentParity (hn : 3 ≤ n) :
    pureSubgroup n < (ArtinGroup.exponentParity (CoxeterMatrix.A (n - 1))).ker := by
  refine (pureSubgroup_le_ker_exponentParity n).lt_of_ne fun h ↦
    sq_sigma_mul_sigma_notMem_pureSubgroup (n := n) (i := ⟨0, by omega⟩) (j := ⟨1, by omega⟩)
      (Or.inl rfl) ?_
  rw [h, ← normalClosure_isSquare_eq_ker_exponentParity]
  exact Subgroup.subset_normalClosure (IsSquare.sq _)

/-- **The pure braids are the braids of trivial exponent parity exactly on at most two
strands**: on two strands both are the braids of even exponent sum. -/
theorem pureSubgroup_eq_ker_exponentParity_iff :
    pureSubgroup n = (ArtinGroup.exponentParity (CoxeterMatrix.A (n - 1))).ker ↔ n ≤ 2 := by
  refine ⟨fun h ↦ ?_, fun hn ↦ ?_⟩
  · by_contra hn
    exact (pureSubgroup_lt_ker_exponentParity (by omega)).ne h
  · rw [ker_exponentParity_eq_comap_alternatingGroup,
      alternatingGroup.eq_bot_of_card_le_two (by rwa [Nat.card_fin]), MonoidHom.comap_bot,
      pureSubgroup_eq_ker]

end TauCeti.BraidGroup
