module

public import TauCeti.GroupTheory.SpecificGroups.Braid.Basic
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Braids on the upper strands and ascending products of elementary braids

For `k : ℕ`, the *tail subgroup* `TauCeti.BraidGroup.tailSubgroup n k` of `BraidGroup n` is the
subgroup generated by the elementary braids `σ j` with `k ≤ j`, that is by the crossings among the
strands `k, k + 1, …, n - 1`. It is the image of the block inclusion
`TauCeti.BraidGroup.natAdd k`, which places a braid on the top strands, and its elementary braids
are exactly the `σ j` with `k ≤ j`.

The *ascending product* `TauCeti.BraidGroup.prodSigmaIco a b = σ a * σ (a + 1) * ⋯ * σ (b - 1)`
is the positive braid that carries strand `a` over the strands `a + 1, …, b`. It commutes with
the elementary braids two or more steps away from its range, and conjugating an elementary braid in
the interior of its range across it raises the index by one; repeating this gives the commutation
rule `TauCeti.BraidGroup.prodSigmaIco_mul_prodSigmaIco` between two ascending products.

These are the algebraic ingredients of the braid-coset model of the arc complex of a punctured disc
(Ellenberg–Venkatesh–Westerland, §5.2), whose simplices are cosets of tail subgroups and whose face
maps are right multiplications by ascending products; see
`TauCeti.GroupTheory.SpecificGroups.Braid.CosetModel`.

## Main definitions

* `TauCeti.BraidGroup.tailSubgroup n k`: the subgroup generated by the `σ j` with `k ≤ j`.
* `TauCeti.BraidGroup.prodSigmaIco a b`: the ascending product `σ a * ⋯ * σ (b - 1)`.

## Main results

* `TauCeti.BraidGroup.sigma_mem_tailSubgroup_iff`: `σ j` lies in the tail subgroup at `k` exactly
  when `k ≤ j`.
* `TauCeti.BraidGroup.range_natAdd`: the block inclusion on the top strands has image the tail
  subgroup.
* `TauCeti.BraidGroup.tailSubgroup_le_centralizer_prodSigmaIco`: the tail subgroup at `b + 1`
  commutes with every ascending product ending below `b`.
* `TauCeti.BraidGroup.prodSigmaIco_mul_sigma`: `(σ a ⋯ σ (b - 1)) σ c = σ (c + 1) (σ a ⋯ σ (b - 1))`
  for `a ≤ c` and `c + 2 ≤ b`.
* `TauCeti.BraidGroup.prodSigmaIco_mul_prodSigmaIco`: the corresponding rule for two ascending
  products.

## References

* J. S. Ellenberg, A. Venkatesh, C. Westerland, *Homological stability for Hurwitz spaces and the
  Cohen–Lenstra conjecture over function fields*, Ann. of Math. 183 (2016), 729–786, §5.2.
-/

public section

namespace TauCeti

namespace BraidGroup

variable {n : ℕ}

/-! ### The tail subgroups -/

/-- The subgroup of `BraidGroup n` generated by the elementary braids `σ j` with `k ≤ j`: the
braids generated by crossings among the strands `k, k + 1, …, n - 1`. It is the image of the block
inclusion `TauCeti.BraidGroup.natAdd k` (`TauCeti.BraidGroup.range_natAdd`). -/
def tailSubgroup (n k : ℕ) : Subgroup (BraidGroup n) :=
  Subgroup.closure (sigma '' {j | k ≤ (j : ℕ)})

/-- The universal property of `TauCeti.BraidGroup.tailSubgroup` as a generated subgroup. -/
theorem tailSubgroup_le_iff {k : ℕ} {H : Subgroup (BraidGroup n)} :
    tailSubgroup n k ≤ H ↔ ∀ j : Fin (n - 1), k ≤ (j : ℕ) → sigma j ∈ H := by
  simp [tailSubgroup, Subgroup.closure_le, Set.subset_def]

/-- The generators of the tail subgroup at `k` are the `σ j` with `k ≤ j`. -/
theorem sigma_mem_tailSubgroup {k : ℕ} {j : Fin (n - 1)} (h : k ≤ (j : ℕ)) :
    sigma j ∈ tailSubgroup n k :=
  Subgroup.subset_closure ⟨j, h, rfl⟩

/-- A braid in the tail subgroup at `k` leaves every strand below `k` in place. -/
theorem permHom_apply_of_mem_tailSubgroup {k : ℕ} {b : BraidGroup n} (hb : b ∈ tailSubgroup n k)
    {x : Fin n} (hx : (x : ℕ) < k) : permHom n b x = x := by
  have hle : tailSubgroup n k ≤ (MulAction.stabilizer (Equiv.Perm (Fin n)) x).comap (permHom n) :=
    tailSubgroup_le_iff.2 fun j hj ↦ by
      rw [Subgroup.mem_comap, MulAction.mem_stabilizer_iff, permHom_sigma, Equiv.Perm.smul_def,
        Fin.ext_iff, val_transposition_apply]
      split_ifs <;> omega
  exact hle hb

/-- The elementary braids in the tail subgroup at `k` are exactly the `σ j` with `k ≤ j`. -/
@[simp]
theorem sigma_mem_tailSubgroup_iff {k : ℕ} {j : Fin (n - 1)} :
    sigma j ∈ tailSubgroup n k ↔ k ≤ (j : ℕ) := by
  refine ⟨fun h ↦ ?_, sigma_mem_tailSubgroup⟩
  by_contra hjk
  have := permHom_apply_of_mem_tailSubgroup h (x := strand j) (by simp; omega)
  rw [permHom_sigma, transposition_apply_strand] at this
  exact strand_ne_strandSucc j this.symm

/-- The tail subgroups shrink as the starting index grows. -/
theorem tailSubgroup_antitone : Antitone (tailSubgroup n) :=
  fun _ _ hkl ↦ tailSubgroup_le_iff.2 fun _ hj ↦ sigma_mem_tailSubgroup (hkl.trans hj)

/-- The tail subgroup at `0` is the whole braid group. -/
@[simp]
theorem tailSubgroup_zero : tailSubgroup n 0 = ⊤ :=
  eq_top_iff.2 <| closure_range_sigma (n := n) ▸
    Subgroup.closure_le _ |>.2 (Set.range_subset_iff.2 fun _ ↦ sigma_mem_tailSubgroup (by omega))

/-- Above the last elementary braid the tail subgroup is trivial. -/
theorem tailSubgroup_eq_bot {k : ℕ} (hk : n - 1 ≤ k) : tailSubgroup n k = ⊥ :=
  eq_bot_iff.2 <| tailSubgroup_le_iff.2 fun j hj ↦ absurd j.isLt (by omega)

/-- The block inclusion `TauCeti.BraidGroup.natAdd k`, placing a braid on the top `m + 1` strands
of `k + m + 1`, has image the tail subgroup at `k`. -/
theorem range_natAdd (k : ℕ) {m : ℕ} :
    (natAdd k : BraidGroup (m + 1) →* BraidGroup (k + m + 1)).range =
      tailSubgroup (k + m + 1) k := by
  rw [MonoidHom.range_eq_map, ← closure_range_sigma, MonoidHom.map_closure, ← Set.range_comp,
    tailSubgroup]
  congr 1
  ext b
  simp only [Set.mem_range, Function.comp_apply, natAdd_sigma, Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨_, by simp, rfl⟩
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j - k, by have := j.isLt; omega⟩, congrArg sigma (Fin.ext (by simp; omega))⟩

/-! ### Ascending products of elementary braids -/

/-- The ascending product `σ a * σ (a + 1) * ⋯ * σ (b - 1)` of the elementary braids with index in
`[a, b)`, which is `1` when `b ≤ a`. Indices `j ≥ n - 1` name no elementary braid of `BraidGroup n`
and contribute no factor, so the relations below assume `b ≤ n - 1`. -/
def prodSigmaIco (a : ℕ) : ℕ → BraidGroup n
  | 0 => 1
  | b + 1 => if h : a ≤ b ∧ b < n - 1 then prodSigmaIco a b * sigma ⟨b, h.2⟩ else prodSigmaIco a b

/-- An ascending product over an empty range is `1`. -/
theorem prodSigmaIco_eq_one_of_le {a b : ℕ} (h : b ≤ a) : prodSigmaIco (n := n) a b = 1 := by
  induction b with
  | zero => rw [prodSigmaIco]
  | succ b ih => rw [prodSigmaIco, dite_eq_right_of_eq_false (eq_false (by omega)), ih (by omega)]

@[simp]
theorem prodSigmaIco_self (a : ℕ) : prodSigmaIco (n := n) a a = 1 :=
  prodSigmaIco_eq_one_of_le le_rfl

/-- Extending the range of an ascending product by one index multiplies it on the right by the next
elementary braid. -/
theorem prodSigmaIco_succ {a b : ℕ} (hab : a ≤ b) (hb : b < n - 1) :
    prodSigmaIco a (b + 1) = prodSigmaIco a b * sigma ⟨b, hb⟩ := by
  rw [prodSigmaIco, dite_eq_left_of_eq_true (eq_true ⟨hab, hb⟩)]

/-- An elementary braid two or more steps away from every factor of an ascending product commutes
with it. -/
theorem commute_sigma_prodSigmaIco {a b : ℕ} {j : Fin (n - 1)}
    (h : (j : ℕ) + 2 ≤ a ∨ b + 1 ≤ (j : ℕ)) : Commute (sigma j) (prodSigmaIco a b) := by
  induction b with
  | zero => rw [prodSigmaIco]; exact Commute.one_right _
  | succ b ih =>
    rw [prodSigmaIco]
    split_ifs with hab
    · exact (ih (by omega)).mul_right (sigma_mul_sigma_comm (by simp; omega))
    · exact ih (by omega)

/-- The tail subgroup at `b + 1` centralizes every ascending product ending below `b`. -/
theorem tailSubgroup_le_centralizer_prodSigmaIco (a b : ℕ) :
    tailSubgroup n (b + 1) ≤ Subgroup.centralizer {prodSigmaIco a b} :=
  tailSubgroup_le_iff.2 fun _ hj ↦ Subgroup.mem_centralizer_singleton_iff.2
    (commute_sigma_prodSigmaIco (Or.inr hj))

/-- Moving an elementary braid in the interior of the range of an ascending product from its right
to its left raises the index by one: `(σ a ⋯ σ (b - 1)) σ c = σ (c + 1) (σ a ⋯ σ (b - 1))` for
`a ≤ c` and `c + 2 ≤ b`. -/
theorem prodSigmaIco_mul_sigma {a b : ℕ} {c d : Fin (n - 1)} (hcd : (c : ℕ) + 1 = d)
    (hac : a ≤ (c : ℕ)) (hcb : (c : ℕ) + 2 ≤ b) (hb : b ≤ n - 1) :
    prodSigmaIco a b * sigma c = sigma d * prodSigmaIco a b := by
  induction b, hcb using Nat.le_induction with
  | base =>
    -- `σ a ⋯ σ (c + 1) = (σ a ⋯ σ (c - 1)) σ c σ (c + 1)`; apply the braid relation at `c`.
    have hc : c = ⟨c, by omega⟩ := rfl
    have hd : d = ⟨c + 1, by omega⟩ := Fin.ext hcd.symm
    rw [prodSigmaIco_succ (by omega) (by omega), prodSigmaIco_succ hac c.isLt, ← hc, ← hd,
      mul_assoc, mul_assoc, ← mul_assoc (sigma c), sigma_braid (Or.inl hcd)]
    simp only [← mul_assoc]
    rw [(commute_sigma_prodSigmaIco (j := d) (Or.inr (by omega))).eq]
  | succ b hb' ih =>
    rw [prodSigmaIco_succ (by omega) (by omega), mul_assoc,
      sigma_mul_sigma_comm (j := c) (by simp; omega), ← mul_assoc, ih (by omega), mul_assoc]

/-- Two ascending products commute up to a shift of the second: if `a ≤ c` and `d < b ≤ n - 1`,
then `(σ a ⋯ σ (b - 1)) (σ c ⋯ σ (d - 1)) = (σ (c + 1) ⋯ σ d) (σ a ⋯ σ (b - 1))`. -/
theorem prodSigmaIco_mul_prodSigmaIco {a b c d : ℕ} (hac : a ≤ c) (hdb : d < b)
    (hb : b ≤ n - 1) :
    prodSigmaIco (n := n) a b * prodSigmaIco c d =
      prodSigmaIco (c + 1) (d + 1) * prodSigmaIco a b := by
  induction d with
  | zero =>
    simp [prodSigmaIco_eq_one_of_le (Nat.zero_le c),
      prodSigmaIco_eq_one_of_le (by omega : 1 ≤ c + 1)]
  | succ d ih =>
    rcases Nat.lt_or_ge d c with hdc | hcd
    · rw [prodSigmaIco_eq_one_of_le (by omega : d + 1 ≤ c),
        prodSigmaIco_eq_one_of_le (by omega : d + 2 ≤ c + 1), mul_one, one_mul]
    · rw [prodSigmaIco_succ hcd (by omega), prodSigmaIco_succ (by omega) (by omega), ← mul_assoc,
        ih (by omega), mul_assoc, prodSigmaIco_mul_sigma (d := ⟨d + 1, by omega⟩) rfl
          (by simp only; omega) (by simp only; omega) hb, ← mul_assoc]

end BraidGroup

end TauCeti
