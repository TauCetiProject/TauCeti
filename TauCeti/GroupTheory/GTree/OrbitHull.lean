/-!
# The convex hull of an orbit in a tree with a group action

Let `G` act on a tree `T` without inversions, let `H` be a subgroup of `G` and `x` a vertex. The
union `T.orbitHull H x` of the segments `[x, h x]` for `h ∈ H` is the convex hull of the orbit
`H x`: it is the smallest `H`-invariant subtree of `T` containing `x`. It is the subtree on which
one lets `H` act to read off the splitting of `H` induced by the action of `G`. It depends only on
the orbit `H x`, and its translate by `g ∈ G` is the hull of the orbit of `g x` under the
conjugate subgroup `g H g⁻¹`.

If `H` is generated by a set `S`, let `K` be the convex hull of `x` and the vertices `s x` for
`s ∈ S`, which is the union of `{x}` and the segments `[x, s x]`. Then the hull of the orbit is
`H K`, and the darts it induces are the translates under `H` of the darts induced by `K`: the
segment from `x` to `s₁ ⋯ sₖ x` is covered by the translates `s₁ ⋯ sᵢ₋₁ [x, sᵢ x]`. When `S` is
finite, `K` is a finite subtree, so a finitely generated subgroup has a finite subtree whose
translates cover the hull of each of its orbits, vertices and edges.

The hull of an orbit is a single vertex exactly when `H` fixes `x`, and it is the whole tree when
`H = G` and the tree is minimal, as for the integers acting on the line.

## Main declarations

* `TauCeti.GTree.orbitHull`: the union of the segments from `x` to its translates under `H`.
* `TauCeti.GTree.orbitHull_eq_convexHull_orbit`, `TauCeti.GTree.isConvex_orbitHull`,
  `TauCeti.GTree.smul_set_orbitHull`, `TauCeti.GTree.orbitHull_subset`: it is the convex
  hull of the orbit, and the smallest convex invariant set containing `x`.
* `TauCeti.GTree.orbitHull_closure`, `TauCeti.GTree.inducedDarts_orbitHull_closure`: the hull of
  an orbit of the subgroup generated by `S`, and its darts, as translates of the hull of `x` and
  its translates under `S`.
* `TauCeti.GTree.exists_finite_orbitHull_eq_smul`: a finitely generated subgroup has a finite
  subtree whose translates cover the hull of an orbit.

## References

* I. Kapovich, R. Weidmann and A. Miasnikov, *Foldings, graphs of groups and the membership
  problem*, Internat. J. Algebra Comput. 15 (2005), §2, Definition 2.8, and the proof of
  Lemma 5.3.
* J.-P. Serre, *Trees*, Chapter I, §5.5 and §6.1.
-/

public section

universe u v w

namespace TauCeti
namespace GTree

open SerreGraph _root_.MulAction
open scoped Pointwise

variable {G : Type w} [Group G] (T : GTree.{u, v} G)

/-! ### The hull of an orbit -/

/-- The hull of the orbit of a vertex `x` under a subgroup `H`: the union of the segments from
`x` to its translates `h • x` for `h ∈ H`. It is the smallest convex set of vertices invariant
under `H` and containing `x`. -/
def orbitHull (H : Subgroup G) (x : T.V) : Set T.V :=
  ⋃ h ∈ H, T.convexHull {x, h • x}

variable {T} {H : Subgroup G} {x : T.V}

theorem mem_orbitHull_iff {v : T.V} :
    v ∈ T.orbitHull H x ↔ ∃ h ∈ H, v ∈ T.convexHull {x, h • x} := by
  simp only [orbitHull, Set.mem_iUnion, exists_prop]

/-- The translates of `x` under `H` lie in the hull of its orbit. -/
theorem smul_mem_orbitHull {h : G} (hh : h ∈ H) : h • x ∈ T.orbitHull H x :=
  mem_orbitHull_iff.mpr ⟨h, hh, right_mem_convexHull_pair x _⟩

variable (T H x)

@[simp] theorem self_mem_orbitHull : x ∈ T.orbitHull H x :=
  mem_orbitHull_iff.mpr ⟨1, H.one_mem, left_mem_convexHull_pair x _⟩

@[simp] theorem orbitHull_nonempty : (T.orbitHull H x).Nonempty :=
  ⟨x, self_mem_orbitHull T H x⟩

theorem orbit_subset_orbitHull : orbit H x ⊆ T.orbitHull H x := by
  rintro _ ⟨h, rfl⟩
  exact smul_mem_orbitHull h.2

theorem orbitHull_eq_iUnion : T.orbitHull H x = ⋃ h : H, T.convexHull {x, (h : G) • x} := by
  ext v
  simp only [mem_orbitHull_iff, Set.mem_iUnion, Subtype.exists, exists_prop]

/-- The hull of an orbit is convex. -/
theorem isConvex_orbitHull : T.IsConvex (T.orbitHull H x) := by
  rw [orbitHull_eq_iUnion]
  exact T.isTree.isConvex_iUnion (fun _ => isConvex_convexHull _)
    fun _ => left_mem_convexHull_pair x _

/-- The union of the segments from `x` to its translates under `H` is the convex hull of the orbit
of `x` under `H`. -/
theorem orbitHull_eq_convexHull_orbit : T.orbitHull H x = T.convexHull (orbit H x) := by
  refine Set.Subset.antisymm (Set.iUnion₂_subset fun h hh => convexHull_mono ?_)
    ((isConvex_orbitHull T H x).convexHull_subset (orbit_subset_orbitHull T H x))
  exact Set.pair_subset (mem_orbit_self x) (mem_orbit x (⟨h, hh⟩ : H))

variable {T H x}

/-- The hull of an orbit of `H` is invariant under `H`. -/
@[simp] theorem smul_set_orbitHull {g : G} (hg : g ∈ H) :
    g • T.orbitHull H x = T.orbitHull H x := by
  rw [orbitHull_eq_convexHull_orbit, ← convexHull_smul_set]
  exact congrArg T.convexHull (smul_orbit (⟨g, hg⟩ : H) x)

/-- The hull of an orbit of `H` is invariant under `H`. -/
@[simp] theorem smul_mem_orbitHull_iff {g : G} (hg : g ∈ H) {v : T.V} :
    g • v ∈ T.orbitHull H x ↔ v ∈ T.orbitHull H x := by
  rw [← Set.mem_inv_smul_set_iff, smul_set_orbitHull (H.inv_mem hg)]

/-- The hull of an orbit of `H` does not depend on the chosen vertex of the orbit. -/
@[simp] theorem orbitHull_smul {g : G} (hg : g ∈ H) :
    T.orbitHull H (g • x) = T.orbitHull H x := by
  rw [orbitHull_eq_convexHull_orbit, orbitHull_eq_convexHull_orbit]
  exact congrArg T.convexHull (orbit_smul (⟨g, hg⟩ : H) x)

variable (T H x) in
/-- The translate by `g` of the hull of the orbit of `x` under `H` is the hull of the orbit of
`g • x` under the conjugate subgroup `g H g⁻¹`. -/
theorem orbitHull_map_conj (g : G) :
    T.orbitHull (H.map (MulAut.conj g : G →* G)) (g • x) = g • T.orbitHull H x := by
  ext v
  simp only [mem_orbitHull_iff, Subgroup.mem_map, exists_exists_and_eq_and, MonoidHom.coe_ofClass,
    MulAut.conj_apply, mul_smul, inv_smul_smul, ← smul_set_convexHull_pair,
    Set.mem_smul_set_iff_inv_smul_mem]

/-- The hull of an orbit of `H` is contained in every convex set containing the orbit: it is the
smallest subtree invariant under `H` and containing `x`. -/
theorem orbitHull_subset {C : Set T.V} (hC : T.IsConvex C)
    (h : ∀ h ∈ H, h • x ∈ C) : T.orbitHull H x ⊆ C :=
  Set.iUnion₂_subset fun g hg => hC.convexHull_subset
    (Set.pair_subset (by simpa using h 1 H.one_mem) (h g hg))

variable (T x) in
theorem orbitHull_mono {H K : Subgroup G} (h : H ≤ K) : T.orbitHull H x ⊆ T.orbitHull K x :=
  Set.biUnion_subset_biUnion_left h

/-- The hull of an orbit of `H` is a single vertex exactly when `H` fixes that vertex. -/
theorem orbitHull_eq_singleton_iff : T.orbitHull H x = {x} ↔ H ≤ stabilizer G x := by
  refine ⟨fun h g hg => ?_, fun h => ?_⟩
  · simpa [h] using smul_mem_orbitHull (x := x) hg
  · refine (orbitHull_subset (T.isAcyclic.isConvex_singleton x) fun g hg => ?_).antisymm
      (Set.singleton_subset_iff.mpr (self_mem_orbitHull T H x))
    exact mem_stabilizer_iff.mp (h hg)

variable (T x) in
/-- The hull of an orbit of the trivial subgroup is a single vertex. -/
@[simp] theorem orbitHull_bot : T.orbitHull ⊥ x = {x} :=
  orbitHull_eq_singleton_iff.mpr bot_le

/-- In a minimal tree, the hull of every orbit of the whole group is the whole tree. -/
theorem IsMinimal.orbitHull_top (hT : T.IsMinimal) (x : T.V) : T.orbitHull ⊤ x = Set.univ :=
  isMinimal_iff.mp hT _ (orbitHull_nonempty T ⊤ x) (isConvex_orbitHull T ⊤ x) fun g _ hv =>
    (smul_mem_orbitHull_iff (Subgroup.mem_top g)).mpr hv

/-- The hull of every orbit of the integers on the line is the whole line. -/
@[simp] theorem line_orbitHull_top (v : line.V) : line.orbitHull ⊤ v = Set.univ :=
  line_isMinimal.orbitHull_top v

/-! ### Subgroups generated by a set -/

variable (T x) (S : Set G)

/-- The convex hull of `x` and its translates under `S` is the union of `{x}` and the segments
from `x` to these translates. -/
theorem convexHull_insert_image_smul :
    T.convexHull (insert x ((· • x) '' S)) = insert x (⋃ s ∈ S, T.convexHull {x, s • x}) := by
  rw [T.isTree.convexHull_insert, Set.biUnion_image]

/-- Let `F` be a monotone equivariant operation on sets of vertices that commutes with unions of
two convex sets having a common vertex. Then `F` maps a segment from `x` to a translate of `x`
under the subgroup generated by `S` into the translates of the image under `F` of the convex hull
of `x` and its translates under `S`. -/
private theorem apply_convexHull_pair_subset {α : Type*} [MulAction G α] {F : Set T.V → Set α}
    (hmono : Monotone F) (hsmul : ∀ (g : G) (C : Set T.V), F (g • C) = g • F C)
    (hunion : ∀ A B : Set T.V, T.IsConvex A → T.IsConvex B → (A ∩ B).Nonempty →
      F (A ∪ B) = F A ∪ F B) {h : G} (hh : h ∈ Subgroup.closure S) :
    F (T.convexHull {x, h • x}) ⊆
      (Subgroup.closure S : Set G) • F (T.convexHull (insert x ((· • x) '' S))) := by
  -- A segment inside the hull `K` of `x` and its translates under `S` is mapped into `F K`.
  have hK : ∀ g : G, g • x ∈ T.convexHull (insert x ((· • x) '' S)) → F (T.convexHull {x, g • x}) ⊆
      (Subgroup.closure S : Set G) • F (T.convexHull (insert x ((· • x) '' S))) := fun g hg =>
    (hmono ((isConvex_convexHull _).convexHull_subset
      (Set.pair_subset (subset_convexHull _ (Set.mem_insert x _)) hg))).trans fun a ha =>
        Set.mem_smul.mpr ⟨1, one_mem _, a, ha, one_smul G a⟩
  -- The translates of `F K` under the subgroup form an invariant set.
  have hinv : ∀ g ∈ Subgroup.closure S, ∀ A : Set α,
      A ⊆ (Subgroup.closure S : Set G) • F (T.convexHull (insert x ((· • x) '' S))) →
      g • A ⊆ (Subgroup.closure S : Set G) • F (T.convexHull (insert x ((· • x) '' S))) := by
    intro g hg A hA
    exact (Set.smul_set_mono hA).trans_eq (by rw [← smul_assoc, smul_coe_set hg])
  induction hh using Subgroup.closure_induction with
  | mem s hs =>
    exact hK s (subset_convexHull _ (Set.mem_insert_of_mem x (Set.mem_image_of_mem _ hs)))
  | one => exact hK 1 (by rw [one_smul]; exact subset_convexHull _ (Set.mem_insert x _))
  | mul g h hg _ ihg ihh =>
    refine (hmono (convexHull_pair_mul_smul_subset T g h x)).trans ?_
    rw [hunion _ _ (isConvex_convexHull _) (isConvex_smul_set_iff.mpr (isConvex_convexHull _))
      ⟨g • x, right_mem_convexHull_pair x _,
        Set.smul_mem_smul_set (left_mem_convexHull_pair x _)⟩, hsmul]
    exact Set.union_subset ihg (hinv g hg _ ihh)
  | inv g hg ih =>
    rw [convexHull_pair_inv_smul, hsmul]
    exact hinv g⁻¹ (inv_mem hg) _ ih

/-- The convex hull of `x` and its translates under `S` lies in the hull of the orbit of `x` under
the subgroup generated by `S`. -/
theorem convexHull_insert_image_smul_subset_orbitHull :
    T.convexHull (insert x ((· • x) '' S)) ⊆ T.orbitHull (Subgroup.closure S) x := by
  refine (isConvex_orbitHull T _ x).convexHull_subset
    (Set.insert_subset (self_mem_orbitHull T _ x) ?_)
  rintro _ ⟨s, hs, rfl⟩
  exact smul_mem_orbitHull (Subgroup.subset_closure hs)

/-- The hull of the orbit of `x` under the subgroup generated by `S` consists of the translates
under that subgroup of the convex hull of `x` and its translates under `S`. -/
theorem orbitHull_closure : T.orbitHull (Subgroup.closure S) x =
    (Subgroup.closure S : Set G) • T.convexHull (insert x ((· • x) '' S)) := by
  refine Set.Subset.antisymm (fun v hv => ?_) ?_
  · obtain ⟨h, hh, hv⟩ := mem_orbitHull_iff.mp hv
    exact apply_convexHull_pair_subset T x S (F := id) monotone_id (fun _ _ => rfl)
      (fun _ _ _ _ _ => rfl) hh hv
  · rintro _ ⟨h, hh, k, hk, rfl⟩
    exact (smul_mem_orbitHull_iff hh).mpr (convexHull_insert_image_smul_subset_orbitHull T x S hk)

variable (H) in
/-- The darts induced by the hull of an orbit are those induced by the segments from `x` to its
translates. -/
theorem inducedDarts_orbitHull :
    T.inducedDarts (T.orbitHull H x) = ⋃ h ∈ H, T.inducedDarts (T.convexHull {x, h • x}) := by
  rw [orbitHull_eq_iUnion, T.isTree.inducedDarts_iUnion (fun _ => isConvex_convexHull _)
    fun _ => left_mem_convexHull_pair x _]
  ext e
  simp only [Set.mem_iUnion, Subtype.exists, exists_prop]

/-- The darts induced by the hull of the orbit of `x` under the subgroup generated by `S` are the
translates under that subgroup of the darts induced by the convex hull of `x` and its translates
under `S`. -/
theorem inducedDarts_orbitHull_closure : T.inducedDarts (T.orbitHull (Subgroup.closure S) x) =
    (Subgroup.closure S : Set G) •
      T.inducedDarts (T.convexHull (insert x ((· • x) '' S))) := by
  refine Set.Subset.antisymm (fun e he => ?_) ?_
  · rw [inducedDarts_orbitHull] at he
    obtain ⟨h, hh, he⟩ := Set.mem_iUnion₂.mp he
    exact apply_convexHull_pair_subset T x S (F := T.inducedDarts)
      (fun _ _ => inducedDarts_mono) (fun g C => (smul_set_inducedDarts T g C).symm)
      (fun _ _ hA hB hAB => T.isTree.inducedDarts_union hA hB hAB) hh he
  · rintro _ ⟨h, hh, e, he, rfl⟩
    have he' := inducedDarts_mono (convexHull_insert_image_smul_subset_orbitHull T x S) he
    rw [← smul_set_orbitHull (x := x) hh, ← smul_set_inducedDarts]
    exact Set.smul_mem_smul_set he'

variable {T} (H) in
/-- A finitely generated subgroup has a finite subtree containing `x` whose translates cover the
hull of the orbit of `x`, both its vertices and the darts it induces. In particular this hull
meets finitely many orbits of vertices and induces finitely many orbits of darts. -/
theorem exists_finite_orbitHull_eq_smul (hH : H.FG) : ∃ K : Set T.V, K.Finite ∧ T.IsConvex K ∧
    x ∈ K ∧ T.orbitHull H x = (H : Set G) • K ∧
      T.inducedDarts (T.orbitHull H x) = (H : Set G) • T.inducedDarts K := by
  obtain ⟨S, rfl, hS⟩ := (Subgroup.fg_iff H).mp hH
  exact ⟨_, T.isAcyclic.finite_convexHull ((hS.image _).insert x), isConvex_convexHull _,
    subset_convexHull _ (Set.mem_insert x _), orbitHull_closure T x S,
    inducedDarts_orbitHull_closure T x S⟩

end GTree
end TauCeti
