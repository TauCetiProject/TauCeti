module

public import TauCeti.GroupTheory.GTree.Restrict
public import TauCeti.GroupTheory.GTree.OrbitHull

/-!
# The action of a subgroup on the convex hull of an orbit

Let `G` act on a tree `T` without inversions and let `H` be a subgroup of `G`. Then `H` acts on
the subtree spanned by any nonempty convex `H`-invariant set `C` of vertices (`GTree.restrict`):
an element of `H` moves a vertex or a dart of the subtree as it does in `T`, so the stabilizer in
`H` of a vertex or a dart is its stabilizer in `G` intersected with `H`. By the structure theorem
for groups acting on trees, the quotient graph of this action carries the splitting of `H`
induced by `C`.

The preferred invariant subtree is the convex hull `T.orbitHull H x` of an orbit `H x`, the union
of the segments `[x, h x]` for `h ∈ H`, which gives the `H`-tree `GTree.orbitTree T H x`. If `H`
is generated by a finite set `S`, the hull is the union of the translates under `H` of the finite
subtree spanned by `x` and the `s x` for `s ∈ S`, and its darts are the translates of the darts of
that subtree; so the quotient graph of `T.orbitTree H x` is finite. For the commutator subgroup
of a free group of rank two acting on its Cayley tree the quotient is infinite, so finite
generation cannot be dropped. In the same way, a finitely generated group acting minimally on a
tree has a finite quotient graph, since the hull of any orbit of the whole group is then the
whole tree. If `H` fixes `x`, the orbit tree is the single vertex `x`, without darts.

## Main declarations

* `TauCeti.GTree.restrict`: the action of a subgroup on an invariant subtree.
* `TauCeti.GTree.map_stabilizer_restrict_vertex`, `TauCeti.GTree.map_stabilizer_restrict_dart`:
  its stabilizers are the intersections of the subgroup with the stabilizers in `G`.
* `TauCeti.GTree.orbitTree`: the action of a subgroup on the convex hull of an orbit.
* `TauCeti.GTree.finite_quotient_V_orbitTree`, `TauCeti.GTree.finite_quotient_E_orbitTree`: for
  a finitely generated subgroup its quotient graph is finite.
* `TauCeti.GTree.IsMinimal.finite_quotient_V`, `TauCeti.GTree.IsMinimal.finite_quotient_E`: the
  quotient graph of a minimal action of a finitely generated group is finite.
* `TauCeti.GTree.subsingleton_orbitTree_V`, `TauCeti.GTree.isEmpty_orbitTree_E`: the orbit tree
  of a subgroup fixing the base vertex is a single vertex.

## References

* I. Kapovich, R. Weidmann and A. Miasnikov, *Foldings, graphs of groups and the membership
  problem*, Internat. J. Algebra Comput. 15 (2005), §2, Remark 2.7 and Definition 2.8.
* V. Guirardel and G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §1.2.
* J.-P. Serre, *Trees*, Chapter I, §5.5.
-/

public section

universe u v w

namespace TauCeti

open _root_.MulAction
open scoped Pointwise

namespace GTree

variable {G : Type w} [Group G] {T : GTree.{u, v} G}

/-! ### Finiteness of the quotient graph -/

/-- If a finite set of vertices meets every orbit, the quotient graph has finitely many
vertices. -/
theorem finite_quotient_V_of_forall_exists_smul_mem {K : Set T.V} (hK : K.Finite)
    (h : ∀ v : T.V, ∃ g : G, g • v ∈ K) : Finite T.quotient.V := by
  have := hK.to_subtype
  refine Finite.of_surjective (fun k : K => T.quotientMap.mapV k) fun b => ?_
  obtain ⟨v, rfl⟩ := T.quotientMap_mapV_surjective b
  obtain ⟨g, hg⟩ := h v
  exact ⟨⟨g • v, hg⟩, quotientMap_mapV_smul g v⟩

/-- If a finite set of darts meets every orbit, the quotient graph has finitely many darts. -/
theorem finite_quotient_E_of_forall_exists_smul_mem {K : Set T.E} (hK : K.Finite)
    (h : ∀ e : T.E, ∃ g : G, g • e ∈ K) : Finite T.quotient.E := by
  have := hK.to_subtype
  refine Finite.of_surjective (fun k : K => T.quotientMap.mapE k) fun b => ?_
  obtain ⟨e, rfl⟩ := T.quotientMap_mapE_surjective b
  obtain ⟨g, hg⟩ := h e
  exact ⟨⟨g • e, hg⟩, quotientMap_mapE_smul g e⟩

/-- A finitely generated group acting minimally on a tree has a quotient graph with finitely many
vertices. -/
theorem IsMinimal.finite_quotient_V [Group.FG G] (hT : T.IsMinimal) : Finite T.quotient.V := by
  obtain ⟨x⟩ : Nonempty T.V := inferInstance
  obtain ⟨K, hK, -, -, hV, -⟩ := exists_finite_orbitHull_eq_smul ⊤ x (Group.fg_def.mp ‹_›)
  refine finite_quotient_V_of_forall_exists_smul_mem hK fun v => ?_
  have hv : v ∈ T.orbitHull ⊤ x := by simp [hT.orbitHull_top x]
  obtain ⟨g, -, k, hk, rfl⟩ := Set.mem_smul.mp (hV.subset hv)
  exact ⟨g⁻¹, by simpa using hk⟩

/-- A finitely generated group acting minimally on a tree has a quotient graph with finitely many
darts. -/
theorem IsMinimal.finite_quotient_E [Group.FG G] (hT : T.IsMinimal) : Finite T.quotient.E := by
  obtain ⟨x⟩ : Nonempty T.V := inferInstance
  obtain ⟨K, hK, -, -, -, hE⟩ := exists_finite_orbitHull_eq_smul ⊤ x (Group.fg_def.mp ‹_›)
  refine finite_quotient_E_of_forall_exists_smul_mem (T.isAcyclic.finite_inducedDarts hK)
    fun e => ?_
  have he : e ∈ T.inducedDarts (T.orbitHull ⊤ x) := by simp [hT.orbitHull_top x]
  obtain ⟨g, -, k, hk, rfl⟩ := Set.mem_smul.mp (hE.subset he)
  exact ⟨g⁻¹, by simpa using hk⟩

/-! ### Restriction to a subgroup and an invariant subtree -/

variable (T) (H : Subgroup G)

/-- The action of a subgroup `H` on the subtree spanned by a nonempty convex `H`-invariant set of
vertices. -/
@[expose] def restrict (C : Set T.V) (hC : T.IsConvex C) (hne : C.Nonempty)
    (hinv : ∀ h ∈ H, ∀ v ∈ C, h • v ∈ C) : GTree.{u, v} H :=
  (T.comap H.subtype).subtree C hC hne fun h v hv => hinv h h.property v hv

variable {T H} {C : Set T.V} (hC : T.IsConvex C) (hne : C.Nonempty)
  (hinv : ∀ h ∈ H, ∀ v ∈ C, h • v ∈ C)

/-- An element of `H` moves a vertex of an invariant subtree as it moves it in the tree. -/
@[simp] theorem restrict_smul_vertex_val (h : H) (v : (T.restrict H C hC hne hinv).V) :
    Subtype.val (h • v) = (h : G) • (Subtype.val v : T.V) :=
  (T.comap H.subtype).subtree_smul_vertex_val hC hne _ h v

/-- An element of `H` moves a dart of an invariant subtree as it moves it in the tree. -/
@[simp] theorem restrict_smul_dart_val (h : H) (e : (T.restrict H C hC hne hinv).E) :
    Subtype.val (h • e) = (h : G) • (Subtype.val e : T.E) :=
  (T.comap H.subtype).subtree_smul_dart_val hC hne _ h e

/-- The stabilizer in `H` of a vertex of an invariant subtree is the intersection of `H` with its
stabilizer in `G`. -/
theorem map_stabilizer_restrict_vertex (v : (T.restrict H C hC hne hinv).V) :
    (stabilizer H v).map H.subtype = H ⊓ stabilizer G (Subtype.val v : T.V) := by
  rw [inf_comm, ← Subgroup.subgroupOf_map_subtype]
  congr 1
  ext h
  rw [Subgroup.mem_subgroupOf, mem_stabilizer_iff, mem_stabilizer_iff,
    ← restrict_smul_vertex_val hC hne hinv]
  exact Subtype.val_injective.eq_iff.symm

/-- The stabilizer in `H` of a dart of an invariant subtree is the intersection of `H` with its
stabilizer in `G`. -/
theorem map_stabilizer_restrict_dart (e : (T.restrict H C hC hne hinv).E) :
    (stabilizer H e).map H.subtype = H ⊓ stabilizer G (Subtype.val e : T.E) := by
  rw [inf_comm, ← Subgroup.subgroupOf_map_subtype]
  congr 1
  ext h
  rw [Subgroup.mem_subgroupOf, mem_stabilizer_iff, mem_stabilizer_iff,
    ← restrict_smul_dart_val hC hne hinv]
  exact Subtype.val_injective.eq_iff.symm

/-! ### The convex hull of an orbit -/

variable (T H) in
/-- The action of a subgroup `H` on the convex hull of the orbit of a vertex `x`. -/
@[expose] def orbitTree (x : T.V) : GTree.{u, v} H :=
  T.restrict H (T.orbitHull H x) (T.isConvex_orbitHull H x) (T.orbitHull_nonempty H x)
    fun _ hh _ hv => (smul_mem_orbitHull_iff hh).2 hv

/-- An element of `H` moves a vertex of the convex hull of an `H`-orbit as it moves it in the
tree. -/
@[simp] theorem orbitTree_smul_vertex_val {x : T.V} (h : H) (v : (T.orbitTree H x).V) :
    Subtype.val (h • v) = (h : G) • (Subtype.val v : T.V) :=
  restrict_smul_vertex_val _ _ _ h v

/-- An element of `H` moves a dart of the convex hull of an `H`-orbit as it moves it in the
tree. -/
@[simp] theorem orbitTree_smul_dart_val {x : T.V} (h : H) (e : (T.orbitTree H x).E) :
    Subtype.val (h • e) = (h : G) • (Subtype.val e : T.E) :=
  restrict_smul_dart_val _ _ _ h e

/-- The quotient of the convex hull of an orbit of a finitely generated subgroup has finitely
many vertices. -/
theorem finite_quotient_V_orbitTree (hH : H.FG) (x : T.V) :
    Finite (T.orbitTree H x).quotient.V := by
  obtain ⟨K, hK, -, -, hV, -⟩ := exists_finite_orbitHull_eq_smul H x hH
  refine finite_quotient_V_of_forall_exists_smul_mem
    (hK.preimage Subtype.val_injective.injOn) fun v => ?_
  -- The membership of `v` in the hull, read on the vertices of `T`, on which `G` acts.
  have hv : (Subtype.val v : T.V) ∈ T.orbitHull H x := v.property
  obtain ⟨g, hg, k, hk, hgk⟩ := Set.mem_smul.mp (hV.subset hv)
  refine ⟨⟨g⁻¹, H.inv_mem hg⟩, Set.mem_preimage.mpr ?_⟩
  rw [orbitTree_smul_vertex_val, ← hgk, Subgroup.coe_mk, inv_smul_smul]
  exact hk

/-- The quotient of the convex hull of an orbit of a finitely generated subgroup has finitely
many darts. -/
theorem finite_quotient_E_orbitTree (hH : H.FG) (x : T.V) :
    Finite (T.orbitTree H x).quotient.E := by
  obtain ⟨K, hK, -, -, -, hE⟩ := exists_finite_orbitHull_eq_smul H x hH
  refine finite_quotient_E_of_forall_exists_smul_mem
    ((T.isAcyclic.finite_inducedDarts hK).preimage Subtype.val_injective.injOn) fun e => ?_
  -- The membership of `e` in the induced darts, read on the darts of `T`, on which `G` acts.
  have he : (Subtype.val e : T.E) ∈ T.inducedDarts (T.orbitHull H x) := e.property
  obtain ⟨g, hg, k, hk, hgk⟩ := Set.mem_smul.mp (hE.subset he)
  refine ⟨⟨g⁻¹, H.inv_mem hg⟩, Set.mem_preimage.mpr ?_⟩
  rw [orbitTree_smul_dart_val, ← hgk, Subgroup.coe_mk, inv_smul_smul]
  exact hk

/-- The convex hull of the orbit of a vertex fixed by the subgroup is that vertex. -/
theorem subsingleton_orbitTree_V {x : T.V} (h : H ≤ stabilizer G x) :
    Subsingleton (T.orbitTree H x).V :=
  (Set.subsingleton_singleton.anti (orbitHull_eq_singleton_iff.mpr h).subset).coe_sort

/-- The convex hull of the orbit of a vertex fixed by the subgroup has no darts. -/
theorem isEmpty_orbitTree_E {x : T.V} (h : H ≤ stabilizer G x) : IsEmpty (T.orbitTree H x).E := by
  refine ⟨fun e => ?_⟩
  have he : (Subtype.val e : T.E) ∈ T.inducedDarts (T.orbitHull H x) := e.property
  simp [orbitHull_eq_singleton_iff.mpr h] at he

end GTree

end TauCeti
