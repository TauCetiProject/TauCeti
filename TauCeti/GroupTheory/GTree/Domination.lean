/-!
# Domination tested on elliptic elements

Let a finitely generated group `G` act without inversions on trees `T₁` and `T₂`. Domination of
`T₂` by `T₁` asks every vertex stabilizer of `T₁` to fix a vertex of `T₂`, a condition on
subgroups which need not be finitely generated. When `T₁` is elliptic with respect to `T₂`, that
is when every dart stabilizer of `T₁` fixes a vertex of `T₂`, it is a condition on elements:
`T₁` dominates `T₂` as soon as every element which is elliptic in `T₁` is elliptic in `T₂`
(`GTree.dominates_of_isEllipticWith`). Indeed a vertex stabilizer of `T₁` is generated by a
finite set and the stabilizers of finitely many darts (`GTree.exists_finite_stabilizer_eq_closure`),
and Serre's lemma for finitely many generating sets (`GTree.isEllipticSubgroup_closure_iUnion`)
applies to these sets in `T₂`.

The hypothesis on elements is needed: a tree with one vertex is elliptic with respect to every
tree (`GTree.isEllipticWith_of_subsingleton`), but it dominates only the trees in which `G` fixes
a vertex; for instance it does not dominate the line of the infinite cyclic group
(`GTree.not_point_dominates_line`). Finite generation cannot be replaced by countability: the
additive group `ℤ[1/2]` acts on the tree of cosets of the chain of subgroups `2⁻ⁿℤ` with every
element fixing a vertex and no vertex fixed by the whole group, so the tree with one vertex
satisfies both hypotheses with respect to this tree and does not dominate it.

A finitely generated group is countable, so a family of trees has a countable subfamily such that
every element hyperbolic in some tree of the family is hyperbolic in some tree of the subfamily.
This subfamily tests domination: a tree which dominates every tree of the subfamily dominates every
tree of the family with respect to which it is elliptic (`GTree.exists_countable_forall_dominates`).

Fix families `𝒜` and `ℋ` of subgroups. A universally elliptic tree is elliptic with respect to
every minimal tree relative to `𝒜` and `ℋ` (`GTree.IsUniversallyElliptic.isEllipticWith`), so:

* two universally elliptic minimal relative trees with the same elliptic elements lie in the same
  deformation space (`GTree.IsUniversallyElliptic.sameDeformationSpace`);
* there is a sequence of universally elliptic minimal relative trees which tests domination: a
  universally elliptic tree dominating every tree of the sequence dominates every universally
  elliptic minimal relative tree
  (`GTree.exists_seq_forall_dominates_of_isUniversallyElliptic`). A JSJ tree is a universally
  elliptic minimal relative tree dominating every universally elliptic minimal relative tree, so
  its existence reduces to the existence of a universally elliptic minimal relative tree
  dominating the countably many trees of this sequence.

## Main declarations

* `TauCeti.GTree.dominates_of_isEllipticWith`: if `T₁` is elliptic with respect to `T₂` and every
  element elliptic in `T₁` is elliptic in `T₂`, then `T₁` dominates `T₂`.
* `TauCeti.GTree.exists_countable_forall_dominates`: a countable subfamily of a family of trees
  tests domination of the trees of the family.
* `TauCeti.GTree.IsUniversallyElliptic.sameDeformationSpace`: universally elliptic trees with the
  same elliptic elements lie in the same deformation space.
* `TauCeti.GTree.exists_seq_forall_dominates_of_isUniversallyElliptic`: a sequence of universally
  elliptic trees testing domination of all universally elliptic trees.

## References

* V. Guirardel and G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017),
  Definition 2.1, Lemma 2.6 (2), Lemma 2.8 (3), Lemma 2.9 and the proof of Theorem 2.16.
  Their trees are minimal `(𝒜, ℋ)`-trees; minimality is needed here only in Lemma 2.8 (3).
  Their proof of Lemma 2.6 (2) goes through standard refinements (Proposition 2.2); the proof
  here uses their Lemma 4.7 instead. In Lemma 2.9 they ask the tree to be elliptic with respect to
  every tree of the family; here ellipticity is asked only with respect to the tree that it is
  shown to dominate. Their proof of Theorem 2.16 enumerates the universally elliptic trees with
  finitely generated stabilizers, which needs `G` to be finitely presented; the sequence here comes
  from Lemma 2.9 and only needs `G` to be finitely generated.
* J.-P. Serre, *Trees*, Chapter I, §6.5.
-/

public section

universe u v u' v' w

namespace TauCeti

open _root_.MulAction

namespace GTree

variable {G : Type w} [Group G]

/-! ### Lemma 2.6 (2): domination tested on elliptic elements -/

/-- **Domination tested on elliptic elements.** Let `G` be finitely generated and let the tree
`T₁` be elliptic with respect to `T₂`. If every element which is elliptic in `T₁` is elliptic in
`T₂`, then `T₁` dominates `T₂`. -/
theorem dominates_of_isEllipticWith [_root_.Group.FG G] {T₁ : GTree.{u, v} G}
    {T₂ : GTree.{u', v'} G} (h : T₁.IsEllipticWith T₂)
    (hg : ∀ g : G, T₁.IsElliptic g → T₂.IsElliptic g) : T₁.Dominates T₂ := by
  refine dominates_iff.mpr fun x => ?_
  obtain ⟨F, hF, E₀, hE₀, -, hx⟩ := T₁.exists_finite_stabilizer_eq_closure x
  have := hE₀.to_subtype
  -- The stabilizer of `x` is generated by `F` and the stabilizers of the darts of `E₀`.
  let S : Option E₀ → Set G := fun o => o.elim F fun e => stabilizer G e.val
  have hS : ⋃ o, S o = F ∪ ⋃ e ∈ E₀, (stabilizer G e : Set G) := by
    simp [S, Set.iUnion_option]
  have hle (o : Option E₀) : S o ⊆ stabilizer G x := by
    rw [hx, ← hS]
    exact (Set.subset_iUnion S o).trans Subgroup.subset_closure
  -- Every element of the stabilizer of `x` is elliptic in `T₂`.
  have hell {g : G} (hgx : g ∈ stabilizer G x) : T₂.IsElliptic g :=
    hg g (isElliptic_iff.mpr ⟨x, mem_stabilizer_iff.mp hgx⟩)
  rw [hx, ← hS]
  refine isEllipticSubgroup_closure_iUnion (fun o => ?_)
    fun i j _ a ha b hb => hell (mul_mem (hle i ha) (hle j hb))
  rcases o with _ | e
  · exact IsEllipticSubgroup.of_fg ((Subgroup.fg_iff _).mpr ⟨F, rfl, hF⟩)
      fun g hgF => hell ((Subgroup.closure_le _).mpr (hle none) hgF)
  · simpa [S] using isEllipticWith_iff.mp h e.val

/-! ### Lemma 2.9: a countable subfamily tests domination -/

/-- **A countable subfamily tests domination.** Let `G` be finitely generated. A family of trees
has a countable subfamily such that a tree dominating every tree of the subfamily dominates every
tree of the family with respect to which it is elliptic. -/
theorem exists_countable_forall_dominates [_root_.Group.FG G] {ι : Type*}
    (T : ι → GTree.{u', v'} G) : ∃ J : Set ι, J.Countable ∧ ∀ S : GTree.{u, v} G,
      (∀ j ∈ J, S.Dominates (T j)) → ∀ i, S.IsEllipticWith (T i) → S.Dominates (T i) := by
  have := IsMulFG.countable G
  -- Countably many trees of the family witness the hyperbolicity of every element.
  obtain ⟨J, hJ, hwit⟩ :=
    exists_countable_forall_exists_mem fun (g : G) (i : ι) => (T i).IsHyperbolic g
  refine ⟨J, hJ, fun S hdom i hi => dominates_of_isEllipticWith hi fun g hg => ?_⟩
  refine not_isHyperbolic_iff.mp fun hgi => ?_
  obtain ⟨j, hj, hgj⟩ := hwit g i hgi
  exact not_isHyperbolic_iff.mpr ((hdom j hj).isElliptic hg) hgj

/-! ### Universally elliptic trees -/

variable {𝒜 ℋ : Set (Subgroup G)}

/-- **Universally elliptic trees with the same elliptic elements.** Let `G` be finitely generated.
Two universally elliptic minimal trees relative to `𝒜` and `ℋ` with the same elliptic elements lie
in the same deformation space. -/
theorem IsUniversallyElliptic.sameDeformationSpace [_root_.Group.FG G] {T T' : GTree.{u, v} G}
    (hT : T.IsUniversallyElliptic 𝒜 ℋ) (hm : T.IsMinimal) (hr : T.IsRelative 𝒜 ℋ)
    (hT' : T'.IsUniversallyElliptic 𝒜 ℋ) (hm' : T'.IsMinimal) (hr' : T'.IsRelative 𝒜 ℋ)
    (h : ∀ g : G, T.IsElliptic g ↔ T'.IsElliptic g) : T.SameDeformationSpace T' :=
  sameDeformationSpace_iff.mpr
    ⟨dominates_of_isEllipticWith (hT.isEllipticWith hm' hr') fun g => (h g).mp,
      dominates_of_isEllipticWith (hT'.isEllipticWith hm hr) fun g => (h g).mpr⟩

/-- **A sequence of universally elliptic trees testing domination.** Let `G` be finitely
generated. There is a sequence of universally elliptic minimal trees relative to `𝒜` and `ℋ` such
that a universally elliptic tree dominating every tree of the sequence dominates every universally
elliptic minimal tree relative to `𝒜` and `ℋ`. -/
theorem exists_seq_forall_dominates_of_isUniversallyElliptic [_root_.Group.FG G]
    (𝒜 ℋ : Set (Subgroup G)) : ∃ U : ℕ → GTree.{u, v} G,
      (∀ n, (U n).IsMinimal ∧ (U n).IsRelative 𝒜 ℋ ∧ (U n).IsUniversallyElliptic 𝒜 ℋ) ∧
      ∀ S : GTree.{u, v} G, S.IsUniversallyElliptic 𝒜 ℋ → (∀ n, S.Dominates (U n)) →
        ∀ T : GTree.{u, v} G, T.IsMinimal → T.IsRelative 𝒜 ℋ → T.IsUniversallyElliptic 𝒜 ℋ →
          S.Dominates T := by
  -- A countable subfamily of the universally elliptic minimal relative trees tests domination.
  let ι := {T : GTree.{u, v} G // T.IsMinimal ∧ T.IsRelative 𝒜 ℋ ∧ T.IsUniversallyElliptic 𝒜 ℋ}
  obtain ⟨J, hJ, h⟩ := exists_countable_forall_dominates.{u, v} fun T : ι => T.val
  -- Adding the one-vertex tree makes it nonempty, so it is the range of a sequence.
  let pt : ι := ⟨point G, point_isMinimal G, point_isRelative G 𝒜 ℋ, point_isUniversallyElliptic⟩
  obtain ⟨f, hf⟩ := (hJ.insert pt).exists_eq_range (Set.insert_nonempty pt J)
  refine ⟨fun n => (f n).val, fun n => (f n).property, fun S hu hdom T hT hTr hTu => ?_⟩
  refine h S (fun j hj => ?_) ⟨T, hT, hTr, hTu⟩ (hu.isEllipticWith hT hTr)
  obtain ⟨n, hn⟩ : j ∈ Set.range f := hf ▸ Set.mem_insert_of_mem pt hj
  exact hn ▸ hdom n

end GTree

end TauCeti
