module

public import TauCeti.GroupTheory.GTree.Bridge
public import TauCeti.GroupTheory.GTree.Cayley

/-!
# The minimal invariant subtree of a subgroup acting on a tree

Let `G` act on a tree `T` without inversions and let `H` be a subgroup of `G`. The union of the
axes of the hyperbolic elements of `H` is `GTree.minimalSubtree T H`. It is convex and
`H`-invariant, and it is contained in every nonempty convex `H`-invariant set of vertices; when
`H` contains a hyperbolic element it is therefore the unique minimal `H`-invariant subtree.

A finitely generated subgroup either fixes a vertex or contains a hyperbolic element. The minimal
subtree of the cyclic subgroup generated by a hyperbolic element is its axis, which is also the
convex hull of the orbit of any vertex of the axis. In the Cayley tree of a free group, the axis
of a basis element `a` consists of the powers of `a`, and the axes of two distinct basis elements
meet only in the identity.

## Main declarations

* `TauCeti.GTree.minimalSubtree`: the union of the axes of the hyperbolic elements of a subgroup.
* `TauCeti.GTree.isConvex_minimalSubtree`, `TauCeti.GTree.smul_mem_minimalSubtree_iff`,
  `TauCeti.GTree.minimalSubtree_subset`: it is convex, invariant, and contained in every nonempty
  convex invariant set of vertices.
* `TauCeti.GTree.minimalSubtree_nonempty_iff`: it is nonempty exactly when the subgroup contains
  a hyperbolic element.
* `TauCeti.GTree.isEllipticSubgroup_or_exists_isHyperbolic`: a finitely generated subgroup fixes a
  vertex or contains a hyperbolic element.
* `TauCeti.GTree.minimalSubtree_zpowers_eq_axis`, `TauCeti.GTree.orbitHull_zpowers_eq_axis`: the
  minimal subtree of a hyperbolic cyclic subgroup, and the hull of an orbit on the axis.
* `TauCeti.GTree.cayley_axis_of`, `TauCeti.GTree.cayley_axis_of_inter_axis_of`: axes of basis
  elements in the Cayley tree of a free group.

## References

* V. Guirardel, G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §1.2 and
  Proposition 1.1.
* J.-P. Serre, *Trees*, Chapter I, §6.4 and §6.5.
-/

public section

universe u v w

namespace TauCeti
namespace GTree

open SerreGraph

variable {G : Type w} [Group G] (T : GTree.{u, v} G)

/-- The union of the axes of the hyperbolic elements of a subgroup: its minimal invariant
subtree, when the subgroup contains a hyperbolic element. -/
def minimalSubtree (H : Subgroup G) : Set T.V :=
  {v | ∃ h ∈ H, T.IsHyperbolic h ∧ v ∈ T.axis h}

variable {T} {H : Subgroup G}

theorem mem_minimalSubtree_iff {v : T.V} :
    v ∈ T.minimalSubtree H ↔ ∃ h ∈ H, T.IsHyperbolic h ∧ v ∈ T.axis h := Iff.rfl

/-- The axis of a hyperbolic element of `H` lies in the minimal subtree of `H`. -/
theorem axis_subset_minimalSubtree {h : G} (hh : h ∈ H) (hyp : T.IsHyperbolic h) :
    T.axis h ⊆ T.minimalSubtree H :=
  fun _ hv => ⟨h, hh, hyp, hv⟩

/-- The minimal subtree is nonempty exactly when the subgroup contains a hyperbolic element. -/
theorem minimalSubtree_nonempty_iff : (T.minimalSubtree H).Nonempty ↔ ∃ h ∈ H, T.IsHyperbolic h :=
  ⟨fun ⟨_, h, hh, hyp, _⟩ => ⟨h, hh, hyp⟩, fun ⟨h, hh, hyp⟩ =>
    (T.axis_nonempty h).mono (axis_subset_minimalSubtree hh hyp)⟩

/-- An element of `H` maps the axis of a hyperbolic element `h` of `H` to the axis of the
hyperbolic element `g * h * g⁻¹` of `H`. -/
private theorem smul_mem_minimalSubtree {g : G} (hg : g ∈ H) {v : T.V}
    (hv : v ∈ T.minimalSubtree H) : g • v ∈ T.minimalSubtree H := by
  obtain ⟨h, hh, hyp, hv⟩ := hv
  exact ⟨g * h * g⁻¹, H.mul_mem (H.mul_mem hg hh) (H.inv_mem hg), isHyperbolic_conj_iff.mpr hyp,
    mem_axis_conj_iff.mpr (by rwa [inv_smul_smul])⟩

/-- The minimal subtree of `H` is invariant under `H`. -/
@[simp] theorem smul_mem_minimalSubtree_iff {g : G} (hg : g ∈ H) {v : T.V} :
    g • v ∈ T.minimalSubtree H ↔ v ∈ T.minimalSubtree H :=
  ⟨fun hv => by simpa using smul_mem_minimalSubtree (H.inv_mem hg) hv, smul_mem_minimalSubtree hg⟩

/-- The minimal subtree grows with the subgroup. -/
theorem minimalSubtree_mono {K : Subgroup G} (h : H ≤ K) :
    T.minimalSubtree H ⊆ T.minimalSubtree K :=
  fun _ ⟨g, hg, hyp, hv⟩ => ⟨g, h hg, hyp, hv⟩

variable (T H) in
/-- The union of the axes of the hyperbolic elements of a subgroup is convex. -/
theorem isConvex_minimalSubtree : T.IsConvex (T.minimalSubtree H) := by
  refine isConvex_iff.mpr ?_
  rintro a ⟨g, hg, hyg, ha⟩ b ⟨h, hh, hyh, hb⟩ p hp e he
  -- A reduced path from `a` to `b` stays in the segment `[a, b]`.
  refine (?_ : T.convexHull {a, b} ⊆ T.minimalSubtree H) ((isConvex_convexHull _).src_mem
    (left_mem_convexHull_pair a b) (right_mem_convexHull_pair a b) hp he)
  have hgμ := axis_subset_minimalSubtree hg hyg
  have hhμ := axis_subset_minimalSubtree hh hyh
  by_cases hd : Disjoint (T.axis g) (T.axis h)
  · -- The segment lies in the axes of `g`, of the hyperbolic element `g * h`, and of `h`.
    exact (convexHull_pair_subset_axis_union ha hb).trans <| Set.union_subset (Set.union_subset hgμ
      (axis_subset_minimalSubtree (H.mul_mem hg hh) (isHyperbolic_mul_of_disjoint_axis hd))) hhμ
  · -- The union of two meeting axes is convex.
    exact ((T.isTree.isConvex_union (T.isConvex_axis g) (T.isConvex_axis h)
      (Set.not_disjoint_iff_nonempty_inter.mp hd)).convexHull_subset
        (Set.pair_subset (Or.inl ha) (Or.inr hb))).trans (Set.union_subset hgμ hhμ)

/-- The minimal subtree of `H` is contained in every nonempty convex `H`-invariant set of
vertices. Since it is itself convex and `H`-invariant, it is, when nonempty, the unique minimal
`H`-invariant subtree: an invariant subtree inside it is all of it, and a minimal invariant
subtree contains it. -/
theorem minimalSubtree_subset {C : Set T.V} (hC : T.IsConvex C) (hne : C.Nonempty)
    (hinv : ∀ h ∈ H, ∀ v ∈ C, h • v ∈ C) : T.minimalSubtree H ⊆ C := by
  rintro v ⟨h, hh, hyp, hv⟩
  refine hyp.axis_subset hC (fun x => ⟨fun hx => ?_, hinv h hh x⟩) hne hv
  simpa using hinv h⁻¹ (H.inv_mem hh) _ hx

/-- The minimal subtree of `H` is contained in the convex hull of every orbit of `H`. -/
theorem minimalSubtree_subset_orbitHull (x : T.V) : T.minimalSubtree H ⊆ T.orbitHull H x :=
  minimalSubtree_subset (isConvex_orbitHull T H x) (orbitHull_nonempty T H x)
    fun _ hh _ hv => (smul_mem_orbitHull_iff hh).mpr hv

/-- A minimal action with a hyperbolic element has the whole tree as minimal subtree. -/
theorem IsMinimal.minimalSubtree_top (hT : T.IsMinimal) (h : ∃ g : G, T.IsHyperbolic g) :
    T.minimalSubtree ⊤ = Set.univ :=
  isMinimal_iff.mp hT _ (minimalSubtree_nonempty_iff.mpr (by simpa using h))
    (isConvex_minimalSubtree T ⊤) fun g _ hv =>
      (smul_mem_minimalSubtree_iff (Subgroup.mem_top g)).mpr hv

/-- A finitely generated subgroup acting on a tree fixes a vertex or contains a hyperbolic
element. -/
theorem isEllipticSubgroup_or_exists_isHyperbolic (hH : H.FG) :
    T.IsEllipticSubgroup H ∨ ∃ h ∈ H, T.IsHyperbolic h :=
  or_iff_not_imp_right.mpr fun h => IsEllipticSubgroup.of_fg hH fun g hg =>
    not_isHyperbolic_iff.mp fun hyp => h ⟨g, hg, hyp⟩

/-- The minimal subtree of the cyclic subgroup generated by a hyperbolic element is its axis. -/
theorem minimalSubtree_zpowers_eq_axis {g : G} (hg : T.IsHyperbolic g) :
    T.minimalSubtree (Subgroup.zpowers g) = T.axis g := by
  refine Set.Subset.antisymm ?_ (axis_subset_minimalSubtree (Subgroup.mem_zpowers g) hg)
  rintro v ⟨h, hh, hyp, hv⟩
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hh
  rwa [hg.axis_zpow (isHyperbolic_zpow_iff.mp hyp).2] at hv

/-- The convex hull of the orbit under the powers of a hyperbolic element of a point of its axis
is the axis. -/
theorem orbitHull_zpowers_eq_axis {g : G} (hg : T.IsHyperbolic g) {x : T.V} (hx : x ∈ T.axis g) :
    T.orbitHull (Subgroup.zpowers g) x = T.axis g := by
  refine Set.Subset.antisymm (orbitHull_subset (T.isConvex_axis g) fun h hh => ?_) ?_
  · obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hh
    exact (zpow_smul_mem_axis_iff n).mpr hx
  · rw [← minimalSubtree_zpowers_eq_axis hg]
    exact minimalSubtree_subset_orbitHull x

/-! ### The Cayley tree of a free group -/

section Cayley

variable {α : Type*}

/-- The axis of a basis element `a` in the Cayley tree consists of the powers of `a`. -/
theorem cayley_axis_of (a : α) : (cayley α).axis (FreeGroup.of a) =
    {v : (cayley α).V | cayleyVertexEquiv v ∈ Subgroup.zpowers (FreeGroup.of a)} := by
  classical
  obtain ⟨c, hc⟩ : ∃ c : ℤ → (cayley α).V, ∀ n, cayleyVertexEquiv (c n) = FreeGroup.of a ^ n :=
    ⟨fun n => cayleyVertexEquiv.symm _, fun n => Equiv.apply_symm_apply _ _⟩
  -- The powers of `a` form a geodesic line, translated by one step by `a`.
  have hdist (m n : ℤ) : (cayley α).dist (c m) (c n) = (m - n).natAbs := by
    refine (SerreGraph.cayley_dist _ _).trans ?_
    rw [hc, hc, ← zpow_neg, ← zpow_add, FreeGroup.norm_of_zpow]
    lia
  rw [axis_eq_range_of_smul_eq_add hdist one_ne_zero fun n => cayleyVertexEquiv.injective (by
    rw [cayleyVertexEquiv_cayley_smul, hc, hc, mul_self_zpow])]
  ext v
  simp only [Set.mem_range, Set.mem_ofPred_eq, Subgroup.mem_zpowers_iff, ← hc]
  exact exists_congr fun n => cayleyVertexEquiv.injective.eq_iff.symm

/-- The axes of two distinct basis elements in the Cayley tree meet in exactly one vertex, the
identity. -/
theorem cayley_axis_of_inter_axis_of {a b : α} (hab : a ≠ b) :
    (cayley α).axis (FreeGroup.of a) ∩ (cayley α).axis (FreeGroup.of b) =
      {v : (cayley α).V | cayleyVertexEquiv v = 1} := by
  ext v
  simp only [cayley_axis_of, Set.mem_inter_iff, Set.mem_ofPred_eq, Subgroup.mem_zpowers_iff]
  refine ⟨fun ⟨⟨n, hn⟩, m, hm⟩ => ?_, fun h => ⟨⟨0, by rw [h, zpow_zero]⟩, 0, by rw [h, zpow_zero]⟩⟩
  obtain ⟨rfl, -⟩ := FreeGroup.eq_of_of_zpow_eq_of_zpow hab (hn.trans hm.symm)
  rw [← hn, zpow_zero]

-- The minimal subtree of the cyclic subgroup generated by a basis element `a`, in the Cayley
-- tree, consists of the powers of `a`: a proper nonempty subtree when the basis has two elements.
example (a : α) : (cayley α).minimalSubtree (Subgroup.zpowers (FreeGroup.of a)) =
    {v : (cayley α).V | cayleyVertexEquiv v ∈ Subgroup.zpowers (FreeGroup.of a)} := by
  rw [minimalSubtree_zpowers_eq_axis (cayley_isHyperbolic_iff.mpr (FreeGroup.of_ne_one a)),
    cayley_axis_of]

end Cayley

end GTree
end TauCeti
