public import TauCeti.GroupTheory.GTree.Basic
public import TauCeti.Combinatorics.Graph.Serre.Helly
public import Mathlib.GroupTheory.Finiteness
public import Mathlib.GroupTheory.GroupAction.FixingSubgroup

/-!
# Fixed points of finitely generated groups acting on trees

This file proves Serre's lemma: if a finitely generated group acts on a tree without inversions
and every element of it is elliptic, then the whole group fixes a vertex. For a group generated by
a finite set `S` it is enough that the elements of `S` and their pairwise products are elliptic.
More generally, if finitely many sets `S i` each generate a subgroup fixing a vertex, and every
product of an element of `S i` and an element of `S j` with `i ≠ j` is elliptic, then the union of
the `S i` generates a subgroup fixing a vertex.
Finite generation cannot be dropped: an infinitely generated group, such as the additive group of
`ℚ` acting on a suitable tree, may consist of elliptic elements without fixing a vertex.

The proof has two steps.

* A criterion for hyperbolicity: if a reduced path from `x` to `g • x` is followed by its
  translate under `g` without backtracking, then the translates of the path by the powers of `g`
  line up into reduced paths, so `d(x, gⁿ x) = n d(x, g x)` (`GTree.dist_pow_smul_eq_mul`).
  Comparing with a vertex moved by the translation length `ℓ(g)` shows that `x` is moved by
  exactly `ℓ(g)` (`GTree.dist_smul_eq_translationLength_of_isReduced`), so `g` is hyperbolic if it
  moves `x` (`GTree.isHyperbolic_of_isReduced`). Applied to a shortest path between the
  vertices fixed by the subgroups generated by two sets `S` and `S'`, it shows that these
  subgroups have a common fixed vertex when every product of an element of `S` and an element
  of `S'` is elliptic: otherwise some element of `S` moves the first dart of the path and some
  element of `S'` moves its last dart (`GTree.isEllipticSubgroup_closure_union`). For the sets
  `{s}` and `{t}` this says that the product of two elliptic elements without a common fixed
  vertex is hyperbolic (`GTree.isHyperbolic_mul_of_disjoint`).
* Helly's theorem for subtrees (`SerreGraph.IsTree.helly_theorem`): the fixed point sets of
  finitely many such subgroups are convex and, by the first step, pairwise intersecting, so they
  have a common vertex (`GTree.isEllipticSubgroup_closure_iUnion`). The case of singleton sets is
  the lemma for elements, the case of subgroups is the lemma for joins of subgroups
  (`GTree.isEllipticSubgroup_iSup`).

## Main results

* `TauCeti.GTree.isHyperbolic_mul_of_disjoint`: the product of two elliptic elements without a
  common fixed vertex is hyperbolic.
* `TauCeti.GTree.isEllipticSubgroup_closure_iUnion`: if finitely many sets each generate a
  subgroup fixing a vertex and the products of elements of two different sets are elliptic, then
  their union generates a subgroup fixing a vertex.
* `TauCeti.GTree.isEllipticSubgroup_iSup`: if finitely many subgroups each fix a vertex and the
  products of elements of two different subgroups are elliptic, then their join fixes a vertex.
* `TauCeti.GTree.isEllipticSubgroup_closure`: a subgroup generated by finitely many elliptic
  elements whose pairwise products are elliptic fixes a vertex.
* `TauCeti.GTree.isEllipticSubgroup_iff_forall_isElliptic`: a finitely generated subgroup fixes a
  vertex exactly when each of its elements does.

## References

* J.-P. Serre, *Trees*, Chapter I, §6.5, Proposition 26 and Corollaries 1–3.
* V. Guirardel and G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §1.2,
  Serre's lemma (p. 16) and Proposition 1.1.
-/

public section

universe u v w

namespace TauCeti
namespace GTree

open SerreGraph _root_.MulAction

variable {G : Type w} [Group G] {T : GTree.{u, v} G}

/-! ### A criterion for hyperbolicity -/

/-- If a reduced path from `x` to `g • x` is followed by its translate under `g` without
backtracking, then `d(x, gⁿ x) = n d(x, g x)` for every `n`: the translates of the path by
`1, g, …, gⁿ⁻¹` form a reduced path from `x` to `gⁿ • x`. -/
theorem dist_pow_smul_eq_mul {g : G} {x : T.V} {p : T.Path x (g • x)}
    (hp : Path.IsReduced T.toSerreGraph p)
    (hg : ∀ e ∈ (Path.darts T.toSerreGraph p).getLast?,
      ∀ f ∈ (Path.darts T.toSerreGraph p).head?, g • f ≠ T.rev e) (n : ℕ) :
    T.dist x (g ^ n • x) = n * T.dist x (g • x) := by
  have hacyc := IsTree.isAcyclic _ T.isTree
  -- Build the reduced path by induction, keeping track of its length and of the condition that
  -- lets the next translate of `p` follow it without backtracking.
  have key : ∀ n : ℕ, ∃ q : T.Path x (g ^ n • x), Path.IsReduced T.toSerreGraph q ∧
      q.length = n * p.length ∧ ∀ e ∈ (Path.darts T.toSerreGraph q).getLast?,
        ∀ f ∈ (Path.darts T.toSerreGraph p).head?, g ^ n • f ≠ T.rev e := by
    intro n
    induction n with
    | zero =>
      refine ⟨(Quiver.Path.nil : T.Path x x).cast rfl (by rw [pow_zero, one_smul]), ?_, ?_, ?_⟩
      · rw [Path.isReduced_cast]
        exact Path.isReduced_nil _ x
      · rw [← Path.length_darts, Path.darts_cast, Path.darts_nil, List.length_nil, zero_mul]
      · simp
    | succ n ih =>
      obtain ⟨q, hq, hqlen, hqlast⟩ := ih
      let r' : T.Path (g ^ n • x) (g ^ (n + 1) • x) :=
        (smulPath (g ^ n) p).cast rfl (by rw [pow_succ, mul_smul])
      have hr'darts : Path.darts T.toSerreGraph r' =
          (Path.darts T.toSerreGraph p).map (g ^ n • ·) := by
        rw [Path.darts_cast, darts_smulPath]
      refine ⟨q.comp r', ?_, ?_, ?_⟩
      · refine (Path.isReduced_comp_iff _ q r').mpr ⟨hq,
          by rwa [Path.isReduced_cast, isReduced_smulPath], fun e he f hf => ?_⟩
        rw [hr'darts, List.head?_map, Option.mem_def, Option.map_eq_some_iff] at hf
        obtain ⟨f, hf, rfl⟩ := hf
        exact hqlast e he f hf
      · rw [Quiver.Path.length_comp, hqlen, ← Path.length_darts _ r', hr'darts,
          List.length_map, Path.length_darts, Nat.succ_mul]
      · intro e he f hf
        cases hl : (Path.darts T.toSerreGraph p).getLast? with
        | none => simp [List.getLast?_eq_none_iff.mp hl] at hf
        | some e' =>
          simp only [Path.darts_comp, hr'darts, List.getLast?_append, List.getLast?_map, hl,
            Option.map_some, Option.some_or, Option.mem_some_iff] at he
          subst he
          rw [rev_smul, pow_succ, mul_smul, Ne, smul_left_cancel_iff]
          exact hg e' hl f hf
  obtain ⟨q, hq, hqlen, -⟩ := key n
  rw [hacyc.dist_eq_length hq, hacyc.dist_eq_length hp, hqlen]

/-- If a reduced path from `x` to `g • x` is followed by its translate under `g` without
backtracking, then `x` is moved by the translation length of `g`. -/
theorem dist_smul_eq_translationLength_of_isReduced {g : G} {x : T.V} {p : T.Path x (g • x)}
    (hp : Path.IsReduced T.toSerreGraph p)
    (hg : ∀ e ∈ (Path.darts T.toSerreGraph p).getLast?,
      ∀ f ∈ (Path.darts T.toSerreGraph p).head?, g • f ≠ T.rev e) :
    T.dist x (g • x) = T.translationLength g := by
  obtain ⟨v, hv⟩ := exists_dist_eq_translationLength (T := T) g
  refine le_antisymm ?_ (translationLength_le g x)
  -- Compare the displacements of `x` and `v` under a large power of `g`: the first grows like
  -- `n d(x, g x)`, the second at most like `n ℓ(g)`, and they differ by at most `2 d(x, v)`.
  set n := 2 * T.dist x v + 1
  have h₁ := dist_pow_smul_eq_mul hp hg n
  have h₂ := T.dist_pow_smul_le g v n
  have h₃ := T.dist_smul_le_dist_smul_add_two_mul_dist (g ^ n) v x
  rw [hv] at h₂
  have h : n * T.dist x (g • x) < n * (T.translationLength g + 1) := by
    rw [mul_add, mul_one]
    omega
  exact Nat.lt_succ_iff.mp (Nat.lt_of_mul_lt_mul_left h)

/-- **A criterion for hyperbolicity.** If `g` moves `x` and a reduced path from `x` to `g • x` is
followed by its translate under `g` without backtracking, then `g` is hyperbolic. -/
theorem isHyperbolic_of_isReduced {g : G} {x : T.V} (hx : g • x ≠ x) {p : T.Path x (g • x)}
    (hp : Path.IsReduced T.toSerreGraph p)
    (hg : ∀ e ∈ (Path.darts T.toSerreGraph p).getLast?,
      ∀ f ∈ (Path.darts T.toSerreGraph p).head?, g • f ≠ T.rev e) :
    T.IsHyperbolic g := by
  rw [← translationLength_pos_iff, ← dist_smul_eq_translationLength_of_isReduced hp hg]
  exact Nat.pos_of_ne_zero fun h => hx ((dist_eq_zero_iff (T.nonempty_path _ _)).mp h).symm

/-! ### Serre's lemma for two sets -/

/-- Let `p` be a nonempty reduced path from `a` to `b`. If `s` fixes `a` but not the first dart
of `p`, and `t` fixes `b` but not the last dart of `p`, then `s * t` is hyperbolic. -/
theorem isHyperbolic_mul_of_isReduced {s t : G} {a b : T.V} {p : T.Path a b}
    (hp : Path.IsReduced T.toSerreGraph p) (hab : a ≠ b) (hs : s • a = a)
    (hsf : ∀ f ∈ (Path.darts T.toSerreGraph p).head?, s • f ≠ f) (ht : t • b = b)
    (hte : ∀ e ∈ (Path.darts T.toSerreGraph p).getLast?, t • e ≠ e) :
    T.IsHyperbolic (s * t) := by
  have hne : Path.darts T.toSerreGraph p ≠ [] := fun h => hab (Path.eq_of_darts_eq_nil _ p h)
  obtain ⟨f, hf⟩ : ∃ f, (Path.darts T.toSerreGraph p).head? = some f :=
    ⟨_, List.head?_eq_some_head hne⟩
  obtain ⟨e, he⟩ : ∃ e, (Path.darts T.toSerreGraph p).getLast? = some e :=
    ⟨_, List.getLast?_eq_some_getLast hne⟩
  -- The path from `b` back along `p` to `a` and then along `s • p` to `s • b = (s * t) • b`.
  have hsb : s • b = (s * t) • b := by rw [mul_smul, ht]
  let q : T.Path b ((s * t) • b) := p.reverse.comp ((smulPath s p).cast hs hsb)
  have hqdarts : Path.darts T.toSerreGraph q = (Path.darts T.toSerreGraph p).reverse.map T.rev ++
      (Path.darts T.toSerreGraph p).map (s • ·) := by
    rw [Path.darts_comp, Path.darts_reverse, Path.darts_cast, darts_smulPath]
  have hq : Path.IsReduced T.toSerreGraph q := by
    refine (Path.isReduced_comp_iff _ _ _).mpr ⟨(Path.isReduced_reverse _ p).mpr hp,
      by rwa [Path.isReduced_cast, isReduced_smulPath], fun e' he' f' hf' => ?_⟩
    simp only [Path.darts_reverse, List.getLast?_map, List.getLast?_reverse, hf, Option.map_some,
      Option.mem_some_iff] at he'
    simp only [Path.darts_cast, darts_smulPath, List.head?_map, hf, Option.map_some,
      Option.mem_some_iff] at hf'
    subst he' hf'
    rw [rev_rev]
    exact hsf f hf
  -- The criterion for hyperbolicity applies at `b`.
  refine isHyperbolic_of_isReduced (x := b) ?_ hq fun e' he' f' hf' => ?_
  · rw [← hsb]
    intro hsb'
    exact hsf f hf (Aut.smul_eq_of_mem_darts (IsTree.isAcyclic _ T.isTree) (T.action s) hs hsb'
      hp (List.mem_of_mem_head? hf))
  · simp only [hqdarts, List.getLast?_append, List.getLast?_map, he, Option.map_some,
      Option.some_or, Option.mem_some_iff] at he'
    simp only [hqdarts, List.head?_append, List.head?_map, List.head?_reverse, he,
      Option.map_some, Option.some_or, Option.mem_some_iff] at hf'
    subst he' hf'
    rw [rev_smul, mul_smul, Ne, smul_left_cancel_iff, ← rev_smul, (T.rev_injective).eq_iff]
    exact hte e he

/-- **Serre's lemma for two generating sets.** Let `S` and `S'` be sets each generating a
subgroup which fixes a vertex. If every product of an element of `S` and an element of `S'` is
elliptic, then `S ∪ S'` generates a subgroup which fixes a vertex. -/
theorem isEllipticSubgroup_closure_union {S S' : Set G}
    (hS : T.IsEllipticSubgroup (Subgroup.closure S))
    (hS' : T.IsEllipticSubgroup (Subgroup.closure S'))
    (h : ∀ a ∈ S, ∀ b ∈ S', T.IsElliptic (a * b)) :
    T.IsEllipticSubgroup (Subgroup.closure (S ∪ S')) := by
  simp only [isEllipticSubgroup_iff, Subgroup.closure_le, Set.union_subset_iff] at hS hS' ⊢
  -- Join the vertices fixed by `S` to those fixed by `S'` by a shortest path.
  obtain ⟨x, hx, y, hy, p, hp, hpS⟩ :=
    ((connected_iff _).mp (IsTree.connected _ T.isTree)).2.exists_isReduced_path
      (A := {v | S ⊆ stabilizer G v}) (B := {v | S' ⊆ stabilizer G v}) hS hS'
  by_cases hxy : x = y
  · exact ⟨x, hx, hxy ▸ hy⟩
  -- Otherwise some `a ∈ S` moves the first dart of the path and some `b ∈ S'` moves its last
  -- dart, so `a * b` is hyperbolic.
  have hnil : Path.darts T.toSerreGraph p ≠ [] := fun h => hxy (Path.eq_of_darts_eq_nil _ p h)
  obtain ⟨a, ha, haf⟩ := Set.not_subset.mp (hpS _ (List.head_mem hnil)).1
  obtain ⟨b, hb, hbe⟩ := Set.not_subset.mp (hpS _ (List.getLast_mem hnil)).2
  refine (not_isHyperbolic_iff.mpr (h a ha b hb) (isHyperbolic_mul_of_isReduced hp hxy
    (mem_stabilizer_iff.mp (hx ha)) (fun f hf haf' => haf ?_) (mem_stabilizer_iff.mp (hy hb))
    fun e he hbe' => hbe ?_)).elim
  · rw [List.head?_eq_some_head hnil, Option.mem_some_iff] at hf
    rw [hf, SetLike.mem_coe, mem_stabilizer_iff, ← tgt_smul, haf']
  · rw [List.getLast?_eq_some_getLast hnil, Option.mem_some_iff] at he
    rw [he, SetLike.mem_coe, mem_stabilizer_iff, ← src_smul, hbe']

/-- Two elliptic elements whose product is elliptic have a common fixed vertex. -/
theorem exists_smul_eq_and_smul_eq_of_isElliptic_mul {s t : G} (hs : T.IsElliptic s)
    (ht : T.IsElliptic t) (hst : T.IsElliptic (s * t)) : ∃ v : T.V, s • v = v ∧ t • v = v := by
  -- This is the case of the sets `{s}` and `{t}`.
  simpa only [isEllipticSubgroup_iff, Subgroup.closure_le, Set.union_subset_iff,
    Set.singleton_subset_iff, SetLike.mem_coe, mem_stabilizer_iff] using
    isEllipticSubgroup_closure_union (T := T) (S := {s}) (S' := {t})
      (by simpa [← Subgroup.zpowers_eq_closure]) (by simpa [← Subgroup.zpowers_eq_closure])
      (by simpa)

/-- **Serre's lemma on pairs of elliptic elements.** The product of two elliptic elements without
a common fixed vertex is hyperbolic. -/
theorem isHyperbolic_mul_of_disjoint {s t : G} (hs : T.IsElliptic s) (ht : T.IsElliptic t)
    (hst : Disjoint (fixedBy T.V s) (fixedBy T.V t)) : T.IsHyperbolic (s * t) := by
  by_contra h
  obtain ⟨v, hsv, htv⟩ :=
    exists_smul_eq_and_smul_eq_of_isElliptic_mul hs ht (not_isHyperbolic_iff.mp h)
  exact Set.disjoint_left.mp hst (mem_fixedBy.mpr hsv) (mem_fixedBy.mpr htv)

/-- **Serre's lemma for two subgroups.** If subgroups `H` and `K` each fix a vertex and every
product of an element of `H` and an element of `K` is elliptic, then `H ⊔ K` fixes a vertex. -/
theorem IsEllipticSubgroup.sup {H K : Subgroup G} (hH : T.IsEllipticSubgroup H)
    (hK : T.IsEllipticSubgroup K) (h : ∀ a ∈ H, ∀ b ∈ K, T.IsElliptic (a * b)) :
    T.IsEllipticSubgroup (H ⊔ K) := by
  rw [Subgroup.sup_eq_closure]
  exact isEllipticSubgroup_closure_union (by simpa) (by simpa) h

/-! ### Serre's lemma -/

/-- **Serre's lemma for finitely many generating sets.** Let `S i` be finitely many sets each
generating a subgroup which fixes a vertex. If every product of an element of `S i` and an element
of `S j` with `i ≠ j` is elliptic, then the union of the `S i` generates a subgroup which fixes a
vertex. -/
theorem isEllipticSubgroup_closure_iUnion {ι : Type*} [Finite ι] {S : ι → Set G}
    (hS : ∀ i, T.IsEllipticSubgroup (Subgroup.closure (S i)))
    (h : Pairwise fun i j => ∀ a ∈ S i, ∀ b ∈ S j, T.IsElliptic (a * b)) :
    T.IsEllipticSubgroup (Subgroup.closure (⋃ i, S i)) := by
  have := Fintype.ofFinite ι
  rw [Subgroup.closure_iUnion, isEllipticSubgroup_iff_nonempty_fixedPoints,
    fixedPoints_subgroup_iSup]
  -- The vertices fixed by the subgroups generated by the `S i` form convex sets which pairwise
  -- intersect by the case of two sets, so they have a common vertex by Helly's theorem.
  simpa using T.isTree.helly_theorem (F := fun i => fixedPoints (Subgroup.closure (S i)) T.V)
    (s := Finset.univ) (fun i _ => T.isConvex_fixedPoints _) fun i _ j _ => by
      obtain rfl | hij := eq_or_ne i j
      · simpa using isEllipticSubgroup_iff_nonempty_fixedPoints.mp (hS i)
      rw [← fixedPoints_subgroup_sup, ← Subgroup.closure_union,
        ← isEllipticSubgroup_iff_nonempty_fixedPoints]
      exact isEllipticSubgroup_closure_union (hS i) (hS j) (h hij)

/-- **Serre's lemma for finitely many subgroups.** If finitely many subgroups `H i` each fix a
vertex and every product of an element of `H i` and an element of `H j` with `i ≠ j` is elliptic,
then `⨆ i, H i` fixes a vertex. -/
theorem isEllipticSubgroup_iSup {ι : Type*} [Finite ι] {H : ι → Subgroup G}
    (hH : ∀ i, T.IsEllipticSubgroup (H i))
    (h : Pairwise fun i j => ∀ a ∈ H i, ∀ b ∈ H j, T.IsElliptic (a * b)) :
    T.IsEllipticSubgroup (⨆ i, H i) := by
  rw [Subgroup.iSup_eq_closure]
  exact isEllipticSubgroup_closure_iUnion (by simpa) h

/-- **Serre's lemma for a finite set of subgroups.** If each subgroup in a finite set `ℋ` fixes a
vertex and every product of elements of two different subgroups in `ℋ` is elliptic, then the
supremum of `ℋ` fixes a vertex. -/
theorem isEllipticSubgroup_sSup {ℋ : Set (Subgroup G)} (hℋ : ℋ.Finite)
    (hH : ∀ H ∈ ℋ, T.IsEllipticSubgroup H)
    (h : ℋ.Pairwise fun H K => ∀ a ∈ H, ∀ b ∈ K, T.IsElliptic (a * b)) :
    T.IsEllipticSubgroup (sSup ℋ) := by
  have := hℋ.to_subtype
  rw [sSup_eq_iSup']
  exact isEllipticSubgroup_iSup (fun H => hH H H.2) fun H K hHK =>
    h H.2 K.2 (Subtype.coe_injective.ne hHK)

/-- **Serre's lemma.** A subgroup generated by a finite set of elliptic elements whose pairwise
products are elliptic fixes a vertex. -/
theorem isEllipticSubgroup_closure {S : Set G} (hS : S.Finite) (h₁ : ∀ s ∈ S, T.IsElliptic s)
    (h₂ : S.Pairwise fun s t => T.IsElliptic (s * t)) :
    T.IsEllipticSubgroup (Subgroup.closure S) := by
  -- This is the case of the singletons `{s}`, `s ∈ S`.
  have := hS.to_subtype
  simpa using isEllipticSubgroup_closure_iUnion (T := T) (S := fun s : S => {s.1})
    (fun s => by simpa [← Subgroup.zpowers_eq_closure] using h₁ s s.2)
    fun s t hst a ha b hb => by
      rw [Set.mem_singleton_iff] at ha hb
      subst ha hb
      exact h₂ s.2 t.2 (Subtype.coe_injective.ne hst)

/-- **Serre's lemma.** A finitely generated subgroup all of whose elements are elliptic fixes a
vertex. -/
theorem IsEllipticSubgroup.of_fg {H : Subgroup G} (hH : H.FG) (h : ∀ g ∈ H, T.IsElliptic g) :
    T.IsEllipticSubgroup H := by
  obtain ⟨S, rfl, hS⟩ := (Subgroup.fg_iff H).mp hH
  exact isEllipticSubgroup_closure hS
    (fun s hs => h s (Subgroup.subset_closure hs)) fun s hs t ht _ =>
      h _ (mul_mem (Subgroup.subset_closure hs) (Subgroup.subset_closure ht))

/-- A finitely generated subgroup fixes a vertex exactly when each of its elements does. -/
theorem isEllipticSubgroup_iff_forall_isElliptic {H : Subgroup G} (hH : H.FG) :
    T.IsEllipticSubgroup H ↔ ∀ g ∈ H, T.IsElliptic g :=
  ⟨fun h _ hg => h.isElliptic hg, IsEllipticSubgroup.of_fg hH⟩

end GTree
end TauCeti
