/-!
# The quotient graph of groups of a group acting on a tree

Let a group `G` act on a tree `T` without inversions, with quotient graph `B = T / G`
(`GTree.quotient`), and let `D : T.Lifting` be a lifting of `B` to `T`. This file constructs the
quotient graph of groups `D.graphOfGroups` over `B`, proves that `G` is canonically isomorphic to
its fundamental group, shows that `D.graphOfGroups` is independent of the choice of lifting up to
isomorphism of graphs of groups, and deduces the free-product decomposition for actions with
trivial dart stabilizers and the freeness of groups acting freely on trees.

For a lifting `D`:

* The vertex group at `b : B.V` is `stabilizer G (D.vertex b)`.
* The edge group at a geometric edge `z : B.GeomEdge` is
  `stabilizer G (D.dart (GeomEdge.out B z))`.
* For a dart `y : B.E` with geometric edge `z = B.toGeomEdge y`, when `y = GeomEdge.out B z` the
  boundary monomorphism `α_y` is the inclusion of `stabilizer G (D.dart y)` into
  `stabilizer G (D.vertex (B.src y))` and `ω_y` is conjugation by `(D.twist y)⁻¹` into
  `stabilizer G (D.vertex (B.tgt y))`; for the reverse dart `α` and `ω` exchange roles. In both
  cases `D.twist y * ω_y(c) * (D.twist y)⁻¹ = α_y(c)` in `G`, the image of `α_y` is the subgroup
  `stabilizer G (D.dart y)`, and the image of `ω_y` is `stabilizer G (D.dart (B.rev y))`.

Sending each vertex group into `G` by subgroup inclusion and each dart `y` to `D.twist y` defines a
homomorphism `D.π₁TreeToGroup : π₁(D.graphOfGroups, D.tree) →* G`. Surjectivity follows from
`GTree.Lifting.iSup_stabilizer_sup_closure_range_twist`: `G` is generated by the stabilizers of the
lifted vertices together with the elements `D.twist y`. Injectivity follows from the normal form
theorem for `D.graphOfGroups`: a reduced alternating loop of positive length lifts to a reduced path
of positive length in the tree `T`, whose endpoints must therefore be distinct. Composing with
`GraphOfGroups.π₁Equiv` identifies the path fundamental group `π₁(D.graphOfGroups, b₀)` at any base
vertex `b₀` with `G` as well.

Any two liftings `D₁` and `D₂` of `T` have vertex and dart lifts in the same `G`-orbits. Choosing
orbit-comparison elements gives mutually inverse morphisms of graphs of groups between
`D₁.graphOfGroups` and `D₂.graphOfGroups` over the identity of `T.quotient`.

When every dart stabilizer is trivial, `D.equivCoprodFreeGroup` decomposes `G` as the free product
of the lifted vertex groups `D.graphOfGroups.vertexGroup b` (that is, `stabilizer G (D.vertex b)`)
with a free group on the positively oriented darts outside `D.tree`; this is the algebraic step of
Kurosh's subgroup theorem. When every vertex stabilizer is trivial, `D.equivFreeGroup` identifies
`G` with that free group, and `GTree.isFreeGroup_of_stabilizer_eq_bot` concludes that every group
acting freely without inversions on a tree is free.

## Main definitions

* `TauCeti.GTree.Lifting.edgeGroupHom`: the boundary monomorphism `ω_y` at a dart `y`.
* `TauCeti.GTree.Lifting.graphOfGroups`: the quotient graph of groups associated to a lifting `D`.
* `TauCeti.GTree.Lifting.vertexGroupSubtype`, `TauCeti.GTree.Lifting.edgeGroupSubtype`: the
  subgroup inclusions of the vertex and edge groups of `D.graphOfGroups` into `G`.
* `TauCeti.GTree.Lifting.π₁TreeToGroup`: the homomorphism `π₁(D.graphOfGroups, D.tree) →* G`.
* `TauCeti.GTree.Lifting.π₁TreeEquiv`: the isomorphism `π₁(D.graphOfGroups, D.tree) ≃* G`.
* `TauCeti.GTree.Lifting.π₁Equiv`: the isomorphism `π₁(D.graphOfGroups, b₀) ≃* G`.
* `TauCeti.GTree.Lifting.homOfOrbits`: the isomorphism of graphs of groups between
  `D₁.graphOfGroups` and `D₂.graphOfGroups` built from orbit-comparison elements.
* `TauCeti.GTree.Lifting.equivCoprodFreeGroup`: the free-product decomposition of `G` when all dart
  stabilizers are trivial.
* `TauCeti.GTree.Lifting.equivFreeGroup`: the free-group isomorphism of `G` when all vertex
  stabilizers are trivial.

## Main results

* `TauCeti.GTree.Lifting.π₁TreeToGroup_bijective`: `D.π₁TreeToGroup` is bijective.
* `TauCeti.GTree.Lifting.exists_hom_graphOfGroups`: for any two liftings `D₁` and `D₂`, there are
  mutually inverse morphisms of graphs of groups between `D₁.graphOfGroups` and
  `D₂.graphOfGroups` over the identity of `T.quotient`.
* `TauCeti.GTree.isFreeGroup_of_stabilizer_eq_bot`: a group acting freely without inversions on a
  tree is a free group.

## References

* J.-P. Serre, *Trees*, Chapter I, §3.3, Theorem 4, and §5.4, Theorem 13.
* I. Kapovich, R. Weidmann and A. Myasnikov, *Foldings, graphs of groups and the membership
  problem*, Internat. J. Algebra Comput. 15 (2005), §2, Proposition 2.6 and Remark 2.7.
-/

public section

universe u v w

namespace TauCeti

open SerreGraph _root_.MulAction

namespace GTree

variable {G : Type w} [Group G] {T : GTree.{u, v} G}

namespace Lifting

section Basic

variable (D : T.Lifting)

/-! ### The quotient graph of groups -/

open scoped Classical in
/-- Auxiliary element conjugating the stabilizer of `D.dart (GeomEdge.out B (B.toGeomEdge y))` onto
`stabilizer G (D.dart (B.rev y))`: `(D.twist y)⁻¹` on the chosen representative `GeomEdge.out`, and
`1` on its reverse. -/
private noncomputable def edgeTwist (y : T.quotient.E) : G :=
  if GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = y then (D.twist y)⁻¹ else 1

private theorem edgeTwist_of_out_eq {y : T.quotient.E}
    (h : GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = y) :
    D.edgeTwist y = (D.twist y)⁻¹ := by
  simp [edgeTwist, h]

private theorem edgeTwist_of_out_eq_rev {y : T.quotient.E}
    (h : GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = T.quotient.rev y) :
    D.edgeTwist y = 1 := by
  simp [edgeTwist, h, T.quotient.rev_ne y]

private theorem edgeTwist_rev (y : T.quotient.E) :
    D.edgeTwist (T.quotient.rev y) = D.twist y * D.edgeTwist y := by
  rcases GeomEdge.out_toGeomEdge_eq_or_eq_rev T.quotient y with h | h <;>
    simp [edgeTwist, h, T.quotient.rev_ne y, (T.quotient.rev_ne y).symm]

private theorem edgeTwist_of_mem {y : T.quotient.E} (hy : y ∈ D.tree.darts) :
    D.edgeTwist y = 1 := by
  simp [edgeTwist, hy]

private theorem stabilizer_dart_rev_eq_map_edgeTwist (y : T.quotient.E) :
    stabilizer G (D.dart (T.quotient.rev y)) =
      (stabilizer G (D.dart (GeomEdge.out T.quotient (T.quotient.toGeomEdge y)))).map
        (MulAut.conj (D.edgeTwist y)).toMonoidHom := by
  rcases GeomEdge.out_toGeomEdge_eq_or_eq_rev T.quotient y with h | h
  · rw [D.edgeTwist_of_out_eq h, h, D.stabilizer_dart_rev]
  · rw [D.edgeTwist_of_out_eq_rev h, h, map_one]
    exact (Subgroup.map_id _).symm

/-- The boundary monomorphism `ω_y` of the quotient graph of groups at a dart `y`: conjugation by
`(D.twist y)⁻¹` when `y` is the chosen representative `GeomEdge.out` of its geometric edge, and the
subgroup inclusion otherwise, into `stabilizer G (D.vertex (B.tgt y))`. -/
noncomputable def edgeGroupHom (y : T.quotient.E) :
    stabilizer G (D.dart (GeomEdge.out T.quotient (T.quotient.toGeomEdge y))) →*
      stabilizer G (D.vertex (T.quotient.tgt y)) :=
  (Subgroup.inclusion (D.stabilizer_dart_rev_le_stabilizer_vertex y)).comp
    (((MulAut.conj (D.edgeTwist y)).subgroupMap _).trans
      (MulEquiv.subgroupCongr (D.stabilizer_dart_rev_eq_map_edgeTwist y).symm)).toMonoidHom

/-- The boundary monomorphism `edgeGroupHom y` is injective. -/
theorem edgeGroupHom_injective (y : T.quotient.E) :
    Function.Injective (D.edgeGroupHom y) := by
  rw [edgeGroupHom, MonoidHom.coe_comp]
  exact (Subgroup.inclusion_injective (D.stabilizer_dart_rev_le_stabilizer_vertex y)).comp
    (MulEquiv.injective _)

/-- The quotient graph of groups over `T.quotient` associated to a lifting `D`: the vertex group at
`b` is `stabilizer G (D.vertex b)`, the edge group at a geometric edge `z` is
`stabilizer G (D.dart (GeomEdge.out T.quotient z))`, and the boundary monomorphism `ω_y` is
`D.edgeGroupHom y`. -/
@[expose] noncomputable def graphOfGroups :
    GraphOfGroups.{u, v, w, w} T.quotient where
  vertexGroup b := stabilizer G (D.vertex b)
  edgeGroup z := stabilizer G (D.dart (GeomEdge.out T.quotient z))
  ω := D.edgeGroupHom
  ω_injective := D.edgeGroupHom_injective

/-- The canonical inclusion of the vertex group `D.graphOfGroups.vertexGroup b` into `G`. -/
def vertexGroupSubtype (b : T.quotient.V) : D.graphOfGroups.vertexGroup b →* G :=
  (stabilizer G (D.vertex b)).subtype

/-- The canonical inclusion of the edge group `D.graphOfGroups.edgeGroup z` into `G`. -/
noncomputable def edgeGroupSubtype (z : T.quotient.GeomEdge) : D.graphOfGroups.edgeGroup z →* G :=
  (stabilizer G (D.dart (GeomEdge.out T.quotient z))).subtype

instance instCoeOutVertexGroup (b : T.quotient.V) : CoeOut (D.graphOfGroups.vertexGroup b) G :=
  ⟨D.vertexGroupSubtype b⟩

noncomputable instance instCoeOutEdgeGroup (z : T.quotient.GeomEdge) :
    CoeOut (D.graphOfGroups.edgeGroup z) G :=
  ⟨D.edgeGroupSubtype z⟩

@[simp] theorem range_vertexGroupSubtype (b : T.quotient.V) :
    (D.vertexGroupSubtype b).range = stabilizer G (D.vertex b) :=
  Subgroup.range_subtype _

@[simp] theorem range_edgeGroupSubtype (z : T.quotient.GeomEdge) :
    (D.edgeGroupSubtype z).range = stabilizer G (D.dart (GeomEdge.out T.quotient z)) :=
  Subgroup.range_subtype _

theorem vertexGroupSubtype_injective (b : T.quotient.V) :
    Function.Injective (D.vertexGroupSubtype b) :=
  Subgroup.subtype_injective _

theorem edgeGroupSubtype_injective (z : T.quotient.GeomEdge) :
    Function.Injective (D.edgeGroupSubtype z) :=
  Subgroup.subtype_injective _

private theorem coe_vertexGroup_cast {b₁ b₂ : T.quotient.V} (h : b₁ = b₂)
    (x : D.graphOfGroups.vertexGroup b₁) :
    ((MulEquiv.cast (M := D.graphOfGroups.vertexGroup) h x :
      D.graphOfGroups.vertexGroup b₂) : G) = x := by
  subst h; rfl

private theorem coe_edgeGroup_cast {z₁ z₂ : T.quotient.GeomEdge} (h : z₁ = z₂)
    (x : D.graphOfGroups.edgeGroup z₁) :
    ((MulEquiv.cast (M := D.graphOfGroups.edgeGroup) h x :
      D.graphOfGroups.edgeGroup z₂) : G) = x := by
  subst h; rfl

theorem graphOfGroups_vertexGroup (b : T.quotient.V) :
    D.graphOfGroups.vertexGroup b = stabilizer G (D.vertex b) := (rfl)

theorem graphOfGroups_edgeGroup (z : T.quotient.GeomEdge) :
    D.graphOfGroups.edgeGroup z = stabilizer G (D.dart (GeomEdge.out T.quotient z)) := (rfl)

theorem graphOfGroups_ω (y : T.quotient.E) :
    D.graphOfGroups.ω y = D.edgeGroupHom y := (rfl)

private theorem coe_ω_eq_conj_edgeTwist (y : T.quotient.E)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (D.graphOfGroups.ω y c : G) = MulAut.conj (D.edgeTwist y) (c : G) := rfl

private theorem coe_α_eq_conj_edgeTwist_rev (y : T.quotient.E)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (D.graphOfGroups.α y c : G) = MulAut.conj (D.edgeTwist (T.quotient.rev y)) (c : G) := by
  rw [GraphOfGroups.α_apply, coe_vertexGroup_cast, coe_ω_eq_conj_edgeTwist, coe_edgeGroup_cast]

/-- On the chosen dart `GeomEdge.out` of a geometric edge, `ω_y` conjugates by `(D.twist y)⁻¹`. -/
theorem coe_ω_of_out_eq {y : T.quotient.E}
    (h : GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = y)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (D.graphOfGroups.ω y c : G) = (D.twist y)⁻¹ * (c : G) * D.twist y := by
  rw [coe_ω_eq_conj_edgeTwist, D.edgeTwist_of_out_eq h, MulAut.conj_apply, inv_inv]

/-- On the dart opposite to `GeomEdge.out`, `ω_y` is the plain subgroup inclusion in `G`. -/
theorem coe_ω_of_out_eq_rev {y : T.quotient.E}
    (h : GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = T.quotient.rev y)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (D.graphOfGroups.ω y c : G) = c := by
  rw [coe_ω_eq_conj_edgeTwist, D.edgeTwist_of_out_eq_rev h, MulAut.conj_apply]
  simp

/-- On the chosen dart `GeomEdge.out` of a geometric edge, `α_y` is the plain subgroup inclusion in
`G`. -/
theorem coe_α_of_out_eq {y : T.quotient.E}
    (h : GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = y)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (D.graphOfGroups.α y c : G) = c := by
  rw [coe_α_eq_conj_edgeTwist_rev, D.edgeTwist_rev, D.edgeTwist_of_out_eq h, mul_inv_cancel,
    MulAut.conj_apply]
  simp

/-- On the dart opposite to `GeomEdge.out`, `α_y` conjugates by `D.twist y`. -/
theorem coe_α_of_out_eq_rev {y : T.quotient.E}
    (h : GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = T.quotient.rev y)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (D.graphOfGroups.α y c : G) = D.twist y * (c : G) * (D.twist y)⁻¹ := by
  rw [coe_α_eq_conj_edgeTwist_rev, D.edgeTwist_rev, D.edgeTwist_of_out_eq_rev h, mul_one,
    MulAut.conj_apply]

/-- On a dart of the spanning tree, `ω_y` is the plain subgroup inclusion in `G`. -/
@[simp] theorem coe_ω_of_mem {y : T.quotient.E} (hy : y ∈ D.tree.darts)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (D.graphOfGroups.ω y c : G) = c := by
  rw [coe_ω_eq_conj_edgeTwist, D.edgeTwist_of_mem hy, MulAut.conj_apply]
  simp

/-- On a dart of the spanning tree, `α_y` is the plain subgroup inclusion in `G`. -/
@[simp] theorem coe_α_of_mem {y : T.quotient.E} (hy : y ∈ D.tree.darts)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (D.graphOfGroups.α y c : G) = c := by
  rw [coe_α_eq_conj_edgeTwist_rev, D.edgeTwist_of_mem (D.tree.rev_mem y hy), MulAut.conj_apply]
  simp

/-- Every dart `y` and edge element `c` satisfy the Bass–Serre relation
`D.twist y * ω_y(c) * (D.twist y)⁻¹ = α_y(c)` in `G`. -/
theorem twist_mul_coe_ω_mul_twist_inv (y : T.quotient.E)
    (c : D.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    D.twist y * (D.graphOfGroups.ω y c : G) * (D.twist y)⁻¹ =
      (D.graphOfGroups.α y c : G) := by
  rw [coe_ω_eq_conj_edgeTwist, coe_α_eq_conj_edgeTwist_rev, D.edgeTwist_rev,
    MulAut.conj_apply, MulAut.conj_apply]
  group

/-- An element of the vertex stabilizer at the target of `y` lies in the image of `ω_y` precisely
when it fixes the lifted reverse dart `D.dart (rev y)`. -/
theorem mem_range_ω_iff {y : T.quotient.E}
    {g : D.graphOfGroups.vertexGroup (T.quotient.tgt y)} :
    g ∈ (D.graphOfGroups.ω y).range ↔ (g : G) ∈ stabilizer G (D.dart (T.quotient.rev y)) := by
  rw [D.stabilizer_dart_rev_eq_map_edgeTwist y, Subgroup.mem_map]
  refine ⟨fun ⟨c, hc⟩ => ?_, fun ⟨x, hx, hgx⟩ => ?_⟩
  · subst hc
    exact ⟨c, c.2, (coe_ω_eq_conj_edgeTwist D y c).symm⟩
  · exact ⟨⟨x, hx⟩, Subtype.ext ((coe_ω_eq_conj_edgeTwist D y ⟨x, hx⟩).trans hgx)⟩

/-- For an arrow `e : a ⟶ b` of `T.quotient`, an element of the vertex group at `b` lies in the
image of `ωArrow e` precisely when it fixes `D.dart (rev e.1)`. -/
theorem mem_range_ωArrow_iff {a b : T.quotient.V} {e : a ⟶ b}
    {g : D.graphOfGroups.vertexGroup b} :
    g ∈ (D.graphOfGroups.ωArrow e).range ↔
      (g : G) ∈ stabilizer G (D.dart (T.quotient.rev e.1)) := by
  obtain ⟨y, rfl, rfl⟩ := e
  simpa using D.mem_range_ω_iff

/-- For an arrow `e : a ⟶ b` of `T.quotient`, an element of the vertex group at `a` lies in the
image of `αArrow e` precisely when it fixes `D.dart e.1`. -/
theorem mem_range_αArrow_iff {a b : T.quotient.V} {e : a ⟶ b}
    {g : D.graphOfGroups.vertexGroup a} :
    g ∈ (D.graphOfGroups.αArrow e).range ↔ (g : G) ∈ stabilizer G (D.dart e.1) := by
  rw [← D.graphOfGroups.range_ωArrow_reverse, D.mem_range_ωArrow_iff, T.quotient.reverse_val,
    T.quotient.rev_rev]

/-- An element of the vertex stabilizer at the source of `y` lies in the image of `α_y` precisely
when it fixes the lifted dart `D.dart y`. -/
theorem mem_range_α_iff {y : T.quotient.E}
    {g : D.graphOfGroups.vertexGroup (T.quotient.src y)} :
    g ∈ (D.graphOfGroups.α y).range ↔ (g : G) ∈ stabilizer G (D.dart y) := by
  simpa using D.mem_range_αArrow_iff (e := T.quotient.dart y) (g := g)

/-! ### The homomorphism from the fundamental group to `G` -/

/-- The canonical homomorphism from `π₁(D.graphOfGroups, D.tree)` to `G`, sending each vertex group
`stabilizer G (D.vertex b)` by subgroup inclusion and each dart `y` to `D.twist y`. -/
noncomputable def π₁TreeToGroup :
    GraphOfGroups.π₁Tree D.graphOfGroups D.tree.darts →* G :=
  GraphOfGroups.π₁Tree.lift D.vertexGroupSubtype D.twist D.twist_eq_one D.twist_rev
    D.twist_mul_coe_ω_mul_twist_inv

@[simp] theorem π₁TreeToGroup_of (b : T.quotient.V) (g : D.graphOfGroups.vertexGroup b) :
    D.π₁TreeToGroup (GraphOfGroups.π₁Tree.of D.tree.darts b g) = g :=
  GraphOfGroups.π₁Tree.lift_of ..

@[simp] theorem π₁TreeToGroup_comp_of (b : T.quotient.V) :
    D.π₁TreeToGroup.comp (GraphOfGroups.π₁Tree.of D.tree.darts b) = D.vertexGroupSubtype b :=
  GraphOfGroups.π₁Tree.lift_comp_of ..

@[simp] theorem π₁TreeToGroup_edge (y : T.quotient.E) :
    D.π₁TreeToGroup (GraphOfGroups.π₁Tree.edge D.tree.darts y) = D.twist y :=
  GraphOfGroups.π₁Tree.lift_edge ..

/-- `D.π₁TreeToGroup` is surjective. -/
theorem π₁TreeToGroup_surjective : Function.Surjective D.π₁TreeToGroup := by
  rw [← MonoidHom.range_eq_top, π₁TreeToGroup, GraphOfGroups.π₁Tree.range_lift]
  simpa using D.iSup_stabilizer_sup_closure_range_twist

/-! ### Lifting alternating paths and injectivity -/

/-- Evaluation of an alternating path of `D.graphOfGroups` in `G`. -/
private noncomputable def evalAlt {a : T.quotient.V} :
    ∀ {b : T.quotient.V}, D.graphOfGroups.AlternatingPath a b → G
  | _, .single g => g
  | _, .cons p e g => evalAlt p * D.twist e.1 * g

private theorem π₁TreeToGroup_toπ₁Tree_toPath {a b : T.quotient.V}
    (p : D.graphOfGroups.AlternatingPath a b) :
    D.π₁TreeToGroup (p.toPath.toπ₁Tree D.tree.darts) = D.evalAlt p := by
  induction p with
  | single g => simp [evalAlt]
  | cons p e g ih => simp [evalAlt, ih, mul_assoc]

/-- Endpoint of the lifted path in `T` of an alternating path starting at `a`, defined so that the
length-zero path ends definitionally at `D.vertex a`. -/
private noncomputable def endVertex {a : T.quotient.V} :
    ∀ {b : T.quotient.V}, D.graphOfGroups.AlternatingPath a b → T.V
  | _, .single _ => D.vertex a
  | b, .cons p e _ => (D.evalAlt p * D.twist e.1) • D.vertex b

private theorem endVertex_eq {a : T.quotient.V} :
    ∀ {b : T.quotient.V} (p : D.graphOfGroups.AlternatingPath a b),
      D.endVertex p = D.evalAlt p • D.vertex b
  | _, .single g => (mem_stabilizer_iff.mp g.2).symm
  | _, .cons p e g => by
    simp only [endVertex, evalAlt]
    rw [mul_smul (D.evalAlt p * D.twist e.1)]
    exact congrArg ((D.evalAlt p * D.twist e.1) • ·) (mem_stabilizer_iff.mp g.2).symm

/-- The edge path in `T` traced by an alternating path `g₀, e₁, g₁, …, e_k, g_k` of
`D.graphOfGroups` starting at `D.vertex a`: the `i`-th dart is the translate of `D.dart e_i` by the
product of the preceding prefix. -/
private noncomputable def liftAlt {a : T.quotient.V} :
    ∀ {b : T.quotient.V} (p : D.graphOfGroups.AlternatingPath a b),
      T.Path (D.vertex a) (D.endVertex p)
  | _, .single _ => Quiver.Path.nil
  | _, .cons p e _ =>
    (liftAlt p).cons ⟨D.evalAlt p • D.dart e.1,
      by rw [src_smul, D.src_dart, e.2.1, D.endVertex_eq],
      by rw [tgt_smul, D.tgt_dart, e.2.2, ← mul_smul]; rfl⟩

/-- Two consecutive lifted darts backtrack in `T` precisely when the alternating path has a
Bass–Serre cancellation `e₁, g₁, e₂` with `e₁ = rev e₂` and `g₁ ∈ range (αArrow e₂)`. -/
private theorem smul_dart_eq_rev_iff_cancels {a b c d : T.quotient.V}
    (p : D.graphOfGroups.AlternatingPath a b) (e₁ : b ⟶ c)
    (g₁ : D.graphOfGroups.vertexGroup c) (e₂ : c ⟶ d) :
    D.evalAlt (.cons p e₁ g₁) • D.dart e₂.1 = T.rev (D.evalAlt p • D.dart e₁.1) ↔
      (GraphOfGroups.AlternatingPath.cons p e₁ g₁).Cancels e₂ := by
  rw [GraphOfGroups.AlternatingPath.cancels_cons_iff, D.mem_range_αArrow_iff, mem_stabilizer_iff,
    rev_smul, evalAlt, mul_assoc, mul_smul, smul_left_cancel_iff]
  refine ⟨fun h => ?_, fun ⟨he, hg⟩ => ?_⟩
  · have hq : e₂.1 = T.quotient.rev e₁.1 := by
      simpa using congrArg T.quotientMap.mapE h
    have he₁ : e₁.1 = T.quotient.rev e₂.1 := by
      rw [hq, T.quotient.rev_rev]
    refine ⟨he₁, ?_⟩
    rw [hq, ← D.twist_smul_dart_rev e₁.1, mul_smul, smul_left_cancel_iff] at h
    rwa [← hq] at h
  · rw [he, mul_smul, hg, ← D.twist_smul_dart_rev (T.quotient.rev e₂.1), T.quotient.rev_rev]

/-- An alternating path of `D.graphOfGroups` is reduced in the Bass–Serre sense if and only if its
lifted path in the tree `T` is reduced. -/
private theorem isReduced_liftAlt_iff {a b : T.quotient.V}
    (p : D.graphOfGroups.AlternatingPath a b) :
    Path.IsReduced T.toSerreGraph (D.liftAlt p) ↔ p.IsReduced := by
  induction p with
  | single g =>
    rw [liftAlt]
    exact iff_of_true (Path.isReduced_nil T.toSerreGraph _)
      (GraphOfGroups.AlternatingPath.isReduced_single g)
  | cons p e₂ g₂ ih =>
    cases p with
    | single g₀ =>
      rw [liftAlt, liftAlt]
      exact iff_of_true (Path.isReduced_toPath T.toSerreGraph _)
        (by simp [GraphOfGroups.AlternatingPath.isReduced_cons_iff])
    | cons p₀ e₁ g₁ =>
      rw [liftAlt, liftAlt, Path.isReduced_cons_cons, ← liftAlt, ih]
      simp only [ne_eq, D.smul_dart_eq_rev_iff_cancels p₀ e₁ g₁ e₂,
        GraphOfGroups.AlternatingPath.isReduced_cons_iff]

/-- `D.π₁TreeToGroup` is injective: any closed normal word in the kernel traces a reduced closed
path in the tree `T`, hence has length zero and trivial vertex element. -/
theorem π₁TreeToGroup_injective : Function.Injective D.π₁TreeToGroup := by
  let b₀ : T.quotient.V := T.quotientMap.mapV (Classical.arbitrary T.V)
  suffices hφ : Function.Injective
      (D.π₁TreeToGroup.comp (GraphOfGroups.π₁Equiv D.graphOfGroups b₀ D.tree).toMonoidHom) by
    intro x y hxy
    obtain ⟨x', rfl⟩ := (GraphOfGroups.π₁Equiv D.graphOfGroups b₀ D.tree).surjective x
    obtain ⟨y', rfl⟩ := (GraphOfGroups.π₁Equiv D.graphOfGroups b₀ D.tree).surjective y
    exact congrArg _ (hφ hxy)
  rw [injective_iff_map_eq_one]
  intro x hx
  let d : D.graphOfGroups.Transversal := default
  let w := GraphOfGroups.π₁.normalWordEquiv d b₀ x
  have hx_mk : x = GraphOfGroups.π₁.mk w.toPath := by
    rw [← GraphOfGroups.π₁.normalWordEquiv_symm_apply d b₀ w, Equiv.symm_apply_apply]
  have heval : D.evalAlt w.toAlternatingPath = 1 := by
    rw [hx_mk, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, GraphOfGroups.π₁Equiv_mk,
      GraphOfGroups.NormalWord.toPath_def, D.π₁TreeToGroup_toπ₁Tree_toPath] at hx
    exact hx
  apply (GraphOfGroups.π₁.normalWordEquiv d b₀).injective
  rw [GraphOfGroups.π₁.normalWordEquiv_one]
  apply GraphOfGroups.NormalWord.ext
  rw [GraphOfGroups.NormalWord.toAlternatingPath_empty]
  rcases hw : w.toAlternatingPath with ⟨g₀⟩ | ⟨p, e, g⟩
  · rw [hw, evalAlt] at heval
    exact congrArg GraphOfGroups.AlternatingPath.single (Subtype.ext heval)
  · exfalso
    have hred : Path.IsReduced T.toSerreGraph (D.liftAlt w.toAlternatingPath) :=
      (D.isReduced_liftAlt_iff w.toAlternatingPath).mpr w.isReduced
    have hend : D.endVertex w.toAlternatingPath = D.vertex b₀ := by
      rw [D.endVertex_eq, heval, one_smul]
    have hlen : (D.liftAlt w.toAlternatingPath).length ≠ 0 := by
      rw [hw, liftAlt, Quiver.Path.length_cons]
      exact Nat.succ_ne_zero _
    have hclosed : ∀ (v : T.V) (_ : v = D.vertex b₀) (q : T.Path (D.vertex b₀) v),
        Path.IsReduced T.toSerreGraph q → q.length = 0 := by
      rintro _ rfl q hq
      rw [T.isTree.eq_nil_of_isReduced _ q hq]
      rfl
    exact hlen (hclosed _ hend (D.liftAlt w.toAlternatingPath) hred)

/-- `D.π₁TreeToGroup` is bijective. -/
theorem π₁TreeToGroup_bijective : Function.Bijective D.π₁TreeToGroup :=
  ⟨D.π₁TreeToGroup_injective, D.π₁TreeToGroup_surjective⟩

/-! ### The structure theorem isomorphisms -/

/-- **Structure theorem (spanning-tree presentation).** For any lifting `D` of a `G`-tree `T`,
the fundamental group `π₁(D.graphOfGroups, D.tree)` of the quotient graph of groups is canonically
isomorphic to `G`. -/
noncomputable def π₁TreeEquiv :
    GraphOfGroups.π₁Tree D.graphOfGroups D.tree.darts ≃* G :=
  MulEquiv.ofBijective D.π₁TreeToGroup D.π₁TreeToGroup_bijective

@[simp] theorem coe_π₁TreeEquiv :
    (D.π₁TreeEquiv : GraphOfGroups.π₁Tree D.graphOfGroups D.tree.darts →* G) = D.π₁TreeToGroup :=
  (rfl)

theorem π₁TreeEquiv_apply (x : GraphOfGroups.π₁Tree D.graphOfGroups D.tree.darts) :
    D.π₁TreeEquiv x = D.π₁TreeToGroup x :=
  (rfl)

@[simp] theorem π₁TreeEquiv_of (b : T.quotient.V) (g : D.graphOfGroups.vertexGroup b) :
    D.π₁TreeEquiv (GraphOfGroups.π₁Tree.of D.tree.darts b g) = g :=
  D.π₁TreeToGroup_of b g

@[simp] theorem π₁TreeEquiv_edge (y : T.quotient.E) :
    D.π₁TreeEquiv (GraphOfGroups.π₁Tree.edge D.tree.darts y) = D.twist y :=
  D.π₁TreeToGroup_edge y

@[simp] theorem π₁TreeEquiv_symm_coe_vertex (b : T.quotient.V)
    (g : D.graphOfGroups.vertexGroup b) :
    D.π₁TreeEquiv.symm (g : G) = GraphOfGroups.π₁Tree.of D.tree.darts b g :=
  D.π₁TreeEquiv.symm_apply_eq.mpr (D.π₁TreeEquiv_of b g).symm

@[simp] theorem π₁TreeEquiv_symm_twist (y : T.quotient.E) :
    D.π₁TreeEquiv.symm (D.twist y) = GraphOfGroups.π₁Tree.edge D.tree.darts y :=
  D.π₁TreeEquiv.symm_apply_eq.mpr (D.π₁TreeEquiv_edge y).symm

/-- Each vertex group `stabilizer G (D.vertex b)` embeds into `π₁(D.graphOfGroups, D.tree)`, and
`D.π₁TreeToGroup` carries its image onto `stabilizer G (D.vertex b)`. -/
@[simp] theorem map_π₁TreeToGroup_range_of (b : T.quotient.V) :
    (GraphOfGroups.π₁Tree.of (𝔸 := D.graphOfGroups) D.tree.darts b).range.map D.π₁TreeToGroup =
      stabilizer G (D.vertex b) := by
  rw [← MonoidHom.range_comp, π₁TreeToGroup_comp_of, range_vertexGroupSubtype]

/-- **Structure theorem (path fundamental group).** For any lifting `D` of a `G`-tree `T` and any
base vertex `b₀` of `T.quotient`, the fundamental group `π₁(D.graphOfGroups, b₀)` of closed paths
is isomorphic to `G`. -/
noncomputable def π₁Equiv (b₀ : T.quotient.V) :
    GraphOfGroups.π₁ D.graphOfGroups b₀ ≃* G :=
  (GraphOfGroups.π₁Equiv D.graphOfGroups b₀ D.tree).trans D.π₁TreeEquiv

theorem π₁Equiv_apply (b₀ : T.quotient.V) (x : GraphOfGroups.π₁ D.graphOfGroups b₀) :
    D.π₁Equiv b₀ x =
      D.π₁TreeToGroup (GraphOfGroups.π₁.toπ₁Tree D.graphOfGroups b₀ D.tree.darts x) := by
  rw [π₁Equiv, MulEquiv.trans_apply, GraphOfGroups.π₁Equiv_apply, π₁TreeEquiv_apply]

@[simp] theorem π₁Equiv_mk (b₀ : T.quotient.V) (p : D.graphOfGroups.Path ⟨b₀⟩ ⟨b₀⟩) :
    D.π₁Equiv b₀ (GraphOfGroups.π₁.mk p) = D.π₁TreeToGroup (p.toπ₁Tree D.tree.darts) := by
  rw [π₁Equiv_apply, GraphOfGroups.π₁.toπ₁Tree_mk]

@[simp] theorem π₁Equiv_vertexHom_mapPath_path (b₀ b : T.quotient.V)
    (g : D.graphOfGroups.vertexGroup b) :
    D.π₁Equiv b₀
        (GraphOfGroups.π₁.vertexHom
          ((GraphOfGroups.dartPrefunctor D.graphOfGroups).mapPath (D.tree.path b₀ b)) g) = g := by
  simp [π₁Equiv]

@[simp] theorem π₁Equiv_ofPathGroup_loop (b₀ : T.quotient.V) (y : T.quotient.E) :
    D.π₁Equiv b₀ (GraphOfGroups.π₁.ofPathGroup D.graphOfGroups b₀ (D.tree.loop b₀ y)) =
      D.twist y := by
  simp [π₁Equiv]

end Basic

/-! ### Independence of the lifting -/

section HomOfOrbits

variable (D₁ D₂ : T.Lifting)

private theorem orbit_twist_mem_stabilizer {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (y : T.quotient.E) :
    u (T.quotient.src y) * D₁.edgeTwist (T.quotient.rev y) *
        (v (T.quotient.toGeomEdge y))⁻¹ * (D₂.edgeTwist (T.quotient.rev y))⁻¹ ∈
      stabilizer G (D₂.vertex (T.quotient.src y)) := by
  rw [mem_stabilizer_iff]
  have hv' : (v (T.quotient.toGeomEdge y))⁻¹ •
      D₂.dart (GeomEdge.out T.quotient (T.quotient.toGeomEdge y)) =
        D₁.dart (GeomEdge.out T.quotient (T.quotient.toGeomEdge y)) :=
    inv_smul_eq_iff.mpr (hv _)
  rcases GeomEdge.out_toGeomEdge_eq_or_eq_rev T.quotient y with h | h
  · have h₁ : D₁.edgeTwist (T.quotient.rev y) = 1 :=
      D₁.edgeTwist_of_out_eq_rev (y := T.quotient.rev y) (by simpa using h)
    have h₂ : D₂.edgeTwist (T.quotient.rev y) = 1 :=
      D₂.edgeTwist_of_out_eq_rev (y := T.quotient.rev y) (by simpa using h)
    rw [h₁, h₂, mul_one, inv_one, mul_one, mul_smul]
    have hsrc : (v (T.quotient.toGeomEdge y))⁻¹ • D₂.vertex (T.quotient.src y) =
        D₁.vertex (T.quotient.src y) := by
      have := congrArg T.src hv'
      rwa [src_smul, h, D₂.src_dart, D₁.src_dart] at this
    rw [hsrc, ← hu]
  · have h₁ : D₁.edgeTwist (T.quotient.rev y) = D₁.twist y := by
      simpa [D₁.twist_rev] using D₁.edgeTwist_of_out_eq (y := T.quotient.rev y) (by simpa using h)
    have h₂ : D₂.edgeTwist (T.quotient.rev y) = D₂.twist y := by
      simpa [D₂.twist_rev] using D₂.edgeTwist_of_out_eq (y := T.quotient.rev y) (by simpa using h)
    rw [h₁, h₂]
    have htgt₂ : (D₂.twist y)⁻¹ • D₂.vertex (T.quotient.src y) =
        T.tgt (D₂.dart (GeomEdge.out T.quotient (T.quotient.toGeomEdge y))) := by
      rw [h, D₂.tgt_dart, T.quotient.tgt_rev, D₂.twist_rev]
    have htgt₁ : D₁.twist y •
        T.tgt (D₁.dart (GeomEdge.out T.quotient (T.quotient.toGeomEdge y))) =
          D₁.vertex (T.quotient.src y) := by
      rw [h, D₁.tgt_dart, T.quotient.tgt_rev, D₁.twist_rev, smul_inv_smul]
    calc (u (T.quotient.src y) * D₁.twist y * (v (T.quotient.toGeomEdge y))⁻¹ * (D₂.twist y)⁻¹) •
          D₂.vertex (T.quotient.src y)
        = u (T.quotient.src y) • D₁.twist y • (v (T.quotient.toGeomEdge y))⁻¹ •
            ((D₂.twist y)⁻¹ • D₂.vertex (T.quotient.src y)) := by
          simp only [mul_smul]
      _ = u (T.quotient.src y) • D₁.twist y •
            T.tgt ((v (T.quotient.toGeomEdge y))⁻¹ •
              D₂.dart (GeomEdge.out T.quotient (T.quotient.toGeomEdge y))) := by
          rw [htgt₂, tgt_smul]
      _ = u (T.quotient.src y) • D₁.vertex (T.quotient.src y) := by rw [hv', htgt₁]
      _ = D₂.vertex (T.quotient.src y) := (hu _).symm

/-- The twisting element of `homOfOrbits` at a dart `y`, lying in the lifted vertex stabilizer at
`src y`. -/
private noncomputable def orbitTwist {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (y : T.quotient.E) : D₂.graphOfGroups.vertexGroup (T.quotient.src y) :=
  ⟨u (T.quotient.src y) * D₁.edgeTwist (T.quotient.rev y) *
      (v (T.quotient.toGeomEdge y))⁻¹ * (D₂.edgeTwist (T.quotient.rev y))⁻¹,
    orbit_twist_mem_stabilizer D₁ D₂ hu hv y⟩

private theorem coe_orbitTwist {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (y : T.quotient.E) :
    (orbitTwist D₁ D₂ hu hv y : G) =
      u (T.quotient.src y) * D₁.edgeTwist (T.quotient.rev y) *
        (v (T.quotient.toGeomEdge y))⁻¹ * (D₂.edgeTwist (T.quotient.rev y))⁻¹ := rfl

private theorem coe_vertexGroup_stabilizerEquivStabilizer {b : T.quotient.V} {u : G}
    (hu : D₂.vertex b = u • D₁.vertex b) (a : D₁.graphOfGroups.vertexGroup b) :
    D₂.vertexGroupSubtype b ((stabilizerEquivStabilizer hu).toMonoidHom a) =
      MulAut.conj u (a : G) :=
  stabilizerEquivStabilizer_apply hu a

private theorem coe_edgeGroup_stabilizerEquivStabilizer {z : T.quotient.GeomEdge} {v : G}
    (hv : D₂.dart (GeomEdge.out T.quotient z) = v • D₁.dart (GeomEdge.out T.quotient z))
    (c : D₁.graphOfGroups.edgeGroup z) :
    D₂.edgeGroupSubtype z ((stabilizerEquivStabilizer hv).toMonoidHom c) =
      MulAut.conj v (c : G) :=
  stabilizerEquivStabilizer_apply hv c

private theorem orbitEdgeHom_rev {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (y : T.quotient.E) (c : D₁.graphOfGroups.edgeGroup (T.quotient.toGeomEdge (T.quotient.rev y))) :
    (stabilizerEquivStabilizer (hv (T.quotient.toGeomEdge (T.quotient.rev y)))).toMonoidHom c =
      MulEquiv.cast (M := D₂.graphOfGroups.edgeGroup) (T.quotient.toGeomEdge_rev y).symm
        ((stabilizerEquivStabilizer (hv (T.quotient.toGeomEdge y))).toMonoidHom
          (MulEquiv.cast (M := D₁.graphOfGroups.edgeGroup) (T.quotient.toGeomEdge_rev y) c)) :=
  let c' := MulEquiv.cast (M := D₁.graphOfGroups.edgeGroup) (T.quotient.toGeomEdge_rev y) c
  let x : D₂.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y) :=
    (stabilizerEquivStabilizer (hv (T.quotient.toGeomEdge y))).toMonoidHom c'
  D₂.edgeGroupSubtype_injective _ <|
    (coe_edgeGroup_stabilizerEquivStabilizer D₁ D₂
        (hv (T.quotient.toGeomEdge (T.quotient.rev y))) c).trans <|
      (congrArg (fun z => MulAut.conj (v z) (c : G)) (T.quotient.toGeomEdge_rev y)).trans <|
        (congrArg (MulAut.conj (v (T.quotient.toGeomEdge y)))
          (coe_edgeGroup_cast D₁ _ c).symm).trans <|
          (coe_edgeGroup_stabilizerEquivStabilizer D₁ D₂
              (hv (T.quotient.toGeomEdge y)) c').symm.trans
            (coe_edgeGroup_cast D₂ (T.quotient.toGeomEdge_rev y).symm x).symm

private theorem orbitVertexHom_α {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (y : T.quotient.E) (c : D₁.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    (stabilizerEquivStabilizer (hu (T.quotient.src y))).toMonoidHom (D₁.graphOfGroups.α y c) =
      orbitTwist D₁ D₂ hu hv y *
        MulEquiv.cast (M := D₂.graphOfGroups.vertexGroup) rfl
          (D₂.graphOfGroups.α y
            ((stabilizerEquivStabilizer (hv (T.quotient.toGeomEdge y))).toMonoidHom c)) *
        (orbitTwist D₁ D₂ hu hv y)⁻¹ :=
  let c' : D₂.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y) :=
    (stabilizerEquivStabilizer (hv (T.quotient.toGeomEdge y))).toMonoidHom c
  D₂.vertexGroupSubtype_injective _ <| calc
    D₂.vertexGroupSubtype (T.quotient.src y)
        ((stabilizerEquivStabilizer (hu (T.quotient.src y))).toMonoidHom (D₁.graphOfGroups.α y c))
        = MulAut.conj (u (T.quotient.src y))
            (MulAut.conj (D₁.edgeTwist (T.quotient.rev y)) (c : G)) :=
      (coe_vertexGroup_stabilizerEquivStabilizer D₁ D₂ (hu (T.quotient.src y)) _).trans
        (congrArg _ (coe_α_eq_conj_edgeTwist_rev D₁ y c))
    _ = (orbitTwist D₁ D₂ hu hv y : G) *
          MulAut.conj (D₂.edgeTwist (T.quotient.rev y))
            (MulAut.conj (v (T.quotient.toGeomEdge y)) (c : G)) *
          (orbitTwist D₁ D₂ hu hv y : G)⁻¹ := by
      simp only [coe_orbitTwist, MulAut.conj_apply]
      group
    _ = (orbitTwist D₁ D₂ hu hv y : G) *
          (MulEquiv.cast (M := D₂.graphOfGroups.vertexGroup) rfl (D₂.graphOfGroups.α y c') : G) *
          (orbitTwist D₁ D₂ hu hv y : G)⁻¹ :=
      congrArg (fun g : G => (orbitTwist D₁ D₂ hu hv y : G) * g * (orbitTwist D₁ D₂ hu hv y : G)⁻¹)
        (((coe_vertexGroup_cast D₂ rfl (D₂.graphOfGroups.α y c')).trans
          (coe_α_eq_conj_edgeTwist_rev D₂ y c')).trans
            (congrArg _ (coe_edgeGroup_stabilizerEquivStabilizer D₁ D₂
              (hv (T.quotient.toGeomEdge y)) c))).symm
    _ = _ := by simp only [c', map_mul, map_inv]

/-- The morphism of graphs of groups `D₁.graphOfGroups → D₂.graphOfGroups` over the identity of
`T.quotient` determined by elements `u b` carrying `D₁.vertex b` to `D₂.vertex b` and elements
`v z` carrying `D₁.dart (GeomEdge.out T.quotient z)` to `D₂.dart (GeomEdge.out T.quotient z)`. -/
noncomputable def homOfOrbits {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z)) :
    GraphOfGroups.Hom D₁.graphOfGroups D₂.graphOfGroups where
  graph := ⟨fun b => b, fun y => y, fun _ => rfl, fun _ => rfl⟩
  vertexHom b := (stabilizerEquivStabilizer (hu b)).toMonoidHom
  edgeHom y := (stabilizerEquivStabilizer (hv (T.quotient.toGeomEdge y))).toMonoidHom
  twist := orbitTwist D₁ D₂ hu hv
  edgeHom_rev := orbitEdgeHom_rev D₁ D₂ hv
  vertexHom_α := orbitVertexHom_α D₁ D₂ hu hv

/-- The underlying graph morphism of `homOfOrbits` is the identity of `T.quotient`. -/
@[simp] theorem homOfOrbits_graph {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z)) :
    (homOfOrbits D₁ D₂ hu hv).graph = SerreGraph.Hom.id T.quotient := by
  ext <;> simp [homOfOrbits]

@[simp] theorem coe_homOfOrbits_vertexHom {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (b : T.quotient.V) (a : D₁.graphOfGroups.vertexGroup b) :
    ((homOfOrbits D₁ D₂ hu hv).vertexHom b a : G) = MulAut.conj (u b) (a : G) :=
  coe_vertexGroup_stabilizerEquivStabilizer D₁ D₂ (hu b) a

@[simp] theorem coe_homOfOrbits_edgeHom {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (y : T.quotient.E) (c : D₁.graphOfGroups.edgeGroup (T.quotient.toGeomEdge y)) :
    ((homOfOrbits D₁ D₂ hu hv).edgeHom y c : G) =
      MulAut.conj (v (T.quotient.toGeomEdge y)) (c : G) :=
  coe_edgeGroup_stabilizerEquivStabilizer D₁ D₂ (hv (T.quotient.toGeomEdge y)) c

private theorem coe_homOfOrbits_twist {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (y : T.quotient.E) :
    ((homOfOrbits D₁ D₂ hu hv).twist y : G) =
      u (T.quotient.src y) * D₁.edgeTwist (T.quotient.rev y) *
        (v (T.quotient.toGeomEdge y))⁻¹ * (D₂.edgeTwist (T.quotient.rev y))⁻¹ :=
  coe_orbitTwist D₁ D₂ hu hv y

/-- On the chosen dart `GeomEdge.out` of a geometric edge, the twisting element of `homOfOrbits` is
`u (src y) * (v (toGeomEdge y))⁻¹`. -/
@[simp] theorem coe_homOfOrbits_twist_of_out_eq {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    {y : T.quotient.E} (h : GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = y) :
    ((homOfOrbits D₁ D₂ hu hv).twist y : G) =
      u (T.quotient.src y) * (v (T.quotient.toGeomEdge y))⁻¹ := by
  rw [coe_homOfOrbits_twist,
    D₁.edgeTwist_of_out_eq_rev (y := T.quotient.rev y) (by simpa using h),
    D₂.edgeTwist_of_out_eq_rev (y := T.quotient.rev y) (by simpa using h)]
  simp

/-- On the dart opposite to `GeomEdge.out`, the twisting element of `homOfOrbits` is
`u (src y) * D₁.twist y * (v (toGeomEdge y))⁻¹ * (D₂.twist y)⁻¹`. -/
@[simp] theorem coe_homOfOrbits_twist_of_out_eq_rev {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    {y : T.quotient.E}
    (h : GeomEdge.out T.quotient (T.quotient.toGeomEdge y) = T.quotient.rev y) :
    ((homOfOrbits D₁ D₂ hu hv).twist y : G) =
      u (T.quotient.src y) * D₁.twist y * (v (T.quotient.toGeomEdge y))⁻¹ * (D₂.twist y)⁻¹ := by
  have h₁ : D₁.edgeTwist (T.quotient.rev y) = D₁.twist y := by
    simpa [D₁.twist_rev] using D₁.edgeTwist_of_out_eq (y := T.quotient.rev y) (by simpa using h)
  have h₂ : D₂.edgeTwist (T.quotient.rev y) = D₂.twist y := by
    simpa [D₂.twist_rev] using D₂.edgeTwist_of_out_eq (y := T.quotient.rev y) (by simpa using h)
  rw [coe_homOfOrbits_twist, h₁, h₂]

/-- Every vertex-group homomorphism of `homOfOrbits` is bijective. -/
theorem homOfOrbits_vertexHom_bijective {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (b : T.quotient.V) :
    Function.Bijective ((homOfOrbits D₁ D₂ hu hv).vertexHom b) :=
  (stabilizerEquivStabilizer (hu b)).bijective

/-- Every edge-group homomorphism of `homOfOrbits` is bijective. -/
theorem homOfOrbits_edgeHom_bijective {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z))
    (y : T.quotient.E) :
    Function.Bijective ((homOfOrbits D₁ D₂ hu hv).edgeHom y) :=
  (stabilizerEquivStabilizer (hv (T.quotient.toGeomEdge y))).bijective

private theorem vertexGroup_heq_of_coe_eq (D : T.Lifting) {b₁ b₂ : T.quotient.V} (hb : b₁ = b₂)
    {x : D.graphOfGroups.vertexGroup b₁} {y : D.graphOfGroups.vertexGroup b₂}
    (h : (x : G) = (y : G)) : x ≍ y := by
  subst hb
  exact heq_of_eq (D.vertexGroupSubtype_injective b₁ h)

/-- With trivial orbit-comparison elements, `homOfOrbits` is the identity morphism. -/
@[simp] theorem homOfOrbits_self :
    homOfOrbits D₁ D₁ (u := fun _ => 1) (fun _ => (one_smul G _).symm) (v := fun _ => 1)
      (fun _ => (one_smul G _).symm) = GraphOfGroups.Hom.id D₁.graphOfGroups := by
  refine GraphOfGroups.Hom.ext
    ((homOfOrbits_graph D₁ D₁ _ _).trans (GraphOfGroups.Hom.id_graph D₁.graphOfGroups).symm)
    (fun b a => vertexGroup_heq_of_coe_eq D₁ (by simp) ?_)
    (fun y => vertexGroup_heq_of_coe_eq D₁ (by simp) ?_)
  · rw [coe_homOfOrbits_vertexHom, GraphOfGroups.Hom.id_vertexHom, MonoidHom.id_apply, map_one,
      MulAut.one_apply]
  · rw [coe_homOfOrbits_twist, GraphOfGroups.Hom.id_twist, map_one]
    group

/-- `homOfOrbits` composes by multiplying the orbit-comparison elements. -/
theorem homOfOrbits_comp (D₃ : T.Lifting) {u₁ : T.quotient.V → G}
    (hu₁ : ∀ b, D₂.vertex b = u₁ b • D₁.vertex b) {v₁ : T.quotient.GeomEdge → G}
    (hv₁ : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v₁ z • D₁.dart (GeomEdge.out T.quotient z))
    {u₂ : T.quotient.V → G} (hu₂ : ∀ b, D₃.vertex b = u₂ b • D₂.vertex b)
    {v₂ : T.quotient.GeomEdge → G}
    (hv₂ : ∀ z, D₃.dart (GeomEdge.out T.quotient z) = v₂ z • D₂.dart (GeomEdge.out T.quotient z)) :
    (homOfOrbits D₂ D₃ hu₂ hv₂).comp (homOfOrbits D₁ D₂ hu₁ hv₁) =
      homOfOrbits D₁ D₃ (u := fun b => u₂ b * u₁ b) (fun b => by rw [hu₂, hu₁, mul_smul])
        (v := fun z => v₂ z * v₁ z) (fun z => by rw [hv₂, hv₁, mul_smul]) := by
  refine GraphOfGroups.Hom.ext ((GraphOfGroups.Hom.comp_graph _ _).trans (by simp))
    (fun b a => vertexGroup_heq_of_coe_eq D₃ (by simp) ?_)
    (fun y => vertexGroup_heq_of_coe_eq D₃ (by simp) ?_)
  · rw [GraphOfGroups.Hom.comp_vertexHom, MonoidHom.comp_apply, coe_homOfOrbits_vertexHom,
      coe_homOfOrbits_vertexHom, coe_homOfOrbits_vertexHom, homOfOrbits_graph]
    simp only [SerreGraph.Hom.id_mapV, id_eq, MulAut.conj_apply]
    group
  · rw [GraphOfGroups.Hom.comp_twist, map_mul, coe_homOfOrbits_vertexHom, coe_homOfOrbits_twist,
      coe_vertexGroup_cast, coe_homOfOrbits_twist, coe_homOfOrbits_twist, homOfOrbits_graph]
    simp only [SerreGraph.Hom.id_mapV, SerreGraph.Hom.id_mapE, id_eq, MulAut.conj_apply]
    group

/-- Inverting the orbit-comparison elements gives the left inverse of `homOfOrbits`. -/
@[simp] theorem homOfOrbits_inv_comp {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z)) :
    (homOfOrbits D₂ D₁ (u := fun b => (u b)⁻¹) (fun b => (inv_smul_eq_iff.mpr (hu b)).symm)
        (v := fun z => (v z)⁻¹) (fun z => (inv_smul_eq_iff.mpr (hv z)).symm)).comp
      (homOfOrbits D₁ D₂ hu hv) = GraphOfGroups.Hom.id D₁.graphOfGroups := by
  rw [homOfOrbits_comp]
  convert homOfOrbits_self D₁ <;> simp

/-- Inverting the orbit-comparison elements gives the right inverse of `homOfOrbits`. -/
@[simp] theorem comp_homOfOrbits_inv {u : T.quotient.V → G}
    (hu : ∀ b, D₂.vertex b = u b • D₁.vertex b) {v : T.quotient.GeomEdge → G}
    (hv : ∀ z, D₂.dart (GeomEdge.out T.quotient z) = v z • D₁.dart (GeomEdge.out T.quotient z)) :
    (homOfOrbits D₁ D₂ hu hv).comp
      (homOfOrbits D₂ D₁ (u := fun b => (u b)⁻¹) (fun b => (inv_smul_eq_iff.mpr (hu b)).symm)
        (v := fun z => (v z)⁻¹) (fun z => (inv_smul_eq_iff.mpr (hv z)).symm)) =
      GraphOfGroups.Hom.id D₂.graphOfGroups := by
  rw [homOfOrbits_comp]
  convert homOfOrbits_self D₂ <;> simp

/-- **Independence of the lifting.** For any two liftings `D₁` and `D₂` of a `G`-tree `T`, there
exist mutually inverse morphisms of graphs of groups between `D₁.graphOfGroups` and
`D₂.graphOfGroups` whose underlying graph morphisms are the identity of `T.quotient`. -/
theorem exists_hom_graphOfGroups :
    ∃ (Φ : GraphOfGroups.Hom D₁.graphOfGroups D₂.graphOfGroups)
      (Ψ : GraphOfGroups.Hom D₂.graphOfGroups D₁.graphOfGroups),
      Φ.graph = SerreGraph.Hom.id T.quotient ∧
        Ψ.graph = SerreGraph.Hom.id T.quotient ∧
        Ψ.comp Φ = GraphOfGroups.Hom.id D₁.graphOfGroups ∧
        Φ.comp Ψ = GraphOfGroups.Hom.id D₂.graphOfGroups := by
  have hV (b : T.quotient.V) : ∃ u : G, D₂.vertex b = u • D₁.vertex b := by
    obtain ⟨u, hu⟩ := quotientMap_mapV_eq_iff.mp
      ((D₁.quotientMap_vertex b).trans (D₂.quotientMap_vertex b).symm)
    exact ⟨u, hu.symm⟩
  have hE (z : T.quotient.GeomEdge) :
      ∃ v : G, D₂.dart (GeomEdge.out T.quotient z) = v • D₁.dart (GeomEdge.out T.quotient z) := by
    obtain ⟨v, hv⟩ := quotientMap_mapE_eq_iff.mp
      ((D₁.quotientMap_dart _).trans (D₂.quotientMap_dart _).symm)
    exact ⟨v, hv.symm⟩
  choose u hu using hV
  choose v hv using hE
  exact ⟨homOfOrbits D₁ D₂ hu hv,
    homOfOrbits D₂ D₁ (u := fun b => (u b)⁻¹) (fun b => (inv_smul_eq_iff.mpr (hu b)).symm)
      (v := fun z => (v z)⁻¹) (fun z => (inv_smul_eq_iff.mpr (hv z)).symm),
    homOfOrbits_graph D₁ D₂ hu hv, homOfOrbits_graph D₂ D₁ _ _,
    homOfOrbits_inv_comp D₁ D₂ hu hv, comp_homOfOrbits_inv D₁ D₂ hu hv⟩

end HomOfOrbits

/-! ### Actions with trivial dart or vertex stabilizers -/

section TrivialEdgeStabilizers

variable (D : T.Lifting)

private theorem subsingleton_edgeGroup_of_stabilizer_eq_bot (hE : ∀ e : T.E, stabilizer G e = ⊥)
    (z : T.quotient.GeomEdge) : Subsingleton (D.graphOfGroups.edgeGroup z) := by
  rw [graphOfGroups_edgeGroup, hE]; infer_instance

/-- When every dart stabilizer of `T` is trivial, `G` is isomorphic to the free product of the
lifted vertex groups `D.graphOfGroups.vertexGroup b` with the free group on the darts of any
orientation `O` of `T.quotient` outside `D.tree`. -/
noncomputable def equivCoprodFreeGroup (hE : ∀ e : T.E, stabilizer G e = ⊥)
    {O : Set T.quotient.E} (hO : T.quotient.IsOrientation O) :
    G ≃* Monoid.Coprod (Monoid.CoprodI D.graphOfGroups.vertexGroup)
      (FreeGroup ↥(O \ D.tree.darts)) :=
  have := D.subsingleton_edgeGroup_of_stabilizer_eq_bot hE
  D.π₁TreeEquiv.symm.trans
    (GraphOfGroups.π₁Tree.equivCoprodFreeGroup D.graphOfGroups hO D.tree.rev_mem)

@[simp] theorem equivCoprodFreeGroup_coe_vertex (hE : ∀ e : T.E, stabilizer G e = ⊥)
    {O : Set T.quotient.E} (hO : T.quotient.IsOrientation O) (b : T.quotient.V)
    (g : D.graphOfGroups.vertexGroup b) :
    D.equivCoprodFreeGroup hE hO (g : G) = Monoid.Coprod.inl (Monoid.CoprodI.of g) := by
  have := D.subsingleton_edgeGroup_of_stabilizer_eq_bot hE
  exact (congrArg _ (D.π₁TreeEquiv_symm_coe_vertex b g)).trans
    (GraphOfGroups.π₁Tree.equivCoprodFreeGroup_of hO D.tree.rev_mem b g)

@[simp] theorem equivCoprodFreeGroup_twist (hE : ∀ e : T.E, stabilizer G e = ⊥)
    {O : Set T.quotient.E} (hO : T.quotient.IsOrientation O) {y : T.quotient.E}
    (hy : y ∈ O \ D.tree.darts) :
    D.equivCoprodFreeGroup hE hO (D.twist y) = Monoid.Coprod.inr (FreeGroup.of ⟨y, hy⟩) := by
  have := D.subsingleton_edgeGroup_of_stabilizer_eq_bot hE
  exact (congrArg _ (D.π₁TreeEquiv_symm_twist y)).trans
    (GraphOfGroups.π₁Tree.equivCoprodFreeGroup_edge hO D.tree.rev_mem hy)

@[simp] theorem equivCoprodFreeGroup_symm_inl (hE : ∀ e : T.E, stabilizer G e = ⊥)
    {O : Set T.quotient.E} (hO : T.quotient.IsOrientation O)
    (x : Monoid.CoprodI D.graphOfGroups.vertexGroup) :
    (D.equivCoprodFreeGroup hE hO).symm (Monoid.Coprod.inl x) =
      Monoid.CoprodI.lift D.vertexGroupSubtype x := by
  have := D.subsingleton_edgeGroup_of_stabilizer_eq_bot hE
  rw [equivCoprodFreeGroup, MulEquiv.symm_trans_apply, MulEquiv.symm_symm,
    GraphOfGroups.π₁Tree.equivCoprodFreeGroup_symm_apply, GraphOfGroups.π₁Tree.ofCoprod_inl,
    π₁TreeEquiv_apply, ← D.π₁TreeToGroup.comp_apply]
  have hcomp : D.π₁TreeToGroup.comp (Monoid.CoprodI.lift (GraphOfGroups.π₁Tree.of D.tree.darts)) =
      Monoid.CoprodI.lift D.vertexGroupSubtype := by ext b g; simp
  exact DFunLike.congr_fun hcomp x

@[simp] theorem equivCoprodFreeGroup_symm_inr_of (hE : ∀ e : T.E, stabilizer G e = ⊥)
    {O : Set T.quotient.E} (hO : T.quotient.IsOrientation O) (y : ↥(O \ D.tree.darts)) :
    (D.equivCoprodFreeGroup hE hO).symm (Monoid.Coprod.inr (FreeGroup.of y)) = D.twist y.1 := by
  have := D.subsingleton_edgeGroup_of_stabilizer_eq_bot hE
  simp [equivCoprodFreeGroup, π₁TreeEquiv_apply]

end TrivialEdgeStabilizers

section FreeAction

variable (D : T.Lifting)

private theorem subsingleton_vertexGroup_of_stabilizer_eq_bot (hV : ∀ v : T.V, stabilizer G v = ⊥)
    (b : T.quotient.V) : Subsingleton (D.graphOfGroups.vertexGroup b) := by
  rw [graphOfGroups_vertexGroup, hV]; infer_instance

/-- When `G` acts freely on the vertices of `T`, `G` is isomorphic to the free group on the darts
of any orientation `O` of `T.quotient` outside `D.tree`, with `D.twist y` sent to the generator
`y` for `y ∈ O \ D.tree`. -/
noncomputable def equivFreeGroup (hV : ∀ v : T.V, stabilizer G v = ⊥)
    {O : Set T.quotient.E} (hO : T.quotient.IsOrientation O) :
    G ≃* FreeGroup ↥(O \ D.tree.darts) :=
  have := D.subsingleton_vertexGroup_of_stabilizer_eq_bot hV
  D.π₁TreeEquiv.symm.trans
    (GraphOfGroups.π₁Tree.equivFreeGroup D.graphOfGroups hO D.tree.rev_mem)

@[simp] theorem equivFreeGroup_twist (hV : ∀ v : T.V, stabilizer G v = ⊥)
    {O : Set T.quotient.E} (hO : T.quotient.IsOrientation O) {y : T.quotient.E}
    (hy : y ∈ O \ D.tree.darts) :
    D.equivFreeGroup hV hO (D.twist y) = FreeGroup.of ⟨y, hy⟩ := by
  have := D.subsingleton_vertexGroup_of_stabilizer_eq_bot hV
  exact (congrArg _ (D.π₁TreeEquiv_symm_twist y)).trans
    (GraphOfGroups.π₁Tree.equivFreeGroup_edge hO D.tree.rev_mem hy)

@[simp] theorem equivFreeGroup_symm_of (hV : ∀ v : T.V, stabilizer G v = ⊥)
    {O : Set T.quotient.E} (hO : T.quotient.IsOrientation O) (y : ↥(O \ D.tree.darts)) :
    (D.equivFreeGroup hV hO).symm (FreeGroup.of y) = D.twist y.1 := by
  have := D.subsingleton_vertexGroup_of_stabilizer_eq_bot hV
  simp [equivFreeGroup, π₁TreeEquiv_apply]

end FreeAction

/-- For any lifting of the one-vertex `G`-tree `point G`, the vertex group at the unique quotient
vertex is the top subgroup `⊤`, and the canonical inclusion into `π₁(D.graphOfGroups, D.tree)` is
bijective. -/
theorem point_of_bijective (D : (point.{u, v} G).Lifting) (b : (point.{u, v} G).quotient.V) :
    Function.Bijective (GraphOfGroups.π₁Tree.of (𝔸 := D.graphOfGroups) D.tree.darts b) := by
  have hsub : Function.Bijective (D.vertexGroupSubtype b) :=
    ⟨Subgroup.subtype_injective _, fun g => ⟨⟨g, by simp⟩, rfl⟩⟩
  rw [← Function.Bijective.of_comp_iff' D.π₁TreeToGroup_bijective, ← MonoidHom.coe_comp,
    D.π₁TreeToGroup_comp_of]
  exact hsub

end Lifting

/-- For every `G`-tree `T`, every spanning tree `S` of `T.quotient` and every vertex `x₀` of `T`,
there is a lifting `D` with spanning tree `S` and `D.vertex (T.quotientMap.mapV x₀) = x₀` together
with an isomorphism `π₁(D.graphOfGroups, T.quotientMap.mapV x₀) ≃* G`. -/
theorem exists_lifting_π₁Equiv (T : GTree.{u, v} G) (S : T.quotient.SpanningTree) (x₀ : T.V) :
    ∃ D : T.Lifting, D.tree = S ∧ D.vertex (T.quotientMap.mapV x₀) = x₀ ∧
      Nonempty (GraphOfGroups.π₁ D.graphOfGroups (T.quotientMap.mapV x₀) ≃* G) := by
  obtain ⟨D, hS, hx₀⟩ := T.exists_lifting S x₀
  exact ⟨D, hS, hx₀, ⟨D.π₁Equiv _⟩⟩

/-- **Serre's freeness theorem:** a group acting on a tree without inversions and with trivial
vertex stabilizers is a free group. -/
theorem isFreeGroup_of_stabilizer_eq_bot (T : GTree.{u, v} G)
    (hV : ∀ v : T.V, stabilizer G v = ⊥) : IsFreeGroup G := by
  obtain ⟨D⟩ := (inferInstance : Nonempty T.Lifting)
  obtain ⟨O, hO⟩ := T.quotient.exists_isOrientation
  exact IsFreeGroup.ofMulEquiv (D.equivFreeGroup hV hO).symm

end GTree

end TauCeti
