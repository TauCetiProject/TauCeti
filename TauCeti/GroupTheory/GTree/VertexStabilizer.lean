module

public import TauCeti.GroupTheory.GTree.Lifting
public import Mathlib.GroupTheory.Finiteness
import TauCeti.GroupTheory.Finiteness

/-!
# Generators of the vertex stabilizers of a tree with a group action

Let a finitely generated group `G` act on a tree `T` without inversions and let `x` be a vertex.
The stabilizer of `x` is finitely generated relative to the incident edge groups: it is generated
by a finite set together with the stabilizers of finitely many darts issuing from `x`
(`GTree.exists_finite_stabilizer_eq_closure`). In particular, if the stabilizers of the darts
issuing from `x` are finitely generated, then so is the stabilizer of `x`
(`GTree.fg_stabilizer_vertex`). Neither statement needs the action to be minimal or the quotient
graph to be finite.

The proof uses a lifting of the quotient graph `T / G`. The group is generated by the stabilizers
of the lifted vertices together with the elements of the lifting attached to the darts of the
quotient graph (`GTree.Lifting.closure_iUnion_stabilizer_union_range_twist`; for the fundamental
group of a graph of groups this is Kapovich–Weidmann–Myasnikov, Proposition 2.4 (3)). Conversely,
let `R` be a set of vertices of the quotient graph and `Y` a set of darts between them, closed
under reversal, and let `K b`, for `b` in `R`, be subgroups of the stabilizers of the lifted
vertices containing the stabilizers of the lifted darts of `Y` issuing from them. The pairs of a
vertex `b` of the quotient graph and a left coset of `K b ⊓ G_{D.vertex b}` are the vertices of a
graph with the darts of `T`, the translate `g • D.dart y` of a lifted dart of `Y` issuing from the
coset of `g` at the source of `y`. Sending the coset of `g` at `b` to `g • D.vertex b` is a
morphism to `T` which is the identity on darts; as `T` is a tree, it is injective on the vertices
of each connected component. If the vertices of `R` are joined inside the spanning tree and `Y`,
and the subgroups `K b` and the elements of the lifting attached to the darts of `Y` generate `G`,
then all the cosets at a vertex of `R` lie in one component, so each `K b` is the whole stabilizer
(`GTree.Lifting.eq_stabilizer_vertex_of_closure_eq_top`). A finitely generated group is generated
by finitely many elements of the stabilizers of the lifted vertices and finitely many elements of
the lifting, so `R` and `Y` may be taken finite.

## Main declarations

* `TauCeti.GTree.Lifting.closure_iUnion_stabilizer_union_range_twist`: the stabilizers of the
  lifted vertices and the elements of a lifting generate the group.
* `TauCeti.GTree.Lifting.eq_stabilizer_vertex_of_closure_eq_top`: subgroups of the stabilizers
  of the lifted vertices containing the stabilizers of the lifted darts and generating `G`
  together with the elements of the lifting are the whole stabilizers.
* `TauCeti.GTree.exists_finite_stabilizer_eq_closure`: the vertex stabilizers of a tree of a
  finitely generated group are finitely generated relative to the incident edge groups.
* `TauCeti.GTree.fg_stabilizer_vertex`: a vertex with finitely generated incident edge groups
  has a finitely generated stabilizer.

## References

* V. Guirardel and G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §1.7,
  Definition 4.3 and Lemma 4.7.
* J.-P. Serre, *Trees*, Chapter I, §5.4.
* I. Kapovich, R. Weidmann and A. Myasnikov, *Foldings, graphs of groups and the membership
  problem*, Internat. J. Algebra Comput. 15 (2005), Proposition 2.4 (3).
-/

public section

universe u v w

namespace TauCeti

open SerreGraph _root_.MulAction

namespace GTree

variable {G : Type w} [Group G] {T : GTree.{u, v} G}

namespace Lifting

variable (D : T.Lifting)

/-- The translates of the lifted vertices by a subgroup containing the stabilizers of the lifted
vertices and the elements of the lifting form a set of vertices closed under adjacency. -/
private theorem exists_smul_vertex_eq_tgt {H : Subgroup G}
    (hstab : ∀ b, stabilizer G (D.vertex b) ≤ H) (htwist : ∀ y, D.twist y ∈ H) {e : T.E} {h : G}
    (hh : h ∈ H) {b : T.quotient.V} (hb : h • D.vertex b = T.src e) :
    ∃ h' ∈ H, ∃ b', h' • D.vertex b' = T.tgt e := by
  obtain ⟨k, hk, hke⟩ := D.exists_smul_dart_eq (e := h⁻¹ • e)
    (by rw [src_smul, ← hb, inv_smul_smul])
  refine ⟨h * k * D.twist (T.quotientMap.mapE (h⁻¹ • e)),
    mul_mem (mul_mem hh (hstab b hk)) (htwist _), T.quotient.tgt (T.quotientMap.mapE (h⁻¹ • e)), ?_⟩
  rw [mul_smul, mul_smul, ← tgt_dart, ← tgt_smul, hke, tgt_smul, smul_inv_smul]

/-- The group is generated by the stabilizers of the lifted vertices and the elements attached
to the darts of the quotient graph. -/
theorem closure_iUnion_stabilizer_union_range_twist :
    Subgroup.closure ((⋃ b, (stabilizer G (D.vertex b) : Set G)) ∪ Set.range D.twist) = ⊤ := by
  set H := Subgroup.closure ((⋃ b, (stabilizer G (D.vertex b) : Set G)) ∪ Set.range D.twist)
  have hstab (b : T.quotient.V) : stabilizer G (D.vertex b) ≤ H := fun g hg =>
    Subgroup.subset_closure (Or.inl (Set.mem_iUnion.mpr ⟨b, hg⟩))
  -- The translates of the lifted vertices by `H` are closed under adjacency, so they are all the
  -- vertices of the tree; in particular `g • D.vertex b₀ = h • D.vertex b₀` with `h ∈ H`.
  refine eq_top_iff.mpr fun g _ => ?_
  obtain ⟨b₀⟩ := (connected_iff _).mp T.quotient_connected |>.1
  obtain ⟨p⟩ := T.nonempty_path (D.vertex b₀) (g • D.vertex b₀)
  obtain ⟨h, hh, b, hb⟩ := (Path.mem_iff_mem_of_forall_mem_darts T.toSerreGraph (S := Set.univ)
    (R := {x | ∃ h ∈ H, ∃ b, h • D.vertex b = x}) (fun _ _ => trivial)
    (fun e _ ⟨h, hh, b, hb⟩ => D.exists_smul_vertex_eq_tgt hstab
      (fun y => Subgroup.subset_closure (Or.inr ⟨y, rfl⟩)) hh hb) p
    fun _ _ => trivial).mp ⟨1, one_mem H, b₀, one_smul G _⟩
  obtain rfl : b = b₀ := by simpa using congrArg T.quotientMap.mapV hb
  have : h⁻¹ * g ∈ stabilizer G (D.vertex b) := by
    rw [mem_stabilizer_iff, mul_smul, ← hb, inv_smul_smul]
  simpa using mul_mem hh (hstab b this)

/-! ### The graph of cosets -/

/-- An element of the group carrying the lift of the image of a dart to that dart. -/
private noncomputable def toDart (e : T.E) : G :=
  (quotientMap_mapE_eq_iff.mp (D.quotientMap_dart (T.quotientMap.mapE e))).choose

private theorem toDart_smul (e : T.E) : D.toDart e • D.dart (T.quotientMap.mapE e) = e :=
  (quotientMap_mapE_eq_iff.mp (D.quotientMap_dart (T.quotientMap.mapE e))).choose_spec

variable (K : T.quotient.V → Subgroup G)

/-- The graph of cosets of a family of subgroups `K b` indexed by the vertices of the quotient
graph: its vertices are the pairs of a vertex `b` of the quotient graph and a left coset of
`K b ⊓ G_{D.vertex b}`, and its darts are those of the tree, a dart `e` issuing from the coset at
the image of its source of an element carrying the lift of the image of `e` to `e`. -/
private noncomputable def cosetGraph : SerreGraph.{max u w, v} where
  V := Σ b : T.quotient.V, G ⧸ (K b ⊓ stabilizer G (D.vertex b))
  E := T.E
  src e := Sigma.mk (T.quotient.src (T.quotientMap.mapE e)) (QuotientGroup.mk (D.toDart e))
  rev := T.rev
  rev_rev := T.rev_rev
  rev_ne := T.rev_ne

/-- The coset of `g` at the vertex `b` of the quotient graph, as a vertex of the graph of
cosets. -/
private def cosetVertex (b : T.quotient.V) (g : G) : (D.cosetGraph K).V :=
  Sigma.mk b (QuotientGroup.mk g)

/-- A dart of the tree, as a dart of the graph of cosets. -/
private def cosetDart (e : T.E) : (D.cosetGraph K).E := e

private theorem cosetVertex_eq_cosetVertex_iff {b : T.quotient.V} {g g' : G} :
    D.cosetVertex K b g = D.cosetVertex K b g' ↔ g⁻¹ * g' ∈ K b ⊓ stabilizer G (D.vertex b) :=
  ⟨fun h => QuotientGroup.eq.mp
      (sigma_mk_injective (β := fun b => G ⧸ (K b ⊓ stabilizer G (D.vertex b))) h),
    fun h => congrArg (Sigma.mk b) (QuotientGroup.eq.mpr h)⟩

private theorem cosetGraph_rev_cosetDart (e : T.E) :
    (D.cosetGraph K).rev (D.cosetDart K e) = D.cosetDart K (T.rev e) :=
  rfl

/-- The morphism from the graph of cosets to the tree, sending the coset of `g` at `b` to
`g • D.vertex b`, and the identity on darts. -/
private noncomputable def cosetGraphHom : (D.cosetGraph K).Hom T.toSerreGraph where
  mapV x := ofQuotientStabilizer G (D.vertex x.1) (Subgroup.quotientMapOfLE inf_le_right x.2)
  mapE e := e
  map_src e := by
    have h := congrArg T.src (D.toDart_smul e)
    rwa [src_smul, src_dart, eq_comm] at h
  map_rev _ := rfl

private theorem cosetGraphHom_mapV_cosetVertex (b : T.quotient.V) (g : G) :
    (D.cosetGraphHom K).mapV (D.cosetVertex K b g) = g • D.vertex b :=
  rfl

variable {D K}

/-- The source of the translate by `g` of a lifted dart `y` is the coset of `g` at the source of
`y`, if `K` contains the stabilizer of the lifted dart. -/
private theorem cosetGraph_src {y : T.quotient.E}
    (hy : stabilizer G (D.dart y) ≤ K (T.quotient.src y)) {e : T.E} {g : G} (h : g • D.dart y = e) :
    (D.cosetGraph K).src (D.cosetDart K e) = D.cosetVertex K (T.quotient.src y) g := by
  obtain rfl : T.quotientMap.mapE e = y := by simp [← h]
  have hmem : (D.toDart e)⁻¹ * g ∈ stabilizer G (D.dart (T.quotientMap.mapE e)) := by
    rw [mem_stabilizer_iff, mul_smul, h, inv_smul_eq_iff, D.toDart_smul]
  have hsrc := T.stabilizer_dart_le_stabilizer_src _ hmem
  rw [src_dart] at hsrc
  exact congrArg (Sigma.mk _) (QuotientGroup.eq.mpr ⟨hy hmem, hsrc⟩)

/-- The target of the translate by `g` of a lifted dart `y` is the coset of `g * D.twist y` at
the target of `y`, if `K` contains the stabilizer of the lift of the reverse of `y`. -/
private theorem cosetGraph_tgt {y : T.quotient.E}
    (hy : stabilizer G (D.dart (T.quotient.rev y)) ≤ K (T.quotient.src (T.quotient.rev y)))
    {e : T.E} {g : G} (h : g • D.dart y = e) :
    (D.cosetGraph K).tgt (D.cosetDart K e) =
      D.cosetVertex K (T.quotient.tgt y) (g * D.twist y) := by
  rw [tgt_def, cosetGraph_rev_cosetDart, cosetGraph_src hy (e := T.rev e)
    (by rw [mul_smul, D.twist_smul_dart_rev, ← rev_smul, h]), src_rev]

variable {Y : Set T.quotient.E} (hY : ∀ y ∈ Y, T.quotient.rev y ∈ Y)
  (hdart : ∀ y ∈ Y, stabilizer G (D.dart y) ≤ K (T.quotient.src y))
include hY hdart

/-- A path of the spanning tree of the quotient graph with darts in `Y` lifts to a path of the
graph of cosets between the cosets of any fixed element. -/
private theorem nonempty_cosetGraph_path (g : G) {a c : T.quotient.V} (p : T.quotient.Path a c)
    (hp : ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts) :
    Nonempty ((D.cosetGraph K).Path (D.cosetVertex K a g) (D.cosetVertex K c g)) := by
  induction p with
  | nil => exact ⟨.nil⟩
  | cons p y ih =>
    obtain ⟨q⟩ := ih fun z hz => hp z (by simp [hz])
    obtain ⟨y, rfl, rfl⟩ := y
    obtain ⟨hyY, hyS⟩ := hp y (by simp)
    exact ⟨q.cons ⟨D.cosetDart K (g • D.dart y), cosetGraph_src (hdart y hyY) rfl,
      by rw [cosetGraph_tgt (hdart _ (hY y hyY)) rfl, D.twist_eq_one y hyS, mul_one]⟩⟩

variable {R : Set T.quotient.V} {b₀ : T.quotient.V}
  (hR : ∀ b ∈ R, ∃ p : T.quotient.Path b₀ b,
    ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts)
include hR

/-- The cosets of `h` and of `h * x` at `b₀` are joined in the graph of cosets if `x` lies in
`K b` for some `b` in `R`. -/
private theorem nonempty_cosetGraph_path_mul_of_mem (hK : ∀ b ∈ R, K b ≤ stabilizer G (D.vertex b))
    {b : T.quotient.V} (hb : b ∈ R) {x : G} (hx : x ∈ K b) (h : G) :
    Nonempty ((D.cosetGraph K).Path (D.cosetVertex K b₀ h) (D.cosetVertex K b₀ (h * x))) := by
  obtain ⟨p, hp⟩ := hR b hb
  obtain ⟨q₁⟩ := nonempty_cosetGraph_path hY hdart h p hp
  obtain ⟨q₂⟩ := nonempty_cosetGraph_path hY hdart (h * x) p hp
  have hbx : D.cosetVertex K b h = D.cosetVertex K b (h * x) :=
    (cosetVertex_eq_cosetVertex_iff _ _).mpr
      (by rw [inv_mul_cancel_left]; exact Subgroup.mem_inf.mpr ⟨hx, hK b hb hx⟩)
  rw [hbx] at q₁
  exact ⟨q₁.comp q₂.reverse⟩

/-- The cosets of `h` and of `h * D.twist y` at `b₀` are joined in the graph of cosets if `y`
lies in `Y`. -/
private theorem nonempty_cosetGraph_path_mul_twist (hYR : ∀ y ∈ Y, T.quotient.src y ∈ R)
    {y : T.quotient.E} (hy : y ∈ Y) (h : G) :
    Nonempty ((D.cosetGraph K).Path (D.cosetVertex K b₀ h)
      (D.cosetVertex K b₀ (h * D.twist y))) := by
  obtain ⟨p₁, hp₁⟩ := hR _ (hYR y hy)
  obtain ⟨p₂, hp₂⟩ := hR _ (hYR _ (hY y hy))
  obtain ⟨q₁⟩ := nonempty_cosetGraph_path hY hdart h p₁ hp₁
  obtain ⟨q₂⟩ := nonempty_cosetGraph_path hY hdart (h * D.twist y) p₂ hp₂
  exact ⟨(q₁.cons ⟨D.cosetDart K (h • D.dart y), cosetGraph_src (hdart y hy) rfl,
    cosetGraph_tgt (hdart _ (hY y hy)) rfl⟩).comp q₂.reverse⟩

/-- If the subgroups `K b` for `b` in `R` and the elements attached to the darts of `Y` generate
the group, then the cosets of `h` and of `h * g` at `b₀` are joined in the graph of cosets. -/
private theorem nonempty_cosetGraph_path_mul (hYR : ∀ y ∈ Y, T.quotient.src y ∈ R)
    (hK : ∀ b ∈ R, K b ≤ stabilizer G (D.vertex b))
    (hgen : Subgroup.closure ((⋃ b ∈ R, (K b : Set G)) ∪ D.twist '' Y) = ⊤) (g h : G) :
    Nonempty ((D.cosetGraph K).Path (D.cosetVertex K b₀ h) (D.cosetVertex K b₀ (h * g))) := by
  have hg : g ∈ Subgroup.closure ((⋃ b ∈ R, (K b : Set G)) ∪ D.twist '' Y) :=
    hgen ▸ Subgroup.mem_top g
  induction hg using Subgroup.closure_induction generalizing h with
  | mem x hx =>
    rcases hx with hx | ⟨y, hy, rfl⟩
    · obtain ⟨b, hb, hx⟩ := Set.mem_iUnion₂.mp hx
      exact nonempty_cosetGraph_path_mul_of_mem hY hdart hR hK hb hx h
    · exact nonempty_cosetGraph_path_mul_twist hY hdart hR hYR hy h
  | one => rw [mul_one]; exact ⟨.nil⟩
  | mul x y _ _ ihx ihy =>
    obtain ⟨q₁⟩ := ihx h
    obtain ⟨q₂⟩ := ihy (h * x)
    rw [mul_assoc] at q₂
    exact ⟨q₁.comp q₂⟩
  | inv x _ ihx =>
    obtain ⟨q⟩ := ihx (h * x⁻¹)
    rw [inv_mul_cancel_right] at q
    exact ⟨q.reverse⟩

omit hY hdart hR

variable (D) in
/-- Let `R` be a set of vertices of the quotient graph and `Y` a set of darts of the quotient
graph, closed under reversal and issuing from vertices of `R`, such that every vertex of `R` is
joined to a vertex `b₀` by a path in the spanning tree with darts in `Y`. For `b` in `R` let `K b`
be a subgroup of the stabilizer of the lifted vertex containing the stabilizers of the lifted
darts of `Y` issuing from it. If these subgroups and the elements attached to the darts of `Y`
generate the group, then `K b` is the whole stabilizer of the lifted vertex for every `b` in
`R`. -/
theorem eq_stabilizer_vertex_of_closure_eq_top {R : Set T.quotient.V} {Y : Set T.quotient.E}
    (hY : ∀ y ∈ Y, T.quotient.rev y ∈ Y) (hYR : ∀ y ∈ Y, T.quotient.src y ∈ R) {b₀ : T.quotient.V}
    (hR : ∀ b ∈ R, ∃ p : T.quotient.Path b₀ b,
      ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts) (K : T.quotient.V → Subgroup G)
    (hK : ∀ b ∈ R, K b ≤ stabilizer G (D.vertex b))
    (hdart : ∀ y ∈ Y, stabilizer G (D.dart y) ≤ K (T.quotient.src y))
    (hgen : Subgroup.closure ((⋃ b ∈ R, (K b : Set G)) ∪ D.twist '' Y) = ⊤) {b : T.quotient.V}
    (hb : b ∈ R) : K b = stabilizer G (D.vertex b) := by
  refine le_antisymm (hK b hb) fun g hg => ?_
  -- The cosets of `g` and of `1` at `b` are joined in the graph of cosets and have the same
  -- image in the tree, so they are equal.
  obtain ⟨p, hp⟩ := hR b hb
  obtain ⟨q₁⟩ := nonempty_cosetGraph_path hY hdart g p hp
  obtain ⟨q₂⟩ := nonempty_cosetGraph_path hY hdart 1 p hp
  obtain ⟨q₃⟩ := nonempty_cosetGraph_path_mul hY hdart hR hYR hK hgen g 1
  rw [one_mul] at q₃
  have := (D.cosetGraphHom K).eq_of_mapV_eq_of_isAcyclic T.isAcyclic (fun _ _ _ h => h)
    ((q₁.reverse.comp q₃.reverse).comp q₂) (by
      rw [cosetGraphHom_mapV_cosetVertex, cosetGraphHom_mapV_cosetVertex,
        mem_stabilizer_iff.mp hg, one_smul])
  simpa using ((cosetVertex_eq_cosetVertex_iff _ _).mp this).1

/-! ### Finite generation relative to the incident edge groups -/

/-- A dart of a path from `b₀` inside the spanning tree and `Y` ends a path from `b₀` inside the
spanning tree and `Y`: the part of the path up to that dart. -/
private theorem exists_path_cons_of_mem_darts {Y : Set T.quotient.E} {b₀ c : T.quotient.V}
    {p : T.quotient.Path b₀ c} (hp : ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts)
    {y : T.quotient.E} (hy : y ∈ Path.darts T.quotient p) :
    ∃ q : T.quotient.Path b₀ (T.quotient.src y),
      ∀ z ∈ Path.darts T.quotient (q.cons (T.quotient.dart y)), z ∈ Y ∧ z ∈ D.tree.darts := by
  obtain ⟨q, r, rfl⟩ := Path.exists_eq_cons_comp_of_mem_darts _ p hy
  exact ⟨q, fun z hz => hp z (by simp at hz ⊢; tauto)⟩

variable (D) in
/-- Finitely many vertices and darts of the quotient graph lie in a finite set `Y` of darts,
closed under reversal, such that each of the given vertices and the source of each dart of `Y`
are joined to `b₀` by a path of the spanning tree with darts in `Y`. -/
private theorem exists_finite_darts (b₀ : T.quotient.V) {V₁ : Set T.quotient.V} (hV₁ : V₁.Finite)
    {Y₁ : Set T.quotient.E} (hY₁ : Y₁.Finite) :
    ∃ Y : Set T.quotient.E, Y.Finite ∧ Y₁ ⊆ Y ∧ (∀ y ∈ Y, T.quotient.rev y ∈ Y) ∧
      ∀ b ∈ V₁ ∪ T.quotient.src '' Y, ∃ p : T.quotient.Path b₀ b,
        ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts := by
  -- `Y`: the darts of `Y₁` and of the paths of the spanning tree from `b₀` to the vertices of `V₁`
  -- and to the ends of the darts of `Y₁`, with their reverses.
  let V₀ : Set T.quotient.V := V₁ ∪ T.quotient.src '' Y₁ ∪ T.quotient.tgt '' Y₁
  let Z : Set T.quotient.E := Y₁ ∪ ⋃ b ∈ V₀, {y | y ∈ Path.darts T.quotient (D.tree.path b₀ b)}
  let Y : Set T.quotient.E := Z ∪ T.quotient.rev ⁻¹' Z
  have hZ : Z.Finite := hY₁.union <| ((hV₁.union (hY₁.image _)).union (hY₁.image _)).biUnion
    fun b _ => (Path.darts T.quotient _).finite_toSet
  have hpath {b : T.quotient.V} (hb : b ∈ V₀) :
      ∀ y ∈ Path.darts T.quotient (D.tree.path b₀ b), y ∈ Y ∧ y ∈ D.tree.darts :=
    fun y hy => ⟨Or.inl (Or.inr (Set.mem_biUnion hb hy)), D.tree.mem_of_mem_darts_path hy⟩
  refine ⟨Y, hZ.union (hZ.preimage T.quotient.rev_injective.injOn),
    fun y hy => Or.inl (Or.inl hy), ?_, ?_⟩
  · rintro y (hy | hy)
    · exact Or.inr (by simpa [Set.mem_preimage] using hy)
    · exact Or.inl hy
  rintro b (hb | ⟨y, ((hy | hy) | hy | hy), rfl⟩)
  · exact ⟨_, hpath (Or.inl (Or.inl hb))⟩
  · exact ⟨_, hpath (Or.inl (Or.inr ⟨y, hy, rfl⟩))⟩
  · obtain ⟨b, hb, hy⟩ := Set.mem_iUnion₂.mp hy
    obtain ⟨q, hq⟩ := exists_path_cons_of_mem_darts (hpath hb) hy
    exact ⟨q, fun z hz => hq z (by simp [hz])⟩
  · rw [← tgt_rev]
    exact ⟨_, hpath (Or.inr ⟨_, hy, rfl⟩)⟩
  · obtain ⟨b, hb, hy⟩ := Set.mem_iUnion₂.mp hy
    rw [← tgt_rev]
    obtain ⟨q, hq⟩ := exists_path_cons_of_mem_darts (hpath hb) hy
    exact ⟨_, hq⟩

variable (D) in
/-- Finitely many elements, each fixing a lifted vertex or attached to a dart of the quotient
graph, fix lifted vertices of a finite set or are attached to darts of a finite set. -/
private theorem exists_finite_vertices_darts_of_subset {U : Set G}
    (hU : U.Finite) (hUsub : U ⊆ (⋃ b, (stabilizer G (D.vertex b) : Set G)) ∪ Set.range D.twist) :
    ∃ V₁ : Set T.quotient.V, V₁.Finite ∧ ∃ Y₁ : Set T.quotient.E, Y₁.Finite ∧
      U ⊆ (⋃ b ∈ V₁, (stabilizer G (D.vertex b) : Set G)) ∪ D.twist '' Y₁ := by
  obtain ⟨I, hI, hUI⟩ := Set.finite_subset_iUnion hU (t := Sum.elim
    (fun b => (stabilizer G (D.vertex b) : Set G)) fun y => {D.twist y}) (by
      rw [Set.iUnion_sum]
      simpa [Set.iUnion_singleton_eq_range] using hUsub)
  refine ⟨_, hI.preimage Sum.inl_injective.injOn, _, hI.preimage Sum.inr_injective.injOn,
    fun u hu => ?_⟩
  obtain ⟨i, hi, hui⟩ := Set.mem_iUnion₂.mp (hUI hu)
  rcases i with b | y
  · exact Or.inl (Set.mem_iUnion₂.mpr ⟨b, hi, hui⟩)
  · exact Or.inr ⟨y, hi, (Set.mem_singleton_iff.mp hui).symm⟩

variable (D) in
/-- The stabilizer of a lifted vertex is generated by a finite set and the stabilizers of
finitely many lifted darts issuing from it, given a finite set `U` generating the group whose
elements fix lifted vertices or are attached to darts of the quotient graph. -/
private theorem exists_finite_stabilizer_vertex_eq_closure (b₀ : T.quotient.V) {U : Set G}
    (hU : U.Finite) (hUt : Subgroup.closure U = ⊤)
    (hUsub : U ⊆ (⋃ b, (stabilizer G (D.vertex b) : Set G)) ∪ Set.range D.twist) :
    ∃ F : Set G, F.Finite ∧ ∃ E₀ : Set T.E, E₀.Finite ∧ (∀ e ∈ E₀, T.src e = D.vertex b₀) ∧
      stabilizer G (D.vertex b₀) = Subgroup.closure (F ∪ ⋃ e ∈ E₀, (stabilizer G e : Set G)) := by
  obtain ⟨V₁, hV₁, Y₁, hY₁, hUV⟩ := D.exists_finite_vertices_darts_of_subset hU hUsub
  obtain ⟨Y, hYf, hY₁Y, hYrev, hreach⟩ := D.exists_finite_darts b₀ hV₁ hY₁
  let K : T.quotient.V → Subgroup G := fun b => Subgroup.closure ((U ∩ stabilizer G (D.vertex b)) ∪
    ⋃ y ∈ {y ∈ Y | T.quotient.src y = b}, (stabilizer G (D.dart y) : Set G))
  have hK (b : T.quotient.V) : K b ≤ stabilizer G (D.vertex b) := by
    refine (Subgroup.closure_le _).mpr
      (Set.union_subset Set.inter_subset_right (Set.iUnion₂_subset fun y hy => ?_))
    rw [← hy.2, ← D.src_dart]
    exact T.stabilizer_dart_le_stabilizer_src _
  let R : Set T.quotient.V := {b | ∃ p : T.quotient.Path b₀ b,
    ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts}
  -- The subgroups `K b` and the elements attached to `Y` contain `U`, so they generate.
  have hgen : Subgroup.closure ((⋃ b ∈ R, (K b : Set G)) ∪ D.twist '' Y) = ⊤ := by
    rw [eq_top_iff, ← hUt]
    refine Subgroup.closure_mono fun u hu => ?_
    rcases hUV hu with hu' | ⟨y, hy, rfl⟩
    · obtain ⟨b, hb, hub⟩ := Set.mem_iUnion₂.mp hu'
      exact Or.inl (Set.mem_iUnion₂.mpr ⟨b, hreach b (Or.inl hb),
        Subgroup.subset_closure (Or.inl ⟨hu, hub⟩)⟩)
    · exact Or.inr ⟨y, hY₁Y hy, rfl⟩
  have hK₀ := D.eq_stabilizer_vertex_of_closure_eq_top hYrev
    (fun y hy => hreach _ (Or.inr ⟨y, hy, rfl⟩)) (fun b hb => hb) K (fun b _ => hK b)
    (fun y hy g hg => Subgroup.subset_closure (Or.inr (Set.mem_iUnion₂.mpr ⟨y, ⟨hy, rfl⟩, hg⟩)))
    hgen (b := b₀) ⟨.nil, by simp⟩
  refine ⟨U ∩ stabilizer G (D.vertex b₀), hU.inter_of_left _,
    D.dart '' {y ∈ Y | T.quotient.src y = b₀}, (hYf.subset (Set.sep_subset _ _)).image _, ?_,
    hK₀.symm.trans ?_⟩
  · rintro _ ⟨y, hy, rfl⟩
    rw [src_dart, hy.2]
  · rw [Set.biUnion_image]

end Lifting

variable (T) in
/-- **Vertex stabilizers are finitely generated relative to the incident edge groups.** If a
finitely generated group acts on a tree, the stabilizer of a vertex `x` is generated by a finite
set together with the stabilizers of finitely many darts issuing from `x`. -/
theorem exists_finite_stabilizer_eq_closure [_root_.Group.FG G] (x : T.V) :
    ∃ F : Set G, F.Finite ∧ ∃ E₀ : Set T.E, E₀.Finite ∧ (∀ e ∈ E₀, T.src e = x) ∧
      stabilizer G x = Subgroup.closure (F ∪ ⋃ e ∈ E₀, (stabilizer G e : Set G)) := by
  obtain ⟨S⟩ := T.quotient.exists_spanningTree T.quotient_connected
  obtain ⟨D, -, hx⟩ := T.exists_lifting S x
  obtain ⟨U, hUsub, hU, hUt⟩ := (_root_.Group.fg_def.mp ‹_›).exists_finite_subset_le_closure
    D.closure_iUnion_stabilizer_union_range_twist.ge
  have := D.exists_finite_stabilizer_vertex_eq_closure (T.quotientMap.mapV x) hU
    (eq_top_iff.mpr hUt) hUsub
  rwa [hx] at this

variable (T) in
/-- If a finitely generated group acts on a tree and the stabilizers of the darts issuing from
a vertex are finitely generated, then the stabilizer of the vertex is finitely generated. -/
theorem fg_stabilizer_vertex [_root_.Group.FG G] (x : T.V)
    (h : ∀ e : T.E, T.src e = x → (stabilizer G e).FG) : (stabilizer G x).FG := by
  obtain ⟨F, hF, E₀, hfin, hE₀, hx⟩ := T.exists_finite_stabilizer_eq_closure x
  rw [hx, Subgroup.closure_union]
  refine Subgroup.FG.sup ((Subgroup.fg_iff _).mpr ⟨F, rfl, hF⟩) ?_
  simp only [Subgroup.closure_iUnion, Subgroup.closure_eq]
  exact Subgroup.FG.biSup hfin _ fun e he => h e (hE₀ e he)

end GTree

end TauCeti
