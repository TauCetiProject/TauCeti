module

public import TauCeti.GroupTheory.GTree.Lifting
public import Mathlib.GroupTheory.Finiteness
import TauCeti.GroupTheory.Finiteness

/-!
# Generators of the vertex stabilizers of a tree with a group action

Let a finitely generated group `G` act on a tree `T` without inversions and let `x` be a vertex.
The stabilizer of `x` is finitely generated relative to the incident edge groups: it is generated
by a finite set together with the stabilizers of finitely many darts issuing from `x`
(`GTree.exists_finite_stabilizer_eq_closure`). In particular, if the stabilizers of the darts
issuing from `x` are finitely generated, then so is the stabilizer of `x`
(`GTree.fg_stabilizer_vertex`). Neither statement needs the action to be minimal or the quotient
graph to be finite.

The proof uses a lifting `D` of the quotient graph `T / G` in which the image `b₀` of `x` lifts
to `x`. The group is generated by the stabilizers of the lifted vertices and the elements of the
lifting (`GTree.Lifting.iSup_stabilizer_sup_closure_range_twist`), so finitely many of these
generate it. They fix the lifted vertices of a finite set or are attached to the darts of a finite
set of darts of the quotient graph. Enlarge the latter to a finite set `Y` of darts, closed under
reversal, such that these vertices and the sources of the darts of `Y` are joined to `b₀` by
paths of the spanning tree with darts in `Y`. For a vertex `b` let `K b` be the subgroup
generated by the chosen elements fixing `D.vertex b` and the stabilizers of the lifts of the
darts of `Y` issuing from `b`. Then `K b` is the whole stabilizer of `D.vertex b`
(`GTree.Lifting.eq_stabilizer_vertex_of_closure_eq_top`); at `b₀` this is the first statement.

## Main declarations

* `TauCeti.GTree.exists_finite_stabilizer_eq_closure`: the vertex stabilizers of a tree of a
  finitely generated group are finitely generated relative to the incident edge groups.
* `TauCeti.GTree.fg_stabilizer_vertex`: a vertex with finitely generated incident edge groups
  has a finitely generated stabilizer.

## References

* V. Guirardel and G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §1.7,
  Definition 4.3 and Lemma 4.7.
* J.-P. Serre, *Trees*, Chapter I, §5.4.
-/

public section

universe u v w

namespace TauCeti

open SerreGraph _root_.MulAction

namespace GTree

variable {G : Type w} [Group G] {T : GTree.{u, v} G}

namespace Lifting

variable {D : T.Lifting}

/-! ### Finite generation relative to the incident edge groups -/

/-- A dart of a path from `b₀` inside the spanning tree and `Y` ends a path from `b₀` inside the
spanning tree and `Y`: the part of the path up to that dart. -/
private theorem exists_path_cons_of_mem_darts {Y : Set T.quotient.E} {b₀ c : T.quotient.V}
    {p : T.quotient.Path b₀ c} (hp : ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts)
    {y : T.quotient.E} (hy : y ∈ Path.darts T.quotient p) :
    ∃ q : T.quotient.Path b₀ (T.quotient.src y),
      ∀ z ∈ Path.darts T.quotient (q.cons (T.quotient.dart y)), z ∈ Y ∧ z ∈ D.tree.darts := by
  obtain ⟨q, r, rfl⟩ := Path.exists_eq_cons_comp_of_mem_darts _ p hy
  exact ⟨q, fun z hz => hp z (by simp at hz ⊢; tauto)⟩

variable (D) in
/-- Finitely many vertices and darts of the quotient graph lie in a finite set `Y` of darts,
closed under reversal, such that each of the given vertices and the source of each dart of `Y`
are joined to `b₀` by a path of the spanning tree with darts in `Y`. -/
private theorem exists_finite_darts (b₀ : T.quotient.V) {V₁ : Set T.quotient.V} (hV₁ : V₁.Finite)
    {Y₁ : Set T.quotient.E} (hY₁ : Y₁.Finite) :
    ∃ Y : Set T.quotient.E, Y.Finite ∧ Y₁ ⊆ Y ∧ (∀ y ∈ Y, T.quotient.rev y ∈ Y) ∧
      ∀ b ∈ V₁ ∪ T.quotient.src '' Y, ∃ p : T.quotient.Path b₀ b,
        ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts := by
  -- `Y`: the darts of `Y₁` and of the paths of the spanning tree from `b₀` to the vertices of `V₁`
  -- and to the ends of the darts of `Y₁`, with their reverses.
  let V₀ : Set T.quotient.V := V₁ ∪ T.quotient.src '' Y₁ ∪ T.quotient.tgt '' Y₁
  let Z : Set T.quotient.E := Y₁ ∪ ⋃ b ∈ V₀, {y | y ∈ Path.darts T.quotient (D.tree.path b₀ b)}
  let Y : Set T.quotient.E := Z ∪ T.quotient.rev ⁻¹' Z
  have hZ : Z.Finite := hY₁.union <| ((hV₁.union (hY₁.image _)).union (hY₁.image _)).biUnion
    fun b _ => (Path.darts T.quotient _).finite_toSet
  have hpath {b : T.quotient.V} (hb : b ∈ V₀) :
      ∀ y ∈ Path.darts T.quotient (D.tree.path b₀ b), y ∈ Y ∧ y ∈ D.tree.darts :=
    fun y hy => ⟨Or.inl (Or.inr (Set.mem_biUnion hb hy)), D.tree.mem_of_mem_darts_path hy⟩
  refine ⟨Y, hZ.union (hZ.preimage T.quotient.rev_injective.injOn),
    fun y hy => Or.inl (Or.inl hy), ?_, ?_⟩
  · rintro y (hy | hy)
    · exact Or.inr (by simpa [Set.mem_preimage] using hy)
    · exact Or.inl hy
  rintro b (hb | ⟨y, ((hy | hy) | hy | hy), rfl⟩)
  · exact ⟨_, hpath (Or.inl (Or.inl hb))⟩
  · exact ⟨_, hpath (Or.inl (Or.inr ⟨y, hy, rfl⟩))⟩
  · obtain ⟨b, hb, hy⟩ := Set.mem_iUnion₂.mp hy
    obtain ⟨q, hq⟩ := exists_path_cons_of_mem_darts (hpath hb) hy
    exact ⟨q, fun z hz => hq z (by simp [hz])⟩
  · rw [← tgt_rev]
    exact ⟨_, hpath (Or.inr ⟨_, hy, rfl⟩)⟩
  · obtain ⟨b, hb, hy⟩ := Set.mem_iUnion₂.mp hy
    rw [← tgt_rev]
    obtain ⟨q, hq⟩ := exists_path_cons_of_mem_darts (hpath hb) hy
    exact ⟨_, hq⟩

variable (D) in
/-- Finitely many elements, each fixing a lifted vertex or attached to a dart of the quotient
graph, fix lifted vertices of a finite set or are attached to darts of a finite set. -/
private theorem exists_finite_vertices_darts_of_subset {U : Set G}
    (hU : U.Finite) (hUsub : U ⊆ (⋃ b, (stabilizer G (D.vertex b) : Set G)) ∪ Set.range D.twist) :
    ∃ V₁ : Set T.quotient.V, V₁.Finite ∧ ∃ Y₁ : Set T.quotient.E, Y₁.Finite ∧
      U ⊆ (⋃ b ∈ V₁, (stabilizer G (D.vertex b) : Set G)) ∪ D.twist '' Y₁ := by
  obtain ⟨I, hI, hUI⟩ := Set.finite_subset_iUnion hU (t := Sum.elim
    (fun b => (stabilizer G (D.vertex b) : Set G)) fun y => {D.twist y}) (by
      rw [Set.iUnion_sum]
      simpa [Set.iUnion_singleton_eq_range] using hUsub)
  refine ⟨_, hI.preimage Sum.inl_injective.injOn, _, hI.preimage Sum.inr_injective.injOn,
    fun u hu => ?_⟩
  obtain ⟨i, hi, hui⟩ := Set.mem_iUnion₂.mp (hUI hu)
  rcases i with b | y
  · exact Or.inl (Set.mem_iUnion₂.mpr ⟨b, hi, hui⟩)
  · exact Or.inr ⟨y, hi, (Set.mem_singleton_iff.mp hui).symm⟩

variable (D) in
/-- The stabilizer of a lifted vertex is generated by a finite set and the stabilizers of
finitely many lifted darts issuing from it, given a finite set `U` generating the group whose
elements fix lifted vertices or are attached to darts of the quotient graph. -/
private theorem exists_finite_stabilizer_vertex_eq_closure (b₀ : T.quotient.V) {U : Set G}
    (hU : U.Finite) (hUt : Subgroup.closure U = ⊤)
    (hUsub : U ⊆ (⋃ b, (stabilizer G (D.vertex b) : Set G)) ∪ Set.range D.twist) :
    ∃ F : Set G, F.Finite ∧ ∃ E₀ : Set T.E, E₀.Finite ∧ (∀ e ∈ E₀, T.src e = D.vertex b₀) ∧
      stabilizer G (D.vertex b₀) = Subgroup.closure (F ∪ ⋃ e ∈ E₀, (stabilizer G e : Set G)) := by
  obtain ⟨V₁, hV₁, Y₁, hY₁, hUV⟩ := D.exists_finite_vertices_darts_of_subset hU hUsub
  obtain ⟨Y, hYf, hY₁Y, hYrev, hreach⟩ := D.exists_finite_darts b₀ hV₁ hY₁
  let K : T.quotient.V → Subgroup G := fun b => Subgroup.closure ((U ∩ stabilizer G (D.vertex b)) ∪
    ⋃ y ∈ {y ∈ Y | T.quotient.src y = b}, (stabilizer G (D.dart y) : Set G))
  have hK (b : T.quotient.V) : K b ≤ stabilizer G (D.vertex b) := by
    refine (Subgroup.closure_le _).mpr
      (Set.union_subset Set.inter_subset_right (Set.iUnion₂_subset fun y hy => ?_))
    rw [← hy.2, ← D.src_dart]
    exact T.stabilizer_dart_le_stabilizer_src _
  let R : Set T.quotient.V := {b | ∃ p : T.quotient.Path b₀ b,
    ∀ y ∈ Path.darts T.quotient p, y ∈ Y ∧ y ∈ D.tree.darts}
  -- The subgroups `K b` and the elements attached to `Y` contain `U`, so they generate.
  have hgen : Subgroup.closure ((⋃ b ∈ R, (K b : Set G)) ∪ D.twist '' Y) = ⊤ := by
    rw [eq_top_iff, ← hUt]
    refine Subgroup.closure_mono fun u hu => ?_
    rcases hUV hu with hu' | ⟨y, hy, rfl⟩
    · obtain ⟨b, hb, hub⟩ := Set.mem_iUnion₂.mp hu'
      exact Or.inl (Set.mem_iUnion₂.mpr ⟨b, hreach b (Or.inl hb),
        Subgroup.subset_closure (Or.inl ⟨hu, hub⟩)⟩)
    · exact Or.inr ⟨y, hY₁Y hy, rfl⟩
  have hK₀ := D.eq_stabilizer_vertex_of_closure_eq_top hYrev
    (fun y hy => hreach _ (Or.inr ⟨y, hy, rfl⟩)) (fun b hb => hb) K (fun b _ => hK b)
    (fun y hy g hg => Subgroup.subset_closure (Or.inr (Set.mem_iUnion₂.mpr ⟨y, ⟨hy, rfl⟩, hg⟩)))
    hgen (b := b₀) ⟨.nil, by simp⟩
  refine ⟨U ∩ stabilizer G (D.vertex b₀), hU.inter_of_left _,
    D.dart '' {y ∈ Y | T.quotient.src y = b₀}, (hYf.subset (Set.sep_subset _ _)).image _, ?_,
    hK₀.symm.trans ?_⟩
  · rintro _ ⟨y, hy, rfl⟩
    rw [src_dart, hy.2]
  · rw [Set.biUnion_image]

end Lifting

variable (T) in
/-- **Vertex stabilizers are finitely generated relative to the incident edge groups.** If a
finitely generated group acts on a tree, the stabilizer of a vertex `x` is generated by a finite
set together with the stabilizers of finitely many darts issuing from `x`. -/
theorem exists_finite_stabilizer_eq_closure [_root_.Group.FG G] (x : T.V) :
    ∃ F : Set G, F.Finite ∧ ∃ E₀ : Set T.E, E₀.Finite ∧ (∀ e ∈ E₀, T.src e = x) ∧
      stabilizer G x = Subgroup.closure (F ∪ ⋃ e ∈ E₀, (stabilizer G e : Set G)) := by
  obtain ⟨S⟩ := T.quotient.exists_spanningTree T.quotient_connected
  obtain ⟨D, -, hx⟩ := T.exists_lifting S x
  have hgen : Subgroup.closure ((⋃ b, (stabilizer G (D.vertex b) : Set G)) ∪ Set.range D.twist) =
      ⊤ := by
    simpa [Subgroup.closure_union, Subgroup.closure_iUnion] using
      D.iSup_stabilizer_sup_closure_range_twist
  obtain ⟨U, hUsub, hU, hUt⟩ := (_root_.Group.fg_def.mp ‹_›).exists_finite_subset_le_closure
    hgen.ge
  have := D.exists_finite_stabilizer_vertex_eq_closure (T.quotientMap.mapV x) hU
    (eq_top_iff.mpr hUt) hUsub
  rwa [hx] at this

variable (T) in
/-- If a finitely generated group acts on a tree and the stabilizers of the darts issuing from
a vertex are finitely generated, then the stabilizer of the vertex is finitely generated. -/
theorem fg_stabilizer_vertex [_root_.Group.FG G] (x : T.V)
    (h : ∀ e : T.E, T.src e = x → (stabilizer G e).FG) : (stabilizer G x).FG := by
  obtain ⟨F, hF, E₀, hfin, hE₀, hx⟩ := T.exists_finite_stabilizer_eq_closure x
  rw [hx, Subgroup.closure_union]
  refine Subgroup.FG.sup ((Subgroup.fg_iff _).mpr ⟨F, rfl, hF⟩) ?_
  simp only [Subgroup.closure_iUnion, Subgroup.closure_eq]
  exact Subgroup.FG.biSup hfin _ fun e he => h e (hE₀ e he)

end GTree

end TauCeti
