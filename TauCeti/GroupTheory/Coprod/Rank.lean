module

public import Mathlib.GroupTheory.Rank
public import TauCeti.GroupTheory.Coprod.Finiteness

/-!
# The rank of a free product of two groups

The free product `A ∗ B` of two finitely generated groups is generated by the images of a
generating set of `A` and of a generating set of `B`, so its rank is at most `rank A + rank B`.

## Main statements

* `Monoid.Coprod.rank_le_add`: `Group.rank (A ∗ B) ≤ Group.rank A + Group.rank B`.

## References

* I. Kapovich, R. Weidmann, A. Myasnikov, *Foldings, graphs of groups and the membership problem*,
  Internat. J. Algebra Comput. 15 (2005), §6, proof of Theorem 6.2.
-/

public section

namespace Monoid.Coprod

/-- The rank of a free product of two finitely generated groups is at most the sum of their
ranks. Grushko's theorem says that equality holds. -/
theorem rank_le_add (A B : Type*) [Group A] [Group B] [Group.FG A] [Group.FG B] :
    Group.rank (A ∗ B) ≤ Group.rank A + Group.rank B := by
  classical
  obtain ⟨S, hS, hSc⟩ := Group.rank_spec A
  obtain ⟨T, hT, hTc⟩ := Group.rank_spec B
  -- the images of minimal generating sets of the factors generate the free product
  refine (Group.rank_le (S := S.image inl ∪ T.image inr) ?_).trans ?_
  · simp [Subgroup.closure_union, ← MonoidHom.map_closure, hSc, hTc, ← MonoidHom.range_eq_map]
  · rw [← hS, ← hT]
    exact (Finset.card_union_le _ _).trans (add_le_add Finset.card_image_le Finset.card_image_le)

end Monoid.Coprod
