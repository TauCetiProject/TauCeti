module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.GroupTheory.IsPerfect
import TauCeti.GroupTheory.Solvable

/-!
# Normal generators of perfect groups

The product of two generators normally generates a perfect group. Its normal closure together
with the cyclic subgroup generated by the first generator is the whole group, and in a perfect
group a normal subgroup supplemented by a solvable subgroup is everything
(`Subgroup.Normal.eq_top_of_self_sup_eq_top_of_isSolvable`).

This supplies the normal-generation hypothesis of
`TauCeti.isSimpleGroup_of_normalClosure_eq_top_of_prime_dvd_card`.
-/

public section

namespace Subgroup

variable {G : Type*} [Group G] [Group.IsPerfect G]

/-- The product of two generators normally generates a perfect group. -/
theorem normalClosure_singleton_mul_eq_top (a b : G) (hgen : closure ({a, b} : Set G) = ⊤) :
    normalClosure ({a * b} : Set G) = ⊤ := by
  have hsup : normalClosure ({a * b} : Set G) ⊔ zpowers a = ⊤ := by
    rw [eq_top_iff, ← hgen, closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    refine ⟨mem_sup_right (mem_zpowers a), ?_⟩
    simpa using mul_mem (mem_sup_right (inv_mem (mem_zpowers a)))
      (mem_sup_left (subset_normalClosure (Set.mem_singleton (a * b))))
  exact Normal.eq_top_of_self_sup_eq_top_of_isSolvable hsup

end Subgroup
