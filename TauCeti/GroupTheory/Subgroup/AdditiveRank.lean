module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.Algebra.Module.Submodule.Lattice
public import Mathlib.LinearAlgebra.Dimension.Basic

import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.Dimension.Localization

/-!
# The rank over `ℤ` of subgroups of a commutative group

For a commutative group `G`, `Module.rank ℤ (Additive G)` is the torsion-free rank of `G`: the
supremum of the cardinalities of multiplicatively independent families in `G`. It is the rank in
which finite-rank multiplicative groups are measured, for instance in unit equations, where groups
need not be finitely generated.

This file identifies the rank of a subgroup `H` with that of the corresponding `ℤ`-submodule of
`Additive G`, and deduces that the rank does not increase under injective homomorphisms or under
taking images, that it is modular
on joins and meets of subgroups, and that a subgroup generated by a set `s` has rank at most `#s`.
Consequently, adjoining one element to a subgroup raises its rank by at most one.

## Main statements

* `MonoidHom.lift_rank_additive_le_of_injective`, `MonoidHom.rank_additive_le_of_injective`: the
  source of an injective homomorphism has rank at most that of its target.
* `Subgroup.rank_additive_eq_rank_toIntSubmodule`: the rank of `H` is the rank of the
  `ℤ`-submodule `H.toAddSubgroup.toIntSubmodule` of `Additive G`.
* `Subgroup.lift_rank_additive_map_le`, `Subgroup.rank_additive_map_le`: the image of a subgroup
  has rank at most that of the subgroup.
* `Subgroup.rank_additive_sup_add_rank_additive_inf`: `rank (H ⊔ K) + rank (H ⊓ K) =
  rank H + rank K`, and its consequence `Subgroup.rank_additive_sup_le`.
* `Subgroup.rank_additive_closure_le`: `rank (closure s) ≤ #s`, and its consequence
  `Subgroup.rank_additive_zpowers_le_one`.
-/

public section

universe u v

open Cardinal

variable {G : Type u} [CommGroup G]

namespace MonoidHom

/-- The source of an injective homomorphism of commutative groups has rank over `ℤ` at most that
of its target. -/
theorem lift_rank_additive_le_of_injective {N : Type v} [CommGroup N] (f : G →* N)
    (hf : Function.Injective f) :
    lift.{v} (Module.rank ℤ (Additive G)) ≤ lift.{u} (Module.rank ℤ (Additive N)) := by
  refine f.toAdditive.toIntLinearMap.lift_rank_le_of_injective ?_
  rw [AddMonoidHom.coe_toIntLinearMap, MonoidHom.coe_toAdditive]
  exact Additive.ofMul.injective.comp (hf.comp Additive.toMul.injective)

/-- The source of an injective homomorphism of commutative groups has rank over `ℤ` at most that
of its target. -/
theorem rank_additive_le_of_injective {N : Type u} [CommGroup N] (f : G →* N)
    (hf : Function.Injective f) : Module.rank ℤ (Additive G) ≤ Module.rank ℤ (Additive N) := by
  simpa using f.lift_rank_additive_le_of_injective hf

end MonoidHom

namespace Subgroup

/-- The rank over `ℤ` of a subgroup `H` of a commutative group `G` is the rank of the corresponding
`ℤ`-submodule of `Additive G`. -/
theorem rank_additive_eq_rank_toIntSubmodule (H : Subgroup G) :
    Module.rank ℤ (Additive H) = Module.rank ℤ H.toAddSubgroup.toIntSubmodule := by
  have h :
      LinearMap.range H.subtype.toAdditive.toIntLinearMap = H.toAddSubgroup.toIntSubmodule := by
    rw [AddMonoidHom.coe_toIntLinearMap_range, MonoidHom.coe_toAdditive_range, H.range_subtype]
  rw [← h, rank_range_of_injective _
    (Additive.ofMul.injective.comp (H.subtype_injective.comp Additive.toMul.injective))]

/-- The image of a subgroup under a homomorphism of commutative groups has rank over `ℤ` at most
that of the subgroup. -/
theorem lift_rank_additive_map_le {N : Type v} [CommGroup N] (H : Subgroup G) (f : G →* N) :
    lift.{u} (Module.rank ℤ (Additive (H.map f))) ≤ lift.{v} (Module.rank ℤ (Additive H)) := by
  refine (f.subgroupMap H).toAdditive.toIntLinearMap.lift_rank_le_of_surjective ?_
  rw [AddMonoidHom.coe_toIntLinearMap, MonoidHom.coe_toAdditive]
  exact Additive.ofMul.surjective.comp ((f.subgroupMap_surjective H).comp Additive.toMul.surjective)

/-- The image of a subgroup under a homomorphism of commutative groups has rank over `ℤ` at most
that of the subgroup. -/
theorem rank_additive_map_le {N : Type u} [CommGroup N] (H : Subgroup G) (f : G →* N) :
    Module.rank ℤ (Additive (H.map f)) ≤ Module.rank ℤ (Additive H) := by
  simpa using H.lift_rank_additive_map_le f

/-- The rank over `ℤ` is modular on subgroups of a commutative group. -/
theorem rank_additive_sup_add_rank_additive_inf (H K : Subgroup G) :
    Module.rank ℤ (Additive ↥(H ⊔ K)) + Module.rank ℤ (Additive ↥(H ⊓ K)) =
      Module.rank ℤ (Additive H) + Module.rank ℤ (Additive K) := by
  have hsup : (H ⊔ K).toAddSubgroup.toIntSubmodule =
      H.toAddSubgroup.toIntSubmodule ⊔ K.toAddSubgroup.toIntSubmodule := by
    rw [OrderIso.map_sup, OrderIso.map_sup]
  have hinf : (H ⊓ K).toAddSubgroup.toIntSubmodule =
      H.toAddSubgroup.toIntSubmodule ⊓ K.toAddSubgroup.toIntSubmodule := by
    rw [OrderIso.map_inf, OrderIso.map_inf]
  rw [rank_additive_eq_rank_toIntSubmodule, rank_additive_eq_rank_toIntSubmodule,
    rank_additive_eq_rank_toIntSubmodule, rank_additive_eq_rank_toIntSubmodule, hsup, hinf]
  exact Submodule.rank_sup_add_rank_inf_eq _ _

/-- The rank over `ℤ` is subadditive on joins of subgroups of a commutative group. -/
theorem rank_additive_sup_le (H K : Subgroup G) :
    Module.rank ℤ (Additive ↥(H ⊔ K)) ≤
      Module.rank ℤ (Additive H) + Module.rank ℤ (Additive K) := by
  rw [← rank_additive_sup_add_rank_additive_inf]
  exact self_le_add_right _ _

/-- The subgroup of a commutative group generated by a set `s` has rank at most `#s` over `ℤ`. -/
theorem rank_additive_closure_le (s : Set G) : Module.rank ℤ (Additive (closure s)) ≤ #s := by
  rw [rank_additive_eq_rank_toIntSubmodule, toAddSubgroup_closure,
    ← Submodule.span_int_eq_addSubgroupClosure, Submodule.toAddSubgroup_toIntSubmodule,
    ← mk_preimage_equiv Additive.toMul s]
  exact rank_span_le _

/-- A cyclic subgroup of a commutative group has rank at most one over `ℤ`. -/
theorem rank_additive_zpowers_le_one (g : G) : Module.rank ℤ (Additive (zpowers g)) ≤ 1 := by
  rw [zpowers_eq_closure]
  simpa using rank_additive_closure_le {g}

end Subgroup
