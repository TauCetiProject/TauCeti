/-- Shorthand for the multiplicative copy of `ℤ²`. -/
private abbrev Z2 : Type := Multiplicative (Fin 2 → ℤ)

/-- Shorthand for the Pontryagin dual torus of `ℤ²`. -/
private abbrev T2 : Type := PontryaginDual Z2

private noncomputable local instance : MeasurableSpace T2 := borel T2
private local instance : BorelSpace T2 := ⟨rfl⟩
private noncomputable local instance : MeasurableSpace (ℙ ℝ (Fin 2 → ℝ)) := borel (ℙ ℝ (Fin 2 → ℝ))
private local instance : BorelSpace (ℙ ℝ (Fin 2 → ℝ)) := ⟨rfl⟩

/-- The dual automorphism of `T2` induced by `k ∈ SL₂(ℤ)` acting on `ℤ²`. -/
private noncomputable def dualAct (k : SL(2, ℤ)) : T2 →ₜ* T2 :=
  PontryaginDual.map ⟨(slTwoAction k).toMonoidHom, continuous_of_discreteTopology⟩

private theorem dualAct_apply (k : SL(2, ℤ)) (χ : T2) (v : Z2) :
    dualAct k χ v = χ (slTwoAction k v) :=
  rfl

private theorem dualAct_mul_inv_cancel (k : SL(2, ℤ)) (χ : T2) :
    dualAct k⁻¹ (dualAct k χ) = χ := by
  ext v
  simp [dualAct_apply]

/-- Coordinates of a character of `ℤ²` in `[-1/2, 1/2)²`, read on the two standard basis vectors. -/
private noncomputable def torusCoord (χ : T2) (i : Fin 2) : ℝ :=
  (AddCircle.equivIco (1 : ℝ) (-1 / 2)
    ((AddCircle.homeomorphCircle one_ne_zero).symm (χ (ofAdd (Pi.single i 1)))) : ℝ)

private theorem measurable_torusCoord : Measurable torusCoord := by
  refine measurable_pi_iff.mpr fun i ↦ ?_
  have hc : Continuous fun χ : T2 ↦
      (AddCircle.homeomorphCircle one_ne_zero).symm (χ (ofAdd (Pi.single i 1))) :=
    (AddCircle.homeomorphCircle one_ne_zero).symm.continuous.comp
      (continuous_eval_const (F := Z2 →ₜ* Circle) (ofAdd (Pi.single i 1)))
  exact measurable_subtype_coe.comp <|
    (AddCircle.measurableEquivIco 1 (-1 / 2)).measurable.comp hc.measurable

private theorem measurable_abs_torusCoord_apply (i : Fin 2) :
    Measurable fun χ ↦ |torusCoord χ i| :=
  continuous_abs.measurable.comp (measurable_pi_iff.mp measurable_torusCoord i)

private theorem torusCoord_mem_Ico (χ : T2) (i : Fin 2) :
    torusCoord χ i ∈ Set.Ico (-1 / 2 : ℝ) (-1 / 2 + 1) :=
  (AddCircle.equivIco (1 : ℝ) (-1 / 2) _).2

private theorem abs_torusCoord_le_half (χ : T2) (i : Fin 2) : |torusCoord χ i| ≤ 1 / 2 := by
  obtain ⟨h1, h2⟩ := torusCoord_mem_Ico χ i
  exact abs_le.mpr ⟨by linarith, by linarith⟩

private theorem toCircle_torusCoord (χ : T2) (i : Fin 2) :
    AddCircle.toCircle ((torusCoord χ i : ℝ) : UnitAddCircle) = χ (ofAdd (Pi.single i 1)) := by
  rw [torusCoord, AddCircle.coe_equivIco, ← AddCircle.homeomorphCircle_apply one_ne_zero,
    Homeomorph.apply_symm_apply]

/-- Every character of `ℤ²` is given by the inner product with `torusCoord χ` modulo `ℤ`. -/
private theorem apply_ofAdd_eq_toCircle (χ : T2) (m : Fin 2 → ℤ) :
    χ (ofAdd m) = AddCircle.toCircle
      (((m 0 : ℝ) * torusCoord χ 0 + (m 1 : ℝ) * torusCoord χ 1 : ℝ) : UnitAddCircle) := by
  have hm : m = m 0 • Pi.single 0 1 + m 1 • Pi.single 1 1 := by
    ext j
    fin_cases j <;> simp
  conv_lhs => rw [hm, ofAdd_add, map_mul, ofAdd_zsmul, ofAdd_zsmul, map_zpow, map_zpow,
    ← toCircle_torusCoord χ 0, ← toCircle_torusCoord χ 1]
  have hz (n : ℤ) (t : ℝ) :
      AddCircle.toCircle (t : UnitAddCircle) ^ n =
        AddCircle.toCircle (((n : ℝ) * t : ℝ) : UnitAddCircle) := by
    rw [← AddCircle.toCircle_zsmul, ← QuotientAddGroup.mk_zsmul, zsmul_eq_mul]
  rw [hz, hz, ← AddCircle.toCircle_add, ← QuotientAddGroup.mk_add]

private theorem torusCoord_eq_zero_iff (χ : T2) : torusCoord χ = 0 ↔ χ = 1 := by
  refine ⟨fun h ↦ PontryaginDual.ext fun v ↦ ?_, ?_⟩
  · rw [← ofAdd_toAdd v, apply_ofAdd_eq_toCircle, h]
    simp
  · rintro rfl
    ext i
    have hmem : (0 : ℝ) ∈ Set.Ico (-1 / 2 : ℝ) (-1 / 2 + 1) := ⟨by norm_num, by norm_num⟩
    have h0 := AddCircle.equivIco_coe_of_mem (p := (1 : ℝ)) (a := -1 / 2) hmem
    simpa [torusCoord, AddCircle.homeomorphCircle_symm_one] using h0

/-- Sum of absolute values of entries of an `SL₂(ℤ)` matrix, cast to `ℝ`. -/
private def entryAbsSum (k : SL(2, ℤ)) : ℝ :=
  ((|(k : Matrix (Fin 2) (Fin 2) ℤ) 0 0| + |(k : Matrix (Fin 2) (Fin 2) ℤ) 1 0| +
    |(k : Matrix (Fin 2) (Fin 2) ℤ) 0 1| + |(k : Matrix (Fin 2) (Fin 2) ℤ) 1 1| : ℤ) : ℝ)

private theorem entryAbsSum_nonneg (k : SL(2, ℤ)) : 0 ≤ entryAbsSum k := by
  unfold entryAbsSum
  push_cast
  positivity

/-- Near `1`, the dual action of `k ∈ SL₂(ℤ)` acts linearly on `torusCoord` by `kᵀ`. -/
private theorem torusCoord_dualAct (k : SL(2, ℤ)) {δ : ℝ} (hδ0 : 0 < δ)
    (hδ : entryAbsSum k * δ + δ ≤ 1 / 2) {χ : T2} (hχ : ∀ j, |torusCoord χ j| < δ) :
    torusCoord (dualAct k χ) =
      SpecialLinearGroup.map (Int.castRingHom ℝ) k.transpose • torusCoord χ := by
  rw [Matrix.SpecialLinearGroup.smul_def, Matrix.smul_eq_mulVec]
  ext i
  set y : ℝ := (k 0 i : ℝ) * torusCoord χ 0 + (k 1 i : ℝ) * torusCoord χ 1
  have hval : dualAct k χ (ofAdd (Pi.single i 1)) = AddCircle.toCircle (y : UnitAddCircle) := by
    have hmul : toAdd (slTwoAction k (ofAdd (Pi.single i 1))) = ![k 0 i, k 1 i] := by
      ext j
      rw [slTwoAction_apply_eq_mulVec]
      fin_cases j <;> fin_cases i <;> simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two]
    rw [dualAct_apply, ← ofAdd_toAdd (slTwoAction k _), hmul, apply_ofAdd_eq_toCircle]
    simp [y]
  have hy_abs : |y| < 1 / 2 := by
    have hk_le : |(k 0 i : ℝ)| + |(k 1 i : ℝ)| ≤ entryAbsSum k := by
      unfold entryAbsSum; push_cast
      fin_cases i <;> dsimp <;> linarith [abs_nonneg (((k : Matrix (Fin 2) (Fin 2) ℤ) 0 0 : ℤ) : ℝ),
        abs_nonneg (((k : Matrix (Fin 2) (Fin 2) ℤ) 1 0 : ℤ) : ℝ),
        abs_nonneg (((k : Matrix (Fin 2) (Fin 2) ℤ) 0 1 : ℤ) : ℝ),
        abs_nonneg (((k : Matrix (Fin 2) (Fin 2) ℤ) 1 1 : ℤ) : ℝ)]
    calc |y| ≤ |(k 0 i : ℝ) * torusCoord χ 0| + |(k 1 i : ℝ) * torusCoord χ 1| := abs_add_le _ _
      _ = |(k 0 i : ℝ)| * |torusCoord χ 0| + |(k 1 i : ℝ)| * |torusCoord χ 1| := by
          rw [abs_mul, abs_mul]
      _ ≤ (|(k 0 i : ℝ)| + |(k 1 i : ℝ)|) * δ := by
          nlinarith [abs_nonneg (k 0 i : ℝ), abs_nonneg (k 1 i : ℝ), (hχ 0).le, (hχ 1).le]
      _ < 1 / 2 := by nlinarith
  have hy_mem : y ∈ Set.Ico (-1 / 2 : ℝ) (-1 / 2 + 1) := by
    rw [abs_lt] at hy_abs
    exact ⟨by linarith [hy_abs.1], by linarith [hy_abs.2]⟩
  have heq : (AddCircle.homeomorphCircle one_ne_zero).symm (dualAct k χ (ofAdd (Pi.single i 1))) =
      (y : UnitAddCircle) := by
    rw [hval, Homeomorph.symm_apply_eq, AddCircle.homeomorphCircle_apply]
  rw [torusCoord, heq, AddCircle.equivIco_coe_of_mem hy_mem]
  fin_cases i <;> simp [y, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- Measurable map sending a nontrivial character in `[-1/2, 1/2)²` to the line spanned by its
coordinates in `ℙ ℝ (Fin 2 → ℝ)`. -/
private noncomputable def torusToProj (χ : T2) : ℙ ℝ (Fin 2 → ℝ) :=
  open scoped Classical in
  if h : torusCoord χ ≠ 0 then Projectivization.mk ℝ (torusCoord χ) h
  else Projectivization.mk ℝ ![1, 0] (by simp)

private theorem measurable_torusToProj : Measurable torusToProj := by
  classical
  have hs : MeasurableSet {χ : T2 | torusCoord χ ≠ 0} :=
    measurable_torusCoord isOpen_compl_singleton.measurableSet
  refine Measurable.dite (s := {χ : T2 | torusCoord χ ≠ 0})
    (f := fun x : {χ : T2 | torusCoord χ ≠ 0} ↦ Projectivization.mk ℝ (torusCoord x.1) x.2)
    (g := fun _ ↦ Projectivization.mk ℝ ![1, 0] (by simp)) ?_ measurable_const hs
  have hsub : Measurable fun x : {χ : T2 | torusCoord χ ≠ 0} ↦
      (⟨torusCoord x.1, x.2⟩ : {v : Fin 2 → ℝ // v ≠ 0}) :=
    (measurable_torusCoord.comp measurable_subtype_coe).subtype_mk
  exact Projectivization.continuous_mk'.measurable.comp hsub

/-- On punctured neighborhoods of `1` in `T2`, `torusToProj` intertwines `dualAct k⁻¹` with the
projective action of `sl2zToPSL2R (inverseTranspose k)`. -/
private theorem torusToProj_dualAct_inv (k : SL(2, ℤ)) {δ : ℝ} (hδ0 : 0 < δ)
    (hδ : entryAbsSum k⁻¹ * δ + δ ≤ 1 / 2)
    {χ : T2} (hχ1 : χ ≠ 1) (hχ : ∀ j, |torusCoord χ j| < δ) :
    torusToProj (dualAct k⁻¹ χ) = sl2zToPSL2R (SpecialLinearGroup.inverseTranspose k) •
      torusToProj χ := by
  have hne : torusCoord χ ≠ 0 := mt (torusCoord_eq_zero_iff χ).mp hχ1
  have hne' : torusCoord (dualAct k⁻¹ χ) ≠ 0 := by
    rw [Ne, torusCoord_eq_zero_iff]
    rintro h
    exact hχ1 (by simpa [h] using (dualAct_mul_inv_cancel k⁻¹ χ).symm)
  have hM : torusCoord (dualAct k⁻¹ χ) =
      SpecialLinearGroup.map (Int.castRingHom ℝ) (SpecialLinearGroup.inverseTranspose k) •
        torusCoord χ := by
    rw [SpecialLinearGroup.inverseTranspose_apply]
    exact torusCoord_dualAct k⁻¹ hδ0 hδ hχ
  unfold torusToProj
  rw [dite_eq_left_of_eq_true (eq_true hne'), dite_eq_left_of_eq_true (eq_true hne),
    sl2zToPSL2R_apply, ProjectiveSpecialLinearGroup.smul_proj_mk, Projectivization.smul_mk]
  exact (Projectivization.mk_eq_mk_iff' ℝ _ _ _ _).mpr ⟨1, by rw [one_smul, hM]⟩

/-- Perturbation bound for integrals against diagonal measures of a projection-valued measure. -/
private theorem norm_integral_diag_sub_le {X H : Type*} [MeasurableSpace X]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (P : ProjValMeasure X H) (f : X → ℝ) (hf : Measurable f) {M : ℝ} (hM : 0 ≤ M)
    (hfM : ∀ x, |f x| ≤ M) {ζ ξ : H} (hζ : ‖ζ‖ = 1) (hξ : ‖ξ‖ = 1) :
    |∫ x, f x ∂(P.diag ζ) - ∫ x, f x ∂(P.diag ξ)| ≤ 2 * M * ‖ζ - ξ‖ := by
  let g : BoundedBorelFunction X := .ofFunction (fun x ↦ (f x : ℂ))
    (Complex.measurable_ofReal.comp hf) ⟨M, hM, fun x ↦ by simpa using hfM x⟩
  have hT : ‖P.integral g‖ ≤ M := P.norm_integral_le hM fun x ↦ by simpa [g] using hfM x
  have hint (v : H) : ((∫ x, f x ∂(P.diag v) : ℝ) : ℂ) = ⟪v, P.integral g v⟫_ℂ := by
    simpa [g, ← integral_complex_ofReal] using P.integral_diag_eq_inner_integral g v
  have hdiff : ((∫ x, f x ∂(P.diag ζ) - ∫ x, f x ∂(P.diag ξ) : ℝ) : ℂ) =
      ⟪ζ - ξ, P.integral g ζ⟫_ℂ + ⟪ξ, P.integral g (ζ - ξ)⟫_ℂ := by
    rw [Complex.ofReal_sub, hint ζ, hint ξ, inner_sub_left, map_sub, inner_sub_right]
    ring
  have h1 : ‖⟪ζ - ξ, P.integral g ζ⟫_ℂ‖ ≤ M * ‖ζ - ξ‖ := by
    calc ‖⟪ζ - ξ, P.integral g ζ⟫_ℂ‖ ≤ ‖ζ - ξ‖ * ‖P.integral g ζ‖ := norm_inner_le_norm _ _
      _ ≤ ‖ζ - ξ‖ * (‖P.integral g‖ * ‖ζ‖) :=
          mul_le_mul_of_nonneg_left ((P.integral g).le_opNorm ζ) (norm_nonneg _)
      _ ≤ M * ‖ζ - ξ‖ := by
          rw [hζ, mul_one, mul_comm]
          exact mul_le_mul_of_nonneg_right hT (norm_nonneg _)
  have h2 : ‖⟪ξ, P.integral g (ζ - ξ)⟫_ℂ‖ ≤ M * ‖ζ - ξ‖ := by
    calc ‖⟪ξ, P.integral g (ζ - ξ)⟫_ℂ‖ ≤ ‖ξ‖ * ‖P.integral g (ζ - ξ)‖ := norm_inner_le_norm _ _
      _ ≤ 1 * (‖P.integral g‖ * ‖ζ - ξ‖) := by
          rw [hξ]; exact mul_le_mul_of_nonneg_left ((P.integral g).le_opNorm _) zero_le_one
      _ ≤ M * ‖ζ - ξ‖ := by rw [one_mul]; exact mul_le_mul_of_nonneg_right hT (norm_nonneg _)
  have hc := (norm_add_le _ _).trans (add_le_add h1 h2)
  rw [← hdiff, Complex.norm_real, Real.norm_eq_abs] at hc
  linarith

private theorem norm_toCircle_sub_one_sq (t : ℝ) :
    ‖(AddCircle.toCircle (t : UnitAddCircle) : ℂ) - 1‖ ^ 2 = 4 * Real.sin (Real.pi * t) ^ 2 := by
  rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
    Complex.one_re, Complex.one_im, AddCircle.re_toCircle_coe 1 t, AddCircle.im_toCircle_coe 1 t]
  have hangle : 2 * Real.pi / 1 * t = 2 * (Real.pi * t) := by ring
  rw [hangle, sub_zero, ← sq, ← sq, Real.cos_two_mul, Real.sin_two_mul]
  linear_combination 4 * (Real.cos (Real.pi * t) ^ 2 - 1) * Real.cos_sq_add_sin_sq (Real.pi * t)

/-- Spectral tail bound: almost invariance on the `i`-th generator of `ℤ²` bounds the diagonal
spectral mass outside `(-δ, δ)` in the `i`-th torus coordinate. -/
private theorem diag_abs_torusCoord_ge_le
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {π : ContRepresentation ℂ Z2 H} (hπ : π.IsUnitary) (ξ : H) (i : Fin 2)
    {δ : ℝ} (hδ0 : 0 ≤ δ) :
    4 * Real.sin (Real.pi * δ) ^ 2 *
        ((π.spectralPVM hπ).diag ξ).real {χ : T2 | δ ≤ |torusCoord χ i|} ≤
      ‖π (ofAdd (Pi.single i 1)) ξ - ξ‖ ^ 2 := by
  set P := π.spectralPVM hπ
  let e : BoundedBorelFunction T2 :=
    BoundedBorelFunction.ofContinuousMap
      (PontryaginDual.evalBoundedContinuous (Pi.single i 1)).toContinuousMap
  have hvec : π (ofAdd (Pi.single i 1)) ξ - ξ = P.integral (e - 1) ξ := by
    rw [map_sub, map_one, integral_spectralPVM_evalBoundedContinuous, sub_apply, one_apply_eq_self]
  set S : Set T2 := {χ : T2 | δ ≤ |torusCoord χ i|}
  have hS : MeasurableSet S := measurableSet_le measurable_const (measurable_abs_torusCoord_apply i)
  have hlow (χ : T2) (hχ : χ ∈ S) : 4 * Real.sin (Real.pi * δ) ^ 2 ≤ ‖(e - 1) χ‖ ^ 2 := by
    have he : (e - 1) χ = (AddCircle.toCircle ((torusCoord χ i : ℝ) : UnitAddCircle) : ℂ) - 1 := by
      simp [e, ← toCircle_torusCoord]
    rw [he, norm_toCircle_sub_one_sq]
    have hsin_abs : Real.sin (Real.pi * |torusCoord χ i|) ^ 2 =
        Real.sin (Real.pi * torusCoord χ i) ^ 2 := by
      rcases abs_choice (torusCoord χ i) with h | h <;> simp [h, mul_neg]
    rw [← hsin_abs]
    have hle1 : Real.pi * δ ≤ Real.pi * |torusCoord χ i| :=
      mul_le_mul_of_nonneg_left hχ Real.pi_pos.le
    have hle2 : Real.pi * |torusCoord χ i| ≤ Real.pi / 2 := by
      nlinarith [abs_torusCoord_le_half χ i, Real.pi_pos]
    have hsin_le := Real.sin_le_sin_of_le_of_le_pi_div_two
      (by nlinarith [Real.pi_pos]) hle2 hle1
    have hsin_nn : 0 ≤ Real.sin (Real.pi * δ) :=
      Real.sin_nonneg_of_nonneg_of_le_pi (by positivity) (by nlinarith [Real.pi_pos])
    nlinarith
  have hint : Integrable (fun χ ↦ ‖(e - 1) χ‖ ^ 2) (P.diag ξ) :=
    .of_bound ((e - 1).measurable.norm.pow_const 2).aestronglyMeasurable (‖e - 1‖ ^ 2)
      (.of_forall fun χ ↦ by
        rw [Real.norm_of_nonneg (by positivity)]
        exact pow_le_pow_left₀ (norm_nonneg _) ((e - 1).norm_coe_le_norm χ) 2)
  rw [hvec, P.norm_sq_integral_apply]
  calc 4 * Real.sin (Real.pi * δ) ^ 2 * (P.diag ξ).real S
      = ∫ _ in S, 4 * Real.sin (Real.pi * δ) ^ 2 ∂(P.diag ξ) := by
          rw [setIntegral_const, smul_eq_mul, mul_comm]
    _ ≤ ∫ χ in S, ‖(e - 1) χ‖ ^ 2 ∂(P.diag ξ) :=
          setIntegral_mono_on (integrableOn_const (measure_ne_top _ _)) hint.integrableOn hS hlow
    _ ≤ ∫ χ, ‖(e - 1) χ‖ ^ 2 ∂(P.diag ξ) :=
          setIntegral_le_integral hint (.of_forall fun _ ↦ by positivity)

/-- Local-equivariance integral bound on any finite measure `μ` on `T2` with `μ {1} = 0`. -/
private theorem abs_integral_torusToProj_sub_dualAct_le {μ : Measure T2} [IsFiniteMeasure μ]
    (hμ1 : μ {1} = 0) (k : SL(2, ℤ)) (f : ℙ ℝ (Fin 2 → ℝ) →ᵇ ℝ) {δ : ℝ} (hδ0 : 0 < δ)
    (hδ : entryAbsSum k⁻¹ * δ + δ ≤ 1 / 2) :
    |∫ χ, f (sl2zToPSL2R (SpecialLinearGroup.inverseTranspose k) • torusToProj χ) ∂μ -
        ∫ χ, f (torusToProj (dualAct k⁻¹ χ)) ∂μ| ≤
      2 * ‖f‖ * (μ.real {χ | δ ≤ |torusCoord χ 0|} + μ.real {χ | δ ≤ |torusCoord χ 1|}) := by
  set γ := sl2zToPSL2R (SpecialLinearGroup.inverseTranspose k)
  have hm_f : Measurable fun x ↦ f x := f.continuous.measurable
  have hm_γf : Measurable fun x ↦ f (γ • x) :=
    (f.continuous.comp (continuous_const_smul γ)).measurable
  have hint1 : Integrable (fun χ ↦ f (γ • torusToProj χ)) μ :=
    .of_bound (hm_γf.comp measurable_torusToProj).aestronglyMeasurable ‖f‖
      (.of_forall fun _ ↦ f.norm_coe_le_norm _)
  have hint2 : Integrable (fun χ ↦ f (torusToProj (dualAct k⁻¹ χ))) μ :=
    .of_bound
      (hm_f.comp (measurable_torusToProj.comp (map_continuous _).measurable)).aestronglyMeasurable
      ‖f‖ (.of_forall fun _ ↦ f.norm_coe_le_norm _)
  set hF : T2 → ℝ := fun χ ↦ f (γ • torusToProj χ) - f (torusToProj (dualAct k⁻¹ χ))
  set B : Set T2 := {1} ∪ {χ | δ ≤ |torusCoord χ 0|} ∪ {χ | δ ≤ |torusCoord χ 1|}
  have hB : MeasurableSet B := ((measurableSet_singleton 1).union
    (measurableSet_le measurable_const (measurable_abs_torusCoord_apply 0))).union
    (measurableSet_le measurable_const (measurable_abs_torusCoord_apply 1))
  have hsupp : Function.support hF ⊆ B := fun χ hχ ↦ by
    by_contra hnotB
    simp only [B, Set.mem_union, Set.mem_singleton_iff, Set.mem_ofPred_eq, not_or, not_le] at hnotB
    exact hχ (sub_eq_zero.mpr <| congrArg f
      (torusToProj_dualAct_inv k hδ0 hδ hnotB.1.1
        fun j ↦ by fin_cases j; exacts [hnotB.1.2, hnotB.2]).symm)
  have hB_le :
      μ.real B ≤ μ.real {χ | δ ≤ |torusCoord χ 0|} + μ.real {χ | δ ≤ |torusCoord χ 1|} := by
    have h1 := measureReal_union_le (μ := μ) ({1} ∪ {χ | δ ≤ |torusCoord χ 0|})
      {χ | δ ≤ |torusCoord χ 1|}
    have h2 := measureReal_union_le (μ := μ) ({1} : Set T2) {χ | δ ≤ |torusCoord χ 0|}
    have h0 : μ.real {1} = 0 := by simp [Measure.real, hμ1]
    linarith
  have hrest : ∫ χ, hF χ ∂μ = ∫ χ in B, hF χ ∂μ :=
    (integral_congr_ae <| .of_forall fun χ ↦
      (congrFun (Set.indicator_eq_self.mpr hsupp) χ).symm).trans (integral_indicator hB)
  rw [← integral_sub hint1 hint2, ← Real.norm_eq_abs, hrest]
  calc ‖∫ χ in B, hF χ ∂μ‖ ≤ (2 * ‖f‖) * μ.real B :=
        norm_setIntegral_le_of_norm_le_const (measure_lt_top _ _) fun χ _ ↦
          (norm_sub_le _ _).trans <| by
            linarith [f.norm_coe_le_norm (γ • torusToProj χ),
              f.norm_coe_le_norm (torusToProj (dualAct k⁻¹ χ))]
    _ ≤ 2 * ‖f‖ * (μ.real {χ | δ ≤ |torusCoord χ 0|} + μ.real {χ | δ ≤ |torusCoord χ 1|}) :=
        mul_le_mul_of_nonneg_left hB_le (by positivity)

/-- Quantitative equivariance estimate for the pushed-forward spectral probability measure of a
unit vector with no `{1}`-mass. -/
private theorem abs_integral_torusToProj_sub_le
    {G : Subgroup SL(2, ℤ)} {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {ρ : ContRepresentation ℂ (Z2 ⋊[slTwoAction.comp G.subtype] G) H}
    (hρ : ρ.IsUnitary) (hinv : (ρ.restrict inl).invariants = ⊥)
    (g : G) (f : ℙ ℝ (Fin 2 → ℝ) →ᵇ ℝ) {δ : ℝ} (hδ0 : 0 < δ)
    (hδ : entryAbsSum (g : SL(2, ℤ))⁻¹ * δ + δ ≤ 1 / 2) {ξ : H} (hξ : ‖ξ‖ = 1) :
    |∫ x, f (sl2zToPSL2R (SpecialLinearGroup.inverseTranspose (g : SL(2, ℤ))) • x)
        ∂(Measure.map torusToProj (((ρ.restrict inl).spectralPVM (hρ.restrict inl)).diag ξ)) -
      ∫ x, f x
        ∂(Measure.map torusToProj (((ρ.restrict inl).spectralPVM (hρ.restrict inl)).diag ξ))| ≤
      2 * ‖f‖ * ((((ρ.restrict inl).spectralPVM (hρ.restrict inl)).diag ξ).real
          {χ : T2 | δ ≤ |torusCoord χ 0|} +
        (((ρ.restrict inl).spectralPVM (hρ.restrict inl)).diag ξ).real
          {χ : T2 | δ ≤ |torusCoord χ 1|} +
        ‖ρ (inr g⁻¹) ξ - ξ‖) := by
  set P := (ρ.restrict inl).spectralPVM (hρ.restrict inl)
  set γ := sl2zToPSL2R (SpecialLinearGroup.inverseTranspose (g : SL(2, ℤ)))
  have hP1 : P.diag ξ {1} = 0 := by
    have hproj := (spectralPVM_proj_singleton_one_eq_zero_iff (hρ.restrict inl)).mpr hinv
    have hsq := P.norm_sq_proj_apply {1} (measurableSet_singleton 1) ξ
    rw [hproj, zero_apply, norm_zero, zero_pow two_ne_zero] at hsq
    exact (ENNReal.toReal_eq_zero_iff _).mp hsq.symm |>.resolve_right (measure_ne_top _ _)
  have hm_f : Measurable fun x ↦ f x := f.continuous.measurable
  have hm_γf : Measurable fun x ↦ f (γ • x) :=
    (f.continuous.comp (continuous_const_smul γ)).measurable
  rw [integral_map measurable_torusToProj.aemeasurable hm_γf.aestronglyMeasurable,
    integral_map measurable_torusToProj.aemeasurable hm_f.aestronglyMeasurable]
  have heq2 : ∫ χ, f (torusToProj χ) ∂(P.diag ξ) =
      ∫ χ, f (torusToProj (dualAct (g : SL(2, ℤ))⁻¹ χ)) ∂(P.diag (ρ (inr g⁻¹) ξ)) := by
    conv_lhs => rw [← map_diag_spectralPVM_restrict_inl_apply_inr (ρ := ρ) hρ g⁻¹ ξ]
    exact integral_map (map_continuous (dualAct (g : SL(2, ℤ))⁻¹)).measurable.aemeasurable
      (hm_f.comp measurable_torusToProj).aestronglyMeasurable
  rw [heq2]
  have herr1 := abs_integral_torusToProj_sub_dualAct_le hP1 (g : SL(2, ℤ)) f hδ0 hδ
  have hm_d : Measurable fun χ : T2 ↦ f (torusToProj (dualAct (g : SL(2, ℤ))⁻¹ χ)) :=
    hm_f.comp (measurable_torusToProj.comp (map_continuous _).measurable)
  have hζ : ‖ρ (inr g⁻¹) ξ‖ = 1 := by rw [hρ.norm_map, hξ]
  have herr2 : |∫ χ, f (torusToProj (dualAct (g : SL(2, ℤ))⁻¹ χ)) ∂(P.diag ξ) -
      ∫ χ, f (torusToProj (dualAct (g : SL(2, ℤ))⁻¹ χ)) ∂(P.diag (ρ (inr g⁻¹) ξ))| ≤
      2 * ‖f‖ * ‖ρ (inr g⁻¹) ξ - ξ‖ := by
    rw [abs_sub_comm]
    exact norm_integral_diag_sub_le P _ hm_d (norm_nonneg f)
      (fun _ ↦ by simpa only [Real.norm_eq_abs] using f.norm_coe_le_norm _) hζ hξ
  linarith [abs_sub_le (∫ χ, f (γ • torusToProj χ) ∂(P.diag ξ))
    (∫ χ, f (torusToProj (dualAct (g : SL(2, ℤ))⁻¹ χ)) ∂(P.diag ξ))
    (∫ χ, f (torusToProj (dualAct (g : SL(2, ℤ))⁻¹ χ)) ∂(P.diag (ρ (inr g⁻¹) ξ)))]

/-- Divided spectral tail bound when `0 < δ ≤ 1 / 2` and `‖π (e_i) ξ - ξ‖ < η ≤ 1`. -/
private theorem diag_abs_torusCoord_ge_le_div
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {π : ContRepresentation ℂ Z2 H} (hπ : π.IsUnitary) (ξ : H) (i : Fin 2)
    {δ η : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1 / 2) (hη : η ≤ 1)
    (hai : ‖π (ofAdd (Pi.single i 1)) ξ - ξ‖ < η) :
    ((π.spectralPVM hπ).diag ξ).real {χ : T2 | δ ≤ |torusCoord χ i|} ≤
      η / (4 * Real.sin (Real.pi * δ) ^ 2) := by
  have hsin0 : 0 < Real.sin (Real.pi * δ) :=
    Real.sin_pos_of_pos_of_lt_pi (by positivity) (by nlinarith [Real.pi_pos, hδ1])
  have hsq : ‖π (ofAdd (Pi.single i 1)) ξ - ξ‖ ^ 2 ≤ η := by
    nlinarith [norm_nonneg (π (ofAdd (Pi.single i 1)) ξ - ξ)]
  exact (le_div_iff₀' (by positivity)).mpr
    ((diag_abs_torusCoord_ge_le hπ ξ i hδ0.le).trans hsq)

/-- Along a net of almost invariant unit vectors indexed by `Finset (ℤ² ⋊ G) × ℕ`, the
`g`-equivariance defect of the pushed-forward spectral measures converges to `0`. -/
private theorem tendsto_integral_torusToProj_sub_zero {G : Subgroup SL(2, ℤ)} {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {ρ : ContRepresentation ℂ (Z2 ⋊[slTwoAction.comp G.subtype] G) H}
    (hρ : ρ.IsUnitary) (hinv : (ρ.restrict inl).invariants = ⊥)
    {ξ : Finset (Z2 ⋊[slTwoAction.comp G.subtype] G) × ℕ → H} (hξ_norm : ∀ p, ‖ξ p‖ = 1)
    (hξ_ai : ∀ p γ, γ ∈ p.1 → ‖ρ γ (ξ p) - ξ p‖ < 1 / (p.2 + 1 : ℝ))
    (g : G) (f : ℙ ℝ (Fin 2 → ℝ) →ᵇ ℝ) :
    Tendsto (fun p ↦
      ∫ x, f (sl2zToPSL2R (SpecialLinearGroup.inverseTranspose (g : SL(2, ℤ))) • x)
          ∂(Measure.map torusToProj (((ρ.restrict inl).spectralPVM (hρ.restrict inl)).diag (ξ p))) -
        ∫ x, f x
          ∂(Measure.map torusToProj (((ρ.restrict inl).spectralPVM (hρ.restrict inl)).diag (ξ p))))
      atTop (𝓝 0) := by
  classical
  rw [Metric.tendsto_nhds]
  intro ε hε
  set C : ℝ := entryAbsSum (g : SL(2, ℤ))⁻¹ + 1
  have hC : 1 ≤ C := by linarith [entryAbsSum_nonneg (g : SL(2, ℤ))⁻¹]
  set δ : ℝ := 1 / (2 * C)
  have hδ0 : 0 < δ := by positivity
  have hδ_le : δ ≤ 1 / 2 := by rw [div_le_div_iff₀ (by positivity) two_pos]; linarith
  have hsin0 : 0 < Real.sin (Real.pi * δ) :=
    Real.sin_pos_of_pos_of_lt_pi (by positivity) (by nlinarith [Real.pi_pos, hδ_le])
  set D : ℝ := 2 / (4 * Real.sin (Real.pi * δ) ^ 2) + 1
  set η : ℝ := min 1 (ε / (2 * ‖f‖ + 1) / D)
  obtain ⟨N, hN⟩ := exists_nat_one_div_lt (by positivity : 0 < η)
  let F₀ : Finset (Z2 ⋊[slTwoAction.comp G.subtype] G) :=
    {inl (ofAdd (Pi.single 0 1)), inl (ofAdd (Pi.single 1 1)), inr g⁻¹}
  filter_upwards [Filter.eventually_ge_atTop (F₀, N)] with p hp
  have hNp : (N : ℝ) + 1 ≤ (p.2 : ℝ) + 1 := by exact_mod_cast Nat.add_le_add_right hp.2 1
  have hlt (γ₀) (hγ₀ : γ₀ ∈ F₀) : ‖ρ γ₀ (ξ p) - ξ p‖ < η :=
    (hξ_ai p γ₀ (hp.1 hγ₀)).trans <|
      (one_div_le_one_div_of_le (by positivity) hNp).trans_lt hN
  have htail (i : Fin 2) := diag_abs_torusCoord_ge_le_div (hρ.restrict inl) (ξ p) i hδ0 hδ_le
    (min_le_left _ _) (hlt (inl (ofAdd (Pi.single i 1))) (by fin_cases i <;> simp [F₀]))
  have hmain := abs_integral_torusToProj_sub_le hρ hinv g f hδ0
    (by have : C * δ = 1 / 2 := by dsimp [δ]; field_simp
        linarith) (hξ_norm p)
  have hD_eq : η / (4 * Real.sin (Real.pi * δ) ^ 2) +
      η / (4 * Real.sin (Real.pi * δ) ^ 2) + η = D * η := by
    dsimp [D]; ring
  have hsum : (((ρ.restrict inl).spectralPVM (hρ.restrict inl)).diag (ξ p)).real
        {χ | δ ≤ |torusCoord χ 0|} +
      (((ρ.restrict inl).spectralPVM (hρ.restrict inl)).diag (ξ p)).real
        {χ | δ ≤ |torusCoord χ 1|} + ‖ρ (inr g⁻¹) (ξ p) - ξ p‖ < D * η := by
    linarith [htail 0, htail 1, hlt (inr g⁻¹) (by simp [F₀]), hD_eq]
  have hDη : D * η ≤ ε / (2 * ‖f‖ + 1) :=
    (le_div_iff₀' (by positivity : 0 < D)).mp (min_le_right _ _)
  have hprod : 2 * ‖f‖ * (D * η) < ε :=
    calc 2 * ‖f‖ * (D * η) ≤ 2 * ‖f‖ * (ε / (2 * ‖f‖ + 1)) :=
          mul_le_mul_of_nonneg_left hDη (by positivity)
      _ < (2 * ‖f‖ + 1) * (ε / (2 * ‖f‖ + 1)) :=
          mul_lt_mul_of_pos_right (by linarith) (by positivity)
      _ = ε := mul_div_cancel₀ ε (by positivity)
  rw [Real.dist_eq, sub_zero]
  exact hmain.trans_lt ((mul_le_mul_of_nonneg_left hsum.le (by positivity)).trans_lt hprod)

/-- Passing to an ultrafilter limit of pushed-forward diagonal spectral measures along almost
invariant unit vectors shows that a representation with no `ℤ²`-invariant vectors forces `G` to be
amenable. -/
private theorem amenable_of_invariants_eq_bot {G : Subgroup SL(2, ℤ)} {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {ρ : ContRepresentation ℂ (Z2 ⋊[slTwoAction.comp G.subtype] G) H}
    (hρ : ρ.IsUnitary) (hai : ρ.HasAlmostInvariantVectors)
    (hinv : (ρ.restrict inl).invariants = ⊥) : Amenable G := by
  classical
  set Γ := Z2 ⋊[slTwoAction.comp G.subtype] G
  set P := (ρ.restrict inl).spectralPVM (hρ.restrict inl)
  choose ξ hξ_norm hξ_ai using fun p : Finset Γ × ℕ ↦
    (hasAlmostInvariantVectors_def ρ).mp hai p.1 (1 / (p.2 + 1 : ℝ)) Nat.one_div_pos_of_nat
  have hprob (p : Finset Γ × ℕ) : IsProbabilityMeasure (P.diag (ξ p)) := by
    have hn : ‖ξ p‖₊ = 1 := Subtype.ext (by simpa [coe_nnNorm] using hξ_norm p)
    exact ⟨by simp [P.diag_univ, eNorm_eq_nnNorm, hn]⟩
  let ν (p : Finset Γ × ℕ) : ProbabilityMeasure (ℙ ℝ (Fin 2 → ℝ)) :=
    ⟨Measure.map torusToProj (P.diag (ξ p)),
      (Measure.isProbabilityMeasure_map_iff measurable_torusToProj.aemeasurable).mpr (hprob p)⟩
  let U : Ultrafilter (Finset Γ × ℕ) := Ultrafilter.of atTop
  obtain ⟨μ₀, -, hμ₀⟩ := isCompact_univ.ultrafilter_le_nhds (U.map ν) (by simp)
  have hdefect (g : G) (f : ℙ ℝ (Fin 2 → ℝ) →ᵇ ℝ) :
      ∫ x, f (sl2zToPSL2R (SpecialLinearGroup.inverseTranspose (g : SL(2, ℤ))) • x)
        ∂(μ₀ : Measure _) = ∫ x, f x ∂(μ₀ : Measure _) := by
    set γ := sl2zToPSL2R (SpecialLinearGroup.inverseTranspose (g : SL(2, ℤ)))
    let fγ : ℙ ℝ (Fin 2 → ℝ) →ᵇ ℝ := f.compContinuous ⟨(γ • ·), continuous_const_smul γ⟩
    let Φ : ProbabilityMeasure (ℙ ℝ (Fin 2 → ℝ)) → ℝ :=
      fun μ ↦ ∫ x, fγ x ∂(μ : Measure _) - ∫ x, f x ∂(μ : Measure _)
    have hΦ_cont : Continuous Φ :=
      (ProbabilityMeasure.continuous_integral_boundedContinuousFunction fγ).sub
        (ProbabilityMeasure.continuous_integral_boundedContinuousFunction f)
    have h1 : Tendsto (Φ ∘ ν) U (𝓝 (Φ μ₀)) := (hΦ_cont.tendsto μ₀).comp (tendsto_map'_iff.mp hμ₀)
    have h2 : Tendsto (Φ ∘ ν) U (𝓝 0) :=
      (tendsto_integral_torusToProj_sub_zero hρ hinv hξ_norm hξ_ai g f).mono_left
        (Ultrafilter.of_le atTop)
    exact sub_eq_zero.mp (tendsto_nhds_unique h1 h2)
  have : Amenable sl2zToPSL2R.ker := by
    rw [sl2zToPSL2R_ker]
    infer_instance
  let θ := SpecialLinearGroup.inverseTranspose (n := Fin 2) (R := ℤ)
  have : Amenable (G.map θ.toMonoidHom) := by
    refine (G.map θ.toMonoidHom).amenable_of_discreteTopology_map_of_forall_map_smul_eq
      (φ := sl2zToPSL2R) (IsProbabilityMeasure.ne_zero (μ₀ : Measure _)) ?_
    rintro ⟨_, g, hg, rfl⟩
    refine ext_of_forall_integral_eq_of_IsFiniteMeasure fun f ↦ ?_
    rw [integral_map (continuous_const_smul _).measurable.aemeasurable
      f.continuous.measurable.aestronglyMeasurable]
    exact hdefect ⟨g, hg⟩ f
  exact Amenable.of_injective (θ.toMonoidHom.subgroupMap G)
    (θ.toMonoidHom.subgroupMap_injective G θ.injective)

/-- Converse direction: if `G ≤ SL₂(ℤ)` is amenable, then `ℤ² ⋊ G` is amenable, so its infinite
normal subgroup `ℤ²` cannot have relative property (T). -/
private theorem not_relativePropertyT_of_amenable.{u} {G : Subgroup SL(2, ℤ)} [Amenable G] :
    ¬ (inl (G := G) (φ := slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} := by
  set Γ := Z2 ⋊[slTwoAction.comp G.subtype] G
  let _ : TopologicalSpace Γ := ⊥
  have : DiscreteTopology Γ := ⟨rfl⟩
  have : Amenable Γ := Amenable.of_ker_le_range (inl (G := G) (φ := slTwoAction.comp G.subtype))
    SemidirectProduct.rightHom SemidirectProduct.range_inl_eq_ker_rightHom.ge
  let e : ULift.{u} Γ ≃* Γ := MulEquiv.ulift
  let _ : TopologicalSpace (ULift.{u} Γ) := ⊥
  have : DiscreteTopology (ULift.{u} Γ) := ⟨rfl⟩
  have : Amenable (ULift.{u} Γ) := Amenable.of_injective e.toMonoidHom e.injective
  have hHaag : HasHaagerupProperty (ULift.{u} Γ) := hasHaagerupProperty_of_amenable
  intro hT
  have hfin : Finite (((inl (G := G) (φ := slTwoAction.comp G.subtype)).range).map
      e.symm.toMonoidHom) :=
    hHaag.finite_of_relativePropertyT (hT.map e.symm.toMonoidHom)
  let ι : Multiplicative ℤ → ((inl (G := G) (φ := slTwoAction.comp G.subtype)).range).map
      e.symm.toMonoidHom :=
    fun n ↦ ⟨e.symm (inl (ofAdd ![toAdd n, 0])),
      ⟨inl (ofAdd ![toAdd n, 0]), ⟨ofAdd ![toAdd n, 0], rfl⟩, rfl⟩⟩
  have hι : Function.Injective ι := fun m n h ↦ by
    have h1 := SemidirectProduct.inl_injective (e.symm.injective (congrArg Subtype.val h))
    exact toAdd.injective (congrArg (fun v : Fin 2 → ℤ ↦ v 0) (ofAdd.injective h1))
  have : Finite (Multiplicative ℤ) := Finite.of_injective ι hι
  exact not_finite (Multiplicative ℤ)

end SpecialLinearPropertyT

open SpecialLinearPropertyT

universe u

/-- **Burger's relative property (T) theorem.** For every nonamenable subgroup `G ≤ SL₂(ℤ)`, the
pair `(ℤ² ⋊ G, ℤ²)` has relative property (T). -/
theorem relativePropertyT_inl_of_not_amenable {G : Subgroup SL(2, ℤ)} (hG : ¬ Amenable G) :
    (inl (G := G) (φ := slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} := by
  rw [Subgroup.relativePropertyT_def]
  intro H _ _ _ ρ hρ hai
  refine not_not.mp fun hno ↦ hG (amenable_of_invariants_eq_bot hρ hai ?_)
  rw [Submodule.eq_bot_iff]
  intro v hv
  by_contra hv0
  exact hno ⟨v, hv0, fun ⟨_, m, rfl⟩ ↦ hv m⟩

end TauCeti

namespace Subgroup

universe u

/-- **Characterization of relative property (T) for `(ℤ² ⋊ G, ℤ²)`.** For a subgroup `G ≤ SL₂(ℤ)`,
the normal subgroup `ℤ²` of `ℤ² ⋊ G` has relative property (T) in universe `u` if and only if `G`
is not amenable. -/
theorem relativePropertyT_range_inl_slTwoAction_iff_not_amenable (G : Subgroup SL(2, ℤ)) :
    (inl (G := G) (φ := TauCeti.slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} ↔
      ¬ TauCeti.Amenable G :=
  ⟨fun hT _ ↦ TauCeti.SpecialLinearPropertyT.not_relativePropertyT_of_amenable hT,
    TauCeti.relativePropertyT_inl_of_not_amenable⟩

/-- **Følner characterization of relative property (T) for `(ℤ² ⋊ G, ℤ²)`.** For a subgroup
`G ≤ SL₂(ℤ)`, the normal subgroup `ℤ²` of `ℤ² ⋊ G` has relative property (T) in universe `u` if
and only if `G` does not have Følner sets. -/
theorem relativePropertyT_range_inl_slTwoAction_iff_not_hasFoelnerSets (G : Subgroup SL(2, ℤ)) :
    (inl (G := G) (φ := TauCeti.slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} ↔
      ¬ TauCeti.HasFoelnerSets G := by
  rw [G.relativePropertyT_range_inl_slTwoAction_iff_not_amenable,
    TauCeti.amenable_iff_hasFoelnerSets]

end Subgroup

namespace TauCeti

universe u

/-- **Kazhdan–Margulis theorem.** The pair `(ℤ² ⋊ SL₂(ℤ), ℤ²)` has relative property (T). -/
theorem relativePropertyT_inl_slTwo :
    (inl (G := SL(2, ℤ)) (φ := slTwoAction)).range.RelativePropertyT.{u} := by
  have hnotA : ¬ Amenable (⊤ : Subgroup SL(2, ℤ)) := fun _ ↦ by
    have : Amenable SL(2, ℤ) :=
      Amenable.of_injective (Subgroup.topEquiv (G := SL(2, ℤ))).symm.toMonoidHom
        (Subgroup.topEquiv (G := SL(2, ℤ))).symm.injective
    exact not_amenable_of_injective_freeGroup _ injective_freeGroup_lift_transvection_two this
  let f : SpecialLinearPropertyT.Z2 ⋊[slTwoAction.comp (⊤ : Subgroup SL(2, ℤ)).subtype]
      (⊤ : Subgroup SL(2, ℤ)) →* SpecialLinearPropertyT.Z2 ⋊[slTwoAction] SL(2, ℤ) :=
    SemidirectProduct.map (MonoidHom.id _) (⊤ : Subgroup SL(2, ℤ)).subtype fun _ ↦ rfl
  have hmap : ((inl (G := (⊤ : Subgroup SL(2, ℤ)))
      (φ := slTwoAction.comp (⊤ : Subgroup SL(2, ℤ)).subtype)).range).map f =
      (inl (G := SL(2, ℤ)) (φ := slTwoAction)).range := by
    ext x
    simp [f, SemidirectProduct.map_inl]
  rw [← hmap]
  exact (relativePropertyT_inl_of_not_amenable hnotA).map f

/-- For Sanov's rank-two free subgroup `F₂ ≤ SL₂(ℤ)` generated by `[[1, 2], [0, 1]]` and
`[[1, 0], [2, 1]]`, the pair `(ℤ² ⋊ F₂, ℤ²)` has relative property (T). -/
theorem relativePropertyT_inl_freeGroup_transvection_two :
    (inl (G := (FreeGroup.lift ![SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1)
          (2 : ℤ),
        SpecialLinearGroup.transvection (one_ne_zero : (1 : Fin 2) ≠ 0) (2 : ℤ)]).range)
      (φ := slTwoAction.comp
        (FreeGroup.lift ![SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (2 : ℤ),
          SpecialLinearGroup.transvection (one_ne_zero : (1 : Fin 2) ≠ 0) (2 : ℤ)]).range.subtype)
      ).range.RelativePropertyT.{u} := by
  set ψ := FreeGroup.lift ![SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (2 : ℤ),
    SpecialLinearGroup.transvection (one_ne_zero : (1 : Fin 2) ≠ 0) (2 : ℤ)]
  refine relativePropertyT_inl_of_not_amenable fun hA ↦ ?_
  exact not_amenable_of_injective_freeGroup ψ.rangeRestrict
    (ψ.rangeRestrict_injective_iff.mpr injective_freeGroup_lift_transvection_two) hA

/-- For the elementary transvection subgroup `{I + n E_{ij} : n ∈ ℤ} ≤ SL₂(ℤ)`, the pair
`(ℤ² ⋊ G, ℤ²)` does not have relative property (T), showing that nonamenability cannot be dropped
in Burger's theorem. -/
theorem not_relativePropertyT_inl_transvectionHom {i j : Fin 2} (hij : i ≠ j) :
    ¬ (inl (G := (SpecialLinearGroup.transvectionHom (A := ℤ) hij).range)
      (φ := slTwoAction.comp
        (SpecialLinearGroup.transvectionHom (A := ℤ) hij).range.subtype)
      ).range.RelativePropertyT.{u} := by
  set U := (SpecialLinearGroup.transvectionHom (A := ℤ) hij).range
  rw [U.relativePropertyT_range_inl_slTwoAction_iff_not_amenable, not_not]
  exact Amenable.of_denseRange
    ⟨(SpecialLinearGroup.transvectionHom (A := ℤ) hij).rangeRestrict,
      continuous_of_discreteTopology⟩
    (SpecialLinearGroup.transvectionHom (A := ℤ) hij).rangeRestrict_surjective.denseRange

end TauCeti
