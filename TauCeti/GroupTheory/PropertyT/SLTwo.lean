section Helpers

/-- The Pontryagin dual torus `𝕋²` of `ℤ²`. -/
private abbrev DualTorus : Type :=
  PontryaginDual (Multiplicative (Fin 2 → ℤ))

private noncomputable local instance : MeasurableSpace DualTorus := borel DualTorus
private local instance : BorelSpace DualTorus := ⟨rfl⟩
private noncomputable local instance : MeasurableSpace (OnePoint ℝ) := borel (OnePoint ℝ)
private local instance : BorelSpace (OnePoint ℝ) := ⟨rfl⟩

/-- The dual automorphism of `𝕋²` induced by `slTwoAction g`. -/
private noncomputable def dualAction (g : SL(2, ℤ)) : DualTorus →ₜ* DualTorus :=
  PontryaginDual.map ⟨(slTwoAction g).toMonoidHom, continuous_of_discreteTopology⟩

/-- Principal-argument coordinate `arg (χ v) ∈ (-π, π]` on the dual torus. -/
private noncomputable def torusArg (v : Fin 2 → ℤ) (χ : DualTorus) : ℝ :=
  Complex.arg ((χ (Multiplicative.ofAdd v) : Circle) : ℂ)

/-- Homogeneous coordinates `![-x₁, x₀]` of a character `χ` at the standard basis of `ℤ²`. -/
private noncomputable def torusVec (χ : DualTorus) : Fin 2 → ℝ :=
  ![-torusArg ![0, 1] χ, torusArg ![1, 0] χ]

/-- The Borel projection `𝕋² → OnePoint ℝ` sending `χ` with coordinates `(x₀, x₁)` to `-x₁ / x₀`
(and `x₀ = 0` to `∞`). -/
private noncomputable def torusToOnePoint (χ : DualTorus) : OnePoint ℝ :=
  if torusVec χ 1 = 0 then ∞ else ((torusVec χ 1)⁻¹ * torusVec χ 0 : ℝ)

private lemma continuousAt_torusArg_one (v : Fin 2 → ℤ) : ContinuousAt (torusArg v) 1 := by
  have h1 : (((1 : DualTorus) (Multiplicative.ofAdd v) : Circle) : ℂ) ∈ Complex.slitPlane := by
    simp
  exact ContinuousAt.comp (g := Complex.arg)
    (f := fun χ : DualTorus ↦ ((χ (Multiplicative.ofAdd v) : Circle) : ℂ))
    (Complex.continuousAt_arg h1)
    (PontryaginDual.continuous_coe_eval_const (Multiplicative.ofAdd v)).continuousAt

private lemma measurable_torusToOnePoint : Measurable torusToOnePoint := by
  have harg (v : Fin 2 → ℤ) : Measurable (torusArg v) :=
    Complex.measurable_arg.comp
      (PontryaginDual.continuous_coe_eval_const (Multiplicative.ofAdd v)).measurable
  have h0 : Measurable fun χ : DualTorus ↦ torusVec χ 0 :=
    (harg ![0, 1]).neg
  have h1 : Measurable fun χ : DualTorus ↦ torusVec χ 1 :=
    harg ![1, 0]
  exact Measurable.ite (measurableSet_eq_fun h1 measurable_const) measurable_const
    (OnePoint.continuous_coe.measurable.comp (h1.inv.mul h0))

private lemma multiplicative_fin_two_eq (m : Multiplicative (Fin 2 → ℤ)) :
    m = (Multiplicative.ofAdd ![1, 0]) ^ (Multiplicative.toAdd m 0) *
      (Multiplicative.ofAdd ![0, 1]) ^ (Multiplicative.toAdd m 1) := by
  rw [← ofAdd_zsmul, ← ofAdd_zsmul, ← ofAdd_add]
  apply Multiplicative.toAdd.injective
  ext i
  fin_cases i <;> simp

private lemma torusVec_eq_zero_iff {χ : DualTorus} : torusVec χ = 0 ↔ χ = 1 := by
  refine ⟨fun h ↦ PontryaginDual.ext fun m ↦ ?_, fun h ↦ ?_⟩
  · have h0 : χ (Multiplicative.ofAdd ![1, 0]) = 1 :=
      Circle.arg_eq_zero.mp (by simpa [torusVec, torusArg] using congrFun h 1)
    have h1 : χ (Multiplicative.ofAdd ![0, 1]) = 1 :=
      Circle.arg_eq_zero.mp (neg_eq_zero.mp (by simpa [torusVec, torusArg] using congrFun h 0))
    rw [multiplicative_fin_two_eq m, map_mul, map_zpow, map_zpow, h0, h1, one_zpow, one_zpow,
      mul_one, PontryaginDual.one_apply]
  · subst h
    ext i
    fin_cases i <;> simp [torusVec, torusArg]

private lemma torusArg_dualAction_of_abs_lt {g : SL(2, ℤ)} {χ : DualTorus} {δ B : ℝ}
    (hB : 0 < B) (hδ_eq : δ = Real.pi / (2 * B))
    (hx0 : |torusArg ![1, 0] χ| < δ) (hx1 : |torusArg ![0, 1] χ| < δ)
    (v : Fin 2 → ℤ) (a b : ℤ)
    (hgv : slTwoAction g (Multiplicative.ofAdd v) =
      (Multiplicative.ofAdd ![1, 0]) ^ a * (Multiplicative.ofAdd ![0, 1]) ^ b)
    (hab : |(a : ℝ)| + |(b : ℝ)| < B) :
    torusArg v (dualAction g χ) = a * torusArg ![1, 0] χ + b * torusArg ![0, 1] χ := by
  have hδ : 0 < δ := hδ_eq ▸ div_pos Real.pi_pos (by positivity)
  have hexp : (dualAction g χ) (Multiplicative.ofAdd v) =
      Circle.exp (a * torusArg ![1, 0] χ + b * torusArg ![0, 1] χ) := by
    rw [dualAction, PontryaginDual.map_apply, ContinuousMonoidHom.coe_mk,
      MulEquiv.coe_toMonoidHom, hgv, map_mul, map_zpow, map_zpow, Circle.exp_add,
      Circle.exp_intCast_mul, Circle.exp_intCast_mul, torusArg, torusArg,
      Circle.exp_arg, Circle.exp_arg]
  have hlt : |a * torusArg ![1, 0] χ + b * torusArg ![0, 1] χ| < Real.pi := by
    have h1 : |a * torusArg ![1, 0] χ + b * torusArg ![0, 1] χ| ≤
        (|(a : ℝ)| + |(b : ℝ)|) * δ := by
      calc |a * torusArg ![1, 0] χ + b * torusArg ![0, 1] χ|
          ≤ |(a : ℝ)| * |torusArg ![1, 0] χ| + |(b : ℝ)| * |torusArg ![0, 1] χ| := by
            simpa [abs_mul] using abs_add_le (a * torusArg ![1, 0] χ) (b * torusArg ![0, 1] χ)
        _ ≤ |(a : ℝ)| * δ + |(b : ℝ)| * δ := by gcongr
        _ = (|(a : ℝ)| + |(b : ℝ)|) * δ := by ring
    have h2 : (|(a : ℝ)| + |(b : ℝ)|) * δ < B * δ := mul_lt_mul_of_pos_right hab hδ
    have h3 : B * δ = Real.pi / 2 := by
      rw [hδ_eq]
      field_simp [hB.ne']
    linarith [Real.pi_pos]
  rw [torusArg, hexp]
  exact Circle.arg_exp (neg_lt_of_abs_lt hlt) (lt_of_abs_lt hlt).le

/-- Near the trivial character, `dualAction g` acts linearly on `torusVec` via the real cast of
`g⁻¹`. -/
private lemma exists_open_nhds_one_torusVec_dualAction (g : SL(2, ℤ)) :
    ∃ U : Set DualTorus, IsOpen U ∧ (1 : DualTorus) ∈ U ∧ ∀ χ ∈ U,
      torusVec (dualAction g χ) =
        Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) g⁻¹ • torusVec χ := by
  set B : ℝ := |(g 0 0 : ℝ)| + |(g 0 1 : ℝ)| + |(g 1 0 : ℝ)| + |(g 1 1 : ℝ)| + 1
  have hB : 0 < B := by positivity
  set δ : ℝ := Real.pi / (2 * B)
  have hδ : 0 < δ := div_pos Real.pi_pos (by positivity)
  have hnhds : {χ : DualTorus | |torusArg ![1, 0] χ| < δ ∧ |torusArg ![0, 1] χ| < δ} ∈
      𝓝 (1 : DualTorus) := by
    have hc (v : Fin 2 → ℤ) : ∀ᶠ χ in 𝓝 (1 : DualTorus), |torusArg v χ| < δ := by
      have ht := Metric.tendsto_nhds.mp (continuousAt_torusArg_one v).tendsto δ hδ
      have h0 : torusArg v 1 = 0 := by simp [torusArg]
      simpa [Real.dist_eq, h0] using ht
    exact (hc ![1, 0]).and (hc ![0, 1])
  obtain ⟨U, hUsub, hUopen, h1U⟩ := mem_nhds_iff.mp hnhds
  refine ⟨U, hUopen, h1U, fun χ hχ ↦ ?_⟩
  obtain ⟨hx0, hx1⟩ := hUsub hχ
  have hy0 : torusArg ![1, 0] (dualAction g χ) =
      g 0 0 * torusArg ![1, 0] χ + g 1 0 * torusArg ![0, 1] χ :=
    torusArg_dualAction_of_abs_lt hB rfl hx0 hx1 ![1, 0] (g 0 0) (g 1 0)
      (by
        simpa [Matrix.SpecialLinearGroup.smul_def, Matrix.mulVec, Matrix.vecHead] using
          multiplicative_fin_two_eq (slTwoAction g (Multiplicative.ofAdd ![1, 0])))
      (by dsimp [B]; linarith [abs_nonneg (g 0 1 : ℝ), abs_nonneg (g 1 1 : ℝ)])
  have hy1 : torusArg ![0, 1] (dualAction g χ) =
      g 0 1 * torusArg ![1, 0] χ + g 1 1 * torusArg ![0, 1] χ :=
    torusArg_dualAction_of_abs_lt hB rfl hx0 hx1 ![0, 1] (g 0 1) (g 1 1)
      (by
        simpa [Matrix.SpecialLinearGroup.smul_def, Matrix.mulVec, Matrix.vecHead,
          Matrix.vecTail] using
          multiplicative_fin_two_eq (slTwoAction g (Multiplicative.ofAdd ![0, 1])))
      (by dsimp [B]; linarith [abs_nonneg (g 0 0 : ℝ), abs_nonneg (g 1 0 : ℝ)])
  ext i
  (fin_cases i <;>
    simp [torusVec, hy0, hy1, Matrix.SpecialLinearGroup.smul_def,
      Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      Matrix.SpecialLinearGroup.map_apply_coe, Matrix.mulVec]);
  ring

/-- On a punctured neighborhood of `1 ∈ 𝕋²`, `torusToOnePoint` intertwines `dualAction g` with the
Möbius action of `sl2zToPSL2R g⁻¹` on `OnePoint ℝ`. -/
private lemma exists_open_nhds_one_torusToOnePoint_dualAction (g : SL(2, ℤ)) :
    ∃ U : Set DualTorus, IsOpen U ∧ (1 : DualTorus) ∈ U ∧ ∀ χ ∈ U, χ ≠ 1 →
      torusToOnePoint (dualAction g χ) = sl2zToPSL2R g⁻¹ • torusToOnePoint χ := by
  obtain ⟨U, hU, h1U, hvec⟩ := exists_open_nhds_one_torusVec_dualAction g
  refine ⟨U, hU, h1U, fun χ hχU hχ1 ↦ ?_⟩
  let M : SL(2, ℝ) := Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) g⁻¹
  have hv : torusVec χ ≠ 0 := mt torusVec_eq_zero_iff.mp hχ1
  have hMv : (M : GL (Fin 2) ℝ) • torusVec χ ≠ 0 := (smul_ne_zero_iff_ne (M : GL (Fin 2) ℝ)).mpr hv
  have hχ_eq : torusToOnePoint χ =
      (OnePoint.equivProjectivization ℝ).symm (Projectivization.mk ℝ (torusVec χ) hv) := by
    rw [OnePoint.equivProjectivization_symm_apply_mk, torusToOnePoint]
  have hgχ_eq : torusToOnePoint (dualAction g χ) =
      (OnePoint.equivProjectivization ℝ).symm
        (Projectivization.mk ℝ ((M : GL (Fin 2) ℝ) • torusVec χ) hMv) := by
    have hsmul : (M : GL (Fin 2) ℝ) • torusVec χ = M • torusVec χ := rfl
    rw [OnePoint.equivProjectivization_symm_apply_mk, torusToOnePoint, hvec χ hχU, hsmul]
  rw [sl2zToPSL2R_apply, OnePoint.pslMk_smul, hχ_eq,
    OnePoint.equivProjectivization_symm_toGL_smul, Projectivization.smul_mk, hgχ_eq]
  rfl

/-- On any finite Borel measure `μ` on `𝕋²` giving mass zero to `{1}`, the integral of
`f ∘ torusToOnePoint ∘ dualAction g` differs from that of `f ∘ (sl2zToPSL2R g⁻¹ • ·) ∘
torusToOnePoint` by at most `2 * ‖f‖ * μ.real Uᶜ`, where `U` is an open neighborhood of `1` on
`U \ {1}` of which `torusToOnePoint` is equivariant. -/
private lemma abs_integral_torusToOnePoint_dualAction_sub_le
    {μ : Measure DualTorus} [IsFiniteMeasure μ] (hμ1 : μ {1} = 0)
    {g : SL(2, ℤ)} {U : Set DualTorus} (hU : IsOpen U)
    (hUeq : ∀ χ ∈ U, χ ≠ 1 → torusToOnePoint (dualAction g χ) =
      sl2zToPSL2R g⁻¹ • torusToOnePoint χ)
    (f : OnePoint ℝ →ᵇ ℝ) :
    |∫ χ, f (torusToOnePoint (dualAction g χ)) ∂μ -
        ∫ χ, f (sl2zToPSL2R g⁻¹ • torusToOnePoint χ) ∂μ| ≤ 2 * ‖f‖ * μ.real Uᶜ := by
  have hmeas_t : Measurable torusToOnePoint := measurable_torusToOnePoint
  have hmeas_g : Measurable (dualAction g) := (map_continuous (dualAction g)).measurable
  let d : DualTorus → ℝ := fun χ ↦
    f (torusToOnePoint (dualAction g χ)) - f (sl2zToPSL2R g⁻¹ • torusToOnePoint χ)
  have hd_meas : Measurable d :=
    (f.continuous.measurable.comp (hmeas_t.comp hmeas_g)).sub
      ((f.continuous.comp (continuous_const_smul _)).measurable.comp hmeas_t)
  have hd_bound (χ : DualTorus) : ‖d χ‖ ≤ 2 * ‖f‖ := by
    refine (norm_sub_le _ _).trans ?_
    linarith [f.norm_coe_le_norm (torusToOnePoint (dualAction g χ)),
      f.norm_coe_le_norm (sl2zToPSL2R g⁻¹ • torusToOnePoint χ)]
  have hd_ae : d =ᵐ[μ] (Uᶜ).indicator d := by
    rw [Filter.EventuallyEq, ae_iff]
    refine measure_mono_null (fun χ hχ ↦ ?_) hμ1
    by_contra hχ1
    rw [Set.mem_singleton_iff] at hχ1
    by_cases hχU : χ ∈ U
    · have hd0 : d χ = 0 := by simp [d, hUeq χ hχU hχ1]
      exact hχ (by simp [hd0, hχU])
    · exact hχ (by simp [hχU])
  have hint1 : Integrable (fun χ ↦ f (torusToOnePoint (dualAction g χ))) μ :=
    .of_bound (f.continuous.measurable.comp (hmeas_t.comp hmeas_g)).aestronglyMeasurable ‖f‖
      (.of_forall fun _ ↦ f.norm_coe_le_norm _)
  have hint2 : Integrable (fun χ ↦ f (sl2zToPSL2R g⁻¹ • torusToOnePoint χ)) μ :=
    .of_bound
      ((f.continuous.comp (continuous_const_smul _)).measurable.comp hmeas_t).aestronglyMeasurable
      ‖f‖ (.of_forall fun _ ↦ f.norm_coe_le_norm _)
  rw [← integral_sub hint1 hint2, integral_congr_ae hd_ae]
  calc |∫ χ, (Uᶜ).indicator d χ ∂μ|
      ≤ ∫ χ, ‖(Uᶜ).indicator d χ‖ ∂μ := by
        rw [← Real.norm_eq_abs]
        exact norm_integral_le_integral_norm _
    _ ≤ ∫ χ, (Uᶜ).indicator (fun _ : DualTorus ↦ 2 * ‖f‖) χ ∂μ := by
        refine integral_mono
          ((Integrable.of_bound hd_meas.aestronglyMeasurable (2 * ‖f‖)
            (.of_forall hd_bound)).indicator hU.isClosed_compl.measurableSet).norm
          ((integrable_const (2 * ‖f‖)).indicator hU.isClosed_compl.measurableSet) fun χ ↦ ?_
        by_cases hχ : χ ∈ Uᶜ
        · simpa [hχ, ← Real.norm_eq_abs] using hd_bound χ
        · simp [hχ]
    _ = 2 * ‖f‖ * μ.real Uᶜ := by
        rw [integral_indicator hU.isClosed_compl.measurableSet, MeasureTheory.integral_const,
          Measure.real, Measure.restrict_apply_univ, ← Measure.real, smul_eq_mul, mul_comm]

private lemma abs_integral_diag_sub_le {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] (P : ProjValMeasure DualTorus H)
    {φ : DualTorus → ℝ} (hφ : Measurable φ) {M : ℝ} (hM : 0 ≤ M) (hbound : ∀ χ, |φ χ| ≤ M)
    (η ξ : H) :
    |∫ χ, φ χ ∂(P.diag η) - ∫ χ, φ χ ∂(P.diag ξ)| ≤ M * (‖η‖ + ‖ξ‖) * ‖η - ξ‖ := by
  let F : BoundedBorelFunction DualTorus := BoundedBorelFunction.ofFunction
    (fun χ ↦ (φ χ : ℂ)) (Complex.continuous_ofReal.measurable.comp hφ)
    ⟨M, hM, fun χ ↦ by simpa [Complex.norm_real] using hbound χ⟩
  have hC := P.norm_integral_diag_sub_le (f := F) (M := M)
    (fun χ ↦ by simpa [F, Complex.norm_real] using hbound χ) η ξ
  simpa only [F, BoundedBorelFunction.ofFunction_apply, integral_complex_ofReal,
    ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs] using hC

/-- Quantitative approximate `G`-invariance of the pushed-forward diagonal spectral measure of a
unit vector `ξ` when `ρ|_{ℤ²}` has no nonzero invariant vector. -/
private lemma exists_abs_integral_map_torusToOnePoint_sub_le
    {G : Subgroup SL(2, ℤ)} {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {ρ : ContRepresentation ℂ (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G) H}
    (hρ : ρ.IsUnitary) (hinv : (ρ.restrict SemidirectProduct.inl).invariants = ⊥)
    (g : G) (f : OnePoint ℝ →ᵇ ℝ) :
    ∃ (S : Finset (Fin 2 → ℤ)) (C : ℝ), 0 ≤ C ∧ ∀ ξ : H, ‖ξ‖ = 1 →
      |∫ x, f x ∂(Measure.map torusToOnePoint
          (((ρ.restrict SemidirectProduct.inl).spectralPVM (hρ.restrict _)).diag ξ)) -
        ∫ x, f (sl2zToPSL2R (g : SL(2, ℤ))⁻¹ • x) ∂(Measure.map torusToOnePoint
          (((ρ.restrict SemidirectProduct.inl).spectralPVM (hρ.restrict _)).diag ξ))| ≤
        2 * ‖f‖ * ‖ρ (.inr g) ξ - ξ‖ +
          2 * ‖f‖ * (C * ∑ v ∈ S, ‖ρ (.inl (.ofAdd v)) ξ - ξ‖ ^ 2) := by
  set P := (ρ.restrict SemidirectProduct.inl).spectralPVM (hρ.restrict _)
  obtain ⟨U, hU, h1U, hUeq⟩ := exists_open_nhds_one_torusToOnePoint_dualAction (g : SL(2, ℤ))
  obtain ⟨S, C, hC, hSC⟩ :=
    (ρ.restrict SemidirectProduct.inl).exists_diag_spectralPVM_compl_le_sum_norm_sub_sq
      (hρ.restrict _) hU h1U
  refine ⟨S, C, hC, fun ξ hξ ↦ ?_⟩
  have hP1 : P.diag ξ {1} = 0 := by
    have hproj : P.proj {1} (measurableSet_singleton 1) = 0 :=
      ((ρ.restrict SemidirectProduct.inl).spectralPVM_proj_singleton_one_eq_zero_iff
        (hρ.restrict _)).mpr hinv
    have h0 := P.norm_sq_proj_apply {1} (measurableSet_singleton 1) ξ
    rw [hproj, zero_apply, norm_zero, sq, mul_zero] at h0
    exact ((ENNReal.toReal_eq_zero_iff _).mp h0.symm).resolve_right (measure_ne_top _ _)
  have hmeas_t : Measurable torusToOnePoint := measurable_torusToOnePoint
  have hmeas_g : Measurable (dualAction (g : SL(2, ℤ))) :=
    (map_continuous (dualAction _)).measurable
  have hI1 : ∫ x, f x ∂(Measure.map torusToOnePoint (P.diag ξ)) =
      ∫ χ, f (torusToOnePoint (dualAction (g : SL(2, ℤ)) χ)) ∂(P.diag (ρ (.inr g) ξ)) := by
    rw [integral_map hmeas_t.aemeasurable f.continuous.aestronglyMeasurable,
      ← ρ.map_diag_spectralPVM_restrict_inl_apply_inr hρ g ξ]
    exact integral_map hmeas_g.aemeasurable
      (f.continuous.measurable.comp hmeas_t).aestronglyMeasurable
  have hstep1 : |∫ χ, f (torusToOnePoint (dualAction (g : SL(2, ℤ)) χ)) ∂(P.diag (ρ (.inr g) ξ)) -
      ∫ χ, f (torusToOnePoint (dualAction (g : SL(2, ℤ)) χ)) ∂(P.diag ξ)| ≤
      2 * ‖f‖ * ‖ρ (.inr g) ξ - ξ‖ := by
    have hC_int := abs_integral_diag_sub_le P
      (φ := fun χ ↦ f (torusToOnePoint (dualAction (g : SL(2, ℤ)) χ)))
      (f.continuous.measurable.comp (hmeas_t.comp hmeas_g)) (norm_nonneg f)
      (fun χ ↦ by
        simpa [Real.norm_eq_abs] using
          f.norm_coe_le_norm (torusToOnePoint (dualAction (g : SL(2, ℤ)) χ)))
      (ρ (.inr g) ξ) ξ
    rw [hρ.norm_map, hξ] at hC_int
    linarith
  have hstep2 : |∫ χ, f (torusToOnePoint (dualAction (g : SL(2, ℤ)) χ)) ∂(P.diag ξ) -
      ∫ χ, f (sl2zToPSL2R (g : SL(2, ℤ))⁻¹ • torusToOnePoint χ) ∂(P.diag ξ)| ≤
      2 * ‖f‖ * (C * ∑ v ∈ S, ‖ρ (.inl (.ofAdd v)) ξ - ξ‖ ^ 2) :=
    (abs_integral_torusToOnePoint_dualAction_sub_le hP1 hU hUeq f).trans
      (mul_le_mul_of_nonneg_left (hSC ξ) (by positivity))
  have hI3 : ∫ x, f (sl2zToPSL2R (g : SL(2, ℤ))⁻¹ • x) ∂(Measure.map torusToOnePoint (P.diag ξ)) =
      ∫ χ, f (sl2zToPSL2R (g : SL(2, ℤ))⁻¹ • torusToOnePoint χ) ∂(P.diag ξ) :=
    integral_map hmeas_t.aemeasurable
      (f.continuous.comp (continuous_const_smul _)).aestronglyMeasurable
  rw [hI1, hI3]
  exact (abs_sub_le _ (∫ χ, f (torusToOnePoint (dualAction (g : SL(2, ℤ)) χ)) ∂(P.diag ξ)) _).trans
    (add_le_add hstep1 hstep2)

private lemma exists_tendsto_norm_sub_of_hasAlmostInvariantVectors {Γ : Type*} [Group Γ]
    {H : Type*} [NormedAddCommGroup H] [Module ℂ H]
    {ρ : ContRepresentation ℂ Γ H} (halm : ρ.HasAlmostInvariantVectors) :
    ∃ ξ : Finset Γ × ℕ → H, (∀ i, ‖ξ i‖ = 1) ∧
      ∀ γ : Γ, Tendsto (fun i ↦ ‖ρ γ (ξ i) - ξ i‖) (atTop ×ˢ atTop) (𝓝 0) := by
  classical
  have hex (i : Finset Γ × ℕ) :
      ∃ ξ : H, ‖ξ‖ = 1 ∧ ∀ γ ∈ i.1, ‖ρ γ ξ - ξ‖ < 1 / (i.2 + 1 : ℝ) :=
    (ρ.hasAlmostInvariantVectors_def.mp halm) i.1 (1 / (i.2 + 1 : ℝ)) (by positivity)
  choose ξ hξ_norm hξ_alm using hex
  refine ⟨ξ, hξ_norm, fun γ ↦ Metric.tendsto_nhds.mpr fun ε hε ↦ ?_⟩
  obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
  filter_upwards [Filter.prod_mem_prod (Filter.mem_atTop ({γ} : Finset Γ))
    (Filter.mem_atTop N)] with i ⟨hi1, hi2⟩
  rw [Real.dist_0_eq_abs, abs_of_nonneg (norm_nonneg _)]
  have hle : 1 / (i.2 + 1 : ℝ) ≤ 1 / (N + 1 : ℝ) :=
    one_div_le_one_div_of_le (by positivity) (by exact_mod_cast Nat.add_le_add_right hi2 1)
  exact lt_trans (lt_of_lt_of_le (hξ_alm i γ (hi1 (Finset.mem_singleton_self γ))) hle) hN

/-- If a unitary representation of `ℤ² ⋊ G` has almost invariant vectors and no nonzero
`ℤ²`-invariant vector, pushing diagonal spectral measures to `OnePoint ℝ` and taking a weak-⋆
ultrafilter limit produces a `G`-invariant Borel probability measure on `OnePoint ℝ`. -/
private lemma exists_probabilityMeasure_map_smul_eq_of_invariants_eq_bot
    {G : Subgroup SL(2, ℤ)} {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {ρ : ContRepresentation ℂ (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G) H}
    (hρ : ρ.IsUnitary) (halm : ρ.HasAlmostInvariantVectors)
    (hinv : (ρ.restrict SemidirectProduct.inl).invariants = ⊥) :
    ∃ ν : ProbabilityMeasure (OnePoint ℝ),
      ∀ g : G, Measure.map (sl2zToPSL2R (g : SL(2, ℤ)) • ·) (ν : Measure (OnePoint ℝ)) = ν := by
  classical
  have : SecondCountableTopology (OnePoint ℝ) :=
    ChartedSpace.secondCountable_of_sigmaCompact ℝ (OnePoint ℝ)
  have : TopologicalSpace.MetrizableSpace (OnePoint ℝ) :=
    TopologicalSpace.metrizableSpace_of_t3_secondCountable (OnePoint ℝ)
  let Γ := Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G
  set P := (ρ.restrict SemidirectProduct.inl).spectralPVM (hρ.restrict _)
  obtain ⟨ξ, hξ_norm, hdisp⟩ := exists_tendsto_norm_sub_of_hasAlmostInvariantVectors halm
  have hprob (i : Finset Γ × ℕ) : IsProbabilityMeasure (P.diag (ξ i)) :=
    ⟨by
      rw [← ENNReal.ofReal_toReal (measure_ne_top (P.diag (ξ i)) Set.univ),
        P.diag_univ_toReal, hξ_norm i, one_pow, ENNReal.ofReal_one]⟩
  let μs (i : Finset Γ × ℕ) : ProbabilityMeasure (OnePoint ℝ) :=
    ⟨Measure.map torusToOnePoint (P.diag (ξ i)),
      (Measure.isProbabilityMeasure_map_iff measurable_torusToOnePoint.aemeasurable).mpr (hprob i)⟩
  let L : Filter (Finset Γ × ℕ) := atTop ×ˢ atTop
  let 𝒰 : Ultrafilter (Finset Γ × ℕ) := Ultrafilter.of L
  obtain ⟨ν, -, hν_lim⟩ :=
    isCompact_univ.ultrafilter_le_nhds (Ultrafilter.map μs 𝒰) (by simp)
  refine ⟨ν, fun g ↦ ext_of_forall_integral_eq_of_IsFiniteMeasure fun f ↦ ?_⟩
  obtain ⟨S, C, -, hbound⟩ :=
    exists_abs_integral_map_torusToOnePoint_sub_le hρ hinv g⁻¹ f
  have hdiff_zero : Tendsto (fun i : Finset Γ × ℕ ↦
      ∫ x, f x ∂(μs i : Measure (OnePoint ℝ)) -
        ∫ x, f (sl2zToPSL2R (g : SL(2, ℤ)) • x) ∂(μs i : Measure (OnePoint ℝ))) L (𝓝 0) := by
    have hupper : Tendsto (fun i : Finset Γ × ℕ ↦
        2 * ‖f‖ * ‖ρ (.inr g⁻¹) (ξ i) - ξ i‖ +
          2 * ‖f‖ * (C * ∑ v ∈ S, ‖ρ (.inl (.ofAdd v)) (ξ i) - ξ i‖ ^ 2)) L (𝓝 0) := by
      have h1 : Tendsto (fun i ↦ 2 * ‖f‖ * ‖ρ (.inr g⁻¹) (ξ i) - ξ i‖) L (𝓝 0) := by
        simpa using (hdisp (.inr g⁻¹)).const_mul (2 * ‖f‖)
      have h2 : Tendsto (fun i ↦ ∑ v ∈ S, ‖ρ (.inl (.ofAdd v)) (ξ i) - ξ i‖ ^ 2) L (𝓝 0) := by
        rw [← Finset.sum_const_zero (s := S)]
        exact tendsto_finsetSum S fun v _ ↦ by simpa using (hdisp (.inl (.ofAdd v))).pow 2
      simpa using h1.add (((h2.const_mul C).const_mul (2 * ‖f‖)))
    refine squeeze_zero_norm (fun i ↦ ?_) hupper
    simpa [μs, Real.norm_eq_abs] using hbound (ξ i) (hξ_norm i)
  let fg : OnePoint ℝ →ᵇ ℝ :=
    BoundedContinuousFunction.mkOfCompact ⟨fun x ↦ f (sl2zToPSL2R (g : SL(2, ℤ)) • x),
      f.continuous.comp (continuous_const_smul _)⟩
  have hint := ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mp hν_lim
  have hsub := ((hint f).sub (hint fg)).congr fun _ ↦ rfl
  have hzero := tendsto_nhds_unique hsub (hdiff_zero.mono_left (Ultrafilter.of_le L))
  rw [integral_map (continuous_const_smul _).measurable.aemeasurable
    f.continuous.aestronglyMeasurable]
  exact (sub_eq_zero.mp hzero).symm

end Helpers

universe u

/-- **Burger's theorem.** For every nonamenable subgroup `G ≤ SL(2, ℤ)`, the normal subgroup `ℤ²`
has relative property (T) in the semidirect product `ℤ² ⋊ G`. -/
theorem relativePropertyT_inl_of_not_amenable {G : Subgroup SL(2, ℤ)} (hG : ¬ Amenable G) :
    (SemidirectProduct.inl (G := G)
      (φ := slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} := by
  rw [Subgroup.relativePropertyT_def]
  intro H _ _ _ ρ hρ halm
  by_contra! hno
  have hinv : (ρ.restrict SemidirectProduct.inl).invariants = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro v hv
    by_contra hv0
    refine hno v hv0 fun x ↦ ?_
    obtain ⟨a, ha⟩ := x.property
    simpa [← ha] using hv a
  let _ : MeasurableSpace (OnePoint ℝ) := borel (OnePoint ℝ)
  have : BorelSpace (OnePoint ℝ) := ⟨rfl⟩
  obtain ⟨ν, hν⟩ := exists_probabilityMeasure_map_smul_eq_of_invariants_eq_bot hρ halm hinv
  let φ : G →* PSL(2, ℝ) := sl2zToPSL2R.comp G.subtype
  have hrng : φ.range = G.map sl2zToPSL2R :=
    (MonoidHom.range_comp sl2zToPSL2R G.subtype).trans (by rw [Subgroup.range_subtype])
  have : DiscreteTopology φ.range := hrng ▸ Subgroup.discreteTopology_map_sl2zToPSL2R G
  have hker_le : φ.ker.map G.subtype ≤ Subgroup.center SL(2, ℤ) := by
    rintro _ ⟨x, hx, rfl⟩
    exact sl2zToPSL2R_ker ▸ hx
  have : Finite φ.ker := by
    have : Finite (Subgroup.center SL(2, ℤ)) := Matrix.SpecialLinearGroup.finite_center
    refine Finite.of_injective (fun x : φ.ker ↦ (⟨G.subtype x, hker_le ⟨x, x.2, rfl⟩⟩ :
      Subgroup.center SL(2, ℤ))) fun x y h ↦ ?_
    exact Subtype.ext (Subtype.ext
      (congrArg (fun z : Subgroup.center SL(2, ℤ) ↦ (z.1 : SL(2, ℤ))) h))
  exact hG (OnePoint.amenable_of_discrete_range_of_finite_ker_of_map_smul_eq
    (φ := φ) (ν := (ν : Measure (OnePoint ℝ))) hν)

/-- **Burger's theorem (Følner-set formulation).** For every subgroup `G ≤ SL(2, ℤ)` without Følner
sets, `(ℤ² ⋊ G, ℤ²)` has relative property (T). -/
theorem relativePropertyT_inl_of_not_hasFoelnerSets {G : Subgroup SL(2, ℤ)}
    (hG : ¬ HasFoelnerSets G) :
    (SemidirectProduct.inl (G := G)
      (φ := slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} :=
  relativePropertyT_inl_of_not_amenable (mt amenable_iff_hasFoelnerSets.mp hG)

end TauCeti

namespace Subgroup

universe u

/-- **Amenable converse to Burger's theorem.** For every amenable subgroup `G ≤ SL(2, ℤ)`, the
normal subgroup `ℤ²` does not have relative property (T) in `ℤ² ⋊ G`: the ambient semidirect
product is amenable and `ℤ²` is infinite. -/
theorem not_relativePropertyT_inl_of_amenable (G : Subgroup SL(2, ℤ)) [TauCeti.Amenable G] :
    ¬ (SemidirectProduct.inl (G := G)
        (φ := TauCeti.slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} := by
  let N := Multiplicative (Fin 2 → ℤ)
  let Γ := N ⋊[TauCeti.slTwoAction.comp G.subtype] G
  let _ : TopologicalSpace N := ⊥
  have : DiscreteTopology N := ⟨rfl⟩
  have : IsTopologicalGroup N := ⟨⟩
  let _ : TopologicalSpace Γ := ⊥
  have : DiscreteTopology Γ := ⟨rfl⟩
  have : IsTopologicalGroup Γ := ⟨⟩
  have : TauCeti.Amenable Γ :=
    TauCeti.Amenable.of_ker_le_range SemidirectProduct.inl SemidirectProduct.rightHom
      SemidirectProduct.range_inl_eq_ker_rightHom.ge
  let Λ := (SemidirectProduct.inl (G := G) (φ := TauCeti.slTwoAction.comp G.subtype)).range
  have : Infinite Λ := Infinite.of_injective
    (fun n : ℤ ↦ (⟨SemidirectProduct.inl (.ofAdd ![n, 0]), ⟨.ofAdd ![n, 0], rfl⟩⟩ : Λ))
    fun a b h ↦ by
      have h' := SemidirectProduct.inl_injective (congrArg Subtype.val h)
      simpa using congrFun (Multiplicative.ofAdd.injective h') 0
  exact not_relativePropertyT_of_hasFoelnerSets.{u, 0} Λ TauCeti.Amenable.hasFoelnerSets

/-- **Characterization of relative property (T) for `(ℤ² ⋊ G, ℤ²)`.** For a subgroup
`G ≤ SL(2, ℤ)`, the normal subgroup `ℤ²` has relative property (T) in `ℤ² ⋊ G` if and only if `G`
is not amenable. -/
theorem relativePropertyT_inl_iff_not_amenable (G : Subgroup SL(2, ℤ)) :
    (SemidirectProduct.inl (G := G)
        (φ := TauCeti.slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} ↔
      ¬ TauCeti.Amenable G :=
  ⟨fun hT _ ↦ not_relativePropertyT_inl_of_amenable G hT,
    TauCeti.relativePropertyT_inl_of_not_amenable⟩

/-- For a subgroup `G ≤ SL(2, ℤ)`, the normal subgroup `ℤ²` has relative property (T) in `ℤ² ⋊ G`
if and only if `G` does not have Følner sets. -/
theorem relativePropertyT_inl_iff_not_hasFoelnerSets (G : Subgroup SL(2, ℤ)) :
    (SemidirectProduct.inl (G := G)
        (φ := TauCeti.slTwoAction.comp G.subtype)).range.RelativePropertyT.{u} ↔
      ¬ TauCeti.HasFoelnerSets G := by
  rw [relativePropertyT_inl_iff_not_amenable, TauCeti.amenable_iff_hasFoelnerSets]

end Subgroup

namespace TauCeti

universe u

/-- **Kazhdan–Margulis theorem.** The pair `(ℤ² ⋊ SL(2, ℤ), ℤ²)` has relative property (T). -/
theorem relativePropertyT_inl_slTwo :
    (SemidirectProduct.inl (G := SL(2, ℤ)) (φ := slTwoAction)).range.RelativePropertyT.{u} := by
  have htop : ¬ Amenable (⊤ : Subgroup SL(2, ℤ)) :=
    not_amenable_of_injective_freeGroup
      (Subgroup.topEquiv.symm.toMonoidHom.comp
        (FreeGroup.lift ![Matrix.SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) 2,
          Matrix.SpecialLinearGroup.transvection (one_ne_zero : (1 : Fin 2) ≠ 0) 2]))
      (Subgroup.topEquiv.symm.injective.comp injective_freeGroup_lift_transvection_two)
  have hT := relativePropertyT_inl_of_not_amenable.{u} htop
  let e : (Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp (⊤ : Subgroup SL(2, ℤ)).subtype]
      (⊤ : Subgroup SL(2, ℤ))) →* Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction] SL(2, ℤ) :=
    SemidirectProduct.lift SemidirectProduct.inl
      (SemidirectProduct.inr.comp (⊤ : Subgroup SL(2, ℤ)).subtype) fun g ↦
        MonoidHom.ext fun v ↦ by simp [SemidirectProduct.inl_aut]
  have hmap : ((SemidirectProduct.inl (G := (⊤ : Subgroup SL(2, ℤ)))
      (φ := slTwoAction.comp (⊤ : Subgroup SL(2, ℤ)).subtype)).range).map e =
      (SemidirectProduct.inl (G := SL(2, ℤ)) (φ := slTwoAction)).range := by
    rw [← MonoidHom.range_comp]
    congr 1
    exact MonoidHom.ext fun v ↦ by simp [e]
  exact hmap ▸ hT.map e

/-- For any injective homomorphism `f : FreeGroup α →* SL(2, ℤ)` on at least two generators,
`(ℤ² ⋊ f.range, ℤ²)` has relative property (T). -/
theorem relativePropertyT_inl_range_of_injective_freeGroup {α : Type*} [Nontrivial α]
    {f : FreeGroup α →* SL(2, ℤ)} (hf : Function.Injective f) :
    (SemidirectProduct.inl (G := f.range)
        (φ := slTwoAction.comp f.range.subtype)).range.RelativePropertyT.{u} := by
  refine relativePropertyT_inl_of_not_amenable ?_
  exact not_amenable_of_injective_freeGroup f.rangeRestrict fun a b h ↦
    hf (congrArg Subtype.val h)

/-- For Sanov's rank-two free subgroup `F₂ ≤ SL(2, ℤ)` generated by `[[1, 2], [0, 1]]` and
`[[1, 0], [2, 1]]`, the pair `(ℤ² ⋊ F₂, ℤ²)` has relative property (T). -/
theorem relativePropertyT_inl_range_freeGroup_lift_transvection_two :
    let F₂ : Subgroup SL(2, ℤ) :=
      (FreeGroup.lift
        ![Matrix.SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (2 : ℤ),
          Matrix.SpecialLinearGroup.transvection (one_ne_zero : (1 : Fin 2) ≠ 0) (2 : ℤ)]).range
    (SemidirectProduct.inl (N := Multiplicative (Fin 2 → ℤ)) (G := F₂)
      (φ := slTwoAction.comp F₂.subtype)).range.RelativePropertyT.{u} :=
  relativePropertyT_inl_range_of_injective_freeGroup injective_freeGroup_lift_transvection_two

/-- For the unipotent transvection subgroup `{I + n eᵢⱼ : n ∈ ℤ} ≤ SL(2, ℤ)`, the pair
`(ℤ² ⋊ G, ℤ²)` fails relative property (T), showing that nonamenability in Burger's theorem cannot
be dropped. -/
theorem not_relativePropertyT_inl_range_transvectionHom {i j : Fin 2} (hij : i ≠ j) :
    let U : Subgroup SL(2, ℤ) := (Matrix.SpecialLinearGroup.transvectionHom (A := ℤ) hij).range
    ¬ (SemidirectProduct.inl (N := Multiplicative (Fin 2 → ℤ)) (G := U)
        (φ := slTwoAction.comp U.subtype)).range.RelativePropertyT.{u} := by
  intro U
  let ψ : Multiplicative ℤ →ₜ* U :=
    ⟨(Matrix.SpecialLinearGroup.transvectionHom (A := ℤ) hij).rangeRestrict,
      continuous_of_discreteTopology⟩
  have hψ : DenseRange ψ :=
    (Matrix.SpecialLinearGroup.transvectionHom (A := ℤ) hij).rangeRestrict_surjective.denseRange
  have : Amenable U := .of_denseRange ψ hψ
  exact Subgroup.not_relativePropertyT_inl_of_amenable U

end TauCeti
