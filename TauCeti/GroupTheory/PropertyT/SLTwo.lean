namespace TauCeti

/-- `SL(2, ℤ)` is not amenable (for its discrete topology), since it contains Sanov's free subgroup
of rank two. -/
theorem not_amenable_slTwo : ¬ Amenable SL(2, ℤ) :=
  not_amenable_of_injective_freeGroup _ injective_freeGroup_lift_transvection_two

/-- `SL(2, ℤ)` does not have Følner sets. -/
theorem not_hasFoelnerSets_slTwo : ¬ HasFoelnerSets SL(2, ℤ) :=
  mt amenable_iff_hasFoelnerSets.mpr not_amenable_slTwo

end TauCeti

namespace Subgroup

private abbrev IntPlane := Multiplicative (Fin 2 → ℤ)
private abbrev DualTorus := PontryaginDual IntPlane
private abbrev RealProjLine := ℙ ℝ (Fin 2 → ℝ)

private local instance : MeasurableSpace DualTorus := borel DualTorus
private local instance : BorelSpace DualTorus := ⟨rfl⟩
private local instance : MeasurableSpace RealProjLine := borel RealProjLine
private local instance : BorelSpace RealProjLine := ⟨rfl⟩

section SpectralPushforward

/-- The `i`-th standard generator of `ℤ²`, viewed in `Multiplicative (Fin 2 → ℤ)`. -/
private def stdGen (i : Fin 2) : IntPlane :=
  ofAdd (Pi.single i 1)

/-- Principal-branch angular coordinates `(-π, π]²` on the Pontryagin dual of `ℤ²`. -/
private def coord (χ : DualTorus) : Fin 2 → ℝ :=
  fun i => Complex.arg (χ (stdGen i) : ℂ)

private theorem measurable_coord : Measurable coord :=
  measurable_pi_iff.2 fun i =>
    Complex.measurable_arg.comp
      (TauCeti.PontryaginDual.continuous_coe_eval_const (stdGen i)).measurable

private theorem apply_ofAdd_eq_exp (χ : DualTorus) (v : Fin 2 → ℤ) :
    χ (ofAdd v) = Circle.exp ((v 0 : ℝ) * coord χ 0 + (v 1 : ℝ) * coord χ 1) := by
  have hv : v = v 0 • Pi.single 0 1 + v 1 • Pi.single 1 1 := by
    ext j
    fin_cases j <;> simp
  conv_lhs => rw [hv, ofAdd_add, ofAdd_zsmul, ofAdd_zsmul, map_mul, map_zpow, map_zpow]
  rw [Circle.exp_add, Circle.exp_intCast_mul, Circle.exp_intCast_mul]
  simp only [coord, stdGen, Circle.exp_arg]

private theorem coord_eq_zero_iff (χ : DualTorus) : coord χ = 0 ↔ χ = 1 := by
  refine ⟨fun h => ?_, fun h => by ext i; simp [coord, h]⟩
  apply PontryaginDual.ext
  intro v
  obtain ⟨w, rfl⟩ := ofAdd.surjective v
  have h0 : coord χ 0 = 0 := congrFun h 0
  have h1 : coord χ 1 = 0 := congrFun h 1
  simp [apply_ofAdd_eq_exp, h0, h1]

private def defaultLine : RealProjLine :=
  Projectivization.mk ℝ ![1, 0] (by simp)

/-- Radial projection from `𝕋²` to `ℙ ℝ (Fin 2 → ℝ)` in principal-branch coordinates, sending `1`
to an arbitrary basepoint (`{1}` has zero spectral mass when there are no `ℤ²`-invariants). -/
private def projMap (χ : DualTorus) : RealProjLine :=
  let _ := Classical.decEq (Fin 2 → ℝ)
  if h : coord χ = 0 then defaultLine else Projectivization.mk ℝ (coord χ) h

private theorem measurable_projMap : Measurable projMap := by
  let _ := Classical.decEq (Fin 2 → ℝ)
  have hs : MeasurableSet {χ : DualTorus | coord χ = 0} :=
    measurable_coord (measurableSet_singleton 0)
  have hg : Measurable (fun x : ({χ : DualTorus | coord χ = 0}ᶜ : Set DualTorus) =>
      Projectivization.mk ℝ (coord x.1) x.2) :=
    (Projectivization.continuous_mk' (K := ℝ) (V := Fin 2 → ℝ)).measurable.comp
      (measurable_coord.comp measurable_subtype_coe).subtype_mk
  exact Measurable.dite (s := {χ : DualTorus | coord χ = 0}) measurable_const hg hs

/-- The contragredient embedding `g ↦ (g⁻¹)ᵀ` of `SL(2, ℤ)` into `GL(2, ℤ)`. -/
private def dualHom : SL(2, ℤ) →* GL (Fin 2) ℤ :=
  Matrix.GeneralLinearGroup.inverseTranspose.toMonoidHom.comp Matrix.SpecialLinearGroup.toGL

private theorem dualHom_injective : Function.Injective dualHom :=
  Matrix.GeneralLinearGroup.inverseTranspose.injective.comp Matrix.SpecialLinearGroup.toGL_injective

private abbrev dualRealGL (g : SL(2, ℤ)) : GL (Fin 2) ℝ :=
  Matrix.GeneralLinearGroup.map (Int.castRingHom ℝ) (dualHom g)

private theorem coe_dualRealGL_inv (g : SL(2, ℤ)) :
    (dualRealGL g⁻¹ : Matrix (Fin 2) (Fin 2) ℝ) =
      ((Int.castRingHom ℝ).mapMatrix (g : Matrix (Fin 2) (Fin 2) ℤ)).transpose := by
  have hZ :
      (dualHom g⁻¹ : Matrix (Fin 2) (Fin 2) ℤ) = (g : Matrix (Fin 2) (Fin 2) ℤ).transpose := by
    rw [dualHom, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      Matrix.GeneralLinearGroup.coe_inverseTranspose, ← map_inv, inv_inv]
    rfl
  ext i j
  exact congrArg (fun z : ℤ => (z : ℝ)) (congrFun (congrFun hZ i) j)

/-- Radius around `0 ∈ (-π, π]²` inside which `gᵀ` does not wrap around the branch cut `±π`. -/
private def smallRadius (g : SL(2, ℤ)) : ℝ :=
  Real.pi / (2 * (|((g : Matrix (Fin 2) (Fin 2) ℤ) 0 0 : ℝ)| +
    |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 0 : ℝ)| +
    |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 1 : ℝ)| +
    |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 1 : ℝ)| + 1))

private theorem smallRadius_pos (g : SL(2, ℤ)) : 0 < smallRadius g := by
  unfold smallRadius
  positivity

private theorem smallRadius_le_pi (g : SL(2, ℤ)) : smallRadius g ≤ Real.pi := by
  unfold smallRadius
  have hden : 1 ≤ 2 * (|((g : Matrix (Fin 2) (Fin 2) ℤ) 0 0 : ℝ)| +
      |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 0 : ℝ)| +
      |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 1 : ℝ)| +
      |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 1 : ℝ)| + 1) := by
    linarith [abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 0 0 : ℝ),
      abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 0 : ℝ),
      abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 0 1 : ℝ),
      abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 1 : ℝ)]
  exact div_le_self Real.pi_pos.le hden

/-- Near `1 ∈ 𝕋²` and away from `1`, `projMap` intertwines the Pontryagin dual of `slTwoAction g`
with the projective action of `dualRealGL g⁻¹` (`gᵀ`). -/
private theorem projMap_dual_eq_smul (g : SL(2, ℤ)) {χ : DualTorus} (hχ1 : χ ≠ 1)
    (hsmall : ∀ i : Fin 2, |coord χ i| < smallRadius g) :
    projMap (PontryaginDual.map ⟨(TauCeti.slTwoAction g).toMonoidHom,
        continuous_of_discreteTopology⟩ χ) =
      dualRealGL g⁻¹ • projMap χ := by
  let _ := Classical.decEq (Fin 2 → ℝ)
  set αχ : DualTorus :=
    PontryaginDual.map ⟨(TauCeti.slTwoAction g).toMonoidHom, continuous_of_discreteTopology⟩ χ
  have hcoord : coord αχ = dualRealGL g⁻¹ • coord χ := by
    ext i
    have hact : toAdd (TauCeti.slTwoAction g (stdGen i)) =
        fun j => (g : Matrix (Fin 2) (Fin 2) ℤ) j i := by
      rw [TauCeti.slTwoAction_apply_eq_mulVec, stdGen, toAdd_ofAdd, Matrix.mulVec_single_one]
      rfl
    have heval : αχ (stdGen i) =
        Circle.exp (((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ) * coord χ 0 +
          ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ) * coord χ 1) := by
      simp only [αχ, PontryaginDual.map_apply, ContinuousMonoidHom.coe_mk,
        MulEquiv.coe_toMonoidHom]
      rw [← ofAdd_toAdd (TauCeti.slTwoAction g (stdGen i)), hact, apply_ofAdd_eq_exp]
    set C : ℝ := |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 0 : ℝ)| +
      |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 0 : ℝ)| +
      |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 1 : ℝ)| +
      |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 1 : ℝ)| + 1
    have hC_pos : 0 < C := by positivity
    have hr_def : smallRadius g = Real.pi / (2 * C) := rfl
    have hsum_abs : |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ) * coord χ 0 +
        ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ) * coord χ 1| < Real.pi := by
      have htri : |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ) * coord χ 0 +
          ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ) * coord χ 1| ≤
          |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ)| * |coord χ 0| +
          |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ)| * |coord χ 1| := by
        simpa only [abs_mul] using abs_add_le
          (((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ) * coord χ 0)
          (((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ) * coord χ 1)
      have hcol_le : |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ)| +
          |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ)| < C := by
        fin_cases i <;>
          simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue] <;>
          linarith [abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 0 0 : ℝ),
            abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 0 : ℝ),
            abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 0 1 : ℝ),
            abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 1 : ℝ)]
      have hprod : |((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ)| * |coord χ 0| +
          |((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ)| * |coord χ 1| ≤
          C * smallRadius g := by
        nlinarith [hsmall 0, hsmall 1, smallRadius_pos g,
          abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ),
          abs_nonneg ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ)]
      have hCr : C * smallRadius g = Real.pi / 2 := by
        rw [hr_def]
        field_simp [hC_pos.ne']
      linarith [Real.pi_pos]
    have harg : coord αχ i =
        ((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ) * coord χ 0 +
          ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ) * coord χ 1 := by
      rw [coord, heval]
      exact Circle.arg_exp (neg_lt_of_abs_lt hsum_abs) (lt_of_abs_lt hsum_abs).le
    have hrhs : (dualRealGL g⁻¹ • coord χ) i =
        ((g : Matrix (Fin 2) (Fin 2) ℤ) 0 i : ℝ) * coord χ 0 +
          ((g : Matrix (Fin 2) (Fin 2) ℤ) 1 i : ℝ) * coord χ 1 := by
      rw [Units.smul_def, Matrix.smul_eq_mulVec, coe_dualRealGL_inv]
      simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two]
    exact harg.trans hrhs.symm
  have hχ0 : coord χ ≠ 0 := mt (coord_eq_zero_iff χ).mp hχ1
  have hαχ0 : coord αχ ≠ 0 := by
    rw [hcoord]
    exact fun h => hχ0 ((MulAction.injective (dualRealGL g⁻¹)) (h.trans (smul_zero _).symm))
  simp only [projMap, hχ0, hαχ0, ↓reduceDIte]
  rw [Projectivization.smul_mk]
  exact (Projectivization.mk_eq_mk_iff' ℝ _ _ _ _).2 ⟨1, by simp [hcoord]⟩

private theorem norm_sq_circleExp_sub_one (θ : ℝ) :
    ‖(Circle.exp θ : ℂ) - 1‖ ^ 2 = 2 * (1 - Real.cos θ) := by
  rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply, Circle.coe_exp, Complex.exp_mul_I]
  simp only [Complex.sub_re, Complex.add_re, Complex.cos_ofReal_re, Complex.mul_re,
    Complex.sin_ofReal_re, Complex.I_re, mul_zero, Complex.sin_ofReal_im, Complex.I_im,
    mul_one, sub_zero, add_zero, Complex.one_re, Complex.sub_im, Complex.add_im,
    Complex.cos_ofReal_im, zero_add, Complex.mul_im, Complex.one_im]
  nlinarith [Real.cos_sq_add_sin_sq θ]

/-- Chebyshev/Markov bound on the spectral tail `{χ | r ≤ |coord χ i|}` in terms of the
displacement of `η` under the `i`-th standard generator of `ℤ²`. -/
private theorem diag_real_ge_coord_le {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {π : ContRepresentation ℂ IntPlane H} (hπ : π.IsUnitary) (η : H)
    {r : ℝ} (hr : 0 < r) (hr_pi : r ≤ Real.pi) (i : Fin 2) :
    ((π.spectralPVM hπ).diag η).real {χ : DualTorus | r ≤ |coord χ i|} ≤
      ‖π (stdGen i) η - η‖ ^ 2 / (2 * (1 - Real.cos r)) := by
  set P := π.spectralPVM hπ
  have hcos_lt : Real.cos r < 1 := by
    simpa only [Real.cos_zero] using
      Real.strictAntiOn_cos ⟨le_rfl, Real.pi_pos.le⟩ ⟨hr.le, hr_pi⟩ hr
  have hden_pos : 0 < 2 * (1 - Real.cos r) := by linarith
  let fi : TauCeti.BoundedBorelFunction DualTorus :=
    TauCeti.BoundedBorelFunction.ofContinuousMap
      (PontryaginDual.evalBoundedContinuous (Pi.single i (1 : ℤ))).toContinuousMap - 1
  have hP_fi : P.integral fi η = π (stdGen i) η - η := by
    dsimp only [P, fi]
    rw [map_sub, map_one, ContRepresentation.integral_spectralPVM_evalBoundedContinuous]
    rfl
  have hnorm_sq : ‖π (stdGen i) η - η‖ ^ 2 = ∫ χ, ‖fi χ‖ ^ 2 ∂(P.diag η) := by
    rw [← hP_fi, P.norm_sq_integral_apply]
  have hS : MeasurableSet {χ : DualTorus | r ≤ |coord χ i|} :=
    measurableSet_le measurable_const
      (continuous_abs.measurable.comp ((measurable_pi_apply i).comp measurable_coord))
  have hint : Integrable (fun χ => ‖fi χ‖ ^ 2) (P.diag η) :=
    .of_bound (fi.measurable.norm.pow_const 2).aestronglyMeasurable (‖fi‖ ^ 2)
      (Eventually.of_forall fun χ => by
        rw [Real.norm_of_nonneg (by positivity)]
        exact pow_le_pow_left₀ (norm_nonneg _) (fi.norm_coe_le_norm χ) 2)
  have hpt : ({χ : DualTorus | r ≤ |coord χ i|}.indicator fun _ => 2 * (1 - Real.cos r)) ≤
      fun χ => ‖fi χ‖ ^ 2 := by
    intro χ
    by_cases hχ : r ≤ |coord χ i|
    · rw [Set.indicator_of_mem hχ]
      have hcos_le : Real.cos |coord χ i| ≤ Real.cos r :=
        Real.strictAntiOn_cos.antitoneOn ⟨hr.le, hr_pi⟩
          ⟨abs_nonneg _, Complex.abs_arg_le_pi _⟩ hχ
      rw [Real.cos_abs] at hcos_le
      have hfi_val : ‖fi χ‖ ^ 2 = 2 * (1 - Real.cos (coord χ i)) := by
        have hχ_exp : (χ (stdGen i) : ℂ) = Circle.exp (coord χ i) :=
          congrArg (fun z : Circle => (z : ℂ)) (Circle.exp_arg (χ (stdGen i))).symm
        have hcoe : fi χ = (χ (stdGen i) : ℂ) - 1 := by simp [fi, stdGen]
        rw [hcoe, hχ_exp, norm_sq_circleExp_sub_one]
      linarith
    · rw [Set.indicator_of_notMem hχ]
      positivity
  have hint_le := integral_mono ((integrable_const _).indicator hS) hint hpt
  rw [integral_indicator_const _ hS, smul_eq_mul, ← hnorm_sq] at hint_le
  exact (le_div_iff₀ hden_pos).2 hint_le

/-- Variation of a bounded Borel integral against `P.diag` between two unit vectors `η` and `ξ`. -/
private theorem abs_integral_projMap_sub_le {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] (P : TauCeti.ProjValMeasure DualTorus H)
    (f : RealProjLine →ᵇ ℝ) {η ξ : H} (hη : ‖η‖ = 1) (hξ : ‖ξ‖ = 1) :
    |∫ χ, f (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap χ) ∂(P.diag ξ)| ≤
      2 * ‖f‖ * ‖η - ξ‖ := by
  let F : TauCeti.BoundedBorelFunction DualTorus :=
    TauCeti.BoundedBorelFunction.ofFunction (fun χ => (f (projMap χ) : ℂ))
      (Complex.continuous_ofReal.measurable.comp (f.continuous.measurable.comp measurable_projMap))
      ⟨‖f‖, norm_nonneg f, fun χ => by simpa using f.norm_coe_le_norm (projMap χ)⟩
  have hT_norm : ‖P.integral F‖ ≤ ‖f‖ :=
    P.norm_integral_le (norm_nonneg f) fun χ => by simpa [F] using f.norm_coe_le_norm (projMap χ)
  have hint_eq (ζ : H) : ((∫ χ, f (projMap χ) ∂(P.diag ζ) : ℝ) : ℂ) = ⟪ζ, P.integral F ζ⟫_ℂ := by
    rw [← integral_complex_ofReal]
    simpa only [F, TauCeti.BoundedBorelFunction.ofFunction_apply] using
      P.integral_diag_eq_inner_integral F ζ
  have hdiff : (((∫ χ, f (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap χ) ∂(P.diag ξ) : ℝ)) : ℂ) =
      ⟪η - ξ, P.integral F η⟫_ℂ + ⟪ξ, P.integral F (η - ξ)⟫_ℂ := by
    rw [Complex.ofReal_sub, hint_eq η, hint_eq ξ, inner_sub_left, map_sub, inner_sub_right]
    ring
  calc |∫ χ, f (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap χ) ∂(P.diag ξ)|
      = ‖(((∫ χ, f (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap χ) ∂(P.diag ξ) : ℝ)) : ℂ)‖ :=
        (Complex.norm_real _).symm
    _ = ‖⟪η - ξ, P.integral F η⟫_ℂ + ⟪ξ, P.integral F (η - ξ)⟫_ℂ‖ := by rw [hdiff]
    _ ≤ ‖⟪η - ξ, P.integral F η⟫_ℂ‖ + ‖⟪ξ, P.integral F (η - ξ)⟫_ℂ‖ := norm_add_le _ _
    _ ≤ ‖η - ξ‖ * ‖P.integral F η‖ + ‖ξ‖ * ‖P.integral F (η - ξ)‖ :=
        add_le_add (norm_inner_le_norm _ _) (norm_inner_le_norm _ _)
    _ ≤ ‖η - ξ‖ * (‖f‖ * ‖η‖) + ‖ξ‖ * (‖f‖ * ‖η - ξ‖) := by
        gcongr
        · exact ((P.integral F).le_opNorm η).trans
            (mul_le_mul_of_nonneg_right hT_norm (norm_nonneg η))
        · exact ((P.integral F).le_opNorm (η - ξ)).trans
            (mul_le_mul_of_nonneg_right hT_norm (norm_nonneg (η - ξ)))
    _ = 2 * ‖f‖ * ‖η - ξ‖ := by
        rw [hη, hξ]
        ring

/-- Quantitative almost-invariance estimate for the projective pushforward `ν_ξ` of `P.diag ξ`:
when `ρ` has no nonzero `ℤ²`-invariant vectors, the failure of `ν_ξ` to be invariant under
`dualRealGL (ψ k)⁻¹` on a test function `f` is bounded by the displacements of `ξ` under `inr k`
and the two standard generators of `ℤ²`. -/
private theorem abs_integral_map_projMap_sub_le {K : Type*} [Group K] (ψ : K →* SL(2, ℤ))
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {ρ : ContRepresentation ℂ (IntPlane ⋊[TauCeti.slTwoAction.comp ψ] K) H}
    (hρ : ρ.IsUnitary) (hinv : (ρ.restrict inl).invariants = ⊥)
    (k : K) (f : RealProjLine →ᵇ ℝ) {ξ : H} (hξ : ‖ξ‖ = 1) :
    let ν := Measure.map projMap (((ρ.restrict inl).spectralPVM (hρ.restrict _)).diag ξ)
    let r := smallRadius (ψ k)
    |∫ x, f (dualRealGL (ψ k)⁻¹ • x) ∂ν - ∫ x, f x ∂ν| ≤
      4 * ‖f‖ * ‖ρ (inr k) ξ - ξ‖ +
        2 * ‖f‖ * ((2 * ‖ρ (inr k) ξ - ξ‖ + ‖ρ (inl (stdGen 0)) ξ - ξ‖) ^ 2 +
          (2 * ‖ρ (inr k) ξ - ξ‖ + ‖ρ (inl (stdGen 1)) ξ - ξ‖) ^ 2) /
          (2 * (1 - Real.cos r)) := by
  intro ν r
  set P := (ρ.restrict inl).spectralPVM (hρ.restrict _)
  set η := ρ (inr k) ξ
  have hη : ‖η‖ = 1 := by rw [← hξ]; exact hρ.norm_map (inr k) ξ
  let fk : RealProjLine →ᵇ ℝ :=
    f.compContinuous ⟨(dualRealGL (ψ k)⁻¹ • ·), continuous_const_smul _⟩
  have hfk_norm : ‖fk‖ ≤ ‖f‖ := f.norm_compContinuous_le _
  have hint_ν_fk : ∫ x, f (dualRealGL (ψ k)⁻¹ • x) ∂ν = ∫ χ, fk (projMap χ) ∂(P.diag ξ) :=
    integral_map measurable_projMap.aemeasurable fk.continuous.aestronglyMeasurable
  have hint_ν_f : ∫ x, f x ∂ν = ∫ χ, f (projMap χ) ∂(P.diag ξ) :=
    integral_map measurable_projMap.aemeasurable f.continuous.aestronglyMeasurable
  -- Equivariance of `P.diag` moves `P.diag ξ` back to `P.diag η`.
  let αk : DualTorus →ₜ* DualTorus :=
    PontryaginDual.map ⟨(TauCeti.slTwoAction (ψ k)).toMonoidHom, continuous_of_discreteTopology⟩
  have hmap_diag : Measure.map αk (P.diag η) = P.diag ξ :=
    ContRepresentation.map_diag_spectralPVM_restrict_inl_apply_inr hρ k ξ
  have hint_ξ_eq_η : ∫ χ, f (projMap χ) ∂(P.diag ξ) = ∫ χ, f (projMap (αk χ)) ∂(P.diag η) := by
    rw [← hmap_diag]
    exact integral_map (map_continuous αk).aemeasurable
      (f.continuous.measurable.comp measurable_projMap).aestronglyMeasurable
  -- Step 1: replace `P.diag ξ` by `P.diag η` in the `fk` integral.
  have hstep1 : |∫ χ, fk (projMap χ) ∂(P.diag ξ) - ∫ χ, fk (projMap χ) ∂(P.diag η)| ≤
      2 * ‖f‖ * ‖η - ξ‖ := by
    rw [abs_sub_comm]
    exact (abs_integral_projMap_sub_le P fk hη hξ).trans
      (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hfk_norm zero_le_two) (norm_nonneg _))
  -- Step 2: on `P.diag η`, `fk ∘ projMap` and `f ∘ projMap ∘ αk` agree outside `{1}` and the tails.
  let B0 : Set DualTorus := {χ | r ≤ |coord χ 0|}
  let B1 : Set DualTorus := {χ | r ≤ |coord χ 1|}
  let Bad : Set DualTorus := ({1} : Set DualTorus) ∪ B0 ∪ B1
  have hB0_meas : MeasurableSet B0 :=
    measurableSet_le measurable_const
      (continuous_abs.measurable.comp ((measurable_pi_apply 0).comp measurable_coord))
  have hB1_meas : MeasurableSet B1 :=
    measurableSet_le measurable_const
      (continuous_abs.measurable.comp ((measurable_pi_apply 1).comp measurable_coord))
  have hBad_meas : MeasurableSet Bad :=
    ((measurableSet_singleton 1).union hB0_meas).union hB1_meas
  have hP1 : P.proj {1} (measurableSet_singleton 1) = 0 :=
    ((ρ.restrict inl).spectralPVM_proj_singleton_one_eq_zero_iff (hρ.restrict _)).2 hinv
  have hdiag1 : (P.diag η).real {1} = 0 := by
    rw [measureReal_def, ← P.norm_sq_proj_apply {1} (measurableSet_singleton 1) η, hP1]
    simp
  have hg1 : Integrable (fun χ => fk (projMap χ)) (P.diag η) :=
    .of_bound (fk.continuous.measurable.comp measurable_projMap).aestronglyMeasurable ‖fk‖
      (Eventually.of_forall fun χ => fk.norm_coe_le_norm _)
  have hg2 : Integrable (fun χ => f (projMap (αk χ))) (P.diag η) :=
    .of_bound ((f.continuous.measurable.comp measurable_projMap).comp
        (map_continuous αk).measurable).aestronglyMeasurable ‖f‖
      (Eventually.of_forall fun χ => f.norm_coe_le_norm _)
  have hpt_bad (χ : DualTorus) :
      |fk (projMap χ) - f (projMap (αk χ))| ≤ Bad.indicator (fun _ => 2 * ‖f‖) χ := by
    by_cases hχ : χ ∈ Bad
    · rw [Set.indicator_of_mem hχ]
      calc |fk (projMap χ) - f (projMap (αk χ))|
          ≤ |fk (projMap χ)| + |f (projMap (αk χ))| := abs_sub _ _
        _ ≤ ‖fk‖ + ‖f‖ := add_le_add (fk.norm_coe_le_norm _) (f.norm_coe_le_norm _)
        _ ≤ 2 * ‖f‖ := by linarith
    · rw [Set.indicator_of_notMem hχ]
      have hχ1 : χ ≠ 1 := fun h => hχ (Or.inl (Or.inl h))
      have hsmall : ∀ i : Fin 2, |coord χ i| < r := by
        intro i
        fin_cases i
        · exact lt_of_not_ge fun h => hχ (Or.inl (Or.inr h))
        · exact lt_of_not_ge fun h => hχ (Or.inr h)
      have heq := projMap_dual_eq_smul (ψ k) hχ1 hsmall
      simp only [fk, BoundedContinuousFunction.compContinuous_apply, ContinuousMap.coe_mk,
        αk, heq, sub_self, abs_zero, le_rfl]
  have hstep2_raw : |∫ χ, fk (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap (αk χ)) ∂(P.diag η)| ≤
      2 * ‖f‖ * (P.diag η).real Bad := by
    rw [← integral_sub hg1 hg2]
    calc |∫ χ, (fk (projMap χ) - f (projMap (αk χ))) ∂(P.diag η)|
        ≤ ∫ χ, |fk (projMap χ) - f (projMap (αk χ))| ∂(P.diag η) :=
          by simpa only [Real.norm_eq_abs] using
            norm_integral_le_integral_norm (fun χ => fk (projMap χ) - f (projMap (αk χ)))
      _ ≤ ∫ χ, Bad.indicator (fun _ => 2 * ‖f‖) χ ∂(P.diag η) :=
          integral_mono (hg1.sub hg2).abs ((integrable_const _).indicator hBad_meas) hpt_bad
      _ = 2 * ‖f‖ * (P.diag η).real Bad := by
          rw [integral_indicator_const _ hBad_meas, smul_eq_mul, mul_comm]
  have hBad_le : (P.diag η).real Bad ≤ (P.diag η).real B0 + (P.diag η).real B1 := by
    calc (P.diag η).real (({1} ∪ B0) ∪ B1)
        ≤ (P.diag η).real ({1} ∪ B0) + (P.diag η).real B1 := measureReal_union_le _ _
      _ ≤ ((P.diag η).real {1} + (P.diag η).real B0) + (P.diag η).real B1 := by
          gcongr
          exact measureReal_union_le _ _
      _ = (P.diag η).real B0 + (P.diag η).real B1 := by rw [hdiag1, zero_add]
  have hdisp_η (i : Fin 2) :
      ‖(ρ.restrict inl) (stdGen i) η - η‖ ≤ 2 * ‖η - ξ‖ + ‖ρ (inl (stdGen i)) ξ - ξ‖ := by
    have hsplit : ρ (inl (stdGen i)) η - η =
        ρ (inl (stdGen i)) (η - ξ) + (ρ (inl (stdGen i)) ξ - ξ) - (η - ξ) := by
      rw [map_sub]
      abel
    rw [ContRepresentation.restrict_apply, hsplit]
    calc ‖ρ (inl (stdGen i)) (η - ξ) + (ρ (inl (stdGen i)) ξ - ξ) - (η - ξ)‖
        ≤ ‖ρ (inl (stdGen i)) (η - ξ) + (ρ (inl (stdGen i)) ξ - ξ)‖ + ‖η - ξ‖ := norm_sub_le _ _
      _ ≤ ‖ρ (inl (stdGen i)) (η - ξ)‖ + ‖ρ (inl (stdGen i)) ξ - ξ‖ + ‖η - ξ‖ := by
          gcongr
          exact norm_add_le _ _
      _ = 2 * ‖η - ξ‖ + ‖ρ (inl (stdGen i)) ξ - ξ‖ := by
          rw [hρ.norm_map]
          ring
  have hcos_lt : Real.cos r < 1 := by
    simpa only [Real.cos_zero] using
      Real.strictAntiOn_cos ⟨le_rfl, Real.pi_pos.le⟩ ⟨(smallRadius_pos _).le, smallRadius_le_pi _⟩
        (smallRadius_pos _)
  have hden_pos : 0 < 2 * (1 - Real.cos r) := by linarith
  have hB0_bound : (P.diag η).real B0 ≤
      (2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 0)) ξ - ξ‖) ^ 2 / (2 * (1 - Real.cos r)) :=
    (diag_real_ge_coord_le (hρ.restrict _) η (smallRadius_pos _) (smallRadius_le_pi _) 0).trans
      (div_le_div_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hdisp_η 0) 2) hden_pos.le)
  have hB1_bound : (P.diag η).real B1 ≤
      (2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 1)) ξ - ξ‖) ^ 2 / (2 * (1 - Real.cos r)) :=
    (diag_real_ge_coord_le (hρ.restrict _) η (smallRadius_pos _) (smallRadius_le_pi _) 1).trans
      (div_le_div_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hdisp_η 1) 2) hden_pos.le)
  have hstep2 : |∫ χ, fk (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap (αk χ)) ∂(P.diag η)| ≤
      2 * ‖f‖ * ((2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 0)) ξ - ξ‖) ^ 2 +
        (2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 1)) ξ - ξ‖) ^ 2) / (2 * (1 - Real.cos r)) := by
    calc |∫ χ, fk (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap (αk χ)) ∂(P.diag η)|
        ≤ 2 * ‖f‖ * (P.diag η).real Bad := hstep2_raw
      _ ≤ 2 * ‖f‖ * ((P.diag η).real B0 + (P.diag η).real B1) :=
          mul_le_mul_of_nonneg_left hBad_le (by positivity)
      _ ≤ 2 * ‖f‖ * ((2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 0)) ξ - ξ‖) ^ 2 / (2 * (1 - Real.cos r)) +
            (2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 1)) ξ - ξ‖) ^ 2 / (2 * (1 - Real.cos r))) :=
          mul_le_mul_of_nonneg_left (add_le_add hB0_bound hB1_bound) (by positivity)
      _ = 2 * ‖f‖ * ((2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 0)) ξ - ξ‖) ^ 2 +
            (2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 1)) ξ - ξ‖) ^ 2) / (2 * (1 - Real.cos r)) := by
          ring
  rw [hint_ν_fk, hint_ν_f, hint_ξ_eq_η]
  calc |∫ χ, fk (projMap χ) ∂(P.diag ξ) - ∫ χ, f (projMap (αk χ)) ∂(P.diag η)|
      = |(∫ χ, fk (projMap χ) ∂(P.diag ξ) - ∫ χ, fk (projMap χ) ∂(P.diag η)) +
          (∫ χ, fk (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap (αk χ)) ∂(P.diag η))| := by ring_nf
    _ ≤ |∫ χ, fk (projMap χ) ∂(P.diag ξ) - ∫ χ, fk (projMap χ) ∂(P.diag η)| +
          |∫ χ, fk (projMap χ) ∂(P.diag η) - ∫ χ, f (projMap (αk χ)) ∂(P.diag η)| := abs_add_le _ _
    _ ≤ 2 * ‖f‖ * ‖η - ξ‖ +
          2 * ‖f‖ * ((2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 0)) ξ - ξ‖) ^ 2 +
            (2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 1)) ξ - ξ‖) ^ 2) / (2 * (1 - Real.cos r)) :=
        add_le_add hstep1 hstep2
    _ ≤ 4 * ‖f‖ * ‖η - ξ‖ +
          2 * ‖f‖ * ((2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 0)) ξ - ξ‖) ^ 2 +
            (2 * ‖η - ξ‖ + ‖ρ (inl (stdGen 1)) ξ - ξ‖) ^ 2) / (2 * (1 - Real.cos r)) := by
        have : 0 ≤ ‖f‖ * ‖η - ξ‖ := by positivity
        linarith

end SpectralPushforward

universe u v

/-- **Burger's theorem (sufficiency).** If a group `G` embeds into `SL(2, ℤ)` via `ψ` and does not
have Følner sets, then `ℤ²` has relative property (T) inside `ℤ² ⋊ G`. -/
theorem relativePropertyT_inl_of_not_hasFoelnerSets {G : Type v} [Group G]
    {ψ : G →* SL(2, ℤ)} (hψ : Function.Injective ψ) (hG : ¬ TauCeti.HasFoelnerSets G) :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp ψ] G).range.RelativePropertyT.{u} := by
  classical
  rw [relativePropertyT_def]
  intro H _ _ _ ρ hρ hρ_almost
  by_contra! hno_inv
  have hinv_bot : (ρ.restrict inl).invariants = ⊥ := by
    rw [eq_bot_iff]
    intro v hv
    by_contra hv0
    exact hno_inv v hv0 fun ⟨_, ⟨n, rfl⟩⟩ => hv n
  set P := (ρ.restrict inl).spectralPVM (hρ.restrict _)
  -- Index almost invariant unit vectors by `(F, n) : Finset G × ℕ`.
  let testSet (F : Finset G) : Finset (IntPlane ⋊[TauCeti.slTwoAction.comp ψ] G) :=
    F.image inr ∪ {inl (stdGen 0), inl (stdGen 1)}
  have hex (p : Finset G × ℕ) :
      ∃ ξ : H, ‖ξ‖ = 1 ∧ ∀ γ ∈ testSet p.1, ‖ρ γ ξ - ξ‖ < 1 / ((p.2 : ℝ) + 1) :=
    (ContRepresentation.hasAlmostInvariantVectors_def ρ).mp hρ_almost (testSet p.1)
      (1 / ((p.2 : ℝ) + 1)) (by positivity)
  choose ξ hξ_norm hξ_small using hex
  have hprob_diag (p : Finset G × ℕ) : IsProbabilityMeasure (P.diag (ξ p)) := by
    refine ⟨?_⟩
    rw [P.diag_univ, ← ofReal_norm, hξ_norm p]
    simp
  let ν (p : Finset G × ℕ) : ProbabilityMeasure RealProjLine :=
    ⟨Measure.map projMap (P.diag (ξ p)),
      (Measure.isProbabilityMeasure_map_iff measurable_projMap.aemeasurable).mpr (hprob_diag p)⟩
  -- Extract a Prokhorov / weak-star cluster point on the compact space `ℙ ℝ (Fin 2 → ℝ)`.
  obtain ⟨ν₀, hν₀⟩ := exists_clusterPt_of_compactSpace (Filter.map ν atTop)
  have hν₀_inv (g : G) : Measure.map (dualRealGL (ψ g)⁻¹ • ·) (ν₀ : Measure RealProjLine) = ν₀ := by
    refine ext_of_forall_integral_eq_of_IsFiniteMeasure fun f => ?_
    let fk : RealProjLine →ᵇ ℝ :=
      f.compContinuous ⟨(dualRealGL (ψ g)⁻¹ • ·), continuous_const_smul _⟩
    let Φ : ProbabilityMeasure RealProjLine → ℝ :=
      fun μ => ∫ x, fk x ∂(μ : Measure RealProjLine) - ∫ x, f x ∂(μ : Measure RealProjLine)
    have hΦ_cont : Continuous Φ :=
      (ProbabilityMeasure.continuous_integral_boundedContinuousFunction fk).sub
        (ProbabilityMeasure.continuous_integral_boundedContinuousFunction f)
    set r := smallRadius (ψ g)
    have hcos_lt : Real.cos r < 1 := by
      simpa only [Real.cos_zero] using
        Real.strictAntiOn_cos ⟨le_rfl, Real.pi_pos.le⟩ ⟨(smallRadius_pos _).le, smallRadius_le_pi _⟩
          (smallRadius_pos _)
    have hden_pos : 0 < 2 * (1 - Real.cos r) := by linarith
    let B : ℕ → ℝ := fun n =>
      4 * ‖f‖ * (1 / ((n : ℝ) + 1)) +
        2 * ‖f‖ * (18 * (1 / ((n : ℝ) + 1)) ^ 2) / (2 * (1 - Real.cos r))
    have h1n : Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) atTop (𝓝 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat
    have hB_zero : Tendsto B atTop (𝓝 0) := by
      have hlin : Tendsto (fun n : ℕ => 4 * ‖f‖ * (1 / ((n : ℝ) + 1))) atTop (𝓝 0) := by
        simpa using h1n.const_mul (4 * ‖f‖)
      have hquad : Tendsto (fun n : ℕ =>
          2 * ‖f‖ * (18 * (1 / ((n : ℝ) + 1)) ^ 2) / (2 * (1 - Real.cos r))) atTop (𝓝 0) := by
        simpa using (((h1n.pow 2).const_mul 18).const_mul (2 * ‖f‖)).div_const
          (2 * (1 - Real.cos r))
      simpa [B] using hlin.add hquad
    have hΦ_bound : ∀ᶠ p : Finset G × ℕ in atTop, ‖Φ (ν p)‖ ≤ B p.2 := by
      filter_upwards [Filter.eventually_ge_atTop ({g}, 0)] with p hp
      have hg_mem : g ∈ p.1 := Finset.singleton_subset_iff.mp hp.1
      set δ : ℝ := 1 / ((p.2 : ℝ) + 1)
      have hk_lt : ‖ρ (inr g) (ξ p) - ξ p‖ < δ :=
        hξ_small p (inr g) (Finset.mem_union_left _ (Finset.mem_image_of_mem inr hg_mem))
      have h0_lt : ‖ρ (inl (stdGen 0)) (ξ p) - ξ p‖ < δ :=
        hξ_small p (inl (stdGen 0)) (Finset.mem_union_right _ (by simp))
      have h1_lt : ‖ρ (inl (stdGen 1)) (ξ p) - ξ p‖ < δ :=
        hξ_small p (inl (stdGen 1)) (Finset.mem_union_right _ (by simp))
      have hsq0 : (2 * ‖ρ (inr g) (ξ p) - ξ p‖ + ‖ρ (inl (stdGen 0)) (ξ p) - ξ p‖) ^ 2 ≤
          9 * δ ^ 2 := by
        have hle : 2 * ‖ρ (inr g) (ξ p) - ξ p‖ + ‖ρ (inl (stdGen 0)) (ξ p) - ξ p‖ ≤ 3 * δ := by
          linarith
        calc (2 * ‖ρ (inr g) (ξ p) - ξ p‖ + ‖ρ (inl (stdGen 0)) (ξ p) - ξ p‖) ^ 2
            ≤ (3 * δ) ^ 2 := pow_le_pow_left₀ (by positivity) hle 2
          _ = 9 * δ ^ 2 := by ring
      have hsq1 : (2 * ‖ρ (inr g) (ξ p) - ξ p‖ + ‖ρ (inl (stdGen 1)) (ξ p) - ξ p‖) ^ 2 ≤
          9 * δ ^ 2 := by
        have hle : 2 * ‖ρ (inr g) (ξ p) - ξ p‖ + ‖ρ (inl (stdGen 1)) (ξ p) - ξ p‖ ≤ 3 * δ := by
          linarith
        calc (2 * ‖ρ (inr g) (ξ p) - ξ p‖ + ‖ρ (inl (stdGen 1)) (ξ p) - ξ p‖) ^ 2
            ≤ (3 * δ) ^ 2 := pow_le_pow_left₀ (by positivity) hle 2
          _ = 9 * δ ^ 2 := by ring
      have hest := abs_integral_map_projMap_sub_le ψ hρ hinv_bot g f (hξ_norm p)
      rw [Real.norm_eq_abs]
      refine hest.trans ?_
      have hterm1 : 4 * ‖f‖ * ‖ρ (inr g) (ξ p) - ξ p‖ ≤ 4 * ‖f‖ * δ :=
        mul_le_mul_of_nonneg_left hk_lt.le (by positivity)
      have hterm2 :
          2 * ‖f‖ * ((2 * ‖ρ (inr g) (ξ p) - ξ p‖ + ‖ρ (inl (stdGen 0)) (ξ p) - ξ p‖) ^ 2 +
            (2 * ‖ρ (inr g) (ξ p) - ξ p‖ + ‖ρ (inl (stdGen 1)) (ξ p) - ξ p‖) ^ 2) /
            (2 * (1 - Real.cos r)) ≤
          2 * ‖f‖ * (18 * δ ^ 2) / (2 * (1 - Real.cos r)) := by
        refine div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ (by positivity)) hden_pos.le
        linarith
      dsimp only [B]
      linarith
    have hΦ_tendsto : Tendsto (Φ ∘ ν) atTop (𝓝 0) :=
      squeeze_zero_norm' hΦ_bound
        (hB_zero.comp (monotone_snd.tendsto_atTop_atTop fun n => ⟨(∅, n), le_rfl⟩))
    have := hν₀.neBot
    have hΦ_ν₀ : Φ ν₀ = 0 :=
      tendsto_nhds_unique ((hΦ_cont.tendsto ν₀).mono_left inf_le_left)
        ((tendsto_map'_iff.2 hΦ_tendsto).mono_left inf_le_right)
    have hint_map : ∫ x, f x ∂(Measure.map (dualRealGL (ψ g)⁻¹ • ·) (ν₀ : Measure RealProjLine)) =
        ∫ x, fk x ∂(ν₀ : Measure RealProjLine) :=
      integral_map (continuous_const_smul _).aemeasurable f.continuous.aestronglyMeasurable
    linarith [show ∫ x, fk x ∂(ν₀ : Measure RealProjLine) -
        ∫ x, f x ∂(ν₀ : Measure RealProjLine) = 0 from hΦ_ν₀]
  have hFoelner : TauCeti.HasFoelnerSets G :=
    TauCeti.hasFoelnerSets_of_injective_gl_int_of_map_smul_projectivization_eq
      (ψ := dualHom.comp ψ) (dualHom_injective.comp hψ) (μ := (ν₀ : Measure RealProjLine))
      fun g => by simpa [dualRealGL] using hν₀_inv g⁻¹
  exact hG hFoelner

/-- **Burger's theorem (necessity).** If a group `G` embeds into `SL(2, ℤ)` via `ψ` and has Følner
sets, then `ℤ²` does not have relative property (T) inside `ℤ² ⋊ G` in any Hilbert-space universe
`u`. -/
theorem not_relativePropertyT_inl_of_hasFoelnerSets {G : Type v} [Group G]
    {ψ : G →* SL(2, ℤ)} (hψ : Function.Injective ψ) (hG : TauCeti.HasFoelnerSets G) :
    ¬ (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp ψ] G).range.RelativePropertyT.{u} := by
  let Γ := IntPlane ⋊[TauCeti.slTwoAction.comp ψ] G
  let Γ₀ := IntPlane ⋊[TauCeti.slTwoAction.comp ψ.range.subtype] ψ.range
  let eG : G ≃* ψ.range := MonoidHom.ofInjective hψ
  let e₀ : Γ ≃* Γ₀ := SemidirectProduct.congr (MulEquiv.refl IntPlane) eG fun g => by
    ext v
    rfl
  -- Show that `Γ₀` (in `Type 0`) has Følner sets as an extension of `ψ.range` by abelian `ℤ²`.
  have hF_range : TauCeti.HasFoelnerSets ψ.range := eG.symm.hasFoelnerSets_iff.mpr hG
  have hF₀ : TauCeti.HasFoelnerSets Γ₀ := by
    let _ : TopologicalSpace IntPlane := ⊥
    have : DiscreteTopology IntPlane := ⟨rfl⟩
    let _ : TopologicalSpace Γ₀ := ⊥
    have : DiscreteTopology Γ₀ := ⟨rfl⟩
    have : TauCeti.Amenable ψ.range := .of_hasFoelnerSets hF_range
    have : TauCeti.Amenable Γ₀ :=
      .of_ker_le_range (inl : IntPlane →* Γ₀) rightHom range_inl_eq_ker_rightHom.ge
    exact TauCeti.amenable_iff_hasFoelnerSets.mp this
  -- Lift `Γ₀` into `Type u` so the counting-measure regular representation lives in `Type u`.
  let Γu := ULift.{u} Γ₀
  let eu : Γu ≃* Γ₀ := MulEquiv.ulift
  have hFu : TauCeti.HasFoelnerSets Γu := eu.hasFoelnerSets_iff.mpr hF₀
  let φ : Γ →* Γu := eu.symm.toMonoidHom.comp e₀.toMonoidHom
  have hφ_inj : Function.Injective φ := eu.symm.injective.comp e₀.injective
  have : Infinite IntPlane :=
    Infinite.of_injective (fun n : ℤ => ofAdd ![n, 0]) fun m n hmn => by
      simpa using congrFun (ofAdd.injective hmn) 0
  let Λ : Subgroup Γ := (inl : IntPlane →* Γ).range
  have : Infinite (Λ.map φ) :=
    Infinite.of_injective
      (fun x : IntPlane => ⟨φ (inl x), ⟨inl x, ⟨x, rfl⟩, rfl⟩⟩)
      fun x y hxy => inl_injective (hφ_inj (Subtype.ext_iff.mp hxy))
  intro hT
  exact not_relativePropertyT_of_hasFoelnerSets hFu (hT.map φ)

/-- **Burger's theorem.** For any group `G` with an injective homomorphism `ψ : G →* SL(2, ℤ)`,
the subgroup `ℤ²` has relative property (T) inside `ℤ² ⋊ G` if and only if `G` does not have
Følner sets. -/
theorem relativePropertyT_inl_iff_not_hasFoelnerSets {G : Type v} [Group G]
    {ψ : G →* SL(2, ℤ)} (hψ : Function.Injective ψ) :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp ψ] G).range.RelativePropertyT.{u} ↔
      ¬ TauCeti.HasFoelnerSets G :=
  ⟨fun hT hG => not_relativePropertyT_inl_of_hasFoelnerSets hψ hG hT,
    relativePropertyT_inl_of_not_hasFoelnerSets hψ⟩

/-- Discrete-group amenability form of `relativePropertyT_inl_of_not_hasFoelnerSets`. -/
theorem relativePropertyT_inl_of_not_amenable {G : Type v} [Group G]
    [TopologicalSpace G] [DiscreteTopology G] {ψ : G →* SL(2, ℤ)} (hψ : Function.Injective ψ)
    (hG : ¬ TauCeti.Amenable G) :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp ψ] G).range.RelativePropertyT.{u} :=
  relativePropertyT_inl_of_not_hasFoelnerSets hψ
    (mt TauCeti.amenable_iff_hasFoelnerSets.mpr hG)

/-- Discrete-group amenability form of `relativePropertyT_inl_iff_not_hasFoelnerSets`. -/
theorem relativePropertyT_inl_iff_not_amenable {G : Type v} [Group G]
    [TopologicalSpace G] [DiscreteTopology G] {ψ : G →* SL(2, ℤ)} (hψ : Function.Injective ψ) :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp ψ] G).range.RelativePropertyT.{u} ↔
      ¬ TauCeti.Amenable G := by
  rw [relativePropertyT_inl_iff_not_hasFoelnerSets hψ, TauCeti.amenable_iff_hasFoelnerSets]

/-- For a subgroup `G : Subgroup SL(2, ℤ)` without Følner sets, `(ℤ² ⋊ G, ℤ²)` has relative
property (T). -/
theorem relativePropertyT_inl_slTwoAction_of_not_hasFoelnerSets (G : Subgroup SL(2, ℤ))
    (hG : ¬ TauCeti.HasFoelnerSets G) :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp G.subtype]
        G).range.RelativePropertyT.{u} :=
  relativePropertyT_inl_of_not_hasFoelnerSets G.subtype_injective hG

/-- **Burger's theorem for subgroups of `SL(2, ℤ)`.** For `G : Subgroup SL(2, ℤ)`, the pair
`(ℤ² ⋊ G, ℤ²)` has relative property (T) if and only if `G` does not have Følner sets. -/
theorem relativePropertyT_inl_slTwoAction_iff_not_hasFoelnerSets (G : Subgroup SL(2, ℤ)) :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp G.subtype]
        G).range.RelativePropertyT.{u} ↔
      ¬ TauCeti.HasFoelnerSets G :=
  relativePropertyT_inl_iff_not_hasFoelnerSets G.subtype_injective

/-- For a non-amenable subgroup `G : Subgroup SL(2, ℤ)`, `(ℤ² ⋊ G, ℤ²)` has relative
property (T). -/
theorem relativePropertyT_inl_slTwoAction_of_not_amenable (G : Subgroup SL(2, ℤ))
    (hG : ¬ TauCeti.Amenable G) :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp G.subtype]
        G).range.RelativePropertyT.{u} :=
  relativePropertyT_inl_of_not_amenable G.subtype_injective hG

/-- For `G : Subgroup SL(2, ℤ)`, the pair `(ℤ² ⋊ G, ℤ²)` has relative property (T) if and only if
`G` is not amenable. -/
theorem relativePropertyT_inl_slTwoAction_iff_not_amenable (G : Subgroup SL(2, ℤ)) :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp G.subtype]
        G).range.RelativePropertyT.{u} ↔
      ¬ TauCeti.Amenable G :=
  relativePropertyT_inl_iff_not_amenable G.subtype_injective

/-- **Kazhdan–Margulis theorem.** The normal subgroup `ℤ²` has relative property (T) in
`ℤ² ⋊ SL(2, ℤ)`, in every Hilbert-space universe `u`. -/
theorem relativePropertyT_inl_slTwo :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction] SL(2, ℤ)).range.RelativePropertyT.{u} :=
  relativePropertyT_inl_of_not_hasFoelnerSets (ψ := MonoidHom.id SL(2, ℤ)) Function.injective_id
    TauCeti.not_hasFoelnerSets_slTwo

/-- For the rank-two free group `F₂` acting on `ℤ²` through Sanov's generators
`[[1, 2], [0, 1]]` and `[[1, 0], [2, 1]]`, the pair `(ℤ² ⋊ F₂, ℤ²)` has relative property (T). -/
theorem relativePropertyT_inl_freeGroup_slTwo :
    (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp
        (FreeGroup.lift
          ![Matrix.SpecialLinearGroup.transvection (zero_ne_one : (0 : Fin 2) ≠ 1) (2 : ℤ),
            Matrix.SpecialLinearGroup.transvection (one_ne_zero : (1 : Fin 2) ≠ 0) (2 : ℤ)])]
        FreeGroup (Fin 2)).range.RelativePropertyT.{u} := by
  let _ : TopologicalSpace (FreeGroup (Fin 2)) := ⊥
  have : DiscreteTopology (FreeGroup (Fin 2)) := ⟨rfl⟩
  exact relativePropertyT_inl_of_not_amenable TauCeti.injective_freeGroup_lift_transvection_two
    TauCeti.not_amenable_freeGroup

/-- For the amenable upper unipotent shear subgroup `{[[1, n], [0, 1]] : n ∈ ℤ} ≤ SL(2, ℤ)`, the
pair `(ℤ² ⋊ G, ℤ²)` does not have relative property (T). -/
theorem not_relativePropertyT_inl_transvectionHom_range :
    ¬ (inl : Multiplicative (Fin 2 → ℤ) →*
      Multiplicative (Fin 2 → ℤ) ⋊[TauCeti.slTwoAction.comp
        (Matrix.SpecialLinearGroup.transvectionHom (A := ℤ)
          (zero_ne_one : (0 : Fin 2) ≠ 1)).range.subtype]
        (Matrix.SpecialLinearGroup.transvectionHom (A := ℤ)
          (zero_ne_one : (0 : Fin 2) ≠ 1)).range).range.RelativePropertyT.{u} := by
  let φ := Matrix.SpecialLinearGroup.transvectionHom (A := ℤ) (zero_ne_one : (0 : Fin 2) ≠ 1)
  rw [relativePropertyT_inl_slTwoAction_iff_not_amenable, not_not]
  let _ : TopologicalSpace (Multiplicative ℤ) := ⊥
  have : DiscreteTopology (Multiplicative ℤ) := ⟨rfl⟩
  exact .of_denseRange ⟨φ.rangeRestrict, continuous_of_discreteTopology⟩
    φ.rangeRestrict_surjective.denseRange

end Subgroup
