/-!
# Orbits of a finitely generated group, computed

Let a group `G` act on a finite type `α` with decidable equality, and let `S : Finset G`. The
orbit of a point `x` under the subgroup `Subgroup.closure ↑S` generated by `S` is a finite set,
but Mathlib's `MulAction.orbit` offers no way to compute it: membership in `Subgroup.closure ↑S`
carries no `Decidable` instance, and the subgroup itself is not a finset. This file computes the
orbit by the usual closure procedure — start from `{x}`, and repeatedly add all translates by the
generators — and proves that the result is the orbit. Since each round either enlarges the current
finset or leaves it fixed forever, `Fintype.card α` rounds always suffice
(`Finset.isFixedPt_iterate_of_card_le_card_add`), so the definition iterates that many times and
is executable by `decide` and `#eval`.

Applied to a group acting on itself by left multiplication, the orbit of `1` is the subgroup
generated by `S`; this gives the generated subgroup as a finset, and its order as a computation.

## Main definitions

* `Finset.orbitStep S s`: one round of closure, the finset `s ∪ S • s`.
* `Finset.orbitFinset S x`: the orbit of `x` under `Subgroup.closure ↑S`, as a finset.
* `Finset.closureFinset S`: the subgroup `Subgroup.closure ↑S` of a finite group, as a finset.

## Main results

* `Finset.coe_orbitFinset`, `Finset.mem_orbitFinset`: the finset is the orbit of `x` under the
  subgroup generated by `S`.
* `Finset.isPretransitive_closure_iff_orbitFinset_eq_univ`: the generated subgroup acts
  transitively exactly when the computed orbit of a point is everything. This is what makes
  transitivity of a finitely generated permutation group decidable.
* `Finset.mem_closureFinset`, `Finset.card_closureFinset`: the finset presentation of the
  generated subgroup, and its order.
* `MulAction.fixedFinsetEquivOrbitFinset`, `MulAction.subsetPermOn`, `MulAction.subsetOrbitEquiv`:
  fixed finite subsets correspond to finsets of orbits, and elements stabilizing a finset act on it
  and its complement with orbit decomposition matching the quotient-orbit partition.
-/

public section

namespace Finset

open MulAction Pointwise

variable {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]

/-- One round of closure of a finset `s` under the group elements in `S`: the finset `s` together
with all translates `g • y` of its elements by generators `g ∈ S`. -/
@[expose] def orbitStep (S : Finset G) (s : Finset α) : Finset α :=
  s ∪ S • s

@[simp]
theorem mem_orbitStep {S : Finset G} {s : Finset α} {y : α} :
    y ∈ orbitStep S s ↔ y ∈ s ∨ ∃ g ∈ S, ∃ x ∈ s, g • x = y := by
  simp [orbitStep, Finset.mem_smul]

theorem subset_orbitStep (S : Finset G) (s : Finset α) : s ⊆ orbitStep S s :=
  Finset.subset_union_left

theorem smul_finset_subset_orbitStep {S : Finset G} {g : G} (hg : g ∈ S) (s : Finset α) :
    g • s ⊆ orbitStep S s :=
  (Finset.smul_finset_subset_smul hg).trans Finset.subset_union_right

variable [Fintype α]

/-- The orbit of `x` under the subgroup generated by `S`, computed by `Fintype.card α` rounds of
closure under the generators starting from `{x}`. That many rounds always suffice, by
`Finset.isFixedPt_iterate_of_card_le_card_add`; the identification with `MulAction.orbit` is
`Finset.coe_orbitFinset`. -/
@[expose] def orbitFinset (S : Finset G) (x : α) : Finset α :=
  (orbitStep S)^[Fintype.card α] {x}

/-- The computed orbit is closed under one more round of closure. -/
theorem orbitStep_orbitFinset (S : Finset G) (x : α) :
    orbitStep S (orbitFinset S x) = orbitFinset S x :=
  Finset.isFixedPt_iterate_of_card_le_card_add (subset_orbitStep S) (Nat.le_add_left _ _)

@[simp]
theorem mem_orbitFinset_self (S : Finset G) (x : α) : x ∈ orbitFinset S x :=
  Function.id_le_iterate_of_id_le (subset_orbitStep S) _ {x} (Finset.mem_singleton_self x)

/-- The computed orbit is the orbit of `x` under the subgroup generated by `S`. -/
@[simp]
theorem coe_orbitFinset (S : Finset G) (x : α) :
    (orbitFinset S x : Set α) = orbit (Subgroup.closure (S : Set G)) x := by
  refine subset_antisymm ?_ ?_
  · -- Every round of closure stays inside the orbit.
    suffices h : ∀ k, ((orbitStep S)^[k] {x} : Set α) ⊆ orbit (Subgroup.closure (S : Set G)) x
      from h _
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [Function.iterate_succ_apply']
      intro y hy
      rcases mem_orbitStep.mp hy with hy | ⟨g, hg, z, hz, rfl⟩
      · exact ih hy
      · exact smul_mem_orbit_closure (S := (S : Set G)) hg (ih hz)
  · -- The computed orbit is a finite set containing `x` and closed under the generators.
    exact orbit_closure_subset_of_finite (Finset.finite_toSet _) (mem_orbitFinset_self S x)
      fun g hg y hy => (orbitStep_orbitFinset S x).subset
        (smul_finset_subset_orbitStep hg _ (Finset.smul_mem_smul_finset hy))

/-- A point lies in the computed finset `Finset.orbitFinset S x` exactly when it lies in the orbit
of `x` under the subgroup generated by `S`. -/
@[simp]
theorem mem_orbitFinset {S : Finset G} {x y : α} :
    y ∈ orbitFinset S x ↔ y ∈ orbit (Subgroup.closure (S : Set G)) x := by
  rw [← Finset.mem_coe, coe_orbitFinset]

/-- The subgroup generated by `S` acts transitively exactly when the computed orbit of a point
is the whole type. -/
theorem isPretransitive_closure_iff_orbitFinset_eq_univ (S : Finset G) (x : α) :
    IsPretransitive (Subgroup.closure (S : Set G)) α ↔ orbitFinset S x = Finset.univ := by
  rw [isPretransitive_iff_orbit_eq_univ x, ← coe_orbitFinset]
  exact Finset.coe_eq_univ (s := orbitFinset S x)

/-- The subgroup generated by `S` acts transitively exactly when the computed orbit of every
point is the whole type. The universally quantified form is the one that is decidable without
choosing a point. -/
theorem isPretransitive_closure_iff_forall_orbitFinset_eq_univ (S : Finset G) :
    IsPretransitive (Subgroup.closure (S : Set G)) α ↔ ∀ x : α, orbitFinset S x = Finset.univ := by
  rcases isEmpty_or_nonempty α with _ | ⟨⟨x⟩⟩
  · -- On an empty type both sides hold vacuously.
    exact iff_of_true ⟨fun x => isEmptyElim x⟩ fun x => isEmptyElim x
  · exact ⟨fun h y => (isPretransitive_closure_iff_orbitFinset_eq_univ S y).mp h,
      fun h => (isPretransitive_closure_iff_orbitFinset_eq_univ S x).mpr (h x)⟩

/-! ### The generated subgroup of a finite group, as a finset -/

variable (S : Finset G) [Fintype G] [DecidableEq G]

/-- The subgroup of a finite group generated by `S`, as a finset: the orbit of `1` under the
generated subgroup acting by left multiplication, computed by `Finset.orbitFinset`. -/
@[expose] def closureFinset : Finset G :=
  orbitFinset S (1 : G)

/-- A group element lies in the computed finset `Finset.closureFinset S` exactly when it lies in
the subgroup generated by `S`. -/
@[simp]
theorem mem_closureFinset {g : G} : g ∈ closureFinset S ↔ g ∈ Subgroup.closure (S : Set G) := by
  rw [closureFinset, mem_orbitFinset, orbit_subgroup_one_eq_self, SetLike.mem_coe]

/-- The computed finset `Finset.closureFinset S`, as a set, is the subgroup generated by `S`. -/
@[simp]
theorem coe_closureFinset : (closureFinset S : Set G) = Subgroup.closure (S : Set G) := by
  ext
  simp [mem_closureFinset]

/-- The order of the subgroup generated by `S`, as the cardinality of a computed finset. -/
@[simp]
theorem card_closureFinset : (closureFinset S).card = Nat.card (Subgroup.closure (S : Set G)) := by
  rw [← Nat.card_eq_finsetCard]
  exact Nat.card_congr (Equiv.subtypeEquivRight fun _ => mem_closureFinset S)

end Finset

namespace MulAction

open scoped Pointwise

/-- If `g • T = T`, every integer power of `g` fixes `T` setwise. -/
theorem zpow_smul_finset_eq {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]
    {g : G} {T : Finset α} (hg : g • T = T) (k : ℤ) : g ^ k • T = T :=
  (stabilizer G T).zpow_mem hg k

/-- Membership in a `g`-invariant finset is invariant under `⟨g⟩`-orbits. -/
theorem zpow_smul_mem_of_smul_eq {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]
    {g : G} {T : Finset α} (hg : g • T = T) {x y : α}
    (h : orbitRel (Subgroup.zpowers g) α x y) : x ∈ T ↔ y ∈ T := by
  obtain ⟨⟨_, k, rfl⟩, rfl⟩ := mem_orbit_iff.mp (orbitRel_apply.mp h)
  calc
    (⟨g ^ k, Subgroup.zpow_mem_zpowers g k⟩ : Subgroup.zpowers g) • y ∈ T ↔ g ^ k • y ∈ T :=
      Iff.rfl
    _ ↔ g ^ k • y ∈ g ^ k • T := by rw [zpow_smul_finset_eq hg k]
    _ ↔ y ∈ T := Finset.smul_mem_smul_finset_iff (g ^ k)

/-- Translation preserves complements of invariant finsets. -/
theorem smul_compl_eq_of_smul_eq {G α : Type*} [Group G] [MulAction G α] [Fintype α]
    [DecidableEq α] {g : G} {S : Finset α} (hS : g • S = S) : g • Sᶜ = Sᶜ := by
  refine Finset.coe_injective ?_
  simp only [Finset.coe_smul_finset, Finset.coe_compl, Set.smul_set_compl]
  rw [← Finset.coe_smul_finset, hS]

/-- Bijection between `g`-invariant finsets `T ⊆ α` and finsets of `⟨g⟩`-orbits in `α`. -/
noncomputable def fixedFinsetEquivOrbitFinset {G α : Type*} [Group G] [MulAction G α]
    [Fintype α] [DecidableEq α] (g : G)
    [Fintype (orbitRel.Quotient (Subgroup.zpowers g) α)] :
    {T : Finset α // g • T = T} ≃ Finset (orbitRel.Quotient (Subgroup.zpowers g) α) where
  toFun T := Finset.univ.filter fun ω ↦ ω.out ∈ T.val
  invFun s :=
    let := Classical.decEq (orbitRel.Quotient (Subgroup.zpowers g) α)
    ⟨Finset.univ.filter fun q ↦ Quotient.mk'' q ∈ s, by
      ext q
      simp only [Finset.mem_smul_finset]
      constructor
      · rintro ⟨q', hq', hqq'⟩
        have hrel : orbitRel (Subgroup.zpowers g) α q q' :=
          ⟨⟨g, 1, zpow_one g⟩, by simpa [Subgroup.smul_def] using hqq'⟩
        simpa [Quotient.sound' hrel] using hq'
      · intro hq
        refine ⟨g⁻¹ • q, ?_, smul_inv_smul g q⟩
        have hrel : orbitRel (Subgroup.zpowers g) α (g⁻¹ • q) q :=
          ⟨⟨g⁻¹, -1, zpow_neg_one g⟩, rfl⟩
        simpa [Quotient.sound' hrel] using hq⟩
  left_inv T := Subtype.ext <| by
    ext q
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact zpow_smul_mem_of_smul_eq T.property (Quotient.exact' (Quotient.out_eq (Quotient.mk'' q)))
  right_inv s := by
    ext ω
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rw [Quotient.out_eq']

/-- The orbit finset corresponding to a `g`-invariant finset `T`. -/
@[simp]
theorem fixedFinsetEquivOrbitFinset_apply {G α : Type*} [Group G] [MulAction G α]
    [Fintype α] [DecidableEq α] (g : G)
    [Fintype (orbitRel.Quotient (Subgroup.zpowers g) α)] (T : {T : Finset α // g • T = T}) :
    fixedFinsetEquivOrbitFinset g T = Finset.univ.filter fun ω ↦ ω.out ∈ T.val := by
  rfl

/-- Restriction of a subgroup action to permutations of an invariant finset. -/
@[expose] def subsetPermOn {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]
    (H : Subgroup G) (T : Finset α) (hT : ∀ x : H, (x : G) • T = T) :
    H →* Equiv.Perm ↥T where
  toFun x :=
    { toFun := fun y ↦ ⟨(x : G) • y.val, by
        have hm := Finset.smul_mem_smul_finset (a := (x : G)) y.property
        rwa [hT x] at hm⟩
      invFun := fun y ↦ ⟨(x⁻¹ : H).val • y.val, by
        have hm := Finset.smul_mem_smul_finset (a := (x⁻¹ : H).val) y.property
        rwa [hT x⁻¹] at hm⟩
      left_inv := fun y ↦ Subtype.ext (by simp [inv_smul_smul])
      right_inv := fun y ↦ Subtype.ext (by simp [smul_inv_smul]) }
  map_one' := by ext y; simp
  map_mul' x z := by ext y; simp [mul_smul]

@[simp]
theorem subsetPermOn_apply {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]
    (H : Subgroup G) (T : Finset α) (hT : ∀ x : H, (x : G) • T = T) (x : H) (y : ↥T) :
    (subsetPermOn H T hT x y).val = (x : G) • y.val := rfl

@[simp]
theorem subsetPermOn_zpow_val {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]
    {H : Subgroup G} {T : Finset α} (hT : ∀ x : H, (x : G) • T = T) (x : H) (k : ℤ) (y : ↥T) :
    ((subsetPermOn H T hT x ^ k) y).val = ((x : G) ^ k) • y.val := by
  rw [← map_zpow, subsetPermOn_apply, Subgroup.coe_zpow]

theorem subsetPermOn_minimalPeriod {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]
    {H : Subgroup G} {T : Finset α} (hT : ∀ x : H, (x : G) • T = T) (x : H) (y : ↥T) :
    Function.minimalPeriod ((subsetPermOn H T hT x) • ·) y =
      Function.minimalPeriod ((x : G) • ·) y.val := by
  refine Function.minimalPeriod_eq_minimalPeriod_iff.mpr fun n ↦ ?_
  rw [Function.IsPeriodicPt, Function.IsFixedPt, Function.IsPeriodicPt, Function.IsFixedPt,
    smul_iterate_apply, smul_iterate_apply, Subtype.ext_iff, Equiv.Perm.smul_def,
    ← zpow_natCast (subsetPermOn H T hT x) n, subsetPermOn_zpow_val, zpow_natCast]

/-- Equivalence between `⟨x|_T⟩`-orbits on an `H`-invariant finset `T` and ambient
`⟨x⟩`-orbits whose chosen representative lies in `T`. -/
noncomputable def subsetOrbitEquiv {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]
    {H : Subgroup G} (T : Finset α) (hT : ∀ x : H, (x : G) • T = T) (x : H) :
    orbitRel.Quotient (Subgroup.zpowers (subsetPermOn H T hT x)) ↥T ≃
      {ω : orbitRel.Quotient (Subgroup.zpowers (x : G)) α // ω.out ∈ T} where
  toFun q :=
    ⟨Quotient.mk'' q.out.val, (zpow_smul_mem_of_smul_eq (hT x)
      (Quotient.exact' (Quotient.out_eq' (Quotient.mk'' q.out.val)).symm)).mp q.out.property⟩
  invFun ω := Quotient.mk'' ⟨ω.val.out, ω.property⟩
  left_inv q := by
    dsimp only
    conv_rhs => rw [← Quotient.out_eq' q]
    apply Quotient.sound'
    set ω : orbitRel.Quotient (Subgroup.zpowers (x : G)) α := Quotient.mk'' q.out.val
    obtain ⟨⟨_, k, rfl⟩, hk⟩ := mem_orbit_iff.mp (orbitRel_apply.mp
      (Quotient.exact' (Quotient.out_eq' ω)))
    exact (mem_orbit_iff.mpr ⟨⟨subsetPermOn H T hT x ^ k, k, rfl⟩, Subtype.ext <| by
      simpa [Subgroup.smul_def, Equiv.Perm.smul_def, subsetPermOn_zpow_val] using hk⟩)
  right_inv ω := Subtype.ext <| by
    let q : orbitRel.Quotient (Subgroup.zpowers (subsetPermOn H T hT x)) ↥T :=
      Quotient.mk'' ⟨ω.val.out, ω.property⟩
    obtain ⟨⟨_, k, rfl⟩, hk⟩ := mem_orbit_iff.mp (orbitRel_apply.mp
      (Quotient.exact' (Quotient.out_eq' q)))
    have hmem : orbitRel (Subgroup.zpowers (x : G)) α q.out.val ω.val.out :=
      ⟨⟨(x : G) ^ k, k, rfl⟩, by
        simpa [Subgroup.smul_def, Equiv.Perm.smul_def, subsetPermOn_zpow_val] using
          congrArg Subtype.val hk⟩
    exact (Quotient.sound' hmem).trans (Quotient.out_eq' ω.val)

theorem subsetOrbitEquiv_out_rel {G α : Type*} [Group G] [MulAction G α] [DecidableEq α]
    {H : Subgroup G} (T : Finset α) (hT : ∀ x : H, (x : G) • T = T) (x : H)
    (q : orbitRel.Quotient (Subgroup.zpowers (subsetPermOn H T hT x)) ↥T) :
    orbitRel (Subgroup.zpowers (x : G)) α q.out.val (subsetOrbitEquiv T hT x q).val.out :=
  Quotient.exact' (Quotient.out_eq _).symm

end MulAction
