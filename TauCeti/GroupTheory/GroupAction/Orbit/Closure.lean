module

public import Mathlib.Algebra.Pointwise.Stabilizer
import Mathlib.Algebra.Group.Subgroup.Actions

/-!
# Orbits of a generated subgroup

Let a group `G` act on a type `α` and let `S` be a set of elements of `G`. The orbit of a point
`b` under the subgroup `Subgroup.closure S` generated by `S` is the least subset of `α` that
contains `b` and is mapped into itself by every `g ∈ S` and every `g⁻¹`, `g ∈ S`. When the
subset in question is finite the inverses are redundant: an element of a group mapping a finite
set into itself maps it onto itself, so a finite set closed under `S` is closed under the
inverses as well. In particular, on a finite type the orbit is the least `S`-closed subset
containing `b`.

This is how an orbit of a permutation group given by generators is determined in practice:
exhibit a set containing the point and closed under the generators, and show that every point of
it is reached. For an infinite set the
inverses cannot be dropped: the integers act on themselves by translation, the subgroup
generated by `1` is everything, and the natural numbers contain `0` and are closed under
`x ↦ x + 1` without containing the orbit of `0`.

## Main results

* `MulAction.orbit_closure_subset`: a set containing `b` and closed under `S` and under the
  inverses of the elements of `S` contains the orbit of `b` under `Subgroup.closure S`.
* `MulAction.orbit_closure_subset_of_finite`: for a finite set, closure under `S` suffices.
* `MulAction.isLeast_orbit_closure`: the orbit of `b` is the least set containing `b` and closed
  under `S` and the inverses of its elements.
* `MulAction.isLeast_orbit_closure_of_finite`: on a finite type, the orbit of `b` is the least set
  containing `b` and closed under `S`.
-/

public section

namespace MulAction

open Pointwise Subgroup

variable {G α : Type*} [Group G] [MulAction G α] {S : Set G} {T : Set α} {b : α}

/-- An element of `S` maps the orbit of `b` under the subgroup generated by `S` into itself. -/
@[to_additive /-- An element of `S` maps the orbit of `b` under the additive subgroup generated
by `S` into itself. -/]
theorem smul_mem_orbit_closure {g : G} (hg : g ∈ S) {x : α} (hx : x ∈ orbit (closure S) b) :
    g • x ∈ orbit (closure S) b :=
  mem_orbit_of_mem_orbit (⟨g, subset_closure hg⟩ : closure S) hx

/-- The inverse of an element of `S` maps the orbit of `b` under the subgroup generated by `S`
into itself. -/
@[to_additive /-- The negative of an element of `S` maps the orbit of `b` under the additive
subgroup generated by `S` into itself. -/]
theorem inv_smul_mem_orbit_closure {g : G} (hg : g ∈ S) {x : α}
    (hx : x ∈ orbit (closure S) b) : g⁻¹ • x ∈ orbit (closure S) b :=
  mem_orbit_of_mem_orbit (⟨g, subset_closure hg⟩ : closure S)⁻¹ hx

/-- A set containing `b` and mapped into itself by every element of `S` and by its inverse
contains the orbit of `b` under the subgroup generated by `S`. -/
@[to_additive /-- A set containing `b` and mapped into itself by every element of `S` and by its
negative contains the orbit of `b` under the additive subgroup generated by `S`. -/]
theorem orbit_closure_subset (hb : b ∈ T) (hS : ∀ g ∈ S, ∀ x ∈ T, g • x ∈ T)
    (hS' : ∀ g ∈ S, ∀ x ∈ T, g⁻¹ • x ∈ T) : orbit (closure S) b ⊆ T := by
  -- The generators stabilize `T` setwise, hence so does the subgroup they generate.
  have hle : closure S ≤ stabilizer G T := by
    refine (closure_le _).mpr fun g hg => mem_stabilizer_set.mpr fun x => ⟨fun hx => ?_, hS g hg x⟩
    simpa using hS' g hg _ hx
  intro y hy
  obtain ⟨g, rfl⟩ := mem_orbit_iff.mp hy
  rw [smul_def]
  exact (mem_stabilizer_set.mp (hle g.2) b).mpr hb

/-- A finite set containing `b` and mapped into itself by every element of `S` contains the orbit
of `b` under the subgroup generated by `S`. No condition on the inverses is needed: an element of
a group mapping a finite set into itself maps it onto itself. -/
@[to_additive /-- A finite set containing `b` and mapped into itself by every element of `S`
contains the orbit of `b` under the additive subgroup generated by `S`. No condition on the
negatives is needed: an element of an additive group mapping a finite set into itself maps it
onto itself. -/]
theorem orbit_closure_subset_of_finite (hT : T.Finite) (hb : b ∈ T)
    (hS : ∀ g ∈ S, ∀ x ∈ T, g • x ∈ T) : orbit (closure S) b ⊆ T := by
  -- On a finite set, closure under `g` already places `g` in the setwise stabilizer.
  have hstab : ∀ g ∈ S, g ∈ stabilizer G T := fun g hg =>
    (mem_stabilizer_set' hT).mpr fun x hx => hS g hg x hx
  refine orbit_closure_subset hb hS fun g hg x hx => ?_
  exact (mem_stabilizer_set' hT).mp (inv_mem (hstab g hg)) hx

/-- The orbit of `b` under the subgroup generated by `S` is the least set that contains `b` and is
mapped into itself by every element of `S` and by its inverse. -/
@[to_additive /-- The orbit of `b` under the additive subgroup generated by `S` is the least set
that contains `b` and is mapped into itself by every element of `S` and by its negative. -/]
theorem isLeast_orbit_closure (S : Set G) (b : α) :
    IsLeast {T : Set α | b ∈ T ∧ (∀ g ∈ S, ∀ x ∈ T, g • x ∈ T) ∧ ∀ g ∈ S, ∀ x ∈ T, g⁻¹ • x ∈ T}
      (orbit (closure S) b) :=
  ⟨⟨mem_orbit_self b, fun _ hg _ => smul_mem_orbit_closure hg,
      fun _ hg _ => inv_smul_mem_orbit_closure hg⟩,
    fun _ ⟨hb, hS, hS'⟩ => orbit_closure_subset hb hS hS'⟩

/-- On a finite type, the orbit of `b` under the subgroup generated by `S` is the least set that
contains `b` and is mapped into itself by every element of `S`. -/
@[to_additive /-- On a finite type, the orbit of `b` under the additive subgroup generated by `S`
is the least set that contains `b` and is mapped into itself by every element of `S`. -/]
theorem isLeast_orbit_closure_of_finite [Finite α] (S : Set G) (b : α) :
    IsLeast {T : Set α | b ∈ T ∧ ∀ g ∈ S, ∀ x ∈ T, g • x ∈ T} (orbit (closure S) b) :=
  ⟨⟨mem_orbit_self b, fun _ hg _ => smul_mem_orbit_closure hg⟩,
    fun T ⟨hb, hS⟩ => orbit_closure_subset_of_finite T.toFinite hb hS⟩

end MulAction
