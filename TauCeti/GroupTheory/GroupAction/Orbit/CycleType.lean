module

public import TauCeti.GroupTheory.Perm.Partition
public import TauCeti.GroupTheory.GroupAction.Orbit.Card
import Mathlib.Data.ZMod.QuotientGroup

/-!
# Cycle lengths of a group element acting on a finite set

For a group acting on a finite set, the full cycle type of the permutation induced by an
element is the multiset of sizes of the orbits of its cyclic subgroup. The acting group itself
need not be finite. This connects permutation cycle lengths, including fixed points, to an
orbit calculation in the original group.

The comparison uses `Equiv.Perm.fullCycleType_eq_map_card_orbit` and
`TauCeti.map_card_orbit_eq_of_orbit_eq`: the permutation and the original group element have
the same integer powers acting on the carrier, hence the same orbits.

For a free action (`IsCancelSMul`), such as the left-regular action of a group on itself, every
orbit of the cyclic subgroup generated by `g` has `orderOf g` elements, so the full cycle type of
`g` is `Multiset.replicate (Nat.card X / orderOf g) (orderOf g)`
(`MulAction.fullCycleType_toPerm_eq_replicate`).
-/

public section

namespace MulAction

open scoped Classical in
/-- The cycle lengths of the permutation induced by a group element are the sizes of the
orbits of the cyclic subgroup it generates, including the singleton orbits. -/
theorem fullCycleType_toPerm_eq_map_card_orbit {G X : Type*} [Group G] [MulAction G X]
    [Fintype X] [DecidableEq X] (g : G) :
    (toPerm g : Equiv.Perm X).fullCycleType =
      (Finset.univ : Finset (orbitRel.Quotient (Subgroup.zpowers g) X)).val.map
        (fun ω => Nat.card ω.orbit) := by
  have hpow (n : ℤ) (x : X) : (toPerm g ^ n) x = g ^ n • x := by
    rw [← toPermHom_apply, ← map_zpow, toPermHom_apply, toPerm_apply]
  rw [Equiv.Perm.fullCycleType_eq_map_card_orbit]
  apply TauCeti.map_card_orbit_eq_of_orbit_eq
  intro x
  ext y
  simp only [mem_orbit_iff, Subgroup.smul_def]
  constructor
  · rintro ⟨h, hh⟩
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp h.2
    exact ⟨⟨g ^ n, Subgroup.zpow_mem_zpowers g n⟩, by simpa [← hn, hpow] using hh⟩
  · rintro ⟨h, hh⟩
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp h.2
    exact ⟨⟨(toPerm g : Equiv.Perm X) ^ n, Subgroup.zpow_mem_zpowers _ n⟩,
      by simpa [← hn, hpow] using hh⟩

/-- **The cycle type of a free action.** If `G` acts freely on a finite set `X`, then every cycle of
the permutation induced by `g` has length `orderOf g`, so its full cycle type consists of
`Nat.card X / orderOf g` parts equal to `orderOf g`. For the left-regular action of a finite group
on itself, an element of order `d` in a group of order `m` thus acts with `m / d` cycles of
length `d`. -/
theorem fullCycleType_toPerm_eq_replicate {G X : Type*} [Group G] [MulAction G X]
    [IsCancelSMul G X] [Fintype X] [DecidableEq X] (g : G) :
    (toPerm g : Equiv.Perm X).fullCycleType =
      Multiset.replicate (Nat.card X / orderOf g) (orderOf g) := by
  -- Each orbit of `zpowers g` is in bijection with `zpowers g`, the stabilizers being trivial.
  have hmem : ∀ n ∈ (toPerm g : Equiv.Perm X).fullCycleType, n = orderOf g := by
    classical
    rw [fullCycleType_toPerm_eq_map_card_orbit]
    simp only [Multiset.mem_map, Finset.mem_val, Finset.mem_univ, true_and, forall_exists_index,
      forall_apply_eq_imp_iff]
    intro ω
    induction ω using Quotient.inductionOn with | h x => ?_
    rw [orbitRel.Quotient.orbit_mk]
    calc Nat.card (orbit (Subgroup.zpowers g) x)
        = (stabilizer (Subgroup.zpowers g) x).index :=
          Nat.card_congr (orbitEquivQuotientStabilizer _ x)
      _ = orderOf g := by
          rw [IsCancelSMul.stabilizer_eq_bot, Subgroup.index_bot, Nat.card_zpowers]
  -- The number of parts is then forced by the parts summing to `Nat.card X`.
  refine Multiset.eq_replicate.mpr ⟨?_, hmem⟩
  have hsum := Equiv.Perm.sum_fullCycleType (toPerm g : Equiv.Perm X)
  rw [Multiset.eq_replicate_card.mpr hmem, Multiset.sum_replicate, smul_eq_mul,
    ← Nat.card_eq_fintype_card] at hsum
  rcases Nat.eq_zero_or_pos (orderOf g) with h0 | hpos
  · rw [h0, Nat.div_zero, Multiset.card_eq_zero, Multiset.eq_zero_iff_forall_notMem]
    exact fun n hn ↦ (Equiv.Perm.pos_of_mem_fullCycleType hn).ne' (h0 ▸ hmem n hn)
  · rw [← hsum, Nat.mul_div_cancel _ hpos]

end MulAction
