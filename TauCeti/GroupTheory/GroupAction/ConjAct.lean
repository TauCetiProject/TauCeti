/-!
# Conjugation of subgroups

A normal subgroup `N` of `G` carries the conjugation action `MulAut.conjNormal` of the whole of
`G`. Conjugation by an element of `N` itself is inner, so a homomorphism `ψ : N →* M` to a
*commutative* monoid cannot see it: conjugate elements of `N` have the same image in `M`.

Dually, conjugation cannot move a *central* element: a subgroup containing one has every
conjugate containing it too.

A conjugate `gΓg⁻¹` sees `g` only modulo the normalizer of `Γ` on the right, and multiplying `g`
on the left by an element of the normalizer of `Γ₁` conjugates the relative stabilizer
`(gΓ₂g⁻¹).subgroupOf Γ₁` by that element. `TauCeti.NumberTheory.HeckeRing.StabConjugation` turns
these into equivalences of Hecke decomposition quotients.

For an action of `G` on a type, translation by `g` carries the orbits of a subgroup `H` onto the
orbits of its conjugate `g H g⁻¹`. If the action is faithful, a point stabilizer acts faithfully
by conjugation on every transitive normal subgroup. The stabilizer of `g • a` in a normal
subgroup is the conjugate by `g` of the stabilizer of `a`.

## Main statements

* `ConjAct.mk_eq_mk_iff_isConj`: conjugation orbits are the classes of `IsConj`.
* `MonoidHom.map_conjNormal_val`: a homomorphism from a normal subgroup to a commutative monoid is
  unchanged by conjugation by an element of that subgroup.
* `MonoidHom.map_conjNormal_eq_of_inv_mul_mem`: composed with conjugation by `g`, such a
  homomorphism depends only on the coset `g N`.
* `MulAut.conjNormal_pow_conjNormal_pow`: if `x ^ l ∈ N`, conjugating by `x ^ i` and then by
  `x ^ j` (`i j : Fin l`) agrees with conjugating by `x ^ (i + j)`, up to an inner automorphism of
  `N` by a power of `x ^ l`.
* `Subgroup.conjugationAction`: the explicit conjugation action on a normal subgroup.
* `Subgroup.inv_mul_mul_mem_conjAct_smul_iff`: conjugation preserves subgroup membership.
* `Subgroup.mem_conjAct_smul_iff`: membership in a conjugate `g H g⁻¹`.
* `Subgroup.map_conjAct_smul`: conjugate subgroups have the same image under a homomorphism to a
  commutative group.
* `Subgroup.conjAct_smul_zpowers`: the conjugate of the cyclic subgroup generated by `x` is
  generated by the conjugate of `x`.
* `Subgroup.mem_conjAct_smul_of_mem_center`: a central element of a subgroup lies in each of its
  conjugates.
* `Subgroup.inclusion_conj_smul`: the inclusion of a normal subgroup into a larger normal
  subgroup commutes with conjugation.
* `Subgroup.conjAct_smul_mul_right_of_mem_normalizer`: `(gh)Γ(gh)⁻¹ = gΓg⁻¹` when `h`
  normalizes `Γ`.
* `Subgroup.subgroupOf_conjAct_smul_mul_left_of_mem_normalizer`: left multiplication of `g` by an
  element of the normalizer of `Γ₁` conjugates `(gΓ₂g⁻¹).subgroupOf Γ₁`.
* `TauCeti.MulAction.orbitRel_smul_smul_iff_of_conjAct_smul_eq`: `g • x` and `g • y` lie in the
  same orbit of `g H g⁻¹` exactly when `x` and `y` lie in the same orbit of `H`.
* `TauCeti.MulAction.orbit_smul_of_conjAct_smul_eq`: the orbit of `g • x` under `g H g⁻¹` is the
  translate by `g` of the orbit of `x` under `H`.
* `TauCeti.MulAction.stabilizer_smul_eq_conjNormal_smul`: for a normal subgroup `N`, the
  stabilizer of `g • a` in `N` is the conjugate by `g` of the stabilizer of `a` in `N`.
* `Subgroup.stabilizer_conjNormal_injective`: in a faithful action, the conjugation map
  from a point stabilizer to `MulAut N` is injective for every transitive normal subgroup `N`.
-/

public section

/-- Two elements of a group lie in one orbit of the conjugation action exactly when they are
conjugate. -/
theorem ConjAct.mk_eq_mk_iff_isConj {G : Type*} [Group G] {x y : G} :
    (Quotient.mk'' x : MulAction.orbitRel.Quotient (ConjAct G) G) = Quotient.mk'' y ↔
      IsConj x y :=
  Quotient.eq''.trans (by rw [ConjAct.orbitRel_conjAct])

namespace MonoidHom

variable {G M : Type*} [Group G] [CommMonoid M] {N : Subgroup G} [N.Normal]

/-- **Conjugation by an element of a normal subgroup does not move a homomorphism from that
subgroup to a commutative monoid**: conjugate elements have the same image in a commutative
target. -/
@[simp]
theorem map_conjNormal_val (ψ : N →* M) (a x : N) : ψ (MulAut.conjNormal (a : G) x) = ψ x := by
  have h : IsConj x (MulAut.conjNormal (a : G) x) :=
    isConj_iff.mpr ⟨a, by rw [MulAut.conjNormal_val, MulAut.conj_apply]⟩
  exact (isConj_iff_eq.mp (ψ.map_isConj h)).symm

/-- **A homomorphism from a normal subgroup to a commutative monoid, composed with conjugation by
`g`, depends only on the coset `g N`**: it agrees at `g` and `g₀` when `g₀⁻¹ g ∈ N`. -/
theorem map_conjNormal_eq_of_inv_mul_mem (ψ : N →* M) {g₀ g : G} (h : g₀⁻¹ * g ∈ N) (x : N) :
    ψ (MulAut.conjNormal g x) = ψ (MulAut.conjNormal g₀ x) := by
  -- Write `g = g₀ a` with `a ∈ N`; conjugation by `a` does not move `ψ`.
  obtain ⟨a, rfl⟩ : ∃ a : N, g = g₀ * a := ⟨⟨g₀⁻¹ * g, h⟩, by simp⟩
  rw [map_mul, MulAut.mul_apply]
  exact (ψ.comp (MulAut.conjNormal g₀).toMonoidHom).map_conjNormal_val a x

end MonoidHom

namespace MulAut

/-- **Powers of `x` conjugate a normal subgroup modulo `x ^ l`.** If `x ^ l ∈ N`, then for
`i j : Fin l` conjugation by `x ^ j` followed by `x ^ i` is conjugation by `x ^ (i + j)` (the sum
taken in `Fin l`) followed by the inner automorphism of `N` by `(x ^ l) ^ ((i + j) / l)`. -/
theorem conjNormal_pow_conjNormal_pow {G : Type*} [Group G] {N : Subgroup G} [N.Normal] {l : ℕ}
    {x : G} (hx : x ^ l ∈ N) (h : N) (i j : Fin l) :
    conjNormal (x ^ (i : ℕ)) (conjNormal (x ^ (j : ℕ)) h) =
      (⟨x ^ l, hx⟩ : N) ^ (((i : ℕ) + j) / l) * conjNormal (x ^ ((i + j : Fin l) : ℕ)) h *
        ((⟨x ^ l, hx⟩ : N) ^ (((i : ℕ) + j) / l))⁻¹ := by
  apply Subtype.ext
  have hpow : x ^ (i : ℕ) * x ^ (j : ℕ) =
      (x ^ l) ^ (((i : ℕ) + j) / l) * x ^ ((i + j : Fin l) : ℕ) := by
    rw [← pow_add, ← pow_mul, ← pow_add, Fin.val_add, Nat.div_add_mod]
  simp only [Subgroup.coe_mul, InvMemClass.coe_inv, SubmonoidClass.coe_pow, conjNormal_apply]
  calc
    x ^ (i : ℕ) * (x ^ (j : ℕ) * (h : G) * (x ^ (j : ℕ))⁻¹) * (x ^ (i : ℕ))⁻¹ =
        (x ^ (i : ℕ) * x ^ (j : ℕ)) * (h : G) * (x ^ (i : ℕ) * x ^ (j : ℕ))⁻¹ := by group
    _ = ((x ^ l) ^ (((i : ℕ) + j) / l) * x ^ ((i + j : Fin l) : ℕ)) * (h : G) *
          ((x ^ l) ^ (((i : ℕ) + j) / l) * x ^ ((i + j : Fin l) : ℕ))⁻¹ := by rw [hpow]
    _ = (x ^ l) ^ (((i : ℕ) + j) / l) * (x ^ ((i + j : Fin l) : ℕ) * (h : G) *
          (x ^ ((i + j : Fin l) : ℕ))⁻¹) * ((x ^ l) ^ (((i : ℕ) + j) / l))⁻¹ := by group

end MulAut

namespace Subgroup

open scoped Pointwise

section ConjugationAction

open scoped IsMulCommutative

variable {G : Type*} [Group G] (N : Subgroup G) [N.Normal]

/-- Conjugation by the ambient group on a normal subgroup. -/
@[instance_reducible]
def conjugationAction : MulDistribMulAction G N :=
  MulDistribMulAction.compHom N (MulAut.conjNormal (H := N))

attribute [local instance] conjugationAction

@[simp]
theorem coe_conjugationAction_smul (g : G) (n : N) :
    ((g • n : N) : G) = g * n * g⁻¹ := (rfl)

variable {N} [IsMulCommutative N]

/-- Conjugation by an element of an abelian normal subgroup is trivial on that subgroup. -/
@[simp]
theorem conjugationAction_coe_smul (n m : N) : (n : G) • m = m := by
  apply Subtype.ext
  rw [coe_conjugationAction_smul, ← coe_mul, ← coe_inv, ← coe_mul]
  simp

end ConjugationAction

/-- Conjugating an element and a subgroup by the same inverse preserves membership. -/
@[simp]
theorem inv_mul_mul_mem_conjAct_smul_iff {G : Type*} [Group G] (g x : G) (H : Subgroup G) :
    g⁻¹ * x * g ∈ (ConjAct.toConjAct g)⁻¹ • H ↔ x ∈ H := by
  simpa only [← ConjAct.toConjAct_inv, ConjAct.toConjAct_smul, inv_inv] using
    (smul_mem_pointwise_smul_iff (a := (ConjAct.toConjAct g)⁻¹) (S := H) (x := x))

/-- An element lies in the conjugate `g H g⁻¹` iff conjugating it back by `g` lands in `H`. -/
theorem mem_conjAct_smul_iff {G : Type*} [Group G] {H : Subgroup G} {g x : G} :
    x ∈ ConjAct.toConjAct g • H ↔ g⁻¹ * x * g ∈ H := by
  rw [mem_pointwise_smul_iff_inv_smul_mem, ← ConjAct.toConjAct_inv, ConjAct.toConjAct_smul,
    inv_inv]

/-- **A central element of a subgroup lies in each of its conjugates**, since conjugation fixes
it. -/
theorem mem_conjAct_smul_of_mem_center {G : Type*} [Group G] {H : Subgroup G} {z : G}
    (hz : z ∈ center G) (c : G) (h : z ∈ H) : z ∈ ConjAct.toConjAct c • H := by
  rw [mem_pointwise_smul_iff_inv_smul_mem, ConjAct.smul_def, map_inv, ConjAct.ofConjAct_toConjAct,
    inv_inv, mem_center_iff.mp hz c⁻¹, inv_mul_cancel_right]
  exact h

/-- **Conjugation does not change the image in a commutative group**: for a homomorphism `f` to
a commutative group, the conjugate `g H g⁻¹` has the same image as `H`, since `f (g x g⁻¹) = f x`.
For instance, conjugate subgroups of `GL_n(R)` have the same determinant image. -/
@[simp]
theorem map_conjAct_smul {G M : Type*} [Group G] [CommGroup M] (H : Subgroup G) (f : G →* M)
    (g : ConjAct G) : (g • H).map f = H.map f := by
  ext y
  simp only [mem_map]
  constructor
  · rintro ⟨x, hx, rfl⟩
    rw [mem_pointwise_smul_iff_inv_smul_mem] at hx
    exact ⟨_, hx, by simp [ConjAct.smul_def]⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨g • x, smul_mem_pointwise_smul _ _ _ hx, by simp [ConjAct.smul_def, mul_inv_cancel_comm]⟩

/-- The conjugate `g ⟨x⟩ g⁻¹` of a cyclic subgroup is the cyclic subgroup generated by the
conjugate `g x g⁻¹`. -/
theorem conjAct_smul_zpowers {G : Type*} [Group G] (g x : G) :
    ConjAct.toConjAct g • zpowers x = zpowers (g * x * g⁻¹) := by
  rw [pointwise_smul_def]
  exact MonoidHom.map_zpowers (MulAut.conj g).toMonoidHom x

/-- The inclusion of a normal subgroup `H` into a larger normal subgroup `K` commutes with the
conjugation actions of `ConjAct G` on `H` and on `K`. -/
theorem inclusion_conj_smul {G : Type*} [Group G] {H K : Subgroup G} [H.Normal] [K.Normal]
    (h : H ≤ K) (g : ConjAct G) (x : H) : inclusion h (g • x) = g • inclusion h x :=
  Subtype.ext <| by
    rw [coe_inclusion, ConjAct.Subgroup.val_conj_smul, ConjAct.Subgroup.val_conj_smul,
      coe_inclusion]

/-- Conjugation only sees `g` modulo the normalizer on the right: `(gh)Γ(gh)⁻¹ = gΓg⁻¹`
whenever `h` normalizes `Γ`. Membership in `Γ` itself is the special case
`Subgroup.le_normalizer`. -/
theorem conjAct_smul_mul_right_of_mem_normalizer {G : Type*} [Group G] (Γ : Subgroup G) (g : G)
    {h : G} (hh : h ∈ normalizer Γ) :
    ConjAct.toConjAct (g * h) • Γ = ConjAct.toConjAct g • Γ := by
  rw [map_mul, ← smul_smul, conjAct_pointwise_smul_eq_self hh]

/-- Left multiplication of the base point by anything normalizing `Γ₁` conjugates the
stabilizer by it: `x` stabilizes `hg` exactly when `h⁻¹xh` stabilizes `g`. Membership in `Γ₁`
itself is the special case `Subgroup.le_normalizer`.

The conjugating automorphism of `↥Γ₁` is `Subgroup.normalizerMonoidHom`, which is defined for
exactly this: `MulAut.conj h` would need `h` to be an element of `Γ₁`. -/
theorem subgroupOf_conjAct_smul_mul_left_of_mem_normalizer {G : Type*} [Group G]
    (Γ₁ Γ₂ : Subgroup G) (g : G) (h : normalizer (Γ₁ : Set G)) :
    (ConjAct.toConjAct ((h : G) * g) • Γ₂).subgroupOf Γ₁ =
      ((ConjAct.toConjAct g • Γ₂).subgroupOf Γ₁).map
        (Γ₁.normalizerMonoidHom h).toMonoidHom := by
  ext x
  rw [mem_map_equiv]
  simp only [mem_subgroupOf, mem_pointwise_smul_iff_inv_smul_mem, ConjAct.smul_def, map_inv,
    ConjAct.ofConjAct_toConjAct, inv_inv, normalizerMonoidHom_apply_symm_apply_coe]
  -- Both sides are membership of the *same* element of `Γ₂`, written with different
  -- bracketing: `(hg)⁻¹x(hg)` versus `g⁻¹(h⁻¹xh)g`. Reassociating proves that identity; the
  -- `iff` is then congruence along it, so no rewriting has to find a redex.
  exact iff_of_eq (congrArg (· ∈ Γ₂) (by simp only [mul_inv_rev, mul_assoc]))

end Subgroup

namespace TauCeti.MulAction

open scoped Pointwise

/-- **Orbits of conjugate subgroups correspond under translation**: if `H'` is the conjugate
`g H g⁻¹` of `H`, then `g • x` and `g • y` lie in the same `H'`-orbit exactly when `x` and `y` lie
in the same `H`-orbit. -/
theorem orbitRel_smul_smul_iff_of_conjAct_smul_eq {G X : Type*} [Group G] [MulAction G X]
    {H H' : Subgroup G} {g : G} (h : ConjAct.toConjAct g • H = H') (x y : X) :
    _root_.MulAction.orbitRel H' X (g • x) (g • y) ↔ _root_.MulAction.orbitRel H X x y := by
  subst h
  simp only [_root_.MulAction.orbitRel_apply, _root_.MulAction.mem_orbit_iff, Subtype.exists,
    Subgroup.mk_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ← ConjAct.toConjAct_inv,
    ConjAct.toConjAct_smul, inv_inv]
  refine ⟨fun ⟨k, hk, hkx⟩ ↦ ⟨g⁻¹ * k * g, hk, ?_⟩, fun ⟨k, hk, hkx⟩ ↦ ⟨g * k * g⁻¹, ?_, ?_⟩⟩
  · rw [mul_smul, mul_smul, hkx, inv_smul_smul]
  · simpa [mul_assoc] using hk
  · rw [mul_smul, mul_smul, inv_smul_smul, hkx]

/-- **Orbits of conjugate subgroups are translates**: if `H'` is the conjugate `g H g⁻¹` of `H`,
then the `H'`-orbit of `g • x` is the translate by `g` of the `H`-orbit of `x`. -/
theorem orbit_smul_of_conjAct_smul_eq {G X : Type*} [Group G] [MulAction G X]
    {H H' : Subgroup G} {g : G} (h : ConjAct.toConjAct g • H = H') (x : X) :
    _root_.MulAction.orbit H' (g • x) = g • _root_.MulAction.orbit H x := by
  ext y
  rw [Set.mem_smul_set_iff_inv_smul_mem, ← _root_.MulAction.orbitRel_apply,
    ← _root_.MulAction.orbitRel_apply, ← orbitRel_smul_smul_iff_of_conjAct_smul_eq h,
    smul_inv_smul]

open _root_.MulAction in
/-- For a normal subgroup `N`, the stabilizer of `g • a` in `N` is the conjugate by `g` of the
stabilizer of `a` in `N`. This is the form of `MulAction.stabilizer_smul_eq_stabilizer_map_conj`
for the action of a normal subgroup. -/
theorem stabilizer_smul_eq_conjNormal_smul {G X : Type*} [Group G] [MulAction G X]
    {N : Subgroup G} [N.Normal] (g : G) (a : X) :
    stabilizer N (g • a) = (MulAut.conjNormal g : MulAut N) • stabilizer N a := by
  ext n
  simp [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, Subgroup.smul_def, mul_smul,
    inv_smul_eq_iff]

end TauCeti.MulAction

open _root_.MulAction in
/-- **A point stabilizer acts faithfully by conjugation on a transitive normal subgroup**: for a
faithful action and a normal subgroup `N` acting transitively, conjugation
`stabilizer G x →* MulAut N` is injective. -/
theorem Subgroup.stabilizer_conjNormal_injective {G X : Type*} [Group G] [MulAction G X]
    [FaithfulSMul G X] (N : Subgroup G) [N.Normal] [IsPretransitive N X] (x : X) :
    Function.Injective ((MulAut.conjNormal (H := N)).comp (stabilizer G x).subtype) := by
  refine (injective_iff_map_eq_one _).mpr fun h hh ↦
    Subtype.ext (eq_of_smul_eq_smul (α := X) fun y ↦ ?_)
  rw [MonoidHom.comp_apply, Subgroup.coe_subtype] at hh
  obtain ⟨n, rfl⟩ := exists_smul_eq N x y
  have hcomm : (h : G) * n = n * h := by
    have hc := congrArg (fun f : MulAut N ↦ ((f n : N) : G)) hh
    simpa only [MulAut.conjNormal_apply, MulAut.one_apply, mul_inv_eq_iff_eq_mul] using hc
  rw [OneMemClass.coe_one, subgroup_smul_def, ← mul_smul, hcomm, mul_smul,
    mem_stabilizer_iff.mp h.property, one_smul]
