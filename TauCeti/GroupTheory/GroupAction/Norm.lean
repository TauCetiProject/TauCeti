module

public import Mathlib.Algebra.BigOperators.GroupWithZero.Action
public import Mathlib.GroupTheory.GroupAction.Hom
public import Mathlib.GroupTheory.OrderOfElement

import Mathlib.GroupTheory.GroupAction.ConjAct
import TauCeti.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# The norm of a finite group action

The norm `TauCeti.groupNorm G M` sums the scalar translates of an element of an additive
commutative monoid. Its definition needs only distributive scalar multiplication by the finite
scalar type. For a finite normal subgroup of a group acting on `M`, the norm commutes with the
ambient action and is bundled as the equivariant additive map `TauCeti.groupNormHom`.

For a finite cyclic group generated by `g`, `TauCeti.groupNorm_eq_sum_range` expresses the norm
as the sum over `1, g, …, gⁿ⁻¹`, where `n = orderOf g`. This formula applies without a ring of
scalars or a representation. Likewise, for a multiplicative inversion action of an even-order cyclic
group, `TauCeti.prod_smul_eq_one_of_smul_eq_inv` shows that the multiplicative norm `∏ x, x • m`
is `1` by pairing consecutive powers of the generator.
-/

public section

namespace TauCeti

/-- The group norm, `m ↦ ∑ x, x • m`, as an additive homomorphism. It needs only a finite
scalar type and distributive scalar multiplication on an additive commutative monoid. -/
def groupNorm (G M : Type*) [Fintype G] [AddCommMonoid M] [DistribSMul G M] : M →+ M :=
  ∑ x : G, DistribSMul.toAddMonoidHom M x

/-- Applying the group norm sums the scalar translates of the argument. -/
@[simp]
theorem groupNorm_apply (G M : Type*) [Fintype G] [AddCommMonoid M] [DistribSMul G M]
    (m : M) : groupNorm G M m = ∑ x : G, x • m := by
  simp [groupNorm]

/-- The norm of a finite normal subgroup `N` of `G` commutes with the action of `G`: conjugation
by `g` permutes `N`. -/
theorem groupNorm_smul {G M : Type*} [Group G] [AddCommMonoid M] [DistribMulAction G M]
    (N : Subgroup G) [N.Normal] [Fintype N] (g : G) (m : M) :
    groupNorm N M (g • m) = g • groupNorm N M m := by
  simp only [groupNorm_apply, Finset.smul_sum, Subgroup.smul_def]
  exact Fintype.sum_equiv (MulAut.conjNormal g⁻¹).toEquiv _ _ fun n ↦ by
    simp [← mul_smul, mul_assoc]

/-- The norm of a finite normal subgroup `N` of `G`, as a `G`-equivariant additive endomorphism
of `M` (`TauCeti.groupNorm_smul`). -/
def groupNormHom {G : Type*} [Group G] (N : Subgroup G) [N.Normal] [Fintype N] (M : Type*)
    [AddCommMonoid M] [DistribMulAction G M] : M →+[G] M :=
  { groupNorm N M with map_smul' := groupNorm_smul N }

/-- The equivariant norm `groupNormHom N M` is the group norm of `N`. -/
@[simp]
theorem groupNormHom_apply {G : Type*} [Group G] (N : Subgroup G) [N.Normal] [Fintype N]
    (M : Type*) [AddCommMonoid M] [DistribMulAction G M] (m : M) :
    groupNormHom N M m = groupNorm N M m :=
  (rfl)

/-- The norm of a finite cyclic group is the sum of the translates by powers of a generator.
Only distributive scalar multiplication on an additive commutative monoid is required. -/
theorem groupNorm_eq_sum_range {G M : Type*} [Group G] [Fintype G] [AddCommMonoid M]
    [DistribSMul G M] (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (m : M) :
    groupNorm G M m = ∑ i ∈ Finset.range (orderOf g), g ^ i • m := by
  rw [groupNorm_apply]
  exact (sum_range_orderOf_eq_sum g hg (fun x ↦ x • m)).symm

private theorem pow_smul_of_smul_eq_inv {G M : Type*} [Group G] [CommGroup M]
    [MulDistribMulAction G M] {g : G} (hinv : ∀ m : M, g • m = m⁻¹) (j : ℕ) (m : M) :
    (g ^ j) • m = if Even j then m else m⁻¹ := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [pow_succ', mul_smul, ih, hinv]
    by_cases hj : Even j <;> simp [hj, Nat.even_add_one]

/-- Under an even-order inversion action of a cyclic group, the multiplicative norm is `1`. -/
theorem prod_smul_eq_one_of_smul_eq_inv {G M : Type*} [Group G] [Fintype G] [CommGroup M]
    [MulDistribMulAction G M] {g : G} (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (hord : Even (orderOf g)) (hinv : ∀ m : M, g • m = m⁻¹) (m : M) :
    ∏ x : G, x • m = 1 := by
  have hprod : ∏ i ∈ Finset.range (orderOf g), (g ^ i) • m = ∏ x : G, x • m := by
    rw [← Fin.prod_univ_eq_prod_range]
    simpa only [Equiv.trans_apply, Equiv.subtypeUnivEquiv_apply, finEquivZPowers_apply] using
      (((finEquivZPowers (isOfFinOrder_of_finite g)).trans
        (Equiv.subtypeUnivEquiv hg)).prod_comp (fun x ↦ x • m))
  rw [← hprod]
  obtain ⟨q, hq⟩ := hord
  rw [hq, ← two_mul]
  clear hq
  induction q with
  | zero => simp
  | succ q ih =>
    have hsucc : 2 * (q + 1) = (2 * q + 1) + 1 := by omega
    rw [hsucc, Finset.prod_range_succ, Finset.prod_range_succ, ih, one_mul,
      pow_smul_of_smul_eq_inv hinv, pow_smul_of_smul_eq_inv hinv]
    simp

end TauCeti
