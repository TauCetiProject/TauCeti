module

public import Mathlib.Algebra.Group.Action.Pretransitive
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.GroupTheory.GroupAction.Defs

/-!
# Fixed points of a generated subgroup

A point is fixed by the subgroup generated by a set exactly when every element of the set
fixes it. This reduces the fixed-point conditions in the Frobenius power criteria to their
generators. Likewise, a function invariant under every element of a set `S` of a group acting on
its domain is invariant under the subgroup generated by `S`
(`TauCeti.apply_eq_of_mem_closure`), hence constant when that subgroup acts transitively
(`TauCeti.apply_eq_apply_of_isPretransitive_closure`).
-/

public section

namespace TauCeti

/-- A generated subgroup fixes a point exactly when all its generators fix that point. -/
theorem forall_mem_closure_smul_eq_self_iff
    {G X : Type*} [Group G] [MulAction G X] {s : Set G} {x : X} :
    (∀ g ∈ Subgroup.closure s, g • x = x) ↔ ∀ g ∈ s, g • x = x := by
  -- Present the fixed-point condition as stabilizer containment so `closure_le` applies.
  change Subgroup.closure s ≤ MulAction.stabilizer G x ↔ _
  rw [Subgroup.closure_le, Set.subset_def]
  rfl

/-- A function invariant under every element of a set `S` of a group acting on `α` is invariant
under the whole subgroup generated by `S`. -/
theorem apply_eq_of_mem_closure {G α β : Type*} [Group G] [MulAction G α] {S : Set G} {f : α → β}
    (hS : ∀ g ∈ S, ∀ a, f (g • a) = f a) {g : G} (hg : g ∈ Subgroup.closure S) (a : α) :
    f (g • a) = f a := by
  induction hg using Subgroup.closure_induction generalizing a with
  | mem g hg => exact hS g hg a
  | one => rw [one_smul]
  | mul g g' _ _ ih ih' => rw [mul_smul, ih, ih']
  | inv g _ ih => rw [← ih (g⁻¹ • a), smul_inv_smul]

/-- A function invariant under every element of a set `S` of a group acting on `α` takes a single
value when the subgroup generated by `S` acts transitively. -/
theorem apply_eq_apply_of_isPretransitive_closure {G α β : Type*} [Group G] [MulAction G α]
    {S : Set G} {f : α → β} (hS : ∀ g ∈ S, ∀ a, f (g • a) = f a)
    (hconn : MulAction.IsPretransitive (Subgroup.closure S) α) (a b : α) : f a = f b := by
  obtain ⟨g, rfl⟩ := hconn.exists_smul_eq a b
  exact (apply_eq_of_mem_closure hS g.2 a).symm

end TauCeti
