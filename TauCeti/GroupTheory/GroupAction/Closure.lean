module

public import Mathlib.Algebra.Group.Action.End
public import Mathlib.Algebra.Group.Action.Pretransitive
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.GroupTheory.GroupAction.Defs

/-!
# Fixed points of a generated subgroup or submonoid

A point is fixed by the subgroup, or the submonoid, generated by a set exactly when every element
of the set fixes it. This reduces the fixed-point conditions in the Frobenius power criteria to
their generators. Likewise, a function invariant under every element of a set `S` of a group
acting on its domain is invariant under the subgroup generated by `S`
(`TauCeti.apply_eq_of_mem_closure`), hence constant when that subgroup acts transitively
(`TauCeti.apply_eq_apply_of_isPretransitive_closure`). More generally, a map between `G`-sets
equivariant under every element of `S` is equivariant under `Subgroup.closure S`
(`TauCeti.apply_smul_eq_of_mem_closure`).

A point is fixed by a whole monoid once it is fixed by a family whose action generates the image of
the action (`TauCeti.forall_smul_eq_self_iff_of_closure_toEndHom_eq_top`).
-/

public section

namespace TauCeti

/-- A generated subgroup fixes a point exactly when all its generators fix that point. -/
theorem forall_mem_closure_smul_eq_self_iff
    {G X : Type*} [Group G] [MulAction G X] {s : Set G} {x : X} :
    (∀ g ∈ Subgroup.closure s, g • x = x) ↔ ∀ g ∈ s, g • x = x :=
  -- The fixed-point condition is containment in the stabilizer, so `closure_le` applies.
  Subgroup.closure_le (MulAction.stabilizer G x)

/-- A generated submonoid fixes a point exactly when all its generators fix that point. -/
theorem Submonoid.forall_mem_closure_smul_eq_self_iff
    {M X : Type*} [Monoid M] [MulAction M X] {s : Set M} {x : X} :
    (∀ g ∈ Submonoid.closure s, g • x = x) ↔ ∀ g ∈ s, g • x = x :=
  -- The fixed-point condition is containment in the stabilizer, so `closure_le` applies.
  Submonoid.closure_le (S := MulAction.stabilizerSubmonoid M x)

/-- A function invariant under every element of a set `S` of a group acting on `α` is invariant
under the whole subgroup generated by `S`. -/
theorem apply_eq_of_mem_closure {G α : Type*} {β : Sort*} [Group G] [MulAction G α] {S : Set G}
    {f : α → β} (hS : ∀ g ∈ S, ∀ a, f (g • a) = f a) {g : G} (hg : g ∈ Subgroup.closure S) (a : α) :
    f (g • a) = f a := by
  induction hg using Subgroup.closure_induction generalizing a with
  | mem g hg => exact hS g hg a
  | one => rw [one_smul]
  | mul g g' _ _ ih ih' => rw [mul_smul, ih, ih']
  | inv g _ ih => rw [← ih (g⁻¹ • a), smul_inv_smul]

/-- A function invariant under every element of a set `S` of a group acting on `α` takes a single
value when the subgroup generated by `S` acts transitively. -/
theorem apply_eq_apply_of_isPretransitive_closure {G α : Type*} {β : Sort*} [Group G]
    [MulAction G α] {S : Set G} {f : α → β} (hS : ∀ g ∈ S, ∀ a, f (g • a) = f a)
    (hconn : MulAction.IsPretransitive (Subgroup.closure S) α) (a b : α) : f a = f b := by
  obtain ⟨g, rfl⟩ := hconn.exists_smul_eq a b
  exact (apply_eq_of_mem_closure hS g.property a).symm

/-- A map between `G`-sets that is equivariant under every element of a set `S` is equivariant
under the whole subgroup generated by `S`. -/
theorem apply_smul_eq_of_mem_closure {G α β : Type*} [Group G] [MulAction G α] [MulAction G β]
    {S : Set G} {f : α → β} (hS : ∀ g ∈ S, ∀ a, f (g • a) = g • f a) {g : G}
    (hg : g ∈ Subgroup.closure S) (a : α) :
    f (g • a) = g • f a := by
  induction hg using Subgroup.closure_induction generalizing a with
  | mem g hg => exact hS g hg a
  | one => rw [one_smul, one_smul]
  | mul g g' _ _ ih ih' => rw [mul_smul, ih, ih', mul_smul]
  | inv g _ ih => rw [← inv_smul_smul g (f (g⁻¹ • a)), ← ih (g⁻¹ • a), smul_inv_smul]

/-- Let `σ : ι → M` be a family whose maps `x ↦ σ i • x` generate the monoid of the maps
`x ↦ g • x` with `g : M` (for instance, a family generating `M` as a monoid). Then a point is fixed
by all of `M` exactly when every `σ i` fixes it. -/
theorem forall_smul_eq_self_iff_of_closure_toEndHom_eq_top {M X : Type*} {ι : Sort*} [Monoid M]
    [MulAction M X] {σ : ι → M}
    (hσ : Submonoid.closure
      (Set.range ((MulAction.toEndHom (M := M) (α := X)).mrangeRestrict ∘ σ)) = ⊤) {x : X} :
    (∀ g : M, g • x = x) ↔ ∀ i, σ i • x = x := by
  refine ⟨fun h i ↦ h (σ i), fun h g ↦ ?_⟩
  -- An element of `M` and its image in the image of the action move `x` alike: by definition,
  -- `MulAction.toEndHom g` is the map `(g • ·)`.
  have key (g : M) : (MulAction.toEndHom (M := M) (α := X)).mrangeRestrict g • x = g • x := by
    rw [Submonoid.smul_def, MonoidHom.coe_mrangeRestrict, Function.End.smul_def]
    rfl
  have hx := (Submonoid.forall_mem_closure_smul_eq_self_iff (x := x)).2 <|
    Set.forall_mem_range.2 fun i ↦ (key (σ i)).trans (h i)
  rw [← key]
  exact hx _ (hσ ▸ Submonoid.mem_top _)

end TauCeti
