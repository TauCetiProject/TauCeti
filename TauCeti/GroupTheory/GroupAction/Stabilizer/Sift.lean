public import TauCeti.Algebra.Group.Subgroup.Closure
public import TauCeti.GroupTheory.GroupAction.Orbit.Card
public import TauCeti.GroupTheory.GroupAction.Stabilizer.Chain

/-!
# Orders of groups from sifting

Let a group `G` act on `α`, let `b 0, b 1, …` be points of `α` and let `T 0, T 1, …` be finite
lists of elements of `G`. *Sifting* an element `g` through `T i, …, T (i + n - 1)` along
`b i, …, b (i + n - 1)` picks the first `r ∈ T i` sending `b i` where `g` does, replaces `g` by the
residue `r⁻¹ * g`, and continues with the next list; it succeeds when every step finds such an
`r` and the final residue is `1`. Since each step only compares images of points and the last one
compares an element with `1`, `TauCeti.sift` is a finite computation that `decide` can run.

This file turns successful sifts into the order of a group. Suppose that each `T i`, `i < k`, is a
nonempty list of elements of the `i`-th member `H.stabilizerChain b i` of the stabilizer chain of
`H` with distinct images of `b i`, that `H` is generated by (a subset of the subgroup generated
by) the elements of the lists, and that for `i ≤ j < k` every product `s * r` with `s ∈ T j` and
`r ∈ T i` sifts through `T i, …, T (k - 1)`. Then `Nat.card H` is the product of the lengths of the
lists (`Subgroup.natCard_eq_prod_length_of_sift`), and `b 0, …, b (k - 1)` is a base of `H`
(`Subgroup.stabilizerChain_eq_bot_of_sift`).

The lower bound is the stabilizer-chain order formula: the images of `b i` under `T i` lie in the
`i`-th basic orbit. The upper bound is a covering argument: if left multiplication by every element
of a set `S` maps `R * K` into itself, for a finite subgroup `K` and a finite nonempty set `R`,
then the subgroup generated by `S` stabilizes the finite set `R * K` and hence has at most
`|R| * |K|` elements (`Subgroup.natCard_closure_le_ncard_mul`, in
`TauCeti.Algebra.Group.Subgroup.Closure`). Applied to the subgroups generated by the lists from
level `i` on, the successful sifts are exactly these covering conditions, level by level. Nothing
about the stabilizer chain of `H` is assumed in advance: apart from the memberships of the elements
of the lists in `H` and of `H` in the subgroup they generate, every hypothesis is a finite check on
the lists.

## Main declarations

* `TauCeti.sift`: sifting through lists of group elements along a sequence of points.
* `TauCeti.sift_succ`: one step of a sift, by the first matching element of the list.
* `TauCeti.inv_mul_mem_closure_of_sift`: an element that sifts is a product of elements of the
  lists.
* `Subgroup.natCard_eq_prod_length_of_sift`: the order of a group from successful sifts.
* `Subgroup.stabilizerChain_eq_bot_of_sift`: the points form a base.
* `TauCeti.transversalCheck`, `TauCeti.siftCheck`: the finite hypotheses as checks that `decide`
  can run.
* `Subgroup.natCard_eq_prod_length_of_siftCheck`, `Subgroup.stabilizerChain_eq_bot_of_siftCheck`:
  the same conclusions from these checks and a list of generators of `H` that sift.

## References

* C. C. Sims, *Computational methods in the study of permutation groups*, in Computational
  Problems in Abstract Algebra, Pergamon, 1970, 169–183.
* Á. Seress, *Permutation Group Algorithms*, Cambridge Tracts in Mathematics 152, Cambridge
  University Press, 2003, §4.1–§4.2.
-/

public section

open MulAction Pointwise

namespace TauCeti

variable {G α : Type*} [Group G] [MulAction G α] [DecidableEq α] [DecidableEq G]

/-- Sifting `g` through the lists `T i, …, T (i + n - 1)` along the points `b i, …, b (i + n - 1)`,
starting from the partial product `p`: pick the first `r ∈ T i` with `(p * r) • b i = g • b i` and
continue from `p * r` with the remaining `n - 1` lists; fail if there is no such `r`, and after the
last list succeed exactly when the partial product is `g`. Sifting from `p = 1` is the usual sift of
`g`, whose residue after a step is `(p * r)⁻¹ * g`; tracking `p` instead of the residue avoids
inverses, so `sift` computes as fast as the products of its arguments do. The body is exposed so
that `decide` can run a sift in an importing module. -/
@[expose] def sift (b : ℕ → α) (T : ℕ → List G) : ℕ → ℕ → G → G → Bool
  | _, 0, p, g => decide (p = g)
  | i, n + 1, p, g =>
    match (T i).find? fun r ↦ decide ((p * r) • b i = g • b i) with
    | some r => sift b T (i + 1) n (p * r) g
    | none => false

variable {b : ℕ → α} {T : ℕ → List G}

@[simp]
theorem sift_zero (i : ℕ) (p g : G) : sift b T i 0 p g = decide (p = g) := by
  simp [sift]

/-- One step of a sift: sifting through `n + 1` lists from `p` finds the first `r ∈ T i` with
`(p * r) • b i = g • b i` and sifts through the remaining `n` lists from `p * r`, failing if there
is no such `r`. -/
theorem sift_succ (i n : ℕ) (p g : G) :
    sift b T i (n + 1) p g = ((T i).find? fun r ↦ decide ((p * r) • b i = g • b i)).elim false
      fun r ↦ sift b T (i + 1) n (p * r) g := by
  rw [sift]
  cases (T i).find? fun r ↦ decide ((p * r) • b i = g • b i) <;> rfl

/-- A sift step that finds `r` continues from `p * r`. -/
theorem sift_succ_of_find?_eq_some {i n : ℕ} {p g r : G}
    (h : (T i).find? (fun r ↦ decide ((p * r) • b i = g • b i)) = some r) :
    sift b T i (n + 1) p g = sift b T (i + 1) n (p * r) g := by
  rw [sift_succ, h, Option.elim_some]

/-- A sift step that finds no matching element fails. -/
@[simp]
theorem sift_succ_of_find?_eq_none {i n : ℕ} {p g : G}
    (h : (T i).find? (fun r ↦ decide ((p * r) • b i = g • b i)) = none) :
    sift b T i (n + 1) p g = false := by
  rw [sift_succ, h, Option.elim_none]

/-- A successful sift of length `n + 1` starts with an element `r ∈ T i` with
`(p * r) • b i = g • b i`, and continues from `p * r`. -/
theorem exists_of_sift_succ {i n : ℕ} {p g : G} (h : sift b T i (n + 1) p g = true) :
    ∃ r ∈ T i, (p * r) • b i = g • b i ∧ sift b T (i + 1) n (p * r) g = true := by
  rw [sift] at h
  split at h
  · rename_i r hr
    exact ⟨r, List.mem_of_find?_eq_some hr, by simpa using List.find?_some hr, h⟩
  · exact absurd h Bool.false_ne_true

/-- **Sifting is sound.** If `g` sifts through `T i, …, T (i + n - 1)` from `p`, then `p⁻¹ * g`
lies in the subgroup generated by the elements of these lists. -/
theorem inv_mul_mem_closure_of_sift {i n : ℕ} {p g : G} (h : sift b T i n p g = true) :
    p⁻¹ * g ∈ Subgroup.closure {r | ∃ j, i ≤ j ∧ j < i + n ∧ r ∈ T j} := by
  induction n generalizing i p with
  | zero =>
    rw [sift_zero, decide_eq_true_iff] at h
    simp [h]
  | succ n ih =>
    obtain ⟨r, hr, -, hres⟩ := exists_of_sift_succ h
    have hle : Subgroup.closure {r | ∃ j, i + 1 ≤ j ∧ j < i + 1 + n ∧ r ∈ T j} ≤
        Subgroup.closure {r | ∃ j, i ≤ j ∧ j < i + (n + 1) ∧ r ∈ T j} :=
      Subgroup.closure_mono fun x ⟨j, hj, hj', hx⟩ ↦ ⟨j, by omega, by omega, hx⟩
    have hr' : r ∈ Subgroup.closure {r | ∃ j, i ≤ j ∧ j < i + (n + 1) ∧ r ∈ T j} :=
      Subgroup.subset_closure ⟨i, le_rfl, by omega, hr⟩
    simpa [mul_assoc] using mul_mem hr' (hle (ih hres))

/-- The finite checks on the lists `T 0, …, T (k - 1)` alone: each `T i` is nonempty, its elements
fix `b 0, …, b (i - 1)`, and their images of `b i` are distinct. The body is exposed so that
`decide` can run the check in an importing module. -/
@[expose] def transversalCheck (b : ℕ → α) (T : ℕ → List G) (k : ℕ) : Bool :=
  (List.range k).all fun i ↦ !(T i).isEmpty &&
    ((T i).all fun r ↦ (List.range i).all fun j ↦ decide (r • b j = b j)) &&
    decide ((T i).map (· • b i)).Nodup

/-- The sifting conditions at level `i`: for `i ≤ j < k`, every product `s * r` with `s ∈ T j`
and `r ∈ T i` sifts through `T i, …, T (k - 1)`. The body is exposed so that `decide` can run the
check in an importing module. -/
@[expose] def siftCheck (b : ℕ → α) (T : ℕ → List G) (k i : ℕ) : Bool :=
  ((List.range k).filter (i ≤ ·)).all fun j ↦ (T j).all fun s ↦
    (T i).all fun r ↦ sift b T i (k - i) 1 (s * r)

end TauCeti

namespace Subgroup

variable {G α : Type*} [Group G] [MulAction G α] {H : Subgroup G} {b : ℕ → α}
  [DecidableEq α] [DecidableEq G] {T : ℕ → List G} {k : ℕ}

/-- The subgroup generated by the lists `T i, …, T (k - 1)` is finite, with at most
`|T i| * ⋯ * |T (k - 1)|` elements, when every product of an element of a later list with an
element of `T i` sifts. -/
private theorem finite_closure_and_natCard_le_of_sift (hne : ∀ i < k, T i ≠ [])
    (hsift : ∀ i < k, ∀ j < k, i ≤ j → ∀ s ∈ T j, ∀ r ∈ T i,
      TauCeti.sift b T i (k - i) 1 (s * r) = true) (i : ℕ) :
    Finite (closure {r | ∃ j, i ≤ j ∧ j < k ∧ r ∈ T j}) ∧
      Nat.card (closure {r | ∃ j, i ≤ j ∧ j < k ∧ r ∈ T j}) ≤
        ∏ j ∈ Finset.Ico i k, (T j).length := by
  induction h : k - i generalizing i with
  | zero =>
    have hS : {r | ∃ j, i ≤ j ∧ j < k ∧ r ∈ T j} = ∅ :=
      Set.eq_empty_of_forall_notMem fun r ⟨j, hj, hj', _⟩ ↦ by omega
    rw [hS, closure_empty, Finset.Ico_eq_empty (by omega)]
    exact ⟨inferInstance, by simp⟩
  | succ n ih =>
    obtain ⟨hfin, hcard⟩ := ih (i + 1) (by omega)
    have hcover : ∀ s ∈ {r | ∃ j, i ≤ j ∧ j < k ∧ r ∈ T j}, ∀ r ∈ {r | r ∈ T i},
        s * r ∈ {r | r ∈ T i} * (closure {r | ∃ j, i + 1 ≤ j ∧ j < k ∧ r ∈ T j} : Set G) := by
      rintro s ⟨j, hij, hjk, hs⟩ r hr
      have hs' := hsift i (by omega) j hjk hij s hs r hr
      rw [h] at hs'
      obtain ⟨r', hr', -, hres⟩ := TauCeti.exists_of_sift_succ hs'
      have := TauCeti.inv_mul_mem_closure_of_sift hres
      have hk : i + 1 + n = k := by omega
      rw [hk, one_mul] at this
      exact ⟨r', hr', r'⁻¹ * (s * r), this, mul_inv_cancel_left r' _⟩
    have hR : ({r | r ∈ T i} : Set G).Nonempty := List.exists_mem_of_ne_nil _ (hne i (by omega))
    have hik : i < k := by omega
    refine ⟨finite_closure_of_forall_mul_mem (List.finite_toSet _) hR hcover, ?_⟩
    calc _ ≤ ({r | r ∈ T i} : Set G).ncard *
          Nat.card (closure {r | ∃ j, i + 1 ≤ j ∧ j < k ∧ r ∈ T j}) :=
        natCard_closure_le_ncard_mul (List.finite_toSet _) hR hcover
      _ ≤ (T i).length * ∏ j ∈ Finset.Ico (i + 1) k, (T j).length := by
        gcongr
        rw [← List.coe_toFinset, Set.ncard_coe_finset]
        exact List.toFinset_card_le _
      _ = ∏ j ∈ Finset.Ico i k, (T j).length :=
        (Finset.prod_eq_prod_Ico_succ_bot hik fun j ↦ (T j).length).symm

/-- The two bounds behind `natCard_eq_prod_length_of_sift`: `H` is finite, the lengths of the lists
are bounded by the basic orbits, and the order of `H` by the product of the lengths. -/
private theorem prod_length_le_and_natCard_le_of_sift
    (hT : ∀ i < k, ∀ r ∈ T i, r ∈ H.stabilizerChain b i)
    (hne : ∀ i < k, T i ≠ []) (hnodup : ∀ i < k, ((T i).map (· • b i)).Nodup)
    (hH : H ≤ closure {r | ∃ i < k, r ∈ T i})
    (hsift : ∀ i < k, ∀ j < k, i ≤ j → ∀ s ∈ T j, ∀ r ∈ T i,
      TauCeti.sift b T i (k - i) 1 (s * r) = true) :
    Finite H ∧ ∏ i ∈ Finset.range k, (T i).length ≤
        ∏ i ∈ Finset.range k, (orbit (H.stabilizerChain b i) (b i)).ncard ∧
      Nat.card H ≤ ∏ i ∈ Finset.range k, (T i).length := by
  have hS : {r | ∃ j, 0 ≤ j ∧ j < k ∧ r ∈ T j} = {r | ∃ i < k, r ∈ T i} := by simp
  obtain ⟨hfin, hcard⟩ := finite_closure_and_natCard_le_of_sift hne hsift 0
  rw [hS] at hfin hcard
  rw [← Finset.range_eq_Ico] at hcard
  have : Finite H := Finite.of_injective _ (inclusion_injective hH)
  exact ⟨this, Finset.prod_le_prod fun i hi ↦
      length_le_ncard_orbit (hT i (Finset.mem_range.1 hi)) (hnodup i (Finset.mem_range.1 hi))
        (Finite.finite_mulAction_orbit _),
    (card_le_of_le hH).trans hcard⟩

/-- **The order of a group from successful sifts.** Let `T 0, …, T (k - 1)` be nonempty lists, each
`T i` consisting of elements of the `i`-th member of the stabilizer chain of `H` along `b` with
distinct images of `b i`, such that `H` lies in the subgroup generated by their elements. If for
`i ≤ j < k` every product `s * r` with `s ∈ T j` and `r ∈ T i` sifts through
`T i, …, T (k - 1)`, then the order of `H` is the product of the lengths of the lists. -/
theorem natCard_eq_prod_length_of_sift (hT : ∀ i < k, ∀ r ∈ T i, r ∈ H.stabilizerChain b i)
    (hne : ∀ i < k, T i ≠ []) (hnodup : ∀ i < k, ((T i).map (· • b i)).Nodup)
    (hH : H ≤ closure {r | ∃ i < k, r ∈ T i})
    (hsift : ∀ i < k, ∀ j < k, i ≤ j → ∀ s ∈ T j, ∀ r ∈ T i,
      TauCeti.sift b T i (k - i) 1 (s * r) = true) :
    Nat.card H = ∏ i ∈ Finset.range k, (T i).length := by
  obtain ⟨hfin, hlow, hup⟩ := prod_length_le_and_natCard_le_of_sift hT hne hnodup hH hsift
  have hpos : 0 < Nat.card (H.stabilizerChain b k) := Nat.card_pos
  refine le_antisymm hup (hlow.trans ?_)
  rw [← H.prod_ncard_orbit_mul_card_stabilizerChain b k]
  exact Nat.le_mul_of_pos_right _ hpos

/-- **The points form a base.** Under the hypotheses of `natCard_eq_prod_length_of_sift`, no
element of `H` other than `1` fixes all of `b 0, …, b (k - 1)`. -/
theorem stabilizerChain_eq_bot_of_sift (hT : ∀ i < k, ∀ r ∈ T i, r ∈ H.stabilizerChain b i)
    (hne : ∀ i < k, T i ≠ []) (hnodup : ∀ i < k, ((T i).map (· • b i)).Nodup)
    (hH : H ≤ closure {r | ∃ i < k, r ∈ T i})
    (hsift : ∀ i < k, ∀ j < k, i ≤ j → ∀ s ∈ T j, ∀ r ∈ T i,
      TauCeti.sift b T i (k - i) 1 (s * r) = true) :
    H.stabilizerChain b k = ⊥ := by
  obtain ⟨hfin, hlow, hup⟩ := prod_length_le_and_natCard_le_of_sift hT hne hnodup hH hsift
  have hpos : 0 < ∏ i ∈ Finset.range k, (T i).length :=
    Finset.prod_pos fun i hi ↦ List.length_pos_iff.2 (hne i (Finset.mem_range.1 hi))
  rw [← card_le_one_iff_eq_bot]
  rw [← H.prod_ncard_orbit_mul_card_stabilizerChain b k] at hup
  by_contra hlt
  have := Nat.mul_lt_mul_of_le_of_lt hlow (not_le.1 hlt) (hpos.trans_le hlow)
  omega

/-- The hypotheses of `natCard_eq_prod_length_of_sift` from the finite checks
`TauCeti.transversalCheck` and `TauCeti.siftCheck`, the memberships of the listed elements in `H`,
and generators of `H` that sift. -/
private theorem hypotheses_of_siftCheck {gens : List G} (hT : ∀ i < k, ∀ r ∈ T i, r ∈ H)
    (hH : H ≤ closure {g | g ∈ gens}) (htrans : TauCeti.transversalCheck b T k = true)
    (hgens : gens.all (TauCeti.sift b T 0 k 1) = true)
    (hsift : ∀ i < k, TauCeti.siftCheck b T k i = true) :
    (∀ i < k, ∀ r ∈ T i, r ∈ H.stabilizerChain b i) ∧ (∀ i < k, T i ≠ []) ∧
      (∀ i < k, ((T i).map (· • b i)).Nodup) ∧ H ≤ closure {r | ∃ i < k, r ∈ T i} ∧
      ∀ i < k, ∀ j < k, i ≤ j → ∀ s ∈ T j, ∀ r ∈ T i,
        TauCeti.sift b T i (k - i) 1 (s * r) = true := by
  simp only [TauCeti.transversalCheck, List.all_eq_true, List.mem_range, Bool.and_eq_true,
    Bool.not_eq_true', List.isEmpty_eq_false_iff, decide_eq_true_eq] at htrans
  simp only [List.all_eq_true] at hgens
  refine ⟨fun i hi r hr ↦ (mem_stabilizerChain_iff _ _).2 ⟨hT i hi r hr, (htrans i hi).1.2 r hr⟩,
    fun i hi ↦ (htrans i hi).1.1, fun i hi ↦ (htrans i hi).2, hH.trans ((closure_le _).2 ?_), ?_⟩
  · intro g hg
    have := TauCeti.inv_mul_mem_closure_of_sift (hgens g hg)
    rwa [inv_one, one_mul, zero_add, show {r | ∃ j, 0 ≤ j ∧ j < k ∧ r ∈ T j} =
      {r | ∃ i < k, r ∈ T i} by simp] at this
  · intro i hi j hj hij s hs r hr
    have h := hsift i hi
    simp only [TauCeti.siftCheck, List.all_eq_true, List.mem_filter, List.mem_range,
      decide_eq_true_eq] at h
    exact h j ⟨hj, hij⟩ s hs r hr

/-- **The order of a group from sifting checks.** A form of `natCard_eq_prod_length_of_sift` whose
finite hypotheses are the checks `TauCeti.transversalCheck` and `TauCeti.siftCheck`, which `decide`
can run, and in which `H` is generated by the elements of a list `gens` that sift through
`T 0, …, T (k - 1)`. -/
theorem natCard_eq_prod_length_of_siftCheck {gens : List G} (hT : ∀ i < k, ∀ r ∈ T i, r ∈ H)
    (hH : H ≤ closure {g | g ∈ gens}) (htrans : TauCeti.transversalCheck b T k = true)
    (hgens : gens.all (TauCeti.sift b T 0 k 1) = true)
    (hsift : ∀ i < k, TauCeti.siftCheck b T k i = true) :
    Nat.card H = ∏ i ∈ Finset.range k, (T i).length :=
  let ⟨h₁, h₂, h₃, h₄, h₅⟩ := hypotheses_of_siftCheck hT hH htrans hgens hsift
  natCard_eq_prod_length_of_sift h₁ h₂ h₃ h₄ h₅

/-- **The points form a base, from sifting checks.** Under the hypotheses of
`natCard_eq_prod_length_of_siftCheck`, no element of `H` other than `1` fixes all of
`b 0, …, b (k - 1)`. -/
theorem stabilizerChain_eq_bot_of_siftCheck {gens : List G} (hT : ∀ i < k, ∀ r ∈ T i, r ∈ H)
    (hH : H ≤ closure {g | g ∈ gens}) (htrans : TauCeti.transversalCheck b T k = true)
    (hgens : gens.all (TauCeti.sift b T 0 k 1) = true)
    (hsift : ∀ i < k, TauCeti.siftCheck b T k i = true) :
    H.stabilizerChain b k = ⊥ :=
  let ⟨h₁, h₂, h₃, h₄, h₅⟩ := hypotheses_of_siftCheck hT hH htrans hgens hsift
  stabilizerChain_eq_bot_of_sift h₁ h₂ h₃ h₄ h₅

end Subgroup
