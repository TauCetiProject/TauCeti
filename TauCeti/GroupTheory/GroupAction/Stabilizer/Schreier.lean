module

public import TauCeti.GroupTheory.GroupAction.Stabilizer.Chain
import TauCeti.GroupTheory.GroupAction.Orbit.Closure

/-!
# Schreier generators of a point stabilizer

Let a group `G` act on `α`, let `S` be a set of elements of `G` and `x` a point of `α`. A
*transversal map* for the orbit of `x` under `Subgroup.closure S` is a function `t : α → G` that
picks, for each point `y` of the orbit, an element `t y` of the closure carrying `x` to `y`. The
*Schreier generators* of `S` relative to `t` are the elements `(t (s • y))⁻¹ * s * t y` for
`s ∈ S` and `y` in the orbit; each of them fixes `x`. Schreier's lemma in this form says that
they generate the stabilizer of `x` in `Subgroup.closure S`.

This is the orbit-indexed form of Schreier's lemma used for permutation groups: the transversal is
indexed by the points of the orbit, as in a Schreier vector, rather than by the cosets of the
stabilizer as in Mathlib's `Subgroup.closure_mul_image_eq`, and it acts on the left, as Mathlib's
permutations do. No normalization `t x = 1` is needed: `t x` fixes `x` and lies in the closure, so
it lies in the stabilizer.

Along a stabilizer chain, this turns generators of one member and a transversal map for its basic
orbit into generators of the next member. The basic orbits of the next member are then the orbits
of the subgroup generated by the Schreier generators, which `MulAction.isLeast_orbit_closure`
describes as least closed sets. With a finite generating set and a finite basic orbit there are
finitely many Schreier generators.

## Main declarations

* `MulAction.schreierGenerators`: the Schreier generators of `S` relative to a transversal map.
* `MulAction.inv_mul_mul_mem_closure_schreierGenerators`: for every `g` in `Subgroup.closure S`
  and every `y` in the orbit, `(t (g • y))⁻¹ * g * t y` is a product of Schreier generators.
* `MulAction.closure_schreierGenerators`: **Schreier's lemma**: the Schreier generators generate
  the stabilizer of `x` in `Subgroup.closure S`.
* `MulAction.finite_schreierGenerators`: there are finitely many Schreier generators when `S`
  and the orbit are finite.
* `Subgroup.stabilizerChain_succ_eq_closure_schreierGenerators`: generators of the next member of
  a stabilizer chain from generators of the previous one.

## References

* O. Schreier, *Die Untergruppen der freien Gruppen*, Abh. Math. Sem. Univ. Hamburg 5 (1927).
* Á. Seress, *Permutation Group Algorithms*, Cambridge Tracts in Mathematics 152, Cambridge
  University Press, 2003, §4.2 (Schreier's lemma and Schreier generators).
-/

public section

open Subgroup

namespace MulAction

variable {G α : Type*} [Group G] [MulAction G α]

/-- The **Schreier generators** of `S` at the point `x` relative to the map `t : α → G`: the
elements `(t (s • y))⁻¹ * s * t y` for `s ∈ S` and `y` in the orbit of `x` under
`Subgroup.closure S`. When `t` is a transversal map for this orbit, they generate the stabilizer
of `x` in `Subgroup.closure S` (`MulAction.closure_schreierGenerators`). -/
def schreierGenerators (S : Set G) (t : α → G) (x : α) : Set G :=
  Set.image2 (fun s y ↦ (t (s • y))⁻¹ * s * t y) S (orbit (closure S) x)

variable {S : Set G} {t : α → G} {x : α}

@[simp]
theorem mem_schreierGenerators_iff {g : G} :
    g ∈ schreierGenerators S t x ↔
      ∃ s ∈ S, ∃ y ∈ orbit (closure S) x, (t (s • y))⁻¹ * s * t y = g :=
  Iff.rfl

/-- The Schreier generator at `s ∈ S` and a point `y` of the orbit of `x`. -/
theorem inv_mul_mul_mem_schreierGenerators {s : G} (hs : s ∈ S) {y : α}
    (hy : y ∈ orbit (closure S) x) : (t (s • y))⁻¹ * s * t y ∈ schreierGenerators S t x :=
  Set.mem_image2_of_mem hs hy

/-- There are finitely many Schreier generators when the generating set and the orbit are
finite. -/
theorem finite_schreierGenerators (hS : S.Finite) (hx : (orbit (closure S) x).Finite) :
    (schreierGenerators S t x).Finite :=
  hS.image2 _ hx

/-- Every element `g` of `Subgroup.closure S` is a product of Schreier generators up to the
values of `t` at the orbit points `y` and `g • y`: `(t (g • y))⁻¹ * g * t y` lies in the
subgroup they generate. This holds for every map `t : α → G`. -/
theorem inv_mul_mul_mem_closure_schreierGenerators {g : G} (hg : g ∈ closure S) {y : α}
    (hy : y ∈ orbit (closure S) x) :
    (t (g • y))⁻¹ * g * t y ∈ closure (schreierGenerators S t x) := by
  induction hg using closure_induction_left generalizing y with
  | one => simp
  | mul_left s hs g hg ih =>
    have hgy : g • y ∈ orbit (closure S) x := mem_orbit_of_mem_orbit (⟨g, hg⟩ : closure S) hy
    have h := mul_mem (subset_closure (inv_mul_mul_mem_schreierGenerators (t := t) hs hgy)) (ih hy)
    simpa [mul_smul, mul_assoc] using h
  | inv_mul_cancel s hs g hg ih =>
    have hz : s⁻¹ • g • y ∈ orbit (closure S) x :=
      inv_smul_mem_orbit_closure hs (mem_orbit_of_mem_orbit (⟨g, hg⟩ : closure S) hy)
    have h := mul_mem
      (inv_mem (subset_closure (inv_mul_mul_mem_schreierGenerators (t := t) hs hz))) (ih hy)
    simpa [mul_smul, mul_assoc] using h

/-- **Schreier's lemma** for a point stabilizer: if `t` sends each point `y` of the orbit of `x`
under `Subgroup.closure S` to an element of the closure carrying `x` to `y`, then the Schreier
generators `(t (s • y))⁻¹ * s * t y` generate the stabilizer of `x` in `Subgroup.closure S`. -/
theorem closure_schreierGenerators
    (ht : ∀ y ∈ orbit (closure S) x, t y ∈ closure S ∧ t y • x = y) :
    closure (schreierGenerators S t x) = closure S ⊓ stabilizer G x := by
  have hx : x ∈ orbit (closure S) x := mem_orbit_self x
  apply le_antisymm
  · rw [closure_le]
    rintro - ⟨s, hs, y, hy, rfl⟩
    have hsy : s • y ∈ orbit (closure S) x := smul_mem_orbit_closure hs hy
    rw [SetLike.mem_coe, mem_inf, mem_stabilizer_iff]
    refine ⟨mul_mem (mul_mem (inv_mem (ht _ hsy).1) (subset_closure hs)) (ht y hy).1, ?_⟩
    rw [mul_smul, mul_smul, (ht y hy).2, inv_smul_eq_iff, (ht _ hsy).2]
  · intro g hg
    obtain ⟨hgS, hgx⟩ := mem_inf.mp hg
    rw [mem_stabilizer_iff] at hgx
    -- both `t x` and `(t x)⁻¹ * g * t x` lie in the closure of the Schreier generators
    have htx : t x ∈ closure (schreierGenerators S t x) := by
      simpa [(ht x hx).2] using inv_mul_mul_mem_closure_schreierGenerators (t := t) (ht x hx).1 hx
    have h := inv_mul_mul_mem_closure_schreierGenerators (t := t) hgS hx
    rw [hgx] at h
    simpa [mul_assoc] using mul_mem (mul_mem htx h) (inv_mem htx)

end MulAction

namespace Subgroup

open MulAction

variable {G α : Type*} [Group G] [MulAction G α] {H : Subgroup G} {b : ℕ → α} {i : ℕ}
  {S : Set G} {t : α → G}

/-- **Schreier's lemma along a stabilizer chain**: if `S` generates the `i`-th member of the
stabilizer chain of `H` and `t` is a transversal map for its `i`-th basic orbit, then the
Schreier generators of `S` at `b i` relative to `t` generate the `(i + 1)`-st member. -/
theorem stabilizerChain_succ_eq_closure_schreierGenerators (hS : closure S = H.stabilizerChain b i)
    (ht : ∀ y ∈ orbit (H.stabilizerChain b i) (b i),
      t y ∈ H.stabilizerChain b i ∧ t y • b i = y) :
    H.stabilizerChain b (i + 1) = closure (schreierGenerators S t (b i)) := by
  rw [stabilizerChain_succ, ← hS, closure_schreierGenerators]
  rwa [hS]

end Subgroup
