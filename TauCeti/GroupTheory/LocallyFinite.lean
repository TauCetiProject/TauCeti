module

public import Mathlib.GroupTheory.FiniteAbelian.Basic

/-!
# Locally finite groups

A group is **locally finite** when each of its finitely generated subgroups is finite, that is,
when the subgroup generated by any finite set of elements is finite
(`TauCeti.Group.IsLocallyFinite`). Finite groups are locally finite, and locally finite groups are
torsion groups. For commutative groups the converse holds: a finitely generated commutative
torsion group is finite, so a commutative group is locally finite exactly when it is a torsion
group (`TauCeti.Group.isLocallyFinite_iff_isMulTorsion`). For noncommutative groups the converse
is the general Burnside problem, which has a negative answer.

Every group is the directed union of the subgroups generated by its finite subsets
(`TauCeti.Group.directed_closure_finset`, `TauCeti.Group.iSup_closure_finset`). So a locally
finite group is a directed union of finite subgroups, which is how properties of finite groups that
are compatible with directed unions, such as the vanishing or torsion of positive-degree group
homology, pass to locally finite groups.

## Main definitions

* `TauCeti.Group.IsLocallyFinite`: every finitely generated subgroup is finite.

## Main results

* `TauCeti.Group.isLocallyFinite_iff_forall_fg`: a group is locally finite exactly when every
  finitely generated subgroup (`Group.FG`) is finite.
* `TauCeti.Group.IsLocallyFinite.of_finite`: finite groups are locally finite.
* `TauCeti.Group.IsLocallyFinite.isMulTorsion`: locally finite groups are torsion groups.
* `TauCeti.Group.isLocallyFinite_iff_isMulTorsion`: a commutative group is locally finite exactly
  when it is a torsion group; `TauCeti.Group.isLocallyFinite_multiplicative_iff` is the same
  statement for an additive group `A` viewed as `Multiplicative A`.
* `TauCeti.Group.directed_closure_finset` and `TauCeti.Group.iSup_closure_finset`: the subgroups
  generated by finite subsets form a directed family whose union is the whole group.

## References

* O. H. Kegel and B. A. F. Wehrfritz, *Locally finite groups*, North-Holland Mathematical
  Library 3, North-Holland, 1973.
-/

public section

namespace TauCeti

section Closure

variable (G : Type*) [Group G]

/-- The subgroups generated by the finite subsets of a group form a directed family. -/
theorem Group.directed_closure_finset :
    Directed (· ≤ ·) fun s : Finset G ↦ Subgroup.closure (s : Set G) := by
  classical
  exact fun s t ↦ ⟨s ∪ t, Subgroup.closure_mono (by simp), Subgroup.closure_mono (by simp)⟩

/-- A group is the union of the subgroups generated by its finite subsets. -/
theorem Group.iSup_closure_finset : ⨆ s : Finset G, Subgroup.closure (s : Set G) = ⊤ :=
  eq_top_iff.2 fun g _ ↦ Subgroup.mem_iSup_of_mem {g} (Subgroup.subset_closure (by simp))

end Closure

/-- A group is **locally finite** when each of its finitely generated subgroups is finite: the
subgroup generated by any finite set of elements is finite. -/
class Group.IsLocallyFinite (G : Type*) [Group G] : Prop where
  /-- The subgroup generated by a finite set is finite. -/
  finite_closure (s : Set G) (hs : s.Finite) : Finite (Subgroup.closure s)

namespace Group.IsLocallyFinite

variable {G : Type*} [Group G]

/-- In a locally finite group, the subgroup generated by a finite set of elements is finite. -/
instance finite_closure_finset [IsLocallyFinite G] (s : Finset G) :
    Finite (Subgroup.closure (s : Set G)) :=
  finite_closure _ s.finite_toSet

/-- Finite groups are locally finite. -/
instance of_finite [Finite G] : IsLocallyFinite G :=
  ⟨fun _ _ ↦ inferInstance⟩

/-- **Locally finite groups are torsion groups**: every element generates a finite subgroup. -/
theorem isMulTorsion [IsLocallyFinite G] : IsMulTorsion G := fun g ↦ by
  have := finite_closure_finset ({g} : Finset G)
  exact Submonoid.isOfFinOrder_coe.2 (isOfFinOrder_of_finite
    (⟨g, Subgroup.subset_closure (by simp)⟩ : Subgroup.closure (({g} : Finset G) : Set G)))

end Group.IsLocallyFinite

/-- A group is locally finite exactly when every finitely generated subgroup is finite. -/
theorem Group.isLocallyFinite_iff_forall_fg {G : Type*} [Group G] :
    Group.IsLocallyFinite G ↔ ∀ H : Subgroup G, Group.FG H → Finite H := by
  refine ⟨fun hG H hH ↦ ?_, fun h ↦ ⟨fun s hs ↦ ?_⟩⟩
  · obtain ⟨s, hs, hfin⟩ := (Subgroup.fg_iff H).1 ((Group.fg_iff_subgroup_fg H).1 hH)
    exact hs ▸ hG.finite_closure s hfin
  · have := hs.to_subtype
    exact h _ inferInstance

/-- **A commutative group is locally finite exactly when it is a torsion group**: a finitely
generated commutative torsion group is finite. -/
theorem Group.isLocallyFinite_iff_isMulTorsion {G : Type*} [CommGroup G] :
    Group.IsLocallyFinite G ↔ IsMulTorsion G := by
  refine ⟨fun _ ↦ IsLocallyFinite.isMulTorsion, fun hG ↦ ⟨fun s hs ↦ ?_⟩⟩
  have := hs.to_subtype
  exact CommGroup.finite_of_fg_isMulTorsion _ (hG.subgroup _)

/-- An additive commutative group, viewed as a multiplicative group, is locally finite exactly
when it is a torsion group. This is the form in which the condition applies to the classifying
space `B(Multiplicative A)` of an abelian group `A`, an Eilenberg--MacLane space `K(A, 1)`. -/
theorem Group.isLocallyFinite_multiplicative_iff {A : Type*} [AddCommGroup A] :
    Group.IsLocallyFinite (Multiplicative A) ↔ IsAddTorsion A :=
  isLocallyFinite_iff_isMulTorsion.trans
    ⟨fun h a ↦ isOfFinOrder_ofAdd_iff.1 (h (Multiplicative.ofAdd a)),
      fun h g ↦ (isOfFinOrder_ofAdd_iff (α := A)).2 (h g.toAdd)⟩

end TauCeti
