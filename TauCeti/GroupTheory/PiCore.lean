module

public import Mathlib.GroupTheory.Sylow
public import Mathlib.Order.SupClosed

/-!
# `π`-groups and the `π`-core of a group

For a set of primes `π`, a group is a **`π`-group** (`TauCeti.IsPiGroup π G`) when every prime
dividing its order lies in `π`. The **`π`-core** `O_π(G)` (`TauCeti.piCore π G`) is the subgroup
generated by the normal `π`-subgroups of `G`. For `π = {p}` the `π`-groups of finite order are the
finite `p`-groups, and for finite `G` the core `O_{p}(G)` is the intersection of the Sylow
`p`-subgroups; for `π = {p}ᶜ` the `π`-groups are the groups of order prime to `p`, and for finite
`G` the core `O_{p'}(G) = piCore {p}ᶜ G` is the largest normal subgroup of order prime to `p`.
These cores are the basic carriers of local group theory, for instance in the upper `p`-series,
the Fitting subgroup and the local analysis of the odd order theorem.

## Main results

* `TauCeti.IsPiGroup.of_natCard_dvd_mul`: a group whose order divides the product of the orders
  of two `π`-groups is a `π`-group; in particular `π`-groups are closed under extensions
  (`TauCeti.IsPiGroup.of_subgroup_of_quotient`) and under joins with a normal `π`-subgroup
  (`TauCeti.IsPiGroup.to_sup_of_normal_right`).
* `TauCeti.isPiGroup_singleton_iff`: a finite group is a `{p}`-group iff it is a `p`-group.
* `TauCeti.isPiGroup_compl_singleton_iff`: a group is a `{p}ᶜ`-group iff `p` does not divide its
  order.
* `TauCeti.piCore_characteristic`: the `π`-core is characteristic, in particular normal.
* `TauCeti.isPiGroup_piCore`, `TauCeti.le_piCore_iff`: for finite `G` the `π`-core is a normal
  `π`-subgroup containing every normal `π`-subgroup.
* `TauCeti.piCore_eq_top_iff`: for finite `G`, `O_π(G) = G` iff `G` is a `π`-group.
* `TauCeti.piCore_quotient_piCore_eq_bot`: for finite `G`, `O_π(G ⧸ O_π(G)) = 1`.
* `TauCeti.map_subtype_piCore`: for finite `G` and `N ⊴ G`, `O_π(N) = O_π(G) ⊓ N`.
* `TauCeti.map_piCore_le`, `TauCeti.map_piCore_of_isPiGroup_ker`: a surjective homomorphism maps
  `O_π(G)` into the `π`-core of the target, onto it when its kernel is a `π`-group.
* `TauCeti.map_piCore_mulEquiv`: isomorphisms carry `π`-cores onto `π`-cores.
* `TauCeti.Sylow.normal_iInf`: the intersection of the Sylow `p`-subgroups is normal.
* `TauCeti.piCore_singleton_eq_iInf_sylow`: for finite `G`, `O_p(G)` is the intersection of the
  Sylow `p`-subgroups of `G`.

## References

* H. Bender and G. Glauberman, *Local Analysis for the Odd Order Theorem*, Chapter I, §1 (the
  notation `O_π` preceding Lemma 1.1).
* The `pcore` library of the Mathematical Components odd order formalization
  (G. Gonthier et al., *A Machine-Checked Proof of the Odd Order Theorem*, ITP 2013).
-/

public section

namespace TauCeti

variable {π π' : Set ℕ} {G H K : Type*}

/-- A group `G` is a **`π`-group** for a set of natural numbers `π` when every prime dividing
`Nat.card G` lies in `π`. For a finite group this is the usual notion: its order is a
`π`-number. (An infinite group has `Nat.card G = 0`, so it is a `π`-group only when `π`
contains every prime.) The predicate only involves the cardinality, so it is stated for an
arbitrary type. -/
def IsPiGroup (π : Set ℕ) (G : Type*) : Prop :=
  ∀ p, p.Prime → p ∣ Nat.card G → p ∈ π

/-- Unfolding lemma for `TauCeti.IsPiGroup`. -/
theorem isPiGroup_iff : IsPiGroup π G ↔ ∀ p, p.Prime → p ∣ Nat.card G → p ∈ π := .rfl

/-- A group is a `{p}ᶜ`-group iff the prime `p` does not divide its order. -/
theorem isPiGroup_compl_singleton_iff {p : ℕ} (hp : p.Prime) :
    IsPiGroup {p}ᶜ G ↔ ¬ p ∣ Nat.card G :=
  ⟨fun h hpG ↦ h p hp hpG rfl, fun h _ _ hqG hq ↦ h (hq ▸ hqG)⟩

namespace IsPiGroup

/-- A group whose order divides the order of a `π`-group is a `π`-group. -/
theorem of_natCard_dvd (hG : IsPiGroup π G) (h : Nat.card H ∣ Nat.card G) : IsPiGroup π H :=
  fun p hp hpH ↦ hG p hp (hpH.trans h)

/-- A group whose order divides the product of the orders of two `π`-groups is a `π`-group. -/
theorem of_natCard_dvd_mul (hG : IsPiGroup π G) (hH : IsPiGroup π H)
    (h : Nat.card K ∣ Nat.card G * Nat.card H) : IsPiGroup π K := fun p hp hpK ↦
  ((Nat.Prime.dvd_mul hp).mp (hpK.trans h)).elim (hG p hp) (hH p hp)

/-- A `π`-group is a `π'`-group for every `π' ⊇ π`. -/
theorem mono (hG : IsPiGroup π G) (hππ' : π ⊆ π') : IsPiGroup π' G :=
  fun p hp hpG ↦ hππ' (hG p hp hpG)

/-- A trivial group is a `π`-group for every `π`. -/
theorem of_subsingleton [Nonempty G] [Subsingleton G] : IsPiGroup π G := fun _ hp hpG ↦
  (hp.ne_one (Nat.eq_one_of_dvd_one (Nat.card_eq_one_iff_unique.mpr ⟨‹_›, ‹_›⟩ ▸ hpG))).elim

variable [Group G] [Group H]

/-- The trivial subgroup is a `π`-group for every `π`. -/
theorem of_bot : IsPiGroup π (⊥ : Subgroup G) := of_subsingleton

/-- A group embedding into a `π`-group is a `π`-group. -/
theorem of_injective (hH : IsPiGroup π H) (f : G →* H) (hf : Function.Injective f) :
    IsPiGroup π G :=
  hH.of_natCard_dvd (Subgroup.card_dvd_of_injective f hf)

/-- A homomorphic image of a `π`-group is a `π`-group. -/
theorem of_surjective (hG : IsPiGroup π G) (f : G →* H) (hf : Function.Surjective f) :
    IsPiGroup π H :=
  hG.of_natCard_dvd (Subgroup.card_dvd_of_surjective hf)

/-- A group isomorphic to a `π`-group is a `π`-group. -/
theorem of_equiv (hG : IsPiGroup π G) (e : G ≃* H) : IsPiGroup π H :=
  hG.of_natCard_dvd (Nat.card_congr e.toEquiv).symm.dvd

/-- Being a `π`-group is invariant under isomorphism. -/
theorem _root_.MulEquiv.isPiGroup_iff (e : G ≃* H) : IsPiGroup π G ↔ IsPiGroup π H :=
  ⟨fun h ↦ h.of_equiv e, fun h ↦ h.of_equiv e.symm⟩

/-- A subgroup of a `π`-subgroup is a `π`-subgroup. -/
theorem to_le {A B : Subgroup G} (hB : IsPiGroup π B) (hAB : A ≤ B) : IsPiGroup π A :=
  hB.of_natCard_dvd (Subgroup.card_dvd_of_le hAB)

/-- Every subgroup of a `π`-group is a `π`-group. -/
theorem to_subgroup (hG : IsPiGroup π G) (A : Subgroup G) : IsPiGroup π A :=
  hG.of_natCard_dvd A.card_subgroup_dvd_card

/-- Every quotient of a `π`-group by a subgroup, as a coset space, has `π`-number order; in
particular every quotient group of a `π`-group is a `π`-group. -/
theorem to_quotient (hG : IsPiGroup π G) (N : Subgroup G) : IsPiGroup π (G ⧸ N) :=
  hG.of_natCard_dvd N.card_quotient_dvd_card

/-- The image of a `π`-subgroup under a homomorphism is a `π`-group. -/
theorem map {A : Subgroup G} (hA : IsPiGroup π A) (f : G →* H) : IsPiGroup π (A.map f) :=
  hA.of_natCard_dvd (A.card_map_dvd f)

/-- A group with a `π`-group as kernel and a `π`-group as image of some homomorphism is a
`π`-group. -/
theorem of_ker_of_range (f : G →* H) (hker : IsPiGroup π f.ker) (hrange : IsPiGroup π f.range) :
    IsPiGroup π G :=
  hker.of_natCard_dvd_mul hrange (Subgroup.card_ker_mul_card_range f).symm.dvd

/-- A group with a `π`-subgroup `N` whose coset space `G ⧸ N` has `π`-number order is a
`π`-group; in particular an extension of a `π`-group by a `π`-group is a `π`-group. -/
theorem of_subgroup_of_quotient (N : Subgroup G) (hN : IsPiGroup π N)
    (hG : IsPiGroup π (G ⧸ N)) : IsPiGroup π G :=
  hG.of_natCard_dvd_mul hN (Subgroup.card_eq_card_quotient_mul_card_subgroup N).dvd

/-- The preimage of a `π`-subgroup under a homomorphism whose kernel is a `π`-group is a
`π`-group. -/
theorem comap_of_ker_isPiGroup (B : Subgroup H) (hB : IsPiGroup π B) (f : G →* H)
    (hf : IsPiGroup π f.ker) : IsPiGroup π (B.comap f) := by
  refine of_ker_of_range (f.domRestrict (B.comap f)) ?_ ?_
  · rw [MonoidHom.ker_domRestrict]
    exact hf.of_equiv (Subgroup.subgroupOfEquivOfLe (Subgroup.ker_le_comap f B)).symm
  · rw [MonoidHom.domRestrict_range]
    exact hB.to_le (Subgroup.map_comap_le f B)

/-- The join of a `π`-subgroup with a normal `π`-subgroup is a `π`-subgroup. The proof is adapted
from Mathlib's `IsPGroup.to_sup_of_normal_right`. -/
theorem to_sup_of_normal_right {A B : Subgroup G} (hA : IsPiGroup π A) (hB : IsPiGroup π B)
    [B.Normal] : IsPiGroup π (A ⊔ B : Subgroup G) := by
  rw [← QuotientGroup.ker_mk' B, ← Subgroup.comap_map_eq]
  exact (hA.map _).comap_of_ker_isPiGroup _ _ (by rwa [QuotientGroup.ker_mk'])

/-- The join of a normal `π`-subgroup with a `π`-subgroup is a `π`-subgroup. The statement and
proof are adapted from Mathlib's `IsPGroup.to_sup_of_normal_left`. -/
theorem to_sup_of_normal_left {A B : Subgroup G} (hA : IsPiGroup π A) (hB : IsPiGroup π B)
    [A.Normal] : IsPiGroup π (A ⊔ B : Subgroup G) :=
  sup_comm B A ▸ hB.to_sup_of_normal_right hA

end IsPiGroup

variable [Group G] [Group H]

/-- The top subgroup is a `π`-group iff the group is. -/
theorem isPiGroup_top_iff : IsPiGroup π (⊤ : Subgroup G) ↔ IsPiGroup π G :=
  Subgroup.topEquiv.isPiGroup_iff

/-- A finite group is a `{p}`-group iff it is a `p`-group. -/
theorem isPiGroup_singleton_iff [Finite G] {p : ℕ} (hp : p.Prime) :
    IsPiGroup {p} G ↔ IsPGroup p G := by
  rw [isPGroup_iff_primeFactors_card_subset hp.ne_zero, hp.primeFactors]
  refine ⟨fun h q hq ↦ ?_, fun h q hq hqG ↦ ?_⟩
  · rw [Nat.mem_primeFactors] at hq
    exact Finset.mem_singleton.mpr (h q hq.1 hq.2.1)
  · exact Finset.mem_singleton.mp (h (Nat.mem_primeFactors.mpr ⟨hq, hqG, Nat.card_pos.ne'⟩))

/-! ### The `π`-core -/

variable (π G) in
/-- The **`π`-core** `O_π(G)` of a group `G`: the subgroup generated by the normal `π`-subgroups
of `G`. For finite `G` it is the largest normal `π`-subgroup (`TauCeti.isPiGroup_piCore`,
`TauCeti.le_piCore_iff`). -/
def piCore : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ IsPiGroup π N}

/-- Every normal `π`-subgroup lies in the `π`-core. -/
theorem le_piCore {N : Subgroup G} [N.Normal] (hN : IsPiGroup π N) : N ≤ piCore π G :=
  le_sSup ⟨inferInstance, hN⟩

/-- A surjective homomorphism maps the `π`-core into the `π`-core of its target. -/
theorem map_piCore_le (f : G →* H) (hf : Function.Surjective f) :
    (piCore π G).map f ≤ piCore π H := by
  refine Subgroup.map_le_iff_le_comap.mpr (sSup_le fun N ⟨hNn, hN⟩ ↦ ?_)
  have := hNn.map f hf
  exact Subgroup.map_le_iff_le_comap.mp (le_piCore (hN.map f))

/-- The `π`-core is preserved by every automorphism. -/
instance piCore_characteristic : (piCore π G).Characteristic :=
  Subgroup.characteristic_iff_map_le.mpr fun e ↦ map_piCore_le (e : G →* G) e.surjective

/-- The `π`-core is monotone in `π`. -/
theorem piCore_mono (hππ' : π ⊆ π') : piCore π G ≤ piCore π' G :=
  sSup_le_sSup fun _ ⟨hNn, hN⟩ ↦ ⟨hNn, hN.mono hππ'⟩

/-- A surjective homomorphism whose kernel is a `π`-group maps the `π`-core onto the `π`-core of
its target. -/
theorem map_piCore_of_isPiGroup_ker (f : G →* H) (hf : Function.Surjective f)
    (hker : IsPiGroup π f.ker) : (piCore π G).map f = piCore π H := by
  refine le_antisymm (map_piCore_le f hf) (sSup_le fun M ⟨hMn, hM⟩ ↦ ?_)
  have := hMn.comap f
  rw [← Subgroup.map_comap_eq_self_of_surjective hf M]
  exact Subgroup.map_mono (le_piCore (hM.comap_of_ker_isPiGroup _ f hker))

/-- An isomorphism maps the `π`-core onto the `π`-core. -/
@[simp]
theorem map_piCore_mulEquiv (e : G ≃* H) : (piCore π G).map (e : G →* H) = piCore π H :=
  map_piCore_of_isPiGroup_ker _ e.surjective <| by
    rw [MonoidHom.ker_eq_bot_iff _ |>.mpr e.injective]
    exact .of_bot

/-- The intersection of the Sylow `p`-subgroups of a group is normal. -/
instance Sylow.normal_iInf {p : ℕ} : (⨅ P : Sylow p G, (P : Subgroup G)).Normal :=
  ⟨fun n hn g ↦ Subgroup.mem_iInf.mpr fun P ↦ by
    simpa [Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem, MulAut.smul_def]
      using Subgroup.mem_iInf.mp hn (g⁻¹ • P)⟩

section Finite

variable [Finite G]

variable (π G) in
/-- The `π`-core of a finite group is a `π`-group. -/
theorem isPiGroup_piCore : IsPiGroup π (piCore π G) := by
  have hsup : SupClosed {N : Subgroup G | N.Normal ∧ IsPiGroup π N} := by
    rintro A ⟨hAn, hA⟩ B ⟨hBn, hB⟩
    exact ⟨Subgroup.sup_normal A B, hA.to_sup_of_normal_left hB⟩
  exact (hsup.sSup_mem (Set.toFinite _) ⟨Subgroup.normal_bot, .of_bot⟩ subset_rfl).2

/-- In a finite group, a normal subgroup lies in the `π`-core iff it is a `π`-group. -/
theorem le_piCore_iff {N : Subgroup G} [N.Normal] : N ≤ piCore π G ↔ IsPiGroup π N :=
  ⟨fun h ↦ (isPiGroup_piCore π G).to_le h, le_piCore⟩

/-- A finite group is its own `π`-core iff it is a `π`-group. -/
theorem piCore_eq_top_iff : piCore π G = ⊤ ↔ IsPiGroup π G := by
  rw [eq_top_iff, le_piCore_iff, isPiGroup_top_iff]

/-- The `π`-core of the quotient of a finite group by its `π`-core is trivial. -/
@[simp]
theorem piCore_quotient_piCore_eq_bot : piCore π (G ⧸ piCore π G) = ⊥ := by
  have hle : (piCore π (G ⧸ piCore π G)).comap (QuotientGroup.mk' _) ≤ piCore π G :=
    le_piCore ((isPiGroup_piCore _ _).comap_of_ker_isPiGroup _ _ <| by
      rw [QuotientGroup.ker_mk']
      exact isPiGroup_piCore π G)
  refine eq_bot_iff.mpr fun x hx ↦ ?_
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (piCore π G) x
  exact (QuotientGroup.eq_one_iff g).mpr (hle hx)

/-- For a normal subgroup `N` of a finite group, `O_π(N) = O_π(G) ⊓ N`. -/
theorem map_subtype_piCore (N : Subgroup G) [N.Normal] :
    (piCore π N).map N.subtype = piCore π G ⊓ N := by
  refine le_antisymm (le_inf (le_piCore ?_) (Subgroup.map_subtype_le _)) ?_
  · exact (isPiGroup_piCore π N).of_equiv (Subgroup.equivMapOfInjective _ _ N.subtype_injective)
  · rw [← Subgroup.map_subgroupOf_eq_of_le (inf_le_right : piCore π G ⊓ N ≤ N)]
    have : ((piCore π G ⊓ N).subgroupOf N).Normal := Subgroup.Normal.subgroupOf inferInstance N
    exact Subgroup.map_mono (le_piCore (((isPiGroup_piCore π G).to_le inf_le_left).of_equiv
      (Subgroup.subgroupOfEquivOfLe inf_le_right).symm))

/-- In a finite group, a normal subgroup lies in `O_{p'}(G)` iff its order is prime to `p`. -/
theorem le_piCore_compl_singleton_iff {p : ℕ} (hp : p.Prime) {N : Subgroup G} [N.Normal] :
    N ≤ piCore {p}ᶜ G ↔ ¬ p ∣ Nat.card N := by
  rw [le_piCore_iff, isPiGroup_compl_singleton_iff hp]

/-- `O_p(G)` is the intersection of the Sylow `p`-subgroups of `G`. -/
theorem piCore_singleton_eq_iInf_sylow (p : ℕ) [Fact p.Prime] :
    piCore {p} G = ⨅ P : Sylow p G, (P : Subgroup G) := by
  have hp := Fact.out (p := p.Prime)
  refine le_antisymm (le_iInf fun P ↦
    ((isPiGroup_singleton_iff hp).mp (isPiGroup_piCore _ G)).le_sylow_of_normal P) ?_
  exact le_piCore ((isPiGroup_singleton_iff hp).mpr
    ((Classical.arbitrary (Sylow p G)).isPGroup.to_le (iInf_le _ _)))

end Finite

end TauCeti
