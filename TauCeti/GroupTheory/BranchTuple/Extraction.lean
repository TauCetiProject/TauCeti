import Mathlib.Data.Fintype.Fin

/-!
# Extracting an element of a single conjugacy class

Let `G` be a finite group and `g ∈ G` of order `d`. If more than `d · |C|` entries of a generating
branch tuple `t` lie in the conjugacy class `C` of `g`, then `t` is braid equivalent to a tuple
`(g, g₂, …, g_n)` whose tail `(g₂, …, g_n)` still generates `G`. In particular, every generating
tuple in `C^n` with `n ≥ d · |C| + 1` can be braided to start with any prescribed element of `C`,
keeping a generating tail. This is the extraction step of Ellenberg–Venkatesh–Westerland's
Proposition 3.4, and it feeds the stable classification of generating braid orbits by the lifting
invariant. The ordered product is unchanged, since the Hurwitz action preserves it; the tuple need
not have product one. Some hypothesis on the classes is essential: braid moves do not change the
class multiplicities, so no element of a class absent from `t` can be extracted.

## Main results

* `TauCeti.BraidOrbitMonoid.exists_ofTuple_eq_pow_mul`: the occurrences of an element `a` can be
  moved to the front, so an element with at least `k` entries equal to `a` is `[a]^k y`.
* `TauCeti.BraidOrbitMonoid.conj_mul_eq_mul_of_mem_generated`: a block `x` of product one
  placed in front of `y` may be conjugated by any element of the subgroup generated by `y`.
* `TauCeti.BraidOrbitMonoid.of_pow_succ_mul_eq_of_mul`: if `a ^ d = 1` with `d ≠ 0`, then
  `[a]^(d + 1) y` starts with any conjugate of `a` by an element of the subgroup generated by
  `[a] y`.
* `TauCeti.BranchTuple.exists_hurwitzAction_eq_cons`: the extraction of `g` from a generating
  tuple with more than `d · |C|` entries in the class `C` of `g`.
* `TauCeti.BranchTuple.exists_hurwitzAction_eq_cons_of_forall_isConj`: the single-class case.

## Implementation notes

The proof takes place in the braid-orbit monoid `TauCeti.BraidOrbitMonoid Set.univ`. By the
pigeonhole principle some `x ∈ C` occurs at least `d + 1` times, so the tuple represents
`[x]^d [x] y`. The block `[x]^d` has product one and `[x] y` still generates `G`, so the block can
be conjugated to `[g]^d`, which exhibits `[g]` as the first entry; the remaining entries contain
`[x] y` and hence generate `G`.

## References

* J. S. Ellenberg, A. Venkatesh, C. Westerland, *Homological stability for Hurwitz spaces and the
  Cohen-Lenstra conjecture over function fields*, Ann. of Math. 183 (2016), Proposition 3.4 and
  its proof.
-/

public section

namespace TauCeti

open BranchTuple BraidGroup Finset

variable {G : Type*} [Group G]

namespace BraidOrbitMonoid

variable {c : Set G} (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c)
include hc

/-- **Absorbing conjugation into a product-one block.** For a conjugation-invariant `c`, a block
`x` of product one placed in front of an element `y` may be conjugated by any element of the
subgroup generated by the entries of `y` without changing `x * y`. -/
theorem conj_mul_eq_mul_of_mem_generated {x : BraidOrbitMonoid c} (hx : product x = 1)
    {y : BraidOrbitMonoid c} {g : G} (hg : g ∈ generated y) : conj hc g x * y = x * y := by
  -- For each `y`, the elements whose conjugation every product-one block in front of `y` absorbs
  -- form a subgroup `S y`.
  let S (y : BraidOrbitMonoid c) : Subgroup G :=
    { carrier := {g | ∀ x : BraidOrbitMonoid c, product x = 1 → conj hc g x * y = x * y}
      mul_mem' := fun {g h} hg hh x hx ↦ by
        rw [← conj_conj, hg _ (by simp [hx]), hh x hx]
      one_mem' := fun x _ ↦ by simp
      inv_mem' := fun {g} hg x hx ↦ by
        have := hg (conj hc g⁻¹ x) (by simp [hx])
        rwa [conj_conj, mul_inv_cancel, conj_one, MonoidHom.id_apply, eq_comm] at this }
  suffices ∀ y, generated y ≤ S y from this y hg x hx
  intro y
  induction y using PresentedMonoid.induction_on_of with
  | of a =>
    -- Moving the block across `[a]` conjugates it by `a`.
    rw [generated_of, Subgroup.closure_le, Set.singleton_subset_iff]
    intro x hx
    rw [(commute_of_product_eq_one hc hx _).eq, mul_eq_conj_mul hc (PresentedMonoid.of _ a) x,
      product_of]
  | one => simp
  | mul y z hy hz =>
    rw [generated_mul, sup_le_iff]
    refine ⟨fun g hg x hx ↦ ?_, fun g hg x hx ↦ ?_⟩
    · rw [← mul_assoc, hy hg x hx, mul_assoc]
    · have hx' : product (conj hc g x) = 1 := by simp [hx]
      rw [← mul_assoc, (commute_of_product_eq_one hc hx' y).eq, mul_assoc, hz hg x hx,
        ← mul_assoc, ← (commute_of_product_eq_one hc hx y).eq, mul_assoc]

/-- The occurrences of `a` in a word can be moved to the front. -/
private theorem exists_prod_map_of_eq_pow_mul [DecidableEq c] (a : c) :
    ∀ (l : List c) {k : ℕ}, k ≤ l.count a →
      ∃ y, (l.map (PresentedMonoid.of (HurwitzRel c))).prod =
        PresentedMonoid.of (HurwitzRel c) a ^ k * y
  | [], k, hk => ⟨1, by simp_all⟩
  | b :: l, k, hk => by
    by_cases hb : b = a
    · subst hb
      rcases k with _ | k
      · exact ⟨_, (one_mul _).symm⟩
      · obtain ⟨y, hy⟩ := exists_prod_map_of_eq_pow_mul b l (k := k) (by simpa using hk)
        exact ⟨y, by rw [List.map_cons, List.prod_cons, hy, pow_succ', mul_assoc]⟩
    · obtain ⟨y, hy⟩ := exists_prod_map_of_eq_pow_mul a l (k := k)
        (by simpa [List.count_cons, hb] using hk)
      -- Move `[b]` to the right across the block `[a]^k`.
      exact ⟨_, by rw [List.map_cons, List.prod_cons, hy, ← mul_assoc,
        mul_eq_mul_conj hc (PresentedMonoid.of (HurwitzRel c) a ^ k), mul_assoc]⟩

/-- **Moving occurrences to the front.** For a conjugation-invariant `c`, if at least `k` entries
of a `c`-valued tuple `t` are equal to `a`, the element represented by `t` is `[a]^k y` for some
`y`. The entries `a` are moved to the front unchanged; the entries they pass are conjugated. -/
theorem exists_ofTuple_eq_pow_mul [DecidableEq c] {r : ℕ} (t : Fin r → c) (a : c) {k : ℕ}
    (hk : k ≤ #{i | t i = a}) :
    ∃ y, ofTuple t = PresentedMonoid.of (HurwitzRel c) a ^ k * y := by
  rw [ofTuple_def, show (List.ofFn fun i ↦ PresentedMonoid.of (HurwitzRel c) (t i)) =
      (List.ofFn t).map (PresentedMonoid.of (HurwitzRel c)) by
    simp [List.map_ofFn, Function.comp_def]]
  exact exists_prod_map_of_eq_pow_mul hc a _ (by rwa [List.count_ofFn])

/-- **Extracting a conjugate from a full order block.** For a conjugation-invariant `c`, let `a ∈ c`
satisfy `a ^ d = 1` with `d ≠ 0`. Then `[a]^(d + 1) y` can be rewritten to start with the conjugate
`b = h a h⁻¹` of `a` by any element `h` of the subgroup generated by the entries of `[a] y`:
`[a]^(d + 1) y = [b] ([b]^(d - 1) [a] y)`. -/
theorem of_pow_succ_mul_eq_of_mul {a b : c} {d : ℕ} (hd : (a : G) ^ d = 1) (hd₀ : d ≠ 0)
    {y : BraidOrbitMonoid c} {h : G} (hh : h ∈ generated (PresentedMonoid.of (HurwitzRel c) a * y))
    (hb : h * a * h⁻¹ = b) :
    PresentedMonoid.of (HurwitzRel c) a ^ (d + 1) * y =
      PresentedMonoid.of (HurwitzRel c) b *
        (PresentedMonoid.of (HurwitzRel c) b ^ (d - 1) *
          (PresentedMonoid.of (HurwitzRel c) a * y)) := by
  -- The block `[a]^d` has product one, so conjugating it by `h` turns it into `[b]^d`.
  have hconj := conj_mul_eq_mul_of_mem_generated hc (x := PresentedMonoid.of _ a ^ d)
    (by simp [hd]) hh
  rw [map_pow, conj_of, show (⟨h * a * h⁻¹, _⟩ : c) = b from Subtype.ext hb] at hconj
  rw [pow_succ, mul_assoc, ← hconj, ← mul_assoc (PresentedMonoid.of _ b), ← pow_succ',
    Nat.sub_add_cancel (Nat.pos_of_ne_zero hd₀)]

end BraidOrbitMonoid

namespace BranchTuple

open BraidOrbitMonoid

/-- **Extracting an element of a conjugacy class.** Let `G` be finite, let `g ∈ G`, and let `t` be
a generating branch tuple more than `orderOf g * |C|` of whose entries lie in the conjugacy class
`C` of `g`. Then `t` is braid equivalent to a tuple `(g, s₁, …, sₙ)` whose tail `s` still generates
`G`. -/
theorem exists_hurwitzAction_eq_cons [Finite G] [DecidableEq (ConjClasses G)] {n : ℕ}
    (t : BranchTuple (n + 1) G) (g : G) (hgen : generated t = ⊤)
    (hcount : orderOf g * Nat.card (ConjClasses.mk g).carrier <
      (classMultiset t).count (ConjClasses.mk g)) :
    ∃ (b : BraidGroup (n + 1)) (s : BranchTuple n G),
      hurwitzAction b t = Fin.cons g s ∧ generated s = ⊤ := by
  classical
  have : Fintype G := Fintype.ofFinite G
  -- By the pigeonhole principle some `x` in the class of `g` occurs more than `orderOf g` times.
  obtain ⟨x, hxC, hx⟩ : ∃ x ∈ (ConjClasses.mk g).carrier.toFinset,
      orderOf g < #{i ∈ {i | ConjClasses.mk (t i) = ConjClasses.mk g} | t i = x} := by
    refine exists_lt_card_fiber_of_mul_lt_card_of_maps_to (fun i hi ↦ ?_) ?_
    · simpa [ConjClasses.mem_carrier_iff_mk_eq] using hi
    · rwa [Set.toFinset_card, ← Nat.card_eq_fintype_card, mul_comm, ← count_classMultiset]
  have hxg : ConjClasses.mk x = ConjClasses.mk g := by
    simpa [ConjClasses.mem_carrier_iff_mk_eq] using hxC
  obtain ⟨h, hxg⟩ := isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hxg)
  have hd : orderOf x = orderOf g := by
    rw [← MulEquiv.orderOf_eq (MulAut.conj h) x, MulAut.conj_apply, hxg]
  -- Work in the braid-orbit monoid of `G` itself.
  have hc : ∀ g : G, ∀ x ∈ (Set.univ : Set G), g * x * g⁻¹ ∈ Set.univ := fun _ _ _ ↦ trivial
  let o : G → BraidOrbitMonoid (Set.univ : Set G) := fun a ↦ PresentedMonoid.of _ ⟨a, trivial⟩
  let t' : Fin (n + 1) → (Set.univ : Set G) := fun i ↦ ⟨t i, trivial⟩
  obtain ⟨y, hy⟩ : ∃ y, ofTuple t' = o x ^ (orderOf g + 1) * y :=
    exists_ofTuple_eq_pow_mul hc t' ⟨x, trivial⟩ (hx.trans_le (card_le_card fun i hi ↦ by
      simp_all [t']))
  -- `[x] y` still generates `G`, so the block `[x]^orderOf g` can be conjugated to `[g]^orderOf g`.
  have hR : BraidOrbitMonoid.generated (o x * y) = ⊤ := by
    rw [generated_mul, ← generated_pow (o x) (orderOf g).succ_ne_zero, ← generated_mul, ← hy,
      generated_ofTuple]
    exact hgen
  have hT : ofTuple t' = o g * (o g ^ (orderOf g - 1) * (o x * y)) := by
    rw [hy]
    exact of_pow_succ_mul_eq_of_mul hc (by simp [← hd, pow_orderOf_eq_one])
      (orderOf_pos g).ne' (hR ▸ Subgroup.mem_top h) (b := ⟨g, trivial⟩) hxg
  obtain ⟨r, s', hs'⟩ := exists_ofTuple_eq (o g ^ (orderOf g - 1) * (o x * y))
  obtain rfl : r = n := by
    have := congrArg length hT
    rw [← hs', length_mul, length_of, length_ofTuple, length_ofTuple] at this
    omega
  have hcons : ofTuple t' = ofTuple (Fin.cons (⟨g, trivial⟩ : (Set.univ : Set G)) s') := by
    rw [ofTuple_cons, hs', hT]
  obtain ⟨b, hb⟩ := (ofTuple_eq_ofTuple_iff hc).mp hcons
  refine ⟨b, fun i ↦ s' i, hb.trans ?_, ?_⟩
  · funext k
    cases k using Fin.cases <;> simp
  · rw [← generated_ofTuple, hs', generated_mul, hR, sup_top_eq]

/-- **Extracting an element of a single class.** Let `G` be finite, let `g ∈ G` have order `d`, and
let `C` be its conjugacy class. Every generating tuple of length at least `d · |C| + 1` with
entries in `C` is braid equivalent to a tuple `(g, s₁, …, sₙ)` whose tail `s` still generates `G`.
-/
theorem exists_hurwitzAction_eq_cons_of_forall_isConj [Finite G] {n : ℕ}
    (t : BranchTuple (n + 1) G) {g : G} (ht : ∀ i, IsConj g (t i)) (hgen : generated t = ⊤)
    (hn : orderOf g * Nat.card (ConjClasses.mk g).carrier ≤ n) :
    ∃ (b : BraidGroup (n + 1)) (s : BranchTuple n G),
      hurwitzAction b t = Fin.cons g s ∧ generated s = ⊤ := by
  classical
  refine exists_hurwitzAction_eq_cons t g hgen ?_
  rw [count_classMultiset, filter_true_of_mem fun i _ ↦ (ConjClasses.mk_eq_mk_iff_isConj.mpr
    (ht i).symm), card_univ, Fintype.card_fin]
  omega

end BranchTuple

end TauCeti
