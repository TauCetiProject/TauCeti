/-!
# Branch tuples and Nielsen classes

A finite cover of the projective line branched over `r` points, with monodromy group `G`, is
described by `r` elements of `G`: the images of loops around the branch points. This file sets up
the group theory of such tuples, independently of the covers they describe.

A *branch tuple* of length `r` in `G` is a function `Fin r → G`. Its ordered product
`g₀ g₁ ⋯ g_{r-1}`, the subgroup its entries generate and the multiset of conjugacy classes of its
entries are separate invariants: a tuple of product one (a sphere tuple) need not generate `G`,
and a generating tuple need not have product one.

Nielsen classes divide branch tuples by applying one automorphism of `G` to all entries at once.
`TauCeti.NielsenClass A r` does this for an arbitrary subgroup `A` of `MulAut G`, and two cases
are singled out:

* the *inner* Nielsen classes `TauCeti.InnerNielsenClass r G`, for the inner automorphisms, that
  is simultaneous conjugation;
* the *absolute* Nielsen classes `TauCeti.AbsoluteNielsenClass e r`, for a faithful permutation
  representation given as an isomorphism `e : G ≃* P` onto a subgroup `P` of a group `S` (usually
  `S = Equiv.Perm (Fin d)`): the automorphisms of `G` that `e` turns into conjugation by an element
  of the normaliser of `P` in `S`.

The ordered product and the generated subgroup change under an automorphism `φ` by `φ` itself, so
the conditions *product one* and *generation* are invariants of every Nielsen class; the conjugacy
classes of the entries are invariants of inner Nielsen classes.

## Main definitions

* `TauCeti.BranchTuple r G`: branch tuples of length `r` in `G`.
* `TauCeti.BranchTuple.product`: the ordered product of the entries.
* `TauCeti.BranchTuple.generated`: the subgroup generated by the entries.
* `TauCeti.BranchTuple.classMultiset`: the multiset of conjugacy classes of the entries.
* `TauCeti.NielsenClass A r`: branch tuples modulo a subgroup `A` of `MulAut G`.
* `TauCeti.InnerNielsenClass r G`: branch tuples modulo simultaneous conjugation.
* `TauCeti.AbsoluteNielsenClass e r`: branch tuples modulo the normaliser of a faithful
  permutation representation `e`.

## Main results

* `TauCeti.BranchTuple.product_append` and `TauCeti.BranchTuple.generated_append`:
  concatenation multiplies the ordered products and joins the generated subgroups.
* `TauCeti.NielsenClass.mk_eq_mk_iff`, `TauCeti.InnerNielsenClass.mk_eq_mk_iff` and
  `TauCeti.AbsoluteNielsenClass.mk_eq_mk_iff`: when two tuples have the same class.
* `TauCeti.NielsenClass.product_eq_one_iff_of_mk_eq_mk` and
  `TauCeti.NielsenClass.generated_eq_top_iff_of_mk_eq_mk`: product one and generation are
  invariants of Nielsen classes.
* `TauCeti.InnerNielsenClass.classMultiset_eq_of_mk_eq_mk`: class multiplicities are invariants of
  inner Nielsen classes.
* `TauCeti.InnerNielsenClass.mk_injective`: in an abelian group inner Nielsen classes are just
  tuples.
* `TauCeti.AbsoluteNielsenClass.mk_eq_mk_of_inner`: inner equivalence implies absolute
  equivalence.

## References

* J. S. Ellenberg, A. Venkatesh, C. Westerland, *Homological stability for Hurwitz spaces and the
  Cohen-Lenstra conjecture over function fields*, Ann. of Math. 183 (2016), §§2.1–2.3.
* M. M. Wood, *An algebraic lifting invariant of Ellenberg, Venkatesh, and Westerland*, Res.
  Math. Sci. 8 (2021), §3.
* H. Völklein, *Groups as Galois groups*, Cambridge Stud. Adv. Math. 53 (1996), Chapter 9.
-/

public section

namespace TauCeti

/-- A branch tuple of length `r` in a group `G`: an `r`-tuple `(g₀, …, g_{r-1})` of elements of
`G`, read as the local monodromies of a cover around `r` ordered branch points. -/
abbrev BranchTuple (r : ℕ) (G : Type*) : Type _ := Fin r → G

namespace BranchTuple

variable {G H : Type*} [Group G] [Group H] {r : ℕ}

/-! ### The ordered product -/

/-- The ordered product `t 0 * t 1 * ⋯ * t (r - 1)` of a branch tuple; the empty product is `1`. -/
def product (t : BranchTuple r G) : G := (List.ofFn t).prod

theorem product_def (t : BranchTuple r G) : product t = (List.ofFn t).prod := (rfl)

/-- The empty tuple has product one. -/
@[simp]
theorem product_zero (t : BranchTuple 0 G) : product t = 1 := by
  simp [product_def]

/-- The ordered product of a constant tuple is its entry raised to the tuple length. -/
@[simp]
theorem product_const (g : G) : product (fun _ : Fin r ↦ g) = g ^ r := by
  rw [product_def, List.ofFn_const, List.prod_replicate]

@[simp]
theorem product_cons (g : G) (t : BranchTuple r G) :
    product (Fin.cons g t : BranchTuple (r + 1) G) = g * product t := by
  simp [product_def, List.ofFn_succ]

@[simp]
theorem product_snoc (t : BranchTuple r G) (g : G) :
    product (Fin.snoc t g : BranchTuple (r + 1) G) = product t * g := by
  simp [product_def, -List.ofFn_succ, List.ofFn_succ_last]

/-- A homomorphism applied to every entry maps the ordered product. -/
theorem product_comp (f : G →* H) (t : BranchTuple r G) : product (f ∘ t) = f (product t) := by
  rw [product_def, product_def, ← List.map_ofFn, map_list_prod]

/-- Concatenation multiplies the ordered products in the order of the two blocks. -/
@[simp]
theorem product_append {m n : ℕ} (t : BranchTuple m G) (s : BranchTuple n G) :
    product (Fin.append t s) = product t * product s := by
  simp [product_def]

/-! ### The generated subgroup -/

/-- The subgroup of `G` generated by the entries of a branch tuple. -/
def generated (t : BranchTuple r G) : Subgroup G := Subgroup.closure (Set.range t)

theorem generated_def (t : BranchTuple r G) : generated t = Subgroup.closure (Set.range t) :=
  (rfl)

theorem apply_mem_generated (t : BranchTuple r G) (i : Fin r) : t i ∈ generated t :=
  Subgroup.subset_closure (Set.mem_range_self i)

/-- The generated subgroup is the least subgroup containing every entry. -/
theorem generated_le_iff {t : BranchTuple r G} {K : Subgroup G} :
    generated t ≤ K ↔ ∀ i, t i ∈ K := by
  rw [generated_def, Subgroup.closure_le, Set.range_subset_iff]
  simp only [SetLike.mem_coe]

/-- The empty tuple generates the trivial subgroup. -/
@[simp]
theorem generated_zero (t : BranchTuple 0 G) : generated t = ⊥ :=
  le_bot_iff.mp (generated_le_iff.mpr finZeroElim)

@[simp]
theorem generated_cons (g : G) (t : BranchTuple r G) :
    generated (Fin.cons g t : BranchTuple (r + 1) G) = Subgroup.closure {g} ⊔ generated t := by
  rw [generated_def, generated_def, Fin.range_cons, Set.insert_eq, Subgroup.closure_union]

/-- A homomorphism applied to every entry maps the generated subgroup. -/
theorem generated_comp (f : G →* H) (t : BranchTuple r G) :
    generated (f ∘ t) = (generated t).map f := by
  rw [generated_def, generated_def, MonoidHom.map_closure, Set.range_comp]

/-- The subgroup generated by concatenation is the join of the subgroups of its two blocks. -/
@[simp]
theorem generated_append {m n : ℕ} (t : BranchTuple m G) (s : BranchTuple n G) :
    generated (Fin.append t s) = generated t ⊔ generated s := by
  simp only [generated_def, ← Subgroup.closure_union]
  congr 1
  ext x
  simp only [Set.mem_union, ← List.mem_ofFn', List.ofFn_fin_append, List.mem_append]

/-! ### Class multiplicities -/

/-- The multiset of conjugacy classes of the entries of a branch tuple: the multiplicity of a class
`C` is the number of entries lying in `C`. -/
def classMultiset (t : BranchTuple r G) : Multiset (ConjClasses G) :=
  Finset.univ.val.map fun i ↦ ConjClasses.mk (t i)

theorem classMultiset_def (t : BranchTuple r G) :
    classMultiset t = Finset.univ.val.map fun i ↦ ConjClasses.mk (t i) :=
  (rfl)

@[simp]
theorem mem_classMultiset {t : BranchTuple r G} {C : ConjClasses G} :
    C ∈ classMultiset t ↔ ∃ i, t i ∈ C.carrier := by
  simp [classMultiset_def, ConjClasses.mem_carrier_iff_mk_eq]

/-- The multiplicity of a conjugacy class in `classMultiset t` is the number of entries of `t`
lying in it. -/
theorem count_classMultiset [DecidableEq (ConjClasses G)] (t : BranchTuple r G)
    (C : ConjClasses G) :
    (classMultiset t).count C = (Finset.univ.filter fun i ↦ ConjClasses.mk (t i) = C).card := by
  rw [classMultiset_def, Multiset.count_map, ← Finset.filter_val, Finset.card_val]
  simp_rw [eq_comm]

/-- Two branch tuples whose entries agree up to conjugacy after a permutation of the positions
have the same class multiset. -/
theorem classMultiset_eq_of_isConj {t t' : BranchTuple r G} (σ : Equiv.Perm (Fin r))
    (h : ∀ i, IsConj (t (σ i)) (t' i)) : classMultiset t' = classMultiset t := by
  have hfun : (fun i ↦ ConjClasses.mk (t' i)) = (fun i ↦ ConjClasses.mk (t i)) ∘ σ :=
    funext fun i ↦ (ConjClasses.mk_eq_mk_iff_isConj.mpr (h i)).symm
  rw [classMultiset_def, classMultiset_def, hfun, ← Multiset.map_map,
    Multiset.map_univ_val_equiv]

/-! ### Automorphisms acting on all entries -/

/-- An automorphism acts on a branch tuple by acting on every entry. -/
theorem smul_eq_comp (φ : MulAut G) (t : BranchTuple r G) :
    φ • t = (φ.toMonoidHom : G →* G) ∘ t :=
  (rfl)

@[simp]
theorem product_smul (φ : MulAut G) (t : BranchTuple r G) : product (φ • t) = φ (product t) := by
  rw [smul_eq_comp, product_comp, MulEquiv.coe_toMonoidHom]

theorem generated_smul (φ : MulAut G) (t : BranchTuple r G) :
    generated (φ • t) = (generated t).map φ.toMonoidHom := by
  rw [smul_eq_comp, generated_comp]

theorem product_smul_eq_one_iff (φ : MulAut G) (t : BranchTuple r G) :
    product (φ • t) = 1 ↔ product t = 1 := by
  rw [product_smul, map_eq_one_iff φ φ.injective]

@[simp]
theorem generated_smul_eq_top_iff (φ : MulAut G) (t : BranchTuple r G) :
    generated (φ • t) = ⊤ ↔ generated t = ⊤ := by
  have htop := Subgroup.map_top_of_surjective φ.toMonoidHom φ.surjective
  rw [generated_smul]
  refine ⟨fun h ↦ Subgroup.map_injective (f := φ.toMonoidHom) φ.injective ?_, fun h ↦ ?_⟩
  · rw [h, htop]
  · rw [h, htop]

/-- Simultaneous conjugation by `x : ConjAct G` is the inner automorphism of `ofConjAct x` acting
on every entry. -/
theorem conjAct_smul_eq (x : ConjAct G) (t : BranchTuple r G) :
    x • t = MulAut.conj (ConjAct.ofConjAct x) • t := by
  funext i
  simp [ConjAct.smul_def, MulAut.smul_def, MulAut.conj_apply]

/-- Simultaneous conjugation conjugates the ordered product. -/
@[simp]
theorem product_conjAct_smul (x : ConjAct G) (t : BranchTuple r G) :
    product (x • t) = x • product t := by
  rw [conjAct_smul_eq, product_smul, ConjAct.smul_def, MulAut.conj_apply]

/-- Simultaneous conjugation does not change the conjugacy classes of the entries. -/
@[simp]
theorem classMultiset_conj_smul (g : G) (t : BranchTuple r G) :
    classMultiset (MulAut.conj g • t) = classMultiset t :=
  classMultiset_eq_of_isConj 1 fun _ ↦ isConj_iff.mpr ⟨g, rfl⟩

end BranchTuple

/-! ### Nielsen classes -/

/-- The Nielsen classes of branch tuples of length `r` relative to a group `A` of automorphisms of
`G`: two tuples have the same class when one automorphism in `A`, applied to every entry, carries
one to the other. -/
abbrev NielsenClass {G : Type*} [Group G] (A : Subgroup (MulAut G)) (r : ℕ) : Type _ :=
  MulAction.orbitRel.Quotient A (BranchTuple r G)

namespace NielsenClass

variable {G : Type*} [Group G] {A : Subgroup (MulAut G)} {r : ℕ}

/-- Two branch tuples have the same Nielsen class exactly when an automorphism in `A` carries the
first to the second. -/
theorem mk_eq_mk_iff_smul {t t' : BranchTuple r G} :
    (Quotient.mk'' t : NielsenClass A r) = Quotient.mk'' t' ↔ ∃ φ ∈ A, φ • t = t' := by
  rw [eq_comm, Quotient.eq'', MulAction.orbitRel_apply, MulAction.mem_orbit_iff]
  simp only [Subtype.exists, Subgroup.mk_smul, exists_prop]

/-- Two branch tuples have the same Nielsen class exactly when an automorphism in `A` carries the
first to the second entrywise. -/
theorem mk_eq_mk_iff {t t' : BranchTuple r G} :
    (Quotient.mk'' t : NielsenClass A r) = Quotient.mk'' t' ↔
      ∃ φ ∈ A, ∀ i, t' i = φ (t i) := by
  simp only [mk_eq_mk_iff_smul, funext_iff, Pi.smul_apply, MulAut.smul_def, eq_comm]

/-- Product one is an invariant of Nielsen classes. -/
theorem product_eq_one_iff_of_mk_eq_mk {t t' : BranchTuple r G}
    (h : (Quotient.mk'' t : NielsenClass A r) = Quotient.mk'' t') :
    BranchTuple.product t = 1 ↔ BranchTuple.product t' = 1 := by
  obtain ⟨φ, -, rfl⟩ := mk_eq_mk_iff_smul.mp h
  exact (BranchTuple.product_smul_eq_one_iff φ t).symm

/-- Generation of `G` is an invariant of Nielsen classes. -/
theorem generated_eq_top_iff_of_mk_eq_mk {t t' : BranchTuple r G}
    (h : (Quotient.mk'' t : NielsenClass A r) = Quotient.mk'' t') :
    BranchTuple.generated t = ⊤ ↔ BranchTuple.generated t' = ⊤ := by
  obtain ⟨φ, -, rfl⟩ := mk_eq_mk_iff_smul.mp h
  exact (BranchTuple.generated_smul_eq_top_iff φ t).symm

end NielsenClass

/-- The inner Nielsen classes of branch tuples of length `r` in `G`: branch tuples modulo
simultaneous conjugation of all entries by one element of `G`. -/
abbrev InnerNielsenClass (r : ℕ) (G : Type*) [Group G] : Type _ :=
  NielsenClass (MulAut.conj : G →* MulAut G).range r

namespace InnerNielsenClass

variable {G : Type*} [Group G] {r : ℕ}

/-- Two branch tuples have the same inner Nielsen class exactly when one element of `G`
conjugates the first to the second entrywise. -/
theorem mk_eq_mk_iff {t t' : BranchTuple r G} :
    (Quotient.mk'' t : InnerNielsenClass r G) = Quotient.mk'' t' ↔
      ∃ g : G, ∀ i, t' i = g * t i * g⁻¹ := by
  simp [NielsenClass.mk_eq_mk_iff]

/-- The conjugacy classes of the entries, with multiplicities, are an invariant of inner Nielsen
classes. -/
theorem classMultiset_eq_of_mk_eq_mk {t t' : BranchTuple r G}
    (h : (Quotient.mk'' t : InnerNielsenClass r G) = Quotient.mk'' t') :
    BranchTuple.classMultiset t = BranchTuple.classMultiset t' := by
  obtain ⟨-, ⟨g, rfl⟩, rfl⟩ := NielsenClass.mk_eq_mk_iff_smul.mp h
  exact (BranchTuple.classMultiset_conj_smul g t).symm

/-- In an abelian group, conjugation is trivial, so the inner Nielsen class of a branch tuple
determines the tuple. Dividing by all automorphisms of the group can identify more tuples. -/
theorem mk_injective {G : Type*} [CommGroup G] :
    Function.Injective (Quotient.mk'' : BranchTuple r G → InnerNielsenClass r G) := by
  intro t t' h
  obtain ⟨g, hg⟩ := mk_eq_mk_iff.mp h
  exact funext fun i ↦ by rw [hg, mul_inv_cancel_comm]

end InnerNielsenClass

/-- The absolute Nielsen classes of branch tuples of length `r` in `G`, relative to a faithful
permutation representation given as an isomorphism `e : G ≃* P` onto a subgroup `P` of a group
`S` (classically `S = Equiv.Perm (Fin d)`): branch tuples modulo the automorphisms of `G` that `e`
turns into conjugation by an element of the normaliser of `P` in `S`. -/
abbrev AbsoluteNielsenClass {G : Type*} [Group G] {S : Type*} [Group S] {P : Subgroup S}
    (e : G ≃* P) (r : ℕ) : Type _ :=
  NielsenClass ((MulAut.congr e).symm.toMonoidHom.comp
    (Subgroup.normalizerMonoidHom (H := P))).range r

namespace AbsoluteNielsenClass

variable {G : Type*} [Group G] {S : Type*} [Group S] {P : Subgroup S} {e : G ≃* P} {r : ℕ}

/-- Two branch tuples have the same absolute Nielsen class exactly when one element of the
normaliser of `P` conjugates the image of the first under `e` to the image of the second,
entrywise. -/
theorem mk_eq_mk_iff {t t' : BranchTuple r G} :
    (Quotient.mk'' t : AbsoluteNielsenClass e r) = Quotient.mk'' t' ↔
      ∃ n ∈ Subgroup.normalizer (P : Set S), ∀ i, (e (t' i) : S) = n * e (t i) * n⁻¹ := by
  rw [NielsenClass.mk_eq_mk_iff]
  constructor
  · rintro ⟨-, ⟨n, rfl⟩, h⟩
    refine ⟨n, n.property, fun i ↦ ?_⟩
    rw [h i]
    simp [MulAut.congr_symm_apply]
  · rintro ⟨n, hn, h⟩
    refine ⟨_, ⟨⟨n, hn⟩, rfl⟩, fun i ↦ e.injective (Subtype.ext ?_)⟩
    rw [h i]
    simp [MulAut.congr_symm_apply]

/-- Simultaneous conjugation is conjugation by an element of `P`, which normalises `P`: tuples with
the same inner Nielsen class have the same absolute Nielsen class. -/
theorem mk_eq_mk_of_inner {t t' : BranchTuple r G}
    (h : (Quotient.mk'' t : InnerNielsenClass r G) = Quotient.mk'' t') :
    (Quotient.mk'' t : AbsoluteNielsenClass e r) = Quotient.mk'' t' := by
  obtain ⟨g, hg⟩ := InnerNielsenClass.mk_eq_mk_iff.mp h
  refine mk_eq_mk_iff.mpr ⟨e g, P.le_normalizer (e g).property, fun i ↦ ?_⟩
  rw [hg i]
  simp

end AbsoluteNielsenClass

end TauCeti
