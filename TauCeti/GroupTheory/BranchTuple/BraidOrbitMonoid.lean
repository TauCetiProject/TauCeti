/-!
# The braid-orbit monoid

Let `c` be a conjugation-invariant subset of a group `G`. Taking the `c`-valued branch tuples of
every length, dividing the tuples of each length by the Hurwitz action of the braid group, and
multiplying by concatenation gives a graded monoid, the *braid-orbit monoid* of `(G, c)`. It is
the algebraic shadow of the union of the Hurwitz spaces of `G`-covers of the line with monodromy
in `c`, and the lifting invariant of a braid orbit is a homomorphism out of it.

We define it by its presentation: `TauCeti.BraidOrbitMonoid c` is the monoid on generators `[a]`,
`a ∈ c`, subject to the relations `[a][b] = [a b a⁻¹][a]`, one for each positive Hurwitz move.
A `c`-valued tuple `t` of length `r` represents the element
`TauCeti.BraidOrbitMonoid.ofTuple t = [t 0] ⋯ [t (r - 1)]`, so multiplication is represented by
concatenation and the empty tuple represents the unit. The comparison theorem
`TauCeti.BraidOrbitMonoid.ofTuple_eq_ofTuple_iff` says that two `c`-valued tuples of the same
length represent the same element exactly when they lie in the same orbit of the Hurwitz action;
tuples of different lengths represent different elements, since the length is an invariant. So
the elements of length `r` are exactly the braid orbits of `c`-valued tuples of length `r`.

The ordered product, the class multiplicities and the generated subgroup of a representative are
invariants. The ordered product is a homomorphism to `G`, the class multiplicities (and hence
the length) are additive, and the generated subgroup of a product is the join of the generated
subgroups. Non-generating tuples are elements too: generation is preserved by the braid action
but does not describe the whole monoid. Moving a generator `[a]` across an element `x` conjugates
it by the ordered product of `x`, so an element of product one is central.

## Main definitions

* `TauCeti.HurwitzRel c`: the relations `[a][b] ~ [a b a⁻¹][a]` among words in `c`.
* `TauCeti.BraidOrbitMonoid c`: the monoid presented by these relations.
* `TauCeti.BraidOrbitMonoid.ofTuple`: the element represented by a `c`-valued tuple.
* `TauCeti.BraidOrbitMonoid.product`: the ordered product, as a homomorphism to `G`.
* `TauCeti.BraidOrbitMonoid.classMultiset` and `TauCeti.BraidOrbitMonoid.length`: the multiset of
  conjugacy classes of the entries and the number of entries.
* `TauCeti.BraidOrbitMonoid.generated`: the subgroup generated by the entries.

## Main results

* `TauCeti.BraidOrbitMonoid.ofTuple_eq_ofTuple_iff`: two `c`-valued tuples of the same length
  represent the same element exactly when they are in the same orbit of the Hurwitz action.
* `TauCeti.BraidOrbitMonoid.ofTuple_append` and `TauCeti.BraidOrbitMonoid.ofTuple_zero`:
  multiplication is concatenation and the empty tuple is the unit;
  `TauCeti.BraidOrbitMonoid.exists_ofTuple_eq`: every element is represented by a tuple.
* `TauCeti.BraidOrbitMonoid.classMultiset_mul` and `TauCeti.BraidOrbitMonoid.length_mul`: class
  multiplicities and length are additive; `TauCeti.BraidOrbitMonoid.generated_mul`: the
  generated subgroup of a product is the join.
* `TauCeti.BraidOrbitMonoid.mul_of_eq_of_mul`: moving a generator across an element conjugates it
  by the ordered product of the element.
* `TauCeti.BraidOrbitMonoid.commute_of_product_eq_one`: an element of product one commutes with
  every element.

## References

* J. S. Ellenberg, A. Venkatesh, C. Westerland, *Homological stability for Hurwitz spaces and the
  Cohen-Lenstra conjecture over function fields*, Ann. of Math. 183 (2016), §3.3 and
  Proposition 3.4.
* M. M. Wood, *An algebraic lifting invariant of Ellenberg, Venkatesh, and Westerland*, Res.
  Math. Sci. 8 (2021), §3, proof of Theorem 3.1.
-/

public section

namespace TauCeti

open BranchTuple BraidGroup

variable {G : Type*} [Group G]

/-- The Hurwitz relations among words in a subset `c` of a group: the two-letter word `[a][b]` is
related to `[a'][a]` whenever `a' = a * b * a⁻¹`, so that each relation is one positive Hurwitz
move `(a, b) ↦ (a b a⁻¹, a)`. -/
inductive HurwitzRel (c : Set G) : FreeMonoid c → FreeMonoid c → Prop
  | move (a b a' : c) (h : (a' : G) = a * b * (a : G)⁻¹) :
      HurwitzRel c (.of a * .of b) (.of a' * .of a)

/-- The braid-orbit monoid of a subset `c` of a group: the monoid on generators `[a]`, `a ∈ c`,
subject to the relations `[a][b] = [a b a⁻¹][a]`. When `c` is conjugation-invariant, its elements
of length `r` are the orbits of the Hurwitz action on `c`-valued tuples of length `r`
(`TauCeti.BraidOrbitMonoid.ofTuple_eq_ofTuple_iff`), and multiplication is concatenation. -/
abbrev BraidOrbitMonoid (c : Set G) : Type _ := PresentedMonoid (HurwitzRel c)

namespace BraidOrbitMonoid

variable {c : Set G} {r m : ℕ}

/-- The defining relation of the braid-orbit monoid: `[a][b] = [a'][a]` when `a' = a b a⁻¹`. -/
theorem of_mul_of (a b a' : c) (h : (a' : G) = a * b * (a : G)⁻¹) :
    PresentedMonoid.of (HurwitzRel c) a * PresentedMonoid.of (HurwitzRel c) b =
      PresentedMonoid.of (HurwitzRel c) a' * PresentedMonoid.of (HurwitzRel c) a := by
  simpa only [PresentedMonoid.of, map_mul] using
    PresentedMonoid.mk_eq_mk_of_rel (HurwitzRel.move a b a' h)

/-! ### Elements represented by tuples -/

/-- The element of the braid-orbit monoid represented by a `c`-valued tuple `t` of length `r`:
the ordered product `[t 0] ⋯ [t (r - 1)]` of its generators. -/
def ofTuple (t : Fin r → c) : BraidOrbitMonoid c :=
  (List.ofFn fun i ↦ PresentedMonoid.of (HurwitzRel c) (t i)).prod

theorem ofTuple_def (t : Fin r → c) :
    ofTuple t = (List.ofFn fun i ↦ PresentedMonoid.of (HurwitzRel c) (t i)).prod :=
  (rfl)

private theorem mk_ofList (l : List c) :
    PresentedMonoid.mk (HurwitzRel c) (FreeMonoid.ofList l) =
      (l.map (PresentedMonoid.of (HurwitzRel c))).prod := by
  induction l with
  | nil => exact map_one _
  | cons a l ih => rw [FreeMonoid.ofList_cons, map_mul, ih, List.map_cons, List.prod_cons]; rfl

/-- The element represented by a tuple is the class of the word of its entries. -/
theorem mk_ofList_ofFn (t : Fin r → c) :
    PresentedMonoid.mk (HurwitzRel c) (FreeMonoid.ofList (List.ofFn t)) = ofTuple t := by
  rw [mk_ofList, List.map_ofFn, ofTuple_def, Function.comp_def]

/-- The empty tuple represents the unit. -/
@[simp]
theorem ofTuple_zero (t : Fin 0 → c) : ofTuple t = 1 := by
  simp [ofTuple_def]

@[simp]
theorem ofTuple_cons (a : c) (t : Fin r → c) :
    ofTuple (Fin.cons a t : Fin (r + 1) → c) = PresentedMonoid.of (HurwitzRel c) a * ofTuple t := by
  simp [ofTuple_def, List.ofFn_succ]

/-- Multiplication in the braid-orbit monoid is represented by concatenation of tuples. -/
theorem ofTuple_append (t : Fin r → c) (s : Fin m → c) :
    ofTuple (Fin.append t s) = ofTuple t * ofTuple s := by
  rw [← mk_ofList_ofFn, ← mk_ofList_ofFn, ← mk_ofList_ofFn, List.ofFn_fin_append,
    FreeMonoid.ofList_append, map_mul]

/-- Every element of the braid-orbit monoid is represented by a tuple. -/
theorem exists_ofTuple_eq (x : BraidOrbitMonoid c) : ∃ (r : ℕ) (t : Fin r → c), ofTuple t = x := by
  obtain ⟨w, rfl⟩ := PresentedMonoid.surjective_mk x
  refine ⟨w.toList.length, fun i ↦ w.toList[(i : ℕ)], ?_⟩
  rw [← mk_ofList_ofFn]
  simp only [List.ofFn_getElem, FreeMonoid.ofList_toList]

/-! ### Invariants -/

/-- The ordered product of a representative, as a homomorphism from the braid-orbit monoid to `G`
sending each generator `[a]` to `a`. -/
def product : BraidOrbitMonoid c →* G :=
  PresentedMonoid.lift Subtype.val fun _ _ h ↦ by
    obtain ⟨a, b, a', h⟩ := h
    simp [h]

@[simp]
theorem product_of (a : c) : product (PresentedMonoid.of (HurwitzRel c) a) = a :=
  PresentedMonoid.lift_of _ _

/-- The ordered product of the element represented by a tuple is the ordered product of the
tuple. -/
@[simp]
theorem product_ofTuple (t : Fin r → c) :
    product (ofTuple t) = BranchTuple.product fun i ↦ (t i : G) := by
  rw [ofTuple_def, map_list_prod, BranchTuple.product_def, List.map_ofFn]
  simp [Function.comp_def]

/-- The multiset of conjugacy classes of the entries of a representative: the multiplicity of a
class `C` is the number of entries lying in `C`. -/
def classMultiset (x : BraidOrbitMonoid c) : Multiset (ConjClasses G) :=
  Multiplicative.toAdd <| PresentedMonoid.lift
    (fun a : c ↦ Multiplicative.ofAdd ({ConjClasses.mk (a : G)} : Multiset (ConjClasses G)))
    (fun _ _ h ↦ by
      obtain ⟨a, b, a', h⟩ := h
      have hclass : ConjClasses.mk (a' : G) = ConjClasses.mk (b : G) :=
        ConjClasses.mk_eq_mk_iff_isConj.mpr (isConj_iff.mpr ⟨(a : G)⁻¹, by rw [h]; group⟩)
      simp only [map_mul, FreeMonoid.lift_eval_of, hclass]
      exact mul_comm _ _) x

@[simp]
theorem classMultiset_one : classMultiset (1 : BraidOrbitMonoid c) = 0 := by
  simp [classMultiset]

/-- Class multiplicities are additive. -/
@[simp]
theorem classMultiset_mul (x y : BraidOrbitMonoid c) :
    classMultiset (x * y) = classMultiset x + classMultiset y := by
  simp [classMultiset]

@[simp]
theorem classMultiset_of (a : c) :
    classMultiset (PresentedMonoid.of (HurwitzRel c) a) = {ConjClasses.mk (a : G)} := by
  simp [classMultiset]

/-- The class multiplicities of the element represented by a tuple are those of the tuple. -/
@[simp]
theorem classMultiset_ofTuple (t : Fin r → c) :
    classMultiset (ofTuple t) = BranchTuple.classMultiset fun i ↦ (t i : G) := by
  induction r with
  | zero => simp [BranchTuple.classMultiset_def]
  | succ r ih =>
    rw [← Fin.cons_self_tail t, ofTuple_cons, classMultiset_mul, classMultiset_of, ih]
    simp [BranchTuple.classMultiset_def, Fin.univ_succ, Multiset.singleton_add, Fin.tail,
      Function.comp_def]

/-- The length of an element: the number of entries of a representative. -/
def length (x : BraidOrbitMonoid c) : ℕ := Multiset.card (classMultiset x)

theorem length_def (x : BraidOrbitMonoid c) : length x = Multiset.card (classMultiset x) :=
  (rfl)

@[simp]
theorem length_one : length (1 : BraidOrbitMonoid c) = 0 := by
  simp [length_def]

/-- Length is additive, so the braid-orbit monoid is graded by length. -/
@[simp]
theorem length_mul (x y : BraidOrbitMonoid c) : length (x * y) = length x + length y := by
  simp [length_def]

@[simp]
theorem length_of (a : c) : length (PresentedMonoid.of (HurwitzRel c) a) = 1 := by
  simp [length_def]

@[simp]
theorem length_ofTuple (t : Fin r → c) : length (ofTuple t) = r := by
  simp [length_def, BranchTuple.classMultiset_def]

/-- The function on words sending a word to the subgroup generated by its letters. -/
private def wordGenerated (w : FreeMonoid c) : Subgroup G :=
  Subgroup.closure (Subtype.val '' {a | a ∈ w.toList})

private theorem wordGenerated_mul (w v : FreeMonoid c) :
    wordGenerated (w * v) = wordGenerated w ⊔ wordGenerated v := by
  simp only [wordGenerated, FreeMonoid.toList_mul, List.mem_append, Set.ofPred_or,
    Set.image_union, Subgroup.closure_union]

private theorem wordGenerated_ofList_ofFn (t : Fin r → c) :
    wordGenerated (FreeMonoid.ofList (List.ofFn t)) = BranchTuple.generated fun i ↦ (t i : G) := by
  rw [wordGenerated, BranchTuple.generated_def]
  congr 1
  ext g
  simp [List.mem_ofFn]

/-- A Hurwitz move does not change the subgroup generated by the letters of a word. -/
private theorem wordGenerated_of_mul_of {a b a' : c} (h : (a' : G) = a * b * (a : G)⁻¹) :
    wordGenerated (.of a * .of b) = wordGenerated (.of a' * .of a) := by
  have hpair (x y : c) :
      FreeMonoid.of x * FreeMonoid.of y = FreeMonoid.ofList (List.ofFn ![x, y]) := by
    simp [List.ofFn_succ, FreeMonoid.ofList_cons, FreeMonoid.ofList_nil]
  have h₀ : strand (0 : Fin (2 - 1)) = 0 := Fin.ext (by simp)
  have h₁ : strandSucc (0 : Fin (2 - 1)) = 1 := Fin.ext (by simp)
  rw [hpair, hpair, wordGenerated_ofList_ofFn, wordGenerated_ofList_ofFn,
    ← generated_hurwitzMove (0 : Fin (2 - 1))]
  congr 1
  funext k
  fin_cases k <;> simp [hurwitzMove_apply, h, h₀, h₁]

/-- The kernel of `wordGenerated`, a congruence relation on words containing the Hurwitz
relations. -/
private def wordGeneratedCon : Con (FreeMonoid c) where
  r w v := wordGenerated w = wordGenerated v
  iseqv := ⟨fun _ ↦ rfl, Eq.symm, Eq.trans⟩
  mul' h h' := by simp only [wordGenerated_mul, h, h']

private theorem conGen_le_wordGeneratedCon : conGen (HurwitzRel c) ≤ wordGeneratedCon :=
  Con.conGen_le.2 fun _ _ h ↦ by
    obtain ⟨a, b, a', h⟩ := h
    exact wordGenerated_of_mul_of h

/-- The subgroup of `G` generated by the entries of a representative. -/
def generated (x : BraidOrbitMonoid c) : Subgroup G :=
  Con.liftOn (c := conGen (HurwitzRel c)) x wordGenerated fun _ _ h ↦
    conGen_le_wordGeneratedCon h

private theorem generated_mk (w : FreeMonoid c) :
    generated (PresentedMonoid.mk (HurwitzRel c) w) = wordGenerated w :=
  (rfl)

@[simp]
theorem generated_one : generated (1 : BraidOrbitMonoid c) = ⊥ := by
  rw [← map_one (PresentedMonoid.mk (HurwitzRel c)), generated_mk]
  simp [wordGenerated]

/-- The subgroup generated by the entries of a product is the join of the generated subgroups. -/
@[simp]
theorem generated_mul (x y : BraidOrbitMonoid c) :
    generated (x * y) = generated x ⊔ generated y := by
  induction x, y using PresentedMonoid.inductionOn₂ with
  | _ w v => rw [← map_mul, generated_mk, generated_mk, generated_mk, wordGenerated_mul]

@[simp]
theorem generated_of (a : c) :
    generated (PresentedMonoid.of (HurwitzRel c) a) = Subgroup.closure {(a : G)} := by
  simp [PresentedMonoid.of, generated_mk, wordGenerated]

/-- The subgroup generated by the element represented by a tuple is the subgroup generated by the
tuple. -/
@[simp]
theorem generated_ofTuple (t : Fin r → c) :
    generated (ofTuple t) = BranchTuple.generated fun i ↦ (t i : G) := by
  rw [← mk_ofList_ofFn, generated_mk, wordGenerated_ofList_ofFn]

/-! ### Moving generators across a block -/

/-- Moving a generator `[a]` from the right of an element `x` to its left conjugates it by the
ordered product of `x`: `x [a] = [a'] x` for `a' = product x * a * (product x)⁻¹`. -/
theorem mul_of_eq_of_mul (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c) (x : BraidOrbitMonoid c)
    {a a' : c} (h : (a' : G) = product x * a * (product x)⁻¹) :
    x * PresentedMonoid.of (HurwitzRel c) a = PresentedMonoid.of (HurwitzRel c) a' * x := by
  have hx : x ∈ Submonoid.closure (Set.range (PresentedMonoid.of (HurwitzRel c))) := by
    simp [PresentedMonoid.closure_range_of]
  induction hx using Submonoid.closure_induction_left generalizing a a' with
  | one =>
    obtain rfl : a' = a := Subtype.ext (by simpa using h)
    rw [one_mul, mul_one]
  | mul_left _ hb x _ ih =>
    obtain ⟨b, rfl⟩ := hb
    -- First move `[a]` across `x`, then across `[b]`.
    let a₁ : c := ⟨product x * a * (product x)⁻¹, hc _ _ a.property⟩
    rw [mul_assoc, ih (a' := a₁) rfl, ← mul_assoc, of_mul_of b a₁ a' (by simp [h, a₁, mul_assoc]),
      mul_assoc]

/-- An element of the braid-orbit monoid whose ordered product is one is central: a block of
product one commutes with every braid orbit. -/
theorem commute_of_product_eq_one (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c)
    {x : BraidOrbitMonoid c} (hx : product x = 1) (y : BraidOrbitMonoid c) : Commute x y := by
  have hy : y ∈ Submonoid.closure (Set.range (PresentedMonoid.of (HurwitzRel c))) := by
    simp [PresentedMonoid.closure_range_of]
  induction hy using Submonoid.closure_induction with
  | mem _ ha =>
    obtain ⟨a, rfl⟩ := ha
    exact mul_of_eq_of_mul hc x (by simp [hx])
  | one => exact Commute.one_right x
  | mul _ _ _ _ hy hz => exact hy.mul_right hz

/-! ### Braid orbits -/

/-- Two `c`-valued tuples related by one Hurwitz move represent the same element. -/
private theorem ofTuple_eq_of_hurwitzMove {t t' : Fin r → c} (i : Fin (r - 1))
    (h : hurwitzMove i (fun k ↦ (t k : G)) = fun k ↦ (t' k : G)) : ofTuple t = ofTuple t' := by
  have he (k : Fin r) : (t' k : G) = hurwitzMove i (fun k ↦ (t k : G)) k := (congrFun h k).symm
  have hfix (k : Fin r) (h₀ : (k : ℕ) ≠ i) (h₁ : (k : ℕ) ≠ i + 1) : t' k = t k :=
    Subtype.ext ((he k).trans (hurwitzMove_apply_of_ne i _ (by simpa [Fin.ext_iff] using h₀)
      (by simpa [Fin.ext_iff] using h₁)))
  have hs : (strand i : ℕ) + 1 = strandSucc i := by simp
  have htake : ((List.ofFn fun k ↦ PresentedMonoid.of (HurwitzRel c) (t k)).take (strand i)) =
      (List.ofFn fun k ↦ PresentedMonoid.of (HurwitzRel c) (t' k)).take (strand i) := by
    refine List.ext_getElem (by simp) fun n h₁ _ ↦ ?_
    simp only [List.length_take, List.length_ofFn, val_strand, lt_min_iff] at h₁
    simp only [List.getElem_take, List.getElem_ofFn]
    rw [hfix _ (by simp; omega) (by simp; omega)]
  have hdrop : ((List.ofFn fun k ↦ PresentedMonoid.of (HurwitzRel c) (t k)).drop
        (strandSucc i + 1)) =
      (List.ofFn fun k ↦ PresentedMonoid.of (HurwitzRel c) (t' k)).drop (strandSucc i + 1) := by
    refine List.ext_getElem (by simp) fun n _ _ ↦ ?_
    simp only [List.getElem_drop, List.getElem_ofFn]
    rw [hfix _ (by simp; omega) (by simp; omega)]
  have hsucc : t' (strandSucc i) = t (strand i) :=
    Subtype.ext ((he _).trans (hurwitzMove_apply_strandSucc i _))
  rw [ofTuple_def, ofTuple_def, List.prod_ofFn_eq_take_mul_mul_drop _ hs,
    List.prod_ofFn_eq_take_mul_mul_drop _ hs, htake, hdrop, hsucc,
    of_mul_of _ _ (t' (strand i)) ((he _).trans (hurwitzMove_apply_strand i _))]

/-- Two `c`-valued tuples in the same orbit of the Hurwitz action represent the same element. -/
theorem ofTuple_eq_ofTuple_of_hurwitzAction (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c)
    {t t' : Fin r → c} (b : BraidGroup r)
    (h : hurwitzAction b (fun k ↦ (t k : G)) = fun k ↦ (t' k : G)) : ofTuple t = ofTuple t' := by
  induction b using sigma_induction_on generalizing t t' with
  | sigma i => exact ofTuple_eq_of_hurwitzMove i (by rwa [hurwitzAction_sigma] at h)
  | one =>
    obtain rfl : t = t' := funext fun k ↦ Subtype.ext (by simpa using congrFun h k)
    rfl
  | mul b b' hb hb' =>
    -- The intermediate tuple `b' • t` is again `c`-valued.
    let s : Fin r → c := fun k ↦ ⟨hurwitzAction b' (fun k ↦ (t k : G)) k,
      hurwitzAction_apply_mem hc (fun k ↦ (t k).property) b' k⟩
    rw [map_mul, Equiv.Perm.mul_apply] at h
    exact (hb' (t' := s) rfl).trans (hb (t := s) h)
  | inv b hb =>
    rw [map_inv, Equiv.Perm.inv_def, Equiv.symm_apply_eq] at h
    exact (hb h.symm).symm

/-- One Hurwitz move inside a word: `u [a][b] v` is related to `u [a'][a] v` for
`a' = a b a⁻¹`. -/
private def MoveRel (w w' : FreeMonoid c) : Prop :=
  ∃ (u v : FreeMonoid c) (a b a' : c), (a' : G) = a * b * (a : G)⁻¹ ∧
    w = u * (.of a * .of b) * v ∧ w' = u * (.of a' * .of a) * v

private theorem eqvGen_moveRel_mul_right {w w' : FreeMonoid c}
    (h : Relation.EqvGen MoveRel w w') (v : FreeMonoid c) :
    Relation.EqvGen MoveRel (w * v) (w' * v) := by
  induction h with
  | rel _ _ h =>
    obtain ⟨u, v', a, b, a', ha, rfl, rfl⟩ := h
    exact .rel _ _ ⟨u, v' * v, a, b, a', ha, by simp only [mul_assoc], by simp only [mul_assoc]⟩
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ ih ih' => exact .trans _ _ _ ih ih'

private theorem eqvGen_moveRel_mul_left (v : FreeMonoid c) {w w' : FreeMonoid c}
    (h : Relation.EqvGen MoveRel w w') :
    Relation.EqvGen MoveRel (v * w) (v * w') := by
  induction h with
  | rel _ _ h =>
    obtain ⟨u, v', a, b, a', ha, rfl, rfl⟩ := h
    exact .rel _ _ ⟨v * u, v', a, b, a', ha, by simp only [mul_assoc], by simp only [mul_assoc]⟩
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ ih ih' => exact .trans _ _ _ ih ih'

/-- The equivalence relation generated by Hurwitz moves inside words, as a congruence. -/
private def moveCon : Con (FreeMonoid c) where
  r := Relation.EqvGen MoveRel
  iseqv := Relation.EqvGen.equivalence _
  mul' h h' := .trans _ _ _ (eqvGen_moveRel_mul_right h _) (eqvGen_moveRel_mul_left _ h')

private theorem length_eq_of_eqvGen {w w' : FreeMonoid c} (h : Relation.EqvGen MoveRel w w') :
    w.toList.length = w'.toList.length := by
  induction h with
  | rel _ _ h =>
    obtain ⟨u, v, a, b, a', -, rfl, rfl⟩ := h
    simp [FreeMonoid.toList_mul, FreeMonoid.toList_of]
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

private theorem exists_hurwitzAction_eq_of_eqvGen {w w' : FreeMonoid c}
    (h : Relation.EqvGen MoveRel w w') {r : ℕ} {t t' : Fin r → c} (ht : w.toList = List.ofFn t)
    (ht' : w'.toList = List.ofFn t') :
    ∃ b : BraidGroup r, hurwitzAction b (fun k ↦ (t k : G)) = fun k ↦ (t' k : G) := by
  induction h generalizing r with
  | rel _ _ h =>
    obtain ⟨u, v, a, b, a', ha', rfl, rfl⟩ := h
    simp only [FreeMonoid.toList_mul, FreeMonoid.toList_of, List.append_assoc,
      List.cons_append, List.nil_append] at ht ht'
    have hlen := congrArg List.length ht
    simp only [List.length_append, List.length_cons, List.length_ofFn] at hlen
    let i : Fin (r - 1) := ⟨u.toList.length, by omega⟩
    have hget (s : Fin r → c) (k : Fin r) : s k = (List.ofFn s)[(k : ℕ)]'(by simp) := by simp
    have hta : t (strand i) = a := by
      rw [hget t]
      simp only [← ht]
      simp [i]
    have htb : t (strandSucc i) = b := by
      rw [hget t]
      simp only [← ht]
      simp [i]
    have hval (s : Fin r → c) : List.ofFn (fun k ↦ (s k : G)) = (List.ofFn s).map Subtype.val := by
      simp [List.map_ofFn, Function.comp_def]
    refine ⟨sigma i, List.ofFn_injective ?_⟩
    rw [hurwitzAction_sigma, ofFn_hurwitzMove, hta, htb, hval, hval, ← ht, ← ht']
    simp [i, ha', List.drop_append, Nat.add_assoc]
  | refl =>
    obtain rfl := List.ofFn_injective (ht.symm.trans ht')
    exact ⟨1, by simp⟩
  | symm _ _ _ ih =>
    obtain ⟨b, hb⟩ := ih ht' ht
    exact ⟨b⁻¹, by rw [← hb, map_inv, Equiv.Perm.inv_def, Equiv.symm_apply_apply]⟩
  | trans _ w' _ h₁ _ ih₁ ih₂ =>
    obtain rfl : w'.toList.length = r := by rw [← length_eq_of_eqvGen h₁, ht, List.length_ofFn]
    obtain ⟨b₁, hb₁⟩ := ih₁ ht List.ofFn_getElem.symm
    obtain ⟨b₂, hb₂⟩ := ih₂ List.ofFn_getElem.symm ht'
    exact ⟨b₂ * b₁, by rw [map_mul, Equiv.Perm.mul_apply, hb₁, hb₂]⟩

/-- Two `c`-valued tuples of the same length representing the same element lie in the same orbit
of the Hurwitz action. -/
theorem exists_hurwitzAction_eq_of_ofTuple_eq {t t' : Fin r → c} (h : ofTuple t = ofTuple t') :
    ∃ b : BraidGroup r, hurwitzAction b (fun k ↦ (t k : G)) = fun k ↦ (t' k : G) := by
  rw [← mk_ofList_ofFn, ← mk_ofList_ofFn, PresentedMonoid.mk_eq_mk_iff] at h
  have hle : conGen (HurwitzRel c) ≤ moveCon := Con.conGen_le.2 fun _ _ h ↦ by
    obtain ⟨a, b, a', ha⟩ := h
    exact .rel _ _ ⟨1, 1, a, b, a', ha, by simp, by simp⟩
  exact exists_hurwitzAction_eq_of_eqvGen (hle h) rfl rfl

/-- **Elements of the braid-orbit monoid are braid orbits.** For a conjugation-invariant subset
`c`, two `c`-valued tuples of the same length represent the same element of the braid-orbit
monoid exactly when they lie in the same orbit of the Hurwitz action of the braid group. Tuples
of different lengths represent different elements (`TauCeti.BraidOrbitMonoid.length_ofTuple`). -/
theorem ofTuple_eq_ofTuple_iff (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c) {t t' : Fin r → c} :
    ofTuple t = ofTuple t' ↔
      ∃ b : BraidGroup r, hurwitzAction b (fun k ↦ (t k : G)) = fun k ↦ (t' k : G) :=
  ⟨exists_hurwitzAction_eq_of_ofTuple_eq, fun ⟨b, hb⟩ ↦ ofTuple_eq_ofTuple_of_hurwitzAction hc b hb⟩

end BraidOrbitMonoid

end TauCeti
