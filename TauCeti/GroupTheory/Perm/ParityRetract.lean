module

public import Mathlib.GroupTheory.Complement
public import Mathlib.GroupTheory.SpecificGroups.Alternating
public import TauCeti.GroupTheory.Perm.MovedNorm

/-!
# A nonexpanding parity retraction

For a transposition `t`, `Equiv.Perm.parityRetract` sends even permutations to the identity and
odd permutations to `t`. It is a homomorphism onto `Subgroup.zpowers t`
(`Equiv.Perm.range_parityRetract`) with kernel `alternatingGroup α`
(`Equiv.Perm.ker_parityRetract`), fixes `{1, t}` pointwise, and does not increase the moved-point
norm. In particular, `Subgroup.zpowers t` is a complement of `alternatingGroup α` in `Perm α`
(`Equiv.Perm.IsSwap.isComplement'_alternatingGroup_zpowers`), and gauges with values in a symmetric
group can be retracted to the two-element subgroup without increasing the cost of a cochain valued
in that subgroup.

This is the parity-retraction argument used in Jeromie Beasley, *The Permutation Coboundary
Constant of the Complete Complex Is k/3 for Every k≥4*, version 7,
doi:10.5281/zenodo.23245792, Corollary 7 and Theorem 8.
-/

public section

namespace Equiv.Perm

variable {α : Type*} [Fintype α] [DecidableEq α] {t : Perm α}

/-- The parity homomorphism onto the subgroup generated by a transposition `t`. -/
def parityRetract (ht : t.IsSwap) : Perm α →* Perm α where
  toFun σ := if sign σ = 1 then 1 else t
  map_one' := by simp
  map_mul' σ τ := by
    have htt : t * t = 1 := by
      obtain ⟨a, b, _, rfl⟩ := ht
      simp
    rcases Int.units_eq_one_or (sign σ) with hσ | hσ <;>
      rcases Int.units_eq_one_or (sign τ) with hτ | hτ <;>
      simp [hσ, hτ, htt, Units.ext_iff]

/-- The parity retraction chooses between the identity and the given transposition. -/
theorem parityRetract_apply (ht : t.IsSwap) (σ : Perm α) :
    parityRetract ht σ = if sign σ = 1 then 1 else t :=
  (rfl)

/-- Even permutations retract to the identity. -/
@[simp]
theorem parityRetract_of_sign_eq_one (ht : t.IsSwap) {σ : Perm α} (hσ : sign σ = 1) :
    parityRetract ht σ = 1 := by
  simp [parityRetract_apply, hσ]

/-- Odd permutations retract to the given transposition. -/
@[simp]
theorem parityRetract_of_sign_eq_neg_one (ht : t.IsSwap) {σ : Perm α}
    (hσ : sign σ = -1) : parityRetract ht σ = t := by
  simp [parityRetract_apply, hσ, Units.ext_iff]

/-- The parity retraction fixes its chosen transposition. -/
@[simp]
theorem parityRetract_self (ht : t.IsSwap) : parityRetract ht t = t :=
  parityRetract_of_sign_eq_neg_one ht ht.sign_eq

/-- The range of the parity retraction consists exactly of the identity and the transposition. -/
theorem mem_range_parityRetract (ht : t.IsSwap) (σ : Perm α) :
    σ ∈ Set.range (parityRetract ht) ↔ σ = 1 ∨ σ = t := by
  constructor
  · rintro ⟨τ, rfl⟩
    rw [parityRetract_apply]
    split_ifs <;> simp
  · rintro (rfl | rfl)
    · exact ⟨1, map_one _⟩
    · exact ⟨_, parityRetract_self ht⟩

/-- Retracting twice is the same as retracting once. -/
@[simp]
theorem parityRetract_idem (ht : t.IsSwap) (σ : Perm α) :
    parityRetract ht (parityRetract ht σ) = parityRetract ht σ := by
  rw [parityRetract_apply ht σ]
  split_ifs <;> simp

/-- The fixed points of the parity retraction are precisely its two possible values. -/
@[simp]
theorem parityRetract_eq_self_iff (ht : t.IsSwap) (σ : Perm α) :
    parityRetract ht σ = σ ↔ σ = 1 ∨ σ = t := by
  constructor
  · intro h
    exact (mem_range_parityRetract ht σ).mp ⟨σ, h⟩
  · rintro (rfl | rfl) <;> simp

/-- The parity retraction preserves the sign. -/
@[simp]
theorem sign_parityRetract (ht : t.IsSwap) (σ : Perm α) :
    sign (parityRetract ht σ) = sign σ := by
  rcases Int.units_eq_one_or (sign σ) with hσ | hσ <;>
    simp [hσ, ht.sign_eq]

/-- The kernel of the parity retraction consists exactly of the even permutations. -/
@[simp]
theorem parityRetract_eq_one_iff (ht : t.IsSwap) (σ : Perm α) :
    parityRetract ht σ = 1 ↔ sign σ = 1 := by
  constructor
  · intro h
    rw [← sign_parityRetract ht σ, h, sign_one]
  · exact parityRetract_of_sign_eq_one ht

/-- The kernel of the parity retraction is the alternating subgroup. -/
@[simp]
theorem ker_parityRetract (ht : t.IsSwap) : (parityRetract ht).ker = alternatingGroup α := by
  ext σ
  rw [MonoidHom.mem_ker, parityRetract_eq_one_iff, mem_alternatingGroup]

/-- The range of the parity retraction is the cyclic subgroup generated by its transposition. -/
@[simp]
theorem range_parityRetract (ht : t.IsSwap) :
    (parityRetract ht).range = Subgroup.zpowers t := by
  refine le_antisymm ?_ (Subgroup.zpowers_le.mpr ⟨t, parityRetract_self ht⟩)
  rintro σ hσ
  rcases (mem_range_parityRetract ht σ).mp hσ with rfl | h
  · exact one_mem _
  · exact h ▸ Subgroup.mem_zpowers t

/-- Every value of the parity retraction squares to `1`. -/
@[simp]
theorem parityRetract_mul_self (ht : t.IsSwap) (σ : Perm α) :
    parityRetract ht σ * parityRetract ht σ = 1 := by
  rcases (mem_range_parityRetract ht (parityRetract ht σ)).mp ⟨σ, rfl⟩ with h | h
  · rw [h, mul_one]
  · obtain ⟨a, b, _, rfl⟩ := ht
    rw [h, swap_mul_self]

/-- Every value of the parity retraction is its own inverse. -/
@[simp]
theorem inv_parityRetract (ht : t.IsSwap) (σ : Perm α) :
    (parityRetract ht σ)⁻¹ = parityRetract ht σ :=
  inv_eq_iff_mul_eq_one.mpr (parityRetract_mul_self ht σ)

/-- Multiplying any permutation on the right by its parity retraction produces an even
permutation. -/
theorem mul_parityRetract_mem_alternatingGroup (ht : t.IsSwap) (σ : Perm α) :
    σ * parityRetract ht σ ∈ alternatingGroup α := by
  rw [mem_alternatingGroup, map_mul, sign_parityRetract, Int.units_mul_self]

/-- **The subgroup generated by any transposition is a complement of the alternating group.** -/
theorem IsSwap.isComplement'_alternatingGroup_zpowers (ht : t.IsSwap) :
    (alternatingGroup α).IsComplement' (Subgroup.zpowers t) := by
  apply Subgroup.isComplement'_of_disjoint_and_mul_eq_univ
  · rw [disjoint_iff_inf_le, ← ker_parityRetract ht, ← range_parityRetract ht]
    rintro σ ⟨hker, hrange⟩
    exact ((parityRetract_eq_self_iff ht σ).mpr
      ((mem_range_parityRetract ht σ).mp hrange)).symm.trans hker
  · refine Set.eq_univ_iff_forall.mpr fun σ =>
      ⟨σ * parityRetract ht σ, mul_parityRetract_mem_alternatingGroup ht σ,
        parityRetract ht σ, ?_, ?_⟩
    · rw [SetLike.mem_coe, ← range_parityRetract ht]
      exact ⟨σ, rfl⟩
    · dsimp only
      rw [mul_assoc, parityRetract_mul_self, mul_one]

/-- The parity retraction does not increase the moved-point norm. -/
theorem movedNorm_parityRetract_le (ht : t.IsSwap) (σ : Perm α) :
    movedNorm α (parityRetract ht σ) ≤ movedNorm α σ := by
  rcases Int.units_eq_one_or (sign σ) with hσ | hσ
  · simp [hσ]
  · rw [parityRetract_of_sign_eq_neg_one ht hσ, ht.movedNorm]
    exact two_le_movedNorm_of_sign_eq_neg_one hσ

end Equiv.Perm
