module

public import Mathlib.GroupTheory.SpecificGroups.Alternating
public import TauCeti.GroupTheory.Perm.FiberSubgroup

/-!
# Permutation subgroups generated by transpositions

A subgroup `G` of `Equiv.Perm α` always preserves its own orbits, so it is contained in
`TauCeti.fiberSubgroup (Quotient.mk (MulAction.orbitRel G α))`. On a finite set `α`, this
inclusion is an equality if and only if `G` is generated by the transpositions it contains, if and
only if `G` contains the transposition of every pair of points in the same `G`-orbit. In that case
`TauCeti.fiberSubgroupMulEquivPiPerm` identifies `G` with the product of the full symmetric groups
on its orbits.

For the alternating group `alternatingGroup α`, no transposition is even, so its subgroup generated
by transpositions is trivial. Consequently `alternatingGroup α` is generated by transpositions if
and only if `card α ≤ 2`.

## Main results

* `TauCeti.le_fiberSubgroup_orbitRel`: every subgroup of `Equiv.Perm α` preserves its own orbits.
* `Subgroup.swap_mem_of_orbitRel_of_closure_isSwap_eq`: if `G` is generated by transpositions,
  every two points in the same `G`-orbit are exchanged by a transposition in `G`.
* `Subgroup.closure_isSwap_eq_iff_forall_orbitRel`: on a finite type, `G` is generated by
  transpositions if and only if `G` contains `Equiv.swap a b` for every orbit-equivalent `a, b`.
* `TauCeti.closure_isSwap_eq_iff_eq_fiberSubgroup_orbitRel`: on a finite type, `G` is generated
  by transpositions if and only if `G = fiberSubgroup (Quotient.mk (MulAction.orbitRel G α))`.
* `TauCeti.mulEquivPiPermOfClosureIsSwapEq`: the explicit isomorphism of a transposition-generated
  subgroup of `Equiv.Perm α` with the product of full symmetric groups on its orbits.
* `TauCeti.closure_isSwap_alternatingGroup_eq_iff`: `alternatingGroup α` is generated by
  transpositions if and only if `Fintype.card α ≤ 2`.
-/

public section

open Equiv

section Subgroup

namespace Subgroup

variable {α : Type*}

/-- If `G ≤ Equiv.Perm α` is generated by the transpositions it contains, then any two elements in
the same `G`-orbit are swapped by a transposition in `G`. -/
theorem swap_mem_of_orbitRel_of_closure_isSwap_eq [DecidableEq α]
    (G : Subgroup (Perm α))
    (hG : Subgroup.closure {τ : Perm α | τ ∈ G ∧ τ.IsSwap} = G)
    {a b : α} (hab : MulAction.orbitRel G α a b) :
    swap a b ∈ G := by
  have htrans : ∀ {x y z : α}, swap x y ∈ G → swap y z ∈ G → swap x z ∈ G := by
    intro x y z hxy hyz
    rcases eq_or_ne x y with rfl | hxy'; · exact hyz
    rcases eq_or_ne y z with rfl | hyz'; · exact hxy
    rcases eq_or_ne x z with rfl | hxz'; · simpa [Perm.one_def] using G.one_mem
    have heq : swap x y * swap y z * swap x y = swap x z := by
      ext w; simp only [Perm.coe_mul, Function.comp_apply, swap_apply_def]; split_ifs <;> simp_all
    exact heq ▸ G.mul_mem (G.mul_mem hxy hyz) hxy
  -- Permutations moving each point within its `swap`-class form a subgroup containing all swaps.
  let S : Subgroup (Perm α) :=
    { carrier := {g : Perm α | ∀ x, swap (g x) x ∈ G}
      one_mem' := fun _ => by simpa [Perm.one_def] using G.one_mem
      mul_mem' := fun {g h} hg hh x => htrans (hg (h x)) (hh x)
      inv_mem' := fun {g} hg x => by
        simpa [Perm.inv_def, Equiv.apply_symm_apply, swap_comm] using hg (g⁻¹ x) }
  have hle : G ≤ S := by
    rw [← hG, closure_le]
    rintro τ ⟨hτG, x, y, -, rfl⟩ w
    rcases eq_or_ne w x with rfl | hwx; · simpa [swap_comm] using hτG
    rcases eq_or_ne w y with rfl | hwy; · simpa using hτG
    · rw [swap_apply_of_ne_of_ne hwx hwy]; simpa [Perm.one_def] using G.one_mem
  obtain ⟨⟨g, hg⟩, rfl⟩ := hab
  exact hle hg b

end Subgroup

end Subgroup

namespace TauCeti

variable {α : Type*}

/-- Every subgroup `G ≤ Equiv.Perm α` preserves its own orbits, so it is contained in the fiber
subgroup of the orbit quotient map. -/
theorem le_fiberSubgroup_orbitRel (G : Subgroup (Perm α)) :
    G ≤ fiberSubgroup (Quotient.mk (MulAction.orbitRel G α)) := fun g hg =>
  mem_fiberSubgroup.mpr fun _ => Quotient.sound ⟨⟨g, hg⟩, rfl⟩

/-- If `G` contains the transposition of every pair of elements in the same `G`-orbit on a finite
type `α`, then every orbit-preserving permutation lies in the subgroup generated by transpositions
of `G`. -/
private theorem fiberSubgroup_orbitRel_le_closure_isSwap [Finite α] [DecidableEq α]
    (G : Subgroup (Perm α))
    (hswap : ∀ a b : α, MulAction.orbitRel G α a b → swap a b ∈ G) :
    fiberSubgroup (Quotient.mk (MulAction.orbitRel G α)) ≤
      Subgroup.closure {τ : Perm α | τ ∈ G ∧ τ.IsSwap} := by
  cases nonempty_fintype α
  intro σ hσ
  suffices ∀ n : ℕ, ∀ π : Perm α, π ∈ fiberSubgroup (Quotient.mk (MulAction.orbitRel G α)) →
      π.support.card = n → π ∈ Subgroup.closure {τ : Perm α | τ ∈ G ∧ τ.IsSwap} from
    this σ.support.card σ hσ rfl
  intro n
  induction n using Nat.strong_induction_on with
  | ind n ih =>
    intro π hπ hn
    rcases π.support.eq_empty_or_nonempty with hemp | ⟨a, ha⟩
    · rw [Perm.support_eq_empty_iff.mp hemp]; exact one_mem _
    · have ha' : π a ≠ a := Perm.mem_support.mp ha
      have hτG : swap a (π a) ∈ G := swap_comm a (π a) ▸
        hswap (π a) a (Quotient.exact (mem_fiberSubgroup.mp hπ a))
      have hτmem : swap a (π a) ∈ Subgroup.closure {τ : Perm α | τ ∈ G ∧ τ.IsSwap} :=
        Subgroup.subset_closure ⟨hτG, a, π a, ha'.symm, rfl⟩
      let π' : Perm α := swap a (π a) * π
      have hsub : π'.support ⊂ π.support := by
        refine Finset.ssubset_iff_subset_ne.mpr ⟨fun x hx => ?_, fun heq =>
          Perm.mem_support.mp (heq ▸ ha) (by simp [π'])⟩
        by_contra hnot
        have hfix : π x = x := Perm.notMem_support.mp hnot
        have hxa : x ≠ a := fun h => hnot (h ▸ ha)
        have hxπa : x ≠ π a := fun h => hxa (π.injective (hfix.trans h))
        exact Perm.mem_support.mp hx (by simp [π', hfix, swap_apply_of_ne_of_ne hxa hxπa])
      have hπ'mem := ih π'.support.card (hn ▸ Finset.card_lt_card hsub) π'
        (Subgroup.mul_mem _ (le_fiberSubgroup_orbitRel G hτG) hπ) rfl
      have hprod : swap a (π a) * π' = π := by simp [π', ← mul_assoc]
      exact hprod ▸ Subgroup.mul_mem _ hτmem hπ'mem

/-- On a finite type, a permutation subgroup `G` is generated by transpositions if and only if it
equals the fiber subgroup of its orbit quotient map (the product of full symmetric groups on its
orbits). -/
theorem closure_isSwap_eq_iff_eq_fiberSubgroup_orbitRel [Finite α] [DecidableEq α]
    (G : Subgroup (Perm α)) :
    Subgroup.closure {τ : Perm α | τ ∈ G ∧ τ.IsSwap} = G ↔
      G = fiberSubgroup (Quotient.mk (MulAction.orbitRel G α)) := by
  refine ⟨fun hG => le_antisymm (le_fiberSubgroup_orbitRel G) ?_, fun hG =>
    le_antisymm ((Subgroup.closure_le G).2 fun _ h => h.1) ?_⟩
  · simpa [hG] using fiberSubgroup_orbitRel_le_closure_isSwap G
      (fun _ _ hab => G.swap_mem_of_orbitRel_of_closure_isSwap_eq hG hab)
  · exact (le_fiberSubgroup_orbitRel G).trans <| fiberSubgroup_orbitRel_le_closure_isSwap G
      fun _ _ hab => hG.symm ▸ swap_mem_fiberSubgroup (Quotient.sound hab)

end TauCeti

namespace Subgroup

variable {α : Type*}

/-- On a finite type, a permutation subgroup `G` is generated by transpositions if and only if it
contains `Equiv.swap a b` whenever `a` and `b` lie in the same `G`-orbit. -/
theorem closure_isSwap_eq_iff_forall_orbitRel [Finite α] [DecidableEq α]
    (G : Subgroup (Perm α)) :
    Subgroup.closure {τ : Perm α | τ ∈ G ∧ τ.IsSwap} = G ↔
      ∀ a b : α, MulAction.orbitRel G α a b → swap a b ∈ G :=
  ⟨fun hG _ _ hab => G.swap_mem_of_orbitRel_of_closure_isSwap_eq hG hab, fun hswap =>
    le_antisymm ((closure_le G).2 fun _ h => h.1)
      ((TauCeti.le_fiberSubgroup_orbitRel G).trans
        (TauCeti.fiberSubgroup_orbitRel_le_closure_isSwap G hswap))⟩

end Subgroup

namespace TauCeti

variable {α : Type*}

/-- A permutation subgroup of a finite type generated by transpositions is isomorphic to the direct
product of the full symmetric groups on its orbits. -/
def mulEquivPiPermOfClosureIsSwapEq [Finite α] [DecidableEq α] (G : Subgroup (Perm α))
    (hG : Subgroup.closure {τ : Perm α | τ ∈ G ∧ τ.IsSwap} = G) :
    G ≃* ∀ o : MulAction.orbitRel.Quotient G α,
      Perm {a : α // Quotient.mk (MulAction.orbitRel G α) a = o} :=
  (MulEquiv.subgroupCongr
      ((closure_isSwap_eq_iff_eq_fiberSubgroup_orbitRel G).mp hG)).trans
    (fiberSubgroupMulEquivPiPerm (Quotient.mk (MulAction.orbitRel G α)))

@[simp]
theorem mulEquivPiPermOfClosureIsSwapEq_apply_coe [Finite α] [DecidableEq α]
    (G : Subgroup (Perm α))
    (hG : Subgroup.closure {τ : Perm α | τ ∈ G ∧ τ.IsSwap} = G)
    (g : G) (o : MulAction.orbitRel.Quotient G α)
    (a : {a : α // Quotient.mk (MulAction.orbitRel G α) a = o}) :
    (mulEquivPiPermOfClosureIsSwapEq G hG g o a : α) = (g : Perm α) a := by
  rw [mulEquivPiPermOfClosureIsSwapEq, MulEquiv.trans_apply,
    fiberSubgroupMulEquivPiPerm_apply_coe]
  rfl

/-- No transposition belongs to `alternatingGroup α`, so its subgroup generated by transpositions
is trivial. -/
theorem closure_isSwap_alternatingGroup [Fintype α] [DecidableEq α] :
    Subgroup.closure {τ : Perm α | τ ∈ alternatingGroup α ∧ τ.IsSwap} = ⊥ := by
  rw [eq_bot_iff, Subgroup.closure_le]
  rintro τ ⟨hτA, hτs⟩
  exact absurd ((Perm.mem_alternatingGroup.mp hτA).symm.trans hτs.sign_eq) (by decide)

/-- The alternating group on a finite type `α` is trivial if and only if `Fintype.card α ≤ 2`. -/
theorem alternatingGroup_eq_bot_iff [Fintype α] [DecidableEq α] :
    alternatingGroup α = ⊥ ↔ Fintype.card α ≤ 2 := by
  rw [← Nat.card_eq_fintype_card]
  refine ⟨fun hbot => ?_, alternatingGroup.eq_bot_of_card_le_two⟩
  by_contra hlt
  have : Nontrivial (alternatingGroup α) :=
    alternatingGroup.nontrivial_of_three_le_card (by omega)
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩, hab⟩ := exists_pair_ne (alternatingGroup α)
  exact hab (Subtype.ext ((Subgroup.mem_bot.mp (hbot ▸ ha)).trans
    (Subgroup.mem_bot.mp (hbot ▸ hb)).symm))

/-- The alternating group on a finite type `α` is generated by transpositions if and only if
`Fintype.card α ≤ 2`. -/
theorem closure_isSwap_alternatingGroup_eq_iff [Fintype α] [DecidableEq α] :
    Subgroup.closure {τ : Perm α | τ ∈ alternatingGroup α ∧ τ.IsSwap} = alternatingGroup α ↔
      Fintype.card α ≤ 2 := by
  rw [closure_isSwap_alternatingGroup, eq_comm, alternatingGroup_eq_bot_iff]

end TauCeti
