module

public import TauCeti.GroupTheory.Perm.Basic

/-!
# Two involutions and the cycles of their product

Conjugating the product `f * g` of two involutions by `g` inverts it, so `g` carries each cycle of
`f * g` onto a cycle traversed backwards; this is the involution
`Function.Involutive.cycleReversal` of the cycles of `f * g`. The classes of the equivalence
relation generated by `f` and `g` are exactly its orbits: such a class consists of a cycle of
`f * g` together with its reverse.

## Main definitions

* `Function.Involutive.cycleReversal`: for involutions `f` and `g`, the involution of the cycles
  of `f * g` induced by `g`, which reverses their direction of travel.
* `Function.Involutive.eqvGenQuotientEquiv`: the classes of the equivalence relation generated by
  two involutions are the orbits of `Function.Involutive.cycleReversal`.

## Main results

* `Function.Involutive.eqvGen_iff_sameCycle`: the equivalence relation generated by two
  involutions relates `x` exactly to the cycles of `x` and of `g x` under `f * g`.
* `Function.Involutive.sameCycle_cycleReversal_mk_mk_iff`: two cycles are one orbit of reversal
  exactly when they are equal or reverse to each other.
-/

public section

namespace Function.Involutive

open Equiv Equiv.Perm

variable {α : Type*} {f g : Equiv.Perm α}

/-- Conjugating the product of two involutions by its second factor inverts it. -/
theorem semiconj_mul (hf : Function.Involutive f) (hg : Function.Involutive g) :
    Function.Semiconj g ⇑(f * g) ⇑(f * g)⁻¹ := by
  intro z
  rw [Perm.inv_def, Equiv.eq_symm_apply]
  simp [hf (g z), hg (f (g z))]

/-- For involutions `f` and `g`, applying `g` to two points does not change whether they lie in one
cycle of `f * g`: `g` carries each cycle onto a cycle traversed backwards. -/
theorem sameCycle_apply_apply_iff (hf : Function.Involutive f) (hg : Function.Involutive g)
    {x y : α} : (f * g).SameCycle (g x) (g y) ↔ (f * g).SameCycle x y := by
  refine ⟨fun h ↦ ?_, fun h ↦ sameCycle_inv.mp (h.map (hf.semiconj_mul hg))⟩
  simpa only [hg _] using sameCycle_inv.mp (h.map (hf.semiconj_mul hg))

/-- **The equivalence relation generated by two involutions.** It relates `x` to `y` exactly when
`y` lies in the cycle of `x` or in the cycle of `g x` under `f * g`. -/
theorem eqvGen_iff_sameCycle (hf : Function.Involutive f) (hg : Function.Involutive g)
    {x y : α} :
    Relation.EqvGen (fun a b ↦ b = g a ∨ b = f a) x y ↔
      (f * g).SameCycle x y ∨ (f * g).SameCycle (g x) y := by
  constructor
  · intro h
    induction h with
    | rel a b hab =>
      rcases hab with rfl | rfl
      · exact Or.inr .rfl
      · right
        simpa [hg a] using (sameCycle_apply_right (f := f * g) (x := g a) (y := g a)).mpr .rfl
    | refl a => exact Or.inl .rfl
    | symm a b _ ih =>
      rcases ih with h | h
      · exact Or.inl h.symm
      · right
        simpa only [hg a] using ((hf.sameCycle_apply_apply_iff hg).mpr h).symm
    | trans a b c _ _ ihab ihbc =>
      rcases ihab with h | h <;> rcases ihbc with h' | h'
      · exact Or.inl (h.trans h')
      · exact Or.inr (((hf.sameCycle_apply_apply_iff hg).mpr h).trans h')
      · exact Or.inr (h.trans h')
      · left
        simpa only [hg a] using ((hf.sameCycle_apply_apply_iff hg).mpr h).trans h'
  · -- One step of `f * g` is a `g`-step followed by an `f`-step.
    have hstep (a : α) : Relation.EqvGen (fun a b ↦ b = g a ∨ b = f a) a ((f * g) a) :=
      .trans _ _ _ (.rel _ _ (Or.inl rfl)) (.rel _ _ (Or.inr rfl))
    have hcyc {a b : α} (h : (f * g).SameCycle a b) :
        Relation.EqvGen (fun a b ↦ b = g a ∨ b = f a) a b :=
      Quot.eqvGen_exact (h.apply_eq_of_apply_eq fun z ↦ (Quot.eqvGen_sound (hstep z)).symm)
    rintro (h | h)
    · exact hcyc h
    · exact .trans _ _ _ (.rel _ _ (Or.inl rfl)) (hcyc h)

/-- **Reversal of the cycles of a product of two involutions.** For involutions `f` and `g`, the
second factor `g` carries each cycle of `f * g` onto a cycle traversed backwards, so it permutes
the cycles. -/
def cycleReversal (hf : Function.Involutive f) (hg : Function.Involutive g) :
    Equiv.Perm (Quotient (SameCycle.setoid (f * g))) :=
  Quotient.congr g fun _ _ ↦ (hf.sameCycle_apply_apply_iff hg).symm

/-- Reversal sends the cycle of `x` to the cycle of `g x`. -/
@[simp]
theorem cycleReversal_mk (hf : Function.Involutive f) (hg : Function.Involutive g) (x : α) :
    hf.cycleReversal hg ⟦x⟧ = ⟦g x⟧ :=
  (rfl)

/-- Reversing the cycles of a product of two involutions twice gives back every cycle. -/
theorem cycleReversal_involutive (hf : Function.Involutive f) (hg : Function.Involutive g) :
    Function.Involutive (hf.cycleReversal hg) := by
  intro q
  induction q using Quotient.ind
  simp [hg _]

/-- Two cycles of a product of two involutions are one orbit of reversal exactly when they are
equal or reverse to each other. -/
theorem sameCycle_cycleReversal_mk_mk_iff (hf : Function.Involutive f)
    (hg : Function.Involutive g) {x y : α} :
    (hf.cycleReversal hg).SameCycle ⟦x⟧ ⟦y⟧ ↔
      (f * g).SameCycle x y ∨ (f * g).SameCycle (g x) y := by
  have h := TauCeti.sameCycle_toPerm_iff _ (hf.cycleReversal_involutive hg) ⟦x⟧ ⟦y⟧
  -- `Function.Involutive.toPerm` rebuilds a permutation from the underlying function of
  -- `cycleReversal`, using that function as its own inverse, so the two agree pointwise by `rfl`.
  rw [show (hf.cycleReversal_involutive hg).toPerm _ = hf.cycleReversal hg from
    Equiv.ext fun _ ↦ rfl] at h
  rw [h, cycleReversal_mk, Quotient.eq, Quotient.eq]
  have h' := hf.sameCycle_apply_apply_iff hg (x := x) (y := g y)
  rw [hg y] at h'
  exact or_congr Iff.rfl h'.symm

/-- **The classes of the equivalence relation generated by two involutions** are the cycles of
their product modulo reversal: the class of `x` corresponds to the reversal orbit of the cycle of
`x`. -/
noncomputable def eqvGenQuotientEquiv (hf : Function.Involutive f)
    (hg : Function.Involutive g) :
    Quotient (Relation.EqvGen.setoid fun a b ↦ b = g a ∨ b = f a) ≃
      Quotient (SameCycle.setoid (hf.cycleReversal hg)) :=
  Equiv.ofBijective
    (Quotient.lift (fun x ↦ ⟦⟦x⟧⟧) fun _ _ h ↦ Quotient.sound <|
      (hf.sameCycle_cycleReversal_mk_mk_iff hg).mpr ((hf.eqvGen_iff_sameCycle hg).mp h))
    ⟨by
      rintro ⟨x⟩ ⟨y⟩ h
      exact Quotient.sound ((hf.eqvGen_iff_sameCycle hg).mpr
        ((hf.sameCycle_cycleReversal_mk_mk_iff hg).mp (Quotient.exact h))),
    by
      rintro ⟨⟨x⟩⟩
      exact ⟨⟦x⟧, rfl⟩⟩

/-- The class of `x` corresponds to the reversal orbit of the cycle of `x`. -/
@[simp]
theorem eqvGenQuotientEquiv_mk (hf : Function.Involutive f) (hg : Function.Involutive g)
    (x : α) : hf.eqvGenQuotientEquiv hg ⟦x⟧ = ⟦⟦x⟧⟧ :=
  (rfl)

end Function.Involutive
