module

public import Mathlib.Algebra.Group.TypeTags.Basic
public import Mathlib.Data.ZMod.Defs
public import Mathlib.GroupTheory.SpecificGroups.Alternating
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Subgroup
import TauCeti.GroupTheory.Perm.FinThree.Basic

/-!
# The alternating group `A₃` is `ℤ/3ℤ`

The alternating subgroup of `Equiv.Perm (Fin 3)` has prime order three
(`TauCeti.card_alternatingGroup_fin_three`), so it is cyclic and generated by any nonidentity
element, for instance the three-cycle `(0 1 2) = [0, 1, 2].formPerm`. Taking powers of this
three-cycle identifies `Multiplicative (ZMod 3)` with `A₃`.

## Main definitions

* `TauCeti.alternatingGroupFinThreeZModMulEquiv`: the isomorphism
  `Multiplicative (ZMod 3) ≃* A₃`, `r ↦ (0 1 2) ^ r`.

## Main results

* `TauCeti.coe_alternatingGroupFinThreeZModMulEquiv`: the image of `r` is the permutation
  `(0 1 2) ^ r`.
-/

public section

namespace TauCeti

open Equiv

/-- **`A₃` is cyclic of order three**: the powers of the three-cycle `(0 1 2)` identify
`Multiplicative (ZMod 3)` with the alternating subgroup of `Equiv.Perm (Fin 3)`, which has prime
order three. -/
noncomputable def alternatingGroupFinThreeZModMulEquiv :
    Multiplicative (ZMod 3) ≃* alternatingGroup (Fin 3) :=
  let c : alternatingGroup (Fin 3) :=
    ⟨[0, 1, 2].formPerm, by simp [List.formPerm_cons_cons, Perm.mem_alternatingGroup]⟩
  zmodMulEquivOfGenerator (g := c)
    (fun x => by
      rw [zpowers_eq_top_of_prime_card card_alternatingGroup_fin_three (by decide : c ≠ 1)]
      trivial)
    card_alternatingGroup_fin_three

/-- The isomorphism `Multiplicative (ZMod 3) ≃* A₃` sends `r` to the power `(0 1 2) ^ r` of the
three-cycle. -/
@[simp]
theorem coe_alternatingGroupFinThreeZModMulEquiv (r : Multiplicative (ZMod 3)) :
    (alternatingGroupFinThreeZModMulEquiv r : Perm (Fin 3)) =
      [0, 1, 2].formPerm ^ (Multiplicative.toAdd r).val := by
  conv_lhs => rw [← ofAdd_toAdd r, ← ZMod.natCast_zmod_val (Multiplicative.toAdd r),
    ← Int.cast_natCast]
  rw [alternatingGroupFinThreeZModMulEquiv, zmodMulEquivOfGenerator_apply_ofAdd_intCast,
    zpow_natCast, Subgroup.coe_pow]

end TauCeti
