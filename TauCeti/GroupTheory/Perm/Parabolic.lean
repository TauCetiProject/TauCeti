module

public import TauCeti.GroupTheory.Coxeter.Parabolic
public import TauCeti.GroupTheory.Coxeter.Restriction
public import TauCeti.GroupTheory.Perm.Coxeter
public import TauCeti.GroupTheory.Perm.SumCongr
import Mathlib.Order.Fin.Basic

/-!
# The two-block standard parabolic subgroup of `S_(k+l)` and `(k, l)`-shuffles

In the symmetric group `Equiv.Perm (Fin (k + l))`, realized as the type-`A` Coxeter group
`TauCeti.permCoxeterSystem (k + l)` generated by the adjacent transpositions `s i = (i i+1)`,
omitting the single wall `s (k - 1)` crossing the boundary between the first `k` letters and the
last `l` letters leaves the index set

`TauCeti.blockParabolicSet k l = {i : Fin (k + l - 1) | (i : ℕ) + 1 < k ∨ k ≤ (i : ℕ)}`.

This file identifies the resulting standard parabolic subgroup and its minimal left coset
representatives, uniformly for all `k, l : ℕ` (including `k = 0` and `l = 0`):

* `TauCeti.permCoxeterSystem_parabolic_blockParabolicSet`: the standard parabolic subgroup attached
  to `TauCeti.blockParabolicSet k l` is the image of the block embedding
  `Equiv.Perm.finSumPermHom k l : S_k × S_l →* S_(k+l)`;
* `Equiv.Perm.permCoxeterSystem_length_finSumPerm`: `Equiv.Perm.finSumPerm σ τ` adds the Coxeter
  lengths of `σ` and `τ`;
* `TauCeti.isMinimalCosetRep_blockParabolicSet_iff`: a permutation `d` is a minimal left coset
  representative of `S_k × S_l` in `S_(k+l)` exactly when it is a `(k, l)`-*shuffle*, meaning that
  `d` is strictly increasing on the first `k` letters and strictly increasing on the last `l`
  letters;
* `TauCeti.eq_of_isMinimalCosetRep_blockParabolicSet`: a minimal coset representative is uniquely
  determined by the `k`-element image of the first block.

## Main definitions

* `TauCeti.blockParabolicSet k l`: the simple-reflection indices crossing two letters in the first
  block `{0, …, k - 1}` or two letters in the second block `{k, …, k + l - 1}`.

## Main results

* `Equiv.Perm.finSumPerm_transposition_one` and `Equiv.Perm.finSumPerm_one_transposition`: adjacent
  transpositions of the two blocks map to the corresponding adjacent transpositions of
  `Fin (k + l)`.
* `Equiv.Perm.permCoxeterSystem_length_finSumPerm`: Coxeter length is additive across
  `Equiv.Perm.finSumPerm`.
* `TauCeti.permCoxeterSystem_parabolic_blockParabolicSet`: the standard parabolic subgroup of
  `TauCeti.blockParabolicSet k l` is `(Equiv.Perm.finSumPermHom k l).range`.
* `TauCeti.isMinimalCosetRep_blockParabolicSet_iff` and
  `TauCeti.eq_of_isMinimalCosetRep_blockParabolicSet`: minimal coset representatives are the
  `(k, l)`-shuffles, determined by the image of the first `k` letters.

## References

* A. Björner and F. Brenti, *Combinatorics of Coxeter Groups*, Springer GTM 231 (2005),
  Proposition 2.4.8.
* M. Geck and G. Pfeiffer, *Characters of Finite Coxeter Groups and Iwahori-Hecke Algebras*,
  OUP (2000), Section 2.1.
-/

public section

open TauCeti TauCeti.BraidGroup

namespace Equiv.Perm

variable {k l : ℕ}

/-- An adjacent transposition of the first `k` letters, extended by the identity on the last `l`,
is the same adjacent transposition in `Equiv.Perm (Fin (k + l))`. -/
theorem finSumPerm_transposition_one (i : Fin (k - 1)) :
    finSumPerm (transposition i) (1 : Perm (Fin l)) = transposition ⟨i, by omega⟩ := by
  ext x
  induction x using Fin.addCases with
  | left a =>
    rw [finSumPerm_apply_castAdd, Fin.val_castAdd, val_transposition_apply,
      val_transposition_apply]
    simp only [Fin.val_castAdd]
  | right b =>
    have := i.isLt
    rw [finSumPerm_apply_natAdd, Perm.one_apply, val_transposition_apply]
    simp only [Fin.val_natAdd]
    split_ifs <;> omega

/-- An adjacent transposition of the last `l` letters, extended by the identity on the first `k`,
is the shifted adjacent transposition `s (k + j)` in `Equiv.Perm (Fin (k + l))`. -/
theorem finSumPerm_one_transposition (j : Fin (l - 1)) :
    finSumPerm (1 : Perm (Fin k)) (transposition j) = transposition ⟨k + j, by omega⟩ := by
  ext x
  induction x using Fin.addCases with
  | left a =>
    have := a.isLt
    rw [finSumPerm_apply_castAdd, Perm.one_apply, val_transposition_apply]
    simp only [Fin.val_castAdd]
    split_ifs <;> omega
  | right b =>
    rw [finSumPerm_apply_natAdd, Fin.val_natAdd, val_transposition_apply,
      val_transposition_apply]
    simp only [Fin.val_natAdd]
    split_ifs <;> omega

private theorem finSumPerm_inl_eq_parabolicHom :
    (finSumPermHom k l).comp (MonoidHom.inl (Perm (Fin k)) (Perm (Fin l))) =
      (permCoxeterSystem k).parabolicHom (permCoxeterSystem (k + l))
        (f := fun i : Fin (k - 1) ↦ (⟨i, by omega⟩ : Fin (k + l - 1)))
        (fun i j ↦ by simp only [coxeterMatrixA_apply, Fin.ext_iff]) :=
  (permCoxeterSystem k).ext_simple fun i ↦ by
    rw [MonoidHom.comp_apply, MonoidHom.inl_apply, finSumPermHom_apply,
      (permCoxeterSystem k).parabolicHom_simple, permCoxeterSystem_simple,
      permCoxeterSystem_simple, finSumPerm_transposition_one]

private theorem finSumPerm_inr_eq_parabolicHom :
    (finSumPermHom k l).comp (MonoidHom.inr (Perm (Fin k)) (Perm (Fin l))) =
      (permCoxeterSystem l).parabolicHom (permCoxeterSystem (k + l))
        (f := fun j : Fin (l - 1) ↦ (⟨k + j, by omega⟩ : Fin (k + l - 1)))
        (fun i j ↦ by simp only [coxeterMatrixA_apply, Fin.ext_iff]; split_ifs <;> omega) :=
  (permCoxeterSystem l).ext_simple fun j ↦ by
    rw [MonoidHom.comp_apply, MonoidHom.inr_apply, finSumPermHom_apply,
      (permCoxeterSystem l).parabolicHom_simple, permCoxeterSystem_simple,
      permCoxeterSystem_simple, finSumPerm_one_transposition]

/-- **Coxeter length is additive across `Equiv.Perm.finSumPerm`.** -/
@[simp]
theorem permCoxeterSystem_length_finSumPerm (σ : Perm (Fin k)) (τ : Perm (Fin l)) :
    (permCoxeterSystem (k + l)).length (B := Fin (k + l - 1)) (finSumPerm σ τ) =
      (permCoxeterSystem k).length (B := Fin (k - 1)) σ +
        (permCoxeterSystem l).length (B := Fin (l - 1)) τ := by
  have hmul : finSumPerm σ τ = finSumPerm σ 1 * finSumPerm 1 τ := by
    rw [finSumPerm_mul, mul_one, one_mul]
  have hσ : (permCoxeterSystem (k + l)).length (B := Fin (k + l - 1)) (finSumPerm σ 1) =
      (permCoxeterSystem k).length (B := Fin (k - 1)) σ := by
    have h := DFunLike.congr_fun (finSumPerm_inl_eq_parabolicHom (k := k) (l := l)) σ
    simpa using (congrArg (permCoxeterSystem (k + l)).length h).trans
      ((permCoxeterSystem k).length_parabolicHom _ σ)
  have hτ : (permCoxeterSystem (k + l)).length (B := Fin (k + l - 1)) (finSumPerm 1 τ) =
      (permCoxeterSystem l).length (B := Fin (l - 1)) τ := by
    have h := DFunLike.congr_fun (finSumPerm_inr_eq_parabolicHom (k := k) (l := l)) τ
    simpa using (congrArg (permCoxeterSystem (k + l)).length h).trans
      ((permCoxeterSystem l).length_parabolicHom _ τ)
  let f₁ : Fin (k - 1) → Fin (k + l - 1) := fun i ↦ ⟨i, by omega⟩
  have hmem : finSumPerm σ 1 ∈ (permCoxeterSystem (k + l)).parabolic (Set.range f₁) := by
    rw [← (permCoxeterSystem k).range_parabolicHom
      (fun i j ↦ by simp only [coxeterMatrixA_apply, Fin.ext_iff, f₁]),
      ← finSumPerm_inl_eq_parabolicHom]
    exact ⟨σ, by simp⟩
  have hnd : ∀ i ∈ Set.range f₁,
      ¬ (permCoxeterSystem (k + l)).IsLeftDescent (finSumPerm 1 τ) i := by
    rintro _ ⟨i, rfl⟩ hd
    rw [isLeftDescent_permCoxeterSystem_iff, finSumPerm_inv, inv_one] at hd
    have h₁ : strand (f₁ i) = Fin.castAdd l ⟨i, by omega⟩ := Fin.ext (by simp [f₁])
    have h₂ : strandSucc (f₁ i) = Fin.castAdd l ⟨(i : ℕ) + 1, by omega⟩ :=
      Fin.ext (by simp [f₁])
    rw [h₁, h₂, finSumPerm_apply_castAdd, finSumPerm_apply_castAdd, Perm.one_apply,
      Perm.one_apply, Fin.lt_def] at hd
    simp only [Fin.val_castAdd] at hd
    omega
  rw [hmul, (permCoxeterSystem (k + l)).length_mul_of_forall_not_isLeftDescent hmem hnd, hσ, hτ]

end Equiv.Perm

namespace TauCeti

variable {k l : ℕ}

/-- The simple-reflection indices of `TauCeti.permCoxeterSystem (k + l)` that stay within the first
`k` letters or within the last `l` letters, omitting only the wall crossing `k - 1` and `k`. -/
def blockParabolicSet (k l : ℕ) : Set (Fin (k + l - 1)) :=
  {i | (i : ℕ) + 1 < k ∨ k ≤ (i : ℕ)}

/-- An index `i` lies in `TauCeti.blockParabolicSet k l` when `i + 1 < k` or `k ≤ i`. -/
@[simp]
theorem mem_blockParabolicSet {i : Fin (k + l - 1)} :
    i ∈ blockParabolicSet k l ↔ (i : ℕ) + 1 < k ∨ k ≤ (i : ℕ) :=
  Iff.rfl

/-- **The standard parabolic subgroup of `TauCeti.blockParabolicSet k l` is `S_k × S_l`.** Its
elements are the permutations in the range of `Equiv.Perm.finSumPermHom k l`. -/
theorem permCoxeterSystem_parabolic_blockParabolicSet (k l : ℕ) :
    (permCoxeterSystem (k + l)).parabolic (blockParabolicSet k l) =
      (Equiv.Perm.finSumPermHom k l).range := by
  refine le_antisymm ((permCoxeterSystem (k + l)).parabolic_le_iff.mpr fun i hi ↦ ?_) ?_
  · rw [permCoxeterSystem_simple]
    rcases hi with hlt | hge
    · exact ⟨(transposition ⟨i, by omega⟩, 1), by
        simp [Equiv.Perm.finSumPerm_transposition_one]⟩
    · exact ⟨(1, transposition ⟨(i : ℕ) - k, by omega⟩), by
        simpa [Nat.add_sub_of_le hge] using
          Equiv.Perm.finSumPerm_one_transposition (k := k) ⟨(i : ℕ) - k, by omega⟩⟩
  · rintro _ ⟨⟨σ, τ⟩, rfl⟩
    rw [Equiv.Perm.finSumPermHom_apply]
    have hmul : Equiv.Perm.finSumPerm σ τ =
        Equiv.Perm.finSumPerm σ 1 * Equiv.Perm.finSumPerm 1 τ := by
      rw [Equiv.Perm.finSumPerm_mul, mul_one, one_mul]
    rw [hmul]
    refine mul_mem ?_ ?_
    · have hsub : Set.range (fun i : Fin (k - 1) ↦ (⟨i, by omega⟩ : Fin (k + l - 1))) ⊆
          blockParabolicSet k l := by
        rintro _ ⟨i, rfl⟩
        exact Or.inl (by simp; omega)
      refine (permCoxeterSystem (k + l)).parabolic_mono hsub ?_
      rw [← (permCoxeterSystem k).range_parabolicHom
        (fun i j ↦ by simp only [coxeterMatrixA_apply, Fin.ext_iff]),
        ← Equiv.Perm.finSumPerm_inl_eq_parabolicHom]
      exact ⟨σ, by simp⟩
    · have hsub : Set.range (fun j : Fin (l - 1) ↦ (⟨k + j, by omega⟩ : Fin (k + l - 1))) ⊆
          blockParabolicSet k l := by
        rintro _ ⟨j, rfl⟩
        exact Or.inr (by simp)
      refine (permCoxeterSystem (k + l)).parabolic_mono hsub ?_
      rw [← (permCoxeterSystem l).range_parabolicHom
        (fun i j ↦ by simp only [coxeterMatrixA_apply, Fin.ext_iff]; split_ifs <;> omega),
        ← Equiv.Perm.finSumPerm_inr_eq_parabolicHom]
      exact ⟨τ, by simp⟩

/-- **Minimal coset representatives of `S_k × S_l` in `S_(k+l)` are the `(k, l)`-shuffles.** A
permutation `d` has minimal Coxeter length in `d · (S_k × S_l)` exactly when `d` is strictly
increasing on the first `k` letters and strictly increasing on the last `l` letters. -/
theorem isMinimalCosetRep_blockParabolicSet_iff {d : Equiv.Perm (Fin (k + l))} :
    (permCoxeterSystem (k + l)).IsMinimalCosetRep (blockParabolicSet k l) d ↔
      StrictMono (fun i : Fin k ↦ d (Fin.castAdd l i)) ∧
        StrictMono (fun j : Fin l ↦ d (Fin.natAdd k j)) := by
  rw [(permCoxeterSystem (k + l)).isMinimalCosetRep_iff]
  simp only [mem_blockParabolicSet, isRightDescent_permCoxeterSystem_iff, not_lt]
  refine ⟨fun h ↦ ⟨?_, ?_⟩, fun ⟨h₁, h₂⟩ i hi ↦ ?_⟩
  · rcases k with _ | k
    · exact Subsingleton.strictMono _
    · refine Fin.strictMono_iff_lt_succ.mpr fun i ↦ ?_
      let γ : Fin (k + 1 + l - 1) := ⟨i, by omega⟩
      have h₁ : Fin.castAdd l i.castSucc = strand γ := Fin.ext (by simp [γ])
      have h₂ : Fin.castAdd l i.succ = strandSucc γ := Fin.ext (by simp [γ])
      rw [h₁, h₂]
      exact lt_of_le_of_ne (h γ (Or.inl (by simp [γ])))
        (d.injective.ne (strand_ne_strandSucc γ))
  · rcases l with _ | l
    · exact Subsingleton.strictMono _
    · refine Fin.strictMono_iff_lt_succ.mpr fun j ↦ ?_
      let γ : Fin (k + (l + 1) - 1) := ⟨k + j, by omega⟩
      have h₁ : Fin.natAdd k j.castSucc = strand γ := Fin.ext (by simp [γ])
      have h₂ : Fin.natAdd k j.succ = strandSucc γ := Fin.ext (by simp [γ, Nat.add_assoc])
      rw [h₁, h₂]
      exact lt_of_le_of_ne (h γ (Or.inr (by simp [γ]))) (d.injective.ne (strand_ne_strandSucc γ))
  · rcases hi with hlt | hge
    · have hs₁ : strand i = Fin.castAdd l ⟨i, by omega⟩ := Fin.ext (by simp)
      have hs₂ : strandSucc i = Fin.castAdd l ⟨(i : ℕ) + 1, hlt⟩ := Fin.ext (by simp)
      rw [hs₁, hs₂]
      exact (h₁ (Fin.lt_def.mpr (Nat.lt_succ_self _))).le
    · have hs₁ : strand i = Fin.natAdd k ⟨(i : ℕ) - k, by omega⟩ :=
        Fin.ext (by simp [Nat.add_sub_of_le hge])
      have hs₂ : strandSucc i = Fin.natAdd k ⟨(i : ℕ) - k + 1, by omega⟩ :=
        Fin.ext (by simp; omega)
      rw [hs₁, hs₂]
      exact (h₂ (Fin.lt_def.mpr (Nat.lt_succ_self _))).le

/-- **A `(k, l)`-shuffle is uniquely determined by the image of the first `k` letters.** Two
minimal coset representatives of `S_k × S_l` whose inverses send the same positions into
`{0, …, k - 1}` are equal. -/
theorem eq_of_isMinimalCosetRep_blockParabolicSet {d₁ d₂ : Equiv.Perm (Fin (k + l))}
    (hd₁ : (permCoxeterSystem (k + l)).IsMinimalCosetRep (blockParabolicSet k l) d₁)
    (hd₂ : (permCoxeterSystem (k + l)).IsMinimalCosetRep (blockParabolicSet k l) d₂)
    (h : ∀ x : Fin (k + l), (d₁.symm x : ℕ) < k ↔ (d₂.symm x : ℕ) < k) :
    d₁ = d₂ := by
  refine hd₁.eq_of_inv_mul_mem (permCoxeterSystem (k + l)) hd₂ ?_
  rw [permCoxeterSystem_parabolic_blockParabolicSet, Equiv.Perm.mem_range_finSumPermHom_iff]
  intro x
  simpa [Equiv.Perm.inv_def] using h (d₂ x)

end TauCeti
