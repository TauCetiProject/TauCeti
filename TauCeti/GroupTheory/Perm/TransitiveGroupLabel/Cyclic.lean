module

public import TauCeti.GroupTheory.Perm.TransitiveGroupLabel.Basic
import TauCeti.GroupTheory.Perm.OrbitCount.FinRotate

/-!
# The cyclic reference permutation groups

In every degree `n` the first label `nT1` is the cyclic group `Cₙ`, acting regularly on
`Fin n` by rotation. In degrees three to five the reference subgroup is defined as the closure of
`finRotate n`, and in degrees one and two it is the whole symmetric group, which the rotation
also generates. We record this uniformly as `referenceSubgroup n ⟨0, _⟩ = zpowers (finRotate n)`
and identify the reference subgroup with `Multiplicative (ZMod n)`, the rotation corresponding to
`Multiplicative.ofAdd 1`. Every permutation group with label `nT1` is therefore abstractly
cyclic of order `n`.

## Main declarations

* `TauCeti.referenceSubgroup_zero_eq_zpowers`: the reference subgroup of `nT1` is generated by
  `finRotate n`.
* `TauCeti.referenceSubgroupZeroMulEquivZMod`: the reference subgroup of `nT1` is isomorphic to
  `Multiplicative (ZMod n)`, sending `finRotate n` to `Multiplicative.ofAdd 1`.
* `TauCeti.TransitiveGroupLabel.nonempty_mulEquiv_zmod`: a permutation group with label `nT1`
  is isomorphic to `Multiplicative (ZMod n)`.
-/

public section

open Equiv Equiv.Perm

namespace TauCeti

/-- The reference subgroup of the first label `nT1` is the cyclic group generated by the rotation
`finRotate n`, in every degree in which labels exist. -/
theorem referenceSubgroup_zero_eq_zpowers {n : ℕ} (h : 0 < numTransitiveGroups n) :
    referenceSubgroup n ⟨0, h⟩ = Subgroup.zpowers (finRotate n) := by
  match n, h with
  | 0, h => exact absurd h (by simp)
  | 1, _ => exact Subsingleton.elim _ _
  | 2, _ =>
    -- The symmetric group on two letters consists of the identity and the rotation.
    rw [referenceSubgroup_two, eq_comm, eq_top_iff]
    intro σ _
    have hσ : ∀ σ : Perm (Fin 2), σ = 1 ∨ σ = finRotate 2 := by decide
    obtain rfl | rfl := hσ σ
    exacts [Subgroup.one_mem _, Subgroup.mem_zpowers _]
  | 3, _ => rw [referenceSubgroup_three_zero, Subgroup.zpowers_eq_closure]
  | 4, _ => rw [referenceSubgroup_four_zero, Subgroup.zpowers_eq_closure]
  | 5, _ => rw [referenceSubgroup_five_zero, Subgroup.zpowers_eq_closure]
  | k + 6, h => exact absurd h (by simp)

/-- The rotation `finRotate n` lies in the reference subgroup of `nT1`. -/
theorem finRotate_mem_referenceSubgroup_zero {n : ℕ} (h : 0 < numTransitiveGroups n) :
    finRotate n ∈ referenceSubgroup n ⟨0, h⟩ := by
  rw [referenceSubgroup_zero_eq_zpowers]
  exact Subgroup.mem_zpowers _

/-- The reference subgroup of `nT1` is cyclic of order `n`: it is isomorphic to
`Multiplicative (ZMod n)`, with the rotation `finRotate n` corresponding to
`Multiplicative.ofAdd 1`. -/
noncomputable def referenceSubgroupZeroMulEquivZMod {n : ℕ} (h : 0 < numTransitiveGroups n) :
    referenceSubgroup n ⟨0, h⟩ ≃* Multiplicative (ZMod n) :=
  (zmodMulEquivOfGenerator (g := (⟨finRotate n, finRotate_mem_referenceSubgroup_zero h⟩ :
      referenceSubgroup n ⟨0, h⟩))
    (fun x ↦ by
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
        ((referenceSubgroup_zero_eq_zpowers h).le x.property)
      exact ⟨k, Subtype.ext hk⟩)
    (by
      rw [referenceSubgroup_zero_eq_zpowers, Nat.card_zpowers, orderOf_finRotate
        (pos_of_transitiveGroupIndex (⟨0, h⟩ : TransitiveGroupIndex n)).ne'])).symm

/-- The isomorphism `referenceSubgroupZeroMulEquivZMod` sends `Multiplicative.ofAdd k` to the
`k`-th power of the rotation. -/
@[simp]
theorem coe_referenceSubgroupZeroMulEquivZMod_symm_apply_ofAdd_intCast {n : ℕ}
    (h : 0 < numTransitiveGroups n) (k : ℤ) :
    ((referenceSubgroupZeroMulEquivZMod h).symm (Multiplicative.ofAdd (k : ZMod n)) :
      Perm (Fin n)) = finRotate n ^ k := by
  rw [referenceSubgroupZeroMulEquivZMod, MulEquiv.symm_symm,
    zmodMulEquivOfGenerator_apply_ofAdd_intCast, Subgroup.coe_zpow]

/-- The isomorphism `referenceSubgroupZeroMulEquivZMod` sends the rotation to
`Multiplicative.ofAdd 1`. -/
@[simp]
theorem referenceSubgroupZeroMulEquivZMod_apply_finRotate {n : ℕ}
    (h : 0 < numTransitiveGroups n) :
    referenceSubgroupZeroMulEquivZMod h ⟨finRotate n, finRotate_mem_referenceSubgroup_zero h⟩ =
      Multiplicative.ofAdd 1 := by
  rw [referenceSubgroupZeroMulEquivZMod, zmodMulEquivOfGenerator_symm_apply_generator]

/-- Every permutation group with label `nT1` is abstractly the cyclic group of order `n`. The
isomorphism depends on the conjugating permutation used to read the label. -/
theorem TransitiveGroupLabel.nonempty_mulEquiv_zmod {n : ℕ} {h : 0 < numTransitiveGroups n}
    {G : Subgroup (Perm (Fin n))} (hG : TransitiveGroupLabel ⟨0, h⟩ G) :
    Nonempty (G ≃* Multiplicative (ZMod n)) := by
  obtain ⟨e⟩ := hG.nonempty_mulEquiv_referenceSubgroup
  exact ⟨e.trans (referenceSubgroupZeroMulEquivZMod h)⟩

end TauCeti
