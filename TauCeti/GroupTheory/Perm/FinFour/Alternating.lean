module

public import TauCeti.GroupTheory.Perm.FinFour.Matching
public import Mathlib.Algebra.Group.TypeTags.Basic
public import Mathlib.Data.ZMod.Defs
import TauCeti.GroupTheory.Perm.FinThree.Alternating

/-!
# The alternating group `A₄` modulo its Klein four-group is `ℤ/3ℤ`

Let `q : S₄ →* S₃` be the action of `S₄` on the three perfect matchings `M₀ = 01|23`,
`M₁ = 03|12`, `M₂ = 02|13` of `Fin 4` (`TauCeti.symmetricGroupFourMatchingHom`). It sends
transpositions to transpositions, so it preserves the sign, and since it is surjective it maps the
alternating group `A₄` onto the alternating group `A₃`. The latter is cyclic of order three,
generated by the three-cycle `c = (0 1 2)` of the matchings
(`TauCeti.alternatingGroupFinThreeZModMulEquiv`), which is the image of the three-cycle
`(0 1 2)` of `Fin 4`. Reading off the exponent of `c` gives the homomorphism

`κ : A₄ →* Multiplicative (ZMod 3)`, `q g = c ^ κ(g)`,

which is surjective, sends `(0 1 2)` to `1`, and whose kernel is the Klein four-group
`alternatingGroup.kleinFour (Fin 4)`, the kernel of `q` read inside `A₄`. The one-dimensional
representations of `A₄` are the characters of `ℤ/3ℤ` pulled back along `κ`.

## Main definitions

* `TauCeti.alternatingGroupFourZModThreeHom`: the homomorphism `κ : A₄ →* Multiplicative (ZMod 3)`.

## Main results

* `TauCeti.sign_symmetricGroupFourMatchingHom`: `q` preserves the sign.
* `TauCeti.map_alternatingGroup_symmetricGroupFourMatchingHom`: `q(A₄) = A₃`.
* `TauCeti.symmetricGroupFourMatchingHom_coe_eq_pow`: `q g = c ^ κ(g)` for `g ∈ A₄`.
* `TauCeti.alternatingGroupFourZModThreeHom_eq_iff`: `κ` is characterized by this identity.
* `TauCeti.ker_alternatingGroupFourZModThreeHom`: the kernel of `κ` is the Klein four-group.
* `TauCeti.alternatingGroupFourZModThreeHom_surjective`: `κ` is surjective.

## References

* W. Fulton and J. Harris, *Representation Theory: A First Course*, Springer GTM 129 (1991),
  §2.3.
* G. James and M. Liebeck, *Representations and Characters of Groups*, Chapter 18.
-/

public section

namespace TauCeti

open Equiv

/-- **The action on matchings preserves the sign**: `sign ∘ q` is a surjective homomorphism
`S₄ →* ℤˣ`, and the sign is the only one. -/
theorem sign_symmetricGroupFourMatchingHom (σ : Perm (Fin 4)) :
    Perm.sign (symmetricGroupFourMatchingHom σ) = Perm.sign σ := by
  have h : Perm.sign.comp symmetricGroupFourMatchingHom = Perm.sign :=
    Perm.eq_sign_of_surjective_hom
      ((Perm.sign_surjective (Fin 3)).comp symmetricGroupFourMatchingHom_surjective)
  exact DFunLike.congr_fun h σ

/-- **The action on matchings maps `A₄` onto `A₃`**, since it preserves the sign and is
surjective. -/
theorem map_alternatingGroup_symmetricGroupFourMatchingHom :
    (alternatingGroup (Fin 4)).map symmetricGroupFourMatchingHom = alternatingGroup (Fin 3) := by
  ext τ
  simp only [Subgroup.mem_map, Perm.mem_alternatingGroup]
  constructor
  · rintro ⟨σ, hσ, rfl⟩
    rwa [sign_symmetricGroupFourMatchingHom]
  · intro hτ
    obtain ⟨σ, rfl⟩ := symmetricGroupFourMatchingHom_surjective τ
    exact ⟨σ, by rwa [sign_symmetricGroupFourMatchingHom] at hτ, rfl⟩

/-- **The homomorphism `κ : A₄ →* ℤ/3ℤ`**: for `g ∈ A₄`, the image `q g ∈ A₃` of `g` under the
action on the three perfect matchings is `c ^ κ(g)` for the three-cycle `c = (0 1 2)` of the
matchings (`TauCeti.symmetricGroupFourMatchingHom_coe_eq_pow`). Its kernel is the Klein
four-group. -/
noncomputable def alternatingGroupFourZModThreeHom :
    alternatingGroup (Fin 4) →* Multiplicative (ZMod 3) :=
  alternatingGroupFinThreeZModMulEquiv.symm.toMonoidHom.comp
    ((symmetricGroupFourMatchingHom.comp (alternatingGroup (Fin 4)).subtype).codRestrict
      (alternatingGroup (Fin 3)) fun g => by
        rw [← map_alternatingGroup_symmetricGroupFourMatchingHom]
        exact Subgroup.mem_map_of_mem _ g.2)

/-- `κ(g)` is the unique `r` with `q g = c ^ r` for the three-cycle `c = (0 1 2)` of the
matchings. -/
theorem alternatingGroupFourZModThreeHom_eq_iff {g : alternatingGroup (Fin 4)}
    {r : Multiplicative (ZMod 3)} :
    alternatingGroupFourZModThreeHom g = r ↔
      symmetricGroupFourMatchingHom g = [0, 1, 2].formPerm ^ (Multiplicative.toAdd r).val := by
  rw [← coe_alternatingGroupFinThreeZModMulEquiv, alternatingGroupFourZModThreeHom,
    MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_eq, Subtype.ext_iff]
  simp only [MonoidHom.codRestrict_apply, MonoidHom.comp_apply, Subgroup.coe_subtype]

/-- **The defining identity of `κ`**: an element `g` of `A₄` acts on the three perfect matchings
as the power `c ^ κ(g)` of the three-cycle `c = (0 1 2)`. -/
theorem symmetricGroupFourMatchingHom_coe_eq_pow (g : alternatingGroup (Fin 4)) :
    symmetricGroupFourMatchingHom g =
      [0, 1, 2].formPerm ^ (Multiplicative.toAdd (alternatingGroupFourZModThreeHom g)).val :=
  alternatingGroupFourZModThreeHom_eq_iff.1 rfl

/-- **The kernel of `κ` is the Klein four-group** `alternatingGroup.kleinFour (Fin 4)`: it is the
kernel of the action `q` on the three perfect matchings, read inside `A₄`. -/
theorem ker_alternatingGroupFourZModThreeHom :
    alternatingGroupFourZModThreeHom.ker = alternatingGroup.kleinFour (Fin 4) := by
  rw [alternatingGroupFourZModThreeHom,
    MonoidHom.ker_comp_of_injective _ _ alternatingGroupFinThreeZModMulEquiv.symm.injective,
    MonoidHom.ker_codRestrict, ← MonoidHom.comap_ker, ker_symmetricGroupFourMatchingHom,
    Subgroup.comap_map_eq_self_of_injective (alternatingGroup (Fin 4)).subtype_injective]

/-- **`κ` is surjective**: `A₄ / V₄ ≃ ℤ/3ℤ`. -/
theorem alternatingGroupFourZModThreeHom_surjective :
    Function.Surjective alternatingGroupFourZModThreeHom := by
  intro r
  obtain ⟨σ, hσ, hq⟩ := map_alternatingGroup_symmetricGroupFourMatchingHom.ge
    (alternatingGroupFinThreeZModMulEquiv r).2
  exact ⟨⟨σ, hσ⟩, alternatingGroupFourZModThreeHom_eq_iff.2
    (hq.trans (coe_alternatingGroupFinThreeZModMulEquiv r))⟩

end TauCeti
