module

public import TauCeti.GroupTheory.Coset.Enumeration
import TauCeti.GroupTheory.Coset.Basic

/-!
# Replaying unlabeled coset enumeration over an arbitrary subgroup

Let `G` be a group generated by `x₀, …, x_{n-1}` and let `H ≤ G` be a subgroup containing the
values of a list `subs` of words in the generators. Unlabeled coset enumeration over `H`
(Todd–Coxeter without subgroup-element tracking) builds a table of *points* `p`, each standing for
an element `w_p ∈ G`, together with *edges* and *coincidences* recording coset equalities in
`G ⧸ H`:

```text
g_t * w_j H = w_q H,        w_j H = w_i H,
```

where `g_t` is a generator or the inverse of one. Unlike `TauCeti.CosetEnumeration`, no subgroup
exponents are stored, so the subgroup `H` may have arbitrarily many generators (or be trivial) and
each table field uses half as many bits (`32` instead of `64`).

A replay certificate serves two purposes under the same invariant:

1. **Word membership and relator derivation** (`TauCeti.SubgroupEnumeration.checkWords` and
   `TauCeti.SubgroupEnumeration.checkRelators`): even before the table closes, if walking a word
   `w` from the point `0` returns to the representative of `0`, then `wordValue x w ∈ H`. When
   `H = ⊥` and `subs = []`, walking `w` from *any* point `i` back to the representative of `i`
   certifies `wordValue x w = 1`, which allows deriving intermediate relators from compact local
   subgraphs before a full enumeration.
2. **Subgroup index bounds** (`TauCeti.SubgroupEnumeration.run`): when the table closes, every
   generator permutes the cosets `w_p H` of the surviving points, so they cover `G ⧸ H`. Thus
   `H.FiniteIndex` holds and `H.index ≤ k` for the number `k` of surviving points.

The replay engine (`CosetEnumeration.State`, `CosetEnumeration.Scheme.replay`), signed-letter
conventions (`CosetEnumeration.invLetter`, `letter`, `signedLetter`, `wordValue`, `rotations`), and
soundness invariant are shared with `TauCeti.CosetEnumeration`, instantiated with the `32`-bit
trivial-label scheme `TauCeti.SubgroupEnumeration.unlabeledScheme`.

## Main definitions

* `TauCeti.SubgroupEnumeration.unlabeledScheme`: the `32`-bit replay scheme with trivial labels.
* `TauCeti.SubgroupEnumeration.checkWords`: replay a certificate and check that every target word
  closes at the point `0`.
* `TauCeti.SubgroupEnumeration.checkRelators`: replay a certificate with no subgroup generators and
  check that each target word closes at its specified base point.
* `TauCeti.SubgroupEnumeration.run`: replay a certificate and, if the table closes, return the
  number of surviving points.

## Main results

* `TauCeti.SubgroupEnumeration.wordValue_mem_of_checkWords`: a checked replay certifies
  `wordValue x w ∈ H` for every target word `w`.
* `TauCeti.SubgroupEnumeration.wordValue_eq_one_of_checkRelators`: with no subgroup generators, a
  checked replay certifies `wordValue x w = 1` for every `(i, w)` in the target list.
* `TauCeti.SubgroupEnumeration.finiteIndex_of_run` and
  `TauCeti.SubgroupEnumeration.index_le_of_run`: a closed replay with `k` surviving points proves
  `H.FiniteIndex` and `H.index ≤ k`.
* `TauCeti.GroupPresentation.wordValue_mem_of_checkWords`,
  `TauCeti.GroupPresentation.wordValue_eq_one_of_checkRelators`,
  `TauCeti.GroupPresentation.finiteIndex_of_run`, and
  `TauCeti.GroupPresentation.index_le_of_run`: the corresponding interfaces for the group defined
  by a `TauCeti.GroupPresentation`.

## References

* J. A. Todd and H. S. M. Coxeter, *A practical method for enumerating cosets of a finite abstract
  group*, Proc. Edinburgh Math. Soc. **5** (1936), 26–34.
* D. F. Holt, B. Eick and E. A. O'Brien, *Handbook of Computational Group Theory*, Chapman &
  Hall/CRC (2005), Chapter 5.
* G. Havas, *Coset enumeration strategies*, Proc. ISSAC '91, 191–199.
-/

public section

namespace TauCeti.SubgroupEnumeration

open CosetEnumeration

/-! ### Unlabeled replay scheme and entry points -/

/-- The `32`-bit replay scheme for unlabeled coset enumeration over an arbitrary subgroup, storing
no subgroup-element labels (`Unit`) or global accumulator (`Unit`). -/
@[expose]
def unlabeledScheme : Scheme Unit Unit where
  width := 32
  encode q _ := q + 1
  decode
    | 0 => none
    | q + 1 => some (q, ())
  canEncode _ _ := true
  zero := ()
  add _ _ := ()
  neg _ := ()
  sub _ _ := ()
  subLabel := ()
  onSelf _ _ := ()
  force _ := 0

/-- **Replay and check word closure at `0`.** Replay `parents` and `steps` for the relators `rels`
and subgroup words `subs` in `n` generators, then check that every word in `ws` walks from `0` back
to the representative of `0`. The table need not close. -/
@[expose]
def checkWords (n : ℕ) (rels subs ws : List (List ℕ)) (parents steps : List ℕ) : Bool :=
  let st := unlabeledScheme.replay n rels subs () parents steps
  ws.all (st.closesAt unlabeledScheme (2 * n) 0)

/-- **Replay and check relator closure at specified points.** Replay `parents` and `steps` for the
relators `rels` with no subgroup generators in `n` generators, then check that each pair `(i, w)`
in `ws` walks `w` from `i` back to the representative of `i`. The table need not close. -/
@[expose]
def checkRelators (n : ℕ) (rels : List (List ℕ)) (ws : List (ℕ × List ℕ))
    (parents steps : List ℕ) : Bool :=
  let st := unlabeledScheme.replay n rels [] () parents steps
  ws.all fun iw ↦ st.closesAt unlabeledScheme (2 * n) iw.1 iw.2

/-- **Replay of unlabeled coset enumeration** over a subgroup containing the values of `subs`, for
the relators `rels` in `n` generators. The `p`-th entry `c` of `parents` defines the point `p + 1`
as `g_t * w_j` with `t = c % (2 * n)` and `j = c / (2 * n)`, and `steps` is the list of step codes
of `TauCeti.CosetEnumeration.State.step`. A closed replay returns the number of surviving
points. -/
@[expose]
def run (n : ℕ) (rels subs : List (List ℕ)) (parents steps : List ℕ) : Option ℕ :=
  ((unlabeledScheme.replay n rels subs () parents steps).result unlabeledScheme (2 * n)).map
    Prod.fst

/-! ### Soundness -/

section Soundness

private def unlabeledInterp {G : Type*} [Group G] (H : Subgroup G) :
    Interp unlabeledScheme G (G ⧸ H) where
  actR y _ := y
  extraOk _ := True
  decode_zero := rfl
  decode_encode {_ e} _ _ := by cases e; rfl
  actR_zero _ := rfl
  actR_add _ _ _ := rfl
  actR_add_neg _ _ := rfl
  sub_eq _ _ := rfl
  smul_actR _ _ _ := rfl
  onSelf_ok _ _ := trivial

private theorem unlabeledInterp_sub {G : Type*} [Group G] {n : ℕ} {x : Fin n → G}
    {H : Subgroup G} {subs : List (List ℕ)} (hsubs : ∀ s ∈ subs, wordValue x s ∈ H) :
    ∀ s ∈ subs,
      wordValue x s • (QuotientGroup.mk 1 : G ⧸ H) =
        (unlabeledInterp H).actR (QuotientGroup.mk 1) unlabeledScheme.subLabel := fun s hs ↦ by
  rw [MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
  exact QuotientGroup.mk_eq_one_iff.mpr (hsubs s hs)

private theorem closesAt_coset {G : Type*} [Group G] {n : ℕ} {x : Fin n → G} {H : Subgroup G}
    {rels subs : List (List ℕ)} {parents steps : List ℕ}
    (hrels : ∀ r ∈ rels, wordValue x r = 1) (hsubs : ∀ s ∈ subs, wordValue x s ∈ H)
    {i : ℕ} {w : List ℕ}
    (hw : (unlabeledScheme.replay n rels subs () parents steps).closesAt unlabeledScheme (2 * n)
      i w = true) :
    (pt x parents i)⁻¹ * wordValue x w * pt x parents i ∈ H := by
  obtain ⟨r, _, _, hw1, hw2⟩ :=
    closesAt_of_runSteps (unlabeledInterp H) hrels (unlabeledInterp_sub hsubs) trivial hw
  have hmk : (QuotientGroup.mk (wordValue x w * pt x parents i) : G ⧸ H) =
      QuotientGroup.mk (pt x parents i) := by
    have heq := hw1.trans hw2.symm
    simpa [unlabeledInterp, MulAction.Quotient.smul_mk, smul_eq_mul, mul_one] using heq
  simpa [mul_assoc] using QuotientGroup.eq.mp hmk.symm

end Soundness

section Main

variable {G : Type*} [Group G] {n : ℕ} {x : Fin n → G} {H : Subgroup G}
  {rels subs ws : List (List ℕ)} {parents steps : List ℕ} {k : ℕ}

/-- **Word membership from a partial replay.** If the relators `rels` hold and every word in `subs`
evaluates into `H`, then every word in `ws` that closes at `0` in the replayed table also evaluates
into `H`. Neither generation by `x` nor table closure is required. -/
theorem wordValue_mem_of_checkWords (hrels : ∀ r ∈ rels, wordValue x r = 1)
    (hsubs : ∀ s ∈ subs, wordValue x s ∈ H)
    (hcheck : checkWords n rels subs ws parents steps = true) :
    ∀ w ∈ ws, wordValue x w ∈ H := by
  intro w hw
  have hmem := closesAt_coset hrels hsubs (List.all_eq_true.mp hcheck w hw)
  simpa [pt_zero] using hmem

/-- **Relator derivation from a partial replay.** If the relators `rels` hold, then every pair
`(i, w)` in `ws` for which `w` closes at the point `i` in a replay with no subgroup generators
satisfies `wordValue x w = 1`. Neither generation by `x` nor table closure is required. -/
theorem wordValue_eq_one_of_checkRelators {ws : List (ℕ × List ℕ)}
    (hrels : ∀ r ∈ rels, wordValue x r = 1)
    (hcheck : checkRelators n rels ws parents steps = true) :
    ∀ iw ∈ ws, wordValue x iw.2 = 1 := by
  intro iw hiw
  have hmem : (pt x parents iw.1)⁻¹ * wordValue x iw.2 * pt x parents iw.1 = 1 :=
    Subgroup.mem_bot.mp (closesAt_coset (H := (⊥ : Subgroup G)) hrels (by simp)
      (List.all_eq_true.mp hcheck iw hiw))
  exact (conj_eq_one_iff (a := (pt x parents iw.1)⁻¹)).mp (by simpa only [inv_inv] using hmem)

private theorem surjective_of_run (hx : Subgroup.closure (Set.range x) = ⊤)
    (hrels : ∀ r ∈ rels, wordValue x r = 1) (hsubs : ∀ s ∈ subs, wordValue x s ∈ H)
    (hrun : run n rels subs parents steps = some k) :
    ∃ f : Fin k → G ⧸ H, Function.Surjective f := by
  obtain ⟨⟨k', _⟩, hres, rfl⟩ := Option.map_eq_some_iff.mp hrun
  exact surjective_of_result (unlabeledInterp H) hx H hrels (unlabeledInterp_sub hsubs) trivial hres
    fun h ↦ by simpa [unlabeledInterp, MulAction.Quotient.smul_mk, smul_eq_mul, mul_one] using h

/-- A closed unlabeled replay shows that any subgroup containing the values of `subs` has finite
index. -/
theorem finiteIndex_of_run (hx : Subgroup.closure (Set.range x) = ⊤)
    (hrels : ∀ r ∈ rels, wordValue x r = 1) (hsubs : ∀ s ∈ subs, wordValue x s ∈ H)
    (hrun : run n rels subs parents steps = some k) :
    H.FiniteIndex :=
  let ⟨_, hf⟩ := surjective_of_run hx hrels hsubs hrun
  H.finiteIndex_of_surjective hf

/-- **Subgroup index bound from unlabeled coset enumeration.** If the generators `x` generate `G`,
the relators `rels` hold, and every word in `subs` evaluates into `H`, then a closed replay with
`k` surviving points certifies `H.index ≤ k`. -/
theorem index_le_of_run (hx : Subgroup.closure (Set.range x) = ⊤)
    (hrels : ∀ r ∈ rels, wordValue x r = 1) (hsubs : ∀ s ∈ subs, wordValue x s ∈ H)
    (hrun : run n rels subs parents steps = some k) :
    H.index ≤ k :=
  let ⟨_, hf⟩ := surjective_of_run hx hrels hsubs hrun
  (H.index_le_of_surjective hf).trans_eq (Nat.card_fin k)

end Main

section Presentation

/-- **Word membership for a presented group.** A partial replay over the compiled relators of `P`
and subgroup words `subs` certifies that every checked word evaluates into any subgroup `H`
containing the values of `subs`. -/
theorem _root_.TauCeti.GroupPresentation.wordValue_mem_of_checkWords (P : GroupPresentation)
    {H : Subgroup P.Group} {subs ws : List (List ℕ)} {parents steps : List ℕ}
    (hsubs : ∀ s ∈ subs, wordValue (PresentedGroup.of (rels := P.relatorSet)) s ∈ H)
    (hcheck : checkWords P.generatorCount (P.relatorLetters.map (List.map signedLetter)) subs ws
      parents steps = true) :
    ∀ w ∈ ws, wordValue (PresentedGroup.of (rels := P.relatorSet)) w ∈ H :=
  SubgroupEnumeration.wordValue_mem_of_checkWords P.wordValue_relatorLetters_eq_one hsubs hcheck

/-- **Relator derivation for a presented group.** A partial replay over the compiled relators of
`P` with no subgroup generators certifies that every checked `(i, w)` satisfies
`wordValue PresentedGroup.of w = 1` in `P.Group`. -/
theorem _root_.TauCeti.GroupPresentation.wordValue_eq_one_of_checkRelators (P : GroupPresentation)
    {ws : List (ℕ × List ℕ)} {parents steps : List ℕ}
    (hcheck : checkRelators P.generatorCount (P.relatorLetters.map (List.map signedLetter)) ws
      parents steps = true) :
    ∀ iw ∈ ws, wordValue (PresentedGroup.of (rels := P.relatorSet)) iw.2 = 1 :=
  SubgroupEnumeration.wordValue_eq_one_of_checkRelators P.wordValue_relatorLetters_eq_one hcheck

/-- A closed unlabeled replay over the compiled relators of `P` shows that any subgroup of
`P.Group` containing the values of `subs` has finite index. -/
theorem _root_.TauCeti.GroupPresentation.finiteIndex_of_run (P : GroupPresentation)
    {H : Subgroup P.Group} {subs : List (List ℕ)} {parents steps : List ℕ} {k : ℕ}
    (hsubs : ∀ s ∈ subs, wordValue (PresentedGroup.of (rels := P.relatorSet)) s ∈ H)
    (hrun : run P.generatorCount (P.relatorLetters.map (List.map signedLetter)) subs parents steps =
      some k) :
    H.FiniteIndex :=
  SubgroupEnumeration.finiteIndex_of_run (PresentedGroup.closure_range_of _)
    P.wordValue_relatorLetters_eq_one hsubs hrun

/-- **Subgroup index bound for a presented group.** A closed unlabeled replay over the compiled
relators of `P` with `k` surviving points certifies `H.index ≤ k` for any subgroup `H` containing
the values of `subs`. -/
theorem _root_.TauCeti.GroupPresentation.index_le_of_run (P : GroupPresentation)
    {H : Subgroup P.Group} {subs : List (List ℕ)} {parents steps : List ℕ} {k : ℕ}
    (hsubs : ∀ s ∈ subs, wordValue (PresentedGroup.of (rels := P.relatorSet)) s ∈ H)
    (hrun : run P.generatorCount (P.relatorLetters.map (List.map signedLetter)) subs parents steps =
      some k) :
    H.index ≤ k :=
  SubgroupEnumeration.index_le_of_run (PresentedGroup.closure_range_of _)
    P.wordValue_relatorLetters_eq_one hsubs hrun

end Presentation

end TauCeti.SubgroupEnumeration
