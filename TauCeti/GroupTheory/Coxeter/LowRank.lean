module

public import Mathlib.GroupTheory.Coxeter.Length
public import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# Rank-one and rank-two Coxeter groups

A Coxeter system indexed by a singleton (`Unique B`) has only one simple reflection, so length
parity identifies its group with `Multiplicative (ZMod 2)` of order `2`. A Coxeter system indexed
by `Fin 2` with matrix `M` is generated by two involutions whose product satisfies
`(s 0 * s 1) ^ M 0 1 = 1`; its universal property identifies `M.Group` (and hence any Coxeter
system for `M`) with Mathlib's `DihedralGroup (M 0 1)` — both when `0 < M 0 1` (finite dihedral
group of order `2 * M 0 1`) and when `M 0 1 = 0` (`DihedralGroup 0`, the infinite dihedral group).

## Main definitions

* `CoxeterSystem.uniqueEquivZModTwo`: `W ≃* Multiplicative (ZMod 2)` for `[Unique B]`.
* `CoxeterMatrix.finTwoGroupEquivDihedralGroup`: `M.Group ≃* DihedralGroup (M 0 1)` for
  `M : CoxeterMatrix (Fin 2)`.
* `CoxeterSystem.finTwoEquivDihedralGroup`: `W ≃* DihedralGroup (M 0 1)` for
  `cs : CoxeterSystem M W` on `Fin 2`.

## Main results

* `CoxeterSystem.natCard_of_unique`: `Nat.card W = 2` for `[Unique B]`.
* `CoxeterSystem.natCard_of_fin_two`: `Nat.card W = 2 * M 0 1` for `Fin 2` (including `0` when
  `M 0 1 = 0`).
-/

public section

namespace CoxeterMatrix

section DihedralLift

variable {G : Type*} [Group G] {s₀ s₁ : G} {n : ℕ}

private def dihedralRotHom (hn : (s₀ * s₁) ^ n = 1) : ZMod n →+ Additive G :=
  ZMod.lift n ⟨zmultiplesHom (Additive G) (Additive.ofMul (s₀ * s₁)), by
    rw [zmultiplesHom_apply, ← ofMul_zpow, zpow_natCast, hn, ofMul_one]⟩

private theorem inv_mul_dihedralRotHom_mul (hs₀ : s₀ * s₀ = 1) (hs₁ : s₁ * s₁ = 1)
    (hn : (s₀ * s₁) ^ n = 1) (i : ZMod n) :
    s₀ * Additive.toMul (dihedralRotHom hn i) * s₀ =
      Additive.toMul (dihedralRotHom hn (-i)) := by
  obtain ⟨m, rfl⟩ := ZMod.intCast_surjective i
  have hs₀_inv : s₀⁻¹ = s₀ := inv_eq_of_mul_eq_one_right hs₀
  have hs₁_inv : s₁⁻¹ = s₁ := inv_eq_of_mul_eq_one_right hs₁
  have hsemi : SemiconjBy s₀ (s₀ * s₁) ((s₀ * s₁)⁻¹) := by
    rw [SemiconjBy, mul_inv_rev, hs₀_inv, hs₁_inv, ← mul_assoc s₀, hs₀, one_mul, mul_assoc, hs₀,
      mul_one]
  have hz := (hsemi.zpow_right m).eq
  rw [inv_zpow, ← zpow_neg] at hz
  have hneg : (-(m : ZMod n)) = ((-m : ℤ) : ZMod n) := (Int.cast_neg m).symm
  rw [hneg, dihedralRotHom, ZMod.lift_coe, ZMod.lift_coe]
  simp only [zmultiplesHom_apply, toMul_zsmul, toMul_ofMul]
  rw [hz, mul_assoc, hs₀, mul_one]

private def dihedralToGroupFun (s₀ : G) (hn : (s₀ * s₁) ^ n = 1) : DihedralGroup n → G
  | .r i => Additive.toMul (dihedralRotHom hn i)
  | .sr i => s₀ * Additive.toMul (dihedralRotHom hn i)

private def dihedralToGroupHom (hs₀ : s₀ * s₀ = 1) (hs₁ : s₁ * s₁ = 1)
    (hn : (s₀ * s₁) ^ n = 1) : DihedralGroup n →* G where
  toFun := dihedralToGroupFun s₀ hn
  map_one' := by
    rw [DihedralGroup.one_def, dihedralToGroupFun, map_zero]
    rfl
  map_mul' := by
    have hg_add (i j : ZMod n) :
        Additive.toMul (dihedralRotHom hn (i + j)) =
          Additive.toMul (dihedralRotHom hn i) * Additive.toMul (dihedralRotHom hn j) := by
      rw [map_add, toMul_add]
    rintro (i | i) (j | j)
    · exact hg_add i j
    · simp only [DihedralGroup.r_mul_sr, dihedralToGroupFun]
      have hneg := inv_mul_dihedralRotHom_mul hs₀ hs₁ hn (-i)
      rw [neg_neg] at hneg
      rw [sub_eq_add_neg, add_comm j (-i), hg_add, ← hneg, mul_assoc (s₀ * _), ← mul_assoc s₀ s₀,
        hs₀, one_mul, ← mul_assoc]
    · simp only [DihedralGroup.sr_mul_r, dihedralToGroupFun]
      rw [hg_add, mul_assoc]
    · simp only [DihedralGroup.sr_mul_sr, dihedralToGroupFun]
      rw [sub_eq_add_neg, add_comm j (-i), hg_add, ← inv_mul_dihedralRotHom_mul hs₀ hs₁ hn i,
        mul_assoc, mul_assoc]

private theorem dihedralToGroupHom_sr_zero (hs₀ : s₀ * s₀ = 1) (hs₁ : s₁ * s₁ = 1)
    (hn : (s₀ * s₁) ^ n = 1) :
    dihedralToGroupHom hs₀ hs₁ hn (.sr 0) = s₀ := by
  simp [dihedralToGroupHom, dihedralToGroupFun]

private theorem dihedralToGroupHom_sr_one (hs₀ : s₀ * s₀ = 1) (hs₁ : s₁ * s₁ = 1)
    (hn : (s₀ * s₁) ^ n = 1) :
    dihedralToGroupHom hs₀ hs₁ hn (.sr 1) = s₁ := by
  have hcast : (1 : ZMod n) = ((1 : ℤ) : ZMod n) := Int.cast_one.symm
  simp only [dihedralToGroupHom, MonoidHom.coe_mk, OneHom.coe_mk, dihedralToGroupFun]
  rw [hcast, dihedralRotHom, ZMod.lift_coe]
  simp only [zmultiplesHom_apply, one_zsmul, toMul_ofMul, ← mul_assoc, hs₀, one_mul]

private theorem comp_dihedralToGroupHom (φ : G →* DihedralGroup n)
    (hφ₀ : φ s₀ = .sr 0) (hφ₁ : φ s₁ = .sr 1)
    (hs₀ : s₀ * s₀ = 1) (hs₁ : s₁ * s₁ = 1) (hn : (s₀ * s₁) ^ n = 1) :
    φ.comp (dihedralToGroupHom hs₀ hs₁ hn) = MonoidHom.id (DihedralGroup n) := by
  have hrot (i : ZMod n) : φ (Additive.toMul (dihedralRotHom hn i)) = .r i := by
    obtain ⟨m, rfl⟩ := ZMod.intCast_surjective i
    rw [dihedralRotHom, ZMod.lift_coe]
    simp only [zmultiplesHom_apply, toMul_zsmul, toMul_ofMul, map_zpow, map_mul, hφ₀, hφ₁,
      DihedralGroup.sr_mul_sr, sub_zero, DihedralGroup.r_one_zpow]
  refine MonoidHom.ext fun x ↦ ?_
  rcases x with i | i
  · exact hrot i
  · simp only [MonoidHom.comp_apply, MonoidHom.id_apply, dihedralToGroupHom, MonoidHom.coe_mk,
      OneHom.coe_mk, dihedralToGroupFun, map_mul, hφ₀, hrot i, DihedralGroup.sr_mul_r, zero_add]

end DihedralLift

private def finTwoSrFun (n : ℕ) (i : Fin 2) : DihedralGroup n :=
  if i = 0 then .sr 0 else .sr 1

private theorem isLiftable_finTwoSrFun (M : CoxeterMatrix (Fin 2)) :
    M.IsLiftable (finTwoSrFun (M 0 1)) := by
  have h10 : (1 : Fin 2) ≠ 0 := by decide
  refine Fin.forall_fin_two.mpr ⟨Fin.forall_fin_two.mpr ⟨?_, ?_⟩, Fin.forall_fin_two.mpr ⟨?_, ?_⟩⟩
  · simp [finTwoSrFun]
  · simp [finTwoSrFun, h10]
  · rw [M.symmetric 1 0]
    have hinv : (finTwoSrFun (M 0 1) 1 * finTwoSrFun (M 0 1) 0) =
        (DihedralGroup.r 1)⁻¹ := by simp [finTwoSrFun, h10]
    rw [hinv, inv_pow, DihedralGroup.r_one_pow_n, inv_one]
  · simp [finTwoSrFun]

private def finTwoToDihedralGroup (M : CoxeterMatrix (Fin 2)) :
    M.Group →* DihedralGroup (M 0 1) :=
  M.toCoxeterSystem.lift ⟨finTwoSrFun (M 0 1), isLiftable_finTwoSrFun M⟩

private theorem finTwoToDihedralGroup_simple_zero (M : CoxeterMatrix (Fin 2)) :
    M.finTwoToDihedralGroup (M.simple 0) = DihedralGroup.sr 0 :=
  M.toCoxeterSystem.lift_apply_simple _ 0

private theorem finTwoToDihedralGroup_simple_one (M : CoxeterMatrix (Fin 2)) :
    M.finTwoToDihedralGroup (M.simple 1) = DihedralGroup.sr 1 :=
  M.toCoxeterSystem.lift_apply_simple _ 1

/-- **A rank-two presented Coxeter group `M.Group` is isomorphic to `DihedralGroup (M 0 1)`.**
When `M 0 1 = 0`, `DihedralGroup 0` is the infinite dihedral group. -/
def finTwoGroupEquivDihedralGroup (M : CoxeterMatrix (Fin 2)) :
    M.Group ≃* DihedralGroup (M 0 1) :=
  have hs₀ : M.simple 0 * M.simple 0 = 1 := M.toCoxeterSystem.simple_mul_simple_self 0
  have hs₁ : M.simple 1 * M.simple 1 = 1 := M.toCoxeterSystem.simple_mul_simple_self 1
  have hn : (M.simple 0 * M.simple 1) ^ M 0 1 = 1 := M.toCoxeterSystem.simple_mul_simple_pow 0 1
  MonoidHom.toMulEquiv M.finTwoToDihedralGroup (dihedralToGroupHom hs₀ hs₁ hn)
    (M.toCoxeterSystem.ext_simple <| Fin.forall_fin_two.mpr
      ⟨by rw [CoxeterMatrix.toCoxeterSystem_simple, MonoidHom.comp_apply,
            M.finTwoToDihedralGroup_simple_zero, dihedralToGroupHom_sr_zero, MonoidHom.id_apply],
        by rw [CoxeterMatrix.toCoxeterSystem_simple, MonoidHom.comp_apply,
            M.finTwoToDihedralGroup_simple_one, dihedralToGroupHom_sr_one, MonoidHom.id_apply]⟩)
    (comp_dihedralToGroupHom M.finTwoToDihedralGroup M.finTwoToDihedralGroup_simple_zero
      M.finTwoToDihedralGroup_simple_one hs₀ hs₁ hn)

@[simp]
theorem finTwoGroupEquivDihedralGroup_simple_zero (M : CoxeterMatrix (Fin 2)) :
    M.finTwoGroupEquivDihedralGroup (M.simple 0) = DihedralGroup.sr 0 :=
  M.finTwoToDihedralGroup_simple_zero

@[simp]
theorem finTwoGroupEquivDihedralGroup_simple_one (M : CoxeterMatrix (Fin 2)) :
    M.finTwoGroupEquivDihedralGroup (M.simple 1) = DihedralGroup.sr 1 :=
  M.finTwoToDihedralGroup_simple_one

end CoxeterMatrix

namespace CoxeterSystem

section Unique

variable {B W : Type*} [Unique B] [Group W] {M : CoxeterMatrix B} (cs : CoxeterSystem M W)

private def zmodTwoToCoxeter : Multiplicative (ZMod 2) →* W where
  toFun x := if Multiplicative.toAdd x = 0 then 1 else cs.simple default
  map_one' := rfl
  map_mul' x y := by
    have h2 (a : ZMod 2) : a = 0 ∨ a = 1 := by revert a; decide
    rw [toAdd_mul]
    rcases h2 (Multiplicative.toAdd x) with hx | hx <;>
      rcases h2 (Multiplicative.toAdd y) with hy | hy <;>
      rw [hx, hy]
    · simp
    · simp
    · simp
    · have h11 : (1 + 1 : ZMod 2) = 0 := by decide
      have h10 : (1 : ZMod 2) ≠ 0 := by decide
      simp [h11, h10]

/-- **A rank-one Coxeter system is isomorphic to `Multiplicative (ZMod 2)` via length parity.** -/
def uniqueEquivZModTwo : W ≃* Multiplicative (ZMod 2) :=
  have h10 : (1 : ZMod 2) ≠ 0 := by decide
  MonoidHom.toMulEquiv cs.lengthParity cs.zmodTwoToCoxeter
    (cs.ext_simple fun i ↦ by
      rw [Subsingleton.elim i default]
      simp [zmodTwoToCoxeter, cs.lengthParity_simple, h10])
    (MonoidHom.ext fun x ↦ by
      have h2 (a : ZMod 2) : a = 0 ∨ a = 1 := by revert a; decide
      rcases h2 (Multiplicative.toAdd x) with hx | hx
      · have hx0 : x = Multiplicative.ofAdd 0 := Multiplicative.toAdd.injective hx
        rw [hx0]
        simp [zmodTwoToCoxeter]
      · have hx1 : x = Multiplicative.ofAdd 1 := Multiplicative.toAdd.injective hx
        rw [hx1, MonoidHom.comp_apply, MonoidHom.id_apply]
        simp [zmodTwoToCoxeter, h10, cs.lengthParity_simple])

include cs in
theorem natCard_of_unique : Nat.card W = 2 := by
  rw [Nat.card_congr cs.uniqueEquivZModTwo.toEquiv, Nat.card_congr Multiplicative.toAdd,
    Nat.card_zmod]

end Unique

section FinTwo

variable {W : Type*} [Group W] {M : CoxeterMatrix (Fin 2)} (cs : CoxeterSystem M W)

/-- **Any Coxeter system on `Fin 2` is isomorphic to `DihedralGroup (M 0 1)`.** -/
def finTwoEquivDihedralGroup : W ≃* DihedralGroup (M 0 1) :=
  cs.mulEquiv.trans M.finTwoGroupEquivDihedralGroup

@[simp]
theorem finTwoEquivDihedralGroup_simple_zero :
    cs.finTwoEquivDihedralGroup (cs.simple 0) = DihedralGroup.sr 0 := by
  simp [finTwoEquivDihedralGroup]

@[simp]
theorem finTwoEquivDihedralGroup_simple_one :
    cs.finTwoEquivDihedralGroup (cs.simple 1) = DihedralGroup.sr 1 := by
  simp [finTwoEquivDihedralGroup]

include cs in
/-- **Cardinality of a rank-two Coxeter group**: `2 * M 0 1` in general (which evaluates to `0`
when `M 0 1 = 0`, matching `Nat.card` of the infinite dihedral group `DihedralGroup 0`). -/
theorem natCard_of_fin_two : Nat.card W = 2 * M 0 1 := by
  rw [Nat.card_congr cs.finTwoEquivDihedralGroup.toEquiv, DihedralGroup.nat_card]

end FinTwo

end CoxeterSystem
