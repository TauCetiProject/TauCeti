module

public import TauCeti.GroupTheory.Coxeter.StrongExchange

/-!
# Standard parabolic subgroups and minimal coset representatives

Let `cs : CoxeterSystem M W` be a Coxeter system with simple reflections indexed by `B`. For a set
`J ⊆ B` the **standard parabolic subgroup** `cs.parabolic J` is the subgroup of `W` generated by
the simple reflections `s i` with `i ∈ J`. Its elements are exactly those spelled by words all of
whose letters lie in `J` (`CoxeterSystem.mem_parabolic_iff_exists_wordProd_eq`), and the word may
be taken reduced. The first substantive statement here is that a *reduced* word for an element of
`cs.parabolic J` never leaves the subgroup: each of its letters spells a simple reflection already
in `cs.parabolic J` (`CoxeterSystem.simple_mem_parabolic_of_isReduced`).

The main theorem is the **factorization of `W` along a standard parabolic subgroup**. Call `u` a
*minimal coset representative* when it has minimal length in its own left coset
`u · cs.parabolic J`. Then:

* multiplying a minimal coset representative by a parabolic element adds lengths,
  `ℓ (u * v) = ℓ u + ℓ v` (`CoxeterSystem.length_mul_of_isMinimalCosetRep`);
* `u` is a minimal coset representative exactly when no `i ∈ J` is a right descent of `u`
  (`CoxeterSystem.isMinimalCosetRep_iff`);
* every `w : W` factors uniquely as `w = u * v` with `u` a minimal coset representative and
  `v ∈ cs.parabolic J` (`CoxeterSystem.existsUnique_isMinimalCosetRep_mul`), and the two lengths
  then add by the first item.

Everything is proved from the exchange condition in
`TauCeti/GroupTheory/Coxeter/StrongExchange.lean`: no geometric representation, no finiteness
hypothesis, and no appeal to Matsumoto's theorem. The length-additivity argument is the classical
one: in a reduced word `α ++ ω'` whose halves spell a minimal representative and a parabolic
element, deleting a letter of `α` produces a shorter representative of the same coset, while
deleting a letter of `ω'` contradicts reducedness on the parabolic side.

Membership of `u` in the left coset of `w` is spelled `u⁻¹ * w ∈ cs.parabolic J` throughout, rather
than through a coset type, so that the statements compose directly with the length API.

## Main definitions

* `CoxeterSystem.parabolic`: the standard parabolic subgroup attached to a set of indices.
* `CoxeterSystem.IsMinimalCosetRep`: having minimal length in one's own left coset of a standard
  parabolic subgroup.

## Main results

* `CoxeterSystem.mem_parabolic_iff_exists_wordProd_eq` and
  `CoxeterSystem.exists_isReduced_wordProd_eq_of_mem_parabolic`: membership in a standard parabolic
  subgroup is being spelled by a word, indeed by a reduced word, with letters in the given set.
* `CoxeterSystem.simple_mem_parabolic_of_isReduced`: every letter of a reduced word for an element
  of a standard parabolic subgroup spells a simple reflection lying in that subgroup.
* `CoxeterSystem.length_mul_of_isMinimalCosetRep`: lengths add across a minimal coset
  representative.
* `CoxeterSystem.isMinimalCosetRep_iff`: minimality in the coset is the absence of right descents
  in `J`.
* `CoxeterSystem.existsUnique_isMinimalCosetRep_mul`: the unique factorization of an element of `W`
  as a minimal coset representative times a parabolic element.

## References

* A. Björner and F. Brenti, *Combinatorics of Coxeter Groups*, Springer GTM 231 (2005),
  Section 2.4.
* N. Bourbaki, *Groupes et algèbres de Lie*, Chapitres IV-VI, Ch. IV, §1.8.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, CUP (1990), Section 1.10.
-/

public section

namespace CoxeterSystem

variable {B W : Type*} [Group W] {M : CoxeterMatrix B} (cs : CoxeterSystem M W)

local prefix:100 "s " => cs.simple
local prefix:100 "π " => cs.wordProd
local prefix:100 "ℓ " => cs.length

/-! ### Standard parabolic subgroups -/

/-- The **standard parabolic subgroup** attached to a set `J` of indices: the subgroup of `W`
generated by the simple reflections `s i` with `i ∈ J`. -/
def parabolic (J : Set B) : Subgroup W := Subgroup.closure (cs.simple '' J)

theorem simple_mem_parabolic {J : Set B} {i : B} (hi : i ∈ J) : s i ∈ cs.parabolic J :=
  Subgroup.subset_closure ⟨i, hi, rfl⟩

theorem parabolic_mono {J J' : Set B} (h : J ⊆ J') : cs.parabolic J ≤ cs.parabolic J' :=
  Subgroup.closure_mono (Set.image_mono h)

@[simp]
theorem parabolic_empty : cs.parabolic (∅ : Set B) = ⊥ := by
  rw [parabolic, Set.image_empty, Subgroup.closure_empty]

/-- A word with letters in `J` spells an element of the standard parabolic subgroup of `J`. -/
theorem wordProd_mem_parabolic {J : Set B} {ω : List B} (hω : ∀ i ∈ ω, i ∈ J) :
    π ω ∈ cs.parabolic J := by
  induction ω with
  | nil => simp
  | cons a ω ih =>
    rw [cs.wordProd_cons]
    exact mul_mem (cs.simple_mem_parabolic (hω a (by simp)))
      (ih fun i hi => hω i (List.mem_cons_of_mem a hi))

@[simp]
theorem parabolic_univ : cs.parabolic (Set.univ : Set B) = ⊤ := by
  refine le_antisymm le_top fun w _ => ?_
  obtain ⟨ω, rfl⟩ := cs.wordProd_surjective w
  exact cs.wordProd_mem_parabolic fun i _ => Set.mem_univ i

/-- Every element of a standard parabolic subgroup is spelled by a word with letters in the
defining set. -/
theorem exists_wordProd_eq_of_mem_parabolic {J : Set B} {w : W} (hw : w ∈ cs.parabolic J) :
    ∃ ω : List B, (∀ i ∈ ω, i ∈ J) ∧ π ω = w := by
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, hi, rfl⟩ := hx
    exact ⟨[i], by simpa using hi, cs.wordProd_singleton i⟩
  | one => exact ⟨[], by simp, cs.wordProd_nil⟩
  | mul x y _ _ ihx ihy =>
    obtain ⟨ω₁, h₁, rfl⟩ := ihx
    obtain ⟨ω₂, h₂, rfl⟩ := ihy
    refine ⟨ω₁ ++ ω₂, fun i hi => ?_, cs.wordProd_append ω₁ ω₂⟩
    rcases List.mem_append.mp hi with hi | hi
    exacts [h₁ i hi, h₂ i hi]
  | inv x _ ih =>
    obtain ⟨ω, h, rfl⟩ := ih
    exact ⟨ω.reverse, fun i hi => h i (by simpa using hi), cs.wordProd_reverse ω⟩

theorem mem_parabolic_iff_exists_wordProd_eq {J : Set B} {w : W} :
    w ∈ cs.parabolic J ↔ ∃ ω : List B, (∀ i ∈ ω, i ∈ J) ∧ π ω = w :=
  ⟨cs.exists_wordProd_eq_of_mem_parabolic,
    fun ⟨_, hω, hp⟩ => hp ▸ cs.wordProd_mem_parabolic hω⟩

/-- The word of `CoxeterSystem.mem_parabolic_iff_exists_wordProd_eq` may be taken reduced:
shrinking a word to a reduced sublist keeps all of its letters inside `J`. -/
theorem exists_isReduced_wordProd_eq_of_mem_parabolic {J : Set B} {w : W}
    (hw : w ∈ cs.parabolic J) :
    ∃ ω : List B, cs.IsReduced ω ∧ (∀ i ∈ ω, i ∈ J) ∧ π ω = w := by
  obtain ⟨ω, hωJ, rfl⟩ := cs.exists_wordProd_eq_of_mem_parabolic hw
  obtain ⟨σ, hsub, hred, hprod⟩ := cs.exists_isReduced_sublist ω
  exact ⟨σ, hred, fun i hi => hωJ i (hsub.subset hi), hprod⟩

/-! ### Reduced words of parabolic elements stay inside the parabolic subgroup -/

/-- A left descent of an element of a standard parabolic subgroup lies in that subgroup. This is
the exchange condition applied to a reduced word with letters in `J`. -/
theorem simple_mem_parabolic_of_isLeftDescent {J : Set B} {w : W} (hw : w ∈ cs.parabolic J)
    {i : B} (hi : cs.IsLeftDescent w i) : s i ∈ cs.parabolic J := by
  obtain ⟨ω, hred, hωJ, rfl⟩ := cs.exists_isReduced_wordProd_eq_of_mem_parabolic hw
  obtain ⟨k, -, hke, -⟩ := cs.exchangeCondition hred hi
  have h : s i = π (ω.eraseIdx k) * (π ω)⁻¹ := by
    rw [← hke, mul_assoc, mul_inv_cancel, mul_one]
  rw [h]
  exact mul_mem
    (cs.wordProd_mem_parabolic fun a ha => hωJ a (List.mem_of_mem_eraseIdx ha)) (inv_mem hw)

/-- **The letters of a reduced word for a parabolic element are parabolic.** If `ω` is reduced and
spells an element of `cs.parabolic J`, then `s i` lies in `cs.parabolic J` for every letter `i`
of `ω`.

The conclusion is about the simple reflections rather than about the indices: injectivity of
`cs.simple` is not available for an abstract Coxeter system, so a letter outside `J` could a
priori spell the same reflection as one inside it. -/
theorem simple_mem_parabolic_of_isReduced {J : Set B} :
    ∀ ω : List B, cs.IsReduced ω → π ω ∈ cs.parabolic J → ∀ i ∈ ω, s i ∈ cs.parabolic J := by
  intro ω
  induction ω with
  | nil => simp
  | cons a ω ih =>
    intro hred hw
    have hlen : ℓ (π (a :: ω)) = ω.length + 1 := by simpa using hred.eq
    have hcancel : π ω = s a * π (a :: ω) := by
      rw [cs.wordProd_cons, cs.simple_mul_simple_cancel_left]
    have hle : ℓ (π ω) ≤ ω.length := cs.length_wordProd_le ω
    have hge : ω.length ≤ ℓ (π ω) := by
      have h := cs.length_mul_le (s a) (π ω)
      rw [← cs.wordProd_cons, hlen, cs.length_simple] at h
      omega
    have hdesc : cs.IsLeftDescent (π (a :: ω)) a :=
      cs.isLeftDescent_iff.mpr (by rw [← hcancel, hlen]; omega)
    have hsa : s a ∈ cs.parabolic J := cs.simple_mem_parabolic_of_isLeftDescent hw hdesc
    have hωmem : π ω ∈ cs.parabolic J := by rw [hcancel]; exact mul_mem hsa hw
    have hredω : cs.IsReduced ω := show ℓ (π ω) = ω.length from le_antisymm hle hge
    intro i hi
    rcases List.mem_cons.mp hi with rfl | hi
    · exact hsa
    · exact ih hredω hωmem i hi

/-! ### Minimal coset representatives -/

/-- `u` is a **minimal coset representative** for the standard parabolic subgroup of `J` when it
has minimal length in its own left coset `u · cs.parabolic J`. -/
def IsMinimalCosetRep (J : Set B) (u : W) : Prop := ∀ v ∈ cs.parabolic J, ℓ u ≤ ℓ (u * v)

/-- Every left coset of a standard parabolic subgroup contains a minimal coset representative. -/
theorem exists_isMinimalCosetRep (J : Set B) (w : W) :
    ∃ v ∈ cs.parabolic J, cs.IsMinimalCosetRep J (w * v) := by
  classical
  have hex : ∃ n : ℕ, ∃ v, v ∈ cs.parabolic J ∧ ℓ (w * v) = n :=
    ⟨ℓ (w * 1), 1, one_mem _, rfl⟩
  obtain ⟨v₀, hv₀mem, hv₀⟩ := Nat.find_spec hex
  refine ⟨v₀, hv₀mem, fun v hv => ?_⟩
  rw [hv₀, mul_assoc]
  exact Nat.find_le ⟨v₀ * v, mul_mem hv₀mem hv, rfl⟩

/-- **Lengths add across a minimal coset representative.** If `u` has minimal length in
`u · cs.parabolic J` and `v` lies in that parabolic subgroup, then `ℓ (u * v) = ℓ u + ℓ v`. -/
theorem length_mul_of_isMinimalCosetRep {J : Set B} {u : W} (hu : cs.IsMinimalCosetRep J u)
    {v : W} (hv : v ∈ cs.parabolic J) : ℓ (u * v) = ℓ u + ℓ v := by
  suffices H : ∀ n : ℕ, ∀ v ∈ cs.parabolic J, ℓ v ≤ n → ℓ (u * v) = ℓ u + ℓ v from
    H (ℓ v) v hv le_rfl
  intro n
  induction n with
  | zero =>
    intro v _ hlen
    rw [cs.length_eq_zero_iff.mp (Nat.le_zero.mp hlen)]
    simp
  | succ n ih =>
    intro v hv hlen
    rcases Nat.lt_or_ge (ℓ v) (n + 1) with hlt | hge
    · exact ih v hv (by omega)
    have hvn : ℓ v = n + 1 := by omega
    obtain ⟨ω, hred, hωJ, rfl⟩ := cs.exists_isReduced_wordProd_eq_of_mem_parabolic hv
    have hωlen : ω.length = n + 1 := hred.eq.symm.trans hvn
    obtain ⟨ω', j, rfl⟩ : ∃ ω' j, ω = ω' ++ [j] := by
      rcases List.eq_nil_or_concat ω with rfl | ⟨L, b, rfl⟩
      · simp at hωlen
      · exact ⟨L, b, by simp⟩
    have hω'len : ω'.length = n := by simpa using hωlen
    have hjJ : j ∈ J := hωJ j (by simp)
    have hω'J : ∀ i ∈ ω', i ∈ J := fun i hi => hωJ i (by simp [hi])
    have hsplit : π (ω' ++ [j]) = π ω' * s j := by
      rw [cs.wordProd_append, cs.wordProd_singleton]
    have hv' : π ω' ∈ cs.parabolic J := cs.wordProd_mem_parabolic hω'J
    have hω'length : ℓ (π ω') = n := by
      have hle : ℓ (π ω') ≤ n := hω'len ▸ cs.length_wordProd_le ω'
      have hbound := cs.length_mul_le (π ω') (s j)
      rw [← hsplit, hvn, cs.length_simple] at hbound
      omega
    have hIH : ℓ (u * π ω') = ℓ u + n := by rw [ih (π ω') hv' (by omega), hω'length]
    rw [hvn, hsplit, ← mul_assoc]
    rcases cs.length_mul_simple (u * π ω') j with h1 | h1
    · omega
    exfalso
    obtain ⟨α, hαred, hαu⟩ := cs.exists_isReduced u
    have hαlen : α.length = ℓ u := by rw [hαu, hαred.eq]
    have hprod : π (α ++ ω') = u * π ω' := by rw [cs.wordProd_append, ← hαu]
    have hcat : cs.IsReduced (α ++ ω') :=
      show ℓ (π (α ++ ω')) = (α ++ ω').length from by
        rw [hprod, hIH, List.length_append, hαlen, hω'len]
    have hdesc : cs.IsRightDescent (π (α ++ ω')) j :=
      cs.isRightDescent_iff.mpr (by rw [hprod]; omega)
    obtain ⟨k, hk, hke, -⟩ := cs.exchangeCondition_right hcat hdesc
    rw [List.length_append, hαlen, hω'len] at hk
    have key : u * π ω' * s j = π ((α ++ ω').eraseIdx k) := by rw [← hprod]; exact hke
    rcases Nat.lt_or_ge k α.length with hkα | hkα
    · -- Deleting a letter of `α` produces a shorter representative of the same coset.
      have h2 : π ((α ++ ω').eraseIdx k) = π (α.eraseIdx k) * π ω' := by
        rw [List.eraseIdx_append_of_lt_length hkα, cs.wordProd_append]
      have heq : u * (π ω' * s j * (π ω')⁻¹) = π (α.eraseIdx k) := by
        rw [← mul_assoc, ← mul_assoc, key, h2, mul_assoc, mul_inv_cancel, mul_one]
      have hz : π ω' * s j * (π ω')⁻¹ ∈ cs.parabolic J :=
        mul_mem (mul_mem hv' (cs.simple_mem_parabolic hjJ)) (inv_mem hv')
      have hmin := hu _ hz
      rw [heq] at hmin
      have hshort := cs.length_wordProd_le (α.eraseIdx k)
      have hlen1 := List.length_eraseIdx_add_one hkα
      omega
    · -- Deleting a letter of `ω'` contradicts reducedness on the parabolic side.
      have h2 : π ((α ++ ω').eraseIdx k) = u * π (ω'.eraseIdx (k - α.length)) := by
        rw [List.eraseIdx_append_of_length_le hkα, cs.wordProd_append, ← hαu]
      have h3 : π ω' * s j = π (ω'.eraseIdx (k - α.length)) :=
        mul_left_cancel (a := u) (by rw [← mul_assoc, key, h2])
      have hklt : k - α.length < ω'.length := by omega
      have hle := cs.length_wordProd_le (ω'.eraseIdx (k - α.length))
      rw [← h3] at hle
      have hfull : ℓ (π ω' * s j) = n + 1 := by rw [← hsplit]; exact hvn
      have hlen1 := List.length_eraseIdx_add_one hklt
      omega

/-- Minimality in the coset is the absence of right descents inside `J`. -/
theorem isMinimalCosetRep_iff {J : Set B} {u : W} :
    cs.IsMinimalCosetRep J u ↔ ∀ i ∈ J, ¬ cs.IsRightDescent u i := by
  refine ⟨fun hu i hi hdesc => ?_, fun hu => ?_⟩
  · have hle := hu _ (cs.simple_mem_parabolic hi)
    have := cs.isRightDescent_iff.mp hdesc
    omega
  obtain ⟨v₀, hv₀mem, hmin⟩ := cs.exists_isMinimalCosetRep J u
  have hsplit : ℓ u = ℓ (u * v₀) + ℓ v₀⁻¹ := by
    have h := cs.length_mul_of_isMinimalCosetRep hmin (inv_mem hv₀mem)
    rwa [mul_assoc, mul_inv_cancel, mul_one] at h
  by_cases hy : v₀⁻¹ = 1
  · have hv0 : v₀ = 1 := by simpa using congrArg Inv.inv hy
    rwa [hv0, mul_one] at hmin
  exfalso
  obtain ⟨ω, hred, hωJ, hprod⟩ :=
    cs.exists_isReduced_wordProd_eq_of_mem_parabolic (inv_mem hv₀mem)
  obtain ⟨ω', i, rfl⟩ : ∃ ω' i, ω = ω' ++ [i] := by
    rcases List.eq_nil_or_concat ω with rfl | ⟨L, b, rfl⟩
    · rw [cs.wordProd_nil] at hprod
      exact absurd hprod.symm hy
    · exact ⟨L, b, by simp⟩
  have hiJ : i ∈ J := hωJ i (by simp)
  have hω'mem : π ω' ∈ cs.parabolic J :=
    cs.wordProd_mem_parabolic fun a ha => hωJ a (by simp [ha])
  have hcat : π ω' * s i = v₀⁻¹ := by
    rw [← hprod, cs.wordProd_append, cs.wordProd_singleton]
  have hlen : ℓ v₀⁻¹ = ω'.length + 1 := by rw [← hprod, hred.eq]; simp
  have hω'len : ℓ (π ω') = ω'.length := by
    refine le_antisymm (cs.length_wordProd_le ω') ?_
    have hbound := cs.length_mul_le (π ω') (s i)
    rw [hcat, hlen, cs.length_simple] at hbound
    omega
  have hlast : v₀⁻¹ * s i = π ω' := by
    rw [← hcat, mul_assoc, cs.simple_mul_simple_self, mul_one]
  have heq : u * s i = u * v₀ * π ω' := by
    rw [← hlast, ← mul_assoc, mul_assoc u v₀ v₀⁻¹, mul_inv_cancel, mul_one]
  have hfact : ℓ (u * s i) = ℓ (u * v₀) + ω'.length := by
    rw [heq, cs.length_mul_of_isMinimalCosetRep hmin hω'mem, hω'len]
  exact hu i hiJ (cs.isRightDescent_iff.mpr (by omega))

/-- **Every element of `W` factors uniquely as a minimal coset representative times an element of
the standard parabolic subgroup.** The two lengths then add, by
`CoxeterSystem.length_mul_of_isMinimalCosetRep`. -/
theorem existsUnique_isMinimalCosetRep_mul (J : Set B) (w : W) :
    ∃! p : W × W, cs.IsMinimalCosetRep J p.1 ∧ p.2 ∈ cs.parabolic J ∧ w = p.1 * p.2 := by
  obtain ⟨v₀, hv₀mem, hmin⟩ := cs.exists_isMinimalCosetRep J w
  refine ⟨(w * v₀, v₀⁻¹), ⟨hmin, inv_mem hv₀mem, by rw [mul_assoc, mul_inv_cancel, mul_one]⟩, ?_⟩
  rintro ⟨u, v⟩ ⟨hu, hv, rfl⟩
  have hmem : u⁻¹ * (u * v * v₀) ∈ cs.parabolic J := by
    rw [← mul_assoc, ← mul_assoc, inv_mul_cancel, one_mul]
    exact mul_mem hv hv₀mem
  have hmem' : (u * v * v₀)⁻¹ * u ∈ cs.parabolic J := by simpa using inv_mem hmem
  have h1 : ℓ (u * v * v₀) = ℓ u + ℓ (u⁻¹ * (u * v * v₀)) := by
    have h := cs.length_mul_of_isMinimalCosetRep hu hmem
    rwa [← mul_assoc, mul_inv_cancel, one_mul] at h
  have h2 : ℓ u = ℓ (u * v * v₀) + ℓ ((u * v * v₀)⁻¹ * u) := by
    have h := cs.length_mul_of_isMinimalCosetRep hmin hmem'
    rwa [← mul_assoc, mul_inv_cancel, one_mul] at h
  have h3 : ℓ ((u * v * v₀)⁻¹ * u) = ℓ (u⁻¹ * (u * v * v₀)) := by
    rw [← cs.length_inv (u⁻¹ * (u * v * v₀))]
    congr 1
    group
  have h4 : u⁻¹ * (u * v * v₀) = 1 := by
    rw [← cs.length_eq_zero_iff]
    omega
  have h5 : v * v₀ = 1 := by rw [← h4, ← mul_assoc, ← mul_assoc, inv_mul_cancel, one_mul]
  have hvv : v = v₀⁻¹ := by
    have h := congrArg (· * v₀⁻¹) h5
    simpa [mul_assoc] using h
  have hXu : u * v * v₀ = u := by rw [mul_assoc, h5, mul_one]
  rw [Prod.mk.injEq]
  exact ⟨hXu.symm, hvv⟩

end CoxeterSystem
