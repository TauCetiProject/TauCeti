module

public import Mathlib.RingTheory.TensorProduct.Free
public import TauCeti.GroupTheory.Coxeter.Geometric.Sign
public import TauCeti.LinearAlgebra.Matrix.FinsuppReflection

/-!
# Integral forms of the geometric representation

Let `cs : CoxeterSystem M W` be a Coxeter system with arbitrary index set `B`, and let
`A : Matrix B B ℤ` be an integer matrix with `(A i j : ℝ) = 2 ⟪αᵢ, αⱼ⟫` for the canonical form
`⟪·, ·⟫ = CoxeterMatrix.geometricForm M` of the geometric representation, that is
`A i j = -2 cos (π / M i j)`. Such a matrix exists exactly
when every off-diagonal entry of `M` is `2`, `3` or `0` (read as `∞`), giving the entries `0`,
`-1` and `-2`: for instance for the Weyl groups of simply laced type, and for the infinite
dihedral group, where `A` is the degenerate matrix `!![2, -2; -2, 2]`.

Then the free abelian group `B →₀ ℤ` carries the representation of `W` in which the `i`-th simple
reflection acts by the integral reflection `x ↦ x - (∑ⱼ A i j xⱼ) eᵢ`. Coefficientwise inclusion
`c : (B →₀ ℤ) → (B →₀ ℝ)` intertwines it with the standard geometric representation `ρ`,
`c (ρℤ(w) x) = ρ(w) (c x)`, and `c` is injective, so the integral representation is faithful by
Tits' theorem. No assumption on the determinant of `A` is made.

The construction works over every commutative ring `R`, with the matrix `A` read in `R`, and the
representations over two rings are intertwined by coefficientwise application of any ring
homomorphism. In particular reduction modulo an integer `n` gives a representation on
`B →₀ ZMod n` intertwined with the integral one; faithfulness holds over rings of characteristic
zero and is not claimed in general (in rank one the reflection reduces to the identity modulo `2`).

## Main definitions

* `CoxeterSystem.integralGeometricRepresentation`: the representation of `W` on `B →₀ R` by the
  reflections `Matrix.finsuppReflection` of `A`, for an integer matrix `A` as above.

## Main results

* `CoxeterSystem.mapRange_intCast_integralGeometricRepresentation`: coefficientwise inclusion of
  integers into reals intertwines the integral representation with the geometric representation.
* `CoxeterSystem.mapRange_integralGeometricRepresentation`: compatibility with every ring
  homomorphism, for instance reduction modulo an integer.
* `CoxeterSystem.integralGeometricRepresentation_injective`: the representation is faithful over
  every ring of characteristic zero, in particular over `ℤ`.
* `CoxeterSystem.finsuppBilinForm_integralGeometricRepresentation`: it preserves the form with
  Gram matrix `A`.
* `CoxeterSystem.mrange_integralGeometricRepresentation`: its image is the monoid generated by the
  integral simple reflections.
* `CoxeterSystem.conj_integralGeometricRepresentation_simple_apply` and
  `CoxeterSystem.conj_baseChange_conj_integralGeometricRepresentation`: transported to a module `L`
  with a `ℤ`-basis, the action is given by the same formula in that basis, and after extending
  scalars to `ℝ` it becomes the geometric representation.

## References

* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, CUP (1990), Section 5.3 (the reflection
  formula) and Section 5.4, Corollary (faithfulness).
-/

public section

open Function

namespace CoxeterMatrix

variable {B : Type*} {M : CoxeterMatrix B} {A : Matrix B B ℤ}

/-! ### Integral Gram matrices -/

section Gram

variable (hA : ∀ i j, (A i j : ℝ) = 2 * M.geometricForm (Finsupp.single i 1) (Finsupp.single j 1))
include hA

/-- An integral Gram matrix of the canonical form is symmetric. -/
theorem isSymm_of_intCast_eq_two_mul_geometricForm : A.IsSymm :=
  Matrix.IsSymm.ext fun i j ↦ Int.cast_injective (α := ℝ) <| by
    rw [hA, hA, M.geometricForm_comm]

/-- An integral Gram matrix of the canonical form has `2` on the diagonal, every simple root
being a unit vector. -/
theorem apply_self_of_intCast_eq_two_mul_geometricForm (i : B) : A i i = 2 :=
  Int.cast_injective (α := ℝ) <| by rw [hA, M.geometricForm_single_self]; norm_num

/-- Over `ℝ`, the reflections of an integral Gram matrix of the canonical form are the simple
reflections of the geometric representation. -/
theorem finsuppReflection_map_intCast_eq_geometricReflection (i : B) :
    (A.map (Int.cast : ℤ → ℝ)).finsuppReflection i = M.geometricReflection i := by
  have hform : (A.map (Int.cast : ℤ → ℝ)).finsuppBilinForm (Finsupp.single i 1) =
      (2 : ℝ) • M.geometricForm (Finsupp.single i 1) :=
    Finsupp.lhom_ext fun j b ↦ by
      simp only [Matrix.finsuppBilinForm_single_single, Matrix.map_apply, hA, LinearMap.smul_apply,
        smul_eq_mul, geometricForm_single_single]
      ring
  refine LinearMap.ext fun v ↦ ?_
  rw [Matrix.finsuppReflection_apply, geometricReflection_apply, hform, LinearMap.smul_apply,
    smul_eq_mul]

/-- **The reflections of an integral Gram matrix satisfy the Coxeter relations** over every
commutative ring: over `ℤ` because coefficientwise inclusion into `ℝ` is injective and turns them
into the simple reflections of the geometric representation, and over any other ring by applying
`ℤ → R` to the coefficients. -/
theorem isLiftable_finsuppReflection (R : Type*) [CommRing R] :
    M.IsLiftable (A.map (Int.cast : ℤ → R)).finsuppReflection := by
  have hint : M.IsLiftable A.finsuppReflection := fun i j ↦ by
    refine LinearMap.ext fun x ↦ Finsupp.mapRange_injective _ (map_zero (Int.castRingHom ℝ))
      Int.cast_injective ?_
    rw [Matrix.mapRange_pow_finsuppReflection_mul, one_apply_eq_self]
    simp only [Int.coe_castRingHom, finsuppReflection_map_intCast_eq_geometricReflection hA,
      M.isLiftable_geometricReflection i j, one_apply_eq_self]
  intro i j
  refine Finsupp.basisSingleOne.ext fun k ↦ ?_
  have h := A.mapRange_pow_finsuppReflection_mul (Int.castRingHom R) i j (M i j)
    (Finsupp.single k 1)
  rw [hint i j, one_apply_eq_self] at h
  simpa using h.symm

end Gram

end CoxeterMatrix

namespace CoxeterSystem

variable {B W : Type*} [Group W] {M : CoxeterMatrix B} (cs : CoxeterSystem M W)
  (R : Type*) {S : Type*} [CommRing R] [CommRing S] (A : Matrix B B ℤ)
  (hA : ∀ i j, (A i j : ℝ) = 2 * M.geometricForm (Finsupp.single i 1) (Finsupp.single j 1))

/-! ### The integral geometric representation -/

/-- **The geometric representation with integral Gram matrix `A`**, over a commutative ring `R`:
the representation of `W` on the free module `B →₀ R` in which the `i`-th simple reflection acts
by `x ↦ x - (∑ⱼ A i j xⱼ) eᵢ`. The integer matrix `A` is twice the Gram matrix of the canonical
form of the geometric representation. Over `ℤ` this is a faithful representation on the lattice
spanned by the simple roots, which coefficientwise inclusion identifies with the restriction of the
geometric representation (`CoxeterSystem.mapRange_intCast_integralGeometricRepresentation`). -/
noncomputable def integralGeometricRepresentation : Representation R W (B →₀ R) :=
  cs.lift ⟨_, CoxeterMatrix.isLiftable_finsuppReflection hA R⟩

/-- **The `i`-th simple reflection acts by the integral reflection** `x ↦ x - (∑ⱼ A i j xⱼ) eᵢ`. -/
@[simp]
theorem integralGeometricRepresentation_simple (i : B) :
    cs.integralGeometricRepresentation R A hA (cs.simple i) =
      (A.map (Int.cast : ℤ → R)).finsuppReflection i :=
  cs.lift_apply_simple (CoxeterMatrix.isLiftable_finsuppReflection hA R) i

/-- Over `ℤ`, the `i`-th simple reflection acts by the reflection of `A` itself. -/
theorem integralGeometricRepresentation_simple_int (i : B) :
    cs.integralGeometricRepresentation ℤ A hA (cs.simple i) = A.finsuppReflection i := by
  rw [integralGeometricRepresentation_simple]
  exact congrArg (Matrix.finsuppReflection · i) (Matrix.ext fun _ _ ↦ Int.cast_id)

/-- **Applying a ring homomorphism to the coefficients intertwines the representations** over the
two rings. For the reduction `ℤ → ZMod n` this is the induced action modulo `n`. -/
theorem mapRange_integralGeometricRepresentation (f : R →+* S) (w : W) (x : B →₀ R) :
    (cs.integralGeometricRepresentation R A hA w x).mapRange f (map_zero f) =
      cs.integralGeometricRepresentation S A hA w (x.mapRange f (map_zero f)) := by
  induction w using cs.simple_induction generalizing x with
  | simple i =>
    have hmap : (A.map (Int.cast : ℤ → R)).map f = A.map (Int.cast : ℤ → S) := by
      ext; simp
    rw [integralGeometricRepresentation_simple, integralGeometricRepresentation_simple,
      Matrix.mapRange_finsuppReflection, hmap]
  | one => simp
  | mul w w' hw hw' => simp only [map_mul, mul_apply_eq_comp, hw, hw']

/-- Over `ℝ`, the representation with integral Gram matrix `A` is the geometric
representation. -/
theorem integralGeometricRepresentation_real :
    cs.integralGeometricRepresentation ℝ A hA = cs.geometricRepresentation :=
  cs.ext_simple fun i ↦ by
    rw [integralGeometricRepresentation_simple, geometricRepresentation_simple,
      CoxeterMatrix.finsuppReflection_map_intCast_eq_geometricReflection hA]

/-- **Coefficientwise inclusion `ℤ → ℝ` intertwines the integral representation with the geometric
representation**: `c (ρℤ(w) x) = ρ(w) (c x)`. Since `c` is injective
(`Finsupp.mapRange_injective`), the integral representation is the restriction of the geometric
representation to the lattice of integral combinations of the simple roots. -/
theorem mapRange_intCast_integralGeometricRepresentation (w : W) (x : B →₀ ℤ) :
    (cs.integralGeometricRepresentation ℤ A hA w x).mapRange (Int.cast : ℤ → ℝ) Int.cast_zero =
      cs.geometricRepresentation w (x.mapRange (Int.cast : ℤ → ℝ) Int.cast_zero) := by
  rw [← integralGeometricRepresentation_real cs A hA]
  exact cs.mapRange_integralGeometricRepresentation ℤ A hA (Int.castRingHom ℝ) w x

/-- The image of `w` over `R` acts trivially as soon as its image over `ℤ` does. -/
private theorem integralGeometricRepresentation_eq_one_of_int {w : W}
    (h : cs.integralGeometricRepresentation ℤ A hA w = 1) :
    cs.integralGeometricRepresentation R A hA w = 1 :=
  Finsupp.basisSingleOne.ext fun k ↦ by
    have := cs.mapRange_integralGeometricRepresentation ℤ A hA (Int.castRingHom R) w
      (Finsupp.single k 1)
    simpa [h] using this.symm

/-- In characteristic zero, the image of `w` over `ℤ` acts trivially as soon as its image over `R`
does, coefficientwise inclusion being injective. -/
private theorem integralGeometricRepresentation_int_eq_one [CharZero R] {w : W}
    (h : cs.integralGeometricRepresentation R A hA w = 1) :
    cs.integralGeometricRepresentation ℤ A hA w = 1 :=
  LinearMap.ext fun x ↦ Finsupp.mapRange_injective _ (map_zero (Int.castRingHom R))
    Int.cast_injective <| by
      rw [cs.mapRange_integralGeometricRepresentation ℤ A hA (Int.castRingHom R), h]
      simp

/-- **The geometric representation with integral Gram matrix is faithful** over every ring of
characteristic zero, in particular over `ℤ`. This follows from Tits' theorem
`CoxeterSystem.geometricRepresentation_injective`, through coefficientwise inclusion into `ℝ`.
No assumption on the determinant of `A` is needed: in the infinite dihedral group `A` is singular.
Over a ring of positive characteristic the representation need not be faithful. -/
theorem integralGeometricRepresentation_injective [CharZero R] :
    Injective (cs.integralGeometricRepresentation R A hA) := by
  refine (injective_iff_map_eq_one _).mpr fun w hw ↦ cs.geometricRepresentation_injective ?_
  rw [map_one, ← integralGeometricRepresentation_real cs A hA]
  exact cs.integralGeometricRepresentation_eq_one_of_int ℝ A hA
    (cs.integralGeometricRepresentation_int_eq_one R A hA hw)

/-- **The representation preserves the form with Gram matrix `A`**, the form
`(x, y) ↦ ∑ᵢⱼ xᵢ Aᵢⱼ yⱼ` read over `R`. -/
theorem finsuppBilinForm_integralGeometricRepresentation (w : W) (x y : B →₀ R) :
    (A.map (Int.cast : ℤ → R)).finsuppBilinForm (cs.integralGeometricRepresentation R A hA w x)
        (cs.integralGeometricRepresentation R A hA w y) =
      (A.map (Int.cast : ℤ → R)).finsuppBilinForm x y := by
  have hsymm : (A.map (Int.cast : ℤ → R)).IsSymm :=
    (CoxeterMatrix.isSymm_of_intCast_eq_two_mul_geometricForm hA).map _
  induction w using cs.simple_induction generalizing x y with
  | simple i =>
    rw [integralGeometricRepresentation_simple, Matrix.finsuppBilinForm_finsuppReflection hsymm]
    simp [CoxeterMatrix.apply_self_of_intCast_eq_two_mul_geometricForm hA i]
  | one => simp
  | mul w w' hw hw' => rw [map_mul, mul_apply_eq_comp, mul_apply_eq_comp, hw, hw']

/-- **The image of the representation is generated by the integral simple reflections** as a
monoid. Each of these reflections being an involution, this monoid is also the group they
generate. -/
theorem mrange_integralGeometricRepresentation :
    MonoidHom.mrange (cs.integralGeometricRepresentation R A hA) =
      Submonoid.closure (Set.range (A.map (Int.cast : ℤ → R)).finsuppReflection) := by
  rw [MonoidHom.mrange_eq_map, ← cs.submonoidClosure_range_simple, MonoidHom.map_mclosure,
    ← Set.range_comp]
  exact congrArg (Submonoid.closure ∘ Set.range)
    (funext (cs.integralGeometricRepresentation_simple R A hA))

/-! ### Transport to a module with a basis -/

section Basis

variable {L : Type*} [AddCommGroup L] [Module ℤ L] (e : Module.Basis B ℤ L)

/-- **Transporting the integral representation along a `ℤ`-basis `e`** of a module `L`, by the
coordinate equivalence: the `i`-th simple reflection acts by `y ↦ y - (∑ⱼ A i j yⱼ) e i`, where
`yⱼ` are the coordinates of `y` in the basis `e`. -/
theorem conj_integralGeometricRepresentation_simple_apply (i : B) (y : L) :
    e.repr.symm.conj (cs.integralGeometricRepresentation ℤ A hA (cs.simple i)) y =
      y - A.finsuppBilinForm (Finsupp.single i 1) (e.repr y) • e i := by
  rw [LinearEquiv.conj_apply_apply, LinearEquiv.symm_symm,
    integralGeometricRepresentation_simple_int, Matrix.finsuppReflection_apply, map_sub,
    map_zsmul, LinearEquiv.symm_apply_apply, Module.Basis.repr_symm_single_one]

/-- **After extending scalars to `ℝ`, the transported integral representation is the geometric
representation**: the identification `ℝ ⊗[ℤ] L ≃ (B →₀ ℝ)` induced by the basis `e`, sending
`1 ⊗ e i` to the simple root `αᵢ`, conjugates the base change of the integral action of `w` to
`ρ(w)`. -/
theorem conj_baseChange_conj_integralGeometricRepresentation (w : W) :
    (Algebra.TensorProduct.basis ℝ e).repr.conj
        ((e.repr.symm.conj (cs.integralGeometricRepresentation ℤ A hA w)).baseChange ℝ) =
      cs.geometricRepresentation w := by
  refine Finsupp.basisSingleOne.ext fun k ↦ ?_
  have h := cs.mapRange_intCast_integralGeometricRepresentation A hA w (Finsupp.single k 1)
  simp only [Finsupp.mapRange_single, Int.cast_one] at h
  simp [LinearEquiv.conj_apply_apply, ← h, algebraMap_int_eq]

end Basis

end CoxeterSystem
