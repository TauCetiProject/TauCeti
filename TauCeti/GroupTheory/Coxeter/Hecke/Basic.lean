/-!
# The Iwahori–Hecke algebra of a Coxeter matrix

For a Coxeter matrix `M` on an index type `B`, a commutative semiring `R` and a parameter `c : R`,
the Iwahori–Hecke algebra `M.HeckeAlgebra c` is the associative unital `R`-algebra on generators
`T i`, `i : B`, subject to

* the quadratic relation `T i * T i = c • T i + 1`, and
* the braid relations: for all `i` and `j`, the two alternating words in `T i` and `T j` of length
  `M i j` have the same product (no relation when `M i j = 0`, read as `∞`).

It is built as the quotient of `FreeAlgebra R B` by these relations, which makes the universal
property `CoxeterMatrix.HeckeAlgebra.lift` available. When `c = v - v⁻¹` for a unit `v`, the
quadratic relation is `(T i - v) * (T i + v⁻¹) = 0`
(`CoxeterMatrix.HeckeAlgebra.T_sub_algebraMap_mul_T_add_algebraMap_eq_zero`): this is the
equal-parameter Hecke algebra over `ℤ[v, v⁻¹]` in the normalisation of Kazhdan and Lusztig. At
`c = 0` the defining relations are the Coxeter relations of the simple reflections.

Let `cs : CoxeterSystem M W` be a Coxeter system with Coxeter matrix `M`. For `w : W` the element
`CoxeterMatrix.HeckeAlgebra.Tw c cs w`, usually written `T_w`, is the product
`T i₁ * ⋯ * T iₖ` along any reduced expression `w = s i₁ ⋯ s iₖ`; by Matsumoto's theorem
(`TauCeti.existsUnique_reducedWordLift`) it does not depend on the reduced expression. The
elements `T_w` multiply by the length rule: `T_v * T_w = T_(v * w)` when lengths add, and

* `T i * T_w = T_(s i * w)` if `ℓ (s i * w) = ℓ w + 1`, and
* `T i * T_w = c • T_w + T_(s i * w)` if `ℓ (s i * w) < ℓ w`,

with the mirror statements on the right. Consequently the elements `T_w` span the Hecke algebra as
an `R`-module. That they are linearly independent, so form a basis, is proved in
`TauCeti.GroupTheory.Coxeter.Hecke.Basis`.

## Main definitions

* `CoxeterMatrix.HeckeAlgebra.Rel`: the defining relations on the free algebra.
* `CoxeterMatrix.HeckeAlgebra`: the Iwahori–Hecke algebra of `M` with parameter `c`.
* `CoxeterMatrix.HeckeAlgebra.T`: the generators.
* `CoxeterMatrix.HeckeAlgebra.lift`: the universal property.
* `CoxeterMatrix.HeckeAlgebra.unitT`: over a commutative ring, the generators as units.
* `CoxeterMatrix.HeckeAlgebra.Tw`: the element `T_w` attached to an element `w` of a Coxeter
  system.

## Main results

* `CoxeterMatrix.HeckeAlgebra.T_mul_self` and `CoxeterMatrix.HeckeAlgebra.prod_map_T_braidWord`:
  the defining relations.
* `CoxeterMatrix.HeckeAlgebra.lift_T` and `CoxeterMatrix.HeckeAlgebra.hom_ext`: the universal
  property.
* `CoxeterMatrix.HeckeAlgebra.Tw_wordProd`: `T_w` is the product of the generators along any
  reduced expression of `w`.
* `CoxeterMatrix.HeckeAlgebra.Tw_mul_Tw`: `T_v * T_w = T_(v * w)` when `ℓ (v * w) = ℓ v + ℓ w`.
* `CoxeterMatrix.HeckeAlgebra.T_mul_Tw_of_isLeftDescent` and its three companions: multiplication
  of `T_w` by a generator.
* `CoxeterMatrix.HeckeAlgebra.mul_mem_span_image_Tw`: the subalgebra generated by the `T i`,
  `i ∈ J`, preserves the span of the `T_w`, `w ∈ S`, when `S` is stable under the `s i`, `i ∈ J`.
* `CoxeterMatrix.HeckeAlgebra.span_range_Tw`: the elements `T_w` span the Hecke algebra.

## References

* N. Iwahori, *On the structure of a Hecke ring of a Chevalley group over a finite field*,
  J. Fac. Sci. Univ. Tokyo Sect. I 10 (1964), 215–236.
* D. Kazhdan and G. Lusztig, *Representations of Coxeter groups and Hecke algebras*,
  Invent. Math. 53 (1979), 165–184.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, CUP (1990), Section 7.1.
* The quotient presentation and universal-property API follow `TauCeti.TypeAHeckeAlgebra`, the
  type-A case of this construction.
-/

public section

open CoxeterSystem

namespace CoxeterMatrix

variable {B : Type*} (M : CoxeterMatrix B) {R : Type*} [CommSemiring R] (c : R)

namespace HeckeAlgebra

/-- The defining relations of the Iwahori–Hecke algebra of the Coxeter matrix `M` with parameter
`c`, as a relation on the free algebra over `B`: the quadratic relation `T i * T i = c • T i + 1`,
and the braid relation equating the products of the two alternating words of length `M i j` in
`T i` and `T j`. -/
inductive Rel : FreeAlgebra R B → FreeAlgebra R B → Prop
  | mul_self (i : B) :
      Rel (FreeAlgebra.ι R i * FreeAlgebra.ι R i) (c • FreeAlgebra.ι R i + 1)
  | braid (i j : B) :
      Rel ((braidWord M i j).map (FreeAlgebra.ι R)).prod
        ((braidWord M j i).map (FreeAlgebra.ι R)).prod

end HeckeAlgebra

/-- The Iwahori–Hecke algebra of the Coxeter matrix `M` over `R` with quadratic parameter `c`:
the free `R`-algebra on `B` modulo `CoxeterMatrix.HeckeAlgebra.Rel`. -/
@[expose] def HeckeAlgebra : Type _ := RingQuot (HeckeAlgebra.Rel M c)

instance : Semiring (M.HeckeAlgebra c) :=
  inferInstanceAs (Semiring (RingQuot (HeckeAlgebra.Rel M c)))

instance {R : Type*} [CommRing R] (c : R) : Ring (M.HeckeAlgebra c) :=
  inferInstanceAs (Ring (RingQuot (HeckeAlgebra.Rel M c)))

/-- The Hecke algebra over `R` is an algebra over every ring that `R` is an algebra over. -/
instance (priority := 900) HeckeAlgebra.instAlgebra' {S : Type*} [CommSemiring S]
    [Algebra S R] : Algebra S (M.HeckeAlgebra c) :=
  inferInstanceAs (Algebra S (RingQuot (HeckeAlgebra.Rel M c)))

instance : Algebra R (M.HeckeAlgebra c) := inferInstance

instance {S T : Type*} [CommSemiring S] [CommSemiring T] [SMul S T] [Algebra S R] [Algebra T R]
    [IsScalarTower S T R] : IsScalarTower S T (M.HeckeAlgebra c) :=
  inferInstanceAs (IsScalarTower S T (RingQuot (HeckeAlgebra.Rel M c)))

namespace HeckeAlgebra

/-- The quotient map from the free algebra to the Hecke algebra. -/
def mkAlgHom : FreeAlgebra R B →ₐ[R] M.HeckeAlgebra c :=
  RingQuot.mkAlgHom R (Rel M c)

/-- The generator `T i` of the Hecke algebra, attached to the simple reflection `s i`. -/
def T (i : B) : M.HeckeAlgebra c :=
  mkAlgHom M c (FreeAlgebra.ι R i)

/-- The quotient map takes each free-algebra generator to the corresponding Hecke generator. -/
@[simp]
theorem mkAlgHom_ι (i : B) : mkAlgHom M c (FreeAlgebra.ι R i) = T M c i := (rfl)

/-- Every element of the Hecke algebra is represented by a free-algebra element. -/
theorem mkAlgHom_surjective : Function.Surjective (mkAlgHom M c) :=
  RingQuot.mkAlgHom_surjective _ _

variable {M c} in
/-- Related elements of the free algebra have the same image in the Hecke algebra. -/
theorem mkAlgHom_rel {x y : FreeAlgebra R B} (h : Rel M c x y) :
    mkAlgHom M c x = mkAlgHom M c y :=
  RingQuot.mkAlgHom_rel R h

/-- The quadratic relation of a Hecke generator. -/
@[simp]
theorem T_mul_self (i : B) : T M c i * T M c i = c • T M c i + 1 := by
  simpa only [map_mul, map_add, map_smul, map_one, mkAlgHom_ι] using
    mkAlgHom_rel (Rel.mul_self (M := M) (c := c) i)

/-- **The braid relations**: the two alternating words of length `M i j` in the generators `T i`
and `T j` have the same product. -/
theorem prod_map_T_braidWord (i j : B) :
    ((braidWord M i j).map (T M c)).prod = ((braidWord M j i).map (T M c)).prod := by
  have h := mkAlgHom_rel (Rel.braid (M := M) (c := c) i j)
  simpa only [map_list_prod, List.map_map, Function.comp_def, mkAlgHom_ι] using h

section Lift

variable {M c} {A : Type*} [Semiring A] [Algebra R A]

/-- The universal property of the Hecke presentation: a family in an `R`-algebra indexed by `B`
satisfying the quadratic relation and the braid relations of `M` extends to an algebra map out of
`M.HeckeAlgebra c`. -/
def lift (f : B → A) (hself : ∀ i, f i * f i = c • f i + 1)
    (hbraid : ∀ i j, ((braidWord M i j).map f).prod = ((braidWord M j i).map f).prod) :
    M.HeckeAlgebra c →ₐ[R] A :=
  RingQuot.liftAlgHom R ⟨FreeAlgebra.lift R f, by
    rintro x y (i | ⟨i, j⟩)
    · simpa only [map_mul, map_add, map_smul, map_one, FreeAlgebra.lift_ι_apply] using hself i
    · simpa only [map_list_prod, List.map_map, Function.comp_def, FreeAlgebra.lift_ι_apply]
        using hbraid i j⟩

/-- The algebra map built by `CoxeterMatrix.HeckeAlgebra.lift` takes each generator to its
prescribed value. -/
@[simp]
theorem lift_T (f : B → A) (hself) (hbraid) (i : B) : lift f hself hbraid (T M c i) = f i :=
  (RingQuot.liftAlgHom_mkAlgHom_apply R _ _ _).trans (FreeAlgebra.lift_ι_apply _ _)

/-- Two algebra maps out of the Hecke algebra agreeing on the generators are equal. -/
@[ext high]
theorem hom_ext {F G : M.HeckeAlgebra c →ₐ[R] A} (h : ∀ i, F (T M c i) = G (T M c i)) :
    F = G :=
  RingQuot.ringQuot_ext' R F G <| FreeAlgebra.hom_ext (funext h)

end Lift

/-- The generators generate the Hecke algebra as an `R`-algebra. -/
theorem adjoin_range_T : Algebra.adjoin R (Set.range (T M c)) = ⊤ := by
  have hrange : Set.range (T M c) = mkAlgHom M c '' Set.range (FreeAlgebra.ι R (X := B)) := by
    simp only [← Set.range_comp, Function.comp_def, mkAlgHom_ι]
  rw [hrange, Algebra.adjoin_image_eq_range _ (FreeAlgebra.adjoin_range_ι R _)]
  exact (AlgHom.range_eq_top _).2 (mkAlgHom_surjective M c)

section Ring

variable {R : Type*} [CommRing R] (c : R)

/-- The generator `T i` as a unit. Its inverse is `T i - c`, by the quadratic relation. -/
def unitT (i : B) : (M.HeckeAlgebra c)ˣ where
  val := T M c i
  inv := T M c i - algebraMap R _ c
  val_inv := by
    rw [mul_sub, ← Algebra.commutes, ← Algebra.smul_def, T_mul_self, add_sub_cancel_left]
  inv_val := by
    rw [sub_mul, ← Algebra.smul_def, T_mul_self, add_sub_cancel_left]

/-- The underlying element of `unitT M c i` is the generator `T M c i`. -/
@[simp]
theorem val_unitT (i : B) : (unitT M c i : M.HeckeAlgebra c) = T M c i := (rfl)

/-- The inverse of the generator `T i` is `T i - c`. -/
@[simp]
theorem val_inv_unitT (i : B) :
    ↑(unitT M c i)⁻¹ = T M c i - algebraMap R (M.HeckeAlgebra c) c := (rfl)

/-- Each generator `T i` is invertible. -/
theorem isUnit_T (i : B) : IsUnit (T M c i) := (unitT M c i).isUnit

/-- With the normalised parameter `c = v - v⁻¹`, the quadratic relation reads
`(T i - v) * (T i + v⁻¹) = 0`. -/
theorem T_sub_algebraMap_mul_T_add_algebraMap_eq_zero (v : Rˣ) (i : B) :
    (T M ((v : R) - ↑v⁻¹) i - algebraMap R _ (v : R)) *
        (T M ((v : R) - ↑v⁻¹) i + algebraMap R _ (↑v⁻¹ : R)) = 0 := by
  have hv : algebraMap R (M.HeckeAlgebra ((v : R) - ↑v⁻¹)) (v : R) * algebraMap R _ (↑v⁻¹ : R) =
      1 := by
    simp [← map_mul]
  simp only [sub_mul, mul_add, T_mul_self, ← Algebra.commutes _ (T M _ i), hv,
    Algebra.smul_def, map_sub]
  abel

end Ring

section Tw

variable {M} {W : Type*} [Group W] (cs : CoxeterSystem M W)

/-- The element `T_w` of the Hecke algebra attached to an element `w` of a Coxeter system with
Coxeter matrix `M`: the product of the generators `T i` along a reduced expression of `w`. It is
the reduced-word lift of Matsumoto's theorem (`TauCeti.existsUnique_reducedWordLift`), so it does
not depend on the reduced expression (`CoxeterMatrix.HeckeAlgebra.Tw_wordProd`). -/
noncomputable def Tw (w : W) : M.HeckeAlgebra c :=
  (TauCeti.existsUnique_reducedWordLift cs (T M c) (prod_map_T_braidWord M c)).exists.choose w

variable {c cs}

/-- `T_w` is the product of the generators along any reduced expression of `w`. -/
theorem Tw_wordProd {ω : List B} (hω : cs.IsReduced ω) :
    Tw c cs (cs.wordProd ω) = (ω.map (T M c)).prod :=
  (TauCeti.existsUnique_reducedWordLift cs (T M c)
    (prod_map_T_braidWord M c)).exists.choose_spec ω hω

variable (c cs)

/-- The element `T_w` attached to the identity is `1`. -/
@[simp]
theorem Tw_one : Tw c cs (1 : W) = 1 := by
  simpa using Tw_wordProd (c := c) (cs := cs) (ω := []) (by simp [CoxeterSystem.IsReduced])

/-- The element `T_w` attached to a simple reflection is the corresponding generator. -/
@[simp]
theorem Tw_simple (i : B) : Tw c cs (cs.simple i) = T M c i := by
  simpa using Tw_wordProd (c := c) (cs := cs) (ω := [i]) (by simp [CoxeterSystem.IsReduced])

variable {c cs}

/-- **Length additivity.** If `ℓ (v * w) = ℓ v + ℓ w`, then `T_v * T_w = T_(v * w)`. -/
theorem Tw_mul_Tw {v w : W} (h : cs.length (v * w) = cs.length v + cs.length w) :
    Tw c cs v * Tw c cs w = Tw c cs (v * w) := by
  obtain ⟨ω, hω, rfl⟩ := cs.exists_isReduced v
  obtain ⟨ω', hω', rfl⟩ := cs.exists_isReduced w
  have hred : cs.IsReduced (ω ++ ω') := by
    rw [CoxeterSystem.IsReduced, wordProd_append, h, hω.eq, hω'.eq, List.length_append]
  rw [← wordProd_append, Tw_wordProd hω, Tw_wordProd hω', Tw_wordProd hred, List.map_append,
    List.prod_append]

/-- **Left multiplication, length increase.** If `s i * w` is longer than `w`, then
`T i * T_w = T_(s i * w)`. -/
theorem T_mul_Tw_of_not_isLeftDescent {w : W} {i : B} (h : ¬cs.IsLeftDescent w i) :
    T M c i * Tw c cs w = Tw c cs (cs.simple i * w) := by
  rw [← Tw_simple c cs, Tw_mul_Tw]
  rw [cs.not_isLeftDescent_iff.mp h, length_simple, add_comm]

/-- **Right multiplication, length increase.** If `w * s i` is longer than `w`, then
`T_w * T i = T_(w * s i)`. -/
theorem Tw_mul_T_of_not_isRightDescent {w : W} {i : B} (h : ¬cs.IsRightDescent w i) :
    Tw c cs w * T M c i = Tw c cs (w * cs.simple i) := by
  rw [← Tw_simple c cs, Tw_mul_Tw]
  rw [cs.not_isRightDescent_iff.mp h, length_simple]

/-- **Left multiplication, length decrease.** If `s i * w` is shorter than `w`, then
`T i * T_w = c • T_w + T_(s i * w)`. -/
theorem T_mul_Tw_of_isLeftDescent {w : W} {i : B} (h : cs.IsLeftDescent w i) :
    T M c i * Tw c cs w = c • Tw c cs w + Tw c cs (cs.simple i * w) := by
  have hw : Tw c cs w = T M c i * Tw c cs (cs.simple i * w) := by
    rw [T_mul_Tw_of_not_isLeftDescent, simple_mul_simple_cancel_left]
    rwa [cs.isLeftDescent_iff_not_isLeftDescent_mul] at h
  conv_lhs => rw [hw]
  rw [← mul_assoc, T_mul_self, add_mul, one_mul, smul_mul_assoc, ← hw]

/-- **Right multiplication, length decrease.** If `w * s i` is shorter than `w`, then
`T_w * T i = c • T_w + T_(w * s i)`. -/
theorem Tw_mul_T_of_isRightDescent {w : W} {i : B} (h : cs.IsRightDescent w i) :
    Tw c cs w * T M c i = c • Tw c cs w + Tw c cs (w * cs.simple i) := by
  have hw : Tw c cs w = Tw c cs (w * cs.simple i) * T M c i := by
    rw [Tw_mul_T_of_not_isRightDescent, simple_mul_simple_cancel_right]
    rwa [cs.isRightDescent_iff_not_isRightDescent_mul] at h
  conv_lhs => rw [hw]
  rw [mul_assoc, T_mul_self, mul_add, mul_one, mul_smul_comm, ← hw]

/-- Left multiplication by a generator `T i` preserves the span of the elements `T_w` for `w` in a
set `S` that is closed under left multiplication by the simple reflection `s i`. -/
theorem T_mul_mem_span_image_Tw {S : Set W} {i : B} (hS : ∀ w ∈ S, cs.simple i * w ∈ S)
    {x : M.HeckeAlgebra c} (hx : x ∈ Submodule.span R (Tw c cs '' S)) :
    T M c i * x ∈ Submodule.span R (Tw c cs '' S) := by
  induction hx using Submodule.span_induction with
  | mem _ hy =>
    obtain ⟨w, hw, rfl⟩ := hy
    by_cases h : cs.IsLeftDescent w i
    · rw [T_mul_Tw_of_isLeftDescent h]
      exact add_mem (Submodule.smul_mem _ _ (Submodule.subset_span ⟨w, hw, rfl⟩))
        (Submodule.subset_span ⟨_, hS w hw, rfl⟩)
    · rw [T_mul_Tw_of_not_isLeftDescent h]
      exact Submodule.subset_span ⟨_, hS w hw, rfl⟩
  | zero => simp
  | add _ _ _ _ hy hz => simpa only [mul_add] using add_mem hy hz
  | smul r _ _ hy => simpa only [mul_smul_comm] using Submodule.smul_mem _ r hy

/-- Let `S ⊆ W` be closed under left multiplication by the simple reflections `s i`, `i ∈ J`. Then
the subalgebra generated by the generators `T i`, `i ∈ J`, multiplies the span of the elements
`T_w`, `w ∈ S`, into itself. -/
theorem mul_mem_span_image_Tw {J : Set B} {S : Set W} (hS : ∀ i ∈ J, ∀ w ∈ S, cs.simple i * w ∈ S)
    {x y : M.HeckeAlgebra c} (hx : x ∈ Algebra.adjoin R (T M c '' J))
    (hy : y ∈ Submodule.span R (Tw c cs '' S)) :
    x * y ∈ Submodule.span R (Tw c cs '' S) := by
  rw [← smul_eq_mul]
  refine (Submodule.span R (Tw c cs '' S)).smul_mem_of_mem_adjoin ?_ hx hy
  rintro _ ⟨i, hi, rfl⟩ z hz
  rw [smul_eq_mul]
  exact T_mul_mem_span_image_Tw (hS i hi) hz

variable (c cs)

/-- The elements `T_w` span the Hecke algebra as an `R`-module. -/
theorem span_range_Tw : Submodule.span R (Set.range (Tw c cs)) = ⊤ := by
  refine eq_top_iff.mpr fun x _ ↦ ?_
  have hx : x ∈ Algebra.adjoin R (T M c '' Set.univ) := by
    rw [Set.image_univ, adjoin_range_T]; trivial
  -- The span is stable under left multiplication by `x`; apply this to `T_1 = 1`.
  simpa using mul_mem_span_image_Tw (cs := cs) (fun _ _ _ _ ↦ Set.mem_univ _) hx
    (Submodule.subset_span ⟨1, Set.mem_univ _, rfl⟩)

end Tw

section Ring

variable {M} {R : Type*} [CommRing R] (c : R) {W : Type*} [Group W] (cs : CoxeterSystem M W)

/-- Over a commutative ring, each element `T_w` is invertible. -/
theorem isUnit_Tw (w : W) : IsUnit (Tw c cs w) := by
  obtain ⟨ω, hω, rfl⟩ := cs.exists_isReduced w
  rw [Tw_wordProd hω]
  exact List.prod_isUnit fun _ hx ↦ by
    obtain ⟨i, -, rfl⟩ := List.mem_map.mp hx
    exact isUnit_T M c i

end Ring

end HeckeAlgebra

end CoxeterMatrix
