module

public import TauCeti.GroupTheory.Coprod.Finiteness
public import TauCeti.GroupTheory.FinitelyPresentedGroup

/-!
# Groups finitely presented relative to a family of subgroups

Let `G` be a group and `ℋ` a family of subgroups of `G`. A homomorphism `φ` from a free group
`F(Ω)` to `G` extends to the natural homomorphism `F(Ω) ∗ (∗_{H ∈ ℋ} H) → G` which is the
inclusion on every `H ∈ ℋ`. The group `G` is *finitely presented relative to `ℋ`* when `Ω` can be
chosen finite so that this homomorphism is surjective and its kernel is the normal closure of a
finite set (Guirardel–Levitt, Definition 1.8, following Osin). The definition is used for finite
families `ℋ`, but it does not need finiteness, which is therefore a hypothesis of the results
that use it.

The family is a set of subgroups, as for trees relative to a family of subgroups, so a subgroup
contributes a single free factor.

## Main definitions

* `TauCeti.Group.relPresentationHom`: the natural homomorphism `F(Ω) ∗ (∗_{H ∈ ℋ} H) → G`.
* `TauCeti.Group.IsFinitelyPresentedRel`: `G` is finitely presented relative to `ℋ`.

## Main results

* `TauCeti.Group.IsFinitelyPresentedRel.isFinitelyNormallyGenerated_ker`,
  `TauCeti.Group.isFinitelyPresentedRel_iff_of_surjective`: relative finite presentation does not
  depend on the finite relative generating set.
* `TauCeti.Group.isFinitelyPresentedRel_empty`: finite presentation relative to the empty family
  is finite presentation.
* `TauCeti.Group.IsFinitelyPresentedRel.of_isFinitelyPresented`: a finitely presented group is
  finitely presented relative to every finite family of finitely generated subgroups.
* `TauCeti.Group.IsFinitelyPresentedRel.fg`: a group finitely presented relative to a finite
  family of finitely generated subgroups is finitely generated.
* `TauCeti.Group.isFinitelyPresentedRel_singleton_top`: every group, finitely generated or not,
  is finitely presented relative to itself.

## References

* V. Guirardel and G. Levitt, *JSJ decompositions of groups*, Astérisque 395 (2017), §1.7,
  Definitions 1.6 and 1.8 and the remarks following them, and §2.5, the recollection before the
  proof of Proposition 2.24.
* D. V. Osin, *Relatively hyperbolic groups: intrinsic geometry, algebraic properties, and
  algorithmic problems*, Mem. Amer. Math. Soc. 179 (2006).
-/

public section

open Function Monoid

namespace TauCeti

namespace Group

variable {G : Type*} [Group G] {α β : Type*} {ℋ : Set (Subgroup G)}

variable (α ℋ) in
/-- The free product `F(Ω) ∗ (∗_{H ∈ ℋ} H)` of the free group on `Ω` and the subgroups in the
family `ℋ`. -/
abbrev RelFreeProduct : Type _ :=
  -- The monoid structure of each factor is given as that of the group `H`: with the structure
  -- found by instance search, unification does not find the group structure of the free product.
  Coprod (FreeGroup α) (@CoprodI ℋ (fun H => (H : Subgroup G)) fun H => H.1.toGroup.toMonoid)

/-- The natural homomorphism `F(Ω) ∗ (∗_{H ∈ ℋ} H) → G` extending a homomorphism `φ` from the
free group `F(Ω)` to `G` by the inclusions of the subgroups in the family `ℋ`. -/
def relPresentationHom (φ : FreeGroup α →* G) (ℋ : Set (Subgroup G)) : RelFreeProduct α ℋ →* G :=
  Coprod.lift φ (CoprodI.lift fun H => H.1.subtype)

@[simp]
theorem relPresentationHom_inl (φ : FreeGroup α →* G) (ℋ : Set (Subgroup G)) (x : FreeGroup α) :
    relPresentationHom φ ℋ (Coprod.inl x) = φ x := by
  simp [relPresentationHom]

@[simp]
theorem relPresentationHom_inr_of (φ : FreeGroup α →* G) {H : ℋ} (x : (H : Subgroup G)) :
    relPresentationHom φ ℋ (Coprod.inr (CoprodI.of x)) = x := by
  simp [relPresentationHom]

/-- The image of the natural homomorphism is generated by the image of the free group and the
subgroups in the family. -/
theorem range_relPresentationHom (φ : FreeGroup α →* G) (ℋ : Set (Subgroup G)) :
    (relPresentationHom φ ℋ).range = φ.range ⊔ sSup ℋ := by
  simp [relPresentationHom, CoprodI.range_eq_iSup, sSup_eq_iSup']

/-- The natural homomorphism is surjective exactly when the image of the free group and the
subgroups in the family generate the group. -/
theorem relPresentationHom_surjective_iff {φ : FreeGroup α →* G} :
    Surjective (relPresentationHom φ ℋ) ↔ φ.range ⊔ sSup ℋ = ⊤ := by
  rw [← MonoidHom.range_eq_top, range_relPresentationHom]

/-- If `φ` is already surjective, so is the natural homomorphism. -/
theorem relPresentationHom_surjective {φ : FreeGroup α →* G} (hφ : Surjective φ) :
    Surjective (relPresentationHom φ ℋ) := by
  simp [relPresentationHom_surjective_iff, MonoidHom.range_eq_top.2 hφ]

/-- The free product `F(Ω) ∗ (∗_{H ∈ ℋ} H)` is generated by the free generators and the
subgroups in the family. -/
private theorem closure_generators :
    Subgroup.closure ((Coprod.inl '' Set.range FreeGroup.of : Set (RelFreeProduct α ℋ)) ∪
      Set.range Coprod.inr) = ⊤ := by
  rw [eq_top_iff, ← Coprod.closure_range_inl_union_inr, Subgroup.closure_le]
  rintro _ (⟨x, rfl⟩ | ⟨y, rfl⟩)
  · refine Subgroup.closure_mono Set.subset_union_left ?_
    simp [← MonoidHom.map_closure, FreeGroup.closure_range_of]
  · exact Subgroup.subset_closure (.inr ⟨y, rfl⟩)

/-- The free product of a finitely generated free group and finitely many finitely generated
subgroups is finitely generated. -/
private theorem fg_relFreeProduct [Finite α] (hℋ : ℋ.Finite) (hfg : ∀ H ∈ ℋ, H.FG) :
    _root_.Group.FG (RelFreeProduct α ℋ) :=
  have : Finite ℋ := hℋ
  have (H : ℋ) : _root_.Group.FG (H : Subgroup G) := hfg H H.2
  inferInstance

/-- Relative finite presentation does not depend on the relative generating set: if the natural
homomorphism of one family of generators is surjective with finitely normally generated kernel,
then the natural homomorphism of any finite family of generators which is surjective has a
finitely normally generated kernel. -/
theorem isFinitelyNormallyGenerated_ker_relPresentationHom [Finite β] {φ : FreeGroup α →* G}
    {ψ : FreeGroup β →* G} (hφ : Surjective (relPresentationHom φ ℋ))
    (hker : (relPresentationHom φ ℋ).ker.IsFinitelyNormallyGenerated)
    (hψ : Surjective (relPresentationHom ψ ℋ)) :
    (relPresentationHom ψ ℋ).ker.IsFinitelyNormallyGenerated := by
  have hh : (relPresentationHom φ ℋ).comp (Coprod.lift
      (FreeGroup.lift fun b => surjInv hφ (ψ (.of b))) Coprod.inr) = relPresentationHom ψ ℋ := by
    ext <;> simp [surjInv_eq hφ]
  have hk : (relPresentationHom ψ ℋ).comp (Coprod.lift
      (FreeGroup.lift fun a => surjInv hψ (φ (.of a))) Coprod.inr) = relPresentationHom φ ℋ := by
    ext <;> simp [surjInv_eq hψ]
  refine hker.ker_of_comp_eq _ _ (DFunLike.congr_fun hh) (DFunLike.congr_fun hk)
    closure_generators (((Set.finite_range FreeGroup.of).image Coprod.inl).subset ?_)
  rintro t ⟨ht | ⟨x, rfl⟩, hne⟩
  · exact ht
  · simp at hne

variable (ℋ) in
/-- A group `G` is finitely presented relative to a family `ℋ` of subgroups when there is a
finite family `Ω` of elements of `G` such that the natural homomorphism
`F(Ω) ∗ (∗_{H ∈ ℋ} H) → G` is surjective and its kernel is the normal closure of a finite set. -/
def IsFinitelyPresentedRel : Prop :=
  ∃ (n : ℕ) (φ : FreeGroup (Fin n) →* G), Surjective (relPresentationHom φ ℋ) ∧
    (relPresentationHom φ ℋ).ker.IsFinitelyNormallyGenerated

/-- The definition of relative finite presentation, unfolded. -/
theorem isFinitelyPresentedRel_iff : IsFinitelyPresentedRel ℋ ↔
    ∃ (n : ℕ) (φ : FreeGroup (Fin n) →* G), Surjective (relPresentationHom φ ℋ) ∧
      (relPresentationHom φ ℋ).ker.IsFinitelyNormallyGenerated := Iff.rfl

/-- If `G` is finitely presented relative to `ℋ`, then the kernel of the natural homomorphism of
every finite relative generating family is the normal closure of a finite set. -/
theorem IsFinitelyPresentedRel.isFinitelyNormallyGenerated_ker [Finite α]
    (h : IsFinitelyPresentedRel ℋ) {ψ : FreeGroup α →* G}
    (hψ : Surjective (relPresentationHom ψ ℋ)) :
    (relPresentationHom ψ ℋ).ker.IsFinitelyNormallyGenerated := by
  obtain ⟨n, φ, hφ, hker⟩ := h
  exact isFinitelyNormallyGenerated_ker_relPresentationHom hφ hker hψ

/-- A finite relative generating family whose natural homomorphism has a finitely normally
generated kernel exhibits `G` as finitely presented relative to `ℋ`. -/
theorem IsFinitelyPresentedRel.of_isFinitelyNormallyGenerated_ker [Finite α] {ψ : FreeGroup α →* G}
    (hψ : Surjective (relPresentationHom ψ ℋ))
    (hker : (relPresentationHom ψ ℋ).ker.IsFinitelyNormallyGenerated) :
    IsFinitelyPresentedRel ℋ := by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin α
  obtain ⟨φ, hφ⟩ : ∃ φ : FreeGroup (Fin n) →* G, φ.range = ψ.range :=
    ⟨ψ.comp (FreeGroup.map e.symm), by
      rw [MonoidHom.range_comp,
        MonoidHom.range_eq_top.2 (FreeGroup.map_surjective e.symm.surjective),
        ← MonoidHom.range_eq_map]⟩
  have hφ' : Surjective (relPresentationHom φ ℋ) := by
    rwa [relPresentationHom_surjective_iff, hφ, ← relPresentationHom_surjective_iff]
  exact ⟨n, φ, hφ', isFinitelyNormallyGenerated_ker_relPresentationHom hψ hker hφ'⟩

/-- For a finite relative generating family, `G` is finitely presented relative to `ℋ` exactly
when the kernel of the natural homomorphism is the normal closure of a finite set. -/
theorem isFinitelyPresentedRel_iff_of_surjective [Finite α] {ψ : FreeGroup α →* G}
    (hψ : Surjective (relPresentationHom ψ ℋ)) :
    IsFinitelyPresentedRel ℋ ↔ (relPresentationHom ψ ℋ).ker.IsFinitelyNormallyGenerated :=
  ⟨fun h => h.isFinitelyNormallyGenerated_ker hψ, .of_isFinitelyNormallyGenerated_ker hψ⟩

/-- A finitely presented group is finitely presented relative to every finite family of finitely
generated subgroups. -/
theorem IsFinitelyPresentedRel.of_isFinitelyPresented [_root_.Group.IsFinitelyPresented G]
    (hℋ : ℋ.Finite) (hfg : ∀ H ∈ ℋ, H.FG) : IsFinitelyPresentedRel ℋ := by
  obtain ⟨n, φ, hφ, -⟩ := _root_.Group.IsFinitelyPresented.out (G := G)
  have := fg_relFreeProduct (α := Fin n) hℋ hfg
  have hsurj : Surjective (relPresentationHom φ ℋ) := relPresentationHom_surjective hφ
  exact ⟨n, φ, hsurj, _root_.Group.IsFinitelyPresented.isFinitelyNormallyGenerated_ker hsurj⟩

/-- A group finitely presented relative to a finite family of finitely generated subgroups is
finitely generated. -/
theorem IsFinitelyPresentedRel.fg (h : IsFinitelyPresentedRel ℋ) (hℋ : ℋ.Finite)
    (hfg : ∀ H ∈ ℋ, H.FG) : _root_.Group.FG G := by
  obtain ⟨n, φ, hφ, -⟩ := h
  have := fg_relFreeProduct (α := Fin n) hℋ hfg
  exact _root_.Group.fg_of_surjective hφ

/-- A group is finitely presented relative to the empty family of subgroups exactly when it is
finitely presented. -/
@[simp]
theorem isFinitelyPresentedRel_empty :
    IsFinitelyPresentedRel (∅ : Set (Subgroup G)) ↔ _root_.Group.IsFinitelyPresented G := by
  refine ⟨fun ⟨n, φ, hφ, hker⟩ => ⟨n, φ, ?_, ?_⟩, fun _ => .of_isFinitelyPresented
    Set.finite_empty (by simp)⟩
  · simpa [relPresentationHom_surjective_iff, MonoidHom.range_eq_top] using hφ
  · have hρ : relPresentationHom φ ∅ = φ.comp (Coprod.lift (.id _) 1) := by
      ext H
      · simp
      · exact H.2.elim
    have hsurj : Surjective (Coprod.lift (.id _) 1 :
        RelFreeProduct (Fin n) (∅ : Set (Subgroup G)) →* FreeGroup (Fin n)) :=
      fun x => ⟨Coprod.inl x, by simp⟩
    exact .ker_of_ker_comp hsurj (hρ ▸ hker)

/-- Every group is finitely presented relative to itself, with no generators and no relators. In
particular a group finitely presented relative to a subgroup need not be finitely generated. -/
theorem isFinitelyPresentedRel_singleton_top : IsFinitelyPresentedRel ({⊤} : Set (Subgroup G)) := by
  refine ⟨0, 1, by simp [relPresentationHom_surjective_iff], ?_⟩
  let s : G →* RelFreeProduct (Fin 0) ({⊤} : Set (Subgroup G)) :=
    Coprod.inr.comp ((CoprodI.of (i := ⟨⊤, rfl⟩)).comp
      ((MonoidHom.id G).codRestrict ⊤ fun _ => Subgroup.mem_top _))
  have hs : s.comp (relPresentationHom 1 {⊤}) = .id _ := by
    ext H x
    · exact H.elim0
    · obtain ⟨H, rfl⟩ := H
      simp [s, relPresentationHom]
  have hinj : Injective (relPresentationHom (1 : FreeGroup (Fin 0) →* G) {⊤}) :=
    LeftInverse.injective (g := s) (DFunLike.congr_fun hs)
  rw [(MonoidHom.ker_eq_bot_iff _).2 hinj]
  exact .bot

end Group

end TauCeti
