/-!
# `ℤ² ⋊ G` is ICC for nonamenable `G ≤ SL(2, ℤ)`

Let `ι : G →* SL(2, ℤ)` be injective and form `ℤ² ⋊ G` with `G` acting on column vectors through
`ι` (`TauCeti.slTwoAction`). By `TauCeti.forall_infinite_setOf_isConj_iff_of_injective`, every
nontrivial conjugacy class of `ℤ² ⋊ G` is infinite exactly when every nonzero vector of `ℤ²` has
an infinite `G`-orbit.

A nonamenable `G` has this property. The stabilizer of a nonzero vector in `SL(2, ℤ)` is
commutative (`Matrix.SpecialLinearGroup.isMulCommutative_stabilizer`), hence amenable, and a
discrete group with a finite orbit and amenable stabilizer is amenable
(`TauCeti.Amenable.of_finite_orbit`). This covers `SL(2, ℤ)` itself, its finite-index subgroups,
and the free subgroups, such as Sanov's subgroup generated by `[[1, 2], [0, 1]]` and
`[[1, 0], [2, 1]]` (`TauCeti.injective_freeGroup_lift_transvection_two`).

## Main statements

* `TauCeti.infinite_range_smul_of_not_hasFoelnerSets` and
  `TauCeti.infinite_range_smul_of_not_amenable`: a nonamenable `G` has infinite orbits on nonzero
  vectors.
* `TauCeti.infinite_setOf_isConj_semidirectProduct_of_not_amenable`: `ℤ² ⋊ G` is ICC for
  nonamenable `G`, with the specializations
  `Subgroup.infinite_setOf_isConj_semidirectProduct_slTwo_of_not_amenable`,
  `Subgroup.infinite_setOf_isConj_semidirectProduct_slTwo_of_finiteIndex`,
  `TauCeti.infinite_setOf_isConj_semidirectProduct_slTwo` and
  `TauCeti.infinite_setOf_isConj_semidirectProduct_freeGroup` to nonamenable and finite-index
  subgroups of `SL(2, ℤ)`, to `SL(2, ℤ)` itself and to free subgroups of rank at least two.

## References

* C. Anantharaman and S. Popa, *An Introduction to II₁ Factors*, Example 18.1.5 and
  Theorem 18.3.2, where `ℤ² ⋊ F_n` is used as an ICC group.
-/

public section

open scoped MatrixGroups IsMulCommutative

namespace TauCeti

section Conjugacy

variable {G : Type*} [Group G] {ι : G →* SL(2, ℤ)}

/-- **Infinite orbits of nonamenable groups on `ℤ²`** (Følner form): if `ι : G →* SL(2, ℤ)` is
injective and `G` has no Følner sets, then every nonzero vector of `ℤ²` has an infinite `G`-orbit.
The stabilizer of a nonzero vector is commutative, so a finite orbit would make `G` amenable. -/
theorem infinite_range_smul_of_not_hasFoelnerSets (hι : Function.Injective ι)
    (hG : ¬ HasFoelnerSets G) {v : Fin 2 → ℤ} (hv : v ≠ 0) :
    (Set.range fun g => ι g • v).Infinite := by
  intro hfin
  let _ : TopologicalSpace G := ⊥
  have : DiscreteTopology G := ⟨rfl⟩
  let _ : MulAction G (Fin 2 → ℤ) := MulAction.compHom _ ι
  have horbit : MulAction.orbit G v = Set.range fun g => ι g • v := by
    ext; simp [MulAction.mem_orbit_iff, MulAction.compHom_smul_def]
  have : Finite (MulAction.orbit G v) := (horbit ▸ hfin).to_subtype
  have : IsMulCommutative (MulAction.stabilizer SL(2, ℤ) v) :=
    Matrix.SpecialLinearGroup.isMulCommutative_stabilizer hv
  have hstab : (MulAction.stabilizer SL(2, ℤ) v).comap ι = MulAction.stabilizer G v :=
    by ext; simp [MulAction.mem_stabilizer_iff, MulAction.compHom_smul_def]
  have : IsMulCommutative (MulAction.stabilizer G v) :=
    hstab ▸ Subgroup.comap_injective_isMulCommutative _ hι
  exact hG (amenable_iff_hasFoelnerSets.1 (Amenable.of_finite_orbit v))

/-- **Infinite orbits of nonamenable groups on `ℤ²`**: if `ι : G →* SL(2, ℤ)` is injective and
`G` is not amenable, then every nonzero vector of `ℤ²` has an infinite `G`-orbit. -/
theorem infinite_range_smul_of_not_amenable [TopologicalSpace G] [IsTopologicalGroup G]
    (hι : Function.Injective ι) (hG : ¬ Amenable G) {v : Fin 2 → ℤ} (hv : v ≠ 0) :
    (Set.range fun g => ι g • v).Infinite :=
  infinite_range_smul_of_not_hasFoelnerSets hι (mt (Amenable.of_hasFoelnerSets (G := G)) hG) hv

/-- **`ℤ² ⋊ G` is ICC for nonamenable `G` embedded in `SL(2, ℤ)`**: if `ι : G →* SL(2, ℤ)` is
injective and `G` is not amenable, then every nontrivial conjugacy class of `ℤ² ⋊ G` is infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_of_not_amenable [TopologicalSpace G]
    [IsTopologicalGroup G]
    (hι : Function.Injective ι) (hG : ¬ Amenable G)
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] G} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite :=
  (forall_infinite_setOf_isConj_iff_of_injective hι).2
    (fun _ => infinite_range_smul_of_not_amenable hι hG) x hx

end Conjugacy

/-- For a free group `FreeGroup α` on at least two generators embedded in `SL(2, ℤ)`, for instance
by Sanov's embedding for `α = Fin 2`, every nontrivial conjugacy class of `ℤ² ⋊ FreeGroup α` is
infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_freeGroup {α : Type*} [Nontrivial α]
    {ι : FreeGroup α →* SL(2, ℤ)} (hι : Function.Injective ι)
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp ι] FreeGroup α} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite := by
  let _ : TopologicalSpace (FreeGroup α) := ⊥
  have : DiscreteTopology (FreeGroup α) := ⟨rfl⟩
  exact infinite_setOf_isConj_semidirectProduct_of_not_amenable hι not_amenable_freeGroup hx

/-- **`ℤ² ⋊ SL(2, ℤ)` is ICC**: every nontrivial conjugacy class of `ℤ² ⋊ SL(2, ℤ)` is
infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_slTwo
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction] SL(2, ℤ)} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite :=
  infinite_setOf_isConj_semidirectProduct_of_not_amenable (ι := MonoidHom.id SL(2, ℤ))
    Function.injective_id not_amenable_slTwo hx

end TauCeti

namespace Subgroup

open TauCeti

/-- **`ℤ² ⋊ G` is ICC for nonamenable subgroups `G ≤ SL(2, ℤ)`**: every nontrivial conjugacy class
of `ℤ² ⋊ G` is infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_slTwo_of_not_amenable (G : Subgroup SL(2, ℤ))
    (hG : ¬ Amenable G)
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite :=
  TauCeti.infinite_setOf_isConj_semidirectProduct_of_not_amenable G.subtype_injective hG hx

/-- **`ℤ² ⋊ G` is ICC for finite-index subgroups `G ≤ SL(2, ℤ)`**: every nontrivial conjugacy
class of `ℤ² ⋊ G` is infinite. -/
theorem infinite_setOf_isConj_semidirectProduct_slTwo_of_finiteIndex (G : Subgroup SL(2, ℤ))
    [G.FiniteIndex]
    {x : Multiplicative (Fin 2 → ℤ) ⋊[slTwoAction.comp G.subtype] G} (hx : x ≠ 1) :
    {y | IsConj x y}.Infinite :=
  G.infinite_setOf_isConj_semidirectProduct_slTwo_of_not_amenable
    (fun _ => not_amenable_slTwo (Amenable.of_finiteIndex G)) hx

end Subgroup
