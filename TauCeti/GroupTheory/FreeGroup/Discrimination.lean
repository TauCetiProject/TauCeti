module

public import TauCeti.GroupTheory.FreeGroup.Linear

/-!
# Free groups are discriminated by the free group of rank two

Every finite family of nonidentity elements of a free group `FreeGroup ι`, of arbitrary rank,
survives simultaneously under a single homomorphism to `FreeGroup (Fin 2)`.

The finitely many elements lie in the subgroup generated by a finite set `t` of basis elements.
The retraction of `FreeGroup ι` onto `FreeGroup t`, killing the other basis elements, is injective
on that subgroup, and `FreeGroup t` embeds in `FreeGroup (Fin 2)` by
`TauCeti.injective_freeGroup_lift_conj_zpow_of`.

This shows that the choice of free target in the definitions of residually free and fully
residually free groups is immaterial: the free group of rank two always suffices.

## Main results

* `FreeGroup.exists_finset_forall_mem_closure`: finitely many elements of a free group lie in the
  subgroup generated by finitely many basis elements.
* `FreeGroup.exists_monoidHom_fin_two_forall_ne_one`: finitely many nonidentity elements of a free
  group survive under one homomorphism to `FreeGroup (Fin 2)`.

## References

* C. Champetier, V. Guirardel, *Limit groups as limits of free groups*, Israel J. Math. 146
  (2005), §2.3.
-/

public section

open Subgroup

namespace FreeGroup

variable {ι : Type*}

/-- Each element of a free group lies in the subgroup generated by finitely many basis
elements. -/
theorem exists_finset_mem_closure (x : FreeGroup ι) :
    ∃ t : Finset ι, x ∈ closure (of '' (t : Set ι)) := by
  classical
  have hx : x ∈ closure (Set.range (of : ι → FreeGroup ι)) := by
    rw [closure_range_of]
    exact mem_top x
  induction hx using closure_induction with
  | mem _ hy =>
    obtain ⟨i, rfl⟩ := hy
    exact ⟨{i}, subset_closure ⟨i, by simp, rfl⟩⟩
  | one => exact ⟨∅, one_mem _⟩
  | mul _ _ _ _ hy hz =>
    obtain ⟨t, ht⟩ := hy
    obtain ⟨t', ht'⟩ := hz
    have hle (u : Finset ι) (hu : u ⊆ t ∪ t') :
        closure (of '' (u : Set ι)) ≤ closure (of '' ((t ∪ t' : Finset ι) : Set ι)) :=
      closure_mono (Set.image_mono (by exact_mod_cast hu))
    exact ⟨t ∪ t', mul_mem (hle t Finset.subset_union_left ht)
      (hle t' Finset.subset_union_right ht')⟩
  | inv _ _ hy =>
    obtain ⟨t, ht⟩ := hy
    exact ⟨t, inv_mem ht⟩

/-- Finitely many elements of a free group lie in the subgroup generated by finitely many basis
elements. -/
theorem exists_finset_forall_mem_closure (s : Finset (FreeGroup ι)) :
    ∃ t : Finset ι, ∀ x ∈ s, x ∈ closure (of '' (t : Set ι)) := by
  classical
  choose t ht using exists_finset_mem_closure (ι := ι)
  refine ⟨s.biUnion t, fun x hx => closure_mono (Set.image_mono ?_) (ht x)⟩
  exact_mod_cast Finset.subset_biUnion_of_mem t hx

/-- **Free groups are discriminated by `F₂`.** Finitely many nonidentity elements of a free group
of arbitrary rank survive simultaneously under one homomorphism to the free group of rank two. -/
theorem exists_monoidHom_fin_two_forall_ne_one (s : Finset (FreeGroup ι))
    (hs : ∀ x ∈ s, x ≠ 1) :
    ∃ φ : FreeGroup ι →* FreeGroup (Fin 2), ∀ x ∈ s, φ x ≠ 1 := by
  classical
  obtain ⟨t, ht⟩ := exists_finset_forall_mem_closure s
  -- The retraction onto the basis elements in `t` is the identity on the subgroup they generate.
  let r : FreeGroup ι →* FreeGroup t := lift fun i => if h : i ∈ t then of ⟨i, h⟩ else 1
  have hr : Set.EqOn ((map ((↑) : t → ι)).comp r) (MonoidHom.id _)
      (closure (of '' (t : Set ι))) := by
    refine MonoidHom.eqOn_closure ?_
    rintro _ ⟨i, hi, rfl⟩
    simp [r, Finset.mem_coe.mp hi]
  -- The finite basis `t` is countable, so `FreeGroup t` embeds in `FreeGroup (Fin 2)`.
  obtain ⟨k, hk⟩ := Countable.exists_injective_nat t
  refine ⟨(lift fun i : t => of (1 : Fin 2) ^ (k i : ℤ) * of 0 * (of 1 ^ (k i : ℤ))⁻¹).comp r,
    fun x hx hφ => hs x hx ?_⟩
  have hrx : r x = 1 := (map_eq_one_iff _
    (TauCeti.injective_freeGroup_lift_conj_zpow_of (Nat.cast_injective.comp hk))).1 hφ
  have hx' : map ((↑) : t → ι) (r x) = x := hr (ht x hx)
  rw [← hx', hrx, _root_.map_one]

end FreeGroup
