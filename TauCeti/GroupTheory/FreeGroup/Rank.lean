/-!
# The rank of a free group

The free group on a finite type `α` is generated by the images of the elements of `α`, so its
rank, the least number of generators, is at most the cardinality of `α`.

Conversely, a free basis has at most as many elements as any generating family. If a free group
`H` with basis `ι` is the image of `FreeGroup α` for a finite type `α`, then `ι` is finite, since
the homomorphisms `H →* ℤ/2`, which correspond to the functions `ι → ℤ/2`, are determined by their
values on the images of the elements of `α`. The bound `#ι ≤ #α` is a case of a count of
homomorphisms to `ℤ/2`: if `ι` is finite and every homomorphism `FreeGroup α →* ℤ/2` factors
through a homomorphism `FreeGroup α →* H`, then `#α ≤ #ι`. It applies to the homomorphism
`FreeGroup ι →* FreeGroup α` that sends each basis element to a preimage.

Consequently, a group with a free basis is finitely generated exactly when the basis is
finite, and its rank is the cardinality of that basis. These results allow rank computations
from explicit free coordinates, for example the non-tree edges of a graph.

The abelianization of a group with a free basis is a free abelian group with basis the classes of
the same elements (`FreeGroupBasis.abelianizationBasis`). Hence the rank of a finitely generated
free group is also the rank of its abelianization as a free `ℤ`-module
(`TauCeti.finrank_abelianization_eq_rank`).

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Cambridge University Press, 2002, Section 1.2, p. 42 (the abelianization of a free group is free
  abelian on the same basis, so the rank of a free group is well defined).
-/

public section

namespace TauCeti

/-- The free group on a finite type `α` is generated by `Nat.card α` elements. -/
theorem rank_freeGroup_le (α : Type*) [Finite α] : Group.rank (FreeGroup α) ≤ Nat.card α := by
  have := Fintype.ofFinite α
  classical
  refine (Group.rank_le (S := Finset.univ.image FreeGroup.of) ?_).trans ?_
  · rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, FreeGroup.closure_range_of]
  · exact Finset.card_image_le.trans (by simp [Nat.card_eq_fintype_card])

end TauCeti

namespace FreeGroupBasis

variable {ι α H : Type*} [Group H] {f : FreeGroup α →* H}

/-- A free basis of a group generated by the images of finitely many elements is finite. -/
theorem finite_of_surjective (b : FreeGroupBasis ι H) [Finite α] (hf : Function.Surjective f) :
    Finite ι := by
  have : Finite (ι → Multiplicative (ZMod 2)) := Finite.of_injective _ (b.injective_lift_comp hf)
  have : Nontrivial (Multiplicative (ZMod 2)) := nontrivial_of_ne (.ofAdd 1) 1 (by decide)
  by_contra hι
  have : Infinite ι := not_finite_iff_infinite.mp hι
  exact not_finite (ι → Multiplicative (ZMod 2))

/-- A finite free basis has at least as many elements as any family all of whose `ℤ/2`-valued
assignments extend to the group: if `H` has a finite free basis `ι` and every homomorphism
`FreeGroup α →* ℤ/2` factors through `f : FreeGroup α →* H`, then `#α ≤ #ι`. -/
theorem card_le_of_forall_exists_comp_eq (b : FreeGroupBasis ι H) [Finite ι]
    (h : ∀ v : α → Multiplicative (ZMod 2),
      ∃ φ : H →* Multiplicative (ZMod 2), φ.comp f = FreeGroup.lift v) :
    Nat.card α ≤ Nat.card ι := by
  obtain hα | hα := finite_or_infinite α
  swap
  · simp
  choose φ hφ using h
  have hinj : Function.Injective fun (v : α → Multiplicative (ZMod 2)) (i : ι) ↦ φ v (b i) :=
    fun v w hvw ↦ FreeGroup.lift.injective <| by
      rw [← hφ v, ← hφ w, b.ext_hom (φ v) (φ w) (congr_fun hvw)]
  simpa [Nat.card_fun, pow_le_pow_iff_right₀] using Nat.card_le_card_of_injective _ hinj

/-- A free basis has at most as many elements as a finite generating family: if `FreeGroup α`
surjects onto a free group with basis `ι`, then `#ι ≤ #α`. -/
theorem card_le_of_surjective (b : FreeGroupBasis ι H) [Finite α] (hf : Function.Surjective f) :
    Nat.card ι ≤ Nat.card α :=
  -- Every assignment `ι → ℤ/2` extends through a lift of the basis along `f`.
  (FreeGroupBasis.ofFreeGroup α).card_le_of_forall_exists_comp_eq
    (f := FreeGroup.lift fun i ↦ Function.surjInv hf (b i)) fun v ↦
      ⟨(b.lift v).comp f, FreeGroup.ext_hom _ _ fun i ↦ by simp [Function.surjInv_eq hf]⟩

/-- A free basis of a finitely generated group has finitely many elements. -/
theorem finite_of_fg (b : FreeGroupBasis ι H) [Group.FG H] : Finite ι := by
  obtain ⟨S, hS : Finite S, f, hf⟩ := Group.fg_iff_exists_freeGroup_hom_surjective.mp
    (inferInstance : Group.FG H)
  exact b.finite_of_surjective (f := f) hf

/-- A group with a free basis is finitely generated exactly when the basis is finite. -/
theorem fg_iff_finite (b : FreeGroupBasis ι H) : Group.FG H ↔ Finite ι := by
  refine ⟨fun h => b.finite_of_fg, fun h => ?_⟩
  exact Group.fg_of_surjective (f := b.repr.symm.toMonoidHom) b.repr.symm.surjective

/-- The minimum number of generators of a finitely generated free group equals the
cardinality of any of its free bases. -/
theorem rank_eq_nat_card (b : FreeGroupBasis ι H) [Group.FG H] :
    Group.rank H = Nat.card ι := by
  classical
  have := b.finite_of_fg
  refine le_antisymm ((Group.rank_congr b.repr).trans_le (TauCeti.rank_freeGroup_le ι)) ?_
  obtain ⟨S, hcard, hS⟩ := Group.rank_spec H
  have hsurj : Function.Surjective (FreeGroup.lift (Subtype.val : S → H)) := by
    rw [FreeGroup.lift_surjective_iff_closure_range_eq_top, Subtype.range_coe]
    exact hS
  simpa only [Nat.card_eq_fintype_card (α := S), Fintype.card_coe, hcard] using
    b.card_le_of_surjective hsurj

/-- **The abelianization of a free group is free abelian on the same basis.** For a free basis `b`
of `H`, the classes of the elements `b i` form a basis of the abelianization of `H`, written
additively, as a `ℤ`-module. -/
noncomputable def abelianizationBasis (b : FreeGroupBasis ι H) :
    Module.Basis ι ℤ (Additive (Group.Abelianization H)) :=
  -- `FreeAbelianGroup ι` is by definition `Additive (Group.Abelianization (FreeGroup ι))`.
  (FreeAbelianGroup.basis ι).map
    (AddEquiv.toIntLinearEquiv (M := FreeAbelianGroup ι) b.repr.symm.abelianizationCongr.toAdditive)

@[simp]
theorem abelianizationBasis_apply (b : FreeGroupBasis ι H) (i : ι) :
    b.abelianizationBasis i = .ofMul (.of (b i)) := by
  have h : FreeAbelianGroup.basis ι i = FreeAbelianGroup.of i :=
    (FreeAbelianGroup.basis ι).repr.injective <| by simp [FreeAbelianGroup.basis]
  rw [abelianizationBasis, Module.Basis.map_apply, h]
  -- `FreeAbelianGroup.of i` is by definition the additive class of `FreeGroup.of i`, which the
  -- abelianized isomorphism sends to the class of `b.repr.symm (FreeGroup.of i) = b i`.
  rfl

end FreeGroupBasis

namespace TauCeti

variable {H : Type*} [Group H]

/-- The abelianization of a free group is a free `ℤ`-module. -/
instance instModuleFreeAbelianization [IsFreeGroup H] :
    Module.Free ℤ (Additive (Group.Abelianization H)) :=
  .of_basis (IsFreeGroup.basis H).abelianizationBasis

/-- **The rank of a free group is the rank of its abelianization.** For a finitely generated free
group `H`, the rank of the abelianization of `H` as a `ℤ`-module is the rank of `H`, the least
number of generators of `H`. -/
theorem finrank_abelianization_eq_rank [IsFreeGroup H] [Group.FG H] :
    Module.finrank ℤ (Additive (Group.Abelianization H)) = Group.rank H := by
  rw [Module.finrank_eq_nat_card_basis (IsFreeGroup.basis H).abelianizationBasis,
    (IsFreeGroup.basis H).rank_eq_nat_card]

end TauCeti
