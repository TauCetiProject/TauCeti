module

public import TauCeti.GroupTheory.FreeGroup.Centralizer

/-!
# Maximal roots in free groups

Every nontrivial element `x` of a free group is a positive power `r ^ k` of exactly one element
`r` that is not a proper power; `r` is the *maximal root* of `x`. The centralizer of `x` is the
cyclic group generated by `r`, and the positive-exponent roots of `x` are exactly the powers
`r ^ (k / n)` with `n ∣ k`.

The identity is excluded: it is itself a proper power (`1 = 1 ^ 2`), so it has no maximal root,
and its centralizer is the whole group.

The results hold for every group with `IsFreeGroup`, in particular for `FreeGroup α`.

Conjugation and inversion transport maximal roots: `(g * r * g⁻¹) ^ k = g * x * g⁻¹` and
`r⁻¹ ^ k = x⁻¹`, and neither operation creates or destroys proper powers
(`Group.isProperPower_conj_iff`, `Group.isProperPower_inv`), so by uniqueness the maximal
roots of `g * x * g⁻¹` and `x⁻¹` are `g * r * g⁻¹` and `r⁻¹`, with the same exponent.

## Main results

* `IsFreeGroup.exists_maximalRoot`: a nontrivial element of a free group is `r ^ k` for a unique
  pair `(r, k)` with `k ≠ 0` and `r` not a proper power.
* `IsFreeGroup.pow_eq_pow_iff_of_not_isProperPower`: for non-proper-powers `r`, `s` and nonzero
  exponents, `r ^ k = s ^ l ↔ r = s ∧ k = l`.
* `IsFreeGroup.pow_eq_iff_dvd_and_eq_pow_div`: if `r ^ k = x` is the maximal root
  decomposition, then `y ^ n = x ↔ n ∣ k ∧ y = r ^ (k / n)` for `n ≠ 0`.
* `IsFreeGroup.centralizer_singleton_eq_zpowers`: the centralizer of `x` is generated by its
  maximal root.

* `Group.maximalRoot_conj`, `Group.maximalRoot_inv`, `Group.maximalRoot_pow`: transport
  maximal-root decompositions under conjugation, inversion, and positive powers.

## References

* O. Kharlampovich, A. Myasnikov, V. Remeslennikov, D. Serbin, *Subgroups of fully residually
  free groups: algorithmic problems*, Contemp. Math. 360 (2004), §5, proof of Lemma 21
  (maximal roots, and centralizers of nontrivial elements of a free group).
-/

/- Implementation note: the proofs avoid reduced words. The centralizer of `x ≠ 1` is cyclic
(`IsFreeGroup.isCyclic_centralizer`), a generator of it is not a proper power, and the
torsion-freeness of free groups pins down the exponents. -/

public section

open Group Subgroup

namespace IsFreeGroup

variable {G : Type*} [Group G] [IsFreeGroup G]

/-- In a free group, the centralizer of `r ^ k`, for `k ≠ 0` and `r` not a proper power, is the
cyclic group generated by `r`. -/
theorem centralizer_singleton_eq_zpowers {x r : G} {k : ℕ} (hk : k ≠ 0)
    (hr : ¬IsProperPower r) (hx : r ^ k = x) : centralizer {x} = zpowers r := by
  have hr1 := ne_one_of_not_isProperPower hr
  have hx1 : x ≠ 1 := hx ▸ (pow_eq_one_iff_left hk).not.2 hr1
  obtain ⟨t, ht⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top _).1 (isCyclic_centralizer hx1)
  have hrt : r ∈ zpowers t :=
    ht ▸ mem_centralizer_singleton_iff.2 (hx ▸ (Commute.self_pow r k).eq)
  rw [← ht]
  obtain ⟨i, rfl⟩ := mem_zpowers_iff.1 hrt
  obtain rfl | rfl := Int.natAbs_eq_iff.1 (natAbs_eq_one_of_not_isProperPower_zpow hr) <;> simp

/-- Uniqueness of maximal roots in a free group: if `r` and `s` are not proper powers and the
exponents `k`, `l` are nonzero, then `r ^ k = s ^ l` exactly when `r = s` and `k = l`. -/
theorem pow_eq_pow_iff_of_not_isProperPower {r s : G} {k l : ℕ} (hk : k ≠ 0) (hl : l ≠ 0)
    (hr : ¬IsProperPower r) (hs : ¬IsProperPower s) : r ^ k = s ^ l ↔ r = s ∧ k = l := by
  refine ⟨fun h ↦ ?_, by rintro ⟨rfl, rfl⟩; rfl⟩
  have hrs : zpowers r = zpowers s :=
    (centralizer_singleton_eq_zpowers hk hr rfl).symm.trans
      (centralizer_singleton_eq_zpowers hl hs h.symm)
  obtain ⟨j, rfl⟩ := mem_zpowers_iff.1 (hrs ▸ mem_zpowers s : s ∈ zpowers r)
  have hkj : (k : ℤ) = j * l := by
    rw [← IsMulTorsionFree.zpow_right_inj (ne_one_of_not_isProperPower hr), zpow_mul,
      zpow_natCast, zpow_natCast, h]
  obtain rfl | rfl := Int.natAbs_eq_iff.1 (natAbs_eq_one_of_not_isProperPower_zpow hs)
  · simp only [Nat.cast_one, one_mul, zpow_one, Nat.cast_inj, true_and] at hkj ⊢
    exact hkj
  · simp only [Nat.cast_one, neg_mul, one_mul] at hkj
    omega

/-- **Maximal roots in a free group.** Every nontrivial element `x` of a free group is `r ^ k`
for a unique pair `(r, k)` with `k ≠ 0` and `r` not a proper power. -/
theorem exists_maximalRoot {x : G} (hx : x ≠ 1) :
    ∃! p : G × ℕ, p.2 ≠ 0 ∧ p.1 ^ p.2 = x ∧ ¬IsProperPower p.1 := by
  obtain ⟨t, ht⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top _).1 (isCyclic_centralizer hx)
  obtain ⟨m, hm⟩ := mem_zpowers_iff.1 (ht ▸ mem_centralizer_singleton_iff.2 rfl : x ∈ _)
  -- Normalise the exponent of `x` in the generator `t` to be positive, replacing `t` by `t⁻¹`.
  obtain ⟨r, k, hrt, hk, hrk⟩ : ∃ r : G, ∃ k : ℕ, zpowers r = zpowers t ∧ k ≠ 0 ∧ r ^ k = x := by
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact hx (by simpa using hm.symm)
    obtain ⟨k, rfl | rfl⟩ := Int.eq_nat_or_neg m
    · exact ⟨t, k, rfl, by omega, by simpa using hm⟩
    · exact ⟨t⁻¹, k, zpowers_inv, by omega, by simpa [inv_pow] using hm⟩
  have hr := not_isProperPower_of_zpowers_eq_centralizer hx (hrt.trans ht)
  refine ⟨(r, k), ⟨hk, hrk, hr⟩, ?_⟩
  rintro ⟨s, l⟩ ⟨hl, hsl, hs⟩
  exact Prod.ext_iff.2 <|
    (pow_eq_pow_iff_of_not_isProperPower hl hk hs hr).1 (hsl.trans hrk.symm)

/-- The positive-exponent roots of an element of a free group are powers of its maximal root: if
`r ^ k = x` with `k ≠ 0` and `r` not a proper power, then for `n ≠ 0`, `y ^ n = x` exactly when
`n ∣ k` and `y = r ^ (k / n)`. -/
theorem pow_eq_iff_dvd_and_eq_pow_div {x r y : G} {k n : ℕ} (hk : k ≠ 0)
    (hr : ¬IsProperPower r) (hx : r ^ k = x) (hn : n ≠ 0) :
    y ^ n = x ↔ n ∣ k ∧ y = r ^ (k / n) := by
  constructor
  · intro hy
    have hyr : y ∈ zpowers r := centralizer_singleton_eq_zpowers hk hr hx ▸
      mem_centralizer_singleton_iff.2 (hy ▸ (Commute.self_pow y n).eq)
    obtain ⟨j, rfl⟩ := mem_zpowers_iff.1 hyr
    have hjn : j * n = k := by
      rw [← IsMulTorsionFree.zpow_right_inj (ne_one_of_not_isProperPower hr), zpow_mul,
        zpow_natCast, zpow_natCast, hy, hx]
    have hj0 : 0 ≤ j := by
      by_contra hj
      have := Int.mul_neg_of_neg_of_pos (not_le.1 hj) (by omega : (0 : ℤ) < n)
      omega
    lift j to ℕ using hj0
    norm_cast at hjn
    subst hjn
    exact ⟨Dvd.intro_left j rfl, by rw [Nat.mul_div_cancel _ (Nat.pos_of_ne_zero hn), zpow_natCast]⟩
  · rintro ⟨⟨c, rfl⟩, rfl⟩
    rw [Nat.mul_div_cancel_left c (Nat.pos_of_ne_zero hn), ← pow_mul, mul_comm, hx]

end IsFreeGroup
