/-!
# Reduced words in free groups

Elementary facts about reduced words complementing `Mathlib.GroupTheory.FreeGroup.Reduce`:
the formal inverse of a one-letter word, uniqueness of reduced representatives, reducedness of
formal inverses and of words of constant sign, powers of a letter, compatibility of formal
inversion with subwords, and reducedness of words `w u w⁻¹` in which no letter cancels at either
join. The reduced word of a product `of a * of b` of two generators is `[(a, true), (b, true)]`
(`FreeGroup.toWord_of_mul_of`).
A word without repeated generators is reduced, a reduced word representing the identity is
empty, a word that is not reduced admits a step of free reduction, and inserting a letter followed
by its inverse does not change the element represented.
Free reductions are non-crossing: in a trivial word, the subword between the only two occurrences
of a generator is trivial; and a cancelling pair in a concatenation of reduced words straddles
two consecutive nonempty words.

The last section controls cancellation under left multiplication: if the reduced word of `g` does
not begin with the formal inverse of `x₂`, then the reduced word of `(x₁ ++ x₂) * g` still begins
with `x₁` whenever `x₁ ++ x₂` is reduced. This is the prefix calculus behind ping-pong arguments
on reduced words, such as the big powers property of free groups.

Finally, the reduced word of `g⁻¹ * f` arises from those of `g` and `f` by cancelling their
longest common prefix, so `‖g⁻¹ * f‖ + 2 * commonPrefixLength g f = ‖g‖ + ‖f‖` for the word
length `‖·‖`. Thus the Gromov product of word length is the common prefix length of reduced
words, and the parity of word length is additive (`FreeGroup.even_norm_mul_iff`).

The subgroup generated by a set `s` of free generators consists of the elements whose reduced
word uses only letters of `s` (`FreeGroup.mem_closure_image_of_iff`). Consequently a free
generator lies in it exactly when it belongs to `s` (`FreeGroup.of_mem_closure_image_of_iff`),
and the subgroups generated by two sets of free generators meet in the subgroup generated by
their intersection (`FreeGroup.closure_image_of_inter`). For distinct free generators `a ≠ b`,
the product `a ^ p * b ^ q` is trivial only for `p = q = 0`
(`FreeGroup.of_zpow_mul_of_zpow_eq_one_iff`).
-/

public section

namespace FreeGroup

variable {α : Type*}

/-- The inverse of a one-letter word is the inverse letter. -/
theorem inv_mk_singleton (w : α × Bool) : (mk [w])⁻¹ = mk [(w.1, !w.2)] := by
  simp [inv_mk, invRev]

/-- The word consisting of `n` copies of a letter represents the `n`-th power of that letter. -/
theorem mk_replicate (n : ℕ) (y : α × Bool) : mk (List.replicate n y) = mk [y] ^ n := by
  simpa only [List.flatten_replicate_singleton] using (pow_mk (L := [y]) n).symm

/-- A word made of copies of a single letter is reduced. -/
@[simp] theorem isReduced_replicate (n : ℕ) (y : α × Bool) : IsReduced (List.replicate n y) :=
  List.isChain_replicate_of_rel n fun _ => rfl

/-- Reduced words representing the same element of a free group are equal. -/
theorem IsReduced.eq_of_mk_eq {u v : List (α × Bool)} (hu : IsReduced u) (hv : IsReduced v)
    (h : mk u = mk v) : u = v := by
  classical
  rw [← hu.reduce_eq, ← hv.reduce_eq, reduce.sound h]

/-- The formal inverse of a reduced word is reduced. -/
theorem IsReduced.invRev {w : List (α × Bool)} (hw : IsReduced w) :
    IsReduced (invRev w) := by
  classical
  have h := isReduced_toWord (x := mk (FreeGroup.invRev w))
  rwa [toWord_mk, reduce_invRev, hw.reduce_eq] at h

/-- A formal inverse is reduced exactly when the original word is. -/
@[simp]
theorem isReduced_invRev {w : List (α × Bool)} : IsReduced (invRev w) ↔ IsReduced w :=
  ⟨fun h => by simpa using IsReduced.invRev h, IsReduced.invRev⟩

/-- A word all of whose letters have the same sign is reduced. -/
theorem isReduced_of_forall_snd_eq :
    ∀ {w : List (α × Bool)} {e : Bool}, (∀ x ∈ w, x.2 = e) → IsReduced w
  | [], _, _ => .nil
  | [_], _, _ => .singleton
  | a :: b :: w, _, h =>
    isReduced_cons_cons.2 ⟨fun _ ↦ (h a (by simp)).trans (h b (by simp)).symm,
      isReduced_of_forall_snd_eq fun x hx ↦ h x (List.mem_cons_of_mem _ hx)⟩

/-- A word is a subword of another exactly when their formal inverses are. -/
@[simp]
theorem invRev_isInfix_invRev {u v : List (α × Bool)} : invRev u <:+: invRev v ↔ u <:+: v := by
  suffices h : ∀ {u v : List (α × Bool)}, u <:+: v → invRev u <:+: invRev v from
    ⟨fun huv ↦ by simpa using h huv, h⟩
  rintro u v ⟨s, t, rfl⟩
  exact ⟨invRev t, invRev s, by simp [List.append_assoc]⟩

/-- If `w` and the nonempty word `u` are reduced, the last letter of `w` does not cancel against
the first letter of `u`, and the last letter of `u` does not cancel against the first letter of
`invRev w`, then `w ++ u ++ invRev w` is reduced. -/
theorem IsReduced.append_append_invRev {w u : List (α × Bool)} (hw : IsReduced w)
    (hu : IsReduced u) (hu₀ : u ≠ [])
    (hhead : ∀ a ∈ w.getLast?, (a.1, !a.2) ∉ u.head?)
    (hlast : ∀ a ∈ w.getLast?, a ∉ u.getLast?) :
    IsReduced (w ++ u ++ FreeGroup.invRev w) := by
  refine List.isChain_append.mpr ⟨List.isChain_append.mpr ⟨hw, hu, ?_⟩, hw.invRev, ?_⟩
  · intro x hx y hy hxy
    have := hhead x hx
    rw [Option.mem_def.mp hy] at this
    cases x; cases y
    simp_all
  · intro x hx y hy hxy
    rw [List.getLast?_append_of_ne_nil _ hu₀] at hx
    simp only [FreeGroup.invRev, List.head?_reverse, List.getLast?_map, Option.mem_def,
      Option.map_eq_some_iff] at hy
    obtain ⟨z, hz, rfl⟩ := hy
    have := hlast z hz
    rw [Option.mem_def.mp hx] at this
    cases x; cases z
    simp_all [Bool.eq_not]

/-- A nonempty reduced word is never its own formal inverse: otherwise it would represent an
element of order at most two of the torsion-free group `FreeGroup α`. -/
theorem IsReduced.invRev_ne_self {w : List (α × Bool)} (hw : IsReduced w) (hw₀ : w ≠ []) :
    FreeGroup.invRev w ≠ w := by
  intro h
  have hsq : mk w ^ 2 = 1 := by
    rw [pow_two]
    nth_rw 1 [← h]
    rw [← inv_mk, inv_mul_cancel]
  rw [pow_eq_one_iff_left (Nat.succ_ne_zero 1), one_eq_mk] at hsq
  exact hw₀ (hw.eq_of_mk_eq IsReduced.nil hsq)

/-- Conjugating a nonempty reduced word not involving the generator `x` by the letter `(x, b)`
gives a reduced word. -/
theorem IsReduced.singleton_append_append_invRev {R : List (α × Bool)} {x : α} {b : Bool}
    (hR : IsReduced R) (hR₀ : R ≠ []) (hxR : x ∉ R.map Prod.fst) :
    IsReduced ([(x, b)] ++ R ++ FreeGroup.invRev [(x, b)]) := by
  refine IsReduced.singleton.append_append_invRev hR hR₀ ?_ ?_ <;>
    intro a ha <;> rw [List.getLast?_singleton, Option.mem_some_iff] at ha <;> subst ha <;>
    intro hmem <;> apply hxR
  exacts [List.mem_map_of_mem (List.mem_of_mem_head? hmem),
    List.mem_map_of_mem (List.mem_of_mem_getLast? hmem)]

/-- A word in which no generator occurs twice is reduced. -/
theorem isReduced_of_nodup_map_fst {L : List (α × Bool)} (h : (L.map Prod.fst).Nodup) :
    IsReduced L :=
  ((List.pairwise_map.1 h).imp fun hab heq => absurd heq hab).isChain

/-- A reduced word representing the identity is empty. -/
theorem IsReduced.eq_nil_of_mk_eq_one {L : List (α × Bool)} (hL : IsReduced L) (h : mk L = 1) :
    L = [] :=
  hL.eq_of_mk_eq IsReduced.nil (h.trans one_eq_mk)

/-- If the product of two reduced words is trivial, the second is the formal inverse of the
first. -/
theorem IsReduced.eq_invRev_of_mk_append_eq_one {L₁ L₂ : List (α × Bool)} (h₁ : IsReduced L₁)
    (h₂ : IsReduced L₂) (h : mk (L₁ ++ L₂) = 1) : L₂ = FreeGroup.invRev L₁ := by
  refine h₂.eq_of_mk_eq h₁.invRev ?_
  rw [← inv_mk]
  exact eq_inv_of_mul_eq_one_right (by rwa [mul_mk])

/-- A word that is not reduced contains a letter followed by its inverse. -/
theorem exists_eq_append_cons_cons_of_not_isReduced {L : List (α × Bool)} (h : ¬IsReduced L) :
    ∃ L₁ L₂ x b, L = L₁ ++ (x, b) :: (x, !b) :: L₂ := by
  simp only [isReduced_iff_not_step, not_forall, not_not] at h
  obtain ⟨_, ⟨⟩⟩ := h
  exact ⟨_, _, _, _, rfl⟩

/-- A step of free reduction does not change the element represented. -/
theorem Red.Step.mk_eq {L₁ L₂ : List (α × Bool)} (h : Red.Step L₁ L₂) : mk L₁ = mk L₂ :=
  Red.exact.2 ⟨_, h.to_red, Red.refl⟩

/-- **Non-crossing of free reductions.** If the generator `x` occurs in the trivial word
`P (x, b) M (x, !b) Q` only at the two displayed positions, then the subword `M` between them is
trivial. -/
theorem mk_eq_one_of_mk_append_cons_append_cons_eq_one {P M Q : List (α × Bool)} {x : α} {b : Bool}
    (hP : x ∉ P.map Prod.fst) (hM : x ∉ M.map Prod.fst) (hQ : x ∉ Q.map Prod.fst)
    (h : mk (P ++ (x, b) :: (M ++ (x, !b) :: Q)) = 1) : mk M = 1 := by
  classical
  by_contra hM₁
  -- Otherwise the reduced word `(x, b) R (x, !b)` of `x^b M x^-b`, with `R` the reduced word of
  -- `M`, would be the reduced word of `P⁻¹ Q⁻¹`, which does not contain `x`.
  set R := (mk M).toWord with hR
  have hRM : R.Sublist M := by rw [hR, toWord_mk]; exact reduce.red.sublist
  have hR₀ : R ≠ [] := fun h₀ => hM₁ (by rw [← mk_toWord (x := mk M), ← hR, h₀, one_eq_mk])
  have hxR : x ∉ R.map Prod.fst := fun hx => hM ((hRM.map _).subset hx)
  have hmk : mk ([(x, b)] ++ R ++ invRev [(x, b)]) = mk (invRev P ++ invRev Q) := by
    have hC : mk ([(x, b)] ++ R ++ invRev [(x, b)]) = mk ([(x, b)] ++ M ++ [(x, !b)]) := by
      rw [← mul_mk, ← mul_mk, ← mul_mk, ← mul_mk, hR, mk_toWord]
      simp [invRev]
    have h' : mk P * mk ([(x, b)] ++ R ++ invRev [(x, b)]) * mk Q = 1 := by
      rw [hC, ← h]
      simp
    have hPQ : (mk P)⁻¹ * (mk Q)⁻¹ = mk (invRev P ++ invRev Q) := by
      rw [inv_mk, inv_mk, mul_mk]
    rw [← hPQ]
    exact eq_inv_mul_of_mul_eq (eq_inv_of_mul_eq_one_left h')
  have hsub := (reduce.red (L := invRev P ++ invRev Q)).sublist
  rw [← reduce.sound hmk, (isReduced_toWord.singleton_append_append_invRev hR₀ hxR).reduce_eq]
    at hsub
  have hmem := hsub.subset (List.mem_append_left _ (List.mem_append_left _
    (List.mem_singleton_self (x, b))))
  simp only [invRev, List.mem_append, List.mem_reverse, List.mem_map, Prod.mk.injEq] at hmem
  rcases hmem with ⟨a, ha, rfl, -⟩ | ⟨a, ha, rfl, -⟩
  exacts [hP (List.mem_map_of_mem ha), hQ (List.mem_map_of_mem ha)]

/-- In a list of reduced words whose concatenation contains a letter followed by its inverse,
the letter ends one of the words and its inverse begins the next nonempty word. -/
theorem exists_eq_append_cons_append_cons_of_flatten_eq {ws : List (List (α × Bool))}
    (hws : ∀ w ∈ ws, IsReduced w) {L₁ L₂ : List (α × Bool)} {x : α} {b : Bool}
    (h : ws.flatten = L₁ ++ (x, b) :: (x, !b) :: L₂) :
    ∃ pre w₁ mid w₂ post, ws = pre ++ (w₁ ++ [(x, b)]) :: (mid ++ ((x, !b) :: w₂) :: post) ∧
      ∀ w ∈ mid, w = [] := by
  induction ws generalizing L₁ with
  | nil => simp at h
  | cons w ws ih =>
    have hws' : ∀ w ∈ ws, IsReduced w := fun w hw => hws w (List.mem_cons_of_mem _ hw)
    rw [List.flatten_cons, List.append_eq_append_iff] at h
    rcases h with ⟨as, rfl, h⟩ | ⟨bs, rfl, h⟩
    · obtain ⟨pre, w₁, mid, w₂, post, rfl, hmid⟩ := ih hws' h
      exact ⟨w :: pre, w₁, mid, w₂, post, rfl, hmid⟩
    · rcases bs with _ | ⟨c, _ | ⟨d, bs⟩⟩
      · -- The pair lies in the later words.
        obtain ⟨pre, w₁, mid, w₂, post, rfl, hmid⟩ := ih (L₁ := []) hws' (by simpa using h.symm)
        exact ⟨(L₁ ++ []) :: pre, w₁, mid, w₂, post, rfl, hmid⟩
      · -- The letter ends `w`; its inverse begins the next nonempty word.
        simp only [List.cons_append, List.nil_append, List.cons.injEq] at h
        obtain ⟨rfl, h⟩ := h
        obtain ⟨mid, w₂, post, rfl, hmid, -⟩ := List.flatten_eq_cons_iff.1 h.symm
        exact ⟨[], L₁, mid, w₂, post, rfl, hmid⟩
      · -- The pair would lie inside the reduced word `w`.
        simp only [List.cons_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl, -⟩ := h
        have hw := (hws _ List.mem_cons_self).infix (L₁ := [(x, b), (x, !b)]) ⟨L₁, bs, by simp⟩
        simp [isReduced_cons_cons] at hw

/-- Inserting a letter followed by its inverse does not change the element represented. -/
theorem mk_append_cons_cons_of_ne {X Y : List (α × Bool)} {x : α} {b c : Bool} (hbc : b ≠ c) :
    mk (X ++ (x, b) :: (x, c) :: Y) = mk (X ++ Y) := by
  obtain rfl := Bool.eq_not_of_ne hbc.symm
  exact Red.Step.not.mk_eq

section Prefix

open List

variable [DecidableEq α]

/-- If the reduced word of `g` begins with the formal inverse of `x`, then left multiplication by
`x` cancels that prefix. -/
theorem toWord_mk_mul_of_invRev_prefix {x : List (α × Bool)} {g : FreeGroup α}
    (h : invRev x <+: g.toWord) : (mk x * g).toWord = g.toWord.drop x.length := by
  obtain ⟨y, hy⟩ := h
  have hred : IsReduced y := isReduced_toWord.infix ⟨invRev x, [], by rw [append_nil, hy]⟩
  have hmul : mk x * g = mk y := by
    rw [← mk_toWord (x := g), ← hy, ← mul_mk, ← inv_mk]
    exact mul_inv_cancel_left _ _
  rw [hmul, toWord_mk, hred.reduce_eq, ← hy, drop_left' invRev_length]

omit [DecidableEq α] in
/-- In a reduced word, a letter is never followed by its inverse. -/
theorem ne_inv_of_isReduced_cons_cons {a b : α × Bool} {l : List (α × Bool)}
    (h : IsReduced (a :: b :: l)) : b ≠ (a.1, !a.2) := by
  rintro rfl
  simpa using (isReduced_cons_cons.1 h).1 rfl

/-- Left multiplication by a letter that does not cancel prepends it to the reduced word. -/
theorem toWord_mk_singleton_mul_of_head?_ne {a : α × Bool} {g : FreeGroup α}
    (h : g.toWord.head? ≠ some (a.1, !a.2)) : (mk [a] * g).toWord = a :: g.toWord := by
  obtain ⟨a₁, a₂⟩ := a
  simp [toWord_mk_mul_eq, h]

/-- The reduced word of a product of two generators is the two-letter word: no letter cancels. -/
@[simp]
theorem toWord_of_mul_of (a b : α) : (of a * of b).toWord = [(a, true), (b, true)] := by
  rw [toWord_mul, toWord_of, toWord_of, singleton_append, ← isReduced_iff_reduce_eq]
  simp

/-- If `x` is reduced and the reduced word of `g` does not begin with the formal inverse of `x`,
then the first letter of `x` survives in the reduced word of `x * g`. -/
theorem head?_toWord_mk_mul {x : List (α × Bool)} {g : FreeGroup α} (hx : IsReduced x)
    (h : ¬invRev x <+: g.toWord) : (mk x * g).toWord.head? = x.head? := by
  induction x with
  | nil => simp [invRev] at h
  | cons b x ih =>
    rw [← singleton_append, ← mul_mk, mul_assoc]
    suffices hb : (mk x * g).toWord.head? ≠ some (b.1, !b.2) by
      rw [toWord_mk_singleton_mul_of_head?_ne hb, head?_cons, singleton_append, head?_cons]
    by_cases hx' : invRev x <+: g.toWord
    · -- The word `x` cancels completely; the letter after it is not `b⁻¹`.
      rw [toWord_mk_mul_of_invRev_prefix hx']
      intro hhead
      apply h
      obtain ⟨y, hy⟩ := hx'
      rw [← hy, drop_left' invRev_length] at hhead
      obtain ⟨y', rfl⟩ : ∃ y', y = (b.1, !b.2) :: y' := ⟨y.tail, (cons_head?_tail hhead).symm⟩
      exact ⟨y', by simpa [invRev_cons, invRev] using hy⟩
    · -- The word `x` is not cancelled, so its first letter survives and is not `b⁻¹`.
      cases x with
      | nil => simp [invRev] at hx'
      | cons c x =>
        rw [ih (hx.infix ⟨[b], [], by simp⟩) hx', head?_cons, Ne, Option.some_inj]
        exact ne_inv_of_isReduced_cons_cons hx

/-- If `x₁ ++ x₂` is reduced and the reduced word of `g` does not begin with the formal inverse of
`x₂`, then the reduced word of `(x₁ ++ x₂) * g` begins with `x₁`: the cancellation between the
two factors stops inside `x₂`. -/
theorem prefix_toWord_mk_append_mul {x₁ x₂ : List (α × Bool)} {g : FreeGroup α}
    (hx : IsReduced (x₁ ++ x₂)) (h : ¬invRev x₂ <+: g.toWord) :
    x₁ <+: (mk (x₁ ++ x₂) * g).toWord := by
  induction x₁ with
  | nil => exact nil_prefix
  | cons a x₁ ih =>
    have hx' : IsReduced (x₁ ++ x₂) := hx.infix ⟨[a], [], by simp⟩
    have hhead : (mk (x₁ ++ x₂) * g).toWord.head? ≠ some (a.1, !a.2) := by
      cases x₁ with
      | cons b x₁ =>
        obtain ⟨z, hz⟩ := ih hx'
        rw [← hz, cons_append, head?_cons, Ne, Option.some_inj]
        exact ne_inv_of_isReduced_cons_cons hx
      | nil =>
        rw [nil_append] at hx' ⊢
        rw [head?_toWord_mk_mul hx' h]
        cases x₂ with
        | nil => simp [invRev] at h
        | cons b x₂ =>
          rw [head?_cons, Ne, Option.some_inj]
          exact ne_inv_of_isReduced_cons_cons hx
    rw [cons_append, ← singleton_append (l := x₁ ++ x₂), ← mul_mk, mul_assoc,
      toWord_mk_singleton_mul_of_head?_ne hhead]
    exact (prefix_cons_inj a).2 (ih hx')

end Prefix

section CommonPrefix

variable [DecidableEq α]

/-- For reduced words `u` and `v`, the reduced word of `(mk u)⁻¹ * mk v` has length
`u.length + v.length - 2 * commonPrefixLength u v`. Intuitively, this reduced word arises from
`invRev u ++ v` by cancelling the longest common prefix of `u` and `v`. -/
theorem length_toWord_inv_mk_mul_mk {u v : List (α × Bool)} (hu : IsReduced u)
    (hv : IsReduced v) :
    ((mk u)⁻¹ * mk v).toWord.length + 2 * List.commonPrefixLength u v = u.length + v.length := by
  induction u generalizing v with
  | nil => simp [hv.reduce_eq]
  | cons a u ih =>
    cases v with
    | nil => simp [inv_mk, hu.invRev.reduce_eq]
    | cons b v =>
      by_cases hab : a = b
      · subst hab
        have hmul : (mk (a :: u))⁻¹ * mk (a :: v) = (mk u)⁻¹ * mk v := by
          simp only [← List.singleton_append (l := u), ← List.singleton_append (l := v), ← mul_mk,
            mul_inv_rev, mul_assoc, inv_mul_cancel_left]
        have := ih (hu.infix (List.suffix_cons a u).isInfix)
          (hv.infix (List.suffix_cons a v).isInfix)
        simp only [hmul, List.commonPrefixLength_cons_cons, ite_true, List.length_cons]
        omega
      · -- No letter cancels: `invRev (a :: u)` ends with `a⁻¹`, and `b ≠ a`.
        have hred : IsReduced (invRev (a :: u) ++ b :: v) := by
          refine List.isChain_append.2 ⟨hu.invRev, hv, fun x hx y hy hxy => ?_⟩
          simp only [invRev, List.map_cons, List.reverse_cons, List.getLast?_append,
            List.getLast?_singleton, Option.some_or, Option.mem_def, Option.some.injEq] at hx
          simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hy
          subst hx hy
          obtain ⟨a₁, a₂⟩ := a
          obtain ⟨b₁, b₂⟩ := b
          simp only at hxy ⊢
          subst hxy
          cases a₂ <;> cases b₂ <;> simp_all
        rw [inv_mk, mul_mk, toWord_mk, hred.reduce_eq]
        simp [hab]

/-- The word length of `g⁻¹ * f` is the sum of the word lengths of `g` and `f` minus twice the
length of the longest common prefix of their reduced words. -/
theorem norm_inv_mul_add_two_mul_commonPrefixLength (g f : FreeGroup α) :
    norm (g⁻¹ * f) + 2 * List.commonPrefixLength g.toWord f.toWord = norm g + norm f := by
  have h := length_toWord_inv_mk_mul_mk (isReduced_toWord (x := g)) (isReduced_toWord (x := f))
  rwa [mk_toWord, mk_toWord] at h

/-- The parity of word length is additive: `g * f` has even word length exactly when the word
lengths of `g` and `f` have the same parity. -/
theorem even_norm_mul_iff (g f : FreeGroup α) :
    Even (norm (g * f)) ↔ (Even (norm g) ↔ Even (norm f)) := by
  have h := norm_inv_mul_add_two_mul_commonPrefixLength g⁻¹ f
  rw [inv_inv, norm_inv_eq] at h
  grind

/-- Every element of a subgroup generated by elements of even word length has even word
length. -/
theorem even_norm_of_mem_closure {S : Set (FreeGroup α)} (hS : ∀ s ∈ S, Even (norm s))
    {g : FreeGroup α} (hg : g ∈ Subgroup.closure S) : Even (norm g) := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact hS x hx
  | one => simp
  | mul x y _ _ hx hy => simp [even_norm_mul_iff, hx, hy]
  | inv x _ hx => rwa [norm_inv_eq]

end CommonPrefix

section Induction

variable [DecidableEq α]

/-- Induction along reduced words: a property of `1` that passes from `g` to `g * mk [x]`
whenever the reduced word of `g * mk [x]` is that of `g` followed by `x` holds for every element
of the free group. -/
@[elab_as_elim]
theorem induction_on_reduced {motive : FreeGroup α → Prop} (g : FreeGroup α) (one : motive 1)
    (mul_mk_singleton : ∀ g x, (g * mk [x]).toWord = g.toWord ++ [x] → motive g →
      motive (g * mk [x])) :
    motive g := by
  suffices ∀ L : List (α × Bool), IsReduced L → motive (mk L) by
    simpa only [mk_toWord] using this g.toWord isReduced_toWord
  intro L
  induction L using List.reverseRecOn with
  | nil => exact fun _ => one_eq_mk (α := α) ▸ one
  | append_singleton L x ih =>
    intro hL
    have hL' : IsReduced L := hL.infix (List.prefix_append L [x]).isInfix
    rw [← mul_mk]
    refine mul_mk_singleton _ _ ?_ (ih hL')
    rw [mul_mk, toWord_mk, hL.reduce_eq, toWord_mk, hL'.reduce_eq]

end Induction

/-- An element of a free group lies in the subgroup generated by a set `s` of free generators
exactly when every letter of its reduced word lies in `s`. -/
theorem mem_closure_image_of_iff [DecidableEq α] {s : Set α} {g : FreeGroup α} :
    g ∈ Subgroup.closure (of '' s) ↔ ∀ l ∈ g.toWord, l.1 ∈ s := by
  refine ⟨fun h => ?_, fun h => ?_⟩
  · induction h using Subgroup.closure_induction with
    | mem x hx => obtain ⟨a, ha, rfl⟩ := hx; simpa using ha
    | one => simp
    | mul x y _ _ hx hy =>
      intro l hl
      rw [toWord_mul] at hl
      exact (List.mem_append.1 (reduce.red.sublist.subset hl)).elim (hx l) (hy l)
    | inv x _ hx =>
      intro l hl
      rw [toWord_inv, invRev, List.mem_reverse, List.mem_map] at hl
      obtain ⟨m, hm, rfl⟩ := hl
      exact hx m hm
  · simpa only [mk_toWord, lift_of_apply] using lift_mk_mem_closure_image of h

/-- A free generator lies in the subgroup generated by a set of free generators exactly when it
is one of them. -/
@[simp]
theorem of_mem_closure_image_of_iff {s : Set α} {a : α} :
    of a ∈ Subgroup.closure (of '' s) ↔ a ∈ s := by
  classical
  simp [mem_closure_image_of_iff]

/-- The subgroup generated by a single free generator `of b` contains the free generator `of a`
exactly when `a = b`. -/
@[simp]
theorem of_mem_closure_singleton_of_iff {a b : α} :
    of a ∈ Subgroup.closure ({of b} : Set (FreeGroup α)) ↔ a = b := by
  rw [← Set.image_singleton, of_mem_closure_image_of_iff, Set.mem_singleton_iff]

/-- The free generator `of a` is an integer power of the free generator `of b` exactly when
`a = b`. -/
@[simp]
theorem of_mem_zpowers_of_iff {a b : α} : of a ∈ Subgroup.zpowers (of b) ↔ a = b := by
  rw [Subgroup.zpowers_eq_closure, of_mem_closure_singleton_of_iff]

/-- The subgroups generated by two sets of free generators meet in the subgroup generated by
their intersection. -/
theorem closure_image_of_inter (s t : Set α) :
    Subgroup.closure (of '' (s ∩ t)) =
      Subgroup.closure (of '' s) ⊓ Subgroup.closure (of '' t) := by
  classical
  ext w
  simp [Subgroup.mem_inf, mem_closure_image_of_iff, imp_and, forall_and]

/-- For distinct generators `a ≠ b` of a free group, `a ^ p * b ^ q = 1` only for `p = q = 0`.
In particular `a ^ p * b ^ q ≠ 1` for all `p, q ≥ 1`: the noncommuting pair `(a, b)` satisfies the
big powers condition with bound `1`. -/
@[simp]
theorem of_zpow_mul_of_zpow_eq_one_iff {a b : α} (hab : a ≠ b) {p q : ℤ} :
    of a ^ p * of b ^ q = 1 ↔ p = 0 ∧ q = 0 := by
  refine ⟨fun h => ?_, fun ⟨hp, hq⟩ => by simp [hp, hq]⟩
  simpa using eq_of_of_zpow_eq_of_zpow hab ((mul_eq_one_iff_eq_inv.1 h).trans (zpow_neg _ q).symm)

end FreeGroup
