module

public import TauCeti.GroupTheory.CSA
public import TauCeti.GroupTheory.FreeGroup.MaximalRoot

/-!
# Free groups are CSA

Let `u` be a nontrivial element of a free group which is not a proper power. Then the cyclic
subgroup `zpowers u` is a maximal abelian subgroup, and it is malnormal: an element conjugating a
nonidentity power of `u` back into `zpowers u` already lies in `zpowers u`. Since every maximal
abelian subgroup of a nontrivial free group is of this form, every free group is a CSA group, and
commutation is transitive on its nontrivial elements.

The hypothesis that `u` is not a proper power is needed: for `u = a ^ 2` the element `a` lies
outside `zpowers u` but commutes with `u`. Both malnormality and maximality characterize the
non-proper-powers among the nontrivial elements.

The argument avoids reduced words. If `g * u ^ m * g⁻¹ = u ^ n` with `u ^ m ≠ 1`, commutation
transitivity through `u ^ n` shows that `g * u * g⁻¹` commutes with `u`, so it lies in
`zpowers u`, the centralizer of `u`. Since `g * u * g⁻¹` is not a proper power, it is `u` or
`u⁻¹`. A nontrivial element of a free group is not conjugate to its inverse
(`Group.IsCommTransitive.not_isConj_inv`), so `g` commutes with `u` and lies in `zpowers u`.

The file also records that `FreeGroup (Fin 2) × Multiplicative ℤ` is not CSA: the free group on
two generators is nonabelian, but its product with a nontrivial abelian group has a nonidentity
central element.

## Main results

* `IsFreeGroup.isCommTransitive`: commutation is transitive on the nontrivial elements of a free
  group.
* `IsFreeGroup.isTISubgroup_zpowers`: the cyclic subgroup generated by a non-proper-power is
  malnormal.
* `IsFreeGroup.maximal_isMulCommutative_zpowers`: the cyclic subgroup generated by a
  non-proper-power is maximal abelian.
* `IsFreeGroup.maximal_isMulCommutative_iff`: the maximal abelian subgroups of a nontrivial free
  group are exactly the cyclic subgroups generated by non-proper-powers.
* `IsFreeGroup.isCSA`: every free group is CSA.
* `Group.not_isCSA_prod_int`: `FreeGroup (Fin 2) × Multiplicative ℤ` is not CSA.

## References

* G. Baumslag, A. Myasnikov, V. Remeslennikov, *Algebraic geometry over groups I. Algebraic sets
  and ideal theory*, J. Algebra 219 (1999), §1 and §2.1 (CSA groups; free groups are CSA).
* O. Kharlampovich, A. Myasnikov, V. Remeslennikov, D. Serbin, *Subgroups of fully residually
  free groups: algorithmic problems*, Contemp. Math. 360 (2004), §4 (malnormal subgroups) and
  §5, proof of Lemma 21 (centralizers in free groups).
-/

public section

open Group Subgroup

namespace IsFreeGroup

variable {G : Type*} [Group G] [IsFreeGroup G]

/-- Commutation is transitive on the nontrivial elements of a free group. -/
theorem isCommTransitive : IsCommTransitive G :=
  (isCommTransitive_iff G).2 fun _ _ _ hy hxy hyz => commute_of_commute hy hxy hyz

/-- In a free group, an element conjugating a non-proper-power `u` into `zpowers u` lies in
`zpowers u`. -/
private theorem mem_zpowers_of_conj_mem_zpowers {u g : G} (hu : ¬IsProperPower u)
    (h : g * u * g⁻¹ ∈ zpowers u) : g ∈ zpowers u := by
  obtain ⟨j, hj⟩ := mem_zpowers_iff.1 h
  have hj1 : j.natAbs = 1 :=
    natAbs_eq_one_of_not_isProperPower_zpow (hj ▸ (isProperPower_conj_iff g u).not.2 hu)
  obtain rfl | rfl := Int.natAbs_eq_iff.1 hj1
  · rw [← centralizer_singleton_eq_zpowers_self hu,
      mem_centralizer_singleton_iff]
    simp only [Nat.cast_one, zpow_one] at hj
    exact mul_inv_eq_iff_eq_mul.1 hj.symm
  · refine absurd (isConj_iff.2 ⟨g, ?_⟩)
      (isCommTransitive.not_isConj_inv (ne_one_of_not_isProperPower hu))
    simpa using hj.symm

/-- **Maximal cyclic subgroups of a free group are malnormal.** If `u` is not a proper power,
then an element outside `zpowers u` conjugates no nonidentity element of `zpowers u` back into
`zpowers u`. -/
theorem isTISubgroup_zpowers {u : G} (hu : ¬IsProperPower u) :
    TauCeti.IsTISubgroup (zpowers u) := by
  refine TauCeti.isTISubgroup_iff.2 fun g x hg hx hgx => ?_
  by_contra hx1
  obtain ⟨m, rfl⟩ := mem_zpowers_iff.1 hx
  obtain ⟨n, hn⟩ := mem_zpowers_iff.1 hgx
  have hy : (g * u * g⁻¹) ^ m ≠ 1 := by
    rwa [conj_zpow, Ne, conj_eq_one_iff]
  -- `g * u * g⁻¹` commutes with its power `g * u ^ m * g⁻¹ = u ^ n`, which commutes with `u`.
  have hcomm : Commute (g * u * g⁻¹) u :=
    commute_of_commute hy (Commute.self_zpow _ m) (by rw [conj_zpow, ← hn]; exact .zpow_self u n)
  refine hg (mem_zpowers_of_conj_mem_zpowers hu ?_)
  rw [← centralizer_singleton_eq_zpowers_self hu]
  exact mem_centralizer_singleton_iff.2 hcomm.eq

/-- In a free group, the cyclic subgroup generated by a non-proper-power is a maximal abelian
subgroup. -/
theorem maximal_isMulCommutative_zpowers {u : G} (hu : ¬IsProperPower u) :
    Maximal (fun K : Subgroup G => IsMulCommutative K) (zpowers u) := by
  refine ⟨inferInstance, fun K hK hle => ?_⟩
  have hK : IsMulCommutative K := hK
  have hC : centralizer (zpowers u : Set G) = zpowers u := by
    rw [zpowers_eq_closure, centralizer_closure, ← zpowers_eq_closure,
      centralizer_singleton_eq_zpowers_self hu]
  exact (eq_of_centralizer_eq_self_of_le_of_isMulCommutative hC hle).le

/-- A nontrivial element `u` of a free group generates a malnormal subgroup exactly when `u` is
not a proper power. -/
theorem isTISubgroup_zpowers_iff {u : G} (hu : u ≠ 1) :
    TauCeti.IsTISubgroup (zpowers u) ↔ ¬IsProperPower u := by
  refine ⟨fun h => not_isProperPower_of_zpowers_eq_centralizer hu ?_, isTISubgroup_zpowers⟩
  exact le_antisymm (zpowers_le_centralizer_singleton u)
    (h.centralizer_singleton_le (mem_zpowers u) hu)

/-- A nontrivial element `u` of a free group generates a maximal abelian subgroup exactly when
`u` is not a proper power. -/
theorem maximal_isMulCommutative_zpowers_iff {u : G} (hu : u ≠ 1) :
    Maximal (fun K : Subgroup G => IsMulCommutative K) (zpowers u) ↔ ¬IsProperPower u := by
  refine ⟨fun h => not_isProperPower_of_zpowers_eq_centralizer hu ?_,
    maximal_isMulCommutative_zpowers⟩
  have hle := zpowers_le_centralizer_singleton u
  exact le_antisymm hle (h.2 (isMulCommutative_centralizer hu) hle)

/-- The maximal abelian subgroups of a nontrivial free group are exactly the cyclic subgroups
generated by elements that are not proper powers. -/
theorem maximal_isMulCommutative_iff [Nontrivial G] {M : Subgroup G} :
    Maximal (fun K : Subgroup G => IsMulCommutative K) M ↔
      ∃ u : G, ¬IsProperPower u ∧ M = zpowers u := by
  refine ⟨fun hM => ?_, ?_⟩
  · have hMbot : M ≠ ⊥ := by
      rintro rfl
      obtain ⟨g, hg⟩ := exists_ne (1 : G)
      exact hg (mem_bot.1 (hM.2 (zpowers_isMulCommutative g) bot_le (mem_zpowers g)))
    obtain ⟨⟨y, hyM⟩, hy⟩ := ne_bot_iff_exists_ne_one.1 hMbot
    have hy1 : y ≠ 1 := fun e => hy (Subtype.ext e)
    have : IsMulCommutative M := hM.1
    have hMC : M ≤ centralizer {y} := fun x hx =>
      mem_centralizer_singleton_iff.2 (setLike_mul_comm hx hyM)
    obtain ⟨⟨r, k⟩, ⟨hk, hrk, hr⟩, -⟩ := exists_maximalRoot hy1
    refine ⟨r, hr, ?_⟩
    rw [← centralizer_singleton_eq_zpowers hk hr hrk]
    exact hM.eq_of_le (isMulCommutative_centralizer hy1) hMC
  · rintro ⟨u, hu, rfl⟩
    exact maximal_isMulCommutative_zpowers hu

/-- **Free groups are CSA**: every maximal abelian subgroup of a free group is malnormal. -/
theorem isCSA : IsCSA G := by
  refine (isCSA_iff G).2 fun M hM => ?_
  rcases subsingleton_or_nontrivial G with hG | hG
  · rw [Subsingleton.elim M ⊤]
    exact TauCeti.IsTISubgroup.top
  · obtain ⟨u, hu, rfl⟩ := maximal_isMulCommutative_iff.1 hM
    exact isTISubgroup_zpowers hu

end IsFreeGroup

namespace Group

/-- The product of the free group on two generators with `ℤ` is not CSA. -/
theorem not_isCSA_prod_int :
    ¬ IsCSA (FreeGroup (Fin 2) × Multiplicative ℤ) := by
  apply not_isCSA_prod_of_nontrivial
  intro hcomm
  exact not_subsingleton (Fin 2) (FreeGroup.isMulCommutative_iff_subsingleton.mp hcomm)

end Group
