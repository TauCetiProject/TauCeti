/-!
# Merzljakov's theorem for a single equation over a free group

Let `w` be an element of `FreeGroup ((Fin k ⊕ Fin k) ⊕ A)`, viewed as the left-hand side of an
equation `w(x₀, …, x_{k-1}, y₀, …, y_{k-1}) = 1` with constants in `FreeGroup A`, universally
quantified variables `x_i = Sum.inl (Sum.inl i)`, and existentially quantified variables
`y_i = Sum.inl (Sum.inr i)`. A *formal solution* assigns to each `y_i` an element of the subgroup
of `FreeGroup (Fin k ⊕ A)` generated by the constants `A` and the variables `x₀, …, x_i` such that
substituting `y_i` for the existential variables makes `w` trivial in `FreeGroup (Fin k ⊕ A)`.

**Merzljakov's theorem** states that over an alphabet `A` with at least two distinct letters, the
positive sentence `∀ x₀ ∃ y₀ … ∀ x_{k-1} ∃ y_{k-1} (w(x, y) = 1)` holds in `FreeGroup A` if and
only if the equation has a formal solution.

## Proof outline

Suppose `f` is a tuple of Skolem functions for the sentence over `FreeGroup A` and `a ≠ b` are
distinct letters of `A`. Representing `w` by a word `W` of length `L`, choose a Merzljakov tuple of
exponent lists `ms i` of length `L² + 1` with respect to `f` (`FreeGroup.exists_isMerzljakovTuple`).
Substituting the Merzljakov words `g i` for `x_i` and the reduced words of the witnesses
`h j = f g j` for `y_j` turns `W` into `L` reduced words whose product is trivial in `FreeGroup A`.
By `TauCeti.exists_cancellationPieces`, these `L` words factor into cancellation pieces so that
each factorisation has length at most `L - 1`. Across all `L` factorisations there are fewer than
`L² + 1` cut points, so `FreeGroup.exists_mem_forall_isUnsplit_merzljakovBlock` selects an exponent
`m i ∈ ms i` for each `i` whose block `b a^{m i} b` and inverse block are unsplit in every
factorisation.

Iterating `FreeGroup.blockInsert` to insert `x_i` into `b a^{m i} b` for `i = 0, …, k - 1` commutes
with concatenation along the cancellation pieces, so the resulting words still multiply to `1` in
`FreeGroup (Fin k ⊕ A)`. On `g i`, only step `i` acts, decomposing the result as `u_i x_i v_i` with
`u_i, v_i ∈ FreeGroup A`; on `h j`, steps after `j` leave the word unchanged by the Merzljakov
tuple condition, so only `x₀, …, x_j` are inserted. Applying the endomorphism sending `x_i` to
`u_i⁻¹ x_i v_i⁻¹` and fixing `A` produces the required formal solution.

Compared with Kharlampovich–Myasnikov (§4.4), which selects "marked" occurrences of blocks via a
solution table over a finite alphabet, this proof replaces all occurrences of an unsplit block using
`List.IsUnsplit` and `TauCeti.CancellationPieces`, and requires no finiteness hypothesis on `A`.
The group-independent formulation for `TauCeti.GroupAlgGeom.IsFormalSolution` over arbitrary
nonabelian free groups (for finite systems, and for arbitrary systems over countable or equationally
Noetherian free groups) is proved in `TauCeti.GroupTheory.GroupAlgGeom.FormalSolution`.

## Main results

* `FreeGroup.forallExistsAlt_of_formalSolution`: a formal solution witnesses the sentence in every
  group receiving the generators `A`.
* `FreeGroup.exists_formalSolution_of_skolem`: Merzljakov's theorem from explicit Skolem functions
  and two distinct letters `a ≠ b` of `A`.
* `FreeGroup.exists_formalSolution_of_forallExistsAlt`,
  `FreeGroup.forallExistsAlt_lift_eq_one_iff`: Merzljakov's equivalence over a nontrivial alphabet
  `[Nontrivial A]`.
* `FreeGroup.not_exists_formalSolution_of_isEmpty`,
  `FreeGroup.not_exists_formalSolution_commutator_of_subsingleton`: sharpness of `[Nontrivial A]`
  in ranks `0` and `1`.

## References

* Yu. I. Merzljakov, *Positive formulae on free groups*, Algebra i Logika 5 (1966), 25–42.
* G. S. Makanin, *Decidability of the universal and positive theories of a free group*,
  Math. USSR Izv. 25 (1985), §4, Lemma 5.
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), 1–203, §4.4, Merzljakov's Theorem.
-/

public section

namespace FreeGroup

open List

section Sufficiency

variable {A H : Type*} [Group H] {k : ℕ}

/-- A formal solution of `w(x, y) = 1` over `FreeGroup A` makes the positive sentence
`∀ x₀ ∃ y₀ … ∀ x_{k-1} ∃ y_{k-1} (w(x, y) = 1)` hold in every group `H` under any interpretation
`c : A → H` of the constants. -/
theorem forallExistsAlt_of_formalSolution (c : A → H) (w : FreeGroup ((Fin k ⊕ Fin k) ⊕ A))
    {y : Fin k → FreeGroup (Fin k ⊕ A)}
    (hy : ∀ i, y i ∈ Subgroup.closure (Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic i))
    (hw : lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr)) w = 1) :
    TauCeti.ForallExistsAlt k fun x z : Fin k → H ↦
      lift (Sum.elim (Sum.elim x z) c) w = 1 := by
  let f : (Fin k → H) → Fin k → H := fun x i ↦ lift (Sum.elim x c) (y i)
  refine TauCeti.forallExistsAlt_of_skolem f (fun i x x' hxx' ↦ ?_) (fun x ↦ ?_)
  · refine Subgroup.closure_induction
      (p := fun u _ ↦ lift (Sum.elim x c) u = lift (Sum.elim x' c) u)
      ?_ (by simp) (fun _ _ _ _ h₁ h₂ ↦ by simp [h₁, h₂]) (fun _ _ h₁ ↦ by simp [h₁]) (hy i)
    rintro _ (⟨a, rfl⟩ | ⟨j, hj, rfl⟩)
    · simp
    · simp [hxx' j hj]
  · have hcomp : (lift (Sum.elim x c)).comp
        (lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr))) =
        lift (Sum.elim (Sum.elim x (f x)) c) := by
      ext z
      rcases z with (i | j) | a <;> simp [f]
    rw [← hcomp, MonoidHom.comp_apply, hw, _root_.map_one]

end Sufficiency

section BlockInsertIter

variable {A : Type*} {k : ℕ}

/-- Iterate `blockInsert` across the first `n` indices `0, …, n - 1` of `Fin k`, inserting
`Sum.inl i` into the blocks `merzljakovBlock (Sum.inr a) (Sum.inr b) (m i)` and their formal
inverses. -/
private def blockInsertUpTo [DecidableEq A] (a b : A) (m : Fin k → ℕ) :
    (n : ℕ) → n ≤ k → List ((Fin k ⊕ A) × Bool) → List ((Fin k ⊕ A) × Bool)
  | 0, _, v => v
  | n + 1, hn, v =>
    blockInsert (Sum.inr a) (Sum.inr b) (Sum.inl ⟨n, hn⟩) (m ⟨n, hn⟩)
      (blockInsertUpTo a b m n (Nat.le_of_succ_le hn) v)

private theorem map_prodMap_inr_invRev (w : List (A × Bool)) :
    (invRev w).map (Prod.map (Sum.inr : A → Fin k ⊕ A) id) =
      invRev (w.map (Prod.map Sum.inr id)) := by
  simp [invRev, List.map_reverse, List.map_map, Function.comp_def]

private theorem map_prodMap_inr_substituteLetter {α : Type*} (f : α → List (A × Bool))
    (z : α × Bool) :
    (substituteLetter f z).map (Prod.map (Sum.inr : A → Fin k ⊕ A) id) =
      substituteLetter (fun x ↦ (f x).map (Prod.map Sum.inr id)) z := by
  obtain ⟨x, _ | _⟩ := z <;> simp [substituteLetter, map_prodMap_inr_invRev]

private theorem map_prodMap_inr_isInfix_iff {u v : List (A × Bool)} :
    u.map (Prod.map (Sum.inr : A → Fin k ⊕ A) id) <:+: v.map (Prod.map Sum.inr id) ↔
      u <:+: v := by
  have hinj : Function.Injective (Prod.map (Sum.inr : A → Fin k ⊕ A) (id : Bool → Bool)) :=
    Sum.inr_injective.prodMap Function.injective_id
  refine ⟨fun ⟨s, t, hst⟩ ↦ ?_, fun h ↦ h.map _⟩
  obtain ⟨s₁, t', hst₁, hs₁, rfl⟩ := map_eq_append_iff.1 hst.symm
  obtain ⟨s', u', rfl, rfl, hu'⟩ := map_eq_append_iff.1 hs₁
  obtain rfl := hinj.list_map hu'.symm
  exact ⟨s', t', hst₁.symm⟩

section Helpers

variable [DecidableEq A] {a b : A} {m : Fin k → ℕ}

private theorem blockInsertUpTo_invRev (n : ℕ) (hn : n ≤ k) (v : List ((Fin k ⊕ A) × Bool)) :
    blockInsertUpTo a b m n hn (invRev v) = invRev (blockInsertUpTo a b m n hn v) := by
  induction n with
  | zero => rfl
  | succ n ih => simp [blockInsertUpTo, blockInsert_invRev, ih]

private theorem blockInsertUpTo_substituteLetter {α : Type*} (n : ℕ) (hn : n ≤ k)
    (f : α → List ((Fin k ⊕ A) × Bool)) (z : α × Bool) :
    blockInsertUpTo a b m n hn (substituteLetter f z) =
      substituteLetter (fun x ↦ blockInsertUpTo a b m n hn (f x)) z := by
  obtain ⟨x, _ | _⟩ := z <;> simp [substituteLetter, blockInsertUpTo_invRev]

private theorem blockInsertUpTo_singleton (n : ℕ) (hn : n ≤ k) (c : (Fin k ⊕ A) × Bool) :
    blockInsertUpTo a b m n hn [c] = [c] := by
  induction n with
  | zero => rfl
  | succ n ih => simp [blockInsertUpTo, ih]

private theorem isUnsplit_map_blockInsertUpTo {u : List ((Fin k ⊕ A) × Bool)}
    {L : List (List ((Fin k ⊕ A) × Bool))} (n : ℕ) (hn : n ≤ k) (huL : u.IsUnsplit L)
    (hu : ∀ c ∈ u, ∀ i : Fin k, i.1 < n → c.1 ≠ Sum.inl i) :
    u.IsUnsplit (L.map (blockInsertUpTo a b m n hn)) := by
  induction n with
  | zero => simpa [blockInsertUpTo] using huL
  | succ n ih =>
    have hmap : L.map (blockInsertUpTo a b m (n + 1) hn) =
        (L.map (blockInsertUpTo a b m n (Nat.le_of_succ_le hn))).map
          (blockInsert (Sum.inr a) (Sum.inr b) (Sum.inl ⟨n, hn⟩) (m ⟨n, hn⟩)) := by
      simp [blockInsertUpTo, List.map_map, Function.comp_def]
    rw [hmap]
    exact isUnsplit_map_blockInsert
      (ih (Nat.le_of_succ_le hn) fun c hc i hi ↦ hu c hc i (Nat.lt_succ_of_lt hi))
      fun c hc ↦ hu c hc ⟨n, hn⟩ (Nat.lt_succ_self n)

private theorem blockInsertUpTo_flatten {L : List (List ((Fin k ⊕ A) × Bool))} (n : ℕ) (hn : n ≤ k)
    (h : ∀ i : Fin k, i.1 < n → (merzljakovBlock (Sum.inr a) (Sum.inr b) (m i)).IsUnsplit L ∧
      (invRev (merzljakovBlock (Sum.inr a) (Sum.inr b) (m i))).IsUnsplit L) :
    blockInsertUpTo a b m n hn L.flatten = (L.map (blockInsertUpTo a b m n hn)).flatten := by
  induction n with
  | zero => simp [blockInsertUpTo]
  | succ n ih =>
    have hn' := Nat.le_of_succ_le hn
    have hstep := h ⟨n, hn⟩ (Nat.lt_succ_self n)
    have hno_inl (c : (Fin k ⊕ A) × Bool)
        (hc : c ∈ merzljakovBlock (Sum.inr a : Fin k ⊕ A) (Sum.inr b) (m ⟨n, hn⟩))
        (i : Fin k) (_ : i.1 < n) : c.1 ≠ Sum.inl i := by
      rcases fst_eq_or_eq_of_mem_merzljakovBlock hc with heq | heq <;> simp [heq]
    have hno_inl_inv (c : (Fin k ⊕ A) × Bool)
        (hc : c ∈ invRev (merzljakovBlock (Sum.inr a : Fin k ⊕ A) (Sum.inr b) (m ⟨n, hn⟩)))
        (i : Fin k) (hi : i.1 < n) : c.1 ≠ Sum.inl i := by
      obtain ⟨d, hd, rfl⟩ : ∃ d ∈ merzljakovBlock (Sum.inr a : Fin k ⊕ A) (Sum.inr b) (m ⟨n, hn⟩),
          (d.1, !d.2) = c := by simpa [invRev] using hc
      exact hno_inl d hd i hi
    rw [blockInsertUpTo, ih hn' (fun i hi ↦ h i (Nat.lt_succ_of_lt hi)),
      blockInsert_flatten
        (isUnsplit_map_blockInsertUpTo n hn' hstep.1 hno_inl)
        (isUnsplit_map_blockInsertUpTo n hn' hstep.2 hno_inl_inv)]
    simp [blockInsertUpTo, List.map_map, Function.comp_def]

private theorem isInfix_of_isInfix_blockInsertUpTo {u v : List ((Fin k ⊕ A) × Bool)}
    (n : ℕ) (hn : n ≤ k) (h : u <:+: blockInsertUpTo a b m n hn v)
    (hu : ∀ c ∈ u, ∀ i : Fin k, c.1 ≠ Sum.inl i) : u <:+: v := by
  induction n with
  | zero => exact h
  | succ n ih =>
    exact ih (Nat.le_of_succ_le hn)
      (isInfix_of_isInfix_blockInsert h fun c hc ↦ hu c hc ⟨n, hn⟩)

private theorem fst_mem_of_mem_blockInsertUpTo {v : List ((Fin k ⊕ A) × Bool)}
    (hv : ∀ c ∈ v, c.1 ∈ Set.range Sum.inr) (n : ℕ) (hn : n ≤ k)
    {c : (Fin k ⊕ A) × Bool} (hc : c ∈ blockInsertUpTo a b m n hn v) :
    c.1 ∈ Set.range Sum.inr ∨ ∃ t : Fin k, t.1 < n ∧ c.1 = Sum.inl t := by
  induction n with
  | zero => exact .inl (hv c hc)
  | succ n ih =>
    rcases fst_eq_or_mem_of_mem_blockInsert hc with heq | hc'
    · exact .inr ⟨⟨n, hn⟩, Nat.lt_succ_self n, heq⟩
    · rcases ih (Nat.le_of_succ_le hn) hc' with hinr | ⟨t, ht, heq⟩
      · exact .inl hinr
      · exact .inr ⟨t, Nat.lt_succ_of_lt ht, heq⟩

private theorem blockInsertUpTo_eq_of_ge {v : List (A × Bool)} (j : ℕ) (hj : j ≤ k)
    (n : ℕ) (hn : n ≤ k) (hjn : j ≤ n)
    (hnot : ∀ t : Fin k, j ≤ t.1 →
      ¬ merzljakovBlock a b (m t) <:+: v ∧ ¬ invRev (merzljakovBlock a b (m t)) <:+: v) :
    blockInsertUpTo a b m n hn (v.map (Prod.map Sum.inr id)) =
      blockInsertUpTo a b m j hj (v.map (Prod.map Sum.inr id)) := by
  induction n with
  | zero =>
    obtain rfl : j = 0 := Nat.eq_zero_of_le_zero hjn
    rfl
  | succ n ih =>
    rcases eq_or_lt_of_le hjn with rfl | hlt
    · rfl
    · have hn' := Nat.le_of_succ_le hn
      have hjn' : j ≤ n := Nat.le_of_lt_succ hlt
      have ht := hnot ⟨n, hn⟩ hjn'
      have hno_inl (c : (Fin k ⊕ A) × Bool)
          (hc : c ∈ merzljakovBlock (Sum.inr a : Fin k ⊕ A) (Sum.inr b) (m ⟨n, hn⟩))
          (i : Fin k) : c.1 ≠ Sum.inl i := by
        rcases fst_eq_or_eq_of_mem_merzljakovBlock hc with heq | heq <;> simp [heq]
      have hno_inl_inv (c : (Fin k ⊕ A) × Bool)
          (hc : c ∈ invRev (merzljakovBlock (Sum.inr a : Fin k ⊕ A) (Sum.inr b) (m ⟨n, hn⟩)))
          (i : Fin k) : c.1 ≠ Sum.inl i := by
        obtain ⟨d, hd, rfl⟩ :
            ∃ d ∈ merzljakovBlock (Sum.inr a : Fin k ⊕ A) (Sum.inr b) (m ⟨n, hn⟩),
              (d.1, !d.2) = c := by simpa [invRev] using hc
        exact hno_inl d hd i
      rw [blockInsertUpTo, blockInsert_eq_self, ih hn' hjn']
      · intro hinf
        have hinf₀ := isInfix_of_isInfix_blockInsertUpTo n hn' hinf hno_inl
        rw [← map_prodMap_merzljakovBlock, map_prodMap_inr_isInfix_iff] at hinf₀
        exact ht.1 hinf₀
      · intro hinf
        have hinf₀ := isInfix_of_isInfix_blockInsertUpTo n hn' hinf hno_inl_inv
        rw [← map_prodMap_merzljakovBlock, ← map_prodMap_inr_invRev,
          map_prodMap_inr_isInfix_iff] at hinf₀
        exact ht.2 hinf₀

private theorem exists_mul_of_mul_blockInsertUpTo_merzljakovWord (hab : a ≠ b)
    {ms : Fin k → List ℕ} {h : Fin k → FreeGroup A} (hms : IsMerzljakovTuple a b ms h)
    (hm : ∀ i, m i ∈ ms i) (i : Fin k) :
    ∃ u v : FreeGroup A,
      mk (blockInsertUpTo a b m k le_rfl
          ((merzljakovWord a b (ms i)).map (Prod.map Sum.inr id))) =
        map Sum.inr u * of (Sum.inl i) * map Sum.inr v := by
  have hab' : (Sum.inr a : Fin k ⊕ A) ≠ Sum.inr b := Sum.inr_injective.ne hab
  -- Steps before `i` leave `merzljakovWord a b (ms i)` unchanged.
  have hbefore (n : ℕ) (hn : n ≤ i.1) :
      blockInsertUpTo a b m n (hn.trans i.2.le)
        ((merzljakovWord a b (ms i)).map (Prod.map Sum.inr id)) =
        (merzljakovWord a b (ms i)).map (Prod.map Sum.inr id) := by
    induction n with
    | zero => rfl
    | succ n ih =>
      have hn_lt : n < i.1 := Nat.lt_of_succ_le hn
      have hne : (⟨n, hn.trans i.2.le⟩ : Fin k) ≠ i := fun heq ↦ hn_lt.ne (congrArg Fin.val heq)
      rw [blockInsertUpTo, ih (Nat.le_of_succ_le hn), blockInsert_eq_self]
      · rw [← map_prodMap_merzljakovBlock, map_prodMap_inr_isInfix_iff]
        exact hms.not_merzljakovBlock_isInfix_merzljakovWord hab hne (hm _)
      · rw [← map_prodMap_merzljakovBlock, ← map_prodMap_inr_invRev, map_prodMap_inr_isInfix_iff]
        exact not_invRev_merzljakovBlock_isInfix_merzljakovWord a b _ (ms i)
  -- Steps after `i` leave the result of step `i + 1` unchanged.
  have hafter : blockInsertUpTo a b m k le_rfl
      ((merzljakovWord a b (ms i)).map (Prod.map Sum.inr id)) =
      blockInsertUpTo a b m (i.1 + 1) i.2
        ((merzljakovWord a b (ms i)).map (Prod.map Sum.inr id)) := by
    refine blockInsertUpTo_eq_of_ge (i.1 + 1) i.2 k le_rfl i.2 fun t ht ↦ ?_
    have hne : t ≠ i := fun heq ↦ (Nat.lt_of_succ_le ht).ne' (congrArg Fin.val heq)
    exact ⟨hms.not_merzljakovBlock_isInfix_merzljakovWord hab hne (hm t),
      not_invRev_merzljakovBlock_isInfix_merzljakovWord a b (m t) (ms i)⟩
  -- Step `i` inserts `Sum.inl i` into the unique block `m i ∈ ms i`.
  obtain ⟨ms₁, ms₂, hms_eq⟩ := append_of_mem (hm i)
  have hnd : (ms₁ ++ m i :: ms₂).Nodup := hms_eq ▸ hms.nodup i
  have hm₁ : m i ∉ ms₁ := fun h₁ ↦ (nodup_append.1 hnd).2.2 _ h₁ _ mem_cons_self rfl
  have hm₂ : m i ∉ ms₂ := (nodup_cons.1 (nodup_append.1 hnd).2.1).1
  let uWord : List (A × Bool) := merzljakovWord a b ms₁ ++ replicate (m i) (a, true)
  let vWord : List (A × Bool) := merzljakovWord a b ms₂
  refine ⟨mk uWord, mk vWord, ?_⟩
  rw [hafter, blockInsertUpTo, hbefore i.1 le_rfl, map_prodMap_merzljakovWord, hms_eq,
    blockInsert_merzljakovWord hab' hm₁ hm₂]
  have hsplit : merzljakovWord (Sum.inr a : Fin k ⊕ A) (Sum.inr b) ms₁ ++
      (replicate (m i) (Sum.inr a, true) ++
        (Sum.inl i, true) :: merzljakovWord (Sum.inr a) (Sum.inr b) ms₂) =
      uWord.map (Prod.map Sum.inr id) ++ [(Sum.inl i, true)] ++
        vWord.map (Prod.map Sum.inr id) := by
    simp [uWord, vWord, map_prodMap_merzljakovWord, append_assoc]
  rw [hsplit, ← mul_mk, ← mul_mk]
  simp [Prod.map_def, map.mk, of]

end Helpers

end BlockInsertIter

/-- **Merzljakov's theorem** (Skolem-function form): if `a ≠ b` are two distinct letters of `A`
and `f` is a tuple of Skolem functions respecting the order of the quantifiers such that
`w(x, f x) = 1` holds in `FreeGroup A` for all `x`, then `w(x, y) = 1` has a formal solution in
`FreeGroup (Fin k ⊕ A)`. -/
theorem exists_formalSolution_of_skolem {A : Type*} {k : ℕ} {a b : A} (hab : a ≠ b)
    (w : FreeGroup ((Fin k ⊕ Fin k) ⊕ A))
    (f : (Fin k → FreeGroup A) → Fin k → FreeGroup A)
    (hf : ∀ i x x', (∀ j ≤ i, x j = x' j) → f x i = f x' i)
    (hw : ∀ x, lift (Sum.elim (Sum.elim x (f x)) of) w = 1) :
    ∃ y : Fin k → FreeGroup (Fin k ⊕ A),
      (∀ i, y i ∈ Subgroup.closure (Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic i)) ∧
      lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr)) w = 1 := by
  classical
  obtain ⟨W, rfl⟩ : ∃ W, mk W = w := ⟨w.toWord, mk_toWord⟩
  let L := W.length
  obtain ⟨ms, hlen, hms⟩ := exists_isMerzljakovTuple a b (L * L + 1) f hf
  let g : Fin k → FreeGroup A := fun i ↦ mk (merzljakovWord a b (ms i))
  let h : Fin k → FreeGroup A := f g
  let U : (Fin k ⊕ Fin k) ⊕ A → List (A × Bool) :=
    Sum.elim (Sum.elim (fun i ↦ merzljakovWord a b (ms i)) (fun j ↦ (h j).toWord))
      (fun c ↦ [(c, true)])
  have hU_red (z : (Fin k ⊕ Fin k) ⊕ A) : IsReduced (U z) := by
    rcases z with (i | j) | c
    · exact isReduced_merzljakovWord a b (ms i)
    · exact isReduced_toWord
    · exact IsReduced.singleton
  let ws : List (List (A × Bool)) := W.map (substituteLetter U)
  have hws_red : ∀ v ∈ ws, IsReduced v := by
    intro v hv
    obtain ⟨⟨z, _ | _⟩, _, rfl⟩ := mem_map.1 hv
    · exact (hU_red z).invRev
    · exact hU_red z
  have hws_one : mk ws.flatten = 1 := by
    have hmkU : (fun z ↦ mk (U z)) = Sum.elim (Sum.elim g h) of := by
      ext z
      rcases z with (i | j) | c <;> simp [U, g, h, of, mk_toWord]
    dsimp only [ws]
    rw [← flatMap_def, mk_flatMap_substituteLetter, hmkU]
    exact hw g
  obtain ⟨p, ⟨P⟩⟩ := TauCeti.exists_cancellationPieces hws_red hws_one
  -- Choose an exponent `m i ∈ ms i` whose block and inverse block are unsplit in every pattern.
  let Fs : List (List (List (A × Bool))) :=
    P.patterns.map fun V ↦ V.map (substituteLetter P.piece)
  have hex_m (i : Fin k) : ∃ m ∈ ms i, ∀ F ∈ Fs,
      (merzljakovBlock a b m).IsUnsplit F ∧ (invRev (merzljakovBlock a b m)).IsUnsplit F := by
    refine exists_mem_forall_isUnsplit_merzljakovBlock hab (hms.nodup i) ?_
    rw [hlen i]
    have hle : ∀ n ∈ Fs.map (fun F ↦ F.length - 1), n ≤ L := by
      intro n hn
      obtain ⟨F, hF, rfl⟩ := mem_map.1 hn
      obtain ⟨V, hV, rfl⟩ := mem_map.1 hF
      have hVlen := P.length_le_of_mem_patterns hV
      simp only [length_map, ws, L] at hVlen ⊢
      omega
    calc (Fs.map fun F ↦ F.length - 1).sum
      _ ≤ (Fs.map fun F ↦ F.length - 1).length • L := sum_le_length_nsmul _ _ hle
      _ = L * L := by simp [Fs, ws, L]
      _ < L * L + 1 := Nat.lt_succ_self _
  choose m hm_mem hm_unsplit using hex_m
  -- Apply `blockInsertUpTo` to the pieces and to the substituted words.
  let piece₀ (q : Fin p) : List ((Fin k ⊕ A) × Bool) := (P.piece q).map (Prod.map Sum.inr id)
  let piece' (q : Fin p) : List ((Fin k ⊕ A) × Bool) := blockInsertUpTo a b m k le_rfl (piece₀ q)
  let U' (z : (Fin k ⊕ Fin k) ⊕ A) : List ((Fin k ⊕ A) × Bool) :=
    blockInsertUpTo a b m k le_rfl ((U z).map (Prod.map Sum.inr id))
  have hpat_eq : P.patterns.map (fun V ↦ V.flatMap (substituteLetter piece')) =
      W.map (substituteLetter U') := by
    have hinj : Function.Injective (Prod.map (Sum.inr : A → Fin k ⊕ A) (id : Bool → Bool)) :=
      Sum.inr_injective.prodMap Function.injective_id
    have hV_eq (V : List (Fin p × Bool)) (hV : V ∈ P.patterns) :
        V.flatMap (substituteLetter piece') =
          blockInsertUpTo a b m k le_rfl
            ((V.flatMap (substituteLetter P.piece)).map (Prod.map Sum.inr id)) := by
      let L₀ := V.map (substituteLetter piece₀)
      have hL₀_map : L₀ = (V.map (substituteLetter P.piece)).map
          (List.map (Prod.map Sum.inr id)) := by
        simp only [L₀, piece₀, List.map_map, Function.comp_def, map_prodMap_inr_substituteLetter]
      have hL₀_unsplit (i : Fin k) (_ : i.1 < k) :
          (merzljakovBlock (Sum.inr a : Fin k ⊕ A) (Sum.inr b) (m i)).IsUnsplit L₀ ∧
            (invRev (merzljakovBlock (Sum.inr a : Fin k ⊕ A) (Sum.inr b) (m i))).IsUnsplit L₀ := by
        have hF := hm_unsplit i (V.map (substituteLetter P.piece)) (mem_map_of_mem hV)
        rw [hL₀_map, ← map_prodMap_merzljakovBlock, ← map_prodMap_inr_invRev,
          map_isUnsplit_iff hinj, map_isUnsplit_iff hinj]
        exact hF
      have hflat₀ : L₀.flatten =
          (V.flatMap (substituteLetter P.piece)).map (Prod.map Sum.inr id) := by
        rw [hL₀_map, ← map_flatten, flatMap_def]
      rw [← hflat₀, blockInsertUpTo_flatten k le_rfl hL₀_unsplit]
      simp [L₀, piece', flatMap_def, List.map_map, Function.comp_def,
        blockInsertUpTo_substituteLetter]
    calc P.patterns.map (fun V ↦ V.flatMap (substituteLetter piece'))
      _ = P.patterns.map (fun V ↦ blockInsertUpTo a b m k le_rfl
            ((V.flatMap (substituteLetter P.piece)).map (Prod.map Sum.inr id))) :=
        map_congr_left hV_eq
      _ = ws.map (fun v ↦ blockInsertUpTo a b m k le_rfl (v.map (Prod.map Sum.inr id))) := by
        have hmap := congrArg
          (List.map fun v ↦ blockInsertUpTo a b m k le_rfl (v.map (Prod.map Sum.inr id)))
          P.map_flatMap_patterns
        simpa only [List.map_map, Function.comp_def] using hmap
      _ = W.map (substituteLetter U') := by
        simp [ws, U', List.map_map, Function.comp_def, map_prodMap_inr_substituteLetter,
          blockInsertUpTo_substituteLetter]
  have hU'_one : lift (fun z ↦ mk (U' z)) (mk W) = 1 := by
    rw [← mk_flatMap_substituteLetter]
    have hflat : W.flatMap (substituteLetter U') =
        P.patterns.flatten.flatMap (substituteLetter piece') := by
      rw [flatMap_def, ← hpat_eq]
      simp [flatMap_def, map_flatten, flatten_flatten, List.map_map, Function.comp_def]
    rw [hflat, mk_flatMap_substituteLetter, P.mk_flatten_patterns, _root_.map_one]
  -- Evaluate `mk (U' z)` on the universal variables, existential variables, and constants.
  choose u v huv using exists_mul_of_mul_blockInsertUpTo_merzljakovWord hab hms hm_mem
  let K (j : Fin k) : Subgroup (FreeGroup (Fin k ⊕ A)) :=
    Subgroup.closure (Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic j)
  have hp_mem (j : Fin k) : mk (U' (Sum.inl (Sum.inr j))) ∈ K j := by
    have heq : U' (Sum.inl (Sum.inr j)) =
        blockInsertUpTo a b m (j.1 + 1) j.2 (((h j).toWord).map (Prod.map Sum.inr id)) := by
      refine blockInsertUpTo_eq_of_ge (j.1 + 1) j.2 k le_rfl j.2 fun t ht ↦ ?_
      have hjt : j < t := Fin.lt_def.2 (Nat.lt_of_succ_le ht)
      exact ⟨hms.not_isInfix_toWord hjt (hm_mem t), hms.not_invRev_isInfix_toWord hjt (hm_mem t)⟩
    have himg : of '' (Set.range (Sum.inr : A → Fin k ⊕ A) ∪ Sum.inl '' Set.Iic j) =
        Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic j := by
      simp [Set.image_union, Set.image_image, Set.range_comp]
    dsimp only [K]
    rw [heq, ← lift_of_apply (mk _), ← himg]
    refine lift_mk_mem_closure_image of fun c hc ↦ ?_
    have hv₀ : ∀ d ∈ ((h j).toWord).map (Prod.map (Sum.inr : A → Fin k ⊕ A) id),
        d.1 ∈ Set.range Sum.inr := by
      intro d hd
      obtain ⟨e, _, rfl⟩ := mem_map.1 hd
      exact ⟨e.1, rfl⟩
    rcases fst_mem_of_mem_blockInsertUpTo hv₀ (j.1 + 1) j.2 hc with ha' | ⟨t, ht, htc⟩
    · exact .inl ha'
    · exact .inr ⟨t, Fin.le_iff_val_le_val.2 (Nat.le_of_lt_succ ht), htc.symm⟩
  -- Change variables by `x_i ↦ u_i⁻¹ x_i v_i⁻¹` to isolate `x_i` in the universal slots.
  let ψ : FreeGroup (Fin k ⊕ A) →* FreeGroup (Fin k ⊕ A) :=
    lift (Sum.elim (fun i ↦ (map Sum.inr (u i))⁻¹ * of (Sum.inl i) * (map Sum.inr (v i))⁻¹)
      (of ∘ Sum.inr))
  have hψ_inr (q : FreeGroup A) : ψ (map Sum.inr q) = map Sum.inr q := by
    have hcomp : ψ.comp (map Sum.inr) = map Sum.inr := by
      ext c
      simp [ψ]
    exact DFunLike.congr_fun hcomp q
  have hinr_mem (j : Fin k) (q : FreeGroup A) : map Sum.inr q ∈ K j := by
    rw [map_eq_lift]
    exact range_lift_le
      (Set.range_subset_iff.2 fun c ↦ Subgroup.subset_closure (Or.inl ⟨c, rfl⟩)) ⟨q, rfl⟩
  let y : Fin k → FreeGroup (Fin k ⊕ A) := fun j ↦ ψ (mk (U' (Sum.inl (Sum.inr j))))
  refine ⟨y, fun j ↦ ?_, ?_⟩
  · refine Subgroup.closure_induction (p := fun q _ ↦ ψ q ∈ K j) ?_ (by simp)
      (fun _ _ _ _ h₁ h₂ ↦ by simpa using mul_mem h₁ h₂)
      (fun _ _ h₁ ↦ by simpa using inv_mem h₁) (hp_mem j)
    rintro _ (⟨c, rfl⟩ | ⟨t, htj, rfl⟩)
    · exact Subgroup.subset_closure (Or.inl ⟨c, by simp [ψ]⟩)
    · simp only [Function.comp_apply, ψ, lift_apply_of, Sum.elim_inl]
      exact mul_mem (mul_mem (inv_mem (hinr_mem j (u t)))
        (Subgroup.subset_closure (Or.inr ⟨t, htj, rfl⟩))) (inv_mem (hinr_mem j (v t)))
  · have hcomp : ψ.comp (lift fun z ↦ mk (U' z)) =
        lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr)) := by
      ext z
      rcases z with (i | j) | c
      · simp only [MonoidHom.comp_apply, lift_apply_of, Sum.elim_inl, Function.comp_apply]
        dsimp only [U', U]
        rw [Sum.elim_inl, Sum.elim_inl, huv i, _root_.map_mul, _root_.map_mul, hψ_inr, hψ_inr]
        simp only [ψ, lift_apply_of, Sum.elim_inl]
        group
      · simp [y]
      · simp [U', U, blockInsertUpTo_singleton, of, ψ]
    rw [← hcomp, MonoidHom.comp_apply, hU'_one, _root_.map_one]

/-- **Merzljakov's theorem**: over an alphabet `A` with at least two letters, if the positive
sentence `∀ x₀ ∃ y₀ … ∀ x_{k-1} ∃ y_{k-1} (w(x, y) = 1)` holds in `FreeGroup A`, then the equation
has a formal solution in `FreeGroup (Fin k ⊕ A)`. -/
theorem exists_formalSolution_of_forallExistsAlt {A : Type*} [Nontrivial A] {k : ℕ}
    (w : FreeGroup ((Fin k ⊕ Fin k) ⊕ A))
    (h : TauCeti.ForallExistsAlt k fun x y : Fin k → FreeGroup A ↦
      lift (Sum.elim (Sum.elim x y) of) w = 1) :
    ∃ y : Fin k → FreeGroup (Fin k ⊕ A),
      (∀ i, y i ∈ Subgroup.closure (Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic i)) ∧
      lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr)) w = 1 := by
  obtain ⟨a, b, hab⟩ := exists_pair_ne A
  obtain ⟨f, hf, hw⟩ := h.exists_skolem
  exact exists_formalSolution_of_skolem hab w f hf hw

/-- **Merzljakov's theorem** (equivalence): over an alphabet `A` with at least two letters, the
positive sentence `∀ x₀ ∃ y₀ … ∀ x_{k-1} ∃ y_{k-1} (w(x, y) = 1)` holds in `FreeGroup A` if and
only if the equation has a formal solution in `FreeGroup (Fin k ⊕ A)`. -/
theorem forallExistsAlt_lift_eq_one_iff {A : Type*} [Nontrivial A] {k : ℕ}
    (w : FreeGroup ((Fin k ⊕ Fin k) ⊕ A)) :
    (TauCeti.ForallExistsAlt k fun x y : Fin k → FreeGroup A ↦
        lift (Sum.elim (Sum.elim x y) of) w = 1) ↔
      ∃ y : Fin k → FreeGroup (Fin k ⊕ A),
        (∀ i, y i ∈ Subgroup.closure (Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic i)) ∧
        lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr)) w = 1 :=
  ⟨exists_formalSolution_of_forallExistsAlt w,
    fun ⟨_, hy, hw⟩ ↦ forallExistsAlt_of_formalSolution of w hy hw⟩

section BoundaryAndExamples

open scoped commutatorElement

/-- Over an empty alphabet (rank `0`), Merzljakov's theorem fails: `∀ x₀ ∃ y₀ (x₀ = 1)` holds in
the trivial group `FreeGroup A`, yet `x₀ = 1` has no formal solution in `FreeGroup (Fin 1 ⊕ A)`. -/
theorem not_exists_formalSolution_of_isEmpty {A : Type*} [IsEmpty A] :
    (TauCeti.ForallExistsAlt 1 fun x y : Fin 1 → FreeGroup A ↦
        lift (Sum.elim (Sum.elim x y) of) (of (Sum.inl (Sum.inl (0 : Fin 1)))) = 1) ∧
      ¬ ∃ y : Fin 1 → FreeGroup (Fin 1 ⊕ A),
        (∀ i, y i ∈ Subgroup.closure (Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic i)) ∧
        lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr))
          (of (Sum.inl (Sum.inl (0 : Fin 1)))) = 1 := by
  refine ⟨TauCeti.forallExistsAlt_one.2 fun _ ↦ ⟨1, Subsingleton.elim _ _⟩, fun ⟨y, _, hw⟩ ↦ ?_⟩
  simp only [lift_apply_of, Sum.elim_inl, Function.comp_apply] at hw
  have h01 : (Multiplicative.ofAdd (1 : ℤ)) = 1 := by
    simpa using congrArg (lift (Sum.elim (fun _ ↦ Multiplicative.ofAdd (1 : ℤ)) isEmptyElim)) hw
  exact one_ne_zero (Multiplicative.ofAdd.injective h01)

/-- Over a one-letter alphabet (rank `1`), Merzljakov's theorem fails: `FreeGroup A` is cyclic and
therefore commutative, so `∀ x₀ ∃ y₀ (⁅x₀, a⁆ = 1)` holds in `FreeGroup A`, yet `⁅x₀, a⁆ = 1` has
no formal solution in `FreeGroup (Fin 1 ⊕ A)`. -/
theorem not_exists_formalSolution_commutator_of_subsingleton {A : Type*} [Subsingleton A] (a : A) :
    (TauCeti.ForallExistsAlt 1 fun x y : Fin 1 → FreeGroup A ↦
        lift (Sum.elim (Sum.elim x y) of)
          ⁅(of (Sum.inl (Sum.inl 0)) : FreeGroup ((Fin 1 ⊕ Fin 1) ⊕ A)), of (Sum.inr a)⁆ = 1) ∧
      ¬ ∃ y : Fin 1 → FreeGroup (Fin 1 ⊕ A),
        (∀ i, y i ∈ Subgroup.closure (Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic i)) ∧
        lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr))
          ⁅(of (Sum.inl (Sum.inl 0)) : FreeGroup ((Fin 1 ⊕ Fin 1) ⊕ A)), of (Sum.inr a)⁆ = 1 := by
  have hcommA := isMulCommutative_iff.1 (isMulCommutative_iff_subsingleton.2 ‹Subsingleton A›)
  refine ⟨TauCeti.forallExistsAlt_one.2 fun x ↦ ⟨1, ?_⟩, fun ⟨y, _, hw⟩ ↦ ?_⟩
  · simp [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm, hcommA]
  · classical
    have hcomm : ⁅(of (Sum.inl 0) : FreeGroup (Fin 1 ⊕ A)), of (Sum.inr a : Fin 1 ⊕ A)⁆ = 1 := by
      simpa [map_commutatorElement] using hw
    have hmk : ⁅(of (Sum.inl 0) : FreeGroup (Fin 1 ⊕ A)), of (Sum.inr a : Fin 1 ⊕ A)⁆ =
        mk [(Sum.inl 0, true), (Sum.inr a, true), (Sum.inl 0, false), (Sum.inr a, false)] := by
      simp [commutatorElement_def, of, inv_mk, invRev, mul_mk]
    have hred : IsReduced
        ([(Sum.inl 0, true), (Sum.inr a, true), (Sum.inl 0, false), (Sum.inr a, false)] :
          List ((Fin 1 ⊕ A) × Bool)) := by
      simp [isReduced_cons_cons]
    have hword := congrArg toWord (hmk.symm.trans hcomm)
    rw [toWord_mk, hred.reduce_eq, toWord_one] at hword
    simp at hword

/-- Over a finite alphabet `Fin n` of rank `n ≥ 2`, Skolem functions for a single equation yield a
formal solution in `FreeGroup (Fin k ⊕ Fin n)`. -/
example {n k : ℕ} (hn : 2 ≤ n) (w : FreeGroup ((Fin k ⊕ Fin k) ⊕ Fin n))
    (f : (Fin k → FreeGroup (Fin n)) → Fin k → FreeGroup (Fin n))
    (hf : ∀ i x x', (∀ j ≤ i, x j = x' j) → f x i = f x' i)
    (hw : ∀ x, lift (Sum.elim (Sum.elim x (f x)) of) w = 1) :
    ∃ y : Fin k → FreeGroup (Fin k ⊕ Fin n),
      (∀ i, y i ∈ Subgroup.closure (Set.range (of ∘ Sum.inr) ∪ (of ∘ Sum.inl) '' Set.Iic i)) ∧
      lift (Sum.elim (Sum.elim (of ∘ Sum.inl) y) (of ∘ Sum.inr)) w = 1 :=
  have hab : (⟨0, by omega⟩ : Fin n) ≠ ⟨1, by omega⟩ := by simp
  exists_formalSolution_of_skolem hab w f hf hw

end BoundaryAndExamples

end FreeGroup
