/-!
# Satisfiability of systems over a free group under sub-basis constraints

A finite system of equations and inequations over a free group `F(A)` is coded by two lists of
words in the variables and the letters of `A` (`TauCeti.EqIneqSystem.ofWords`). A *sub-basis
constraint* is coded by a finite list of pairs `(x, a)`: the variable `x` may only take values
in the subgroup generated by the letters `a` listed with it
(`TauCeti.EqIneqSystem.constraintOfList`); a variable that does not occur in the list must take
the value `1`.

Bounded solvability under such constraints is primitive recursive
(`TauCeti.EqIneqSystem.primrecRel_exists_norm_le_isConstrainedSolution`): it is a
primitive-recursive relation of the code and of a number `N` whether the system has a solution
satisfying the constraints all of whose values have length at most `N`. The number of variables
is not fixed, since the variables are numbered by `ℕ`, and the alphabet `A` may be infinite: only
the finitely many letters named by the constraint enter the search. The procedure is
an exhaustive search: the value of a constrained variable has a reduced word in its allowed
letters and their inverses, there are finitely many such words of length at most `N`
(`FreeGroup.wordsOverOfLengthLE`), and each candidate tuple is tested by substitution and free
reduction.

## References

* G. S. Makanin, *Decidability of the universal and positive theories of a free group*,
  Math. USSR-Izv. 25 (1985), 75–88, §3, proof of Theorem 1 (decidability from a bound on the
  length of a shortest solution by exhaustive search).
* V. Diekert, A. Jez, W. Plandowski, *Finding all solutions of equations in free groups and
  monoids with involution*, arXiv:1405.5133, §1–§2: equations with constraints, the alphabet
  and the set of variables being part of the input.
-/

public section

namespace TauCeti.EqIneqSystem

open FreeGroup

variable {X A : Type*}

/-- The sub-basis constraint coded by a finite list of pairs: the variable `x` is allowed the
letter `a` exactly when the pair `(x, a)` is listed. A variable that does not occur in the list
is allowed no letter, so it is restricted to the trivial subgroup. -/
def constraintOfList (c : List (X × A)) (x : X) : Set A :=
  {a | (x, a) ∈ c}

/-- A letter is allowed for a variable by a listed constraint exactly when the pair is
listed. -/
@[simp] theorem mem_constraintOfList {c : List (X × A)} {x : X} {a : A} :
    a ∈ constraintOfList c x ↔ (x, a) ∈ c :=
  Iff.rfl

/-- The empty list allows no letter. -/
@[simp] theorem constraintOfList_nil (x : X) : constraintOfList ([] : List (X × A)) x = ∅ := by
  ext a
  simp

/-- Concatenating lists allows the letters allowed by either list. -/
@[simp] theorem constraintOfList_append (c d : List (X × A)) (x : X) :
    constraintOfList (c ++ d) x = constraintOfList c x ∪ constraintOfList d x := by
  ext a
  simp

/-- A listed constraint allows finitely many letters for each variable. -/
theorem finite_constraintOfList (c : List (X × A)) (x : X) : (constraintOfList c x).Finite :=
  (c.map Prod.snd).finite_toSet.subset fun a ha =>
    List.mem_map.2 ⟨(x, a), mem_constraintOfList.1 ha, rfl⟩

section Search

/-- The letters listed with the variable `x`. -/
private def allowedLetters (c : List (ℕ × A)) (x : ℕ) : List A :=
  c.filterMap fun y => if y.1 = x then some y.2 else none

private theorem mem_allowedLetters {c : List (ℕ × A)} {x : ℕ} {a : A} :
    a ∈ allowedLetters c x ↔ (x, a) ∈ c := by
  simp [allowedLetters]

/-- A number exceeding every variable listed in a constraint. -/
private def constraintBound (c : List (ℕ × A)) : ℕ :=
  (c.map Prod.fst).sum + 1

private theorem lt_constraintBound {c : List (ℕ × A)} {x : ℕ} {a : A} (h : (x, a) ∈ c) :
    x < constraintBound c :=
  Nat.lt_succ_of_le (List.le_sum_of_mem (List.mem_map_of_mem (f := Prod.fst) h))

/-- The tuples of words tested for a constrained system: for each variable below the bound,
one word of length at most `N` in its allowed letters. -/
private def candidates (c : List (ℕ × A)) (N : ℕ) : List (List (List (A × Bool))) :=
  ((List.range (constraintBound c)).map fun x =>
    wordsOverOfLengthLE (allowedLetters c x) N).sections

/-- Every word of a tested tuple has length at most `N` and uses only allowed letters; beyond
the tuple the word is empty. -/
private theorem getD_of_mem_candidates {c : List (ℕ × A)} {N : ℕ} {u : List (List (A × Bool))}
    (hu : u ∈ candidates c N) (x : ℕ) :
    (u.getD x []).length ≤ N ∧ ∀ y ∈ u.getD x [], (x, y.1) ∈ c := by
  rw [candidates, List.mem_sections] at hu
  rcases lt_or_ge x u.length with hx | hx
  · have h := hu.get hx (hu.length_eq ▸ hx)
    simp only [List.get_eq_getElem, List.getElem_map, List.getElem_range,
      mem_wordsOverOfLengthLE, mem_allowedLetters] at h
    rwa [List.getD_eq_getElem _ _ hx]
  · rw [List.getD_eq_default _ _ hx]
    simp

/-- The reduced words of the values below the bound form a tested tuple, when the values have
length at most `N` and use only allowed letters. -/
private theorem map_toWord_mem_candidates [DecidableEq A] {c : List (ℕ × A)} {N : ℕ}
    {v : ℕ → FreeGroup A} (hv : ∀ x, (v x).norm ≤ N)
    (hc : ∀ x, ∀ y ∈ (v x).toWord, (x, y.1) ∈ c) :
    (List.range (constraintBound c)).map (fun x => (v x).toWord) ∈ candidates c N := by
  rw [candidates, List.mem_sections, List.forall₂_map_left_iff, List.forall₂_map_right_iff,
    List.forall₂_same]
  exact fun x _ => mem_wordsOverOfLengthLE.2
    ⟨hv x, fun y hy => mem_allowedLetters.2 (hc x y hy)⟩

/-- A system has a constrained solution with all values of length at most `N` exactly when one
of the finitely many tested tuples of words solves it. -/
private theorem exists_norm_le_isConstrainedSolution_iff [DecidableEq A] (c : List (ℕ × A))
    (p : List (List ((ℕ ⊕ A) × Bool)) × List (List ((ℕ ⊕ A) × Bool))) (N : ℕ) :
    (∃ v : ℕ → FreeGroup A, (∀ x, (v x).norm ≤ N) ∧
        (ofWords p).IsConstrainedSolution (constraintOfList c) v of) ↔
      ∃ u ∈ candidates c N,
        (ofWords p).IsSolution (fun x => FreeGroup.mk (u.getD x [])) of := by
  constructor
  · rintro ⟨v, hv, hs⟩
    refine ⟨_, map_toWord_mem_candidates hv ((isConstrainedSolution_iff_toWord _ _ _).1 hs).2, ?_⟩
    convert hs.isSolution using 1
    funext x
    rcases lt_or_ge x (constraintBound c) with hx | hx
    · simp [hx, mk_toWord]
    · rw [List.getD_eq_default _ _ (by simpa using hx), ← one_eq_mk]
      exact (hs.eq_one_of_eq_empty (Set.eq_empty_of_forall_notMem fun a ha =>
        hx.not_gt (lt_constraintBound ha))).symm
  · rintro ⟨u, hu, hs⟩
    refine ⟨_, fun x => norm_mk_le.trans (getD_of_mem_candidates hu x).1,
      hs.isConstrainedSolution fun x => ?_⟩
    simpa only [lift_of_apply] using lift_mk_mem_closure_image of fun y hy =>
      mem_constraintOfList.2 ((getD_of_mem_candidates hu x).2 y hy)

variable [Primcodable A]

private theorem primrec_constraintBound : Primrec (constraintBound (A := A)) := by
  have hsum : Primrec (List.sum : List ℕ → ℕ) :=
    (Primrec.list_foldr Primrec.id (Primrec.const 0)
      (Primrec.nat_add.comp (Primrec.fst.comp Primrec.snd)
        (Primrec.snd.comp Primrec.snd)).to₂).of_eq fun l => by
      induction l <;> simp_all
  exact Primrec.succ.comp (hsum.comp (Primrec.list_map Primrec.id
    (Primrec.fst.comp Primrec.snd).to₂))

private theorem primrec₂_candidates : Primrec₂ (candidates (A := A)) := by
  have hl : Primrec₂ (allowedLetters (A := A)) :=
    Primrec.listFilterMap Primrec.fst (Primrec.ite
      (Primrec.eq.comp (Primrec.fst.comp Primrec.snd) (Primrec.snd.comp Primrec.fst))
      (Primrec.option_some.comp (Primrec.snd.comp Primrec.snd)) (Primrec.const none)).to₂
  exact (Primrec.list_sections.comp (Primrec.list_map
    (Primrec.list_range.comp (primrec_constraintBound.comp Primrec.fst))
    (primrec₂_wordsOverOfLengthLE.comp (hl.comp (Primrec.fst.comp Primrec.fst) Primrec.snd)
      (Primrec.snd.comp Primrec.fst)).to₂)).to₂

/-- **Bounded solvability under sub-basis constraints is primitive recursive.** It is a
primitive-recursive relation of a list of allowed pairs, a pair of lists of words in variables
numbered by `ℕ` and letters of `A`, and a number `N`, whether the system has a solution in
`F(A)` all of whose values have length at most `N` and lie in the subgroups generated by the
allowed letters. The words need not be reduced, the number of variables is not fixed, and the
alphabet need not be finite. -/
theorem primrecRel_exists_norm_le_isConstrainedSolution [DecidableEq A] :
    PrimrecRel fun (q : List (ℕ × A) ×
        (List (List ((ℕ ⊕ A) × Bool)) × List (List ((ℕ ⊕ A) × Bool)))) (N : ℕ) =>
      ∃ v : ℕ → FreeGroup A, (∀ x, (v x).norm ≤ N) ∧
        (ofWords q.2).IsConstrainedSolution (constraintOfList q.1) v of :=
  (primrecRel_isSolution_mk_getD.exists_mem_list.comp
    (primrec₂_candidates.comp (Primrec.fst.comp Primrec.fst) Primrec.snd)
    (Primrec.snd.comp Primrec.fst)).of_eq fun q =>
      (exists_norm_le_isConstrainedSolution_iff q.1.1 q.1.2 q.2).symm

end Search

section Examples

/-- The equation `y ^ 2 = a ^ 2`, written as the word `y y a⁻¹ a⁻¹`, has a solution with `y`
restricted to the subgroup generated by `a`. -/
example (a : A) : ∃ v : ℕ → FreeGroup A,
    (ofWords (X := ℕ) (A := A) ([[(Sum.inl 0, true), (Sum.inl 0, true), (Sum.inr a, false),
      (Sum.inr a, false)]], [])).IsConstrainedSolution (constraintOfList [(0, a)]) v of := by
  refine ⟨fun x => if x = 0 then of a else 1,
    (isConstrainedSolution_iff _ _ _ _).2 ⟨?_, fun x => ?_⟩⟩
  · simp [isSolution_ofWords_iff, eval_eq_lift, lift_mk]
  · by_cases hx : x = 0
    · subst hx
      exact Subgroup.subset_closure ⟨a, by simp, by simp⟩
    · simp [hx, one_mem]

/-- The equation `y = b`, written as the word `y b⁻¹`, has no solution with `y` restricted to
the subgroup generated by a letter `a` different from `b`. -/
example {a b : A} (hab : a ≠ b) (v : ℕ → FreeGroup A) :
    ¬ (ofWords (X := ℕ) (A := A) ([[(Sum.inl 0, true), (Sum.inr b, false)]],
      [])).IsConstrainedSolution (constraintOfList [(0, a)]) v of := by
  intro h
  have hy : v 0 = of b := by
    simpa [isSolution_ofWords_iff, eval_eq_lift, lift_mk, mul_inv_eq_one] using h.isSolution
  have h0 := h.mem_closure 0
  rw [hy] at h0
  have : constraintOfList [(0, a)] 0 = {a} := by ext; simp [eq_comm]
  rw [this, FreeGroup.of_mem_closure_image_of_iff] at h0
  exact hab (by simpa using h0.symm)

/-- A variable that does not occur in the list takes the value `1` in every constrained
solution. -/
example {S : EqIneqSystem ℕ A} {c : List (ℕ × A)} {v : ℕ → FreeGroup A}
    (h : S.IsConstrainedSolution (constraintOfList c) v of) {x : ℕ} (hx : ∀ a, (x, a) ∉ c) :
    v x = 1 :=
  h.eq_one_of_eq_empty (by ext a; simp [hx a])

end Examples

end TauCeti.EqIneqSystem
