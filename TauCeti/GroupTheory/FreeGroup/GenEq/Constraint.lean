module

public import TauCeti.GroupTheory.FreeGroup.GenEq.PartitionTable

/-!
# Alphabet constraints on solutions of generalised equations

A system of equations over a free group `F(A)` is often solved under *alphabet constraints*: each
variable `x` must take its value in the subgroup generated by a set `C x` of basis letters. For a
generalised equation the corresponding notion restricts the letters of each item: a solution is
*constrained* by `D : items → Set A` when the word of the item `k` only uses letters of `D k`.

For the generalised equation `Ω_T` of a table, the constraint `C` on the variables induces the
constraint `itemAlphabet C` on the items: an item lying in the word of an occurrence of a variable
`x` may only use letters of `C x`. Since the word maps read the values of the variables off the
words of the items, the words `P_x(U)` of a solution satisfying the induced constraint only use
letters of `C x`. Conversely, if the words of the entries of each variable are empty together (as
in a partition table), a solution whose words `P_x(U)`, for the variables that occur, only use
letters of `C x` satisfies the induced constraint.

The comparison is made letter by letter, on the words `P_x(U)` as written. The weaker condition
that `P_x(U)` represents an element of the subgroup generated by `C x` does not imply the induced
constraint: the items of a variable that occurs once are joined by no base, so their words may
cancel each other.

## Main definitions

* `TauCeti.GenEq.Solution.IsConstrained`: a solution uses, in each item, only the allowed letters.
* `TauCeti.GenEq.itemAlphabet`: the constraint on the items of `Ω_T` induced by a constraint on
  the variables.

## Main results

* `TauCeti.GenEq.Solution.isConstrained_iff_point_mem_closure`: a solution is constrained exactly
  when each item takes its value in the subgroup generated by its allowed letters.
* `TauCeti.GenEq.Solution.IsConstrained.forall_mem_wordMap`: the word maps of a constrained
  solution only use the letters allowed for the variable.
* `TauCeti.GenEq.Solution.substituteVars_segment_entryStart_eq_wordMap`: in a solution, every
  entry of a variable spells the word map of that variable, when the words of the entries of that
  variable are empty together.
* `TauCeti.GenEq.Solution.isConstrained_itemAlphabet`: conversely, a solution whose word maps
  only use the allowed letters is constrained, when the words of the entries of each variable are
  empty together.

## References

* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §4.2 (the generalised equations of a system and their word maps) and §4.4 (equations
  with the constraints `yᵢ ∈ F[Xᵢ]`).
* V. Diekert, A. Jez, W. Plandowski, *Finding all solutions of equations in free groups and
  monoids with involution*, Inform. and Comput. 251 (2016), §1.1–§1.3 (equations with rational
  constraints, of which alphabet constraints are a special case).
-/

public section

namespace TauCeti

namespace GenEq

open FreeGroup (substituteVars substituteVars_invRev substituteVars_map_inl)

variable {X Z A : Type*}

/-- The letters of `A` used by a word `h[i, j] ^ ±1` after substitution of words for the items
are the letters used by the words of the items between the boundaries `i` and `j`. -/
theorem exists_mem_substituteVars_segment_iff (Ω : GenEq A)
    (u : Fin Ω.numItems → List (A × Bool)) {i j : ℕ} {s : Bool} {a : A} :
    (∃ l ∈ substituteVars u (Ω.segment i j s), l.1 = a) ↔
      ∃ k : Fin Ω.numItems, i ≤ k ∧ (k : ℕ) < j ∧ ∃ l ∈ u k, l.1 = a := by
  have hmem (k : Fin Ω.numItems) :
      k ∈ ((List.finRange Ω.numItems).take j).drop i ↔ i ≤ k ∧ (k : ℕ) < j := by
    simp only [List.mem_iff_getElem, List.getElem_drop, List.getElem_take, List.getElem_finRange,
      List.length_drop, List.length_take, List.length_finRange, Fin.ext_iff, Fin.val_cast]
    exact ⟨by grind, fun h => ⟨k - i, by grind⟩⟩
  have htrue : (∃ l ∈ substituteVars u (Ω.segment i j true), l.1 = a) ↔
      ∃ k : Fin Ω.numItems, i ≤ k ∧ (k : ℕ) < j ∧ ∃ l ∈ u k, l.1 = a := by
    simp only [segment_true, substituteVars_map_inl, List.mem_flatMap, hmem]
    grind
  cases s
  · rw [← htrue, segment_false, substituteVars_invRev]
    simp [FreeGroup.invRev, or_comm]
  · exact htrue

namespace Solution

variable {Ω : GenEq A}

/-- A solution of a generalised equation is *constrained* by a family `D` of sets of letters,
one for each item, when the word of each item `k` only uses letters of `D k`. -/
def IsConstrained (U : Ω.Solution) (D : Fin Ω.numItems → Set A) : Prop :=
  ∀ k, ∀ l ∈ U.word k, l.1 ∈ D k

/-- A solution is constrained when the word of each item only uses the allowed letters. -/
theorem isConstrained_iff {U : Ω.Solution} {D : Fin Ω.numItems → Set A} :
    U.IsConstrained D ↔ ∀ k, ∀ l ∈ U.word k, l.1 ∈ D k :=
  Iff.rfl

/-- Allowing every letter for every item is no constraint. -/
@[simp]
theorem isConstrained_univ (U : Ω.Solution) : U.IsConstrained fun _ => Set.univ :=
  fun _ _ _ => Set.mem_univ _

/-- Enlarging the sets of allowed letters keeps a solution constrained. -/
theorem IsConstrained.mono {U : Ω.Solution} {D D' : Fin Ω.numItems → Set A}
    (h : U.IsConstrained D) (hD : ∀ k, D k ⊆ D' k) : U.IsConstrained D' :=
  fun k l hl => hD k (h k l hl)

/-- A solution is constrained exactly when each item takes its value in the subgroup generated by
its allowed letters. -/
theorem isConstrained_iff_point_mem_closure {U : Ω.Solution} {D : Fin Ω.numItems → Set A} :
    U.IsConstrained D ↔ ∀ k, U.point k ∈ Subgroup.closure (FreeGroup.of '' D k) := by
  classical
  simp only [isConstrained_iff, FreeGroup.mem_closure_image_of_iff, point_apply,
    FreeGroup.toWord_mk, (U.isReduced_word _).reduce_eq]

end Solution

variable (E : List (((X ⊕ A) × Bool) × List ((Z ⊕ A) × Bool)))

/-- The constraint on the items of `ofEntries E` induced by a constraint `C` on the variables: a
letter is allowed for an item when it is allowed for every variable one of whose entries has that
item in its word. An item in the word of no entry of a variable is unconstrained. -/
def itemAlphabet (C : X → Set A) (c : Fin (ofEntries E).numItems) : Set A :=
  {a | ∀ (k : Fin E.length) (x : X), E[k].1.1 = Sum.inl x → entryStart E k ≤ c →
    (c : ℕ) < entryStart E ((k : ℕ) + 1) → a ∈ C x}

/-- A letter is allowed for an item when it is allowed for every variable one of whose entries
has that item in its word. -/
theorem mem_itemAlphabet_iff {C : X → Set A} {c : Fin (ofEntries E).numItems} {a : A} :
    a ∈ itemAlphabet E C c ↔ ∀ (k : Fin E.length) (x : X), E[k].1.1 = Sum.inl x →
      entryStart E k ≤ c → (c : ℕ) < entryStart E ((k : ℕ) + 1) → a ∈ C x :=
  Iff.rfl

/-- Allowing every letter for every variable allows every letter for every item. -/
@[simp]
theorem itemAlphabet_univ :
    itemAlphabet E (fun _ : X => (Set.univ : Set A)) = fun _ => Set.univ := by
  ext c a
  simp [mem_itemAlphabet_iff]

variable {E}

/-- The word maps of a solution satisfying the constraint induced on the items only use the
letters allowed for the variable. -/
theorem Solution.IsConstrained.forall_mem_wordMap {U : (ofEntries E).Solution} {C : X → Set A}
    (hU : U.IsConstrained (itemAlphabet E C)) (x : X) :
    ∀ l ∈ substituteVars U.word (wordMap E x), l.1 ∈ C x := by
  intro l hl
  by_cases hx : ∃ k : Fin E.length, E[k].1.1 = Sum.inl x
  · obtain ⟨k, hk⟩ := hx
    obtain ⟨k₀, hk₀, hw⟩ := exists_wordMap_eq E k hk
    rw [hw] at hl
    obtain ⟨c, hc, hc', l', hl', hfst⟩ :=
      (exists_mem_substituteVars_segment_iff _ U.word).1 ⟨l, hl, rfl⟩
    exact hfst ▸ hU c l' hl' k₀ x hk₀ hc hc'
  · rw [wordMap_eq_nil E fun k hk => hx ⟨k, hk⟩] at hl
    simp at hl

/-- In a solution of `ofEntries E`, the items spanned by the word of an entry of a variable `x`
spell the same word as the word map of `x`, letter by letter, when the words of the entries of `x`
are empty together: the value of `x` does not depend on the occurrence at which it is read. -/
theorem Solution.substituteVars_segment_entryStart_eq_wordMap (U : (ofEntries E).Solution)
    {x : X} (he : ∀ e ∈ E, ∀ e' ∈ E, e.1.1 = Sum.inl x → e'.1.1 = Sum.inl x →
      (e.2 = [] ↔ e'.2 = []))
    {k : Fin E.length} (hk : E[k].1.1 = Sum.inl x) :
    substituteVars U.word
        ((ofEntries E).segment (entryStart E k) (entryStart E ((k : ℕ) + 1)) E[k].1.2) =
      substituteVars U.word (wordMap E x) := by
  obtain ⟨k₀, hk₀, hw⟩ := exists_wordMap_eq E k hk
  have hiff := he _ (List.getElem_mem k.isLt) _ (List.getElem_mem k₀.isLt) hk hk₀
  have hnil (k' : Fin E.length) (h : E[k'].2 = []) :
      (ofEntries E).segment (entryStart E k') (entryStart E ((k' : ℕ) + 1)) E[k'].1.2 = [] :=
    List.eq_nil_of_length_eq_zero <| (length_segment_entryStart E k'.isLt _).trans <|
      List.length_eq_zero_iff.2 h
  rw [hw]
  by_cases h : k = k₀
  · rw [h]
  by_cases hne : E[k].2 = []
  · rw [hnil k hne, hnil k₀ (hiff.1 hne)]
  · exact U.subst_eq _ (mem_equations_ofEntries_of_isVarPair E (p := (k, k₀))
      ((isVarPair_iff E).2 ⟨h, by rw [hk]; rfl, hk.trans hk₀.symm, hne, mt hiff.2 hne⟩))

/-- If the words of the entries of each variable are empty together, a solution satisfies the
constraint induced on the items as soon as the word map of each variable carried by an entry only
uses the letters allowed for that variable. -/
theorem Solution.isConstrained_itemAlphabet (U : (ofEntries E).Solution) {C : X → Set A}
    (he : ∀ (x : X), ∀ e ∈ E, ∀ e' ∈ E, e.1.1 = Sum.inl x → e'.1.1 = Sum.inl x →
      (e.2 = [] ↔ e'.2 = []))
    (hU : ∀ (k : Fin E.length) (x : X), E[k].1.1 = Sum.inl x →
      ∀ l ∈ substituteVars U.word (wordMap E x), l.1 ∈ C x) :
    U.IsConstrained (itemAlphabet E C) := by
  intro c l hl k x hk hc hc'
  obtain ⟨l', hl', hfst⟩ := (exists_mem_substituteVars_segment_iff _ U.word
    (s := E[k].1.2)).2 ⟨c, hc, hc', l, hl, rfl⟩
  rw [U.substituteVars_segment_entryStart_eq_wordMap (he x) hk] at hl'
  exact hfst ▸ hU k x hk l' hl'

end GenEq

end TauCeti
