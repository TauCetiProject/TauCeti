module

public import TauCeti.GroupTheory.FreeGroup.GenEq.Minimal.Basic
import Mathlib.Data.Fin.VecNotation
import TauCeti.Algebra.Group.Subgroup.ZPowers
import TauCeti.GroupTheory.FreeGroup.Nielsen
import TauCeti.GroupTheory.GroupAlgGeom.Automorphism
import TauCeti.GroupTheory.GroupAlgGeom.FreeDiscrimination
import TauCeti.GroupTheory.GroupAlgGeom.Separated

/-!
# Examples of minimal solutions of a generalised equation

These examples concern the generalised equation over `F(a, b)` with a single item `h` and no
bases, whose coordinate group is `F(a, b)[h]`. They show that:

* `h = ba` is minimal for the trivial group, but not for the group generated by `h ↦ h a`;
* `h = b` is minimal up to endomorphisms for every group, set of letters and set of items;
* `h = ba` is not minimal up to endomorphisms fixing `a`: it is the image of `h = b` under
  `b ↦ ba`;
* `<_{M,K,S}` need not be transitive when `M` moves a letter of `K`: for the group generated by
  `a ↦ a⁻¹, b ↦ b⁻¹, h ↦ h a` and all letters fixed, `h = b` lies below `h = ba`, which lies below
  `h = baa`, but `h = b` does not lie below `h = baa`.
-/

public section

namespace TauCeti.GenEq.Examples

open TauCeti.GroupAlgGeom Monoid.Coprod Solution

/-- The generalised equation over `F(a, b)` with a single item `h` and no bases, with `a = 0` and
`b = 1`. -/
abbrev freeItem : GenEq (Fin 2) where
  numItems := 1
  numBases := 0
  left := Fin.elim0
  right := Fin.elim0
  left_lt_right := fun μ ↦ μ.elim0
  sign := Fin.elim0
  dual := Fin.elim0
  dual_involutive := fun μ ↦ μ.elim0
  constBases := ∅
  connections := ∅
  bounds_of_mem_connections := by simp
  dual_mem_connections := by simp

private theorem toSystem_freeItem : freeItem.toSystem = ∅ := by
  refine Set.eq_empty_of_forall_notMem fun w hw ↦ ?_
  obtain ⟨e, he, -⟩ := (mem_toSystem_iff _).1 hw
  exact (forall_mem_equations (P := fun _ ↦ False) _).2
    ⟨fun μ ↦ μ.elim0, fun _ hb ↦ absurd hb (Finset.notMem_empty _),
      fun _ hc ↦ absurd hc (Finset.notMem_empty _)⟩ e he

/-- The coordinate group of `freeItem`, which has no equations, is `F(a, b)[h]`, since `F(a, b)[h]`
is separated by `F(a, b)`. -/
private theorem exists_bijective_coordGroup_freeItem :
    ∃ θ : freeItem.coordGroup →* GX (FreeGroup (Fin 2)) (Fin 1), Function.Bijective θ ∧
      ∀ w : GX (FreeGroup (Fin 2)) (Fin 1), θ (w : freeItem.coordGroup) = w := by
  have h := (GX.isDiscriminatedBy_of_isFreeGroup (X := Fin 1)
    (FreeGroup.isMulCommutative_iff_subsingleton.not.2 (not_subsingleton (Fin 2)))).isSeparatedBy
      |>.exists_bijective_gHom_coordGroup_empty
  rw [← toSystem_freeItem] at h
  obtain ⟨θ, hθ, hθw⟩ := h
  exact ⟨θ.toMonoidHom, hθ, hθw⟩

/-- The identification of the coordinate group of `freeItem` with `F(a, b)[h]`. -/
private noncomputable def coordEquiv : freeItem.coordGroup ≃* GX (FreeGroup (Fin 2)) (Fin 1) :=
  MulEquiv.ofBijective _ exists_bijective_coordGroup_freeItem.choose_spec.1

/-- An automorphism of `F(a, b)[h]` transported to the coordinate group of `freeItem` acts on the
classes of words as on the words. -/
private theorem congr_coordEquiv_mk (f : MulAut (GX (FreeGroup (Fin 2)) (Fin 1)))
    (w : GX (FreeGroup (Fin 2)) (Fin 1)) :
    MulAut.congr coordEquiv.symm f (w : freeItem.coordGroup) = (f w : freeItem.coordGroup) := by
  have hmk (w : GX (FreeGroup (Fin 2)) (Fin 1)) : coordEquiv (w : freeItem.coordGroup) = w :=
    exists_bijective_coordGroup_freeItem.choose_spec.2 w
  rw [MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.trans_apply, MulEquiv.symm_symm, hmk,
    MulEquiv.symm_apply_eq, hmk]

/-- The automorphism `h ↦ h a` of `F(a, b)[h]`. -/
private noncomputable abbrev mulRightA : MulAut (GX (FreeGroup (Fin 2)) (Fin 1)) :=
  GX.transvection 0 1 (inl (FreeGroup.of 0)) (one_mem _) (GX.inl_mem_avoiding 0 _)

/-- The automorphism `h ↦ h a` of the coordinate group of `freeItem`. -/
private noncomputable def coordMulRightA : MulAut freeItem.coordGroup :=
  MulAut.congr coordEquiv.symm mulRightA

/-- The solution `h = b`. -/
private def solB : freeItem.Solution :=
  ofNumBasesEqZero (Ω := freeItem) rfl rfl ![[(1, true)]]
    (by unfold FreeGroup.IsReduced; decide) (by decide)

/-- The solution `h = ba`. -/
private def solBA : freeItem.Solution :=
  ofNumBasesEqZero (Ω := freeItem) rfl rfl ![[(1, true), (0, true)]]
    (by unfold FreeGroup.IsReduced; decide) (by decide)

/-- The solution `h = baa`. -/
private def solBAA : freeItem.Solution :=
  ofNumBasesEqZero (Ω := freeItem) rfl rfl ![[(1, true), (0, true), (0, true)]]
    (by unfold FreeGroup.IsReduced; decide) (by decide)

/-! ### Minimality with respect to a group of automorphisms -/

/-- `h = b` is smaller than `h = ba` with respect to the group generated by `h ↦ h a`. -/
private theorem autLT_solB_solBA : AutLT (Subgroup.zpowers coordMulRightA) solB solBA := by
  refine autLT_iff _ |>.2 ⟨⟨coordMulRightA, Subgroup.mem_zpowers _, fun g ↦ ?_⟩,
    by simp [solB, solBA], 0, by simp [solB, solBA]⟩
  induction g using QuotientGroup.induction_on with
  | H w =>
    rw [coordMulRightA, congr_coordEquiv_mk, toHom_mk, toHom_mk, GX.eval_transvection]
    congr 2
    funext k
    rw [Subsingleton.elim k 0]
    simp [solB, solBA, FreeGroup.of, FreeGroup.mul_mk]

/-- `h = ba` is not minimal with respect to the group generated by `h ↦ h a`. -/
example : ¬ IsAutMinimal (Subgroup.zpowers coordMulRightA) solBA :=
  fun h ↦ (isAutMinimal_iff _).1 h solB autLT_solB_solBA

/-- `h = ba` is minimal with respect to the trivial group of automorphisms, as every solution is. -/
example : IsAutMinimal ⊥ solBA :=
  isAutMinimal_bot solBA

/-! ### Minimality up to endomorphisms -/

/-- `h = b` is minimal up to endomorphisms for every group, set of letters and set of items: its
only item has length one. -/
private theorem isEndMinimal_solB (M : Subgroup (MulAut freeItem.coordGroup)) (K : Set (Fin 2))
    (S : Set (Fin 1)) : IsEndMinimal M K S solB :=
  isEndMinimal_of_forall_length_le_one fun _ ↦ by simp [solB]

/-- `h = b` is minimal with respect to every group of automorphisms. -/
example (M : Subgroup (MulAut freeItem.coordGroup)) : IsAutMinimal M solB :=
  (isEndMinimal_solB M ∅ ∅).isAutMinimal

/-- `h = ba` is not minimal up to endomorphisms fixing `a`: it is the image of `h = b` under the
Nielsen automorphism `b ↦ ba`. -/
example : ¬ IsEndMinimal ⊥ {0} ∅ solBA := by
  refine fun h ↦ (isEndMinimal_iff _ _ _).1 h solB <| (endLT_iff _ _ _).2
    ⟨⟨1, one_mem _, (FreeGroup.nielsenMul 1 0 (by decide) 1).toMonoidHom, by simp, by simp,
      fun k ↦ ?_⟩, by simp [solB, solBA], 0, by simp [solB, solBA]⟩
  rw [Subsingleton.elim k 0, MulAut.one_apply, toHom_genericPoint,
    show solB.point 0 = FreeGroup.of 1 by simp [point_apply, solB, FreeGroup.of],
    MulEquiv.coe_toMonoidHom, FreeGroup.nielsenMul_of_left]
  simp [solBA, FreeGroup.of, FreeGroup.mul_mk]

/-- The involution `a ↦ a⁻¹`, `b ↦ b⁻¹`, `h ↦ h a` of `F(a, b)[h]`: generator inversion on
`F(a, b)`, followed by `h ↦ h a`. -/
private noncomputable abbrev gxInv : MulAut (GX (FreeGroup (Fin 2)) (Fin 1)) :=
  mulRightA * MulEquiv.coprodCongr FreeGroup.generatorInversion (.refl _)

/-- The involution `a ↦ a⁻¹`, `b ↦ b⁻¹`, `h ↦ h a` of the coordinate group of `freeItem`. It
moves the letter `a`. -/
private noncomputable def coordInv : MulAut freeItem.coordGroup :=
  MulAut.congr coordEquiv.symm gxInv

private theorem coordInv_sq : coordInv ^ 2 = 1 := by
  rw [coordInv, ← map_pow, ← map_one (MulAut.congr coordEquiv.symm)]
  congr 1
  refine MulEquiv.toMonoidHom_injective (hom_ext (FreeGroup.ext_hom _ _ fun i ↦ ?_)
    (FreeGroup.ext_hom _ _ fun j ↦ ?_))
  · simp [pow_two]
  · obtain rfl := Subsingleton.elim j 0
    simp [pow_two]

private theorem toHom_coordInv (U : freeItem.Solution) :
    U.toHom (coordInv (CoordGroup.genericPoint (.id _) _ 0)) = U.point 0 * FreeGroup.of 0 := by
  rw [CoordGroup.genericPoint_apply, coordInv, congr_coordEquiv_mk, toHom_mk]
  simp

/-- With all letters fixed, `<_{M,K,S}` is not transitive for the group generated by an
automorphism moving a letter: `h = b` lies below `h = ba`, which lies below `h = baa`, but
`h = b` does not lie below `h = baa`. -/
example :
    EndLT (Subgroup.zpowers coordInv) Set.univ ∅ solB solBA ∧
      EndLT (Subgroup.zpowers coordInv) Set.univ ∅ solBA solBAA ∧
      ¬ EndLT (Subgroup.zpowers coordInv) Set.univ ∅ solB solBAA := by
  refine ⟨(endLT_iff _ _ _).2 ⟨⟨coordInv, Subgroup.mem_zpowers _, .id _, by simp, by simp,
      fun k ↦ ?_⟩, by simp [solB, solBA], 0, by simp [solB, solBA]⟩,
    (endLT_iff _ _ _).2 ⟨⟨coordInv, Subgroup.mem_zpowers _, .id _, by simp, by simp,
      fun k ↦ ?_⟩, by simp [solBA, solBAA], 0, by simp [solBA, solBAA]⟩, ?_⟩
  iterate 2
    rw [Subsingleton.elim k 0, MonoidHom.id_apply, toHom_coordInv]
    simp [solB, solBA, solBAA, FreeGroup.of, FreeGroup.mul_mk]
  · rw [endLT_iff]
    rintro ⟨⟨σ, hσ, π, hπ, -, h⟩, -⟩
    obtain rfl : π = .id _ := FreeGroup.ext_hom _ _ fun a ↦ hπ a trivial
    have h0 := h 0
    rw [MonoidHom.id_apply] at h0
    rcases (Subgroup.mem_zpowers_iff_of_sq_eq_one coordInv_sq).1 hσ with rfl | rfl
    · rw [MulAut.one_apply, toHom_genericPoint] at h0
      have := congrArg FreeGroup.toWord h0
      simp [solB, solBAA, FreeGroup.toWord_mk] at this
    · rw [toHom_coordInv] at h0
      have := congrArg FreeGroup.toWord h0
      simp [solB, solBAA, FreeGroup.toWord_mk, FreeGroup.toWord_mul] at this

end TauCeti.GenEq.Examples
