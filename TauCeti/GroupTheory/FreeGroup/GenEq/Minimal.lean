/-!
# Minimal solutions of a generalised equation

Let `M` be a group of automorphisms of the coordinate group `F_{R(Ω)}` of a generalised equation `Ω`
over `F(A)`. A solution `U₁` of `Ω` is *smaller* than a solution `U₂` with respect to `M`, written
`U₁ <_M U₂`, if `U₂ = U₁ ∘ σ` as homomorphisms `F_{R(Ω)} → F(A)` for some `σ ∈ M`, no item is longer
in `U₁` than in `U₂`, and some item is shorter. A solution is *`M`-minimal* if no solution is
smaller than it. Since the total length of a solution decreases strictly along `<_M`, every
solution is minimal or lies above a minimal one. In the Makanin–Razborov process the groups `M`
are built from groups of canonical automorphisms of the vertices of the solution tree, and the
paths of minimal solutions through the tree stay in a finite subtree.

The sources compare solutions up to an endomorphism `π` of the free group as well: their condition
is `U₂ = π ∘ U₁ ∘ σ`, where `π` fixes the coefficient letters and, in [IFT], the values of the
parameters; `<_M` is the case where `π` is the identity. The relation `U₁ <_{M,K,S} U₂` allows such
a `π` fixing a set `K` of letters and the values of `U₁` at a set `S` of items, and compares the two
solutions on the items. A letter outside `K` plays the role of the fresh letters of [VAR-II], §6,
which replace long periodic pieces of minimal solutions. Minimality up to endomorphisms implies
`M`-minimality and can be strictly stronger: `h = ba` is minimal for the trivial group, but for
`K = {a}` it is the image of `h = b` under `b ↦ ba`. The relation is transitive, and every
solution is minimal or lies above a minimal one, when `M` is *defined over `K`* and fixes the items
of `S`: its elements fix the letters of `K` and the items of `S`, and map the subgroup generated by
the items and the letters of `K` onto itself. The sources compare the two homomorphisms on the whole
coordinate group, where composing the witnesses gives transitivity as soon as `M` fixes the items of
`S`. Here the coordinate group contains all of `F(A)`, so that comparison forces `π` to fix every
letter that `σ` fixes; for the trivial group `π` must be the identity, and `h = ba` above stays
minimal. Comparing on the items avoids this, at the cost of the further conditions on `M`; without
the condition that `M` fix the letters of `K`, transitivity can fail, as the example at the end of
the file shows.

The sources differ further as follows. [IFT] compares only the lengths of the active items. Given
the witnesses `σ` and `π`, its length test agrees with the one here when `σ` fixes the other items
and, for `<_{M,K,S}`, these lie in `S`: each of them then has the same value in `U₁` and `U₂`. The
domain of comparison and the conditions on `π` differ as described above. Its automorphisms fix the
coefficient letters and the parameters, which `<_M` does not need. Finally, it asserts a minimal
solution strictly below every solution, which fails when the solution is itself minimal;
`exists_isAutMinimal` and `exists_isEndMinimal` allow equality.

## Main definitions

* `TauCeti.GenEq.Solution.AutLT`: the relation `U₁ <_M U₂`.
* `TauCeti.GenEq.Solution.IsAutMinimal`: `M`-minimal solutions.
* `TauCeti.GenEq.autOver`: the automorphisms defined over a set of letters and fixing a set of
  items.
* `TauCeti.GenEq.Solution.EndLT`: the relation `U₁ <_{M,K,S} U₂`.
* `TauCeti.GenEq.Solution.IsEndMinimal`: solutions minimal up to endomorphisms.

## Main results

* `TauCeti.GenEq.Solution.AutLT.trans`: `<_M` is transitive.
* `TauCeti.GenEq.Solution.wellFounded_autLT`: `<_M` is well founded.
* `TauCeti.GenEq.Solution.exists_isAutMinimal`: every solution is `M`-minimal or lies above an
  `M`-minimal solution.
* `TauCeti.GenEq.Solution.wellFounded_endLT`: `<_{M,K,S}` is well founded.
* `TauCeti.GenEq.Solution.EndLT.trans`, `TauCeti.GenEq.Solution.exists_isEndMinimal`: `<_{M,K,S}`
  is transitive, and every solution is minimal up to endomorphisms or lies above such a minimal
  solution, when `M` is defined over `K` and fixes the items of `S`.
* `TauCeti.GenEq.Solution.IsEndMinimal.isAutMinimal`: minimality up to endomorphisms implies
  `M`-minimality.

## References

* [IFT] O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra
  290 (2005), §5.5.1.
* [VAR-II] O. Kharlampovich, A. Myasnikov, *Irreducible affine varieties over a free group. II:
  Systems in triangular quasi-quadratic form and description of residually free groups*,
  J. Algebra 200 (1998), §2 and §6.
-/

public section

open TauCeti.GroupAlgGeom

namespace TauCeti.GenEq.Solution

variable {A : Type*} {Ω : GenEq A} (M : Subgroup (MulAut Ω.coordGroup))

/-- `U₁ <_M U₂`: the homomorphism of `U₂` is that of `U₁` composed with an automorphism in `M`, no
item is longer in `U₁` than in `U₂`, and some item is shorter. -/
def AutLT (U₁ U₂ : Ω.Solution) : Prop :=
  (∃ σ ∈ M, ∀ g, U₂.toHom g = U₁.toHom (σ g)) ∧
    (∀ k, (U₁.word k).length ≤ (U₂.word k).length) ∧ ∃ k, (U₁.word k).length < (U₂.word k).length

/-- Unfolding `U₁ <_M U₂`. -/
theorem autLT_iff {U₁ U₂ : Ω.Solution} : AutLT M U₁ U₂ ↔
    (∃ σ ∈ M, ∀ g, U₂.toHom g = U₁.toHom (σ g)) ∧ (∀ k, (U₁.word k).length ≤ (U₂.word k).length) ∧
      ∃ k, (U₁.word k).length < (U₂.word k).length :=
  Iff.rfl

variable {M}

/-- The relation `<_M` is transitive. -/
theorem AutLT.trans {U₁ U₂ U₃ : Ω.Solution} (h₁₂ : AutLT M U₁ U₂) (h₂₃ : AutLT M U₂ U₃) :
    AutLT M U₁ U₃ := by
  obtain ⟨⟨σ, hσ, h⟩, hle, k, hk⟩ := h₁₂
  obtain ⟨⟨τ, hτ, h'⟩, hle', -⟩ := h₂₃
  exact ⟨⟨σ * τ, M.mul_mem hσ hτ, fun g ↦ (h' g).trans (h (τ g))⟩,
    fun j ↦ (hle j).trans (hle' j), k, hk.trans_le (hle' k)⟩

variable (M)

/-- The relation `<_M` is well founded: the tuple of lengths of the items decreases strictly along
it. -/
theorem wellFounded_autLT : WellFounded (AutLT M) :=
  Subrelation.wf (fun h ↦ Pi.lt_def.2 h.2)
    (InvImage.wf (fun (U : Ω.Solution) k ↦ (U.word k).length) wellFounded_lt)

/-- A solution is *`M`-minimal* when no solution is smaller than it with respect to `M`. -/
def IsAutMinimal (U : Ω.Solution) : Prop :=
  ∀ U' : Ω.Solution, ¬ AutLT M U' U

/-- Unfolding `M`-minimality. -/
theorem isAutMinimal_iff {U : Ω.Solution} : IsAutMinimal M U ↔ ∀ U', ¬ AutLT M U' U :=
  Iff.rfl

/-- For a transitive well-founded relation `r`, every element is `r`-minimal or lies above an
`r`-minimal element. -/
private theorem exists_minimal_eq_or_rel {α : Type*} {r : α → α → Prop} (hr : WellFounded r)
    (htrans : ∀ {a b c}, r a b → r b c → r a c) (a : α) :
    ∃ b, (∀ c, ¬ r c b) ∧ (b = a ∨ r b a) := by
  obtain ⟨b, hb, hmin⟩ := hr.has_min {b | b = a ∨ r b a} ⟨a, .inl rfl⟩
  refine ⟨b, fun c h ↦ hmin c ?_ h, hb⟩
  rcases hb with rfl | hb
  exacts [.inr h, .inr (htrans h hb)]

/-- Every solution is `M`-minimal or lies above an `M`-minimal solution. -/
theorem exists_isAutMinimal (U : Ω.Solution) :
    ∃ U₀ : Ω.Solution, IsAutMinimal M U₀ ∧ (U₀ = U ∨ AutLT M U₀ U) :=
  exists_minimal_eq_or_rel (wellFounded_autLT M) AutLT.trans U

/-! ### Example: one free item -/

section Example

open Monoid.Coprod

/-- The generalised equation over `F(a, b)` with a single item `h` and no bases, with `a = 0` and
`b = 1`. -/
private abbrev freeItem : GenEq (Fin 2) where
  numItems := 1
  numBases := 0
  left := Fin.elim0
  right := Fin.elim0
  left_lt_right := fun μ ↦ μ.elim0
  sign := Fin.elim0
  dual := Fin.elim0
  dual_involutive := fun μ ↦ μ.elim0
  constBases := ∅
  connections := ∅
  bounds_of_mem_connections := by simp
  dual_mem_connections := by simp

private theorem toSystem_freeItem : freeItem.toSystem = ∅ := by
  refine Set.eq_empty_of_forall_notMem fun w hw ↦ ?_
  obtain ⟨e, he, -⟩ := (mem_toSystem_iff _).1 hw
  exact (forall_mem_equations (P := fun _ ↦ False) _).2
    ⟨fun μ ↦ μ.elim0, fun _ hb ↦ absurd hb (Finset.notMem_empty _),
      fun _ hc ↦ absurd hc (Finset.notMem_empty _)⟩ e he

/-- The automorphism `h ↦ h a` of `F(a, b)[h]`. -/
private noncomputable abbrev mulRightA : MulAut (GX (FreeGroup (Fin 2)) (Fin 1)) :=
  GX.transvection 0 1 (inl (FreeGroup.of 0)) (one_mem _) (GX.inl_mem_avoiding 0 _)

/-- The automorphism `h ↦ h a` of the coordinate group of `freeItem`. -/
private noncomputable def coordMulRightA : MulAut freeItem.coordGroup :=
  QuotientGroup.congr _ _ mulRightA (by
    rw [← Rad_image_mulEquiv _ mulRightA (GX.transvection_inl _ _), toSystem_freeItem,
      Set.image_empty])

/-- The solution `h = b`. -/
private def solB : freeItem.Solution :=
  ofNumBasesEqZero (Ω := freeItem) rfl rfl ![[(1, true)]]
    (by unfold FreeGroup.IsReduced; decide) (by decide)

/-- The solution `h = ba`. -/
private def solBA : freeItem.Solution :=
  ofNumBasesEqZero (Ω := freeItem) rfl rfl ![[(1, true), (0, true)]]
    (by unfold FreeGroup.IsReduced; decide) (by decide)

/-- `h = b` is smaller than `h = ba` with respect to the group generated by `h ↦ h a`. -/
private theorem autLT_solB_solBA : AutLT (Subgroup.zpowers coordMulRightA) solB solBA := by
  refine ⟨⟨coordMulRightA, Subgroup.mem_zpowers _, fun g ↦ ?_⟩, by simp [solB, solBA], 0,
    by simp [solB, solBA]⟩
  induction g using QuotientGroup.induction_on with
  | H w =>
    rw [coordMulRightA, QuotientGroup.congr_mk, toHom_mk, toHom_mk, GX.eval_transvection]
    congr 2
    funext k
    rw [Subsingleton.elim k 0]
    simp [solB, solBA, FreeGroup.of, FreeGroup.mul_mk]

/-- `h = ba` is not minimal with respect to the group generated by `h ↦ h a`. -/
example : ¬ IsAutMinimal (Subgroup.zpowers coordMulRightA) solBA :=
  fun h ↦ h solB autLT_solB_solBA

end Example

end TauCeti.GenEq.Solution

/-! ### Minimality up to endomorphisms of the free group -/

namespace TauCeti.GenEq

open TauCeti.GroupAlgGeom Pointwise

variable {A : Type*} (Ω : GenEq A)

/-- The automorphisms of the coordinate group `F_{R(Ω)}` *defined over* a set `K` of letters and
fixing a set `S` of items: they fix the letters of `K` and the items of `S`, and map the subgroup
generated by the items and the letters of `K` onto itself. -/
def autOver (K : Set A) (S : Set (Fin Ω.numItems)) : Subgroup (MulAut Ω.coordGroup) :=
  fixingSubgroup (MulAut Ω.coordGroup)
      (CoordGroup.coeff (.id (FreeGroup A)) Ω.toSystem '' (FreeGroup.of '' K) ∪
        CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem '' S) ⊓
    MulAction.stabilizer (MulAut Ω.coordGroup)
      (Subgroup.closure (Set.range (CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem) ∪
        CoordGroup.coeff (.id (FreeGroup A)) Ω.toSystem '' (FreeGroup.of '' K)))

variable {Ω} in
/-- An automorphism is defined over `K` and fixes the items of `S` when it fixes the letters of
`K` and the items of `S` and maps the subgroup generated by the items and the letters of `K` onto
itself. -/
theorem mem_autOver_iff {K : Set A} {S : Set (Fin Ω.numItems)} {σ : MulAut Ω.coordGroup} :
    σ ∈ Ω.autOver K S ↔
      (∀ a ∈ K, σ (CoordGroup.coeff (.id (FreeGroup A)) Ω.toSystem (FreeGroup.of a)) =
          CoordGroup.coeff (.id (FreeGroup A)) Ω.toSystem (FreeGroup.of a)) ∧
        (∀ k ∈ S, σ (CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem k) =
          CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem k) ∧
        σ • Subgroup.closure (Set.range (CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem) ∪
            CoordGroup.coeff (.id (FreeGroup A)) Ω.toSystem '' (FreeGroup.of '' K)) =
          Subgroup.closure (Set.range (CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem) ∪
            CoordGroup.coeff (.id (FreeGroup A)) Ω.toSystem '' (FreeGroup.of '' K)) := by
  simp only [autOver, Subgroup.mem_inf, mem_fixingSubgroup_iff, Set.forall_mem_union,
    Set.forall_mem_image, MulAut.smul_def, MulAction.mem_stabilizer_iff, and_assoc]

namespace Solution

variable {Ω} (M : Subgroup (MulAut Ω.coordGroup)) (K : Set A) (S : Set (Fin Ω.numItems))

/-- `U₁ <_{M,K,S} U₂`: the point of `U₂` is the image of that of `U₁ ∘ σ`, `σ ∈ M`, under an
endomorphism of `F(A)` fixing the letters of `K` and the values of `U₁` at the items of `S`; no item
is longer in `U₁` than in `U₂`, and some item is shorter. -/
def EndLT (U₁ U₂ : Ω.Solution) : Prop :=
  (∃ σ ∈ M, ∃ π : FreeGroup A →* FreeGroup A, (∀ a ∈ K, π (FreeGroup.of a) = FreeGroup.of a) ∧
      (∀ k ∈ S, π (U₁.point k) = U₁.point k) ∧
      ∀ k, U₂.point k =
        π (U₁.toHom (σ (CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem k)))) ∧
    (∀ k, (U₁.word k).length ≤ (U₂.word k).length) ∧ ∃ k, (U₁.word k).length < (U₂.word k).length

/-- Unfolding `U₁ <_{M,K,S} U₂`. -/
theorem endLT_iff {U₁ U₂ : Ω.Solution} : EndLT M K S U₁ U₂ ↔
    (∃ σ ∈ M, ∃ π : FreeGroup A →* FreeGroup A, (∀ a ∈ K, π (FreeGroup.of a) = FreeGroup.of a) ∧
      (∀ k ∈ S, π (U₁.point k) = U₁.point k) ∧
      ∀ k, U₂.point k =
        π (U₁.toHom (σ (CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem k)))) ∧
    (∀ k, (U₁.word k).length ≤ (U₂.word k).length) ∧
      ∃ k, (U₁.word k).length < (U₂.word k).length :=
  Iff.rfl

variable {M K S}

/-- A solution smaller than another with respect to `M` is smaller up to endomorphisms. -/
theorem AutLT.endLT {U₁ U₂ : Ω.Solution} (h : AutLT M U₁ U₂) : EndLT M K S U₁ U₂ := by
  obtain ⟨⟨σ, hσ, h⟩, hle, hlt⟩ := h
  refine ⟨⟨σ, hσ, .id _, fun _ _ ↦ rfl, fun _ _ ↦ rfl, fun k ↦ ?_⟩, hle, hlt⟩
  simp [← h, CoordGroup.genericPoint_apply]

/-- For a group of automorphisms defined over `K` and fixing the items of `S`, the relation
`<_{M,K,S}` is transitive. -/
theorem EndLT.trans (hM : M ≤ Ω.autOver K S) {U₁ U₂ U₃ : Ω.Solution} (h₁₂ : EndLT M K S U₁ U₂)
    (h₂₃ : EndLT M K S U₂ U₃) : EndLT M K S U₁ U₃ := by
  obtain ⟨⟨σ₁, hσ₁, π₁, hK₁, hS₁, h₁⟩, hle, k, hk⟩ := h₁₂
  obtain ⟨⟨σ₂, hσ₂, π₂, hK₂, hS₂, h₂⟩, hle', -⟩ := h₂₃
  obtain ⟨hσK, hσS, -⟩ := mem_autOver_iff.1 (hM hσ₁)
  have hH := (mem_autOver_iff.1 (hM hσ₂)).2.2
  -- `U₂` and `π₁ ∘ U₁ ∘ σ₁` agree on the items and on the letters of `K`, hence on the subgroup
  -- they generate, which `σ₂` preserves.
  have heq : Set.EqOn (U₂.toHom : Ω.coordGroup →* FreeGroup A)
      (π₁.comp ((U₁.toHom : Ω.coordGroup →* FreeGroup A).comp σ₁.toMonoidHom)) _ :=
    MonoidHom.eqOn_closure
      (s := Set.range (CoordGroup.genericPoint (.id (FreeGroup A)) Ω.toSystem) ∪
        CoordGroup.coeff (.id (FreeGroup A)) Ω.toSystem '' (FreeGroup.of '' K)) <| by
    rintro _ (⟨j, rfl⟩ | ⟨_, ⟨a, ha, rfl⟩, rfl⟩)
    · simpa [CoordGroup.genericPoint_apply] using h₁ j
    · simp [-CoordGroup.coeff_apply, hσK a ha, hK₁ a ha]
  have hS₂₁ : ∀ j ∈ S, U₂.point j = U₁.point j := fun j hj ↦ by
    rw [h₁ j, hσS j hj]
    simpa [CoordGroup.genericPoint_apply] using hS₁ j hj
  refine ⟨⟨σ₁ * σ₂, M.mul_mem hσ₁ hσ₂, π₂.comp π₁, fun a ha ↦ by simp [hK₁ a ha, hK₂ a ha],
    fun j hj ↦ ?_, fun j ↦ ?_⟩, fun j ↦ (hle j).trans (hle' j), k, hk.trans_le (hle' k)⟩
  · rw [MonoidHom.comp_apply, hS₁ j hj, ← hS₂₁ j hj, hS₂ j hj]
  · rw [h₂ j]
    exact congrArg π₂ (heq (hH ▸ Subgroup.smul_mem_pointwise_smul _ σ₂ _
      (Subgroup.subset_closure (Set.mem_union_left _ ⟨j, rfl⟩))))

variable (M K S)

/-- The relation `<_{M,K,S}` is well founded: the tuple of lengths of the items decreases strictly
along it. -/
theorem wellFounded_endLT : WellFounded (EndLT M K S) :=
  Subrelation.wf (fun h ↦ Pi.lt_def.2 h.2)
    (InvImage.wf (fun (U : Ω.Solution) k ↦ (U.word k).length) wellFounded_lt)

/-- A solution is *minimal up to endomorphisms* fixing `K` and the values at `S`, with respect to
`M`, when no solution is smaller than it for `<_{M,K,S}`. -/
def IsEndMinimal (U : Ω.Solution) : Prop :=
  ∀ U' : Ω.Solution, ¬ EndLT M K S U' U

/-- Unfolding minimality up to endomorphisms. -/
theorem isEndMinimal_iff {U : Ω.Solution} : IsEndMinimal M K S U ↔ ∀ U', ¬ EndLT M K S U' U :=
  Iff.rfl

variable {M K S}

/-- Every solution is minimal up to endomorphisms or lies above such a minimal solution, for a
group of automorphisms defined over `K` and fixing the items of `S`. -/
theorem exists_isEndMinimal (hM : M ≤ Ω.autOver K S) (U : Ω.Solution) :
    ∃ U₀ : Ω.Solution, IsEndMinimal M K S U₀ ∧ (U₀ = U ∨ EndLT M K S U₀ U) :=
  exists_minimal_eq_or_rel (wellFounded_endLT M K S) (fun h₁₂ h₂₃ ↦ h₁₂.trans hM h₂₃) U

/-- A solution minimal up to endomorphisms is minimal with respect to `M`. -/
theorem IsEndMinimal.isAutMinimal {U : Ω.Solution} (h : IsEndMinimal M K S U) :
    IsAutMinimal M U :=
  fun U' h' ↦ h U' h'.endLT

/-- Minimality up to endomorphisms with respect to a group, a set of fixed letters and a set of
items whose values are fixed implies it for every subgroup, every larger set of fixed letters and
every larger set of items. -/
theorem IsEndMinimal.mono {M' : Subgroup (MulAut Ω.coordGroup)} {K' : Set A}
    {S' : Set (Fin Ω.numItems)} (hM : M' ≤ M) (hK : K ⊆ K') (hS : S ⊆ S') {U : Ω.Solution}
    (h : IsEndMinimal M K S U) : IsEndMinimal M' K' S' U := by
  rintro U' ⟨⟨σ, hσ, π, hπK, hπS, hπ⟩, hle, hlt⟩
  exact h U' ⟨⟨σ, hM hσ, π, fun a ha ↦ hπK a (hK ha), fun k hk ↦ hπS k (hS hk), hπ⟩, hle, hlt⟩

/-! ### Examples: one free item, continued -/

section Example

open Monoid.Coprod

/-- `h = ba` is minimal with respect to the trivial group of automorphisms, as every solution is. -/
example : IsAutMinimal ⊥ solBA := by
  rintro U ⟨⟨σ, hσ, h⟩, -, k, hk⟩
  obtain rfl : σ = 1 := Subgroup.mem_bot.1 hσ
  obtain rfl : U = solBA := point_injective <| funext fun j ↦ by
    have := h ((inr (FreeGroup.of j) : GX (FreeGroup (Fin 2)) (Fin 1)) : freeItem.coordGroup)
    rw [MulAut.one_apply, toHom_inr_of, toHom_inr_of] at this
    simpa only [point_apply] using this.symm
  exact lt_irrefl _ hk

/-- `h = b` is minimal up to endomorphisms for every group, set of letters and set of items: no
item of a solution is empty. -/
private theorem isEndMinimal_solB (M : Subgroup (MulAut freeItem.coordGroup)) (K : Set (Fin 2))
    (S : Set (Fin 1)) : IsEndMinimal M K S solB := by
  rintro U ⟨-, -, k, hk⟩
  exact U.word_ne_nil k (by simpa [solB] using hk)

/-- `h = b` is minimal with respect to every group of automorphisms. -/
example (M : Subgroup (MulAut freeItem.coordGroup)) : IsAutMinimal M solB :=
  (isEndMinimal_solB M ∅ ∅).isAutMinimal

/-- `h = ba` is not minimal up to endomorphisms fixing `a`: it is the image of `h = b` under
`b ↦ ba`. -/
example : ¬ IsEndMinimal ⊥ {0} ∅ solBA := by
  refine fun h ↦ h solB ⟨⟨1, one_mem _, FreeGroup.lift ![.of 0, .of 1 * .of 0], by simp,
    by simp, fun k ↦ ?_⟩, by simp [solB, solBA], 0, by simp [solB, solBA]⟩
  rw [Subsingleton.elim k 0, MulAut.one_apply, CoordGroup.genericPoint_apply, toHom_inr_of]
  simp [solB, solBA, FreeGroup.of, FreeGroup.mul_mk]

/-- The solution `h = baa`. -/
private def solBAA : freeItem.Solution :=
  ofNumBasesEqZero (Ω := freeItem) rfl rfl ![[(1, true), (0, true), (0, true)]]
    (by unfold FreeGroup.IsReduced; decide) (by decide)

/-- The involution `a ↦ a⁻¹`, `b ↦ b` of `F(a, b)`. -/
private noncomputable def invA : FreeGroup (Fin 2) →* FreeGroup (Fin 2) :=
  FreeGroup.lift ![(FreeGroup.of 0)⁻¹, FreeGroup.of 1]

private theorem invA_invA (g : FreeGroup (Fin 2)) : invA (invA g) = g :=
  DFunLike.congr_fun (FreeGroup.ext_hom (invA.comp invA) (.id _) fun i ↦ by
    revert i; simp [Fin.forall_fin_two, invA]) g

/-- The involution `a ↦ a⁻¹`, `b ↦ b`, `h ↦ h a` of `F(a, b)[h]`. -/
private noncomputable def gxInvA :
    GX (FreeGroup (Fin 2)) (Fin 1) →* GX (FreeGroup (Fin 2)) (Fin 1) :=
  lift (inl.comp invA) (FreeGroup.lift fun j ↦ inr (FreeGroup.of j) * inl (FreeGroup.of 0))

private theorem gxInvA_comp_gxInvA : gxInvA.comp gxInvA = .id _ :=
  hom_ext (MonoidHom.ext fun g ↦ by simp [gxInvA, invA_invA])
    (FreeGroup.ext_hom _ _ fun j ↦ by simp [gxInvA, invA])

/-- The radical of `freeItem`, which has no equations, is trivial: `F(a, b)[h]` is separated by
`F(a, b)`. -/
private theorem rad_freeItem : Rad (.id _) freeItem.toSystem = ⊥ := by
  have h := (GX.isDiscriminatedBy_of_isFreeGroup (X := Fin 1)
    (FreeGroup.not_isMulCommutative (α := Fin 2))).isSeparatedBy.Rad_ker_eq (GHom.id _)
  rw [(MonoidHom.ker_eq_bot_iff _).2 ?_, ← Subgroup.normalClosure_empty, Rad_normalClosure,
    Subgroup.normalClosure_empty] at h
  · rwa [toSystem_freeItem]
  · simpa using Function.injective_id

/-- The involution `a ↦ a⁻¹`, `b ↦ b`, `h ↦ h a` of the coordinate group of `freeItem`. It moves
the letter `a`. -/
private noncomputable def coordInvA : MulAut freeItem.coordGroup :=
  QuotientGroup.congr _ _ (gxInvA.toMulEquiv gxInvA gxInvA_comp_gxInvA gxInvA_comp_gxInvA)
    (by rw [rad_freeItem, Subgroup.map_bot])

private theorem coordInvA_sq : coordInvA ^ 2 = 1 :=
  MulEquiv.ext fun g ↦ QuotientGroup.induction_on g fun w ↦ by
    rw [pow_two, MulAut.mul_apply, coordInvA, QuotientGroup.congr_mk, QuotientGroup.congr_mk]
    simp [← MonoidHom.comp_apply, gxInvA_comp_gxInvA]

private theorem toHom_coordInvA (U : freeItem.Solution) :
    U.toHom (coordInvA (CoordGroup.genericPoint (.id _) _ 0)) = U.point 0 * FreeGroup.of 0 := by
  rw [CoordGroup.genericPoint_apply, coordInvA, QuotientGroup.congr_mk, toHom_mk]
  simp [gxInvA]

/-- With all letters fixed, `<_{M,K,S}` is not transitive for the group generated by an
automorphism moving a letter: `h = b` lies below `h = ba`, which lies below `h = baa`, but
`h = b` does not lie below `h = baa`. -/
example :
    EndLT (Subgroup.zpowers coordInvA) Set.univ ∅ solB solBA ∧
      EndLT (Subgroup.zpowers coordInvA) Set.univ ∅ solBA solBAA ∧
      ¬ EndLT (Subgroup.zpowers coordInvA) Set.univ ∅ solB solBAA := by
  refine ⟨⟨⟨coordInvA, Subgroup.mem_zpowers _, .id _, by simp, by simp, fun k ↦ ?_⟩,
      by simp [solB, solBA], 0, by simp [solB, solBA]⟩,
    ⟨⟨coordInvA, Subgroup.mem_zpowers _, .id _, by simp, by simp, fun k ↦ ?_⟩,
      by simp [solBA, solBAA], 0, by simp [solBA, solBAA]⟩, ?_⟩
  iterate 2
    rw [Subsingleton.elim k 0, MonoidHom.id_apply, toHom_coordInvA]
    simp [solB, solBA, solBAA, FreeGroup.of, FreeGroup.mul_mk]
  · rintro ⟨⟨σ, hσ, π, hπ, -, h⟩, -⟩
    obtain rfl : π = .id _ := FreeGroup.ext_hom _ _ fun a ↦ hπ a trivial
    have h0 := h 0
    rw [MonoidHom.id_apply] at h0
    rcases (Subgroup.mem_zpowers_iff_of_sq_eq_one coordInvA_sq).1 hσ with rfl | rfl
    · rw [MulAut.one_apply, CoordGroup.genericPoint_apply, toHom_inr_of] at h0
      have := congrArg FreeGroup.toWord h0
      simp [solB, solBAA, FreeGroup.toWord_mk] at this
    · rw [toHom_coordInvA] at h0
      have := congrArg FreeGroup.toWord h0
      simp [solB, solBAA, FreeGroup.toWord_mk, FreeGroup.toWord_mul] at this

end Example

end Solution

end TauCeti.GenEq
