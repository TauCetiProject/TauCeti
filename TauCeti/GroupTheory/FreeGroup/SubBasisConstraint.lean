/-!
# Systems of equations and inequations with sub-basis constraints

A finite system of equations and inequations over a free group `F(A)` is often solved under
*constraints*: each variable `x` is required to take its value in the subgroup generated by a
prescribed set `C x` of basis letters. Such constraints appear when a positive sentence
`∀ x₁ ∃ y₁ … ∀ xₖ ∃ yₖ, S = 1` is lifted to the free group `F(A)[X]`: the value of `yᵢ` must lie
in the subgroup generated by `A` and `x₁, …, xᵢ`.

This file defines the constrained solutions of a `TauCeti.EqIneqSystem`. A constraint is a function
`C : X → Set A` from variables to sets of coefficient letters, and the definition makes sense for
any group `G` with a coefficient map `c : A → G`: the value of `x` must lie in the subgroup
generated by `c '' C x`. For `G = F(A)` and `c = FreeGroup.of` these are the subgroups generated
by sub-bases.

## Main definitions

* `TauCeti.EqIneqSystem.IsConstrainedSolution`: an assignment solves a system and takes each
  variable into the subgroup generated by its allowed coefficient letters.

## Main results

* `TauCeti.EqIneqSystem.IsConstrainedSolution.mono`: enlarging the constraint sets keeps
  constrained solutions.
* `TauCeti.EqIneqSystem.isConstrainedSolution_univ_of`: over a free group, allowing every basis
  letter for every variable is no constraint.
* `TauCeti.EqIneqSystem.isConstrainedSolution_append`: a constrained solution of a conjunction is
  a constrained solution of both systems.
* `TauCeti.EqIneqSystem.exists_isConstrainedSolution_commutator_eq_commutator`: the equation
  `[x, y] = [a, b]` is solved by `x = a`, `y = b` whenever the constraints allow `a` for `x`
  and `b` for `y`.
* `TauCeti.EqIneqSystem.not_isSolution_commutator_of_commutator_of`: over a free group, the
  system `[x, a] = 1`, `[x, b] = 1`, `x ≠ 1` has no solution for distinct basis letters `a`, `b`.
* `TauCeti.EqIneqSystem.existsUnique_isConstrainedSolution_pow_eq_pow`: in a group with unique
  roots, `y ^ n = a ^ n` with `n ≠ 0` has exactly one constrained solution in one variable when
  `a` is allowed for `y`.
* `TauCeti.EqIneqSystem.not_isConstrainedSolution_var_eq_of`: over a free group, the equation
  `y = b` has no solution with `y` in the subgroup generated by basis letters other than `b`.
* `TauCeti.EqIneqSystem.not_isSolution_pow_eq_of`: over a free group, `x ^ n = a` with `2 ≤ n`
  has no solution for a basis letter `a`.

## References

* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §4.4, proof of Corollary 9 (equations over free groups with the constraints
  `yᵢ ∈ F[Xᵢ]`).
* V. Diekert, A. Jez, W. Plandowski, *Finding all solutions of equations in free groups and
  monoids with involution*, Inform. and Comput. 251 (2016), §1–§2 (equations with constraints).
-/

public section

namespace TauCeti

namespace EqIneqSystem

open FreeGroup (of)
open scoped commutatorElement

variable {X A G H : Type*} [Group G] [Group H]

/-- An assignment `v` is a solution of the system `S` under the constraint `C` when it solves `S`
and the value of each variable `x` lies in the subgroup generated by the coefficients `c a` with
`a ∈ C x`. Over the free group `F(A)` with `c = FreeGroup.of`, each variable is restricted to the
subgroup generated by a sub-basis. -/
def IsConstrainedSolution (S : EqIneqSystem X A) (C : X → Set A) (v : X → G) (c : A → G) : Prop :=
  S.IsSolution v c ∧ ∀ x, v x ∈ Subgroup.closure (c '' C x)

/-- A constrained solution is a solution whose values lie in the subgroups generated by the
allowed coefficients. -/
theorem isConstrainedSolution_iff (S : EqIneqSystem X A) (C : X → Set A) (v : X → G) (c : A → G) :
    S.IsConstrainedSolution C v c ↔
      S.IsSolution v c ∧ ∀ x, v x ∈ Subgroup.closure (c '' C x) :=
  Iff.rfl

section API

variable {S : EqIneqSystem X A} {C D : X → Set A} {v : X → G} {c : A → G}

/-- A constrained solution is a solution. -/
theorem IsConstrainedSolution.isSolution (h : S.IsConstrainedSolution C v c) :
    S.IsSolution v c := h.1

/-- A constrained solution takes each variable into the subgroup generated by its allowed
coefficients. -/
theorem IsConstrainedSolution.mem_closure (h : S.IsConstrainedSolution C v c) (x : X) :
    v x ∈ Subgroup.closure (c '' C x) := h.2 x

/-- Enlarging the constraint sets keeps constrained solutions. -/
theorem IsConstrainedSolution.mono (h : S.IsConstrainedSolution C v c) (hCD : ∀ x, C x ⊆ D x) :
    S.IsConstrainedSolution D v c :=
  ⟨h.1, fun x => Subgroup.closure_mono (Set.image_mono (hCD x)) (h.2 x)⟩

/-- A variable that is allowed no coefficient letter takes the value `1`. -/
theorem IsConstrainedSolution.eq_one_of_eq_empty (h : S.IsConstrainedSolution C v c) {x : X}
    (hx : C x = ∅) : v x = 1 := by
  simpa [hx] using h.2 x

end API

/-- When the coefficients generate the group, allowing every coefficient letter for every
variable is no constraint. -/
theorem isConstrainedSolution_univ_iff (S : EqIneqSystem X A) {c : A → G}
    (hc : Subgroup.closure (Set.range c) = ⊤) (v : X → G) :
    S.IsConstrainedSolution (fun _ => Set.univ) v c ↔ S.IsSolution v c := by
  simp [isConstrainedSolution_iff, hc]

/-- Over a free group, allowing every basis letter for every variable is no constraint. -/
@[simp] theorem isConstrainedSolution_univ_of (S : EqIneqSystem X A) (v : X → FreeGroup A) :
    S.IsConstrainedSolution (fun _ => Set.univ) v of ↔ S.IsSolution v of :=
  S.isConstrainedSolution_univ_iff (FreeGroup.closure_range_of A) v

/-- The constrained solutions of the empty system are the assignments satisfying the
constraints. -/
@[simp] theorem isConstrainedSolution_empty_iff (C : X → Set A) (v : X → G) (c : A → G) :
    (empty X A).IsConstrainedSolution C v c ↔ ∀ x, v x ∈ Subgroup.closure (c '' C x) := by
  simp [isConstrainedSolution_iff]

/-- The all-identity assignment solves the empty system under every constraint. -/
theorem isConstrainedSolution_empty_one (C : X → Set A) (c : A → G) :
    (empty X A).IsConstrainedSolution C (1 : X → G) c := by
  simp [one_mem]

/-- An assignment solves an appended system under a constraint exactly when it solves both
systems under that constraint. -/
@[simp] theorem isConstrainedSolution_append (S T : EqIneqSystem X A) (C : X → Set A) (v : X → G)
    (c : A → G) :
    (S.append T).IsConstrainedSolution C v c ↔
      S.IsConstrainedSolution C v c ∧ T.IsConstrainedSolution C v c := by
  simp only [isConstrainedSolution_iff, isSolution_append]
  tauto

/-- A constrained solution of a relabelled system restricts to a constrained solution of the
original system, for the constraint and the assignment pulled back along the relabelling. -/
theorem IsConstrainedSolution.of_relabel {Y : Type*} {f : X → Y} {S : EqIneqSystem X A}
    {D : Y → Set A} {v : Y → G} {c : A → G} (h : (S.relabel f).IsConstrainedSolution D v c) :
    S.IsConstrainedSolution (D ∘ f) (v ∘ f) c :=
  ⟨(isSolution_relabel f S v c).1 h.1, fun x => h.2 (f x)⟩

/-- Injective group homomorphisms preserve and reflect constrained solutions. -/
theorem isConstrainedSolution_comp_iff_of_injective (S : EqIneqSystem X A) (C : X → Set A)
    (φ : G →* H) (hφ : Function.Injective φ) (v : X → G) (c : A → G) :
    S.IsConstrainedSolution C (φ ∘ v) (φ ∘ c) ↔ S.IsConstrainedSolution C v c := by
  refine and_congr (S.isSolution_comp_iff_of_injective φ hφ v c) (forall_congr' fun x => ?_)
  rw [Set.image_comp, ← MonoidHom.map_closure, Function.comp_apply, Subgroup.mem_map_iff_mem hφ]

/-! ### Small constrained systems -/

/-- The equation `[x, y] = [a, b]` in two distinct variables has the solution `x = a`, `y = b`,
which satisfies every constraint allowing `a` for `x` and `b` for `y`. -/
theorem exists_isConstrainedSolution_commutator_eq_commutator {x y : X} (hxy : x ≠ y) {a b : A}
    {C : X → Set A} (ha : a ∈ C x) (hb : b ∈ C y) (c : A → G) :
    ∃ v : X → G,
      (⟨[⁅(of (Sum.inl x) : FreeGroup (X ⊕ A)), of (Sum.inl y)⁆ *
        ⁅(of (Sum.inr a) : FreeGroup (X ⊕ A)), of (Sum.inr b)⁆⁻¹], []⟩ :
        EqIneqSystem X A).IsConstrainedSolution C v c := by
  classical
  have hc : ⁅c a, c b⁆ * ⁅c b, c a⁆ = 1 := by rw [← commutatorElement_inv, inv_mul_cancel]
  refine ⟨Function.update (Function.update 1 x (c a)) y (c b), ?_, fun z => ?_⟩
  · simpa [isSolution_iff, map_commutatorElement, hxy] using hc
  · obtain rfl | hzy := eq_or_ne z y
    · simpa using Subgroup.subset_closure (Set.mem_image_of_mem c hb)
    obtain rfl | hzx := eq_or_ne z x
    · simpa [hzy] using Subgroup.subset_closure (Set.mem_image_of_mem c ha)
    · simp [hzy, hzx, one_mem]

/-- With no variables, the empty system has exactly one constrained solution. -/
example [IsEmpty X] (C : X → Set A) (c : A → G) :
    ∃! v : X → G, (empty X A).IsConstrainedSolution C v c :=
  ⟨1, isConstrainedSolution_empty_one C c, fun _ _ => Subsingleton.elim _ _⟩

/-- Over a free group, the system `[x, a] = 1`, `[x, b] = 1`, `x ≠ 1` has no solution when `a`
and `b` are distinct basis letters: an element commuting with both is trivial. -/
theorem not_isSolution_commutator_of_commutator_of {a b : A} (hab : a ≠ b) (x : X)
    (v : X → FreeGroup A) :
    ¬ (⟨[⁅(of (Sum.inl x) : FreeGroup (X ⊕ A)), of (Sum.inr a)⁆,
        ⁅(of (Sum.inl x) : FreeGroup (X ⊕ A)), of (Sum.inr b)⁆],
      [of (Sum.inl x)]⟩ : EqIneqSystem X A).IsSolution v of := by
  simp only [isSolution_iff, List.forall_mem_cons, map_commutatorElement, eval_of, Sum.elim_inl,
    Sum.elim_inr, commutatorElement_eq_one_iff_commute]
  rintro ⟨⟨ha, hb, -⟩, hx, -⟩
  exact hx (FreeGroup.eq_one_of_commute_of_of_commute_of hab ha hb)

/-- In a group with unique roots, the equation `y ^ n = a ^ n` with `n ≠ 0` says that `y = a`. -/
theorem isSolution_pow_eq_pow_iff [HasUniqueRoots G] {n : ℕ} (hn : n ≠ 0) (y : X) (a : A)
    (v : X → G) (c : A → G) :
    (⟨[of (Sum.inl y) ^ n * (of (Sum.inr a) ^ n)⁻¹], []⟩ : EqIneqSystem X A).IsSolution v c ↔
      v y = c a := by
  simp [isSolution_iff, mul_inv_eq_one, (pow_left_injective (M := G) hn).eq_iff]

/-- In a group with unique roots, the equation `y ^ n = a ^ n` with `n ≠ 0` in one variable has
exactly one solution under any constraint allowing `a` for `y`, in particular with `y` restricted
to the subgroup generated by `a`. -/
theorem existsUnique_isConstrainedSolution_pow_eq_pow [Unique X] [HasUniqueRoots G] {n : ℕ}
    (hn : n ≠ 0) {a : A} {C : X → Set A} (ha : a ∈ C default) (c : A → G) :
    ∃! v : X → G,
      (⟨[of (Sum.inl default) ^ n * (of (Sum.inr a) ^ n)⁻¹], []⟩ :
        EqIneqSystem X A).IsConstrainedSolution C v c := by
  refine ⟨fun _ => c a, ⟨(isSolution_pow_eq_pow_iff hn _ _ _ _).2 rfl, fun x => ?_⟩,
    fun w hw => funext fun x => ?_⟩
  · rw [Unique.eq_default x]
    exact Subgroup.subset_closure (Set.mem_image_of_mem c ha)
  · rw [Unique.eq_default x]
    exact (isSolution_pow_eq_pow_iff hn _ _ _ _).1 hw.1

/-- Over a free group, the equation `y = b` has no solution in which `y` is restricted to the
subgroup generated by a set of basis letters not containing `b`. -/
theorem not_isConstrainedSolution_var_eq_of {y : X} {b : A} {C : X → Set A} (hb : b ∉ C y)
    (v : X → FreeGroup A) :
    ¬ (⟨[of (Sum.inl y) * (of (Sum.inr b))⁻¹], []⟩ :
      EqIneqSystem X A).IsConstrainedSolution C v of := by
  rintro ⟨h, hC⟩
  have hy : v y = of b := by simpa [isSolution_iff, mul_inv_eq_one] using h
  exact hb (FreeGroup.of_mem_closure_image_of_iff.1 (hy ▸ hC y))

/-- Over a free group, the equation `x ^ n = a` with `2 ≤ n` has no solution when `a` is a basis
letter: a basis letter is not a proper power. -/
theorem not_isSolution_pow_eq_of {n : ℕ} (hn : 2 ≤ n) (x : X) (a : A) (v : X → FreeGroup A) :
    ¬ (⟨[of (Sum.inl x) ^ n * (of (Sum.inr a))⁻¹], []⟩ : EqIneqSystem X A).IsSolution v of := by
  intro h
  have hx : v x ^ n = of a := by simpa [isSolution_iff, mul_inv_eq_one] using h
  exact FreeGroup.not_isProperPower_of a (Group.isProperPower_iff.2 ⟨v x, n, hn, hx.symm⟩)

/-- Over the free group of rank zero every inequation fails: a system has a solution exactly when
it has no inequations. -/
example [IsEmpty A] (S : EqIneqSystem X A) (v : X → FreeGroup A) :
    S.IsSolution v of ↔ S.ineqs = [] :=
  S.isSolution_iff_of_subsingleton v of

/-- Over a free group of rank at most one the commutativity equation `[x, y] = 1` is solved by
every assignment. -/
example [Subsingleton A] (x y : X) (v : X → FreeGroup A) :
    (⟨[⁅(of (Sum.inl x) : FreeGroup (X ⊕ A)), of (Sum.inl y)⁆], []⟩ :
      EqIneqSystem X A).IsSolution v of := by
  have := FreeGroup.isMulCommutative_iff_subsingleton.2 ‹Subsingleton A›
  simpa [isSolution_iff, map_commutatorElement, commutatorElement_eq_one_iff_commute,
    commute_iff_eq] using mul_comm' (v x) (v y)

end EqIneqSystem

end TauCeti
