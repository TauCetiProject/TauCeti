module

public import TauCeti.GroupTheory.FreeGroup.Commuting
public import TauCeti.Algebra.Group.ProperPower
import TauCeti.GroupTheory.FreeGroup.Abelianization
import TauCeti.GroupTheory.SpecificGroups.Heisenberg.Basic

/-!
# Commutators in a free group are not proper powers

**Schützenberger's theorem**: a nontrivial commutator `⁅a, b⁆` of a free group is not a proper
power. More precisely, if `⁅a, b⁆ = c ^ n` with `n ≠ 1`, then `a` and `b` commute
(`IsFreeGroup.commute_of_commutator_eq_pow`); the exponent `1` is excluded since every commutator
is its own first power.

For `n = 0` the commutator is trivial. Otherwise the subgroup generated by `a`, `b` and `c` is
free (Nielsen–Schreier); its abelianization is torsion-free and contains the class of `c` as an
element whose `n`-th power, the class of `⁅a, b⁆`, is the identity, so `c` lies in its commutator
subgroup. A homomorphism to the Heisenberg group over `ZMod n` therefore sends `c` to the centre,
of exponent `n`, and kills `⁅a, b⁆ = c ^ n`: its range is commutative
(`TauCeti.HeisenbergGroup.pairwise_commute_map_of_commutatorElement_eq_pow`). Since the
Heisenberg group over `ZMod n` is not commutative for `n ≥ 2`, the free subgroup has no free basis
with two elements, so it is commutative. The argument follows the proof of Lyndon's theorem
(`IsFreeGroup.isVaught`), with the Heisenberg group over `ZMod n` in place of the dihedral group of
order `8`, which is the Heisenberg group over `ZMod 2`.

## Main results

* `IsFreeGroup.commute_of_commutator_eq_pow`: if `⁅a, b⁆ = c ^ n` with `n ≠ 1` in a free group,
  then `a` and `b` commute.
* `IsFreeGroup.not_isProperPower_commutator`: a nontrivial commutator of a free group is not a
  proper power.

## References

* M. P. Schützenberger, *Sur l'équation `a^{2+n} = b^{2+m} c^{2+p}` dans un groupe libre*,
  C. R. Acad. Sci. Paris 248 (1959), 2435–2436.
* O. Kharlampovich, A. Myasnikov, *Irreducible affine varieties over a free group. I*,
  J. Algebra 200 (1998), §2, proof of Lemma 12.
-/

public section

open scoped commutatorElement

open Subgroup TauCeti

namespace IsFreeGroup

variable {G : Type*} [Group G] [IsFreeGroup G]

/-- A free group generated by elements `a`, `b` and `c` with `⁅a, b⁆ = c ^ n`, `2 ≤ n`, is
commutative. -/
private theorem isMulCommutative_of_commutator_eq_pow {n : ℕ} (hn : 2 ≤ n) {a b c : G}
    (hG : closure {a, b, c} = ⊤) (h : ⁅a, b⁆ = c ^ n) : IsMulCommutative G := by
  have : Fact (1 < n) := ⟨hn⟩
  refine isMulCommutative_of_forall_isMulCommutative_range
    (x := (⟨1, 0, 0⟩ : HeisenbergGroup (ZMod n))) (y := ⟨0, 1, 0⟩) (fun hc => ?_) fun π => ?_
  · have := (HeisenbergGroup.commutatorElement_eq _ _).symm.trans
      (commutatorElement_eq_one_iff_commute.2 hc)
    simpa using congrArg HeisenbergGroup.z this
  rw [MonoidHom.range_eq_map, ← hG, MonoidHom.map_closure, Set.image_insert_eq,
    Set.image_insert_eq, Set.image_singleton]
  exact isMulCommutative_closure
    (HeisenbergGroup.pairwise_commute_map_of_commutatorElement_eq_pow (by omega) h π)

/-- **Schützenberger's theorem**, in the form of an equation: if `⁅a, b⁆ = c ^ n` in a free group
with `n ≠ 1`, then `a` and `b` commute. -/
theorem commute_of_commutator_eq_pow {a b c : G} {n : ℕ} (hn : n ≠ 1) (h : ⁅a, b⁆ = c ^ n) :
    Commute a b := by
  obtain rfl | hn2 : n = 0 ∨ 2 ≤ n := by omega
  · exact commutatorElement_eq_one_iff_commute.1 (by simpa using h)
  -- the subgroup generated by `a`, `b` and `c` is free (Nielsen–Schreier), hence commutative
  let K := closure ({a, b, c} : Set G)
  have : IsFreeGroup K := K.isFreeGroupOfIsFreeGroup
  have ha : a ∈ K := subset_closure (by simp)
  have hb : b ∈ K := subset_closure (by simp)
  have hc : c ∈ K := subset_closure (by simp)
  have hK : closure {(⟨a, ha⟩ : K), ⟨b, hb⟩, ⟨c, hc⟩} = ⊤ := by
    rw [← closure_closure_coe_preimage]
    congr 1
    ext
    simp [Subtype.ext_iff]
  have hcomm := isMulCommutative_of_commutator_eq_pow hn2 hK
    (Subtype.ext (by simpa [commutatorElement_def] using h))
  exact (commute_iff_eq a b).2
    (by simpa using congrArg Subtype.val (isMulCommutative_iff.1 hcomm ⟨a, ha⟩ ⟨b, hb⟩))

/-- **Schützenberger's theorem**: a nontrivial commutator of a free group is not a proper power. -/
theorem not_isProperPower_commutator {a b : G} (h : ⁅a, b⁆ ≠ 1) : ¬IsProperPower ⁅a, b⁆ := by
  rw [isProperPower_iff]
  rintro ⟨c, n, hn, hc⟩
  exact h (commutatorElement_eq_one_iff_commute.2 (commute_of_commutator_eq_pow (by omega) hc))

end IsFreeGroup
