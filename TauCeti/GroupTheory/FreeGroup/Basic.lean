/-!
# Signed words and finite supports in free groups

A signed word is a list of pairs `(x, b)`, with `true` denoting a generator and `false` its
inverse. This file gives product formulas for evaluating such words under a homomorphism out of a
free group.

It also shows that every element of a free group lies in the subgroup generated by finitely many
basis elements. Hence countably many elements lie in a free factor `FreeGroup β` of countable
rank, and a retraction of `FreeGroup ι` onto `FreeGroup β` fixes them.

## Main results

* `MonoidHom.apply_freeGroup_mk`: a homomorphism evaluates a signed word letter by letter.
* `FreeGroup.lift_mk_singleton`: the value of a lift on a one-letter word.
* `FreeGroup.lift_inv_mk`: inverting the image of every generator flips every sign in a word.
* `FreeGroup.lift_mk_mem_closure_image`: a word in the letters of a set `s` of generators is sent
  into the subgroup generated by the images of `s`.
* `FreeGroup.lift_map`: lifting after mapping the generators is lifting the composite.
* `FreeGroup.exists_lift_eq_of_isConj`: the values of a word under all lifts are closed under
  conjugation.
* `FreeGroup.lift_sumElim_image_map_inl`: substituting words for the generators of the second
  summand of `α ⊕ β` recovers every set of words in `α`.
* `FreeGroup.natCard_monoidHom`: a homomorphism out of `FreeGroup α` is its family of values on
  the generators, so there are `|G| ^ |α|` of them into a finite group `G` when `α` is finite.
* `FreeGroup.exists_finset_mem_closure`, `FreeGroup.exists_finset_forall_mem_closure`: finitely
  many elements of a free group lie in the subgroup generated by finitely many basis elements.
* `FreeGroup.exists_countable_retraction`: countably many elements of a free group lie in a free
  factor of countable rank, onto which the free group retracts.
-/

public section

namespace MonoidHom

/-- A homomorphism out of a free group into a division monoid evaluates on the word `L` as the
product of the images of its signed letters. For a group target and a homomorphism given as a
lift, this is `FreeGroup.lift_mk`. -/
theorem apply_freeGroup_mk {α M : Type*} [DivisionMonoid M] (F : FreeGroup α →* M)
    (L : List (α × Bool)) :
    F (FreeGroup.mk L) =
      (L.map fun p => cond p.2 (F (FreeGroup.of p.1)) (F (FreeGroup.of p.1))⁻¹).prod := by
  rw [← FreeGroup.lift_of_apply (FreeGroup.mk L), FreeGroup.lift_mk, map_list_prod, List.map_map]
  exact congrArg List.prod <| List.map_congr_left fun ⟨_, b⟩ _ => by cases b <;> simp

end MonoidHom

namespace FreeGroup

/-- Lifting `f` evaluates a one-letter word as the image of its generator, or the inverse of that
image for a negative letter. -/
theorem lift_mk_singleton {α G : Type*} [Group G] (f : α → G) (y : α × Bool) :
    lift f (mk [y]) = cond y.2 (f y.1) (f y.1)⁻¹ := by
  simp [lift_mk]

/-- Lifting the pointwise inverse of `f` evaluates on the word `L` as lifting `f` evaluates on the
word with every sign flipped. -/
theorem lift_inv_mk {α G : Type*} [Group G] (f : α → G) (L : List (α × Bool)) :
    lift (fun x => (f x)⁻¹) (mk L) = lift f (mk (L.map fun p => (p.1, !p.2))) := by
  rw [lift_mk, lift_mk, List.map_map]
  exact congrArg List.prod <| List.map_congr_left fun ⟨_, b⟩ _ => by cases b <;> simp

/-- A homomorphism from a free group sends a word all of whose letters lie in a set `s` of free
generators into the subgroup generated by the images of `s`. -/
theorem lift_mk_mem_closure_image {α G : Type*} [Group G] (f : α → G) {s : Set α}
    {L : List (α × Bool)} (h : ∀ l ∈ L, l.1 ∈ s) : lift f (mk L) ∈ Subgroup.closure (f '' s) := by
  rw [lift_mk]
  refine list_prod_mem fun x hx => ?_
  obtain ⟨⟨a, b⟩, hl, rfl⟩ := List.mem_map.1 hx
  have ha := Subgroup.subset_closure (Set.mem_image_of_mem f (h _ hl))
  cases b <;> simpa using ha

attribute [simp] lift_of_eq_id

/-- Lifting `f` after mapping the generators along `g` is lifting `f ∘ g`. -/
@[simp]
theorem lift_comp_map {α β G : Type*} [Group G] (f : β → G) (g : α → β) :
    (lift f).comp (map g) = lift (f ∘ g) := by
  ext
  simp

/-- Lifting `f` after mapping the generators along `g` evaluates as lifting `f ∘ g`. -/
@[simp]
theorem lift_map {α β G : Type*} [Group G] (f : β → G) (g : α → β) (x : FreeGroup α) :
    lift f (map g x) = lift (f ∘ g) x :=
  DFunLike.congr_fun (lift_comp_map f g) x

/-- The values of a word `u` under the homomorphisms `FreeGroup α →* G` are closed under
conjugation in `G`: every conjugate of `lift f u` is `lift g u` for some `g`. -/
theorem exists_lift_eq_of_isConj {α G : Type*} [Group G] {u : FreeGroup α} (f : α → G) {a : G}
    (ha : IsConj (lift f u) a) : ∃ g : α → G, lift g u = a := by
  obtain ⟨t, rfl⟩ := isConj_iff.1 ha
  refine ⟨fun x => MulAut.conj t (f x), ?_⟩
  have h : lift (fun x => MulAut.conj t (f x)) = (MulAut.conj t).toMonoidHom.comp (lift f) :=
    ext_hom _ _ fun x => by
      rw [lift_apply_of, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, lift_apply_of]
  rw [h, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]

/-- Substituting a word `w b` in `α` for each generator `b` of the second summand of `α ⊕ β`
is a left inverse of the inclusion of `FreeGroup α`, so it recovers every set of words in `α`. -/
theorem lift_sumElim_image_map_inl {α β : Type*} (w : β → FreeGroup α) (R : Set (FreeGroup α)) :
    lift (Sum.elim of w) '' (map Sum.inl '' R) = R := by
  simp [Set.image_image]

/-- A homomorphism out of the free group on a finite set `α` is its family of values on the
generators, so there are `Nat.card G ^ Nat.card α` homomorphisms into a finite group `G`. For
infinite `G` the equation still holds in `Nat.card`, both sides being `0` when `α` is nonempty. -/
theorem natCard_monoidHom (α G : Type*) [Group G] [Finite α] :
    Nat.card (FreeGroup α →* G) = Nat.card G ^ Nat.card α := by
  rw [← Nat.card_congr lift, Nat.card_fun]

section Support

open Subgroup

variable {ι : Type*}

/-- Each element of a free group lies in the subgroup generated by finitely many basis
elements. -/
theorem exists_finset_mem_closure (x : FreeGroup ι) :
    ∃ t : Finset ι, x ∈ closure (of '' (t : Set ι)) := by
  classical
  have hx : x ∈ closure (Set.range (of : ι → FreeGroup ι)) := by
    rw [closure_range_of]
    exact mem_top x
  induction hx using closure_induction with
  | mem _ hy =>
    obtain ⟨i, rfl⟩ := hy
    exact ⟨{i}, subset_closure ⟨i, by simp, rfl⟩⟩
  | one => exact ⟨∅, one_mem _⟩
  | mul _ _ _ _ hy hz =>
    obtain ⟨t, ht⟩ := hy
    obtain ⟨t', ht'⟩ := hz
    have hle (u : Finset ι) (hu : u ⊆ t ∪ t') :
        closure (of '' (u : Set ι)) ≤ closure (of '' ((t ∪ t' : Finset ι) : Set ι)) :=
      closure_mono (Set.image_mono (by exact_mod_cast hu))
    exact ⟨t ∪ t', mul_mem (hle t Finset.subset_union_left ht)
      (hle t' Finset.subset_union_right ht')⟩
  | inv _ _ hy =>
    obtain ⟨t, ht⟩ := hy
    exact ⟨t, inv_mem ht⟩

/-- Finitely many elements of a free group lie in the subgroup generated by finitely many basis
elements. -/
theorem exists_finset_forall_mem_closure (s : Finset (FreeGroup ι)) :
    ∃ t : Finset ι, ∀ x ∈ s, x ∈ closure (of '' (t : Set ι)) := by
  classical
  choose t ht using exists_finset_mem_closure (ι := ι)
  refine ⟨s.biUnion t, fun x hx => closure_mono (Set.image_mono ?_) (ht x)⟩
  exact_mod_cast Finset.subset_biUnion_of_mem t hx

/-- **Countably many elements of a free group lie in a free factor of countable rank.** Given
countably many elements `u k` of `FreeGroup ι`, there are a countable set `β` of basis elements and
a retraction `r` of `FreeGroup ι` onto `FreeGroup β`, that is a left inverse of `map (↑)`, with
`map (↑) (r (u k)) = u k` for every `k`. -/
theorem exists_countable_retraction {κ : Type*} [Countable κ] (u : κ → FreeGroup ι) :
    ∃ β : Set ι, β.Countable ∧ ∃ r : FreeGroup ι →* FreeGroup β,
      r.comp (map (↑)) = MonoidHom.id _ ∧ ∀ k, map (↑) (r (u k)) = u k := by
  classical
  choose t ht using fun k => exists_finset_mem_closure (u k)
  let β : Set ι := ⋃ k, (t k : Set ι)
  -- The retraction onto the basis elements in `β` is the identity on the subgroup they generate.
  let r : FreeGroup ι →* FreeGroup β := lift fun i => if h : i ∈ β then of ⟨i, h⟩ else 1
  have hr : Set.EqOn ((map ((↑) : β → ι)).comp r) (MonoidHom.id _) (closure (of '' β)) := by
    refine MonoidHom.eqOn_closure ?_
    rintro _ ⟨i, hi, rfl⟩
    simp [r, hi]
  refine ⟨β, Set.countable_iUnion fun k => (t k).countable_toSet, r, by ext; simp [r],
    fun k => hr ?_⟩
  exact closure_mono (Set.image_mono (Set.subset_iUnion (fun k => (t k : Set ι)) k)) (ht k)

end Support

end FreeGroup
