module

public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.GroupTheory.FreeGroup.Basic
public import Mathlib.GroupTheory.FreeGroup.Reduce
import Mathlib.Algebra.BigOperators.Group.List.Basic
import Mathlib.Algebra.Group.Submonoid.BigOperators

/-!
# Signed words and subgroups generated by free generators

A signed word is a list of pairs `(x, b)`, with `true` denoting a generator and `false` its
inverse. This file gives product formulas for evaluating such words under a homomorphism out of a
free group, and describes the subgroup of a free group generated by a set `s` of free generators
(a sub-basis): it consists of the elements whose reduced words only use letters from `s`.

## Main results

* `MonoidHom.apply_freeGroup_mk`: a homomorphism evaluates a signed word letter by letter.
* `FreeGroup.lift_inv_mk`: inverting the image of every generator flips every sign in a word.
* `FreeGroup.mem_closure_image_of_iff_toWord`: an element lies in the subgroup generated by a set
  of free generators exactly when every letter of its reduced word belongs to that set.
* `FreeGroup.of_mem_closure_image_of_iff`: a free generator lies in the subgroup generated by a
  set of free generators exactly when it belongs to that set.
* `FreeGroup.closure_image_of_inter`: the subgroups generated by two sets of free generators meet
  in the subgroup generated by their intersection.
-/

public section

namespace MonoidHom

/-- A homomorphism out of a free group into a division monoid evaluates on the word `L` as the
product of the images of its signed letters. For a group target and a homomorphism given as a
lift, this is `FreeGroup.lift_mk`. -/
theorem apply_freeGroup_mk {α M : Type*} [DivisionMonoid M] (F : FreeGroup α →* M)
    (L : List (α × Bool)) :
    F (FreeGroup.mk L) =
      (L.map fun p => cond p.2 (F (FreeGroup.of p.1)) (F (FreeGroup.of p.1))⁻¹).prod := by
  rw [← FreeGroup.lift_of_apply (FreeGroup.mk L), FreeGroup.lift_mk, map_list_prod, List.map_map]
  exact congrArg List.prod <| List.map_congr_left fun ⟨_, b⟩ _ => by cases b <;> simp

end MonoidHom

namespace FreeGroup

/-- Lifting the pointwise inverse of `f` evaluates on the word `L` as lifting `f` evaluates on the
word with every sign flipped. -/
theorem lift_inv_mk {α G : Type*} [Group G] (f : α → G) (L : List (α × Bool)) :
    lift (fun x => (f x)⁻¹) (mk L) = lift f (mk (L.map fun p => (p.1, !p.2))) := by
  rw [lift_mk, lift_mk, List.map_map]
  exact congrArg List.prod <| List.map_congr_left fun ⟨_, b⟩ _ => by cases b <;> simp

/-! ### Subgroups generated by sets of free generators -/

section SubBasis

variable {α : Type*}

/-- An element of a free group lies in the subgroup generated by a set `s` of free generators
exactly when every letter of its reduced word belongs to `s`. -/
theorem mem_closure_image_of_iff_toWord [DecidableEq α] {s : Set α} {w : FreeGroup α} :
    w ∈ Subgroup.closure (of '' s) ↔ ∀ p ∈ w.toWord, p.1 ∈ s := by
  refine ⟨fun h => ?_, fun h => ?_⟩
  · induction h using Subgroup.closure_induction with
    | mem _ hx => obtain ⟨a, ha, rfl⟩ := hx; simpa using ha
    | one => simp
    | mul x y _ _ hx hy =>
      intro p hp
      rw [toWord_mul] at hp
      exact (List.mem_append.1 ((Red.sublist reduce.red).subset hp)).elim (hx p) (hy p)
    | inv x _ hx =>
      intro p hp
      obtain ⟨q, hq, rfl⟩ := List.mem_map.1 (List.mem_reverse.1 (toWord_inv x ▸ hp))
      exact hx q hq
  · rw [← mk_toWord (x := w), ← MonoidHom.id_apply (FreeGroup α) (mk _),
      MonoidHom.apply_freeGroup_mk]
    refine list_prod_mem fun g hg => ?_
    obtain ⟨⟨a, b⟩, hp, rfl⟩ := List.mem_map.1 hg
    have ha := Subgroup.subset_closure (Set.mem_image_of_mem of (h _ hp))
    cases b
    exacts [inv_mem ha, ha]

/-- A free generator lies in the subgroup generated by a set of free generators exactly when it
is one of them. -/
@[simp]
theorem of_mem_closure_image_of_iff {s : Set α} {a : α} :
    of a ∈ Subgroup.closure (of '' s) ↔ a ∈ s := by
  classical
  simp [mem_closure_image_of_iff_toWord]

/-- The subgroup generated by a single free generator `of b` contains the free generator `of a`
exactly when `a = b`. -/
@[simp]
theorem of_mem_closure_singleton_of_iff {a b : α} :
    of a ∈ Subgroup.closure ({of b} : Set (FreeGroup α)) ↔ a = b := by
  rw [← Set.image_singleton, of_mem_closure_image_of_iff, Set.mem_singleton_iff]

/-- The free generator `of a` is an integer power of the free generator `of b` exactly when
`a = b`. -/
@[simp]
theorem of_mem_zpowers_of_iff {a b : α} : of a ∈ Subgroup.zpowers (of b) ↔ a = b := by
  rw [Subgroup.zpowers_eq_closure, of_mem_closure_singleton_of_iff]

/-- The subgroups generated by two sets of free generators meet in the subgroup generated by
their intersection. -/
theorem closure_image_of_inter (s t : Set α) :
    Subgroup.closure (of '' (s ∩ t)) =
      Subgroup.closure (of '' s) ⊓ Subgroup.closure (of '' t) := by
  classical
  ext w
  simp [Subgroup.mem_inf, mem_closure_image_of_iff_toWord, imp_and, forall_and]

end SubBasis

end FreeGroup
