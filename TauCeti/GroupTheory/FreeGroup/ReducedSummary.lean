/-!
# A monoid with involution recognising reduced words

For an alphabet `α`, the monoid `TauCeti.ReducedSummary α` has an identity `1` for the empty
word, an absorbing element `0` for the words that are not reduced, and an element
`word f l S` for the nonempty reduced words with first letter `f`, last letter `l` and set of
generators `S`. The product of two summaries of nonempty reduced words is `0` when the last
letter of the first is the formal inverse of the first letter of the second. The involution
exchanges and inverts the first and the last letter. Over a finite alphabet the monoid is
finite.

The value of a signed word under the valuation `TauCeti.ReducedSummary.ofLetter` is its
summary. Hence the conditions that a word is empty, is reduced, or is reduced and only uses
generators from a given set are conditions on its value in a finite monoid with involution when
the alphabet is finite: these are the regular constraints that express a system of equations
over a free group, with inequations and with variables restricted to subgroups generated by
sets of basis letters, as a word equation over a free monoid with involution.

## Main definitions

* `TauCeti.ReducedSummary`: the summaries of signed words over `α`, a monoid with zero and with
  an involution reversing products.
* `TauCeti.ReducedSummary.ofLetter`: the summary of a one-letter word.

## Main results

* `TauCeti.ReducedSummary.starVal_ofLetter_eq_one_iff`: a word has summary `1` exactly when it is
  empty.
* `TauCeti.ReducedSummary.starVal_ofLetter_eq_zero_iff`: a word has summary `0` exactly when it
  is not reduced.
* `TauCeti.ReducedSummary.starVal_ofLetter_eq_word_iff`: a word has summary `word f l S` exactly
  when it is reduced, begins with `f`, ends with `l` and has `S` as its set of generators.
* `TauCeti.ReducedSummary.card_eq`: over a finite alphabet of `n` generators there are
  `2 + (2 n) ^ 2 * 2 ^ n` summaries.

## References

* [CDE16] L. Ciobanu, V. Diekert, M. Elder, *Solution sets for equations over free groups are
  EDT0L languages*, Internat. J. Algebra Comput. 26 (2016), 843–886; arXiv:1508.02149, §3.2
  (the finite monoid `N_F` with involution, of which this monoid is the refinement recording the
  set of generators).
* [DJP16] V. Diekert, A. Jez, W. Plandowski, *Finding all solutions of equations in free groups
  and monoids with involution*, Inform. and Comput. 251 (2016), 263–286; arXiv:1405.5133,
  §1.1 (constraints recognised by a morphism to a finite monoid with involution) and the proof
  of Theorem 2 (the automaton with a sink, an initial state and the pairs of a first and a last
  letter).
-/

public section

namespace TauCeti

open FreeGroup

/-- The summary of a signed word over `α`: `zero` (the element `0`) for a word that is not
reduced, `one` (the element `1`) for the empty word, and the first letter, the last letter and
the set of generators of a nonempty reduced word. Not every element is the summary of a word:
the set of generators is arbitrary, for instance empty. -/
inductive ReducedSummary (α : Type*) where
  /-- The summary of the words that are not reduced. -/
  | zero : ReducedSummary α
  /-- The summary of the empty word. -/
  | one : ReducedSummary α
  /-- The summary of a nonempty reduced word with the given first letter, last letter and set
  of generators. -/
  | word (first last : α × Bool) (generators : Finset α) : ReducedSummary α

namespace ReducedSummary

variable {α : Type*}

instance : Zero (ReducedSummary α) := ⟨zero⟩

instance : One (ReducedSummary α) := ⟨one⟩

/- The two constructors without arguments are the numerals `0` and `1`, which are the normal
forms. These two lemmas are not `@[simp]`: they would rewrite the left-hand sides of the
automatically generated `sizeOf` equations of the constructors. -/

theorem zero_eq_zero : (zero : ReducedSummary α) = 0 := (rfl)

theorem one_eq_one : (one : ReducedSummary α) = 1 := (rfl)

instance : Nontrivial (ReducedSummary α) := ⟨⟨0, 1, nofun⟩⟩

@[simp] theorem word_ne_zero (f l : α × Bool) (S : Finset α) : word f l S ≠ 0 := nofun

@[simp] theorem word_ne_one (f l : α × Bool) (S : Finset α) : word f l S ≠ 1 := nofun

/-- The involution on summaries: the summary of the formal inverse of a word. -/
protected def star : ReducedSummary α → ReducedSummary α
  | zero => zero
  | one => one
  | word f l S => word (l.1, !l.2) (f.1, !f.2) S

instance : Star (ReducedSummary α) := ⟨ReducedSummary.star⟩

@[simp] protected theorem star_zero : star (0 : ReducedSummary α) = 0 := (rfl)

@[simp] theorem star_word (f l : α × Bool) (S : Finset α) :
    star (word f l S) = word (l.1, !l.2) (f.1, !f.2) S := (rfl)

/-- The summary of the one-letter word on a generator. -/
def ofLetter (a : α) : ReducedSummary α :=
  word (a, true) (a, true) {a}

@[simp] theorem ofLetter_def (a : α) : ofLetter a = word (a, true) (a, true) {a} := (rfl)

section Monoid

variable [DecidableEq α]

/-- The product of two summaries: the summary of a concatenation. -/
protected def mul : ReducedSummary α → ReducedSummary α → ReducedSummary α
  | one, y => y
  | x, one => x
  | zero, _ => zero
  | _, zero => zero
  | word f l S, word f' l' S' =>
    if l.1 = f'.1 ∧ l.2 ≠ f'.2 then zero else word f l' (S ∪ S')

instance : Mul (ReducedSummary α) := ⟨ReducedSummary.mul⟩

@[simp] theorem word_mul_word (f l f' l' : α × Bool) (S S' : Finset α) :
    word f l S * word f' l' S' = if l.1 = f'.1 ∧ l.2 ≠ f'.2 then 0 else word f l' (S ∪ S') := (rfl)

instance : MulZeroOneClass (ReducedSummary α) where
  one_mul x := by cases x <;> rfl
  mul_one x := by cases x <;> rfl
  zero_mul x := by cases x <;> rfl
  mul_zero x := by cases x <;> rfl

instance : MonoidWithZero (ReducedSummary α) where
  mul_assoc x y z := by
    cases x <;> cases y <;> cases z <;>
      try simp only [zero_eq_zero, one_eq_one, zero_mul, mul_zero, one_mul, mul_one]
    simp only [word_mul_word]
    split_ifs <;> simp [*, Finset.union_assoc]

instance : StarMul (ReducedSummary α) where
  star_involutive x := by cases x <;> first | rfl | simp
  star_mul x y := by
    cases x <;> cases y <;> try rfl
    simp only [word_mul_word, star_word]
    split_ifs <;> simp_all [Finset.union_comm, eq_comm]

/-- A one-letter word has as summary the letter as first and last letter and its generator as
the set of generators. -/
theorem starVal_ofLetter_singleton (p : α × Bool) :
    starVal ofLetter [p] = word p p {p.1} := by
  obtain ⟨a, _ | _⟩ := p <;> simp

private theorem starVal_ofLetter_trichotomy (w : List (α × Bool)) :
    (w = [] ∧ starVal ofLetter w = 1) ∨ (¬ IsReduced w ∧ starVal ofLetter w = 0) ∨
      ∃ f l, IsReduced w ∧ w.head? = some f ∧ w.getLast? = some l ∧
        starVal ofLetter w = word f l (w.map Prod.fst).toFinset := by
  induction w with
  | nil => simp
  | cons p w ih =>
    rw [← List.singleton_append, starVal_append, starVal_ofLetter_singleton]
    rcases ih with ⟨rfl, -⟩ | ⟨hw, hv⟩ | ⟨q, l, hw, hq, hl, hv⟩
    · exact .inr <| .inr ⟨p, p, by simp⟩
    · exact .inr <| .inl ⟨fun h ↦ hw h.tail, by simp [hv]⟩
    · obtain ⟨w, rfl⟩ : ∃ w', w = q :: w' := by cases w <;> simp_all
      by_cases h : p.1 = q.1 ∧ p.2 ≠ q.2
      · exact .inr <| .inl ⟨by simp [h], by simp [hv, h]⟩
      · refine .inr <| .inr ⟨p, l, ?_, rfl, by simpa using hl, ?_⟩
        · exact isReduced_cons_cons.2 ⟨fun h₁ ↦ by_contra fun h₂ ↦ h ⟨h₁, h₂⟩, hw⟩
        · simp [hv, h, Finset.insert_comm]

/-- A word has summary `1` exactly when it is empty. -/
@[simp] theorem starVal_ofLetter_eq_one_iff (w : List (α × Bool)) :
    starVal ofLetter w = (1 : ReducedSummary α) ↔ w = [] := by
  rcases starVal_ofLetter_trichotomy w with ⟨rfl, -⟩ | ⟨hw, hv⟩ | ⟨f, l, -, hf, -, hv⟩
  · simp
  · exact ⟨fun h ↦ by simp [hv] at h, fun h ↦ absurd (h ▸ IsReduced.nil) hw⟩
  · simp only [hv, word_ne_one, false_iff]
    rintro rfl
    simp at hf

/-- A word has summary `0` exactly when it is not reduced. -/
@[simp] theorem starVal_ofLetter_eq_zero_iff (w : List (α × Bool)) :
    starVal ofLetter w = (0 : ReducedSummary α) ↔ ¬ IsReduced w := by
  rcases starVal_ofLetter_trichotomy w with ⟨rfl, -⟩ | ⟨hw, hv⟩ | ⟨f, l, hw, -, -, hv⟩ <;> simp_all

/-- A word has summary `word f l S` exactly when it is reduced, begins with `f`, ends with `l`
and `S` is the set of its generators. -/
theorem starVal_ofLetter_eq_word_iff (w : List (α × Bool)) (f l : α × Bool) (S : Finset α) :
    starVal ofLetter w = word f l S ↔
      IsReduced w ∧ w.head? = some f ∧ w.getLast? = some l ∧ ∀ a, a ∈ S ↔ ∃ e, (a, e) ∈ w := by
  rcases starVal_ofLetter_trichotomy w with ⟨rfl, hv⟩ | ⟨hw, hv⟩ | ⟨f', l', hw, hf, hl, hv⟩
  · simp [hv]
  · simp [hv, hw]
  · simp [hv, hw, hf, hl, Finset.ext_iff, eq_comm]

end Monoid

private def equivOption :
    ReducedSummary α ≃ Option (Option ((α × Bool) × (α × Bool) × Finset α)) where
  toFun
    | zero => none
    | one => some none
    | word f l S => some (some (f, l, S))
  invFun
    | none => zero
    | some none => one
    | some (some (f, l, S)) => word f l S
  left_inv x := by cases x <;> rfl
  right_inv x := by rcases x with _ | _ | ⟨f, l, S⟩ <;> rfl

/-- The summaries over a finite alphabet form a finite set. -/
instance [Finite α] : Finite (ReducedSummary α) :=
  have := Fintype.ofFinite α
  .of_equiv _ equivOption.symm

/-- The number of summaries over a finite alphabet of `n` generators is
`2 + (2 n) ^ 2 * 2 ^ n`: the elements `0` and `1`, and a first letter and a last letter (each one
of the `2 n` signed letters) and a set of generators. Not all of them are summaries of words. -/
theorem card_eq [Finite α] :
    Nat.card (ReducedSummary α) = 2 + (2 * Nat.card α) ^ 2 * 2 ^ Nat.card α := by
  have := Fintype.ofFinite α
  simp only [Nat.card_congr equivOption, Nat.card_eq_fintype_card, Fintype.card_option,
    Fintype.card_prod, Fintype.card_bool, Fintype.card_finset]
  ring

end ReducedSummary

end TauCeti
