/-!
# A monoid with involution recognising reduced words

For an alphabet `α`, the carrier of the monoid `TauCeti.ReducedSummary α` consists of an
identity `1`, an absorbing element `0`, and an element `word f l S` for every first letter `f`,
last letter `l` and finite set `S` of generators. The product of two elements `word f l S` and
`word f' l' S'` is `0` when `l` is the formal inverse of `f'`, and `word f l' (S ∪ S')`
otherwise. The involution exchanges and inverts the first and the last letter. Over a finite
alphabet the monoid is finite.

Not every element of the carrier is the value of a word: the value of a signed word under the
valuation `TauCeti.ReducedSummary.ofGenerator` is `1` for the empty word, `0` for a word that is
not reduced, and `word f l S` for a nonempty reduced word with first letter `f`, last letter `l`
and set of generators `S`. Hence, when the alphabet is finite, the conditions that a word is
empty, is reduced, or is reduced and only uses generators from a given set are recognised by its
value in a finite monoid with involution. These are the regular constraints used by the separate
reduction of a system of equations and inequations over a free group, with variables restricted
to subgroups generated by sets of basis letters, to a word equation over a free monoid with
involution. This file only recognises the constraints; it does not translate the equations and
inequations themselves.

## Main definitions

* `TauCeti.ReducedSummary`: a monoid with zero and with an involution reversing products, whose
  elements include the summaries of signed words over `α`.
* `TauCeti.ReducedSummary.ofGenerator`: the summary of the positive one-letter word `[(a, true)]`
  on a generator `a`; the negative one-letter word has its `star` as summary.
* `TauCeti.ReducedSummary.SupportedIn`: the identity and the elements `word f l S` with `S`
  contained in a given set `A`; on values of words it holds exactly for the reduced words whose
  generators lie in `A`.

## Main results

* `TauCeti.ReducedSummary.starVal_ofGenerator_eq_one_iff`: a word has summary `1` exactly when it is
  empty.
* `TauCeti.ReducedSummary.starVal_ofGenerator_eq_zero_iff`: a word has summary `0` exactly when it
  is not reduced.
* `TauCeti.ReducedSummary.starVal_ofGenerator_eq_word_iff`: a word has summary `word f l S` exactly
  when it is reduced, begins with `f`, ends with `l` and has `S` as its set of generators.
* `TauCeti.ReducedSummary.supportedIn_starVal_ofGenerator_iff`: the value of a word satisfies
  `SupportedIn A` exactly when the word is reduced and all its generators lie in `A`.
* `TauCeti.ReducedSummary.card_eq`: over a finite alphabet of `n` generators the whole carrier,
  including the elements that are not values of words, has `2 + (2 n) ^ 2 * 2 ^ n` elements.

## References

* [CDE16] L. Ciobanu, V. Diekert, M. Elder, *Solution sets for equations over free groups are
  EDT0L languages*, Internat. J. Algebra Comput. 26 (2016), 843–886; arXiv:1508.02149, §3.2
  (the finite monoid `N_F` with involution, of which this monoid is the refinement recording the
  set of generators).
* [DJP16] V. Diekert, A. Jez, W. Plandowski, *Finding all solutions of equations in free groups
  and monoids with involution*, Inform. and Comput. 251 (2016), 263–286; arXiv:1405.5133,
  §1.1 (constraints recognised by a morphism to a finite monoid with involution) and the proof
  of Theorem 2 (the automaton with a sink, an initial state and the pairs of a first and a last
  letter).
-/

public section

namespace TauCeti

open FreeGroup

/-- The carrier of the monoid of summaries of signed words over `α`: an element `zero` (the
`0`), an element `one` (the `1`), and an element `word f l S` for every first letter, last
letter and finite set of generators. The value of a word under `ofGenerator` is `zero` for a word
that is not reduced, `one` for the empty word, and the first letter, the last letter and the set
of generators of a nonempty reduced word. Not every element is such a value: the set of
generators is arbitrary, for instance empty. -/
inductive ReducedSummary (α : Type*) where
  /-- The absorbing element, the value of the words that are not reduced. -/
  | zero : ReducedSummary α
  /-- The identity, the value of the empty word. -/
  | one : ReducedSummary α
  /-- The element with the given first letter, last letter and set of generators; it is the
  value of the nonempty reduced words with these data, if there are any. -/
  | word (first last : α × Bool) (generators : Finset α) : ReducedSummary α

namespace ReducedSummary

variable {α : Type*}

instance : Zero (ReducedSummary α) := ⟨zero⟩

instance : One (ReducedSummary α) := ⟨one⟩

/- The two constructors without arguments are the numerals `0` and `1`, which are the normal
forms. These two lemmas are not `@[simp]`: they would rewrite the left-hand sides of the
automatically generated `sizeOf` equations of the constructors. -/

theorem zero_eq_zero : (zero : ReducedSummary α) = 0 := (rfl)

theorem one_eq_one : (one : ReducedSummary α) = 1 := (rfl)

instance : Nontrivial (ReducedSummary α) := ⟨⟨0, 1, nofun⟩⟩

@[simp] theorem word_ne_zero (f l : α × Bool) (S : Finset α) : word f l S ≠ 0 := nofun

@[simp] theorem word_ne_one (f l : α × Bool) (S : Finset α) : word f l S ≠ 1 := nofun

/-- The involution exchanges and inverts the first and the last letter; on values of words it is
the value of the formal inverse. -/
instance : Star (ReducedSummary α) where
  star
    | zero => zero
    | one => one
    | word f l S => word (l.1, !l.2) (f.1, !f.2) S

@[simp] protected theorem star_zero : star (0 : ReducedSummary α) = 0 := (rfl)

private theorem star_one_eq : star (1 : ReducedSummary α) = 1 := (rfl)

@[simp] theorem star_word (f l : α × Bool) (S : Finset α) :
    star (word f l S) = word (l.1, !l.2) (f.1, !f.2) S := (rfl)

/-- The involution does not compare letters, so it needs no decidable equality on `α`. -/
instance : InvolutiveStar (ReducedSummary α) where
  star_involutive x := by
    cases x <;> simp [zero_eq_zero, one_eq_one, ReducedSummary.star_zero, star_one_eq]

/-- The summary of the positive one-letter word `[(a, true)]` on the generator `a`. The negative
one-letter word `[(a, false)]` has summary `star (ofGenerator a)`. -/
def ofGenerator (a : α) : ReducedSummary α :=
  word (a, true) (a, true) {a}

@[simp] theorem ofGenerator_def (a : α) : ofGenerator a = word (a, true) (a, true) {a} := (rfl)

/-- The identity and the elements `word f l S` with `S ⊆ A`. This includes elements that are not
values of words, such as `word f l ∅`; on values of words it holds exactly for the reduced words
all of whose generators lie in `A` (`supportedIn_starVal_ofGenerator_iff`). -/
def SupportedIn (A : Set α) : ReducedSummary α → Prop
  | zero => False
  | one => True
  | word _ _ S => ↑S ⊆ A

@[simp] theorem not_supportedIn_zero (A : Set α) : ¬ SupportedIn A 0 := nofun

@[simp] theorem supportedIn_one (A : Set α) : SupportedIn A 1 := trivial

@[simp] theorem supportedIn_word (A : Set α) (f l : α × Bool) (S : Finset α) :
    SupportedIn A (word f l S) ↔ ↑S ⊆ A := .rfl

@[simp] theorem supportedIn_star (A : Set α) (x : ReducedSummary α) :
    SupportedIn A (star x) ↔ SupportedIn A x := by
  cases x <;> exact .rfl

section Monoid

variable [DecidableEq α]

/-- The product: `0` is absorbing, `1` is the identity, and the product of `word f l S` and
`word f' l' S'` is `0` when `l` is the formal inverse of `f'` and `word f l' (S ∪ S')` otherwise.
On values of words it is the value of the concatenation. -/
instance : Mul (ReducedSummary α) where
  mul
    | one, y => y
    | x, one => x
    | zero, _ => zero
    | _, zero => zero
    | word f l S, word f' l' S' =>
      if l.1 = f'.1 ∧ l.2 ≠ f'.2 then zero else word f l' (S ∪ S')

@[simp] theorem word_mul_word (f l f' l' : α × Bool) (S S' : Finset α) :
    word f l S * word f' l' S' = if l.1 = f'.1 ∧ l.2 ≠ f'.2 then 0 else word f l' (S ∪ S') := (rfl)

instance : MulZeroOneClass (ReducedSummary α) where
  one_mul x := by cases x <;> rfl
  mul_one x := by cases x <;> rfl
  zero_mul x := by cases x <;> rfl
  mul_zero x := by cases x <;> rfl

instance : MonoidWithZero (ReducedSummary α) where
  mul_assoc x y z := by
    cases x <;> cases y <;> cases z <;>
      try simp only [zero_eq_zero, one_eq_one, zero_mul, mul_zero, one_mul, mul_one]
    simp only [word_mul_word]
    split_ifs <;> simp [*, Finset.union_assoc]

instance : StarMul (ReducedSummary α) where
  star_mul x y := by
    cases x <;> cases y <;>
      simp only [zero_eq_zero, one_eq_one, zero_mul, mul_zero, one_mul, mul_one,
        ReducedSummary.star_zero, star_one_eq, star_word, word_mul_word]
    split_ifs <;> simp_all [Finset.union_comm, eq_comm]

/-- A product satisfies `SupportedIn A` exactly when it is not `0` and both factors satisfy
`SupportedIn A`. -/
theorem supportedIn_mul (A : Set α) (x y : ReducedSummary α) :
    SupportedIn A (x * y) ↔ x * y ≠ 0 ∧ SupportedIn A x ∧ SupportedIn A y := by
  cases x <;> cases y <;> simp only [zero_eq_zero, one_eq_one, zero_mul, mul_zero, one_mul,
    mul_one, word_mul_word]
  all_goals try split_ifs
  all_goals simp_all [Set.union_subset_iff]

/-- A one-letter word has as summary the letter as first and last letter and its generator as
the set of generators. -/
@[simp high] theorem starVal_ofGenerator_singleton (p : α × Bool) :
    starVal ofGenerator [p] = word p p {p.1} := by
  obtain ⟨a, _ | _⟩ := p <;> simp

private theorem starVal_ofGenerator_trichotomy (w : List (α × Bool)) :
    (w = [] ∧ starVal ofGenerator w = 1) ∨ (¬ IsReduced w ∧ starVal ofGenerator w = 0) ∨
      ∃ f l, IsReduced w ∧ w.head? = some f ∧ w.getLast? = some l ∧
        starVal ofGenerator w = word f l (w.map Prod.fst).toFinset := by
  induction w with
  | nil => simp
  | cons p w ih =>
    rw [← List.singleton_append, starVal_append, starVal_ofGenerator_singleton]
    rcases ih with ⟨rfl, -⟩ | ⟨hw, hv⟩ | ⟨q, l, hw, hq, hl, hv⟩
    · exact .inr <| .inr ⟨p, p, by simp⟩
    · exact .inr <| .inl ⟨fun h ↦ hw h.tail, by simp [hv]⟩
    · obtain ⟨w, rfl⟩ : ∃ w', w = q :: w' := by cases w <;> simp_all
      by_cases h : p.1 = q.1 ∧ p.2 ≠ q.2
      · exact .inr <| .inl ⟨by simp [h], by simp [hv, h]⟩
      · refine .inr <| .inr ⟨p, l, ?_, rfl, by simpa using hl, ?_⟩
        · exact isReduced_cons_cons.2 ⟨fun h₁ ↦ by_contra fun h₂ ↦ h ⟨h₁, h₂⟩, hw⟩
        · simp [hv, h, Finset.insert_comm]

/-- A word has summary `1` exactly when it is empty. -/
@[simp] theorem starVal_ofGenerator_eq_one_iff (w : List (α × Bool)) :
    starVal ofGenerator w = (1 : ReducedSummary α) ↔ w = [] := by
  rcases starVal_ofGenerator_trichotomy w with ⟨rfl, -⟩ | ⟨hw, hv⟩ | ⟨f, l, -, hf, -, hv⟩
  · simp
  · exact ⟨fun h ↦ by simp [hv] at h, fun h ↦ absurd (h ▸ IsReduced.nil) hw⟩
  · simp only [hv, word_ne_one, false_iff]
    rintro rfl
    simp at hf

/-- A word has summary `0` exactly when it is not reduced. -/
@[simp] theorem starVal_ofGenerator_eq_zero_iff (w : List (α × Bool)) :
    starVal ofGenerator w = (0 : ReducedSummary α) ↔ ¬ IsReduced w := by
  rcases starVal_ofGenerator_trichotomy w with ⟨rfl, -⟩ | ⟨hw, hv⟩ | ⟨f, l, hw, -, -, hv⟩ <;>
    simp_all

/-- A word has summary `word f l S` exactly when it is reduced, begins with `f`, ends with `l`
and `S` is the set of its generators. -/
theorem starVal_ofGenerator_eq_word_iff (w : List (α × Bool)) (f l : α × Bool) (S : Finset α) :
    starVal ofGenerator w = word f l S ↔
      IsReduced w ∧ w.head? = some f ∧ w.getLast? = some l ∧ ∀ a, a ∈ S ↔ ∃ e, (a, e) ∈ w := by
  rcases starVal_ofGenerator_trichotomy w with ⟨rfl, hv⟩ | ⟨hw, hv⟩ | ⟨f', l', hw, hf, hl, hv⟩
  · simp [hv]
  · simp [hv, hw]
  · simp [hv, hw, hf, hl, Finset.ext_iff, eq_comm]

/-- The value of a word satisfies `SupportedIn A` exactly when the word is reduced and all its
generators lie in `A`. -/
theorem supportedIn_starVal_ofGenerator_iff (A : Set α) (w : List (α × Bool)) :
    SupportedIn A (starVal ofGenerator w) ↔ IsReduced w ∧ ∀ p ∈ w, p.1 ∈ A := by
  rcases starVal_ofGenerator_trichotomy w with ⟨rfl, hv⟩ | ⟨hw, hv⟩ | ⟨f, l, hw, -, -, hv⟩
  · simp [hv]
  · simp [hv, hw]
  · simp [hv, hw, Set.subset_def, or_imp]

end Monoid

/-- Over a finite alphabet the carrier is finite. -/
instance [Finite α] : Finite (ReducedSummary α) :=
  have := Fintype.ofFinite α
  .of_equiv _ (proxy_equiv% (ReducedSummary α))

/-- Over a finite alphabet of `n` generators the whole carrier has `2 + (2 n) ^ 2 * 2 ^ n`
elements: `0` and `1`, and the elements given by a first letter and a last letter (each one of
the `2 n` signed letters) and a set of generators. The count includes the elements that are not
values of words. -/
theorem card_eq [Finite α] :
    Nat.card (ReducedSummary α) = 2 + (2 * Nat.card α) ^ 2 * 2 ^ Nat.card α := by
  have := Fintype.ofFinite α
  rw [← Nat.card_congr (proxy_equiv% (ReducedSummary α))]
  simp [Nat.card_eq_fintype_card]
  ring

end ReducedSummary

end TauCeti
