module

public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import TauCeti.Algebra.Group.Subgroup.Conjugates

/-!
# Representatives of the cyclic centralizers of a group

Call an element `g ≠ 1` of a group `G` *self-centralizing* when its centralizer is the cyclic
group it generates. The cyclic centralizers of nontrivial elements are exactly the subgroups
generated by self-centralizing elements: if `C_G(g) = ⟨c⟩` with `g ≠ 1`, then `g` is a power of `c`
and `C_G(c) = ⟨c⟩`. To extend all cyclic centralizers of `G`, Myasnikov and Remeslennikov choose
a set of representatives of the conjugacy classes of these centralizers. This is recorded as a set
`S` of self-centralizing elements, one generator for each chosen centralizer: every
self-centralizing element has a conjugate generating the same subgroup as some `s ∈ S`, and no
two different elements of `S` generate conjugate subgroups, so that this `s` is unique. In a
torsion-free group the first condition says that the element is conjugate to `s` or to `s⁻¹`.
The centralizer `G` of the identity counts only when it is also the centralizer of a nontrivial
element, as in a cyclic group `G = ⟨c⟩` with `c ≠ 1`.

## Main definitions

* `TauCeti.IsCentralizerRepresentatives S`: `S` is such a set of representatives.

## Main results

* `TauCeti.exists_isCentralizerRepresentatives`: every group has one.
* `TauCeti.exists_isCentralizerRepresentatives_superset`: a set of self-centralizing elements
  generating pairwise non-conjugate subgroups extends to one.
* `TauCeti.IsCentralizerRepresentatives.image_mulEquiv`: transport along an isomorphism.
* `TauCeti.isCentralizerRepresentatives_empty_iff`: the empty set is one exactly when no element
  is self-centralizing, as in the trivial group and in `ℤ²`.
* `TauCeti.isCentralizerRepresentatives_singleton_of_zpowers_eq_top`: in a nontrivial cyclic
  group, such as `ℤ`, any generator alone is one.

## References

* A. Myasnikov, V. Remeslennikov, D. Serbin, *Regular free length functions on Lyndon's free
  `ℤ[t]`-group `F^{ℤ[t]}`*, Contemp. Math. 378 (2005), 37–77, §2.1.
* A. Myasnikov, V. Remeslennikov, *Exponential groups II: extensions of centralizers and tensor
  completion of CSA-groups*, Internat. J. Algebra Comput. 6 (1996), 687–711.
-/

public section

open Subgroup
open scoped Pointwise

namespace TauCeti

variable {G H : Type*} [Group G] [Group H]

/-- A set `S` of elements of a group is a *set of representatives of the cyclic centralizers*
when its elements are nontrivial and generate their own centralizers, every nontrivial element
generating its own centralizer has a conjugate that generates the same subgroup as some `s ∈ S`,
and no two different elements of `S` have conjugate centralizers. -/
structure IsCentralizerRepresentatives (S : Set G) : Prop where
  /-- The representatives are not the identity. -/
  ne_one : ∀ s ∈ S, s ≠ 1
  /-- A representative generates its centralizer. -/
  centralizer_eq : ∀ s ∈ S, centralizer {s} = zpowers s
  /-- The centralizer of every nontrivial element generating its centralizer is conjugate to the
  centralizer of a representative. -/
  exists_conj : ∀ g : G, g ≠ 1 → centralizer {g} = zpowers g →
    ∃ s ∈ S, ∃ x : G, zpowers (x * g * x⁻¹) = zpowers s
  /-- Different representatives do not have conjugate centralizers. -/
  eq_of_conj : ∀ s ∈ S, ∀ t ∈ S, ∀ x : G, zpowers (x * s * x⁻¹) = zpowers t → s = t

/-- A set of nontrivial elements generating their centralizers, no two of which have conjugate
centralizers, extends to a set of representatives of the cyclic centralizers. -/
theorem exists_isCentralizerRepresentatives_superset {T : Set G} (h1 : ∀ s ∈ T, s ≠ 1)
    (hT : ∀ s ∈ T, centralizer {s} = zpowers s)
    (hconj : ∀ s ∈ T, ∀ t ∈ T, ∀ x : G, zpowers (x * s * x⁻¹) = zpowers t → s = t) :
    ∃ S : Set G, T ⊆ S ∧ IsCentralizerRepresentatives S := by
  -- `f g` is the conjugacy class of the subgroup generated by `g`; a set of representatives is a
  -- set of self-centralizing elements on which `f` is injective with the largest possible image.
  let f (g : G) : Set (Subgroup G) := MulAction.orbit (ConjAct G) (zpowers g)
  have hf (g t : G) : f g = f t ↔ ∃ x : G, zpowers (x * t * x⁻¹) = zpowers g := by
    simp [f, MulAction.orbit_eq_iff, mem_orbit_conjAct_iff, MonoidHom.map_zpowers]
  obtain ⟨S, hTS, hSK, himage, hinj⟩ := Set.InjOn.exists_subset_injOn_subset_range_eq
    (f := f) (s := {g | g ≠ 1 ∧ centralizer {g} = zpowers g})
    (fun s hs t ht hst ↦ ((hf s t).1 hst).elim fun x hx ↦ (hconj t ht s hs x hx).symm)
    (fun s hs ↦ ⟨h1 s hs, hT s hs⟩)
  refine ⟨S, hTS, ⟨fun s hs ↦ (hSK hs).1, fun s hs ↦ (hSK hs).2, fun g hg hcg ↦ ?_,
    fun s hs t ht x hx ↦ hinj hs ht ((hf t s).2 ⟨x, hx⟩).symm⟩⟩
  obtain ⟨s, hs, hsg⟩ : f g ∈ f '' S := himage ▸ Set.mem_image_of_mem f ⟨hg, hcg⟩
  exact ⟨s, hs, (hf s g).1 hsg⟩

/-- Every group has a set of representatives of its cyclic centralizers. -/
theorem exists_isCentralizerRepresentatives (G : Type*) [Group G] :
    ∃ S : Set G, IsCentralizerRepresentatives S :=
  (exists_isCentralizerRepresentatives_superset (T := (∅ : Set G)) (by simp) (by simp)
    (by simp)).imp fun _ ↦ And.right

/-- The image of a set of representatives of the cyclic centralizers under an isomorphism is
one. -/
theorem IsCentralizerRepresentatives.image_mulEquiv {S : Set G}
    (hS : IsCentralizerRepresentatives S) (e : G ≃* H) : IsCentralizerRepresentatives (e '' S) := by
  have hz (a b : G) : zpowers (e a) = zpowers (e b) ↔ zpowers a = zpowers b := by
    simp only [SetLike.ext_iff, e.surjective.forall, mem_zpowers_iff, ← map_zpow,
      EmbeddingLike.apply_eq_iff_eq]
  have hc (g : G) : centralizer {e g} = zpowers (e g) ↔ centralizer {g} = zpowers g := by
    simp only [SetLike.ext_iff, e.surjective.forall, mem_centralizer_singleton_iff,
      mem_zpowers_iff, ← map_zpow, ← map_mul, EmbeddingLike.apply_eq_iff_eq]
  have hconj (x g : G) : e x * e g * (e x)⁻¹ = e (x * g * x⁻¹) := by simp
  refine ⟨?_, ?_, fun g hg hcg ↦ ?_, ?_⟩
  · rintro _ ⟨s, hs, rfl⟩
    simpa using hS.ne_one s hs
  · rintro _ ⟨s, hs, rfl⟩
    exact (hc s).2 (hS.centralizer_eq s hs)
  · obtain ⟨g, rfl⟩ := e.surjective g
    obtain ⟨s, hs, x, hx⟩ := hS.exists_conj g (by simpa using hg) ((hc g).1 hcg)
    exact ⟨e s, Set.mem_image_of_mem e hs, e x, by rwa [hconj, hz]⟩
  · rintro _ ⟨s, hs, rfl⟩ _ ⟨t, ht, rfl⟩ x hx
    obtain ⟨x, rfl⟩ := e.surjective x
    exact congrArg e (hS.eq_of_conj s hs t ht x (by rwa [hconj, hz] at hx))

/-- The empty set is a set of representatives of the cyclic centralizers exactly when no
nontrivial element generates its centralizer, as in the trivial group or in `ℤ²`. -/
theorem isCentralizerRepresentatives_empty_iff : IsCentralizerRepresentatives (∅ : Set G) ↔
    ∀ g : G, g ≠ 1 → centralizer {g} ≠ zpowers g :=
  ⟨fun h g hg hcg ↦ by simpa using h.exists_conj g hg hcg,
    fun h ↦ ⟨by simp, by simp, fun g hg hcg ↦ absurd hcg (h g hg), by simp⟩⟩

/-- In a cyclic group, a nontrivial generator alone is a set of representatives of the cyclic
centralizers. -/
theorem isCentralizerRepresentatives_singleton_of_zpowers_eq_top {g : G} (hg : g ≠ 1)
    (htop : zpowers g = ⊤) : IsCentralizerRepresentatives {g} := by
  have hcent (x : G) : centralizer {x} = ⊤ := by
    refine eq_top_iff.2 fun y _ ↦ mem_centralizer_singleton_iff.2 ?_
    obtain ⟨a, rfl⟩ := mem_zpowers_iff.1 (htop ▸ mem_top x)
    obtain ⟨b, rfl⟩ := mem_zpowers_iff.1 (htop ▸ mem_top y)
    exact (Commute.zpow_zpow_self g b a).eq
  exact ⟨by simpa using hg, by simp [hcent, htop],
    fun h _ hch ↦ ⟨g, Set.mem_singleton g, 1, by simpa [htop, hcent] using hch.symm⟩, by simp⟩

/-- In `ℤ`, the generator `1` alone is a set of representatives of the cyclic centralizers. -/
example : IsCentralizerRepresentatives {Multiplicative.ofAdd (1 : ℤ)} :=
  isCentralizerRepresentatives_singleton_of_zpowers_eq_top (by decide) <|
    eq_top_iff.2 fun x _ ↦ mem_zpowers_iff.2 ⟨x.toAdd, by simp [← ofAdd_zsmul]⟩

/-- In a trivial group, the empty set is a set of representatives of the cyclic centralizers. -/
example [Subsingleton G] : IsCentralizerRepresentatives (∅ : Set G) :=
  isCentralizerRepresentatives_empty_iff.2 fun g hg ↦ (hg (Subsingleton.elim g 1)).elim

/-- In `ℤ²`, the empty set is a set of representatives of the cyclic centralizers: every
centralizer is the whole group, which is not cyclic. -/
example : IsCentralizerRepresentatives (∅ : Set (Multiplicative (ℤ × ℤ))) := by
  refine isCentralizerRepresentatives_empty_iff.2 fun g _ hcg ↦ ?_
  have htop : zpowers g = ⊤ := hcg ▸ by
    simp [centralizer_eq_top_iff_subset, CommGroup.center_eq_top]
  obtain ⟨k, hk⟩ := mem_zpowers_iff.1 (htop ▸ mem_top (Multiplicative.ofAdd (1, 0)))
  obtain ⟨m, hm⟩ := mem_zpowers_iff.1 (htop ▸ mem_top (Multiplicative.ofAdd (0, 1)))
  have hk' := congrArg Multiplicative.toAdd hk
  have hm' := congrArg Multiplicative.toAdd hm
  simp only [toAdd_zpow, toAdd_ofAdd, Prod.ext_iff, Prod.smul_fst, Prod.smul_snd,
    smul_eq_mul] at hk' hm'
  rcases Int.mul_eq_zero.1 hk'.2 with rfl | h
  · simp at hk'
  · simp [h] at hm'

end TauCeti
