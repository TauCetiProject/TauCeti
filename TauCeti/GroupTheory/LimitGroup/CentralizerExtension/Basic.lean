/-!
# Extensions of centralizers

For a group `G`, an element `u : G` and `n : ℕ`, the *extension of the centralizer* of `u` by
`ℤⁿ` is the amalgamated product
`G(u, ℤⁿ) = G ∗_{C_G(u)} (C_G(u) × ℤⁿ)`
of `G` and `C_G(u) × ℤⁿ` over the full centralizer `C_G(u)`, with `C_G(u)` embedded in the second
factor as `c ↦ (c, 1)`. It contains `G` and `n` new letters `t₀, …, tₙ₋₁`, the standard generators
of `ℤⁿ`, which commute with each other and with every element of `C_G(u)`; a homomorphism out of
`G(u, ℤⁿ)` is determined by any such data (`CentralizerExt.homEquiv`). For `n = 1` this is the HNN
extension `⟨G, t | [c, t] = 1, c ∈ C_G(u)⟩`.

Iterated extensions of centralizers are the basic examples of fully residually free groups: over a
CSA group `G` with the big powers property and `u ≠ 1`, the retractions `tᵢ ↦ u ^ kᵢ` of
`G(u, ℤⁿ)` onto `G` discriminate it by `G` (see Kharlampovich–Myasnikov, *Implicit function theorem
over free groups*, §2.5); this is proved as `CentralizerExt.isDiscriminatedBy` in
`TauCeti.GroupTheory.LimitGroup.CentralizerExtension.Discrimination`. This file sets up the
construction for arbitrary `u` and `n`, its universal property and these retractions, and compares
it with `G` for `n = 0`, with `G × ℤⁿ` for central `u`, and with Mathlib's HNN extension for
`n = 1`. The construction always uses the full centralizer and imposes no condition on `u` or `n`;
`IsAdmissibleCentralizerStep u n` records the conditions imposed on a step of an iterated extension
of centralizers. The extension depends only on the centralizer: if `C_G(u) = C_G(v)` then
`G(u, ℤⁿ) ≃* G(v, ℤⁿ)` over `G` (`CentralizerExt.congr`). In particular, when `u = r ^ d` has the
same centralizer as a root `r` that is not a proper power, as in a residually free group, the
extension at `u` is an admissible extension at `r` for `n > 0`, and its retractions are among those
of the extension at `r`.

The amalgam is Mathlib's `Monoid.PushoutI` over the `Bool`-indexed family `CentralizerExtFactor`,
so its normal form theory (`Monoid.PushoutI.NormalWord`) applies directly.

## Main definitions

* `TauCeti.LimitGroup.CentralizerExt u n`: the extension `G(u, ℤⁿ)`.
* `TauCeti.LimitGroup.CentralizerExt.of`: the inclusion of `G`.
* `TauCeti.LimitGroup.CentralizerExt.t`: the new letters `tᵢ`.
* `TauCeti.LimitGroup.CentralizerExt.ofProd`: the inclusion of the factor `C_G(u) × ℤⁿ`.
* `TauCeti.LimitGroup.CentralizerExt.lift`, `TauCeti.LimitGroup.CentralizerExt.homEquiv`: the
  universal property.
* `TauCeti.LimitGroup.CentralizerExt.retraction k`: the retraction `tᵢ ↦ u ^ kᵢ` onto `G`.
* `TauCeti.LimitGroup.CentralizerExt.congr`: extensions of equal centralizers are isomorphic
  over `G`.
* `TauCeti.LimitGroup.IsAdmissibleCentralizerStep u n`: `u` is not a proper power and `0 < n`.

## Main results

* `TauCeti.LimitGroup.CentralizerExt.of_injective`,
  `TauCeti.LimitGroup.CentralizerExt.ofProd_injective`: both factors embed in `G(u, ℤⁿ)`.
* `TauCeti.LimitGroup.CentralizerExt.range_of_inf_range_ofProd`: the two factors meet in the
  amalgamated subgroup `C_G(u)`.
* `TauCeti.LimitGroup.CentralizerExt.exists_eq_of_mul_list_prod`: the normal form of an element of
  `G(u, ℤⁿ)` as an element of `G` times a reduced word starting in `C_G(u) × ℤⁿ`.
* `TauCeti.LimitGroup.CentralizerExt.closure_range_of_union_range_t`: `G(u, ℤⁿ)` is generated by
  `G` and the new letters, so it is finitely generated when `G` is.
* `TauCeti.LimitGroup.CentralizerExt.range_of_ne_top`: in positive rank, `G` is a proper subgroup of
  `G(u, ℤⁿ)`.
* `TauCeti.LimitGroup.CentralizerExt.zeroEquiv`: `G(u, ℤ⁰) ≃* G`.
* `TauCeti.LimitGroup.CentralizerExt.equivProdOfMemCenter`: for central `u`,
  `G(u, ℤⁿ) ≃* G × ℤⁿ`.
* `TauCeti.LimitGroup.CentralizerExt.equivHNNExtension`: `G(u, ℤ)` is the HNN extension of `G`
  along the identity of `C_G(u)`.

## References

* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §2.5.
* O. Kharlampovich, A. Myasnikov, *Irreducible affine varieties over a free group. I*,
  J. Algebra 200 (1998), §1, Definition 5.
-/

public section

open Subgroup

universe u v

namespace TauCeti.LimitGroup

variable {G : Type u} [Group G]

/-- The two factors of the extension `G(u, ℤⁿ)` as a `Bool`-indexed family: `G` at `false` and
`C_G(u) × ℤⁿ` at `true`, with `ℤⁿ` written as `Fin n → Multiplicative ℤ`. -/
abbrev CentralizerExtFactor (u : G) (n : ℕ) (b : Bool) : Type u :=
  cond b (centralizer {u} × (Fin n → Multiplicative ℤ)) G

instance (u : G) (n : ℕ) (b : Bool) : Group (CentralizerExtFactor u n b) :=
  Bool.rec (motive := fun b => Group (CentralizerExtFactor u n b))
    (inferInstanceAs (Group G))
    (inferInstanceAs (Group (centralizer {u} × (Fin n → Multiplicative ℤ)))) b

/-- The two embeddings of `C_G(u)` amalgamated in `G(u, ℤⁿ)`: the inclusion into `G` and
`c ↦ (c, 1)` into `C_G(u) × ℤⁿ`. -/
def centralizerExtMap (u : G) (n : ℕ) :
    ∀ b, centralizer {u} →* CentralizerExtFactor u n b
  | false => (centralizer {u}).subtype
  | true => MonoidHom.inl _ _

@[simp] theorem centralizerExtMap_false (u : G) (n : ℕ) :
    centralizerExtMap u n false = (centralizer {u}).subtype := (rfl)

@[simp] theorem centralizerExtMap_true (u : G) (n : ℕ) :
    centralizerExtMap u n true = MonoidHom.inl (centralizer {u}) (Fin n → Multiplicative ℤ) :=
  (rfl)

theorem centralizerExtMap_injective (u : G) (n : ℕ) (b : Bool) :
    Function.Injective (centralizerExtMap u n b) := by
  cases b
  · exact Subtype.val_injective
  · exact fun _ _ h => congrArg Prod.fst h

/-- The *extension of the centralizer* of `u` by `ℤⁿ`, the amalgamated product
`G(u, ℤⁿ) = G ∗_{C_G(u)} (C_G(u) × ℤⁿ)` over the full centralizer `C_G(u)`. -/
abbrev CentralizerExt (u : G) (n : ℕ) : Type u :=
  Monoid.PushoutI (centralizerExtMap u n)

namespace CentralizerExt

variable {u : G} {n : ℕ} {K : Type v}

open Monoid.PushoutI

/-- The inclusion of `G` in `G(u, ℤⁿ)`. -/
def of : G →* CentralizerExt u n :=
  Monoid.PushoutI.of (φ := centralizerExtMap u n) false

/-- The new letter `tᵢ` of `G(u, ℤⁿ)`, the `i`-th standard generator of `ℤⁿ`. -/
def t (i : Fin n) : CentralizerExt u n :=
  Monoid.PushoutI.of (φ := centralizerExtMap u n) true (1, Pi.mulSingle i (.ofAdd 1))

/-- The inclusion of `G` is the inclusion of the first factor of the amalgam. -/
theorem of_def :
    (of : G →* CentralizerExt u n) = Monoid.PushoutI.of (φ := centralizerExtMap u n) false :=
  (rfl)

/-- The new letter `tᵢ` is the image of the `i`-th standard generator of the second factor. -/
theorem t_def (i : Fin n) :
    (t i : CentralizerExt u n) =
      Monoid.PushoutI.of (φ := centralizerExtMap u n) true (1, Pi.mulSingle i (.ofAdd 1)) :=
  (rfl)

/-- `G` embeds in `G(u, ℤⁿ)`. -/
theorem of_injective : Function.Injective (of : G →* CentralizerExt u n) :=
  Monoid.PushoutI.of_injective (centralizerExtMap_injective u n) false

@[simp] theorem of_inj {g h : G} : (of g : CentralizerExt u n) = of h ↔ g = h :=
  of_injective.eq_iff

/-- An element of `G` commutes with `of h` in `G(u, ℤⁿ)` exactly when it commutes with `h`
in `G`. -/
theorem of_mem_centralizer_of_iff {g h : G} :
    (of g : CentralizerExt u n) ∈ centralizer {of h} ↔ g ∈ centralizer {h} := by
  simp only [mem_centralizer_singleton_iff, ← map_mul, of_inj]

/-- The new letters commute with each other. -/
theorem commute_t_t (i j : Fin n) : Commute (t i : CentralizerExt u n) (t j) :=
  ((Commute.one_right 1).prod (Commute.all _ _)).map _

/-- The inclusion of the factor `C_G(u) × ℤⁿ` in `G(u, ℤⁿ)`. -/
def ofProd : centralizer {u} × (Fin n → Multiplicative ℤ) →* CentralizerExt u n :=
  Monoid.PushoutI.of (φ := centralizerExtMap u n) true

/-- The inclusion of `C_G(u) × ℤⁿ` is the inclusion of the second factor of the amalgam. -/
theorem ofProd_def :
    (ofProd : _ →* CentralizerExt u n) = Monoid.PushoutI.of (φ := centralizerExtMap u n) true :=
  (rfl)

theorem ofProd_mulSingle (i : Fin n) :
    (ofProd (1, Pi.mulSingle i (.ofAdd 1)) : CentralizerExt u n) = t i :=
  (rfl)

/-- The element `(c, v)` of `C_G(u) × ℤⁿ` is `c * ∏ i, tᵢ ^ vᵢ` in `G(u, ℤⁿ)`, the product written
with `zpowersPiHom` since the `tᵢ` live in a noncommutative group. -/
theorem ofProd_apply (c : centralizer {u}) (v : Fin n → Multiplicative ℤ) :
    (ofProd (c, v) : CentralizerExt u n) = of (c : G) * zpowersPiHom t commute_t_t v := by
  have hcv : ((c, v) : centralizer {u} × (Fin n → Multiplicative ℤ)) = (c, 1) * (1, v) := by
    simp
  have h₁ := of_apply_eq_base (centralizerExtMap u n) true c
  have h₂ := of_apply_eq_base (centralizerExtMap u n) false c
  simp only [centralizerExtMap_true, centralizerExtMap_false, Subgroup.coe_subtype] at h₁ h₂
  have hv : (ofProd (u := u) (n := n)).comp (MonoidHom.inr _ _) = zpowersPiHom t commute_t_t :=
    MonoidHom.pi_ext_mint fun i => by simp [ofProd_mulSingle]
  rw [hcv, map_mul]
  -- `MonoidHom.inl _ _ c` is `(c, 1)` by definition, and `of` is the inclusion at `false`; `simp`
  -- cannot see the former through the instance on the `Bool`-indexed factor.
  exact congrArg₂ (· * ·) (h₁.trans h₂.symm) (DFunLike.congr_fun hv v)

@[simp] theorem ofProd_inl (c : centralizer {u}) :
    (ofProd (c, 1) : CentralizerExt u n) = of (c : G) := by
  rw [ofProd_apply, map_one, mul_one]

@[simp] theorem ofProd_inr (v : Fin n → Multiplicative ℤ) :
    (ofProd (1, v) : CentralizerExt u n) = zpowersPiHom t commute_t_t v := by
  rw [ofProd_apply, OneMemClass.coe_one, map_one, one_mul]

/-- The factor `C_G(u) × ℤⁿ` embeds in `G(u, ℤⁿ)`. -/
theorem ofProd_injective : Function.Injective (ofProd : _ →* CentralizerExt u n) :=
  Monoid.PushoutI.of_injective (centralizerExtMap_injective u n) true

@[simp] theorem ofProd_inj {p q : centralizer {u} × (Fin n → Multiplicative ℤ)} :
    (ofProd p : CentralizerExt u n) = ofProd q ↔ p = q :=
  ofProd_injective.eq_iff

/-- The new letters commute with every element of `C_G(u)`. -/
theorem commute_of_t {c : G} (hc : c ∈ centralizer {u}) (i : Fin n) :
    Commute (of c : CentralizerExt u n) (t i) := by
  rw [← ofProd_inl ⟨c, hc⟩, ← ofProd_mulSingle]
  exact ((Commute.one_right _).prod (Commute.one_left _)).map _

/-- The factor `C_G(u) × ℤⁿ` of `G(u, ℤⁿ)` is generated by `C_G(u)` and the new letters. -/
theorem range_ofProd :
    (ofProd : _ →* CentralizerExt u n).range =
      (centralizer {u}).map of ⊔ closure (Set.range t) := by
  refine le_antisymm ?_ (sup_le ?_ ((closure_le _).2 ?_))
  · rintro _ ⟨⟨c, v⟩, rfl⟩
    rw [ofProd_apply]
    exact mul_mem (mem_sup_left (mem_map_of_mem _ c.2))
      (mem_sup_right ((range_zpowersPiHom t commute_t_t).le (MonoidHom.mem_range.2 ⟨v, rfl⟩)))
  · rintro _ ⟨c, hc, rfl⟩
    exact ⟨(⟨c, hc⟩, 1), ofProd_inl _⟩
  · rintro _ ⟨i, rfl⟩
    exact ⟨_, ofProd_mulSingle i⟩

/-- Every element of the factor `C_G(u) × ℤⁿ` of `G(u, ℤⁿ)` commutes with `u`. -/
theorem commute_ofProd_of (p : centralizer {u} × (Fin n → Multiplicative ℤ)) :
    Commute (ofProd p : CentralizerExt u n) (of u) := by
  have hu : u ∈ centralizer {u} := mem_centralizer_singleton_iff.2 rfl
  rw [← ofProd_inl ⟨u, hu⟩]
  exact (((commute_iff_eq _ _).2 (Subtype.ext (mem_centralizer_singleton_iff.1 p.1.2))).prod
    (Commute.one_right _)).map ofProd

/-- The normal form for the amalgam `G(u, ℤⁿ)`: every element is `g * a₁ * ⋯ * aᵣ` with `g ∈ G`
and letters `aⱼ` alternately in `C_G(u) × ℤⁿ` and in `G`, none of them in `C_G(u)`, the first one
in `C_G(u) × ℤⁿ`. -/
theorem exists_eq_of_mul_list_prod (x : CentralizerExt u n) :
    ∃ (g : G) (L : List (Σ b, CentralizerExtFactor u n b)),
      L.IsChain (fun l l' => l.1 ≠ l'.1) ∧ (∀ l ∈ L, l.2 ∉ (centralizerExtMap u n l.1).range) ∧
      (∀ l ∈ L.head?, l.1 = true) ∧
      x = of g * (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod := by
  obtain ⟨g, L, hc, hred, hhead, rfl⟩ := Monoid.PushoutI.exists_eq_of_mul_list_prod false x
  exact ⟨g, L, hc, hred, fun l hl => by simpa using hhead l hl, by rw [of_def]⟩

/-- Homomorphisms out of `G(u, ℤⁿ)` agree when they agree on `G` and on the new letters. -/
@[ext high]
theorem hom_ext [Monoid K] {f g : CentralizerExt u n →* K} (hof : f.comp of = g.comp of)
    (ht : ∀ i, f (t i) = g (t i)) : f = g := by
  refine Monoid.PushoutI.hom_ext_nonempty fun b => ?_
  cases b
  · exact hof
  · -- On `C_G(u) × ℤⁿ`, write `(c, v)` as `c * ∏ i, tᵢ ^ vᵢ`.
    have hv : f.comp (zpowersPiHom t commute_t_t) = g.comp (zpowersPiHom t commute_t_t) :=
      MonoidHom.pi_ext_mint fun i => by simpa using ht i
    refine MonoidHom.ext fun ⟨c, v⟩ => ?_
    have h := congrArg₂ (· * ·) (DFunLike.congr_fun hof (c : G)) (DFunLike.congr_fun hv v)
    simp only [MonoidHom.comp_apply, ← map_mul, ← ofProd_apply] at h
    exact h

variable [Group K]

/-- A homomorphism out of `G(u, ℤⁿ)` is given by a homomorphism `φ` on `G` and pairwise commuting
images `τ i` of the new letters that commute with `φ (C_G(u))`. -/
def lift (φ : G →* K) (τ : Fin n → K) (hτ : ∀ i j, Commute (τ i) (τ j))
    (hφ : ∀ c ∈ centralizer {u}, ∀ i, Commute (φ c) (τ i)) : CentralizerExt u n →* K :=
  Monoid.PushoutI.lift
    (fun b => Bool.rec (motive := fun b => CentralizerExtFactor u n b →* K) φ
      ((φ.comp (centralizer {u}).subtype).noncommCoprod (zpowersPiHom τ hτ)
        fun c v => commute_zpowersPiHom (x := (φ.comp (centralizer {u}).subtype) c) (hφ c c.2) v)
      b)
    (φ.comp (centralizer {u}).subtype)
    fun b => by
      cases b
      · rfl
      · exact MonoidHom.noncommCoprod_comp_inl _ _ _

section lift

variable (φ : G →* K) (τ : Fin n → K) (hτ : ∀ i j, Commute (τ i) (τ j))
  (hφ : ∀ c ∈ centralizer {u}, ∀ i, Commute (φ c) (τ i))

@[simp] theorem lift_of (g : G) : lift φ τ hτ hφ (of g) = φ g := by
  rw [lift, of, Monoid.PushoutI.lift_of]

@[simp] theorem lift_comp_of : (lift φ τ hτ hφ).comp of = φ :=
  MonoidHom.ext (lift_of φ τ hτ hφ)

@[simp] theorem lift_ofProd (p : centralizer {u} × (Fin n → Multiplicative ℤ)) :
    lift φ τ hτ hφ (ofProd p) = φ p.1 * zpowersPiHom τ hτ p.2 := by
  rw [ofProd, lift, Monoid.PushoutI.lift_of]
  -- The factor homomorphism is stated through the `Bool`-indexed family; restate it on the product.
  exact MonoidHom.noncommCoprod_apply _ _ _ _

@[simp] theorem lift_t (i : Fin n) : lift φ τ hτ hφ (t i) = τ i := by
  rw [← ofProd_mulSingle, lift_ofProd]
  simp

end lift

/-- The universal property of `G(u, ℤⁿ)`: homomorphisms to `K` correspond to homomorphisms
`φ : G →* K` together with pairwise commuting images of the new letters that commute with
`φ (C_G(u))`. -/
def homEquiv : (CentralizerExt u n →* K) ≃
    { p : (G →* K) × (Fin n → K) // (∀ i j, Commute (p.2 i) (p.2 j)) ∧
      ∀ c ∈ centralizer {u}, ∀ i, Commute (p.1 c) (p.2 i) } where
  toFun f := ⟨(f.comp of, fun i => f (t i)), fun i j => (commute_t_t i j).map f,
    fun _ hc i => (commute_of_t hc i).map f⟩
  invFun p := lift p.1.1 p.1.2 p.2.1 p.2.2
  left_inv f := hom_ext (by simp) (by simp)
  right_inv p := by ext <;> simp

@[simp] theorem homEquiv_apply_coe (f : CentralizerExt u n →* K) :
    (homEquiv f : (G →* K) × (Fin n → K)) = (f.comp of, fun i => f (t i)) := (rfl)

@[simp] theorem homEquiv_symm_apply (p) :
    (homEquiv (u := u) (n := n) (K := K)).symm p = lift p.1.1 p.1.2 p.2.1 p.2.2 := (rfl)

/-- For `k : Fin n → ℤ`, the retraction of `G(u, ℤⁿ)` onto `G` sending `tᵢ` to `u ^ kᵢ`. -/
def retraction (k : Fin n → ℤ) : CentralizerExt u n →* G :=
  lift (.id G) (fun i => u ^ k i) (fun _ _ => Commute.zpow_zpow_self _ _ _)
    fun _ hc _ => Commute.zpow_right (mem_centralizer_singleton_iff.mp hc) _

@[simp] theorem retraction_of (k : Fin n → ℤ) (g : G) :
    retraction k (of g : CentralizerExt u n) = g :=
  lift_of _ _ _ _ g

@[simp] theorem retraction_t (k : Fin n → ℤ) (i : Fin n) :
    retraction k (t i : CentralizerExt u n) = u ^ k i :=
  lift_t _ _ _ _ i

@[simp] theorem retraction_comp_of (k : Fin n → ℤ) :
    (retraction k).comp (of : G →* CentralizerExt u n) = .id G :=
  lift_comp_of _ _ _ _

/-- `G(u, ℤⁿ)` is generated by `G` and the new letters. -/
theorem closure_range_of_union_range_t :
    closure (Set.range (of : G →* CentralizerExt u n) ∪ Set.range t) = ⊤ := by
  set S := closure (Set.range (of : G →* CentralizerExt u n) ∪ Set.range t)
  have hof (g : G) : (of g : CentralizerExt u n) ∈ S := subset_closure (Or.inl ⟨g, rfl⟩)
  -- The second factor is generated by `C_G(u) ≤ G` and the new letters.
  have htrue : (ofProd : _ →* CentralizerExt u n).range ≤ S := by
    rw [range_ofProd]
    refine sup_le ?_ (closure_mono Set.subset_union_right)
    rintro _ ⟨c, -, rfl⟩
    exact hof c
  refine (eq_top_iff' S).2 fun x => ?_
  induction x using Monoid.PushoutI.induction_on with
  | of b g =>
    cases b
    · exact hof g
    · exact htrue ⟨g, rfl⟩
  | base c =>
    rw [← of_apply_eq_base (centralizerExtMap u n) false c]
    exact hof (c : G)
  | mul x y hx hy => exact mul_mem hx hy

/-- Extending a centralizer of a finitely generated group gives a finitely generated group. -/
instance [Group.FG G] : Group.FG (CentralizerExt u n) := by
  obtain ⟨s, hs, hsf⟩ := Group.fg_iff.1 ‹Group.FG G›
  refine Group.fg_iff.2 ⟨of '' s ∪ Set.range t, eq_top_iff.2 ?_,
    (hsf.image _).union (Set.finite_range _)⟩
  rw [← closure_range_of_union_range_t]
  refine (closure_le _).2 (Set.union_subset ?_ (Set.subset_union_right.trans subset_closure))
  rintro _ ⟨g, rfl⟩
  have hg : of g ∈ (closure s).map (of : G →* CentralizerExt u n) :=
    mem_map_of_mem _ (hs ▸ mem_top g)
  rw [MonoidHom.map_closure] at hg
  exact closure_mono Set.subset_union_left hg

/-- An element `(c, v)` of the factor `C_G(u) × ℤⁿ` lies in `G` exactly when `v = 1`: the
homomorphism `G(u, ℤⁿ) →* ℤⁿ` killing `G` sends it to `v`. -/
theorem ofProd_mem_range_of_iff {p : centralizer {u} × (Fin n → Multiplicative ℤ)} :
    ofProd p ∈ (of : G →* CentralizerExt u n).range ↔ p.2 = 1 := by
  refine ⟨fun ⟨g, hg⟩ => ?_, fun h => ⟨p.1, by rw [← ofProd_inl, ← h]⟩⟩
  let ρ : CentralizerExt u n →* (Fin n → Multiplicative ℤ) :=
    lift 1 (fun j => Pi.mulSingle j (.ofAdd 1)) (fun _ _ => .all _ _) fun _ _ _ => .all _ _
  have hρ : zpowersPiHom (fun j : Fin n => Pi.mulSingle j (Multiplicative.ofAdd 1))
      (fun _ _ => .all _ _) = MonoidHom.id _ :=
    MonoidHom.pi_ext_mint fun i => by simp
  simpa [ρ, hρ] using (congrArg ρ hg).symm

/-- An element of `G` lies in the factor `C_G(u) × ℤⁿ` of `G(u, ℤⁿ)` exactly when it lies in
`C_G(u)`. -/
theorem of_mem_range_ofProd_iff {g : G} :
    of g ∈ (ofProd : _ →* CentralizerExt u n).range ↔ g ∈ centralizer {u} := by
  refine ⟨fun ⟨⟨c, v⟩, hp⟩ => ?_, fun hg => ⟨(⟨g, hg⟩, 1), ofProd_inl _⟩⟩
  obtain rfl : v = 1 := ofProd_mem_range_of_iff.1 ⟨g, hp.symm⟩
  rw [ofProd_inl, of_inj] at hp
  exact hp ▸ c.2

/-- The two factors `G` and `C_G(u) × ℤⁿ` of `G(u, ℤⁿ)` meet exactly in the amalgamated subgroup
`C_G(u)`. -/
theorem range_of_inf_range_ofProd :
    (of : G →* CentralizerExt u n).range ⊓ (ofProd : _ →* CentralizerExt u n).range =
      (centralizer {u}).map of := by
  ext x
  constructor
  · rintro ⟨⟨g, rfl⟩, hg⟩
    exact ⟨g, of_mem_range_ofProd_iff.1 hg, rfl⟩
  · rintro ⟨g, hg, rfl⟩
    exact ⟨⟨g, rfl⟩, of_mem_range_ofProd_iff.2 hg⟩

/-- The new letters do not lie in `G`. -/
theorem t_notMem_range_of (i : Fin n) : t i ∉ (of : G →* CentralizerExt u n).range := by
  rw [← ofProd_mulSingle, ofProd_mem_range_of_iff]
  simp

/-- In positive rank, `G` is a proper subgroup of `G(u, ℤⁿ)`. -/
theorem range_of_ne_top (hn : 0 < n) : (of : G →* CentralizerExt u n).range ≠ ⊤ :=
  fun h => t_notMem_range_of ⟨0, hn⟩ (h ▸ mem_top _)

/-- The homomorphism `G(u, ℤⁿ) →* G(v, ℤⁿ)` fixing `G` and the new letters, for
`C_G(u) = C_G(v)`. -/
private def congrHom {v : G} (h : centralizer {u} = centralizer {v}) :
    CentralizerExt u n →* CentralizerExt v n :=
  lift of t commute_t_t fun _ hc i => commute_of_t (h ▸ hc) i

private theorem congrHom_of {v : G} (h : centralizer {u} = centralizer {v}) (g : G) :
    congrHom (n := n) h (of g) = of g :=
  lift_of _ _ _ _ g

private theorem congrHom_t {v : G} (h : centralizer {u} = centralizer {v}) (i : Fin n) :
    congrHom h (t i) = t i :=
  lift_t _ _ _ _ i

/-- Extensions of equal centralizers are isomorphic over `G`: if `C_G(u) = C_G(v)`, then
`G(u, ℤⁿ) ≃* G(v, ℤⁿ)`, fixing `G` and the new letters. -/
def congr {v : G} (h : centralizer {u} = centralizer {v}) :
    CentralizerExt u n ≃* CentralizerExt v n :=
  (congrHom h).toMulEquiv (congrHom h.symm)
    (hom_ext (by ext; simp [congrHom_of]) (by simp [congrHom_t]))
    (hom_ext (by ext; simp [congrHom_of]) (by simp [congrHom_t]))

@[simp] theorem congr_of {v : G} (h : centralizer {u} = centralizer {v}) (g : G) :
    congr (n := n) h (of g) = of g :=
  congrHom_of h g

@[simp] theorem congr_t {v : G} (h : centralizer {u} = centralizer {v}) (i : Fin n) :
    congr h (t i) = t i :=
  congrHom_t h i

@[simp] theorem congr_symm {v : G} (h : centralizer {u} = centralizer {v}) :
    (congr (n := n) h).symm = congr h.symm := (rfl)

/-- If `u = r ^ d` and `C_G(u) = C_G(r)`, the retraction `tᵢ ↦ u ^ kᵢ` of `G(u, ℤⁿ)` factors
through `congr` as the retraction `tᵢ ↦ r ^ (d * kᵢ)` of `G(r, ℤⁿ)`. -/
theorem retraction_comp_congr {r : G} {d : ℕ} (hd : r ^ d = u)
    (h : centralizer {u} = centralizer {r}) (k : Fin n → ℤ) :
    (retraction (fun i => d * k i)).comp (congr h).toMonoidHom = retraction k := by
  subst hd
  exact hom_ext (by ext; simp) fun i => by simp [zpow_mul]

/-- Pointwise form of `retraction_comp_congr`. -/
@[simp] theorem retraction_congr {r : G} {d : ℕ} (hd : r ^ d = u)
    (h : centralizer {u} = centralizer {r}) (k : Fin n → ℤ) (x : CentralizerExt u n) :
    retraction (fun i => d * k i) (congr h x) = retraction k x :=
  DFunLike.congr_fun (retraction_comp_congr hd h k) x

/-- Extending a centralizer by `ℤ⁰` does not change the group: `G(u, ℤ⁰) ≃* G`. -/
def zeroEquiv : CentralizerExt u 0 ≃* G :=
  (retraction 0).toMulEquiv of (hom_ext (by ext; simp) finZeroElim) (retraction_comp_of 0)

@[simp] theorem zeroEquiv_of (g : G) : zeroEquiv (of g : CentralizerExt u 0) = g :=
  retraction_of (u := u) (n := 0) 0 g

@[simp] theorem zeroEquiv_symm_apply (g : G) : (zeroEquiv (u := u)).symm g = of g := (rfl)

/-- The homomorphism `G(u, ℤⁿ) →* G × ℤⁿ` sending `g` to `(g, 1)` and `tᵢ` to the `i`-th
standard generator. -/
private def toProd : CentralizerExt u n →* G × (Fin n → Multiplicative ℤ) :=
  lift (.inl _ _) (fun i => (1, Pi.mulSingle i (.ofAdd 1)))
    (fun _ _ => (Commute.one_right 1).prod (.all _ _)) fun _ _ _ => MonoidHom.commute_inl_inr _ _

private theorem toProd_of (g : G) : toProd (of g : CentralizerExt u n) = (g, 1) :=
  lift_of _ _ _ _ g

private theorem toProd_t (i : Fin n) :
    toProd (t i : CentralizerExt u n) = (1, Pi.mulSingle i (.ofAdd 1)) :=
  lift_t _ _ _ _ i

/-- If `u` is central, its centralizer is all of `G`, and extending it by `ℤⁿ` is the direct
product: `G(u, ℤⁿ) ≃* G × ℤⁿ`. -/
def equivProdOfMemCenter (hu : u ∈ center G) :
    CentralizerExt u n ≃* G × (Fin n → Multiplicative ℤ) :=
  toProd.toMulEquiv (of.noncommCoprod (zpowersPiHom t commute_t_t) fun g =>
      commute_zpowersPiHom (commute_of_t (mem_centralizer_singleton_iff.2 (mem_center_iff.1 hu g))))
    (hom_ext (by ext; simp [toProd_of]) fun i => by simp [toProd_t])
    (by
      have hv : (toProd (u := u) (n := n)).comp (zpowersPiHom t commute_t_t) = .inr _ _ :=
        MonoidHom.pi_ext_mint fun i => by simp [toProd_t]
      refine MonoidHom.ext fun ⟨x, v⟩ => ?_
      simp [toProd_of, ← MonoidHom.comp_apply _ (zpowersPiHom t commute_t_t), hv])

@[simp] theorem equivProdOfMemCenter_of (hu : u ∈ center G) (g : G) :
    equivProdOfMemCenter (n := n) hu (of g) = (g, 1) :=
  toProd_of g

@[simp] theorem equivProdOfMemCenter_t (hu : u ∈ center G) (i : Fin n) :
    equivProdOfMemCenter hu (t i) = (1, Pi.mulSingle i (.ofAdd 1)) :=
  toProd_t i

/-- The homomorphism `G(u, ℤ) →* ⟨G, t | [c, t] = 1, c ∈ C_G(u)⟩` that is the identity on `G` and
sends `t₀` to `t`. -/
private def toHNNExtension :
    CentralizerExt u 1 →* HNNExtension G (centralizer {u}) (centralizer {u}) (.refl _) :=
  lift HNNExtension.of (fun _ => HNNExtension.t) (fun _ _ => Commute.refl _)
    fun _ hc _ => HNNExtension.commute_of_t_iff_mem.2 hc

private theorem toHNNExtension_of (g : G) :
    toHNNExtension (of g : CentralizerExt u 1) = HNNExtension.of g :=
  lift_of _ _ _ _ g

private theorem toHNNExtension_t (i : Fin 1) :
    toHNNExtension (t i : CentralizerExt u 1) = HNNExtension.t :=
  lift_t _ _ _ _ i

/-- The inverse of `toHNNExtension`. -/
private def ofHNNExtension :
    HNNExtension G (centralizer {u}) (centralizer {u}) (.refl _) →* CentralizerExt u 1 :=
  HNNExtension.lift of (t 0) fun c => (commute_of_t c.2 0).symm.eq

private theorem ofHNNExtension_of (g : G) :
    ofHNNExtension (HNNExtension.of g : HNNExtension G (centralizer {u}) (centralizer {u}) _) =
      of g :=
  HNNExtension.lift_of _ _ _ g

private theorem ofHNNExtension_t :
    ofHNNExtension (HNNExtension.t : HNNExtension G (centralizer {u}) (centralizer {u}) _) =
      (t 0 : CentralizerExt u 1) :=
  HNNExtension.lift_t _ _ _

/-- Extending a centralizer by `ℤ` is the HNN extension `⟨G, t | [c, t] = 1, c ∈ C_G(u)⟩` along the
identity of `C_G(u)`. -/
def equivHNNExtension :
    CentralizerExt u 1 ≃* HNNExtension G (centralizer {u}) (centralizer {u}) (.refl _) :=
  toHNNExtension.toMulEquiv ofHNNExtension
    (hom_ext (by ext; simp [toHNNExtension_of, ofHNNExtension_of]) fun i => by
      simp [toHNNExtension_t, ofHNNExtension_t, Subsingleton.elim i 0])
    (HNNExtension.hom_ext (by ext; simp [toHNNExtension_of, ofHNNExtension_of])
      (by simp [toHNNExtension_t, ofHNNExtension_t]))

@[simp] theorem equivHNNExtension_of (g : G) :
    equivHNNExtension (of g : CentralizerExt u 1) = HNNExtension.of g :=
  toHNNExtension_of g

@[simp] theorem equivHNNExtension_t (i : Fin 1) :
    equivHNNExtension (t i : CentralizerExt u 1) = HNNExtension.t :=
  toHNNExtension_t i

@[simp] theorem equivHNNExtension_symm_of (g : G) :
    equivHNNExtension.symm
      (HNNExtension.of g : HNNExtension G (centralizer {u}) (centralizer {u}) (.refl _)) = of g :=
  ofHNNExtension_of g

@[simp] theorem equivHNNExtension_symm_t :
    equivHNNExtension.symm
      (HNNExtension.t : HNNExtension G (centralizer {u}) (centralizer {u}) (.refl _)) = t 0 :=
  ofHNNExtension_t

end CentralizerExt

/-- A step `G ↦ G(u, ℤⁿ)` of an iterated extension of centralizers is *admissible* when `u` is not
a proper power (in particular `u ≠ 1`) and the added rank `n` is positive. -/
def IsAdmissibleCentralizerStep (u : G) (n : ℕ) : Prop :=
  ¬Group.IsProperPower u ∧ 0 < n

theorem isAdmissibleCentralizerStep_iff {u : G} {n : ℕ} :
    IsAdmissibleCentralizerStep u n ↔ ¬Group.IsProperPower u ∧ 0 < n :=
  Iff.rfl

theorem IsAdmissibleCentralizerStep.ne_one {u : G} {n : ℕ} (h : IsAdmissibleCentralizerStep u n) :
    u ≠ 1 :=
  Group.ne_one_of_not_isProperPower h.1

/-- An admissible step adds positive rank. -/
theorem IsAdmissibleCentralizerStep.pos {u : G} {n : ℕ} (h : IsAdmissibleCentralizerStep u n) :
    0 < n :=
  h.2

/-- Extending the centralizer of a basis element of a free group is admissible in every positive
rank. -/
theorem isAdmissibleCentralizerStep_freeGroup_of {α : Type*} (a : α) {n : ℕ} (hn : 0 < n) :
    IsAdmissibleCentralizerStep (FreeGroup.of a) n :=
  ⟨FreeGroup.not_isProperPower_of a, hn⟩

/-- Extending the centralizer of the square of a basis element of a free group is never
admissible. -/
theorem not_isAdmissibleCentralizerStep_freeGroup_of_sq {α : Type*} (a : α) (n : ℕ) :
    ¬IsAdmissibleCentralizerStep (FreeGroup.of a ^ 2) n :=
  fun h => h.1 (FreeGroup.isProperPower_of_sq a)

end TauCeti.LimitGroup
