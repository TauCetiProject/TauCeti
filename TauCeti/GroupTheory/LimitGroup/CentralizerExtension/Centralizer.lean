/-!
# The centralizer of the base element in an extension of centralizers

Let `G` be a CSA group and `u : G`. In the extension `G(u, ℤⁿ) = G ∗_{C_G(u)} (C_G(u) × ℤⁿ)` of the
centralizer of `u`, the centralizer of `u` is exactly the second factor `C_G(u) × ℤⁿ`: it is
generated by `C_G(u)` and the new letters `t₀, …, tₙ₋₁`. So extending a centralizer enlarges
that centralizer by a free abelian direct factor of rank `n` and nothing else.

For a basis element `a` of a free group `F`, where `C_F(a) = ⟨a⟩`, the centralizer of `a` in
`F(a, ℤⁿ)` is the free abelian group of rank `n + 1` on `a, t₀, …, tₙ₋₁`. For `n = 1` this is the
subgroup `⟨a, t⟩ ≅ ℤ²` of `⟨F, t | [a, t] = 1⟩`, so centralizers in fully residually free groups
need not be cyclic.

## Main definitions

* `TauCeti.LimitGroup.CentralizerExt.ofProd`: the inclusion of the factor `C_G(u) × ℤⁿ`.
* `TauCeti.LimitGroup.CentralizerExt.centralizerEquiv`: for a CSA group `G`, the isomorphism of
  `C_G(u) × ℤⁿ` with the centralizer of `u` in `G(u, ℤⁿ)`.
* `TauCeti.LimitGroup.CentralizerExt.centralizerFreeGroupOfEquiv`: the isomorphism of `ℤ × ℤⁿ`
  with the centralizer of a basis element `a` in `F(a, ℤⁿ)`.

## Main results

* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_eq_range_ofProd`: for a CSA group `G`, the
  centralizer of `u` in `G(u, ℤⁿ)` is the factor `C_G(u) × ℤⁿ`.
* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_eq_map_sup_closure`: it is generated by
  `C_G(u)` and the new letters.
* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_freeGroup_of`: the centralizer of a basis
  element `a` of a free group `F` in `F(a, ℤ)` is generated by `a` and the new letter.

## Implementation notes

The proof uses the normal form for amalgamated products. Write an element commuting with `u` as
`k * a₁ * ⋯ * aᵣ` with `k ∈ G` and letters `aⱼ` alternately in `(C_G(u) × ℤⁿ) ∖ C_G(u)` and in
`G ∖ C_G(u)`, starting in the former. Then `u = w⁻¹ * (k⁻¹ * u * k) * w` for `w = a₁ * ⋯ * aᵣ`;
were `k⁻¹ * u * k` outside `C_G(u)`, the right-hand side would be a reduced word of length
`2 * r + 1`, which is not in `C_G(u)`. So `k⁻¹ * u * k` commutes with `u`, and `k ∈ C_G(u)` because
`C_G(u)` is malnormal. As `a₁` commutes with `u`, the same argument applied to `a₂ * ⋯ * aᵣ` shows
that `r ≤ 1`.

## References

* O. Kharlampovich, A. Myasnikov, V. Remeslennikov, D. Serbin, *Subgroups of fully residually free
  groups: algorithmic problems*, Contemp. Math. 360 (2004), §5, Lemma 19.
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §2.5.
-/

public section

open Group Subgroup

namespace TauCeti.LimitGroup.CentralizerExt

variable {G : Type*} [Group G] {u : G} {n : ℕ}

/-- The inclusion of the factor `C_G(u) × ℤⁿ` in `G(u, ℤⁿ)`. -/
def ofProd : centralizer {u} × (Fin n → Multiplicative ℤ) →* CentralizerExt u n :=
  Monoid.PushoutI.of (φ := centralizerExtMap u n) true

/-- The inclusion of `C_G(u) × ℤⁿ` is the inclusion of the second factor of the amalgam. -/
theorem ofProd_def :
    (ofProd : _ →* CentralizerExt u n) = Monoid.PushoutI.of (φ := centralizerExtMap u n) true :=
  (rfl)

/-- The element `(c, v)` of `C_G(u) × ℤⁿ` is `c * ∏ i, tᵢ ^ vᵢ` in `G(u, ℤⁿ)`. -/
theorem ofProd_apply (c : centralizer {u}) (v : Fin n → Multiplicative ℤ) :
    (ofProd (c, v) : CentralizerExt u n) = of (c : G) * zpowersPiHom t commute_t_t v :=
  pushoutI_of_true c v

@[simp] theorem ofProd_inl (c : centralizer {u}) :
    (ofProd (c, 1) : CentralizerExt u n) = of (c : G) := by
  rw [ofProd_apply, map_one, mul_one]

@[simp] theorem ofProd_mulSingle (i : Fin n) :
    (ofProd (1, Pi.mulSingle i (.ofAdd 1)) : CentralizerExt u n) = t i :=
  (t_def i).symm

/-- The factor `C_G(u) × ℤⁿ` embeds in `G(u, ℤⁿ)`. -/
theorem ofProd_injective : Function.Injective (ofProd : _ →* CentralizerExt u n) :=
  Monoid.PushoutI.of_injective (centralizerExtMap_injective u n) true

/-- The factor `C_G(u) × ℤⁿ` of `G(u, ℤⁿ)` is generated by `C_G(u)` and the new letters. -/
theorem range_ofProd :
    (ofProd : _ →* CentralizerExt u n).range =
      (centralizer {u}).map of ⊔ closure (Set.range t) := by
  refine le_antisymm ?_ (sup_le ?_ ((closure_le _).2 ?_))
  · rintro _ ⟨⟨c, v⟩, rfl⟩
    rw [ofProd_apply]
    exact mul_mem (mem_sup_left (mem_map_of_mem _ c.2))
      (mem_sup_right ((range_zpowersPiHom t commute_t_t).le (MonoidHom.mem_range.2 ⟨v, rfl⟩)))
  · rintro _ ⟨c, hc, rfl⟩
    exact ⟨(⟨c, hc⟩, 1), ofProd_inl _⟩
  · rintro _ ⟨i, rfl⟩
    exact ⟨_, ofProd_mulSingle i⟩

/-- Every element of the factor `C_G(u) × ℤⁿ` of `G(u, ℤⁿ)` commutes with `u`. -/
theorem commute_ofProd_of (p : centralizer {u} × (Fin n → Multiplicative ℤ)) :
    Commute (ofProd p : CentralizerExt u n) (of u) := by
  have hu : u ∈ centralizer {u} := mem_centralizer_singleton_iff.2 rfl
  rw [← ofProd_inl ⟨u, hu⟩]
  exact (Commute.prod (Subtype.ext (mem_centralizer_singleton_iff.1 p.1.2))
    (Commute.one_right _)).map ofProd

/-- The normal form for the amalgam `G(u, ℤⁿ)`, with the first letter in the second factor: every
element is `k * a₁ * ⋯ * aᵣ` with `k ∈ G` and letters `aⱼ` alternately in `C_G(u) × ℤⁿ` and in
`G`, none of them in `C_G(u)`. -/
private theorem exists_eq_of_mul_prod (x : CentralizerExt u n) :
    ∃ (k : G) (L : List (Σ b, CentralizerExtFactor u n b)),
      L.IsChain (fun l l' => l.1 ≠ l'.1) ∧ (∀ l ∈ L, l.2 ∉ (centralizerExtMap u n l.1).range) ∧
      (∀ l ∈ L.head?, l.1 = true) ∧
      x = of k * (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod := by
  obtain ⟨h, L, hc, hred, rfl⟩ :=
    Monoid.PushoutI.exists_eq_base_mul_list_prod (centralizerExtMap_injective u n) x
  rw [← Monoid.PushoutI.of_apply_eq_base _ false, ← of_def, centralizerExtMap_false,
    Subgroup.coe_subtype]
  rcases L with _ | ⟨⟨_ | _, a⟩, L⟩
  · exact ⟨h, [], hc, hred, by simp, rfl⟩
  · -- `show` retypes the letter `a : CentralizerExtFactor u n false` as an element of `G`.
    refine ⟨h * (show G from a), L, hc.tail, fun l hl => hred l (List.mem_cons_of_mem _ hl),
      fun l hl => ?_, ?_⟩
    · simpa using ((List.isChain_cons.1 hc).1 l hl).symm
    · simp only [of_def, List.map_cons, List.prod_cons, map_mul, mul_assoc]
  · exact ⟨h, _, hc, hred, by simp, rfl⟩

/-- If `k * a₁ * ⋯ * aᵣ` commutes with `u` in `G(u, ℤⁿ)`, for `k ∈ G` and a reduced word
`a₁ * ⋯ * aᵣ` starting in the factor `C_G(u) × ℤⁿ`, then `k` centralizes `u`. -/
private theorem mem_centralizer_of_commute_of_mul_prod (hG : IsCSA G)
    {L : List (Σ b, CentralizerExtFactor u n b)} (hc : L.IsChain fun l l' => l.1 ≠ l'.1)
    (hred : ∀ l ∈ L, l.2 ∉ (centralizerExtMap u n l.1).range) (hhead : ∀ l ∈ L.head?, l.1 = true)
    {k : G} (h : Commute (of k *
      (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod) (of u)) :
    k ∈ centralizer {u} := by
  by_contra hk
  have huu : u ∈ centralizer {u} := mem_centralizer_singleton_iff.2 rfl
  refine Monoid.PushoutI.list_prod_inv_mul_of_mul_list_prod_notMem_range_base
    (centralizerExtMap_injective u n) hc hred (i := false) (g := k⁻¹ * u * k) ?_
    (fun l hl => by simp [hhead l hl]) ⟨⟨u, huu⟩, ?_⟩
  · rintro ⟨c, hcu⟩
    rw [centralizerExtMap_false] at hcu
    exact hk (hG.mem_centralizer_of_conj_mem_centralizer (hcu ▸ c.2))
  · rw [← Monoid.PushoutI.of_apply_eq_base _ false, ← of_def, centralizerExtMap_false]
    simpa [mul_assoc] using h.inv_mul_cancel.symm

/-- A reduced word `a₁ * ⋯ * aᵣ` of `G(u, ℤⁿ)` that starts in the factor `C_G(u) × ℤⁿ` and
commutes with `u` lies in that factor. -/
private theorem prod_mem_range_ofProd (hG : IsCSA G)
    {L : List (Σ b, CentralizerExtFactor u n b)} (hc : L.IsChain fun l l' => l.1 ≠ l'.1)
    (hred : ∀ l ∈ L, l.2 ∉ (centralizerExtMap u n l.1).range) (hhead : ∀ l ∈ L.head?, l.1 = true)
    (h : Commute (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod
      (of u)) :
    (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod ∈
      (ofProd : _ →* CentralizerExt u n).range := by
  rcases L with _ | ⟨⟨_ | _, p⟩, L⟩
  · exact one_mem _
  · exact absurd (hhead _ rfl) (by simp)
  rcases L with _ | ⟨⟨_ | _, a⟩, L⟩
  · exact ⟨p, by simp [ofProd_def]⟩
  · -- The word continues with `a ∈ G ∖ C_G(u)`; as `p` commutes with `u`, so does the rest.
    simp only [List.map_cons, List.prod_cons, ← ofProd_def, ← of_def] at h
    have ha := mem_centralizer_of_commute_of_mul_prod hG hc.tail.tail
      (fun l hl => hred l (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hl)))
      (fun l hl => by simpa using ((List.isChain_cons.1 hc.tail).1 l hl).symm) (k := a)
      (by simpa using (commute_ofProd_of p).inv_left.mul_left h)
    exact absurd ⟨⟨a, ha⟩, by rw [centralizerExtMap_false]; rfl⟩
      (hred _ (List.mem_cons_of_mem _ List.mem_cons_self))
  · exact absurd (List.isChain_cons_cons.1 hc).1 (by simp)

/-- **The centralizer of the base element in an extension of centralizers.** For a CSA group `G`,
the centralizer of `u` in `G(u, ℤⁿ) = G ∗_{C_G(u)} (C_G(u) × ℤⁿ)` is the factor `C_G(u) × ℤⁿ`. -/
theorem centralizer_of_eq_range_ofProd (hG : IsCSA G) :
    centralizer {(of u : CentralizerExt u n)} = (ofProd : _ →* CentralizerExt u n).range := by
  refine le_antisymm (fun x hx => ?_) ?_
  · obtain ⟨k, L, hc, hred, hhead, rfl⟩ := exists_eq_of_mul_prod x
    have hx' : Commute (of k * (L.map fun l =>
        Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod) (of u) :=
      mem_centralizer_singleton_iff.1 hx
    have hk := mem_centralizer_of_commute_of_mul_prod hG hc hred hhead hx'
    have hku : Commute (of k : CentralizerExt u n) (of u) :=
      Commute.map (mem_centralizer_singleton_iff.1 hk) of
    exact mul_mem ⟨(⟨k, hk⟩, 1), ofProd_inl _⟩
      (prod_mem_range_ofProd hG hc hred hhead (by simpa using hku.inv_left.mul_left hx'))
  · rintro _ ⟨p, rfl⟩
    exact mem_centralizer_singleton_iff.2 (commute_ofProd_of p).eq

/-- For a CSA group `G`, the centralizer of `u` in `G(u, ℤⁿ)` is generated by `C_G(u)` and the new
letters. -/
theorem centralizer_of_eq_map_sup_closure (hG : IsCSA G) :
    centralizer {(of u : CentralizerExt u n)} =
      (centralizer {u}).map of ⊔ closure (Set.range t) := by
  rw [centralizer_of_eq_range_ofProd hG, range_ofProd]

/-- For a CSA group `G`, the centralizer of `u` in `G(u, ℤⁿ)` is `C_G(u) × ℤⁿ`. -/
noncomputable def centralizerEquiv (hG : IsCSA G) :
    centralizer {u} × (Fin n → Multiplicative ℤ) ≃* centralizer {(of u : CentralizerExt u n)} :=
  (MonoidHom.ofInjective ofProd_injective).trans
    (MulEquiv.subgroupCongr (centralizer_of_eq_range_ofProd hG).symm)

@[simp] theorem coe_centralizerEquiv_apply (hG : IsCSA G)
    (p : centralizer {u} × (Fin n → Multiplicative ℤ)) :
    (centralizerEquiv hG p : CentralizerExt u n) = ofProd p :=
  (rfl)

section FreeGroup

variable {α : Type*} (a : α)

/-- The centralizer of a basis element `a` of a free group `F` in `F(a, ℤⁿ)` is generated by `a`
and the new letters. For `n = 1` it is the subgroup `⟨a, t⟩` of `⟨F, t | [a, t] = 1⟩`. -/
theorem centralizer_of_freeGroup_of :
    centralizer {(of (FreeGroup.of a) : CentralizerExt (FreeGroup.of a) n)} =
      closure (insert (of (FreeGroup.of a)) (Set.range t)) := by
  rw [centralizer_of_eq_map_sup_closure IsFreeGroup.isCSA]
  -- `rw` cannot be used: the type of `of` mentions the centralizer being rewritten.
  simp only [IsFreeGroup.centralizer_singleton_eq_zpowers_self (FreeGroup.not_isProperPower_of a)]
  rw [zpowers_eq_closure, MonoidHom.map_closure, ← closure_union, Set.image_singleton,
    Set.singleton_union]

/-- The centralizer of a basis element `a` of a free group is infinite cyclic, generated by
`a`. -/
private noncomputable def zpowersEquivCentralizer :
    Multiplicative ℤ ≃* centralizer {FreeGroup.of a} :=
  (MonoidHom.ofInjective (f := zpowersHom _ (FreeGroup.of a)) fun _ _ h =>
    Multiplicative.toAdd.injective <| (injective_zpow_iff_not_isOfFinOrder.2 <|
      orderOf_eq_zero_iff.1 <| orderOf_eq_zero_iff'.2 fun _ hn =>
        (pow_eq_one_iff_left hn.ne').not.2 (FreeGroup.of_ne_one a)) h).trans
    (MulEquiv.subgroupCongr <| (range_zpowersHom _).trans
      (IsFreeGroup.centralizer_singleton_eq_zpowers_self (FreeGroup.not_isProperPower_of a)).symm)

/-- The centralizer of a basis element `a` of a free group `F` in `F(a, ℤⁿ)` is free abelian of
rank `n + 1`, on `a` and the new letters. For `n = 1` it is `⟨a, t⟩ ≅ ℤ²`. -/
noncomputable def centralizerFreeGroupOfEquiv (n : ℕ) :
    Multiplicative ℤ × (Fin n → Multiplicative ℤ) ≃*
      centralizer {(of (FreeGroup.of a) : CentralizerExt (FreeGroup.of a) n)} :=
  ((zpowersEquivCentralizer a).prodCongr (.refl _)).trans (centralizerEquiv IsFreeGroup.isCSA)

@[simp] theorem coe_centralizerFreeGroupOfEquiv_apply (k : Multiplicative ℤ)
    (v : Fin n → Multiplicative ℤ) :
    (centralizerFreeGroupOfEquiv a n (k, v) : CentralizerExt (FreeGroup.of a) n) =
      of (FreeGroup.of a) ^ k.toAdd * zpowersPiHom t commute_t_t v := by
  rw [← map_zpow]
  exact ofProd_apply _ v

end FreeGroup

end TauCeti.LimitGroup.CentralizerExt
