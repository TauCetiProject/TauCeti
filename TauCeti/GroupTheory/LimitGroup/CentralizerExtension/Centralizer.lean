/-!
# Centralizers in an extension of centralizers

Let `u` be an element of a group `G` such that `g⁻¹ * u * g ∈ C_G(u)` only for `g ∈ C_G(u)`, as
in every CSA group. In the extension `G(u, ℤⁿ) = G ∗_{C_G(u)} (C_G(u) × ℤⁿ)` of the centralizer
of `u`, the centralizer of `u` is exactly the second factor `C_G(u) × ℤⁿ`: it is generated by
`C_G(u)` and the new letters `t₀, …, tₙ₋₁`. So extending a centralizer enlarges that centralizer
by a free abelian direct factor of rank `n` and nothing else.

For an element `u` of a free group `F` that is not a proper power, such as a basis element,
`C_F(u) = ⟨u⟩`, so the centralizer of `u` in `F(u, ℤⁿ)` is the free abelian group of rank `n + 1`
on `u, t₀, …, tₙ₋₁`. For a basis element `a` and `n = 1` this is the subgroup `⟨a, t⟩ ≅ ℤ²` of
`⟨F, t | [a, t] = 1⟩`, so centralizers in fully residually free groups need not be cyclic.

For any group `G` and `b ∈ G`, an element of `G` commutes with `tᵢ b` in `G(u, ℤⁿ)` exactly when
it commutes with `u` and with `b`. So if `G` is commutative transitive (for instance CSA) and `u`
and `b` do not commute, no nontrivial element of `G` commutes with `tᵢ b`.

## Main definitions

* `TauCeti.LimitGroup.CentralizerExt.centralizerEquiv`: if `g⁻¹ * u * g ∈ C_G(u)` only for
  `g ∈ C_G(u)`, the isomorphism of `C_G(u) × ℤⁿ` with the centralizer of `u` in `G(u, ℤⁿ)`.
* `TauCeti.LimitGroup.CentralizerExt.centralizerEquivOfNotIsProperPower`: the isomorphism of
  `ℤ × ℤⁿ` with the centralizer of `u` in `F(u, ℤⁿ)`, for `u` in a free group `F` not a proper
  power.

## Main results

* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_eq_range_ofProd`: if `g⁻¹ * u * g ∈ C_G(u)`
  only for `g ∈ C_G(u)`, the centralizer of `u` in `G(u, ℤⁿ)` is the factor `C_G(u) × ℤⁿ`.
* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_eq_map_sup_closure`: it is generated by
  `C_G(u)` and the new letters.
* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_eq_closure_insert`: for `u` in a free group
  `F` not a proper power, the centralizer of `u` in `F(u, ℤⁿ)` is generated by `u` and the new
  letters.
* `TauCeti.LimitGroup.CentralizerExt.commute_of_t_mul_of_iff`: `G ∩ C(tᵢ b) = C_G(u) ∩ C_G(b)` in
  `G(u, ℤⁿ)`.
* `TauCeti.LimitGroup.CentralizerExt.eq_one_of_commute_t_mul_of`: `G ∩ C(tᵢ b) = 1` in
  `G(u, ℤⁿ)` when `G` is commutative transitive and `[u, b] ≠ 1`.

## Implementation notes

The centralizer of `u` is computed with the normal form for amalgamated products. Write an
element commuting with `u` as `k * a₁ * ⋯ * aᵣ` with `k ∈ G` and letters `aⱼ` alternately in
`(C_G(u) × ℤⁿ) ∖ C_G(u)` and in `G ∖ C_G(u)`, starting in the former. Then
`u = w⁻¹ * (k⁻¹ * u * k) * w` for `w = a₁ * ⋯ * aᵣ`; were `k⁻¹ * u * k` outside `C_G(u)`, the
right-hand side would be a reduced word of length `2 * r + 1`, which is not in `C_G(u)`. So
`k⁻¹ * u * k` commutes with `u`, and `k ∈ C_G(u)` by the hypothesis on `u` (in a CSA group,
because `C_G(u)` is malnormal). As `a₁` commutes with `u`, the same argument applied to
`a₂ * ⋯ * aᵣ` shows that `r ≤ 1`.

If `g ∈ G` commutes with `tᵢ b`, then `tᵢ⁻¹ g tᵢ = b g b⁻¹` lies in `G`. Sending `tᵢ` to the
letter `t` of `G(u, ℤ)` and the other letters to `1`, Britton's lemma in the HNN extension
`G(u, ℤ) = ⟨G, t | [c, t] = 1, c ∈ C_G(u)⟩` (`HNNExtension.inv_t_mul_of_mul_t_mem_range_iff`)
shows `g ∈ C_G(u)`. So `g` commutes with `tᵢ`, hence with `b`. Under commutative transitivity an
element commuting with two non-commuting elements is trivial.

## References

* O. Kharlampovich, A. Myasnikov, V. Remeslennikov, D. Serbin, *Subgroups of fully residually free
  groups: algorithmic problems*, Contemp. Math. 360 (2004), §5, Lemma 19.
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §2.5 and §7.2, Proposition 5.
* R. C. Lyndon, P. E. Schupp, *Combinatorial Group Theory*, Springer (1977), Chapter IV, §2
  (Britton's lemma).
-/

public section

open Group Subgroup

namespace TauCeti.LimitGroup.CentralizerExt

variable {G : Type*} [Group G] {u : G} {n : ℕ}

section Centralizer

variable (hu : ∀ g : G, g⁻¹ * u * g ∈ centralizer {u} → g ∈ centralizer {u})
include hu

/-- If `k * a₁ * ⋯ * aᵣ` commutes with `u` in `G(u, ℤⁿ)`, for `k ∈ G` and a reduced word
`a₁ * ⋯ * aᵣ` starting in the factor `C_G(u) × ℤⁿ`, then `k` centralizes `u`. -/
private theorem mem_centralizer_of_commute_of_mul_prod
    {L : List (Σ b, CentralizerExtFactor u n b)} (hc : L.IsChain fun l l' => l.1 ≠ l'.1)
    (hred : ∀ l ∈ L, l.2 ∉ (centralizerExtMap u n l.1).range) (hhead : ∀ l ∈ L.head?, l.1 = true)
    {k : G} (h : Commute (of k *
      (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod) (of u)) :
    k ∈ centralizer {u} := by
  by_contra hk
  have huu : u ∈ centralizer {u} := mem_centralizer_singleton_iff.2 rfl
  refine Monoid.PushoutI.list_prod_inv_mul_of_mul_list_prod_notMem_range_base
    (centralizerExtMap_injective u n) hc hred (i := false) (g := k⁻¹ * u * k) ?_
    (fun l hl => by simp [hhead l hl]) ⟨⟨u, huu⟩, ?_⟩
  · rintro ⟨c, hcu⟩
    rw [centralizerExtMap_false] at hcu
    exact hk (hu k (hcu ▸ c.property))
  · rw [← Monoid.PushoutI.of_apply_eq_base _ false, ← of_def, centralizerExtMap_false]
    simpa [mul_assoc] using h.inv_mul_cancel.symm

/-- A reduced word `a₁ * ⋯ * aᵣ` of `G(u, ℤⁿ)` that starts in the factor `C_G(u) × ℤⁿ` and
commutes with `u` lies in that factor. -/
private theorem prod_mem_range_ofProd
    {L : List (Σ b, CentralizerExtFactor u n b)} (hc : L.IsChain fun l l' => l.1 ≠ l'.1)
    (hred : ∀ l ∈ L, l.2 ∉ (centralizerExtMap u n l.1).range) (hhead : ∀ l ∈ L.head?, l.1 = true)
    (h : Commute (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod
      (of u)) :
    (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod ∈
      (ofProd : _ →* CentralizerExt u n).range := by
  rcases L with _ | ⟨⟨_ | _, p⟩, L⟩
  · exact one_mem _
  · exact absurd (hhead _ rfl) (by simp)
  rcases L with _ | ⟨⟨_ | _, a⟩, L⟩
  · exact ⟨p, by simp [ofProd_def]⟩
  · -- The word continues with `a ∈ G ∖ C_G(u)`; as `p` commutes with `u`, so does the rest.
    simp only [List.map_cons, List.prod_cons, ← ofProd_def, ← of_def] at h
    have ha := mem_centralizer_of_commute_of_mul_prod hu hc.tail.tail
      (fun l hl => hred l (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hl)))
      (fun l hl => by simpa using ((List.isChain_cons.1 hc.tail).1 l hl).symm) (k := a)
      (by simpa using (commute_ofProd_of p).inv_left.mul_left h)
    exact absurd ⟨⟨a, ha⟩, by simp⟩
      (hred _ (List.mem_cons_of_mem _ List.mem_cons_self))
  · exact absurd (List.isChain_cons_cons.1 hc).1 (by simp)

/-- **The centralizer of the base element in an extension of centralizers.** If every `g` with
`g⁻¹ * u * g` commuting with `u` centralizes `u` (for instance in a CSA group), the centralizer of
`u` in `G(u, ℤⁿ) = G ∗_{C_G(u)} (C_G(u) × ℤⁿ)` is the factor `C_G(u) × ℤⁿ`. -/
theorem centralizer_of_eq_range_ofProd :
    centralizer {(of u : CentralizerExt u n)} = (ofProd : _ →* CentralizerExt u n).range := by
  refine le_antisymm (fun x hx => ?_) ?_
  · obtain ⟨k, L, hc, hred, hhead, rfl⟩ := exists_eq_of_mul_list_prod x
    have hx' : Commute (of k * (L.map fun l =>
        Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod) (of u) :=
      (commute_iff_eq _ _).2 (mem_centralizer_singleton_iff.1 hx)
    have hk := mem_centralizer_of_commute_of_mul_prod hu hc hred hhead hx'
    have hku : Commute (of k : CentralizerExt u n) (of u) :=
      ((commute_iff_eq _ _).2 (mem_centralizer_singleton_iff.1 hk)).map of
    exact mul_mem ⟨(⟨k, hk⟩, 1), ofProd_inl _⟩
      (prod_mem_range_ofProd hu hc hred hhead (by simpa using hku.inv_left.mul_left hx'))
  · rintro _ ⟨p, rfl⟩
    exact mem_centralizer_singleton_iff.2 (commute_ofProd_of p).eq

/-- If every `g` with `g⁻¹ * u * g` commuting with `u` centralizes `u` (for instance in a CSA
group), the centralizer of `u` in `G(u, ℤⁿ)` is generated by `C_G(u)` and the new letters. -/
theorem centralizer_of_eq_map_sup_closure :
    centralizer {(of u : CentralizerExt u n)} =
      (centralizer {u}).map of ⊔ closure (Set.range t) :=
  (centralizer_of_eq_range_ofProd hu).trans range_ofProd

/-- If every `g` with `g⁻¹ * u * g` commuting with `u` centralizes `u` (for instance in a CSA
group), the centralizer of `u` in `G(u, ℤⁿ)` is `C_G(u) × ℤⁿ`. -/
noncomputable def centralizerEquiv :
    centralizer {u} × (Fin n → Multiplicative ℤ) ≃* centralizer {(of u : CentralizerExt u n)} :=
  (MonoidHom.ofInjective ofProd_injective).trans
    (MulEquiv.subgroupCongr (centralizer_of_eq_range_ofProd hu).symm)

@[simp] theorem coe_centralizerEquiv_apply (p : centralizer {u} × (Fin n → Multiplicative ℤ)) :
    (centralizerEquiv hu p : CentralizerExt u n) = ofProd p :=
  (rfl)

@[simp] theorem centralizerEquiv_symm_apply_ofProd
    (p : centralizer {u} × (Fin n → Multiplicative ℤ))
    (hp : (ofProd p : CentralizerExt u n) ∈ centralizer {of u}) :
    (centralizerEquiv hu).symm ⟨ofProd p, hp⟩ = p :=
  (centralizerEquiv hu).symm_apply_eq.2 (Subtype.ext (coe_centralizerEquiv_apply hu p).symm)

@[simp] theorem centralizerEquiv_symm_apply_of (c : centralizer {u})
    (hc : (of (c : G) : CentralizerExt u n) ∈ centralizer {of u}) :
    (centralizerEquiv hu).symm ⟨of (c : G), hc⟩ = (c, 1) :=
  (centralizerEquiv hu).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem centralizerEquiv_symm_apply_t (i : Fin n)
    (ht : (t i : CentralizerExt u n) ∈ centralizer {of u}) :
    (centralizerEquiv hu).symm ⟨t i, ht⟩ = (1, Pi.mulSingle i (.ofAdd 1)) :=
  (centralizerEquiv hu).symm_apply_eq.2 (Subtype.ext (by simp))

end Centralizer

section CommuteTMulOf

/-- In the extension `G(u, ℤⁿ)` of the centralizer of `u`, an element of `G` commutes with `tᵢ b`
exactly when it commutes with both `u` and `b`. -/
@[simp] theorem commute_of_t_mul_of_iff {b : G} {i : Fin n} {g : G} :
    Commute (of g : CentralizerExt u n) (t i * of b) ↔ Commute g u ∧ Commute g b := by
  refine ⟨fun hg ↦ ?_, fun ⟨hgu, hgb⟩ ↦
    (commute_of_t (mem_centralizer_singleton_iff.2 hgu) i).mul_right (hgb.map of)⟩
  -- Send `tᵢ` to the letter of `G(u, ℤ)` and the other letters to `1`.
  let π : CentralizerExt u n →* CentralizerExt u 1 :=
    lift of (fun j ↦ if j = i then t 0 else 1) (fun _ _ ↦ by split_ifs <;> simp)
      fun c hc _ ↦ by split_ifs <;> simp [commute_of_t hc]
  have h1 := (hg.map π).map (equivHNNExtension (u := u))
  simp only [π, map_mul, lift_of, lift_t, ↓reduceIte, equivHNNExtension_of,
    equivHNNExtension_t] at h1
  -- Britton's lemma: `t⁻¹ g t = b g b⁻¹` lies in `G`, so `g ∈ C_G(u)`.
  have hgu : g ∈ centralizer {u} := (HNNExtension.inv_t_mul_of_mul_t_mem_range_iff
      (φ := .refl (centralizer {u}))).1 ⟨b * g * b⁻¹, by
    rw [map_mul, map_mul, map_inv, mul_inv_eq_iff_eq_mul, mul_assoc _ HNNExtension.t, mul_assoc,
      h1.eq]
    group⟩
  -- So `g` commutes with `tᵢ`, hence with `b`.
  have hgb : Commute (of g : CentralizerExt u n) (of b) := by
    simpa using (commute_of_t hgu i).inv_right.mul_right hg
  exact ⟨mem_centralizer_singleton_iff.1 hgu, hgb.of_map of_injective⟩

/-- In the extension `G(u, ℤⁿ)` of the centralizer of `u` in a commutative-transitive group `G`
(for instance a CSA group), an element of `G` commuting with `tᵢ b` is trivial when `u` and `b` do
not commute. -/
theorem eq_one_of_commute_t_mul_of (hG : IsCommTransitive G) {b : G} (hub : ¬Commute u b)
    {i : Fin n} {g : G} (hg : Commute (of g : CentralizerExt u n) (t i * of b)) : g = 1 := by
  obtain ⟨hgu, hgb⟩ := commute_of_t_mul_of_iff.1 hg
  by_contra hg1
  exact hub ((isCommTransitive_iff G).1 hG u g b hg1 hgu.symm hgb)

end CommuteTMulOf

section IsFreeGroup

variable {F : Type*} [Group F] [IsFreeGroup F] {u : F}

/-- For an element `u` of a free group `F` that is not a proper power, the centralizer of `u` in
`F(u, ℤⁿ)` is generated by `u` and the new letters. For a basis element `a` and `n = 1` it is the
subgroup `⟨a, t⟩` of `⟨F, t | [a, t] = 1⟩`. -/
theorem centralizer_of_eq_closure_insert (hu : ¬IsProperPower u) :
    centralizer {(of u : CentralizerExt u n)} = closure (insert (of u) (Set.range t)) := by
  rw [centralizer_of_eq_map_sup_closure fun _ =>
    IsFreeGroup.isCSA.mem_centralizer_of_conj_mem_centralizer]
  -- `rw` cannot be used: the type of `of` mentions the centralizer being rewritten.
  simp only [IsFreeGroup.centralizer_singleton_eq_zpowers_self hu]
  rw [zpowers_eq_closure, MonoidHom.map_closure, ← closure_union, Set.image_singleton,
    Set.singleton_union]

/-- For an element `u` of a free group `F` that is not a proper power, the centralizer of `u` in
`F(u, ℤⁿ)` is free abelian of rank `n + 1`, on `u` and the new letters. For a basis element `a`
and `n = 1` it is `⟨a, t⟩ ≅ ℤ²`. -/
noncomputable def centralizerEquivOfNotIsProperPower (hu : ¬IsProperPower u) :
    Multiplicative ℤ × (Fin n → Multiplicative ℤ) ≃* centralizer {(of u : CentralizerExt u n)} :=
  ((IsFreeGroup.intEquivCentralizer hu).prodCongr (.refl _)).trans
    (centralizerEquiv fun _ => IsFreeGroup.isCSA.mem_centralizer_of_conj_mem_centralizer)

@[simp] theorem coe_centralizerEquivOfNotIsProperPower_apply (hu : ¬IsProperPower u)
    (p : Multiplicative ℤ × (Fin n → Multiplicative ℤ)) :
    (centralizerEquivOfNotIsProperPower hu p : CentralizerExt u n) =
      of u ^ p.1.toAdd * zpowersPiHom t commute_t_t p.2 := by
  rw [← map_zpow, ← IsFreeGroup.coe_intEquivCentralizer_apply hu, ← ofProd_apply]
  -- By definition the left side is `ofProd (intEquivCentralizer hu p.1, p.2)`; Mathlib has no
  -- evaluation lemma for `MulEquiv.prodCongr`.
  rfl

@[simp] theorem centralizerEquivOfNotIsProperPower_symm_apply_of_zpow (hu : ¬IsProperPower u)
    (k : ℤ) (hk : (of u : CentralizerExt u n) ^ k ∈ centralizer {of u}) :
    (centralizerEquivOfNotIsProperPower hu).symm ⟨of u ^ k, hk⟩ = (.ofAdd k, 1) :=
  (centralizerEquivOfNotIsProperPower hu).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem centralizerEquivOfNotIsProperPower_symm_apply_of (hu : ¬IsProperPower u)
    (hk : (of u : CentralizerExt u n) ∈ centralizer {of u}) :
    (centralizerEquivOfNotIsProperPower hu).symm ⟨of u, hk⟩ = (.ofAdd 1, 1) :=
  (centralizerEquivOfNotIsProperPower hu).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem centralizerEquivOfNotIsProperPower_symm_apply_t (hu : ¬IsProperPower u)
    (i : Fin n) (ht : (t i : CentralizerExt u n) ∈ centralizer {of u}) :
    (centralizerEquivOfNotIsProperPower hu).symm ⟨t i, ht⟩ = (1, Pi.mulSingle i (.ofAdd 1)) :=
  (centralizerEquivOfNotIsProperPower hu).symm_apply_eq.2 (Subtype.ext (by simp))

end IsFreeGroup

end TauCeti.LimitGroup.CentralizerExt
