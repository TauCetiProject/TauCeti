/-!
# The centralizer of the base element in an extension of centralizers

Let `G` be a CSA group and `u : G`. In the extension `G(u, ℤⁿ) = G ∗_{C_G(u)} (C_G(u) × ℤⁿ)` of the
centralizer of `u`, the centralizer of `u` is exactly the second factor `C_G(u) × ℤⁿ`: it is
generated by `C_G(u)` and the new letters `t₀, …, tₙ₋₁`. So extending a centralizer enlarges
that centralizer by a free abelian direct factor of rank `n` and nothing else.

For an element `u` of a free group `F` that is not a proper power, such as a basis element,
`C_F(u) = ⟨u⟩`, so the centralizer of `u` in `F(u, ℤⁿ)` is the free abelian group of rank `n + 1`
on `u, t₀, …, tₙ₋₁`. For a basis element `a` and `n = 1` this is the subgroup `⟨a, t⟩ ≅ ℤ²` of
`⟨F, t | [a, t] = 1⟩`, so centralizers in fully residually free groups need not be cyclic.

## Main definitions

* `TauCeti.LimitGroup.CentralizerExt.prodEquivCentralizer`: for a CSA group `G`, the isomorphism
  of `C_G(u) × ℤⁿ` with the centralizer of `u` in `G(u, ℤⁿ)`.
* `TauCeti.LimitGroup.CentralizerExt.intProdEquivCentralizer`: the isomorphism of `ℤ × ℤⁿ` with
  the centralizer of `u` in `F(u, ℤⁿ)`, for `u` in a free group `F` not a proper power.

## Main results

* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_eq_range_ofProd`: for a CSA group `G`, the
  centralizer of `u` in `G(u, ℤⁿ)` is the factor `C_G(u) × ℤⁿ`.
* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_eq_map_sup_closure`: it is generated by
  `C_G(u)` and the new letters.
* `TauCeti.LimitGroup.CentralizerExt.centralizer_of_eq_closure_insert`: for `u` in a free group
  `F` not a proper power, the centralizer of `u` in `F(u, ℤⁿ)` is generated by `u` and the new
  letters.

## Implementation notes

The proof uses the normal form for amalgamated products. Write an element commuting with `u` as
`k * a₁ * ⋯ * aᵣ` with `k ∈ G` and letters `aⱼ` alternately in `(C_G(u) × ℤⁿ) ∖ C_G(u)` and in
`G ∖ C_G(u)`, starting in the former. Then `u = w⁻¹ * (k⁻¹ * u * k) * w` for `w = a₁ * ⋯ * aᵣ`;
were `k⁻¹ * u * k` outside `C_G(u)`, the right-hand side would be a reduced word of length
`2 * r + 1`, which is not in `C_G(u)`. So `k⁻¹ * u * k` commutes with `u`, and `k ∈ C_G(u)` because
`C_G(u)` is malnormal. As `a₁` commutes with `u`, the same argument applied to `a₂ * ⋯ * aᵣ` shows
that `r ≤ 1`.

## References

* O. Kharlampovich, A. Myasnikov, V. Remeslennikov, D. Serbin, *Subgroups of fully residually free
  groups: algorithmic problems*, Contemp. Math. 360 (2004), §5, Lemma 19.
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §2.5.
-/

public section

open Group Subgroup

namespace TauCeti.LimitGroup.CentralizerExt

variable {G : Type*} [Group G] {u : G} {n : ℕ}

/-- If `k * a₁ * ⋯ * aᵣ` commutes with `u` in `G(u, ℤⁿ)`, for `k ∈ G` and a reduced word
`a₁ * ⋯ * aᵣ` starting in the factor `C_G(u) × ℤⁿ`, then `k` centralizes `u`. -/
private theorem mem_centralizer_of_commute_of_mul_prod (hG : IsCSA G)
    {L : List (Σ b, CentralizerExtFactor u n b)} (hc : L.IsChain fun l l' => l.1 ≠ l'.1)
    (hred : ∀ l ∈ L, l.2 ∉ (centralizerExtMap u n l.1).range) (hhead : ∀ l ∈ L.head?, l.1 = true)
    {k : G} (h : Commute (of k *
      (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod) (of u)) :
    k ∈ centralizer {u} := by
  by_contra hk
  have huu : u ∈ centralizer {u} := mem_centralizer_singleton_iff.2 rfl
  refine Monoid.PushoutI.list_prod_inv_mul_of_mul_list_prod_notMem_range_base
    (centralizerExtMap_injective u n) hc hred (i := false) (g := k⁻¹ * u * k) ?_
    (fun l hl => by simp [hhead l hl]) ⟨⟨u, huu⟩, ?_⟩
  · rintro ⟨c, hcu⟩
    rw [centralizerExtMap_false] at hcu
    exact hk (hG.mem_centralizer_of_conj_mem_centralizer (hcu ▸ c.2))
  · rw [← Monoid.PushoutI.of_apply_eq_base _ false, ← of_def, centralizerExtMap_false]
    simpa [mul_assoc] using h.inv_mul_cancel.symm

/-- A reduced word `a₁ * ⋯ * aᵣ` of `G(u, ℤⁿ)` that starts in the factor `C_G(u) × ℤⁿ` and
commutes with `u` lies in that factor. -/
private theorem prod_mem_range_ofProd (hG : IsCSA G)
    {L : List (Σ b, CentralizerExtFactor u n b)} (hc : L.IsChain fun l l' => l.1 ≠ l'.1)
    (hred : ∀ l ∈ L, l.2 ∉ (centralizerExtMap u n l.1).range) (hhead : ∀ l ∈ L.head?, l.1 = true)
    (h : Commute (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod
      (of u)) :
    (L.map fun l => Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod ∈
      (ofProd : _ →* CentralizerExt u n).range := by
  rcases L with _ | ⟨⟨_ | _, p⟩, L⟩
  · exact one_mem _
  · exact absurd (hhead _ rfl) (by simp)
  rcases L with _ | ⟨⟨_ | _, a⟩, L⟩
  · exact ⟨p, by simp [ofProd_def]⟩
  · -- The word continues with `a ∈ G ∖ C_G(u)`; as `p` commutes with `u`, so does the rest.
    simp only [List.map_cons, List.prod_cons, ← ofProd_def, ← of_def] at h
    have ha := mem_centralizer_of_commute_of_mul_prod hG hc.tail.tail
      (fun l hl => hred l (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hl)))
      (fun l hl => by simpa using ((List.isChain_cons.1 hc.tail).1 l hl).symm) (k := a)
      (by simpa using (commute_ofProd_of p).inv_left.mul_left h)
    exact absurd ⟨⟨a, ha⟩, by simp⟩
      (hred _ (List.mem_cons_of_mem _ List.mem_cons_self))
  · exact absurd (List.isChain_cons_cons.1 hc).1 (by simp)

/-- **The centralizer of the base element in an extension of centralizers.** For a CSA group `G`,
the centralizer of `u` in `G(u, ℤⁿ) = G ∗_{C_G(u)} (C_G(u) × ℤⁿ)` is the factor `C_G(u) × ℤⁿ`. -/
theorem centralizer_of_eq_range_ofProd (hG : IsCSA G) :
    centralizer {(of u : CentralizerExt u n)} = (ofProd : _ →* CentralizerExt u n).range := by
  refine le_antisymm (fun x hx => ?_) ?_
  · obtain ⟨k, L, hc, hred, hhead, rfl⟩ := exists_eq_of_mul_list_prod x
    have hx' : Commute (of k * (L.map fun l =>
        Monoid.PushoutI.of (φ := centralizerExtMap u n) l.1 l.2).prod) (of u) :=
      (commute_iff_eq _ _).2 (mem_centralizer_singleton_iff.1 hx)
    have hk := mem_centralizer_of_commute_of_mul_prod hG hc hred hhead hx'
    have hku : Commute (of k : CentralizerExt u n) (of u) :=
      ((commute_iff_eq _ _).2 (mem_centralizer_singleton_iff.1 hk)).map of
    exact mul_mem ⟨(⟨k, hk⟩, 1), ofProd_inl _⟩
      (prod_mem_range_ofProd hG hc hred hhead (by simpa using hku.inv_left.mul_left hx'))
  · rintro _ ⟨p, rfl⟩
    exact mem_centralizer_singleton_iff.2 (commute_ofProd_of p).eq

/-- For a CSA group `G`, the centralizer of `u` in `G(u, ℤⁿ)` is generated by `C_G(u)` and the new
letters. -/
theorem centralizer_of_eq_map_sup_closure (hG : IsCSA G) :
    centralizer {(of u : CentralizerExt u n)} =
      (centralizer {u}).map of ⊔ closure (Set.range t) := by
  rw [centralizer_of_eq_range_ofProd hG, range_ofProd]

/-- For a CSA group `G`, the centralizer of `u` in `G(u, ℤⁿ)` is `C_G(u) × ℤⁿ`. -/
noncomputable def prodEquivCentralizer (hG : IsCSA G) :
    centralizer {u} × (Fin n → Multiplicative ℤ) ≃* centralizer {(of u : CentralizerExt u n)} :=
  (MonoidHom.ofInjective ofProd_injective).trans
    (MulEquiv.subgroupCongr (centralizer_of_eq_range_ofProd hG).symm)

@[simp] theorem coe_prodEquivCentralizer_apply (hG : IsCSA G)
    (p : centralizer {u} × (Fin n → Multiplicative ℤ)) :
    (prodEquivCentralizer hG p : CentralizerExt u n) = ofProd p := by
  simp [prodEquivCentralizer, MonoidHom.ofInjective_apply]

@[simp] theorem prodEquivCentralizer_symm_apply_ofProd (hG : IsCSA G)
    (p : centralizer {u} × (Fin n → Multiplicative ℤ))
    (hp : (ofProd p : CentralizerExt u n) ∈ centralizer {of u}) :
    (prodEquivCentralizer hG).symm ⟨ofProd p, hp⟩ = p :=
  (prodEquivCentralizer hG).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem prodEquivCentralizer_symm_apply_of (hG : IsCSA G) (g : G)
    (hg : (of g : CentralizerExt u n) ∈ centralizer {of u}) :
    (prodEquivCentralizer hG).symm ⟨of g, hg⟩ = (⟨g, of_mem_centralizer_of_iff.1 hg⟩, 1) :=
  (prodEquivCentralizer hG).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem prodEquivCentralizer_symm_apply_zpowersPiHom (hG : IsCSA G)
    (v : Fin n → Multiplicative ℤ)
    (hv : (zpowersPiHom t commute_t_t v : CentralizerExt u n) ∈ centralizer {of u}) :
    (prodEquivCentralizer hG).symm ⟨zpowersPiHom t commute_t_t v, hv⟩ = (1, v) :=
  (prodEquivCentralizer hG).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem prodEquivCentralizer_symm_apply_t (hG : IsCSA G) (i : Fin n)
    (ht : (t i : CentralizerExt u n) ∈ centralizer {of u}) :
    (prodEquivCentralizer hG).symm ⟨t i, ht⟩ = (1, Pi.mulSingle i (.ofAdd 1)) :=
  (prodEquivCentralizer hG).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem prodEquivCentralizer_symm_apply_inv (hG : IsCSA G) (x : CentralizerExt u n)
    (hx : x⁻¹ ∈ centralizer {of u}) :
    (prodEquivCentralizer hG).symm ⟨x⁻¹, hx⟩ =
      ((prodEquivCentralizer hG).symm ⟨x, inv_mem_iff.1 hx⟩)⁻¹ :=
  (prodEquivCentralizer hG).symm_apply_eq.2 (Subtype.ext (by simp))

section IsFreeGroup

variable {F : Type*} [Group F] [IsFreeGroup F] {u : F}

/-- For an element `u` of a free group `F` that is not a proper power, the centralizer of `u` in
`F(u, ℤⁿ)` is generated by `u` and the new letters. For a basis element `a` and `n = 1` it is the
subgroup `⟨a, t⟩` of `⟨F, t | [a, t] = 1⟩`. -/
theorem centralizer_of_eq_closure_insert (hu : ¬IsProperPower u) :
    centralizer {(of u : CentralizerExt u n)} = closure (insert (of u) (Set.range t)) := by
  rw [centralizer_of_eq_map_sup_closure IsFreeGroup.isCSA]
  -- `rw` cannot be used: the type of `of` mentions the centralizer being rewritten.
  simp only [IsFreeGroup.centralizer_singleton_eq_zpowers_self hu]
  rw [zpowers_eq_closure, MonoidHom.map_closure, ← closure_union, Set.image_singleton,
    Set.singleton_union]

/-- For an element `u` of a free group `F` that is not a proper power, the centralizer of `u` in
`F(u, ℤⁿ)` is free abelian of rank `n + 1`, on `u` and the new letters. For a basis element `a`
and `n = 1` it is `⟨a, t⟩ ≅ ℤ²`. -/
noncomputable def intProdEquivCentralizer (hu : ¬IsProperPower u) :
    Multiplicative ℤ × (Fin n → Multiplicative ℤ) ≃* centralizer {(of u : CentralizerExt u n)} :=
  ((IsFreeGroup.intEquivCentralizer hu).prodCongr (.refl _)).trans
    (prodEquivCentralizer IsFreeGroup.isCSA)

@[simp] theorem coe_intProdEquivCentralizer_apply (hu : ¬IsProperPower u)
    (p : Multiplicative ℤ × (Fin n → Multiplicative ℤ)) :
    (intProdEquivCentralizer hu p : CentralizerExt u n) =
      of u ^ p.1.toAdd * zpowersPiHom t commute_t_t p.2 := by
  simp [intProdEquivCentralizer, ofProd_apply]

@[simp] theorem intProdEquivCentralizer_symm_apply_ofProd (hu : ¬IsProperPower u)
    (p : centralizer {u} × (Fin n → Multiplicative ℤ))
    (hp : (ofProd p : CentralizerExt u n) ∈ centralizer {of u}) :
    (intProdEquivCentralizer hu).symm ⟨ofProd p, hp⟩ =
      ((IsFreeGroup.intEquivCentralizer hu).symm p.1, p.2) := by
  simp [intProdEquivCentralizer]

@[simp] theorem intProdEquivCentralizer_symm_apply_of (hu : ¬IsProperPower u) (g : F)
    (hg : (of g : CentralizerExt u n) ∈ centralizer {of u}) :
    (intProdEquivCentralizer hu).symm ⟨of g, hg⟩ =
      ((IsFreeGroup.intEquivCentralizer hu).symm ⟨g, of_mem_centralizer_of_iff.1 hg⟩, 1) := by
  simp [intProdEquivCentralizer]

@[simp] theorem intProdEquivCentralizer_symm_apply_zpowersPiHom (hu : ¬IsProperPower u)
    (v : Fin n → Multiplicative ℤ)
    (hv : (zpowersPiHom t commute_t_t v : CentralizerExt u n) ∈ centralizer {of u}) :
    (intProdEquivCentralizer hu).symm ⟨zpowersPiHom t commute_t_t v, hv⟩ = (1, v) := by
  simp [intProdEquivCentralizer]

@[simp] theorem intProdEquivCentralizer_symm_apply_t (hu : ¬IsProperPower u) (i : Fin n)
    (ht : (t i : CentralizerExt u n) ∈ centralizer {of u}) :
    (intProdEquivCentralizer hu).symm ⟨t i, ht⟩ = (1, Pi.mulSingle i (.ofAdd 1)) := by
  simp [intProdEquivCentralizer]

@[simp] theorem intProdEquivCentralizer_symm_apply_inv (hu : ¬IsProperPower u)
    (x : CentralizerExt u n) (hx : x⁻¹ ∈ centralizer {of u}) :
    (intProdEquivCentralizer hu).symm ⟨x⁻¹, hx⟩ =
      ((intProdEquivCentralizer hu).symm ⟨x, inv_mem_iff.1 hx⟩)⁻¹ :=
  (intProdEquivCentralizer hu).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem intProdEquivCentralizer_symm_apply_of_zpow_mul_zpowersPiHom
    (hu : ¬IsProperPower u) (k : ℤ) (v : Fin n → Multiplicative ℤ)
    (h : (of u ^ k * zpowersPiHom t commute_t_t v : CentralizerExt u n) ∈ centralizer {of u}) :
    (intProdEquivCentralizer hu).symm ⟨of u ^ k * zpowersPiHom t commute_t_t v, h⟩ =
      (.ofAdd k, v) :=
  (intProdEquivCentralizer hu).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem intProdEquivCentralizer_symm_apply_of_zpow (hu : ¬IsProperPower u) (k : ℤ)
    (hk : (of u : CentralizerExt u n) ^ k ∈ centralizer {of u}) :
    (intProdEquivCentralizer hu).symm ⟨of u ^ k, hk⟩ = (.ofAdd k, 1) :=
  (intProdEquivCentralizer hu).symm_apply_eq.2 (Subtype.ext (by simp))

@[simp] theorem intProdEquivCentralizer_symm_apply_of_pow (hu : ¬IsProperPower u) (m : ℕ)
    (hm : (of u : CentralizerExt u n) ^ m ∈ centralizer {of u}) :
    (intProdEquivCentralizer hu).symm ⟨of u ^ m, hm⟩ = (.ofAdd ↑m, 1) :=
  (intProdEquivCentralizer hu).symm_apply_eq.2 (Subtype.ext (by simp))

end IsFreeGroup

end TauCeti.LimitGroup.CentralizerExt
