module

public import TauCeti.GroupTheory.LimitGroup.CentralizerExtension.FreeProduct
import TauCeti.GroupTheory.FreeGroup.CSA

/-!
# Free letters in extensions of centralizers

Let `G` be a group, `a, b ∈ G` and `G(a, ℤᵐ) = G ∗_{C_G(a)} (C_G(a) × ℤᵐ)` the extension of the
centralizer of `a`, with new letters `t₀, …, tₘ₋₁`. An element of `G` commutes with `tⱼ b` exactly
when it commutes with `a` and with `b` (`commute_of_t_mul_of_iff`). So if `G` is commutative
transitive (for instance CSA) and `a` and `b` do not commute, no nontrivial element of `G` commutes
with `tⱼ b` (`eq_one_of_commute_t_mul_of`). Consequently, when the centralizer of `tⱼ b` in
`G(a, ℤᵐ)` is extended in turn, each of its new letters `sᵢ` is free over `G`: the subgroup of
`G(a, ℤᵐ)(tⱼ b, ℤⁿ)` generated by `G` and `sᵢ` is the free product `G ∗ ⟨sᵢ⟩`
(`coprodLift_injective_of_not_commute`, a special case of
`CentralizerExt.coprodLift_injective_of_forall_mem_centralizer`). For instance, in
`F(a, b)(a, t)(t b, s)` the letter `s` is free over `F(a, b)`.

These are the first steps of the normal-form argument showing that the extensions of centralizers
built from a solution of a one-commutator equation `[x, y] = [a, b]` over a CSA group embed its
coordinate group ([IFT], §7.2, Proposition 5, Case 1).

## Main results

* `TauCeti.LimitGroup.CentralizerExt.commute_of_t_mul_of_iff`: `G ∩ C(tⱼ b) = C_G(a) ∩ C_G(b)` in
  `G(a, ℤᵐ)`.
* `TauCeti.LimitGroup.CentralizerExt.eq_one_of_commute_t_mul_of`: `G ∩ C(tⱼ b) = 1` in
  `G(a, ℤᵐ)` when `G` is commutative transitive and `[a, b] ≠ 1`.
* `TauCeti.LimitGroup.CentralizerExt.coprodLift_injective_of_not_commute`: `G ∗ ⟨sᵢ⟩` embeds in
  `G(a, ℤᵐ)(tⱼ b, ℤⁿ)`.

## Implementation notes

If `g ∈ G` commutes with `tⱼ b`, then `tⱼ⁻¹ g tⱼ = b g b⁻¹` lies in `G`. Sending `tⱼ` to the
letter `t` of `G(a, ℤ)` and the other letters to `1`, Britton's lemma in the HNN extension
`G(a, ℤ) = ⟨G, t | [c, t] = 1, c ∈ C_G(a)⟩` (`HNNExtension.inv_t_mul_of_mul_t_mem_range_iff`)
shows `g ∈ C_G(a)`. So `g` commutes with `tⱼ`, hence with `b`. Under commutative transitivity an
element commuting with two non-commuting elements is trivial.

## References

* [IFT] O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra
  290 (2005), §7.2, Proposition 5.
* R. C. Lyndon, P. E. Schupp, *Combinatorial Group Theory*, Springer (1977), Chapter IV, §2
  (Britton's lemma).
-/

public section

open Group Subgroup

namespace TauCeti.LimitGroup.CentralizerExt

variable {G : Type*} [Group G]

/-- In the extension `G(a, ℤⁿ)` of the centralizer of `a`, an element of `G` commutes with `tᵢ b`
exactly when it commutes with both `a` and `b`. -/
theorem commute_of_t_mul_of_iff {a b : G} {n : ℕ} {i : Fin n} {g : G} :
    Commute (of g : CentralizerExt a n) (t i * of b) ↔ Commute g a ∧ Commute g b := by
  refine ⟨fun hg ↦ ?_, fun ⟨hga, hgb⟩ ↦
    (commute_of_t (mem_centralizer_singleton_iff.2 hga) i).mul_right (hgb.map of)⟩
  -- Send `tᵢ` to the letter of `G(a, ℤ)` and the other letters to `1`.
  let π : CentralizerExt a n →* CentralizerExt a 1 :=
    lift of (fun j ↦ if j = i then t 0 else 1) (fun _ _ ↦ by split_ifs <;> simp)
      fun c hc _ ↦ by split_ifs <;> simp [commute_of_t hc]
  have h1 := (hg.map π).map (equivHNNExtension (u := a))
  simp only [π, map_mul, lift_of, lift_t, ↓reduceIte, equivHNNExtension_of,
    equivHNNExtension_t] at h1
  -- Britton's lemma: `t⁻¹ g t = b g b⁻¹` lies in `G`, so `g ∈ C_G(a)`.
  have hga : g ∈ centralizer {a} := (HNNExtension.inv_t_mul_of_mul_t_mem_range_iff
      (φ := .refl (centralizer {a}))).1 ⟨b * g * b⁻¹, by
    rw [map_mul, map_mul, map_inv, mul_inv_eq_iff_eq_mul, mul_assoc _ HNNExtension.t, mul_assoc,
      h1.eq]
    group⟩
  -- So `g` commutes with `tᵢ`, hence with `b`.
  have hgb : Commute (of g : CentralizerExt a n) (of b) := by
    simpa using (commute_of_t hga i).inv_right.mul_right hg
  exact ⟨mem_centralizer_singleton_iff.1 hga, hgb.of_map of_injective⟩

/-- In the extension `G(a, ℤⁿ)` of the centralizer of `a` in a commutative-transitive group `G`
(for instance a CSA group), an element of `G` commuting with `tᵢ b` is trivial when `a` and `b` do
not commute. -/
theorem eq_one_of_commute_t_mul_of (hG : IsCommTransitive G) {a b : G} (hab : ¬Commute a b) {n : ℕ}
    {i : Fin n} {g : G} (hg : Commute (of g : CentralizerExt a n) (t i * of b)) : g = 1 := by
  obtain ⟨hga, hgb⟩ := commute_of_t_mul_of_iff.1 hg
  by_contra hg1
  exact hab ((isCommTransitive_iff G).1 hG a g b hg1 hga.symm hgb)

/-- **A free letter over `G`.** Let `G` be commutative transitive and `a, b ∈ G` not commuting.
In the extension of the centralizer of `tⱼ b` in `G(a, ℤᵐ)` by `ℤⁿ`, each new letter `sᵢ` is free
over `G`: the homomorphism `G ∗ ⟨z⟩ →* G(a, ℤᵐ)(tⱼ b, ℤⁿ)` that is the inclusion on `G` and sends
`z` to `sᵢ` is injective. -/
theorem coprodLift_injective_of_not_commute (hG : IsCommTransitive G) {a b : G} (hab : ¬Commute a b)
    {m n : ℕ} (j : Fin m) (i : Fin n) : Function.Injective (Monoid.Coprod.lift
      ((of : CentralizerExt a m →* CentralizerExt (t j * of b : CentralizerExt a m) n).comp of)
      (FreeGroup.lift fun _ : Unit ↦ t i)) :=
  coprodLift_injective_of_forall_mem_centralizer i fun _ hg ↦
    eq_one_of_commute_t_mul_of hG hab (mem_centralizer_singleton_iff.1 hg)

/-- For distinct basis elements `a`, `b` of a free group `F`, the elements `b` and `t` of `F(a, t)`
generate the free product `⟨b⟩ ∗ ⟨t⟩`. -/
example {α : Type*} {a b : α} (hab : a ≠ b) :
    Function.Injective (Monoid.Coprod.lift
      ((of : FreeGroup α →* CentralizerExt (FreeGroup.of a) 1).comp
        (zpowers (FreeGroup.of b)).subtype)
      (FreeGroup.lift fun _ : Unit ↦ t 0)) :=
  coprodLift_injective_of_forall_mem_centralizer 0 fun k hk ↦ by
    -- A nontrivial power of `b` commuting with `a` would make `a` commute with `b`.
    by_contra hk1
    obtain ⟨e, he⟩ := mem_zpowers_iff.1 k.property
    refine hab (FreeGroup.eq_of_commute_of_of ((isCommTransitive_iff _).1
      IsFreeGroup.isCommTransitive _ (k : FreeGroup α) _ (by simpa using hk1)
      (mem_centralizer_singleton_iff.1 hk).symm ?_))
    rw [← he]
    exact (Commute.refl _).zpow_left e

/-- For distinct basis elements `a`, `b` of a free group `F`, the letter `s` of `F(a, t)(t b, s)` is
free over `F`. -/
example {α : Type*} {a b : α} (hab : a ≠ b) :
    Function.Injective (Monoid.Coprod.lift
      ((of : CentralizerExt (FreeGroup.of a) 1 →*
          CentralizerExt (t 0 * of (FreeGroup.of b) : CentralizerExt (FreeGroup.of a) 1) 1).comp
        of)
      (FreeGroup.lift fun _ : Unit ↦ t 0)) :=
  coprodLift_injective_of_not_commute IsFreeGroup.isCommTransitive
    (fun h ↦ hab (FreeGroup.eq_of_commute_of_of h)) 0 0

end TauCeti.LimitGroup.CentralizerExt
