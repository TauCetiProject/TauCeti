module

public import TauCeti.GroupTheory.LimitGroup.CentralizerExtension.FreeProduct
import TauCeti.GroupTheory.LimitGroup.CentralizerExtension.Centralizer

/-!
# Free letters in extensions of centralizers

Let `G` be a commutative-transitive group (for instance CSA), `a, b ∈ G` not commuting, and
`G(a, ℤᵐ) = G ∗_{C_G(a)} (C_G(a) × ℤᵐ)` the extension of the centralizer of `a`, with new letters
`t₀, …, tₘ₋₁`. No nontrivial element of `G` commutes with `tⱼ b`
(`CentralizerExt.eq_one_of_commute_t_mul_of`). Consequently, when the centralizer of `tⱼ b` in
`G(a, ℤᵐ)` is extended in turn, its new letters `s₀, …, sₙ₋₁` are free over `G`: for an embedding
`ι : A →* ℤⁿ = ⟨s₀, …, sₙ₋₁⟩`, the subgroup of `G(a, ℤᵐ)(tⱼ b, ℤⁿ)` generated by `G` and `ι(A)` is
the free product `G ∗ ι(A)`; in particular each `sᵢ` is free over `G`
(`coprodLift_injective_of_not_commute`, a special case of
`CentralizerExt.coprodLift_injective_of_comap_centralizer_eq_bot`). For instance, in
`F(a, b)(a, t)(t b, s)` the letter `s` is free over `F(a, b)`.

These are the first steps of the normal-form argument showing that the extensions of centralizers
built from a solution of a one-commutator equation `[x, y] = [a, b]` over a CSA group embed its
coordinate group ([IFT], §7.2, Proposition 5, Case 1).

## Main results

* `TauCeti.LimitGroup.CentralizerExt.coprodLift_injective_of_not_commute`: `G ∗ A` embeds in
  `G(a, ℤᵐ)(tⱼ b, ℤⁿ)` for a subgroup `A` of the free abelian group `ℤⁿ` on the new letters.

## References

* [IFT] O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra
  290 (2005), §7.2, Proposition 5.
-/

public section

open Group Subgroup

namespace TauCeti.LimitGroup.CentralizerExt

variable {G : Type*} [Group G]

/-- **Free letters over `G`.** Let `G` be commutative transitive and `a, b ∈ G` not commuting.
In the extension of the centralizer of `tⱼ b` in `G(a, ℤᵐ)` by `ℤⁿ`, the new letters
`s₀, …, sₙ₋₁` are free over `G`: for an embedding `ι : A →* ℤⁿ`, the homomorphism
`G ∗ A →* G(a, ℤᵐ)(tⱼ b, ℤⁿ)` that is the inclusion on `G` and `ι` on `A` is injective. -/
theorem coprodLift_injective_of_not_commute (hG : IsCommTransitive G) {a b : G} (hab : ¬Commute a b)
    {m n : ℕ} (j : Fin m) {A : Type*} [Group A] {ι : A →* (Fin n → Multiplicative ℤ)}
    (hι : Function.Injective ι) : Function.Injective (Monoid.Coprod.lift
      ((of : CentralizerExt a m →* CentralizerExt (t j * of b : CentralizerExt a m) n).comp of)
      ((zpowersPiHom t commute_t_t).comp ι)) :=
  coprodLift_injective_of_comap_centralizer_eq_bot ((eq_bot_iff_forall _).2 fun _ hg ↦
    eq_one_of_commute_t_mul_of hG hab (mem_centralizer_singleton_iff.1 hg)) hι

/-- For distinct basis elements `a`, `b` of a free group `F`, the elements `b` and `t` of `F(a, t)`
generate the free product `⟨b⟩ ∗ ⟨t⟩`. -/
example {α : Type*} {a b : α} (hab : a ≠ b) :
    Function.Injective (Monoid.Coprod.lift
      ((of : FreeGroup α →* CentralizerExt (FreeGroup.of a) 1).comp
        (zpowers (FreeGroup.of b)).subtype)
      (zpowersPiHom t commute_t_t)) := by
  refine coprodLift_injective_of_comap_centralizer_eq_bot (ι := .id _)
    ((eq_bot_iff_forall _).2 fun k hk ↦ ?_) Function.injective_id
  -- A nontrivial power of `b` commuting with `a` would make `a` commute with `b`.
  by_contra hk1
  obtain ⟨e, he⟩ := mem_zpowers_iff.1 k.property
  refine hab (FreeGroup.eq_of_commute_of_of ((isCommTransitive_iff _).1
    IsFreeGroup.isCommTransitive _ (k : FreeGroup α) _ (by simpa using hk1)
    (mem_centralizer_singleton_iff.1 hk).symm ?_))
  rw [← he]
  exact (Commute.refl _).zpow_left e

/-- For distinct basis elements `a`, `b` of a free group `F`, the letter `s` of `F(a, t)(t b, s)` is
free over `F`. -/
example {α : Type*} {a b : α} (hab : a ≠ b) :
    Function.Injective (Monoid.Coprod.lift
      ((of : CentralizerExt (FreeGroup.of a) 1 →*
          CentralizerExt (t 0 * of (FreeGroup.of b) : CentralizerExt (FreeGroup.of a) 1) 1).comp
        of)
      (zpowersPiHom t commute_t_t)) :=
  coprodLift_injective_of_not_commute (ι := .id _) IsFreeGroup.isCommTransitive
    (fun h ↦ hab (FreeGroup.eq_of_commute_of_of h)) 0 Function.injective_id

end TauCeti.LimitGroup.CentralizerExt
