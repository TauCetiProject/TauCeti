/-!
# Partial exponentiation by the indeterminate

Myasnikov and Remeslennikov build the tensor completion `G^{ℤ[t]}` of a CSA group `G` step by
step: each stage is a *partial* `ℤ[t]`-group, in which `g ^ t` is defined for some elements `g`
only, and the next stage extends the centralizers on which it is not yet defined. This file
records the structure of one stage of that construction when the centralizers are extended by one
new letter at a time. The indeterminate is written `t` here and `X` in names, as in `ℤ[X]`.

A `PartialXPow P` consists of a set `dom` of elements of `P` whose `t`-th power is defined, and a
map `xpow : P → P` giving that power on `dom`, such that every nonidentity element commutes with
a *top* element `b`: every element of the centralizer of `b` is `d * b ^ m` with `d` in `dom`,
and no power `b ^ m` with `m ≠ 0` is in `dom` (when the centralizer is abelian, it is the direct
product of its part in `dom` and the infinite cyclic group generated by `b`). The map `xpow` is
total, with `xpow b = 1` for a top element `b`, but only its values on `dom` are `t`-th powers.
In the construction, the next stage extends the centralizer of a top element by a new letter,
which becomes its `t`-th power. A top element is not a proper power, so this extension is an
admissible step of an iterated extension of centralizers.

The first stage is a torsion-free group in which the centralizer of every nonidentity element is
cyclic, for instance a free group, with no power defined (`PartialXPow.trivial`); its top elements
are the nonidentity elements that generate their own centralizer, that is, the elements that are
not proper powers.

## Main definitions

* `TauCeti.LimitGroup.PartialXPow P`: a partial exponentiation by the indeterminate on `P`.
* `TauCeti.LimitGroup.PartialXPow.IsTop`: the top elements.
* `TauCeti.LimitGroup.PartialXPow.trivial`: for a torsion-free group with cyclic centralizers,
  the structure in which no power is defined.
* `TauCeti.LimitGroup.PartialXPow.map`: transport along an isomorphism.

## Main results

* `TauCeti.LimitGroup.PartialXPow.exists_isTop_commute`: every nonidentity element commutes with
  a top element.
* `TauCeti.LimitGroup.PartialXPow.IsTop.isAdmissibleCentralizerStep`: extending the centralizer
  of a top element is an admissible step.
* `TauCeti.LimitGroup.PartialXPow.isTop_trivial_iff`: the top elements of the trivial structure
  are the nonidentity elements that generate their own centralizer.
* `TauCeti.LimitGroup.PartialXPow.isTop_trivial_iff_not_isProperPower`: they are the elements
  that are not proper powers.

## References

* A. G. Myasnikov, V. N. Remeslennikov, *Exponential groups. II. Extensions of centralizers and
  tensor completion of CSA-groups*, Internat. J. Algebra Comput. 6 (1996): Definition 4 (partial
  `A`-groups), Lemma 5 (transport of the action to an isomorphic copy), and §8 (root elements
  `v`, those with `C(v) = ⟨v⟩` among the cyclic centralizers extended at a level).
* A. G. Myasnikov, V. N. Remeslennikov, D. Serbin, *Regular free length functions on Lyndon's
  free `ℤ[t]`-group `F^{ℤ[t]}`*, Contemp. Math. 378 (2005), §2.1 (the chain of extensions of
  cyclic centralizers).
-/

public section

open Subgroup

namespace TauCeti.LimitGroup

/-- A *partial exponentiation by the indeterminate* on a group `P`: a set `dom` of elements whose
`t`-th power is defined, closed under conjugation, inverses and products of commuting elements,
and a map `xpow : P → P`, the `t`-th power on `dom`, that commutes with conjugation and is
multiplicative on commuting elements, such that every nonidentity element commutes with an
element `b` with `xpow b = 1`, every element of whose centralizer is `d * b ^ m` with `d` in
`dom`, and no power `b ^ m` of which with `m ≠ 0` is in `dom`. -/
@[ext]
structure PartialXPow (P : Type*) [Group P] where
  /-- The elements whose `t`-th power is defined. -/
  dom : Set P
  /-- The `t`-th power; it is meaningful on `dom` and is `1` on top elements. -/
  xpow : P → P
  /-- The identity is in the domain. -/
  one_mem : 1 ∈ dom
  /-- The domain is closed under conjugation. -/
  conj_mem (g : P) {x : P} (hx : x ∈ dom) : g * x * g⁻¹ ∈ dom
  /-- The domain is closed under inverses. -/
  inv_mem {x : P} (hx : x ∈ dom) : x⁻¹ ∈ dom
  /-- The domain is closed under products of commuting elements. -/
  mul_mem {x y : P} (hx : x ∈ dom) (hy : y ∈ dom) (h : Commute x y) : x * y ∈ dom
  /-- The `t`-th power commutes with conjugation. -/
  xpow_conj (g x : P) : xpow (g * x * g⁻¹) = g * xpow x * g⁻¹
  /-- The `t`-th power is multiplicative on commuting elements. -/
  xpow_mul {x y : P} (h : Commute x y) : xpow (x * y) = xpow x * xpow y
  /-- Every nonidentity element commutes with a top element. -/
  exists_top {x : P} (hx : x ≠ 1) : ∃ b : P, Commute b x ∧ xpow b = 1 ∧
    (∀ y : P, Commute y b → ∃ d ∈ dom, ∃ m : ℤ, y = d * b ^ m) ∧ ∀ m : ℤ, b ^ m ∈ dom → m = 0

namespace PartialXPow

variable {P : Type*} [Group P] (S : PartialXPow P)

/-- An element `b` is a *top* element if its `t`-th power is not defined, in the strong sense
that every element of the centralizer of `b` is `d * b ^ m` with `d` in the domain and no power
`b ^ m` with `m ≠ 0` is in the domain; the total map `xpow` takes the value `1` at `b`. -/
def IsTop (b : P) : Prop :=
  S.xpow b = 1 ∧ (∀ y : P, Commute y b → ∃ d ∈ S.dom, ∃ m : ℤ, y = d * b ^ m) ∧
    ∀ m : ℤ, b ^ m ∈ S.dom → m = 0

variable {S}

/-- An element is in the domain exactly when its conjugate by `g` is. -/
@[simp]
theorem conj_mem_iff (g : P) {x : P} : g * x * g⁻¹ ∈ S.dom ↔ x ∈ S.dom :=
  ⟨fun h ↦ by simpa [mul_assoc] using S.conj_mem g⁻¹ h, S.conj_mem g⟩

/-- An element is in the domain exactly when its inverse is. -/
@[simp]
protected theorem inv_mem_iff {x : P} : x⁻¹ ∈ S.dom ↔ x ∈ S.dom :=
  ⟨fun h ↦ by simpa using S.inv_mem h, S.inv_mem⟩

/-- The domain is closed under natural powers. -/
protected theorem pow_mem {x : P} (hx : x ∈ S.dom) (n : ℕ) : x ^ n ∈ S.dom := by
  induction n with
  | zero => simpa using S.one_mem
  | succ n ih => simpa [pow_succ] using S.mul_mem ih hx ((Commute.refl x).pow_left n)

/-- The domain is closed under integer powers. -/
protected theorem zpow_mem {x : P} (hx : x ∈ S.dom) (n : ℤ) : x ^ n ∈ S.dom := by
  obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg n <;> simpa using S.pow_mem hx n

variable (S) in
/-- The `t`-th power of the identity is the identity. -/
@[simp]
theorem xpow_one : S.xpow 1 = 1 := by
  simpa using S.xpow_mul (Commute.one_left (1 : P))

variable (S) in
/-- The `t`-th power of an inverse is the inverse of the `t`-th power. -/
@[simp]
theorem xpow_inv (x : P) : S.xpow x⁻¹ = (S.xpow x)⁻¹ :=
  eq_inv_of_mul_eq_one_right <| by
    rw [← S.xpow_mul (Commute.refl x).inv_right, mul_inv_cancel, xpow_one]

variable (S) in
/-- The `t`-th power of a natural power is the natural power of the `t`-th power. -/
@[simp]
theorem xpow_pow (x : P) (n : ℕ) : S.xpow (x ^ n) = S.xpow x ^ n := by
  induction n with
  | zero => simp
  | succ n ih => rw [pow_succ, S.xpow_mul ((Commute.refl x).pow_left n), ih, pow_succ]

variable (S) in
/-- The `t`-th power of an integer power is the integer power of the `t`-th power. -/
@[simp]
theorem xpow_zpow (x : P) (n : ℤ) : S.xpow (x ^ n) = S.xpow x ^ n := by
  obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg n <;> simp

variable (S) in
/-- An element commutes with its `t`-th power. -/
theorem commute_xpow (x : P) : Commute x (S.xpow x) :=
  (eq_mul_inv_iff_mul_eq.1 (by simpa using S.xpow_conj x x)).symm

/-- The defining property of a top element. -/
theorem isTop_iff {b : P} : S.IsTop b ↔ S.xpow b = 1 ∧
    (∀ y : P, Commute y b → ∃ d ∈ S.dom, ∃ m : ℤ, y = d * b ^ m) ∧
      ∀ m : ℤ, b ^ m ∈ S.dom → m = 0 :=
  Iff.rfl

/-- Every nonidentity element commutes with a top element. -/
theorem exists_isTop_commute {x : P} (hx : x ≠ 1) : ∃ b : P, S.IsTop b ∧ Commute b x :=
  (S.exists_top hx).imp fun _ h ↦ ⟨h.2, h.1⟩

/-- A top element is not in the domain. -/
theorem IsTop.notMem_dom {b : P} (hb : S.IsTop b) : b ∉ S.dom := fun h ↦
  one_ne_zero (hb.2.2 1 (by rwa [zpow_one]))

/-- A top element is not the identity. -/
theorem IsTop.ne_one {b : P} (hb : S.IsTop b) : b ≠ 1 := fun h ↦
  hb.notMem_dom (h ▸ S.one_mem)

/-- A conjugate of a top element is a top element. -/
theorem IsTop.conj {b : P} (hb : S.IsTop b) (g : P) : S.IsTop (g * b * g⁻¹) := by
  refine ⟨by simp [S.xpow_conj, hb.1], fun y hy ↦ ?_, fun m hm ↦ hb.2.2 m ?_⟩
  · have hy' : Commute (g⁻¹ * y * g) b := by
      simpa [mul_assoc] using hy.map (MulAut.conj g⁻¹)
    obtain ⟨d, hd, m, hdm⟩ := hb.2.1 _ hy'
    refine ⟨g * d * g⁻¹, (conj_mem_iff g).2 hd, m, ?_⟩
    calc y = g * (g⁻¹ * y * g) * g⁻¹ := by group
      _ = _ := by rw [hdm, conj_zpow]; group
  · rwa [conj_zpow, conj_mem_iff] at hm

/-- A top element is not a proper power. -/
theorem IsTop.not_isProperPower {b : P} (hb : S.IsTop b) : ¬Group.IsProperPower b := by
  rw [Group.isProperPower_iff]
  rintro ⟨y, n, hn, hyb⟩
  have hy : Commute y b := hyb ▸ (Commute.refl y).pow_right n
  obtain ⟨d, hd, m, rfl⟩ := hb.2.1 y hy
  have hdb : Commute d b := by
    simpa using hy.mul_left ((Commute.refl b).zpow_left (-m))
  -- `b = (d * b ^ m) ^ n = d ^ n * b ^ (m * n)`, so `b ^ (1 - m * n) = d ^ n` is in the domain
  have h2 : b ^ (1 - m * n) = d ^ n := by
    rw [zpow_sub, zpow_one, mul_inv_eq_iff_eq_mul, zpow_mul, zpow_natCast,
      ← (hdb.zpow_right m).mul_pow, ← hyb]
  have h3 := hb.2.2 _ (h2 ▸ S.pow_mem hd n)
  have := Int.eq_one_of_mul_eq_one_left (Int.natCast_nonneg n) (by omega : m * n = 1)
  omega

/-- Extending the centralizer of a top element by a positive number of letters is an admissible
step. -/
theorem IsTop.isAdmissibleCentralizerStep {b : P} (hb : S.IsTop b) {n : ℕ} (hn : 0 < n) :
    IsAdmissibleCentralizerStep b n :=
  isAdmissibleCentralizerStep_iff.2 ⟨hb.not_isProperPower, hn⟩

-- In a torsion-free group, an element `b ≠ 1` whose centralizer is generated by `b` satisfies
-- the last two conditions of a top element for the domain `{1}`.
private theorem isTop_aux [IsMulTorsionFree P] {b : P} (hb1 : b ≠ 1)
    (hb : centralizer {b} = zpowers b) :
    (∀ y : P, Commute y b → ∃ d ∈ ({1} : Set P), ∃ m : ℤ, y = d * b ^ m) ∧
      ∀ m : ℤ, b ^ m ∈ ({1} : Set P) → m = 0 := by
  refine ⟨fun y hy ↦ ?_, fun m hm ↦ (IsMulTorsionFree.zpow_eq_one_iff_right hb1).1 hm⟩
  obtain ⟨m, rfl⟩ := mem_zpowers_iff.1 (hb ▸ mem_centralizer_singleton_iff.2 hy)
  exact ⟨1, rfl, m, (one_mul _).symm⟩

/-- The structure in which no `t`-th power is defined, on a torsion-free group in which the
centralizer of every nonidentity element is cyclic: the top elements are the nonidentity elements
that generate their own centralizer. -/
protected def trivial [IsMulTorsionFree P] (h : ∀ g : P, g ≠ 1 → IsCyclic (centralizer {g})) :
    PartialXPow P where
  dom := {1}
  xpow _ := 1
  one_mem := rfl
  conj_mem := by simp
  inv_mem := by simp
  mul_mem := by simp
  xpow_conj := by simp
  xpow_mul _ := (mul_one 1).symm
  exists_top {x} hx := by
    obtain ⟨c, hc⟩ := (centralizer {x}).isCyclic_iff_exists_zpowers_eq.1 (h x hx)
    have hxc : x ∈ zpowers c := hc ▸ mem_centralizer_singleton_iff.2 rfl
    have hc1 : c ≠ 1 := by
      rintro rfl
      exact hx (by simpa using hxc)
    exact ⟨c, (mem_centralizer_singleton_iff.1 (hc ▸ mem_zpowers c)), rfl,
      isTop_aux hc1 (centralizer_singleton_eq_zpowers_of_centralizer_le hc.ge)⟩

@[simp]
theorem trivial_dom [IsMulTorsionFree P] (h : ∀ g : P, g ≠ 1 → IsCyclic (centralizer {g})) :
    (PartialXPow.trivial h).dom = {1} := (rfl)

@[simp]
theorem trivial_xpow [IsMulTorsionFree P] (h : ∀ g : P, g ≠ 1 → IsCyclic (centralizer {g}))
    (x : P) : (PartialXPow.trivial h).xpow x = 1 := (rfl)

/-- In the structure in which no power is defined, the top elements are the nonidentity elements
that generate their own centralizer. -/
theorem isTop_trivial_iff [IsMulTorsionFree P] (h : ∀ g : P, g ≠ 1 → IsCyclic (centralizer {g}))
    {b : P} : (PartialXPow.trivial h).IsTop b ↔ b ≠ 1 ∧ centralizer {b} = zpowers b := by
  refine ⟨fun hb ↦ ⟨hb.ne_one, le_antisymm (fun y hy ↦ ?_) (zpowers_le_centralizer_singleton b)⟩,
    fun ⟨hb1, hb⟩ ↦ ⟨rfl, isTop_aux hb1 hb⟩⟩
  obtain ⟨d, hd, m, rfl⟩ := hb.2.1 y (mem_centralizer_singleton_iff.1 hy)
  simp_all

/-- In the structure in which no power is defined, the top elements are the elements that are not
proper powers. -/
theorem isTop_trivial_iff_not_isProperPower [IsMulTorsionFree P]
    (h : ∀ g : P, g ≠ 1 → IsCyclic (centralizer {g})) {b : P} :
    (PartialXPow.trivial h).IsTop b ↔ ¬Group.IsProperPower b := by
  refine ⟨IsTop.not_isProperPower, fun hb ↦ (isTop_trivial_iff h).2
    ⟨Group.ne_one_of_not_isProperPower hb, ?_⟩⟩
  obtain ⟨c, hc⟩ := (centralizer {b}).isCyclic_iff_exists_zpowers_eq.1
    (h b (Group.ne_one_of_not_isProperPower hb))
  obtain ⟨k, rfl⟩ := mem_zpowers_iff.1 (hc ▸ mem_centralizer_singleton_iff.2 rfl)
  rw [← hc]
  obtain rfl | rfl := Int.natAbs_eq_iff.1 (Group.natAbs_eq_one_of_not_isProperPower_zpow hb) <;>
    simp

-- An isomorphism carries a top element to an element satisfying the conditions of a top element
-- for the transported domain and power.
private theorem isTop_map_aux {Q : Type*} [Group Q] (S : PartialXPow P) (e : P ≃* Q) {b : P}
    (hb : S.IsTop b) : e (S.xpow (e.symm (e b))) = 1 ∧
      (∀ y : Q, Commute y (e b) → ∃ d ∈ e '' S.dom, ∃ m : ℤ, y = d * e b ^ m) ∧
        ∀ m : ℤ, e b ^ m ∈ e '' S.dom → m = 0 := by
  refine ⟨by simp [hb.1], fun y hy ↦ ?_, fun m ⟨d, hd, hdm⟩ ↦ hb.2.2 m ?_⟩
  · obtain ⟨d, hd, m, hdm⟩ := hb.2.1 (e.symm y) (by simpa using hy.map e.symm)
    exact ⟨e d, ⟨d, hd, rfl⟩, m, by rw [← map_zpow, ← map_mul, ← hdm, e.apply_symm_apply]⟩
  · rw [← map_zpow, e.injective.eq_iff] at hdm
    exact hdm ▸ hd

/-- Transport of a partial exponentiation along an isomorphism of groups. -/
def map {Q : Type*} [Group Q] (S : PartialXPow P) (e : P ≃* Q) : PartialXPow Q where
  dom := e '' S.dom
  xpow y := e (S.xpow (e.symm y))
  one_mem := ⟨1, S.one_mem, map_one e⟩
  conj_mem g x hx := by
    obtain ⟨x, hx, rfl⟩ := hx
    exact ⟨e.symm g * x * (e.symm g)⁻¹, S.conj_mem _ hx,
      by simp only [map_mul, map_inv, MulEquiv.apply_symm_apply]⟩
  inv_mem hx := by
    obtain ⟨x, hx, rfl⟩ := hx
    exact ⟨x⁻¹, S.inv_mem hx, map_inv e x⟩
  mul_mem hx hy h := by
    obtain ⟨x, hx, rfl⟩ := hx
    obtain ⟨y, hy, rfl⟩ := hy
    exact ⟨x * y, S.mul_mem hx hy (by simpa using h.map e.symm), map_mul e x y⟩
  xpow_conj g x := by
    simp only [map_mul, map_inv, S.xpow_conj, MulEquiv.apply_symm_apply]
  xpow_mul h := by rw [map_mul, S.xpow_mul (h.map e.symm), map_mul]
  exists_top hx := by
    obtain ⟨b, hb, hbx⟩ := S.exists_isTop_commute (x := e.symm _) (by simpa using hx)
    exact ⟨e b, by simpa using hbx.map e, isTop_map_aux S e hb⟩

@[simp]
theorem map_dom {Q : Type*} [Group Q] (S : PartialXPow P) (e : P ≃* Q) :
    (S.map e).dom = e '' S.dom := (rfl)

@[simp]
theorem map_xpow_apply {Q : Type*} [Group Q] (S : PartialXPow P) (e : P ≃* Q) (x : P) :
    (S.map e).xpow (e x) = e (S.xpow x) := by
  simp [map]

/-- Transport along the identity is the identity. -/
@[simp]
theorem map_refl (S : PartialXPow P) : S.map (MulEquiv.refl P) = S := by
  ext <;> simp [map]

/-- Transport along a composite of isomorphisms is the composite of the transports. -/
theorem map_map {Q R : Type*} [Group Q] [Group R] (S : PartialXPow P) (e : P ≃* Q)
    (f : Q ≃* R) : (S.map e).map f = S.map (e.trans f) := by
  ext <;> simp [map]

/-- Transport along an isomorphism and back is the identity. -/
@[simp]
theorem map_symm_map {Q : Type*} [Group Q] (S : PartialXPow P) (e : P ≃* Q) :
    (S.map e).map e.symm = S := by
  rw [map_map, MulEquiv.self_trans_symm, map_refl]

/-- Transport along the inverse of an isomorphism and back is the identity. -/
@[simp]
theorem map_map_symm {Q : Type*} [Group Q] (S : PartialXPow Q) (e : P ≃* Q) :
    (S.map e.symm).map e = S := by
  rw [map_map, MulEquiv.symm_trans_self, map_refl]

/-- An isomorphism carries the top elements of a partial exponentiation exactly to the top
elements of the transported one. -/
@[simp]
theorem isTop_map_iff {Q : Type*} [Group Q] (S : PartialXPow P) (e : P ≃* Q) {b : P} :
    (S.map e).IsTop (e b) ↔ S.IsTop b := by
  refine ⟨fun hb ↦ ⟨?_, fun y hy ↦ ?_, fun m hm ↦ hb.2.2 m ?_⟩, isTop_map_aux S e⟩
  · simpa using hb.1
  · obtain ⟨_, ⟨d, hd, rfl⟩, m, hdm⟩ := hb.2.1 (e y) (by simpa using hy.map e)
    exact ⟨d, hd, m, e.injective (by simpa using hdm)⟩
  · simpa [← map_zpow] using hm

/-! ### The free group -/

/-- The generators of a free group are top elements of the structure in which no power is
defined. -/
example {α : Type*} (a : α) :
    (PartialXPow.trivial fun _ hg ↦ IsFreeGroup.isCyclic_centralizer hg :
      PartialXPow (FreeGroup α)).IsTop (FreeGroup.of a) :=
  (isTop_trivial_iff_not_isProperPower _).2 (FreeGroup.not_isProperPower_of a)

/-- The square of a generator of a free group is not a top element of the structure in which no
power is defined. -/
example {α : Type*} (a : α) :
    ¬(PartialXPow.trivial fun _ hg ↦ IsFreeGroup.isCyclic_centralizer hg :
      PartialXPow (FreeGroup α)).IsTop (FreeGroup.of a ^ 2) :=
  fun h ↦ h.not_isProperPower (FreeGroup.isProperPower_of_sq a)

end PartialXPow

end TauCeti.LimitGroup
