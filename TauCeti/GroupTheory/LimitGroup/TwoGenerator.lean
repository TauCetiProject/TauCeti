import TauCeti.GroupTheory.Subgroup.Centralizer

/-!
# Two-generated subgroups of residually free groups

Two elements `a` and `b` of a residually free group generate the trivial group, `ℤ`, `ℤ²`, or a
free group of rank two. If they commute, they generate a free abelian group of rank at most two,
since residually free groups are torsion-free. If they do not, some homomorphism `φ` to a free
group keeps their commutator nontrivial; then `φ a` and `φ b` do not commute, so they freely
generate a free group of rank two, and therefore so do `a` and `b`. In particular a nonabelian
residually free group contains a free group of rank two, and full residual freeness is not needed
for this.

The same argument, with one homomorphism keeping finitely many elements nontrivial at once, shows
that in a fully residually free group the centralizers `C(g)` and `C(h)` of two elements that do
not commute generate their free product `C(g) ∗ C(h)`. A reduced word in the two centralizers maps,
under a homomorphism to a free group keeping its letters and `⁅g, h⁆` nontrivial, to a reduced
word in the centralizers of the images of `g` and `h`. Those are cyclic and generated by two
elements that do not commute, hence free factors of a free subgroup of rank two. Here residual
freeness is not enough: in `F₂ × ℤ` the central factor lies in every centralizer.

## Main results

* `TauCeti.LimitGroup.IsResiduallyFree.injective_lift_iff_not_commute`: in a residually free group,
  `a` and `b` freely generate a free group of rank two if and only if they do not commute.
* `TauCeti.LimitGroup.IsResiduallyFree.closure_pair_mulEquiv_int_or_freeGroup`: two elements of a
  residually free group generate a subgroup isomorphic to `ℤᵏ` with `k ≤ 2`, or to the free group
  of rank two.
* `TauCeti.LimitGroup.IsFullyResiduallyFree.injective_lift_centralizer_subtype`: in a fully
  residually free group, the centralizers of two elements that do not commute generate their free
  product.

## References

* C. Champetier, V. Guirardel, *Limit groups as limits of free groups*, Israel J. Math. 146
  (2005), Proposition 3.1.
* O. Kharlampovich, A. Myasnikov, *Irreducible affine varieties over a free group. I:
  Irreducibility of quadratic equations and Nullstellensatz*, J. Algebra 200 (1998), §5, Lemma 21.
-/

public section

open Monoid Subgroup
open scoped commutatorElement

namespace TauCeti.LimitGroup

variable {G : Type*} [Group G]

/-- In a residually free group, two noncommuting elements freely generate a free group of rank
two. -/
theorem IsResiduallyFree.injective_lift_of_not_commute (h : IsResiduallyFree G) {a b : G}
    (hab : ¬Commute a b) : Function.Injective (FreeGroup.lift ![a, b]) := by
  -- A homomorphism to a free group keeping `⁅a, b⁆` nontrivial keeps `a` and `b` noncommuting.
  obtain ⟨ι, φ, hφ⟩ :=
    isResiduallyFree_def.mp h ⁅a, b⁆ (by rwa [Ne, commutatorElement_eq_one_iff_commute])
  have hφab : ¬Commute (φ a) (φ b) := by
    rwa [← commutatorElement_eq_one_iff_commute, ← map_commutatorElement]
  have hcomp : φ.comp (FreeGroup.lift ![a, b]) = FreeGroup.lift ![φ a, φ b] := by
    ext i
    fin_cases i <;> simp
  have hinj := IsFreeGroup.injective_lift_of_not_commute hφab
  rw [← hcomp, MonoidHom.coe_comp] at hinj
  exact hinj.of_comp

/-- In a residually free group, `a` and `b` freely generate a free group of rank two if and only if
they do not commute. -/
theorem IsResiduallyFree.injective_lift_iff_not_commute (h : IsResiduallyFree G) {a b : G} :
    Function.Injective (FreeGroup.lift ![a, b]) ↔ ¬Commute a b :=
  ⟨FreeGroup.not_commute_of_injective_lift, h.injective_lift_of_not_commute⟩

/-- **Two-generated subgroups of residually free groups.** Two elements of a residually free group
generate a subgroup isomorphic to `ℤᵏ` for some `k ≤ 2`, that is the trivial group, `ℤ` or `ℤ²`,
when they commute, and to the free group of rank two when they do not. -/
theorem IsResiduallyFree.closure_pair_mulEquiv_int_or_freeGroup (h : IsResiduallyFree G)
    (a b : G) :
    (Commute a b ∧ ∃ k ≤ 2, Nonempty (closure {a, b} ≃* Multiplicative (Fin k → ℤ))) ∨
      (¬Commute a b ∧ Nonempty (closure {a, b} ≃* FreeGroup (Fin 2))) := by
  classical
  by_cases hab : Commute a b
  · have := h.isMulTorsionFree
    have hs : (({a, b} : Finset G) : Set G).Pairwise Commute := by
      rw [Finset.coe_pair]
      exact Set.pairwise_pair.mpr fun _ => ⟨hab, hab.symm⟩
    obtain ⟨k, hk, he⟩ := exists_mulEquiv_closure_of_pairwise_commute hs
    rw [Finset.coe_pair] at he
    exact .inl ⟨hab, k, hk.trans Finset.card_le_two, he⟩
  · have hrange : (FreeGroup.lift ![a, b]).range = closure {a, b} := by
      rw [FreeGroup.range_lift_eq_closure, Matrix.range_cons_cons_empty]
    exact .inr ⟨hab, ⟨((MonoidHom.ofInjective (h.injective_lift_of_not_commute hab)).trans
      (MulEquiv.subgroupCongr hrange)).symm⟩⟩

/-- **Centralizers of noncommuting elements generate their free product.** In a fully residually
free group, if `g` and `h` do not commute, the homomorphism `C_G(g) ∗ C_G(h) →* G` induced by the
inclusions of the two centralizers is injective. -/
theorem IsFullyResiduallyFree.injective_lift_centralizer_subtype (hG : IsFullyResiduallyFree G)
    {g h : G} (hgh : ¬Commute g h) :
    Function.Injective (Coprod.lift (centralizer {g}).subtype (centralizer {h}).subtype) := by
  classical
  let c : Bool → G := fun b ↦ cond b h g
  refine (CoprodI.injective_coprod_lift_iff fun b ↦ (centralizer {c b}).subtype).2 <|
    (injective_iff_map_eq_one _).2 fun w hw ↦ ?_
  let W := CoprodI.Word.equiv w
  have hWw : W.prod = w := CoprodI.Word.equiv.symm_apply_apply w
  -- One homomorphism `φ` to a free group keeps `⁅g, h⁆` and every letter of `W` nontrivial.
  obtain ⟨ι, φ, hφ⟩ := isFullyResiduallyFree_def.mp hG
    (insert ⁅g, h⁆ (W.toList.map fun l ↦ (l.2 : G)).toFinset) (by
      simp only [Finset.forall_mem_insert, List.mem_toFinset, List.forall_mem_map, ne_eq,
        commutatorElement_eq_one_iff_commute, OneMemClass.coe_eq_one]
      exact ⟨hgh, W.ne_one⟩)
  have hφgh : ¬Commute (φ g) (φ h) := by
    rw [← commutatorElement_eq_one_iff_commute, ← map_commutatorElement]
    exact hφ _ (Finset.mem_insert_self _ _)
  -- Restricted to the centralizers, `φ` maps `W` to a reduced word in the centralizers of `φ g`
  -- and `φ h`, which generate their free product; so `W` is empty.
  let f b : centralizer {c b} →* centralizer {φ (c b)} :=
    φ.centralizerMap Set.image_singleton.superset
  have hf : ∀ l ∈ W.toList, f l.1 l.2 ≠ 1 := fun l hl h1 ↦
    hφ _ (Finset.mem_insert_of_mem (List.mem_toFinset.2 (List.mem_map.2 ⟨l, hl, rfl⟩)))
      (by simpa [f] using congrArg Subtype.val h1)
  have hN := (CoprodI.injective_coprod_lift_iff fun b ↦ (centralizer {φ (c b)}).subtype).1
    (IsFreeGroup.injective_lift_centralizer_subtype hφgh)
  have hW : W = .empty := CoprodI.Word.eq_empty_of_lift_prod_eq_one f hf <|
    (map_eq_one_iff _ hN).1 <| by
      rw [← map_one φ, ← hw, ← hWw]
      simp [CoprodI.Word.prod, map_list_prod, Function.comp_def, f]
  rw [← hWw, hW, CoprodI.Word.prod_empty]

end TauCeti.LimitGroup
