/-!
# Triangular quasi-quadratic systems under a change of the coefficient group

An injective homomorphism `f : G →* G'` carries a raw TQ system over `G` to one over `G'` in the
same variables: each level is mapped by the induced homomorphism `G[Y] →* G'[Y]` on its
coefficients. A standard quadratic level is mapped by
`TauCeti.GroupAlgGeom.Quadratic.Standard.map`, which needs its coefficients to stay nontrivial;
injectivity guarantees this. The equations of the image system are the images of the equations.
A homomorphism that is not injective need not keep a quadratic level in standard form, since it
may send a coefficient to `1`. Such a level can still be mapped as a standard equation when all of
its coefficients survive, while `TauCeti.LimitGroup.NTQ.BlockLevel.map` maps it, with no condition,
as a quadratic system.

If moreover `G'` is separated by `G` over `G`, a quadratic level over a lower system is regular
exactly when its image is: regularity through the change of coefficients is regularity of the
image equation (`TauCeti.GroupAlgGeom.Quadratic.Standard.isRegular_map_iff`), and the coordinate
group over `G'` of the image of the lower system contains the one over `G` and is separated by it
(`TauCeti.GroupAlgGeom.Quadratic.Standard.isRegular_comp_map_iff`). Hence a system is regular
exactly when its image is.

Every TQ system over a free group `F(A)` is the image of a system over the free factor generated by
finitely many letters of `A`, containing any given finite set of letters. The coefficients of each
level involve finitely many letters
(`TauCeti.GroupAlgGeom.GX.exists_finset_forall_mem_range_map_freeGroupMap`), and a standard
quadratic equation whose coefficients lie in a free factor is the image of one over that factor
(`TauCeti.GroupAlgGeom.Quadratic.Standard.exists_map_eq`). A free factor on at least two letters
is nonabelian, and `F(A)` is discriminated, hence separated, by it over it
(`TauCeti.GroupAlgGeom.isDiscriminatedBy_freeGroupMap`), so a regular system over `F(A)` is the
image of a regular system over a nonabelian free factor of finite rank. These are ingredients for
reducing a lifting problem with finitely many equations over a regular NTQ system to a free group
of finite rank. Lifts descend along such free factors by
`TauCeti.GroupAlgGeom.Lift.hasLift_iff_of_isSeparatedBy` and
`TauCeti.GroupAlgGeom.Lift.hasLiftNe_iff_of_isSeparatedBy`, compatibility by
`TauCeti.GroupAlgGeom.Lift.IsCompatibleNe.of_isSeparatedBy`.

## Main definitions

* `TauCeti.LimitGroup.NTQ.Level.map`, `TauCeti.LimitGroup.NTQ.System.map`: the image of a level
  and of a system under an injective change of coefficients.

## Main results

* `TauCeti.LimitGroup.NTQ.System.equations_map`: the equations of the image system are the
  images of the equations.
* `TauCeti.LimitGroup.NTQ.System.map_id`, `TauCeti.LimitGroup.NTQ.System.map_map`: the identity
  changes nothing, and successive changes of coefficients compose.
* `TauCeti.LimitGroup.NTQ.System.isRegular_map_iff`: along a coefficient extension by which the
  larger group is separated, a system is regular exactly when its image is.
* `TauCeti.LimitGroup.NTQ.System.exists_finset_map_eq`: a system over a free group comes from a
  free factor of finite rank containing any given finite set of letters.
* `TauCeti.LimitGroup.NTQ.System.IsRegular.exists_finset_map_eq`: a regular system over a free
  group comes from a regular system over a nonabelian free factor of finite rank containing any
  given finite set of at least two letters.

## References

* [IFT] O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra
  290 (2005), §7.6, Definition 43, and §6, Lemma 37.
-/

public section

namespace TauCeti.LimitGroup.NTQ

open GroupAlgGeom Monoid.Coprod

universe u u' v

namespace Level

variable {K K' : Type*} [Group K] [Group K'] {X : Type*}

/-- The image of a level under an injective change of coefficients `f : K →* K'`: a quadratic
level goes to the image equation, a centralizer level to the image of its set of coefficients. -/
def map (f : K →* K') (hf : Function.Injective f) : Level K X → Level K' X
  | quadratic Q => quadratic (Q.map f fun _ hg => (map_ne_one_iff f hf).2
      (Quadratic.Standard.ne_one_of_mem_coeffs hg))
  | centralizer U hU => centralizer (f '' U) (hU.image f)
  | abelian => abelian
  | empty => empty

variable (f : K →* K') (hf : Function.Injective f)

@[simp]
theorem map_quadratic (Q : Quadratic.Standard K X) :
    (quadratic Q).map f hf = quadratic (Q.map f fun _ hg => (map_ne_one_iff f hf).2
      (Quadratic.Standard.ne_one_of_mem_coeffs hg)) := (rfl)

@[simp]
theorem map_centralizer (U : Set K) (hU : U.Finite) :
    (centralizer U hU : Level K X).map f hf = centralizer (f '' U) (hU.image f) := (rfl)

@[simp]
theorem map_abelian : (abelian : Level K X).map f hf = abelian := (rfl)

@[simp]
theorem map_empty : (empty : Level K X).map f hf = empty := (rfl)

/-- Changing the coefficients along the identity does not change a level. -/
@[simp]
theorem map_id (L : Level K X) : L.map (.id K) Function.injective_id = L := by
  cases L <;> simp

/-- Changing the coefficients of a level along `f` and then along `g` is changing them along
`g ∘ f`. -/
@[simp]
theorem map_map {K'' : Type*} [Group K''] (g : K' →* K'') (hg : Function.Injective g)
    (L : Level K X) : (L.map f hf).map g hg = L.map (g.comp f) (hg.comp hf) := by
  cases L <;> simp [Set.image_image]

/-- The equations of the image level are the images of the equations. -/
@[simp]
theorem equations_map (L : Level K X) :
    (L.map f hf).equations = Monoid.Coprod.map f (FreeGroup.map id) '' L.equations := by
  cases L with
  | quadratic Q => simp
  | centralizer U hU => simpa using BlockLevel.equations_map f (.level (.centralizer U hU))
  | abelian => simpa using BlockLevel.equations_map f (.level (.abelian : Level K X))
  | empty => simp

/-- A level with coefficients in `F(A)[Y]` is the image of a level with coefficients in
`F(A₀)[Y]` for every finite set `A₀` of letters containing a suitable finite set `B`. -/
private theorem exists_finset_map_eq {A : Type u} {Y X : Type*}
    (L : Level (GX (FreeGroup A) Y) X) : ∃ B : Finset A, ∀ A₀ : Finset A, B ⊆ A₀ →
      ∃ L₀ : Level (GX (FreeGroup A₀) Y) X,
        L₀.map (Monoid.Coprod.map (FreeGroup.map (↑)) (FreeGroup.map id))
          (Monoid.Coprod.map_injective (FreeGroup.map_injective Subtype.val_injective)
            (FreeGroup.map_injective Function.injective_id)) = L := by
  classical
  cases L with
  | quadratic Q =>
    obtain ⟨B, hB⟩ := GX.exists_finset_forall_mem_range_map_freeGroupMap Q.coeffs.toFinset
    refine ⟨B, fun A₀ hA₀ => ?_⟩
    obtain ⟨Q₀, _, hQ₀⟩ := Q.exists_map_eq fun g hg => hB A₀ hA₀ g (List.mem_toFinset.2 hg)
    exact ⟨.quadratic Q₀, by rw [map_quadratic, hQ₀]⟩
  | centralizer U hU =>
    obtain ⟨B, hB⟩ := GX.exists_finset_forall_mem_range_map_freeGroupMap hU.toFinset
    refine ⟨B, fun A₀ hA₀ => ⟨.centralizer (_ ⁻¹' U) (hU.preimage (Monoid.Coprod.map_injective
      (FreeGroup.map_injective Subtype.val_injective)
        (FreeGroup.map_injective Function.injective_id)).injOn), ?_⟩⟩
    rw [map_centralizer]
    congr 1
    exact Set.image_preimage_eq_of_subset fun g hg => hB A₀ hA₀ g (hU.mem_toFinset.2 hg)
  | abelian => exact ⟨∅, fun _ _ => ⟨.abelian, rfl⟩⟩
  | empty => exact ⟨∅, fun _ _ => ⟨.empty, rfl⟩⟩

end Level

namespace System

variable {G : Type u} {G' : Type u'} [Group G] [Group G']

/-- The image of a raw TQ system under an injective change of coefficients `f : G →* G'`: every
level is mapped along the induced homomorphism of the coefficient groups `G[Y] →* G'[Y]` of its
lower variables. -/
def map (f : G →* G') (hf : Function.Injective f) : {Y : Type v} → System G Y → System G' Y
  | _, nil => nil
  | _, cons S X L => cons (S.map f hf) X (L.map (Monoid.Coprod.map f (FreeGroup.map id))
      (Monoid.Coprod.map_injective hf (FreeGroup.map_injective Function.injective_id)))

variable (f : G →* G') (hf : Function.Injective f)

@[simp]
theorem map_nil : (nil : System G PEmpty).map f hf = nil := (rfl)

@[simp]
theorem map_cons {Y X : Type v} [Finite X] (S : System G Y) (L : Level (GX G Y) X) :
    (cons S X L).map f hf = cons (S.map f hf) X (L.map (Monoid.Coprod.map f (FreeGroup.map id))
      (Monoid.Coprod.map_injective hf (FreeGroup.map_injective Function.injective_id))) := (rfl)

/-- The equations of the image system are the images of the equations. -/
@[simp]
theorem equations_map {Y : Type v} (U : System G Y) :
    (U.map f hf).equations = Monoid.Coprod.map f (FreeGroup.map id) '' U.equations := by
  induction U with
  | nil => simp
  | @cons Z S X _ L ih =>
    -- the change of coefficients commutes with the two homomorphisms into `G[X ⊕ Z]` through
    -- which the equations of the lower system and of the top level are read
    have h₁ : (Monoid.Coprod.map (.id G') (FreeGroup.map (Sum.inr : Z → X ⊕ Z))).comp
        (Monoid.Coprod.map f (FreeGroup.map id)) =
        (Monoid.Coprod.map f (FreeGroup.map id)).comp
          (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inr)) := by
      ext <;> simp
    have h₂ : (eval (Monoid.Coprod.map (.id G') (FreeGroup.map (Sum.inr : Z → X ⊕ Z)))
          fun x ↦ inr (FreeGroup.of (Sum.inl x))).comp
        (Monoid.Coprod.map (Monoid.Coprod.map f (FreeGroup.map id)) (FreeGroup.map id)) =
        (Monoid.Coprod.map f (FreeGroup.map id)).comp
          (eval (Monoid.Coprod.map (.id G) (FreeGroup.map Sum.inr))
            fun x ↦ inr (FreeGroup.of (Sum.inl x))) := by
      ext <;> simp
    simp only [map_cons, equations_cons, ih, Level.equations_map, Set.image_union,
      ← Set.image_comp, ← MonoidHom.coe_comp, h₁, h₂]

/-- Changing the coefficients along the identity does not change a system. -/
@[simp]
theorem map_id {Y : Type v} (U : System G Y) : U.map (.id G) Function.injective_id = U := by
  induction U with
  | nil => rfl
  | @cons Z S X _ L ih =>
    have h : Monoid.Coprod.map (.id G) (FreeGroup.map (id : Z → Z)) = .id _ := by
      ext <;> simp
    simp [ih, h]

/-- Changing the coefficients of a system along `f` and then along `g` is changing them along
`g ∘ f`. -/
@[simp]
theorem map_map {G'' : Type*} [Group G''] (g : G' →* G'') (hg : Function.Injective g)
    {Y : Type v} (U : System G Y) : (U.map f hf).map g hg = U.map (g.comp f) (hg.comp hf) := by
  induction U with
  | nil => rfl
  | @cons Z S X _ L ih =>
    have h : (Monoid.Coprod.map g (FreeGroup.map (id : Z → Z))).comp
        (Monoid.Coprod.map f (FreeGroup.map id)) =
          Monoid.Coprod.map (g.comp f) (FreeGroup.map id) := by
      ext <;> simp
    simp [ih, h]

variable {f}

/-- Along an injective coefficient extension `f : G →* G'` by which `G'` is separated over `G`,
a raw TQ system is regular exactly when its image is. -/
theorem isRegular_map_iff (hsep : IsSeparatedBy f (.id G)) {Y : Type v} (U : System G Y) :
    (U.map f hf).IsRegular ↔ U.IsRegular := by
  induction U with
  | nil => simp
  | cons S X L ih =>
    cases L with
    | quadratic Q =>
      simp only [map_cons, Level.map_quadratic, isRegular_cons_quadratic, ih,
        Quadratic.Standard.vars_map, Quadratic.Standard.isRegular_map_iff]
      -- the radical of the lower system sits under a quotient, out of reach of `simp`
      rw [equations_map, Quadratic.Standard.isRegular_comp_map_iff hf hsep]
    | centralizer U hU => simp
    | abelian => simp
    | empty => simpa using ih

/-- A raw TQ system over a free group `F(A)` is the image of a system over the free factor
`F(A₀)` for some finite set `A₀` of letters containing any given finite set `s`. -/
theorem exists_finset_map_eq {A : Type u} {Y : Type v} (U : System (FreeGroup A) Y) (s : Finset A) :
    ∃ A₀ : Finset A, s ⊆ A₀ ∧ ∃ U₀ : System (FreeGroup A₀) Y,
      U₀.map (FreeGroup.map (↑)) (FreeGroup.map_injective Subtype.val_injective) = U := by
  classical
  induction U generalizing s with
  | nil => exact ⟨s, subset_rfl, nil, rfl⟩
  | cons S X L ih =>
    -- enlarge `s` by the letters of the coefficients of the top level, then descend the lower
    -- system and the top level to the same free factor
    obtain ⟨B, hB⟩ := Level.exists_finset_map_eq L
    obtain ⟨A₀, hA₀, S₀, rfl⟩ := ih (s ∪ B)
    obtain ⟨L₀, rfl⟩ := hB A₀ (Finset.union_subset_right hA₀)
    exact ⟨A₀, Finset.union_subset_left hA₀, cons S₀ X L₀, rfl⟩

/-- A regular system over a free group `F(A)` is the image of a regular system over the free
factor `F(A₀)` for some finite set `A₀` of letters containing any given finite set `s` of at least
two letters; this free factor is nonabelian. -/
theorem IsRegular.exists_finset_map_eq {A : Type u} {Y : Type v} {U : System (FreeGroup A) Y}
    (hU : U.IsRegular) (s : Finset A) (hs : (s : Set A).Nontrivial) :
    ∃ A₀ : Finset A, s ⊆ A₀ ∧ ∃ U₀ : System (FreeGroup A₀) Y, U₀.IsRegular ∧
      U₀.map (FreeGroup.map (↑)) (FreeGroup.map_injective Subtype.val_injective) = U := by
  obtain ⟨A₀, hsA₀, U₀, rfl⟩ := U.exists_finset_map_eq s
  -- `F(A)` is discriminated, hence separated, by its nonabelian free factor `F(A₀)` over it
  have hA₀ : (A₀ : Set A).Nontrivial := hs.mono (Finset.coe_subset.2 hsA₀)
  exact ⟨A₀, hsA₀, U₀,
    (isRegular_map_iff _ (isDiscriminatedBy_freeGroupMap hA₀).isSeparatedBy U₀).1 hU, rfl⟩

end System

/-! ### Examples -/

section Examples

/-- The two-level system with the genus-two levels `[x₁, y₁][x₂, y₂] = 1` and
`[u₁, v₁][u₂, v₂] = 1` over the free factor `F(a, b)` of `F(a, b, c)` stays regular over
`F(a, b, c)`. -/
example : (System.map (FreeGroup.map ((↑) : ({0, 1} : Set (Fin 3)) → Fin 3))
    (FreeGroup.map_injective Subtype.val_injective)
    (System.cons (System.cons (G := FreeGroup ({0, 1} : Set (Fin 3))) .nil (Fin 2 ⊕ Fin 2)
      (.quadratic (.orientable 2 two_pos Sum.inl Sum.inr
        (by simp [Function.injective_id])))) (Fin 2 ⊕ Fin 2)
      (.quadratic (.orientable 2 two_pos Sum.inl Sum.inr
        (by simp [Function.injective_id]))))).IsRegular :=
  (System.isRegular_map_iff _ (isDiscriminatedBy_freeGroupMap
    ⟨0, by simp, 1, by simp, by decide⟩).isSeparatedBy _).2 isRegular_two_genusTwo_levels

end Examples

end TauCeti.LimitGroup.NTQ
