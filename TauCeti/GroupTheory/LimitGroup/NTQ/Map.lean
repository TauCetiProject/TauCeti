/-!
# Triangular quasi-quadratic systems under a change of the coefficient group

An injective homomorphism `f : G →* G'` carries a raw TQ system over `G` to one over `G'` in the
same variables: each level is mapped by the induced homomorphism `G[Y] →* G'[Y]` on its
coefficients, which keeps the coefficients of a quadratic level nontrivial. The equations of the
image system are the images of the equations. A change of coefficients that is not injective may
send a coefficient of a standard quadratic equation to `1`; it still maps a level of a block, as a
quadratic system (`TauCeti.LimitGroup.NTQ.BlockLevel.map`), but not a level of a TQ system.

If moreover `G'` is separated by `G` over `G`, the coordinate group over `G'` of each lower system
of the image is separated by the corresponding coordinate group over `G`, which it contains, so
regularity is the same for a system and its image. Every TQ system over a free group `F(A)` is the
image of a system over the free factor generated by finitely many letters of `A`. Together with
the descent of compatibility and lifts along such factors
(`TauCeti.GroupAlgGeom.Lift.hasLiftNe_iff_of_isSeparatedBy`), these are the steps that reduce
statements about regular NTQ systems over free groups to free groups of finite rank.

## Main definitions

* `TauCeti.LimitGroup.NTQ.Level.map`, `TauCeti.LimitGroup.NTQ.System.map`: the image of a level
  and of a system under an injective change of coefficients.

## Main results

* `TauCeti.LimitGroup.NTQ.System.equations_map`: the equations of the image system are the
  images of the equations.
* `TauCeti.LimitGroup.NTQ.System.isRegular_map_iff`: along a coefficient extension by which the
  larger group is separated, a system is regular exactly when its image is.
* `TauCeti.LimitGroup.NTQ.System.exists_finset_map_eq`: a system over a free group comes from a
  free factor of finite rank containing any given finite set of letters.

## References

* [IFT] O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra
  290 (2005), §7.6, Definition 43, and §6, Lemma 37.
-/

public section

namespace TauCeti.LimitGroup.NTQ

open GroupAlgGeom Monoid.Coprod

universe u u' v

/-- Finitely many words over a free group `F(A)` lie in the image of the free factor `F(A₀)`
for every finite set `A₀` of letters containing a suitable finite set `B`. -/
private theorem exists_finset_forall_mem_range {A : Type u} {Y : Type*}
    (s : Finset (GX (FreeGroup A) Y)) : ∃ B : Finset A, ∀ A₀ : Finset A, B ⊆ A₀ → ∀ w ∈ s,
      w ∈ (Monoid.Coprod.map (FreeGroup.map ((↑) : A₀ → A)) (FreeGroup.map id)).range := by
  obtain ⟨B, hB⟩ := GX.exists_finset_forall_mem_range_map_freeGroupMap s
  refine ⟨B, fun A₀ hA₀ w hw => ?_⟩
  obtain ⟨u, rfl⟩ := hB w hw
  refine ⟨Monoid.Coprod.map (FreeGroup.map fun a : B ↦ (⟨a, hA₀ a.property⟩ : A₀))
    (FreeGroup.map id) u, ?_⟩
  rw [Monoid.Coprod.map_map]
  congr 2 <;> ext <;> simp

namespace Level

variable {K K' : Type*} [Group K] [Group K'] {X : Type*}

/-- The image of a level under an injective change of coefficients `f : K →* K'`: a quadratic
level goes to the image equation, a centralizer level to the image of its set of coefficients. -/
def map (f : K →* K') (hf : Function.Injective f) : Level K X → Level K' X
  | quadratic Q => quadratic (Q.map f fun _ hg => (map_ne_one_iff f hf).2
      (Quadratic.Standard.ne_one_of_mem_coeffs hg))
  | centralizer U hU => centralizer (f '' U) (hU.image f)
  | abelian => abelian
  | empty => empty

variable (f : K →* K') (hf : Function.Injective f)

@[simp]
theorem map_quadratic (Q : Quadratic.Standard K X) :
    (quadratic Q).map f hf = quadratic (Q.map f fun _ hg => (map_ne_one_iff f hf).2
      (Quadratic.Standard.ne_one_of_mem_coeffs hg)) := (rfl)

@[simp]
theorem map_centralizer (U : Set K) (hU : U.Finite) :
    (centralizer U hU : Level K X).map f hf = centralizer (f '' U) (hU.image f) := (rfl)

@[simp]
theorem map_abelian : (abelian : Level K X).map f hf = abelian := (rfl)

@[simp]
theorem map_empty : (empty : Level K X).map f hf = empty := (rfl)

/-- The equations of the image level are the images of the equations. -/
@[simp]
theorem equations_map (L : Level K X) :
    (L.map f hf).equations = Monoid.Coprod.map f (FreeGroup.map id) '' L.equations := by
  cases L with
  | quadratic Q => simp
  | centralizer U hU => simpa using BlockLevel.equations_map f (.level (.centralizer U hU))
  | abelian => simpa using BlockLevel.equations_map f (.level (.abelian : Level K X))
  | empty => simp

/-- A level with coefficients in `F(A)[Y]` is the image of a level with coefficients in
`F(A₀)[Y]` for every finite set `A₀` of letters containing a suitable finite set `B`. -/
private theorem exists_finset_map_eq {A : Type u} {Y X : Type*}
    (L : Level (GX (FreeGroup A) Y) X) : ∃ B : Finset A, ∀ A₀ : Finset A, B ⊆ A₀ →
      ∃ L₀ : Level (GX (FreeGroup A₀) Y) X,
        L₀.map (Monoid.Coprod.map (FreeGroup.map (↑)) (FreeGroup.map id))
          (Monoid.Coprod.map_injective (FreeGroup.map_injective Subtype.val_injective)
            (FreeGroup.map_injective Function.injective_id)) = L := by
  classical
  cases L with
  | quadratic Q =>
    obtain ⟨B, hB⟩ := exists_finset_forall_mem_range Q.coeffs.toFinset
    refine ⟨B, fun A₀ hA₀ => ?_⟩
    obtain ⟨Q₀, _, hQ₀⟩ := Q.exists_map_eq fun g hg => hB A₀ hA₀ g (List.mem_toFinset.2 hg)
    exact ⟨.quadratic Q₀, by rw [map_quadratic, hQ₀]⟩
  | centralizer U hU =>
    obtain ⟨B, hB⟩ := exists_finset_forall_mem_range hU.toFinset
    refine ⟨B, fun A₀ hA₀ => ⟨.centralizer (_ ⁻¹' U) (hU.preimage (Monoid.Coprod.map_injective
      (FreeGroup.map_injective Subtype.val_injective)
        (FreeGroup.map_injective Function.injective_id)).injOn), ?_⟩⟩
    rw [map_centralizer]
    congr 1
    exact Set.image_preimage_eq_of_subset fun g hg => hB A₀ hA₀ g (hU.mem_toFinset.2 hg)
  | abelian => exact ⟨∅, fun _ _ => ⟨.abelian, rfl⟩⟩
  | empty => exact ⟨∅, fun _ _ => ⟨.empty, rfl⟩⟩

end Level

namespace System

variable {G : Type u} {G' : Type u'} [Group G] [Group G']

/-- The image of a raw TQ system under an injective change of coefficients `f : G →* G'`: every
level is mapped along the induced homomorphism of the coefficient groups `G[Y] →* G'[Y]` of its
lower variables. -/
def map (f : G →* G') (hf : Function.Injective f) : {Y : Type v} → System G Y → System G' Y
  | _, nil => nil
  | _, cons S X L => cons (S.map f hf) X (L.map (Monoid.Coprod.map f (FreeGroup.map id))
      (Monoid.Coprod.map_injective hf (FreeGroup.map_injective Function.injective_id)))

variable (f : G →* G') (hf : Function.Injective f)

@[simp]
theorem map_nil : (nil : System G PEmpty).map f hf = nil := (rfl)

@[simp]
theorem map_cons {Y X : Type v} [Finite X] (S : System G Y) (L : Level (GX G Y) X) :
    (cons S X L).map f hf = cons (S.map f hf) X (L.map (Monoid.Coprod.map f (FreeGroup.map id))
      (Monoid.Coprod.map_injective hf (FreeGroup.map_injective Function.injective_id))) := (rfl)

/-- The equations of the image system are the images of the equations. -/
@[simp]
theorem equations_map {Y : Type v} (U : System G Y) :
    (U.map f hf).equations = Monoid.Coprod.map f (FreeGroup.map id) '' U.equations := by
  induction U with
  | nil => simp
  | cons S X L ih =>
    rw [map_cons, equations_cons, equations_cons, ih, Level.equations_map, Set.image_union,
      Set.image_image, Set.image_image, Set.image_image, Set.image_image]
    -- both sides are images under the same homomorphism `G[Y] → G'[X ⊕ Y]`, resp.
    -- `G[Y][X] → G'[X ⊕ Y]`
    congr 1 <;> refine Set.image_congr fun w _ => ?_ <;>
      rw [← MonoidHom.comp_apply, ← MonoidHom.comp_apply] <;>
      exact DFunLike.congr_fun (by ext <;> simp) w

variable {f}

/-- A standard quadratic equation over `G[Y]` is regular over the coordinate group of a system
`E ⊆ G[Y]` over `G` exactly when it is regular, through the change of coefficients `f`, over the
coordinate group of the image of `E` over `G'`, if `G'` is separated by `G` over `G`. -/
private theorem isRegular_comp_map_iff (hf : Function.Injective f) (hsep : IsSeparatedBy f (.id G))
    {Y X : Type*} (E : Set (GX G Y)) (Q : Quadratic.Standard (GX G Y) X) :
    Q.IsRegular
        ((QuotientGroup.mk' (Rad (.id G') (Monoid.Coprod.map f (FreeGroup.map id) '' E))).comp
          (Monoid.Coprod.map f (FreeGroup.map id))) ↔
      Q.IsRegular (QuotientGroup.mk' (Rad (.id G) E)) := by
  -- the coordinate group of `E` with solutions in `G'` is the one over `G`
  have hRad : Rad ((MonoidHom.id G').comp f) E = Rad (.id G) E :=
    Rad_eq_of_isSeparatedBy hf (by simpa using hsep) E
  let e : GHom (QuotientGroup.mk' (Rad ((MonoidHom.id G').comp f) E))
      (QuotientGroup.mk' (Rad (.id G) E)) :=
    ⟨(QuotientGroup.quotientMulEquivOfEq hRad : _ →* _), fun _ => rfl⟩
  rw [← Quadratic.Standard.isRegular_congr e (QuotientGroup.quotientMulEquivOfEq hRad).bijective]
  -- and it embeds in the coordinate group of the image, which is separated by it over it
  have hκ : (CoordGroup.mapCoeff f (.id G') E : _ →* _).comp
      (QuotientGroup.mk' (Rad ((MonoidHom.id G').comp f) E)) =
      (QuotientGroup.mk' (Rad (.id G') (Monoid.Coprod.map f (FreeGroup.map id) '' E))).comp
        (Monoid.Coprod.map f (FreeGroup.map id)) :=
    MonoidHom.ext fun w => CoordGroup.mapCoeff_mk w
  refine ⟨fun h => h.of_isSeparatedBy ?_,
    fun h => h.map ⟨_, DFunLike.congr_fun hκ⟩ CoordGroup.mapCoeff_injective⟩
  have := (CoordGroup.isSeparatedBy_mapCoeff (S := E) hsep).comp
    (QuotientGroup.mk' (Rad ((MonoidHom.id G').comp f) E))
  rwa [hκ, MonoidHom.id_comp (QuotientGroup.mk' (Rad ((MonoidHom.id G').comp f) E))] at this

/-- Along an injective coefficient extension `f : G →* G'` by which `G'` is separated over `G`,
a raw TQ system is regular exactly when its image is. -/
theorem isRegular_map_iff (hsep : IsSeparatedBy f (.id G)) {Y : Type v} (U : System G Y) :
    (U.map f hf).IsRegular ↔ U.IsRegular := by
  induction U with
  | nil => simp
  | cons S X L ih =>
    cases L with
    | quadratic Q =>
      rw [map_cons, Level.map_quadratic, isRegular_cons_quadratic, isRegular_cons_quadratic, ih,
        Quadratic.Standard.vars_map, Quadratic.Standard.isRegular_map_iff, equations_map,
        isRegular_comp_map_iff hf hsep]
    | centralizer U hU => simp
    | abelian => simp
    | empty => simpa using ih

/-- A raw TQ system over a free group `F(A)` is the image of a system over the free factor
`F(A₀)` for some finite set `A₀` of letters containing any given finite set `s`. -/
theorem exists_finset_map_eq {A : Type u} {Y : Type v} (U : System (FreeGroup A) Y) (s : Finset A) :
    ∃ A₀ : Finset A, s ⊆ A₀ ∧ ∃ U₀ : System (FreeGroup A₀) Y,
      U₀.map (FreeGroup.map (↑)) (FreeGroup.map_injective Subtype.val_injective) = U := by
  classical
  induction U generalizing s with
  | nil => exact ⟨s, subset_rfl, nil, rfl⟩
  | cons S X L ih =>
    -- enlarge `s` by the letters of the coefficients of the top level, then descend the lower
    -- system and the top level to the same free factor
    obtain ⟨B, hB⟩ := Level.exists_finset_map_eq L
    obtain ⟨A₀, hA₀, S₀, rfl⟩ := ih (s ∪ B)
    obtain ⟨L₀, rfl⟩ := hB A₀ (Finset.union_subset_right hA₀)
    exact ⟨A₀, Finset.union_subset_left hA₀, cons S₀ X L₀, rfl⟩

end System

/-! ### Examples -/

section Examples

/-- A regular system over a free group `F(A)` is the image of a regular system over a nonabelian
free factor `F(A₀)` of finite rank, for a finite set `A₀` of letters containing any given finite
set `s` of at least two letters. -/
example {A : Type u} {Y : Type v} (U : System (FreeGroup A) Y) (hU : U.IsRegular) (s : Finset A)
    (hs : (s : Set A).Nontrivial) :
    ∃ A₀ : Finset A, s ⊆ A₀ ∧ (A₀ : Set A).Nontrivial ∧ ∃ U₀ : System (FreeGroup A₀) Y,
      U₀.IsRegular ∧
        U₀.map (FreeGroup.map (↑)) (FreeGroup.map_injective Subtype.val_injective) = U := by
  obtain ⟨A₀, hsA₀, U₀, rfl⟩ := U.exists_finset_map_eq s
  have hA₀ : (A₀ : Set A).Nontrivial := hs.mono (Finset.coe_subset.2 hsA₀)
  exact ⟨A₀, hsA₀, hA₀, U₀,
    (System.isRegular_map_iff _ (isDiscriminatedBy_freeGroupMap hA₀).isSeparatedBy U₀).1 hU, rfl⟩

/-- The two-level system with the genus-two levels `[x₁, y₁][x₂, y₂] = 1` and
`[u₁, v₁][u₂, v₂] = 1` over the free factor `F(a, b)` of `F(a, b, c)` stays regular over
`F(a, b, c)`. -/
example : (System.map (FreeGroup.map ((↑) : ({0, 1} : Set (Fin 3)) → Fin 3))
    (FreeGroup.map_injective Subtype.val_injective)
    (System.cons (System.cons (G := FreeGroup ({0, 1} : Set (Fin 3))) .nil (Fin 2 ⊕ Fin 2)
      (.quadratic (.orientable 2 two_pos Sum.inl Sum.inr
        (by simp [Function.injective_id])))) (Fin 2 ⊕ Fin 2)
      (.quadratic (.orientable 2 two_pos Sum.inl Sum.inr
        (by simp [Function.injective_id]))))).IsRegular :=
  (System.isRegular_map_iff _ (isDiscriminatedBy_freeGroupMap
    ⟨0, by simp, 1, by simp, by decide⟩).isSeparatedBy _).2 isRegular_two_genusTwo_levels

end Examples

end TauCeti.LimitGroup.NTQ
