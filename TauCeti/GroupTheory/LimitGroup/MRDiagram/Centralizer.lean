module

public import TauCeti.GroupTheory.FreeGroup.MaximalRoot.Basic
public import TauCeti.GroupTheory.LimitGroup.CentralizerExtension.DehnTwist
public import TauCeti.GroupTheory.LimitGroup.MRDiagram.Basic

/-!
# The twist diagram of an extension of a centralizer

Every `G`-homomorphism to `G` of the extension `G(u, ℤ) = ⟨G, t | [c, t] = 1, c ∈ C_G(u)⟩` of the
centralizer of `u` gives a solution `x = t` of the equation `[x, u] = 1` in `G`, and when the
centralizer of `u` is abelian, as for `u ≠ 1` in a free group, every solution arises this way. The
*twist diagram* of `G(u, ℤ)` has three vertices on a single branch: the root `G(u, ℤ)`, an
identity edge to a vertex carrying `G(u, ℤ)` again, whose modular group is generated by the Dehn
twist `t ↦ t * u`, and the proper quotient `t ↦ 1` from it to the leaf `G`. The branch composites
are the retractions `t ↦ u ^ k`, one for each integer `k`.

When `u` generates the centralizer of its own centralizer, as a non-proper-power does in a free
group, these are all the `G`-homomorphisms and the twist diagram is complete. When the
centralizer of `u` itself consists of the powers of `u`, as again for a non-proper-power of a
free group, the solutions of `[x, u] = 1` are exactly `x = u ^ k`, so that the twist diagram is a
diagram of this equation. With the trivial group in place of the modular group only `x = 1` is
left, and completeness fails as soon as `u ≠ 1`.

## Main definitions

* `TauCeti.LimitGroup.MRDiagram.centralizerOfModular u M hM`: the three-vertex diagram of
  `G(u, ℤ)` with the group `M` of automorphisms at its middle vertex.
* `TauCeti.LimitGroup.MRDiagram.centralizer u`: the twist diagram of `G(u, ℤ)`, whose modular
  group is generated by the Dehn twist.

## Main results

* `TauCeti.LimitGroup.MRDiagram.branchHoms_centralizer`: the branch composites of
  `centralizer u` are the retractions `t ↦ u ^ k`.
* `TauCeti.LimitGroup.MRDiagram.isComplete_centralizer_iff`: `centralizer u` is complete exactly
  when every element commuting with the centralizer of `u` is a power of `u`.
* `TauCeti.LimitGroup.MRDiagram.isComplete_centralizer_of_not_isProperPower`: it is complete for a
  non-proper-power `u` of a free group, in particular for a basis element.
* `TauCeti.LimitGroup.MRDiagram.exists_mem_branchHoms_centralizer_apply_t_eq_iff_mem_V`: when the
  centralizer of `u` consists of the powers of `u`, the values at `t` of the branch composites of
  `centralizer u` are exactly the solutions of `[x, u] = 1`.
* `TauCeti.LimitGroup.MRDiagram.hasProperQuotients_centralizerOfModular`: the edge below the
  root is a proper epimorphism.
* `TauCeti.LimitGroup.MRDiagram.not_isComplete_centralizerOfModular_bot`: without the modular
  automorphisms the diagram is not complete, for `u ≠ 1`.

## References

* O. Kharlampovich, A. Myasnikov, *Effective JSJ decompositions*, in: Groups, Languages,
  Algorithms, Contemp. Math. 378 (2005), §11.1 and Theorem 11.3.
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §2.5 and §5.6, Theorem 7.
-/

public section

namespace TauCeti.LimitGroup

open GroupAlgGeom

universe u

namespace MRDiagram

open Monoid.Coprod Subgroup CentralizerExt
open scoped commutatorElement

variable {G : Type u} [Group G] (u : G)

/-- The three-vertex diagram of the extension `G(u, ℤ)` of a centralizer, with a group `M` of
automorphisms at its middle vertex: an identity edge from the root `G(u, ℤ)` to a vertex carrying
`G(u, ℤ)` and `M`, followed by the quotient `t ↦ 1` to the leaf `G`. -/
def centralizerOfModular (M : Subgroup (MulAut (CentralizerExt u 1)))
    (hM : M ≤ fixingSubgroup (MulAut (CentralizerExt u 1))
      (Set.range (of : G →* CentralizerExt u 1))) :
    MRDiagram (of : G →* CentralizerExt u 1) :=
  edge ⊥ bot_le (GHom.id _) (edge M hM (retractionGHom 0) (leaf (.id G)))

section Modular

variable (M : Subgroup (MulAut (CentralizerExt u 1)))
  (hM : M ≤ fixingSubgroup (MulAut (CentralizerExt u 1))
    (Set.range (of : G →* CentralizerExt u 1)))

theorem centralizerOfModular_def :
    centralizerOfModular u M hM =
      edge ⊥ bot_le (GHom.id _) (edge M hM (retractionGHom 0) (leaf (.id G))) :=
  (rfl)

/-- The root of the three-vertex diagram of `G(u, ℤ)` carries no modular automorphism. -/
@[simp]
theorem modular_centralizerOfModular : (centralizerOfModular u M hM).modular = ⊥ :=
  modular_edge

/-- The edge below the root of the three-vertex diagram of `G(u, ℤ)`, the quotient `t ↦ 1`, is a
proper epimorphism. -/
@[simp]
theorem hasProperQuotients_centralizerOfModular :
    (centralizerOfModular u M hM).HasProperQuotients := by
  refine hasProperQuotients_edge.2 (hasProperEdges_edge.2
    ⟨fun g => ⟨of g, (retractionGHom _).map_coeff g⟩, fun h => ?_, hasProperEdges_leaf _⟩)
  refine t_notMem_range_of (u := u) (0 : Fin 1) ⟨1, h ?_⟩
  simp

end Modular

variable {u} in
/-- The branch composites of the three-vertex diagram of `G(u, ℤ)`: the automorphisms of its
middle vertex followed by the quotient `t ↦ 1`. -/
theorem mem_branchHoms_centralizerOfModular {M : Subgroup (MulAut (CentralizerExt u 1))}
    {hM : M ≤ fixingSubgroup (MulAut (CentralizerExt u 1))
      (Set.range (of : G →* CentralizerExt u 1))}
    {φ : GHom (of : G →* CentralizerExt u 1) (.id G)} :
    φ ∈ (centralizerOfModular u M hM).branchHoms (.id G) ↔
      ∃ σ ∈ M, ∀ x, φ x = retraction 0 (σ x) := by
  have hid (ψ : GHom (MonoidHom.id G) (.id G)) (g : G) : ψ g = g := ψ.map_coeff g
  rw [centralizerOfModular, branchHoms_edge_bot_id, mem_branchHoms_edge]
  simp only [branchHoms_leaf, Set.mem_univ, true_and, hid, coe_retractionGHom]
  exact exists_congr fun _ => and_congr_right fun _ => ⟨fun ⟨_, h⟩ => h, fun h => ⟨.id _, h⟩⟩

/-- The twist diagram of `G(u, ℤ)`: an identity edge from the root `G(u, ℤ)` to a vertex carrying
`G(u, ℤ)` with modular group generated by the Dehn twist `t ↦ t * u`, followed by the quotient
`t ↦ 1` to the leaf `G`. When the centralizer of `u` consists of the powers of `u`, it is a
diagram of the equation `[x, u] = 1`. -/
def centralizer : MRDiagram (of : G →* CentralizerExt u 1) :=
  centralizerOfModular u (zpowers (dehnTwist u)) (zpowers_dehnTwist_le_fixingSubgroup u)

theorem centralizer_def :
    centralizer u =
      centralizerOfModular u (zpowers (dehnTwist u)) (zpowers_dehnTwist_le_fixingSubgroup u) :=
  (rfl)

/-- The root of the twist diagram of `G(u, ℤ)` carries no modular automorphism. -/
@[simp]
theorem modular_centralizer : (centralizer u).modular = ⊥ :=
  modular_centralizerOfModular ..

/-- The edge below the root of the twist diagram of `G(u, ℤ)` is a proper epimorphism. -/
@[simp]
theorem hasProperQuotients_centralizer : (centralizer u).HasProperQuotients :=
  hasProperQuotients_centralizerOfModular ..

variable {u}

/-- A `G`-homomorphism is a branch composite of the twist diagram of `G(u, ℤ)` exactly when it is
a retraction `t ↦ u ^ k`. -/
theorem mem_branchHoms_centralizer {φ : GHom (of : G →* CentralizerExt u 1) (.id G)} :
    φ ∈ (centralizer u).branchHoms (.id G) ↔ ∃ k : ℤ, φ = retractionGHom fun _ => k := by
  rw [centralizer, mem_branchHoms_centralizerOfModular]
  constructor
  · rintro ⟨σ, ⟨k, rfl⟩, h⟩
    exact ⟨k, GHom.ext fun x => by simpa using h x⟩
  · rintro ⟨k, rfl⟩
    exact ⟨_, mem_zpowers_iff.2 ⟨k, rfl⟩, fun x => by simp⟩

/-- The branch composites of the twist diagram of `G(u, ℤ)` are the retractions `t ↦ u ^ k`. -/
@[simp]
theorem branchHoms_centralizer : (centralizer u).branchHoms (.id G) = Set.range retractionGHom :=
  Set.ext fun _ => mem_branchHoms_centralizer.trans
    ⟨fun ⟨k, hk⟩ => ⟨_, hk.symm⟩, fun ⟨k, hk⟩ => ⟨k 0, hk ▸ congrArg retractionGHom
      (funext fun i => by rw [Subsingleton.elim i 0])⟩⟩

/-- The values at `t` of the branch composites of the twist diagram of `G(u, ℤ)` are the powers
of `u`. -/
theorem exists_mem_branchHoms_centralizer_apply_t_eq_iff_mem_zpowers {g : G} :
    (∃ φ ∈ (centralizer u).branchHoms (.id G), φ (t 0) = g) ↔ g ∈ zpowers u := by
  simp only [branchHoms_centralizer, Set.exists_range_iff, coe_retractionGHom, retraction_t,
    mem_zpowers_iff]
  exact ⟨fun ⟨k, hk⟩ => ⟨k 0, hk⟩, fun ⟨k, hk⟩ => ⟨fun _ => k, hk⟩⟩

/-- Every diagram of `G(u, ℤ)` is sound for the equation `[x, u] = 1` at `x = t`. -/
theorem isSound_centralizerExt (D : MRDiagram (of : G →* CentralizerExt u 1)) :
    D.IsSound (.id G) {⁅(inr (FreeGroup.of ()) : GX G Unit), (inl u : GX G Unit)⁆}
      fun _ => t 0 :=
  isSound_iff.2 fun φ _ => by
    simpa [V_singleton_commutatorElement, mem_centralizer_singleton_iff] using
      ((commute_of_t (mem_centralizer_singleton_iff.2 rfl) 0).map φ).symm.eq

/-- The twist diagram of `G(u, ℤ)` is complete exactly when every element commuting with the
centralizer of `u` is a power of `u`. -/
theorem isComplete_centralizer_iff :
    (centralizer u).IsComplete (.id G) ↔ Subgroup.centralizer (Subgroup.centralizer {u} : Set G) ≤
      zpowers u := by
  refine ⟨fun h g hg => ?_, fun h => isComplete_iff.2 fun φ => ?_⟩
  · exact exists_mem_branchHoms_centralizer_apply_t_eq_iff_mem_zpowers.1
      ⟨⟨lift (.id G) (fun _ => g) (fun _ _ => Commute.refl g) fun c hc _ =>
        (mem_centralizer_iff.1 hg c hc), fun x => lift_of _ _ _ _ x⟩, isComplete_iff.1 h _,
        lift_t _ _ _ _ 0⟩
  · obtain ⟨k, hk⟩ := h (mem_centralizer_iff.2 fun c hc => by
      simpa using ((commute_of_t hc 0).map φ).eq)
    exact mem_branchHoms_centralizer.2 ⟨k, GHom.toMonoidHom_injective <|
      hom_ext (by ext; simp) fun i => by simp [← hk, Subsingleton.elim i 0]⟩

/-- In a free group, the twist diagram of `G(u, ℤ)` is complete when `u` is not a proper power. -/
theorem isComplete_centralizer_of_not_isProperPower [IsFreeGroup G]
    (hu : ¬Group.IsProperPower u) : (centralizer u).IsComplete (.id G) :=
  isComplete_centralizer_iff.2 fun _ hg =>
    IsFreeGroup.centralizer_singleton_eq_zpowers_self hu ▸ mem_centralizer_singleton_iff.2
      (mem_centralizer_iff.1 hg u (mem_centralizer_singleton_iff.2 rfl)).symm

/-- Over a free group with a basis element `a`, the twist diagram of `G(a, ℤ)` is complete. -/
theorem isComplete_centralizer_freeGroup_of {α : Type u} (a : α) :
    (centralizer (FreeGroup.of a)).IsComplete (.id (FreeGroup α)) :=
  isComplete_centralizer_of_not_isProperPower (FreeGroup.not_isProperPower_of a)

/-- When the centralizer of `u` consists of powers of `u`, as for a non-proper-power of a free
group, the solutions of `[x, u] = 1` are exactly the values at `t` of the branch composites of
the twist diagram of `G(u, ℤ)`. -/
theorem exists_mem_branchHoms_centralizer_apply_t_eq_iff_mem_V
    (hu : Subgroup.centralizer {u} ≤ zpowers u) {v : Unit → G} :
    (∃ φ ∈ (centralizer u).branchHoms (.id G), φ (t 0) = v ()) ↔
      v ∈ V (.id G) {⁅(inr (FreeGroup.of ()) : GX G Unit), (inl u : GX G Unit)⁆} := by
  rw [exists_mem_branchHoms_centralizer_apply_t_eq_iff_mem_zpowers, V_singleton_commutatorElement,
    Set.mem_ofPred_eq, MonoidHom.id_apply]
  exact ⟨fun h => zpowers_le.2 (mem_centralizer_singleton_iff.2 rfl) h, fun h => hu h⟩

/-- Without modular automorphisms, the only branch composite of the three-vertex diagram of
`G(u, ℤ)` is the quotient `t ↦ 1`. -/
theorem mem_branchHoms_centralizerOfModular_bot
    {φ : GHom (of : G →* CentralizerExt u 1) (.id G)} :
    φ ∈ (centralizerOfModular u ⊥ bot_le).branchHoms (.id G) ↔ φ = retractionGHom 0 := by
  rw [mem_branchHoms_centralizerOfModular]
  constructor
  · rintro ⟨σ, hσ, h⟩
    obtain rfl := mem_bot.1 hσ
    exact GHom.ext fun x => by simpa using h x
  · rintro rfl
    exact ⟨1, mem_bot.2 rfl, fun x => by simp⟩

/-- Without modular automorphisms, the only branch composite of the three-vertex diagram of
`G(u, ℤ)` is the quotient `t ↦ 1`. -/
@[simp]
theorem branchHoms_centralizerOfModular_bot :
    (centralizerOfModular u ⊥ bot_le).branchHoms (.id G) = {retractionGHom 0} :=
  Set.ext fun _ => mem_branchHoms_centralizerOfModular_bot

/-- Without modular automorphisms, the three-vertex diagram of `G(u, ℤ)` is not complete for
`u ≠ 1`: it misses the solution `x = u` of `[x, u] = 1`. -/
theorem not_isComplete_centralizerOfModular_bot (hu : u ≠ 1) :
    ¬(centralizerOfModular u ⊥ bot_le).IsComplete (.id G) := fun h =>
  hu <| by
    simpa using DFunLike.congr_fun (mem_branchHoms_centralizerOfModular_bot.1
      (isComplete_iff.1 h (retractionGHom fun _ => 1))) (t 0)

end MRDiagram

end TauCeti.LimitGroup
