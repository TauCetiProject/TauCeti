/-!
# Residual freeness of the closed surface groups `S⁺(2, 0)` and `S⁻(3, 0)`

The closed surface groups that are not fully residually free are those of the projective plane,
the Klein bottle and the nonorientable surface of genus three; all others are. This file proves
that the orientable surface group of genus two is fully residually free and that the nonorientable
surface group of genus three is not even residually free.

Let `F₂` be the free group on `a = FreeGroup.of 0` and `b = FreeGroup.of 1`, and let
`c = a⁻¹ b⁻¹ a b` be their commutator in the surface convention `[x, y] = x⁻¹ y⁻¹ x y`. The closed
orientable surface group `S⁺(2, 0) = ⟨a₁, b₁, a₂, b₂ | [a₁, b₁] [a₂, b₂] = 1⟩` is the double
`F₂ ∗_{⟨c⟩} F₂` of `F₂` along the cyclic subgroup generated by `c`: the relation says
`[a₁, b₁] = [b₂, a₂]`, so `a₁, b₁` and `b₂, a₂` span two copies of `F₂` amalgamated along `c`.
Since `c` is not a proper power, `⟨c⟩` is the centralizer of `c` in `F₂`. A double embeds in the
HNN extension along the identity of its amalgamated subgroup (`HNNExtension.ofDouble_injective`),
so the double lies in the extension `F₂(c, ℤ) = F₂ ∗_{⟨c⟩} (⟨c⟩ × ⟨t⟩)` of the centralizer of `c`,
as the subgroup generated by `F₂` and `t F₂ t⁻¹`. Extensions of centralizers of free groups are
fully residually free, hence so is `S⁺(2, 0)`. This is the argument of Champetier and Guirardel
for B. Baumslag's theorem that the double of a free group along a maximal cyclic subgroup is fully
residually free, applied to genus two as in G. Baumslag's work on surface groups.

The nonorientable surface group `S⁻(3, 0) = ⟨c₁, c₂, c₃ | c₁ ^ 2 c₂ ^ 2 c₃ ^ 2⟩` behaves
differently. By Lyndon's theorem, three elements `x`, `y`, `z` of a free group with
`x ^ 2 y ^ 2 z ^ 2 = 1` commute pairwise: free groups satisfy Vaught's condition
(`IsFreeGroup.isVaught`). Hence every homomorphism from `S⁻(3, 0)` to a free group, or to any
group satisfying Vaught's condition, has commutative image. Since `c₁` and `c₂` do not commute
(`TauCeti.SurfaceGroup.Nonorientable.commute_c_iff`), the commutator `⁅c₁, c₂⁆` is a nontrivial
element killed by every homomorphism to a free group, so `S⁻(3, 0)` is not residually free.

## Main definitions

* `TauCeti.SurfaceGroup.Orientable.genusTwoToCentralizerExt`: the embedding
  `S⁺(2, 0) →* F₂(c, ℤ)`, `a₁ ↦ a`, `b₁ ↦ b`, `a₂ ↦ t b t⁻¹`, `b₂ ↦ t a t⁻¹`.

## Main results

* `TauCeti.SurfaceGroup.Orientable.genusTwoToCentralizerExt_injective`: `S⁺(2, 0)` embeds in the
  extension of the centralizer of `[a, b]` in `F₂`.
* `TauCeti.LimitGroup.isFullyResiduallyFree_orientable_two_zero`: `S⁺(2, 0)` is fully residually
  free.
* `TauCeti.SurfaceGroup.Nonorientable.isMulCommutative_range_of_isVaught`: every homomorphism from
  `S⁻(3, 0)` to a group satisfying Vaught's condition has commutative image.
* `TauCeti.LimitGroup.not_isResiduallyFree_nonorientable_three_zero`: `S⁻(3, 0)` is not
  residually free.

## References

* G. Baumslag, *On generalised free products*, Math. Z. 78 (1962), 423–438.
* B. Baumslag, *Residually free groups*, Proc. London Math. Soc. (3) 17 (1967), 402–418.
* C. Champetier, V. Guirardel, *Limit groups as limits of free groups*, Israel J. Math. 146
  (2005), §3.2, Corollary 3.6 and the paragraph on surface groups that follows it.
* R. C. Lyndon, *The equation `a²b² = c²` in free groups*, Michigan Math. J. 6 (1959).
* O. Kharlampovich, A. Myasnikov, *Implicit function theorem over free groups*, J. Algebra 290
  (2005), §3.1, Definition 7 and the proof of Lemma 2.
-/

public section

open Subgroup
open scoped commutatorElement

namespace TauCeti

namespace SurfaceGroup.Orientable

open LimitGroup

/-- The commutator `c = a⁻¹ b⁻¹ a b` of the basis elements `a = FreeGroup.of 0` and
`b = FreeGroup.of 1` of `F₂`. -/
private abbrev commF₂ : FreeGroup (Fin 2) :=
  (FreeGroup.of 0)⁻¹ * (FreeGroup.of 1)⁻¹ * FreeGroup.of 0 * FreeGroup.of 1

/-- In `F₂`, the centralizer of `c = a⁻¹ b⁻¹ a b` is the cyclic group it generates. -/
private theorem centralizer_commF₂ : centralizer {commF₂} = zpowers commF₂ :=
  IsFreeGroup.centralizer_singleton_eq_zpowers_self
    (FreeGroup.not_isProperPower_inv_mul_inv_mul_mul (by decide))

/-- The defining relation of `S⁺(2, 0)` as an equality of commutators: `[a₁, b₁] = [b₂, a₂]`. -/
private theorem commutator_eq : (b 2 0 1)⁻¹ * (a 2 0 1)⁻¹ * b 2 0 1 * a 2 0 1 =
    (a 2 0 0)⁻¹ * (b 2 0 0)⁻¹ * a 2 0 0 * b 2 0 0 := by
  have h := orientableWord_a_b_peripheral 2 0
  rw [orientableWord_def] at h
  simp only [List.ofFn_succ, List.ofFn_zero, List.prod_cons, List.prod_nil, mul_one,
    Fin.succ_zero_eq_one] at h
  rw [eq_inv_of_mul_eq_one_left h]
  simp [mul_assoc]

/-- The double `F₂ ∗_{C(c)} F₂` of `F₂` along the centralizer of `c = a⁻¹ b⁻¹ a b`. -/
private abbrev Double : Type :=
  Monoid.PushoutI fun _ : Bool => (centralizer {commF₂}).subtype

/-- `S⁺(2, 0)` maps to the double: `a₁, b₁` go to `a, b` in the first copy and `a₂, b₂` to `b, a`
in the second. -/
private def toDouble : Orientable 2 0 →* Double :=
  lift ![Monoid.PushoutI.of false (FreeGroup.of 0), Monoid.PushoutI.of true (FreeGroup.of 1)]
    ![Monoid.PushoutI.of false (FreeGroup.of 1), Monoid.PushoutI.of true (FreeGroup.of 0)]
    Fin.elim0 <| by
      -- Both copies of `c` are the image of `c` in the amalgamated subgroup.
      have hc : (Monoid.PushoutI.of false commF₂ : Double) = Monoid.PushoutI.of true commF₂ :=
        (Monoid.PushoutI.of_apply_eq_base (fun _ : Bool => (centralizer {commF₂}).subtype) false
          ⟨commF₂, mem_centralizer_singleton_iff.2 rfl⟩).trans
          (Monoid.PushoutI.of_apply_eq_base _ true _).symm
      calc _ = (Monoid.PushoutI.of false commF₂ : Double) * (Monoid.PushoutI.of true commF₂)⁻¹ := by
            simp [orientableWord_def, List.ofFn_succ, commF₂, mul_assoc]
        _ = 1 := by rw [hc, mul_inv_cancel]

/-- The inverse of `toDouble`: the first copy of `F₂` goes to `⟨a₁, b₁⟩` and the second to
`⟨b₂, a₂⟩`. -/
private def fromDouble : Double →* Orientable 2 0 :=
  Monoid.PushoutI.lift
    (fun i => cond i (FreeGroup.lift ![b 2 0 1, a 2 0 1]) (FreeGroup.lift ![a 2 0 0, b 2 0 0]))
    ((FreeGroup.lift ![a 2 0 0, b 2 0 0]).comp (centralizer {commF₂}).subtype) fun i => by
      cases i
      · rfl
      · ext ⟨x, hx⟩
        rw [centralizer_commF₂] at hx
        obtain ⟨k, rfl⟩ := mem_zpowers_iff.1 hx
        simp [commutator_eq]

private theorem fromDouble_toDouble (x : Orientable 2 0) : fromDouble (toDouble x) = x := by
  have h : fromDouble.comp toDouble = MonoidHom.id _ :=
    hom_ext (by simp [Fin.forall_fin_two, toDouble, fromDouble])
      (by simp [Fin.forall_fin_two, toDouble, fromDouble]) finZeroElim
  exact DFunLike.congr_fun h x

/-- The embedding of the closed surface group `S⁺(2, 0)` in the extension `F₂(c, ℤ)` of the
centralizer of `c = a⁻¹ b⁻¹ a b` in the free group `F₂` on `a = FreeGroup.of 0` and
`b = FreeGroup.of 1`: it sends `a₁, b₁` to `a, b` and `a₂, b₂` to `t b t⁻¹, t a t⁻¹`, where `t` is
the new letter. -/
def genusTwoToCentralizerExt : Orientable 2 0 →* CentralizerExt
    ((FreeGroup.of 0)⁻¹ * (FreeGroup.of 1)⁻¹ * FreeGroup.of 0 * FreeGroup.of 1 :
      FreeGroup (Fin 2)) 1 :=
  (CentralizerExt.equivHNNExtension.symm.toMonoidHom.comp (HNNExtension.ofDouble _)).comp toDouble

@[simp]
theorem genusTwoToCentralizerExt_a_zero :
    genusTwoToCentralizerExt (a 2 0 0) = CentralizerExt.of (FreeGroup.of 0) := by
  simp [genusTwoToCentralizerExt, toDouble]

@[simp]
theorem genusTwoToCentralizerExt_b_zero :
    genusTwoToCentralizerExt (b 2 0 0) = CentralizerExt.of (FreeGroup.of 1) := by
  simp [genusTwoToCentralizerExt, toDouble]

@[simp]
theorem genusTwoToCentralizerExt_a_one :
    genusTwoToCentralizerExt (a 2 0 1) =
      CentralizerExt.t 0 * CentralizerExt.of (FreeGroup.of 1) * (CentralizerExt.t 0)⁻¹ := by
  simp [genusTwoToCentralizerExt, toDouble]

@[simp]
theorem genusTwoToCentralizerExt_b_one :
    genusTwoToCentralizerExt (b 2 0 1) =
      CentralizerExt.t 0 * CentralizerExt.of (FreeGroup.of 0) * (CentralizerExt.t 0)⁻¹ := by
  simp [genusTwoToCentralizerExt, toDouble]

/-- The closed surface group `S⁺(2, 0)` embeds in the extension of the centralizer of the
commutator `a⁻¹ b⁻¹ a b` of the two basis elements of the free group of rank two. -/
theorem genusTwoToCentralizerExt_injective : Function.Injective genusTwoToCentralizerExt :=
  CentralizerExt.equivHNNExtension.symm.injective.comp <|
    (HNNExtension.ofDouble_injective _).comp
      (Function.LeftInverse.injective fromDouble_toDouble)

end SurfaceGroup.Orientable

namespace SurfaceGroup.Nonorientable

/-- Every homomorphism from the closed nonorientable surface group
`S⁻(3, 0) = ⟨c₁, c₂, c₃ | c₁ ^ 2 c₂ ^ 2 c₃ ^ 2⟩` to a group satisfying Vaught's condition, such as
a free group, has commutative image. -/
theorem isMulCommutative_range_of_isVaught {H : Type*} [Group H] (hH : Group.IsVaught H)
    (f : Nonorientable 3 0 →* H) : IsMulCommutative f.range := by
  -- An element commuting with the images of `c₁, c₂, c₃` commutes with the whole image.
  have key {a : H} (ha : ∀ i, Commute a (f (c 3 0 i))) (x : Nonorientable 3 0) :
      Commute a (f x) := by
    have : (MulAut.conj a).toMonoidHom.comp f = f :=
      hom_ext (fun i ↦ by simp [(ha i).eq]) finZeroElim
    simpa [commute_iff_eq, mul_inv_eq_iff_eq_mul] using DFunLike.congr_fun this x
  have h : f (c 3 0 0) ^ 2 * f (c 3 0 1) ^ 2 * f (c 3 0 2) ^ 2 = 1 := by
    simpa [map_nonorientableWord, nonorientableWord_def, List.ofFn_succ, mul_assoc] using
      congrArg f (nonorientableWord_c_peripheral 3 0)
  obtain ⟨h01, h02, h12⟩ := (Group.isVaught_iff H).1 hH _ _ _ h
  have hc (i j : Fin 3) : Commute (f (c 3 0 i)) (f (c 3 0 j)) := by
    fin_cases i <;> fin_cases j <;> simp [h01, h02, h12, h01.symm, h02.symm, h12.symm]
  refine isMulCommutative_iff.2 ?_
  rintro ⟨_, x, rfl⟩ ⟨_, y, rfl⟩
  exact Subtype.ext (key (fun i ↦ (key (hc i) x).symm) y).eq

end SurfaceGroup.Nonorientable

namespace LimitGroup

/-- **G. Baumslag.** The fundamental group `S⁺(2, 0)` of the closed orientable surface of genus two
is fully residually free. -/
theorem isFullyResiduallyFree_orientable_two_zero :
    IsFullyResiduallyFree (SurfaceGroup.Orientable 2 0) :=
  (isFullyResiduallyFree_centralizerExt
    (isFullyResiduallyFree_of_isFreeGroup (G := FreeGroup (Fin 2)))
    (Group.ne_one_of_not_isProperPower
      (FreeGroup.not_isProperPower_inv_mul_inv_mul_mul (by decide)))).of_injective
    SurfaceGroup.Orientable.genusTwoToCentralizerExt_injective

section Nonorientable

open SurfaceGroup.Nonorientable

/-- **Lyndon.** The fundamental group `S⁻(3, 0) = ⟨c₁, c₂, c₃ | c₁ ^ 2 c₂ ^ 2 c₃ ^ 2⟩` of the closed
nonorientable surface of genus three is not residually free: every homomorphism to a free group
kills the nontrivial commutator `⁅c₁, c₂⁆`. -/
theorem not_isResiduallyFree_nonorientable_three_zero :
    ¬IsResiduallyFree (SurfaceGroup.Nonorientable 3 0) := by
  rw [isResiduallyFree_def]
  push Not
  refine ⟨⁅c 3 0 0, c 3 0 1⁆, by simp [commutatorElement_eq_one_iff_commute], fun ι φ ↦ ?_⟩
  -- By Lyndon's theorem the image of `φ` in the free group `FreeGroup ι` is commutative.
  have := isMulCommutative_iff.1 (isMulCommutative_range_of_isVaught IsFreeGroup.isVaught φ)
    ⟨_, φ.mem_range.2 ⟨c 3 0 0, rfl⟩⟩ ⟨_, φ.mem_range.2 ⟨c 3 0 1, rfl⟩⟩
  simpa [map_commutatorElement, commutatorElement_eq_one_iff_commute, commute_iff_eq,
    Subtype.ext_iff] using this

end Nonorientable

end LimitGroup

end TauCeti
