variable {X : Type*} [MeasurableSpace X] [MeasurableSingletonClass X] [DecidableEq X]

/-- For a finite nonempty `F`, the counting-measure Følner ratio of `F` at `m` is below
`ENNReal.ofReal ε` exactly when `|mF △ F| < ε · |F|`. -/
@[to_additive MeasureTheory.Measure.count_vadd_symmDiff_div_count_lt_ofReal_iff
  /-- For a finite nonempty `F`, the counting-measure additive Følner ratio of `F` at `m` is below
  `ENNReal.ofReal ε` exactly when `|(m +ᵥ F) △ F| < ε · |F|`. -/]
theorem MeasureTheory.Measure.count_smul_symmDiff_div_count_lt_ofReal_iff {M : Type*}
    [SMul M X] {F : Finset X} (hF : F.Nonempty) (m : M) {ε : ℝ} :
    Measure.count ((m • (F : Set X)) ∆ F) / Measure.count (F : Set X) < ENNReal.ofReal ε ↔
      (#((m • F) ∆ F) : ℝ) < ε * #F := by
  -- Turn the counting measures into cardinalities.
  simp only [← coe_smul_finset, ← coe_symmDiff, Measure.count_apply_finset]
  exact ENNReal.natCast_div_natCast_lt_ofReal_iff (Finset.card_pos.2 hF)

omit [MeasurableSingletonClass X] in
/-- The counting-measure Følner ratio of a measurable finite set bounds the cardinality ratio
from above. -/
@[to_additive MeasureTheory.Measure.card_vadd_symmDiff_div_card_le_count_div_count
  /-- The counting-measure additive Følner ratio of a measurable finite set bounds the cardinality
  ratio from above. -/]
theorem MeasureTheory.Measure.card_smul_symmDiff_div_card_le_count_div_count {M : Type*}
    [SMul M X] {F : Finset X} (hFm : MeasurableSet (F : Set X)) (m : M) :
    (#((m • F) ∆ F) : ℝ≥0∞) / #F ≤
      Measure.count ((m • (F : Set X)) ∆ F) / Measure.count (F : Set X) := by
  rw [Measure.count_apply_finset' hFm]
  refine ENNReal.div_le_div_right ?_ _
  rw [← coe_smul_finset, ← coe_symmDiff]
  calc (#((m • F) ∆ F) : ℝ≥0∞) = ∑' _ : (((m • F) ∆ F : Finset X) : Set X), (1 : ℝ≥0∞) := by simp
    _ ≤ _ := Measure.le_count_apply

omit [MeasurableSingletonClass X] in
/-- The real cardinality ratios of a counting-measure Følner family of finite sets tend to
zero for every group element. -/
@[to_additive IsAddFoelner.tendsto_card_vadd_symmDiff_div_card
  /-- The real cardinality ratios of a counting-measure additive Følner family of finite sets tend
  to zero for every group element. -/]
theorem IsFoelner.tendsto_card_smul_symmDiff_div_card [MulAction G X] {ι : Type*}
    {l : Filter ι} {F : ι → Finset X}
    (hF : IsFoelner G Measure.count l (fun i => (F i : Set X))) (g : G) :
    Tendsto (fun i => (#((g • F i) ∆ F i) : ℝ) / #(F i)) l (𝓝 0) := by
  have hlimit := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp
    (hF.tendsto_meas_smul_symmDiff g)
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hlimit
    (Eventually.of_forall fun i => by positivity) ?_
  filter_upwards [hF.eventually_measurableSet,
    (hF.tendsto_meas_smul_symmDiff g).eventually (gt_mem_nhds zero_lt_one)] with i hFm hlt
  have hle := Measure.card_smul_symmDiff_div_card_le_count_div_count hFm g
  have := ENNReal.toReal_mono hlt.ne_top hle
  simpa [ENNReal.toReal_div, Function.comp_def] using this

omit [MeasurableSingletonClass X] in
/-- A Følner family for counting measure along a nontrivial filter passes every finite test: for
each finite `K ⊆ G` and `ε > 0` there is a finite nonempty `F ⊆ X` with `|gF △ F| < ε · |F|` for
all `g ∈ K`. -/
@[to_additive /-- An additive Følner family for counting measure along a nontrivial filter passes
every finite test: for each finite `K ⊆ G` and `ε > 0` there is a finite nonempty `F ⊆ X` with
`|(g +ᵥ F) △ F| < ε · |F|` for all `g ∈ K`. -/]
theorem IsFoelner.exists_finset_card_smul_symmDiff_lt [MulAction G X] {ι : Type*}
    {l : Filter ι} [l.NeBot] {F : ι → Set X} (hF : IsFoelner G Measure.count l F)
    (K : Finset G) {ε : ℝ} (hε : 0 < ε) :
    ∃ F' : Finset X, F'.Nonempty ∧ ∀ g ∈ K, (#((g • F') ∆ F') : ℝ) < ε * #F' := by
  have hK : ∀ᶠ i in l, ∀ g ∈ K,
      Measure.count ((g • F i) ∆ F i) / Measure.count (F i) < ENNReal.ofReal ε :=
    (eventually_all_finset K).2 fun g _ =>
      (hF.tendsto_meas_smul_symmDiff g).eventually (gt_mem_nhds (ENNReal.ofReal_pos.2 hε))
  obtain ⟨i, hi0, hitop, hmeas, hiK⟩ :=
    (hF.eventually_meas_ne_zero.and (hF.eventually_meas_ne_top.and
      (hF.eventually_measurableSet.and hK))).exists
  have hfin : (F i).Finite := (Measure.count_apply_lt_top' hmeas).1 (lt_top_iff_ne_top.2 hitop)
  have hne : hfin.toFinset.Nonempty := by
    simpa [← Set.ne_empty_iff_nonempty] using mt Measure.count_eq_zero_iff.2 hi0
  have hmeas' : MeasurableSet (hfin.toFinset : Set X) := by simpa using hmeas
  refine ⟨hfin.toFinset, hne, fun g hg => ?_⟩
  have hlt := (Measure.card_smul_symmDiff_div_card_le_count_div_count hmeas' g).trans_lt
    (by simpa only [Set.Finite.coe_toFinset] using hiK g hg)
  exact (ENNReal.natCast_div_natCast_lt_ofReal_iff (Finset.card_pos.2 hne)).1 hlt

namespace TauCeti

/-- If every finite test has a witness, then there is a Følner family of finite nonempty sets for
counting measure, indexed by `Finset G × ℕ` along `atTop`. -/
@[to_additive exists_isAddFoelner_atTop /-- If every finite test has a witness, then there is an
additive Følner family of finite nonempty sets for counting measure, indexed by `Finset G × ℕ`
along `atTop`. -/]
theorem exists_isFoelner_atTop [MulAction G X]
    (h : ∀ K : Finset G, ∀ ε : ℝ, 0 < ε →
      ∃ F : Finset X, F.Nonempty ∧ ∀ g ∈ K, (#((g • F) ∆ F) : ℝ) < ε * #F) :
    ∃ F : Finset G × ℕ → Finset X, (∀ i, (F i).Nonempty) ∧
      IsFoelner G Measure.count atTop (fun i => (F i : Set X)) := by
  -- At `(K, n)`, take a witness for the test set `K` with tolerance `1 / (n + 1)`.
  choose F hne hlt using fun i : Finset G × ℕ => h i.1 (1 / (i.2 + 1)) (by positivity)
  refine ⟨F, hne, Eventually.of_forall fun i => (F i).measurableSet,
    Eventually.of_forall fun i => by simp [Measure.count_apply_finset, (hne i).ne_empty],
    Eventually.of_forall fun i => by simp [Measure.count_apply_finset], fun g => ?_⟩
  -- The ratio is eventually below `ofReal (1 / (n + 1))`, which tends to `0` with `n`.
  have hsnd : Tendsto (fun i : Finset G × ℕ => i.2) atTop atTop :=
    tendsto_atTop_atTop_of_monotone (fun _ _ h => h.2) fun n => ⟨(∅, n), le_rfl⟩
  have hbound : Tendsto (fun i : Finset G × ℕ => ENNReal.ofReal (1 / (i.2 + 1))) atTop (𝓝 0) := by
    simpa [Function.comp_def] using
      (ENNReal.tendsto_ofReal tendsto_one_div_add_atTop_nhds_zero_nat).comp hsnd
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hbound
    (Eventually.of_forall fun _ => zero_le) ?_
  filter_upwards [eventually_ge_atTop ({g}, 0)] with i hi
  refine ((Measure.count_smul_symmDiff_div_count_lt_ofReal_iff (hne i) g).2 (hlt i g ?_)).le
  exact hi.1 (mem_singleton_self g)

end TauCeti

end Count

namespace TauCeti

variable (G) in
/-- A group `G` has Følner sets when Mathlib's maximal Følner filter for the left regular action
of `G` on itself with counting measure is nontrivial. The measurable space `⊤` is installed
locally, so every subset of `G` is measurable and the notion depends only on the group. -/
@[to_additive HasAddFoelnerSets /-- An additive group `G` has Følner sets when Mathlib's maximal
additive Følner filter for the left regular action of `G` on itself with counting measure is
nontrivial. The measurable space `⊤` is installed locally, so every subset of `G` is measurable and
the notion depends only on the additive group. -/]
abbrev HasFoelnerSets : Prop :=
  letI : MeasurableSpace G := ⊤
  NeBot (maxFoelner G (Measure.count : Measure G))

/-- A group has Følner sets exactly when for every finite `K ⊆ G` and every `ε > 0` there is a
finite nonempty `F ⊆ G` with `|gF △ F| < ε · |F|` for all `g ∈ K`. -/
@[to_additive hasAddFoelnerSets_iff /-- An additive group has Følner sets exactly when for every
finite `K ⊆ G` and every `ε > 0` there is a finite nonempty `F ⊆ G` with `|(g +ᵥ F) △ F| < ε · |F|`
for all `g ∈ K`. -/]
theorem hasFoelnerSets_iff [DecidableEq G] : HasFoelnerSets G ↔
    ∀ K : Finset G, ∀ ε : ℝ, 0 < ε →
      ∃ F : Finset G, F.Nonempty ∧ ∀ g ∈ K, (#((g • F) ∆ F) : ℝ) < ε * #F := by
  let : MeasurableSpace G := ⊤
  refine ⟨fun h K ε hε => (isFoelner_maxFoelner G Measure.count).exists_finset_card_smul_symmDiff_lt
    K hε, fun h => ?_⟩
  obtain ⟨F, -, hF⟩ := exists_isFoelner_atTop h
  exact ((isFoelner_iff_tendsto _ _).1 hF).neBot

/-- A counting-measure Følner family along a nontrivial filter witnesses `HasFoelnerSets`, for any
measurable space on `G`. -/
@[to_additive IsAddFoelner.hasAddFoelnerSets /-- An additive counting-measure Følner family along a
nontrivial filter witnesses `HasAddFoelnerSets`, for any measurable space on `G`. -/]
theorem _root_.IsFoelner.hasFoelnerSets [MeasurableSpace G] {ι : Type*} {l : Filter ι} [l.NeBot]
    {F : ι → Set G} (hF : IsFoelner G Measure.count l F) : HasFoelnerSets G := by
  classical
  exact hasFoelnerSets_iff.2 fun K _ hε => hF.exists_finset_card_smul_symmDiff_lt K hε

/-- For any measurable space on `G` with measurable singletons, nontriviality of the maximal
counting-measure Følner filter agrees with `HasFoelnerSets G`. -/
@[to_additive hasAddFoelnerSets_iff_maxAddFoelner_neBot /-- For any measurable space on `G` with
measurable singletons, nontriviality of the maximal counting-measure additive Følner filter agrees
with `HasAddFoelnerSets G`. -/]
theorem hasFoelnerSets_iff_maxFoelner_neBot [MeasurableSpace G] [MeasurableSingletonClass G] :
    HasFoelnerSets G ↔ NeBot (maxFoelner G (Measure.count : Measure G)) := by
  classical
  refine ⟨fun h => ?_, fun _ => (isFoelner_maxFoelner G Measure.count).hasFoelnerSets⟩
  obtain ⟨F, -, hF⟩ := exists_isFoelner_atTop (hasFoelnerSets_iff.1 h)
  exact ((isFoelner_iff_tendsto _ _).1 hF).neBot

/-- A group has Følner sets if a family of eventually nonempty finite sets has vanishing
relative translation boundaries along a nontrivial filter. -/
@[to_additive HasAddFoelnerSets.of_tendsto_card_vadd_symmDiff_div_card /-- An additive group has
Følner sets if a family of eventually nonempty finite sets has vanishing relative translation
boundaries along a nontrivial filter. -/]
theorem HasFoelnerSets.of_tendsto_card_smul_symmDiff_div_card [DecidableEq G] {ι : Type*}
    {l : Filter ι} [l.NeBot] {F : ι → Finset G} (hne : ∀ᶠ i in l, (F i).Nonempty)
    (hF : ∀ g : G, Tendsto (fun i => (#((g • F i) ∆ F i) : ℝ) / #(F i)) l (𝓝 0)) :
    HasFoelnerSets G := by
  rw [hasFoelnerSets_iff]
  intro K ε hε
  have hevent : ∀ᶠ i in l, ∀ g ∈ K, (#((g • F i) ∆ F i) : ℝ) / #(F i) < ε :=
    (eventually_all_finset K).2 fun g _ => (hF g).eventually (gt_mem_nhds hε)
  obtain ⟨i, hni, hi⟩ := (hne.and hevent).exists
  exact ⟨F i, hni, fun g hg =>
    (div_lt_iff₀ (by exact_mod_cast hni.card_pos)).1 (hi g hg)⟩

/-- Every finite group has Følner sets, witnessed by the whole group. -/
@[to_additive /-- Every finite additive group has additive Følner sets, witnessed by the whole
  group. -/]
theorem HasFoelnerSets.of_finite [Finite G] : HasFoelnerSets G := by
  classical
  let := Fintype.ofFinite G
  rw [hasFoelnerSets_iff]
  refine fun _ _ hε ↦ ⟨Finset.univ, Finset.univ_nonempty, fun g _ ↦ ?_⟩
  have hsmul : g • (Finset.univ : Finset G) = Finset.univ :=
    Finset.eq_univ_of_forall fun x ↦
      Finset.mem_smul_finset.mpr ⟨g⁻¹ * x, Finset.mem_univ _, mul_inv_cancel_left g x⟩
  rw [hsmul, symmDiff_self]
  simp only [bot_eq_empty, card_empty, Nat.cast_zero, card_univ]
  exact mul_pos hε (Nat.cast_pos.2 Fintype.card_pos)

/-- If every finite test on finite subsets of `S ⊆ G` has a witness, then so does every finite test
on a finite subset `K` of the subgroup generated by `S`: for every `ε > 0` some finite nonempty
`F ⊆ X` satisfies `|gF △ F| < ε · |F|` for all `g ∈ K`. -/
@[to_additive /-- If every finite test on finite subsets of `S ⊆ G` has a witness, then so does
every finite test on a finite subset `K` of the additive subgroup generated by `S`: for every
`ε > 0` some finite nonempty `F ⊆ X` satisfies `|(g +ᵥ F) △ F| < ε · |F|` for all `g ∈ K`. -/]
theorem exists_finset_card_smul_symmDiff_lt_of_subset_closure {X : Type*} [MulAction G X]
    [DecidableEq X] {S : Set G}
    (hS : ∀ T : Finset G, (T : Set G) ⊆ S → ∀ ε : ℝ, 0 < ε →
      ∃ F : Finset X, F.Nonempty ∧ ∀ s ∈ T, (#((s • F) ∆ F) : ℝ) < ε * #F)
    {K : Finset G} (hK : (K : Set G) ⊆ Subgroup.closure S) {ε : ℝ} (hε : 0 < ε) :
    ∃ F : Finset X, F.Nonempty ∧ ∀ g ∈ K, (#((g • F) ∆ F) : ℝ) < ε * #F := by
  classical
  -- Each `g ∈ K` is controlled by `n g` times the boundaries of the elements of `T g ⊆ S`.
  choose T hTS n hn using fun g : K =>
    exists_card_smul_finset_symmDiff_le_mul_sum (X := X) (hK g.property)
  set U := univ.biUnion T
  set N := ∑ g : K, n g
  have hU : (U : Set G) ⊆ S := by
    rw [coe_biUnion]
    exact Set.iUnion₂_subset fun g _ => hTS g
  have hδ : 0 < ε / ((N + 1) * (#U + 1)) := by positivity
  -- Test the elements of `U` with a tolerance small enough to absorb the factor `N * #U`.
  obtain ⟨F, hF, hFU⟩ := hS U hU _ hδ
  refine ⟨F, hF, fun g hg => ?_⟩
  have hF₀ : (0 : ℝ) < #F := by exact_mod_cast hF.card_pos
  have hgU : #((g • F) ∆ F) ≤ N * ∑ t ∈ U, #((t • F) ∆ F) :=
    (hn ⟨g, hg⟩ F).trans (Nat.mul_le_mul
      (single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (mem_univ _))
      (sum_le_sum_of_subset (subset_biUnion_of_mem T (mem_univ _))))
  have hsum : ∑ t ∈ U, (#((t • F) ∆ F) : ℝ) ≤ #U * (ε / ((N + 1) * (#U + 1)) * #F) := by
    simpa using sum_le_card_nsmul U (fun t => (#((t • F) ∆ F) : ℝ)) _ fun t ht => (hFU t ht).le
  have hNU : (N : ℝ) * #U < (N + 1) * (#U + 1) := by nlinarith [N.cast_nonneg (α := ℝ)]
  calc (#((g • F) ∆ F) : ℝ) ≤ N * ∑ t ∈ U, (#((t • F) ∆ F) : ℝ) := by exact_mod_cast hgU
    _ ≤ N * (#U * (ε / ((N + 1) * (#U + 1)) * #F)) := by gcongr
    _ = (N * #U) / ((N + 1) * (#U + 1)) * (ε * #F) := by ring
    _ < ε * #F := by
      apply mul_lt_of_lt_one_left (by positivity)
      rwa [div_lt_one (by positivity)]

/-- **Orbit pigeonhole.** If a finite set `F : Finset Z` has total translation boundary
`∑_{g ∈ K} |g • F ∆ F| < ε |F|`, then some orbit slice of `F` at a point `z₀ ∈ F` maps along
`MulAction.orbitEquivQuotientStabilizer` to a finite nonempty
`F₁ : Finset (G ⧸ MulAction.stabilizer G z₀)` with `|g • F₁ ∆ F₁| < ε |F₁|` for all `g ∈ K`. -/
theorem exists_quotient_finset_of_sum_card_smul_symmDiff_lt {Z : Type*} [MulAction G Z]
    [DecidableEq Z] [∀ z : Z, DecidableEq (G ⧸ MulAction.stabilizer G z)]
    {K : Finset G} {ε : ℝ} {F : Finset Z}
    (h : ∑ g ∈ K, (#((g • F) ∆ F) : ℝ) < ε * #F) :
    ∃ z₀ ∈ F, ∃ F₁ : Finset (G ⧸ MulAction.stabilizer G z₀),
      F₁.Nonempty ∧ ∀ g ∈ K, (#((g • F₁) ∆ F₁) : ℝ) < ε * #F₁ := by
  classical
  -- Decompose `F` and each translation boundary fiberwise over the `G`-orbit space.
  let π : Z → MulAction.orbitRel.Quotient G Z := Quotient.mk _
  have hπ (g : G) (z : Z) : π (g • z) = π z := Quotient.sound ⟨g, rfl⟩
  let O : Finset (MulAction.orbitRel.Quotient G Z) := F.image π
  let slice (o : MulAction.orbitRel.Quotient G Z) : Finset Z := F.filter (π · = o)
  have hcard_F : (#F : ℝ) = ∑ o ∈ O, (#(slice o) : ℝ) := by
    exact_mod_cast Finset.card_eq_sum_card_image π F
  have hcard_symm (g : G) :
      (#((g • F) ∆ F) : ℝ) = ∑ o ∈ O, (#((g • slice o) ∆ slice o) : ℝ) := by
    exact_mod_cast Finset.card_smul_finset_symmDiff_eq_sum_image (hπ g) F
  have hsum_lt : ∑ o ∈ O, ∑ g ∈ K, (#((g • slice o) ∆ slice o) : ℝ) <
      ∑ o ∈ O, ε * #(slice o) := by
    rw [sum_comm]
    simp_rw [← hcard_symm, ← mul_sum, ← hcard_F]
    exact h
  -- Pigeonhole selects a nonempty orbit slice `S = slice (π z₀)` with small total boundary.
  obtain ⟨o, hoO, ho_lt⟩ := exists_lt_of_sum_lt hsum_lt
  obtain ⟨z₀, hz₀F, rfl⟩ := mem_image.mp hoO
  let S : Finset Z := slice (π z₀)
  have hz₀S : z₀ ∈ S := mem_filter.mpr ⟨hz₀F, rfl⟩
  have hmem_orb (z : Z) (hz : z ∈ S) : z ∈ MulAction.orbit G z₀ :=
    Quotient.exact (mem_filter.mp hz).2
  -- Transport `S` into `orbit G z₀` and then to `G ⧸ stabilizer G z₀`.
  let F' : Finset (MulAction.orbit G z₀) := S.subtype (· ∈ MulAction.orbit G z₀)
  let e := MulAction.orbitEquivQuotientStabilizer G z₀
  let F₁ : Finset (G ⧸ MulAction.stabilizer G z₀) := F'.image e
  have hval_F' : F'.image Subtype.val = S := by
    simpa [F', map_eq_image] using subtype_map_of_mem hmem_orb
  have hF'_ne : F'.Nonempty := ⟨⟨z₀, MulAction.mem_orbit_self z₀⟩, mem_subtype.mpr hz₀S⟩
  have hF₁_card : #F₁ = #S := by
    rw [card_image_of_injective _ e.injective, ← hval_F',
      card_image_of_injective _ Subtype.val_injective]
  refine ⟨z₀, hz₀F, F₁, hF'_ne.image e, fun g hg ↦ ?_⟩
  have hsingle : (#((g • S) ∆ S) : ℝ) < ε * #S :=
    (single_le_sum (f := fun g ↦ (#((g • S) ∆ S) : ℝ))
      (fun _ _ ↦ Nat.cast_nonneg _) hg).trans_lt ho_lt
  have hsymm_eq : #((g • F₁) ∆ F₁) = #((g • S) ∆ S) := by
    rw [card_smul_finset_symmDiff_image e.injective
        (orbitEquivQuotientStabilizer_smul z₀ g),
      ← hval_F', card_smul_finset_symmDiff_image Subtype.val_injective (fun _ ↦ rfl)]
  rwa [hsymm_eq, hF₁_card]

/-- If `S` generates `G`, then `G` has Følner sets exactly when the finite-set condition holds for
all finite test sets contained in `S`: for every finite `K ⊆ S` and every `ε > 0` there is a finite
nonempty `F ⊆ G` with `|gF △ F| < ε · |F|` for all `g ∈ K`. -/
@[to_additive hasAddFoelnerSets_iff_of_closure_eq_top /-- If `S` generates `G`, then `G` has
additive Følner sets exactly when the finite-set condition holds for all finite test sets contained
in `S`: for every finite `K ⊆ S` and every `ε > 0` there is a finite nonempty `F ⊆ G` with
`|(g +ᵥ F) △ F| < ε · |F|` for all `g ∈ K`. -/]
theorem hasFoelnerSets_iff_of_closure_eq_top [DecidableEq G] {S : Set G}
    (hS : Subgroup.closure S = ⊤) : HasFoelnerSets G ↔
    ∀ K : Finset G, (K : Set G) ⊆ S → ∀ ε : ℝ, 0 < ε →
      ∃ F : Finset G, F.Nonempty ∧ ∀ g ∈ K, (#((g • F) ∆ F) : ℝ) < ε * #F := by
  rw [hasFoelnerSets_iff]
  exact ⟨fun h K _ => h K, fun h K ε hε =>
    exists_finset_card_smul_symmDiff_lt_of_subset_closure h (by simp [hS]) hε⟩

/-- If a finite set `S` generates `G`, then `G` has Følner sets exactly when for every `ε > 0`
there is a finite nonempty `F ⊆ G` with `|sF △ F| < ε · |F|` for all `s ∈ S`. -/
@[to_additive hasAddFoelnerSets_iff_of_closure_finset_eq_top /-- If a finite set `S` generates
`G`, then `G` has additive Følner sets exactly when for every `ε > 0` there is a finite nonempty
`F ⊆ G` with `|(s +ᵥ F) △ F| < ε · |F|` for all `s ∈ S`. -/]
theorem hasFoelnerSets_iff_of_closure_finset_eq_top [DecidableEq G] {S : Finset G}
    (hS : Subgroup.closure (S : Set G) = ⊤) : HasFoelnerSets G ↔
    ∀ ε : ℝ, 0 < ε → ∃ F : Finset G, F.Nonempty ∧ ∀ s ∈ S, (#((s • F) ∆ F) : ℝ) < ε * #F := by
  rw [hasFoelnerSets_iff_of_closure_eq_top hS]
  refine ⟨fun h => h S subset_rfl, fun h K hK ε hε => ?_⟩
  obtain ⟨F, hF, hFS⟩ := h ε hε
  exact ⟨F, hF, fun g hg => hFS g (mod_cast hK hg)⟩

end TauCeti

namespace MulEquiv

open TauCeti

variable {H : Type*} [Group H]

/-- An isomorphism carries Følner sets of `G` to Følner sets of `H`. -/
@[to_additive /-- An additive isomorphism carries Følner sets of `G` to Følner sets of `H`. -/]
private theorem hasFoelnerSets_of_mulEquiv (e : G ≃* H) (h : HasFoelnerSets G) :
    HasFoelnerSets H := by
  classical
  rw [TauCeti.hasFoelnerSets_iff] at h ⊢
  intro K ε hε
  obtain ⟨F, hF, hFK⟩ := h (K.image e.symm) ε hε
  refine ⟨F.image e, hF.image e, fun g hg => ?_⟩
  -- The isomorphism carries the test for `e.symm g` on `F` to the test for `g` on `e '' F`.
  have h_eq : (g • F.image e) ∆ F.image e = ((e.symm g • F) ∆ F).image e := by
    rw [image_symmDiff _ _ e.injective, image_smul_distrib, apply_symm_apply]
  rw [h_eq, card_image_of_injective _ e.injective, card_image_of_injective _ e.injective]
  exact hFK _ (mem_image_of_mem _ hg)

/-- Having Følner sets is invariant under group isomorphisms. -/
@[to_additive AddEquiv.hasAddFoelnerSets_iff /-- Having additive Følner sets is invariant under
additive group isomorphisms. -/]
theorem hasFoelnerSets_iff (e : G ≃* H) : HasFoelnerSets G ↔ HasFoelnerSets H :=
  ⟨hasFoelnerSets_of_mulEquiv e, hasFoelnerSets_of_mulEquiv e.symm⟩

end MulEquiv

namespace TauCeti

section TypeTagCompatibility

/-- For an additive group `A` acting on a measure space `(X, μ)`, a family of sets is Følner for
the induced action of `Multiplicative A` if and only if it is additively Følner for `A`. -/
@[simp]
theorem isFoelner_multiplicative_iff {A X : Type*} [AddGroup A] [MeasurableSpace X]
    {μ : Measure X} [AddAction A X] {ι : Type*} {l : Filter ι} {F : ι → Set X} :
    IsFoelner (Multiplicative A) μ l F ↔ IsAddFoelner A μ l F := by
  simp [isFoelner_iff, isAddFoelner_iff, Multiplicative.forall]

/-- For a group `G` acting on a measure space `(X, μ)`, a family of sets is additively Følner for
the induced action of `Additive G` if and only if it is Følner for `G`. -/
@[simp]
theorem isAddFoelner_additive_iff {G X : Type*} [Group G] [MeasurableSpace X]
    {μ : Measure X} [MulAction G X] {ι : Type*} {l : Filter ι} {F : ι → Set X} :
    IsAddFoelner (Additive G) μ l F ↔ IsFoelner G μ l F := by
  simp [isFoelner_iff, isAddFoelner_iff, Additive.forall]

/-- The maximal Følner filter of `Multiplicative A` acting on `(X, μ)` coincides with the maximal
additive Følner filter of `A`. -/
@[simp]
theorem maxFoelner_multiplicative (A : Type*) {X : Type*} [AddGroup A] [MeasurableSpace X]
    (μ : Measure X) [AddAction A X] :
    maxFoelner (Multiplicative A) μ = maxAddFoelner A μ :=
  le_antisymm
    ((isAddFoelner_iff_tendsto _ _).1
      (isFoelner_multiplicative_iff.1 (isFoelner_maxFoelner (Multiplicative A) μ)))
    ((isFoelner_iff_tendsto _ _).1
      (isFoelner_multiplicative_iff.2 (isAddFoelner_maxAddFoelner A μ)))

/-- The maximal additive Følner filter of `Additive G` acting on `(X, μ)` coincides with the
maximal Følner filter of `G`. -/
@[simp]
theorem maxAddFoelner_additive (G : Type*) {X : Type*} [Group G] [MeasurableSpace X]
    (μ : Measure X) [MulAction G X] :
    maxAddFoelner (Additive G) μ = maxFoelner G μ :=
  le_antisymm
    ((isFoelner_iff_tendsto _ _).1
      (isAddFoelner_additive_iff.1 (isAddFoelner_maxAddFoelner (Additive G) μ)))
    ((isAddFoelner_iff_tendsto _ _).1
      (isAddFoelner_additive_iff.2 (isFoelner_maxFoelner G μ)))

/-- Transporting a family `F : ι → Set A` to `Multiplicative A` via `Multiplicative.ofAdd '' ·`
preserves and reflects the counting-measure Følner condition. -/
theorem isFoelner_count_image_ofAdd_iff {A : Type*} [AddGroup A] [MeasurableSpace A]
    [MeasurableSingletonClass A] {ι : Type*} {l : Filter ι} {F : ι → Set A} :
    IsFoelner (Multiplicative A) Measure.count l (fun i => Multiplicative.ofAdd '' F i) ↔
      IsAddFoelner A Measure.count l F := by
  have himage (s : Set A) : Multiplicative.ofAdd '' s = Multiplicative.toAdd ⁻¹' s :=
    Multiplicative.ofAdd.image_eq_preimage_symm s
  have hsmul (a : A) (s : Set A) :
      Multiplicative.ofAdd a • (Multiplicative.ofAdd '' s) = Multiplicative.ofAdd '' (a +ᵥ s) := by
    ext y
    constructor
    · rintro ⟨_, ⟨x, hx, rfl⟩, rfl⟩
      exact ⟨a + x, ⟨x, hx, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨x, hx, rfl⟩, rfl⟩
      exact ⟨Multiplicative.ofAdd x, ⟨x, hx, rfl⟩, rfl⟩
  simp only [isFoelner_iff, isAddFoelner_iff, Multiplicative.forall]
  refine and_congr (by simp [himage]) (and_congr ?_ (and_congr ?_ (forall_congr' fun a => ?_)))
  · simp [Measure.count_injective_image Multiplicative.ofAdd.injective]
  · simp [Measure.count_injective_image Multiplicative.ofAdd.injective]
  · simp only [hsmul, ← Set.image_symmDiff Multiplicative.ofAdd.injective,
      Measure.count_injective_image Multiplicative.ofAdd.injective]

/-- Transporting a family `F : ι → Set G` to `Additive G` via `Additive.ofMul '' ·` preserves and
reflects the counting-measure Følner condition. -/
theorem isAddFoelner_count_image_ofMul_iff {G : Type*} [Group G] [MeasurableSpace G]
    [MeasurableSingletonClass G] {ι : Type*} {l : Filter ι} {F : ι → Set G} :
    IsAddFoelner (Additive G) Measure.count l (fun i => Additive.ofMul '' F i) ↔
      IsFoelner G Measure.count l F := by
  have himage (s : Set G) : Additive.ofMul '' s = Additive.toMul ⁻¹' s :=
    Additive.ofMul.image_eq_preimage_symm s
  have hvadd (g : G) (s : Set G) :
      Additive.ofMul g +ᵥ (Additive.ofMul '' s) = Additive.ofMul '' (g • s) := by
    ext y
    constructor
    · rintro ⟨_, ⟨x, hx, rfl⟩, rfl⟩
      exact ⟨g * x, ⟨x, hx, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨x, hx, rfl⟩, rfl⟩
      exact ⟨Additive.ofMul x, ⟨x, hx, rfl⟩, rfl⟩
  simp only [isFoelner_iff, isAddFoelner_iff, Additive.forall]
  refine and_congr (by simp [himage]) (and_congr ?_ (and_congr ?_ (forall_congr' fun g => ?_)))
  · simp [Measure.count_injective_image Additive.ofMul.injective]
  · simp [Measure.count_injective_image Additive.ofMul.injective]
  · simp only [hvadd, ← Set.image_symmDiff Additive.ofMul.injective,
      Measure.count_injective_image Additive.ofMul.injective]

/-- `Multiplicative A` has Følner sets if and only if `A` has additive Følner sets. -/
@[simp]
theorem hasFoelnerSets_multiplicative_iff {A : Type*} [AddGroup A] :
    HasFoelnerSets (Multiplicative A) ↔ HasAddFoelnerSets A := by
  constructor
  · intro h
    let : MeasurableSpace (Multiplicative A) := ⊤
    have hA : HasAddFoelnerSets (Additive (Multiplicative A)) :=
      (isAddFoelner_count_image_ofMul_iff.2
        (isFoelner_maxFoelner (Multiplicative A) Measure.count)).hasAddFoelnerSets
    exact (AddEquiv.additiveMultiplicative A).hasAddFoelnerSets_iff.1 hA
  · intro h
    let : MeasurableSpace A := ⊤
    exact (isFoelner_count_image_ofAdd_iff.2
      (isAddFoelner_maxAddFoelner A Measure.count)).hasFoelnerSets

/-- `Additive G` has additive Følner sets if and only if `G` has Følner sets. -/
@[simp]
theorem hasAddFoelnerSets_additive_iff {G : Type*} [Group G] :
    HasAddFoelnerSets (Additive G) ↔ HasFoelnerSets G := by
  rw [← hasFoelnerSets_multiplicative_iff, (MulEquiv.multiplicativeAdditive G).hasFoelnerSets_iff]

end TypeTagCompatibility

end TauCeti
