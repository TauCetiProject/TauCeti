module

public import Mathlib.Topology.Algebra.Group.Matrix
public import TauCeti.GroupTheory.Amenable.DiscreteFoelner
import TauCeti.GroupTheory.Amenable.FreeGroup
import TauCeti.GroupTheory.FreeGroup.Linear

/-!
# Non-amenability of `SL(2, R)` over linearly ordered commutative rings

Over any linearly ordered commutative ring `R`, Sanov's theorem
(`TauCeti.injective_freeGroup_lift_transvection_of_two_le_abs`) embeds the rank-two free group
`FreeGroup (Fin 2)` into `SL(2, R)` via the transvections `[[1, 2], [0, 1]]` and
`[[1, 0], [2, 1]]`. Since non-abelian free groups are paradoxical (`FreeGroup.paradoxical_univ`),
`SL(2, R)` does not have Følner sets (`TauCeti.not_hasFoelnerSets_slTwo`), and when `R` carries the
discrete topology (for instance `R = ℤ`), `SL(2, R)` is not amenable (`TauCeti.not_amenable_slTwo`).

## Main results

* `TauCeti.not_hasFoelnerSets_slTwo`: over a linearly ordered commutative ring `R`, `SL(2, R)` does
  not have Følner sets.
* `TauCeti.not_amenable_slTwo`: over a discrete linearly ordered commutative ring `R` (such as `ℤ`),
  `SL(2, R)` is not amenable.

## References

* I. N. Sanov, *A property of a representation of a free group*, Doklady Akad. Nauk SSSR 57 (1947),
  657–659.
* B. Bekka, P. de la Harpe and A. Valette, *Kazhdan's Property (T)*, Cambridge University Press
  (2008), Example G.2.4.
-/

public section

open scoped MatrixGroups

namespace TauCeti

/-- Over any linearly ordered commutative ring `R`, `SL(2, R)` does not have Følner sets, since it
contains Sanov's free subgroup of rank two generated by `[[1, 2], [0, 1]]` and `[[1, 0], [2, 1]]`.
-/
theorem not_hasFoelnerSets_slTwo {R : Type*} [CommRing R] [LinearOrder R] [IsStrictOrderedRing R] :
    ¬ HasFoelnerSets SL(2, R) := by
  let _ : TopologicalSpace SL(2, R) := ⊥
  have : DiscreteTopology SL(2, R) := ⟨rfl⟩
  rw [← amenable_iff_hasFoelnerSets]
  exact not_amenable_of_injective_freeGroup _
    (injective_freeGroup_lift_transvection_of_two_le_abs (le_abs_self 2) (le_abs_self 2))

/-- Over any discrete linearly ordered commutative ring `R` (such as `ℤ`), `SL(2, R)` is not
amenable. -/
theorem not_amenable_slTwo {R : Type*} [CommRing R] [LinearOrder R] [IsStrictOrderedRing R]
    [TopologicalSpace R] [DiscreteTopology R] : ¬ Amenable SL(2, R) :=
  mt amenable_iff_hasFoelnerSets.mp not_hasFoelnerSets_slTwo

end TauCeti
