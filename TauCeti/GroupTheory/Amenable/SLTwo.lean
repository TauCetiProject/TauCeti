module

public import Mathlib.Topology.Algebra.Group.Matrix
public import TauCeti.GroupTheory.Amenable.DiscreteFoelner
import TauCeti.GroupTheory.Amenable.FreeGroup
import TauCeti.GroupTheory.FreeGroup.Linear
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Basic

/-!
# Non-amenability of `SL(2, R)` over commutative rings of characteristic zero

Over any commutative ring `R` of characteristic zero, composing Sanov's embedding
(`TauCeti.injective_freeGroup_lift_transvection_two`) with base change along `Int.castRingHom R`
(`Matrix.SpecialLinearGroup.map`) embeds the rank-two free group `FreeGroup (Fin 2)` into
`SL(2, R)` via the transvections `[[1, 2], [0, 1]]` and `[[1, 0], [2, 1]]`. Since non-abelian free
groups are paradoxical (`FreeGroup.paradoxical_univ`), `SL(2, R)` does not have Følner sets
(`TauCeti.not_hasFoelnerSets_slTwo`), and when `R` carries the discrete topology (for instance
`R = ℤ`), `SL(2, R)` is not amenable (`TauCeti.not_amenable_slTwo`).

## Main results

* `TauCeti.not_hasFoelnerSets_slTwo`: over a commutative ring `R` of characteristic zero,
  `SL(2, R)` does not have Følner sets.
* `TauCeti.not_amenable_slTwo`: over a discrete commutative ring `R` of characteristic zero (such
  as `ℤ`), `SL(2, R)` is not amenable.

## References

* I. N. Sanov, *A property of a representation of a free group*, Doklady Akad. Nauk SSSR 57 (1947),
  657–659.
* B. Bekka, P. de la Harpe and A. Valette, *Kazhdan's Property (T)*, Cambridge University Press
  (2008), Example G.2.4.
-/

public section

open scoped MatrixGroups

namespace TauCeti

/-- Over any commutative ring `R` of characteristic zero, `SL(2, R)` does not have Følner sets,
since it contains Sanov's free subgroup of rank two generated by `[[1, 2], [0, 1]]` and
`[[1, 0], [2, 1]]`. -/
theorem not_hasFoelnerSets_slTwo {R : Type*} [CommRing R] [CharZero R] :
    ¬ HasFoelnerSets SL(2, R) := by
  let _ : TopologicalSpace SL(2, R) := ⊥
  have : DiscreteTopology SL(2, R) := ⟨rfl⟩
  rw [← amenable_iff_hasFoelnerSets]
  exact not_amenable_of_injective_freeGroup
    ((Matrix.SpecialLinearGroup.map (Int.castRingHom R)).comp _)
    ((Matrix.SpecialLinearGroup.map_injective Int.cast_injective).comp
      injective_freeGroup_lift_transvection_two)

/-- Over any discrete commutative ring `R` of characteristic zero (such as `ℤ`), `SL(2, R)` is not
amenable. -/
theorem not_amenable_slTwo {R : Type*} [CommRing R] [CharZero R]
    [TopologicalSpace R] [DiscreteTopology R] : ¬ Amenable SL(2, R) :=
  mt amenable_iff_hasFoelnerSets.mp not_hasFoelnerSets_slTwo

end TauCeti
