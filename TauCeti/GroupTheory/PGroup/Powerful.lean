/-!
# Powerful finite `p`-groups and powerfully embedded subgroups

Let `p` be a prime and `G` a finite `p`-group. A normal subgroup `N` of `G` is **powerfully
embedded** in `G` when `⁅N, G⁆ ≤ N ^ p` for odd `p`, and `⁅N, G⁆ ≤ N ^ 4` for `p = 2`, where
`S ^ n = Subgroup.powerClosure S n` is the subgroup generated by the `n`-th powers of elements of
`S`. The group `G` itself is **powerful** when `⊤` is powerfully embedded in `G`.

The foundational theorem of Lubotzky and Mann is that being powerfully embedded is preserved by
taking `p`-th powers: if `N` is powerfully embedded in a finite `p`-group `G`, then `N ^ p` is
again powerfully embedded in `G` (`Subgroup.IsPowerfullyEmbedded.powerClosure_prime`). From this it
follows by induction that in a finite powerful `p`-group `G`:

* every term `λ_k(G)` of the lower `p`-central series is powerfully embedded in `G`, hence is
  itself a powerful `p`-group (`Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries`,
  `Subgroup.IsPowerfullyEmbedded.top_of_isPowerfullyEmbedded`);
* `λ_{k+1}(G) = λ_k(G) ^ p`
  (`Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries_succ_eq_powerClosure`) and
  `λ_j(λ_k(G)) = λ_{k+j}(G)`
  (`Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries_pLowerCentralSeries`);
* whenever `λ_{n+2}(G) = ⊥`, `(a * y) ^ p = a ^ p * y ^ p` for every `a : G` and `y ∈ λ_n(G)`
  (`Subgroup.IsPowerfullyEmbedded.mul_pow_prime_eq_of_pLowerCentralSeries_eq_bot`);
* every element of `G ^ p` is a single `p`-th power, and more generally `λ_k(G) = G ^ (p ^ k)`
  consists precisely of the `p ^ k`-th powers of elements of `G`
  (`Subgroup.IsPowerfullyEmbedded.mem_pLowerCentralSeries_iff_exists_pow_pow`,
  `Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries_eq_powerClosure_pow`).

## Main definitions

* `Subgroup.powerClosure`: the subgroup `S ^ n` generated by the `n`-th powers of elements of `S`.
* `Subgroup.IsPowerfullyEmbedded`: the predicate
  `N.Normal ∧ ⁅N, ⊤⁆ ≤ N.powerClosure (if p = 2 then 4 else p)`.

## Main results

* `Subgroup.IsPowerfullyEmbedded.powerClosure_prime`: in a finite `p`-group, if `N` is powerfully
  embedded, then so is `N.powerClosure p`.
* `Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries`: every term of the lower `p`-central series
  of a finite powerful `p`-group is powerfully embedded.
* `Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries_succ_eq_powerClosure`: `λ_{k+1} = λ_k ^ p`.
* `Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries_pLowerCentralSeries`:
  `λ_j(λ_k(G)) = λ_{k+j}(G)`.
* `Subgroup.IsPowerfullyEmbedded.mul_pow_prime_eq_of_pLowerCentralSeries_eq_bot`: the product-power
  identity `(a * y) ^ p = a ^ p * y ^ p` for `y ∈ λ_n` when `λ_{n+2} = ⊥`.
* `Subgroup.IsPowerfullyEmbedded.exists_pow_eq_of_mem_powerClosure`: every element of `G ^ p` is a
  `p`-th power in a finite powerful `p`-group.
* `Subgroup.IsPowerfullyEmbedded.mem_pLowerCentralSeries_iff_exists_pow_pow` and
  `Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries_eq_powerClosure_pow`: `λ_k(G) = G ^ (p ^ k)`
  and its elements are precisely the `p ^ k`-th powers.

## References

* J. D. Dixon, M. P. F. du Sautoy, A. Mann and D. Segal, *Analytic pro-`p` groups*, Chapter 2
  (Proposition 2.7, Lemma 2.8, Theorem 2.9).
-/

public section

open scoped commutatorElement

namespace Subgroup

/-! ### Power subgroups -/

section PowerClosure

variable {G H : Type*} [Group G] [Group H]

/-- The subgroup `S ^ n` generated by the `n`-th powers of the elements of a subgroup `S`. -/
def powerClosure (S : Subgroup G) (n : ℕ) : Subgroup G :=
  closure ((· ^ n) '' (S : Set G))

/-- The unfolding equation of `Subgroup.powerClosure`. -/
theorem powerClosure_def (S : Subgroup G) (n : ℕ) :
    S.powerClosure n = closure ((· ^ n) '' (S : Set G)) := by
  rw [powerClosure]

/-- The `n`-th power of an element of `S` lies in `S.powerClosure n`. -/
theorem pow_mem_powerClosure {S : Subgroup G} {x : G} (hx : x ∈ S) (n : ℕ) :
    x ^ n ∈ S.powerClosure n :=
  subset_closure ⟨x, hx, rfl⟩

/-- `S.powerClosure n` is the least subgroup containing the `n`-th powers of elements of `S`. -/
theorem powerClosure_le_iff {S T : Subgroup G} {n : ℕ} :
    S.powerClosure n ≤ T ↔ ∀ x ∈ S, x ^ n ∈ T := by
  simp only [powerClosure_def, closure_le, Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

/-- `S.powerClosure n` is contained in `S`. -/
theorem powerClosure_le (S : Subgroup G) (n : ℕ) : S.powerClosure n ≤ S :=
  powerClosure_le_iff.mpr fun _ hx ↦ pow_mem hx n

/-- `Subgroup.powerClosure` is monotone in the subgroup. -/
theorem powerClosure_mono {S T : Subgroup G} (h : S ≤ T) (n : ℕ) :
    S.powerClosure n ≤ T.powerClosure n :=
  powerClosure_le_iff.mpr fun _ hx ↦ pow_mem_powerClosure (h hx) n

/-- Divisibility of exponents reverses inclusion of power subgroups: if `m ∣ n`, then
`S ^ n ≤ S ^ m`. -/
theorem powerClosure_le_of_dvd (S : Subgroup G) {m n : ℕ} (h : m ∣ n) :
    S.powerClosure n ≤ S.powerClosure m := by
  obtain ⟨k, rfl⟩ := h
  exact powerClosure_le_iff.mpr fun x hx ↦ by
    rw [pow_mul]
    exact pow_mem (pow_mem_powerClosure hx m) k

/-- The `m * n`-th power subgroup lies in the `n`-th power subgroup of the `m`-th power subgroup. -/
theorem powerClosure_mul_le (S : Subgroup G) (m n : ℕ) :
    S.powerClosure (m * n) ≤ (S.powerClosure m).powerClosure n :=
  powerClosure_le_iff.mpr fun x hx ↦ by
    rw [pow_mul]
    exact pow_mem_powerClosure (pow_mem_powerClosure hx m) n

/-- The `1`-st power subgroup of `S` is `S`. -/
@[simp]
theorem powerClosure_one (S : Subgroup G) : S.powerClosure 1 = S := by
  rw [powerClosure_def]
  simp

/-- The `0`-th power subgroup of `S` is trivial. -/
@[simp]
theorem powerClosure_zero (S : Subgroup G) : S.powerClosure 0 = ⊥ :=
  le_bot_iff.mp (powerClosure_le_iff.mpr fun _ _ ↦ by simp)

/-- Every power subgroup of `⊥` is `⊥`. -/
@[simp]
theorem powerClosure_bot (n : ℕ) : (⊥ : Subgroup G).powerClosure n = ⊥ :=
  le_bot_iff.mp (powerClosure_le ⊥ n)

/-- The `n`-th power subgroup of `⊤` is generated by all `n`-th powers in `G`. -/
theorem powerClosure_top (n : ℕ) :
    (⊤ : Subgroup G).powerClosure n = closure (Set.range fun g : G ↦ g ^ n) := by
  rw [powerClosure_def, coe_top, Set.image_univ]

/-- Group homomorphisms commute with `Subgroup.powerClosure`. -/
@[simp]
theorem powerClosure_map (f : G →* H) (S : Subgroup G) (n : ℕ) :
    (S.powerClosure n).map f = (S.map f).powerClosure n := by
  rw [powerClosure_def, powerClosure_def, MonoidHom.map_closure, coe_map, Set.image_image,
    Set.image_image]
  simp only [map_pow]

/-- The power subgroup of a normal subgroup is normal. -/
instance powerClosure_normal (S : Subgroup G) [S.Normal] (n : ℕ) :
    (S.powerClosure n).Normal := by
  refine normalizer_eq_top_iff.mp (eq_top_iff.mpr fun g _ ↦ ?_)
  rw [mem_normalizer_iff_map_conj_eq, powerClosure_map]
  have hS : S.map (MulAut.conj g : G →* G) = S :=
    mem_normalizer_iff_map_conj_eq.mp (by rw [normalizer_eq_top]; exact mem_top g)
  rw [hS]

/-- The `p`-th power subgroup of `λ_k(S)` lies in `λ_{k+1}(S)`. -/
theorem powerClosure_pLowerCentralSeries_le (S : Subgroup G) (p k : ℕ) :
    (S.pLowerCentralSeries p k).powerClosure p ≤ S.pLowerCentralSeries p (k + 1) :=
  powerClosure_le_iff.mpr fun _ hx ↦ S.pow_mem_pLowerCentralSeries_succ p hx

/-- If `S` is abelian (that is, `⁅S, S⁆ = ⊥`), then `S.powerClosure n` consists precisely of the
`n`-th powers of elements of `S`. -/
theorem mem_powerClosure_iff_of_commutator_eq_bot {S : Subgroup G} (hS : ⁅S, S⁆ = ⊥) {n : ℕ}
    {x : G} : x ∈ S.powerClosure n ↔ ∃ y ∈ S, y ^ n = x := by
  refine ⟨fun hx ↦ ?_, fun ⟨y, hy, hyx⟩ ↦ hyx ▸ pow_mem_powerClosure hy n⟩
  have hcomm : ∀ a ∈ S, ∀ b ∈ S, Commute a b := fun a ha b hb ↦
    commutatorElement_eq_one_iff_commute.mp
      (mem_bot.mp (hS ▸ commutator_mem_commutator ha hb))
  let T : Subgroup G :=
    { carrier := {x | ∃ y ∈ S, y ^ n = x}
      one_mem' := ⟨1, one_mem S, one_pow n⟩
      mul_mem' := by
        rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
        exact ⟨a * b, mul_mem ha hb, (hcomm a ha b hb).mul_pow n⟩
      inv_mem' := by
        rintro _ ⟨a, ha, rfl⟩
        exact ⟨a⁻¹, inv_mem ha, inv_pow a n⟩ }
  exact (powerClosure_le_iff (T := T).mpr fun y hy ↦ ⟨y, hy, rfl⟩) hx

end PowerClosure

/-! ### Powerfully embedded subgroups -/

section PowerfullyEmbedded

variable {G H : Type*} [Group G] [Group H]

/-- A subgroup `N` of `G` is **powerfully embedded** (relative to `p`) when it is normal in `G` and
`⁅N, G⁆ ≤ N ^ p` for `p ≠ 2`, respectively `⁅N, G⁆ ≤ N ^ 4` for `p = 2`. -/
def IsPowerfullyEmbedded (p : ℕ) (N : Subgroup G) : Prop :=
  N.Normal ∧ ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powerClosure (if p = 2 then 4 else p)

/-- The unfolding characterization of `Subgroup.IsPowerfullyEmbedded`. -/
theorem isPowerfullyEmbedded_iff (p : ℕ) (N : Subgroup G) :
    N.IsPowerfullyEmbedded p ↔
      N.Normal ∧ ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powerClosure (if p = 2 then 4 else p) :=
  Iff.rfl

namespace IsPowerfullyEmbedded

variable {p : ℕ} {N : Subgroup G}

/-- A powerfully embedded subgroup is normal. -/
theorem normal (hN : N.IsPowerfullyEmbedded p) : N.Normal :=
  hN.1

/-- The defining commutator bound of a powerfully embedded subgroup. -/
theorem commutator_le (hN : N.IsPowerfullyEmbedded p) :
    ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powerClosure (if p = 2 then 4 else p) :=
  hN.2

/-- Every powerfully embedded subgroup satisfies `⁅N, G⁆ ≤ N ^ p`, for both odd `p` and `p = 2`. -/
theorem commutator_le_powerClosure_prime (hN : N.IsPowerfullyEmbedded p) :
    ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powerClosure p := by
  by_cases hp2 : p = 2
  · subst hp2
    have h4 : ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powerClosure 4 := by simpa using hN.2
    exact h4.trans (N.powerClosure_le_of_dvd (by decide : 2 ∣ 4))
  · simpa [hp2] using hN.2

/-- Surjective group homomorphisms preserve powerful embedding. -/
theorem map_of_surjective (hN : N.IsPowerfullyEmbedded p) {f : G →* H}
    (hf : Function.Surjective f) : (N.map f).IsPowerfullyEmbedded p := by
  refine ⟨Normal.map hN.1 f hf, ?_⟩
  rw [← map_top_of_surjective f hf, ← map_commutator, ← powerClosure_map]
  exact map_mono hN.2

/-- A powerfully embedded subgroup is itself powerful: `⊤ ≤ N` is powerfully embedded in `N`. -/
theorem top_of_isPowerfullyEmbedded (hN : N.IsPowerfullyEmbedded p) :
    (⊤ : Subgroup N).IsPowerfullyEmbedded p := by
  refine ⟨inferInstance, ?_⟩
  rw [← map_le_map_iff_of_injective N.subtype_injective, map_commutator, powerClosure_map,
    ← MonoidHom.range_eq_map, N.range_subtype]
  exact (commutator_mono le_rfl le_top).trans hN.2

end IsPowerfullyEmbedded

/-- The trivial subgroup is powerfully embedded in every group. -/
theorem isPowerfullyEmbedded_bot (p : ℕ) : (⊥ : Subgroup G).IsPowerfullyEmbedded p :=
  ⟨inferInstance, by simp⟩

/-- In a commutative group, `⊤` is powerfully embedded for every `p`. -/
theorem isPowerfullyEmbedded_top_of_isMulCommutative [IsMulCommutative G] (p : ℕ) :
    (⊤ : Subgroup G).IsPowerfullyEmbedded p := by
  refine ⟨inferInstance, ?_⟩
  rw [commutator_le]
  intro a _ b _
  rw [commutatorElement_eq_one_iff_commute.mpr (IsMulCommutative.is_comm.comm a b)]
  exact one_mem _

end PowerfullyEmbedded

/-! ### Finite powerful `p`-groups -/

section FinitePGroup

universe u

variable {p : ℕ} [hp : Fact p.Prime]

/-- The `p = 2` step of Lubotzky–Mann's theorem: when `⁅N^2, G⁆` is central of exponent `2` and
`(N^2)^4 = ⊥`, `⁅N^2, G⁆` vanishes. -/
private theorem commutator_powerClosure_two_eq_bot {G : Type*} [Group G] {N : Subgroup G}
    (hN : N.IsPowerfullyEmbedded 2) (hpow4 : (N.powerClosure 2).powerClosure 4 = ⊥)
    (hZ : ⁅N.powerClosure 2, (⊤ : Subgroup G)⁆ ≤ center G)
    (hexp : ∀ c ∈ ⁅N.powerClosure 2, (⊤ : Subgroup G)⁆, c ^ 2 = 1) :
    ⁅N.powerClosure 2, (⊤ : Subgroup G)⁆ = ⊥ := by
  -- Helper: if `⁅a, b⁆` is central and squared to `1`, then `⁅a ^ 2, b⁆ = 1`.
  have hsq : ∀ {a b : G}, ⁅a, b⁆ ∈ center G → ⁅a, b⁆ ^ 2 = 1 → ⁅a ^ 2, b⁆ = 1 := by
    intro a b hc hc2
    have hcomm : Commute a ⁅a, b⁆ := mem_center_iff.mp hc a
    have h1 : ⁅a, ⁅a, b⁆⁆ = 1 := commutatorElement_eq_one_iff_commute.mpr hcomm
    rw [TauCeti.commutatorElement_pow_left_of_commute (h1 ▸ Commute.one_right _)
      (h1 ▸ Commute.one_right _), h1, one_pow, hc2, mul_one]
  -- First, `N ^ 2` is abelian.
  have hN2_ab : ⁅N.powerClosure 2, N.powerClosure 2⁆ = ⊥ := by
    rw [le_bot_iff.symm, commutator_comm, powerClosure_def, TauCeti.commutator_closure_le_iff]
    rintro v hv _ ⟨x, _, rfl⟩
    rw [mem_bot, ← inv_eq_one, commutatorElement_inv]
    have hmem : ⁅x, v⁆ ∈ ⁅N.powerClosure 2, (⊤ : Subgroup G)⁆ := by
      rw [← commutatorElement_inv]
      exact inv_mem (commutator_mem_commutator hv (mem_top x))
    exact hsq (hZ hmem) (hexp _ hmem)
  -- Second, `(N ^ 2) ^ 2` is central.
  have hN22_Z : (N.powerClosure 2).powerClosure 2 ≤ center G := by
    rw [← commutator_top_right_eq_bot_iff_le_center, ← le_bot_iff, commutator_comm,
      powerClosure_def, TauCeti.commutator_closure_le_iff]
    rintro g _ _ ⟨u, hu, rfl⟩
    rw [mem_bot, ← inv_eq_one, commutatorElement_inv]
    have hmem : ⁅u, g⁆ ∈ ⁅N.powerClosure 2, (⊤ : Subgroup G)⁆ :=
      commutator_mem_commutator hu (mem_top g)
    exact hsq (hZ hmem) (hexp _ hmem)
  -- Third, every element of `(N ^ 2) ^ 2` has square `1`, since `N ^ 2` is abelian and
  -- `(N ^ 2) ^ 4 = ⊥`.
  have hN22_exp : ∀ c ∈ (N.powerClosure 2).powerClosure 2, c ^ 2 = 1 := by
    intro c hc
    obtain ⟨u, hu, rfl⟩ := (mem_powerClosure_iff_of_commutator_eq_bot hN2_ab).mp hc
    rw [← pow_mul]
    exact mem_bot.mp (hpow4 ▸ pow_mem_powerClosure hu 4)
  -- Finally, for `x ∈ N` and `g : G`, `⁅x, g⁆ ∈ N ^ 4 ≤ (N ^ 2) ^ 2` is central of order `≤ 2`.
  have hN4 : ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powerClosure 4 := by simpa using hN.2
  rw [← le_bot_iff, commutator_comm, powerClosure_def, TauCeti.commutator_closure_le_iff]
  rintro g _ _ ⟨x, hx, rfl⟩
  rw [mem_bot, ← inv_eq_one, commutatorElement_inv]
  have h4 : ⁅x, g⁆ ∈ (N.powerClosure 2).powerClosure 2 :=
    N.powerClosure_mul_le 2 2 (hN4 (commutator_mem_commutator hx (mem_top g)))
  exact hsq (hN22_Z h4) (hN22_exp _ h4)

/-- The odd-`p` step of Lubotzky–Mann's theorem: when `⁅N^p, G⁆` is central of exponent `p` and
`(N^p)^p = ⊥`, `⁅N^p, G⁆` vanishes. -/
private theorem commutator_powerClosure_odd_eq_bot (hp2 : p ≠ 2) {G : Type*} [Group G]
    {N : Subgroup G} (hN : N.IsPowerfullyEmbedded p) (hpowp : (N.powerClosure p).powerClosure p = ⊥)
    (hZ : ⁅N.powerClosure p, (⊤ : Subgroup G)⁆ ≤ center G)
    (hexp : ∀ c ∈ ⁅N.powerClosure p, (⊤ : Subgroup G)⁆, c ^ p = 1) :
    ⁅N.powerClosure p, (⊤ : Subgroup G)⁆ = ⊥ := by
  have hNp : ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powerClosure p := by simpa [hp2] using hN.2
  rw [← le_bot_iff, commutator_comm, powerClosure_def, TauCeti.commutator_closure_le_iff]
  rintro g _ _ ⟨x, hx, rfl⟩
  rw [mem_bot, ← inv_eq_one, commutatorElement_inv]
  have hc : ⁅x, g⁆ ∈ N.powerClosure p := hNp (commutator_mem_commutator hx (mem_top g))
  have hcp : ⁅x, g⁆ ^ p = 1 := mem_bot.mp (hpowp ▸ pow_mem_powerClosure hc p)
  have hd_mem : ⁅x, ⁅x, g⁆⁆ ∈ ⁅N.powerClosure p, (⊤ : Subgroup G)⁆ := by
    rw [← commutatorElement_inv]
    exact inv_mem (commutator_mem_commutator hc (mem_top x))
  have hdZ : ⁅x, ⁅x, g⁆⁆ ∈ center G := hZ hd_mem
  have hxd : Commute x ⁅x, ⁅x, g⁆⁆ := mem_center_iff.mp hdZ x
  have hcd : Commute ⁅x, g⁆ ⁅x, ⁅x, g⁆⁆ := mem_center_iff.mp hdZ ⁅x, g⁆
  obtain ⟨k, hk⟩ := hp.out.dvd_choose_self (by decide) (hp.out.two_le.lt_of_ne' hp2)
  rw [TauCeti.commutatorElement_pow_left_of_commute hxd hcd, hcp, hk, pow_mul, hexp _ hd_mem,
    one_pow, mul_one]

/-- Induction core of Lubotzky–Mann's theorem: if `(N ^ p) ^ ε(p) = ⊥` in a finite `p`-group `G`
with `N` powerfully embedded, then `⁅N ^ p, G⁆ = ⊥`. -/
private theorem commutator_powerClosure_prime_eq_bot_aux (m : ℕ) :
    ∀ (G : Type u) [Group G] [Finite G], Nat.card G = m → IsPGroup p G →
      ∀ (N : Subgroup G), N.IsPowerfullyEmbedded p →
        (N.powerClosure p).powerClosure (if p = 2 then 4 else p) = ⊥ →
        ⁅N.powerClosure p, (⊤ : Subgroup G)⁆ = ⊥ := by
  induction m using Nat.strong_induction_on with
  | _ m ih =>
  intro G _ _ hm hG N hN hpow
  by_contra hne
  have := hN.1
  have := hG.isNilpotent
  -- Pick a central element `z` of order `p` inside the nontrivial normal subgroup `⁅N ^ p, G⁆`.
  set C : Subgroup G := ⁅N.powerClosure p, (⊤ : Subgroup G)⁆ ⊓ center G
  have hinf : C ≠ ⊥ := Group.IsNilpotent.inf_center_ne_bot_of_normal hne
  have : Nontrivial C := (nontrivial_iff_ne_bot C).mpr hinf
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := C) p
    ((hG.to_subgroup C).card_eq_or_dvd.resolve_left Finite.one_lt_card.ne')
  set K : Subgroup G := zpowers (z : G)
  have hKZ : K ≤ center G := zpowers_le.mpr z.2.2
  have : K.Normal := normal_of_le_center hKZ
  have hz_ord : orderOf (z : G) = p := (orderOf_coe z).trans hz
  have hz1 : (z : G) ≠ 1 := fun h ↦ hp.out.one_lt.ne (by rw [← hz_ord, h, orderOf_one])
  have hlt : Nat.card (G ⧸ K) < m := by
    rw [← hm, ← K.index_eq_card, ← K.card_mul_index]
    exact (Nat.lt_mul_iff_one_lt_left (Nat.pos_of_ne_zero K.index_ne_zero_of_finite)).mpr
      (K.one_lt_card_iff_ne_bot.mpr (zpowers_eq_bot.not.mpr hz1))
  -- Apply the induction hypothesis to `G ⧸ K` to force `⁅N ^ p, G⁆ ≤ K`.
  let q := QuotientGroup.mk' K
  have hQ_pow : ((N.map q).powerClosure p).powerClosure (if p = 2 then 4 else p) = ⊥ := by
    rw [← powerClosure_map, ← powerClosure_map, hpow, map_bot]
  have hQ := ih _ hlt (G ⧸ K) rfl (hG.to_quotient K) (N.map q)
    (hN.map_of_surjective (QuotientGroup.mk'_surjective K)) hQ_pow
  have hleK : ⁅N.powerClosure p, (⊤ : Subgroup G)⁆ ≤ K := by
    rw [← QuotientGroup.ker_mk' K, ← map_eq_bot_iff, map_commutator, powerClosure_map,
      map_top_of_surjective q (QuotientGroup.mk'_surjective K)]
    exact hQ
  have hZ : ⁅N.powerClosure p, (⊤ : Subgroup G)⁆ ≤ center G := hleK.trans hKZ
  have hexp : ∀ c ∈ ⁅N.powerClosure p, (⊤ : Subgroup G)⁆, c ^ p = 1 := fun c hc ↦
    orderOf_dvd_iff_pow_eq_one.mp ((orderOf_dvd_of_mem_zpowers (hleK hc)).trans hz_ord.dvd)
  by_cases hp2 : p = 2
  · subst hp2
    exact hne (commutator_powerClosure_two_eq_bot hN (by simpa using hpow) hZ hexp)
  · exact hne (commutator_powerClosure_odd_eq_bot hp2 hN (by simpa [hp2] using hpow) hZ hexp)

variable {G : Type u} [Group G] [Finite G]

/-- **Lubotzky–Mann's theorem (DDMS, Proposition 2.7).** If `N` is powerfully embedded in a finite
`p`-group `G`, then `N.powerClosure p` is also powerfully embedded in `G`. -/
theorem IsPowerfullyEmbedded.powerClosure_prime (hG : IsPGroup p G) {N : Subgroup G}
    (hN : N.IsPowerfullyEmbedded p) : (N.powerClosure p).IsPowerfullyEmbedded p := by
  have := hN.1
  set M := (N.powerClosure p).powerClosure (if p = 2 then 4 else p) with hM
  let q := QuotientGroup.mk' M
  have hQ_pow : ((N.map q).powerClosure p).powerClosure (if p = 2 then 4 else p) = ⊥ := by
    rw [← powerClosure_map, ← powerClosure_map]
    exact (map_eq_bot_iff M).mpr (QuotientGroup.ker_mk' M).ge
  have hQ := commutator_powerClosure_prime_eq_bot_aux _ (G ⧸ M) rfl (hG.to_quotient M) (N.map q)
    (hN.map_of_surjective (QuotientGroup.mk'_surjective M)) hQ_pow
  refine ⟨inferInstance, ?_⟩
  rw [← hM, ← QuotientGroup.ker_mk' M, ← map_eq_bot_iff, map_commutator, powerClosure_map,
    map_top_of_surjective q (QuotientGroup.mk'_surjective M)]
  exact hQ

namespace IsPowerfullyEmbedded

/-- Every term of the lower `p`-central series of a finite powerful `p`-group is powerfully
embedded in the group. -/
theorem pLowerCentralSeries (hG : IsPGroup p G) (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p)
    (k : ℕ) : ((⊤ : Subgroup G).pLowerCentralSeries p k).IsPowerfullyEmbedded p := by
  induction k with
  | zero => simpa using hpow
  | succ k ih =>
    have hstep : (⊤ : Subgroup G).pLowerCentralSeries p (k + 1) =
        ((⊤ : Subgroup G).pLowerCentralSeries p k).powerClosure p := by
      rw [pLowerCentralSeries_succ, ← powerClosure_def, sup_eq_left]
      exact ih.commutator_le_powerClosure_prime
    rw [hstep]
    exact ih.powerClosure_prime hG

/-- In a finite powerful `p`-group, each step of the lower `p`-central series is given purely by
`p`-th powers: `λ_{k+1}(G) = λ_k(G) ^ p`. -/
theorem pLowerCentralSeries_succ_eq_powerClosure (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (k : ℕ) :
    (⊤ : Subgroup G).pLowerCentralSeries p (k + 1) =
      ((⊤ : Subgroup G).pLowerCentralSeries p k).powerClosure p := by
  rw [pLowerCentralSeries_succ, ← powerClosure_def, sup_eq_left]
  exact (hpow.pLowerCentralSeries hG k).commutator_le_powerClosure_prime

/-- In a finite powerful `p`-group, the lower `p`-central series of `λ_k(G)` shifts indices:
`λ_j(λ_k(G)) = λ_{k+j}(G)`. -/
theorem pLowerCentralSeries_pLowerCentralSeries (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (k j : ℕ) :
    ((⊤ : Subgroup G).pLowerCentralSeries p k).pLowerCentralSeries p j =
      (⊤ : Subgroup G).pLowerCentralSeries p (k + j) := by
  induction j with
  | zero => simp
  | succ j ih =>
    set L := (⊤ : Subgroup G).pLowerCentralSeries p k
    have hLpow : (⊤ : Subgroup L).IsPowerfullyEmbedded p :=
      (hpow.pLowerCentralSeries hG k).top_of_isPowerfullyEmbedded
    have hstep := congrArg (Subgroup.map L.subtype)
      (hLpow.pLowerCentralSeries_succ_eq_powerClosure (hG.to_subgroup L) j)
    rw [pLowerCentralSeries_map, powerClosure_map, pLowerCentralSeries_map,
      ← MonoidHom.range_eq_map, L.range_subtype] at hstep
    rw [hstep, ih, ← Nat.add_assoc, hpow.pLowerCentralSeries_succ_eq_powerClosure hG]

/-- **Product-power identity for finite powerful `p`-groups.** If `λ_{n+2}(G) = ⊥` in a finite
powerful `p`-group `G`, then `(a * y) ^ p = a ^ p * y ^ p` for every `a : G` and `y ∈ λ_n(G)`. -/
theorem mul_pow_prime_eq_of_pLowerCentralSeries_eq_bot (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) {n : ℕ}
    (hbot : (⊤ : Subgroup G).pLowerCentralSeries p (n + 2) = ⊥) {a y : G}
    (hy : y ∈ (⊤ : Subgroup G).pLowerCentralSeries p n) :
    (a * y) ^ p = a ^ p * y ^ p := by
  have hLn := hpow.pLowerCentralSeries hG n
  have hsucc1 := hpow.pLowerCentralSeries_succ_eq_powerClosure hG n
  have hsucc2 : (⊤ : Subgroup G).pLowerCentralSeries p (n + 2) =
      ((⊤ : Subgroup G).pLowerCentralSeries p (n + 1)).powerClosure p :=
    hpow.pLowerCentralSeries_succ_eq_powerClosure hG (n + 1)
  by_cases hp2 : p = 2
  · subst hp2
    have hLn4 : ⁅(⊤ : Subgroup G).pLowerCentralSeries 2 n, (⊤ : Subgroup G)⁆ ≤
        ((⊤ : Subgroup G).pLowerCentralSeries 2 n).powerClosure 4 := by
      simpa using hLn.2
    have h4 : ⁅y, a⁆ ∈ (⊤ : Subgroup G).pLowerCentralSeries 2 (n + 2) := by
      rw [hsucc2, hsucc1]
      exact powerClosure_mul_le _ 2 2 (hLn4 (commutator_mem_commutator hy (mem_top a)))
    have hcomm : Commute a y :=
      (commutatorElement_eq_one_iff_commute.mp (mem_bot.mp (hbot ▸ h4))).symm
    exact hcomm.mul_pow 2
  · have hc_mem : ⁅y, a⁆ ∈ (⊤ : Subgroup G).pLowerCentralSeries p (n + 1) := by
      rw [hsucc1]
      exact hLn.commutator_le_powerClosure_prime (commutator_mem_commutator hy (mem_top a))
    have hZ : (⊤ : Subgroup G).pLowerCentralSeries p (n + 1) ≤ center G := by
      rw [← commutator_top_right_eq_bot_iff_le_center]
      refine le_bot_iff.mp ?_
      rw [← hbot, hsucc2]
      exact (hpow.pLowerCentralSeries hG (n + 1)).commutator_le_powerClosure_prime
    have hcZ : ⁅y, a⁆ ∈ center G := hZ hc_mem
    have hca : Commute a ⁅y, a⁆ := mem_center_iff.mp hcZ a
    have hcy : Commute y ⁅y, a⁆ := mem_center_iff.mp hcZ y
    have hcp : ⁅y, a⁆ ^ p = 1 := mem_bot.mp (hbot ▸ pow_mem_pLowerCentralSeries_succ _ _ hc_mem)
    obtain ⟨k, hk⟩ := hp.out.dvd_choose_self (by decide) (hp.out.two_le.lt_of_ne' hp2)
    rw [hca.mul_pow_eq_pow_mul_pow_mul_commutatorElement_pow_choose_two hcy, hk, pow_mul, hcp,
      one_pow, mul_one]

/-- When `λ_{n+2}(G) = ⊥`, every element of `λ_{n+1}(G)` is a `p`-th power of an element of
`λ_n(G)`. -/
private theorem exists_pow_eq_of_mem_pLowerCentralSeries_succ (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) {n : ℕ}
    (hbot : (⊤ : Subgroup G).pLowerCentralSeries p (n + 2) = ⊥) {z : G}
    (hz : z ∈ (⊤ : Subgroup G).pLowerCentralSeries p (n + 1)) :
    ∃ w ∈ (⊤ : Subgroup G).pLowerCentralSeries p n, w ^ p = z := by
  let P : Subgroup G :=
    { carrier := {z | ∃ w ∈ (⊤ : Subgroup G).pLowerCentralSeries p n, w ^ p = z}
      one_mem' := ⟨1, one_mem _, one_pow p⟩
      mul_mem' := by
        rintro _ _ ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
        exact ⟨u * v, mul_mem hu hv,
          hpow.mul_pow_prime_eq_of_pLowerCentralSeries_eq_bot hG hbot hv⟩
      inv_mem' := by
        rintro _ ⟨u, hu, rfl⟩
        exact ⟨u⁻¹, inv_mem hu, inv_pow u p⟩ }
  have hle : (⊤ : Subgroup G).pLowerCentralSeries p (n + 1) ≤ P := by
    rw [hpow.pLowerCentralSeries_succ_eq_powerClosure hG n, powerClosure_le_iff]
    exact fun w hw ↦ ⟨w, hw, rfl⟩
  exact hle hz

/-- Strong-induction core of DDMS Lemma 2.8: every element of `G ^ p` is a `p`-th power. -/
private theorem exists_pow_eq_of_mem_powerClosure_aux (m : ℕ) :
    ∀ (G : Type u) [Group G] [Finite G], Nat.card G = m → IsPGroup p G →
      (⊤ : Subgroup G).IsPowerfullyEmbedded p →
      ∀ g ∈ (⊤ : Subgroup G).powerClosure p, ∃ x : G, x ^ p = g := by
  classical
  induction m using Nat.strong_induction_on with
  | _ m ih =>
  intro G _ _ hm hG hpow g hg
  by_cases h1 : (⊤ : Subgroup G).pLowerCentralSeries p 1 = ⊥
  · have h1' : (⊤ : Subgroup G).powerClosure p = ⊥ := by
      simpa [pLowerCentralSeries_zero] using
        (hpow.pLowerCentralSeries_succ_eq_powerClosure hG 0).symm.trans h1
    exact ⟨1, by simp [mem_bot.mp (h1' ▸ hg)]⟩
  -- Pick the minimal `k` with `λ_k(G) = ⊥`; since `λ_1 ≠ ⊥`, `k = n + 2` for some `n`.
  have hex : ∃ k, (⊤ : Subgroup G).pLowerCentralSeries p k = ⊥ :=
    (hG.to_subgroup ⊤).exists_pLowerCentralSeries_eq_bot
  set k := Nat.find hex
  have hk_bot : (⊤ : Subgroup G).pLowerCentralSeries p k = ⊥ := Nat.find_spec hex
  have hk2 : 2 ≤ k := by
    by_contra hlt
    exact h1 (le_bot_iff.mp ((pLowerCentralSeries_antitone p ⊤ (by omega)).trans hk_bot.le))
  set n := k - 2
  have hn2 : n + 2 = k := by omega
  set K := (⊤ : Subgroup G).pLowerCentralSeries p (n + 1)
  have hK_ne : K ≠ ⊥ := Nat.find_min hex (by omega)
  have hlt : Nat.card (G ⧸ K) < m := by
    rw [← hm, ← K.index_eq_card, ← K.card_mul_index]
    exact (Nat.lt_mul_iff_one_lt_left (Nat.pos_of_ne_zero K.index_ne_zero_of_finite)).mpr
      (K.one_lt_card_iff_ne_bot.mpr hK_ne)
  -- Lift `g` from the smaller finite powerful `p`-group `G ⧸ K`.
  let q := QuotientGroup.mk' K
  have hqpow : (⊤ : Subgroup (G ⧸ K)).IsPowerfullyEmbedded p := by
    have h := hpow.map_of_surjective (QuotientGroup.mk'_surjective K)
    rwa [map_top_of_surjective _ (QuotientGroup.mk'_surjective K)] at h
  have hqg : q g ∈ (⊤ : Subgroup (G ⧸ K)).powerClosure p := by
    rw [← map_top_of_surjective q (QuotientGroup.mk'_surjective K), ← powerClosure_map]
    exact mem_map_of_mem q hg
  obtain ⟨qx, hqx⟩ := ih _ hlt (G ⧸ K) rfl (hG.to_quotient K) hqpow (q g) hqg
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective K qx
  have hzK : (x ^ p)⁻¹ * g ∈ K := by
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
      QuotientGroup.mk_pow]
    exact inv_mul_eq_one.mpr (by simpa [q, QuotientGroup.mk'_apply] using hqx)
  obtain ⟨w, hw, hwp⟩ :=
    hpow.exists_pow_eq_of_mem_pLowerCentralSeries_succ hG (hn2.symm ▸ hk_bot) hzK
  refine ⟨x * w, ?_⟩
  rw [hpow.mul_pow_prime_eq_of_pLowerCentralSeries_eq_bot hG (hn2.symm ▸ hk_bot) hw, hwp,
    mul_inv_cancel_left]

/-- **Every element of `G ^ p` in a finite powerful `p`-group is a `p`-th power** (DDMS,
Lemma 2.8). -/
theorem exists_pow_eq_of_mem_powerClosure (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) {g : G}
    (hg : g ∈ (⊤ : Subgroup G).powerClosure p) : ∃ x : G, x ^ p = g :=
  exists_pow_eq_of_mem_powerClosure_aux _ G rfl hG hpow g hg

/-- **Elements of the lower `p`-central series of a finite powerful `p`-group** (DDMS, Theorem
2.9): `λ_k(G)` consists precisely of the `p ^ k`-th powers of elements of `G`. -/
theorem mem_pLowerCentralSeries_iff_exists_pow_pow (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (k : ℕ) {g : G} :
    g ∈ (⊤ : Subgroup G).pLowerCentralSeries p k ↔ ∃ x : G, x ^ p ^ k = g := by
  induction k generalizing g with
  | zero => simp
  | succ k ih =>
    constructor
    · intro hg
      set L := (⊤ : Subgroup G).pLowerCentralSeries p k
      have hLpow : (⊤ : Subgroup L).IsPowerfullyEmbedded p :=
        (hpow.pLowerCentralSeries hG k).top_of_isPowerfullyEmbedded
      rw [hpow.pLowerCentralSeries_succ_eq_powerClosure hG k] at hg
      have hgL : (⟨g, powerClosure_le L p hg⟩ : L) ∈ (⊤ : Subgroup L).powerClosure p := by
        rw [← mem_map_iff_mem L.subtype_injective, powerClosure_map, ← MonoidHom.range_eq_map,
          L.range_subtype]
        exact hg
      obtain ⟨y, hy⟩ := hLpow.exists_pow_eq_of_mem_powerClosure (hG.to_subgroup L) hgL
      obtain ⟨x, hx⟩ := (ih (g := (y : G))).mp y.2
      refine ⟨x, ?_⟩
      rw [pow_succ, pow_mul, hx]
      exact congrArg Subtype.val hy
    · rintro ⟨x, rfl⟩
      rw [pow_succ, pow_mul]
      exact pow_mem_pLowerCentralSeries_succ p ⊤ ((ih (g := x ^ p ^ k)).mpr ⟨x, rfl⟩)

/-- **Power-subgroup description of the lower `p`-central series of a finite powerful `p`-group**
(DDMS, Theorem 2.9): `λ_k(G) = G ^ (p ^ k)`. -/
theorem pLowerCentralSeries_eq_powerClosure_pow (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (k : ℕ) :
    (⊤ : Subgroup G).pLowerCentralSeries p k = (⊤ : Subgroup G).powerClosure (p ^ k) := by
  refine le_antisymm (fun g hg ↦ ?_) (powerClosure_le_iff.mpr fun x _ ↦ ?_)
  · obtain ⟨x, rfl⟩ := (hpow.mem_pLowerCentralSeries_iff_exists_pow_pow hG k).mp hg
    exact pow_mem_powerClosure (mem_top x) (p ^ k)
  · exact (hpow.mem_pLowerCentralSeries_iff_exists_pow_pow hG k).mpr ⟨x, rfl⟩

end IsPowerfullyEmbedded

end FinitePGroup

