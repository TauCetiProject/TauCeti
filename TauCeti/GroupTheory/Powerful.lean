/-!
# Finite powerful `p`-groups and powerfully embedded subgroups

A subgroup `N` of `G` is **powerfully embedded** for `p` when `N` is normal in `G` and
`⁅N, G⁆ ≤ N.powClosure (if p = 2 then 4 else p)`. A group `G` is powerful for `p` when `⊤` is
powerfully embedded. Following Chapter 2 of Dixon–du Sautoy–Mann–Segal, this file proves that in a
finite `p`-group `N.powClosure p` remains powerfully embedded
(`Subgroup.IsPowerfullyEmbedded.powClosure`), every lower `p`-central series term `λ_k` satisfies
`λ_{k+1} = λ_k.powClosure p`, `(x * y) ^ p = x ^ p * y ^ p` modulo `λ_{m+2}` for `y ∈ λ_m`, and
every element of `λ_k(G)` is a `p ^ k`-th power.

## Main results

* `Subgroup.powClosure`, `Subgroup.IsPowerfullyEmbedded`: power subgroups and powerful embedding.
* `IsPGroup.eq_bot_of_le_commutator_top`: nilpotency descent (`K ≤ ⁅K, ⊤⁆ → K = ⊥`).
* `Subgroup.IsPowerfullyEmbedded.powClosure`: DDMS Theorem 2.7 (`N` powerfully embedded implies
  `N.powClosure p` powerfully embedded).
* `Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries`,
  `Subgroup.IsPowerfullyEmbedded.pLowerCentralSeries_succ_eq_powClosure`,
  `Subgroup.IsPowerfullyEmbedded.mk_mul_pow_pLowerCentralSeries_add_two`: lower `p`-series
  identities in a finite powerful `p`-group.
* `Subgroup.IsPowerfullyEmbedded.exists_pow_eq_of_mem_pLowerCentralSeries_one`,
  `Subgroup.IsPowerfullyEmbedded.map_subtype_pLowerCentralSeries_pLowerCentralSeries`,
  `Subgroup.IsPowerfullyEmbedded.mem_pLowerCentralSeries_iff_exists_pow_pow`: DDMS Lemma 2.10 and
  Theorem 2.11 (`λ_k(G)` consists of the `p ^ k`-th powers).

## References

* J. D. Dixon, M. P. F. du Sautoy, A. Mann, and D. Segal, *Analytic pro-`p` groups*, 2nd ed.,
  Chapter 2 (Theorem 2.7, Lemma 2.10, Theorem 2.11).
-/

public section

open scoped commutatorElement

namespace Subgroup

variable {G : Type*} [Group G]

/-! ### The power subgroup of a subgroup -/

/-- The subgroup generated by the `n`-th powers of elements of `N`. -/
def powClosure (N : Subgroup G) (n : ℕ) : Subgroup G :=
  closure ((fun x : G ↦ x ^ n) '' (N : Set G))

/-- The defining equation of `Subgroup.powClosure`. -/
theorem powClosure_def (N : Subgroup G) (n : ℕ) :
    N.powClosure n = closure ((fun x : G ↦ x ^ n) '' (N : Set G)) :=
  (rfl)

/-- The `n`-th power of an element of `N` lies in `N.powClosure n`. -/
theorem pow_mem_powClosure {N : Subgroup G} {x : G} (hx : x ∈ N) (n : ℕ) :
    x ^ n ∈ N.powClosure n :=
  subset_closure ⟨x, hx, rfl⟩

/-- `N.powClosure n ≤ K` holds exactly when the `n`-th power of every element of `N` lies in `K`. -/
theorem powClosure_le_iff {N K : Subgroup G} {n : ℕ} :
    N.powClosure n ≤ K ↔ ∀ x ∈ N, x ^ n ∈ K := by
  simp only [powClosure_def, closure_le, Set.subset_def, Set.forall_mem_image, SetLike.mem_coe]

/-- The power subgroup of `N` is contained in `N`. -/
theorem powClosure_le (N : Subgroup G) (n : ℕ) : N.powClosure n ≤ N :=
  powClosure_le_iff.mpr fun _ hx ↦ pow_mem hx n

/-- `Subgroup.powClosure` is monotone in the subgroup. -/
theorem powClosure_mono {H K : Subgroup G} (h : H ≤ K) (n : ℕ) :
    H.powClosure n ≤ K.powClosure n :=
  powClosure_le_iff.mpr fun _ hx ↦ pow_mem_powClosure (h hx) n

/-- Naturality of `Subgroup.powClosure` under group homomorphisms. -/
@[simp]
theorem powClosure_map {H : Type*} [Group H] (N : Subgroup G) (f : G →* H) (n : ℕ) :
    (N.powClosure n).map f = (N.map f).powClosure n := by
  rw [powClosure_def, powClosure_def, MonoidHom.map_closure, coe_map, Set.image_image,
    Set.image_image]
  simp only [map_pow]

/-- The `(m * n)`-th powers of elements of `N` lie in `(N.powClosure m).powClosure n`. -/
theorem powClosure_mul_le (N : Subgroup G) (m n : ℕ) :
    N.powClosure (m * n) ≤ (N.powClosure m).powClosure n :=
  powClosure_le_iff.mpr fun x hx ↦
    pow_mul x m n ▸ pow_mem_powClosure (pow_mem_powClosure hx m) n

/-- Any element normalising `N` also normalises `N.powClosure n`. -/
theorem normalizer_le_normalizer_powClosure (N : Subgroup G) (n : ℕ) :
    normalizer (N : Set G) ≤ normalizer (N.powClosure n : Set G) := fun _ hg ↦ by
  rw [mem_normalizer_iff_map_conj_eq] at hg ⊢
  rw [powClosure_map, hg]

/-- The power subgroup of a normal subgroup is normal. -/
instance powClosure_normal (N : Subgroup G) [N.Normal] (n : ℕ) : (N.powClosure n).Normal :=
  normalizer_eq_top_iff.mp <| top_le_iff.mp <| by
    simpa [normalizer_eq_top] using N.normalizer_le_normalizer_powClosure n

/-- The power subgroup of a characteristic subgroup is characteristic. -/
instance powClosure_characteristic (N : Subgroup G) [N.Characteristic] (n : ℕ) :
    (N.powClosure n).Characteristic :=
  characteristic_iff_map_eq.mpr fun φ ↦ by
    rw [powClosure_map, characteristic_iff_map_eq.mp ‹N.Characteristic› φ]

/-- The `n`-th power subgroup of `⊤` is generated by all `n`-th powers in `G`. -/
theorem powClosure_top (n : ℕ) :
    (⊤ : Subgroup G).powClosure n = closure (Set.range fun g : G ↦ g ^ n) := by
  rw [powClosure_def, coe_top, Set.image_univ]

/-! ### Nilpotency descent in finite `p`-groups -/

/-- **Nilpotency descent in a finite `p`-group**: a subgroup contained in its commutator with the
whole group is trivial. -/
theorem _root_.IsPGroup.eq_bot_of_le_commutator_top {p : ℕ} [Fact p.Prime] [Finite G]
    (hG : IsPGroup p G) {K : Subgroup G} (hK : K ≤ ⁅K, (⊤ : Subgroup G)⁆) : K = ⊥ := by
  have hle : ∀ n, K ≤ (⊤ : Subgroup G).lowerCentralSeries n := fun n ↦ by
    induction n with
    | zero => exact le_top
    | succ n ih =>
      exact lowerCentralSeries_succ (⊤ : Subgroup G) n ▸ hK.trans (commutator_mono ih le_rfl)
  obtain ⟨n, hn⟩ := (hG.to_subgroup ⊤).exists_pLowerCentralSeries_eq_bot
  exact le_bot_iff.mp
    ((hle n).trans ((lowerCentralSeries_le_pLowerCentralSeries p ⊤ n).trans hn.le))

/-! ### Powerfully embedded subgroups -/

/-- A subgroup `N` of `G` is **powerfully embedded** for `p` when `N` is normal in `G` and
`⁅N, ⊤⁆ ≤ N.powClosure (if p = 2 then 4 else p)`. -/
def IsPowerfullyEmbedded (p : ℕ) (N : Subgroup G) : Prop :=
  N.Normal ∧ ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powClosure (if p = 2 then 4 else p)

/-- The defining property of `Subgroup.IsPowerfullyEmbedded`. -/
theorem isPowerfullyEmbedded_iff (p : ℕ) (N : Subgroup G) :
    N.IsPowerfullyEmbedded p ↔
      N.Normal ∧ ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powClosure (if p = 2 then 4 else p) :=
  (Iff.rfl)

namespace IsPowerfullyEmbedded

variable {p : ℕ} {N : Subgroup G}

/-- A powerfully embedded subgroup is normal. -/
theorem normal (hN : N.IsPowerfullyEmbedded p) : N.Normal := hN.1

/-- The commutator containment of a powerfully embedded subgroup. -/
theorem commutator_top_le (hN : N.IsPowerfullyEmbedded p) :
    ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powClosure (if p = 2 then 4 else p) := hN.2

/-- In particular, `⁅N, ⊤⁆ ≤ N.powClosure p` for every `p` (at `p = 2`, fourth powers are
squares). -/
theorem commutator_top_le_powClosure (hN : N.IsPowerfullyEmbedded p) :
    ⁅N, (⊤ : Subgroup G)⁆ ≤ N.powClosure p := by
  by_cases hp : p = 2
  · subst hp; exact hN.2.trans ((N.powClosure_mul_le 2 2).trans (powClosure_le _ 2))
  · simpa [hp] using hN.2

/-- The image of a powerfully embedded subgroup under a surjective homomorphism is powerfully
embedded. -/
theorem map {H : Type*} [Group H] (hN : N.IsPowerfullyEmbedded p) {f : G →* H}
    (hf : Function.Surjective f) : (N.map f).IsPowerfullyEmbedded p := by
  have := hN.1
  refine ⟨Subgroup.Normal.map hN.1 f hf, ?_⟩
  rw [← MonoidHom.range_eq_top.mpr hf, ← Subgroup.map_top, ← map_commutator, ← powClosure_map]
  exact Subgroup.map_mono hN.2

/-- A powerfully embedded subgroup is itself powerful as an abstract group. -/
theorem top_subtype (hN : N.IsPowerfullyEmbedded p) : (⊤ : Subgroup N).IsPowerfullyEmbedded p := by
  refine ⟨inferInstance, ?_⟩
  rw [← map_subtype_le_map_subtype, map_commutator, powClosure_map, Subgroup.map_top,
    Subgroup.range_subtype]
  exact (commutator_mono le_rfl le_top).trans hN.2

/-- Odd-prime central reduction for `Subgroup.IsPowerfullyEmbedded.powClosure`. -/
private theorem commutator_powClosure_eq_bot_of_odd (hp : Odd p) (hN : N.IsPowerfullyEmbedded p)
    (hexp : (N.powClosure p).powClosure p = ⊥)
    (hcent : ⁅N.powClosure p, (⊤ : Subgroup G)⁆ ≤ center G) :
    ⁅N.powClosure p, (⊤ : Subgroup G)⁆ = ⊥ := by
  have := hN.1
  have hpow1 : ∀ u ∈ N.powClosure p, u ^ p = 1 := fun u hu ↦
    mem_bot.mp (hexp ▸ pow_mem_powClosure hu p)
  obtain ⟨k, rfl⟩ := hp
  have hp_dvd : 2 * k + 1 ∣ (2 * k + 1).choose 2 := ⟨k, by
    rw [Nat.choose_two_right, Nat.add_sub_cancel, mul_comm (2 * k + 1), mul_assoc,
      Nat.mul_div_cancel_left _ two_pos, mul_comm]⟩
  have hle : N.powClosure (2 * k + 1) ≤ center G := powClosure_le_iff.mpr fun x hx ↦
    mem_center_iff.mpr fun g ↦ mul_inv_eq_iff_eq_mul.mp <| by
      set z : G := ⁅g, x⁆
      have hz : z ∈ N.powClosure (2 * k + 1) := hN.commutator_top_le_powClosure
        (commutator_comm ⊤ N ▸ commutator_mem_commutator (mem_top g) hx)
      have hxz_cent : ⁅x, z⁆ ∈ center G := hcent
        (commutator_comm ⊤ (N.powClosure _) ▸ commutator_mem_commutator (mem_top x) hz)
      have hxz_mem : ⁅x, z⁆ ∈ N.powClosure (2 * k + 1) :=
        commutatorElement_def x z ▸ mul_mem ((powClosure_normal N _).conj_mem z hz x) (inv_mem hz)
      obtain ⟨c, hc⟩ := hp_dvd
      calc g * x ^ (2 * k + 1) * g⁻¹ = (z * x) ^ (2 * k + 1) := by
            rw [← conj_pow]; simp [z, commutatorElement_def, mul_assoc]
        _ = z ^ (2 * k + 1) * x ^ (2 * k + 1) * ⁅x, z⁆ ^ (2 * k + 1).choose 2 :=
            Commute.mul_pow_eq_pow_mul_pow_mul_commutatorElement_pow_choose_two
              (mem_center_iff.mp hxz_cent z) (mem_center_iff.mp hxz_cent x) _
        _ = x ^ (2 * k + 1) := by
            rw [hpow1 z hz, one_mul, hc, pow_mul, hpow1 _ hxz_mem, one_pow, mul_one]
  exact le_bot_iff.mp (commutator_le.mpr fun a ha g _ ↦
    mem_bot.mpr (commutatorElement_eq_one_iff_commute.mpr (mem_center_iff.mp (hle ha) g).symm))

/-- If `A` has exponent dividing `4` and `⁅A, ⊤⁆ ≤ center G`, every element of `A.powClosure 2`
has square `1`. -/
private theorem powClosure_two_sq_eq_one {A : Subgroup G}
    (hA4 : ∀ u ∈ A, u ^ 4 = 1) (hcent : ⁅A, (⊤ : Subgroup G)⁆ ≤ center G) :
    ∀ w ∈ A.powClosure 2, w ^ 2 = 1 := by
  have hsq_comm : ∀ u ∈ A, ∀ v ∈ A, Commute (u ^ 2) (v ^ 2) := fun u hu v hv ↦ by
    have huv_cent : ⁅u, v⁆ ∈ center G := hcent (commutator_mem_commutator hu (mem_top v))
    have h1 : ⁅u ^ 2, v⁆ = ⁅u, v⁆ ^ 2 :=
      (Commute.commutatorElement_pow_left (mem_center_iff.mp huv_cent u) 2).symm
    have h2 : ⁅u ^ 2, v ^ 2⁆ = ⁅u, v⁆ ^ 4 := by
      rw [← Commute.commutatorElement_pow_right
        (mem_center_iff.mp (h1 ▸ pow_mem huv_cent 2) v) 2, h1, ← pow_mul]
    exact commutatorElement_eq_one_iff_commute.mp <| h2.trans <| hA4 _ <|
      commutatorElement_def u v ▸ mul_mem (mul_mem (mul_mem hu hv) (inv_mem hu)) (inv_mem hv)
  have hgen : ∀ u ∈ A, ∀ w ∈ A.powClosure 2, Commute (u ^ 2) w := fun u hu w hw ↦
    mem_centralizer_iff.mp ((powClosure_le_iff.mpr fun v hv ↦ mem_centralizer_iff.mpr fun _ h' ↦
      (Set.mem_singleton_iff.mp h' ▸ hsq_comm u hu v hv).eq) hw) _ (Set.mem_singleton _)
  have hA2_comm : ∀ w₁ ∈ A.powClosure 2, ∀ w₂ ∈ A.powClosure 2, Commute w₁ w₂ := fun w₁ hw₁ w₂ hw₂ ↦
    (mem_centralizer_iff.mp ((powClosure_le_iff.mpr fun u hu ↦ mem_centralizer_iff.mpr fun _ h' ↦
      (Set.mem_singleton_iff.mp h' ▸ (hgen u hu w₂ hw₂).symm).eq) hw₁) _ (Set.mem_singleton _)).symm
  intro w hw
  induction hw using Subgroup.closure_induction with
  | mem _ h => obtain ⟨u, hu, rfl⟩ := h; rw [← pow_mul]; exact hA4 u hu
  | one => exact one_pow 2
  | mul x y hx hy h1 h2 => rw [(hA2_comm x hx y hy).mul_pow, h1, h2, mul_one]
  | inv x _ h1 => rw [inv_pow, h1, inv_one]

/-- Dyadic (`p = 2`) central reduction for `Subgroup.IsPowerfullyEmbedded.powClosure`. -/
private theorem commutator_powClosure_eq_bot_of_two (hN : N.IsPowerfullyEmbedded 2)
    (hexp : (N.powClosure 2).powClosure 4 = ⊥)
    (hcent : ⁅N.powClosure 2, (⊤ : Subgroup G)⁆ ≤ center G) :
    ⁅N.powClosure 2, (⊤ : Subgroup G)⁆ = ⊥ := by
  set A := N.powClosure 2
  have hN4 : N.powClosure 4 ≤ A.powClosure 2 := N.powClosure_mul_le 2 2
  have hA2_sq : ∀ w ∈ A.powClosure 2, w ^ 2 = 1 :=
    powClosure_two_sq_eq_one (fun u hu ↦ mem_bot.mp (hexp ▸ pow_mem_powClosure hu 4)) hcent
  have hA2_cent : A.powClosure 2 ≤ center G := powClosure_le_iff.mpr fun u hu ↦
    mem_center_iff.mpr fun x ↦ (commutatorElement_eq_one_iff_commute.mp <| by
      rw [← Commute.commutatorElement_pow_left
        (mem_center_iff.mp (hcent (commutator_mem_commutator hu (mem_top x))) u) 2,
        hA2_sq _ (hN4 (hN.2
          (commutator_mem_commutator (powClosure_le N 2 hu) (mem_top x))))]).symm.eq
  have hle : A ≤ center G := powClosure_le_iff.mpr fun x hx ↦
    mem_center_iff.mpr fun g ↦ mul_inv_eq_iff_eq_mul.mp <| by
      set z : G := ⁅g, x⁆
      have hz : z ∈ A.powClosure 2 :=
        hN4 (hN.2 (commutator_comm ⊤ N ▸ commutator_mem_commutator (mem_top g) hx))
      calc g * x ^ 2 * g⁻¹ = (z * x) ^ 2 := by
            rw [← conj_pow]; simp [z, commutatorElement_def, mul_assoc]
        _ = z ^ 2 * x ^ 2 := Commute.mul_pow (mem_center_iff.mp (hA2_cent hz) x).symm 2
        _ = x ^ 2 := by rw [hA2_sq z hz, one_mul]
  exact le_bot_iff.mp (commutator_le.mpr fun a ha g _ ↦
    mem_bot.mpr (commutatorElement_eq_one_iff_commute.mpr (mem_center_iff.mp (hle ha) g).symm))

/-- Nilpotency reduction for `Subgroup.IsPowerfullyEmbedded.powClosure`. -/
private theorem commutator_powClosure_eq_bot [hp : Fact p.Prime] [Finite G] (hG : IsPGroup p G)
    (hN : N.IsPowerfullyEmbedded p)
    (hexp : (N.powClosure p).powClosure (if p = 2 then 4 else p) = ⊥) :
    ⁅N.powClosure p, (⊤ : Subgroup G)⁆ = ⊥ := by
  have := hN.1
  set M : Subgroup G := ⁅N.powClosure p, (⊤ : Subgroup G)⁆
  set L : Subgroup G := ⁅M, (⊤ : Subgroup G)⁆
  let q : G →* G ⧸ L := QuotientGroup.mk' L
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective L
  have htop : (⊤ : Subgroup G).map q = ⊤ := Subgroup.map_top q ▸ MonoidHom.range_eq_top.mpr hq
  have hexp' : ((N.map q).powClosure p).powClosure (if p = 2 then 4 else p) = ⊥ := by
    rw [← powClosure_map, ← powClosure_map, hexp, map_bot]
  have hM' : ⁅(N.map q).powClosure p, (⊤ : Subgroup (G ⧸ L))⁆ = M.map q := by
    rw [← powClosure_map, ← htop, ← map_commutator]
  have hcent' : ⁅(N.map q).powClosure p, (⊤ : Subgroup (G ⧸ L))⁆ ≤ center (G ⧸ L) := by
    rw [hM']; intro x hx
    refine mem_center_iff.mpr fun y ↦ (commutatorElement_eq_one_iff_commute.mp ?_).symm
    have hLq : ⁅M.map q, (⊤ : Subgroup (G ⧸ L))⁆ = ⊥ := by
      rw [← htop, ← map_commutator, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    exact mem_bot.mp (hLq ▸ commutator_mem_commutator hx (mem_top y))
  have hbot' : ⁅(N.map q).powClosure p, (⊤ : Subgroup (G ⧸ L))⁆ = ⊥ := by
    by_cases hp2 : p = 2
    · subst hp2; exact (hN.map hq).commutator_powClosure_eq_bot_of_two hexp' hcent'
    · exact (hN.map hq).commutator_powClosure_eq_bot_of_odd (hp.out.odd_of_ne_two hp2)
        (by simpa [hp2] using hexp') hcent'
  exact hG.eq_bot_of_le_commutator_top <| by
    change M ≤ L
    rw [← QuotientGroup.ker_mk' L, ← Subgroup.map_eq_bot_iff, ← hM']; exact hbot'

/-- **Powerfully embedded subgroups are stable under `p`-th powers** (Dixon–du Sautoy–Mann–Segal,
Theorem 2.7): in a finite `p`-group, if `N` is powerfully embedded in `G`, then `N.powClosure p`
is powerfully embedded in `G`. -/
theorem powClosure [Fact p.Prime] [Finite G] (hG : IsPGroup p G)
    (hN : N.IsPowerfullyEmbedded p) : (N.powClosure p).IsPowerfullyEmbedded p := by
  have := hN.1
  set K : Subgroup G := (N.powClosure p).powClosure (if p = 2 then 4 else p)
  refine ⟨inferInstance, ?_⟩
  let q : G →* G ⧸ K := QuotientGroup.mk' K
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective K
  have hexp : ((N.map q).powClosure p).powClosure (if p = 2 then 4 else p) = ⊥ := by
    rw [← powClosure_map, ← powClosure_map, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
  change ⁅N.powClosure p, (⊤ : Subgroup G)⁆ ≤ K
  rw [← QuotientGroup.ker_mk' K, ← Subgroup.map_eq_bot_iff, map_commutator, powClosure_map,
    Subgroup.map_top, MonoidHom.range_eq_top.mpr hq]
  exact (hN.map hq).commutator_powClosure_eq_bot (hG.to_quotient K) hexp

/-! ### Lower `p`-central series of a finite powerful `p`-group -/

section LowerPSeries

variable [hp : Fact p.Prime] [Finite G]

/-- In a finite powerful `p`-group, every term of the lower `p`-central series is powerfully
embedded. -/
theorem pLowerCentralSeries (hG : IsPGroup p G) (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p)
    (k : ℕ) : ((⊤ : Subgroup G).pLowerCentralSeries p k).IsPowerfullyEmbedded p := by
  induction k with
  | zero => rwa [Subgroup.pLowerCentralSeries_zero]
  | succ k ih =>
    rw [Subgroup.pLowerCentralSeries_succ, ← powClosure_def,
      sup_eq_left.mpr ih.commutator_top_le_powClosure]
    exact ih.powClosure hG

/-- In a finite powerful `p`-group, each term of the lower `p`-central series is generated by the
`p`-th powers of the preceding term. -/
theorem pLowerCentralSeries_succ_eq_powClosure (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (k : ℕ) :
    (⊤ : Subgroup G).pLowerCentralSeries p (k + 1) =
      ((⊤ : Subgroup G).pLowerCentralSeries p k).powClosure p := by
  rw [Subgroup.pLowerCentralSeries_succ, ← powClosure_def, sup_eq_left]
  exact (hpow.pLowerCentralSeries hG k).commutator_top_le_powClosure

/-- In a finite powerful `2`-group, `⁅λ_k, ⊤⁆ ≤ λ_{k+2}` for every `k`. -/
theorem commutator_pLowerCentralSeries_top_le_add_two (hG : IsPGroup 2 G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded 2) (k : ℕ) :
    ⁅(⊤ : Subgroup G).pLowerCentralSeries 2 k, (⊤ : Subgroup G)⁆ ≤
      (⊤ : Subgroup G).pLowerCentralSeries 2 (k + 2) := by
  rw [hpow.pLowerCentralSeries_succ_eq_powClosure hG (k + 1),
    hpow.pLowerCentralSeries_succ_eq_powClosure hG k]
  exact (hpow.pLowerCentralSeries hG k).commutator_top_le.trans (powClosure_mul_le _ 2 2)

/-- **Multiplicativity of the `p`-th power map modulo `λ_{m+2}`**: in a finite powerful `p`-group,
for arbitrary `x : G` and `y ∈ λ_m(G)`, `(x * y) ^ p = x ^ p * y ^ p` in `G ⧸ λ_{m+2}(G)`. This
holds for every prime `p`, including `p = 2`. -/
theorem mk_mul_pow_pLowerCentralSeries_add_two (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (m : ℕ) (x : G) {y : G}
    (hy : y ∈ (⊤ : Subgroup G).pLowerCentralSeries p m) :
    ((x * y : G) : G ⧸ (⊤ : Subgroup G).pLowerCentralSeries p (m + 2)) ^ p =
      (x : G ⧸ (⊤ : Subgroup G).pLowerCentralSeries p (m + 2)) ^ p *
        (y : G ⧸ (⊤ : Subgroup G).pLowerCentralSeries p (m + 2)) ^ p := by
  set N := (⊤ : Subgroup G).pLowerCentralSeries p (m + 2)
  rw [QuotientGroup.mk_mul]
  by_cases hp2 : p = 2
  · subst hp2
    exact (QuotientGroup.commute_mk_iff.mpr <| inv_mem_iff.mp <| commutatorElement_inv x y ▸
      hpow.commutator_pLowerCentralSeries_top_le_add_two hG m
        (commutator_mem_commutator hy (mem_top x))).mul_pow 2
  · have hyx : ⁅y, x⁆ ∈ (⊤ : Subgroup G).pLowerCentralSeries p (m + 1) :=
      Subgroup.commutator_mem_pLowerCentralSeries_succ p ⊤ hy (mem_top x)
    have hcent : ∀ g : G, Commute (g : G ⧸ N) ((⁅y, x⁆ : G) : G ⧸ N) := fun g ↦
      (QuotientGroup.commute_mk_iff.mpr
        (Subgroup.commutator_mem_pLowerCentralSeries_succ p ⊤ hyx (mem_top g))).symm
    have hmk_comm : ⁅(y : G ⧸ N), (x : G ⧸ N)⁆ = ((⁅y, x⁆ : G) : G ⧸ N) :=
      (map_commutatorElement (QuotientGroup.mk' N) y x).symm
    obtain ⟨c, hc⟩ :=
      hp.out.dvd_choose_self two_ne_zero (lt_of_le_of_ne hp.out.two_le (Ne.symm hp2))
    rw [Commute.mul_pow_eq_pow_mul_pow_mul_commutatorElement_pow_choose_two
        (hmk_comm.symm ▸ hcent x) (hmk_comm.symm ▸ hcent y) p,
      hmk_comm, hc, pow_mul, Subgroup.mk_pow_eq_one_of_mem_pLowerCentralSeries p ⊤ hyx,
      one_pow, mul_one]

/-- Every element of `λ_{m+1}` is congruent modulo `λ_{m+2}` to the `p`-th power of an element
of `λ_m`. -/
theorem exists_mk_pow_eq_of_mem_pLowerCentralSeries_succ (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (m : ℕ) {z : G}
    (hz : z ∈ (⊤ : Subgroup G).pLowerCentralSeries p (m + 1)) :
    ∃ y ∈ (⊤ : Subgroup G).pLowerCentralSeries p m,
      ((y ^ p : G) : G ⧸ (⊤ : Subgroup G).pLowerCentralSeries p (m + 2)) =
        (z : G ⧸ (⊤ : Subgroup G).pLowerCentralSeries p (m + 2)) := by
  set N := (⊤ : Subgroup G).pLowerCentralSeries p (m + 2)
  let f : (⊤ : Subgroup G).pLowerCentralSeries p m →* G ⧸ N :=
    { toFun := fun y ↦ ((y : G) : G ⧸ N) ^ p
      map_one' := by simp
      map_mul' := fun a b ↦ hpow.mk_mul_pow_pLowerCentralSeries_add_two hG m a b.property }
  have hle : ((⊤ : Subgroup G).pLowerCentralSeries p (m + 1)).map (QuotientGroup.mk' N) ≤
      f.range := by
    rw [hpow.pLowerCentralSeries_succ_eq_powClosure hG m, Subgroup.map_le_iff_le_comap,
      powClosure_le_iff]
    exact fun y hy ↦ ⟨⟨y, hy⟩, by simp [f, QuotientGroup.mk_pow]⟩
  obtain ⟨⟨y, hy⟩, hyz⟩ := hle ⟨z, hz, rfl⟩
  exact ⟨y, hy, by simpa [f, QuotientGroup.mk_pow] using hyz⟩

/-- Induction helper for `exists_pow_eq_of_mem_pLowerCentralSeries_one` on the `p`-class `n`. -/
private theorem exists_pow_eq_of_mem_pLowerCentralSeries_one_aux (n : ℕ) :
    ∀ {H : Type*} [Group H] [Finite H], IsPGroup p H →
      (⊤ : Subgroup H).IsPowerfullyEmbedded p →
      (⊤ : Subgroup H).pLowerCentralSeries p n = ⊥ →
      ∀ g ∈ (⊤ : Subgroup H).pLowerCentralSeries p 1, ∃ x : H, x ^ p = g := by
  induction n with
  | zero =>
    intro _ _ _ _ _ h0 g _
    rw [Subgroup.pLowerCentralSeries_zero] at h0
    exact ⟨1, (one_pow p).trans (mem_bot.mp (h0 ▸ mem_top g)).symm⟩
  | succ n ih =>
    cases n with
    | zero => exact fun _ _ h1 g hg ↦ ⟨1, (one_pow p).trans (mem_bot.mp (h1 ▸ hg)).symm⟩
    | succ m =>
      intro H _ _ hH hpow hbot g hg
      set K := (⊤ : Subgroup H).pLowerCentralSeries p (m + 1)
      let q : H →* H ⧸ K := QuotientGroup.mk' K
      have hq : Function.Surjective q := QuotientGroup.mk'_surjective K
      have htop : (⊤ : Subgroup H).map q = ⊤ := Subgroup.map_top q ▸ MonoidHom.range_eq_top.mpr hq
      have hQ_bot : (⊤ : Subgroup (H ⧸ K)).pLowerCentralSeries p (m + 1) = ⊥ := by
        rw [← htop, ← Subgroup.pLowerCentralSeries_map, Subgroup.map_eq_bot_iff,
          QuotientGroup.ker_mk']
      obtain ⟨xQ, hxQ⟩ := ih (hH.to_quotient K) (htop ▸ hpow.map hq) hQ_bot (q g)
        (htop ▸ Subgroup.pLowerCentralSeries_map p ⊤ q 1 ▸ ⟨g, hg, rfl⟩)
      obtain ⟨x, rfl⟩ := hq xQ
      have hw : (x ^ p)⁻¹ * g ∈ K := QuotientGroup.eq.mp (by simpa [q, map_pow] using hxQ)
      obtain ⟨y, hy, hyw⟩ := hpow.exists_mk_pow_eq_of_mem_pLowerCentralSeries_succ hH m hw
      refine ⟨x * y, eq_of_inv_mul_eq_one (mem_bot.mp (hbot ▸ QuotientGroup.eq.mp ?_))⟩
      rw [QuotientGroup.mk_pow, hpow.mk_mul_pow_pLowerCentralSeries_add_two hH m x hy,
        ← QuotientGroup.mk_pow, ← QuotientGroup.mk_pow, hyw, ← QuotientGroup.mk_mul]; simp

/-- **Every element of `λ_1(G)` is a `p`-th power** (Dixon–du Sautoy–Mann–Segal, Lemma 2.10):
in a finite powerful `p`-group `G`, every element of the first term of the lower `p`-central series
is of the form `x ^ p`. -/
theorem exists_pow_eq_of_mem_pLowerCentralSeries_one (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) {g : G}
    (hg : g ∈ (⊤ : Subgroup G).pLowerCentralSeries p 1) : ∃ x : G, x ^ p = g :=
  let ⟨n, hn⟩ := (hG.to_subgroup ⊤).exists_pLowerCentralSeries_eq_bot
  exists_pow_eq_of_mem_pLowerCentralSeries_one_aux n hG hpow hn g hg

/-- In a finite powerful `p`-group, the lower `p`-central series of `λ_k(G)` shifts the ambient
series by `k`. -/
theorem map_subtype_pLowerCentralSeries_pLowerCentralSeries (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (k j : ℕ) :
    ((⊤ : Subgroup ((⊤ : Subgroup G).pLowerCentralSeries p k)).pLowerCentralSeries p j).map
        ((⊤ : Subgroup G).pLowerCentralSeries p k).subtype =
      (⊤ : Subgroup G).pLowerCentralSeries p (k + j) := by
  set H := (⊤ : Subgroup G).pLowerCentralSeries p k
  have hH_pow := (hpow.pLowerCentralSeries hG k).top_subtype
  induction j with
  | zero => rw [pLowerCentralSeries_zero, map_top, range_subtype, add_zero]
  | succ j ih =>
    rw [hH_pow.pLowerCentralSeries_succ_eq_powClosure (hG.to_subgroup H) j, powClosure_map, ih,
      ← add_assoc, hpow.pLowerCentralSeries_succ_eq_powClosure hG (k + j)]

/-- **Every element of `λ_k(G)` is a `p ^ k`-th power**: in a finite powerful `p`-group `G`, the
`k`-th term of the lower `p`-central series consists precisely of the `p ^ k`-th powers. -/
theorem mem_pLowerCentralSeries_iff_exists_pow_pow (hG : IsPGroup p G)
    (hpow : (⊤ : Subgroup G).IsPowerfullyEmbedded p) (k : ℕ) {g : G} :
    g ∈ (⊤ : Subgroup G).pLowerCentralSeries p k ↔ ∃ x : G, x ^ (p ^ k) = g := by
  refine ⟨fun hg ↦ ?_, ?_⟩
  · induction k generalizing g with
    | zero => exact ⟨g, by simp⟩
    | succ k ih =>
      set H := (⊤ : Subgroup G).pLowerCentralSeries p k
      have hH_pow := (hpow.pLowerCentralSeries hG k).top_subtype
      obtain ⟨g', hg', rfl⟩ :=
        (hpow.map_subtype_pLowerCentralSeries_pLowerCentralSeries hG k 1 ▸ hg :
          g ∈ ((⊤ : Subgroup H).pLowerCentralSeries p 1).map H.subtype)
      obtain ⟨y, hy⟩ := hH_pow.exists_pow_eq_of_mem_pLowerCentralSeries_one (hG.to_subgroup H) hg'
      obtain ⟨x, hx⟩ := ih y.property
      exact ⟨x, by rw [pow_succ, pow_mul, hx]; exact congrArg Subtype.val hy⟩
  · rintro ⟨x, rfl⟩
    induction k with
    | zero => rw [Subgroup.pLowerCentralSeries_zero]; exact mem_top _
    | succ k ih => rw [pow_succ, pow_mul]; exact Subgroup.pow_mem_pLowerCentralSeries_succ p ⊤ ih

end LowerPSeries

