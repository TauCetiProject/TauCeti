/-!
# The Weyl group and Tits system of a Bruhat–Tits root datum

In a Bruhat–Tits root datum `D = (T, (U a, M a))` in `G` of finite crystallographic type `P`, the
Weyl normalizer `N = D.weylNormalizer` generated by `T` and the reflection cosets `M a` permutes
the root subgroups `U a` by conjugation, while `T` normalizes every `U a`.

This file proves that conjugation of root subgroups induces a surjective homomorphism
`D.weylGroupHom : D.weylNormalizer →* P.weylGroup` with kernel `T`, giving the canonical group
isomorphism `D.weylGroupEquiv : D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer ≃* P.weylGroup`
identifying `N / T` with the abstract Weyl group `W(Φ)` (Bruhat–Tits I, 6.1.11 (ii)). Along the way
it constructs the Tits system `(B, N)` with `B = D.borelSubgroup = T U⁺` in `G` when `D` is
generating (`RootDatum.IsGenerating.titsSystem`) and in `D.generatedSubgroup` in general
(`D.titsSystem`, Bruhat–Tits I, Théorème 6.1.15), proves `B ∩ N = T`
(`D.borelSubgroup_inf_weylNormalizer`), shows that any regular coweight defines a root datum with
the same `T`, `U`, and `M` (`D.withPositiveVector`, Bruhat–Tits I, 6.1.11 (i)), and proves the
ray-projection formula `D.iSup_inf_U_eq_of_commutator_le` used downstream to evaluate reflections on
valuations.

## Main definitions

* `TauCeti.BruhatTits.RootDatum.withPositiveVector`: the root datum obtained by replacing
  `D.positiveVector` with any regular coweight (Bruhat–Tits I, 6.1.11 (i)).
* `TauCeti.BruhatTits.RootDatum.weylGroupHom`: the homomorphism `N →* P.weylGroup` characterized by
  `n (U a) n⁻¹ = U (w a)`.
* `TauCeti.BruhatTits.RootDatum.IsGenerating.titsSystem`, `TauCeti.BruhatTits.RootDatum.titsSystem`:
  the Tits system `(B, N)` (Bruhat–Tits I, Théorème 6.1.15).
* `TauCeti.BruhatTits.RootDatum.weylGroupEquiv`: the canonical isomorphism `N / T ≃* W(Φ)`.

## Main results

* `TauCeti.BruhatTits.RootDatum.iSup_inf_U_eq_of_commutator_le`: ray-projection intersection
  formula `(⨆_{⟨a, z⟩ > 0} L a) ⊓ U i₀ = L i₀` at an indivisible `z`-positive root `i₀`.
* `TauCeti.BruhatTits.RootDatum.borelSubgroup_inf_weylNormalizer`: `B ∩ N = T`.
* `TauCeti.BruhatTits.RootDatum.ker_weylGroupHom`: `ker D.weylGroupHom = T`.

## References

* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. I. Données radicielles valuées*,
  Publ. Math. IHÉS 41 (1972), §§6.1.6–6.1.15, pp. 109–116.
-/

public section

open scoped Pointwise commutatorElement

namespace TauCeti.BruhatTits.RootDatum

variable {ι R M N : Type*} [Field R] [LinearOrder R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} {G : Type*} [Group G]

private abbrev reflN {D : RootDatum P G} {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.weylNormalizer :=
  ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩

/-- Every element `w ∈ P.weylGroup` is realized by conjugation of root subgroups by some
`n ∈ D.weylNormalizer`. -/
theorem exists_mem_weylNormalizer_conj_U (D : RootDatum P G) (w : P.weylGroup) :
    ∃ n : D.weylNormalizer, ∀ j,
      ConjAct.toConjAct (n : G) • D.U j = D.U (P.weylGroupToPerm w j) := by
  obtain ⟨g, hg⟩ := w; induction hg using RootPairing.weylGroup.induction with
  | mem i =>
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
    exact ⟨D.reflN hm, fun j ↦ by rw [D.reflection_conjugates i m hm j]; rfl⟩
  | one => exact ⟨1, fun _ ↦ by simp⟩
  | mul _ _ _ _ ih₁ ih₂ => obtain ⟨⟨n₁, hn₁⟩, ⟨n₂, hn₂⟩⟩ := ih₁, ih₂; exact ⟨n₁ * n₂, fun j ↦ by
      rw [Subgroup.coe_mul, ConjAct.toConjAct_mul, mul_smul, hn₂, hn₁, ← Equiv.Perm.mul_apply,
        ← map_mul]; rfl⟩

private theorem exists_weylGroup_conj_U (D : RootDatum P G) (n : D.weylNormalizer) :
    ∃ w : P.weylGroup, ∀ j, ConjAct.toConjAct (n : G) • D.U j = D.U (P.weylGroupToPerm w j) := by
  induction n using D.weylNormalizer_induction with
  | torus _ ht => exact ⟨1, fun _ ↦ by simp [D.conj_smul_U_of_mem_T ht]⟩
  | reflection i m hm =>
    exact ⟨RootPairing.weylGroup.ofIdx P i, fun j ↦ by rw [D.reflection_conjugates i m hm j]; rfl⟩
  | one => exact ⟨1, fun _ ↦ by simp⟩
  | mul _ _ ih₁ ih₂ => obtain ⟨⟨w₁, hw₁⟩, ⟨w₂, hw₂⟩⟩ := ih₁, ih₂; exact ⟨w₁ * w₂, fun j ↦ by
      rw [Subgroup.coe_mul, ConjAct.toConjAct_mul, mul_smul, hw₂, hw₁, ← Equiv.Perm.mul_apply,
        ← map_mul]⟩
  | inv _ ih => exact ⟨ih.choose⁻¹, fun j ↦ by rw [Subgroup.coe_inv, ConjAct.toConjAct_inv,
      inv_smul_eq_iff, ih.choose_spec, map_inv, Equiv.Perm.inv_def, Equiv.apply_symm_apply]⟩

section Crystallographic
variable [IsStrictOrderedRing R] [Finite ι] [P.IsCrystallographic] (D : RootDatum P G)
private theorem withPositiveVector_bruhat_separation {x : N} (hx : ∀ i : ι, P.root' i x ≠ 0)
    (t : G) (ht : t ∈ D.T) (u : G) (hu : u ∈ ⨆ (i) (_ : 0 < P.root' i x), D.U i)
    (htu : t * u ∈ ⨆ (i) (_ : P.root' i x < 0), D.U i) : t * u = 1 := by
  obtain ⟨w, hw⟩ := P.exists_weylGroup_root'_pos_iff hx D.positiveVector_regular
  obtain ⟨n, hn⟩ := D.exists_mem_weylNormalizer_conj_U w
  have hconj {p q : ι → Prop} (hpq : ∀ i, p i → q (P.weylGroupToPerm w i)) {g : G}
      (hg : g ∈ ⨆ (i) (_ : p i), D.U i) : (n : G) * g * (n : G)⁻¹ ∈ ⨆ (i) (_ : q i), D.U i := by
    have h : g ∈ (ConjAct.toConjAct (n : G))⁻¹ • ⨆ (i) (_ : q i), D.U i :=
      (iSup₂_le fun i hi ↦ Subgroup.pointwise_smul_subset_iff.mp <|
        le_iSup₂_of_le (P.weylGroupToPerm w i) (hpq i hi) (hn i).le) hg
    rwa [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, inv_inv, ConjAct.toConjAct_smul] at h
  have ht' := (Subgroup.mem_normalizer_iff.mp (D.weylNormalizer_le_normalizer n.property) t).mp ht
  have hu' : (n : G) * u * (n : G)⁻¹ ∈ D.positiveSubgroup :=
    D.positiveSubgroup_def ▸ hconj (fun i ↦ (hw i).mp) hu
  have htu' : ((n : G) * t * (n : G)⁻¹) * ((n : G) * u * (n : G)⁻¹) ∈ D.negativeSubgroup := by
    rw [negativeSubgroup_def, (by group : ((n : G) * t * (n : G)⁻¹) * ((n : G) * u * (n : G)⁻¹) =
      (n : G) * (t * u) * (n : G)⁻¹)]
    exact hconj (fun i hi ↦ (D.positiveVector_regular _).lt_or_gt.resolve_right
      fun h1 ↦ hi.not_gt ((hw i).mpr h1)) htu
  have h1 := D.eq_one_of_mul_mem_negativeSubgroup ht' hu' htu'
  calc t * u = (n : G)⁻¹ * (((n : G) * t * (n : G)⁻¹) * ((n : G) * u * (n : G)⁻¹)) * n := by group
    _ = 1 := by rw [h1, mul_one, inv_mul_cancel]
/-- Replacing `D.positiveVector` by any regular coweight `x` yields a valid Bruhat–Tits root datum
with the same `T`, `U`, and `M` (Bruhat–Tits I, 6.1.11 (i)). -/
def withPositiveVector (x : N) (hx : ∀ i : ι, P.root' i x ≠ 0) : RootDatum P G :=
  { D with positiveVector := x, positiveVector_regular := hx,
           bruhat_separation := by exact D.withPositiveVector_bruhat_separation hx }
/-- `D.withPositiveVector x hx` has torus subgroup `D.T`. -/
@[simp] theorem withPositiveVector_T (x : N) (hx : ∀ i : ι, P.root' i x ≠ 0) :
    (D.withPositiveVector x hx).T = D.T := (rfl)
/-- `D.withPositiveVector x hx` has root subgroups `D.U`. -/
@[simp] theorem withPositiveVector_U (x : N) (hx : ∀ i : ι, P.root' i x ≠ 0) :
    (D.withPositiveVector x hx).U = D.U := (rfl)
/-- `D.withPositiveVector x hx` has reflection cosets `D.reflectionCoset`. -/
@[simp] theorem withPositiveVector_reflectionCoset (x : N) (hx : ∀ i : ι, P.root' i x ≠ 0) :
    (D.withPositiveVector x hx).reflectionCoset = D.reflectionCoset := (rfl)
/-- `D.withPositiveVector x hx` has positive coweight `x`. -/
@[simp] theorem withPositiveVector_positiveVector (x : N) (hx : ∀ i : ι, P.root' i x ≠ 0) :
    (D.withPositiveVector x hx).positiveVector = x := (rfl)
/-- `T` and `U⁺` intersect trivially. -/
@[simp] theorem T_inf_positiveSubgroup : D.T ⊓ D.positiveSubgroup = ⊥ := by
  let D' := D.withPositiveVector (-D.positiveVector) fun i ↦ by simp [D.positiveVector_regular i]
  refine eq_bot_iff.mpr fun t ⟨ht, hu⟩ ↦ ?_
  have hle : D.positiveSubgroup ≤ D'.negativeSubgroup :=
    D.positiveSubgroup_le_iff.mpr fun i hi ↦ D'.U_le_negativeSubgroup (by simpa [D'] using hi)
  simpa using D'.eq_one_of_mul_mem_negativeSubgroup ht D'.positiveSubgroup.one_mem
    (by simpa using hle hu)
private noncomputable abbrev base₀ := P.indivisibleBaseOf D.positiveVector D.positiveVector_regular
private theorem weylGroup_eq_one_of_forall_pos {w : P.weylGroup}
    (hw : ∀ a : {i : ι // P.IsIndivisible i}, 0 < P.root' a.val D.positiveVector →
      0 < P.root' (P.weylGroupToPerm w a.val) D.positiveVector) : w = 1 := by
  let w₀ := P.indivisibleWeylGroupEquiv.symm w
  have hw₀w : P.indivisibleWeylGroupEquiv w₀ = w := P.indivisibleWeylGroupEquiv.apply_symm_apply w
  have hmaps : Set.MapsTo (P.indivisiblePairing.weylGroupToPerm w₀)
      (TauCeti.posRoots P.indivisiblePairing D.base₀)
      (TauCeti.posRoots P.indivisiblePairing D.base₀) := fun a ha ↦ by
    rw [TauCeti.mem_posRoots, P.indivisibleBaseOf_isPos_iff] at ha ⊢
    rw [P.coe_weylGroupToPerm_indivisibleWeylGroupEquiv, hw₀w]; exact hw a ha
  rw [← hw₀w, TauCeti.eq_one_of_mapsTo_posRoots hmaps, map_one]
private theorem weylGroup_unique_of_conj_U {w₁ w₂ : P.weylGroup}
    (h : ∀ j : ι, D.U (P.weylGroupToPerm w₁ j) = D.U (P.weylGroupToPerm w₂ j)) : w₁ = w₂ := by
  refine mul_inv_eq_one.mp <| D.weylGroup_eq_one_of_forall_pos fun a ha ↦ by_contra fun hnp ↦ ?_
  have hw : D.U (P.weylGroupToPerm (w₁ * w₂⁻¹) a.val) = D.U a.val := by
    rw [map_mul, map_inv, Equiv.Perm.mul_apply, h, Equiv.Perm.inv_def, Equiv.apply_symm_apply]
  exact D.U_ne_bot a.val <| le_bot_iff.mp <| D.positiveSubgroup_inf_negativeSubgroup ▸
    le_inf (D.U_le_positiveSubgroup ha)
      (hw ▸ D.U_le_negativeSubgroup (lt_of_le_of_ne (not_lt.mp hnp) (D.positiveVector_regular _)))
/-- The homomorphism `N →* P.weylGroup` characterized by `n (U a) n⁻¹ = U (w a)`. -/
noncomputable def weylGroupHom : D.weylNormalizer →* P.weylGroup where
  toFun n := (D.exists_weylGroup_conj_U n).choose
  map_one' := D.weylGroup_unique_of_conj_U fun j ↦ by
    rw [← (D.exists_weylGroup_conj_U 1).choose_spec j]; simp
  map_mul' n₁ n₂ := D.weylGroup_unique_of_conj_U fun j ↦ by
    rw [← (D.exists_weylGroup_conj_U (n₁ * n₂)).choose_spec j, Subgroup.coe_mul,
      ConjAct.toConjAct_mul, mul_smul, (D.exists_weylGroup_conj_U n₂).choose_spec j,
      (D.exists_weylGroup_conj_U n₁).choose_spec _, map_mul, Equiv.Perm.mul_apply]
/-- Conjugation by `n ∈ D.weylNormalizer` maps `U i` onto `U (D.weylGroupHom n • i)`. -/
theorem weylGroupHom_conj (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.U i = D.U (P.weylGroupToPerm (D.weylGroupHom n) i) :=
  (D.exists_weylGroup_conj_U n).choose_spec i
/-- Conjugating `u ∈ D.U i` by `n⁻¹` for `n ∈ D.weylNormalizer` (`n⁻¹ u n`) lands in
`D.U (w⁻¹ i)`, where `w = D.weylGroupHom n`. -/
theorem inv_mul_mul_mem_U_weylNormalizer (n : D.weylNormalizer) {i : ι} {u : G} (hu : u ∈ D.U i) :
    (n : G)⁻¹ * u * n ∈ D.U (P.weylGroupToPerm (D.weylGroupHom n)⁻¹ i) := by
  rw [← Subgroup.mem_conjAct_smul_iff, D.weylGroupHom_conj, ← Equiv.Perm.mul_apply, ← map_mul,
    mul_inv_cancel, map_one, Equiv.Perm.one_apply]
  exact hu
variable {D} in
/-- `D.weylGroupHom n` is uniquely determined by how `n` permutes the root subgroups `D.U i`. -/
theorem eq_weylGroupHom {n : D.weylNormalizer} {w : P.weylGroup}
    (h : ∀ i : ι, ConjAct.toConjAct (n : G) • D.U i = D.U (P.weylGroupToPerm w i)) :
    w = D.weylGroupHom n :=
  D.weylGroup_unique_of_conj_U fun i ↦ (h i).symm.trans (D.weylGroupHom_conj n i)
/-- Elements of `T` map to `1` under `D.weylGroupHom`. -/
@[simp] theorem weylGroupHom_torus {t : G} (ht : t ∈ D.T) :
    D.weylGroupHom ⟨t, D.T_le_weylNormalizer ht⟩ = 1 :=
  (D.eq_weylGroupHom fun _ ↦ by simp [D.conj_smul_U_of_mem_T ht]).symm
/-- Every element of `D.reflectionCoset i` maps under `D.weylGroupHom` to the reflection in `i`. -/
-- Not `@[simp]`: `{i : ι}` appears on the LHS only in the proof field of `⟨m, _⟩` (`simpNF`).
theorem weylGroupHom_reflection {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.weylGroupHom ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩ =
      RootPairing.weylGroup.ofIdx P i :=
  (D.eq_weylGroupHom fun j ↦ by rw [D.reflection_conjugates i m hm j]; rfl).symm
/-- `D.weylGroupHom : D.weylNormalizer →* P.weylGroup` is surjective. -/
theorem weylGroupHom_surjective : Function.Surjective D.weylGroupHom := fun w ↦
  let ⟨n, hn⟩ := D.exists_mem_weylNormalizer_conj_U w; ⟨n, (D.eq_weylGroupHom hn).symm⟩

private abbrev PosIndivisible : Type _ :=
  {a : {i : ι // P.IsIndivisible i} // 0 < P.root' a.val D.positiveVector}
private noncomputable abbrev PosIdx : Type := Fin (Nat.card D.PosIndivisible)
private abbrev posRootIdx (a : D.PosIndivisible) : ι := a.val.val

private theorem linearIndependent_posIndivisible {a b : D.PosIndivisible} (hab : a ≠ b) :
    LinearIndependent R ![P.root (D.posRootIdx a), P.root (D.posRootIdx b)] := by
  by_contra hdep
  rcases RootPairing.IsReduced.eq_or_eq_neg (P := P.indivisiblePairing) a.val b.val
      (by simpa using hdep) with h | h
  · exact hab (Subtype.ext (P.indivisiblePairing.root.injective h))
  · have : P.root' (D.posRootIdx a) D.positiveVector =
        -P.root' (D.posRootIdx b) D.positiveVector := by
      simpa [RootPairing.root'] using congrArg (P.toLinearMap · D.positiveVector) h
    linarith [a.property, b.property]
private theorem exists_posIndivisible_of_root'_pos {i : ι} (hi : 0 < P.root' i D.positiveVector) :
    ∃ a : D.PosIndivisible, i = D.posRootIdx a ∨ P.root i = (2 : R) • P.root (D.posRootIdx a) := by
  rcases P.isIndivisible_or_exists_root_eq_two_smul i with hind | ⟨j, hj, hij⟩
  · exact ⟨⟨⟨i, hind⟩, hi⟩, .inl rfl⟩
  · have : P.root' i D.positiveVector = 2 * P.root' j D.positiveVector := by
      simp [RootPairing.root', hij]
    exact ⟨⟨⟨j, hj⟩, by linarith⟩, .inr hij⟩
private theorem root'_sub_smul_ne_zero {w₀ : N} {C : R}
    (hC : ∀ a : D.PosIndivisible,
      P.root' (D.posRootIdx a) w₀ / P.root' (D.posRootIdx a) D.positiveVector ≠ C)
    (i : ι) : P.root' i (w₀ - C • D.positiveVector) ≠ 0 := by
  have hkey (a : D.PosIndivisible) :
      P.root' (D.posRootIdx a) (w₀ - C • D.positiveVector) ≠ 0 := fun h0 ↦
    hC a ((div_eq_iff a.property.ne').mpr (by simpa [map_sub, map_smul, sub_eq_zero] using h0))
  have hpos {j : ι} (hj : 0 < P.root' j D.positiveVector) :
      P.root' j (w₀ - C • D.positiveVector) ≠ 0 :=
    let ⟨a, ha⟩ := D.exists_posIndivisible_of_root'_pos hj
    ha.elim (fun h ↦ h ▸ hkey a) fun hj2 ↦ by
      simpa [RootPairing.root', hj2, two_ne_zero] using hkey a
  rcases (D.positiveVector_regular i).lt_or_gt with hn | hp
  · have h1 := hpos (j := P.reflectionPerm i i) (by simpa using neg_pos.mpr hn)
    rwa [P.root'_reflectionPerm_self, LinearMap.neg_apply, neg_ne_zero] at h1
  · exact hpos hp
private theorem exists_orderEquiv_posIndivisible :
    ∃ (w₀ : N) (e : D.PosIdx ≃ D.PosIndivisible),
      StrictMono (fun k ↦
        P.root' (D.posRootIdx (e k)) w₀ / P.root' (D.posRootIdx (e k)) D.positiveVector) := by
  classical
  let v := D.positiveVector
  let vec : {p : D.PosIndivisible × D.PosIndivisible // p.1 ≠ p.2} → M := fun p ↦
    P.root' (D.posRootIdx p.val.2) v • P.root (D.posRootIdx p.val.1) -
      P.root' (D.posRootIdx p.val.1) v • P.root (D.posRootIdx p.val.2)
  have hvec (p) : vec p ≠ 0 := fun h0 ↦ p.val.2.property.ne' <|
    (LinearIndependent.pair_iff.mp (D.linearIndependent_posIndivisible p.property)
      (P.root' (D.posRootIdx p.val.2) v) (-P.root' (D.posRootIdx p.val.1) v)
      (by simpa [vec, neg_smul, sub_eq_add_neg] using h0)).1
  have : Infinite R := Infinite.of_injective (Nat.cast : ℕ → R) Nat.cast_injective
  obtain ⟨f, hf⟩ := Module.exists_dual_forall_apply_ne_zero (K := R) vec hvec
  let w₀ := P.flip.toPerfPair.symm f
  let q (a : D.PosIndivisible) : R := P.root' (D.posRootIdx a) w₀ / P.root' (D.posRootIdx a) v
  have hq : Function.Injective q := fun a b hab_eq ↦ by_contra fun hab ↦ hf ⟨(a, b), hab⟩ <| by
    have hcross := (div_eq_div_iff a.property.ne' b.property.ne').mp hab_eq
    have hfw : f (vec ⟨(a, b), hab⟩) = P.toLinearMap (vec ⟨(a, b), hab⟩) w₀ := by simp [w₀]
    rw [hfw]; simp only [vec, map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply,
      smul_eq_mul, RootPairing.root'] at hcross ⊢; linarith
  have : Fintype D.PosIndivisible := Fintype.ofFinite _; let s : Finset R := Finset.univ.image q
  have hcard : s.card = Nat.card D.PosIndivisible := by
    rw [Finset.card_image_of_injective _ hq, Finset.card_univ, Fintype.card_eq_nat_card]
  let emb : D.PosIdx ↪o R := s.orderEmbOfFin hcard
  have hmem (k) : ∃ a, q a = emb k :=
    let ⟨a, _, ha⟩ := Finset.mem_image.mp (Finset.orderEmbOfFin_mem s hcard k); ⟨a, ha⟩
  let e : D.PosIdx ≃ D.PosIndivisible := Equiv.ofBijective (fun k ↦ (hmem k).choose)
    ((Fintype.bijective_iff_injective_and_card _).mpr ⟨fun k₁ k₂ hk ↦ emb.injective
      ((hmem k₁).choose_spec.symm.trans ((congrArg q hk).trans (hmem k₂).choose_spec)),
      (Fintype.card_fin _).trans Fintype.card_eq_nat_card.symm⟩)
  have he (k) :
      P.root' (D.posRootIdx (e k)) w₀ / P.root' (D.posRootIdx (e k)) D.positiveVector = emb k := by
    simpa [e, q] using (hmem k).choose_spec
  exact ⟨w₀, e, fun k₁ k₂ hk ↦ by dsimp only; rw [he k₁, he k₂]; exact emb.strictMono hk⟩
private def rayFiltration (e : D.PosIdx ≃ D.PosIndivisible) (L : ι → Subgroup G) (k : ℕ) :
    Subgroup G := ⨆ (r : D.PosIdx) (_ : k ≤ r.val), L (D.posRootIdx (e r))
private theorem exists_cut_datum {w₀ : N} {e : D.PosIdx ≃ D.PosIndivisible}
    (hmono : StrictMono (fun r : D.PosIdx ↦
      P.root' (D.posRootIdx (e r)) w₀ / P.root' (D.posRootIdx (e r)) D.positiveVector))
    (k : D.PosIdx) :
    ∃ DC : RootDatum P G, DC.U = D.U ∧ P.root' (D.posRootIdx (e k)) DC.positiveVector < 0 ∧
      D.rayFiltration e D.U (k.val + 1) ≤ DC.positiveSubgroup := by
  let ratio (r : D.PosIdx) : R :=
    P.root' (D.posRootIdx (e r)) w₀ / P.root' (D.posRootIdx (e r)) D.positiveVector
  have hcut : ∃ C : R, (∀ r, ratio r ≠ C) ∧ ratio k < C ∧
      ∀ r : D.PosIdx, k.val + 1 ≤ r.val → C < ratio r := by
    by_cases hk1 : k.val + 1 < Nat.card D.PosIndivisible
    · let k' : D.PosIdx := ⟨k.val + 1, hk1⟩
      have hlt : ratio k < ratio k' := hmono (Nat.lt_succ_self k.val)
      exact ⟨(ratio k + ratio k') / 2, fun r ↦ (lt_or_ge r.val (k.val + 1)).elim
        (fun hr ↦ by linarith [hmono.monotone (Nat.lt_succ_iff.mp hr)])
        (fun hr ↦ by linarith [hmono.monotone (Fin.le_iff_val_le_val.mpr hr : k' ≤ r)]),
        by linarith,
        fun r hr ↦ by linarith [hmono.monotone (Fin.le_iff_val_le_val.mpr hr : k' ≤ r)]⟩
    · exact ⟨ratio k + 1, fun r ↦ by
        linarith [hmono.monotone
          (Nat.le_of_lt_succ (lt_of_lt_of_le r.isLt (not_lt.mp hk1)) : r ≤ k)],
        by linarith, fun r hr ↦ absurd (hr.trans_lt r.isLt) hk1⟩
  obtain ⟨C, hC, hkC, hrC⟩ := hcut
  let DC := D.withPositiveVector (w₀ - C • D.positiveVector)
    (D.root'_sub_smul_ne_zero fun a ↦ let ⟨r, hr⟩ := e.surjective a; hr ▸ hC r)
  exact ⟨DC, rfl,
    by simpa [DC, map_sub, map_smul] using sub_neg.mpr ((div_lt_iff₀ (e k).property).mp hkC),
    iSup₂_le fun r hr ↦ DC.U_le_positiveSubgroup
      (by simpa [DC, map_sub, map_smul] using
        sub_pos.mpr ((lt_div_iff₀ (e r).property).mp (hrC r hr)))⟩
private theorem rayFiltration_props {w₀ : N} {e : D.PosIdx ≃ D.PosIndivisible}
    (hmono : StrictMono (fun r : D.PosIdx ↦
      P.root' (D.posRootIdx (e r)) w₀ / P.root' (D.posRootIdx (e r)) D.positiveVector))
    (L : ι → Subgroup G)
    (hL2 : ∀ i j, 0 < P.root' i D.positiveVector → P.root j = (2 : R) • P.root i → L j ≤ L i)
    (hcomm : ∀ k r : D.PosIdx, k < r → ⁅L (D.posRootIdx (e k)), L (D.posRootIdx (e r))⁆ ≤
      ⨆ (m) (_ : ∃ p q : ℕ, 0 < p ∧ 0 < q ∧
        P.root m = p • P.root (D.posRootIdx (e k)) + q • P.root (D.posRootIdx (e r))), L m) :
    (⨆ (i) (_ : 0 < P.root' i D.positiveVector), L i) = D.rayFiltration e L 0 ∧
      ∀ k : D.PosIdx, (D.rayFiltration e L k.val : Set G) =
        (L (D.posRootIdx (e k)) : Set G) * (D.rayFiltration e L (k.val + 1) : Set G) := by
  let v := D.positiveVector
  refine ⟨le_antisymm (iSup₂_le fun i hi ↦ ?_)
    (iSup₂_le fun r _ ↦ le_iSup₂_of_le (D.posRootIdx (e r)) (e r).property le_rfl), fun k ↦ ?_⟩
  · obtain ⟨a, hi_a⟩ := D.exists_posIndivisible_of_root'_pos hi; obtain ⟨r, rfl⟩ := e.surjective a
    exact (hi_a.elim (fun h ↦ h ▸ le_rfl) (hL2 (D.posRootIdx (e r)) i (e r).property)).trans
      (le_iSup₂_of_le r (Nat.zero_le _) le_rfl)
  · have hnorm : L (D.posRootIdx (e k)) ≤
        Subgroup.normalizer (D.rayFiltration e L (k.val + 1) : Set G) := by
      refine Subgroup.le_normalizer_biSup_of_commutator_le _ _ fun r hr ↦
        (hcomm k r hr).trans (iSup₂_le fun m ⟨p, q, _hp, hq', hroot⟩ ↦ ?_)
      have hlin (y : N) : P.root' m y = (p : R) * P.root' (D.posRootIdx (e k)) y +
          (q : R) * P.root' (D.posRootIdx (e r)) y := by
        simp [RootPairing.root', hroot, nsmul_eq_mul]
      have hmv : 0 < P.root' m v := by
        have := (e k).property; have := (e r).property; rw [hlin v]; positivity
      obtain ⟨c, hc⟩ := D.exists_posIndivisible_of_root'_pos hmv; obtain ⟨s, rfl⟩ := e.surjective c
      have hmc : P.root' m w₀ / P.root' m v =
          P.root' (D.posRootIdx (e s)) w₀ / P.root' (D.posRootIdx (e s)) v :=
        hc.elim (fun h ↦ h ▸ rfl) fun hc2 ↦ by
          simp only [RootPairing.root', hc2, map_smul, LinearMap.smul_apply, smul_eq_mul]
          exact mul_div_mul_left _ _ two_ne_zero
      have hlt := mul_lt_mul_of_pos_left
        ((div_lt_div_iff₀ (e k).property (e r).property).mp (hmono hr))
        (Nat.cast_pos.mpr hq' : (0 : R) < q)
      have hks : k < s := hmono.lt_iff_lt.mp <| hmc ▸ (div_lt_div_iff₀ (e k).property hmv).mpr
        (by rw [hlin w₀, hlin v]; nlinarith)
      exact (hc.elim (fun h ↦ h ▸ le_rfl) (hL2 (D.posRootIdx (e s)) m (e s).property)).trans
        (le_iSup₂_of_le s hks le_rfl)
    have hsplit :
        D.rayFiltration e L k.val = L (D.posRootIdx (e k)) ⊔ D.rayFiltration e L (k.val + 1) :=
      le_antisymm (iSup₂_le fun r hr ↦ (eq_or_lt_of_le hr).elim
        (fun heq ↦ Fin.ext heq.symm ▸ le_sup_left)
        fun hlt ↦ le_sup_right.trans' (le_iSup₂_of_le r hlt le_rfl))
        (sup_le (le_iSup₂_of_le k le_rfl le_rfl) (iSup₂_le fun r hr ↦
          le_iSup₂_of_le r (Nat.le_of_succ_le hr) le_rfl))
    exact hsplit ▸ Subgroup.coe_mul_of_left_le_normalizer_right _ _ hnorm
/-- **Ray-projection intersection formula**: for any regular coweight `z` and any family of
subgroups `L i ≤ D.U i` on the `z`-positive roots satisfying `L (2 a) ≤ L a` and the positive-cone
commutator bound `[L a, L b] ≤ ⨆_{p, q ≥ 1} L (p a + q b)`, the intersection of
`⨆_{⟨a, z⟩ > 0} L a` with the root subgroup `D.U i₀` of an indivisible `z`-positive root `i₀`
recovers `L i₀` (Bruhat–Tits I, 6.1.6–6.1.7). -/
theorem iSup_inf_U_eq_of_commutator_le {z : N} (hz : ∀ i : ι, P.root' i z ≠ 0)
    (L : ι → Subgroup G) (hLU : ∀ i, 0 < P.root' i z → L i ≤ D.U i)
    (hL2 : ∀ i j, 0 < P.root' i z → P.root j = (2 : R) • P.root i → L j ≤ L i)
    (hcomm : ∀ i j, 0 < P.root' i z → 0 < P.root' j z → ⁅L i, L j⁆ ≤
      ⨆ (k) (_ : ∃ p q : ℕ, 0 < p ∧ 0 < q ∧ P.root k = p • P.root i + q • P.root j), L k)
    {i₀ : ι} (hi₀_ind : P.IsIndivisible i₀) (hi₀_pos : 0 < P.root' i₀ z) :
    (⨆ (i) (_ : 0 < P.root' i z), L i) ⊓ D.U i₀ = L i₀ := by
  let D' := D.withPositiveVector z hz
  refine le_antisymm ?_ (le_inf (le_iSup₂_of_le i₀ hi₀_pos le_rfl) (hLU i₀ hi₀_pos))
  have hz' : z = D'.positiveVector := rfl; have hU' : D.U i₀ = D'.U i₀ := rfl; rw [hz', hU']
  obtain ⟨w₀, e, hmono⟩ := D'.exists_orderEquiv_posIndivisible
  have hbot (k : D'.PosIdx) : D'.U (D'.posRootIdx (e k)) ⊓ D'.rayFiltration e D'.U (k.val + 1) =
      ⊥ := by
    obtain ⟨DC, hDCU, hk_neg, hrem⟩ := D'.exists_cut_datum hmono k
    exact eq_bot_iff.mpr ((inf_le_inf (hDCU ▸ DC.U_le_negativeSubgroup hk_neg) hrem).trans
      (by rw [inf_comm, DC.positiveSubgroup_inf_negativeSubgroup]))
  have hL_le_U (k) : D'.rayFiltration e L k ≤ D'.rayFiltration e D'.U k :=
    iSup₂_mono fun r _ ↦ hLU (D'.posRootIdx (e r)) (e r).property
  obtain ⟨hiSup_eq, hmul⟩ := D'.rayFiltration_props hmono L hL2
    fun k r _ ↦ hcomm (D'.posRootIdx (e k)) (D'.posRootIdx (e r)) (e k).property (e r).property
  obtain ⟨k₀, hk₀⟩ := e.surjective ⟨⟨i₀, hi₀_ind⟩, hi₀_pos⟩
  have hi₀_eq : D'.posRootIdx (e k₀) = i₀ := congrArg D'.posRootIdx hk₀
  rw [hiSup_eq, ← hi₀_eq]; intro g ⟨hgL, hgU⟩
  have hstep (m : ℕ) : m ≤ k₀.val → g ∈ D'.rayFiltration e L m := by
    induction m with
    | zero => exact fun _ ↦ hgL
    | succ m ih =>
      intro hm; let km : D'.PosIdx := ⟨m, lt_of_lt_of_le (Nat.lt_of_succ_le hm) k₀.isLt.le⟩
      obtain ⟨x, hx, y, hy, rfl⟩ := hmul km ▸ SetLike.mem_coe.mpr (ih (Nat.le_of_succ_le hm))
      have hx_mem : x ∈ D'.U (D'.posRootIdx (e km)) ⊓ D'.rayFiltration e D'.U (km.val + 1) :=
        ⟨hLU _ (e km).property hx, (by group : x = (x * y) * y⁻¹) ▸
          mul_mem (Subgroup.mem_iSup_of_mem k₀ (Subgroup.mem_iSup_of_mem hm hgU))
            ((D'.rayFiltration e D'.U _).inv_mem (hL_le_U _ hy))⟩
      rw [hbot km, Subgroup.mem_bot] at hx_mem; simpa [hx_mem] using hy
  obtain ⟨x, hx, y, hy, rfl⟩ := hmul k₀ ▸ SetLike.mem_coe.mpr (hstep k₀.val le_rfl)
  have hy_mem : y ∈ D'.U (D'.posRootIdx (e k₀)) ⊓ D'.rayFiltration e D'.U (k₀.val + 1) :=
    ⟨(by group : y = x⁻¹ * (x * y)) ▸ mul_mem ((D'.U _).inv_mem (hLU _ (e k₀).property hx)) hgU,
      hL_le_U _ hy⟩
  rw [hbot k₀, Subgroup.mem_bot] at hy_mem; simpa [hy_mem] using hx
omit [Finite ι] [P.IsCrystallographic] in
private theorem eq_one_of_mem_U_of_conj_mem_borelSubgroup {i : ι}
    (hi : 0 < P.root' i D.positiveVector) {m u : G} (hm : m ∈ D.reflectionCoset i)
    (hu : u ∈ D.U i) (hB : m * u * m⁻¹ ∈ D.borelSubgroup) : u = 1 := by
  obtain ⟨t, ht, v, hv, htv⟩ := D.coe_borelSubgroup ▸ SetLike.mem_coe.mpr hB; dsimp only at htv
  have hneg : m * u * m⁻¹ ∈ D.negativeSubgroup := D.U_le_negativeSubgroup
    (by simpa using neg_lt_zero.mpr hi) (D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset hm hu)
  have h1 := htv.symm.trans (D.eq_one_of_mul_mem_negativeSubgroup ht hv (htv ▸ hneg))
  exact (by group : u = m⁻¹ * (m * u * m⁻¹) * m).trans (by rw [h1]; group)
/-- Any element of `U⁺` that normalizes every root subgroup `D.U j` is trivial. -/
theorem eq_one_of_mem_positiveSubgroup_of_forall_conj_U {u : G}
    (hu : u ∈ D.positiveSubgroup) (hn : ∀ j : ι, ConjAct.toConjAct u • D.U j = D.U j) : u = 1 := by
  obtain ⟨w₀, e, hmono⟩ := D.exists_orderEquiv_posIndivisible; let n := Nat.card D.PosIndivisible
  obtain ⟨hpos_eq, hmul⟩ := D.rayFiltration_props hmono D.U
    (fun i j _ ↦ D.le_of_root_eq_two_smul i j) fun k r _ ↦ D.commutator_le _ _ fun c _ hneg ↦ by
      have : P.root' (D.posRootIdx (e r)) D.positiveVector =
          -c * P.root' (D.posRootIdx (e k)) D.positiveVector := by
        simp [RootPairing.root', hneg]
      nlinarith [(e k).property, (e r).property]
  have hstep (m : ℕ) : m ≤ n → u ∈ D.rayFiltration e D.U m := by
    induction m with
    | zero => rw [← positiveSubgroup_def] at hpos_eq; exact fun _ ↦ hpos_eq ▸ hu
    | succ m ih =>
      intro hm; let km : D.PosIdx := ⟨m, hm⟩
      obtain ⟨x, hx, y, hy, hxy⟩ := hmul km ▸ SetLike.mem_coe.mpr (ih (Nat.le_of_succ_le hm))
      obtain ⟨DC, hDCU, hk_neg, hrem⟩ := D.exists_cut_datum hmono km
      set ik := P.reflectionPerm (D.posRootIdx (e km)) (D.posRootIdx (e km))
      have hik_pos : 0 < P.root' ik DC.positiveVector := by simpa [ik] using neg_pos.mpr hk_neg
      have hx_norm : x ∈ Subgroup.normalizer (DC.positiveSubgroup : Set G) :=
        (by dsimp only at hxy; rw [← hxy]; group : x = u * y⁻¹) ▸ mul_mem
          (DC.positiveSubgroup_def ▸ hDCU ▸
            Subgroup.mem_normalizer_biSup_of_conjAct_smul_eq fun j _ ↦ hn j)
          (Subgroup.le_normalizer (inv_mem (hrem hy)))
      have hx1 : x = 1 := by_contra fun hne ↦ by
        obtain ⟨_, ⟨a, ha, m₀, hm₀, rfl⟩, b, hb, hab⟩ := DC.bruhat ik
          ⟨by rwa [hDCU, P.reflectionPerm_reflectionPerm_self], hne⟩
        have hm_norm : m₀ ∈ Subgroup.normalizer (DC.positiveSubgroup : Set G) :=
          (by rw [← hab]; group : m₀ = a⁻¹ * x * b⁻¹) ▸ mul_mem
            (mul_mem (Subgroup.le_normalizer (inv_mem (DC.U_le_positiveSubgroup hik_pos ha)))
              hx_norm) (Subgroup.le_normalizer (inv_mem (DC.U_le_positiveSubgroup hik_pos hb)))
        obtain ⟨⟨z, hz⟩, hz_ne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (DC.U_ne_bot ik)
        exact hz_ne <| Subtype.ext <| DC.eq_one_of_mem_U_of_conj_mem_borelSubgroup hik_pos hm₀ hz <|
          DC.positiveSubgroup_le_borelSubgroup
            ((Subgroup.mem_normalizer_iff.mp hm_norm z).mp (DC.U_le_positiveSubgroup hik_pos hz))
      dsimp only at hxy; simpa [← hxy, hx1] using hy
  have hbot : D.rayFiltration e D.U n = ⊥ :=
    eq_bot_iff.mpr (iSup₂_le fun r hr ↦ absurd (hr.trans_lt r.isLt) (lt_irrefl n))
  simpa [hbot] using hstep n le_rfl
/-- **Intersection of `B` and `N`**: the Borel-like subgroup `B = T U⁺` meets the Weyl normalizer
`N` in `T` (`B ∩ N = T`, Bruhat–Tits I, 6.1.11 (ii)). -/
@[simp] theorem borelSubgroup_inf_weylNormalizer : D.borelSubgroup ⊓ D.weylNormalizer = D.T := by
  refine le_antisymm ?_ (le_inf D.T_le_borelSubgroup D.T_le_weylNormalizer)
  intro g ⟨hgB, hgN⟩; obtain ⟨t, ht, u, hu, rfl⟩ := D.coe_borelSubgroup ▸ SetLike.mem_coe.mpr hgB
  let nu : D.weylNormalizer := ⟨u, (by group : u = t⁻¹ * (t * u)) ▸
    mul_mem (D.T_le_weylNormalizer (inv_mem ht)) hgN⟩
  have hw1 : D.weylGroupHom nu = 1 := D.weylGroup_eq_one_of_forall_pos fun a ha ↦ by_contra
    fun hnp ↦ D.U_ne_bot (P.weylGroupToPerm (D.weylGroupHom nu) a.val) <| le_bot_iff.mp <|
      D.positiveSubgroup_inf_negativeSubgroup ▸ le_inf (by
        rw [← D.weylGroupHom_conj nu a.val,
          ← Subgroup.conjAct_pointwise_smul_eq_self (Subgroup.le_normalizer hu)]
        exact Subgroup.pointwise_smul_le_pointwise_smul_iff.mpr (D.U_le_positiveSubgroup ha))
        (D.U_le_negativeSubgroup (lt_of_le_of_ne (not_lt.mp hnp) (D.positiveVector_regular _)))
  have hu1 : u = 1 := D.eq_one_of_mem_positiveSubgroup_of_forall_conj_U hu fun j ↦ by
    simpa [hw1] using D.weylGroupHom_conj nu j
  simpa [hu1] using ht
/-- Pulling `D.borelSubgroup` back to `D.weylNormalizer` gives `D.T.subgroupOf D.weylNormalizer`. -/
theorem subgroupOf_borelSubgroup_weylNormalizer :
    D.borelSubgroup.subgroupOf D.weylNormalizer = D.T.subgroupOf D.weylNormalizer := by
  ext n; exact ⟨fun hB ↦ D.borelSubgroup_inf_weylNormalizer ▸ ⟨hB, n.property⟩,
    fun hT ↦ D.T_le_borelSubgroup hT⟩
private abbrev posComplement (a : {i : ι // P.IsIndivisible i}) : Subgroup G :=
  ⨆ (c : D.PosIndivisible) (_ : c.val ≠ a), D.U (D.posRootIdx c)
private abbrev bCoset (g : G) : Set G := DoubleCoset.doubleCoset g D.borelSubgroup D.borelSubgroup
private theorem U_le_normalizer_posComplement {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.base₀.support) : D.U a.val ≤ Subgroup.normalizer (D.posComplement a : Set G) := by
  let aPos : D.PosIndivisible := ⟨a, P.root'_pos_of_mem_indivisibleBaseOf ha⟩
  refine Subgroup.le_normalizer_biSup_of_commutator_le _ _ fun c hc ↦
    (D.commutator_le a.val (D.posRootIdx c) fun t _ hneg ↦ ?_).trans
      (iSup₂_le fun k ⟨p, q, _hp, hq, hroot⟩ ↦ ?_)
  · have : P.root' (D.posRootIdx c) D.positiveVector = -t * P.root' a.val D.positiveVector := by
      simp [RootPairing.root', hneg]
    nlinarith [aPos.property, c.property]
  have hk_pos : 0 < P.root' k D.positiveVector := by
    have hkv : P.root' k D.positiveVector = (p : R) * P.root' a.val D.positiveVector +
        (q : R) * P.root' (D.posRootIdx c) D.positiveVector := by
      simp [RootPairing.root', hroot, nsmul_eq_mul]
    rw [hkv]; have := aPos.property; have := c.property; positivity
  obtain ⟨d, hd⟩ := D.exists_posIndivisible_of_root'_pos hk_pos
  have hd_ne : d.val ≠ a := fun hda ↦ by
    have hda' : D.posRootIdx d = a.val := congrArg Subtype.val hda
    obtain ⟨r, hr⟩ : ∃ r : R, P.root k = r • P.root a.val :=
      hd.elim (fun hk ↦ ⟨1, by rw [hk, hda', one_smul]⟩) (fun hk2 ↦ ⟨2, by rw [hk2, hda']⟩)
    have hlin : ((p : R) - r) • P.root (D.posRootIdx aPos) +
        (q : R) • P.root (D.posRootIdx c) = 0 := by
      calc ((p : R) - r) • P.root a.val + (q : R) • P.root (D.posRootIdx c)
          = ((p : R) • P.root a.val + (q : R) • P.root (D.posRootIdx c)) - r • P.root a.val := by
            module
        _ = 0 := by rw [Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, ← hroot, ← hr, sub_self]
    exact Nat.cast_ne_zero.mpr hq.ne' (LinearIndependent.pair_iff.mp
      (D.linearIndependent_posIndivisible (mt (congrArg Subtype.val) hc.symm)) _ _ hlin).2
  exact (hd.elim (fun hk ↦ hk ▸ le_rfl) (D.le_of_root_eq_two_smul (D.posRootIdx d) k)).trans
    (le_iSup₂_of_le d hd_ne le_rfl)
private theorem conj_posComplement_eq_self {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.base₀.support) {m : G} (hm : m ∈ D.reflectionCoset a.val) :
    ConjAct.toConjAct m • D.posComplement a = D.posComplement a := by
  let P₀ := P.indivisiblePairing
  have hbij := TauCeti.bijOn_reflectionPerm_posRoots_diff_singleton P₀ D.base₀ ha
  have hm_le {m' : G} (hm' : m' ∈ D.reflectionCoset a.val) :
      ConjAct.toConjAct m' • D.posComplement a ≤ D.posComplement a := by
    rw [posComplement, Subgroup.smul_iSup]
    refine iSup_le fun c ↦ (Subgroup.smul_iSup _ _).trans_le <| iSup_le fun hc ↦ ?_
    have hsc := hbij.mapsTo ⟨(TauCeti.mem_posRoots P₀ D.base₀ c.val).mpr
      ((P.indivisibleBaseOf_isPos_iff D.positiveVector_regular c.val).mpr c.property), hc⟩
    have hpos := (P.indivisibleBaseOf_isPos_iff D.positiveVector_regular _).mp
      ((TauCeti.mem_posRoots P₀ D.base₀ _).mp hsc.1)
    rw [D.reflection_conjugates a.val m' hm' (D.posRootIdx c),
      ← P.coe_indivisiblePairing_reflectionPerm a c.val]
    exact le_iSup₂_of_le ⟨P₀.reflectionPerm a c.val, hpos⟩ hsc.2 le_rfl
  exact le_antisymm (hm_le hm) (Subgroup.subset_pointwise_smul_iff.mpr <|
    ConjAct.toConjAct_inv m ▸ hm_le (by
      simpa [D.reflectionCoset_reflectionPerm_self] using D.inv_mem_reflectionCoset hm))
private theorem exists_mem_of_mem_doubleCoset_mul {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.base₀.support) {m g : G} (hm : m ∈ D.reflectionCoset a.val) (w : D.weylNormalizer)
    (hg : g ∈ D.bCoset m * D.bCoset w) :
    ∃ b₁ ∈ D.borelSubgroup, ∃ u ∈ D.U a.val, ∃ b₂ ∈ D.borelSubgroup,
      g = b₁ * m * u * (w : G) * b₂ := by
  let Uother := D.posComplement a; let Ba := D.T ⊔ Uother
  have hUother_le : Uother ≤ D.positiveSubgroup :=
    iSup₂_le fun c _ ↦ D.U_le_positiveSubgroup c.property
  have hpos_sup : Uother ⊔ D.U a.val = D.positiveSubgroup :=
    le_antisymm
      (sup_le hUother_le (D.U_le_positiveSubgroup (P.root'_pos_of_mem_indivisibleBaseOf ha)))
      (D.positiveSubgroup_le_iff.mpr fun i hi ↦ by
        obtain ⟨d, hd⟩ := D.exists_posIndivisible_of_root'_pos hi
        have hUd := hd.elim (fun hk ↦ hk ▸ le_rfl) (D.le_of_root_eq_two_smul (D.posRootIdx d) i)
        exact (eq_or_ne d.val a).elim (fun hda ↦ hUd.trans (hda ▸ le_sup_right)) fun hda ↦
          hUd.trans (le_sup_left.trans' (le_iSup₂_of_le d hda le_rfl)))
  have hm_Ba : ConjAct.toConjAct m • Ba = Ba := by
    rw [Subgroup.smul_sup,
      Subgroup.conjAct_pointwise_smul_eq_self (D.reflectionCoset_subset_normalizer a.val hm),
      D.conj_posComplement_eq_self ha hm]
  have hB_eq : (D.borelSubgroup : Set G) = (Ba : Set G) * (D.U a.val : Set G) := by
    rw [D.coe_borelSubgroup, ← hpos_sup,
      Subgroup.coe_mul_of_right_le_normalizer_left Uother _ (D.U_le_normalizer_posComplement ha),
      ← mul_assoc, ← Subgroup.coe_mul_of_left_le_normalizer_right D.T Uother
        (fun _ ht ↦ Subgroup.mem_normalizer_biSup_of_conjAct_smul_eq
          fun _ _ ↦ D.conj_smul_U_of_mem_T ht)]
  obtain ⟨x₁, hx₁, x₂, hx₂, rfl⟩ := hg
  obtain ⟨b₁, hb₁, b, hb, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx₁
  obtain ⟨b', hb', b₂, hb₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx₂
  obtain ⟨ba, hba, u, hu, hbau⟩ := hB_eq ▸ SetLike.mem_coe.mpr (mul_mem hb hb'); dsimp only at hbau
  have hBa_le : Ba ≤ D.borelSubgroup :=
    sup_le D.T_le_borelSubgroup (hUother_le.trans D.positiveSubgroup_le_borelSubgroup)
  have hmba : m * ba * m⁻¹ ∈ D.borelSubgroup := hBa_le <| by
    rw [← hm_Ba, ← ConjAct.toConjAct_smul]; exact Subgroup.smul_mem_pointwise_smul _ _ _ hba
  refine ⟨b₁ * (m * ba * m⁻¹), mul_mem hb₁ hmba, u, hu, b₂, hb₂, ?_⟩
  calc (b₁ * m * b) * (b' * (w : G) * b₂) = b₁ * m * (b * b') * (w : G) * b₂ := by group
    _ = (b₁ * (m * ba * m⁻¹)) * m * u * (w : G) * b₂ := by rw [← hbau]; group
private theorem inv_mul_mul_mem_borelSubgroup (w : D.weylNormalizer) {i : ι} {u : G}
    (hu : u ∈ D.U i)
    (hpos : 0 < P.root' (P.weylGroupToPerm (D.weylGroupHom w)⁻¹ i) D.positiveVector) :
    (w : G)⁻¹ * u * (w : G) ∈ D.borelSubgroup := by
  refine D.positiveSubgroup_le_borelSubgroup (D.U_le_positiveSubgroup hpos ?_)
  rw [← map_inv, ← D.weylGroupHom_conj w⁻¹, Subgroup.mem_conjAct_smul_iff]
  simpa [Subgroup.coe_inv, mul_assoc] using hu
private theorem doubleCoset_mul_subset_of_root'_pos {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.base₀.support) {m : G} (hm : m ∈ D.reflectionCoset a.val) (w : D.weylNormalizer)
    (hpos : 0 < P.root' (P.weylGroupToPerm (D.weylGroupHom w)⁻¹ a.val) D.positiveVector) :
    D.bCoset m * D.bCoset w ⊆ D.bCoset (m * w) := fun _ hg ↦ by
  obtain ⟨b₁, hb₁, u, hu, b₂, hb₂, rfl⟩ := D.exists_mem_of_mem_doubleCoset_mul ha hm w hg
  exact DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, ((w : G)⁻¹ * u * (w : G)) * b₂,
    mul_mem (D.inv_mul_mul_mem_borelSubgroup w hu hpos) hb₂, by group⟩
private theorem doubleCoset_mul_subset_union {a : {i : ι // P.IsIndivisible i}}
    (ha : a ∈ D.base₀.support) {m : G} (hm : m ∈ D.reflectionCoset a.val) (w : D.weylNormalizer) :
    D.bCoset m * D.bCoset w ⊆ D.bCoset (m * w) ∪ D.bCoset w := by
  set j := P.weylGroupToPerm (D.weylGroupHom w)⁻¹ a.val
  rcases (D.positiveVector_regular j).lt_or_gt with hneg | hpos
  · intro g hg
    obtain ⟨b₁, hb₁, u, hu, b₂, hb₂, rfl⟩ := D.exists_mem_of_mem_doubleCoset_mul ha hm w hg
    by_cases hu1 : u = 1
    · exact .inl (DoubleCoset.mem_doubleCoset.mpr ⟨b₁, hb₁, b₂, hb₂, by rw [hu1]; group⟩)
    · obtain ⟨_, ⟨x, hx, m', hm', rfl⟩, y, hy, hxy⟩ := D.bruhat
        (P.reflectionPerm a.val a.val) ⟨by rwa [P.reflectionPerm_reflectionPerm_self], hu1⟩
      dsimp only at hxy; rw [D.reflectionCoset_reflectionPerm_self] at hm'
      have hmx := D.positiveSubgroup_le_borelSubgroup
        (D.U_le_positiveSubgroup (P.root'_pos_of_mem_indivisibleBaseOf ha)
          (D.mul_mul_inv_mem_U_of_mem_reflectionCoset hm hx))
      have hmm' := D.T_le_borelSubgroup (D.mul_mem_T_of_mem_reflectionCoset hm hm')
      have hwy := D.inv_mul_mul_mem_borelSubgroup w hy <| by
        have hp : P.weylGroupToPerm (D.weylGroupHom w)⁻¹ (P.reflectionPerm a.val a.val) =
            P.reflectionPerm j j := P.weylGroupToPerm_neg (D.weylGroupHom w)⁻¹ a.val
        rw [hp]; simpa using neg_pos.mpr hneg
      exact .inr <| DoubleCoset.mem_doubleCoset.mpr ⟨b₁ * (m * x * m⁻¹) * (m * m'),
        mul_mem (mul_mem hb₁ hmx) hmm', ((w : G)⁻¹ * y * (w : G)) * b₂, mul_mem hwy hb₂,
        by rw [← hxy]; group⟩
  · exact (D.doubleCoset_mul_subset_of_root'_pos ha hm w hpos).trans Set.subset_union_left
private instance intersection_borelSubgroup_normal :
    (D.borelSubgroup.subgroupOf D.weylNormalizer).Normal :=
  D.subgroupOf_borelSubgroup_weylNormalizer ▸ D.T_normal_weylNormalizer
private abbrev TitsW : Type _ := D.weylNormalizer ⧸ D.borelSubgroup.subgroupOf D.weylNormalizer
private abbrev titsSimple : Set D.TitsW :=
  {s | ∃ a ∈ D.base₀.support, ∃ (m : G) (hm : m ∈ D.reflectionCoset a.val),
    QuotientGroup.mk (D.reflN hm) = s}
private theorem closure_titsSimple : Subgroup.closure D.titsSimple = ⊤ := by
  have hcoset (a : {i : ι // P.IsIndivisible i}) (m : G) (hm : m ∈ D.reflectionCoset a.val) :
      (QuotientGroup.mk (D.reflN hm) : D.TitsW) ∈ Subgroup.closure D.titsSimple := by
    refine D.base₀.induction_reflect a (p := fun a ↦ ∀ (m : G) (hm : m ∈ D.reflectionCoset a.val),
        (QuotientGroup.mk (D.reflN hm) : D.TitsW) ∈ Subgroup.closure D.titsSimple)
      (fun c ih m' hm' ↦ ih m' <| by
        rwa [P.coe_indivisiblePairing_reflectionPerm c c,
          D.reflectionCoset_reflectionPerm_self] at hm')
      (fun c hc m' hm' ↦ Subgroup.subset_closure ⟨c, hc, m', hm', rfl⟩) ?_ m hm
    intro c d ih hd m' hm'
    obtain ⟨⟨md, hmd⟩, ⟨mc, hmc⟩⟩ :=
      D.reflectionCoset_nonempty d.val, D.reflectionCoset_nonempty c.val
    have hconj : md * mc * md⁻¹ ∈
        D.reflectionCoset (P.indivisiblePairing.reflectionPerm d c).val :=
      P.coe_indivisiblePairing_reflectionPerm d c ▸ D.mul_mul_inv_mem_reflectionCoset hmd hmc
    have hmk : (QuotientGroup.mk (D.reflN hm') : D.TitsW) =
        QuotientGroup.mk (D.reflN hmd * D.reflN hmc * (D.reflN hmd)⁻¹) := by
      rw [QuotientGroup.eq, D.subgroupOf_borelSubgroup_weylNormalizer, Subgroup.mem_subgroupOf]
      exact D.inv_mul_mem_T hm' hconj
    have hsd : (QuotientGroup.mk (D.reflN hmd) : D.TitsW) ∈ Subgroup.closure D.titsSimple :=
      Subgroup.subset_closure ⟨d, hd, md, hmd, rfl⟩
    rw [hmk, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv]
    exact mul_mem (mul_mem hsd (ih mc hmc)) (inv_mem hsd)
  rw [eq_top_iff]; rintro q -; obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective q
  induction n using D.weylNormalizer_induction with
  | torus t ht =>
    have h1 : (QuotientGroup.mk ⟨t, D.T_le_weylNormalizer ht⟩ : D.TitsW) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr (D.T_le_borelSubgroup ht)
    exact h1 ▸ one_mem _
  | reflection i m hm =>
    exact (P.isIndivisible_or_exists_root_eq_two_smul i).elim (fun hi ↦ hcoset ⟨i, hi⟩ m hm)
      fun ⟨j, hj, hij⟩ ↦ hcoset ⟨j, hj⟩ m (D.reflectionCoset_eq_of_root_eq_two_smul hij ▸ hm)
  | one => rw [QuotientGroup.mk_one]; exact one_mem _
  | mul _ _ ihx ihy => rw [QuotientGroup.mk_mul]; exact mul_mem ihx ihy
  | inv _ ih => rw [QuotientGroup.mk_inv]; exact inv_mem ih
variable {D} in
/-- **Tits system of a generating root datum** (Bruhat–Tits I, Théorème 6.1.15). -/
noncomputable def IsGenerating.titsSystem (hG : D.IsGenerating) : TitsSystem G where
  subgroupB := D.borelSubgroup
  subgroupN := D.weylNormalizer
  closure_subgroupB_union_subgroupN := by
    rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq,
      D.borelSubgroup_sup_weylNormalizer]; exact D.isGenerating_iff_generatedSubgroup_eq_top.mp hG
  intersection_normal := D.intersection_borelSubgroup_normal
  simple := D.titsSimple
  closure_simple := D.closure_titsSimple
  exists_simpleRep_mul_self_mem := by
    rintro _ ⟨a, _, m, hm, rfl⟩; exact ⟨D.reflN hm, rfl, D.T_le_borelSubgroup (D.mul_self_mem_T hm)⟩
  mul_doubleCoset_subset := by
    rintro _ ⟨a, ha, m, hm, rfl⟩; exact ⟨D.reflN hm, rfl, D.doubleCoset_mul_subset_union ha hm⟩
  exists_conj_not_mem := by
    rintro _ ⟨a, ha, m, hm, rfl⟩
    obtain ⟨⟨u, hu⟩, hu_ne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot a.val)
    have ha_pos := P.root'_pos_of_mem_indivisibleBaseOf ha
    exact ⟨D.reflN hm, rfl, ⟨u, D.positiveSubgroup_le_borelSubgroup
      (D.U_le_positiveSubgroup ha_pos hu)⟩, fun hB ↦
        hu_ne (Subtype.ext (D.eq_one_of_mem_U_of_conj_mem_borelSubgroup ha_pos hm hu hB))⟩
/-- The Borel subgroup of `hG.titsSystem` is `D.borelSubgroup`. -/
@[simp] theorem IsGenerating.titsSystem_subgroupB {D : RootDatum P G} (hG : D.IsGenerating) :
    hG.titsSystem.subgroupB = D.borelSubgroup := (rfl)
/-- The Weyl normalizer subgroup of `hG.titsSystem` is `D.weylNormalizer`. -/
@[simp] theorem IsGenerating.titsSystem_subgroupN {D : RootDatum P G} (hG : D.IsGenerating) :
    hG.titsSystem.subgroupN = D.weylNormalizer := (rfl)
/-- Membership in the simple reflections of `hG.titsSystem`: the classes in `N / (B ∩ N)` of
elements of `D.reflectionCoset a.val` for simple roots `a` of the indivisible base cut out by
`D.positiveVector`. -/
theorem IsGenerating.mem_titsSystem_simple_iff {D : RootDatum P G} (hG : D.IsGenerating)
    {s : hG.titsSystem.WeylGroup} :
    s ∈ hG.titsSystem.simple ↔
      ∃ a ∈ (P.indivisibleBaseOf D.positiveVector D.positiveVector_regular).support,
        ∃ (m : G) (hm : m ∈ D.reflectionCoset a.val),
          QuotientGroup.mk
            ⟨m, hG.titsSystem_subgroupN.symm ▸
              D.reflectionCoset_subset_weylNormalizer a.val hm⟩ = s :=
  Iff.rfl
/-- The Tits system attached to any Bruhat–Tits root datum, in `D.generatedSubgroup`. -/
noncomputable def titsSystem : TitsSystem D.generatedSubgroup :=
  D.isGenerating_restrictToGenerated.titsSystem
/-- The Borel subgroup of `D.titsSystem` is `D.borelSubgroup` restricted to
`D.generatedSubgroup`. -/
@[simp] theorem titsSystem_subgroupB :
    D.titsSystem.subgroupB = D.borelSubgroup.subgroupOf D.generatedSubgroup :=
  D.restrictToGenerated_borelSubgroup
/-- The Weyl normalizer subgroup of `D.titsSystem` is `D.weylNormalizer` restricted to
`D.generatedSubgroup`. -/
@[simp] theorem titsSystem_subgroupN :
    D.titsSystem.subgroupN = D.weylNormalizer.subgroupOf D.generatedSubgroup :=
  D.restrictToGenerated_weylNormalizer
/-- Membership in the simple reflections of `D.titsSystem`: the classes in `N / (B ∩ N)` of
elements of `D.reflectionCoset a.val` for simple roots `a` of the indivisible base cut out by
`D.positiveVector`. -/
theorem mem_titsSystem_simple_iff {s : D.titsSystem.WeylGroup} :
    s ∈ D.titsSystem.simple ↔
      ∃ a ∈ (P.indivisibleBaseOf D.positiveVector D.positiveVector_regular).support,
        ∃ (m : G) (hm : m ∈ D.reflectionCoset a.val),
          QuotientGroup.mk
            ⟨⟨m, D.reflectionCoset_subset_generatedSubgroup a.val hm⟩,
              D.titsSystem_subgroupN.symm ▸
                D.reflectionCoset_subset_weylNormalizer a.val hm⟩ = s := by
  have hbase : P.indivisibleBaseOf D.restrictToGenerated.positiveVector
      D.restrictToGenerated.positiveVector_regular =
      P.indivisibleBaseOf D.positiveVector D.positiveVector_regular := by
    congr 1; exact D.restrictToGenerated_positiveVector
  refine D.isGenerating_restrictToGenerated.mem_titsSystem_simple_iff.trans
    (exists_congr fun a ↦ ?_)
  rw [hbase]
  refine and_congr_right fun _ ↦ ⟨?_, ?_⟩
  · rintro ⟨m, hm, rfl⟩
    rw [D.restrictToGenerated_reflectionCoset, Set.mem_preimage] at hm
    exact ⟨m.val, hm, rfl⟩
  · rintro ⟨m, hm, rfl⟩
    refine ⟨⟨m, D.reflectionCoset_subset_generatedSubgroup a.val hm⟩, ?_, rfl⟩
    rwa [D.restrictToGenerated_reflectionCoset, Set.mem_preimage]
private theorem IsGenerating.ker_weylGroupHom {D : RootDatum P G} (hG : D.IsGenerating) :
    D.weylGroupHom.ker = D.T.subgroupOf D.weylNormalizer := by
  refine le_antisymm (fun n hn ↦ ?_) fun n hn ↦ D.weylGroupHom_torus hn
  let TS := hG.titsSystem; let nTS : TS.subgroupN := n
  let q : TS.WeylGroup := QuotientGroup.mk (s := TS.intersection) nTS
  suffices hq1 : q = 1 from D.borelSubgroup_inf_weylNormalizer ▸
    ⟨(QuotientGroup.eq_one_iff (N := TS.intersection) nTS).mp hq1, n.property⟩
  by_contra hq_ne; obtain ⟨l, hl, hlen, hprod⟩ := TS.exists_prod_eq_of_wordLength q
  rcases l with _ | ⟨s, l'⟩
  · exact hq_ne (hprod.symm.trans List.prod_nil)
  · have hs : s ∈ TS.simple := hl s List.mem_cons_self
    have hl' : ∀ x ∈ l', x ∈ TS.simple := fun x hx ↦ hl x (List.mem_cons_of_mem _ hx)
    have hsq : s * q = l'.prod := by
      rw [← hprod, List.prod_cons, TS.simple_mul_simple_cancel_left hs]
    have hlt_len : TS.simpleGenerators.wordLength (s * q) < TS.simpleGenerators.wordLength q :=
      hsq ▸ (TS.wordLength_prod_le hl').trans_lt (by rw [← hlen, List.length_cons]; omega)
    obtain ⟨a, ha, m, hm, hsmk⟩ := id hs
    have hcell_eq : TS.bruhatCell s * TS.bruhatCell q = TS.bruhatCell (s * q) := by
      refine Set.Subset.antisymm ?_ (TS.subset_bruhatCell_mul_of_mem_simple hs q)
      let mTS : TS.subgroupN := ⟨m, D.reflectionCoset_subset_weylNormalizer a.val hm⟩
      have hsmk' : s = QuotientGroup.mk (s := TS.intersection) mTS := hsmk.symm
      have hq' : q = QuotientGroup.mk (s := TS.intersection) nTS := rfl
      rw [hsmk', hq', ← QuotientGroup.mk_mul, TS.bruhatCell_mk, TS.bruhatCell_mk, TS.bruhatCell_mk]
      exact D.doubleCoset_mul_subset_of_root'_pos ha hm n
        (by simpa [MonoidHom.mem_ker.mp hn] using P.root'_pos_of_mem_indivisibleBaseOf ha)
    exact lt_asymm hlt_len ((TS.bruhatCell_mul_eq_iff_wordLength_lt hs q).mp hcell_eq)
/-- **Kernel of `D.weylGroupHom`**: an element of `D.weylNormalizer` acts trivially on the root
subgroups if and only if it belongs to `T` (Bruhat–Tits I, 6.1.11 (ii)). -/
@[simp] theorem ker_weylGroupHom : D.weylGroupHom.ker = D.T.subgroupOf D.weylNormalizer := by
  refine le_antisymm (fun n hn ↦ ?_) fun n hn ↦ D.weylGroupHom_torus hn
  let D' := D.restrictToGenerated
  let n' : D'.weylNormalizer :=
    ⟨⟨(n : G), D.weylNormalizer_le_generatedSubgroup n.property⟩,
      D.restrictToGenerated_weylNormalizer.symm ▸ Subgroup.mem_subgroupOf.mpr n.property⟩
  have hhom_eq : D'.weylGroupHom n' = D.weylGroupHom n :=
    (D'.eq_weylGroupHom fun i ↦ Subgroup.ext fun x ↦ by
      simp only [Subgroup.mem_conjAct_smul_iff, D', restrictToGenerated_U, Subgroup.mem_subgroupOf,
        ← D.weylGroupHom_conj n i]; rfl).symm
  have hn'_ker : n' ∈ D'.weylGroupHom.ker := MonoidHom.mem_ker.mpr (hhom_eq.trans hn)
  rw [D.isGenerating_restrictToGenerated.ker_weylGroupHom] at hn'_ker
  simpa [D', Subgroup.mem_subgroupOf] using hn'_ker
/-- Conjugating `m ∈ D.reflectionCoset i` by `n⁻¹` for `n ∈ D.weylNormalizer` (`n⁻¹ m n`) lands in
`D.reflectionCoset (w⁻¹ i)`, where `w = D.weylGroupHom n`. -/
theorem inv_mul_mul_mem_reflectionCoset_weylNormalizer (n : D.weylNormalizer) {i : ι} {m : G}
    (hm : m ∈ D.reflectionCoset i) :
    (n : G)⁻¹ * m * n ∈ D.reflectionCoset (P.weylGroupToPerm (D.weylGroupHom n)⁻¹ i) := by
  set j := P.weylGroupToPerm (D.weylGroupHom n)⁻¹ i
  obtain ⟨m', hm'⟩ := D.reflectionCoset_nonempty j
  let nm : D.weylNormalizer := ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩
  let nm' : D.weylNormalizer := ⟨m', D.reflectionCoset_subset_weylNormalizer j hm'⟩
  have hker : n⁻¹ * nm * n * nm'⁻¹ ∈ D.weylGroupHom.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_mul, map_mul, map_inv, map_inv,
      D.weylGroupHom_reflection hm, D.weylGroupHom_reflection hm']
    have hconj := RootPairing.weylGroup.ofIdx_weylGroupToPerm_eq_conj P (D.weylGroupHom n)⁻¹ i
    rw [inv_inv] at hconj
    rw [← hconj, mul_inv_cancel]
  rw [D.ker_weylGroupHom, Subgroup.mem_subgroupOf] at hker
  exact (D.mem_reflectionCoset_iff_mul_inv_mem_T hm').mpr hker
/-- **The Weyl group isomorphism of a Bruhat–Tits root datum**: `N / T ≃* W(Φ)`. -/
noncomputable def weylGroupEquiv :
    D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer ≃* P.weylGroup :=
  (QuotientGroup.quotientMulEquivOfEq D.ker_weylGroupHom.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective D.weylGroupHom D.weylGroupHom_surjective)
/-- `D.weylGroupEquiv` agrees with `D.weylGroupHom` on coset representatives. -/
@[simp] theorem weylGroupEquiv_mk (n : D.weylNormalizer) :
    D.weylGroupEquiv (QuotientGroup.mk n) = D.weylGroupHom n := (rfl)
/-- Conjugation of `D.U i` by `n ∈ D.weylNormalizer` permutes the index by
`D.weylGroupEquiv [n]`. -/
theorem weylGroupEquiv_conj (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.U i =
      D.U (P.weylGroupToPerm (D.weylGroupEquiv (QuotientGroup.mk n)) i) :=
  D.weylGroupHom_conj n i
/-- The coset of any `m ∈ D.reflectionCoset i` maps under `D.weylGroupEquiv` to the reflection in
`i`. -/
theorem weylGroupEquiv_reflection {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.weylGroupEquiv (QuotientGroup.mk ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩) =
      RootPairing.weylGroup.ofIdx P i := D.weylGroupHom_reflection hm
/-- Elements of `T` represent the identity in `N / T` under `D.weylGroupEquiv`. -/
theorem weylGroupEquiv_torus {t : G} (ht : t ∈ D.T) :
    D.weylGroupEquiv (QuotientGroup.mk ⟨t, D.T_le_weylNormalizer ht⟩) = 1 :=
  D.weylGroupHom_torus ht
/-- No element of a reflection coset `D.reflectionCoset i` maps to `1` under `D.weylGroupEquiv`. -/
theorem weylGroupEquiv_reflection_ne_one {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.weylGroupEquiv (QuotientGroup.mk ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩) ≠ 1 := by
  rw [D.weylGroupEquiv_reflection hm]; exact RootPairing.weylGroup.ofIdx_ne_one P i
end Crystallographic
end TauCeti.BruhatTits.RootDatum
