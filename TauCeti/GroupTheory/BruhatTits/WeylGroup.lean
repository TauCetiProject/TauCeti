/-!
# The Weyl group isomorphism of a Bruhat–Tits root datum

For a root datum `D` of finite crystallographic (possibly non-reduced) type `P` over a linearly
ordered field `R` in a group `G`, let `N = D.weylNormalizer` be the subgroup generated by `T` and
the reflection cosets `M a`. This file establishes the canonical group isomorphism

  `D.weylGroupEquiv : (D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer) ≃* P.weylGroup`

characterized by
`ConjAct.toConjAct n • D.U i = D.U (P.weylGroupToPerm (D.weylGroupEquiv ⟦n⟧) i)`
and sending the coset `M a` to the reflection `s_a` in `P.weylGroup`.

## Proof outline

1. **Proportional roots share reflection cosets.** Using (DR3), (DR4), (DR5), and the Bruhat
   criterion `RootDatum.mem_reflectionCoset_of_mem_mul`, doubling a root does not change its
   reflection coset (`RootDatum.reflectionCoset_eq_of_root_eq_two_smul`). For crystallographic `P`,
   any two linearly dependent roots therefore have the same reflection coset.
2. **Existence and uniqueness of `ν : N →* W`.** By (DR5) and the normality of root subgroups
   under `T`, each `n ∈ N` acts on the family of root subgroups through some `w ∈ P.weylGroup`.
   Uniqueness of `w` follows from (DR6) (`U⁺ ∩ U⁻ = ⊥`), (DR1) (`U a ≠ ⊥`), and
   `RootPairing.weylGroup.eq_one_of_forall_root'_pos` (triviality of Weyl elements preserving
   positive roots).
   This yields the surjective homomorphism `D.weylGroupHom : D.weylNormalizer →* P.weylGroup` with
   `T ≤ ker ν`.
3. **Conjugation of reflection cosets.** For `n ∈ N` and `m ∈ M a`, conjugating a Bruhat
   decomposition of a nontrivial element of `U (-a)` and applying `mem_reflectionCoset_of_mem_mul`
   gives `n m n⁻¹ ∈ M (ν(n) a)` (`RootDatum.conj_mem_reflectionCoset`).
4. **Injectivity on `N / T`.** Pass to the reduced indivisible sub-pairing `P.indivisible` and its
   base `b` attached to `D.positiveVector`. In `Q = N / T`, the classes `t_a` of the reflection
   cosets are involutions satisfying `q t_a q⁻¹ = t_{ν'(q) a}` and `s_a = s_c → t_a = t_c`.
   For two simple roots `a, c`, splitting on the parity of the Coxeter order `m_{ac}` shows
   `(t_a t_c)^{m_{ac}} = 1`. Thus the abstract Coxeter group of `b` maps surjectively onto `Q`
   compatibly with `TauCeti.weylCoxeterHom P.indivisible b`; injectivity of `weylCoxeterHom`
   (Tits' theorem) forces the descended map `ν' : N / T →* P.weylGroup` to be injective.

## Main definitions

* `TauCeti.BruhatTits.RootDatum.weylGroupHom`: the canonical surjective homomorphism
  `D.weylNormalizer →* P.weylGroup`.
* `TauCeti.BruhatTits.RootDatum.weylGroupEquiv`: the canonical isomorphism
  `(D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer) ≃* P.weylGroup`.

## Main results

* `TauCeti.BruhatTits.RootDatum.reflectionCoset_eq_of_root_eq_two_smul`: `M (2 a) = M a`.
* `TauCeti.BruhatTits.RootDatum.weylGroupHom_conj`,
  `TauCeti.BruhatTits.RootDatum.weylGroupEquiv_conj`: action of `N` on root subgroups via `W`.
* `TauCeti.BruhatTits.RootDatum.conj_mem_reflectionCoset`,
  `TauCeti.BruhatTits.RootDatum.conj_smul_reflectionCoset`: conjugation of reflection cosets by `N`.
* `TauCeti.BruhatTits.RootDatum.weylGroupEquiv_reflection`,
  `TauCeti.BruhatTits.RootDatum.weylGroupEquiv_torus`,
  `TauCeti.BruhatTits.RootDatum.weylGroupEquiv_reflection_ne_one`: pinning of generators and `T`.
* `TauCeti.BruhatTits.RootDatum.ker_weylGroupHom`: `ker ν = T`.
* `TauCeti.BruhatTits.RootDatum.weylGroupEquiv_unique`: uniqueness of `weylGroupEquiv`.

## References

* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. I*, Publ. Math. IHÉS 41 (1972),
  6.1.2 (pp. 108–109) and Proposition 6.1.11 (p. 117).
-/

public section

open scoped Pointwise

namespace TauCeti.BruhatTits.RootDatum

variable {ι R M N : Type*} [Field R] [LinearOrder R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} {G : Type*} [Group G] (D : RootDatum P G)

/-! ### Reflection cosets of proportional roots -/

/-- By (DR6), the positive and negative unipotent subgroups meet trivially. -/
@[simp]
theorem positiveSubgroup_inf_negativeSubgroup :
    D.positiveSubgroup ⊓ D.negativeSubgroup = ⊥ :=
  eq_bot_iff.mpr fun _ hg ↦ by
    simpa using D.eq_one_of_mul_mem_negativeSubgroup D.T.one_mem hg.1 (by simpa using hg.2)

/-- Every element of `N = D.weylNormalizer` permutes the root subgroups by some element of the
Weyl group. -/
private theorem exists_weylGroup_conj (n : D.weylNormalizer) :
    ∃ w : P.weylGroup,
      ∀ i, ConjAct.toConjAct (n : G) • D.U i = D.U (P.weylGroupToPerm w i) := by
  obtain ⟨g, hg⟩ := n
  dsimp only
  rw [D.weylNormalizer_def] at hg
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with ht | hm
    · exact ⟨1, fun i ↦ by simpa using D.conj_smul_U_of_mem_T ht⟩
    · obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hm
      exact ⟨RootPairing.weylGroup.ofIdx P a, fun i ↦ by
        rw [P.weylGroupToPerm_ofIdx_apply]
        exact D.reflection_conjugates a x ha i⟩
  | one => exact ⟨1, fun i ↦ by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨w₁, hw₁⟩ := hx
    obtain ⟨w₂, hw₂⟩ := hy
    refine ⟨w₁ * w₂, fun i ↦ ?_⟩
    rw [ConjAct.toConjAct_mul, mul_smul, hw₂, hw₁, map_mul, Equiv.Perm.mul_apply]
  | inv x _ hx =>
    obtain ⟨w, hw⟩ := hx
    refine ⟨w⁻¹, fun i ↦ ?_⟩
    rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, hw, ← Equiv.Perm.mul_apply, ← map_mul,
      mul_inv_cancel, map_one, Equiv.Perm.one_apply]

section Ordered

variable [IsStrictOrderedRing R]

/-- Doubling a root does not change its reflection coset: `M (2 a) = M a`. -/
theorem reflectionCoset_eq_of_root_eq_two_smul {i j : ι}
    (h : P.root j = (2 : R) • P.root i) :
    D.reflectionCoset j = D.reflectionCoset i := by
  have hneg : P.root (P.reflectionPerm j j) = (2 : R) • P.root (P.reflectionPerm i i) := by
    rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self,
      RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self, h, smul_neg]
  have hU : D.U j ≤ D.U i := D.le_of_root_eq_two_smul i j h
  have hUneg : D.U (P.reflectionPerm j j) ≤ D.U (P.reflectionPerm i i) :=
    D.le_of_root_eq_two_smul _ _ hneg
  obtain ⟨⟨u, hu⟩, hne⟩ :=
    Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot (P.reflectionPerm j j))
  have hne' : u ≠ 1 := fun h0 ↦ hne (Subtype.ext h0)
  obtain ⟨_, ⟨x, hx, m, hm, rfl⟩, y, hy, hxy⟩ := D.bruhat j ⟨hu, hne'⟩
  obtain ⟨_, ⟨x', hx', m', hm', rfl⟩, y', hy', hxy'⟩ := D.bruhat i ⟨hUneg hu, hne'⟩
  have hmem : m ∈ (D.U i : Set G) * D.reflectionCoset i * D.U i := by
    refine ⟨x⁻¹ * x' * m', ⟨x⁻¹ * x', mul_mem (inv_mem (hU hx)) hx', m', hm', rfl⟩,
      y' * y⁻¹, mul_mem hy' (inv_mem (hU hy)), ?_⟩
    have hEq : x * m * y = x' * m' * y' := hxy.trans hxy'.symm
    calc
      x⁻¹ * x' * m' * (y' * y⁻¹) = x⁻¹ * (x' * m' * y') * y⁻¹ := by group
      _ = x⁻¹ * (x * m * y) * y⁻¹ := by rw [hEq]
      _ = m := by group
  have : Module.IsReflexive R N := .of_isPerfPair P.flip.toLinearMap
  have : HasUniqueDiv N := .of_isTorsionFree R N
  have hperm : P.reflectionPerm j = P.reflectionPerm i := P.reflectionPerm_eq_of_root_eq_smul h
  have hmi : m ∈ D.reflectionCoset i :=
    D.mem_reflectionCoset_of_mem_mul hmem
      (by rw [D.reflection_conjugates j m hm, hperm])
      (by rw [D.reflection_conjugates j m hm, hperm, P.reflectionPerm_self])
  ext g
  rw [D.mem_reflectionCoset_iff_mul_inv_mem_T hm, D.mem_reflectionCoset_iff_mul_inv_mem_T hmi]

/-- Any two linearly dependent roots of a crystallographic root datum have the same reflection
coset. -/
theorem reflectionCoset_eq_of_not_linearIndependent [P.IsCrystallographic] {i j : ι}
    (h : ¬ LinearIndependent R ![P.root i, P.root j]) :
    D.reflectionCoset j = D.reflectionCoset i := by
  rcases P.root_eq_or_eq_neg_or_two_smul_of_not_linearIndependent h with
    h1 | h1 | h1 | h1 | h1 | h1
  · rw [P.root.injective h1]
  · have : j = P.reflectionPerm i i := P.root.injective (by simpa using h1)
    rw [this, D.reflectionCoset_reflectionPerm_self]
  · exact D.reflectionCoset_eq_of_root_eq_two_smul h1
  · have : P.root j = (2 : R) • P.root (P.reflectionPerm i i) := by simpa using h1
    rw [D.reflectionCoset_eq_of_root_eq_two_smul this, D.reflectionCoset_reflectionPerm_self]
  · exact (D.reflectionCoset_eq_of_root_eq_two_smul h1).symm
  · have : P.root i = (2 : R) • P.root (P.reflectionPerm j j) := by simpa using h1
    rw [D.reflectionCoset_eq_of_root_eq_two_smul this, D.reflectionCoset_reflectionPerm_self]

/-- Roots inducing the same reflection in the Weyl group have the same reflection coset. -/
theorem reflectionCoset_eq_of_ofIdx_eq [P.IsCrystallographic] {i j : ι}
    (h : RootPairing.weylGroup.ofIdx P j = RootPairing.weylGroup.ofIdx P i) :
    D.reflectionCoset j = D.reflectionCoset i :=
  D.reflectionCoset_eq_of_not_linearIndependent (P.not_linearIndependent_of_ofIdx_eq h)

section FiniteCrystallographic

variable [Finite ι] [P.IsCrystallographic]

/-! ### The canonical homomorphism `N →* W` -/

/-- Two Weyl-group elements permuting the root subgroups identically are equal. -/
theorem weylGroup_eq_of_U_weylGroupToPerm_eq {w₁ w₂ : P.weylGroup}
    (h : ∀ i, D.U (P.weylGroupToPerm w₁ i) = D.U (P.weylGroupToPerm w₂ i)) :
    w₁ = w₂ := by
  rw [← mul_inv_eq_one]
  refine RootPairing.weylGroup.eq_one_of_forall_root'_pos D.positiveVector_regular fun i hi ↦ ?_
  by_contra hnot
  have hneg : P.root' (P.weylGroupToPerm (w₁ * w₂⁻¹) i) D.positiveVector < 0 :=
    lt_of_le_of_ne (not_lt.mp hnot) (D.positiveVector_regular _)
  have hU : D.U (P.weylGroupToPerm (w₁ * w₂⁻¹) i) = D.U i := by
    have h' := h (P.weylGroupToPerm w₂⁻¹ i)
    rwa [← Equiv.Perm.mul_apply, ← map_mul, ← Equiv.Perm.mul_apply, ← map_mul,
      mul_inv_cancel, map_one, Equiv.Perm.one_apply] at h'
  have hle : D.U i ≤ D.positiveSubgroup ⊓ D.negativeSubgroup :=
    le_inf (D.U_le_positiveSubgroup hi) (hU ▸ D.U_le_negativeSubgroup hneg)
  rw [D.positiveSubgroup_inf_negativeSubgroup, le_bot_iff] at hle
  exact D.U_ne_bot i hle

/-- The canonical homomorphism `D.weylNormalizer →* P.weylGroup` recording the permutation action
of `N` on the root subgroups. -/
noncomputable def weylGroupHom : D.weylNormalizer →* P.weylGroup where
  toFun n := (D.exists_weylGroup_conj n).choose
  map_one' := D.weylGroup_eq_of_U_weylGroupToPerm_eq fun i ↦ by
    rw [← (D.exists_weylGroup_conj 1).choose_spec i]
    simp
  map_mul' n₁ n₂ := D.weylGroup_eq_of_U_weylGroupToPerm_eq fun i ↦ by
    rw [← (D.exists_weylGroup_conj (n₁ * n₂)).choose_spec i, Subgroup.coe_mul,
      ConjAct.toConjAct_mul, mul_smul, (D.exists_weylGroup_conj n₂).choose_spec i,
      (D.exists_weylGroup_conj n₁).choose_spec, map_mul, Equiv.Perm.mul_apply]

/-- Conjugation by `n ∈ N` sends `U i` to `U (ν(n) i)`. -/
theorem weylGroupHom_conj (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.U i = D.U (P.weylGroupToPerm (D.weylGroupHom n) i) :=
  (D.exists_weylGroup_conj n).choose_spec i

/-- `D.weylGroupHom n` is uniquely determined by the conjugation action of `n` on the root
subgroups. -/
theorem weylGroupHom_eq_of_conj (n : D.weylNormalizer) {w : P.weylGroup}
    (h : ∀ i, ConjAct.toConjAct (n : G) • D.U i = D.U (P.weylGroupToPerm w i)) :
    D.weylGroupHom n = w :=
  D.weylGroup_eq_of_U_weylGroupToPerm_eq fun i ↦ (D.weylGroupHom_conj n i).symm.trans (h i)

/-- Every element of `T` maps to `1` under `D.weylGroupHom`. -/
@[simp]
theorem weylGroupHom_of_mem_T {t : G} (ht : t ∈ D.T) :
    D.weylGroupHom ⟨t, D.T_le_weylNormalizer ht⟩ = 1 :=
  D.weylGroupHom_eq_of_conj _ fun i ↦ by simpa using D.conj_smul_U_of_mem_T ht

/-- Every element of a reflection coset `M i` maps to the reflection `s_i` under
`D.weylGroupHom`. -/
theorem weylGroupHom_of_mem_reflectionCoset {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.weylGroupHom ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩ =
      RootPairing.weylGroup.ofIdx P i :=
  D.weylGroupHom_eq_of_conj _ fun j ↦ by
    rw [P.weylGroupToPerm_ofIdx_apply]
    exact D.reflection_conjugates i m hm j

/-- The canonical homomorphism `N →* W` is surjective. -/
theorem weylGroupHom_surjective : Function.Surjective D.weylGroupHom := by
  rintro ⟨w, hw⟩
  induction hw using RootPairing.weylGroup.induction with
  | mem i =>
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
    exact ⟨⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩,
      D.weylGroupHom_of_mem_reflectionCoset hm⟩
  | one => exact ⟨1, map_one _⟩
  | mul x y _ _ hx hy =>
    obtain ⟨n₁, hn₁⟩ := hx
    obtain ⟨n₂, hn₂⟩ := hy
    exact ⟨n₁ * n₂, by rw [map_mul, hn₁, hn₂]; rfl⟩

/-- `T` lies in the kernel of `D.weylGroupHom`. -/
theorem T_subgroupOf_le_ker_weylGroupHom :
    D.T.subgroupOf D.weylNormalizer ≤ D.weylGroupHom.ker := by
  rintro ⟨t, ht⟩ ht'
  exact D.weylGroupHom_of_mem_T ht'

/-- Some element of `M i` conjugates by `n ∈ N` into `M (ν(n) i)`. -/
private theorem exists_conj_mem_reflectionCoset (n : D.weylNormalizer) (i : ι) :
    ∃ m₁ ∈ D.reflectionCoset i,
      (n : G) * m₁ * (n : G)⁻¹ ∈
        D.reflectionCoset (P.weylGroupToPerm (D.weylGroupHom n) i) := by
  set w := D.weylGroupHom n
  set k := P.weylGroupToPerm w i
  have hneg : P.weylGroupToPerm w (P.reflectionPerm i i) = P.reflectionPerm k k := by
    apply P.root.injective
    rw [← P.weylGroup_apply_root, P.root_reflectionPerm, P.reflection_apply_self,
      P.root_reflectionPerm, P.reflection_apply_self, smul_neg, P.weylGroup_apply_root]
  have hconj {r : ι} {g : G} (hg : g ∈ D.U r) :
      (n : G) * g * (n : G)⁻¹ ∈ D.U (P.weylGroupToPerm w r) := by
    rw [← D.weylGroupHom_conj n r, ← ConjAct.toConjAct_smul]
    exact Subgroup.smul_mem_pointwise_smul _ _ _ hg
  obtain ⟨⟨u, hu⟩, hne⟩ :=
    Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot (P.reflectionPerm i i))
  have hne' : u ≠ 1 := fun h0 ↦ hne (Subtype.ext h0)
  obtain ⟨_, ⟨x, hx, m₁, hm₁, rfl⟩, y, hy, hxy⟩ := D.bruhat i ⟨hu, hne'⟩
  have hun : (n : G) * u * (n : G)⁻¹ ∈ (D.U (P.reflectionPerm k k) : Set G) \ {1} := by
    refine ⟨hneg ▸ hconj hu, fun h0 ↦ hne' ?_⟩
    have : u = (n : G)⁻¹ * ((n : G) * u * (n : G)⁻¹) * (n : G) := by group
    rw [this, h0, mul_one, inv_mul_cancel]
  obtain ⟨_, ⟨x', hx', m', hm', rfl⟩, y', hy', hxy'⟩ := D.bruhat k hun
  have hmem : (n : G) * m₁ * (n : G)⁻¹ ∈ (D.U k : Set G) * D.reflectionCoset k * D.U k := by
    refine ⟨((n : G) * x * (n : G)⁻¹)⁻¹ * x' * m',
      ⟨((n : G) * x * (n : G)⁻¹)⁻¹ * x', mul_mem (inv_mem (hconj hx)) hx', m', hm', rfl⟩,
      y' * ((n : G) * y * (n : G)⁻¹)⁻¹, mul_mem hy' (inv_mem (hconj hy)), ?_⟩
    have hEq : (n : G) * (x * m₁ * y) * (n : G)⁻¹ = x' * m' * y' := by
      dsimp only at hxy hxy'; rw [hxy, ← hxy']
    calc
      ((n : G) * x * (n : G)⁻¹)⁻¹ * x' * m' * (y' * ((n : G) * y * (n : G)⁻¹)⁻¹)
          = ((n : G) * x * (n : G)⁻¹)⁻¹ * (x' * m' * y') *
              ((n : G) * y * (n : G)⁻¹)⁻¹ := by group
      _ = ((n : G) * x * (n : G)⁻¹)⁻¹ * ((n : G) * (x * m₁ * y) * (n : G)⁻¹) *
            ((n : G) * y * (n : G)⁻¹)⁻¹ := by rw [hEq]
      _ = (n : G) * m₁ * (n : G)⁻¹ := by group
  set m₁' : D.weylNormalizer := ⟨m₁, D.reflectionCoset_subset_weylNormalizer i hm₁⟩
  have hhom : D.weylGroupHom (n * m₁' * n⁻¹) = RootPairing.weylGroup.ofIdx P k := by
    rw [map_mul, map_mul, map_inv, D.weylGroupHom_of_mem_reflectionCoset hm₁,
      ← RootPairing.weylGroup.ofIdx_weylGroupToPerm_eq_conj]
  refine ⟨m₁, hm₁, D.mem_reflectionCoset_of_mem_mul hmem ?_ ?_⟩
  · simpa only [Subgroup.coe_mul, Subgroup.coe_inv, hhom, P.weylGroupToPerm_ofIdx_apply] using
      D.weylGroupHom_conj (n * m₁' * n⁻¹) k
  · simpa only [Subgroup.coe_mul, Subgroup.coe_inv, hhom, P.weylGroupToPerm_ofIdx_apply,
      P.reflectionPerm_self] using D.weylGroupHom_conj (n * m₁' * n⁻¹) (P.reflectionPerm k k)

/-- Conjugating a reflection coset by an element of `N` shifts its root index by `D.weylGroupHom`:
`n * m * n⁻¹ ∈ M (ν(n) a)`. -/
theorem conj_mem_reflectionCoset (n : D.weylNormalizer) {i : ι} {m : G}
    (hm : m ∈ D.reflectionCoset i) :
    (n : G) * m * (n : G)⁻¹ ∈ D.reflectionCoset (P.weylGroupToPerm (D.weylGroupHom n) i) := by
  obtain ⟨m₁, hm₁, hnm₁⟩ := D.exists_conj_mem_reflectionCoset n i
  have ht : (n : G) * (m * m₁⁻¹) * (n : G)⁻¹ ∈ D.T :=
    (Subgroup.mem_normalizer_iff.mp (D.weylNormalizer_le_normalizer n.2) (m * m₁⁻¹)).mp
      (D.mul_inv_mem_T hm₁ hm)
  have hmul : (n : G) * m * (n : G)⁻¹ =
      ((n : G) * (m * m₁⁻¹) * (n : G)⁻¹) * ((n : G) * m₁ * (n : G)⁻¹) := by group
  rw [hmul]
  exact D.mul_mem_reflectionCoset ht hnm₁

/-- Conjugation by `n ∈ N` maps the reflection coset `M i` onto `M (ν(n) i)`. -/
theorem conj_smul_reflectionCoset (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.reflectionCoset i =
      D.reflectionCoset (P.weylGroupToPerm (D.weylGroupHom n) i) := by
  ext g
  refine ⟨?_, fun hg ↦ ?_⟩
  · rintro ⟨m, hm, rfl⟩
    exact D.conj_mem_reflectionCoset n hm
  · refine ⟨(n : G)⁻¹ * g * (n : G), ?_, ?_⟩
    · have h := D.conj_mem_reflectionCoset n⁻¹ hg
      rw [Subgroup.coe_inv, inv_inv, map_inv, ← Equiv.Perm.mul_apply, ← map_mul,
        inv_mul_cancel, map_one, Equiv.Perm.one_apply] at h
      exact h
    · simp only [ConjAct.smul_def, ConjAct.ofConjAct_toConjAct]
      group

/-! ### The Weyl group isomorphism `N / T ≃* W` -/

/-- The quotient homomorphism `N / T →* W` descended from `D.weylGroupHom`. -/
private noncomputable def weylQuotientHom :
    (D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer) →* P.weylGroup :=
  QuotientGroup.lift _ D.weylGroupHom D.T_subgroupOf_le_ker_weylGroupHom

omit [Finite ι] [P.IsCrystallographic] in
/-- The unique class of the reflection coset `M i` in the quotient `N / T`. -/
private noncomputable def reflectionClass (i : ι) :
    D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer :=
  QuotientGroup.mk
    ⟨(D.reflectionCoset_nonempty i).choose,
      D.reflectionCoset_subset_weylNormalizer i (D.reflectionCoset_nonempty i).choose_spec⟩

omit [Finite ι] [P.IsCrystallographic] in
private theorem reflectionClass_eq_mk {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.reflectionClass i =
      QuotientGroup.mk ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩ := by
  set m₀ := (D.reflectionCoset_nonempty i).choose
  have hm₀ : m₀ ∈ D.reflectionCoset i := (D.reflectionCoset_nonempty i).choose_spec
  refine QuotientGroup.eq.mpr (Subgroup.mem_subgroupOf.mpr ?_)
  have h1 : m * m₀⁻¹ ∈ D.T := D.mul_inv_mem_T hm₀ hm
  have h2 := D.mul_mul_inv_mem_T (D.inv_mem_reflectionCoset hm₀) h1
  simpa [mul_assoc] using h2

omit [Finite ι] [P.IsCrystallographic] in
private theorem reflectionClass_mul_self (i : ι) :
    D.reflectionClass i * D.reflectionClass i = 1 := by
  obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
  have hm' := D.inv_mem_reflectionCoset hm
  calc
    D.reflectionClass i * D.reflectionClass i
        = QuotientGroup.mk ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩ *
            QuotientGroup.mk ⟨m⁻¹, D.reflectionCoset_subset_weylNormalizer i hm'⟩ :=
      congr_arg₂ (· * ·) (D.reflectionClass_eq_mk hm) (D.reflectionClass_eq_mk hm')
    _ = QuotientGroup.mk (1 : D.weylNormalizer) := by
      rw [← QuotientGroup.mk_mul]
      exact congrArg QuotientGroup.mk (Subtype.ext (mul_inv_cancel m))
    _ = 1 := QuotientGroup.mk_one _

omit [Finite ι] in
private theorem reflectionClass_eq_of_ofIdx_eq {i j : ι}
    (h : RootPairing.weylGroup.ofIdx P i = RootPairing.weylGroup.ofIdx P j) :
    D.reflectionClass i = D.reflectionClass j := by
  obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
  have hm' : m ∈ D.reflectionCoset j := by rwa [D.reflectionCoset_eq_of_ofIdx_eq h.symm]
  rw [D.reflectionClass_eq_mk hm, D.reflectionClass_eq_mk hm']

private theorem weylQuotientHom_reflectionClass (i : ι) :
    D.weylQuotientHom (D.reflectionClass i) = RootPairing.weylGroup.ofIdx P i :=
  D.weylGroupHom_of_mem_reflectionCoset (D.reflectionCoset_nonempty i).choose_spec

private theorem conj_reflectionClass
    (q : D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer) (i : ι) :
    q * D.reflectionClass i * q⁻¹ =
      D.reflectionClass (P.weylGroupToPerm (D.weylQuotientHom q) i) := by
  induction q using QuotientGroup.induction_on with
  | H n =>
    obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
    rw [D.reflectionClass_eq_mk hm, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul,
      ← QuotientGroup.mk_mul]
    exact (D.reflectionClass_eq_mk (D.conj_mem_reflectionCoset n hm)).symm

/-- Conjugating an involution `x` by `(x * y) ^ k` equals `(x * y) ^ (2 * k) * x`. -/
private lemma pow_mul_conj_of_mul_self_eq_one {H : Type*} [Group H] {x y : H}
    (hx : x * x = 1) (hy : y * y = 1) (k : ℕ) :
    (x * y) ^ k * x * ((x * y) ^ k)⁻¹ = (x * y) ^ (2 * k) * x := by
  have hxinv : x⁻¹ = x := inv_eq_of_mul_eq_one_right hx
  have hyinv : y⁻¹ = y := inv_eq_of_mul_eq_one_right hy
  induction k with
  | zero => simp
  | succ k ih =>
    have hxyinv : (x * y)⁻¹ = y * x := by rw [mul_inv_rev, hxinv, hyinv]
    calc
      (x * y) ^ (k + 1) * x * ((x * y) ^ (k + 1))⁻¹
          = (x * y) * ((x * y) ^ k * x * ((x * y) ^ k)⁻¹) * (x * y)⁻¹ := by
        rw [pow_succ', mul_inv_rev]; group
      _ = (x * y) * ((x * y) ^ (2 * k) * x) * (y * x) := by rw [ih, hxyinv]
      _ = (x * y) ^ (2 * k + 1) * (x * y) * x := by rw [pow_succ']; group
      _ = (x * y) ^ (2 * (k + 1)) * x := by
        rw [← pow_succ, show 2 * (k + 1) = 2 * k + 1 + 1 by omega]

/-- In `N / T`, the product of two reflection classes satisfies the braid relation prescribed by
the Weyl group. -/
private theorem pow_reflectionClass_mul_eq_one {i j : ι} {m : ℕ}
    (hm : (RootPairing.weylGroup.ofIdx P i * RootPairing.weylGroup.ofIdx P j) ^ m = 1) :
    (D.reflectionClass i * D.reflectionClass j) ^ m = 1 := by
  set t₁ := D.reflectionClass i
  set t₂ := D.reflectionClass j
  set s₁ := RootPairing.weylGroup.ofIdx P i
  set s₂ := RootPairing.weylGroup.ofIdx P j
  have ht₁ : t₁ * t₁ = 1 := D.reflectionClass_mul_self i
  have ht₂ : t₂ * t₂ = 1 := D.reflectionClass_mul_self j
  have hs₁ : s₁ * s₁ = 1 := RootPairing.weylGroup.ofIdx_mul_self P i
  have hs₂ : s₂ * s₂ = 1 := RootPairing.weylGroup.ofIdx_mul_self P j
  have hhom (k : ℕ) : D.weylQuotientHom ((t₁ * t₂) ^ k) = (s₁ * s₂) ^ k := by
    rw [map_pow, map_mul, D.weylQuotientHom_reflectionClass, D.weylQuotientHom_reflectionClass]
  rcases Nat.even_or_odd m with ⟨k, hk⟩ | ⟨k, hk⟩
  · have hm' : (s₁ * s₂) ^ (2 * k) = 1 := by rwa [show 2 * k = k + k by omega, ← hk]
    have hidx : RootPairing.weylGroup.ofIdx P (P.weylGroupToPerm ((s₁ * s₂) ^ k) i) = s₁ := by
      rw [RootPairing.weylGroup.ofIdx_weylGroupToPerm_eq_conj,
        pow_mul_conj_of_mul_self_eq_one hs₁ hs₂ k, hm', one_mul]
    have hcls : (t₁ * t₂) ^ (2 * k) * t₁ = t₁ := by
      rw [← pow_mul_conj_of_mul_self_eq_one ht₁ ht₂ k, D.conj_reflectionClass, hhom,
        D.reflectionClass_eq_of_ofIdx_eq hidx]
    have hres : (t₁ * t₂) ^ (2 * k) = 1 :=
      mul_right_cancel (b := t₁) (by simpa only [one_mul] using hcls)
    rwa [hk, show k + k = 2 * k by omega]
  · have hm' : (s₁ * s₂) ^ (2 * k + 1) = 1 := by rwa [← hk]
    have hidx : RootPairing.weylGroup.ofIdx P (P.weylGroupToPerm ((s₁ * s₂) ^ k) i) = s₂ := by
      rw [RootPairing.weylGroup.ofIdx_weylGroupToPerm_eq_conj,
        pow_mul_conj_of_mul_self_eq_one hs₁ hs₂ k]
      have : (s₁ * s₂) ^ (2 * k) * s₁ * s₂ = 1 := by
        simpa [pow_succ, mul_assoc] using hm'
      calc
        (s₁ * s₂) ^ (2 * k) * s₁
            = (s₁ * s₂) ^ (2 * k) * s₁ * (s₂ * s₂) := by rw [hs₂, mul_one]
        _ = ((s₁ * s₂) ^ (2 * k) * s₁ * s₂) * s₂ := by group
        _ = s₂ := by rw [this, one_mul]
    have hcls : (t₁ * t₂) ^ (2 * k) * t₁ = t₂ := by
      rw [← pow_mul_conj_of_mul_self_eq_one ht₁ ht₂ k, D.conj_reflectionClass, hhom,
        D.reflectionClass_eq_of_ofIdx_eq hidx]
    rw [hk, pow_succ, ← mul_assoc, hcls, ht₂]

/-- The simple reflection classes in `N / T` satisfy the Coxeter relations of a base of
`P.indivisible`. -/
private lemma coxeter_isLiftable (b : P.indivisible.Base) :
    (TauCeti.coxeterMatrixOfBase P.indivisible b).IsLiftable
      (fun a : b.support ↦ D.reflectionClass a.1.1) := fun a c ↦
  D.pow_reflectionClass_mul_eq_one <| by
    have h := RootPairing.weylGroup.pow_coxeterMatrixOfBase_ofIdx_mul_ofIdx_eq_one
      P.indivisible b a c
    simpa only [map_pow, map_mul, map_one, P.indivisibleWeylGroupEquiv_ofIdx] using
      congrArg P.indivisibleWeylGroupEquiv h

/-- The lifted homomorphism from the Coxeter group of `b` onto `N / T` is surjective. -/
private lemma coxeterLift_surjective (b : P.indivisible.Base) :
    Function.Surjective
      ((TauCeti.coxeterMatrixOfBase P.indivisible b).toCoxeterSystem.lift
        ⟨fun a : b.support ↦ D.reflectionClass a.1.1, D.coxeter_isLiftable b⟩) := by
  set M := TauCeti.coxeterMatrixOfBase P.indivisible b
  set hrel := D.coxeter_isLiftable b
  set φ := M.toCoxeterSystem.lift ⟨fun a : b.support ↦ D.reflectionClass a.1.1, hrel⟩
  have hφ_ind : ∀ i : {i : ι // P.IsIndivisible i}, D.reflectionClass i.1 ∈ φ.range :=
    fun i ↦ b.induction_simple_reflect i (p := fun j ↦ D.reflectionClass j.1 ∈ φ.range)
      (fun j hj ↦
        ⟨M.simple ⟨j, hj⟩, M.toCoxeterSystem.lift_apply_simple hrel ⟨j, hj⟩⟩)
      fun j k hj hk ↦ by
        have hkmem : D.reflectionClass k.1 ∈ φ.range :=
          ⟨M.simple ⟨k, hk⟩, M.toCoxeterSystem.lift_apply_simple hrel ⟨k, hk⟩⟩
        have hconj := D.conj_reflectionClass (D.reflectionClass k.1) j.1
        rw [D.weylQuotientHom_reflectionClass, P.weylGroupToPerm_ofIdx_apply] at hconj
        rw [P.indivisible_reflectionPerm_coe, ← hconj]
        exact mul_mem (mul_mem hkmem hj) (inv_mem hkmem)
  have hφ_le : D.weylNormalizer ≤
      (φ.range.comap (QuotientGroup.mk' (D.T.subgroupOf D.weylNormalizer))).map
        D.weylNormalizer.subtype := by
    refine D.weylNormalizer_le_iff.mpr ⟨fun t ht ↦ ?_, fun i m hm ↦ ?_⟩
    · refine ⟨⟨t, D.T_le_weylNormalizer ht⟩, ?_, rfl⟩
      have h1 : QuotientGroup.mk' (D.T.subgroupOf D.weylNormalizer)
          ⟨t, D.T_le_weylNormalizer ht⟩ = 1 :=
        (QuotientGroup.eq_one_iff (N := D.T.subgroupOf D.weylNormalizer) _).mpr ht
      rw [SetLike.mem_coe, Subgroup.mem_comap, h1]
      exact one_mem _
    · refine ⟨⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩, ?_, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap, QuotientGroup.mk'_apply,
        ← D.reflectionClass_eq_mk hm]
      rcases P.exists_isIndivisible_of_index i with hInd | ⟨j, hInd, hij⟩
      · exact hφ_ind ⟨i, hInd⟩
      · have hm' : m ∈ D.reflectionCoset j := D.reflectionCoset_eq_of_root_eq_two_smul hij ▸ hm
        rw [D.reflectionClass_eq_mk hm, ← D.reflectionClass_eq_mk hm']
        exact hφ_ind ⟨j, hInd⟩
  intro q
  induction q using QuotientGroup.induction_on with
  | H n =>
    obtain ⟨n', hn', hEq⟩ := hφ_le n.2
    have : n' = n := Subtype.ext hEq
    rwa [← this]

/-- The quotient homomorphism `N / T →* W` is injective. -/
private theorem weylQuotientHom_injective : Function.Injective D.weylQuotientHom := by
  have hv : ∀ i : {i : ι // P.IsIndivisible i}, P.indivisible.root' i D.positiveVector ≠ 0 :=
    fun i ↦ by rw [P.indivisible_root']; exact D.positiveVector_regular i.1
  let b := P.indivisible.baseOfRegularCoweight D.positiveVector hv
  let M := TauCeti.coxeterMatrixOfBase P.indivisible b
  let hrel := D.coxeter_isLiftable b
  let φ : M.Group →* (D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer) :=
    M.toCoxeterSystem.lift ⟨fun a : b.support ↦ D.reflectionClass a.1.1, hrel⟩
  have hcomp :
      (P.indivisibleWeylGroupEquiv.symm.toMonoidHom.comp D.weylQuotientHom).comp φ =
        TauCeti.weylCoxeterHom P.indivisible b := by
    apply M.toCoxeterSystem.ext_simple
    intro a
    rw [MonoidHom.comp_apply, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom]
    dsimp only [φ]
    rw [M.toCoxeterSystem.lift_apply_simple hrel a, D.weylQuotientHom_reflectionClass,
      P.indivisibleWeylGroupEquiv_symm_ofIdx, CoxeterMatrix.toCoxeterSystem_simple,
      TauCeti.weylCoxeterHom_apply_simple]
  intro q₁ q₂ hq
  obtain ⟨x₁, rfl⟩ := D.coxeterLift_surjective b q₁
  obtain ⟨x₂, rfl⟩ := D.coxeterLift_surjective b q₂
  have hx : TauCeti.weylCoxeterHom P.indivisible b x₁ =
      TauCeti.weylCoxeterHom P.indivisible b x₂ := by
    rw [← hcomp]
    exact congrArg P.indivisibleWeylGroupEquiv.symm hq
  exact congrArg φ (TauCeti.weylCoxeterHom_injective P.indivisible b hx)

/-- **The Weyl group isomorphism of a Bruhat–Tits root datum**: the quotient `N / T` is
canonically isomorphic to the Weyl group `P.weylGroup`. -/
noncomputable def weylGroupEquiv :
    (D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer) ≃* P.weylGroup :=
  MulEquiv.ofBijective D.weylQuotientHom
    ⟨D.weylQuotientHom_injective, fun w ↦
      let ⟨n, hn⟩ := D.weylGroupHom_surjective w
      ⟨QuotientGroup.mk n, hn⟩⟩

/-- On cosets, `D.weylGroupEquiv` agrees with `D.weylGroupHom`. -/
@[simp]
theorem weylGroupEquiv_mk (n : D.weylNormalizer) :
    D.weylGroupEquiv (QuotientGroup.mk n) = D.weylGroupHom n :=
  (rfl)

/-- Conjugation by `n ∈ N` permutes the root subgroups according to `D.weylGroupEquiv ⟦n⟧`. -/
theorem weylGroupEquiv_conj (n : D.weylNormalizer) (i : ι) :
    ConjAct.toConjAct (n : G) • D.U i =
      D.U (P.weylGroupToPerm (D.weylGroupEquiv (QuotientGroup.mk n)) i) :=
  D.weylGroupHom_conj n i

/-- Every element of a reflection coset `M i` maps to the reflection `s_i` under
`D.weylGroupEquiv`. -/
theorem weylGroupEquiv_reflection {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.weylGroupEquiv (QuotientGroup.mk ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩) =
      RootPairing.weylGroup.ofIdx P i :=
  D.weylGroupHom_of_mem_reflectionCoset hm

/-- Every element of `T` maps to `1` under `D.weylGroupEquiv`. -/
theorem weylGroupEquiv_torus {t : G} (ht : t ∈ D.T) :
    D.weylGroupEquiv (QuotientGroup.mk ⟨t, D.T_le_weylNormalizer ht⟩) = 1 :=
  D.weylGroupHom_of_mem_T ht

/-- Reflection cosets map to nontrivial elements of the Weyl group. -/
theorem weylGroupEquiv_reflection_ne_one {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    D.weylGroupEquiv
      (QuotientGroup.mk ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩) ≠ 1 := by
  rw [D.weylGroupEquiv_reflection hm]
  exact RootPairing.weylGroup.ofIdx_ne_one P i

/-- The kernel of `D.weylGroupHom : N →* W` is precisely `T`. -/
@[simp]
theorem ker_weylGroupHom :
    D.weylGroupHom.ker = D.T.subgroupOf D.weylNormalizer := by
  ext n
  rw [MonoidHom.mem_ker, ← D.weylGroupEquiv_mk,
    map_eq_one_iff _ D.weylGroupEquiv.injective, QuotientGroup.eq_one_iff]

/-- An element of `N` that normalizes every root subgroup lies in `T`. -/
theorem mem_T_of_conj_U_eq (n : D.weylNormalizer)
    (h : ∀ i, ConjAct.toConjAct (n : G) • D.U i = D.U i) : (n : G) ∈ D.T := by
  have h1 : n ∈ D.weylGroupHom.ker := D.weylGroupHom_eq_of_conj n fun i ↦ by simpa using h i
  exact Subgroup.mem_subgroupOf.mp (D.ker_weylGroupHom ▸ h1)

/-- `D.weylGroupEquiv` is the unique isomorphism `N / T ≃* W` compatible with the conjugation
action of `N` on the root subgroups. -/
theorem weylGroupEquiv_unique
    (e : (D.weylNormalizer ⧸ D.T.subgroupOf D.weylNormalizer) ≃* P.weylGroup)
    (he : ∀ (n : D.weylNormalizer) (i : ι),
      ConjAct.toConjAct (n : G) • D.U i =
        D.U (P.weylGroupToPerm (e (QuotientGroup.mk n)) i)) :
    e = D.weylGroupEquiv := by
  refine MulEquiv.ext fun q ↦ ?_
  induction q using QuotientGroup.induction_on with
  | H n =>
    rw [D.weylGroupEquiv_mk]
    exact (D.weylGroupHom_eq_of_conj n (he n)).symm

end FiniteCrystallographic

