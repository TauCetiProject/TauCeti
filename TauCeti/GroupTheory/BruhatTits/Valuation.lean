/-!
# Valuations of a root datum

Let `(T, (U a, M a))` be a root datum of type `Φ` in a group `G`. A *valuation* of it in the
sense of Bruhat–Tits is a family `φ = (φ a : U a → ℝ ∪ {∞})` satisfying the axioms (V0)–(V5):

* (V0) each `φ a` takes at least three values;
* (V1) each `U (a, k) := φ a ⁻¹' [k, ∞]` is a subgroup of `U a`, and `U (a, ∞) = {1}`;
* (V2) for `m ∈ M a`, the function `u ↦ φ (-a) u - φ a (m u m⁻¹)` is constant on `U (-a) ∖ {1}`;
* (V3) `[U (a, k), U (b, l)]` lies in the subgroup generated by the `U (p a + q b, p k + q l)`
  with `p, q ≥ 1`, unless `b` is a negative multiple of `a`;
* (V4) if `2 a` is a root, then `φ (2 a)` is the restriction of `2 φ a` to `U (2 a)`;
* (V5) if `u' u u'' ∈ M a` with `u ∈ U a` and `u', u'' ∈ U (-a)`, then `φ (-a) u' = -φ a u`.

A valuation is the extra structure that turns the abstract root datum of the rational points of
a reductive group over a valued field into an apartment: the filtrations `U (a, k)` give the
root-group parts of the parahoric subgroups, and the affine roots are affine functions
`x ↦ a x + k` whose constants `k` are values of `φ a`. Two valuations are *equipollent* if they
differ by the shift `(φ + v) a = φ a + a v` by a vector `v` of the coroot space; the valuations
equipollent to `φ` form the reduced apartment. A valuation is *compatible* with a map `ν : T → N`
if conjugation by `z ∈ T` lowers each `φ a` by `a (ν z)`; for the torus valuation map of a
reductive group, normalized by `⟨χ, ν z⟩ = -ω (χ z)`, this is the compatibility with the
valuation `ω` of the field, and it says that `z` acts on the apartment by the translation `ν z`.

## Main definitions

* `TauCeti.BruhatTits.Valuation`: a valuation of a root datum.
* `TauCeti.BruhatTits.Valuation.filtration`: the filtration subgroups `U (a, k)`.
* `TauCeti.BruhatTits.Valuation.valueSet`: the set `Γ a = φ a (U a ∖ {1}) ⊆ ℝ`.
* `TauCeti.BruhatTits.Valuation.shift`: the valuation `φ + v` for `v` in the coroot space; it
  defines an additive action of the coroot space on the valuations.
* `TauCeti.BruhatTits.Valuation.Equipollent`: valuations differing by a shift, the orbit relation
  of this action.
* `TauCeti.BruhatTits.Valuation.IsCompatible`: compatibility with a map `T → N`.

## Main results

* `TauCeti.BruhatTits.Valuation.filtration_antitone`: `U (a, l) ≤ U (a, k)` for `k ≤ l`.
* `TauCeti.BruhatTits.Valuation.commutator_filtration_le`: the axiom (V3) for subgroups.
* `TauCeti.BruhatTits.Valuation.bruhat_value_right`: the value form of (V5) for the right factor.
* `TauCeti.BruhatTits.Valuation.valueSet_neg`: `Γ (-a) = -Γ a`.
* `TauCeti.BruhatTits.Valuation.equivalence_equipollent`: equipollence is an equivalence relation.
* `TauCeti.BruhatTits.Valuation.isCompatible_iff_filtration`: `φ` is compatible with `ν` if and
  only if each `z ∈ T` conjugates `U (a, k)` onto `U (a, k - a (ν z))`.

## Implementation notes

The axiom (V1) is stated in the equivalent ultrametric form: `φ a 1 = ∞` and `φ a u = ∞` only
for `u = 1`, `min (φ a u) (φ a v) ≤ φ a (u v)` and `φ a u ≤ φ a u⁻¹`. The subgroups `U (a, k)`
are then `Valuation.filtration`, and (V3) is stated elementwise on commutators of elements.

## References

* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. I*, Publ. Math. IHÉS 41 (1972),
  6.1.2 (2), p. 108, Définition 6.2.1, pp. 116–117, 6.2.2, p. 117, and 6.2.5, p. 120.
* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. II*, Publ. Math. IHÉS 60 (1984),
  4.2.7–4.2.9, p. 91.
-/

public section

open scoped Pointwise commutatorElement

namespace TauCeti.BruhatTits

variable {ι M N : Type*} [AddCommGroup M] [AddCommGroup N] {G : Type*} [Group G]

section Field

variable {R : Type*} [Field R] [LinearOrder R] [Module R M] [Module R N] {P : RootPairing ι R M N}

/-- A valuation of the root datum `D` in the sense of Bruhat–Tits: a function
`φ a : U a → ℝ ∪ {∞}` on each root subgroup, satisfying the axioms (V0)–(V5). The root of index
`P.reflectionPerm i i` is `-P.root i`. -/
structure Valuation (D : RootDatum P G) where
  /-- The function `φ a` on the root subgroup `U a`. -/
  toFun : (i : ι) → D.U i → WithTop ℝ
  /-- (V0) Each `φ a` takes at least three values. -/
  three_le_encard_range (i : ι) : 3 ≤ (Set.range (toFun i)).encard
  /-- (V1) The sets `φ a ⁻¹' [k, ∞]` are closed under multiplication. -/
  min_le_apply_mul (i : ι) (u v : D.U i) : min (toFun i u) (toFun i v) ≤ toFun i (u * v)
  /-- (V1) The sets `φ a ⁻¹' [k, ∞]` are closed under inversion. -/
  apply_le_apply_inv (i : ι) (u : D.U i) : toFun i u ≤ toFun i u⁻¹
  /-- (V1) The value `∞` is taken exactly at the identity. -/
  apply_eq_top_iff (i : ι) (u : D.U i) : toFun i u = ⊤ ↔ u = 1
  /-- (V2) For `m ∈ M a`, `u ↦ φ (-a) u - φ a (m u m⁻¹)` is constant on `U (-a) ∖ {1}`. -/
  exists_apply_eq_apply_conj_add (i : ι) (m : G) (hm : m ∈ D.reflectionCoset i) :
    ∃ c : ℝ, ∀ u : D.U (P.reflectionPerm i i), u ≠ 1 →
      toFun _ u = toFun i ⟨m * u * m⁻¹, D.mul_mul_inv_mem_U_of_mem_reflectionCoset hm u.2⟩ + c
  /-- (V3) Unless `b` is a negative multiple of `a`, the commutator of `u ∈ U a` with
  `φ a u ≥ k` and `v ∈ U b` with `φ b v ≥ l` lies in the subgroup generated by the elements
  `g ∈ U (p a + q b)` with `φ (p a + q b) g ≥ p k + q l`, for `p, q ≥ 1`. -/
  commutator_mem (i j : ι) (hij : ∀ c : R, 0 < c → P.root j ≠ -(c • P.root i)) (k l : ℝ)
    (u : D.U i) (v : D.U j) (hu : (k : WithTop ℝ) ≤ toFun i u) (hv : (l : WithTop ℝ) ≤ toFun j v) :
    ⁅(u : G), (v : G)⁆ ∈ Subgroup.closure {g | ∃ (n : ι) (p q : ℕ), 0 < p ∧ 0 < q ∧
      P.root n = p • P.root i + q • P.root j ∧
      ∃ h : g ∈ D.U n, ((p * k + q * l : ℝ) : WithTop ℝ) ≤ toFun n ⟨g, h⟩}
  /-- (V4) If `2 a` is a root, then `φ (2 a)` is the restriction of `2 φ a` to `U (2 a)`. -/
  apply_eq_two_smul (i j : ι) (h : P.root j = (2 : R) • P.root i) (u : D.U j) :
    toFun j u = 2 • toFun i ⟨u, D.le_of_root_eq_two_smul i j h u.2⟩
  /-- (V5) If `u' u u'' ∈ M a` with `u ∈ U a` and `u', u'' ∈ U (-a)`, then
  `φ (-a) u' = -φ a u`. -/
  bruhat_value_left (i : ι) (u : D.U i) (u' u'' : D.U (P.reflectionPerm i i))
    (h : (u' : G) * u * u'' ∈ D.reflectionCoset i) : toFun _ u' = -toFun i u

namespace Valuation

variable {D : RootDatum P G}

instance : CoeFun (Valuation D) fun _ ↦ (i : ι) → D.U i → WithTop ℝ :=
  ⟨Valuation.toFun⟩

@[ext]
theorem ext {φ ψ : Valuation D} (h : ∀ i u, φ i u = ψ i u) : φ = ψ := by
  cases φ
  cases ψ
  congr
  exact funext fun i ↦ funext (h i)

variable (φ : Valuation D) {i : ι}

/-! ### Values -/

attribute [simp] apply_eq_top_iff

@[simp]
theorem apply_one (i : ι) : φ i 1 = ⊤ :=
  (φ.apply_eq_top_iff i 1).mpr rfl

theorem apply_ne_top_iff {u : D.U i} : φ i u ≠ ⊤ ↔ u ≠ 1 :=
  (φ.apply_eq_top_iff i u).not

@[simp]
theorem apply_inv (u : D.U i) : φ i u⁻¹ = φ i u :=
  le_antisymm (by simpa using φ.apply_le_apply_inv i u⁻¹) (φ.apply_le_apply_inv i u)

/-- A nontrivial element of a root subgroup has a real value. -/
theorem exists_apply_eq_coe {u : D.U i} (hu : u ≠ 1) : ∃ k : ℝ, φ i u = k :=
  WithTop.ne_top_iff_exists.mp ((φ.apply_ne_top_iff).mpr hu) |>.imp fun _ h ↦ h.symm

/-! ### Filtration subgroups -/

/-- The filtration subgroup `U (a, k) = φ a ⁻¹' [k, ∞]` of the root subgroup `U a`. -/
def filtration (i : ι) (k : ℝ) : Subgroup G where
  carrier := {g | ∃ h : g ∈ D.U i, (k : WithTop ℝ) ≤ φ i ⟨g, h⟩}
  one_mem' := ⟨one_mem _, le_top.trans_eq (φ.apply_one i).symm⟩
  mul_mem' := by
    rintro g g' ⟨hg, hk⟩ ⟨hg', hk'⟩
    exact ⟨mul_mem hg hg', (le_min hk hk').trans (φ.min_le_apply_mul i ⟨g, hg⟩ ⟨g', hg'⟩)⟩
  inv_mem' := by
    rintro g ⟨hg, hk⟩
    exact ⟨inv_mem hg, hk.trans (φ.apply_le_apply_inv i ⟨g, hg⟩)⟩

@[simp]
theorem mem_filtration_iff {k : ℝ} {g : G} :
    g ∈ φ.filtration i k ↔ ∃ h : g ∈ D.U i, (k : WithTop ℝ) ≤ φ i ⟨g, h⟩ :=
  Iff.rfl

/-- An element `u` of `U a` lies in `U (a, k)` iff `k ≤ φ a u`. -/
-- Not `@[simp]`: `simp` proves it from `mem_filtration_iff` and `Subtype.coe_eta`.
theorem coe_mem_filtration_iff {k : ℝ} (u : D.U i) :
    (u : G) ∈ φ.filtration i k ↔ (k : WithTop ℝ) ≤ φ i u :=
  ⟨fun ⟨_, h⟩ ↦ h, fun h ↦ ⟨u.2, h⟩⟩

theorem filtration_le_U (i : ι) (k : ℝ) : φ.filtration i k ≤ D.U i :=
  fun _ ⟨h, _⟩ ↦ h

/-- The filtration is decreasing: `U (a, l) ≤ U (a, k)` for `k ≤ l`. -/
theorem filtration_antitone (i : ι) : Antitone (φ.filtration i) :=
  fun _ _ hkl _ ⟨h, hl⟩ ↦ ⟨h, (WithTop.coe_le_coe.mpr hkl).trans hl⟩

/-- `U (a, ∞) = ⋂ k, U (a, k)` is trivial. -/
@[simp]
theorem iInf_filtration (i : ι) : ⨅ k, φ.filtration i k = ⊥ := by
  refine eq_bot_iff.mpr fun g hg ↦ ?_
  have hg' := Subgroup.mem_iInf.mp hg
  have h : ∃ h : g ∈ D.U i, ∀ k : ℝ, (k : WithTop ℝ) ≤ φ i ⟨g, h⟩ :=
    ⟨(hg' 0).1, fun k ↦ (hg' k).2⟩
  obtain ⟨h, hk⟩ := h
  have := (φ.apply_eq_top_iff i ⟨g, h⟩).mp (WithTop.eq_top_iff_forall_ge.mpr hk)
  exact Subgroup.mem_bot.mpr (congrArg Subtype.val this)

/-- Every element of `U a` lies in some `U (a, k)`. -/
@[simp]
theorem iSup_filtration (i : ι) : ⨆ k, φ.filtration i k = D.U i := by
  refine le_antisymm (iSup_le (φ.filtration_le_U i)) fun g hg ↦ ?_
  by_cases h1 : (⟨g, hg⟩ : D.U i) = 1
  · rw [show g = 1 from congrArg Subtype.val h1]
    exact one_mem _
  · obtain ⟨k, hk⟩ := φ.exists_apply_eq_coe h1
    exact Subgroup.mem_iSup_of_mem k ((φ.coe_mem_filtration_iff ⟨g, hg⟩).mpr hk.ge)

/-- The axiom (V3) for the filtration subgroups: unless `b` is a negative multiple of `a`,
`[U (a, k), U (b, l)]` lies in the subgroup generated by the `U (p a + q b, p k + q l)` with
`p, q ≥ 1`. -/
theorem commutator_filtration_le {j : ι} (hij : ∀ c : R, 0 < c → P.root j ≠ -(c • P.root i))
    (k l : ℝ) :
    ⁅φ.filtration i k, φ.filtration j l⁆ ≤
      ⨆ (n) (p : ℕ) (q : ℕ) (_ : 0 < p ∧ 0 < q ∧ P.root n = p • P.root i + q • P.root j),
        φ.filtration n (p * k + q * l) := by
  rw [Subgroup.commutator_le]
  rintro g ⟨hg, hk⟩ g' ⟨hg', hl⟩
  refine (Subgroup.closure_le _).mpr ?_ (φ.commutator_mem i j hij k l ⟨g, hg⟩ ⟨g', hg'⟩ hk hl)
  rintro x ⟨n, p, q, hp, hq, hn, hx, hv⟩
  exact Subgroup.mem_iSup_of_mem n <| Subgroup.mem_iSup_of_mem p <| Subgroup.mem_iSup_of_mem q <|
    Subgroup.mem_iSup_of_mem ⟨hp, hq, hn⟩ ⟨hx, hv⟩

/-! ### Value sets -/

/-- The value set `Γ a = φ a (U a ∖ {1}) ⊆ ℝ`, the set of real values of `φ a`. -/
def valueSet (i : ι) : Set ℝ :=
  {k | ∃ u : D.U i, φ i u = k}

@[simp]
theorem mem_valueSet_iff {k : ℝ} : k ∈ φ.valueSet i ↔ ∃ u : D.U i, φ i u = k :=
  Iff.rfl

theorem apply_mem_valueSet {u : D.U i} {k : ℝ} (h : φ i u = k) : k ∈ φ.valueSet i :=
  ⟨u, h⟩

/-- By (V0), each value set has at least two elements. -/
theorem valueSet_nontrivial (i : ι) : (φ.valueSet i).Nontrivial := by
  rw [← Set.one_lt_encard_iff_nontrivial]
  have hsub : Set.range (φ i) ⊆ insert ⊤ ((↑) '' φ.valueSet i) := by
    rintro _ ⟨u, rfl⟩
    by_cases hu : u = 1
    · simp [hu]
    · obtain ⟨k, h⟩ := φ.exists_apply_eq_coe hu
      exact Set.mem_insert_of_mem _ ⟨k, ⟨u, h⟩, h.symm⟩
  have h3 := (φ.three_le_encard_range i).trans ((Set.encard_le_encard hsub).trans
    (Set.encard_insert_le _ _))
  rw [WithTop.coe_injective.encard_image] at h3
  by_contra h
  have h1 : (φ.valueSet i).encard ≤ 1 := not_lt.mp h
  have : (φ.valueSet i).encard + 1 ≤ 1 + 1 := by gcongr
  exact absurd (h3.trans this) (by decide)

section Ordered

variable [IsStrictOrderedRing R]

/-- The value form of (V5) for the right factor: if `u' u u'' ∈ M a` with `u ∈ U a` and
`u', u'' ∈ U (-a)`, then `φ (-a) u'' = -φ a u`. -/
theorem bruhat_value_right (u : D.U i) (u' u'' : D.U (P.reflectionPerm i i))
    (h : (u' : G) * u * u'' ∈ D.reflectionCoset i) : φ _ u'' = -φ i u := by
  have h' : ((u''⁻¹ : D.U _) : G) * (u⁻¹ : D.U i) * (u'⁻¹ : D.U _) ∈ D.reflectionCoset i := by
    simpa [mul_assoc] using D.inv_mem_reflectionCoset h
  simpa using φ.bruhat_value_left i u⁻¹ u''⁻¹ u'⁻¹ h'

/-- In (V5) the middle factor `u` is nontrivial, so `φ a u` is real. -/
theorem bruhat_value_ne_top (u : D.U i) (u' u'' : D.U (P.reflectionPerm i i))
    (h : (u' : G) * u * u'' ∈ D.reflectionCoset i) : φ i u ≠ ⊤ := by
  rw [φ.apply_ne_top_iff, Ne, ← Subtype.coe_inj]
  exact D.ne_one_of_mul_mul_mem_reflectionCoset u'.2 u''.2 h

/-- A value `k` of `φ a` gives the value `-k` of `φ (-a)`. -/
theorem neg_mem_valueSet_neg {k : ℝ} (hk : k ∈ φ.valueSet i) :
    -k ∈ φ.valueSet (P.reflectionPerm i i) := by
  obtain ⟨u, hu⟩ := hk
  have hu1 : (u : G) ≠ 1 := by
    rintro h
    rw [show u = 1 from Subtype.ext h] at hu
    simp at hu
  -- Write `u = x n y` with `x, y ∈ U (-a)` and `n ∈ M (-a) = M a`.
  have hmem : (u : G) ∈ (D.U (P.reflectionPerm (P.reflectionPerm i i)
      (P.reflectionPerm i i)) : Set G) \ {1} :=
    ⟨by rw [P.reflectionPerm_reflectionPerm_self]; exact u.2, hu1⟩
  obtain ⟨_, ⟨x, hx, n, hn, rfl⟩, y, hy, hxy⟩ := D.bruhat _ hmem
  rw [D.reflectionCoset_reflectionPerm_self] at hn
  have hn' : ((⟨x, hx⟩⁻¹ : D.U _) : G) * u * (⟨y, hy⟩⁻¹ : D.U _) ∈ D.reflectionCoset i := by
    convert hn using 1
    simp only [Subgroup.coe_inv]
    rw [← hxy]
    group
  refine ⟨_, (φ.bruhat_value_left i u _ _ hn').trans ?_⟩
  rw [hu, WithTop.LinearOrderedAddCommGroup.coe_neg]

/-- The value set of `-a` is the negative of that of `a`: `Γ (-a) = -Γ a`. -/
theorem valueSet_neg (i : ι) :
    φ.valueSet (P.reflectionPerm i i) = -φ.valueSet i := by
  refine Set.Subset.antisymm (fun k hk ↦ Set.mem_neg.mpr ?_) fun k hk ↦ by
    simpa using φ.neg_mem_valueSet_neg (Set.mem_neg.mp hk)
  simpa using φ.neg_mem_valueSet_neg hk

end Ordered

/-! ### Root data of rank zero -/

section RankZero

variable [IsEmpty ι]

/-- A root datum with no roots has a unique valuation, the empty family. -/
instance : Unique (Valuation D) where
  default :=
    { toFun := isEmptyElim
      three_le_encard_range := isEmptyElim
      min_le_apply_mul := isEmptyElim
      apply_le_apply_inv := isEmptyElim
      apply_eq_top_iff := isEmptyElim
      exists_apply_eq_apply_conj_add := isEmptyElim
      commutator_mem := isEmptyElim
      apply_eq_two_smul := isEmptyElim
      bruhat_value_left := isEmptyElim }
  uniq _ := ext isEmptyElim

end RankZero

end Valuation

end Field

/-! ### Shifts and equipollence -/

namespace Valuation

variable [Module ℝ M] [Module ℝ N] {P : RootPairing ι ℝ M N} {D : RootDatum P G}
  (φ : Valuation D) {i : ι}

/-- The shift `(φ + v) a = φ a + a v` of a valuation by a vector `v` of the coroot space. -/
def shift (v : N) : Valuation D where
  toFun i u := φ i u + (P.root' i v : WithTop ℝ)
  three_le_encard_range i := by
    have h := φ.three_le_encard_range i
    rw [← (add_left_injective_of_ne_top _ WithTop.coe_ne_top).encard_image,
      ← Set.range_comp] at h
    exact h
  min_le_apply_mul i u w := by
    rw [min_add_add_right]
    gcongr
    exact φ.min_le_apply_mul i u w
  apply_le_apply_inv i u := by
    gcongr
    exact φ.apply_le_apply_inv i u
  apply_eq_top_iff i u := by simp
  exists_apply_eq_apply_conj_add i m hm := by
    obtain ⟨c, hc⟩ := φ.exists_apply_eq_apply_conj_add i m hm
    refine ⟨c - 2 * P.root' i v, fun u hu ↦ ?_⟩
    rw [hc u hu, P.root'_reflectionPerm_self, LinearMap.neg_apply]
    obtain ⟨k, hk⟩ := φ.exists_apply_eq_coe (u := ⟨m * u * m⁻¹, _⟩) (fun h ↦ hu (by
      simpa using congrArg Subtype.val h))
    rw [hk]
    norm_cast
    ring
  commutator_mem i j hij k l u w hu hw := by
    rw [WithTop.coe_le_add_coe_iff] at hu hw
    refine Subgroup.closure_mono ?_ (φ.commutator_mem i j hij _ _ u w hu hw)
    rintro g ⟨n, p, q, hp, hq, hn, hg, hv⟩
    refine ⟨n, p, q, hp, hq, hn, hg, ?_⟩
    rw [WithTop.coe_le_add_coe_iff]
    have hnv : P.root' n v = p * P.root' i v + q * P.root' j v := by
      simp [RootPairing.root', hn, nsmul_eq_mul]
    convert hv using 3
    rw [hnv]
    ring
  apply_eq_two_smul i j h u := by
    have hv : P.root' j v = 2 * P.root' i v := by simp [RootPairing.root', h]
    rw [φ.apply_eq_two_smul i j h u, hv, two_nsmul, two_nsmul, two_mul, WithTop.coe_add]
    abel
  bruhat_value_left i u u' u'' h := by
    rw [φ.bruhat_value_left i u u' u'' h, P.root'_reflectionPerm_self, LinearMap.neg_apply]
    generalize φ.toFun i u = x
    cases x with
    | top => simp
    | coe x => norm_cast; ring

@[simp]
theorem shift_apply (v : N) (u : D.U i) : (φ.shift v) i u = φ i u + (P.root' i v : WithTop ℝ) :=
  (rfl)

@[simp]
theorem shift_zero : φ.shift 0 = φ := by
  ext
  simp

@[simp]
theorem shift_shift (v w : N) : (φ.shift v).shift w = φ.shift (v + w) := by
  ext
  simp [add_assoc]

/-- Shifting by `v` moves the filtration: `U (φ + v) (a, k) = U φ (a, k - a v)`. -/
@[simp]
theorem filtration_shift (v : N) (k : ℝ) :
    (φ.shift v).filtration i k = φ.filtration i (k - P.root' i v) := by
  ext g
  simp only [mem_filtration_iff, shift_apply, WithTop.coe_le_add_coe_iff]

/-- Shifting by `v` translates the value set of `a` by `a v`. -/
@[simp]
theorem valueSet_shift (v : N) :
    (φ.shift v).valueSet i = (· + P.root' i v) '' φ.valueSet i := by
  ext k
  simp only [mem_valueSet_iff, shift_apply, Set.mem_image]
  constructor
  · rintro ⟨u, hu⟩
    obtain ⟨l, hl⟩ := φ.exists_apply_eq_coe (u := u) fun h ↦ by simp [h] at hu
    rw [hl] at hu
    exact ⟨l, ⟨u, hl⟩, by exact_mod_cast hu⟩
  · rintro ⟨l, ⟨u, hu⟩, rfl⟩
    exact ⟨u, by rw [hu]; norm_cast⟩

/-- The coroot space acts on the valuations by shifts: `v +ᵥ φ = φ + v`. -/
instance : AddAction N (Valuation D) where
  vadd v φ := φ.shift v
  zero_vadd := shift_zero
  add_vadd v w φ := by
    rw [add_comm]
    exact (φ.shift_shift w v).symm

@[simp]
theorem vadd_eq_shift (v : N) : v +ᵥ φ = φ.shift v :=
  rfl

/-- Two valuations are equipollent if they differ by a shift: `ψ = φ + v` for some `v`. They
are the orbits of the action of the coroot space by shifts, which form the reduced apartment. -/
def Equipollent (φ ψ : Valuation D) : Prop :=
  AddAction.orbitRel N (Valuation D) ψ φ

theorem equipollent_iff {ψ : Valuation D} :
    φ.Equipollent ψ ↔ ∃ v : N, ∀ i u, ψ i u = φ i u + (P.root' i v : WithTop ℝ) :=
  exists_congr fun v ↦ ⟨fun h _ _ ↦ by simp [← h], fun h ↦ (ext h).symm⟩

/-- Every valuation is equipollent to its shifts. -/
theorem equipollent_shift (v : N) : φ.Equipollent (φ.shift v) :=
  ⟨v, rfl⟩

@[refl]
theorem Equipollent.refl : φ.Equipollent φ :=
  (AddAction.orbitRel N (Valuation D)).refl φ

variable {φ}

@[symm]
theorem Equipollent.symm {ψ : Valuation D} (h : φ.Equipollent ψ) : ψ.Equipollent φ :=
  (AddAction.orbitRel N (Valuation D)).symm h

@[trans]
theorem Equipollent.trans {ψ χ : Valuation D} (h₁ : φ.Equipollent ψ) (h₂ : ψ.Equipollent χ) :
    φ.Equipollent χ :=
  (AddAction.orbitRel N (Valuation D)).trans h₂ h₁

variable (D) in
/-- Equipollence is an equivalence relation on the valuations of a root datum. -/
theorem equivalence_equipollent : Equivalence (Equipollent (D := D)) :=
  ⟨Equipollent.refl, Equipollent.symm, Equipollent.trans⟩

/-! ### Compatibility with a map from the torus -/

variable (φ)

/-- A valuation is compatible with a map `ν : T → N` if conjugation by `z ∈ T` lowers each
`φ a` by `a (ν z)`: `φ a (z u z⁻¹) = φ a u - a (ν z)`. For the torus valuation map
`ν` of a reductive group over a valued field, this is the compatibility of `φ` with the
valuation of the field. -/
def IsCompatible (ν : D.T → N) : Prop :=
  ∀ (i : ι) (z : D.T) (u : D.U i),
    φ i ⟨z * u * (z : G)⁻¹, D.mul_mul_inv_mem_U z.2 u.2⟩ = φ i u - (P.root' i (ν z) : WithTop ℝ)

/-- Compatibility with `ν`, elementwise: `φ a (z u z⁻¹) = φ a u - a (ν z)` for `z ∈ T`. -/
theorem isCompatible_iff {ν : D.T → N} :
    φ.IsCompatible ν ↔ ∀ (i : ι) (z : D.T) (u : D.U i),
      φ i ⟨z * u * (z : G)⁻¹, D.mul_mul_inv_mem_U z.2 u.2⟩ =
        φ i u - (P.root' i (ν z) : WithTop ℝ) :=
  Iff.rfl

variable {φ} in
/-- If `φ` is compatible with `ν`, conjugation by `z ∈ T` lowers `φ a` by `a (ν z)`. -/
theorem IsCompatible.apply_conj {ν : D.T → N} (h : φ.IsCompatible ν) (z : D.T) (u : D.U i) :
    φ i ⟨z * u * (z : G)⁻¹, D.mul_mul_inv_mem_U z.2 u.2⟩ =
      φ i u - (P.root' i (ν z) : WithTop ℝ) :=
  h i z u

/-- A valuation is compatible with `ν` if and only if each `z ∈ T` conjugates the filtration
subgroup `U (a, k)` onto `U (a, k - a (ν z))`. -/
theorem isCompatible_iff_filtration {ν : D.T → N} :
    φ.IsCompatible ν ↔ ∀ (i : ι) (z : D.T) (k : ℝ),
      ConjAct.toConjAct (z : G) • φ.filtration i k = φ.filtration i (k - P.root' i (ν z)) := by
  constructor
  · intro h i z k
    ext g
    rw [Subgroup.mem_conjAct_smul_iff]
    by_cases hg : g ∈ D.U i
    · have hu : (z : G)⁻¹ * g * z ∈ D.U i := D.inv_mul_mul_mem_U z.2 hg
      have hc := h.apply_conj z ⟨_, hu⟩
      rw [show (⟨z * ((z : G)⁻¹ * g * z) * (z : G)⁻¹, _⟩ : D.U i) = ⟨g, hg⟩ from
        Subtype.ext (by group)] at hc
      have e₁ : (z : G)⁻¹ * g * z ∈ φ.filtration i k ↔ (k : WithTop ℝ) ≤ φ i ⟨_, hu⟩ :=
        φ.coe_mem_filtration_iff ⟨_, hu⟩
      have e₂ : g ∈ φ.filtration i (k - P.root' i (ν z)) ↔
          ((k - P.root' i (ν z) : ℝ) : WithTop ℝ) ≤ φ i ⟨g, hg⟩ :=
        φ.coe_mem_filtration_iff ⟨g, hg⟩
      rw [e₁, e₂, hc, WithTop.coe_sub_le_sub_coe_iff]
    · refine iff_of_false (fun hk ↦ hg ?_) fun hk ↦ hg (φ.filtration_le_U i _ hk)
      simpa [mul_assoc] using D.mul_mul_inv_mem_U z.2 (φ.filtration_le_U i k hk)
  · refine fun h ↦ φ.isCompatible_iff.mpr fun i z u ↦ ?_
    refine WithTop.eq_of_forall_coe_le_iff fun k ↦ ?_
    have key : (z * u * (z : G)⁻¹ : G) ∈ φ.filtration i k ↔
        (u : G) ∈ φ.filtration i (k + P.root' i (ν z)) := by
      have := h i z (k + P.root' i (ν z))
      rw [add_sub_cancel_right] at this
      rw [← this, Subgroup.mem_conjAct_smul_iff,
        show (z : G)⁻¹ * (z * u * (z : G)⁻¹) * z = u by group]
    have e : (z * u * (z : G)⁻¹ : G) ∈ φ.filtration i k ↔
        (k : WithTop ℝ) ≤ φ i ⟨z * u * (z : G)⁻¹, D.mul_mul_inv_mem_U z.2 u.2⟩ :=
      φ.coe_mem_filtration_iff ⟨_, D.mul_mul_inv_mem_U z.2 u.2⟩
    rw [← e, key, coe_mem_filtration_iff, ← WithTop.coe_sub_le_sub_coe_iff (c := P.root' i (ν z)),
      add_sub_cancel_right]

/-- Compatibility is invariant under shifts. -/
@[simp]
theorem isCompatible_shift_iff {ν : D.T → N} (v : N) :
    (φ.shift v).IsCompatible ν ↔ φ.IsCompatible ν := by
  simp only [isCompatible_iff_filtration, filtration_shift]
  refine forall_congr' fun i ↦ forall_congr' fun z ↦ ⟨fun h k ↦ ?_, fun h k ↦ ?_⟩
  · convert h (k + P.root' i v) using 2 <;> ring_nf
  · rw [h]
    ring_nf

/-- The sign of a compatible map is forced: if `φ` is compatible with both `ν` and `-ν`, then
every root vanishes on every `ν z`. -/
theorem IsCompatible.root'_eq_zero_of_neg {ν : D.T → N} (h : φ.IsCompatible ν)
    (h' : φ.IsCompatible (-ν)) (i : ι) (z : D.T) : P.root' i (ν z) = 0 := by
  obtain ⟨k, u, hu⟩ := (φ.valueSet_nontrivial i).nonempty
  have e := (h.apply_conj z u).symm.trans (h'.apply_conj z u)
  rw [hu, Pi.neg_apply, map_neg] at e
  norm_cast at e
  linarith

end Valuation

end TauCeti.BruhatTits
