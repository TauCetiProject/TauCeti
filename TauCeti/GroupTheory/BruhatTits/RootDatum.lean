public import Mathlib.LinearAlgebra.RootSystem.Defs

/-!
# Root data in a group in the sense of Bruhat–Tits

Let `Φ` be a (possibly non-reduced) root system, given as a root pairing `P` over a linearly
ordered field. A *root datum of type `Φ`* in a group `G` consists of a subgroup `T`, a nontrivial
*root subgroup* `U a` and a *reflection coset* `M a ⊆ G` for each root `a`, subject to the axioms
(DR1)–(DR6) of Bruhat–Tits:

* (DR1) each `U a` is a nontrivial subgroup;
* (DR2) `[U a, U b]` lies in the subgroup generated by the `U (p a + q b)` with `p, q ≥ 1`, unless
  `b` is a negative multiple of `a`;
* (DR3) if `2 a` is a root, then `U (2 a)` is a proper subgroup of `U a`;
* (DR4) `M a` is a right coset `T m` and `U (-a) \ {1} ⊆ U a * M a * U a`;
* (DR5) each `m ∈ M a` conjugates `U b` onto `U (s_a b)`;
* (DR6) `T U⁺ ∩ U⁻ = {1}`, where `U⁺` and `U⁻` are generated by the root subgroups of the roots
  that are positive, resp. negative, on a chosen regular vector.

This structure is the abstract input of Bruhat–Tits theory: the rational points of a reductive
group over any field carry such a datum, and valuations of it give apartments and buildings.

From the axioms we derive that `T` normalizes every root subgroup (`RootDatum.le_normalizer`),
that opposite root subgroups differ (`RootDatum.U_ne_of_root_eq_neg`), that every reflection
coset is stable under inversion (`RootDatum.inv_mem_reflectionCoset`) and that `T` is normal in
the subgroup `N` generated by `T` and the reflection cosets (`RootDatum.T_normal_weylNormalizer`).
The last two rest on `RootDatum.eq_one_of_mem_normalizer`: an element of `U a` normalizing
`U (-a)` is trivial. It implies that an element of `U a * M a * U a` exchanging `U a` and
`U (-a)` by conjugation already lies in `M a`.

## Main definitions

* `TauCeti.BruhatTits.RootDatum`: a root datum of type `P` in a group `G`.
* `TauCeti.BruhatTits.RootDatum.positiveSubgroup`, `negativeSubgroup`: the subgroups `U⁺` and `U⁻`.
* `TauCeti.BruhatTits.RootDatum.IsGenerating`: `T` and the root subgroups generate `G`.
* `TauCeti.BruhatTits.RootDatum.weylNormalizer`: the subgroup `N` generated by `T` and the
  reflection cosets.

## References

* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. I*, Publ. Math. IHÉS 41 (1972),
  Définition 6.1.1, p. 107, and 6.1.2, pp. 108–109.
-/

public section

open scoped Pointwise

namespace TauCeti.BruhatTits

variable {ι R M N : Type*} [Field R] [LinearOrder R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- A root datum of type `P` in the group `G` in the sense of Bruhat–Tits: a subgroup `T`, root
subgroups `U i` and reflection cosets `reflectionCoset i` indexed by the roots of `P`, and a
vector `positiveVector` of the coroot space, regular for the roots, which specifies the positive
roots, satisfying the axioms (DR1)–(DR6). The root of index `P.reflectionPerm i i` is `-P.root i`.
-/
structure RootDatum (P : RootPairing ι R M N) (G : Type*) [Group G] where
  /-- The subgroup `T` of the datum. -/
  T : Subgroup G
  /-- The root subgroup `U a` attached to each root `a`. -/
  U : ι → Subgroup G
  /-- The reflection coset `M a`, a right coset of `T`, attached to each root `a`. -/
  reflectionCoset : ι → Set G
  /-- A regular vector of the coroot space; the positive roots are those positive on it. -/
  positiveVector : N
  /-- (DR1) Every root subgroup is nontrivial. -/
  U_ne_bot (i : ι) : U i ≠ ⊥
  /-- (DR2) Commutators of root subgroups of non-opposite roots `a`, `b` lie in the subgroup
  generated by the root subgroups of the roots `p a + q b` with `p, q ≥ 1`. -/
  commutator_le (i j : ι) (hij : ∀ c : R, 0 < c → P.root j ≠ -(c • P.root i)) :
    ⁅U i, U j⁆ ≤
      ⨆ (k) (_ : ∃ p q : ℕ, 0 < p ∧ 0 < q ∧ P.root k = p • P.root i + q • P.root j), U k
  /-- (DR3) If `2 a` is a root, then `U (2 a) ≤ U a`. -/
  le_of_root_eq_two_smul (i j : ι) (h : P.root j = (2 : R) • P.root i) : U j ≤ U i
  /-- (DR3) If `2 a` is a root, then `U (2 a) ≠ U a`. -/
  ne_of_root_eq_two_smul (i j : ι) (h : P.root j = (2 : R) • P.root i) : U j ≠ U i
  /-- (DR4) Each reflection coset is a right coset `T m` of `T`. -/
  reflectionCoset_eq (i : ι) : ∃ m : G, reflectionCoset i = MulOpposite.op m • (T : Set G)
  /-- (DR4) Every nontrivial element of `U (-a)` lies in `U a * M a * U a`. -/
  bruhat (i : ι) :
    (U (P.reflectionPerm i i) : Set G) \ {1} ⊆ (U i : Set G) * reflectionCoset i * U i
  /-- (DR5) Each element of `M a` conjugates `U b` onto `U (s_a b)`. -/
  reflection_conjugates (i : ι) :
    ∀ m ∈ reflectionCoset i, ∀ j, ConjAct.toConjAct m • U j = U (P.reflectionPerm i j)
  /-- (DR6) The vector `positiveVector` is regular: no root vanishes on it. -/
  positiveVector_regular (i : ι) : P.root' i positiveVector ≠ 0
  /-- (DR6) `T U⁺ ∩ U⁻ = {1}`. -/
  bruhat_separation :
    ∀ t ∈ T, ∀ u ∈ ⨆ (i) (_ : 0 < P.root' i positiveVector), U i,
      t * u ∈ ⨆ (i) (_ : P.root' i positiveVector < 0), U i → t * u = 1

namespace RootDatum

variable {P : RootPairing ι R M N} {G : Type*} [Group G] (D : RootDatum P G)

/-- The subgroup `U⁺` generated by the root subgroups of the positive roots. -/
def positiveSubgroup : Subgroup G :=
  ⨆ (i) (_ : 0 < P.root' i D.positiveVector), D.U i

/-- The subgroup `U⁻` generated by the root subgroups of the negative roots. -/
def negativeSubgroup : Subgroup G :=
  ⨆ (i) (_ : P.root' i D.positiveVector < 0), D.U i

/-- A root datum is generating if `T` and the root subgroups generate the whole group. -/
def IsGenerating : Prop :=
  D.T ⊔ ⨆ i, D.U i = ⊤

/-- The subgroup `N` generated by `T` and the reflection cosets. -/
def weylNormalizer : Subgroup G :=
  Subgroup.closure ((D.T : Set G) ∪ ⋃ i, D.reflectionCoset i)

variable {D}

theorem positiveSubgroup_def :
    D.positiveSubgroup = ⨆ (i) (_ : 0 < P.root' i D.positiveVector), D.U i :=
  (rfl)

theorem negativeSubgroup_def :
    D.negativeSubgroup = ⨆ (i) (_ : P.root' i D.positiveVector < 0), D.U i :=
  (rfl)

theorem weylNormalizer_def :
    D.weylNormalizer = Subgroup.closure ((D.T : Set G) ∪ ⋃ i, D.reflectionCoset i) :=
  (rfl)

theorem U_le_positiveSubgroup {i : ι} (hi : 0 < P.root' i D.positiveVector) :
    D.U i ≤ D.positiveSubgroup :=
  le_iSup₂ (f := fun i (_ : 0 < P.root' i D.positiveVector) ↦ D.U i) i hi

theorem U_le_negativeSubgroup {i : ι} (hi : P.root' i D.positiveVector < 0) :
    D.U i ≤ D.negativeSubgroup :=
  le_iSup₂ (f := fun i (_ : P.root' i D.positiveVector < 0) ↦ D.U i) i hi

theorem positiveSubgroup_le_iff {H : Subgroup G} :
    D.positiveSubgroup ≤ H ↔ ∀ i, 0 < P.root' i D.positiveVector → D.U i ≤ H := by
  simp [positiveSubgroup]

theorem negativeSubgroup_le_iff {H : Subgroup G} :
    D.negativeSubgroup ≤ H ↔ ∀ i, P.root' i D.positiveVector < 0 → D.U i ≤ H := by
  simp [negativeSubgroup]

/-- (DR6) `T U⁺ ∩ U⁻ = {1}`, stated through `positiveSubgroup` and `negativeSubgroup`. -/
theorem eq_one_of_mul_mem_negativeSubgroup {t u : G} (ht : t ∈ D.T)
    (hu : u ∈ D.positiveSubgroup) (htu : t * u ∈ D.negativeSubgroup) : t * u = 1 :=
  D.bruhat_separation t ht u hu htu

theorem isGenerating_iff : D.IsGenerating ↔ D.T ⊔ ⨆ i, D.U i = ⊤ :=
  Iff.rfl

theorem weylNormalizer_le_iff {H : Subgroup G} :
    D.weylNormalizer ≤ H ↔ D.T ≤ H ∧ ∀ i, D.reflectionCoset i ⊆ H := by
  simp [weylNormalizer, Subgroup.closure_le, Set.union_subset_iff, Set.iUnion_subset_iff]

theorem T_le_weylNormalizer : D.T ≤ D.weylNormalizer := fun _ ht ↦
  Subgroup.subset_closure (Or.inl ht)

theorem reflectionCoset_subset_weylNormalizer (i : ι) :
    D.reflectionCoset i ⊆ D.weylNormalizer := fun _ hm ↦
  Subgroup.subset_closure (Or.inr (Set.mem_iUnion_of_mem i hm))

/-! ### Reflection cosets -/

theorem reflectionCoset_nonempty (i : ι) : (D.reflectionCoset i).Nonempty := by
  obtain ⟨m, hm⟩ := D.reflectionCoset_eq i
  exact ⟨m, by simp [hm, mem_rightCoset_iff]⟩

/-- Two elements of the same reflection coset differ by an element of `T`. -/
theorem mul_inv_mem_T {i : ι} {m m' : G} (hm : m ∈ D.reflectionCoset i)
    (hm' : m' ∈ D.reflectionCoset i) : m' * m⁻¹ ∈ D.T := by
  obtain ⟨m₀, h₀⟩ := D.reflectionCoset_eq i
  rw [h₀, mem_rightCoset_iff] at hm hm'
  simpa [mul_assoc] using D.T.mul_mem hm' (D.T.inv_mem hm)

theorem mul_mem_reflectionCoset {i : ι} {t m : G} (ht : t ∈ D.T)
    (hm : m ∈ D.reflectionCoset i) : t * m ∈ D.reflectionCoset i := by
  obtain ⟨m₀, h₀⟩ := D.reflectionCoset_eq i
  rw [h₀, mem_rightCoset_iff] at hm ⊢
  simpa [mul_assoc] using D.T.mul_mem ht hm

/-- Each element of `M a` conjugates `U (-a)` onto `U a`. -/
theorem conj_smul_U_neg {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    ConjAct.toConjAct m • D.U (P.reflectionPerm i i) = D.U i := by
  rw [D.reflection_conjugates i m hm, P.reflectionPerm_self]

/-! ### The torus normalizes the root subgroups -/

/-- `T` normalizes every root subgroup. -/
theorem le_normalizer (i : ι) : D.T ≤ Subgroup.normalizer (D.U i : Set G) := by
  intro t ht
  obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
  rw [← Subgroup.conjAct_pointwise_smul_iff]
  have h := D.conj_smul_U_neg (D.mul_mem_reflectionCoset ht hm)
  rwa [ConjAct.toConjAct_mul, mul_smul, D.conj_smul_U_neg hm] at h

theorem conj_smul_U_of_mem_T {i : ι} {t : G} (ht : t ∈ D.T) :
    ConjAct.toConjAct t • D.U i = D.U i :=
  Subgroup.conjAct_pointwise_smul_eq_self (D.le_normalizer i ht)

theorem mul_mul_inv_mem_U {i : ι} {t u : G} (ht : t ∈ D.T) (hu : u ∈ D.U i) :
    t * u * t⁻¹ ∈ D.U i :=
  (Subgroup.mem_normalizer_iff.mp (D.le_normalizer i ht) u).mp hu

theorem inv_mul_mul_mem_U {i : ι} {t u : G} (ht : t ∈ D.T) (hu : u ∈ D.U i) :
    t⁻¹ * u * t ∈ D.U i := by
  simpa using D.mul_mul_inv_mem_U (D.T.inv_mem ht) hu

/-- Multiplying an element of `U a * M a * U a` on both sides by elements of `U a` stays in
`U a * M a * U a`. -/
private theorem mul_mul_mem_mul {i : ι} {g x y : G} (hx : x ∈ D.U i) (hy : y ∈ D.U i)
    (hg : g ∈ (D.U i : Set G) * D.reflectionCoset i * D.U i) :
    x * g * y ∈ (D.U i : Set G) * D.reflectionCoset i * D.U i := by
  obtain ⟨_, ⟨x', hx', m, hm, rfl⟩, y', hy', rfl⟩ := hg
  exact ⟨x * x' * m, ⟨x * x', mul_mem hx hx', m, hm, rfl⟩, y' * y, mul_mem hy' hy, by group⟩

/-- Some nontrivial element of `U (-a)` decomposes as `x * m * y` with `x, y ∈ U a` and
`m ∈ M a`. -/
private theorem exists_mem_bruhat (i : ι) :
    ∃ u ∈ D.U (P.reflectionPerm i i), u ≠ 1 ∧ ∃ x ∈ D.U i, ∃ m ∈ D.reflectionCoset i,
      ∃ y ∈ D.U i, u = x * m * y := by
  obtain ⟨⟨u, hu⟩, hne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot (P.reflectionPerm i i))
  have hne' : u ≠ 1 := fun h ↦ hne (Subtype.ext h)
  obtain ⟨_, ⟨x, hx, m, hm, rfl⟩, y, hy, hxy⟩ := D.bruhat i ⟨hu, hne'⟩
  exact ⟨u, hu, hne', x, hx, m, hm, y, hy, hxy.symm⟩

/-! ### Opposite root subgroups -/

section Ordered

variable [IsStrictOrderedRing R]

/-- The root subgroups of opposite roots are different. -/
theorem U_ne_of_root_eq_neg {i j : ι} (h : P.root j = -P.root i) : D.U j ≠ D.U i := by
  intro hU
  have hv : P.root' j D.positiveVector = -P.root' i D.positiveVector := by
    simp [RootPairing.root', h]
  refine D.U_ne_bot i (eq_bot_iff.mpr fun u hu ↦ ?_)
  have hu' : u ∈ D.U j := hU ▸ hu
  rcases (D.positiveVector_regular i).lt_or_gt with hi | hi
  · have hj : 0 < P.root' j D.positiveVector := by rw [hv]; exact neg_pos.mpr hi
    simpa using D.eq_one_of_mul_mem_negativeSubgroup D.T.one_mem (U_le_positiveSubgroup hj hu')
      (by simpa using U_le_negativeSubgroup hi hu)
  · have hj : P.root' j D.positiveVector < 0 := by rw [hv]; exact neg_neg_iff_pos.mpr hi
    simpa using D.eq_one_of_mul_mem_negativeSubgroup D.T.one_mem (U_le_positiveSubgroup hi hu)
      (by simpa using U_le_negativeSubgroup hj hu')

/-- An element of `U a` that normalizes `U (-a)` is trivial. -/
theorem eq_one_of_mem_normalizer {i : ι} {g : G} (hg : g ∈ D.U i)
    (hn : g ∈ Subgroup.normalizer (D.U (P.reflectionPerm i i) : Set G)) : g = 1 := by
  by_contra hne
  set j := P.reflectionPerm i i
  have hji : P.reflectionPerm j j = i := P.indexNeg.neg_neg i
  have hg' : g ∈ (D.U (P.reflectionPerm j j) : Set G) \ {1} := ⟨by rwa [hji], hne⟩
  obtain ⟨_, ⟨p, hp, n, hn', rfl⟩, q, hq, hpq⟩ := D.bruhat j hg'
  have hnorm : n ∈ Subgroup.normalizer (D.U j : Set G) := by
    have hn_eq : n = p⁻¹ * g * q⁻¹ := by rw [← hpq]; group
    rw [hn_eq]
    exact mul_mem (mul_mem (Subgroup.le_normalizer (inv_mem hp)) hn)
      (Subgroup.le_normalizer (inv_mem hq))
  have h := D.reflection_conjugates j n hn' j
  rw [Subgroup.conjAct_pointwise_smul_eq_self hnorm, hji] at h
  exact D.U_ne_of_root_eq_neg (by simp [j]) h

/-- An element of `U a * M a * U a` that exchanges `U a` and `U (-a)` by conjugation lies in
`M a`. -/
private theorem mem_reflectionCoset_of_mem_mul {i : ι} {g : G}
    (hg : g ∈ (D.U i : Set G) * D.reflectionCoset i * D.U i)
    (h₁ : ConjAct.toConjAct g • D.U i = D.U (P.reflectionPerm i i))
    (h₂ : ConjAct.toConjAct g • D.U (P.reflectionPerm i i) = D.U i) :
    g ∈ D.reflectionCoset i := by
  obtain ⟨_, ⟨x, hx, m, hm, rfl⟩, y, hy, rfl⟩ := hg
  set j := P.reflectionPerm i i
  have hji : P.reflectionPerm j j = i := P.indexNeg.neg_neg i
  have hm₁ := D.conj_smul_U_neg hm
  have hm₂ : ConjAct.toConjAct m • D.U i = D.U j := D.reflection_conjugates i m hm i
  -- `h = x * m * y * m⁻¹` normalizes `U a` and `U (-a)`, and lies in `U a * U (-a)`.
  set h := x * m * y * m⁻¹
  have hm₁' : (ConjAct.toConjAct m)⁻¹ • D.U i = D.U j := by rw [inv_smul_eq_iff, hm₁]
  have hm₂' : (ConjAct.toConjAct m)⁻¹ • D.U j = D.U i := by rw [inv_smul_eq_iff, hm₂]
  have hh₁ : h ∈ Subgroup.normalizer (D.U i : Set G) := by
    rw [← Subgroup.conjAct_pointwise_smul_iff, ConjAct.toConjAct_mul, mul_smul,
      ConjAct.toConjAct_inv, hm₁', h₂]
  have hh₂ : h ∈ Subgroup.normalizer (D.U j : Set G) := by
    rw [← Subgroup.conjAct_pointwise_smul_iff, ConjAct.toConjAct_mul, mul_smul,
      ConjAct.toConjAct_inv, hm₂', h₁]
  have hz : m * y * m⁻¹ ∈ D.U j := by
    rw [← hm₂, ← ConjAct.toConjAct_smul]
    exact Subgroup.smul_mem_pointwise_smul _ _ _ hy
  have hz₁ : m * y * m⁻¹ = 1 := by
    refine D.eq_one_of_mem_normalizer hz ?_
    rw [hji]
    have : m * y * m⁻¹ = x⁻¹ * h := by simp only [h]; group
    rw [this]
    exact mul_mem (Subgroup.le_normalizer (inv_mem hx)) hh₁
  have hx₁ : x = 1 := by
    refine D.eq_one_of_mem_normalizer hx ?_
    have : h = x := by
      calc h = x * (m * y * m⁻¹) := by simp only [h]; group
        _ = x := by rw [hz₁, mul_one]
    rwa [← this]
  have hy₁ : y = 1 := by simpa using hz₁
  simpa [hx₁, hy₁] using hm

/-- `T` meets every root subgroup trivially. -/
@[simp]
theorem T_inf_U_eq_bot (i : ι) : D.T ⊓ D.U i = ⊥ :=
  eq_bot_iff.mpr fun _ hg ↦ D.eq_one_of_mem_normalizer hg.2 (D.le_normalizer _ hg.1)

/-! ### Normality of `T` in `N` -/

/-- Each element of a reflection coset normalizes `T`, in the form `m T m⁻¹ ⊆ T`. -/
theorem mul_mul_inv_mem_T {i : ι} {m t : G} (hm : m ∈ D.reflectionCoset i) (ht : t ∈ D.T) :
    m * t * m⁻¹ ∈ D.T := by
  obtain ⟨u, hu, hne, x, hx, m₁, hm₁, y, hy, rfl⟩ := D.exists_mem_bruhat i
  set j := P.reflectionPerm i i
  -- The conjugate `t⁻¹ m₁ t` lies in `U a * M a * U a` and exchanges `U a` and `U (-a)`.
  have hconj : t⁻¹ * m₁ * t ∈ D.reflectionCoset i := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ ?_ ?_
    · have hu' : t⁻¹ * (x * m₁ * y) * t ∈ (D.U j : Set G) \ {1} := by
        refine ⟨D.inv_mul_mul_mem_U ht hu, fun h ↦ hne ?_⟩
        have : x * m₁ * y = t * (t⁻¹ * (x * m₁ * y) * t) * t⁻¹ := by group
        rw [this, h, mul_one, mul_inv_cancel]
      have hx' : t⁻¹ * x⁻¹ * t ∈ D.U i := D.inv_mul_mul_mem_U ht (inv_mem hx)
      have hy' : t⁻¹ * y⁻¹ * t ∈ D.U i := D.inv_mul_mul_mem_U ht (inv_mem hy)
      have := D.mul_mul_mem_mul hx' hy' (D.bruhat i hu')
      convert this using 1
      group
    · rw [ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul,
        D.conj_smul_U_of_mem_T ht, D.reflection_conjugates i m₁ hm₁ i,
        D.conj_smul_U_of_mem_T (D.T.inv_mem ht)]
    · rw [ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul,
        D.conj_smul_U_of_mem_T ht, D.conj_smul_U_neg hm₁, D.conj_smul_U_of_mem_T (D.T.inv_mem ht)]
  have h₁ : m₁ * t * m₁⁻¹ ∈ D.T := by
    have := D.T.mul_mem ht (D.mul_inv_mem_T hm₁ hconj)
    simpa [mul_assoc] using this
  -- A general element of `M a` is `s m₁` with `s ∈ T`.
  have hs := D.mul_inv_mem_T hm₁ hm
  have : m * t * m⁻¹ = (m * m₁⁻¹) * (m₁ * t * m₁⁻¹) * (m * m₁⁻¹)⁻¹ := by group
  rw [this]
  exact D.T.mul_mem (D.T.mul_mem hs h₁) (D.T.inv_mem hs)

/-- Each reflection coset is stable under inversion. -/
theorem inv_mem_reflectionCoset {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    m⁻¹ ∈ D.reflectionCoset i := by
  obtain ⟨u, hu, hne, x, hx, m₁, hm₁, y, hy, rfl⟩ := D.exists_mem_bruhat i
  set j := P.reflectionPerm i i
  have hinv : m₁⁻¹ ∈ D.reflectionCoset i := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ ?_ ?_
    · have hu' : (x * m₁ * y)⁻¹ ∈ (D.U j : Set G) \ {1} := ⟨inv_mem hu, inv_ne_one.mpr hne⟩
      have := D.mul_mul_mem_mul hy hx (D.bruhat i hu')
      convert this using 1
      group
    · rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, D.conj_smul_U_neg hm₁]
    · rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, D.reflection_conjugates i m₁ hm₁ i]
  -- A general element of `M a` is `s m₁` with `s ∈ T`, and `m₁⁻¹ s⁻¹ m₁ ∈ T`.
  have hs := D.mul_inv_mem_T hm₁ hm
  have hconj := D.mul_mul_inv_mem_T hinv (D.T.inv_mem hs)
  have : m⁻¹ = (m₁⁻¹ * (m * m₁⁻¹)⁻¹ * m₁⁻¹⁻¹) * m₁⁻¹ := by group
  rw [this]
  exact D.mul_mem_reflectionCoset hconj hinv

/-- Each element of a reflection coset normalizes `T`. -/
theorem reflectionCoset_subset_normalizer (i : ι) :
    D.reflectionCoset i ⊆ Subgroup.normalizer (D.T : Set G) := by
  intro m hm
  refine Subgroup.mem_normalizer_iff.mpr fun t ↦ ⟨D.mul_mul_inv_mem_T hm, fun ht ↦ ?_⟩
  simpa [mul_assoc] using D.mul_mul_inv_mem_T (D.inv_mem_reflectionCoset hm) ht

theorem weylNormalizer_le_normalizer : D.weylNormalizer ≤ Subgroup.normalizer (D.T : Set G) :=
  weylNormalizer_le_iff.mpr ⟨Subgroup.le_normalizer, D.reflectionCoset_subset_normalizer⟩

/-- `T` is a normal subgroup of the subgroup `N` generated by `T` and the reflection cosets. -/
theorem T_normal_weylNormalizer : (D.T.subgroupOf D.weylNormalizer).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer D.T_le_weylNormalizer).mpr
    D.weylNormalizer_le_normalizer

end Ordered

/-! ### Root data of rank zero -/

section RankZero

variable [IsEmpty ι]

variable (P G) in
/-- With no roots, every subgroup `T` is a root datum: the axioms (DR1)–(DR6) are empty. -/
def ofIsEmpty (T : Subgroup G) (v : N) : RootDatum P G where
  T := T
  U := isEmptyElim
  reflectionCoset := isEmptyElim
  positiveVector := v
  U_ne_bot := isEmptyElim
  commutator_le := isEmptyElim
  le_of_root_eq_two_smul := isEmptyElim
  ne_of_root_eq_two_smul := isEmptyElim
  reflectionCoset_eq := isEmptyElim
  bruhat := isEmptyElim
  reflection_conjugates := isEmptyElim
  positiveVector_regular := isEmptyElim
  bruhat_separation _ _ _ _ htu := by simpa using htu

@[simp]
theorem ofIsEmpty_T (T : Subgroup G) (v : N) : (ofIsEmpty P G T v).T = T :=
  (rfl)

/-- With no roots, the subgroup `N` is `T`. -/
@[simp]
theorem weylNormalizer_eq_T_of_isEmpty : D.weylNormalizer = D.T :=
  le_antisymm (weylNormalizer_le_iff.mpr ⟨le_rfl, isEmptyElim⟩) D.T_le_weylNormalizer

/-- With no roots, a root datum is generating if and only if `T` is the whole group. -/
@[simp]
theorem isGenerating_iff_of_isEmpty : D.IsGenerating ↔ D.T = ⊤ := by
  simp [isGenerating_iff]

end RankZero

end RootDatum

end TauCeti.BruhatTits
