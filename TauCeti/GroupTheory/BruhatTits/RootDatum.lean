/-!
# Root data in a group in the sense of Bruhat–Tits

Let `Φ` be a (possibly non-reduced) root system, given as a root pairing `P` over a linearly
ordered field. A *root datum of type `Φ`* in a group `G` consists of a subgroup `T`, a nontrivial
*root subgroup* `U a` and a *reflection coset* `M a ⊆ G` for each root `a`, subject to the axioms
(DR1)–(DR6) of Bruhat–Tits:

* (DR1) each `U a` is a nontrivial subgroup;
* (DR2) `[U a, U b]` lies in the subgroup generated by the `U (p a + q b)` with `p, q ≥ 1`, unless
  `b` is a negative multiple of `a`;
* (DR3) if `2 a` is a root, then `U (2 a)` is a proper subgroup of `U a`;
* (DR4) `M a` is a right coset `T m` and `U (-a) \ {1} ⊆ U a * M a * U a`;
* (DR5) each `m ∈ M a` conjugates `U b` onto `U (s_a b)`;
* (DR6) `T U⁺ ∩ U⁻ = {1}`, where `U⁺` and `U⁻` are generated by the root subgroups of the roots
  that are positive, resp. negative, on a chosen regular vector.

This structure is the abstract input of Bruhat–Tits theory: the rational points of a reductive
group over any field carry such a datum, and valuations of it give apartments and buildings.

From the axioms we derive that `U⁺` and `U⁻` intersect trivially
(`RootDatum.positiveSubgroup_inf_negativeSubgroup`), that `T` normalizes every root subgroup
(`RootDatum.le_normalizer`), that opposite root subgroups differ
(`RootDatum.U_ne_of_root_eq_neg`), that every reflection coset is stable under inversion
(`RootDatum.inv_mem_reflectionCoset`), that opposite and double roots share the same reflection
coset (`RootDatum.reflectionCoset_reflectionPerm_self`,
`RootDatum.reflectionCoset_eq_of_root_eq_two_smul`), that conjugation by `m ∈ M a` maps `M b` into
`M (s_a b)` (`RootDatum.mul_mul_inv_mem_reflectionCoset`), and that `T` is normal in the subgroup
`N` generated by `T` and the reflection cosets (`RootDatum.T_normal_weylNormalizer`).
Each of `inv_mem_reflectionCoset`, `reflectionCoset_reflectionPerm_self`,
`reflectionCoset_eq_of_root_eq_two_smul`, `mul_mul_inv_mem_reflectionCoset`, and
`T_normal_weylNormalizer` rests on `RootDatum.eq_one_of_mem_normalizer`: an element of `U a`
normalizing `U (-a)` is trivial. It implies that an element of `U a * M a * U a` exchanging `U a`
and `U (-a)` by conjugation already lies in `M a`.

## Main definitions

* `TauCeti.BruhatTits.RootDatum`: a root datum of type `P` in a group `G`.
* `TauCeti.BruhatTits.RootDatum.positiveSubgroup`, `negativeSubgroup`: the subgroups `U⁺` and `U⁻`.
* `TauCeti.BruhatTits.RootDatum.borelSubgroup`: the Borel-like subgroup `B = T U⁺`.
* `TauCeti.BruhatTits.RootDatum.generatedSubgroup`: the subgroup generated by `T` and all `U a`.
* `TauCeti.BruhatTits.RootDatum.restrictToGenerated`: the generating root datum in
  `D.generatedSubgroup`.
* `TauCeti.BruhatTits.RootDatum.IsGenerating`: `T` and the root subgroups generate `G`.
* `TauCeti.BruhatTits.RootDatum.weylNormalizer`: the subgroup `N` generated by `T` and the
  reflection cosets.

## References

* F. Bruhat, J. Tits, *Groupes réductifs sur un corps local. I*, Publ. Math. IHÉS 41 (1972),
  Définition 6.1.1, p. 107, and 6.1.2, pp. 108–109.
-/

public section

open scoped Pointwise commutatorElement

namespace TauCeti.BruhatTits

variable {ι R M N : Type*} [Field R] [LinearOrder R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- A root datum of type `P` in the group `G` in the sense of Bruhat–Tits: a subgroup `T`, root
subgroups `U i` and reflection cosets `reflectionCoset i` indexed by the roots of `P`, and a
vector `positiveVector` of the coroot space, regular for the roots, which specifies the positive
roots, satisfying the axioms (DR1)–(DR6). The root of index `P.reflectionPerm i i` is `-P.root i`.
-/
structure RootDatum (P : RootPairing ι R M N) (G : Type*) [Group G] where
  /-- The subgroup `T` of the datum. -/
  T : Subgroup G
  /-- The root subgroup `U a` attached to each root `a`. -/
  U : ι → Subgroup G
  /-- The reflection coset `M a`, a right coset of `T`, attached to each root `a`. -/
  reflectionCoset : ι → Set G
  /-- A regular vector of the coroot space; the positive roots are those positive on it. -/
  positiveVector : N
  /-- (DR1) Every root subgroup is nontrivial. -/
  U_ne_bot (i : ι) : U i ≠ ⊥
  /-- (DR2) Commutators of root subgroups of non-opposite roots `a`, `b` lie in the subgroup
  generated by the root subgroups of the roots `p a + q b` with `p, q ≥ 1`. -/
  commutator_le (i j : ι) (hij : ∀ c : R, 0 < c → P.root j ≠ -(c • P.root i)) :
    ⁅U i, U j⁆ ≤
      ⨆ (k) (_ : ∃ p q : ℕ, 0 < p ∧ 0 < q ∧ P.root k = p • P.root i + q • P.root j), U k
  /-- (DR3) If `2 a` is a root, then `U (2 a) ≤ U a`. -/
  le_of_root_eq_two_smul (i j : ι) (h : P.root j = (2 : R) • P.root i) : U j ≤ U i
  /-- (DR3) If `2 a` is a root, then `U (2 a) ≠ U a`. -/
  ne_of_root_eq_two_smul (i j : ι) (h : P.root j = (2 : R) • P.root i) : U j ≠ U i
  /-- (DR4) Each reflection coset is a right coset `T m` of `T`. -/
  reflectionCoset_eq (i : ι) : ∃ m : G, reflectionCoset i = MulOpposite.op m • (T : Set G)
  /-- (DR4) Every nontrivial element of `U (-a)` lies in `U a * M a * U a`. -/
  bruhat (i : ι) :
    (U (P.reflectionPerm i i) : Set G) \ {1} ⊆ (U i : Set G) * reflectionCoset i * U i
  /-- (DR5) Each element of `M a` conjugates `U b` onto `U (s_a b)`. -/
  reflection_conjugates (i : ι) :
    ∀ m ∈ reflectionCoset i, ∀ j, ConjAct.toConjAct m • U j = U (P.reflectionPerm i j)
  /-- (DR6) The vector `positiveVector` is regular: no root vanishes on it. -/
  positiveVector_regular (i : ι) : P.root' i positiveVector ≠ 0
  /-- (DR6) `T U⁺ ∩ U⁻ = {1}`. -/
  bruhat_separation :
    ∀ t ∈ T, ∀ u ∈ ⨆ (i) (_ : 0 < P.root' i positiveVector), U i,
      t * u ∈ ⨆ (i) (_ : P.root' i positiveVector < 0), U i → t * u = 1

namespace RootDatum

variable {P : RootPairing ι R M N} {G : Type*} [Group G] (D : RootDatum P G)

/-- The subgroup `U⁺` generated by the root subgroups of the positive roots. -/
def positiveSubgroup : Subgroup G :=
  ⨆ (i) (_ : 0 < P.root' i D.positiveVector), D.U i

/-- The subgroup `U⁻` generated by the root subgroups of the negative roots. -/
def negativeSubgroup : Subgroup G :=
  ⨆ (i) (_ : P.root' i D.positiveVector < 0), D.U i

/-- A root datum is generating if `T` and the root subgroups generate the whole group. -/
def IsGenerating : Prop :=
  D.T ⊔ ⨆ i, D.U i = ⊤

/-- The subgroup `N` generated by `T` and the reflection cosets. -/
def weylNormalizer : Subgroup G :=
  Subgroup.closure ((D.T : Set G) ∪ ⋃ i, D.reflectionCoset i)

variable {D}

theorem positiveSubgroup_def :
    D.positiveSubgroup = ⨆ (i) (_ : 0 < P.root' i D.positiveVector), D.U i :=
  (rfl)

theorem negativeSubgroup_def :
    D.negativeSubgroup = ⨆ (i) (_ : P.root' i D.positiveVector < 0), D.U i :=
  (rfl)

theorem weylNormalizer_def :
    D.weylNormalizer = Subgroup.closure ((D.T : Set G) ∪ ⋃ i, D.reflectionCoset i) :=
  (rfl)

theorem U_le_positiveSubgroup {i : ι} (hi : 0 < P.root' i D.positiveVector) :
    D.U i ≤ D.positiveSubgroup :=
  le_iSup₂ (f := fun i (_ : 0 < P.root' i D.positiveVector) ↦ D.U i) i hi

theorem U_le_negativeSubgroup {i : ι} (hi : P.root' i D.positiveVector < 0) :
    D.U i ≤ D.negativeSubgroup :=
  le_iSup₂ (f := fun i (_ : P.root' i D.positiveVector < 0) ↦ D.U i) i hi

theorem positiveSubgroup_le_iff {H : Subgroup G} :
    D.positiveSubgroup ≤ H ↔ ∀ i, 0 < P.root' i D.positiveVector → D.U i ≤ H := by
  simp [positiveSubgroup]

theorem negativeSubgroup_le_iff {H : Subgroup G} :
    D.negativeSubgroup ≤ H ↔ ∀ i, P.root' i D.positiveVector < 0 → D.U i ≤ H := by
  simp [negativeSubgroup]

/-- (DR6) `T U⁺ ∩ U⁻ = {1}`, stated through `positiveSubgroup` and `negativeSubgroup`. -/
theorem eq_one_of_mul_mem_negativeSubgroup {t u : G} (ht : t ∈ D.T)
    (hu : u ∈ D.positiveSubgroup) (htu : t * u ∈ D.negativeSubgroup) : t * u = 1 :=
  D.bruhat_separation t ht u hu htu

variable (D) in
/-- Opposite unipotent subgroups `U⁺` and `U⁻` intersect trivially. -/
@[simp]
theorem positiveSubgroup_inf_negativeSubgroup :
    D.positiveSubgroup ⊓ D.negativeSubgroup = ⊥ :=
  eq_bot_iff.mpr fun _ ⟨hu₁, hu₂⟩ ↦ by
    simpa using D.eq_one_of_mul_mem_negativeSubgroup D.T.one_mem hu₁ (by simpa using hu₂)

theorem isGenerating_iff : D.IsGenerating ↔ D.T ⊔ ⨆ i, D.U i = ⊤ :=
  Iff.rfl

theorem weylNormalizer_le_iff {H : Subgroup G} :
    D.weylNormalizer ≤ H ↔ D.T ≤ H ∧ ∀ i, D.reflectionCoset i ⊆ H := by
  simp [weylNormalizer, Subgroup.closure_le, Set.union_subset_iff, Set.iUnion_subset_iff]

theorem T_le_weylNormalizer : D.T ≤ D.weylNormalizer := fun _ ht ↦
  Subgroup.subset_closure (Or.inl ht)

theorem reflectionCoset_subset_weylNormalizer (i : ι) :
    D.reflectionCoset i ⊆ D.weylNormalizer := fun _ hm ↦
  Subgroup.subset_closure (Or.inr (Set.mem_iUnion_of_mem i hm))

/-- Induction principle for `D.weylNormalizer` from `T` and the reflection cosets `M i`. -/
@[elab_as_elim]
theorem weylNormalizer_induction {motive : D.weylNormalizer → Prop}
    (torus : ∀ t (ht : t ∈ D.T), motive ⟨t, D.T_le_weylNormalizer ht⟩)
    (reflection : ∀ i m (hm : m ∈ D.reflectionCoset i),
      motive ⟨m, D.reflectionCoset_subset_weylNormalizer i hm⟩)
    (one : motive 1) (mul : ∀ x y, motive x → motive y → motive (x * y))
    (inv : ∀ x, motive x → motive x⁻¹) (n : D.weylNormalizer) : motive n := by
  suffices ∀ g (hg : g ∈ Subgroup.closure ((D.T : Set G) ∪ ⋃ i, D.reflectionCoset i)),
      motive ⟨g, D.weylNormalizer_def.symm ▸ hg⟩ from
    this n.val (D.weylNormalizer_def ▸ n.property)
  intro g hg; induction hg using Subgroup.closure_induction with
  | mem x hx =>
    exact hx.elim (torus x) fun hM ↦ let ⟨i, hm⟩ := Set.mem_iUnion.mp hM; reflection i x hm
  | one => exact one
  | mul _ _ _ _ ihx ihy => exact mul _ _ ihx ihy
  | inv _ _ ih => exact inv _ ih

/-! ### Reflection cosets -/

theorem reflectionCoset_nonempty (i : ι) : (D.reflectionCoset i).Nonempty := by
  obtain ⟨m, hm⟩ := D.reflectionCoset_eq i
  exact ⟨m, by simp [hm, mem_rightCoset_iff]⟩

/-- Two elements of the same reflection coset differ by an element of `T`. -/
theorem mul_inv_mem_T {i : ι} {m m' : G} (hm : m ∈ D.reflectionCoset i)
    (hm' : m' ∈ D.reflectionCoset i) : m' * m⁻¹ ∈ D.T := by
  obtain ⟨m₀, h₀⟩ := D.reflectionCoset_eq i
  rw [h₀, mem_rightCoset_iff] at hm hm'
  simpa [mul_assoc] using D.T.mul_mem hm' (D.T.inv_mem hm)

theorem mul_mem_reflectionCoset {i : ι} {t m : G} (ht : t ∈ D.T)
    (hm : m ∈ D.reflectionCoset i) : t * m ∈ D.reflectionCoset i := by
  obtain ⟨m₀, h₀⟩ := D.reflectionCoset_eq i
  rw [h₀, mem_rightCoset_iff] at hm ⊢
  simpa [mul_assoc] using D.T.mul_mem ht hm

/-- Each element of `M a` conjugates `U (-a)` onto `U a`. -/
theorem conj_smul_U_neg {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    ConjAct.toConjAct m • D.U (P.reflectionPerm i i) = D.U i := by
  rw [D.reflection_conjugates i m hm, P.reflectionPerm_self]

/-- Each element `m ∈ M a` conjugates `U b` into `U (s_a b)` (`m u m⁻¹ ∈ U (s_a b)`). -/
theorem mul_mul_inv_mem_U_reflectionCoset {i j : ι} {m u : G}
    (hm : m ∈ D.reflectionCoset i) (hu : u ∈ D.U j) :
    m * u * m⁻¹ ∈ D.U (P.reflectionPerm i j) :=
  D.reflection_conjugates i m hm j ▸ Subgroup.smul_mem_pointwise_smul _ _ _ hu

/-- Conjugating `u ∈ U b` by `m⁻¹` for `m ∈ M a` (`m⁻¹ u m`) lands in `U (s_a b)`. -/
theorem inv_mul_mul_mem_U_reflectionCoset {i j : ι} {m u : G}
    (hm : m ∈ D.reflectionCoset i) (hu : u ∈ D.U j) :
    m⁻¹ * u * m ∈ D.U (P.reflectionPerm i j) := by
  have h := D.reflection_conjugates i m hm (P.reflectionPerm i j)
  rw [P.reflectionPerm_self] at h
  rwa [← h, Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ← ConjAct.toConjAct_inv,
    ConjAct.toConjAct_smul, inv_inv] at hu

/-- Each element of `M a` conjugates `U (-a)` into `U a`. -/
theorem mul_mul_inv_mem_U_of_mem_reflectionCoset {i : ι} {m u : G}
    (hm : m ∈ D.reflectionCoset i) (hu : u ∈ D.U (P.reflectionPerm i i)) :
    m * u * m⁻¹ ∈ D.U i :=
  P.reflectionPerm_self i i ▸ D.mul_mul_inv_mem_U_reflectionCoset hm hu

/-- Each element of `M a` conjugates `U a` into `U (-a)`. -/
theorem mul_mul_inv_mem_U_neg_of_mem_reflectionCoset {i : ι} {m u : G}
    (hm : m ∈ D.reflectionCoset i) (hu : u ∈ D.U i) :
    m * u * m⁻¹ ∈ D.U (P.reflectionPerm i i) :=
  D.mul_mul_inv_mem_U_reflectionCoset hm hu

/-- Membership in a reflection coset, tested against one of its elements. -/
theorem mem_reflectionCoset_iff_mul_inv_mem_T {i : ι} {m g : G}
    (hm : m ∈ D.reflectionCoset i) : g ∈ D.reflectionCoset i ↔ g * m⁻¹ ∈ D.T :=
  ⟨fun hg ↦ D.mul_inv_mem_T hm hg, fun hg ↦ by
    simpa using D.mul_mem_reflectionCoset hg hm⟩

/-! ### The torus normalizes the root subgroups -/

/-- `T` normalizes every root subgroup. -/
theorem le_normalizer (i : ι) : D.T ≤ Subgroup.normalizer (D.U i : Set G) := by
  intro t ht
  obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty i
  rw [← Subgroup.conjAct_pointwise_smul_iff]
  have h := D.conj_smul_U_neg (D.mul_mem_reflectionCoset ht hm)
  rwa [ConjAct.toConjAct_mul, mul_smul, D.conj_smul_U_neg hm] at h

theorem conj_smul_U_of_mem_T {i : ι} {t : G} (ht : t ∈ D.T) :
    ConjAct.toConjAct t • D.U i = D.U i :=
  Subgroup.conjAct_pointwise_smul_eq_self (D.le_normalizer i ht)

theorem mul_mul_inv_mem_U {i : ι} {t u : G} (ht : t ∈ D.T) (hu : u ∈ D.U i) :
    t * u * t⁻¹ ∈ D.U i :=
  (Subgroup.mem_normalizer_iff.mp (D.le_normalizer i ht) u).mp hu

theorem inv_mul_mul_mem_U {i : ι} {t u : G} (ht : t ∈ D.T) (hu : u ∈ D.U i) :
    t⁻¹ * u * t ∈ D.U i := by
  simpa using D.mul_mul_inv_mem_U (D.T.inv_mem ht) hu

/-- Multiplying an element of `U a * M a * U a` on both sides by elements of `U a` stays in
`U a * M a * U a`. -/
private theorem mul_mul_mem_mul {i : ι} {g x y : G} (hx : x ∈ D.U i) (hy : y ∈ D.U i)
    (hg : g ∈ (D.U i : Set G) * D.reflectionCoset i * D.U i) :
    x * g * y ∈ (D.U i : Set G) * D.reflectionCoset i * D.U i := by
  obtain ⟨_, ⟨x', hx', m, hm, rfl⟩, y', hy', rfl⟩ := hg
  exact ⟨x * x' * m, ⟨x * x', mul_mem hx hx', m, hm, rfl⟩, y' * y, mul_mem hy' hy, by group⟩

/-- Some nontrivial element of `U (-a)` decomposes as `x * m * y` with `x, y ∈ U a` and
`m ∈ M a`. -/
theorem exists_mem_bruhat (i : ι) :
    ∃ u ∈ D.U (P.reflectionPerm i i), u ≠ 1 ∧ ∃ x ∈ D.U i, ∃ m ∈ D.reflectionCoset i,
      ∃ y ∈ D.U i, u = x * m * y := by
  obtain ⟨⟨u, hu⟩, hne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot (P.reflectionPerm i i))
  have hne' : u ≠ 1 := fun h ↦ hne (Subtype.ext h)
  obtain ⟨_, ⟨x, hx, m, hm, rfl⟩, y, hy, hxy⟩ := D.bruhat i ⟨hu, hne'⟩
  exact ⟨u, hu, hne', x, hx, m, hm, y, hy, hxy.symm⟩

/-! ### Opposite root subgroups -/

section Ordered

variable [IsStrictOrderedRing R]

/-- The root subgroups of opposite roots are different. -/
theorem U_ne_of_root_eq_neg {i j : ι} (h : P.root j = -P.root i) : D.U j ≠ D.U i := by
  intro hU
  have hv : P.root' j D.positiveVector = -P.root' i D.positiveVector := by
    simp [RootPairing.root', h]
  refine D.U_ne_bot i (eq_bot_iff.mpr fun u hu ↦ ?_)
  have hu' : u ∈ D.U j := hU ▸ hu
  rcases (D.positiveVector_regular i).lt_or_gt with hi | hi
  · have hj : 0 < P.root' j D.positiveVector := by rw [hv]; exact neg_pos.mpr hi
    simpa using D.eq_one_of_mul_mem_negativeSubgroup D.T.one_mem (U_le_positiveSubgroup hj hu')
      (by simpa using U_le_negativeSubgroup hi hu)
  · have hj : P.root' j D.positiveVector < 0 := by rw [hv]; exact neg_neg_iff_pos.mpr hi
    simpa using D.eq_one_of_mul_mem_negativeSubgroup D.T.one_mem (U_le_positiveSubgroup hi hu)
      (by simpa using U_le_negativeSubgroup hj hu')

/-- An element of `U a` that normalizes `U (-a)` is trivial. -/
theorem eq_one_of_mem_normalizer {i : ι} {g : G} (hg : g ∈ D.U i)
    (hn : g ∈ Subgroup.normalizer (D.U (P.reflectionPerm i i) : Set G)) : g = 1 := by
  by_contra hne
  set j := P.reflectionPerm i i
  have hji : P.reflectionPerm j j = i := P.reflectionPerm_reflectionPerm_self i
  have hg' : g ∈ (D.U (P.reflectionPerm j j) : Set G) \ {1} := ⟨by rwa [hji], hne⟩
  obtain ⟨_, ⟨p, hp, n, hn', rfl⟩, q, hq, hpq⟩ := D.bruhat j hg'
  have hnorm : n ∈ Subgroup.normalizer (D.U j : Set G) := by
    have hn_eq : n = p⁻¹ * g * q⁻¹ := by rw [← hpq]; group
    rw [hn_eq]
    exact mul_mem (mul_mem (Subgroup.le_normalizer (inv_mem hp)) hn)
      (Subgroup.le_normalizer (inv_mem hq))
  have h := D.reflection_conjugates j n hn' j
  rw [Subgroup.conjAct_pointwise_smul_eq_self hnorm, hji] at h
  exact D.U_ne_of_root_eq_neg (by simp [j]) h

/-- An element of `U a * M a * U a` that exchanges `U a` and `U (-a)` by conjugation lies in
`M a`. -/
theorem mem_reflectionCoset_of_mem_mul {i : ι} {g : G}
    (hg : g ∈ (D.U i : Set G) * D.reflectionCoset i * D.U i)
    (h₁ : ConjAct.toConjAct g • D.U i = D.U (P.reflectionPerm i i))
    (h₂ : ConjAct.toConjAct g • D.U (P.reflectionPerm i i) = D.U i) :
    g ∈ D.reflectionCoset i := by
  obtain ⟨_, ⟨x, hx, m, hm, rfl⟩, y, hy, rfl⟩ := hg
  set j := P.reflectionPerm i i
  have hji : P.reflectionPerm j j = i := P.reflectionPerm_reflectionPerm_self i
  have hm₁ := D.conj_smul_U_neg hm
  have hm₂ : ConjAct.toConjAct m • D.U i = D.U j := D.reflection_conjugates i m hm i
  -- `h = x * m * y * m⁻¹` normalizes `U a` and `U (-a)`, and lies in `U a * U (-a)`.
  set h := x * m * y * m⁻¹
  have hm₁' : (ConjAct.toConjAct m)⁻¹ • D.U i = D.U j := by rw [inv_smul_eq_iff, hm₁]
  have hm₂' : (ConjAct.toConjAct m)⁻¹ • D.U j = D.U i := by rw [inv_smul_eq_iff, hm₂]
  have hh₁ : h ∈ Subgroup.normalizer (D.U i : Set G) := by
    rw [← Subgroup.conjAct_pointwise_smul_iff, ConjAct.toConjAct_mul, mul_smul,
      ConjAct.toConjAct_inv, hm₁', h₂]
  have hh₂ : h ∈ Subgroup.normalizer (D.U j : Set G) := by
    rw [← Subgroup.conjAct_pointwise_smul_iff, ConjAct.toConjAct_mul, mul_smul,
      ConjAct.toConjAct_inv, hm₂', h₁]
  have hz : m * y * m⁻¹ ∈ D.U j := D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset hm hy
  have hz₁ : m * y * m⁻¹ = 1 := by
    refine D.eq_one_of_mem_normalizer hz ?_
    rw [hji]
    have : m * y * m⁻¹ = x⁻¹ * h := by simp only [h]; group
    rw [this]
    exact mul_mem (Subgroup.le_normalizer (inv_mem hx)) hh₁
  have hx₁ : x = 1 := by
    refine D.eq_one_of_mem_normalizer hx ?_
    have : h = x := by
      calc h = x * (m * y * m⁻¹) := by simp only [h]; group
        _ = x := by rw [hz₁, mul_one]
    rwa [← this]
  have hy₁ : y = 1 := by simpa using hz₁
  simpa [hx₁, hy₁] using hm

/-- The opposite roots `a` and `-a` have the same reflection coset: `M (-a) = M a`. -/
theorem reflectionCoset_reflectionPerm_self (i : ι) :
    D.reflectionCoset (P.reflectionPerm i i) = D.reflectionCoset i := by
  set j := P.reflectionPerm i i
  have hji : P.reflectionPerm j j = i := P.reflectionPerm_reflectionPerm_self i
  -- Write a nontrivial `u ∈ U (-a)` as `x m y` with `x, y ∈ U a` and `m ∈ M a`.
  obtain ⟨u, hu, hne, x, hx, m, hm, y, hy, rfl⟩ := D.exists_mem_bruhat i
  have hmi : ConjAct.toConjAct m • D.U i = D.U j := D.reflection_conjugates i m hm i
  -- The factor `x` is nontrivial, since otherwise `m ∈ U (-a) U a` would fix `U a`.
  have hx₁ : x ≠ 1 := by
    rintro rfl
    have h : ConjAct.toConjAct (m * y) • D.U i = D.U j := by
      rw [ConjAct.toConjAct_mul, mul_smul, Subgroup.conjAct_pointwise_smul_eq_self
        (Subgroup.le_normalizer hy), hmi]
    have hu' : (m * y)⁻¹ ∈ D.U j := inv_mem (by simpa using hu)
    have h' : D.U i = ConjAct.toConjAct (m * y)⁻¹ • D.U j := by
      rw [← h, ConjAct.toConjAct_inv, inv_smul_smul]
    rw [Subgroup.conjAct_pointwise_smul_eq_self (Subgroup.le_normalizer hu')] at h'
    exact D.U_ne_of_root_eq_neg (by simp [j]) h'.symm
  -- Then `x⁻¹ = (m y m⁻¹) m u⁻¹ ∈ U a ∖ {1}` factors through `M (-a)` by (DR4).
  have hz : m * y * m⁻¹ ∈ D.U j := D.mul_mul_inv_mem_U_neg_of_mem_reflectionCoset hm hy
  have hxinv : x⁻¹ ∈ (D.U (P.reflectionPerm j j) : Set G) \ {1} :=
    ⟨by rw [hji]; exact inv_mem hx, inv_ne_one.mpr hx₁⟩
  -- So `m ∈ U (-a) M (-a) U (-a)` exchanges `U a` and `U (-a)`, hence `m ∈ M (-a)`.
  have hmj : m ∈ D.reflectionCoset j := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ ?_ ?_
    · have := D.mul_mul_mem_mul (inv_mem hz) hu (D.bruhat j hxinv)
      convert this using 1
      group
    · rw [hji, D.conj_smul_U_neg hm]
    · rw [hji, hmi]
  ext g
  rw [D.mem_reflectionCoset_iff_mul_inv_mem_T hmj, D.mem_reflectionCoset_iff_mul_inv_mem_T hm]

/-- In a non-reduced root datum, a double root `2 a` has the same reflection coset as `a`. -/
theorem reflectionCoset_eq_of_root_eq_two_smul [Finite ι] {i j : ι}
    (h : P.root j = (2 : R) • P.root i) : D.reflectionCoset j = D.reflectionCoset i := by
  have hperm : P.reflectionPerm j = P.reflectionPerm i := P.reflectionPerm_eq_of_root_eq_smul h
  have hneg : P.root (P.reflectionPerm j j) = (2 : R) • P.root (P.reflectionPerm i i) := by
    rw [P.root_reflectionPerm, P.reflection_apply_self, P.root_reflectionPerm,
      P.reflection_apply_self, h, smul_neg]
  obtain ⟨u, hu, hne, x, hx, m, hm, y, hy, rfl⟩ := D.exists_mem_bruhat j
  have hmi : m ∈ D.reflectionCoset i := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ (by rw [D.reflection_conjugates j m hm i, hperm])
      (by rw [D.reflection_conjugates j m hm (P.reflectionPerm i i), hperm, P.reflectionPerm_self])
    obtain ⟨_, ⟨x', hx', m', hm', rfl⟩, y', hy', hxy'⟩ :=
      D.bruhat i ⟨D.le_of_root_eq_two_smul _ _ hneg hu, hne⟩
    dsimp only at hxy'
    have hassoc : (x⁻¹ * x' * m') * (y' * y⁻¹) = x⁻¹ * (x' * m' * y') * y⁻¹ := by group
    exact ⟨x⁻¹ * x' * m', ⟨x⁻¹ * x', mul_mem (D.le_of_root_eq_two_smul i j h (inv_mem hx)) hx',
      m', hm', rfl⟩, y' * y⁻¹, mul_mem hy' (D.le_of_root_eq_two_smul i j h (inv_mem hy)),
      by dsimp only; rw [hassoc, hxy']; group⟩
  ext g
  rw [D.mem_reflectionCoset_iff_mul_inv_mem_T hm, D.mem_reflectionCoset_iff_mul_inv_mem_T hmi]

/-- If `u' u u'' ∈ M a` with `u ∈ U a` and `u', u'' ∈ U (-a)`, then `u ≠ 1`. -/
theorem ne_one_of_mul_mul_mem_reflectionCoset {i : ι} {u u' u'' : G}
    (hu' : u' ∈ D.U (P.reflectionPerm i i)) (hu'' : u'' ∈ D.U (P.reflectionPerm i i))
    (h : u' * u * u'' ∈ D.reflectionCoset i) : u ≠ 1 := by
  rintro rfl
  have hm := D.conj_smul_U_neg h
  rw [mul_one, Subgroup.conjAct_pointwise_smul_eq_self
    (Subgroup.le_normalizer (mul_mem hu' hu''))] at hm
  exact D.U_ne_of_root_eq_neg (by simp) hm

/-- If `u' u u'' ∈ M a` with `u ∈ U a` and `u' ∈ U (-a)`, then `u'' ≠ 1`. -/
theorem ne_one_right_of_mul_mul_mem_reflectionCoset {i : ι} {u u' u'' : G}
    (hu : u ∈ D.U i) (hu' : u' ∈ D.U (P.reflectionPerm i i))
    (h : u' * u * u'' ∈ D.reflectionCoset i) : u'' ≠ 1 := by
  rintro rfl
  have h1 := D.reflection_conjugates i (u' * u) (by simpa using h) i
  rw [ConjAct.toConjAct_mul, mul_smul,
    Subgroup.conjAct_pointwise_smul_eq_self (Subgroup.le_normalizer hu)] at h1
  have h2 : D.U i = D.U (P.reflectionPerm i i) := by
    rw [← inv_smul_eq_iff.mpr h1.symm, ← ConjAct.toConjAct_inv,
      Subgroup.conjAct_pointwise_smul_eq_self (Subgroup.le_normalizer (inv_mem hu'))]
  exact D.U_ne_of_root_eq_neg (by simp) h2.symm

/-- `T` meets every root subgroup trivially. -/
@[simp]
theorem T_inf_U_eq_bot (i : ι) : D.T ⊓ D.U i = ⊥ :=
  eq_bot_iff.mpr fun _ hg ↦ D.eq_one_of_mem_normalizer hg.2 (D.le_normalizer _ hg.1)

/-! ### Normality of `T` in `N` -/

/-- Each element of a reflection coset normalizes `T`, in the form `m T m⁻¹ ⊆ T`. -/
theorem mul_mul_inv_mem_T {i : ι} {m t : G} (hm : m ∈ D.reflectionCoset i) (ht : t ∈ D.T) :
    m * t * m⁻¹ ∈ D.T := by
  obtain ⟨u, hu, hne, x, hx, m₁, hm₁, y, hy, rfl⟩ := D.exists_mem_bruhat i
  set j := P.reflectionPerm i i
  -- The conjugate `t⁻¹ m₁ t` lies in `U a * M a * U a` and exchanges `U a` and `U (-a)`.
  have hconj : t⁻¹ * m₁ * t ∈ D.reflectionCoset i := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ ?_ ?_
    · have hu' : t⁻¹ * (x * m₁ * y) * t ∈ (D.U j : Set G) \ {1} := by
        refine ⟨D.inv_mul_mul_mem_U ht hu, fun h ↦ hne ?_⟩
        have : x * m₁ * y = t * (t⁻¹ * (x * m₁ * y) * t) * t⁻¹ := by group
        rw [this, h, mul_one, mul_inv_cancel]
      have hx' : t⁻¹ * x⁻¹ * t ∈ D.U i := D.inv_mul_mul_mem_U ht (inv_mem hx)
      have hy' : t⁻¹ * y⁻¹ * t ∈ D.U i := D.inv_mul_mul_mem_U ht (inv_mem hy)
      have := D.mul_mul_mem_mul hx' hy' (D.bruhat i hu')
      convert this using 1
      group
    · rw [ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul,
        D.conj_smul_U_of_mem_T ht, D.reflection_conjugates i m₁ hm₁ i,
        D.conj_smul_U_of_mem_T (D.T.inv_mem ht)]
    · rw [ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul,
        D.conj_smul_U_of_mem_T ht, D.conj_smul_U_neg hm₁, D.conj_smul_U_of_mem_T (D.T.inv_mem ht)]
  have h₁ : m₁ * t * m₁⁻¹ ∈ D.T := by
    have := D.T.mul_mem ht (D.mul_inv_mem_T hm₁ hconj)
    simpa [mul_assoc] using this
  -- A general element of `M a` is `s m₁` with `s ∈ T`.
  have hs := D.mul_inv_mem_T hm₁ hm
  have : m * t * m⁻¹ = (m * m₁⁻¹) * (m₁ * t * m₁⁻¹) * (m * m₁⁻¹)⁻¹ := by group
  rw [this]
  exact D.T.mul_mem (D.T.mul_mem hs h₁) (D.T.inv_mem hs)

/-- Each reflection coset is stable under inversion. -/
theorem inv_mem_reflectionCoset {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) :
    m⁻¹ ∈ D.reflectionCoset i := by
  obtain ⟨u, hu, hne, x, hx, m₁, hm₁, y, hy, rfl⟩ := D.exists_mem_bruhat i
  set j := P.reflectionPerm i i
  have hinv : m₁⁻¹ ∈ D.reflectionCoset i := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ ?_ ?_
    · have hu' : (x * m₁ * y)⁻¹ ∈ (D.U j : Set G) \ {1} := ⟨inv_mem hu, inv_ne_one.mpr hne⟩
      have := D.mul_mul_mem_mul hy hx (D.bruhat i hu')
      convert this using 1
      group
    · rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, D.conj_smul_U_neg hm₁]
    · rw [ConjAct.toConjAct_inv, inv_smul_eq_iff, D.reflection_conjugates i m₁ hm₁ i]
  -- A general element of `M a` is `s m₁` with `s ∈ T`, and `m₁⁻¹ s⁻¹ m₁ ∈ T`.
  have hs := D.mul_inv_mem_T hm₁ hm
  have hconj := D.mul_mul_inv_mem_T hinv (D.T.inv_mem hs)
  have : m⁻¹ = (m₁⁻¹ * (m * m₁⁻¹)⁻¹ * m₁⁻¹⁻¹) * m₁⁻¹ := by group
  rw [this]
  exact D.mul_mem_reflectionCoset hconj hinv

/-- The product of two elements of the same reflection coset `M a` lies in `T`. -/
theorem mul_mem_T_of_mem_reflectionCoset {i : ι} {m m' : G}
    (hm : m ∈ D.reflectionCoset i) (hm' : m' ∈ D.reflectionCoset i) : m * m' ∈ D.T := by
  simpa using D.mul_inv_mem_T (D.inv_mem_reflectionCoset hm') hm

/-- The square of any element of a reflection coset `M a` lies in `T`. -/
theorem mul_self_mem_T {i : ι} {m : G} (hm : m ∈ D.reflectionCoset i) : m * m ∈ D.T :=
  D.mul_mem_T_of_mem_reflectionCoset hm hm

/-- For `m, m' ∈ M a`, the left quotient `m⁻¹ * m'` lies in `T`. -/
theorem inv_mul_mem_T {i : ι} {m m' : G}
    (hm : m ∈ D.reflectionCoset i) (hm' : m' ∈ D.reflectionCoset i) : m⁻¹ * m' ∈ D.T :=
  D.mul_mem_T_of_mem_reflectionCoset (D.inv_mem_reflectionCoset hm) hm'

/-- Conjugating a reflection coset `M b` by an element `m ∈ M a` lands in the reflected coset
`M (s_a b)` (Bruhat–Tits I, 6.1.2 (5)). -/
theorem mul_mul_inv_mem_reflectionCoset {i j : ι} {m g : G}
    (hm : m ∈ D.reflectionCoset i) (hg : g ∈ D.reflectionCoset j) :
    m * g * m⁻¹ ∈ D.reflectionCoset (P.reflectionPerm i j) := by
  set k := P.reflectionPerm i j; have hminv := D.inv_mem_reflectionCoset hm
  have hneg : P.reflectionPerm k k = P.reflectionPerm i (P.reflectionPerm j j) := P.root.injective
    (by simp only [P.root_reflectionPerm, P.reflection_apply_self, map_neg]
        rw [← P.root_reflectionPerm])
  obtain ⟨u, hu, hne, x, hx, m₁, hm₁, y, hy, rfl⟩ := D.exists_mem_bruhat j
  have hm₁' : m * m₁ * m⁻¹ ∈ D.reflectionCoset k := by
    refine D.mem_reflectionCoset_of_mem_mul ?_ ?_ ?_
    · have hu' : m * (x * m₁ * y) * m⁻¹ ∈ (D.U (P.reflectionPerm k k) : Set G) \ {1} :=
        ⟨hneg ▸ D.mul_mul_inv_mem_U_reflectionCoset hm hu,
          fun h ↦ hne (by simpa [mul_assoc] using congrArg (m⁻¹ * · * m) h)⟩
      convert D.mul_mul_mem_mul (D.mul_mul_inv_mem_U_reflectionCoset hm (inv_mem hx))
        (D.mul_mul_inv_mem_U_reflectionCoset hm (inv_mem hy)) (D.bruhat k hu') using 1
      group
    · rw [ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul, ConjAct.toConjAct_inv,
        ← ConjAct.toConjAct_inv, D.reflection_conjugates i m⁻¹ hminv k, P.reflectionPerm_self,
        D.reflection_conjugates j m₁ hm₁ j, D.reflection_conjugates i m hm, hneg]
    · rw [hneg, ConjAct.toConjAct_mul, ConjAct.toConjAct_mul, mul_smul, mul_smul,
        ConjAct.toConjAct_inv, ← ConjAct.toConjAct_inv, D.reflection_conjugates i m⁻¹ hminv,
        P.reflectionPerm_self, D.conj_smul_U_neg hm₁, D.reflection_conjugates i m hm j]
  have hmul : m * g * m⁻¹ = (m * (g * m₁⁻¹) * m⁻¹) * (m * m₁ * m⁻¹) := by group
  exact hmul ▸ D.mul_mem_reflectionCoset (D.mul_mul_inv_mem_T hm (D.mul_inv_mem_T hm₁ hg)) hm₁'

/-- Each element of a reflection coset normalizes `T`. -/
theorem reflectionCoset_subset_normalizer (i : ι) :
    D.reflectionCoset i ⊆ Subgroup.normalizer (D.T : Set G) := by
  intro m hm
  refine Subgroup.mem_normalizer_iff.mpr fun t ↦ ⟨D.mul_mul_inv_mem_T hm, fun ht ↦ ?_⟩
  simpa [mul_assoc] using D.mul_mul_inv_mem_T (D.inv_mem_reflectionCoset hm) ht

theorem weylNormalizer_le_normalizer : D.weylNormalizer ≤ Subgroup.normalizer (D.T : Set G) :=
  weylNormalizer_le_iff.mpr ⟨Subgroup.le_normalizer, D.reflectionCoset_subset_normalizer⟩

/-- `T` is a normal subgroup of the subgroup `N` generated by `T` and the reflection cosets. -/
theorem T_normal_weylNormalizer : (D.T.subgroupOf D.weylNormalizer).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer D.T_le_weylNormalizer).mpr
    D.weylNormalizer_le_normalizer
attribute [instance] T_normal_weylNormalizer

end Ordered

/-! ### Borel and generated subgroups -/

section Subgroups

variable (D)

/-- The Borel-like subgroup `B = T U⁺` attached to `D.positiveVector`. -/
def borelSubgroup : Subgroup G := D.T ⊔ D.positiveSubgroup

/-- The subgroup of `G` generated by `T` and all root subgroups `U a`. -/
def generatedSubgroup : Subgroup G := D.T ⊔ ⨆ i, D.U i

variable {D}

/-- `D.borelSubgroup` is the join `D.T ⊔ D.positiveSubgroup`. -/
theorem borelSubgroup_def : D.borelSubgroup = D.T ⊔ D.positiveSubgroup := (rfl)

/-- `D.generatedSubgroup` is the join of `D.T` and all root subgroups `D.U i`. -/
theorem generatedSubgroup_def : D.generatedSubgroup = D.T ⊔ ⨆ i, D.U i := (rfl)

/-- `D` is generating if and only if `D.generatedSubgroup = ⊤`. -/
theorem isGenerating_iff_generatedSubgroup_eq_top : D.IsGenerating ↔ D.generatedSubgroup = ⊤ :=
  D.isGenerating_iff

/-- `T` is contained in `D.borelSubgroup`. -/
theorem T_le_borelSubgroup : D.T ≤ D.borelSubgroup := le_sup_left

/-- `U⁺` is contained in `D.borelSubgroup`. -/
theorem positiveSubgroup_le_borelSubgroup : D.positiveSubgroup ≤ D.borelSubgroup := le_sup_right

/-- `T` normalizes the positive unipotent subgroup `U⁺`. -/
theorem T_le_normalizer_positiveSubgroup : D.T ≤ Subgroup.normalizer (D.positiveSubgroup : Set G) :=
  fun _ ht ↦ D.positiveSubgroup_def ▸
    Subgroup.mem_normalizer_biSup_of_conjAct_smul_eq fun _ _ ↦ D.conj_smul_U_of_mem_T ht

/-- As sets, `D.borelSubgroup` is the pointwise product `T * U⁺`. -/
theorem coe_borelSubgroup :
    (D.borelSubgroup : Set G) = (D.T : Set G) * (D.positiveSubgroup : Set G) :=
  Subgroup.coe_mul_of_left_le_normalizer_right _ _ D.T_le_normalizer_positiveSubgroup

/-- `T` is contained in `D.generatedSubgroup`. -/
theorem T_le_generatedSubgroup : D.T ≤ D.generatedSubgroup := le_sup_left

/-- Each root subgroup `U i` is contained in `D.generatedSubgroup`. -/
theorem U_le_generatedSubgroup (i : ι) : D.U i ≤ D.generatedSubgroup :=
  (le_iSup (fun j ↦ D.U j) i).trans le_sup_right

/-- `U⁺` is contained in `D.generatedSubgroup`. -/
theorem positiveSubgroup_le_generatedSubgroup : D.positiveSubgroup ≤ D.generatedSubgroup :=
  D.positiveSubgroup_le_iff.mpr fun i _ ↦ D.U_le_generatedSubgroup i

/-- `D.borelSubgroup` is contained in `D.generatedSubgroup`. -/
theorem borelSubgroup_le_generatedSubgroup : D.borelSubgroup ≤ D.generatedSubgroup :=
  sup_le D.T_le_generatedSubgroup D.positiveSubgroup_le_generatedSubgroup

/-- Every reflection coset `M i` lies inside `D.generatedSubgroup`. -/
theorem reflectionCoset_subset_generatedSubgroup (i : ι) :
    D.reflectionCoset i ⊆ D.generatedSubgroup := fun m hm ↦ by
  obtain ⟨u, hu, _, x, hx, m₁, hm₁, y, hy, rfl⟩ := D.exists_mem_bruhat i
  have hm₁G : m₁ ∈ D.generatedSubgroup := (by group : m₁ = x⁻¹ * (x * m₁ * y) * y⁻¹) ▸
    mul_mem (mul_mem (D.U_le_generatedSubgroup i (inv_mem hx)) (D.U_le_generatedSubgroup _ hu))
      (D.U_le_generatedSubgroup i (inv_mem hy))
  simpa [mul_assoc] using mul_mem (D.T_le_generatedSubgroup (D.mul_inv_mem_T hm₁ hm)) hm₁G

/-- The Weyl normalizer `N` is contained in `D.generatedSubgroup`. -/
theorem weylNormalizer_le_generatedSubgroup : D.weylNormalizer ≤ D.generatedSubgroup :=
  D.weylNormalizer_le_iff.mpr ⟨D.T_le_generatedSubgroup, D.reflectionCoset_subset_generatedSubgroup⟩

/-- Together `B` and `N` generate `D.generatedSubgroup`. -/
theorem borelSubgroup_sup_weylNormalizer [IsStrictOrderedRing R] :
    D.borelSubgroup ⊔ D.weylNormalizer = D.generatedSubgroup := by
  refine le_antisymm
    (sup_le D.borelSubgroup_le_generatedSubgroup D.weylNormalizer_le_generatedSubgroup)
    (sup_le (D.T_le_borelSubgroup.trans le_sup_left) (iSup_le fun i ↦ ?_))
  rcases (D.positiveVector_regular i).lt_or_gt with hi | hi
  · set j := P.reflectionPerm i i; obtain ⟨m, hm⟩ := D.reflectionCoset_nonempty j
    have hmN : m ∈ D.borelSubgroup ⊔ D.weylNormalizer :=
      Subgroup.mem_sup_right (D.reflectionCoset_subset_weylNormalizer j hm)
    rw [(P.reflectionPerm_reflectionPerm_self i).symm, ← D.reflection_conjugates j m hm j]
    rintro _ ⟨u, hu, rfl⟩
    exact mul_mem (mul_mem hmN (Subgroup.mem_sup_left (D.positiveSubgroup_le_borelSubgroup
      (D.U_le_positiveSubgroup (by simpa [j] using neg_pos.mpr hi) hu)))) (inv_mem hmN)
  · exact ((D.U_le_positiveSubgroup hi).trans D.positiveSubgroup_le_borelSubgroup).trans le_sup_left

variable (D) in
/-- Restricting a root datum `D` in `G` to `D.generatedSubgroup` yields a generating root datum. -/
def restrictToGenerated : RootDatum P D.generatedSubgroup where
  T := D.T.subgroupOf D.generatedSubgroup
  U i := (D.U i).subgroupOf D.generatedSubgroup
  reflectionCoset i := Subtype.val ⁻¹' D.reflectionCoset i
  positiveVector := D.positiveVector
  U_ne_bot i := Subgroup.ne_bot_iff_exists_ne_one.mpr <|
    let ⟨⟨u, hu⟩, hne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp (D.U_ne_bot i)
    ⟨⟨⟨u, D.U_le_generatedSubgroup i hu⟩, hu⟩,
      fun h ↦ hne (Subtype.ext (congrArg (Subtype.val ∘ Subtype.val) h))⟩
  commutator_le i j hij := Subgroup.commutator_le.mpr fun u hu v hv ↦ by
    let p (k : ι) := ∃ a b : ℕ, 0 < a ∧ 0 < b ∧ P.root k = a • P.root i + b • P.root j
    have hle : ⨆ (k) (_ : p k), D.U k ≤ Subgroup.map D.generatedSubgroup.subtype
        (⨆ (k) (_ : p k), (D.U k).subgroupOf D.generatedSubgroup) :=
      iSup₂_le fun k hk x hx ↦ ⟨⟨x, D.U_le_generatedSubgroup k hx⟩,
        Subgroup.mem_iSup_of_mem k (Subgroup.mem_iSup_of_mem hk hx), rfl⟩
    obtain ⟨g₀, hg₀, hv₀⟩ :=
      hle (D.commutator_le i j hij (Subgroup.commutator_mem_commutator hu hv))
    exact (Subtype.ext hv₀ : g₀ = ⁅u, v⁆) ▸ hg₀
  le_of_root_eq_two_smul i j h _ hu := D.le_of_root_eq_two_smul i j h hu
  ne_of_root_eq_two_smul i j h heq := D.ne_of_root_eq_two_smul i j h <| le_antisymm
    (D.le_of_root_eq_two_smul i j h) fun x hx ↦
      (SetLike.ext_iff.mp heq ⟨x, D.U_le_generatedSubgroup i hx⟩).mpr hx
  reflectionCoset_eq i :=
    let ⟨m, hm⟩ := D.reflectionCoset_eq i
    ⟨⟨m, D.reflectionCoset_subset_generatedSubgroup i (by simp [hm, mem_rightCoset_iff])⟩,
      by ext; simp [hm, mem_rightCoset_iff, Subgroup.mem_subgroupOf]⟩
  bruhat i x hx :=
    let ⟨_, ⟨a, ha, m, hm, rfl⟩, b, hb, hab⟩ := D.bruhat i ⟨hx.1, fun h ↦ hx.2 (Subtype.ext h)⟩
    have haG := D.U_le_generatedSubgroup i ha; have hbG := D.U_le_generatedSubgroup i hb
    have hmG := D.reflectionCoset_subset_generatedSubgroup i hm
    ⟨⟨a * m, mul_mem haG hmG⟩, ⟨⟨a, haG⟩, ha, ⟨m, hmG⟩, hm, rfl⟩, ⟨b, hbG⟩, hb, Subtype.ext hab⟩
  reflection_conjugates i m hm j := by
    ext x; rw [Subgroup.mem_conjAct_smul_iff, Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf,
      ← D.reflection_conjugates i (m : G) hm j, Subgroup.mem_conjAct_smul_iff]; rfl
  positiveVector_regular := D.positiveVector_regular
  bruhat_separation t ht u hu htu := by
    have hsub (p : ι → Prop) : ⨆ (i) (_ : p i), (D.U i).subgroupOf D.generatedSubgroup ≤
        (⨆ (i) (_ : p i), D.U i).subgroupOf D.generatedSubgroup :=
      iSup₂_le fun i hi _ hy ↦ Subgroup.mem_iSup_of_mem i (Subgroup.mem_iSup_of_mem hi hy)
    exact Subtype.ext (D.bruhat_separation t ht u (hsub _ hu) (hsub _ htu))

/-- The torus subgroup of `D.restrictToGenerated` is `D.T` restricted to `D.generatedSubgroup`. -/
@[simp] theorem restrictToGenerated_T :
    D.restrictToGenerated.T = D.T.subgroupOf D.generatedSubgroup := (rfl)

/-- Each root subgroup of `D.restrictToGenerated` is `D.U i` restricted to `D.generatedSubgroup`. -/
@[simp] theorem restrictToGenerated_U (i : ι) :
    D.restrictToGenerated.U i = (D.U i).subgroupOf D.generatedSubgroup := (rfl)

/-- Each reflection coset of `D.restrictToGenerated` is the preimage of `D.reflectionCoset i` in
`D.generatedSubgroup`. -/
@[simp] theorem restrictToGenerated_reflectionCoset (i : ι) :
    D.restrictToGenerated.reflectionCoset i = Subtype.val ⁻¹' D.reflectionCoset i := (rfl)

/-- `D.restrictToGenerated` retains the regular coweight `D.positiveVector`. -/
@[simp] theorem restrictToGenerated_positiveVector :
    D.restrictToGenerated.positiveVector = D.positiveVector := (rfl)

/-- The positive unipotent subgroup of `D.restrictToGenerated` is `D.positiveSubgroup` restricted
to `D.generatedSubgroup`. -/
@[simp] theorem restrictToGenerated_positiveSubgroup :
    D.restrictToGenerated.positiveSubgroup =
      D.positiveSubgroup.subgroupOf D.generatedSubgroup := by
  refine le_antisymm
    (D.restrictToGenerated.positiveSubgroup_le_iff.mpr fun i hi _ hu ↦
      D.U_le_positiveSubgroup hi hu) fun x hx ↦ ?_
  have hle : D.positiveSubgroup ≤
      D.restrictToGenerated.positiveSubgroup.map D.generatedSubgroup.subtype :=
    D.positiveSubgroup_le_iff.mpr fun i hi y hy ↦
      ⟨⟨y, D.U_le_generatedSubgroup i hy⟩, D.restrictToGenerated.U_le_positiveSubgroup hi hy, rfl⟩
  obtain ⟨y, hy, hxy⟩ := hle hx
  exact (Subtype.ext hxy : y = x) ▸ hy

/-- The Borel subgroup of `D.restrictToGenerated` is `D.borelSubgroup` restricted to
`D.generatedSubgroup`. -/
@[simp] theorem restrictToGenerated_borelSubgroup :
    D.restrictToGenerated.borelSubgroup =
      D.borelSubgroup.subgroupOf D.generatedSubgroup := by
  refine le_antisymm
    (sup_le (fun _ ht ↦ D.T_le_borelSubgroup ht)
      (D.restrictToGenerated_positiveSubgroup.trans_le fun _ hu ↦
        D.positiveSubgroup_le_borelSubgroup hu)) fun x hx ↦ ?_
  have hle : D.borelSubgroup ≤
      D.restrictToGenerated.borelSubgroup.map D.generatedSubgroup.subtype :=
    sup_le (fun y hy ↦ ⟨⟨y, D.T_le_generatedSubgroup hy⟩, Subgroup.mem_sup_left hy, rfl⟩)
      (fun y hy ↦ ⟨⟨y, D.positiveSubgroup_le_generatedSubgroup hy⟩,
        Subgroup.mem_sup_right (D.restrictToGenerated_positiveSubgroup.symm ▸ hy), rfl⟩)
  obtain ⟨y, hy, hxy⟩ := hle hx
  exact (Subtype.ext hxy : y = x) ▸ hy

/-- The Weyl normalizer of `D.restrictToGenerated` is `D.weylNormalizer` restricted to
`D.generatedSubgroup`. -/
@[simp] theorem restrictToGenerated_weylNormalizer :
    D.restrictToGenerated.weylNormalizer =
      D.weylNormalizer.subgroupOf D.generatedSubgroup := by
  refine le_antisymm
    (D.restrictToGenerated.weylNormalizer_le_iff.mpr
      ⟨fun _ ht ↦ D.T_le_weylNormalizer ht,
        fun i _ hm ↦ D.reflectionCoset_subset_weylNormalizer i hm⟩) fun x hx ↦ ?_
  have hle : D.weylNormalizer ≤
      D.restrictToGenerated.weylNormalizer.map D.generatedSubgroup.subtype :=
    D.weylNormalizer_le_iff.mpr
      ⟨fun y hy ↦ ⟨⟨y, D.T_le_generatedSubgroup hy⟩, D.restrictToGenerated.T_le_weylNormalizer hy,
        rfl⟩,
        fun i y hy ↦ ⟨⟨y, D.reflectionCoset_subset_generatedSubgroup i hy⟩,
          D.restrictToGenerated.reflectionCoset_subset_weylNormalizer i hy, rfl⟩⟩
  obtain ⟨y, hy, hxy⟩ := hle hx
  exact (Subtype.ext hxy : y = x) ▸ hy

/-- `D.restrictToGenerated` is a generating root datum in `D.generatedSubgroup`. -/
theorem isGenerating_restrictToGenerated : D.restrictToGenerated.IsGenerating := by
  rw [isGenerating_iff, eq_top_iff]; rintro ⟨x, hx⟩ -
  have hle : D.generatedSubgroup ≤ (D.restrictToGenerated.T ⊔ ⨆ i, D.restrictToGenerated.U i).map
      D.generatedSubgroup.subtype :=
    sup_le (fun y hy ↦ ⟨⟨y, D.T_le_generatedSubgroup hy⟩, Subgroup.mem_sup_left hy, rfl⟩)
      (iSup_le fun i y hy ↦ ⟨⟨y, D.U_le_generatedSubgroup i hy⟩,
        Subgroup.mem_sup_right (Subgroup.mem_iSup_of_mem i hy), rfl⟩)
  obtain ⟨y, hy, hxy⟩ := hle hx; exact (Subtype.ext hxy : y = ⟨x, hx⟩) ▸ hy

end Subgroups

/-! ### Root data of rank zero -/

section RankZero

variable [IsEmpty ι]

variable (P G) in
/-- With no roots, every subgroup `T` is a root datum: the axioms (DR1)–(DR6) are empty. -/
def ofIsEmpty (T : Subgroup G) (v : N) : RootDatum P G where
  T := T
  U := isEmptyElim
  reflectionCoset := isEmptyElim
  positiveVector := v
  U_ne_bot := isEmptyElim
  commutator_le := isEmptyElim
  le_of_root_eq_two_smul := isEmptyElim
  ne_of_root_eq_two_smul := isEmptyElim
  reflectionCoset_eq := isEmptyElim
  bruhat := isEmptyElim
  reflection_conjugates := isEmptyElim
  positiveVector_regular := isEmptyElim
  bruhat_separation _ _ _ _ htu := by simpa using htu

@[simp]
theorem ofIsEmpty_T (T : Subgroup G) (v : N) : (ofIsEmpty P G T v).T = T :=
  (rfl)

/-- With no roots, the subgroup `N` is `T`. -/
@[simp]
theorem weylNormalizer_eq_T_of_isEmpty : D.weylNormalizer = D.T :=
  le_antisymm (weylNormalizer_le_iff.mpr ⟨le_rfl, isEmptyElim⟩) D.T_le_weylNormalizer

/-- With no roots, a root datum is generating if and only if `T` is the whole group. -/
@[simp]
theorem isGenerating_iff_of_isEmpty : D.IsGenerating ↔ D.T = ⊤ := by
  simp [isGenerating_iff]

end RankZero

end RootDatum

end TauCeti.BruhatTits
