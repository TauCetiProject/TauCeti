module

public import TauCeti.CommutativeAlgebra.MatrixFactorization.Frobenius
public import TauCeti.Algebra.Homology.Curved.Shift

/-!
# The shift on the homotopy category of matrix factorizations

The parity shift, which swaps the two components of a finite-projective matrix factorization
and negates both maps, is a self-equivalence of the homotopy category `HMF(S,w)`, here
`MatrixFactorization.HomotopyCategory`. This file equips `HMF(S,w)` with the shift by `ℤ` that
it generates, so that the shift by `1` is the parity shift.

This is the shift of Happel's triangulation. Finite-projective matrix factorizations with the
componentwise split exact structure form a Frobenius exact category, and every factorization
`X` has the relative injective presentation

`X ⟶ diskSum X ⟶ X[1]`

whose middle term is the contractible disk sum on the components of `X` and whose cokernel term
is the parity shift `X[1]`. Since stable suspension may be computed from any relative injective
presentation, stable suspension is the parity shift in the stable category. Consequently the
equivalence `MatrixFactorization.stableToHomotopy` between the stable category and `HMF(S,w)`
commutes coherently with the shifts by `ℤ`: the one generated by stable suspension and the one
generated by the parity shift.

## Main definitions

* `TauCeti.MatrixFactorization.HomotopyCategory.instHasShift`: the shift by `ℤ` on `HMF(S,w)`
  generated by the parity shift.
* `TauCeti.MatrixFactorization.HomotopyCategory.parityShiftCompQuotientFunctorIso`: the image of
  the parity shift of a factorization is the shift by `1` of its image.
* `TauCeti.MatrixFactorization.splitSuspensionPresentation`: the componentwise split injective
  presentation `X ⟶ diskSum X ⟶ X[1]`.
* `TauCeti.MatrixFactorization.splitStableSuspensionIsoParityShift`: stable suspension of
  matrix factorizations is the parity shift.
* `TauCeti.MatrixFactorization.stableSuspensionCompStableToHomotopyIso`: the stable-to-homotopy
  comparison intertwines stable suspension with the parity shift.
* `TauCeti.MatrixFactorization.stableToHomotopyCommShift`: the stable-to-homotopy comparison
  commutes with the shifts by `ℤ`.

## References

* Dieter Happel, *Triangulated Categories in the Representation Theory of Finite Dimensional
  Algebras*, Chapter I, Section 2: suspension in the stable category of a Frobenius category.
* D. Orlov, *Triangulated categories of singularities and D-branes in Landau–Ginzburg models*,
  Proc. Steklov Inst. Math. **246** (2004), Section 3, for the category of finite-projective
  matrix factorizations and its shift.

The construction follows the curved-duplex version in `TauCeti.Algebra.Homology.Curved.Shift`,
restricted to finite-projective components.
-/

public section

universe u

namespace TauCeti.MatrixFactorization

open CategoryTheory CategoryTheory.Limits

variable (S : Type u) [CommRing S] (w : S)

attribute [local instance] HasBinaryBiproducts.of_hasBinaryCoproducts


namespace HomotopyCategory

/-- The shift by `ℤ` on the homotopy category of matrix factorizations generated by the parity
shift. -/
noncomputable instance instHasShift : HasShift (HomotopyCategory (S := S) (w := w)) ℤ :=
  (parityShiftEquivalence (S := S) (w := w)).hasShift

/-- The shift by `1` on the homotopy category of matrix factorizations is the parity shift. -/
noncomputable def shiftFunctorOneIso :
    shiftFunctor (HomotopyCategory (S := S) (w := w)) (1 : ℤ) ≅
      (parityShiftEquivalence (S := S) (w := w)).functor :=
  (parityShiftEquivalence (S := S) (w := w)).shiftFunctorOneIso

/-- Every shift functor of the homotopy category of matrix factorizations is additive. -/
instance (n : ℤ) : (shiftFunctor (HomotopyCategory (S := S) (w := w)) n).Additive :=
  (parityShiftEquivalence (S := S) (w := w)).shiftFunctor_additive n

/-- The image in the homotopy category of the parity shift of a factorization is the shift by
`1` of its image, naturally. -/
noncomputable def parityShiftCompQuotientFunctorIso :
    parityShift ⋙ (nullHomotopic (S := S) (w := w)).quotientFunctor ≅
      (nullHomotopic (S := S) (w := w)).quotientFunctor ⋙
        shiftFunctor (HomotopyCategory (S := S) (w := w)) (1 : ℤ) :=
  eqToIso quotientFunctor_comp_parityShiftEquivalence_functor.symm ≪≫
    Functor.isoWhiskerLeft _ (shiftFunctorOneIso S w).symm

variable {S w} in
/-- The component of `parityShiftCompQuotientFunctorIso` at `X` identifies the image of the
parity shift of `X` with the parity shift of its image, followed by `shiftFunctorOneIso`. -/
@[simp]
theorem parityShiftCompQuotientFunctorIso_hom_app (X : MatrixFactorization S w) :
    (parityShiftCompQuotientFunctorIso S w).hom.app X =
      eqToHom (parityShiftEquivalence_functor_obj_quotientFunctor_obj X).symm ≫
        (shiftFunctorOneIso S w).inv.app
          ((nullHomotopic (S := S) (w := w)).quotientFunctor.obj X) := by
  simp [parityShiftCompQuotientFunctorIso, eqToHom_app]

end HomotopyCategory

variable {S w}

/-- The componentwise split injective presentation `X ⟶ diskSum X ⟶ X[1]` of a matrix
factorization: its middle term is the contractible disk sum on the components of `X`, and its
cokernel term is the parity shift of `X`. -/
-- Exposed so that its middle and cokernel terms are definitionally the disk sum and the parity
-- shift, which the typing of the maps between these presentations requires.
@[expose] noncomputable def splitSuspensionPresentation (X : MatrixFactorization S w) :
    (splitExact S w).InjectivePresentation X where
  I := diskSum X
  K := parityShift.obj X
  i := toDiskSum X
  p := diskSumToParityShift X
  zero := toDiskSum_comp_diskSumToParityShift X
  conflation := by
    -- A conflation of the full subcategory is a conflation of the underlying curved duplexes.
    rw [splitExact_def, ExactStructure.fullSubcategory_conflation_iff]
    refine ((ExactStructure.split _).curvedDuplex w).conflation_of_iso ?_
      (ExactStructure.curvedDuplexSplitSuspensionPresentation X.obj).conflation
    refine ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_
    all_goals
      dsimp only [ExactStructure.curvedDuplexSplitSuspensionPresentation]
      simp
  isInjective := splitExact_isInjective_of_mem_nullHomotopic (id_diskSum_mem_nullHomotopic X)

@[simp]
theorem splitSuspensionPresentation_I (X : MatrixFactorization S w) :
    (splitSuspensionPresentation X).I = diskSum X := (rfl)

@[simp]
theorem splitSuspensionPresentation_K (X : MatrixFactorization S w) :
    (splitSuspensionPresentation X).K = parityShift.obj X := (rfl)

@[simp]
theorem splitSuspensionPresentation_i (X : MatrixFactorization S w) :
    (splitSuspensionPresentation X).i = toDiskSum X := (rfl)

@[simp]
theorem splitSuspensionPresentation_p (X : MatrixFactorization S w) :
    (splitSuspensionPresentation X).p = diskSumToParityShift X := (rfl)

/-- In the stable category, the morphism induced by `f` on the cokernel terms of the disk-sum
presentations is the parity shift of `f`. -/
theorem projectiveStableFunctor_map_splitSuspensionPresentation_cokernelMap
    {X Y : MatrixFactorization S w} (f : X ⟶ Y) :
    (splitExact S w).projectiveStableFunctor.map
        ((splitSuspensionPresentation X).cokernelMap (splitSuspensionPresentation Y) f) =
      (splitExact S w).projectiveStableFunctor.map (parityShift.map f) :=
  ExactStructure.projectiveStableFunctor_map_cokernelMap_eq (splitSuspensionPresentation X)
    (splitSuspensionPresentation Y)
    (splitExact_isProjective_of_mem_nullHomotopic (id_diskSum_mem_nullHomotopic Y)) f
    (diskSumMap f) (parityShift.map f) (toDiskSum_comp_diskSumMap f)
    (diskSumToParityShift_comp_parityShift_map f)

variable (S w)

/-- **Stable suspension of matrix factorizations is the parity shift.** For the componentwise
split exact structure, the stable suspension of (the image of) a finite-projective matrix
factorization is (the image of) its parity shift, naturally. -/
noncomputable def splitStableSuspensionIsoParityShift :
    (splitExact S w).projectiveStableFunctor ⋙ (splitExact_isFrobenius S w).stableSuspension ≅
      parityShift ⋙ (splitExact S w).projectiveStableFunctor :=
  -- The implicit endpoints are given so that they are syntactically those of the two functors.
  (NatIso.ofComponents (fun X ↦ Iso.trans
    (X := (parityShift ⋙ (splitExact S w).projectiveStableFunctor).obj X)
    (Z := ((splitExact S w).projectiveStableFunctor ⋙
      (splitExact_isFrobenius S w).stableSuspension).obj X)
    ((splitExact_isFrobenius S w).projectiveStableIsoSuspensionObj
        (splitSuspensionPresentation X))
    (eqToIso ((splitExact_isFrobenius S w).stableSuspension_obj_projectiveStableFunctor_obj
        X).symm)) (fun {X Y} f ↦ by
    have h := (splitExact_isFrobenius S w).projectiveStableIsoSuspensionObj_hom_naturality
      (splitSuspensionPresentation X) (splitSuspensionPresentation Y) f
    rw [projectiveStableFunctor_map_splitSuspensionPresentation_cokernelMap] at h
    rw [Functor.comp_map, Functor.comp_map,
      ExactStructure.IsFrobenius.stableSuspension_map_projectiveStableFunctor_map]
    -- The endpoints of `Iso.trans` are the functor composites, which are only definitionally
    -- equal to the endpoints of the presentation comparison; `rw` cannot see through them.
    erw [Iso.trans_hom, Iso.trans_hom]
    rw [eqToIso.hom, eqToIso.hom]
    simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
    exact (Category.assoc _ _ _).symm.trans ((reassoc_of% h) _))).symm

/-- The component of `splitStableSuspensionIsoParityShift` at `X` is induced by the identity of
`X`, from the chosen suspension presentation to the disk-sum presentation. -/
@[simp]
theorem splitStableSuspensionIsoParityShift_hom_app (X : MatrixFactorization S w) :
    (splitStableSuspensionIsoParityShift S w).hom.app X =
      eqToHom ((splitExact_isFrobenius S w).stableSuspension_obj_projectiveStableFunctor_obj X) ≫
        (splitExact S w).projectiveStableFunctor.map
          (((splitExact_isFrobenius S w).suspensionPresentation X).cokernelMap
            (splitSuspensionPresentation X) (𝟙 X)) := by
  simp only [splitStableSuspensionIsoParityShift, Iso.symm_hom, NatIso.ofComponents_inv_app]
  -- As in the definition, the endpoints agree with those of the composite only definitionally.
  erw [Iso.trans_inv]
  rw [eqToIso.inv, ExactStructure.IsFrobenius.projectiveStableIsoSuspensionObj_inv]
  rfl

/-- The inverse component of `splitStableSuspensionIsoParityShift` at `X` is induced by the
identity of `X`, from the disk-sum presentation to the chosen suspension presentation. -/
@[simp]
theorem splitStableSuspensionIsoParityShift_inv_app (X : MatrixFactorization S w) :
    (splitStableSuspensionIsoParityShift S w).inv.app X =
      (splitExact S w).projectiveStableFunctor.map
          ((splitSuspensionPresentation X).cokernelMap
            ((splitExact_isFrobenius S w).suspensionPresentation X) (𝟙 X)) ≫
        eqToHom ((splitExact_isFrobenius S w).stableSuspension_obj_projectiveStableFunctor_obj
          X).symm := by
  simp only [splitStableSuspensionIsoParityShift, Iso.symm_inv, NatIso.ofComponents_hom_app]
  -- As in the definition, the endpoints agree with those of the composite only definitionally.
  erw [Iso.trans_hom]
  rw [eqToIso.hom, ExactStructure.IsFrobenius.projectiveStableIsoSuspensionObj_hom]
  rfl

/-- The comparison from the componentwise split stable category to `HMF(S,w)` intertwines
stable suspension with the parity shift. -/
noncomputable def stableSuspensionCompStableToHomotopyIso :
    (splitExact_isFrobenius S w).stableSuspension ⋙ stableToHomotopy S w ≅
      stableToHomotopy S w ⋙
        (HomotopyCategory.parityShiftEquivalence (S := S) (w := w)).functor :=
  Quotient.natIsoLift _ <|
    (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight (splitStableSuspensionIsoParityShift S w) _ ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (eqToIso (projectiveStableFunctor_comp_stableToHomotopy S w)) ≪≫
      eqToIso HomotopyCategory.quotientFunctor_comp_parityShiftEquivalence_functor.symm ≪≫
      Functor.isoWhiskerRight
        (eqToIso (projectiveStableFunctor_comp_stableToHomotopy S w).symm) _ ≪≫
      Functor.associator _ _ _

/-- On the stable image of a factorization `X`, the intertwining isomorphism is the homotopy
class of the map induced by the identity of `X` from the chosen suspension presentation to the
disk-sum presentation. -/
theorem stableSuspensionCompStableToHomotopyIso_hom_app (X : MatrixFactorization S w) :
    (stableSuspensionCompStableToHomotopyIso S w).hom.app
        ((splitExact S w).projectiveStableFunctor.obj X) =
      eqToHom (by
          simp [ExactStructure.IsFrobenius.stableSuspension_obj_projectiveStableFunctor_obj]) ≫
        (nullHomotopic (S := S) (w := w)).quotientFunctor.map
          (((splitExact_isFrobenius S w).suspensionPresentation X).cokernelMap
            (splitSuspensionPresentation X) (𝟙 X)) ≫
        eqToHom (by simp) := by
  have h : (stableSuspensionCompStableToHomotopyIso S w).hom.app
      ((splitExact S w).projectiveStableFunctor.obj X) =
        (stableToHomotopy S w).map ((splitStableSuspensionIsoParityShift S w).hom.app X) ≫
          eqToHom (by simp) := by
    simp [stableSuspensionCompStableToHomotopyIso, eqToHom_map]
  rw [h, splitStableSuspensionIsoParityShift_hom_app]
  -- The component is typed at the parity shift, while the cokernel map is typed at the cokernel
  -- term of the presentation; unfolding the presentation makes the two agree reducibly.
  dsimp only [splitSuspensionPresentation]
  simp [eqToHom_map, stableToHomotopy_map]

/-- The comparison from the componentwise split stable category to `HMF(S,w)` commutes with the
shifts by `ℤ`: the one generated by stable suspension and the one generated by the parity
shift. -/
@[instance_reducible]
noncomputable def stableToHomotopyCommShift :
    letI := (splitExact_isFrobenius S w).stableHasShift
    (stableToHomotopy S w).CommShift ℤ :=
  (splitExact_isFrobenius S w).commShiftOfIntertwiningStableSuspension
    (HomotopyCategory.parityShiftEquivalence (S := S) (w := w)) _
    (stableSuspensionCompStableToHomotopyIso S w)

/-- In degree one, the shift compatibility of the stable-to-homotopy comparison is the
identification of stable suspension with the parity shift. -/
theorem stableToHomotopyCommShift_iso_one :
    letI := (splitExact_isFrobenius S w).stableHasShift
    letI := stableToHomotopyCommShift S w
    (stableToHomotopy S w).commShiftIso (1 : ℤ) =
      Functor.isoWhiskerRight (splitExact_isFrobenius S w).stableShiftFunctorOneIso _ ≪≫
        stableSuspensionCompStableToHomotopyIso S w ≪≫
          Functor.isoWhiskerLeft _ (HomotopyCategory.shiftFunctorOneIso S w).symm :=
  (splitExact_isFrobenius S w).commShiftOfIntertwiningStableSuspension_iso_one _ _ _

end TauCeti.MatrixFactorization
