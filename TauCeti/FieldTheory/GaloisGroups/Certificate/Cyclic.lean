module

public import TauCeti.FieldTheory.GaloisGroups.Quintic
import TauCeti.FieldTheory.Galois.PrimeDegree

/-!
# The cyclic label from an automorphism of a quintic root field

A nonidentity automorphism of a field generated by a root of a separable irreducible quintic
makes that degree-five extension Galois. It is therefore the splitting field of the quintic,
and the Galois group has order five. The degree-five transitive-group classification
identifies its label as `5T1`.

The criterion reads the extra datum that distinguishes the cyclic group from the dihedral
group in the quintic certificate: a second root inside the simple root field induces such
an automorphism.
-/

public section
noncomputable section

open Polynomial IntermediateField

namespace TauCeti

/-- A separable irreducible quintic with a nontrivial automorphism of its root field has label
`5T1`. The root field `E` is specified by a generator `x` whose minimal polynomial is `q`. -/
theorem hasGaloisLabel_five_zero_of_rootField_aut
    {F : Type*} [Field F] {q : F[X]} (hirr : Irreducible q) (hsep : q.Separable)
    (hdeg : q.natDegree = 5)
    (E : Type*) [Field E] [Algebra F E] (x : E)
    (hminpoly : minpoly F x = q) (hgen : F⟮x⟯ = ⊤)
    (hAut : ∃ σ : E ≃ₐ[F] E, σ ≠ 1) :
    HasGaloisLabel q (⟨0, by simp⟩ : TransitiveGroupIndex 5) := by
  have hx : IsIntegral F x := minpoly.ne_zero_iff.mp (hminpoly ▸ hirr.ne_zero)
  have hfin : FiniteDimensional F F⟮x⟯ := adjoin.finiteDimensional hx
  rw [hgen] at hfin
  have : FiniteDimensional F E := topEquiv.toLinearEquiv.finiteDimensional
  have hfinrank : Module.finrank F E = 5 := by
    rw [← finrank_top', ← hgen, adjoin.finrank hx, hminpoly]
    exact hdeg
  have hgal : IsGalois F E :=
    isGalois_of_prime_finrank_of_exists_aut_ne_one F E
      (hfinrank ▸ (by decide : Nat.Prime 5)) hAut
  have hsplit : (q.map (algebraMap F E)).Splits := by
    simpa only [hminpoly] using (Normal.splits hgal.to_normal x)
  have : q.IsSplittingField F E := by
    refine ⟨hsplit, ?_⟩
    apply top_unique
    calc
      (⊤ : Subalgebra F E) = Algebra.adjoin F ({x} : Set E) := by
        rw [← adjoin_simple_toSubalgebra_of_isAlgebraic hx.isAlgebraic, hgen]
        rfl
      _ ≤ Algebra.adjoin F (q.rootSet E) := Algebra.adjoin_mono
        (Set.singleton_subset_iff.mpr (by
          rw [mem_rootSet_of_ne hirr.ne_zero, ← hminpoly]
          exact minpoly.aeval F x))
  have hcard : Nat.card q.Gal = 5 := by
    let e : q.SplittingField ≃ₐ[F] E := (IsSplittingField.algEquiv E q).symm
    have h := Nat.card_congr e.autCongr.toEquiv
    simpa only [Polynomial.Gal, IsGalois.card_aut_eq_finrank, hfinrank] using h
  obtain ⟨j, hlabel, -⟩ := existsUnique_hasGaloisLabel_five hsep hirr hdeg
  have hjcard := hlabel.natCard_gal
  rw [hcard] at hjcard
  have hindex : j = (⟨0, by simp⟩ : TransitiveGroupIndex 5) := by
    have hjbound : j.val < 5 := by simpa using j.isLt
    interval_cases h : j.val
    · exact Fin.ext h
    · have hj' : j = ⟨1, by simp⟩ := Fin.ext h
      rw [hj', natCard_referenceSubgroup_five_one] at hjcard
      omega
    · have hj' : j = ⟨2, by simp⟩ := Fin.ext h
      rw [hj', natCard_referenceSubgroup_five_two] at hjcard
      omega
    · have hj' : j = ⟨3, by simp⟩ := Fin.ext h
      rw [hj', natCard_referenceSubgroup_five_three] at hjcard
      omega
    · have hj' : j = ⟨4, by simp⟩ := Fin.ext h
      rw [hj', natCard_referenceSubgroup_five_four] at hjcard
      omega
  exact hindex ▸ hlabel

end TauCeti
