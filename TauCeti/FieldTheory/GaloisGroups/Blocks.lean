module

public import TauCeti.FieldTheory.GaloisGroups.Orbits
public import TauCeti.FieldTheory.Galois.Blocks
public import TauCeti.GroupTheory.Perm.Blocks
import Mathlib.GroupTheory.GroupAction.Pointwise
import TauCeti.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Blocks of a polynomial Galois action

For an irreducible separable polynomial, the action on its roots is the action on one Galois
orbit. Transporting the orbitwise block–intermediate-field correspondence to the root set sends
a block to the field fixed by its setwise stabilizer. Its inverse takes the roots of the chosen
root's minimal polynomial over the intermediate field. The correspondence identifies primitivity
of the root action with the absence of proper intermediate fields in the simple extension
generated by a root.

## Main results

* `TauCeti.rootSetBlockMemOrderIsoOrbit`: transport blocks on an irreducible polynomial's root
  set to blocks on a Galois orbit, for use with the orbitwise field correspondence.
* `TauCeti.rootBlockIntermediateFieldOrderIso`: blocks containing a root are order anti-isomorphic
  to intermediate fields contained in the field generated by that root.
* `TauCeti.coe_rootBlockIntermediateFieldOrderIso_symm_apply_eq_preimage_rootSet_minpoly`: the
  block attached to an intermediate field consists of the roots of the corresponding minimal
  polynomial in the root set.
* `TauCeti.isPreprimitive_iff_isAtom_adjoin_simple`: the root action is primitive exactly when
  the generated simple extension is an atom in the lattice of intermediate fields.
* `TauCeti.isPreprimitive_of_natDegree_le_one`: in degree at most one the root action is
  primitive, although the root generates the bottom intermediate field, which is not an atom.
* `TauCeti.isAtom_adjoin_simple_iff`: the generated simple extension is an atom exactly when the
  polynomial has degree at least two and the root action is primitive.
* `TauCeti.isPreprimitive_of_irreducible_of_separable_of_prime_natDegree`: an irreducible
  separable polynomial of prime degree has a primitive root action.

## References

* H. Wielandt, *Finite Permutation Groups*, Theorem 7.5
* J. D. Dixon and B. Mortimer, *Permutation Groups*, Section 1.5
-/

public section

namespace TauCeti

open scoped Pointwise

open _root_.IntermediateField MulAction Polynomial

universe u

variable {F : Type u} [Field F] {p : F[X]}

/-- Transport blocks containing a root of an irreducible polynomial to blocks containing the
same element in its Galois orbit. Composing with `orbitBlockIntermediateFieldOrderIso` gives the
block–intermediate-field correspondence on the root set of a separable polynomial. -/
noncomputable def rootSetBlockMemOrderIsoOrbit (hp : Irreducible p)
    (x : p.rootSet p.SplittingField) :
    BlockMem p.Gal x ≃o
      BlockMem p.Gal
        (⟨(x : p.SplittingField), mem_orbit_self _⟩ : orbit p.Gal (x : p.SplittingField)) :=
  let e := rootSetEquivOrbit hp x.2
  let he : e x =
      (⟨(x : p.SplittingField), mem_orbit_self _⟩ : orbit p.Gal (x : p.SplittingField)) :=
    Subtype.ext (coe_rootSetEquivOrbit_apply hp x.2 x)
  (blockMemOrderIsoCongr p.Gal e (fun g y ↦ by
    simpa only [coe_rootSetToOrbit] using (rootSetToOrbit hp x.2).map_smul g y) x).trans
    (Set.orderIsoOfEq {B | e x ∈ B ∧ IsBlock p.Gal B}
      {B | ⟨(x : p.SplittingField), mem_orbit_self _⟩ ∈ B ∧ IsBlock p.Gal B} (by rw [he]))

/-- The transported block is the image under the root-to-orbit identification. -/
@[simp]
theorem coe_rootSetBlockMemOrderIsoOrbit_apply (hp : Irreducible p)
    (x : p.rootSet p.SplittingField) (B : BlockMem p.Gal x) :
    (rootSetBlockMemOrderIsoOrbit hp x B : Set (orbit p.Gal (x : p.SplittingField))) =
      rootSetEquivOrbit hp x.2 '' (B : Set (p.rootSet p.SplittingField)) := by
  unfold rootSetBlockMemOrderIsoOrbit
  -- Adjusting the distinguished point preserves the underlying block.
  dsimp only [OrderIso.trans_apply, Set.orderIsoOfEq, Set.equivOfEq]
  exact coe_blockMemOrderIsoCongr_apply _ _ _ _ B

/-- Transporting an orbit block back to the roots takes its preimage under the identification. -/
@[simp]
theorem coe_rootSetBlockMemOrderIsoOrbit_symm_apply (hp : Irreducible p)
    (x : p.rootSet p.SplittingField)
    (B : BlockMem p.Gal
      (⟨(x : p.SplittingField), mem_orbit_self _⟩ : orbit p.Gal (x : p.SplittingField))) :
    ((rootSetBlockMemOrderIsoOrbit hp x).symm B : Set (p.rootSet p.SplittingField)) =
      rootSetEquivOrbit hp x.2 ⁻¹' (B : Set (orbit p.Gal (x : p.SplittingField))) := by
  unfold rootSetBlockMemOrderIsoOrbit
  rw [OrderIso.symm_trans, OrderIso.trans_apply, coe_blockMemOrderIsoCongr_symm_apply]
  -- Adjusting the distinguished point preserves the underlying block.
  rfl

/-- Blocks containing a root of an irreducible separable polynomial correspond contravariantly
to the intermediate fields of its simple extension. This transports the orbitwise correspondence
to the polynomial's root set. -/
noncomputable def rootBlockIntermediateFieldOrderIso
    (hp : Irreducible p) (hsep : p.Separable) (x : p.rootSet p.SplittingField) :
    BlockMem p.Gal x ≃o (Set.Iic F⟮(x : p.SplittingField)⟯)ᵒᵈ :=
  letI : IsGalois F p.SplittingField := IsGalois.of_separable_splitting_field hsep
  (rootSetBlockMemOrderIsoOrbit hp x).trans
    (orbitBlockIntermediateFieldOrderIso p.Gal F (x : p.SplittingField))

/-- The field attached to a root block is the fixed field of its setwise stabilizer. -/
theorem rootBlockIntermediateFieldOrderIso_apply
    (hp : Irreducible p) (hsep : p.Separable)
    (x : p.rootSet p.SplittingField) (B : BlockMem p.Gal x) :
    ((rootBlockIntermediateFieldOrderIso hp hsep x B).ofDual.1 :
      IntermediateField F p.SplittingField) =
      FixedPoints.intermediateField (stabilizer p.Gal (B : Set (p.rootSet p.SplittingField))) := by
  let _ : IsGalois F p.SplittingField := IsGalois.of_separable_splitting_field hsep
  let e := rootSetEquivOrbit hp x.2
  have hstab : stabilizer p.Gal
      (rootSetBlockMemOrderIsoOrbit hp x B : Set (orbit p.Gal (x : p.SplittingField))) =
      stabilizer p.Gal (B : Set (p.rootSet p.SplittingField)) := by
    rw [coe_rootSetBlockMemOrderIsoOrbit_apply]
    ext g
    have himage : e '' (g • (B : Set (p.rootSet p.SplittingField))) =
        g • e '' (B : Set (p.rootSet p.SplittingField)) := by
      simpa only [coe_rootSetToOrbit] using image_smul_set (rootSetToOrbit hp x.2) g
        (B : Set (p.rootSet p.SplittingField))
    rw [mem_stabilizer_iff, mem_stabilizer_iff, ← himage]
    exact e.injective.image_injective.eq_iff
  unfold rootBlockIntermediateFieldOrderIso
  rw [OrderIso.trans_apply, orbitBlockIntermediateFieldOrderIso_apply, hstab]

/-- An element belongs to the field attached to a root block exactly when every element of the
block's setwise stabilizer fixes it. -/
@[simp]
theorem mem_rootBlockIntermediateFieldOrderIso_apply_iff
    (hp : Irreducible p) (hsep : p.Separable)
    (x : p.rootSet p.SplittingField) (B : BlockMem p.Gal x) (y : p.SplittingField) :
    y ∈ (rootBlockIntermediateFieldOrderIso hp hsep x B).ofDual.1 ↔
      ∀ g ∈ stabilizer p.Gal (B : Set (p.rootSet p.SplittingField)), g • y = y := by
  rw [rootBlockIntermediateFieldOrderIso_apply, FixedPoints.mem_intermediateField_iff]
  exact ⟨fun h g hg ↦ h ⟨g, hg⟩, fun h g ↦ h g g.2⟩

/-- The block attached to an intermediate field consists of the roots of the chosen root's
minimal polynomial over that field, viewed inside the polynomial's root set. -/
@[simp]
theorem coe_rootBlockIntermediateFieldOrderIso_symm_apply_eq_preimage_rootSet_minpoly
    (hp : Irreducible p) (hsep : p.Separable)
    (x : p.rootSet p.SplittingField) (E : Set.Iic F⟮(x : p.SplittingField)⟯) :
    (((rootBlockIntermediateFieldOrderIso hp hsep x).symm (OrderDual.toDual E)) :
      Set (p.rootSet p.SplittingField)) =
      Subtype.val ⁻¹' (minpoly E.1 (x : p.SplittingField)).rootSet p.SplittingField := by
  let _ : IsGalois F p.SplittingField := IsGalois.of_separable_splitting_field hsep
  unfold rootBlockIntermediateFieldOrderIso
  rw [OrderIso.symm_trans, OrderIso.trans_apply,
    coe_rootSetBlockMemOrderIsoOrbit_symm_apply,
    coe_orbitBlockIntermediateFieldOrderIso_symm_apply_eq_preimage_rootSet_minpoly]
  ext y
  simp only [Set.mem_preimage, coe_rootSetEquivOrbit_apply]

/-- **The Galois action on the roots is primitive exactly when the simple extension generated by
a root has no proper intermediate fields.** The degree assumption excludes the one-point action,
whose generated intermediate field is bottom and hence not an atom. -/
theorem isPreprimitive_iff_isAtom_adjoin_simple
    (hp : Irreducible p) (hsep : p.Separable) (hdeg : 1 < p.natDegree)
    (x : p.rootSet p.SplittingField) :
    IsPreprimitive p.Gal (p.rootSet p.SplittingField) ↔
      IsAtom F⟮(x : p.SplittingField)⟯ := by
  let _ : IsGalois F p.SplittingField := IsGalois.of_separable_splitting_field hsep
  let e := rootSetEquivOrbit hp x.2
  have hx : F⟮(x : p.SplittingField)⟯ ≠ ⊥ := by
    rw [Ne, IntermediateField.adjoin_simple_eq_bot_iff_natDegree_eq_one hp (mem_rootSet.mp x.2).2]
    exact hdeg.ne'
  rw [isPreprimitive_congr (f := rootSetToOrbit hp x.2) Function.surjective_id
    (by simpa only [coe_rootSetToOrbit] using e.bijective)]
  exact isPreprimitive_orbit_iff_isAtom_adjoin_simple (G := p.Gal) _ hx

/-- The Galois action on the roots of a polynomial of degree at most one is primitive, being an
action on at most one point. The root of a linear polynomial generates the bottom intermediate
field, which is not an atom, so the degree hypothesis of `isPreprimitive_iff_isAtom_adjoin_simple`
cannot be dropped. -/
theorem isPreprimitive_of_natDegree_le_one (hdeg : p.natDegree ≤ 1) :
    IsPreprimitive p.Gal (p.rootSet p.SplittingField) := by
  have : Subsingleton (p.rootSet p.SplittingField) := by
    rw [Set.subsingleton_coe, ← Set.ncard_le_one_iff_subsingleton]
    exact (ncard_rootSet_le p p.SplittingField).trans hdeg
  exact IsPreprimitive.of_subsingleton

/-- **The simple extension generated by a root is an atom exactly when the polynomial has degree
at least two and its Galois action on the roots is primitive.** This form of
`isPreprimitive_iff_isAtom_adjoin_simple` has no degree hypothesis: in degree one the root lies in
the base field, so the generated intermediate field is bottom, while the action is primitive by
`isPreprimitive_of_natDegree_le_one`. -/
theorem isAtom_adjoin_simple_iff
    (hp : Irreducible p) (hsep : p.Separable) (x : p.rootSet p.SplittingField) :
    IsAtom F⟮(x : p.SplittingField)⟯ ↔
      1 < p.natDegree ∧ IsPreprimitive p.Gal (p.rootSet p.SplittingField) := by
  refine ⟨fun h ↦ ?_, fun ⟨hdeg, hprim⟩ ↦
    (isPreprimitive_iff_isAtom_adjoin_simple hp hsep hdeg x).mp hprim⟩
  have hdeg : 1 < p.natDegree := lt_of_le_of_ne hp.natDegree_pos fun hdeg ↦
    h.ne_bot ((IntermediateField.adjoin_simple_eq_bot_iff_natDegree_eq_one hp
      (mem_rootSet.mp x.2).2).mpr hdeg.symm)
  exact ⟨hdeg, (isPreprimitive_iff_isAtom_adjoin_simple hp hsep hdeg x).mpr h⟩

/-- An irreducible separable polynomial of prime degree has a primitive Galois action on its
roots. -/
theorem isPreprimitive_of_irreducible_of_separable_of_prime_natDegree
    (hp : Irreducible p) (hsep : p.Separable) (hprime : p.natDegree.Prime) :
    IsPreprimitive p.Gal (p.rootSet p.SplittingField) := by
  let _ : IsPretransitive p.Gal (p.rootSet p.SplittingField) :=
    Gal.galActionAux_isPretransitive hp
  apply IsPreprimitive.of_prime_card
  rw [Nat.card_eq_fintype_card,
    card_rootSet_eq_natDegree hsep (SplittingField.splits p)]
  exact hprime

end TauCeti
