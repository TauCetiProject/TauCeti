module

public import TauCeti.FieldTheory.GaloisGroups.Stabilizer
public import TauCeti.FieldTheory.Galois.Blocks

/-!
# Blocks of a polynomial Galois action

For an irreducible separable polynomial, the action on its roots is the action on one Galois
orbit. Specializing the orbitwise block–intermediate-field correspondence identifies primitivity
of the root action with the absence of proper intermediate fields in the simple extension
generated by a root.

## Main results

* `TauCeti.isPreprimitive_iff_isAtom_adjoin_simple`: the root action is primitive exactly when
  the generated simple extension is an atom in the lattice of intermediate fields.
* `TauCeti.isPreprimitive_of_irreducible_of_separable_of_prime_natDegree`: an irreducible
  separable polynomial of prime degree has a primitive root action.

## References

* H. Wielandt, *Finite Permutation Groups*, Theorem 7.5
* J. D. Dixon and B. Mortimer, *Permutation Groups*, Section 1.5
-/

public section

namespace TauCeti

open scoped Pointwise

open IntermediateField MulAction Polynomial

universe u

variable {F : Type u} [Field F] {p : F[X]}

/-- **The Galois action on the roots is primitive exactly when the simple extension generated by
a root has no proper intermediate fields.** The degree assumption excludes the one-point action,
whose generated intermediate field is bottom and hence not an atom. -/
theorem isPreprimitive_iff_isAtom_adjoin_simple
    (hp : Irreducible p) (hsep : p.Separable) (hdeg : 1 < p.natDegree)
    (x : p.rootSet p.SplittingField) :
    IsPreprimitive p.Gal (p.rootSet p.SplittingField) ↔
      IsAtom F⟮(x : p.SplittingField)⟯ := by
  let _ : IsGalois F p.SplittingField := IsGalois.of_separable_splitting_field hsep
  have hroot : (p.rootSet p.SplittingField : Set p.SplittingField) =
      orbit p.Gal (x : p.SplittingField) :=
    coe_rootSet_eq_orbit_of_irreducible hp x.2
  -- Changing the subtype membership proof preserves the underlying field element.
  let e := Set.equivOfEq hroot
  let f : p.rootSet p.SplittingField →[p.Gal] orbit p.Gal (x : p.SplittingField) :=
    { toFun := e
      map_smul' := fun g y ↦ Subtype.ext (Gal.coe_smul g y) }
  have hx : F⟮(x : p.SplittingField)⟯ ≠ ⊥ := by
    intro h
    have hdegree : Module.finrank F F⟮(x : p.SplittingField)⟯ = p.natDegree := by
      rw [adjoin.finrank (IsIntegral.of_finite F _),
        ← minpoly.eq_of_irreducible hp (mem_rootSet.mp x.2).2,
        natDegree_mul_C (inv_ne_zero (leadingCoeff_ne_zero.mpr hp.ne_zero))]
    rw [h, IntermediateField.finrank_bot] at hdegree
    omega
  rw [isPreprimitive_congr (f := f) Function.surjective_id e.bijective]
  exact isPreprimitive_orbit_iff_isAtom_adjoin_simple (G := p.Gal) _ hx

/-- An irreducible separable polynomial of prime degree has a primitive Galois action on its
roots. -/
theorem isPreprimitive_of_irreducible_of_separable_of_prime_natDegree
    (hp : Irreducible p) (hsep : p.Separable) (hprime : p.natDegree.Prime) :
    IsPreprimitive p.Gal (p.rootSet p.SplittingField) := by
  let _ : IsPretransitive p.Gal (p.rootSet p.SplittingField) :=
    Gal.galActionAux_isPretransitive hp
  apply IsPreprimitive.of_prime_card
  rw [Nat.card_eq_fintype_card,
    card_rootSet_eq_natDegree hsep (SplittingField.splits p)]
  exact hprime

end TauCeti
