/-!
# Polynomial Galois groups and normal closures

Whenever an element `x` of a field extension `E / F` is integral over `F` and `minpoly F x` splits
in `E` (in particular when `E / F` is normal or `E` is algebraically closed), the splitting field
of `minpoly F x` is isomorphic over `F` to the normal closure of `F⟮x⟯` inside `E`. Conjugation by
that field isomorphism identifies `(minpoly F x).Gal` with `Gal(normalClosure F F⟮x⟯ E/F)` — and
more generally with `Gal(normalClosure F K E/F)` whenever `F⟮x⟯ = K`
(`galNormalClosureEquivGalMinpoly`).

The comparison respects the intrinsic action on roots: a point stabilizer maps to the subgroup
fixing the field generated by the corresponding root. For a separable minimal polynomial, this
subgroup has index `[F(x) : F]`. Thus the group together with a point stabilizer recovers the
simple extension inside its normal closure. No ordering of roots is chosen.

Inside an algebraically closed ambient field `Ω`, for any algebraic intermediate field `K / F` and
any `x ∈ K`, restriction of automorphisms along `normalClosure F F⟮x⟯ Ω ≤ normalClosure F K Ω`
induces a surjective homomorphism `restrictGalMinpolyHom : Gal(normalClosure F K Ω/F) →*
(minpoly F x).Gal` intertwining the Galois actions along `splittingFieldEquivNormalClosure` and the
ambient normal-closure inclusion (`restrictGalMinpolyHom_commutes`). Surjectivity transfers
solvability to `(minpoly F x).Gal`, makes `|(minpoly F x).Gal|` divide
`Nat.card Gal(normalClosure F K Ω/F)`, and agrees with `galNormalClosureEquivGalMinpoly` whenever
`F⟮x⟯ = K`.

## References

* Serge Lang, *Algebra*, revised 3rd ed., Graduate Texts in Mathematics 211, Springer, 2002,
  Chapter V, §3 and Chapter VI, §1.
-/

/- The field isomorphism uses Mathlib's `Polynomial.IsSplittingField.algEquiv`; the
group isomorphism is induced by `AlgEquiv.autCongr`. -/

public section

namespace TauCeti

open IntermediateField Polynomial MulAction

section Splits

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- When `x` is integral over `F` and `minpoly F x` splits in `E`, the splitting field of
`minpoly F x` is isomorphic over `F` to the normal closure of `F⟮x⟯` in `E`. -/
noncomputable def splittingFieldEquivNormalClosure {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) :
    (minpoly F x).SplittingField ≃ₐ[F] normalClosure F F⟮x⟯ E :=
  letI := isSplittingField_normalClosure_adjoin_simple hx hsplit
  (IsSplittingField.algEquiv _ (minpoly F x)).symm

/-- The Galois group of `minpoly F x` is isomorphic to the automorphism group of the normal closure
of `F⟮x⟯` in `E`, via conjugation by `splittingFieldEquivNormalClosure`. -/
noncomputable def galEquivNormalClosure {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) :
    (minpoly F x).Gal ≃*
      (normalClosure F F⟮x⟯ E ≃ₐ[F] normalClosure F F⟮x⟯ E) :=
  (splittingFieldEquivNormalClosure hx hsplit).autCongr

/-- The group comparison intertwines evaluation with the field comparison. -/
@[simp]
theorem galEquivNormalClosure_apply {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) (σ : (minpoly F x).Gal)
    (y : (minpoly F x).SplittingField) :
    galEquivNormalClosure hx hsplit σ (splittingFieldEquivNormalClosure hx hsplit y) =
      splittingFieldEquivNormalClosure hx hsplit (σ y) :=
  congrArg (fun z ↦ splittingFieldEquivNormalClosure hx hsplit (σ z))
    ((splittingFieldEquivNormalClosure hx hsplit).symm_apply_apply y)

/-- `(galEquivNormalClosure hx hsplit).symm` intertwines the Galois actions with
`splittingFieldEquivNormalClosure`. -/
@[simp]
theorem galEquivNormalClosure_symm_commutes {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (τ : Gal(normalClosure F F⟮x⟯ E/F)) (y : (minpoly F x).SplittingField) :
    splittingFieldEquivNormalClosure hx hsplit
        ((galEquivNormalClosure hx hsplit).symm τ y) =
      τ (splittingFieldEquivNormalClosure hx hsplit y) := by
  simpa using (galEquivNormalClosure_apply hx hsplit
    ((galEquivNormalClosure hx hsplit).symm τ) y).symm

/-- A point stabilizer corresponds to the subgroup fixing the simple field generated
by the corresponding root in the normal closure. The action on the source is the
intrinsic action on the roots in the splitting field. -/
theorem map_stabilizer_galEquivNormalClosure {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField) :
    (stabilizer (minpoly F x).Gal y).map (galEquivNormalClosure hx hsplit).toMonoidHom =
      F⟮splittingFieldEquivNormalClosure hx hsplit
        (y : (minpoly F x).SplittingField)⟯.fixingSubgroup := by
  ext σ
  rw [Subgroup.mem_map_equiv, mem_stabilizer_iff, Subtype.ext_iff,
    Polynomial.Gal.coe_smul, fixingSubgroup_adjoin_simple,
    mem_stabilizer_iff]
  have h := galEquivNormalClosure_apply hx hsplit ((galEquivNormalClosure hx hsplit).symm σ)
    (y : (minpoly F x).SplittingField)
  rw [MulEquiv.apply_symm_apply] at h
  rw [← (splittingFieldEquivNormalClosure hx hsplit).injective.eq_iff, ← h]
  rfl

/-- There is a root corresponding to the original generator `x`, and its stabilizer
maps to the subgroup fixing the original simple extension inside its normal closure.
In particular, the comparison identifies this field, rather than only an unspecified
conjugate of it. -/
theorem exists_root_map_stabilizer_eq_fixingSubgroup {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) :
    ∃ y : (minpoly F x).rootSet (minpoly F x).SplittingField,
      (splittingFieldEquivNormalClosure hx hsplit y : E) = x ∧
      (stabilizer (minpoly F x).Gal y).map (galEquivNormalClosure hx hsplit).toMonoidHom =
        (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup := by
  let N := normalClosure F F⟮x⟯ E
  let a : N := ⟨x, le_normalClosure F⟮x⟯ (mem_adjoin_simple_self F x)⟩
  have ha : a ∈ (minpoly F x).rootSet N := by
    rw [mem_rootSet_of_ne (minpoly.ne_zero hx)]
    apply N.val.injective
    rw [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      ← aeval_algHom_apply N.val, map_zero]
    exact minpoly.aeval F x
  let e := splittingFieldEquivNormalClosure hx hsplit
  let y : (minpoly F x).rootSet (minpoly F x).SplittingField :=
    ⟨e.symm a, rootSet_mapsTo e.symm.toAlgHom ha⟩
  refine ⟨y, ?_, ?_⟩
  · exact congrArg Subtype.val (e.apply_symm_apply a)
  · rw [map_stabilizer_galEquivNormalClosure]
    have he : splittingFieldEquivNormalClosure hx hsplit y = a := e.apply_symm_apply a
    rw [he]
    congr 1
    apply lift_injective N
    rw [lift_adjoin_simple, lift_restrict]

/-- When the minimal polynomial is separable, the image of a point stabilizer has
index equal to the degree of the original simple extension. -/
theorem index_map_stabilizer_galEquivNormalClosure {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (hsep : (minpoly F x).Separable)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField) :
    ((stabilizer (minpoly F x).Gal y).map
      (galEquivNormalClosure hx hsplit).toMonoidHom).index = Module.finrank F F⟮x⟯ := by
  rw [MulEquiv.toMonoidHom_eq_coe, Subgroup.index_map_equiv,
    index_stabilizer_eq_natDegree (minpoly.irreducible hx) hsep,
    adjoin.finrank hx]

/-- When `x` generates `K` over `F` and `minpoly F x` splits in `E`, `Gal(normalClosure F K E/F)`
is isomorphic to `(minpoly F x).Gal`. -/
noncomputable def galNormalClosureEquivGalMinpoly {K : IntermediateField F E} {x : E}
    (hx : IsIntegral F x) (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (hK : F⟮x⟯ = K) :
    Gal(normalClosure F K E/F) ≃* (minpoly F x).Gal :=
  (IntermediateField.equivOfEq
    (congrArg (fun L : IntermediateField F E ↦ normalClosure F L E) hK.symm)).autCongr.trans
    (galEquivNormalClosure hx hsplit).symm

/-- `galNormalClosureEquivGalMinpoly` intertwines the Galois action on
`(minpoly F x).SplittingField` with `Gal(normalClosure F K E/F)` along
`splittingFieldEquivNormalClosure` and the ambient normal-closure inclusion. -/
@[simp]
theorem galNormalClosureEquivGalMinpoly_commutes {K : IntermediateField F E} {x : E}
    (hx : IsIntegral F x) (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (hK : F⟮x⟯ = K) (hle : normalClosure F F⟮x⟯ E ≤ normalClosure F K E)
    (σ : Gal(normalClosure F K E/F)) (y : (minpoly F x).SplittingField) :
    IntermediateField.inclusion hle
        (splittingFieldEquivNormalClosure hx hsplit
          (galNormalClosureEquivGalMinpoly hx hsplit hK σ y)) =
      σ (IntermediateField.inclusion hle
        (splittingFieldEquivNormalClosure hx hsplit y)) := by
  let eqL : normalClosure F K E = normalClosure F F⟮x⟯ E :=
    congrArg (fun L : IntermediateField F E ↦ normalClosure F L E) hK.symm
  have heq : (IntermediateField.equivOfEq eqL).symm
      (splittingFieldEquivNormalClosure hx hsplit y) =
    IntermediateField.inclusion hle
      (splittingFieldEquivNormalClosure hx hsplit y) := Subtype.ext rfl
  refine Subtype.ext ?_
  change (splittingFieldEquivNormalClosure hx hsplit
      ((galEquivNormalClosure hx hsplit).symm
        ((IntermediateField.equivOfEq eqL).autCongr σ) y) : E) = _
  rw [galEquivNormalClosure_symm_commutes, AlgEquiv.autCongr_apply,
    AlgEquiv.trans_apply, AlgEquiv.trans_apply, heq, IntermediateField.equivOfEq_apply]

/-- Ambient-field form of `galNormalClosureEquivGalMinpoly_commutes`. -/
@[simp]
theorem coe_galNormalClosureEquivGalMinpoly_commutes {K : IntermediateField F E} {x : E}
    (hx : IsIntegral F x) (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (hK : F⟮x⟯ = K) (σ : Gal(normalClosure F K E/F))
    (y : (minpoly F x).SplittingField) :
    (splittingFieldEquivNormalClosure hx hsplit
        (galNormalClosureEquivGalMinpoly hx hsplit hK σ y) : E) =
      (σ (IntermediateField.inclusion
        (le_of_eq (congrArg (fun L : IntermediateField F E ↦ normalClosure F L E) hK))
        (splittingFieldEquivNormalClosure hx hsplit y)) : E) :=
  congrArg Subtype.val (galNormalClosureEquivGalMinpoly_commutes hx hsplit hK
    (le_of_eq (congrArg (fun L : IntermediateField F E ↦ normalClosure F L E) hK)) σ y)

/-- `(galNormalClosureEquivGalMinpoly hx hsplit hK).symm` intertwines `(minpoly F x).Gal` with
`Gal(normalClosure F K E/F)` along `splittingFieldEquivNormalClosure` and the ambient
normal-closure inclusion. -/
@[simp]
theorem galNormalClosureEquivGalMinpoly_symm_apply {K : IntermediateField F E} {x : E}
    (hx : IsIntegral F x) (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (hK : F⟮x⟯ = K) (hle : normalClosure F F⟮x⟯ E ≤ normalClosure F K E)
    (τ : (minpoly F x).Gal) (y : (minpoly F x).SplittingField) :
    (galNormalClosureEquivGalMinpoly hx hsplit hK).symm τ
        (IntermediateField.inclusion hle
          (splittingFieldEquivNormalClosure hx hsplit y)) =
      IntermediateField.inclusion hle
        (splittingFieldEquivNormalClosure hx hsplit (τ y)) := by
  simpa using (galNormalClosureEquivGalMinpoly_commutes hx hsplit hK hle
    ((galNormalClosureEquivGalMinpoly hx hsplit hK).symm τ) y).symm

/-- When `F⟮x⟯ = K` and `minpoly F x` splits in `E`, `Gal(normalClosure F K E/F)` is solvable if
and only if `(minpoly F x).Gal` is solvable. -/
theorem isSolvable_gal_normalClosure_iff_of_adjoin_eq {K : IntermediateField F E} {x : E}
    (hx : IsIntegral F x) (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (hK : F⟮x⟯ = K) :
    Group.IsSolvable Gal(normalClosure F K E/F) ↔ Group.IsSolvable (minpoly F x).Gal :=
  (galNormalClosureEquivGalMinpoly hx hsplit hK).isSolvable_congr

/-- When `F⟮x⟯ = K` and `minpoly F x` splits in `E`, `Gal(normalClosure F K E/F)` and
`(minpoly F x).Gal` have the same cardinality. -/
theorem natCard_gal_normalClosure_eq_of_adjoin_eq {K : IntermediateField F E} {x : E}
    (hx : IsIntegral F x) (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (hK : F⟮x⟯ = K) :
    Nat.card Gal(normalClosure F K E/F) = Nat.card (minpoly F x).Gal :=
  Nat.card_congr (galNormalClosureEquivGalMinpoly hx hsplit hK).toEquiv

end Splits

section AlgClosed

variable {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω] [IsAlgClosed Ω]
  {K : IntermediateField F Ω}

/-- Restriction of automorphisms from `Gal(normalClosure F K Ω/F)` to `(minpoly F x).Gal` for an
element `x ∈ K` of an algebraic intermediate field `K` inside `[IsAlgClosed Ω]`. -/
noncomputable def restrictGalMinpolyHom [Algebra.IsAlgebraic F K] {x : Ω} (hx : x ∈ K) :
    Gal(normalClosure F K Ω/F) →* (minpoly F x).Gal :=
  have hx_int : IsIntegral F x :=
    IntermediateField.isIntegral_iff.mp (Algebra.IsIntegral.isIntegral (⟨x, hx⟩ : K))
  letI : FiniteDimensional F F⟮x⟯ := adjoin.finiteDimensional hx_int
  letI : Normal F (normalClosure F F⟮x⟯ Ω) := normal_normalClosure_of_isAlgClosed F⟮x⟯
  have hle : normalClosure F F⟮x⟯ Ω ≤ normalClosure F K Ω :=
    normalClosure_mono_of_isAlgClosed (adjoin_simple_le_iff.mpr hx)
  (galEquivNormalClosure hx_int (IsAlgClosed.splits _)).symm.toMonoidHom.comp
    (IntermediateField.inclusion hle).restrictNormalHom

/-- `restrictGalMinpolyHom` intertwines the Galois action on `(minpoly F x).SplittingField` with
the action of `Gal(normalClosure F K Ω/F)` along `splittingFieldEquivNormalClosure` and the ambient
normal-closure inclusion. -/
@[simp]
theorem restrictGalMinpolyHom_commutes [Algebra.IsAlgebraic F K] {x : Ω} (hx : x ∈ K)
    (hx_int : IsIntegral F x) (hsplit : ((minpoly F x).map (algebraMap F Ω)).Splits)
    (hle : normalClosure F F⟮x⟯ Ω ≤ normalClosure F K Ω)
    (σ : Gal(normalClosure F K Ω/F)) (y : (minpoly F x).SplittingField) :
    IntermediateField.inclusion hle
        (splittingFieldEquivNormalClosure hx_int hsplit
          (restrictGalMinpolyHom hx σ y)) =
      σ (IntermediateField.inclusion hle
        (splittingFieldEquivNormalClosure hx_int hsplit y)) := by
  let _ : FiniteDimensional F F⟮x⟯ := adjoin.finiteDimensional hx_int
  let _ : Normal F (normalClosure F F⟮x⟯ Ω) := normal_normalClosure_of_isAlgClosed F⟮x⟯
  change IntermediateField.inclusion hle
      (splittingFieldEquivNormalClosure hx_int hsplit
        ((galEquivNormalClosure hx_int hsplit).symm
          ((IntermediateField.inclusion hle).restrictNormalHom σ) y)) = _
  rw [galEquivNormalClosure_symm_commutes, AlgHom.restrictNormalHom_commutes]

/-- Ambient-field form of `restrictGalMinpolyHom_commutes`: coerced to `Ω`,
`splittingFieldEquivNormalClosure` intertwines `restrictGalMinpolyHom hx σ` with `σ`. -/
@[simp]
theorem coe_restrictGalMinpolyHom_commutes [Algebra.IsAlgebraic F K] {x : Ω} (hx : x ∈ K)
    (hx_int : IsIntegral F x) (hsplit : ((minpoly F x).map (algebraMap F Ω)).Splits)
    (σ : Gal(normalClosure F K Ω/F)) (y : (minpoly F x).SplittingField) :
    (splittingFieldEquivNormalClosure hx_int hsplit
        (restrictGalMinpolyHom hx σ y) : Ω) =
      (σ (IntermediateField.inclusion
        (normalClosure_mono_of_isAlgClosed (adjoin_simple_le_iff.mpr hx))
        (splittingFieldEquivNormalClosure hx_int hsplit y)) : Ω) :=
  congrArg Subtype.val (restrictGalMinpolyHom_commutes hx hx_int hsplit
    (normalClosure_mono_of_isAlgClosed (adjoin_simple_le_iff.mpr hx)) σ y)

/-- **Restriction from `Gal(normalClosure F K Ω/F)` to `(minpoly F x).Gal` is surjective** for
every element `x ∈ K` of an algebraic intermediate field `K` inside `[IsAlgClosed Ω]`. -/
theorem restrictGalMinpolyHom_surjective [Algebra.IsAlgebraic F K] {x : Ω} (hx : x ∈ K) :
    Function.Surjective (restrictGalMinpolyHom hx) := by
  have hx_int : IsIntegral F x :=
    IntermediateField.isIntegral_iff.mp (Algebra.IsIntegral.isIntegral (⟨x, hx⟩ : K))
  let _ : FiniteDimensional F F⟮x⟯ := adjoin.finiteDimensional hx_int
  let _ : Normal F (normalClosure F F⟮x⟯ Ω) := normal_normalClosure_of_isAlgClosed F⟮x⟯
  let _ : Normal F (normalClosure F K Ω) := normal_normalClosure_of_isAlgClosed K
  have hle : normalClosure F F⟮x⟯ Ω ≤ normalClosure F K Ω :=
    normalClosure_mono_of_isAlgClosed (adjoin_simple_le_iff.mpr hx)
  exact (galEquivNormalClosure hx_int (IsAlgClosed.splits _)).symm.surjective.comp
    (IntermediateField.inclusion hle).restrictNormalHom_surjective

/-- If `Gal(normalClosure F K Ω/F)` is solvable, then so is `(minpoly F x).Gal` for every
`x ∈ K`. -/
theorem isSolvable_gal_minpoly_of_mem [Algebra.IsAlgebraic F K] {x : Ω} (hx : x ∈ K)
    [Group.IsSolvable Gal(normalClosure F K Ω/F)] :
    Group.IsSolvable (minpoly F x).Gal :=
  Group.isSolvable_of_surjective (restrictGalMinpolyHom_surjective hx)

/-- If some element `x ∈ K` has non-solvable polynomial Galois group `(minpoly F x).Gal`, then
`Gal(normalClosure F K Ω/F)` is not solvable. -/
theorem not_isSolvable_gal_normalClosure_of_mem [Algebra.IsAlgebraic F K] {x : Ω} (hx : x ∈ K)
    (hns : ¬ Group.IsSolvable (minpoly F x).Gal) :
    ¬ Group.IsSolvable Gal(normalClosure F K Ω/F) :=
  fun _ ↦ hns (isSolvable_gal_minpoly_of_mem hx)

/-- For an algebraic intermediate field `K` of `Ω / F` and any `x ∈ K`, the order of
`(minpoly F x).Gal` divides `Nat.card Gal(normalClosure F K Ω/F)`. -/
theorem natCard_gal_minpoly_dvd_of_mem [Algebra.IsAlgebraic F K] {x : Ω} (hx : x ∈ K) :
    Nat.card (minpoly F x).Gal ∣ Nat.card Gal(normalClosure F K Ω/F) :=
  Subgroup.card_dvd_of_surjective (restrictGalMinpolyHom_surjective hx)

/-- As a group homomorphism, `galNormalClosureEquivGalMinpoly` agrees with
`restrictGalMinpolyHom`. -/
theorem coe_galNormalClosureEquivGalMinpoly_eq_restrictGalMinpolyHom
    [Algebra.IsAlgebraic F K] {x : Ω} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F Ω)).Splits)
    (hK : F⟮x⟯ = K) (hx_mem : x ∈ K) :
    (galNormalClosureEquivGalMinpoly hx hsplit hK :
        Gal(normalClosure F K Ω/F) →* (minpoly F x).Gal) =
      restrictGalMinpolyHom hx_mem := by
  ext σ y
  have hle : normalClosure F F⟮x⟯ Ω ≤ normalClosure F K Ω :=
    normalClosure_mono_of_isAlgClosed (adjoin_simple_le_iff.mpr hx_mem)
  exact (splittingFieldEquivNormalClosure hx hsplit).injective
    ((IntermediateField.inclusion_injective hle)
      ((galNormalClosureEquivGalMinpoly_commutes hx hsplit hK hle σ y).trans
        (restrictGalMinpolyHom_commutes hx_mem hx hsplit hle σ y).symm))

end AlgClosed

end TauCeti
