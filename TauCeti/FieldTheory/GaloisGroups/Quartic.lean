module

import Mathlib.Algebra.Polynomial.SpecificDegree
import TauCeti.Algebra.Polynomial.QuadraticDiscriminant

public import TauCeti.FieldTheory.GaloisGroups.Resolvent.Label
public import TauCeti.FieldTheory.GaloisGroups.Resolvent.Quartic.Discriminant
public import TauCeti.GroupTheory.Perm.TransitiveGroupLabel.Classification

/-!
# The Galois group of a quartic

An irreducible separable quartic has transitive Galois image in `Equiv.Perm (Fin 4)`, so it
carries exactly one of the five labels `4T1`, …, `4T5`, the cyclic, Klein four, dihedral,
alternating and symmetric groups. Away from characteristic `2` two tests read that label off the
coefficients of `f`.

* The discriminant. The Galois image consists of even permutations exactly when `f.discr` is a
  square, which happens for `4T2` and `4T4` only.
* The resolvent cubic, the specialization at `f` of the `D₄`-specification `TauCeti.quarticD4Spec`
  of the invariant `x₀x₂ + x₁x₃`. Its roots in the base field detect confinement of the Galois
  image to a conjugate of the dihedral group of `4T3`, which happens for `4T1`, `4T2` and `4T3`
  only. No separation hypothesis is needed: a quartic and its resolvent cubic have the same
  discriminant, so the resolvent of a separable quartic is separable.

Together the two tests decide between `4T5`, `4T4` and `4T2` and isolate the pair `{4T1, 4T3}`,
which they do not separate: the cyclic and the dihedral group both have odd parity and both lie
in a dihedral group of order eight. Separating them takes a further datum, namely whether `f`
stays irreducible over the quadratic extension generated by a square root of the discriminant.

The resolvent cubic is monic of degree three
(`TauCeti.Polynomial.natDegree_specialize_quarticD4Spec`), so
by `Polynomial.irreducible_iff_roots_eq_zero_of_degree_le_three` it has no root in the base field
exactly when it is irreducible there; the first two theorems below are therefore the classical
rows for an irreducible resolvent cubic.

## Main results

* `TauCeti.existsUnique_hasGaloisLabel_four`: an irreducible separable quartic carries exactly
  one label.
* `TauCeti.HasGaloisLabel.isSquare_discr_iff_four` and
  `TauCeti.HasGaloisLabel.exists_isRoot_specialize_quarticD4Spec_iff`: the discriminant test and
  the resolvent test, as conditions on the label.
* `TauCeti.hasGaloisLabel_four_four_iff`, `TauCeti.hasGaloisLabel_four_three_iff`,
  `TauCeti.hasGaloisLabel_four_one_iff`, `TauCeti.hasGaloisLabel_four_zero_or_two_iff`: **the
  quartic root-test table**, one theorem for each of its four rows.
* The corresponding theorems suffixed `_resolvent_irreducible`, `_resolvent_splits`, or
  `_resolvent_existsUnique_isRoot` state the classical decision table using the resolvent
  predicates from the roadmap.

## References

* K. Conrad, *Galois groups of cubics and quartics (not in characteristic 2)*, §3.
* [H. Cohen, *A Course in Computational Algebraic Number Theory*][cohen1993], §6.3.
-/

public section

open Polynomial Equiv Equiv.Perm

namespace TauCeti

variable {F : Type*} [Field F] {f : F[X]}

private theorem separable_of_irreducible_of_natDegree_eq_four (hchar : ringChar F ≠ 2)
    (hf : f.Monic) (hirr : Irreducible f) (hdeg : f.natDegree = 4) : f.Separable := by
  rw [separable_iff_derivative_ne_zero hirr]
  intro hder
  have hcoeff := congrArg (fun p : F[X] => p.coeff 3) hder
  rw [coeff_derivative, coeff_zero] at hcoeff
  norm_num at hcoeff
  rw [← hdeg, hf.coeff_natDegree] at hcoeff
  rcases hcoeff with h | h
  · exact one_ne_zero h
  · have htwo : (2 : F) ≠ 0 := Ring.two_ne_zero hchar
    have hfour : (4 : F) ≠ 0 := by
      rw [show (4 : F) = 2 * 2 by norm_num]
      exact mul_ne_zero htwo htwo
    exact hfour h

private theorem cubic_discr_factor (a b c : F) :
    Cubic.discr ⟨1, b, c, -(a ^ 3 + b * a ^ 2 + c * a)⟩ =
      discrim 1 (b + a) (c + b * a + a ^ 2) *
        (a ^ 2 + (b + a) * a + (c + b * a + a ^ 2)) ^ 2 := by
  simp only [Cubic.discr, discrim]
  ring

private theorem cubic_splits_iff_isSquare_discr_of_isRoot {g : F[X]}
    (hchar : ringChar F ≠ 2) (b c d a : F) (hg : g = Cubic.toPoly ⟨1, b, c, d⟩)
    (hsep : g.Separable) (ha : g.IsRoot a) : g.Splits ↔ IsSquare g.discr := by
  have hroot : a ^ 3 + b * a ^ 2 + c * a + d = 0 := by
    rw [IsRoot, hg] at ha
    simpa only [Cubic.toPoly, eval_add, eval_mul, eval_pow, eval_C, eval_X, one_mul] using ha
  have hd : d = -(a ^ 3 + b * a ^ 2 + c * a) := by linear_combination hroot
  have hfactor : g = (X - C a) *
      (X ^ 2 + C (b + a) * X + C (c + b * a + a ^ 2)) := by
    rw [hg, hd]
    simp only [Cubic.toPoly, C_add, C_neg, C_mul, C_pow, C_1, one_mul]
    ring
  have hdisc : g.discr = discrim 1 (b + a) (c + b * a + a ^ 2) *
      (a ^ 2 + (b + a) * a + (c + b * a + a ^ 2)) ^ 2 := by
    rw [hg, hd, Cubic.toPoly_discr one_ne_zero, cubic_discr_factor]
  have hqsplit : (X ^ 2 + C (b + a) * X + C (c + b * a + a ^ 2) : F[X]).Splits ↔
      IsSquare (discrim 1 (b + a) (c + b * a + a ^ 2)) := by
    simpa only [C_1, one_mul] using
      (@splits_quadratic_iff_isSquare F _ ⟨Ring.two_ne_zero hchar⟩ 1 (b + a)
        (c + b * a + a ^ 2) one_ne_zero)
  have hsplit : g.Splits ↔
      (X ^ 2 + C (b + a) * X + C (c + b * a + a ^ 2) : F[X]).Splits := by
    rw [hfactor, splits_mul_iff_right (X_sub_C_ne_zero a) (Splits.X_sub_C a)]
  rw [hsplit, hqsplit]
  constructor
  · intro hsq
    rw [hdisc]
    exact hsq.mul (Even.isSquare_pow (by simp) _)
  · intro hsq
    have hgmonic : g.Monic := hg ▸ Cubic.monic_of_a_eq_one' (b := b) (c := c) (d := d)
    have hdiscne : g.discr ≠ 0 := hgmonic.discr_ne_zero_iff.2 hsep
    have hr : a ^ 2 + (b + a) * a + (c + b * a + a ^ 2) ≠ 0 := by
      intro hr
      apply hdiscne
      rw [hdisc, hr]
      simp
    have hquot := hsq.div (Even.isSquare_pow even_two (a ^ 2 + (b + a) * a +
      (c + b * a + a ^ 2)))
    rw [hdisc] at hquot
    have heq : discrim 1 (b + a) (c + b * a + a ^ 2) =
        discrim 1 (b + a) (c + b * a + a ^ 2) *
          (a ^ 2 + (b + a) * a + (c + b * a + a ^ 2)) ^ 2 /
            (a ^ 2 + (b + a) * a + (c + b * a + a ^ 2)) ^ 2 := by
      exact (mul_div_cancel_right₀ _ (pow_ne_zero 2 hr)).symm
    rw [heq]
    exact hquot

private theorem splits_of_cubic_of_two_isRoot {g : F[X]} (hdeg : g.natDegree = 3) {a x : F}
    (ha : g.IsRoot a) (hx : g.IsRoot x) (hxa : x ≠ a) : g.Splits := by
  obtain ⟨q, hq⟩ := dvd_iff_isRoot.2 ha
  have hgne : g ≠ 0 := by
    intro hzero
    rw [hzero, natDegree_zero] at hdeg
    omega
  have hqne : q ≠ 0 := by
    intro hzero
    rw [hzero, mul_zero] at hq
    exact hgne hq
  have hqdeg : q.natDegree = 2 := by
    rw [hq, natDegree_mul (X_sub_C_ne_zero a) hqne, natDegree_X_sub_C] at hdeg
    omega
  have hqx : q.eval x = 0 := by
    rw [hq, IsRoot, eval_mul, eval_sub, eval_X, eval_C] at hx
    exact (mul_eq_zero.mp hx).resolve_left (sub_ne_zero.mpr hxa)
  rw [hq, splits_mul (X_sub_C_ne_zero a) hqne]
  exact ⟨Splits.X_sub_C a, Splits.of_natDegree_eq_two hqdeg hqx⟩

private theorem quarticD4Spec_specialize_eq_toPoly (f : F[X]) :
    quarticD4Spec.specialize F f =
      Cubic.toPoly ⟨1, -f.coeff 2, f.coeff 3 * f.coeff 1 - 4 * f.coeff 0,
        -(f.coeff 3 ^ 2 * f.coeff 0 + f.coeff 1 ^ 2 - 4 * f.coeff 2 * f.coeff 0)⟩ := by
  rw [quarticD4Spec_specialize]
  simp only [Cubic.toPoly, C_neg, C_1, one_mul]
  ring

private theorem irreducible_iff_not_exists_isRoot_of_monic_cubic {g : F[X]} (hg : g.Monic)
    (hdeg : g.natDegree = 3) : Irreducible g ↔ ¬ ∃ a : F, g.IsRoot a := by
  rw [Polynomial.Monic.irreducible_iff_roots_eq_zero_of_degree_le_three hg
    (by omega) (by omega)]
  simp [Multiset.eq_zero_iff_forall_notMem, mem_roots hg.ne_zero]

/-- A polynomial carries at most one label in degree four. -/
theorem HasGaloisLabel.eq_of_four {j k : TransitiveGroupIndex 4} (hj : HasGaloisLabel f j)
    (hk : HasGaloisLabel f k) : j = k := by
  obtain ⟨e⟩ := nonempty_rootSet_splittingField_equiv_fin f hj.separable
  exact (hj.transitiveGroupLabel (e.trans (finCongr hj.natDegree_eq))).eq_of_four
    (hk.transitiveGroupLabel _)

/-- **An irreducible separable quartic carries exactly one label**, one of `4T1`, …, `4T5`. -/
theorem existsUnique_hasGaloisLabel_four (hsep : f.Separable) (hirr : Irreducible f)
    (hdeg : f.natDegree = 4) : ∃! j : TransitiveGroupIndex 4, HasGaloisLabel f j :=
  (exists_hasGaloisLabel_of_irreducible hsep hirr hdeg fun G _ =>
    exists_transitiveGroupLabel_four G).elim fun j hj => ⟨j, hj, fun _ hk => hk.eq_of_four hj⟩

variable {j : TransitiveGroupIndex 4}

/-- **The resolvent cubic reads three of the five quartic labels.** The resolvent cubic of a monic
quartic with a label has a root in the base field exactly when that label is `4T1`, `4T2` or
`4T3`, the labels whose reference subgroup lies in a conjugate of the dihedral group of `4T3`.

The resolvent cubic of a separable quartic is separable, by
`TauCeti.separable_quarticD4Spec_specialize_iff`, so no separation hypothesis appears. -/
theorem HasGaloisLabel.exists_isRoot_specialize_quarticD4Spec_iff (h : HasGaloisLabel f j)
    (hf : f.Monic) :
    (∃ a : F, (quarticD4Spec.specialize F f).IsRoot a) ↔ (j : ℕ) ≤ 2 := by
  rw [h.exists_isRoot_specialize_iff hf quarticD4Spec
      ((separable_quarticD4Spec_specialize_iff hf h.natDegree_eq).2 h.separable),
    quarticD4Spec_H, exists_le_map_conj_referenceSubgroup_four_two_iff]

/-- **The discriminant reads the parity of a quartic label.** Away from characteristic `2`, the
discriminant of a monic quartic with a label is a square exactly when that label is `4T2` or
`4T4`. -/
theorem HasGaloisLabel.isSquare_discr_iff_four (h : HasGaloisLabel f j) (hf : f.Monic)
    (hchar : ringChar F ≠ 2) : IsSquare f.discr ↔ (j : ℕ) = 1 ∨ (j : ℕ) = 3 :=
  (h.isSquare_discr_iff hf hchar).trans (referenceSubgroup_four_le_alternatingGroup_iff j)

variable (hchar : ringChar F ≠ 2) (hf : f.Monic)
include hchar hf

/-- **A quartic with non-square discriminant and no root of the resolvent cubic has label `4T5`.**
Away from characteristic `2`, a monic polynomial has label `4T5`, that is Galois group the full
symmetric group on its four roots, exactly when it is an irreducible quartic whose discriminant is
not a square and whose resolvent cubic has no root in the base field. -/
theorem hasGaloisLabel_four_four_iff :
    HasGaloisLabel f (⟨4, by simp⟩ : TransitiveGroupIndex 4) ↔
      Irreducible f ∧ f.natDegree = 4 ∧ ¬ IsSquare f.discr ∧
        ¬ ∃ a : F, (quarticD4Spec.specialize F f).IsRoot a := by
  refine ⟨fun h => ⟨h.irreducible, h.natDegree_eq, fun hsq => ?_, fun hr => ?_⟩, ?_⟩
  · simpa using (h.isSquare_discr_iff_four hf hchar).1 hsq
  · simpa using (h.exists_isRoot_specialize_quarticD4Spec_iff hf).1 hr
  · rintro ⟨hirr, hdeg, hsq, hroot⟩
    -- A non-square discriminant is nonzero, so `f` is separable and carries a label.
    have hsep : f.Separable := hf.discr_ne_zero_iff.1 fun h0 => hsq ⟨0, by simp [h0]⟩
    obtain ⟨k, hk, -⟩ := existsUnique_hasGaloisLabel_four hsep hirr hdeg
    have hpar := hk.isSquare_discr_iff_four hf hchar
    have hrt := hk.exists_isRoot_specialize_quarticD4Spec_iff hf
    have hne : ¬ ((k : ℕ) = 1 ∨ (k : ℕ) = 3) := fun hk1 => hsq (hpar.2 hk1)
    have hgt : ¬ ((k : ℕ) ≤ 2) := fun hk2 => hroot (hrt.2 hk2)
    have hlt : (k : ℕ) < 5 := by simpa using k.isLt
    have hk4val : (k : ℕ) = 4 := by omega
    have hk4 : k = ⟨4, by simp⟩ := by
      exact Fin.ext hk4val
    subst k
    exact hk

/-- **A quartic with square discriminant and no root of the resolvent cubic has label `4T4`.**
Away from characteristic `2`, a monic polynomial has label `4T4`, that is Galois group the
alternating group on its four roots, exactly when it is an irreducible quartic whose
discriminant is a square and whose resolvent cubic has no root in the base field. -/
theorem hasGaloisLabel_four_three_iff :
    HasGaloisLabel f (⟨3, by simp⟩ : TransitiveGroupIndex 4) ↔
      Irreducible f ∧ f.natDegree = 4 ∧ IsSquare f.discr ∧
        ¬ ∃ a : F, (quarticD4Spec.specialize F f).IsRoot a := by
  refine ⟨fun h => ⟨h.irreducible, h.natDegree_eq,
    (h.isSquare_discr_iff_four hf hchar).2 (by simp), fun hr => ?_⟩, ?_⟩
  · simpa using (h.exists_isRoot_specialize_quarticD4Spec_iff hf).1 hr
  · rintro ⟨hirr, hdeg, hsq, hroot⟩
    have hsep := separable_of_irreducible_of_natDegree_eq_four hchar hf hirr hdeg
    obtain ⟨k, hk, -⟩ := existsUnique_hasGaloisLabel_four hsep hirr hdeg
    have hpar := (hk.isSquare_discr_iff_four hf hchar).1 hsq
    have hgt : ¬ ((k : ℕ) ≤ 2) :=
      fun hk2 => hroot ((hk.exists_isRoot_specialize_quarticD4Spec_iff hf).2 hk2)
    have hk3val : (k : ℕ) = 3 := by omega
    have hk3 : k = ⟨3, by simp⟩ := by
      exact Fin.ext hk3val
    subst k
    exact hk

/-- **A quartic with square discriminant whose resolvent cubic has a root has label `4T2`.**
Away from characteristic `2`, a monic polynomial has label `4T2`, that is Galois group the Klein
four-group acting regularly on its four roots, exactly when it is an irreducible quartic
whose discriminant is a square and whose resolvent cubic has a root in the base field. -/
theorem hasGaloisLabel_four_one_iff :
    HasGaloisLabel f (⟨1, by simp⟩ : TransitiveGroupIndex 4) ↔
      Irreducible f ∧ f.natDegree = 4 ∧ IsSquare f.discr ∧
        ∃ a : F, (quarticD4Spec.specialize F f).IsRoot a := by
  refine ⟨fun h => ⟨h.irreducible, h.natDegree_eq,
    (h.isSquare_discr_iff_four hf hchar).2 (by simp),
    (h.exists_isRoot_specialize_quarticD4Spec_iff hf).2 (by simp)⟩, ?_⟩
  rintro ⟨hirr, hdeg, hsq, hroot⟩
  have hsep := separable_of_irreducible_of_natDegree_eq_four hchar hf hirr hdeg
  obtain ⟨k, hk, -⟩ := existsUnique_hasGaloisLabel_four hsep hirr hdeg
  have hpar := (hk.isSquare_discr_iff_four hf hchar).1 hsq
  have hrt := (hk.exists_isRoot_specialize_quarticD4Spec_iff hf).1 hroot
  have hk1val : (k : ℕ) = 1 := by omega
  have hk1 : k = ⟨1, by simp⟩ := by
    exact Fin.ext hk1val
  subst k
  exact hk

/-- **A quartic with non-square discriminant whose resolvent cubic has a root has label `4T1` or
`4T3`.** Away from characteristic `2`, a monic polynomial has label `4T1` or `4T3`, that is Galois
group cyclic of order four or dihedral of order eight, exactly when it is an irreducible quartic
whose discriminant is not a square and whose resolvent cubic has a root in the base field.

The discriminant and the resolvent cubic do not separate the two labels: both reference subgroups
contain odd permutations and both lie in a dihedral group of order eight, so the two tests take
the same values on them. -/
theorem hasGaloisLabel_four_zero_or_two_iff :
    (HasGaloisLabel f (⟨0, by simp⟩ : TransitiveGroupIndex 4) ∨
        HasGaloisLabel f (⟨2, by simp⟩ : TransitiveGroupIndex 4)) ↔
      Irreducible f ∧ f.natDegree = 4 ∧ ¬ IsSquare f.discr ∧
        ∃ a : F, (quarticD4Spec.specialize F f).IsRoot a := by
  constructor
  · rintro (h | h) <;>
      exact ⟨h.irreducible, h.natDegree_eq,
        fun hsq => by simpa using (h.isSquare_discr_iff_four hf hchar).1 hsq,
        (h.exists_isRoot_specialize_quarticD4Spec_iff hf).2 (by simp)⟩
  · rintro ⟨hirr, hdeg, hsq, hroot⟩
    -- A non-square discriminant is nonzero, so `f` is separable and carries a label.
    have hsep : f.Separable := hf.discr_ne_zero_iff.1 fun h0 => hsq ⟨0, by simp [h0]⟩
    obtain ⟨k, hk, -⟩ := existsUnique_hasGaloisLabel_four hsep hirr hdeg
    have hne : ¬ ((k : ℕ) = 1 ∨ (k : ℕ) = 3) :=
      fun hk1 => hsq ((hk.isSquare_discr_iff_four hf hchar).2 hk1)
    have hrt := (hk.exists_isRoot_specialize_quarticD4Spec_iff hf).1 hroot
    have hk02 : (k : ℕ) = 0 ∨ (k : ℕ) = 2 := by omega
    rcases hk02 with hk0 | hk2
    · obtain rfl : k = ⟨0, by simp⟩ := Fin.ext hk0
      exact Or.inl hk
    · obtain rfl : k = ⟨2, by simp⟩ := Fin.ext hk2
      exact Or.inr hk

/-- **The irreducible-resolvent row for `4T5`.** Away from characteristic `2`, a monic
polynomial has label `4T5` exactly when it is an irreducible quartic with non-square
discriminant and irreducible resolvent cubic. -/
theorem hasGaloisLabel_four_four_iff_resolvent_irreducible :
    HasGaloisLabel f (⟨4, by simp⟩ : TransitiveGroupIndex 4) ↔
      Irreducible f ∧ f.natDegree = 4 ∧ ¬ IsSquare f.discr ∧
        Irreducible (quarticD4Spec.specialize F f) := by
  rw [hasGaloisLabel_four_four_iff hchar hf]
  have hres := irreducible_iff_not_exists_isRoot_of_monic_cubic
    (quarticD4Spec.monic_specialize F f)
    (TauCeti.Polynomial.natDegree_specialize_quarticD4Spec f)
  tauto

/-- **The irreducible-resolvent row for `4T4`.** Away from characteristic `2`, a monic
polynomial has label `4T4` exactly when it is an irreducible quartic with square discriminant
and irreducible resolvent cubic. -/
theorem hasGaloisLabel_four_three_iff_resolvent_irreducible :
    HasGaloisLabel f (⟨3, by simp⟩ : TransitiveGroupIndex 4) ↔
      Irreducible f ∧ f.natDegree = 4 ∧ IsSquare f.discr ∧
        Irreducible (quarticD4Spec.specialize F f) := by
  rw [hasGaloisLabel_four_three_iff hchar hf]
  have hres := irreducible_iff_not_exists_isRoot_of_monic_cubic
    (quarticD4Spec.monic_specialize F f)
    (TauCeti.Polynomial.natDegree_specialize_quarticD4Spec f)
  tauto

/-- **The split-resolvent row for `4T2`.** Away from characteristic `2`, a monic polynomial
has label `4T2` exactly when it is an irreducible quartic with square discriminant whose
resolvent cubic splits completely over the base field. -/
theorem hasGaloisLabel_four_one_iff_resolvent_splits :
    HasGaloisLabel f (⟨1, by simp⟩ : TransitiveGroupIndex 4) ↔
      Irreducible f ∧ f.natDegree = 4 ∧ IsSquare f.discr ∧
        (quarticD4Spec.specialize F f).Splits := by
  constructor
  · intro h
    obtain ⟨hirr, hdeg, hsq, a, ha⟩ := (hasGaloisLabel_four_one_iff hchar hf).1 h
    have hsep := separable_of_irreducible_of_natDegree_eq_four hchar hf hirr hdeg
    have hressep := (separable_quarticD4Spec_specialize_iff hf hdeg).2 hsep
    refine ⟨hirr, hdeg, hsq, ?_⟩
    apply (cubic_splits_iff_isSquare_discr_of_isRoot hchar _ _ _ a
      (quarticD4Spec_specialize_eq_toPoly f) hressep ha).2
    rwa [← discr_quarticD4Spec_specialize hf hdeg]
  · rintro ⟨hirr, hdeg, hsq, hsplit⟩
    have hresdeg := TauCeti.Polynomial.natDegree_specialize_quarticD4Spec f
    obtain ⟨a, ha⟩ := hsplit.exists_eval_eq_zero
      (degree_ne_of_natDegree_ne (hresdeg ▸ by decide))
    apply (hasGaloisLabel_four_one_iff hchar hf).2
    exact ⟨hirr, hdeg, hsq, a, ha⟩

/-- **The unique-root row for `4T1` or `4T3`.** Away from characteristic `2`, a monic
polynomial has label `4T1` or `4T3` exactly when it is an irreducible quartic with non-square
discriminant whose resolvent cubic has exactly one root in the base field. -/
theorem hasGaloisLabel_four_zero_or_two_iff_resolvent_existsUnique_isRoot :
    (HasGaloisLabel f (⟨0, by simp⟩ : TransitiveGroupIndex 4) ∨
        HasGaloisLabel f (⟨2, by simp⟩ : TransitiveGroupIndex 4)) ↔
      Irreducible f ∧ f.natDegree = 4 ∧ ¬ IsSquare f.discr ∧
        ∃! a : F, (quarticD4Spec.specialize F f).IsRoot a := by
  constructor
  · intro h
    obtain ⟨hirr, hdeg, hsq, a, ha⟩ := (hasGaloisLabel_four_zero_or_two_iff hchar hf).1 h
    have hsep := separable_of_irreducible_of_natDegree_eq_four hchar hf hirr hdeg
    have hressep := (separable_quarticD4Spec_specialize_iff hf hdeg).2 hsep
    refine ⟨hirr, hdeg, hsq, a, ha, ?_⟩
    intro x hx
    by_contra hxa
    have hsplit := splits_of_cubic_of_two_isRoot
      (TauCeti.Polynomial.natDegree_specialize_quarticD4Spec f) ha hx hxa
    have hressq := (cubic_splits_iff_isSquare_discr_of_isRoot hchar _ _ _ a
      (quarticD4Spec_specialize_eq_toPoly f) hressep ha).1 hsplit
    apply hsq
    rw [discr_quarticD4Spec_specialize hf hdeg]
    exact hressq
  · rintro ⟨hirr, hdeg, hsq, a, ha, -⟩
    apply (hasGaloisLabel_four_zero_or_two_iff hchar hf).2
    exact ⟨hirr, hdeg, hsq, a, ha⟩

end TauCeti
