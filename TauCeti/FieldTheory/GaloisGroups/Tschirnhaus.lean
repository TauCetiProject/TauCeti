module

public import TauCeti.RingTheory.Polynomial.Tschirnhaus
public import Mathlib.FieldTheory.PolynomialGaloisGroup

/-!
# Tschirnhaus transforms and the Galois group

A Tschirnhaus transform `Polynomial.tschirnhausPolynomial f T` replaces the roots `α` of `f` by
the values `T(α)`. The coefficient-side construction and the root correspondence are developed in
`TauCeti/RingTheory/Polynomial/Tschirnhaus.lean`. This file shows that for a separable `f`
an *admissible* transform — one that separates the roots of `f` — changes neither the splitting
field nor the Galois group.

Separability of `f` is assumed by the two splitting-field results. The Galois correspondence
enters in one place only, the splitting-field argument
`Polynomial.TschirnhausAdmissible.isSplittingField`, which computes the fixing subgroup of the
field generated by the values `T(α)`. The conjugacy of the Galois images needs only that `f` is
nonzero and the transform is admissible.

For a nonzero `f` and any field extension `E` in which `f` splits, the roots of the transform are
exactly the values of `T` at the roots of `f`, with multiplicity, so the transform splits in `E`
as well.
Admissibility is `Polynomial.TschirnhausAdmissible f T`: injectivity of `α ↦ T(α)` on the root set
of `f` in its splitting field. Under it, a separable `f` has a separable transform and each
splitting field of `f` is a splitting field of the transform; and for a nonzero `f`, the
Galois groups are isomorphic and their images inside the permutations of their respective root
sets are conjugate along `α ↦ T(α)`.

That last statement is what carries information back: a constraint on the Galois image of the
transform — typically an upper bound read off a resolvent that became separable after the
substitution — is a constraint on the Galois image of `f`.

## Main results

* `Polynomial.TschirnhausAdmissible.isSplittingField` and
  `Polynomial.TschirnhausAdmissible.nonempty_algEquiv_splittingField`: the splitting fields agree.
* `Polynomial.TschirnhausAdmissible.nonempty_mulEquiv_gal`: the Galois groups are isomorphic.
* `Polynomial.TschirnhausAdmissible.range_galActionHom_eq_map_rootSetEquiv`: the two Galois
  images are conjugate along the canonical bijection `α ↦ T(α)` of root sets.

## References

* H. Cohen, *A Course in Computational Algebraic Number Theory*, §6.3.
-/

public section

noncomputable section

open Polynomial

namespace Polynomial

variable {F : Type*} [Field F] {f T : F[X]}

section Extension

variable {E : Type*} [Field E] [Algebra F E]

/-- Automorphisms that agree on the roots of an admissible Tschirnhaus transform agree on the
roots of the original polynomial. -/
theorem TschirnhausAdmissible.eqOn_rootSet (h : TschirnhausAdmissible f T) (hf : f ≠ 0)
    (hs : (f.map (algebraMap F E)).Splits) {φ ψ : E ≃ₐ[F] E}
    (hφψ : Set.EqOn φ ψ ((f.tschirnhausPolynomial T).rootSet E)) :
    Set.EqOn φ ψ (f.rootSet E) := by
  intro x hx
  apply (tschirnhausAdmissible_iff_injOn hs).mp h
  · exact rootSet_mapsTo φ.toAlgHom hx
  · exact rootSet_mapsTo ψ.toAlgHom hx
  · have hmem : aeval x T ∈ (f.tschirnhausPolynomial T).rootSet E := by
      rw [rootSet_tschirnhausPolynomial_field hf hs]
      exact ⟨x, hx, rfl⟩
    simpa only [aeval_algHom_apply] using hφψ hmem

/-- Two automorphisms of a splitting field of `f` are equal if they agree on every `T(α)`, when
`T` is admissible for the nonzero polynomial `f`. -/
theorem TschirnhausAdmissible.algEquiv_ext [IsSplittingField F E f]
    (h : TschirnhausAdmissible f T) (hf : f ≠ 0)
    (hs : (f.map (algebraMap F E)).Splits) {φ ψ : E ≃ₐ[F] E}
    (hφψ : ∀ x ∈ f.rootSet E, φ (aeval x T) = ψ (aeval x T)) : φ = ψ := by
  have hroots : Set.EqOn φ ψ (f.rootSet E) := h.eqOn_rootSet hf hs fun y hy ↦ by
    rw [rootSet_tschirnhausPolynomial_field hf hs] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    exact hφψ x hx
  have heq := AlgHom.ext_of_adjoin_eq_top
    (φ₁ := φ.toAlgHom) (φ₂ := ψ.toAlgHom)
    (IsSplittingField.adjoin_rootSet (L := E) f) hroots
  exact AlgEquiv.ext fun x ↦ DFunLike.congr_fun heq x

end Extension

/-- **Every splitting field of `f` is a splitting field of an admissible transform.** For a
separable `f` and an admissible `T`, the transform splits in any splitting field `L` of `f` and
its roots generate `L` over `F`. -/
theorem TschirnhausAdmissible.isSplittingField {L : Type*} [Field L] [Algebra F L]
    [IsSplittingField F L f] (h : TschirnhausAdmissible f T) (hsep : f.Separable) :
    IsSplittingField F L (f.tschirnhausPolynomial T) := by
  have hsp : (f.map (algebraMap F L)).Splits := IsSplittingField.splits L f
  let _ : FiniteDimensional F L := IsSplittingField.finiteDimensional L f
  have : IsGalois F L := IsGalois.of_separable_splitting_field hsep
  have hTsp := splits_map_tschirnhausPolynomial_field hsp T
  refine ⟨hTsp, ?_⟩
  rw [← IntermediateField.adjoin_eq_top_iff]
  set M := IntermediateField.adjoin F ((f.tschirnhausPolynomial T).rootSet L) with hM
  have hfix : M.fixingSubgroup = ⊥ := by
    rw [eq_bot_iff]
    intro ϕ hϕ
    apply Subgroup.mem_bot.mpr
    apply h.algEquiv_ext hsep.ne_zero hsp
    intro α hα
    have hmem : aeval α T ∈ (f.tschirnhausPolynomial T).rootSet L := by
      rw [rootSet_tschirnhausPolynomial_field hsep.ne_zero hsp]
      exact ⟨α, hα, rfl⟩
    have h1 : ϕ (aeval α T) = aeval α T :=
        (mem_fixingSubgroup_iff Gal(L/F)).mp hϕ _
          (hM ▸ IntermediateField.subset_adjoin F _ hmem)
    simpa using h1
  rw [← IsGalois.fixedField_fixingSubgroup M, hfix, IntermediateField.fixedField_bot]

/-- The splitting field of `f` is a splitting field of an admissible transform, so the two
splitting fields agree up to an `F`-algebra equivalence. -/
theorem TschirnhausAdmissible.nonempty_algEquiv_splittingField (h : TschirnhausAdmissible f T)
    (hsep : f.Separable) :
    Nonempty (f.SplittingField ≃ₐ[F] (f.tschirnhausPolynomial T).SplittingField) :=
  haveI := h.isSplittingField (L := f.SplittingField) hsep
  ⟨IsSplittingField.algEquiv f.SplittingField (f.tschirnhausPolynomial T)⟩

/-- **An admissible Tschirnhaus transform of a nonzero polynomial has the same Galois group as the
original polynomial.** -/
theorem TschirnhausAdmissible.nonempty_mulEquiv_gal (h : TschirnhausAdmissible f T) (hf : f ≠ 0) :
    Nonempty ((f.tschirnhausPolynomial T).Gal ≃* f.Gal) := by
  have hsp : (f.map (algebraMap F f.SplittingField)).Splits := SplittingField.splits f
  let _ : Fact (((f.tschirnhausPolynomial T).map
      (algebraMap F f.SplittingField)).Splits) :=
    ⟨splits_map_tschirnhausPolynomial_field hsp T⟩
  let _ : Normal F f.SplittingField := Normal.of_isSplittingField f
  refine ⟨(MulEquiv.ofBijective (Gal.restrict (f.tschirnhausPolynomial T) f.SplittingField)
    ⟨?_, Gal.restrict_surjective (f.tschirnhausPolynomial T) f.SplittingField⟩).symm⟩
  intro φ ψ hφψ
  apply h.algEquiv_ext hf hsp
  intro x hx
  let y := h.rootSetEquiv hf hsp ⟨x, hx⟩
  have heq := congrArg (fun σ ↦
    (((Gal.galActionHom (f.tschirnhausPolynomial T) f.SplittingField) σ y :
      (f.tschirnhausPolynomial T).rootSet f.SplittingField) : f.SplittingField)) hφψ
  rw [Gal.galActionHom_restrict, Gal.galActionHom_restrict] at heq
  simpa [y] using heq

section GaloisImage

variable {E : Type*} [Field E] [Algebra F E]

/-- The canonical root-set equivalence for an admissible Tschirnhaus transform intertwines the
root actions induced by every automorphism of a common splitting extension. -/
theorem TschirnhausAdmissible.galActionHom_restrict_rootSetEquiv
    (h : TschirnhausAdmissible f T) (hf : f ≠ 0)
    [hfsp : Fact ((f.map (algebraMap F E)).Splits)]
    [Fact (((f.tschirnhausPolynomial T).map (algebraMap F E)).Splits)]
    (φ : Gal(E/F)) (x : f.rootSet E) :
    (Gal.galActionHom (f.tschirnhausPolynomial T) E)
        ((Gal.restrict (f.tschirnhausPolynomial T) E) φ)
        (h.rootSetEquiv hf hfsp.out x) =
      h.rootSetEquiv hf hfsp.out
        ((Gal.galActionHom f E) ((Gal.restrict f E) φ) x) := by
  apply Subtype.ext
  rw [Gal.galActionHom_restrict, h.coe_rootSetEquiv_apply,
    h.coe_rootSetEquiv_apply, Gal.galActionHom_restrict, aeval_algHom_apply]

/-- **The Galois images of `f` and of an admissible transform are conjugate.** In any normal
extension where both polynomials split, they are conjugate along the canonical root equivalence
`α ↦ T(α)`. -/
theorem TschirnhausAdmissible.range_galActionHom_eq_map_rootSetEquiv
    [Normal F E] (h : TschirnhausAdmissible f T) (hf : f ≠ 0)
    [hfsp : Fact ((f.map (algebraMap F E)).Splits)]
    [Fact (((f.tschirnhausPolynomial T).map (algebraMap F E)).Splits)] :
    (Gal.galActionHom (f.tschirnhausPolynomial T) E).range =
      (Gal.galActionHom f E).range.map
        (Equiv.permCongrHom (h.rootSetEquiv hf hfsp.out)).toMonoidHom := by
  let e := h.rootSetEquiv hf hfsp.out
  have hcomp : (Gal.galActionHom (f.tschirnhausPolynomial T) E).comp
      (Gal.restrict (f.tschirnhausPolynomial T) E) =
      (Equiv.permCongrHom e).toMonoidHom.comp
        ((Gal.galActionHom f E).comp (Gal.restrict f E)) := by
    refine MonoidHom.ext fun φ ↦ Equiv.ext fun y ↦ ?_
    simpa [e] using h.galActionHom_restrict_rootSetEquiv hf φ (e.symm y)
  have hg : (Gal.galActionHom (f.tschirnhausPolynomial T) E).range =
      ((Gal.galActionHom (f.tschirnhausPolynomial T) E).comp
        (Gal.restrict (f.tschirnhausPolynomial T) E)).range := by
    rw [MonoidHom.range_comp,
      MonoidHom.range_eq_top.mpr (Gal.restrict_surjective (f.tschirnhausPolynomial T) E),
      ← MonoidHom.range_eq_map]
  rw [hg, hcomp, MonoidHom.range_comp, MonoidHom.range_comp,
    MonoidHom.range_eq_top.mpr (Gal.restrict_surjective f E), ← MonoidHom.range_eq_map]

end GaloisImage

end Polynomial
