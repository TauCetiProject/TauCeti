module

public import TauCeti.FieldTheory.Galois.Conjugates
public import TauCeti.FieldTheory.GaloisGroups.Stabilizer

/-!
# The conjugate fields of a root field

Let `q` be an irreducible polynomial over `F` with a root `α` in a normal extension `M / F`, let
`G = M ≃ₐ[F] M`, and let `H` be the stabilizer of `α` in `G`, which is the subgroup fixing the root
field `F⟮α⟯`. This file records three descriptions of the data `(G, H)` in terms of the roots.

* The coset space `G ⧸ H` is identified `G`-equivariantly with the roots of `q` in `M`
  (`TauCeti.rootSetEquivQuotientStabilizer`) and with the `F`-embeddings of `F⟮α⟯` into `M`
  (`IntermediateField.quotientFixingSubgroupEquivAlgHom`). Composing the two, the embedding
  attached to a root `β` is the one sending `α` to `β`.
* The subfields of `M` conjugate to `F⟮α⟯` are exactly the root fields `F⟮β⟯` of the roots `β` of
  `q` in `M`. Over a Galois extension their fixing subgroups are exactly the conjugates of
  `H`, by `IntermediateField.mem_orbit_iff_exists_fixingSubgroup_eq`.
* For the Galois group `Polynomial.Gal p` of an irreducible polynomial with Galois splitting field,
  the number of distinct root fields `F⟮β⟯` is the index `[G : N_G(H)]` of the normalizer of the
  point stabilizer. Two roots can generate the same field, so this count is in general smaller
  than the degree `[G : H]`: the root fields are indexed by `G ⧸ N_G(H)`, a proper quotient of
  `G ⧸ H` whenever `H` is not self-normalizing.

So the group `G` together with its point stabilizer `H` determines, up to conjugacy, the root field
`F⟮α⟯` inside the splitting field, and records how many conjugates it has.

## Main results

* `TauCeti.rootSetEquivAlgHom`, `TauCeti.rootSetEquivAlgHom_apply_gen`,
  `TauCeti.rootSetEquivAlgHom_smul`: the roots of `q` are equivariantly the embeddings of `F⟮α⟯`,
  the root `β` corresponding to the embedding sending `α` to `β`.
* `TauCeti.orbit_adjoin_simple_eq_range_adjoin_rootSet`: the conjugates of `F⟮α⟯` are the root
  fields of the roots of `q`.
* `TauCeti.stabilizer_adjoin_simple_eq_normalizer_stabilizer`: in the splitting field of `p`, the
  stabilizer of the field generated by a root is the normalizer of the stabilizer of the root.
* `TauCeti.ncard_range_adjoin_rootSet_eq_index_normalizer`: the number of distinct root fields is
  the index of that normalizer.

## References

* J. S. Milne, *Fields and Galois Theory*, Chapter 3.
-/

public section

namespace TauCeti

open Polynomial IntermediateField MulAction
open scoped Pointwise

variable {F : Type*} [Field F]

/-! ### Roots and embeddings -/

section Normal

variable {M : Type*} [Field M] [Algebra F M] [Normal F M]

/-- **The roots of an irreducible polynomial are the embeddings of a root field.** For a root `α`
of an irreducible `q` in a normal extension `M / F`, the roots of `q` in `M` correspond to the
`F`-embeddings of `F⟮α⟯` into `M`; both are the cosets of the stabilizer of `α`. -/
noncomputable def rootSetEquivAlgHom {q : F[X]} (hq : Irreducible q) {α : M}
    (hα : α ∈ q.rootSet M) : q.rootSet M ≃ (F⟮α⟯ →ₐ[F] M) :=
  (rootSetEquivQuotientStabilizer hq hα).trans
    ((Subgroup.quotientEquivOfEq (fixingSubgroup_adjoin_simple α).symm).trans
      (quotientFixingSubgroupEquivAlgHom F⟮α⟯))

/-- The embedding attached to a root `β` sends `α` to `β`. -/
@[simp]
theorem rootSetEquivAlgHom_apply_gen {q : F[X]} (hq : Irreducible q) {α : M}
    (hα : α ∈ q.rootSet M) (β : q.rootSet M) :
    rootSetEquivAlgHom hq hα β (AdjoinSimple.gen F α) = β := by
  -- Write `β` as the root corresponding to the coset of some `ρ`, that is, as `ρ • α`.
  obtain ⟨c, rfl⟩ := (rootSetEquivQuotientStabilizer hq hα).symm.surjective β
  induction c using QuotientGroup.induction_on with
  | H ρ =>
    rw [coe_rootSetEquivQuotientStabilizer_symm_apply_mk, rootSetEquivAlgHom, Equiv.trans_apply,
      Equiv.apply_symm_apply, Equiv.trans_apply, Subgroup.quotientEquivOfEq_mk,
      quotientFixingSubgroupEquivAlgHom_mk, AlgEquiv.smul_algHom_apply, coe_val,
      AdjoinSimple.coe_gen, AlgEquiv.smul_def]

/-- The identification of the roots with the embeddings of `F⟮α⟯` is equivariant. -/
@[simp]
theorem rootSetEquivAlgHom_smul {q : F[X]} (hq : Irreducible q) {α : M}
    (hα : α ∈ q.rootSet M) (g : M ≃ₐ[F] M) (β : q.rootSet M) :
    rootSetEquivAlgHom hq hα (g • β) = g • rootSetEquivAlgHom hq hα β := by
  -- An embedding of `F⟮α⟯` is determined by its value at `α`.
  refine adjoin_algHom_ext F fun x hx => ?_
  rw [Set.mem_singleton_iff] at hx
  subst hx
  -- The point `⟨α, _⟩` of `F⟮α⟯` is `AdjoinSimple.gen F α`, up to proof irrelevance.
  change rootSetEquivAlgHom hq hα (g • β) (AdjoinSimple.gen F x) =
    (g • rootSetEquivAlgHom hq hα β) (AdjoinSimple.gen F x)
  rw [AlgEquiv.smul_algHom_apply, rootSetEquivAlgHom_apply_gen, rootSetEquivAlgHom_apply_gen,
    rootSet.coe_smul, AlgEquiv.smul_def]

/-! ### The conjugates of a root field -/

/-- **The conjugates of a root field are the root fields of the other roots.** For a root `α` of
an irreducible `q` in a normal extension `M / F`, the subfields `σ(F⟮α⟯)` for `σ : M ≃ₐ[F] M` are
exactly the fields `F⟮β⟯` for the roots `β` of `q` in `M`. -/
theorem orbit_adjoin_simple_eq_range_adjoin_rootSet {q : F[X]} (hq : Irreducible q) {α : M}
    (hα : α ∈ q.rootSet M) :
    orbit (M ≃ₐ[F] M) F⟮α⟯ = Set.range fun β : q.rootSet M => F⟮(β : M)⟯ := by
  have := isPretransitive_rootSet_of_irreducible (M := M) hq
  ext K
  constructor
  · rintro ⟨σ, rfl⟩
    refine ⟨σ • ⟨α, hα⟩, ?_⟩
    dsimp only
    rw [pointwise_smul_adjoin_simple, rootSet.coe_smul, AlgEquiv.smul_def]
  · rintro ⟨β, rfl⟩
    obtain ⟨σ, rfl⟩ := exists_smul_eq (M ≃ₐ[F] M) (⟨α, hα⟩ : q.rootSet M) β
    exact ⟨σ, pointwise_smul_adjoin_simple σ α⟩

end Normal

/-! ### Counting the conjugates of a root field in the splitting field -/

variable {p : F[X]}

/-- **The stabilizer of a root field is the normalizer of the point stabilizer.** An element of
`Polynomial.Gal p` maps the field `F⟮x⟯` generated by a root `x` onto itself exactly when it
normalizes the stabilizer of `x`. -/
theorem stabilizer_adjoin_simple_eq_normalizer_stabilizer [IsGalois F p.SplittingField]
    (x : p.rootSet p.SplittingField) :
    stabilizer p.Gal F⟮(x : p.SplittingField)⟯ =
      Subgroup.normalizer (stabilizer p.Gal x : Set p.Gal) := by
  rw [stabilizer_eq_fixingSubgroup_adjoin_simple x]
  exact IntermediateField.stabilizer_eq_normalizer _

/-- **The number of conjugates of a root field is the index of the normalizer of the point
stabilizer.** For an irreducible `p` with Galois splitting field, the roots `y` of `p` generate
exactly `[G : N_G(H)]` distinct fields `F⟮y⟯`, where `G = Polynomial.Gal p` and `H` is the
stabilizer of any root `x`. This is at most the number `[G : H]` of roots, with equality exactly
when `H` is self-normalizing. -/
theorem ncard_range_adjoin_rootSet_eq_index_normalizer [IsGalois F p.SplittingField]
    (hp : Irreducible p) (x : p.rootSet p.SplittingField) :
    (Set.range fun y : p.rootSet p.SplittingField => F⟮(y : p.SplittingField)⟯).ncard =
      (Subgroup.normalizer (stabilizer p.Gal x : Set p.Gal)).index := by
  rw [← stabilizer_adjoin_simple_eq_normalizer_stabilizer, index_stabilizer]
  -- `p.Gal` is by definition `p.SplittingField ≃ₐ[F] p.SplittingField`, acting in the same way.
  exact congrArg Set.ncard (orbit_adjoin_simple_eq_range_adjoin_rootSet hp x.2).symm

end TauCeti
