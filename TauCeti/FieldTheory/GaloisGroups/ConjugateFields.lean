module

public import TauCeti.FieldTheory.Galois.ConjugateFields
public import TauCeti.FieldTheory.GaloisGroups.Embeddings
import Mathlib.FieldTheory.Galois.Infinite
import TauCeti.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# Conjugate fields of a polynomial root

Let `x` be an element of a field extension `E / F` that is integral over `F` and whose minimal
polynomial `minpoly F x` splits in `E`, and put `N` for the normal closure of `F⟮x⟯` in `E`. The
simple field `F⟮x⟯` embeds in `N`; this file records its orbit under `Gal(N/F)`. These are the
distinct conjugate fields generated by the roots of `minpoly F x`.

When the minimal polynomial is separable, the number of these fields is

`[Gal(N/F) : N_G(H)]`,

where `H` is the point stabilizer in the polynomial Galois group, transported to `Gal(N/F)` by
`TauCeti.galEquivNormalClosure`.  Thus conjugate fields are indexed by the normalizer quotient,
not by the generally larger root quotient `G / H`, which indexes the embeddings of `F⟮x⟯`
(see `TauCeti.FieldTheory.GaloisGroups.Embeddings`).

## Main definitions

* `TauCeti.conjugateSimpleFields`: its set of conjugates under `Gal(N/F)`.
* `TauCeti.quotientNormalizerEquivConjugateSimpleFields`: the normalizer quotient indexing
  those fields.
* `TauCeti.quotientGalNormalizerEquivConjugateSimpleFields`: the same indexing through the
  polynomial Galois group.

## Main results

* `TauCeti.quotientGalStabilizerEquivAlgHomSimpleField_fieldRange`: the embedding indexed by
  a root-stabilizer coset has as image the conjugate field indexed by its projection to the
  normalizer quotient.
* `TauCeti.conjugateSimpleFieldsEquivConjugateSubgroups`: the conjugate fields
  correspond to conjugates of any root's point stabilizer in the polynomial Galois group.
* `TauCeti.ncard_conjugateSimpleFields`: the number of conjugate simple fields is the index of
  the normalizer of their fixing subgroup.
* `TauCeti.ncard_conjugateSimpleFields_eq_index_normalizer`: the number of conjugate simple
  fields is the index of the normalizer of any root's point stabilizer in the polynomial Galois
  group.
* `TauCeti.exists_root_ncard_conjugateSimpleFields_eq_index_normalizer`: the same formula with
  that fixing subgroup identified as a transported point stabilizer of `minpoly F x`.
-/

public section

namespace TauCeti

open _root_.IntermediateField MulAction Polynomial
open scoped Pointwise

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- The distinct conjugates of `F⟮x⟯` inside its normal closure. -/
noncomputable def conjugateSimpleFields (x : E) :
    Set (IntermediateField F (normalClosure F F⟮x⟯ E)) :=
  IntermediateField.conjugateFields (F⟮x⟯.restrict (le_normalClosure F⟮x⟯))

/-- A field is conjugate to `F⟮x⟯` exactly when it is the image of that field under an
automorphism of its normal closure. -/
theorem mem_conjugateSimpleFields_iff {x : E}
    {K : IntermediateField F (normalClosure F F⟮x⟯ E)} :
    K ∈ conjugateSimpleFields (F := F) x ↔
      ∃ σ : normalClosure F F⟮x⟯ E ≃ₐ[F] normalClosure F F⟮x⟯ E,
        (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).map σ.toAlgHom = K :=
  IntermediateField.mem_conjugateFields_iff

/-- The conjugate simple fields are precisely the fields generated by roots of the minimal
polynomial inside the normal closure. -/
theorem mem_conjugateSimpleFields_iff_adjoin_root {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    {K : IntermediateField F (normalClosure F F⟮x⟯ E)} :
    K ∈ conjugateSimpleFields (F := F) x ↔
      ∃ y : (minpoly F x).rootSet (normalClosure F F⟮x⟯ E),
        K = F⟮(y : normalClosure F F⟮x⟯ E)⟯ := by
  let N := normalClosure F F⟮x⟯ E
  let _ : Normal F N := normal_normalClosure_adjoin_simple hx hsplit
  let a : N := ⟨x, le_normalClosure F⟮x⟯ (mem_adjoin_simple_self F x)⟩
  have ha : a ∈ (minpoly F x).rootSet N := by
    rw [mem_rootSet_of_ne (minpoly.ne_zero hx)]
    apply N.val.injective
    rw [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      ← aeval_algHom_apply N.val, map_zero]
    exact minpoly.aeval F x
  have hbase : F⟮x⟯.restrict (le_normalClosure F⟮x⟯) = F⟮a⟯ := by
    apply lift_injective N
    rw [lift_adjoin_simple, lift_restrict]
  constructor
  · intro hK
    obtain ⟨σ, hσ⟩ := mem_conjugateSimpleFields_iff.mp hK
    let y : (minpoly F x).rootSet N := ⟨σ a, smul_mem_rootSet σ ha⟩
    refine ⟨y, ?_⟩
    rw [← hσ, hbase, adjoin_map]
    simp only [Set.image_singleton]
    rfl
  · rintro ⟨y, rfl⟩
    obtain ⟨σ, hσ⟩ := mem_orbit_iff.mp
      ((Set.ext_iff.mp (coe_rootSet_eq_orbit_of_irreducible
        (minpoly.irreducible hx) ha) y).mp y.2)
    apply mem_conjugateSimpleFields_iff.mpr
    refine ⟨σ, ?_⟩
    rw [hbase, adjoin_map, Set.image_singleton]
    exact congrArg (fun z : N ↦ F⟮z⟯) hσ

/-- For any root `y` of `minpoly F x` in its splitting field, the conjugacy orbit of the
transported point stabilizer in `Gal(normalClosure F F⟮x⟯ E/F)` coincides with the conjugacy orbit
of the fixing subgroup of `F⟮x⟯`. -/
private theorem orbit_map_stabilizer_galEquivNormalClosure {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField) :
    MulAction.orbit (ConjAct Gal(normalClosure F F⟮x⟯ E/F))
        ((stabilizer (minpoly F x).Gal y).map (galEquivNormalClosure hx hsplit : _ →* _)) =
      MulAction.orbit (ConjAct Gal(normalClosure F F⟮x⟯ E/F))
        (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup := by
  obtain ⟨y₀, -, hy₀⟩ := exists_root_map_stabilizer_eq_fixingSubgroup hx hsplit
  have := Polynomial.Gal.galActionAux_isPretransitive (minpoly.irreducible hx)
  obtain ⟨g, rfl⟩ := exists_smul_eq (minpoly F x).Gal y₀ y
  rw [stabilizer_smul_eq_stabilizer_map_conj, Subgroup.map_map_conj,
    ← MulEquiv.toMonoidHom_eq_coe, hy₀, MulAction.orbit_eq_iff, mem_orbit_conjAct_iff]
  exact ⟨galEquivNormalClosure hx hsplit g, rfl⟩

/-- For any root `y` of `minpoly F x` in its splitting field, conjugates of `F⟮x⟯` in its
normal closure correspond bijectively to conjugates of the point stabilizer of `y` in
`(minpoly F x).Gal`. -/
noncomputable def conjugateSimpleFieldsEquivConjugateSubgroups {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField) :
    conjugateSimpleFields (F := F) x ≃
      MulAction.orbit (ConjAct (minpoly F x).Gal) (stabilizer (minpoly F x).Gal y) :=
  letI : IsGalois F (normalClosure F F⟮x⟯ E) :=
    isGalois_normalClosure_adjoin_simple hsep hsplit
  (IntermediateField.conjugateFieldsEquivConjugateSubgroups
    (F⟮x⟯.restrict (le_normalClosure F⟮x⟯))).trans <|
    ((MulEquiv.conjugateSubgroupsEquiv
      (galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit)
      (stabilizer (minpoly F x).Gal y)).trans
        (Set.equivOfEq (orbit_map_stabilizer_galEquivNormalClosure
          (IsSeparable.isIntegral hsep) hsplit y))).symm

/-- The polynomial-group correspondence sends a conjugate simple field to the inverse image
of its fixing subgroup under the normal-closure Galois-group equivalence. -/
@[simp]
theorem conjugateSimpleFieldsEquivConjugateSubgroups_apply {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField)
    (K : conjugateSimpleFields (F := F) x) :
    ((conjugateSimpleFieldsEquivConjugateSubgroups hsep hsplit y K).1).map
      ((galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit) : _ →* _) =
      K.1.fixingSubgroup := by
  let _ : IsGalois F (normalClosure F F⟮x⟯ E) :=
    isGalois_normalClosure_adjoin_simple hsep hsplit
  rw [← Subgroup.map_symm_eq_iff_map_eq]
  unfold conjugateSimpleFieldsEquivConjugateSubgroups conjugateSimpleFields at *
  simp

/-- The fixing subgroup of the field corresponding to a conjugate point stabilizer is its
transported subgroup. -/
theorem fixingSubgroup_conjugateSimpleFieldsEquivConjugateSubgroups_symm_apply {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField)
    (H : MulAction.orbit (ConjAct (minpoly F x).Gal)
      (stabilizer (minpoly F x).Gal y)) :
    (((conjugateSimpleFieldsEquivConjugateSubgroups hsep hsplit y).symm H).1).fixingSubgroup =
      H.1.map ((galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit) : _ →* _) := by
  rw [← conjugateSimpleFieldsEquivConjugateSubgroups_apply hsep hsplit y
    ((conjugateSimpleFieldsEquivConjugateSubgroups hsep hsplit y).symm H),
    Equiv.apply_symm_apply]

/-- The field corresponding to a conjugate point stabilizer is the fixed field of its
transported subgroup. -/
@[simp]
theorem conjugateSimpleFieldsEquivConjugateSubgroups_symm_apply {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField)
    (H : MulAction.orbit (ConjAct (minpoly F x).Gal)
      (stabilizer (minpoly F x).Gal y)) :
    ((conjugateSimpleFieldsEquivConjugateSubgroups hsep hsplit y).symm H).1 =
      fixedField (H.1.map
        ((galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit) : _ →* _)) := by
  let _ : IsGalois F (normalClosure F F⟮x⟯ E) :=
    isGalois_normalClosure_adjoin_simple hsep hsplit
  rw [← fixingSubgroup_conjugateSimpleFieldsEquivConjugateSubgroups_symm_apply hsep hsplit y H,
    InfiniteGalois.fixedField_fixingSubgroup]

/-- A normalizer coset for the simple field specifies one of its conjugate images. -/
noncomputable def quotientNormalizerEquivConjugateSimpleFields {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) :
    Gal(normalClosure F F⟮x⟯ E/F) ⧸
      Subgroup.normalizer
        ((F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup :
          Set Gal(normalClosure F F⟮x⟯ E/F)) ≃ conjugateSimpleFields (F := F) x := by
  let _ : IsGalois F (normalClosure F F⟮x⟯ E) :=
    isGalois_normalClosure_adjoin_simple hsep hsplit
  exact IntermediateField.quotientNormalizerEquivConjugateFields
    (F⟮x⟯.restrict (le_normalClosure F⟮x⟯))

/-- A coset representative sends the simple field to its image under that automorphism. -/
@[simp]
theorem quotientNormalizerEquivConjugateSimpleFields_mk {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (σ : Gal(normalClosure F F⟮x⟯ E/F)) :
    ((quotientNormalizerEquivConjugateSimpleFields hsep hsplit (QuotientGroup.mk σ)).1) =
      σ • (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)) := by
  let _ : IsGalois F (normalClosure F F⟮x⟯ E) :=
    isGalois_normalClosure_adjoin_simple hsep hsplit
  exact IntermediateField.quotientNormalizerEquivConjugateFields_mk
    (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)) σ

/-- The normalizer-coset parametrization of simple fields is Galois-equivariant. -/
@[simp]
theorem quotientNormalizerEquivConjugateSimpleFields_smul {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (σ : Gal(normalClosure F F⟮x⟯ E/F))
    (q : Gal(normalClosure F F⟮x⟯ E/F) ⧸
      Subgroup.normalizer
        ((F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup :
          Set Gal(normalClosure F F⟮x⟯ E/F))) :
    (quotientNormalizerEquivConjugateSimpleFields hsep hsplit (σ • q)).1 =
      σ • (quotientNormalizerEquivConjugateSimpleFields hsep hsplit q).1 := by
  let _ : IsGalois F (normalClosure F F⟮x⟯ E) :=
    isGalois_normalClosure_adjoin_simple hsep hsplit
  exact IntermediateField.quotientNormalizerEquivConjugateFields_smul
    (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)) σ q

/-- When a point stabilizer corresponds to the fixing subgroup of the simple field, the
polynomial Galois group equivalence sends its normalizer to the normalizer of that fixing
subgroup. -/
private theorem map_normalizer_stabilizer_galEquivNormalClosure {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField)
    (hy : (stabilizer (minpoly F x).Gal y).map
      (galEquivNormalClosure hx hsplit).toMonoidHom =
        (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup) :
    (Subgroup.normalizer
      (stabilizer (minpoly F x).Gal y : Set (minpoly F x).Gal)).map
        ((galEquivNormalClosure hx hsplit) : _ →* _) =
      Subgroup.normalizer
        ((F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup :
          Set Gal(normalClosure F F⟮x⟯ E/F)) := by
  rw [← hy]
  simpa only [MulEquiv.toMonoidHom_eq_coe] using
    Subgroup.map_equiv_normalizer_eq (stabilizer (minpoly F x).Gal y)
      (galEquivNormalClosure hx hsplit)

/-- Cosets of the normalizer of a point stabilizer in the polynomial Galois group index
the conjugate images of the simple field. -/
noncomputable def quotientGalNormalizerEquivConjugateSimpleFields {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField)
    (hy : (stabilizer (minpoly F x).Gal y).map
      (galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit).toMonoidHom =
        (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup) :
    (minpoly F x).Gal ⧸
      Subgroup.normalizer (stabilizer (minpoly F x).Gal y : Set (minpoly F x).Gal) ≃
        conjugateSimpleFields (F := F) x := by
  let e := galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit
  have hn := map_normalizer_stabilizer_galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit
    y hy
  exact (QuotientGroup.congrOfMapEq e hn).trans
    (quotientNormalizerEquivConjugateSimpleFields hsep hsplit)

/-- A polynomial Galois coset represented by `σ` gives the field obtained by the
corresponding automorphism of the normal closure. -/
@[simp]
theorem quotientGalNormalizerEquivConjugateSimpleFields_mk {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField)
    (hy : (stabilizer (minpoly F x).Gal y).map
      (galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit).toMonoidHom =
        (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup)
    (σ : (minpoly F x).Gal) :
    ((quotientGalNormalizerEquivConjugateSimpleFields hsep hsplit y hy
      (QuotientGroup.mk σ)).1) =
        galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit σ •
          (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)) := by
  let e := galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit
  have hn := map_normalizer_stabilizer_galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit
    y hy
  -- The composite equivalence is defined with local transports; expose its final
  -- application so the quotient transport rule can rewrite the representative.
  change ((quotientNormalizerEquivConjugateSimpleFields hsep hsplit
    (QuotientGroup.congrOfMapEq e hn (QuotientGroup.mk σ))).1) = _
  rw [QuotientGroup.congrOfMapEq_mk]
  exact quotientNormalizerEquivConjugateSimpleFields_mk hsep hsplit _

/-- The field range of the embedding indexed by a root-stabilizer coset is the conjugate
field indexed by the image of that coset in the normalizer quotient. -/
theorem quotientGalStabilizerEquivAlgHomSimpleField_fieldRange {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField)
    (hy : (stabilizer (minpoly F x).Gal y).map
      (galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit).toMonoidHom =
        (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup)
    (q : (minpoly F x).Gal ⧸ stabilizer (minpoly F x).Gal y) :
    (quotientGalStabilizerEquivAlgHomSimpleField (IsSeparable.isIntegral hsep) hsplit
      y q).fieldRange =
      (quotientGalNormalizerEquivConjugateSimpleFields hsep hsplit y hy
        (Subgroup.quotientMapOfLE Subgroup.le_normalizer q)).1 := by
  obtain ⟨σ, rfl⟩ := QuotientGroup.mk_surjective q
  let hx := IsSeparable.isIntegral hsep
  let N := normalClosure F F⟮x⟯ E
  let e := splittingFieldEquivNormalClosure hx hsplit
  have hrange (φ : F⟮x⟯ →ₐ[F] N) :
      φ.fieldRange = F⟮φ (AdjoinSimple.gen F x)⟯ := by
    rw [AlgHom.fieldRange_eq_map, ← adjoin_adjoinSimple_gen_eq_top (F := F) x,
      IntermediateField.adjoin_map]
    simp only [Set.image_singleton]
  let _ : IsGalois F N := isGalois_normalClosure_adjoin_simple hsep hsplit
  have hbase : F⟮(e y : N)⟯ = F⟮x⟯.restrict (le_normalClosure F⟮x⟯) := by
    apply (InfiniteGalois.fixedField_fixingSubgroup _).symm.trans
    rw [← InfiniteGalois.fixedField_fixingSubgroup
      (F⟮x⟯.restrict (le_normalClosure F⟮x⟯))]
    congr 1
    exact (map_stabilizer_galEquivNormalClosure hx hsplit y).symm.trans hy
  rw [hrange, quotientGalStabilizerEquivAlgHomSimpleField_mk_gen,
    Subgroup.quotientMapOfLE_apply_mk, quotientGalNormalizerEquivConjugateSimpleFields_mk]
  have heval : e (σ • (y : (minpoly F x).SplittingField)) =
      galEquivNormalClosure hx hsplit σ (e y) :=
    (galEquivNormalClosure_apply hx hsplit σ y).symm
  rw [heval]
  simpa only [IntermediateField.adjoin_map, Set.image_singleton,
    AlgEquiv.toAlgHom_apply, AlgEquiv.smul_intermediateField_def] using
    congrArg (fun K : IntermediateField F N ↦
      K.map (galEquivNormalClosure hx hsplit σ).toAlgHom) hbase

/-- The polynomial normalizer-coset parametrization respects the transported Galois action. -/
@[simp]
theorem quotientGalNormalizerEquivConjugateSimpleFields_smul {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField)
    (hy : (stabilizer (minpoly F x).Gal y).map
      (galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit).toMonoidHom =
        (F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup)
    (σ : (minpoly F x).Gal)
    (q : (minpoly F x).Gal ⧸
      Subgroup.normalizer (stabilizer (minpoly F x).Gal y : Set (minpoly F x).Gal)) :
    (quotientGalNormalizerEquivConjugateSimpleFields hsep hsplit y hy (σ • q)).1 =
      galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit σ •
        (quotientGalNormalizerEquivConjugateSimpleFields hsep hsplit y hy q).1 := by
  induction q using Quotient.inductionOn' with
  | _ τ =>
    -- The quotient action on representatives reduces definitionally to multiplication.
    change (quotientGalNormalizerEquivConjugateSimpleFields hsep hsplit y hy
      (QuotientGroup.mk (σ * τ))).1 = _
    simp [quotientGalNormalizerEquivConjugateSimpleFields_mk, mul_smul]

/-- For a separable minimal polynomial splitting in `E`, the number of conjugates of `F⟮x⟯` is
the index of the normalizer of its fixing subgroup in the Galois group of the normal closure. -/
theorem ncard_conjugateSimpleFields {x : E} (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) :
    (conjugateSimpleFields (F := F) x).ncard =
      (Subgroup.normalizer
        ((F⟮x⟯.restrict (le_normalClosure F⟮x⟯)).fixingSubgroup :
          Set Gal(normalClosure F F⟮x⟯ E/F))).index := by
  let _ : IsGalois F (normalClosure F F⟮x⟯ E) :=
    isGalois_normalClosure_adjoin_simple hsep hsplit
  exact IntermediateField.ncard_conjugateFields
    (F⟮x⟯.restrict (le_normalClosure F⟮x⟯))

/-- For any root `y` of `minpoly F x` in its splitting field, the number of conjugate simple
fields is the index of the normalizer of the point stabilizer of `y` in `(minpoly F x).Gal`. -/
theorem ncard_conjugateSimpleFields_eq_index_normalizer {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits)
    (y : (minpoly F x).rootSet (minpoly F x).SplittingField) :
    (conjugateSimpleFields (F := F) x).ncard =
      (Subgroup.normalizer
        (stabilizer (minpoly F x).Gal y : Set (minpoly F x).Gal)).index :=
  (Set.ncard_congr' (conjugateSimpleFieldsEquivConjugateSubgroups hsep hsplit y)).trans
    (Subgroup.index_normalizer_eq_ncard_orbit _).symm

/-- A root corresponding to the original generator identifies the fixing subgroup of `F⟮x⟯`
with its point stabilizer. Hence the number of conjugate fields is the index of the normalizer
of that transported stabilizer. -/
theorem exists_root_ncard_conjugateSimpleFields_eq_index_normalizer {x : E}
    (hsep : (minpoly F x).Separable)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) :
    ∃ y : (minpoly F x).rootSet (minpoly F x).SplittingField,
      (splittingFieldEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit y : E) = x ∧
      (conjugateSimpleFields (F := F) x).ncard =
        (Subgroup.normalizer
          (((stabilizer (minpoly F x).Gal y).map
            (galEquivNormalClosure (IsSeparable.isIntegral hsep) hsplit).toMonoidHom :
              Subgroup Gal(normalClosure F F⟮x⟯ E/F)) :
            Set Gal(normalClosure F F⟮x⟯ E/F))).index := by
  obtain ⟨y, hy, hstabilizer⟩ :=
    exists_root_map_stabilizer_eq_fixingSubgroup (IsSeparable.isIntegral hsep) hsplit
  refine ⟨y, hy, ?_⟩
  rw [ncard_conjugateSimpleFields hsep hsplit, hstabilizer]

end TauCeti
