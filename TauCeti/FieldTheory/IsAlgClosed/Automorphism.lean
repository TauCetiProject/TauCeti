/-!
# Extending automorphisms to an algebraically closed field

An algebraically closed field `Ω` is an algebraic closure of the polynomial ring on any
transcendence basis of `Ω` over a base ring. So a ring isomorphism between the polynomial rings
on transcendence bases of two algebraically closed fields `Ω` and `Ω'` extends to a ring
isomorphism `Ω ≃+* Ω'`. The construction follows Mathlib's
`IsAlgClosed.equivOfTranscendenceBasis`, which treats the isomorphism of polynomial rings induced
by a bijection of the bases over a fixed base ring, and records how the extension acts.

Two consequences describe the automorphism group of an algebraically closed field `Ω`, for
instance `ℂ`, relative to a subring `R`:

* every ring automorphism of `R` extends to a ring automorphism of `Ω`;
* the elements of `Ω` fixed by every automorphism of `Ω` over a perfect field `K` are exactly
  the elements of `K`. An element algebraic over `K` but not in `K` is moved by an automorphism
  of the algebraic closure of `K` in `Ω`, which is Galois over `K`, extended to `Ω`; an element
  `x` transcendental over `K` is sent to `x + 1` by an automorphism over `K`.

For `Ω = ℂ` and a subfield `K` these are the statements that every automorphism of `K` extends to
`ℂ` and that the fixed field of `Aut(ℂ / K)` is `K`. They are the starting point for fields of
moduli of algebraic curves over `ℂ`, such as the relative field of moduli of a Belyi pair.

Perfectness is needed: if `K` has characteristic `p` and `a ∈ K` is not a `p`-th power, then the
unique `p`-th root of `a` in `Ω` is fixed by every automorphism of `Ω` over `K`.

## Main results

* `IsTranscendenceBasis.exists_ringEquiv_apply_aeval`: an isomorphism of the polynomial rings on
  transcendence bases extends to the algebraically closed fields.
* `IsTranscendenceBasis.exists_ringEquiv_comp_algebraMap`: an isomorphism of base rings, together
  with a bijection of transcendence bases, extends.
* `RingEquiv.exists_ringEquiv_apply_algebraMap`: every automorphism of a subring
  extends to an automorphism of `Ω`.
* `AlgEquiv.exists_algEquiv_apply_algebraMap`: every automorphism of a subring over a base ring
  extends to an automorphism of `Ω` over that base.
* `Transcendental.exists_algEquiv_apply_eq_add_one`: an element transcendental over the
  base is sent to itself plus one by some automorphism of `Ω` over the base.
* `TauCeti.IsAlgClosed.mem_range_algebraMap_iff_fixed`,
  `TauCeti.IsAlgClosed.fixedField_top_eq_bot`: the fixed field of all automorphisms of `Ω` over
  a perfect field `K` is `K`.

## References

* Bernhard Köck, *Belyi's theorem revisited*, Beiträge zur Algebra und Geometrie 45 (2004),
  253–265, §1.
* Serge Lang, *Algebra*, revised 3rd ed., Graduate Texts in Mathematics 211, Springer, 2002,
  Chapter VIII, §1 (transcendence bases).
-/

public section

open MvPolynomial

variable {R R' Ω Ω' : Type*} [CommRing R] [CommRing R'] [Field Ω] [Field Ω'] [Algebra R Ω]
  [Algebra R' Ω'] [IsAlgClosed Ω] [IsAlgClosed Ω']

namespace IsTranscendenceBasis

/-- A ring isomorphism between the polynomial rings on transcendence bases `v` of `Ω` over `R`
and `w` of `Ω'` over `R'` extends to a ring isomorphism of the algebraically closed fields `Ω`
and `Ω'`, compatibly with evaluation at `v` and at `w`. -/
theorem exists_ringEquiv_apply_aeval {ι κ : Type*} {v : ι → Ω} {w : κ → Ω'}
    (hv : IsTranscendenceBasis R v) (hw : IsTranscendenceBasis R' w)
    (φ : MvPolynomial ι R ≃+* MvPolynomial κ R') :
    ∃ τ : Ω ≃+* Ω', ∀ p, τ (aeval v p) = aeval w (φ p) := by
  have := IsAlgClosed.isAlgClosure_of_transcendence_basis v hv
  have := IsAlgClosed.isAlgClosure_of_transcendence_basis w hw
  -- Transport `φ` to the subrings generated by the transcendence bases.
  let e : Algebra.adjoin R (Set.range v) ≃+* Algebra.adjoin R' (Set.range w) :=
    hv.1.aevalEquiv.symm.toRingEquiv.trans (φ.trans hw.1.aevalEquiv.toRingEquiv)
  refine ⟨IsAlgClosure.equivOfEquiv Ω Ω' e, fun p ↦ ?_⟩
  have h := IsAlgClosure.equivOfEquiv_algebraMap Ω Ω' e (hv.1.aevalEquiv p)
  simpa [e] using h

/-- A ring isomorphism `σ : R ≃+* R'`, together with a bijection `e` between transcendence bases
`v` of `Ω` over `R` and `w` of `Ω'` over `R'`, extends to a ring isomorphism of the
algebraically closed fields `Ω` and `Ω'` sending `v i` to `w (e i)`. -/
theorem exists_ringEquiv_comp_algebraMap {ι κ : Type*} {v : ι → Ω} {w : κ → Ω'}
    (hv : IsTranscendenceBasis R v) (hw : IsTranscendenceBasis R' w) (σ : R ≃+* R')
    (e : ι ≃ κ) :
    ∃ τ : Ω ≃+* Ω', (τ : Ω →+* Ω').comp (algebraMap R Ω) = (algebraMap R' Ω').comp σ ∧
      ∀ i, τ (v i) = w (e i) := by
  obtain ⟨τ, hτ⟩ := exists_ringEquiv_apply_aeval hv hw
    ((mapEquiv ι σ).trans (renameEquiv R' e).toRingEquiv)
  refine ⟨τ, RingHom.ext fun r ↦ ?_, fun i ↦ ?_⟩
  · simpa using hτ (C r)
  · simpa using hτ (X i)

end IsTranscendenceBasis

namespace RingEquiv

/-- Every ring automorphism `σ` of `R` extends to a ring automorphism of an algebraically closed
field `Ω` containing `R`. For `Ω = ℂ`, every automorphism of a subfield of `ℂ` extends to an
automorphism of `ℂ`. -/
theorem exists_ringEquiv_apply_algebraMap [FaithfulSMul R Ω] (σ : R ≃+* R) :
    ∃ τ : Ω ≃+* Ω, ∀ r, τ (algebraMap R Ω r) = algebraMap R Ω (σ r) := by
  obtain ⟨ι, v, hv⟩ := exists_isTranscendenceBasis' R Ω
  obtain ⟨τ, hτ, -⟩ := hv.exists_ringEquiv_comp_algebraMap hv σ (Equiv.refl ι)
  exact ⟨τ, RingHom.congr_fun hτ⟩

end RingEquiv

namespace AlgEquiv

/-- Every `K`-algebra automorphism `σ` of `R` extends to a `K`-algebra automorphism of an
algebraically closed field `Ω` containing `R`. -/
theorem exists_algEquiv_apply_algebraMap {K : Type*} [CommRing K] [Algebra K R] [Algebra K Ω]
    [IsScalarTower K R Ω] [FaithfulSMul R Ω] (σ : R ≃ₐ[K] R) :
    ∃ τ : Ω ≃ₐ[K] Ω, ∀ r, τ (algebraMap R Ω r) = algebraMap R Ω (σ r) := by
  obtain ⟨τ, hτ⟩ := σ.toRingEquiv.exists_ringEquiv_apply_algebraMap (Ω := Ω)
  refine ⟨AlgEquiv.ofRingEquiv (f := τ) fun k ↦ ?_, hτ⟩
  rw [IsScalarTower.algebraMap_apply K R Ω, hτ]
  exact congrArg (algebraMap R Ω) (σ.commutes k)

end AlgEquiv

namespace Transcendental

/-- An element `x` of an algebraically closed field `Ω` that is transcendental over `R` is sent
to `x + 1` by some automorphism of `Ω` over `R`. In particular `x` is not fixed by all
automorphisms of `Ω` over `R`. -/
theorem exists_algEquiv_apply_eq_add_one {x : Ω} (hx : Transcendental R x) :
    ∃ τ : Ω ≃ₐ[R] Ω, τ x = x + 1 := by
  classical
  -- Extend `{x}` to a transcendence basis `s`, and translate the variable at `x`.
  obtain ⟨s, hxs, hs⟩ := exists_isTranscendenceBasis_superset (s := {x})
    ((algebraicIndependent_singleton_iff ⟨x, Set.mem_singleton x⟩).2 hx)
  let i : s := ⟨x, hxs (Set.mem_singleton x)⟩
  let φ : MvPolynomial s R ≃ₐ[R] MvPolynomial s R :=
    AlgEquiv.ofAlgHom (MvPolynomial.aeval (Function.update X i (X i + 1)))
      (MvPolynomial.aeval (Function.update X i (X i - 1)))
      (algHom_ext fun j ↦ by
        rcases eq_or_ne j i with rfl | hj <;> simp [Function.update_of_ne, *])
      (algHom_ext fun j ↦ by
        rcases eq_or_ne j i with rfl | hj <;> simp [Function.update_of_ne, *])
  obtain ⟨τ, hτ⟩ := hs.exists_ringEquiv_apply_aeval hs φ.toRingEquiv
  refine ⟨AlgEquiv.ofRingEquiv (f := τ) fun r ↦ by simpa [φ] using hτ (C r), ?_⟩
  simpa [φ, i] using hτ (X i)

end Transcendental

namespace TauCeti.IsAlgClosed

variable {K : Type*} [Field K] [PerfectField K] [Algebra K Ω]

/-- An element of an algebraically closed field `Ω` is fixed by every automorphism of `Ω` over a
perfect field `K` if and only if it lies in `K`. For `Ω = ℂ`, the fixed field of `Aut(ℂ / K)` is
`K` for every subfield `K` of `ℂ`. -/
theorem mem_range_algebraMap_iff_fixed (x : Ω) :
    x ∈ Set.range (algebraMap K Ω) ↔ ∀ τ : Ω ≃ₐ[K] Ω, τ x = x := by
  refine ⟨by rintro ⟨k, rfl⟩ τ; exact τ.commutes k, fun hx ↦ ?_⟩
  by_cases halg : IsAlgebraic K x
  · -- The algebraic closure `A` of `K` in `Ω` is Galois over `K`, and every automorphism of `A`
    -- over `K` extends to an automorphism of `Ω` over `K`.
    let A := algebraicClosure K Ω
    let y : A := ⟨x, mem_algebraicClosure_iff.2 halg⟩
    obtain ⟨k, hk⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed (k := K) y).2 fun f ↦ by
      obtain ⟨τ, hτ⟩ := f.exists_algEquiv_apply_algebraMap (R := A) (Ω := Ω)
      exact Subtype.ext ((hτ y).symm.trans (hx τ))
    exact ⟨k, by simpa [y] using congr_arg (algebraMap A Ω) hk⟩
  · obtain ⟨τ, hτ⟩ := Transcendental.exists_algEquiv_apply_eq_add_one (R := K) halg
    simp [hx τ] at hτ

/-- The fixed field of all automorphisms of an algebraically closed field `Ω` over a perfect
field `K` is `K`. -/
@[simp]
theorem fixedField_top_eq_bot :
    IntermediateField.fixedField (⊤ : Subgroup (Ω ≃ₐ[K] Ω)) = ⊥ := by
  ext x
  simpa [IntermediateField.mem_fixedField_iff, IntermediateField.mem_bot] using
    (mem_range_algebraMap_iff_fixed (K := K) x).symm

end TauCeti.IsAlgClosed
