/-!
# Matsumoto's presentation of `K₂` of a field

For a field `F`, the **Matsumoto group** is the tensor square `Fˣ ⊗_ℤ Fˣ` of the unit group,
written additively, modulo the subgroup generated by the tensors `x ⊗ y` with `x + y = 1`. The
class of `x ⊗ y` is the **Steinberg symbol** `{x, y}`, so the group is generated by symbols subject
to bilinearity and the Steinberg relation `{x, 1 - x} = 0`. Matsumoto's theorem identifies it with
`K₂(F)`, the kernel of the map from the Steinberg group of `F` to its stable general linear group,
the class of `x ⊗ y` going to the commutator of lifts of `diag(x, x⁻¹, 1)` and `diag(y, 1, y⁻¹)`.

This file develops the group and its symbols independently of the Steinberg group:

* the symbols are biadditive, and the Steinberg relation implies `{x, -x} = 0`, the
  antisymmetry `{x, y} + {y, x} = 0` and `{x, x} = {x, -1}`, so `{x, x}` has order dividing two;
* the universal property: a biadditive pairing on `Fˣ` that vanishes on pairs adding to one
  factors uniquely through the symbol map;
* **every symbol vanishes over a finite field**, so the Matsumoto group of a finite field is
  trivial. The unit group is cyclic with generator `g`, so it suffices that `{g, g} = 0`. In
  characteristic two this is `{g, -1} = {g, 1} = 0`. Otherwise some `x` has `x` and `1 - x` both
  nonsquares, hence odd powers of `g`, and `{x, 1 - x} = 0` is an odd multiple of `{g, g}`.

Through Matsumoto's theorem the last statement is Steinberg's computation `K₂(𝔽_q) = 0`.

## Main definitions

* `TauCeti.MatsumotoGroup F`: the quotient of `Fˣ ⊗_ℤ Fˣ` by the Steinberg relations.
* `TauCeti.MatsumotoGroup.symbol x y`: the Steinberg symbol `{x, y}`, the class of `x ⊗ y`.
* `TauCeti.MatsumotoGroup.lift`: the homomorphism induced by a biadditive Steinberg pairing.

## Main results

* `TauCeti.MatsumotoGroup.symbol_of_add_eq_one`: `{x, y} = 0` when `x + y = 1`.
* `TauCeti.MatsumotoGroup.symbol_self_neg`: `{x, -x} = 0`.
* `TauCeti.MatsumotoGroup.symbol_add_symbol_swap`: `{x, y} + {y, x} = 0`.
* `TauCeti.MatsumotoGroup.symbol_self`: `{x, x} = {x, -1}`.
* `TauCeti.MatsumotoGroup.induction_on`: the group is generated by the symbols.
* `TauCeti.MatsumotoGroup.hom_ext`: homomorphisms out of the group agree when they agree on
  symbols.
* `TauCeti.MatsumotoGroup.symbol_eq_zero_of_finite`: over a finite field every symbol is zero,
  so the Matsumoto group is trivial.

## References

* H. Matsumoto, *Sur les sous-groupes arithmétiques des groupes semi-simples déployés*,
  Ann. Sci. École Norm. Sup. (4) 2 (1969).
* J. Milnor, *Introduction to Algebraic K-Theory*, §§9 and 11.
* C. Weibel, *The K-book*, Chapter III, Theorem 6.1 and Corollary 6.1.1.
-/

public section

open TensorProduct

namespace TauCeti

variable (F : Type*) [Field F]

/-- The group of Matsumoto's presentation of a field `F`: the tensor square `Fˣ ⊗_ℤ Fˣ`, written
additively, modulo the subgroup generated by the `x ⊗ y` with `x + y = 1`, that is, by the
`x ⊗ (1 - x)` for `x ≠ 0, 1`. -/
abbrev MatsumotoGroup :=
  TensorProduct ℤ (Additive Fˣ) (Additive Fˣ) ⧸ Submodule.span ℤ
    {t | ∃ x y : Fˣ, (x : F) + y = 1 ∧
      t = TensorProduct.tmul ℤ (Additive.ofMul x) (Additive.ofMul y)}

namespace MatsumotoGroup

variable {F}

/-- The Steinberg symbol `{x, y}` in the Matsumoto group: the class of `x ⊗ y`. -/
def symbol (x y : Fˣ) : MatsumotoGroup F :=
  Submodule.Quotient.mk (Additive.ofMul x ⊗ₜ[ℤ] Additive.ofMul y)

/-- The class of a pure tensor of units is their Steinberg symbol. -/
@[simp]
theorem mk_tmul (x y : Fˣ) :
    (Submodule.Quotient.mk (Additive.ofMul x ⊗ₜ[ℤ] Additive.ofMul y) : MatsumotoGroup F) =
      symbol x y :=
  (rfl)

/-- **The Steinberg relation.** `{x, y} = 0` when `x + y = 1`. -/
theorem symbol_of_add_eq_one {x y : Fˣ} (h : (x : F) + y = 1) : symbol x y = 0 :=
  (Submodule.Quotient.mk_eq_zero _).2 (Submodule.subset_span ⟨x, y, h, rfl⟩)

/-- **The Steinberg relation.** `{x, 1 - x} = 0` for `x ≠ 1`. -/
theorem symbol_mk0_one_sub (x : Fˣ) (hx : (1 : F) - x ≠ 0) :
    symbol x (Units.mk0 (1 - x) hx) = 0 :=
  symbol_of_add_eq_one (by simp)

@[simp]
theorem symbol_mul_left (x x' y : Fˣ) : symbol (x * x') y = symbol x y + symbol x' y := by
  simp only [symbol, ofMul_mul, add_tmul, Submodule.Quotient.mk_add]

@[simp]
theorem symbol_mul_right (x y y' : Fˣ) : symbol x (y * y') = symbol x y + symbol x y' := by
  simp only [symbol, ofMul_mul, tmul_add, Submodule.Quotient.mk_add]

@[simp]
theorem symbol_one_left (y : Fˣ) : symbol 1 y = 0 := by
  simp only [symbol, ofMul_one, zero_tmul, Submodule.Quotient.mk_zero]

@[simp]
theorem symbol_one_right (x : Fˣ) : symbol x 1 = 0 := by
  simp only [symbol, ofMul_one, tmul_zero, Submodule.Quotient.mk_zero]

@[simp]
theorem symbol_inv_left (x y : Fˣ) : symbol x⁻¹ y = -symbol x y := by
  simp only [symbol, ofMul_inv, neg_tmul, Submodule.Quotient.mk_neg]

@[simp]
theorem symbol_inv_right (x y : Fˣ) : symbol x y⁻¹ = -symbol x y := by
  simp only [symbol, ofMul_inv, tmul_neg, Submodule.Quotient.mk_neg]

@[simp]
theorem symbol_zpow_left (x y : Fˣ) (n : ℤ) : symbol (x ^ n) y = n • symbol x y := by
  rw [symbol, symbol, ofMul_zpow, ← Submodule.Quotient.mk_smul, smul_tmul']

@[simp]
theorem symbol_zpow_right (x y : Fˣ) (n : ℤ) : symbol x (y ^ n) = n • symbol x y := by
  rw [symbol, symbol, ofMul_zpow, ← Submodule.Quotient.mk_smul, ← tmul_smul]

@[simp]
theorem symbol_pow_left (x y : Fˣ) (n : ℕ) : symbol (x ^ n) y = n • symbol x y := by
  rw [← zpow_natCast, symbol_zpow_left, natCast_zsmul]

@[simp]
theorem symbol_pow_right (x y : Fˣ) (n : ℕ) : symbol x (y ^ n) = n • symbol x y := by
  rw [← zpow_natCast, symbol_zpow_right, natCast_zsmul]

/-- `{x, -x} = 0` for every unit `x`. -/
@[simp]
theorem symbol_self_neg (x : Fˣ) : symbol x (-x) = 0 := by
  -- For `x ≠ 1`, `-x = (1 - x) / (1 - x⁻¹)`, and both `{x, 1 - x}` and
  -- `{x, 1 - x⁻¹} = -{x⁻¹, 1 - x⁻¹}` vanish by the Steinberg relation.
  rcases eq_or_ne x 1 with rfl | hx
  · exact symbol_one_left _
  have h₁ : (1 : F) - x ≠ 0 := sub_ne_zero.2 (Ne.symm (Units.val_eq_one.not.2 hx))
  have h₂ : (1 : F) - ((x⁻¹ : Fˣ) : F) ≠ 0 :=
    sub_ne_zero.2 (Ne.symm (Units.val_eq_one.not.2 (inv_ne_one.2 hx)))
  have hneg : -x = Units.mk0 (1 - (x : F)) h₁ * (Units.mk0 (1 - ((x⁻¹ : Fˣ) : F)) h₂)⁻¹ := by
    ext
    have hx0 : (x : F) ≠ 0 := x.ne_zero
    have h₂' : (x : F) - 1 ≠ 0 := sub_ne_zero.2 (Units.val_eq_one.not.2 hx)
    simp only [Units.val_neg, Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0]
    field_simp
    ring
  have h₁' := symbol_mk0_one_sub x h₁
  have h₂' := symbol_mk0_one_sub x⁻¹ h₂
  rw [symbol_inv_left, neg_eq_zero] at h₂'
  rw [hneg, symbol_mul_right, symbol_inv_right, h₁', h₂', neg_zero, add_zero]

/-- **Antisymmetry of Steinberg symbols.** `{x, y} + {y, x} = 0`. -/
theorem symbol_add_symbol_swap (x y : Fˣ) : symbol x y + symbol y x = 0 := by
  -- Expand `{x y, -(x y)} = 0` using `-(x y) = (-x) y = x (-y)`.
  have h := symbol_self_neg (x * y)
  rw [symbol_mul_left, show -(x * y) = -x * y by simp, symbol_mul_right, symbol_self_neg,
    show -x * y = x * -y by simp, symbol_mul_right, symbol_self_neg] at h
  simpa using h

/-- **Antisymmetry of Steinberg symbols.** `{y, x} = -{x, y}`. -/
theorem symbol_swap (x y : Fˣ) : symbol y x = -symbol x y :=
  eq_neg_of_add_eq_zero_right (symbol_add_symbol_swap x y)

/-- `{x, x} = {x, -1}`. -/
theorem symbol_self (x : Fˣ) : symbol x x = symbol x (-1) := by
  calc symbol x x = symbol x (-1 * -x) := by rw [neg_one_mul, neg_neg]
    _ = symbol x (-1) := by rw [symbol_mul_right, symbol_self_neg, add_zero]

/-- The symbol `{x, -1}` has order dividing two. -/
theorem two_nsmul_symbol_neg_one (x : Fˣ) : 2 • symbol x (-1) = 0 := by
  rw [← symbol_pow_right, neg_one_sq, symbol_one_right]

/-- The symbol `{x, x}` has order dividing two. -/
theorem two_nsmul_symbol_self (x : Fˣ) : 2 • symbol x x = 0 := by
  rw [symbol_self, two_nsmul_symbol_neg_one]

/-- **Induction on the Matsumoto group.** The group is generated by the Steinberg symbols, so a
property that holds for every symbol and is closed under addition holds everywhere. -/
@[elab_as_elim]
theorem induction_on {P : MatsumotoGroup F → Prop} (q : MatsumotoGroup F)
    (symbol : ∀ x y : Fˣ, P (symbol x y)) (add : ∀ a b, P a → P b → P (a + b)) : P q := by
  obtain ⟨t, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  induction t using TensorProduct.inductionOn with
  | tmul a b =>
    obtain ⟨x, rfl⟩ := Additive.ofMul.surjective a
    obtain ⟨y, rfl⟩ := Additive.ofMul.surjective b
    rw [mk_tmul]
    exact symbol x y
  | add s t hs ht => exact add _ _ hs ht

/-- Homomorphisms out of the Matsumoto group are determined by their values on the Steinberg
symbols. -/
@[ext]
theorem hom_ext {A : Type*} [AddMonoid A] {f g : MatsumotoGroup F →+ A}
    (h : ∀ x y : Fˣ, f (symbol x y) = g (symbol x y)) : f = g := by
  ext q
  induction q using induction_on with
  | symbol x y => exact h x y
  | add a b ha hb => simp only [map_add, ha, hb]

/-- **The universal property of the Matsumoto group.** A biadditive pairing `c` on `Fˣ` that
satisfies the Steinberg relation, `c x y = 0` whenever `x + y = 1`, induces a homomorphism
`{x, y} ↦ c x y` on the Matsumoto group; it is unique by `hom_ext`. -/
def lift {A : Type*} [AddCommGroup A] (c : Additive Fˣ →+ Additive Fˣ →+ A)
    (hc : ∀ x y : Fˣ, (x : F) + y = 1 → c (Additive.ofMul x) (Additive.ofMul y) = 0) :
    MatsumotoGroup F →+ A :=
  (Submodule.liftQ _ (liftAddHom c fun r m n ↦ by simp).toIntLinearMap <|
    Submodule.span_le.2 <| by
      rintro _ ⟨x, y, hxy, rfl⟩
      simpa using hc x y hxy).toAddMonoidHom

@[simp]
theorem lift_symbol {A : Type*} [AddCommGroup A] (c : Additive Fˣ →+ Additive Fˣ →+ A)
    (hc : ∀ x y : Fˣ, (x : F) + y = 1 → c (Additive.ofMul x) (Additive.ofMul y) = 0)
    (x y : Fˣ) : lift c hc (symbol x y) = c (Additive.ofMul x) (Additive.ofMul y) := by
  rw [lift, ← mk_tmul]
  simp [-mk_tmul]

/-- In a finite field of characteristic other than `2`, the symbol `{g, g}` of a generator `g`
of the unit group vanishes. -/
private theorem symbol_generator_self_of_ringChar_ne_two [Finite F] (hF : ringChar F ≠ 2)
    {g : Fˣ} (hg : ∀ z : Fˣ, ∃ n : ℕ, g ^ n = z) : symbol g g = 0 := by
  -- For `x` and `1 - x` nonsquares, both are odd powers of `g`, so `0 = {x, 1 - x}` is an odd
  -- multiple of the two-torsion element `{g, g}`.
  obtain ⟨x, hx, hx'⟩ := FiniteField.exists_not_isSquare_and_not_isSquare_one_sub hF
  have hx0 : x ≠ 0 := by rintro rfl; exact hx IsSquare.zero
  have hx1 : 1 - x ≠ 0 := by intro h; rw [h] at hx'; exact hx' IsSquare.zero
  -- A unit whose value is not a square is an odd power of `g`.
  have hodd : ∀ (n : ℕ) (u : Fˣ), g ^ n = u → ¬IsSquare (u : F) → Odd n := by
    rintro n u rfl hu
    refine Nat.not_even_iff_odd.1 fun ⟨k, hk⟩ ↦ hu ⟨(g ^ k : Fˣ), ?_⟩
    rw [hk, pow_add, Units.val_mul]
  obtain ⟨a, ha⟩ := hg (Units.mk0 x hx0)
  obtain ⟨b, hb⟩ := hg (Units.mk0 (1 - x) hx1)
  have h := symbol_of_add_eq_one (x := Units.mk0 x hx0) (y := Units.mk0 (1 - x) hx1) (by simp)
  rw [← ha, ← hb, symbol_pow_left, symbol_pow_right, smul_smul] at h
  obtain ⟨m, hm⟩ := (hodd a _ ha hx).mul (hodd b _ hb hx')
  rw [hm] at h
  simpa [add_smul, mul_comm 2 m, mul_smul, two_nsmul_symbol_self] using h

/-- **Steinberg symbols vanish over a finite field.** Through Matsumoto's theorem this is
`K₂(𝔽_q) = 0`. -/
theorem symbol_eq_zero_of_finite [Finite F] (x y : Fˣ) : symbol x y = 0 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Fˣ)
  have hg' : ∀ z : Fˣ, ∃ n : ℕ, g ^ n = z := fun z ↦ mem_powers_iff_mem_zpowers.2 (hg z)
  have hgg : symbol g g = 0 := by
    by_cases hF : ringChar F = 2
    · have : (-1 : Fˣ) = 1 := Units.ext (by simpa using neg_one_eq_one_iff.2 hF)
      rw [symbol_self, this, symbol_one_right]
    · exact symbol_generator_self_of_ringChar_ne_two hF hg'
  obtain ⟨a, rfl⟩ := hg' x
  obtain ⟨b, rfl⟩ := hg' y
  simp [hgg]

/-- The Matsumoto group of a finite field is trivial. -/
instance [Finite F] : Subsingleton (MatsumotoGroup F) :=
  subsingleton_of_forall_eq 0 fun q ↦ by
    induction q using induction_on with
    | symbol x y => exact symbol_eq_zero_of_finite x y
    | add a b ha hb => rw [ha, hb, add_zero]

end MatsumotoGroup

end TauCeti
