/-!
# Vanishing of Milnor K-theory and Steinberg pairings over finite fields

Suppose `F` is a field whose unit group `Fˣ` is cyclic with generator `g`, and let `c : Fˣ → Fˣ → A`
be a Steinberg pairing into an additive group `A`. Since `c(g^m, g^n) = (m * n) • c(g, g)` and
`2 • c(g, g) = 0`, the pairing vanishes identically whenever either:

* `CharP F 2` (since then `c(g, g) = 0` directly), or
* there exist complementary units `g^m + g^n = 1` with `m` and `n` both odd (since then
  `(m * n) • c(g, g) = 0` with `m * n` odd, forcing `c(g, g) = 0`).

Every finite field `F` has cyclic unit group `Fˣ` and satisfies one of these two alternatives (in
odd characteristic, `TauCeti.FiniteField.exists_not_isSquare_and_not_isSquare_one_sub` produces
complementary nonsquare units whose exponents relative to a generator are odd). Consequently:

* every Steinberg pairing on a finite field is identically zero
  (`IsSteinbergPairing.eq_zero_of_finite`);
* the degree-two symbol group `SymbolGroup F` is subsingleton
  (`SymbolGroup.subsingleton_of_finite`);
* all Milnor K-groups `MilnorK.degree F n` vanish for `n ≥ 2` (`MilnorK.finiteField_vanishing`).

## Main results

* `TauCeti.IsSteinbergPairing.eq_zero_of_isCyclic_of_charTwo`: every Steinberg pairing on a
  characteristic-`2` field with cyclic unit group vanishes.
* `TauCeti.IsSteinbergPairing.eq_zero_of_isCyclic_of_exists_odd_add_eq_one`: the cyclic-unit
  symbol annihilator for Steinberg pairings.
* `TauCeti.IsSteinbergPairing.eq_zero_of_finite`: every Steinberg pairing on a finite field is
  identically zero.
* `TauCeti.SymbolGroup.subsingleton_of_finite`: `SymbolGroup F` is trivial for every finite field.
* `TauCeti.MilnorK.degree_eq_bot_of_finite`: `MilnorK.degree F n = ⊥` for every finite field `F`
  and `2 ≤ n`.
* `TauCeti.MilnorK.finiteField_vanishing`: `Subsingleton (MilnorK.degree F n)` for every finite
  field `F` and `2 ≤ n`.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Ch. III, Corollary 6.1.1 and
  Example 7.2(a).
-/

public section

namespace TauCeti

universe u v

namespace IsSteinbergPairing

variable {F : Type u} [Field F] {A : Type v} [AddGroup A] {c : Fˣ → Fˣ → A}

private theorem eq_zero_of_zpowers (hc : IsSteinbergPairing c) {g : Fˣ}
    (hg : ∀ x : Fˣ, x ∈ Subgroup.zpowers g) (hgg : c g g = 0) (a b : Fˣ) : c a b = 0 := by
  obtain ⟨r, rfl⟩ := hg a
  obtain ⟨s, rfl⟩ := hg b
  rw [hc.map_zpow_left, hc.map_zpow_right, hgg, zsmul_zero, zsmul_zero]

/-- Every Steinberg pairing on a field of characteristic `2` with cyclic unit group vanishes
identically. -/
theorem eq_zero_of_isCyclic_of_charTwo [CharP F 2] [IsCyclic Fˣ] (hc : IsSteinbergPairing c)
    (a b : Fˣ) : c a b = 0 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Fˣ)
  exact hc.eq_zero_of_zpowers hg (hc.map_self_of_charTwo g) a b

/-- **Cyclic-unit symbol annihilator.** If `Fˣ` is generated by `g` and there exist odd integers
`m, n` with `(g ^ m : F) + (g ^ n : F) = 1`, then every Steinberg pairing on `F` vanishes
identically. -/
theorem eq_zero_of_isCyclic_of_exists_odd_add_eq_one (hc : IsSteinbergPairing c) {g : Fˣ}
    (hg : ∀ x : Fˣ, x ∈ Subgroup.zpowers g)
    (hodd : ∃ m n : ℤ, Odd m ∧ Odd n ∧ ((g ^ m : Fˣ) : F) + (g ^ n : Fˣ) = 1)
    (a b : Fˣ) : c a b = 0 := by
  refine hc.eq_zero_of_zpowers hg ?_ a b
  rcases hodd with ⟨m, n, hm, hn, hab⟩
  have hmn_zero : (m * n) • c g g = 0 := by
    have h0 := hc.map_add_eq_one (g ^ m) (g ^ n) hab
    rw [hc.map_zpow_left, hc.map_zpow_right, ← mul_zsmul] at h0
    exact h0
  have htwo : (2 : ℤ) • c g g = 0 :=
    (natCast_zsmul (c g g) 2).trans (hc.two_nsmul_map_self g)
  rcases hm.mul hn with ⟨k, hk⟩
  have hodd_smul : (m * n) • c g g = c g g := by
    rw [hk, add_zsmul, mul_comm (2 : ℤ) k, mul_zsmul]
    simp [htwo]
  exact hodd_smul.symm.trans hmn_zero

/-- Every Steinberg pairing on a finite field into an additive group is identically zero. -/
theorem eq_zero_of_finite [Finite F] (hc : IsSteinbergPairing c) (a b : Fˣ) : c a b = 0 := by
  by_cases hchar : ringChar F = 2
  · have : CharP F 2 := ringChar.of_eq hchar
    exact hc.eq_zero_of_isCyclic_of_charTwo a b
  · obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Fˣ)
    obtain ⟨x, hx, hx1⟩ := FiniteField.exists_not_isSquare_and_not_isSquare_one_sub hchar
    have hx0 : x ≠ 0 := by rintro rfl; exact hx IsSquare.zero
    have hx10 : 1 - x ≠ 0 := by rintro h; rw [h] at hx1; exact hx1 IsSquare.zero
    let u : Fˣ := Units.mk0 x hx0
    let v : Fˣ := Units.mk0 (1 - x) hx10
    have huv : (u : F) + v = 1 := by simp [u, v]
    have hu : ¬IsSquare u := fun ⟨y, hy⟩ ↦ hx ⟨y, by simpa [u] using congrArg Units.val hy⟩
    have hv : ¬IsSquare v := fun ⟨y, hy⟩ ↦ hx1 ⟨y, by simpa [v] using congrArg Units.val hy⟩
    obtain ⟨m, hm⟩ := hg u
    obtain ⟨n, hn⟩ := hg v
    dsimp only at hm hn
    have hodd_of : ∀ k : ℤ, ¬IsSquare (g ^ k) → Odd k := fun k hk ↦
      (Int.even_or_odd k).resolve_left fun ⟨r, hr⟩ ↦
        hk ⟨g ^ r, by rw [hr, zpow_add]⟩
    exact hc.eq_zero_of_isCyclic_of_exists_odd_add_eq_one hg
      ⟨m, n, hodd_of m (hm.symm ▸ hu), hodd_of n (hn.symm ▸ hv), by rw [hm, hn, huv]⟩ a b

end IsSteinbergPairing

section FiniteField

variable {F : Type u} [Field F]

/-- Every symbol `{a, b}` in `SymbolGroup F` vanishes over a finite field `F`. -/
@[simp]
theorem symbol_eq_zero_of_finite [Finite F] (a b : Fˣ) : symbol a b = 0 :=
  isSteinbergPairing_symbol.eq_zero_of_finite a b

/-- The degree-two symbol group `SymbolGroup F` of any finite field is trivial. -/
instance SymbolGroup.subsingleton_of_finite (F : Type u) [Field F] [Finite F] :
    Subsingleton (SymbolGroup F) := by
  refine subsingleton_of_forall_eq 0 fun x ↦ ?_
  induction x using SymbolGroup.induction_on with
  | symbol a b => exact symbol_eq_zero_of_finite a b
  | add x y hx hy => rw [hx, hy, add_zero]

namespace MilnorK

/-- Over a finite field, the product of any two degree-one classes in `MilnorK F` vanishes. -/
@[simp]
theorem ofUnit_mul_ofUnit_eq_zero_of_finite [Finite F] (a b : Fˣ) :
    ofUnit a * ofUnit b = 0 :=
  isSteinbergPairing_mul_ofUnit.eq_zero_of_finite a b

/-- Over a finite field, every Milnor symbol of length at least `2` vanishes. -/
theorem symbol_eq_zero_of_finite [Finite F] {l : List Fˣ} (hl : 2 ≤ l.length) :
    symbol l = 0 := by
  match l with
  | [] => simp at hl
  | [_] => simp at hl
  | a :: b :: t =>
    rw [symbol_cons, symbol_cons, ← mul_assoc, ofUnit_mul_ofUnit_eq_zero_of_finite, zero_mul]

/-- Over a finite field, the degree-`n` Milnor submodule `MilnorK.degree F n` is `⊥` for all
`2 ≤ n`. -/
theorem degree_eq_bot_of_finite (F : Type u) [Field F] [Finite F] {n : ℕ} (hn : 2 ≤ n) :
    degree F n = ⊥ := by
  rw [degree_eq_span_symbol, Submodule.span_eq_bot]
  rintro _ ⟨l, rfl, rfl⟩
  exact symbol_eq_zero_of_finite hn

/-- **Milnor K-theory of finite fields.** For every finite field `F` and every `n ≥ 2`, the
degree-`n` Milnor K-group `MilnorK.degree F n` vanishes. -/
theorem finiteField_vanishing (F : Type u) [Field F] [Finite F] (n : ℕ) (hn : 2 ≤ n) :
    Subsingleton (degree F n) := by
  rw [degree_eq_bot_of_finite F hn]
  infer_instance

end MilnorK

end FiniteField

end TauCeti
