/-!
# Native Milnor K-theory

For a commutative semiring `R`, the **Milnor K-theory ring** `TauCeti.MilnorK R` is the quotient
of the tensor algebra `TensorAlgebra ℤ (Additive Rˣ)` by the two-sided ideal generated by the
Steinberg products `ι(a) * ι(b)` for complementary units `(a : R) + b = 1`.

Each unit `a : Rˣ` gives a degree-one generator `MilnorK.ofUnit a`, and a list of units
`l = [a₁, …, aₙ]` gives the Milnor symbol `MilnorK.symbol l := {a₁, …, aₙ}`, the ordered product
of the corresponding degree-one classes. The degree-`n` piece `MilnorK.degree R n` is the image
of the `n`-th tensor power `(LinearMap.range (TensorAlgebra.ι ℤ)) ^ n` in `MilnorK R`.

This file defines the ring, symbols, degree submodules, universal property, and functoriality in
`R`. The internal `ℕ`-grading and identification of the degree pieces with tensor-power quotients
(and in particular `K₀ᴹ ≃ ℤ`, `K₁ᴹ ≃ Additive Rˣ`, `K₂ᴹ ≃ SymbolGroup R`) are established in
`TauCeti.FieldTheory.MilnorK.Grading`.

## Main definitions

* `TauCeti.milnorRel`: the Steinberg relation on `TensorAlgebra ℤ (Additive Rˣ)`.
* `TauCeti.MilnorK`: the Milnor K-theory ring `RingQuot (milnorRel R)`.
* `TauCeti.MilnorK.ofUnit`: the degree-one generator associated to a unit `a : Rˣ`.
* `TauCeti.MilnorK.ofUnitHom`: the `ℤ`-linear map `Additive Rˣ →ₗ[ℤ] MilnorK R`.
* `TauCeti.MilnorK.symbol`: the Milnor symbol `{a₁, …, aₙ}` of a list of units.
* `TauCeti.MilnorK.degree`: the degree-`n` submodule `MilnorK.degree R n` of `MilnorK R`.
* `TauCeti.MilnorK.lift`: the universal `ℤ`-algebra homomorphism out of `MilnorK R`.
* `TauCeti.MilnorK.map`: functoriality `MilnorK R →ₐ[ℤ] MilnorK S` along a ring homomorphism.

## Main results

* `TauCeti.MilnorK.isSteinbergPairing_mul_ofUnit`: `(a, b) ↦ ofUnit a * ofUnit b` is a Steinberg
  pairing.
* `TauCeti.MilnorK.symbol_mul_entry`: multilinearity of `MilnorK.symbol` in any entry.
* `TauCeti.MilnorK.symbol_eq_zero_of_add_eq_one`: vanishing of symbols with consecutive
  complementary entries.
* `TauCeti.MilnorK.degree_eq_span_symbol`: `MilnorK.degree R n` is the `ℤ`-span of length-`n`
  symbols.
* `TauCeti.MilnorK.ringHom_ext`, `TauCeti.MilnorK.algHom_ext`: ring and `ℤ`-algebra maps out of
  `MilnorK R` are determined by their values on `MilnorK.ofUnit`.
* `TauCeti.MilnorK.map_id`, `TauCeti.MilnorK.map_comp`: strict functoriality of `MilnorK.map`.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Ch. III, §7.1.
* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. 9 (1970), 318–344.
-/

public section

namespace TauCeti

universe u v w

variable (R : Type u) [CommSemiring R]

/-- The Steinberg relation generating the two-sided ideal defining `MilnorK R` inside the tensor
algebra `TensorAlgebra ℤ (Additive Rˣ)`. -/
def milnorRel : TensorAlgebra ℤ (Additive Rˣ) → TensorAlgebra ℤ (Additive Rˣ) → Prop :=
  fun x y ↦ ∃ a b : Rˣ, (a : R) + b = 1 ∧
    x = TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b) ∧ y = 0

/-- Characterization of the generating Steinberg relation `milnorRel R`. -/
theorem milnorRel_iff {R : Type u} [CommSemiring R] {x y : TensorAlgebra ℤ (Additive Rˣ)} :
    milnorRel R x y ↔ ∃ a b : Rˣ, (a : R) + b = 1 ∧
      x = TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b) ∧ y = 0 := by
  rfl

/-- **Milnor K-theory** `K_*ᴹ(R)`, defined as the quotient of `TensorAlgebra ℤ (Additive Rˣ)` by
the two-sided ideal generated by the Steinberg products `ι(a) * ι(b)` for `(a : R) + b = 1`. -/
abbrev MilnorK : Type u := RingQuot (milnorRel R)

namespace MilnorK

variable {R}

/-- The degree-one class `{a}` of a unit `a : Rˣ` in `MilnorK R`. -/
def ofUnit (a : Rˣ) : MilnorK R :=
  RingQuot.mkRingHom (milnorRel R) (TensorAlgebra.ι ℤ (Additive.ofMul a))

/-- Unfolding lemma for `MilnorK.ofUnit`. -/
theorem ofUnit_def (a : Rˣ) :
    ofUnit a = RingQuot.mkRingHom (milnorRel R) (TensorAlgebra.ι ℤ (Additive.ofMul a)) := by
  rfl

/-- The degree-one unit map bundled as a `ℤ`-linear map `Additive Rˣ →ₗ[ℤ] MilnorK R`. -/
def ofUnitHom (R : Type u) [CommSemiring R] : Additive Rˣ →ₗ[ℤ] MilnorK R :=
  (RingQuot.mkRingHom (milnorRel R)).toIntAlgHom.toLinearMap.comp (TensorAlgebra.ι ℤ)

/-- Evaluating `ofUnitHom` on `Additive.ofMul a` gives `ofUnit a`. -/
@[simp]
theorem ofUnitHom_ofMul (a : Rˣ) : ofUnitHom R (Additive.ofMul a) = ofUnit a := by
  rfl

/-- The degree-one generator sends `1 : Rˣ` to `0`. -/
@[simp]
theorem ofUnit_one : ofUnit (1 : Rˣ) = 0 := by
  rw [← ofUnitHom_ofMul, ofMul_one, map_zero]

/-- The degree-one generator is additive in the multiplicative group of units. -/
theorem ofUnit_mul (a b : Rˣ) : ofUnit (a * b) = ofUnit a + ofUnit b := by
  rw [← ofUnitHom_ofMul, ofMul_mul, map_add, ofUnitHom_ofMul, ofUnitHom_ofMul]

/-- The degree-one generator sends inverses to negatives. -/
@[simp]
theorem ofUnit_inv (a : Rˣ) : ofUnit a⁻¹ = -ofUnit a := by
  rw [← ofUnitHom_ofMul, ofMul_inv, map_neg, ofUnitHom_ofMul]

/-- The degree-one generator sends natural powers to scalar multiples. -/
theorem ofUnit_pow (a : Rˣ) (n : ℕ) : ofUnit (a ^ n) = n • ofUnit a := by
  rw [← ofUnitHom_ofMul, ofMul_pow, map_nsmul, ofUnitHom_ofMul]

/-- The degree-one generator sends integer powers to integer scalar multiples. -/
theorem ofUnit_zpow (a : Rˣ) (n : ℤ) : ofUnit (a ^ n) = n • ofUnit a := by
  rw [← ofUnitHom_ofMul, ofMul_zpow, map_zsmul, ofUnitHom_ofMul]

/-- The Steinberg relation in `MilnorK R`: complementary units have zero product. -/
theorem ofUnit_mul_ofUnit_of_add_eq_one {a b : Rˣ} (h : (a : R) + b = 1) :
    ofUnit a * ofUnit b = 0 := by
  rw [ofUnit_def, ofUnit_def, ← map_mul]
  exact (RingQuot.mkRingHom_rel (r := milnorRel R) ⟨a, b, h, rfl, rfl⟩).trans (map_zero _)

/-- The degree-two product `(a, b) ↦ ofUnit a * ofUnit b` in `MilnorK R` is a Steinberg
pairing. -/
theorem isSteinbergPairing_mul_ofUnit :
    IsSteinbergPairing (fun a b : Rˣ ↦ ofUnit a * ofUnit b) where
  map_mul_left a₁ a₂ b := by rw [ofUnit_mul, add_mul]
  map_mul_right a b₁ b₂ := by rw [ofUnit_mul, mul_add]
  map_one_left b := by simp
  map_one_right a := by simp
  map_add_eq_one _ _ hab := ofUnit_mul_ofUnit_of_add_eq_one hab

/-- The Milnor symbol `{a₁, …, aₙ}`, defined as the ordered product of degree-one classes. -/
def symbol (l : List Rˣ) : MilnorK R :=
  (l.map ofUnit).prod

/-- The empty Milnor symbol is the multiplicative identity `1`. -/
@[simp]
theorem symbol_nil : symbol ([] : List Rˣ) = 1 := by
  simp [symbol]

/-- Adding a unit in front of a list left-multiplies the symbol by its degree-one class. -/
@[simp]
theorem symbol_cons (a : Rˣ) (l : List Rˣ) : symbol (a :: l) = ofUnit a * symbol l := by
  simp [symbol]

/-- A singleton Milnor symbol is the corresponding degree-one class. -/
theorem symbol_singleton (a : Rˣ) : symbol [a] = ofUnit a := by
  simp [symbol]

/-- Concatenating two lists multiplies their Milnor symbols in the same order. -/
theorem symbol_append (l₁ l₂ : List Rˣ) : symbol (l₁ ++ l₂) = symbol l₁ * symbol l₂ := by
  simp [symbol]

/-- **Multilinearity of Milnor symbols.** Multiplying an entry of a symbol splits it as a sum. -/
theorem symbol_mul_entry (l₁ l₂ : List Rˣ) (a b : Rˣ) :
    symbol (l₁ ++ (a * b) :: l₂) = symbol (l₁ ++ a :: l₂) + symbol (l₁ ++ b :: l₂) := by
  simp only [symbol_append, symbol_cons, ofUnit_mul, add_mul, mul_add]

/-- A Milnor symbol containing `1` vanishes. -/
theorem symbol_eq_zero_of_one_mem {l : List Rˣ} (h : (1 : Rˣ) ∈ l) : symbol l = 0 := by
  obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem h
  simp [symbol_append]

/-- A Milnor symbol containing consecutive complementary units `(a, b)` with `a + b = 1`
vanishes. -/
theorem symbol_eq_zero_of_add_eq_one (l₁ l₂ : List Rˣ) {a b : Rˣ} (h : (a : R) + b = 1) :
    symbol (l₁ ++ a :: b :: l₂) = 0 := by
  simp only [symbol_append, symbol_cons, ← mul_assoc, ofUnit_mul_ofUnit_of_add_eq_one h, zero_mul,
    mul_zero]

/-- Evaluating the quotient map on a pure tensor in `TensorAlgebra ℤ (Additive Rˣ)` yields the
corresponding Milnor symbol. -/
theorem mkRingHom_tprod {n : ℕ} (a : Fin n → Rˣ) :
    RingQuot.mkRingHom (milnorRel R) (TensorAlgebra.tprod ℤ (Additive Rˣ) n (Additive.ofMul ∘ a)) =
      symbol (List.ofFn a) := by
  rw [TensorAlgebra.tprod_apply, map_list_prod, symbol, List.map_ofFn, List.map_ofFn]
  rfl

variable (R)

/-- The degree-`n` submodule `Kₙᴹ(R)` of `MilnorK R`, defined as the image of the `n`-th graded
piece `(LinearMap.range (TensorAlgebra.ι ℤ)) ^ n` of the tensor algebra. -/
def degree (n : ℕ) : Submodule ℤ (MilnorK R) :=
  Submodule.map (RingQuot.mkRingHom (milnorRel R)).toIntAlgHom.toLinearMap
    ((TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)).range ^ n)

variable {R}

/-- Membership in `MilnorK.degree R n` means being the image of a degree-`n` tensor-algebra
element. -/
theorem mem_degree_iff {n : ℕ} {x : MilnorK R} :
    x ∈ degree R n ↔ ∃ t ∈ (TensorAlgebra.ι ℤ :
      Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)).range ^ n,
      RingQuot.mkRingHom (milnorRel R) t = x := by
  rfl

/-- The multiplicative identity `1` lies in degree `0`. -/
theorem one_mem_degree_zero : (1 : MilnorK R) ∈ degree R 0 := by
  rw [mem_degree_iff]
  refine ⟨1, ?_, map_one _⟩
  rw [pow_zero]
  exact Submodule.one_le.mp le_rfl

/-- Every degree-one unit class `ofUnit a` lies in `MilnorK.degree R 1`. -/
theorem ofUnit_mem_degree_one (a : Rˣ) : ofUnit a ∈ degree R 1 := by
  rw [mem_degree_iff]
  refine ⟨TensorAlgebra.ι ℤ (Additive.ofMul a), ?_, rfl⟩
  rw [pow_one]
  exact LinearMap.mem_range_self _ _

/-- Multiplying an element of degree `i` and an element of degree `j` lands in degree `i + j`. -/
theorem mul_mem_degree {i j : ℕ} {x y : MilnorK R} (hx : x ∈ degree R i) (hy : y ∈ degree R j) :
    x * y ∈ degree R (i + j) := by
  rw [mem_degree_iff] at hx hy ⊢
  rcases hx with ⟨tx, htx, rfl⟩
  rcases hy with ⟨ty, hty, rfl⟩
  refine ⟨tx * ty, ?_, map_mul _ _ _⟩
  rw [pow_add]
  exact Submodule.mul_mem_mul htx hty

/-- A Milnor symbol of a list `l` lies in degree `l.length`. -/
theorem symbol_mem_degree (l : List Rˣ) : symbol l ∈ degree R l.length := by
  induction l with
  | nil => simpa using one_mem_degree_zero
  | cons a l ih =>
    rw [symbol_cons, List.length_cons, add_comm]
    exact mul_mem_degree (ofUnit_mem_degree_one a) ih

/-- `MilnorK.degree R n` is spanned over `ℤ` by the Milnor symbols of length `n`. -/
theorem degree_eq_span_symbol (n : ℕ) :
    degree R n = Submodule.span ℤ {x | ∃ l : List Rˣ, l.length = n ∧ x = symbol l} := by
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · intro x hx
    rw [mem_degree_iff] at hx
    rcases hx with ⟨t, ht, rfl⟩
    rw [← TensorPower.range_toTensorAlgebra] at ht
    rcases ht with ⟨w, rfl⟩
    induction w using PiTensorProduct.induction_on with
    | smul_tprod r m =>
      rw [map_smul, TensorPower.toTensorAlgebra_tprod, map_zsmul]
      refine Submodule.smul_mem _ r (Submodule.subset_span ?_)
      refine ⟨List.ofFn (Additive.toMul ∘ m), List.length_ofFn, ?_⟩
      have hm : m = Additive.ofMul ∘ (Additive.toMul ∘ m) := funext fun _ ↦ (ofMul_toMul _).symm
      rw [← mkRingHom_tprod, ← hm]
    | add x y hx hy =>
      rw [map_add, map_add]
      exact add_mem hx hy
  · rintro _ ⟨l, rfl, rfl⟩
    exact symbol_mem_degree l

/-- Two ring homomorphisms out of `MilnorK R` agree if they agree on every `ofUnit a`. -/
theorem ringHom_ext {A : Type v} [Semiring A] {f g : MilnorK R →+* A}
    (h : ∀ a : Rˣ, f (ofUnit a) = g (ofUnit a)) : f = g := by
  refine RingQuot.ringQuot_ext f g (RingHom.ext fun x ↦ ?_)
  induction x using TensorAlgebra.induction with
  | algebraMap r =>
    exact RingHom.congr_fun
      (RingHom.ext_int
        ((f.comp (RingQuot.mkRingHom (milnorRel R))).comp (algebraMap ℤ _))
        ((g.comp (RingQuot.mkRingHom (milnorRel R))).comp (algebraMap ℤ _))) r
  | ι x => exact h (Additive.toMul x)
  | mul x y hx hy => simp only [RingHom.comp_apply, map_mul] at hx hy ⊢; rw [hx, hy]
  | add x y hx hy => simp only [RingHom.comp_apply, map_add] at hx hy ⊢; rw [hx, hy]

/-- Two `ℤ`-algebra homomorphisms out of `MilnorK R` agree if they agree on every `ofUnit a`. -/
theorem algHom_ext {A : Type v} [Semiring A] [Algebra ℤ A] {f g : MilnorK R →ₐ[ℤ] A}
    (h : ∀ a : Rˣ, f (ofUnit a) = g (ofUnit a)) : f = g :=
  AlgHom.toRingHom_injective (ringHom_ext h)

/-- **Universal property of `MilnorK R`.** An additive homomorphism `f : Additive Rˣ →+ A` into a
ring `A` whose values on complementary units multiply to zero extends uniquely to a `ℤ`-algebra
homomorphism `MilnorK R →ₐ[ℤ] A`. -/
def lift {A : Type v} [Ring A] (f : Additive Rˣ →+ A)
    (hf : ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0) :
    MilnorK R →ₐ[ℤ] A :=
  RingQuot.liftAlgHom ℤ
    ⟨TensorAlgebra.lift ℤ f.toIntLinearMap, fun _ _ hrel ↦ by
      rcases hrel with ⟨a, b, hab, rfl, rfl⟩
      simp only [map_mul, TensorAlgebra.lift_ι_apply, AddMonoidHom.coe_toIntLinearMap, map_zero]
      exact hf a b hab⟩

/-- Evaluating `MilnorK.lift f hf` on `ofUnit a` recovers `f (Additive.ofMul a)`. -/
@[simp]
theorem lift_ofUnit {A : Type v} [Ring A] (f : Additive Rˣ →+ A)
    (hf : ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0)
    (a : Rˣ) :
    lift f hf (ofUnit a) = f (Additive.ofMul a) := by
  rw [lift, ofUnit_def, ← RingQuot.mkAlgHom_coe ℤ (milnorRel R)]
  exact (RingQuot.liftAlgHom_mkAlgHom_apply ℤ _ _ _).trans (by simp)

/-- Evaluating `MilnorK.lift f hf` on a symbol multiplies the images of its entries. -/
@[simp]
theorem lift_symbol {A : Type v} [Ring A] (f : Additive Rˣ →+ A)
    (hf : ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0)
    (l : List Rˣ) :
    lift f hf (symbol l) = (l.map fun a ↦ f (Additive.ofMul a)).prod := by
  simp [symbol, map_list_prod, List.map_map, Function.comp_def]

/-- Functoriality of `MilnorK`: a ring homomorphism `f : R →+* S` induces a `ℤ`-algebra
homomorphism `MilnorK R →ₐ[ℤ] MilnorK S` sending `ofUnit a` to `ofUnit (Units.map f a)`. -/
def map {S : Type w} [CommSemiring S] (f : R →+* S) : MilnorK R →ₐ[ℤ] MilnorK S :=
  lift
    { toFun := fun a ↦ ofUnit (Units.map f.toMonoidHom (Additive.toMul a))
      map_zero' := by simp
      map_add' := fun a b ↦ by rw [toMul_add, map_mul, ofUnit_mul] }
    (fun a b hab ↦ ofUnit_mul_ofUnit_of_add_eq_one (by simp [← map_add, hab]))

/-- `MilnorK.map f` sends `ofUnit a` to `ofUnit (Units.map f a)`. -/
@[simp]
theorem map_ofUnit {S : Type w} [CommSemiring S] (f : R →+* S) (a : Rˣ) :
    map f (ofUnit a) = ofUnit (Units.map f.toMonoidHom a) :=
  lift_ofUnit _ _ a

/-- `MilnorK.map f` sends a symbol to the symbol of mapped units in unchanged order. -/
@[simp]
theorem map_symbol {S : Type w} [CommSemiring S] (f : R →+* S) (l : List Rˣ) :
    map f (symbol l) = symbol (l.map (Units.map f.toMonoidHom)) := by
  simp [symbol, map_list_prod, List.map_map, Function.comp_def]

/-- If an additive homomorphism out of `MilnorK R` sends every length-`n` symbol into an additive
subgroup `S`, then it maps all of `MilnorK.degree R n` into `S`. -/
theorem map_mem_of_symbol_mem {A F : Type*} {σ : Type*} [AddGroup A] [SetLike σ A]
    [AddSubgroupClass σ A] [FunLike F (MilnorK R) A] [AddMonoidHomClass F (MilnorK R) A]
    (g : F) {S : σ} {n : ℕ}
    (hg : ∀ l : List Rˣ, l.length = n → g (symbol l) ∈ S) {x : MilnorK R}
    (hx : x ∈ degree R n) : g x ∈ S := by
  rw [degree_eq_span_symbol] at hx
  refine Submodule.span_induction (p := fun y _ ↦ g y ∈ S) ?_ (by simp)
    (fun _ _ _ _ hx hy ↦ by rw [map_add]; exact add_mem hx hy)
    (fun r _ _ hx ↦ by rw [map_zsmul]; exact zsmul_mem hx r) hx
  rintro _ ⟨l, hl, rfl⟩
  exact hg l hl

/-- `MilnorK.map f` preserves every homogeneous degree piece. -/
theorem map_mem_degree {S : Type w} [CommSemiring S] (f : R →+* S) {n : ℕ} {x : MilnorK R}
    (hx : x ∈ degree R n) : map f x ∈ degree S n :=
  map_mem_of_symbol_mem (map f) (fun l hl ↦ by
    rw [map_symbol]
    simpa only [hl, List.length_map] using symbol_mem_degree (l.map (Units.map f.toMonoidHom)))
    hx

/-- The identity ring homomorphism induces the identity on `MilnorK`. -/
@[simp]
theorem map_id (R : Type u) [CommSemiring R] :
    map (RingHom.id R) = AlgHom.id ℤ (MilnorK R) :=
  algHom_ext fun a ↦ by simp

/-- `MilnorK.map` respects composition of ring homomorphisms. -/
theorem map_comp {S : Type v} {T : Type w} [CommSemiring S] [CommSemiring T]
    (g : S →+* T) (f : R →+* S) :
    map (g.comp f) = (map g).comp (map f) :=
  algHom_ext fun a ↦ by
    simp only [map_ofUnit, AlgHom.comp_apply, RingHom.toMonoidHom_comp, Units.map_comp,
      MonoidHom.comp_apply]

end MilnorK

end TauCeti
