/-!
# Steinberg pairings on fields

This file develops field-specific identities for `TauCeti.IsSteinbergPairing` (skew-symmetry,
`c a (-a) = 0`, `c a a = c a (-1)`, and `2 • c a a = 0`), establishes the odd-complementary
generator criterion, and deduces that every Steinberg pairing on a finite field vanishes
identically. The definition and general commutative-semiring/ring lemmas are in
`TauCeti.RingTheory.MilnorK.SteinbergPairing`.

## Main results

* `TauCeti.IsSteinbergPairing.map_neg_self`: `c a (-a) = 0` over a field.
* `TauCeti.IsSteinbergPairing.map_anticomm`: `c a b = -c b a` over a field.
* `TauCeti.IsSteinbergPairing.map_self`: `c a a = c a (-1)` over a field.
* `TauCeti.IsSteinbergPairing.two_nsmul_map_self`: `2 • c a a = 0` over a field.
* `TauCeti.IsSteinbergPairing.eq_zero_of_odd_complementary`: vanishing when `Fˣ` is generated by
  `g` and `g ^ (2 * k + 1)` and `g ^ (2 * l + 1)` are complementary units.
* `TauCeti.IsSteinbergPairing.eq_zero_of_finite`: every Steinberg pairing on a finite field is
  identically zero.

## References

* C. A. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, §III.6.1, Lemma III.6.1,
  Corollary III.6.1.1, and Lemma III.6.3.
-/

public section

namespace TauCeti

namespace IsSteinbergPairing

section Field

variable {F : Type*} [Field F] {A : Type*} [AddCommGroup A] {c : Fˣ → Fˣ → A}

/-- Over a field, every Steinberg pairing satisfies `c a (-a) = 0`. -/
theorem map_neg_self (hc : IsSteinbergPairing c) (a : Fˣ) : c a (-a) = 0 := by
  -- For `a ≠ 1`, `-a = (1 - a) / (1 - a⁻¹)`, and both `c a (1 - a)` and
  -- `c a (1 - a⁻¹) = -c a⁻¹ (1 - a⁻¹)` vanish by the Steinberg relation.
  rcases eq_or_ne a 1 with rfl | ha
  · exact hc.map_one_left _
  have h₁ : (1 : F) - a ≠ 0 := sub_ne_zero.2 (Ne.symm (Units.val_eq_one.not.2 ha))
  have h₂ : (1 : F) - ((a⁻¹ : Fˣ) : F) ≠ 0 :=
    sub_ne_zero.2 (Ne.symm (Units.val_eq_one.not.2 (inv_ne_one.2 ha)))
  have hneg : -a = Units.mk0 (1 - (a : F)) h₁ * (Units.mk0 (1 - ((a⁻¹ : Fˣ) : F)) h₂)⁻¹ := by
    ext
    have ha0 : (a : F) ≠ 0 := a.ne_zero
    have h₂' : (a : F) - 1 ≠ 0 := sub_ne_zero.2 (Units.val_eq_one.not.2 ha)
    simp only [Units.val_neg, Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0]
    field_simp
    ring
  have h₁' := hc.steinberg (a := a) (b := Units.mk0 (1 - (a : F)) h₁) (by simp)
  have h₂' := hc.steinberg (a := a⁻¹) (b := Units.mk0 (1 - ((a⁻¹ : Fˣ) : F)) h₂) (by simp)
  rw [hc.map_inv_left, neg_eq_zero] at h₂'
  simp only [hneg, hc.map_mul_right, hc.map_inv_right, h₁', h₂', neg_zero, add_zero]

/-- Over a field, every Steinberg pairing satisfies `c a a = c a (-1)`. -/
theorem map_self (hc : IsSteinbergPairing c) (a : Fˣ) : c a a = c a (-1 : Fˣ) := by
  have h0 : c a (-1 : Fˣ) + c a a = 0 := by
    rw [← hc.map_mul_right, show (-1 : Fˣ) * a = -a by ext; simp, hc.map_neg_self]
  exact add_left_cancel (h0.trans (hc.map_neg_one_right_add_self_eq_zero a).symm)

/-- Over a field, every Steinberg pairing is skew-symmetric: `c a b = -c b a`. -/
theorem map_anticomm (hc : IsSteinbergPairing c) (a b : Fˣ) : c a b = -c b a := by
  have ha : c a (-(a * b)) = c a b := by
    rw [show -(a * b) = (-a) * b by ext; simp, hc.map_mul_right, hc.map_neg_self, zero_add]
  have hb : c b (-(a * b)) = c b a := by
    rw [show -(a * b) = a * (-b) by ext; simp, hc.map_mul_right, hc.map_neg_self, add_zero]
  have hab : c a b + c b a = 0 := by
    rw [← ha, ← hb, ← hc.map_mul_left, hc.map_neg_self]
  exact eq_neg_of_add_eq_zero_left hab

/-- Over a field, diagonal values `c a a` are 2-torsion. -/
theorem two_nsmul_map_self (hc : IsSteinbergPairing c) (a : Fˣ) : 2 • c a a = 0 := by
  rw [two_nsmul, hc.map_self, hc.map_neg_one_right_add_self_eq_zero a]

/-- Over a field, diagonal values satisfy `(2 : ℤ) • c a a = 0`. -/
theorem two_zsmul_map_self (hc : IsSteinbergPairing c) (a : Fˣ) : (2 : ℤ) • c a a = 0 := by
  simpa only [Nat.cast_ofNat] using (natCast_zsmul (c a a) 2).trans (hc.two_nsmul_map_self a)

/-- In characteristic `2`, diagonal values of a Steinberg pairing vanish. -/
theorem map_self_eq_zero_of_charTwo [CharP F 2] (hc : IsSteinbergPairing c) (a : Fˣ) :
    c a a = 0 := by
  rw [hc.map_self, show (-1 : Fˣ) = 1 by ext; exact CharTwo.neg_eq 1, hc.map_one_right]

/-! ### Finite-field vanishing -/

/-- If `Fˣ` is generated by `g` and `c g g = 0`, then `c` is identically zero. -/
theorem eq_zero_of_generator_map_self_eq_zero (hc : IsSteinbergPairing c) {g : Fˣ}
    (hg : ∀ x : Fˣ, x ∈ Subgroup.zpowers g) (hgg : c g g = 0) (a b : Fˣ) :
    c a b = 0 := by
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
  rw [hc.map_zpow_left, hc.map_zpow_right, hgg, smul_zero, smul_zero]

/-- Cyclic-unit annihilator criterion: if `g` generates `Fˣ` and `g ^ (2 * k + 1)` and
`g ^ (2 * l + 1)` are complementary units (`(g ^ (2 * k + 1) : F) + (g ^ (2 * l + 1) : F) = 1`),
then `c a b = 0` for all `a b : Fˣ`. -/
theorem eq_zero_of_odd_complementary (hc : IsSteinbergPairing c) {g : Fˣ}
    (hg : ∀ x : Fˣ, x ∈ Subgroup.zpowers g) {k l : ℤ}
    (hab : ((g ^ (2 * k + 1) : Fˣ) : F) + ((g ^ (2 * l + 1) : Fˣ) : F) = 1) (a b : Fˣ) :
    c a b = 0 := by
  have h0 : ((2 * k + 1) * (2 * l + 1)) • c g g = 0 := by
    rw [mul_zsmul, ← hc.map_zpow_right, ← hc.map_zpow_left]
    exact hc.steinberg hab
  obtain ⟨m, hm⟩ : Odd ((2 * k + 1) * (2 * l + 1)) :=
    (odd_two_mul_add_one k).mul (odd_two_mul_add_one l)
  have hgg : c g g = 0 := by
    simpa [hm, add_zsmul, mul_comm (2 : ℤ) m, mul_zsmul, hc.two_zsmul_map_self] using h0
  exact hc.eq_zero_of_generator_map_self_eq_zero hg hgg a b

/-- Every Steinberg pairing on a finite field is identically zero. -/
theorem eq_zero_of_finite [Finite F] (hc : IsSteinbergPairing c) (a b : Fˣ) : c a b = 0 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Fˣ)
  by_cases hF : ringChar F = 2
  · have : CharP F 2 := hF ▸ ringChar.charP F
    exact hc.eq_zero_of_generator_map_self_eq_zero hg (hc.map_self_eq_zero_of_charTwo g) a b
  · obtain ⟨x, hx, hx'⟩ := FiniteField.exists_not_isSquare_and_not_isSquare_one_sub hF
    have hx0 : x ≠ 0 := by rintro rfl; exact hx IsSquare.zero
    have hx1 : 1 - x ≠ 0 := by intro h; rw [h] at hx'; exact hx' IsSquare.zero
    have hodd : ∀ u : Fˣ, ¬IsSquare (u : F) → ∃ k : ℤ, g ^ (2 * k + 1) = u := by
      intro u hu
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg u)
      rcases Int.even_or_odd m with ⟨k, rfl⟩ | ⟨k, rfl⟩
      · exact absurd ⟨((g ^ k : Fˣ) : F), by rw [zpow_add, Units.val_mul]⟩ hu
      · exact ⟨k, rfl⟩
    obtain ⟨k, hk⟩ := hodd (Units.mk0 x hx0) hx
    obtain ⟨l, hl⟩ := hodd (Units.mk0 (1 - x) hx1) hx'
    refine hc.eq_zero_of_odd_complementary hg (k := k) (l := l) ?_ a b
    rw [hk, hl]
    simp

end Field

end IsSteinbergPairing

end TauCeti
