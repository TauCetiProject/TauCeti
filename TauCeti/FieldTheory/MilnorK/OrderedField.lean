public import TauCeti.RingTheory.MilnorK.SteinbergPairing

/-!
# The sign symbol on the degree-two symbol group of an ordered field

Let `R` be a linearly ordered commutative ring (or field `F`, such as `ℝ`). Write
`ε a ∈ ZMod 2` (`Units.signAddHom`) for `1` if the unit `a` is negative and `0` if it is positive.
The pairing `(a, b) ↦ ε a * ε b` is biadditive, and it satisfies the Steinberg relation, since two
units adding up to one cannot both be negative. So it descends to a `ℤ`-linear map `sign` from
the degree-two symbol group `SymbolGroup R = (Additive Rˣ ⊗[ℤ] Additive Rˣ) ⧸ steinbergRelations R`
to `ZMod 2`. It sends `{x, y}` to `1` exactly when both entries are negative.

The sign map detects the symbol `{-1, -1}`: this symbol has order exactly two. In particular,
`SymbolGroup R` is not the exterior square of `Rˣ`. Let `D` be the subgroup spanned by the
symbols with at least one positive entry. Then:

* `D` is exactly the kernel of `sign`;
* every class is uniquely `ε • {-1, -1} + d` with `ε ∈ ZMod 2` and `d ∈ D`, which gives a
  splitting `SymbolGroup R ≃ₗ[ℤ] ZMod 2 × D`;
* if `F` is a real closed field, for instance `F = ℝ`, then `D` is divisible: a positive entry is
  an `m`-th power of a positive element for every `m ≠ 0`.

Through Matsumoto's theorem, this is the degree-two case of Milnor's computation of the Milnor
K-groups of `ℝ`: they are `ℤ/2`, generated by `{-1, …, -1}`, plus a divisible group.

## Main definitions

* `TauCeti.SymbolGroup.signPairing`: the Steinberg pairing `(a, b) ↦ ε a * ε b`.
* `TauCeti.SymbolGroup.sign`: the induced `ℤ`-linear map `SymbolGroup R →ₗ[ℤ] ZMod 2`.
* `TauCeti.SymbolGroup.positiveEntrySpan`: the span `D` of the symbols with a positive entry.
* `TauCeti.SymbolGroup.positiveEntryEquiv`: the splitting
  `SymbolGroup R ≃ₗ[ℤ] ZMod 2 × positiveEntrySpan R`.

## Main results

* `TauCeti.SymbolGroup.isSteinbergPairing_signPairing`: `signPairing` satisfies
  `IsSteinbergPairing`.
* `TauCeti.SymbolGroup.sign_symbol`: `sign {x, y} = 1` exactly when `x < 0` and `y < 0`.
* `TauCeti.SymbolGroup.symbol_neg_one_neg_one_ne_zero`: `{-1, -1} ≠ 0`.
* `TauCeti.SymbolGroup.addOrderOf_symbol_neg_one_neg_one`: `{-1, -1}` has order two.
* `TauCeti.SymbolGroup.sign_eq_zero_iff`: the kernel of `sign` is `positiveEntrySpan R`.
* `TauCeti.SymbolGroup.positiveEntrySpan_nsmul_right_surjective`: over a real closed field,
  multiplication by every `m ≠ 0` is surjective on `positiveEntrySpan F`.

## References

* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. 9 (1970), §1.
* C. Weibel, *The K-book*, Example III.6.2.1 and Example III.7.2(c).
-/

public section

namespace TauCeti.SymbolGroup

section PositiveEntrySpan

variable {R : Type*} [CommSemiring R] [Preorder R]

variable (R) in
/-- The subgroup of the symbol group of an ordered semiring spanned by the symbols `{x, y}` with
at least one positive entry. Over a linearly ordered commutative ring it is the kernel of the sign
map (`sign_eq_zero_iff`), and over a real closed field it is divisible
(`positiveEntrySpan_nsmul_right_surjective`). -/
def positiveEntrySpan : Submodule ℤ (SymbolGroup R) :=
  Submodule.span ℤ {q | ∃ x y : Rˣ, (0 < (x : R) ∨ 0 < (y : R)) ∧ q = symbol x y}

variable (R) in
/-- Unfolding lemma for `TauCeti.SymbolGroup.positiveEntrySpan`. -/
theorem positiveEntrySpan_def :
    positiveEntrySpan R =
      Submodule.span ℤ {q | ∃ x y : Rˣ, (0 < (x : R) ∨ 0 < (y : R)) ∧ q = symbol x y} :=
  (rfl)

/-- The universal property of the positive-entry span: it lies in a subgroup exactly when every
symbol with a positive entry does. -/
theorem positiveEntrySpan_le_iff {p : Submodule ℤ (SymbolGroup R)} :
    positiveEntrySpan R ≤ p ↔ ∀ x y : Rˣ, (0 < (x : R) ∨ 0 < (y : R)) → symbol x y ∈ p := by
  rw [positiveEntrySpan_def, Submodule.span_le]
  refine ⟨fun h x y hxy ↦ h ⟨x, y, hxy, rfl⟩, ?_⟩
  rintro h _ ⟨x, y, hxy, rfl⟩
  exact h x y hxy

/-- A symbol with at least one positive entry belongs to `positiveEntrySpan`. -/
theorem symbol_mem_positiveEntrySpan {x y : Rˣ} (h : 0 < (x : R) ∨ 0 < (y : R)) :
    symbol x y ∈ positiveEntrySpan R :=
  Submodule.subset_span ⟨x, y, h, rfl⟩

/-- A symbol whose first entry is positive belongs to `positiveEntrySpan`. -/
theorem symbol_mem_positiveEntrySpan_of_pos_left {x : Rˣ} (hx : 0 < (x : R)) (y : Rˣ) :
    symbol x y ∈ positiveEntrySpan R :=
  symbol_mem_positiveEntrySpan (.inl hx)

/-- A symbol whose second entry is positive belongs to `positiveEntrySpan`. -/
theorem symbol_mem_positiveEntrySpan_of_pos_right (x : Rˣ) {y : Rˣ} (hy : 0 < (y : R)) :
    symbol x y ∈ positiveEntrySpan R :=
  symbol_mem_positiveEntrySpan (.inr hy)

end PositiveEntrySpan

section SignPairing

variable {R : Type*} [Ring R] [LinearOrder R] [IsStrictOrderedRing R]

variable (R) in
/-- The **sign pairing** `(a, b) ↦ ε a * ε b` on the units of an ordered ring, with values in
`ZMod 2`, where `ε` is the additive sign `Units.signAddHom R`. It is `1` exactly when both units
are negative. -/
noncomputable def signPairing : Additive Rˣ →+ Additive Rˣ →+ ZMod 2 :=
  (AddMonoidHom.mul.comp (Units.signAddHom R)).compl₂ (Units.signAddHom R)

/-- Unfolding lemma for `TauCeti.SymbolGroup.signPairing`. -/
theorem signPairing_apply (a b : Additive Rˣ) :
    signPairing R a b = Units.signAddHom R a * Units.signAddHom R b :=
  (rfl)

/-- Evaluating `signPairing` on units gives `1` if both are negative and `0` otherwise. -/
@[simp]
theorem signPairing_ofMul (x y : Rˣ) :
    signPairing R (Additive.ofMul x) (Additive.ofMul y) =
      if (x : R) < 0 ∧ (y : R) < 0 then 1 else 0 := by
  rw [signPairing_apply, Units.signAddHom_ofMul, Units.signAddHom_ofMul]
  split_ifs <;> simp_all

/-- **The sign pairing satisfies the Steinberg relation**: two units adding up to one are not
both negative. -/
theorem signPairing_of_add_eq_one {x y : Rˣ} (h : (x : R) + y = 1) :
    signPairing R (Additive.ofMul x) (Additive.ofMul y) = 0 := by
  rw [signPairing_ofMul, ite_eq_right_iff]
  rintro ⟨hx, hy⟩
  exact ((add_neg hx hy).not_gt (h ▸ zero_lt_one)).elim

/-- The sign pairing on `Rˣ` is a Steinberg pairing. -/
theorem isSteinbergPairing_signPairing :
    IsSteinbergPairing (fun x y : Rˣ ↦ signPairing R (Additive.ofMul x) (Additive.ofMul y)) where
  map_mul_left a₁ a₂ b := by simp [ofMul_mul]
  map_mul_right a b₁ b₂ := by simp [ofMul_mul]
  map_one_left b := by simp
  map_one_right a := by simp
  map_add_eq_one _ _ h := signPairing_of_add_eq_one h

end SignPairing

section OrderedCommRing

variable {R : Type*} [CommRing R] [LinearOrder R] [IsStrictOrderedRing R]

variable (R) in
/-- The **sign map** of the symbol group of an ordered commutative ring, induced by the sign
pairing: it sends `{x, y}` to `1` if `x` and `y` are both negative, and to `0` otherwise. -/
noncomputable def sign : SymbolGroup R →ₗ[ℤ] ZMod 2 :=
  lift (fun x y : Rˣ ↦ signPairing R (Additive.ofMul x) (Additive.ofMul y))
    isSteinbergPairing_signPairing

/-- The value of the sign map on a symbol is the sign pairing. -/
theorem sign_symbol_eq_signPairing (x y : Rˣ) :
    sign R (symbol x y) = signPairing R (Additive.ofMul x) (Additive.ofMul y) :=
  lift_symbol _ _ x y

/-- The sign map sends `{x, y}` to `1` if both `x` and `y` are negative, and to `0` otherwise. -/
@[simp]
theorem sign_symbol (x y : Rˣ) :
    sign R (symbol x y) = if (x : R) < 0 ∧ (y : R) < 0 then 1 else 0 := by
  rw [sign_symbol_eq_signPairing, signPairing_ofMul]

/-- The sign map vanishes on symbols with a positive left entry. -/
theorem sign_symbol_of_pos_left {x : Rˣ} (hx : 0 < (x : R)) (y : Rˣ) :
    sign R (symbol x y) = 0 := by
  simp [hx.not_gt]

/-- The sign map vanishes on symbols with a positive right entry. -/
theorem sign_symbol_of_pos_right (x : Rˣ) {y : Rˣ} (hy : 0 < (y : R)) :
    sign R (symbol x y) = 0 := by
  simp [hy.not_gt]

/-- The sign map takes value `1` on symbols with two negative entries. -/
theorem sign_symbol_of_neg_of_neg {x y : Rˣ} (hx : (x : R) < 0) (hy : (y : R) < 0) :
    sign R (symbol x y) = 1 := by
  simp [hx, hy]

/-- The sign map sends `{-1, -1}` to `1`. -/
theorem sign_symbol_neg_one_neg_one : sign R (symbol (-1 : Rˣ) (-1)) = 1 :=
  sign_symbol_of_neg_of_neg (by simp) (by simp)

/-- **The symbol `{-1, -1}` is nonzero** in the symbol group of an ordered commutative ring: the
sign map sends it to `1`. -/
theorem symbol_neg_one_neg_one_ne_zero : symbol (-1 : Rˣ) (-1) ≠ 0 := fun h ↦ by
  simpa [h] using sign_symbol_neg_one_neg_one (R := R)

/-- **The symbol `{-1, -1}` has order exactly two** in the symbol group of an ordered commutative
ring. -/
theorem addOrderOf_symbol_neg_one_neg_one : addOrderOf (symbol (-1 : Rˣ) (-1)) = 2 := by
  have := Fact.mk Nat.prime_two
  exact addOrderOf_eq_prime (two_nsmul_symbol_neg_one _) symbol_neg_one_neg_one_ne_zero

/-- The sign map vanishes on the positive-entry span. -/
theorem sign_eq_zero_of_mem_positiveEntrySpan {q : SymbolGroup R}
    (hq : q ∈ positiveEntrySpan R) : sign R q = 0 := by
  induction hq using Submodule.span_induction with
  | mem q hq =>
    obtain ⟨x, y, h, rfl⟩ := hq
    rcases h with h | h
    · exact sign_symbol_of_pos_left h y
    · exact sign_symbol_of_pos_right x h
  | zero => exact map_zero _
  | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
  | smul n a _ ha => rw [map_zsmul, ha, smul_zero]

/-- The symbol `{-1, -1}` does not lie in the positive-entry span. -/
theorem symbol_neg_one_neg_one_notMem_positiveEntrySpan :
    symbol (-1 : Rˣ) (-1) ∉ positiveEntrySpan R := fun h ↦ by
  simpa using sign_eq_zero_of_mem_positiveEntrySpan h

/-- Every symbol is congruent modulo the positive-entry span to the multiple of `{-1, -1}` given
by its sign. -/
theorem symbol_sub_sign_smul_mem_positiveEntrySpan (x y : Rˣ) :
    symbol x y - (sign R (symbol x y)).val • symbol (-1 : Rˣ) (-1) ∈ positiveEntrySpan R := by
  rcases x.ne_zero.lt_or_gt with hx | hx
  · rcases y.ne_zero.lt_or_gt with hy | hy
    · -- Write `x = (-1) * (-x)` and `y = (-1) * (-y)`. Expanding `{x, y}` leaves `{-1, -1}`
      -- together with three symbols having the positive entry `-x` or `-y`.
      have hx' : 0 < ((-x : Rˣ) : R) := by simpa using hx
      have hy' : 0 < ((-y : Rˣ) : R) := by simpa using hy
      have hsym : symbol x y - symbol (-1) (-1) =
          symbol (-1) (-y) + (symbol (-x) (-1) + symbol (-x) (-y)) := by
        conv_lhs => rw [← neg_neg x, ← neg_neg y, neg_eq_neg_one_mul (-x),
          neg_eq_neg_one_mul (-y)]
        simp only [symbol_mul_left, symbol_mul_right]
        abel
      simpa [sign_symbol_of_neg_of_neg hx hy, ZMod.val_one'' (n := 2) (by decide), hsym] using
        add_mem (symbol_mem_positiveEntrySpan_of_pos_right (-1) hy')
          (add_mem (symbol_mem_positiveEntrySpan_of_pos_left hx' (-1))
            (symbol_mem_positiveEntrySpan_of_pos_left hx' (-y)))
    · simpa [sign_symbol_of_pos_right x hy] using symbol_mem_positiveEntrySpan_of_pos_right x hy
  · simpa [sign_symbol_of_pos_left hx y] using symbol_mem_positiveEntrySpan_of_pos_left hx y

/-- The homomorphism `ZMod 2 →+ SymbolGroup R` sending `1` to `{-1, -1}`, well defined since
`{-1, -1}` has order dividing two. -/
private def signSection : ZMod 2 →+ SymbolGroup R :=
  ZMod.lift 2 ⟨zmultiplesHom _ (symbol (-1 : Rˣ) (-1)), by
    simpa [two_zsmul, ← two_nsmul] using two_nsmul_symbol_neg_one (-1 : Rˣ)⟩

omit [LinearOrder R] [IsStrictOrderedRing R] in
private theorem signSection_apply (ε : ZMod 2) :
    signSection (R := R) ε = ε.val • symbol (-1 : Rˣ) (-1) := by
  conv_lhs => rw [← ZMod.natCast_zmod_val ε, ← Int.cast_natCast]
  rw [signSection, ZMod.lift_coe, zmultiplesHom_apply, natCast_zsmul]

private theorem sign_signSection (ε : ZMod 2) : sign R (signSection ε) = ε := by
  simp [signSection_apply]

/-- **The kernel of the sign map is the positive-entry span.** -/
theorem sign_eq_zero_iff {q : SymbolGroup R} : sign R q = 0 ↔ q ∈ positiveEntrySpan R := by
  refine ⟨fun hq ↦ ?_, sign_eq_zero_of_mem_positiveEntrySpan⟩
  -- Modulo the span, `q` is congruent to `signSection (sign q)`, which is zero here.
  suffices h : ∀ q : SymbolGroup R, q - signSection (sign R q) ∈ positiveEntrySpan R by
    simpa [hq] using h q
  intro q
  induction q using induction_on with
  | symbol x y => simpa [signSection_apply] using symbol_sub_sign_smul_mem_positiveEntrySpan x y
  | add a b ha hb =>
    convert add_mem ha hb using 1
    rw [map_add, map_add]
    abel

/-- The kernel of `sign R` as a `ℤ`-submodule is `positiveEntrySpan R`. -/
theorem ker_sign : LinearMap.ker (sign R) = positiveEntrySpan R := by
  ext q
  exact sign_eq_zero_iff

variable (R) in
/-- **The splitting of the symbol group of an ordered commutative ring**: every class is uniquely
`ε • {-1, -1} + d` with `ε ∈ ZMod 2` and `d` in the positive-entry span. The first component is
the sign map. -/
noncomputable def positiveEntryEquiv : SymbolGroup R ≃ₗ[ℤ] ZMod 2 × positiveEntrySpan R :=
  AddEquiv.toIntLinearEquiv
    { toFun q := (sign R q, ⟨q - signSection (sign R q),
        sign_eq_zero_iff.1 (by rw [map_sub, sign_signSection, sub_self])⟩)
      invFun p := signSection p.1 + (p.2 : SymbolGroup R)
      left_inv q := add_sub_cancel _ _
      right_inv p := by
        obtain ⟨ε, d, hd⟩ := p
        ext
        · simp [sign_signSection, sign_eq_zero_of_mem_positiveEntrySpan hd]
        · simp [sign_signSection, sign_eq_zero_of_mem_positiveEntrySpan hd]
      map_add' a b := by
        ext
        · simp
        · simp only [map_add, Prod.snd_add, Submodule.coe_add]
          abel }

/-- The first component of `positiveEntryEquiv` is the sign map. -/
@[simp]
theorem positiveEntryEquiv_apply_fst (q : SymbolGroup R) :
    (positiveEntryEquiv R q).1 = sign R q :=
  (rfl)

/-- The second component of `positiveEntryEquiv` is `q - (sign R q).val • {-1, -1}`. -/
@[simp]
theorem coe_positiveEntryEquiv_apply_snd (q : SymbolGroup R) :
    ((positiveEntryEquiv R q).2 : SymbolGroup R) =
      q - (sign R q).val • symbol (-1 : Rˣ) (-1) :=
  congrArg (q - ·) (signSection_apply _)

/-- The inverse of `positiveEntryEquiv` sends `(ε, d)` to `ε.val • {-1, -1} + d`. -/
@[simp]
theorem positiveEntryEquiv_symm_apply (ε : ZMod 2) (d : positiveEntrySpan R) :
    (positiveEntryEquiv R).symm (ε, d) = ε.val • symbol (-1 : Rˣ) (-1) + d :=
  congrArg (· + (d : SymbolGroup R)) (signSection_apply ε)

/-- `positiveEntryEquiv` sends `{-1, -1}` to `(1, 0)`. -/
@[simp]
theorem positiveEntryEquiv_symbol_neg_one_neg_one :
    positiveEntryEquiv R (symbol (-1 : Rˣ) (-1)) = (1, 0) := by
  rw [← LinearEquiv.eq_symm_apply, positiveEntryEquiv_symm_apply]
  simp [ZMod.val_one'' (n := 2) (by decide)]

end OrderedCommRing

section RealClosed

variable {F : Type*} [Field F] [LinearOrder F] [IsStrictOrderedRing F] [IsRealClosed F]

/-- Over a real closed field, a symbol with a positive entry is an `m`-th multiple of a symbol
with a positive entry, for every `m ≠ 0`: the positive entry is the `m`-th power of a positive
element. -/
private theorem exists_mem_positiveEntrySpan_nsmul_eq_symbol {m : ℕ}
    (hm : m ≠ 0) {x y : Fˣ} (h : 0 < (x : F) ∨ 0 < (y : F)) :
    ∃ z ∈ positiveEntrySpan F, m • z = symbol x y := by
  -- A positive unit `a` is the `m`-th power of a positive unit.
  have hroot : ∀ a : Fˣ, 0 < (a : F) → ∃ b : Fˣ, 0 < (b : F) ∧ b ^ m = a := fun a ha ↦ by
    obtain ⟨r, hr, hra⟩ := IsRealClosed.exists_pos_pow_eq_of_pos ha hm
    exact ⟨Units.mk0 r hr.ne', hr, Units.ext (by simpa using hra)⟩
  rcases h with hx | hy
  · obtain ⟨b, hb, rfl⟩ := hroot x hx
    exact ⟨symbol b y, symbol_mem_positiveEntrySpan_of_pos_left hb y,
      (symbol_pow_left b y m).symm⟩
  · obtain ⟨b, hb, rfl⟩ := hroot y hy
    exact ⟨symbol x b, symbol_mem_positiveEntrySpan_of_pos_right x hb,
      (symbol_pow_right x b m).symm⟩

/-- **The positive-entry span is divisible** over a real closed field such as `ℝ`:
multiplication by every `m ≠ 0` is surjective on it. -/
theorem positiveEntrySpan_nsmul_right_surjective {m : ℕ} (hm : m ≠ 0) :
    Function.Surjective fun d : positiveEntrySpan F ↦ m • d := by
  rintro ⟨q, hq⟩
  suffices h : ∃ z ∈ positiveEntrySpan F, m • z = q by
    obtain ⟨z, hz, rfl⟩ := h
    exact ⟨⟨z, hz⟩, rfl⟩
  induction hq using Submodule.span_induction with
  | mem q hq =>
    obtain ⟨x, y, h, rfl⟩ := hq
    exact exists_mem_positiveEntrySpan_nsmul_eq_symbol hm h
  | zero => exact ⟨0, zero_mem _, smul_zero m⟩
  | add a b _ _ ha hb =>
    obtain ⟨z, hz, rfl⟩ := ha
    obtain ⟨w, hw, rfl⟩ := hb
    exact ⟨z + w, add_mem hz hw, smul_add m z w⟩
  | smul n a _ ha =>
    obtain ⟨z, hz, rfl⟩ := ha
    exact ⟨n • z, Submodule.smul_mem _ n hz, (smul_comm n m z).symm⟩

end RealClosed

end TauCeti.SymbolGroup
