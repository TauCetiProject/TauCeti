module

public import TauCeti.FieldTheory.Kummer.Cyclic
public import TauCeti.RingTheory.Norm.RationalPoint

/-!
# Norms from a radical extension at a split base change

Let `L = K(s)` with `sⁿ = b ≠ 0`, and suppose that `K` contains a primitive `n`-th root of
unity. If `b` has an `n`-th root in a field extension `F/K`, then the norm from `F ⊗[K] L`
is surjective on units. The binomial need not be irreducible, and no assumption that `n` is
prime or that `[L : K] = n` is made.

Taking `F` to be a completion gives the local norm conditions at places where the radicand
is a power, used in the Kummer norm argument. The splitting-field realization comes from
`TauCeti.isSplittingField_X_pow_sub_C_of_adjoin_eq_top`, and the norm theorem comes from
`AlgHom.normUnits_tensorProduct_surjective`.

## References

* J. S. Milne, *Class Field Theory*, v4.03, Chapter VII, Proposition 6.10.
-/

public noncomputable section

open Polynomial IntermediateField
open scoped TensorProduct

namespace IsPrimitiveRoot

/-- If a nonzero radicand has a root after base change, the norm from its radical extension
is surjective on units. The extension is required to be generated by that radical. -/
theorem normUnits_tensorProduct_surjective_of_pow_eq
    {K L F : Type*} [Field K] [Field L] [Field F] [Algebra K L] [Algebra K F]
    {n : ℕ} [NeZero n] {ζ b : K} (hζ : IsPrimitiveRoot ζ n) (hb : b ≠ 0)
    {s : L} (hs : s ^ n = algebraMap K L b) (hgen : K⟮s⟯ = ⊤)
    (hroot : ∃ t : F, t ^ n = algebraMap K F b) :
    Function.Surjective (TauCeti.Algebra.normUnits F (S := F ⊗[K] L)) := by
  have := TauCeti.isGalois_of_pow_eq_of_adjoin_eq_top hζ hb hs hgen
  have := TauCeti.isSplittingField_X_pow_sub_C_of_adjoin_eq_top hζ hs hgen
  have := IsSplittingField.finiteDimensional L (X ^ n - C b)
  obtain ⟨t, ht⟩ := hroot
  have hsplit : ((X ^ n - C b).map (algebraMap K F)).Splits := by
    simpa using X_pow_sub_C_splits_of_isPrimitiveRoot
      (hζ.map_of_injective (algebraMap K F).injective) ht
  exact (IsSplittingField.lift L (X ^ n - C b) hsplit).normUnits_tensorProduct_surjective

end IsPrimitiveRoot
