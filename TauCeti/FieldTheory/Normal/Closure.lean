/-!
# Normal closures in general and algebraically closed ambient fields

For an arbitrary field extension `E / F`, `normalClosure F K E` lies in a normal intermediate field
`M` if and only if `K ≤ M` (`normalClosure_le_iff_le_of_normal`), dropping `[Normal F E]` from
Mathlib's `IntermediateField.normalClosure_le_iff_of_normal`. Whenever `x : E` is integral over `F`
and `minpoly F x` splits in `E` (in particular when `E / F` is normal or `E` is algebraically
closed), the normal closure of `F⟮x⟯` in `E` is generated by the roots of `minpoly F x` and is
therefore a splitting field of that polynomial. This identifies the field used to study a simple
extension with the field used to define its polynomial Galois group. The closure has finite degree,
and is Galois when the minimal polynomial is separable.

When `E / F` is normal and `F⟮x⟯` is already all of `E`, `E` itself is a splitting field of
`minpoly F x`; if moreover `E / F` is Galois, the Galois group of `minpoly F x` has order `[E : F]`.

For an arbitrary ambient field, the embedding images of an extension into its normal closure
generate that whole normal closure. This allows properties preserved under composita to be
proved by working with the embedding images. For the same reason every homomorphism between
ambient fields maps one normal closure into the other; in particular automorphisms of the ambient
field restrict to the normal closure even when the ambient field is not normal.

Whenever an algebraic extension `K / F` has every minimal polynomial splitting in `E` (for instance
when `E` is algebraically closed), `normalClosure F K E` is normal over `F`
(`normal_normalClosure_of_splits`), Galois when `K / F` is separable
(`isGalois_normalClosure_of_splits`), and monotone in `K` (`normalClosure_mono_of_splits`).
Moreover, the normal closure of `F(S)` for a set `S` of separable elements whose minimal polynomials
split in the ambient field is Galois; in particular finitely many algebraic numbers lie in a finite
Galois subfield of `ℂ / ℚ`, which is how statements about algebraic numbers are reduced to
statements inside a finite Galois number field.

## References

* Serge Lang, *Algebra*, revised 3rd ed., Graduate Texts in Mathematics 211, Springer, 2002,
  Chapter V, §3.
-/

/- The proof uses `normalClosure_le_iff_le_of_normal` together with
`adjoin_rootSet_isSplittingField` and `IntermediateField.adjoin.powerBasis`. -/

public section

namespace TauCeti

open IntermediateField Polynomial

/-- The images of all `K`-embeddings of `L` into `normalClosure K L Ω` generate that field. -/
theorem normalClosure_iSup_fieldRange_eq_top (K L Ω : Type*) [Field K] [Field L] [Field Ω]
    [Algebra K L] [Algebra K Ω] :
    (⨆ f : L →ₐ[K] normalClosure K L Ω, f.fieldRange) = ⊤ := by
  apply IntermediateField.map_injective (normalClosure K L Ω).val
  rw [IntermediateField.map_iSup, ← AlgHom.fieldRange_eq_map,
    IntermediateField.fieldRange_val]
  simp_rw [AlgHom.map_fieldRange]
  exact (normalClosure.algHomEquiv K L Ω).iSup_comp.trans (normalClosure_def K L Ω).symm

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- **Universal property of `normalClosure` into a normal intermediate field.** In an arbitrary
field extension `E / F` (generalizing `IntermediateField.normalClosure_le_iff_of_normal` by
dropping `[Normal F E]`), `normalClosure F K E` is contained in a normal intermediate field `M` if
and only if `K ≤ M`. -/
@[simp]
theorem normalClosure_le_iff_le_of_normal {K M : IntermediateField F E} [Normal F M] :
    normalClosure F K E ≤ M ↔ K ≤ M := by
  refine ⟨(le_normalClosure K).trans, fun h ↦ normalClosure_le_iff.2 ?_⟩
  rintro f _ ⟨x, rfl⟩
  let y : M := IntermediateField.inclusion h x
  have hy_int : IsIntegral F y := Algebra.IsIntegral.isIntegral y
  have hmin : minpoly F x = minpoly F y :=
    (IntermediateField.minpoly_eq x).trans (IntermediateField.minpoly_eq y).symm
  have hroot : f x ∈ (minpoly F y).rootSet E := by
    rw [mem_rootSet_of_ne (minpoly.ne_zero hy_int), ← hmin,
      aeval_algHom_apply, minpoly.aeval, map_zero]
  have hsplit : ((minpoly F y).map (algebraMap F M)).Splits := Normal.splits' y
  rw [← hsplit.image_rootSet_algebraMap (B := E)] at hroot
  obtain ⟨z, -, hz⟩ := hroot
  exact hz ▸ z.2

/-- The normal closure of a simple algebraic extension has finite degree. -/
theorem finiteDimensional_normalClosure_adjoin_simple {x : E} (hx : IsIntegral F x) :
    FiniteDimensional F (normalClosure F F⟮x⟯ E) := by
  let _ : FiniteDimensional F F⟮x⟯ := adjoin.finiteDimensional hx
  exact normalClosure.is_finiteDimensional F F⟮x⟯ E

/-- When `x` is integral over `F` and `minpoly F x` splits in `E`, the normal closure of `F⟮x⟯` in
`E` is generated by the roots of `minpoly F x` in `E`. The ambient extension `E / F` need not be
normal. -/
theorem normalClosure_adjoin_simple_eq_adjoin_rootSet {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) :
    normalClosure F F⟮x⟯ E = adjoin F ((minpoly F x).rootSet E) := by
  have hsf : IsSplittingField F (adjoin F ((minpoly F x).rootSet E)) (minpoly F x) :=
    adjoin_rootSet_isSplittingField hsplit
  have : Normal F (adjoin F ((minpoly F x).rootSet E)) :=
    Normal.of_isSplittingField (minpoly F x)
  apply le_antisymm
  · rw [normalClosure_le_iff_le_of_normal, adjoin_simple_le_iff]
    exact subset_adjoin F _
      ((mem_rootSet_of_ne (minpoly.ne_zero hx)).mpr (minpoly.aeval F x))
  · refine adjoin_le_iff.mpr fun y hy ↦ ?_
    have hy_eval : aeval y (minpoly F (adjoin.powerBasis hx).gen) = 0 := by
      rw [adjoin.powerBasis_gen, minpoly_gen]
      exact (mem_rootSet.mp hy).2
    let φ : F⟮x⟯ →ₐ[F] E := (adjoin.powerBasis hx).lift y hy_eval
    refine φ.fieldRange_le_normalClosure ⟨(adjoin.powerBasis hx).gen, ?_⟩
    exact (adjoin.powerBasis hx).lift_gen y hy_eval

/-- When `x` is integral over `F` and `minpoly F x` splits in `E`, the normal closure of `F⟮x⟯` in
`E` is a splitting field of `minpoly F x` over `F`. No separability hypothesis is needed. -/
theorem isSplittingField_normalClosure_adjoin_simple {x : E} (hx : IsIntegral F x)
    (hsplit : ((minpoly F x).map (algebraMap F E)).Splits) :
    IsSplittingField F (normalClosure F F⟮x⟯ E) (minpoly F x) := by
  rw [normalClosure_adjoin_simple_eq_adjoin_rootSet hx hsplit]
  exact adjoin_rootSet_isSplittingField hsplit

/-- When every minimal polynomial of an algebraic extension `K / F` splits in `E`,
`normalClosure F K E` is normal over `F`. -/
theorem normal_normalClosure_of_splits {K : Type*} [Field K] [Algebra F K]
    [Algebra.IsAlgebraic F K] (splits : ∀ x : K, ((minpoly F x).map (algebraMap F E)).Splits) :
    Normal F (normalClosure F K E) :=
  have := Algebra.IsAlgebraic.isNormalClosure_normalClosure (L := E) splits
  IsNormalClosure.normal (K := K)

/-- When every minimal polynomial of a separable extension `K / F` splits in `E`,
`normalClosure F K E` is Galois over `F`. -/
theorem isGalois_normalClosure_of_splits {K : Type*} [Field K] [Algebra F K]
    [Algebra.IsSeparable F K] (splits : ∀ x : K, ((minpoly F x).map (algebraMap F E)).Splits) :
    IsGalois F (normalClosure F K E) := by
  have : Algebra.IsAlgebraic F K := Algebra.IsSeparable.isAlgebraic F K
  have : Normal F (normalClosure F K E) := normal_normalClosure_of_splits splits
  exact ⟨⟩

/-- **Monotonicity of `normalClosure` under splitting.** If `K₁ ≤ K₂` are intermediate fields of
`E / F` with `K₂ / F` algebraic and every minimal polynomial of `K₂ / F` splitting in `E`, then
`normalClosure F K₁ E ≤ normalClosure F K₂ E`. -/
theorem normalClosure_mono_of_splits {K₁ K₂ : IntermediateField F E}
    [Algebra.IsAlgebraic F K₂]
    (splits : ∀ x : K₂, ((minpoly F x).map (algebraMap F E)).Splits) (h : K₁ ≤ K₂) :
    normalClosure F K₁ E ≤ normalClosure F K₂ E := by
  have : Normal F (normalClosure F K₂ E) := normal_normalClosure_of_splits splits
  exact normalClosure_le_iff_le_of_normal.mpr (h.trans (le_normalClosure K₂))

/-- The normal closure of `F(S)` in `E` is Galois over `F` when every element of `S` is
separable over `F` with minimal polynomial splitting in `E`. The ambient field `E` need not be
normal over `F`. -/
theorem isGalois_normalClosure_adjoin {S : Set E}
    (h : ∀ s ∈ S, IsSeparable F s ∧ ((minpoly F s).map (algebraMap F E)).Splits) :
    IsGalois F (normalClosure F (adjoin F S) E) := by
  have hint (s) (hs : s ∈ S) : IsIntegral F s := (h s hs).1.isIntegral
  have : Algebra.IsSeparable F (adjoin F S) :=
    (isSeparable_adjoin_iff_isSeparable F E).2 fun s hs ↦ (h s hs).1
  exact isGalois_normalClosure_of_splits fun x ↦ by
    rw [minpoly_eq]
    exact splits_of_mem_adjoin F E (fun s hs ↦ ⟨hint s hs, (h s hs).2⟩) x.2

section Normal

variable [Normal F E]

/-- The normal closure of a simple extension is Galois if its minimal polynomial is
separable. -/
theorem isGalois_normalClosure_adjoin_simple (x : E)
    (hsep : (minpoly F x).Separable) :
    IsGalois F (normalClosure F F⟮x⟯ E) :=
  isGalois_normalClosure_adjoin fun _ hs ↦ by
    rw [Set.mem_singleton_iff.1 hs]
    exact ⟨hsep, Normal.splits' x⟩

/-- A normal simple extension splits the minimal polynomial of its generator and is generated
by its roots. -/
theorem isSplittingField_minpoly_of_adjoin_simple_eq_top (x : E) (hgen : F⟮x⟯ = ⊤) :
    (minpoly F x).IsSplittingField F E := by
  have hx : IsIntegral F x := Algebra.IsIntegral.isIntegral x
  apply isSplittingField_iff_intermediateField.mpr
  refine ⟨Normal.splits' x, top_unique ?_⟩
  rw [← hgen]
  exact IntermediateField.adjoin_simple_le_iff.mpr
    (subset_adjoin F _ ((Polynomial.mem_rootSet_of_ne (minpoly.ne_zero hx)).mpr
      (minpoly.aeval F x)))

end Normal

/-- In a Galois simple extension, the minimal polynomial of a generator has Galois-group
order equal to the extension degree. -/
theorem natCard_gal_minpoly_eq_finrank [IsGalois F E] (x : E) (hgen : F⟮x⟯ = ⊤) :
    Nat.card (minpoly F x).Gal = Module.finrank F E := by
  have := isSplittingField_minpoly_of_adjoin_simple_eq_top x hgen
  rw [Polynomial.Gal.card_of_separable (by exact IsGalois.separable F x)]
  exact (IsSplittingField.algEquiv E (minpoly F x)).toLinearEquiv.finrank_eq.symm

/-- **A finite set lies in a finite Galois subextension.** A finite set `S` of elements of `E`,
each separable over `F` with minimal polynomial splitting in `E`, is contained in an intermediate
field of `E / F` that is finite and Galois over `F`, namely the normal closure of `F(S)`. -/
theorem exists_isGalois_superset {S : Set E} (hS : S.Finite)
    (h : ∀ s ∈ S, IsSeparable F s ∧ ((minpoly F s).map (algebraMap F E)).Splits) :
    ∃ L : IntermediateField F E, FiniteDimensional F L ∧ IsGalois F L ∧ S ⊆ L := by
  have := hS.to_subtype
  have : FiniteDimensional F (adjoin F S) :=
    finiteDimensional_adjoin fun s hs ↦ (h s hs).1.isIntegral
  exact ⟨normalClosure F (adjoin F S) E, inferInstance, isGalois_normalClosure_adjoin h,
    (subset_adjoin F S).trans (le_normalClosure (adjoin F S))⟩

section AlgClosed

variable [IsAlgClosed E]

/-- **A finite set of algebraic elements lies in a finite Galois subextension** of an
algebraically closed field over a perfect field; for instance, finitely many algebraic numbers lie
in a finite Galois subfield of `ℂ / ℚ`. -/
theorem exists_isGalois_superset_of_isAlgClosed [PerfectField F] {S : Set E}
    (hS : S.Finite) (h : ∀ s ∈ S, IsAlgebraic F s) :
    ∃ L : IntermediateField F E, FiniteDimensional F L ∧ IsGalois F L ∧ S ⊆ L :=
  exists_isGalois_superset hS fun s hs ↦
    ⟨PerfectField.separable_of_irreducible (minpoly.irreducible (h s hs).isIntegral),
      IsAlgClosed.splits _⟩

end AlgClosed

end TauCeti

/-- **Homomorphisms of ambient fields map normal closures into normal closures.** An
`F`-algebra homomorphism `σ : L →ₐ[F] L'` carries the image of each embedding `f : K →ₐ[F] L` onto
the image of `σ.comp f`, so it maps `normalClosure F K L` into `normalClosure F K L'`. Taking
`L' = L`, every endomorphism of `L` maps `normalClosure F K L` into itself. Nothing is asked of
`L / F`; when `L / F` is normal the endomorphism case is also a consequence of the normality of
the normal closure. -/
theorem AlgHom.map_normalClosure_le {F K L L' : Type*} [Field F] [Field K] [Field L] [Field L']
    [Algebra F K] [Algebra F L] [Algebra F L'] (σ : L →ₐ[F] L') :
    (IntermediateField.normalClosure F K L).map σ ≤ IntermediateField.normalClosure F K L' := by
  rw [normalClosure_def, IntermediateField.map_iSup]
  exact iSup_le fun f ↦
    (AlgHom.map_fieldRange f σ).trans_le (σ.comp f).fieldRange_le_normalClosure
