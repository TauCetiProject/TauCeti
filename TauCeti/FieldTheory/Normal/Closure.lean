module

public import Mathlib.FieldTheory.Normal.Closure
public import Mathlib.FieldTheory.PolynomialGaloisGroup

/-!
# The normal closure of a simple extension

Inside a normal extension, the normal closure of `F⟮x⟯` is generated by the roots of
`minpoly F x`. Thus it is a splitting field of that polynomial. This identifies the
field used to study a simple extension with the field used to define its polynomial
Galois group.

When `F⟮x⟯` is already all of `E`, this says that `E` itself is a splitting field of
`minpoly F x`; if moreover `E / F` is Galois, the Galois group of `minpoly F x` has order
`[E : F]`.
-/

/- The proof uses Mathlib's description of the normal closure as the supremum of the
conjugate fields and `minpoly.exists_algEquiv_of_root'`. -/

public section

namespace TauCeti

open IntermediateField Polynomial

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Normal F E]

/-- The normal closure of a simple extension is generated by all the conjugates of its
generator, equivalently by the roots of its minimal polynomial. -/
theorem normalClosure_adjoin_simple_eq_adjoin_rootSet (x : E) :
    normalClosure F F⟮x⟯ E = adjoin F ((minpoly F x).rootSet E) := by
  rw [normalClosure_def'']
  apply le_antisymm
  · refine iSup_le fun σ ↦ ?_
    rw [adjoin_map, Set.image_singleton]
    rw [adjoin_simple_le_iff]
    apply subset_adjoin
    rw [mem_rootSet_of_ne (minpoly.ne_zero (Algebra.IsIntegral.isIntegral x))]
    simp [aeval_algHom_apply]
  · refine adjoin_le_iff.mpr fun y hy ↦ ?_
    obtain ⟨σ, hσ⟩ := minpoly.exists_algEquiv_of_root'
      (Algebra.IsAlgebraic.isAlgebraic x) (mem_rootSet.mp hy).2
    apply le_iSup (fun σ : E ≃ₐ[F] E ↦ F⟮x⟯.map σ.toAlgHom) σ
    exact ⟨x, mem_adjoin_simple_self F x, hσ⟩

/-- The normal closure of a simple extension is a splitting field of the generator's
minimal polynomial. No separability hypothesis is needed. -/
theorem isSplittingField_normalClosure_adjoin_simple (x : E) :
    IsSplittingField F (normalClosure F F⟮x⟯ E) (minpoly F x) := by
  rw [normalClosure_adjoin_simple_eq_adjoin_rootSet]
  exact adjoin_rootSet_isSplittingField (Normal.splits (inferInstance : Normal F E) x)

/-- A normal simple extension splits the minimal polynomial of its generator and is generated
by its roots. -/
theorem isSplittingField_minpoly_of_adjoin_simple_eq_top (x : E) (hgen : F⟮x⟯ = ⊤) :
    (minpoly F x).IsSplittingField F E := by
  have hx : IsIntegral F x := Algebra.IsIntegral.isIntegral x
  apply isSplittingField_iff_intermediateField.mpr
  refine ⟨Normal.splits' x, top_unique ?_⟩
  rw [← hgen]
  exact IntermediateField.adjoin_simple_le_iff.mpr
    (subset_adjoin F _ ((Polynomial.mem_rootSet_of_ne (minpoly.ne_zero hx)).mpr
      (minpoly.aeval F x)))

omit [Normal F E] in
/-- In a Galois simple extension, the minimal polynomial of a generator has Galois-group
order equal to the extension degree. -/
theorem natCard_gal_minpoly_eq_finrank [IsGalois F E] (x : E) (hgen : F⟮x⟯ = ⊤) :
    Nat.card (minpoly F x).Gal = Module.finrank F E := by
  have := isSplittingField_minpoly_of_adjoin_simple_eq_top x hgen
  rw [Polynomial.Gal.card_of_separable (by exact IsGalois.separable F x)]
  exact (IsSplittingField.algEquiv E (minpoly F x)).toLinearEquiv.finrank_eq.symm

end TauCeti
