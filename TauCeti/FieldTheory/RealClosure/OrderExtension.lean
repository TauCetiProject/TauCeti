module

public import TauCeti.Algebra.Order.Ring.Ordering.Extension
public import Mathlib.Algebra.Order.Field.Basic
public import Mathlib.Algebra.Order.Hom.Monoid
public import Mathlib.Algebra.QuadraticAlgebra.Basic

/-! # Preserving an order under field extension

The cone generated by nonnegative base elements and extension-field squares
describes precisely the obstruction to extending an order. For a positive
quadratic extension, its scalar coordinate proves that this cone is proper.
The `extensionCone` namespace groups membership, evaluation, and order-extension results.
-/

public section

namespace TauCeti.RealClosure

variable {K L : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]

section CommRing

variable [CommRing L]

/-- Nonnegative scalar multiples of squares in an extension form a submonoid. -/
def weightedSquares (f : K →+* L) : Submonoid L where
  carrier := {x | ∃ a : K, 0 ≤ a ∧ ∃ y : L, x = f a * y ^ 2}
  one_mem' := ⟨1, zero_le_one, 1, by simp⟩
  mul_mem' := by
    rintro x y ⟨a, ha, u, rfl⟩ ⟨b, hb, v, rfl⟩
    exact ⟨a * b, mul_nonneg ha hb, u * v, by rw [map_mul]; ring⟩

@[simp] theorem mem_weightedSquares (f : K →+* L) {x : L} :
    x ∈ weightedSquares f ↔ ∃ a : K, 0 ≤ a ∧ ∃ y : L, x = f a * y ^ 2 := (Iff.rfl)

/-- Finite sums of nonnegative scalar multiples of squares. -/
def extensionCone (f : K →+* L) : Subsemiring L := (weightedSquares f).subsemiringClosure

/-- A generating weighted square belongs to the extension cone. -/
theorem extensionCone.weightedSquares_subset (f : K →+* L) :
    (weightedSquares f : Set L) ⊆ extensionCone f :=
  AddSubmonoid.subset_closure

/-- The generated cone is contained in a subsemiring exactly when its generators are. -/
@[simp] theorem extensionCone.le_iff (f : K →+* L) {S : Subsemiring L} :
    extensionCone f ≤ S ↔ (weightedSquares f : Set L) ⊆ S :=
  ⟨fun h _ hx => h (extensionCone.weightedSquares_subset f hx),
    fun h => (AddSubmonoid.closure_le (S := S.toAddSubmonoid)).mpr h⟩

/-- Induction on finite sums of generating weighted squares. -/
@[elab_as_elim] theorem extensionCone.induction (f : K →+* L)
    {motive : (x : L) → x ∈ extensionCone f → Prop}
    (mem : ∀ x (hx : x ∈ weightedSquares f), motive x (extensionCone.weightedSquares_subset f hx))
    (zero : motive 0 (zero_mem _))
    (add : ∀ x y hx hy, motive x hx → motive y hy → motive (x + y) (add_mem hx hy))
    {x : L} (hx : x ∈ extensionCone f) : motive x hx :=
  AddSubmonoid.closure_induction mem zero add hx

theorem extensionCone.mul_self_mem (f : K →+* L) (x : L) : x * x ∈ extensionCone f :=
  extensionCone.weightedSquares_subset f ⟨1, zero_le_one, x, by simp [pow_two]⟩

theorem extensionCone.map_mem_of_nonneg (f : K →+* L) {x : K} (hx : 0 ≤ x) :
    f x ∈ extensionCone f :=
  extensionCone.weightedSquares_subset f ⟨x, hx, 1, by simp⟩

/-- Algebra homomorphisms preserve the cone generated by the base ordering. -/
theorem extensionCone.map_mem {M : Type*} [CommRing M] [Algebra K L] [Algebra K M]
    (f : L →ₐ[K] M) {x : L} (hx : x ∈ extensionCone (algebraMap K L)) :
    f x ∈ extensionCone (algebraMap K M) := by
  induction hx using extensionCone.induction (algebraMap K L) with
  | mem x hx =>
    obtain ⟨a, ha, y, rfl⟩ := hx
    apply extensionCone.weightedSquares_subset
    exact ⟨a, ha, f y, by simp⟩
  | zero => simpa only [map_zero] using (zero_mem (extensionCone (algebraMap K M)))
  | add x y _ _ hx hy => simpa only [map_add] using add_mem hx hy

/-- An additive map nonnegative on the generating weighted squares is
nonnegative on the entire extension cone. -/
theorem extensionCone.map_nonneg {M : Type*} [AddCommMonoid M] [PartialOrder M]
    [IsOrderedAddMonoid M] (f : K →+* L) (g : L →+ M)
    (hg : ∀ a : K, 0 ≤ a → ∀ y : L, 0 ≤ g (f a * y ^ 2))
    {x : L} (hx : x ∈ extensionCone f) : 0 ≤ g x := by
  induction hx using extensionCone.induction f with
  | mem x hx =>
    obtain ⟨a, ha, y, rfl⟩ := hx
    exact hg a ha y
  | zero => simp
  | add x y _ _ hx hy => simpa only [map_add] using add_nonneg hx hy

/-- Every element of the generated cone is nonnegative in any order extending
the base order. -/
theorem extensionCone.nonneg [LinearOrder L] [IsOrderedRing L]
    (f : K →+* L) (hf : Monotone f) {x : L} (hx : x ∈ extensionCone f) : 0 ≤ x := by
  induction hx using extensionCone.induction f with
  | mem x hx =>
    obtain ⟨a, ha, y, rfl⟩ := hx
    exact mul_nonneg (by simpa only [map_zero] using hf ha) (sq_nonneg y)
  | zero => exact le_rfl
  | add x y _ _ hx hy => exact add_nonneg hx hy

end CommRing

section Field

variable [Field L]

/-- The order of the base field extends whenever its generated cone is proper. -/
theorem extensionCone.exists_linearOrder (f : K →+* L) (h : -1 ∉ extensionCone f) :
    ∃ o : LinearOrder L, letI := o
      IsStrictOrderedRing L ∧ StrictMono f := by
  let P : RingPreordering L :=
    { extensionCone f with
      mem_of_isSquare' := by
        rintro x ⟨y, rfl⟩
        exact extensionCone.mul_self_mem f y
      neg_one_notMem' := h }
  obtain ⟨o, ho, hP⟩ := RingPreordering.exists_linearOrder P
  let := o
  have := ho
  refine ⟨o, ho, ?_⟩
  exact ((monotone_iff_map_nonneg f).mpr fun x hx =>
    hP _ (extensionCone.map_mem_of_nonneg f hx)).strictMono_of_injective f.injective

end Field

section Quadratic

variable {a : K}

/-- Adjoining a square root of a nonnegative element does not force a sum of weighted
squares to equal `-1`. -/
theorem extensionCone.neg_one_notMem_quadraticAlgebra (ha : 0 ≤ a) :
    -1 ∉ extensionCone (algebraMap K (QuadraticAlgebra K a 0)) := by
  intro h
  have hnonneg := extensionCone.map_nonneg (algebraMap K (QuadraticAlgebra K a 0))
    (QuadraticAlgebra.reₗ (R := K) (a := a) (b := 0)).toAddMonoidHom (fun b hb y => ?_) h
  · exact (not_le_of_gt zero_lt_one) (by simpa [QuadraticAlgebra.re_one] using hnonneg)
  · simp only [LinearMap.toAddMonoidHom_coe, QuadraticAlgebra.reₗ_apply]
    simp only [pow_two, QuadraticAlgebra.re_mul, QuadraticAlgebra.algebraMap_re,
      QuadraticAlgebra.algebraMap_im, zero_mul, mul_zero, add_zero]
    simpa only [mul_assoc] using
      mul_nonneg hb (add_nonneg (mul_self_nonneg y.re) (mul_nonneg ha (mul_self_nonneg y.im)))

/-- A nonnegative nonsquare can be adjoined while preserving the base ordering.
Nonsquareness excludes zero, so the radicand is necessarily positive. -/
theorem _root_.QuadraticAlgebra.exists_linearOrder (ha : 0 ≤ a) [Fact (¬ IsSquare a)] :
    ∃ o : LinearOrder (QuadraticAlgebra K a 0), letI := o
      IsStrictOrderedRing (QuadraticAlgebra K a 0) ∧
        StrictMono (algebraMap K (QuadraticAlgebra K a 0)) :=
  extensionCone.exists_linearOrder _ (extensionCone.neg_one_notMem_quadraticAlgebra ha)

end Quadratic

end TauCeti.RealClosure
