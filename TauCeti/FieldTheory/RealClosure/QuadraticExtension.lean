module

public import TauCeti.FieldTheory.RealClosure.AlgebraicClosed
public import Mathlib.Algebra.QuadraticAlgebra.IsQuadraticExtension
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Algebra.Polynomial.SpecificDegree
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-! # Real closed fields and their algebraically closed quadratic extensions

A field `R` is real closed exactly when `-1` is not a square in `R` and some (equivalently,
every) quadratic extension of `R` is algebraically closed. In particular, when `X ^ 2 + 1` is
irreducible, `R` is real closed exactly when `R(√-1) = AdjoinRoot (X ^ 2 + 1)` is
algebraically closed.

For the forward direction, a quadratic extension embeds into the algebraically closed
`QuadraticAlgebra R (-1) 0` of the same dimension, so all its elements are squares. For the
converse, an
algebraically closed extension `K` of degree two identifies `K` with `R(√-1)`. Writing a
square root of `x + y √-1` in coordinates shows that every element or its negative is a
square, and that a sum of two squares is a square. Every irreducible polynomial over `R`
has degree dividing two, so a polynomial of odd degree has a root.

## Main results

* `TauCeti.RealClosure.isAlgClosed_of_isQuadraticExtension`: every quadratic extension of a
  real closed field is algebraically closed.
* `TauCeti.RealClosure.isRealClosed_of_isAlgClosed_of_isQuadraticExtension`: a field in
  which `-1` is not a square, with an algebraically closed quadratic extension, is real closed.
* `TauCeti.RealClosure.isRealClosed_iff_isAlgClosed_of_isQuadraticExtension`: the
  characterization by any fixed quadratic extension.
* `TauCeti.RealClosure.isRealClosed_of_isAlgClosed_adjoin`: the same converse, phrased with
  the intermediate field generated by a square root of `-1`.
* `TauCeti.RealClosure.isRealClosed_iff_isAlgClosed_adjoinRoot`: the characterization by
  `AdjoinRoot (X ^ 2 + 1)`.

## References

* S. Basu, R. Pollack, M.-F. Roy, *Algorithms in Real Algebraic Geometry*, second edition,
  Chapter 2.
* The converse follows the proof of `isRealClosed_of_isAlgClosed_adjoin` by Kiran S. Kedlaya
  in Mathlib pull request 41911 (the Artin–Schreier theorem), whose statement takes the same
  intermediate-field form: the degree bound on irreducible factors and the induction over sums
  of squares are adapted from it. The square-root computation in coordinates replaces that
  proof's quartic factorization.
-/

public section

namespace TauCeti.RealClosure

open Module Polynomial IntermediateField

variable {R K : Type*} [Field R] [Field K] [Algebra R K]

/-- Every quadratic extension of a real closed field is algebraically closed. -/
theorem isAlgClosed_of_isQuadraticExtension [IsRealClosed R]
    [Algebra.IsQuadraticExtension R K] : IsAlgClosed K := by
  have : FiniteDimensional R K :=
    finite_of_finrank_eq_succ (Algebra.IsQuadraticExtension.finrank_eq_two R K)
  -- Embed `K` into the algebraically closed `R(√-1)`; equal dimensions make this onto.
  let f : K →ₐ[R] QuadraticAlgebra R (-1) 0 := IsAlgClosed.lift
  have hf : Function.Surjective f :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (f := f.toLinearMap)
      (by simp [Algebra.IsQuadraticExtension.finrank_eq_two])).mp f.injective
  refine isAlgClosed_of_forall_isSquare (R := R) fun x => ?_
  obtain ⟨w, hw⟩ := QuadraticAlgebra.isSquare (f x)
  obtain ⟨y, rfl⟩ := hf w
  exact ⟨y, f.injective (by simp [hw])⟩

section Converse

variable [IsAlgClosed K]

/-- Over a field with an algebraically closed extension of degree two, every polynomial of odd
degree has a root. -/
private theorem exists_isRoot_of_odd_natDegree (hK : finrank R K = 2) :
    ∀ n, ∀ f : R[X], f.natDegree = n → Odd n → ∃ x, f.IsRoot x := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rintro f rfl hf
    have hf0 : f ≠ 0 := by rintro rfl; simp at hf
    obtain ⟨g, hg, hgf⟩ :=
      WfDvdMonoid.exists_irreducible_factor (not_isUnit_of_natDegree_pos f hf.pos) hf0
    have hdvd : g.natDegree ∣ 2 := hK ▸ hg.natDegree_dvd_finrank (IsAlgClosed.splits _)
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with hg1 | hg2
    · obtain ⟨x, hx⟩ := exists_root_of_degree_eq_one
        ((degree_eq_iff_natDegree_eq_of_pos one_pos).mpr hg1)
      exact ⟨x, hx.dvd hgf⟩
    · obtain ⟨q, rfl⟩ := hgf
      have hq0 : q ≠ 0 := right_ne_zero_of_mul hf0
      have hdeg : (g * q).natDegree = q.natDegree + 2 := by
        rw [natDegree_mul hg.ne_zero hq0, hg2, add_comm]
      obtain ⟨x, hx⟩ := ih q.natDegree (by omega) q rfl (by
        rw [hdeg] at hf
        exact (Nat.odd_add.mp hf).mpr even_two)
      exact ⟨x, by simp [IsRoot, hx.eq_zero]⟩

variable (hR : ¬IsSquare (-1 : R))
include hR

/-- If `-1` is not a square in `R` and `R` has an algebraically closed quadratic extension,
then every `a + b √-1` has a square root `c + d √-1` with `c, d ∈ R`. -/
private theorem exists_coords_sqrt [Algebra.IsQuadraticExtension R K] (a b : R) :
    ∃ c d : R, c * c - d * d = a ∧ 2 * (c * d) = b := by
  have : Fact (¬IsSquare (-1 : R)) := ⟨hR⟩
  have : FiniteDimensional R K :=
    finite_of_finrank_eq_succ (Algebra.IsQuadraticExtension.finrank_eq_two R K)
  -- Identify `R(√-1)` with `K` by sending `√-1` to a square root of `-1` in `K`.
  obtain ⟨i, hi⟩ := IsAlgClosed.exists_pow_nat_eq (-1 : K) two_pos
  let f := QuadraticAlgebra.lift (R := R) (a := -1) (b := 0) ⟨i, by simp [← sq, hi]⟩
  have hf : Function.Surjective f :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (f := f.toLinearMap)
      (by simp [Algebra.IsQuadraticExtension.finrank_eq_two])).mp f.injective
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (f ⟨a, b⟩) two_pos
  obtain ⟨y, rfl⟩ := hf z
  have hy : y * y = ⟨a, b⟩ := f.injective (by simp [← hz, sq])
  have hre := congrArg QuadraticAlgebra.re hy
  have him := congrArg QuadraticAlgebra.im hy
  simp only [QuadraticAlgebra.re_mul, QuadraticAlgebra.im_mul] at hre him
  exact ⟨y.re, y.im, by linear_combination hre, by linear_combination him⟩

/-- A field in which `-1` is not a square and which has an algebraically closed quadratic
extension is real closed. -/
theorem isRealClosed_of_isAlgClosed_of_isQuadraticExtension [Algebra.IsQuadraticExtension R K] :
    IsRealClosed R := by
  have h2 : (2 : R) ≠ 0 := fun h => hR ⟨1, by linear_combination -h⟩
  -- A sum of two squares `a² + b²` is the norm `(c² + d²)²` of a square root of `a + b √-1`.
  have hsumsq {s : R} (hs : IsSumSq s) : IsSquare s := by
    induction hs using IsSumSq.rec' with
    | zero => exact ⟨0, by simp⟩
    | sq_add hx _ ih =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := ih
      obtain ⟨c, d, rfl, rfl⟩ := exists_coords_sqrt (K := K) hR a b
      exact ⟨c * c + d * d, by ring⟩
  have : IsSemireal R := .of_not_isSumSq_neg_one fun h => hR (hsumsq h)
  refine
    { isSquare_or_isSquare_neg := fun x => ?_
      exists_isRoot_of_odd_natDegree := fun hf =>
        exists_isRoot_of_odd_natDegree (K := K)
          (Algebra.IsQuadraticExtension.finrank_eq_two R K) _ _ rfl hf }
  -- A square root `c + d √-1` of `x` has `c = 0` or `d = 0`.
  obtain ⟨c, d, rfl, hcd⟩ := exists_coords_sqrt (K := K) hR x 0
  rcases mul_eq_zero.mp ((mul_eq_zero.mp hcd).resolve_left h2) with rfl | rfl
  · exact Or.inr ⟨d, by ring⟩
  · exact Or.inl ⟨c, by ring⟩

end Converse

/-- A field is real closed exactly when `-1` is not a square in it and a given quadratic
extension is algebraically closed. -/
theorem isRealClosed_iff_isAlgClosed_of_isQuadraticExtension
    [Algebra.IsQuadraticExtension R K] :
    IsRealClosed R ↔ ¬IsSquare (-1 : R) ∧ IsAlgClosed K :=
  ⟨fun _ => ⟨fun h => IsSemireal.not_isSumSq_neg_one R h.isSumSq,
      isAlgClosed_of_isQuadraticExtension (R := R)⟩,
    fun ⟨hR, _⟩ => isRealClosed_of_isAlgClosed_of_isQuadraticExtension (K := K) hR⟩

/-- A field in which `-1` is not a square is real closed when adjoining a square root of `-1`,
taken in some extension, gives an algebraically closed field. -/
theorem isRealClosed_of_isAlgClosed_adjoin (hR : ¬IsSquare (-1 : R)) {i : K} (hi : i ^ 2 = -1)
    [IsAlgClosed R⟮i⟯] : IsRealClosed R := by
  have hroot : aeval i (X ^ 2 + 1 : R[X]) = 0 := by simp [hi]
  have hdeg : (X ^ 2 + 1 : R[X]).natDegree = 2 := by rw [← C_1, natDegree_X_pow_add_C]
  have hirr : Irreducible (X ^ 2 + 1 : R[X]) := by
    refine irreducible_of_degree_le_three_of_not_isRoot (by rw [hdeg]; decide) fun x hx => ?_
    exact hR ⟨x, by linear_combination -(by simpa [sq] using hx : x * x + 1 = 0)⟩
  have hint : IsIntegral R i := ⟨_, monic_X_pow_add_C 1 two_ne_zero, hroot⟩
  have hmin : minpoly R i = X ^ 2 + 1 :=
    (minpoly.eq_of_irreducible_of_monic hirr hroot (monic_X_pow_add_C 1 two_ne_zero)).symm
  have : Algebra.IsQuadraticExtension R R⟮i⟯ :=
    { finrank_eq_two' := by rw [adjoin.finrank hint, hmin, hdeg] }
  exact isRealClosed_of_isAlgClosed_of_isQuadraticExtension (K := R⟮i⟯) hR

/-- A field over which `X ^ 2 + 1` is irreducible is real closed exactly when
`AdjoinRoot (X ^ 2 + 1)` is algebraically closed. -/
theorem isRealClosed_iff_isAlgClosed_adjoinRoot [Fact (Irreducible (X ^ 2 + 1 : R[X]))] :
    IsRealClosed R ↔ IsAlgClosed (AdjoinRoot (X ^ 2 + 1 : R[X])) := by
  have hirr : Irreducible (X ^ 2 + 1 : R[X]) := Fact.out
  have : Algebra.IsQuadraticExtension R (AdjoinRoot (X ^ 2 + 1 : R[X])) :=
    { finrank_eq_two' := by
        rw [(AdjoinRoot.powerBasis hirr.ne_zero).finrank, AdjoinRoot.powerBasis_dim, ← C_1,
          natDegree_X_pow_add_C] }
  rw [isRealClosed_iff_isAlgClosed_of_isQuadraticExtension (K := AdjoinRoot (X ^ 2 + 1 : R[X])),
    and_iff_right_iff_imp]
  rintro - ⟨x, hx⟩
  have hroot : (X ^ 2 + 1 : R[X]).IsRoot x := by simp [IsRoot, sq, ← hx]
  have := degree_eq_one_of_irreducible_of_root hirr hroot
  rw [← C_1, degree_X_pow_add_C two_pos] at this
  exact absurd this (by decide)

end TauCeti.RealClosure
