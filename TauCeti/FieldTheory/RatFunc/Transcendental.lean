/-!
# The rational function field as a base for a transcendental element

Let `F` be an extension of a field `k` and let `x ∈ F` be transcendental over `k`. Mathlib's
`RatFunc.algEquivOfTranscendental` identifies `k(X)` with the intermediate field `k⟮x⟯`;
composing with its inclusion into `F` makes `F` an algebra over `k(X)` in which `X` acts as `x`.
This file packages that algebra structure together with the transfers along it of the scalar
tower over `k` and of separability over `k⟮x⟯`.

The structure is not an instance: it depends on the element `x` and on a proof, and distinct
transcendental elements induce distinct `k(X)`-algebra structures on the same `F`. It is meant
to be introduced locally with `letI`.

A simple transcendental extension is free on its generator: `k⟮x⟯` maps to any field over `k`
by sending `x` to any transcendental element, since both generate a copy of `k(X)`.

When `F = k(x)` and the variable `t` of `k(t)` acts as `q(x)` for a polynomial `q`, the
generator `x` is a root of `q(X) - t`, so `F` is finite over `k(t)`, and separable over it when
`q′ ≠ 0`.

The nonconstant rational function `X - X⁻¹` is also shown to be transcendental.
Consequently substitution at it loses no polynomial information, including in positive
characteristic.

## Main definitions

* `TauCeti.ratFuncAlgebraOfTranscendental`: the `k(X)`-algebra structure on `F` sending `X`
  to `x`.
* `Transcendental.algHomAdjoin`: the `k`-algebra map `k⟮x⟯ → E` sending `x` to a transcendental
  element `z`.

## Main results

* `TauCeti.algebraMap_ratFuncAlgebraOfTranscendental_X`: the variable `X` acts as `x`.
* `TauCeti.map_algebraMap_ratFuncAlgebraOfTranscendental`: an injective `k`-algebra map `f`
  carries the structure induced by `x` to the structure induced by `f x`.
* `TauCeti.isScalarTower_ratFuncAlgebraOfTranscendental`: the structure extends the given
  `k`-algebra structure.
* `TauCeti.isSeparable_ratFuncAlgebraOfTranscendental`: separability over `k⟮x⟯` transfers to
  separability over `k(X)`.
* `TauCeti.ratFuncAlgebraOfTranscendental_eq_liftAlgebra`: when `x` is the image of `X` under a
  `k[X]`-algebra structure, the structure is Mathlib's `RatFunc.liftAlgebra`.
* `TauCeti.coe_algEquivOfTranscendental_algebraMap_X_apply`: conversely, every `k(X)`-algebra
  structure is induced by the image `x` of `X`, through `k(X) ≃ k⟮x⟯`.
* `TauCeti.finrank_adjoin_algebraMap_X`: for a `k(X)`-algebra `F`, the degree of `F` over the
  subfield generated by the image of `X` is its degree over `k(X)`.
* `TauCeti.isSeparable_adjoin_algebraMap_X_iff`: likewise, `F` is separable over that subfield
  exactly when it is separable over `k(X)`.
* `TauCeti.transcendental_of_aeval_eq`: if the variable `t` of `k(t)` acts on `F` as `q(x)`,
  then `x` is transcendental over `k`.
* `TauCeti.finiteDimensional_of_aeval_eq` and `TauCeti.isSeparable_of_aeval_eq`: if `F = k(x)`
  over `k(t)` with `t = q(x)` for a polynomial `q`, then `F` is finite over `k(t)`, and separable
  when `q′ ≠ 0`.
* `TauCeti.transcendental_ratFunc_X_sub_inv`: `X - X⁻¹` is transcendental.
* `TauCeti.isIntegrallyClosedIn_ratFunc`: `k` is integrally closed in `k(X)`.
* `Transcendental.algHomAdjoin_gen`: `Transcendental.algHomAdjoin` sends the generator `x` to `z`.
* `Transcendental.isIntegrallyClosedIn_adjoin`: `k` is integrally closed in the field `k(x)`
  generated by a transcendental element.
-/

public section

noncomputable section

namespace TauCeti

open scoped IntermediateField
open scoped Polynomial

/-- The rational function `X - X⁻¹` is transcendental over the coefficient field,
in every characteristic. -/
theorem transcendental_ratFunc_X_sub_inv (k : Type*) [Field k] :
    Transcendental k (RatFunc.X - RatFunc.X⁻¹ : RatFunc k) := by
  apply RatFunc.transcendental_of_ne_C
  rintro ⟨c, hc⟩
  have he : Polynomial.aeval (RatFunc.X : RatFunc k)
      (Polynomial.X ^ 2 - Polynomial.C c * Polynomial.X - 1) = 0 := by
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, map_mul, map_one]
    rw [RatFunc.algebraMap_eq_C]
    have hx := RatFunc.X_ne_zero (K := k)
    field_simp at hc
    linear_combination hc
  have hp := (transcendental_iff_injective.mp (RatFunc.transcendental_X (K := k)))
    (he.trans (map_zero _).symm)
  have hcoeff := congrArg (fun p : k[X] ↦ p.coeff 2) hp
  norm_num [Polynomial.coeff_one] at hcoeff

variable {k : Type*} [Field k] {F : Type*} [Field F] [Algebra k F] {x : F}

/-- `k` is integrally closed in the rational function field `k(x)`: an integral rational function
is algebraic, hence constant (Stichtenoth, Proposition 1.2.1(d)). -/
instance isIntegrallyClosedIn_ratFunc : IsIntegrallyClosedIn k (RatFunc k) :=
  isIntegrallyClosedIn_iff.mpr ⟨(algebraMap k (RatFunc k)).injective, fun {f} hf ↦ by
    obtain ⟨c, rfl⟩ := not_not.mp fun h ↦ RatFunc.transcendental_of_ne_C f h hf.isAlgebraic
    exact ⟨c, DFunLike.congr_fun RatFunc.algebraMap_eq_C c⟩⟩

/-- The `RatFunc k`-algebra structure on `F` induced by a transcendental element `x`, with
`RatFunc.X` acting as `x`. -/
@[instance_reducible]
noncomputable def ratFuncAlgebraOfTranscendental (hx : Transcendental k x) :
    Algebra (RatFunc k) F :=
  (k⟮x⟯.val.comp (RatFunc.algEquivOfTranscendental x hx).toAlgHom).toRingHom.toAlgebra

/-- The structure map of `ratFuncAlgebraOfTranscendental hx` is the embedding through `k(x)`. -/
theorem algebraMap_ratFuncAlgebraOfTranscendental_apply (hx : Transcendental k x)
    (r : RatFunc k) :
    letI := ratFuncAlgebraOfTranscendental hx
    algebraMap (RatFunc k) F r = ((RatFunc.algEquivOfTranscendental x hx r : k⟮x⟯) : F) := by
  let _ := ratFuncAlgebraOfTranscendental hx
  rw [RingHom.algebraMap_toAlgebra]
  rfl

/-- Under `ratFuncAlgebraOfTranscendental hx`, the rational-function variable maps to `x`. -/
@[simp]
theorem algebraMap_ratFuncAlgebraOfTranscendental_X (hx : Transcendental k x) :
    letI := ratFuncAlgebraOfTranscendental hx
    algebraMap (RatFunc k) F RatFunc.X = x := by
  let _ := ratFuncAlgebraOfTranscendental hx
  rw [algebraMap_ratFuncAlgebraOfTranscendental_apply,
    RatFunc.algEquivOfTranscendental_X]

/-- An injective `k`-algebra map `f : F → F'` carries the embedding `X ↦ x` of `k(X)` to the
embedding `X ↦ f x`. -/
theorem map_algebraMap_ratFuncAlgebraOfTranscendental {F' G : Type*} [Field F'] [Algebra k F']
    [FunLike G F F'] [AlgHomClass G k F F'] (f : G) (hf : Function.Injective f)
    (hx : Transcendental k x) (r : RatFunc k) :
    f (letI := ratFuncAlgebraOfTranscendental hx; algebraMap (RatFunc k) F r) =
      letI := ratFuncAlgebraOfTranscendental (hx.algHom f hf)
      algebraMap (RatFunc k) F' r := by
  have hy := hx.algHom f hf
  -- Both sides are `k`-algebra maps out of `k(X)` sending `X` to `f x`.
  have h : (AlgHom.ofClass f).comp
        (k⟮x⟯.val.comp (RatFunc.algEquivOfTranscendental x hx).toAlgHom) =
      k⟮f x⟯.val.comp (RatFunc.algEquivOfTranscendental (f x) hy).toAlgHom :=
    RatFunc.algHom_ext (by simp [RatFunc.algEquivOfTranscendental_X])
  rw [algebraMap_ratFuncAlgebraOfTranscendental_apply,
    algebraMap_ratFuncAlgebraOfTranscendental_apply]
  exact DFunLike.congr_fun h r

/-- The `RatFunc k`-algebra structure induced by `x` extends the given `k`-algebra structure. -/
theorem isScalarTower_ratFuncAlgebraOfTranscendental (hx : Transcendental k x) :
    letI := ratFuncAlgebraOfTranscendental hx
    IsScalarTower k (RatFunc k) F := by
  let _ := ratFuncAlgebraOfTranscendental hx
  exact .of_algebraMap_eq fun c ↦
    ((k⟮x⟯.val.comp (RatFunc.algEquivOfTranscendental x hx).toAlgHom).commutes c).symm

/-- Separability over `k(x)` transfers to the rational-function algebra structure induced by
`x`. -/
theorem isSeparable_ratFuncAlgebraOfTranscendental (hx : Transcendental k x)
    [Algebra.IsSeparable k⟮x⟯ F] :
    letI := ratFuncAlgebraOfTranscendental hx
    Algebra.IsSeparable (RatFunc k) F := by
  let _ := ratFuncAlgebraOfTranscendental hx
  -- Transport separability along the identification `k(X) ≃ k(x)`. Its compatibility condition
  -- reads, at an element `r` of `k(x)`, as `algebraMap (RatFunc k) F (e.symm r) = r` for
  -- `e := RatFunc.algEquivOfTranscendental x hx`, which is what the structure map computes.
  refine Algebra.IsSeparable.of_equiv_equiv
    (RatFunc.algEquivOfTranscendental x hx).symm.toRingEquiv (RingEquiv.refl F) ?_
  ext r
  rw [RingHom.comp_apply, RingHom.comp_apply, algebraMap_ratFuncAlgebraOfTranscendental_apply]
  simp

/-- **Every `k(X)`-algebra structure is induced by the image of `X`**: for a `k(X)`-algebra `F`
over `k`, with `x` the image of `X`, the structure map is the identification `k(X) ≃ k⟮x⟯`
followed by the inclusion of `k⟮x⟯` in `F`. -/
@[simp]
theorem coe_algEquivOfTranscendental_algebraMap_X_apply [Algebra (RatFunc k) F]
    [IsScalarTower k (RatFunc k) F] (r : RatFunc k) :
    ((RatFunc.algEquivOfTranscendental _
      ((transcendental_algebraMap_iff
        (FaithfulSMul.algebraMap_injective (RatFunc k) F)).mpr RatFunc.transcendental_X) r :
        k⟮algebraMap (RatFunc k) F RatFunc.X⟯) : F) =
      algebraMap (RatFunc k) F r := by
  -- Both maps send a polynomial `p` to `p(x)`, hence agree on fractions.
  have hp (p : k[X]) : algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) p) =
      Polynomial.aeval (algebraMap (RatFunc k) F RatFunc.X) p := by
    rw [Polynomial.aeval_algebraMap_apply, RatFunc.aeval_X_left_eq_algebraMap]
  rw [RatFunc.algEquivOfTranscendental_apply]
  conv_rhs => rw [← RatFunc.num_div_denom r]
  rw [map_div₀, hp, hp]

/-- **The image of `X` generates the image of `k(X)`**: for a `k(X)`-algebra `F` over `k`, the
degree of `F` over `k⟮x⟯`, with `x` the image of `X`, is its degree over `k(X)`. -/
theorem finrank_adjoin_algebraMap_X [Algebra (RatFunc k) F] [IsScalarTower k (RatFunc k) F] :
    Module.finrank k⟮algebraMap (RatFunc k) F RatFunc.X⟯ F = Module.finrank (RatFunc k) F := by
  have hx : Transcendental k (algebraMap (RatFunc k) F RatFunc.X) := (transcendental_algebraMap_iff
    (FaithfulSMul.algebraMap_injective (RatFunc k) F)).mpr RatFunc.transcendental_X
  refine (Algebra.finrank_eq_of_equiv_equiv (RatFunc.algEquivOfTranscendental _ hx).toRingEquiv
    (RingEquiv.refl F) (RingHom.ext fun r ↦ ?_)).symm
  exact coe_algEquivOfTranscendental_algebraMap_X_apply r

/-- **Separability over the image of `k(X)`**: for a `k(X)`-algebra `F` over `k`, with `x` the
image of `X`, `F` is separable over `k⟮x⟯` exactly when it is separable over `k(X)`. -/
theorem isSeparable_adjoin_algebraMap_X_iff [Algebra (RatFunc k) F]
    [IsScalarTower k (RatFunc k) F] :
    Algebra.IsSeparable k⟮algebraMap (RatFunc k) F RatFunc.X⟯ F ↔
      Algebra.IsSeparable (RatFunc k) F := by
  have hx : Transcendental k (algebraMap (RatFunc k) F RatFunc.X) := (transcendental_algebraMap_iff
    (FaithfulSMul.algebraMap_injective (RatFunc k) F)).mpr RatFunc.transcendental_X
  exact (Algebra.IsSeparable.iff_of_equiv_equiv (RatFunc.algEquivOfTranscendental _ hx).toRingEquiv
    (RingEquiv.refl F) (RingHom.ext coe_algEquivOfTranscendental_algebraMap_X_apply)).symm

section Polynomial

variable [Algebra (RatFunc k) F] [IsScalarTower k (RatFunc k) F] {q : k[X]}

/-- If the variable `t` of `k(t)` acts as `q(x)`, then `q` is not constant, since `t` is
transcendental over `k`. -/
theorem natDegree_pos_of_aeval_eq
    (hq : algebraMap (RatFunc k) F RatFunc.X = Polynomial.aeval x q) : 0 < q.natDegree := by
  refine Nat.pos_of_ne_zero fun h ↦ RatFunc.transcendental_X (K := k) ?_
  rw [Polynomial.eq_C_of_natDegree_eq_zero h, Polynomial.aeval_C,
    IsScalarTower.algebraMap_apply k (RatFunc k) F] at hq
  rw [(algebraMap (RatFunc k) F).injective hq]
  exact isAlgebraic_algebraMap _

/-- If the variable `t` of `k(t)` acts as `q(x)`, then `x` is transcendental over `k`, since
`t` is. -/
theorem transcendental_of_aeval_eq
    (hq : algebraMap (RatFunc k) F RatFunc.X = Polynomial.aeval x q) : Transcendental k x :=
  (transcendental_aeval_iff.mp (hq ▸
    (transcendental_algebraMap_iff (algebraMap (RatFunc k) F).injective).mpr
      RatFunc.transcendental_X)).1

/-- When `t = q(x)`, the element `x` is a root of the nonzero polynomial `q(X) - t` over
`k(t)`. -/
private theorem map_sub_C_ne_zero_and_aeval_eq_zero
    (hq : algebraMap (RatFunc k) F RatFunc.X = Polynomial.aeval x q) :
    q.map (algebraMap k (RatFunc k)) - Polynomial.C RatFunc.X ≠ 0 ∧
      Polynomial.aeval x (q.map (algebraMap k (RatFunc k)) - Polynomial.C RatFunc.X) = 0 := by
  have hdeg := natDegree_pos_of_aeval_eq hq
  refine ⟨fun h ↦ ?_, by
    rw [map_sub, Polynomial.aeval_map_algebraMap, Polynomial.aeval_C, ← hq, sub_self]⟩
  have hlt : (Polynomial.C (RatFunc.X : RatFunc k)).degree <
      (q.map (algebraMap k (RatFunc k))).degree := by
    rw [Polynomial.degree_map, Polynomial.degree_eq_natDegree (Polynomial.ne_zero_of_natDegree_gt
      hdeg)]
    exact Polynomial.degree_C_le.trans_lt (by exact_mod_cast hdeg)
  have := Polynomial.degree_sub_eq_left_of_degree_lt hlt
  rw [h, Polynomial.degree_zero] at this
  exact (bot_le.trans_lt hlt).ne' this.symm

/-- **`k(x)` is finite over `k(t)`** when `t = q(x)`: `x` is a root of the nonzero polynomial
`q(X) - t` over `k(t)`. -/
theorem finiteDimensional_of_aeval_eq (hx : k⟮x⟯ = ⊤)
    (hq : algebraMap (RatFunc k) F RatFunc.X = Polynomial.aeval x q) :
    FiniteDimensional (RatFunc k) F := by
  obtain ⟨h0, hroot⟩ := map_sub_C_ne_zero_and_aeval_eq_zero hq
  have := IntermediateField.adjoin.finiteDimensional (IsAlgebraic.isIntegral ⟨_, h0, hroot⟩)
  rw [IntermediateField.adjoin_eq_top_of_adjoin_eq_top k (E := RatFunc k) hx] at this
  exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional

/-- `k(x)` is separable over `k(t)` when `t = q(x)` and `q′ ≠ 0`: `x` is a simple root of
`q(X) - t`, since `q′(x) ≠ 0` for the transcendental `x`. -/
theorem isSeparable_of_aeval_eq (hx : k⟮x⟯ = ⊤)
    (hq : algebraMap (RatFunc k) F RatFunc.X = Polynomial.aeval x q)
    (hd : Polynomial.derivative q ≠ 0) : Algebra.IsSeparable (RatFunc k) F := by
  have hd' : Polynomial.aeval x (Polynomial.derivative
      (q.map (algebraMap k (RatFunc k)) - Polynomial.C RatFunc.X)) ≠ 0 := by
    rw [Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero, Polynomial.derivative_map,
      Polynomial.aeval_map_algebraMap]
    exact fun h ↦ transcendental_of_aeval_eq hq ⟨_, hd, h⟩
  exact (finiteDimensional_and_isSeparable_of_aeval_derivative_ne_zero
    (IntermediateField.adjoin_eq_top_of_adjoin_eq_top k hx)
    (map_sub_C_ne_zero_and_aeval_eq_zero hq).2 hd').2

end Polynomial

/-- The `k`-algebra map `k⟮x⟯ → E` sending a transcendental `x` to a transcendental `z`: both
`k⟮x⟯` and `k⟮z⟯` are identified with the rational function field `k(X)`. -/
noncomputable def _root_.Transcendental.algHomAdjoin (hx : Transcendental k x) {E : Type*}
    [Field E] [Algebra k E] {z : E} (hz : Transcendental k z) : k⟮x⟯ →ₐ[k] E :=
  (IntermediateField.val _).comp ((RatFunc.algEquivOfTranscendental z hz).toAlgHom.comp
    (RatFunc.algEquivOfTranscendental x hx).symm.toAlgHom)

@[simp]
theorem _root_.Transcendental.algHomAdjoin_gen (hx : Transcendental k x) {E : Type*} [Field E]
    [Algebra k E] {z : E} (hz : Transcendental k z) :
    hx.algHomAdjoin hz (IntermediateField.AdjoinSimple.gen k x) = z := by
  simp [Transcendental.algHomAdjoin]

/-- `k` is integrally closed in the field `k(x)` generated by an element `x` transcendental over
`k`: the elements of `k(x)` algebraic over `k` are the constants. -/
theorem _root_.Transcendental.isIntegrallyClosedIn_adjoin (hx : Transcendental k x) :
    IsIntegrallyClosedIn k k⟮x⟯ :=
  (RatFunc.algEquivOfTranscendental x hx).isIntegrallyClosedIn.mp isIntegrallyClosedIn_ratFunc

open scoped RatFunc in
/-- When `F` is already a `k[X]`-algebra in which `X` acts as `x`, the structure induced by `x` is
Mathlib's scoped `RatFunc.liftAlgebra`, the extension of the `k[X]`-action to fractions: the two
`k(X)`-algebra structures agree on `k[X]`, hence everywhere. This lets results stated for
`ratFuncAlgebraOfTranscendental` be read in the `RatFunc.liftAlgebra` structure. -/
theorem ratFuncAlgebraOfTranscendental_eq_liftAlgebra [Algebra k[X] F] [IsScalarTower k k[X] F]
    [FaithfulSMul k[X] F] (hx : Transcendental k x) (hX : algebraMap k[X] F Polynomial.X = x) :
    ratFuncAlgebraOfTranscendental hx = RatFunc.liftAlgebra k F := by
  subst hX
  refine Algebra.algebra_ext _ _ fun r ↦ ?_
  -- Both structure maps send a polynomial `p` to its image in `F`.
  have h := IsLocalization.ringHom_ext (nonZeroDivisors k[X])
    (j := @algebraMap (RatFunc k) F _ _ (ratFuncAlgebraOfTranscendental hx))
    (k := @algebraMap (RatFunc k) F _ _ (RatFunc.liftAlgebra k F)) <| RingHom.ext fun p ↦ by
      simp only [RingHom.comp_apply, algebraMap_ratFuncAlgebraOfTranscendental_apply,
        RatFunc.algEquivOfTranscendental_algebraMap,
        IntermediateField.AdjoinSimple.coe_aeval_gen_apply,
        ← IsScalarTower.algebraMap_apply k[X] (RatFunc k) F]
      rw [← IsScalarTower.coe_toAlgHom' k k[X] F, Polynomial.aeval_algHom_apply,
        Polynomial.aeval_X_left_apply]
  exact congrArg (· r) h

end TauCeti
