module

public import Mathlib.FieldTheory.RatFunc.IntermediateField

/-!
# Automorphisms of the rational function field are its generators

A `k`-algebra homomorphism out of `k(X)` is determined by the image of `X`, because `k(X)` is the
fraction field of `k[X]`. For an automorphism that image generates `k(X)` over `k`, and conversely
every generator is the image of `X` under an automorphism; a generator is automatically
transcendental. So the automorphisms of `k(X)` over `k` correspond to the generators of `k(X)`
over `k`.

This is the computational form of `Aut(k(x)/k)`, and the starting point for identifying it with
the group of linear fractional transformations: a generator is a quotient of polynomials of degree
at most one with nonzero determinant.

## Main definitions

* `RatFunc.algEquivOfAdjoinEqTop`: the automorphism of `k(X)` sending `X` to a given generator.
* `RatFunc.autEquivGenerator`: the resulting bijection between the automorphisms of `k(X)` over `k`
  and the generators of `k(X)` over `k`.

## Main results

* `RatFunc.algHom_ext` and `RatFunc.algEquiv_ext`: a `k`-algebra homomorphism, or automorphism, out
  of `k(X)` is determined by the image of `X`.
* `RatFunc.adjoin_apply_X_eq_top`: the image of `X` under an automorphism generates `k(X)`, and
  `RatFunc.transcendental_of_adjoin_eq_top`: a generator is transcendental.
* `RatFunc.transcendental_apply_X`: the image of `X` under an injective homomorphism is
  transcendental.

## Provenance

`algEquivOfAdjoinEqTop` composes Mathlib's `RatFunc.algEquivOfTranscendental`, which identifies
`k(X)` with `k⟮f⟯` for a transcendental `f`, with the identification of `k⟮f⟯ = ⊤` with `k(X)`.
Mathlib's `RatFunc.Luroth.algEquiv` composes those same two steps for an arbitrary nontrivial
intermediate field `E`, and `RatFunc.Luroth.algEquiv_X` evaluates it: it sends `X` to the generator
of `E` that Lüroth's theorem produces. What is specific here is that the generator is an arbitrary
given one and the intermediate field is all of `k(X)`, so the result is an automorphism, and that
the correspondence is packaged as the bijection `autEquivGenerator`.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Exercise 1.2.
-/

public section

namespace RatFunc

section AlgHom

variable {K : Type*} [CommRing K] [IsDomain K] {L : Type*} [Semiring L] [Algebra K L]

/-- **A homomorphism out of `k(X)` is determined by the image of `X`**: the polynomials `k[X]` are
generated by `X`, and `k(X)` is their fraction field. -/
@[ext]
theorem algHom_ext {σ τ : RatFunc K →ₐ[K] L} (h : σ X = τ X) : σ = τ :=
  IsLocalization.algHom_ext (nonZeroDivisors (Polynomial K))
    (Polynomial.algHom_ext (by
      simp only [AlgHom.comp_apply]
      exact h))

/-- **An automorphism of `k(X)` is determined by the image of `X`**, the `AlgEquiv` form of
`RatFunc.algHom_ext`. -/
@[ext]
theorem algEquiv_ext {σ τ : RatFunc K ≃ₐ[K] RatFunc K} (h : σ X = τ X) : σ = τ :=
  AlgEquiv.coe_toAlgHom_injective (algHom_ext (by simpa using h))

section Ring

variable {M : Type*} [Ring M] [Algebra K M]

/-- The image of `X` under an injective homomorphism is transcendental. -/
theorem transcendental_apply_X (σ : RatFunc K →ₐ[K] M) (hσ : Function.Injective σ) :
    Transcendental K (σ X) := fun h ↦ transcendental_X ((isAlgebraic_algHom_iff σ hσ).mp h)

end Ring

end AlgHom

variable {K : Type*} [Field K]

/-- **The image of `X` under an automorphism generates `k(X)`**: the image of `k⟮X⟯ = ⊤` under a
surjective map is everything. -/
theorem adjoin_apply_X_eq_top (σ : RatFunc K ≃ₐ[K] RatFunc K) :
    IntermediateField.adjoin K {σ X} = ⊤ := by
  have hmap : IntermediateField.adjoin K {σ X} =
      (IntermediateField.adjoin K {(X : RatFunc K)}).map (σ : RatFunc K →ₐ[K] RatFunc K) := by
    rw [IntermediateField.adjoin_map, Set.image_singleton]
    rfl
  rw [hmap, adjoin_X, ← AlgHom.fieldRange_eq_map, AlgEquiv.fieldRange_eq_top]

/-- **A generator of `k(X)` over `k` is transcendental**: otherwise the field it generates, which
is all of `k(X)`, would be algebraic over `k`, and `X` is not. -/
theorem transcendental_of_adjoin_eq_top {f : RatFunc K}
    (htop : IntermediateField.adjoin K {f} = ⊤) : Transcendental K f := fun halg ↦ by
  have hA : Algebra.IsAlgebraic K (IntermediateField.adjoin K {f}) :=
    IntermediateField.isAlgebraic_adjoin_simple (isAlgebraic_iff_isIntegral.mp halg)
  rw [htop] at hA
  have hX := hA.isAlgebraic (⟨X, IntermediateField.mem_top⟩ :
    (⊤ : IntermediateField K (RatFunc K)))
  exact transcendental_X (K := K) ((isAlgebraic_algHom_iff (IntermediateField.val ⊤)
    (IntermediateField.val ⊤).injective).mpr hX)

/-- **The automorphism of `k(X)` sending `X` to a generator `f`**: the identification of `k(X)`
with `k⟮f⟯ = ⊤`, which transcendence of `f` provides. -/
noncomputable def algEquivOfAdjoinEqTop {f : RatFunc K}
    (htop : IntermediateField.adjoin K {f} = ⊤) : RatFunc K ≃ₐ[K] RatFunc K :=
  (algEquivOfTranscendental f (transcendental_of_adjoin_eq_top htop)).trans
    ((IntermediateField.equivOfEq htop).trans IntermediateField.topEquiv)

/-- **The automorphism of a generator sends `X` to it**, which is what identifies the
automorphisms with the generators. -/
@[simp]
theorem algEquivOfAdjoinEqTop_X {f : RatFunc K}
    (htop : IntermediateField.adjoin K {f} = ⊤) : algEquivOfAdjoinEqTop htop X = f := by
  rw [algEquivOfAdjoinEqTop]
  simp [IntermediateField.equivOfEq_apply,
    algEquivOfTranscendental_X f (transcendental_of_adjoin_eq_top htop)]

/-- **The automorphisms of `k(X)` over `k` are its transcendental generators**: an automorphism
is determined by, and determines, the image of `X`. -/
noncomputable def autEquivGenerator : (RatFunc K ≃ₐ[K] RatFunc K) ≃
    {f : RatFunc K // IntermediateField.adjoin K {f} = ⊤} where
  toFun σ := ⟨σ X, adjoin_apply_X_eq_top σ⟩
  invFun f := algEquivOfAdjoinEqTop f.2
  left_inv σ := algEquiv_ext (by simp)
  right_inv f := Subtype.ext (algEquivOfAdjoinEqTop_X f.2)

@[simp]
theorem autEquivGenerator_apply (σ : RatFunc K ≃ₐ[K] RatFunc K) :
    (autEquivGenerator σ : RatFunc K) = σ X := by
  rfl

@[simp]
theorem autEquivGenerator_symm_apply
    (f : {f : RatFunc K // IntermediateField.adjoin K {f} = ⊤}) :
    autEquivGenerator.symm f = algEquivOfAdjoinEqTop f.2 := by
  rfl

end RatFunc
