module

public import Mathlib.FieldTheory.RatFunc.IntermediateField
import TauCeti.FieldTheory.IntermediateField.Adjoin.Transcendental

/-!
# Isomorphisms out of the rational function field are its generators

A `k`-algebra homomorphism out of `k(X)` is determined by the image of `X`, because `k(X)` is the
fraction field of `k[X]`. For an isomorphism `k(X) ≃ L` that image generates `L` over `k`, and
conversely, when `L / k` is transcendental, every generator of `L` over `k` is the image of `X`
under an isomorphism; such a generator is automatically transcendental. So the isomorphisms
`k(X) ≃ L` over `k` correspond to the generators of `L` over `k`, and in particular the
automorphisms of `k(X)` over `k` correspond to the generators of `k(X)` over `k`.

This is the computational form of `Aut(k(x)/k)`, and the starting point for identifying it with
the group of linear fractional transformations: a generator is a quotient of polynomials of degree
at most one with nonzero determinant.

## Main definitions

* `RatFunc.algEquivOfAdjoinEqTop`: the isomorphism `k(X) ≃ L` sending `X` to a given generator.
* `RatFunc.algEquivEquivGenerator`: the resulting bijection between the isomorphisms `k(X) ≃ L`
  over `k` and the generators of `L` over `k`.

## Main results

* `RatFunc.algHom_ext` and `RatFunc.algEquiv_ext`: a `k`-algebra homomorphism, or isomorphism, out
  of `k(X)` is determined by the image of `X`.
* `RatFunc.adjoin_apply_X_eq_top`: the image of `X` under an isomorphism generates the target.
* `RatFunc.transcendental_apply_X`: the image of `X` under an injective homomorphism is
  transcendental.

## Provenance

`algEquivOfAdjoinEqTop` composes Mathlib's `RatFunc.algEquivOfTranscendental`, which identifies
`k(X)` with `k⟮f⟯` for a transcendental `f`, with the identification of `k⟮f⟯ = ⊤` with `L`.
Mathlib's `RatFunc.Luroth.algEquiv` composes those same two steps for an arbitrary nontrivial
intermediate field `E`, and `RatFunc.Luroth.algEquiv_X` evaluates it: it sends `X` to the generator
of `E` that Lüroth's theorem produces. What is specific here is that the generator is an arbitrary
given generator of all of `L`, so the result is an isomorphism onto `L`, and that the
correspondence is packaged as the bijection `algEquivEquivGenerator`.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Exercise 1.2.
-/

public section

open scoped IntermediateField

namespace RatFunc

section AlgHom

variable {K : Type*} [CommRing K] [IsDomain K] {L : Type*} [Semiring L] [Algebra K L]

/-- **A homomorphism out of `k(X)` is determined by the image of `X`**: the polynomials `k[X]` are
generated by `X`, and `k(X)` is their fraction field. -/
@[ext]
theorem algHom_ext {σ τ : RatFunc K →ₐ[K] L} (h : σ X = τ X) : σ = τ :=
  IsLocalization.algHom_ext (nonZeroDivisors (Polynomial K)) (Polynomial.algHom_ext (by simpa))

/-- **An isomorphism out of `k(X)` is determined by the image of `X`**, the `AlgEquiv` form of
`RatFunc.algHom_ext`. -/
@[ext]
theorem algEquiv_ext {σ τ : RatFunc K ≃ₐ[K] L} (h : σ X = τ X) : σ = τ :=
  AlgEquiv.coe_toAlgHom_injective (algHom_ext h)

section Ring

variable {M : Type*} [Ring M] [Algebra K M]

/-- The image of `X` under an injective homomorphism is transcendental. -/
theorem transcendental_apply_X (σ : RatFunc K →ₐ[K] M) (hσ : Function.Injective σ) :
    Transcendental K (σ X) := fun h ↦ transcendental_X ((isAlgebraic_algHom_iff σ hσ).mp h)

end Ring

end AlgHom

variable {K : Type*} [Field K] {L : Type*} [Field L] [Algebra K L]

/-- **The image of `X` under an isomorphism generates the target**: the image of `k⟮X⟯ = ⊤` under
a surjective map is everything. -/
theorem adjoin_apply_X_eq_top (σ : RatFunc K ≃ₐ[K] L) : K⟮σ X⟯ = ⊤ := by
  rw [← Set.image_singleton, ← AlgEquiv.coe_toAlgHom, ← IntermediateField.adjoin_map, adjoin_X,
    ← AlgHom.fieldRange_eq_map, AlgEquiv.fieldRange_eq_top]

variable [Algebra.Transcendental K L]

/-- **The isomorphism `k(X) ≃ L` sending `X` to a generator `f` of `L`**: the identification of
`k(X)` with `k⟮f⟯ = ⊤`, which transcendence of `f` provides. -/
noncomputable def algEquivOfAdjoinEqTop {f : L} (htop : K⟮f⟯ = ⊤) : RatFunc K ≃ₐ[K] L :=
  (algEquivOfTranscendental f (TauCeti.transcendental_of_adjoin_simple_eq_top htop)).trans
    ((IntermediateField.equivOfEq htop).trans IntermediateField.topEquiv)

/-- **The isomorphism of a generator sends `X` to it**, which is what identifies the
isomorphisms with the generators. -/
@[simp]
theorem algEquivOfAdjoinEqTop_X {f : L} (htop : K⟮f⟯ = ⊤) : algEquivOfAdjoinEqTop htop X = f := by
  simp [algEquivOfAdjoinEqTop, IntermediateField.equivOfEq_apply]

variable (K L) in
/-- **The isomorphisms `k(X) ≃ L` over `k` are the generators of `L`**: an isomorphism is
determined by, and determines, the image of `X`. -/
noncomputable def algEquivEquivGenerator : (RatFunc K ≃ₐ[K] L) ≃ {f : L // K⟮f⟯ = ⊤} where
  toFun σ := ⟨σ X, adjoin_apply_X_eq_top σ⟩
  invFun f := algEquivOfAdjoinEqTop f.2
  left_inv σ := algEquiv_ext (by simp)
  right_inv f := Subtype.ext (algEquivOfAdjoinEqTop_X f.2)

@[simp]
theorem algEquivEquivGenerator_apply (σ : RatFunc K ≃ₐ[K] L) :
    (algEquivEquivGenerator K L σ : L) = σ X :=
  (rfl)

@[simp]
theorem algEquivEquivGenerator_symm_apply (f : {f : L // K⟮f⟯ = ⊤}) :
    (algEquivEquivGenerator K L).symm f = algEquivOfAdjoinEqTop f.2 :=
  (rfl)

end RatFunc
