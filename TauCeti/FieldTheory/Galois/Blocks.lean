module

public import Mathlib.GroupTheory.GroupAction.Primitive
public import Mathlib.FieldTheory.Galois.IsGaloisGroup
public import TauCeti.FieldTheory.Galois.FixedField

/-!
# Blocks inside a Galois orbit

For a finite group `G` acting as the Galois group of `L / K`,
the orbit of an element `x` is the set of its conjugates.
Blocks containing `x` inside this orbit correspond contravariantly to the intermediate fields
contained in `K⟮x⟯`. The forward map takes the fixed field of the setwise stabilizer; the inverse
map takes the orbit of `x` under the fixing subgroup of the intermediate field.

This formulation does not require a transitive action on a larger set of roots. In particular,
for the splitting field of a separable reducible polynomial, it applies separately to the orbit
of each root. The singleton block corresponds to `K⟮x⟯`, and the whole orbit to `K`. If `x` does
not lie in `K`, primitivity on its conjugates is equivalent to the absence of proper intermediate
fields in `K⟮x⟯ / K`.

The construction composes Mathlib's `MulAction.block_stabilizerOrderIso` with the Galois
correspondence `IsGaloisGroup.intermediateFieldEquivSubgroup`.

## References

* H. Wielandt, *Finite Permutation Groups*, Theorem 7.5.
* J. D. Dixon and B. Mortimer, *Permutation Groups*, Section 1.5.
-/

public section

namespace TauCeti

open scoped Pointwise

open IntermediateField MulAction

variable {G K L : Type*} [Group G] [Finite G] [Field K] [Field L] [Algebra K L]
  [MulSemiringAction G L] [IsGaloisGroup G K L]

/-- Identify the stabilizer interval with the dual of the image interval under the
Galois correspondence. -/
private noncomputable def orbitStabilizerOrderIsoDualIic (x : L) :
    Set.Ici (stabilizer G (⟨x, mem_orbit_self x⟩ : orbit G x)) ≃o
      (Set.Iic (IsGaloisGroup.intermediateFieldEquivSubgroup G K L K⟮x⟯))ᵒᵈ :=
  let hstab : stabilizer G (⟨x, mem_orbit_self x⟩ : orbit G x) =
      fixingSubgroup G (K⟮x⟯ : Set L) := by
    rw [TauCeti.IntermediateField.fixingSubgroup_coe_adjoin_simple]
    ext g
    rw [mem_stabilizer_iff, Subtype.ext_iff, orbit.coe_smul, mem_stabilizer_iff]
  { toFun := fun H ↦ OrderDual.toDual ⟨OrderDual.toDual H.1, hstab.symm.trans_le H.2⟩
    invFun := fun H ↦ ⟨(OrderDual.ofDual H).1.ofDual,
      hstab.trans_le (OrderDual.ofDual H).2⟩
    left_inv := fun _ ↦ rfl
    right_inv := fun _ ↦ rfl
    map_rel_iff' := Iff.rfl }

private theorem orbitStabilizerOrderIsoDualIic_apply (x : L)
    (H : Set.Ici (stabilizer G (⟨x, mem_orbit_self x⟩ : orbit G x))) :
    ((orbitStabilizerOrderIsoDualIic (K := K) x H).ofDual).1 =
      OrderDual.toDual H.1 := rfl

/-- Blocks through `x` in its Galois orbit are order anti-isomorphic to the intermediate fields
of the simple extension generated by `x`. The block lattice is taken on the orbit itself,
so this correspondence also applies when `x` is a root of a reducible polynomial. -/
noncomputable def orbitBlockIntermediateFieldOrderIso (G K : Type*) [Group G] [Finite G]
    [Field K] [Algebra K L] [MulSemiringAction G L] [IsGaloisGroup G K L] (x : L) :
    BlockMem G (⟨x, mem_orbit_self x⟩ : orbit G x) ≃o
      (Set.Iic K⟮x⟯)ᵒᵈ :=
  (block_stabilizerOrderIso G (⟨x, mem_orbit_self x⟩ : orbit G x)).trans
    ((orbitStabilizerOrderIsoDualIic (G := G) (K := K) x).trans
      ((IsGaloisGroup.intermediateFieldEquivSubgroup G K L).Iic K⟮x⟯).symm.dual)

/-- The field attached to a block is the fixed field of its setwise stabilizer. -/
theorem orbitBlockIntermediateFieldOrderIso_apply (x : L)
    (B : BlockMem G (⟨x, mem_orbit_self x⟩ : orbit G x)) :
    ((orbitBlockIntermediateFieldOrderIso G K x B).ofDual.1 : IntermediateField K L) =
      FixedPoints.intermediateField (stabilizer G (B : Set (orbit G x))) := by
  -- Mathlib's interval restriction preserves the inverse on underlying values.
  have hIic (y : Set.Iic (IsGaloisGroup.intermediateFieldEquivSubgroup G K L K⟮x⟯)) :
      (((IsGaloisGroup.intermediateFieldEquivSubgroup G K L).Iic K⟮x⟯).symm y).1 =
        (IsGaloisGroup.intermediateFieldEquivSubgroup G K L).symm y.1 := rfl
  -- Mathlib's block correspondence sends a block to its setwise stabilizer.
  have hblock : ((block_stabilizerOrderIso G
      (⟨x, mem_orbit_self x⟩ : orbit G x)) B).1 =
        stabilizer G (B : Set (orbit G x)) := rfl
  simp only [orbitBlockIntermediateFieldOrderIso, OrderIso.trans_apply,
    OrderIso.dual_apply, OrderDual.ofDual_toDual, hIic,
    orbitStabilizerOrderIsoDualIic_apply, hblock,
    IsGaloisGroup.intermediateFieldEquivSubgroup_symm_apply_toDual]

/-- Membership in the field attached to a block means fixedness under every element of its
setwise stabilizer. -/
@[simp]
theorem mem_orbitBlockIntermediateFieldOrderIso_apply_iff (x : L)
    (B : BlockMem G (⟨x, mem_orbit_self x⟩ : orbit G x)) (y : L) :
    y ∈ (orbitBlockIntermediateFieldOrderIso G K x B).ofDual.1 ↔
      ∀ g ∈ stabilizer G (B : Set (orbit G x)), g • y = y := by
  rw [orbitBlockIntermediateFieldOrderIso_apply, FixedPoints.mem_intermediateField_iff]
  exact ⟨fun h g hg ↦ h ⟨g, hg⟩, fun h g ↦ h g g.2⟩

/-- The block attached to `E ≤ K⟮x⟯` is the orbit of `x` under the automorphisms fixing `E`,
viewed inside the orbit of all its conjugates. -/
@[simp]
theorem coe_orbitBlockIntermediateFieldOrderIso_symm_apply (x : L) (E : Set.Iic K⟮x⟯) :
    (((orbitBlockIntermediateFieldOrderIso G K x).symm (OrderDual.toDual E)) :
      Set (orbit G x)) =
      orbit (fixingSubgroup G (E.1 : Set L)) (⟨x, mem_orbit_self x⟩ : orbit G x) := by
  let B := (orbitBlockIntermediateFieldOrderIso G K x).symm (OrderDual.toDual E)
  have hfield : FixedPoints.intermediateField (stabilizer G (B : Set (orbit G x))) = E.1 := by
    rw [← orbitBlockIntermediateFieldOrderIso_apply, OrderIso.apply_symm_apply,
      OrderDual.ofDual_toDual]
  have hstab : stabilizer G (B : Set (orbit G x)) = fixingSubgroup G (E.1 : Set L) := by
    rw [← hfield, IsGaloisGroup.fixingSubgroup_fixedPoints]
  rw [← hstab]
  exact (B.2.2.orbit_stabilizer_eq B.2.1).symm

/-- The block attached to an intermediate field consists of those conjugates that are roots of
`minpoly E x`. This describes the inverse correspondence by a polynomial over `E`. -/
theorem coe_orbitBlockIntermediateFieldOrderIso_symm_apply_eq_preimage_rootSet_minpoly
    (x : L) (E : Set.Iic K⟮x⟯) :
    (((orbitBlockIntermediateFieldOrderIso G K x).symm (OrderDual.toDual E)) :
      Set (orbit G x)) = Subtype.val ⁻¹' (minpoly E.1 x).rootSet L := by
  let H := fixingSubgroup G (E.1 : Set L)
  have := IsGaloisGroup.isGalois H E.1 L
  have := IsGaloisGroup.finiteDimensional H E.1 L
  let e := IsGaloisGroup.mulEquivCongr H Gal(L/E.1) E.1 L
  have horbit (y : orbit G x) :
      y ∈ orbit H (⟨x, mem_orbit_self x⟩ : orbit G x) ↔
        (y : L) ∈ orbit Gal(L/E.1) x := by
    constructor
    · rintro ⟨g, rfl⟩
      refine ⟨e g, ?_⟩
      simpa only [orbit.coe_smul, Subgroup.smul_def] using
        IsGaloisGroup.mulEquivCongr_apply_smul H Gal(L/E.1) E.1 L g x
    · rintro ⟨σ, hσ⟩
      obtain ⟨g, rfl⟩ := e.surjective σ
      refine ⟨g, Subtype.ext ?_⟩
      rw [← hσ]
      simpa only [orbit.coe_smul, Subgroup.smul_def] using
        (IsGaloisGroup.mulEquivCongr_apply_smul H Gal(L/E.1) E.1 L g x).symm
  rw [coe_orbitBlockIntermediateFieldOrderIso_symm_apply]
  ext y
  rw [horbit, Set.mem_preimage,
    Polynomial.mem_rootSet_of_ne (minpoly.ne_zero (IsIntegral.of_finite E.1 x)),
    ← minpoly.eq_iff_aeval_minpoly_eq_zero (IsIntegral.of_finite E.1 x), eq_comm,
    Normal.minpoly_eq_iff_mem_orbit L]

/-- The action on the conjugates of an element outside the base field is primitive exactly when
the simple extension it generates has no proper intermediate fields. The exclusion of the base
field is necessary: its elements have singleton orbits, while the bottom intermediate field is
not an atom. -/
theorem isPreprimitive_orbit_iff_isAtom_adjoin_simple (x : L) (hx : K⟮x⟯ ≠ ⊥) :
    IsPreprimitive G (orbit G x) ↔ IsAtom K⟮x⟯ := by
  have hnt : (orbit G x).Nontrivial := by
    rw [← Set.not_subsingleton_iff]
    intro hs
    have hstab : stabilizer G x = ⊤ := by
      apply eq_top_iff.mpr
      intro g _
      exact hs (mem_orbit _ _) (mem_orbit_self _)
    have hfix : fixingSubgroup G (K⟮x⟯ : Set L) = ⊤ := by
      rw [TauCeti.IntermediateField.fixingSubgroup_coe_adjoin_simple, hstab]
    apply hx
    apply (IsGaloisGroup.intermediateFieldEquivSubgroup G K L).injective
    simp [IsGaloisGroup.intermediateFieldEquivSubgroup_apply, hfix]
  let _ : Nontrivial (orbit G x) := hnt.coe_sort
  rw [← isSimpleOrder_blockMem_iff_isPreprimitive G
      (⟨x, mem_orbit_self x⟩ : orbit G x),
    (orbitBlockIntermediateFieldOrderIso G K x).isSimpleOrder_iff,
    ← isSimpleOrder_iff_isSimpleOrder_orderDual, Set.isSimpleOrder_Iic_iff_isAtom]

end TauCeti
