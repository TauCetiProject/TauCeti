/-!
# The discriminant square class and the discriminant root field

Let `L/K` be a finite separable field extension. The discriminant `Algebra.discr K b` of a
`K`-basis `b` of `L` is nonzero, and the discriminants of two bases differ by the square of the
determinant of the change-of-basis matrix. So the **discriminant square class**
`TauCeti.discriminantClass K L`, the class of `Algebra.discr K b` in `Kˣ ⧸ (Kˣ)²`, does not depend
on `b`. It is the invariant of `L/K` that the discriminant ideal of a ring of integers does not see:
over a local field, the discriminant ideal and the square class together determine the
discriminant of an integral basis up to the square of an integral unit.

The **discriminant root field** `TauCeti.discriminantRootField K L` is the intermediate field of
`AlgebraicClosure K / K` generated by the square roots of the discriminant. Any one square root of
any representative of the square class generates it, so it is `K` exactly when the discriminant is
a square in `K`, and a quadratic extension of `K` otherwise.

## Main definitions

* `TauCeti.discriminantClass K L`: the square class of the discriminant of any `K`-basis of `L`.
* `TauCeti.discriminantRootField K L`: the field `K(√disc)` inside `AlgebraicClosure K`.

## Main results

* `TauCeti.discriminantClass_eq` and `TauCeti.discriminantClass_eq_zero_iff`: the square class is
  that of the discriminant of an arbitrary basis.
* `TauCeti.discriminantClass_eq_of_algEquiv`, `TauCeti.discriminantClass_self`: invariance under
  `K`-algebra equivalence and the trivial extension.
* `TauCeti.discriminantClass_eq_squareClass_of_sq_eq`: for `L = K(√u)` quadratic, the square
  class is that of `u`.
* `TauCeti.discriminantRootField_eq_adjoin_simple` and
  `TauCeti.discriminantRootField_eq_adjoin_simple_of_basis`: the root field is generated by any
  square root of any representative; `TauCeti.discriminantRootField_eq_of_algEquiv`: invariance
  under `K`-algebra equivalence.
* `TauCeti.discriminantRootField_eq_bot_iff`, `TauCeti.finrank_discriminantRootField_eq_two_iff`
  and `TauCeti.discriminantRootField_eq_bot_or_finrank_eq_two`: the root field is `K` or a
  quadratic extension, according as the square class is trivial or not.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter I, §2 and Chapter III, §2.
* J. W. Jones and D. P. Roberts, *A database of local fields*, J. Symbolic Comput. 41 (2006),
  80–97 (arXiv:math/0309309).
-/

public section

open Module IntermediateField

namespace TauCeti

section Class

variable (K L : Type*) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]
  [Algebra.IsSeparable K L]

/-- The **discriminant square class** of a finite separable extension `L/K`: the class in
`Kˣ ⧸ (Kˣ)²` of the discriminant `Algebra.discr K b` of a `K`-basis `b` of `L`. The discriminant
is a unit because `L/K` is separable, and its class does not depend on the basis
(`TauCeti.discriminantClass_eq`); the definition uses `Module.finBasis K L`. -/
noncomputable def discriminantClass : SquareClassGroup K :=
  squareClass (Algebra.discr_isUnit_of_basis K (Module.finBasis K L)).unit

variable {K L}

/-- **The discriminant square class is independent of the basis**: it is the square class of the
discriminant of any `K`-basis of `L`. -/
theorem discriminantClass_eq {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι K L) :
    discriminantClass K L = squareClass (Algebra.discr_isUnit_of_basis K b).unit := by
  obtain ⟨u, hu⟩ := (Module.finBasis K L).exists_discr_eq_sq_mul_discr b
  have h : (Algebra.discr_isUnit_of_basis K b).unit =
      u ^ 2 * (Algebra.discr_isUnit_of_basis K (Module.finBasis K L)).unit :=
    Units.ext (by simpa using hu)
  rw [discriminantClass, h, squareClass_sq_mul]

/-- The discriminant square class is trivial exactly when the discriminant of some, equivalently
any, basis is a square in `K`. -/
theorem discriminantClass_eq_zero_iff {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι K L) :
    discriminantClass K L = 0 ↔ IsSquare (Algebra.discr K b) := by
  rw [discriminantClass_eq b, squareClass_eq_zero_iff, ← Units.isSquare_coe_iff,
    IsUnit.unit_spec]

/-- **The discriminant square class is invariant under `K`-algebra equivalence.** -/
theorem discriminantClass_eq_of_algEquiv {M : Type*} [Field M] [Algebra K M]
    [FiniteDimensional K M] [Algebra.IsSeparable K M] (e : L ≃ₐ[K] M) :
    discriminantClass K L = discriminantClass K M := by
  let b := Module.finBasis K L
  rw [discriminantClass_eq b, discriminantClass_eq (b.map e.toLinearEquiv)]
  congr 1
  have hb : ⇑(b.map e.toLinearEquiv) = e ∘ b := funext fun _ => by simp
  exact Units.ext (by simpa [hb] using Algebra.discr_eq_discr_of_algEquiv b e)

variable (K) in
/-- The trivial extension `K/K` has trivial discriminant square class: the basis `{1}` has
discriminant `1`. -/
@[simp]
theorem discriminantClass_self : discriminantClass K K = 0 := by
  rw [discriminantClass_eq_zero_iff (Basis.singleton Unit K)]
  exact ⟨1, by simp [Algebra.discr_def, Matrix.det_unique, Algebra.traceMatrix_apply]⟩

/-- **The discriminant square class of a quadratic extension `K(√u)/K`** is the square class of
`u`: the basis `{1, x}` with `x ^ 2 = u` and `x ∉ K` has discriminant `4 u`, and `2 ≠ 0` in `K`
because the discriminant of a separable extension is nonzero. -/
theorem discriminantClass_eq_squareClass_of_sq_eq (hfin : finrank K L = 2) {x : L} {u : Kˣ}
    (hx2 : x ^ 2 = algebraMap K L u) (hx : x ∉ Set.range (algebraMap K L)) :
    discriminantClass K L = squareClass u := by
  let b := quadraticExtensionBasis K L hx hfin
  have hb : ⇑b = ![1, x] := funext fun i => by fin_cases i <;> simp [b]
  have hd : Algebra.discr K b = 4 * u := by
    rw [hb]
    exact Algebra.discr_one_elem_eq_of_sq_algebraMap hfin hx2 (by simpa using hx)
  -- `4 u ≠ 0` because `L/K` is separable, so `4 u = 2 ^ 2 * u` with `2` a unit of `K`.
  have h2 : (2 : K) ≠ 0 := by
    intro h
    apply Algebra.discr_not_zero_of_basis K b
    rw [hd, show (4 : K) = 2 * 2 by norm_num, h, zero_mul, zero_mul]
  have hunit : (Algebra.discr_isUnit_of_basis K b).unit = Units.mk0 2 h2 ^ 2 * u :=
    Units.ext (by rw [IsUnit.unit_spec, hd]; push_cast; norm_num)
  rw [discriminantClass_eq b, hunit, squareClass_sq_mul]

end Class

section RootField

variable (K L : Type*) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]
  [Algebra.IsSeparable K L]

/-- The **discriminant root field** `K(√disc)` of a finite separable extension `L/K`: the
intermediate field of `AlgebraicClosure K / K` generated by the square roots of all
representatives of `TauCeti.discriminantClass K L`. A single square root of a single
representative already generates it (`TauCeti.discriminantRootField_eq_adjoin_simple`), so it
does not depend on the choice of a square root or of a basis. -/
noncomputable def discriminantRootField : IntermediateField K (AlgebraicClosure K) :=
  adjoin K {s | ∃ u : Kˣ, squareClass u = discriminantClass K L ∧
    s ^ 2 = algebraMap K (AlgebraicClosure K) u}

variable {K L}

/-- **The discriminant root field is generated by any square root of any representative** of the
discriminant square class. -/
theorem discriminantRootField_eq_adjoin_simple {u : Kˣ}
    (hu : squareClass u = discriminantClass K L) {s : AlgebraicClosure K}
    (hs : s ^ 2 = algebraMap K (AlgebraicClosure K) u) :
    discriminantRootField K L = K⟮s⟯ := by
  refine le_antisymm (adjoin_le_iff.mpr ?_)
    (adjoin_simple_le_iff.mpr (subset_adjoin _ _ ⟨u, hu, hs⟩))
  rintro t ⟨v, hv, ht⟩
  -- Two representatives `u`, `v` of one square class have square product `u v`.
  have huv : IsSquare ((u : K) * v) := by
    rw [← Units.val_mul, Units.isSquare_coe_iff, ← squareClass_eq_iff_isSquare_mul, hu, hv]
  exact IntermediateField.mem_adjoin_simple_of_isSquare_mul hs ht u.ne_zero huv

/-- **The discriminant root field is generated by a square root of the discriminant of any
basis.** -/
theorem discriminantRootField_eq_adjoin_simple_of_basis {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : Basis ι K L) {s : AlgebraicClosure K}
    (hs : s ^ 2 = algebraMap K (AlgebraicClosure K) (Algebra.discr K b)) :
    discriminantRootField K L = K⟮s⟯ :=
  discriminantRootField_eq_adjoin_simple (discriminantClass_eq b).symm (by simpa using hs)

/-- **The discriminant root field is invariant under `K`-algebra equivalence.** -/
theorem discriminantRootField_eq_of_algEquiv {M : Type*} [Field M] [Algebra K M]
    [FiniteDimensional K M] [Algebra.IsSeparable K M] (e : L ≃ₐ[K] M) :
    discriminantRootField K L = discriminantRootField K M := by
  rw [discriminantRootField, discriminantRootField, discriminantClass_eq_of_algEquiv e]

/-- A representative `u` of the discriminant square class together with a square root `s` of
`u` in `AlgebraicClosure K`. -/
private theorem exists_squareClass_eq_and_sq_eq :
    ∃ u : Kˣ, squareClass u = discriminantClass K L ∧
      ∃ s : AlgebraicClosure K, s ^ 2 = algebraMap K (AlgebraicClosure K) u :=
  ⟨_, squareClass_toMul_out (discriminantClass K L), IsAlgClosed.exists_pow_nat_eq _ two_pos⟩

/-- **The discriminant root field is `K` exactly when the discriminant square class is trivial**,
that is, when the discriminant is a square in `K`. -/
@[simp]
theorem discriminantRootField_eq_bot_iff :
    discriminantRootField K L = ⊥ ↔ discriminantClass K L = 0 := by
  obtain ⟨u, hu, s, hs⟩ := exists_squareClass_eq_and_sq_eq (K := K) (L := L)
  rw [discriminantRootField_eq_adjoin_simple hu hs,
    IntermediateField.adjoin_simple_eq_bot_iff_isSquare hs, ← hu, squareClass_eq_zero_iff,
    Units.isSquare_coe_iff]

/-- **The discriminant root field has degree two exactly when the discriminant square class is
nontrivial**: it is then generated by a square root of a nonsquare of `K`. -/
theorem finrank_discriminantRootField_eq_two_iff :
    finrank K (discriminantRootField K L) = 2 ↔ discriminantClass K L ≠ 0 := by
  obtain ⟨u, hu, s, hs⟩ := exists_squareClass_eq_and_sq_eq (K := K) (L := L)
  refine ⟨fun h h0 => ?_, fun h => ?_⟩
  · rw [(discriminantRootField_eq_bot_iff (K := K) (L := L)).mpr h0,
      IntermediateField.finrank_bot] at h
    exact absurd h (by decide)
  · rw [ne_eq, ← hu, squareClass_eq_zero_iff, ← Units.isSquare_coe_iff] at h
    rw [discriminantRootField_eq_adjoin_simple hu hs]
    exact IntermediateField.finrank_adjoin_simple_eq_two_of_not_isSquare hs h

/-- **The discriminant root field is `K` or a quadratic extension of `K`.** -/
theorem discriminantRootField_eq_bot_or_finrank_eq_two :
    discriminantRootField K L = ⊥ ∨ finrank K (discriminantRootField K L) = 2 := by
  rw [discriminantRootField_eq_bot_iff, finrank_discriminantRootField_eq_two_iff]
  exact em _

end RootField

end TauCeti
