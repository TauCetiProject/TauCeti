module

public import Mathlib.Algebra.Field.Defs
public import Mathlib.Basic.Finite.Defs
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.FieldTheory.ChevalleyWarning

/-!
# Values of an anisotropic binary quadratic form over a finite field

Let `K` be a finite field and let `a, b ∈ K` be such that `T² + a T − b` has no root in `K`. Then
the binary quadratic form `Y² + a X Y − b X²` is anisotropic: it vanishes only at `X = Y = 0`. Over
a finite field such a form still takes every value `c`, in every characteristic. Indeed, the ternary
form `Y² + a X Y − b X² − c Z²` has total degree `2 < 3`, so by the Chevalley–Warning theorem its
number of zeros is divisible by the characteristic of `K`; the zero `(0, 0, 0)` is therefore not
the only one, and anisotropy forces a second zero to have `Z ≠ 0`.

Equivalently, `Y² + a X Y − b X²` is the norm form of the quadratic extension of `K` generated by a
root of `T² − a T − b`, and the statement is the surjectivity of the norm of a finite field
extension. It supplies the points of the residue conics met when an elliptic curve with nonsplit
multiplicative reduction over a local field with finite residue field is shown to have points with
singular reduction.

## Main results

* `FiniteField.exists_sq_add_mul_mul_sub_mul_sq_eq`: if `T² + a T − b` has no root in the finite
  field `K`, then every `c ∈ K` is of the form `y² + a x y − b x²`.

## References

* [J.-P. Serre, *A Course in Arithmetic*][serre1973], I.2 (the Chevalley–Warning theorem and
  quadratic forms over finite fields).
-/

public section

namespace FiniteField

open MvPolynomial

variable {K : Type*} [Field K] [Finite K]

/-- **An anisotropic binary quadratic form over a finite field takes every value.** If the monic
quadratic `T² + a T − b` has no root in the finite field `K`, then every `c ∈ K` is of the form
`y² + a x y − b x²`. -/
theorem exists_sq_add_mul_mul_sub_mul_sq_eq {a b : K} (h : ∀ t : K, t ^ 2 + a * t - b ≠ 0)
    (c : K) : ∃ x y : K, y ^ 2 + a * x * y - b * x ^ 2 = c := by
  classical
  have := Fintype.ofFinite K
  -- the ternary form `Y² + a X Y − b X² − c Z²` in the variables `X = X 0`, `Y = X 1`, `Z = X 2`
  set f : MvPolynomial (Fin 3) K :=
    X 1 ^ 2 + C a * X 0 * X 1 - C b * X 0 ^ 2 - C c * X 2 ^ 2 with hf
  have heval (w : Fin 3 → K) :
      eval w f = w 1 ^ 2 + a * w 0 * w 1 - b * w 0 ^ 2 - c * w 2 ^ 2 := by
    simp [hf]
  have hdeg : f.totalDegree < Fintype.card (Fin 3) := by
    have hC (r : K) (p : MvPolynomial (Fin 3) K) (hp : p.totalDegree ≤ 2) :
        (C r * p).totalDegree ≤ 2 :=
      (totalDegree_mul _ _).trans (by simpa using hp)
    have h2 : f.totalDegree ≤ 2 := by
      refine (totalDegree_sub _ _).trans (max_le ((totalDegree_sub _ _).trans (max_le
        ((totalDegree_add _ _).trans (max_le (totalDegree_X_pow _ _).le ?_))
        (hC _ _ (totalDegree_X_pow _ _).le))) (hC _ _ (totalDegree_X_pow _ _).le))
      rw [mul_assoc]
      exact hC _ _ ((totalDegree_mul _ _).trans (by simp [totalDegree_X]))
    simpa using h2.trans_lt (by norm_num : 2 < 3)
  -- by Chevalley–Warning the characteristic divides the number of zeros of `f`
  have hp := CharP.char_is_prime K (ringChar K)
  have hdvd := char_dvd_card_solutions (ringChar K) hdeg
  set z : {w : Fin 3 → K // eval w f = 0} := ⟨0, by rw [heval]; simp⟩
  have hcard : 1 < Fintype.card {w : Fin 3 → K // eval w f = 0} :=
    hp.one_lt.trans_le (Nat.le_of_dvd (Fintype.card_pos_iff.2 ⟨z⟩) hdvd)
  -- so `f` has a zero `w ≠ 0`
  obtain ⟨⟨w, hw⟩, hwz⟩ := Fintype.exists_ne_of_one_lt_card hcard z
  have hw0 : w ≠ 0 := fun h0 ↦ hwz (Subtype.ext h0)
  rw [heval] at hw
  -- anisotropy forces `w 2 ≠ 0`
  have hw2 : w 2 ≠ 0 := by
    intro h2
    rw [h2] at hw
    by_cases h0 : w 0 = 0
    · rw [h0] at hw
      have h1 : w 1 = 0 := pow_eq_zero_iff two_ne_zero |>.1 (by linear_combination hw)
      exact hw0 (funext fun i ↦ by fin_cases i <;> simp [h0, h1, h2])
    · refine h (w 1 / w 0) ?_
      field_simp
      linear_combination hw
  exact ⟨w 0 / w 2, w 1 / w 2, by field_simp; linear_combination hw⟩

end FiniteField
