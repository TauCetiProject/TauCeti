module

public import Mathlib.Algebra.CharP.Two
public import TauCeti.FieldTheory.MilnorKTheory.Grading
import TauCeti.FieldTheory.Finite.Nonsquare

/-!
# Vanishing of Milnor K-theory of finite fields

Every Steinberg pairing on a finite field `F` vanishes (`IsSteinbergPairing.eq_zero_of_finite`),
hence `SymbolGroup F` is trivial (`SymbolGroup.subsingleton_of_finite`) and `MilnorK.degree F n`
vanishes for every `n ≥ 2` (`MilnorK.finiteField_vanishing`).

## References

* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. **9** (1970), Example 1.5.
* C. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Chapter III, Example 7.1.1.
-/

public section

namespace TauCeti

universe u

namespace IsSteinbergPairing

variable {F : Type*} [Field F] {A : Type*} [AddCommGroup A]

/-- On a field of characteristic `2` with cyclic unit group, every Steinberg pairing vanishes
identically. -/
theorem eq_zero_of_isCyclic_of_charTwo [CharP F 2] [IsCyclic Fˣ] {c : Fˣ → Fˣ → A}
    (hc : IsSteinbergPairing c) (a b : Fˣ) : c a b = 0 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Fˣ)
  obtain ⟨r, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
  obtain ⟨s, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
  rw [hc.map_zpow_left, hc.map_zpow_right, hc.map_self_eq_zero_of_charTwo g, smul_zero, smul_zero]

/-- On a field whose unit group is generated by `g`, if two odd powers of `g` sum to `1`, then
every Steinberg pairing vanishes identically. -/
theorem eq_zero_of_isCyclic_of_exists_odd_add_eq_one {c : Fˣ → Fˣ → A}
    (hc : IsSteinbergPairing c) {g : Fˣ} (hg : ∀ x : Fˣ, x ∈ Subgroup.zpowers g)
    {m n : ℤ} (hm : Odd m) (hn : Odd n) (hadd : ((g ^ m : Fˣ) : F) + (g ^ n : Fˣ) = 1)
    (a b : Fˣ) : c a b = 0 := by
  have hgg : c g g = 0 := by
    have hmn : (m * n) • c g g = 0 := by
      simpa [hc.map_zpow_left, hc.map_zpow_right, smul_smul] using hc.steinberg (g ^ m) (g ^ n) hadd
    have h2 : (2 : ℤ) • c g g = 0 := by rw [two_zsmul, ← two_nsmul]; exact hc.two_nsmul_map_self g
    obtain ⟨k, hk⟩ := hm.mul hn
    rwa [hk, add_zsmul, one_zsmul, mul_comm (2 : ℤ) k, mul_zsmul, h2, smul_zero, zero_add] at hmn
  obtain ⟨r, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
  obtain ⟨s, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
  rw [hc.map_zpow_left, hc.map_zpow_right, hgg, smul_zero, smul_zero]

/-- **Steinberg pairings on finite fields vanish**: every Steinberg pairing on a finite field is
identically zero. -/
theorem eq_zero_of_finite [Finite F] {c : Fˣ → Fˣ → A} (hc : IsSteinbergPairing c)
    (a b : Fˣ) : c a b = 0 := by
  by_cases hF : ringChar F = 2
  · have : CharP F 2 := ringChar.of_eq hF
    exact hc.eq_zero_of_isCyclic_of_charTwo a b
  · obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Fˣ)
    obtain ⟨x, hx, hx'⟩ := TauCeti.FiniteField.exists_not_isSquare_and_not_isSquare_one_sub hF
    have hx0 : x ≠ 0 := by rintro rfl; exact hx IsSquare.zero
    have hx1 : 1 - x ≠ 0 := by intro h; rw [h] at hx'; exact hx' IsSquare.zero
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hg (Units.mk0 x hx0))
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hg (Units.mk0 (1 - x) hx1))
    have hm_odd : Odd m := Int.not_even_iff_odd.mp fun heven =>
      hx (by simpa [hm] using (heven.isSquare_zpow g).map (Units.coeHom F))
    have hn_odd : Odd n := Int.not_even_iff_odd.mp fun heven =>
      hx' (by simpa [hn] using (heven.isSquare_zpow g).map (Units.coeHom F))
    have hadd : ((g ^ m : Fˣ) : F) + (g ^ n : Fˣ) = 1 := by
      rw [hm, hn]
      simp
    exact hc.eq_zero_of_isCyclic_of_exists_odd_add_eq_one hg hm_odd hn_odd hadd a b

end IsSteinbergPairing

namespace SymbolGroup

/-- The degree-two Steinberg symbol group `SymbolGroup F` of any finite field `F` is trivial. -/
instance subsingleton_of_finite (F : Type*) [Field F] [Finite F] : Subsingleton (SymbolGroup F) :=
  subsingleton_of_forall_eq 0 fun z => by
    induction z using SymbolGroup.induction_on with
    | symbol a b => exact (isSteinbergPairing_symbol (R := F)).eq_zero_of_finite a b
    | add _ _ hx hy => rw [hx, hy, add_zero]

end SymbolGroup

namespace MilnorK

variable {F : Type u} [Field F]

/-- Over a finite field, every degree-two product `ofUnit a * ofUnit b` vanishes in `MilnorK F`. -/
theorem ofUnit_mul_eq_zero_of_finite [Finite F] (a b : Fˣ) : ofUnit a * ofUnit b = 0 :=
  isSteinbergPairing_ofUnit_mul.eq_zero_of_finite a b

/-- Over a finite field, every Milnor symbol of length at least `2` vanishes. -/
theorem symbol_eq_zero_of_finite [Finite F] {l : List Fˣ} (hl : 2 ≤ l.length) : symbol l = 0 := by
  match l, hl with
  | a :: b :: _, _ =>
    rw [symbol_cons, symbol_cons, ← mul_assoc, ofUnit_mul_eq_zero_of_finite a b, zero_mul]

/-- Over a finite field, `MilnorK.degree F n` is the bottom submodule for every `n ≥ 2`. -/
theorem degree_eq_bot_of_finite (F : Type u) [Field F] [Finite F] (n : ℕ) (hn : 2 ≤ n) :
    degree F n = ⊥ := by
  rw [eq_bot_iff, degree_le_iff]
  exact fun _ hl => (Submodule.mem_bot ℤ).mpr (symbol_eq_zero_of_finite (hl.symm ▸ hn))

/-- **Milnor K-groups of finite fields vanish in every degree at least two**: `Kₙᴹ(F) = 0` for
every finite field `F` and every `n ≥ 2` (Milnor 1970, Example 1.5; Weibel, III.7.1.1). -/
theorem finiteField_vanishing (F : Type u) [Field F] [Finite F] (n : ℕ) (hn : 2 ≤ n) :
    Subsingleton (MilnorK.degree F n) := by rw [degree_eq_bot_of_finite F n hn]; infer_instance

end MilnorK

end TauCeti
