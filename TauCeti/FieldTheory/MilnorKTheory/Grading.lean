/-!
# Grading and low-degree identifications of Milnor K-theory

For a commutative semiring `R`, the Steinberg relation ideal in `TensorAlgebra ℤ (Additive Rˣ)`
is generated by homogeneous elements of degree `2`. Consequently it is a homogeneous two-sided
ideal whose degree-`n` slice equals the submodule spanned by products `x * (ι a * ι b) * y` of
total degree `n` (`TauCeti.MilnorK.mem_ker_quotient_and_mem_range_pow_iff`).

The images `TauCeti.MilnorK.degree R n` of the degree-`n` tensor-algebra submodules therefore form
an internal `ℕ`-grading of `TauCeti.MilnorK R`, giving a `GradedAlgebra (MilnorK.degree R)`
instance and a graded universal property `TauCeti.MilnorK.gradedLift`. Each graded piece is
identified with the `n`-th tensor power of `Additive Rˣ` modulo the degree-`n` Steinberg relations
(`TauCeti.MilnorK.degreeEquivQuotient`), yielding the canonical low-degree identifications:

* `TauCeti.MilnorK.degreeZeroEquiv`: `K₀ᴹ(R) ≃ₗ[ℤ] ℤ` (in particular `MilnorK R` is
  nontrivial);
* `TauCeti.MilnorK.degreeOneEquiv`: `K₁ᴹ(R) ≃ₗ[ℤ] Additive Rˣ` (in particular `ofUnit` is
  injective);
* `TauCeti.MilnorK.degreeTwoEquiv`: `K₂ᴹ(R) ≃ₗ[ℤ] SymbolGroup R`.

Finally, `TauCeti.MilnorK.map` preserves degrees, upgrading to a graded ring homomorphism
`TauCeti.MilnorK.gradedMap` and degreewise `ℤ`-linear maps `TauCeti.MilnorK.mapDegree` that are
natural with respect to all three low-degree identifications.

## References

* C. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Chapter III, §7.1.
* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. **9** (1970), 318–344.
-/

public section

open scoped DirectSum TensorProduct

namespace TauCeti.MilnorK

universe u v

variable {R : Type u} [CommSemiring R]

/-! ### Degree-`n` submodules -/

variable (R) in
/-- The degree-`n` Milnor K-group `Kₙᴹ(R)`, defined as the image of Mathlib's degree-`n`
tensor-algebra submodule `(TensorAlgebra.ι ℤ).range ^ n` under `MilnorK.quotient`. -/
def degree (n : ℕ) : Submodule ℤ (MilnorK R) :=
  Submodule.map (quotient R).toIntAlgHom.toLinearMap
    ((TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)).range ^ n)

/-- Unfolding lemma for `TauCeti.MilnorK.degree`. -/
theorem degree_def (R : Type u) [CommSemiring R] (n : ℕ) :
    degree R n = Submodule.map (quotient R).toIntAlgHom.toLinearMap
      ((TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)).range ^ n) := by
  rfl

@[simp]
theorem mem_degree_iff {n : ℕ} {x : MilnorK R} :
    x ∈ degree R n ↔
      ∃ t ∈ (LinearMap.range
        (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ n,
        quotient R t = x :=
  Submodule.mem_map

/-- The quotient map carries each degree-`n` tensor into `MilnorK.degree R n`. -/
theorem quotient_mem_degree {n : ℕ} {t : TensorAlgebra ℤ (Additive Rˣ)}
    (ht : t ∈ (LinearMap.range
      (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ n) :
    quotient R t ∈ degree R n :=
  mem_degree_iff.mpr ⟨t, ht, rfl⟩

/-- `1` has degree `0` in `MilnorK R`. -/
theorem one_mem_degree_zero : (1 : MilnorK R) ∈ degree R 0 := by
  have h1 : (1 : TensorAlgebra ℤ (Additive Rˣ)) ∈
      (LinearMap.range
        (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ 0 := by
    rw [pow_zero]
    exact Submodule.one_le.mp le_rfl
  rw [← map_one (quotient R)]
  exact quotient_mem_degree h1

/-- Every integer scalar has degree `0` in `MilnorK R`. -/
theorem intCast_mem_degree_zero (k : ℤ) : (k : MilnorK R) ∈ degree R 0 := by
  simpa only [zsmul_eq_mul, mul_one] using Submodule.smul_mem (degree R 0) k one_mem_degree_zero

/-- Every degree-one generator `ofUnit a` lies in `MilnorK.degree R 1`. -/
theorem ofUnit_mem_degree_one (a : Rˣ) : ofUnit a ∈ degree R 1 := by
  rw [ofUnit_def]
  exact quotient_mem_degree (by
    rw [pow_one]
    exact LinearMap.mem_range_self _ (Additive.ofMul a))

/-- Multiplication adds degrees in `MilnorK R`. -/
theorem mul_mem_degree {m n : ℕ} {x y : MilnorK R}
    (hx : x ∈ degree R m) (hy : y ∈ degree R n) :
    x * y ∈ degree R (m + n) := by
  obtain ⟨t₁, ht₁, rfl⟩ := mem_degree_iff.mp hx
  obtain ⟨t₂, ht₂, rfl⟩ := mem_degree_iff.mp hy
  rw [← map_mul]
  exact quotient_mem_degree (by
    rw [pow_add]
    exact Submodule.mul_mem_mul ht₁ ht₂)

/-- A Milnor symbol of length `l.length` lies in `MilnorK.degree R l.length`. -/
theorem symbol_mem_degree (l : List Rˣ) : symbol l ∈ degree R l.length := by
  induction l with
  | nil =>
    rw [symbol_nil]
    exact one_mem_degree_zero
  | cons a l ih =>
    rw [symbol_cons, List.length_cons, add_comm]
    exact mul_mem_degree (ofUnit_mem_degree_one a) ih

/-- A Milnor symbol of length `n` lies in `MilnorK.degree R n`. -/
theorem symbol_mem_degree_of_length {n : ℕ} {l : List Rˣ} (hl : l.length = n) :
    symbol l ∈ degree R n :=
  hl ▸ symbol_mem_degree l

/-- `MilnorK.degree R n` is spanned over `ℤ` by the Milnor symbols of length `n`. -/
theorem degree_eq_span (R : Type u) [CommSemiring R] (n : ℕ) :
    degree R n = Submodule.span ℤ {x | ∃ l : List Rˣ, l.length = n ∧ x = symbol l} := by
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · rintro _ ⟨t, ht, rfl⟩
    simp only [AlgHom.toLinearMap_apply, RingHom.toIntAlgHom_coe]
    induction ht using Submodule.pow_induction_on_left' with
    | algebraMap k =>
      have hk : quotient R (algebraMap ℤ (TensorAlgebra ℤ (Additive Rˣ)) k) =
          k • symbol ([] : List Rˣ) := by
        rw [eq_intCast (algebraMap ℤ (TensorAlgebra ℤ (Additive Rˣ))), map_intCast, symbol_nil,
          zsmul_eq_mul, mul_one]
      rw [hk]
      exact Submodule.smul_mem _ k (Submodule.subset_span ⟨[], rfl, rfl⟩)
    | add x y i _ _ ihx ihy =>
      rw [map_add]
      exact Submodule.add_mem _ ihx ihy
    | mem_mul m hm i t _ ih =>
      obtain ⟨u, rfl⟩ := hm
      rw [map_mul, quotient_ι]
      generalize quotient R t = q at ih ⊢
      induction ih using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨l, hl, rfl⟩ := hx
        rw [← symbol_cons]
        exact Submodule.subset_span ⟨Additive.toMul u :: l, by simp [hl], rfl⟩
      | zero =>
        rw [mul_zero]
        exact Submodule.zero_mem _
      | add x y _ _ hx hy =>
        rw [mul_add]
        exact Submodule.add_mem _ hx hy
      | smul k x _ hx =>
        rw [mul_smul_comm]
        exact Submodule.smul_mem _ k hx
  · rintro _ ⟨l, hl, rfl⟩
    exact symbol_mem_degree_of_length hl

/-- A submodule of `MilnorK R` contains `MilnorK.degree R n` if and only if it contains every
Milnor symbol of length `n`. -/
theorem degree_le_iff {n : ℕ} {S : Submodule ℤ (MilnorK R)} :
    degree R n ≤ S ↔ ∀ l : List Rˣ, l.length = n → symbol l ∈ S := by
  rw [degree_eq_span, Submodule.span_le]
  constructor
  · intro h l hl
    exact h ⟨l, hl, rfl⟩
  · rintro h _ ⟨l, hl, rfl⟩
    exact h l hl

/-- Two additive homomorphisms out of `MilnorK.degree R n` agree if they agree on all Milnor
symbols of length `n`. -/
theorem degree_addMonoidHom_ext {n : ℕ} {A : Type*} [AddCommGroup A] {f g : degree R n →+ A}
    (h : ∀ (l : List Rˣ) (hl : l.length = n),
      f ⟨symbol l, symbol_mem_degree_of_length hl⟩ =
        g ⟨symbol l, symbol_mem_degree_of_length hl⟩) :
    f = g := by
  apply AddMonoidHom.ext
  rintro ⟨x, hx⟩
  rw [degree_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨l, hl, rfl⟩ := hy
    exact h l hl
  | zero => exact (map_zero f).trans (map_zero g).symm
  | add y z hy hz ihy ihz =>
    have hy' : y ∈ degree R n := (degree_eq_span R n).symm ▸ hy
    have hz' : z ∈ degree R n := (degree_eq_span R n).symm ▸ hz
    have hadd : (⟨y + z, (degree_eq_span R n).symm ▸ Submodule.add_mem _ hy hz⟩ : degree R n) =
        ⟨y, hy'⟩ + ⟨z, hz'⟩ :=
      rfl
    rw [hadd, map_add, map_add, ihy, ihz]
  | smul k y hy ihy =>
    have hy' : y ∈ degree R n := (degree_eq_span R n).symm ▸ hy
    have hsmul : (⟨k • y, (degree_eq_span R n).symm ▸ Submodule.smul_mem _ k hy⟩ : degree R n) =
        k • ⟨y, hy'⟩ :=
      rfl
    rw [hsmul, map_zsmul, map_zsmul, ihy]

/-- Two `ℤ`-linear maps out of `MilnorK.degree R n` agree if they agree on all Milnor symbols of
length `n`. -/
theorem degree_linearMap_ext {n : ℕ} {A : Type*} [AddCommGroup A] {f g : degree R n →ₗ[ℤ] A}
    (h : ∀ (l : List Rˣ) (hl : l.length = n),
      f ⟨symbol l, symbol_mem_degree_of_length hl⟩ =
        g ⟨symbol l, symbol_mem_degree_of_length hl⟩) :
    f = g :=
  LinearMap.toAddMonoidHom_injective (degree_addMonoidHom_ext h)

/-! ### Homogeneity of the two-sided Steinberg ideal -/

variable (R) in
/-- The two-sided Steinberg ideal in `TensorAlgebra ℤ (Additive Rˣ)`, generated by the degree-two
products `ι(a) * ι(b)` with `(a : R) + b = 1`. -/
def milnorIdeal : TwoSidedIdeal (TensorAlgebra ℤ (Additive Rˣ)) :=
  TwoSidedIdeal.span {z | ∃ a b : Rˣ, (a : R) + b = 1 ∧
    z = TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b)}

/-- Unfolding lemma for `TauCeti.MilnorK.milnorIdeal`. -/
theorem milnorIdeal_def (R : Type u) [CommSemiring R] :
    milnorIdeal R = TwoSidedIdeal.span {z | ∃ a b : Rˣ, (a : R) + b = 1 ∧
      z = TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b)} := by
  rfl

/-- The kernel of `MilnorK.quotient R` is the two-sided Steinberg ideal. -/
theorem ker_quotient_eq_milnorIdeal (R : Type u) [CommSemiring R] :
    RingHom.ker (quotient R) = (milnorIdeal R).asIdeal := by
  rw [RingQuot.ker_mkRingHom_eq_span, milnorIdeal]
  congr 2
  ext z
  constructor
  · rintro ⟨x, y, hxy, rfl⟩
    obtain ⟨a, b, hab, rfl, rfl⟩ := milnorRel_iff.mp hxy
    exact ⟨a, b, hab, by rw [sub_zero]⟩
  · rintro ⟨a, b, hab, rfl⟩
    exact ⟨_, 0, milnorRel_iff.mpr ⟨a, b, hab, rfl, rfl⟩, (sub_zero _).symm⟩

/-- The kernel of `MilnorK.quotient R` is homogeneous for Mathlib's `ℕ`-grading of the tensor
algebra. -/
theorem isHomogeneous_ker_quotient (R : Type u) [CommSemiring R] :
    (RingHom.ker (quotient R)).IsHomogeneous
      ((LinearMap.range
        (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)) ^ ·) :
        ℕ → Submodule ℤ _) := by
  rw [ker_quotient_eq_milnorIdeal]
  apply TwoSidedIdeal.homogeneous_span
  rintro _ ⟨a, b, -, rfl⟩
  refine ⟨2, ?_⟩
  dsimp only
  rw [sq]
  exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _)

variable (R) in
/-- The degree-`n` Steinberg relation submodule `Rₙ` in `TensorAlgebra ℤ (Additive Rˣ)`, spanned
by all homogeneous products `x * (ι(a) * ι(b)) * y` of total degree `i + 2 + j = n`. -/
def milnorRelPiece (n : ℕ) : Submodule ℤ (TensorAlgebra ℤ (Additive Rˣ)) :=
  Submodule.span ℤ {z | ∃ (i j : ℕ) (x y : TensorAlgebra ℤ (Additive Rˣ)) (a b : Rˣ),
    i + 2 + j = n ∧
    x ∈ (LinearMap.range
      (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ i ∧
    y ∈ (LinearMap.range
      (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ j ∧
    (a : R) + b = 1 ∧
    z = x * (TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b)) * y}

/-- Unfolding lemma for `TauCeti.MilnorK.milnorRelPiece`. -/
theorem milnorRelPiece_def (R : Type u) [CommSemiring R] (n : ℕ) :
    milnorRelPiece R n =
      Submodule.span ℤ {z | ∃ (i j : ℕ) (x y : TensorAlgebra ℤ (Additive Rˣ)) (a b : Rˣ),
        i + 2 + j = n ∧
        x ∈ (LinearMap.range
          (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ i ∧
        y ∈ (LinearMap.range
          (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ j ∧
        (a : R) + b = 1 ∧
        z = x *
          (TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b)) * y} := by
  rfl

/-- Every element of `milnorRelPiece R n` lies in the degree-`n` piece `(ι ℤ).range ^ n`. -/
theorem milnorRelPiece_le_range_pow (R : Type u) [CommSemiring R] (n : ℕ) :
    milnorRelPiece R n ≤
      (LinearMap.range
        (TensorAlgebra.ι ℤ :
          Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ n := by
  rw [milnorRelPiece, Submodule.span_le]
  rintro _ ⟨i, j, x, y, a, b, rfl, hx, hy, -, rfl⟩
  have hab : TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b) ∈
      (LinearMap.range
        (TensorAlgebra.ι ℤ :
          Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ 2 := by
    rw [sq]
    exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _)
  rw [pow_add, pow_add]
  exact Submodule.mul_mem_mul (Submodule.mul_mem_mul hx hab) hy

/-- **Homogeneous slice of the Steinberg ideal**: a degree-`n` tensor lies in the kernel of
`MilnorK.quotient R` if and only if it belongs to `milnorRelPiece R n` (`J ∩ Tₙ = Rₙ`). -/
theorem mem_ker_quotient_and_mem_range_pow_iff {n : ℕ} {z : TensorAlgebra ℤ (Additive Rˣ)} :
    (z ∈ RingHom.ker (quotient R) ∧
      z ∈ (LinearMap.range
        (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ))) ^ n) ↔
      z ∈ milnorRelPiece R n := by
  classical
  let 𝒯 : ℕ → Submodule ℤ (TensorAlgebra ℤ (Additive Rˣ)) :=
    (LinearMap.range
      (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)) ^ ·)
  constructor
  · rintro ⟨hzker, hzdeg⟩
    let H : AddSubgroup (TensorAlgebra ℤ (Additive Rˣ)) :=
      (milnorRelPiece R n).toAddSubgroup.comap (GradedRing.proj 𝒯 n)
    have hsub : (milnorIdeal R : Set (TensorAlgebra ℤ (Additive Rˣ))) ⊆ H := by
      rw [milnorIdeal, TauCeti.TwoSidedIdeal.coe_span_subset_addSubgroup_iff]
      rintro x _ ⟨a, b, hab, rfl⟩ y
      rw [AddSubgroup.mem_comap, Submodule.mem_toAddSubgroup]
      have hxsum : x = ∑ i ∈ (DirectSum.decompose 𝒯 x).support,
          (DirectSum.decompose 𝒯 x i : TensorAlgebra ℤ (Additive Rˣ)) :=
        (DirectSum.sum_support_decompose 𝒯 x).symm
      have hysum : y = ∑ j ∈ (DirectSum.decompose 𝒯 y).support,
          (DirectSum.decompose 𝒯 y j : TensorAlgebra ℤ (Additive Rˣ)) :=
        (DirectSum.sum_support_decompose 𝒯 y).symm
      rw [hxsum, hysum, Finset.sum_mul, Finset.sum_mul, map_sum]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [Finset.mul_sum, map_sum]
      refine Submodule.sum_mem _ fun j _ => ?_
      have hmem : (DirectSum.decompose 𝒯 x i : TensorAlgebra ℤ (Additive Rˣ)) *
            (TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b)) *
            (DirectSum.decompose 𝒯 y j : TensorAlgebra ℤ (Additive Rˣ)) ∈
          𝒯 (i + 2 + j) := by
        have h2 :
            TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b) ∈
              𝒯 2 := by
          dsimp only [𝒯]
          rw [sq]
          exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _)
        exact SetLike.mul_mem_graded
          (SetLike.mul_mem_graded (SetLike.coe_mem _) h2) (SetLike.coe_mem _)
      rw [GradedRing.proj_apply, DirectSum.decompose_of_mem 𝒯 hmem]
      by_cases hdeg : i + 2 + j = n
      · subst hdeg
        rw [DirectSum.of_eq_same]
        exact Submodule.subset_span
          ⟨i, j, _, _, a, b, rfl, SetLike.coe_mem _, SetLike.coe_mem _, hab, rfl⟩
      · rw [DirectSum.of_eq_of_ne _ _ _ (Ne.symm hdeg)]
        exact Submodule.zero_mem _
    have hzideal : z ∈ (milnorIdeal R : Set (TensorAlgebra ℤ (Additive Rˣ))) := by
      rw [ker_quotient_eq_milnorIdeal R] at hzker
      exact TwoSidedIdeal.mem_asIdeal.mp hzker
    have hproj_z : GradedRing.proj 𝒯 n z ∈ milnorRelPiece R n := hsub hzideal
    rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒯 hzdeg] at hproj_z
    exact hproj_z
  · intro hz
    refine ⟨?_, milnorRelPiece_le_range_pow R n hz⟩
    rw [milnorRelPiece] at hz
    induction hz using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨i, j, x, y, a, b, -, -, -, hab, rfl⟩ := hw
      rw [RingHom.mem_ker, map_mul, map_mul, map_mul, quotient_ι, quotient_ι,
        toMul_ofMul, toMul_ofMul, ofUnit_mul_ofUnit_eq_zero hab, mul_zero, zero_mul]
    | zero => exact Ideal.zero_mem _
    | add _ _ _ _ hx hy => exact Ideal.add_mem _ hx hy
    | smul k _ _ hx => exact zsmul_mem hx k

/-- There are no Steinberg relations in degree `0`. -/
@[simp]
theorem milnorRelPiece_zero (R : Type u) [CommSemiring R] : milnorRelPiece R 0 = ⊥ := by
  rw [eq_bot_iff, milnorRelPiece, Submodule.span_le]
  rintro _ ⟨i, j, -, -, -, -, hij, -, -, -, -⟩
  omega

/-- There are no Steinberg relations in degree `1`. -/
@[simp]
theorem milnorRelPiece_one (R : Type u) [CommSemiring R] : milnorRelPiece R 1 = ⊥ := by
  rw [eq_bot_iff, milnorRelPiece, Submodule.span_le]
  rintro _ ⟨i, j, -, -, -, -, hij, -, -, -, -⟩
  omega

/-- In degree `2`, `milnorRelPiece R 2` is spanned by the elementary Steinberg products
`ι(a) * ι(b)` with `(a : R) + b = 1`. -/
theorem milnorRelPiece_two (R : Type u) [CommSemiring R] :
    milnorRelPiece R 2 = Submodule.span ℤ {z | ∃ a b : Rˣ, (a : R) + b = 1 ∧
      z = TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b)} := by
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · rw [milnorRelPiece, Submodule.span_le]
    rintro _ ⟨i, j, x, y, a, b, hij, hx, hy, hab, rfl⟩
    have hi : i = 0 := by omega
    have hj : j = 0 := by omega
    subst hi hj
    rw [pow_zero, Submodule.one_eq_range] at hx hy
    obtain ⟨m, rfl⟩ := hx
    obtain ⟨k, rfl⟩ := hy
    have hmk : Algebra.linearMap ℤ (TensorAlgebra ℤ (Additive Rˣ)) m *
        (TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b)) *
        Algebra.linearMap ℤ (TensorAlgebra ℤ (Additive Rˣ)) k =
        (m * k) • (TensorAlgebra.ι ℤ (Additive.ofMul a) *
          TensorAlgebra.ι ℤ (Additive.ofMul b)) := by
      simp only [Algebra.linearMap_apply, Algebra.algebraMap_eq_smul_one, smul_mul_assoc,
        mul_smul_comm, one_mul, mul_one, smul_smul, mul_comm m k]
    rw [hmk]
    exact Submodule.smul_mem _ (m * k) (Submodule.subset_span ⟨a, b, hab, rfl⟩)
  · rintro _ ⟨a, b, hab, rfl⟩
    refine Submodule.subset_span ⟨0, 0, 1, 1, a, b, rfl, ?_, ?_, hab, by simp⟩
    · rw [pow_zero]; exact Submodule.one_le.mp le_rfl
    · rw [pow_zero]; exact Submodule.one_le.mp le_rfl

variable (R) in
/-- The degree-`n` Steinberg relation submodule inside the `n`-th tensor power
`⨂[ℤ]^n (Additive Rˣ)`. -/
noncomputable def milnorTensorRel (n : ℕ) : Submodule ℤ (TensorPower ℤ n (Additive Rˣ)) :=
  (milnorRelPiece R n).map (TensorAlgebra.tensorPowerProjection n)

/-- Unfolding lemma for `TauCeti.MilnorK.milnorTensorRel`. -/
theorem milnorTensorRel_def (R : Type u) [CommSemiring R] (n : ℕ) :
    milnorTensorRel R n = (milnorRelPiece R n).map (TensorAlgebra.tensorPowerProjection n) := by
  rfl

@[simp]
theorem milnorTensorRel_zero (R : Type u) [CommSemiring R] : milnorTensorRel R 0 = ⊥ := by
  simp [milnorTensorRel]

@[simp]
theorem milnorTensorRel_one (R : Type u) [CommSemiring R] : milnorTensorRel R 1 = ⊥ := by
  simp [milnorTensorRel]

/-- In degree `2`, `milnorTensorRel R 2` is spanned by the pure Steinberg tensors
`tprod ![ofMul a, ofMul b]` with `(a : R) + b = 1`. -/
theorem milnorTensorRel_two (R : Type u) [CommSemiring R] :
    milnorTensorRel R 2 = Submodule.span ℤ {z | ∃ a b : Rˣ, (a : R) + b = 1 ∧
      z = PiTensorProduct.tprod ℤ ![Additive.ofMul a, Additive.ofMul b]} := by
  rw [milnorTensorRel, milnorRelPiece_two, Submodule.map_span]
  congr 1
  ext z
  constructor
  · rintro ⟨_, ⟨a, b, hab, rfl⟩, rfl⟩
    refine ⟨a, b, hab, ?_⟩
    have htprod :
        TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b) =
          TensorAlgebra.tprod ℤ (Additive Rˣ) 2 ![Additive.ofMul a, Additive.ofMul b] := by
      simp [TensorAlgebra.tprod_apply]
    rw [htprod, TensorAlgebra.tensorPowerProjection_tprod_self]
  · rintro ⟨a, b, hab, rfl⟩
    refine ⟨TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b),
      ⟨a, b, hab, rfl⟩, ?_⟩
    have htprod :
        TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b) =
          TensorAlgebra.tprod ℤ (Additive Rˣ) 2 ![Additive.ofMul a, Additive.ofMul b] := by
      simp [TensorAlgebra.tprod_apply]
    rw [htprod, TensorAlgebra.tensorPowerProjection_tprod_self]

/-- Every element in the kernel of `MilnorK.quotient R` projects in degree `n` into
`milnorTensorRel R n`. -/
theorem tensorPowerProjection_mem_milnorTensorRel_of_mem_ker {n : ℕ}
    {z : TensorAlgebra ℤ (Additive Rˣ)} (hz : z ∈ RingHom.ker (quotient R)) :
    TensorAlgebra.tensorPowerProjection n z ∈ milnorTensorRel R n := by
  let 𝒯 : ℕ → Submodule ℤ (TensorAlgebra ℤ (Additive Rˣ)) :=
    (LinearMap.range
      (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)) ^ ·)
  rw [← TensorAlgebra.tensorPowerProjection_decompose n z]
  refine Submodule.mem_map_of_mem ?_
  exact (mem_ker_quotient_and_mem_range_pow_iff).mp
    ⟨isHomogeneous_ker_quotient R n hz, SetLike.coe_mem (DirectSum.decompose 𝒯 z n)⟩

/-! ### Internal `ℕ`-grading and graded universal property -/

/-- The degree pieces `MilnorK.degree R` form an internal direct sum decomposition of
`MilnorK R`. -/
theorem isInternal_degree (R : Type u) [CommSemiring R] : DirectSum.IsInternal (degree R) :=
  TauCeti.GradedAlgebra.isInternal_map
    ((LinearMap.range
      (TensorAlgebra.ι ℤ : Additive Rˣ →ₗ[ℤ] TensorAlgebra ℤ (Additive Rˣ)) ^ ·) :
      ℕ → Submodule ℤ _)
    (quotient R).toIntAlgHom (quotient_surjective R) (isHomogeneous_ker_quotient R)

/-- Multiplication adds degrees in `MilnorK R`. -/
instance : SetLike.GradedMonoid (degree R) where
  one_mem := one_mem_degree_zero
  mul_mem _ _ _ _ hx hy := mul_mem_degree hx hy

/-- `MilnorK R` is internally `ℕ`-graded by `MilnorK.degree R`. -/
noncomputable instance : GradedAlgebra (degree R) :=
  (isInternal_degree R).gradedAlgebra

variable (R) in
/-- **Graded universal property of `MilnorK R`**: an additive homomorphism `f : Additive Rˣ →+ A`
landing in the degree-`1` piece `ℬ 1` of a graded ring and satisfying the Steinberg relation
extends uniquely to a graded ring homomorphism `MilnorK.degree R →+*ᵍ ℬ`. -/
def gradedLift {A τ : Type*} [Ring A] [SetLike τ A] [AddSubgroupClass τ A]
    (ℬ : ℕ → τ) [SetLike.GradedMonoid ℬ]
    (f : Additive Rˣ →+ A)
    (hdeg : ∀ a : Rˣ, f (Additive.ofMul a) ∈ ℬ 1)
    (hf : ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0) :
    degree R →+*ᵍ ℬ where
  toRingHom := lift R f hf
  map_mem {n x} hx := by
    rw [degree_eq_span] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l, rfl, rfl⟩ := hy
      rw [lift_symbol]
      induction l with
      | nil => exact SetLike.one_mem_graded ℬ
      | cons a l ih =>
        rw [List.map_cons, List.prod_cons, List.length_cons, add_comm]
        exact SetLike.mul_mem_graded (hdeg a) ih
    | zero =>
      rw [map_zero]
      exact zero_mem (ℬ n)
    | add y z _ _ hy hz =>
      rw [map_add]
      exact add_mem hy hz
    | smul k y _ hy =>
      rw [map_zsmul]
      exact zsmul_mem hy k

@[simp]
theorem gradedLift_toRingHom {A τ : Type*} [Ring A] [SetLike τ A] [AddSubgroupClass τ A]
    (ℬ : ℕ → τ) [SetLike.GradedMonoid ℬ]
    (f : Additive Rˣ →+ A)
    (hdeg : ∀ a : Rˣ, f (Additive.ofMul a) ∈ ℬ 1)
    (hf : ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0) :
    (gradedLift R ℬ f hdeg hf).toRingHom = lift R f hf := by
  rfl

@[simp]
theorem gradedLift_apply {A τ : Type*} [Ring A] [SetLike τ A] [AddSubgroupClass τ A]
    (ℬ : ℕ → τ) [SetLike.GradedMonoid ℬ]
    (f : Additive Rˣ →+ A)
    (hdeg : ∀ a : Rˣ, f (Additive.ofMul a) ∈ ℬ 1)
    (hf : ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0)
    (x : MilnorK R) :
    gradedLift R ℬ f hdeg hf x = lift R f hf x := by
  rfl

/-- Two graded ring homomorphisms out of `MilnorK.degree R` agree when they agree on degree-one
unit classes. -/
@[ext 1200]
theorem gradedHom_ext {A τ : Type*} [Ring A] [SetLike τ A]
    {ℬ : ℕ → τ} {φ ψ : degree R →+*ᵍ ℬ}
    (h : ∀ a : Rˣ, φ (ofUnit a) = ψ (ofUnit a)) : φ = ψ := by
  have hring : φ.toRingHom = ψ.toRingHom := ringHom_ext h
  exact GradedRingHom.ext fun x => RingHom.congr_fun hring x

/-- Uniqueness of the graded ring homomorphism extending a degree-one Steinberg assignment. -/
theorem gradedLift_unique {A τ : Type*} [Ring A] [SetLike τ A] [AddSubgroupClass τ A]
    (ℬ : ℕ → τ) [SetLike.GradedMonoid ℬ]
    (f : Additive Rˣ →+ A)
    (hdeg : ∀ a : Rˣ, f (Additive.ofMul a) ∈ ℬ 1)
    (hf : ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0)
    (φ : degree R →+*ᵍ ℬ) (hφ : ∀ a : Rˣ, φ (ofUnit a) = f (Additive.ofMul a)) :
    φ = gradedLift R ℬ f hdeg hf :=
  gradedHom_ext fun a => (hφ a).trans (lift_ofUnit f hf a).symm

/-! ### Degree-`n` quotient presentation and low-degree equivalences -/

/-- Canonical surjective `ℤ`-linear map from the `n`-th tensor power `⨂[ℤ]^n (Additive Rˣ)`
onto `MilnorK.degree R n`. -/
noncomputable def tensorPowerToDegree (R : Type u) [CommSemiring R] (n : ℕ) :
    TensorPower ℤ n (Additive Rˣ) →ₗ[ℤ] degree R n :=
  ((quotient R).toIntAlgHom.toLinearMap.comp TensorPower.toTensorAlgebra).codRestrict
    (degree R n) fun x => quotient_mem_degree (TensorAlgebra.toTensorAlgebra_mem_range_ι_pow x)

/-- Unfolding lemma for `TauCeti.MilnorK.tensorPowerToDegree`. -/
theorem tensorPowerToDegree_coe (n : ℕ) (x : TensorPower ℤ n (Additive Rˣ)) :
    (tensorPowerToDegree R n x : MilnorK R) = quotient R (TensorPower.toTensorAlgebra x) := by
  rfl

@[simp]
theorem tensorPowerToDegree_tprod (n : ℕ) (v : Fin n → Additive Rˣ) :
    (tensorPowerToDegree R n (PiTensorProduct.tprod ℤ v) : MilnorK R) =
      symbol (List.ofFn fun i => Additive.toMul (v i)) := by
  rw [tensorPowerToDegree_coe, TensorPower.toTensorAlgebra_tprod, quotient_tprod]

theorem tensorPowerToDegree_surjective (R : Type u) [CommSemiring R] (n : ℕ) :
    Function.Surjective (tensorPowerToDegree R n) := by
  rintro ⟨x, hx⟩
  obtain ⟨t, ht, rfl⟩ := mem_degree_iff.mp hx
  refine ⟨TensorAlgebra.tensorPowerProjection n t, Subtype.ext ?_⟩
  rw [tensorPowerToDegree_coe, TensorAlgebra.toTensorAlgebra_tensorPowerProjection_of_mem ht]

theorem ker_tensorPowerToDegree (R : Type u) [CommSemiring R] (n : ℕ) :
    LinearMap.ker (tensorPowerToDegree R n) = milnorTensorRel R n := by
  ext x
  rw [LinearMap.mem_ker, Subtype.ext_iff, ZeroMemClass.coe_zero, tensorPowerToDegree_coe]
  constructor
  · intro hx
    have hrel : TensorPower.toTensorAlgebra x ∈ milnorRelPiece R n :=
      mem_ker_quotient_and_mem_range_pow_iff.mp
        ⟨hx, TensorAlgebra.toTensorAlgebra_mem_range_ι_pow x⟩
    have hproj : TensorAlgebra.tensorPowerProjection n (TensorPower.toTensorAlgebra x) = x :=
      LinearMap.congr_fun (TensorAlgebra.tensorPowerProjection_comp_toTensorAlgebra n) x
    rw [← hproj]
    exact Submodule.mem_map_of_mem hrel
  · intro hx
    obtain ⟨z, hz, rfl⟩ := Submodule.mem_map.mp hx
    have hdeg := milnorRelPiece_le_range_pow R n hz
    rw [TensorAlgebra.toTensorAlgebra_tensorPowerProjection_of_mem hdeg]
    exact (mem_ker_quotient_and_mem_range_pow_iff.mpr hz).1

variable (R) in
/-- **Degree-`n` presentation of Milnor K-theory**: `MilnorK.degree R n` is canonically
`ℤ`-linearly equivalent to `(⨂[ℤ]^n (Additive Rˣ)) ⧸ milnorTensorRel R n`. -/
noncomputable def degreeEquivQuotient (n : ℕ) :
    degree R n ≃ₗ[ℤ] TensorPower ℤ n (Additive Rˣ) ⧸ milnorTensorRel R n :=
  ((tensorPowerToDegree R n).quotKerEquivOfSurjective
    (tensorPowerToDegree_surjective R n)).symm.trans
    (Submodule.quotEquivOfEq _ _ (ker_tensorPowerToDegree R n))

@[simp]
theorem degreeEquivQuotient_symm_mk_tprod (n : ℕ) (v : Fin n → Additive Rˣ) :
    ((degreeEquivQuotient R n).symm (Submodule.Quotient.mk (PiTensorProduct.tprod ℤ v)) :
        MilnorK R) =
      symbol (List.ofFn fun i => Additive.toMul (v i)) := by
  have hmk : (Submodule.quotEquivOfEq _ _ (ker_tensorPowerToDegree R n)).symm
      (Submodule.Quotient.mk (PiTensorProduct.tprod ℤ v)) =
      Submodule.Quotient.mk (PiTensorProduct.tprod ℤ v) :=
    (LinearEquiv.symm_apply_eq _).mpr (Submodule.quotEquivOfEq_mk _ _ _ _).symm
  rw [degreeEquivQuotient, LinearEquiv.trans_symm, LinearEquiv.trans_apply, LinearEquiv.symm_symm,
    hmk, LinearMap.quotKerEquivOfSurjective_apply_mk, tensorPowerToDegree_tprod]

theorem degreeEquivQuotient_symbol (n : ℕ) (v : Fin n → Rˣ) :
    degreeEquivQuotient R n
        ⟨symbol (List.ofFn v), symbol_mem_degree_of_length (List.length_ofFn)⟩ =
      Submodule.Quotient.mk (PiTensorProduct.tprod ℤ fun i => Additive.ofMul (v i)) := by
  apply (degreeEquivQuotient R n).symm.injective
  rw [LinearEquiv.symm_apply_apply]
  apply Subtype.ext
  simp

variable (R) in
/-- **Degree-zero identification**: `K₀ᴹ(R) ≃ₗ[ℤ] ℤ`. -/
noncomputable def degreeZeroEquiv : degree R 0 ≃ₗ[ℤ] ℤ :=
  (degreeEquivQuotient R 0).trans
    ((Submodule.quotEquivOfEqBot _ (milnorTensorRel_zero R)).trans
      (PiTensorProduct.isEmptyEquiv (Fin 0)))

@[simp]
theorem degreeZeroEquiv_one : degreeZeroEquiv R ⟨1, one_mem_degree_zero⟩ = 1 := by
  have h : (⟨1, one_mem_degree_zero⟩ : degree R 0) =
      (degreeEquivQuotient R 0).symm
        (Submodule.Quotient.mk (PiTensorProduct.tprod ℤ Fin.elim0)) :=
    Subtype.ext (by simp)
  rw [h]
  simp [degreeZeroEquiv]

@[simp]
theorem degreeZeroEquiv_intCast (k : ℤ) :
    degreeZeroEquiv R ⟨(k : MilnorK R), intCast_mem_degree_zero k⟩ = k := by
  have h : (⟨(k : MilnorK R), intCast_mem_degree_zero k⟩ : degree R 0) =
      k • ⟨1, one_mem_degree_zero⟩ := by
    apply Subtype.ext
    simp [zsmul_eq_mul]
  rw [h, map_zsmul, degreeZeroEquiv_one, smul_eq_mul, mul_one]

@[simp]
theorem degreeZeroEquiv_symm_apply (k : ℤ) :
    ((degreeZeroEquiv R).symm k : MilnorK R) = (k : MilnorK R) := by
  have h : (degreeZeroEquiv R).symm k = ⟨(k : MilnorK R), intCast_mem_degree_zero k⟩ := by
    apply (degreeZeroEquiv R).injective
    rw [LinearEquiv.apply_symm_apply, degreeZeroEquiv_intCast]
  exact congrArg Subtype.val h

/-- `MilnorK R` is always nontrivial: `1 ≠ 0` because `K₀ᴹ(R) ≃ₗ[ℤ] ℤ`. -/
instance : Nontrivial (MilnorK R) := by
  refine ⟨1, 0, fun h => ?_⟩
  have h' : (⟨1, one_mem_degree_zero⟩ : degree R 0) = 0 := Subtype.ext h
  have h10 : (1 : ℤ) = 0 := by
    simpa only [degreeZeroEquiv_one, map_zero] using congrArg (degreeZeroEquiv R) h'
  exact one_ne_zero h10

variable (R) in
/-- **Degree-one identification**: `K₁ᴹ(R) ≃ₗ[ℤ] Additive Rˣ`. -/
noncomputable def degreeOneEquiv : degree R 1 ≃ₗ[ℤ] Additive Rˣ :=
  (degreeEquivQuotient R 1).trans
    ((Submodule.quotEquivOfEqBot _ (milnorTensorRel_one R)).trans
      (PiTensorProduct.subsingletonEquiv (0 : Fin 1)))

@[simp]
theorem degreeOneEquiv_ofUnit (a : Rˣ) :
    degreeOneEquiv R ⟨ofUnit a, ofUnit_mem_degree_one a⟩ = Additive.ofMul a := by
  have h : (⟨ofUnit a, ofUnit_mem_degree_one a⟩ : degree R 1) =
      (degreeEquivQuotient R 1).symm
        (Submodule.Quotient.mk (PiTensorProduct.tprod ℤ fun _ : Fin 1 => Additive.ofMul a)) :=
    Subtype.ext (by simp)
  rw [h]
  simp [degreeOneEquiv]

@[simp]
theorem degreeOneEquiv_symm_apply (u : Additive Rˣ) :
    ((degreeOneEquiv R).symm u : MilnorK R) = ofUnit (Additive.toMul u) := by
  have h : (degreeOneEquiv R).symm u =
      ⟨ofUnit (Additive.toMul u), ofUnit_mem_degree_one (Additive.toMul u)⟩ := by
    apply (degreeOneEquiv R).injective
    rw [LinearEquiv.apply_symm_apply, degreeOneEquiv_ofUnit, ofMul_toMul]
  exact congrArg Subtype.val h

/-- The canonical unit map `ofUnit : Rˣ → MilnorK R` is injective. -/
theorem ofUnit_injective : Function.Injective (ofUnit (R := R)) := by
  intro a b hab
  have h := congrArg (degreeOneEquiv R)
    (Subtype.ext hab : (⟨ofUnit a, ofUnit_mem_degree_one a⟩ : degree R 1) =
      ⟨ofUnit b, ofUnit_mem_degree_one b⟩)
  rw [degreeOneEquiv_ofUnit, degreeOneEquiv_ofUnit] at h
  exact Additive.ofMul.injective h

/-- The canonical additive homomorphism `ofUnitHom R : Additive Rˣ →+ MilnorK R` is injective. -/
theorem ofUnitHom_injective (R : Type u) [CommSemiring R] : Function.Injective (ofUnitHom R) := by
  intro u v huv
  have huv' : ofUnit (Additive.toMul u) = ofUnit (Additive.toMul v) := by
    rw [← ofUnitHom_ofMul, ← ofUnitHom_ofMul, ofMul_toMul, ofMul_toMul]
    exact huv
  exact Additive.toMul.injective (ofUnit_injective huv')

/-- Auxiliary `ℤ`-linear map from `⨂[ℤ]^2 (Additive Rˣ)` to `SymbolGroup R`. -/
private noncomputable def tensorPowerTwoToSymbolGroup (R : Type u) [CommSemiring R] :
    TensorPower ℤ 2 (Additive Rˣ) →ₗ[ℤ] SymbolGroup R :=
  PiTensorProduct.lift
    { toFun := fun v => TauCeti.symbol (Additive.toMul (v 0)) (Additive.toMul (v 1))
      map_update_add' := fun m i x y => by
        fin_cases i
        · simp [Function.update, symbol_mul_left]
        · simp [Function.update, symbol_mul_right]
      map_update_smul' := fun m i k x => by
        fin_cases i
        · simp [Function.update, symbol_zpow_left]
        · simp [Function.update, symbol_zpow_right] }

private theorem milnorTensorRel_two_le_ker (R : Type u) [CommSemiring R] :
    milnorTensorRel R 2 ≤ LinearMap.ker (tensorPowerTwoToSymbolGroup R) := by
  rw [milnorTensorRel_two, Submodule.span_le]
  rintro _ ⟨a, b, hab, rfl⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker, tensorPowerTwoToSymbolGroup, PiTensorProduct.lift.tprod]
  exact TauCeti.symbol_eq_zero_of_add_eq_one hab

/-- Auxiliary `ℤ`-linear map `SymbolGroup R →ₗ[ℤ] MilnorK.degree R 2` sending `{a, b}` to
`ofUnit a * ofUnit b`. -/
private noncomputable def symbolGroupToDegreeTwo (R : Type u) [CommSemiring R] :
    SymbolGroup R →ₗ[ℤ] degree R 2 :=
  SymbolGroup.lift
    (fun a b : Rˣ =>
      (⟨ofUnit a * ofUnit b,
        mul_mem_degree (ofUnit_mem_degree_one a) (ofUnit_mem_degree_one b)⟩ : degree R 2))
    { map_mul_left := fun a b d => Subtype.ext (by
        dsimp only [Submodule.coe_add]
        rw [ofUnit_mul, add_mul])
      map_mul_right := fun a b d => Subtype.ext (by
        dsimp only [Submodule.coe_add]
        rw [ofUnit_mul, mul_add])
      steinberg := fun a b hab => Subtype.ext (ofUnit_mul_ofUnit_eq_zero hab) }

variable (R) in
/-- **Degree-two identification**: `K₂ᴹ(R) ≃ₗ[ℤ] SymbolGroup R`, sending `ofUnit a * ofUnit b`
to `TauCeti.symbol a b`. -/
noncomputable def degreeTwoEquiv : degree R 2 ≃ₗ[ℤ] SymbolGroup R :=
  LinearEquiv.ofLinearMap
    ((Submodule.liftQ (milnorTensorRel R 2) (tensorPowerTwoToSymbolGroup R)
      (milnorTensorRel_two_le_ker R)).comp (degreeEquivQuotient R 2).toLinearMap)
    (symbolGroupToDegreeTwo R)
    (by
      apply SymbolGroup.hom_ext
      intro a b
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, symbolGroupToDegreeTwo,
        SymbolGroup.lift_symbol]
      have h : (⟨ofUnit a * ofUnit b,
          mul_mem_degree (ofUnit_mem_degree_one a) (ofUnit_mem_degree_one b)⟩ : degree R 2) =
          ⟨symbol (List.ofFn ![a, b]), symbol_mem_degree_of_length List.length_ofFn⟩ :=
        Subtype.ext (by simp [symbol_def])
      rw [h, degreeEquivQuotient_symbol]
      simp [Submodule.liftQ_apply, tensorPowerTwoToSymbolGroup])
    (by
      apply degree_linearMap_ext
      intro l hl
      match l, hl with
      | [a, b], _ =>
        simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearMap.id_apply]
        have h : (⟨symbol [a, b], symbol_mem_degree_of_length rfl⟩ : degree R 2) =
            ⟨symbol (List.ofFn ![a, b]), symbol_mem_degree_of_length List.length_ofFn⟩ :=
          Subtype.ext (by simp)
        rw [h, degreeEquivQuotient_symbol]
        simp only [Submodule.liftQ_apply, tensorPowerTwoToSymbolGroup, PiTensorProduct.lift.tprod]
        apply Subtype.ext
        simp [symbolGroupToDegreeTwo])

@[simp]
theorem degreeTwoEquiv_ofUnit_mul (a b : Rˣ) :
    degreeTwoEquiv R
        ⟨ofUnit a * ofUnit b,
          mul_mem_degree (ofUnit_mem_degree_one a) (ofUnit_mem_degree_one b)⟩ =
      TauCeti.symbol a b := by
  have h : (⟨ofUnit a * ofUnit b,
      mul_mem_degree (ofUnit_mem_degree_one a) (ofUnit_mem_degree_one b)⟩ : degree R 2) =
      (degreeTwoEquiv R).symm (TauCeti.symbol a b) :=
    Subtype.ext (by simp [degreeTwoEquiv, symbolGroupToDegreeTwo])
  rw [h, LinearEquiv.apply_symm_apply]

/-- `degreeTwoEquiv R` sends the length-`2` Milnor symbol `[a, b]` to `TauCeti.symbol a b`. -/
theorem degreeTwoEquiv_symbol (a b : Rˣ) :
    degreeTwoEquiv R ⟨symbol [a, b], symbol_mem_degree_of_length rfl⟩ =
      TauCeti.symbol a b := by
  have h : (⟨symbol [a, b], symbol_mem_degree_of_length rfl⟩ : degree R 2) =
      ⟨ofUnit a * ofUnit b,
        mul_mem_degree (ofUnit_mem_degree_one a) (ofUnit_mem_degree_one b)⟩ :=
    Subtype.ext (symbol_pair a b)
  rw [h, degreeTwoEquiv_ofUnit_mul]

@[simp]
theorem degreeTwoEquiv_symm_symbol (a b : Rˣ) :
    ((degreeTwoEquiv R).symm (TauCeti.symbol a b) : MilnorK R) = ofUnit a * ofUnit b := by
  simp [degreeTwoEquiv, symbolGroupToDegreeTwo]

/-! ### Graded functoriality -/

section Map

variable {S T : Type*} [CommSemiring S] [CommSemiring T]

/-- `MilnorK.map f` preserves degrees. -/
theorem map_mem_degree (f : R →+* S) {n : ℕ} {x : MilnorK R} (hx : x ∈ degree R n) :
    map f x ∈ degree S n := by
  rw [degree_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨l, rfl, rfl⟩ := hy
    rw [map_symbol]
    exact symbol_mem_degree_of_length (List.length_map _)
  | zero =>
    rw [map_zero]
    exact Submodule.zero_mem _
  | add y z _ _ hy hz =>
    rw [map_add]
    exact Submodule.add_mem _ hy hz
  | smul k y _ hy =>
    rw [map_zsmul]
    exact Submodule.smul_mem _ k hy

/-- Graded ring homomorphism `MilnorK.degree R →+*ᵍ MilnorK.degree S` induced by a ring
homomorphism `f : R →+* S`. -/
def gradedMap (f : R →+* S) : degree R →+*ᵍ degree S where
  toRingHom := map f
  map_mem hx := map_mem_degree f hx

@[simp]
theorem gradedMap_toRingHom (f : R →+* S) : (gradedMap f).toRingHom = map f := by
  rfl

@[simp]
theorem gradedMap_apply (f : R →+* S) (x : MilnorK R) : gradedMap f x = map f x := by
  rfl

@[simp]
theorem gradedMap_id : gradedMap (RingHom.id R) = GradedRingHom.id (degree R) :=
  gradedHom_ext fun a => by simp

@[simp]
theorem gradedMap_comp (g : S →+* T) (f : R →+* S) :
    gradedMap (g.comp f) = (gradedMap g).comp (gradedMap f) :=
  gradedHom_ext fun a => by
    simp only [gradedMap_apply, map_comp, RingHom.comp_apply, GradedRingHom.comp_apply]

/-- The degree-`n` `ℤ`-linear map `Kₙᴹ(R) →ₗ[ℤ] Kₙᴹ(S)` induced by a ring homomorphism
`f : R →+* S`. -/
def mapDegree (f : R →+* S) (n : ℕ) : degree R n →ₗ[ℤ] degree S n :=
  ((map f).toIntAlgHom.toLinearMap.comp (degree R n).subtype).codRestrict
    (degree S n) fun x => map_mem_degree f x.2

@[simp]
theorem mapDegree_coe (f : R →+* S) (n : ℕ) (x : degree R n) :
    (mapDegree f n x : MilnorK S) = map f x.1 := by
  rfl

@[simp]
theorem mapDegree_id (n : ℕ) : mapDegree (RingHom.id R) n = LinearMap.id := by
  ext x
  simp

@[simp]
theorem mapDegree_comp (g : S →+* T) (f : R →+* S) (n : ℕ) :
    mapDegree (g.comp f) n = (mapDegree g n).comp (mapDegree f n) := by
  ext x
  simp

/-- Naturality of `degreeZeroEquiv` with respect to ring homomorphisms. -/
theorem degreeZeroEquiv_mapDegree (f : R →+* S) (x : degree R 0) :
    degreeZeroEquiv S (mapDegree f 0 x) = degreeZeroEquiv R x := by
  obtain ⟨k, rfl⟩ := (degreeZeroEquiv R).symm.surjective x
  have hmap : mapDegree f 0 ((degreeZeroEquiv R).symm k) = (degreeZeroEquiv S).symm k := by
    apply Subtype.ext
    simp
  rw [hmap, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]

/-- Naturality of `degreeOneEquiv` with respect to ring homomorphisms. -/
theorem degreeOneEquiv_mapDegree (f : R →+* S) (x : degree R 1) :
    degreeOneEquiv S (mapDegree f 1 x) =
      MonoidHom.toAdditive (Units.map f.toMonoidHom) (degreeOneEquiv R x) := by
  obtain ⟨u, rfl⟩ := (degreeOneEquiv R).symm.surjective x
  have hmap : mapDegree f 1 ((degreeOneEquiv R).symm u) =
      (degreeOneEquiv S).symm (MonoidHom.toAdditive (Units.map f.toMonoidHom) u) := by
    apply Subtype.ext
    simp
  rw [hmap, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]

/-- Naturality of `degreeTwoEquiv` with respect to `SymbolGroup.map`. -/
theorem degreeTwoEquiv_mapDegree (f : R →+* S) (x : degree R 2) :
    degreeTwoEquiv S (mapDegree f 2 x) = SymbolGroup.map f (degreeTwoEquiv R x) := by
  revert x
  refine fun x => LinearMap.congr_fun (g := (SymbolGroup.map f).comp (degreeTwoEquiv R).toLinearMap)
    (f := (degreeTwoEquiv S).toLinearMap.comp (mapDegree f 2)) ?_ x
  apply degree_linearMap_ext
  intro l hl
  match l, hl with
  | [a, b], _ =>
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
    have hmap : mapDegree f 2 ⟨symbol [a, b], symbol_mem_degree_of_length rfl⟩ =
        ⟨symbol [Units.map f.toMonoidHom a, Units.map f.toMonoidHom b],
          symbol_mem_degree_of_length rfl⟩ :=
      Subtype.ext (by simp)
    rw [hmap, degreeTwoEquiv_symbol, degreeTwoEquiv_symbol, SymbolGroup.map_symbol]

end Map

end TauCeti.MilnorK
