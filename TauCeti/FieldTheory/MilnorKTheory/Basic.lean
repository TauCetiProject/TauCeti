/-!
# The Milnor K-theory ring of a commutative semiring

For a commutative semiring `R`, the **Milnor K-theory ring** `TauCeti.MilnorK R` is the quotient of
`TensorAlgebra ℤ (Additive Rˣ)` by the two-sided Steinberg ideal generated by `ι(a) * ι(b)` for
`(a : R) + b = 1` (`TauCeti.milnorRel`, Weibel III.7.1).

This file constructs `MilnorK R`, its quotient map `MilnorK.quotient`, degree-one generators
`MilnorK.ofUnit` / `ofUnitHom`, ordered symbols `MilnorK.symbol`, the universal property
`MilnorK.lift` / `liftEquiv`, and functoriality `MilnorK.map`.

## References

* C. Weibel, *The K-book: An Introduction to Algebraic K-Theory*, Chapter III, §7.1.
* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. **9** (1970), 318–344.
-/

public section

namespace TauCeti

universe u v

section Defs

variable (R : Type u) [CommSemiring R]

/-- The binary relation generating the two-sided Steinberg ideal of
`TensorAlgebra ℤ (Additive Rˣ)`. -/
def milnorRel : TensorAlgebra ℤ (Additive Rˣ) → TensorAlgebra ℤ (Additive Rˣ) → Prop :=
  fun x y => ∃ a b : Rˣ, (a : R) + b = 1 ∧
    x = TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b) ∧ y = 0

/-- Characterization of the generating relation `TauCeti.milnorRel`. -/
theorem milnorRel_iff {R : Type u} [CommSemiring R] {x y : TensorAlgebra ℤ (Additive Rˣ)} :
    milnorRel R x y ↔ ∃ a b : Rˣ, (a : R) + b = 1 ∧
      x = TensorAlgebra.ι ℤ (Additive.ofMul a) * TensorAlgebra.ι ℤ (Additive.ofMul b) ∧
      y = 0 := Iff.rfl

/-- **Milnor K-theory** `K_*ᴹ(R)`, the quotient of the tensor algebra of `Additive Rˣ` over `ℤ`
by the two-sided ideal generated by the Steinberg products `ι(a) * ι(b)` with `(a : R) + b = 1`
(Weibel, III.7.1). -/
abbrev MilnorK : Type u := RingQuot (milnorRel R)

end Defs

namespace MilnorK

section Semiring

variable (R : Type u) [CommSemiring R]

/-- The canonical quotient ring homomorphism from the tensor algebra to `MilnorK R`. -/
abbrev quotient : TensorAlgebra ℤ (Additive Rˣ) →+* MilnorK R := RingQuot.mkRingHom (milnorRel R)

/-- Every element of `MilnorK R` lifts to the tensor algebra. -/
theorem quotient_surjective : Function.Surjective (quotient R) :=
  RingQuot.mkRingHom_surjective (milnorRel R)

/-- The canonical additive homomorphism `Additive Rˣ →+ MilnorK R` sending a unit to its
degree-one class. -/
def ofUnitHom : Additive Rˣ →+ MilnorK R :=
  (quotient R).toAddMonoidHom.comp (TensorAlgebra.ι ℤ).toAddMonoidHom

variable {R}

/-- The degree-one class of a unit in `MilnorK R`. -/
def ofUnit (a : Rˣ) : MilnorK R := quotient R (TensorAlgebra.ι ℤ (Additive.ofMul a))
/-- Unfolding lemma for `TauCeti.MilnorK.ofUnit`. -/
theorem ofUnit_def (a : Rˣ) :
    ofUnit a = quotient R (TensorAlgebra.ι ℤ (Additive.ofMul a)) := by rfl
/-- Unfolding lemma for `TauCeti.MilnorK.ofUnitHom`. -/
theorem ofUnitHom_apply (u : Additive Rˣ) : ofUnitHom R u = ofUnit (Additive.toMul u) := by rfl
@[simp] theorem ofUnitHom_ofMul (a : Rˣ) : ofUnitHom R (Additive.ofMul a) = ofUnit a := by rfl
@[simp] theorem quotient_ι (u : Additive Rˣ) :
    quotient R (TensorAlgebra.ι ℤ u) = ofUnit (Additive.toMul u) := by rfl
@[simp] theorem ofUnit_one : ofUnit (1 : Rˣ) = 0 := by
  rw [ofUnit_def, ofMul_one, map_zero, map_zero]
theorem ofUnit_mul (a b : Rˣ) : ofUnit (a * b) = ofUnit a + ofUnit b := by
  rw [ofUnit_def, ofMul_mul, map_add, map_add, ← ofUnit_def, ← ofUnit_def]
@[simp] theorem ofUnit_inv (a : Rˣ) : ofUnit a⁻¹ = -ofUnit a := by
  rw [ofUnit_def, ofMul_inv, map_neg, map_neg, ← ofUnit_def]
theorem ofUnit_pow (a : Rˣ) (n : ℕ) : ofUnit (a ^ n) = n • ofUnit a := by
  rw [ofUnit_def, ofMul_pow, map_nsmul, map_nsmul, ← ofUnit_def]
theorem ofUnit_zpow (a : Rˣ) (n : ℤ) : ofUnit (a ^ n) = n • ofUnit a := by
  rw [ofUnit_def, ofMul_zpow, map_zsmul, map_zsmul, ← ofUnit_def]

end Semiring

section CommRing

variable {R : Type*} [CommRing R]

theorem two_nsmul_ofUnit_neg_one : 2 • ofUnit (-1 : Rˣ) = 0 := by rw [← ofUnit_pow]; simp
theorem neg_ofUnit_neg_one : -ofUnit (-1 : Rˣ) = ofUnit (-1 : Rˣ) := by rw [← ofUnit_inv]; simp

end CommRing

section

variable {R : Type u} [CommSemiring R]

/-- **The Steinberg relation** in `MilnorK R`: `ofUnit a * ofUnit b = 0` when `(a : R) + b = 1`. -/
theorem ofUnit_mul_ofUnit_eq_zero {a b : Rˣ} (h : (a : R) + b = 1) : ofUnit a * ofUnit b = 0 := by
  rw [ofUnit_def, ofUnit_def, ← map_mul]
  simpa only [map_zero] using RingQuot.mkRingHom_rel (r := milnorRel R) ⟨a, b, h, rfl, rfl⟩

/-- The degree-two product `(a, b) ↦ ofUnit a * ofUnit b` is a Steinberg pairing. -/
theorem isSteinbergPairing_ofUnit_mul :
    IsSteinbergPairing (fun a b : Rˣ => ofUnit a * ofUnit b) where
  map_mul_left _ _ _ := by rw [ofUnit_mul, add_mul]
  map_mul_right _ _ _ := by rw [ofUnit_mul, mul_add]
  steinberg _ _ h := ofUnit_mul_ofUnit_eq_zero h

/-! ### Ordered Milnor symbols -/

/-- The **Milnor symbol** `{a₁, …, aₙ}`, the ordered product of degree-one unit classes. -/
def symbol (l : List Rˣ) : MilnorK R := (l.map ofUnit).prod
/-- Unfolding lemma for `TauCeti.MilnorK.symbol`. -/
theorem symbol_def (l : List Rˣ) : symbol l = (l.map ofUnit).prod := by rfl
@[simp] theorem symbol_nil : symbol ([] : List Rˣ) = 1 := by rfl
theorem symbol_singleton (a : Rˣ) : symbol [a] = ofUnit a := by simp [symbol_def]
@[simp] theorem symbol_cons (a : Rˣ) (l : List Rˣ) : symbol (a :: l) = ofUnit a * symbol l := by
  simp [symbol_def]
theorem symbol_pair (a b : Rˣ) : symbol [a, b] = ofUnit a * ofUnit b := by simp [symbol_def]
theorem symbol_append (l₁ l₂ : List Rˣ) : symbol (l₁ ++ l₂) = symbol l₁ * symbol l₂ := by
  simp [symbol_def]
theorem symbol_mul_middle (l₁ : List Rˣ) (a b : Rˣ) (l₂ : List Rˣ) :
    symbol (l₁ ++ (a * b) :: l₂) = symbol (l₁ ++ a :: l₂) + symbol (l₁ ++ b :: l₂) := by
  simp only [symbol_append, symbol_cons, ofUnit_mul, add_mul, mul_add]
@[simp] theorem symbol_one_middle (l₁ l₂ : List Rˣ) : symbol (l₁ ++ 1 :: l₂) = 0 := by
  simp [symbol_append]
theorem symbol_inv_middle (l₁ : List Rˣ) (a : Rˣ) (l₂ : List Rˣ) :
    symbol (l₁ ++ a⁻¹ :: l₂) = -symbol (l₁ ++ a :: l₂) := by
  rw [symbol_append, symbol_cons, ofUnit_inv, neg_mul (ofUnit a), mul_neg (symbol l₁),
    ← symbol_cons, ← symbol_append]
theorem symbol_eq_zero_of_add_eq_one (l₁ : List Rˣ) {a b : Rˣ} (h : (a : R) + b = 1)
    (l₂ : List Rˣ) : symbol (l₁ ++ a :: b :: l₂) = 0 := by
  simp only [symbol_append, symbol_cons, ← mul_assoc]
  rw [mul_assoc (symbol l₁), ofUnit_mul_ofUnit_eq_zero h, mul_zero, zero_mul]

/-- The quotient map sends a pure tensor word in `TensorAlgebra` to its Milnor symbol. -/
theorem quotient_tprod {n : ℕ} (v : Fin n → Additive Rˣ) :
    quotient R (TensorAlgebra.tprod ℤ (Additive Rˣ) n v) =
      symbol (List.ofFn fun i => Additive.toMul (v i)) := by
  simp only [TensorAlgebra.tprod_apply, map_list_prod, List.map_ofFn, Function.comp_def,
    quotient_ι, symbol_def]

/-! ### Induction, extensionality, and universal property -/

/-- Induction on expressions in `MilnorK R` built from integers and degree-one unit classes. -/
@[elab_as_elim]
theorem induction {P : MilnorK R → Prop}
    (intCast : ∀ n : ℤ, P (n : MilnorK R)) (ofUnit : ∀ a : Rˣ, P (MilnorK.ofUnit a))
    (mul : ∀ x y, P x → P y → P (x * y)) (add : ∀ x y, P x → P y → P (x + y)) (x : MilnorK R) :
    P x := by
  obtain ⟨t, rfl⟩ := quotient_surjective R x
  induction t using TensorAlgebra.induction with
  | algebraMap n =>
    rw [eq_intCast (algebraMap ℤ (TensorAlgebra ℤ (Additive Rˣ))), map_intCast]; exact intCast n
  | ι u => exact ofUnit (Additive.toMul u)
  | mul _ _ h₁ h₂ => simpa only [map_mul] using mul _ _ h₁ h₂
  | add _ _ h₁ h₂ => simpa only [map_add] using add _ _ h₁ h₂

/-- Two ring homomorphisms out of `MilnorK R` agree when they agree on degree-one unit classes. -/
@[ext 1200] theorem ringHom_ext {A : Type v} [Ring A] {f g : MilnorK R →+* A}
    (h : ∀ a : Rˣ, f (ofUnit a) = g (ofUnit a)) : f = g :=
  RingQuot.ringQuot_ext f g <| RingHom.ext fun t => DFunLike.congr_fun
    (TensorAlgebra.hom_ext (f := f.toIntAlgHom.comp (quotient R).toIntAlgHom)
      (g := g.toIntAlgHom.comp (quotient R).toIntAlgHom)
      (LinearMap.ext fun u => h (Additive.toMul u))) t

/-- Two `ℤ`-algebra homomorphisms out of `MilnorK R` agree when they agree on units. -/
@[ext 1200] theorem hom_ext {A : Type v} [Semiring A] [Algebra ℤ A] {f g : MilnorK R →ₐ[ℤ] A}
    (h : ∀ a : Rˣ, f (ofUnit a) = g (ofUnit a)) : f = g :=
  AlgHom.ext fun x => by
    obtain ⟨t, rfl⟩ := quotient_surjective R x
    exact DFunLike.congr_fun (TensorAlgebra.hom_ext (f := f.comp (quotient R).toIntAlgHom)
      (g := g.comp (quotient R).toIntAlgHom) (LinearMap.ext fun u => h (Additive.toMul u))) t

section Lift

variable {A : Type v} [Ring A] (f : Additive Rˣ →+ A)
  (hf : ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0)

variable (R) in
/-- **Universal property of `MilnorK R`**: an additive homomorphism `f : Additive Rˣ →+ A` into a
ring whose values satisfy the Steinberg relation extends uniquely to `MilnorK R →+* A`. -/
def lift : MilnorK R →+* A :=
  RingQuot.lift ⟨(TensorAlgebra.lift ℤ f.toIntLinearMap).toRingHom, by
    rintro _ _ ⟨a, b, hab, rfl, rfl⟩
    simpa only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_mul, TensorAlgebra.lift_ι_apply,
      AddMonoidHom.coe_toIntLinearMap, map_zero] using hf a b hab⟩

@[simp] theorem lift_ofUnit (a : Rˣ) : lift R f hf (ofUnit a) = f (Additive.ofMul a) := by
  rw [ofUnit_def, lift, RingQuot.lift_mkRingHom_apply]
  exact TensorAlgebra.lift_ι_apply f.toIntLinearMap (Additive.ofMul a)
@[simp] theorem lift_quotient (t : TensorAlgebra ℤ (Additive Rˣ)) :
    lift R f hf (quotient R t) = TensorAlgebra.lift ℤ f.toIntLinearMap t :=
  RingQuot.lift_mkRingHom_apply _ _ t
theorem lift_symbol (l : List Rˣ) :
    lift R f hf (symbol l) = (l.map fun a => f (Additive.ofMul a)).prod := by
  simp [symbol_def, map_list_prod, Function.comp_def]
theorem lift_unique (g : MilnorK R →+* A) (hg : ∀ a : Rˣ, g (ofUnit a) = f (Additive.ofMul a)) :
    g = lift R f hf := ringHom_ext fun a => (hg a).trans (lift_ofUnit f hf a).symm

end Lift

section LiftEquiv

variable (R) {A : Type v} [Ring A]

/-- The universal property of `MilnorK R` as an equivalence between Steinberg homomorphisms
`Additive Rˣ →+ A` and ring homomorphisms `MilnorK R →+* A`. -/
def liftEquiv :
    {f : Additive Rˣ →+ A //
      ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0} ≃
      (MilnorK R →+* A) where
  toFun f := lift R f.1 f.2
  invFun g := ⟨g.toAddMonoidHom.comp (ofUnitHom R), fun a b h => by
    simp only [AddMonoidHom.comp_apply, ofUnitHom_ofMul, RingHom.toAddMonoidHom_eq_coe,
      AddMonoidHom.coe_ofClass, ← map_mul, ofUnit_mul_ofUnit_eq_zero h, map_zero]⟩
  left_inv f := Subtype.ext <| AddMonoidHom.ext fun u => by
    simp only [AddMonoidHom.comp_apply, RingHom.toAddMonoidHom_eq_coe, AddMonoidHom.coe_ofClass]
    rw [← ofMul_toMul u, ofUnitHom_ofMul, lift_ofUnit]
  right_inv g := (lift_unique _ _ g fun _ => rfl).symm

@[simp] theorem liftEquiv_apply (f : {f : Additive Rˣ →+ A //
    ∀ a b : Rˣ, (a : R) + b = 1 → f (Additive.ofMul a) * f (Additive.ofMul b) = 0}) :
    liftEquiv R f = lift R f.1 f.2 := by rfl
@[simp] theorem liftEquiv_symm_apply_val (g : MilnorK R →+* A) (a : Rˣ) :
    ((liftEquiv R).symm g).1 (Additive.ofMul a) = g (ofUnit a) := by rfl

end LiftEquiv

/-! ### Functoriality -/

/-- Functorial ring homomorphism `MilnorK R →+* MilnorK S` induced by `f : R →+* S`. -/
def map {S : Type*} [CommSemiring S] (f : R →+* S) : MilnorK R →+* MilnorK S :=
  lift R ((ofUnitHom S).comp (MonoidHom.toAdditive (Units.map f.toMonoidHom))) fun a b hab => by
    simpa using ofUnit_mul_ofUnit_eq_zero (R := S) (a := Units.map f.toMonoidHom a)
      (b := Units.map f.toMonoidHom b) (by simp [← map_add, hab])

@[simp] theorem map_ofUnit {S : Type*} [CommSemiring S] (f : R →+* S) (a : Rˣ) :
    map f (ofUnit a) = ofUnit (Units.map f.toMonoidHom a) := lift_ofUnit _ _ a
@[simp] theorem map_symbol {S : Type*} [CommSemiring S] (f : R →+* S) (l : List Rˣ) :
    map f (symbol l) = symbol (l.map (Units.map f.toMonoidHom)) := by
  simp [symbol_def, map_list_prod, Function.comp_def]
@[simp] theorem map_id : map (RingHom.id R) = RingHom.id (MilnorK R) := ringHom_ext fun _ => by simp
@[simp] theorem map_comp {S T : Type*} [CommSemiring S] [CommSemiring T] (g : S →+* T)
    (f : R →+* S) : map (g.comp f) = (map g).comp (map f) :=
  ringHom_ext fun _ => by simp only [RingHom.comp_apply, map_ofUnit]; congr 1

end

