module

public import TauCeti.FieldTheory.FunctionField.Differential.Comparison
public import TauCeti.FieldTheory.FunctionField.PlaneCurve.Genus
-- Proof-only: powers of a function lie in the multiples of its pole divisor.
import TauCeti.FieldTheory.FunctionField.RiemannRoch.Principal
-- Proof-only: the number of monomials of degree at most `n - 3`.
import TauCeti.Data.Finset.NatAntidiagonal
-- Proof-only: the products `x ^ i y ^ j` are linearly independent.
import TauCeti.RingTheory.Algebraic.LinearIndependent

/-!
# The canonical divisor and the regular differentials of a smooth plane curve

Let `g ∈ k[X, Y]` be irreducible of total degree `n`, with the coefficient of `Yⁿ` equal to `1`,
such that the projective closure of `g = 0` is smooth in both affine charts `g = 0` and
`uⁿ g(1 / u, v / u) = 0`, and let `F / k(x)` be finite separable, generated by `y` with
`g(x, y) = 0`, with exact constant field `k`. The divisor of `dx` is
`-2 (x)_∞ + Diff(F / k(x))`, and `Diff(F / k(x)) = div (∂g/∂Y (x, y)) + (n - 1) (x)_∞`
(`TauCeti.Divisor.different_eq_principal_add_zsmul_poles`), so the Weil differential

`ω₀ = dx / (∂g/∂Y (x, y))`

has divisor `(n - 3) (x)_∞`. Since the projective closure does not pass through `(0 : 1 : 0)`,
the pole divisor `(x)_∞` is the divisor cut out on the curve by the line at infinity, and this says
that **the canonical divisors of a smooth plane curve of degree `n` are cut out by the curves of
degree `n - 3`**.

The monomials `x ^ i y ^ j` with `i + j ≤ n - 3` lie in `L((n - 3) (x)_∞)`: `y` is integral over
`k[x]`, and `y / x` is integral over `k[1 / x]` by the equation of the chart at infinity, so `y`
has poles only where `x` does, and of no larger order. They are linearly independent, because
`1, y, …, y ^ (n - 1)` is a basis of `F / k(x)`, and there are `(n - 1)(n - 2) / 2 = g` of them,
while `ℓ((n - 3) (x)_∞) = g` since the divisor is canonical. Hence `L((n - 3) (x)_∞)` is exactly
the space of polynomials in `x` and `y` of degree at most `n - 3`, and the regular differentials of
`F` are exactly the

`h(x, y) dx / (∂g/∂Y (x, y))` with `deg h ≤ n - 3`.

## Main results

* `TauCeti.mem_riemannRochSpace_poles_of_aeval_eq_zero`: `y ∈ L((x)_∞)`.
* `TauCeti.weilDifferentialDivisor_repartitionDualMul_inv_weilDifferentialCotrace_of_aeval_eq_zero`:
  the differential `dx / (∂g/∂Y (x, y))` has divisor `(n - 3) (x)_∞`.
* `TauCeti.divisorClass_sub_three_zsmul_poles_eq_canonicalClass_of_aeval_eq_zero`:
  `(n - 3) (x)_∞` is canonical.
* `TauCeti.riemannRochSpace_sub_three_zsmul_poles_eq_span_of_aeval_eq_zero`: `L((n - 3) (x)_∞)` is
  spanned by the monomials `x ^ i y ^ j` with `i + j ≤ n - 3`.
* `TauCeti.weilDifferentialFiltration_zero_eq_span_of_aeval_eq_zero`: the regular differentials
  are spanned by the `x ^ i y ^ j dx / (∂g/∂Y (x, y))` with `i + j ≤ n - 3`.

## References

* W. Fulton, *Algebraic Curves*, Section 8.5, for the canonical divisors of a plane curve and the
  adjoint curves of degree `n - 3`.
* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Remark 4.3.7(c) and Theorem 3.5.10.
* `TauCeti.FieldTheory.FunctionField.Hyperelliptic.RegularDifferential`, the corresponding
  description of the regular differentials of `y² = f(x)`, whose proof this file follows.
-/

public section

open Polynomial

open scoped IntermediateField

namespace TauCeti

variable {k F : Type*} [Field k] [Field F] [Algebra k F] [Algebra (RatFunc k) F]

/-- **The coordinate `y` of a plane curve has no worse poles than `x`**: let `g ∈ k[X, Y]` have
total degree `n`, with the coefficient of `Yⁿ` equal to `1`, and let `g(x, y) = 0`. Then
`y ∈ L((x)_∞)`. Indeed `y` is integral over `k[x]`, and `y / x` is integral over `k[1 / x]`
through the equation `uⁿ g(1 / u, v / u) = 0` of the chart at infinity. -/
theorem mem_riemannRochSpace_poles_of_aeval_eq_zero (hF : IsFunctionField k F)
    {g : MvPolynomial (Fin 2) k} (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1) {y : F}
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    y ∈ riemannRochSpace (Divisor.poles hF (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
      (Units.mk0 RatFunc.X RatFunc.X_ne_zero))) := by
  set x := algebraMap (RatFunc k) F RatFunc.X with hxd
  have hx : x ≠ 0 := by simp [x, RatFunc.X_ne_zero]
  rcases eq_or_ne y 0 with rfl | hy0
  · exact zero_mem _
  rw [mem_riemannRochSpace_iff_neg_le_ord hy0]
  intro P
  simp only [Divisor.coeff_poles, Units.coe_map, MonoidHom.coe_ofClass, Units.val_mk0, ← hxd]
  by_cases hP : 0 ≤ P.ord x
  · -- At a place where `x` is regular, so is `y`.
    have h := P.mem_integers_of_aeval_eq_zero (Bivariate.monic_equivMvPolynomial_symm le_rfl hlead)
      hy (P.mem_integers_iff_ord_nonneg.mpr hP)
    rw [P.mem_integers_iff_ord_nonneg] at h
    omega
  · -- At a pole of `x`, `y / x` is a root of the chart equation at `x⁻¹`, hence regular.
    have hmon := Bivariate.monic_equivMvPolynomial_symm
      (MvPolynomial.totalDegree_inftyChart_le (le_refl g.totalDegree))
      (by rw [MvPolynomial.coeff_single_one_inftyChart le_rfl, hlead])
    have h := P.mem_integers_of_aeval_eq_zero hmon
      (by rw [MvPolynomial.aeval_inftyChart le_rfl hx, hy, mul_zero])
      (P.mem_integers_iff_ord_nonneg.mpr (by rw [P.ord_inv]; omega))
    rw [P.mem_integers_iff_ord_nonneg, P.ord_mul hy0 (inv_ne_zero hx), P.ord_inv] at h
    omega

/-- **Monomials of degree `d` in the coordinates of a plane curve lie in `L(d (x)_∞)`**: under the
hypotheses of `TauCeti.mem_riemannRochSpace_poles_of_aeval_eq_zero`, `x ^ i y ^ j ∈ L(m (x)_∞)`
whenever `i + j ≤ m`. -/
theorem pow_mul_pow_mem_riemannRochSpace_zsmul_poles_of_aeval_eq_zero (hF : IsFunctionField k F)
    {g : MvPolynomial (Fin 2) k} (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1) {y : F}
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) {i j : ℕ} {m : ℤ}
    (h : (i + j : ℤ) ≤ m) :
    algebraMap (RatFunc k) F RatFunc.X ^ i * y ^ j ∈ riemannRochSpace (m • Divisor.poles hF
      (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
        (Units.mk0 RatFunc.X RatFunc.X_ne_zero))) := by
  have hmem := mul_mem_riemannRochSpace_add (pow_mem_riemannRochSpace_zsmul_poles hF
    (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
      (Units.mk0 RatFunc.X RatFunc.X_ne_zero)) i)
    (pow_mem_riemannRochSpace_zsmul (mem_riemannRochSpace_poles_of_aeval_eq_zero hF hlead hy) j)
  rw [← add_zsmul] at hmem
  exact riemannRochSpace_mono ((Divisor.isEffective_poles hF _).zsmul_le_zsmul h) hmem

variable [IsScalarTower k (RatFunc k) F]

variable [Algebra.IsSeparable (RatFunc k) F] [FiniteDimensional (RatFunc k) F]

/-- **The divisor of `dx / (∂g/∂Y (x, y))`**: let `g ∈ k[X, Y]` be irreducible of total degree
`n`, with the coefficient of `Yⁿ` equal to `1`, such that `g = 0` is smooth and so is its chart at
infinity `uⁿ g(1 / u, v / u) = 0`, and let `F / k(x)` be finite separable, generated by `y` with
`g(x, y) = 0`, with exact constant field `k`. Then the Weil differential `dx / (∂g/∂Y (x, y))`,
where `dx` is the cotrace of the normalized differential of `k(x)`, has divisor `(n - 3) (x)_∞`. -/
theorem weilDifferentialDivisor_repartitionDualMul_inv_weilDifferentialCotrace_of_aeval_eq_zero
    (hF : IsFunctionField k F) (hex : IsIntegrallyClosedIn k F) {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g) (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1)
    (hsm : Ideal.span {g, MvPolynomial.pderiv 0 g, MvPolynomial.pderiv 1 g} = ⊤)
    (hsm' : Ideal.span {g.inftyChart g.totalDegree,
      MvPolynomial.pderiv 0 (g.inftyChart g.totalDegree),
      MvPolynomial.pderiv 1 (g.inftyChart g.totalDegree)} = ⊤)
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) {z : Fˣ}
    (hz : (z : F) = MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y]
      (MvPolynomial.pderiv 1 g)) :
    weilDifferentialDivisor hF hex
        (repartitionDualMul_mem_weilDifferentialSpace hF ((z⁻¹ : Fˣ) : F)
          (weilDifferentialCotrace k F (IsFunctionField.ratFunc k) hF
            ⟨ratFuncWeilDifferential k, ratFuncWeilDifferential_mem k⟩).2)
        (repartitionDualMul_ne_zero hF (Units.ne_zero _)
          (weilDifferentialCotrace_ratFuncWeilDifferential_ne_zero hF)) =
      ((g.totalDegree : ℤ) - 3) • Divisor.poles hF
        (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
          (Units.mk0 RatFunc.X RatFunc.X_ne_zero)) := by
  rw [weilDifferentialDivisor_repartitionDualMul hF hex
      (weilDifferentialCotrace k F (IsFunctionField.ratFunc k) hF
        ⟨ratFuncWeilDifferential k, ratFuncWeilDifferential_mem k⟩).2
      (weilDifferentialCotrace_ratFuncWeilDifferential_ne_zero hF),
    weilDifferentialDivisor_weilDifferentialCotrace_ratFuncWeilDifferential,
    Divisor.different_eq_principal_add_zsmul_poles hF hirr hlead hsm hsm' hgen hy hz,
    Divisor.principal_inv]
  module

/-- **The canonical divisors of a smooth plane curve of degree `n` are cut out by curves of degree
`n - 3`**: under the hypotheses of
`TauCeti.weilDifferentialDivisor_repartitionDualMul_inv_weilDifferentialCotrace_of_aeval_eq_zero`,
the divisor `(n - 3) (x)_∞` represents the canonical class. -/
theorem divisorClass_sub_three_zsmul_poles_eq_canonicalClass_of_aeval_eq_zero
    (hF : IsFunctionField k F) (hex : IsIntegrallyClosedIn k F) {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g)
    (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1)
    (hsm : Ideal.span {g, MvPolynomial.pderiv 0 g, MvPolynomial.pderiv 1 g} = ⊤)
    (hsm' : Ideal.span {g.inftyChart g.totalDegree,
      MvPolynomial.pderiv 0 (g.inftyChart g.totalDegree),
      MvPolynomial.pderiv 1 (g.inftyChart g.totalDegree)} = ⊤)
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    (Place.orderSystem hF).divisorClass (((g.totalDegree : ℤ) - 3) • Divisor.poles hF
        (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
          (Units.mk0 RatFunc.X RatFunc.X_ne_zero))) =
      canonicalClass hF hex := by
  rw [← weilDifferentialDivisor_repartitionDualMul_inv_weilDifferentialCotrace_of_aeval_eq_zero hF
    hex hirr hlead hsm hsm' hgen hy (z := Units.mk0 _ (aeval_pderiv_one_ne_zero_of_aeval_eq_zero
      hirr (Bivariate.monic_equivMvPolynomial_symm le_rfl hlead) hy)) rfl]
  exact divisorClass_weilDifferentialDivisor hF hex _ _

/-- **The Riemann–Roch space of the canonical divisor of a smooth plane curve**: under the
hypotheses of
`TauCeti.weilDifferentialDivisor_repartitionDualMul_inv_weilDifferentialCotrace_of_aeval_eq_zero`,
`L((n - 3) (x)_∞)` is spanned by the monomials `x ^ i y ^ j` with `i + j ≤ n - 3`. These are
linearly independent (`Transcendental.linearIndepOn_pow_mul_pow`), so they form a basis, and
`L((n - 3) (x)_∞)` is the space of polynomials in `x` and `y` of degree at most `n - 3`. -/
theorem riemannRochSpace_sub_three_zsmul_poles_eq_span_of_aeval_eq_zero
    (hF : IsFunctionField k F) (hex : IsIntegrallyClosedIn k F) {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g)
    (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1)
    (hsm : Ideal.span {g, MvPolynomial.pderiv 0 g, MvPolynomial.pderiv 1 g} = ⊤)
    (hsm' : Ideal.span {g.inftyChart g.totalDegree,
      MvPolynomial.pderiv 0 (g.inftyChart g.totalDegree),
      MvPolynomial.pderiv 1 (g.inftyChart g.totalDegree)} = ⊤)
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    riemannRochSpace (((g.totalDegree : ℤ) - 3) • Divisor.poles hF
        (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
          (Units.mk0 RatFunc.X RatFunc.X_ne_zero))) =
      Submodule.span k ((fun p : ℕ × ℕ ↦ algebraMap (RatFunc k) F RatFunc.X ^ p.1 * y ^ p.2) ''
        {p | p.1 + p.2 + 3 ≤ g.totalDegree}) := by
  classical
  have h2 := two_mul_genus_eq_of_aeval_eq_zero hex hirr hlead hsm hsm' hgen hy
  set n := g.totalDegree
  set f := fun p : ℕ × ℕ ↦ algebraMap (RatFunc k) F RatFunc.X ^ p.1 * y ^ p.2
  have hn : 1 ≤ n := MvPolynomial.totalDegree_pos_of_aeval_eq_zero hlead hy
  have := finiteDimensional_riemannRochSpace hF (((n : ℤ) - 3) • Divisor.poles hF
    (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
      (Units.mk0 RatFunc.X RatFunc.X_ne_zero)))
  -- The exponents of the monomials of degree at most `n - 3`, as a finite set.
  set S := (Finset.range (n - 2)).biUnion Finset.antidiagonal
  have hS : (S : Set (ℕ × ℕ)) = {p | p.1 + p.2 + 3 ≤ n} := by
    ext p
    simp only [S, Finset.coe_biUnion, Finset.coe_range, Set.mem_iUnion, Set.mem_Iio,
      Finset.mem_coe, Finset.mem_antidiagonal, Set.mem_ofPred_eq, exists_prop, exists_eq_right']
    omega
  -- These monomials are linearly independent, since their `y`-degree is less than `n`.
  have hdeg : (minpoly (RatFunc k) y).natDegree = n := by
    rw [minpoly_ratFunc_eq_map_of_aeval_eq_zero hirr
        (Bivariate.monic_equivMvPolynomial_symm le_rfl hlead) hy,
      (Bivariate.monic_equivMvPolynomial_symm le_rfl hlead).natDegree_map,
      Bivariate.natDegree_equivMvPolynomial_symm le_rfl hlead]
  have hli : LinearIndepOn k f (S : Set (ℕ × ℕ)) :=
    (RatFunc.transcendental_X.linearIndepOn_pow_mul_pow y).mono fun p hp ↦ by
      rw [hS] at hp
      simp only [Set.mem_ofPred_eq, hdeg] at hp ⊢
      omega
  have hfin : Module.finrank k (Submodule.span k (f '' (S : Set (ℕ × ℕ)))) = S.card := by
    rw [Set.image_eq_range, finrank_span_eq_card hli]
    simp
  -- There are `g` of them, and `ℓ((n - 3) (x)_∞) = g` since the divisor is canonical.
  have hcard : (S.card : ℤ) = genus k F := by
    have hc : 2 * S.card = (n - 2) * (n - 2 + 1) :=
      Finset.Nat.two_mul_card_biUnion_range_antidiagonal (n - 2)
    rcases Nat.lt_or_ge n 2 with hn2 | hn2
    · have hn1 : n = 1 := by omega
      rw [hn1] at h2 hc
      norm_num at h2 hc
      simp [hc, h2]
    · zify [hn2] at hc
      have hA : ((n : ℤ) - 2) * (n - 2 + 1) = (n - 1) * (n - 2) := by ring
      linarith
  rw [← hS]
  refine (Submodule.eq_of_le_of_finrank_eq (Submodule.span_le.mpr ?_) ?_).symm
  · rintro _ ⟨p, hp, rfl⟩
    rw [Finset.mem_coe, ← Finset.mem_coe, hS] at hp
    exact pow_mul_pow_mem_riemannRochSpace_zsmul_poles_of_aeval_eq_zero hF hlead hy
      (by simp only [Set.mem_ofPred_eq] at hp; omega)
  · rw [hfin, ← Divisor.dim_def, (isRiemannRochDivisor_of_divisorClass_eq_canonicalClass hF hex
      (divisorClass_sub_three_zsmul_poles_eq_canonicalClass_of_aeval_eq_zero hF hex hirr hlead hsm
        hsm' hgen hy)).dim_eq hF hex]
    exact_mod_cast hcard

/-- **The regular differentials of a smooth plane curve**: under the hypotheses of
`TauCeti.weilDifferentialDivisor_repartitionDualMul_inv_weilDifferentialCotrace_of_aeval_eq_zero`,
the regular Weil differentials of `F` are spanned by the `x ^ i y ^ j dx / (∂g/∂Y (x, y))` with
`i + j ≤ n - 3`, where `dx` is the cotrace of the normalized differential of `k(x)`: they are the
`h(x, y) dx / (∂g/∂Y (x, y))` for the polynomials `h` of degree at most `n - 3`. -/
theorem weilDifferentialFiltration_zero_eq_span_of_aeval_eq_zero (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) {g : MvPolynomial (Fin 2) k} (hirr : Irreducible g)
    (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1)
    (hsm : Ideal.span {g, MvPolynomial.pderiv 0 g, MvPolynomial.pderiv 1 g} = ⊤)
    (hsm' : Ideal.span {g.inftyChart g.totalDegree,
      MvPolynomial.pderiv 0 (g.inftyChart g.totalDegree),
      MvPolynomial.pderiv 1 (g.inftyChart g.totalDegree)} = ⊤)
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    weilDifferentialFiltration (0 : Divisor k F) =
      Submodule.span k ((fun p : ℕ × ℕ ↦ repartitionDualMul hF
          (algebraMap (RatFunc k) F RatFunc.X ^ p.1 * y ^ p.2 /
            MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] (MvPolynomial.pderiv 1 g))
          (weilDifferentialCotrace k F (IsFunctionField.ratFunc k) hF
            ⟨ratFuncWeilDifferential k, ratFuncWeilDifferential_mem k⟩)) ''
        {p | p.1 + p.2 + 3 ≤ g.totalDegree}) := by
  set z := Units.mk0 _ (aeval_pderiv_one_ne_zero_of_aeval_eq_zero hirr
    (Bivariate.monic_equivMvPolynomial_symm le_rfl hlead) hy)
  have hω := repartitionDualMul_ne_zero hF (Units.ne_zero z⁻¹)
    (weilDifferentialCotrace_ratFuncWeilDifferential_ne_zero hF)
  have hW := isGreatest_weilDifferentialDivisor hF hex
    (repartitionDualMul_mem_weilDifferentialSpace hF ((z⁻¹ : Fˣ) : F)
      (weilDifferentialCotrace k F (IsFunctionField.ratFunc k) hF
        ⟨ratFuncWeilDifferential k, ratFuncWeilDifferential_mem k⟩).2) hω
  rw [weilDifferentialDivisor_repartitionDualMul_inv_weilDifferentialCotrace_of_aeval_eq_zero hF
    hex hirr hlead hsm hsm' hgen hy rfl] at hW
  rw [← map_riemannRochSpace_repartitionDualMulRight hF hex hω hW 0, sub_zero,
    riemannRochSpace_sub_three_zsmul_poles_eq_span_of_aeval_eq_zero hF hex hirr hlead hsm hsm' hgen
      hy,
    Submodule.map_span, Set.image_image]
  simp_rw [repartitionDualMulRight_apply, repartitionDualMul_repartitionDualMul,
    Units.val_inv_eq_inv_val, div_eq_mul_inv, z, Units.val_mk0]

end TauCeti
