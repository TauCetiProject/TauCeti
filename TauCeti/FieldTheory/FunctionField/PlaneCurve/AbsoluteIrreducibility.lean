module

public import TauCeti.FieldTheory.FunctionField.PlaneCurve.ConstantField
import Mathlib.LinearAlgebra.TensorProduct.RightExactness
import TauCeti.Algebra.Polynomial.Bivariate

/-!
# Exact constants and absolute irreducibility of plane equations

An irreducible plane equation with a transcendental first coordinate stays irreducible under
every separable algebraic extension of the constants if the field containing its coordinates
has exact constants. Over a perfect field this gives the converse of the absolute-irreducibility
criterion: for a field generated by the two coordinates, exact constants are equivalent to
irreducibility of the equation over an algebraic closure.

The separability hypothesis matters. Over an imperfect field, exact constants alone do not
imply geometric integrality. The converse here therefore uses separability of the extension of
constants, while the final equivalence uses perfectness of the base field.

The argument uses `TauCeti.ker_aeval_eq_span_singleton_of_irreducible` to identify the ideal of
relations, and `TauCeti.isDomain_tensorProduct_of_isIntegrallyClosedIn` to show that its scalar
extension is prime. Flatness over the base field preserves the embedding of the coordinate
ring into the field containing the coordinates.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, second edition, Section III.6,
  Corollary 3.6.8.
-/

public section

open scoped TensorProduct IntermediateField

namespace TauCeti

variable {k F : Type*} [Field k] [Field F] [Algebra k F]

/-- An irreducible plane equation stays irreducible after a separable algebraic extension of
constants when its coordinates lie in a field with exact constants and its first coordinate is
transcendental. The coordinates need not generate the ambient field. -/
theorem irreducible_map_of_isIntegrallyClosedIn (hex : IsIntegrallyClosedIn k F)
    (L : Type*) [Field L] [Algebra k L] [Algebra.IsSeparable k L]
    {φ : MvPolynomial (Fin 2) k} (hφ : Irreducible φ) {x y : F}
    (hx : Transcendental k x) (h : MvPolynomial.aeval ![x, y] φ = 0) :
    Irreducible (φ.map (algebraMap k L)) := by
  let f : MvPolynomial (Fin 2) k →ₐ[k] F := MvPolynomial.aeval ![x, y]
  let g := Algebra.TensorProduct.map (AlgHom.id k L) f.rangeRestrict
  have hker : RingHom.ker g = Ideal.span {(1 : L) ⊗ₜ[k] φ} := by
    rw [Algebra.TensorProduct.lTensor_ker _ f.rangeRestrict_surjective, AlgHom.ker_rangeRestrict,
      ker_aeval_eq_span_singleton_of_irreducible hφ hx h, Ideal.map_span, Set.image_singleton,
      Algebra.TensorProduct.includeRight_apply]
  have : IsDomain (F ⊗[k] L) := isDomain_tensorProduct_of_isIntegrallyClosedIn hex L
  have : IsDomain (L ⊗[k] F) :=
    (Algebra.TensorProduct.comm k F L).toMulEquiv.isDomain_iff.mp inferInstance
  let j : L ⊗[k] f.range →ₐ[L] L ⊗[k] F :=
    Algebra.TensorProduct.map (AlgHom.id L L) f.range.val
  have hj : Function.Injective j :=
    Module.Flat.lTensor_preserves_injective_linearMap (M := L) f.range.val.toLinearMap
      Subtype.val_injective
  have : IsDomain (L ⊗[k] f.range) := hj.isDomain j.toRingHom
  have hp : Prime ((1 : L) ⊗ₜ[k] φ) :=
    (Ideal.span_singleton_prime (by
      rw [← map_ne_zero_iff (MvPolynomial.algebraTensorAlgEquiv k L)
        (MvPolynomial.algebraTensorAlgEquiv k L).injective]
      simpa using
        (MvPolynomial.map_injective (algebraMap k L) (algebraMap k L).injective).ne hφ.ne_zero)).mp
      (hker ▸ RingHom.ker_isPrime g)
  rw [← MulEquiv.prime_iff (MvPolynomial.algebraTensorAlgEquiv k L),
    MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul] at hp
  exact hp.irreducible

open scoped Polynomial.Bivariate in
/-- Over a perfect base field, exact constants of the function field of an irreducible plane
equation are equivalent to irreducibility of that equation over an algebraic closure of the
constants (Stichtenoth, Corollary 3.6.8). -/
theorem isIntegrallyClosedIn_iff_irreducible_map [PerfectField k]
    (L : Type*) [Field L] [Algebra k L] [Algebra.IsAlgebraic k L] [IsAlgClosed L]
    {x y : F} (hx : Transcendental k x) (hxy : k⟮x, y⟯ = ⊤) {φ : k[X][Y]}
    (hφ : Irreducible φ) (h : Polynomial.aevalAeval x y φ = 0) :
    IsIntegrallyClosedIn k F ↔
      Irreducible (φ.map (Polynomial.mapRingHom (algebraMap k L))) := by
  refine ⟨fun hex ↦ ?_, fun hirr ↦ isIntegrallyClosedIn_of_irreducible_map hx hxy hirr h⟩
  let e := Polynomial.Bivariate.equivMvPolynomial k
  have heval : MvPolynomial.aeval ![x, y] (e φ) = 0 := by
    rw [← Polynomial.Bivariate.aevalAeval_comp_equivMvPolynomial_symm, AlgHom.comp_apply,
      AlgEquiv.coe_toAlgHom, AlgEquiv.symm_apply_apply]
    exact h
  have hirr := irreducible_map_of_isIntegrallyClosedIn hex L
    ((MulEquiv.irreducible_iff e.symm).mp (by simpa using hφ)) hx heval
  simpa only [e, Polynomial.Bivariate.equivMvPolynomial_symm_map,
    AlgEquiv.symm_apply_apply] using
    (MulEquiv.irreducible_iff (Polynomial.Bivariate.equivMvPolynomial L).symm).mpr hirr

end TauCeti
