module

public import TauCeti.FieldTheory.FunctionField.PlaneCurve.Genus

import Mathlib.Algebra.Polynomial.SpecificDegree
import TauCeti.FieldTheory.RatFunc.Transcendental
import TauCeti.RingTheory.Derivation.Basic

/-!
# The genus of the Klein quartic

Let `F / k` be a field generated by a transcendental `x` and an element `y` with

`x³ y + y³ + x = 0`,

the affine equation of the Klein quartic `X³ Y + Y³ Z + Z³ X = 0`. If `k` is the exact constant
field of `F` and `7 ≠ 0` in `k`, then `F` has genus `3 = (4 - 1)(4 - 2) / 2`
(`TauCeti.genus_eq_three_of_pow_three_mul_add_pow_three_add_eq_zero`). Over an algebraically
closed field of characteristic zero both hypotheses hold
(`TauCeti.isIntegrallyClosedIn_of_isAlgClosed`).

The genus comes from the genus of a smooth plane curve, `TauCeti.genus_eq_of_aeval_eq_zero`,
which computes the different of a projection to a rational subfield. That theorem projects from
the point `(0 : 1 : 0)`, which lies on the Klein quartic: the coefficient of `y⁴` in
`x³ y + y³ + x` is zero. So the proof first changes coordinates to `u = y - x` and `v = x`. The
equation becomes

`g(u, v) = u³ + 3 u² v + 3 u v² + u v³ + v⁴ + v³ + v = 0`,

whose coefficient of `v⁴` is `1`, so the projection is now from the point `(1 : 1 : 0)`, which is
off the curve. The remaining hypotheses of `TauCeti.genus_eq_of_aeval_eq_zero` are checked as
follows.

* **Smoothness.** Both affine charts `g = 0` and `u⁴ g(1 / u, v / u) = 0` are smooth when
  `7 ≠ 0`: in each chart an explicit polynomial combination of the equation and its two partial
  derivatives equals `7`. In characteristic `7` the Klein quartic is singular.
* **Irreducibility.** As a polynomial in `u` over `k[v]`, `g` is a monic cubic. A root
  `r ∈ k[v]` would vanish at `v = 0`, and after dividing by `v` the equation would give `1 = 0`
  at `v = 0`. So `g` is irreducible.
* **Separability.** The minimal polynomial `g(u, T)` of `v` over `k(u)` has derivative with
  constant term `3 u² + 1 ≠ 0`. So `F / k(u)` is separable in every characteristic.

## Main results

* `TauCeti.genus_eq_three_of_pow_three_mul_add_pow_three_add_eq_zero`: **the Klein quartic has
  genus `3`**.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Corollary 3.4.14.
* W. Fulton, *Algebraic Curves*, Section 8.3, for the genus `(n - 1)(n - 2) / 2` of a smooth plane
  curve of degree `n`.
-/

public section

open scoped IntermediateField

namespace TauCeti

variable {k : Type*} [Field k]

section Equation

open MvPolynomial

variable (k) in
/-- The Klein quartic `x³ y + y³ + x = 0` in the coordinates `u = y - x` and `v = x`, as a
polynomial in `u = X₀` and `v = X₁`. -/
private noncomputable def affineEquation : MvPolynomial (Fin 2) k :=
  X 0 ^ 3 + 3 * X 0 ^ 2 * X 1 + 3 * X 0 * X 1 ^ 2 + X 0 * X 1 ^ 3 + X 1 ^ 4 + X 1 ^ 3 + X 1

variable (k) in
/-- The equation `u⁴ g(1 / u, v / u)` of the Klein quartic in the chart at infinity. -/
private noncomputable def infinityEquation : MvPolynomial (Fin 2) k :=
  X 0 ^ 3 * X 1 + X 0 * X 1 ^ 3 + 3 * X 0 * X 1 ^ 2 + 3 * X 0 * X 1 + X 0 + X 1 ^ 4 + X 1 ^ 3

/-- The affine equation as a sum of monomials. -/
private theorem affineEquation_eq_sum_monomial : affineEquation k =
    monomial (Finsupp.single 0 3) 1 + monomial (Finsupp.single 0 2 + Finsupp.single 1 1) 3 +
      monomial (Finsupp.single 0 1 + Finsupp.single 1 2) 3 +
      monomial (Finsupp.single 0 1 + Finsupp.single 1 3) 1 + monomial (Finsupp.single 1 4) 1 +
      monomial (Finsupp.single 1 3) 1 + monomial (Finsupp.single 1 1) 1 := by
  simp only [affineEquation, X, monomial_pow, monomial_mul_monomial, ← map_ofNat C,
    C_mul_monomial]
  simp [Finsupp.smul_single]

/-- The coefficient of `v⁴` in the affine equation is `1`. -/
private theorem coeff_single_one_four_affineEquation :
    (affineEquation k).coeff (Finsupp.single 1 4) = 1 := by
  rw [affineEquation_eq_sum_monomial]
  simp [coeff_monomial, Finsupp.ext_iff, Fin.forall_fin_two]

/-- The affine equation has total degree `4`. -/
private theorem totalDegree_affineEquation : (affineEquation k).totalDegree = 4 := by
  refine le_antisymm ?_ ?_
  · rw [affineEquation_eq_sum_monomial]
    repeat' refine (totalDegree_add _ _).trans (max_le ?_ ?_)
    all_goals exact (totalDegree_monomial_le _ _).trans (by simp [Finsupp.sum_add_index'])
  · have : Finsupp.single (1 : Fin 2) 4 ∈ (affineEquation k).support := by
      simp [mem_support_iff, coeff_single_one_four_affineEquation]
    simpa using le_totalDegree this

/-- The chart equation at infinity of the affine equation. -/
private theorem inftyChart_affineEquation :
    (affineEquation k).inftyChart 4 = infinityEquation k := by
  simp only [affineEquation, infinityEquation, inftyChart_add, X, monomial_pow,
    monomial_mul_monomial, ← map_ofNat C, C_mul_monomial, inftyChart_monomial]
  simp [Finsupp.smul_single]
  abel

/-- The affine chart of the Klein quartic is smooth when `7 ≠ 0`. -/
private theorem span_affineEquation_pderiv_eq_top (h7 : (7 : k) ≠ 0) :
    Ideal.span {affineEquation k, pderiv 0 (affineEquation k), pderiv 1 (affineEquation k)} =
      ⊤ := by
  refine Ideal.eq_top_of_isUnit_mem _ (Submodule.mem_span_triple.mpr
    ⟨-27 * X 0 * X 1 - 27 * X 1 ^ 2, 9 * X 0 ^ 2 * X 1 + 12 * X 0 * X 1 ^ 2 + 3 * X 1 ^ 3 - 7,
      6 * X 0 * X 1 ^ 2 + 6 * X 1 ^ 3 + 7, ?_⟩) ((IsUnit.mk0 _ h7).map C)
  simp [affineEquation, pderiv_X, map_ofNat]
  ring

/-- The chart at infinity of the Klein quartic is smooth when `7 ≠ 0`. -/
private theorem span_infinityEquation_pderiv_eq_top (h7 : (7 : k) ≠ 0) :
    Ideal.span {infinityEquation k, pderiv 0 (infinityEquation k),
      pderiv 1 (infinityEquation k)} = ⊤ := by
  refine Ideal.eq_top_of_isUnit_mem _ (Submodule.mem_span_triple.mpr
    ⟨-40 * X 0 ^ 4 + X 0 ^ 3 + 3 * X 0 ^ 2 * X 1 ^ 2 + 75 * X 0 ^ 2 * X 1 - 183 * X 0 ^ 2 +
      40 * X 0 * X 1 ^ 3 + 3 * X 0 * X 1 ^ 2 - 12 * X 0 * X 1 + 2 * X 0 - 31 * X 1 ^ 4 +
      24 * X 1 ^ 3 - 43 * X 1 - 77,
    10 * X 0 ^ 5 - 8 * X 0 ^ 3 * X 1 + 76 * X 0 ^ 3 - 10 * X 0 ^ 2 * X 1 ^ 3 +
      3 * X 0 ^ 2 * X 1 ^ 2 + 3 * X 0 ^ 2 * X 1 + X 0 ^ 2 + 10 * X 0 * X 1 ^ 4 -
      4 * X 0 * X 1 ^ 3 - 3 * X 0 * X 1 ^ 2 + 10 * X 0 * X 1 + 26 * X 0 + 3 * X 1 ^ 5 -
      7 * X 1 ^ 4 + 8 * X 1 ^ 3 - 9 * X 1 ^ 2 - 21 * X 1 + 7,
    10 * X 0 ^ 4 * X 1 - X 0 ^ 3 * X 1 - 3 * X 0 ^ 2 * X 1 ^ 3 - 21 * X 0 ^ 2 * X 1 ^ 2 +
      15 * X 0 ^ 2 * X 1 + 30 * X 0 ^ 2 - 10 * X 0 * X 1 ^ 4 + 6 * X 0 * X 1 ^ 2 -
      5 * X 0 * X 1 - X 0 + 7 * X 1 ^ 5 - 4 * X 1 ^ 4 - 2 * X 1 ^ 3 + 13 * X 1 ^ 2 +
      28 * X 1 + 17, ?_⟩) ((IsUnit.mk0 _ h7).map C)
  simp [infinityEquation, pderiv_X, map_ofNat]
  ring

end Equation

section Irreducible

open _root_.Polynomial

/-- The cubic `T³ + 3 X T² + (3 X² + X³) T + X⁴ + X³ + X` has no root in `k[X]`: a root vanishes
at `0`, and after dividing the equation by `X` its value at `0` is `1`. -/
private theorem cubic_ne_zero (r : k[X]) :
    r ^ 3 + 3 * X * r ^ 2 + (3 * X ^ 2 + X ^ 3) * r + (X ^ 4 + X ^ 3 + X) ≠ 0 := by
  intro h
  have h0 : r.eval 0 = 0 := by simpa using congrArg (eval 0) h
  obtain ⟨s, rfl⟩ : X ∣ r := X_dvd_iff.mpr (by rwa [coeff_zero_eq_eval_zero])
  have h' : X * (X ^ 2 * s ^ 3 + 3 * X ^ 2 * s ^ 2 + 3 * X ^ 2 * s + X ^ 3 * s + X ^ 3 + X ^ 2 + 1)
      = 0 := by linear_combination h
  simpa using congrArg (eval 0) ((mul_eq_zero.mp h').resolve_left X_ne_zero)

/-- The affine equation is irreducible: as a polynomial in `u` over `k[v]` it is a monic cubic
without roots. -/
private theorem irreducible_affineEquation : Irreducible (affineEquation k) := by
  rw [← MulEquiv.irreducible_iff (MvPolynomial.renameEquiv k (Equiv.swap 0 1)),
    ← MulEquiv.irreducible_iff (Bivariate.equivMvPolynomial k).symm]
  set p : k[X][X] :=
    X ^ 3 + C (3 * X) * X ^ 2 + C (3 * X ^ 2 + X ^ 3) * X + C (X ^ 4 + X ^ 3 + X)
  have hp : (Bivariate.equivMvPolynomial k).symm
      (MvPolynomial.renameEquiv k (Equiv.swap 0 1) (affineEquation k)) = p := by
    simp [p, affineEquation, map_ofNat]
    ring
  have hmon : p.Monic := by simp only [p]; monicity!
  have hdeg : p.natDegree = 3 := by simp only [p]; compute_degree!
  rw [hp, Monic.irreducible_iff_roots_eq_zero_of_degree_le_three hmon (by omega) (by omega)]
  refine Multiset.eq_zero_of_forall_notMem fun r hr ↦ cubic_ne_zero r ?_
  have := (mem_roots hmon.ne_zero).mp hr
  simp only [p, IsRoot, eval_add, eval_mul, eval_pow, eval_C, eval_X] at this
  linear_combination this

end Irreducible

/-- The coefficient of `v ^ n` in the affine equation, of total degree `n`, is `1`. -/
private theorem coeff_single_one_totalDegree_affineEquation :
    (affineEquation k).coeff (Finsupp.single 1 (affineEquation k).totalDegree) = 1 := by
  rw [totalDegree_affineEquation, coeff_single_one_four_affineEquation]

variable {F : Type*} [Field F] [Algebra k F] {x y : F}

/-- On the Klein quartic `x³ y + y³ + x = 0`, the coordinate `u = y - x` is transcendental over the
exact constant field when `x` is: otherwise `u` is a constant `c`, and
`x³ (x + c) + (x + c)³ + x = 0` makes `x` algebraic. -/
private theorem transcendental_sub (hex : IsIntegrallyClosedIn k F) (hx : Transcendental k x)
    (h : x ^ 3 * y + y ^ 3 + x = 0) : Transcendental k (y - x) := by
  intro halg
  obtain ⟨c, hc⟩ := IsIntegrallyClosedIn.algebraMap_eq_of_integral halg.isIntegral
  have hmon : (Polynomial.X ^ 3 * (Polynomial.X + Polynomial.C c) +
      (Polynomial.X + Polynomial.C c) ^ 3 + Polynomial.X : Polynomial k).Monic := by
    monicity!
  refine hx ⟨_, hmon.ne_zero, ?_⟩
  simp only [map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hc]
  linear_combination h

section RatFunc

/-! ### The Klein quartic over `k(u)`, for `u = y - x` -/

variable [Algebra (RatFunc k) F] [IsScalarTower k (RatFunc k) F]
  (hX : algebraMap (RatFunc k) F RatFunc.X = y - x)
include hX

omit [IsScalarTower k (RatFunc k) F] in
/-- In the coordinates `u = y - x` and `v = x`, the point `(x, y)` of the Klein quartic satisfies
the affine equation. -/
private theorem aeval_affineEquation (h : x ^ 3 * y + y ^ 3 + x = 0) :
    MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, x] (affineEquation k) = 0 := by
  rw [hX]
  simp [affineEquation]
  linear_combination h

/-- If `x` and `y` generate `F` over `k`, then `x` generates `F` over `k(u)`. -/
private theorem adjoin_simple_eq_top (hgen : k⟮x, y⟯ = ⊤) : (RatFunc k)⟮x⟯ = ⊤ := by
  have hxK : x ∈ (RatFunc k)⟮x⟯ := IntermediateField.mem_adjoin_simple_self (RatFunc k) x
  have hy : y = algebraMap (RatFunc k) F RatFunc.X + x := by rw [hX]; ring
  have hyK : y ∈ (RatFunc k)⟮x⟯ := by
    rw [hy]
    exact add_mem (IntermediateField.algebraMap_mem _ _) hxK
  have hle : k⟮x, y⟯ ≤ ((RatFunc k)⟮x⟯).restrictScalars k := by
    rw [IntermediateField.adjoin_le_iff, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨(IntermediateField.mem_restrictScalars k).mpr hxK,
      (IntermediateField.mem_restrictScalars k).mpr hyK⟩
  rw [hgen] at hle
  exact eq_top_iff.mpr fun z _ ↦
    (IntermediateField.mem_restrictScalars k).mp (hle IntermediateField.mem_top)

/-- `F` is finite and separable over `k(u)`: `v = x` is a root of the monic polynomial `g(u, T)`,
which is its minimal polynomial since `g` is irreducible, and the derivative of `g(u, T)` has
constant term `3 u² + 1 ≠ 0`. -/
private theorem finiteDimensional_and_isSeparable (hgen : k⟮x, y⟯ = ⊤)
    (h : x ^ 3 * y + y ^ 3 + x = 0) :
    FiniteDimensional (RatFunc k) F ∧ Algebra.IsSeparable (RatFunc k) F := by
  have hfin : FiniteDimensional (RatFunc k) F := Module.finite_of_finrank_pos (by
    rw [finrank_ratFunc_eq_totalDegree_of_aeval_eq_zero irreducible_affineEquation
      coeff_single_one_totalDegree_affineEquation (adjoin_simple_eq_top hX hgen)
      (aeval_affineEquation hX h), totalDegree_affineEquation]
    norm_num)
  have hmin := minpoly_ratFunc_eq_map_of_aeval_eq_zero irreducible_affineEquation
    (Polynomial.Bivariate.monic_equivMvPolynomial_symm le_rfl
      coeff_single_one_totalDegree_affineEquation) (aeval_affineEquation hX h)
  have hint := IsIntegral.of_finite (RatFunc k) x
  have hsep : IsSeparable (RatFunc k) x := by
    rw [IsSeparable, Polynomial.separable_iff_derivative_ne_zero (minpoly.irreducible hint),
      hmin, Polynomial.derivative_map]
    refine (Polynomial.map_ne_zero_iff
      (IsFractionRing.injective (Polynomial k) (RatFunc k))).mpr fun h0 ↦ ?_
    have h1 := congrArg (Polynomial.eval 0) h0
    simp [affineEquation, map_ofNat, Polynomial.derivative_pow] at h1
    simpa using congrArg (Polynomial.eval 0) h1
  let e : (RatFunc k)⟮x⟯ ≃ₐ[RatFunc k] F :=
    (IntermediateField.equivOfEq (adjoin_simple_eq_top hX hgen)).trans
      IntermediateField.topEquiv
  have := (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable (RatFunc k) F).mpr hsep
  exact ⟨hfin, AlgEquiv.Algebra.isSeparable e⟩

end RatFunc

/-- **The Klein quartic has genus three**: let `F / k` be generated by a transcendental `x` and an
element `y` with `x³ y + y³ + x = 0`. If `k` is the exact constant field of `F` and `7 ≠ 0` in
`k`, then `F` has genus `3`. This is the genus `(n - 1)(n - 2) / 2` of a smooth plane curve of
degree `n = 4`. -/
theorem genus_eq_three_of_pow_three_mul_add_pow_three_add_eq_zero
    (hex : IsIntegrallyClosedIn k F) (h7 : (7 : k) ≠ 0) (hx : Transcendental k x)
    (hgen : k⟮x, y⟯ = ⊤) (h : x ^ 3 * y + y ^ 3 + x = 0) :
    genus k F = 3 := by
  -- View `F` over `k(u)` for `u = y - x`, generated by `v = x` with `g(u, v) = 0`.
  have hu := transcendental_sub hex hx h
  let _ := ratFuncAlgebraOfTranscendental hu
  have := isScalarTower_ratFuncAlgebraOfTranscendental hu
  have hX := algebraMap_ratFuncAlgebraOfTranscendental_X hu
  obtain ⟨_, _⟩ := finiteDimensional_and_isSeparable hX hgen h
  rw [genus_eq_of_aeval_eq_zero hex irreducible_affineEquation
      coeff_single_one_totalDegree_affineEquation (span_affineEquation_pderiv_eq_top h7)
      (by rw [totalDegree_affineEquation, inftyChart_affineEquation]
          exact span_infinityEquation_pderiv_eq_top h7)
      (adjoin_simple_eq_top hX hgen) (aeval_affineEquation hX h),
    totalDegree_affineEquation]

end TauCeti
