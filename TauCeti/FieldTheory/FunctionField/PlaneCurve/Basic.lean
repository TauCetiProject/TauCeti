module

public import TauCeti.Algebra.MvPolynomial.FinTwo
public import TauCeti.FieldTheory.FunctionField.Basic

/-!
# The function field of a plane curve

A field `F` generated over `k` by a transcendental element `x` and a root `y` of `g(x, Y)`, for a
nonzero `g ∈ k[X, Y]`, is an algebraic function field over `k`: `y` is algebraic over `k(x)`, so
`F / k(x)` is finite.

## Main results

* `TauCeti.isFunctionField_of_aeval_eq_zero`: a field generated by a transcendental `x` and a root
  `y` of a nonzero `g(x, Y)` is an algebraic function field.
-/

public section

open Polynomial

open scoped IntermediateField

namespace TauCeti

variable {k F : Type*} [Field k] [Field F] [Algebra k F]

/-- **The function field of a plane curve**: a field generated over `k` by a transcendental `x`
and a root `y` of `g(x, Y)`, for a nonzero `g ∈ k[X, Y]`, is an algebraic function field. -/
theorem isFunctionField_of_aeval_eq_zero {g : MvPolynomial (Fin 2) k} (hg : g ≠ 0)
    {x y : F} (hx : Transcendental k x) (hgen : k⟮x, y⟯ = ⊤)
    (h : MvPolynomial.aeval ![x, y] g = 0) : IsFunctionField k F := by
  set q := (Polynomial.Bivariate.equivMvPolynomial k).symm g
  have hq : q ≠ 0 := (map_ne_zero_iff _ (AlgEquiv.injective _)).mpr hg
  set x' := IntermediateField.AdjoinSimple.gen k x
  have hx' : Transcendental k x' :=
    (transcendental_algebraMap_iff (algebraMap k⟮x⟯ F).injective).mp
      (by rwa [IntermediateField.AdjoinSimple.algebraMap_gen])
  -- View `k(x)` as a `k[X]`-algebra with `X ↦ x`; then `y` is a root of `g(x, Y) ≠ 0`.
  let _ : Algebra k[X] k⟮x⟯ := (Polynomial.aeval x').toRingHom.toAlgebra
  have : IsScalarTower k k[X] k⟮x⟯ := .of_algebraMap_eq fun c ↦ by
    simp [RingHom.algebraMap_toAlgebra]
  have hy : IsAlgebraic k⟮x⟯ y := by
    refine ⟨q.map (algebraMap k[X] k⟮x⟯),
      (Polynomial.map_ne_zero_iff (transcendental_iff_injective.mp hx')).mpr hq, ?_⟩
    rw [Polynomial.Bivariate.aeval_map_eq_aeval_equivMvPolynomial, AlgEquiv.apply_symm_apply]
    convert h using 2
    ext i
    fin_cases i <;> simp [RingHom.algebraMap_toAlgebra, x']
  have htop : k⟮x⟯⟮y⟯ = ⊤ := IntermediateField.restrictScalars_injective k <| by
    rw [IntermediateField.adjoin_simple_adjoin_simple, hgen, IntermediateField.restrictScalars_top]
  have := IntermediateField.adjoin.finiteDimensional hy.isIntegral
  have : FiniteDimensional k⟮x⟯ F := ((IntermediateField.equivOfEq htop).trans
    IntermediateField.topEquiv).toLinearEquiv.finiteDimensional
  exact hx.isFunctionField_adjoin.finite_extension

end TauCeti
