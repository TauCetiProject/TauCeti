/-!
# The genus of a smooth projective plane curve

Let `G ∈ k[X₀, X₁, X₂]` be homogeneous of degree `d`, and suppose the projective curve `G = 0` is
nonsingular: at every point `(b₀ : b₁ : b₂)` of `G = 0` over an algebraically closed extension
`K` of `k`, some partial derivative of `G` is nonzero. Let `F / k` be generated by `x` and `y`
with `G(x, y, 1) = 0`, where `x` is transcendental. Then

`g(F) = (d - 1)(d - 2) / 2`.

`TauCeti.genus_eq_of_aeval_eq_zero` proves this for the projection `(x, y) ↦ x` from the point
`(0 : 1 : 0)`, provided that this point is off the curve, both affine charts are smooth, and
`F / k(x)` is separable. Here the centre of projection is chosen instead. For `c ∈ k` the shear
`X₀ ↦ X₀ + c X₁` turns projection from `(c : 1 : 0)` into projection from `(0 : 1 : 0)`, with the
coordinate `u = x - c y`. Two conditions on `c` make the theorem applicable:

* `(c : 1 : 0)` is off the curve, `G(c, 1, 0) ≠ 0`. The binary form `G(X₀, X₁, 0)` is nonzero:
  otherwise the line at infinity `X₂ = 0` would be a component of the curve, and the curve would
  be singular where this line meets the rest of it. So at most `d` values of `c` are excluded.
* the projection is separable: `c ∂G/∂X₀ + ∂G/∂X₁` does not vanish at `(x, y, 1)`. Since the
  affine curve is smooth, the two partial derivatives do not vanish together at `(x, y, 1)`, so
  at most one value of `c` is excluded.

Nonsingularity is a condition at the points over `K`; the weak Nullstellensatz turns it into the
ideal-theoretic smoothness of the affine charts that `TauCeti.genus_eq_of_aeval_eq_zero` uses
(`TauCeti.span_insert_range_pderiv_dehomogenize_eq_top`), and the shear preserves it
(`MvPolynomial.exists_aeval_pderiv_linearSubst_ne_zero`). A suitable `c` exists once `k` has more
than `d + 1` elements. A small finite constant field is first enlarged by a finite constant field
extension, which preserves the genus. No irreducibility or exactness hypothesis is needed: the
affine equation `G(X₀, X₁, 1)` of a nonsingular projective plane curve is irreducible over `K`,
hence over every intermediate field of `K / k` (`TauCeti.irreducible_map_dehomogenize`), and this
makes `k` the exact constant field of `F` (`TauCeti.isIntegrallyClosedIn_of_irreducible_map`).

## Main results

* `TauCeti.exists_isSeparable_finrank_eq_of_isHomogeneous_of_lt_card`: over a field with more
  than `d + 1` elements, a centre of projection `(c : 1 : 0)` off a smooth projective plane curve
  of degree `d` whose linear coordinate `u = x - c y` is separating, with `[F : k(u)] = d`.
* `TauCeti.genus_eq_of_isHomogeneous_of_lt_card`: the genus `(d - 1)(d - 2) / 2` of a smooth
  projective plane curve of degree `d` over a field with more than `d + 1` elements.
* `TauCeti.genus_eq_of_isHomogeneous`: the same over every field `k`.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Corollary 3.4.14 and Theorem 3.6.3.
* W. Fulton, *Algebraic Curves*, Sections 5.1 and 8.3.
-/

public section

open scoped IntermediateField Polynomial

open MvPolynomial

namespace TauCeti

variable {k : Type*} [Field k]

/-! ### The line at infinity is not a component of a smooth curve -/

section LineAtInfinity

variable {K : Type*} [Field K] [Algebra k K] {G : MvPolynomial (Fin 3) k} {d : ℕ}

/-- If the binary form `G(X₀, X₁, 0)` vanishes, then every point of the line at infinity lies on
`G = 0`. -/
private theorem aeval_eq_zero_of_apply_two_eq_zero [Infinite K] (hG : G.IsHomogeneous d)
    (hP : aeval ![Polynomial.X, 1, 0] G = (0 : k[X])) {b : Fin 3 → K} (hb : b 2 = 0) :
    aeval b G = 0 := by
  -- The points `(t : 1 : 0)`, and by homogeneity every point `(b₀ : b₁ : 0)` with `b₁ ≠ 0`.
  have h1 : ∀ t : K, aeval ![t, 1, 0] G = 0 := fun t ↦ by
    have := congrArg (Polynomial.aeval t) hP
    rw [map_zero, comp_aeval_apply] at this
    convert this using 2
    ext i
    fin_cases i <;> simp
  have h2 : ∀ b : Fin 3 → K, b 2 = 0 → b 1 ≠ 0 → aeval b G = 0 := fun b hb2 hb1 ↦ by
    have hb : b = b 1 • ![b 0 / b 1, 1, 0] := by
      ext i
      fin_cases i <;> simp [hb2, hb1, mul_div_cancel₀]
    rw [hb, hG.aeval_smul, h1, smul_zero]
  by_cases hb1 : b 1 = 0
  · -- The point `(1 : 0 : 0)` is a zero of `t ↦ G(1, t, 0)`, which vanishes for `t ≠ 0`.
    have hR : (aeval ![1, Polynomial.X, 0] G : K[X]) = 0 :=
      Polynomial.eq_zero_of_infinite_isRoot _ <|
        (Set.finite_singleton (0 : K)).infinite_compl.mono fun t (ht : t ≠ 0) ↦ by
          rw [Set.mem_ofPred_eq, Polynomial.IsRoot.def, ← Polynomial.coe_aeval_eq_eval,
            ← AlgHom.coe_restrictScalars' k (Polynomial.aeval t), comp_aeval_apply]
          convert h2 ![1, t, 0] rfl ht using 2
          ext i
          fin_cases i <;> simp
    have h3 : aeval ![(1 : K), 0, 0] G = 0 := by
      have := congrArg ((Polynomial.aeval (0 : K)).restrictScalars k) hR
      rw [comp_aeval_apply, map_zero] at this
      convert this using 2
      ext i
      fin_cases i <;> simp
    have hb' : b = b 0 • ![1, 0, 0] := by
      ext i
      fin_cases i <;> simp [hb1, hb]
    rw [hb', hG.aeval_smul, h3, smul_zero]
  · exact h2 b hb hb1

/-- If the binary form `G(X₀, X₁, 0)` vanishes, then along the line at infinity the partial
derivatives `∂G/∂X₀` and `∂G/∂X₁` vanish as well. -/
private theorem aeval_pderiv_castSucc_eq_zero_of_apply_two_eq_zero [Infinite K]
    (hG : G.IsHomogeneous d) (hP : aeval ![Polynomial.X, 1, 0] G = (0 : k[X])) (l : Fin 2)
    {b : Fin 3 → K} (hb : b 2 = 0) : aeval b (pderiv l.castSucc G) = 0 := by
  -- The restriction `B = G(X₀, X₁, 0)` vanishes identically.
  set f : Fin 3 → MvPolynomial (Fin 2) k := ![X 0, X 1, 0]
  have hB : aeval f G = 0 := by
    refine map_injective (algebraMap k K) (algebraMap k K).injective ?_
    rw [map_zero]
    refine MvPolynomial.funext fun v ↦ ?_
    rw [eval_map, ← aeval_def, comp_aeval_apply, map_zero]
    refine aeval_eq_zero_of_apply_two_eq_zero hG hP ?_
    simp [f]
  -- Its partial derivatives are the restrictions of those of `G`.
  have hd : pderiv l (aeval f G) = aeval f (pderiv l.castSucc G) := by
    rw [pderiv_aeval, Fin.sum_univ_three]
    fin_cases l <;> simp [f, pderiv_X]
  have hb' : b = fun i ↦ aeval ![b 0, b 1] (f i) := by
    ext i
    fin_cases i <;> simp [f, hb]
  rw [hb', ← comp_aeval_apply, ← hd, hB, map_zero, map_zero]

/-- A nonzero point of the line at infinity at which a homogeneous polynomial `C` of positive
degree vanishes: the curve `C = 0` meets the line `X₂ = 0`, by the dimension theorem. -/
private theorem exists_ne_zero_apply_two_eq_zero_aeval_eq_zero [IsAlgClosed K]
    {C : MvPolynomial (Fin 3) k} {e : ℕ} (hC : C.IsHomogeneous e) (he : e ≠ 0) :
    ∃ b : Fin 3 → K, b ≠ 0 ∧ b 2 = 0 ∧ aeval b C = 0 := by
  classical
  obtain ⟨b, hb, hbs⟩ := exists_ne_zero_forall_aeval_eq_zero (K := K) (s := {C, X 2})
    (Finset.card_le_two.trans_lt (by simp)) (by simp [hC.constantCoeff_eq_zero he])
  exact ⟨b, hb, by simpa using hbs (X 2) (by simp), hbs C (by simp)⟩

/-- **The line at infinity is not a component of a smooth plane curve**: if `G` is homogeneous and
nonsingular at every point of `G = 0` over an algebraically closed extension `K` of `k`, and `G`
has a zero `(x : y : 1)` in a field extension of `k`, then the binary form `G(X₀, X₁, 0)` is
nonzero. Otherwise every point of the line at infinity lies on the curve, and the curve is
singular where that line meets the rest of it; in degree at most one, `G` would be a nonzero
multiple of `X₂`, which has no zero `(x : y : 1)`. -/
private theorem aeval_X_one_zero_ne_zero [IsAlgClosed K] (hG : G.IsHomogeneous d)
    (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ l, aeval b (pderiv l G) ≠ 0)
    {F : Type*} [Field F] [Algebra k F] {x y : F} (h : aeval ![x, y, 1] G = 0) :
    aeval ![Polynomial.X, 1, 0] G ≠ (0 : k[X]) := by
  intro hP
  -- At a point of the line at infinity only `∂G/∂X₂` can be nonzero.
  have hsing : ∀ b : Fin 3 → K, b ≠ 0 → b 2 = 0 → aeval b (pderiv 2 G) ≠ 0 :=
    fun b hb0 hb2 h2 ↦ by
      obtain ⟨l, hl⟩ := hsm b hb0 (aeval_eq_zero_of_apply_two_eq_zero hG hP hb2)
      fin_cases l
      · exact hl (aeval_pderiv_castSucc_eq_zero_of_apply_two_eq_zero hG hP 0 hb2)
      · exact hl (aeval_pderiv_castSucc_eq_zero_of_apply_two_eq_zero hG hP 1 hb2)
      · exact hl h2
  rcases Nat.lt_or_ge d 2 with hd | hd
  · -- In degree at most one the partial derivatives are constants, and Euler's identity reads
    -- `d • G = X₀ ∂₀G + X₁ ∂₁G + X₂ ∂₂G` with `∂₀G = ∂₁G = 0` and `∂₂G ≠ 0`.
    have hC : ∀ l, pderiv l G = C ((pderiv l G).coeff 0) := fun l ↦
      totalDegree_eq_zero_iff_eq_C.mp ((totalDegree_zero_iff_isHomogeneous _).mpr
        (by simpa [show d - 1 = 0 by omega] using hG.pderiv (i := l)))
    have h1 : ∀ l : Fin 2, (pderiv l.castSucc G).coeff 0 = 0 := fun l ↦ by
      have := aeval_pderiv_castSucc_eq_zero_of_apply_two_eq_zero hG hP l
        (b := ![(1 : K), 0, 0]) rfl
      rwa [hC, aeval_C, map_eq_zero] at this
    have h2 := hsing ![1, 0, 0] (fun h ↦ by simpa using congrFun h 0) rfl
    rw [hC, aeval_C, ne_eq, map_eq_zero] at h2
    have heuler := congrArg (aeval ![x, y, 1]) hG.sum_X_mul_pderiv
    rw [map_nsmul, h, nsmul_zero, map_sum, Fin.sum_univ_three] at heuler
    have h10 := h1 0
    have h11 := h1 1
    simp only [Fin.castSucc_zero, Fin.castSucc_one] at h10 h11
    rw [hC 0, hC 1, hC 2, h10, h11] at heuler
    simp only [Fin.isValue, mul_zero, map_zero, add_zero, map_mul, aeval_X, Matrix.cons_val,
      algHom_C, one_mul, zero_add, map_eq_zero] at heuler
    exact h2 heuler
  · obtain ⟨b, hb0, hb2, hb⟩ :=
      exists_ne_zero_apply_two_eq_zero_aeval_eq_zero (K := K) (hG.pderiv (i := 2))
        (by omega : d - 1 ≠ 0)
    exact hsing b hb0 hb2 hb

end LineAtInfinity

/-! ### Choosing the centre of projection -/

section Centre

variable {G : MvPolynomial (Fin 3) k} {d : ℕ}

/-- The binary form `G(T, 1, 0)` has degree at most `d`. -/
private theorem natDegree_aeval_X_one_zero_le (hG : G.IsHomogeneous d) :
    (aeval ![Polynomial.X, 1, 0] G : k[X]).natDegree ≤ d := by
  conv_lhs => rw [G.as_sum]
  rw [map_sum]
  refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun s hs ↦ ?_
  have hdeg : s 0 + s 1 + s 2 = d := by
    simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_three] using
      hG (mem_support_iff.mp hs)
  rw [aeval_monomial, Finsupp.prod_fintype _ _ (by simp), Fin.prod_univ_three]
  rcases eq_or_ne (s 2) 0 with h2 | h2
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, one_pow, h2,
      pow_zero, mul_one, Polynomial.algebraMap_eq]
    exact (Polynomial.natDegree_C_mul_X_pow_le _ _).trans (by omega)
  · simp [h2]

/-- **A centre of projection off the curve, avoiding one slope**: if `k` has more than `d + 1`
elements, `G(X₀, X₁, 0) ≠ 0`, and `a, b ∈ F` are not both zero, then some `c ∈ k` satisfies
`G(c, 1, 0) ≠ 0` and `c a + b ≠ 0`. The first condition excludes the at most `d` roots of
`G(T, 1, 0)`, the second at most one value of `c`. -/
private theorem exists_eval_ne_zero_and_mul_add_ne_zero (hG : G.IsHomogeneous d)
    (hP : aeval ![Polynomial.X, 1, 0] G ≠ (0 : k[X]))
    (hcard : ((d + 1 : ℕ) : ℕ∞) < ENat.card k) {F : Type*} [Field F] [Algebra k F] {a b : F}
    (hab : a ≠ 0 ∨ b ≠ 0) :
    ∃ c : k, eval ![c, 1, 0] G ≠ 0 ∧ algebraMap k F c * a + b ≠ 0 := by
  set P : k[X] := aeval ![Polynomial.X, 1, 0] G
  have hPc : ∀ c, P.eval c = eval ![c, 1, 0] G := fun c ↦ by
    have hv : (fun i ↦ Polynomial.aeval c ((![Polynomial.X, 1, 0] : Fin 3 → k[X]) i)) =
        ![c, 1, 0] := by
      ext i
      fin_cases i <;> simp
    rw [← Polynomial.coe_aeval_eq_eval, comp_aeval_apply, hv, aeval_eq_eval]
  have hPdeg : P.natDegree ≤ d := natDegree_aeval_X_one_zero_le hG
  have hcard' := Cardinal.natCast_lt_toENat.mp hcard
  by_cases hc₀ : ∃ c₀ : k, algebraMap k F c₀ * a + b = 0
  · obtain ⟨c₀, hc₀⟩ := hc₀
    have hQ : P * (Polynomial.X - Polynomial.C c₀) ≠ 0 :=
      mul_ne_zero hP (Polynomial.X_sub_C_ne_zero c₀)
    have hQdeg : (P * (Polynomial.X - Polynomial.C c₀)).natDegree < Cardinal.mk k :=
      lt_of_le_of_lt (Nat.cast_le.mpr (Polynomial.natDegree_mul_le.trans
        (by rw [Polynomial.natDegree_X_sub_C]; omega))) hcard'
    obtain ⟨c, hc⟩ := Polynomial.exists_eval_ne_zero_of_natDegree_lt_card _ hQ hQdeg
    rw [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] at hc
    refine ⟨c, hPc c ▸ left_ne_zero_of_mul hc, fun h ↦ ?_⟩
    -- Two slopes `c ≠ c₀` with `c a + b = c₀ a + b = 0` force `a = b = 0`.
    have ha : a = 0 := by
      have h' : algebraMap k F (c - c₀) * a = 0 := by
        rw [map_sub]
        linear_combination h - hc₀
      exact (mul_eq_zero.mp h').resolve_left ((map_ne_zero _).mpr (right_ne_zero_of_mul hc))
    have hb : b = 0 := by simpa [ha] using hc₀
    exact hab.elim (· ha) (· hb)
  · simp only [not_exists] at hc₀
    obtain ⟨c, hc⟩ := Polynomial.exists_eval_ne_zero_of_natDegree_lt_card _ hP
      (lt_of_le_of_lt (Nat.cast_le.mpr (hPdeg.trans (by omega))) hcard')
    exact ⟨c, hPc c ▸ hc, hc₀ c⟩

end Centre

/-! ### The shear moving the centre of projection to `(0 : 1 : 0)` -/

section Shear

/-- The linear change of homogeneous coordinates `X₀ ↦ X₀ + c X₁`. It fixes the line at infinity
and pulls back the curve `G = 0` along the map sending `(0 : 1 : 0)` to `(c : 1 : 0)`. -/
private def shear (c : k) : Matrix (Fin 3) (Fin 3) k :=
  !![1, c, 0; 0, 1, 0; 0, 0, 1]

private theorem det_shear (c : k) : (shear c).det = 1 := by
  simp [shear, Matrix.det_fin_three]

private theorem aeval_linearSubst_shear {A : Type*} [CommSemiring A] [Algebra k A] (c : k)
    (v : Fin 3 → A) (p : MvPolynomial (Fin 3) k) :
    aeval v (linearSubst (shear c) p) = aeval ![v 0 + algebraMap k A c * v 1, v 1, v 2] p := by
  rw [aeval_linearSubst]
  congr 2
  ext i
  fin_cases i <;> simp [shear, Matrix.mulVec, dotProduct, Fin.sum_univ_three, mul_comm]

/-- The shear `X₀ ↦ X₀ + c X₁` of the affine coordinates. -/
private noncomputable def shearEquiv (c : k) :
    MvPolynomial (Fin 2) k ≃ₐ[k] MvPolynomial (Fin 2) k :=
  AlgEquiv.ofAlgHom (aeval ![X 0 + C c * X 1, X 1]) (aeval ![X 0 - C c * X 1, X 1])
    (algHom_ext fun i ↦ by fin_cases i <;> simp) (algHom_ext fun i ↦ by fin_cases i <;> simp)

private theorem dehomogenize_linearSubst_shear (c : k) (p : MvPolynomial (Fin 3) k) :
    dehomogenize 2 (linearSubst (shear c) p) = shearEquiv c (dehomogenize 2 p) := by
  have h : (dehomogenize 2).comp (linearSubst (shear c)) =
      (shearEquiv c : MvPolynomial (Fin 2) k →ₐ[k] MvPolynomial (Fin 2) k).comp
        (dehomogenize 2) := by
    refine algHom_ext fun i ↦ ?_
    have h0 : dehomogenize (R := k) (2 : Fin 3) (X 0) = X 0 := by simp; rfl
    have h1 : dehomogenize (R := k) (2 : Fin 3) (X 1) = X 1 := by simp; rfl
    have h2 : dehomogenize (R := k) (2 : Fin 3) (X 2) = 1 := by simp
    fin_cases i <;> simp [shear, shearEquiv, Fin.sum_univ_three, h0, h1, h2]
  exact AlgHom.congr_fun h p

end Shear

/-! ### The genus -/

section Genus

variable {F : Type*} [Field F] [Algebra k F]

/-- The affine point `(u, v)` in homogeneous coordinates `(u : v : w)`, here with `w = 1`. -/
private theorem insertNth_two {A : Type*} (u v w : A) :
    (2 : Fin 3).insertNth w ![u, v] = ![u, v, w] := by
  ext i
  fin_cases i <;> rfl

private theorem insert_range_fin_two {A : Type*} (p : Fin 2 → A) (q : A) :
    insert q (Set.range p) = {q, p 0, p 1} := by
  ext r
  simp only [Set.mem_insert_iff, Set.mem_range, Fin.exists_fin_two]
  constructor <;> rintro (rfl | rfl | rfl) <;> simp

/-- The affine chart `X₂ ≠ 0` of a nonsingular projective plane curve is smooth. -/
private theorem span_dehomogenize_two_pderiv_eq_top {K : Type*} [Field K] [IsAlgClosed K]
    [Algebra k K] {G : MvPolynomial (Fin 3) k} {d : ℕ} (hG : G.IsHomogeneous d)
    (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ l, aeval b (pderiv l G) ≠ 0) :
    Ideal.span {dehomogenize 2 G, pderiv 0 (dehomogenize 2 G), pderiv 1 (dehomogenize 2 G)} =
      ⊤ := by
  have h := span_insert_range_pderiv_dehomogenize_eq_top hG 2
    fun a ↦ hsm _ fun h ↦ by simpa using congrFun h 2
  rwa [insert_range_fin_two] at h

/-- The chart at infinity `X₀ ≠ 0` of a nonsingular projective plane curve is smooth, in the
coordinates `(X₂ / X₀, X₁ / X₀)` of `MvPolynomial.inftyChart`. -/
private theorem span_inftyChart_pderiv_eq_top {K : Type*} [Field K] [IsAlgClosed K]
    [Algebra k K] {G : MvPolynomial (Fin 3) k} {d : ℕ} (hG : G.IsHomogeneous d)
    (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ l, aeval b (pderiv l G) ≠ 0) :
    Ideal.span {(dehomogenize 2 G).inftyChart d, pderiv 0 ((dehomogenize 2 G).inftyChart d),
      pderiv 1 ((dehomogenize 2 G).inftyChart d)} = ⊤ := by
  rw [inftyChart_dehomogenize hG]
  have h0 := span_insert_range_pderiv_dehomogenize_eq_top hG 0
    fun a ↦ hsm _ fun h ↦ by simpa using congrFun h 0
  rw [insert_range_fin_two] at h0
  set h₀ := dehomogenize 0 G
  -- Swapping the two coordinates permutes the partial derivatives.
  have hsw : ∀ j : Fin 2, pderiv j (rename (Equiv.swap 0 1) h₀) =
      rename (Equiv.swap 0 1) (pderiv (Equiv.swap 0 1 j) h₀) := fun j ↦ by
    simpa using pderiv_rename (Equiv.swap (0 : Fin 2) 1).injective (Equiv.swap 0 1 j) h₀
  have := congrArg (Ideal.map (rename (R := k) (Equiv.swap (0 : Fin 2) 1))) h0
  rw [Ideal.map_span, Ideal.map_top] at this
  rw [hsw 0, hsw 1, Equiv.swap_apply_left, Equiv.swap_apply_right, ← this, Set.image_insert_eq,
    Set.image_insert_eq, Set.image_singleton, Set.pair_comm (rename _ (pderiv 0 h₀))]

/-- If `k(X)` acts on `F` with `X ↦ x - c y` and `x, y` generate `F` over `k`, then `y` generates
`F` over `k(X)`. -/
private theorem adjoin_simple_eq_top_of_algebraMap_X_eq [Algebra (RatFunc k) F]
    [IsScalarTower k (RatFunc k) F] {x y : F} {c : k}
    (hX : algebraMap (RatFunc k) F RatFunc.X = x - algebraMap k F c * y) (hgen : k⟮x, y⟯ = ⊤) :
    (RatFunc k)⟮y⟯ = ⊤ := by
  have hyK : y ∈ (RatFunc k)⟮y⟯ := IntermediateField.mem_adjoin_simple_self (RatFunc k) y
  have hxK : x ∈ (RatFunc k)⟮y⟯ := by
    have hx : x = algebraMap (RatFunc k) F RatFunc.X +
        algebraMap (RatFunc k) F (algebraMap k (RatFunc k) c) * y := by
      rw [hX, ← IsScalarTower.algebraMap_apply]
      ring
    rw [hx]
    exact add_mem (IntermediateField.algebraMap_mem _ _)
      (mul_mem (IntermediateField.algebraMap_mem _ _) hyK)
  have hle : k⟮x, y⟯ ≤ ((RatFunc k)⟮y⟯).restrictScalars k := by
    rw [IntermediateField.adjoin_le_iff, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨(IntermediateField.mem_restrictScalars k).mpr hxK,
      (IntermediateField.mem_restrictScalars k).mpr hyK⟩
  rw [hgen] at hle
  exact eq_top_iff.mpr fun z _ ↦
    (IntermediateField.mem_restrictScalars k).mp (hle IntermediateField.mem_top)

variable {K : Type*} [Field K] [IsAlgClosed K] [Algebra k K] {G : MvPolynomial (Fin 3) k} {d : ℕ}

/-- The affine equation `G(X₀, X₁, 1)` of a nonsingular projective plane curve with a point
`(x : y : 1)` over `F` is irreducible over `K`: it is not a unit, since it vanishes at `(x, y)`. -/
private theorem irreducible_map_dehomogenize_two (hG : G.IsHomogeneous d)
    (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ l, aeval b (pderiv l G) ≠ 0)
    {x y : F} (h : aeval ![x, y, 1] G = 0) :
    Irreducible ((dehomogenize 2 G).map (algebraMap k K)) := by
  refine irreducible_map_dehomogenize le_rfl hG hsm 2 fun hu ↦ ?_
  obtain ⟨c, hc, hcG⟩ := isUnit_iff_eq_C_of_isReduced.mp hu
  have hxy := congrArg (aeval ![x, y]) hcG
  rw [aeval_dehomogenize, insertNth_two, h, aeval_C] at hxy
  exact hc.ne_zero ((map_eq_zero_iff _ (algebraMap k F).injective).mp hxy.symm)

/-- **The projected equation of a smooth projective plane curve**: under the hypotheses of
`TauCeti.genus_eq_of_isHomogeneous_of_lt_card`, some `c ∈ k` with `G(c, 1, 0) ≠ 0` makes
`u = x - c y` transcendental, and the sheared affine equation `g' ∈ k[X, Y]` is irreducible of
total degree `d` with the coefficient of `Y^d` equal to `1`, smooth in both affine charts, and
satisfies `g'(u, y) = 0` and `∂g'/∂Y (u, y) ≠ 0`. -/
private theorem exists_aeval_sub_mul_eq_zero (hG : G.IsHomogeneous d)
    (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ l, aeval b (pderiv l G) ≠ 0)
    (hcard : ((d + 1 : ℕ) : ℕ∞) < ENat.card k)
    {x y : F} (hx : Transcendental k x) (h : aeval ![x, y, 1] G = 0) :
    ∃ (c : k) (g' : MvPolynomial (Fin 2) k), eval ![c, 1, 0] G ≠ 0 ∧
      Transcendental k (x - algebraMap k F c * y) ∧ Irreducible g' ∧
      g'.coeff (Finsupp.single 1 g'.totalDegree) = 1 ∧ g'.totalDegree = d ∧
      Ideal.span {g', pderiv 0 g', pderiv 1 g'} = ⊤ ∧
      Ideal.span {g'.inftyChart g'.totalDegree, pderiv 0 (g'.inftyChart g'.totalDegree),
        pderiv 1 (g'.inftyChart g'.totalDegree)} = ⊤ ∧
      aeval ![x - algebraMap k F c * y, y] g' = 0 ∧
      aeval ![x - algebraMap k F c * y, y] (pderiv 1 g') ≠ 0 := by
  have hpt : ∀ u v : F, (2 : Fin 3).insertNth 1 ![u, v] = ![u, v, 1] := fun u v ↦
    insertNth_two u v 1
  have h21 : (2 : Fin 3).succAbove 1 = 1 := rfl
  have h20 : (2 : Fin 3).succAbove 0 = 0 := rfl
  set g := dehomogenize 2 G with hg_def
  -- The affine chart is smooth, so `∂g/∂X₀` and `∂g/∂X₁` do not both vanish at `(x, y)`.
  have hsm2 := span_dehomogenize_two_pderiv_eq_top hG hsm
  have hgxy : aeval ![x, y] g = 0 := by rw [aeval_dehomogenize, hpt, h]
  set a := aeval ![x, y, 1] (pderiv 0 G) with ha_def
  set b := aeval ![x, y, 1] (pderiv 1 G) with hb_def
  have ha : aeval ![x, y] (pderiv 0 g) = a := by
    rw [pderiv_dehomogenize, h20, aeval_dehomogenize, hpt]
  have hb : aeval ![x, y] (pderiv 1 g) = b := by
    rw [pderiv_dehomogenize, h21, aeval_dehomogenize, hpt]
  have hab : a ≠ 0 ∨ b ≠ 0 := by
    by_contra! hab
    have hle : Ideal.span {g, pderiv 0 g, pderiv 1 g} ≤
        RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] F) := by
      rw [Ideal.span_le]
      rintro q (rfl | rfl | rfl) <;> simp [RingHom.mem_ker, hgxy, ha, hb, hab.1, hab.2]
    rw [hsm2] at hle
    simpa using RingHom.mem_ker.mp (hle (Submodule.mem_top (x := 1)))
  obtain ⟨c, hc, hcab⟩ := exists_eval_ne_zero_and_mul_add_ne_zero hG
    (aeval_X_one_zero_ne_zero (K := K) hG hsm h) hcard hab
  -- The sheared and normalized equation `G' = G(X₀ + c X₁, X₁, X₂) / G(c, 1, 0)`.
  set μ := (eval ![c, 1, 0] G)⁻¹ with hμ
  have hμ0 : μ ≠ 0 := inv_ne_zero hc
  set G' := C μ * linearSubst (shear c) G with hG'_def
  have hG' : G'.IsHomogeneous d := by
    simpa using (isHomogeneous_C (Fin 3) μ).mul (hG.linearSubst (shear c))
  have hsm' : ∀ v : Fin 3 → K, v ≠ 0 → aeval v G' = 0 → ∃ l, aeval v (pderiv l G') ≠ 0 := by
    intro v hv hv0
    rw [hG'_def, map_mul, aeval_C, mul_eq_zero, map_eq_zero, or_iff_right hμ0] at hv0
    obtain ⟨l, hl⟩ := exists_aeval_pderiv_linearSubst_ne_zero
      (by rw [det_shear]; exact one_ne_zero) hsm hv hv0
    refine ⟨l, ?_⟩
    rw [hG'_def, pderiv_C_mul, map_mul, aeval_C]
    exact mul_ne_zero ((map_ne_zero _).mpr hμ0) hl
  set g' := dehomogenize 2 G' with hg'_def
  have hg' : g' = C μ * shearEquiv c g := by
    rw [hg'_def, hG'_def, map_mul, dehomogenize_linearSubst_shear, hg_def, algHom_C,
      algebraMap_eq]
  have hirr' : Irreducible g' := by
    rw [hg', irreducible_isUnit_mul ((IsUnit.mk0 _ hμ0).map C)]
    exact (MulEquiv.irreducible_iff (shearEquiv c).toMulEquiv).mpr
      (irreducible_map_dehomogenize_two hG hsm h).of_map
  have hlead1 : g'.coeff (Finsupp.single 1 d) = 1 := by
    have hv : (shear c).mulVec (Pi.single 1 1) = ![c, 1, 0] := by
      ext i
      fin_cases i <;> simp [shear, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
    rw [hg'_def, coeff_dehomogenize_single hG' 2 1, h21, hG'.coeff_single_eq_eval, hG'_def,
      map_mul, eval_C, eval_linearSubst, hv, hμ, inv_mul_cancel₀ hc]
  have hdeg' : g'.totalDegree = d := by
    refine le_antisymm ((totalDegree_dehomogenize_le 2 G').trans hG'.totalDegree_le) ?_
    have hmem : Finsupp.single 1 d ∈ g'.support := by
      rw [mem_support_iff, hlead1]
      exact one_ne_zero
    simpa using le_totalDegree hmem
  have hlead : g'.coeff (Finsupp.single 1 g'.totalDegree) = 1 := by rw [hdeg', hlead1]
  -- Both affine charts of `G' = 0` are smooth.
  have hsmA := span_dehomogenize_two_pderiv_eq_top hG' hsm'
  have hsmI := span_inftyChart_pderiv_eq_top hG' hsm'
  rw [← hg'_def] at hsmA hsmI
  rw [← hdeg'] at hsmI
  -- The projection from `(c : 1 : 0)` is `u = x - c y`.
  set u := x - algebraMap k F c * y with hu_def
  have hxu : u + algebraMap k F c * y = x := by rw [hu_def]; ring
  have heval : ∀ v w : F,
      aeval ![v, w] g' = algebraMap k F μ * aeval ![v + algebraMap k F c * w, w, 1] G :=
    fun v w ↦ by
      rw [hg'_def, aeval_dehomogenize, hpt, hG'_def, map_mul, aeval_C, aeval_linearSubst_shear]
      simp
  -- If `u` were algebraic over `k`, then `y`, a root of the monic `g'(u, Y)`, would be algebraic
  -- over `k(u)`, hence over `k`, and so would `x = u + c y`.
  have hu : Transcendental k u := by
    intro hua
    have := IntermediateField.isAlgebraic_adjoin_simple hua.isIntegral
    have hdegL : (g'.map (algebraMap k k⟮u⟯)).totalDegree ≤ g'.totalDegree :=
      Finset.sup_mono (support_map_subset _ _)
    have hmonL := Polynomial.Bivariate.monic_equivMvPolynomial_symm hdegL
      (by rw [coeff_map, hlead, map_one])
    have hyL : IsAlgebraic k⟮u⟯ y :=
      Polynomial.Bivariate.isAlgebraic_of_aeval_algebraMap_eq_zero
        (a := IntermediateField.AdjoinSimple.gen k u) (hmonL.map _).ne_zero
        (by rw [IntermediateField.AdjoinSimple.algebraMap_gen, aeval_map_algebraMap, heval, hxu, h,
          mul_zero])
    exact hx (hxu ▸ hua.add ((isAlgebraic_algebraMap c).mul
      (hyL.restrictScalars_of_isIntegral k)))
  -- `∂g'/∂Y (u, y) = (c ∂G/∂X₀ + ∂G/∂X₁)(x, y, 1) / G(c, 1, 0)`, nonzero by the choice of `c`.
  have hpd : aeval ![u, y] (pderiv 1 g') = algebraMap k F μ * (algebraMap k F c * a + b) := by
    rw [hg'_def, pderiv_dehomogenize, h21, aeval_dehomogenize, hpt, hG'_def, pderiv_C_mul,
      pderiv_linearSubst, Fin.sum_univ_three]
    simp only [map_mul, map_add, aeval_C]
    rw [aeval_linearSubst_shear, aeval_linearSubst_shear, aeval_linearSubst_shear]
    simp [shear, hxu, ha_def, hb_def]
  exact ⟨c, g', hc, hu, hirr', hlead, hdeg', hsmA, hsmI, by rw [heval, hxu, h, mul_zero],
    hpd ▸ mul_ne_zero ((map_ne_zero _).mpr hμ0) hcab⟩

/-- **A separating projection of a smooth projective plane curve**: let `G ∈ k[X₀, X₁, X₂]` be
homogeneous of degree `d` with every point of `G = 0` over an algebraically closed extension `K`
of `k` nonsingular, and let `F / k` be generated by a transcendental `x` and an element `y` with
`G(x, y, 1) = 0`. If `k` has more than `d + 1` elements, then some centre of projection
`(c : 1 : 0)` lies off the curve and its linear coordinate `u = x - c y` is transcendental over
`k`, with `F / k(u)` finite and separable of degree `d`. -/
theorem exists_isSeparable_finrank_eq_of_isHomogeneous_of_lt_card (hG : G.IsHomogeneous d)
    (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ l, aeval b (pderiv l G) ≠ 0)
    (hcard : ((d + 1 : ℕ) : ℕ∞) < ENat.card k)
    {x y : F} (hx : Transcendental k x) (hgen : k⟮x, y⟯ = ⊤) (h : aeval ![x, y, 1] G = 0) :
    ∃ c : k, eval ![c, 1, 0] G ≠ 0 ∧ Transcendental k (x - algebraMap k F c * y) ∧
      FiniteDimensional k⟮x - algebraMap k F c * y⟯ F ∧
      Algebra.IsSeparable k⟮x - algebraMap k F c * y⟯ F ∧
      Module.finrank k⟮x - algebraMap k F c * y⟯ F = d := by
  obtain ⟨c, g', hc, hu, hirr', hlead, hdeg', -, -, hy', hpd⟩ :=
    exists_aeval_sub_mul_eq_zero hG hsm hcard hx h
  set u := x - algebraMap k F c * y
  let _ := ratFuncAlgebraOfTranscendental hu
  have := isScalarTower_ratFuncAlgebraOfTranscendental hu
  have hX : algebraMap (RatFunc k) F RatFunc.X = u :=
    algebraMap_ratFuncAlgebraOfTranscendental_X hu
  have hgen' := adjoin_simple_eq_top_of_algebraMap_X_eq hX hgen
  rw [← hX] at hy' hpd
  obtain ⟨_, _⟩ := finiteDimensional_and_isSeparable_of_aeval_pderiv_one_ne_zero hgen' hy' hpd
  -- Transport from `k(X)` along `k(X) ≃ k(u)`, which commutes with the embeddings into `F`.
  set e := (RatFunc.algEquivOfTranscendental u hu).toRingEquiv
  have he : (algebraMap k⟮u⟯ F).comp e = (RingEquiv.refl F : F →+* F).comp
      (algebraMap (RatFunc k) F) :=
    RingHom.ext fun r ↦ (algebraMap_ratFuncAlgebraOfTranscendental_apply hu r).symm
  refine ⟨c, hc, hu, Module.Finite.of_equiv_equiv e (RingEquiv.refl F) he,
    Algebra.IsSeparable.of_equiv_equiv e (RingEquiv.refl F) he, ?_⟩
  rw [← Algebra.finrank_eq_of_equiv_equiv e (RingEquiv.refl F) he,
    finrank_ratFunc_eq_totalDegree_of_aeval_eq_zero hirr' hlead hgen' hy', hdeg']

/-- **The genus of a smooth projective plane curve, over a constant field with more than `d + 1`
elements**: let `G ∈ k[X₀, X₁, X₂]` be homogeneous of degree `d` with every point of `G = 0` over
an algebraically closed extension `K` of `k` nonsingular, and let `F / k` be generated by a
transcendental `x` and an element `y` with `G(x, y, 1) = 0`, where `k` is the exact constant field
of `F`. If `k` has more than `d + 1` elements, then `F` has
genus `(d - 1)(d - 2) / 2`. -/
theorem genus_eq_of_isHomogeneous_of_lt_card (hex : IsIntegrallyClosedIn k F)
    (hG : G.IsHomogeneous d)
    (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ l, aeval b (pderiv l G) ≠ 0)
    (hcard : ((d + 1 : ℕ) : ℕ∞) < ENat.card k)
    {x y : F} (hx : Transcendental k x) (hgen : k⟮x, y⟯ = ⊤) (h : aeval ![x, y, 1] G = 0) :
    genus k F = (d - 1) * (d - 2) / 2 := by
  -- Project from the centre `(c : 1 : 0)` and apply the genus formula to the projected equation.
  obtain ⟨c, g', -, hu, hirr', hlead, hdeg', hsmA, hsmI, hy', hpd⟩ :=
    exists_aeval_sub_mul_eq_zero hG hsm hcard hx h
  let _ := ratFuncAlgebraOfTranscendental hu
  have := isScalarTower_ratFuncAlgebraOfTranscendental hu
  have hX : algebraMap (RatFunc k) F RatFunc.X = x - algebraMap k F c * y :=
    algebraMap_ratFuncAlgebraOfTranscendental_X hu
  have hgen' := adjoin_simple_eq_top_of_algebraMap_X_eq hX hgen
  rw [← hX] at hy' hpd
  obtain ⟨_, _⟩ := finiteDimensional_and_isSeparable_of_aeval_pderiv_one_ne_zero hgen' hy' hpd
  rw [genus_eq_of_aeval_eq_zero hex hirr' hlead hsmA hsmI hgen' hy', hdeg']

/-- **The genus of a smooth projective plane curve** (Fulton, *Algebraic Curves*, Section 8.3): let
`G ∈ k[X₀, X₁, X₂]` be homogeneous of degree `d`, with every point of `G = 0` over an algebraically
closed extension `K` of `k` nonsingular. Let `F / k` be generated by a transcendental `x` and an
element `y` with `G(x, y, 1) = 0`. Then `F` has genus `(d - 1)(d - 2) / 2`.

Nonsingularity makes `G(X₀, X₁, 1)` irreducible over `K`, so `k` is the exact constant field of
`F` (`TauCeti.isIntegrallyClosedIn_of_irreducible_map`). -/
theorem genus_eq_of_isHomogeneous (hG : G.IsHomogeneous d)
    (hsm : ∀ b : Fin 3 → K, b ≠ 0 → aeval b G = 0 → ∃ l, aeval b (pderiv l G) ≠ 0)
    {x y : F} (hx : Transcendental k x) (hgen : k⟮x, y⟯ = ⊤) (h : aeval ![x, y, 1] G = 0) :
    genus k F = (d - 1) * (d - 2) / 2 := by
  have hirr := irreducible_map_dehomogenize_two hG hsm h
  have h₂ : aeval ![x, y] (dehomogenize 2 G) = 0 := by rwa [aeval_dehomogenize, insertNth_two]
  let eK := Polynomial.Bivariate.equivMvPolynomial K
  have hirr' : Irreducible (eK.symm ((dehomogenize 2 G).map (algebraMap k K))) :=
    (MulEquiv.irreducible_iff eK.symm.toMulEquiv).mpr hirr
  rw [Polynomial.Bivariate.equivMvPolynomial_symm_map] at hirr'
  have hex := isIntegrallyClosedIn_of_irreducible_map (L := K) hx hgen hirr'
    ((AlgHom.congr_fun
      (Polynomial.Bivariate.aevalAeval_comp_equivMvPolynomial_symm (R := k) x y) _).trans h₂)
  rcases finite_or_infinite k with hk | hk
  · -- Pass to a finite constant field extension `k'` with more than `d + 1` elements.
    obtain ⟨F', k', hk', hcard, hc⟩ :=
      exists_finiteDimensional_lt_card_constantCompositum_eq_top k F (d + 1)
    have : FiniteDimensional F F' := finiteDimensional_of_constantCompositum_eq_top (k := k) hc
    have : Algebra.IsSeparable k k' := Algebra.IsAlgebraic.isSeparable_of_perfectField
    have : PerfectField k' := Algebra.IsAlgebraic.perfectField k
    have hF : IsFunctionField k F := isFunctionField_of_aeval_eq_zero hirr.of_map.ne_zero hx hgen h₂
    have hex' := isIntegrallyClosedIn_of_constantCompositum_eq_top hex hc
    -- Embed `k'` in `K` over `k`.
    let _ : Algebra k' K := (IsAlgClosed.lift : k' →ₐ[k] K).toRingHom.toAlgebra
    have : IsScalarTower k k' K :=
      .of_algebraMap_eq fun c ↦ ((IsAlgClosed.lift : k' →ₐ[k] K).commutes c).symm
    have hsm' : ∀ b : Fin 3 → K, b ≠ 0 → aeval b (G.map (algebraMap k k')) = 0 →
        ∃ l, aeval b (pderiv l (G.map (algebraMap k k'))) ≠ 0 := by
      intro b hb hb0
      rw [aeval_map_algebraMap] at hb0
      obtain ⟨l, hl⟩ := hsm b hb hb0
      exact ⟨l, by rwa [pderiv_map, aeval_map_algebraMap]⟩
    have hx' : Transcendental k' (algebraMap F F' x) :=
      ((transcendental_algebraMap_iff (algebraMap F F').injective).mpr hx).extendScalars k'
    have hgen' : k'⟮algebraMap F F' x, algebraMap F F' y⟯ = ⊤ := by
      have := adjoin_image_eq_top_of_constantCompositum_eq_top hgen hc
      rwa [Set.image_pair] at this
    have h' : aeval ![algebraMap F F' x, algebraMap F F' y, 1] (G.map (algebraMap k k')) = 0 := by
      have hcomp : ![algebraMap F F' x, algebraMap F F' y, 1] =
          fun i ↦ IsScalarTower.toAlgHom k F F' (![x, y, 1] i) := by
        ext i
        fin_cases i <;> simp
      rw [aeval_map_algebraMap, hcomp, ← comp_aeval_apply, h, map_zero]
    rw [← genus_eq_genus_of_constantCompositum_eq_top hF hex hc]
    exact genus_eq_of_isHomogeneous_of_lt_card (K := K) hex' (hG.map _) hsm' hcard hx' hgen' h'
  · exact genus_eq_of_isHomogeneous_of_lt_card hex hG hsm (by simp) hx hgen h

end Genus

end TauCeti
