/-!
# The constant field of a plane curve

Let `F` be a field generated over `k` by a transcendental element `x` and an element `y` with
`φ(x, y) = 0`, for an irreducible `φ ∈ k[X, Y]`. This file proves the absolute-irreducibility
criterion for the constant field: if `φ` stays irreducible over an algebraically closed field
`K ⊇ k`, then `k` is algebraically closed in `F`, that is, `k` is the exact field of constants of
`F`. This is Stichtenoth's Corollary 3.6.8, stated in his Section 3.6, where `k` is assumed
perfect; the proof here needs no hypothesis on `k`. It supplies the exactness of constants for
function fields given by an absolutely irreducible plane equation.

The proof passes through the tensor product `F ⊗[k] K`.

* The relations between `x` and `y` are exactly the multiples of `φ`: the kernel of evaluation
  `k[X, Y] → F` at `(x, y)` is the principal ideal `(φ)`. Indeed `φ(x, Y)` has positive degree in
  `Y`, since `x` is transcendental, so by Gauss's lemma it is irreducible over `k(x)`. It is
  therefore a multiple of the minimal polynomial of `y` over `k(x)` and divides every `ψ(x, Y)`
  with `ψ(x, y) = 0`, first over `k(x)` and then, again by Gauss's lemma, over `k[x]`.
* So the ring `k[x, y]` is `k[X, Y] / (φ)`, and since `K` is flat over `k`, the ring
  `k[x, y] ⊗[k] K` is `K[X, Y] / (φ)`. This is a domain when `φ` is irreducible, hence prime,
  in `K[X, Y]`. Its localization `F ⊗[k] K` is then a domain as well
  (`TauCeti.isDomain_tensorProduct_of_isLocalization`), because `F` is the fraction field of
  `k[x, y]`.
* When `K` is algebraically closed, `F ⊗[k] K` being a domain forces `k` to be algebraically
  closed in `F` (`TauCeti.algebraicClosure_eq_bot_of_isDomain_tensorProduct`).

## Main results

* `TauCeti.ker_aeval_eq_span_singleton_of_irreducible`: the ideal of relations of `(x, y)` over
  `k` is generated by `φ`.
* `TauCeti.isDomain_tensorProduct_of_irreducible_map`: if `φ` is irreducible over a field `K`
  containing `k`, then `F ⊗[k] K` is a domain.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Corollary 3.6.8.
-/

public section

open MvPolynomial
open scoped IntermediateField TensorProduct

namespace TauCeti

variable {k F : Type*} [Field k] [Field F] [Algebra k F]

/-- **The relations of a point on a plane curve.** If `x` is transcendental over `k` and
`φ(x, y) = 0` for an irreducible `φ ∈ k[X, Y]`, then the polynomials vanishing at `(x, y)` are
exactly the multiples of `φ`. -/
theorem ker_aeval_eq_span_singleton_of_irreducible {φ : MvPolynomial (Fin 2) k}
    (hφ : Irreducible φ) {x y : F} (hx : Transcendental k x) (h : aeval ![x, y] φ = 0) :
    RingHom.ker (aeval ![x, y] : MvPolynomial (Fin 2) k →ₐ[k] F) = Ideal.span {φ} := by
  refine le_antisymm (fun ψ hψ ↦ ?_) ((Ideal.span_singleton_le_iff_mem _).mpr h)
  rw [RingHom.mem_ker] at hψ
  -- Read `φ` and `ψ` as polynomials in `Y` over `k[X]`, and `F` as a `k(X)`-algebra with
  -- `X ↦ x`.
  let _ := ratFuncAlgebraOfTranscendental hx
  have := isScalarTower_ratFuncAlgebraOfTranscendental hx
  set e := Polynomial.Bivariate.equivMvPolynomial k
  have hφ' : Irreducible (e.symm φ) := (MulEquiv.irreducible_iff e).mp (by simpa using hφ)
  have hev (χ : MvPolynomial (Fin 2) k) :
      Polynomial.aeval y ((e.symm χ).map (algebraMap (Polynomial k) (RatFunc k))) =
        aeval ![x, y] χ := by
    rw [Polynomial.Bivariate.aeval_map_eq_aeval_equivMvPolynomial, RatFunc.algebraMap_X,
      algebraMap_ratFuncAlgebraOfTranscendental_X, AlgEquiv.apply_symm_apply]
  -- `φ(x, Y)` has positive degree in `Y`: a nonzero `φ ∈ k[X]` cannot vanish at `x`.
  have hdeg : (e.symm φ).natDegree ≠ 0 := by
    intro h0
    obtain ⟨a, ha⟩ := Polynomial.natDegree_eq_zero.mp h0
    have h0' := hev φ
    rw [h, ← ha, Polynomial.map_C, Polynomial.aeval_C,
      map_eq_zero_iff _ (algebraMap (RatFunc k) F).injective,
      map_eq_zero_iff _ (IsFractionRing.injective (Polynomial k) (RatFunc k))] at h0'
    exact hφ'.ne_zero (by rw [← ha, h0', map_zero])
  have hprim := hφ'.isPrimitive hdeg
  have hirr := (hprim.irreducible_iff_irreducible_map_fraction_map (K := RatFunc k)).mp hφ'
  -- `φ(x, Y)` is irreducible with root `y`, so it is associated to the minimal polynomial of `y`,
  -- which divides `ψ(x, Y)`.
  have hy : IsIntegral (RatFunc k) y := IsAlgebraic.isIntegral ⟨_, hirr.ne_zero, by rw [hev, h]⟩
  have hdvd := ((minpoly.irreducible hy).dvd_symm hirr (minpoly.dvd _ _ (by rw [hev, h]))).trans
    (minpoly.dvd _ _ (by rw [hev, hψ]))
  rw [Ideal.mem_span_singleton, ← map_dvd_iff e.symm]
  exact hprim.dvd_of_fraction_map_dvd_fraction_map hdvd

/-- **Plane curves stay integral under extension of scalars.** Let `F` be generated over `k` by a
transcendental `x` and an element `y` with `φ(x, y) = 0`. If `φ ∈ k[X, Y]` is irreducible over a
field `K` containing `k`, then `F ⊗[k] K` is a domain. -/
theorem isDomain_tensorProduct_of_irreducible_map (K : Type*) [Field K] [Algebra k K]
    {φ : MvPolynomial (Fin 2) k} (hφ : Irreducible (φ.map (algebraMap k K))) {x y : F}
    (hx : Transcendental k x) (hgen : k⟮x, y⟯ = ⊤) (h : aeval ![x, y] φ = 0) :
    IsDomain (F ⊗[k] K) := by
  let f : MvPolynomial (Fin 2) k →ₐ[k] F := aeval ![x, y]
  have hrange : f.range = Algebra.adjoin k {x, y} := by
    rw [← Algebra.adjoin_range_eq_range_aeval, Matrix.range_cons_cons_empty]
  -- `F` is the fraction field of `k[x, y]`.
  have : IsFractionRing f.range F := .of_field _ _ fun z ↦ by
    obtain ⟨r, hr, s, hs, rfl⟩ :=
      IntermediateField.mem_adjoin_iff_div.mp (hgen ▸ IntermediateField.mem_top : z ∈ k⟮x, y⟯)
    rw [← hrange] at hr hs
    exact ⟨⟨r, hr⟩, ⟨s, hs⟩, rfl⟩
  -- The kernel of `K[X, Y] = K ⊗[k] k[X, Y] → K ⊗[k] k[x, y]` is generated by `φ`, which is prime
  -- in `K[X, Y]`.
  let g := Algebra.TensorProduct.map (AlgHom.id k K) f.rangeRestrict
  have hg : Function.Surjective g :=
    Algebra.TensorProduct.map_surjective _ _ Function.surjective_id f.rangeRestrict_surjective
  have hker : RingHom.ker g = Ideal.span {(1 : K) ⊗ₜ[k] φ} := by
    rw [Algebra.TensorProduct.lTensor_ker _ f.rangeRestrict_surjective, AlgHom.ker_rangeRestrict,
      ker_aeval_eq_span_singleton_of_irreducible (Irreducible.of_map hφ) hx h, Ideal.map_span,
      Set.image_singleton, Algebra.TensorProduct.includeRight_apply]
  have hprime : Prime ((1 : K) ⊗ₜ[k] φ) := by
    rw [← MulEquiv.prime_iff (algebraTensorAlgEquiv k K), algebraTensorAlgEquiv_tmul, one_smul]
    exact hφ.prime
  have : (RingHom.ker g).IsPrime := hker ▸ (Ideal.span_singleton_prime hprime.ne_zero).mpr hprime
  have : IsDomain (K ⊗[k] f.range) :=
    (RingHom.quotientKerEquivOfSurjective hg).toMulEquiv.isDomain_iff.mp
      (Ideal.Quotient.isDomain (RingHom.ker g))
  have : IsDomain (f.range ⊗[k] K) :=
    (Algebra.TensorProduct.comm k K f.range).toMulEquiv.isDomain_iff.mp inferInstance
  exact isDomain_tensorProduct_of_isLocalization (nonZeroDivisors f.range) le_rfl F K


end TauCeti
