/-!
# A function field with exact constants and a nonreduced constant extension

Let `k` be a field of characteristic `p > 0` and let `a, b ∈ k` be `p`-independent: the
monomials `a ^ i * b ^ j` with `i, j < p` are linearly independent over the subfield `k ^ p` of
`p`-th powers; for instance, independent indeterminates `a` and `b` over `𝔽_p`. Let
`F = k(x, y)` with `x` transcendental over `k` and

`y ^ p = a + b x ^ p`.

Then `F / k` is an algebraic function field with exact constant field `k`, and `F / k(x)` is
purely inseparable of degree `p`. Yet if an extension `K / k` contains `p`-th roots `α` of `a`
and `β` of `b`, the element `1 ⊗ α + x ⊗ β - y ⊗ 1` of `F ⊗[k] K` is a nonzero nilpotent: its
`p`-th power vanishes because `(α + β x) ^ p = a + b x ^ p`. So `F ⊗[k] K` is not reduced, and in
particular not a domain. Exactness of the constants of a function field therefore does not make
its extensions of scalars domains. Separably generated function fields with exact constants do
have that property (Lang, *Algebra*, Chapter VIII, Section 4). By that criterion, which this
file does not formalize, `F / k` is not separably generated: over an imperfect constant field,
separable generation cannot be dropped from it.

The constants are exact by a coefficient comparison. Write an element `z` of `F` algebraic over
`k` in the basis `1, y, …, y ^ (p - 1)` of `F / k(x)`. Its `p`-th power
`z ^ p = ∑ fᵢ ^ p (a + b x ^ p) ^ i` lies in `k(x)` and is algebraic over `k`, hence lies in `k`.
Clearing denominators turns this into an identity of polynomials in `x`. Expanding
`(a + b x ^ p) ^ i` and reading off the coefficients of `x ^ (p n)`, the `p`-independence of `a`
and `b` forces every `fᵢ` with `i ≥ 1` to vanish, so that `z` lies in `k(x)` and therefore in
`k`. The same comparison shows that `a + b x ^ p` is not a `p`-th power in `k(x)`, so that
`X ^ p - (a + b x ^ p)` is irreducible.

As in the files on the hyperelliptic equation `y ^ 2 = f(x)`, the field `F` is presented as an
algebra over `k(x) = RatFunc k` generated by `y`, and `x` is the image of `RatFunc.X`.

## Main results

* `TauCeti.IsPIndependentPair`: `a` and `b` are `p`-independent.
* `TauCeti.irreducible_X_pow_sub_C_add_mul_X_pow`: `X ^ p - (a + b x ^ p)` is irreducible over
  `k(x)`.
* `TauCeti.notMem_span_pair_of_pow_eq`: `α ∉ k + k β` for `p`-th roots `α` of `a` and `β` of `b`.
* `TauCeti.isIntegrallyClosedIn_of_pow_eq_add_mul_X_pow`: `k` is the exact constant field of `F`.
* `TauCeti.isFunctionField_of_pow_eq_add_mul_X_pow`: `F / k` is an algebraic function field.
* `TauCeti.finrank_eq_of_pow_eq_add_mul_X_pow`: `[F : k(x)] = p`.
* `TauCeti.not_isReduced_tensorProduct_of_pow_eq_add_mul_X_pow`: `F ⊗[k] K` is not reduced once
  `K` contains `p`-th roots `α` of `a` and `β` of `b` with `α ∉ k + k β`.
* `TauCeti.exists_isFunctionField_isIntegrallyClosedIn_not_isReduced_tensorProduct`: if `a, b` is
  a `p`-independent pair, then for each extension `K` containing `p`-th roots of `a` and `b` there
  is a function field with exact constants whose tensor product with `K` is not reduced.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Section III.6, on the role of perfect constant fields in constant field extensions.
* S. Lang, *Algebra*, 3rd ed., GTM 211, Springer, 2002, Chapter VIII, Section 4, on separable
  and regular extensions.
-/

public section

open Polynomial Finset
open scoped IntermediateField TensorProduct

namespace TauCeti

universe u

variable {k : Type u} [Field k] {p : ℕ} [hp : Fact p.Prime] [CharP k p] {a b : k}

/-! ### Coefficient comparisons in `k[X]` and `k(X)` -/

/-- The coefficient of `X ^ (p n)` in `∑ Pᵢⱼ ^ p a ^ i b ^ j` is `∑ (Pᵢⱼ)ₙ ^ p a ^ i b ^ j`. -/
private theorem coeff_sum_pow_mul_C (P : ℕ → ℕ → k[X]) (n : ℕ) :
    (∑ i ∈ range p, ∑ j ∈ range p, P i j ^ p * C (a ^ i * b ^ j)).coeff (p * n) =
      ∑ i ∈ range p, ∑ j ∈ range p, (P i j).coeff n ^ p * a ^ i * b ^ j := by
  simp only [finsetSum_coeff, coeff_mul_C, ← map_frobenius_expand, coeff_map,
    coeff_expand_mul' hp.out.pos, frobenius_def, mul_assoc]

/-- Expanding `(a + b X ^ p) ^ i` writes `∑ gᵢ ^ p (a + b X ^ p) ^ i` in the monomials
`a ^ m b ^ j`, whose coefficient is `(binom(m + j, j) g_{m + j} X ^ j) ^ p` for `m + j < p`. -/
private theorem sum_pow_mul_C_add_C_mul_X_pow (g : ℕ → k[X]) :
    ∑ i ∈ range p, g i ^ p * (C a + C b * X ^ p) ^ i =
      ∑ m ∈ range p, ∑ j ∈ range p, (if m + j < p then
        ((m + j).choose j : k[X]) * g (m + j) * X ^ j else 0) ^ p * C (a ^ m * b ^ j) := by
  have key : ∀ i ∈ range p, g i ^ p * (C a + C b * X ^ p) ^ i =
      ∑ j ∈ range (i + 1), (((i - j + j).choose j : k[X]) * g (i - j + j) * X ^ j) ^ p *
        C (a ^ (i - j) * b ^ j) := by
    intro i _
    rw [add_comm, add_pow, mul_sum]
    refine sum_congr rfl fun j hj ↦ ?_
    rw [Nat.sub_add_cancel (Nat.lt_succ_iff.mp (mem_range.mp hj))]
    have hc : ((i.choose j : ℕ) : k[X]) ^ p = i.choose j := by
      rw [← frobenius_def, map_natCast]
    simp only [mul_pow, hc, map_mul, map_pow]
    ring
  rw [sum_congr rfl key]
  simp only [ite_pow, zero_pow hp.out.ne_zero, ite_mul, zero_mul]
  rw [sum_sigma', ← sum_product', ← sum_filter]
  refine sum_nbij' (fun s ↦ (s.1 - s.2, s.2)) (fun q ↦ ⟨q.1 + q.2, q.2⟩) ?_ ?_ ?_ ?_ ?_
  · simp only [mem_sigma, mem_range, mem_filter, mem_product]
    omega
  · simp only [mem_sigma, mem_range, mem_filter, mem_product]
    omega
  · rintro ⟨i, j⟩ h
    simp only [mem_sigma, mem_range] at h
    simp only [Sigma.mk.injEq, heq_eq_eq, and_true]
    omega
  · rintro ⟨m, j⟩ _
    simp
  · rintro ⟨i, j⟩ _
    rfl

/-! ### Consequences of `p`-independence -/

omit hp [CharP k p] in
variable (p) in
/-- `a` and `b` are `p`-independent: the monomials `a ^ i * b ^ j` with `i, j < p` are linearly
independent over the subfield of `p`-th powers of `k`. -/
def IsPIndependentPair (a b : k) : Prop :=
  ∀ c : ℕ → ℕ → k,
    ∑ i ∈ range p, ∑ j ∈ range p, c i j ^ p * a ^ i * b ^ j = 0 → ∀ i < p, ∀ j < p, c i j = 0

section PIndependent

variable (hab : IsPIndependentPair p a b)

include hab

/-- `p`-independence of `a` and `b` over `k ^ p` gives `p`-independence over `k[X] ^ p`. -/
private theorem eq_zero_of_sum_pow_mul_C_eq_zero
    {P : ℕ → ℕ → k[X]} (h : ∑ i ∈ range p, ∑ j ∈ range p, P i j ^ p * C (a ^ i * b ^ j) = 0)
    {i j : ℕ} (hi : i < p) (hj : j < p) : P i j = 0 := by
  ext n
  have hn := congrArg (coeff · (p * n)) h
  simp only [coeff_sum_pow_mul_C, coeff_zero] at hn
  exact hab (fun i j ↦ (P i j).coeff n) hn i hi j hj

/-- **The key coefficient comparison.** If `∑_{i < p} gᵢ ^ p (a + b X ^ p) ^ i = e h ^ p` in `k[X]`
with `e ∈ k` and `h ≠ 0`, then `gᵢ = 0` for `0 < i < p`. Comparing the coefficients of
`X ^ (p deg h)` expresses `e` in the monomials `a ^ m b ^ j`; `p`-independence then makes each
coefficient of the left side a constant multiple of `h`. For `i ≥ 1` the coefficients of `a ^ i`
and `a ^ (i - 1) b` are `gᵢ` and `i gᵢ X`, and both multiples of `h` only if `gᵢ = 0`. -/
private theorem eq_zero_of_sum_pow_mul_C_add_C_mul_X_pow_eq
    {g : ℕ → k[X]} {h : k[X]} (hh : h ≠ 0) {e : k}
    (H : ∑ i ∈ range p, g i ^ p * (C a + C b * X ^ p) ^ i = C e * h ^ p) {i : ℕ} (hi0 : i ≠ 0)
    (hip : i < p) : g i = 0 := by
  rw [sum_pow_mul_C_add_C_mul_X_pow] at H
  set Q : ℕ → ℕ → k[X] := fun m j ↦
    if m + j < p then ((m + j).choose j : k[X]) * g (m + j) * X ^ j else 0 with hQ
  have hη : h.coeff h.natDegree ≠ 0 := by
    rw [coeff_natDegree]
    exact leadingCoeff_ne_zero.mpr hh
  set ε : ℕ → ℕ → k := fun m j ↦ (Q m j).coeff h.natDegree / h.coeff h.natDegree
  -- The coefficient of `X ^ (p deg h)` expresses `e` in the monomials `a ^ m b ^ j`.
  have he : ∑ m ∈ range p, ∑ j ∈ range p, ε m j ^ p * (a ^ m * b ^ j) = e := by
    have hc := congrArg (coeff · (p * h.natDegree)) H
    rw [coeff_sum_pow_mul_C, coeff_C_mul, ← map_frobenius_expand, coeff_map,
      coeff_expand_mul' hp.out.pos, frobenius_def] at hc
    rw [eq_comm, ← mul_div_cancel_right₀ e (pow_ne_zero p hη), ← hc, sum_div]
    refine sum_congr rfl fun m _ ↦ ?_
    rw [sum_div]
    refine sum_congr rfl fun j _ ↦ ?_
    simp only [ε, div_pow]
    ring
  -- Hence every coefficient `Q m j` is the constant multiple `ε m j` of `h`.
  have hQh : ∀ m < p, ∀ j < p, Q m j = C (ε m j) * h := by
    refine fun m hm j hj ↦ sub_eq_zero.mp <| eq_zero_of_sum_pow_mul_C_eq_zero hab
      (P := fun m j ↦ Q m j - C (ε m j) * h) ?_ hm hj
    simp only [sub_pow_char, sub_mul, sum_sub_distrib, sub_eq_zero]
    rw [H, ← he, map_sum, sum_mul]
    refine sum_congr rfl fun m _ ↦ ?_
    rw [map_sum, sum_mul]
    refine sum_congr rfl fun j _ ↦ ?_
    simp only [mul_pow, map_mul, map_pow]
    ring
  have h1 := hQh i hip 0 hp.out.pos
  have h2 := hQh (i - 1) (by omega) 1 hp.out.one_lt
  simp only [hQ, Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hi0), add_zero, hip, ite_true,
    Nat.choose_zero_right, Nat.choose_one_right, pow_zero, Nat.cast_one, one_mul, mul_one,
    pow_one] at h1 h2
  rw [h1] at h2 ⊢
  have h3 : C ((i : k) * ε i 0) * X = C (ε (i - 1) 1) := by
    refine mul_left_cancel₀ hh ?_
    rw [map_mul, map_natCast]
    linear_combination h2
  have h4 := congrArg (coeff · 1) h3
  simp only [coeff_C_mul_X, coeff_C, one_ne_zero, ite_false] at h4
  have hi : (i : k) ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff k p]
    exact fun hd ↦ hi0 (Nat.eq_zero_of_dvd_of_lt hd hip)
  rw [(mul_eq_zero.mp h4).resolve_left hi, map_zero, zero_mul]

/-- The comparison of `eq_zero_of_sum_pow_mul_C_add_C_mul_X_pow_eq` in `k(X)`: if
`∑_{i < p} fᵢ ^ p (a + b X ^ p) ^ i` is a constant, then `fᵢ = 0` for `0 < i < p`. -/
private theorem eq_zero_of_sum_pow_mul_add_mul_X_pow_eq_algebraMap
    {f : ℕ → RatFunc k} {e : k}
    (H : ∑ i ∈ range p, f i ^ p * algebraMap k[X] (RatFunc k) (C a + C b * X ^ p) ^ i =
      algebraMap k (RatFunc k) e) {i : ℕ} (hi0 : i ≠ 0) (hip : i < p) : f i = 0 := by
  obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors k[X]) (range p) f
  choose g hg using fun i (hi : i ∈ range p) ↦ hd i hi
  set g' : ℕ → k[X] := fun i ↦ if hi : i ∈ range p then g i hi else 0
  have hg' : ∀ i ∈ range p, algebraMap k[X] (RatFunc k) (g' i) = (d : k[X]) • f i :=
    fun i hi ↦ by simp only [g', hi, ↓reduceDIte, hg]
  have hd0 : algebraMap k[X] (RatFunc k) d ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective k[X] (RatFunc k))).mpr
      (nonZeroDivisors.ne_zero d.2)
  have Hpoly : ∑ i ∈ range p, g' i ^ p * (C a + C b * X ^ p) ^ i = C e * (d : k[X]) ^ p := by
    refine IsFractionRing.injective k[X] (RatFunc k) ?_
    simp only [map_sum, map_mul, map_pow]
    rw [sum_congr rfl fun i hi ↦ by rw [hg' i hi, Algebra.smul_def, mul_pow, mul_assoc],
      ← mul_sum, H, RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C, mul_comm]
  have := eq_zero_of_sum_pow_mul_C_add_C_mul_X_pow_eq hab (nonZeroDivisors.ne_zero d.2) Hpoly hi0
    hip
  have hfi := hg' i (mem_range.mpr hip)
  rw [this, map_zero, Algebra.smul_def, eq_comm, mul_eq_zero] at hfi
  exact hfi.resolve_left hd0

/-- `a + b X ^ p` is not a `p`-th power in `k(X)`. -/
private theorem pow_ne_algebraMap_add_mul_X_pow
    (g : RatFunc k) : g ^ p ≠ algebraMap k[X] (RatFunc k) (C a + C b * X ^ p) := by
  intro hg
  have := eq_zero_of_sum_pow_mul_add_mul_X_pow_eq_algebraMap hab
    (f := fun i ↦ if i = 0 then g else if i = 1 then -1 else 0) (e := 0) ?_ one_ne_zero
    hp.out.one_lt
  · simp at this
  · rw [sum_eq_add 0 1 zero_ne_one (fun c _ hc ↦ by simp [hc.1, hc.2, zero_pow hp.out.ne_zero])
      (fun h ↦ absurd (mem_range.mpr hp.out.pos) h)
      (fun h ↦ absurd (mem_range.mpr hp.out.one_lt) h)]
    simp [hg, neg_one_pow_char]

/-- `X ^ p - (a + b X ^ p)` is irreducible over `k(X)`. -/
theorem irreducible_X_pow_sub_C_add_mul_X_pow :
    Irreducible (X ^ p - C (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p))) :=
  X_pow_sub_C_irreducible_of_prime hp.out (pow_ne_algebraMap_add_mul_X_pow hab)

/-- `α ∉ k + k β` when `α` and `β` are `p`-th roots of a `p`-independent pair `a, b`. -/
theorem notMem_span_pair_of_pow_eq
    {K : Type*} [Field K] [Algebra k K] {α β : K} (hα : α ^ p = algebraMap k K a)
    (hβ : β ^ p = algebraMap k K b) : α ∉ Submodule.span k {1, β} := by
  have := charP_of_injective_algebraMap (algebraMap k K).injective p
  rw [Submodule.mem_span_pair]
  rintro ⟨c₀, c₂, h⟩
  have hpow := congrArg (· ^ p) h
  simp only [add_pow_char, Algebra.smul_def, mul_pow, mul_one, hα, hβ, ← map_pow,
    ← map_mul, ← map_add] at hpow
  have := hab (fun i j ↦ if i = 0 ∧ j = 0 then c₀ else if i = 1 ∧ j = 0 then -1 else
      if i = 0 ∧ j = 1 then c₂ else 0) ?_ 1 hp.out.one_lt 0 hp.out.pos
  · simp at this
  · have hpa := (algebraMap k K).injective hpow
    have hp0 : p ≠ 0 := hp.out.ne_zero
    have h0 : 0 ∈ range p := mem_range.mpr hp.out.pos
    have h1 : 1 ∈ range p := mem_range.mpr hp.out.one_lt
    rw [sum_eq_add 0 1 zero_ne_one (fun i _ hi ↦ sum_eq_zero fun j _ ↦ by
        simp [hi.1, hi.2, zero_pow hp0]) (absurd h0) (absurd h1),
      sum_eq_add 0 1 zero_ne_one (fun j _ hj ↦ by simp [hj.1, hj.2, zero_pow hp0])
        (absurd h0) (absurd h1),
      sum_eq_single 0 (fun j _ hj ↦ by simp [hj, zero_pow hp0]) (absurd h0)]
    simp only [and_true, one_ne_zero, zero_ne_one, and_false, ite_true, ite_false, pow_zero,
      pow_one, mul_one, neg_one_pow_char]
    linear_combination hpa

end PIndependent

/-! ### The function field `y ^ p = a + b x ^ p` -/

variable {F : Type*} [Field F] [Algebra (RatFunc k) F] [Algebra k F]
  [IsScalarTower k (RatFunc k) F]

omit [CharP k p] [Algebra k F] [IsScalarTower k (RatFunc k) F] in
/-- `y` is a root of the monic `X ^ p - (a + b x ^ p)` over `k(x)`. -/
private theorem isIntegral_of_pow_eq_add_mul_X_pow {y : F}
    (hy : y ^ p = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p))) :
    IsIntegral (RatFunc k) y :=
  ⟨X ^ p - C (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p)),
    monic_X_pow_sub_C _ hp.out.ne_zero, by simp [hy]⟩

omit [CharP k p] in
/-- **`y ^ p = a + b x ^ p` is an algebraic function field over `k`**: `y` is integral over `k(x)`.
-/
theorem isFunctionField_of_pow_eq_add_mul_X_pow {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : y ^ p = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p))) :
    IsFunctionField k F := by
  have h1 : FiniteDimensional (RatFunc k) (RatFunc k)⟮y⟯ :=
    IntermediateField.adjoin.finiteDimensional (isIntegral_of_pow_eq_add_mul_X_pow hy)
  rw [hgen] at h1
  have : FiniteDimensional (RatFunc k) F :=
    IntermediateField.topEquiv.toLinearEquiv.finiteDimensional
  exact isFunctionField_iff_functionField.mpr inferInstance

/-- **Extending the scalars of `y ^ p = a + b x ^ p` to `p`-th roots of `a` and `b` gives a
nonreduced ring**: if `α ^ p = a` and `β ^ p = b` in `K` with `α ∉ k + k β`, then
`1 ⊗ α + x ⊗ β - y ⊗ 1` is a nonzero nilpotent of `F ⊗[k] K`. -/
theorem not_isReduced_tensorProduct_of_pow_eq_add_mul_X_pow {y : F}
    (hy : y ^ p = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p)))
    {K : Type*} [Field K] [Algebra k K] {α β : K} (hα : α ^ p = algebraMap k K a)
    (hβ : β ^ p = algebraMap k K b) (hαβ : α ∉ Submodule.span k {1, β}) :
    ¬ IsReduced (F ⊗[k] K) := by
  set x := algebraMap (RatFunc k) F RatFunc.X
  have hy' : y ^ p = algebraMap k F a + algebraMap k F b * x ^ p := by
    simp [hy, x, IsScalarTower.algebraMap_apply k (RatFunc k) F, RatFunc.algebraMap_C,
      ← RatFunc.algebraMap_eq_C]
  have := Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain k F K
    (algebraMap k F).injective (algebraMap k K).injective
  have := charP_of_injective_algebraMap (algebraMap k (F ⊗[k] K)).injective p
  intro hred
  set w : F ⊗[k] K := 1 ⊗ₜ α + x ⊗ₜ β - y ⊗ₜ 1
  have hw : w ^ p = 0 := by
    simp only [w, sub_pow_char, add_pow_char, Algebra.TensorProduct.tmul_pow, one_pow, hα, hβ,
      hy', Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul, ← TensorProduct.smul_tmul,
      TensorProduct.add_tmul, sub_self]
  -- A functional killing `1` and `β` but not `α` detects `w ≠ 0`.
  obtain ⟨l, hlα, hl⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hαβ inferInstance
  have hl0 : ∀ v ∈ ({1, β} : Set K), l v = 0 := fun v hv ↦ by
    simpa [hl] using Submodule.mem_map_of_mem (f := l) (Submodule.subset_span hv)
  have h1 := hl0 1 (by simp)
  have hβ0 := hl0 β (by simp)
  have hw0 : TensorProduct.rid k F (l.lTensor F w) = l α • 1 := by
    simp [w, h1, hβ0]
  apply smul_ne_zero hlα (one_ne_zero (α := F))
  rw [← hw0, IsReduced.eq_zero w ⟨p, hw⟩, map_zero, map_zero]

section PIndependent

variable (hab : IsPIndependentPair p a b)

include hab

/-- **`k` is the exact constant field of `y ^ p = a + b x ^ p`** for `p`-independent `a` and `b`.
-/
theorem isIntegrallyClosedIn_of_pow_eq_add_mul_X_pow
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : y ^ p = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p))) :
    IsIntegrallyClosedIn k F := by
  have := charP_of_injective_algebraMap (algebraMap k F).injective p
  set c := algebraMap k[X] (RatFunc k) (C a + C b * X ^ p)
  have hmonic : (X ^ p - C c).Monic := monic_X_pow_sub_C _ hp.out.ne_zero
  have hdeg : (X ^ p - C c).natDegree = p := natDegree_X_pow_sub_C c
  rw [isIntegrallyClosedIn_iff]
  refine ⟨(algebraMap k F).injective, fun {z} hz ↦ ?_⟩
  -- Write `z` as a polynomial of degree `< p` in `y` over `k(x)`.
  have hz' : z ∈ Algebra.adjoin (RatFunc k) {y} := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (isIntegral_of_pow_eq_add_mul_X_pow hy).isAlgebraic, hgen]
    trivial
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hz'
  obtain ⟨Q, rfl⟩ : ∃ Q, aeval y Q = z := hz'
  set Q' := Q %ₘ (X ^ p - C c)
  have hQ' : aeval y Q = ∑ i ∈ range p, algebraMap (RatFunc k) F (Q'.coeff i) * y ^ i := by
    rw [← aeval_modByMonic_eq_self_of_root (q := X ^ p - C c) (by simp [hy]),
      aeval_eq_sum_range' (hdeg ▸ natDegree_modByMonic_lt Q hmonic
        (fun h ↦ hp.out.ne_zero (by rw [← hdeg, h, natDegree_one])))]
    simp only [Algebra.smul_def, Q']
  -- Its `p`-th power lies in `k(x)` and is algebraic over `k`, hence a constant.
  have hpow :
      aeval y Q ^ p = algebraMap (RatFunc k) F (∑ i ∈ range p, Q'.coeff i ^ p * c ^ i) := by
    rw [hQ', sum_pow_char, map_sum]
    refine sum_congr rfl fun i _ ↦ ?_
    rw [mul_pow, ← pow_mul, mul_comm i, pow_mul, hy, map_mul, map_pow, map_pow]
  let φ := IsScalarTower.toAlgHom k (RatFunc k) F
  have hint : IsIntegral k (∑ i ∈ range p, Q'.coeff i ^ p * c ^ i) :=
    (isIntegral_algHom_iff φ φ.injective).mp <| by
      rw [IsScalarTower.toAlgHom_apply, ← hpow]
      exact hz.pow p
  obtain ⟨e, he⟩ := IsIntegrallyClosedIn.isIntegral_iff.mp hint
  have hcoeff := fun i ↦ eq_zero_of_sum_pow_mul_add_mul_X_pow_eq_algebraMap hab he.symm (i := i)
  -- So `z` lies in `k(x)`, and is a constant.
  rw [hQ', sum_eq_single 0 (fun i hi hi0 ↦ by
      rw [hcoeff i hi0 (mem_range.mp hi), map_zero, zero_mul])
    (fun h ↦ absurd (mem_range.mpr hp.out.pos) h), pow_zero, mul_one] at hz ⊢
  obtain ⟨e', he'⟩ := IsIntegrallyClosedIn.isIntegral_iff.mp
    ((isIntegral_algHom_iff φ φ.injective).mp (by rwa [IsScalarTower.toAlgHom_apply]))
  exact ⟨e', by rw [IsScalarTower.algebraMap_apply k (RatFunc k) F, he']⟩

omit [Algebra k F] [IsScalarTower k (RatFunc k) F] in
/-- **`F / k(x)` has degree `p`**: `X ^ p - (a + b x ^ p)` is irreducible over `k(x)`. -/
theorem finrank_eq_of_pow_eq_add_mul_X_pow
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : y ^ p = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p))) :
    Module.finrank (RatFunc k) F = p := by
  have hint := isIntegral_of_pow_eq_add_mul_X_pow hy
  have hmin :
      minpoly (RatFunc k) y = X ^ p - C (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p)) :=
    (minpoly.eq_of_irreducible_of_monic (irreducible_X_pow_sub_C_add_mul_X_pow hab)
      (by simp [hy]) (monic_X_pow_sub_C _ hp.out.ne_zero)).symm
  rw [← IntermediateField.finrank_top', ← hgen, IntermediateField.adjoin.finrank hint, hmin,
    natDegree_X_pow_sub_C]

/-- **A function field with exact constants and a nonreduced extension of scalars.** If `a, b ∈ k`
are `p`-independent and `K / k` contains `p`-th roots of `a` and `b`, there is a function field
`F / k` with exact constant field `k` whose tensor product with `K` over `k` is not reduced, namely
`F = k(x)[y] / (y ^ p - a - b x ^ p)`. -/
theorem exists_isFunctionField_isIntegrallyClosedIn_not_isReduced_tensorProduct
    {K : Type*} [Field K] [Algebra k K] {α β : K} (hα : α ^ p = algebraMap k K a)
    (hβ : β ^ p = algebraMap k K b) :
    ∃ (F : Type u) (_ : Field F) (_ : Algebra k F), IsFunctionField k F ∧
      IsIntegrallyClosedIn k F ∧ ¬ IsReduced (F ⊗[k] K) := by
  set f := X ^ p - C (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p))
  have : Fact (Irreducible f) := ⟨irreducible_X_pow_sub_C_add_mul_X_pow hab⟩
  have hy : AdjoinRoot.root f ^ p = algebraMap (RatFunc k) (AdjoinRoot f)
      (algebraMap k[X] (RatFunc k) (C a + C b * X ^ p)) := by
    have := AdjoinRoot.eval₂_root f
    simp only [f, eval₂_sub, eval₂_X_pow, eval₂_C, sub_eq_zero] at this
    exact this
  have hgen := IntermediateField.adjoin_root_eq_top f
  exact ⟨AdjoinRoot f, inferInstance, inferInstance,
    isFunctionField_of_pow_eq_add_mul_X_pow hgen hy,
    isIntegrallyClosedIn_of_pow_eq_add_mul_X_pow hab hgen hy,
    not_isReduced_tensorProduct_of_pow_eq_add_mul_X_pow hy hα hβ
      (notMem_span_pair_of_pow_eq hab hα hβ)⟩

