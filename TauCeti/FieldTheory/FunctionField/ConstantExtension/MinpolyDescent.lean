module

public import Mathlib.FieldTheory.RatFunc.IntermediateField
public import TauCeti.FieldTheory.FunctionField.GeometricDegree
public import TauCeti.FieldTheory.Minpoly.Lifts
public import TauCeti.FieldTheory.RatFunc.Galois

/-!
# Descending a function field along its minimal polynomial

Let `K → k` be a field extension and let `E` be a field extension of `k(t)` generated by one
element `z`, so that `E = k(t)[Z] / (μ)` for the minimal polynomial `μ` of `z` over `k(t)`. If the
coefficients of `μ` lie in `K(t)`, then `E` is defined over `K`: the subfield `K(t)(z)` of `E` is
a model of `E` over `K`. Its degree over `K(t)` is the degree of `E` over `k(t)`, because the
minimal polynomial of `z` over `K(t)` is `μ` with its coefficients read in `K(t)`
(`IntermediateField.finrank_adjoin_simple_eq_of_minpoly_mem_lifts`), and its compositum with the
constants `k` is all of `E`.

The coefficients of `μ` lie in `K(t)` when `μ` is fixed by the coefficient maps of a set `S` of
automorphisms of `k` whose common fixed points are `K`
(`TauCeti.RatFunc.mem_lifts_of_forall_map_mapRingEquiv_eq`). This is the last step of Köck's
proof that a Belyi pair over `ℂ` is defined over a finite extension of its field of moduli: the
normalized generator `z` of the pair has minimal polynomial fixed by a subgroup `V` of finite
index in the stabilizer of the pair in `Aut(ℂ)`, and `K` is the fixed field `ℂ ^ V`. No
algebraicity of `k / K` is assumed, as `ℂ / ℂ ^ V` is transcendental.

Throughout, `K(t) → k(t)` is an algebra map sending `t` to `t` (and a `K`-algebra map where the
automorphisms of `k` enter), and `E` is a `K(t)`-algebra through `k(t)`.

## Main results

* `TauCeti.finrank_adjoin_simple_ratFunc_eq_of_forall_map_mapRingEquiv_eq`: if `z` generates
  `E` over `k(t)` and its minimal polynomial is fixed by coefficient maps whose common fixed
  points are `K`, then `[K(t)(z) : K(t)] = [E : k(t)]`.
* `TauCeti.constantCompositum_adjoin_simple_ratFunc_eq_top`: the compositum of `K(t)(z)` with the
  constants `k` is `E` when `z` generates `E` over `k(t)`.

## References

* B. Köck, *Belyi's theorem revisited*, Beiträge zur Algebra und Geometrie 45 (2004), 253–265,
  proof of (2.2) Theorem.
-/

public section

open IntermediateField Polynomial

namespace TauCeti

variable {K k E : Type*} [Field K] [Field k] [Field E]
  [Algebra (RatFunc K) (RatFunc k)] [Algebra (RatFunc k) E] [Algebra (RatFunc K) E]
  [IsScalarTower (RatFunc K) (RatFunc k) E]

section Automorphisms

variable [Algebra K k] [IsScalarTower K (RatFunc K) (RatFunc k)]

/-- **Degree of the descended field.** Let `S` be a set of automorphisms of `k` whose common
fixed points are the image of `K`. If `z` generates `E` over `k(t)` and its minimal polynomial
over `k(t)` is fixed by the coefficient map of every `σ ∈ S`, then `K(t)(z)` has the same degree
over `K(t)` as `E` over `k(t)`. -/
theorem finrank_adjoin_simple_ratFunc_eq_of_forall_map_mapRingEquiv_eq
    (hX : algebraMap (RatFunc K) (RatFunc k) RatFunc.X = RatFunc.X) {S : Set (k ≃+* k)}
    (hS : ∀ c : k, (∀ σ ∈ S, σ c = c) → c ∈ Set.range (algebraMap K k)) {z : E}
    (hz : IsIntegral (RatFunc k) z) (hgen : (RatFunc k)⟮z⟯ = ⊤)
    (hfix : ∀ σ ∈ S, (minpoly (RatFunc k) z).map
      (RatFunc.mapRingEquiv σ : RatFunc k →+* RatFunc k) = minpoly (RatFunc k) z) :
    Module.finrank (RatFunc K) (RatFunc K)⟮z⟯ = Module.finrank (RatFunc k) E := by
  rw [finrank_adjoin_simple_eq_of_minpoly_mem_lifts hz
    (RatFunc.mem_lifts_of_forall_map_mapRingEquiv_eq hX hS hfix), hgen, finrank_top']

end Automorphisms

section Compositum

variable [Algebra k E] [IsScalarTower k (RatFunc k) E]

/-- **The descended field is a model.** If `z` generates `E` over `k(t)`, then the compositum of
`K(t)(z)` with the constants `k` is all of `E`. -/
theorem constantCompositum_adjoin_simple_ratFunc_eq_top
    (hX : algebraMap (RatFunc K) (RatFunc k) RatFunc.X = RatFunc.X) {z : E}
    (hgen : (RatFunc k)⟮z⟯ = ⊤) :
    constantCompositum (RatFunc K)⟮z⟯ k E = ⊤ := by
  set L := constantCompositum (RatFunc K)⟮z⟯ k E
  have hsub : ∀ x ∈ (RatFunc K)⟮z⟯, (x : E) ∈ L.toSubfield := fun x hx ↦ by
    simpa using L.algebraMap_mem ⟨x, hx⟩
  -- The rational functions over `k` whose images lie in `L` form an intermediate field of
  -- `k(t) / k`. It contains `t`, so it is all of `k(t)`.
  let M := (L.toSubfield.comap (algebraMap (RatFunc k) E)).toIntermediateField (K := k)
    fun c ↦ by
      rw [Subfield.mem_comap, ← IsScalarTower.algebraMap_apply]
      exact algebraMap_mem_constantCompositum _ k E c
  have hXM : (RatFunc.X : RatFunc k) ∈ M.toSubfield := by
    rw [Subfield.toIntermediateField_toSubfield, Subfield.mem_comap, ← hX,
      ← IsScalarTower.algebraMap_apply]
    exact hsub _ (IntermediateField.algebraMap_mem _ _)
  have hM : M = ⊤ :=
    eq_top_iff.mpr <| _root_.RatFunc.adjoin_X.symm.le.trans (adjoin_simple_le_iff.mpr hXM)
  have hkt (f : RatFunc k) : algebraMap (RatFunc k) E f ∈ L.toSubfield := by
    have hf : f ∈ M.toSubfield := (mem_toSubfield M f).mpr (hM ▸ mem_top)
    rwa [Subfield.toIntermediateField_toSubfield, Subfield.mem_comap] at hf
  -- So `L` is an intermediate field of `E / k(t)`, and it contains the generator `z`.
  let N := L.toSubfield.toIntermediateField hkt
  have hzN : z ∈ N.toSubfield := by
    rw [Subfield.toIntermediateField_toSubfield]
    exact hsub _ (mem_adjoin_simple_self _ z)
  have hN : N = ⊤ := eq_top_iff.mpr <| hgen.symm.le.trans (adjoin_simple_le_iff.mpr hzN)
  refine eq_top_iff.mpr fun x _ ↦ ?_
  have hx : x ∈ N.toSubfield := (mem_toSubfield N x).mpr (hN ▸ mem_top)
  rwa [Subfield.toIntermediateField_toSubfield, mem_toSubfield] at hx

end Compositum

end TauCeti
