module

public import TauCeti.FieldTheory.FunctionField.ConstantExtension.Basic

import TauCeti.FieldTheory.IntermediateField.Adjoin.EqTop

/-!
# Rational-parameter degrees after extending constants

For an exact constant field `k` in `F`, extending constants by a finite separable extension
`k' / k` preserves `[F : k(x)]`. The ambient field `F'` is the compositum of `F` and `k'`,
expressed by `constantCompositum F k' F' = ⊤`. No function-field hypothesis is needed.

## Main results

* `TauCeti.finrank_over_adjoin_simple_eq_of_constantCompositum_eq_top`:
  `[F' : k'(x)] = [F : k(x)]` for every `x ∈ F`.

## Reference

H. Stichtenoth, *Algebraic Function Fields and Codes*, second edition, Proposition 3.6.1(c).
-/

public section

open scoped IntermediateField

namespace TauCeti

universe u u' v v'

variable {k : Type u} {k' : Type u'} {F : Type v} {F' : Type v'}
variable [Field k] [Field k'] [Field F] [Field F']
variable [Algebra k k'] [Algebra k F] [Algebra k F'] [Algebra k' F'] [Algebra F F']
variable [IsScalarTower k k' F'] [IsScalarTower k F F']

/-- A finite separable extension of an exact constant field preserves the degree over the
subfield generated by any element of the original field (Stichtenoth, Proposition 3.6.1(c)). -/
theorem finrank_over_adjoin_simple_eq_of_constantCompositum_eq_top
    [FiniteDimensional k k'] [Algebra.IsSeparable k k'] (hex : IsIntegrallyClosedIn k F)
    (h : constantCompositum F k' F' = ⊤) (x : F) :
    Module.finrank k'⟮algebraMap F F' x⟯ F' = Module.finrank k⟮x⟯ F := by
  let f : F →ₐ[k] F' := IsScalarTower.toAlgHom k F F'
  let g : k' →ₐ[k] F' := IsScalarTower.toAlgHom k k' F'
  let A : IntermediateField k F' := g.fieldRange
  have : FiniteDimensional k A := g.equivFieldRange.toLinearEquiv.finiteDimensional
  have : Algebra.IsSeparable k A := AlgEquiv.Algebra.isSeparable g.equivFieldRange
  have hcomp : A ⊔ f.fieldRange = ⊤ := by
    have hc : IntermediateField.adjoin F (A : Set F') = ⊤ := by
      simpa only [A, g, IsScalarTower.toAlgHom_fieldRange, constantCompositum_def] using h
    simpa only [IntermediateField.adjoin_self, f] using
      IntermediateField.adjoin_sup_fieldRange_eq_top k F F' hc
  have hdegree :=
    relfinrank_sup_adjoin_simple_eq_relfinrank_adjoin_simple_of_isIntegrallyClosedIn hex A hcomp x
  have hbase : (k'⟮algebraMap F F' x⟯).restrictScalars k =
      A ⊔ k⟮algebraMap F F' x⟯ := by
    rw [IntermediateField.restrictScalars_adjoin_of_algEquiv g.equivFieldRange
      (by ext y; exact (g.equivFieldRange_apply_coe y).symm),
      IntermediateField.restrictScalars_adjoin_eq_sup]
  rw [← hbase, IntermediateField.relfinrank_top_right,
    IntermediateField.relfinrank_top_right] at hdegree
  -- Restricting scalars keeps the subfield carrier and its inclusion in `F'` unchanged.
  exact hdegree

end TauCeti
