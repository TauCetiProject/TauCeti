module

public import TauCeti.FieldTheory.FunctionField.ConstantExtension.IntermediateField
import TauCeti.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Degrees over subfields after extending constants

For an exact constant field `k` in `F`, extending constants by a separable algebraic extension
`k' / k` preserves `[F : k(x)]`, and more generally `[F : E]` for every subfield `E` of `F`
containing `k`, with `E` replaced by its compositum `E · k'`. The ambient field `F'` is the
compositum of `F` and `k'`, expressed by `constantCompositum F k' F' = ⊤`. The constant extension
may be infinite; in particular this applies to an algebraic closure over a perfect constant
field. No function-field hypothesis is needed. Without separability or exactness the degree
`[F : k(x)]` can only drop.

## Main results

* `TauCeti.finrank_over_adjoin_simple_eq_of_constantCompositum_eq_top`:
  `[F' : k'(x)] = [F : k(x)]` for every `x ∈ F`.
* `TauCeti.finrank_over_adjoin_simple_le_of_constantCompositum_eq_top`:
  `[F' : k'(x)] ≤ [F : k(x)]` for any constant extension, when `F / k(x)` is finite.
* `TauCeti.finrank_over_constantCompositum_eq_finrank_of_constantCompositum_eq_top`:
  `[F' : E · k'] = [F : E]` for every subfield `E` of `F` containing `k`.
* `TauCeti.adjoin_simple_eq_top_of_constantCompositum_eq_top` and
  `TauCeti.minpoly_algebraMap_eq_map_of_constantCompositum_eq_top`: a primitive element `y` of
  `F / E` stays primitive over `E · k'`; when `F / E` is finite, its minimal polynomial
  is unchanged. Neither result requires the constant extension to be finite.

## Reference

H. Stichtenoth, *Algebraic Function Fields and Codes*, second edition, Proposition 3.6.1(c).
-/

public section

open scoped IntermediateField

namespace TauCeti

universe u u' v v'

variable {k : Type u} {k' : Type u'} {F : Type v} {F' : Type v'}
variable [Field k] [Field k'] [Field F] [Field F']
variable [Algebra k k'] [Algebra k F] [Algebra k F'] [Algebra k' F'] [Algebra F F']
variable [IsScalarTower k k' F'] [IsScalarTower k F F']

/-- A separable algebraic extension of an exact constant field preserves the degree over the
subfield generated by any element of the original field (Stichtenoth, Proposition 3.6.1(c)).
The extension of constants may be infinite. -/
theorem finrank_over_adjoin_simple_eq_of_constantCompositum_eq_top
    [Algebra.IsSeparable k k'] (hex : IsIntegrallyClosedIn k F)
    (h : constantCompositum F k' F' = ⊤) (x : F) :
    Module.finrank k'⟮algebraMap F F' x⟯ F' = Module.finrank k⟮x⟯ F := by
  let b := Module.Basis.ofVectorSpace k⟮x⟯ F
  have hdegree := Module.finrank_eq_nat_card_basis (constantExtensionBasis hex h k⟮x⟯ b)
  rwa [IntermediateField.range_algebraMap_adjoin_simple, IntermediateField.adjoin_adjoin_right,
    ← Module.finrank_eq_nat_card_basis b] at hdegree

private theorem span_range_basis_of_finite_constantCompositum
    (h : constantCompositum F k' F' = ⊤) (C : IntermediateField k F)
    [FiniteDimensional C F] {ι : Type*} (b : Module.Basis ι C F) :
    Submodule.span (IntermediateField.adjoin k' (Set.range (algebraMap C F')))
      (Set.range (algebraMap F F' ∘ b)) = ⊤ := by
  let C' := IntermediateField.adjoin k' (Set.range (algebraMap C F'))
  let g : C →+* C' := (algebraMap C F').codRestrict C'.toSubring fun x =>
    IntermediateField.subset_adjoin k' _ ⟨x, rfl⟩
  let : Algebra C C' := g.toAlgebra
  have : IsScalarTower C C' F' := .of_algebraMap_eq fun _ => rfl
  let f := IsScalarTower.toAlgHom C F F'
  let e := AlgEquiv.ofInjective f f.injective
  have hspan := f.range.adjoin_eq_span_basis C' (b.map e.toLinearEquiv)
  have hrange : (f.range : Set F') = Set.range (algebraMap F F') := rfl
  have hfun : (fun i => ((b.map e.toLinearEquiv) i : F')) = algebraMap F F' ∘ b := by
    ext i
    exact AlgEquiv.ofInjective_apply f f.injective (b i)
  rw [hrange, hfun] at hspan
  let A := IntermediateField.adjoin C' (Set.range (algebraMap F F'))
  have hle : (constantCompositum F k' F' : Set F') ⊆ A := by
    rw [constantCompositum_def]
    refine (IntermediateField.adjoin_subset_adjoin_iff F).2 ?_
    constructor
    · rintro _ ⟨x, rfl⟩
      exact IntermediateField.subset_adjoin C' _ ⟨x, rfl⟩
    · rintro _ ⟨c, rfl⟩
      rw [IsScalarTower.algebraMap_apply k' C' F' c]
      exact A.algebraMap_mem (algebraMap k' C' c)
  have htop : A = ⊤ := eq_top_iff.mpr fun z _ => hle (by simp [h])
  have halg : ∀ z ∈ Set.range (algebraMap F F'), IsAlgebraic C' z := by
    rintro _ ⟨x, rfl⟩
    exact (IsAlgebraic.algHom f (Algebra.IsAlgebraic.isAlgebraic (R := C) x)).tower_top
  have htop' := congrArg IntermediateField.toSubalgebra htop
  change (IntermediateField.adjoin C' (Set.range (algebraMap F F'))).toSubalgebra = ⊤ at htop'
  rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic halg] at htop'
  rw [htop', Algebra.top_toSubmodule] at hspan
  exact hspan.symm

/-- **Extending constants can only lower a finite degree over `k(x)`**: if `F' = F · k'`
and `F / k(x)` is finite, then `[F' : k'(x)] ≤ [F : k(x)]`. The extension `k' / k` may be
transcendental; neither separability nor exactness of the constant field is assumed. -/
theorem finrank_over_adjoin_simple_le_of_constantCompositum_eq_top
    (h : constantCompositum F k' F' = ⊤) (x : F) [FiniteDimensional k⟮x⟯ F] :
    Module.finrank k'⟮algebraMap F F' x⟯ F' ≤ Module.finrank k⟮x⟯ F := by
  let b := Module.finBasis k⟮x⟯ F
  have hle := finrank_range_le_card
    (R := IntermediateField.adjoin k' (Set.range (algebraMap k⟮x⟯ F'))) (algebraMap F F' ∘ b)
  rwa [Set.finrank, span_range_basis_of_finite_constantCompositum h k⟮x⟯ b, finrank_top,
    Fintype.card_fin, IntermediateField.range_algebraMap_adjoin_simple,
    IntermediateField.adjoin_adjoin_right] at hle

/-- **A separable algebraic extension of an exact constant field preserves the degree over any
subfield** (Stichtenoth, Proposition 3.6.1(c), for an arbitrary intermediate field): if `E` is a
subfield of `F` containing `k`, then `[F · k' : E · k'] = [F : E]`. The extension of constants
may be infinite. -/
theorem finrank_over_constantCompositum_eq_finrank_of_constantCompositum_eq_top {E : Type*}
    [Field E] [Algebra k E] [Algebra E F] [IsScalarTower k E F] [Algebra E F']
    [IsScalarTower E F F'] [Algebra.IsSeparable k k']
    (hex : IsIntegrallyClosedIn k F) (h : constantCompositum F k' F' = ⊤) :
    Module.finrank (constantCompositum E k' F') F' = Module.finrank E F := by
  have : IsScalarTower k E F' := IsScalarTower.of_algebraMap_eq fun c ↦ by
    rw [IsScalarTower.algebraMap_apply E F F', ← IsScalarTower.algebraMap_apply k E F,
      ← IsScalarTower.algebraMap_apply k F F']
  -- Identify the external subfield with its image in `F` to apply the basis transport.
  let f := IsScalarTower.toAlgHom k E F
  let C := f.fieldRange
  let e := f.equivFieldRange
  let b := Module.Basis.ofVectorSpace E F
  let bC := b.mapCoeffs e.toRingEquiv fun c x ↦ by
    simp [Algebra.smul_def, e, f, AlgHom.equivFieldRange_apply_coe]
  let C' := IntermediateField.adjoin k' (Set.range (algebraMap C F'))
  have hrange : Set.range (algebraMap C F') = Set.range (algebraMap E F') := by
    rw [← e.surjective.range_comp]
    congr 1
    ext c
    -- The field-range equivalence sends `c` to its image in `F`.
    change algebraMap F F' (algebraMap E F c) = algebraMap E F' c
    exact (IsScalarTower.algebraMap_apply E F F' c).symm
  -- Adjoining `C` to `k'` and adjoining `k'` to `E` give the same subfield of `F'`.
  have hsubfield : C'.toSubfield = (constantCompositum E k' F').toSubfield := by
    rw [constantCompositum_def, IntermediateField.adjoin_toSubfield,
      IntermediateField.adjoin_toSubfield, hrange, Set.union_comm]
  let b' := (constantExtensionBasis hex h C bC).mapCoeffs
    (RingEquiv.subfieldCongr hsubfield) fun c x ↦ by
      -- This congruence preserves the underlying elements, hence their actions on `F'`.
      rfl
  exact (Module.finrank_eq_nat_card_basis b').trans
    (Module.finrank_eq_nat_card_basis b).symm

section Subfield

variable {E : Type*} [Field E] [Algebra E F] [Algebra E F'] [IsScalarTower E F F']

/-- **A primitive element stays primitive after extending constants**: if `y` generates `F` over a
subfield `E`, its image generates the compositum `F · k'` over `E · k'`. -/
theorem adjoin_simple_eq_top_of_constantCompositum_eq_top (h : constantCompositum F k' F' = ⊤)
    {y : F} (hy : E⟮y⟯ = ⊤) : (constantCompositum E k' F')⟮algebraMap F F' y⟯ = ⊤ := by
  set L := (constantCompositum E k' F')⟮algebraMap F F' y⟯
  -- `L` contains the image of `F = E(y)` and the image of `k'`, hence the compositum `F · k'`.
  have hFL (x : F) : algebraMap F F' x ∈ L := by
    have hx : IsScalarTower.toAlgHom E F F' x ∈ (E⟮y⟯).map (IsScalarTower.toAlgHom E F F') :=
      ⟨x, hy ▸ IntermediateField.mem_top, rfl⟩
    rw [IntermediateField.adjoin_map, Set.image_singleton] at hx
    have hle : E⟮IsScalarTower.toAlgHom E F F' y⟯ ≤ L.restrictScalars E :=
      IntermediateField.adjoin_simple_le_iff.mpr (IntermediateField.mem_adjoin_simple_self
        (constantCompositum E k' F') _)
    exact (IntermediateField.mem_restrictScalars E).mp (hle hx)
  have hle := (constantCompositum_le_iff F k' F' (K := L.toSubfield.toIntermediateField hFL)).mpr
    fun c ↦ L.algebraMap_mem ⟨_, algebraMap_mem_constantCompositum E k' F' c⟩
  rw [h] at hle
  exact top_le_iff.mp fun x _ ↦ hle IntermediateField.mem_top

/-- **Extending constants keeps the minimal polynomial of a primitive element**: if `y` generates
`F` over a subfield `E` containing `k`, over which `F` is finite, the minimal polynomial of its
image over `E · k'` is that of `y` over `E`. -/
theorem minpoly_algebraMap_eq_map_of_constantCompositum_eq_top [Algebra k E] [IsScalarTower k E F]
    [FiniteDimensional E F] [Algebra.IsSeparable k k']
    (hex : IsIntegrallyClosedIn k F) (h : constantCompositum F k' F' = ⊤) {y : F} (hy : E⟮y⟯ = ⊤) :
    minpoly (constantCompositum E k' F') (algebraMap F F' y) =
      (minpoly E y).map (algebraMap E (constantCompositum E k' F')) := by
  -- The minimal polynomial over `E · k'` divides that over `E`, and both have degree `[F : E]`.
  have hn := finrank_over_constantCompositum_eq_finrank_of_constantCompositum_eq_top (E := E) hex h
  have : FiniteDimensional (constantCompositum E k' F') F' :=
    Module.finite_of_finrank_pos (hn ▸ Module.finrank_pos)
  refine (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic (IsIntegral.of_finite _ _))
    ((minpoly.monic (IsIntegral.of_finite E y)).map _)
    (minpoly.dvd_map_of_isScalarTower' E _ F' y) ?_).symm
  rw [(minpoly.monic (IsIntegral.of_finite E y)).natDegree_map,
    ← IntermediateField.adjoin.finrank (IsIntegral.of_finite E y), hy,
    IntermediateField.finrank_top', ← hn,
    ← IntermediateField.adjoin.finrank (IsIntegral.of_finite _ _),
    adjoin_simple_eq_top_of_constantCompositum_eq_top h hy, IntermediateField.finrank_top']

end Subfield

end TauCeti
