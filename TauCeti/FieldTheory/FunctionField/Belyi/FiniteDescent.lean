module

public import TauCeti.FieldTheory.FunctionField.Belyi.Model
import TauCeti.FieldTheory.FunctionField.Belyi.BaseChange
import TauCeti.FieldTheory.RatFunc.Transcendental

/-!
# Belyi pairs over algebraic extensions are defined over finite extensions

Let `k` be a field of characteristic zero which is algebraic over a subfield `K₀`; the case of
interest is `k = AlgebraicClosure ℚ` and `K₀ = ℚ`. Every algebraic Belyi pair `X = (F, t)` over
`k` has a model over a finite extension of `K₀` inside `k`
(`TauCeti.AlgebraicBelyiPair.exists_finiteDimensional_model`). So every Belyi pair over
`AlgebraicClosure ℚ` is defined over a number field.

The model is explicit. Choose finitely many elements `S` of `F` generating it over `k`, and let
`E = K₀(t, S)` be the subfield of `F` they generate together with `t` over `K₀`. It is a function
field over `K₀`: it is finitely generated, contains the transcendental `t`, and lies in `F`, whose
transcendence degree over `K₀` is that over `k`, namely one. The constants of `k` lying in `E`
form a subfield `K` of `k`, which is algebraic over `K₀` and hence finite over it. It is exactly
the constant field of `E`, since an element of `E` algebraic over `K` is algebraic over `k`, and
so is a constant of `F`. As `E` contains `t` and generates `F` over `k`, the base-change
comparison of Belyi pairs (`TauCeti.isAlgebraicBelyiPair_iff_of_constantCompositum_eq_top`) shows
that `E` over `K(t)` is an algebraic Belyi pair, and a model of `X` over `K`. No minimal
polynomial or coefficient bookkeeping is needed.

For a field `k` algebraic over `ℚ`, a class of pairs defined over a number field `K` is fixed by
the open subgroup `Aut(k/K)` of `Aut(k/ℚ)`, and its translates depend only on the finitely many
embeddings of `K` into `k`. Consequently the stabilizer of every class is open and every Galois
orbit of isomorphism classes of Belyi pairs is finite; when `k` is Galois over `ℚ`, such as
`AlgebraicClosure ℚ`, the field of moduli is moreover a number field whose degree over `ℚ` is the
true orbit size. The finiteness of orbits needs no count of Belyi pairs of bounded degree.

## Main results

* `TauCeti.AlgebraicBelyiPair.exists_finiteDimensional_model`: every algebraic Belyi pair over
  `k` has a model over a finite extension of `K₀` inside `k`.
* `TauCeti.AlgebraicBelyiPair.IsoClass.exists_finiteDimensional_isDefinedOver`: every
  isomorphism class is defined over such a field.
* `TauCeti.AlgebraicBelyiPair.IsoClass.isOpen_stabilizer`: for `k` algebraic over `ℚ`, the
  stabilizer of a class in `Gal(k/ℚ)` is open.
* `TauCeti.AlgebraicBelyiPair.IsoClass.finiteDimensional_fieldOfModuli`: for `k` Galois over `ℚ`,
  the field of moduli of a class is a number field.
* `TauCeti.AlgebraicBelyiPair.IsoClass.finrank_fieldOfModuli_eq_trueOrbitSize`: its degree over
  `ℚ` is the true orbit size.
* `TauCeti.AlgebraicBelyiPair.IsoClass.finite_orbit`: for `k` algebraic over `ℚ`, Galois orbits of
  classes are finite.

## References

* B. Köck, *Belyi's theorem revisited*, Beiträge zur Algebra und Geometrie 45 (2004), 253–265,
  Section 1, for fields of moduli and fields of definition.
* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Corollary 1.1.16, for the finiteness of the constant field of a function field.
-/

public section

universe u

open IntermediateField

namespace TauCeti

namespace AlgebraicBelyiPair

variable {k : Type u} [Field k] [CharZero k] {K₀ : Type*} [Field K₀] [Algebra K₀ k]

/-! ### The model generated by finitely many elements -/

section Model

variable (X : AlgebraicBelyiPair k) [Algebra K₀ X] [IsScalarTower K₀ k X]

/-- A finitely generated subfield over `K₀` of the function field of a Belyi pair containing `t`
is a function field over `K₀`. -/
private theorem isFunctionField_of_fg [Algebra.IsAlgebraic K₀ k] {E : IntermediateField K₀ X}
    (hE : E.FG)
    (ht : algebraMap (RatFunc k) X RatFunc.X ∈ E) : IsFunctionField K₀ E := by
  have : Algebra.EssFiniteType K₀ E := essFiniteType_iff.mpr hE
  have htk : Transcendental k (algebraMap (RatFunc k) X RatFunc.X) :=
    (transcendental_algebraMap_iff (FaithfulSMul.algebraMap_injective (RatFunc k) X)).mpr
      RatFunc.transcendental_X
  have htE : Transcendental K₀ (⟨_, ht⟩ : E) :=
    (transcendental_algebraMap_iff (algebraMap E X).injective).mp (htk.of_tower_top K₀)
  have hX : IsFunctionField k X := isFunctionField_iff_functionField.mpr inferInstance
  have h1 : Algebra.trdeg K₀ X = 1 := by
    rw [← trdeg_eq_of_isAlgebraic_base (R := K₀) (S := k)]
    exact hX.trdeg_eq_one
  rw [isFunctionField_iff_trdeg_eq_one]
  exact le_antisymm ((trdeg_le_of_injective E.val E.val.injective).trans h1.le)
    (Cardinal.one_le_iff_ne_zero.mpr (trdeg_ne_zero_iff.mpr
      (Algebra.transcendental_def.mpr ⟨_, htE⟩)))

variable (E : IntermediateField K₀ X)

/-- The constants of `k` lying in a subfield `E` of the function field of `X`. -/
private def constants : IntermediateField K₀ k :=
  E.comap (IsScalarTower.toAlgHom K₀ k X)

private theorem mem_constants {c : k} : c ∈ constants X E ↔ algebraMap k X c ∈ E :=
  Iff.rfl

/-- The constants of `k` lying in `E` act on `E`. -/
private noncomputable instance : Algebra (constants X E) E :=
  ((algebraMap (constants X E) X).codRestrict E fun c ↦
    (IsScalarTower.algebraMap_apply (constants X E) k X c).symm ▸ c.2).toAlgebra

private theorem algebraMap_constants_coe (c : constants X E) :
    (algebraMap (constants X E) E c : X) = algebraMap k X c :=
  IsScalarTower.algebraMap_apply (constants X E) k X c

private instance : IsScalarTower (constants X E) E X :=
  .of_algebraMap_eq fun c ↦ (algebraMap_constants_coe X E c).symm.trans
    (IsScalarTower.algebraMap_apply (constants X E) k X c).symm

private instance : IsScalarTower K₀ (constants X E) E :=
  .of_algebraMap_eq fun c ↦ Subtype.ext <| by
    rw [algebraMap_constants_coe]
    exact IsScalarTower.algebraMap_apply K₀ k X c

/-- The constants of `k` lying in `E` are the constant field of `E`: an element of `E` algebraic
over them is a constant of the function field of `X`. -/
private theorem isIntegrallyClosedIn_constants : IsIntegrallyClosedIn (constants X E) E := by
  refine isIntegrallyClosedIn_iff_forall_isAlgebraic.mpr fun x hx ↦ ?_
  have hxk : IsAlgebraic k (x : X) :=
    ((isAlgebraic_algebraMap_iff (algebraMap E X).injective).mpr hx).extendScalars
      (algebraMap (constants X E) k).injective
  obtain ⟨c, hc⟩ := isIntegrallyClosedIn_iff_forall_isAlgebraic.mp
    X.isAlgebraicBelyiPair.isIntegrallyClosedIn _ hxk
  exact ⟨⟨c, (mem_constants X E).mpr (hc ▸ x.2)⟩,
    Subtype.ext ((algebraMap_constants_coe X E _).trans hc)⟩

/-- If `E` is a function field over `K₀`, the constants of `k` lying in `E` are finite over
`K₀`. -/
private theorem finiteDimensional_constants [Algebra.IsAlgebraic K₀ k] (hE : IsFunctionField K₀ E) :
    FiniteDimensional K₀ (constants X E) :=
  hE.finiteDimensional_of_isAlgebraic _

/-- **The model generated by a subfield.** A subfield `E` of the function field of `X` which is a
function field over `K₀`, contains `t` and generates the function field over `k` is a model of
`X` over the constants of `k` lying in it. -/
private noncomputable def model [Algebra.IsAlgebraic K₀ k] (hE : IsFunctionField K₀ E)
    (ht : algebraMap (RatFunc k) X RatFunc.X ∈ E) (hgen : adjoin k (E : Set X) = ⊤) :
    Model (constants X E) X :=
  have htk : Transcendental k (algebraMap (RatFunc k) X RatFunc.X) :=
    (transcendental_algebraMap_iff (FaithfulSMul.algebraMap_injective (RatFunc k) X)).mpr
      RatFunc.transcendental_X
  have htE : Transcendental (constants X E) (⟨_, ht⟩ : E) :=
    (transcendental_algebraMap_iff (algebraMap E X).injective).mp
      (htk.of_tower_top (constants X E))
  letI := ratFuncAlgebraOfTranscendental htE
  haveI := isScalarTower_ratFuncAlgebraOfTranscendental htE
  have hX : algebraMap E X (algebraMap (RatFunc (constants X E)) E RatFunc.X) =
      algebraMap (RatFunc k) X RatFunc.X := by
    rw [algebraMap_ratFuncAlgebraOfTranscendental_X]
    rfl
  haveI : FiniteDimensional (RatFunc (constants X E)) E :=
    isFunctionField_iff_functionField.mp hE.of_isAlgebraic
  { pair :=
      { carrier := E
        isAlgebraicBelyiPair := (isAlgebraicBelyiPair_iff_of_constantCompositum_eq_top
          (isIntegrallyClosedIn_constants X E) (constantCompositum_eq_top_of_adjoin_eq_top E k X
            ((congrArg (adjoin k) Subtype.range_coe).trans hgen)) hX).mp
          X.isAlgebraicBelyiPair }
    embedding := algebraMap E X
    embedding_algebraMap := algebraMap_constants_coe X E
    embedding_algebraMap_X := hX
    adjoin_range_embedding := (congrArg (adjoin k) Subtype.range_coe).trans hgen }

end Model

variable (K₀) in
/-- **Belyi pairs over an algebraic extension descend to a finite extension**: if `k` is algebraic
over `K₀`, every algebraic Belyi pair over `k` has a model over a subfield of `k` finite over
`K₀`. In particular every Belyi pair over `AlgebraicClosure ℚ` is defined over a number field. -/
theorem exists_finiteDimensional_model [Algebra.IsAlgebraic K₀ k] (X : AlgebraicBelyiPair k) :
    ∃ K : IntermediateField K₀ k, FiniteDimensional K₀ K ∧ Nonempty (Model K X) := by
  let : Algebra K₀ X := ((algebraMap k X).comp (algebraMap K₀ k)).toAlgebra
  have : IsScalarTower K₀ k X := .of_algebraMap_eq fun _ ↦ rfl
  have hX : IsFunctionField k X := isFunctionField_iff_functionField.mpr inferInstance
  have := hX.essFiniteType
  obtain ⟨S, hS⟩ := fg_top k X
  -- The model is the subfield generated over `K₀` by `t` and generators of `X` over `k`.
  let E := adjoin K₀ (insert (algebraMap (RatFunc k) X RatFunc.X) (S : Set X))
  have ht : algebraMap (RatFunc k) X RatFunc.X ∈ E := subset_adjoin _ _ (Set.mem_insert _ _)
  have hE : IsFunctionField K₀ E :=
    isFunctionField_of_fg X (fg_adjoin_of_finite (S.finite_toSet.insert _)) ht
  have hgen : adjoin k (E : Set X) = ⊤ := eq_top_iff.mpr <| hS.symm.le.trans <|
    adjoin.mono _ _ _ fun x hx ↦ subset_adjoin _ _ (Set.mem_insert_of_mem _ hx)
  exact ⟨constants X E, finiteDimensional_constants X E hE, ⟨model X E hE ht hgen⟩⟩

namespace IsoClass

variable (K₀) in
/-- If `k` is algebraic over `K₀`, every isomorphism class of algebraic Belyi pairs over `k` is
defined over a subfield of `k` finite over `K₀`. -/
theorem exists_finiteDimensional_isDefinedOver [Algebra.IsAlgebraic K₀ k] (c : IsoClass k) :
    ∃ K : IntermediateField K₀ k, FiniteDimensional K₀ K ∧ c.IsDefinedOver K := by
  induction c using ind with
  | h X =>
    obtain ⟨K, hK, hM⟩ := X.exists_finiteDimensional_model K₀
    exact ⟨K, hK, isDefinedOver_mk_iff.mpr hM⟩

/-! ### Stabilizers, fields of moduli and orbits -/

/-- **Stabilizers are open**: for a field `k` algebraic over `ℚ`, the stabilizer in `Gal(k/ℚ)` of
an isomorphism class of algebraic Belyi pairs over `k` is open in the Krull topology, as it
contains the automorphisms fixing a number field of definition. -/
theorem isOpen_stabilizer [Algebra.IsAlgebraic ℚ k] (c : IsoClass k) :
    IsOpen (MulAction.stabilizer (k ≃ₐ[ℚ] k) c : Set (k ≃ₐ[ℚ] k)) := by
  obtain ⟨K, hK, hc⟩ := c.exists_finiteDimensional_isDefinedOver ℚ
  have : Algebra.IsAlgebraic K k := .tower_top (K := ℚ) K
  exact Subgroup.isOpen_mono hc.fixingSubgroup_le_stabilizer K.fixingSubgroup_isOpen

/-- **The field of moduli is a number field**: over a Galois extension `k` of `ℚ`, such as
`AlgebraicClosure ℚ`, the field of moduli of an isomorphism class of algebraic Belyi pairs is
finite over `ℚ`, being contained in a number field of definition. -/
theorem finiteDimensional_fieldOfModuli [IsGalois ℚ k] (c : IsoClass k) :
    FiniteDimensional ℚ c.fieldOfModuli := by
  obtain ⟨K, hK, hc⟩ := c.exists_finiteDimensional_isDefinedOver ℚ
  have := IsGalois.tower_top_of_isGalois ℚ K k
  have hle : c.fieldOfModuli ≤ K := hc.fieldOfModuli_le
  exact FiniteDimensional.of_injective (inclusion hle).toLinearMap (inclusion_injective hle)

/-- Over a Galois extension `k` of `ℚ`, such as `AlgebraicClosure ℚ`, the degree of the field of
moduli of a class over `ℚ` is its true orbit size. -/
theorem finrank_fieldOfModuli_eq_trueOrbitSize [IsGalois ℚ k] (c : IsoClass k) :
    Module.finrank ℚ c.fieldOfModuli = c.trueOrbitSize := by
  rw [IntermediateField.finrank_eq_fixingSubgroup_index, fieldOfModuli_def,
    InfiniteGalois.fixingSubgroup_fixedField ⟨_, Subgroup.isClosed_of_isOpen _ c.isOpen_stabilizer⟩,
    trueOrbitSize_eq_index]

/-- **Galois orbits are finite**: over a field `k` algebraic over `ℚ`, such as
`AlgebraicClosure ℚ`, the orbit of an isomorphism class of algebraic Belyi pairs under
`Aut(k/ℚ)` is finite. The translate of the class by an automorphism depends only on its restriction
to a number field of definition, and there are finitely many such restrictions. -/
theorem finite_orbit [Algebra.IsAlgebraic ℚ k] (c : IsoClass k) :
    (MulAction.orbit (k ≃ₐ[ℚ] k) c).Finite := by
  obtain ⟨K, hK, hc⟩ := c.exists_finiteDimensional_isDefinedOver ℚ
  have : Algebra.IsAlgebraic K k := .tower_top (K := ℚ) K
  let res : (k ≃ₐ[ℚ] k) → (K →ₐ[ℚ] k) := fun σ ↦ σ.toAlgHom.comp K.val
  have hres {σ τ : k ≃ₐ[ℚ] k} (h : res σ = res τ) : σ • c = τ • c := by
    rw [← inv_smul_eq_iff, ← mul_smul]
    exact hc.smul_eq fun a ↦ by
      simpa [res] using congrArg (τ.symm ·) (DFunLike.congr_fun h a)
  refine (Set.finite_range fun φ : Set.range res ↦ φ.2.choose • c).subset ?_
  rintro _ ⟨σ, rfl⟩
  exact ⟨⟨res σ, σ, rfl⟩, hres (Exists.choose_spec (⟨σ, rfl⟩ : ∃ τ, res τ = res σ))⟩

/-- Over a field `k` algebraic over `ℚ` the true orbit size of a class is positive. -/
theorem trueOrbitSize_pos [Algebra.IsAlgebraic ℚ k] (c : IsoClass k) : 0 < c.trueOrbitSize := by
  rw [trueOrbitSize_eq_index, MulAction.index_stabilizer]
  exact (Set.ncard_pos c.finite_orbit).mpr ⟨c, MulAction.mem_orbit_self c⟩

end IsoClass

end AlgebraicBelyiPair

end TauCeti
