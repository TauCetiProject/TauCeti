module

public import TauCeti.Algebra.Polynomial.XPowSubC
public import TauCeti.Analysis.Complex.Minpoly
public import TauCeti.FieldTheory.FunctionField.Place.RatFunc.Basic

/-!
# The place of `X ^ 2 + 1` on a rational function field

Let `K` be a field over which `X ^ 2 + 1` is irreducible, that is, in which `-1` is not a square:
for instance an ordered field such as `ℚ` or `ℝ` (`Polynomial.irreducible_X_sq_add_one`). Then
`X ^ 2 + 1` defines a finite place `P` of `K(x)`. This file computes that place:

* `P` has degree `2`, so `K(x)` has places that are not rational;
* when `K` is a subfield of `ℂ` (more generally, a field with an algebra map to `ℂ`), its residue
  field is `K(i)`, the subfield of `ℂ` generated by `K` and `i`, with the residue class of `x`
  going to `i`. Over `ℚ` this is the field `ℚ(i)` of Gaussian rationals.

The divisor of `x ^ 2 + 1`, namely `P - 2 P_∞`, is computed with the other principal divisors of
`K(x)` in `TauCeti.FieldTheory.FunctionField.Divisor.RatFunc`
(`TauCeti.Divisor.principal_X_sq_add_one`). It shows why the degree of a divisor weights each
place by its degree: the weighted degree of `div (x ^ 2 + 1)` is `1 · 2 - 2 · 1 = 0`, as the
product formula requires, while the plain sum of its coefficients is `1 - 2 = -1`
(`TauCeti.AlgebraicGeometry.WeilDivisor.degree_principal_X_sq_add_one`).

## Main results

* `TauCeti.Place.degree_adicOfIrreducible_X_sq_add_one`: the place of `X ^ 2 + 1` has degree
  `2`.
* `TauCeti.Place.adicOfIrreducibleXSqAddOneResidueFieldEquiv`: its residue field is `K(i)`, with
  `TauCeti.Place.adicOfIrreducibleXSqAddOneResidueFieldEquiv_mk_X`: the class of `x` goes to `i`.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Proposition 1.2.1 and Definition 1.4.1.
-/

public section

noncomputable section

open IsDedekindDomain Polynomial

open scoped IntermediateField

namespace TauCeti

variable {K : Type*} [Field K] (h : Irreducible (X ^ 2 + 1 : K[X]))

namespace Place

/-- **The place of `X ^ 2 + 1` has degree two** (Stichtenoth, Proposition 1.2.1(a)): its
residue field is `K[X] / (X ^ 2 + 1)`. -/
theorem degree_adicOfIrreducible_X_sq_add_one : (adicOfIrreducible h).degree = 2 := by
  simp

variable [Algebra K ℂ]

/-- **The residue field of the place of `X ^ 2 + 1` is `K(i)`** (Stichtenoth,
Proposition 1.2.1(a)): it is `K[X] / (X ^ 2 + 1)`, and `X ^ 2 + 1` is the minimal polynomial of
`i` over `K`. Over `ℚ` this is the field of Gaussian rationals. -/
def adicOfIrreducibleXSqAddOneResidueFieldEquiv :
    (adicOfIrreducible h).ResidueField ≃ₐ[K] K⟮Complex.I⟯ :=
  -- `AdjoinRoot (X ^ 2 + 1)` is by definition `K[X] ⧸ Ideal.span {X ^ 2 + 1}`.
  (adicOfIrreducibleResidueFieldEquiv h).symm.trans <|
    (AdjoinRoot.algEquivOfEq K (X ^ 2 + 1) _ (Complex.minpoly_I h).symm).trans
      (IntermediateField.adjoinRootEquivAdjoin K (Complex.isIntegral_I K))

/-- The residue class of `x` at the place of `X ^ 2 + 1` corresponds to `i`. -/
theorem adicOfIrreducibleXSqAddOneResidueFieldEquiv_mk_X :
    adicOfIrreducibleXSqAddOneResidueFieldEquiv h
        (adicOfIrreducibleResidueFieldEquiv h (Ideal.Quotient.mk _ X)) =
      IntermediateField.AdjoinSimple.gen K Complex.I := by
  have hX := (adicOfIrreducibleResidueFieldEquiv h).symm_apply_apply (Ideal.Quotient.mk _ X)
  -- The class of `X` in `K[X] ⧸ Ideal.span {X ^ 2 + 1}` is by definition the root of
  -- `X ^ 2 + 1` in `AdjoinRoot (X ^ 2 + 1)`.
  exact (congrArg (fun z ↦ IntermediateField.adjoinRootEquivAdjoin K (Complex.isIntegral_I K)
      (AdjoinRoot.algEquivOfEq K (X ^ 2 + 1) _ (Complex.minpoly_I h).symm z)) hX).trans
    ((congrArg (IntermediateField.adjoinRootEquivAdjoin K (Complex.isIntegral_I K))
      (AdjoinRoot.algEquivOfEq_root (R := K) _ _ _)).trans
      (IntermediateField.adjoinRootEquivAdjoin_apply_root K (Complex.isIntegral_I K)))

/-- The residue class of `x` at the place of `X ^ 2 + 1` corresponds to `i`, stated in simp normal
form: `simp` rewrites `adicOfIrreducibleResidueFieldEquiv h (Ideal.Quotient.mk _ X)` by
`TauCeti.Place.adicOfIrreducibleResidueFieldEquiv_mk` to this cast of the image of `X`, so this
is the form in which `simp` meets the left side of
`TauCeti.Place.adicOfIrreducibleXSqAddOneResidueFieldEquiv_mk_X`. -/
@[simp]
theorem adicOfIrreducibleXSqAddOneResidueFieldEquiv_cast_algebraMap_X :
    adicOfIrreducibleXSqAddOneResidueFieldEquiv h
        (cast (congrArg ResidueField (adicOfIrreducible_def h).symm)
          (algebraMap K[X] (ofPrime K (RatFunc K) (HeightOneSpectrum.ofIrreducible h)).ResidueField
            X)) =
      IntermediateField.AdjoinSimple.gen K Complex.I := by
  simpa using adicOfIrreducibleXSqAddOneResidueFieldEquiv_mk_X h

/-- The element `i` corresponds to the residue class of `x` at the place of `X ^ 2 + 1`. -/
@[simp]
theorem adicOfIrreducibleXSqAddOneResidueFieldEquiv_symm_apply_gen :
    (adicOfIrreducibleXSqAddOneResidueFieldEquiv h).symm
        (IntermediateField.AdjoinSimple.gen K Complex.I) =
      adicOfIrreducibleResidueFieldEquiv h (Ideal.Quotient.mk _ X) :=
  (AlgEquiv.symm_apply_eq _).mpr (adicOfIrreducibleXSqAddOneResidueFieldEquiv_mk_X h).symm

end Place

end TauCeti
