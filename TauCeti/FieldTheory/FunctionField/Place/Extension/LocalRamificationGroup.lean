module

public import TauCeti.FieldTheory.FunctionField.Place.Extension.RamificationGroup
public import TauCeti.RingTheory.LocalRing.RamificationGroup

/-!
# Function-field and local-ring ramification groups

The lower ramification groups of a place are the generic local-ring ramification filtration of
its valuation ring. More precisely, for a place `P` of `F' / k` over `F`, this file identifies

`Place.ramificationGroup F P i`

with `IsLocalRing.ramificationGroup (P.integers.decompositionSubgroup F) P.integers i`.
The comparison rests on the equality between the place filtration and powers of the maximal
ideal of `P.integers`.

The decomposition group acts faithfully on the valuation ring: agreement there implies
agreement on its fraction field. Consequently the generic lower index and Hilbert counting
identity apply directly to the function-field groups. The counting identity is the combinatorial
half of Hilbert's different formula; identifying its left-hand side with the different exponent
is separate local different theory.

## Main results

* `TauCeti.Place.ramificationGroup_eq_localRing`: the two lower ramification filtrations agree.
* `TauCeti.Place.mem_ramificationGroup_iff_le_lowerIndex`: membership is bounded below by the
  local-ring lower index.
* `TauCeti.Place.sum_addVal_smul_sub_eq_finsum_card_ramificationGroup_sub_one`: Hilbert's
  double-counting identity in the function-field vocabulary.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, second edition, Theorem 3.8.7.
* J.-P. Serre, *Local Fields*, Chapter IV, Section 1.
-/

public section

namespace TauCeti

namespace Place

universe u v v'

variable {k : Type u} {F : Type v} {F' : Type v'}
variable [Field k] [Field F] [Field F']
variable [Algebra k F] [Algebra k F'] [Algebra F F'] [IsScalarTower k F F']

/-- The decomposition group acts faithfully on the valuation ring of a place. Indeed, two field
automorphisms agreeing on the valuation ring agree on its fraction field. -/
instance instFaithfulSMulIntegers (P : Place k F') :
    FaithfulSMul (P.integers.decompositionSubgroup F) P.integers where
  eq_of_smul_eq_smul {g h} heq := by
    apply Subtype.ext
    apply AlgEquiv.ext
    intro y
    rcases eq_or_ne y 0 with rfl | hy0
    · simp
    · rcases ValuationSubring.mem_or_inv_mem P.integers y with hy | hy
      · exact congrArg Subtype.val (heq ⟨y, hy⟩)
      · have hinv := congrArg Subtype.val (heq ⟨y⁻¹, hy⟩)
        simpa only [coe_decompositionSubgroup_smul, map_inv₀, inv_inj] using hinv

/-- The lower ramification groups defined using the order filtration of the function field are
the generic local-ring ramification groups of the valuation ring. -/
theorem ramificationGroup_eq_localRing (P : Place k F') (i : ℕ) :
    ramificationGroup F P i =
      IsLocalRing.ramificationGroup (P.integers.decompositionSubgroup F) P.integers i := by
  ext g
  rw [mem_ramificationGroup_iff, IsLocalRing.mem_ramificationGroup_natCast_iff]
  constructor
  · intro h x
    apply (P.mem_maximalIdeal_pow_iff_coe_mem_filtration (i + 1) (g • x - x)).mpr
    change ((g : P.integers.decompositionSubgroup F) : F' ≃ₐ[F] F') (x : F') -
      (x : F') ∈ P.filtration ((i + 1 : ℕ) : ℤ)
    simpa only [Nat.cast_add, Nat.cast_one] using h (x : F') x.2
  · intro h x hx
    let x' : P.integers := ⟨x, hx⟩
    have h' := (P.mem_maximalIdeal_pow_iff_coe_mem_filtration (i + 1)
      (g • x' - x')).mp (h x')
    change (((g • x' : P.integers) : F') - (x' : F')) ∈
      P.filtration ((i + 1 : ℕ) : ℤ) at h'
    rw [coe_decompositionSubgroup_smul] at h'
    change ((g : P.integers.decompositionSubgroup F) : F' ≃ₐ[F] F') x - x ∈
      P.filtration ((i : ℤ) + 1)
    simpa only [Nat.cast_add, Nat.cast_one] using h'

/-- Membership in a function-field ramification group in terms of the local-ring lower index:
`g ∈ G_i(P)` exactly when `i + 1 ≤ i_P(g)`. -/
theorem mem_ramificationGroup_iff_le_lowerIndex (P : Place k F') (i : ℕ)
    (g : P.integers.decompositionSubgroup F) :
    g ∈ ramificationGroup F P i ↔
      ((i + 1 : ℕ) : ℕ∞) ≤ IsLocalRing.lowerIndex P.integers g := by
  rw [ramificationGroup_eq_localRing (F := F) P,
    IsLocalRing.mem_ramificationGroup_iff_le_lowerIndex]
  norm_num

open Finset in
/-- **Hilbert's counting identity** in the function-field place vocabulary. If the valuation ring
is generated by one element `ξ` over the valuation ring below it, the sum of the displacements
of `ξ` by the nonidentity elements of the decomposition group equals
`∑ᶠ i, (#G_i(P) - 1)`.

The monogenic hypothesis is used only to compute every lower index on `ξ`; the filtration
comparison itself is unconditional. -/
theorem sum_addVal_smul_sub_eq_finsum_card_ramificationGroup_sub_one
    [Algebra.IsIntegral F F'] (P : Place k F')
    [Fintype (P.integers.decompositionSubgroup F)]
    [DecidableEq (P.integers.decompositionSubgroup F)] (ξ : P.integers)
    (hξ : Algebra.adjoin (P.restrict k F).integers {ξ} = ⊤) :
    ∑ σ ∈ (univ : Finset (P.integers.decompositionSubgroup F)).erase 1,
        IsDiscreteValuationRing.addVal P.integers (σ • ξ - ξ) =
      ((∑ᶠ i : ℕ, (Nat.card (ramificationGroup F P i) - 1) : ℕ) : ℕ∞) := by
  simp_rw [ramificationGroup_eq_localRing (F := F) P]
  exact IsLocalRing.sum_addVal_smul_sub_eq_finsum_card_ramificationGroup_sub_one hξ

end Place

end TauCeti
