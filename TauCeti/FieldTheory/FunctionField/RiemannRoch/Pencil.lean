module

public import TauCeti.FieldTheory.FunctionField.Consequences.HighDegree
import TauCeti.FieldTheory.FunctionField.RiemannRoch.Conorm
import TauCeti.FieldTheory.FunctionField.RiemannRoch.SectionRing

/-!
# Multiplication by the pencil of a function

For a nonzero function `z`, write `Z` and `D` for its zero and pole divisors.
The sections `1, z` of `L(D)` have no common zero; for nonconstant `z` they form
a pencil. If `deg (A - Z) > 2g - 2`, then every element of `L(A + D)` is
`a + z b` with `a, b ∈ L(A)`. The results also allow constant `z`.

In particular, for `D = (z)∞` and sufficiently large `n`,
`L((n + 1)D) = L(nD) + z L(nD)`. Iteration expresses all higher sections using
powers of `z` and a single finite-dimensional space of sections. This is the
multiplication input for finite generation of the section ring
`TauCeti.Divisor.sectionRing D` over the subalgebra generated by its two degree-one
sections `1, z`; for `z` transcendental over `k`, `D` has positive degree and this
subalgebra is a polynomial algebra in two variables. In product form,
`L((n + 1)D) ⊆ L(D) · L(nD)` in the same range
(`TauCeti.riemannRochSpace_succ_nsmul_poles_le_mul`).

Iterating the product form, once `2g - 1 ≤ (N - 1) deg D` every section of `(N + j) D` is a
sum of products of `j` sections of `D` with one of `N D`
(`TauCeti.riemannRochSpace_add_nsmul_poles_le_pow_mul`). Since `L(D)ᵉ ⊆ L(eD)`, it follows that
the section ring of `eD` is generated in degree one as soon as `2g - 1 ≤ (e - 1) deg D`
(`TauCeti.riemannRochSpace_nsmul_nsmul_poles_le_pow`), with no finite-generation argument for
the section ring of `D`. For `z` transcendental over `k`, `deg D ≥ 1`, so this applies to the
pole divisor `(zᵉ)∞ = e D` of every power `zᵉ` with `e ≥ 1` and `e ≥ 2g`
(`TauCeti.riemannRochSpace_nsmul_poles_pow_le_pow`). In genus zero it applies to `D` itself, so
the section ring of every pole divisor is generated in degree one
(`TauCeti.riemannRochSpace_nsmul_poles_le_pow_of_genus_eq_zero`). Generation in degree one is
what embeds a curve in projective space by the complete linear system of the divisor.

These statements use Riemann–Roch, so they need `k` to be the exact constant field of `F`. Over
an arbitrary `k`, the multiples of a pole divisor have the same Riemann–Roch spaces over `k` and
over the full constant field `k̃ = algebraicClosure k F`
(`TauCeti.restrictScalars_riemannRochSpace_nsmul_poles`), and `k̃` is exact. So generation in
every positive degree persists over `k`, for `e ≥ 2 g(F / k̃)`
(`TauCeti.riemannRochSpace_nsmul_poles_pow_le_pow_of_ne_zero`). Only degree zero is lost, where
`L(0) = k̃` is larger than the constants `k` unless `k` is exact; projective embeddings do not see
degree zero.

The argument is the base-point-free pencil calculation: the intersection of
`L(A)` and `z L(A)` is `L(A - Z)`, and Riemann–Roch computes the dimension of their
sum. Multiplication by `z` is the existing equivalence
`TauCeti.riemannRochSpaceEquivSubPrincipal`.

## References

* Hartshorne, *Algebraic Geometry*, Chapter IV, Section 3, for the
  base-point-free pencil argument and section rings.
* Stichtenoth, *Algebraic Function Fields and Codes*, second edition,
  Theorem 1.5.17, for Riemann–Roch in high degree.
-/

public section

namespace TauCeti

open AlgebraicGeometry

variable {k F : Type*} [Field k] [Field F] [Algebra k F]

/-- The pencil `1, z` generates `L(A + (z)∞)` from `L(A)` in high degree.
The second summand is `z L(A)`, expressed as a Riemann–Roch space via the principal divisor. -/
theorem riemannRochSpace_add_poles_eq_sup (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (z : Fˣ) (A : Divisor k F)
    (hA : 2 * (genus k F : ℤ) - 1 ≤ Divisor.degree (A - Divisor.zeros hF z)) :
    riemannRochSpace (A + Divisor.poles hF z) =
      riemannRochSpace A ⊔ riemannRochSpace (A - Divisor.principal hF z) := by
  have hZ : 0 ≤ Divisor.zeros hF z := (Divisor.isEffective_zeros hF z).zero_le
  have hD : 0 ≤ Divisor.poles hF z := (Divisor.isEffective_poles hF z).zero_le
  have hinf : A ⊓ (A - Divisor.principal hF z) = A - Divisor.zeros hF z := by
    ext P
    simp only [WeilDivisor.coeff_inf, WeilDivisor.coeff_sub,
      Divisor.coeff_principal, Divisor.coeff_zeros]
    omega
  have hsup : A ⊔ (A - Divisor.principal hF z) = A + Divisor.poles hF z := by
    ext P
    simp only [WeilDivisor.coeff_sup, WeilDivisor.coeff_add, WeilDivisor.coeff_sub,
      Divisor.coeff_principal, Divisor.coeff_poles]
    omega
  have hle : riemannRochSpace A ⊔ riemannRochSpace (A - Divisor.principal hF z) ≤
      riemannRochSpace (A + Divisor.poles hF z) := by
    rw [← hsup]
    exact sup_le (riemannRochSpace_mono le_sup_left) (riemannRochSpace_mono le_sup_right)
  have hlow : A - Divisor.zeros hF z ≤ A := sub_le_self _ hZ
  have hhigh : A ≤ A + Divisor.poles hF z := le_add_of_nonneg_right hD
  have hdimLow := Divisor.dim_eq_degree_add_one_sub_genus_of_two_mul_genus_sub_one_le_degree
    hF hex hA
  have hdimA := Divisor.dim_eq_degree_add_one_sub_genus_of_two_mul_genus_sub_one_le_degree
    hF hex (hA.trans (Divisor.degree_le_of_le hlow))
  have hdimHigh := Divisor.dim_eq_degree_add_one_sub_genus_of_two_mul_genus_sub_one_le_degree
    hF hex (hA.trans (Divisor.degree_le_of_le (hlow.trans hhigh)))
  have := finiteDimensional_riemannRochSpace hF A
  have := finiteDimensional_riemannRochSpace hF (A - Divisor.principal hF z)
  have := finiteDimensional_riemannRochSpace hF (A + Divisor.poles hF z)
  refine (Submodule.eq_of_le_of_finrank_eq hle ?_).symm
  have hdim := Submodule.finrank_sup_add_finrank_inf_eq (riemannRochSpace A)
    (riemannRochSpace (A - Divisor.principal hF z))
  rw [← riemannRochSpace_inf, hinf, ← Divisor.dim_def, ← Divisor.dim_def,
    ← Divisor.dim_def, Divisor.dim_sub_principal] at hdim
  simp only [Divisor.degree_sub, Divisor.degree_add, Divisor.degree_zeros_eq_degree_poles hF z]
    at hdimLow hdimHigh
  rw [← Divisor.dim_def]
  omega

/-- Every section of `A + (z)∞` decomposes as `a + z b` with both terms drawn from `L(A)`,
provided `A - (z)₀` has degree above the canonical degree. -/
theorem mem_riemannRochSpace_add_poles_iff (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (z : Fˣ) (A : Divisor k F)
    (hA : 2 * (genus k F : ℤ) - 1 ≤ Divisor.degree (A - Divisor.zeros hF z)) (f : F) :
    f ∈ riemannRochSpace (A + Divisor.poles hF z) ↔
      ∃ a ∈ riemannRochSpace A, ∃ b ∈ riemannRochSpace A, f = a + (z : F) * b := by
  rw [riemannRochSpace_add_poles_eq_sup hF hex z A hA]
  constructor
  · intro hf
    obtain ⟨a, ha, c, hc, hsum⟩ := Submodule.mem_sup.mp hf
    let b := (riemannRochSpaceEquivSubPrincipal hF z A).symm ⟨c, hc⟩
    refine ⟨a, ha, b, b.property, ?_⟩
    have hc' : (z : F) * (b : F) = c := by
      rw [← riemannRochSpaceEquivSubPrincipal_apply]
      exact congrArg Subtype.val
        ((riemannRochSpaceEquivSubPrincipal hF z A).apply_symm_apply ⟨c, hc⟩)
    exact hsum.symm.trans (congrArg (a + ·) hc'.symm)
  · rintro ⟨a, ha, b, hb, rfl⟩
    exact Submodule.add_mem_sup ha (mul_mem_riemannRochSpace_sub_principal hF z hb)

/-- Multiplication by `1, z` generates the next multiple of the pole divisor.
The bound is on the preceding multiple, so all three Riemann–Roch dimensions are in high degree. -/
theorem mem_riemannRochSpace_succ_nsmul_poles_iff (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (z : Fˣ) (n : ℕ)
    (hn : 2 * (genus k F : ℤ) - 1 ≤ ((n : ℤ) - 1) * Divisor.degree (Divisor.poles hF z)) (f : F) :
    f ∈ riemannRochSpace ((n + 1) • Divisor.poles hF z) ↔
      ∃ a ∈ riemannRochSpace (n • Divisor.poles hF z),
        ∃ b ∈ riemannRochSpace (n • Divisor.poles hF z), f = a + (z : F) * b := by
  have hbound : 2 * (genus k F : ℤ) - 1 ≤
      Divisor.degree (n • Divisor.poles hF z - Divisor.zeros hF z) := by
    rw [Divisor.degree_sub, map_nsmul, nsmul_eq_mul, Divisor.degree_zeros_eq_degree_poles hF z]
    nlinarith [hn]
  simpa only [add_nsmul, one_nsmul] using
    mem_riemannRochSpace_add_poles_iff hF hex z (n • Divisor.poles hF z) hbound f

/-- In the same range, every section of `(n + 1) D`, for `D = (z)∞`, is a sum of products of a
section of `D` with a section of `nD`, since the pencil `1, z` lies in `L(D)`. This is the
multiplication condition under which the section ring of `D` is generated in degree one. -/
theorem riemannRochSpace_succ_nsmul_poles_le_mul (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (z : Fˣ) (n : ℕ)
    (hn : 2 * (genus k F : ℤ) - 1 ≤ ((n : ℤ) - 1) * Divisor.degree (Divisor.poles hF z)) :
    riemannRochSpace ((n + 1) • Divisor.poles hF z) ≤
      riemannRochSpace (Divisor.poles hF z) * riemannRochSpace (n • Divisor.poles hF z) := by
  intro f hf
  obtain ⟨a, ha, b, hb, rfl⟩ := (mem_riemannRochSpace_succ_nsmul_poles_iff hF hex z n hn f).mp hf
  refine add_mem ?_ (Submodule.mul_mem_mul (mem_riemannRochSpace_poles hF z) hb)
  simpa only [one_mul] using Submodule.mul_mem_mul
    (one_mem_riemannRochSpace_iff.mpr (Divisor.isEffective_poles hF z).zero_le) ha

/-- Iterating the pencil: once the bound holds at `N`, every section of `(N + j) D`, for
`D = (z)∞`, is a sum of products of `j` sections of `D` with a section of `N D`. -/
theorem riemannRochSpace_add_nsmul_poles_le_pow_mul (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (z : Fˣ) {N : ℕ}
    (hN : 2 * (genus k F : ℤ) - 1 ≤ ((N : ℤ) - 1) * Divisor.degree (Divisor.poles hF z))
    (j : ℕ) :
    riemannRochSpace ((N + j) • Divisor.poles hF z) ≤
      riemannRochSpace (Divisor.poles hF z) ^ j * riemannRochSpace (N • Divisor.poles hF z) := by
  have hdeg := Divisor.degree_nonneg (Divisor.isEffective_poles hF z).zero_le
  induction j with
  | zero => simp
  | succ j ih =>
    rw [← add_assoc, pow_succ', mul_assoc]
    refine (riemannRochSpace_succ_nsmul_poles_le_mul hF hex z (N + j) ?_).trans
      (mul_le_mul_right ih _)
    push_cast
    nlinarith

/-- **The section ring of a multiple of a pole divisor is generated in degree one** once the
multiple is in the range of the pencil: if `2g - 1 ≤ (e - 1) deg D` for `D = (z)∞`, then every
section of `n (e D)` is a sum of products of `n` sections of `e D`, over an exact constant
field. -/
theorem riemannRochSpace_nsmul_nsmul_poles_le_pow (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (z : Fˣ) {e : ℕ}
    (he : 2 * (genus k F : ℤ) - 1 ≤ ((e : ℤ) - 1) * Divisor.degree (Divisor.poles hF z))
    (n : ℕ) :
    riemannRochSpace (n • e • Divisor.poles hF z) ≤
      riemannRochSpace (e • Divisor.poles hF z) ^ n := by
  have hdeg := Divisor.degree_nonneg (Divisor.isEffective_poles hF z).zero_le
  refine Divisor.adjoin_sectionRingGrade_one_eq_top_iff.mp
    (Divisor.adjoin_sectionRingGrade_one_eq_top hF hex fun m hm ↦ ?_) n
  have hm : (1 : ℤ) ≤ m := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hm
  -- `(m + 1) (e D) = (m e + e) D`, and `L(D)ᵉ ⊆ L(e D)`.
  rw [smul_smul, smul_smul, Nat.succ_mul]
  refine (riemannRochSpace_add_nsmul_poles_le_pow_mul hF hex z (N := m * e) ?_ e).trans
    (mul_le_mul_left (riemannRochSpace_pow_le_riemannRochSpace_nsmul _ e) _)
  have := mul_nonneg (mul_nonneg (sub_nonneg.2 hm) (Int.natCast_nonneg e)) hdeg
  push_cast
  nlinarith

/-- **High powers of a transcendental function have pole divisors whose section ring is generated
in degree one**: over an exact constant field, if `z` is transcendental over `k`, `e ≥ 1` and
`e ≥ 2g`, then every section of `n (zᵉ)∞` is a sum of products of `n` sections of `(zᵉ)∞`. -/
theorem riemannRochSpace_nsmul_poles_pow_le_pow (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) {z : Fˣ} (hz : Transcendental k (z : F)) {e : ℕ}
    (he₀ : 0 < e) (he : 2 * genus k F ≤ e) (n : ℕ) :
    riemannRochSpace (n • Divisor.poles hF (z ^ e)) ≤
      riemannRochSpace (Divisor.poles hF (z ^ e)) ^ n := by
  have := hF.finiteDimensional_adjoin hz
  have hdeg : 1 ≤ Divisor.degree (Divisor.poles hF z) := by
    rw [Divisor.degree_poles hF z hz]
    exact_mod_cast Module.finrank_pos
  rw [Divisor.poles_pow]
  refine riemannRochSpace_nsmul_nsmul_poles_le_pow hF hex z ?_ n
  have he' : (2 * genus k F : ℤ) ≤ e := by exact_mod_cast he
  have he₀' : (1 : ℤ) ≤ e := by exact_mod_cast he₀
  have := mul_nonneg (sub_nonneg.2 he₀') (sub_nonneg.2 hdeg)
  nlinarith

/-- **High powers of a transcendental function have pole divisors whose section ring is generated
in positive degrees, over any constant field**: if `z` is transcendental over `k`, `e ≥ 1` and
`e ≥ 2g`, where `g` is the genus of `F` over its full constant field `algebraicClosure k F`, then
for every `n ≠ 0`, every section of `n (zᵉ)∞` is a sum of products of `n` sections of `(zᵉ)∞`.
Degree zero is excluded: `L(0)` is `algebraicClosure k F`, which is larger than the constants `k`
unless `k` is the exact constant field. -/
theorem riemannRochSpace_nsmul_poles_pow_le_pow_of_ne_zero (hF : IsFunctionField k F) {z : Fˣ}
    (hz : Transcendental k (z : F)) {e : ℕ} (he₀ : 0 < e)
    (he : 2 * genus (algebraicClosure k F) F ≤ e) {n : ℕ} (hn : n ≠ 0) :
    riemannRochSpace (n • Divisor.poles hF (z ^ e)) ≤
      riemannRochSpace (Divisor.poles hF (z ^ e)) ^ n := by
  have hF' := hF.algebraicClosure
  -- Generation over the exact constant field `algebraicClosure k F`, restricted to `k`.
  have h := Submodule.restrictScalars_mono k
    (riemannRochSpace_nsmul_poles_pow_le_pow hF' isIntegrallyClosedIn_algebraicClosure
      (hz.extendScalars _) he₀ he n)
  rwa [Submodule.restrictScalars_pow hn, restrictScalars_riemannRochSpace_nsmul_poles hF hF',
    ← one_nsmul (Divisor.poles hF' _), restrictScalars_riemannRochSpace_nsmul_poles hF hF',
    one_nsmul] at h

/-- **In genus zero, the section ring of a pole divisor is generated in degree one**: over an
exact constant field, every section of `n D`, for `D = (z)∞`, is a sum of products of `n`
sections of `D`. -/
theorem riemannRochSpace_nsmul_poles_le_pow_of_genus_eq_zero (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (hg : genus k F = 0) (z : Fˣ) (n : ℕ) :
    riemannRochSpace (n • Divisor.poles hF z) ≤ riemannRochSpace (Divisor.poles hF z) ^ n := by
  simpa using riemannRochSpace_nsmul_nsmul_poles_le_pow hF hex z (e := 1) (by simp [hg]) n

/-- All higher sections are generated by one space `L(ND)` and bounded powers of `z`,
where `D = (z)∞`. Thus a basis of `L(ND)` supplies finitely many generators for the
high-degree part of the section ring as a module over the pencil `1, z`. -/
theorem riemannRochSpace_add_nsmul_poles_eq_span (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (z : Fˣ) (N : ℕ)
    (hN : 2 * (genus k F : ℤ) - 1 ≤ ((N : ℤ) - 1) * Divisor.degree (Divisor.poles hF z))
    (m : ℕ) :
    riemannRochSpace ((N + m) • Divisor.poles hF z) =
      Submodule.span k {f : F | ∃ i ≤ m, ∃ a ∈ riemannRochSpace (N • Divisor.poles hF z),
        f = (z : F) ^ i * a} := by
  have hD : 0 ≤ Divisor.poles hF z := (Divisor.isEffective_poles hF z).zero_le
  have hdegD : 0 ≤ Divisor.degree (Divisor.poles hF z) := Divisor.degree_nonneg hD
  induction m with
  | zero =>
    apply le_antisymm
    · intro f hf
      exact Submodule.subset_span ⟨0, le_refl 0, f, by simpa using hf, by simp⟩
    · refine Submodule.span_le.mpr ?_
      rintro f ⟨i, hi, a, ha, rfl⟩
      have hi0 : i = 0 := by omega
      simpa [hi0] using ha
  | succ m ih =>
    apply le_antisymm
    · intro f hf
      have hbound : 2 * (genus k F : ℤ) - 1 ≤
          (((N + m : ℕ) : ℤ) - 1) * Divisor.degree (Divisor.poles hF z) := by
        push_cast
        nlinarith
      obtain ⟨a, ha, b, hb, rfl⟩ :=
        (mem_riemannRochSpace_succ_nsmul_poles_iff hF hex z (N + m) hbound f).mp hf
      clear hf
      rw [ih] at ha hb
      refine Submodule.add_mem _ ?_ ?_
      · exact Submodule.span_mono (by
          rintro f ⟨i, hi, a, ha, rfl⟩
          exact ⟨i, by omega, a, ha, rfl⟩) ha
      · refine Submodule.mapsTo_span (f := LinearMap.mulLeft k (z : F)) ?_ hb
        rintro f ⟨i, hi, a, ha, rfl⟩
        exact ⟨i + 1, by omega, a, ha, by simp [pow_succ, mul_assoc, mul_left_comm]⟩
    · refine Submodule.span_le.mpr ?_
      rintro f ⟨i, hi, a, ha, rfl⟩
      have hpow : (z : F) ^ i ∈ riemannRochSpace (i • Divisor.poles hF z) := by
        simpa using pow_mem_riemannRochSpace_zsmul (mem_riemannRochSpace_poles hF z) i
      have hmul := mul_mem_riemannRochSpace_add hpow ha
      rw [← add_nsmul] at hmul
      exact riemannRochSpace_mono (nsmul_le_nsmul_left hD (by omega)) hmul

end TauCeti
