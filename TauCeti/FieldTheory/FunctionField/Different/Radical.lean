module

public import TauCeti.FieldTheory.FunctionField.Different.Derivative
public import TauCeti.FieldTheory.FunctionField.Different.Hurwitz
public import TauCeti.FieldTheory.FunctionField.Place.Extension.Radical
-- Proof-only: `Valuation.finrank_eq_of_pow_eq_of_gcd_ord_eq_one`, the degree of `F' / F`.
import TauCeti.FieldTheory.KummerExtension

/-!
# The different of a radical extension `y ^ n = u`

Let `F' / k'` be a finite separable extension of the field extension `F / k`, generated by an
element `y` with `y ^ n = u` for some nonzero `u ∈ F`, where `n` is invertible in `k`. At a place
`P'` of `F'` over the place `P` of `F`, write `r_P = gcd(n, ord_P u)`. Stichtenoth's
Proposition 3.7.3(b) gives the ramification data `e(P' ∣ P) = n / r_P` and
`d(P' ∣ P) = n / r_P - 1`. This file proves the two extreme cases, which together cover every
place when `n` is prime. Both rest on Stichtenoth's Theorem 3.5.10(a) applied to `X ^ n - c`: if
`F' = F(z)` with `z ^ n = c` regular at `P`, then `d(P' ∣ P) ≤ (n - 1) · ord_{P'} z`.

* If `n ∣ ord_P u` (that is, `r_P = n`), then `P` is unramified in `F'`: `d(P' ∣ P) = 0` and
  `e(P' ∣ P) = 1`.
* If `gcd(n, ord_P u) = 1`, then `d(P' ∣ P) = n - 1`.

For `n = 2` this is the different of `y ^ 2 = f(x)` over `k(x)` in characteristic not two: the
places over `P` ramify exactly when `ord_P f` is odd, each with different exponent one.

For prime `n` the two cases assemble into a divisor identity. Let `B` be the sum of the places `P`
of `F` with `n ∤ ord_P u`. Each of them is totally ramified, so `n • Diff(F'/F) = (n - 1) • Con(B)`.
Taking degrees gives `[k' : k] · deg Diff(F'/F) = (n - 1) · deg B`, and the Hurwitz genus formula
becomes the closed genus formula of a radical extension of prime exponent,
`[k' : k] · (2g' - 2) = [F' : F] · (2g - 2) + (n - 1) · deg B`.

## Main results

* `TauCeti.Place.differentExponent_le_mul_ord_of_pow_eq`: `d(P' ∣ P) ≤ (n - 1) · ord_{P'} z` for
  a generator `z` with `z ^ n` regular at `P`.
* `TauCeti.Place.differentExponent_eq_zero_of_pow_eq_of_dvd_ord` and
  `TauCeti.Place.ramificationIdx_eq_one_of_pow_eq_of_dvd_ord`: the unramified case.
* `TauCeti.Place.differentExponent_add_one_eq_of_pow_eq_of_gcd_ord_eq_one`: the totally ramified
  case, `d(P' ∣ P) + 1 = n`.
* `TauCeti.Place.differentExponent_eq_of_pow_eq_of_prime` and
  `TauCeti.Place.ramificationIdx_eq_of_pow_eq_of_prime`: the different exponent and ramification
  index at every place of a radical extension `y ^ n = u` with `n` prime.
* `TauCeti.Divisor.nsmul_different_eq_nsmul_conorm_of_pow_eq_of_prime`:
  `n • Diff(F'/F) = (n - 1) • Con(B)` for `n` prime.
* `TauCeti.Divisor.finrank_mul_degree_different_of_pow_eq_of_prime`:
  `[k' : k] · deg Diff(F'/F) = (n - 1) · deg B` for `n` prime.
* `TauCeti.hurwitz_genus_formula_of_pow_eq_of_prime`: the genus of a radical extension of prime
  exponent.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Proposition 3.7.3, Corollary 3.7.4 and Theorem 3.5.10.
-/

public section

open Polynomial

open scoped IntermediateField

namespace TauCeti

namespace Place

universe u u' v v'

variable {k : Type u} {k' : Type u'} {F : Type v} {F' : Type v'}
variable [Field k] [Field k'] [Field F] [Field F']
variable [Algebra k k'] [Algebra k F] [Algebra k' F'] [Algebra F F'] [Algebra k F']
variable [IsScalarTower k k' F'] [IsScalarTower k F F']
variable [FiniteDimensional F F'] [Algebra.IsSeparable F F']

variable (k F) {P' : Place k' F'}

/-- **The different exponent above a radical generator** (Stichtenoth, Theorem 3.5.10(a) for
`X ^ n - c`): if `F' = F(z)` with `z ^ n = c` for some `c ∈ F` regular at the place `P` below `P'`,
`z ≠ 0`, and `n` invertible in `k`, then `d(P' ∣ P) ≤ (n - 1) · ord_{P'} z`. -/
theorem differentExponent_le_mul_ord_of_pow_eq {z : F'} {n : ℕ} {c : F} (hgen : F⟮z⟯ = ⊤)
    (hz : z ^ n = algebraMap F F' c) (hn : (n : k) ≠ 0) (hc : c ∈ (P'.restrict k F).integers)
    (hz0 : z ≠ 0) :
    (differentExponent k F P' : ℤ) ≤ ((n : ℤ) - 1) * P'.ord z := by
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hn Nat.cast_zero
  have hn' : (n : F') ≠ 0 := by
    rw [← map_natCast (algebraMap k F')]
    exact (_root_.map_ne_zero _).mpr hn
  have hder : aeval z (derivative (X ^ n - C c)) = (n : F') * z ^ (n - 1) := by
    simp [derivative_X_pow]
  have hd := differentExponent_le_ord_aeval_derivative k F hgen (monic_X_pow_sub_C c hn0)
    (fun i ↦ by
      rw [coeff_sub, coeff_X_pow, coeff_C]
      refine sub_mem ?_ ?_ <;> split_ifs
      exacts [one_mem _, zero_mem _, hc, zero_mem _])
    (by simp [hz]) (by rw [hder]; exact mul_ne_zero hn' (pow_ne_zero _ hz0))
  rwa [hder, P'.ord_mul hn' (pow_ne_zero _ hz0), P'.ord_eq_zero_of_isAlgebraic
    (isAlgebraic_natCast n), P'.ord_pow, Nat.cast_sub (Nat.one_le_iff_ne_zero.mpr hn0),
    Nat.cast_one, zero_add] at hd

/-- **A radical extension is unramified where the order of the radicand is divisible by the
exponent `n`** (Stichtenoth, Proposition 3.7.3(b) with `r_P = n`): if `F' = F(y)` with
`y ^ n = u` for a
nonzero `u ∈ F`, `n` is invertible in `k`, and `n` divides the order of `u` at the place `P` below
`P'`, then `d(P' ∣ P) = 0`. -/
theorem differentExponent_eq_zero_of_pow_eq_of_dvd_ord {y : F'} {n : ℕ} {u : F}
    (hgen : F⟮y⟯ = ⊤) (hy : y ^ n = algebraMap F F' u) (hn : (n : k) ≠ 0) (hu : u ≠ 0)
    (hdvd : (n : ℤ) ∣ (P'.restrict k F).ord u) :
    differentExponent k F P' = 0 := by
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hn Nat.cast_zero
  -- Divide `y` by `w ∈ F` with `n · ord_P w = ord_P u`, to get a generator `z` whose `n`-th power
  -- `c` is a unit at `P`.
  obtain ⟨w, hw0, hw⟩ := (P'.restrict k F).exists_ne_zero_ord_eq ((P'.restrict k F).ord u / n)
  have hwF : algebraMap F F' w ≠ 0 := (_root_.map_ne_zero _).mpr hw0
  set c := u / w ^ n with hc_def
  set z := y / algebraMap F F' w with hz_def
  have hz : z ^ n = algebraMap F F' c := by
    rw [hz_def, hc_def, div_pow, hy, map_div₀, map_pow]
  have hc : (P'.restrict k F).ord c = 0 := by
    rw [hc_def, (P'.restrict k F).ord_div hu (pow_ne_zero _ hw0), ord_pow, hw,
      Int.mul_ediv_cancel' hdvd, sub_self]
  have hgenz : F⟮z⟯ = ⊤ := by
    have hyz : y = z * algebraMap F F' w := by rw [hz_def, div_mul_cancel₀ _ hwF]
    rw [eq_top_iff, ← hgen, IntermediateField.adjoin_simple_le_iff, hyz]
    exact mul_mem (IntermediateField.mem_adjoin_simple_self F z)
      (IntermediateField.algebraMap_mem _ w)
  have hz0 : z ≠ 0 := div_ne_zero (fun h0 ↦ by
    rw [h0, zero_pow hn0, eq_comm, map_eq_zero] at hy
    exact hu hy) hwF
  -- `z` is a unit at `P'`, since `n · ord_{P'} z = e(P' ∣ P) · ord_P c = 0`.
  have hordz : P'.ord z = 0 := by
    have := natCast_mul_ord_eq_ramificationIdx_mul_ord_of_pow_eq k F (P' := P') hz
    rw [hc, mul_zero, mul_eq_zero] at this
    exact this.resolve_left (by exact_mod_cast hn0)
  have hd := differentExponent_le_mul_ord_of_pow_eq k F hgenz hz hn
    ((P'.restrict k F).mem_integers_iff_ord_nonneg.mpr hc.ge) hz0
  rw [hordz, mul_zero] at hd
  omega

/-- **A radical extension is unramified where the order of the radicand is divisible by the
exponent `n`** (Stichtenoth, Proposition 3.7.3(b) with `r_P = n`): if `F' = F(y)` with
`y ^ n = u` for a
nonzero `u ∈ F`, `n` is invertible in `k`, and `n` divides the order of `u` at the place `P` below
`P'`, then `e(P' ∣ P) = 1`. -/
theorem ramificationIdx_eq_one_of_pow_eq_of_dvd_ord {y : F'} {n : ℕ} {u : F}
    (hgen : F⟮y⟯ = ⊤) (hy : y ^ n = algebraMap F F' u) (hn : (n : k) ≠ 0) (hu : u ≠ 0)
    (hdvd : (n : ℤ) ∣ (P'.restrict k F).ord u) :
    ramificationIdx F P' = 1 := by
  have := ramificationIdx_le_differentExponent_add_one k F P'
  rw [differentExponent_eq_zero_of_pow_eq_of_dvd_ord k F hgen hy hn hu hdvd] at this
  have := ramificationIdx_pos F P'
  omega

/-- **The different exponent of a totally ramified radical extension** (Stichtenoth,
Proposition 3.7.3(b) with `r_P = 1`): if `F' = F(y)` with `y ^ n = u` for a nonzero `u ∈ F`, `n`
is invertible in `k`, and `n` is coprime to the order of `u` at the place `P` below `P'`, then
`d(P' ∣ P) = n - 1`, stated as `d(P' ∣ P) + 1 = n` so that no truncated subtraction appears. -/
theorem differentExponent_add_one_eq_of_pow_eq_of_gcd_ord_eq_one {y : F'} {n : ℕ} {u : F}
    (hgen : F⟮y⟯ = ⊤) (hy : y ^ n = algebraMap F F' u) (hn : (n : k) ≠ 0) (hu : u ≠ 0)
    (h : Int.gcd n ((P'.restrict k F).ord u) = 1) :
    differentExponent k F P' + 1 = n := by
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hn Nat.cast_zero
  obtain ⟨z, c, hgenz, hz, hc, hz0⟩ :=
    exists_adjoin_eq_top_pow_eq_ord_eq_one k F (P'.restrict k F) hgen hy hu hn0 h
  -- `d ≤ (n - 1) · ord_{P'} z`, while `n · ord_{P'} z = e(P' ∣ P) ≤ d + 1`; so `ord_{P'} z = 1`.
  have hd := differentExponent_le_mul_ord_of_pow_eq k F hgenz hz hn
    ((P'.restrict k F).mem_integers_iff_ord_nonneg.mpr (hc ▸ zero_le_one)) hz0
  have hkey := natCast_mul_ord_eq_ramificationIdx_mul_ord_of_pow_eq k F (P' := P') hz
  rw [hc, mul_one] at hkey
  have hle : (ramificationIdx F P' : ℤ) ≤ differentExponent k F P' + 1 := by
    exact_mod_cast ramificationIdx_le_differentExponent_add_one k F P'
  have hpos : (0 : ℤ) < ramificationIdx F P' := by exact_mod_cast ramificationIdx_pos F P'
  have hn1 : (1 : ℤ) ≤ n := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hn0
  have ho : P'.ord z = 1 := le_antisymm (by nlinarith) (by nlinarith)
  rw [ho, mul_one] at hkey hd
  have : (differentExponent k F P' : ℤ) + 1 = n := by linarith
  exact_mod_cast this

/-- **The different exponent of a radical extension of prime exponent** (Stichtenoth,
Proposition 3.7.3(b)): if `F' = F(y)` with `y ^ n = u` for a nonzero `u ∈ F`, `n` is prime and
invertible in `k`, then `d(P' ∣ P)` is `0` when `n` divides the order of `u` at the place `P`
below `P'`, and `n - 1` otherwise. -/
theorem differentExponent_eq_of_pow_eq_of_prime {y : F'} {n : ℕ} {u : F} (hp : n.Prime)
    (hgen : F⟮y⟯ = ⊤) (hy : y ^ n = algebraMap F F' u) (hn : (n : k) ≠ 0) (hu : u ≠ 0) :
    differentExponent k F P' = if (n : ℤ) ∣ (P'.restrict k F).ord u then 0 else n - 1 := by
  split_ifs with hdvd
  · exact differentExponent_eq_zero_of_pow_eq_of_dvd_ord k F hgen hy hn hu hdvd
  · have := differentExponent_add_one_eq_of_pow_eq_of_gcd_ord_eq_one k F hgen hy hn hu
      (Int.isCoprime_iff_gcd_eq_one.mp
        ((Nat.prime_iff_prime_int.mp hp).coprime_iff_not_dvd.mpr hdvd))
    omega

/-- **The ramification index of a radical extension of prime exponent** (Stichtenoth,
Proposition 3.7.3(b)): if `F' = F(y)` with `y ^ n = u` for a nonzero `u ∈ F`, `n` is prime and
invertible in `k`, then the place `P` below `P'` is unramified when `n` divides `ord_P u`, and
`e(P' ∣ P) = n` otherwise. -/
theorem ramificationIdx_eq_of_pow_eq_of_prime {y : F'} {n : ℕ} {u : F} (hp : n.Prime)
    (hgen : F⟮y⟯ = ⊤) (hy : y ^ n = algebraMap F F' u) (hn : (n : k) ≠ 0) (hu : u ≠ 0) :
    ramificationIdx F P' = if (n : ℤ) ∣ (P'.restrict k F).ord u then 1 else n := by
  split_ifs with hdvd
  · exact ramificationIdx_eq_one_of_pow_eq_of_dvd_ord k F hgen hy hn hu hdvd
  · -- `n ∣ e(P' ∣ P) ≤ d(P' ∣ P) + 1 = n`.
    have hgcd := Int.isCoprime_iff_gcd_eq_one.mp
      ((Nat.prime_iff_prime_int.mp hp).coprime_iff_not_dvd.mpr hdvd)
    have hdiv := div_gcd_ord_dvd_ramificationIdx_of_pow_eq k F (P' := P') hp.ne_zero hy
    rw [hgcd, Nat.div_one] at hdiv
    have hd := differentExponent_add_one_eq_of_pow_eq_of_gcd_ord_eq_one k F hgen hy hn hu hgcd
    have hle := ramificationIdx_le_differentExponent_add_one k F P'
    exact (hd ▸ hle).antisymm (Nat.le_of_dvd (ramificationIdx_pos F P') hdiv)

end Place

/-! ### The different divisor of a radical extension of prime exponent -/

section DifferentDivisor

open AlgebraicGeometry

universe u u' v v'

variable {k : Type u} {k' : Type u'} {F : Type v} {F' : Type v'}
variable [Field k] [Field k'] [Field F] [Field F']
variable [Algebra k k'] [Algebra k F] [Algebra k' F'] [Algebra F F'] [Algebra k F']
variable [IsScalarTower k k' F'] [IsScalarTower k F F']
variable [FiniteDimensional F F'] [Algebra.IsSeparable F F']

namespace Divisor

variable (k' F') (hF : IsFunctionField k F)

/-- The branch divisor of a radical extension: the sum of places whose order of the radicand is
not divisible by the exponent. -/
noncomputable def radicalBranch (n : ℕ) (u : F) (hu : u ≠ 0) : Divisor k F :=
  WeilDivisor.ofFinset {P ∈ (principal hF (Units.mk0 u hu)).support | ¬ (n : ℤ) ∣ P.ord u}

/-- The coefficient of a radical branch divisor is one at its branch places and zero elsewhere. -/
@[simp]
theorem coeff_radicalBranch (P : Place k F) {n : ℕ} {u : F} (hu : u ≠ 0) :
    (radicalBranch hF n u hu).coeff P = if (n : ℤ) ∣ P.ord u then 0 else 1 := by
  classical
  have hmem : P ∈ {P ∈ (principal hF (Units.mk0 u hu)).support |
      ¬ (n : ℤ) ∣ P.ord u} ↔ ¬ (n : ℤ) ∣ P.ord u := by
    rw [Finset.mem_filter, mem_support_principal_iff, Units.val_mk0, and_iff_right_iff_imp]
    exact fun h h0 ↦ h (h0 ▸ dvd_zero _)
  rw [radicalBranch, WeilDivisor.coeff_ofFinset]
  simp [hmem]

/-- A place occurs in the radical branch divisor exactly when the exponent does not divide the
order of the radicand there. -/
@[simp]
theorem mem_support_radicalBranch_iff (P : Place k F) {n : ℕ} {u : F} (hu : u ≠ 0) :
    P ∈ (radicalBranch hF n u hu).support ↔ ¬ (n : ℤ) ∣ P.ord u := by
  classical
  rw [WeilDivisor.mem_support_iff, coeff_radicalBranch]
  split_ifs <;> simp [*]

/-- **The different divisor of a radical extension of prime exponent** (Stichtenoth,
Proposition 3.7.3(b)): if `F' = F(y)` with `y ^ n = u` for a nonzero `u ∈ F`, `n` is prime and
invertible in `k`, then `n • Diff(F'/F) = (n - 1) • Con(B)`, where `B` is the sum of the places `P`
of `F` with `n ∤ ord_P u`.  Each such place is totally ramified with different exponent `n - 1`
above it, and every other place is unramified. -/
theorem nsmul_different_eq_nsmul_conorm_of_pow_eq_of_prime {y : F'} {n : ℕ} {u : F} (hp : n.Prime)
    (hgen : F⟮y⟯ = ⊤) (hy : y ^ n = algebraMap F F' u) (hn : (n : k) ≠ 0) (hu : u ≠ 0) :
    n • different k' F' hF = (n - 1) • conorm k' F' (radicalBranch hF n u hu) := by
  classical
  refine WeilDivisor.ext fun P' ↦ ?_
  rw [WeilDivisor.coeff_nsmul, WeilDivisor.coeff_nsmul, coeff_different, coeff_conorm,
    Place.differentExponent_eq_of_pow_eq_of_prime k F hp hgen hy hn hu,
    Place.ramificationIdx_eq_of_pow_eq_of_prime k F hp hgen hy hn hu]
  rw [coeff_radicalBranch hF (P'.restrict k F) hu]
  by_cases hdvd : (n : ℤ) ∣ (P'.restrict k F).ord u
  · simp [hdvd]
  · simp only [hdvd, ite_false]
    push_cast [Nat.cast_sub hp.one_le]
    ring

/-- **The degree of the different of a radical extension of prime exponent** (Stichtenoth,
Proposition 3.7.3(b) and Corollary 3.7.4): if `F' = F(y)` with `y ^ n = u` for a nonzero `u ∈ F`,
`n` is prime and invertible in `k`, and `k' / k` is algebraic, then
`[k' : k] · deg Diff(F'/F) = (n - 1) · deg B`, where `B` is the sum of the places `P` of `F` with
`n ∤ ord_P u`. -/
theorem finrank_mul_degree_different_of_pow_eq_of_prime [Algebra.IsIntegral k k'] {y : F'} {n : ℕ}
    {u : F} (hp : n.Prime) (hgen : F⟮y⟯ = ⊤) (hy : y ^ n = algebraMap F F' u) (hn : (n : k) ≠ 0)
    (hu : u ≠ 0) :
    (Module.finrank k k' : ℤ) * degree (different k' F' hF) = ((n : ℤ) - 1) * degree
      (radicalBranch hF n u hu) := by
  set B := radicalBranch hF n u hu with hB
  have hn0 : (n : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have hcon := finrank_mul_degree_conorm_of_isSeparable k' F' B
  have hdeg := congrArg (fun D ↦ (Module.finrank k k' : ℤ) * degree D)
    (nsmul_different_eq_nsmul_conorm_of_pow_eq_of_prime k' F' hF hp hgen hy hn hu)
  simp only [map_nsmul, nsmul_eq_mul, Nat.cast_sub hp.one_le, Nat.cast_one, ← hB] at hdeg
  -- Either some place has `n ∤ ord_P u`, and then `[F' : F] = n`, or `B = 0`.
  have key : (n : ℤ) * ((Module.finrank k k' : ℤ) * degree (different k' F' hF)) =
      n * (((n : ℤ) - 1) * degree B) := by
    by_cases hS : B.support.Nonempty
    · obtain ⟨P, hP⟩ := hS
      rw [Place.finrank_eq_of_pow_eq_of_prime_of_not_dvd_ord k F P hp hgen hy
        ((mem_support_radicalBranch_iff hF P hu).mp (hB ▸ hP))] at hcon
      linear_combination hdeg + ((n : ℤ) - 1) * hcon
    · have hB0 : B = 0 := by
        apply Finsupp.ext
        intro P
        by_contra hP
        exact hS ⟨P, Finsupp.mem_support_iff.mpr hP⟩
      simp only [hB0, map_zero] at hdeg ⊢
      linear_combination hdeg
  exact mul_left_cancel₀ hn0 key

end Divisor

omit [FiniteDimensional F F'] [Algebra.IsSeparable F F'] in
/-- **The genus of a radical extension of prime exponent** (Stichtenoth, Corollary 3.7.4 for
prime `n`): if `F' = F(y)` with `y ^ n = u` for a nonzero `u ∈ F`, `n` is prime and invertible
in `k`, both fields have exact constants and `k' / k` is finite separable, then
`[k' : k] · (2g' - 2) = [F' : F] · (2g - 2) + (n - 1) · deg B`, where `B` is the sum of the places
`P` of `F` with `n ∤ ord_P u`. -/
theorem hurwitz_genus_formula_of_pow_eq_of_prime [FiniteDimensional k k'] [Algebra.IsSeparable k k']
    (hF : IsFunctionField k F) (hF' : IsFunctionField k' F') (hex : IsIntegrallyClosedIn k F)
    (hex' : IsIntegrallyClosedIn k' F') {y : F'} {n : ℕ} {u : F} (hp : n.Prime)
    (hgen : F⟮y⟯ = ⊤) (hy : y ^ n = algebraMap F F' u) (hn : (n : k) ≠ 0) (hu : u ≠ 0) :
    (Module.finrank k k' : ℤ) * (2 * genus k' F' - 2) =
      Module.finrank F F' * (2 * genus k F - 2) + ((n : ℤ) - 1) * Divisor.degree
        (Divisor.radicalBranch hF n u hu) := by
  have : FiniteDimensional F F' := Algebra.finiteDimensional_of_pow_eq hgen hy hp.ne_zero
  have hnF : (n : F) ≠ 0 := by
    rw [← map_natCast (algebraMap k F)]
    exact (_root_.map_ne_zero _).mpr hn
  have : Algebra.IsSeparable F F' := Algebra.isSeparable_of_pow_eq hgen hy hnF hu
  rw [hurwitz_genus_formula hF hF' hex hex',
    Divisor.finrank_mul_degree_different_of_pow_eq_of_prime k' F' hF hp hgen hy hn hu]

end DifferentDivisor

end TauCeti
