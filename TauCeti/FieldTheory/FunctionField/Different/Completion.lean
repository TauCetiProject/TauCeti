/-!
# The trace-dual different of a place under completion

For a place `P'` of `F' / k'` lying over `P = P'.restrict k F` of `F / k` with `F' / F` finite and
separable (no perfectness, finiteness, or residue-separability assumptions), the complementary
module, different ideal and exponent, complementary-module length, and discriminant valuation all
commute with passing to the completed extension `F̂_P → F̂'_{P'}`. Callers install the local algebra
structures `TauCeti.Place.completionExtensionAlgebra` and `completionIntegersExtensionAlgebra` (as
`letI`), and install `algebraIntegersExtension` and `isScalarTowerIntegersExtension` with
`attribute [local instance 10]` for `𝒪_P ⊆ 𝒪'_P`.

## Main results

* `sum_trace_mul_smul_completionEmbedding_eq`: trace-dual expansions of `F' / F` pass to
  `F̂'_{P'} / F̂_P`.
* `traceDual_one_completionIntegers_eq_span`, `extended_dual_one_eq_dual_one_completionIntegers`,
  `mem_traceDual_completionIntegers_iff_valuation_le`: the completed complementary module is
  generated by (and is the fractional-ideal extension of) the local-model one and equals
  `{z | v_{P̂'}(z) ≤ exp d(P' ∣ P)}`.
* `map_differentIdeal_eq_differentIdeal_completionIntegers`,
  `map_differentIdeal_pi_eq_pi_differentIdeal_completionIntegers`,
  `differentIdeal_completionIntegers_eq_maximalIdeal_pow`,
  `multiplicity_differentIdeal_completionIntegers`, `differentExponent_completionPlace`:
  `differentIdeal 𝒪_P 𝒪'_P` generates `differentIdeal 𝒪̂_P 𝒪̂_{P'} = 𝔪̂_{P'} ^ d(P' ∣ P)` at a
  single place and `∏_{Q' ∣ P} differentIdeal 𝒪̂_P 𝒪̂_{Q'}` across all places above `P`, and
  `d(P̂' ∣ P̂) = d(P' ∣ P)`.
* `span_traceDual_one_eq_traceDual_one_completionIntegers_of_forall_mem_integers`,
  `map_differentIdeal_eq_differentIdeal_completionIntegers_of_forall_mem_integers`: the same
  complementary-module and different-ideal comparisons read directly from an affine model `B ⊆ C`.
* `length_traceDual_completionIntegers_quotient`,
  `length_quotient_differentIdeal_completionIntegers`, `ord_discr_completionIntegers`,
  `completionPlace_ord_discr_completionIntegers`, `length_traceDual_completionIntegers_quotient_eq`,
  `ord_discr_completionIntegers_eq`: length and discriminant valuation formulas and invariance under
  completion.

## References

* J.-P. Serre, *Local Fields*, GTM 67, Springer, 1979, Chapter II, §3 and Chapter III, §§2–4.
* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, 2009, I.7 and III.4–5.
-/

public section
noncomputable section

open IsDedekindDomain IsLocalRing
open scoped WithZero nonZeroDivisors

namespace TauCeti.Place

section Different

variable {k k' F F' : Type*} [Field k] [Field k'] [Field F] [Field F']
  [Algebra k F] [Algebra k k'] [Algebra k' F'] [Algebra k F'] [Algebra F F']
  [IsScalarTower k k' F'] [IsScalarTower k F F']
  [FiniteDimensional F F'] [Algebra.IsSeparable F F']

attribute [local instance 10] algebraIntegersExtension isScalarTowerIntegersExtension

private abbrev centerBase (P' : Place k' F') : HeightOneSpectrum (P'.restrict k F).integers :=
  (P'.restrict k F).center (algebraMap_mem_integers_restrict (R := (P'.restrict k F).integers)
    k F P' (algebraMap_mem_integers_of_mem_integralClosure k F P'))

private theorem centerIntegralClosure_liesOver_centerBase (P' : Place k' F') :
    (centerIntegralClosure k F P').asIdeal.LiesOver (centerBase (k := k) (F := F) P').asIdeal :=
  centerIntegralClosure_def k F P' ▸
    center_liesOver k F P' (algebraMap_mem_integers_of_mem_integralClosure k F P')

omit [FiniteDimensional F F'] in
private theorem valuation_eq_centerBase (P' : Place k' F') :
    (P'.restrict k F).valuation = (centerBase (k := k) (F := F) P').valuation F :=
  ((P'.restrict k F).valuation_center _).symm

private theorem valuation_eq_centerIntegralClosure (P' : Place k' F') :
    P'.valuation = (centerIntegralClosure k F P').valuation F' :=
  centerIntegralClosure_def k F P' ▸ (P'.valuation_center _).symm

omit [FiniteDimensional F F'] [Algebra.IsSeparable F F'] in
private theorem isTorsionFree_integers [Algebra.IsIntegral F F'] (P' : Place k' F') :
    Module.IsTorsionFree (P'.restrict k F).integers P'.integers :=
  Module.isTorsionFree_iff_algebraMap_injective.mpr fun _ _ hab ↦ Subtype.ext <|
    (algebraMap F F').injective <| by simpa [coe_algebraMap_integers] using congrArg Subtype.val hab

open scoped AdicCompletionExtension in
private theorem mem_traceDual_completionIntegers_iff_adic (P' : Place k' F') (z : P'.Completion) :
    letI := (P'.restrict k F).completionExtensionAlgebra P' rfl
    letI := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
    haveI := centerIntegralClosure_liesOver_centerBase (k := k) (F := F) P'
    z ∈ Submodule.traceDual (P'.restrict k F).completionPlace.integers (P'.restrict k F).Completion
        (1 : Submodule P'.completionPlace.integers P'.Completion) ↔
      completionEquivAdicCompletionOfValuationEq k' F' (centerIntegralClosure k F P') P'
          (valuation_eq_centerIntegralClosure (k := k) (F := F) P') z ∈
        Submodule.traceDual ((centerBase (k := k) (F := F) P').adicCompletionIntegers F)
          ((centerBase (k := k) (F := F) P').adicCompletion F)
          (1 : Submodule ((centerIntegralClosure k F P').adicCompletionIntegers F')
            ((centerIntegralClosure k F P').adicCompletion F')) := by
  let _ := (P'.restrict k F).completionExtensionAlgebra P' rfl
  let _ := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
  have := centerIntegralClosure_liesOver_centerBase (k := k) (F := F) P'
  exact RingEquiv.mem_traceDual_one_iff_of_equiv
    (completionIntegersRingEquivAdicCompletionIntegersOfValuationEq k F _ _
      (valuation_eq_centerBase P'))
    (completionEquivAdicCompletionOfValuationEq k F _ _
      (valuation_eq_centerBase P')).toAlgEquiv.toRingEquiv
    (completionIntegersRingEquivAdicCompletionIntegersOfValuationEq k' F' _ P'
      (valuation_eq_centerIntegralClosure P'))
    (completionEquivAdicCompletionOfValuationEq k' F' _ P'
      (valuation_eq_centerIntegralClosure P')).toAlgEquiv.toRingEquiv
    (fun a ↦
      (completionIntegersRingEquivAdicCompletionIntegersOfValuationEq_apply k F _ _ _ a).symm)
    (fun b ↦
      (completionIntegersRingEquivAdicCompletionIntegersOfValuationEq_apply k' F' _ _ _ b).symm)
    (algebraMap_comp_completionEquivAdicCompletionOfValuationEq (centerBase P')
      (centerIntegralClosure k F P') (P'.restrict k F) P' rfl
      (valuation_eq_centerBase P') (valuation_eq_centerIntegralClosure P')) z

/-- **Trace-dual expansions pass to completions.** If `x = ∑ᵢ Tr_{F'/F}(x bᵢ) • yᵢ` for every
`x ∈ F'`, then `z = ∑ᵢ Tr_{F̂'_{P'}/F̂_P}(z bᵢ) • yᵢ` for every `z ∈ F̂'_{P'}`. -/
theorem sum_trace_mul_smul_completionEmbedding_eq (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) {ι : Type*} [Fintype ι] (b y : ι → F')
    (hb : ∀ x : F', ∑ i, Algebra.trace F F' (x * b i) • y i = x) (z : P'.Completion) :
    letI := P.completionExtensionAlgebra P' hP
    ∑ i, Algebra.trace P.Completion P'.Completion
        (z * P'.completionEmbedding (b i)) • P'.completionEmbedding (y i) = z := by
  subst hP
  open scoped AdicCompletionExtension in
  let _ := (P'.restrict k F).completionExtensionAlgebra P' rfl
  let _ := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
  have := centerIntegralClosure_liesOver_centerBase (k := k) (F := F) P'
  let v := centerBase (k := k) (F := F) P'; let w := centerIntegralClosure k F P'
  let hv := valuation_eq_centerBase (k := k) (F := F) P'
  let hw := valuation_eq_centerIntegralClosure (k := k) (F := F) P'
  let eK := (completionEquivAdicCompletionOfValuationEq k F v _ hv).toAlgEquiv.toRingEquiv
  let eL := (completionEquivAdicCompletionOfValuationEq k' F' w P' hw).toAlgEquiv.toRingEquiv
  have hKL := algebraMap_comp_completionEquivAdicCompletionOfValuationEq v w (P'.restrict k F) P'
    rfl hv hw
  have hsum := v.sum_trace_adicCompletion_mul_smul_eq (K := F)
    (B := integralClosure (P'.restrict k F).integers F') (L := F') w b y hb (eL z)
  apply eL.injective
  rw [map_sum]
  have hmap (t : (P'.restrict k F).Completion) :
      eL (algebraMap (P'.restrict k F).Completion P'.Completion t) =
        algebraMap (v.adicCompletion F) (w.adicCompletion F') (eK t) :=
    (RingHom.congr_fun hKL t).symm
  have hemb (x : F') :
      eL (P'.completionEmbedding x) = algebraMap F' (w.adicCompletion F') x :=
    completionEquivAdicCompletionOfValuationEq_completionEmbedding k' F' w P' hw x
  refine (Finset.sum_congr rfl fun i _ ↦ ?_).trans hsum
  rw [Algebra.smul_def, Algebra.smul_def, map_mul, hmap,
    Algebra.trace_eq_of_equiv_equiv eK eL hKL, RingEquiv.apply_symm_apply, map_mul,
    hemb (b i), hemb (y i)]

/-- **The completed complementary module is generated by the local-model complementary module**,
with no hypothesis on the residue fields. -/
theorem traceDual_one_completionIntegers_eq_span (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) :
    letI := P.completionExtensionAlgebra P' hP
    letI := P.completionIntegersExtensionAlgebra P' hP
    Submodule.traceDual P.completionPlace.integers P.Completion
        (1 : Submodule P'.completionPlace.integers P'.Completion) =
      Submodule.span P'.completionPlace.integers
        (P'.completionEmbedding ''
          Submodule.traceDual P.integers F (1 : Submodule (integralClosure P.integers F') F')) := by
  subst hP
  open scoped AdicCompletionExtension in
  let _ := (P'.restrict k F).completionExtensionAlgebra P' rfl
  let _ := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
  have := centerIntegralClosure_liesOver_centerBase (k := k) (F := F) P'
  let v := centerBase (k := k) (F := F) P'; let w := centerIntegralClosure k F P'
  let hw := valuation_eq_centerIntegralClosure (k := k) (F := F) P'
  let eB := completionIntegersRingEquivAdicCompletionIntegersOfValuationEq k' F' w P' hw
  let eL := (completionEquivAdicCompletionOfValuationEq k' F' w P' hw).toAlgEquiv.toRingEquiv
  let S : Set F' := Submodule.traceDual (P'.restrict k F).integers F
    (1 : Submodule (integralClosure (P'.restrict k F).integers F') F')
  have hspan := v.traceDual_one_adicCompletionIntegers_eq_span (K := F)
    (B := integralClosure (P'.restrict k F).integers F') (L := F') w
  refine le_antisymm (fun z hz ↦ ?_) (Submodule.span_le.mpr ?_)
  · have hmem : ∀ u ∈ Submodule.span (w.adicCompletionIntegers F')
        (algebraMap F' (w.adicCompletion F') '' S),
        eL.symm u ∈ Submodule.span P'.completionPlace.integers (P'.completionEmbedding '' S) :=
      fun u hu ↦ Submodule.span_induction (fun _ ⟨d, hd, h⟩ ↦ by
        rw [← h, (eL.symm_apply_eq).mpr
          (completionEquivAdicCompletionOfValuationEq_completionEmbedding k' F' w P' hw d).symm]
        exact Submodule.subset_span ⟨d, hd, rfl⟩) (by rw [map_zero]; exact zero_mem _)
        (fun _ _ _ _ hx hy ↦ by rw [map_add]; exact add_mem hx hy) (fun c x _ hx ↦ by
          have hc : (eB.symm c : P'.Completion) = eL.symm (c : w.adicCompletion F') :=
            eL.injective <|
              (completionIntegersRingEquivAdicCompletionIntegersOfValuationEq_apply k' F' w P' hw
                (eB.symm c)).symm.trans <| (congrArg Subtype.val (eB.apply_symm_apply c)).trans
                  (eL.apply_symm_apply _).symm
          have hsmul : eL.symm (c • x) = eB.symm c • eL.symm x := by
            rw [Algebra.smul_def, map_mul, Algebra.smul_def, ValuationSubring.algebraMap_apply,
              ValuationSubring.algebraMap_apply, hc]
          rw [hsmul]; exact Submodule.smul_mem _ (eB.symm c) hx) hu
    simpa only [eL.symm_apply_apply] using hmem (eL z)
      (hspan ▸ (mem_traceDual_completionIntegers_iff_adic P' z).mp hz)
  · rintro _ ⟨d, hd, rfl⟩
    refine (mem_traceDual_completionIntegers_iff_adic P' _).mpr ?_
    rw [completionEquivAdicCompletionOfValuationEq_completionEmbedding k' F' w P' hw d, hspan]
    exact Submodule.subset_span ⟨d, hd, rfl⟩

/-- **Trace duals commute with completion**, as fractional ideals: extending the trace dual of
`𝒪'_P` over `𝒪_P` along `𝒪'_P →+* 𝒪̂_{P'}` yields the trace dual of `𝒪̂_{P'}` over `𝒪̂_P`. -/
theorem extended_dual_one_eq_dual_one_completionIntegers (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) :
    letI := P.completionExtensionAlgebra P' hP
    letI := P.completionIntegersExtensionAlgebra P' hP
    haveI := P.finiteDimensional_completion P' hP
    haveI := P.isSeparable_completion P' hP
    haveI := P.isIntegralClosure_completionIntegers P' hP
    (FractionalIdeal.dual P.integers F
        (1 : FractionalIdeal (integralClosure P.integers F')⁰ F')).extended P'.Completion
        (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
          (P.completionIntegersIntegralClosureHom_injective P' hP)) =
      FractionalIdeal.dual P.completionPlace.integers P.Completion
        (1 : FractionalIdeal P'.completionPlace.integers⁰ P'.Completion) := by
  let _ := P.completionExtensionAlgebra P' hP
  let _ := P.completionIntegersExtensionAlgebra P' hP
  have _ := P.finiteDimensional_completion P' hP
  have _ := P.isSeparable_completion P' hP
  have _ := P.isIntegralClosure_completionIntegers P' hP
  exact TauCeti.extended_dual_one_eq_dual_one_of_span_traceDual_one
    (P'.completionEmbedding : F' →+* P'.Completion)
    (fun y ↦ by
      rw [AlgHom.coe_toRingHom, ValuationSubring.algebraMap_apply,
        coe_completionIntegersIntegralClosureHom, Subalgebra.algebraMap_apply])
    (P.traceDual_one_completionIntegers_eq_span P' hP).symm

/-- **The different ideal commutes with completion.** Extending `differentIdeal 𝒪_P 𝒪'_P` along
`𝒪'_P →+* 𝒪̂_{P'}` yields `differentIdeal 𝒪̂_P 𝒪̂_{P'}` with no separability hypothesis on the
residue extension. -/
theorem map_differentIdeal_eq_differentIdeal_completionIntegers (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) :
    letI := P.completionIntegersExtensionAlgebra P' hP
    (differentIdeal P.integers (integralClosure P.integers F')).map
        (P.completionIntegersIntegralClosureHom P' hP) =
      differentIdeal P.completionPlace.integers P'.completionPlace.integers := by
  let _ := P.completionExtensionAlgebra P' hP
  let _ := P.completionIntegersExtensionAlgebra P' hP
  have _ := P.finiteDimensional_completion P' hP
  have _ := P.isSeparable_completion P' hP
  have _ := P.isIntegralClosure_completionIntegers P' hP
  exact TauCeti.map_differentIdeal_eq_differentIdeal_of_extended_dual_one
    (P.extended_dual_one_eq_dual_one_completionIntegers P' hP)

variable (k' F') in
/-- **The different ideal across the semilocal product above `P`.** Extending
`differentIdeal 𝒪_P 𝒪'_P` diagonally to `∏_{Q' ∣ P} 𝒪̂_{Q'}` yields the product of the completed
different ideals `differentIdeal 𝒪̂_P 𝒪̂_{Q'}`. -/
theorem map_differentIdeal_pi_eq_pi_differentIdeal_completionIntegers (P : Place k F) :
    letI := fun Q' : {Q' : Place k' F' // Q'.restrict k F = P} ↦
      P.completionIntegersExtensionAlgebra Q'.val Q'.property
    (differentIdeal P.integers (integralClosure P.integers F')).map
        (RingHom.pi fun Q' : {Q' : Place k' F' // Q'.restrict k F = P} ↦
          P.completionIntegersIntegralClosureHom Q'.val Q'.property) =
      Ideal.pi fun Q' : {Q' : Place k' F' // Q'.restrict k F = P} ↦
        differentIdeal P.completionPlace.integers Q'.val.completionPlace.integers := by
  let J := {Q' : Place k' F' // Q'.restrict k F = P}
  let _ := fun Q' : J ↦ P.completionIntegersExtensionAlgebra Q'.val Q'.property
  refine Ideal.map_eq_pi_of_map_evalRingHom _ _ _ fun Q' ↦ ?_
  have hcomp : (Pi.evalRingHom (fun i : J ↦ i.val.completionPlace.integers) Q').comp
      (RingHom.pi fun R' : J ↦ P.completionIntegersIntegralClosureHom R'.val R'.property) =
      P.completionIntegersIntegralClosureHom Q'.val Q'.property :=
    RingHom.ext fun x ↦ by rw [RingHom.comp_apply, Pi.evalRingHom_apply, RingHom.pi_apply]
  rw [hcomp, P.map_differentIdeal_eq_differentIdeal_completionIntegers Q'.val Q'.property]

/-- **The completed different ideal as a power of the maximal ideal**: with no hypothesis on the
residue fields, `differentIdeal 𝒪̂_P 𝒪̂_{P'} = 𝔪̂_{P'} ^ d(P' ∣ P)`. -/
theorem differentIdeal_completionIntegers_eq_maximalIdeal_pow (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) :
    letI := P.completionIntegersExtensionAlgebra P' hP
    differentIdeal P.completionPlace.integers P'.completionPlace.integers =
      maximalIdeal P'.completionPlace.integers ^ differentExponent k F P' := by
  subst hP
  open scoped AdicCompletionExtension in
  let _ := (P'.restrict k F).completionExtensionAlgebra P' rfl
  let _ := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
  have := (P'.restrict k F).finiteDimensional_completion P' rfl
  have := (P'.restrict k F).isIntegralClosure_completionIntegers P' rfl
  have := (P'.restrict k F).isSeparable_completion P' rfl
  have := centerIntegralClosure_liesOver_centerBase (k := k) (F := F) P'
  have : Module.Finite (P'.restrict k F).integers
      (integralClosure (P'.restrict k F).integers F') :=
    IsIntegralClosure.finite (P'.restrict k F).integers F F' _
  let v := centerBase (k := k) (F := F) P'; let w := centerIntegralClosure k F P'
  let hv := valuation_eq_centerBase (k := k) (F := F) P'
  let hw := valuation_eq_centerIntegralClosure (k := k) (F := F) P'
  let eB := completionIntegersRingEquivAdicCompletionIntegersOfValuationEq k' F' w P' hw
  have hmax : (maximalIdeal P'.completionPlace.integers).map eB.toRingHom =
      maximalIdeal (w.adicCompletionIntegers F') :=
    IsLocalRing.map_maximalIdeal_of_surjective eB.toRingHom (by simpa using eB.surjective)
  ext x
  rw [RingEquiv.mem_differentIdeal_iff_of_equiv
      (completionIntegersRingEquivAdicCompletionIntegersOfValuationEq k F v _ hv)
      (completionEquivAdicCompletionOfValuationEq k F v _ hv).toAlgEquiv.toRingEquiv eB
      (completionEquivAdicCompletionOfValuationEq k' F' w P' hw).toAlgEquiv.toRingEquiv
      (fun a ↦
        (completionIntegersRingEquivAdicCompletionIntegersOfValuationEq_apply k F v _ hv a).symm)
      (fun b ↦
        (completionIntegersRingEquivAdicCompletionIntegersOfValuationEq_apply k' F' w P' hw b).symm)
      (algebraMap_comp_completionEquivAdicCompletionOfValuationEq v w _ P' rfl hv hw) x,
    v.differentIdeal_adicCompletionIntegers_eq_maximalIdeal_pow (K := F)
      (B := integralClosure (P'.restrict k F).integers F') (L := F') w,
    ← differentExponent_def, ← hmax, ← Ideal.map_pow,
    Ideal.mem_map_iff_of_surjective eB.toRingHom (by simpa using eB.surjective)]
  exact ⟨fun ⟨y, hy, hyx⟩ ↦ eB.injective hyx ▸ hy, fun hx ↦ ⟨x, hx, rfl⟩⟩

/-- **Completion preserves the different exponent**: the multiplicity of `𝔪̂_{P'}` in
`differentIdeal 𝒪̂_P 𝒪̂_{P'}` equals `d(P' ∣ P)` (with arbitrary residue fields). -/
@[simp]
theorem multiplicity_differentIdeal_completionIntegers (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) :
    letI := P.completionIntegersExtensionAlgebra P' hP
    multiplicity (maximalIdeal P'.completionPlace.integers)
        (differentIdeal P.completionPlace.integers P'.completionPlace.integers) =
      differentExponent k F P' := by
  let _ := P.completionIntegersExtensionAlgebra P' hP
  rw [P.differentIdeal_completionIntegers_eq_maximalIdeal_pow P' hP]
  exact multiplicity_pow_self_of_prime
    (Ideal.prime_of_isPrime (IsDiscreteValuationRing.not_a_field _) inferInstance) _

/-- **The valuation criterion for the completed complementary module**: `z ∈ F̂'_{P'}` has
`𝒪̂_P`-integral traces against `𝒪̂_{P'}` if and only if `v_{P̂'}(z) ≤ exp d(P' ∣ P)`. -/
theorem mem_traceDual_completionIntegers_iff_valuation_le (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) {z : P'.Completion} :
    letI := P.completionExtensionAlgebra P' hP
    letI := P.completionIntegersExtensionAlgebra P' hP
    z ∈ Submodule.traceDual P.completionPlace.integers P.Completion
        (1 : Submodule P'.completionPlace.integers P'.Completion) ↔
      P'.completionPlace.valuation z ≤ WithZero.exp (differentExponent k F P' : ℤ) := by
  let _ := P.completionExtensionAlgebra P' hP
  let _ := P.completionIntegersExtensionAlgebra P' hP
  have := P.finiteDimensional_completion P' hP
  have := P.isIntegralClosure_completionIntegers P' hP
  have := P.isSeparable_completion P' hP
  obtain ⟨π, hπ0, hπ⟩ := P'.completionPlace.exists_ne_zero_ord_eq 1
  have hπint : π ∈ P'.completionPlace.integers :=
    P'.completionPlace.mem_integers_iff_ord_nonneg.mpr (by rw [hπ]; norm_num)
  have hδ : differentIdeal P.completionPlace.integers P'.completionPlace.integers =
      Ideal.span {⟨π, hπint⟩ ^ differentExponent k F P'} := by
    rw [P.differentIdeal_completionIntegers_eq_maximalIdeal_pow P' hP,
      (P'.completionPlace.irreducible_of_isUniformizer (t := ⟨π, hπint⟩)
        (P'.completionPlace.isUniformizer_iff_ord_eq_one.mpr hπ)).maximalIdeal_eq,
      Ideal.span_singleton_pow]
  have hvalπ : P'.completionPlace.valuation (π ^ differentExponent k F P') =
      WithZero.exp (-(differentExponent k F P' : ℤ)) := by
    rw [P'.completionPlace.valuation_eq_exp_neg_ord (pow_ne_zero _ hπ0),
      P'.completionPlace.ord_pow, hπ, mul_one]
  rw [mem_traceDual_one_iff_mul_of_differentIdeal_eq_span hδ, ValuationSubring.algebraMap_apply,
    Submodule.mem_one, Subring.coe_pow]
  have hmem1 : (∃ b : P'.completionPlace.integers,
      algebraMap P'.completionPlace.integers P'.Completion b = z * π ^ differentExponent k F P') ↔
      P'.completionPlace.valuation (z * π ^ differentExponent k F P') ≤ 1 :=
    ⟨fun ⟨b, hb⟩ ↦ hb ▸ (P'.completionPlace.mem_integers_iff).mp b.property,
      fun h ↦ ⟨⟨_, (P'.completionPlace.mem_integers_iff).mpr h⟩, rfl⟩⟩
  rw [hmem1, map_mul, hvalπ]
  exact ⟨fun h ↦ by simpa [mul_assoc, ← WithZero.exp_add] using
      mul_le_mul_left h (WithZero.exp (differentExponent k F P' : ℤ)),
    fun h ↦ by simpa [← WithZero.exp_add] using
      mul_le_mul_left h (WithZero.exp (-(differentExponent k F P' : ℤ)))⟩

/-- **Completed complementary-module length formula**: `length 𝒪̂_P (Ĉ_{P'} / 𝒪̂_{P'}) = d · f`. -/
theorem length_traceDual_completionIntegers_quotient (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) :
    letI := P.completionExtensionAlgebra P' hP
    letI := P.completionIntegersExtensionAlgebra P' hP
    Module.length P.completionPlace.integers
        ((Submodule.traceDual P.completionPlace.integers P.Completion
            (1 : Submodule P'.completionPlace.integers P'.Completion)) ⧸
          (1 : Submodule P'.completionPlace.integers P'.Completion).comap
            (Submodule.traceDual P.completionPlace.integers P.Completion
              (1 : Submodule P'.completionPlace.integers P'.Completion)).subtype) =
      (differentExponent k F P' : ℕ∞) * relativeDegree k F P' := by
  subst hP
  let _ := (P'.restrict k F).completionExtensionAlgebra P' rfl
  let _ := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
  have := (P'.restrict k F).finiteDimensional_completion P' rfl
  have := (P'.restrict k F).isIntegralClosure_completionIntegers P' rfl
  have := (P'.restrict k F).isSeparable_completion P' rfl
  have : Module.Finite (P'.restrict k F).completionPlace.ResidueField
      P'.completionPlace.ResidueField :=
    .of_equiv_equiv (P'.restrict k F).residueFieldEquivCompletion.toRingEquiv
      P'.residueFieldEquivCompletion.toRingEquiv
      (P'.algebraMap_comp_residueFieldEquivCompletion (k := k) (F := F))
  rw [length_traceDual_quotient_eq_multiplicity_mul_finrank,
    multiplicity_differentIdeal_completionIntegers (P'.restrict k F) P' rfl,
    P'.finrank_residueField_completion (k := k) (F := F)]

/-- When `𝒪_{P'}` is the integral closure of `𝒪_P`, completion preserves the length of `C / 𝒪`. -/
theorem length_traceDual_completionIntegers_quotient_eq (P' : Place k' F')
    [IsIntegralClosure P'.integers (P'.restrict k F).integers F'] :
    letI := (P'.restrict k F).completionExtensionAlgebra P' rfl
    letI := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
    Module.length (P'.restrict k F).completionPlace.integers
        ((Submodule.traceDual (P'.restrict k F).completionPlace.integers
            (P'.restrict k F).Completion
            (1 : Submodule P'.completionPlace.integers P'.Completion)) ⧸
          (1 : Submodule P'.completionPlace.integers P'.Completion).comap
            (Submodule.traceDual (P'.restrict k F).completionPlace.integers
              (P'.restrict k F).Completion
              (1 : Submodule P'.completionPlace.integers P'.Completion)).subtype) =
      Module.length (P'.restrict k F).integers
        ((Submodule.traceDual (P'.restrict k F).integers F (1 : Submodule P'.integers F')) ⧸
          (1 : Submodule P'.integers F').comap
            (Submodule.traceDual (P'.restrict k F).integers F
              (1 : Submodule P'.integers F')).subtype) := by
  let _ := (P'.restrict k F).completionExtensionAlgebra P' rfl
  let _ := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
  have := isTorsionFree_integers (k := k) (F := F) P'
  have hC : ∀ c : P'.integers, algebraMap P'.integers F' c ∈ P'.integers := fun c ↦ c.property
  rw [(P'.restrict k F).length_traceDual_completionIntegers_quotient P' rfl,
    length_traceDual_quotient_eq_multiplicity_mul_finrank,
    differentExponent_eq_multiplicity_center (B := (P'.restrict k F).integers) (C := P'.integers)
      P' hC, P'.center_integers_asIdeal hC, relativeDegree_def]

/-- **Completed discriminant valuation formula**: `Ring.ord 𝒪̂_P (discr 𝒪̂_P b) = d · f`. -/
theorem ord_discr_completionIntegers (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) {ι : Type*} [Fintype ι] [DecidableEq ι] :
    letI := P.completionIntegersExtensionAlgebra P' hP
    ∀ b : Module.Basis ι P.completionPlace.integers P'.completionPlace.integers,
      Ring.ord P.completionPlace.integers (Algebra.discr P.completionPlace.integers b) =
        (differentExponent k F P' : ℕ∞) * relativeDegree k F P' := by
  subst hP
  let _ := (P'.restrict k F).completionExtensionAlgebra P' rfl
  let _ := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
  have := (P'.restrict k F).isIntegralClosure_completionIntegers P' rfl
  have := (P'.restrict k F).isSeparable_completion P' rfl
  intro b
  rw [ord_discr_eq_multiplicity_mul_finrank (P'.restrict k F).Completion P'.Completion b,
    multiplicity_differentIdeal_completionIntegers (P'.restrict k F) P' rfl,
    P'.finrank_residueField_completion (k := k) (F := F)]

omit [FiniteDimensional F F'] in
/-- When `𝒪_{P'}` is the integral closure of `𝒪_P`, completion preserves the discriminant ord. -/
theorem ord_discr_completionIntegers_eq (P' : Place k' F')
    [IsIntegralClosure P'.integers (P'.restrict k F).integers F']
    {ι ι' : Type*} [Fintype ι] [DecidableEq ι] [Fintype ι'] [DecidableEq ι']
    (b : Module.Basis ι (P'.restrict k F).integers P'.integers) :
    letI := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
    ∀ b' : Module.Basis ι' (P'.restrict k F).completionPlace.integers P'.completionPlace.integers,
      Ring.ord (P'.restrict k F).completionPlace.integers
          (Algebra.discr (P'.restrict k F).completionPlace.integers b') =
        Ring.ord (P'.restrict k F).integers (Algebra.discr (P'.restrict k F).integers b) := by
  let _ := (P'.restrict k F).completionIntegersExtensionAlgebra P' rfl
  have : Module.Finite (P'.restrict k F).integers P'.integers := .of_basis b
  have := IsIntegralClosure.isLocalization (P'.restrict k F).integers F F' P'.integers
  have : FiniteDimensional F F' :=
    .of_basis (b.localizationLocalization F (P'.restrict k F).integers⁰ F')
  have := isTorsionFree_integers (k := k) (F := F) P'
  have hC : ∀ c : P'.integers, algebraMap P'.integers F' c ∈ P'.integers := fun c ↦ c.property
  intro b'
  rw [(P'.restrict k F).ord_discr_completionIntegers P' rfl b',
    ord_discr_eq_multiplicity_mul_finrank F F' b,
    differentExponent_eq_multiplicity_center (B := (P'.restrict k F).integers) (C := P'.integers)
      P' hC, P'.center_integers_asIdeal hC, relativeDegree_def]

/-- **The length of `𝒪̂_{P'} / 𝔡(𝒪̂_{P'} / 𝒪̂_P)` over `𝒪̂_P` is `d(P' ∣ P) · f(P' ∣ P)`**, with
`f(P' ∣ P)` the full relative residue degree, including its inseparable factor. -/
theorem length_quotient_differentIdeal_completionIntegers (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) :
    letI := P.completionIntegersExtensionAlgebra P' hP
    Module.length P.completionPlace.integers
        (P'.completionPlace.integers ⧸
          differentIdeal P.completionPlace.integers P'.completionPlace.integers) =
      (differentExponent k F P' : ℕ∞) * relativeDegree k F P' := by
  let _ := P.completionExtensionAlgebra P' hP
  let _ := P.completionIntegersExtensionAlgebra P' hP
  have _ := P.finiteDimensional_completion P' hP
  have _ := P.isSeparable_completion P' hP
  have _ := P.isIntegralClosure_completionIntegers P' hP
  rw [← TauCeti.length_traceDual_quotient_eq_length_quotient_differentIdeal
      (K := P.Completion) (L := P'.Completion),
    P.length_traceDual_completionIntegers_quotient P' hP]

/-- **The completed discriminant valuation formula (`Place.ord` form)**: for any `𝒪̂_P`-basis `b`
of `𝒪̂_{P'}`, `ord_{P̂} (discr 𝒪̂_P b) = d(P' ∣ P) · f(P' ∣ P)`, with `f(P' ∣ P)` the full
relative residue degree, including its inseparable factor. -/
theorem completionPlace_ord_discr_completionIntegers (P : Place k F) (P' : Place k' F')
    (hP : P'.restrict k F = P) {ι : Type*} [Fintype ι] [DecidableEq ι] :
    letI := P.completionIntegersExtensionAlgebra P' hP
    ∀ b : Module.Basis ι P.completionPlace.integers P'.completionPlace.integers,
      P.completionPlace.ord (Algebra.discr P.completionPlace.integers b : P.Completion) =
        differentExponent k F P' * relativeDegree k F P' := by
  let _ := P.completionIntegersExtensionAlgebra P' hP
  intro b
  have hord := P.ord_discr_completionIntegers P' hP b
  set d := Algebra.discr P.completionPlace.integers b
  have hd0 : d ≠ 0 := by
    intro h
    rw [h, Ring.ord_eq_addVal, AddValuation.map_zero, ← Nat.cast_mul] at hord
    exact ENat.top_ne_natCast _ hord
  rw [Ring.ord_eq_addVal, P.completionPlace.addVal_integers hd0, ← Nat.cast_mul,
    Nat.cast_inj] at hord
  rw [← Int.toNat_of_nonneg (P.completionPlace.mem_integers_iff_ord_nonneg.mp d.property), hord,
    Nat.cast_mul]

section AffineModel

variable {B C : Type*} [CommRing B] [IsDedekindDomain B] [Algebra B F] [IsFractionRing B F]
  [CommRing C] [Algebra C F'] [Algebra B C] [Algebra B F']
  [IsScalarTower B C F'] [IsScalarTower B F F'] [IsIntegralClosure C B F']

/-- **The completed complementary module is spanned by the complementary module of an affine
model**: if `B` is a Dedekind affine model of `F`, `C` is its integral closure in `F'`, and `P'`
is finite on `C`, then `Submodule.traceDual 𝒪̂_P F̂_P 1` is the `𝒪̂_{P'}`-span of the image of
`Submodule.traceDual B F 1` in `F̂'_{P'}`. -/
theorem span_traceDual_one_eq_traceDual_one_completionIntegers_of_forall_mem_integers
    (P : Place k F) (P' : Place k' F') (hP : P'.restrict k F = P)
    (hC : ∀ c : C, algebraMap C F' c ∈ P'.integers) :
    letI := P.completionExtensionAlgebra P' hP
    letI := P.completionIntegersExtensionAlgebra P' hP
    Submodule.span P'.completionPlace.integers
        (P'.completionEmbedding '' (Submodule.traceDual B F (1 : Submodule C F') : Set F')) =
      Submodule.traceDual P.completionPlace.integers P.Completion
        (1 : Submodule P'.completionPlace.integers P'.Completion) := by
  let _ := P.completionExtensionAlgebra P' hP
  let _ := P.completionIntegersExtensionAlgebra P' hP
  have hB : ∀ b : B, algebraMap B F b ∈ P.integers :=
    hP ▸ algebraMap_mem_integers_restrict k F P' hC
  have hloc := P.span_traceDual_one_eq_traceDual_one_integralClosure (F' := F') (C := C) hB
  rw [P.traceDual_one_completionIntegers_eq_span P' hP, ← hloc]
  refine le_antisymm (Submodule.span_le.mpr ?_) (Submodule.span_le.mpr ?_)
  · rintro _ ⟨x, hx, rfl⟩
    exact Submodule.subset_span ⟨x, Submodule.subset_span hx, rfl⟩
  · rintro _ ⟨x, hx, rfl⟩
    exact Submodule.map_mem_span_of_forall_exists (P'.completionEmbedding : F' →+* P'.Completion)
      _ _ (fun s ↦ ⟨P.completionIntegersIntegralClosureHom P' hP s, by
        rw [AlgHom.coe_toRingHom, ValuationSubring.algebraMap_apply,
          coe_completionIntegersIntegralClosureHom, Subalgebra.algebraMap_apply]⟩)
      (fun y hy ↦ Submodule.subset_span (Set.mem_image_of_mem _ hy)) hx

/-- **The different ideal of an affine model generates the completed different ideal**: if `B` is
a Dedekind affine model of `F`, `C` is its integral closure in `F'`, and `P'` is finite on `C`,
then extending `differentIdeal B C` along `C →+* 𝒪̂_{P'}` yields
`differentIdeal 𝒪̂_P 𝒪̂_{P'}`. -/
theorem map_differentIdeal_eq_differentIdeal_completionIntegers_of_forall_mem_integers
    [IsDedekindDomain C] [Module.IsTorsionFree B C]
    (P : Place k F) (P' : Place k' F') (hP : P'.restrict k F = P)
    (hC : ∀ c : C, algebraMap C F' c ∈ P'.integers) :
    letI := P.completionIntegersExtensionAlgebra P' hP
    (differentIdeal B C).map
        (P'.completionIntegersEmbedding.toRingHom.comp
          ((algebraMap C F').codRestrict P'.integers hC)) =
      differentIdeal P.completionPlace.integers P'.completionPlace.integers := by
  let _ := P.completionIntegersExtensionAlgebra P' hP
  have hB : ∀ b : B, algebraMap B F b ∈ P.integers :=
    hP ▸ algebraMap_mem_integers_restrict k F P' hC
  have hcomp : P'.completionIntegersEmbedding.toRingHom.comp
      ((algebraMap C F').codRestrict P'.integers hC) =
      (P.completionIntegersIntegralClosureHom P' hP).comp (integralClosureHom P hB) := by
    ext c
    simp
  rw [hcomp, ← Ideal.map_map,
    P.map_differentIdeal_eq_differentIdeal_integralClosure hB (integralClosureHom P hB)
      (fun c ↦ by rw [Subalgebra.algebraMap_apply, coe_integralClosureHom]),
    P.map_differentIdeal_eq_differentIdeal_completionIntegers P' hP]

end AffineModel

