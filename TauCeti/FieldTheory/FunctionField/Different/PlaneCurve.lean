import TauCeti.RingTheory.RegularLocalRing.Hypersurface

/-!
# The different of a smooth affine plane curve over `k(x)`

Let `g ∈ k[X, Y]` be an irreducible polynomial whose affine curve `g = 0` is smooth, in the
ideal-theoretic sense that `g`, `∂g/∂X` and `∂g/∂Y` generate the unit ideal, and which is monic as
a polynomial in `Y` over `k[X]`. Let `F` be a finite separable extension of `k(x)` generated by an
element `y` with `g(x, y) = 0`. This file computes the different exponents of `F / k(x)` at the
places of `F` at which `x` is regular, the places over the finite places of `k(x)`:

`d(P ∣ P ∩ k(x)) = ord_P (∂g/∂Y (x, y))`.

So a place over a finite place of `k(x)` ramifies exactly where `∂g/∂Y` vanishes on the curve.

The proof identifies the coordinate ring. Since `g` is monic in `Y`, `y` is integral over
`k[x]` with minimal polynomial `g(x, Y)`, so `k[x][y] ≅ k[X, Y] ⧸ (g)`. The smoothness
hypothesis makes this ring a Dedekind domain
(`MvPolynomial.isIntegrallyClosed_adjoin_singleton`), in particular integrally closed, and
its fraction field is `F`. Hence `k[x][y]` is the integral closure of `k[x]` in `F`, generated by
`y`, and its different ideal is generated by `∂g/∂Y (x, y)`
(`TauCeti.Place.differentExponent_eq_ord_aeval_derivative_minpoly_of_isIntegralClosure`).

The places at which `x` has a pole are not covered: they have no centre on `k[x][y]`, and the
statement says nothing about them.

## Main results

* `TauCeti.Place.differentExponent_eq_ord_aeval_pderiv_one`: at a place at which `x` is regular,
  the different exponent of `F / k(x)` is the order of `∂g/∂Y (x, y)`.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Theorem 3.5.10.
* W. Fulton, *Algebraic Curves*, Section 3.2, for the local rings of a smooth plane curve.
-/

public section

open Polynomial

open scoped IntermediateField

namespace TauCeti

namespace Place

variable {k F : Type*} [Field k] [Field F] [Algebra k F] [Algebra (RatFunc k) F]
  [IsScalarTower k (RatFunc k) F] [FiniteDimensional (RatFunc k) F]
  [Algebra.IsSeparable (RatFunc k) F]

/-- **The different of a smooth affine plane curve at the finite places**: let `g ∈ k[X, Y]` be
irreducible, monic in `Y` over `k[X]`, with `g`, `∂g/∂X` and `∂g/∂Y` generating the unit ideal,
and let `F / k(x)` be generated by `y` with `g(x, y) = 0`. At every place `P` of `F` at which `x`
is regular, the different exponent of `F / k(x)` is `ord_P (∂g/∂Y (x, y))`. -/
theorem differentExponent_eq_ord_aeval_pderiv_one {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g)
    (hsm : Ideal.span {g, MvPolynomial.pderiv 0 g, MvPolynomial.pderiv 1 g} = ⊤)
    (hmon : ((Bivariate.equivMvPolynomial k).symm g).Monic) {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) (P : Place k F)
    (hx : algebraMap (RatFunc k) F RatFunc.X ∈ P.integers) :
    (differentExponent k (RatFunc k) P : ℤ) =
      P.ord (MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y]
        (MvPolynomial.pderiv 1 g)) := by
  -- View `F` as a `k[X]`-algebra through `k(x)`.
  let _ : Algebra k[X] F :=
    ((algebraMap (RatFunc k) F).comp (algebraMap k[X] (RatFunc k))).toAlgebra
  have : IsScalarTower k[X] (RatFunc k) F := .of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower k k[X] F := .of_algebraMap_eq fun c ↦ by
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply,
      ← IsScalarTower.algebraMap_apply k k[X] (RatFunc k),
      ← IsScalarTower.algebraMap_apply k (RatFunc k) F]
  have : FaithfulSMul k[X] F := (faithfulSMul_iff_algebraMap_injective _ _).mpr <| by
    rw [IsScalarTower.algebraMap_eq k[X] (RatFunc k) F]
    exact (algebraMap (RatFunc k) F).injective.comp (IsFractionRing.injective _ _)
  have hxX : algebraMap (RatFunc k) F RatFunc.X = algebraMap k[X] F X := by
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, RatFunc.algebraMap_X]
  -- `f = g(X, Y)`, read in `k[X][Y]`, is the minimal polynomial of `y` over `k[x]`.
  set f := (Bivariate.equivMvPolynomial k).symm g
  have hgf : Bivariate.equivMvPolynomial k f = g := by simp [f]
  have hyf : aeval y f = 0 := by rw [← Bivariate.aeval_equivMvPolynomial, ← hxX, hgf, hy]
  have hint : IsIntegral k[X] y := ⟨f, hmon, hyf⟩
  have hmin : minpoly k[X] y = f :=
    eq_of_monic_of_associated (minpoly.monic hint) hmon <|
      (minpoly.irreducible hint).associated_of_dvd
        ((MulEquiv.irreducible_iff (Bivariate.equivMvPolynomial k).symm).mpr hirr)
        (minpoly.isIntegrallyClosed_dvd hint hyf)
  -- Hence `C = k[x][y]` is the integral closure of `k[x]` in its fraction field `F`, generated
  -- by `y`.
  set C := Algebra.adjoin k[X] {y}
  have : IsIntegrallyClosed C :=
    MvPolynomial.isIntegrallyClosed_adjoin_singleton hint (hmin ▸ hgf) hsm
  have : IsFractionRing C F := IntermediateField.isFractionRing_algebra_adjoin_of_adjoin_eq_top
    hgen
  have : Algebra.IsIntegral k[X] C := Algebra.IsIntegral.adjoin (by simpa using hint)
  have : IsDedekindDomain C := IsIntegralClosure.isDedekindDomain k[X] (RatFunc k) F C
  have hgenC : Algebra.adjoin k[X] {(⟨y, Algebra.self_mem_adjoin_singleton k[X] y⟩ : C)} = ⊤ :=
    Subalgebra.map_injective (f := C.val) Subtype.val_injective <| by
      rw [← Algebra.adjoin_image, Set.image_singleton, Algebra.map_top, Subalgebra.range_val]
      rfl
  -- `P` is finite on `C`, since `x` is regular at `P` and `C` is integral over `k[x]`.
  have hR : ∀ r : k[X], algebraMap k[X] F r ∈ P.integers := fun r ↦ by
    induction r using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | monomial n c =>
      rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, ← hxX, ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply]
      exact mul_mem (P.algebraMap_mem_integers c) (pow_mem hx n)
  have hC : ∀ c : C, algebraMap C F c ∈ P.integers := fun c ↦
    P.mem_integers_of_isIntegral hR (Algebra.IsIntegral.isIntegral c).algebraMap
  rw [differentExponent_eq_ord_aeval_derivative_minpoly_of_isIntegralClosure k (RatFunc k)
      (B := k[X]) P hC hgenC, Subalgebra.algebraMap_apply, Subtype.coe_mk,
    minpoly.isIntegrallyClosed_eq_field_fractions' (RatFunc k) hint, hmin, derivative_map,
    aeval_map_algebraMap, ← Bivariate.aeval_equivMvPolynomial,
    ← Bivariate.pderiv_one_equivMvPolynomial, hgf, hxX]

end Place

end TauCeti
