/-!
# The different of a smooth plane curve

Let `g ∈ k[X, Y]` be a polynomial whose affine curve `g = 0` is smooth, in the ideal-theoretic
sense that `g`, `∂g/∂X` and `∂g/∂Y` generate the unit ideal, and which is monic as a polynomial in
`Y` over `k[X]`. Let `K = k(t)` be a rational function field and `F` a finite separable extension
of `K` generated by an element `y` with `g(t, y) = 0`, where `g` has degree `[F : K]` in `Y`. This
file first computes the different exponents of `F / K` at the places of `F` at which `t` is
regular:

`d(P ∣ P ∩ K) = ord_P (∂g/∂Y (t, y))`.

So such a place ramifies exactly where `∂g/∂Y` vanishes on the curve.

The proof identifies the coordinate ring. Since `g` is monic in `Y`, `y` is integral over
`k[t]`, and comparing degrees shows that its minimal polynomial is `g(t, Y)`, so
`k[t][y] ≅ k[X, Y] ⧸ (g)`. The smoothness hypothesis makes this ring a Dedekind domain
(`MvPolynomial.isIntegrallyClosed_adjoin_singleton`), in particular integrally closed, and its
fraction field is `F`. Hence `k[t][y]` is the integral closure of `k[t]` in `F`, generated by `y`,
and its different ideal is generated by `∂g/∂Y (t, y)`
(`TauCeti.Place.differentExponent_eq_ord_aeval_derivative_minpoly_of_isIntegralClosure`).

## The whole curve

Now take `K = k(x)` and let `g` be irreducible of total degree `n`, with the coefficient of `Yⁿ`
equal to `1`.
Then the projective closure of `g = 0` does not pass through `(0 : 1 : 0)`, `[F : k(x)] = n`, and
the places of `F` at which `x` has a pole are the points at infinity, which lie in the affine
chart with coordinates `u = 1 / x` and `v = y / x` and equation
`h = MvPolynomial.inftyChart n g = uⁿ g(1 / u, v / u)`. The field `k(u)` is `k(x)`, so if this
chart is smooth as well, the first computation for `t = u` gives the different exponents above
infinity. Since `∂h/∂v (u, v) = u^(n - 1) ∂g/∂Y (x, y)`, both charts are covered by the single
divisor identity

`Diff(F / k(x)) = div (∂g/∂Y (x, y)) + (n - 1) (x)_∞`.

The principal divisor has degree zero and the pole divisor of `x` has degree `[F : k(x)] = n`, so
`deg Diff(F / k(x)) = n (n - 1)`. The genus `(n - 1)(n - 2) / 2` of a smooth plane curve of degree
`n` follows from this by the Hurwitz genus formula, in
`TauCeti.FieldTheory.FunctionField.PlaneCurve.Genus`.

## Main results

* `TauCeti.Place.mem_integers_of_aeval_eq_zero`: a root `b` of `φ(a, Y)`, for `φ` monic in `Y`, is
  regular wherever `a` is.
* `TauCeti.Place.differentExponent_eq_ord_aeval_pderiv_one`: at a place at which `t` is regular,
  the different exponent of `F / k(t)` is the order of `∂g/∂Y (t, y)`.
* `TauCeti.minpoly_ratFunc_eq_map_of_aeval_eq_zero` and
  `TauCeti.finrank_ratFunc_eq_natDegree_of_aeval_eq_zero`: for irreducible `g`, the minimal
  polynomial of `y` over `k(x)` is `g(x, Y)`, so `[F : k(x)]` is the degree of `g` in `Y`.
* `TauCeti.finrank_ratFunc_eq_totalDegree_of_aeval_eq_zero`: if moreover the coefficient of `Yⁿ`
  in `g` is `1`, where `n` is the total degree of `g`, then `[F : k(x)] = n`.
* `TauCeti.Place.differentExponent_eq_ord_aeval_pderiv_one_sub_mul_ord`: at a place at which
  `x` has no zero, `d(P ∣ P ∩ k(x)) = ord_P (∂g/∂Y (x, y)) - (n - 1) ord_P x`.
* `TauCeti.Divisor.different_eq_principal_add_zsmul_poles`:
  `Diff(F / k(x)) = div (∂g/∂Y (x, y)) + (n - 1) (x)_∞`.
* `TauCeti.Divisor.degree_different_eq_totalDegree_mul`: `deg Diff(F / k(x)) = n (n - 1)`.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Theorem 3.5.10.
* W. Fulton, *Algebraic Curves*, Section 3.2, for the local rings of a smooth plane curve.
-/

public section

open Polynomial

open scoped IntermediateField

namespace TauCeti

namespace Place

section Integral

variable {k F : Type*} [Field k] [Field F] [Algebra k F]

/-- **A root of a polynomial monic in `Y` is regular wherever its first coordinate is**: if
`φ ∈ k[X, Y]` is monic as a polynomial in `Y` over `k[X]`, `φ(a, b) = 0`, and `a` is regular at the
place `P`, then so is `b`, which is integral over `k[a]`. -/
theorem mem_integers_of_aeval_eq_zero (P : Place k F) {φ : MvPolynomial (Fin 2) k}
    (hmon : ((Bivariate.equivMvPolynomial k).symm φ).Monic) {a b : F}
    (hab : MvPolynomial.aeval ![a, b] φ = 0) (ha : a ∈ P.integers) : b ∈ P.integers := by
  -- View `k[a]` as a `k[X]`-algebra through `X ↦ a`; the monic equation makes `b` integral over it.
  let A := Algebra.adjoin k ({a} : Set F)
  let _ : Algebra k[X] A := (aeval (⟨a, Algebra.self_mem_adjoin_singleton k a⟩ : A)).toAlgebra
  have : IsScalarTower k k[X] A := .of_algebraMap_eq fun c ↦ by
    simp [RingHom.algebraMap_toAlgebra]
  refine P.mem_integers_of_isIntegral_adjoin ha ⟨_, hmon.map (algebraMap k[X] A), ?_⟩
  rw [← aeval_def, Bivariate.aeval_map_eq_aeval_equivMvPolynomial, AlgEquiv.apply_symm_apply]
  simpa [RingHom.algebraMap_toAlgebra] using hab

end Integral

section Rational

variable {k K F : Type*} [Field k] [Field K] [Field F] [Algebra k K] [Algebra k F] [Algebra K F]
  [IsScalarTower k K F] [FiniteDimensional K F] [Algebra.IsSeparable K F]

/-- **The different of a smooth affine plane curve over a rational function field**: let
`K = k(t)` with `t` transcendental over `k`, let `g ∈ k[X, Y]` be monic in `Y` over `k[X]` of
degree `[F : K]`, with `g`, `∂g/∂X` and `∂g/∂Y` generating the unit ideal, and let `F / K` be
generated by `y` with `g(t, y) = 0`. At every place `P` of `F` at which `t` is regular, the
different exponent of `F / K` is `ord_P (∂g/∂Y (t, y))`. -/
theorem differentExponent_eq_ord_aeval_pderiv_one {t : K} (ht : Transcendental k t)
    (htop : k⟮t⟯ = ⊤) {g : MvPolynomial (Fin 2) k}
    (hsm : Ideal.span {g, MvPolynomial.pderiv 0 g, MvPolynomial.pderiv 1 g} = ⊤)
    (hmon : ((Bivariate.equivMvPolynomial k).symm g).Monic)
    (hdeg : ((Bivariate.equivMvPolynomial k).symm g).natDegree = Module.finrank K F)
    {y : F} (hgen : K⟮y⟯ = ⊤) (hy : MvPolynomial.aeval ![algebraMap K F t, y] g = 0)
    (P : Place k F) (htP : algebraMap K F t ∈ P.integers) :
    (differentExponent k K P : ℤ) =
      P.ord (MvPolynomial.aeval ![algebraMap K F t, y] (MvPolynomial.pderiv 1 g)) := by
  -- View `K = k(t)` as the fraction field of `k[X]` through `X ↦ t`, and `F` as a `k[X]`-algebra
  -- through `K`.
  let _ : Algebra k[X] K := (aeval t).toAlgebra
  let _ : Algebra k[X] F := ((algebraMap K F).comp (algebraMap k[X] K)).toAlgebra
  have : IsScalarTower k[X] K F := .of_algebraMap_eq fun _ ↦ rfl
  have : IsFractionRing k[X] K := by
    let e : RatFunc k ≃ₐ[k] K := (RatFunc.algEquivOfTranscendental t ht).trans
      ((IntermediateField.equivOfEq htop).trans IntermediateField.topEquiv)
    refine IsLocalization.isLocalization_of_algEquiv _ { e with commutes' := fun p ↦ ?_ }
    simp [e, RingHom.algebraMap_toAlgebra]
  have : IsScalarTower k k[X] K := .of_algebraMap_eq fun c ↦ by
    simp [RingHom.algebraMap_toAlgebra]
  have : IsScalarTower k k[X] F := .of_algebraMap_eq fun c ↦ by
    rw [IsScalarTower.algebraMap_apply k[X] K F, ← IsScalarTower.algebraMap_apply k k[X] K,
      ← IsScalarTower.algebraMap_apply k K F]
  have : FaithfulSMul k[X] F := (faithfulSMul_iff_algebraMap_injective _ _).mpr <| by
    rw [IsScalarTower.algebraMap_eq k[X] K F]
    exact (algebraMap K F).injective.comp (IsFractionRing.injective _ _)
  have htX : algebraMap K F t = algebraMap k[X] F X := by
    rw [IsScalarTower.algebraMap_apply k[X] K F]
    exact congrArg _ (aeval_X t).symm
  -- `f = g(X, Y)`, read in `k[X][Y]`, is the minimal polynomial of `y` over `k[t]`: it is a
  -- monic multiple of that minimal polynomial, of the same degree `[F : K]`.
  set f := (Bivariate.equivMvPolynomial k).symm g
  have hgf : Bivariate.equivMvPolynomial k f = g := by simp [f]
  have hyf : aeval y f = 0 := by rw [← Bivariate.aeval_equivMvPolynomial, ← htX, hgf, hy]
  have hint : IsIntegral k[X] y := ⟨f, hmon, hyf⟩
  have hmin : minpoly k[X] y = f := by
    refine (eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint) hmon
      (minpoly.isIntegrallyClosed_dvd hint hyf) ?_).symm
    rw [hdeg, ← IntermediateField.finrank_top' (F := K) (E := F), ← hgen,
      IntermediateField.adjoin.finrank (Algebra.IsIntegral.isIntegral (R := K) y),
      minpoly.isIntegrallyClosed_eq_field_fractions' K hint, (minpoly.monic hint).natDegree_map]
  -- Hence `C = k[t][y]` is the integral closure of `k[t]` in its fraction field `F`, generated
  -- by `y`.
  set C := Algebra.adjoin k[X] {y}
  have : IsIntegrallyClosed C :=
    MvPolynomial.isIntegrallyClosed_adjoin_singleton hint (hmin ▸ hgf) hsm
  have : IsFractionRing C F := IntermediateField.isFractionRing_algebra_adjoin_of_adjoin_eq_top
    hgen
  have : Algebra.IsIntegral k[X] C := Algebra.IsIntegral.adjoin (by simpa using hint)
  have : IsDedekindDomain C := IsIntegralClosure.isDedekindDomain k[X] K F C
  have hgenC : Algebra.adjoin k[X] {(⟨y, Algebra.self_mem_adjoin_singleton k[X] y⟩ : C)} = ⊤ :=
    Subalgebra.map_injective (f := C.val) Subtype.val_injective <| by
      rw [← Algebra.adjoin_image, Set.image_singleton, Algebra.map_top, Subalgebra.range_val]
      rfl
  -- `P` is finite on `C`, since `t` is regular at `P` and `C` is integral over `k[t]`.
  have hR : ∀ r : k[X], algebraMap k[X] F r ∈ P.integers := fun r ↦ by
    induction r using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | monomial n c =>
      rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, ← htX, ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply]
      exact mul_mem (P.algebraMap_mem_integers c) (pow_mem htP n)
  have hC : ∀ c : C, algebraMap C F c ∈ P.integers := fun c ↦
    P.mem_integers_of_isIntegral hR (Algebra.IsIntegral.isIntegral c).algebraMap
  rw [differentExponent_eq_ord_aeval_derivative_minpoly_of_isIntegralClosure k K
      (B := k[X]) P hC hgenC, Subalgebra.algebraMap_apply, Subtype.coe_mk,
    minpoly.isIntegrallyClosed_eq_field_fractions' K hint, hmin, derivative_map,
    aeval_map_algebraMap, ← Bivariate.aeval_equivMvPolynomial,
    ← Bivariate.pderiv_one_equivMvPolynomial, hgf, htX]

end Rational

end Place

/-! ### The whole plane curve over `k(x)` -/

section PlaneCurve

variable {k F : Type*} [Field k] [Field F] [Algebra k F] [Algebra (RatFunc k) F]
  [IsScalarTower k (RatFunc k) F]

/-- **The minimal polynomial of a point of a plane curve over `k(x)`**: an irreducible
`g ∈ k[X, Y]`, monic in `Y` over `k[X]`, with `g(x, y) = 0`, read as a polynomial in `Y` over
`k(x)`, is the minimal polynomial of `y`. -/
theorem minpoly_ratFunc_eq_map_of_aeval_eq_zero {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g) (hmon : ((Bivariate.equivMvPolynomial k).symm g).Monic) {y : F}
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    minpoly (RatFunc k) y =
      ((Bivariate.equivMvPolynomial k).symm g).map (algebraMap k[X] (RatFunc k)) := by
  have hfirr : Irreducible ((Bivariate.equivMvPolynomial k).symm g) :=
    (MulEquiv.irreducible_iff (Bivariate.equivMvPolynomial k)).mp (by simpa using hirr)
  refine (minpoly.eq_of_irreducible_of_monic
    ((hmon.irreducible_iff_irreducible_map_fraction_map).mp hfirr) ?_ (hmon.map _)).symm
  rw [Bivariate.aeval_map_eq_aeval_equivMvPolynomial, RatFunc.algebraMap_X,
    AlgEquiv.apply_symm_apply, hy]

/-- **The degree of a plane curve over `k(x)`**: if `F / k(x)` is generated by `y` with
`g(x, y) = 0`, where `g ∈ k[X, Y]` is irreducible and monic in `Y` over `k[X]`, then `[F : k(x)]`
is the degree of `g` in `Y`. -/
theorem finrank_ratFunc_eq_natDegree_of_aeval_eq_zero {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g)
    (hmon : ((Bivariate.equivMvPolynomial k).symm g).Monic) {y : F}
    (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    Module.finrank (RatFunc k) F = ((Bivariate.equivMvPolynomial k).symm g).natDegree := by
  have hint : IsIntegral (RatFunc k) y := by
    refine ⟨_, hmon.map (algebraMap k[X] (RatFunc k)), ?_⟩
    rw [← aeval_def, ← minpoly_ratFunc_eq_map_of_aeval_eq_zero hirr hmon hy, minpoly.aeval]
  rw [← IntermediateField.finrank_top', ← hgen, IntermediateField.adjoin.finrank hint,
    minpoly_ratFunc_eq_map_of_aeval_eq_zero hirr hmon hy, hmon.natDegree_map]

/-- **The degree of a plane curve of degree `n` over `k(x)`**: if `F / k(x)` is generated by `y`
with `g(x, y) = 0`, where `g ∈ k[X, Y]` is irreducible of total degree `n` with the coefficient of
`Yⁿ` equal to `1`, then `[F : k(x)] = n`. -/
theorem finrank_ratFunc_eq_totalDegree_of_aeval_eq_zero {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g) (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1) {y : F}
    (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    Module.finrank (RatFunc k) F = g.totalDegree := by
  rw [finrank_ratFunc_eq_natDegree_of_aeval_eq_zero hirr
      (Bivariate.monic_equivMvPolynomial_symm le_rfl hlead) hgen hy,
    Bivariate.natDegree_equivMvPolynomial_symm le_rfl hlead]

/-- **The monomials of degree less than `n` in the coordinates of a plane curve are
independent**: let `g ∈ k[X, Y]` be irreducible of total degree `n`, with the coefficient of `Yⁿ`
equal to `1`, and let `g(x, y) = 0`. Then the products `x ^ i y ^ j` with `i + j < n` are linearly
independent over `k`, since `y` has degree `n` over `k(x)`. -/
theorem linearIndepOn_pow_mul_pow_of_aeval_eq_zero {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g) (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1) {y : F}
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    LinearIndepOn k (fun p : ℕ × ℕ ↦ algebraMap (RatFunc k) F RatFunc.X ^ p.1 * y ^ p.2)
      {p | p.1 + p.2 < g.totalDegree} := by
  have hdeg : (minpoly (RatFunc k) y).natDegree = g.totalDegree := by
    rw [minpoly_ratFunc_eq_map_of_aeval_eq_zero hirr
        (Bivariate.monic_equivMvPolynomial_symm le_rfl hlead) hy,
      (Bivariate.monic_equivMvPolynomial_symm le_rfl hlead).natDegree_map,
      Bivariate.natDegree_equivMvPolynomial_symm le_rfl hlead]
  refine (RatFunc.transcendental_X.linearIndepOn_pow_mul_pow y).mono fun p hp ↦ ?_
  simp only [Set.mem_ofPred_eq, hdeg] at hp ⊢
  omega

variable [Algebra.IsSeparable (RatFunc k) F]

/-- Let `g ∈ k[X, Y]` be irreducible and monic in `Y` over `k[X]`, and let `y` satisfy
`g(x, y) = 0`, where `F / k(x)` is separable. Then the partial derivative `∂g/∂Y` does not vanish
at `(x, y)`. -/
theorem aeval_pderiv_one_ne_zero_of_aeval_eq_zero {g : MvPolynomial (Fin 2) k}
    (hirr : Irreducible g)
    (hmon : ((Bivariate.equivMvPolynomial k).symm g).Monic) {y : F}
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] (MvPolynomial.pderiv 1 g) ≠ 0 := by
  have h := (Algebra.IsSeparable.isSeparable (RatFunc k) y).aeval_derivative_ne_zero
    (minpoly.aeval (RatFunc k) y)
  rwa [minpoly_ratFunc_eq_map_of_aeval_eq_zero hirr hmon hy, derivative_map,
    Bivariate.aeval_map_eq_aeval_equivMvPolynomial, RatFunc.algebraMap_X,
    ← Bivariate.pderiv_one_equivMvPolynomial, AlgEquiv.apply_symm_apply] at h

variable [FiniteDimensional (RatFunc k) F]

/-- **The different of a smooth plane curve above infinity**: let `g ∈ k[X, Y]` be irreducible of
total degree `n`, with the coefficient of `Yⁿ` equal to `1`, whose chart equation at infinity
`h = uⁿ g(1 / u, v / u)` has `h`, `∂h/∂u` and `∂h/∂v` generating the unit ideal, and let `F / k(x)`
be generated by `y` with `g(x, y) = 0`. At every place `P` of `F` at which `x` has no zero, in
particular at every pole of `x`, `d(P ∣ P ∩ k(x)) = ord_P (∂g/∂Y (x, y)) - (n - 1) ord_P x`. -/
theorem Place.differentExponent_eq_ord_aeval_pderiv_one_sub_mul_ord
    {g : MvPolynomial (Fin 2) k} (hirr : Irreducible g)
    (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1)
    (hsm : Ideal.span {g.inftyChart g.totalDegree,
      MvPolynomial.pderiv 0 (g.inftyChart g.totalDegree),
      MvPolynomial.pderiv 1 (g.inftyChart g.totalDegree)} = ⊤)
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) (P : Place k F)
    (hP : (algebraMap (RatFunc k) F RatFunc.X)⁻¹ ∈ P.integers) :
    (Place.differentExponent k (RatFunc k) P : ℤ) =
      P.ord (MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y]
          (MvPolynomial.pderiv 1 g)) -
        ((g.totalDegree : ℤ) - 1) * P.ord (algebraMap (RatFunc k) F RatFunc.X) := by
  set n := g.totalDegree
  set x := algebraMap (RatFunc k) F RatFunc.X
  have hx : x ≠ 0 := by simp [x, RatFunc.X_ne_zero]
  have hmon := Bivariate.monic_equivMvPolynomial_symm le_rfl hlead
  have hfin := finrank_ratFunc_eq_totalDegree_of_aeval_eq_zero hirr hlead hgen hy
  have hn : 1 ≤ n := MvPolynomial.totalDegree_pos_of_aeval_eq_zero hlead hy
  -- The chart at infinity: `u = x⁻¹` generates `k(x)`, and `v = y x⁻¹` satisfies `h(u, v) = 0`.
  have hdeg := MvPolynomial.totalDegree_inftyChart_le (le_refl n)
  have hlead' : (g.inftyChart n).coeff (Finsupp.single 1 n) = 1 := by
    rw [MvPolynomial.coeff_single_one_inftyChart le_rfl, hlead]
  have hu : algebraMap (RatFunc k) F RatFunc.X⁻¹ = x⁻¹ := map_inv₀ _ _
  have hgen' : (RatFunc k)⟮y * x⁻¹⟯ = ⊤ := by
    refine eq_top_iff.mpr (hgen ▸ IntermediateField.adjoin_simple_le_iff.mpr ?_)
    have : y * x⁻¹ * x ∈ (RatFunc k)⟮y * x⁻¹⟯ :=
      mul_mem (IntermediateField.mem_adjoin_simple_self _ _)
        (IntermediateField.algebraMap_mem _ _)
    simpa [hx] using this
  have h := differentExponent_eq_ord_aeval_pderiv_one (t := RatFunc.X⁻¹)
    (fun h ↦ RatFunc.transcendental_X (IsAlgebraic.inv_iff.mp h))
    (by rw [IntermediateField.adjoin_simple_inv, RatFunc.adjoin_X]) hsm
    (Bivariate.monic_equivMvPolynomial_symm hdeg hlead')
    (by rw [Bivariate.natDegree_equivMvPolynomial_symm hdeg hlead', hfin]) hgen'
    (by rw [hu, MvPolynomial.aeval_inftyChart le_rfl hx, hy, mul_zero]) P (by rwa [hu])
  -- `∂h/∂v (u, v) = u^(n - 1) ∂g/∂Y (x, y)`.
  rw [h, hu, MvPolynomial.aeval_pderiv_one_inftyChart le_rfl hx,
    P.ord_mul (pow_ne_zero _ (inv_ne_zero hx))
      (aeval_pderiv_one_ne_zero_of_aeval_eq_zero hirr hmon hy),
    P.ord_pow, P.ord_inv, Nat.cast_sub hn, Nat.cast_one]
  ring

namespace Divisor

open AlgebraicGeometry

/-- **The different of a smooth plane curve** (Stichtenoth, Theorem 3.5.10, in both affine
charts): let `g ∈ k[X, Y]` be irreducible of total degree `n`, with the coefficient of `Yⁿ` equal
to `1`, such that `g = 0` is smooth and so is its chart at infinity `h = uⁿ g(1 / u, v / u) = 0`,
and let `F / k(x)` be finite separable, generated by `y` with `g(x, y) = 0`. Then
`Diff(F / k(x)) = div (∂g/∂Y (x, y)) + (n - 1) (x)_∞`. -/
theorem different_eq_principal_add_zsmul_poles (hF : IsFunctionField k F)
    {g : MvPolynomial (Fin 2) k} (hirr : Irreducible g)
    (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1)
    (hsm : Ideal.span {g, MvPolynomial.pderiv 0 g, MvPolynomial.pderiv 1 g} = ⊤)
    (hsm' : Ideal.span {g.inftyChart g.totalDegree,
      MvPolynomial.pderiv 0 (g.inftyChart g.totalDegree),
      MvPolynomial.pderiv 1 (g.inftyChart g.totalDegree)} = ⊤)
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) {z : Fˣ}
    (hz : (z : F) = MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y]
      (MvPolynomial.pderiv 1 g)) :
    different k F (IsFunctionField.ratFunc k) =
      principal hF z + ((g.totalDegree : ℤ) - 1) • poles hF
        (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
          (Units.mk0 RatFunc.X RatFunc.X_ne_zero)) := by
  have hmon := Bivariate.monic_equivMvPolynomial_symm le_rfl hlead
  refine WeilDivisor.ext fun P ↦ ?_
  rw [coeff_different, WeilDivisor.coeff_add, WeilDivisor.coeff_zsmul, coeff_principal,
    coeff_poles, hz]
  simp only [Units.coe_map, MonoidHom.coe_ofClass, Units.val_mk0]
  by_cases hP : 0 ≤ P.ord (algebraMap (RatFunc k) F RatFunc.X)
  · rw [Place.differentExponent_eq_ord_aeval_pderiv_one RatFunc.transcendental_X RatFunc.adjoin_X
      hsm hmon (finrank_ratFunc_eq_natDegree_of_aeval_eq_zero hirr hmon hgen hy).symm hgen hy P
      (P.mem_integers_iff_ord_nonneg.mpr hP), max_eq_right (by omega), mul_zero, add_zero]
  · rw [Place.differentExponent_eq_ord_aeval_pderiv_one_sub_mul_ord hirr hlead hsm' hgen hy P
      (P.mem_integers_iff_ord_nonneg.mpr (by rw [P.ord_inv]; omega)), max_eq_left (by omega)]
    ring

/-- **The degree of the different of a smooth plane curve**: under the hypotheses of
`TauCeti.Divisor.different_eq_principal_add_zsmul_poles`, `deg Diff(F / k(x)) = n (n - 1)` for a
curve of degree `n`. -/
theorem degree_different_eq_totalDegree_mul {g : MvPolynomial (Fin 2) k} (hirr : Irreducible g)
    (hlead : g.coeff (Finsupp.single 1 g.totalDegree) = 1)
    (hsm : Ideal.span {g, MvPolynomial.pderiv 0 g, MvPolynomial.pderiv 1 g} = ⊤)
    (hsm' : Ideal.span {g.inftyChart g.totalDegree,
      MvPolynomial.pderiv 0 (g.inftyChart g.totalDegree),
      MvPolynomial.pderiv 1 (g.inftyChart g.totalDegree)} = ⊤)
    {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : MvPolynomial.aeval ![algebraMap (RatFunc k) F RatFunc.X, y] g = 0) :
    degree (different k F (IsFunctionField.ratFunc k)) =
      g.totalDegree * ((g.totalDegree : ℤ) - 1) := by
  have hF : IsFunctionField k F := isFunctionField_iff_functionField.mpr inferInstance
  have hmon := Bivariate.monic_equivMvPolynomial_symm le_rfl hlead
  have hfin := finrank_ratFunc_eq_totalDegree_of_aeval_eq_zero hirr hlead hgen hy
  -- The pole divisor of `x` is the conorm of `P_∞`, of degree `[F : k(x)] · deg P_∞ = n`.
  have hpoles : degree (poles hF (Units.map (algebraMap (RatFunc k) F : RatFunc k →* F)
      (Units.mk0 RatFunc.X RatFunc.X_ne_zero))) = g.totalDegree := by
    have h := finrank_mul_degree_conorm k F (IsFunctionField.ratFunc k)
      (WeilDivisor.ofPoint (Place.infty k))
    rw [Module.finrank_self, Nat.cast_one, one_mul, degree_ofPoint, Place.degree_infty, hfin] at h
    rw [← conorm_poles k F (IsFunctionField.ratFunc k) hF, poles_X]
    simpa using h
  rw [different_eq_principal_add_zsmul_poles hF hirr hlead hsm hsm' hgen hy
      (z := Units.mk0 _ (aeval_pderiv_one_ne_zero_of_aeval_eq_zero hirr hmon hy)) rfl,
    map_add, degree_principal, map_zsmul, hpoles, zero_add, smul_eq_mul, mul_comm]

end Divisor

