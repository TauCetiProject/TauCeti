module

public import TauCeti.FieldTheory.FunctionField.Hyperelliptic.Genus.Basic
public import TauCeti.FieldTheory.RatFunc.Transcendental
-- Proof-only: a quadratic extension away from characteristic two is generated by a square root.
import TauCeti.FieldTheory.IntermediateField.Quadratic

/-!
# Squarefree polynomial models of quadratic extensions of `k(x)`

Let `k` be a field of characteristic other than two and let `x ∈ F` be transcendental over `k`
with `[F : k(x)] = 2`. Completing the square gives `F = k(x, y)` with `y ^ 2 = u` for some
`u ∈ k(x)`. Multiplying `y` by an element of `k(x)` changes `u` by a square, so `u` can first be
made a polynomial, by clearing its denominator, and then a squarefree polynomial `f`, by dividing
out the largest square factor. When `k` is the exact constant field of `F`, the genus formula for
`y ^ 2 = f(x)` (`TauCeti.genus_eq_of_sq_eq`), `g = ⌊(deg f - 1) / 2⌋`, then pins the degree of
`f` to `2g + 1` or `2g + 2`. The constant field must be exact: otherwise `f` may be a constant,
as for `F = k'(x)` with `k' = k(√c)`.

In particular every hyperelliptic function field away from characteristic two is
`k(x, y)` with `y ^ 2 = f(x)` for a squarefree `f` of degree `2g + 1` or `2g + 2`. This is the
existence half of Stichtenoth, Proposition 6.2.3; the converse genus formula is
`TauCeti.genus_eq_of_sq_eq` and `TauCeti.isHyperellipticFunctionField_of_sq_eq`, and the ramified
places are described by `TauCeti.Place.one_lt_ramificationIdx_iff_of_sq_eq`.

## Main results

* `TauCeti.exists_squarefree_sq_eq_of_finrank_ratFunc_eq_two`: a quadratic extension `F` of
  `k(X)` is `k(X)(y)` with `y ^ 2 = f` for a squarefree `f ∈ k[X]`.
* `TauCeti.exists_squarefree_natDegree_sq_eq_of_finrank_ratFunc_eq_two`: if moreover `F` has
  exact constants, `f` can be taken of degree `2g + 1` or `2g + 2`.
* `TauCeti.exists_squarefree_sq_eq_aeval_of_finrank_adjoin_eq_two` and
  `TauCeti.exists_squarefree_natDegree_sq_eq_aeval_of_finrank_adjoin_eq_two`: the same for the
  subfield `k(x)` generated by a transcendental element `x ∈ F`, with `y ^ 2 = f(x)`.
* `TauCeti.IsHyperellipticFunctionField.exists_squarefree_sq_eq_aeval`: a hyperelliptic function
  field has a model `y ^ 2 = f(x)` with `f` squarefree of degree `2g + 1` or `2g + 2`.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Proposition 6.2.3.
-/

public section

open Polynomial

open scoped IntermediateField

namespace TauCeti

variable {k F : Type*} [Field k] [Field F] [Algebra k F]

section RatFunc

variable [Algebra (RatFunc k) F] [IsScalarTower k (RatFunc k) F]

omit [Algebra k F] [IsScalarTower k (RatFunc k) F] in
/-- **A quadratic extension of `k(X)` has a squarefree polynomial model**: away from
characteristic two, if `F / k(X)` has degree two, then `F = k(X)(y)` with `y ^ 2 = f` for a
squarefree polynomial `f`. See `TauCeti.exists_squarefree_natDegree_sq_eq_of_finrank_ratFunc_eq_two`
for the degree of `f` when `k` is the exact constant field of `F`. -/
theorem exists_squarefree_sq_eq_of_finrank_ratFunc_eq_two (h2 : (2 : k) ≠ 0)
    (hdeg : Module.finrank (RatFunc k) F = 2) :
    ∃ (f : k[X]) (y : F), Squarefree f ∧
      y ^ 2 = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) f) ∧ (RatFunc k)⟮y⟯ = ⊤ := by
  have : NeZero (2 : k) := ⟨h2⟩
  have : NeZero (2 : RatFunc k) := NeZero.nat_of_injective (n := 2)
    (f := algebraMap k (RatFunc k)) (algebraMap k (RatFunc k)).injective
  -- Complete the square: `F = k(X)(y₀)` with `y₀ ^ 2 = u ∈ k(X)`.
  obtain ⟨y₀, -, hy₀b, ⟨u, hu⟩, hgen₀⟩ :=
    IntermediateField.exists_sq_mem_range_adjoin_simple_eq_of_finrank_eq_two
      (K := RatFunc k) (L := F) (E := ⊤) (by rw [IntermediateField.finrank_top', hdeg])
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [map_zero, sq_eq_zero_iff] at hu
    exact hy₀b (hu ▸ zero_mem _)
  -- Write `u = p / q` and split off the largest square factor of `p q = s ^ 2 f`.
  obtain ⟨s, f, hsf, hf⟩ := exists_sq_mul_squarefree (u.num * u.denom)
  have hq := RatFunc.algebraMap_ne_zero u.denom_ne_zero
  have hs : algebraMap k[X] (RatFunc k) s ≠ 0 := RatFunc.algebraMap_ne_zero fun hs ↦ by
    rw [hs, zero_pow two_ne_zero, zero_mul, eq_comm, mul_eq_zero] at hsf
    exact hsf.elim (RatFunc.num_ne_zero hu0) u.denom_ne_zero
  -- Then `y = y₀ q / s` has square `u q ^ 2 / s ^ 2 = p q / s ^ 2 = f`.
  set c := algebraMap k[X] (RatFunc k) u.denom / algebraMap k[X] (RatFunc k) s
  have huc : u * c ^ 2 = algebraMap k[X] (RatFunc k) f := by
    have hpq := congrArg (algebraMap k[X] (RatFunc k)) hsf
    rw [map_mul, map_pow, map_mul] at hpq
    rw [← RatFunc.num_div_denom u, div_pow, div_mul_div_comm,
      div_eq_iff (mul_ne_zero hq (pow_ne_zero 2 hs))]
    linear_combination -(algebraMap k[X] (RatFunc k) u.denom) * hpq
  refine ⟨f, y₀ * algebraMap (RatFunc k) F c, hf, ?_, ?_⟩
  · rw [mul_pow, hu, ← map_pow, ← map_mul, huc]
  · rw [IntermediateField.adjoin_simple_mul_algebraMap y₀ c (div_ne_zero hq hs), hgen₀]

/-- Over an exact constant field, a generator of a quadratic extension of `k(X)` does not square
to a constant: a constant square would make it integral, hence constant. -/
private theorem natDegree_pos_of_sq_eq (hex : IsIntegrallyClosedIn k F)
    (hdeg : Module.finrank (RatFunc k) F = 2) {f : k[X]} {y : F} (hgen : (RatFunc k)⟮y⟯ = ⊤)
    (hy : y ^ 2 = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) f)) :
    0 < f.natDegree := by
  by_contra h0
  obtain ⟨a, rfl⟩ := natDegree_eq_zero.mp (Nat.eq_zero_of_not_pos h0)
  have hya : y ^ 2 = algebraMap k F a := by
    simpa [← RatFunc.algebraMap_eq_C, ← IsScalarTower.algebraMap_apply] using hy
  obtain ⟨b, rfl⟩ := hex.isIntegral_iff.mp (.of_pow two_pos (hya ▸ isIntegral_algebraMap))
  have hbot : (RatFunc k)⟮algebraMap k F b⟯ = ⊥ := by
    simp [IsScalarTower.algebraMap_apply k (RatFunc k) F]
  rw [hgen, eq_comm, IntermediateField.bot_eq_top_iff_finrank_eq_one, hdeg] at hbot
  omega

/-- **A quadratic extension of `k(X)` with exact constants has a squarefree polynomial model of
degree `2g + 1` or `2g + 2`** (Stichtenoth, Proposition 6.2.3): away from characteristic two, if
`F / k(X)` has degree two and `k` is the exact constant field of `F`, then `F = k(X)(y)` with
`y ^ 2 = f` for a squarefree polynomial `f` of degree `2g + 1` or `2g + 2`, where `g` is the genus
of `F / k`. -/
theorem exists_squarefree_natDegree_sq_eq_of_finrank_ratFunc_eq_two (h2 : (2 : k) ≠ 0)
    (hex : IsIntegrallyClosedIn k F) (hdeg : Module.finrank (RatFunc k) F = 2) :
    ∃ (f : k[X]) (y : F), Squarefree f ∧
      (f.natDegree = 2 * genus k F + 1 ∨ f.natDegree = 2 * genus k F + 2) ∧
      y ^ 2 = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) f) ∧ (RatFunc k)⟮y⟯ = ⊤ := by
  obtain ⟨f, y, hf, hy, hgen⟩ := exists_squarefree_sq_eq_of_finrank_ratFunc_eq_two h2 hdeg
  have hpos := natDegree_pos_of_sq_eq hex hdeg hgen hy
  have hg := genus_eq_of_sq_eq h2 hf hpos hgen hy
  exact ⟨f, y, hf, by omega, hy, hgen⟩

end RatFunc

section Transcendental

variable {x : F} (hx : Transcendental k x)

/-- The image of `k(X)` is `k(x)`, so `F` has the same degree over both. -/
private theorem finrank_ratFunc_eq_finrank_adjoin :
    letI := ratFuncAlgebraOfTranscendental hx
    Module.finrank (RatFunc k) F = Module.finrank k⟮x⟯ F := by
  let := ratFuncAlgebraOfTranscendental hx
  have := isScalarTower_ratFuncAlgebraOfTranscendental hx
  rw [← finrank_adjoin_algebraMap_X, algebraMap_ratFuncAlgebraOfTranscendental_X]

include hx in
/-- Transport of a model `y ^ 2 = f` of `F` over `k(X)` to the rational subfield `k(x)`. -/
private theorem sq_eq_aeval_and_adjoin_eq_top (hdeg : Module.finrank k⟮x⟯ F = 2) {f : k[X]}
    {y : F} :
    letI := ratFuncAlgebraOfTranscendental hx
    y ^ 2 = algebraMap (RatFunc k) F (algebraMap k[X] (RatFunc k) f) → (RatFunc k)⟮y⟯ = ⊤ →
      y ^ 2 = aeval x f ∧ k⟮x⟯⟮y⟯ = ⊤ := by
  let := ratFuncAlgebraOfTranscendental hx
  have := isScalarTower_ratFuncAlgebraOfTranscendental hx
  intro hy hgen
  have hdeg' := (finrank_ratFunc_eq_finrank_adjoin hx).trans hdeg
  refine ⟨?_, ?_⟩
  · rw [hy, algebraMap_ratFuncAlgebraOfTranscendental_apply,
      RatFunc.algEquivOfTranscendental_algebraMap,
      IntermediateField.AdjoinSimple.coe_aeval_gen_apply]
  -- `y ∉ k(X)` since it generates `F`, hence `y ∉ k(x)`, and `F / k(x)` has prime degree.
  have hprime : (Module.finrank k⟮x⟯ F).Prime := hdeg ▸ Nat.prime_two
  have := IntermediateField.isSimpleOrder_of_finrank_prime k⟮x⟯ F hprime
  refine (eq_bot_or_eq_top (k⟮x⟯⟮y⟯)).resolve_left fun hbot ↦ ?_
  obtain ⟨z, hz⟩ :=
    IntermediateField.mem_bot.mp (IntermediateField.adjoin_simple_eq_bot_iff.mp hbot)
  obtain ⟨r, hr⟩ := (RatFunc.algEquivOfTranscendental x hx).surjective z
  have hyb : y ∈ (⊥ : IntermediateField (RatFunc k) F) := by
    refine IntermediateField.mem_bot.mpr ⟨r, ?_⟩
    rw [algebraMap_ratFuncAlgebraOfTranscendental_apply, hr, ← hz,
      IntermediateField.algebraMap_apply]
  rw [← IntermediateField.adjoin_simple_eq_bot_iff, hgen, eq_comm,
    IntermediateField.bot_eq_top_iff_finrank_eq_one, hdeg'] at hyb
  exact absurd hyb (by norm_num)

include hx in
/-- **A quadratic extension of a rational subfield has a squarefree polynomial model**: away from
characteristic two, if `x ∈ F` is transcendental over `k` with `[F : k(x)] = 2`, then
`F = k(x)(y)` with `y ^ 2 = f(x)` for a squarefree polynomial `f`. See
`TauCeti.exists_squarefree_natDegree_sq_eq_aeval_of_finrank_adjoin_eq_two` for the degree of `f`
when `k` is the exact constant field of `F`. -/
theorem exists_squarefree_sq_eq_aeval_of_finrank_adjoin_eq_two (h2 : (2 : k) ≠ 0)
    (hdeg : Module.finrank k⟮x⟯ F = 2) :
    ∃ (f : k[X]) (y : F), Squarefree f ∧ y ^ 2 = aeval x f ∧ k⟮x⟯⟮y⟯ = ⊤ := by
  let := ratFuncAlgebraOfTranscendental hx
  have := isScalarTower_ratFuncAlgebraOfTranscendental hx
  have hdeg' := (finrank_ratFunc_eq_finrank_adjoin hx).trans hdeg
  obtain ⟨f, y, hf, hy, hgen⟩ := exists_squarefree_sq_eq_of_finrank_ratFunc_eq_two h2 hdeg'
  exact ⟨f, y, hf, sq_eq_aeval_and_adjoin_eq_top hx hdeg hy hgen⟩

include hx in
/-- **A quadratic extension of a rational subfield with exact constants has a squarefree
polynomial model of degree `2g + 1` or `2g + 2`** (Stichtenoth, Proposition 6.2.3): away from
characteristic two, if `x ∈ F` is transcendental over the exact constant field `k` with
`[F : k(x)] = 2`, then `F = k(x)(y)` with `y ^ 2 = f(x)` for a squarefree polynomial `f` of degree
`2g + 1` or `2g + 2`, where `g` is the genus of `F / k`. -/
theorem exists_squarefree_natDegree_sq_eq_aeval_of_finrank_adjoin_eq_two (h2 : (2 : k) ≠ 0)
    (hex : IsIntegrallyClosedIn k F) (hdeg : Module.finrank k⟮x⟯ F = 2) :
    ∃ (f : k[X]) (y : F), Squarefree f ∧
      (f.natDegree = 2 * genus k F + 1 ∨ f.natDegree = 2 * genus k F + 2) ∧
      y ^ 2 = aeval x f ∧ k⟮x⟯⟮y⟯ = ⊤ := by
  let := ratFuncAlgebraOfTranscendental hx
  have := isScalarTower_ratFuncAlgebraOfTranscendental hx
  have hdeg' := (finrank_ratFunc_eq_finrank_adjoin hx).trans hdeg
  obtain ⟨f, y, hf, hfdeg, hy, hgen⟩ :=
    exists_squarefree_natDegree_sq_eq_of_finrank_ratFunc_eq_two h2 hex hdeg'
  exact ⟨f, y, hf, hfdeg, sq_eq_aeval_and_adjoin_eq_top hx hdeg hy hgen⟩

end Transcendental

/-- **A hyperelliptic function field has a squarefree polynomial model** (Stichtenoth,
Proposition 6.2.3): away from characteristic two, a hyperelliptic function field `F / k` of genus
`g` with exact constants is `k(x, y)` with `y ^ 2 = f(x)` for a transcendental `x` and a
squarefree polynomial `f` of degree `2g + 1` or `2g + 2`. -/
theorem IsHyperellipticFunctionField.exists_squarefree_sq_eq_aeval (h2 : (2 : k) ≠ 0)
    (hex : IsIntegrallyClosedIn k F) (hhyp : IsHyperellipticFunctionField k F) :
    ∃ (x : F) (f : k[X]) (y : F), Transcendental k x ∧ Squarefree f ∧
      (f.natDegree = 2 * genus k F + 1 ∨ f.natDegree = 2 * genus k F + 2) ∧
      y ^ 2 = aeval x f ∧ k⟮x⟯⟮y⟯ = ⊤ := by
  obtain ⟨x, hx, hdeg, -⟩ := hhyp.exists_separable_finrank_adjoin_eq_two
  obtain ⟨f, y, hf, hfdeg, hy, hgen⟩ :=
    exists_squarefree_natDegree_sq_eq_aeval_of_finrank_adjoin_eq_two hx h2 hex hdeg
  exact ⟨x, f, y, hx, hf, hfdeg, hy, hgen⟩

end TauCeti
