module

public import TauCeti.FieldTheory.FunctionField.Hyperelliptic.RationalSubfield
public import TauCeti.FieldTheory.IntermediateField.Restrict

/-!
# Automorphisms of a hyperelliptic function field preserve the rational subfield

Let `F / k` be a function field with exact constants and genus `g ≥ 2`, and let `x ∈ F` be
transcendental with `[F : k(x)] = 2`. Since the rational subfield of index two is unique
(`TauCeti.adjoin_eq_adjoin_of_finrank_adjoin_eq_two`), every `k`-automorphism `σ` of `F` carries
`k(x)` onto `k(σ x) = k(x)`. Restriction is therefore a homomorphism `Aut(F / k) →* Aut(k(x) / k)`,
whose kernel is the group of automorphisms of `F / k(x)`, of order two when `F / k(x)` is
separable: it is generated by the hyperelliptic involution, and `Aut(F / k)` modulo it embeds into
`Aut(k(x) / k)`.

## Main results

* `TauCeti.map_adjoin_eq_self_of_finrank_adjoin_eq_two`: every automorphism carries `k(x)` onto
  itself.
* `TauCeti.ker_restrictAdjoinHom`: the kernel of restriction to `k(x)` is the subgroup fixing
  `k(x)`.
* `TauCeti.natCard_fixingSubgroup_adjoin_eq_two`: that subgroup has order two.

## References

* H. Stichtenoth, *Algebraic Function Fields and Codes*, 2nd ed., GTM 254, Springer, 2009,
  Proposition 6.2.4.
-/

public section

open scoped IntermediateField

namespace TauCeti

variable {k F : Type*} [Field k] [Field F] [Algebra k F]

/-- **Every automorphism preserves the rational subfield of index two**: for `g ≥ 2` and
`[F : k(x)] = 2`, a `k`-automorphism `σ` of `F` carries `k(x)` onto itself, because `k(σ x)` is
again a rational subfield of index two. -/
theorem map_adjoin_eq_self_of_finrank_adjoin_eq_two (hF : IsFunctionField k F)
    (hex : IsIntegrallyClosedIn k F) (hg : 2 ≤ genus k F) {x : F} (hx : Transcendental k x)
    (hdeg : Module.finrank k⟮x⟯ F = 2) (σ : F ≃ₐ[k] F) :
    k⟮x⟯.map σ.toAlgHom = k⟮x⟯ := by
  rw [IntermediateField.adjoin_map, Set.image_singleton]
  refine adjoin_eq_adjoin_of_finrank_adjoin_eq_two hF hex hg hx hdeg ?_
  -- `σ` identifies `k(x)` with `k(σ x)` compatibly with its action on `F`
  have hmap : k⟮x⟯.map σ.toAlgHom = k⟮σ x⟯ := by
    rw [IntermediateField.adjoin_map, Set.image_singleton]
    rfl
  rw [← hdeg]
  refine (Algebra.finrank_eq_of_equiv_equiv
    ((k⟮x⟯.equivMap σ.toAlgHom).trans (IntermediateField.equivOfEq hmap)).toRingEquiv
    σ.toRingEquiv (RingHom.ext fun y ↦ ?_)).symm
  simp [IntermediateField.coe_equivMap_apply, IntermediateField.equivOfEq_apply]

/-- **Restriction to the rational subfield of index two**, the homomorphism
`Aut(F / k) →* Aut(k(x) / k)`. -/
noncomputable def restrictAdjoinHom (hF : IsFunctionField k F) (hex : IsIntegrallyClosedIn k F)
    (hg : 2 ≤ genus k F) {x : F} (hx : Transcendental k x) (hdeg : Module.finrank k⟮x⟯ F = 2) :
    (F ≃ₐ[k] F) →* (k⟮x⟯ ≃ₐ[k] k⟮x⟯) :=
  IntermediateField.restrictAlgEquivHom k⟮x⟯
    (map_adjoin_eq_self_of_finrank_adjoin_eq_two hF hex hg hx hdeg)

@[simp]
theorem coe_restrictAdjoinHom_apply (hF : IsFunctionField k F) (hex : IsIntegrallyClosedIn k F)
    (hg : 2 ≤ genus k F) {x : F} (hx : Transcendental k x) (hdeg : Module.finrank k⟮x⟯ F = 2)
    (σ : F ≃ₐ[k] F) (y : k⟮x⟯) : (restrictAdjoinHom hF hex hg hx hdeg σ y : F) = σ y :=
  IntermediateField.coe_restrictAlgEquivHom_apply _ _ σ y

/-- **The kernel of restriction is the group of automorphisms over `k(x)`**: an automorphism of
`F / k` restricts to the identity of `k(x)` exactly when it fixes `k(x)` pointwise. -/
theorem ker_restrictAdjoinHom (hF : IsFunctionField k F) (hex : IsIntegrallyClosedIn k F)
    (hg : 2 ≤ genus k F) {x : F} (hx : Transcendental k x) (hdeg : Module.finrank k⟮x⟯ F = 2) :
    (restrictAdjoinHom hF hex hg hx hdeg).ker = k⟮x⟯.fixingSubgroup :=
  IntermediateField.ker_restrictAlgEquivHom _ _

/-- **The automorphisms over `k(x)` form a group of order two** when `F / k(x)` is separable:
a separable quadratic extension is Galois, with Galois group of order `[F : k(x)] = 2`. -/
theorem natCard_fixingSubgroup_adjoin_eq_two {x : F} (hdeg : Module.finrank k⟮x⟯ F = 2)
    [Algebra.IsSeparable k⟮x⟯ F] : Nat.card k⟮x⟯.fixingSubgroup = 2 := by
  have : Algebra.IsQuadraticExtension k⟮x⟯ F := ⟨hdeg⟩
  rw [Nat.card_congr (IntermediateField.fixingSubgroupEquiv k⟮x⟯).toEquiv,
    IsGalois.card_aut_eq_finrank, hdeg]

end TauCeti
