import TauCeti.FieldTheory.FunctionField.Hyperelliptic.RationalPoint

/-!
# The genus-two field `y² = x⁵ - 1`

Construct the quadratic field given by `y² = x⁵ - 1`. Its constants are exact in every
characteristic. In characteristic other than two and five, it has genus two,
and its different is the sum of the distinct zeros of `y` and its rational place at infinity,
with total degree six. Thus the
finite branch places contribute degree five whether or not the fifth roots of unity are
rational over the constants.

The Weierstrass gaps at a rational place are `{1, 3}` when the place ramifies over `k(x)` and
`{1, 2}` when it does not. The place at infinity is of the first kind, so it is a Weierstrass
place. An affine point `(a, b)` with `b ≠ 0`, such as `(0, i)` when `i² = -1` in `k`, gives a
rational place of the second kind. These are the two gap sequences possible in genus two.

## Main results

* `TauCeti.GenusTwo.genus_eq_two` and `TauCeti.GenusTwo.degree_different`: the genus is two and
  the different of `F / k(x)` has degree six.
* `TauCeti.GenusTwo.weierstrassGaps_eq_of_one_lt_ramificationIdx` and
  `TauCeti.GenusTwo.weierstrassGaps_eq_of_ramificationIdx_eq_one`: the gaps at a rational place
  are `{1, 3}` or `{1, 2}` according as it ramifies over `k(x)` or not.
* `TauCeti.GenusTwo.weierstrassGaps_eq_of_restrict_eq_infty`: the place at infinity has gaps
  `{1, 3}`.
* `TauCeti.GenusTwo.exists_weierstrassGaps_eq_of_sq_eq` and
  `TauCeti.GenusTwo.exists_weierstrassGaps_eq_of_sq_eq_neg_one`: the rational place of an affine
  point `(a, b)` with `b ≠ 0`, for instance `(0, i)`, has gaps `{1, 2}`.

## References

H. Stichtenoth, *Algebraic Function Fields and Codes*, second edition, Proposition 6.2.3,
Theorem 1.6.8 and Proposition 6.2.4.
-/

public section

noncomputable section

namespace TauCeti.GenusTwo

open _root_.Polynomial
open scoped _root_.IntermediateField
open AlgebraicGeometry

variable (k : Type*) [Field k]

/-- The quintic `x⁵ - 1` has odd degree over every field. -/
theorem odd_natDegree : Odd (X ^ 5 - C 1 : k[X]).natDegree := by
  rw [natDegree_X_pow_sub_C]
  decide

/-- The quintic `x⁵ - 1` is squarefree in characteristic other than five. -/
theorem squarefree (h5 : (5 : k) ≠ 0) : Squarefree (X ^ 5 - C 1 : k[X]) :=
  (separable_X_pow_sub_C (1 : k) h5 one_ne_zero).squarefree

/-- The quadratic equation over `k(x)` defining `y² = x⁵ - 1`. -/
def equationPolynomial : (RatFunc k)[X] :=
  X ^ 2 - C (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1))

/-- The defining polynomial, for computation without unfolding its body. -/
theorem equationPolynomial_def : equationPolynomial k =
    X ^ 2 - C (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1)) := (rfl)

private theorem irreducible_equationPolynomial : Irreducible (equationPolynomial k) := by
  rw [equationPolynomial_def]
  refine X_pow_sub_C_irreducible_of_prime Nat.prime_two fun b hb ↦ ?_
  have hord := congrArg (Place.infty k).ord hb
  simp only [Place.ord_pow, Place.ord_infty, RatFunc.intDegree_polynomial,
    natDegree_X_pow_sub_C] at hord
  norm_num at hord
  omega

/-- The function field of the affine equation `y² = x⁵ - 1`, obtained by adjoining its root
to `k(x)`. -/
abbrev FunctionField := AdjoinRoot (equationPolynomial k)

/-- Irreducibility supplies the field structure on the root algebra. -/
instance : Fact (Irreducible (equationPolynomial k)) :=
  ⟨irreducible_equationPolynomial k⟩

/-- The `y`-coordinate in the quadratic field. -/
def genY : FunctionField k := AdjoinRoot.root (equationPolynomial k)

/-- The `y`-coordinate is the root in the defining root algebra. -/
theorem genY_def : genY k = AdjoinRoot.root (equationPolynomial k) := (rfl)

/-- The `x`-coordinate in the quadratic field: the image of the variable of `k(x)`. -/
def genX : FunctionField k := algebraMap (RatFunc k) (FunctionField k) RatFunc.X

/-- The `x`-coordinate is the image of the variable of `k(x)`. -/
theorem genX_def : genX k = algebraMap (RatFunc k) (FunctionField k) RatFunc.X := (rfl)

/-- The coordinate `y` satisfies the defining equation. -/
theorem genY_sq : genY k ^ 2 =
    algebraMap (RatFunc k) (FunctionField k) (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1)) := by
  have hroot := root_X_pow_sub_C_pow 2 (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1))
  rw [← equationPolynomial_def] at hroot
  simpa only [genY_def, AdjoinRoot.algebraMap_eq] using hroot

/-- The quadratic field is generated by `y` over `k(x)`. -/
theorem adjoin_genY_eq_top : (RatFunc k)⟮genY k⟯ = ⊤ := by
  rw [genY_def]
  exact IntermediateField.adjoin_root_eq_top (equationPolynomial k)

/-- The field extension over `k(x)` is quadratic. -/
theorem finrank_eq_two : Module.finrank (RatFunc k) (FunctionField k) = 2 :=
  finrank_ratFunc_eq_two_of_sq_eq_of_odd (odd_natDegree k) (adjoin_genY_eq_top k) (genY_sq k)

/-- The model is finite-dimensional over the rational function field. -/
instance : FiniteDimensional (RatFunc k) (FunctionField k) :=
  Module.finite_of_finrank_pos (by rw [finrank_eq_two k]; exact Nat.zero_lt_two)

/-- The constructed field is an algebraic function field over `k`. -/
theorem isFunctionField : IsFunctionField k (FunctionField k) :=
  isFunctionField_iff_functionField.mpr inferInstance

/-- **The genus of `y² = x⁵ - 1` is two** in characteristic other than two and five. -/
theorem genus_eq_two (h2 : (2 : k) ≠ 0) (h5 : (5 : k) ≠ 0) :
    genus k (FunctionField k) = 2 := by
  have h := genus_eq_of_sq_eq h2 (squarefree k h5)
    (odd_natDegree k).pos (adjoin_genY_eq_top k) (genY_sq k)
  simpa only [natDegree_X_pow_sub_C, Nat.reduceSub, Nat.reduceDiv] using h

/-- The `y`-coordinate is nonzero. -/
@[simp]
theorem genY_ne_zero : genY k ≠ 0 := by
  have hroot := _root_.root_X_pow_sub_C_ne_zero (by decide : 1 < (2 : ℕ))
    (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1))
  rw [← equationPolynomial_def] at hroot
  simpa only [genY_def] using hroot

/-- Away from characteristic two the quadratic model is separable over `k(x)`. -/
instance [NeZero (2 : k)] : Algebra.IsSeparable (RatFunc k) (FunctionField k) :=
  Algebra.isSeparable_of_finrank_eq_two
    (by
      intro h
      exact NeZero.ne (2 : k) (FaithfulSMul.algebraMap_injective k (RatFunc k)
        (by simpa only [map_ofNat, map_zero] using h))) (finrank_eq_two k)

/-- The constants of `y² = x⁵ - 1` are exactly `k` in every characteristic. -/
theorem isIntegrallyClosedIn :
    IsIntegrallyClosedIn k (FunctionField k) := by
  exact isIntegrallyClosedIn_of_sq_eq_of_odd
    (odd_natDegree k) (adjoin_genY_eq_top k) (genY_sq k)

section Different

variable [NeZero (2 : k)]

/-- **The different has degree six**: Hurwitz reads `2 · 2 - 2 = -2 · 2 + 6`. -/
theorem degree_different (h5 : (5 : k) ≠ 0) :
    Divisor.degree (Divisor.different k (FunctionField k) (IsFunctionField.ratFunc k)) = 6 := by
  have h := degree_different_ratFunc_of_sq_eq (NeZero.ne (2 : k))
    (squarefree k h5) (odd_natDegree k).pos
    (adjoin_genY_eq_top k) (genY_sq k)
  simp only [natDegree_X_pow_sub_C] at h
  norm_num at h
  exact h

/-- **The different consists of the distinct zeros of `y` and a rational place at infinity**.
The finite part has degree five, independently of the splitting of `x⁵ - 1` over `k`. -/
theorem exists_different_eq_ofFinset (h5 : (5 : k) ≠ 0) :
    ∃ P : Place k (FunctionField k), P.degree = 1 ∧
      P.restrict k (RatFunc k) = Place.infty k ∧
      Divisor.different k (FunctionField k) (IsFunctionField.ratFunc k) =
        WeilDivisor.ofFinset
          (Divisor.zeros (isFunctionField k) (Units.mk0 (genY k) (genY_ne_zero k))).support +
            WeilDivisor.ofPoint P ∧
      Divisor.degree (Divisor.zeros (isFunctionField k)
        (Units.mk0 (genY k) (genY_ne_zero k))) = 5 := by
  have hf := squarefree k h5
  have hodd := odd_natDegree k
  obtain ⟨P, hP, hdegree, -⟩ := Place.existsUnique_restrict_eq_infty_of_sq_eq_of_odd
    hodd (adjoin_genY_eq_top k) (genY_sq k)
  have hgen : (RatFunc k)⟮(Units.mk0 (genY k) (genY_ne_zero k) : FunctionField k)⟯ = ⊤ :=
    by simpa only [Units.val_mk0] using adjoin_genY_eq_top k
  refine ⟨P, hdegree, hP,
    different_ratFunc_eq_ofFinset_add_of_sq_eq_of_odd (NeZero.ne (2 : k))
      hf hodd hgen (genY_sq k) hP, ?_⟩
  have heq := different_ratFunc_eq_zeros_add_of_sq_eq_of_odd (NeZero.ne (2 : k))
    hf hodd hgen (genY_sq k) hP
  have hdeg := congrArg Divisor.degree heq
  rw [Divisor.degree_add, Divisor.degree_ofPoint, hdegree, degree_different k h5] at hdeg
  omega

end Different

/-! ### Weierstrass gaps -/

section WeierstrassGaps

/-- A polynomial in the variable of `k(x)` maps to the same polynomial in `x`. -/
private theorem algebraMap_eq_aeval_genX (p : k[X]) :
    algebraMap (RatFunc k) (FunctionField k) (algebraMap k[X] (RatFunc k) p) =
      aeval (genX k) p := by
  rw [genX_def, aeval_algebraMap_apply, RatFunc.aeval_X_left_eq_algebraMap]

/-- **The affine equation in the coordinates `x` and `y`**: `y² = x⁵ - 1`. -/
@[simp]
theorem genY_sq_eq : genY k ^ 2 = genX k ^ 5 - 1 := by
  rw [genY_sq, algebraMap_eq_aeval_genX]
  simp

/-- The coordinate `x` is transcendental over `k`. -/
theorem transcendental_genX : Transcendental k (genX k) :=
  (transcendental_algebraMap_iff (FaithfulSMul.algebraMap_injective (RatFunc k) _)).mpr
    RatFunc.transcendental_X

/-- The field is quadratic over the subfield `k⟮x⟯` generated by `x`. -/
theorem finrank_adjoin_genX : Module.finrank k⟮genX k⟯ (FunctionField k) = 2 := by
  rw [genX_def, finrank_adjoin_algebraMap_X, finrank_eq_two]

/-- The field is finite-dimensional over the subfield `k⟮x⟯` generated by `x`. -/
instance : FiniteDimensional k⟮genX k⟯ (FunctionField k) :=
  Module.finite_of_finrank_pos (by rw [finrank_adjoin_genX]; exact Nat.zero_lt_two)

/-- A place ramifies over `k⟮x⟯` exactly as it does over `k(x)`. -/
private theorem ramificationIdx_adjoin_genX (P : Place k (FunctionField k)) :
    Place.ramificationIdx k⟮genX k⟯ P = Place.ramificationIdx (RatFunc k) P :=
  (Place.ramificationIdx_eq_of_ringEquiv (F := k⟮genX k⟯) (P' := P)
    (σ := (RatFunc.algEquivOfTranscendental _ (transcendental_genX k)).toRingEquiv)
    coe_algEquivOfTranscendental_algebraMap_X_apply).symm

variable {k}

/-- **The ramified rational places of `y² = x⁵ - 1` have gaps `1, 3`**: in characteristic other
than two and five, a rational place ramified over `k(x)` has Weierstrass gaps `{1, 3}`. -/
theorem weierstrassGaps_eq_of_one_lt_ramificationIdx (h2 : (2 : k) ≠ 0) (h5 : (5 : k) ≠ 0)
    {P : Place k (FunctionField k)} (hP : P.degree = 1)
    (hram : 1 < Place.ramificationIdx (RatFunc k) P) : P.weierstrassGaps = {1, 3} := by
  rw [Place.weierstrassGaps_eq_image_range_of_one_lt_ramificationIdx (isFunctionField k)
    (isIntegrallyClosedIn k) (transcendental_genX k) (finrank_adjoin_genX k) hP
    (by rwa [ramificationIdx_adjoin_genX]), genus_eq_two k h2 h5]
  decide

/-- **The unramified rational places of `y² = x⁵ - 1` have gaps `1, 2`**: in characteristic other
than two and five, a rational place unramified over `k(x)` has Weierstrass gaps `{1, 2}`. -/
theorem weierstrassGaps_eq_of_ramificationIdx_eq_one (h2 : (2 : k) ≠ 0) (h5 : (5 : k) ≠ 0)
    {P : Place k (FunctionField k)} (hP : P.degree = 1)
    (hram : Place.ramificationIdx (RatFunc k) P = 1) : P.weierstrassGaps = {1, 2} := by
  rw [Place.weierstrassGaps_eq_Icc_of_ramificationIdx_eq_one (isFunctionField k)
    (isIntegrallyClosedIn k) (transcendental_genX k) (finrank_adjoin_genX k) hP
    (by rwa [ramificationIdx_adjoin_genX]), genus_eq_two k h2 h5]
  decide

/-- **The place at infinity of `y² = x⁵ - 1` is a Weierstrass place**: in characteristic other
than two and five, the place over the place at infinity of `k(x)`, which is rational, has
Weierstrass gaps `{1, 3}`. -/
theorem weierstrassGaps_eq_of_restrict_eq_infty (h2 : (2 : k) ≠ 0) (h5 : (5 : k) ≠ 0)
    {P : Place k (FunctionField k)} (hP : P.restrict k (RatFunc k) = Place.infty k) :
    P.weierstrassGaps = {1, 3} := by
  have : NeZero (2 : k) := ⟨h2⟩
  obtain ⟨Q, -, hQ, huniq⟩ := Place.existsUnique_restrict_eq_infty_of_sq_eq_of_odd
    (odd_natDegree k) (adjoin_genY_eq_top k) (genY_sq k)
  obtain rfl := huniq P hP
  exact weierstrassGaps_eq_of_one_lt_ramificationIdx h2 h5 hQ
    ((Place.one_lt_ramificationIdx_iff_of_sq_eq h2 (squarefree k h5) (adjoin_genY_eq_top k)
      (genY_sq k) P).mpr (Or.inl ⟨hP, odd_natDegree k⟩))

/-- **A rational point off the branch locus gives a rational place with gaps `1, 2`**: in
characteristic other than two and five, if `b ≠ 0` and `b² = a⁵ - 1`, then there is a rational
place at which `x - a` and `y - b` both vanish, and its Weierstrass gaps are `{1, 2}`. -/
theorem exists_weierstrassGaps_eq_of_sq_eq (h2 : (2 : k) ≠ 0) (h5 : (5 : k) ≠ 0) {a b : k}
    (hb : b ≠ 0) (hab : b ^ 2 = a ^ 5 - 1) :
    ∃ P : Place k (FunctionField k), P.degree = 1 ∧
      0 < P.ord (genX k - algebraMap k (FunctionField k) a) ∧
      0 < P.ord (genY k - algebraMap k (FunctionField k) b) ∧ P.weierstrassGaps = {1, 2} := by
  obtain ⟨P, -, hdeg, he, hxa, hyb⟩ := Place.exists_ord_sub_pos_of_sq_eq h2 (squarefree k h5)
    (odd_natDegree k).pos (adjoin_genY_eq_top k) (genY_sq k) hb
    (by rw [hab, eval_sub, eval_pow, eval_X, eval_C])
  exact ⟨P, hdeg, by rwa [genX_def], hyb,
    weierstrassGaps_eq_of_ramificationIdx_eq_one h2 h5 hdeg he⟩

/-- **The rational place of the point `(0, i)` has gaps `1, 2`**: in characteristic other than two
and five, if `i² = -1` in `k`, then there is a rational place at which `x` and `y - i` vanish,
and its Weierstrass gaps are `{1, 2}`. -/
theorem exists_weierstrassGaps_eq_of_sq_eq_neg_one (h2 : (2 : k) ≠ 0) (h5 : (5 : k) ≠ 0) {i : k}
    (hi : i ^ 2 = -1) :
    ∃ P : Place k (FunctionField k), P.degree = 1 ∧ 0 < P.ord (genX k) ∧
      0 < P.ord (genY k - algebraMap k (FunctionField k) i) ∧ P.weierstrassGaps = {1, 2} := by
  have hi0 : i ≠ 0 := by
    rintro rfl
    norm_num at hi
  simpa using exists_weierstrassGaps_eq_of_sq_eq h2 h5 (a := 0) hi0 (by rw [hi]; ring)

end WeierstrassGaps

end TauCeti.GenusTwo
