module

public import TauCeti.FieldTheory.FunctionField.Hyperelliptic.Different
import Mathlib.FieldTheory.KummerPolynomial

/-!
# The genus-two field `y² = x⁵ - 1`

Construct the quadratic field given by `y² = x⁵ - 1`. Its constants are exact in every
characteristic. In characteristic other than two and five, it has genus two,
and its different is the sum of the distinct zeros of `y` and its rational place at infinity,
with total degree six. Thus the
finite branch places contribute degree five whether or not the fifth roots of unity are
rational over the constants.

## References

H. Stichtenoth, *Algebraic Function Fields and Codes*, second edition, Proposition 6.2.3.
-/

public section

noncomputable section

namespace TauCeti.GenusTwo

open _root_.Polynomial
open scoped _root_.IntermediateField
open AlgebraicGeometry

variable (k : Type*) [Field k]

/-- The quintic `x⁵ - 1` has odd degree over every field. -/
theorem odd_natDegree : Odd (X ^ 5 - C 1 : k[X]).natDegree := by
  rw [natDegree_X_pow_sub_C]
  decide

/-- The quintic `x⁵ - 1` is squarefree in characteristic other than five. -/
theorem squarefree (h5 : (5 : k) ≠ 0) : Squarefree (X ^ 5 - C 1 : k[X]) :=
  (separable_X_pow_sub_C (1 : k) h5 one_ne_zero).squarefree

/-- The quadratic equation over `k(x)` defining `y² = x⁵ - 1`. -/
def equationPolynomial : (RatFunc k)[X] :=
  X ^ 2 - C (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1))

/-- The defining polynomial, for computation without unfolding its body. -/
theorem equationPolynomial_def : equationPolynomial k =
    X ^ 2 - C (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1)) := (rfl)

private theorem irreducible_equationPolynomial : Irreducible (equationPolynomial k) := by
  rw [equationPolynomial_def]
  refine X_pow_sub_C_irreducible_of_prime Nat.prime_two fun b hb ↦ ?_
  have hord := congrArg (Place.infty k).ord hb
  simp only [Place.ord_pow, Place.ord_infty, RatFunc.intDegree_polynomial,
    natDegree_X_pow_sub_C] at hord
  norm_num at hord
  omega

/-- The function field of the affine equation `y² = x⁵ - 1`, obtained by adjoining its root
to `k(x)`. -/
abbrev FunctionField := AdjoinRoot (equationPolynomial k)

/-- Irreducibility supplies the field structure on the root algebra. -/
instance : Fact (Irreducible (equationPolynomial k)) :=
  ⟨irreducible_equationPolynomial k⟩

/-- The `y`-coordinate in the quadratic field. -/
def genY : FunctionField k := AdjoinRoot.root (equationPolynomial k)

/-- The `y`-coordinate is the root in the defining root algebra. -/
theorem genY_def : genY k = AdjoinRoot.root (equationPolynomial k) := (rfl)

/-- The coordinate `y` satisfies the defining equation. -/
@[simp]
theorem genY_sq : genY k ^ 2 =
    algebraMap (RatFunc k) (FunctionField k) (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1)) := by
  have hroot := root_X_pow_sub_C_pow 2 (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1))
  rw [← equationPolynomial_def] at hroot
  simpa only [genY_def, AdjoinRoot.algebraMap_eq] using hroot

/-- The quadratic field is generated by `y` over `k(x)`. -/
theorem adjoin_genY_eq_top : (RatFunc k)⟮genY k⟯ = ⊤ := by
  rw [genY_def]
  exact IntermediateField.adjoin_root_eq_top (equationPolynomial k)

/-- The field extension over `k(x)` is quadratic. -/
theorem finrank_eq_two : Module.finrank (RatFunc k) (FunctionField k) = 2 :=
  finrank_ratFunc_eq_two_of_sq_eq_of_odd (odd_natDegree k) (adjoin_genY_eq_top k) (genY_sq k)

/-- The model is finite-dimensional over the rational function field. -/
instance : FiniteDimensional (RatFunc k) (FunctionField k) :=
  Module.finite_of_finrank_pos (by rw [finrank_eq_two k]; exact Nat.zero_lt_two)

/-- The constructed field is an algebraic function field over `k`. -/
theorem isFunctionField : IsFunctionField k (FunctionField k) :=
  isFunctionField_iff_functionField.mpr inferInstance

/-- **The genus of `y² = x⁵ - 1` is two** in characteristic other than two and five. -/
theorem genus_eq_two (h2 : (2 : k) ≠ 0) (h5 : (5 : k) ≠ 0) :
    genus k (FunctionField k) = 2 := by
  have h := genus_eq_of_sq_eq h2 (squarefree k h5)
    (odd_natDegree k).pos (adjoin_genY_eq_top k) (genY_sq k)
  simpa only [natDegree_X_pow_sub_C, Nat.reduceSub, Nat.reduceDiv] using h

/-- The `y`-coordinate is nonzero. -/
@[simp]
theorem genY_ne_zero : genY k ≠ 0 := by
  have hroot := _root_.root_X_pow_sub_C_ne_zero (by decide : 1 < (2 : ℕ))
    (algebraMap k[X] (RatFunc k) (X ^ 5 - C 1))
  rw [← equationPolynomial_def] at hroot
  simpa only [genY_def] using hroot

/-- Away from characteristic two the quadratic model is separable over `k(x)`. -/
instance [NeZero (2 : k)] : Algebra.IsSeparable (RatFunc k) (FunctionField k) :=
  Algebra.isSeparable_of_finrank_eq_two
    (by
      intro h
      exact NeZero.ne (2 : k) (FaithfulSMul.algebraMap_injective k (RatFunc k)
        (by simpa only [map_ofNat, map_zero] using h))) (finrank_eq_two k)

/-- The constants of `y² = x⁵ - 1` are exactly `k` in every characteristic. -/
theorem isIntegrallyClosedIn :
    IsIntegrallyClosedIn k (FunctionField k) := by
  exact isIntegrallyClosedIn_of_sq_eq_of_odd
    (odd_natDegree k) (adjoin_genY_eq_top k) (genY_sq k)

section Different

variable [NeZero (2 : k)]

/-- **The different has degree six**: Hurwitz reads `2 · 2 - 2 = -2 · 2 + 6`. -/
theorem degree_different (h5 : (5 : k) ≠ 0) :
    Divisor.degree (Divisor.different k (FunctionField k) (IsFunctionField.ratFunc k)) = 6 := by
  have h := degree_different_ratFunc_of_sq_eq (NeZero.ne (2 : k))
    (squarefree k h5) (odd_natDegree k).pos
    (adjoin_genY_eq_top k) (genY_sq k)
  simp only [natDegree_X_pow_sub_C] at h
  norm_num at h
  exact h

/-- **The different consists of the distinct zeros of `y` and a rational place at infinity**.
The finite part has degree five, independently of the splitting of `x⁵ - 1` over `k`. -/
theorem exists_different_eq_ofFinset (h5 : (5 : k) ≠ 0) :
    ∃ P : Place k (FunctionField k), P.degree = 1 ∧
      P.restrict k (RatFunc k) = Place.infty k ∧
      Divisor.different k (FunctionField k) (IsFunctionField.ratFunc k) =
        WeilDivisor.ofFinset
          (Divisor.zeros (isFunctionField k) (Units.mk0 (genY k) (genY_ne_zero k))).support +
            WeilDivisor.ofPoint P ∧
      Divisor.degree (Divisor.zeros (isFunctionField k)
        (Units.mk0 (genY k) (genY_ne_zero k))) = 5 := by
  have hf := squarefree k h5
  have hodd := odd_natDegree k
  obtain ⟨P, hP, hdegree, -⟩ := Place.existsUnique_restrict_eq_infty_of_sq_eq_of_odd
    hodd (adjoin_genY_eq_top k) (genY_sq k)
  have hgen : (RatFunc k)⟮(Units.mk0 (genY k) (genY_ne_zero k) : FunctionField k)⟯ = ⊤ :=
    by simpa only [Units.val_mk0] using adjoin_genY_eq_top k
  refine ⟨P, hdegree, hP,
    different_ratFunc_eq_ofFinset_add_of_sq_eq_of_odd (NeZero.ne (2 : k))
      hf hodd hgen (genY_sq k) hP, ?_⟩
  have heq := different_ratFunc_eq_zeros_add_of_sq_eq_of_odd (NeZero.ne (2 : k))
    hf hodd hgen (genY_sq k) hP
  have hdeg := congrArg Divisor.degree heq
  rw [Divisor.degree_add, Divisor.degree_ofPoint, hdegree, degree_different k h5] at hdeg
  omega

end Different

end TauCeti.GenusTwo
