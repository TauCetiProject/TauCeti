/-!
# `p`-independence and `p`-bases of fields in prime characteristic

Let `k` be a field of exponential (or prime) characteristic `p` and let
`k ^ p = (frobenius k p).fieldRange` be its subfield of `p`-th powers. A family `b : ι → k` is
**`p`-independent** when the `p`-monomials `∏ i, b i ^ (e i : ℕ)` (`e : ι →₀ Fin p`) are linearly
independent over `k ^ p`, and in prime characteristic `p` a **`p`-basis** when those `p`-monomials
form a `k ^ p`-basis of `k`.

Because every element `x ∈ k` satisfies `x ^ p ∈ k ^ p`, any `k ^ p`-subalgebra of `k` is algebraic
and hence automatically an intermediate field, so the `k ^ p`-linear span of the `p`-monomials in
`b` coincides with the intermediate field generated by `b` over `k ^ p`. Adjoining an element
outside an intermediate field `E ≥ k ^ p` produces a purely inseparable extension of degree `p` (via
Mathlib's `irreducible_X_pow_sub_C_of_prime` in `Mathlib.FieldTheory.KummerPolynomial`), giving an
incremental characterization of `p`-independence, finite character, and existence of possibly
infinite `p`-bases by Zorn's lemma.

## Main definitions

* `TauCeti.pMonomial`: the `p`-monomial `∏ i, b i ^ (e i : ℕ)` for `e : ι →₀ Fin p`.
* `TauCeti.IsPIndependent`: linear independence of `pMonomial p b` over
  `(frobenius k p).fieldRange`.
* `TauCeti.IsPBasis`: `pMonomial p b` forms a `(frobenius k p).fieldRange`-basis of `k`.
* `TauCeti.IsPBasis.basis`, `TauCeti.IsPBasis.fintypeBasis`: the resulting bases of `k` over
  `k ^ p`.

## Main results

* `TauCeti.span_range_pMonomial_eq_adjoin`: the `k ^ p`-span of the `p`-monomials in `b` equals
  the intermediate field generated by `b` over `k ^ p`.
* `TauCeti.isPIndependent_option_iff`: adjoining `x` preserves `p`-independence iff `x` lies
  outside `k ^ p(range b)`.
* `TauCeti.isPIndependent_iff_finset`: `p`-independence has finite character.
* `TauCeti.exists_isPBasis_of_isPIndependent`, `TauCeti.exists_isPBasis`: every `p`-independent
  subset extends to a (possibly infinite) `p`-basis, so every field of prime characteristic `p`
  admits a `p`-basis.
* `TauCeti.IsPBasis.finite_iff_finiteDimensional`: a `p`-basis is finite iff `[k : k ^ p]` is
  finite.
* `TauCeti.IsPBasis.finrank_fieldRange_frobenius`: `[k : k ^ p] = p ^ Nat.card ι` for a finite
  `p`-basis indexed by `ι`.
* `TauCeti.isPBasis_empty_iff_perfectRing`: the empty family is a `p`-basis iff `k` is perfect.

## References

* H. Matsumura, *Commutative Ring Theory*, second edition, Cambridge University Press, 1989, §26.
* The Stacks Project, Algebra, Definition 15.47.1 (Tag 07P1) and Lemma 15.47.2 (Tag 07P2).
-/

public section

namespace TauCeti

section PMonomial

variable (p : ℕ) [NeZero p] {ι ι' M : Type*} [CommMonoid M]

/-- The `p`-monomial `∏ i, b i ^ (e i : ℕ)` attached to a family `b : ι → M` and a finitely
supported exponent function `e : ι →₀ Fin p`. -/
def pMonomial (b : ι → M) (e : ι →₀ Fin p) : M :=
  e.prod fun i n ↦ b i ^ (n : ℕ)

/-- Unfolding `pMonomial` as a `Finsupp.prod`. -/
theorem pMonomial_def (b : ι → M) (e : ι →₀ Fin p) :
    pMonomial p b e = e.prod fun i n ↦ b i ^ (n : ℕ) :=
  (rfl)

/-- The empty exponent gives the unit `p`-monomial `1`. -/
@[simp]
theorem pMonomial_zero (b : ι → M) : pMonomial p b 0 = 1 :=
  Finsupp.prod_zero_index

/-- A single-coordinate exponent gives a single power of the corresponding generator. -/
@[simp]
theorem pMonomial_single (b : ι → M) (i : ι) (n : Fin p) :
    pMonomial p b (Finsupp.single i n) = b i ^ (n : ℕ) :=
  Finsupp.prod_single_index (pow_zero _)

/-- A unit exponent in coordinate `i` recovers `b i`. -/
theorem pMonomial_single_one (hp : 1 < p) (b : ι → M) (i : ι) :
    pMonomial p b (Finsupp.single i ⟨1, hp⟩) = b i := by
  simp [pMonomial_single]

/-- On a finite index type, `pMonomial` is the ordinary finite product over all indices. -/
theorem pMonomial_eq_fintype_prod [Fintype ι] (b : ι → M) (e : ι →₀ Fin p) :
    pMonomial p b e = ∏ i, b i ^ (e i : ℕ) :=
  Finsupp.prod_fintype _ _ fun _ ↦ pow_zero _

/-- Reindexing along an injective map corresponds to `Finsupp.mapDomain` on exponents. -/
theorem pMonomial_comp_of_injective (b : ι → M) {f : ι' → ι} (hf : Function.Injective f)
    (e : ι' →₀ Fin p) : pMonomial p (b ∘ f) e = pMonomial p b (e.mapDomain f) := by
  unfold pMonomial
  convert (Finsupp.prod_mapDomain_index_inj
    (s := e) (h := fun i (n : Fin p) ↦ b i ^ (n : ℕ)) hf).symm using 1
  rfl

/-- Reindexing along `Option.elim' x b` splits off the `none` power from the `some` monomial. -/
theorem pMonomial_option_elim (x : M) (b : ι → M) (e : Option ι →₀ Fin p) :
    pMonomial p (Option.elim' x b) e = x ^ (e none : ℕ) * pMonomial p b e.some := by
  have h1 : pMonomial p (Option.elim' x b) e =
      (e.mapRange Fin.val (Fin.val_zero p)).prod fun o n ↦ Option.elim' x b o ^ n := by
    rw [pMonomial_def, Finsupp.prod_mapRange_index (fun _ ↦ pow_zero _)]
  have h2 : pMonomial p b e.some =
      (e.some.mapRange Fin.val (Fin.val_zero p)).prod fun i n ↦ b i ^ n := by
    rw [pMonomial_def, Finsupp.prod_mapRange_index (fun _ ↦ pow_zero _)]
  have hsome :
      (e.mapRange Fin.val (Fin.val_zero p)).some = e.some.mapRange Fin.val (Fin.val_zero p) := by
    ext i
    rfl
  rw [h1, ← Finsupp.optionElim_some (e.mapRange Fin.val (Fin.val_zero p)),
    Finsupp.prod_pow_optionElim, Finsupp.mapRange_apply, hsome, h2]
  rfl

/-- The product of two `p`-monomials differs from the `p`-monomial of their modulo-`p` sum by a
`p`-th power. -/
theorem exists_mul_pMonomial_eq_pow_mul_pMonomial_add (b : ι → M) (e f : ι →₀ Fin p) :
    ∃ c : M, pMonomial p b e * pMonomial p b f = c ^ p * pMonomial p b (e + f) := by
  classical
  let s : Finset ι := e.support ∪ f.support
  refine ⟨∏ i ∈ s, b i ^ (((e i : ℕ) + (f i : ℕ)) / p), ?_⟩
  have he : pMonomial p b e = ∏ i ∈ s, b i ^ (e i : ℕ) :=
    Finsupp.prod_of_support_subset _ Finset.subset_union_left _ fun _ _ ↦ pow_zero _
  have hf : pMonomial p b f = ∏ i ∈ s, b i ^ (f i : ℕ) :=
    Finsupp.prod_of_support_subset _ Finset.subset_union_right _ fun _ _ ↦ pow_zero _
  have hef : pMonomial p b (e + f) = ∏ i ∈ s, b i ^ ((e + f) i : ℕ) :=
    Finsupp.prod_of_support_subset _ Finsupp.support_add _ fun _ _ ↦ pow_zero _
  have hexp : ∀ i, p * (((e i : ℕ) + (f i : ℕ)) / p) + ((e + f) i : ℕ) = (e i : ℕ) + (f i : ℕ) := by
    intro i
    rw [Finsupp.add_apply, Fin.val_add, Nat.div_add_mod]
  rw [he, hf, hef, ← Finset.prod_pow, ← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun i _ ↦ ?_
  rw [← pow_mul, mul_comm _ p, ← pow_add, ← pow_add, hexp i]

/-- Multiplying the decremented `p`-monomial at a nonzero coordinate `j` by `b j` recovers the
original `p`-monomial. -/
theorem mul_pMonomial_sub_single (hp : 1 < p) (b : ι → M) (e : ι →₀ Fin p) {j : ι}
    (hj : e j ≠ 0) :
    b j * pMonomial p b (e - Finsupp.single j ⟨1, hp⟩) = pMonomial p b e := by
  let e' : ι →₀ Fin p := e - Finsupp.single j ⟨1, hp⟩
  have h1 : pMonomial p b e' =
      b j ^ (e' j : ℕ) * (e'.erase j).prod fun i n ↦ b i ^ (n : ℕ) :=
    (Finsupp.mul_prod_erase' e' j (fun i (n : Fin p) ↦ b i ^ (n : ℕ)) fun _ ↦ pow_zero _).symm
  have h2 : pMonomial p b e =
      b j ^ (e j : ℕ) * (e.erase j).prod fun i n ↦ b i ^ (n : ℕ) :=
    (Finsupp.mul_prod_erase' e j (fun i (n : Fin p) ↦ b i ^ (n : ℕ)) fun _ ↦ pow_zero _).symm
  have herase : e'.erase j = e.erase j := by
    ext i
    by_cases hij : i = j
    · simp [hij]
    · simp [e', hij]
  have hj1 : 1 ≤ (e j : ℕ) := Nat.succ_le_of_lt (Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hj))
  have hle : (⟨1, hp⟩ : Fin p) ≤ e j := Fin.le_def.mpr hj1
  have hval : (e' j : ℕ) = (e j : ℕ) - 1 := by
    simpa [e'] using Fin.coe_sub_iff_le.mpr hle
  rw [h1, h2, herase, ← mul_assoc, ← pow_succ', hval, Nat.sub_add_cancel hj1]

end PMonomial

section ExpCharField

variable {p : ℕ} {k : Type*} [Field k] [ExpChar k p] {ι ι' : Type*}

/-- A family `b : ι → k` in a field `k` of exponential characteristic `p` is **`p`-independent**
when its `p`-monomials `∏ i, b i ^ (e i : ℕ)` (`e : ι →₀ Fin p`) are linearly independent over
the subfield `k ^ p` of `p`-th powers. -/
def IsPIndependent (p : ℕ) {k : Type*} [Field k] [ExpChar k p] {ι : Type*} (b : ι → k) : Prop :=
  have : NeZero p := ⟨expChar_ne_zero k p⟩
  LinearIndependent (frobenius k p).fieldRange (pMonomial p b)

/-- Unfolding `IsPIndependent` as linear independence of the `p`-monomials over `k ^ p`. -/
theorem isPIndependent_iff [NeZero p] (b : ι → k) :
    IsPIndependent p b ↔ LinearIndependent (frobenius k p).fieldRange (pMonomial p b) :=
  Iff.rfl

/-- Unfold `IsPIndependent` to linear independence of the `p`-monomials over `k ^ p`. -/
theorem IsPIndependent.linearIndependent [NeZero p] {b : ι → k} (hb : IsPIndependent p b) :
    LinearIndependent (frobenius k p).fieldRange (pMonomial p b) :=
  hb

/-- For a finite index type, `IsPIndependent` is linear independence of `e ↦ ∏ i, b i ^ e i`
indexed by `ι → Fin p`. -/
theorem isPIndependent_iff_fintype [Fintype ι] (b : ι → k) :
    IsPIndependent p b ↔
      LinearIndependent (frobenius k p).fieldRange (fun e : ι → Fin p ↦ ∏ i, b i ^ (e i : ℕ)) := by
  have : NeZero p := ⟨expChar_ne_zero k p⟩
  have heq : (fun e : ι → Fin p ↦ ∏ i, b i ^ (e i : ℕ)) =
      pMonomial p b ∘ Finsupp.equivFunOnFinite.symm := funext fun e ↦ by
    simpa using (pMonomial_eq_fintype_prod p b (Finsupp.equivFunOnFinite.symm e)).symm
  rw [heq, IsPIndependent, linearIndependent_equiv]

/-- Composing a `p`-independent family with an injective map preserves `p`-independence. -/
theorem IsPIndependent.comp {b : ι → k} (hb : IsPIndependent p b) {f : ι' → ι}
    (hf : Function.Injective f) : IsPIndependent p (b ∘ f) := by
  have : NeZero p := ⟨expChar_ne_zero k p⟩
  have hcomp : pMonomial p (b ∘ f) = pMonomial p b ∘ Finsupp.mapDomain f :=
    funext fun e ↦ pMonomial_comp_of_injective p b hf e
  rw [IsPIndependent, hcomp]
  exact hb.linearIndependent.comp _ (Finsupp.mapDomain_injective hf)

/-- `p`-independence is invariant under reindexing by an equivalence. -/
theorem isPIndependent_equiv (b : ι → k) (e : ι' ≃ ι) :
    IsPIndependent p (b ∘ e) ↔ IsPIndependent p b :=
  ⟨fun h ↦ by
    have := h.comp e.symm.injective
    rwa [Function.comp_assoc, Equiv.self_comp_symm, Function.comp_id] at this,
    fun h ↦ h.comp e.injective⟩

/-- Any empty family is `p`-independent. -/
theorem isPIndependent_empty [IsEmpty ι] (b : ι → k) : IsPIndependent p b := by
  have : NeZero p := ⟨expChar_ne_zero k p⟩
  rw [IsPIndependent, linearIndependent_iff']
  intro s g hg e he
  have he0 : e = 0 := Subsingleton.elim e 0
  have hs : s = {0} := by
    ext x
    simp [Subsingleton.elim x 0, he0 ▸ he]
  subst he0
  rw [hs, Finset.sum_singleton, pMonomial_zero, Algebra.smul_def, mul_one] at hg
  exact (algebraMap (frobenius k p).fieldRange k).injective (by simpa using hg)

/-- `p`-independence has finite character: a family is `p`-independent iff every finite subfamily
is `p`-independent. -/
theorem isPIndependent_iff_finset (b : ι → k) :
    IsPIndependent p b ↔ ∀ s : Finset ι, IsPIndependent p (fun i : s ↦ b i) := by
  have : NeZero p := ⟨expChar_ne_zero k p⟩
  refine ⟨fun hb s ↦ hb.comp Subtype.val_injective, fun h ↦ ?_⟩
  classical
  rw [IsPIndependent, linearIndependent_iff_finset_linearIndependent]
  intro t
  let s : Finset ι := t.biUnion Finsupp.support
  have hs : ∀ f ∈ t, ∀ a ∈ f.support, a ∈ s := fun f hf _ ha ↦
    Finset.mem_biUnion.mpr ⟨f, hf, ha⟩
  let emb : (s →₀ Fin p) → (ι →₀ Fin p) := Finsupp.mapDomain Subtype.val
  let proj : (ι →₀ Fin p) → (s →₀ Fin p) := Finsupp.subtypeDomain (· ∈ s)
  have hemb_eq : ∀ g : s →₀ Fin p, g.extendDomain = emb g := fun g ↦ by
    rw [Finsupp.extendDomain_eq_embDomain_subtype, Finsupp.embDomain_eq_mapDomain]
    rfl
  have hsect : ∀ f ∈ t, emb (proj f) = f := fun f hf ↦ by
    rw [← hemb_eq]
    exact Finsupp.extendDomain_subtypeDomain f (hs f hf)
  have hsub : pMonomial p b ∘ (Subtype.val : t → ι →₀ Fin p) =
      (fun g : s →₀ Fin p ↦ pMonomial p (fun i : s ↦ b i) g) ∘ (fun f : t ↦ proj f) := by
    ext f
    have hpm : pMonomial p (fun i : s ↦ b i) (proj f.1) = pMonomial p b (emb (proj f.1)) :=
      pMonomial_comp_of_injective p b Subtype.val_injective (proj f.1)
    rw [Function.comp_apply, Function.comp_apply, hpm, hsect f.1 f.2]
  rw [hsub]
  refine (h s).linearIndependent.comp _ fun f₁ f₂ heq ↦ Subtype.ext ?_
  rw [← hsect f₁.1 f₁.2, ← hsect f₂.1 f₂.2, heq]

private theorem isPIndependent_sUnion_of_chain {c : Set (Set k)}
    (hc : ∀ t ∈ c, IsPIndependent p ((↑) : t → k)) (hch : IsChain (· ⊆ ·) c) (hcne : c.Nonempty) :
    IsPIndependent p ((↑) : ↑(⋃₀ c) → k) := by
  classical
  rw [isPIndependent_iff_finset]
  intro F
  have hsub : ↑(F.image (Subtype.val : ↑(⋃₀ c) → k)) ⊆ ⋃₀ c := by
    intro y hy
    simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe, Subtype.exists] at hy
    obtain ⟨x, hx, -, rfl⟩ := hy
    exact hx
  obtain ⟨t, htc, hFt⟩ := hch.directedOn.exists_mem_subset_of_finite_of_subset_sUnion hcne
    (Finset.finite_toSet _) hsub
  let f : F → t := fun x ↦ ⟨x.1.1, hFt (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ x.2))⟩
  have hf : Function.Injective f := fun x y hxy ↦
    Subtype.ext (Subtype.ext (congrArg (Subtype.val : t → k) hxy))
  have hcomp : (((↑) : t → k) ∘ f) = fun x : F ↦ (x.1 : k) := rfl
  rw [← hcomp]
  exact (hc t htc).comp hf

end ExpCharField

section FieldTheory

variable {p : ℕ} [Fact p.Prime] {k : Type*} [Field k] [ExpChar k p] {ι ι' : Type*}

/-- A family `b : ι → k` in a field `k` of prime characteristic `p` is a **`p`-basis** of `k`
when its `p`-monomials `∏ i, b i ^ (e i : ℕ)` (`e : ι →₀ Fin p`) form a basis of `k` over the
subfield `k ^ p` of `p`-th powers. -/
def IsPBasis (p : ℕ) [Fact p.Prime] {k : Type*} [Field k] [ExpChar k p] {ι : Type*}
    (b : ι → k) : Prop :=
  IsPIndependent p b ∧
    Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b)) = ⊤

/-- Unfolding `IsPBasis` as `p`-independence together with spanning of the `p`-monomials. -/
theorem isPBasis_iff (b : ι → k) :
    IsPBasis p b ↔
      IsPIndependent p b ∧
        Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b)) = ⊤ :=
  Iff.rfl

/-- Every `p`-basis is `p`-independent. -/
theorem IsPBasis.isPIndependent {b : ι → k} (hb : IsPBasis p b) : IsPIndependent p b :=
  hb.1

/-- The `p`-monomials of a `p`-basis span `k` over `k ^ p`. -/
theorem IsPBasis.span_pMonomial_eq_top {b : ι → k} (hb : IsPBasis p b) :
    Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b)) = ⊤ :=
  hb.2

private theorem mul_mem_span_range_pMonomial (b : ι → k) {x y : k}
    (hx : x ∈ Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b)))
    (hy : y ∈ Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b))) :
    x * y ∈ Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b)) := by
  induction hx using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨e, rfl⟩ := hu
    induction hy using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨f, rfl⟩ := hv
      obtain ⟨c, hc⟩ := exists_mul_pMonomial_eq_pow_mul_pMonomial_add p b e f
      rw [hc]
      exact Submodule.smul_mem _ (⟨c ^ p, c, frobenius_def ..⟩ : (frobenius k p).fieldRange)
        (Submodule.subset_span ⟨e + f, rfl⟩)
    | zero => simp
    | add v w _ _ hv hw => rw [mul_add]; exact Submodule.add_mem _ hv hw
    | smul a v _ hv => rw [Algebra.mul_smul_comm]; exact Submodule.smul_mem _ a hv
  | zero => simp
  | add u w _ _ hu hw => rw [add_mul]; exact Submodule.add_mem _ hu hw
  | smul a u _ hu => rw [Algebra.smul_mul_assoc]; exact Submodule.smul_mem _ a hu

/-- The `k ^ p`-linear span of the `p`-monomials in `b` coincides with the intermediate field
generated by `range b` over `k ^ p`. -/
theorem span_range_pMonomial_eq_adjoin (b : ι → k) :
    Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b)) =
      (IntermediateField.adjoin (frobenius k p).fieldRange
        (Set.range b)).toSubalgebra.toSubmodule := by
  set S : Submodule (frobenius k p).fieldRange k :=
    Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b))
  have hone : (1 : k) ∈ S := Submodule.subset_span ⟨0, pMonomial_zero p b⟩
  let A : Subalgebra (frobenius k p).fieldRange k :=
    { carrier := S
      zero_mem' := S.zero_mem
      add_mem' := S.add_mem
      one_mem' := hone
      mul_mem' := mul_mem_span_range_pMonomial b
      algebraMap_mem' := fun c ↦ by simpa [Algebra.smul_def] using S.smul_mem c hone }
  have hA : A.IsAlgebraic := fun x _ ↦ by
    have hxp : IsIntegral (frobenius k p).fieldRange (x ^ p) :=
      isIntegral_algebraMap (x := (⟨x ^ p, x, frobenius_def ..⟩ : (frobenius k p).fieldRange))
    exact (IsIntegral.of_pow (Fact.out : p.Prime).pos hxp).isAlgebraic
  let L : IntermediateField (frobenius k p).fieldRange k := hA.toIntermediateField
  refine le_antisymm ?_ ?_
  · rw [Submodule.span_le]
    rintro _ ⟨e, rfl⟩
    rw [SetLike.mem_coe, Subalgebra.mem_toSubmodule, IntermediateField.mem_toSubalgebra,
      pMonomial_def]
    exact prod_mem fun i _ ↦
      pow_mem (IntermediateField.subset_adjoin (frobenius k p).fieldRange (Set.range b) ⟨i, rfl⟩) _
  · have hle : IntermediateField.adjoin (frobenius k p).fieldRange (Set.range b) ≤ L := by
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      -- `L.toSubalgebra` is `A`, whose underlying submodule is `S`.
      rw [SetLike.mem_coe, ← IntermediateField.mem_toSubalgebra, ← Subalgebra.mem_toSubmodule]
      exact Submodule.subset_span ⟨Finsupp.single i ⟨1, (Fact.out : p.Prime).one_lt⟩,
        pMonomial_single_one p (Fact.out : p.Prime).one_lt b i⟩
    -- `L.toSubalgebra.toSubmodule` reduces definitionally to `A.toSubmodule = S`.
    exact hle

/-- The `p`-monomials of `b` span `k` over `k ^ p` iff `b` generates `k` as a field over `k ^ p`. -/
theorem span_range_pMonomial_eq_top_iff (b : ι → k) :
    Submodule.span (frobenius k p).fieldRange (Set.range (pMonomial p b)) = ⊤ ↔
      IntermediateField.adjoin (frobenius k p).fieldRange (Set.range b) = ⊤ := by
  rw [span_range_pMonomial_eq_adjoin, eq_top_iff, eq_top_iff]
  simp only [IsConcreteLE.le_iff, Subalgebra.mem_toSubmodule, IntermediateField.mem_toSubalgebra,
    Submodule.mem_top, IntermediateField.mem_top]

/-- A `p`-basis generates `k` as a field over `k ^ p`. -/
theorem IsPBasis.adjoin_eq_top {b : ι → k} (hb : IsPBasis p b) :
    IntermediateField.adjoin (frobenius k p).fieldRange (Set.range b) = ⊤ :=
  (span_range_pMonomial_eq_top_iff b).mp hb.2

/-- For a finite index type, `IsPBasis` means the `p`-monomials indexed by `ι → Fin p` are linearly
independent and span `k` over `k ^ p`. -/
theorem isPBasis_iff_fintype [Fintype ι] (b : ι → k) :
    IsPBasis p b ↔
      LinearIndependent (frobenius k p).fieldRange (fun e : ι → Fin p ↦ ∏ i, b i ^ (e i : ℕ)) ∧
        Submodule.span (frobenius k p).fieldRange
          (Set.range fun e : ι → Fin p ↦ ∏ i, b i ^ (e i : ℕ)) = ⊤ := by
  rw [IsPBasis, isPIndependent_iff_fintype]
  have hrange :
      Set.range (pMonomial p b) = Set.range (fun e : ι → Fin p ↦ ∏ i, b i ^ (e i : ℕ)) := by
    ext x
    constructor
    · rintro ⟨e, rfl⟩
      exact ⟨Finsupp.equivFunOnFinite e, (pMonomial_eq_fintype_prod p b e).symm⟩
    · rintro ⟨e, rfl⟩
      exact ⟨Finsupp.equivFunOnFinite.symm e,
        by simpa using pMonomial_eq_fintype_prod p b (Finsupp.equivFunOnFinite.symm e)⟩
  rw [hrange]

/-- Every element of a `p`-independent family is nonzero. -/
theorem IsPIndependent.ne_zero {b : ι → k} (hb : IsPIndependent p b) (i : ι) : b i ≠ 0 := by
  have h := hb.linearIndependent.ne_zero
    (Finsupp.single i (⟨1, (Fact.out : p.Prime).one_lt⟩ : Fin p))
  rwa [pMonomial_single_one p (Fact.out : p.Prime).one_lt] at h

/-- A `p`-independent family is injective. -/
theorem IsPIndependent.injective {b : ι → k} (hb : IsPIndependent p b) : Function.Injective b := by
  intro i j hij
  have h1 : pMonomial p b (Finsupp.single i ⟨1, (Fact.out : p.Prime).one_lt⟩) =
      pMonomial p b (Finsupp.single j ⟨1, (Fact.out : p.Prime).one_lt⟩) := by
    simp [hij]
  have hne : (⟨1, (Fact.out : p.Prime).one_lt⟩ : Fin p) ≠ 0 :=
    mt (congrArg Fin.val) one_ne_zero
  exact Finsupp.single_left_injective hne (hb.linearIndependent.injective h1)

private theorem notMem_adjoin_of_isPIndependent_option {b : ι → k} {x : k}
    (hopt : IsPIndependent p (Option.elim' x b)) :
    x ∉ IntermediateField.adjoin (frobenius k p).fieldRange (Set.range b) := by
  intro hx
  rw [← IntermediateField.mem_toSubalgebra, ← Subalgebra.mem_toSubmodule,
    ← span_range_pMonomial_eq_adjoin] at hx
  have hmem :
      pMonomial p (Option.elim' x b) (Finsupp.single none ⟨1, (Fact.out : p.Prime).one_lt⟩) ∈
        Submodule.span (frobenius k p).fieldRange
          (pMonomial p (Option.elim' x b) '' {e | e none = 0}) := by
    rw [pMonomial_single_one p (Fact.out : p.Prime).one_lt]
    refine Submodule.span_mono ?_ hx
    rintro _ ⟨e, rfl⟩
    refine ⟨e.mapDomain Option.some, Finsupp.mapDomain_of_notMem_range _ none (by simp), ?_⟩
    exact (pMonomial_comp_of_injective p (Option.elim' x b) (Option.some_injective ι) e).symm
  have hnotmem :
      Finsupp.single (none : Option ι) (⟨1, (Fact.out : p.Prime).one_lt⟩ : Fin p) ∉
        {e : Option ι →₀ Fin p | e none = 0} := by
    simp only [Set.mem_ofPred_eq, Finsupp.single_eq_same, Fin.ext_iff, Fin.val_zero, one_ne_zero,
      not_false_eq_true]
  exact hopt.linearIndependent.notMem_span_image hnotmem hmem

private theorem isPIndependent_option_of_notMem_adjoin {b : ι → k} (hb : IsPIndependent p b)
    {x : k} (hx : x ∉ IntermediateField.adjoin (frobenius k p).fieldRange (Set.range b)) :
    IsPIndependent p (Option.elim' x b) := by
  let E := IntermediateField.adjoin (frobenius k p).fieldRange (Set.range b)
  have hx' : x ∉ E.toSubfield := hx
  have hxp : x ^ p ∈ E.toSubfield :=
    E.algebraMap_mem (⟨x ^ p, x, frobenius_def ..⟩ : (frobenius k p).fieldRange)
  have hpow_sub : LinearIndependent E.toSubfield (fun n : Fin p ↦ x ^ (n : ℕ)) :=
    linearIndependent_pow_of_notMem_subfield hx' hxp
  have hpow : LinearIndependent E (fun n : Fin p ↦ x ^ (n : ℕ)) := by
    rw [linearIndependent_iff']
    intro s c hc n hn
    have hc' : ∑ m ∈ s, (⟨(c m : k), (c m).2⟩ : E.toSubfield) • x ^ (m : ℕ) = 0 := by
      simpa only [Subfield.smul_def, IntermediateField.smul_def] using hc
    have h0 := linearIndependent_iff'.mp hpow_sub s (fun m ↦ ⟨c m, (c m).2⟩) hc' n hn
    exact Subtype.ext (congrArg Subtype.val h0)
  have hm_mem : ∀ e : ι →₀ Fin p, pMonomial p b e ∈ E := fun e ↦ by
    rw [← IntermediateField.mem_toSubalgebra, ← Subalgebra.mem_toSubmodule,
      ← span_range_pMonomial_eq_adjoin]
    exact Submodule.subset_span ⟨e, rfl⟩
  let m : (ι →₀ Fin p) → E := fun e ↦ ⟨pMonomial p b e, hm_mem e⟩
  have hm_lin : LinearIndependent (frobenius k p).fieldRange m :=
    LinearIndependent.of_comp (IsScalarTower.toAlgHom (frobenius k p).fieldRange E k).toLinearMap
      hb.linearIndependent
  have hprod := linearIndependent_smul hm_lin hpow
  let eEquiv : (Option ι →₀ Fin p) ≃ (ι →₀ Fin p) × Fin p :=
    Finsupp.optionEquiv.trans (Equiv.prodComm _ _)
  have hcomp :
      (fun q : (ι →₀ Fin p) × Fin p ↦ m q.1 • x ^ (q.2 : ℕ)) ∘ eEquiv =
        pMonomial p (Option.elim' x b) := by
    ext f
    rw [Function.comp_apply, Algebra.smul_def]
    exact (mul_comm (pMonomial p b f.some) (x ^ (f none : ℕ))).trans
      (pMonomial_option_elim p x b f).symm
  rw [IsPIndependent, ← hcomp]
  exact (linearIndependent_equiv eEquiv).mpr hprod

/-- Adjoining `x` to a `p`-independent family `b` preserves `p`-independence iff `x` does not lie
in the intermediate field `k ^ p(range b)`. -/
theorem isPIndependent_option_iff {b : ι → k} (hb : IsPIndependent p b) (x : k) :
    IsPIndependent p (Option.elim' x b) ↔
      x ∉ IntermediateField.adjoin (frobenius k p).fieldRange (Set.range b) :=
  ⟨notMem_adjoin_of_isPIndependent_option, isPIndependent_option_of_notMem_adjoin hb⟩

/-- Adjoining `x ∉ s` to a `p`-independent set `s` preserves `p`-independence iff `x ∉ k ^ p(s)`. -/
theorem isPIndependent_insert_iff {s : Set k} (hs : IsPIndependent p ((↑) : s → k))
    {x : k} (hx : x ∉ s) :
    IsPIndependent p ((↑) : ↑(insert x s) → k) ↔
      x ∉ IntermediateField.adjoin (frobenius k p).fieldRange s := by
  classical
  let e : Option s ≃ ↑(insert x s) :=
    (Equiv.optionEquivSumPUnit s).trans (Equiv.Set.insert hx).symm
  have hcomp : (((↑) : ↑(insert x s) → k) ∘ e) = Option.elim' x ((↑) : s → k) := by
    ext o
    cases o <;> simp [e]
  rw [← isPIndependent_equiv ((↑) : ↑(insert x s) → k) e, hcomp,
    isPIndependent_option_iff hs x, Subtype.range_coe]

/-- A non-`p`-independent family has some member lying in the intermediate field over `k ^ p`
generated by the remaining members. -/
theorem exists_mem_adjoin_image_compl_singleton_of_not_isPIndependent {b : ι → k}
    (hb : ¬ IsPIndependent p b) :
    ∃ i : ι, b i ∈ IntermediateField.adjoin (frobenius k p).fieldRange (b '' ({i}ᶜ : Set ι)) := by
  classical
  have hex : ∃ n : ℕ, ∃ s : Finset ι, s.card = n ∧ ¬ IsPIndependent p (fun i : s ↦ b i) := by
    rw [isPIndependent_iff_finset] at hb
    push Not at hb
    obtain ⟨s, hs⟩ := hb
    exact ⟨s.card, s, rfl, hs⟩
  obtain ⟨s, hscard, hs⟩ := Nat.find_spec hex
  have hne : s.Nonempty := by
    by_contra hempty
    rw [Finset.not_nonempty_iff_eq_empty] at hempty
    subst hempty
    exact hs (isPIndependent_empty _)
  obtain ⟨i, hi⟩ := hne
  let s' : Finset ι := s.erase i
  have hs' : IsPIndependent p (fun j : s' ↦ b j) := by
    by_contra hnot
    have hlt : s'.card < Nat.find hex := hscard ▸ Finset.card_erase_lt_of_mem hi
    exact Nat.find_min hex hlt ⟨s', rfl, hnot⟩
  have hnot : i ∉ (s' : Set ι) := Finset.notMem_erase i s
  let e : Option s' ≃ s :=
    (Equiv.optionEquivSumPUnit s').trans
      ((Equiv.Set.insert hnot).symm.trans (Equiv.subtypeEquivRight fun j ↦ by simp [s', hi]))
  have hcomp : (fun j : s ↦ b j) ∘ e = Option.elim' (b i) (fun j : s' ↦ b j) := by
    ext o
    cases o with
    | none =>
      have hinr := Equiv.Set.insert_symm_apply_inr hnot PUnit.unit
      simp only [e, Function.comp_apply, Equiv.trans_apply, Equiv.optionEquivSumPUnit_none,
        Equiv.subtypeEquivRight_apply, Option.elim'_none]
      rw [hinr]
    | some j =>
      have hinl := Equiv.Set.insert_symm_apply_inl hnot j
      simp only [e, Function.comp_apply, Equiv.trans_apply, Equiv.optionEquivSumPUnit_some,
        Equiv.subtypeEquivRight_apply, Option.elim'_some]
      rw [hinl]
  have hmem : b i ∈ IntermediateField.adjoin (frobenius k p).fieldRange
      (Set.range fun j : s' ↦ b j) := by
    by_contra hnotmem
    have hopt := (isPIndependent_option_iff hs' (b i)).mpr hnotmem
    rw [← hcomp, isPIndependent_equiv] at hopt
    exact hs hopt
  refine ⟨i, IntermediateField.adjoin.mono _ _ _ ?_ hmem⟩
  rintro _ ⟨⟨j, hj⟩, rfl⟩
  exact ⟨j, Finset.ne_of_mem_erase hj, rfl⟩

/-- Every `p`-independent subset of a field of prime characteristic `p` extends to a `p`-basis. -/
theorem exists_isPBasis_of_isPIndependent {s : Set k} (hs : IsPIndependent p ((↑) : s → k)) :
    ∃ t : Set k, s ⊆ t ∧ IsPBasis p ((↑) : t → k) := by
  let P : Set (Set k) := {t | IsPIndependent p ((↑) : t → k)}
  have hchain : ∀ c ⊆ P, IsChain (· ⊆ ·) c → c.Nonempty → ∃ ub ∈ P, ∀ t ∈ c, t ⊆ ub :=
    fun c hcP hch hcne ↦
      ⟨⋃₀ c, isPIndependent_sUnion_of_chain hcP hch hcne, fun _ ht ↦ Set.subset_sUnion_of_mem ht⟩
  obtain ⟨t, hst, htmax⟩ := zorn_subset_nonempty P hchain s hs
  refine ⟨t, hst, htmax.prop, ?_⟩
  rw [span_range_pMonomial_eq_top_iff, eq_top_iff]
  intro x _
  by_contra hx
  have hxt : x ∉ t := fun h ↦
    hx (IntermediateField.subset_adjoin _ _ ⟨⟨x, h⟩, rfl⟩)
  have hins : insert x t ∈ P :=
    (isPIndependent_insert_iff htmax.prop hxt).mpr (by simpa using hx)
  have hsub : insert x t ⊆ t := htmax.le_of_ge hins (Set.subset_insert x t)
  exact hxt (hsub (Set.mem_insert x t))

/-- Every field of prime characteristic `p` admits a (possibly infinite) `p`-basis. -/
theorem exists_isPBasis (p : ℕ) [Fact p.Prime] (k : Type*) [Field k] [ExpChar k p] :
    ∃ t : Set k, IsPBasis p ((↑) : t → k) := by
  obtain ⟨t, -, ht⟩ := exists_isPBasis_of_isPIndependent (p := p) (s := (∅ : Set k))
    (isPIndependent_empty _)
  exact ⟨t, ht⟩

/-- A `p`-basis is invariant under reindexing by an equivalence. -/
theorem isPBasis_equiv (b : ι → k) (e : ι' ≃ ι) : IsPBasis p (b ∘ e) ↔ IsPBasis p b := by
  rw [IsPBasis, IsPBasis, isPIndependent_equiv, span_range_pMonomial_eq_top_iff,
    span_range_pMonomial_eq_top_iff, Set.range_comp, e.range_eq_univ, Set.image_univ]

/-- The `k ^ p`-basis of `k` formed by the `p`-monomials of a `p`-basis `b`. -/
noncomputable def IsPBasis.basis {b : ι → k} (hb : IsPBasis p b) :
    Module.Basis (ι →₀ Fin p) (frobenius k p).fieldRange k :=
  Module.Basis.mk hb.1.linearIndependent hb.2.ge

/-- Evaluating `IsPBasis.basis` at an exponent `e` gives the `p`-monomial `pMonomial p b e`. -/
@[simp]
theorem IsPBasis.basis_apply {b : ι → k} (hb : IsPBasis p b) (e : ι →₀ Fin p) :
    hb.basis e = pMonomial p b e := by
  rw [IsPBasis.basis, Module.Basis.coe_mk]

/-- For a finite `p`-basis `b`, the `k ^ p`-basis of `k` indexed by `ι → Fin p`. -/
noncomputable def IsPBasis.fintypeBasis [Fintype ι] {b : ι → k} (hb : IsPBasis p b) :
    Module.Basis (ι → Fin p) (frobenius k p).fieldRange k :=
  hb.basis.reindex Finsupp.equivFunOnFinite

/-- Evaluating `IsPBasis.fintypeBasis` at `e : ι → Fin p` gives `∏ i, b i ^ (e i : ℕ)`. -/
@[simp]
theorem IsPBasis.fintypeBasis_apply [Fintype ι] {b : ι → k} (hb : IsPBasis p b) (e : ι → Fin p) :
    hb.fintypeBasis e = ∏ i, b i ^ (e i : ℕ) := by
  simpa [IsPBasis.fintypeBasis] using
    pMonomial_eq_fintype_prod p b (Finsupp.equivFunOnFinite.symm e)

/-- A `p`-basis is finite if and only if `k` is finite-dimensional over `k ^ p`. -/
theorem IsPBasis.finite_iff_finiteDimensional {b : ι → k} (hb : IsPBasis p b) :
    Finite ι ↔ FiniteDimensional (frobenius k p).fieldRange k := by
  constructor
  · intro hfin
    have : Fintype ι := Fintype.ofFinite ι
    exact Module.Finite.of_basis hb.fintypeBasis
  · intro hfd
    have : Fintype (ι →₀ Fin p) := FiniteDimensional.fintypeBasisIndex hb.basis
    have hne : (⟨1, (Fact.out : p.Prime).one_lt⟩ : Fin p) ≠ 0 :=
      mt (congrArg Fin.val) one_ne_zero
    exact Finite.of_injective
      (fun i : ι ↦ Finsupp.single i (⟨1, (Fact.out : p.Prime).one_lt⟩ : Fin p))
      (Finsupp.single_left_injective hne)

/-- If `b : ι → k` is a finite `p`-basis, then `[k : k ^ p] = p ^ Nat.card ι`. -/
theorem IsPBasis.finrank_fieldRange_frobenius [Finite ι] {b : ι → k} (hb : IsPBasis p b) :
    Module.finrank (frobenius k p).fieldRange k = p ^ Nat.card ι := by
  classical
  have : Fintype ι := Fintype.ofFinite ι
  rw [Module.finrank_eq_card_basis hb.fintypeBasis, Fintype.card_fun, Fintype.card_fin,
    Nat.card_eq_fintype_card]

/-- The empty family is a `p`-basis of `k` if and only if `k` is a perfect ring of
characteristic `p`. -/
theorem isPBasis_empty_iff_perfectRing [IsEmpty ι] (b : ι → k) :
    IsPBasis p b ↔ PerfectRing k p := by
  rw [IsPBasis, and_iff_right (isPIndependent_empty b)]
  have hrange : Set.range (pMonomial p b) = {1} := by
    ext x
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨e, rfl⟩
      rw [Subsingleton.elim e 0, pMonomial_zero]
    · rintro rfl
      exact ⟨0, pMonomial_zero p b⟩
  rw [hrange, Submodule.eq_top_iff']
  constructor
  · intro h
    refine PerfectRing.ofSurjective k p fun x ↦ ?_
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (h x)
    obtain ⟨a, ha⟩ := c.2
    rw [Subfield.smul_def, smul_eq_mul, mul_one] at hc
    exact ⟨a, ha.trans hc⟩
  · intro _ x
    obtain ⟨a, ha⟩ := surjective_frobenius k p x
    refine Submodule.mem_span_singleton.mpr ⟨⟨x, a, ha⟩, ?_⟩
    rw [Subfield.smul_def, smul_eq_mul, mul_one]

