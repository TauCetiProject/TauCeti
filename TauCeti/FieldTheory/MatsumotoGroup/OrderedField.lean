public import TauCeti.FieldTheory.MatsumotoGroup.Basic

/-!
# The sign symbol on the Matsumoto group of an ordered field

Let `F` be a linearly ordered field, such as `ℝ`. Write `ε a ∈ ZMod 2` for `1` if the unit `a`
is negative and `0` if it is positive. The pairing `(a, b) ↦ ε a * ε b` is biadditive, and it
satisfies the Steinberg relation, since two units adding up to one cannot both be negative. So it
descends to a homomorphism `sign` from the Matsumoto group `(Fˣ ⊗ Fˣ) / ⟨x ⊗ y : x + y = 1⟩`
to `ZMod 2`. It sends `{x, y}` to `1` exactly when both entries are negative.

The sign map detects the symbol `{-1, -1}`: this symbol has order exactly two. In particular,
the Matsumoto group is not the exterior square of `Fˣ`. Let `D` be the subgroup spanned by the
symbols with at least one positive entry. Then

* `D` is exactly the kernel of `sign`;
* every class is uniquely `ε • {-1, -1} + d` with `ε ∈ ZMod 2` and `d ∈ D`, which gives a
  splitting `MatsumotoGroup F ≃ₗ[ℤ] ZMod 2 × D`;
* if `F` is real closed, for instance `F = ℝ`, then `D` is divisible. A positive entry is an
  `m`-th power of a positive element for every `m ≠ 0`.

Through Matsumoto's theorem, this is the degree-two case of Milnor's computation of the Milnor
K-groups of `ℝ`: they are `ℤ/2`, generated by `{-1, …, -1}`, plus a divisible group.

## Main definitions

* `TauCeti.MatsumotoGroup.unitSign`: the sign `ε : Fˣ → ZMod 2` of a unit, as an additive map.
* `TauCeti.MatsumotoGroup.signPairing`: the Steinberg pairing `(a, b) ↦ ε a * ε b`.
* `TauCeti.MatsumotoGroup.sign`: the induced homomorphism `MatsumotoGroup F →+ ZMod 2`.
* `TauCeti.MatsumotoGroup.positiveEntrySpan`: the span `D` of the symbols with a positive
  entry.
* `TauCeti.MatsumotoGroup.positiveEntryEquiv`: the splitting
  `MatsumotoGroup F ≃ₗ[ℤ] ZMod 2 × positiveEntrySpan F`.

## Main results

* `TauCeti.MatsumotoGroup.sign_symbol`: `sign {x, y} = 1` exactly when `x < 0` and `y < 0`.
* `TauCeti.MatsumotoGroup.symbol_neg_one_neg_one_ne_zero`: `{-1, -1} ≠ 0`.
* `TauCeti.MatsumotoGroup.addOrderOf_symbol_neg_one_neg_one`: `{-1, -1}` has order two.
* `TauCeti.MatsumotoGroup.sign_eq_zero_iff`: the kernel of `sign` is `positiveEntrySpan F`.
* `TauCeti.MatsumotoGroup.surjective_nsmul_positiveEntrySpan`: over a real closed field,
  multiplication by every `m ≠ 0` is surjective on `positiveEntrySpan F`.

## References

* J. Milnor, *Algebraic K-theory and quadratic forms*, Invent. Math. 9 (1970), §1.
* C. Weibel, *The K-book*, Example III.6.2.1 and Example III.7.2(c).
-/

public section

namespace TauCeti

namespace MatsumotoGroup

variable {F : Type*} [Field F] [LinearOrder F] [IsStrictOrderedRing F]

variable (F) in
/-- The sign of a unit of an ordered field as an element of `ZMod 2`: `1` on negative units and
`0` on positive units. It is additive on `Additive Fˣ`, since the product of two units is
negative exactly when one of them is. -/
def unitSign : Additive Fˣ →+ ZMod 2 :=
  AddMonoidHom.mk' (fun a ↦ if ((Additive.toMul a : Fˣ) : F) < 0 then 1 else 0) fun a b ↦ by
    have ha := (Additive.toMul a).ne_zero
    have hb := (Additive.toMul b).ne_zero
    rcases ha.lt_or_gt with ha | ha <;> rcases hb.lt_or_gt with hb | hb
    · simp [ha, hb, (mul_pos_of_neg_of_neg ha hb).not_gt, CharTwo.add_self_eq_zero]
    · simp [ha, hb.not_gt, mul_neg_of_neg_of_pos ha hb]
    · simp [ha.not_gt, hb, mul_neg_of_pos_of_neg ha hb]
    · simp [ha.not_gt, hb.not_gt, (mul_pos ha hb).not_gt]

@[simp]
theorem unitSign_ofMul (x : Fˣ) :
    unitSign F (Additive.ofMul x) = if (x : F) < 0 then 1 else 0 :=
  (rfl)

theorem unitSign_ofMul_of_neg {x : Fˣ} (hx : (x : F) < 0) :
    unitSign F (Additive.ofMul x) = 1 := by
  simp [hx]

theorem unitSign_ofMul_of_pos {x : Fˣ} (hx : 0 < (x : F)) :
    unitSign F (Additive.ofMul x) = 0 := by
  simp [hx.not_gt]

variable (F) in
/-- The **sign pairing** `(a, b) ↦ ε a * ε b` on the units of an ordered field, with values in
`ZMod 2`. It is `1` exactly when both units are negative. -/
def signPairing : Additive Fˣ →+ Additive Fˣ →+ ZMod 2 :=
  (AddMonoidHom.mul.comp (unitSign F)).compl₂ (unitSign F)

theorem signPairing_apply (a b : Additive Fˣ) :
    signPairing F a b = unitSign F a * unitSign F b :=
  (rfl)

@[simp]
theorem signPairing_ofMul (x y : Fˣ) :
    signPairing F (Additive.ofMul x) (Additive.ofMul y) =
      if (x : F) < 0 ∧ (y : F) < 0 then 1 else 0 := by
  rw [signPairing_apply, unitSign_ofMul, unitSign_ofMul]
  split_ifs <;> simp_all

/-- **The sign pairing satisfies the Steinberg relation**: two units adding up to one are not
both negative. -/
theorem signPairing_of_add_eq_one {x y : Fˣ} (h : (x : F) + y = 1) :
    signPairing F (Additive.ofMul x) (Additive.ofMul y) = 0 := by
  rw [signPairing_ofMul, ite_eq_right_iff]
  rintro ⟨hx, hy⟩
  exact (by linarith : False).elim

variable (F) in
/-- The **sign map** of the Matsumoto group of an ordered field, induced by the sign pairing:
it sends `{x, y}` to `1` if `x` and `y` are both negative, and to `0` otherwise. -/
def sign : MatsumotoGroup F →+ ZMod 2 :=
  lift (signPairing F) fun _ _ ↦ signPairing_of_add_eq_one

/-- The value of the sign map on a symbol is the sign pairing. -/
theorem sign_symbol_eq_signPairing (x y : Fˣ) :
    sign F (symbol x y) = signPairing F (Additive.ofMul x) (Additive.ofMul y) :=
  lift_symbol _ _ x y

@[simp]
theorem sign_symbol (x y : Fˣ) :
    sign F (symbol x y) = if (x : F) < 0 ∧ (y : F) < 0 then 1 else 0 := by
  rw [sign_symbol_eq_signPairing, signPairing_ofMul]

theorem sign_symbol_of_pos_left {x : Fˣ} (hx : 0 < (x : F)) (y : Fˣ) :
    sign F (symbol x y) = 0 := by
  simp [hx.not_gt]

theorem sign_symbol_of_pos_right (x : Fˣ) {y : Fˣ} (hy : 0 < (y : F)) :
    sign F (symbol x y) = 0 := by
  simp [hy.not_gt]

theorem sign_symbol_of_neg_of_neg {x y : Fˣ} (hx : (x : F) < 0) (hy : (y : F) < 0) :
    sign F (symbol x y) = 1 := by
  simp [hx, hy]

theorem sign_symbol_neg_one_neg_one : sign F (symbol (-1 : Fˣ) (-1)) = 1 :=
  sign_symbol_of_neg_of_neg (by simp) (by simp)

/-- **The symbol `{-1, -1}` is nonzero** in the Matsumoto group of an ordered field: the sign map
sends it to `1`. -/
theorem symbol_neg_one_neg_one_ne_zero : symbol (-1 : Fˣ) (-1) ≠ 0 := fun h ↦ by
  simpa [h] using sign_symbol_neg_one_neg_one (F := F)

/-- **The symbol `{-1, -1}` has order exactly two** in the Matsumoto group of an ordered field. -/
theorem addOrderOf_symbol_neg_one_neg_one : addOrderOf (symbol (-1 : Fˣ) (-1)) = 2 := by
  have := Fact.mk Nat.prime_two
  exact addOrderOf_eq_prime (two_nsmul_symbol_neg_one _) symbol_neg_one_neg_one_ne_zero

variable (F) in
/-- The subgroup of the Matsumoto group of an ordered field spanned by the symbols `{x, y}` with
at least one positive entry. It is the kernel of the sign map (`sign_eq_zero_iff`), and it is
divisible when `F` is real closed (`surjective_nsmul_positiveEntrySpan`). -/
def positiveEntrySpan : Submodule ℤ (MatsumotoGroup F) :=
  Submodule.span ℤ {q | ∃ x y : Fˣ, (0 < (x : F) ∨ 0 < (y : F)) ∧ q = symbol x y}

omit [IsStrictOrderedRing F] in
theorem symbol_mem_positiveEntrySpan {x y : Fˣ} (h : 0 < (x : F) ∨ 0 < (y : F)) :
    symbol x y ∈ positiveEntrySpan F :=
  Submodule.subset_span ⟨x, y, h, rfl⟩

omit [IsStrictOrderedRing F] in
theorem symbol_mem_positiveEntrySpan_of_pos_left {x : Fˣ} (hx : 0 < (x : F)) (y : Fˣ) :
    symbol x y ∈ positiveEntrySpan F :=
  symbol_mem_positiveEntrySpan (.inl hx)

omit [IsStrictOrderedRing F] in
theorem symbol_mem_positiveEntrySpan_of_pos_right (x : Fˣ) {y : Fˣ} (hy : 0 < (y : F)) :
    symbol x y ∈ positiveEntrySpan F :=
  symbol_mem_positiveEntrySpan (.inr hy)

/-- The sign map vanishes on the positive-entry span. -/
theorem sign_eq_zero_of_mem_positiveEntrySpan {q : MatsumotoGroup F}
    (hq : q ∈ positiveEntrySpan F) : sign F q = 0 := by
  induction hq using Submodule.span_induction with
  | mem q hq =>
    obtain ⟨x, y, h, rfl⟩ := hq
    rcases h with h | h
    · exact sign_symbol_of_pos_left h y
    · exact sign_symbol_of_pos_right x h
  | zero => exact map_zero _
  | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
  | smul n a _ ha => rw [map_zsmul, ha, smul_zero]

theorem symbol_neg_one_neg_one_notMem_positiveEntrySpan :
    symbol (-1 : Fˣ) (-1) ∉ positiveEntrySpan F := fun h ↦ by
  simpa using sign_eq_zero_of_mem_positiveEntrySpan h

/-- Every symbol is congruent modulo the positive-entry span to the multiple of `{-1, -1}` given
by its sign. -/
theorem symbol_sub_sign_smul_mem_positiveEntrySpan (x y : Fˣ) :
    symbol x y - (sign F (symbol x y)).val • symbol (-1 : Fˣ) (-1) ∈ positiveEntrySpan F := by
  rcases x.ne_zero.lt_or_gt with hx | hx
  · rcases y.ne_zero.lt_or_gt with hy | hy
    · -- Write `x = (-1) * (-x)` and `y = (-1) * (-y)`. Expanding `{x, y}` leaves `{-1, -1}`
      -- together with three symbols having the positive entry `-x` or `-y`.
      have hx' : 0 < ((-x : Fˣ) : F) := by simpa using hx
      have hy' : 0 < ((-y : Fˣ) : F) := by simpa using hy
      have hsym : symbol x y = symbol (-1) (-1) + symbol (-1) (-y) +
          (symbol (-x) (-1) + symbol (-x) (-y)) := by
        conv_lhs => rw [← neg_neg x, ← neg_neg y, neg_eq_neg_one_mul (-x),
          neg_eq_neg_one_mul (-y)]
        simp only [symbol_mul_left, symbol_mul_right]
        abel
      have hval : (1 : ZMod 2).val = 1 := rfl
      rw [sign_symbol_of_neg_of_neg hx hy, hval, one_nsmul, hsym, add_assoc, add_sub_cancel_left]
      exact add_mem (symbol_mem_positiveEntrySpan_of_pos_right (-1) hy')
          (add_mem (symbol_mem_positiveEntrySpan_of_pos_left hx' (-1))
            (symbol_mem_positiveEntrySpan_of_pos_left hx' (-y)))
    · simpa [sign_symbol_of_pos_right x hy] using symbol_mem_positiveEntrySpan_of_pos_right x hy
  · simpa [sign_symbol_of_pos_left hx y] using symbol_mem_positiveEntrySpan_of_pos_left hx y

/-- The homomorphism `ZMod 2 →+ MatsumotoGroup F` sending `1` to `{-1, -1}`, well defined since
`{-1, -1}` has order dividing two. -/
private def signSection : ZMod 2 →+ MatsumotoGroup F :=
  ZMod.lift 2 ⟨zmultiplesHom _ (symbol (-1 : Fˣ) (-1)), by
    rw [zmultiplesHom_apply, Nat.cast_ofNat, two_zsmul, ← two_nsmul, two_nsmul_symbol_neg_one]⟩

omit [LinearOrder F] [IsStrictOrderedRing F] in
private theorem signSection_apply (ε : ZMod 2) :
    signSection (F := F) ε = ε.val • symbol (-1 : Fˣ) (-1) := by
  conv_lhs => rw [← ZMod.natCast_zmod_val ε, ← Int.cast_natCast]
  rw [signSection, ZMod.lift_coe, zmultiplesHom_apply, natCast_zsmul]

private theorem sign_signSection (ε : ZMod 2) : sign F (signSection ε) = ε := by
  rw [signSection_apply, map_nsmul, sign_symbol_neg_one_neg_one, nsmul_eq_mul, mul_one,
    ZMod.natCast_zmod_val]

/-- **The kernel of the sign map is the positive-entry span.** -/
theorem sign_eq_zero_iff {q : MatsumotoGroup F} : sign F q = 0 ↔ q ∈ positiveEntrySpan F := by
  refine ⟨fun hq ↦ ?_, sign_eq_zero_of_mem_positiveEntrySpan⟩
  -- Modulo the span, `q` is congruent to `signSection (sign q)`, which is zero here.
  suffices h : ∀ q : MatsumotoGroup F, q - signSection (sign F q) ∈ positiveEntrySpan F by
    simpa [hq] using h q
  intro q
  induction q using induction_on with
  | symbol x y => simpa [signSection_apply] using symbol_sub_sign_smul_mem_positiveEntrySpan x y
  | add a b ha hb =>
    convert add_mem ha hb using 1
    rw [map_add, map_add]
    abel

theorem ker_sign : (sign F).ker = (positiveEntrySpan F).toAddSubgroup := by
  ext q
  exact sign_eq_zero_iff

variable (F) in
/-- **The splitting of the Matsumoto group of an ordered field**: every class is uniquely
`ε • {-1, -1} + d` with `ε ∈ ZMod 2` and `d` in the positive-entry span. The first component is
the sign map. -/
def positiveEntryEquiv : MatsumotoGroup F ≃ₗ[ℤ] ZMod 2 × positiveEntrySpan F :=
  AddEquiv.toIntLinearEquiv
    { toFun q := (sign F q, ⟨q - signSection (sign F q),
        sign_eq_zero_iff.1 (by rw [map_sub, sign_signSection, sub_self])⟩)
      invFun p := signSection p.1 + (p.2 : MatsumotoGroup F)
      left_inv q := add_sub_cancel _ _
      right_inv p := by
        obtain ⟨ε, d, hd⟩ := p
        ext
        · simp [sign_signSection, sign_eq_zero_of_mem_positiveEntrySpan hd]
        · simp [sign_signSection, sign_eq_zero_of_mem_positiveEntrySpan hd]
      map_add' a b := by
        ext
        · simp
        · simp only [map_add, Prod.snd_add, Submodule.coe_add]
          abel }

@[simp]
theorem positiveEntryEquiv_apply_fst (q : MatsumotoGroup F) :
    (positiveEntryEquiv F q).1 = sign F q :=
  (rfl)

@[simp]
theorem coe_positiveEntryEquiv_apply_snd (q : MatsumotoGroup F) :
    ((positiveEntryEquiv F q).2 : MatsumotoGroup F) =
      q - (sign F q).val • symbol (-1 : Fˣ) (-1) :=
  congrArg (q - ·) (signSection_apply _)

@[simp]
theorem positiveEntryEquiv_symm_apply (ε : ZMod 2) (d : positiveEntrySpan F) :
    (positiveEntryEquiv F).symm (ε, d) = ε.val • symbol (-1 : Fˣ) (-1) + d :=
  congrArg (· + (d : MatsumotoGroup F)) (signSection_apply ε)

@[simp]
theorem positiveEntryEquiv_symbol_neg_one_neg_one :
    positiveEntryEquiv F (symbol (-1 : Fˣ) (-1)) = (1, 0) := by
  rw [← LinearEquiv.eq_symm_apply, positiveEntryEquiv_symm_apply]
  have hval : (1 : ZMod 2).val = 1 := rfl
  simp [hval]

/-- Over a real closed field, a symbol with a positive entry is an `m`-th multiple of a symbol
with a positive entry, for every `m ≠ 0`: the positive entry is the `m`-th power of a positive
element. -/
private theorem exists_mem_positiveEntrySpan_nsmul_eq_symbol [IsRealClosed F] {m : ℕ}
    (hm : m ≠ 0) {x y : Fˣ} (h : 0 < (x : F) ∨ 0 < (y : F)) :
    ∃ z ∈ positiveEntrySpan F, m • z = symbol x y := by
  -- A positive element `a` is `r ^ m`, hence also `|r| ^ m` with `|r| > 0`.
  have hroot : ∀ a : Fˣ, 0 < (a : F) → ∃ b : Fˣ, 0 < (b : F) ∧ b ^ m = a := fun a ha ↦ by
    obtain ⟨r, hr⟩ := IsRealClosed.exists_eq_pow_of_nonneg ha.le hm
    have hr0 : r ≠ 0 := by rintro rfl; simp [zero_pow hm] at hr
    refine ⟨Units.mk0 |r| (abs_ne_zero.2 hr0), abs_pos.2 hr0, Units.ext ?_⟩
    rw [Units.val_pow_eq_pow_val, Units.val_mk0, pow_abs, ← hr, abs_of_pos ha]
  rcases h with hx | hy
  · obtain ⟨b, hb, rfl⟩ := hroot x hx
    exact ⟨symbol b y, symbol_mem_positiveEntrySpan_of_pos_left hb y,
      (symbol_pow_left b y m).symm⟩
  · obtain ⟨b, hb, rfl⟩ := hroot y hy
    exact ⟨symbol x b, symbol_mem_positiveEntrySpan_of_pos_right x hb,
      (symbol_pow_right x b m).symm⟩

/-- **The positive-entry span is divisible** over a real closed field such as `ℝ`:
multiplication by every `m ≠ 0` is surjective on it. -/
theorem surjective_nsmul_positiveEntrySpan [IsRealClosed F] {m : ℕ} (hm : m ≠ 0) :
    Function.Surjective fun d : positiveEntrySpan F ↦ m • d := by
  rintro ⟨q, hq⟩
  suffices h : ∃ z ∈ positiveEntrySpan F, m • z = q by
    obtain ⟨z, hz, rfl⟩ := h
    exact ⟨⟨z, hz⟩, rfl⟩
  induction hq using Submodule.span_induction with
  | mem q hq =>
    obtain ⟨x, y, h, rfl⟩ := hq
    exact exists_mem_positiveEntrySpan_nsmul_eq_symbol hm h
  | zero => exact ⟨0, zero_mem _, smul_zero m⟩
  | add a b _ _ ha hb =>
    obtain ⟨z, hz, rfl⟩ := ha
    obtain ⟨w, hw, rfl⟩ := hb
    exact ⟨z + w, add_mem hz hw, smul_add m z w⟩
  | smul n a _ ha =>
    obtain ⟨z, hz, rfl⟩ := ha
    exact ⟨n • z, Submodule.smul_mem _ n hz, (smul_comm n m z).symm⟩

end MatsumotoGroup

end TauCeti
