/-!
# Matsumoto's presentation of `K₂`

For a commutative semiring `R`, the **Matsumoto group** (or degree-two symbol group) is the
tensor square `Additive Rˣ ⊗_ℤ Additive Rˣ` of the unit group, written additively, modulo the
submodule `TauCeti.MatsumotoGroup.steinbergRelations R` generated by the tensors `x ⊗ y` with
`(x : R) + y = 1`. The class of `x ⊗ y` is the **Steinberg symbol** `{x, y}` (`symbol x y`), so
the group is generated by symbols subject to bilinearity and the Steinberg relation
`{x, 1 - x} = 0`. Over a field `F`, Matsumoto's theorem identifies it with `K₂(F)`.

This file develops the group, its symbols, its universal property (`lift`, `liftLinear`,
`liftEquiv`), its functoriality (`map`), and the specialization to fields and finite fields
(where every symbol vanishes, so the Matsumoto group of a finite field is trivial).

## Main definitions

* `TauCeti.MatsumotoGroup R`: the quotient of `Additive Rˣ ⊗_ℤ Additive Rˣ` by
  `steinbergRelations R`.
* `TauCeti.MatsumotoGroup.symbol x y`: the Steinberg symbol `{x, y}`, the class of `x ⊗ y`.
* `TauCeti.MatsumotoGroup.lift` / `liftLinear` / `liftEquiv`: the homomorphisms induced by a
  biadditive Steinberg pairing.
* `TauCeti.MatsumotoGroup.map`: functoriality induced by a ring homomorphism.

## Main results

* `TauCeti.MatsumotoGroup.symbol_of_add_eq_one`: `{x, y} = 0` when `x + y = 1`.
* `TauCeti.MatsumotoGroup.symbol_self_neg`: `{x, -x} = 0` over a field.
* `TauCeti.MatsumotoGroup.symbol_add_symbol_swap`: `{x, y} + {y, x} = 0` over a field.
* `TauCeti.MatsumotoGroup.symbol_self`: `{x, x} = {x, -1}` over a field.
* `TauCeti.MatsumotoGroup.induction_on`: the group is generated by the symbols.
* `TauCeti.MatsumotoGroup.hom_ext` / `linearMap_ext`: homomorphisms out of the group agree when
  they agree on symbols.
* `TauCeti.MatsumotoGroup.symbol_eq_zero_of_finite`: over a finite field every symbol is zero,
  so the Matsumoto group is trivial.

## References

* H. Matsumoto, *Sur les sous-groupes arithmétiques des groupes semi-simples déployés*,
  Ann. Sci. École Norm. Sup. (4) 2 (1969).
* J. Milnor, *Introduction to Algebraic K-Theory*, §§9 and 11.
* C. Weibel, *The K-book*, Chapter III, Theorem 6.1, Corollary 6.1.1, and §7.1.
-/

public section

open scoped TensorProduct

namespace TauCeti

universe u

section Defs

variable (R : Type u) [CommSemiring R]

namespace MatsumotoGroup

/-- The `ℤ`-submodule of `Additive Rˣ ⊗[ℤ] Additive Rˣ` spanned by the Steinberg tensors
`x ⊗ y` with `(x : R) + y = 1`. -/
def steinbergRelations : Submodule ℤ (Additive Rˣ ⊗[ℤ] Additive Rˣ) :=
  Submodule.span ℤ {t | ∃ x y : Rˣ, (x : R) + y = 1 ∧
    t = Additive.ofMul x ⊗ₜ[ℤ] Additive.ofMul y}

/-- Unfolding lemma for `TauCeti.MatsumotoGroup.steinbergRelations`. -/
theorem steinbergRelations_def : steinbergRelations R = Submodule.span ℤ
    {t | ∃ x y : Rˣ, (x : R) + y = 1 ∧ t = Additive.ofMul x ⊗ₜ[ℤ] Additive.ofMul y} :=
  (rfl)

end MatsumotoGroup

/-- The group of Matsumoto's presentation of a commutative semiring `R`: the tensor square
`Additive Rˣ ⊗_ℤ Additive Rˣ` modulo the submodule generated by the `x ⊗ y` with `(x : R) + y = 1`,
that is, by the `x ⊗ (1 - x)` for `x ≠ 0, 1` over a field. -/
abbrev MatsumotoGroup : Type u :=
  (Additive Rˣ ⊗[ℤ] Additive Rˣ) ⧸ MatsumotoGroup.steinbergRelations R

end Defs

namespace MatsumotoGroup

section CommSemiring

variable {R : Type u} [CommSemiring R]

/-- The Steinberg symbol `{x, y}` in the Matsumoto group: the class of `x ⊗ y`. -/
def symbol (x y : Rˣ) : MatsumotoGroup R :=
  Submodule.Quotient.mk (Additive.ofMul x ⊗ₜ[ℤ] Additive.ofMul y)

/-- The class of a pure tensor of units is their Steinberg symbol. -/
@[simp]
theorem mk_tmul (x y : Rˣ) :
    (Submodule.Quotient.mk (Additive.ofMul x ⊗ₜ[ℤ] Additive.ofMul y) : MatsumotoGroup R) =
      symbol x y :=
  (rfl)

/-- **The Steinberg relation.** `{x, y} = 0` when `x + y = 1`. -/
theorem symbol_of_add_eq_one {x y : Rˣ} (h : (x : R) + y = 1) : symbol x y = 0 :=
  (Submodule.Quotient.mk_eq_zero _).2 (Submodule.subset_span ⟨x, y, h, rfl⟩)

/-- The canonical pairing `(x, y) ↦ symbol x y` is a Steinberg pairing. -/
theorem isSteinbergPairing_symbol : IsSteinbergPairing (symbol (R := R)) where
  map_mul_left _ _ _ := by simp only [← mk_tmul, ofMul_mul, TensorProduct.add_tmul,
    Submodule.Quotient.mk_add]
  map_mul_right _ _ _ := by simp only [← mk_tmul, ofMul_mul, TensorProduct.tmul_add,
    Submodule.Quotient.mk_add]
  steinberg _ _ h := symbol_of_add_eq_one h

@[simp]
theorem symbol_mul_left (x x' y : Rˣ) : symbol (x * x') y = symbol x y + symbol x' y :=
  isSteinbergPairing_symbol.map_mul_left x x' y

@[simp]
theorem symbol_mul_right (x y y' : Rˣ) : symbol x (y * y') = symbol x y + symbol x y' :=
  isSteinbergPairing_symbol.map_mul_right x y y'

@[simp]
theorem symbol_one_left (y : Rˣ) : symbol (1 : Rˣ) y = 0 :=
  isSteinbergPairing_symbol.map_one_left y

@[simp]
theorem symbol_one_right (x : Rˣ) : symbol x (1 : Rˣ) = 0 :=
  isSteinbergPairing_symbol.map_one_right x

@[simp]
theorem symbol_inv_left (x y : Rˣ) : symbol x⁻¹ y = -symbol x y :=
  isSteinbergPairing_symbol.map_inv_left x y

@[simp]
theorem symbol_inv_right (x y : Rˣ) : symbol x y⁻¹ = -symbol x y :=
  isSteinbergPairing_symbol.map_inv_right x y

@[simp]
theorem symbol_zpow_left (x y : Rˣ) (n : ℤ) : symbol (x ^ n) y = n • symbol x y :=
  isSteinbergPairing_symbol.map_zpow_left x y n

@[simp]
theorem symbol_zpow_right (x y : Rˣ) (n : ℤ) : symbol x (y ^ n) = n • symbol x y :=
  isSteinbergPairing_symbol.map_zpow_right x y n

@[simp]
theorem symbol_pow_left (x y : Rˣ) (n : ℕ) : symbol (x ^ n) y = n • symbol x y :=
  isSteinbergPairing_symbol.map_pow_left x y n

@[simp]
theorem symbol_pow_right (x y : Rˣ) (n : ℕ) : symbol x (y ^ n) = n • symbol x y :=
  isSteinbergPairing_symbol.map_pow_right x y n

/-- **Induction on the Matsumoto group.** The group is generated by the Steinberg symbols, so a
property that holds for every symbol and is closed under addition holds everywhere. -/
@[elab_as_elim]
theorem induction_on {P : MatsumotoGroup R → Prop} (q : MatsumotoGroup R)
    (symbol : ∀ x y : Rˣ, P (symbol x y)) (add : ∀ a b, P a → P b → P (a + b)) : P q := by
  obtain ⟨t, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  induction t using TensorProduct.inductionOn with
  | tmul a b =>
    obtain ⟨x, rfl⟩ := Additive.ofMul.surjective a
    obtain ⟨y, rfl⟩ := Additive.ofMul.surjective b
    rw [mk_tmul]
    exact symbol x y
  | add s t hs ht => exact add _ _ hs ht

/-- Additive homomorphisms out of the Matsumoto group are determined by their values on the
Steinberg symbols. -/
@[ext 1100]
theorem hom_ext {A : Type*} [AddMonoid A] {f g : MatsumotoGroup R →+ A}
    (h : ∀ x y : Rˣ, f (symbol x y) = g (symbol x y)) : f = g := by
  ext q
  induction q using induction_on with
  | symbol x y => exact h x y
  | add a b ha hb => simp only [map_add, ha, hb]

/-- `ℤ`-linear maps out of the Matsumoto group are determined by their values on the Steinberg
symbols. -/
@[ext 1100]
theorem linearMap_ext {A : Type*} [AddCommMonoid A] [Module ℤ A] {f g : MatsumotoGroup R →ₗ[ℤ] A}
    (h : ∀ x y : Rˣ, f (symbol x y) = g (symbol x y)) : f = g :=
  LinearMap.toAddMonoidHom_injective (hom_ext h)

section Universal

variable {A : Type*} [AddCommGroup A]

/-- Universal property of `MatsumotoGroup R`: a Steinberg pairing `c : Rˣ → Rˣ → A` into an
additive commutative group descends to a `ℤ`-linear map `MatsumotoGroup R →ₗ[ℤ] A`. -/
def liftLinear (c : Rˣ → Rˣ → A) (hc : IsSteinbergPairing c) : MatsumotoGroup R →ₗ[ℤ] A :=
  let bilin : Additive Rˣ →ₗ[ℤ] Additive Rˣ →ₗ[ℤ] A :=
    AddMonoidHom.toIntLinearMap
      { toFun := fun u => AddMonoidHom.toIntLinearMap
          { toFun := fun v => c (Additive.toMul u) (Additive.toMul v)
            map_zero' := hc.map_one_right _
            map_add' := fun _ _ => hc.map_mul_right _ _ _ }
        map_zero' := LinearMap.ext fun _ => hc.map_one_left _
        map_add' := fun _ _ => LinearMap.ext fun _ => hc.map_mul_left _ _ _ }
  (steinbergRelations R).liftQ (TensorProduct.lift bilin) <| by
    rw [steinbergRelations_def, Submodule.span_le]
    rintro _ ⟨a, b, hab, rfl⟩
    exact hc.steinberg a b hab

@[simp]
theorem liftLinear_symbol (c : Rˣ → Rˣ → A) (hc : IsSteinbergPairing c) (a b : Rˣ) :
    liftLinear c hc (symbol a b) = c a b := by
  rw [← mk_tmul, liftLinear]
  exact (Submodule.liftQ_apply (steinbergRelations R) _ _).trans (TensorProduct.lift.tmul _ _)

theorem liftLinear_unique (c : Rˣ → Rˣ → A) (hc : IsSteinbergPairing c)
    (f : MatsumotoGroup R →ₗ[ℤ] A) (hf : ∀ a b : Rˣ, f (symbol a b) = c a b) :
    f = liftLinear c hc :=
  linearMap_ext fun a b => (hf a b).trans (liftLinear_symbol c hc a b).symm

/-- Equivalence between Steinberg pairings `Rˣ → Rˣ → A` and `ℤ`-linear maps
`MatsumotoGroup R →ₗ[ℤ] A`. -/
def liftEquiv : {c : Rˣ → Rˣ → A // IsSteinbergPairing c} ≃ (MatsumotoGroup R →ₗ[ℤ] A) where
  toFun c := liftLinear c.val c.property
  invFun f :=
    ⟨fun a b => f (symbol a b), isSteinbergPairing_symbol.comp_addMonoidHom f.toAddMonoidHom⟩
  left_inv c := Subtype.ext (funext fun a => funext fun b => liftLinear_symbol c.val c.property a b)
  right_inv f := (liftLinear_unique _ _ f fun _ _ => rfl).symm

@[simp]
theorem liftEquiv_apply (c : {c : Rˣ → Rˣ → A // IsSteinbergPairing c}) :
    liftEquiv c = liftLinear c.val c.property :=
  (rfl)

@[simp]
theorem liftEquiv_symm_apply_val (f : MatsumotoGroup R →ₗ[ℤ] A) (a b : Rˣ) :
    (liftEquiv.symm f).val a b = f (symbol a b) :=
  (rfl)

/-- **The universal property of the Matsumoto group.** A biadditive pairing `c` on `Rˣ` that
satisfies the Steinberg relation, `c x y = 0` whenever `x + y = 1`, induces a homomorphism
`{x, y} ↦ c x y` on the Matsumoto group; it is unique by `hom_ext`. -/
def lift (c : Additive Rˣ →+ Additive Rˣ →+ A)
    (hc : ∀ x y : Rˣ, (x : R) + y = 1 → c (Additive.ofMul x) (Additive.ofMul y) = 0) :
    MatsumotoGroup R →+ A :=
  (liftLinear (fun x y => c (Additive.ofMul x) (Additive.ofMul y))
    { map_mul_left := fun x x' y => by simp only [ofMul_mul, map_add, AddMonoidHom.add_apply]
      map_mul_right := fun x y y' => by simp only [ofMul_mul, map_add]
      steinberg := hc }).toAddMonoidHom

@[simp]
theorem lift_symbol (c : Additive Rˣ →+ Additive Rˣ →+ A)
    (hc : ∀ x y : Rˣ, (x : R) + y = 1 → c (Additive.ofMul x) (Additive.ofMul y) = 0)
    (x y : Rˣ) : lift c hc (symbol x y) = c (Additive.ofMul x) (Additive.ofMul y) := by
  simp [lift]

end Universal

/-- Functorial map on `MatsumotoGroup` induced by a ring homomorphism `f : R →+* S`. -/
def map {S : Type*} [CommSemiring S] (f : R →+* S) :
    MatsumotoGroup R →ₗ[ℤ] MatsumotoGroup S :=
  liftLinear (fun a b => symbol (Units.map f.toMonoidHom a) (Units.map f.toMonoidHom b))
    (isSteinbergPairing_symbol.comp_ringHom f)

@[simp]
theorem map_symbol {S : Type*} [CommSemiring S] (f : R →+* S) (a b : Rˣ) :
    map f (symbol a b) = symbol (Units.map f.toMonoidHom a) (Units.map f.toMonoidHom b) :=
  liftLinear_symbol _ _ a b

@[simp]
theorem map_id : map (RingHom.id R) = LinearMap.id :=
  linearMap_ext fun _ _ => by simp

@[simp]
theorem map_comp {S T : Type*} [CommSemiring S] [CommSemiring T] (g : S →+* T)
    (f : R →+* S) : map (g.comp f) = (map g).comp (map f) :=
  linearMap_ext fun a b => by
    simp only [LinearMap.comp_apply, map_symbol, RingHom.toMonoidHom_comp, Units.map_comp,
      MonoidHom.comp_apply]

end CommSemiring

section CommRing

variable {R : Type u} [CommRing R]

/-- The symbol `{x, -1}` has order dividing two. -/
theorem two_nsmul_symbol_neg_one (x : Rˣ) : 2 • symbol x (-1) = 0 := by
  rw [← symbol_pow_right, neg_one_sq, symbol_one_right]

end CommRing

section Field

variable {F : Type u} [Field F]

/-- **The Steinberg relation.** `{x, 1 - x} = 0` for `x ≠ 1`. -/
theorem symbol_mk0_one_sub (x : Fˣ) (hx : (1 : F) - x ≠ 0) :
    symbol x (Units.mk0 (1 - x) hx) = 0 :=
  symbol_of_add_eq_one (by simp)

/-- `{x, -x} = 0` for every unit `x`. -/
@[simp]
theorem symbol_self_neg (x : Fˣ) : symbol x (-x) = 0 :=
  isSteinbergPairing_symbol.map_neg_self x

/-- **Antisymmetry of Steinberg symbols.** `{y, x} = -{x, y}`. -/
theorem symbol_swap (x y : Fˣ) : symbol y x = -symbol x y :=
  isSteinbergPairing_symbol.map_swap y x

/-- **Antisymmetry of Steinberg symbols.** `{x, y} + {y, x} = 0`. -/
theorem symbol_add_symbol_swap (x y : Fˣ) : symbol x y + symbol y x = 0 := by
  rw [symbol_swap x y, add_neg_cancel]

/-- `{x, x} = {x, -1}`. -/
theorem symbol_self (x : Fˣ) : symbol x x = symbol x (-1) :=
  isSteinbergPairing_symbol.map_self x

/-- The symbol `{x, x}` has order dividing two. -/
theorem two_nsmul_symbol_self (x : Fˣ) : 2 • symbol x x = 0 :=
  isSteinbergPairing_symbol.two_nsmul_map_self x

/-- In characteristic two, `{x, x} = 0`. -/
@[simp]
theorem symbol_self_eq_zero_of_charTwo [CharP F 2] (x : Fˣ) : symbol x x = 0 :=
  isSteinbergPairing_symbol.map_self_eq_zero_of_charTwo x

/-- **Steinberg symbols vanish over a finite field.** Through Matsumoto's theorem this is
`K₂(𝔽_q) = 0`. -/
theorem symbol_eq_zero_of_finite [Finite F] (x y : Fˣ) : symbol x y = 0 :=
  isSteinbergPairing_symbol.eq_zero_of_finite x y

/-- The Matsumoto group of a finite field is trivial. -/
instance [Finite F] : Subsingleton (MatsumotoGroup F) :=
  subsingleton_of_forall_eq 0 fun q => by
    induction q using induction_on with
    | symbol x y => exact symbol_eq_zero_of_finite x y
    | add a b ha hb => rw [ha, hb, add_zero]

end Field

end MatsumotoGroup

end TauCeti
