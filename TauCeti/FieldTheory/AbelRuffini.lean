/-!
# Solvable Galois groups are radical

Mathlib's `isSolvable_gal_minpoly` says that an element expressible by radicals has a minimal
polynomial with solvable Galois group. This file proves the converse in characteristic zero
(Milne, *Fields and Galois Theory*, Theorem 5.34): a finite Galois extension `E/F` has solvable
Galois group exactly when every element of `E`, embedded in an algebraically closed field `Ω`, lies
in the radical closure `solvableByRad F Ω`.

The radicals are taken in `Ω`, not in `E`: the roots of unity that the radical expressions need
need not lie in `E`, and `solvableByRad F E` can be smaller than `E` (for a real cyclic cubic field
over `ℚ` it is `ℚ`).

The heart of the argument is Kummer theory. If `L/K` is a finite Galois extension with solvable
group and `L` contains a primitive `n`-th root of unity for a multiple `n` of `[L : K]`, then
`solvableByRad K L = ⊤`: otherwise `L` would be a nontrivial solvable extension of
`S = solvableByRad K L`, so a cyclic subextension of prime degree `p` over `S` would exist, and by
Kummer theory (`exists_root_adjoin_eq_top_of_isCyclic`) it would be generated by a `p`-th root of
an element of `S`, which already lies in `S`. The general case adjoins a primitive `[E : F]`-th
root of unity `ζ` to the image of `E` and applies this to the compositum over `F(ζ)`.

## Main results

* `TauCeti.solvableByRad_eq_top_of_isSolvable`: a finite Galois extension with solvable group
  containing enough roots of unity is generated by radicals.
* `TauCeti.restrictScalars_solvableByRad`: radicals over a field of radicals are radicals.
* `solvableByRad.map_le_of_algHom`: algebra homomorphisms preserve radicals.
* `TauCeti.isSolvable_of_forall_mem_solvableByRad`: a finite Galois extension that embeds into the
  radical closure has solvable group.
* `TauCeti.isSolvable_iff_forall_mem_solvableByRad`: in characteristic zero, a finite Galois
  extension has solvable group iff it embeds into the radical closure of an algebraically closed
  field.
* `Polynomial.isSolvable_gal_iff_forall_rootSet_mem_solvableByRad`: in characteristic zero, a
  polynomial has solvable Galois group iff all of its roots in an algebraically closed field are
  radicals.
* `Irreducible.forall_rootSet_mem_solvableByRad`: in characteristic zero, if one root of an
  irreducible polynomial is a radical expression, then so are all of its roots.

## References

* J. S. Milne, *Fields and Galois Theory*, version 5.10 (2022), Theorem 5.34.
-/

public section

open IntermediateField Module Polynomial

namespace TauCeti

section Radicals

variable {F E E' : Type*} [Field F] [Field E] [Field E'] [Algebra F E] [Algebra F E']

/-- An `F`-algebra homomorphism carries elements expressible by radicals to elements expressible
by radicals. -/
theorem _root_.solvableByRad.map_le_of_algHom (i : E →ₐ[F] E') :
    (solvableByRad F E).map i ≤ solvableByRad F E' :=
  map_le_iff_le_comap.mpr <| solvableByRad_le fun x _ hn hx ↦ by
    simpa using solvableByRad.rad_mem hn (by simpa using hx)

/-- Elements expressible by radicals over a field `K` whose elements are themselves expressible
by radicals over `F` are expressible by radicals over `F`. -/
theorem restrictScalars_solvableByRad {K : Type*} [Field K] [Algebra F K] [Algebra K E]
    [IsScalarTower F K E] (hK : ∀ k : K, algebraMap K E k ∈ solvableByRad F E) :
    (solvableByRad K E).restrictScalars F = solvableByRad F E := by
  refine le_antisymm (fun x hx ↦ ?_) <| solvableByRad_le fun x _ hn hx ↦ ?_
  · let S : IntermediateField K E := (solvableByRad F E).toSubfield.toIntermediateField hK
    exact solvableByRad_le (s := S) (fun y _ hn hy ↦ solvableByRad.rad_mem hn hy) hx
  · exact solvableByRad.rad_mem hn hx

end Radicals

section Kummer

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- A finite Galois extension `L/K` with solvable Galois group is generated by radicals, provided
`L` contains a primitive `n`-th root of unity for some multiple `n` of `[L : K]`. -/
theorem solvableByRad_eq_top_of_isSolvable [FiniteDimensional K L] [IsGalois K L]
    [Group.IsSolvable Gal(L/K)] {n : ℕ} [NeZero n] {ζ : L} (hζ : IsPrimitiveRoot ζ n)
    (hn : finrank K L ∣ n) : solvableByRad K L = ⊤ := by
  -- Otherwise `L` is a nontrivial extension of `S = solvableByRad K L`, with solvable group.
  set S := solvableByRad K L
  by_contra hS
  have : Group.IsSolvable Gal(L/S) :=
    Group.isSolvable_of_isSolvable_injective (AlgEquiv.restrictScalarsHom_injective K)
  have : Nontrivial Gal(L/S) := by
    rw [← Finite.one_lt_card_iff_nontrivial, IsGalois.card_aut_eq_finrank]
    exact lt_of_le_of_ne finrank_pos (Ne.symm (mt finrank_eq_one_iff_eq_top.mp hS))
  -- A normal subgroup `H` of prime index `p` cuts out a cyclic extension of degree `p` of `S`.
  obtain ⟨H, hH, hp⟩ := Group.IsSolvable.exists_normal_index_prime Gal(L/S)
  set p := H.index
  have hcard : Nat.card Gal(fixedField H/S) = p := by
    rw [← Nat.card_congr (IsGalois.normalAutEquivQuotient H).toEquiv]
    exact H.index_eq_card.symm
  have : Fact p.Prime := ⟨hp⟩
  have : IsCyclic Gal(fixedField H/S) := isCyclic_of_prime_card hcard
  have hM : finrank S (fixedField H) = p := by rw [← IsGalois.card_aut_eq_finrank, hcard]
  -- `p` divides `n`, so `S` contains a primitive `p`-th root of unity.
  have hdvd : p ∣ n := by
    refine dvd_trans ?_ hn
    rw [← finrank_mul_finrank K S L, ← finrank_mul_finrank S (fixedField H) L, hM]
    exact Dvd.dvd.mul_left (dvd_mul_right _ _) _
  have hη : IsPrimitiveRoot (ζ ^ (n / p)) p := by
    have := hζ.pow_of_dvd (Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_neZero n) hdvd) hp.pos).ne'
      (Nat.div_dvd_of_dvd hdvd)
    rwa [Nat.div_div_self hdvd (NeZero.ne n)] at this
  have hηS : ζ ^ (n / p) ∈ S :=
    solvableByRad.rad_mem hp.ne_zero (by rw [hη.pow_eq_one]; exact one_mem S)
  obtain ⟨α, ⟨a, ha⟩, hα⟩ := exists_root_adjoin_eq_top_of_isCyclic S (fixedField H)
    ⟨⟨_, hηS⟩, (mem_primitiveRoots finrank_pos).mpr
      (by rw [hM]; exact IsPrimitiveRoot.of_map_of_injective (f := S.val) hη S.val.injective)⟩
  -- The Kummer generator `α` is a radical over `S`, hence lies in `S`: the extension is trivial.
  have hαS : (α : L) ∈ S := by
    refine solvableByRad.rad_mem (n := finrank S (fixedField H)) finrank_pos.ne' ?_
    rw [← SubmonoidClass.coe_pow, ← ha]
    exact a.property
  have hbot : (⊥ : IntermediateField S (fixedField H)) = ⊤ := by
    rw [← hα, eq_comm, adjoin_simple_eq_bot_iff, mem_bot]
    exact ⟨⟨α, hαS⟩, rfl⟩
  exact hp.one_lt.ne' (hM ▸ bot_eq_top_iff_finrank_eq_one.mp hbot)

end Kummer

section Galois

variable {F E Ω : Type*} [Field F] [Field E] [Field Ω] [Algebra F E] [Algebra F Ω]

/-- The compositum `C = LK` of a finite Galois extension `L/F` with solvable group and an
intermediate field `K` of radicals is generated by radicals, if `C` contains a primitive
`[L : F]`-th root of unity. -/
private theorem solvableByRad_eq_top_of_sup_eq_top {C : Type*} [Field C] [Algebra F C]
    {K L : IntermediateField F C} [FiniteDimensional F K] [FiniteDimensional F L] [IsGalois F L]
    [Group.IsSolvable Gal(L/F)] (hsup : L ⊔ K = ⊤) (hK : K ≤ solvableByRad F C) {ζ : C}
    (hζ : IsPrimitiveRoot ζ (finrank F L)) : solvableByRad F C = ⊤ := by
  have : IsGalois K C := IsGalois.sup_right L K hsup
  have : FiniteDimensional F C := by
    have : FiniteDimensional F (⊤ : IntermediateField F C) := hsup ▸ inferInstance
    exact topEquiv.toLinearEquiv.finiteDimensional
  have : FiniteDimensional K C := Module.Finite.of_restrictScalars_finite F K C
  -- Restriction to `L` embeds `Gal(C/K)` into `Gal(L/F)`.
  have hinj := restrictRestrictAlgEquivMapHom_injective L K hsup
  have : Group.IsSolvable Gal(C/K) := Group.isSolvable_of_isSolvable_injective hinj
  have hdvd : finrank K C ∣ finrank F L := by
    rw [← IsGalois.card_aut_eq_finrank, ← IsGalois.card_aut_eq_finrank]
    exact Subgroup.card_dvd_of_injective _ hinj
  have : NeZero (finrank F L) := ⟨finrank_pos.ne'⟩
  rw [eq_top_iff, ← restrictScalars_solvableByRad (K := K) fun k ↦ hK k.property,
    solvableByRad_eq_top_of_isSolvable hζ hdvd, restrictScalars_top]

/-- A finite Galois extension `E/F` has solvable Galois group if some embedding of `E` lands in
the radical closure of `F`. This is the Galois-group form of Mathlib's
`isSolvable_gal_minpoly`. -/
theorem isSolvable_of_forall_mem_solvableByRad [FiniteDimensional F E] [IsGalois F E]
    (ι : E →ₐ[F] Ω) (h : ∀ x, ι x ∈ solvableByRad F Ω) : Group.IsSolvable Gal(E/F) := by
  -- `E` is the splitting field of the minimal polynomial of a primitive element `x`.
  obtain ⟨x, hx⟩ := Field.exists_primitive_element F E
  have : Group.IsSolvable Gal((minpoly F x).SplittingField/F) :=
    minpoly.algHom_eq ι ι.injective x ▸ isSolvable_gal_minpoly (h x)
  have : IsSplittingField F E (minpoly F x) := by
    refine isSplittingField_iff_intermediateField.mpr ⟨Normal.splits' x, top_le_iff.mp ?_⟩
    rw [← hx, adjoin_simple_le_iff]
    refine subset_adjoin _ _ ?_
    rw [mem_rootSet]
    exact ⟨minpoly.ne_zero (Algebra.IsIntegral.isIntegral x), minpoly.aeval F x⟩
  let e := (IsSplittingField.algEquiv E (minpoly F x)).autCongr
  exact Group.isSolvable_of_isSolvable_injective (f := e.toMonoidHom) e.injective

/-- **The radical criterion** (Milne, *Fields and Galois Theory*, Theorem 5.34). Over a field of
characteristic zero, a finite Galois extension `E/F` has solvable Galois group if and only if every
element of `E`, embedded in an algebraically closed field `Ω`, is expressible by radicals over
`F` in `Ω`. -/
theorem isSolvable_iff_forall_mem_solvableByRad [CharZero F] [IsAlgClosed Ω]
    [FiniteDimensional F E] [IsGalois F E] (ι : E →ₐ[F] Ω) :
    Group.IsSolvable Gal(E/F) ↔ ∀ x, ι x ∈ solvableByRad F Ω := by
  refine ⟨fun _ x ↦ ?_, isSolvable_of_forall_mem_solvableByRad ι⟩
  -- Adjoin a primitive `[E : F]`-th root of unity `ζ` to the image of `E`, giving `C`.
  have : CharZero Ω := charZero_of_injective_algebraMap (algebraMap F Ω).injective
  have : NeZero (finrank F E : Ω) := ⟨Nat.cast_ne_zero.mpr finrank_pos.ne'⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot Ω (finrank F E)
  set C := ι.fieldRange ⊔ F⟮ζ⟯
  have hζC : ζ ∈ C := (le_sup_right : F⟮ζ⟯ ≤ C) (mem_adjoin_simple_self F ζ)
  -- Inside `C`, the image `L` of `E` and the field `K = F(ζ)` satisfy the compositum lemma.
  let L := restrict (le_sup_left : ι.fieldRange ≤ C)
  let eL : E ≃ₐ[F] L := ι.equivFieldRange.trans (restrictAlgEquiv _)
  have : FiniteDimensional F L := eL.toLinearEquiv.finiteDimensional
  have : IsGalois F L := IsGalois.of_algEquiv eL
  have : Group.IsSolvable Gal(L/F) :=
    Group.isSolvable_of_surjective (f := eL.autCongr.toMonoidHom) eL.autCongr.surjective
  let ζ' : C := ⟨ζ, hζC⟩
  have hζ' : IsPrimitiveRoot ζ' (finrank F L) := by
    rw [← eL.toLinearEquiv.finrank_eq]
    exact IsPrimitiveRoot.of_map_of_injective (f := C.val) hζ C.val.injective
  have : FiniteDimensional F F⟮ζ'⟯ := adjoin.finiteDimensional <|
    IsIntegral.of_pow finrank_pos <| by rw [hζ'.pow_eq_one]; exact isIntegral_one
  have hsup : L ⊔ F⟮ζ'⟯ = ⊤ := lift_injective _ <| by
    rw [lift_sup, lift_restrict, lift_adjoin_simple, lift_top]
  have hK : F⟮ζ'⟯ ≤ solvableByRad F C := adjoin_simple_le_iff.mpr <|
    solvableByRad.rad_mem finrank_pos.ne' (by rw [hζ'.pow_eq_one]; exact one_mem _)
  have hrad := solvableByRad_eq_top_of_sup_eq_top hsup hK hζ'
  -- Map the conclusion `solvableByRad F C = ⊤` back to `Ω`.
  have hxC : ι x ∈ C :=
    (le_sup_left : ι.fieldRange ≤ C) (AlgHom.mem_fieldRange.mpr ⟨x, rfl⟩)
  exact solvableByRad.map_le_of_algHom C.val ⟨⟨ι x, hxC⟩, hrad ▸ mem_top, rfl⟩

/-- **The radical criterion for polynomials.** Over a field of characteristic zero, a polynomial
`q` has solvable Galois group if and only if all of its roots in an algebraically closed field `Ω`
are expressible by radicals. The polynomial need not be irreducible or separable. -/
theorem _root_.Polynomial.isSolvable_gal_iff_forall_rootSet_mem_solvableByRad [CharZero F]
    [IsAlgClosed Ω] (q : F[X]) :
    Group.IsSolvable q.Gal ↔ ∀ x ∈ q.rootSet Ω, x ∈ solvableByRad F Ω := by
  let ι : q.SplittingField →ₐ[F] Ω := IsAlgClosed.lift
  have : IsGalois F q.SplittingField := ⟨⟩
  -- The image of the splitting field is generated by the roots of `q` in `Ω`.
  have hι := IsSplittingField.adjoin_rootSet_eq_range q.SplittingField q ι
  refine (isSolvable_iff_forall_mem_solvableByRad ι).trans ⟨fun h y hy ↦ ?_, fun h x ↦ ?_⟩
  · obtain ⟨x, rfl⟩ : y ∈ ι.range := hι ▸ Algebra.subset_adjoin hy
    exact h x
  · exact Algebra.adjoin_le (S := (solvableByRad F Ω).toSubalgebra) h (hι ▸ ⟨x, rfl⟩)

/-- Over a field of characteristic zero, if one root of an irreducible polynomial in an
algebraically closed field is expressible by radicals, then so are all of its roots. -/
theorem _root_.Irreducible.forall_rootSet_mem_solvableByRad [CharZero F] [IsAlgClosed Ω]
    {q : F[X]} (hq : Irreducible q) {x : Ω} (hx : aeval x q = 0) (hxR : x ∈ solvableByRad F Ω) :
    ∀ y ∈ q.rootSet Ω, y ∈ solvableByRad F Ω :=
  (isSolvable_gal_iff_forall_rootSet_mem_solvableByRad q).mp
    (isSolvable_gal_of_irreducible hxR hq hx)

end Galois

end TauCeti
