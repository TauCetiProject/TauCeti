import TauCeti.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# Field extensions generated by a set

Complements on `IntermediateField.adjoin F s = ⊤`, the statement that a set `s` generates a field
extension `E / F`: several independent consequences of it, and one criterion for it.

*Extensionality.* An `F`-algebra automorphism of `E` fixing every element of `s` is the
identity. This is the whole-field counterpart of Mathlib's
`IntermediateField.algHom_ext_of_eq_adjoin` (which compares homomorphisms out of the *subfield*
`adjoin F s`), obtained from it by restricting to that subfield, which is all of `E`, rather
than repeating the adjoin induction. It is the extensionality step shared by the multiquadratic
arguments: the splitting law shows a decomposition-group element fixes every generator `√dᵢ` and
concludes it is trivial, and the Frobenius computation concludes the same when every Legendre
symbol is `1`.

*Semilinear transport.* A ring isomorphism `E ≃+* E'` carrying `F` into `F'` carries a generating
set of `E / F` to a generating set of `E' / F'`. Mathlib's `IntermediateField.adjoin_map` treats
`F`-algebra maps; this is the form needed for Galois conjugates, which change the base field.

*Changing the base of a generated extension.* For a tower `K ⊆ L ⊆ M` in which a set `t`
generates `M` over `L`, the compositum of `K(t)` — generated over the *bottom* of the
tower — with the image of `L` is already all of `M`. That is the shape every compositum argument
over the base `K` needs, because Mathlib's engines (`IntermediateField.fixingSubgroup_sup`,
`IntermediateField.normal_sup`, and the linear-disjointness API) all take two intermediate
fields of a *single* extension `M / K` together with a hypothesis that their join is `⊤`.
Dually, if `s` generates `L` over `K` and `ι : L →ₐ[K] M` lands in a tower `K ⊆ F ⊆ M`, then
over `F` the image of `ι` and the image of `s` generate the same field; this is how a primitive
element of `L / K` becomes one of a base change of `L`. Finally, the image of `ι` generates `M`
over `F` exactly when `M` is the compositum over `K` of the images of `F` and `ι`.

*Spanning.* If the image of a ring `R` generates an algebraic extension `M / E`, it already spans
`M` over `E`, so every element of `M` is an `E`-linear combination of elements of `R`.

*Generation from algebra generators.* If a ring `S` is generated as an `R`-algebra by a set `s`,
then the fraction field `L` of `S` is generated by the image of `s` over any field `K` between `R`
and `L`, because every element of `L` is a ratio of two elements of `R[s]`. For a single element
`β`, this is how a generator of an extension of integer rings becomes a primitive element of the
extension of fraction fields. Conversely, if elements generate `L` over the fraction field `K` of
a ring `A`, then `L` is the fraction field of the `A`-algebra they generate.

## Main results

* `TauCeti.IntermediateField.algHom_ext_of_adjoin_eq_top`: algebra homomorphisms into any
  semiring are determined by their values on a generating set.
* `TauCeti.IntermediateField.algEquiv_ext_of_adjoin_eq_top`: two algebra isomorphisms agreeing on
  a generating set are equal.
* `TauCeti.IntermediateField.algEquiv_eq_one_of_adjoin_eq_top`: an automorphism fixing each
  element of a generating set is `1`.
* `TauCeti.IntermediateField.adjoin_image_eq_top_of_ringEquiv`: a ring isomorphism carrying `F`
  into `F'` carries a generating set over `F` to a generating set over `F'`.
* `TauCeti.IntermediateField.adjoin_sup_fieldRange_eq_top`: for a tower `K ⊆ L ⊆ M` in which
  `t` generates `M` over `L`, the compositum `K(t) ⊔ L` is `⊤` inside `M`.
* `TauCeti.IntermediateField.adjoin_range_eq_adjoin_image`: over any intermediate base, the image
  of a `K`-embedding of `L` generates the same field as the image of a generating set of `L/K`.
* `TauCeti.IntermediateField.adjoin_gen_eq_top_of_pow_eq`: if `L = K(α)` and `β ^ n = α`, then
  `L(β)` is generated by `β` already over `K`.
* `AlgHom.adjoin_range_eq_top_iff_fieldRange_sup_fieldRange_eq_top`: a field is generated over
  one factor by the other exactly when it is the compositum of the two.
* `TauCeti.IntermediateField.span_range_eq_top_of_adjoin_range_eq_top`: an algebraic extension
  generated by the image of a ring is spanned by it.
* `TauCeti.IntermediateField.adjoin_image_eq_top_of_algebra_adjoin_eq_top`: algebra generators
  of a domain also generate its fraction field over any intermediate base field;
  `TauCeti.IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top` is the single-generator
  case.
* `TauCeti.IntermediateField.isFractionRing_algebra_adjoin_of_adjoin_eq_top`: conversely,
  generators of `L` over the fraction field of `A` generate an `A`-algebra with fraction field
  `L`.
* `TauCeti.IntermediateField.finrank_le_of_adjoin_simple_eq_top_of_pow_mem`: if `β` generates `L`
  over `E` and `β ^ n` lies in `E` for some `n ≠ 0`, then `[L : E] ≤ n`.
* `TauCeti.IntermediateField.finrank_eq_one_of_adjoin_eq_top_of_mem_bot`: if `L = K(y)` with `y`
  in the bottom intermediate field, then `[L : K] = 1`.

## Generating sets

The compositum criterion allows an arbitrary set of field generators, so it applies to extensions
that need several generators or contain transcendental elements. It expresses generation over a
larger base as generation by the same set together with that base inside a single extension.
For a cyclotomic extension, the singleton consisting of a primitive root suffices; its algebra
generation hypothesis implies field generation by `IntermediateField.adjoin_eq_top_of_algebra`.

`adjoin_sup_fieldRange_eq_top` is adapted from the Birkbeck–Brasca Chebotarev density project,
where the step is inlined into a larger `adjoin_induction`.
-/

public section

namespace TauCeti.IntermediateField

variable {F E : Type*} [Field F] [Field E] [Algebra F E] {s : Set E}

/-- **Two algebra homomorphisms agreeing on a generating set are equal.** If `s` generates `E`
over `F` (`IntermediateField.adjoin F s = ⊤`) and `F`-algebra maps `σ, τ : E →ₐ[F] E₂` (into any
semiring `E₂`) agree on every element of `s`, then `σ = τ`. This is the whole-field, two-map
counterpart of Mathlib's `IntermediateField.algHom_ext_of_eq_adjoin`. -/
theorem algHom_ext_of_adjoin_eq_top {E₂ : Type*} [Semiring E₂] [Algebra F E₂]
    (htop : IntermediateField.adjoin F s = ⊤)
    {σ τ : E →ₐ[F] E₂} (h : ∀ x ∈ s, σ x = τ x) : σ = τ :=
  -- Restrict `σ`, `τ` to the subfield `adjoin F s` and compare there with Mathlib's
  -- `adjoin_algHom_ext`, which is the adjoin induction we would otherwise repeat.
  AlgHom.ext fun y ↦ AlgHom.congr_fun
    (IntermediateField.adjoin_algHom_ext F (φ₁ := σ.comp (IntermediateField.val _))
      (φ₂ := τ.comp (IntermediateField.val _)) h) ⟨y, htop ▸ IntermediateField.mem_top⟩

/-- Two `F`-algebra isomorphisms out of `E` agreeing on a generating set are equal. -/
theorem algEquiv_ext_of_adjoin_eq_top {E₂ : Type*} [Semiring E₂] [Algebra F E₂]
    (htop : IntermediateField.adjoin F s = ⊤)
    {σ τ : E ≃ₐ[F] E₂} (h : ∀ x ∈ s, σ x = τ x) : σ = τ :=
  AlgEquiv.coe_toAlgHom_injective (algHom_ext_of_adjoin_eq_top htop h)

/-- An `F`-algebra automorphism of `E` that fixes every element of a set generating `E` over
`F` is the identity. This is `TauCeti.IntermediateField.algEquiv_ext_of_adjoin_eq_top` against
the identity. -/
theorem algEquiv_eq_one_of_adjoin_eq_top (htop : IntermediateField.adjoin F s = ⊤)
    {σ : E ≃ₐ[F] E} (hfix : ∀ x ∈ s, σ x = x) : σ = 1 :=
  algEquiv_ext_of_adjoin_eq_top htop (σ := σ) (τ := 1) (by simpa using hfix)

/-- **Generating sets transport along semilinear ring isomorphisms.** Let `f : E ≃+* E'` be a ring
isomorphism carrying `F` into `F'` along a ring homomorphism `σ : F →+* F'`, as a Galois
conjugation does. If `s` generates `E` over `F`, then `f '' s` generates `E'` over `F'`. -/
theorem adjoin_image_eq_top_of_ringEquiv {F' E' : Type*} [Field F'] [Field E'] [Algebra F' E']
    (σ : F →+* F') (f : E ≃+* E') (hf : ∀ c, f (algebraMap F E c) = algebraMap F' E' (σ c))
    (htop : IntermediateField.adjoin F s = ⊤) : IntermediateField.adjoin F' (f '' s) = ⊤ := by
  refine eq_top_iff.mpr fun y _ ↦ ?_
  have hy : f.symm y ∈ IntermediateField.adjoin F s := htop ▸ IntermediateField.mem_top
  rw [← IntermediateField.mem_toSubfield, IntermediateField.adjoin_toSubfield] at hy ⊢
  -- `y` is the image under `f` of an element of the subfield generated by `F` and `s`.
  have hmap : y ∈ (Subfield.closure (Set.range (algebraMap F E) ∪ s)).map (f : E →+* E') :=
    Subfield.mem_map.mpr ⟨f.symm y, hy, f.apply_symm_apply y⟩
  rw [RingHom.map_field_closure] at hmap
  refine Subfield.closure_mono ?_ hmap
  rintro _ ⟨z, ⟨c, rfl⟩ | hz, rfl⟩
  · exact Or.inl ⟨σ c, (hf c).symm⟩
  · exact Or.inr ⟨z, hz, rfl⟩

/-- **The compositum step.** If a set `t` generates `M` over `L`, then inside `M` the
compositum of `K(t)` with the image of `L` is all of `M`, for any base field `K` of the
tower. This is the input to Mathlib's compositum engines
(`IntermediateField.fixingSubgroup_sup`, `IntermediateField.normal_sup`). The single-generator
case `t = {ζ}` is the one the cyclotomic compositum uses; it is obtained by specialisation. -/
theorem adjoin_sup_fieldRange_eq_top (K L M : Type*) [Field K] [Field L] [Field M]
    [Algebra K L] [Algebra K M] [Algebra L M] [IsScalarTower K L M] {t : Set M}
    (hadj : IntermediateField.adjoin L t = ⊤) :
    IntermediateField.adjoin K t ⊔ (IsScalarTower.toAlgHom K L M).fieldRange = ⊤ := by
  refine top_le_iff.mp fun x _ ↦ ?_
  have hx : x ∈ IntermediateField.adjoin L t := hadj ▸ IntermediateField.mem_top
  refine IntermediateField.adjoin_induction L (fun y hy ↦ ?_) (fun r ↦ ?_)
    (fun a b _ _ ha hb ↦ add_mem ha hb) (fun a _ ha ↦ inv_mem ha)
    (fun a b _ _ ha hb ↦ mul_mem ha hb) hx
  · exact le_sup_left (α := IntermediateField K M) (IntermediateField.subset_adjoin K t hy)
  · exact le_sup_right (α := IntermediateField K M) ⟨r, rfl⟩

/-- **Generators of a base-changed image.** If `s` generates `L` over `K`, then for any tower
`K ⊆ F ⊆ M` and `K`-embedding `ι : L →ₐ[K] M`, the field generated over `F` by the image of `ι`
is already generated by the image of `s`. -/
theorem adjoin_range_eq_adjoin_image {K L F M : Type*} [Field K] [Field L] [Field F] [Field M]
    [Algebra K L] [Algebra K F] [Algebra F M] [Algebra K M] [IsScalarTower K F M]
    (ι : L →ₐ[K] M) {s : Set L} (hs : IntermediateField.adjoin K s = ⊤) :
    IntermediateField.adjoin F (Set.range ι) = IntermediateField.adjoin F (ι '' s) := by
  rw [← AlgHom.coe_fieldRange, AlgHom.fieldRange_eq_map, ← hs, IntermediateField.adjoin_map,
    IntermediateField.adjoin_adjoin_right]

open _root_.IntermediateField in
/-- If `L = K(α)` and `β ^ n = α` in an overfield, then `L(β)` is generated by `β`
already over `K`. No algebraicity or nonzero-exponent hypothesis is needed. -/
theorem adjoin_gen_eq_top_of_pow_eq {K L Ω : Type*} [Field K] [Field L] [Field Ω]
    [Algebra K L] [Algebra K Ω] [Algebra L Ω] [IsScalarTower K L Ω] {α : L}
    (hα : IntermediateField.adjoin K {α} = ⊤) {β : Ω} {n : ℕ}
    (hβ : β ^ n = algebraMap L Ω α) :
    IntermediateField.adjoin K {IntermediateField.AdjoinSimple.gen L β} = ⊤ := by
  let γ := IntermediateField.AdjoinSimple.gen L β
  have hpow : γ ^ n = algebraMap L L⟮β⟯ α :=
    Subtype.ext (by simpa [γ] using hβ)
  have hrange : (IsScalarTower.toAlgHom K L L⟮β⟯).fieldRange ≤
      IntermediateField.adjoin K {γ} := by
    rw [← IntermediateField.adjoin_self K (IsScalarTower.toAlgHom K L L⟮β⟯).fieldRange,
      AlgHom.coe_fieldRange,
      adjoin_range_eq_adjoin_image (IsScalarTower.toAlgHom K L L⟮β⟯) hα,
      Set.image_singleton, IntermediateField.adjoin_simple_le_iff, IsScalarTower.toAlgHom_apply,
      ← hpow]
    exact pow_mem (IntermediateField.mem_adjoin_simple_self K γ) n
  have htop := adjoin_sup_fieldRange_eq_top K L L⟮β⟯
    (adjoin_adjoinSimple_gen_eq_top β)
  rwa [sup_eq_left.mpr hrange] at htop

/-- **A compositum is generated over one factor by the other.** For a tower `K ⊆ E ⊆ M` and a
`K`-embedding `ι : L →ₐ[K] M`, `M` is generated over `E` by the image of `ι` if and only if `M` is
the compositum over `K` of the images of `E` and `L`. -/
theorem _root_.AlgHom.adjoin_range_eq_top_iff_fieldRange_sup_fieldRange_eq_top {K E L M : Type*}
    [Field K] [Field E] [Field L] [Field M] [Algebra K E] [Algebra K L] [Algebra E M] [Algebra K M]
    [IsScalarTower K E M] (ι : L →ₐ[K] M) :
    IntermediateField.adjoin E (Set.range ι) = ⊤ ↔
      (IsScalarTower.toAlgHom K E M).fieldRange ⊔ ι.fieldRange = ⊤ := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · -- This is the compositum step `TauCeti.IntermediateField.adjoin_sup_fieldRange_eq_top` for
    -- `t = Set.range ι`.
    rw [sup_comm, ← adjoin_sup_fieldRange_eq_top K E M h, ← AlgHom.coe_fieldRange,
      IntermediateField.adjoin_self]
  -- Over `K`, the field generated over `E` by the image of `ι` contains both images.
  refine IntermediateField.restrictScalars_eq_top_iff.1 (top_le_iff.1 (h ▸ sup_le ?_ ?_))
  · rintro _ ⟨x, rfl⟩
    exact IntermediateField.algebraMap_mem _ x
  · rintro _ ⟨x, rfl⟩
    exact IntermediateField.subset_adjoin E _ ⟨x, rfl⟩

/-- **An algebraic extension generated by a subring is spanned by it.** If the image of `R`
generates `M` over a field `E` and `M / E` is algebraic, then that image spans `M` as an
`E`-vector space: being closed under multiplication, it spans the `E`-algebra it generates, which
is the whole field. -/
theorem span_range_eq_top_of_adjoin_range_eq_top {R E M : Type*} [CommSemiring R] [Field E]
    [Field M] [Algebra R M] [Algebra E M] [Algebra.IsAlgebraic E M]
    (h : IntermediateField.adjoin E (Set.range (algebraMap R M)) = ⊤) :
    Submodule.span E (Set.range (algebraMap R M)) = ⊤ := by
  have hadj := congrArg IntermediateField.toSubalgebra h
  rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
    fun x _ ↦ Algebra.IsAlgebraic.isAlgebraic x, IntermediateField.top_toSubalgebra] at hadj
  have hclosure : (Submonoid.closure (Set.range (algebraMap R M)) : Set M) =
      Set.range (algebraMap R M) := by
    rw [← MonoidHom.coe_mrange, Submonoid.closure_eq]
  rw [← hclosure, ← Algebra.adjoin_eq_span, hadj, Algebra.top_toSubmodule]

section FractionRing

variable {A K L : Type*} [CommRing A] [Field K] [Field L] [Algebra A K] [Algebra A L] [Algebra K L]
  [IsScalarTower A K L] [IsFractionRing A K]

/-- If elements `s` generate a field `L` over the fraction field `K` of `A`, then `L` is the
fraction field of the `A`-algebra `A[s]` they generate: every element of `L = K(s)` is a ratio of
two elements of `K[s]`, and their denominators in `A` can be cleared. This is a converse of
`TauCeti.IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top`. -/
theorem isFractionRing_algebra_adjoin_of_adjoin_eq_top {s : Set L}
    (h : IntermediateField.adjoin K s = ⊤) :
    IsFractionRing (Algebra.adjoin A s) L := by
  have hinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  refine .of_field _ _ fun z ↦ ?_
  have hz : z ∈ IntermediateField.adjoin K s := h ▸ trivial
  obtain ⟨r, hr, u, hu, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp hz
  -- clear the denominators of `r, u ∈ K[s]` by elements `a, b` of `A`
  obtain ⟨⟨a, ha⟩, har⟩ := multiple_mem_adjoin_of_mem_localization_adjoin
    (nonZeroDivisors A) K s r hr
  obtain ⟨⟨b, hb⟩, hbu⟩ := multiple_mem_adjoin_of_mem_localization_adjoin
    (nonZeroDivisors A) K s u hu
  have : Nontrivial A := (algebraMap A K).domain_nontrivial
  have ha0 : algebraMap A L a ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (nonZeroDivisors.ne_zero ha)
  have hb0 : algebraMap A L b ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (nonZeroDivisors.ne_zero hb)
  refine ⟨algebraMap A _ b * ⟨_, har⟩, algebraMap A _ a * ⟨_, hbu⟩, ?_⟩
  simp only [map_mul, ← IsScalarTower.algebraMap_apply, Subalgebra.algebraMap_apply,
    Submonoid.smul_def, Algebra.smul_def]
  rw [mul_left_comm (algebraMap A L a), mul_div_mul_left _ _ hb0, mul_div_mul_left _ _ ha0]

end FractionRing

variable {R S K L : Type*} [CommSemiring R] [CommRing S] [Field K] [Field L] [Algebra R S]
  [Algebra R K] [Algebra R L] [Algebra S L] [Algebra K L] [IsScalarTower R S L]
  [IsScalarTower R K L] [IsFractionRing S L]

/-- If `S` is generated as an `R`-algebra by a set `s`, then the fraction field `L` of `S` is
generated by the image of `s` over any field `K` sitting between `R` and `L`: every element of `L`
is a ratio of two elements of `R[s]`. -/
theorem adjoin_image_eq_top_of_algebra_adjoin_eq_top {s : Set S} (h : Algebra.adjoin R s = ⊤) :
    IntermediateField.adjoin K (algebraMap S L '' s) = ⊤ := by
  -- `R[s]` lands in `K(s)` by the universal property of `Algebra.adjoin`, applied to the
  -- preimage of `K(s)` in `S`.
  have hle : Algebra.adjoin R s ≤
      ((IntermediateField.adjoin K (algebraMap S L '' s)).toSubalgebra.restrictScalars R).comap
        (IsScalarTower.toAlgHom R S L) :=
    Algebra.adjoin_le fun x hx ↦ IntermediateField.subset_adjoin K _ ⟨x, hx, rfl⟩
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := S) x
  exact div_mem (hle (h.ge Algebra.mem_top)) (hle (h.ge Algebra.mem_top))

/-- If `S` is generated as an `R`-algebra by a single element `β`, then the fraction field `L` of
`S` is generated by the image of `β` over any field `K` sitting between `R` and `L`. This is the
single-generator case of `TauCeti.IntermediateField.adjoin_image_eq_top_of_algebra_adjoin_eq_top`.
-/
theorem adjoin_eq_top_of_algebra_adjoin_eq_top {β : S} (h : Algebra.adjoin R {β} = ⊤) :
    IntermediateField.adjoin K {algebraMap S L β} = ⊤ := by
  simpa using adjoin_image_eq_top_of_algebra_adjoin_eq_top (K := K) (L := L) h

open Polynomial in
/-- If `β` generates `L` over `E` and `β ^ n` lies in `E`, for some `n ≠ 0`, then `[L : E] ≤ n`:
`β` is a root of the monic polynomial `X ^ n - C (β ^ n)` over `E`, so its minimal polynomial over
`E` has degree at most `n`. -/
theorem finrank_le_of_adjoin_simple_eq_top_of_pow_mem {E L : Type*} [Field E] [Field L]
    [Algebra E L] {β : L} (hβ : IntermediateField.adjoin E {β} = ⊤) {n : ℕ} (hn : n ≠ 0)
    (hE : β ^ n ∈ Set.range (algebraMap E L)) : Module.finrank E L ≤ n := by
  obtain ⟨c, hc⟩ := hE
  have hroot : aeval β (X ^ n - C c : E[X]) = 0 := by simp [hc]
  rw [← IntermediateField.finrank_top', ← hβ,
    IntermediateField.adjoin.finrank ⟨_, monic_X_pow_sub_C _ hn, hroot⟩]
  exact (natDegree_le_of_dvd (minpoly.dvd E β hroot) (X_pow_sub_C_ne_zero hn.bot_lt _)).trans
    (natDegree_X_pow_sub_C _).le

/-- If `L = K(y)` for an element `y` of the bottom intermediate field, then `[L : K] = 1`. -/
theorem finrank_eq_one_of_adjoin_eq_top_of_mem_bot {K L : Type*} [Field K] [Field L] [Algebra K L]
    {y : L} (hgen : IntermediateField.adjoin K {y} = ⊤)
    (hy : y ∈ (⊥ : IntermediateField K L)) : Module.finrank K L = 1 := by
  rw [IntermediateField.adjoin_simple_eq_bot_iff.2 hy] at hgen
  exact IntermediateField.bot_eq_top_iff_finrank_eq_one.mp hgen

end TauCeti.IntermediateField
