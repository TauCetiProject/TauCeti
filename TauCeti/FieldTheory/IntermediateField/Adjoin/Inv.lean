module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import TauCeti.FieldTheory.IntermediateField.Adjoin.Mobius

/-!
# Simple intermediate fields generated by inverses

Adjoining an element to a field is unchanged when that element is replaced by its inverse.
Inversion is the Möbius transformation `x ↦ (0 * x + 1) / (1 * x + 0)`, so both results are
special cases of the Möbius invariance results in
`TauCeti.FieldTheory.IntermediateField.Adjoin.Mobius`.

## Main results

* `TauCeti.IntermediateField.adjoin_simple_inv`: `K⟮x⁻¹⟯ = K⟮x⟯`.
* `TauCeti.minpoly.natDegree_inv`: `x⁻¹` and `x` have minimal polynomials of the same degree.
-/

public section

open scoped IntermediateField

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

namespace TauCeti.IntermediateField

/-- The simple intermediate field generated by the inverse of an element is the one generated by
the element itself. -/
@[simp]
theorem adjoin_simple_inv (x : L) : K⟮x⁻¹⟯ = K⟮x⟯ := by
  -- Inversion is the Möbius map with `(a, b, c, d) = (0, 1, 1, 0)`, of determinant `-1`.
  simpa using adjoin_simple_mul_add_div_mul_add (K := K) (a := 0) (b := 1) (c := 1) (d := 0) x
    (by simp)

end TauCeti.IntermediateField

namespace TauCeti.minpoly

/-- An element and its inverse have minimal polynomials of the same degree. Both degrees are `0`
when the element is not integral. -/
theorem natDegree_inv (x : L) : (minpoly K x⁻¹).natDegree = (minpoly K x).natDegree := by
  -- Inversion is the Möbius map with `(a, b, c, d) = (0, 1, 1, 0)`, of determinant `-1`.
  simpa using natDegree_mul_add_div_mul_add (K := K) (a := 0) (b := 1) (c := 1) (d := 0) x
    (by simp)

end TauCeti.minpoly
