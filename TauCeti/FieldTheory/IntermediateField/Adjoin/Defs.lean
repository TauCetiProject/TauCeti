module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import TauCeti.FieldTheory.IntermediateField.ScalarTower

/-!
# The generator of a simple intermediate field

For an element `α` of an extension `E / F`, the generator `IntermediateField.AdjoinSimple.gen F α`
of `F⟮α⟯` is a root of a polynomial `p` over `F`, viewed over `F⟮α⟯`, exactly when `α` is a root
of `p`. This is the form in which a root of `p` is removed from `p` over the field it generates.
In particular, `AdjoinSimple.gen F α` is an `n`-th root of an element from a compatible base `R`
in `F⟮α⟯` exactly when `α` is in `E`. The generator also generates `F⟮α⟯` over `F`, which is what
lets a theorem about an extension generated by one element be applied to the simple intermediate
field `F⟮α⟯` itself.

## Main results

* `IntermediateField.AdjoinSimple.isRoot_map_gen_iff`: the generator of `F⟮α⟯` is a root of `p`
  mapped to `F⟮α⟯` if and only if `α` is a root of `p`.
* `IntermediateField.AdjoinSimple.gen_pow_eq_algebraMap_iff`: `AdjoinSimple.gen F α ^ n =
  algebraMap R F⟮α⟯ r` if and only if `α ^ n = algebraMap R E r`.
* `IntermediateField.adjoin_adjoinSimple_gen_eq_top`: the generator of `F⟮α⟯` generates it over
  `F`.
* `IntermediateField.restrictScalars_adjoin_eq_fieldRange_sup`: restricting scalars of
  `adjoin k' S` to `k` inside `E / k' / k` gives the compositum of the image of `k'` and
  `adjoin k S`.
-/

public section

namespace IntermediateField

open Polynomial

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- The generator of `F⟮α⟯` is a root of `p` mapped to `F⟮α⟯` if and only if `α` is a root
of `p`. -/
theorem AdjoinSimple.isRoot_map_gen_iff (α : E) {p : F[X]} :
    (p.map (algebraMap F F⟮α⟯)).IsRoot (AdjoinSimple.gen F α) ↔ aeval α p = 0 := by
  rw [IsRoot.def, eval_map_algebraMap, ← ZeroMemClass.coe_eq_zero, AdjoinSimple.coe_aeval_gen_apply]

/-- The generator `AdjoinSimple.gen F α` of `F⟮α⟯` has `n`-th power `algebraMap R F⟮α⟯ r` if and
only if `α` has `n`-th power `algebraMap R E r` in `E`. -/
@[simp]
theorem AdjoinSimple.gen_pow_eq_algebraMap_iff {R : Type*} [CommSemiring R] [Algebra R F]
    [Algebra R E] [IsScalarTower R F E] {α : E} {n : ℕ} {r : R} :
    AdjoinSimple.gen F α ^ n = algebraMap R F⟮α⟯ r ↔ α ^ n = algebraMap R E r :=
  pow_eq_algebraMap_iff

/-- The generator of `F⟮α⟯` generates `F⟮α⟯` over `F`. -/
@[simp]
theorem adjoin_adjoinSimple_gen_eq_top (α : E) : F⟮AdjoinSimple.gen F α⟯ = ⊤ :=
  lift_injective _ (by simp)

/-- Restricting scalars of `adjoin k' S` to `k` inside an ambient extension `E / k' / k` gives the
compositum of the image of `k'` and `adjoin k S`. -/
theorem restrictScalars_adjoin_eq_fieldRange_sup {k k' E : Type*} [Field k] [Field k'] [Field E]
    [Algebra k k'] [Algebra k E] [Algebra k' E] [IsScalarTower k k' E] (S : Set E) :
    (adjoin k' S).restrictScalars k = (IsScalarTower.toAlgHom k k' E).fieldRange ⊔ adjoin k S := by
  rw [restrictScalars_adjoin_of_algEquiv (IsScalarTower.toAlgHom k k' E).equivFieldRange
      (by ext; simp), restrictScalars_adjoin_eq_sup]

end IntermediateField
