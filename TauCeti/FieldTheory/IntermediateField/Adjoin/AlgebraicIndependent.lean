module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure

/-!
# Algebraic independence of generators and transcendence degree

Let `E / F` be a field extension, `x : ι → E` a finite family and `T ⊆ E` a set of elements
algebraic over `F`. The field `F(x, T)` generated by `x` and `T` is algebraic over `F(x)`, so its
transcendence degree over `F` is at least the size of `ι` exactly when `x` is algebraically
independent over `F`.

This turns lower bounds for transcendence degrees into algebraic independence statements. For
instance, Schanuel's conjecture bounds `trdeg ℚ(x, exp x)` from below; when the `exp xᵢ` are
algebraic, it is algebraic independence of the `xᵢ`.

## Main results

* `TauCeti.natCard_le_trdeg_adjoin_union_iff`: for a finite family `x` and a set `T`
  of algebraic elements, `F(x, T)` has transcendence degree at least `card ι` over `F` iff `x` is
  algebraically independent over `F`.
* `TauCeti.algebraicIndependent_iff_forall_transcendental_adjoin`: a set `s` is algebraically
  independent over `F` iff each `x ∈ s` is transcendental over `F(s \ {x})`.
-/

public section

open IntermediateField Set

namespace TauCeti

universe u v w

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- Let `x` be a finite family in `E` and `T` a set of elements of `E` algebraic over `F`. Then
the field `F(x, T)` has transcendence degree at least `card ι` over `F` if and only if `x` is
algebraically independent over `F`. -/
theorem natCard_le_trdeg_adjoin_union_iff {ι : Type w} [Finite ι] {x : ι → E} {T : Set E}
    (hT : ∀ z ∈ T, IsAlgebraic F z) :
    (Nat.card ι : Cardinal) ≤ Algebra.trdeg F (adjoin F (range x ∪ T)) ↔
      AlgebraicIndependent F x := by
  set L := adjoin F (range x ∪ T)
  have hxL (i : ι) : x i ∈ L := subset_adjoin F _ (Or.inl (mem_range_self i))
  -- The family `x`, viewed in `L`.
  set x' : ι → L := fun i ↦ ⟨x i, hxL i⟩
  rw [← Cardinal.lift_le.{w}, Cardinal.lift_natCast, ← Cardinal.lift_natCast.{v}, Nat.cast_card]
  refine ⟨fun h ↦ ?_, fun h ↦
    (AlgebraicIndependent.of_comp (x := x') L.val h).lift_cardinalMk_le_trdeg⟩
  -- The generators of `L` generate `L` as an intermediate field of itself.
  have hgen : adjoin F (Subtype.val ⁻¹' (range x ∪ T) : Set L) = ⊤ := by
    apply lift_injective L
    rw [lift_adjoin, lift_top, image_preimage_eq_of_subset]
    rw [Subtype.range_coe]
    exact subset_adjoin F _
  -- Every element of `L` is algebraic over the subfield generated by `x`, since the generators
  -- of `L` are.
  have halg : Algebra.IsAlgebraic (adjoin F (range x')) L := by
    refine ⟨fun z ↦ mem_algebraicClosure_iff.1 ?_⟩
    have hle : adjoin F (Subtype.val ⁻¹' (range x ∪ T) : Set L) ≤
        (algebraicClosure (adjoin F (range x')) L).restrictScalars F := by
      rw [adjoin_le_iff]
      rintro w (⟨i, hi⟩ | hw)
      · obtain rfl : x' i = w := Subtype.ext hi
        exact mem_algebraicClosure_iff.2
          (isAlgebraic_algebraMap (⟨x' i, subset_adjoin F _ (mem_range_self i)⟩ :
            adjoin F (range x')))
      · have hwF : IsAlgebraic F w :=
          (isAlgebraic_algHom_iff L.val Subtype.val_injective).1 (hT _ hw)
        exact mem_algebraicClosure_iff.2 (hwF.tower_top (adjoin F (range x')))
    exact hle (hgen ▸ mem_top)
  -- Hence `x` is a transcendence basis of `L`.
  have := (isAlgebraic_adjoin_iff_top (F := F) (E := L) (S := L)).1 halg
  have hb := Algebra.IsAlgebraic.isTranscendenceBasis_of_lift_le_trdeg_of_finite F x' h
  exact hb.1.map' (f := L.val) Subtype.val_injective

/-- A subset `s` of a field extension `E / F` is algebraically independent over `F` if and only if
each `x ∈ s` is transcendental over the field `F(s \ {x})` generated by the other elements. -/
theorem algebraicIndependent_iff_forall_transcendental_adjoin {s : Set E} :
    AlgebraicIndependent F ((↑) : s → E) ↔ ∀ x ∈ s, Transcendental (adjoin F (s \ {x})) x := by
  simp_rw [IntermediateField.transcendental_adjoin_iff]
  refine ⟨fun h x hx ↦ ?_, fun h ↦ algebraicIndependent_of_finite' s (algebraMap F E).injective
    fun t hts _ _ a ha hat ↦ (h a ha).of_tower_top_of_subalgebra_le
      (Algebra.adjoin_mono (subset_sdiff_singleton hts hat))⟩
  have hsx : Subtype.val '' {y : s | y ≠ ⟨x, hx⟩} = s \ {x} := by
    ext y
    simp [and_comm]
  have := h.transcendental_adjoin (s := {y : s | y ≠ ⟨x, hx⟩}) (i := ⟨x, hx⟩) (by simp)
  rwa [hsx] at this

end TauCeti
