/-!
# Simple transcendental field extensions

A simple transcendental field extension has transcendence degree one.

Combined with the tower rule for linear independence, a family that is linearly independent over
the simple extension `k⟮x⟯` stays linearly independent over `k` after multiplying by arbitrary
powers of a transcendental element `x`.

The finite-power statement is the source of dimension growth in the theory of algebraic function
fields: multiplying a basis of `F / k⟮x⟯` by the powers `1, x, …, xⁿ` exhibits `(n + 1) [F : k(x)]`
functions that are independent over `k` and whose poles are controlled by those of `x`.

If a second element `y` is related to a transcendental `x` by an irreducible polynomial
`φ(X, Y)` over `k`, so that `(x, y)` is a point of the plane curve `φ = 0`, then `y` has degree
`deg_Y φ` over `k⟮x⟯`. Since `k⟮x⟯` is the fraction field of `k[x] ≅ k[X]`, this is Gauss's lemma:
`φ` is primitive over `k[X]`, so it stays irreducible over `k⟮x⟯` and is, up to a scalar, the
minimal polynomial of `y`.

## Main results

* `Transcendental.trdeg_adjoin_eq_one`: the field generated by one transcendental element has
  transcendence degree one.
* `Transcendental.linearIndependent_mul_pow`: a `k⟮x⟯`-linearly independent family in
  `F`, multiplied by the powers of a transcendental `x`, is `k`-linearly independent.
* `Transcendental.linearIndependent_mul_pow_fin`: the finite-power restriction used in
  dimension estimates.
* `Transcendental.irreducible_map_aeval_gen`: an irreducible `φ ∈ k[X][Y]` of positive degree in
  `Y` stays irreducible over `k⟮x⟯` (Gauss's lemma).
* `Transcendental.natDegree_minpoly_eq_natDegree_of_aevalAeval_eq_zero`: if moreover
  `φ(x, y) = 0`, the minimal polynomial of `y` over `k⟮x⟯` has degree `deg_Y φ`, and
  `Transcendental.finrank_eq_natDegree_of_aevalAeval_eq_zero` gives `[F : k⟮x⟯] = deg_Y φ` when
  `F = k⟮x, y⟯`.
-/

public section

open scoped IntermediateField Polynomial.Bivariate

namespace TauCeti

variable {k F : Type*} [Field k] [Field F] [Algebra k F] {x : F}

/-- The simple field generated by a transcendental element has transcendence degree one. -/
theorem _root_.Transcendental.trdeg_adjoin_eq_one {x : F} (hx : Transcendental k x) :
    Algebra.trdeg k k⟮x⟯ = 1 := by
  let y := IntermediateField.AdjoinSimple.gen k x
  have hy : Transcendental k y :=
    (transcendental_algebraMap_iff (algebraMap k⟮x⟯ F).injective).mp (by
      rwa [IntermediateField.AdjoinSimple.algebraMap_gen])
  have hi : AlgebraicIndependent k (fun z : ({y} : Set k⟮x⟯) ↦ (z : k⟮x⟯)) :=
    (algebraicIndependent_singleton_iff ⟨y, rfl⟩).mpr hy
  have hb : IsTranscendenceBasis k (fun z : ({y} : Set k⟮x⟯) ↦ (z : k⟮x⟯)) := by
    apply hi.isTranscendenceBasis_iff_isAlgebraic.mpr
    rw [Subtype.range_val, ← IntermediateField.isAlgebraic_adjoin_iff_top,
      IntermediateField.adjoin_adjoinSimple_gen_eq_top]
    let : Module.Finite (⊤ : IntermediateField k k⟮x⟯) k⟮x⟯ :=
      Module.Finite.top_left _ _
    infer_instance
  simpa using hb.cardinalMk_eq_trdeg.symm

/-- **The growth family**: multiplying a `k⟮x⟯`-linearly independent family by the powers of a
transcendental element `x` yields a `k`-linearly independent family.  This is Mathlib's tower rule
`linearIndependent_smul`, applied to the powers of `x` inside `k⟮x⟯`. -/
theorem _root_.Transcendental.linearIndependent_mul_pow (hx : _root_.Transcendental k x) {ι : Type*}
    {c : ι → F} (hc : LinearIndependent k⟮x⟯ c) :
    LinearIndependent k fun p : ι × ℕ ↦ c p.1 * x ^ p.2 := by
  have hgen : _root_.Transcendental k (IntermediateField.AdjoinSimple.gen k x) :=
    (transcendental_algebraMap_iff (algebraMap k⟮x⟯ F).injective).mp (by
      rwa [IntermediateField.AdjoinSimple.algebraMap_gen])
  simpa only [Algebra.smul_def, map_pow, IntermediateField.AdjoinSimple.algebraMap_gen,
    mul_comm] using
    (linearIndependent_equiv' (Equiv.prodComm ι ℕ)
      (g := fun p : ι × ℕ ↦ IntermediateField.AdjoinSimple.gen k x ^ p.2 • c p.1) rfl).mpr
      (linearIndependent_smul (Transcendental.linearIndependent_pow hgen) hc)

/-- Restrict the growth family to the first `n` powers of `x`. -/
theorem _root_.Transcendental.linearIndependent_mul_pow_fin (hx : _root_.Transcendental k x)
    {ι : Type*} {c : ι → F}
    (hc : LinearIndependent k⟮x⟯ c) (n : ℕ) :
    LinearIndependent k fun p : ι × Fin n ↦ c p.1 * x ^ (p.2 : ℕ) := by
  have h := (Transcendental.linearIndependent_mul_pow hx hc).comp
    (fun p : ι × Fin n ↦ (p.1, (p.2 : ℕ)))
    (fun p q hpq ↦ by
      simp only [Prod.mk.injEq, Fin.val_inj] at hpq
      exact Prod.ext hpq.1 hpq.2)
  simpa [Function.comp_def] using h

/-! ### Points of plane curves over `k⟮x⟯` -/

section PlaneCurve

open _root_.IntermediateField Polynomial

variable {y : F} {φ : k[X][Y]}

/-- A nonzero `φ ∈ k[X][Y]` vanishing at `(x, y)` with `x` transcendental has positive degree in
`Y`: a polynomial in `X` alone cannot vanish at `x`. -/
theorem _root_.Transcendental.natDegree_ne_zero_of_aevalAeval_eq_zero
    (hx : _root_.Transcendental k x) (hφ : φ ≠ 0) (h : aevalAeval x y φ = 0) :
    φ.natDegree ≠ 0 := by
  intro hdeg
  rw [eq_C_of_natDegree_eq_zero hdeg, aevalAeval_C] at h
  exact hφ (by rw [eq_C_of_natDegree_eq_zero hdeg,
    transcendental_iff_injective.mp hx (h.trans (map_zero _).symm), C_0])

/-- **Gauss's lemma over `k⟮x⟯`**: an irreducible `φ ∈ k[X][Y]` of positive degree in `Y` stays
irreducible over the field `k⟮x⟯` generated by a transcendental `x`, once `X` is sent to `x`. -/
theorem _root_.Transcendental.irreducible_map_aeval_gen (hx : _root_.Transcendental k x)
    (hφ : Irreducible φ) (hdeg : φ.natDegree ≠ 0) :
    Irreducible (φ.map (aeval (AdjoinSimple.gen k x)).toRingHom) := by
  have h := ((hφ.isPrimitive hdeg).irreducible_iff_irreducible_map_fraction_map
    (K := RatFunc k)).1 hφ
  -- transport along `k(X) ≃ k⟮x⟯`, which extends `k[X] → k⟮x⟯`
  let e := RatFunc.algEquivOfTranscendental x hx
  rw [← MulEquiv.irreducible_iff (mapEquiv e.toRingEquiv)] at h
  convert h using 1
  rw [mapEquiv_apply, Polynomial.map_map]
  congr 1
  refine RingHom.ext fun p ↦ ?_
  exact (RatFunc.algEquivOfTranscendental_algebraMap x hx p).symm

/-- **The degree of a point of a plane curve over `k⟮x⟯`**: if `x` is transcendental and `y`
satisfies `φ(x, y) = 0` for an irreducible `φ ∈ k[X][Y]`, then the minimal polynomial of `y` over
`k⟮x⟯` has degree `deg_Y φ`. -/
theorem _root_.Transcendental.natDegree_minpoly_eq_natDegree_of_aevalAeval_eq_zero
    (hx : _root_.Transcendental k x) (hφ : Irreducible φ) (h : aevalAeval x y φ = 0) :
    (minpoly k⟮x⟯ y).natDegree = φ.natDegree := by
  have hdeg := hx.natDegree_ne_zero_of_aevalAeval_eq_zero hφ.ne_zero h
  have hinj : Function.Injective (aeval (AdjoinSimple.gen k x)) := fun p q hpq ↦
    transcendental_iff_injective.mp hx <| by
      simpa only [AdjoinSimple.coe_aeval_gen_apply] using congrArg Subtype.val hpq
  have hroot : aeval y (φ.map (aeval (AdjoinSimple.gen k x)).toRingHom) = 0 := by
    rw [aeval_def, eval₂_map, ← h, aevalAeval_eq_eval₂]
    congr 1
    refine RingHom.ext fun p ↦ ?_
    simp
  have hirr := hx.irreducible_map_aeval_gen hφ hdeg
  rw [← minpoly.eq_of_irreducible hirr hroot, natDegree_mul_C (by simpa using hirr.ne_zero),
    natDegree_map_eq_of_injective hinj]

/-- **The degree of the function field of a plane curve over `k⟮x⟯`**: if `F = k⟮x, y⟯` with `x`
transcendental and `φ(x, y) = 0` for an irreducible `φ ∈ k[X][Y]`, then `[F : k⟮x⟯] = deg_Y φ`. -/
theorem _root_.Transcendental.finrank_eq_natDegree_of_aevalAeval_eq_zero
    (hx : _root_.Transcendental k x) (hxy : k⟮x, y⟯ = ⊤) (hφ : Irreducible φ)
    (h : aevalAeval x y φ = 0) : Module.finrank k⟮x⟯ F = φ.natDegree := by
  have hdeg := hx.natDegree_minpoly_eq_natDegree_of_aevalAeval_eq_zero hφ h
  have hint : IsIntegral k⟮x⟯ y := by
    by_contra hy
    rw [minpoly.eq_zero hy, natDegree_zero] at hdeg
    exact hx.natDegree_ne_zero_of_aevalAeval_eq_zero hφ.ne_zero h hdeg.symm
  have htop : k⟮x⟯⟮y⟯ = ⊤ := restrictScalars_injective k <| by
    rw [adjoin_simple_adjoin_simple, hxy, restrictScalars_top]
  rw [← finrank_top', ← htop, adjoin.finrank hint, hdeg]

end PlaneCurve

end TauCeti
