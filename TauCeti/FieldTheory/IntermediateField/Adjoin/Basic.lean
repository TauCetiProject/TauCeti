import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.Minpoly.Field

/-!
# Membership in intermediate fields obtained by adjoining elements

Linear expressions `a + b * x` with coefficients in an intermediate field `F` belong to
`F ⊔ K⟮x⟯`, without any algebraic relation on `x`. The image of `K(S)` under a tower map `L → M`
is `K(S')` for the image `S'` of `S`; in particular, the image of `K⟮x⟯` is `K⟮x⟯` for the image
of `x`. An intermediate field `E` carrying a compatible `F`-algebra structure and containing a set
`s` receives a canonical `F`-algebra embedding from `IntermediateField.adjoin F s`
(`TauCeti.IntermediateField.adjoinAlgHom`). A root of an irreducible polynomial generates the bottom
intermediate field exactly when the polynomial is linear. Adjoining the elements of a family indexed
by `Option α` splits as adjoining those indexed by `some i` and then the one indexed by `none`.
Every element of the simple intermediate field `K⟮y⟯` generated by an element `y` integral over `K`
is itself integral over `K`.
-/

public section

namespace TauCeti.IntermediateField

open _root_.IntermediateField

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- If `a` and `b` lie in `F`, then `a + b * x` lies in `F ⊔ K⟮x⟯`. -/
theorem mem_sup_adjoin_of_exists_add_mul {F : IntermediateField K L} {x y : L}
    (hy : ∃ a b : L, a ∈ F ∧ b ∈ F ∧ y = a + b * x) :
    y ∈ F ⊔ K⟮x⟯ := by
  obtain ⟨a, b, ha, hb, rfl⟩ := hy
  exact add_mem (le_sup_left (b := K⟮x⟯) ha)
    (mul_mem (le_sup_left (b := K⟮x⟯) hb) (le_sup_right (a := F) (mem_adjoin_simple_self K x)))

section Tower

variable {M : Type*} [Field M] [Algebra K M] [Algebra L M] [IsScalarTower K L M]

/-- The image of `K(S)` under a tower map `L → M` is the subfield `K(S')` generated by the image
`S'` of `S`. -/
theorem range_algebraMap_adjoin (S : Set L) :
    Set.range (algebraMap (adjoin K S) M) = (adjoin K (algebraMap L M '' S) : Set M) := by
  -- The map `K(S) → M` is the inclusion `K(S) → L` followed by `L → M`.
  rw [IsScalarTower.algebraMap_eq (adjoin K S) L M, RingHom.coe_comp, Set.range_comp,
    ← adjoin_eq_range_algebraMap_adjoin]
  -- The image of `K(S)` under `L → M` is its image under the tower `K`-algebra map.
  rw [← IsScalarTower.coe_toAlgHom' K L M, ← coe_map, adjoin_map]

/-- The image of `K(x)` under a tower map `L → M` is the subfield `K(x)` generated by the image of
`x`. -/
theorem range_algebraMap_adjoin_simple (x : L) :
    Set.range (algebraMap K⟮x⟯ M) = (K⟮algebraMap L M x⟯ : Set M) := by
  rw [range_algebraMap_adjoin, Set.image_singleton]

end Tower

open Polynomial in
/-- A root of an irreducible polynomial lies in the base field, that is, generates the bottom
intermediate field, exactly when the polynomial is linear. -/
theorem adjoin_simple_eq_bot_iff_natDegree_eq_one {p : K[X]} {x : L} (hp : Irreducible p)
    (hx : aeval x p = 0) :
    K⟮x⟯ = ⊥ ↔ p.natDegree = 1 := by
  -- `p` is a nonzero constant multiple of the minimal polynomial of `x`.
  have hdeg : (minpoly K x).natDegree = p.natDegree := by
    rw [← minpoly.eq_of_irreducible hp hx,
      natDegree_mul_C (inv_ne_zero (leadingCoeff_ne_zero.mpr hp.ne_zero))]
  rw [adjoin_simple_eq_bot_iff, mem_bot, ← RingHom.coe_range, SetLike.mem_coe,
    ← minpoly.natDegree_eq_one_iff, hdeg]

/-- If an intermediate field `E` of `Ω / L` carries an `F`-algebra structure compatible with `Ω`
and contains `s`, there is a canonical `F`-algebra homomorphism `adjoin F s →ₐ[F] E` preserving
underlying elements of `Ω`. -/
def adjoinAlgHom (F : Type*) {L Ω : Type*} [Field F] [Field L] [Field Ω]
    [Algebra F Ω] [Algebra L Ω] {E : IntermediateField L Ω} [Algebra F E]
    [IsScalarTower F E Ω] {s : Set Ω} (hs : s ⊆ E) :
    adjoin F s →ₐ[F] E :=
  let EF : IntermediateField F Ω :=
    { E.toSubfield with
      algebraMap_mem' := fun c ↦ by
        rw [IsScalarTower.algebraMap_apply F E Ω]
        exact (algebraMap F E c).property }
  have hle : adjoin F s ≤ EF := adjoin_le_iff.mpr hs
  { toFun := fun z ↦ ⟨z.val, hle z.property⟩
    map_one' := rfl
    map_mul' := fun _ _ ↦ rfl
    map_zero' := rfl
    map_add' := fun _ _ ↦ rfl
    commutes' := fun c ↦ Subtype.ext <| IsScalarTower.algebraMap_apply F E Ω c }

/-- The inclusion `adjoinAlgHom` preserves underlying elements of `Ω`. -/
@[simp]
theorem coe_adjoinAlgHom (F : Type*) {L Ω : Type*} [Field F] [Field L] [Field Ω]
    [Algebra F Ω] [Algebra L Ω] {E : IntermediateField L Ω} [Algebra F E]
    [IsScalarTower F E Ω] {s : Set Ω} (hs : s ⊆ E) (z : adjoin F s) :
    (adjoinAlgHom F hs z : Ω) = z :=
  (rfl)

/-- For a singleton set `{x}`, `adjoinAlgHom` sends the distinguished generator of `F⟮x⟯` to `x`. -/
@[simp]
theorem adjoinAlgHom_gen (F : Type*) {L Ω : Type*} [Field F] [Field L] [Field Ω]
    [Algebra F Ω] [Algebra L Ω] {E : IntermediateField L Ω} [Algebra F E]
    [IsScalarTower F E Ω] {x : Ω} (hs : ({x} : Set Ω) ⊆ E) :
    adjoinAlgHom F hs (AdjoinSimple.gen F x) = ⟨x, hs rfl⟩ :=
  (rfl)

/-- The `adjoin F s`-algebra structure on `E` induced by `adjoinAlgHom` is compatible with the
inclusions into `Ω`. -/
theorem isScalarTower_adjoinAlgHom (F : Type*) {L Ω : Type*} [Field F] [Field L] [Field Ω]
    [Algebra F Ω] [Algebra L Ω] {E : IntermediateField L Ω} [Algebra F E]
    [IsScalarTower F E Ω] {s : Set Ω} (hs : s ⊆ E) :
    letI := (adjoinAlgHom F hs).toAlgebra
    IsScalarTower (adjoin F s) E Ω :=
  letI := (adjoinAlgHom F hs).toAlgebra
  .of_algebraMap_eq fun _ ↦ by
    simp [RingHom.algebraMap_toAlgebra]

end TauCeti.IntermediateField

namespace IntermediateField

/-- Adjoining the elements `r (some i)` and then the element `r none` adjoins all the elements
`r i`. -/
theorem adjoin_range_comp_some_sup_adjoin_singleton {α K F : Type*} [Field K] [Field F]
    [Algebra K F] (r : Option α → F) :
    adjoin K (Set.range (r ∘ some)) ⊔ adjoin K {r none} = adjoin K (Set.range r) := by
  rw [← adjoin_union, Set.union_singleton, ← Option.range_eq]

end IntermediateField

open scoped IntermediateField in
/-- Every element of the simple intermediate field `K⟮y⟯` generated by an element `y` integral
over `K` is integral over `K`. -/
theorem IsIntegral.of_mem_adjoin_simple {K L : Type*} [Field K] [Field L] [Algebra K L]
    {x y : L} (hy : IsIntegral K y) (hx : x ∈ K⟮y⟯) : IsIntegral K x := by
  have := IntermediateField.adjoin.finiteDimensional hy
  exact IntermediateField.isIntegral_iff.mp (.of_finite K ⟨x, hx⟩)
