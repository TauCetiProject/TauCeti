module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.FieldTheory.Minpoly.Basic
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.IntermediateField.Algebraic

/-!
# Membership and generation in intermediate fields obtained by adjoining elements

Linear expressions `a + b * x` with coefficients in an intermediate field `F` belong to
`F ⊔ K⟮x⟯`, without any algebraic relation on `x`. The image of `K⟮x⟯` under a tower map `L → M`
is `K⟮x⟯` for the image of `x`. A root of an irreducible polynomial generates the bottom
intermediate field exactly when the polynomial is linear, and an element of a finite-dimensional
intermediate field `F / K` whose minimal polynomial has degree at least `[F : K]` generates `F`.
-/

public section

namespace TauCeti.IntermediateField

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- If `a` and `b` lie in `F`, then `a + b * x` lies in `F ⊔ K⟮x⟯`. -/
theorem mem_sup_adjoin_of_exists_add_mul {F : IntermediateField K L} {x y : L}
    (hy : ∃ a b : L, a ∈ F ∧ b ∈ F ∧ y = a + b * x) :
    y ∈ F ⊔ IntermediateField.adjoin K {x} := by
  rcases hy with ⟨a, b, ha, hb, rfl⟩
  have hF : F ≤ F ⊔ IntermediateField.adjoin K {x} := le_sup_left
  have hx : IntermediateField.adjoin K {x} ≤ F ⊔ IntermediateField.adjoin K {x} :=
    le_sup_right
  exact add_mem (hF ha)
    (mul_mem (hF hb) (hx (IntermediateField.mem_adjoin_of_mem K (Set.mem_singleton x))))

/-- The image of `K(x)` under a tower map `L → M` is the subfield `K(x)` generated by the image of
`x`. -/
theorem range_algebraMap_adjoin_simple {M : Type*} [Field M] [Algebra K M] [Algebra L M]
    [IsScalarTower K L M] (x : L) :
    Set.range (algebraMap (IntermediateField.adjoin K {x}) M) =
      (IntermediateField.adjoin K {algebraMap L M x} : Set M) := by
  have hmap :
      ((IsScalarTower.toAlgHom K L M).comp (IntermediateField.adjoin K {x}).val).fieldRange =
        IntermediateField.adjoin K {algebraMap L M x} := by
    rw [IntermediateField.fieldRange_comp_val, IntermediateField.adjoin_map]
    simp only [Set.image_singleton, IsScalarTower.toAlgHom_apply]
  -- Both maps from `K⟮x⟯` to `M` are the inclusion followed by `L → M`.
  exact congrArg SetLike.coe hmap

open Polynomial in
/-- A root of an irreducible polynomial lies in the base field, that is, generates the bottom
intermediate field, exactly when the polynomial is linear. -/
theorem adjoin_simple_eq_bot_iff_natDegree_eq_one {p : K[X]} {x : L} (hp : Irreducible p)
    (hx : aeval x p = 0) :
    IntermediateField.adjoin K {x} = ⊥ ↔ p.natDegree = 1 := by
  rw [IntermediateField.adjoin_simple_eq_bot_iff, IntermediateField.mem_bot,
    ← RingHom.coe_range, SetLike.mem_coe, ← minpoly.natDegree_eq_one_iff,
    ← minpoly.eq_of_irreducible hp hx,
    natDegree_mul_C (inv_ne_zero (leadingCoeff_ne_zero.mpr hp.ne_zero))]

/-- An element `x` of a finite-dimensional intermediate field `F / K` whose minimal polynomial has
degree at least `[F : K]` generates `F` over `K`. -/
theorem adjoin_simple_eq_of_finrank_le_natDegree_minpoly {F : IntermediateField K L}
    [FiniteDimensional K F] {x : L} (hx : x ∈ F)
    (hdeg : Module.finrank K F ≤ (minpoly K x).natDegree) :
    IntermediateField.adjoin K {x} = F := by
  have hx_int : IsIntegral K x :=
    IntermediateField.isIntegral_iff.mp (Algebra.IsIntegral.isIntegral (⟨x, hx⟩ : F))
  refine IntermediateField.eq_of_le_of_finrank_le
    (IntermediateField.adjoin_simple_le_iff.mpr hx) ?_
  rwa [IntermediateField.adjoin.finrank hx_int]

end TauCeti.IntermediateField

namespace IntermediateField

open scoped IntermediateField

/-- **The generator of `K⟮α⟯` generates it**: inside the field `K⟮α⟯`, adjoining the generator gives
everything. -/
theorem adjoin_adjoinSimple_gen_eq_top {K L : Type*} [Field K] [Field L] [Algebra K L] (α : L) :
    K⟮AdjoinSimple.gen K α⟯ = ⊤ := by
  apply map_injective K⟮α⟯.val
  rw [adjoin_map, Set.image_singleton, coe_val, AdjoinSimple.coe_gen, ← AlgHom.fieldRange_eq_map,
    fieldRange_val]

end IntermediateField
