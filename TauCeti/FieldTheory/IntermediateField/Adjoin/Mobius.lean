module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import TauCeti.Algebra.Field.LinearFractional

/-!
# Simple intermediate fields generated by Möbius images

For a field extension `L / K` and coefficients `a, b, c, d ∈ K` with `a * d - b * c ≠ 0`, the
Möbius image `(a x + b) / (c x + d)` of any `x ∈ L` generates the same simple intermediate field
over `K` as `x` itself, including at the pole `c x + d = 0` where Lean's division-by-zero
convention `y / 0 = 0` sends `x = -d / c ∈ K` to `0 ∈ K` so both intermediate fields are `⊥`. No
assumption on the characteristic is needed.

Consequently, integrality over `K`, algebraicity over `K`, and the degree of the minimal polynomial
over `K` are all invariant under nonsingular `K`-rational Möbius transformations.

## Main results

* `TauCeti.IntermediateField.adjoin_simple_mul_add_div_mul_add`:
  `K⟮(a x + b) / (c x + d)⟯ = K⟮x⟯` when `a * d - b * c ≠ 0`.
* `TauCeti.isIntegral_mul_add_div_mul_add_iff` and
  `TauCeti.isAlgebraic_mul_add_div_mul_add_iff`: integrality and algebraicity over `K` are
  preserved.
* `TauCeti.minpoly.natDegree_mul_add_div_mul_add`: `(a x + b) / (c x + d)` and `x` have minimal
  polynomials over `K` of equal degree.
-/

public section

open scoped IntermediateField

namespace TauCeti.IntermediateField

open _root_.IntermediateField hiding algebraMap_mem

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- A Möbius transformation `(a x + b) / (c x + d)` with coefficients in `K` and nonzero
determinant `a * d - b * c` preserves the simple intermediate field `K⟮x⟯`, including at the pole
`c x + d = 0` where both sides equal `⊥`. -/
theorem adjoin_simple_mul_add_div_mul_add (x : L) {a b c d : K} (hdet : a * d - b * c ≠ 0) :
    K⟮(algebraMap K L a * x + algebraMap K L b) /
      (algebraMap K L c * x + algebraMap K L d)⟯ = K⟮x⟯ := by
  set y : L := (algebraMap K L a * x + algebraMap K L b) /
    (algebraMap K L c * x + algebraMap K L d)
  by_cases hx : algebraMap K L c * x + algebraMap K L d = 0
  · have hy0 : y = 0 := by simp [y, hx]
    rw [hy0, TauCeti.eq_map_neg_div_of_map_mul_add_map_eq_zero (algebraMap K L) hdet hx,
      adjoin_simple_eq_bot_iff.mpr (zero_mem ⊥),
      adjoin_simple_eq_bot_iff.mpr (algebraMap_mem ⊥ _)]
  · have hdetL : algebraMap K L a * algebraMap K L d -
        algebraMap K L b * algebraMap K L c ≠ 0 := by
      simpa [map_sub, map_mul] using (map_ne_zero (algebraMap K L)).mpr hdet
    have hxy : x = (algebraMap K L d * y - algebraMap K L b) /
        (-algebraMap K L c * y + algebraMap K L a) :=
      (TauCeti.moebius_inv_moebius hdetL hx).symm
    refine le_antisymm (adjoin_simple_le_iff.mpr ?_) (adjoin_simple_le_iff.mpr ?_)
    · exact div_mem
        (add_mem (mul_mem (algebraMap_mem _ a) (mem_adjoin_simple_self K x)) (algebraMap_mem _ b))
        (add_mem (mul_mem (algebraMap_mem _ c) (mem_adjoin_simple_self K x)) (algebraMap_mem _ d))
    · rw [hxy]
      exact div_mem
        (sub_mem (mul_mem (algebraMap_mem _ d) (mem_adjoin_simple_self K y)) (algebraMap_mem _ b))
        (add_mem (mul_mem (neg_mem (algebraMap_mem _ c)) (mem_adjoin_simple_self K y))
          (algebraMap_mem _ a))

end TauCeti.IntermediateField

namespace TauCeti

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- If `K⟮x⟯ = K⟮y⟯` and `y` is integral over `K`, then `x` is integral over `K`. -/
private theorem isIntegral_of_adjoin_simple_eq {x y : L} (hadj : K⟮x⟯ = K⟮y⟯)
    (hy : IsIntegral K y) : IsIntegral K x := by
  have : FiniteDimensional K K⟮x⟯ := hadj ▸ IntermediateField.adjoin.finiteDimensional hy
  simpa using (IsIntegral.of_finite K (IntermediateField.AdjoinSimple.gen K x)).map
    (IntermediateField.val K⟮x⟯)

/-- Integrality over a base field `K` is invariant under nonsingular `K`-rational Möbius
transformations, including at the pole. -/
theorem isIntegral_mul_add_div_mul_add_iff (x : L) {a b c d : K} (hdet : a * d - b * c ≠ 0) :
    IsIntegral K ((algebraMap K L a * x + algebraMap K L b) /
      (algebraMap K L c * x + algebraMap K L d)) ↔ IsIntegral K x := by
  have hadj := TauCeti.IntermediateField.adjoin_simple_mul_add_div_mul_add x hdet
  exact ⟨isIntegral_of_adjoin_simple_eq hadj.symm, isIntegral_of_adjoin_simple_eq hadj⟩

/-- Algebraicity over a base field `K` is invariant under nonsingular `K`-rational Möbius
transformations, including at the pole. -/
theorem isAlgebraic_mul_add_div_mul_add_iff (x : L) {a b c d : K} (hdet : a * d - b * c ≠ 0) :
    IsAlgebraic K ((algebraMap K L a * x + algebraMap K L b) /
      (algebraMap K L c * x + algebraMap K L d)) ↔ IsAlgebraic K x := by
  rw [isAlgebraic_iff_isIntegral, isAlgebraic_iff_isIntegral,
    isIntegral_mul_add_div_mul_add_iff x hdet]

namespace minpoly

/-- Nonsingular `K`-rational Möbius transformations preserve the degree of the minimal polynomial
over `K`, including at transcendental elements (where both degrees are `0`) and at the pole (where
both degrees are `1`). -/
theorem natDegree_mul_add_div_mul_add (x : L) {a b c d : K} (hdet : a * d - b * c ≠ 0) :
    (minpoly K ((algebraMap K L a * x + algebraMap K L b) /
      (algebraMap K L c * x + algebraMap K L d))).natDegree = (minpoly K x).natDegree := by
  by_cases hx : IsIntegral K x
  · have hy : IsIntegral K _ := (isIntegral_mul_add_div_mul_add_iff x hdet).mpr hx
    rw [← IntermediateField.adjoin.finrank hy, ← IntermediateField.adjoin.finrank hx,
      TauCeti.IntermediateField.adjoin_simple_mul_add_div_mul_add x hdet]
  · have hy : ¬IsIntegral K _ := mt (isIntegral_mul_add_div_mul_add_iff x hdet).mp hx
    rw [minpoly.eq_zero hy, minpoly.eq_zero hx]

end minpoly

end TauCeti
