module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.RingTheory.Algebraic.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# Subalgebras containing intermediate fields generated by algebraic sets

When a set `s` in a field extension `Ω / F` consists of elements algebraic over `F`, the
intermediate field `IntermediateField.adjoin F s` has the same underlying elements as the
subalgebra `Algebra.adjoin F s`. Consequently, any `F`-subalgebra of an `F`-algebra `M` that
contains the images of the generators `x ∈ s` under an `F`-algebra homomorphism
`IntermediateField.adjoin F s →ₐ[F] M` contains its entire image.

## Main results

* `TauCeti.IntermediateField.map_mem_of_subset_subalgebra`: if every element of `s` is algebraic
  over `F` and an `F`-subalgebra contains the image of `s` under `f : adjoin F s →ₐ[F] M`, then it
  contains `f z` for all `z : adjoin F s`.
-/

public section

namespace TauCeti.IntermediateField

open _root_.IntermediateField

/-- If every element of `s` is algebraic over `F` and an `F`-subalgebra `S` of `M` contains the
images of the generators `x ∈ s` under an `F`-algebra homomorphism `f : adjoin F s →ₐ[F] M`, then
`S` contains the entire image of `f`. -/
theorem map_mem_of_subset_subalgebra {F Ω M : Type*} [Field F] [Field Ω] [Algebra F Ω]
    [Semiring M] [Algebra F M] {s : Set Ω} (hs : ∀ x ∈ s, IsAlgebraic F x)
    (f : adjoin F s →ₐ[F] M) {S : Subalgebra F M}
    (hmem : ∀ x (hx : x ∈ s), f ⟨x, subset_adjoin F s hx⟩ ∈ S) (z : adjoin F s) :
    f z ∈ S := by
  have hz : (z : Ω) ∈ Algebra.adjoin F s := by
    rw [← adjoin_toSubalgebra_of_isAlgebraic hs]
    exact z.property
  have hle : Algebra.adjoin F s ≤ (S.comap f).map (adjoin F s).val :=
    Algebra.adjoin_le fun x hx ↦
      ⟨⟨x, subset_adjoin F s hx⟩, (Subalgebra.mem_comap _ _ _).mpr (hmem x hx), rfl⟩
  obtain ⟨w, hw, hwz⟩ := Subalgebra.mem_map.mp (hle hz)
  exact Subtype.ext hwz ▸ hw

end TauCeti.IntermediateField
