module

public import TauCeti.Algebra.Category.Ring.AdjoinFinset
public import TauCeti.FieldTheory.IntermediateField.Algebraic
public import Mathlib.CategoryTheory.Filtered.Final
public import Mathlib.CategoryTheory.Limits.Final
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# An algebraic extension as a filtered colimit of finite subextensions

The finite intermediate fields form a directed system under inclusion. For an algebraic
extension `L / K`, their inclusion cocone exhibits `L` as a colimit in commutative rings.
Applying `Spec` to `finiteSubextensionDiagram` gives the affine inverse system used in
finite-presentation descent of a contraction, its target and its projective embedding.

The diagram and cocone reuse the monotone-subalgebra construction underlying
`TauCeti.CommRingCat.adjoinFinsetDiagram` and `TauCeti.CommRingCat.adjoinFinsetCocone`.
The colimit is transported from `TauCeti.CommRingCat.isColimitAdjoinFinsetCocone`
along the final functor taking a finite set to its generated intermediate field.
-/

public section

open CategoryTheory Limits

namespace TauCeti.IntermediateField

variable (K L : Type*) [Field K] [Field L] [Algebra K L]

/-- The commutative rings underlying finite intermediate fields, with their inclusions. -/
noncomputable def finiteSubextensionDiagram : ↥(finiteExts K L) ⥤ CommRingCat :=
  CommRingCat.monotoneSubalgebraDiagram K L (fun E : ↥(finiteExts K L) ↦ E.1.toSubalgebra)
    (fun _ _ h ↦ h)

/-- The inclusion cocone from finite subextensions into the ambient extension. -/
noncomputable def finiteSubextensionCocone : Cocone (finiteSubextensionDiagram K L) := by
  unfold finiteSubextensionDiagram
  exact CommRingCat.monotoneSubalgebraCocone K L
    (fun E : ↥(finiteExts K L) ↦ E.1.toSubalgebra) (fun _ _ h ↦ h)

/-- A stage of the finite-subextension diagram is its underlying commutative ring. -/
@[simp] theorem finiteSubextensionDiagram_obj (E : ↥(finiteExts K L)) :
    (finiteSubextensionDiagram K L).obj E = CommRingCat.of E.1 := (rfl)

/-- Transition maps are inclusions of intermediate fields. -/
@[simp] theorem finiteSubextensionDiagram_map {E F : ↥(finiteExts K L)} (f : E ⟶ F) :
    eqToHom (finiteSubextensionDiagram_obj K L E).symm ≫
        (finiteSubextensionDiagram K L).map f ≫
          eqToHom (finiteSubextensionDiagram_obj K L F) =
      CommRingCat.ofHom (_root_.IntermediateField.inclusion (leOfHom f)).toRingHom := by
  symm
  apply (conj_eqToHom_iff_heq' _ _ _ _).2
  rfl

/-- The cocone point is the ambient extension. -/
@[simp] theorem finiteSubextensionCocone_pt :
    (finiteSubextensionCocone K L).pt = CommRingCat.of L := (rfl)

/-- Cocone legs are the inclusions into the ambient extension. -/
@[simp] theorem finiteSubextensionCocone_ι_app (E : ↥(finiteExts K L)) :
    eqToHom (finiteSubextensionDiagram_obj K L E).symm ≫
        (finiteSubextensionCocone K L).ι.app E ≫
          eqToHom (finiteSubextensionCocone_pt K L) =
      CommRingCat.ofHom (algebraMap E.1 L) := by
  symm
  apply (conj_eqToHom_iff_heq' _ _ _ _).2
  rfl

variable [Algebra.IsAlgebraic K L]

/-- The field generated by a finite set, regarded as a finite subextension. -/
@[expose]
noncomputable def adjoinFinsetToFiniteExts : Finset L ⥤ ↥(finiteExts K L) :=
  (show Monotone (fun s : Finset L ↦
      (⟨_root_.IntermediateField.adjoin K (s : Set L),
        show FiniteDimensional K (_root_.IntermediateField.adjoin K (s : Set L)) from
          inferInstance⟩ : ↥(finiteExts K L))) from
    fun _ _ h ↦ _root_.IntermediateField.adjoin.mono K _ _ (Finset.coe_subset.mpr h)).functor

/-- The field generated by `s` is the stage selected by the reindexing functor. -/
@[simp] theorem adjoinFinsetToFiniteExts_obj (s : Finset L) :
    ((adjoinFinsetToFiniteExts K L).obj s).1 =
      _root_.IntermediateField.adjoin K (s : Set L) := (rfl)

instance : (adjoinFinsetToFiniteExts K L).Final := by
  apply Functor.final_of_exists_of_isFiltered
  · intro E
    have : FiniteDimensional K E.1.toSubalgebra := E.2
    obtain ⟨s, hs⟩ := E.1.fg_of_fg_toSubalgebra
      ((Subalgebra.fg_iff_finiteType E.1.toSubalgebra).mpr inferInstance)
    have hs' : E = (adjoinFinsetToFiniteExts K L).obj s :=
      Subtype.ext (by rw [adjoinFinsetToFiniteExts_obj, hs])
    exact ⟨s, ⟨homOfLE hs'.le⟩⟩
  · intro E s f g
    exact ⟨s, 𝟙 s, Subsingleton.elim _ _⟩

/-- Field adjunction and algebra adjunction agree in an algebraic extension. -/
private noncomputable def adjoinFinsetDiagramIso :
    adjoinFinsetToFiniteExts K L ⋙ finiteSubextensionDiagram K L ≅
      CommRingCat.adjoinFinsetDiagram K L :=
  NatIso.ofComponents (fun s ↦
    (Subalgebra.equivOfEq _ _ (_root_.IntermediateField.adjoin_toSubalgebra (F := K)
      (s : Set L))).toRingEquiv.toCommRingCatIso) (by
    intro s t f
    ext x
    rfl)

/-- The reindexed finite-subextension cocone agrees with finite algebra adjunction. -/
private noncomputable def adjoinFinsetCoconeIso :
    (Cocone.precompose (adjoinFinsetDiagramIso K L).hom).obj
        (CommRingCat.adjoinFinsetCocone K L) ≅
      (finiteSubextensionCocone K L).whisker (adjoinFinsetToFiniteExts K L) :=
  Cocone.ext (Iso.refl _) (by intro s; ext x; rfl)

/-- An algebraic extension is the filtered colimit of its finite intermediate fields. -/
noncomputable def isColimitFiniteSubextensionCocone :
    IsColimit (finiteSubextensionCocone K L) := by
  apply (Functor.Final.isColimitWhiskerEquiv (adjoinFinsetToFiniteExts K L) _).toFun
  apply IsColimit.ofIsoColimit _ (adjoinFinsetCoconeIso K L)
  exact (IsColimit.precomposeHomEquiv (adjoinFinsetDiagramIso K L)
    (CommRingCat.adjoinFinsetCocone K L)).symm
    (CommRingCat.isColimitAdjoinFinsetCocone K L)

end TauCeti.IntermediateField
