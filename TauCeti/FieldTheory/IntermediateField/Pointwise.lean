module

public import Mathlib.Algebra.Algebra.Subalgebra.Pointwise
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# Pointwise actions on intermediate fields

A monoid `R` acting on a field `L` by ring automorphisms that fix the base field `K` acts on the
intermediate fields of `L / K`, by applying the action to every element: `a • E` is the image of
`E` under the algebra map `x ↦ a • x`. For the automorphism group `L ≃ₐ[K] L` this is
`σ • E = E.map σ`, the conjugate of `E` by `σ`. Its orbits are the classes of conjugate subfields.

This is the intermediate-field analogue of Mathlib's `Subalgebra.pointwiseMulAction`, and as there
the action is an instance only in the `Pointwise` locale.

## Main definitions

* `IntermediateField.pointwiseMulAction`: the pointwise action on intermediate fields.

## Main results

* `IntermediateField.coe_pointwise_smul`: the carrier of `a • E` is `a • (E : Set L)`.
* `IntermediateField.algEquiv_smul_eq_map`: an automorphism acts by `IntermediateField.map`.
* `IntermediateField.mem_pointwise_smul_iff_inv_smul_mem`: membership in a translate.
* `IntermediateField.pointwise_smul_adjoin_simple`: the conjugate of `K⟮x⟯` by `σ` is `K⟮σ x⟯`.
-/

public section

namespace IntermediateField

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

section Monoid

variable {R : Type*} [Monoid R] [MulSemiringAction R L] [SMulCommClass R K L]

/-- The action on intermediate fields obtained by applying the action to every element.

This is available as an instance in the `Pointwise` locale. -/
@[instance_reducible]
protected def pointwiseMulAction : MulAction R (IntermediateField K L) where
  smul a E := E.map (MulSemiringAction.toAlgHom K L a)
  one_smul E := (congr_arg (fun f => E.map f) (AlgHom.ext <| one_smul R)).trans E.map_id
  mul_smul _a₁ _a₂ E :=
    (congr_arg (fun f => E.map f) (AlgHom.ext <| mul_smul _ _)).trans (E.map_map _ _).symm

scoped[Pointwise] attribute [instance] IntermediateField.pointwiseMulAction

open scoped Pointwise

/-- The translate `a • E` is the image of `E` under the algebra map induced by `a`. -/
theorem pointwise_smul_def (a : R) (E : IntermediateField K L) :
    a • E = E.map (MulSemiringAction.toAlgHom K L a) :=
  (rfl)

/-- The carrier of a translate is the translate of the carrier. -/
@[simp, norm_cast]
theorem coe_pointwise_smul (a : R) (E : IntermediateField K L) :
    ↑(a • E) = a • (E : Set L) :=
  (rfl)

/-- Translating an element of `E` gives an element of the translate of `E`. -/
theorem smul_mem_pointwise_smul (a : R) {x : L} {E : IntermediateField K L} (hx : x ∈ E) :
    a • x ∈ a • E :=
  (Set.smul_mem_smul_set hx : _ ∈ a • (E : Set L))

/-- Translation is monotone. -/
theorem pointwise_smul_mono (a : R) {E E' : IntermediateField K L} (h : E ≤ E') :
    a • E ≤ a • E' :=
  map_mono _ h

end Monoid

section Group

variable {R : Type*} [Group R] [MulSemiringAction R L] [SMulCommClass R K L]

open scoped Pointwise

/-- An element lies in `a • E` exactly when its translate by `a⁻¹` lies in `E`. -/
theorem mem_pointwise_smul_iff_inv_smul_mem {a : R} {E : IntermediateField K L} {x : L} :
    x ∈ a • E ↔ a⁻¹ • x ∈ E :=
  Set.mem_smul_set_iff_inv_smul_mem

/-- For a group action, `a • x ∈ a • E` exactly when `x ∈ E`. -/
@[simp]
theorem smul_mem_pointwise_smul_iff {a : R} {E : IntermediateField K L} {x : L} :
    a • x ∈ a • E ↔ x ∈ E :=
  Set.smul_mem_smul_set_iff

end Group

open scoped Pointwise

/-- An automorphism of `L / K` acts on intermediate fields by `IntermediateField.map`: the translate
`σ • E` is the conjugate subfield `σ(E)`. -/
theorem algEquiv_smul_eq_map (σ : L ≃ₐ[K] L) (E : IntermediateField K L) :
    σ • E = E.map (σ : L →ₐ[K] L) :=
  (rfl)

/-- The conjugate `σ(adjoin K S)` is generated by the image `σ(S)`. -/
theorem pointwise_smul_adjoin (σ : L ≃ₐ[K] L) (S : Set L) :
    σ • adjoin K S = adjoin K (σ '' S) := by
  rw [algEquiv_smul_eq_map]
  exact adjoin_map K S (σ : L →ₐ[K] L)

/-- The conjugate `σ(K⟮x⟯)` of a simple extension is `K⟮σ x⟯`. -/
@[simp]
theorem pointwise_smul_adjoin_simple (σ : L ≃ₐ[K] L) (x : L) :
    σ • K⟮x⟯ = K⟮σ x⟯ := by
  rw [pointwise_smul_adjoin, Set.image_singleton]

end IntermediateField
