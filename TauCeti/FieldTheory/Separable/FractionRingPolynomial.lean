module

public import Mathlib.FieldTheory.TranscendentalSeparable
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.Algebraic.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# The rational function field is separably generated

For every field `k`, perfect or not, the field `k(s) = FractionRing k[s]` of rational functions in
one variable is separably generated over `k`: `{s}` is a transcendence basis, and `k(s)` is
generated by `s` as a field, so it is separable over `k(s)` itself
(`TauCeti.instIsSeparablyGeneratedFractionRingPolynomial`). Mathlib's instance covers only perfect
`k`. The extension is not algebraic, so it is not `Algebra.IsSeparable`.
-/

public section

open Polynomial

namespace TauCeti

variable (k : Type*) [Field k]

/-- The field of rational functions `FractionRing k[X]` is generated as a field over `k` by `X`. -/
theorem adjoin_algebraMap_X_eq_top :
    IntermediateField.adjoin k {algebraMap k[X] (FractionRing k[X]) X} = ⊤ := by
  refine eq_top_iff.mpr fun z _ ↦ ?_
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := k[X]) z
  have hmem : ∀ p : k[X], algebraMap k[X] (FractionRing k[X]) p ∈
      IntermediateField.adjoin k {algebraMap k[X] (FractionRing k[X]) X} := fun p ↦ by
    have : algebraMap k[X] (FractionRing k[X]) p =
        aeval (algebraMap k[X] (FractionRing k[X]) X) p := by
      rw [Polynomial.aeval_algebraMap_apply, Polynomial.aeval_X_left_apply]
    rw [this]
    exact IntermediateField.algebra_adjoin_le_adjoin k _
      (Polynomial.aeval_mem_adjoin_singleton k _)
  exact div_mem (hmem a) (hmem b)

/-- `X` is a transcendence basis of `FractionRing k[X]` over `k`. -/
theorem isTranscendenceBasis_algebraMap_X :
    IsTranscendenceBasis k fun _ : Unit ↦ algebraMap k[X] (FractionRing k[X]) X := by
  have : Algebra.IsAlgebraic k[X] (FractionRing k[X]) :=
    IsLocalization.isAlgebraic _ (nonZeroDivisors k[X])
  exact (IsTranscendenceBasis.polynomial Unit k).algebraMap_comp

/-- **The rational function field is separably generated** over every field `k`. -/
instance instIsSeparablyGeneratedFractionRingPolynomial :
    Algebra.IsSeparablyGenerated k (FractionRing k[X]) := by
  refine ⟨{algebraMap k[X] (FractionRing k[X]) X}, ?_, ⟨fun z ↦ ?_⟩⟩
  · have h := (isTranscendenceBasis_algebraMap_X k).to_subtype_range
    rwa [Set.range_const] at h
  · have hz : z ∈ IntermediateField.adjoin k {algebraMap k[X] (FractionRing k[X]) X} :=
      (adjoin_algebraMap_X_eq_top k).symm ▸ IntermediateField.mem_top
    exact isSeparable_algebraMap (⟨z, hz⟩ : IntermediateField.adjoin k _)

end TauCeti
