module

public import Mathlib.FieldTheory.TranscendentalSeparable
public import Mathlib.FieldTheory.RatFunc.Basic
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.Algebraic.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# The rational function field is separably generated

A field extension `K / k` generated as a field by a transcendence basis is separably generated
(`IsTranscendenceBasis.isSeparablyGenerated_of_adjoin_range_eq_top`), whatever `k` is.

In particular, for every field `k`, perfect or not, the field `k(s)` of rational functions in one
variable, that is any fraction field `K` of `k[s]`, is separably generated over `k`: `{s}` is a
transcendence basis, and `K` is generated by `s` as a field
(`TauCeti.IsFractionRing.isSeparablyGenerated_polynomial`). This gives instances for
`FractionRing k[X]` and `RatFunc k`; Mathlib's instance covers only perfect `k`. The extension is
not algebraic, so it is not `Algebra.IsSeparable`.
-/

public section

open Polynomial

/-- A field extension generated as a field by a transcendence basis is separably generated. -/
theorem IsTranscendenceBasis.isSeparablyGenerated_of_adjoin_range_eq_top {k K ι : Type*}
    [Field k] [Field K] [Algebra k K] {x : ι → K} (hx : IsTranscendenceBasis k x)
    (h : IntermediateField.adjoin k (Set.range x) = ⊤) : Algebra.IsSeparablyGenerated k K := by
  refine ⟨Set.range x, hx.to_subtype_range, ⟨fun z ↦ ?_⟩⟩
  have hz : z ∈ IntermediateField.adjoin k (Set.range x) := h ▸ IntermediateField.mem_top
  -- `algebraMap` out of a subfield is the coercion (`IntermediateField.algebraMap_apply`).
  change IsSeparable _ (algebraMap (IntermediateField.adjoin k (Set.range x)) K ⟨z, hz⟩)
  exact isSeparable_algebraMap _

namespace TauCeti.IsFractionRing

variable (k K : Type*) [Field k] [Field K] [Algebra k[X] K] [Algebra k K] [IsScalarTower k k[X] K]
  [IsFractionRing k[X] K]

/-- A fraction field `K` of `k[X]` is generated as a field over `k` by `X`. -/
theorem adjoin_algebraMap_X_eq_top : IntermediateField.adjoin k {algebraMap k[X] K X} = ⊤ := by
  refine eq_top_iff.mpr fun z _ ↦ (IntermediateField.mem_adjoin_simple_iff _ _).mpr ?_
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := k[X]) z
  exact ⟨a, b, by simp [aeval_algebraMap_apply]⟩

/-- `X` is a transcendence basis of a fraction field `K` of `k[X]` over `k`. -/
theorem isTranscendenceBasis_algebraMap_X :
    IsTranscendenceBasis k fun _ : Unit ↦ algebraMap k[X] K X := by
  have : Algebra.IsAlgebraic k[X] K := IsLocalization.isAlgebraic _ (nonZeroDivisors k[X])
  exact (IsTranscendenceBasis.polynomial Unit k).algebraMap_comp

/-- **The rational function field is separably generated** over every field `k`: so is every
fraction field `K` of `k[X]`. -/
theorem isSeparablyGenerated_polynomial : Algebra.IsSeparablyGenerated k K :=
  (isTranscendenceBasis_algebraMap_X k K).isSeparablyGenerated_of_adjoin_range_eq_top <| by
    rw [Set.range_const]
    exact adjoin_algebraMap_X_eq_top k K

end TauCeti.IsFractionRing

namespace TauCeti

variable (k : Type*) [Field k]

/-- `FractionRing k[X]` is separably generated over every field `k`. -/
instance instIsSeparablyGeneratedFractionRingPolynomial :
    Algebra.IsSeparablyGenerated k (FractionRing k[X]) :=
  IsFractionRing.isSeparablyGenerated_polynomial k _

/-- `RatFunc k` is separably generated over every field `k`. -/
instance instIsSeparablyGeneratedRatFunc : Algebra.IsSeparablyGenerated k (RatFunc k) :=
  IsFractionRing.isSeparablyGenerated_polynomial k _

end TauCeti
