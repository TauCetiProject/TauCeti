module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.FieldTheory.Separable
import Mathlib.FieldTheory.SeparableDegree
import Mathlib.Tactic.ComputeDegree

/-!
# Simple roots are separable

An element `y` of a field extension of `K` that is a simple root of some polynomial `p` over `K`,
that is `p(y) = 0` and `p′(y) ≠ 0`, is separable over `K`: writing `p = minpoly · r`, the
derivative `p′(y) = minpoly′(y) r(y)` is nonzero, so `minpoly′ ≠ 0`. Consequently a field
generated over `K` by such an element is finite and separable over `K`.

## Main results

* `TauCeti.isSeparable_of_aeval_derivative_ne_zero`: a simple root of a polynomial is separable.
* `TauCeti.finiteDimensional_and_isSeparable_of_aeval_derivative_ne_zero`: a field generated by
  a simple root of a polynomial is finite and separable.
* `TauCeti.finrank_eq_one_of_two_mul_add_eq_zero`: a separable generator `z` of `L / K` with
  `z² + u z - v = 0` and `2 z + u = 0` forces `L = K`.
-/

public section

open Polynomial

open scoped IntermediateField

namespace TauCeti

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {p : K[X]} {y : L}

/-- **A simple root is separable**: if `p(y) = 0` and `p′(y) ≠ 0`, then `y` is separable. -/
theorem isSeparable_of_aeval_derivative_ne_zero (hp : aeval y p = 0)
    (hd : aeval y (derivative p) ≠ 0) : IsSeparable K y := by
  have hint : IsIntegral K y :=
    IsAlgebraic.isIntegral ⟨p, fun h0 ↦ hd (by rw [h0, derivative_zero, map_zero]), hp⟩
  -- Writing `p = minpoly · r`, `p′(y) = minpoly′(y) r(y)`, so `minpoly′ ≠ 0`.
  rw [IsSeparable, separable_iff_derivative_ne_zero (minpoly.irreducible hint)]
  intro h0
  obtain ⟨r, hr⟩ := minpoly.dvd K y hp
  refine hd ?_
  rw [hr, derivative_mul, h0, map_add, map_mul, map_mul, minpoly.aeval]
  simp

/-- **A field generated by a simple root is finite and separable**: if `L = K⟮y⟯`, where
`p(y) = 0` and `p′(y) ≠ 0`, then `L / K` is finite and separable. -/
theorem finiteDimensional_and_isSeparable_of_aeval_derivative_ne_zero (hgen : K⟮y⟯ = ⊤)
    (hp : aeval y p = 0) (hd : aeval y (derivative p) ≠ 0) :
    FiniteDimensional K L ∧ Algebra.IsSeparable K L := by
  have hsep := isSeparable_of_aeval_derivative_ne_zero hp hd
  let e : K⟮y⟯ ≃ₐ[K] L := (IntermediateField.equivOfEq hgen).trans IntermediateField.topEquiv
  have := (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K L).mpr hsep
  have := IntermediateField.adjoin.finiteDimensional hsep.isIntegral
  exact ⟨e.toLinearEquiv.finiteDimensional, AlgEquiv.Algebra.isSeparable e⟩

/-- **A separable generator with `2 z + u = 0` of a quadratic extension is trivial.** If `z`
generates a separable extension `L / K`, satisfies `z² + u z - v = 0` and `2 z + u = 0`, then
`L = K`: the minimal polynomial `m` of `z` divides the quadratic `X² + u X - v`, and `m'(z) ≠ 0`
forces `m²` to divide it too, so `m` is linear. -/
theorem finrank_eq_one_of_two_mul_add_eq_zero [Algebra.IsSeparable K L] {u v : K} {z : L}
    (hgen : K⟮z⟯ = ⊤) (hz : z ^ 2 + algebraMap K L u * z - algebraMap K L v = 0)
    (hd : 2 * z + algebraMap K L u = 0) : Module.finrank K L = 1 := by
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : K[X], ψ = X ^ 2 + C u * X - C v := ⟨_, rfl⟩
  have hψm : ψ.Monic := by rw [hψdef]; monicity!
  have hψz : aeval z ψ = 0 := by simpa [hψdef] using hz
  have hderiv : aeval z (derivative ψ) = 0 := by
    rw [← hd]
    simp only [hψdef, derivative_sub, derivative_X_pow, derivative_C_mul_X, derivative_C, sub_zero,
      map_add, map_mul, aeval_C, Nat.cast_ofNat, map_ofNat]
    norm_num
  obtain ⟨g, hg⟩ := minpoly.dvd K z hψz
  have hsep := Algebra.IsSeparable.isSeparable K z
  have hg0 : aeval z g = 0 := by
    have h := congrArg (aeval z) (congrArg derivative hg)
    rw [hderiv, derivative_mul, map_add, map_mul, map_mul, minpoly.aeval, zero_mul, add_zero] at h
    exact (mul_eq_zero.mp h.symm).resolve_left (fun h0 ↦ hsep.aeval_derivative_ne_zero
      (minpoly.aeval K z) h0)
  have hmg : minpoly K z ∣ g := minpoly.dvd K z hg0
  have hdeg : (minpoly K z * minpoly K z).natDegree ≤ 2 := by
    have : (minpoly K z * minpoly K z) ∣ ψ := hg ▸ mul_dvd_mul_left _ hmg
    exact (natDegree_le_of_dvd this hψm.ne_zero).trans (by rw [hψdef]; compute_degree)
  have hint : IsIntegral K z := hsep.isIntegral
  have hpos := minpoly.natDegree_pos hint
  rw [natDegree_mul (minpoly.ne_zero hint) (minpoly.ne_zero hint)] at hdeg
  have h1 : z ∈ (algebraMap K L).range := by
    rw [← minpoly.natDegree_eq_one_iff]
    omega
  have hbot : K⟮z⟯ = ⊥ := by
    rw [IntermediateField.adjoin_simple_eq_bot_iff, IntermediateField.mem_bot]
    exact h1
  rw [← IntermediateField.finrank_top', ← hgen, hbot, IntermediateField.finrank_bot]

end TauCeti
