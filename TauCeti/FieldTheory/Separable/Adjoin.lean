module

public import Mathlib.FieldTheory.Separable
import Mathlib.FieldTheory.SeparableClosure

/-!
# Separable subalgebras generated by commuting elements

In a possibly noncommutative domain over a field, a pairwise commuting set of separable
elements generates a separable commutative subalgebra. This permits adjoining separable
elements to subfields of a division algebra without requiring the ambient algebra to be
commutative.
-/

public section

open Algebra

open scoped IsMulCommutative

namespace Set.Pairwise

variable {K A : Type*} [Field K] [Ring A] [IsDomain A] [Algebra K A]

/-- A pairwise commuting set in a domain generates a separable subalgebra if and only if
all of its generators are separable. The ambient domain need not be commutative or finite
dimensional. -/
theorem isSeparable_adjoin_iff {s : Set A} (hcomm : s.Pairwise Commute) :
    Algebra.IsSeparable K (adjoin K s) ↔ ∀ x ∈ s, IsSeparable K x := by
  refine ⟨fun h x hx ↦ (Subalgebra.isSeparable_iff.mp h) x (subset_adjoin hx), fun hsep ↦ ?_⟩
  have : IsMulCommutative (adjoin K s) := isMulCommutative_adjoin K hcomm
  -- Inside `adjoin K s`, every subalgebra containing the generators is everything.
  have hle {S : Subalgebra K (adjoin K s)} (hS : ((↑) : adjoin K s → A) ⁻¹' s ⊆ S)
      (x : adjoin K s) : x ∈ S :=
    adjoin_le hS (adjoin_adjoin_coe_preimage.ge mem_top)
  have hsep' (x : adjoin K s) (hx : (x : A) ∈ s) : IsSeparable K x :=
    (isSeparable_map_iff (adjoin K s).val Subtype.val_injective).mp (hsep x hx)
  -- The generated commutative domain is integral over `K`, hence a field, so its separable
  -- elements form a subalgebra.
  have : Algebra.IsIntegral K (adjoin K s) :=
    ⟨hle (S := integralClosure K _) fun x hx ↦ (hsep' x hx).isIntegral⟩
  let _ : Field (adjoin K s) := (isField_of_isIntegral_of_isField' (Field.toIsField K)).toField
  exact ⟨hle (S := (separableClosure K _).toSubalgebra) hsep'⟩

end Set.Pairwise
