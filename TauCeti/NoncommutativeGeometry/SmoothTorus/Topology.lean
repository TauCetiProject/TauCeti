/-!
# The Fréchet topology of the smooth noncommutative torus

The smooth noncommutative torus `𝒜_θ` carries the weighted `ℓ¹` seminorms

`‖a‖_k = ∑ₓ ‖a x‖ * weight x ^ k`, `k : ℕ`,

where `weight (m, n) = (1 + |m|) (1 + |n|)`. Since `weight x ≥ 1`, they increase with `k`, and
`‖a‖_k` bounds each weighted coefficient `‖a x‖ * weight x ^ k` appearing in the definition of
rapid decay.

Because the weight is submultiplicative and the twisting phase has modulus one, every `‖·‖_k` is
submultiplicative, `‖a * b‖_k ≤ ‖a‖_k ‖b‖_k`, and it is invariant under the involution. Hence the
topology they generate makes `𝒜_θ` a topological star algebra. It is complete, Hausdorff and
first countable, hence metrizable, so `𝒜_θ` is a Fréchet star algebra. The Fourier series
`∑ₓ a x U₁ ^ x₁ U₂ ^ x₂` of every element converges to it, and the coefficient functionals and
the canonical trace are continuous.

## Main definitions

* `TauCeti.SmoothNoncommutativeTorus.seminorm θ k`: the weighted `ℓ¹` seminorm `‖·‖_k`.
* `TauCeti.SmoothNoncommutativeTorus.seminormFamily θ`: the family of these seminorms, which
  defines the topology of `𝒜_θ`.

## Main statements

* `TauCeti.SmoothNoncommutativeTorus.withSeminorms`: the topology is generated by the seminorms
  `‖·‖_k`.
* `TauCeti.SmoothNoncommutativeTorus.seminorm_mul_le`: `‖a * b‖_k ≤ ‖a‖_k ‖b‖_k`.
* `TauCeti.SmoothNoncommutativeTorus.seminorm_star`: `‖star a‖_k = ‖a‖_k`.
* `TauCeti.SmoothNoncommutativeTorus.instIsTopologicalRing`,
  `TauCeti.SmoothNoncommutativeTorus.instContinuousStar`: `𝒜_θ` is a topological star algebra.
* `TauCeti.SmoothNoncommutativeTorus.instCompleteSpace`,
  `TauCeti.SmoothNoncommutativeTorus.instMetrizableSpace`: `𝒜_θ` is complete and metrizable.
* `TauCeti.SmoothNoncommutativeTorus.hasSum_single_coeff`: the Fourier series of `a` converges
  to `a`.
* `TauCeti.SmoothNoncommutativeTorus.continuous_trace`: the canonical trace is continuous.

The construction of the topology from a seminorm family follows Mathlib's Schwartz space
`SchwartzMap`.

## References

* A. Connes, *Noncommutative Geometry*, Academic Press, 1994, Chapter III, §2.β and Chapter IV,
  §6.
* M. A. Rieffel, *C*-algebras associated with irrational rotations*, Pacific J. Math. 93 (1981).
-/

public section

open Complex Filter Topology Uniformity
open scoped ComplexConjugate

noncomputable section

namespace TauCeti

namespace SmoothNoncommutativeTorus

variable {θ : ℝ}

/-! ### The weighted `ℓ¹` seminorms -/

variable (θ) in
/-- The weighted `ℓ¹` seminorm `‖a‖_k = ∑ₓ ‖a x‖ * weight x ^ k` on the smooth noncommutative
torus. -/
def seminorm (k : ℕ) : Seminorm ℂ (SmoothNoncommutativeTorus θ) :=
  Seminorm.of (fun a ↦ ∑' x, ‖a.coeff x‖ * weight x ^ k)
    (fun a b ↦ by
      rw [← (a.isRapidDecay_coeff.summable_norm_mul_weight_pow k).tsum_add
        (b.isRapidDecay_coeff.summable_norm_mul_weight_pow k)]
      refine ((a + b).isRapidDecay_coeff.summable_norm_mul_weight_pow k).tsum_le_tsum
        (fun x ↦ ?_) ((a.isRapidDecay_coeff.summable_norm_mul_weight_pow k).add
          (b.isRapidDecay_coeff.summable_norm_mul_weight_pow k))
      rw [coeff_add, Pi.add_apply, ← add_mul]
      exact mul_le_mul_of_nonneg_right (norm_add_le _ _) (pow_nonneg (weight_pos x).le k))
    (fun c a ↦ by
      simp only [coeff_smul, Pi.smul_apply, smul_eq_mul, norm_mul, mul_assoc, tsum_mul_left])

theorem seminorm_apply (k : ℕ) (a : SmoothNoncommutativeTorus θ) :
    seminorm θ k a = ∑' x, ‖a.coeff x‖ * weight x ^ k :=
  (rfl)

theorem hasSum_seminorm (k : ℕ) (a : SmoothNoncommutativeTorus θ) :
    HasSum (fun x ↦ ‖a.coeff x‖ * weight x ^ k) (seminorm θ k a) :=
  (a.isRapidDecay_coeff.summable_norm_mul_weight_pow k).hasSum

/-- Each weighted coefficient is bounded by the seminorm. -/
theorem norm_coeff_mul_weight_pow_le_seminorm (k : ℕ) (a : SmoothNoncommutativeTorus θ)
    (x : ℤ × ℤ) : ‖a.coeff x‖ * weight x ^ k ≤ seminorm θ k a :=
  (a.isRapidDecay_coeff.summable_norm_mul_weight_pow k).le_tsum x fun _ _ ↦
    norm_mul_weight_pow_nonneg _ _ k

theorem norm_coeff_le_seminorm_zero (a : SmoothNoncommutativeTorus θ) (x : ℤ × ℤ) :
    ‖a.coeff x‖ ≤ seminorm θ 0 a := by
  simpa using norm_coeff_mul_weight_pow_le_seminorm 0 a x

/-- The seminorms increase with the weight exponent. -/
theorem seminorm_mono {k l : ℕ} (hkl : k ≤ l) (a : SmoothNoncommutativeTorus θ) :
    seminorm θ k a ≤ seminorm θ l a :=
  (a.isRapidDecay_coeff.summable_norm_mul_weight_pow k).tsum_le_tsum
    (fun x ↦ mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (one_le_weight x) hkl) (norm_nonneg _))
    (a.isRapidDecay_coeff.summable_norm_mul_weight_pow l)

@[simp]
theorem seminorm_single (k : ℕ) (x : ℤ × ℤ) (c : ℂ) :
    seminorm θ k (single x c) = ‖c‖ * weight x ^ k := by
  rw [seminorm_apply, tsum_eq_single x fun y hy ↦ by simp [hy]]
  simp

@[simp]
theorem seminorm_one (k : ℕ) : seminorm θ k 1 = 1 := by
  simp [one_def]

/-- The seminorms are invariant under the involution. -/
@[simp]
theorem seminorm_star (k : ℕ) (a : SmoothNoncommutativeTorus θ) :
    seminorm θ k (star a) = seminorm θ k a := by
  rw [seminorm_apply, seminorm_apply, ← (Equiv.neg (ℤ × ℤ)).tsum_eq]
  simp

/-- The weighted coefficients of a product are bounded by the convolution of the weighted
coefficients of its factors. -/
theorem norm_coeff_mul_mul_weight_pow_le (k : ℕ) (a b : SmoothNoncommutativeTorus θ)
    (x : ℤ × ℤ) :
    ‖(a * b).coeff x‖ * weight x ^ k ≤
      ∑' y, ‖a.coeff y‖ * weight y ^ k * (‖b.coeff (x - y)‖ * weight (x - y) ^ k) := by
  have hs : Summable fun y ↦
      ‖a.coeff y‖ * weight y ^ k * (‖b.coeff (x - y)‖ * weight (x - y) ^ k) :=
    ((a.isRapidDecay_coeff.summable_norm_mul_weight_pow k).mul_right
      (seminorm θ k b)).of_nonneg_of_le
      (fun y ↦ mul_nonneg (norm_mul_weight_pow_nonneg _ y k) (norm_mul_weight_pow_nonneg _ _ k))
      fun y ↦ mul_le_mul_of_nonneg_left (norm_coeff_mul_weight_pow_le_seminorm k b (x - y))
        (norm_mul_weight_pow_nonneg _ y k)
  rw [coeff_mul]
  calc ‖∑' y, a.coeff y * b.coeff (x - y) * twist θ y (x - y)‖ * weight x ^ k
      ≤ (∑' y, ‖a.coeff y * b.coeff (x - y) * twist θ y (x - y)‖) * weight x ^ k :=
        mul_le_mul_of_nonneg_right (norm_tsum_le_tsum_norm (summable_norm_mul_coeff a b x))
          (pow_nonneg (weight_pos x).le k)
    _ = ∑' y, ‖a.coeff y * b.coeff (x - y) * twist θ y (x - y)‖ * weight x ^ k :=
        tsum_mul_right.symm
    _ ≤ _ := Summable.tsum_le_tsum (fun y ↦ norm_mul_coeff_mul_weight_pow_le a b x y k)
        ((summable_norm_mul_coeff a b x).mul_right _) hs

/-- The seminorms are submultiplicative. -/
theorem seminorm_mul_le (k : ℕ) (a b : SmoothNoncommutativeTorus θ) :
    seminorm θ k (a * b) ≤ seminorm θ k a * seminorm θ k b := by
  rw [seminorm_apply, seminorm_apply]
  exact hasSum_le (norm_coeff_mul_mul_weight_pow_le k a b) (hasSum_seminorm k (a * b))
    (DiscreteConvolution.hasSum_tsum_mul_sub
      (a.isRapidDecay_coeff.summable_norm_mul_weight_pow k).abs
      (b.isRapidDecay_coeff.summable_norm_mul_weight_pow k).abs)

/-! ### The topology -/

variable (θ) in
/-- The family of weighted `ℓ¹` seminorms `‖·‖_k`, `k : ℕ`, defining the topology of the smooth
noncommutative torus. -/
def seminormFamily : SeminormFamily ℂ (SmoothNoncommutativeTorus θ) ℕ :=
  seminorm θ

@[simp]
theorem seminormFamily_apply (k : ℕ) : seminormFamily θ k = seminorm θ k :=
  (rfl)

/-- The topology of the smooth noncommutative torus, generated by the weighted `ℓ¹` seminorms. -/
instance instTopologicalSpace : TopologicalSpace (SmoothNoncommutativeTorus θ) :=
  (seminormFamily θ).moduleFilterBasis.topology'

variable (θ) in
/-- The topology of the smooth noncommutative torus is generated by its weighted `ℓ¹`
seminorms. -/
theorem withSeminorms : WithSeminorms (seminormFamily θ) :=
  ⟨rfl⟩

instance instIsTopologicalAddGroup : IsTopologicalAddGroup (SmoothNoncommutativeTorus θ) :=
  (withSeminorms θ).isTopologicalAddGroup

instance instContinuousSMul : ContinuousSMul ℂ (SmoothNoncommutativeTorus θ) :=
  (withSeminorms θ).continuousSMul

instance instPolynormableSpace : PolynormableSpace ℂ (SmoothNoncommutativeTorus θ) :=
  (withSeminorms θ).toPolynormableSpace

instance instFirstCountableTopology : FirstCountableTopology (SmoothNoncommutativeTorus θ) :=
  (withSeminorms θ).firstCountableTopology

instance instUniformSpace : UniformSpace (SmoothNoncommutativeTorus θ) :=
  fast_instance% (seminormFamily θ).addGroupFilterBasis.uniformSpace

instance instIsUniformAddGroup : IsUniformAddGroup (SmoothNoncommutativeTorus θ) :=
  (seminormFamily θ).addGroupFilterBasis.isUniformAddGroup

instance instT2Space : T2Space (SmoothNoncommutativeTorus θ) := by
  have : T1Space (SmoothNoncommutativeTorus θ) :=
    (withSeminorms θ).T1_of_separating fun a ha ↦ ⟨0, fun h ↦ ha <| by
      ext x
      simpa using (norm_coeff_le_seminorm_zero a x).trans_eq h⟩
  infer_instance

/-- Convergence to `0` in the smooth noncommutative torus, in terms of the seminorms. -/
theorem tendsto_nhds_zero {ι : Type*} {l : Filter ι} {u : ι → SmoothNoncommutativeTorus θ} :
    Tendsto u l (𝓝 0) ↔ ∀ k ε, 0 < ε → ∀ᶠ i in l, seminorm θ k (u i) < ε := by
  simp [(withSeminorms θ).tendsto_nhds u 0]

instance instContinuousStar : ContinuousStar (SmoothNoncommutativeTorus θ) where
  continuous_star := continuous_iff_continuousAt.2 fun a ↦ by
    rw [ContinuousAt, (withSeminorms θ).tendsto_nhds]
    intro k ε hε
    filter_upwards [((withSeminorms θ).tendsto_nhds id a).1 tendsto_id k ε hε] with b hb
    rwa [← star_sub, seminormFamily_apply, seminorm_star]

private theorem tendsto_mul_left_nhds_zero (a : SmoothNoncommutativeTorus θ) :
    Tendsto (fun b ↦ a * b) (𝓝 0) (𝓝 0) := by
  rw [tendsto_nhds_zero]
  intro k ε hε
  have hS : 0 < seminorm θ k a + 1 := by positivity
  filter_upwards [tendsto_nhds_zero.1 tendsto_id k (ε / (seminorm θ k a + 1)) (by positivity)]
    with b hb
  calc seminorm θ k (a * b) ≤ seminorm θ k a * seminorm θ k b := seminorm_mul_le k a b
    _ ≤ (seminorm θ k a + 1) * seminorm θ k b := by gcongr; linarith
    _ < (seminorm θ k a + 1) * (ε / (seminorm θ k a + 1)) := by gcongr; exact hb
    _ = ε := mul_div_cancel₀ ε hS.ne'

private theorem tendsto_mul_right_nhds_zero (a : SmoothNoncommutativeTorus θ) :
    Tendsto (fun b ↦ b * a) (𝓝 0) (𝓝 0) := by
  have hstar : Tendsto (star : SmoothNoncommutativeTorus θ → _) (𝓝 0) (𝓝 0) := by
    simpa using continuous_star.tendsto (0 : SmoothNoncommutativeTorus θ)
  simpa [Function.comp_def] using hstar.comp ((tendsto_mul_left_nhds_zero (star a)).comp hstar)

instance instIsTopologicalRing : IsTopologicalRing (SmoothNoncommutativeTorus θ) := by
  refine .of_addGroup_of_nhds_zero ?_ tendsto_mul_left_nhds_zero tendsto_mul_right_nhds_zero
  rw [tendsto_nhds_zero]
  intro k ε hε
  let l := 𝓝 (0 : SmoothNoncommutativeTorus θ)
  have h₁ := tendsto_nhds_zero.1 (tendsto_fst (f := l) (g := l)) k 1 one_pos
  have h₂ := tendsto_nhds_zero.1 (tendsto_snd (f := l) (g := l)) k ε hε
  filter_upwards [h₁, h₂] with p hp₁ hp₂
  calc seminorm θ k (p.1 * p.2) ≤ seminorm θ k p.1 * seminorm θ k p.2 := seminorm_mul_le k _ _
    _ ≤ 1 * seminorm θ k p.2 := by gcongr
    _ < ε := by rwa [one_mul]

/-! ### Continuity of the coefficients -/

/-- Each Fourier coefficient is a continuous function on the smooth noncommutative torus. -/
@[fun_prop]
theorem continuous_coeff (x : ℤ × ℤ) :
    Continuous fun a : SmoothNoncommutativeTorus θ ↦ a.coeff x :=
  continuous_iff_continuousAt.2 fun a ↦ Metric.tendsto_nhds.2 fun ε hε ↦ by
    filter_upwards [((withSeminorms θ).tendsto_nhds id a).1 tendsto_id 0 ε hε] with b hb
    rw [dist_eq_norm, ← Pi.sub_apply, ← coeff_sub]
    exact (norm_coeff_le_seminorm_zero _ x).trans_lt hb

/-- The canonical trace is continuous. -/
@[fun_prop]
theorem continuous_trace : Continuous (trace θ) :=
  (continuous_coeff 0).congr fun a ↦ (trace_apply a).symm

/-! ### Convergence of Fourier series -/

/-- The Fourier series `∑ₓ a x U₁ ^ x₁ U₂ ^ x₂` of an element of the smooth noncommutative torus
converges to it. -/
theorem hasSum_single_coeff (a : SmoothNoncommutativeTorus θ) :
    HasSum (fun x ↦ single x (a.coeff x)) a := by
  rw [HasSum, (withSeminorms θ).tendsto_nhds]
  intro k ε hε
  -- the error of a partial sum is the tail of the series defining the seminorm
  have htail := tendsto_tsum_compl_atTop_zero fun x ↦ ‖a.coeff x‖ * weight x ^ k
  filter_upwards [htail.eventually (gt_mem_nhds hε)] with s hs
  convert hs using 1
  rw [seminormFamily_apply, ← map_neg_eq_map, neg_sub, seminorm_apply]
  refine (tsum_congr fun x ↦ ?_).trans
    (tsum_subtype {x | x ∉ s} fun x ↦ ‖a.coeff x‖ * weight x ^ k).symm
  by_cases hx : x ∈ s <;> simp [hx, Set.indicator]

/-! ### Completeness -/

private theorem exists_tendsto_of_cauchySeq {u : ℕ → SmoothNoncommutativeTorus θ}
    (hu : CauchySeq u) : ∃ a, Tendsto u atTop (𝓝 a) := by
  -- the Cauchy condition for each seminorm
  have hcau : ∀ k ε, 0 < ε → ∃ N, ∀ m ≥ N, ∀ n ≥ N, seminorm θ k (u m - u n) < ε := by
    rw [cauchySeq_iff_tendsto, uniformity_eq_comap_nhds_zero, tendsto_comap_iff] at hu
    intro k ε hε
    have h := tendsto_nhds_zero.1 hu k ε hε
    rw [eventually_atTop_prod_self'] at h
    obtain ⟨N, hN⟩ := h
    exact ⟨N, fun m hm n hn ↦ by simpa using hN n hn m hm⟩
  -- the coefficients converge
  have hcoeff : ∀ x, CauchySeq fun n ↦ (u n).coeff x := fun x ↦ Metric.cauchySeq_iff.2
    fun ε hε ↦ (hcau 0 ε hε).imp fun N hN m hm n hn ↦ by
      rw [dist_eq_norm, ← Pi.sub_apply, ← coeff_sub]
      exact (norm_coeff_le_seminorm_zero _ x).trans_lt (hN m hm n hn)
  choose c hc using fun x ↦ cauchySeq_tendsto_of_complete (hcoeff x)
  -- finite partial sums of the weighted distance to the limit are controlled by the Cauchy bound
  have hsum : ∀ k ε, 0 < ε → ∃ N, ∀ m ≥ N, ∀ s : Finset (ℤ × ℤ),
      ∑ x ∈ s, ‖(u m).coeff x - c x‖ * weight x ^ k ≤ ε := by
    intro k ε hε
    obtain ⟨N, hN⟩ := hcau k ε hε
    refine ⟨N, fun m hm s ↦ le_of_tendsto (tendsto_finsetSum s fun x _ ↦
      (((tendsto_const_nhds.sub (hc x)).norm).mul_const _)) ?_⟩
    filter_upwards [eventually_ge_atTop N] with n hn
    calc ∑ x ∈ s, ‖(u m).coeff x - (u n).coeff x‖ * weight x ^ k
        ≤ seminorm θ k (u m - u n) := by
          rw [seminorm_apply]
          simpa using ((u m - u n).isRapidDecay_coeff.summable_norm_mul_weight_pow k).sum_le_tsum s
            fun x _ ↦ norm_mul_weight_pow_nonneg _ x k
      _ ≤ ε := (hN m hm n hn).le
  have hdecay : IsRapidDecay c := by
    refine isRapidDecay_iff.2 fun k ↦ ?_
    obtain ⟨N, hN⟩ := hsum k 1 one_pos
    refine ⟨seminorm θ k (u N) + 1, fun x ↦ ?_⟩
    have h₁ := norm_coeff_mul_weight_pow_le_seminorm k (u N) x
    have h₂ : ‖(u N).coeff x - c x‖ * weight x ^ k ≤ 1 := by simpa using hN N le_rfl {x}
    calc ‖c x‖ * weight x ^ k
        ≤ (‖(u N).coeff x‖ + ‖(u N).coeff x - c x‖) * weight x ^ k :=
          mul_le_mul_of_nonneg_right
            (by simpa using norm_sub_le ((u N).coeff x) ((u N).coeff x - c x))
            (pow_nonneg (weight_pos x).le k)
      _ ≤ seminorm θ k (u N) + 1 := by rw [add_mul]; exact add_le_add h₁ h₂
  refine ⟨⟨c, hdecay⟩, (withSeminorms θ).tendsto_nhds_atTop _ _ |>.2 fun k ε hε ↦ ?_⟩
  obtain ⟨N, hN⟩ := hsum k (ε / 2) (half_pos hε)
  refine ⟨N, fun m hm ↦ ?_⟩
  rw [seminormFamily_apply, seminorm_apply]
  refine lt_of_le_of_lt (tsum_le_of_sum_le' (half_pos hε).le fun s ↦ ?_) (half_lt_self hε)
  simpa using hN m hm s

instance instCompleteSpace : CompleteSpace (SmoothNoncommutativeTorus θ) := by
  have : (𝓤 (SmoothNoncommutativeTorus θ)).IsCountablyGenerated :=
    IsUniformAddGroup.uniformity_countably_generated
  exact UniformSpace.complete_of_cauchySeq_tendsto fun _ hu ↦ exists_tendsto_of_cauchySeq hu

instance instMetrizableSpace : TopologicalSpace.MetrizableSpace (SmoothNoncommutativeTorus θ) := by
  have : (𝓤 (SmoothNoncommutativeTorus θ)).IsCountablyGenerated :=
    IsUniformAddGroup.uniformity_countably_generated
  exact UniformSpace.metrizableSpace

end SmoothNoncommutativeTorus

