/-!
# The cellular comparison of Brown's twisting cocycle

Let `X` be a relative CW complex and `k` a commutative ring. The cubical cellular chain group in
dimension `m + 1` is the relative normalized cubical homology `Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)` of the pair of
consecutive skeleta `TauCeti.skeletonPair C (m + 1)`, and its boundary is the connecting morphism
of the pair `(Xᵐ⁺², Xᵐ⁺¹)` followed by the map `Hₘ₊₁(Xᵐ⁺¹) ⟶ Hₘ₊₁(Xᵐ⁺¹, Xᵐ)`. The characteristic
map of an `n`-cell `j`, read on the cube `Iⁿ`, is a relative cycle of `(Xⁿ, Xⁿ⁻¹)`
(`TauCeti.skeletonCellCube`, `TauCeti.skeletonCellCubeCycle`). The first part of this file shows
that the classes `[χⱼ]` of these **characteristic cubes** form a basis of the cubical cellular
chains (`TauCeti.cellCubeBasis`, `TauCeti.cellCubeBasis_apply`). The characteristic maps induce
isomorphisms `Hₘ₊₁(∐ⱼ (Dᵐ⁺¹, Sᵐ); k) ≅ Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)`
(`TauCeti.isIso_singularHomologyMap_characteristicPairMap`), the disks read on cubes exhibit
`∐ⱼ (Dᵐ⁺¹, Sᵐ)` as a coproduct of cube pairs, relative homology is additive
(`TopPair.isColimitCofanCubicalHomologyOfIsColimit`), and the cube pair has relative homology
`k`, generated by the identity cube (`TauCeti.cubicalHomologyCubeBoundaryPairEquiv`).

The second part computes the cellular boundary in this basis for Brown's semi-free model of the
chains on the based path space of a CW complex (`TauCeti.brownModel`). Its base chains `e_x`
satisfy `∂ e_x = ∑_y ε(m_{x,y}) e_y`, and `e_x` is the characteristic cube of `x` modulo the
lower skeleton (`TauCeti.brownModel_baseChain_sub_cellCube_mem_cubicalChainModuleSupportedIn`). So
`e_x` represents `[χ_x]`, its boundary is a cycle of `Xᵐ⁺¹` computing the connecting morphism, and
modulo `Xᵐ` that cycle is `∑_y ε(m_{x,y}) χ_y`. Hence the coefficient of the `(m + 1)`-cell `y` in
the cellular boundary of the `(m + 2)`-cell `x` is the augmentation `ε(m_{x,y})` of the entry of
Brown's twisting cocycle (`TauCeti.cellCubeBasis_repr_homologyMap_cubicalHomologyδ`): the classical
complex of Brown's cocycle, with coefficients in `k` through the augmentation, is the cubical
cellular chain complex of `X` in positive degrees.

## Main definitions

* `TauCeti.skeletonCellCube C n j`: the characteristic cube of the `n`-cell `j`, as a cube of the
  `n`-skeleton.
* `TauCeti.skeletonCellCubeCycle C k m j`: its relative cycle in `(Xᵐ⁺¹, Xᵐ)`.
* `TauCeti.cellCubeBasis C k m`: the basis of `Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)` given by the characteristic cubes
  of the `(m + 1)`-cells.

## Main results

* `TauCeti.cellCubeBasis_apply`: the basis vector of a cell is the class of its characteristic
  cube, which `TauCeti.isCubicalRepresentative_ofCube_skeletonCellCube` represents.
* `TauCeti.homologyMap_cubicalHomologyδ_eq_of_isCubicalRepresentative`: the cubical cellular
  boundary computed on representatives in `X`.
* `TauCeti.brownModel_baseChain_isCubicalRepresentative`: the base chain of an `(m + 2)`-cell of
  Brown's model represents its basis vector.
* `TauCeti.cellCubeBasis_repr_homologyMap_cubicalHomologyδ`: the cellular boundary of Brown's model
  has the augmented entries `ε(m_{x,y})` of Brown's twisting cocycle as its matrix in the bases of
  characteristic cubes.

## References

* E. H. Brown, *Twisted tensor products, I*, Ann. of Math. (2) 69 (1959), 223–246.
* J.-F. Barraud, M. Damian, V. Humilière, A. Oancea, *Morse homology with differential graded
  coefficients*, Progress in Mathematics 360, Birkhäuser, 2025, Chapter 3 (Theorem 3.3.5).
* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, Section 2.2 (cellular
  homology and the cellular boundary formula).
-/

public section

noncomputable section

open CategoryTheory Limits Metric Set Topology Topology.RelCWComplex unitInterval
open scoped DirectSum

namespace TauCeti

section Basis

variable {X : Type} [TopologicalSpace X] [T2Space X] {D : Set X} (C : Set X) [RelCWComplex C D]

/-- The **characteristic cube** `TauCeti.cellCube C n j` of the `n`-cell `j`, as a cube of the
`n`-skeleton `Xⁿ`, the ambient space of the skeletal pair `TauCeti.skeletonPair C n`. -/
def skeletonCellCube (n : ℕ) (j : cell C n) : SingularCube (skeletonPair C n).fst n :=
  (⟨fun d ↦ ⟨cellCube C n j d, cellCube_mem_skeletonLT_succ C n j d⟩,
    (cellCube C n j).continuous.subtype_mk _⟩ : C(Fin n → I, skeletonLT C ((n + 1 : ℕ) : ℕ∞)))

/-- The characteristic cube of `j` in the `n`-skeleton is `TauCeti.cellCube C n j`. -/
theorem skeletonCellCube_apply (n : ℕ) (j : cell C n) (d : Fin n → I) :
    (skeletonCellCube C n j d : skeletonLT C ((n + 1 : ℕ) : ℕ∞)) =
      ⟨cellCube C n j d, cellCube_mem_skeletonLT_succ C n j d⟩ :=
  (rfl)

/-- Read in `X`, the characteristic cube of `j` in the `n`-skeleton is `TauCeti.cellCube C n j`. -/
@[simp]
theorem subtypeVal_comp_skeletonCellCube (n : ℕ) (j : cell C n) :
    (ContinuousMap.subtypeVal (skeletonLT C ((n + 1 : ℕ) : ℕ∞))).comp (skeletonCellCube C n j) =
      cellCube C n j :=
  ContinuousMap.ext fun _ ↦ (rfl)

/-- Pushed forward to `X`, the characteristic cube of `j` in the `n`-skeleton is the characteristic
cube `TauCeti.cellCube C n j`. -/
theorem map_ofCube_skeletonCellCube (R : Type*) [Ring R] (n : ℕ) (j : cell C n) :
    NormalizedCubicalChain.map R
        (ContinuousMap.subtypeVal (skeletonLT C ((n + 1 : ℕ) : ℕ∞) : Set X)) n
        (NormalizedCubicalChain.ofCube _ R (skeletonCellCube C n j)) =
      NormalizedCubicalChain.ofCube X R (cellCube C n j) :=
  (NormalizedCubicalChain.map_ofCube R _ _).trans
    (congrArg _ (subtypeVal_comp_skeletonCellCube C n j))

/-- The characteristic cube of an `n`-cell sends the boundary of the cube into the
`(n - 1)`-skeleton `Xⁿ⁻¹`, the subspace of the skeletal pair. -/
theorem mapsTo_skeletonCellCube_boundary (n : ℕ) (j : cell C n) :
    MapsTo (skeletonCellCube C n j) (Cube.boundary (Fin n)) (range (skeletonPair C n).map) := by
  intro d hd
  rw [TopPair.range_ofInclusion_map]
  have h : cellCube C n j d ∈ (skeletonLT C (n : ℕ∞) : Set X) := by
    rw [cellCube_apply]
    exact cellFrontier_subset_skeletonLT n j ⟨_, mem_sphere_zero_iff_norm.2
      ((norm_cubeHomeomorphClosedBall_eq_one_iff d).2 hd), rfl⟩
  refine mem_preimage.2 ?_
  rw [skeletonCellCube_apply]
  exact h

/-- The disk of the `n`-cell `j` read on the cube, as a map of pairs
`(Iⁿ, ∂Iⁿ) ⟶ ∐ⱼ (Dⁿ, Sⁿ⁻¹)`. -/
private def cellCubeDiskPairHom (n : ℕ) (j : cell C n) :
    cubeBoundaryPair.{0} n ⟶ sigmaDiskPair (cell C n) n :=
  cubeBoundaryPairHom (P := sigmaDiskPair (cell C n) n) (cellCubeMap C n j) fun d hd ↦
    ⟨⟨cellCubeMap C n j d, by
      rw [mem_ofPred_eq, cellCubeMap_apply]
      exact (norm_cubeHomeomorphClosedBall_eq_one_iff d).2 hd⟩, rfl⟩

/-- The disks of the `n`-cells, read on cubes, exhibit `∐ⱼ (Dⁿ, Sⁿ⁻¹)` as the coproduct of copies
of the cube pair `(Iⁿ, ∂Iⁿ)`. -/
private def isColimitCofanCellCubeDiskPairHom (n : ℕ) :
    IsColimit (Cofan.mk (sigmaDiskPair (cell C n) n) (cellCubeDiskPairHom C n)) :=
  TopPair.isColimitCofanOfIsHomeomorph _ (by
    have hfun : (fun x : Σ _ : cell C n, (cubeBoundaryPair.{0} n).fst ↦
          TopPair.Hom.fst (cellCubeDiskPairHom C n x.1) x.2) =
        Sigma.map (β₁ := fun _ : cell C n ↦ ULift.{0} (Fin n → I))
          (β₂ := fun _ : cell C n ↦ closedBall (0 : Fin n → ℝ) 1) id
          (fun _ ↦ ⇑(Homeomorph.ulift.{0, 0}.trans (cubeHomeomorphClosedBall (Fin n)))) :=
      funext fun x ↦ (cubeBoundaryPairHom_fst_apply _ _ _).trans (cellCubeMap_apply ..)
    rw [hfun]
    exact IsHomeomorph.sigmaMap Function.bijective_id fun _ ↦
      (Homeomorph.ulift.{0, 0}.trans (cubeHomeomorphClosedBall (Fin n))).isHomeomorph) fun y ↦ by
    -- A point of a boundary sphere is the image of a point of the boundary of its cube.
    obtain ⟨⟨j, v⟩, hv⟩ := y
    refine ⟨j, ⟨ULift.up ((cubeHomeomorphClosedBall (Fin n)).symm v), ?_⟩, ?_⟩
    · rw [mem_preimage, ← norm_cubeHomeomorphClosedBall_eq_one_iff,
        Homeomorph.apply_symm_apply]
      exact hv
    · refine (cubeBoundaryPairHom_fst_apply _ _ _).trans ?_
      exact (cellCubeMap_apply ..).trans
        (Sigma.ext rfl (heq_of_eq ((cubeHomeomorphClosedBall (Fin n)).apply_symm_apply v)))

/-- The characteristic cube of `j`, as a map of pairs `(Iⁿ, ∂Iⁿ) ⟶ (Xⁿ, Xⁿ⁻¹)`, is the disk of `j`
read on the cube followed by the characteristic maps of the `n`-cells. -/
private theorem cubeBoundaryPairHom_skeletonCellCube (n : ℕ) (j : cell C n) :
    cubeBoundaryPairHom (skeletonCellCube C n j) (mapsTo_skeletonCellCube_boundary C n j) =
      cellCubeDiskPairHom C n j ≫ characteristicPairMap C n :=
  TopPair.hom_ext_of_fst _ <| TopCat.ext fun z ↦ by
    have hp : TopPair.Hom.fst (cellCubeDiskPairHom C n j) z =
        ⟨j, cubeHomeomorphClosedBall (Fin n) (ULift.down z)⟩ :=
      (cubeBoundaryPairHom_fst_apply _ _ _).trans (cellCubeMap_apply ..)
    rw [TopPair.Hom.fst_comp, TopCat.comp_app, hp]
    refine Subtype.ext ((congrArg (fun x : skeletonLT C ((n + 1 : ℕ) : ℕ∞) ↦ (x : X))
      (cubeBoundaryPairHom_fst_apply _ _ z)).trans ?_)
    exact (cellCube_apply n j _).trans (characteristicPairMap_fst_apply C n
      ⟨j, cubeHomeomorphClosedBall (Fin n) (ULift.down z)⟩).symm

variable (k : Type) [CommRing k] (m : ℕ)

/-- The relative cubical cycle of the characteristic cube of the `(m + 1)`-cell `j` in the pair of
skeleta `(Xᵐ⁺¹, Xᵐ)`. -/
def skeletonCellCubeCycle (j : cell C (m + 1)) :
    ((skeletonPair C (m + 1)).cubicalChainComplex k).cycles (m + 1) :=
  TopPair.cubicalCycleOfCube k (skeletonCellCube C (m + 1) j)
    (mapsTo_skeletonCellCube_boundary C (m + 1) j)

/-- The relative cycle of the characteristic cube of `j` is the relative chain of that cube. -/
@[simp]
theorem iCycles_skeletonCellCubeCycle (j : cell C (m + 1)) :
    ((skeletonPair C (m + 1)).cubicalChainComplex k).iCycles (m + 1)
        (skeletonCellCubeCycle C k m j) =
      TopPair.cubicalChainOfCube k (skeletonCellCube C (m + 1) j) :=
  TopPair.iCycles_cubicalCycleOfCube ..

/-- The map `k → Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)`, `a ↦ a • [χⱼ]`, of the `(m + 1)`-cell `j`. -/
private def cellCubeHomologyLeg (j : cell C (m + 1)) :
    ModuleCat.of k k ⟶ ((skeletonPair C (m + 1)).cubicalChainComplex k).homology (m + 1) :=
  (cubicalHomologyCubeBoundaryPairEquiv k m).toModuleIso.hom ≫
    HomologicalComplex.homologyMap (TopPair.cubicalChainComplexMap k
      (cubeBoundaryPairHom (skeletonCellCube C (m + 1) j)
        (mapsTo_skeletonCellCube_boundary C (m + 1) j))) (m + 1)

private theorem cellCubeHomologyLeg_apply (j : cell C (m + 1)) (a : k) :
    cellCubeHomologyLeg C k m j a =
      a • ((skeletonPair C (m + 1)).cubicalChainComplex k).homologyπ (m + 1)
        (skeletonCellCubeCycle C k m j) := by
  rw [cellCubeHomologyLeg, ModuleCat.comp_apply]
  -- The generator `k ≃ₗ[k] Hₘ₊₁(Iᵐ⁺¹, ∂Iᵐ⁺¹; k)` is read through its `ModuleCat` isomorphism,
  -- whose source `ModuleCat.of k k` is `k` only up to reducible unfolding.
  erw [cubicalHomologyCubeBoundaryPairEquiv_apply]
  rw [map_smul, homologyMap_cubeBoundaryPairHom_cubeBoundaryPairCycle, skeletonCellCubeCycle]

/-- The maps of the cells exhibit `Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)` as a coproduct of copies of `k`. -/
private def isColimitCofanCellCubeHomologyLeg :
    IsColimit (Cofan.mk (((skeletonPair C (m + 1)).cubicalChainComplex k).homology (m + 1))
      (cellCubeHomologyLeg C k m)) :=
  have : IsIso (Sigma.desc fun j ↦ HomologicalComplex.homologyMap
      (TopPair.cubicalChainComplexMap k (cellCubeDiskPairHom C (m + 1) j)) (m + 1)) :=
    (Cofan.nonempty_isColimit_iff_isIso_sigmaDesc _).1
      ⟨TopPair.isColimitCofanCubicalHomologyOfIsColimit k
        (isColimitCofanCellCubeDiskPairHom C (m + 1)) (m + 1)⟩
  have := TopPair.isIso_homologyMap_cubicalChainComplexMap_of_isIso (k := k)
    (characteristicPairMap C (m + 1)) (m + 1)
  have : IsIso (Sigma.desc (cellCubeHomologyLeg C k m)) := by
    -- Each leg is the leg of additivity, precomposed with the generator of the cube pair and
    -- followed by the characteristic maps.
    have hdesc : Sigma.desc (cellCubeHomologyLeg C k m) =
        (Sigma.mapIso fun _ ↦ (cubicalHomologyCubeBoundaryPairEquiv k m).toModuleIso).hom ≫
          (Sigma.desc fun j ↦ HomologicalComplex.homologyMap
            (TopPair.cubicalChainComplexMap k (cellCubeDiskPairHom C (m + 1) j)) (m + 1)) ≫
          HomologicalComplex.homologyMap
            (TopPair.cubicalChainComplexMap k (characteristicPairMap C (m + 1))) (m + 1) :=
      Sigma.hom_ext _ _ fun j ↦ by
        simp [cellCubeHomologyLeg, cubeBoundaryPairHom_skeletonCellCube,
          TopPair.cubicalChainComplexMap_comp, HomologicalComplex.homologyMap_comp]
    rw [hdesc]
    infer_instance
  Cofan.isColimitOfIsIsoSigmaDesc (hc := this) _

open scoped Classical in
/-- The direct sum of copies of `k`, one for each `(m + 1)`-cell, is `Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)`. -/
private def cellCubeHomologyEquiv :
    (⨁ _ : cell C (m + 1), k) ≃ₗ[k]
      ((skeletonPair C (m + 1)).cubicalChainComplex k).homology (m + 1) :=
  ((ModuleCat.coproductCoconeIsColimit fun _ : cell C (m + 1) ↦ ModuleCat.of k k
    ).coconePointUniqueUpToIso (isColimitCofanCellCubeHomologyLeg C k m)).toLinearEquiv

open scoped Classical in
private theorem cellCubeHomologyEquiv_lof (j : cell C (m + 1)) (a : k) :
    cellCubeHomologyEquiv C k m (DirectSum.lof k _ (fun _ ↦ k) j a) =
      cellCubeHomologyLeg C k m j a :=
  ConcreteCategory.congr_hom
    ((ModuleCat.coproductCoconeIsColimit _).comp_coconePointUniqueUpToIso_hom
      (isColimitCofanCellCubeHomologyLeg C k m) ⟨j⟩) a

open scoped Classical in
/-- **The characteristic cubes form a basis of the cubical cellular chains.** For a relative CW
complex and a commutative ring `k`, the classes `[χⱼ]` of the characteristic cubes
`TauCeti.skeletonCellCube` of the `(m + 1)`-cells `j` form a basis of the relative cubical
homology `Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)` of the pair of skeleta (`TauCeti.cellCubeBasis_apply`). -/
def cellCubeBasis :
    Module.Basis (cell C (m + 1)) k
      (((skeletonPair C (m + 1)).cubicalChainComplex k).homology (m + 1)) :=
  .ofRepr ((cellCubeHomologyEquiv C k m).symm.trans (finsuppLEquivDirectSum k k _).symm)

/-- The basis vector of the cell `j` is the class of its characteristic cube. -/
@[simp]
theorem cellCubeBasis_apply (j : cell C (m + 1)) :
    cellCubeBasis C k m j =
      ((skeletonPair C (m + 1)).cubicalChainComplex k).homologyπ (m + 1)
        (skeletonCellCubeCycle C k m j) := by
  classical
  simp only [cellCubeBasis, Module.Basis.coe_ofRepr, LinearEquiv.symm_trans_apply,
    LinearEquiv.symm_symm]
  rw [finsuppLEquivDirectSum_single, cellCubeHomologyEquiv_lof, cellCubeHomologyLeg_apply, one_smul]

/-- The characteristic cube of the `(m + 1)`-cell `j` represents the basis vector of `j`. -/
theorem isCubicalRepresentative_ofCube_skeletonCellCube (j : cell C (m + 1)) :
    (skeletonPair C (m + 1)).IsCubicalRepresentative k
      (NormalizedCubicalChain.ofCube _ k (skeletonCellCube C (m + 1) j)) (cellCubeBasis C k m j) :=
  (TopPair.isCubicalRepresentative_iff _ _).2 ⟨skeletonCellCubeCycle C k m j, by
    rw [iCycles_skeletonCellCubeCycle, TopPair.cubicalChainOfCube_def,
      normalizedCubicalChainComplexXEquiv_symm_apply], (cellCubeBasis_apply C k m j).symm⟩

end Basis

section CellularBoundary

universe u

variable {X : Type u} [TopologicalSpace X] [T2Space X] {D : Set X} (C : Set X)
  [RelCWComplex C D] {k : Type u} [Ring k] {m : ℕ}

/-- A chain `w₀` of `Xᵐ⁺¹` whose image in `Xᵐ⁺²` is the boundary of a chain `c` is a cycle. -/
private theorem d_eq_zero_of_map_eq_boundary
    {c : NormalizedCubicalChain (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set X) k (m + 1 + 1)}
    {w₀ : NormalizedCubicalChain (skeletonPair C (m + 1 + 1)).snd k (m + 1)}
    (hw₀ : NormalizedCubicalChain.map k (skeletonPair C (m + 1 + 1)).map.hom (m + 1) w₀ =
      NormalizedCubicalChain.boundary _ k (m + 1) c) :
    ((normalizedCubicalChainComplex k).obj (skeletonPair C (m + 1 + 1)).snd).d (m + 1) m w₀ =
      0 := by
  rw [normalizedCubicalChainComplex_obj_d_apply]
  refine NormalizedCubicalChain.map_injective k _
    (skeletonPair C (m + 1 + 1)).isEmbedding_map.injective m ?_
  rw [NormalizedCubicalChain.map_boundary_apply, hw₀]
  exact (LinearMap.congr_fun (NormalizedCubicalChain.boundary_boundary (R := k) m) c).trans
    (LinearMap.map_zero _).symm

/-- Read in `X`, a chain `w₀` of `Xᵐ⁺¹` whose image in `Xᵐ⁺²` is the boundary of a chain `c` is the
boundary of `c` read in `X`. -/
private theorem map_subtypeVal_eq_boundary_of_map_eq_boundary
    {c : NormalizedCubicalChain (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set X) k (m + 1 + 1)}
    {w₀ : NormalizedCubicalChain (skeletonPair C (m + 1 + 1)).snd k (m + 1)}
    (hw₀ : NormalizedCubicalChain.map k (skeletonPair C (m + 1 + 1)).map.hom (m + 1) w₀ =
      NormalizedCubicalChain.boundary _ k (m + 1) c) :
    NormalizedCubicalChain.map k
        (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 : ℕ) : ℕ∞) : Set X)) (m + 1) w₀ =
      NormalizedCubicalChain.boundary X k (m + 1) (NormalizedCubicalChain.map k
        (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set X))
          (m + 1 + 1) c) := by
  -- The inclusion of `Xᵐ⁺¹` into `X` factors through `Xᵐ⁺²`.
  have hincl : ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 : ℕ) : ℕ∞) : Set X) =
      (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set X)).comp
        (skeletonPair C (m + 1 + 1)).map.hom :=
    ContinuousMap.ext fun _ ↦ rfl
  refine (congrArg (fun f ↦ NormalizedCubicalChain.map k f (m + 1) w₀) hincl).trans ?_
  refine (LinearMap.congr_fun (NormalizedCubicalChain.map_comp k _ _ (m + 1)) w₀).trans ?_
  exact (congrArg (NormalizedCubicalChain.map k _ (m + 1)) hw₀).trans
    (NormalizedCubicalChain.map_boundary_apply k _ c)

/-- **The cubical cellular boundary on representatives.** Let `c` be a chain of `Xᵐ⁺²`
representing a class `μ` of `Hₘ₊₂(Xᵐ⁺², Xᵐ⁺¹; k)`, and `s` a chain of `Xᵐ⁺¹` representing a class
`ν` of `Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)`. If, read in `X`, the boundary of `c` is `s` modulo the chains of `Xᵐ`,
then the cellular boundary, the connecting morphism of `(Xᵐ⁺², Xᵐ⁺¹)` followed by the map to
`Hₘ₊₁(Xᵐ⁺¹, Xᵐ; k)`, sends `μ` to `ν`. -/
theorem homologyMap_cubicalHomologyδ_eq_of_isCubicalRepresentative
    {c : NormalizedCubicalChain (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set X) k (m + 1 + 1)}
    {s : NormalizedCubicalChain (skeletonLT C ((m + 1 + 1 : ℕ) : ℕ∞) : Set X) k (m + 1)}
    {μ : ((skeletonPair C (m + 1 + 1)).cubicalChainComplex k).homology (m + 1 + 1)}
    {ν : ((skeletonPair C (m + 1)).cubicalChainComplex k).homology (m + 1)}
    (hc : (skeletonPair C (m + 1 + 1)).IsCubicalRepresentative k c μ)
    (hs : (skeletonPair C (m + 1)).IsCubicalRepresentative k s ν)
    (hcs : NormalizedCubicalChain.boundary X k (m + 1) (NormalizedCubicalChain.map k
          (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set X))
            (m + 1 + 1) c) -
        NormalizedCubicalChain.map k
          (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 : ℕ) : ℕ∞) : Set X)) (m + 1) s ∈
      NormalizedCubicalChain.supportedIn k (skeletonLT C ((m + 1 : ℕ) : ℕ∞)) (m + 1)) :
    (HomologicalComplex.homologyMap
        (cokernel.π ((normalizedCubicalChainComplex k).map (skeletonPair C (m + 1)).map))
          (m + 1)).hom
        (((skeletonPair C (m + 1 + 1)).cubicalHomologyδ k (m + 1 + 1) (m + 1)).hom μ) = ν := by
  -- The boundary of `c` lies in `Xᵐ⁺¹`: it is `s` up to a chain of `Xᵐ ⊆ Xᵐ⁺¹`.
  have hbc : NormalizedCubicalChain.boundary X k (m + 1) (NormalizedCubicalChain.map k
      (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set X))
        (m + 1 + 1) c) ∈
      NormalizedCubicalChain.supportedIn k (skeletonLT C ((m + 1 + 1 : ℕ) : ℕ∞)) (m + 1) := by
    rw [← sub_add_cancel (NormalizedCubicalChain.boundary X k (m + 1) _)]
    exact add_mem (NormalizedCubicalChain.supportedIn_mono k
      (skeletonLT_mono (by norm_cast; omega)) _ hcs)
      (NormalizedCubicalChain.map_subtypeVal_mem_supportedIn k s)
  obtain ⟨w₀, hw₀⟩ : NormalizedCubicalChain.boundary _ k (m + 1) c ∈ LinearMap.range
      (NormalizedCubicalChain.map k (skeletonPair C (m + 1 + 1)).map.hom (m + 1)) := by
    refine (TopPair.mem_range_map_ofInclusion_iff
      (skeletonLT_subset_skeletonLT_succ C (m + 1 + 1)) _).2 ?_
    rw [NormalizedCubicalChain.map_boundary_apply]
    exact hbc
  -- So it is a cycle `w` of `Xᵐ⁺¹`, the image of `μ` under the connecting morphism.
  have hdw₀ := d_eq_zero_of_map_eq_boundary C hw₀
  set w :=
    ((normalizedCubicalChainComplex k).obj (skeletonPair C (m + 1 + 1)).snd).moduleCatCyclesMk w₀ m
      (by simp) hdw₀
  rw [hc.cubicalHomologyδ_eq w ((congrArg (NormalizedCubicalChain.map k _ (m + 1))
    (HomologicalComplex.iCycles_moduleCatCyclesMk ..)).trans hw₀)]
  -- Modulo `Xᵐ`, the cycle `w` is `s`.
  refine TopPair.homologyMap_homologyπ_eq_of_isCubicalRepresentative k _ w hs ?_
  refine TopPair.sub_mem_range_map_ofInclusion (skeletonLT_subset_skeletonLT_succ C (m + 1))
    _ _ ?_
  have hwX : NormalizedCubicalChain.map k
      (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 : ℕ) : ℕ∞) : Set X)) (m + 1)
      (normalizedCubicalChainComplexXEquiv _ (m + 1)
        ((((normalizedCubicalChainComplex k).obj (skeletonPair C (m + 1)).fst).iCycles
          (m + 1)).hom w)) =
      NormalizedCubicalChain.boundary X k (m + 1) (NormalizedCubicalChain.map k
        (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set X))
          (m + 1 + 1) c) :=
    (congrArg (NormalizedCubicalChain.map k _ (m + 1))
      (HomologicalComplex.iCycles_moduleCatCyclesMk ..)).trans
      (map_subtypeVal_eq_boundary_of_map_eq_boundary C hw₀)
  rw [hwX]
  exact hcs

end CellularBoundary

section Brown

variable {B : Type} [TopologicalSpace B] [T2Space B] {b : B} {C : Set B} [CWComplex C]
  {H : Type*} {R : Type} [CommRing R]
  (τ : ∀ (n : ℕ) (j : cell C n), MoorePathBetween B b (map n j 0)) (hC : pathComponent b ⊆ C)
  (m : ℕ)

/-- A chain of `B` lies in stage `q = k - 1` of the skeletal filtration of `B` that supports Brown's
model exactly when it is supported in the skeleton `skeletonLT C k`. -/
private theorem cubicalChainModuleLof_mem_preimageSkeleton_id_iff {n k : ℕ} {q : ℤ}
    (hq : q = k - 1) {c : NormalizedCubicalChain B R n} :
    cubicalChainModuleLof B H R n c ∈ cubicalChainModuleSupportedIn H R (preimageSkeleton C id q) ↔
      c ∈ NormalizedCubicalChain.supportedIn R (skeletonLT C (k : ℕ∞)) n := by
  rw [preimageSkeleton_eq_preimage_skeletonLT id k q hq, preimage_id,
    cubicalChainModuleLof_mem_cubicalChainModuleSupportedIn_iff]

/-- The `(m + 1)`-cells in the row of an `(m + 2)`-cell `x` of Brown's cocycle. -/
private def brownRowCells (x : cell C (m + 1 + 1)) : Finset (cell C (m + 1)) :=
  ((brownModel H R τ hC).cocycle.m ⟨m + 1 + 1, x⟩).support.preimage (Sigma.mk (m + 1))
    sigma_mk_injective.injOn

/-- Outside the `(m + 1)`-cells of the row of `x`, the augmented row of `x` vanishes. -/
private theorem loopChainAugmentation_brownModel_cocycle_m_eq_zero {x : cell C (m + 1 + 1)}
    {y : cell C (m + 1)} (hy : y ∉ brownRowCells (H := H) (R := R) τ hC m x) :
    loopChainAugmentation B b R
      ((brownModel H R τ hC).cocycle.m ⟨m + 1 + 1, x⟩ ⟨m + 1, y⟩) = 0 := by
  rw [brownRowCells, Finset.mem_preimage, Finsupp.mem_support_iff, not_not] at hy
  rw [hy, map_zero]

/-- **The boundary of the base chain of an `(m + 2)`-cell** `x` in Brown's model of a CW complex,
read as a chain `c` of `B`, is congruent modulo the `m`-skeleton to the combination of the
characteristic cubes of the `(m + 1)`-cells with the augmented row of `x` as coefficients. -/
private theorem boundary_sub_sum_mem_supportedIn {x : cell C (m + 1 + 1)}
    {c : NormalizedCubicalChain B R (m + 1 + 1)}
    (hce : cubicalChainModuleLof B H R (m + 1 + 1) c = (brownModel H R τ hC).baseChain ⟨_, x⟩) :
    NormalizedCubicalChain.boundary B R (m + 1) c -
        ∑ y ∈ brownRowCells (H := H) (R := R) τ hC m x, loopChainAugmentation B b R
          ((brownModel H R τ hC).cocycle.m ⟨m + 1 + 1, x⟩ ⟨m + 1, y⟩) •
          NormalizedCubicalChain.ofCube B R (cellCube C (m + 1) y) ∈
      NormalizedCubicalChain.supportedIn R (skeletonLT C ((m + 1 : ℕ) : ℕ∞)) (m + 1) := by
  classical
  have h :=
    brownModel_cubicalChainModuleDifferential_baseChain_sub_mem_cubicalChainModuleSupportedIn
      (H := H) (R := R) τ hC ⟨m + 1 + 1, x⟩
  rw [← hce, cubicalChainModuleDifferential_lof_succ] at h
  -- Split the row into its `(m + 1)`-cells and the cells of lower dimension, whose
  -- characteristic cubes lie in the `m`-skeleton.
  set row := (brownModel H R τ hC).cocycle.m ⟨m + 1 + 1, x⟩
  let t : (Σ n, cell C n) → cubicalChainModule B H R := fun y ↦
    loopChainAugmentation B b R (row y) •
      cubicalChainModuleLof B H R y.1 (NormalizedCubicalChain.ofCube B R (cellCube C y.1 y.2))
  let u : (Σ n, cell C n) → cubicalChainModule B H R := fun y ↦ if y.1 = m + 1 then t y else 0
  have hsum : (row.sum fun y a ↦ loopChainAugmentation B b R a •
      cubicalChainModuleLof B H R y.1 (NormalizedCubicalChain.ofCube B R (cellCube C y.1 y.2))) =
      (∑ y ∈ row.support, u y) + ∑ y ∈ row.support, (t y - u y) := by
    rw [← Finset.sum_add_distrib, Finsupp.sum]
    exact Finset.sum_congr rfl fun y _ ↦ (add_sub_cancel _ _).symm
  have hu : ∑ y ∈ row.support, u y = cubicalChainModuleLof B H R (m + 1)
      (∑ y ∈ brownRowCells (H := H) (R := R) τ hC m x, loopChainAugmentation B b R
        (row ⟨m + 1, y⟩) • NormalizedCubicalChain.ofCube B R (cellCube C (m + 1) y)) := by
    rw [map_sum, brownRowCells, ← Finset.sum_preimage (Sigma.mk (m + 1)) row.support
      sigma_mk_injective.injOn u fun ⟨n, j⟩ _ hy ↦ ?_]
    · exact Finset.sum_congr rfl fun y _ ↦ by simp [u, t]
    by_cases h : n = m + 1
    · subst h
      exact absurd ⟨j, rfl⟩ hy
    · simp [u, h]
  have hv : ∑ y ∈ row.support, (t y - u y) ∈
      cubicalChainModuleSupportedIn H R (preimageSkeleton C id (((m + 1 + 1 : ℕ) : ℤ) - 2)) := by
    refine Submodule.sum_mem _ fun y hy ↦ ?_
    by_cases hym : y.1 = m + 1
    · simp [u, hym]
    · have hlt : y.1 < m + 1 + 1 :=
        brownModel_cocycle_m_mem_supported (H := H) τ hC ⟨m + 1 + 1, x⟩ hy
      simp only [u, hym, ↓reduceIte, sub_zero, t]
      exact Submodule.smul_mem _ _
        ((cubicalChainModuleLof_mem_preimageSkeleton_id_iff (k := m + 1) (by push_cast; ring)).2
          (NormalizedCubicalChain.ofCube_mem_supportedIn R
            ((range_subset_iff.2 (cellCube_mem_skeletonLT_succ C y.1 y.2)).trans
              (skeletonLT_mono (by norm_cast; omega)))))
  rw [hsum, hu, ← sub_sub] at h
  have h' := add_mem h hv
  rw [sub_add_cancel, ← map_sub] at h'
  exact (cubicalChainModuleLof_mem_preimageSkeleton_id_iff (k := m + 1) (by push_cast; ring)).1 h'

/-- **The base chain of an `(m + 2)`-cell represents its basis vector.** In Brown's model of a CW
complex, the base chain `e_x` of an `(m + 2)`-cell `x` is the push-forward of a chain of `Xᵐ⁺²`
that represents the basis vector `[χ_x]` of `Hₘ₊₂(Xᵐ⁺², Xᵐ⁺¹)` (`TauCeti.cellCubeBasis`). -/
theorem brownModel_baseChain_isCubicalRepresentative (x : cell C (m + 1 + 1)) :
    ∃ c : NormalizedCubicalChain (skeletonPair C (m + 1 + 1)).fst R (m + 1 + 1),
      cubicalChainModuleLof B H R (m + 1 + 1) (NormalizedCubicalChain.map R
          (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 + 1 : ℕ) : ℕ∞) : Set B))
          (m + 1 + 1) c) = (brownModel H R τ hC).baseChain ⟨_, x⟩ ∧
        (skeletonPair C (m + 1 + 1)).IsCubicalRepresentative R c (cellCubeBasis C R (m + 1) x) := by
  -- The base chain of `x` is a chain of `Xᵐ⁺²`, congruent to the characteristic cube of `x`
  -- modulo `Xᵐ⁺¹`, so it represents the basis vector of `x`.
  obtain ⟨c, hce⟩ := exists_cubicalChainModuleLof_eq
    ((brownModel H R τ hC).baseChain_mem_cubicalChainModuleGrading ⟨m + 1 + 1, x⟩) (m + 1 + 1)
    (by simp)
  have hc₁ := brownModel_baseChain_mem_cubicalChainModuleSupportedIn (H := H) (R := R) τ hC
    ⟨m + 1 + 1, x⟩
  rw [← hce] at hc₁
  obtain ⟨c', rfl⟩ := (NormalizedCubicalChain.supportedIn_def R _ _).le
    ((cubicalChainModuleLof_mem_preimageSkeleton_id_iff (k := m + 1 + 1 + 1)
      (by push_cast; ring)).1 hc₁)
  have hc₂ := brownModel_baseChain_sub_cellCube_mem_cubicalChainModuleSupportedIn (H := H)
    (R := R) τ hC ⟨m + 1 + 1, x⟩
  rw [← hce, ← map_sub] at hc₂
  refine ⟨c', hce, (isCubicalRepresentative_ofCube_skeletonCellCube C R (m + 1) x).of_sub_mem_range
    (TopPair.sub_mem_range_map_ofInclusion (skeletonLT_subset_skeletonLT_succ C (m + 1 + 1)) _ _
      ?_)⟩
  convert (cubicalChainModuleLof_mem_preimageSkeleton_id_iff (k := m + 1 + 1)
    (by push_cast; ring)).1 hc₂ using 2
  exact map_ofCube_skeletonCellCube C R (m + 1 + 1) x

/-- **The cellular boundary of Brown's model of a CW complex.** In the bases of the characteristic
cubes of the cells (`TauCeti.cellCubeBasis`), the boundary of the cubical cellular chains, the
connecting morphism `Hₘ₊₂(Xᵐ⁺², Xᵐ⁺¹) ⟶ Hₘ₊₁(Xᵐ⁺¹)` followed by the map to `Hₘ₊₁(Xᵐ⁺¹, Xᵐ)`, has
as its coefficient of the `(m + 1)`-cell `y` in the image of the `(m + 2)`-cell `x` the
augmentation `ε(m_{x,y})` of the entry of Brown's twisting cocycle (`TauCeti.brownModel`). -/
theorem cellCubeBasis_repr_homologyMap_cubicalHomologyδ (x : cell C (m + 1 + 1))
    (y : cell C (m + 1)) :
    (cellCubeBasis C R m).repr
        ((HomologicalComplex.homologyMap
          (cokernel.π ((normalizedCubicalChainComplex R).map (skeletonPair C (m + 1)).map))
            (m + 1)).hom
          (((skeletonPair C (m + 1 + 1)).cubicalHomologyδ R (m + 1 + 1) (m + 1)).hom
            (cellCubeBasis C R (m + 1) x))) y =
      loopChainAugmentation B b R ((brownModel H R τ hC).cocycle.m ⟨m + 1 + 1, x⟩ ⟨m + 1, y⟩) := by
  classical
  -- The base chain of `x` represents the basis vector of `x`.
  obtain ⟨c', hce, hrep⟩ := brownModel_baseChain_isCubicalRepresentative (H := H) (R := R) τ hC m x
  -- Its boundary is, modulo `Xᵐ`, the combination of the characteristic cubes of the
  -- `(m + 1)`-cells with the augmented row of `x` as coefficients.
  have hrep₁ := TopPair.IsCubicalRepresentative.sum (s := brownRowCells (H := H) (R := R) τ hC m x)
    fun y _ ↦ (isCubicalRepresentative_ofCube_skeletonCellCube C R m y).smul
      (loopChainAugmentation B b R ((brownModel H R τ hC).cocycle.m ⟨m + 1 + 1, x⟩ ⟨m + 1, y⟩))
  -- Read in `B`, the combination of the characteristic cubes in `Xᵐ⁺¹` is the combination of the
  -- characteristic cubes `TauCeti.cellCube`.
  have hs : NormalizedCubicalChain.map R
      (ContinuousMap.subtypeVal (skeletonLT C ((m + 1 + 1 : ℕ) : ℕ∞) : Set B)) (m + 1)
      (∑ y ∈ brownRowCells (H := H) (R := R) τ hC m x, loopChainAugmentation B b R
        ((brownModel H R τ hC).cocycle.m ⟨m + 1 + 1, x⟩ ⟨m + 1, y⟩) •
        NormalizedCubicalChain.ofCube (skeletonPair C (m + 1)).fst R
          (skeletonCellCube C (m + 1) y)) =
      ∑ y ∈ brownRowCells (H := H) (R := R) τ hC m x, loopChainAugmentation B b R
        ((brownModel H R τ hC).cocycle.m ⟨m + 1 + 1, x⟩ ⟨m + 1, y⟩) •
        NormalizedCubicalChain.ofCube B R (cellCube C (m + 1) y) :=
    (map_sum _ _ _).trans (Finset.sum_congr rfl fun y _ ↦ (LinearMap.map_smul _ _ _).trans
      (congrArg _ (map_ofCube_skeletonCellCube C R (m + 1) y)))
  have hcs := boundary_sub_sum_mem_supportedIn τ hC m hce
  rw [← hs] at hcs
  rw [homologyMap_cubicalHomologyδ_eq_of_isCubicalRepresentative C hrep hrep₁ hcs,
    Module.Basis.repr_finsetSum_smul_self_apply _ _ _
      (loopChainAugmentation_brownModel_cocycle_m_eq_zero τ hC m)]

end Brown

end TauCeti
