module

public import TauCeti.AlgebraicTopology.Singular.Basic
public import TauCeti.Topology.Convenient.CompactlyGenerated
public import TauCeti.AlgebraicTopology.SimplicialSet.TopAdj

/-!
# Singular chains and generated topologies

Refining a space by a family that generates every standard topological simplex does not
change its singular simplicial set. The comparison is induced by the actual generated-topology
counit; its inverse lifts each simplex without changing its underlying function. Consequently
singular chains with coefficients in any preadditive category with the required coproducts
are naturally isomorphic before and after refinement.

In particular, compact generation preserves the singular simplicial set and singular chains
of an arbitrary space, including raw compact-open mapping spaces and stopped Moore path spaces.
No separation or compact-generation hypothesis on that space is required. This is a chain
isomorphism, not just a homology equivalence, and does not assert a homotopy equivalence of
spaces or a homotopy lifting property.

When a common family `G` generates both standard simplices and finite cubes (for instance,
`CompHaus`), this singular comparison and the normalized cubical comparison in
`TauCeti.AlgebraicTopology.Singular.Cubical.GeneratedBy` are induced by the same space-level
counit `(GeneratedByTopCat.adjCounit (X := G)).app X`. Naturality of `TauCeti.cubicalToSingular`
therefore makes their comparison square commute.

## References

* R. M. Vogt, *Convenient categories of topological spaces for homotopy theory* (1971).

The singular simplicial set and singular-chain functors are Mathlib's `TopCat.toSSet` and
`AlgebraicTopology.singularChainComplexFunctor`.
-/

public section

noncomputable section

universe t u v w w'

open CategoryTheory Convexity Topology TopCat
open scoped Simplicial

namespace TauCeti.TopCat

variable {ι : Type t} (G : ι → Type v) [∀ i, TopologicalSpace (G i)]

/-- The generated-topology counit is bijective on singular simplices whenever the standard
simplex is generated by the chosen family. -/
theorem bijective_toSSet_map_generatedByCounit_app (X : TopCat.{u}) (n : SimplexCategoryᵒᵖ)
    [IsGeneratedBy G (StdSimplex ℝ (Fin (n.unop.len + 1)))] :
    Function.Bijective ((toSSet.map (ofHom (WithGeneratedByTopology.counit G X))).app n) := by
  constructor
  · intro σ τ h
    apply (toSSetObjEquiv _ n).injective
    simpa only [toSSetObjEquiv_toSSet_map_app, ConcreteCategory.hom_ofHom,
      ContinuousMap.toGeneratedBy_equiv_comp] using
      congrArg (fun ρ ↦ (toSSetObjEquiv X n ρ).toGeneratedBy G) h
  · intro σ
    refine ⟨(toSSetObjEquiv _ n).symm ((toSSetObjEquiv X n σ).toGeneratedBy G), ?_⟩
    apply (toSSetObjEquiv X n).injective
    simp only [toSSetObjEquiv_toSSet_map_app, ConcreteCategory.hom_ofHom,
      Equiv.apply_symm_apply,
      ContinuousMap.equiv_comp_toGeneratedBy]

variable [∀ n : ℕ, IsGeneratedBy G (StdSimplex ℝ (Fin (n + 1)))]

/-- Refinement by generators that generate every simplex preserves the singular simplicial set.
This applies in particular to compact generation, for any original space. -/
instance isIso_toSSet_map_generatedByCounit (X : TopCat.{u}) :
    IsIso (toSSet.map ((GeneratedByTopCat.adjCounit (X := G)).app X)) := by
  have (n : SimplexCategoryᵒᵖ) :
      IsIso ((toSSet.map ((GeneratedByTopCat.adjCounit (X := G)).app X)).app n) :=
    (CategoryTheory.isIso_iff_bijective _).2 (by
      have h := bijective_toSSet_map_generatedByCounit_app G X n
      rw [← GeneratedByTopCat.adjCounit_app_hom] at h
      exact h)
  exact NatIso.isIso_of_isIso_app _

/-- The natural singular simplicial set comparison induced by the generated-topology counit. -/
def toSSetGeneratedByIso :
    (TopCat.toGeneratedByTopCat (X := G) ⋙ GeneratedByTopCat.toTopCat) ⋙ toSSet ≅ toSSet :=
  NatIso.ofComponents
    (fun X ↦ asIso (toSSet.map ((GeneratedByTopCat.adjCounit (X := G)).app X)))
    (fun f ↦ by
      simpa only [asIso_hom, Functor.comp_map, Functor.id_map, ← Functor.map_comp] using
        congrArg toSSet.map ((GeneratedByTopCat.adjCounit (X := G)).naturality f))

/-- The forward singular-set comparison is induced by the counit. -/
@[simp]
theorem toSSetGeneratedByIso_hom_app (X : TopCat.{u}) :
    (toSSetGeneratedByIso G).hom.app X =
      toSSet.map ((GeneratedByTopCat.adjCounit (X := G)).app X) :=
  (rfl)

/-- The inverse singular-set comparison is the inverse of the counit-induced map. -/
@[simp]
theorem toSSetGeneratedByIso_inv_app (X : TopCat.{u}) :
    (toSSetGeneratedByIso G).inv.app X =
      inv (toSSet.map ((GeneratedByTopCat.adjCounit (X := G)).app X)) :=
  (rfl)

/-- The inverse singular-set comparison lifts precisely the same continuous simplex to the
refined topology. -/
theorem toSSetObjEquiv_toSSetGeneratedByIso_inv_app_app (X : TopCat.{u}) (n : SimplexCategoryᵒᵖ)
    (σ : (toSSet.obj X).obj n) :
    toSSetObjEquiv ((TopCat.toGeneratedByTopCat (X := G) ⋙
        GeneratedByTopCat.toTopCat).obj X) n
        (((toSSetGeneratedByIso G).inv.app X).app n σ) =
      (toSSetObjEquiv X n σ).toGeneratedBy G := by
  -- The composite functor's object has carrier `WithGeneratedByTopology G X` definitionally.
  let f : C(StdSimplex ℝ (Fin (n.unop.len + 1)), WithGeneratedByTopology G X) :=
    toSSetObjEquiv _ n (((toSSetGeneratedByIso G).inv.app X).app n σ)
  have h : ((toSSet.map ((GeneratedByTopCat.adjCounit (X := G)).app X)).app n)
      ((((toSSetGeneratedByIso G).inv.app X).app n) σ) = σ :=
    ((((toSSetGeneratedByIso G).app X).app n).inv_hom_id_apply σ)
  have hc := congrArg (toSSetObjEquiv X n) h
  rw [toSSetObjEquiv_toSSet_map_app] at hc
  have hf : (WithGeneratedByTopology.counit G X).comp f = toSSetObjEquiv X n σ := by
    rwa [← GeneratedByTopCat.adjCounit_app_hom]
  exact (ContinuousMap.toGeneratedBy_equiv_comp f).symm.trans
    (congrArg (fun τ : C(StdSimplex ℝ (Fin (n.unop.len + 1)), X) ↦ τ.toGeneratedBy G) hf)

/-- After applying the counit, the inverse comparison evaluates to the original simplex. -/
theorem adjCounit_toSSetObjEquiv_toSSetGeneratedByIso_inv_app_app (X : TopCat.{u})
    (n : SimplexCategoryᵒᵖ) (σ : (toSSet.obj X).obj n)
    (z : StdSimplex ℝ (Fin (n.unop.len + 1))) :
    ((GeneratedByTopCat.adjCounit (X := G)).app X)
        (toSSetObjEquiv _ n (((toSSetGeneratedByIso G).inv.app X).app n σ) z) =
      toSSetObjEquiv X n σ z := by
  have h : ((toSSet.map ((GeneratedByTopCat.adjCounit (X := G)).app X)).app n)
      ((((toSSetGeneratedByIso G).inv.app X).app n) σ) = σ :=
    ((((toSSetGeneratedByIso G).app X).app n).inv_hom_id_apply σ)
  have hc := congrArg (toSSetObjEquiv X n) h
  rw [toSSetObjEquiv_toSSet_map_app] at hc
  exact ContinuousMap.congr_fun hc z

-- Exercise compact generation with independent test-space and target universes.
example (X : TopCat.{u}) :
    IsIso (toSSet.map ((GeneratedByTopCat.adjCounit
      (X := fun K : CompHaus.{v} ↦ K)).app X)) := inferInstance

end TauCeti.TopCat

namespace TauCeti

variable {ι : Type t} (G : ι → Type v) [∀ i, TopologicalSpace (G i)]
  [∀ n : ℕ, IsGeneratedBy G (StdSimplex ℝ (Fin (n + 1)))]
  {C : Type w} [Category.{w'} C] [Preadditive C] [Limits.HasCoproducts.{u} C] (R : C)

/-- The generated-topology counit induces an isomorphism on singular chains, with arbitrary
coefficients in a preadditive category with coproducts. -/
instance isIso_singularChainComplexFunctor_map_generatedByCounit (X : TopCat.{u}) :
    IsIso (((AlgebraicTopology.singularChainComplexFunctor C).obj R).map
      ((GeneratedByTopCat.adjCounit (X := G)).app X)) := by
  rw [singularChainComplexFunctor_obj_map]
  have := TopCat.isIso_toSSet_map_generatedByCounit G X
  exact Functor.map_isIso ((SSet.chainComplexFunctor C).obj R) _

/-- Singular chains are naturally unchanged by a refinement whose generators generate every
standard simplex. The comparison is induced by the actual counit. -/
def singularChainComplexFunctorGeneratedByIso :
    (TopCat.toGeneratedByTopCat (X := G) ⋙ GeneratedByTopCat.toTopCat) ⋙
        (AlgebraicTopology.singularChainComplexFunctor C).obj R ≅
      (AlgebraicTopology.singularChainComplexFunctor C).obj R :=
  Functor.isoWhiskerRight (TopCat.toSSetGeneratedByIso G) ((SSet.chainComplexFunctor C).obj R)

/-- The forward chain comparison is the singular chain map of the counit. -/
theorem singularChainComplexFunctorGeneratedByIso_hom_app (X : TopCat.{u}) :
    (singularChainComplexFunctorGeneratedByIso G R).hom.app X =
      ((AlgebraicTopology.singularChainComplexFunctor C).obj R).map
        ((GeneratedByTopCat.adjCounit (X := G)).app X) :=
  (rfl)

/-- The inverse chain comparison is induced by the inverse singular-set comparison. -/
theorem singularChainComplexFunctorGeneratedByIso_inv_app (X : TopCat.{u}) :
    (singularChainComplexFunctorGeneratedByIso G R).inv.app X =
      SSet.chainComplexMap ((TopCat.toSSetGeneratedByIso G).inv.app X) R :=
  (rfl)

/-- On each singular-chain summand, the inverse comparison is induced by lifting its simplex
to the generated topology. -/
theorem ιChainComplex_singularChainComplexFunctorGeneratedByIso_inv_app_f
    (X : TopCat.{u}) {n : ℕ} (σ : (TopCat.toSSet.obj X).obj (Opposite.op ⦋n⦌)) :
    (TopCat.toSSet.obj X).ιChainComplex σ ≫
        ((singularChainComplexFunctorGeneratedByIso G R).inv.app X).f n =
      (TopCat.toSSet.obj ((TopCat.toGeneratedByTopCat (X := G) ⋙
        GeneratedByTopCat.toTopCat).obj X)).ιChainComplex
          ((((TopCat.toSSetGeneratedByIso G).inv.app X).app (Opposite.op ⦋n⦌)) σ) :=
  SSet.ι_chainComplexMap_f _ _ _ R σ

-- The coefficient morphism universe is also independent of both space universes.
example (X : TopCat.{u}) :
    IsIso (((AlgebraicTopology.singularChainComplexFunctor C).obj R).map
      ((GeneratedByTopCat.adjCounit (X := fun K : CompHaus.{v} ↦ K)).app X)) := inferInstance

end TauCeti
