module

public import TauCeti.AlgebraicTopology.Singular.Homotopy.Invariance
public import TauCeti.AlgebraicTopology.Singular.LocalHomology.Compact
public import TauCeti.AlgebraicTopology.Singular.LocalHomology.Noncompact
public import TauCeti.AlgebraicTopology.Singular.LocalHomology.OpenEmbedding
public import TauCeti.Geometry.Manifold.Boundary.Collar.Retraction

/-!
# Top homology of a space with compact collared boundary

Let `X` be a Hausdorff space and `ι : M → X` an open embedding of a topological `n`-manifold `M`
without boundary, whose complement `∂X = X ∖ ι(M)` is the image of a collared map `f : N → X`
(`TauCeti.IsCollared`) from a compact space `N`, as for a compact topological manifold with
boundary or with corners and its interior. This file proves that the map
`Hₙ(X; R) → Hₙ(X, ∂X; R)` of the long exact sequence of the pair is injective, with coefficients
in any module `R` (`TauCeti.injective_singularHomologyπ_of_isCollared`). Equivalently, the image
of `Hₙ(∂X; R)` in `Hₙ(X; R)` is zero, although `∂X` itself, a space of dimension `n - 1` with
corners, is not assumed to be a manifold.

The proof runs through the interior. The collar pushes `X` off its boundary, so `ι` is a homotopy
equivalence (`TauCeti.IsCollar.homotopyEquivOfRangeEq`), and every class of `Hₙ(X)` is `ι_* β`
for a class `β` of `Hₙ(M)`. If `ι_* β` vanishes in `Hₙ(X, ∂X)`, then it vanishes in the local
homology `Hₙ(X, X ∖ {ι x})` at every point `x` of `M`, since `∂X ⊆ X ∖ {ι x}`; by excision along
`ι` the local class of `β` at `x` vanishes. A class of `Hₙ(M, M ∖ L)`, for compact `L`, is
detected at the points of `L` (`TauCeti.eq_zero_of_forall_localHomologyRestriction_eq_zero`), and
a class of `Hₙ(M)` vanishing in `Hₙ(M, M ∖ L)` for every compact `L` is zero
(`TauCeti.eq_zero_of_forall_isCompact_singularHomologyπ_eq_zero`, Hatcher's Lemma 3.27 and
Proposition 3.33). So `β = 0`.

For a compact manifold with boundary this says that the top homology is carried by the closed
components: for `[0, 1] ⊔ S¹` in dimension one, `H₁(X)` is generated by the circle, whose class
survives in `H₁(X, ∂X)`, while for the closed disc `Dⁿ`, `Hₙ(Dⁿ) = 0`. The collar is needed: for
`X` the circle with empty interior, `∂X = X` is not collared, and `H₁(X) → H₁(X, X) = 0` is not
injective.

This is the injectivity condition under which representing chain systems of fundamental classes
of compactified trajectory spaces are unique up to homotopy
(`TauCeti.TwistingChainSystem.IsRepresenting.nonempty_homotopy`).

## Main results

* `TauCeti.injective_singularHomologyπ_of_isCollared`: `Hₙ(X; R) → Hₙ(X, ∂X; R)` is injective.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 3.3, Lemma 3.27 and Proposition 3.33.
* J.-F. Barraud, M. Damian, V. Humilière, A. Oancea, *Morse homology with differential graded
  coefficients*, Progress in Mathematics 360, Birkhäuser, 2025, Proposition 5.2.8.
-/

public section

noncomputable section

open CategoryTheory Limits Module Set Topology

universe w

namespace TauCeti

variable {Λ : Type w} [Ring Λ] (R : ModuleCat.{w} Λ)
  {X M N E : Type w} [TopologicalSpace X] [T2Space X] [TopologicalSpace M] [TopologicalSpace N]
  [CompactSpace N] [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [ChartedSpace E M] {ι : M → X} {f : N → X} {n : ℕ}

/-- **The top homology of a space with compact collared boundary embeds in its relative
homology.** Let `X` be a Hausdorff space, `ι : M → X` an open embedding of a manifold `M` of
dimension `n` without boundary, and suppose that the complement `∂X = X ∖ ι(M)` is the image of a
collared map `f` from a compact space. Then `Hₙ(X; R) → Hₙ(X, ∂X; R)` is injective. -/
theorem injective_singularHomologyπ_of_isCollared (hn : finrank ℝ E = n)
    (hι : IsOpenEmbedding ι) (hιf : range ι = (range f)ᶜ) (hf : IsCollared f) :
    Function.Injective ((TopPair.ofSubset ((range ι)ᶜ : Set (TopCat.of X))).singularHomologyπ
      (C := ModuleCat.{w} Λ) R n).hom := by
  obtain ⟨c, hc⟩ := isCollared_iff.1 hf
  have : T2Space M := hι.isEmbedding.t2Space
  have : LocallyCompactSpace M := ChartedSpace.locallyCompactSpace E M
  let j : C(M, X) := ⟨ι, hι.continuous⟩
  -- The interior is a homotopy equivalence, so every class of `Hₙ(X)` comes from `Hₙ(M)`.
  have hsurj : Function.Surjective
      (SSet.homologyMap (TopCat.toSSet.map (TopCat.ofHom j)) R n).hom := by
    have hj : TopCat.ofHom (hc.homotopyEquivOfRangeEq hι.isEmbedding hιf).toFun = TopCat.ofHom j :=
      TopCat.hom_ext (ContinuousMap.ext fun x ↦
        congrFun (hc.coe_homotopyEquivOfRangeEq hι.isEmbedding hιf) x)
    have := (ConcreteCategory.bijective_of_isIso
      ((hc.homotopyEquivOfRangeEq hι.isEmbedding hιf).singularHomologyIso R n).hom).2
    rwa [ContinuousMap.HomotopyEquiv.singularHomologyIso_hom, hj] at this
  rw [injective_iff_map_eq_zero]
  intro α hα
  obtain ⟨β, rfl⟩ := hsurj α
  -- The local class of `β` at every point of `M` vanishes.
  have hloc (x : M) : singularHomologyToLocalHomology R x n β = 0 := by
    have hx : j ⁻¹' {j x} ⊆ {x} := fun y hy ↦ hι.injective hy
    have h₁ := singularHomologyToLocalHomology_singularHomologyMap R j hx β
    rw [singularHomologyToLocalHomology_eq_localHomologyRestriction R (S := range ι) (x := j x)
      (mem_range_self x), hα, map_zero] at h₁
    have := isIso_localHomologyMap R j hι (S := {x}) (T := {j x})
      (subset_antisymm hx (by simp)) isClosed_singleton
      (singleton_subset_iff.2 (mem_range_self x)) n
    exact (injective_iff_map_eq_zero _).1
      (ConcreteCategory.bijective_of_isIso (localHomologyMap R j hx n)).1 _ h₁.symm
  -- A class of `Hₙ(M)` with vanishing local classes is zero.
  have hβ : β = 0 := by
    refine eq_zero_of_forall_isCompact_singularHomologyπ_eq_zero R
      (fun D hD ↦ isZero_localHomology_of_isCompact R hn hD (Nat.lt_succ_self n)) β
      fun L hL ↦ eq_zero_of_forall_localHomologyRestriction_eq_zero R hn hL _ fun x hx ↦ ?_
    rw [← singularHomologyToLocalHomology_eq_localHomologyRestriction R hx]
    exact hloc x
  rw [hβ]
  exact map_zero _

end TauCeti
