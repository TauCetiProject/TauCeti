module

public import TauCeti.AlgebraicTopology.Singular.LocalHomology.IsFundamentalClass
public import TauCeti.AlgebraicTopology.Singular.LocalHomology.RelativeFundamentalClass
import TauCeti.AlgebraicTopology.Singular.LocalHomology.OpenEmbedding
import TauCeti.AlgebraicTopology.Singular.Triple

/-!
# The boundary of the relative fundamental class

Let `X` be a compact Hausdorff space and `ι : M → X` an open embedding of an oriented topological
`n`-manifold `M` whose complement `∂X = X ∖ ι(M)` is collared, as for a compact manifold with
boundary or with corners. The relative fundamental class `[X, ∂X] ∈ Hₙ(X, ∂X; ℤ)` is
`TauCeti.HomologicalOrientation.fundamentalClassRel`. This file proves that the connecting
morphism `Hₙ(X, ∂X; ℤ) ⟶ Hₙ₋₁(∂X; ℤ)` sends it to a fundamental class of `∂X`
(`TauCeti.IsFundamentalClass`): at every point of `∂X` its image generates the local homology of
`∂X` there. Consequently a chain representing `[X, ∂X]` has as boundary a fundamental cycle of
`∂X`. This is the homological input of fundamental chains relative to the boundary, as in the
gluing condition of representing chain systems (`TauCeti.TwistingChainSystem.IsRepresenting`),
where the boundary is assembled from products of lower-dimensional spaces. No manifold structure on
`∂X` is assumed: the argument shows directly that its local homology at each point is a copy of
`ℤ` generated by the image of `[X, ∂X]`.

Near a boundary point `f y`, with interior point `ι x = c (y, 1 / 2)` of the collar `c` and segment
`S = c({y} × [0, 1 / 2])` between them, three identifications carry the local orientation at `x`
to the image of `[X, ∂X]` at `f y`:

* the total pair `(X, X ∖ S)` of the triple `(X, X ∖ {ι x}, X ∖ S)` is acyclic, since pushing the
  collar depth up moves everything off `S`, so the connecting morphism of the triple
  `Hₙ(X, X ∖ {ι x}) ⟶ Hₙ₋₁(X ∖ {ι x}, X ∖ S)` is an isomorphism;
* the inclusion of `∂X` into `X ∖ {ι x}` identifies `Hₙ₋₁(∂X, ∂X ∖ {f y})` with
  `Hₙ₋₁(X ∖ {ι x}, X ∖ S)`, through the collar of depth less than `1 / 2`, which deforms onto
  `∂X` keeping base points;
* naturality of connecting morphisms makes the resulting square commute.

## Main results

* `TauCeti.HomologicalOrientation.isFundamentalClass_singularHomologyδ_fundamentalClassRel`: the
  connecting morphism sends the relative fundamental class to a fundamental class of the boundary.

## References

* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, Section 3.3, the fundamental
  class of a compact manifold with boundary and its image in the homology of the boundary.
* J.-F. Barraud, O. Cornea, *Lagrangian intersections and the Serre spectral sequence*, Annals of
  Mathematics 166 (2007), Appendix A, where fundamental chains relative to the boundary of the
  compactified trajectory spaces form the representing chain systems.
-/

public section

noncomputable section

open CategoryTheory Limits Set Topology unitInterval

universe w v u

namespace TauCeti

namespace IsCollar

variable {A : Type u} [Category.{v} A] [HasCoproducts.{w} A] [Abelian A] (R : A)
  {X : Type w} {N : Type*} [TopologicalSpace X] [TopologicalSpace N] {f : N → X}
  {c : N × Ico (0 : ℝ) 1 → X}

/-- The segment `c({y} × [0, s])` of the collar `c` over the base point `y`, from `f y` to depth
`s`. -/
private def segment (c : N × Ico (0 : ℝ) 1 → X) (y : N) {s : ℝ} (hs : s < 1) : Set X :=
  range fun u : Icc (0 : ℝ) s ↦ c (y, ⟨u, u.2.1, u.2.2.trans_lt hs⟩)

variable (hc : IsCollar f c)
include hc

/-- A point of the collar lies on the segment over `y` up to depth `s` exactly when its base point
is `y` and its depth is at most `s`. -/
private lemma apply_mem_segment_iff {y : N} {s : ℝ} (hs : s < 1) {p : N × Ico (0 : ℝ) 1} :
    c p ∈ segment c y hs ↔ p.1 = y ∧ (p.2 : ℝ) ≤ s := by
  constructor
  · rintro ⟨u, hu⟩
    obtain rfl := hc.isOpenEmbedding.injective hu
    exact ⟨rfl, u.2.2⟩
  · rintro ⟨rfl, hp⟩
    exact ⟨⟨p.2, p.2.2.1, hp⟩, rfl⟩

omit hc in
private lemma isCompact_segment (hcc : Continuous c) (y : N) {s : ℝ} (hs : s < 1) :
    IsCompact (segment c y hs) :=
  isCompact_range (hcc.comp (continuous_const.prodMk (by fun_prop)))

/-- The depth `(1 - τ) d + τ t` between the depths `d` and `t` of the collar. -/
private def interpDepth (τ : I) (d : Ico (0 : ℝ) 1) {t : ℝ} (ht : t ∈ Ico (0 : ℝ) 1) :
    Ico (0 : ℝ) 1 :=
  ⟨(1 - τ) * d + τ * t, by
    have h₁ := mul_le_mul_of_nonneg_left (le_max_left (d : ℝ) t) (sub_nonneg.2 τ.2.2)
    have h₂ := mul_le_mul_of_nonneg_left (le_max_right (d : ℝ) t) τ.2.1
    have := max_lt d.2.2 ht.2
    exact ⟨add_nonneg (mul_nonneg (sub_nonneg.2 τ.2.2) d.2.1) (mul_nonneg τ.2.1 ht.1),
      by nlinarith⟩⟩

omit hc in
private lemma coe_interpDepth (τ : I) (d : Ico (0 : ℝ) 1) {t : ℝ} (ht : t ∈ Ico (0 : ℝ) 1) :
    (interpDepth τ d ht : ℝ) = (1 - τ) * d + τ * t :=
  rfl

/-- Inside the collar `C = c(N × [0, 1))`, for `0 ≤ s < 1`, the local homology of `C` along the
segment `c({y} × [0, s])` vanishes: pushing the depth linearly up to a level `t > s` moves every
point off the segment, and never moves a point off the segment onto it. -/
private theorem isZero_localHomology_collarPart_segment (y : N) {s : ℝ} (hs0 : 0 ≤ s)
    (hs : s < 1) (k : ℕ) :
    IsZero (localHomology R (Subtype.val ⁻¹' segment c y hs : Set (collarPart c 1)) k) := by
  obtain ⟨t, hst, ht1⟩ : ∃ t, s < t ∧ t < 1 := ⟨(s + 1) / 2, by linarith, by linarith⟩
  have ht : t ∈ Ico (0 : ℝ) 1 := ⟨hs0.trans hst.le, ht1⟩
  let H : I × collarPart c 1 → collarPart c 1 := fun q ↦ ⟨c ((hc.collarCoord 1 q.2).1,
    interpDepth q.1 (hc.collarCoord 1 q.2).2 ht),
    mem_collarPart_iff.2 ⟨_, (interpDepth q.1 _ ht).2.2, rfl⟩⟩
  have hH : Continuous H := by
    refine Continuous.subtype_mk (hc.isOpenEmbedding.continuous.comp ?_) _
    have h := (map_continuous (hc.collarCoord 1)).comp (continuous_snd (X := I))
    exact h.fst.prodMk (Continuous.subtype_mk (((continuous_const.sub
      (continuous_subtype_val.comp continuous_fst)).mul (continuous_subtype_val.comp h.snd)).add
        ((continuous_subtype_val.comp continuous_fst).mul continuous_const)) _)
  -- A point of the collar lies on the segment exactly when its collar coordinates do.
  have hmem (z : collarPart c 1) : (z : X) ∈ segment c y hs ↔ (hc.collarCoord 1 z).1 = y ∧
      ((hc.collarCoord 1 z).2 : ℝ) ≤ s := by
    rw [← hc.apply_mem_segment_iff hs, hc.apply_collarCoord]
  have hcoord (q : I × collarPart c 1) : hc.collarCoord 1 (H q) =
      ((hc.collarCoord 1 q.2).1, interpDepth q.1 (hc.collarCoord 1 q.2).2 ht) :=
    hc.collarCoord_apply _ _ rfl
  refine isZero_localHomology_of_homotopy R (g := ⟨fun z ↦ H (1, z), hH.comp (by fun_prop)⟩)
    { toFun := H
      continuous_toFun := hH
      map_zero_left := fun z ↦ Subtype.ext <| by
        refine Eq.trans ?_ (hc.apply_collarCoord z)
        exact congrArg c (Prod.ext rfl (Subtype.ext (by simp [coe_interpDepth])))
      map_one_left := fun _ ↦ rfl } (fun τ z hz ↦ ?_) (fun z hz ↦ ?_) k
  · -- A point off the segment over `y` has depth beyond `s`, and stays beyond `s`.
    have hz' : (z : X) ∉ segment c y hs := hz
    have hHz : ((H (τ, z) : collarPart c 1) : X) ∉ segment c y hs := by
      rw [hmem] at hz' ⊢
      rw [hcoord]
      rintro ⟨rfl, h⟩
      have hd : s < (hc.collarCoord 1 z).2 := lt_of_not_ge fun h' ↦ hz' ⟨rfl, h'⟩
      rw [coe_interpDepth] at h
      nlinarith [mul_le_mul_of_nonneg_left (min_le_left ((hc.collarCoord 1 z).2 : ℝ) t)
        (sub_nonneg.2 τ.2.2), mul_le_mul_of_nonneg_left
        (min_le_right ((hc.collarCoord 1 z).2 : ℝ) t) τ.2.1, lt_min hd hst]
    exact hHz
  · -- At the end of the deformation every point has depth `t > s`.
    have hz' : ((H (1, z) : collarPart c 1) : X) ∈ segment c y hs := hz
    rw [hmem, hcoord, coe_interpDepth] at hz'
    simp only [Icc.coe_one, sub_self, zero_mul, one_mul, zero_add] at hz'
    exact absurd hz'.2 (not_le.2 hst)

/-- **The collar has no local homology along a segment.** For `0 ≤ s < 1`, the local homology
`Hₖ(X, X ∖ c({y} × [0, s]))` vanishes: by excision it is the local homology of the image of the
collar along the segment. -/
private theorem isZero_localHomology_segment [T2Space X] (y : N) {s : ℝ} (hs0 : 0 ≤ s)
    (hs : s < 1) (k : ℕ) : IsZero (localHomology R (segment c y hs) k) := by
  let j : C(collarPart c 1, X) := ⟨Subtype.val, continuous_subtype_val⟩
  have := isIso_localHomologyMap R j (hc.isOpen_collarPart 1).isOpenEmbedding_subtypeVal
    (S := Subtype.val ⁻¹' segment c y hs) (T := segment c y hs) rfl
    (isCompact_segment hc.isOpenEmbedding.continuous y hs).isClosed (by
      rintro _ ⟨u, rfl⟩
      rw [ContinuousMap.coe_mk, Subtype.range_coe]
      exact mem_collarPart_iff.2 ⟨_, u.2.2.trans_lt hs, rfl⟩) k
  exact IsZero.of_iso (hc.isZero_localHomology_collarPart_segment R y hs0 hs k)
    (asIso (localHomologyMap R j (S := Subtype.val ⁻¹' segment c y hs) (T := segment c y hs)
      subset_rfl k)).symm

/-- On the collar `c(N × [0, s))` of depth less than `s`, the segment over `y` is the set of points
over `y`. -/
private lemma mem_segment_iff_collarCoord {y : N} {s : ℝ} (hs : s < 1) (z : collarPart c s) :
    (z : X) ∈ segment c y hs ↔ (hc.collarCoord s z).1 = y := by
  rw [← hc.apply_collarCoord z, hc.apply_mem_segment_iff hs]
  exact and_iff_left (hc.collarCoord_lt z).le

/-- The boundary `f(N)` meets the segment over `y` only at `f y`. -/
private lemma eq_of_mem_segment {y z : N} {s : ℝ} (hs : s < 1) (h : f z ∈ segment c y hs) :
    z = y := by
  rw [← hc.apply_zero] at h
  exact ((hc.apply_mem_segment_iff hs).1 h).1

/-- The local homology of the boundary `f(N)` at `f y` is that of the collar `c(N × [0, s))` along
the segment over `y`, through the inclusion: the collar deforms onto the boundary keeping base
points. -/
private theorem isIso_localHomologyMap_inclusion_collarPart (y : N) {s : ℝ} (hs0 : 0 < s)
    (hs : s < 1) (h : ContinuousMap.inclusion (hc.range_subset_collarPart hs0) ⁻¹'
      (Subtype.val ⁻¹' segment c y hs) ⊆ {⟨f y, mem_range_self y⟩}) (k : ℕ) :
    IsIso (localHomologyMap R (ContinuousMap.inclusion (hc.range_subset_collarPart hs0)) h k) := by
  let g := ContinuousMap.inclusion (hc.range_subset_collarPart hs0)
  let r := hc.collarRetraction s
  have hr : r ⁻¹' {⟨f y, mem_range_self y⟩} ⊆ Subtype.val ⁻¹' segment c y hs := by
    intro z hz
    rw [mem_preimage, hc.mem_segment_iff_collarCoord]
    exact hc.injective ((hc.coe_collarRetraction z).symm.trans
      (congrArg Subtype.val (mem_singleton_iff.1 hz)))
  -- The retraction undoes the inclusion of the boundary.
  have hrg : r.comp g = ContinuousMap.id _ := by
    ext ⟨_, z, rfl⟩
    rw [ContinuousMap.comp_apply, hc.coe_collarRetraction,
      hc.collarCoord_apply _ (z, ⟨0, by norm_num⟩) (hc.apply_zero z)]
    rfl
  -- The deformation of the collar onto the boundary keeps base points, so it never moves a point
  -- off the segment onto it.
  have hF (τ : I) (z : collarPart c s) (hz : z ∉ Subtype.val ⁻¹' segment c y hs) :
      (hc.collarDeformation hs0).toHomotopy (τ, z) ∉ Subtype.val ⁻¹' segment c y hs := by
    rw [mem_preimage, hc.mem_segment_iff_collarCoord] at hz ⊢
    rwa [ContinuousMap.HomotopyWith.coe_toHomotopy, hc.collarCoord_collarDeformation_fst]
  refine ⟨⟨localHomologyMap R r hr k, ?_, ?_⟩⟩
  · rw [localHomologyMap_comp, localHomologyMap_congr R hrg]
    exact localHomologyMap_id_self R _ k
  · rw [localHomologyMap_comp]
    exact (localHomologyMap_eq_of_homotopy R (hc.collarDeformation hs0).toHomotopy hF _
      subset_rfl k).trans (localHomologyMap_id_self R _ k)

/-- **The boundary near a point is the collar near the segment.** Let `B = f(N)` be the collared
boundary, `y ∈ N`, `0 < s < 1` and `x = c (y, s)`. The inclusion `B → X ∖ {x}` induces an
isomorphism from the local homology of `B` at `f y` to the local homology of `X ∖ {x}` along the
segment `c({y} × [0, s])`. It factors through the collar `c(N × [0, s))` of depth less than `s`,
which deforms onto `B` keeping base points, and which contains the segment minus `x`. -/
private theorem isIso_localHomologyMap_inclusion [T2Space X] {B : Set X} (hB : range f = B)
    (y : N) {s : ℝ} (hs0 : 0 < s) (hs : s < 1) {x : X} (hx : c (y, ⟨s, hs0.le, hs⟩) = x)
    (hBx : B ⊆ {x}ᶜ) (hy : f y ∈ B)
    (h : ContinuousMap.inclusion hBx ⁻¹' (Subtype.val ⁻¹' segment c y hs) ⊆ {⟨f y, hy⟩})
    (k : ℕ) : IsIso (localHomologyMap R (ContinuousMap.inclusion hBx) h k) := by
  subst hB hx
  have hKx : collarPart c s ⊆ {c (y, ⟨s, hs0.le, hs⟩)}ᶜ := by
    intro z hz hzx
    obtain ⟨p, hp, rfl⟩ := mem_collarPart_iff.1 hz
    rw [hc.isOpenEmbedding.injective hzx] at hp
    exact lt_irrefl s hp
  let g := ContinuousMap.inclusion (hc.range_subset_collarPart hs0)
  have hg : g ⁻¹' (Subtype.val ⁻¹' segment c y hs) ⊆ {⟨f y, hy⟩} := fun b hb ↦ h hb
  have := hc.isIso_localHomologyMap_inclusion_collarPart R y hs0 hs hg k
  -- Excise the complement of the collar of depth less than `s` from `X ∖ {x}`.
  let jK := ContinuousMap.inclusion hKx
  have hjK : IsOpenEmbedding jK :=
    ((isOpen_compl_singleton.isOpenEmbedding_subtypeVal).of_comp_iff _).1
      (hc.isOpen_collarPart s).isOpenEmbedding_subtypeVal
  have : IsIso (localHomologyMap R jK (S := Subtype.val ⁻¹' segment c y hs)
      (T := Subtype.val ⁻¹' segment c y hs) subset_rfl k) := by
    refine isIso_localHomologyMap R jK hjK rfl
      ((isCompact_segment hc.isOpenEmbedding.continuous y hs).isClosed.preimage
        continuous_subtype_val) ?_ k
    rintro ⟨_, hzx⟩ ⟨⟨u, hu₀, hus⟩, rfl⟩
    refine ⟨⟨_, mem_collarPart_iff.2 ⟨_, lt_of_le_of_ne hus fun h ↦ hzx ?_, rfl⟩⟩, rfl⟩
    exact congrArg c (Prod.ext rfl (Subtype.ext h))
  have hcomp := localHomologyMap_comp R g jK hg
    (subset_rfl : jK ⁻¹' (Subtype.val ⁻¹' segment c y hs) ⊆ _) k
  rw [localHomologyMap_congr R (show ContinuousMap.inclusion hBx = jK.comp g from rfl), ← hcomp]
  infer_instance

end IsCollar

section Square

variable {A : Type u} [Category.{v} A] [HasCoproducts.{w} A] [Abelian A] (R : A)
  {X : Type w} [TopologicalSpace X]

/-- For `x ∈ S`, the connecting morphism `Hₙ(X, X ∖ {x}) ⟶ Hₘ(X ∖ {x}, X ∖ S)` of the triple
`(X, X ∖ {x}, X ∖ S)`, read in the local homology of `X ∖ {x}` along `S`. -/
private def tripleδ {S : Set X} {x : X} (hSx : Sᶜ ⊆ {x}ᶜ) {n m : ℕ} (hm : m + 1 = n) :
    localHomology R {x} n ⟶ localHomology R (Subtype.val ⁻¹' S : Set ↥({x}ᶜ : Set X)) m :=
  (TopTriple.ofSubset (X := TopCat.of X) hSx).singularHomologyδ R n m hm ≫
    TopPair.singularHomologyMap (TopPair.ofSubsetPreimageValIso (X := TopCat.of X) hSx).inv R m

/-- When `(X, X ∖ S)` is acyclic, the connecting morphism of the triple `(X, X ∖ {x}, X ∖ S)` is an
isomorphism. -/
private lemma isIso_tripleδ {S : Set X} {x : X} (hSx : Sᶜ ⊆ {x}ᶜ)
    (hS : ∀ k, IsZero (localHomology R S k)) {n m : ℕ} (hm : m + 1 = n) :
    IsIso (tripleδ R hSx hm) := by
  rw [tripleδ]
  exact IsIso.comp_isIso' (TopTriple.isIso_singularHomologyδ_of_isZero
    (TopTriple.ofSubset (X := TopCat.of X) hSx) R n m (hS n) (hS m) hm)
    (TopPair.singularHomologyMapIso R
      (TopPair.ofSubsetPreimageValIso (X := TopCat.of X) hSx).symm m).isIso_hom

/-- **The boundary read at a point, against the triple of a segment.** Let `x` be a point of
`U ⊆ X`, `S` a set containing `x`, and `p` a point of `∂ = X ∖ U` such that `S` meets `∂` only at
`p`. Taking the boundary `Hₙ(X, ∂) ⟶ Hₘ(∂)` of a class, reading it in the local homology of `∂` at
`p` and then in the local homology of `X ∖ {x}` along `S`, is restricting the class to
`Hₙ(X, X ∖ {x})` and applying the connecting morphism of the triple `(X, X ∖ {x}, X ∖ S)`: both
are induced by the inclusion of `∂` into `X ∖ {x}`. -/
private lemma singularHomologyδ_comp_localHomologyMap_inclusion {U S : Set X} {x : X}
    (hxU : {x} ⊆ U) (hUx : Uᶜ ⊆ {x}ᶜ) (hSx : Sᶜ ⊆ {x}ᶜ) (p : (Uᶜ : Set X))
    (hsub : ContinuousMap.inclusion hUx ⁻¹' (Subtype.val ⁻¹' S) ⊆ {p})
    {n m : ℕ} (hm : m + 1 = n) :
    (TopPair.ofSubset (X := TopCat.of X) Uᶜ).singularHomologyδ R n m hm ≫
      ((TopPair.ofSubset (X := TopCat.of ↥(Uᶜ : Set X)) univᶜ).singularHomologyπ R m ≫
        localHomologyRestriction R (subset_univ {p}) m ≫
          localHomologyMap R (ContinuousMap.inclusion hUx) hsub m :
        (TopPair.toSSetPair.obj (TopPair.ofSubset (X := TopCat.of ↥(Uᶜ : Set X))
          univᶜ)).right.homology R m ⟶
            localHomology R (Subtype.val ⁻¹' S : Set ↥({x}ᶜ : Set X)) m) =
      localHomologyRestriction R (S := {x}) (T := U) hxU n ≫ tripleδ R hSx hm := by
  have hφ : TopPair.Hom.snd (TopPair.ofSubsetMap (𝟙 (TopCat.of X)) (compl_subset_compl.2 hxU)) =
      TopCat.ofHom (ContinuousMap.inclusion hUx) := by
    ext z
    exact Subtype.ext (TopPair.ofSubsetMap_snd_apply _ _ z)
  have hN := TopPair.singularHomologyδ_naturality R
    (TopPair.ofSubsetMap (𝟙 (TopCat.of X)) (compl_subset_compl.2 hxU)) n m hm
  rw [hφ] at hN
  -- The inner pair `(X ∖ {x}, X ∖ S)` of the triple is the pair of `X ∖ {x}` and the preimage of
  -- `X ∖ S`, through the identity of `X ∖ {x}`.
  have hE : (TopPair.ofInclusion (X := TopCat.of X) hSx).singularHomologyπ R m ≫
      TopPair.singularHomologyMap (TopPair.ofSubsetPreimageValIso (X := TopCat.of X) hSx).inv R m =
      (TopPair.ofSubset (X := TopCat.of ↥({x}ᶜ : Set X)) (Subtype.val ⁻¹' Sᶜ)).singularHomologyπ
        R m := by
    rw [← TopPair.singularHomologyπ_naturality, TopPair.ofSubsetPreimageValIso_inv_fst]
    exact (congrArg (· ≫ _) ((congrArg (SSet.homologyMap · R m) (TopCat.toSSet.map_id _)).trans
      (SSet.homologyMap_id _ R m))).trans (Category.id_comp _)
  rw [localHomologyRestriction_comp_localHomologyMap, localHomologyMap_def,
    ← TopPair.singularHomologyπ_naturality, TopPair.ofSubsetMap_fst]
  refine ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) hN)).trans ?_
  rw [tripleδ, TopTriple.singularHomologyδ_eq_comp_singularHomologyπ _ R n m hm,
    localHomologyRestriction_def]
  exact (Category.assoc _ _ _).trans (congrArg (_ ≫ ·)
    ((congrArg (_ ≫ ·) hE.symm).trans (Category.assoc _ _ _).symm))

end Square

namespace HomologicalOrientation

variable {X M : Type} {N : Type*} [TopologicalSpace X] [TopologicalSpace N] {ι : M → X}
  {f : N → X} [TopologicalSpace M] [T2Space X] [CompactSpace X] [T2Space M] {E : Type}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M] {n : ℕ}
  (o : HomologicalOrientation M E n) (hn : Module.finrank ℝ E = n) (hι : IsOpenEmbedding ι)
  (hιf : range ι = (range f)ᶜ) (hf : IsCollared f)

/-- **The boundary of the relative fundamental class is a fundamental class of the boundary.**
Let `X` be a compact Hausdorff space containing an oriented `n`-manifold `M` as an open subset
whose complement `∂X` is collared. The connecting morphism `Hₙ(X, ∂X; ℤ) ⟶ Hₘ(∂X; ℤ)`,
`m + 1 = n`, sends the relative fundamental class `[X, ∂X]` to a fundamental class of `∂X`: at
every point of `∂X`, its image generates the local homology `Hₘ(∂X, ∂X ∖ {p}; ℤ)`. -/
theorem isFundamentalClass_singularHomologyδ_fundamentalClassRel {m : ℕ} (hm : m + 1 = n) :
    IsFundamentalClass
      ((TopPair.ofSubset ((range ι)ᶜ : Set (TopCat.of X))).singularHomologyδ
        (ModuleCat.of ℤ (ULift.{0} ℤ)) n m hm (o.fundamentalClassRel hn hι hιf hf)) := by
  -- Fix a boundary point `f y` and the interior point `ι x = c (y, 1 / 2)` of the collar over
  -- it. The image of `[X, ∂X]` in the local homology of `∂X` at `f y` is carried to the local
  -- orientation at `x` by the isomorphisms of `isIso_localHomologyMap_inclusion`,
  -- `localHomologyIsoOfIsOpenEmbedding` and the connecting morphism of the triple
  -- `(X, X ∖ {ι x}, X ∖ S)` along the segment `S` from `f y` to `ι x`, whose total pair is acyclic.
  refine (isFundamentalClass_iff_forall_isLocalOrientation _).2 fun ⟨p, hp⟩ ↦ ?_
  obtain ⟨c, hc⟩ := isCollared_iff.1 hf
  have hB : range f = (range ι)ᶜ := by rw [hιf, compl_compl]
  obtain ⟨y, rfl⟩ : p ∈ range f := hB.symm.subset hp
  have hs0 : (0 : ℝ) < 1 / 2 := by norm_num
  have hs1 : (1 / 2 : ℝ) < 1 := by norm_num
  obtain ⟨x, hx⟩ : c (y, ⟨1 / 2, hs0.le, hs1⟩) ∈ range ι := by
    rw [hιf]
    rintro ⟨z, hz⟩
    have := congrArg (fun q : N × Ico (0 : ℝ) 1 ↦ (q.2 : ℝ))
      (hc.isOpenEmbedding.injective ((hc.apply_zero z).trans hz))
    norm_num at this
  set R := ModuleCat.of ℤ (ULift.{0} ℤ)
  have hxι : {ι x} ⊆ range ι := singleton_subset_iff.2 (mem_range_self x)
  have hBx : (range ι)ᶜ ⊆ {ι x}ᶜ := compl_subset_compl.2 hxι
  have hSx : (IsCollar.segment c y hs1)ᶜ ⊆ {ι x}ᶜ :=
    compl_subset_compl.2 (singleton_subset_iff.2 ⟨⟨1 / 2, hs0.le, le_rfl⟩, hx.symm⟩)
  let pt : ((range ι)ᶜ : Set X) := ⟨f y, hp⟩
  have hsub : ContinuousMap.inclusion hBx ⁻¹' (Subtype.val ⁻¹' IsCollar.segment c y hs1) ⊆
      {pt} := by
    rintro ⟨b, hb⟩ hbS
    obtain ⟨z, rfl⟩ : b ∈ range f := hB.symm.subset hb
    exact Subtype.ext (congrArg f (hc.eq_of_mem_segment hs1 hbS))
  -- `Φ`: the local homology of `∂X` at `pt` is that of `X ∖ {ι x}` along the segment.
  let Φ := localHomologyMap R (ContinuousMap.inclusion hBx) hsub m
  have : IsIso Φ := hc.isIso_localHomologyMap_inclusion R hB y hs0 hs1 hx.symm _ hp hsub m
  -- `Ψ`: the connecting morphism of the triple along the segment, whose total pair is acyclic.
  have : IsIso (tripleδ R hSx hm) :=
    isIso_tripleδ R hSx (hc.isZero_localHomology_segment R y hs0.le hs1) hm
  -- Conclude: name the boundary class with the type of the homology of the space `∂X`, and
  -- transport the local orientation at `x` along `Φ⁻¹ ∘ Ψ`, by the square of
  -- `singularHomologyδ_comp_localHomologyMap_inclusion`.
  obtain ⟨β, hβ⟩ : ∃ β : ((TopCat.toSSet.obj (TopCat.of ↥((range ι)ᶜ : Set X))).homology R m :
      ModuleCat.{0} ℤ),
      β = (TopPair.ofSubset (X := TopCat.of X) (range ι)ᶜ).singularHomologyδ R n m hm
        (o.fundamentalClassRel hn hι hιf hf) := ⟨_, rfl⟩
  rw [← hβ]
  have hz : singularHomologyToLocalHomology R pt m β =
      (localHomologyIsoOfIsOpenEmbedding R hι x n ≪≫ asIso (tripleδ R hSx hm) ≪≫
        (asIso Φ).symm).hom
        (o x).val := by
    refine ConcreteCategory.injective_of_mono_of_preservesPullback Φ ?_
    rw [Iso.trans_hom, Iso.trans_hom, Iso.symm_hom, asIso_inv, asIso_hom,
      ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, IsIso.inv_hom_id_apply,
      singularHomologyToLocalHomology_apply, hβ,
      ← o.localHomologyRestriction_fundamentalClassRel hn hι hιf hf x]
    exact ConcreteCategory.congr_hom (singularHomologyδ_comp_localHomologyMap_inclusion R hxι hBx
      hSx pt hsub hm) (o.fundamentalClassRel hn hι hιf hf)
  rw [hz]
  exact (o x).property.map _

end HomologicalOrientation

end TauCeti
