module

public import TauCeti.AlgebraicTopology.Singular.Kunneth.Basic
public import TauCeti.AlgebraicTopology.Singular.LocalHomology.IsFundamentalClass
public import TauCeti.AlgebraicTopology.Singular.LocalHomology.TopHomology
import TauCeti.Algebra.Homology.PrincipalIdealRing
import TauCeti.CategoryTheory.GradedObject.Monoidal

/-!
# The fundamental class of a product of manifolds

Let `M` and `N` be compact connected Hausdorff spaces modelled on real normed spaces `E` and `F` of
finite dimensions `m` and `n`, that is, closed connected topological manifolds, and let `k` be a
principal ideal domain, for instance `ℤ` or a field. If `μ ∈ Hₘ(M; R)` and `ν ∈ Hₙ(N; S)` are
fundamental classes (`TauCeti.IsFundamentalClass`), with coefficient modules `R` and `S` free of
rank one over `k`, then their homology cross product

`μ × ν ∈ Hₘ₊ₙ(M × N; R ⊗ S)`

is a fundamental class of the product manifold `M × N`, modelled on `E × F`
(`TauCeti.IsFundamentalClass.singularHomologyCross`). For `R = S = ℤ` this is the classical
statement that the cross product of the fundamental classes of two closed connected oriented
manifolds is a fundamental class of their product.

The proof uses no local computation in a product of charts. Fix a point `z = (x, y)` of `M × N`.

* Over a domain, a compact connected manifold whose top homology with coefficients free of rank
  one is nonzero has its top homology mapping isomorphically to the local homology at every point
  (`TauCeti.singularHomologyToLocalHomology_bijective_of_ne_zero`).
* So `Hₘ(M; R)` and `Hₙ(N; S)` are free of rank one, generated by `μ` and `ν`
  (`TauCeti.IsFundamentalClass.exists_linearEquiv_isUnit`), and `Hₘ(M; R) ⊗ Hₙ(N; S)` is free of
  rank one, generated by `μ ⊗ ν`.
* Over a principal ideal domain the Künneth map is a split monomorphism
  (`TopCat.isSplitMono_singularHomologyKunneth`), hence so is the cross product
  `Hₘ(M; R) ⊗ Hₙ(N; S) → Hₘ₊ₙ(M × N; R ⊗ S)` on this summand. In particular `μ × ν ≠ 0`, so the
  restriction `Hₘ₊ₙ(M × N; R ⊗ S) → Hₘ₊ₙ(M × N, M × N ∖ {z}; R ⊗ S)` is an isomorphism as well.
* The composite `Hₘ(M; R) ⊗ Hₙ(N; S) → Hₘ₊ₙ(M × N, M × N ∖ {z}; R ⊗ S)` is then a split
  monomorphism between modules free of rank one, hence it carries the generator `μ ⊗ ν` to a
  generator of the local homology at `z` (`LinearMap.span_singleton_apply_eq_top_of_leftInverse`).

## Main results

* `TauCeti.IsFundamentalClass.singularHomologyCross`: the cross product of fundamental classes of
  closed connected manifolds is a fundamental class of their product.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 3.3 (Lemma 3.27 and Theorem 3.26) and Section 3.B (the Künneth formula).
* J.-F. Barraud, M. Damian, V. Humilière, A. Oancea, *Floer homology with DG coefficients.
  Applications to cotangent bundles*, arXiv:2404.07953, Proposition 6.13, where the cross product of
  fundamental classes is the fundamental class of a product of manifolds abundant with 2-spheres.
-/

public section

noncomputable section

open CategoryTheory Limits Module Set MonoidalCategory

universe w

namespace TauCeti

section Cross

variable {k : Type w} [CommRing k] [IsDomain k] [IsPrincipalIdealRing k]
  {R S : ModuleCat.{w} k} (eR : R ≃ₗ[k] k) (eS : S ≃ₗ[k] k)
  {M N E F : Type w} [TopologicalSpace M] [T2Space M] [CompactSpace M] [ConnectedSpace M]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M]
  [TopologicalSpace N] [T2Space N] [CompactSpace N] [ConnectedSpace N]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ChartedSpace F N]
  {m n : ℕ}

include eR eS in
/-- **The cross product of fundamental classes is a fundamental class of the product.** Let `M`
and `N` be compact connected manifolds of dimensions `m` and `n`, modelled on `E` and `F`, and let
`R` and `S` be modules free of rank one over a principal ideal domain `k`. If `μ ∈ Hₘ(M; R)` and
`ν ∈ Hₙ(N; S)` are fundamental classes, then the cross product `μ × ν ∈ Hₘ₊ₙ(M × N; R ⊗ S)` is a
fundamental class of the product manifold `M × N`, modelled on `E × F`. With `R = S = ℤ`, the cross
product of the fundamental classes of two closed connected oriented manifolds is a fundamental class
of their product. -/
theorem IsFundamentalClass.singularHomologyCross
    (hm : finrank ℝ E = m) (hn : finrank ℝ F = n)
    {μ : ((TopCat.toSSet.obj (TopCat.of M)).homology R m : ModuleCat.{w} k)}
    {ν : ((TopCat.toSSet.obj (TopCat.of N)).homology S n : ModuleCat.{w} k)}
    (hμ : IsFundamentalClass μ) (hν : IsFundamentalClass ν) :
    IsFundamentalClass (M := M × N)
      ((TopCat.singularHomologyCross (TopCat.of M) (TopCat.of N) R S m n (m + n) rfl).hom
        (μ ⊗ₜ ν)) := by
  refine (isFundamentalClass_iff _).2 fun z ↦ ?_
  -- The product manifold, modelled on `E × F`.
  let : ChartedSpace (E × F) (M × N) := prodChartedSpace E M F N
  have hmn : finrank ℝ (E × F) = m + n := by rw [Module.finrank_prod, hm, hn]
  -- The two top homology modules are free of rank one, generated by `μ` and `ν`.
  obtain ⟨eHM, huM⟩ := hμ.exists_linearEquiv_isUnit hm eR
  obtain ⟨eHN, huN⟩ := hν.exists_linearEquiv_isUnit hn eS
  let eT := (TensorProduct.congr eHM eHN).trans (TensorProduct.lid k k)
  have heT : IsUnit (eT (μ ⊗ₜ ν)) := by
    simpa [eT] using huM.mul huN
  -- The cross product is a split monomorphism on the summand of degree `(m, n)` of the Künneth map.
  have : Module.Projective k R := .of_equiv eR.symm
  have : Module.Projective k S := .of_equiv eS.symm
  have := TopCat.isSplitMono_singularHomologyKunneth (TopCat.of M) (TopCat.of N) R S (m + n)
  have hsplit : IsSplitMono
      (TopCat.singularHomologyCross (TopCat.of M) (TopCat.of N) R S m n (m + n) rfl) := by
    rw [← TopCat.ι_singularHomologyKunneth]
    infer_instance
  set c := TopCat.singularHomologyCross (TopCat.of M) (TopCat.of N) R S m n (m + n) rfl
  have hcinj : Function.Injective c.hom :=
    (ModuleCat.mono_iff_injective c).1 inferInstance
  -- So `μ × ν ≠ 0`, and the restriction to the local homology at `z` is bijective.
  have eRS : (R ⊗ S : ModuleCat.{w} k) ≃ₗ[k] k :=
    (TensorProduct.congr eR eS).trans (TensorProduct.lid k k)
  have hc0 : c.hom (μ ⊗ₜ ν) ≠ 0 := by
    intro h
    have h0 : μ ⊗ₜ ν = 0 := hcinj (h.trans (map_zero c.hom).symm)
    exact heT.ne_zero ((congrArg eT h0).trans (map_zero eT))
  have hbij := singularHomologyToLocalHomology_bijective_of_ne_zero (M := M × N) (R ⊗ S) eRS
    hmn z hc0
  -- The composite of the cross product and the restriction is split, hence surjective. The
  -- restriction `φ` is stated with its source written as the target of `c`.
  let φ : (((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{w} k) (m + n)).obj
      (R ⊗ S)).obj (TopCat.of M ⊗ TopCat.of N) : ModuleCat.{w} k) ≃ₗ[k]
      (localHomology (R ⊗ S) ({z} : Set (M × N)) (m + n) : ModuleCat.{w} k) :=
    LinearEquiv.ofBijective (singularHomologyToLocalHomology (R ⊗ S) z (m + n)) hbij
  let f := φ.toLinearMap ∘ₗ c.hom
  let g := (retraction c).hom ∘ₗ φ.symm.toLinearMap
  have hgf : Function.LeftInverse g f := fun a ↦ by
    simp only [f, g, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
    rw [← ModuleCat.comp_apply, IsSplitMono.id, ModuleCat.id_apply]
  exact f.span_singleton_apply_eq_top_of_leftInverse eT
    (localHomologySingletonLinearEquiv (R ⊗ S) hmn eRS z) hgf
    (eT.span_singleton_eq_top_iff_isUnit.2 heT)

end Cross

end TauCeti
