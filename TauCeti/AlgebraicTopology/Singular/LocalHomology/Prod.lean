import TauCeti.CategoryTheory.GradedObject.Monoidal

/-!
# The fundamental class of a product of manifolds

Let `M` and `N` be compact connected Hausdorff spaces modelled on real normed spaces `E` and `F` of
finite dimensions `m` and `n`, that is, closed connected topological manifolds, and let `k` be a
principal ideal domain, for instance `ℤ` or a field. If `μ ∈ Hₘ(M; R)` and `ν ∈ Hₙ(N; S)` are
fundamental classes (`TauCeti.IsFundamentalClass`), with coefficient modules `R` and `S` free of
rank one over `k`, then their homology cross product

`μ × ν ∈ Hₘ₊ₙ(M × N; R ⊗ S)`

is a fundamental class of the product manifold `M × N`, modelled on `E × F`
(`TauCeti.IsFundamentalClass.singularHomologyCross`). For `R = S = ℤ` this is the classical
statement that the cross product of the fundamental classes of two closed connected oriented
manifolds is a fundamental class of their product.

The proof uses no local computation in a product of charts. Fix a point `z = (x, y)` of `M × N`.

* Over a domain, a compact connected manifold whose top homology with coefficients free of rank
  one is nonzero has its top homology mapping isomorphically to the local homology at every point
  (`TauCeti.surjective_singularHomologyToLocalHomology_of_ne_zero`): the image is the set of local
  classes fixed by transport along loops (`TauCeti.mem_range_localHomologySystemCone_π_app_iff`),
  and a linear automorphism of a module free of rank one over a domain which fixes a nonzero
  element is the identity (`LinearMap.eq_id_of_apply_eq_self`).
* So the restrictions `Hₘ(M; R) → Hₘ(M, M ∖ {x}; R)` and `Hₙ(N; S) → Hₙ(N, N ∖ {y}; S)` are
  isomorphisms, and `Hₘ(M; R) ⊗ Hₙ(N; S)` is free of rank one, generated by `μ ⊗ ν`.
* Over a principal ideal domain the Künneth map is a split monomorphism
  (`TopCat.isSplitMono_singularHomologyKunneth`), hence so is the cross product
  `Hₘ(M; R) ⊗ Hₙ(N; S) → Hₘ₊ₙ(M × N; R ⊗ S)` on this summand. In particular `μ × ν ≠ 0`, so the
  restriction `Hₘ₊ₙ(M × N; R ⊗ S) → Hₘ₊ₙ(M × N, M × N ∖ {z}; R ⊗ S)` is an isomorphism as well.
* The composite `Hₘ(M; R) ⊗ Hₙ(N; S) → Hₘ₊ₙ(M × N, M × N ∖ {z}; R ⊗ S)` is then a split
  monomorphism between modules free of rank one, hence it carries the generator `μ ⊗ ν` to a
  generator of the local homology at `z` (`LinearMap.span_singleton_apply_eq_top_of_leftInverse`).

## Main results

* `TauCeti.surjective_singularHomologyToLocalHomology_of_ne_zero`: over a domain, with
  coefficients free of rank one, the top homology of a compact connected manifold maps onto the
  local homology at each point as soon as it is nonzero, and
  `TauCeti.bijective_singularHomologyToLocalHomology_of_ne_zero`: the restriction is then
  bijective.
* `TauCeti.IsFundamentalClass.singularHomologyCross`: the cross product of fundamental classes of
  closed connected manifolds is a fundamental class of their product.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 3.3 (Lemma 3.27 and Theorem 3.26) and Section 3.B (the Künneth formula).
* J.-F. Barraud, M. Damian, V. Humilière, A. Oancea, *Floer homology with DG coefficients.
  Applications to cotangent bundles*, arXiv:2404.07953, Proposition 6.13, where the cross product of
  fundamental classes is the fundamental class of a product of manifolds abundant with 2-spheres.
-/

public section

noncomputable section

open CategoryTheory Limits Module Set MonoidalCategory

universe w

namespace TauCeti

section Surjective

variable {Λ : Type w} [CommRing Λ] [IsDomain Λ] (N : ModuleCat.{w} Λ) (eN : N ≃ₗ[Λ] Λ)
  {M E : Type w} [TopologicalSpace M] [T2Space M] [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [ChartedSpace E M]

include eN in
/-- **Nonzero top homology maps onto local homology.** Let `M` be a compact connected manifold of
dimension `n`, and `N` a module free of rank one over a domain `Λ`. If `Hₙ(M; N)` is nonzero, then
the restriction `Hₙ(M; N) → Hₙ(M, M ∖ {x}; N)` to the local homology at any point `x` is surjective,
hence an isomorphism (`TauCeti.singularHomologyToLocalHomology_injective`). Indeed its image is the
set of local classes fixed by transport along loops at `x`, and transport along a loop acts on the
local homology, a module free of rank one, by an automorphism, which fixes the nonzero image of a
nonzero class and is therefore the identity. In other words, `M` is `N`-orientable. -/
theorem surjective_singularHomologyToLocalHomology_of_ne_zero [CompactSpace M] [ConnectedSpace M]
    {n : ℕ} (hn : finrank ℝ E = n) (x : M)
    {μ : ((TopCat.toSSet.obj (TopCat.of M)).homology N n : ModuleCat.{w} Λ)} (hμ : μ ≠ 0) :
    Function.Surjective (singularHomologyToLocalHomology N x n) := by
  have : IsEmpty (TopPair.ofSubset ((univ : Set (TopCat.of M))ᶜ)).snd := by
    simp only [compl_univ]
    exact inferInstanceAs (IsEmpty (∅ : Set M))
  have hπ : IsIso ((TopPair.ofSubset ((univ : Set (TopCat.of M))ᶜ)).singularHomologyπ
      (C := ModuleCat.{w} Λ) N n) := inferInstance
  -- The local homology at `x` is free of rank one.
  obtain ⟨eL⟩ : Nonempty ((localHomology N ({x} : Set M) n : ModuleCat.{w} Λ) ≃ₗ[Λ] Λ) := by
    subst hn
    exact ⟨(singularHomologyComplSingletonFinrankIso N (chartAt E x)
      (mem_chart_source E x)).toLinearEquiv.trans eN⟩
  -- The image of `μ` is a nonzero local class fixed by transport along every loop.
  have hμx : singularHomologyToLocalHomology N x n μ ≠ 0 := by
    rw [← map_zero (singularHomologyToLocalHomology N x n)]
    exact (singularHomologyToLocalHomology_injective N hn x).ne hμ
  have hfix (g : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk x) :
      localHomologyTransport N M E n g (singularHomologyToLocalHomology N x n μ) =
        singularHomologyToLocalHomology N x n μ :=
    (mem_range_localHomologySystemCone_π_app_iff N hn (FundamentalGroupoid.mk x) _).1
      ⟨_, by rw [localHomologySystemCone_π_app, singularHomologyToLocalHomology_apply]; rfl⟩ g
  -- Hence every local class is fixed by transport along loops, and comes from a global class.
  intro z
  obtain ⟨γ, hγ⟩ := (mem_range_localHomologySystemCone_π_app_iff N hn
    (FundamentalGroupoid.mk x) z).2 fun g ↦
      LinearMap.congr_fun
        (LinearMap.eq_id_of_apply_eq_self (localHomologyTransport N M E n g).hom eL hμx (hfix g)) z
  obtain ⟨γ', rfl⟩ := ((ConcreteCategory.isIso_iff_bijective _).1 hπ).2 γ
  exact ⟨γ', by
    rw [← hγ, localHomologySystemCone_π_app]
    exact singularHomologyToLocalHomology_apply N x γ'⟩

include eN in
/-- **Nonzero top homology is local homology.** For a compact connected manifold `M` of dimension
`n` and a module `N` free of rank one over a domain, if `Hₙ(M; N)` is nonzero then the restriction
`Hₙ(M; N) → Hₙ(M, M ∖ {x}; N)` is bijective at every point `x`. -/
theorem bijective_singularHomologyToLocalHomology_of_ne_zero [CompactSpace M] [ConnectedSpace M]
    {n : ℕ} (hn : finrank ℝ E = n) (x : M)
    {μ : ((TopCat.toSSet.obj (TopCat.of M)).homology N n : ModuleCat.{w} Λ)} (hμ : μ ≠ 0) :
    Function.Bijective (singularHomologyToLocalHomology N x n) :=
  ⟨singularHomologyToLocalHomology_injective N hn x,
    surjective_singularHomologyToLocalHomology_of_ne_zero N eN hn x hμ⟩

end Surjective

section Cross

variable {k : Type w} [CommRing k] [IsDomain k] [IsPrincipalIdealRing k]
  {R S : ModuleCat.{w} k} (eR : R ≃ₗ[k] k) (eS : S ≃ₗ[k] k)
  {M N E F : Type w} [TopologicalSpace M] [T2Space M] [CompactSpace M] [ConnectedSpace M]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E M]
  [TopologicalSpace N] [T2Space N] [CompactSpace N] [ConnectedSpace N]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ChartedSpace F N]
  {m n : ℕ}

omit [IsPrincipalIdealRing k] in
include eR in
/-- On a compact connected manifold of dimension `m`, with coefficients free of rank one over a
domain, the top homology of a manifold carrying a fundamental class is free of rank one, through
the restriction to the local homology at a point. -/
private theorem nonempty_linearEquiv_of_isFundamentalClass (hm : finrank ℝ E = m) (x : M)
    {μ : ((TopCat.toSSet.obj (TopCat.of M)).homology R m : ModuleCat.{w} k)}
    (hμ : IsFundamentalClass μ) :
    ∃ e : ((TopCat.toSSet.obj (TopCat.of M)).homology R m : ModuleCat.{w} k) ≃ₗ[k] k,
      IsUnit (e μ) := by
  have : Nonempty M := ⟨x⟩
  have : Nontrivial R := eR.toEquiv.nontrivial
  have hμ0 : μ ≠ 0 := by
    rintro rfl
    exact not_isFundamentalClass_zero hm R hμ
  obtain ⟨eL⟩ : Nonempty ((localHomology R ({x} : Set M) m : ModuleCat.{w} k) ≃ₗ[k] k) := by
    subst hm
    exact ⟨(singularHomologyComplSingletonFinrankIso R (chartAt E x)
      (mem_chart_source E x)).toLinearEquiv.trans eR⟩
  let e := (LinearEquiv.ofBijective _
    (bijective_singularHomologyToLocalHomology_of_ne_zero R eR hm x hμ0)).trans eL
  refine ⟨e, ?_⟩
  -- The image of `μ` generates the local homology, so its coordinate generates `k`.
  have hspan := congrArg (Submodule.map eL.toLinearMap) ((isFundamentalClass_iff μ).1 hμ x)
  rw [Submodule.map_span, Set.image_singleton, Submodule.map_top, LinearEquiv.range] at hspan
  exact (Ideal.span_singleton_eq_top).1 hspan

include eR eS in
/-- **The cross product of fundamental classes is a fundamental class of the product.** Let `M`
and `N` be compact connected manifolds of dimensions `m` and `n`, modelled on `E` and `F`, and let
`R` and `S` be modules free of rank one over a principal ideal domain `k`. If `μ ∈ Hₘ(M; R)` and
`ν ∈ Hₙ(N; S)` are fundamental classes, then the cross product `μ × ν ∈ Hₘ₊ₙ(M × N; R ⊗ S)` is a
fundamental class of the product manifold `M × N`, modelled on `E × F`. With `R = S = ℤ`, the cross
product of the fundamental classes of two closed connected oriented manifolds is a fundamental class
of their product. -/
theorem IsFundamentalClass.singularHomologyCross
    (hm : finrank ℝ E = m) (hn : finrank ℝ F = n)
    {μ : ((TopCat.toSSet.obj (TopCat.of M)).homology R m : ModuleCat.{w} k)}
    {ν : ((TopCat.toSSet.obj (TopCat.of N)).homology S n : ModuleCat.{w} k)}
    (hμ : IsFundamentalClass μ) (hν : IsFundamentalClass ν) :
    IsFundamentalClass (M := M × N)
      ((TopCat.singularHomologyCross (TopCat.of M) (TopCat.of N) R S m n (m + n) rfl).hom
        (μ ⊗ₜ ν)) := by
  refine (isFundamentalClass_iff _).2 fun z ↦ ?_
  -- The product manifold, modelled on `E × F`.
  let : ChartedSpace (E × F) (M × N) := prodChartedSpace E M F N
  have hmn : finrank ℝ (E × F) = m + n := by rw [Module.finrank_prod, hm, hn]
  -- The two top homology modules are free of rank one, generated by `μ` and `ν`.
  obtain ⟨eHM, huM⟩ := nonempty_linearEquiv_of_isFundamentalClass eR hm z.1 hμ
  obtain ⟨eHN, huN⟩ := nonempty_linearEquiv_of_isFundamentalClass eS hn z.2 hν
  let eT := (TensorProduct.congr eHM eHN).trans (TensorProduct.lid k k)
  have heT : IsUnit (eT (μ ⊗ₜ ν)) := by
    simpa [eT] using huM.mul huN
  -- The cross product is a split monomorphism on the summand of degree `(m, n)` of the Künneth map.
  have : Module.Projective k R := .of_equiv eR.symm
  have : Module.Projective k S := .of_equiv eS.symm
  have := TopCat.isSplitMono_singularHomologyKunneth (TopCat.of M) (TopCat.of N) R S (m + n)
  have hsplit : IsSplitMono
      (TopCat.singularHomologyCross (TopCat.of M) (TopCat.of N) R S m n (m + n) rfl) := by
    rw [← TopCat.ι_singularHomologyKunneth]
    infer_instance
  set c := TopCat.singularHomologyCross (TopCat.of M) (TopCat.of N) R S m n (m + n) rfl
  have hcinj : Function.Injective c.hom :=
    (ModuleCat.mono_iff_injective c).1 inferInstance
  -- So `μ × ν ≠ 0`, and the restriction to the local homology at `z` is bijective.
  have eRS : (R ⊗ S : ModuleCat.{w} k) ≃ₗ[k] k :=
    (TensorProduct.congr eR eS).trans (TensorProduct.lid k k)
  have hc0 : c.hom (μ ⊗ₜ ν) ≠ 0 := by
    intro h
    have h0 : μ ⊗ₜ ν = 0 := hcinj (h.trans (map_zero c.hom).symm)
    exact heT.ne_zero ((congrArg eT h0).trans (map_zero eT))
  have hbij := bijective_singularHomologyToLocalHomology_of_ne_zero (M := M × N) (R ⊗ S) eRS
    hmn z hc0
  obtain ⟨eL⟩ : Nonempty ((localHomology (R ⊗ S) ({z} : Set (M × N)) (m + n) :
      ModuleCat.{w} k) ≃ₗ[k] k) := by
    rw [← hmn]
    exact ⟨(singularHomologyComplSingletonFinrankIso (R ⊗ S) (chartAt (E × F) z)
      (mem_chart_source (E × F) z)).toLinearEquiv.trans eRS⟩
  -- The composite of the cross product and the restriction is split, hence surjective.
  let φ := LinearEquiv.ofBijective _ hbij
  let f := (singularHomologyToLocalHomology (R ⊗ S) z (m + n)) ∘ₗ c.hom
  let g := (retraction c).hom ∘ₗ φ.symm.toLinearMap
  have hgf : Function.LeftInverse g f := fun a ↦ by
    -- `f a` is `φ (c a)` by definition of `φ`, which `φ.symm` undoes.
    have h : φ.symm (f a) = c.hom a := φ.symm_apply_apply (c.hom a)
    change (retraction c).hom (φ.symm (f a)) = a
    rw [h, ← ModuleCat.comp_apply, IsSplitMono.id, ModuleCat.id_apply]
  exact f.span_singleton_apply_eq_top_of_leftInverse eT eL hgf
    (eT.span_singleton_eq_top_iff_isUnit.2 heT)

end Cross

end TauCeti
