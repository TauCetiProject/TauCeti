/-!
# The second cohomology of a surface mapping torus

Let `F` be a closed connected oriented surface, `φ : F ≃ₜ F` an orientation-preserving
homeomorphism with `det (1 - φ_*) ≠ 0` on `H₁(F; ℤ)`, so that the mapping torus `Y_φ` has
`b₁(Y_φ) = 1`, and let `i : F → Y_φ` be the inclusion of the fibre. This file shows that
`H²(Y_φ; ℤ)` is infinite cyclic modulo its torsion, detected by evaluation on the fibre class
`i_*[F]`, and it keeps the torsion rather than passing to rational coefficients.

By the universal coefficient theorem, a class of `H²(Y_φ; ℤ)` that pairs to zero with
`H₂(Y_φ; ℤ)` comes from `Ext¹(H₁(Y_φ; ℤ), ℤ)`. The torsion of `H₁(Y_φ; ℤ)` has order
`r = |det (1 - φ_*)|` (`TauCeti.MappingTorus.card_torsion_homology_one_eq_natAbs_det`), and
`H₁(Y_φ; ℤ)` modulo torsion is `H₀(F; ℤ) ≅ ℤ` through the Wang connecting morphism
(`TauCeti.MappingTorus.ker_wangδ_zero_eq_torsion`). So multiplication by `r` on `H₁(Y_φ; ℤ)`
factors through `ℤ`, and `r` annihilates that `Ext¹` group
(`TauCeti.ChainComplex.smul_eq_zero_of_kronecker_eq_zero`). Since `H₂(Y_φ; ℤ)` is generated by the
fibre class (`TauCeti.MappingTorus.fibreClassEquiv`), a class pairing to zero with `i_*[F]` has
finite order. Consequently a class `v ∈ H²(Y_φ; ℤ)` with `⟨v, i_*[F]⟩ = 1`, which exists by
`TauCeti.MappingTorus.surjective_evalFundamentalClass_incl`, generates `H²(Y_φ; ℤ)` modulo torsion:
every class `w` differs from `⟨w, i_*[F]⟩ • v` by an element of finite order.

This is the class `v` in which the line labels of the symplectic suspension `S¹ × Y_φ` are
written, in `TauCeti.Geometry.Symplectic.Manifold.Suspension.Chamber`, together with the class of
`ds ∧ dt`. The fibre class is built from singular chains with coefficients in `ULift ℤ`; the
homology of the mapping torus with coefficients in `ℤ` enters through the coefficient
isomorphism `TauCeti.uliftIntHomologyIso`.

## Main results

* `TauCeti.MappingTorus.isOfFinAddOrder_sub_evalFundamentalClass_smul`: if `⟨v, i_*[F]⟩ = 1`, every
  `w ∈ H²(Y_φ; ℤ)` differs from `⟨w, i_*[F]⟩ • v` by an element of finite order.
* `TauCeti.MappingTorus.isOfFinAddOrder_iff_evalFundamentalClass_eq_zero`: a class of
  `H²(Y_φ; ℤ)` has finite order exactly when it pairs to zero with the fibre class.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 2.2, Example 2.48 (the Wang sequence of a mapping torus), and Section 3.1, Theorem 3.2
  (the universal coefficient theorem).
* C. H. Taubes, *The Seiberg–Witten and Gromov invariants*, Math. Res. Lett. 2 (1995), 221–238.
-/

public section

noncomputable section

open CategoryTheory AlgebraicTopology HomologicalComplex Module

namespace TauCeti.MappingTorus

variable {F : Type} [TopologicalSpace F] (φ : F ≃ₜ F)

variable [Module.Free ℤ ((((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj
    (ModuleCat.of ℤ ℤ)).obj (TopCat.of F)).homology 1)]
  [Module.Finite ℤ ((((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj
    (ModuleCat.of ℤ ℤ)).obj (TopCat.of F)).homology 1)]

/-- Multiplication by `|det (1 - φ_*)|` on `H₁(Y_φ; ULift ℤ)` factors through `ℤ`: the torsion has
that order, and `H₁(Y_φ; ℤ)` modulo torsion is `H₀(F; ℤ) ≅ ℤ` through the Wang connecting
morphism. -/
private theorem exists_comp_eq_natAbs_det_smul_id [PathConnectedSpace F]
    (hdet : (LinearMap.id -
      (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ ℤ)) 1).hom).det ≠ 0) :
    ∃ (f : (TopCat.toSSet.obj (TopCat.of (MappingTorus φ))).homology
        (ModuleCat.of ℤ (ULift.{0} ℤ)) 1 ⟶ ModuleCat.of ℤ ℤ)
      (g : ModuleCat.of ℤ ℤ ⟶ (TopCat.toSSet.obj (TopCat.of (MappingTorus φ))).homology
        (ModuleCat.of ℤ (ULift.{0} ℤ)) 1),
      f ≫ g = ((LinearMap.id -
        (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ ℤ)) 1).hom).det.natAbs : ℤ) • 𝟙 _ := by
  set r := (LinearMap.id - (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ ℤ)) 1).hom).det.natAbs
  -- `ψ = ε ∘ δ` maps `H₁(Y_φ; ℤ)` onto `ℤ` with kernel the torsion, which `r` annihilates, so
  -- `r • 𝟙` factors through `ψ`.
  let ψ : (((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj (ModuleCat.of ℤ ℤ)).obj
      (TopCat.of (MappingTorus φ))).homology 1 →ₗ[ℤ] ℤ :=
    ((TopCat.of F).singularHomology₀ε (ModuleCat.of ℤ ℤ)).hom ∘ₗ (wangδ φ (ModuleCat.of ℤ ℤ) 0).hom
  let ε := (asIso ((TopCat.of F).singularHomology₀ε (ModuleCat.of ℤ ℤ))).toLinearEquiv
  have hψ : Function.Surjective ψ :=
    ε.surjective.comp ((ModuleCat.epi_iff_surjective _).1 inferInstance)
  have hker : LinearMap.ker ψ = Submodule.torsion ℤ _ := by
    rw [← ker_wangδ_zero_eq_torsion φ hdet]
    exact LinearMap.ker_comp_of_ker_eq_bot _ (LinearMap.ker_eq_bot.2 ε.injective)
  have hr : Nat.card (Submodule.torsion ℤ ((((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj
      (ModuleCat.of ℤ ℤ)).obj (TopCat.of (MappingTorus φ))).homology 1)) = r :=
    card_torsion_homology_one_eq_natAbs_det φ hdet
  obtain ⟨a₀, ha₀⟩ := hψ 1
  have hψr := Module.Dual.smulRight_smul_eq_smul_id ψ ha₀ (r := (r : ℤ)) fun y hy ↦ by
    rw [hker] at hy
    rw [Nat.cast_smul_eq_nsmul ℤ, ← hr]
    exact congrArg Subtype.val (card_nsmul_eq_zero' (x := (⟨y, hy⟩ : Submodule.torsion ℤ _)))
  -- Read `H₁(Y_φ; ULift ℤ)` as `H₁(Y_φ; ℤ)` through the coefficient isomorphism, which is stated
  -- for `SSet.homology`: this is by definition the homology of `singularChainComplexFunctor`.
  let e : (TopCat.toSSet.obj (TopCat.of (MappingTorus φ))).homology
      (ModuleCat.of ℤ (ULift.{0} ℤ)) 1 ≅ (((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj
        (ModuleCat.of ℤ ℤ)).obj (TopCat.of (MappingTorus φ))).homology 1 :=
    uliftIntHomologyIso (TopCat.of (MappingTorus φ)) 1
  refine ⟨ConcreteCategory.ofHom (((r : ℤ) • ψ) ∘ₗ e.hom.hom),
    ConcreteCategory.ofHom (e.inv.hom ∘ₗ LinearMap.toSpanSingleton ℤ _ a₀),
    ModuleCat.hom_ext (LinearMap.ext fun x ↦ ?_)⟩
  simp only [ModuleCat.hom_comp, ConcreteCategory.hom_ofHom, LinearMap.coe_comp,
    Function.comp_apply, LinearMap.toSpanSingleton_apply]
  have h := DFunLike.congr_fun hψr (e.hom.hom x)
  simp only [LinearMap.smulRight_apply, LinearMap.smul_apply, LinearMap.id_apply] at h
  rw [LinearMap.smul_apply, h, LinearMap.map_smul, Iso.hom_inv_id_apply]
  simpa using Nat.cast_smul_eq_nsmul ℤ r x

variable {E : Type} [T2Space F] [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [ChartedSpace E F] [CompactSpace F] [ConnectedSpace F]
  (o : HomologicalOrientation F E 2) (hn : finrank ℝ E = 2)

/-- **The second cohomology of a surface mapping torus modulo torsion.** Let `φ` be an
orientation-preserving homeomorphism of a closed connected oriented surface `F` with
`det (1 - φ_*) ≠ 0` on `H₁(F; ℤ)`, and let `v ∈ H²(Y_φ; ℤ)` pair to one with the fibre class
`i_*[F]`. Then every class `w ∈ H²(Y_φ; ℤ)` differs from `⟨w, i_*[F]⟩ • v` by an element of finite
order: `v` generates `H²(Y_φ; ℤ)` modulo torsion. -/
theorem isOfFinAddOrder_sub_evalFundamentalClass_smul
    (hφ : o.mapFundamentalClass hn ⟨φ, φ.continuous⟩ = o.fundamentalClass hn)
    (hdet : (LinearMap.id -
      (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ ℤ)) 1).hom).det ≠ 0)
    {v : (TopCat.of (MappingTorus φ)).singularCohomology (ModuleCat.of ℤ (ULift.{0} ℤ)) ℤ
      (ModuleCat.of ℤ ℤ) 2}
    (hv : o.evalFundamentalClass hn (ModuleCat.of ℤ ℤ) (incl φ) v = 1)
    (w : (TopCat.of (MappingTorus φ)).singularCohomology (ModuleCat.of ℤ (ULift.{0} ℤ)) ℤ
      (ModuleCat.of ℤ ℤ) 2) :
    IsOfFinAddOrder (w - o.evalFundamentalClass hn (ModuleCat.of ℤ ℤ) (incl φ) w • v) := by
  have := ChartedSpace.locallyPathConnectedSpace E F
  have : PathConnectedSpace F := pathConnectedSpace_iff_connectedSpace.2 inferInstance
  have hz := (singularKronecker_eq_zero_iff_evalFundamentalClass_eq_zero hφ
    (injective_id_sub_homologyMap_monodromyChainMap_ulift φ hdet) (ModuleCat.of ℤ ℤ)
    (w - o.evalFundamentalClass hn (ModuleCat.of ℤ ℤ) (incl φ) w • v)).2 (by simp [hv])
  obtain ⟨f, g, hfg⟩ := exists_comp_eq_natAbs_det_smul_id φ hdet
  have : Projective (ModuleCat.of ℤ ℤ) := (IsProjective.iff_projective ℤ).1 inferInstance
  rw [TopCat.singularKronecker_def] at hz
  -- `f`, `g` and `hz` are stated for `SSet.homology`, which is by definition the homology of the
  -- chain complex of `TopCat.toSSet.obj _` that `smul_eq_zero_of_kronecker_eq_zero` expects.
  have hr := TauCeti.ChainComplex.smul_eq_zero_of_kronecker_eq_zero (i := 1 + 1) (j := 1) rfl f g
    hfg hz
  rw [Nat.cast_smul_eq_nsmul ℤ] at hr
  exact isOfFinAddOrder_iff_nsmul_eq_zero.2 ⟨_, Int.natAbs_pos.2 hdet, hr⟩

/-- **The torsion of `H²(Y_φ; ℤ)`** for a surface mapping torus with `det (1 - φ_*) ≠ 0`: a class
has finite order exactly when it pairs to zero with the fibre class `i_*[F]`. So evaluation on
the fibre class identifies `H²(Y_φ; ℤ)` modulo torsion with `ℤ`. -/
theorem isOfFinAddOrder_iff_evalFundamentalClass_eq_zero
    (hφ : o.mapFundamentalClass hn ⟨φ, φ.continuous⟩ = o.fundamentalClass hn)
    (hdet : (LinearMap.id -
      (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ ℤ)) 1).hom).det ≠ 0)
    (w : (TopCat.of (MappingTorus φ)).singularCohomology (ModuleCat.of ℤ (ULift.{0} ℤ)) ℤ
      (ModuleCat.of ℤ ℤ) 2) :
    IsOfFinAddOrder w ↔ o.evalFundamentalClass hn (ModuleCat.of ℤ ℤ) (incl φ) w = 0 := by
  refine ⟨fun hw ↦ ?_, fun hw ↦ ?_⟩
  · exact ((o.evalFundamentalClass hn (ModuleCat.of ℤ ℤ) (incl φ)).toAddMonoidHom.isOfFinAddOrder
      hw).eq_zero'
  · obtain ⟨v, hv⟩ := surjective_evalFundamentalClass_incl hφ
      (injective_id_sub_homologyMap_monodromyChainMap_ulift φ hdet) (ModuleCat.of ℤ ℤ) 1
    simpa [hw] using isOfFinAddOrder_sub_evalFundamentalClass_smul φ o hn hφ hdet hv w

end TauCeti.MappingTorus
