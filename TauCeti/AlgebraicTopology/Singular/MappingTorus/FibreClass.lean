import TauCeti.AlgebraicTopology.Cohomology.UniversalCoefficient

/-!
# The fibre class of a mapping torus

Let `F` be a compact connected oriented topological manifold of dimension `n + 1`, with fundamental
class `[F] ∈ Hₙ₊₁(F; ℤ)`, let `φ : F ≃ₜ F` be a homeomorphism preserving the orientation,
`φ_*[F] = [F]`, and let `i : F → T_φ` be the inclusion of the fibre into the mapping torus. The
Wang sequence

`Hₙ₊₁(F) ⟶ Hₙ₊₁(F) ⟶ Hₙ₊₁(T_φ) ⟶ Hₙ(F) ⟶ Hₙ(F)`,

with maps `𝟙 - φ_*`, `i_*`, the Wang connecting morphism and `𝟙 - φ_*`, computes the top
homology of `T_φ` when `𝟙 - φ_*` is injective on `Hₙ(F; ℤ)`: the connecting morphism then
vanishes, so `i_*` is onto, and it is injective because `φ_*` is the identity on `Hₙ₊₁(F; ℤ)`.
Hence `Hₙ₊₁(T_φ; ℤ)` is free of rank one on the **fibre class** `i_*[F]`
(`TauCeti.MappingTorus.fibreClassEquiv`).

For a closed oriented surface `F` and an orientation-preserving `φ`, the hypothesis concerns the
free group `H₁(F; ℤ)` of finite rank, on which `𝟙 - φ_*` is injective exactly when
`det (𝟙 - φ_*) ≠ 0`: the integral form of the criterion
`TauCeti.MappingTorus.finrank_homology_one_eq_one_iff` for `b₁(T_φ) = 1`. The fibre class is built
from chains with coefficients in `ULift ℤ`, and
`TauCeti.MappingTorus.injective_id_sub_homologyMap_monodromyChainMap_ulift` turns
`det (𝟙 - φ_*) ≠ 0` on `H₁(F; ℤ)` into the injectivity hypothesis used here. Then `H₂(T_φ; ℤ)` is
infinite cyclic, generated by the fibre class.

Dually, evaluation on the fibre class detects the Kronecker pairing on `Hⁿ⁺¹(T_φ; ℤ, M)` for every
abelian group `M`: a class `w` pairs to zero with all of `Hₙ₊₁(T_φ; ℤ)` exactly when
`⟨w, i_*[F]⟩ = 0`
(`TauCeti.MappingTorus.singularKronecker_eq_zero_iff_evalFundamentalClass_eq_zero`), and by the
universal coefficient theorem every `m ∈ M` is `⟨w, i_*[F]⟩` for some class `w`
(`TauCeti.MappingTorus.surjective_evalFundamentalClass_incl`). With `M = ℤ` this gives a class
`v ∈ Hⁿ⁺¹(T_φ; ℤ)` with `⟨v, i_*[F]⟩ = 1`, and every class `w` differs from `⟨w, i_*[F]⟩ • v` by a
class in the kernel of the Kronecker map, which is the image of `Ext¹(Hₙ(T_φ; ℤ), ℤ)`
(`TopCat.exact_singularExtToCohomology_singularKronecker`). For a surface mapping torus `Y_φ` with
`b₁(Y_φ) = 1` this `v` is the class with `⟨v, [F]⟩ = 1` in which, together with the class of
`ds ∧ dt`, the line labels of `S¹ × Y_φ` are written in
`TauCeti.Geometry.Symplectic.Manifold.Suspension.Chamber`.

## Main results

* `TauCeti.MappingTorus.homologyMap_monodromyChainMap_eq_id`: an orientation-preserving `φ` acts
  as the identity on `Hₙ₊₁(F; ℤ)`.
* `TauCeti.MappingTorus.epi_wangδ_of_mapFundamentalClass_eq`: the Wang connecting morphism is
  then onto `Hₙ₊₁(F; ℤ)`.
* `TauCeti.MappingTorus.injective_id_sub_homologyMap_monodromyChainMap_ulift`: if
  `det (𝟙 - φ_*) ≠ 0` on a free `H₁(F; ℤ)` of finite rank, then `𝟙 - φ_*` is injective on
  `H₁(F; ULift ℤ)`.
* `TauCeti.MappingTorus.fibreClassEquiv`: if `𝟙 - φ_*` is injective on `Hₙ(F; ℤ)`, then
  `c ↦ c • i_*[F]` is an isomorphism `ℤ ≃ₗ[ℤ] Hₙ₊₁(T_φ; ℤ)`.
* `TauCeti.MappingTorus.exists_eq_zsmul_mapFundamentalClass_incl`: every class of `Hₙ₊₁(T_φ; ℤ)` is
  an integer multiple of the fibre class.
* `TauCeti.MappingTorus.singularKronecker_eq_zero_iff_evalFundamentalClass_eq_zero` and
  `TauCeti.MappingTorus.surjective_evalFundamentalClass_incl`: the Kronecker pairing on
  `Hⁿ⁺¹(T_φ; ℤ, M)` is evaluation on the fibre class, and every value is attained.

## References

* A. Hatcher, *Algebraic Topology*, Section 2.2 (the Wang sequence of a mapping torus) and
  Section 3.1 (the universal coefficient theorem).
* C. H. Taubes, *The Seiberg–Witten and Gromov invariants*, Math. Res. Lett. 2 (1995), 221–238.
-/

public section

noncomputable section

open CategoryTheory AlgebraicTopology HomologicalComplex Module

namespace TauCeti.MappingTorus

section Determinant

variable {F : Type} [TopologicalSpace F] (φ : F ≃ₜ F)
  [Module.Free ℤ ((((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj
    (ModuleCat.of ℤ ℤ)).obj (TopCat.of F)).homology 1)]
  [Module.Finite ℤ ((((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj
    (ModuleCat.of ℤ ℤ)).obj (TopCat.of F)).homology 1)]

/-- If `det (𝟙 - φ_*) ≠ 0` on `H₁(F; ℤ)`, then `𝟙 - φ_*` is injective on the homology
`H₁(F; ULift ℤ)` used by the fibre class. -/
theorem injective_id_sub_homologyMap_monodromyChainMap_ulift
    (hdet : (LinearMap.id -
      (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ ℤ)) 1).hom).det ≠ 0) :
    Function.Injective (LinearMap.id -
      (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ (ULift.{0} ℤ))) 1).hom :
        _ →ₗ[ℤ] _) := by
  -- `uliftIntHomologyIso` is stated for `SSet.homology`, which is by definition the homology of
  -- `singularChainComplexFunctor`.
  let e : (((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj
      (ModuleCat.of ℤ (ULift.{0} ℤ))).obj (TopCat.of F)).homology 1 ≃ₗ[ℤ]
        (((singularChainComplexFunctor (ModuleCat.{0} ℤ)).obj (ModuleCat.of ℤ ℤ)).obj
          (TopCat.of F)).homology 1 :=
    (uliftIntHomologyIso (TopCat.of F) 1).toLinearEquiv
  -- `homologyMap (monodromyChainMap φ R) 1` is by definition `SSet.homologyMap` of `φ`, so the
  -- coefficient isomorphism intertwines the two actions of the monodromy.
  have hφ : ∀ z, e ((homologyMap (monodromyChainMap φ (ModuleCat.of ℤ (ULift.{0} ℤ))) 1).hom z) =
      (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ ℤ)) 1).hom (e z) := fun z ↦ by
    have h := LinearMap.congr_fun (ModuleCat.hom_ext_iff.1
      (homologyMap_comp_uliftIntHomologyIso_hom (TopCat.ofHom ⟨φ, φ.continuous⟩) 1)) z
    simp only [ModuleCat.hom_comp, LinearMap.coe_comp] at h
    rw [monodromyChainMap_def, monodromyChainMap_def]
    exact h
  intro x y hxy
  apply e.injective
  apply LinearMap.ker_eq_bot.1 (not_not.1 fun h ↦ hdet (LinearMap.det_eq_zero_iff_ker_ne_bot.2 h))
  have h := congrArg e hxy
  simp only [LinearMap.sub_apply, LinearMap.id_apply, map_sub, hφ] at h ⊢
  exact h

end Determinant

variable {F E : Type} [TopologicalSpace F] [T2Space F] [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [ChartedSpace E F] [CompactSpace F] [ConnectedSpace F] {n : ℕ}
  (o : HomologicalOrientation F E (n + 1)) (hn : finrank ℝ E = n + 1) {φ : F ≃ₜ F}

/-- An orientation-preserving homeomorphism, `φ_*[F] = [F]`, of a compact connected oriented
`(n + 1)`-manifold acts as the identity on `Hₙ₊₁(F; ℤ)`. -/
theorem homologyMap_monodromyChainMap_eq_id
    (hφ : o.mapFundamentalClass hn ⟨φ, φ.continuous⟩ = o.fundamentalClass hn) :
    homologyMap (monodromyChainMap φ (ModuleCat.of ℤ (ULift.{0} ℤ))) (n + 1) = 𝟙 _ := by
  have h := o.singularHomologyMap_eq_of_mapFundamentalClass_eq hn
    (hφ.trans (o.mapFundamentalClass_id hn).symm)
  rw [TopCat.ofHom_id, CategoryTheory.Functor.map_id] at h
  rw [monodromyChainMap_def]
  -- `singularHomologyFunctor` is by definition the homology of the singular chain complex, so `h`
  -- is the goal.
  exact h

/-- **The Wang connecting morphism is onto the top homology of the fibre.** If `φ` preserves the
fundamental class of a compact connected oriented `(n + 1)`-manifold `F`, it acts as the identity
on `Hₙ₊₁(F; ℤ)`, so by the exactness of the Wang sequence every class of `Hₙ₊₁(F; ℤ)` is `δ y` for
some `y ∈ Hₙ₊₂(T_φ; ℤ)`, where `δ` is the Wang connecting morphism. -/
theorem epi_wangδ_of_mapFundamentalClass_eq
    (hφ : o.mapFundamentalClass hn ⟨φ, φ.continuous⟩ = o.fundamentalClass hn) :
    Epi (wangδ φ (ModuleCat.of ℤ ℤ) (n + 1)) := by
  refine epi_wangδ_of_homologyMap_monodromyChainMap_eq_id φ _ (n + 1) ?_
  -- `φ_* = 𝟙` on `Hₙ₊₁(F; ULift ℤ)`, hence on `Hₙ₊₁(F; ℤ)` by naturality of the change of
  -- coefficients
  have h := homologyMap_monodromyChainMap_eq_id o hn hφ
  rw [monodromyChainMap_def] at h ⊢
  refine (cancel_epi (uliftIntHomologyIso (TopCat.of F) (n + 1)).hom).1 ?_
  -- term-mode steps: `homologyMap_comp_uliftIntHomologyIso_hom` is stated through `SSet.homology`,
  -- which is by definition the homology of the singular chain complex
  exact (homologyMap_comp_uliftIntHomologyIso_hom (TopCat.ofHom ⟨φ, φ.continuous⟩)
    (n + 1)).symm.trans ((congrArg (· ≫ _) h).trans
      ((Category.id_comp _).trans (Category.comp_id _).symm))

/-- **The fibre class generates the top homology of a mapping torus.** If `φ` preserves the
fundamental class of `F` and `𝟙 - φ_*` is injective on `Hₙ(F; ℤ)`, then `c ↦ c • i_*[F]` is an
isomorphism `ℤ ≃ₗ[ℤ] Hₙ₊₁(T_φ; ℤ)`, where `i : F → T_φ` is the fibre inclusion. -/
def fibreClassEquiv
    (hφ : o.mapFundamentalClass hn ⟨φ, φ.continuous⟩ = o.fundamentalClass hn)
    (h : Function.Injective (LinearMap.id -
      (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ (ULift.{0} ℤ))) n).hom : _ →ₗ[ℤ] _)) :
    ℤ ≃ₗ[ℤ] ((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ (ULift.{0} ℤ))).obj (TopCat.of (MappingTorus φ)) :=
  haveI := (mono_homologyMap_wangEndomorphism_iff φ _ n).2 h
  haveI := isIso_homologyMap_fibreInclusionChainMap_succ φ _ n
    (homologyMap_monodromyChainMap_eq_id o hn hφ)
  (o.fundamentalClassEquiv hn).trans
    (asIso (homologyMap (fibreInclusionChainMap φ (ModuleCat.of ℤ (ULift.{0} ℤ)))
      (n + 1))).toLinearEquiv

variable {o hn}
variable (hφ : o.mapFundamentalClass hn ⟨φ, φ.continuous⟩ = o.fundamentalClass hn)
  (h : Function.Injective (LinearMap.id -
    (homologyMap (monodromyChainMap φ (ModuleCat.of ℤ (ULift.{0} ℤ))) n).hom : _ →ₗ[ℤ] _))

/-- The isomorphism `TauCeti.MappingTorus.fibreClassEquiv` sends `c` to `c` times the fibre
class. -/
@[simp]
theorem fibreClassEquiv_apply (c : ℤ) :
    fibreClassEquiv o hn hφ h c = c • o.mapFundamentalClass hn (incl φ) := by
  rw [HomologicalOrientation.mapFundamentalClass_def, singularHomologyMap_incl_eq]
  exact (congrArg
    (homologyMap (fibreInclusionChainMap φ (ModuleCat.of ℤ (ULift.{0} ℤ))) (n + 1)).hom
    (o.fundamentalClassEquiv_apply hn c)).trans (map_zsmul _ c _)

include hφ h in
/-- Under the hypotheses of `TauCeti.MappingTorus.fibreClassEquiv`, every class of
`Hₙ₊₁(T_φ; ℤ)` is an integer multiple of the fibre class `i_*[F]`. -/
theorem exists_eq_zsmul_mapFundamentalClass_incl
    (γ : ((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ (ULift.{0} ℤ))).obj (TopCat.of (MappingTorus φ))) :
    ∃ d : ℤ, γ = d • o.mapFundamentalClass hn (incl φ) := by
  obtain ⟨d, rfl⟩ := (fibreClassEquiv o hn hφ h).surjective γ
  exact ⟨d, fibreClassEquiv_apply hφ h d⟩

variable (M : ModuleCat.{0} ℤ)

include hφ h in
/-- Under the hypotheses of `TauCeti.MappingTorus.fibreClassEquiv`, a class `w ∈ Hⁿ⁺¹(T_φ; ℤ, M)`
pairs to zero with all of `Hₙ₊₁(T_φ; ℤ)` exactly when it pairs to zero with the fibre class. -/
theorem singularKronecker_eq_zero_iff_evalFundamentalClass_eq_zero
    (w : (TopCat.of (MappingTorus φ)).singularCohomology (ModuleCat.of ℤ (ULift.{0} ℤ)) ℤ M
      (n + 1)) :
    (TopCat.of (MappingTorus φ)).singularKronecker ℤ (n + 1) w = 0 ↔
      o.evalFundamentalClass hn M (incl φ) w = 0 := by
  rw [HomologicalOrientation.evalFundamentalClass_apply]
  refine ⟨fun hw ↦ by simp [hw], fun hw ↦ ?_⟩
  ext γ
  obtain ⟨d, rfl⟩ := exists_eq_zsmul_mapFundamentalClass_incl hφ h γ
  simp [map_zsmul, hw]

include hφ h in
/-- Under the hypotheses of `TauCeti.MappingTorus.fibreClassEquiv`, every element of `M` is the
evaluation `⟨w, i_*[F]⟩` of a class `w ∈ Hⁿ⁺¹(T_φ; ℤ, M)` on the fibre class. For `M = ℤ` this
gives a class `v` with `⟨v, i_*[F]⟩ = 1`. -/
theorem surjective_evalFundamentalClass_incl :
    Function.Surjective (o.evalFundamentalClass hn M (incl φ)) := by
  intro m
  obtain ⟨w, hw⟩ := TauCeti.ChainComplex.kronecker_surjective_of_isSplitMono (k := ℤ)
    (X := (TopCat.toSSet.obj (TopCat.of (MappingTorus φ))).chainComplex
      (ModuleCat.of ℤ (ULift.{0} ℤ))) (Y := M) (n + 1)
    (ModuleCat.ofHom (LinearMap.toSpanSingleton ℤ M m ∘ₗ
      (fibreClassEquiv o hn hφ h).symm.toLinearMap))
  have h₁ : (fibreClassEquiv o hn hφ h).symm (o.mapFundamentalClass hn (incl φ)) = 1 := by
    rw [LinearEquiv.symm_apply_eq, fibreClassEquiv_apply, one_smul]
  have h₂ : (ModuleCat.ofHom (LinearMap.toSpanSingleton ℤ M m ∘ₗ
      (fibreClassEquiv o hn hφ h).symm.toLinearMap)).hom
        (o.mapFundamentalClass hn (incl φ)) = m := by
    simp only [ModuleCat.hom_ofHom, LinearMap.comp_apply, LinearEquiv.coe_coe, h₁,
      LinearMap.toSpanSingleton_apply]
    -- The scalar action on `M` is its `ModuleCat` module structure.
    exact @one_smul _ _ _ M.isModule.toDistribMulAction.toMulAction m
  refine ⟨w, ?_⟩
  rw [HomologicalOrientation.evalFundamentalClass_apply, TopCat.singularKronecker_def]
  exact (congrArg (fun g ↦ g.hom (o.mapFundamentalClass hn (incl φ))) hw).trans h₂

end TauCeti.MappingTorus
