module

public import TauCeti.AlgebraicTopology.Singular.Coinvariants
public import TauCeti.CategoryTheory.Limits.Shapes.Products
public import TauCeti.Topology.MappingTorus.Covering
public import Mathlib.Algebra.Homology.HomologicalComplexAbelian

/-!
# The singular chains of the infinite cyclic cover of a mapping torus

Let `φ : F ≃ₜ F` be a homeomorphism.  The mapping torus `T_φ` is the quotient of the cylinder
`F × ℝ` by the covering action of `ℤ` generated by the deck transformation
`τ : (x, t) ↦ (φ x, t + 1)`.  This file proves that the singular chains of the cover and of the
mapping torus form a short exact sequence of chain complexes
`0 ⟶ C(F × ℝ; R) ⟶ C(F × ℝ; R) ⟶ C(T_φ; R) ⟶ 0`, whose first map is `𝟙 - τ_*` and whose second
map is induced by the covering map.

* `TauCeti.MappingTorus.isColimitCyclicCoverCokernelCofork`: the chains of the mapping torus are
  the cokernel of `𝟙 - τ_*`.  Since the mapping torus is the quotient of `F × ℝ` by a covering
  action, its chains are the coinvariants of the action of `ℤ` on the chains of `F × ℝ`
  (`IsQuotientCoveringMap.isColimitMapCoconeSingularChainComplex`), and coinvariants of `ℤ` are a
  cokernel of `𝟙 - τ_*`.
* `TauCeti.MappingTorus.isSplitMono_id_sub_deckChainMap_f`: in each degree, `𝟙 - τ_*` is a split
  monomorphism.  The deck transformation permutes the singular simplices of `F × ℝ` freely,
  raising the integer part of the height of the initial vertex by one, so the retraction
  telescopes along each orbit (`TauCeti.isSplitMono_id_sub`).
* `TauCeti.MappingTorus.cyclicCoverShortComplex_shortExact`: the short exact sequence, for
  coefficients in an abelian category with coproducts.

The projection `F × ℝ → F` is a homotopy equivalence carrying `τ` to `φ`.  Through it, the long
exact homology sequence of this short exact sequence is the Wang sequence
`⋯ ⟶ Hₙ(F) ⟶ Hₙ(F) ⟶ Hₙ(T_φ) ⟶ Hₙ₋₁(F) ⟶ ⋯` of the mapping torus, with first map `𝟙 - φ_*`; see
`TauCeti.AlgebraicTopology.Singular.MappingTorus.Wang`.

## References

* J. Milnor, *Infinite cyclic coverings*, Conference on the Topology of Manifolds (1968),
  Section 1, for the exact sequence of the chains of an infinite cyclic cover.
* A. Hatcher, *Algebraic Topology*, Section 2.2, Example 2.48, for the Wang sequence of a mapping
  torus.
-/

public section

noncomputable section

open AlgebraicTopology CategoryTheory Limits Simplicial TauCeti.TopCat

universe w v u

namespace TauCeti.MappingTorus

variable {F : Type w} [TopologicalSpace F] (φ : F ≃ₜ F)

section Preadditive

variable {C : Type u} [Category.{v} C] [HasCoproducts.{w} C] [Preadditive C] (R : C)

/-- The endomorphism `τ_*` of the singular chains of the cylinder `F × ℝ` induced by the deck
transformation `τ : (x, t) ↦ (φ x, t + 1)`. -/
def deckChainMap :
    ((singularChainComplexFunctor C).obj R).obj (TopCat.of (F × ℝ)) ⟶
      ((singularChainComplexFunctor C).obj R).obj (TopCat.of (F × ℝ)) :=
  ((singularChainComplexFunctor C).obj R).map (TopCat.ofHom (deck φ : C(F × ℝ, F × ℝ)))

/-- The deck chain map is the singular-chain functor applied to the deck transformation. -/
lemma deckChainMap_def :
    deckChainMap φ R =
      ((singularChainComplexFunctor C).obj R).map (TopCat.ofHom (deck φ : C(F × ℝ, F × ℝ))) :=
  (rfl)

/-- The map from the singular chains of the cylinder `F × ℝ` to those of the mapping torus induced
by the covering map. -/
def coverChainMap :
    ((singularChainComplexFunctor C).obj R).obj (TopCat.of (F × ℝ)) ⟶
      ((singularChainComplexFunctor C).obj R).obj (TopCat.of (MappingTorus φ)) :=
  ((singularChainComplexFunctor C).obj R).map (TopCat.ofHom (coverMap φ))

/-- The cover chain map is the singular-chain functor applied to the covering map. -/
lemma coverChainMap_def :
    coverChainMap φ R = ((singularChainComplexFunctor C).obj R).map (TopCat.ofHom (coverMap φ)) :=
  (rfl)

/-- The covering map is invariant under the deck transformation, so the cover chain map kills
`𝟙 - τ_*`. -/
@[reassoc (attr := simp)]
lemma deckChainMap_comp_coverChainMap :
    deckChainMap φ R ≫ coverChainMap φ R = coverChainMap φ R := by
  rw [deckChainMap_def, coverChainMap_def, ← Functor.map_comp]
  congr 1
  ext p
  exact coverMap_deck φ p

/-- **The chains of a mapping torus are a cokernel.**  The singular chains of the mapping torus
of `φ` are the cokernel of `𝟙 - τ_*` on the singular chains of the cylinder `F × ℝ`, with
projection the cover chain map. -/
def isColimitCyclicCoverCokernelCofork :
    IsColimit (CokernelCofork.ofπ (f := 𝟙 _ - deckChainMap φ R) (coverChainMap φ R)
      (by simp [Preadditive.sub_comp])) := by
  letI := action φ
  -- The covering map is the quotient covering map of the multiplicative form of the action.
  have hG : IsQuotientCoveringMap (TopCat.ofHom (coverMap φ)) (Multiplicative ℤ) :=
    IsAddQuotientCoveringMap.toMultiplicative _ ℤ (isAddQuotientCoveringMap_coverMap φ)
  refine SingleObj.isColimitCokernelCoforkOfIsColimit _
    (hG.isColimitMapCoconeSingularChainComplex R) ?_
  -- The generator `ofAdd 1` acts by the deck transformation.
  simp only [Functor.comp_map, TopCat.actionFunctor_map]
  exact congrArg _ (congrArg _ (ContinuousMap.ext fun p ↦ (deck_eq_vadd φ p).symm))

/-- The deck transformation, acting on the singular `n`-simplices of the cylinder `F × ℝ`. -/
private def deckSimplexPerm (n : SimplexCategoryᵒᵖ) :
    Equiv.Perm ((TopCat.toSSet.obj (TopCat.of (F × ℝ))).obj n) :=
  ((TopCat.toSSet.mapIso (TopCat.isoOfHomeo (deck φ))).app n).toEquiv

private lemma deckSimplexPerm_apply {n : SimplexCategoryᵒᵖ}
    (σ : (TopCat.toSSet.obj (TopCat.of (F × ℝ))).obj n) :
    deckSimplexPerm φ n σ =
      (TopCat.toSSet.map (TopCat.ofHom (deck φ : C(F × ℝ, F × ℝ)))).app n σ :=
  (rfl)

/-- In each degree, `𝟙 - τ_*` is a split monomorphism on the singular chains of the cylinder.  The
deck transformation raises the integer part of the height of the initial vertex of a singular
simplex by one, so it permutes the simplices freely and the retraction telescopes along each
orbit. -/
theorem isSplitMono_id_sub_deckChainMap_f (n : ℕ) :
    IsSplitMono (𝟙 _ - (deckChainMap φ R).f n) := by
  let X := TopCat.toSSet.obj (TopCat.of (F × ℝ))
  let x : SimplexCategory.toTop.{w}.obj ⦋n⦌ := SimplexCategory.toTopInitialVertex _
  refine isSplitMono_id_sub (X.isColimitChainComplexXCofan R n) (e := deckSimplexPerm φ _)
    (h := fun σ ↦ ⌊(simplexMap σ x).2⌋) (fun σ ↦ ?_) fun σ ↦ ?_
  · -- The deck transformation adds one to the height.
    dsimp only
    rw [deckSimplexPerm_apply, simplexMap_app]
    simp
  · exact SSet.ι_chainComplexMap_f (x := σ) ..

/-- **The chain-level short complex of the infinite cyclic cover of a mapping torus**
`C(F × ℝ; R) ⟶ C(F × ℝ; R) ⟶ C(T_φ; R)`, with first map `𝟙 - τ_*` and second map induced by the
covering map. -/
abbrev cyclicCoverShortComplex : ShortComplex (ChainComplex C ℕ) :=
  ShortComplex.mk (𝟙 _ - deckChainMap φ R) (coverChainMap φ R) (by simp [Preadditive.sub_comp])

end Preadditive

variable {C : Type u} [Category.{v} C] [Abelian C] [HasCoproducts.{w} C] (R : C)

/-- **The short exact sequence of the infinite cyclic cover of a mapping torus.**  For
coefficients in an abelian category with coproducts, the sequence of singular chains
`0 ⟶ C(F × ℝ; R) ⟶ C(F × ℝ; R) ⟶ C(T_φ; R) ⟶ 0`, with first map `𝟙 - τ_*` and second map induced
by the covering map, is short exact. -/
theorem cyclicCoverShortComplex_shortExact : (cyclicCoverShortComplex φ R).ShortExact := by
  have hc := isColimitCyclicCoverCokernelCofork φ R
  have : Mono (cyclicCoverShortComplex φ R).f :=
    HomologicalComplex.mono_of_mono_f _ fun n ↦ by
      have := isSplitMono_id_sub_deckChainMap_f φ R n
      simpa using (inferInstance : Mono (𝟙 _ - (deckChainMap φ R).f n))
  exact .mk' (ShortComplex.exact_of_g_is_cokernel _ hc) this (epi_of_isColimit_cofork hc)

end TauCeti.MappingTorus
