module

public import TauCeti.Algebra.Homology.Monoidal.Homology.Kunneth.Projective
public import TauCeti.AlgebraicTopology.Singular.Cubical.Comparison.Relative.CubePair
public import TauCeti.AlgebraicTopology.Singular.Cubical.Kunneth

/-!
# The relative cubical cross product and the Künneth theorem for a pair times a space

For a topological pair `P = (X, A)` and a space `Y`, the cubical cross product
`N(X) ⊗ N(Y) ⟶ N(X × Y)` carries the chains of `A` tensored with those of `Y` into the chains of
`A × Y`, so it descends to the **relative cubical cross product**

`N(X, A) ⊗ N(Y) ⟶ N(X × Y, A × Y)`

(`TopPair.cubicalCrossProduct`), where `(X × Y, A × Y)` is the product pair `P.prodRight Y`. It
is a quasi-isomorphism (`TopPair.quasiIso_cubicalCrossProduct`): this is the **relative
Eilenberg–Zilber theorem**. The sequence `0 ⟶ N(A) ⟶ N(X) ⟶ N(X, A) ⟶ 0` splits in each degree,
so it stays short exact after tensoring with `N(Y)`, and the cross products of `A × Y` and `X × Y`
form a morphism from the tensored sequence to the chain sequence of the pair `(X × Y, A × Y)`. The
absolute cross products are quasi-isomorphisms (`TauCeti.quasiIso_cubicalCrossProduct`), so by
the five lemma, applied to the long exact homology sequences, so is the relative one.

The relative Künneth map `⨁_{p + q = n} Hₚ(X, A) ⊗ H_q(Y) ⟶ Hₙ(X × Y, A × Y)`
(`TopPair.cubicalHomologyKunneth`) is the algebraic Künneth map followed by the map induced by the
relative cross product. It is an isomorphism whenever the relative homology of `P` is projective,
over any commutative ring and with no condition on `Y` (`TopPair.isIso_cubicalHomologyKunneth`),
because the relative chains of `P` are projective as well.

For the cube pair `(Iᵐ⁺¹, ∂Iᵐ⁺¹)` the relative homology is `k`, generated by the fundamental cycle
`[Iᵐ⁺¹]`, in degree `m + 1` and zero otherwise. So taking the cross product with `[Iᵐ⁺¹]` is an
isomorphism

`H_q(Y; k) ≃ₗ[k] Hₘ₊₁₊q(Iᵐ⁺¹ × Y, ∂Iᵐ⁺¹ × Y; k)`

(`TauCeti.cubicalHomologyCubeBoundaryPairProdRightEquiv`), which sends the class of a cycle `z` to
the class of the relative cycle `[Iᵐ⁺¹] × z`
(`TauCeti.cubicalHomologyCubeBoundaryPairProdRightEquiv_homologyπ`). This identifies the relative
homology of the product of a cell with a space, the building block of comparisons of chains over a
CW complex one cell at a time.

## Main definitions and results

* `TopPair.cubicalCrossProduct k P Y`: the relative cross product
  `N(X, A) ⊗ N(Y) ⟶ N(X × Y, A × Y)`, characterized by
  `TopPair.cokernelπ_whiskerRight_cubicalCrossProduct`.
* `TopPair.quasiIso_cubicalCrossProduct`: the relative Eilenberg–Zilber theorem.
* `TopPair.cubicalHomologyKunneth`, `TopPair.isIso_cubicalHomologyKunneth`: the relative Künneth
  map, an isomorphism when the relative homology of the pair is projective.
* `TauCeti.cubicalHomologyCubeBoundaryPairProdRightEquiv`: the isomorphism
  `H_q(Y; k) ≃ₗ[k] Hₘ₊₁₊q(Iᵐ⁺¹ × Y, ∂Iᵐ⁺¹ × Y; k)`, `x ↦ [Iᵐ⁺¹] × x`.

## References

* W. S. Massey, *Singular Homology Theory*, GTM 70, Springer, 1980, Chapter VII.
* E. H. Spanier, *Algebraic Topology*, McGraw-Hill, 1966, Chapter 5, Section 3, the relative
  Künneth formula.
-/

public section

noncomputable section

open CategoryTheory MonoidalCategory Limits HomologicalComplex TauCeti

universe u

namespace TopPair

variable (k : Type u) [CommRing k] (P : TopPair.{u}) (Y : TopCat.{u})

/-! ### The relative cross product -/

/-- The cross product is natural along the inclusion of the subspace of a pair: tensoring the
chains of `A ⊆ X` with those of `Y` and then taking the cross product in `X × Y` is the cross
product in `A × Y` followed by the inclusion `A × Y ⊆ X × Y`. -/
@[reassoc]
theorem whiskerRight_comp_cubicalCrossProduct :
    ((normalizedCubicalChainComplex k).map P.map ▷ (normalizedCubicalChainComplex k).obj Y) ≫
        TauCeti.cubicalCrossProduct k P.fst Y =
      TauCeti.cubicalCrossProduct k P.snd Y ≫
        (normalizedCubicalChainComplex k).map (P.prodRight Y).map := by
  rw [← tensorHom_id, ← (normalizedCubicalChainComplex k).map_id Y]
  exact TauCeti.cubicalCrossProduct_naturality (R := k) P.map (𝟙 Y)

/-- The chain sequence `N(A) ⟶ N(X) ⟶ N(X, A)` of a pair, tensored on the right with `N(Y)`, is
short exact, since it splits in each degree. -/
theorem shortExact_tensorRightShortComplex_cubicalChainComplexShortComplex :
    (tensorRightShortComplex ((normalizedCubicalChainComplex k).obj Y)
      (P.cubicalChainComplexShortComplex k)).ShortExact :=
  shortExact_tensorRightShortComplex _ _ (P.shortExact_cubicalChainComplexShortComplex k)

/-- **The relative cubical cross product** `N(X, A) ⊗ N(Y) ⟶ N(X × Y, A × Y)` of a pair
`P = (X, A)` and a space `Y`, induced by the cross product `N(X) ⊗ N(Y) ⟶ N(X × Y)`
(`TopPair.cokernelπ_whiskerRight_cubicalCrossProduct`). -/
def cubicalCrossProduct :
    P.cubicalChainComplex k ⊗ (normalizedCubicalChainComplex k).obj Y ⟶
      (P.prodRight Y).cubicalChainComplex k :=
  (CokernelCofork.IsColimit.desc'
    (P.shortExact_tensorRightShortComplex_cubicalChainComplexShortComplex k Y).gIsCokernel
    (TauCeti.cubicalCrossProduct k P.fst Y ≫
      cokernel.π ((normalizedCubicalChainComplex k).map (P.prodRight Y).map))
    ((whiskerRight_comp_cubicalCrossProduct_assoc k P Y _).trans ((Category.assoc _ _ _).trans
      ((TauCeti.cubicalCrossProduct k P.snd Y ≫= cokernel.condition _).trans comp_zero)))).1

/-- The relative cross product of the classes of chains of `X` and `Y` is the class of their
cross product. -/
@[reassoc (attr := simp)]
theorem cokernelπ_whiskerRight_cubicalCrossProduct :
    (cokernel.π ((normalizedCubicalChainComplex k).map P.map) ▷
        (normalizedCubicalChainComplex k).obj Y) ≫ P.cubicalCrossProduct k Y =
      TauCeti.cubicalCrossProduct k P.fst Y ≫
        cokernel.π ((normalizedCubicalChainComplex k).map (P.prodRight Y).map) :=
  (CokernelCofork.IsColimit.desc'
    (P.shortExact_tensorRightShortComplex_cubicalChainComplexShortComplex k Y).gIsCokernel _ _).2

/-- The cross products of `A × Y`, of `X × Y` and of the pair, as a morphism from the chain
sequence of `P` tensored with `N(Y)` to the chain sequence of the pair `(X × Y, A × Y)`. -/
def cubicalCrossProductShortComplex :
    tensorRightShortComplex ((normalizedCubicalChainComplex k).obj Y)
        (P.cubicalChainComplexShortComplex k) ⟶
      (P.prodRight Y).cubicalChainComplexShortComplex k where
  τ₁ := TauCeti.cubicalCrossProduct k P.snd Y
  τ₂ := TauCeti.cubicalCrossProduct k P.fst Y
  τ₃ := P.cubicalCrossProduct k Y
  comm₁₂ := (whiskerRight_comp_cubicalCrossProduct k P Y).symm
  comm₂₃ := (cokernelπ_whiskerRight_cubicalCrossProduct k P Y).symm

/-- **The relative Eilenberg–Zilber theorem**: the relative cubical cross product
`N(X, A) ⊗ N(Y) ⟶ N(X × Y, A × Y)` is a quasi-isomorphism. -/
instance quasiIso_cubicalCrossProduct : QuasiIso (P.cubicalCrossProduct k Y) :=
  HomologicalComplex.HomologySequence.quasiIso_τ₃ (P.cubicalCrossProductShortComplex k Y)
    (P.shortExact_tensorRightShortComplex_cubicalChainComplexShortComplex k Y)
    ((P.prodRight Y).shortExact_cubicalChainComplexShortComplex k)
    (inferInstanceAs (QuasiIso (TauCeti.cubicalCrossProduct k P.snd Y)))
    (inferInstanceAs (QuasiIso (TauCeti.cubicalCrossProduct k P.fst Y)))

/-! ### The relative Künneth theorem -/

/-- **The relative Künneth map** `⨁_{p + q = n} Hₚ(X, A; k) ⊗ H_q(Y; k) ⟶ Hₙ(X × Y, A × Y; k)` of
a pair `P = (X, A)` and a space `Y`: the algebraic Künneth map of the chain complexes `N(X, A)` and
`N(Y)` followed by the map induced by the relative cross product. -/
def cubicalHomologyKunneth (n : ℕ) :
    GradedObject.Monoidal.tensorObj (fun p ↦ (P.cubicalChainComplex k).homology p)
        (fun q ↦ ((normalizedCubicalChainComplex k).obj Y).homology q) n ⟶
      ((P.prodRight Y).cubicalChainComplex k).homology n :=
  homologyKunneth (P.cubicalChainComplex k) ((normalizedCubicalChainComplex k).obj Y) n ≫
    homologyMap (P.cubicalCrossProduct k Y) n

/-- The relative Künneth map is the algebraic Künneth map followed by the map induced by the
relative cross product. -/
theorem cubicalHomologyKunneth_def (n : ℕ) :
    P.cubicalHomologyKunneth k Y n =
      homologyKunneth (P.cubicalChainComplex k) ((normalizedCubicalChainComplex k).obj Y) n ≫
        homologyMap (P.cubicalCrossProduct k Y) n :=
  (rfl)

/-- The relative Künneth map restricts to the homology cross product followed by the map induced
by the relative cross product on each summand. -/
@[reassoc (attr := simp)]
theorem ι_cubicalHomologyKunneth (p q n : ℕ) (h : p + q = n) :
    GradedObject.Monoidal.ιTensorObj (fun p ↦ (P.cubicalChainComplex k).homology p)
        (fun q ↦ ((normalizedCubicalChainComplex k).obj Y).homology q) p q n h ≫
      P.cubicalHomologyKunneth k Y n =
      homologyCross (P.cubicalChainComplex k) ((normalizedCubicalChainComplex k).obj Y) p q n h ≫
        homologyMap (P.cubicalCrossProduct k Y) n := by
  rw [cubicalHomologyKunneth_def, ι_homologyKunneth_assoc]

/-- **The relative Künneth theorem**: if the relative cubical homology modules of a pair
`P = (X, A)` are projective, for instance free, then for every space `Y` the relative Künneth map
`⨁_{p + q = n} Hₚ(X, A; k) ⊗ H_q(Y; k) ⟶ Hₙ(X × Y, A × Y; k)` is an isomorphism, over every
commutative ring `k`. -/
theorem isIso_cubicalHomologyKunneth
    [∀ p, Module.Projective k ((P.cubicalChainComplex k).homology p)] (n : ℕ) :
    IsIso (P.cubicalHomologyKunneth k Y n) := by
  have := isIso_homologyKunneth_of_projective (P.cubicalChainComplex k)
    ((normalizedCubicalChainComplex k).obj Y) n
  rw [cubicalHomologyKunneth_def]
  infer_instance

end TopPair

namespace TauCeti

/-! ### The product of the cube pair with a space -/

variable (k : Type) [CommRing k] (X : TopCat.{0}) (m : ℕ)

/-- Since the relative homology of the cube pair `(Iᵐ⁺¹, ∂Iᵐ⁺¹)` vanishes outside degree `m + 1`,
the summand `Hₘ₊₁(Iᵐ⁺¹, ∂Iᵐ⁺¹) ⊗ H_q(X)` is all of the degree `m + 1 + q` part of the tensor
product of the homologies. -/
private lemma isIso_ιTensorObj_cubeBoundaryPair (q : ℕ) :
    IsIso (GradedObject.Monoidal.ιTensorObj
      (fun p ↦ ((cubeBoundaryPair.{0} (m + 1)).cubicalChainComplex k).homology p)
      (fun q ↦ ((normalizedCubicalChainComplex k).obj X).homology q) (m + 1) q (m + 1 + q) rfl) :=
  ⟨GradedObject.Monoidal.tensorObjDesc fun p q' h ↦
      if hp : p = m + 1 then eqToHom (by rw [hp, show q' = q by omega]) else 0,
    by simp, GradedObject.Monoidal.tensorObj_ext _ _ fun p q' h ↦ by
      by_cases hp : p = m + 1
      · obtain rfl := hp
        obtain rfl : q' = q := by omega
        simp
      · exact ((tensorRight _).map_isZero
          (isZero_cubicalHomology_cubeBoundaryPair_of_ne k hp)).eq_of_src _ _⟩

/-- **The relative homology of the product of the cube pair with a space**: taking the cross
product with the fundamental cycle `[Iᵐ⁺¹]` is an isomorphism
`H_q(X; k) ≃ₗ[k] Hₘ₊₁₊q(Iᵐ⁺¹ × X, ∂Iᵐ⁺¹ × X; k)`, over every commutative ring `k`
(`TauCeti.cubicalHomologyCubeBoundaryPairProdRightEquiv_apply`,
`TauCeti.cubicalHomologyCubeBoundaryPairProdRightEquiv_homologyπ`). -/
def cubicalHomologyCubeBoundaryPairProdRightEquiv (q : ℕ) :
    ((normalizedCubicalChainComplex k).obj X).homology q ≃ₗ[k]
      (((cubeBoundaryPair.{0} (m + 1)).prodRight X).cubicalChainComplex k).homology (m + 1 + q) :=
  have := isIso_ιTensorObj_cubeBoundaryPair k X m q
  have := (cubeBoundaryPair.{0} (m + 1)).isIso_cubicalHomologyKunneth k X (m + 1 + q)
  (TensorProduct.lid k _).symm ≪≫ₗ
    TensorProduct.congr (cubicalHomologyCubeBoundaryPairEquiv k m) (LinearEquiv.refl k _) ≪≫ₗ
    (asIso (GradedObject.Monoidal.ιTensorObj _ _ (m + 1) q (m + 1 + q) rfl ≫
      (cubeBoundaryPair.{0} (m + 1)).cubicalHomologyKunneth k X (m + 1 + q))).toLinearEquiv

/-- The isomorphism `H_q(X; k) ≃ₗ[k] Hₘ₊₁₊q(Iᵐ⁺¹ × X, ∂Iᵐ⁺¹ × X; k)` sends a class `x` to the
relative cross product of the fundamental class `[Iᵐ⁺¹]` with `x`. -/
@[simp]
theorem cubicalHomologyCubeBoundaryPairProdRightEquiv_apply (q : ℕ)
    (x : ((normalizedCubicalChainComplex k).obj X).homology q) :
    cubicalHomologyCubeBoundaryPairProdRightEquiv k X m q x =
      (homologyMap ((cubeBoundaryPair.{0} (m + 1)).cubicalCrossProduct k X) (m + 1 + q)).hom
        ((homologyCross ((cubeBoundaryPair.{0} (m + 1)).cubicalChainComplex k)
          ((normalizedCubicalChainComplex k).obj X) (m + 1) q (m + 1 + q) rfl).hom
          (((cubeBoundaryPair.{0} (m + 1)).cubicalChainComplex k).homologyπ (m + 1)
            (cubeBoundaryPairCycle k m) ⊗ₜ x)) := by
  simp only [cubicalHomologyCubeBoundaryPairProdRightEquiv, LinearEquiv.trans_apply,
    TensorProduct.lid_symm_apply, TensorProduct.congr_tmul, LinearEquiv.refl_apply,
    cubicalHomologyCubeBoundaryPairEquiv_apply, one_smul]
  -- `(asIso f).toLinearEquiv y` is `f.hom y` by `Iso.toLinearEquiv_apply`, which `simp` does not
  -- fire here because the carrier of a tensor product in `ModuleCat` is only unfolded to
  -- `TensorProduct` at default transparency
  exact ConcreteCategory.congr_hom
    ((cubeBoundaryPair.{0} (m + 1)).ι_cubicalHomologyKunneth k X (m + 1) q (m + 1 + q) rfl) _

/-- The isomorphism `H_q(X; k) ≃ₗ[k] Hₘ₊₁₊q(Iᵐ⁺¹ × X, ∂Iᵐ⁺¹ × X; k)` sends the class of a cycle
`z` to the class of the relative cycle `[Iᵐ⁺¹] × z`, the image of the tensor product of the
fundamental cycle and `z` under the relative cross product. -/
theorem cubicalHomologyCubeBoundaryPairProdRightEquiv_homologyπ (q : ℕ)
    (z : ((normalizedCubicalChainComplex k).obj X).cycles q) :
    cubicalHomologyCubeBoundaryPairProdRightEquiv k X m q
        (((normalizedCubicalChainComplex k).obj X).homologyπ q z) =
      (((cubeBoundaryPair.{0} (m + 1)).prodRight X).cubicalChainComplex k).homologyπ (m + 1 + q)
        ((cyclesMap ((cubeBoundaryPair.{0} (m + 1)).cubicalCrossProduct k X) (m + 1 + q)).hom
          ((cyclesCross ((cubeBoundaryPair.{0} (m + 1)).cubicalChainComplex k)
            ((normalizedCubicalChainComplex k).obj X) (m + 1) q (m + 1 + q) rfl).hom
            (cubeBoundaryPairCycle k m ⊗ₜ z))) := by
  rw [cubicalHomologyCubeBoundaryPairProdRightEquiv_apply]
  have h := congrArg (fun f ↦ f.hom (cubeBoundaryPairCycle k m ⊗ₜ z))
    (homologyπ_tensorHom_homologyCross_assoc
      ((cubeBoundaryPair.{0} (m + 1)).cubicalChainComplex k)
      ((normalizedCubicalChainComplex k).obj X) (m + 1) q (m + 1 + q) rfl
      (homologyMap ((cubeBoundaryPair.{0} (m + 1)).cubicalCrossProduct k X) (m + 1 + q)))
  rw [homologyπ_naturality] at h
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply,
    ModuleCat.MonoidalCategory.tensorHom_tmul] at h
  exact h

end TauCeti
