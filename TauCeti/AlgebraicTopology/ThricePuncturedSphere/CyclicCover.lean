/-!
# Cyclic covers of the thrice-punctured sphere

For `m ≠ 0` and `a b : ℕ`, the affine curve

  `y ^ m = t ^ a * (t - 1) ^ b`,      `t ∈ ℂ ∖ {0, 1}`,

projects to the `t`-line as an `m`-sheeted covering map of the thrice-punctured sphere: it is the
pullback of the power map `y ↦ y ^ m`, a covering of `ℂ` over `ℂ ∖ {0}`, along the function
`t ↦ tᵃ (t − 1)ᵇ`, which has no zeros on `ℂ ∖ {0, 1}`. Multiplying `y` by an `m`-th root of unity
permutes each fibre, so the cover is cyclic.

This file computes the monodromy of this cover directly from its equation. Let
`ζ = exp (2πi / m)`. Over the basepoint `1/2` the fibre consists of the `m` points `ζ ^ k · y₀`,
where `y₀` is the value at `t = 1/2` of the branch `exp ((a log t + b log (t − 1)) / m)` of
`(tᵃ (t − 1)ᵇ)^(1/m)` (with `log (−1/2) = log (1/2) + πi`). Along the counterclockwise circle `γ0`
of radius `1/2` about `0`, the factor `tᵃ` winds `a` times around `0` and `(t − 1)ᵇ` does not wind,
so the lift starting at `ζ ^ k · y₀` is

  `s ↦ ζ ^ k · exp ((a (log (1/2) + 2πis) + b (log (1 − γ0 s) + πi)) / m)`,

which ends at `ζ ^ (k + a) · y₀`. Symmetrically, along the circle `γ1` about `1` the lift ends at
`ζ ^ (k + b) · y₀`. Numbering the fibre by `ζ ^ k · y₀ ↦ k`, the monodromy triple is therefore
`(r ^ a, r ^ b, (r ^ (a + b))⁻¹)`, where `r = finRotate m` is the cyclic rotation `k ↦ k + 1` of
`Fin m`.

The rotation `(t, y) ↦ (t, ζ · y)` is a deck transformation, and it induces the rotation
`k ↦ k + 1` on the labels. When the cover is connected, its deck group therefore has order `m`
and is generated by the rotation, so the cover is regular with cyclic deck group `ℤ/m`.

For `(m, a, b) = (4, 1, 1)` this is the superelliptic curve `y⁴ = t (t − 1)`, and its monodromy
triple is `TauCeti.PermutationTriple.torusTriple`, the connected triple of genus one with cycle
types `[4], [4], [2, 2]`. In particular this cover is path connected, and its deck group is cyclic
of order `4`, generated by `y ↦ i · y`. This finite cover is the input to the compactification
`TauCeti.FilledCover`, which fills its four punctures over `0`, `1` and `∞` to give the compact
Riemann surface of the algebraic function `(t² − t)^(1/4)` with its Belyi map `t`.

## Main declarations

* `TauCeti.ThricePuncturedSphere.CyclicCover m a b`: the curve `y ^ m = tᵃ (t − 1)ᵇ` over
  `ℂ ∖ {0, 1}`, as the fibre product of `t ↦ tᵃ (t − 1)ᵇ` and `y ↦ y ^ m`.
* `TauCeti.ThricePuncturedSphere.CyclicCover.isCoveringMap_fst`: its projection to `t` is a
  covering map.
* `TauCeti.ThricePuncturedSphere.CyclicCover.fiberEquiv`: the numbering `ζ ^ k · y₀ ↦ k` of the
  fibre over `1/2`.
* `TauCeti.ThricePuncturedSphere.CyclicCover.monodromyPerm_periph0_fiberPoint`,
  `TauCeti.ThricePuncturedSphere.CyclicCover.monodromyPerm_periph1_fiberPoint`: monodromy along the
  peripheral loops about `0` and `1` multiplies `y` by `ζ ^ a` and by `ζ ^ b`.
* `TauCeti.ThricePuncturedSphere.CyclicCover.monodromyTriple_fiberEquiv`: the monodromy triple is
  `(r ^ a, r ^ b, (r ^ (a + b))⁻¹)`.
* `TauCeti.ThricePuncturedSphere.CyclicCover.rotate`: the deck transformation `y ↦ ζ · y`; for
  `y⁴ = t (t − 1)` it is `y ↦ i · y` (`CyclicCover.snd_rotate_apply_four`).
* `TauCeti.ThricePuncturedSphere.CyclicCover.natCard_deck`,
  `TauCeti.ThricePuncturedSphere.CyclicCover.zpowers_rotate`: a connected cyclic cover has deck
  group of order `m`, generated by the rotation.
* `TauCeti.ThricePuncturedSphere.CyclicCover.monodromyTriple_fiberEquiv_eq_torusTriple`: the
  monodromy triple of `y⁴ = t (t − 1)` is `torusTriple`; consequently this cover is path
  connected.

## References

* O. Forster, *Lectures on Riemann Surfaces*, Graduate Texts in Mathematics 81, Springer 1981,
  §8 (the Riemann surface of an algebraic function, obtained by filling the punctures of the
  covering defined by its equation).
* E. Girondo and G. González-Diez, *Introduction to Compact Riemann Surfaces and Dessins
  d'Enfants*, London Mathematical Society Student Texts 79, Cambridge University Press, 2012,
  §2.7 (the monodromy of a cover, computed by lifting the loops around the branch values).
-/

public section

noncomputable section

namespace TauCeti

namespace ThricePuncturedSphere

open Complex Function Set

open scoped Real

/-- The **cyclic cover** `y ^ m = tᵃ (t − 1)ᵇ` of the thrice-punctured sphere: the fibre product
of `t ↦ tᵃ (t − 1)ᵇ` on `ℂ ∖ {0, 1}` with the power map `y ↦ y ^ m` on `ℂ`, that is, the pairs
`(t, y)` with `tᵃ (t − 1)ᵇ = y ^ m`, with the subspace topology of `(ℂ ∖ {0, 1}) × ℂ`. It covers
`ℂ ∖ {0, 1}` by the first projection `Function.Pullback.fst`. -/
abbrev CyclicCover (m a b : ℕ) : Type :=
  Function.Pullback (fun t : ThricePuncturedSphere ↦ (t : ℂ) ^ a * ((t : ℂ) - 1) ^ b)
    (fun y : ℂ ↦ y ^ m)

namespace CyclicCover

variable {m a b : ℕ}

/-- The point `(t, y)` of the cyclic cover `y ^ m = tᵃ (t − 1)ᵇ`. -/
def mk (t : ThricePuncturedSphere) (y : ℂ) (h : y ^ m = (t : ℂ) ^ a * ((t : ℂ) - 1) ^ b) :
    CyclicCover m a b :=
  ⟨(t, y), h.symm⟩

@[simp]
theorem fst_mk (t : ThricePuncturedSphere) (y : ℂ)
    (h : y ^ m = (t : ℂ) ^ a * ((t : ℂ) - 1) ^ b) : (mk t y h).fst = t :=
  (rfl)

@[simp]
theorem snd_mk (t : ThricePuncturedSphere) (y : ℂ)
    (h : y ^ m = (t : ℂ) ^ a * ((t : ℂ) - 1) ^ b) : (mk t y h).snd = y :=
  (rfl)

/-- The equation of the cyclic cover. -/
theorem snd_pow (z : CyclicCover m a b) :
    z.snd ^ m = (z.fst : ℂ) ^ a * ((z.fst : ℂ) - 1) ^ b :=
  z.2.symm

/-- The function `t ↦ tᵃ (t − 1)ᵇ` has no zeros on `ℂ ∖ {0, 1}`. -/
private theorem rhs_ne_zero (t : ThricePuncturedSphere) : (t : ℂ) ^ a * ((t : ℂ) - 1) ^ b ≠ 0 :=
  mul_ne_zero (pow_ne_zero _ t.ne_zero) (pow_ne_zero _ (sub_ne_zero.2 t.ne_one))

variable [NeZero m]

/-- **The cyclic cover is a covering map**: for `m ≠ 0`, the projection `(t, y) ↦ t` of the curve
`y ^ m = tᵃ (t − 1)ᵇ` to `ℂ ∖ {0, 1}` is a covering map. -/
theorem isCoveringMap_fst :
    IsCoveringMap (Function.Pullback.fst : CyclicCover m a b → ThricePuncturedSphere) :=
  (isCoveringMapOn_npow m (Nat.cast_ne_zero.2 (NeZero.ne m))).isCoveringMap_pullback_fst
    (by fun_prop) fun t ↦ rhs_ne_zero t

/-- The primitive `m`-th root of unity `exp (2πi / m)`. -/
local notation "ζ" => cexp (2 * π * I / m)

/-- The exponent `a log (1/2) + b log (−1/2)` of the basepoint value `y₀ = exp (… / m)`, with the
principal value `log (−1/2) = log (1/2) + πi`. -/
local notation "w₀" => (a * log (1 / 2) + b * (log (1 / 2) + π * I) : ℂ)

private theorem isPrimitiveRoot_ζ : IsPrimitiveRoot ζ m :=
  isPrimitiveRoot_exp m (NeZero.ne m)

/-- The `m`-th power of `exp (w / m)` is `exp w`. -/
private theorem exp_div_pow (w : ℂ) : cexp (w / m) ^ m = cexp w := by
  rw [← exp_nat_mul, mul_div_cancel₀ _ (Nat.cast_ne_zero.2 (NeZero.ne m))]

/-- The `m`-th power of `ζ ^ k · exp (w / m)` is `exp w`. -/
private theorem pow_mul_exp_div_pow (k : ℕ) (w : ℂ) : (ζ ^ k * cexp (w / m)) ^ m = cexp w := by
  rw [mul_pow, ← pow_mul, pow_mul', isPrimitiveRoot_ζ.pow_eq_one, one_pow, one_mul, exp_div_pow]

/-- `exp (a u + b v) = (exp u)ᵃ (exp v)ᵇ`. -/
private theorem exp_nat_mul_add_nat_mul (u v : ℂ) :
    cexp (a * u + b * v) = cexp u ^ a * cexp v ^ b := by
  simp only [exp_add, exp_nat_mul]

/-- `exp (a log (1/2) + b log (−1/2)) = (1/2)ᵃ (1/2 − 1)ᵇ`. -/
private theorem exp_w₀ : cexp w₀ = (1 / 2 : ℂ) ^ a * (1 / 2 - 1) ^ b := by
  rw [exp_nat_mul_add_nat_mul]
  simp only [exp_add, exp_log (by norm_num : (1 / 2 : ℂ) ≠ 0), exp_pi_mul_I]
  norm_num

/-- The point `ζ ^ k · y₀` of the fibre of the cyclic cover over `1/2`, where
`y₀ = exp ((a log (1/2) + b log (−1/2)) / m)`. -/
def fiberPoint (k : ℕ) :
    (Function.Pullback.fst ⁻¹' {basePt} : Set (CyclicCover m a b)) :=
  ⟨mk basePt (ζ ^ k * cexp (w₀ / m)) (by rw [pow_mul_exp_div_pow, exp_w₀, coe_basePt]), rfl⟩

@[simp]
theorem fst_fiberPoint (k : ℕ) : (fiberPoint (m := m) (a := a) (b := b) k : CyclicCover m a b).fst =
    basePt :=
  (rfl)

/-- The `y`-coordinate of `fiberPoint k` is `ζ ^ k · y₀`. -/
theorem snd_fiberPoint (k : ℕ) : (fiberPoint (m := m) (a := a) (b := b) k : CyclicCover m a b).snd =
    cexp (2 * π * I / m) ^ k * cexp ((a * log (1 / 2) + b * (log (1 / 2) + π * I)) / m) :=
  (rfl)

/-- The fibre points are periodic modulo `m`. -/
theorem fiberPoint_mod (k : ℕ) :
    fiberPoint (m := m) (a := a) (b := b) (k % m) = fiberPoint k := by
  refine Subtype.ext (Pullback.ext rfl ?_)
  have h := pow_mod_orderOf ζ k
  rw [← isPrimitiveRoot_ζ.eq_orderOf] at h
  rw [snd_fiberPoint, snd_fiberPoint, h]

/-- The fibre points `ζ ^ i · y₀`, `i < m`, are pairwise distinct. -/
private theorem fiberPoint_injective :
    Injective fun i : Fin m ↦ fiberPoint (m := m) (a := a) (b := b) i := by
  intro i j hij
  dsimp only at hij
  have h := congrArg (fun z ↦ Function.Pullback.snd (Subtype.val z)) hij
  simp only [snd_fiberPoint] at h
  exact Fin.ext (isPrimitiveRoot_ζ.pow_inj i.2 j.2 (mul_right_cancel₀ (exp_ne_zero _) h))

/-- Every point of the fibre over `1/2` is one of the points `ζ ^ i · y₀`, `i < m`. -/
private theorem fiberPoint_surjective :
    Surjective fun i : Fin m ↦ fiberPoint (m := m) (a := a) (b := b) i := by
  intro z
  have hz : (z : CyclicCover m a b).fst = basePt := z.2
  have hy₀ : cexp (w₀ / m) ≠ 0 := exp_ne_zero _
  have hpow : ((z : CyclicCover m a b).snd / cexp (w₀ / m)) ^ m = 1 := by
    rw [div_pow, snd_pow, hz, exp_div_pow, exp_w₀, coe_basePt]
    exact div_self (by norm_num)
  obtain ⟨i, hi, hζ⟩ := isPrimitiveRoot_ζ.eq_pow_of_pow_eq_one hpow
  refine ⟨⟨i, hi⟩, Subtype.ext (Pullback.ext hz.symm ?_)⟩
  rw [snd_fiberPoint, hζ, div_mul_cancel₀ _ hy₀]

/-- The numbering of the fibre of the cyclic cover over `1/2` by `Fin m`: the point
`ζ ^ k · y₀` gets the label `k`, where `ζ = exp (2πi / m)` and
`y₀ = exp ((a log (1/2) + b log (−1/2)) / m)` (see `CyclicCover.fiberEquiv_symm_apply`). -/
def fiberEquiv : (Function.Pullback.fst ⁻¹' {basePt} : Set (CyclicCover m a b)) ≃ Fin m :=
  (Equiv.ofBijective _ ⟨fiberPoint_injective, fiberPoint_surjective⟩).symm

@[simp]
theorem fiberEquiv_symm_apply (i : Fin m) :
    (fiberEquiv (m := m) (a := a) (b := b)).symm i = fiberPoint i :=
  (rfl)

/-- The label of `fiberPoint k` is `k` modulo `m`. -/
@[simp]
theorem fiberEquiv_fiberPoint (k : ℕ) :
    fiberEquiv (fiberPoint (m := m) (a := a) (b := b) k) =
      ⟨k % m, Nat.mod_lt _ (NeZero.pos m)⟩ := by
  rw [← fiberPoint_mod, ← fiberEquiv_symm_apply ⟨k % m, Nat.mod_lt _ (NeZero.pos m)⟩,
    Equiv.apply_symm_apply]

/-- Along `γ0`, the point `1 − γ0 s` stays in the right half-plane, where `log` is continuous. -/
private theorem one_sub_γ0_mem_slitPlane (s : unitInterval) : 1 - (γ0 s : ℂ) ∈ slitPlane := by
  have h := re_le_norm (γ0 s : ℂ)
  rw [norm_coe_γ0] at h
  exact Or.inl (by rw [sub_re, one_re]; linarith)

/-- Along `γ1`, the point `γ1 s` stays in the right half-plane, where `log` is continuous. -/
private theorem γ1_mem_slitPlane (s : unitInterval) : (γ1 s : ℂ) ∈ slitPlane :=
  Or.inl (mem_rightOpen.1 (γ1_mem_rightOpen s))

/-- The lift of `γ0` to the cyclic cover starting at `fiberPoint k`: over `t = (1/2) exp (2πis)`,
the branch `ζ ^ k · exp ((a (log (1/2) + 2πis) + b (log (1 − t) + πi)) / m)` of
`(tᵃ (t − 1)ᵇ)^(1/m)`. -/
private def liftγ0 (k : ℕ) : C(unitInterval, CyclicCover m a b) where
  toFun s := mk (γ0 s) (ζ ^ k * cexp ((a * (log (1 / 2) + 2 * π * I * s) +
      b * (log (1 - γ0 s) + π * I)) / m)) (by
    rw [pow_mul_exp_div_pow, exp_nat_mul_add_nat_mul]
    simp only [exp_add, exp_log (by norm_num : (1 / 2 : ℂ) ≠ 0),
      exp_log (slitPlane_ne_zero (one_sub_γ0_mem_slitPlane s)), exp_pi_mul_I]
    rw [coe_γ0_eq_exp]
    ring)
  continuous_toFun := by
    have hlog : Continuous fun s : unitInterval ↦ log (1 - (γ0 s : ℂ)) :=
      (continuous_const.sub (continuous_subtype_val.comp γ0.continuous)).clog
        one_sub_γ0_mem_slitPlane
    exact Continuous.subtype_mk (γ0.continuous.prodMk (by fun_prop)) _

private theorem snd_liftγ0 (k : ℕ) (s : unitInterval) :
    (liftγ0 (m := m) (a := a) (b := b) k s).snd = ζ ^ k * cexp ((a * (log (1 / 2) +
      2 * π * I * s) + b * (log (1 - γ0 s) + π * I)) / m) :=
  (rfl)

/-- The lift of `γ1` to the cyclic cover starting at `fiberPoint k`: over
`t = 1 − (1/2) exp (2πis)`, the branch `ζ ^ k · exp ((a log t + b (log (1/2) + πi + 2πis)) / m)`
of `(tᵃ (t − 1)ᵇ)^(1/m)`. -/
private def liftγ1 (k : ℕ) : C(unitInterval, CyclicCover m a b) where
  toFun s := mk (γ1 s) (ζ ^ k * cexp ((a * log (γ1 s) +
      b * (log (1 / 2) + π * I + 2 * π * I * s)) / m)) (by
    rw [show (γ1 s : ℂ) - 1 = 1 / 2 * -1 * cexp (2 * π * I * s) by rw [coe_γ1_eq_exp]; ring,
      pow_mul_exp_div_pow, exp_nat_mul_add_nat_mul]
    simp only [exp_add, exp_log (slitPlane_ne_zero (γ1_mem_slitPlane s)),
      exp_log (by norm_num : (1 / 2 : ℂ) ≠ 0), exp_pi_mul_I])
  continuous_toFun := by
    have hlog : Continuous fun s : unitInterval ↦ log (γ1 s : ℂ) :=
      (continuous_subtype_val.comp γ1.continuous).clog γ1_mem_slitPlane
    exact Continuous.subtype_mk (γ1.continuous.prodMk (by fun_prop)) _

private theorem snd_liftγ1 (k : ℕ) (s : unitInterval) :
    (liftγ1 (m := m) (a := a) (b := b) k s).snd = ζ ^ k * cexp ((a * log (γ1 s) +
      b * (log (1 / 2) + π * I + 2 * π * I * s)) / m) :=
  (rfl)

private theorem liftγ0_zero (k : ℕ) :
    liftγ0 (m := m) (a := a) (b := b) k 0 =
      (fiberPoint (m := m) (a := a) (b := b) k : CyclicCover m a b) := by
  refine Pullback.ext γ0.source ?_
  rw [snd_liftγ0, snd_fiberPoint, γ0.source, coe_basePt]
  norm_num

private theorem liftγ0_one (k : ℕ) :
    liftγ0 (m := m) (a := a) (b := b) k 1 =
      (fiberPoint (m := m) (a := a) (b := b) (k + a) : CyclicCover m a b) := by
  refine Pullback.ext γ0.target ?_
  rw [snd_liftγ0, snd_fiberPoint, γ0.target, coe_basePt, show (1 : ℂ) - 1 / 2 = 1 / 2 by norm_num]
  simp only [← exp_nat_mul, ← exp_add]
  congr 1
  push_cast
  field_simp
  ring

private theorem liftγ1_zero (k : ℕ) :
    liftγ1 (m := m) (a := a) (b := b) k 0 =
      (fiberPoint (m := m) (a := a) (b := b) k : CyclicCover m a b) := by
  refine Pullback.ext γ1.source ?_
  rw [snd_liftγ1, snd_fiberPoint, γ1.source, coe_basePt]
  norm_num

private theorem liftγ1_one (k : ℕ) :
    liftγ1 (m := m) (a := a) (b := b) k 1 =
      (fiberPoint (m := m) (a := a) (b := b) (k + b) : CyclicCover m a b) := by
  refine Pullback.ext γ1.target ?_
  rw [snd_liftγ1, snd_fiberPoint, γ1.target, coe_basePt]
  simp only [← exp_nat_mul, ← exp_add]
  congr 1
  push_cast
  field_simp
  ring

/-- **Monodromy about `0`**: along the peripheral loop about `0`, the point `ζ ^ k · y₀` of the
fibre over `1/2` moves to `ζ ^ (k + a) · y₀`, since `tᵃ` winds `a` times around `0` while
`(t − 1)ᵇ` does not wind. -/
@[simp]
theorem monodromyPerm_periph0_fiberPoint (k : ℕ) :
    (isCoveringMap_fst (m := m) (a := a) (b := b)).monodromyPerm basePt periph0 (fiberPoint k) =
      fiberPoint (k + a) := by
  refine Subtype.ext ?_
  rw [IsCoveringMap.coe_monodromyPerm, periph0_def]
  exact (isCoveringMap_fst.monodromy_eq_apply_one (Γ := liftγ0 k) (funext fun _ ↦ rfl)
    (liftγ0_zero k)).trans (liftγ0_one k)

/-- **Monodromy about `1`**: along the peripheral loop about `1`, the point `ζ ^ k · y₀` of the
fibre over `1/2` moves to `ζ ^ (k + b) · y₀`. -/
@[simp]
theorem monodromyPerm_periph1_fiberPoint (k : ℕ) :
    (isCoveringMap_fst (m := m) (a := a) (b := b)).monodromyPerm basePt periph1 (fiberPoint k) =
      fiberPoint (k + b) := by
  refine Subtype.ext ?_
  rw [IsCoveringMap.coe_monodromyPerm, periph1_def]
  exact (isCoveringMap_fst.monodromy_eq_apply_one (Γ := liftγ1 k) (funext fun _ ↦ rfl)
    (liftγ1_zero k)).trans (liftγ1_one k)

/-- **The monodromy triple of the cyclic cover** `y ^ m = tᵃ (t − 1)ᵇ`, with the fibre over `1/2`
numbered by `ζ ^ k · y₀ ↦ k`, is `(r ^ a, r ^ b, (r ^ b * r ^ a)⁻¹)` for the cyclic rotation
`r = finRotate m`. -/
theorem monodromyTriple_fiberEquiv :
    (isCoveringMap_fst (m := m) (a := a) (b := b)).monodromyTriple fiberEquiv =
      PermutationTriple.ofTwo (finRotate m ^ a) (finRotate m ^ b) := by
  refine PermutationTriple.ext_of_two (Equiv.ext fun i ↦ ?_) (Equiv.ext fun i ↦ ?_) <;>
  · simp only [IsCoveringMap.monodromyTriple_σ0, IsCoveringMap.monodromyTriple_σ1,
      PermutationTriple.ofTwo_σ0, PermutationTriple.ofTwo_σ1, Equiv.permCongr_apply,
      fiberEquiv_symm_apply, monodromyPerm_periph0_fiberPoint, monodromyPerm_periph1_fiberPoint,
      fiberEquiv_fiberPoint]
    exact Fin.ext (Fin.coe_finRotate_pow _ i).symm

/-! ### The rotation of the sheets -/

/-- The **rotation** `(t, y) ↦ (t, ζ · y)` of the cyclic cover, with `ζ = exp (2πi / m)`: a deck
transformation of the projection to `ℂ ∖ {0, 1}`. -/
def rotate : deck (Function.Pullback.fst : CyclicCover m a b → ThricePuncturedSphere) :=
  ⟨{ toFun z := mk z.fst (ζ * z.snd) (by
        rw [mul_pow, isPrimitiveRoot_ζ.pow_eq_one, one_mul, snd_pow])
     invFun z := mk z.fst (ζ⁻¹ * z.snd) (by
        rw [mul_pow, inv_pow, isPrimitiveRoot_ζ.pow_eq_one, inv_one, one_mul, snd_pow])
     left_inv z := Pullback.ext rfl (inv_mul_cancel_left₀ (exp_ne_zero _) z.snd)
     right_inv z := Pullback.ext rfl (mul_inv_cancel_left₀ (exp_ne_zero _) z.snd)
     continuous_toFun := Continuous.subtype_mk (by fun_prop) _
     continuous_invFun := Continuous.subtype_mk (by fun_prop) _ },
    rfl⟩

@[simp]
theorem fst_rotate_apply (z : CyclicCover m a b) :
    ((rotate (m := m) (a := a) (b := b) : CyclicCover m a b ≃ₜ CyclicCover m a b) z).fst =
      z.fst :=
  (rfl)

@[simp]
theorem snd_rotate_apply (z : CyclicCover m a b) :
    ((rotate (m := m) (a := a) (b := b) : CyclicCover m a b ≃ₜ CyclicCover m a b) z).snd =
      cexp (2 * π * I / m) * z.snd :=
  (rfl)

/-- On the superelliptic curve `y⁴ = t (t − 1)` the rotation is `y ↦ i · y`, as
`exp (2πi / 4) = i`. -/
theorem snd_rotate_apply_four (z : CyclicCover 4 1 1) :
    ((rotate (m := 4) (a := 1) (b := 1) : CyclicCover 4 1 1 ≃ₜ CyclicCover 4 1 1) z).snd =
      I * z.snd := by
  rw [snd_rotate_apply, show 2 * π * I / (4 : ℕ) = π / 2 * I by push_cast; ring,
    exp_pi_div_two_mul_I]

/-- The rotation moves the fibre point `ζ ^ k · y₀` to `ζ ^ (k + 1) · y₀`. -/
@[simp]
theorem rotate_smul_fiberPoint (k : ℕ) :
    rotate (m := m) (a := a) (b := b) • fiberPoint k =
      fiberPoint (m := m) (a := a) (b := b) (k + 1) := by
  refine Subtype.ext (Pullback.ext rfl ?_)
  rw [deck.fiber_smul_coe, snd_rotate_apply, snd_fiberPoint, snd_fiberPoint, pow_succ',
    ← mul_assoc]

section Connected

variable [PathConnectedSpace (CyclicCover m a b)]

/-- Under the identification of the deck group of a connected cyclic cover with the automorphism
group of its monodromy triple, the rotation `y ↦ ζ · y` is the rotation `k ↦ k + 1` of the
labels. -/
theorem coe_deckMulEquivAutomorphismGroup_rotate :
    ((isCoveringMap_fst (m := m) (a := a) (b := b)).deckMulEquivAutomorphismGroup fiberEquiv
      rotate : Equiv.Perm (Fin m)) = finRotate m := by
  refine Equiv.ext fun i ↦ ?_
  rw [IsCoveringMap.coe_deckMulEquivAutomorphismGroup_apply, fiberEquiv_symm_apply,
    rotate_smul_fiberPoint, fiberEquiv_fiberPoint]
  exact Fin.ext ((Fin.coe_finRotate_pow 1 i).symm.trans (by rw [pow_one]))

/-- The rotation `y ↦ ζ · y` of a connected cyclic cover has order `m`. -/
theorem orderOf_rotate : orderOf (rotate (m := m) (a := a) (b := b)) = m := by
  rw [← (isCoveringMap_fst.deckMulEquivAutomorphismGroup fiberEquiv).orderOf_eq,
    ← Subgroup.orderOf_coe, coe_deckMulEquivAutomorphismGroup_rotate,
    orderOf_finRotate (NeZero.ne m)]

/-- A connected cyclic cover is regular: its deck group has order `m`, the number of sheets. -/
theorem natCard_deck :
    Nat.card (deck (Function.Pullback.fst : CyclicCover m a b → ThricePuncturedSphere)) = m := by
  have hdvd := PermutationTriple.card_automorphismGroup_dvd
    (isCoveringMap_fst.isConnected_monodromyTriple
      (fiberEquiv (m := m) (a := a) (b := b))).isPretransitive
  rw [← Nat.card_congr
    (isCoveringMap_fst.deckMulEquivAutomorphismGroup fiberEquiv).toEquiv] at hdvd
  have : Finite (deck (Function.Pullback.fst : CyclicCover m a b → ThricePuncturedSphere)) :=
    Nat.finite_of_card_ne_zero (ne_zero_of_dvd_ne_zero (NeZero.ne m) hdvd)
  refine le_antisymm (Nat.le_of_dvd (NeZero.pos m) hdvd) ?_
  calc m = orderOf (rotate (m := m) (a := a) (b := b)) := orderOf_rotate.symm
    _ ≤ _ := orderOf_le_card

/-- **The deck group of a connected cyclic cover is cyclic, generated by the rotation**
`y ↦ ζ · y` with `ζ = exp (2πi / m)`. -/
theorem zpowers_rotate : Subgroup.zpowers (rotate (m := m) (a := a) (b := b)) = ⊤ := by
  have : Finite (deck (Function.Pullback.fst : CyclicCover m a b → ThricePuncturedSphere)) :=
    Nat.finite_of_card_ne_zero (by rw [natCard_deck]; exact NeZero.ne m)
  exact Subgroup.eq_top_of_card_eq _ (by rw [Nat.card_zpowers, natCard_deck, orderOf_rotate])

end Connected

/-! ### The superelliptic curve `y⁴ = t (t − 1)` -/

/-- **The superelliptic curve `y⁴ = t (t − 1)`** has monodromy triple `torusTriple`: monodromy
about `0` and about `1` is the rotation `k ↦ k + 1` of the four sheets, and about `∞` it is
`k ↦ k + 2`. -/
theorem monodromyTriple_fiberEquiv_eq_torusTriple :
    (isCoveringMap_fst (m := 4) (a := 1) (b := 1)).monodromyTriple fiberEquiv =
      PermutationTriple.torusTriple := by
  rw [monodromyTriple_fiberEquiv]
  exact PermutationTriple.ext_of_two (pow_one _) (pow_one _)

/-- The superelliptic curve `y⁴ = t (t − 1)` over `ℂ ∖ {0, 1}` is path connected, since its
monodromy triple `torusTriple` is connected. Hence `CyclicCover.natCard_deck` and
`CyclicCover.zpowers_rotate` apply: its deck group is cyclic of order `4`, generated by
`y ↦ i · y` (see `CyclicCover.snd_rotate_apply_four`). -/
instance : PathConnectedSpace (CyclicCover 4 1 1) := by
  refine (isCoveringMap_fst.isConnected_monodromyTriple_iff fiberEquiv).1 ?_
  rw [monodromyTriple_fiberEquiv_eq_torusTriple]
  exact PermutationTriple.isConnected_torusTriple

end CyclicCover

end ThricePuncturedSphere

end TauCeti
