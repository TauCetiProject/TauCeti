module

public import TauCeti.AlgebraicTopology.ThricePuncturedSphere.InfinityGenerator
public import TauCeti.AlgebraicTopology.ThricePuncturedSphere.MonodromyTriple
public import TauCeti.Topology.Homotopy.Monodromy.BasepointChange
public import TauCeti.Topology.Homotopy.Monodromy.PreimageComponents

import TauCeti.GroupTheory.Perm.Basic
import TauCeti.Topology.IsLocalHomeomorph

/-!
# The components of a cover over the punctured neighborhood of infinity

Let `p : E → ℂ ∖ {0, 1}` be a covering map whose fibre over the basepoint `1/2` is numbered by
`ν`, with monodromy triple `(σ0, σ1, σinf)`. This file proves that the connected components of the
preimage `p ⁻¹' D∞*` of the standard punctured neighborhood `D∞* = {z | 2 < ‖z‖}` of infinity are
in bijection with the cycles of `σinf`.

These components are the points to be added over `∞` when a finite cover of the thrice-punctured
sphere is compactified to a branched cover of the Riemann sphere. The bijection is not with the
fibre, nor with the orbits of the whole monodromy group: it is with the orbits of the single
permutation `σinf`.

The proof has three steps.

* The fundamental group of `D∞*` at `p₊ = 1/2 + (√35/2)·i` is generated by the large clockwise
  circle `δInf` (`zpowers_δInf`), and `D∞*` is path connected. So the components of `p ⁻¹' D∞*`
  are the cycles of the monodromy of `δInf` on the fibre over `p₊`
  (`IsCoveringMap.sameCycleQuotientEquivZerothHomotopy`).
* Transported to the basepoint `1/2` along the vertical segment `αPlus`, the class of `δInf` is
  `periphInf` (`transport_δInf_eq_periphInf`). So monodromy along `αPlus` carries the cycles of
  `periphInf` on the fibre over `1/2` to those of `δInf` on the fibre over `p₊`.
* The numbering `ν` carries the monodromy of `periphInf` to `σinf`.

Explicitly, the cycle of a sheet `i` corresponds to the component containing the endpoint of the
lift of `αPlus` that starts at the point numbered `i`.

## Main declarations

* `IsCoveringMap.sameCycle_monodromyTriple_σinf_iff`: two sheets lie in the same cycle of
  `σinf` exactly when the endpoints of their lifts of `αPlus` lie in the same cycle of the local
  monodromy at infinity.
* `IsCoveringMap.sameCycle_monodromyTriple_σinf_iff_joinedIn`: equivalently, exactly when those
  endpoints are joined by a path inside `p ⁻¹' D∞*`.
* `IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents`: the cycles of `σinf` are the
  connected components of `p ⁻¹' D∞*`, with value `sameCycleQuotientσinfEquivConnectedComponents_mk`
  on the cycle of a sheet.

## References

* E. Girondo and G. González-Diez, *Introduction to Compact Riemann Surfaces and Dessins
  d'Enfants*, London Mathematical Society Student Texts 79, Cambridge University Press, 2012,
  §1.2.7 (the components of the preimage of a punctured disc, one added point for each) and
  §2.7 (their correspondence with the cycles of the monodromy).
-/

public section

noncomputable section

namespace TauCeti

open ThricePuncturedSphere Equiv Equiv.Perm

variable {n : ℕ} {E : Type*} [TopologicalSpace E] {p : E → ThricePuncturedSphere}
  (hp : IsCoveringMap p) (ν : p ⁻¹' {basePt} ≃ Fin n)

/-- **`σinf` is the local monodromy at infinity.** Two sheets lie in the same cycle of the third
permutation `σinf` of the monodromy triple exactly when the endpoints of their lifts of `αPlus`
lie in the same cycle of the monodromy of the clockwise large circle `δInf`, a generator of the
fundamental group of the punctured neighborhood of infinity. -/
theorem _root_.IsCoveringMap.sameCycle_monodromyTriple_σinf_iff (i j : Fin n) :
    (hp.monodromyTriple ν).σinf.SameCycle i j ↔
      (hp.monodromyPerm pPlus
          (FundamentalGroup.map ⟨Subtype.val, continuous_subtype_val⟩ infBasePt
            (FundamentalGroup.fromPath (.mk δInf)))).SameCycle
        (hp.monodromy (.mk αPlus) (ν.symm i)) (hp.monodromy (.mk αPlus) (ν.symm j)) := by
  rw [hp.monodromyTriple_σinf, ← transport_δInf_eq_periphInf,
    hp.monodromyPerm_fundamentalGroupMulEquivOfPath_symm, sameCycle_permCongr_iff,
    sameCycle_permCongr_iff, Equiv.symm_symm,
    coveringFiberEquiv_apply, coveringFiberEquiv_apply]

/-- **Cycles of `σinf` are the components over infinity, pointwise.** Two sheets lie in the same
cycle of `σinf` exactly when the endpoints of their lifts of `αPlus` are joined by a path inside
the preimage of the punctured neighborhood of infinity. -/
theorem _root_.IsCoveringMap.sameCycle_monodromyTriple_σinf_iff_joinedIn (i j : Fin n) :
    (hp.monodromyTriple ν).σinf.SameCycle i j ↔
      JoinedIn (p ⁻¹' puncturedNeighborhoodInf)
        (hp.monodromy (.mk αPlus) (ν.symm i) : E) (hp.monodromy (.mk αPlus) (ν.symm j)) := by
  rw [hp.sameCycle_monodromyTriple_σinf_iff,
    hp.sameCycle_monodromyPerm_iff_joinedIn_preimage pPlus_mem_puncturedNeighborhoodInf
      zpowers_δInf]

/-- The endpoint of a lift of `αPlus` lies over the punctured neighborhood of infinity. -/
theorem _root_.IsCoveringMap.monodromy_αPlus_mem_preimage (e : p ⁻¹' {basePt}) :
    (hp.monodromy (.mk αPlus) e : E) ∈ p ⁻¹' puncturedNeighborhoodInf := by
  rw [Set.mem_preimage, (hp.monodromy (.mk αPlus) e).2]
  exact pPlus_mem_puncturedNeighborhoodInf

/-- The preimage of `D∞*` is locally path connected, being open in the total space of a cover of a
locally path-connected space. -/
private theorem locallyPathConnectedSpace_preimage_puncturedNeighborhoodInf
    (hp : IsCoveringMap p) : LocallyPathConnectedSpace (p ⁻¹' puncturedNeighborhoodInf) := by
  have := hp.isLocalHomeomorph.locallyPathConnectedSpace
  exact (isOpen_puncturedNeighborhoodInf.preimage hp.continuous).locallyPathConnectedSpace

/-- **The points over infinity.** The cycles of the third permutation `σinf` of the monodromy
triple are in bijection with the connected components of the preimage of the punctured
neighborhood `{z | 2 < ‖z‖}` of infinity. The cycle of a sheet `i` goes to the component of the
endpoint of the lift of `αPlus` starting at the point numbered `i`
(`IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents_mk`). -/
def _root_.IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents :
    Quotient (SameCycle.setoid (hp.monodromyTriple ν).σinf) ≃
      ConnectedComponents (p ⁻¹' puncturedNeighborhoodInf) :=
  haveI := locallyPathConnectedSpace_preimage_puncturedNeighborhoodInf hp
  ((Quotient.congr (ν.symm.trans (coveringFiberEquiv hp (.mk αPlus))) fun i j => by
      rw [Equiv.trans_apply, Equiv.trans_apply, coveringFiberEquiv_apply,
        coveringFiberEquiv_apply]
      exact hp.sameCycle_monodromyTriple_σinf_iff ν i j).trans
    (hp.sameCycleQuotientEquivZerothHomotopy isPathConnected_puncturedNeighborhoodInf
      pPlus_mem_puncturedNeighborhoodInf zpowers_δInf)).trans
    connectedComponentsEquivZerothHomotopy.symm

/-- The cycle of the sheet `i` goes to the connected component of the endpoint of the lift of
`αPlus` starting at the point numbered `i`. -/
@[simp]
theorem _root_.IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents_mk (i : Fin n) :
    hp.sameCycleQuotientσinfEquivConnectedComponents ν (Quotient.mk _ i) =
      ConnectedComponents.mk
        ⟨hp.monodromy (.mk αPlus) (ν.symm i), hp.monodromy_αPlus_mem_preimage (ν.symm i)⟩ := by
  have := locallyPathConnectedSpace_preimage_puncturedNeighborhoodInf hp
  simp only [IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents, Equiv.trans_apply,
    Quotient.congr_mk, coveringFiberEquiv_apply]
  rw [hp.sameCycleQuotientEquivZerothHomotopy_mk, connectedComponentsEquivZerothHomotopy_symm_apply]
  -- Mathlib states the last value as the quotient class `⟦x⟧`, which is `ConnectedComponents.mk x`
  -- by definition.
  rfl

end TauCeti
