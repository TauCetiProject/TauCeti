module

public import TauCeti.AlgebraicTopology.ThricePuncturedSphere.InfinityGenerator
public import TauCeti.AlgebraicTopology.ThricePuncturedSphere.MonodromyTriple
public import TauCeti.AlgebraicTopology.ThricePuncturedSphere.ZeroOneGenerators
public import TauCeti.Topology.Homotopy.Monodromy.BasepointChange
public import TauCeti.Topology.Homotopy.Monodromy.PreimageComponents

import TauCeti.GroupTheory.Perm.Basic
import TauCeti.Topology.IsLocalHomeomorph

/-!
# The components of a cover over the punctured neighborhoods of the punctures

Let `p : E → ℂ ∖ {0, 1}` be a covering map whose fibre over the basepoint `1/2` is numbered by
`ν`, with monodromy triple `(σ0, σ1, σinf)`. This file proves that for each puncture
`q ∈ {0, 1, ∞}` the connected components of the preimage `p ⁻¹' D_q*` of the standard punctured
neighborhood

* `D₀* = {z | ‖z‖ < 1/2}`, `D₁* = {z | ‖z - 1‖ < 1/2}`, `D∞* = {z | 2 < ‖z‖}`

are in bijection with the cycles of `σ_q`.

These components are the points to be added over `q` when a finite cover of the thrice-punctured
sphere is compactified to a branched cover of the Riemann sphere. The bijection is not with the
fibre, nor with the orbits of the whole monodromy group: it is with the orbits of the single
permutation `σ_q`.

The proof has three steps, the same at each puncture.

* The fundamental group of `D_q*` at a local basepoint `y_q` is generated by a local circle `δ_q`
  (`zpowers_δZero`, `zpowers_δOne`, `zpowers_δInf`), and `D_q*` is path connected. So the
  components of `p ⁻¹' D_q*` are the cycles of the monodromy of `δ_q` on the fibre over `y_q`
  (`IsCoveringMap.sameCycleQuotientEquivZerothHomotopy`).
* Transported to the basepoint `1/2` along a path `α_q` (`αZero`, `αOne`, `αPlus`), the class of
  `δ_q` is the peripheral element at `q` (`transport_δZero_eq_periph0`,
  `transport_δOne_eq_periph1`, `transport_δInf_eq_periphInf`). So monodromy along `α_q` carries
  the cycles of the peripheral element on the fibre over `1/2` to those of `δ_q` on the fibre over
  `y_q`.
* The numbering `ν` carries the monodromy of the peripheral element to `σ_q`.

Explicitly, the cycle of a sheet `i` corresponds to the component containing the endpoint of the
lift of `α_q` that starts at the point numbered `i`.

## Main declarations

* `IsCoveringMap.sameCycle_monodromyTriple_σ0_iff`,
  `IsCoveringMap.sameCycle_monodromyTriple_σ1_iff`,
  `IsCoveringMap.sameCycle_monodromyTriple_σinf_iff`: two sheets lie in the same cycle of `σ_q`
  exactly when the endpoints of their lifts of `α_q` lie in the same cycle of the local monodromy
  at `q`.
* `IsCoveringMap.sameCycle_monodromyTriple_σ0_iff_joinedIn` and its analogues at `1` and `∞`:
  equivalently, exactly when those endpoints are joined by a path inside `p ⁻¹' D_q*`.
* `IsCoveringMap.sameCycleQuotientσ0EquivConnectedComponents`,
  `IsCoveringMap.sameCycleQuotientσ1EquivConnectedComponents`,
  `IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents`: the cycles of `σ_q` are the
  connected components of `p ⁻¹' D_q*`, with the values `…_mk` on the cycle of a sheet.

## References

* E. Girondo and G. González-Diez, *Introduction to Compact Riemann Surfaces and Dessins
  d'Enfants*, London Mathematical Society Student Texts 79, Cambridge University Press, 2012,
  §1.2.7 (the components of the preimage of a punctured disc, one added point for each) and
  §2.7 (their correspondence with the cycles of the monodromy).
-/

public section

noncomputable section

namespace TauCeti

open ThricePuncturedSphere Equiv Equiv.Perm

variable {n : ℕ} {E : Type*} [TopologicalSpace E] {p : E → ThricePuncturedSphere}
  (hp : IsCoveringMap p) (ν : p ⁻¹' {basePt} ≃ Fin n)

/-! ### Cycles of a peripheral permutation from a local generator -/

section Local

variable {S : Set ThricePuncturedSphere} {y : ThricePuncturedSphere} (hy : y ∈ S)
  {c : FundamentalGroup S ⟨y, hy⟩} {α : Path basePt y}
  {g : FundamentalGroup ThricePuncturedSphere basePt}
  {σ : Perm (Fin n)}

include hp in
/-- If the local class `c` at `y ∈ S` is transported along `α` to `g` at the basepoint, then two
sheets lie in the same cycle of the monodromy of `g` exactly when the endpoints of their lifts of
`α` lie in the same cycle of the monodromy of `c`. -/
private theorem sameCycle_iff_of_transport
    (hσ : σ = ν.permCongr (hp.monodromyPerm basePt g))
    (hg : (FundamentalGroup.fundamentalGroupMulEquivOfPath α).symm
      (FundamentalGroup.map ⟨Subtype.val, continuous_subtype_val⟩ ⟨y, hy⟩ c) = g)
    (i j : Fin n) :
    σ.SameCycle i j ↔
      (hp.monodromyPerm y
          (FundamentalGroup.map ⟨Subtype.val, continuous_subtype_val⟩ ⟨y, hy⟩ c)).SameCycle
        (hp.monodromy (.mk α) (ν.symm i)) (hp.monodromy (.mk α) (ν.symm j)) := by
  subst hσ hg
  rw [hp.monodromyPerm_fundamentalGroupMulEquivOfPath_symm, sameCycle_permCongr_iff,
    sameCycle_permCongr_iff, Equiv.symm_symm, coveringFiberEquiv_apply, coveringFiberEquiv_apply]

include hy in
/-- The endpoint of a lift of a path from the basepoint into `S` lies over `S`. -/
private theorem monodromy_mem_preimage (e : p ⁻¹' {basePt}) :
    (hp.monodromy (.mk α) e : E) ∈ p ⁻¹' S := by
  rw [Set.mem_preimage, (hp.monodromy (.mk α) e).2]
  exact hy

include hp in
/-- The preimage of an open set is locally path connected, being open in the total space of a
cover of a locally path-connected space. -/
private theorem locallyPathConnectedSpace_preimage (hS : IsOpen S) :
    LocallyPathConnectedSpace (p ⁻¹' S) := by
  have := hp.isLocalHomeomorph.locallyPathConnectedSpace
  exact (hS.preimage hp.continuous).locallyPathConnectedSpace

/-- The cycles of `σ` are the connected components of `p ⁻¹' S`, when `σ` is the monodromy of the
transport of a generator of `π₁(S, y)`. -/
private def sameCycleQuotientEquivConnectedComponents (hS : IsOpen S) (hS' : IsPathConnected S)
    (hc : Subgroup.zpowers c = ⊤) (hσ : σ = ν.permCongr (hp.monodromyPerm basePt g))
    (hg : (FundamentalGroup.fundamentalGroupMulEquivOfPath α).symm
      (FundamentalGroup.map ⟨Subtype.val, continuous_subtype_val⟩ ⟨y, hy⟩ c) = g) :
    Quotient (SameCycle.setoid σ) ≃ ConnectedComponents (p ⁻¹' S) :=
  haveI := locallyPathConnectedSpace_preimage hp hS
  ((Quotient.congr (ν.symm.trans (coveringFiberEquiv hp (.mk α))) fun i j => by
      rw [Equiv.trans_apply, Equiv.trans_apply, coveringFiberEquiv_apply,
        coveringFiberEquiv_apply]
      exact sameCycle_iff_of_transport hp ν hy hσ hg i j).trans
    (hp.sameCycleQuotientEquivZerothHomotopy hS' hy hc)).trans
    connectedComponentsEquivZerothHomotopy.symm

private theorem sameCycleQuotientEquivConnectedComponents_mk (hS : IsOpen S)
    (hS' : IsPathConnected S) (hc : Subgroup.zpowers c = ⊤)
    (hσ : σ = ν.permCongr (hp.monodromyPerm basePt g))
    (hg : (FundamentalGroup.fundamentalGroupMulEquivOfPath α).symm
      (FundamentalGroup.map ⟨Subtype.val, continuous_subtype_val⟩ ⟨y, hy⟩ c) = g) (i : Fin n) :
    sameCycleQuotientEquivConnectedComponents hp ν hy hS hS' hc hσ hg (Quotient.mk _ i) =
      ConnectedComponents.mk
        ⟨hp.monodromy (.mk α) (ν.symm i), monodromy_mem_preimage hp hy (ν.symm i)⟩ := by
  have := locallyPathConnectedSpace_preimage hp hS
  simp only [sameCycleQuotientEquivConnectedComponents, Equiv.trans_apply, Quotient.congr_mk,
    coveringFiberEquiv_apply]
  rw [hp.sameCycleQuotientEquivZerothHomotopy_mk, connectedComponentsEquivZerothHomotopy_symm_apply]
  -- Mathlib states the last value as the quotient class `⟦x⟧`, which is `ConnectedComponents.mk x`
  -- by definition.
  rfl

end Local

/-! ### The puncture `0` -/

/-- **`σ0` is the local monodromy at `0`.** Two sheets lie in the same cycle of the first
permutation `σ0` of the monodromy triple exactly when the endpoints of their lifts of `αZero`
lie in the same cycle of the monodromy of `δZero`, a generator of the fundamental group of the
punctured neighborhood of `0`. -/
theorem _root_.IsCoveringMap.sameCycle_monodromyTriple_σ0_iff (i j : Fin n) :
    (hp.monodromyTriple ν).σ0.SameCycle i j ↔
      (hp.monodromyPerm (zeroBasePt : ThricePuncturedSphere)
          (FundamentalGroup.map ⟨Subtype.val, continuous_subtype_val⟩ zeroBasePt
            (FundamentalGroup.fromPath (.mk δZero)))).SameCycle
        (hp.monodromy (.mk αZero) (ν.symm i)) (hp.monodromy (.mk αZero) (ν.symm j)) :=
  sameCycle_iff_of_transport hp ν zeroBasePt.2 (hp.monodromyTriple_σ0 ν)
    transport_δZero_eq_periph0 i j

/-- **Cycles of `σ0` are the components over `0`, pointwise.** Two sheets lie in the same cycle of
`σ0` exactly when the endpoints of their lifts of `αZero` are joined by a path inside the
preimage of the punctured neighborhood of `0`. -/
theorem _root_.IsCoveringMap.sameCycle_monodromyTriple_σ0_iff_joinedIn (i j : Fin n) :
    (hp.monodromyTriple ν).σ0.SameCycle i j ↔
      JoinedIn (p ⁻¹' puncturedNeighborhoodZero)
        (hp.monodromy (.mk αZero) (ν.symm i) : E) (hp.monodromy (.mk αZero) (ν.symm j)) := by
  rw [hp.sameCycle_monodromyTriple_σ0_iff,
    hp.sameCycle_monodromyPerm_iff_joinedIn_preimage zeroBasePt.2 zpowers_δZero]

/-- The endpoint of a lift of `αZero` lies over the punctured neighborhood of `0`. -/
theorem _root_.IsCoveringMap.monodromy_αZero_mem_preimage (e : p ⁻¹' {basePt}) :
    (hp.monodromy (.mk αZero) e : E) ∈ p ⁻¹' puncturedNeighborhoodZero :=
  monodromy_mem_preimage hp zeroBasePt.2 e

/-- **The points over `0`.** The cycles of the first permutation `σ0` of the monodromy
triple are in bijection with the connected components of the preimage of the punctured
neighborhood `{z | ‖z‖ < 1/2}` of `0`. The cycle of a sheet `i` goes to the component of
the endpoint of the lift of `αZero` starting at the point numbered `i`
(`IsCoveringMap.sameCycleQuotientσ0EquivConnectedComponents_mk`). -/
def _root_.IsCoveringMap.sameCycleQuotientσ0EquivConnectedComponents :
    Quotient (SameCycle.setoid (hp.monodromyTriple ν).σ0) ≃
      ConnectedComponents (p ⁻¹' puncturedNeighborhoodZero) :=
  sameCycleQuotientEquivConnectedComponents hp ν zeroBasePt.2 isOpen_puncturedNeighborhoodZero
    isPathConnected_puncturedNeighborhoodZero zpowers_δZero (hp.monodromyTriple_σ0 ν)
    transport_δZero_eq_periph0

/-- The cycle of the sheet `i` goes to the connected component of the endpoint of the lift of
`αZero` starting at the point numbered `i`. -/
@[simp]
theorem _root_.IsCoveringMap.sameCycleQuotientσ0EquivConnectedComponents_mk (i : Fin n) :
    hp.sameCycleQuotientσ0EquivConnectedComponents ν (Quotient.mk _ i) =
      ConnectedComponents.mk
        ⟨hp.monodromy (.mk αZero) (ν.symm i), hp.monodromy_αZero_mem_preimage (ν.symm i)⟩ :=
  sameCycleQuotientEquivConnectedComponents_mk hp ν zeroBasePt.2 isOpen_puncturedNeighborhoodZero
    isPathConnected_puncturedNeighborhoodZero zpowers_δZero (hp.monodromyTriple_σ0 ν)
    transport_δZero_eq_periph0 i

/-! ### The puncture `1` -/

/-- **`σ1` is the local monodromy at `1`.** Two sheets lie in the same cycle of the second
permutation `σ1` of the monodromy triple exactly when the endpoints of their lifts of `αOne`
lie in the same cycle of the monodromy of `δOne`, a generator of the fundamental group of the
punctured neighborhood of `1`. -/
theorem _root_.IsCoveringMap.sameCycle_monodromyTriple_σ1_iff (i j : Fin n) :
    (hp.monodromyTriple ν).σ1.SameCycle i j ↔
      (hp.monodromyPerm (oneBasePt : ThricePuncturedSphere)
          (FundamentalGroup.map ⟨Subtype.val, continuous_subtype_val⟩ oneBasePt
            (FundamentalGroup.fromPath (.mk δOne)))).SameCycle
        (hp.monodromy (.mk αOne) (ν.symm i)) (hp.monodromy (.mk αOne) (ν.symm j)) :=
  sameCycle_iff_of_transport hp ν oneBasePt.2 (hp.monodromyTriple_σ1 ν)
    transport_δOne_eq_periph1 i j

/-- **Cycles of `σ1` are the components over `1`, pointwise.** Two sheets lie in the same cycle of
`σ1` exactly when the endpoints of their lifts of `αOne` are joined by a path inside the
preimage of the punctured neighborhood of `1`. -/
theorem _root_.IsCoveringMap.sameCycle_monodromyTriple_σ1_iff_joinedIn (i j : Fin n) :
    (hp.monodromyTriple ν).σ1.SameCycle i j ↔
      JoinedIn (p ⁻¹' puncturedNeighborhoodOne)
        (hp.monodromy (.mk αOne) (ν.symm i) : E) (hp.monodromy (.mk αOne) (ν.symm j)) := by
  rw [hp.sameCycle_monodromyTriple_σ1_iff,
    hp.sameCycle_monodromyPerm_iff_joinedIn_preimage oneBasePt.2 zpowers_δOne]

/-- The endpoint of a lift of `αOne` lies over the punctured neighborhood of `1`. -/
theorem _root_.IsCoveringMap.monodromy_αOne_mem_preimage (e : p ⁻¹' {basePt}) :
    (hp.monodromy (.mk αOne) e : E) ∈ p ⁻¹' puncturedNeighborhoodOne :=
  monodromy_mem_preimage hp oneBasePt.2 e

/-- **The points over `1`.** The cycles of the second permutation `σ1` of the monodromy
triple are in bijection with the connected components of the preimage of the punctured
neighborhood `{z | ‖z - 1‖ < 1/2}` of `1`. The cycle of a sheet `i` goes to the component of
the endpoint of the lift of `αOne` starting at the point numbered `i`
(`IsCoveringMap.sameCycleQuotientσ1EquivConnectedComponents_mk`). -/
def _root_.IsCoveringMap.sameCycleQuotientσ1EquivConnectedComponents :
    Quotient (SameCycle.setoid (hp.monodromyTriple ν).σ1) ≃
      ConnectedComponents (p ⁻¹' puncturedNeighborhoodOne) :=
  sameCycleQuotientEquivConnectedComponents hp ν oneBasePt.2 isOpen_puncturedNeighborhoodOne
    isPathConnected_puncturedNeighborhoodOne zpowers_δOne (hp.monodromyTriple_σ1 ν)
    transport_δOne_eq_periph1

/-- The cycle of the sheet `i` goes to the connected component of the endpoint of the lift of
`αOne` starting at the point numbered `i`. -/
@[simp]
theorem _root_.IsCoveringMap.sameCycleQuotientσ1EquivConnectedComponents_mk (i : Fin n) :
    hp.sameCycleQuotientσ1EquivConnectedComponents ν (Quotient.mk _ i) =
      ConnectedComponents.mk
        ⟨hp.monodromy (.mk αOne) (ν.symm i), hp.monodromy_αOne_mem_preimage (ν.symm i)⟩ :=
  sameCycleQuotientEquivConnectedComponents_mk hp ν oneBasePt.2 isOpen_puncturedNeighborhoodOne
    isPathConnected_puncturedNeighborhoodOne zpowers_δOne (hp.monodromyTriple_σ1 ν)
    transport_δOne_eq_periph1 i

/-! ### The puncture `∞` -/

/-- **`σinf` is the local monodromy at `∞`.** Two sheets lie in the same cycle of the third
permutation `σinf` of the monodromy triple exactly when the endpoints of their lifts of `αPlus`
lie in the same cycle of the monodromy of `δInf`, a generator of the fundamental group of the
punctured neighborhood of `∞`. -/
theorem _root_.IsCoveringMap.sameCycle_monodromyTriple_σinf_iff (i j : Fin n) :
    (hp.monodromyTriple ν).σinf.SameCycle i j ↔
      (hp.monodromyPerm pPlus
          (FundamentalGroup.map ⟨Subtype.val, continuous_subtype_val⟩ infBasePt
            (FundamentalGroup.fromPath (.mk δInf)))).SameCycle
        (hp.monodromy (.mk αPlus) (ν.symm i)) (hp.monodromy (.mk αPlus) (ν.symm j)) :=
  sameCycle_iff_of_transport hp ν infBasePt.2 (hp.monodromyTriple_σinf ν)
    transport_δInf_eq_periphInf i j

/-- **Cycles of `σinf` are the components over `∞`, pointwise.** Two sheets lie in the same cycle of
`σinf` exactly when the endpoints of their lifts of `αPlus` are joined by a path inside the
preimage of the punctured neighborhood of `∞`. -/
theorem _root_.IsCoveringMap.sameCycle_monodromyTriple_σinf_iff_joinedIn (i j : Fin n) :
    (hp.monodromyTriple ν).σinf.SameCycle i j ↔
      JoinedIn (p ⁻¹' puncturedNeighborhoodInf)
        (hp.monodromy (.mk αPlus) (ν.symm i) : E) (hp.monodromy (.mk αPlus) (ν.symm j)) := by
  rw [hp.sameCycle_monodromyTriple_σinf_iff,
    hp.sameCycle_monodromyPerm_iff_joinedIn_preimage infBasePt.2 zpowers_δInf]

/-- The endpoint of a lift of `αPlus` lies over the punctured neighborhood of `∞`. -/
theorem _root_.IsCoveringMap.monodromy_αPlus_mem_preimage (e : p ⁻¹' {basePt}) :
    (hp.monodromy (.mk αPlus) e : E) ∈ p ⁻¹' puncturedNeighborhoodInf :=
  monodromy_mem_preimage hp infBasePt.2 e

/-- **The points over `∞`.** The cycles of the third permutation `σinf` of the monodromy
triple are in bijection with the connected components of the preimage of the punctured
neighborhood `{z | 2 < ‖z‖}` of `∞`. The cycle of a sheet `i` goes to the component of
the endpoint of the lift of `αPlus` starting at the point numbered `i`
(`IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents_mk`). -/
def _root_.IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents :
    Quotient (SameCycle.setoid (hp.monodromyTriple ν).σinf) ≃
      ConnectedComponents (p ⁻¹' puncturedNeighborhoodInf) :=
  sameCycleQuotientEquivConnectedComponents hp ν infBasePt.2 isOpen_puncturedNeighborhoodInf
    isPathConnected_puncturedNeighborhoodInf zpowers_δInf (hp.monodromyTriple_σinf ν)
    transport_δInf_eq_periphInf

/-- The cycle of the sheet `i` goes to the connected component of the endpoint of the lift of
`αPlus` starting at the point numbered `i`. -/
@[simp]
theorem _root_.IsCoveringMap.sameCycleQuotientσinfEquivConnectedComponents_mk (i : Fin n) :
    hp.sameCycleQuotientσinfEquivConnectedComponents ν (Quotient.mk _ i) =
      ConnectedComponents.mk
        ⟨hp.monodromy (.mk αPlus) (ν.symm i), hp.monodromy_αPlus_mem_preimage (ν.symm i)⟩ :=
  sameCycleQuotientEquivConnectedComponents_mk hp ν infBasePt.2 isOpen_puncturedNeighborhoodInf
    isPathConnected_puncturedNeighborhoodInf zpowers_δInf (hp.monodromyTriple_σinf ν)
    transport_δInf_eq_periphInf i

end TauCeti
