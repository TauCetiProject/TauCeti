module

public import Mathlib.GroupTheory.FreeGroup.IsFreeGroup
public import TauCeti.AlgebraicTopology.FundamentalGroup.CoverGeneration
public import TauCeti.AlgebraicTopology.ThricePuncturedSphere.PuncturedHalfPlanes

import TauCeti.AlgebraicTopology.FundamentalGroup.VanKampen

/-!
# The fundamental group of the thrice-punctured sphere

The thrice-punctured sphere `ℂ ∖ {0, 1}` is the union of the open sets `A = {re z < 1}` and
`B = {0 < re z}`. Both are path connected, and so is their intersection, the open strip
`0 < re z < 1`, which contains the basepoint `1/2`. By the generation half of the Seifert--van
Kampen theorem (`TauCeti.FundamentalGroup.range_map_subtypeVal_sup_eq_top`), `π₁(ℂ ∖ {0, 1}, 1/2)`
is generated by the images of `π₁(A, 1/2)` and `π₁(B, 1/2)`. These are infinite cyclic, generated
by the classes of the peripheral loops `γ0` and `γ1`, whose images are `periph0` and `periph1`.
Hence `periph0` and `periph1` generate `π₁(ℂ ∖ {0, 1}, 1/2)`.

In particular a homomorphism out of `π₁(ℂ ∖ {0, 1}, 1/2)` is determined by its values on `periph0`
and `periph1`. For the monodromy representation of a cover this says that the monodromy group, the
image of `π₁`, is generated by the monodromy permutations around `0` and around `1`, which is how
a cover's permutation triple sees the transitivity of its monodromy.

The full Seifert--van Kampen theorem for the same cover (`TauCeti.vanKampenEquiv`, which applies
because the strip `A ∩ B` is simply connected) identifies `π₁(ℂ ∖ {0, 1}, 1/2)` with the free
product `π₁(A, 1/2) ∗ π₁(B, 1/2) ≃* ℤ ∗ ℤ`, so `π₁(ℂ ∖ {0, 1}, 1/2)` is the free group on the two
generators `periph0` and `periph1`. The element `periphInf = (periph1 * periph0)⁻¹` is then the
image of `(of 1 * of 0)⁻¹`, and any two elements of a group are the images of `periph0` and
`periph1` under a unique homomorphism. This free universal property is how a permutation triple
is turned into an action of the fundamental group.

## Main declarations

* `TauCeti.ThricePuncturedSphere.closure_periph0_periph1`: `periph0` and `periph1` generate
  `π₁(ℂ ∖ {0, 1}, 1/2)`.
* `TauCeti.ThricePuncturedSphere.fundamentalGroup_hom_ext`: a homomorphism out of
  `π₁(ℂ ∖ {0, 1}, 1/2)` is determined by its values on `periph0` and `periph1`.
* `TauCeti.ThricePuncturedSphere.fundamentalGroupMulEquivFreeGroup`:
  `π₁(ℂ ∖ {0, 1}, 1/2) ≃* FreeGroup (Fin 2)`, sending `periph0` to `of 0` and `periph1` to `of 1`.
* `TauCeti.ThricePuncturedSphere.peripheralBasis`: `(periph0, periph1)` as a free basis of
  `π₁(ℂ ∖ {0, 1}, 1/2)`, whose `FreeGroupBasis.lift` realizes any pair of values.

## References

* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, Theorem 1.20.
-/

public section

open Set
open scoped Monoid.Coprod

namespace TauCeti

namespace ThricePuncturedSphere

/-- The image of `π₁(A, 1/2)` in `π₁(ℂ ∖ {0, 1}, 1/2)` is generated by `periph0`. -/
private theorem range_map_leftOpen :
    ((FundamentalGroup.map (ContinuousMap.subtypeVal leftOpen)
      ⟨basePt, basePt_mem_leftOpen⟩).range :
        Subgroup (FundamentalGroup ThricePuncturedSphere basePt)) =
      Subgroup.zpowers periph0 := by
  rw [MonoidHom.range_eq_map, ← zpowers_periph0Left, MonoidHom.map_zpowers]
  exact congrArg Subgroup.zpowers map_val_periph0Left

/-- The image of `π₁(B, 1/2)` in `π₁(ℂ ∖ {0, 1}, 1/2)` is generated by `periph1`. -/
private theorem range_map_rightOpen :
    ((FundamentalGroup.map (ContinuousMap.subtypeVal rightOpen)
      ⟨basePt, basePt_mem_rightOpen⟩).range :
        Subgroup (FundamentalGroup ThricePuncturedSphere basePt)) =
      Subgroup.zpowers periph1 := by
  rw [MonoidHom.range_eq_map, ← zpowers_periph1Right, MonoidHom.map_zpowers]
  exact congrArg Subgroup.zpowers map_val_periph1Right

/-- **The peripheral elements `periph0` and `periph1` generate `π₁(ℂ ∖ {0, 1}, 1/2)`.** -/
@[simp]
theorem closure_periph0_periph1 :
    Subgroup.closure {periph0, periph1} = ⊤ := by
  have h := FundamentalGroup.range_map_subtypeVal_sup_eq_top
    (by rw [isOpen_leftOpen.interior_eq, isOpen_rightOpen.interior_eq, leftOpen_union_rightOpen])
    isPathConnected_leftOpen isPathConnected_rightOpen isPathConnected_leftOpen_inter_rightOpen
    basePt_mem_leftOpen basePt_mem_rightOpen
  rw [range_map_leftOpen, range_map_rightOpen] at h
  rw [eq_top_iff, ← h]
  exact sup_le (Subgroup.zpowers_le.2 (Subgroup.subset_closure (mem_insert _ _)))
    (Subgroup.zpowers_le.2 (Subgroup.subset_closure (mem_insert_of_mem _ rfl)))

/-- A homomorphism out of `π₁(ℂ ∖ {0, 1}, 1/2)` is determined by its values on the peripheral
elements `periph0` and `periph1`. -/
@[ext]
theorem fundamentalGroup_hom_ext {G : Type*} [Monoid G]
    {f g : FundamentalGroup ThricePuncturedSphere basePt →* G}
    (h0 : f periph0 = g periph0) (h1 : f periph1 = g periph1) : f = g :=
  MonoidHom.eq_of_eqOn_dense closure_periph0_periph1 (by
    rintro _ (rfl | rfl)
    exacts [h0, h1])

/-- The three peripheral elements `periph0`, `periph1` and `periphInf` generate
`π₁(ℂ ∖ {0, 1}, 1/2)`. They do not generate it freely: they satisfy
`periphInf * periph1 * periph0 = 1`. -/
theorem closure_periph0_periph1_periphInf :
    Subgroup.closure {periph0, periph1, periphInf} = ⊤ :=
  eq_top_iff.2 <| closure_periph0_periph1.ge.trans <| Subgroup.closure_mono <|
    insert_subset_insert (singleton_subset_iff.2 (mem_insert _ _))

/-! ### The free group on the peripheral elements -/

/-- The Seifert--van Kampen isomorphism `π₁(A, 1/2) ∗ π₁(B, 1/2) ≃* π₁(ℂ ∖ {0, 1}, 1/2)` for the
standard cover `A = {re z < 1}`, `B = {0 < re z}`. -/
private noncomputable def standardCoverMulEquiv :
    (FundamentalGroup leftOpen ⟨basePt, basePt_mem_leftOpen⟩ ∗
      FundamentalGroup rightOpen ⟨basePt, basePt_mem_rightOpen⟩) ≃*
      FundamentalGroup ThricePuncturedSphere basePt :=
  vanKampenEquiv
    (by rw [isOpen_leftOpen.interior_eq, isOpen_rightOpen.interior_eq, leftOpen_union_rightOpen])
    isPathConnected_leftOpen isPathConnected_rightOpen isSimplyConnected_leftOpen_inter_rightOpen
    basePt_mem_leftOpen basePt_mem_rightOpen

private theorem standardCoverMulEquiv_apply
    (g : FundamentalGroup leftOpen ⟨basePt, basePt_mem_leftOpen⟩ ∗
      FundamentalGroup rightOpen ⟨basePt, basePt_mem_rightOpen⟩) :
    standardCoverMulEquiv g =
      vanKampenLift leftOpen rightOpen basePt basePt_mem_leftOpen basePt_mem_rightOpen g :=
  DFunLike.congr_fun (vanKampenEquiv_toMonoidHom _ _ _ _ _ _) g

private theorem standardCoverMulEquiv_symm_periph0 :
    standardCoverMulEquiv.symm periph0 = Monoid.Coprod.inl periph0Left := by
  rw [MulEquiv.symm_apply_eq, standardCoverMulEquiv_apply, vanKampenLift_apply_inl]
  -- `map_val_periph0Left` states the inclusion as `⟨Subtype.val, _⟩`, which is
  -- `ContinuousMap.subtypeVal` unfolded, so `rw` cannot match it.
  exact map_val_periph0Left.symm

private theorem standardCoverMulEquiv_symm_periph1 :
    standardCoverMulEquiv.symm periph1 = Monoid.Coprod.inr periph1Right := by
  rw [MulEquiv.symm_apply_eq, standardCoverMulEquiv_apply, vanKampenLift_apply_inr]
  -- `map_val_periph1Right` states the inclusion as `⟨Subtype.val, _⟩`, which is
  -- `ContinuousMap.subtypeVal` unfolded, so `rw` cannot match it.
  exact map_val_periph1Right.symm

/-- The homomorphism `π₁(ℂ ∖ {0, 1}, 1/2) →* FreeGroup (Fin 2)` read through the Seifert--van
Kampen isomorphism, sending the generator `periph0Left` of `π₁(A, 1/2) ≃* ℤ` to `of 0` and the
generator `periph1Right` of `π₁(B, 1/2) ≃* ℤ` to `of 1`. -/
private noncomputable def toFreeGroup :
    FundamentalGroup ThricePuncturedSphere basePt →* FreeGroup (Fin 2) :=
  (Monoid.Coprod.lift
      ((zpowersHom _ (FreeGroup.of 0)).comp leftOpenFundamentalGroupMulEquivInt.toMonoidHom)
      ((zpowersHom _ (FreeGroup.of 1)).comp rightOpenFundamentalGroupMulEquivInt.toMonoidHom)).comp
    standardCoverMulEquiv.symm.toMonoidHom

private theorem toFreeGroup_periph0 : toFreeGroup periph0 = FreeGroup.of 0 := by
  simp [toFreeGroup, standardCoverMulEquiv_symm_periph0]

private theorem toFreeGroup_periph1 : toFreeGroup periph1 = FreeGroup.of 1 := by
  simp [toFreeGroup, standardCoverMulEquiv_symm_periph1]

/-- **The fundamental group of the thrice-punctured sphere is free of rank two**:
`π₁(ℂ ∖ {0, 1}, 1/2) ≃* FreeGroup (Fin 2)`, sending the peripheral elements `periph0` and
`periph1` to the generators `of 0` and `of 1`. -/
noncomputable def fundamentalGroupMulEquivFreeGroup :
    FundamentalGroup ThricePuncturedSphere basePt ≃* FreeGroup (Fin 2) :=
  MonoidHom.toMulEquiv toFreeGroup (FreeGroup.lift ![periph0, periph1])
    (by ext <;> simp [toFreeGroup_periph0, toFreeGroup_periph1])
    (FreeGroup.ext_hom _ _ fun i => by
      fin_cases i <;> simp [toFreeGroup_periph0, toFreeGroup_periph1])

/-- The isomorphism `π₁(ℂ ∖ {0, 1}, 1/2) ≃* FreeGroup (Fin 2)` sends `periph0` to `of 0`. -/
@[simp]
theorem fundamentalGroupMulEquivFreeGroup_periph0 :
    fundamentalGroupMulEquivFreeGroup periph0 = FreeGroup.of 0 :=
  toFreeGroup_periph0

/-- The isomorphism `π₁(ℂ ∖ {0, 1}, 1/2) ≃* FreeGroup (Fin 2)` sends `periph1` to `of 1`. -/
@[simp]
theorem fundamentalGroupMulEquivFreeGroup_periph1 :
    fundamentalGroupMulEquivFreeGroup periph1 = FreeGroup.of 1 :=
  toFreeGroup_periph1

/-- The isomorphism `π₁(ℂ ∖ {0, 1}, 1/2) ≃* FreeGroup (Fin 2)` sends the peripheral element at
infinity `periphInf` to `(of 1 * of 0)⁻¹`. -/
@[simp]
theorem fundamentalGroupMulEquivFreeGroup_periphInf :
    fundamentalGroupMulEquivFreeGroup periphInf = (FreeGroup.of 1 * FreeGroup.of 0)⁻¹ := by
  rw [periphInf_def, map_inv, map_mul, fundamentalGroupMulEquivFreeGroup_periph0,
    fundamentalGroupMulEquivFreeGroup_periph1]

/-- The generator `of 0` of `FreeGroup (Fin 2)` corresponds to `periph0`. -/
@[simp]
theorem fundamentalGroupMulEquivFreeGroup_symm_of_zero :
    fundamentalGroupMulEquivFreeGroup.symm (FreeGroup.of 0) = periph0 := by
  rw [MulEquiv.symm_apply_eq, fundamentalGroupMulEquivFreeGroup_periph0]

/-- The generator `of 1` of `FreeGroup (Fin 2)` corresponds to `periph1`. -/
@[simp]
theorem fundamentalGroupMulEquivFreeGroup_symm_of_one :
    fundamentalGroupMulEquivFreeGroup.symm (FreeGroup.of 1) = periph1 := by
  rw [MulEquiv.symm_apply_eq, fundamentalGroupMulEquivFreeGroup_periph1]

/-- The peripheral elements `periph0` and `periph1`, as a free basis of `π₁(ℂ ∖ {0, 1}, 1/2)`.
Its `FreeGroupBasis.lift` sends a pair of elements of any group to the unique homomorphism taking
`periph0` and `periph1` to them. -/
noncomputable def peripheralBasis :
    FreeGroupBasis (Fin 2) (FundamentalGroup ThricePuncturedSphere basePt) :=
  .ofRepr fundamentalGroupMulEquivFreeGroup

/-- The isomorphism with `FreeGroup (Fin 2)` given by `peripheralBasis` is
`fundamentalGroupMulEquivFreeGroup`. -/
@[simp]
theorem peripheralBasis_repr : peripheralBasis.repr = fundamentalGroupMulEquivFreeGroup :=
  (rfl)

/-- The first element of `peripheralBasis` is `periph0`. -/
@[simp]
theorem peripheralBasis_zero : peripheralBasis 0 = periph0 :=
  peripheralBasis.repr.injective <| by
    rw [FreeGroupBasis.repr_apply_coe, peripheralBasis_repr,
      fundamentalGroupMulEquivFreeGroup_periph0]

/-- The second element of `peripheralBasis` is `periph1`. -/
@[simp]
theorem peripheralBasis_one : peripheralBasis 1 = periph1 :=
  peripheralBasis.repr.injective <| by
    rw [FreeGroupBasis.repr_apply_coe, peripheralBasis_repr,
      fundamentalGroupMulEquivFreeGroup_periph1]

/-- `π₁(ℂ ∖ {0, 1}, 1/2)` is a free group. -/
instance : IsFreeGroup (FundamentalGroup ThricePuncturedSphere basePt) :=
  peripheralBasis.isFreeGroup

end ThricePuncturedSphere

end TauCeti
