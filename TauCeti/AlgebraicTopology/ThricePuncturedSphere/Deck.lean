module

public import TauCeti.AlgebraicTopology.ThricePuncturedSphere.Classification
public import TauCeti.Combinatorics.PermutationTriple.Examples

/-!
# Deck transformations of covers of the thrice-punctured sphere

Let `c` be a connected cover of the thrice-punctured sphere `U = ℂ ∖ {0, 1}` whose fibre over the
basepoint `b = 1/2` is numbered by `Fin n`, and let `t` be its monodromy triple. A deck
transformation of `c` permutes the fibre over `b`, hence permutes the labels
(`TauCeti.ConnectedFiberNumberedCover.deckPerm`): the label `i` goes to the label of the image of
the point labelled `i`. This file proves that this identifies the deck group of `c` with the
automorphism group of `t`, **as a subgroup of `Equiv.Perm (Fin n)`**:

  `deck p ≃* t.automorphismGroup`.

The general input is that, over a path-connected, locally path-connected base, the permutations of
the labels induced by deck transformations are exactly the permutations commuting with the
numbered monodromy (`TauCeti.ConnectedFiberNumberedCover.range_deckPerm`). Over `U` the numbered
monodromy is generated by the components of `t`, and the permutations commuting with them form
`t.automorphismGroup` (`TauCeti.PermutationTriple.automorphismGroup_eq_centralizer_monodromyGroup`).

No `ᵐᵒᵖ` appears. Deck transformations act on the fibre on the left and commute with monodromy,
and the identification sends a deck transformation to the permutation it induces on the labels,
not to a monodromy element. The numbering is what makes the target a concrete subgroup: relabelling
the fibre by `τ` conjugates both sides by `τ`
(`TauCeti.ConnectedFiberNumberedCover.deckPerm_smul`,
`TauCeti.PermutationTriple.automorphismGroup_smul`), so only the abstract isomorphism type of the
deck group is an invariant of the unnumbered cover.

The two threaded examples are computed on the action. For the cover with triple
`TauCeti.PermutationTriple.cyclicTriple n`, the monodromy of `z ↦ zⁿ`, and for the degree-four
cover with triple `TauCeti.PermutationTriple.torusTriple`, the permutations of the labels induced
by deck transformations are exactly the powers of the rotation `i ↦ i + 1`. The deck groups are
therefore cyclic, of orders `n` and `4`, and act transitively on the fibre; they act freely, as the
deck group of every connected cover does (`TauCeti.Deck.fiber_stabilizer_eq_bot`).

## Main declarations

* `TauCeti.ConnectedFiberNumberedCover.range_deckPerm_eq_automorphismGroup`: the permutations of
  the labels induced by deck transformations form the automorphism group of the triple.
* `TauCeti.ConnectedFiberNumberedCover.deckMulEquiv`: **the deck group of a numbered cover of `U`
  is the automorphism group of its triple**, with `coe_deckMulEquiv_apply` and
  `deckMulEquiv_symm_smul` recording which permutation corresponds to which deck transformation.
* `TauCeti.ConnectedFiberNumberedCover.range_deckPerm_of_connectedTriple_eq_cyclicTriple`,
  `TauCeti.ConnectedFiberNumberedCover.range_deckPerm_of_connectedTriple_eq_torusTriple`: the deck
  actions of the two examples, with their cyclicity, their orders and their transitivity on the
  fibre.

## References

* E. Girondo and G. González-Diez, *Introduction to Compact Riemann Surfaces and Dessins
  d'Enfants*, London Mathematical Society Student Texts 79, Cambridge University Press, 2012,
  §2.7 (the monodromy and the covering group of a morphism).
* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, §1.3 (deck transformations
  and the lifting criterion).
-/

public section

open Equiv

namespace TauCeti

open ThricePuncturedSphere PermutationTriple

variable {n : ℕ}

namespace ConnectedFiberNumberedCover

variable (c : ConnectedFiberNumberedCover (X := TopCat.of ThricePuncturedSphere) basePt n)

/-- **The permutations of the labels induced by deck transformations of a numbered cover of
`ℂ ∖ {0, 1}` form the automorphism group of its triple.** -/
theorem range_deckPerm_eq_automorphismGroup :
    c.deckPerm.range = (c.connectedTriple : PermutationTriple n).automorphismGroup := by
  rw [range_deckPerm, automorphismGroup_eq_centralizer_monodromyGroup, coe_connectedTriple,
    IsCoveringMap.monodromyGroup_monodromyTriple, MonoidHom.range_comp]

/-- **The deck group of a numbered cover of `ℂ ∖ {0, 1}` is the automorphism group of its
triple.** A deck transformation goes to the permutation it induces on the labels of the fibre over
`1/2` (`coe_deckMulEquiv_apply`). -/
noncomputable def deckMulEquiv :
    deck ⇑c.cover.proj ≃* (c.connectedTriple : PermutationTriple n).automorphismGroup :=
  (MonoidHom.ofInjective c.deckPerm_injective).trans
    (MulEquiv.subgroupCongr c.range_deckPerm_eq_automorphismGroup)

/-- The automorphism of the triple attached to a deck transformation is the permutation it induces
on the labels. -/
@[simp]
theorem coe_deckMulEquiv_apply (φ : deck ⇑c.cover.proj) :
    (c.deckMulEquiv φ : Perm (Fin n)) = c.deckPerm φ :=
  (rfl)

/-- The deck transformation attached to an automorphism `τ` of the triple sends the point labelled
`i` to the point labelled `τ i`. -/
@[simp]
theorem deckMulEquiv_symm_smul (τ : (c.connectedTriple : PermutationTriple n).automorphismGroup)
    (i : Fin n) : c.deckMulEquiv.symm τ • c.ν.symm i = c.ν.symm ((τ : Perm (Fin n)) i) := by
  rw [← c.ν.symm_apply_apply (c.deckMulEquiv.symm τ • c.ν.symm i), ← deckPerm_apply,
    ← coe_deckMulEquiv_apply, MulEquiv.apply_symm_apply]

/-! ### The threaded examples

Both examples induce exactly the powers of the rotation `i ↦ i + 1` on the labels, and the deck
group is read off from that. -/

section Rotation

/-- When deck transformations induce exactly the powers of `g` on the labels, the deck group is
isomorphic to the group generated by `g`. -/
private noncomputable def deckMulEquivZPowers {g : Perm (Fin n)}
    (h : c.deckPerm.range = Subgroup.zpowers g) : deck ⇑c.cover.proj ≃* Subgroup.zpowers g :=
  (MonoidHom.ofInjective c.deckPerm_injective).trans (MulEquiv.subgroupCongr h)

variable {c} (h : c.deckPerm.range = Subgroup.zpowers (finRotate n))
include h

private theorem isCyclic_deck_of_range_deckPerm_eq : IsCyclic (deck ⇑c.cover.proj) :=
  (deckMulEquivZPowers c h).isCyclic.2 inferInstance

private theorem card_deck_of_range_deckPerm_eq : Nat.card (deck ⇑c.cover.proj) = n := by
  rw [Nat.card_congr (deckMulEquivZPowers c h).toEquiv, Nat.card_zpowers,
    orderOf_finRotate c.forgetNumbering.ne_zero]

private theorem isPretransitive_deck_of_range_deckPerm_eq :
    MulAction.IsPretransitive (deck ⇑c.cover.proj) (⇑c.cover.proj ⁻¹' {basePt}) := by
  rw [← isPretransitive_range_deckPerm_iff, h]
  exact isPretransitive_of_finRotate_mem (Subgroup.mem_zpowers _)

end Rotation

section Cyclic

variable {c} (hc : (c.connectedTriple : PermutationTriple n) = cyclicTriple n)
include hc

/-- The cover of `ℂ ∖ {0, 1}` with the triple of `z ↦ zⁿ`: its deck transformations induce
exactly the powers of the rotation `i ↦ i + 1` on the labels. -/
theorem range_deckPerm_of_connectedTriple_eq_cyclicTriple :
    c.deckPerm.range = Subgroup.zpowers (finRotate n) := by
  rw [range_deckPerm_eq_automorphismGroup, hc, automorphismGroup_cyclicTriple]

/-- The deck group of the cover of `ℂ ∖ {0, 1}` with the triple of `z ↦ zⁿ` is cyclic. -/
theorem isCyclic_deck_of_connectedTriple_eq_cyclicTriple : IsCyclic (deck ⇑c.cover.proj) :=
  isCyclic_deck_of_range_deckPerm_eq (range_deckPerm_of_connectedTriple_eq_cyclicTriple hc)

/-- The deck group of the cover of `ℂ ∖ {0, 1}` with the triple of `z ↦ zⁿ` has order `n`. -/
theorem card_deck_of_connectedTriple_eq_cyclicTriple : Nat.card (deck ⇑c.cover.proj) = n :=
  card_deck_of_range_deckPerm_eq (range_deckPerm_of_connectedTriple_eq_cyclicTriple hc)

/-- The deck group of the cover of `ℂ ∖ {0, 1}` with the triple of `z ↦ zⁿ` acts transitively on
the fibre over `1/2`. -/
theorem isPretransitive_deck_of_connectedTriple_eq_cyclicTriple :
    MulAction.IsPretransitive (deck ⇑c.cover.proj) (⇑c.cover.proj ⁻¹' {basePt}) :=
  isPretransitive_deck_of_range_deckPerm_eq (range_deckPerm_of_connectedTriple_eq_cyclicTriple hc)

end Cyclic

section Torus

variable {c : ConnectedFiberNumberedCover (X := TopCat.of ThricePuncturedSphere) basePt 4}
  (hc : (c.connectedTriple : PermutationTriple 4) = torusTriple)
include hc

/-- The degree-four cover of `ℂ ∖ {0, 1}` with the torus triple: its deck transformations induce
exactly the powers of the rotation `i ↦ i + 1` on the labels. -/
theorem range_deckPerm_of_connectedTriple_eq_torusTriple :
    c.deckPerm.range = Subgroup.zpowers (finRotate 4) := by
  rw [range_deckPerm_eq_automorphismGroup, hc, automorphismGroup_torusTriple,
    monodromyGroup_torusTriple]

/-- The deck group of the degree-four cover of `ℂ ∖ {0, 1}` with the torus triple is cyclic. -/
theorem isCyclic_deck_of_connectedTriple_eq_torusTriple : IsCyclic (deck ⇑c.cover.proj) :=
  isCyclic_deck_of_range_deckPerm_eq (range_deckPerm_of_connectedTriple_eq_torusTriple hc)

/-- The deck group of the degree-four cover of `ℂ ∖ {0, 1}` with the torus triple has order
`4`. -/
theorem card_deck_of_connectedTriple_eq_torusTriple : Nat.card (deck ⇑c.cover.proj) = 4 :=
  card_deck_of_range_deckPerm_eq (range_deckPerm_of_connectedTriple_eq_torusTriple hc)

/-- The deck group of the degree-four cover of `ℂ ∖ {0, 1}` with the torus triple acts transitively
on the fibre over `1/2`; it acts freely by `TauCeti.Deck.fiber_stabilizer_eq_bot`. -/
theorem isPretransitive_deck_of_connectedTriple_eq_torusTriple :
    MulAction.IsPretransitive (deck ⇑c.cover.proj) (⇑c.cover.proj ⁻¹' {basePt}) :=
  isPretransitive_deck_of_range_deckPerm_eq (range_deckPerm_of_connectedTriple_eq_torusTriple hc)

end Torus

end ConnectedFiberNumberedCover

end TauCeti
