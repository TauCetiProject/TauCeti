module

public import TauCeti.Algebra.Homology.DG.Algebra.KoszulTwist
public import TauCeti.RingTheory.GradedAlgebra.FreeGradedCommutative

/-!
# Sullivan algebras and minimality

A Sullivan algebra is a commutative differential graded algebra `(ΛV, d)` whose underlying algebra
is free graded-commutative on generators `x i` of positive degree, indexed by a well-ordered type,
such that the differential of each generator lies in the subalgebra generated by the earlier ones.
It is minimal when the differential of every generator is decomposable, a sum of products of two
elements of positive degree. Minimal Sullivan algebras are the minimal models of rational homotopy
theory: every connected commutative differential graded algebra over a field of characteristic
zero has one, unique up to isomorphism, and for a simply connected space of finite type its
generators are dual to the rational homotopy groups.

The well-ordering condition excludes free algebras whose differential is decomposable but which
admit no such order, such as `Λ(x, y, z)` on three generators of degree `1` with `dx = yz`,
`dy = zx`, `dz = xy`. Minimality is a condition on the differential, not on the generators: the
main result of this file characterises it through the indecomposables `Q(A) = A⁺ ⧸ A⁺ · A⁺`, whose
basis, when `2` is invertible in `K`, is given by the classes of the generators
(`TauCeti.IsFreeGradedCommutative.indecomposablesBasis`).

## Main definitions

* `TauCeti.IsSullivanAlgebra 𝒜 d x deg`: the generator and filtration conditions making `(A, d)` a
  Sullivan algebra on the generators `x i` of degrees `deg i`; the axioms of a differential on `d`
  are supplied separately as `TauCeti.IsDGAlgebra 𝒜 d`.
* `TauCeti.IsMinimalSullivanAlgebra 𝒜 d x deg`: moreover the differential of every generator lies
  in `A⁺ · A⁺`.

## Main results

* `TauCeti.IsDGAlgebra.map_positivePart_le` and
  `TauCeti.IsDGAlgebra.map_positivePart_mul_positivePart_le`: the differential of a differential
  graded algebra preserves the positive part and the decomposables, so it induces a map on the
  indecomposables.
* `TauCeti.IsSullivanAlgebra.isMinimal_iff`: a Sullivan algebra is minimal exactly when
  `d (A⁺) ⊆ A⁺ · A⁺`; equivalently, when `d (A) ⊆ A⁺ · A⁺`
  (`TauCeti.IsSullivanAlgebra.isMinimal_iff_range_le`), or when the differential induced on the
  indecomposables vanishes (`TauCeti.IsSullivanAlgebra.isMinimal_iff_indecomposables_map_eq_zero`).
* `MvPolynomial.isMinimalSullivanAlgebra_X`: a polynomial ring on well-ordered variables of even
  positive degrees, with zero differential, satisfies `TauCeti.IsMinimalSullivanAlgebra`.

## References

* J. W. Morgan, *The algebraic topology of smooth algebraic varieties*, Publ. Math. IHÉS 48
  (1978), Definitions 5.1 and 5.2 and the note after Definition 5.2.
* K. Hess, *Rational homotopy theory: a brief introduction*, in *Interactions between homotopy
  theory and algebra*, Contemp. Math. 436, 2007, Definition 1.10 and Example 1.12.
* Y. Félix, S. Halperin, J.-C. Thomas, *Rational homotopy theory*, Graduate Texts in Mathematics
  205, Springer, 2001, §12.
-/

public section

namespace TauCeti

variable {K A : Type*} [CommRing K] [Ring A] [Algebra K A] {𝒜 : ℤ → Submodule K A}
  {d : A →ₗ[K] A}

namespace IsDGAlgebra

variable [GradedAlgebra 𝒜]

/-- The differential of a differential graded algebra carries the positive part into itself. -/
theorem map_positivePart_le (hA : IsDGAlgebra 𝒜 d) : (positivePart 𝒜).map d ≤ positivePart 𝒜 :=
  TauCeti.map_positivePart_le zero_le_one hA.map_mem

/-- The differential of a differential graded algebra carries the decomposables `A⁺ · A⁺` into
themselves, by the Leibniz rule. -/
theorem map_positivePart_mul_positivePart_le (hA : IsDGAlgebra 𝒜 d) :
    (positivePart 𝒜 * positivePart 𝒜).map d ≤ positivePart 𝒜 * positivePart 𝒜 := by
  rw [Submodule.map_le_iff_le_comap, Submodule.mul_le]
  intro a ha b hb
  refine positivePart_le_iff
    (P := (positivePart 𝒜 * positivePart 𝒜).comap (d ∘ₗ LinearMap.mulRight K b)).2
    (fun p hp a ha => ?_) ha
  simp only [Submodule.mem_comap, LinearMap.comp_apply, LinearMap.mulRight_apply, hA.leibniz ha,
    Units.smul_def]
  exact add_mem (Submodule.mul_mem_mul (mem_positivePart_of_mem (by omega) (hA.map_mem ha)) hb)
    (zsmul_mem (Submodule.mul_mem_mul (mem_positivePart_of_mem hp ha)
      (hA.map_positivePart_le ⟨b, hb, rfl⟩)) _)

end IsDGAlgebra

variable {ι : Type*} [LinearOrder ι]

variable (𝒜) in
/-- The generator and filtration conditions of a **Sullivan algebra** `(A, d)` on the generators
`x i` of degrees `deg i`: `A` is free graded-commutative on the `x i`, every generator has positive
degree, and `d` sends each generator into the subalgebra generated by the earlier ones, for the
well-order of `ι`. The predicate does not require `d` to be a differential: together with
`IsDGAlgebra 𝒜 d`, which supplies degree `+1`, the Leibniz rule and `d² = 0`, it says that
`(A, d)` is a Sullivan algebra. -/
structure IsSullivanAlgebra [WellFoundedLT ι] (d : A →ₗ[K] A) (x : ι → A) (deg : ι → ℕ) : Prop
    extends IsFreeGradedCommutative 𝒜 x deg where
  /-- Every generator has positive degree. -/
  deg_pos : ∀ i, 0 < deg i
  /-- The differential of a generator lies in the subalgebra generated by the earlier ones. -/
  d_mem_adjoin : ∀ i, d (x i) ∈ Algebra.adjoin K (x '' Set.Iio i)

variable (𝒜) in
/-- The conditions of a **minimal Sullivan algebra**: those of `IsSullivanAlgebra`, and moreover
`d` sends every generator to a decomposable element, a sum of products of two elements of positive
degree. As for `IsSullivanAlgebra`, the axioms of a differential on `d` are supplied separately as
`IsDGAlgebra 𝒜 d`. -/
structure IsMinimalSullivanAlgebra [WellFoundedLT ι] (d : A →ₗ[K] A) (x : ι → A) (deg : ι → ℕ) :
    Prop extends IsSullivanAlgebra 𝒜 d x deg where
  /-- The differential of each generator is decomposable. -/
  d_mem_mul : ∀ i, d (x i) ∈ positivePart 𝒜 * positivePart 𝒜

namespace IsSullivanAlgebra

variable [WellFoundedLT ι] [GradedAlgebra 𝒜] {x : ι → A} {deg : ι → ℕ}

omit [GradedAlgebra 𝒜] in
/-- Every generator of a Sullivan algebra lies in the positive part. -/
theorem x_mem_positivePart (hx : IsSullivanAlgebra 𝒜 d x deg) (i : ι) :
    x i ∈ positivePart 𝒜 :=
  hx.mem_positivePart (hx.deg_pos i)

/-- A Sullivan algebra is minimal exactly when its differential takes values in the decomposables
`A⁺ · A⁺`. -/
theorem isMinimal_iff_range_le (hA : IsDGAlgebra 𝒜 d) (hx : IsSullivanAlgebra 𝒜 d x deg) :
    IsMinimalSullivanAlgebra 𝒜 d x deg ↔
      LinearMap.range d ≤ positivePart 𝒜 * positivePart 𝒜 := by
  refine ⟨fun h => ?_, fun h => ⟨hx, fun i => h ⟨x i, rfl⟩⟩⟩
  have h𝒜 : ∀ p < 0, 𝒜 p = ⊥ := fun _ => hx.eq_bot_of_neg
  suffices hw : ∀ w ∈ Algebra.adjoin K (Set.range x), d w ∈ positivePart 𝒜 * positivePart 𝒜 by
    rintro _ ⟨a, rfl⟩
    exact hw a (hx.adjoin_range_eq_top ▸ Algebra.mem_top)
  intro w hw
  induction hw using Algebra.adjoin_induction with
  | mem w hw =>
    obtain ⟨i, rfl⟩ := hw
    exact h.d_mem_mul i
  | algebraMap r => simp [hA.map_algebraMap]
  | add w w' _ _ hw hw' => simpa using add_mem hw hw'
  | mul w w' _ _ hw hw' =>
    rw [hA.toIsNonUnitalDGAlgebra.leibniz_koszulTwist]
    exact add_mem (mul_mem_positivePart_mul_positivePart_of_left h𝒜 hw w')
      (mul_mem_positivePart_mul_positivePart_of_right h𝒜 _ hw')

/-- **Minimality of a Sullivan algebra** is the condition `d (A⁺) ⊆ A⁺ · A⁺`: the differential of
every element of positive degree, not only of every generator, is decomposable. -/
theorem isMinimal_iff (hA : IsDGAlgebra 𝒜 d) (hx : IsSullivanAlgebra 𝒜 d x deg) :
    IsMinimalSullivanAlgebra 𝒜 d x deg ↔
      (positivePart 𝒜).map d ≤ positivePart 𝒜 * positivePart 𝒜 :=
  ⟨fun h => LinearMap.map_le_range.trans ((hx.isMinimal_iff_range_le hA).1 h),
    fun h => ⟨hx, fun i => h ⟨x i, hx.x_mem_positivePart i, rfl⟩⟩⟩

/-- A Sullivan algebra is minimal exactly when the differential induced on its indecomposables
`A⁺ ⧸ A⁺ · A⁺` vanishes. -/
theorem isMinimal_iff_indecomposables_map_eq_zero (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) :
    IsMinimalSullivanAlgebra 𝒜 d x deg ↔
      Indecomposables.map d hA.map_positivePart_le hA.map_positivePart_mul_positivePart_le = 0 := by
  rw [Indecomposables.map_eq_zero_iff, hx.isMinimal_iff hA]

end IsSullivanAlgebra

end TauCeti

namespace MvPolynomial

open TauCeti

variable {K : Type*} [CommRing K] {σ : Type*} [LinearOrder σ] [WellFoundedLT σ]

/-- A polynomial ring on well-ordered variables placed in even positive degrees, with zero
differential, satisfies the conditions `IsMinimalSullivanAlgebra` of a minimal Sullivan algebra:
it is the free graded-commutative algebra on even generators. For `K = ℚ` it is a model of a
product of Eilenberg–MacLane spaces `K(ℚ, 2n)`. -/
theorem isMinimalSullivanAlgebra_X {deg : σ → ℕ} (hdeg : ∀ i, Even (deg i))
    (hpos : ∀ i, 0 < deg i) :
    IsMinimalSullivanAlgebra (weightedHomogeneousSubmodule K fun i => (deg i : ℤ)) 0 X deg where
  toIsFreeGradedCommutative := isFreeGradedCommutative_X hdeg
  deg_pos := hpos
  d_mem_adjoin _ := zero_mem _
  d_mem_mul _ := zero_mem _

end MvPolynomial
