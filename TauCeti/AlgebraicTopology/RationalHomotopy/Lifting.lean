/-!
# The lifting lemma for Sullivan algebras

Let `M = ΛV` be a free graded-commutative differential graded algebra on generators `x i` indexed
by a well-ordered type, such that the differential of each generator lies in the subalgebra
generated by the earlier ones. A Sullivan algebra is such an algebra whose generators have
positive degrees; the degrees play no role here. The lifting lemma says that `M` has the left
lifting property against surjective quasi-isomorphisms with graded-commutative source: for a
surjective morphism `π : B → C` of differential graded algebras inducing a bijection on
cohomology, with `B` graded-commutative, every morphism `g : M → C` factors as `π ∘ h` for a
morphism `h : M → B`.

The lift is built one generator at a time, by well-founded recursion
(`WellFounded.exists_forall_of_forall_exists`). Once `h` is defined on the
generators `x j`, `j < i`, the element `z = h (d (x i))` is a cycle of degree `|x i| + 1` with
`π z = d (g (x i))`. Since `π` is a surjective quasi-isomorphism, `z = d b` for some `b` with
`π b = g (x i)` (`TauCeti.DGAlgHom.exists_mem_d_eq_and_apply_eq`), and `h (x i) = b` extends `h`.
The images of the generators then define an algebra map by the universal property of `ΛV`, which
commutes with the differentials because it does so on the generators.

In particular Sullivan algebras are cofibrant in the model structure on commutative differential
graded algebras whose fibrations are the surjections. The lemma also underlies the
homotopy theory of maps out of them: transitivity of homotopy and the bijection on homotopy
classes induced by a quasi-isomorphism both apply it.

## Main results

* `TauCeti.IsFreeGradedCommutative.exists_dgAlgHom_comp_eq`: the lifting lemma.

## References

* K. Hess, *Rational homotopy theory: a brief introduction*, in *Interactions between homotopy
  theory and algebra*, Contemp. Math. 436, 2007, Proposition 1.13.
* Y. Félix, S. Halperin, J.-C. Thomas, *Rational homotopy theory*, Graduate Texts in Mathematics
  205, Springer, 2001, §12.
-/

public section

namespace TauCeti

namespace IsFreeGradedCommutative

variable {K A B C : Type*} [CommRing K] [Invertible (2 : K)] [Ring A] [Ring B] [Ring C]
  [Algebra K A] [Algebra K B] [Algebra K C]
  {𝒜 : ℤ → Submodule K A} {ℬ : ℤ → Submodule K B} {𝒞 : ℤ → Submodule K C}
  [GradedAlgebra 𝒜] [GradedAlgebra ℬ] [GradedAlgebra 𝒞]
  {dA : A →ₗ[K] A} {dB : B →ₗ[K] B} {dC : C →ₗ[K] C}
  {hA : IsDGAlgebra 𝒜 dA} {hB : IsDGAlgebra ℬ dB} {hC : IsDGAlgebra 𝒞 dC}
  {ι : Type*} [LinearOrder ι] [WellFoundedLT ι] {x : ι → A} {deg : ι → ℕ}

omit [Invertible (2 : K)] [WellFoundedLT ι] in
/-- The inductive step of the lifting lemma: if a graded algebra map `L : A → B` commutes with
the differentials and lifts `g` on the generators `x j`, `j < i`, then `L (dA (x i))` is the
boundary of an element of degree `deg i` lifting `g (x i)`. -/
private theorem exists_lift_generator (hx : ∀ i, x i ∈ 𝒜 (deg i))
    (hd : ∀ i, dA (x i) ∈ Algebra.adjoin K (x '' Set.Iio i))
    (π : DGAlgHom hB hC) (hπ : Function.Surjective π) (hπc : Function.Bijective π.cohomologyMap)
    (g : DGAlgHom hA hC) (L : 𝒜 →ₐᵍ[K] ℬ) (i : ι)
    (hL : ∀ j < i, dB (L (x j)) = L (dA (x j)) ∧ π (L (x j)) = g (x j)) :
    ∃ c ∈ ℬ (deg i), dB c = L (dA (x i)) ∧ π c = g (x i) := by
  -- The obstruction `z = L (dA (x i))` is a cycle with `π z = dC (g (x i))`.
  have hz : dB (L (dA (x i))) = 0 := by
    rw [hA.map_d_eq_of_mem_adjoin hB L ?_ (hd i), hA.sq_zero, map_zero]
    rintro _ ⟨j, hj, rfl⟩
    exact (hL j hj).1
  have hπz : dC (g (x i)) = π (L (dA (x i))) := by
    rw [g.map_d]
    refine (AlgHom.eqOn_adjoin_iff (φ := (π : B →ₐ[K] C).comp L.toAlgHom) (ψ := g).2 ?_
      (hd i)).symm
    rintro _ ⟨j, hj, rfl⟩
    simpa using (hL j hj).2
  exact π.exists_mem_d_eq_and_apply_eq hπ hπc (L.map_mem (hA.map_mem (hx i))) hz
    (g.map_mem (hx i)) hπz

/-- **The lifting lemma.** Let `A` be free graded-commutative on generators `x i` indexed by a
well-ordered type, with the differential of each `x i` in the subalgebra generated by the `x j`,
`j < i` (for instance a Sullivan algebra). Let `π : B → C` be a surjective morphism of
differential graded algebras inducing a bijection on cohomology, with `B` graded-commutative. Then
every morphism `g : A → C` of differential graded algebras lifts through `π`: `g = π ∘ h` for a
morphism `h : A → B`. -/
theorem exists_dgAlgHom_comp_eq (hx : IsFreeGradedCommutative 𝒜 x deg)
    (hd : ∀ i, dA (x i) ∈ Algebra.adjoin K (x '' Set.Iio i))
    (hBc : ∀ {p q : ℤ} {a b : B}, a ∈ ℬ p → b ∈ ℬ q → a * b = (p * q).negOnePow • (b * a))
    (π : DGAlgHom hB hC) (hπ : Function.Surjective π) (hπc : Function.Bijective π.cohomologyMap)
    (g : DGAlgHom hA hC) : ∃ h : DGAlgHom hA hB, π.comp h = g := by
  -- Graded algebra maps out of `A` with prescribed homogeneous images of the generators.
  have hlift (b : ι → B) (hb : ∀ i, b i ∈ ℬ (deg i)) : ∃ L : 𝒜 →ₐᵍ[K] ℬ, ∀ i, L (x i) = b i :=
    ⟨.ofAdjoinRangeEqTop (hx.lift b fun i j => hBc (hb i) (hb j)) hx.adjoin_range_eq_top hx.mem
      fun i => by simpa only [lift_x] using hb i, by simp⟩
  -- The images `b i` of the generators are chosen by well-founded recursion: `V b i c` says that
  -- `c` is an admissible image of `x i`, given the images `b j` of the `x j`, `j < i`. Its
  -- differential condition quantifies over every algebra map extending the `b j`; these all
  -- agree on `dA (x i)`, which lies in the subalgebra generated by the `x j`, `j < i`.
  obtain ⟨b, hb⟩ := wellFounded_lt.exists_forall_of_forall_exists (X := fun _ : ι => B)
    (fun b i c => c ∈ ℬ (deg i) ∧ π c = g (x i) ∧
      ∀ φ : A →ₐ[K] B, (∀ j < i, φ (x j) = b j) → dB c = φ (dA (x i)))
    (fun i c b b' hbb' ⟨hc, hπc, hdc⟩ => ⟨hc, hπc, fun φ hφ => hdc φ fun j hj =>
      (hφ j hj).trans (hbb' j hj).symm⟩)
    fun i b hb => by
      -- Extend the earlier images by `0` to define an algebra map `L` out of `A`.
      obtain ⟨L, hLx⟩ := hlift (fun j => if j < i then b j else 0) fun j => by
        split_ifs with hj
        exacts [(hb j hj).1, zero_mem _]
      have hLx' (j : ι) (hj : j < i) : L (x j) = b j := by rw [hLx, ite_eq_left hj]
      obtain ⟨c, hc, hdc, hπc⟩ := exists_lift_generator hx.mem hd π hπ hπc g L i fun j hj => by
        rw [hLx' j hj]
        exact ⟨(hb j hj).2.2 L.toAlgHom fun k hk => hLx' k (hk.trans hj), (hb j hj).2.1⟩
      refine ⟨c, hc, hπc, fun φ hφ => hdc.trans <| AlgHom.eqOn_adjoin_iff (φ := L.toAlgHom)
        (ψ := φ) |>.2 ?_ (hd i)⟩
      rintro _ ⟨j, hj, rfl⟩
      exact (hLx' j hj).trans (hφ j hj).symm
  obtain ⟨L, hLx⟩ := hlift b fun i => (hb i).1
  refine ⟨DGAlgHom.ofAdjoinRangeEqTop hA hB L.toAlgHom hx.adjoin_range_eq_top hx.mem
    (fun i => L.map_mem (hx.mem i)) fun i => ?_, ?_⟩
  · simpa only [GradedAlgHom.coe_toAlgHom, hLx] using (hb i).2.2 L.toAlgHom fun j _ => hLx j
  · ext a
    simpa using DFunLike.congr_fun (hx.algHom_ext (φ := (π : B →ₐ[K] C).comp L.toAlgHom)
      (ψ := g) fun i => by simpa [hLx] using (hb i).2.1) a

end IsFreeGradedCommutative

end TauCeti
