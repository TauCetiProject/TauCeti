module

public import TauCeti.AlgebraicTopology.SimplicialComplex.Realization.Finite
public import TauCeti.Topology.Category.TopCat.Limits.Basic

/-!
# The weak realization as a colimit of finite subcomplexes

The topology of a weak realization is coherent with the realizations of its finite
subcomplexes (`AbstractSimplicialComplex.isCoherentWith_range_realization_finiteSubcomplex`), so
closedness is tested by intersection with those subspaces
(`AbstractSimplicialComplex.isClosed_iff_inter_realization_finiteSubcomplex`).
Thus it is their directed colimit in `TopCat`
(`AbstractSimplicialComplex.isColimitFiniteSubcomplexCocone`), by
`TauCeti.TopCat.isColimitOfIsCoherentWith`. No local finiteness is required.

## References

* A. Hatcher, *Algebraic Topology*, Appendix A (the weak topology on complexes).
-/

public section

open Set Topology CategoryTheory Limits TauCeti.SetLike

namespace AbstractSimplicialComplex

variable {ι : Type*} {K : AbstractSimplicialComplex ι}

/-- Finite subcomplexes of `K` ordered by face inclusion. They may omit vertices of `K`. -/
abbrev FiniteSubcomplex (K : AbstractSimplicialComplex ι) :=
  {L : PreAbstractSimplicialComplex ι // L ≤ K.toPreAbstractSimplicialComplex ∧ L.faces.Finite}

/-- The subcomplex generated by one face of `K`. -/
def finiteSubcomplexOfFace (K : AbstractSimplicialComplex ι) (σ : Face K) : K.FiniteSubcomplex :=
  ⟨PreAbstractSimplicialComplex.simplex σ.val,
    PreAbstractSimplicialComplex.simplex_le_iff.mpr (fun _ => σ.property),
    PreAbstractSimplicialComplex.finite_faces_simplex σ.val⟩

/-- The defining equation for the underlying precomplex of `finiteSubcomplexOfFace`: it consists
of all nonempty subfaces. -/
@[simp]
theorem finiteSubcomplexOfFace_val (K : AbstractSimplicialComplex ι) (σ : Face K) :
    (K.finiteSubcomplexOfFace σ).val = PreAbstractSimplicialComplex.simplex σ.val := (rfl)

namespace FiniteSubcomplex

/-- The realization of a finite subcomplex inside the weak realization of `K`. -/
def realization (L : K.FiniteSubcomplex) : Set (Realization K) :=
  {x | x.val.support ∈ L.val.faces}

/-- The defining equation for `FiniteSubcomplex.realization`: it consists of exactly the points
carried by one of its faces. -/
theorem realization_def (L : K.FiniteSubcomplex) :
    L.realization = {x | x.val.support ∈ L.val.faces} := (rfl)

/-- A point belongs to a realized finite subcomplex exactly when its support is a face of it. -/
@[simp]
theorem mem_realization {L : K.FiniteSubcomplex} {x : Realization K} :
    x ∈ L.realization ↔ x.val.support ∈ L.val.faces := Iff.rfl

/-- Realization of finite subcomplexes is monotone with respect to face inclusion. -/
theorem monotone_realization (K : AbstractSimplicialComplex ι) :
    Monotone (realization (K := K)) := by
  intro L M h x hx
  have hLM : L.val ≤ M.val := h
  exact mem_realization.mpr (hLM (mem_realization.mp hx))

/-- Two finite subcomplexes are contained in their union, which is again finite. -/
instance : IsDirectedOrder K.FiniteSubcomplex where
  directed L M := by
    -- The supremum of precomplexes is defined by the union of their face sets.
    have hfin : (L.val ⊔ M.val).faces.Finite := L.property.2.union M.property.2
    have hL : L.val ≤ L.val ⊔ M.val := le_sup_left
    have hM : M.val ≤ L.val ⊔ M.val := le_sup_right
    exact ⟨⟨L.val ⊔ M.val, sup_le L.property.1 M.property.1, hfin⟩, hL, hM⟩

/-- The realized finite subcomplex is compact in the weak topology. -/
theorem isCompact_realization (L : K.FiniteSubcomplex) : IsCompact L.realization := by
  rw [realization_def]
  exact K.isCompact_setOf_support_mem L.property.1 L.property.2

end FiniteSubcomplex

/-- Realizing the subcomplex generated by a face gives the image of that closed simplex. -/
@[simp]
theorem realization_finiteSubcomplexOfFace (K : AbstractSimplicialComplex ι) (σ : Face K) :
    (K.finiteSubcomplexOfFace σ).realization = range (faceInclusion K σ) := by
  ext x
  rw [FiniteSubcomplex.mem_realization, finiteSubcomplexOfFace_val,
    PreAbstractSimplicialComplex.mem_faces,
    PreAbstractSimplicialComplex.mem_simplex, mem_range_faceInclusion_iff]
  exact and_iff_right (K.isRelLowerSet_faces (support_mem K x)).1

/-- The topology of a weak realization is determined by the subspaces given by its finite
subcomplexes, even when the ambient complex is not locally finite. -/
theorem isCoherentWith_range_realization_finiteSubcomplex (K : AbstractSimplicialComplex ι) :
    IsCoherentWith (range (FiniteSubcomplex.realization (K := K))) := by
  refine .of_isClosed fun s hs => isClosed_iff_faceInclusion.mpr fun σ => ?_
  have hm (x : StandardSimplex σ.val) : faceInclusion K σ x ∈
      (K.finiteSubcomplexOfFace σ).realization := by
    rw [realization_finiteSubcomplexOfFace]
    exact mem_range_self x
  exact (hs _ (mem_range_self (K.finiteSubcomplexOfFace σ))).preimage
    ((continuous_faceInclusion K σ).subtype_mk hm)

/-- A subset of a weak realization is closed exactly when its intersection with each realized
finite subcomplex is closed. -/
theorem isClosed_iff_inter_realization_finiteSubcomplex {s : Set (Realization K)} :
    IsClosed s ↔ ∀ L : K.FiniteSubcomplex, IsClosed (s ∩ L.realization) := by
  refine ⟨fun hs L => hs.inter L.isCompact_realization.isClosed, fun hs => ?_⟩
  exact (K.isCoherentWith_range_realization_finiteSubcomplex).isClosed_of_forall_isClosed_inter
    (forall_mem_range.mpr hs)

variable (K)

/-- The inclusions of realized finite subcomplexes into the weak realization form a cocone. -/
noncomputable abbrev finiteSubcomplexCocone :
    Cocone (TauCeti.TopCat.subspaceDiagram (FiniteSubcomplex.monotone_realization K)) :=
  TauCeti.TopCat.subspaceCocone (FiniteSubcomplex.monotone_realization K)

/-- The weak realization is the directed colimit in `TopCat` of the realized finite
subcomplexes with their inclusion maps. -/
noncomputable def isColimitFiniteSubcomplexCocone : IsColimit K.finiteSubcomplexCocone :=
  TauCeti.TopCat.isColimitOfIsCoherentWith (FiniteSubcomplex.monotone_realization K)
    (by
      refine eq_univ_of_forall fun x =>
        mem_iUnion.mpr ⟨K.finiteSubcomplexOfFace (carrier K x), ?_⟩
      rw [realization_finiteSubcomplexOfFace]
      exact mem_range_faceInclusion_carrier K x)
    (K.isCoherentWith_range_realization_finiteSubcomplex)

/-- The colimit desc map restricts to the specified map on each finite subcomplex. -/
@[simp]
theorem isColimitFiniteSubcomplexCocone_desc_apply (K : AbstractSimplicialComplex ι)
    (s : Cocone (TauCeti.TopCat.subspaceDiagram (FiniteSubcomplex.monotone_realization K)))
    (L : K.FiniteSubcomplex) (x : L.realization) :
    K.isColimitFiniteSubcomplexCocone.desc s x.val = s.ι.app L x :=
  ConcreteCategory.congr_hom (K.isColimitFiniteSubcomplexCocone.fac s L) x

end AbstractSimplicialComplex
