module

public import TauCeti.AlgebraicTopology.SimplicialComplex.CombinatorialManifold.Boundary.Stellar
import TauCeti.AlgebraicTopology.SimplicialComplex.CombinatorialManifold.Homotopy

/-!
# The boundary of a combinatorial manifold

For a combinatorial `(n + 1)`-manifold `K`, the combinatorial boundary `manifoldBoundary K (n + 1)`
is a combinatorial `n`-manifold (`IsCombinatorialManifold.manifoldBoundary`), and its own
combinatorial boundary is void (`IsCombinatorialManifold.manifoldBoundary_manifoldBoundary_eq_bot`).

At the vertex level, `manifoldBoundary K (n + 1)` picks out precisely the vertices of `K` whose link
is a combinatorial `n`-ball (`IsCombinatorialManifold.singleton_mem_manifoldBoundary_iff`), whereas
the remaining vertices of `K` are those whose link is a combinatorial `n`-sphere
(`IsCombinatorialManifold.singleton_notMem_manifoldBoundary_iff`). Note that `manifoldBoundary` is
generated by the codimension-one boundary ridges rather than being the full subcomplex induced on
its vertices: in the standard `(n + 1)`-simplex `simplex V`, every vertex has an `n`-ball link, yet
`manifoldBoundary (simplex V) (n + 1) = simplexBoundary V` omits the interior `(n + 1)`-face `V`.

In positive boundary dimension `n = m + 1`, commuting `link` with `manifoldBoundary` identifies the
link inside `manifoldBoundary K (m + 2)` of each boundary vertex `v` with
`manifoldBoundary (link K {v}) (m + 1)`, which is a combinatorial `m`-sphere because `link K {v}` is
a combinatorial `(m + 1)`-ball. In boundary dimension `n = 0`, `manifoldBoundary K 1` is pure of
dimension `0`, so every vertex link is void.

## Main results

* `PreAbstractSimplicialComplex.IsCombinatorialManifold.singleton_mem_manifoldBoundary_iff`:
  a vertex belongs to `manifoldBoundary K (n + 1)` if and only if its link in `K` is a
  combinatorial `n`-ball.
* `PreAbstractSimplicialComplex.IsCombinatorialManifold.singleton_notMem_manifoldBoundary_iff`:
  a vertex of `K` lies outside `manifoldBoundary K (n + 1)` if and only if its link in `K` is a
  combinatorial `n`-sphere.
* `IsCombinatorialManifold.isCombinatorialSphere_link_manifoldBoundary`:
  every vertex of `manifoldBoundary K (n + 2)` has a combinatorial `n`-sphere link inside the
  boundary.
* `PreAbstractSimplicialComplex.IsCombinatorialManifold.manifoldBoundary`:
  the combinatorial boundary of a combinatorial `(n + 1)`-manifold is a combinatorial `n`-manifold.
* `PreAbstractSimplicialComplex.IsCombinatorialManifold.manifoldBoundary_eq_bot_iff`:
  `manifoldBoundary K (n + 1) = ⊥` if and only if every vertex of `K` has a combinatorial
  `n`-sphere link.
* `PreAbstractSimplicialComplex.IsCombinatorialManifold.manifoldBoundary_manifoldBoundary_eq_bot`:
  the combinatorial boundary of the combinatorial boundary of a combinatorial `(n + 1)`-manifold is
  void.

## References

* C. P. Rourke, B. J. Sanderson, *Introduction to Piecewise-Linear Topology*, Springer (1972),
  Chapters 2 and 3.
* W. B. R. Lickorish, *Simplicial moves on complexes and manifolds*, Geom. Topol. Monogr. 2
  (1999), 299–320.
-/

public section

open Finset

namespace PreAbstractSimplicialComplex

variable {ι : Type*} [DecidableEq ι] {K : PreAbstractSimplicialComplex ι} {v : ι} {n : ℕ}

/-- For any precomplex `K`, `manifoldBoundary K 1` is a combinatorial `0`-manifold: it is pure of
dimension `0`, so every vertex has void link. -/
theorem isCombinatorialManifold_manifoldBoundary_one (K : PreAbstractSimplicialComplex ι) :
    IsCombinatorialManifold (manifoldBoundary K 1) 0 :=
  isCombinatorialManifold_zero_iff.mpr fun v hv =>
    (isPure_manifoldBoundary_succ.link_eq_bot_iff hv).mpr (card_singleton v)

/-- A vertex belongs to the combinatorial boundary of a combinatorial `(n + 1)`-manifold `K`
precisely when its link in `K` is a combinatorial `n`-ball. -/
theorem IsCombinatorialManifold.singleton_mem_manifoldBoundary_iff
    (hK : IsCombinatorialManifold K (n + 1)) :
    ({v} : Finset ι) ∈ manifoldBoundary K (n + 1) ↔ IsCombinatorialBall (link K {v}) n := by
  cases n with
  | zero => exact singleton_mem_manifoldBoundary_one_iff
  | succ m =>
    refine ⟨fun hvB => ?_, IsCombinatorialBall.singleton_mem_manifoldBoundary⟩
    have hvK : ({v} : Finset ι) ∈ K := manifoldBoundary_le hvB
    rcases isCombinatorialManifold_succ_iff.mp hK hvK with hs | hb
    · have hbot : link (manifoldBoundary K (m + 2)) {v} = ⊥ := by
        rw [link_manifoldBoundary]
        simpa using hs.manifoldBoundary_eq_bot
      have hcard := (isPure_manifoldBoundary_succ.link_eq_bot_iff hvB).mp hbot
      rw [card_singleton] at hcard
      omega
    · exact hb

/-- A vertex of a combinatorial `(n + 1)`-manifold `K` lies outside `manifoldBoundary K (n + 1)`
precisely when its link in `K` is a combinatorial `n`-sphere. -/
theorem IsCombinatorialManifold.singleton_notMem_manifoldBoundary_iff
    (hK : IsCombinatorialManifold K (n + 1)) (hv : ({v} : Finset ι) ∈ K) :
    ({v} : Finset ι) ∉ manifoldBoundary K (n + 1) ↔ IsCombinatorialSphere (link K {v}) n := by
  rw [hK.singleton_mem_manifoldBoundary_iff]
  exact ⟨(isCombinatorialManifold_succ_iff.mp hK hv).resolve_right,
    IsCombinatorialSphere.not_isCombinatorialBall⟩

/-- In a combinatorial `(n + 2)`-manifold `K`, the link inside `manifoldBoundary K (n + 2)` of every
boundary vertex is a combinatorial `n`-sphere: it is the combinatorial boundary of that vertex's
`(n + 1)`-ball link in `K`. -/
theorem IsCombinatorialManifold.isCombinatorialSphere_link_manifoldBoundary
    (hK : IsCombinatorialManifold K (n + 2))
    (hv : ({v} : Finset ι) ∈ manifoldBoundary K (n + 2)) :
    IsCombinatorialSphere (link (manifoldBoundary K (n + 2)) {v}) n := by
  have hb := hK.singleton_mem_manifoldBoundary_iff.mp hv
  rw [link_manifoldBoundary, card_singleton]
  exact hb.isCombinatorialSphere_manifoldBoundary

/-- The combinatorial boundary of a combinatorial `(n + 1)`-manifold is a combinatorial
`n`-manifold. -/
theorem IsCombinatorialManifold.manifoldBoundary
    (hK : IsCombinatorialManifold K (n + 1)) :
    IsCombinatorialManifold (PreAbstractSimplicialComplex.manifoldBoundary K (n + 1)) n := by
  cases n with
  | zero => exact isCombinatorialManifold_manifoldBoundary_one K
  | succ m =>
    exact isCombinatorialManifold_succ_iff.mpr fun _ hv =>
      Or.inl (hK.isCombinatorialSphere_link_manifoldBoundary hv)

/-- A combinatorial `(n + 1)`-manifold has void combinatorial boundary precisely when every vertex
has a combinatorial `n`-sphere link. -/
theorem IsCombinatorialManifold.manifoldBoundary_eq_bot_iff
    (hK : IsCombinatorialManifold K (n + 1)) :
    PreAbstractSimplicialComplex.manifoldBoundary K (n + 1) = ⊥ ↔
      ∀ ⦃v : ι⦄, ({v} : Finset ι) ∈ K → IsCombinatorialSphere (link K {v}) n := by
  constructor
  · intro hbot v hv
    refine (hK.singleton_notMem_manifoldBoundary_iff hv).mp ?_
    rw [hbot]
    exact fun h => h
  · intro hs
    refine eq_bot_iff.mpr fun α hα => ?_
    obtain ⟨v, hvα⟩ :=
      ((PreAbstractSimplicialComplex.manifoldBoundary K (n + 1)).isRelLowerSet_faces hα).1
    have hvB : ({v} : Finset ι) ∈ PreAbstractSimplicialComplex.manifoldBoundary K (n + 1) :=
      singleton_mem_of_mem hα hvα
    exact (hK.singleton_notMem_manifoldBoundary_iff (manifoldBoundary_le hvB)).mpr
      (hs (manifoldBoundary_le hvB)) hvB

/-- A combinatorial `(n + 1)`-manifold has nonvoid combinatorial boundary precisely when at least
one vertex has a combinatorial `n`-ball link. -/
theorem IsCombinatorialManifold.manifoldBoundary_ne_bot_iff
    (hK : IsCombinatorialManifold K (n + 1)) :
    PreAbstractSimplicialComplex.manifoldBoundary K (n + 1) ≠ ⊥ ↔
      ∃ v : ι, IsCombinatorialBall (link K {v}) n := by
  constructor
  · intro hne
    obtain ⟨α, hα, -⟩ := IsConcreteLE.exists_of_lt (bot_lt_iff_ne_bot.mpr hne)
    obtain ⟨v, hvα⟩ :=
      ((PreAbstractSimplicialComplex.manifoldBoundary K (n + 1)).isRelLowerSet_faces hα).1
    exact ⟨v, hK.singleton_mem_manifoldBoundary_iff.mp (singleton_mem_of_mem hα hvα)⟩
  · rintro ⟨v, hb⟩ hbot
    have hvB := hb.singleton_mem_manifoldBoundary
    rw [hbot] at hvB
    exact hvB

/-- The combinatorial boundary of the combinatorial boundary of a combinatorial `(n + 1)`-manifold
is void: `∂(∂K) = ⊥`. -/
theorem IsCombinatorialManifold.manifoldBoundary_manifoldBoundary_eq_bot
    (hK : IsCombinatorialManifold K (n + 1)) :
    PreAbstractSimplicialComplex.manifoldBoundary
      (PreAbstractSimplicialComplex.manifoldBoundary K (n + 1)) n = ⊥ := by
  cases n with
  | zero => exact manifoldBoundary_zero _
  | succ m =>
    exact hK.manifoldBoundary.manifoldBoundary_eq_bot_iff.mpr fun _ hv =>
      hK.isCombinatorialSphere_link_manifoldBoundary hv

end PreAbstractSimplicialComplex
