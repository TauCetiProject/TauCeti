/-!
# The combinatorial boundary of a simplicial complex

Relative to an ambient dimension `d`, the combinatorial boundary `manifoldBoundary K d` of a
pre-abstract simplicial complex `K` is `⊥` when `d = 0`, and for `d = m + 1` is the subcomplex
generated by the `(m + 1)`-vertex faces of `K` whose link in `K` is a combinatorial `0`-ball
(equivalently, a single vertex). When `K` has dimension at most `m + 1`, these generating ridges
are precisely the `(m + 1)`-vertex faces contained in a unique `(m + 2)`-vertex face of `K`.

This file establishes the basic lattice, dimension, purity, finiteness, relabeling, and link
properties of `manifoldBoundary`, together with its values on the standard simplex and simplex
boundary. The construction is named `manifoldBoundary` to distinguish the PL boundary subcomplex
from the homological chain boundary `AbstractSimplicialComplex.boundary` and from
`simplexBoundary`. Stellar invariance and the manifold theorem for `manifoldBoundary` are developed
in `CombinatorialManifold.Boundary.Stellar` and `CombinatorialManifold.Boundary.Manifold`.

## Main definitions

* `PreAbstractSimplicialComplex.manifoldBoundary`: the `(d - 1)`-dimensional combinatorial
  boundary of a complex relative to dimension `d`.

## Main results

* `PreAbstractSimplicialComplex.isPure_manifoldBoundary_succ`: `manifoldBoundary K (m + 1)` is pure
  of dimension `m`.
* `PreAbstractSimplicialComplex.isCombinatorialBall_zero_link_iff_existsUnique`: in a complex of
  dimension at most `d`, a `d`-vertex finset has `0`-ball link if and only if it lies in a unique
  `(d + 1)`-vertex face.
* `PreAbstractSimplicialComplex.map_manifoldBoundary`: injective vertex relabelings commute with
  `manifoldBoundary`.
* `PreAbstractSimplicialComplex.link_manifoldBoundary`: taking the link of `σ` commutes with
  `manifoldBoundary`, shifting the dimension index to `d - σ.card`.
* `PreAbstractSimplicialComplex.manifoldBoundary_simplex` and
  `PreAbstractSimplicialComplex.manifoldBoundary_simplexBoundary`: the combinatorial boundary of the
  standard `d`-simplex is its simplex boundary, and that of the standard `d`-sphere model is `⊥`.

## References

* C. P. Rourke, B. J. Sanderson, *Introduction to Piecewise-Linear Topology*, Springer (1972),
  Chapters 2 and 3.
* W. B. R. Lickorish, *Simplicial moves on complexes and manifolds*, Geom. Topol. Monogr. 2
  (1999), 299–320.
-/

public section

open Finset

namespace PreAbstractSimplicialComplex

variable {ι : Type*} [DecidableEq ι] {K : PreAbstractSimplicialComplex ι}
  {V α σ τ : Finset ι} {d m : ℕ}

/-- The **(d - 1)-dimensional combinatorial boundary** of a pre-abstract simplicial complex `K`
relative to ambient dimension `d`: `⊥` in dimension `0`, and for `d = m + 1` the subcomplex
generated by the `(m + 1)`-vertex faces of `K` whose link in `K` is a combinatorial `0`-ball. -/
def manifoldBoundary (K : PreAbstractSimplicialComplex ι) : ℕ → PreAbstractSimplicialComplex ι
  | 0 => ⊥
  | m + 1 =>
      TauCeti.PreAbstractSimplicialComplex.ofGenerators
        {τ | τ ∈ K ∧ τ.card = m + 1 ∧ IsCombinatorialBall (link K τ) 0}

/-- In ambient dimension `0`, the combinatorial boundary is void. -/
@[simp]
theorem manifoldBoundary_zero (K : PreAbstractSimplicialComplex ι) :
    manifoldBoundary K 0 = ⊥ := by
  rfl

/-- In positive ambient dimension `m + 1`, the combinatorial boundary is generated by the
`(m + 1)`-vertex faces with `0`-ball link. -/
theorem manifoldBoundary_succ (K : PreAbstractSimplicialComplex ι) (m : ℕ) :
    manifoldBoundary K (m + 1) =
      TauCeti.PreAbstractSimplicialComplex.ofGenerators
        {τ | τ ∈ K ∧ τ.card = m + 1 ∧ IsCombinatorialBall (link K τ) 0} := by
  rfl

/-- A finite set belongs to `manifoldBoundary K (m + 1)` precisely when it is nonempty and
contained in an `(m + 1)`-vertex face of `K` whose link is a combinatorial `0`-ball. -/
theorem mem_manifoldBoundary_succ_iff :
    α ∈ manifoldBoundary K (m + 1) ↔
      α.Nonempty ∧ ∃ τ ∈ K, τ.card = m + 1 ∧ IsCombinatorialBall (link K τ) 0 ∧ α ⊆ τ := by
  rw [manifoldBoundary_succ, TauCeti.PreAbstractSimplicialComplex.mem_ofGenerators]
  exact ⟨fun ⟨hne, τ, ⟨hτK, hcard, hball⟩, hsub⟩ => ⟨hne, τ, hτK, hcard, hball, hsub⟩,
    fun ⟨hne, τ, hτK, hcard, hball, hsub⟩ => ⟨hne, τ, ⟨hτK, hcard, hball⟩, hsub⟩⟩

/-- Membership in `manifoldBoundary K (m + 1)` phrased directly via singleton-simplex links. -/
theorem mem_manifoldBoundary_succ_iff_exists_simplex :
    α ∈ manifoldBoundary K (m + 1) ↔
      α.Nonempty ∧ ∃ τ ∈ K, τ.card = m + 1 ∧ (∃ w, link K τ = simplex {w}) ∧ α ⊆ τ := by
  simp only [mem_manifoldBoundary_succ_iff, isCombinatorialBall_zero_iff]

/-- The combinatorial boundary of the void complex is void in every dimension. -/
@[simp]
theorem manifoldBoundary_bot (d : ℕ) :
    manifoldBoundary (⊥ : PreAbstractSimplicialComplex ι) d = ⊥ := by
  cases d with
  | zero => rfl
  | succ m =>
    refine eq_bot_iff.mpr fun α hα => ?_
    obtain ⟨-, _, hτ, -⟩ := mem_manifoldBoundary_succ_iff.mp hα
    exact hτ

/-- The combinatorial boundary is a subcomplex of the ambient complex. -/
theorem manifoldBoundary_le : manifoldBoundary K d ≤ K := by
  cases d with
  | zero => exact bot_le
  | succ m =>
    rw [manifoldBoundary_succ, TauCeti.PreAbstractSimplicialComplex.ofGenerators_le_iff]
    exact fun _ hτ _ => hτ.1

/-- Every face of `manifoldBoundary K d` has at most `d` vertices. -/
theorem card_le_of_mem_manifoldBoundary (hα : α ∈ manifoldBoundary K d) : α.card ≤ d := by
  cases d with
  | zero => exact hα.elim
  | succ m =>
    obtain ⟨-, τ, -, hcard, -, hsub⟩ := mem_manifoldBoundary_succ_iff.mp hα
    exact hcard ▸ card_le_card hsub

/-- No face with more than `d` vertices belongs to `manifoldBoundary K d`. -/
theorem notMem_manifoldBoundary_of_lt_card (hcard : d < α.card) :
    α ∉ manifoldBoundary K d :=
  fun hα => (card_le_of_mem_manifoldBoundary hα).not_gt hcard

/-- An `(m + 1)`-vertex finset belongs to `manifoldBoundary K (m + 1)` precisely when it is a face
of `K` whose link is a combinatorial `0`-ball. -/
theorem mem_manifoldBoundary_of_card_eq (hcard : τ.card = m + 1) :
    τ ∈ manifoldBoundary K (m + 1) ↔ τ ∈ K ∧ IsCombinatorialBall (link K τ) 0 := by
  rw [mem_manifoldBoundary_succ_iff]
  constructor
  · rintro ⟨-, ρ, hρK, hρcard, hball, hsub⟩
    obtain rfl := eq_of_subset_of_card_le hsub (by omega)
    exact ⟨hρK, hball⟩
  · rintro ⟨hτK, hball⟩
    exact ⟨card_pos.mp (by omega), τ, hτK, hcard, hball, Subset.rfl⟩

/-- A vertex belongs to `manifoldBoundary K 1` precisely when its link in `K` is a combinatorial
`0`-ball. -/
theorem singleton_mem_manifoldBoundary_one_iff {v : ι} :
    ({v} : Finset ι) ∈ manifoldBoundary K 1 ↔ IsCombinatorialBall (link K {v}) 0 := by
  rw [mem_manifoldBoundary_of_card_eq (card_singleton v), and_iff_right_iff_imp]
  intro hb
  by_contra hv
  exact hb.ne_bot (link_eq_bot_of_notMem (singleton_nonempty v) hv)

/-- If `K` has dimension strictly below `d`, its combinatorial boundary at index `d` is void:
`K` has no `d`-simplices from which a boundary `(d - 1)`-simplex could acquire a nonempty link. -/
theorem manifoldBoundary_eq_bot_of_dimension_lt (hdim : dimension K < (d : WithBot ℕ∞)) :
    manifoldBoundary K d = ⊥ := by
  cases d with
  | zero => rfl
  | succ m =>
    refine eq_bot_iff.mpr fun α hα => ?_
    obtain ⟨-, τ, -, hcard, ⟨w, hlink⟩, -⟩ :=
      mem_manifoldBoundary_succ_iff_exists_simplex.mp hα
    have hw : ({w} : Finset ι) ∈ link K τ := by
      rw [hlink]
      exact self_mem_simplex.mpr (singleton_nonempty w)
    obtain ⟨-, hdis, hface⟩ := mem_link_nonempty.mp hw
    have hwτ : w ∉ τ := disjoint_singleton_left.mp hdis
    rw [singleton_union] at hface
    have hle := le_dimension hface
    rw [card_insert_of_notMem hwτ, hcard] at hle
    exact not_le_of_gt hdim (by simpa using hle)

/-- In positive ambient dimension `m + 1`, `manifoldBoundary K (m + 1)` is pure of dimension `m`. -/
theorem isPure_manifoldBoundary_succ : IsPure (manifoldBoundary K (m + 1)) m := by
  rw [isPure_iff]
  intro α hα
  obtain ⟨-, τ, hτK, hcard, hball, hsub⟩ := mem_manifoldBoundary_succ_iff.mp hα
  exact ⟨τ, (mem_manifoldBoundary_of_card_eq hcard).mpr ⟨hτK, hball⟩, hsub, hcard⟩

/-- `manifoldBoundary K (m + 1)` has dimension at most `m`. -/
theorem dimension_manifoldBoundary_succ_le :
    dimension (manifoldBoundary K (m + 1)) ≤ (m : WithBot ℕ∞) :=
  isPure_manifoldBoundary_succ.dimension_le

/-- A nonvoid `manifoldBoundary K (m + 1)` has dimension `m`. -/
theorem dimension_manifoldBoundary_succ_eq (h : manifoldBoundary K (m + 1) ≠ ⊥) :
    dimension (manifoldBoundary K (m + 1)) = (m : WithBot ℕ∞) :=
  isPure_manifoldBoundary_succ.dimension_eq h

/-- If `K` has finitely many faces, so does `manifoldBoundary K d`. -/
theorem finite_faces_manifoldBoundary (hfin : K.faces.Finite) :
    (manifoldBoundary K d).faces.Finite :=
  hfin.subset manifoldBoundary_le

/-! ### Ridge incidence characterization -/

/-- In a complex of dimension at most `d`, a `d`-vertex finset has a `0`-ball link precisely when
it is contained in a unique `(d + 1)`-vertex face of `K`. -/
theorem isCombinatorialBall_zero_link_iff_existsUnique
    (hdim : dimension K ≤ (d : WithBot ℕ∞)) (hcard : τ.card = d) :
    IsCombinatorialBall (link K τ) 0 ↔ ∃! σ, σ ∈ K ∧ σ.card = d + 1 ∧ τ ⊆ σ := by
  rw [isCombinatorialBall_zero_iff]
  constructor
  · rintro ⟨w, hlink⟩
    have hw : ({w} : Finset ι) ∈ link K τ := by
      rw [hlink]
      exact self_mem_simplex.mpr (singleton_nonempty w)
    obtain ⟨-, hdis, hwK⟩ := mem_link_nonempty.mp hw
    have hwτ : w ∉ τ := disjoint_singleton_left.mp hdis
    rw [singleton_union] at hwK
    refine ⟨insert w τ, ⟨hwK, by rw [card_insert_of_notMem hwτ, hcard], subset_insert w τ⟩, ?_⟩
    rintro σ ⟨hσK, hσcard, hτσ⟩
    have hsdiff : (σ \ τ).card = 1 := by
      rw [card_sdiff_of_subset hτσ, hσcard, hcard]
      omega
    obtain ⟨u, hu⟩ := card_eq_one.mp hsdiff
    have hu_mem : ({u} : Finset ι) ∈ link K τ :=
      mem_link_nonempty.mpr ⟨singleton_nonempty u,
        hu ▸ sdiff_disjoint, by rwa [← hu, sdiff_union_of_subset hτσ]⟩
    rw [hlink, mem_simplex, singleton_subset_iff, mem_singleton] at hu_mem
    rw [← sdiff_union_of_subset hτσ, hu, hu_mem.2, singleton_union]
  · rintro ⟨σ₀, ⟨hσ₀K, hσ₀card, hτσ₀⟩, huniq⟩
    have hsdiff : (σ₀ \ τ).card = 1 := by
      rw [card_sdiff_of_subset hτσ₀, hσ₀card, hcard]
      omega
    obtain ⟨w, hw⟩ := card_eq_one.mp hsdiff
    have hwσ₀ : insert w τ = σ₀ := by
      rw [← singleton_union, ← hw, sdiff_union_of_subset hτσ₀]
    refine ⟨w, le_antisymm (fun ρ hρ => ?_) ?_⟩
    · obtain ⟨hne, hdis, hρK⟩ := mem_link_nonempty.mp hρ
      have hle := dimension_le_iff.mp hdim (ρ ∪ τ) hρK
      have hρcard_le : (ρ ∪ τ).card - 1 ≤ d := by exact_mod_cast hle
      rw [card_union_of_disjoint hdis, hcard] at hρcard_le
      have hρpos : 0 < ρ.card := card_pos.mpr hne
      obtain ⟨u, rfl⟩ := card_eq_one.mp (show ρ.card = 1 by omega)
      rw [singleton_union] at hρK
      have huτ : u ∉ τ := disjoint_singleton_left.mp hdis
      have heq := huniq (insert u τ) ⟨hρK, by rw [card_insert_of_notMem huτ, hcard],
        subset_insert u τ⟩
      have huw : ({u} : Finset ι) = {w} := by rw [← insert_sdiff_cancel huτ, heq, hw]
      exact mem_simplex.mpr ⟨singleton_nonempty u, huw.le⟩
    · exact simplex_le_iff.mpr fun _ => mem_link_nonempty.mpr
        ⟨singleton_nonempty w, hw ▸ sdiff_disjoint, by rwa [singleton_union, hwσ₀]⟩

/-- In a complex of dimension at most `m + 1`, `manifoldBoundary K (m + 1)` consists of the
nonempty subsets of `(m + 1)`-vertex faces lying in a unique `(m + 2)`-vertex face of `K`. -/
theorem mem_manifoldBoundary_succ_iff_existsUnique
    (hdim : dimension K ≤ ((m + 1 : ℕ) : WithBot ℕ∞)) :
    α ∈ manifoldBoundary K (m + 1) ↔
      α.Nonempty ∧ ∃ τ ∈ K, τ.card = m + 1 ∧ (∃! σ, σ ∈ K ∧ σ.card = m + 2 ∧ τ ⊆ σ) ∧ α ⊆ τ := by
  rw [mem_manifoldBoundary_succ_iff]
  refine and_congr_right fun _ => exists_congr fun τ => and_congr_right fun _ =>
    and_congr_right fun hcard => and_congr_left fun _ =>
      isCombinatorialBall_zero_link_iff_existsUnique hdim hcard

/-! ### Relabeling and links -/

/-- An injective vertex map commutes with `manifoldBoundary`. -/
@[simp]
theorem map_manifoldBoundary {κ : Type*} [DecidableEq κ] (f : ι → κ)
    (hf : Function.Injective f) :
    (manifoldBoundary K d).map f = manifoldBoundary (K.map f) d := by
  cases d with
  | zero =>
    apply eq_bot_iff.mpr
    rintro ω ⟨α, hα, -⟩
    exact hα
  | succ m =>
    refine SetLike.ext fun ω => ?_
    constructor
    · intro hω
      obtain ⟨α, hα, rfl⟩ := mem_map_iff.mp hω
      obtain ⟨hne, τ, hτK, hcard, ⟨w, hlink⟩, hsub⟩ :=
        mem_manifoldBoundary_succ_iff_exists_simplex.mp hα
      refine mem_manifoldBoundary_succ_iff_exists_simplex.mpr
        ⟨hne.image f, τ.image f, mem_map_iff.mpr ⟨τ, hτK, rfl⟩,
          by rw [card_image_of_injective τ hf, hcard], ⟨f w, ?_⟩, image_subset_image hsub⟩
      rw [← map_link f hf, hlink, map_simplex, image_singleton]
    · intro hω
      obtain ⟨hne, τ', hτ'K, hcard, ⟨y, hlink⟩, hsub⟩ :=
        mem_manifoldBoundary_succ_iff_exists_simplex.mp hω
      obtain ⟨τ, hτK, rfl⟩ := mem_map_iff.mp hτ'K
      obtain ⟨α, hατ, rfl⟩ := subset_image_iff.mp hsub
      rw [← map_link f hf] at hlink
      have hy : ({y} : Finset κ) ∈ (link K τ).map f := by
        rw [hlink]
        exact self_mem_simplex.mpr (singleton_nonempty y)
      obtain ⟨ρ, hρ, hρy⟩ := mem_map_iff.mp hy
      have hρcard : ρ.card = 1 := by
        have := congrArg Finset.card hρy
        rwa [card_image_of_injective ρ hf, card_singleton] at this
      obtain ⟨w, rfl⟩ := card_eq_one.mp hρcard
      rw [image_singleton, singleton_inj] at hρy
      subst y
      refine mem_map_iff.mpr ⟨α, mem_manifoldBoundary_succ_iff_exists_simplex.mpr
        ⟨image_nonempty.mp hne, τ, hτK, by rwa [card_image_of_injective τ hf] at hcard,
          ⟨w, ?_⟩, hατ⟩, rfl⟩
      refine le_antisymm (fun η hη => ?_) (simplex_le_iff.mpr fun _ => hρ)
      have hηmap : η.image f ∈ (link K τ).map f := mem_map_iff.mpr ⟨η, hη, rfl⟩
      rw [hlink, mem_simplex, ← image_singleton, image_subset_image_iff hf] at hηmap
      exact mem_simplex.mpr ⟨((link K τ).isRelLowerSet_faces hη).1, hηmap.2⟩

/-- Taking the link of any finset `σ` commutes with `manifoldBoundary`, shifting the ambient
dimension index to `d - σ.card`. No face, nonemptiness, or dimension hypothesis is required. -/
@[simp]
theorem link_manifoldBoundary (K : PreAbstractSimplicialComplex ι) (d : ℕ) (σ : Finset ι) :
    link (manifoldBoundary K d) σ = manifoldBoundary (link K σ) (d - σ.card) := by
  by_cases hlt : σ.card < d
  · obtain ⟨r, hr⟩ : ∃ r, d - σ.card = r + 1 := ⟨d - σ.card - 1, by omega⟩
    obtain ⟨m, rfl⟩ : ∃ m, d = m + 1 := ⟨d - 1, by omega⟩
    rw [hr]
    refine SetLike.ext fun ρ => ?_
    rw [mem_link_nonempty, mem_manifoldBoundary_succ_iff, mem_manifoldBoundary_succ_iff]
    constructor
    · rintro ⟨hne, hdis, -, τ, hτK, hτcard, hball, hsub⟩
      have hστ : σ ⊆ τ := subset_union_right.trans hsub
      have hρτ : ρ ⊆ τ \ σ := subset_sdiff.mpr ⟨subset_union_left.trans hsub, hdis⟩
      have hsdiff : (τ \ σ).card = r + 1 := by
        rw [card_sdiff_of_subset hστ, hτcard]
        omega
      refine ⟨hne, τ \ σ, mem_link_nonempty.mpr
        ⟨hne.mono hρτ, sdiff_disjoint, by rwa [sdiff_union_of_subset hστ]⟩,
        hsdiff, ?_, hρτ⟩
      rwa [link_link sdiff_disjoint.symm, union_comm, sdiff_union_of_subset hστ]
    · rintro ⟨hne, ω, hωlink, hωcard, hball, hρω⟩
      obtain ⟨-, hdisω, hωσK⟩ := mem_link_nonempty.mp hωlink
      refine ⟨hne, hdisω.mono_left hρω, union_nonempty.mpr (Or.inl hne),
        ω ∪ σ, hωσK, ?_, ?_, union_subset_union_left hρω⟩
      · rw [card_union_of_disjoint hdisω, hωcard]
        omega
      · rwa [link_link hdisω.symm, union_comm] at hball
  · have hsub_zero : d - σ.card = 0 := by omega
    rw [hsub_zero, manifoldBoundary_zero]
    refine eq_bot_iff.mpr fun ρ hρ => ?_
    obtain ⟨hne, hdis, hmem⟩ := mem_link_nonempty.mp hρ
    have hle := card_le_of_mem_manifoldBoundary hmem
    rw [card_union_of_disjoint hdis] at hle
    have := card_pos.mpr hne
    omega

/-! ### Standard simplex and simplex boundary -/

/-- The combinatorial boundary of the standard `d`-simplex is its simplex boundary. -/
theorem manifoldBoundary_simplex (hV : V.card = d + 1) :
    manifoldBoundary (simplex V) d = simplexBoundary V := by
  cases d with
  | zero =>
    obtain ⟨v, rfl⟩ := card_eq_one.mp hV
    rw [manifoldBoundary_zero, simplexBoundary_singleton]
  | succ m =>
    refine le_antisymm (fun α hα => ?_) (fun α hα => ?_)
    · obtain ⟨hne, hsub⟩ := mem_simplex.mp (manifoldBoundary_le hα)
      have hcard := card_le_of_mem_manifoldBoundary hα
      exact mem_simplexBoundary.mpr ⟨hne, Finset.ssubset_iff_subset_ne.mpr
        ⟨hsub, fun heq => by rw [heq, hV] at hcard; omega⟩⟩
    · obtain ⟨τ, hτ, hατ, hτcard⟩ := (isPure_simplexBoundary hV).exists_coface hα
      have hτV : τ ⊆ V := (mem_simplexBoundary.mp hτ).2.subset
      refine mem_manifoldBoundary_succ_iff.mpr
        ⟨(mem_simplexBoundary.mp hα).1, τ, simplexBoundary_le_simplex hτ, hτcard, ?_, hατ⟩
      simpa [hτcard] using isCombinatorialBall_link_simplex hV hτV (by omega)

/-- The combinatorial boundary of `simplex V` at its natural dimension `V.card - 1` is
`simplexBoundary V`, including the empty and singleton spanning sets. -/
@[simp]
theorem manifoldBoundary_simplex_card (V : Finset ι) :
    manifoldBoundary (simplex V) (V.card - 1) = simplexBoundary V := by
  rcases V.eq_empty_or_nonempty with rfl | hV
  · simp
  · have hpos : 1 ≤ V.card := card_pos.mpr hV
    exact manifoldBoundary_simplex (by omega)

/-- The combinatorial boundary of the standard `d`-sphere model `simplexBoundary V` is void. -/
theorem manifoldBoundary_simplexBoundary (hV : V.card = d + 2) :
    manifoldBoundary (simplexBoundary V) d = ⊥ := by
  cases d with
  | zero => rfl
  | succ m =>
    refine eq_bot_iff.mpr fun α hα => ?_
    obtain ⟨-, τ, hτ, hτcard, ⟨w, hlink⟩, -⟩ :=
      mem_manifoldBoundary_succ_iff_exists_simplex.mp hα
    have hτV : τ ⊆ V := (mem_simplexBoundary.mp hτ).2.subset
    rw [link_simplexBoundary hτV] at hlink
    have hsdiff : (V \ τ).card = 2 := by
      rw [card_sdiff_of_subset hτV, hV, hτcard]
      omega
    obtain ⟨a, b, hab, heq⟩ := card_eq_two.mp hsdiff
    rw [heq] at hlink
    have hfaces := congrArg PreAbstractSimplicialComplex.faces hlink
    rw [faces_simplexBoundary_pair hab, faces_simplex_singleton] at hfaces
    have ha : ({a} : Finset ι) = {w} := by
      have : ({a} : Finset ι) ∈ ({{w}} : Set (Finset ι)) := hfaces ▸ by simp
      simpa using this
    have hb : ({b} : Finset ι) = {w} := by
      have : ({b} : Finset ι) ∈ ({{w}} : Set (Finset ι)) := hfaces ▸ by simp
      simpa using this
    exact hab (singleton_injective (ha.trans hb.symm))

/-- The combinatorial boundary of `simplexBoundary V` at its natural dimension `V.card - 2` is
void, for every finite vertex set `V`. -/
@[simp]
theorem manifoldBoundary_simplexBoundary_card (V : Finset ι) :
    manifoldBoundary (simplexBoundary V) (V.card - 2) = ⊥ := by
  by_cases h : V.card ≤ 2
  · have hzero : V.card - 2 = 0 := by omega
    rw [hzero, manifoldBoundary_zero]
  · exact manifoldBoundary_simplexBoundary (by omega)

end PreAbstractSimplicialComplex
