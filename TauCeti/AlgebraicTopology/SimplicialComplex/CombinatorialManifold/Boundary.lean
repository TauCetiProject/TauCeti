/-!
# The boundary of a combinatorial manifold

For any pre-abstract simplicial complex `K`, its **combinatorial boundary**
`PreAbstractSimplicialComplex.manifoldBoundary K` is the subcomplex generated by the faces `τ ∈ K`
whose link is a single vertex (`link K τ = simplex {w}`): in a combinatorial `(n + 1)`-manifold,
these are precisely the codimension-one faces incident to a single `(n + 1)`-simplex.

Two exact commutation identities hold for arbitrary precomplexes without any manifold hypothesis:

* `link_manifoldBoundary`: `link (manifoldBoundary K) σ = manifoldBoundary (link K σ)`.
* `manifoldBoundary_stellarSubdivision`: for a fresh vertex `{v} ∉ K`,
  `manifoldBoundary (stellarSubdivision K σ v) = stellarSubdivision (manifoldBoundary K) σ v`.

Together with the higher-face link classification in `CombinatorialManifold.Stellar`, these yield
the main structural theorems on boundaries of combinatorial balls, spheres, and manifolds:

* `StellarEquivalentUpToRelabeling.manifoldBoundary`: intrinsic stellar equivalence induces
  intrinsic stellar equivalence on `manifoldBoundary`.
* `IsCombinatorialBall.isCombinatorialSphere_manifoldBoundary` and
  `IsCombinatorialSphere.manifoldBoundary_eq_bot`: the boundary of a combinatorial `(n + 1)`-ball
  is a combinatorial `n`-sphere, while the boundary of a combinatorial `n`-sphere is void.
* `IsCombinatorialManifold.mem_manifoldBoundary_iff` and
  `IsCombinatorialManifold.singleton_mem_manifoldBoundary_iff`: in a combinatorial
  `(n + 1)`-manifold `K`, a face `ρ ∈ K` lies in `manifoldBoundary K` if and only if `link K ρ` is
  a combinatorial `(n + 1 - ρ.card)`-ball (which in particular forces `ρ.card ≤ n + 1`); thus the
  vertices of `manifoldBoundary K` are precisely the vertices of `K` with combinatorial `n`-ball
  links.
* `IsCombinatorialManifold.isCombinatorialManifold_manifoldBoundary`: the boundary of a
  combinatorial `(n + 1)`-manifold is a combinatorial `n`-manifold.
* `IsCombinatorialManifold.isCombinatorialSphere_link_manifoldBoundary` and
  `IsCombinatorialManifold.manifoldBoundary_manifoldBoundary_eq_bot`: in dimension `n + 2`, every
  vertex of `manifoldBoundary K` has a combinatorial `n`-sphere link, and in every dimension `n`,
  `manifoldBoundary (manifoldBoundary K) = ⊥`.
* `IsCombinatorialManifold.exists_chartedSpace_hasGroupoid_PLGroupoid_manifoldBoundary`: the weak
  realization of `(manifoldBoundary K).restrictVertices` for a combinatorial `(n + 2)`-manifold
  carries a boundaryless PL manifold atlas modelled on `ℝ^(n + 1)`.

## References

* C. P. Rourke, B. J. Sanderson, *Introduction to Piecewise-Linear Topology*, Springer (1972),
  Chapters 2 and 3.
* W. B. R. Lickorish, *Simplicial moves on complexes and manifolds*, Geom. Topol. Monogr. 2
  (1999), 299–320.
-/

public section

open Finset TauCeti

namespace PreAbstractSimplicialComplex

variable {ι κ : Type*}

/-! ### Definition, basic properties, and commutation with links -/

/-- The **combinatorial boundary** of a precomplex `K`: the subcomplex generated by the faces
`τ ∈ K` whose link is a single vertex (`link K τ = simplex {w}`). On a combinatorial
`(n + 1)`-manifold, these are the codimension-one boundary faces, and the vertices of
`manifoldBoundary K` are the vertices of `K` whose links are combinatorial `n`-balls. -/
def manifoldBoundary [DecidableEq ι] (K : PreAbstractSimplicialComplex ι) :
    PreAbstractSimplicialComplex ι where
  faces := {ρ | ρ.Nonempty ∧ ∃ τ ∈ K, ρ ⊆ τ ∧ ∃ w, link K τ = simplex {w}}
  isRelLowerSet_faces := by
    rintro ρ₁ ⟨hne₁, τ, hτ, hsub, hw⟩
    exact ⟨hne₁, fun {_} hle hne₂ => ⟨hne₂, τ, hτ, hle.trans hsub, hw⟩⟩

/-- Membership in `manifoldBoundary K`: `ρ` is nonempty and contained in some face `τ ∈ K` whose
link is a single vertex. -/
theorem mem_manifoldBoundary [DecidableEq ι] {K : PreAbstractSimplicialComplex ι} {ρ : Finset ι} :
    ρ ∈ manifoldBoundary K ↔
      ρ.Nonempty ∧ ∃ τ ∈ K, ρ ⊆ τ ∧ ∃ w, link K τ = simplex {w} :=
  (Iff.rfl)

/-- The combinatorial boundary is a subcomplex. -/
theorem manifoldBoundary_le [DecidableEq ι] (K : PreAbstractSimplicialComplex ι) :
    manifoldBoundary K ≤ K := by
  intro ρ hρ
  obtain ⟨hne, τ, hτ, hsub, -⟩ := mem_manifoldBoundary.mp hρ
  exact (K.isRelLowerSet_faces hτ).2 hsub hne

/-- The combinatorial boundary of the void precomplex is void. -/
@[simp]
theorem manifoldBoundary_bot [DecidableEq ι] :
    manifoldBoundary (⊥ : PreAbstractSimplicialComplex ι) = ⊥ :=
  eq_bot_iff.mpr (manifoldBoundary_le ⊥)

/-- If `K` has finitely many faces, so does `manifoldBoundary K`. -/
theorem finite_faces_manifoldBoundary [DecidableEq ι] {K : PreAbstractSimplicialComplex ι}
    (hK : K.faces.Finite) : (manifoldBoundary K).faces.Finite :=
  hK.subset (manifoldBoundary_le K)

/-- An injective vertex relabeling commutes with `manifoldBoundary`. -/
@[simp]
theorem map_manifoldBoundary [DecidableEq ι] [DecidableEq κ] {K : PreAbstractSimplicialComplex ι}
    (f : ι → κ) (hf : Function.Injective f) :
    (manifoldBoundary K).map f = manifoldBoundary (K.map f) := by
  refine SetLike.ext fun ω => ?_
  rw [mem_map_iff, mem_manifoldBoundary]
  constructor
  · rintro ⟨ρ, hρ, rfl⟩
    obtain ⟨hne, τ, hτ, hsub, w, hw⟩ := mem_manifoldBoundary.mp hρ
    refine ⟨hne.image f, τ.image f, mem_map_iff.mpr ⟨τ, hτ, rfl⟩, Finset.image_mono f hsub,
      f w, ?_⟩
    rw [← map_link f hf, hw, map_simplex, Finset.image_singleton]
  · rintro ⟨hωne, η, hη, hωη, u, hu⟩
    obtain ⟨τ, hτ, rfl⟩ := mem_map_iff.mp hη
    have hmap_link : (link K τ).map f = simplex {u} := by rwa [map_link f hf]
    have hu_mem : ({u} : Finset κ) ∈ (link K τ).map f := by
      rw [hmap_link]; exact singleton_mem_simplex.mpr (Finset.mem_singleton_self u)
    obtain ⟨w, _, rfl⟩ := singleton_mem_map_iff.mp hu_mem
    have hw : link K τ = simplex {w} := map_injective hf <| by
      dsimp only
      rw [hmap_link, map_simplex, Finset.image_singleton]
    let ρ : Finset ι := τ.filter fun x => f x ∈ ω
    have hρω : ρ.image f = ω := by
      ext y
      simp only [ρ, Finset.mem_image, Finset.mem_filter]
      refine ⟨?_, fun hy => ?_⟩
      · rintro ⟨x, ⟨_, hfx⟩, rfl⟩; exact hfx
      · obtain ⟨x, hxτ, rfl⟩ := Finset.mem_image.mp (hωη hy)
        exact ⟨x, ⟨hxτ, hy⟩, rfl⟩
    exact ⟨ρ, mem_manifoldBoundary.mpr
      ⟨Finset.Nonempty.of_image (hρω.symm ▸ hωne), τ, hτ, Finset.filter_subset _ τ, w, hw⟩, hρω⟩

/-- Taking links commutes with `manifoldBoundary` on every precomplex. -/
@[simp]
theorem link_manifoldBoundary [DecidableEq ι] (K : PreAbstractSimplicialComplex ι) (σ : Finset ι) :
    link (manifoldBoundary K) σ = manifoldBoundary (link K σ) := by
  refine SetLike.ext fun ρ => ?_
  rw [mem_link_nonempty, mem_manifoldBoundary, mem_manifoldBoundary]
  constructor
  · rintro ⟨hne, hdis, _, τ, hτ, hsub, w, hw⟩
    have hστ : σ ⊆ τ := Finset.subset_union_right.trans hsub
    have hρdiff : ρ ⊆ τ \ σ :=
      Finset.subset_sdiff.mpr ⟨Finset.subset_union_left.trans hsub, hdis⟩
    have hτ' : τ \ σ ∈ link K σ :=
      mem_link_nonempty.mpr ⟨hne.mono hρdiff, Finset.sdiff_disjoint, by
        rwa [Finset.sdiff_union_of_subset hστ]⟩
    refine ⟨hne, τ \ σ, hτ', hρdiff, w, ?_⟩
    rw [link_link Finset.sdiff_disjoint.symm, Finset.union_comm,
      Finset.sdiff_union_of_subset hστ, hw]
  · rintro ⟨hne, τ', hτ', hsub, w, hw⟩
    obtain ⟨_, hdis, hτ'σ⟩ := mem_link_nonempty.mp hτ'
    refine ⟨hne, hdis.mono_left hsub,
      ⟨hne.mono Finset.subset_union_left, τ' ∪ σ, hτ'σ,
        Finset.union_subset_union_left hsub, w, ?_⟩⟩
    rw [Finset.union_comm, ← link_link hdis.symm, hw]

/-! ### Standard models -/

/-- The combinatorial boundary of any simplex is its simplex boundary. -/
@[simp]
theorem manifoldBoundary_simplex [DecidableEq ι] (V : Finset ι) :
    manifoldBoundary (simplex V) = simplexBoundary V := by
  refine SetLike.ext fun ρ => ?_
  rw [mem_manifoldBoundary, mem_simplexBoundary]
  constructor
  · rintro ⟨hne, τ, hτ, hρτ, w, hw⟩
    have hτV : τ ⊆ V := (mem_simplex.mp hτ).2
    rw [link_simplex hτV] at hw
    have hw_mem : ({w} : Finset ι) ∈ simplex (V \ τ) := by
      rw [hw]; exact singleton_mem_simplex.mpr (Finset.mem_singleton_self w)
    obtain ⟨hwV, hwτ⟩ := Finset.mem_sdiff.mp
      (Finset.singleton_subset_iff.mp (mem_simplex.mp hw_mem).2)
    exact ⟨hne, Finset.ssubset_iff_subset_ne.mpr
      ⟨hρτ.trans hτV, fun hρV => hwτ (hρτ (hρV ▸ hwV))⟩⟩
  · rintro ⟨hne, hproper⟩
    obtain ⟨w, hwV, hwρ⟩ := Finset.exists_of_ssubset hproper
    have hρ_erase : ρ ⊆ V.erase w :=
      Finset.subset_erase.mpr ⟨hproper.subset, hwρ⟩
    have hτ : V.erase w ∈ simplex V :=
      mem_simplex.mpr ⟨hne.mono hρ_erase, Finset.erase_subset w V⟩
    have hsdiff : V \ V.erase w = {w} := by
      ext x; simp only [Finset.mem_sdiff, Finset.mem_erase, Finset.mem_singleton]
      exact ⟨fun ⟨hxV, hx⟩ => Classical.byContradiction fun hxw => hx ⟨hxw, hxV⟩,
        fun hxw => ⟨hxw ▸ hwV, fun h => h.1 hxw⟩⟩
    exact ⟨hne, V.erase w, hτ, hρ_erase, w,
      by rw [link_simplex (Finset.erase_subset w V), hsdiff]⟩

/-- The combinatorial boundary of any simplex boundary is void. -/
@[simp]
theorem manifoldBoundary_simplexBoundary [DecidableEq ι] (V : Finset ι) :
    manifoldBoundary (simplexBoundary V) = ⊥ := by
  refine eq_bot_iff.mpr fun ρ hρ => ?_
  obtain ⟨_, τ, hτ, _, w, hw⟩ := mem_manifoldBoundary.mp hρ
  rw [link_simplexBoundary (mem_simplexBoundary.mp hτ).2.subset] at hw
  exact (simplexBoundary_ne_simplex_singleton (V \ τ) w hw).elim

/-! ### Exact commutation with stellar subdivision and stellar invariance -/

private theorem exists_stellarSubdivision_eq_simplex_singleton_iff [DecidableEq ι]
    {P : PreAbstractSimplicialComplex ι} {α : Finset ι} {v : ι}
    (hv : ({v} : Finset ι) ∉ P) (hα : α.Nonempty) :
    (∃ u, stellarSubdivision P α v = simplex {u}) ↔ ∃ x, P = simplex {x} := by
  constructor
  · rintro ⟨u, hu⟩
    by_cases hαP : α ∈ P
    · have hv_mem : ({v} : Finset ι) ∈ simplex {u} := by
        rw [← hu]; exact singleton_mem_stellarSubdivision_iff.mpr hαP
      have hvu : v = u := Finset.mem_singleton.mp (singleton_mem_simplex.mp hv_mem)
      subst hvu
      obtain ⟨x, hxα⟩ := hα
      have hxP : ({x} : Finset ι) ∈ P := singleton_mem_of_mem hαP hxα
      refine ⟨x, le_antisymm (fun β hβ => mem_simplex.mpr ⟨(P.isRelLowerSet_faces hβ).1,
        fun y hy => ?_⟩) (simplex_le_iff.mpr fun _ => hxP)⟩
      by_contra hyx
      have hy_ne : y ≠ x := Finset.notMem_singleton.mp hyx
      have hyP : ({y} : Finset ι) ∈ P := singleton_mem_of_mem hβ hy
      have hy_sub : ({y} : Finset ι) ∈ simplex {v} := by
        rw [← hu]
        refine (mem_stellarSubdivision_iff_of_notMem
          (notMem_of_singleton_notMem hv hyP)).mpr ⟨hyP, fun hsub => ?_⟩
        exact hy_ne (Finset.mem_singleton.mp (hsub hxα)).symm
      exact hv (Finset.mem_singleton.mp (singleton_mem_simplex.mp hy_sub) ▸ hyP)
    · exact ⟨u, (stellarSubdivision_eq_self_of_notMem hv hα hαP).symm.trans hu⟩
  · rintro ⟨x, rfl⟩
    by_cases hαx : α = {x}
    · subst hαx
      exact ⟨v, stellarSubdivision_simplex_singleton_self x v⟩
    · have hα_not : α ∉ simplex {x} := fun h =>
        hαx (hα.subset_singleton_iff.mp (mem_simplex.mp h).2)
      exact ⟨x, stellarSubdivision_eq_self_of_notMem hv hα hα_not⟩

private theorem link_closedStar_inf_deletion_eq_link_of_sdiff_singleton [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {σ β : Finset ι} {a : ι} (hdiff : σ \ β = {a}) :
    link (closedStar K σ ⊓ deletion K σ) β = link K (β ∪ σ) := by
  have ha : a ∈ σ ∧ a ∉ β := Finset.mem_sdiff.mp (hdiff ▸ Finset.mem_singleton_self a)
  have hβσ : β ∪ σ = insert a β := by
    rw [← Finset.union_sdiff_self_eq_union, hdiff, Finset.union_singleton]
  refine SetLike.ext fun ρ => ?_
  rw [mem_link_nonempty, mem_inf, mem_closedStar_nonempty, mem_deletion, mem_link_nonempty, hβσ,
    Finset.disjoint_insert_right]
  constructor
  · rintro ⟨hne, hdis, ⟨_, hface⟩, _, hnot⟩
    refine ⟨hne, ⟨fun haρ => hnot ?_, hdis⟩, by rwa [← hβσ, ← Finset.union_assoc]⟩
    intro x hxσ
    by_cases hxβ : x ∈ β
    · exact Finset.mem_union_right _ hxβ
    · have hxa : x = a := Finset.mem_singleton.mp (hdiff ▸ Finset.mem_sdiff.mpr ⟨hxσ, hxβ⟩)
      exact Finset.mem_union_left _ (hxa ▸ haρ)
  · rintro ⟨hne, ⟨haρ, hdis⟩, hface⟩
    have hface' : (ρ ∪ β) ∪ σ ∈ K := by rwa [Finset.union_assoc, hβσ]
    have hne' : (ρ ∪ β).Nonempty := hne.mono Finset.subset_union_left
    refine ⟨hne, hdis, ⟨hne', hface'⟩,
      (K.isRelLowerSet_faces hface').2 Finset.subset_union_left hne', fun hsub => ?_⟩
    rcases Finset.mem_union.mp (hsub ha.1) with ha' | ha'
    · exact haρ ha'
    · exact ha.2 ha'

private theorem exists_link_stellarSubdivision_insert_eq_simplex_singleton_iff [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {σ β : Finset ι} {v : ι}
    (hv : ({v} : Finset ι) ∉ K) (hvβ : v ∉ β)
    (hmem : insert v β ∈ stellarSubdivision K σ v) :
    (∃ u, link (stellarSubdivision K σ v) (insert v β) = simplex {u}) ↔
      (∃ a, σ \ β = {a}) ∧ ∃ x, link K (β ∪ σ) = simplex {x} := by
  obtain ⟨hnsub, hβσK⟩ := (insert_mem_stellarSubdivision_iff hvβ).mp hmem
  rw [link_stellarSubdivision_insert hv hvβ]
  constructor
  · rintro ⟨u, hu⟩
    obtain ⟨a, ha⟩ := Finset.sdiff_nonempty.mpr hnsub
    have hdiff : σ \ β = {a} := by
      ext b
      simp only [Finset.mem_singleton]
      refine ⟨fun hb => ?_, fun hba => hba ▸ ha⟩
      by_contra hba
      have hmem_pair {c d : ι} (hc : c ∈ σ \ β) (hd : d ∈ σ \ β) (hcd : c ≠ d) :
          ({c} : Finset ι) ∈ link (closedStar K σ ⊓ deletion K σ) β := by
        obtain ⟨hcσ, hcβ⟩ := Finset.mem_sdiff.mp hc
        obtain ⟨hdσ, hdβ⟩ := Finset.mem_sdiff.mp hd
        have hc_face : ({c} ∪ β) ∪ σ ∈ K := by
          have : ({c} ∪ β) ∪ σ = β ∪ σ := by
            rw [Finset.union_assoc, Finset.singleton_union,
              Finset.insert_eq_of_mem (Finset.mem_union_right _ hcσ)]
          rwa [this]
        have hne' : ({c} ∪ β).Nonempty := Finset.singleton_nonempty c |>.mono subset_union_left
        refine mem_link_nonempty.mpr ⟨Finset.singleton_nonempty c,
          Finset.disjoint_singleton_left.mpr hcβ,
          mem_inf.mpr ⟨mem_closedStar_nonempty.mpr ⟨hne', hc_face⟩,
            mem_deletion.mpr ⟨(K.isRelLowerSet_faces hc_face).2 subset_union_left hne',
              fun hsub => ?_⟩⟩⟩
        rcases Finset.mem_union.mp (hsub hdσ) with hdc | hdβ'
        · exact hcd (Finset.mem_singleton.mp hdc).symm
        · exact hdβ hdβ'
      have ha_u : a = u := Finset.mem_singleton.mp <| singleton_mem_simplex.mp <|
        hu ▸ hmem_pair ha hb (Ne.symm hba)
      have hb_u : b = u := Finset.mem_singleton.mp <| singleton_mem_simplex.mp <|
        hu ▸ hmem_pair hb ha hba
      exact hba (hb_u.trans ha_u.symm)
    rw [link_closedStar_inf_deletion_eq_link_of_sdiff_singleton hdiff] at hu
    exact ⟨⟨a, hdiff⟩, u, hu⟩
  · rintro ⟨⟨a, hdiff⟩, x, hx⟩
    rw [link_closedStar_inf_deletion_eq_link_of_sdiff_singleton hdiff]
    exact ⟨x, hx⟩

private theorem erase_union_mem_manifoldBoundary_of_link_stellarSubdivision [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {σ η : Finset ι} {v u : ι}
    (hv : ({v} : Finset ι) ∉ K) (hvη : v ∈ η)
    (hη : η ∈ stellarSubdivision K σ v)
    (hu : link (stellarSubdivision K σ v) η = simplex {u}) :
    ¬ σ ⊆ η.erase v ∧ η.erase v ∪ σ ∈ K ∧ ∃ x, link K (η.erase v ∪ σ) = simplex {x} := by
  have hvη' : v ∉ η.erase v := Finset.notMem_erase v η
  have hηeq : insert v (η.erase v) = η := Finset.insert_erase hvη
  have hηL : insert v (η.erase v) ∈ stellarSubdivision K σ v := by rwa [hηeq]
  have hu' : link (stellarSubdivision K σ v) (insert v (η.erase v)) = simplex {u} := by
    rwa [hηeq]
  obtain ⟨hnsub, hησK⟩ := (insert_mem_stellarSubdivision_iff hvη').mp hηL
  obtain ⟨-, x, hx⟩ := (exists_link_stellarSubdivision_insert_eq_simplex_singleton_iff
    hv hvη' hηL).mp ⟨u, hu'⟩
  exact ⟨hnsub, hησK, x, hx⟩

private theorem exists_insert_stellarSubdivision_link_singleton [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {σ τ ξ : Finset ι} {v x : ι}
    (hv : ({v} : Finset ι) ∉ K) (hτ : τ ∈ K) (hστ : σ ⊆ τ) (hξτ : ξ ⊆ τ)
    (hnsub : ¬ σ ⊆ ξ) (hx : link K τ = simplex {x}) :
    ∃ β u, v ∉ β ∧ insert v β ∈ stellarSubdivision K σ v ∧ ξ ⊆ β ∧
      link (stellarSubdivision K σ v) (insert v β) = simplex {u} := by
  obtain ⟨a, haσ, haξ⟩ := Finset.not_subset.mp hnsub
  let β : Finset ι := τ.erase a
  have hvβ : v ∉ β := fun h =>
    notMem_of_singleton_notMem hv hτ (Finset.erase_subset a τ h)
  have hdiff : σ \ β = {a} := by
    ext y; simp only [β, Finset.mem_sdiff, Finset.mem_erase, Finset.mem_singleton]
    exact ⟨fun ⟨hyσ, hy⟩ => Classical.byContradiction fun hya => hy ⟨hya, hστ hyσ⟩,
      fun hya => ⟨hya ▸ haσ, fun h => h.1 hya⟩⟩
  have hβσ : β ∪ σ = τ := by
    ext y; simp only [β, Finset.mem_union, Finset.mem_erase]
    exact ⟨fun h => h.elim (fun h => h.2) (fun h => hστ h),
      fun hyτ => by_cases (fun hya : y = a => Or.inr (hya ▸ haσ))
        (fun hya => Or.inl ⟨hya, hyτ⟩)⟩
  have hηL : insert v β ∈ stellarSubdivision K σ v :=
    (insert_mem_stellarSubdivision_iff hvβ).mpr
      ⟨fun h => (Finset.notMem_erase a τ (h haσ)).elim, hβσ.symm ▸ hτ⟩
  obtain ⟨u, hu⟩ := (exists_link_stellarSubdivision_insert_eq_simplex_singleton_iff
    hv hvβ hηL).mpr ⟨⟨a, hdiff⟩, x, hβσ.symm ▸ hx⟩
  exact ⟨β, u, hvβ, hηL, Finset.subset_erase.mpr ⟨hξτ, haξ⟩, hu⟩

private theorem mem_manifoldBoundary_stellarSubdivision_iff_of_mem [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {σ ρ : Finset ι} {v : ι}
    (hv : ({v} : Finset ι) ∉ K) (hσne : σ.Nonempty) (hvρ : v ∈ ρ) :
    ρ ∈ manifoldBoundary (stellarSubdivision K σ v) ↔
      ρ ∈ stellarSubdivision (manifoldBoundary K) σ v := by
  have hv' : v ∉ ρ.erase v := Finset.notMem_erase v ρ
  have hρeq : insert v (ρ.erase v) = ρ := Finset.insert_erase hvρ
  rw [← hρeq, insert_mem_stellarSubdivision_iff hv', hρeq, mem_manifoldBoundary]
  constructor
  · rintro ⟨_, η, hη, hρη, u, hu⟩
    obtain ⟨hnsub, hησK, x, hx⟩ :=
      erase_union_mem_manifoldBoundary_of_link_stellarSubdivision hv (hρη hvρ) hη hu
    have herase_sub : ρ.erase v ⊆ η.erase v := Finset.erase_subset_erase v hρη
    exact ⟨fun hsub => hnsub (hsub.trans herase_sub),
      mem_manifoldBoundary.mpr ⟨hσne.mono Finset.subset_union_right,
        η.erase v ∪ σ, hησK, Finset.union_subset_union_left herase_sub, x, hx⟩⟩
  · rintro ⟨hnsub, hunionB⟩
    obtain ⟨_, τ, hτ, hsubτ, x, hx⟩ := mem_manifoldBoundary.mp hunionB
    obtain ⟨β, u, -, hηL, hξβ, hu⟩ := exists_insert_stellarSubdivision_link_singleton hv hτ
      (Finset.subset_union_right.trans hsubτ) (Finset.subset_union_left.trans hsubτ) hnsub hx
    refine ⟨⟨v, hvρ⟩, insert v β, hηL, ?_, u, hu⟩
    rw [← hρeq]
    exact Finset.insert_subset_insert v hξβ

/-- **Exact commutation of `manifoldBoundary` with stellar subdivision** at a fresh vertex:
starring any set `σ` at `{v} ∉ K` stars `manifoldBoundary K` at `σ` (which leaves
`manifoldBoundary K` unchanged whenever `σ ∉ manifoldBoundary K`). -/
@[simp]
theorem manifoldBoundary_stellarSubdivision [DecidableEq ι] {K : PreAbstractSimplicialComplex ι}
    {σ : Finset ι} {v : ι} (hv : ({v} : Finset ι) ∉ K) :
    manifoldBoundary (stellarSubdivision K σ v) =
      stellarSubdivision (manifoldBoundary K) σ v := by
  rcases σ.eq_empty_or_nonempty with rfl | hσne
  · simp
  by_cases hσK : σ ∈ K
  · refine SetLike.ext fun ρ => ?_
    by_cases hvρ : v ∈ ρ
    · exact mem_manifoldBoundary_stellarSubdivision_iff_of_mem hv hσne hvρ
    · rw [mem_stellarSubdivision_iff_of_notMem hvρ, mem_manifoldBoundary]
      constructor
      · rintro ⟨hne, η, hη, hρη, u, hu⟩
        by_cases hvη : v ∈ η
        · obtain ⟨hnsub, hησK, x, hx⟩ :=
            erase_union_mem_manifoldBoundary_of_link_stellarSubdivision hv hvη hη hu
          have hρη' : ρ ⊆ η.erase v := Finset.subset_erase.mpr ⟨hρη, hvρ⟩
          exact ⟨mem_manifoldBoundary.mpr
            ⟨hne, η.erase v ∪ σ, hησK, hρη'.trans Finset.subset_union_left, x, hx⟩,
            fun hsub => hnsub (hsub.trans hρη')⟩
        · obtain ⟨hηK, hnsub⟩ := (mem_stellarSubdivision_iff_of_notMem hvη).mp hη
          rw [link_stellarSubdivision_of_notMem hvη] at hu
          obtain ⟨x, hx⟩ := (exists_stellarSubdivision_eq_simplex_singleton_iff
            (fun h => hv (link_le h)) (Finset.sdiff_nonempty.mpr hnsub)).mp ⟨u, hu⟩
          exact ⟨mem_manifoldBoundary.mpr ⟨hne, η, hηK, hρη, x, hx⟩,
            fun hsub => hnsub (hsub.trans hρη)⟩
      · rintro ⟨hρB, hnsub⟩
        obtain ⟨hne, τ, hτ, hρτ, x, hx⟩ := mem_manifoldBoundary.mp hρB
        by_cases hστ : σ ⊆ τ
        · obtain ⟨β, u, -, hηL, hρβ, hu⟩ :=
            exists_insert_stellarSubdivision_link_singleton hv hτ hστ hρτ hnsub hx
          exact ⟨hne, insert v β, hηL, hρβ.trans (Finset.subset_insert v β), u, hu⟩
        · have hvτ : v ∉ τ := notMem_of_singleton_notMem hv hτ
          obtain ⟨u, hu⟩ := (exists_stellarSubdivision_eq_simplex_singleton_iff
            (fun h => hv (link_le h)) (Finset.sdiff_nonempty.mpr hστ)).mpr ⟨x, hx⟩
          exact ⟨hne, τ, (mem_stellarSubdivision_iff_of_notMem hvτ).mpr ⟨hτ, hστ⟩, hρτ,
            u, by rwa [link_stellarSubdivision_of_notMem hvτ]⟩
  · have hvB : ({v} : Finset ι) ∉ manifoldBoundary K := fun h => hv (manifoldBoundary_le K h)
    have hσB : σ ∉ manifoldBoundary K := fun h => hσK (manifoldBoundary_le K h)
    rw [stellarSubdivision_eq_self_of_notMem hv hσne hσK,
      stellarSubdivision_eq_self_of_notMem hvB hσne hσB]

/-- Starring an interior face (`σ ∉ manifoldBoundary K`) at a fresh vertex leaves
`manifoldBoundary K` unchanged. -/
theorem manifoldBoundary_stellarSubdivision_of_notMem [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {σ : Finset ι} {v : ι}
    (hv : ({v} : Finset ι) ∉ K) (hσne : σ.Nonempty) (hσ : σ ∉ manifoldBoundary K) :
    manifoldBoundary (stellarSubdivision K σ v) = manifoldBoundary K := by
  rw [manifoldBoundary_stellarSubdivision hv,
    stellarSubdivision_eq_self_of_notMem (fun h => hv (manifoldBoundary_le K h)) hσne hσ]

/-- Same-type stellar equivalence induces same-type stellar equivalence on `manifoldBoundary`. -/
theorem StellarEquivalent.manifoldBoundary [DecidableEq ι]
    {K L : PreAbstractSimplicialComplex ι} (h : StellarEquivalent K L) :
    StellarEquivalent (PreAbstractSimplicialComplex.manifoldBoundary K)
      (PreAbstractSimplicialComplex.manifoldBoundary L) := by
  apply h.induction_on
  · intro A B hmove
    obtain ⟨σ, v, hσ, hv, rfl⟩ := isStellarMove_iff.mp hmove
    rw [manifoldBoundary_stellarSubdivision hv]
    have hvB : ({v} : Finset _) ∉ PreAbstractSimplicialComplex.manifoldBoundary A :=
      fun h => hv (manifoldBoundary_le A h)
    by_cases hσB : σ ∈ PreAbstractSimplicialComplex.manifoldBoundary A
    · exact stellarEquivalent_stellarSubdivision hσB hvB
    · rw [stellarSubdivision_eq_self_of_notMem hvB (A.isRelLowerSet_faces hσ).1 hσB]
  · intro _; exact .refl _
  · intro _ _ ih; exact ih.symm
  · intro _ _ _ ih₁ ih₂; exact ih₁.trans ih₂

/-- Intrinsic stellar equivalence induces intrinsic stellar equivalence on `manifoldBoundary`. -/
theorem StellarEquivalentUpToRelabeling.manifoldBoundary [DecidableEq ι]
    {K L : PreAbstractSimplicialComplex ι} (h : StellarEquivalentUpToRelabeling K L) :
    StellarEquivalentUpToRelabeling (PreAbstractSimplicialComplex.manifoldBoundary K)
      (PreAbstractSimplicialComplex.manifoldBoundary L) := by
  apply h.induction_on
  · intro A B f g he
    refine .of_common_relabeling f g ?_
    simpa only [map_manifoldBoundary _ f.injective, map_manifoldBoundary _ g.injective] using
      he.manifoldBoundary
  · intro _; exact .refl _
  · intro _ _ ih; exact ih.symm
  · intro _ _ _ ih₁ ih₂; exact ih₁.trans ih₂

/-! ### Boundaries of combinatorial balls, spheres, and manifolds -/

/-- The combinatorial boundary of a combinatorial `(n + 1)`-ball is a combinatorial `n`-sphere. -/
theorem IsCombinatorialBall.isCombinatorialSphere_manifoldBoundary [DecidableEq ι]
    {B : PreAbstractSimplicialComplex ι} {n : ℕ} (hB : IsCombinatorialBall B (n + 1)) :
    IsCombinatorialSphere (manifoldBoundary B) n := by
  obtain ⟨V, hV, he⟩ := isCombinatorialBall_iff.mp hB
  exact isCombinatorialSphere_iff.mpr
    ⟨V, hV, manifoldBoundary_simplex V ▸ he.manifoldBoundary⟩

/-- The combinatorial boundary of a combinatorial `n`-sphere is void. -/
theorem IsCombinatorialSphere.manifoldBoundary_eq_bot [DecidableEq ι]
    {S : PreAbstractSimplicialComplex ι} {n : ℕ} (hS : IsCombinatorialSphere S n) :
    manifoldBoundary S = ⊥ := by
  obtain ⟨V, _, he⟩ := isCombinatorialSphere_iff.mp hS
  have he_bot : StellarEquivalentUpToRelabeling (manifoldBoundary S) ⊥ :=
    manifoldBoundary_simplexBoundary V ▸ he.manifoldBoundary
  exact dimension_eq_bot_iff.mp (he_bot.dimension_eq.symm.trans dimension_bot)

/-- The combinatorial boundary of a `0`-dimensional combinatorial manifold is void. -/
theorem IsCombinatorialManifold.manifoldBoundary_eq_bot_of_zero [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} (hK : IsCombinatorialManifold K 0) :
    manifoldBoundary K = ⊥ := by
  refine eq_bot_iff.mpr fun ρ hρ => ?_
  obtain ⟨_, τ, hτ, _, w, hw⟩ := mem_manifoldBoundary.mp hρ
  obtain ⟨u, rfl⟩ := dimension_le_zero_iff.mp hK.dimension_le τ hτ
  rw [isCombinatorialManifold_zero_iff.mp hK hτ] at hw
  exact Set.notMem_empty {w} (hw ▸ singleton_mem_simplex.mpr (Finset.mem_singleton_self w))

/-- Every boundary face of a combinatorial `(n + 1)`-manifold has cardinality at most `n + 1`
(codimension at least `1`). -/
theorem IsCombinatorialManifold.card_le_of_mem_manifoldBoundary [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {ρ : Finset ι} {n : ℕ}
    (hK : IsCombinatorialManifold K (n + 1)) (hρ : ρ ∈ manifoldBoundary K) :
    ρ.card ≤ n + 1 := by
  obtain ⟨_, τ, hτ, hρτ, w, hw⟩ := mem_manifoldBoundary.mp hρ
  have hτ_le : τ.card ≤ n + 2 := by
    have : τ.card - 1 ≤ n + 1 := by exact_mod_cast dimension_le_iff.mp hK.dimension_le τ hτ
    omega
  have hτ_ne_top : τ.card ≠ n + 2 := fun htop =>
    (isCombinatorialBall_simplex (V := {w}) (n := 0) (by simp)).ne_bot
      (hw.symm.trans ((hK.link_eq_bot_iff hτ).mpr htop))
  exact (Finset.card_le_card hρτ).trans (Nat.le_of_lt_succ (Nat.lt_of_le_of_ne hτ_le hτ_ne_top))

/-- Every face in the combinatorial boundary of a combinatorial `(n + 1)`-manifold has a
combinatorial `(n + 1 - ρ.card)`-ball link in `K`. -/
theorem IsCombinatorialManifold.isCombinatorialBall_link_of_mem_manifoldBoundary [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {ρ : Finset ι} {n : ℕ}
    (hK : IsCombinatorialManifold K (n + 1)) (hρB : ρ ∈ manifoldBoundary K) :
    IsCombinatorialBall (link K ρ) (n + 1 - ρ.card) := by
  have hρK : ρ ∈ K := manifoldBoundary_le K hρB
  have hρ_card : ρ.card ≤ n + 1 := hK.card_le_of_mem_manifoldBoundary hρB
  obtain ⟨_, τ, hτ, hρτ, w, hw⟩ := mem_manifoldBoundary.mp hρB
  have hτ_card_le : τ.card ≤ n + 1 :=
    hK.card_le_of_mem_manifoldBoundary
      (mem_manifoldBoundary.mpr ⟨(K.isRelLowerSet_faces hτ).1, τ, hτ, Subset.rfl, w, hw⟩)
  rcases Nat.eq_zero_or_pos (n + 1 - ρ.card) with hd0 | hdpos
  · have hτ_card : τ.card ≤ ρ.card := by omega
    have hρeq : ρ = τ := Finset.eq_of_subset_of_card_le hρτ hτ_card
    subst hρeq
    rw [hd0, hw]
    exact isCombinatorialBall_simplex (by simp)
  · obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hdpos.ne'
    rcases hK.isCombinatorialSphere_or_isCombinatorialBall_link hρK hρ_card with hs | hb
    · rw [hm] at hs
      have hdim_τ : dimension (link K τ) = ((n + 1 - τ.card : ℕ) : WithBot ℕ∞) :=
        hK.dimension_link hτ hτ_card_le
      rw [hw, dimension_simplex (Finset.singleton_nonempty w), Finset.card_singleton] at hdim_τ
      have hτ_card : τ.card = n + 1 := by
        have : n + 1 - τ.card = 0 := by exact_mod_cast hdim_τ.symm
        omega
      have hproper : ρ ⊂ τ := Finset.ssubset_iff_subset_ne.mpr
        ⟨hρτ, fun h => by rw [h, hτ_card] at hm; simp at hm⟩
      obtain ⟨u, hu⟩ := Finset.exists_of_ssubset hproper
      have hdiff_mem : τ \ ρ ∈ link (manifoldBoundary K) ρ :=
        mem_link_nonempty.mpr ⟨⟨u, Finset.mem_sdiff.mpr hu⟩, Finset.sdiff_disjoint, by
          rw [Finset.sdiff_union_of_subset hproper.subset]
          exact mem_manifoldBoundary.mpr ⟨(K.isRelLowerSet_faces hτ).1, τ, hτ,
            Subset.rfl, w, hw⟩⟩
      rw [link_manifoldBoundary, hs.manifoldBoundary_eq_bot] at hdiff_mem
      exact hdiff_mem.elim
    · exact hb

/-- **Characterization of boundary faces in a combinatorial `(n + 1)`-manifold**: a finset `ρ`
belongs to `manifoldBoundary K` if and only if `ρ ∈ K` and `link K ρ` is a combinatorial
`(n + 1 - ρ.card)`-ball. -/
theorem IsCombinatorialManifold.mem_manifoldBoundary_iff [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {ρ : Finset ι} {n : ℕ}
    (hK : IsCombinatorialManifold K (n + 1)) :
    ρ ∈ manifoldBoundary K ↔
      ρ ∈ K ∧ IsCombinatorialBall (link K ρ) (n + 1 - ρ.card) := by
  refine ⟨fun hρB => ⟨manifoldBoundary_le K hρB,
    hK.isCombinatorialBall_link_of_mem_manifoldBoundary hρB⟩, ?_⟩
  rintro ⟨hρK, hb⟩
  rcases Nat.eq_zero_or_pos (n + 1 - ρ.card) with hd0 | hdpos
  · rw [hd0] at hb
    obtain ⟨w, hw⟩ := isCombinatorialBall_zero_iff.mp hb
    exact mem_manifoldBoundary.mpr ⟨(K.isRelLowerSet_faces hρK).1, ρ, hρK, Subset.rfl, w, hw⟩
  · obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hdpos.ne'
    rw [hm] at hb
    have hne_bot : manifoldBoundary (link K ρ) ≠ ⊥ :=
      hb.isCombinatorialSphere_manifoldBoundary.ne_bot
    obtain ⟨α, hα, -⟩ := IsConcreteLE.exists_of_lt (bot_lt_iff_ne_bot.mpr hne_bot)
    rw [← link_manifoldBoundary] at hα
    exact (manifoldBoundary K).isRelLowerSet_faces ((mem_link_nonempty.mp hα).2.2) |>.2
      Finset.subset_union_right (K.isRelLowerSet_faces hρK).1

/-- **Boundary vertices of a combinatorial `(n + 1)`-manifold**: `{v}` belongs to
`manifoldBoundary K` if and only if `{v} ∈ K` and `link K {v}` is a combinatorial `n`-ball. -/
theorem IsCombinatorialManifold.singleton_mem_manifoldBoundary_iff [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {v : ι} {n : ℕ}
    (hK : IsCombinatorialManifold K (n + 1)) :
    ({v} : Finset ι) ∈ manifoldBoundary K ↔
      ({v} : Finset ι) ∈ K ∧ IsCombinatorialBall (link K {v}) n := by
  simpa only [Finset.card_singleton, Nat.add_sub_cancel] using
    hK.mem_manifoldBoundary_iff (ρ := {v})

/-- A combinatorial `(n + 1)`-manifold has void boundary if and only if every vertex link is a
combinatorial `n`-sphere. -/
theorem IsCombinatorialManifold.manifoldBoundary_eq_bot_iff [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {n : ℕ}
    (hK : IsCombinatorialManifold K (n + 1)) :
    manifoldBoundary K = ⊥ ↔
      ∀ ⦃v : ι⦄, ({v} : Finset ι) ∈ K → IsCombinatorialSphere (link K {v}) n := by
  constructor
  · intro hbot v hv
    rcases isCombinatorialManifold_succ_iff.mp hK hv with hs | hb
    · exact hs
    · have hvB : ({v} : Finset ι) ∈ manifoldBoundary K :=
        hK.singleton_mem_manifoldBoundary_iff.mpr ⟨hv, hb⟩
      rw [hbot] at hvB
      exact hvB.elim
  · intro hall
    refine eq_bot_iff.mpr fun ρ hρ => ?_
    obtain ⟨v, hvρ⟩ := ((manifoldBoundary K).isRelLowerSet_faces hρ).1
    have hvB : ({v} : Finset ι) ∈ manifoldBoundary K := singleton_mem_of_mem hρ hvρ
    obtain ⟨hvK, hb⟩ := hK.singleton_mem_manifoldBoundary_iff.mp hvB
    exact ((hall hvK).not_isCombinatorialBall hb).elim

/-- If every vertex link of `K` is a combinatorial `n`-sphere, then the link of every face
`σ ∈ K` with `σ.card ≤ n + 1` is a combinatorial `(n + 1 - σ.card)`-sphere. -/
theorem isCombinatorialSphere_link_of_forall_singleton [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {σ : Finset ι} {n : ℕ}
    (hK : ∀ ⦃v : ι⦄, ({v} : Finset ι) ∈ K → IsCombinatorialSphere (link K {v}) n)
    (hσ : σ ∈ K) (hcard : σ.card ≤ n + 1) :
    IsCombinatorialSphere (link K σ) (n + 1 - σ.card) := by
  have hM : IsCombinatorialManifold K (n + 1) :=
    isCombinatorialManifold_succ_iff.mpr fun v hv => Or.inl (hK hv)
  have hbot : manifoldBoundary K = ⊥ := hM.manifoldBoundary_eq_bot_iff.mpr hK
  refine (hM.isCombinatorialSphere_or_isCombinatorialBall_link hσ hcard).resolve_right fun hb => ?_
  have hσB : σ ∈ manifoldBoundary K := hM.mem_manifoldBoundary_iff.mpr ⟨hσ, hb⟩
  rw [hbot] at hσB
  exact hσB

/-- Every non-maximal face of a combinatorial `(n + 1)`-sphere has a combinatorial-sphere link of
the complementary dimension. -/
theorem IsCombinatorialSphere.isCombinatorialSphere_link [DecidableEq ι]
    {S : PreAbstractSimplicialComplex ι} {σ : Finset ι} {n : ℕ}
    (hS : IsCombinatorialSphere S (n + 1)) (hσ : σ ∈ S) (hcard : σ.card ≤ n + 1) :
    IsCombinatorialSphere (link S σ) (n + 1 - σ.card) :=
  isCombinatorialSphere_link_of_forall_singleton
    (hS.isCombinatorialManifold.manifoldBoundary_eq_bot_iff.mp hS.manifoldBoundary_eq_bot)
    hσ hcard

/-- Every positive-dimensional combinatorial `(n + 1)`-ball has at least one vertex whose link is a
combinatorial `n`-ball. -/
theorem IsCombinatorialBall.exists_isCombinatorialBall_link_singleton [DecidableEq ι]
    {B : PreAbstractSimplicialComplex ι} {n : ℕ} (hB : IsCombinatorialBall B (n + 1)) :
    ∃ v : ι, ({v} : Finset ι) ∈ B ∧ IsCombinatorialBall (link B {v}) n := by
  obtain ⟨ρ, hρ, -⟩ := IsConcreteLE.exists_of_lt
    (bot_lt_iff_ne_bot.mpr hB.isCombinatorialSphere_manifoldBoundary.ne_bot)
  obtain ⟨v, hvρ⟩ := ((manifoldBoundary B).isRelLowerSet_faces hρ).1
  exact ⟨v, hB.isCombinatorialManifold.singleton_mem_manifoldBoundary_iff.mp
    (singleton_mem_of_mem hρ hvρ)⟩

/-! ### The boundary of a combinatorial manifold is a closed combinatorial manifold -/

/-- Every vertex of the boundary of a combinatorial `(n + 2)`-manifold has a combinatorial
`n`-sphere link in `manifoldBoundary K`. -/
theorem IsCombinatorialManifold.isCombinatorialSphere_link_manifoldBoundary [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {v : ι} {n : ℕ}
    (hK : IsCombinatorialManifold K (n + 2)) (hv : ({v} : Finset ι) ∈ manifoldBoundary K) :
    IsCombinatorialSphere (link (manifoldBoundary K) {v}) n := by
  rw [link_manifoldBoundary]
  exact (hK.singleton_mem_manifoldBoundary_iff.mp hv).2.isCombinatorialSphere_manifoldBoundary

/-- **The boundary of a combinatorial `(n + 1)`-manifold is a combinatorial `n`-manifold.** -/
theorem IsCombinatorialManifold.isCombinatorialManifold_manifoldBoundary [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {n : ℕ}
    (hK : IsCombinatorialManifold K (n + 1)) :
    IsCombinatorialManifold (manifoldBoundary K) n := by
  cases n with
  | zero =>
      refine isCombinatorialManifold_zero_iff.mpr fun v hv => ?_
      obtain ⟨_, hb⟩ := hK.singleton_mem_manifoldBoundary_iff.mp hv
      obtain ⟨w, hw⟩ := isCombinatorialBall_zero_iff.mp hb
      rw [link_manifoldBoundary, hw, manifoldBoundary_simplex, simplexBoundary_singleton]
  | succ n =>
      exact isCombinatorialManifold_succ_iff.mpr fun v hv =>
        Or.inl (hK.isCombinatorialSphere_link_manifoldBoundary hv)

/-- **The boundary of a combinatorial manifold has empty boundary** (`∂(∂K) = ⊥`) in all
dimensions. -/
theorem IsCombinatorialManifold.manifoldBoundary_manifoldBoundary_eq_bot [DecidableEq ι]
    {K : PreAbstractSimplicialComplex ι} {n : ℕ}
    (hK : IsCombinatorialManifold K n) :
    manifoldBoundary (manifoldBoundary K) = ⊥ := by
  cases n with
  | zero =>
      rw [hK.manifoldBoundary_eq_bot_of_zero, manifoldBoundary_bot]
  | succ n =>
      cases n with
      | zero =>
          exact hK.isCombinatorialManifold_manifoldBoundary.manifoldBoundary_eq_bot_of_zero
      | succ n =>
          exact hK.isCombinatorialManifold_manifoldBoundary.manifoldBoundary_eq_bot_iff.mpr
            fun _ hv => hK.isCombinatorialSphere_link_manifoldBoundary hv

end PreAbstractSimplicialComplex

/-! ### Boundaryless PL manifold structure on the boundary realization -/

public noncomputable section

open scoped Manifold

namespace PreAbstractSimplicialComplex

/-- The weak realization of `(manifoldBoundary K).restrictVertices` for a combinatorial
`(n + 2)`-manifold `K` carries a boundaryless PL manifold atlas modelled on `ℝ^(n + 1)`. No
finiteness or countability of `K` is assumed. -/
theorem IsCombinatorialManifold.exists_chartedSpace_hasGroupoid_PLGroupoid_manifoldBoundary
    {ι : Type*} [DecidableEq ι] {K : PreAbstractSimplicialComplex ι} {n : ℕ}
    (hK : IsCombinatorialManifold K (n + 2)) :
    ∃ C : ChartedSpace (Fin (n + 1) → ℝ)
        (AbstractSimplicialComplex.Realization (manifoldBoundary K).restrictVertices),
      let := C
      HasGroupoid (AbstractSimplicialComplex.Realization (manifoldBoundary K).restrictVertices)
        (PLGroupoid 𝓘(ℝ, Fin (n + 1) → ℝ)) := by
  apply AbstractSimplicialComplex.exists_chartedSpace_hasGroupoid_of_isCombinatorialSphere_link
  intro v
  apply (isCombinatorialSphere_map_iff (Subtype.val_injective :
    Function.Injective (Subtype.val : _ → ι))).mp
  rw [map_link _ Subtype.val_injective, Finset.image_singleton, map_restrictVertices]
  exact hK.isCombinatorialSphere_link_manifoldBoundary v.2

end PreAbstractSimplicialComplex

end
