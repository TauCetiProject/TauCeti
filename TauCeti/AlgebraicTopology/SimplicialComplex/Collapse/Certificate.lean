module

public import TauCeti.AlgebraicTopology.SimplicialComplex.Collapse.Basic
import Mathlib.Data.Finset.Grade

/-!
# Bit-mask certificates for simplicial collapse

A finite precomplex on `Fin n` can be presented by a list of generating faces, each encoded as
a natural number whose set bits are the vertices of the face.  This file gives a Boolean
checker for a proposed sequence of elementary collapses of such a presentation, together with
its soundness theorem: an accepted certificate yields a collapse to a one-vertex complex.

A step of a certificate is a pair `(s, i)`: the face with mask `s` is to be collapsed through its
coface obtained by adjoining the vertex `i`.  The checker verifies that this coface is one of the
generators and that every generator containing the face is contained in the coface; then the
pair is free.  Deleting it replaces the generators containing the face by the facets of the
coface that omit a vertex of the face.  All operations are bitwise operations on natural
numbers, so a certificate with hundreds of steps can be verified by `decide +kernel`; the
checker definitions are exposed for this purpose.

The face `maskFace n m` is the part of `Finset.equivBitIndices m` below `n`, viewed in `Fin n`.
Working in `Fin n` lets the kernel decode a mask by testing its first `n` bits.

## References

* C. P. Rourke and B. J. Sanderson, *Introduction to Piecewise-Linear Topology* (1972),
  Chapter 3 (simplicial collapse).

## Main definitions

All declarations are in the namespace `TauCeti.PreAbstractSimplicialComplex`.

* `maskFace`: the subset of `Fin n` encoded by a bit mask.
* `ofMasks`: the precomplex generated by a list of masks.
* `isFreeMaskStep`: the Boolean test for one elementary collapse.
* `deleteMaskStep`: the generators after that collapse.
* `checkMaskCollapse`: the Boolean test for a whole collapse sequence ending at a single vertex.
* `checkMaskCollapseTo`: the Boolean test for a collapse sequence ending at a prescribed complex.
* `checkMaskNoFreePair`: the Boolean test that a presentation has no free pair.

## Main results

* `isFreeMaskStep_eq_true_iff`: the conditions under which a step is accepted.
* `isFreePair_ofMasks_of_isFreeMaskStep`: an accepted step is a free pair.
* `deletion_ofMasks_of_isFreeMaskStep`: deleting that free pair gives the complex generated by the
  updated masks.
* `collapsible_ofMasks_of_checkMaskCollapse`: an accepted certificate proves collapsibility.
* `collapsesTo_ofMasks_of_checkMaskCollapseTo`: an accepted certificate proves a collapse onto
  the prescribed complex.
* `not_isFreePair_ofMasks_of_checkMaskNoFreePair`: an accepted test rules out free pairs.
-/

public section

namespace TauCeti.PreAbstractSimplicialComplex

open _root_.PreAbstractSimplicialComplex

variable {n : ℕ}

/-- The subset of `Fin n` whose members are the indices of the set bits of `m`. Bits at
positions `n` and above are ignored. -/
@[expose] def maskFace (n m : ℕ) : Finset (Fin n) :=
  {i | m.testBit i}

/-- A vertex lies in the face of `m` exactly when its bit is set. -/
@[simp]
theorem mem_maskFace {m : ℕ} {i : Fin n} : i ∈ maskFace n m ↔ m.testBit i = true := by
  simp [maskFace]

/-- If `s` is a bitwise submask of `g`, the face of `s` is contained in the face of `g`. -/
theorem maskFace_subset_maskFace {s g : ℕ} (h : s &&& g = s) :
    maskFace n s ⊆ maskFace n g := by
  intro i hi
  rw [mem_maskFace] at hi ⊢
  rw [← h, Nat.testBit_and] at hi
  exact (Bool.and_eq_true _ _ ▸ hi).2

/-- For a mask with no bits at positions `n` and above, containment of faces is the bitwise
submask relation. -/
theorem maskFace_subset_maskFace_iff {s g : ℕ} (hs : s < 2 ^ n) :
    maskFace n s ⊆ maskFace n g ↔ s &&& g = s := by
  refine ⟨fun h => Nat.eq_of_testBit_eq fun j => ?_, maskFace_subset_maskFace⟩
  rw [Nat.testBit_and]
  by_cases hj : j < n
  · cases hsj : s.testBit j
    · rfl
    · have := h ((mem_maskFace (i := ⟨j, hj⟩)).mpr hsj)
      rw [mem_maskFace] at this
      simp [this]
  · rw [Nat.testBit_lt_two_pow (hs.trans_le (Nat.pow_le_pow_right Nat.two_pos (not_lt.mp hj)))]
    rfl

/-- A nonzero mask with no bits at positions `n` and above encodes a nonempty face. -/
theorem maskFace_nonempty {s : ℕ} (hs0 : s ≠ 0) (hs : s < 2 ^ n) : (maskFace n s).Nonempty := by
  obtain ⟨j, hj⟩ := Nat.exists_testBit_of_ne_zero hs0
  have hjn : j < n := by
    by_contra hjn
    rw [Nat.testBit_lt_two_pow (hs.trans_le (Nat.pow_le_pow_right Nat.two_pos (not_lt.mp hjn)))]
      at hj
    exact Bool.false_ne_true hj
  exact ⟨⟨j, hjn⟩, mem_maskFace.mpr hj⟩

/-- Setting bit `i` adjoins the vertex `i`. -/
theorem maskFace_or_two_pow (s : ℕ) (i : Fin n) :
    maskFace n (s ||| 2 ^ (i : ℕ)) = insert i (maskFace n s) := by
  ext j
  simp only [mem_maskFace, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true,
    decide_eq_true_eq, Finset.mem_insert, Fin.ext_iff]
  exact or_comm.trans (or_congr_left eq_comm)

/-- Toggling a set bit `j` removes the vertex `j`. -/
theorem maskFace_xor_two_pow {t : ℕ} (j : Fin n) (hj : t.testBit j = true) :
    maskFace n (t ^^^ 2 ^ (j : ℕ)) = (maskFace n t).erase j := by
  ext k
  simp only [mem_maskFace, Nat.testBit_xor, Nat.testBit_two_pow, Finset.mem_erase, ne_eq,
    Fin.ext_iff]
  by_cases hk : k = j
  · subst hk
    simp [hj]
  · simp [Fin.val_ne_of_ne hk, Fin.val_ne_of_ne (Ne.symm hk)]

/-- The mask `2 ^ v` encodes the single vertex `v`. -/
theorem maskFace_two_pow (v : Fin n) : maskFace n (2 ^ (v : ℕ)) = {v} := by
  ext k
  simp [Nat.testBit_two_pow, Fin.ext_iff, eq_comm]

/-- The precomplex on `Fin n` generated by the faces encoded by the masks in `G`: its faces are
the nonempty subsets of those faces. -/
def ofMasks (n : ℕ) (G : List ℕ) : PreAbstractSimplicialComplex (Fin n) where
  faces := {σ | σ.Nonempty ∧ ∃ g ∈ G, σ ⊆ maskFace n g}
  isRelLowerSet_faces := by
    rintro σ ⟨hσ, g, hg, hσg⟩
    exact ⟨hσ, fun τ hτσ hτ => ⟨hτ, g, hg, hτσ.trans hσg⟩⟩

/-- The faces of `ofMasks n G` are the nonempty subsets of the faces of the masks in `G`. -/
@[simp]
theorem mem_ofMasks {G : List ℕ} {σ : Finset (Fin n)} :
    σ ∈ ofMasks n G ↔ σ.Nonempty ∧ ∃ g ∈ G, σ ⊆ maskFace n g :=
  Iff.rfl

/-- The Boolean test that `(s, i)` describes an elementary collapse of `ofMasks n G`: `s` is a
nonzero mask below `2 ^ n`, `i < n` is not in the face of `s`, the coface `s ||| 2 ^ i` is a
generator, and every generator containing the face of `s` is contained in that coface. -/
@[expose] def isFreeMaskStep (n : ℕ) (G : List ℕ) (s i : ℕ) : Bool :=
  s != 0 && decide (s < 2 ^ n) && decide (i < n) && !s.testBit i &&
    G.contains (s ||| 2 ^ i) && G.all fun g => s &&& g != s || g &&& (s ||| 2 ^ i) == g

/-- The generators after collapsing the face of `s` through its coface `s ||| 2 ^ i`: the
generators not containing `s`, together with the facets of the coface omitting a vertex of
`s`. -/
@[expose] def deleteMaskStep (n : ℕ) (G : List ℕ) (s i : ℕ) : List ℕ :=
  G.filter (fun g => s &&& g != s) ++
    ((List.range n).filter (s.testBit ·)).map fun j => (s ||| 2 ^ i) ^^^ 2 ^ j

/-- A step `(s, i)` is accepted exactly when `s` is a nonzero mask below `2 ^ n`, `i < n` is not a
bit of `s`, the coface `s ||| 2 ^ i` is a generator, and every generator containing `s` as a
submask is a submask of that coface. -/
theorem isFreeMaskStep_eq_true_iff {G : List ℕ} {s i : ℕ} :
    isFreeMaskStep n G s i = true ↔ s ≠ 0 ∧ s < 2 ^ n ∧ i < n ∧ s.testBit i = false ∧
      s ||| 2 ^ i ∈ G ∧ ∀ g ∈ G, s &&& g = s → g &&& (s ||| 2 ^ i) = g := by
  simp only [isFreeMaskStep, Bool.and_eq_true, bne_iff_ne, ne_eq, decide_eq_true_eq,
    Bool.not_eq_true', List.contains_iff_mem, List.all_eq_true, Bool.or_eq_true,
    beq_iff_eq, ← imp_iff_not_or, and_assoc]

/-- Every face of `ofMasks n G` containing the face of an accepted step `(s, i)` lies in the
face of `s ||| 2 ^ i`. -/
private theorem subset_of_isFreeMaskStep {G : List ℕ} {s i : ℕ}
    (h : isFreeMaskStep n G s i = true) {ω : Finset (Fin n)} (hω : ω ∈ ofMasks n G)
    (hsω : maskFace n s ⊆ ω) : ω ⊆ maskFace n (s ||| 2 ^ i) := by
  obtain ⟨-, hs, -, -, -, hall⟩ := isFreeMaskStep_eq_true_iff.mp h
  obtain ⟨-, g, hg, hωg⟩ := mem_ofMasks.mp hω
  exact hωg.trans (maskFace_subset_maskFace
    (hall g hg ((maskFace_subset_maskFace_iff hs).mp (hsω.trans hωg))))

/-- An accepted step `(s, i)` describes a free pair of `ofMasks n G`. -/
theorem isFreePair_ofMasks_of_isFreeMaskStep {G : List ℕ} {s i : ℕ}
    (h : isFreeMaskStep n G s i = true) :
    IsFreePair (ofMasks n G) (maskFace n s) (maskFace n (s ||| 2 ^ i)) := by
  obtain ⟨hs0, hs, hi, hsi, hmem, -⟩ := isFreeMaskStep_eq_true_iff.mp h
  have hτ : maskFace n (s ||| 2 ^ i) = insert ⟨i, hi⟩ (maskFace n s) :=
    maskFace_or_two_pow s ⟨i, hi⟩
  have hiσ : (⟨i, hi⟩ : Fin n) ∉ maskFace n s := by simpa using hsi
  have hτK : maskFace n (s ||| 2 ^ i) ∈ ofMasks n G :=
    mem_ofMasks.mpr ⟨hτ ▸ Finset.insert_nonempty _ _, _, hmem, subset_rfl⟩
  refine ⟨(ofMasks n G).isRelLowerSet_faces hτK |>.2 (hτ ▸ Finset.subset_insert _ _)
      (maskFace_nonempty hs0 hs), hτK, hτ ▸ Finset.ssubset_insert hiσ, fun ω hω hσω => ?_⟩
  have hωτ := subset_of_isFreeMaskStep h hω hσω
  rw [hτ] at hωτ ⊢
  by_cases hiω : (⟨i, hi⟩ : Fin n) ∈ ω
  · exact Or.inr (hωτ.antisymm (Finset.insert_subset hiω hσω))
  · exact Or.inl ((Finset.subset_insert_iff_of_notMem hiω).mp hωτ |>.antisymm hσω)

/-- Deleting the free pair of an accepted step `(s, i)` gives the precomplex generated by the
updated masks `deleteMaskStep n G s i`. -/
theorem deletion_ofMasks_of_isFreeMaskStep {G : List ℕ} {s i : ℕ}
    (h : isFreeMaskStep n G s i = true) :
    deletion (ofMasks n G) (maskFace n s) = ofMasks n (deleteMaskStep n G s i) := by
  obtain ⟨-, hs, -, -, hmem, hall⟩ := isFreeMaskStep_eq_true_iff.mp h
  apply SetLike.ext
  intro ω
  simp only [mem_deletion, mem_ofMasks, deleteMaskStep, List.mem_append, List.mem_filter,
    bne_iff_ne, ne_eq, List.mem_map, List.mem_range]
  constructor
  · rintro ⟨⟨hne, g, hg, hωg⟩, hσω⟩
    refine ⟨hne, ?_⟩
    by_cases hsg : s &&& g = s
    · -- The face lies in the upper face but misses a vertex `j` of the lower face.
      have hωτ : ω ⊆ maskFace n (s ||| 2 ^ i) :=
        hωg.trans (maskFace_subset_maskFace (hall g hg hsg))
      obtain ⟨j, hjs, hjω⟩ := Finset.not_subset.mp hσω
      have hjτ : (s ||| 2 ^ i).testBit j = true := by
        simp [Nat.testBit_or, (mem_maskFace.mp hjs)]
      refine ⟨_, Or.inr ⟨j, ⟨j.2, mem_maskFace.mp hjs⟩, rfl⟩, ?_⟩
      rw [maskFace_xor_two_pow j hjτ]
      exact fun k hk => Finset.mem_erase.mpr ⟨fun hkj => hjω (hkj ▸ hk), hωτ hk⟩
    · exact ⟨g, Or.inl ⟨hg, hsg⟩, hωg⟩
  · rintro ⟨hne, g, hg | ⟨j, ⟨hj, hjs⟩, rfl⟩, hωg⟩
    · refine ⟨⟨hne, g, hg.1, hωg⟩, fun hσω => hg.2 ?_⟩
      exact (maskFace_subset_maskFace_iff hs).mp (hσω.trans hωg)
    · have hjτ : (s ||| 2 ^ i).testBit j = true := by simp [Nat.testBit_or, hjs]
      rw [maskFace_xor_two_pow ⟨j, hj⟩ hjτ] at hωg
      refine ⟨⟨hne, _, hmem, hωg.trans (Finset.erase_subset _ _)⟩, fun hσω => ?_⟩
      exact (Finset.mem_erase.mp (hωg (hσω (mem_maskFace.mpr hjs)))).1 rfl

/-- An accepted step `(s, i)` is an elementary collapse of `ofMasks n G` onto the precomplex
generated by `deleteMaskStep n G s i`. -/
theorem elementaryCollapsesTo_ofMasks_of_isFreeMaskStep {G : List ℕ} {s i : ℕ}
    (h : isFreeMaskStep n G s i = true) :
    ElementaryCollapsesTo (ofMasks n G) (ofMasks n (deleteMaskStep n G s i)) :=
  .of_isFreePair (isFreePair_ofMasks_of_isFreeMaskStep h)
    (deletion_ofMasks_of_isFreeMaskStep h).symm

/-- A nonempty list of generators all equal to `2 ^ v` generates the one-vertex complex. -/
theorem ofMasks_eq_point {G : List ℕ} (v : Fin n) (hG : G ≠ [])
    (hv : ∀ g ∈ G, g = 2 ^ (v : ℕ)) : ofMasks n G = point v := by
  apply SetLike.ext
  intro σ
  obtain ⟨g, hg⟩ := List.exists_mem_of_ne_nil G hG
  simp only [mem_ofMasks, mem_point]
  constructor
  · rintro ⟨hne, g', hg', hσ⟩
    rw [hv g' hg', maskFace_two_pow] at hσ
    exact Finset.subset_singleton_iff.mp hσ |>.resolve_left hne.ne_empty
  · rintro rfl
    exact ⟨Finset.singleton_nonempty v, g, hg, by rw [hv g hg, maskFace_two_pow]⟩

/-- The Boolean test that a list of steps collapses `ofMasks n G` to the vertex `v`. Each step
must pass `isFreeMaskStep`, and after all steps every remaining generator must be the mask
`2 ^ v` of the single vertex `v < n`. -/
@[expose] def checkMaskCollapse (n : ℕ) : List ℕ → List (ℕ × ℕ) → ℕ → Bool
  | G, [], v => decide (v < n) && G != [] && G.all (· == 2 ^ v)
  | G, (s, i) :: steps, v =>
      isFreeMaskStep n G s i && checkMaskCollapse n (deleteMaskStep n G s i) steps v

/-- An accepted certificate collapses `ofMasks n G` to its final vertex. -/
theorem collapsesTo_point_ofMasks_of_checkMaskCollapse {G : List ℕ} {steps : List (ℕ × ℕ)}
    {v : ℕ} (h : checkMaskCollapse n G steps v = true) :
    ∃ hv : v < n, CollapsesTo (ofMasks n G) (point ⟨v, hv⟩) := by
  induction steps generalizing G with
  | nil =>
    simp only [checkMaskCollapse, Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq,
      List.all_eq_true, beq_iff_eq] at h
    obtain ⟨⟨hv, hG⟩, hall⟩ := h
    exact ⟨hv, ofMasks_eq_point ⟨v, hv⟩ hG hall ▸ CollapsesTo.refl _⟩
  | cons step steps ih =>
    obtain ⟨s, i⟩ := step
    simp only [checkMaskCollapse, Bool.and_eq_true] at h
    obtain ⟨hv, hcol⟩ := ih h.2
    exact ⟨hv, CollapsesTo.head (elementaryCollapsesTo_ofMasks_of_isFreeMaskStep h.1) hcol⟩

/-- A precomplex presented by masks is collapsible when a collapse certificate is accepted. -/
theorem collapsible_ofMasks_of_checkMaskCollapse {G : List ℕ} {steps : List (ℕ × ℕ)} {v : ℕ}
    (h : checkMaskCollapse n G steps v = true) : Collapsible (ofMasks n G) := by
  obtain ⟨_, hcol⟩ := collapsesTo_point_ofMasks_of_checkMaskCollapse h
  exact collapsible_iff.mpr ⟨_, hcol⟩

/-- The Boolean test that every mask in `G` is a bitwise submask of some mask in `H`. -/
@[expose] def maskCovers (G H : List ℕ) : Bool :=
  G.all fun g => H.any fun h => g &&& h == g

/-- If every mask in `G` is a submask of a mask in `H`, then the precomplex generated by `G` is
contained in the one generated by `H`. -/
theorem ofMasks_le_ofMasks_of_maskCovers {G H : List ℕ} (h : maskCovers G H = true) :
    ofMasks n G ≤ ofMasks n H := by
  rintro σ ⟨hne, g, hg, hσg⟩
  simp only [maskCovers, List.all_eq_true, List.any_eq_true, beq_iff_eq] at h
  obtain ⟨g', hg', hgg'⟩ := h g hg
  exact ⟨hne, g', hg', hσg.trans (maskFace_subset_maskFace hgg')⟩

/-- The Boolean test that a list of steps collapses `ofMasks n G` onto `ofMasks n H`. Each step
must pass `isFreeMaskStep`, and the remaining generators must cover and be covered by `H`, in the
sense of `maskCovers`. -/
@[expose] def checkMaskCollapseTo (n : ℕ) : List ℕ → List (ℕ × ℕ) → List ℕ → Bool
  | G, [], H => maskCovers G H && maskCovers H G
  | G, (s, i) :: steps, H =>
      isFreeMaskStep n G s i && checkMaskCollapseTo n (deleteMaskStep n G s i) steps H

/-- An accepted certificate collapses `ofMasks n G` onto `ofMasks n H`. -/
theorem collapsesTo_ofMasks_of_checkMaskCollapseTo {G H : List ℕ} {steps : List (ℕ × ℕ)}
    (h : checkMaskCollapseTo n G steps H = true) : CollapsesTo (ofMasks n G) (ofMasks n H) := by
  induction steps generalizing G with
  | nil =>
    simp only [checkMaskCollapseTo, Bool.and_eq_true] at h
    exact le_antisymm (ofMasks_le_ofMasks_of_maskCovers h.1)
      (ofMasks_le_ofMasks_of_maskCovers h.2) ▸ CollapsesTo.refl _
  | cons step steps ih =>
    obtain ⟨s, i⟩ := step
    simp only [checkMaskCollapseTo, Bool.and_eq_true] at h
    exact CollapsesTo.head (elementaryCollapsesTo_ofMasks_of_isFreeMaskStep h.1) (ih h.2)

/-- The Boolean test that `ofMasks n G` has no free pair: for every generator `g` and every bit
`j` of `g`, some generator `g'` below `2 ^ n` contains the facet `g ^^^ 2 ^ j` of `g` without
being contained in `g`. -/
@[expose] def checkMaskNoFreePair (n : ℕ) (G : List ℕ) : Bool :=
  G.all fun g => (List.range n).all fun j => !g.testBit j ||
    G.any fun g' => decide (g' < 2 ^ n) && (g ^^^ 2 ^ j) &&& g' == g ^^^ 2 ^ j && g' &&& g != g'

/-- If `checkMaskNoFreePair` accepts `G`, then `ofMasks n G` has no free pair: the upper face of a
free pair would be a generator `g`, and the generator `g'` provided for the lower face would be a
third face containing it. -/
theorem not_isFreePair_ofMasks_of_checkMaskNoFreePair {G : List ℕ}
    (h : checkMaskNoFreePair n G = true) (σ τ : Finset (Fin n)) :
    ¬ IsFreePair (ofMasks n G) σ τ := by
  intro hfree
  obtain ⟨hτne, g, hg, hτg⟩ := mem_ofMasks.mp hfree.upper_mem
  have hgτ : maskFace n g = τ :=
    hfree.upper_maximal (mem_ofMasks.mpr ⟨hτne.mono hτg, g, hg, subset_rfl⟩) hτg
  obtain ⟨a, haσ, rfl⟩ := Finset.covBy_iff_exists_insert.mp hfree.covBy
  have hga : g.testBit a = true := mem_maskFace.mp (hgτ ▸ Finset.mem_insert_self a σ)
  simp only [checkMaskNoFreePair, List.all_eq_true, List.mem_range, Bool.or_eq_true,
    Bool.not_eq_eq_eq_not, Bool.not_true, List.any_eq_true, Bool.and_eq_true, decide_eq_true_eq,
    beq_iff_eq, bne_iff_ne, ne_eq] at h
  obtain ⟨g', hg', ⟨hg'n, hsub⟩, hnot⟩ := (h g hg a a.2).resolve_left (by simp [hga])
  have hσ : maskFace n (g ^^^ 2 ^ (a : ℕ)) = σ := by
    rw [maskFace_xor_two_pow a hga, hgτ, Finset.erase_insert haσ]
  have hσg' : σ ⊆ maskFace n g' := hσ ▸ maskFace_subset_maskFace hsub
  have hg'τ := hfree.subset_upper_of_lower_subset
    (mem_ofMasks.mpr ⟨hfree.lower_mem.1.mono hσg', g', hg', subset_rfl⟩) hσg'
  exact hnot ((maskFace_subset_maskFace_iff hg'n).mp (hgτ ▸ hg'τ))

end TauCeti.PreAbstractSimplicialComplex
