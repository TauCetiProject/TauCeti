module

public import Mathlib.AlgebraicTopology.SimplicialSet.Skeleton

/-!
# Functoriality and basic properties of simplicial skeletons

Every simplicial map `f : X ⟶ Y` sends each skeletal filtration stage `X.skeleton n` (generated by
simplices of dimension `< n`) into `Y.skeleton n` (`SSet.skeleton_le_preimage_skeleton`), and the
relative skeleton `SSet.skeletonOfMono` of the inclusion `⊥ ↪ X` agrees with `X.skeleton`
(`SSet.skeletonOfMono_bot_eq_skeleton`).
-/

public section

open CategoryTheory

universe u

namespace SSet

/-- Every simplicial map sends the stage `X.skeleton n` generated by simplices of dimension `< n`
into the corresponding stage `Y.skeleton n` of its codomain. -/
lemma skeleton_le_preimage_skeleton {X Y : SSet.{u}} (f : X ⟶ Y) (n : ℕ) :
    X.skeleton n ≤ (Y.skeleton n).preimage f := by
  -- Expose the defining supremum of `X.skeleton n` without unfolding the `OrderHom` structure.
  change (⨆ (i : Fin n) (x : X.nonDegenerate i), Subcomplex.ofSimplex x.val) ≤ _
  simp only [iSup_le_iff]
  intro k x
  rw [Subcomplex.ofSimplex_le_iff, Subcomplex.preimage_obj, Set.mem_preimage]
  exact Y.mem_skeleton (f.app _ x.val) k.isLt

/-- The relative skeleton `SSet.skeletonOfMono` of the inclusion of the empty subcomplex `⊥ ↪ X`
agrees with `X.skeleton`. -/
@[simp]
lemma skeletonOfMono_bot_eq_skeleton (X : SSet.{u}) (n : ℕ) :
    skeletonOfMono (Subcomplex.ι (⊥ : X.Subcomplex)) n = X.skeleton n := by
  simp [skeletonOfMono]

end SSet
