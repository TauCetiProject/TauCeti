module

public import Mathlib.AlgebraicTopology.Quasicategory.InnerFibration
public import Mathlib.AlgebraicTopology.SimplicialSet.SubcomplexOp
public import TauCeti.AlgebraicTopology.SimplicialSet.AnodyneExtensions.LeftRight.Basic

/-!
# Fibers of maps of simplicial sets

For a map of simplicial sets `q : X ⟶ Y` and a subcomplex `A` of `Y`, the restriction
`A.fromPreimage q : A.preimage q ⟶ A` of `q` over `A` is a base change of `q`, so it inherits every
right lifting property of `q`. In particular it is an inner, left, right or Kan fibration when `q`
is.

The fiber `SSet.fiber q y` of `q` over a vertex `y` of `Y` is the preimage of the subcomplex
generated by `y`. That subcomplex is terminal, so the fiber of an inner fibration is a
quasicategory, and the fiber of a Kan fibration is a Kan complex. Simplicial sets of maps over a
base, such as the sections of an inner fibration, are fibers of this kind.

## Main definitions

* `SSet.fiber q y`: the fiber of `q : X ⟶ Y` over the vertex `y`, as a subcomplex of `X`.
* `SSet.fiber.map g hg y`: the map of fibers over `y` induced by a map `g` over `Y`.
* `SSet.fiber.lift`: a morphism to `X` whose composite with `q` is constant at `y`, as a morphism
  to the fiber.
* `SSet.fiber.basePoint`: a vertex of `X` over `y`, as a vertex of the fiber.

## Main results

* `SSet.Subcomplex.hasLiftingProperty_fromPreimage`,
  `SSet.Subcomplex.hasLiftingProperty_lift_of_eq_preimage`: the restriction of `q` over a
  subcomplex has the right lifting properties of `q`.
* `SSet.Subcomplex.isTerminalOfSimplex`: the subcomplex generated by a vertex is terminal.
* `SSet.range_le_fiber_iff`: a map lands in the fiber of `q` over `y` exactly when its composite
  with `q` is constant at `y`.
* `SSet.fiber.fromPreimageIso`: the fibers of the restriction of `q` over a subcomplex are fibers
  of `q`.
* `SSet.fiber.isTerminalOfIsIso`: the fibers of an isomorphism are terminal.
* `SSet.fiber.quasicategory`, `SSet.fiber.kanComplex`: the fibers of inner fibrations are
  quasicategories, and those of Kan fibrations are Kan complexes.
* `SSet.fiber_opFunctor_map`: the fibers of the opposite of a map are the opposites of its fibers.

## References

* J. Lurie, *Higher Topos Theory*, Section 2.1.1.
-/

public section

universe u

open CategoryTheory Limits HomotopicalAlgebra Simplicial

namespace SSet

open modelCategoryQuillen

variable {X Y : SSet.{u}}

namespace Subcomplex

/-- The restriction `A.fromPreimage q` of `q` over a subcomplex `A` has the right lifting property
with respect to every map against which `q` has it: a lift for `q` of a square over `A` lands in
the preimage of `A`. -/
instance hasLiftingProperty_fromPreimage {P Q : SSet.{u}} (i : P ⟶ Q) (q : X ⟶ Y)
    [HasLiftingProperty i q] (A : Y.Subcomplex) : HasLiftingProperty i (A.fromPreimage q) where
  sq_hasLift {t b} sq := by
    have sq' : CommSq (t ≫ (A.preimage q).ι) i q (b ≫ A.ι) :=
      ⟨by rw [Category.assoc, ← fromPreimage_ι, ← Category.assoc, sq.w, Category.assoc]⟩
    refine ⟨⟨{ l := lift sq'.lift ?_, fac_left := ?_, fac_right := ?_ }⟩⟩
    · rw [← image_top, image_le_iff, ← preimage_comp, sq'.fac_right, preimage_comp, preimage_ι]
      exact top_le_iff.2 (by ext; simp)
    · rw [← cancel_mono (A.preimage q).ι, Category.assoc, lift_ι, CommSq.fac_left]
    · rw [← cancel_mono A.ι, Category.assoc, fromPreimage_ι, ← Category.assoc, lift_ι,
        CommSq.fac_right]

/-- The restriction `Subcomplex.lift (A'.ι ≫ q) h : A' ⟶ A` of `q` to a subcomplex `A'` equal to the
preimage of `A` is `A.fromPreimage q`, so it has the right lifting properties of `q`. -/
lemma hasLiftingProperty_lift_of_eq_preimage {P Q : SSet.{u}} (i : P ⟶ Q) (q : X ⟶ Y)
    [HasLiftingProperty i q] {A : Y.Subcomplex} {A' : X.Subcomplex} (hA : A' = A.preimage q)
    (h : range (A'.ι ≫ q) ≤ A) : HasLiftingProperty i (lift (A'.ι ≫ q) h) := by
  subst hA
  have he : lift ((A.preimage q).ι ≫ q) h = A.fromPreimage q := by
    rw [← cancel_mono A.ι, lift_ι, fromPreimage_ι]
  rw [he]
  infer_instance

/-- The restriction of an inner fibration over a subcomplex is an inner fibration. -/
instance innerFibration_fromPreimage (q : X ⟶ Y) [InnerFibration q] (A : Y.Subcomplex) :
    InnerFibration (A.fromPreimage q) :=
  ⟨fun _ _ i hi ↦ have := InnerFibration.mem (q := q) i hi; inferInstance⟩

/-- The restriction of a left fibration over a subcomplex is a left fibration. -/
instance leftFibration_fromPreimage (q : X ⟶ Y) [LeftFibration q] (A : Y.Subcomplex) :
    LeftFibration (A.fromPreimage q) :=
  (leftFibration_iff_hasLiftingProperty _).2 fun _ i hi ↦
    have := (leftFibration_iff_hasLiftingProperty q).1 inferInstance i hi
    inferInstance

/-- The restriction of a right fibration over a subcomplex is a right fibration. -/
instance rightFibration_fromPreimage (q : X ⟶ Y) [RightFibration q] (A : Y.Subcomplex) :
    RightFibration (A.fromPreimage q) :=
  (rightFibration_iff_hasLiftingProperty _).2 fun _ i h0 ↦
    have := (rightFibration_iff_hasLiftingProperty q).1 inferInstance i h0
    inferInstance

/-- The restriction of a Kan fibration over a subcomplex is a Kan fibration. -/
instance fibration_fromPreimage (q : X ⟶ Y) [Fibration q] (A : Y.Subcomplex) :
    Fibration (A.fromPreimage q) := by
  rw [fibration_iff] at *
  intro _ _ i hi
  have := ‹J.rlp q› i hi
  infer_instance

/-- The simplices of the subcomplex generated by a vertex `y` are the degeneracies of `y`. -/
lemma mem_ofSimplex₀_obj_iff (y : Y _⦋0⦌) {n : SimplexCategoryᵒᵖ} (z : Y.obj n) :
    z ∈ (ofSimplex y).obj n ↔ z = Y.map (n.unop.const _ 0).op y := by
  rw [mem_ofSimplex_obj_iff]
  exact ⟨fun ⟨f, hf⟩ ↦ by rw [← hf, Subsingleton.elim f (n.unop.const _ 0)],
    fun h ↦ ⟨_, h.symm⟩⟩

/-- The subcomplex generated by a vertex `y` is terminal. -/
def isTerminalOfSimplex (y : Y _⦋0⦌) : IsTerminal (ofSimplex y : SSet.{u}) :=
  IsTerminal.ofUniqueHom (fun _ ↦ const ⟨y, mem_ofSimplex_obj y⟩) fun _ g ↦ by
    ext n z
    exact Subtype.ext ((mem_ofSimplex₀_obj_iff y _).1 (g.app n z).property)

/-- A map lands in the subcomplex generated by a vertex `y` exactly when it is constant at `y`. -/
lemma range_le_ofSimplex_iff {Z : SSet.{u}} (g : Z ⟶ Y) (y : Y _⦋0⦌) :
    range g ≤ ofSimplex y ↔ g = const y := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · ext n z
    exact (mem_ofSimplex₀_obj_iff y _).1 (h _ ⟨z, rfl⟩)
  · rintro n _ ⟨z, rfl⟩
    rw [h]
    exact (mem_ofSimplex₀_obj_iff y _).2 rfl

end Subcomplex

/-- The fiber of a map `q : X ⟶ Y` over a vertex `y` of `Y`: the subcomplex of `X` of the simplices
that `q` sends to degeneracies of `y`. -/
def fiber (q : X ⟶ Y) (y : Y _⦋0⦌) : X.Subcomplex :=
  (Subcomplex.ofSimplex y).preimage q

/-- The fiber of `q` over `y` is the preimage under `q` of the subcomplex generated by `y`. -/
lemma fiber_eq_preimage (q : X ⟶ Y) (y : Y _⦋0⦌) :
    fiber q y = (Subcomplex.ofSimplex y).preimage q := by
  rfl

/-- The simplices of the fiber of `q` over `y` are those that `q` sends to degeneracies of `y`. -/
@[simp]
lemma mem_fiber_iff (q : X ⟶ Y) (y : Y _⦋0⦌) {n : SimplexCategoryᵒᵖ} (x : X.obj n) :
    x ∈ (fiber q y).obj n ↔ q.app n x = Y.map (n.unop.const _ 0).op y := by
  rw [fiber, Subcomplex.preimage_obj, Set.mem_preimage, Subcomplex.mem_ofSimplex₀_obj_iff]

/-- A map `g : Z ⟶ X` lands in the fiber of `q` over `y` exactly when `g ≫ q` is constant at `y`.
This is the universal property of the fiber. -/
lemma range_le_fiber_iff {Z : SSet.{u}} (g : Z ⟶ X) (q : X ⟶ Y) (y : Y _⦋0⦌) :
    Subcomplex.range g ≤ fiber q y ↔ g ≫ q = const y := by
  rw [fiber, ← Subcomplex.image_top, ← Subcomplex.image_le_iff, ← Subcomplex.image_comp,
    Subcomplex.image_top, Subcomplex.range_le_ofSimplex_iff]

/-- The inclusion of the fiber of `q` over `y`, followed by `q`, is constant at `y`. -/
@[reassoc (attr := simp)]
lemma fiber.ι_comp (q : X ⟶ Y) (y : Y _⦋0⦌) : (fiber q y).ι ≫ q = const y :=
  (range_le_fiber_iff _ q y).1 (by simp)

/-- A map `g : X ⟶ X'` of simplicial sets over `Y` restricts to a map of fibers over each vertex
`y` of `Y`. -/
def fiber.map {X' : SSet.{u}} {q : X ⟶ Y} {q' : X' ⟶ Y} (g : X ⟶ X') (hg : g ≫ q' = q)
    (y : Y _⦋0⦌) : (fiber q y : SSet) ⟶ (fiber q' y : SSet) :=
  Subcomplex.lift ((fiber q y).ι ≫ g) (by simp [range_le_fiber_iff, hg])

@[reassoc (attr := simp)]
lemma fiber.map_ι {X' : SSet.{u}} {q : X ⟶ Y} {q' : X' ⟶ Y} (g : X ⟶ X') (hg : g ≫ q' = q)
    (y : Y _⦋0⦌) : fiber.map g hg y ≫ (fiber q' y).ι = (fiber q y).ι ≫ g :=
  (rfl)

/-- The map of fibers induced by the identity is the identity. -/
@[simp]
lemma fiber.map_id (q : X ⟶ Y) (y : Y _⦋0⦌) : fiber.map (𝟙 X) (Category.id_comp q) y = 𝟙 _ := by
  rw [← cancel_mono (fiber q y).ι]
  simp

/-- Maps of fibers compose. -/
lemma fiber.map_comp {X' X'' : SSet.{u}} {q : X ⟶ Y} {q' : X' ⟶ Y} {q'' : X'' ⟶ Y} (g : X ⟶ X')
    (hg : g ≫ q' = q) (g' : X' ⟶ X'') (hg' : g' ≫ q'' = q') (y : Y _⦋0⦌) :
    fiber.map (g ≫ g') (by rw [Category.assoc, hg', hg]) y =
      fiber.map g hg y ≫ fiber.map g' hg' y := by
  rw [← cancel_mono (fiber q'' y).ι]
  simp

/-- The fibers of an isomorphism are terminal. -/
noncomputable def fiber.isTerminalOfIsIso (q : X ⟶ Y) [IsIso q] (y : Y _⦋0⦌) :
    IsTerminal (fiber q y : SSet) :=
  IsTerminal.ofUniqueHom
    (fun _ ↦ Subcomplex.lift (const ((inv q).app _ y)) (by simp [range_le_fiber_iff]))
    fun _ g ↦ by
      rw [← cancel_mono (fiber q y).ι, ← cancel_mono q]
      simp

/-- A morphism `g` with `g ≫ q` constant at `y`, as a morphism to the fiber of `q` over `y`. -/
def fiber.lift {Z : SSet.{u}} (g : Z ⟶ X) (q : X ⟶ Y) (y : Y _⦋0⦌) (hg : g ≫ q = const y) :
    Z ⟶ (fiber q y : SSet) :=
  Subcomplex.lift g ((range_le_fiber_iff g q y).2 hg)

@[reassoc (attr := simp)]
lemma fiber.lift_ι {Z : SSet.{u}} (g : Z ⟶ X) (q : X ⟶ Y) (y : Y _⦋0⦌) (hg : g ≫ q = const y) :
    fiber.lift g q y hg ≫ (fiber q y).ι = g :=
  Subcomplex.lift_ι _ _

/-- A vertex `x` of `X` over `y`, as a vertex of the fiber of `q` over `y`. -/
def fiber.basePoint (q : X ⟶ Y) {y : Y _⦋0⦌} {x : X _⦋0⦌} (hx : q.app _ x = y) :
    (fiber q y : SSet) _⦋0⦌ :=
  ⟨x, by simp [hx, SimplexCategory.const_eq_id]⟩

@[simp]
lemma fiber.coe_basePoint (q : X ⟶ Y) {y : Y _⦋0⦌} {x : X _⦋0⦌} (hx : q.app _ x = y) :
    (fiber.basePoint q hx).val = x :=
  (rfl)

lemma fiber.ι_app_basePoint (q : X ⟶ Y) {y : Y _⦋0⦌} {x : X _⦋0⦌} (hx : q.app _ x = y) :
    (fiber q y).ι.app _ (fiber.basePoint q hx) = x :=
  (rfl)

/-- The fiber of `q` over a vertex `y` of a subcomplex `A` lies in the preimage of `A`. -/
lemma fiber_le_preimage (q : X ⟶ Y) {A : Y.Subcomplex} (y : (A : SSet.{u}) _⦋0⦌) :
    fiber q y.val ≤ A.preimage q := by
  intro n x hx
  rw [mem_fiber_iff] at hx
  rw [Subcomplex.preimage_obj, Set.mem_preimage, hx]
  exact A.map _ y.property

/-- **The fibers of the restriction of `q` over a subcomplex are fibers of `q`**: the fiber of
`A.fromPreimage q : A.preimage q ⟶ A` over a vertex `y` of `A` is isomorphic to the fiber of `q`
over `y`, through the inclusion of `A.preimage q` into `X`. -/
noncomputable def fiber.fromPreimageIso (q : X ⟶ Y) (A : Y.Subcomplex) (y : (A : SSet.{u}) _⦋0⦌) :
    (fiber (A.fromPreimage q) y : SSet.{u}) ≅ (fiber q y.val : SSet.{u}) where
  hom := fiber.lift ((fiber (A.fromPreimage q) y).ι ≫ (A.preimage q).ι) q y.val (by
    rw [Category.assoc, ← Subcomplex.fromPreimage_ι, fiber.ι_comp_assoc, const_comp]
    rfl)
  inv := fiber.lift (Subcomplex.lift (fiber q y.val).ι (by simpa using fiber_le_preimage q y))
    (A.fromPreimage q) y (by
      rw [← cancel_mono A.ι, Category.assoc, Subcomplex.fromPreimage_ι, Subcomplex.lift_ι_assoc,
        fiber.ι_comp, const_comp]
      rfl)
  hom_inv_id := by
    rw [← cancel_mono (fiber _ y).ι, ← cancel_mono (A.preimage q).ι]
    simp
  inv_hom_id := by
    rw [← cancel_mono (fiber q y.val).ι]
    simp

@[reassoc (attr := simp)]
lemma fiber.fromPreimageIso_hom_ι (q : X ⟶ Y) (A : Y.Subcomplex) (y : (A : SSet.{u}) _⦋0⦌) :
    (fiber.fromPreimageIso q A y).hom ≫ (fiber q y.val).ι =
      (fiber (A.fromPreimage q) y).ι ≫ (A.preimage q).ι := by
  simp [fiber.fromPreimageIso]

/-- A terminal simplicial set is a quasicategory. -/
lemma quasicategory_of_isTerminal (h : IsTerminal X) : Quasicategory X :=
  ⟨fun _ _ _ _ _ ↦ ⟨h.from _, h.hom_ext _ _⟩⟩

/-- A terminal simplicial set is a Kan complex. -/
lemma kanComplex_of_isTerminal (h : IsTerminal X) : KanComplex X :=
  KanComplex.iff.2 fun _ _ _ _ ↦ ⟨h.from _, fun _ _ ↦ h.hom_ext _ _⟩

/-- The fiber of an inner fibration over a vertex is a quasicategory. -/
instance fiber.quasicategory (q : X ⟶ Y) [InnerFibration q] (y : Y _⦋0⦌) :
    Quasicategory (fiber q y) :=
  have := quasicategory_of_isTerminal (Subcomplex.isTerminalOfSimplex y)
  -- `fiber q y` is by definition the source of the restriction of `q` over `ofSimplex y`.
  quasicategory_of_innerFibration (X := ((Subcomplex.ofSimplex y).preimage q : SSet))
    ((Subcomplex.ofSimplex y).fromPreimage q)

/-- The fiber of a Kan fibration over a vertex is a Kan complex. -/
instance fiber.kanComplex (q : X ⟶ Y) [Fibration q] (y : Y _⦋0⦌) : KanComplex (fiber q y) :=
  have := kanComplex_of_isTerminal (Subcomplex.isTerminalOfSimplex y)
  -- `fiber q y` is by definition the source of the restriction of `q` over `ofSimplex y`.
  isFibrant_of_fibration (X := ((Subcomplex.ofSimplex y).preimage q : SSet))
    ((Subcomplex.ofSimplex y).fromPreimage q)

/-- The fibre of the opposite `qᵒᵖ` of a map over a vertex `y` is the opposite of the fibre of `q`
over `y`. -/
lemma fiber_opFunctor_map (q : X ⟶ Y) (y : Y _⦋0⦌) :
    fiber (opFunctor.map q) (opObjEquiv.symm y) = (fiber q y).op := by
  ext n x
  rw [mem_fiber_iff, Subcomplex.mem_op_obj_iff, mem_fiber_iff, opFunctor_map, op_map,
    Equiv.apply_symm_apply, opObjEquiv.symm.injective.eq_iff]
  -- Both sides compare with a degeneracy of `y`, along the unique map `n ⟶ ⦋0⦌`.
  congr!

end SSet
