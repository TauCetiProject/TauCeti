module

public import Mathlib.AlgebraicTopology.Quasicategory.InnerFibration

/-!
# Fibers of maps of simplicial sets

For a map of simplicial sets `q : X ⟶ Y` and a subcomplex `A` of `Y`, the restriction
`A.fromPreimage q : A.preimage q ⟶ A` of `q` over `A` is a base change of `q`, so it inherits every
right lifting property of `q`. In particular it is an inner fibration, or a Kan fibration, when `q`
is.

The fiber `SSet.fiber q y` of `q` over a vertex `y` of `Y` is the preimage of the subcomplex
generated by `y`. That subcomplex is terminal, so the fiber of an inner fibration is a
quasicategory, and the fiber of a Kan fibration is a Kan complex. Simplicial sets of maps over a
base, such as the sections of an inner fibration, are fibers of this kind.

## Main definitions

* `SSet.fiber q y`: the fiber of `q : X ⟶ Y` over the vertex `y`, as a subcomplex of `X`.

## Main results

* `SSet.Subcomplex.hasLiftingProperty_fromPreimage`: the restriction of `q` over a subcomplex has
  the right lifting properties of `q`.
* `SSet.Subcomplex.isTerminalOfSimplex`: the subcomplex generated by a vertex is terminal.
* `SSet.range_le_fiber_iff`: a map lands in the fiber of `q` over `y` exactly when its composite
  with `q` is constant at `y`.
* `SSet.fiber.quasicategory`, `SSet.fiber.kanComplex`: the fibers of inner fibrations are
  quasicategories, and those of Kan fibrations are Kan complexes.

## References

* J. Lurie, *Higher Topos Theory*, Section 2.1.1.
-/

public section

universe u

open CategoryTheory Limits HomotopicalAlgebra Simplicial

namespace SSet

open modelCategoryQuillen

variable {X Y : SSet.{u}}

namespace Subcomplex

/-- The restriction `A.fromPreimage q` of `q` over a subcomplex `A` has the right lifting property
with respect to every map against which `q` has it: a lift for `q` of a square over `A` lands in
the preimage of `A`. -/
instance hasLiftingProperty_fromPreimage {P Q : SSet.{u}} (i : P ⟶ Q) (q : X ⟶ Y)
    [HasLiftingProperty i q] (A : Y.Subcomplex) : HasLiftingProperty i (A.fromPreimage q) where
  sq_hasLift {t b} sq := by
    have sq' : CommSq (t ≫ (A.preimage q).ι) i q (b ≫ A.ι) :=
      ⟨by rw [Category.assoc, ← fromPreimage_ι, ← Category.assoc, sq.w, Category.assoc]⟩
    refine ⟨⟨{ l := lift sq'.lift ?_, fac_left := ?_, fac_right := ?_ }⟩⟩
    · rw [← image_top, image_le_iff, ← preimage_comp, sq'.fac_right, preimage_comp, preimage_ι]
      exact top_le_iff.2 (by ext; simp)
    · rw [← cancel_mono (A.preimage q).ι, Category.assoc, lift_ι, CommSq.fac_left]
    · rw [← cancel_mono A.ι, Category.assoc, fromPreimage_ι, ← Category.assoc, lift_ι,
        CommSq.fac_right]

/-- The restriction of an inner fibration over a subcomplex is an inner fibration. -/
instance innerFibration_fromPreimage (q : X ⟶ Y) [InnerFibration q] (A : Y.Subcomplex) :
    InnerFibration (A.fromPreimage q) :=
  ⟨fun _ _ i hi ↦ have := InnerFibration.mem (q := q) i hi; inferInstance⟩

/-- The restriction of a Kan fibration over a subcomplex is a Kan fibration. -/
instance fibration_fromPreimage (q : X ⟶ Y) [Fibration q] (A : Y.Subcomplex) :
    Fibration (A.fromPreimage q) := by
  rw [fibration_iff] at *
  intro _ _ i hi
  have := ‹J.rlp q› i hi
  infer_instance

/-- The simplices of the subcomplex generated by a vertex `y` are the degeneracies of `y`. -/
lemma mem_ofSimplex₀_obj_iff (y : Y _⦋0⦌) {n : SimplexCategoryᵒᵖ} (z : Y.obj n) :
    z ∈ (ofSimplex y).obj n ↔ z = Y.map (n.unop.const _ 0).op y := by
  rw [mem_ofSimplex_obj_iff]
  exact ⟨fun ⟨f, hf⟩ ↦ by rw [← hf, Subsingleton.elim f (n.unop.const _ 0)],
    fun h ↦ ⟨_, h.symm⟩⟩

/-- The subcomplex generated by a vertex `y` is terminal. -/
def isTerminalOfSimplex (y : Y _⦋0⦌) : IsTerminal (ofSimplex y : SSet.{u}) :=
  IsTerminal.ofUniqueHom (fun _ ↦ const ⟨y, mem_ofSimplex_obj y⟩) fun _ g ↦ by
    ext n z
    exact Subtype.ext ((mem_ofSimplex₀_obj_iff y _).1 (g.app n z).2)

/-- A map lands in the subcomplex generated by a vertex `y` exactly when it is constant at `y`. -/
lemma range_le_ofSimplex_iff {Z : SSet.{u}} (g : Z ⟶ Y) (y : Y _⦋0⦌) :
    range g ≤ ofSimplex y ↔ g = const y := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · ext n z
    exact (mem_ofSimplex₀_obj_iff y _).1 (h _ ⟨z, rfl⟩)
  · rintro n _ ⟨z, rfl⟩
    rw [h]
    exact (mem_ofSimplex₀_obj_iff y _).2 rfl

end Subcomplex

/-- The fiber of a map `q : X ⟶ Y` over a vertex `y` of `Y`: the subcomplex of `X` of the simplices
that `q` sends to degeneracies of `y`. -/
def fiber (q : X ⟶ Y) (y : Y _⦋0⦌) : X.Subcomplex :=
  (Subcomplex.ofSimplex y).preimage q

/-- The simplices of the fiber of `q` over `y` are those that `q` sends to degeneracies of `y`. -/
@[simp]
lemma mem_fiber_iff (q : X ⟶ Y) (y : Y _⦋0⦌) {n : SimplexCategoryᵒᵖ} (x : X.obj n) :
    x ∈ (fiber q y).obj n ↔ q.app n x = Y.map (n.unop.const _ 0).op y := by
  rw [fiber, Subcomplex.preimage_obj, Set.mem_preimage, Subcomplex.mem_ofSimplex₀_obj_iff]

/-- A map `g : Z ⟶ X` lands in the fiber of `q` over `y` exactly when `g ≫ q` is constant at `y`.
This is the universal property of the fiber. -/
lemma range_le_fiber_iff {Z : SSet.{u}} (g : Z ⟶ X) (q : X ⟶ Y) (y : Y _⦋0⦌) :
    Subcomplex.range g ≤ fiber q y ↔ g ≫ q = const y := by
  rw [fiber, ← Subcomplex.image_top, ← Subcomplex.image_le_iff, ← Subcomplex.image_comp,
    Subcomplex.image_top, Subcomplex.range_le_ofSimplex_iff]

/-- A terminal simplicial set is a quasicategory. -/
lemma quasicategory_of_isTerminal (h : IsTerminal X) : Quasicategory X :=
  ⟨fun _ _ _ _ _ ↦ ⟨h.from _, h.hom_ext _ _⟩⟩

/-- A terminal simplicial set is a Kan complex. -/
lemma kanComplex_of_isTerminal (h : IsTerminal X) : KanComplex X :=
  KanComplex.iff.2 fun _ _ _ _ ↦ ⟨h.from _, fun _ _ ↦ h.hom_ext _ _⟩

/-- The fiber of an inner fibration over a vertex is a quasicategory. -/
instance fiber.quasicategory (q : X ⟶ Y) [InnerFibration q] (y : Y _⦋0⦌) :
    Quasicategory (fiber q y) :=
  have := quasicategory_of_isTerminal (Subcomplex.isTerminalOfSimplex y)
  -- `fiber q y` is by definition the source of the restriction of `q` over `ofSimplex y`.
  quasicategory_of_innerFibration (X := ((Subcomplex.ofSimplex y).preimage q : SSet))
    ((Subcomplex.ofSimplex y).fromPreimage q)

/-- The fiber of a Kan fibration over a vertex is a Kan complex. -/
instance fiber.kanComplex (q : X ⟶ Y) [Fibration q] (y : Y _⦋0⦌) : KanComplex (fiber q y) :=
  have := kanComplex_of_isTerminal (Subcomplex.isTerminalOfSimplex y)
  -- `fiber q y` is by definition the source of the restriction of `q` over `ofSimplex y`.
  isFibrant_of_fibration (X := ((Subcomplex.ofSimplex y).preimage q : SSet))
    ((Subcomplex.ofSimplex y).fromPreimage q)

end SSet
