module

public import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Basic
public import Mathlib.CategoryTheory.MorphismProperty.WeakFactorizationSystem

import Mathlib.AlgebraicTopology.SimplicialSet.Presentable
import Mathlib.AlgebraicTopology.SimplicialSet.Monomorphisms
import Mathlib.CategoryTheory.Limits.Types.Colimits

/-!
# The Kan–Quillen weak factorization systems

Boundary inclusions permit the small object argument because their domains are finite
simplicial sets. The resulting functorial factorization has a monomorphism as its first
map and a map lifting against all monomorphisms as its second map. Together with the
horn factorization, this gives the two weak factorization systems used in the
Kan–Quillen model structure:

* monomorphisms and maps lifting against all boundary inclusions;
* anodyne extensions and Kan fibrations.

We also show that every anodyne extension is a monomorphism. No identification with
geometric weak equivalences is asserted here.

The constructions reuse Mathlib's small object argument and its horn smallness proof
by Joël Riou, and its skeletal description of simplicial monomorphisms. The native
`MorphismProperty.functorialFactorizationData` exposes the factors, their functoriality,
and their lifting properties for both systems.

## References

* P. G. Goerss and J. F. Jardine, *Simplicial homotopy theory*, Chapter I, Section 11.
-/

public section

universe u

open CategoryTheory MorphismProperty HomotopicalAlgebra
open scoped Simplicial

namespace SSet

namespace modelCategoryQuillen

attribute [local instance] Cardinal.fact_isRegular_aleph0
  Cardinal.orderBotAleph0OrdToType

/-- The family of boundary inclusions is small in the universe of its simplices. -/
instance isSmall_I : MorphismProperty.IsSmall.{u} I.{u} :=
  isSmall_ofHoms ..

/-- Finite boundary domains make countable cell attachment sufficient for the small
object argument. -/
instance isCardinalForSmallObjectArgument_I :
    IsCardinalForSmallObjectArgument I.{u} Cardinal.aleph0.{u} where
  preservesColimit {A B X Y} i hi f hf := by
    have : IsFinitelyPresentable.{u} A := by
      obtain ⟨n⟩ := hi
      infer_instance
    infer_instance

/-- Boundary inclusions admit the small object argument. -/
instance hasSmallObjectArgument_I : HasSmallObjectArgument.{u} I.{u} :=
  ⟨.aleph0, inferInstance, inferInstance, inferInstance⟩

/-- The left class generated by boundary inclusions consists exactly of monomorphisms. -/
lemma llp_rlp_I : I.rlp.llp = monomorphisms SSet.{u} := by
  apply le_antisymm
  · rw [llp_rlp_of_hasSmallObjectArgument.{u}]
    simp only [retracts_le_iff, transfiniteCompositions_le_iff, pushouts_le_iff,
      coproducts_le_iff (Q := monomorphisms SSet.{u}), I_le_monomorphisms]
  · rw [← rlp_monomorphisms]
    exact le_llp_rlp _

/-- Every simplicial map factors functorially as a monomorphism followed by a map
lifting against all boundary inclusions. -/
instance hasFunctorialFactorization_monomorphisms :
    HasFunctorialFactorization (monomorphisms SSet.{u}) I.rlp := by
  rw [← llp_rlp_I]
  infer_instance

/-- Monomorphisms and maps lifting against boundary inclusions form a weak
factorization system. -/
instance isWeakFactorizationSystem_monomorphisms :
    IsWeakFactorizationSystem (monomorphisms SSet.{u}) I.rlp where
  rlp := rlp_monomorphisms
  llp := llp_rlp_I

/-- Every simplicial map factors functorially as an anodyne extension followed by
a Kan fibration, using Mathlib's horn small object construction. -/
instance hasFunctorialFactorization_anodyneExtensions :
    HasFunctorialFactorization anodyneExtensions.{u} (fibrations SSet.{u}) := by
  rw [anodyneExtensions_eq_llp_rlp, fibrations_eq]
  infer_instance

/-- Anodyne extensions and Kan fibrations form a weak factorization system. -/
instance isWeakFactorizationSystem_anodyneExtensions :
    IsWeakFactorizationSystem anodyneExtensions.{u} (fibrations SSet.{u}) where
  rlp := by simp only [anodyneExtensions_eq_llp_rlp, fibrations_eq, rlp_llp_rlp]
  llp := rfl

end modelCategoryQuillen

/-- Anodyne extensions are monomorphisms. -/
lemma anodyneExtensions_le_monomorphisms :
    anodyneExtensions.{u} ≤ monomorphisms SSet.{u} := by
  rw [anodyneExtensions_eq_llp_rlp, ← modelCategoryQuillen.llp_rlp_I]
  apply antitone_llp
  rw [← rlp_monomorphisms]
  exact antitone_rlp modelCategoryQuillen.J_le_monomorphisms

end SSet
