import TauCeti.Topology.Homotopy.Path

/-!
# Covers by path-connected sets generate the fundamental group

Let `U : ι → Set X` be a family of subsets whose interiors cover `X`, all containing the basepoint
`x`, such that every pairwise intersection `U i ∩ U j` (in particular every `U i`) is path
connected. Then `π₁(X, x)` is generated by the images of the groups `π₁(U i, x)` under the
inclusions. This is the surjectivity half of the Seifert--van Kampen theorem: the canonical map
from the free product of the `π₁(U i, x)` to `π₁(X, x)` is surjective.

The proof is derived from the generation half of the groupoid van Kampen theorem,
`TauCeti.FundamentalGroupoid.iSup_im_map_subtypeVal_eq_top`. Choose, for every point `y`, a path
`τ y` from `x` to `y` inside a single member of the cover. The morphisms `f : y ⟶ z` of the
fundamental groupoid for which the loop `τ y ≫ f ≫ (τ z)⁻¹` lies in the subgroup generated by the
images form a subgroupoid. It contains every morphism coming from a member `U i` of the cover,
because the path-connected intersections allow each of `τ y`, `τ z` to be exchanged for a path in
`U i` at the cost of a loop in a single member of the cover. Hence it is the whole fundamental
groupoid, and every loop at `x` lies in the subgroup.

Path-connectedness of the pairwise intersections cannot be dropped: the circle is the union of two
open arcs, each simply connected, whose intersection has two components.

## Main results

* `TauCeti.FundamentalGroup.iSup_range_map_subtypeVal_eq_top`: the images of the fundamental
  groups of the members of the cover generate `π₁(X, x)`.
* `TauCeti.FundamentalGroup.range_map_subtypeVal_sup_eq_top`: the same statement for a cover by
  two sets `A`, `B` with `A`, `B` and `A ∩ B` path connected.

## References

* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, Theorem 1.20, the proof that
  the map `Φ` is surjective.
* R. Brown, *Topology and Groupoids*, Section 6.7.
-/

public section

open CategoryTheory Set Topology

namespace TauCeti

namespace FundamentalGroup

open _root_.FundamentalGroupoid hiding fromPath

variable {X : Type*} [TopologicalSpace X] {ι : Type*} {U : ι → Set X} {x : X}

/-- A loop at `x` with range in `U i` lies in the subgroup generated by the images of all the
`π₁(U j, x)`. -/
private theorem fromPath_mem_iSup_range (hx : ∀ i, x ∈ U i) {i : ι} (γ : Path x x)
    (hγ : range γ ⊆ U i) :
    (_root_.FundamentalGroup.fromPath ⟦γ⟧ : _root_.FundamentalGroup X x) ∈
      (⨆ i, (_root_.FundamentalGroup.map (ContinuousMap.subtypeVal (U i)) ⟨x, hx i⟩).range :
        Subgroup (_root_.FundamentalGroup X x)) := by
  refine Subgroup.mem_iSup_of_mem i ⟨_root_.FundamentalGroup.fromPath
    ⟦γ.codRestrict (x := ⟨x, hx i⟩) (y := ⟨x, hx i⟩) fun t ↦ hγ (mem_range_self t)⟧, ?_⟩
  rw [FundamentalGroup.map_fromPath]
  exact congrArg (fun q : Path x x ↦ (_root_.FundamentalGroup.fromPath ⟦q⟧ :
    _root_.FundamentalGroup X x)) (Path.map_codRestrict (x := ⟨x, hx i⟩) (y := ⟨x, hx i⟩) γ _)

/-- The loop `p ≫ q⁻¹`, for paths `p` and `q` from `x` to `c` inside a single `U i`, lies in the
subgroup generated by the images of the `π₁(U j, x)`. -/
private theorem comp_inv_mem_iSup_range (hx : ∀ i, x ∈ U i) {i : ι} {c : X} (p q : Path x c)
    (hp : range p ⊆ U i) (hq : range q ⊆ U i) :
    (_root_.FundamentalGroupoid.fromPath ⟦p⟧ ≫ inv (_root_.FundamentalGroupoid.fromPath ⟦q⟧) :
      _root_.FundamentalGroup X x) ∈
      (⨆ i, (_root_.FundamentalGroup.map (ContinuousMap.subtypeVal (U i)) ⟨x, hx i⟩).range :
        Subgroup (_root_.FundamentalGroup X x)) := by
  rw [← Groupoid.inv_eq_inv]
  refine fromPath_mem_iSup_range hx (i := i) (p.trans q.symm) ?_
  rw [Path.trans_range, Path.symm_range]
  exact union_subset hp hq

/-- The key step of the generation theorem. If `α` runs from `x` to `a` inside `U j`, `δ` from `a`
to `b` inside `U i` and `β` from `x` to `b` inside `U k`, then the loop `α ≫ δ ≫ β⁻¹` lies in the
subgroup generated by the images of the `π₁(U l, x)`. Choose `σa` from `x` to `a` inside
`U j ∩ U i` and `σb` from `x` to `b` inside `U i ∩ U k`, and split the loop as
`(α ≫ σa⁻¹) ≫ (σa ≫ δ ≫ σb⁻¹) ≫ (σb ≫ β⁻¹)`, three loops each inside a single member. -/
private theorem comp_comp_inv_mem_iSup_range (hx : ∀ i, x ∈ U i)
    (hpc : ∀ i j, IsPathConnected (U i ∩ U j)) {i j k : ι} {a b : X} (α : Path x a)
    (δ : Path a b) (β : Path x b) (hα : range α ⊆ U j) (hδ : range δ ⊆ U i)
    (hβ : range β ⊆ U k) :
    (_root_.FundamentalGroupoid.fromPath ⟦α⟧ ≫ _root_.FundamentalGroupoid.fromPath ⟦δ⟧ ≫
        inv (_root_.FundamentalGroupoid.fromPath ⟦β⟧) : _root_.FundamentalGroup X x) ∈
      (⨆ i, (_root_.FundamentalGroup.map (ContinuousMap.subtypeVal (U i)) ⟨x, hx i⟩).range :
        Subgroup (_root_.FundamentalGroup X x)) := by
  set H : Subgroup (_root_.FundamentalGroup X x) :=
    ⨆ i, (_root_.FundamentalGroup.map (ContinuousMap.subtypeVal (U i)) ⟨x, hx i⟩).range
  have hσa := (hpc j i).joinedIn x ⟨hx j, hx i⟩ a ⟨hα α.target_mem_range, hδ δ.source_mem_range⟩
  have hσb := (hpc i k).joinedIn x ⟨hx i, hx k⟩ b ⟨hδ δ.target_mem_range, hβ β.target_mem_range⟩
  have hσa' : range hσa.somePath ⊆ U j ∩ U i := range_subset_iff.2 hσa.somePath_mem
  have hσb' : range hσb.somePath ⊆ U i ∩ U k := range_subset_iff.2 hσb.somePath_mem
  set σa := _root_.FundamentalGroupoid.fromPath ⟦hσa.somePath⟧
  set σb := _root_.FundamentalGroupoid.fromPath ⟦hσb.somePath⟧
  have hsplit : _root_.FundamentalGroupoid.fromPath ⟦α⟧ ≫
      _root_.FundamentalGroupoid.fromPath ⟦δ⟧ ≫ inv (_root_.FundamentalGroupoid.fromPath ⟦β⟧) =
      (_root_.FundamentalGroupoid.fromPath ⟦α⟧ ≫ inv σa) ≫
        (σa ≫ _root_.FundamentalGroupoid.fromPath ⟦δ⟧ ≫ inv σb) ≫
        (σb ≫ inv (_root_.FundamentalGroupoid.fromPath ⟦β⟧)) := by
    simp
  have hmid : (σa ≫ _root_.FundamentalGroupoid.fromPath ⟦δ⟧ ≫ inv σb :
      _root_.FundamentalGroup X x) ∈ H := by
    rw [← Groupoid.inv_eq_inv]
    refine fromPath_mem_iSup_range hx (i := i) (hσa.somePath.trans (δ.trans hσb.somePath.symm)) ?_
    rw [Path.trans_range, Path.trans_range, Path.symm_range]
    exact union_subset (hσa'.trans inter_subset_right)
      (union_subset hδ (hσb'.trans inter_subset_left))
  rw [hsplit]
  -- In `End`, `f ≫ g` is the product `g * f`.
  exact H.mul_mem (H.mul_mem (comp_inv_mem_iSup_range hx _ _ (hσb'.trans inter_subset_right) hβ)
    hmid) (comp_inv_mem_iSup_range hx _ _ hα (hσa'.trans inter_subset_left))

/-- **Generation half of the Seifert--van Kampen theorem.** Let the interiors of the sets `U i`
cover `X`, let every `U i` contain `x`, and let every intersection `U i ∩ U j` be path connected.
Then `π₁(X, x)` is generated by the images of the fundamental groups `π₁(U i, x)` under the
inclusions. -/
theorem iSup_range_map_subtypeVal_eq_top (hU : ∀ y, ∃ i, U i ∈ 𝓝 y) (hx : ∀ i, x ∈ U i)
    (hpc : ∀ i j, IsPathConnected (U i ∩ U j)) :
    (⨆ i, (_root_.FundamentalGroup.map (ContinuousMap.subtypeVal (U i)) ⟨x, hx i⟩).range :
      Subgroup (_root_.FundamentalGroup X x)) = ⊤ := by
  set H : Subgroup (_root_.FundamentalGroup X x) :=
    ⨆ i, (_root_.FundamentalGroup.map (ContinuousMap.subtypeVal (U i)) ⟨x, hx i⟩).range
  -- For every point `y`, a path `τ y` from `x` to `y` inside the single member `U (i₀ y)`.
  choose i₀ hi₀ using hU
  have hτ : ∀ y, JoinedIn (U (i₀ y)) x y := fun y ↦
    ((hpc (i₀ y) (i₀ y)).joinedIn x ⟨hx _, hx _⟩ y
      ⟨mem_of_mem_nhds (hi₀ y), mem_of_mem_nhds (hi₀ y)⟩).mono inter_subset_left
  have hτ' : ∀ y, range (hτ y).somePath ⊆ U (i₀ y) := fun y ↦
    range_subset_iff.2 (hτ y).somePath_mem
  let τ : ∀ c : _root_.FundamentalGroupoid X, mk x ⟶ c := fun c ↦
    _root_.FundamentalGroupoid.fromPath ⟦(hτ c.as).somePath⟧
  have hinv : ∀ g : _root_.FundamentalGroup X x, g⁻¹ = inv g := fun g ↦ Groupoid.inv_eq_inv g
  -- The morphisms `f : c ⟶ d` whose conjugate `τ c ≫ f ≫ (τ d)⁻¹` lies in `H`.
  let S : Subgroupoid (_root_.FundamentalGroupoid X) :=
    { arrows := fun c d ↦ {f | (τ c ≫ f ≫ inv (τ d) : _root_.FundamentalGroup X x) ∈ H}
      inv := fun {c d f} hf ↦ by
        have h := H.inv_mem hf
        rw [hinv] at h
        simpa [Groupoid.inv_eq_inv] using h
      mul := fun {c d e f} hf {g} hg ↦ by
        have h := H.mul_mem hg hf
        rw [End.mul_def] at h
        simpa using h }
  -- Every morphism coming from a single member `U i` lies in `S`, so `S` is everything.
  have hS : S = ⊤ := by
    rw [eq_top_iff, ← FundamentalGroupoid.iSup_im_map_subtypeVal_eq_top
      fun y ↦ ⟨i₀ y, hi₀ y⟩]
    refine iSup_le fun i ↦ ?_
    rw [Subgroupoid.im, Subgroupoid.map_le_iff_le_comap]
    rintro ⟨⟨a⟩, ⟨b⟩, g⟩ -
    induction g using Path.Homotopic.Quotient.ind with | mk δ =>
    exact comp_comp_inv_mem_iSup_range hx hpc (hτ a).somePath (δ.map continuous_subtype_val)
      (hτ b).somePath (hτ' a) (by rintro _ ⟨t, rfl⟩; exact (δ t).2) (hτ' b)
  -- A loop `γ` at `x` lies in `S`, and `τ x` is a loop inside `U (i₀ x)`, so `γ` lies in `H`.
  refine eq_top_iff.2 fun γ _ ↦ ?_
  have hγ : γ ∈ S.arrows (mk x) (mk x) := by
    rw [hS]
    trivial
  have hτx : (τ (mk x) : _root_.FundamentalGroup X x) ∈ H :=
    fromPath_mem_iSup_range hx _ (hτ' x)
  have h := H.mul_mem hτx (H.mul_mem hγ (H.inv_mem hτx))
  rw [hinv, End.mul_def, End.mul_def] at h
  simpa using h

/-- **Generation half of the Seifert--van Kampen theorem, for two sets.** If the interiors of
`A` and `B` cover `X`, and `A`, `B` and `A ∩ B` are path connected and contain `x`, then `π₁(X, x)`
is generated by the images of `π₁(A, x)` and `π₁(B, x)` under the inclusions. -/
theorem range_map_subtypeVal_sup_eq_top {A B : Set X} (hAB : interior A ∪ interior B = univ)
    (hA : IsPathConnected A) (hB : IsPathConnected B) (hAB' : IsPathConnected (A ∩ B))
    (hxA : x ∈ A) (hxB : x ∈ B) :
    ((_root_.FundamentalGroup.map (ContinuousMap.subtypeVal A) ⟨x, hxA⟩).range ⊔
        (_root_.FundamentalGroup.map (ContinuousMap.subtypeVal B) ⟨x, hxB⟩).range :
      Subgroup (_root_.FundamentalGroup X x)) = ⊤ := by
  have hx : ∀ b : Bool, x ∈ bif b then A else B := fun b ↦ by cases b <;> assumption
  have h := iSup_range_map_subtypeVal_eq_top (U := fun b : Bool ↦ bif b then A else B) (x := x)
    (fun y ↦ by
      rcases (hAB ▸ mem_univ y : y ∈ interior A ∪ interior B) with hy | hy
      exacts [⟨true, mem_interior_iff_mem_nhds.1 hy⟩, ⟨false, mem_interior_iff_mem_nhds.1 hy⟩])
    hx
    (fun b b' ↦ by
      cases b <;> cases b' <;>
        simp only [Bool.cond_true, Bool.cond_false, inter_self, inter_comm B A] <;> assumption)
  refine eq_top_iff.2 (h.ge.trans (iSup_le fun b ↦ ?_))
  cases b
  exacts [le_sup_right, le_sup_left]

end FundamentalGroup

end TauCeti
