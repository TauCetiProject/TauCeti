module

public import TauCeti.AlgebraicTopology.FundamentalGroup.VanKampen.Presentation.Cover

/-!
# Naturality of van Kampen cover presentations

A continuous map carrying each member of one based family into a specified member of another
induces a homomorphism between the free products of their fundamental groups. This map
preserves the overlap relations and hence descends to the van Kampen presentation quotients,
without cover or connectedness assumptions. Identity and composition laws make these quotient
maps functorial.

For neighborhood covers with path-connected triple intersections, the presentation
isomorphisms commute with the induced map of ambient fundamental groups. In particular, a
refinement induces an isomorphism of presentations, independent of the chosen index assignment.
The presentation isomorphisms used here are those obtained from fundamental-groupoid gluing in
`TauCeti.AlgebraicTopology.FundamentalGroup.VanKampen.Cover`.

## References

* A. Hatcher, *Algebraic Topology*, Section 1.2, Theorem 1.20.
* R. Brown, *Topology and Groupoids*, 3rd ed., Section 6.7.
-/

public section

noncomputable section

open Set Topology

namespace TauCeti

variable {X Y Z : Type*} [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace Z]
  {ι κ η : Type*} {U : ι → Set X} {V : κ → Set Y} {W : η → Set Z}
  {x : X} (hx : ∀ i, x ∈ U i) (f : C(X, Y)) (r : ι → κ)
  (hf : ∀ i, MapsTo f (U i) (V (r i))) (hy : ∀ j, f x ∈ V j)

/-- The free-product map induced by a continuous map and an assignment of target members. -/
def vanKampenCoverFreeMap :
    Monoid.CoprodI (fun i ↦ FundamentalGroup (U i) ⟨x, hx i⟩) →*
      Monoid.CoprodI (fun j ↦ FundamentalGroup (V j) ⟨f x, hy j⟩) :=
  Monoid.CoprodI.lift fun i ↦ Monoid.CoprodI.of.comp
    (FundamentalGroup.map
      ((f.restrictPreimage (V (r i))).comp (ContinuousMap.inclusion (fun _ hz ↦ hf i hz)))
      ⟨x, hx i⟩)

/-- On a factor the free-product map is the map of fundamental groups of the restricted map. -/
@[simp]
lemma vanKampenCoverFreeMap_of (i : ι) (a : FundamentalGroup (U i) ⟨x, hx i⟩) :
    vanKampenCoverFreeMap hx f r hf hy (Monoid.CoprodI.of a) =
      Monoid.CoprodI.of (i := r i) (FundamentalGroup.map
        ((f.restrictPreimage (V (r i))).comp (ContinuousMap.inclusion (fun _ hz ↦ hf i hz)))
        ⟨x, hx i⟩ a) := by
  unfold vanKampenCoverFreeMap
  rw [Monoid.CoprodI.lift_of]
  rfl

/-- The free-product map commutes with the inclusion-induced maps to the ambient groups. -/
lemma vanKampenWideLift_comp_coverFreeMap :
    (vanKampenWideLift V (f x) hy).comp (vanKampenCoverFreeMap hx f r hf hy) =
      (FundamentalGroup.map f x).comp (vanKampenWideLift U x hx) := by
  apply Monoid.CoprodI.ext_hom
  intro i
  apply MonoidHom.ext
  intro a
  -- Inclusion basepoints are equal by proof irrelevance; expose them for rewriting.
  dsimp only [MonoidHom.comp_apply]
  erw [vanKampenCoverFreeMap_of, vanKampenWideLift_of, vanKampenWideLift_of]
  obtain ⟨a⟩ := a
  induction a using Path.Homotopic.Quotient.ind with
  | mk γ => rfl

/-- Maps of based families preserve the normal subgroups generated by overlap relations. -/
lemma vanKampenCoverRelations_le_comap_coverFreeMap :
    vanKampenCoverRelations U x hx ≤
      (vanKampenCoverRelations V (f x) hy).comap (vanKampenCoverFreeMap hx f r hf hy) := by
  rw [vanKampenCoverRelations_def]
  apply Subgroup.normalClosure_le_normal
  rintro _ ⟨i, j, a, rfl⟩
  -- The normal-closure generators use the intersection subtype's bundled basepoint.
  erw [Subgroup.mem_comap, map_mul, map_inv]
  erw [vanKampenCoverFreeMap_of (i := i), vanKampenCoverFreeMap_of (i := j)]
  let t : C(↥(U i ∩ U j), ↥(V (r i) ∩ V (r j))) :=
    (f.restrictPreimage (V (r i) ∩ V (r j))).comp
      (ContinuousMap.inclusion fun z hz ↦ ⟨hf i hz.1, hf j hz.2⟩)
  -- Both overlap squares have the same underlying composite on representative loops.
  have hl : FundamentalGroup.map
        ((f.restrictPreimage (V (r i))).comp (ContinuousMap.inclusion (fun _ hz ↦ hf i hz)))
        ⟨x, hx i⟩
        (FundamentalGroup.map (ContinuousMap.inclusion inter_subset_left) ⟨x, hx i, hx j⟩ a) =
      FundamentalGroup.map (ContinuousMap.inclusion inter_subset_left) ⟨f x, hy (r i), hy (r j)⟩
        (FundamentalGroup.map t ⟨x, hx i, hx j⟩ a) := by
    obtain ⟨a⟩ := a
    induction a using Path.Homotopic.Quotient.ind with
    | mk γ => rfl
  have hr : FundamentalGroup.map
        ((f.restrictPreimage (V (r j))).comp (ContinuousMap.inclusion (fun _ hz ↦ hf j hz)))
        ⟨x, hx j⟩
        (FundamentalGroup.map (ContinuousMap.inclusion inter_subset_right) ⟨x, hx i, hx j⟩ a) =
      FundamentalGroup.map (ContinuousMap.inclusion inter_subset_right) ⟨f x, hy (r i), hy (r j)⟩
        (FundamentalGroup.map t ⟨x, hx i, hx j⟩ a) := by
    obtain ⟨a⟩ := a
    induction a using Path.Homotopic.Quotient.ind with
    | mk γ => rfl
  erw [hl, hr]
  exact mul_inv_mem_vanKampenCoverRelations V (f x) hy (r i) (r j)
    (FundamentalGroup.map t ⟨x, hx i, hx j⟩ a)

/-- The quotient map between van Kampen presentations induced by a map of based families.
Neither family needs to cover, and intersections need not be path connected. -/
def vanKampenCoverQuotientMap :
    (Monoid.CoprodI (fun i ↦ FundamentalGroup (U i) ⟨x, hx i⟩)) ⧸
        vanKampenCoverRelations U x hx →*
      (Monoid.CoprodI (fun j ↦ FundamentalGroup (V j) ⟨f x, hy j⟩)) ⧸
        vanKampenCoverRelations V (f x) hy :=
  QuotientGroup.map _ _ (vanKampenCoverFreeMap hx f r hf hy)
    (vanKampenCoverRelations_le_comap_coverFreeMap hx f r hf hy)

/-- On quotient representatives the presentation map is induced by the free-product map. -/
@[simp]
lemma vanKampenCoverQuotientMap_mk
    (a : Monoid.CoprodI fun i ↦ FundamentalGroup (U i) ⟨x, hx i⟩) :
    vanKampenCoverQuotientMap hx f r hf hy (QuotientGroup.mk a) =
      QuotientGroup.mk (vanKampenCoverFreeMap hx f r hf hy a) := by
  simp [vanKampenCoverQuotientMap]

/-- The identity of a based family induces the identity on its free product. -/
@[simp]
lemma vanKampenCoverFreeMap_id :
    vanKampenCoverFreeMap hx (ContinuousMap.id X) id (fun _ _ ha ↦ ha) hx =
      MonoidHom.id _ := by
  apply Monoid.CoprodI.ext_hom
  intro i
  apply MonoidHom.ext
  intro a
  dsimp only [MonoidHom.comp_apply, MonoidHom.id_apply]
  erw [vanKampenCoverFreeMap_of]
  obtain ⟨a⟩ := a
  -- The restricted identity is the identity on every representative loop.
  induction a using Path.Homotopic.Quotient.ind with
  | mk γ => rfl

variable (g : C(Y, Z)) (s : κ → η) (hg : ∀ j, MapsTo g (V j) (W (s j)))
  (hz : ∀ k, g (f x) ∈ W k)

/-- Free-product maps compose according to the maps of spaces and index assignments. -/
lemma vanKampenCoverFreeMap_comp :
    (vanKampenCoverFreeMap hy g s hg hz).comp (vanKampenCoverFreeMap hx f r hf hy) =
      vanKampenCoverFreeMap hx (g.comp f) (s ∘ r)
        (fun i _ ha ↦ hg (r i) (hf i ha)) hz := by
  apply Monoid.CoprodI.ext_hom
  intro i
  apply MonoidHom.ext
  intro a
  dsimp only [MonoidHom.comp_apply]
  erw [vanKampenCoverFreeMap_of, vanKampenCoverFreeMap_of, vanKampenCoverFreeMap_of]
  obtain ⟨a⟩ := a
  -- Both restricted composites apply g after f to the same representative loop.
  induction a using Path.Homotopic.Quotient.ind with
  | mk γ => rfl

/-- The identity of a based family induces the identity on its presentation quotient. -/
@[simp]
lemma vanKampenCoverQuotientMap_id :
    dsimp% (vanKampenCoverQuotientMap hx (ContinuousMap.id X) id (fun _ _ ha ↦ ha) hx =
      MonoidHom.id _) := by
  simp only [vanKampenCoverQuotientMap, vanKampenCoverFreeMap_id]
  exact QuotientGroup.map_id _ _

/-- Presentation quotient maps compose according to the maps of spaces and index assignments. -/
lemma vanKampenCoverQuotientMap_comp :
    (vanKampenCoverQuotientMap hy g s hg hz).comp (vanKampenCoverQuotientMap hx f r hf hy) =
      vanKampenCoverQuotientMap hx (g.comp f) (s ∘ r)
        (fun i _ ha ↦ hg (r i) (hf i ha)) hz := by
  apply MonoidHom.ext
  intro a
  induction a using QuotientGroup.induction_on with
  | H a =>
    simp only [MonoidHom.comp_apply, vanKampenCoverQuotientMap_mk]
    exact congrArg QuotientGroup.mk
      (DFunLike.congr_fun (vanKampenCoverFreeMap_comp hx f r hf hy g s hg hz) a)

variable (hU : ∀ z, ∃ i, U i ∈ 𝓝 z)
  (hUt : ∀ i j k, IsPathConnected (U i ∩ U j ∩ U k))
  (hV : ∀ z, ∃ j, V j ∈ 𝓝 z)
  (hVt : ∀ i j k, IsPathConnected (V i ∩ V j ∩ V k))

/-- The van Kampen presentation isomorphisms are natural under maps of based covers. -/
lemma vanKampenCoverQuotientEquiv_naturality :
    (vanKampenCoverQuotientEquiv (hx := hy) hV hVt).toMonoidHom.comp
        (vanKampenCoverQuotientMap hx f r hf hy) =
      (FundamentalGroup.map f x).comp
        (vanKampenCoverQuotientEquiv (hx := hx) hU hUt).toMonoidHom := by
  apply MonoidHom.ext
  intro a
  induction a using QuotientGroup.induction_on with
  | H a =>
    dsimp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom]
    rw [vanKampenCoverQuotientMap_mk, vanKampenCoverQuotientEquiv_mk,
      vanKampenCoverQuotientEquiv_mk]
    exact DFunLike.congr_fun (vanKampenWideLift_comp_coverFreeMap hx f r hf hy) a

/-- The quotient map is independent of the assignment of target members, even when the
families do not cover and their intersections are disconnected. -/
lemma vanKampenCoverQuotientMap_eq (r' : ι → κ)
    (hf' : ∀ i, MapsTo f (U i) (V (r' i))) :
    vanKampenCoverQuotientMap hx f r hf hy =
      vanKampenCoverQuotientMap hx f r' hf' hy := by
  apply QuotientGroup.monoidHom_ext
  apply Monoid.CoprodI.ext_hom
  intro i
  apply MonoidHom.ext
  intro a
  dsimp only [MonoidHom.comp_apply]
  erw [vanKampenCoverQuotientMap_mk, vanKampenCoverQuotientMap_mk,
    vanKampenCoverFreeMap_of, vanKampenCoverFreeMap_of]
  apply QuotientGroup.eq_iff_div_mem.mpr
  rw [div_eq_mul_inv]
  let t : C(U i, ↥(V (r i) ∩ V (r' i))) :=
    (f.restrictPreimage (V (r i) ∩ V (r' i))).comp
      (ContinuousMap.inclusion fun _ ha ↦ ⟨hf i ha, hf' i ha⟩)
  convert mul_inv_mem_vanKampenCoverRelations V (f x) hy (r i) (r' i)
    (FundamentalGroup.map t ⟨x, hx i⟩ a) using 1
  obtain ⟨a⟩ := a
  -- The two factorizations of f through the target overlap preserve the same loop.
  induction a using Path.Homotopic.Quotient.ind with
  | mk γ => rfl

include hU hUt in
/-- Refinement of based neighborhood covers induces an isomorphism of their presentations. -/
theorem bijective_vanKampenCoverQuotientMap_of_refinement
    {V : κ → Set X} (hy : ∀ j, x ∈ V j) (r : ι → κ) (hf : ∀ i, U i ⊆ V (r i))
    (hV : ∀ z, ∃ j, V j ∈ 𝓝 z)
    (hVt : ∀ i j k, IsPathConnected (V i ∩ V j ∩ V k)) :
    Function.Bijective
      (vanKampenCoverQuotientMap hx (ContinuousMap.id X) r (fun i _ ha ↦ hf i ha) hy) := by
  have h := vanKampenCoverQuotientEquiv_naturality hx (ContinuousMap.id X) r
    (fun i _ ha ↦ hf i ha) hy hU hUt hV hVt
  erw [FundamentalGroup.map_id, MonoidHom.id_comp] at h
  apply (Function.Bijective.of_comp_iff'
    (vanKampenCoverQuotientEquiv (hx := hy) hV hVt).bijective _).mp
  exact (congrArg (fun k : _ →* _ ↦ Function.Bijective k) h).mpr
    (vanKampenCoverQuotientEquiv (hx := hx) hU hUt).bijective

end TauCeti
