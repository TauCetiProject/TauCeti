/-!
# The classifying space of a uniquely divisible abelian group

Let `m` be an integer and `A` an abelian group on which multiplication by `m` is bijective, that
is, a module over `ℤ[1/m]`. Over a commutative semisimple ring `k` in which `m = 0`, for instance
`k = 𝔽₂` and `m = 2`, the group homology of `A` with trivial coefficients `k` vanishes in every
positive degree, and so the Eilenberg--MacLane space `K(A, 1) = B(Multiplicative A)` has the
`k`-homology of a point.

The proof follows Serre. The group `A` is the directed union of its finitely generated
`ℤ[1/m]`-submodules, and a class of a directed union comes from a member
(`TauCeti.groupHomology.isZero_groupHomology_of_directed`). Since `ℤ[1/m]` is a principal ideal
domain (`IsLocalization.isPrincipalIdealRing`), a finitely generated `ℤ[1/m]`-module is the product
of a free module `ℤ[1/m]ⁿ` and a torsion module. The torsion part is a finite group whose order is
prime to `m`, hence a unit of `k`, so its homology vanishes
(`groupHomology.subsingleton_of_isUnit_natCard`); the factor `ℤ[1/m]` is acyclic over `k`
(`TauCeti.isZero_groupHomology_localizationAway`); and a product of acyclic groups is acyclic over
a semisimple ring, by the Künneth theorem (`TauCeti.subsingleton_groupHomology_prod`).

For `m = 2` this is the vanishing `H̃_*(K(A, 1); 𝔽₂) = 0` for every uniquely two-divisible group
`A`, the case `n = 1` of the mod-two acyclicity of the Eilenberg--MacLane spaces `K(A, n)` that
drives the mod-two Hurewicz theorem.

## Main results

* `TauCeti.subsingleton_groupHomology_of_bijective_zsmul`: an abelian group on which
  multiplication by `m` is bijective has no positive-degree group homology with trivial
  coefficients in a semisimple ring in which `m = 0`.
* `TauCeti.subsingleton_classifyingSpace_singularHomology_of_bijective_zsmul`: the corresponding
  vanishing of the positive-degree homology of `K(A, 1)`.
* `TauCeti.IsUniquelyTwoDivisible.subsingleton_classifyingSpace_singularHomology`: `K(A, 1)` has the
  mod-two homology of a point when `A` is uniquely two-divisible.

## References

* J.-P. Serre, *Groupes d'homotopie et classes de groupes abéliens*, Ann. of Math. 58 (1953),
  Chapter I.
* K. S. Brown, *Cohomology of Groups*, Graduate Texts in Mathematics 87, Springer, 1982,
  Chapter V.
-/

public section

noncomputable section

open CategoryTheory IsLocalization.Away
open scoped DirectSum

namespace TauCeti

variable (k : Type) [CommRing k] {m : ℤ}

section Algebra

variable {T : Type*} [AddCommGroup T] [Module (Localization.Away m) T]

/-- The integer `m` is inverted in `ℤ[1/m]`, written with the integer cast. -/
private theorem intCast_mul_invSelf : (m : Localization.Away m) * invSelf m = 1 := by
  simpa using mul_invSelf (S := Localization.Away m) m

/-- In a `ℤ[1/m]`-module, `m⁻¹` undoes multiplication by `m`. -/
private theorem invSelf_smul_zsmul (x : T) : (invSelf m : Localization.Away m) • m • x = x := by
  rw [← Int.cast_smul_eq_zsmul (Localization.Away m), smul_smul, mul_comm, intCast_mul_invSelf,
    one_smul]

/-- Every element of `ℤ[1/m]` is an integer times a power of `m⁻¹`. -/
private theorem exists_eq_intCast_mul_invSelf_pow (r : Localization.Away m) :
    ∃ (j : ℕ) (a : ℤ), r = (a : Localization.Away m) * invSelf m ^ j := by
  obtain ⟨j, a, hr⟩ := surj m r
  refine ⟨j, a, ?_⟩
  rw [← eq_intCast (algebraMap ℤ (Localization.Away m)), ← hr, mul_assoc, ← mul_pow, mul_invSelf,
    one_pow, mul_one]

/-- If an element `x` of a `ℤ[1/m]`-module has finite additive order, then `m⁻¹ • x` is an integer
multiple of `x`: multiplication by `m` is injective, hence bijective, on the finite group
generated by `x`. -/
private theorem invSelf_smul_mem_zmultiples {x : T} (hx : IsOfFinAddOrder x) :
    (invSelf m : Localization.Away m) • x ∈ AddSubgroup.zmultiples x := by
  have : Finite (AddSubgroup.zmultiples x) := hx.finite_zmultiples
  let f : AddSubgroup.zmultiples x → AddSubgroup.zmultiples x := fun w ↦
    ⟨m • (w : T), AddSubgroup.zsmul_mem _ w.2 m⟩
  have hf : Function.Injective f := fun w w' h ↦ Subtype.ext <| by
    have h' : m • (w : T) = m • (w' : T) := congrArg Subtype.val h
    simpa only [invSelf_smul_zsmul (m := m)] using
      congrArg ((invSelf m : Localization.Away m) • ·) h'
  obtain ⟨w, hw⟩ := (Finite.injective_iff_surjective.1 hf) ⟨x, AddSubgroup.mem_zmultiples x⟩
  have hw : m • (w : T) = x := congrArg Subtype.val hw
  have hx : (invSelf m : Localization.Away m) • x = w := by
    simpa only [hw] using invSelf_smul_zsmul (m := m) (w : T)
  exact hx ▸ w.2

/-- **A finitely generated torsion `ℤ[1/m]`-module is finite.** If every element of a finitely
generated `ℤ[1/m]`-module has finite additive order, then the integer multiples of finitely many
`ℤ[1/m]`-generators already exhaust it, so it is a finitely generated torsion abelian group. -/
private theorem finite_of_moduleFinite_localizationAway [Module.Finite (Localization.Away m) T]
    (hT : IsAddTorsion T) : Finite T := by
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := Localization.Away m) (M := T)
  -- the additive subgroup generated by `s` is stable under `m⁻¹`, hence under `ℤ[1/m]`
  have hinv : ∀ (j : ℕ) {z : T}, z ∈ AddSubgroup.closure (s : Set T) →
      (invSelf m : Localization.Away m) ^ j • z ∈ AddSubgroup.closure (s : Set T) := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      intro z hz
      rw [pow_succ', mul_smul]
      exact AddSubgroup.zmultiples_le_of_mem (ih hz) (invSelf_smul_mem_zmultiples (hT _))
  let P : Submodule (Localization.Away m) T :=
    { (AddSubgroup.closure (s : Set T)).toAddSubmonoid with
      smul_mem' := fun r z hz ↦ by
        obtain ⟨j, a, rfl⟩ := exists_eq_intCast_mul_invSelf_pow r
        rw [mul_smul, Int.cast_smul_eq_zsmul]
        exact AddSubgroup.zsmul_mem _ (hinv j hz) a }
  have hP : P = ⊤ := eq_top_iff.2 (hs ▸ Submodule.span_le.2 AddSubgroup.subset_closure)
  have : AddGroup.FG T := AddGroup.fg_iff.2
    ⟨s, eq_top_iff.2 fun z _ ↦ show z ∈ P from hP ▸ Submodule.mem_top, s.finite_toSet⟩
  exact AddCommGroup.finite_of_fg_isAddTorsion T hT

/-- The order of a finite `ℤ[1/m]`-module is prime to `m`: a prime factor common to both would be
the order of an element killed by `m`. Hence it is a unit of every ring in which `m = 0`. -/
private theorem isUnit_natCard_of_localizationAway [Finite T] {R : Type*} [CommRing R]
    (hmR : (m : R) = 0) : IsUnit (Nat.card T : R) := by
  have hcop : Nat.Coprime (Nat.card T) m.natAbs := Nat.coprime_of_dvd fun p hp hT hm ↦ by
    have := Fact.mk hp
    obtain ⟨x, hx⟩ := exists_prime_addOrderOf_dvd_card' p hT
    have hmx : m • x = 0 := addOrderOf_dvd_iff_zsmul_eq_zero.1 (hx ▸ Int.ofNat_dvd_left.2 hm)
    have : x = 0 := by rw [← invSelf_smul_zsmul (m := m) x, hmx, smul_zero]
    exact hp.one_lt.ne' (by rw [← hx, this, addOrderOf_zero])
  have := (Int.isCoprime_iff_nat_coprime.2 (by simpa using hcop) :
    IsCoprime (Nat.card T : ℤ) m).map (Int.castRingHom R)
  rwa [map_natCast, eq_intCast, hmR, isCoprime_zero_right] at this

end Algebra

/-- An element of a `ℤ[1/m]`-module killed by a nonzero element of `ℤ[1/m]` has finite additive
order: clearing the denominator gives a nonzero integer that kills it. -/
private theorem isOfFinAddOrder_of_smul_eq_zero {T : Type*} [AddCommGroup T]
    [Module (Localization.Away m) T] {r : Localization.Away m} (hr : r ≠ 0) {x : T}
    (hx : r • x = 0) : IsOfFinAddOrder x := by
  obtain ⟨j, a, rfl⟩ := exists_eq_intCast_mul_invSelf_pow r
  refine isOfFinAddOrder_iff_zsmul_eq_zero.2
    ⟨a, fun h ↦ hr (by rw [h, Int.cast_zero, zero_mul]), ?_⟩
  -- `a = mʲ (a m⁻ʲ)` in `ℤ[1/m]`
  have ha : (a : Localization.Away m) = (m : Localization.Away m) ^ j * (a * invSelf m ^ j) := by
    rw [mul_left_comm, ← mul_pow, intCast_mul_invSelf, one_pow, mul_one]
  rw [← Int.cast_smul_eq_zsmul (Localization.Away m), ha, mul_smul, hx, smul_zero]

section Homology

/-- Positive-degree group homology with trivial coefficients only depends on the underlying
abelian group up to additive equivalence. -/
private theorem subsingleton_groupHomology_of_addEquiv {M N : Type} [AddCommGroup M]
    [AddCommGroup N] (e : M ≃+ N) {n : ℕ}
    [Subsingleton (groupHomology (Rep.trivial k (Multiplicative N) k) n)] :
    Subsingleton (groupHomology (Rep.trivial k (Multiplicative M) k) n) :=
  (groupHomology.mapIso (A := Rep.trivial k _ k) (B := Rep.trivial k _ k)
    (AddEquiv.toMultiplicative e) (LinearEquiv.refl k k)
    (fun _ ↦ by ext; simp) n).toLinearEquiv.toEquiv.subsingleton

/-- A module is the directed union of the submodules spanned by its finite subsets, so its group
homology vanishes in a given degree as soon as that of each of these submodules does. -/
private theorem subsingleton_groupHomology_of_forall_span {R A : Type} [CommRing R]
    [AddCommGroup A] [Module R A] {n : ℕ}
    (h : ∀ s : Finset A, Subsingleton
      (groupHomology (Rep.trivial k (Multiplicative (Submodule.span R (s : Set A))) k) n)) :
    Subsingleton (groupHomology (Rep.trivial k (Multiplicative A) k) n) := by
  let S (s : Finset A) : Subgroup (Multiplicative A) :=
    AddSubgroup.toSubgroup (Submodule.span R (s : Set A)).toAddSubgroup
  have hS : Directed (· ≤ ·) S := Monotone.directed_le fun s t hst ↦
    AddSubgroup.toSubgroup.monotone (Submodule.toAddSubgroup_mono
      (Submodule.span_mono (Finset.coe_subset.2 hst)))
  have hG : ⨆ s, S s = ⊤ := eq_top_iff.2 fun a _ ↦ Subgroup.mem_iSup_of_mem {a.toAdd} <|
    (Multiplicative.mem_toSubgroup _ _).2 <|
      Submodule.subset_span (Finset.mem_coe.2 (Finset.mem_singleton_self _))
  refine ModuleCat.subsingleton_of_isZero
    (TauCeti.groupHomology.isZero_groupHomology_of_directed hS hG fun s ↦ ?_)
  let e : S s ≃* Multiplicative (Submodule.span R (s : Set A)) :=
    { toFun x := Multiplicative.ofAdd ⟨x.1.toAdd, (Multiplicative.mem_toSubgroup _ _).1 x.2⟩
      invFun y := ⟨Multiplicative.ofAdd y.toAdd.1, (Multiplicative.mem_toSubgroup _ _).2 y.toAdd.2⟩
      left_inv _ := rfl
      right_inv _ := rfl
      map_mul' _ _ := rfl }
  have := h s
  rw [ModuleCat.isZero_iff_subsingleton]
  exact (groupHomology.mapIso (A := Rep.res (S s).subtype (Rep.trivial k _ k))
    (B := Rep.trivial k _ k) e (LinearEquiv.refl k k) (fun _ ↦ by ext; simp)
    n).toLinearEquiv.toEquiv.subsingleton

variable [IsSemisimpleRing k]

/-- The additive form of `TauCeti.subsingleton_groupHomology_prod`: a product of abelian groups
that are acyclic over a semisimple ring is acyclic. -/
private theorem subsingleton_groupHomology_multiplicative_prod {M N : Type} [AddCommGroup M]
    [AddCommGroup N]
    (hM : ∀ n, Subsingleton (groupHomology (Rep.trivial k (Multiplicative M) k) (n + 1)))
    (hN : ∀ n, Subsingleton (groupHomology (Rep.trivial k (Multiplicative N) k) (n + 1)))
    (n : ℕ) : Subsingleton (groupHomology (Rep.trivial k (Multiplicative (M × N)) k) (n + 1)) :=
  have := subsingleton_groupHomology_prod (Multiplicative M) (Multiplicative N) k hM hN n
  (groupHomology.mapIso (A := Rep.trivial k _ k) (B := Rep.trivial k _ k)
    (MulEquiv.prodMultiplicative M N) (LinearEquiv.refl k k)
    (fun _ ↦ by ext; simp) (n + 1)).toLinearEquiv.toEquiv.subsingleton

/-- The homology computation for a group presented as a free `ℤ[1/m]`-module `ℤ[1/m]ʳ` times a
finitely generated `ℤ[1/m]`-module killed by a nonzero element `q`. The free factor is a product of
copies of the acyclic group `ℤ[1/m]`, and the torsion factor is a finite group whose order is a
unit of `k`. -/
private theorem subsingleton_groupHomology_of_addEquiv_pi_prod (hm : m ≠ 0) (hmk : (m : k) = 0)
    {N T : Type} [AddCommGroup N] [AddCommGroup T] [Module (Localization.Away m) T]
    [Module.Finite (Localization.Away m) T] {r : ℕ} {q : Localization.Away m} (hq : q ≠ 0)
    (hqT : ∀ x : T, q • x = 0) (φ : N ≃+ (Fin r → Localization.Away m) × T) (n : ℕ) :
    Subsingleton (groupHomology (Rep.trivial k (Multiplicative N) k) (n + 1)) := by
  have hR (n : ℕ) :
      Subsingleton (groupHomology (Rep.trivial k (Multiplicative (Localization.Away m)) k)
        (n + 1)) := by
    refine ModuleCat.subsingleton_of_isZero ?_
    rcases n with _ | n
    · exact isZero_groupHomology_one_localizationAway k hmk
    · exact isZero_groupHomology_localizationAway k hm (by omega)
  have hfree : ∀ n, Subsingleton (groupHomology
      (Rep.trivial k (Multiplicative (Fin r → Localization.Away m)) k) (n + 1)) :=
    Module.pi_induction' (ι := Fin r) (Localization.Away m)
      (fun N _ _ ↦ ∀ n, Subsingleton (groupHomology (Rep.trivial k (Multiplicative N) k) (n + 1)))
      (fun N _ _ ↦ ∀ n, Subsingleton (groupHomology (Rep.trivial k (Multiplicative N) k) (n + 1)))
      (fun e h n ↦ have := h n; subsingleton_groupHomology_of_addEquiv k e.symm.toAddEquiv)
      (fun e h n ↦ have := h n; subsingleton_groupHomology_of_addEquiv k e.symm.toAddEquiv)
      (fun n ↦ ModuleCat.subsingleton_of_isZero (isZero_groupHomology_succ_of_subsingleton _ n))
      (fun hN hN' n ↦ subsingleton_groupHomology_multiplicative_prod k hN hN' n)
      (fun _ ↦ Localization.Away m) (fun _ ↦ hR)
  have : Finite T :=
    finite_of_moduleFinite_localizationAway (m := m) fun x ↦
      isOfFinAddOrder_of_smul_eq_zero hq (hqT x)
  have htors (n : ℕ) :
      Subsingleton (groupHomology (Rep.trivial k (Multiplicative T) k) (n + 1)) := by
    refine groupHomology.subsingleton_of_isUnit_natCard _ ?_ n
    rw [Nat.card_congr Multiplicative.toAdd]
    exact isUnit_natCard_of_localizationAway hmk
  have := subsingleton_groupHomology_multiplicative_prod k hfree htors n
  exact subsingleton_groupHomology_of_addEquiv k φ

/-- The homology of a finitely generated `ℤ[1/m]`-module vanishes in positive degrees: by the
structure theorem over the principal ideal domain `ℤ[1/m]` it is a free module `ℤ[1/m]ʳ` times a
torsion module killed by a nonzero element. -/
private theorem subsingleton_groupHomology_of_moduleFinite_localizationAway (hm : m ≠ 0)
    (hmk : (m : k) = 0) (N : Type) [AddCommGroup N] [Module (Localization.Away m) N]
    [Module.Finite (Localization.Away m) N] (n : ℕ) :
    Subsingleton (groupHomology (Rep.trivial k (Multiplicative N) k) (n + 1)) := by
  have : IsDomain (Localization.Away m) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hm)
  -- `N ≅ ℤ[1/m]ʳ × ⨁ᵢ ℤ[1/m] ⧸ (pᵢ ^ eᵢ)`, and the second factor is killed by `∏ᵢ pᵢ ^ eᵢ`
  obtain ⟨r, ι, _, p, hp, e, ⟨φ⟩⟩ := Module.equiv_free_prod_directSum (Localization.Away m) N
  have hq : ∏ i, p i ^ e i ≠ 0 := Finset.prod_ne_zero_iff.2 fun i _ ↦ pow_ne_zero _ (hp i).ne_zero
  refine subsingleton_groupHomology_of_addEquiv_pi_prod k hm hmk hq (fun x ↦ ?_)
    (φ.trans (LinearEquiv.prodCongr
      (Finsupp.linearEquivFunOnFinite (Localization.Away m) (Localization.Away m) (Fin r))
      (LinearEquiv.refl _ _))).toAddEquiv n
  refine DirectSum.ext fun i ↦ ?_
  obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem (fun i ↦ p i ^ e i) (Finset.mem_univ i)
  have hi : Module.IsTorsionBy (Localization.Away m)
      (Localization.Away m ⧸ Localization.Away m ∙ p i ^ e i) (p i ^ e i) :=
    (Module.isTorsionBy_quotient_iff _ _).2 fun y ↦
      Submodule.mem_span_singleton.2 ⟨y, by rw [smul_eq_mul, smul_eq_mul, mul_comm]⟩
  rw [DirectSum.smul_apply, DirectSum.zero_apply, hc, mul_comm, mul_smul, hi, smul_zero]

/-- The homology of a `ℤ[1/m]`-module vanishes in positive degrees, as it does for each of its
finitely generated submodules. -/
private theorem subsingleton_groupHomology_of_localizationAway (hm : m ≠ 0) (hmk : (m : k) = 0)
    (A : Type) [AddCommGroup A] [Module (Localization.Away m) A] (n : ℕ) :
    Subsingleton (groupHomology (Rep.trivial k (Multiplicative A) k) (n + 1)) :=
  subsingleton_groupHomology_of_forall_span (R := Localization.Away m) k fun _ ↦
    subsingleton_groupHomology_of_moduleFinite_localizationAway k hm hmk _ n

/-- **Abelian groups on which multiplication by `m` is bijective are acyclic modulo `m`.** Let
`k` be a commutative semisimple ring in which the integer `m` vanishes. If multiplication by `m` is
a bijection of the abelian group `A`, then the group homology of `A` with trivial coefficients `k`
vanishes in every positive degree. -/
theorem subsingleton_groupHomology_of_bijective_zsmul (hmk : (m : k) = 0) {A : Type}
    [AddCommGroup A] (hA : Function.Bijective fun x : A ↦ m • x) (n : ℕ) :
    Subsingleton (groupHomology (Rep.trivial k (Multiplicative A) k) (n + 1)) := by
  rcases eq_or_ne m 0 with rfl | hm
  · -- multiplication by zero is injective only on the trivial group
    have : Subsingleton (Multiplicative A) :=
      ⟨fun x y ↦ Multiplicative.toAdd.injective <| hA.1 <| by simp⟩
    exact ModuleCat.subsingleton_of_isZero (isZero_groupHomology_succ_of_subsingleton _ n)
  let _ : Module (Localization.Away m) A := hA.localizationAwayModule
  exact subsingleton_groupHomology_of_localizationAway k hm hmk A n

/-- **The classifying space of a uniquely `m`-divisible abelian group.** If multiplication by `m`
is a bijection of the abelian group `A`, then the Eilenberg--MacLane space
`K(A, 1) = B(Multiplicative A)` has no homology in positive degrees with coefficients in a
commutative semisimple ring `k` in which `m = 0`. -/
theorem subsingleton_classifyingSpace_singularHomology_of_bijective_zsmul (hmk : (m : k) = 0)
    {A : Type} [AddCommGroup A] (hA : Function.Bijective fun x : A ↦ m • x) (n : ℕ) :
    Subsingleton (((singularChains k).obj
      (TopCat.of (classifyingSpace (Multiplicative A)))).homology (n + 1)) :=
  have := subsingleton_groupHomology_of_bijective_zsmul k hmk hA n
  (classifyingSpaceSingularHomologyIsoGroupHomology k _ (n + 1)).toLinearEquiv.toEquiv.subsingleton

/-- **Mod-two acyclicity of `K(A, 1)`.** For a uniquely two-divisible abelian group `A`, the
Eilenberg--MacLane space `K(A, 1) = B(Multiplicative A)` has the mod-two homology of a point:
`H̃_*(K(A, 1); 𝔽₂) = 0`. -/
theorem IsUniquelyTwoDivisible.subsingleton_classifyingSpace_singularHomology {A : Type}
    [AddCommGroup A] (hA : IsUniquelyTwoDivisible A) (n : ℕ) :
    Subsingleton (((singularChains (ZMod 2)).obj
      (TopCat.of (classifyingSpace (Multiplicative A)))).homology (n + 1)) :=
  subsingleton_classifyingSpace_singularHomology_of_bijective_zsmul (ZMod 2) (m := 2)
    (by decide) ((isUniquelyTwoDivisible_iff A).1 hA) n

end Homology

end TauCeti
