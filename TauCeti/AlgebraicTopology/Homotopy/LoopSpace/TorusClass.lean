module

public import TauCeti.AlgebraicTopology.Homotopy.Hurewicz.Spherical
public import TauCeti.AlgebraicTopology.Homotopy.LoopSpace.FreeLoop
public import TauCeti.AlgebraicTopology.Singular.Cubical.CrossProduct.Chains

/-!
# Torus classes of loops of free loops

A loop `Λ` in the free loop space `𝓛Q = C(S¹, Q)` sweeps out a torus `(s, t) ↦ Λ t (exp (2πis))` in
`Q`. This file defines the class of that torus in the second homology of `Q` and computes the
classes obtained from loops at a constant loop.

On normalized cubical chains, crossing with the standard loop of the circle (`TauCeti.circleCube`)
and pushing forward along evaluation `S¹ × 𝓛Q → Q` (`TauCeti.freeLoopEval`) is a chain map up to
sign (`TauCeti.boundary_freeLoopTorusChain`), since the standard loop is a cycle. It induces the
**torus map** `H^□ₖ(𝓛Q; R) → H^□ₖ₊₁(Q; R)`, `a ↦ ev_* ([S¹] × a)` (`TauCeti.freeLoopTorusHomology`).
After the cubical Hurewicz map of `𝓛Q` it gives the **torus class** `π₁(𝓛Q, γ) → H^□₂(Q; R)` of
loops of free loops (`TauCeti.cubicalFreeLoopTorusClassHom`), which sends the class of `Λ` to the
class of the cube swept out by `Λ` (`TauCeti.cubicalFreeLoopTorusClassHom_mk`).

At the constant loop at `x`, the fundamental group of `𝓛Q` is generated by loops of based loops and
loops of constant loops (`TauCeti.range_freeLoopHomotopyGroupHom`). The torus of a loop of based
loops is a generalized loop of `Q` at `x` (`GenLoop.freeLoopTorus`), and its class is the Hurewicz
class of that element of `π₂(Q, x)` (`TauCeti.cubicalFreeLoopTorusClassHom_eq_cubicalHurewicz`); the
torus of a loop of constant loops is degenerate, so its class vanishes
(`TauCeti.cubicalFreeLoopTorusClassHom_eq_zero_of_forall_const`). Hence the torus classes at a
constant loop are exactly the Hurewicz classes of `π₂(Q, x)`
(`TauCeti.range_cubicalFreeLoopTorusClassHom_const`), and the same holds in singular homology
(`TauCeti.range_freeLoopTorusClassHom_const`): the torus classes are spherical
(`TauCeti.freeLoopTorusClassHom_const_mem_sphericalClasses`).

This is the transgression from loops of contractible free loops to spherical classes through which
the period and first Chern number of capped loops are read in Floer theory.

## Main definitions

* `TauCeti.freeLoopTorusHomology`: the torus map `H^□ₖ(𝓛Q; R) ⟶ H^□ₖ₊₁(Q; R)`.
* `TauCeti.cubicalFreeLoopTorusClassHom`: the torus class `π₁(𝓛Q, γ) → H^□₂(Q; R)`.
* `TauCeti.freeLoopTorusClassHom`: the torus class `π₁(𝓛Q, γ) → H₂(Q; ℤ)` in singular homology.

## Main results

* `TauCeti.range_cubicalFreeLoopTorusClassHom_const`, `TauCeti.range_freeLoopTorusClassHom_const`:
  at the constant loop at `x`, the torus classes are the Hurewicz classes of `π₂(Q, x)`.
* `TauCeti.freeLoopTorusClassHom_const_mem_sphericalClasses`: the torus classes are spherical.

## References

* J.-F. Barraud, M. Damian, V. Humilière, A. Oancea, *Floer homology with DG coefficients.
  Applications to cotangent bundles*, arXiv:2404.07953, §3.
* W. S. Massey, *Singular Homology Theory*, GTM 70, Springer, 1980, Chapters II and VII, for the
  cross product of cubical chains.
-/

public section

noncomputable section

open AlgebraicTopology CategoryTheory HomotopyGroup TauCeti
open scoped unitInterval Topology Topology.Homotopy

universe u

namespace TauCeti

/-! ### The torus chain map -/

section Chains

variable {Q : Type u} [TopologicalSpace Q]

/-- The standard loop `t ↦ exp (2πit)` of the circle as a singular `1`-cube. -/
def circleCube : SingularCube Circle 1 :=
  unitToCircle.comp ⟨fun z ↦ z 0, by fun_prop⟩

@[simp]
theorem circleCube_apply (z : Fin 1 → I) : circleCube z = unitToCircle (z 0) :=
  (rfl)

variable (R : Type*) [CommRing R]

/-- The standard loop of the circle is a cycle of the normalized cubical chains. -/
theorem boundary_ofCube_circleCube :
    NormalizedCubicalChain.boundary Circle R 0 (NormalizedCubicalChain.ofCube Circle R circleCube) =
      0 := by
  rw [NormalizedCubicalChain.boundary_ofCube, Fin.sum_univ_one]
  have h : SingularCube.face 0 0 circleCube = SingularCube.face 0 1 circleCube := by
    ext z
    simp [unitToCircle_zero, unitToCircle_one]
  rw [h, sub_self, smul_zero]

variable (Q) in
/-- Evaluation `S¹ × 𝓛Q → Q`, `(z, γ) ↦ γ z`, of free loops. -/
def freeLoopEval : C(Circle × C(Circle, Q), Q) :=
  (ContinuousMap.id C(Circle, Q)).uncurry.comp ContinuousMap.prodSwap

@[simp]
theorem freeLoopEval_apply (z : Circle) (γ : C(Circle, Q)) : freeLoopEval Q (z, γ) = γ z :=
  (rfl)

variable (Q) in
/-- The **torus chain map** on normalized cubical chains: a chain `a` of the free loop space goes to
the push-forward along evaluation of the cross product of the standard loop of the circle with `a`,
`a ↦ ev_♯ ([S¹] × a)`. -/
def freeLoopTorusChain (k : ℕ) :
    NormalizedCubicalChain C(Circle, Q) R k →ₗ[R] NormalizedCubicalChain Q R (k + 1) :=
  NormalizedCubicalChain.cast R (Nat.add_comm 1 k) ∘ₗ
    NormalizedCubicalChain.map R (freeLoopEval Q) (1 + k) ∘ₗ
      NormalizedCubicalChain.crossProduct Circle C(Circle, Q) R 1 k
        (NormalizedCubicalChain.ofCube Circle R circleCube)

theorem freeLoopTorusChain_apply (k : ℕ) (a : NormalizedCubicalChain C(Circle, Q) R k) :
    freeLoopTorusChain Q R k a = NormalizedCubicalChain.cast R (Nat.add_comm 1 k)
      (NormalizedCubicalChain.map R (freeLoopEval Q) (1 + k)
        (NormalizedCubicalChain.crossProduct Circle C(Circle, Q) R 1 k
          (NormalizedCubicalChain.ofCube Circle R circleCube) a)) :=
  (rfl)

/-- The torus chain of a cube `c` of free loops is the class of the cube
`(s, x) ↦ c x (exp (2πis))`. -/
theorem freeLoopTorusChain_ofCube (k : ℕ) (c : SingularCube C(Circle, Q) k) :
    freeLoopTorusChain Q R k (NormalizedCubicalChain.ofCube _ R c) =
      NormalizedCubicalChain.ofCube Q R (SingularCube.cast (Nat.add_comm 1 k)
        ((freeLoopEval Q).comp (SingularCube.crossProduct circleCube c))) := by
  rw [freeLoopTorusChain_apply, NormalizedCubicalChain.crossProduct_ofCube,
    NormalizedCubicalChain.map_ofCube, NormalizedCubicalChain.cast_ofCube]

/-- The torus chain of a `0`-chain is a cycle. -/
theorem boundary_freeLoopTorusChain_zero (a : NormalizedCubicalChain C(Circle, Q) R 0) :
    NormalizedCubicalChain.boundary Q R 0 (freeLoopTorusChain Q R 0 a) = 0 := by
  rw [freeLoopTorusChain_apply, NormalizedCubicalChain.cast_rfl,
    ← LinearMap.comp_apply (NormalizedCubicalChain.boundary Q R 0),
    ← NormalizedCubicalChain.map_boundary, LinearMap.comp_apply,
    NormalizedCubicalChain.boundary_crossProduct_zero_right, boundary_ofCube_circleCube]
  simp

/-- The cross product with the standard loop of the circle anticommutes with the boundary, since the
standard loop is a cycle. -/
theorem boundary_crossProduct_circleCube {Y : Type*} [TopologicalSpace Y] (k : ℕ)
    (b : NormalizedCubicalChain Y R (k + 1)) :
    NormalizedCubicalChain.boundary (Circle × Y) R (1 + k)
        (NormalizedCubicalChain.crossProduct Circle Y R 1 (k + 1)
          (NormalizedCubicalChain.ofCube Circle R circleCube) b) =
      -NormalizedCubicalChain.crossProduct Circle Y R 1 k
          (NormalizedCubicalChain.ofCube Circle R circleCube)
          (NormalizedCubicalChain.boundary Y R k b) := by
  have hL := NormalizedCubicalChain.boundary_crossProduct (p := 0) (q := k) (R := R)
    (NormalizedCubicalChain.ofCube Circle R circleCube) b
  rw [boundary_ofCube_circleCube, map_zero, LinearMap.zero_apply] at hL
  have h : 1 + k = 0 + k + 1 := by omega
  apply NormalizedCubicalChain.cast_injective R h
  rw [← NormalizedCubicalChain.boundary_cast]
  convert hL using 1
  simp

/-- **The torus chain map anticommutes with the boundary**:
`∂ (ev_♯ ([S¹] × b)) = - ev_♯ ([S¹] × ∂ b)`, since the standard loop is a cycle. -/
theorem boundary_freeLoopTorusChain (k : ℕ) (b : NormalizedCubicalChain C(Circle, Q) R (k + 1)) :
    NormalizedCubicalChain.boundary Q R (k + 1) (freeLoopTorusChain Q R (k + 1) b) =
      -freeLoopTorusChain Q R k (NormalizedCubicalChain.boundary _ R k b) := by
  have e : freeLoopTorusChain Q R (k + 1) b = NormalizedCubicalChain.cast R
      (congrArg Nat.succ (Nat.add_comm 1 k)) (NormalizedCubicalChain.map R (freeLoopEval Q)
        (1 + k + 1) (NormalizedCubicalChain.crossProduct Circle C(Circle, Q) R 1 (k + 1)
          (NormalizedCubicalChain.ofCube Circle R circleCube) b)) := rfl
  rw [e, NormalizedCubicalChain.boundary_cast, ← LinearMap.comp_apply
    (NormalizedCubicalChain.boundary Q R (1 + k)), ← NormalizedCubicalChain.map_boundary,
    LinearMap.comp_apply, boundary_crossProduct_circleCube, map_neg, map_neg,
    freeLoopTorusChain_apply]

end Chains

/-! ### The torus map on homology -/

section Homology

variable {Q : Type u} [TopologicalSpace Q] (R : Type u) [CommRing R]

/-- The differential of the normalized cubical chain complex of a space is the cubical
boundary. -/
private theorem d_apply (X : Type u) [TopologicalSpace X] (n : ℕ)
    (g : NormalizedCubicalChain X R (n + 1)) :
    ((normalizedCubicalChainComplex R).obj (TopCat.of X)).d (n + 1) n g =
      NormalizedCubicalChain.boundary X R n g :=
  normalizedCubicalChainComplex_obj_d_apply (R := R) (TopCat.of X) n g

/-- The torus chain of a cycle of the free loop space is a cycle. -/
private theorem boundary_freeLoopTorusChain_iCycles (k : ℕ)
    (z : ((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).cycles k) :
    ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).d (k + 1) k
      (freeLoopTorusChain Q R k (normalizedCubicalChainComplexXEquiv _ k
        (((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).iCycles k z))) = 0 := by
  rw [d_apply]
  cases k with
  | zero => exact boundary_freeLoopTorusChain_zero R _
  | succ j =>
    have hz := normalizedCubicalChainComplexXEquiv_d_apply (R := R) (TopCat.of C(Circle, Q)) j
      (((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).iCycles (j + 1) z)
    rw [HomologicalComplex.moduleCat_d_iCycles_apply, map_zero] at hz
    rw [boundary_freeLoopTorusChain, ← hz, map_zero, neg_zero]
    -- The two zeros differ only by reading the chains of `Q` as a term of its chain complex.
    rfl

variable (Q) in
/-- The torus chain map on cycles, from degree `k` of the free loop space to degree `k + 1` of
`Q`. -/
def freeLoopTorusCycles (k : ℕ) :
    ((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).cycles k ⟶
      ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).cycles (k + 1) :=
  ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).liftCycles
    (((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).iCycles k ≫
      ModuleCat.ofHom ((normalizedCubicalChainComplexXEquiv _ (k + 1)).symm.toLinearMap ∘ₗ
        freeLoopTorusChain Q R k ∘ₗ (normalizedCubicalChainComplexXEquiv _ k).toLinearMap)) k
    (by simp)
    (by ext z; exact boundary_freeLoopTorusChain_iCycles R k z)

/-- The cycle `freeLoopTorusCycles Q R k z` is the torus chain of the cycle `z`. -/
@[simp]
theorem iCycles_freeLoopTorusCycles_apply (k : ℕ)
    (z : ((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).cycles k) :
    ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).iCycles (k + 1)
        (freeLoopTorusCycles Q R k z) =
      (normalizedCubicalChainComplexXEquiv _ (k + 1)).symm
        (freeLoopTorusChain Q R k (normalizedCubicalChainComplexXEquiv _ k
          (((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).iCycles k z))) := by
  rw [freeLoopTorusCycles, ← ModuleCat.comp_apply, HomologicalComplex.liftCycles_i]
  -- The lifted morphism is the composite of `iCycles` with the torus chain map, by definition.
  rfl

/-- The torus chain of a boundary has zero homology class. -/
private theorem toCycles_freeLoopTorusCycles_homologyπ (k : ℕ) :
    ((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).toCycles (k + 1) k ≫
      freeLoopTorusCycles Q R k ≫
        ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).homologyπ (k + 1) = 0 := by
  ext y
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp, LinearMap.comp_apply, LinearMap.comp_apply,
    ModuleCat.hom_zero, LinearMap.zero_apply, ← map_zero
      (((normalizedCubicalChainComplex R).obj (TopCat.of Q)).homologyπ (k + 1)).hom]
  refine HomologicalComplex.moduleCat_homologyπ_eq_of_iCycles_sub_eq_d _ (m := k + 2)
    (-freeLoopTorusChain Q R (k + 1) (normalizedCubicalChainComplexXEquiv _ (k + 1) y)) ?_
  rw [map_zero, sub_zero, iCycles_freeLoopTorusCycles_apply,
    HomologicalComplex.moduleCat_iCycles_toCycles_apply,
    normalizedCubicalChainComplexXEquiv_d_apply,
    d_apply, map_neg, boundary_freeLoopTorusChain, neg_neg]
  -- `normalizedCubicalChainComplexXEquiv` is the identity of the underlying chains.
  rfl

variable (Q) in
/-- **The torus map** `H^□ₖ(𝓛Q; R) ⟶ H^□ₖ₊₁(Q; R)` on normalized cubical homology: a class `a` of
the free loop space `𝓛Q = C(S¹, Q)` goes to `ev_* ([S¹] × a)`, the push-forward along evaluation
`S¹ × 𝓛Q → Q` of its cross product with the class of the standard loop of the circle. A loop of
free loops is a torus in `Q`, and this map sends its class to the class of the torus. -/
def freeLoopTorusHomology (k : ℕ) :
    ((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).homology k ⟶
      ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).homology (k + 1) :=
  (Limits.CokernelCofork.IsColimit.desc' (((normalizedCubicalChainComplex R).obj
    (TopCat.of C(Circle, Q))).homologyIsCokernel (k + 1) k (by simp)) _
    (toCycles_freeLoopTorusCycles_homologyπ R k)).1

/-- The torus map sends the class of a cycle `z` to the class of its torus chain
`ev_♯ ([S¹] × z)`. -/
@[simp]
theorem freeLoopTorusHomology_homologyπ (k : ℕ)
    (z : ((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).cycles k) :
    freeLoopTorusHomology Q R k
        (((normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))).homologyπ k z) =
      ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).homologyπ (k + 1)
        (freeLoopTorusCycles Q R k z) :=
  ConcreteCategory.congr_hom (Limits.CokernelCofork.IsColimit.desc' _ _
    (toCycles_freeLoopTorusCycles_homologyπ R k)).2 z

end Homology

/-! ### Torus classes of loops of free loops -/

section FundamentalGroup

variable {Q : Type u} [TopologicalSpace Q] (R : Type u) [CommRing R]

/-- The **torus** `(s, t) ↦ Λ t (exp (2πis))` swept out by a family `Λ` of free loops
parametrized by the interval, as a singular `2`-cube of `Q`. -/
def freeLoopTorusCube (Λ : SingularCube C(Circle, Q) 1) : SingularCube Q 2 :=
  SingularCube.cast (Nat.add_comm 1 1)
    ((freeLoopEval Q).comp (SingularCube.crossProduct circleCube Λ))

@[simp]
theorem freeLoopTorusCube_apply (Λ : SingularCube C(Circle, Q) 1) (z : Fin 2 → I) :
    freeLoopTorusCube Λ z = Λ (fun _ ↦ z 1) (unitToCircle (z 0)) := by
  simp only [freeLoopTorusCube, SingularCube.cast_apply, ContinuousMap.comp_apply,
    SingularCube.crossProduct_apply, freeLoopEval_apply, circleCube_apply]
  congr 2
  funext j
  rw [Subsingleton.elim j 0]
  -- The coordinate `Fin.natAdd 1 0` of the cross product is `1`.
  rfl

variable (Q) in
/-- **The torus class of a loop of free loops**: the homomorphism `π₁(𝓛Q, γ) → H^□₂(Q; R)` sending
a loop `Λ` of free loops at `γ` to the class of the torus `(s, t) ↦ Λ t (exp (2πis))` it sweeps
out. It is the torus map `TauCeti.freeLoopTorusHomology` after the cubical Hurewicz map of `𝓛Q`. -/
def cubicalFreeLoopTorusClassHom (γ : C(Circle, Q)) :
    Additive (HomotopyGroup (Fin 1) C(Circle, Q) γ) →+
      ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).homology 2 :=
  (freeLoopTorusHomology Q R 1).hom.toAddMonoidHom.comp (HomotopyGroup.cubicalHurewiczHom R 0)

/-- The torus class of a loop of free loops is the class of any cycle whose underlying chain is the
torus the loop sweeps out. -/
theorem cubicalFreeLoopTorusClassHom_mk {γ : C(Circle, Q)} (Λ : Ω^ (Fin 1) C(Circle, Q) γ)
    {z : ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).cycles 2}
    (hz : ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).iCycles 2 z =
      NormalizedCubicalChain.ofCube Q R (freeLoopTorusCube (Λ : SingularCube C(Circle, Q) 1))) :
    cubicalFreeLoopTorusClassHom Q R γ
        (Additive.ofMul (⟦Λ⟧ : HomotopyGroup (Fin 1) C(Circle, Q) γ)) =
      ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).homologyπ 2 z := by
  let K := (normalizedCubicalChainComplex R).obj (TopCat.of C(Circle, Q))
  let w := K.moduleCatCyclesMk (NormalizedCubicalChain.ofCube _ R (Λ : SingularCube _ 1)) 0
    (by simp) (by rw [d_apply]; exact GenLoop.boundary_ofCube_eq_zero R Λ)
  have hw : K.iCycles 1 w = NormalizedCubicalChain.ofCube _ R (Λ : SingularCube _ 1) :=
    HomologicalComplex.iCycles_moduleCatCyclesMk ..
  -- By definition, the torus class is the torus map applied to the cubical Hurewicz class.
  calc cubicalFreeLoopTorusClassHom Q R γ (Additive.ofMul ⟦Λ⟧)
      = freeLoopTorusHomology Q R 1 (GenLoop.cubicalHurewicz R Λ) :=
        congrArg (freeLoopTorusHomology Q R 1) ((HomotopyGroup.cubicalHurewiczHom_apply R 0 _).trans
          (HomotopyGroup.cubicalHurewicz_mk R 0 Λ))
    _ = freeLoopTorusHomology Q R 1 (K.homologyπ 1 w) := by
      rw [GenLoop.homologyπ_eq_cubicalHurewicz R Λ hw]
    _ = _ := by
      rw [freeLoopTorusHomology_homologyπ]
      congr 1
      refine HomologicalComplex.moduleCat_iCycles_injective _ _ ?_
      rw [iCycles_freeLoopTorusCycles_apply, hz, hw]
      exact freeLoopTorusChain_ofCube R 1 _

/-- The torus swept out by a loop of free loops at the constant loop at `x`, all of whose loops
start at `x`, is a generalized loop of `Q` at `x`: its boundary is sent to `x`. -/
def _root_.GenLoop.freeLoopTorus {x : Q}
    (Λ : Ω^ (Fin 1) C(Circle, Q) (ContinuousMap.const Circle x))
    (hΛ : ∀ t, Λ t 1 = x) : Ω^ (Fin 2) Q x :=
  ⟨freeLoopTorusCube (Λ : SingularCube C(Circle, Q) 1), by
    rintro z ⟨i, hi⟩
    rw [freeLoopTorusCube_apply]
    fin_cases i
    · rcases hi with hi | hi <;>
        simp only [Fin.zero_eta, Fin.isValue] at hi <;> rw [hi] <;>
          simp [unitToCircle_zero, unitToCircle_one, hΛ]
    · have hb : (fun _ : Fin 1 ↦ z 1) ∈ Cube.boundary (Fin 1) := ⟨0, by simpa using hi⟩
      simp [GenLoop.boundary Λ _ hb]⟩

@[simp]
theorem _root_.GenLoop.freeLoopTorus_apply {x : Q}
    (Λ : Ω^ (Fin 1) C(Circle, Q) (ContinuousMap.const Circle x))
    (hΛ : ∀ t, Λ t 1 = x) (z : Fin 2 → I) :
    GenLoop.freeLoopTorus Λ hΛ z = Λ (fun _ ↦ z 1) (unitToCircle (z 0)) :=
  freeLoopTorusCube_apply _ z

/-- **The torus class of a loop of based loops is a Hurewicz class**: for a loop `Λ` of free
loops at the constant loop at `x` whose loops all start at `x`, the torus class of `Λ` is the
cubical Hurewicz class of the torus it sweeps out, read as an element of `π₂(Q, x)`. -/
theorem cubicalFreeLoopTorusClassHom_eq_cubicalHurewicz {x : Q}
    (Λ : Ω^ (Fin 1) C(Circle, Q) (ContinuousMap.const Circle x)) (hΛ : ∀ t, Λ t 1 = x) :
    cubicalFreeLoopTorusClassHom Q R _
        (Additive.ofMul (⟦Λ⟧ : HomotopyGroup (Fin 1) C(Circle, Q) _)) =
      GenLoop.cubicalHurewicz R (GenLoop.freeLoopTorus Λ hΛ) := by
  let z := ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).moduleCatCyclesMk
    (NormalizedCubicalChain.ofCube Q R (freeLoopTorusCube (Λ : SingularCube C(Circle, Q) 1))) 1
    (by simp)
    (by rw [d_apply]; exact GenLoop.boundary_ofCube_eq_zero R (GenLoop.freeLoopTorus Λ hΛ))
  have hz : ((normalizedCubicalChainComplex R).obj (TopCat.of Q)).iCycles 2 z =
      NormalizedCubicalChain.ofCube Q R (freeLoopTorusCube (Λ : SingularCube C(Circle, Q) 1)) :=
    HomologicalComplex.iCycles_moduleCatCyclesMk ..
  rw [cubicalFreeLoopTorusClassHom_mk R Λ hz]
  exact GenLoop.homologyπ_eq_cubicalHurewicz R (GenLoop.freeLoopTorus Λ hΛ) hz

/-- **The torus class of a loop of constant loops vanishes**: the torus swept out by a loop of
constant loops does not depend on the circle coordinate, so it is degenerate. -/
theorem cubicalFreeLoopTorusClassHom_eq_zero_of_forall_const {γ : C(Circle, Q)}
    (Λ : Ω^ (Fin 1) C(Circle, Q) γ) (hΛ : ∀ t z, Λ t z = Λ t 1) :
    cubicalFreeLoopTorusClassHom Q R γ
        (Additive.ofMul (⟦Λ⟧ : HomotopyGroup (Fin 1) C(Circle, Q) γ)) =
      0 := by
  have hdeg : SingularCube.IsDegenerate (freeLoopTorusCube (Λ : SingularCube C(Circle, Q) 1)) :=
    SingularCube.isDegenerate_iff.2 ⟨0, SingularCube.isDegenerateAt_iff.2 fun z t ↦ by simp [hΛ]⟩
  -- The zero cycle has underlying chain the class of the degenerate torus; the two zeros differ
  -- only by reading the chains of `Q` as a term of its chain complex.
  rw [cubicalFreeLoopTorusClassHom_mk R Λ (z := 0)
    (by rw [map_zero, NormalizedCubicalChain.ofCube_eq_zero R hdeg]; rfl), map_zero]

/-- Every generalized loop `p` of `Q` at `x` is the torus swept out by a loop of based loops: the
loop `t ↦ (s ↦ p (s, t))` of loops at `x`, read as circle maps. -/
private theorem exists_freeLoopTorus_eq {x : Q} (p : Ω^ (Fin 2) Q x) :
    ∃ (Λ : Ω^ (Fin 1) C(Circle, Q) (ContinuousMap.const Circle x)) (hΛ : ∀ t, Λ t 1 = x),
      GenLoop.freeLoopTorus Λ hΛ = p := by
  have hφ : Continuous fun q : I × I ↦ (![q.2, q.1] : Fin 2 → I) :=
    continuous_pi fun i ↦ by
      fin_cases i <;>
        simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue, Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.cons_val_fin_one] <;> fun_prop
  -- `P t` is the closed path `s ↦ p (s, t)`.
  let P : C(I, C(I, Q)) := ContinuousMap.curry (p.1.comp ⟨_, hφ⟩)
  have hP (t s : I) : P t s = p ![s, t] := rfl
  have hb (t : I) {s : I} (hs : s = 0 ∨ s = 1) : P t s = x :=
    GenLoop.boundary p _ ⟨0, by simpa using hs⟩
  have hP0 (t : I) : P t 0 = P t 1 := (hb t (.inl rfl)).trans (hb t (.inr rfl)).symm
  let Λ : C(Fin 1 → I, C(Circle, Q)) :=
    ⟨fun t ↦ circleMapHomeomorphClosedUnitPath.symm ⟨P (t 0), hP0 (t 0)⟩,
      circleMapHomeomorphClosedUnitPath.symm.continuous.comp
        ((P.continuous.comp (continuous_apply 0)).subtype_mk _)⟩
  have hΛ (t : Fin 1 → I) (s : I) : Λ t (unitToCircle s) = p ![s, t 0] :=
    (circleMapHomeomorphClosedUnitPath_symm_unitToCircle _ s).trans (hP _ s)
  have hconst (t : Fin 1 → I) (ht : t 0 = 0 ∨ t 0 = 1) : Λ t = ContinuousMap.const Circle x := by
    ext z
    obtain ⟨s, rfl⟩ := unitToCircle_surjective z
    rw [hΛ, ContinuousMap.const_apply]
    exact GenLoop.boundary p _ ⟨1, by simpa using ht⟩
  refine ⟨⟨Λ, fun t ⟨i, hi⟩ ↦ by rw [Subsingleton.elim i 0] at hi; exact hconst t hi⟩,
    fun t ↦ ?_, ?_⟩
  · rw [← unitToCircle_zero]
    exact (hΛ t 0).trans (GenLoop.boundary p _ ⟨0, by simp⟩)
  · ext z
    rw [GenLoop.freeLoopTorus_apply]
    refine (hΛ _ _).trans (congrArg p ?_)
    funext i
    fin_cases i <;> rfl

/-- The torus class of a loop of based loops at `x` is a cubical Hurewicz class of `π₂(Q, x)`. -/
private theorem cubicalFreeLoopTorusClassHom_map_val_mem_range {x : Q}
    (β : Ω^ (Fin 1) (BasedMap Circle Q 1 x) ⟨ContinuousMap.const Circle x, rfl⟩) :
    cubicalFreeLoopTorusClassHom Q R (ContinuousMap.const Circle x) (Additive.ofMul
      (HomotopyGroup.map ⟨Subtype.val, continuous_subtype_val⟩ rfl ⟦β⟧)) ∈
      (HomotopyGroup.cubicalHurewiczHom R 1 : Additive (HomotopyGroup (Fin 2) Q x) →+ _).range := by
  rw [HomotopyGroup.map_mk, cubicalFreeLoopTorusClassHom_eq_cubicalHurewicz R _ fun t ↦ by
    rw [GenLoop.map_apply]; exact (β t).2]
  exact ⟨_, (HomotopyGroup.cubicalHurewiczHom_apply R 1 _).trans
    (HomotopyGroup.cubicalHurewicz_mk R 1 _)⟩

/-- The torus class of a loop of constant loops vanishes. -/
private theorem cubicalFreeLoopTorusClassHom_map_const' {x : Q}
    (hc : (ContinuousMap.const' : C(Q, C(Circle, Q))) x = ContinuousMap.const Circle x)
    (h : HomotopyGroup (Fin 1) Q x) :
    cubicalFreeLoopTorusClassHom Q R (ContinuousMap.const Circle x)
      (Additive.ofMul (HomotopyGroup.map ContinuousMap.const' hc h)) = 0 :=
  Quotient.inductionOn h fun η ↦ by
    rw [HomotopyGroup.map_mk]
    -- Every loop of the family is constant.
    exact cubicalFreeLoopTorusClassHom_eq_zero_of_forall_const R _ fun t z ↦ by
      rw [GenLoop.map_apply]; rfl

/-- **The torus classes at a constant loop are the cubical Hurewicz classes of `π₂`.** At the
constant loop at `x`, the image of the torus class `π₁(𝓛Q, x) → H^□₂(Q; R)` is the image of the
cubical Hurewicz map `π₂(Q, x) → H^□₂(Q; R)`. -/
theorem range_cubicalFreeLoopTorusClassHom_const (x : Q) :
    (cubicalFreeLoopTorusClassHom Q R (ContinuousMap.const Circle x)).range =
      (HomotopyGroup.cubicalHurewiczHom R 1 : Additive (HomotopyGroup (Fin 2) Q x) →+ _).range := by
  -- Every loop of free loops at the constant loop is a loop of based loops followed by a loop of
  -- constant loops. The torus of the first is a generalized loop of `Q` at `x`, and every such
  -- generalized loop arises this way; the torus of the second is degenerate.
  refine le_antisymm ?_ ?_
  · rintro _ ⟨a, rfl⟩
    -- Split `a` into a loop of based loops and the loop `s` of constant loops over its
    -- evaluation `h`.
    have hc : (ContinuousMap.const' : C(Q, C(Circle, Q))) x = ContinuousMap.const Circle x := rfl
    set h := HomotopyGroup.mapHom (N := Fin 1) (mappingSpaceEval (B := Circle) (X := Q) 1)
      (leftInverse_mappingSpaceEval_const 1 x) a.toMul with hh
    set s := HomotopyGroup.map ContinuousMap.const' hc h with hs
    have hes : HomotopyGroup.mapHom (mappingSpaceEval (B := Circle) (X := Q) 1)
        (leftInverse_mappingSpaceEval_const 1 x) s = h := by
      rw [HomotopyGroup.mapHom_apply]
      exact HomotopyGroup.map_map_of_comp_eq_id _ _ hc _ (mappingSpaceEval_comp_const' 1) _
    have hker : a.toMul * s⁻¹ ∈ (freeLoopHomotopyGroupHom x 0).range := by
      rw [range_freeLoopHomotopyGroupHom, MonoidHom.mem_ker, _root_.map_mul, _root_.map_inv, hes,
        ← hh, mul_inv_cancel]
    obtain ⟨n, hn⟩ := hker
    obtain ⟨b, rfl⟩ := (basedMapCircleHomotopyGroupMulEquiv x 0).surjective n
    rw [freeLoopHomotopyGroupHom_basedMapCircleHomotopyGroupMulEquiv] at hn
    have ha : a = Additive.ofMul (a.toMul * s⁻¹) + Additive.ofMul s := by
      rw [← ofMul_mul, inv_mul_cancel_right, ofMul_toMul]
    rw [ha, map_add, hs, cubicalFreeLoopTorusClassHom_map_const' R hc, add_zero, ← hn]
    induction b using Quotient.inductionOn with
    | h β => exact cubicalFreeLoopTorusClassHom_map_val_mem_range R β
  · rintro _ ⟨a, rfl⟩
    induction a using Quotient.inductionOn with | h p => ?_
    obtain ⟨Λ, hΛ, rfl⟩ := exists_freeLoopTorus_eq p
    exact ⟨_, (cubicalFreeLoopTorusClassHom_eq_cubicalHurewicz R Λ hΛ).trans
      ((HomotopyGroup.cubicalHurewiczHom_apply R 1 _).trans
        (HomotopyGroup.cubicalHurewicz_mk R 1 _)).symm⟩

end FundamentalGroup

/-! ### Torus classes in singular homology -/

section Singular

variable {Q : Type} [TopologicalSpace Q]

variable (Q) in
/-- **The torus class of a loop of free loops in singular homology**: the homomorphism
`π₁(𝓛Q, γ) → H₂(Q; ℤ)` sending a loop `Λ` of free loops at `γ` to the class of the torus
`(s, t) ↦ Λ t (exp (2πis))` it sweeps out. It is the cubical torus class
`TauCeti.cubicalFreeLoopTorusClassHom`, read in singular homology through the cubical–simplicial
comparison. -/
def freeLoopTorusClassHom (γ : C(Circle, Q)) :
    Additive (HomotopyGroup (Fin 1) C(Circle, Q) γ) →+
      ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).obj (TopCat.of Q) :=
  (singularCubicalHomologyIso ℤ (TopCat.of Q) 2).inv.hom.toAddMonoidHom.comp
    (cubicalFreeLoopTorusClassHom Q ℤ γ)

theorem freeLoopTorusClassHom_apply (γ : C(Circle, Q))
    (a : Additive (HomotopyGroup (Fin 1) C(Circle, Q) γ)) :
    freeLoopTorusClassHom Q γ a =
      (singularCubicalHomologyIso ℤ (TopCat.of Q) 2).inv (cubicalFreeLoopTorusClassHom Q ℤ γ a) :=
  (rfl)

/-- **The torus classes at a constant loop are the Hurewicz classes of `π₂`.** At the constant
loop at `x`, the image of the torus class `π₁(𝓛Q, x) → H₂(Q; ℤ)` is the image of the Hurewicz map
`π₂(Q, x) → H₂(Q; ℤ)`. -/
theorem range_freeLoopTorusClassHom_const (x : Q) :
    (freeLoopTorusClassHom Q (ContinuousMap.const Circle x)).range =
      (hurewiczIntHom Q x 1).range := by
  obtain ⟨ε, hε⟩ := HomotopyGroup.exists_hurewicz_eq_units_smul_cubicalHurewicz 0
  have hεε : (ε : ℤ) * ε = 1 := by rw [← Units.val_mul, Int.units_mul_self, Units.val_one]
  -- The Hurewicz class of `a` is `ε` times the singular reading of its cubical Hurewicz class.
  have hh (a : Additive (HomotopyGroup (Fin 2) Q x)) : hurewiczIntHom Q x 1 a =
      (ε : ℤ) • (singularCubicalHomologyIso ℤ (TopCat.of Q) 2).inv
        (HomotopyGroup.cubicalHurewiczHom ℤ 1 a) := by
    rw [hurewiczIntHom_apply, hε, HomotopyGroup.cubicalHurewiczHom_apply]
  refine le_antisymm ?_ ?_
  · rintro _ ⟨g, rfl⟩
    obtain ⟨a, ha⟩ : cubicalFreeLoopTorusClassHom Q ℤ _ g ∈
        (HomotopyGroup.cubicalHurewiczHom ℤ 1 : Additive (HomotopyGroup (Fin 2) Q x) →+ _).range :=
      range_cubicalFreeLoopTorusClassHom_const ℤ x ▸ ⟨g, rfl⟩
    refine ⟨(ε : ℤ) • a, ?_⟩
    rw [map_zsmul, hh, freeLoopTorusClassHom_apply, ← ha]
    exact ((smul_smul _ _ _).trans (congrArg (· • _) hεε)).trans (one_smul _ _)
  · rintro _ ⟨a, rfl⟩
    obtain ⟨g, hg⟩ : HomotopyGroup.cubicalHurewiczHom ℤ 1 a ∈
        (cubicalFreeLoopTorusClassHom Q ℤ (ContinuousMap.const Circle x)).range :=
      (range_cubicalFreeLoopTorusClassHom_const ℤ x).symm ▸ ⟨a, rfl⟩
    refine ⟨(ε : ℤ) • g, ?_⟩
    rw [map_zsmul, hh, freeLoopTorusClassHom_apply, hg]
    -- The two sides differ only by reading singular homology as the homology of the singular
    -- chains, which carries the same scalar action.
    rfl

/-- The torus class of a loop of free loops at a constant loop is spherical. -/
theorem freeLoopTorusClassHom_const_mem_sphericalClasses (x : Q)
    (a : Additive (HomotopyGroup (Fin 1) C(Circle, Q) (ContinuousMap.const Circle x))) :
    freeLoopTorusClassHom Q (ContinuousMap.const Circle x) a ∈ sphericalClasses Q 1 := by
  obtain ⟨b, hb⟩ : freeLoopTorusClassHom Q _ a ∈ (hurewiczIntHom Q x 1).range :=
    range_freeLoopTorusClassHom_const x ▸ ⟨a, rfl⟩
  exact hb ▸ hurewiczIntHom_mem_sphericalClasses x b

end Singular

end TauCeti
