public import TauCeti.AlgebraicTopology.Sphere.CubeQuotient
public import TauCeti.AlgebraicTopology.Sphere.Puncture

/-!
# The Hurewicz class of the tautological loop of a sphere

The map `TauCeti.cubeToSphere : Iⁿ⁺¹ → Sⁿ⁺¹` collapses the boundary of the cube to the north pole
`N`, so it is a generalized loop `TauCeti.sphereGenLoop (n + 1)` of the sphere at `N`, with
universe-lifted counterpart `TauCeti.diskBoundaryGenLoop (n + 1)` on `TopCat.diskBoundary (n + 2)`.
This file proves that its Hurewicz class generates the top homology of the sphere in every
universe: `GenLoop.hurewicz R (diskBoundaryGenLoop (n + 1))` (and hence
`GenLoop.hurewicz R (sphereGenLoop (n + 1))` in `Type 0`) is an isomorphism, for coefficients `R`
in any abelian category with coproducts (`TauCeti.isIso_hurewicz_diskBoundaryGenLoop`,
`TauCeti.isIso_hurewicz_sphereGenLoop`). Equivalently, the quotient map `(Iⁿ⁺¹, ∂Iⁿ⁺¹) → (Sⁿ⁺¹, N)`
sends the fundamental class of the cube to a fundamental class of the sphere, inducing an
isomorphism `Hₙ₊₁(Iⁿ⁺¹, ∂Iⁿ⁺¹; R) ≅ Hₙ₊₁(Sⁿ⁺¹, N; R)`
(`TauCeti.isIso_singularHomologyMap_toCubeBoundaryPairHom_diskBoundaryGenLoop`,
`TauCeti.isIso_singularHomologyMap_toCubeBoundaryPairHom_sphereGenLoop`).

Every generalized loop factors through the tautological one
(`GenLoop.map_diskBoundaryMap_diskBoundaryGenLoop`, `GenLoop.map_toSphere_sphereGenLoop`), so this
is the universal example of the Hurewicz map: every Hurewicz class is the image of that of the
tautological loop (`GenLoop.hurewicz_eq_hurewicz_diskBoundaryGenLoop_comp`,
`GenLoop.hurewicz_eq_hurewicz_sphereGenLoop_comp`), which pins down the Hurewicz map on all spaces
up to its value on `π_{n+1}(Sⁿ⁺¹)`. In particular a generalized loop whose pointed map out of the
sphere is bijective onto a Hausdorff space, that is a surjective loop identifying only points of
the boundary of the cube, has a generating Hurewicz class
(`GenLoop.isIso_hurewicz_of_bijective_toSphere`).

Since a homotopy of generalized loops along a path is a free homotopy of the corresponding maps
out of the sphere (`TauCeti.GenLoop.HomotopyAlong.homotopic_toSphere`), and homotopic maps induce
the same map on singular homology, base-point change along a path preserves Hurewicz classes
(`HomotopyGroup.hurewicz_homotopyGroupTransport`), and the images of the integral Hurewicz
homomorphisms at two points joined by a path coincide
(`HomotopyGroup.range_hurewiczIntHom_eq_of_joined`,
`HomotopyGroup.range_hurewiczUliftIntHom_eq_of_joined`). With integer coefficients, the image of the
top homology of the sphere under the pointed map of a generalized loop is contained in the cyclic
group generated by the Hurewicz class of the loop
(`GenLoop.singularHomologyMap_toSphere_mem_zmultiples`,
`GenLoop.singularHomologyMap_diskBoundaryMap_mem_zmultiples`,
`GenLoop.singularHomologyMap_diskBoundaryMap_ulift_mem_zmultiples`).

The proof reads the Hurewicz class in the local homology `Hₙ₊₁(Sⁿ⁺¹, Sⁿ⁺¹ ∖ {s})` at the south pole
`s`, the image of the centre `0` of the disk `Dⁿ⁺¹` under `TauCeti.closedBallToSphere`, through
which `TauCeti.cubeToSphere` factors.

* The punctured sphere `Sⁿ⁺¹ ∖ {s}` is contractible, so `Hₙ₊₁(Sⁿ⁺¹) ⟶ Hₙ₊₁(Sⁿ⁺¹, Sⁿ⁺¹ ∖ {s})` is an
  isomorphism.
* The boundary sphere `Sⁿ` of the disk is a deformation retract of `Dⁿ⁺¹ ∖ {0}`, so
  `(Dⁿ⁺¹, Sⁿ) ⟶ (Dⁿ⁺¹, Dⁿ⁺¹ ∖ {0})` induces isomorphisms on relative homology
  (`TauCeti.isIso_singularHomologyMap_diskBoundaryPairToComplDiskCenter`).
* The collapse map is a homeomorphism from the open ball onto `Sⁿ⁺¹ ∖ {N}`, and only the centre
  goes to `s`. So it is a chart at the centre of the disk, and the local homology comparison
  `TauCeti.singularHomologyComplSingletonIsoOfChart` shows that
  `(Dⁿ⁺¹, Dⁿ⁺¹ ∖ {0}) ⟶ (Sⁿ⁺¹, Sⁿ⁺¹ ∖ {s})` induces isomorphisms on relative homology.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 2.1, Proposition 2.22 (the quotient map of a good pair, here
  `(Dⁿ, ∂Dⁿ) → (Dⁿ / ∂Dⁿ, pt)`), Section 4.1, the change of base point for higher homotopy
  groups, and Section 4.2, the Hurewicz map.
-/

public section

noncomputable section

open CategoryTheory Limits Metric Set Topology AlgebraicTopology
open scoped unitInterval Topology.Homotopy

universe w

namespace TauCeti

/-- The north pole of the universe-lifted sphere `TopCat.diskBoundary.{w} (n + 1)`. -/
def diskBoundaryNorthPole (n : ℕ) : TopCat.diskBoundary.{w} (n + 1) :=
  ULift.up (sphereNorthPole n)

@[simp]
theorem diskBoundaryNorthPole_down (n : ℕ) :
    (diskBoundaryNorthPole.{w} n).down = sphereNorthPole n :=
  (rfl)

/-- **The tautological generalized loop of the universe-lifted sphere**
`TopCat.diskBoundary.{w} (n + 1)`, obtained by lifting `TauCeti.sphereGenLoop n`. -/
def diskBoundaryGenLoop (n : ℕ) :
    Ω^ (Fin n) (TopCat.diskBoundary.{w} (n + 1)) (diskBoundaryNorthPole.{w} n) :=
  GenLoop.map ⟨ULift.up, continuous_uliftUp⟩ rfl (sphereGenLoop n)

@[simp]
theorem diskBoundaryGenLoop_apply_down (n : ℕ) (y : Fin n → I) :
    (diskBoundaryGenLoop.{w} n y).down = sphereGenLoop n y := by
  rw [diskBoundaryGenLoop]
  exact congrArg ULift.down (DFunLike.congr_fun (GenLoop.coe_map _ _ _) y)

private lemma diskBoundary_ext_iff {m : ℕ} {x y : TopCat.diskBoundary.{w} m} :
    x = y ↔ x.down = y.down :=
  ULift.ext_iff

variable (n : ℕ)

/-- The collapse `x ↦ (2 √(1 - ‖x‖²) x, 2 ‖x‖² - 1)` of the disk `𝔻 (n + 1)` onto the boundary
sphere `∂𝔻 (n + 2)` in universe `w`, through which `TauCeti.diskBoundaryGenLoop (n + 1)`
factors. -/
private def diskToDiskBoundary :
    TopCat.disk.{w} (n + 1) ⟶ TopCat.diskBoundary.{w} (n + 2) :=
  TopCat.ofHom (X := TopCat.disk.{w} (n + 1)) (Y := TopCat.diskBoundary.{w} (n + 2))
    ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
      ((closedBallToSphere (n + 1)).comp ⟨ULift.down, continuous_uliftDown⟩))

private lemma diskToDiskBoundary_apply_down (z : TopCat.disk.{w} (n + 1)) :
    (diskToDiskBoundary.{w} n z).down = closedBallToSphere (n + 1)
      (z : ULift.{w} (closedBall (0 : EuclideanSpace ℝ (Fin (n + 1))) 1)).down :=
  (rfl)

/-- Only the boundary sphere of the disk goes to the north pole. -/
private lemma diskToDiskBoundary_eq_diskBoundaryNorthPole_iff {z : TopCat.disk.{w} (n + 1)} :
    diskToDiskBoundary.{w} n z = diskBoundaryNorthPole.{w} (n + 1) ↔
      z ∈ Set.range (TopCat.diskBoundaryInclusion.{w} (n + 1)) := by
  rw [diskBoundary_ext_iff, diskToDiskBoundary_apply_down, diskBoundaryNorthPole_down,
    closedBallToSphere_eq_sphereNorthPole_iff, mem_range_diskBoundaryInclusion_iff]

/-! ### The collapse map on the interior of the disk -/

/-- The interior of the disk, the preimage of the complement of the north pole. -/
private abbrev diskInterior : Set (TopCat.disk.{w} (n + 1)) :=
  diskToDiskBoundary.{w} n ⁻¹' {diskBoundaryNorthPole.{w} (n + 1)}ᶜ

/-- The collapse map is a bijection from the interior of the disk onto the complement of the
north pole. -/
private lemma bijOn_diskToDiskBoundary :
    BijOn (diskToDiskBoundary.{w} n) (diskInterior.{w} n)
      {diskBoundaryNorthPole.{w} (n + 1)}ᶜ := by
  refine ⟨fun _ hz ↦ hz, fun z hz w _ h ↦ ?_, fun y hy ↦ ?_⟩
  · rw [diskBoundary_ext_iff, diskToDiskBoundary_apply_down, diskToDiskBoundary_apply_down,
      closedBallToSphere_eq_closedBallToSphere_iff] at h
    rcases h with h | ⟨h, -⟩
    · exact ULift.ext h
    · exact (hz ((diskToDiskBoundary_eq_diskBoundaryNorthPole_iff n).2
        ((mem_range_diskBoundaryInclusion_iff _).2 h))).elim
  · obtain ⟨z, hz⟩ := closedBallToSphere_surjective (n := n + 1) y.down
    have hz' : diskToDiskBoundary.{w} n
        (ULift.up z : ULift.{w} (closedBall (0 : EuclideanSpace ℝ (Fin (n + 1))) 1)) = y :=
      ULift.ext ((diskToDiskBoundary_apply_down n _).trans hz)
    exact ⟨_, Set.mem_compl_singleton_iff.2 (hz' ▸ hy), hz'⟩

/-- On the interior of the disk the collapse map is an open embedding. -/
private lemma isOpenEmbedding_diskToDiskBoundary_domRestrict :
    IsOpenEmbedding ((diskInterior.{w} n).domRestrict (diskToDiskBoundary.{w} n)) := by
  refine ⟨IsEmbedding.subtypeVal.comp (g := Subtype.val)
      (f := ({diskBoundaryNorthPole.{w} (n + 1)}ᶜ :
        Set (TopCat.diskBoundary.{w} (n + 2))).restrictPreimage (diskToDiskBoundary.{w} n))
      (IsClosedEmbedding.of_continuous_injective_isClosedMap
        ((diskToDiskBoundary.{w} n).hom.continuous.restrictPreimage) ?_
        (IsClosedMap.restrictPreimage
          (diskToDiskBoundary.{w} n).hom.continuous.isClosedMap _)).isEmbedding,
    ?_⟩
  · exact fun z w h ↦
      Subtype.ext ((bijOn_diskToDiskBoundary n).injOn z.2 w.2 (congrArg Subtype.val h))
  · rw [range_domRestrict, (bijOn_diskToDiskBoundary n).image_eq]
    exact isOpen_compl_singleton

/-- The collapse map as an open partial homeomorphism from the interior of the disk onto the
complement of the north pole. -/
private def diskToDiskBoundaryChart :
    OpenPartialHomeomorph (TopCat.disk.{w} (n + 1)) (TopCat.diskBoundary.{w} (n + 2)) :=
  OpenPartialHomeomorph.ofContinuousOpenRestrict
    ((bijOn_diskToDiskBoundary.{w} n).toPartialEquiv _ _ _)
    (diskToDiskBoundary.{w} n).hom.continuous.continuousOn
    (isOpenEmbedding_diskToDiskBoundary_domRestrict.{w} n).isOpenMap
    (isOpen_compl_singleton.preimage (diskToDiskBoundary.{w} n).hom.continuous)

private lemma diskToDiskBoundaryChart_apply (z : TopCat.disk.{w} (n + 1)) :
    diskToDiskBoundaryChart.{w} n z = diskToDiskBoundary.{w} n z :=
  (rfl)

/-- The south pole of `∂𝔻 (n + 2)`, the image of the centre of the disk. -/
private abbrev southPole : TopCat.diskBoundary.{w} (n + 2) :=
  diskToDiskBoundaryChart.{w} n (diskCenter.{w} (n + 1))

/-- Only the centre of the disk goes to the south pole. -/
private lemma diskToDiskBoundary_eq_southPole_iff {z : TopCat.disk.{w} (n + 1)} :
    diskToDiskBoundary.{w} n z = southPole.{w} n ↔ z = diskCenter.{w} (n + 1) := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ rfl⟩
  rw [southPole, diskToDiskBoundaryChart_apply, diskBoundary_ext_iff,
    diskToDiskBoundary_apply_down, diskToDiskBoundary_apply_down,
    closedBallToSphere_eq_closedBallToSphere_iff] at h
  rcases h with h | ⟨-, h⟩
  · exact ULift.ext h
  · simp at h

private lemma southPole_ne_diskBoundaryNorthPole :
    southPole.{w} n ≠ diskBoundaryNorthPole.{w} (n + 1) := by
  rw [Ne, southPole, diskToDiskBoundaryChart_apply, diskToDiskBoundary_eq_diskBoundaryNorthPole_iff]
  exact diskCenter_notMem_range_diskBoundaryInclusion (n + 1)

private lemma diskCenter_mem_diskToDiskBoundaryChart_source :
    diskCenter.{w} (n + 1) ∈ (diskToDiskBoundaryChart.{w} n).source :=
  southPole_ne_diskBoundaryNorthPole n

private lemma mapsTo_diskToDiskBoundary_compl :
    MapsTo (diskToDiskBoundary.{w} n)
      ({diskCenter.{w} (n + 1)}ᶜ : Set (TopCat.disk.{w} (n + 1)))
      ({southPole.{w} n}ᶜ : Set (TopCat.of (TopCat.diskBoundary.{w} (n + 2)))) :=
  fun _ hz h ↦ hz ((diskToDiskBoundary_eq_southPole_iff n).1 h)

/-- The collapse map as a map of pairs
`(𝔻 (n + 1), 𝔻 (n + 1) ∖ {0}) ⟶ (∂𝔻 (n + 2), ∂𝔻 (n + 2) ∖ {s})`. -/
private def diskToDiskBoundaryPairMap :
    TopPair.ofSubset ({diskCenter.{w} (n + 1)}ᶜ : Set (TopCat.disk.{w} (n + 1))) ⟶
      TopPair.ofSubset
        ({southPole.{w} n}ᶜ : Set (TopCat.of (TopCat.diskBoundary.{w} (n + 2)))) :=
  TopPair.ofSubsetMap (diskToDiskBoundary.{w} n) (mapsTo_diskToDiskBoundary_compl n)

section Universe

variable {C : Type*} [Category C] [HasCoproducts.{w} C] [Abelian C] (R : C)

/-- **Local homology at the centre of the disk.** The collapse map induces isomorphisms
`Hₖ(𝔻 (n + 1), 𝔻 (n + 1) ∖ {0}) ≅ Hₖ(∂𝔻 (n + 2), ∂𝔻 (n + 2) ∖ {s})` in any universe `w`, since it is
a homeomorphism near the centre. -/
private lemma isIso_singularHomologyMap_diskToDiskBoundaryPairMap (k : ℕ) :
    IsIso (TopPair.singularHomologyMap (diskToDiskBoundaryPairMap.{w} n) R k) := by
  have hx := diskCenter_mem_diskToDiskBoundaryChart_source.{w} n
  have := TopPair.isIso_singularHomologyMap_excisionMap_of_isClosed_subset R
    (X := TopCat.of (TopCat.disk.{w} (n + 1))) (diskToDiskBoundaryChart.{w} n).open_source
    isClosed_singleton (singleton_subset_iff.2 hx) k
  have hfac := singularHomologyMap_excisionMap_comp_singularHomologyComplSingletonIsoOfChart_hom
    R (diskToDiskBoundaryChart.{w} n) hx k
  rw [← TopPair.singularHomologyMap_comp] at hfac
  -- Excision onto the source followed by the collapse map is the homeomorphism of the chart
  -- followed by excision onto the target.
  have hpair : TopPair.excisionMap (X := TopCat.of (TopCat.disk.{w} (n + 1)))
      (diskToDiskBoundaryChart.{w} n).source {diskCenter.{w} (n + 1)}ᶜ ≫
        diskToDiskBoundaryPairMap.{w} n =
      (TopPair.ofSubsetIso (X := TopCat.of (diskToDiskBoundaryChart.{w} n).source)
        (Y := TopCat.of (diskToDiskBoundaryChart.{w} n).target)
        (diskToDiskBoundaryChart.{w} n).toHomeomorphSourceTarget
        (B := Subtype.val ⁻¹' {diskCenter.{w} (n + 1)}ᶜ)
        (B' := Subtype.val ⁻¹' {diskToDiskBoundaryChart.{w} n (diskCenter.{w} (n + 1))}ᶜ)
        fun z ↦ ((diskToDiskBoundaryChart.{w} n).injOn.eq_iff z.2 hx).not.symm).hom ≫
      TopPair.excisionMap (X := TopCat.of (TopCat.diskBoundary.{w} (n + 2)))
        (diskToDiskBoundaryChart.{w} n).target
        {diskToDiskBoundaryChart.{w} n (diskCenter.{w} (n + 1))}ᶜ := by
    apply TopPair.hom_ext_of_fst
    ext z
    rw [TopPair.Hom.fst_comp, TopPair.Hom.fst_comp, ConcreteCategory.comp_apply,
      ConcreteCategory.comp_apply]
    -- The ambient spaces of these pairs are subspaces presented through `TopPair.ofSubset`, so
    -- the evaluation lemmas only match after unfolding.
    erw [TopPair.excisionMap_fst_apply, TopPair.excisionMap_fst_apply, TopPair.ofSubsetIso_hom,
      TopPair.ofSubsetMap_fst_apply, TopPair.ofSubsetMap_fst_apply]
    rfl
  rw [← hpair, TopPair.singularHomologyMap_comp, cancel_epi] at hfac
  rw [← hfac]
  infer_instance

/-! ### The Hurewicz class of the tautological loop -/

private lemma mapsTo_id_diskBoundaryNorthPole :
    MapsTo (𝟙 (TopCat.of (TopCat.diskBoundary.{w} (n + 2))))
      ({diskBoundaryNorthPole.{w} (n + 1)} : Set (TopCat.of (TopCat.diskBoundary.{w} (n + 2))))
      ({southPole.{w} n}ᶜ : Set (TopCat.of (TopCat.diskBoundary.{w} (n + 2)))) := by
  rintro _ rfl h
  exact southPole_ne_diskBoundaryNorthPole n h.symm

private lemma diskHomeomorphCube_symm_diskHomeomorphCube_down (z : TopCat.disk.{w} (n + 1)) :
    ((diskHomeomorphCube.{0} (n + 1)).symm (diskHomeomorphCube.{w} (n + 1) z)).down =
      (z : ULift.{w} (closedBall (0 : EuclideanSpace ℝ (Fin (n + 1))) 1)).down := by
  let z₀ : TopCat.disk.{0} (n + 1) :=
    (ULift.up (z : ULift.{w} (closedBall (0 : EuclideanSpace ℝ (Fin (n + 1))) 1)).down :
      ULift.{0} (closedBall (0 : EuclideanSpace ℝ (Fin (n + 1))) 1))
  have hz : diskHomeomorphCube.{w} (n + 1) z = diskHomeomorphCube.{0} (n + 1) z₀ := by
    rw [diskHomeomorphCube_apply, diskHomeomorphCube_apply]
    refine congrArg _ (Subtype.ext ?_)
    rw [coe_diskHomeomorphClosedBall_apply, coe_diskHomeomorphClosedBall_apply]
  rw [hz, Homeomorph.symm_apply_apply]

/-- The tautological loop on `∂𝔻 (n + 2)`, read on the disk, is the collapse map: the composite
`(𝔻 (n + 1), ∂𝔻 (n + 1)) ⟶ (Iⁿ⁺¹, ∂Iⁿ⁺¹) ⟶ (∂𝔻 (n + 2), {N}) ⟶ (∂𝔻 (n + 2), ∂𝔻 (n + 2) ∖ {s})`
equals
`(𝔻 (n + 1), ∂𝔻 (n + 1)) ⟶ (𝔻 (n + 1), 𝔻 (n + 1) ∖ {0}) ⟶ (∂𝔻 (n + 2), ∂𝔻 (n + 2) ∖ {s})`. -/
private lemma diskBoundaryPairToCube_comp_toCubeBoundaryPairHom :
    diskBoundaryPairToCube.{w} (n + 1) ≫
        GenLoop.toCubeBoundaryPairHom (diskBoundaryGenLoop.{w} (n + 1)) ≫
          TopPair.ofSubsetMap (𝟙 _) (mapsTo_id_diskBoundaryNorthPole.{w} n) =
      diskBoundaryPairToComplDiskCenter.{w} (n + 1) ≫ diskToDiskBoundaryPairMap.{w} n := by
  apply TopPair.hom_ext_of_fst
  ext z
  rw [TopPair.Hom.fst_comp, TopPair.Hom.fst_comp, TopPair.Hom.fst_comp, ConcreteCategory.comp_apply,
    ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, TopPair.ofSubsetMap_fst_apply,
    GenLoop.toCubeBoundaryPairHom_fst_apply, diskBoundaryPairToCube_fst_apply_down]
  -- The ambient spaces of these pairs are presented through `TopPair.ofSubset` and
  -- `TopCat.disk`, so the evaluation lemmas only match after unfolding.
  erw [TopPair.ofSubsetMap_fst_apply, ConcreteCategory.id_apply]
  apply ULift.ext
  rw [diskBoundaryGenLoop_apply_down, sphereGenLoop_apply, cubeToSphere_apply]
  erw [diskHomeomorphCube_symm_diskHomeomorphCube_down, diskBoundaryPairToComplDiskCenter_fst]
  -- Both sides are now the underlying point of `diskToDiskBoundary n z`.
  rfl

private lemma contractibleSpace_diskBoundary_compl_singleton
    (s : TopCat.diskBoundary.{w} (n + 2)) :
    ContractibleSpace ({s}ᶜ : Set (TopCat.diskBoundary.{w} (n + 2))) := by
  let e : ({s}ᶜ : Set (TopCat.diskBoundary.{w} (n + 2))) ≃ₜ
      ({diskBoundaryHomeomorph (n + 2) s}ᶜ :
        Set (sphere (0 : EuclideanSpace ℝ (ULift.{w} (Fin (n + 2)))) 1)) :=
    (diskBoundaryHomeomorph (n + 2)).subtype fun x ↦ by
      simp only [mem_compl_iff, mem_singleton_iff,
        (diskBoundaryHomeomorph (n + 2)).injective.eq_iff]
  have hc : ContractibleSpace ({diskBoundaryHomeomorph (n + 2) s}ᶜ :
      Set (sphere (0 : EuclideanSpace ℝ (ULift.{w} (Fin (n + 2)))) 1)) :=
    contractibleSpace_sphere_compl_singleton _
  exact e.contractibleSpace_iff.mpr hc

/-- **The Hurewicz class of the tautological loop generates the top homology of the lifted sphere**
in every universe `w`: `GenLoop.hurewicz R (diskBoundaryGenLoop (n + 1))` is an isomorphism
`R ≅ Hₙ₊₁(∂𝔻 (n + 2); R)`. -/
instance isIso_hurewicz_diskBoundaryGenLoop :
    IsIso (GenLoop.hurewicz R (diskBoundaryGenLoop.{w} (n + 1))) := by
  have hN := mapsTo_id_diskBoundaryNorthPole.{w} n
  -- Read the class in the local homology at the south pole.
  have hπ : (singularHomologyIsoOfSubsetSingleton R n (diskBoundaryNorthPole.{w} (n + 1))).hom ≫
      TopPair.singularHomologyMap (TopPair.ofSubsetMap (𝟙 _) hN) R (n + 1) =
        (TopPair.ofSubset ({southPole.{w} n}ᶜ :
          Set (TopCat.of (TopCat.diskBoundary.{w} (n + 2))))).singularHomologyπ R (n + 1) := by
    have h := TopPair.singularHomologyπ_naturality (R := R) (TopPair.ofSubsetMap (𝟙 _) hN) (n + 1)
    -- The ambient space of `TopPair.ofSubset` is `TopCat.of (TopCat.diskBoundary (n + 2))` only up
    -- to unfolding, so the identity is matched by `erw`.
    erw [TopPair.ofSubsetMap_fst, CategoryTheory.Functor.map_id, SSet.homologyMap_id,
      Category.id_comp] at h
    rw [singularHomologyIsoOfSubsetSingleton_hom]
    exact h.symm
  have : ContractibleSpace (TopPair.ofSubset ({southPole.{w} n}ᶜ :
      Set (TopCat.of (TopCat.diskBoundary.{w} (n + 2))))).snd :=
    contractibleSpace_diskBoundary_compl_singleton n (southPole.{w} n)
  -- State the source of `singularHomologyπ` as `singularHomologyFunctor` so instance search matches
  -- the target of `GenLoop.hurewicz`.
  have : IsIso (X := ((singularHomologyFunctor C (n + 1)).obj R).obj
      (TopCat.of (TopCat.diskBoundary.{w} (n + 2))))
      ((TopPair.ofSubset ({southPole.{w} n}ᶜ :
        Set (TopCat.of (TopCat.diskBoundary.{w} (n + 2))))).singularHomologyπ R (n + 1)) :=
    TopPair.isIso_singularHomologyπ_of_contractibleSpace _ R n
  have := isIso_singularHomologyMap_diskBoundaryPairToComplDiskCenter.{w} R (n + 1) (n + 1)
  have := isIso_singularHomologyMap_diskToDiskBoundaryPairMap.{w} n R (n + 1)
  have hfac : GenLoop.hurewicz R (diskBoundaryGenLoop.{w} (n + 1)) ≫
      (TopPair.ofSubset ({southPole.{w} n}ᶜ :
        Set (TopCat.of (TopCat.diskBoundary.{w} (n + 2))))).singularHomologyπ R (n + 1) =
      (singularHomologyDiskBoundaryPairIso.{w} R (n + 1)).inv ≫
        TopPair.singularHomologyMap (diskBoundaryPairToComplDiskCenter.{w} (n + 1)) R (n + 1) ≫
          TopPair.singularHomologyMap (diskToDiskBoundaryPairMap.{w} n) R (n + 1) := by
    rw [← hπ, GenLoop.hurewicz_comp_singularHomologyIsoOfSubsetSingleton_hom_assoc,
      singularHomologyCubeBoundaryPairIso_inv, Category.assoc,
      ← TopPair.singularHomologyMap_comp, ← TopPair.singularHomologyMap_comp,
      diskBoundaryPairToCube_comp_toCubeBoundaryPairHom, TopPair.singularHomologyMap_comp]
  exact IsIso.of_isIso_fac_right hfac

/-- **The collapse of the boundary of the cube onto `∂𝔻 (n + 2)` induces an isomorphism on relative
homology** in every universe `w`. -/
instance isIso_singularHomologyMap_toCubeBoundaryPairHom_diskBoundaryGenLoop :
    IsIso (TopPair.singularHomologyMap
      (GenLoop.toCubeBoundaryPairHom.{w} (diskBoundaryGenLoop.{w} (n + 1))) R (n + 1)) := by
  rw [← Iso.hom_inv_id_assoc (singularHomologyCubeBoundaryPairIso.{w} R (n + 1))
    (TopPair.singularHomologyMap _ R (n + 1)),
    ← GenLoop.hurewicz_comp_singularHomologyIsoOfSubsetSingleton_hom]
  infer_instance

end Universe

section Small

variable {C : Type*} [Category C] [HasCoproducts.{0} C] [Abelian C] (R : C)

/-- **The Hurewicz class of the tautological loop generates the top homology of the sphere.**
The class of `TauCeti.cubeToSphere : (Iⁿ⁺¹, ∂Iⁿ⁺¹) → (Sⁿ⁺¹, N)` under the Hurewicz map is an
isomorphism `R ≅ Hₙ₊₁(Sⁿ⁺¹; R)`: the collapse of the boundary of the cube sends the fundamental
class of the cube to a fundamental class of the sphere. -/
instance isIso_hurewicz_sphereGenLoop :
    IsIso (GenLoop.hurewicz R (sphereGenLoop (n + 1))) := by
  let e : TopCat.diskBoundary.{0} (n + 2) ≃ₜ sphere (0 : EuclideanSpace ℝ (Fin (n + 2))) 1 :=
    Homeomorph.ulift
  let f : C(TopCat.diskBoundary.{0} (n + 2), sphere (0 : EuclideanSpace ℝ (Fin (n + 2))) 1) := e
  have hN : f (diskBoundaryNorthPole.{0} (n + 1)) = sphereNorthPole (n + 1) :=
    diskBoundaryNorthPole_down.{0} (n + 1)
  have hloop : GenLoop.map f hN (diskBoundaryGenLoop.{0} (n + 1)) = sphereGenLoop (n + 1) := by
    apply Subtype.ext
    refine ContinuousMap.ext fun y ↦ ?_
    rw [DFunLike.congr_fun (GenLoop.coe_map _ _ _) y]
    exact diskBoundaryGenLoop_apply_down.{0} (n + 1) y
  have : IsIso (TopCat.ofHom f) :=
    TopCat.isIso_of_bijective_of_isClosedMap _ e.bijective e.isClosedMap
  rw [← hloop, GenLoop.hurewicz_map]
  infer_instance

/-- **The collapse of the boundary of the cube induces an isomorphism on relative homology.** The
map of pairs `TauCeti.cubeToSphere : (Iⁿ⁺¹, ∂Iⁿ⁺¹) → (Sⁿ⁺¹, N)` induces an isomorphism
`Hₙ₊₁(Iⁿ⁺¹, ∂Iⁿ⁺¹; R) ≅ Hₙ₊₁(Sⁿ⁺¹, N; R)`. -/
instance isIso_singularHomologyMap_toCubeBoundaryPairHom_sphereGenLoop :
    IsIso (TopPair.singularHomologyMap
      (GenLoop.toCubeBoundaryPairHom.{0} (sphereGenLoop (n + 1))) R (n + 1)) := by
  rw [← Iso.hom_inv_id_assoc (singularHomologyCubeBoundaryPairIso R (n + 1))
    (TopPair.singularHomologyMap _ R (n + 1)),
    ← GenLoop.hurewicz_comp_singularHomologyIsoOfSubsetSingleton_hom]
  infer_instance

end Small

end TauCeti

namespace GenLoop

open TauCeti

section DiskBoundary

variable {n : ℕ} [NeZero n] {X : Type w} [TopologicalSpace X] {x : X}

/-- The attaching map `GenLoop.diskBoundaryMap p` sends the north pole of `∂𝔻 (n + 1)` to the base
point `x`. -/
@[simp]
theorem diskBoundaryMap_diskBoundaryNorthPole (p : Ω^ (Fin n) X x) :
    diskBoundaryMap (X := TopCat.of X) p (diskBoundaryNorthPole.{w} n) = x := by
  rw [diskBoundaryMap_apply, diskBoundaryNorthPole_down, toSphere_sphereNorthPole]

/-- Every generalized loop factors through `TauCeti.diskBoundaryGenLoop` via
`GenLoop.diskBoundaryMap`. -/
@[simp]
theorem map_diskBoundaryMap_diskBoundaryGenLoop (p : Ω^ (Fin n) X x) :
    GenLoop.map (diskBoundaryMap (X := TopCat.of X) p).hom
        (diskBoundaryMap_diskBoundaryNorthPole p) (diskBoundaryGenLoop.{w} n) = p := by
  apply Subtype.ext
  refine ContinuousMap.ext fun y ↦ ?_
  rw [DFunLike.congr_fun (GenLoop.coe_map _ _ _) y, ContinuousMap.comp_apply, GenLoop.coe_coe]
  exact (diskBoundaryMap_apply (X := TopCat.of X) p (diskBoundaryGenLoop.{w} n y)).trans
    ((congrArg (toSphere p)
      ((diskBoundaryGenLoop_apply_down.{w} n y).trans (sphereGenLoop_apply y))).trans
      (toSphere_cubeToSphere p y))

end DiskBoundary

section Small

variable {C : Type*} [Category C] [HasCoproducts.{0} C] [Abelian C] (R : C) {n : ℕ}
  {X : Type} [TopologicalSpace X] {x : X}

/-- **Every Hurewicz class is the image of that of the tautological loop**: the Hurewicz class of
a generalized loop `p` is the image of the Hurewicz class of `TauCeti.sphereGenLoop (n + 1)` under
`(GenLoop.toSphere p)_* : Hₙ₊₁(Sⁿ⁺¹; R) ⟶ Hₙ₊₁(X; R)`. -/
theorem hurewicz_eq_hurewicz_sphereGenLoop_comp (p : Ω^ (Fin (n + 1)) X x) :
    hurewicz R p = hurewicz R (sphereGenLoop (n + 1)) ≫
      ((singularHomologyFunctor C (n + 1)).obj R).map (TopCat.ofHom (toSphere p)) := by
  rw [← hurewicz_map R (toSphere p) (toSphere_sphereNorthPole p), map_toSphere_sphereGenLoop]

end Small

section Universe

variable {C : Type*} [Category C] [HasCoproducts.{w} C] [Abelian C] (R : C) {n : ℕ}
  {X : Type w} [TopologicalSpace X] {x : X}

/-- **Every Hurewicz class in universe `w` is the image of that of `diskBoundaryGenLoop`**: the
Hurewicz class of `p` is the image of `GenLoop.hurewicz R (diskBoundaryGenLoop (n + 1))` under
`(GenLoop.diskBoundaryMap p)_* : Hₙ₊₁(∂𝔻 (n + 2); R) ⟶ Hₙ₊₁(X; R)`. -/
theorem hurewicz_eq_hurewicz_diskBoundaryGenLoop_comp (p : Ω^ (Fin (n + 1)) X x) :
    hurewicz R p = hurewicz R (diskBoundaryGenLoop.{w} (n + 1)) ≫
      ((singularHomologyFunctor C (n + 1)).obj R).map (diskBoundaryMap (X := TopCat.of X) p) := by
  have h := hurewicz_map R (diskBoundaryMap (X := TopCat.of X) p).hom
    (diskBoundaryMap_diskBoundaryNorthPole p) (diskBoundaryGenLoop.{w} (n + 1))
  rw [map_diskBoundaryMap_diskBoundaryGenLoop] at h
  exact h

/-- **A generalized loop that is a homeomorphism off the boundary has a generating Hurewicz class.**
If the pointed map `GenLoop.toSphere p : Sⁿ⁺¹ → X` is bijective onto a Hausdorff space `X`, it is a
homeomorphism, so the Hurewicz class of `p` is an isomorphism `R ≅ Hₙ₊₁(X; R)`, like that of the
tautological loop. By `GenLoop.injective_toSphere_iff` and `GenLoop.surjective_toSphere_iff`, the
hypothesis says that `p` is surjective and identifies only points of the boundary of the cube. -/
theorem isIso_hurewicz_of_bijective_toSphere [T2Space X] {p : Ω^ (Fin (n + 1)) X x}
    (hp : Function.Bijective (toSphere p)) : IsIso (hurewicz R p) := by
  have : CompactSpace (TopCat.diskBoundary.{w} (n + 2)) :=
    inferInstanceAs (CompactSpace (ULift.{w} (sphere (0 : EuclideanSpace ℝ (Fin (n + 2))) 1)))
  have hbij : Function.Bijective (diskBoundaryMap (X := TopCat.of X) p) :=
    ⟨fun s t h ↦ ULift.ext (hp.1 ((diskBoundaryMap_apply (X := TopCat.of X) p s).symm.trans
        (h.trans (diskBoundaryMap_apply (X := TopCat.of X) p t)))),
      fun y ↦ let ⟨s, hs⟩ := hp.2 y; ⟨ULift.up s, (diskBoundaryMap_apply (X := TopCat.of X) p
        (ULift.up s)).trans hs⟩⟩
  have : IsIso (diskBoundaryMap (X := TopCat.of X) p) :=
    TopCat.isIso_of_bijective_of_isClosedMap _ hbij
      (diskBoundaryMap (X := TopCat.of X) p).hom.continuous.isClosedMap
  rw [hurewicz_eq_hurewicz_diskBoundaryGenLoop_comp]
  infer_instance

end Universe

end GenLoop

namespace HomotopyGroup

open TauCeti

section Transport

variable {X : Type w} [TopologicalSpace X] {x y : X}
  {C : Type*} [Category C] [HasCoproducts.{w} C] [Abelian C] (R : C) (n : ℕ)

/-- **The Hurewicz map is invariant under base-point change.** Transporting a class of
`πₙ₊₁(X, x)` along a path does not change its Hurewicz class in `Hₙ₊₁(X; R)`. -/
@[simp]
theorem hurewicz_homotopyGroupTransport (γ : Path x y) (a : HomotopyGroup (Fin (n + 1)) X x) :
    hurewicz R n (homotopyGroupTransport γ a) = hurewicz R n a := by
  induction a using Quotient.inductionOn with | h f => ?_
  rw [homotopyGroupTransport_mk, hurewicz_mk, hurewicz_mk,
    GenLoop.hurewicz_eq_hurewicz_diskBoundaryGenLoop_comp (p := GenLoop.transport γ f),
    GenLoop.hurewicz_eq_hurewicz_diskBoundaryGenLoop_comp (p := f)]
  -- Precomposing the free homotopy on `Sⁿ⁺¹` with `ULift.down` gives a free homotopy on
  -- `∂𝔻 (n + 2)`, so the two attaching maps induce the same map on singular homology.
  obtain ⟨H⟩ := (GenLoop.collarHomotopyAlong γ f).homotopic_toSphere
  let H' : (GenLoop.diskBoundaryMap (X := TopCat.of X) f).hom.Homotopy
      (GenLoop.diskBoundaryMap (X := TopCat.of X) (GenLoop.transport γ f)).hom :=
    (H.compContinuousMap ⟨ULift.down, continuous_uliftDown⟩).cast
      (ContinuousMap.ext fun s ↦ (GenLoop.diskBoundaryMap_apply (X := TopCat.of X) f s).symm)
      (ContinuousMap.ext fun s ↦ (GenLoop.diskBoundaryMap_apply (X := TopCat.of X) _ s).symm)
  exact congrArg (_ ≫ ·) (TopCat.Homotopy.congr_homologyMap_singularChainComplexFunctor
    (f := GenLoop.diskBoundaryMap (X := TopCat.of X) (GenLoop.transport γ f))
    (g := GenLoop.diskBoundaryMap (X := TopCat.of X) f) H'.symm R (n + 1))

end Transport

/-- The integral Hurewicz homomorphism is invariant under base-point change. -/
@[simp]
theorem hurewiczIntHom_homotopyGroupTransport {X : Type} [TopologicalSpace X] {x y : X}
    (γ : Path x y) {n : ℕ} (a : HomotopyGroup (Fin (n + 1)) X x) :
    hurewiczIntHom X y n (Additive.ofMul (homotopyGroupTransport γ a)) =
      hurewiczIntHom X x n (Additive.ofMul a) := by
  rw [hurewiczIntHom_apply, hurewiczIntHom_apply, toMul_ofMul, toMul_ofMul,
    hurewicz_homotopyGroupTransport]

variable {X : Type} [TopologicalSpace X] {x y : X}

/-- The images of the integral Hurewicz homomorphisms at two points joined by a path coincide. -/
theorem range_hurewiczIntHom_eq_of_joined (h : Joined x y) (n : ℕ) :
    (hurewiczIntHom X x n).range = (hurewiczIntHom X y n).range := by
  -- Each range is contained in the other, by transport along the path and its reverse.
  have key {x y : X} (γ : Path x y) :
      (hurewiczIntHom X x n).range ≤ (hurewiczIntHom X y n).range := by
    rintro _ ⟨a, rfl⟩
    exact ⟨Additive.ofMul (homotopyGroupTransport γ a.toMul), by simp⟩
  exact le_antisymm (key h.somePath) (key h.somePath.symm)

/-- The universe-polymorphic integral Hurewicz homomorphism is invariant under base-point
change. -/
@[simp]
theorem hurewiczUliftIntHom_homotopyGroupTransport {X : Type w} [TopologicalSpace X] {x y : X}
    (γ : Path x y) {n : ℕ} (a : HomotopyGroup (Fin (n + 1)) X x) :
    hurewiczUliftIntHom X y n (Additive.ofMul (homotopyGroupTransport γ a)) =
      hurewiczUliftIntHom X x n (Additive.ofMul a) := by
  rw [hurewiczUliftIntHom_apply, hurewiczUliftIntHom_apply, toMul_ofMul, toMul_ofMul,
    hurewicz_homotopyGroupTransport]

/-- The images of the universe-polymorphic integral Hurewicz homomorphisms at two points joined by
a path coincide. -/
theorem range_hurewiczUliftIntHom_eq_of_joined {X : Type w} [TopologicalSpace X] {x y : X}
    (h : Joined x y) (n : ℕ) :
    (hurewiczUliftIntHom X x n).range = (hurewiczUliftIntHom X y n).range := by
  have key {x y : X} (γ : Path x y) :
      (hurewiczUliftIntHom X x n).range ≤ (hurewiczUliftIntHom X y n).range := by
    rintro _ ⟨a, rfl⟩
    exact ⟨Additive.ofMul (homotopyGroupTransport γ a.toMul), by simp⟩
  exact le_antisymm (key h.somePath) (key h.somePath.symm)

end HomotopyGroup

namespace GenLoop

open TauCeti

variable {n : ℕ}

/-- The image of the integral homology of the sphere `Sⁿ⁺¹` under the pointed map
`GenLoop.toSphere p` of a generalized loop `p` is contained in the cyclic group generated by the
Hurewicz class of `p`. -/
theorem singularHomologyMap_toSphere_mem_zmultiples {X : Type} [TopologicalSpace X] {x : X}
    (p : Ω^ (Fin (n + 1)) X x)
    (b : ((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ ℤ)).obj (TopCat.of (sphere (0 : EuclideanSpace ℝ (Fin (n + 2))) 1))) :
    (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ ℤ)).map (TopCat.ofHom (toSphere p))).hom b ∈
        AddSubgroup.zmultiples ((hurewicz (ModuleCat.of ℤ ℤ) p).hom 1) := by
  set h₀ := hurewicz (ModuleCat.of ℤ ℤ) (sphereGenLoop (n + 1))
  obtain ⟨k, rfl⟩ : ∃ k : ℤ, h₀.hom k = b := ⟨(inv h₀).hom b, IsIso.inv_hom_id_apply h₀ b⟩
  have hk : h₀.hom k = k • h₀.hom 1 := by
    rw [← map_zsmul, smul_eq_mul, mul_one]
  refine ⟨k, ?_⟩
  rw [hk, map_zsmul, hurewicz_eq_hurewicz_sphereGenLoop_comp, ModuleCat.hom_comp,
    LinearMap.comp_apply]

/-- The image of the integral homology of the boundary sphere `∂𝔻ⁿ⁺²` under the attaching map
`GenLoop.diskBoundaryMap p` of a generalized loop `p` is contained in the cyclic group generated
by the Hurewicz class of `p`. -/
theorem singularHomologyMap_diskBoundaryMap_mem_zmultiples {X : TopCat.{0}} {x : X}
    (p : Ω^ (Fin (n + 1)) X x)
    (b : ((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ ℤ)).obj (TopCat.diskBoundary (n + 1 + 1))) :
    (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ ℤ)).map (diskBoundaryMap p)).hom b ∈
        AddSubgroup.zmultiples ((hurewicz (ModuleCat.of ℤ ℤ) p).hom 1) := by
  -- `GenLoop.diskBoundaryMap p` is `GenLoop.toSphere p` read on the lifted sphere.
  let d : TopCat.diskBoundary (n + 1 + 1) ⟶
      TopCat.of (sphere (0 : EuclideanSpace ℝ (Fin (n + 2))) 1) :=
    TopCat.ofHom ⟨ULift.down, continuous_uliftDown⟩
  have hφ : diskBoundaryMap p = d ≫ TopCat.ofHom (toSphere p) := by
    ext s
    exact diskBoundaryMap_apply p s
  have e : (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ ℤ)).map (diskBoundaryMap p)).hom b =
        (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
          (ModuleCat.of ℤ ℤ)).map (TopCat.ofHom (toSphere p))).hom
          ((((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
            (ModuleCat.of ℤ ℤ)).map d).hom b) := by
    rw [hφ]
    exact congrArg (fun g ↦ ModuleCat.Hom.hom g b)
      (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
        (ModuleCat.of ℤ ℤ)).map_comp d (TopCat.ofHom (toSphere p)))
  rw [e]
  exact singularHomologyMap_toSphere_mem_zmultiples p _

/-- The image of the universe-lifted integral homology of the boundary sphere `∂𝔻ⁿ⁺²` under the
attaching map `GenLoop.diskBoundaryMap p` of a generalized loop `p` in universe `w` is contained in
the cyclic group generated by the Hurewicz class of `p`. -/
theorem singularHomologyMap_diskBoundaryMap_ulift_mem_zmultiples {X : TopCat.{w}} {x : X}
    (p : Ω^ (Fin (n + 1)) X x)
    (b : ((singularHomologyFunctor (ModuleCat.{w} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ (ULift.{w} ℤ))).obj (TopCat.diskBoundary.{w} (n + 1 + 1))) :
    (((singularHomologyFunctor (ModuleCat.{w} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ (ULift.{w} ℤ))).map (diskBoundaryMap p)).hom b ∈
        AddSubgroup.zmultiples ((hurewicz (ModuleCat.of ℤ (ULift.{w} ℤ)) p).hom 1) := by
  set h₀ := hurewicz (ModuleCat.of ℤ (ULift.{w} ℤ)) (diskBoundaryGenLoop.{w} (n + 1))
  obtain ⟨t, rfl⟩ : ∃ t : ULift.{w} ℤ, h₀.hom t = b :=
    ⟨(inv h₀).hom b, IsIso.inv_hom_id_apply h₀ b⟩
  have ht : h₀.hom t = t.down • h₀.hom 1 := by
    conv_lhs => rw [(ULift.ext (by simp) : t = t.down • (1 : ULift.{w} ℤ))]
    exact map_zsmul h₀.hom t.down 1
  refine ⟨t.down, ?_⟩
  rw [ht, map_zsmul, hurewicz_eq_hurewicz_diskBoundaryGenLoop_comp, ModuleCat.hom_comp,
    LinearMap.comp_apply]

end GenLoop
