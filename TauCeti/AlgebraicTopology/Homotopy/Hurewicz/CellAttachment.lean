module

public import TauCeti.AlgebraicTopology.Cellular.Boundary
public import TauCeti.AlgebraicTopology.Homotopy.CellAttachment
public import TauCeti.AlgebraicTopology.Homotopy.Hurewicz.Absolute
public import TauCeti.Topology.CWComplex.Abstract.AttachCells

/-!
# The bottom homotopy group after attaching cells along spheres

Let `X` be a Hausdorff space whose homotopy groups vanish below degree `n + 2`, and attach
`(n + 3)`-cells to `X` along the pointed maps `Sⁿ⁺² → X` of a family of generalized loops
`p i : (Iⁿ⁺², ∂Iⁿ⁺²) → (X, x)`. The inclusion `X → Y` of the result is onto on `πₙ₊₂`
(`TauCeti.surjective_homotopyGroupMap_cellAttachmentIncl`), and it kills each class `[p i]`
(`TauCeti.map_cellAttachmentIncl_mk_eq_one`). This file proves that nothing else is killed: the
kernel of `πₙ₊₂(X, x) → πₙ₊₂(Y, x)` is the subgroup generated by the classes `[p i]`
(`TauCeti.ker_mapHom_cellAttachmentIncl`), so `πₙ₊₂(Y, x)` is the quotient of `πₙ₊₂(X, x)` by
these classes (`TauCeti.cellAttachmentHomotopyGroupMulEquiv`). This is the step of the
construction of an Eilenberg--MacLane space `K(A, n + 2)` from a presentation of an abelian
group `A` that attaches one cell for each relation (Hatcher, Section 4.2, the construction of
Eilenberg--MacLane spaces).

The proof goes through homology. The Hurewicz map is injective on `πₙ₊₂(X, x)`
(`HomotopyGroup.bijective_hurewicz`) and natural, so a class `g` killed in `Y` has a Hurewicz
class killed in `Hₙ₊₂(Y; ℤ)`. Read `Y` as a relative CW complex over `X` whose cells all have
dimension `n + 3` (`HomotopicalAlgebra.AttachCells.toRelativeCWComplex`): by the long exact
sequence of the pair `(Y, X)`, the Hurewicz class of `g` comes from `Hₙ₊₃(Y, X; ℤ)`, and the
connecting morphism of a skeletal pair takes values in the span of the images of the attaching
maps (`TauCeti.skeletonPairδ_mem_iSup_range`). The attaching map of the cell `i` is the pointed
map `Sⁿ⁺² → X` of `p i`
(`HomotopicalAlgebra.AttachCells.coe_cellAttachingMap_toRelCWComplex_apply`), whose image in
homology lies in the cyclic group generated by the Hurewicz class of `p i`
(`GenLoop.singularHomologyMap_diskBoundaryMap_mem_zmultiples`). So the Hurewicz class of `g` lies
in the subgroup generated by the Hurewicz classes of the `p i`, and injectivity of the Hurewicz
map puts `g` in the subgroup generated by the `[p i]`.

## Main results

* `TauCeti.ker_singularHomologyMap_cellAttachmentIncl_le`: with any module coefficients, the
  homology classes of `X` killed by attaching `(m + 1)`-cells are sums of images of classes of the
  attaching spheres.
* `TauCeti.ker_mapHom_cellAttachmentIncl`: attaching `(n + 3)`-cells along the generalized loops
  `p i` of an `(n + 1)`-connected Hausdorff space kills exactly the subgroup of `πₙ₊₂` generated
  by their classes.
* `TauCeti.cellAttachmentHomotopyGroupMulEquiv`: the resulting presentation of `πₙ₊₂` of the
  cell attachment as a quotient.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 4.2, Theorem 4.32 (the Hurewicz theorem) and the construction of Eilenberg--MacLane
  spaces `K(G, n)` from a presentation of `G`.
-/

public section

noncomputable section

open CategoryTheory Topology Set Topology.RelCWComplex
open scoped Topology.Homotopy

universe u

namespace TauCeti

section Homology

variable {k : Type u} [Ring k] (M : ModuleCat.{u} k) {X : TopCat.{u}} [T2Space X] {ι : Type u}
  {m : ℕ}

/-- **The homology killed by attaching cells comes from the attaching spheres.** If `Y` is obtained
from a Hausdorff space `X` by attaching `(m + 1)`-cells along maps `φ i : Sᵐ → X`, every class of
`Hₘ(X; M)` that dies in `Hₘ(Y; M)` is a sum of images of classes of the spheres under the `φ i`. -/
theorem ker_singularHomologyMap_cellAttachmentIncl_le
    (φ : ι → (TopCat.diskBoundary (m + 1) ⟶ X)) :
    LinearMap.ker (((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{u} k) m).obj M).map
      (cellAttachmentIncl φ)).hom ≤
        ⨆ i, LinearMap.range
          (((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{u} k) m).obj M).map
            (φ i)).hom := by
  set F := (AlgebraicTopology.singularHomologyFunctor (ModuleCat.{u} k) m).obj M
  intro a ha
  rw [LinearMap.mem_ker] at ha
  -- Read `Y` as a classical relative CW complex over `X`, all of whose cells have dimension
  -- `m + 1`: its skeleta are `X` below the cells and `Y` above them.
  let c := cellAttachmentAttachCells φ
  let _ := c.toRelativeCWComplex.toRelCWComplex
  have hD := c.skeletonLT_toRelCWComplex (m := m + 1) le_rfl
  have hY := c.skeletonLT_toRelCWComplex_eq_univ (m := m + 1 + 1) (by omega)
  let eIso : X ≅ skeletonObj (univ : Set (cellAttachment φ)) (m + 1) := TopCat.isoOfHomeo
    ((isClosedEmbedding_cellAttachmentIncl φ).isEmbedding.toHomeomorph.trans
      (Homeomorph.setCongr hD.symm))
  let jIso : skeletonObj (univ : Set (cellAttachment φ)) (m + 1 + 1) ≅ cellAttachment φ :=
    TopCat.isoOfHomeo ((Homeomorph.setCongr hY).trans (Homeomorph.Set.univ _))
  -- The class dies in the top skeleton, which is `Y` itself.
  have h₁ : (F.map (skeletonPair (univ : Set (cellAttachment φ)) (m + 1)).map).hom
      ((F.map eIso.hom).hom a) = 0 := by
    refine (ModuleCat.mono_iff_injective (F.map jIso.hom)).1 inferInstance ?_
    calc _ = (F.map (eIso.hom ≫ (skeletonPair (univ : Set (cellAttachment φ)) (m + 1)).map ≫
          jIso.hom)).hom a :=
          (congrArg (fun t ↦ ModuleCat.Hom.hom t a)
            ((F.map_comp _ _).trans (congrArg (_ ≫ ·) (F.map_comp _ _)))).symm
      -- `eIso` followed by the inclusions of skeleta is the inclusion of `X`, by definition.
      _ = (F.map (cellAttachmentIncl φ)).hom a := rfl
      _ = _ := ha.trans (map_zero _).symm
  -- By exactness it comes from the cellular chains of dimension `m + 1`, so it lies in the span
  -- of the images of the classical attaching maps.
  obtain ⟨y, hy⟩ := (ShortComplex.moduleCat_exact_iff _).1
    (TopPair.singularHomology_exact_subspace (skeletonPair (univ : Set (cellAttachment φ))
      (m + 1)) M (m + 1) m) _ h₁
  -- The classical attaching map of a cell is the attaching map of the corresponding cell of `c`.
  have hatt (j : cell (univ : Set (cellAttachment φ)) (m + 1)) :
      cellAttachingMap j = φ (c.cellToRelCWComplexEquiv j) ≫ eIso.hom := by
    ext z
    have hb := ConcreteCategory.congr_hom
      (cellAttachment_boundary φ (c.cellToRelCWComplexEquiv j)) z
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply] at hb
    -- `c` is a local definition, so its cells are rewritten with `cellAttachmentAttachCells_cell`.
    rw [c.coe_cellAttachingMap_toRelCWComplex_apply,
      show c.cell (c.cellToRelCWComplexEquiv j) =
        cellAttachmentCell φ (c.cellToRelCWComplexEquiv j) from cellAttachmentAttachCells_cell φ _,
      ← hb]
    -- `eIso` is the corestriction of the inclusion of `X`, by definition.
    rfl
  have h₂ : (⨆ j : cell (univ : Set (cellAttachment φ)) (m + 1), LinearMap.range
      (SSet.homologyMap (TopCat.toSSet.map (cellAttachingMap j)) M m).hom) ≤
        (⨆ i, LinearMap.range (F.map (φ i)).hom).map (F.map eIso.hom).hom := by
    refine iSup_le fun j ↦ ?_
    rintro _ ⟨b, rfl⟩
    refine ⟨(F.map (φ (c.cellToRelCWComplexEquiv j))).hom b,
      Submodule.mem_iSup_of_mem _ (LinearMap.mem_range_self _ b), ?_⟩
    rw [hatt j]
    exact (congrArg (fun t ↦ ModuleCat.Hom.hom t b) (F.map_comp _ _)).symm
  obtain ⟨a', ha', hea⟩ := h₂ (hy ▸ skeletonPairδ_mem_iSup_range _ M m y)
  obtain rfl := (ModuleCat.mono_iff_injective (F.map eIso.hom)).1 inferInstance hea
  exact SetLike.mem_coe.1 ha'

end Homology

section HomotopyGroup

variable {X : TopCat.{0}} [T2Space X] {x : X} {ι : Type} {n : ℕ}

/-- **Attaching cells along spheres kills exactly their classes.** Let `X` be a Hausdorff space
whose homotopy groups `πₖ(X, x)` vanish for `k < n + 2`, and attach `(n + 3)`-cells along the
pointed maps `Sⁿ⁺² → X` of generalized loops `p i`. Then the kernel of
`πₙ₊₂(X, x) → πₙ₊₂(X ∪ eⁿ⁺³, x)` is the subgroup generated by the classes of the `p i`. -/
theorem ker_mapHom_cellAttachmentIncl
    (hX : ∀ k < n + 2, Subsingleton (HomotopyGroup (Fin k) X x))
    (p : ι → Ω^ (Fin (n + 2)) X x) :
    (HomotopyGroup.mapHom (N := Fin (n + 2)) (x := x)
      (cellAttachmentIncl fun i ↦ _root_.GenLoop.diskBoundaryMap (p i)).hom rfl).ker =
      Subgroup.closure (G := HomotopyGroup (Fin (n + 2)) X x) (range fun i ↦ ⟦p i⟧) := by
  set φ : ι → (TopCat.diskBoundary (n + 2 + 1) ⟶ X) :=
    fun i ↦ _root_.GenLoop.diskBoundaryMap (p i)
  refine le_antisymm (fun g hg ↦ ?_) ((Subgroup.closure_le _).2 ?_)
  swap
  · rintro _ ⟨i, rfl⟩
    exact map_cellAttachmentIncl_mk_eq_one φ rfl
  set F := (AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1 + 1)).obj
    (ModuleCat.of ℤ ℤ)
  set h := HomotopyGroup.hurewiczAddEquiv hX
  set G := Subgroup.closure (G := HomotopyGroup (Fin (n + 2)) X x) (range fun i ↦ ⟦p i⟧)
  have hh (a : HomotopyGroup (Fin (n + 2)) X x) :
      h (Additive.ofMul a) = (HomotopyGroup.hurewicz (ModuleCat.of ℤ ℤ) (n + 1) a).hom 1 := by
    rw [HomotopyGroup.hurewiczAddEquiv_apply, HomotopyGroup.hurewiczHom_apply, toMul_ofMul]
  -- The Hurewicz class of `g` dies in `Y`.
  have h₁ : (F.map (cellAttachmentIncl φ)).hom (h (Additive.ofMul g)) = 0 := by
    have hmap := HomotopyGroup.hurewicz_map (ModuleCat.of ℤ ℤ) (n + 1)
      (cellAttachmentIncl φ).hom rfl g
    rw [← HomotopyGroup.mapHom_apply, MonoidHom.mem_ker.1 hg, HomotopyGroup.hurewicz_one] at hmap
    rw [hh]
    exact (congrArg (fun t ↦ ModuleCat.Hom.hom t (1 : ℤ)) hmap).symm
  -- So it is a sum of images of attaching spheres, each a multiple of the class of a loop.
  have h₂ : h (Additive.ofMul g) ∈ G.toAddSubgroup.map h.toAddMonoidHom := by
    refine Submodule.iSup_induction _ (motive := (· ∈ G.toAddSubgroup.map h.toAddMonoidHom))
      (ker_singularHomologyMap_cellAttachmentIncl_le (ModuleCat.of ℤ ℤ) φ h₁) ?_ (zero_mem _)
      fun _ _ ↦ add_mem
    rintro i _ ⟨b, rfl⟩
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1
      (_root_.GenLoop.singularHomologyMap_diskBoundaryMap_mem_zmultiples (p i) b)
    have e : h (Additive.ofMul (⟦p i⟧ : HomotopyGroup (Fin (n + 2)) X x)) =
        (_root_.GenLoop.hurewicz (ModuleCat.of ℤ ℤ) (p i)).hom 1 :=
      (hh _).trans (congrArg (fun t ↦ ModuleCat.Hom.hom t (1 : ℤ))
        (HomotopyGroup.hurewicz_mk (ModuleCat.of ℤ ℤ) (n + 1) (p i)))
    have hp : (_root_.GenLoop.hurewicz (ModuleCat.of ℤ ℤ) (p i)).hom 1 ∈
        G.toAddSubgroup.map h.toAddMonoidHom :=
      e ▸ AddSubgroup.mem_map.2
        ⟨_, (Additive.mem_toAddSubgroup _ _).2 (Subgroup.subset_closure ⟨i, rfl⟩), rfl⟩
    exact hk ▸ zsmul_mem hp k
  -- The Hurewicz map is injective.
  obtain ⟨g', hg', hgg'⟩ := AddSubgroup.mem_map.1 h₂
  obtain rfl := h.injective hgg'
  exact (Additive.mem_toAddSubgroup _ _).1 hg'

/-- **Attaching cells along spheres presents `πₙ₊₂` as a quotient.** For a Hausdorff space `X`
whose homotopy groups `πₖ(X, x)` vanish for `k < n + 2`, attaching `(n + 3)`-cells along the
pointed maps `Sⁿ⁺² → X` of generalized loops `p i` gives a space whose `πₙ₊₂` is the quotient of
`πₙ₊₂(X, x)` by the subgroup generated by the classes of the `p i`, through the inclusion. -/
def cellAttachmentHomotopyGroupMulEquiv
    (hX : ∀ k < n + 2, Subsingleton (HomotopyGroup (Fin k) X x))
    (p : ι → Ω^ (Fin (n + 2)) X x) :
    HomotopyGroup (Fin (n + 2)) X x ⧸
        Subgroup.closure (G := HomotopyGroup (Fin (n + 2)) X x) (range fun i ↦ ⟦p i⟧) ≃*
      HomotopyGroup (Fin (n + 2)) (cellAttachment fun i ↦ _root_.GenLoop.diskBoundaryMap (p i))
        (cellAttachmentIncl (fun i ↦ _root_.GenLoop.diskBoundaryMap (p i)) x) :=
  (QuotientGroup.quotientMulEquivOfEq (ker_mapHom_cellAttachmentIncl hX p).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective _
      (surjective_homotopyGroupMap_cellAttachmentIncl _ (N := Fin (n + 2)) (by simp) x))

@[simp]
theorem cellAttachmentHomotopyGroupMulEquiv_mk
    (hX : ∀ k < n + 2, Subsingleton (HomotopyGroup (Fin k) X x))
    (p : ι → Ω^ (Fin (n + 2)) X x) (a : HomotopyGroup (Fin (n + 2)) X x) :
    cellAttachmentHomotopyGroupMulEquiv hX p a =
      HomotopyGroup.map (cellAttachmentIncl fun i ↦ _root_.GenLoop.diskBoundaryMap (p i)).hom rfl
        a := by
  rw [cellAttachmentHomotopyGroupMulEquiv, MulEquiv.trans_apply,
    QuotientGroup.quotientMulEquivOfEq_mk]
  exact QuotientGroup.kerLift_mk (HomotopyGroup.mapHom (N := Fin (n + 2)) (x := x)
    (cellAttachmentIncl fun i ↦ _root_.GenLoop.diskBoundaryMap (p i)).hom rfl) a

end HomotopyGroup

end TauCeti
