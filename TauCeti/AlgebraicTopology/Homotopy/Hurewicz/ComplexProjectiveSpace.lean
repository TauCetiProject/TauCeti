module

public import TauCeti.AlgebraicTopology.Homotopy.Hurewicz.Spherical
public import TauCeti.Topology.ComplexProjectiveSpace.Hopf.Exact
import TauCeti.Topology.Homotopy.HomotopyGroup.Basic

/-!
# The second integral homology of complex projective space

Complex projective space `CPⁿ` is simply connected
(`TauCeti.ComplexProjectiveSpace.instSimplyConnectedSpace`), so by the Hurewicz theorem the
integral Hurewicz homomorphism `π₂(CPⁿ) → H₂(CPⁿ; ℤ)` is an isomorphism at every base point
(`TauCeti.ComplexProjectiveSpace.bijective_hurewiczIntHom`), and every class of `H₂(CPⁿ; ℤ)` is
spherical (`TauCeti.sphericalClasses_complexProjectiveSpace_eq_top`). For `n ≥ 1` the boundary
map of the Hopf fibration identifies `π₂(CPⁿ)` with `π₁(S¹) ≅ ℤ`
(`TauCeti.ComplexProjectiveSpace.pi2MulEquivInt`), so `H₂(CPⁿ; ℤ)` is infinite cyclic,
generated by the Hurewicz class of the generator of `π₂(CPⁿ)`
(`TauCeti.ComplexProjectiveSpace.zmultiples_hurewiczIntHom_pi2MulEquivInt_symm`).

This is the form in which the period group of capped Hamiltonian Floer theory on `CPⁿ` is
generated by a single sphere (`TauCeti.Geometry.Symplectic.Floer.Examples.ComplexProjectiveSpace`),
as on the two-sphere (`TauCeti.Geometry.Symplectic.Floer.Examples.Sphere`).

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 4.2 (the Hurewicz theorem, Theorem 4.32, and the long exact sequence of the Hopf
  fibration `S¹ → S²ⁿ⁺¹ → CPⁿ`).
-/

public section

open AlgebraicTopology HomotopyGroup Metric

namespace TauCeti.ComplexProjectiveSpace

variable {n : ℕ}

/-- **The Hurewicz isomorphism of `CPⁿ` in degree two**: the integral Hurewicz homomorphism
`π₂(CPⁿ, p) → H₂(CPⁿ; ℤ)` is bijective at every base point. -/
theorem bijective_hurewiczIntHom (p : ComplexProjectiveSpace n) :
    Function.Bijective (hurewiczIntHom (ComplexProjectiveSpace n) p 1) := by
  convert (hurewiczAddEquiv (n := 0) fun _ => subsingleton_homotopyGroup_of_lt_two p).bijective
    using 1
  funext a
  exact (hurewiczAddEquiv_apply_eq_hurewiczIntHom _ a).symm

/-- **`H₂(CPⁿ; ℤ)` is generated by the Hurewicz class of the generator of `π₂(CPⁿ) ≅ ℤ`**, for
`n ≥ 1`: every class is an integer multiple of the Hurewicz class of the element of `π₂(CPⁿ)`
sent to `1` by `TauCeti.ComplexProjectiveSpace.pi2MulEquivInt`. -/
theorem zmultiples_hurewiczIntHom_pi2MulEquivInt_symm
    (v : sphere (0 : EuclideanSpace ℂ (Fin (n + 1))) 1) (hn : n ≠ 0) :
    AddSubgroup.zmultiples (hurewiczIntHom (ComplexProjectiveSpace n) (mk n v) 1
      (Additive.ofMul ((pi2MulEquivInt v hn).symm (Multiplicative.ofAdd 1)))) = ⊤ := by
  refine (AddSubgroup.eq_top_iff' _).2 fun A => ?_
  obtain ⟨b, rfl⟩ := (bijective_hurewiczIntHom (mk n v)).2 A
  refine AddSubgroup.mem_zmultiples_iff.2
    ⟨Multiplicative.toAdd (pi2MulEquivInt v hn b.toMul), ?_⟩
  rw [← map_zsmul]
  congr 1
  -- `b` is the power of the generator given by its integer coordinate.
  simp [← ofMul_zpow, ← map_zpow, ← ofAdd_zsmul]

end TauCeti.ComplexProjectiveSpace

namespace TauCeti

/-- **Every class of `H₂(CPⁿ; ℤ)` is spherical.** -/
@[simp]
theorem sphericalClasses_complexProjectiveSpace_eq_top (n : ℕ) :
    sphericalClasses (ComplexProjectiveSpace n) 1 = ⊤ :=
  sphericalClasses_eq_top (n := 0) fun _ =>
    subsingleton_homotopyGroup_of_lt_two (Classical.arbitrary (ComplexProjectiveSpace n))

end TauCeti
