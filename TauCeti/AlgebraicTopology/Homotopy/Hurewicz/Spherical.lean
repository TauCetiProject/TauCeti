module

public import TauCeti.AlgebraicTopology.Homotopy.Hurewicz.Absolute

/-!
# Spherical homology classes

The *spherical classes* of a space `X` form the subgroup of `Hₙ₊₁(X; ℤ)` generated by the images
of the fundamental class of the sphere under maps `Sⁿ⁺¹ → X`, that is, by the images of the
Hurewicz homomorphisms `πₙ₊₁(X, x) → Hₙ₊₁(X; ℤ)` at all base points `x`. On a disconnected space
a spherical class need not be the image of a single sphere: it can be a sum of such images from
different path components. This file defines the subgroup of spherical classes.

* The Hurewicz class does not depend on the base point: the images of the Hurewicz
  homomorphisms at two points joined by a path coincide
  (`HomotopyGroup.range_hurewiczIntHom_eq_of_joined`, proved alongside the sphere representation
  of Hurewicz classes).
* `TauCeti.sphericalClasses X n` is the subgroup of `Hₙ₊₁(X; ℤ)` generated by the images of the
  Hurewicz homomorphisms at all base points. On a path-connected space it is the image of the
  Hurewicz homomorphism at any single base point (`TauCeti.sphericalClasses_eq_range`), so its
  elements are exactly the Hurewicz classes of elements of `πₙ₊₁(X, x)`. On a disconnected space
  it is generated by the spherical classes of the path components.
* Spherical classes are natural: a continuous map sends spherical classes to spherical classes
  (`TauCeti.map_mem_sphericalClasses`), and so induces a homomorphism of the groups of spherical
  classes (`TauCeti.sphericalClassesMap`).
* By the Hurewicz theorem, every class in `Hₙ₊₂(X; ℤ)` of an `(n + 1)`-connected space is
  spherical (`TauCeti.sphericalClasses_eq_top`).

In degree two these are the spherical classes over which the periods of capped Hamiltonian Floer
theory are taken: two caps of a contractible loop differ by a sphere.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 4.1, the change of base point for higher homotopy groups, and Section 4.2, the Hurewicz
  map and spherical homology classes.
* D. McDuff and D. Salamon, *J-holomorphic curves and symplectic topology*, Section 11.1, on
  spherical classes and the Novikov ring of a symplectic manifold.
-/

public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicTopology Metric Topology
open scoped unitInterval Topology.Homotopy

namespace TauCeti

open HomotopyGroup

variable {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]

variable (X) in
/-- The subgroup of **spherical classes** in `Hₙ₊₁(X; ℤ)`: the subgroup generated by the images of
the integral Hurewicz homomorphisms `πₙ₊₁(X, x) → Hₙ₊₁(X; ℤ)` at all base points `x`. On a
path-connected space it is the image of the Hurewicz homomorphism at any base point
(`TauCeti.sphericalClasses_eq_range`). -/
def sphericalClasses (n : ℕ) :
    AddSubgroup (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ ℤ)).obj (TopCat.of X)) :=
  ⨆ x : X, (hurewiczIntHom X x n).range

/-- The Hurewicz class of an element of `πₙ₊₁(X, x)` is spherical. -/
@[simp]
theorem hurewiczIntHom_mem_sphericalClasses {n : ℕ} (x : X)
    (a : Additive (HomotopyGroup (Fin (n + 1)) X x)) :
    hurewiczIntHom X x n a ∈ sphericalClasses X n :=
  AddSubgroup.mem_iSup_of_mem x ⟨a, rfl⟩

/-- The image of the Hurewicz homomorphism at any base point consists of spherical classes. -/
theorem range_hurewiczIntHom_le_sphericalClasses (x : X) (n : ℕ) :
    (hurewiczIntHom X x n).range ≤ sphericalClasses X n :=
  le_iSup (fun x : X ↦ (hurewiczIntHom X x n).range) x

/-- A subgroup contains the spherical classes exactly when it contains the Hurewicz classes of the
elements of all homotopy groups `πₙ₊₁(X, x)`. -/
theorem sphericalClasses_le_iff {n : ℕ}
    {G : AddSubgroup (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ ℤ)).obj (TopCat.of X))} :
    sphericalClasses X n ≤ G ↔ ∀ x a, hurewiczIntHom X x n a ∈ G := by
  simp only [sphericalClasses, iSup_le_iff]
  exact forall_congr' fun x ↦ ⟨fun h a ↦ h ⟨a, rfl⟩, fun h _ ⟨a, ha⟩ ↦ ha ▸ h a⟩

/-- **On a path-connected space the spherical classes are the image of the Hurewicz homomorphism
at any base point.** -/
theorem sphericalClasses_eq_range [PathConnectedSpace X] (x : X) (n : ℕ) :
    sphericalClasses X n = (hurewiczIntHom X x n).range :=
  le_antisymm (iSup_le fun y ↦ (range_hurewiczIntHom_eq_of_joined
    (PathConnectedSpace.joined y x) n).le) (range_hurewiczIntHom_le_sphericalClasses x n)

/-- On a path-connected space, a class is spherical exactly when it is the Hurewicz class of an
element of `πₙ₊₁(X, x)`, for any base point `x`. -/
theorem mem_sphericalClasses_iff [PathConnectedSpace X] (x : X) {n : ℕ}
    {c : ((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj (ModuleCat.of ℤ ℤ)).obj
      (TopCat.of X)} :
    c ∈ sphericalClasses X n ↔ ∃ a, hurewiczIntHom X x n a = c := by
  rw [sphericalClasses_eq_range x, AddMonoidHom.mem_range]

/-- **Naturality of spherical classes**: a continuous map sends spherical classes to spherical
classes. -/
theorem map_mem_sphericalClasses (f : C(X, Y)) {n : ℕ}
    {c : ((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj (ModuleCat.of ℤ ℤ)).obj
      (TopCat.of X)} (hc : c ∈ sphericalClasses X n) :
    (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj (ModuleCat.of ℤ ℤ)).map
      (TopCat.ofHom f)).hom c ∈ sphericalClasses Y n := by
  let f' : _ →+ _ := (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
    (ModuleCat.of ℤ ℤ)).map (TopCat.ofHom f)).hom.toAddMonoidHom
  suffices sphericalClasses X n ≤ (sphericalClasses Y n).comap f' from this hc
  refine sphericalClasses_le_iff.2 fun x a ↦ ?_
  rw [AddSubgroup.mem_comap, LinearMap.toAddMonoidHom_coe, ← ofMul_toMul a,
    ← hurewiczIntHom_map f rfl]
  exact hurewiczIntHom_mem_sphericalClasses (f x) _

/-- The homomorphism of groups of spherical classes induced by a continuous map `f : X → Y`: the
restriction of `f_* : Hₙ₊₁(X; ℤ) → Hₙ₊₁(Y; ℤ)` (`TauCeti.coe_sphericalClassesMap`), well defined
by `TauCeti.map_mem_sphericalClasses`. -/
def sphericalClassesMap (f : C(X, Y)) (n : ℕ) : sphericalClasses X n →+ sphericalClasses Y n :=
  ((((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj (ModuleCat.of ℤ ℤ)).map
    (TopCat.ofHom f)).hom.toAddMonoidHom.comp (sphericalClasses X n).subtype).codRestrict _
    fun s ↦ map_mem_sphericalClasses f s.2

@[simp]
theorem coe_sphericalClassesMap (f : C(X, Y)) {n : ℕ} (s : sphericalClasses X n) :
    (sphericalClassesMap f n s : _) = (((singularHomologyFunctor (ModuleCat.{0} ℤ) (n + 1)).obj
      (ModuleCat.of ℤ ℤ)).map (TopCat.ofHom f)).hom s :=
  (rfl)

/-- The induced homomorphism of spherical classes sends the Hurewicz class of `a` to the Hurewicz
class of `f_* a`. -/
theorem sphericalClassesMap_hurewiczIntHom (f : C(X, Y)) {n : ℕ} (x : X)
    (a : HomotopyGroup (Fin (n + 1)) X x) :
    sphericalClassesMap f n ⟨hurewiczIntHom X x n (Additive.ofMul a),
      hurewiczIntHom_mem_sphericalClasses x _⟩ =
      ⟨hurewiczIntHom Y (f x) n (Additive.ofMul (HomotopyGroup.map f rfl a)),
        hurewiczIntHom_mem_sphericalClasses (f x) _⟩ :=
  Subtype.ext (hurewiczIntHom_map f rfl a).symm

/-- **Every class of an `(n + 1)`-connected space is spherical in degree `n + 2`**, by the
Hurewicz theorem. -/
theorem sphericalClasses_eq_top {n : ℕ} {x : X}
    (hX : ∀ k < n + 2, Subsingleton (HomotopyGroup (Fin k) X x)) :
    sphericalClasses X (n + 1) = ⊤ := by
  refine eq_top_iff.2 fun c _ ↦ ?_
  obtain ⟨a, rfl⟩ := (bijective_hurewicz hX).2 c
  simpa [hurewiczIntHom_apply] using hurewiczIntHom_mem_sphericalClasses x (Additive.ofMul a)

end TauCeti
