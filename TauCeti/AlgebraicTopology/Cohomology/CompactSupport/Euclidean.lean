public import TauCeti.Analysis.Convex.Topology

/-!
# Cohomology with compact supports of a real normed space

Let `E` be a real normed space and `y : E`. Every compact subset of `E` lies in a compact set
which contains `y` and is star-convex about `y`, and for such a set `K` the inclusion
`(E, E ∖ K) ⟶ (E, E ∖ {y})` induces isomorphisms on relative singular cohomology
(`TauCeti.isIso_singularCohomologyMap_compl_of_starConvex`). So the groups `Hⁿ(E, E ∖ {y})` are
cofinal, up to isomorphism, in the diagram whose colimit is the cohomology with compact supports,
and the map `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ_c(E)` is an isomorphism. This is the base case of the proof of
Poincaré duality (Hatcher, Theorem 3.35), where the duality map of `ℝᵐ` is compared with the
local homology at a point.

Combined with the computation of local cohomology, for `E` of finite dimension `d` the group
`Hⁿ_c(E; R, N)` vanishes for `n ≠ d` when the coefficients `R` are projective, and over `ℤ` the
group `Hᵈ_c(E; ℤ)` is generated by the image of the local cohomology generator selected by an
orientation of `E`.

## Main definitions and results

* `TopCat.isIso_compactSupportCohomologyι_singleton`: `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ_c(E)` is an
  isomorphism.
* `TopCat.compactSupportCohomologyEuclideanIso`: `Hⁿ_c(E) ≅ Hⁿ(E, E ∖ {y})`.
* `TopCat.isZero_compactSupportCohomology_euclidean`: `Hⁿ_c(E; R, N) = 0` for
  `n ≠ finrank ℝ E` and projective `R`.
* `Orientation.span_compactSupportCohomologyι_localCohomologyClass`: `Hᵈ_c(E; ℤ)` is generated by
  the image of `ω.localCohomologyClass` for an orientation `ω` of `E`.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 3.3, the computation `Hⁱ_c(ℝⁿ) ≅ Hⁱ(ℝⁿ, ℝⁿ ∖ {0})` and the case `M = ℝⁿ` of the proof
  of Theorem 3.35.
-/

public section

noncomputable section

open CategoryTheory Limits TopologicalSpace Module

universe v u

namespace TopCat

/-! ### Cohomology with compact supports of a real normed space -/

variable {C : Type u} [Category.{v} C] [HasCoproducts.{v} C] [Abelian C] {R : C}
  {k : Type v} [Ring k] [Linear k C] {M : C}
  {E : Type v} [NormedAddCommGroup E] [NormedSpace ℝ E]

private lemma isIso_singularCohomologyMap_singleton_starHull (y : E)
    (K : Compacts (of E)) (n : ℕ) :
    IsIso (TopPair.singularCohomologyMap (R := R) (k := k) (M := M)
      (TopPair.ofSubsetMap (𝟙 (of E))
        (mapsTo_id_compl_compacts (Compacts.singleton_le_starHull (E := E) ℝ y K))) n) :=
  TauCeti.isIso_singularCohomologyMap_compl_of_starConvex R k M
    (Compacts.starConvex_starHull (E := E) ℝ y K) (Compacts.mem_starHull_self (E := E) ℝ y K)
    (Compacts.starHull (E := E) ℝ y K).isCompact.isBounded n

variable (R k M)

/-- **Cohomology with compact supports of a real normed space is local cohomology at a point.**
For a real normed space `E` and `y : E`, the map `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ_c(E)` is an isomorphism.
-/
instance isIso_compactSupportCohomologyι_singleton (y : E) (n : ℕ) :
    IsIso (compactSupportCohomologyι (R := R) (k := k) (M := M) (X := of E) n {y}) := by
  -- Every compact `K ⊆ E` lies in the compact union of the segments from `y` to the points of
  -- `K`, which is star-convex about `y`, and for such sets the restriction
  -- `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ(E, E ∖ K)` is an isomorphism.
  rw [ConcreteCategory.isIso_iff_bijective]
  refine ⟨(injective_iff_map_eq_zero _).2 fun z hz ↦ ?_, fun x ↦ ?_⟩
  · obtain ⟨L, hL, hzL⟩ := (compactSupportCohomologyι_eq_zero_iff z).1 hz
    have := isIso_singularCohomologyMap_singleton_starHull (R := R) (k := k)
      (M := M) y L n
    refine (injective_iff_map_eq_zero _).1
      ((ConcreteCategory.bijective_of_isIso (TopPair.singularCohomologyMap (R := R) (k := k)
        (M := M) (TopPair.ofSubsetMap (𝟙 (of E))
          (mapsTo_id_compl_compacts (Compacts.singleton_le_starHull (E := E) ℝ y L))) n)).1) z ?_
    rw [← singularCohomologyMap_ofSubsetMap_id_trans hL (Compacts.le_starHull (E := E) ℝ y L),
      ConcreteCategory.comp_apply, hzL, map_zero]
  · obtain ⟨L, -, w, rfl⟩ := exists_compactSupportCohomologyι_eq x {y}
    have := isIso_singularCohomologyMap_singleton_starHull (R := R) (k := k)
      (M := M) y L n
    obtain ⟨z, hz⟩ := (ConcreteCategory.bijective_of_isIso (TopPair.singularCohomologyMap
      (R := R) (k := k) (M := M) (TopPair.ofSubsetMap (𝟙 (of E))
        (mapsTo_id_compl_compacts (Compacts.singleton_le_starHull (E := E) ℝ y L))) n)).2
      (TopPair.singularCohomologyMap (TopPair.ofSubsetMap (𝟙 (of E))
        (mapsTo_id_compl_compacts (Compacts.le_starHull (E := E) ℝ y L))) n w)
    refine ⟨z, ?_⟩
    rw [← singularCohomologyMap_comp_compactSupportCohomologyι_apply n
      (Compacts.singleton_le_starHull (E := E) ℝ y L), hz,
      singularCohomologyMap_comp_compactSupportCohomologyι_apply n
        (Compacts.le_starHull (E := E) ℝ y L)]

/-- **Cohomology with compact supports of a real normed space**: `Hⁿ_c(E) ≅ Hⁿ(E, E ∖ {y})` for
every point `y : E`, the inverse of the isomorphism `compactSupportCohomologyι` from the local
cohomology at `y` (`TopCat.isIso_compactSupportCohomologyι_singleton`). -/
def compactSupportCohomologyEuclideanIso (y : E) (n : ℕ) :
    (of E).compactSupportCohomology R k M n ≅
      (TopPair.ofSubset ({y}ᶜ : Set (of E))).singularCohomology R k M n :=
  (asIso (compactSupportCohomologyι (R := R) (k := k) (M := M) (X := of E) n {y})).symm

@[reassoc (attr := simp)]
lemma compactSupportCohomologyι_compactSupportCohomologyEuclideanIso_hom (y : E) (n : ℕ) :
    compactSupportCohomologyι (X := of E) n ({y} : Compacts E) ≫
        (compactSupportCohomologyEuclideanIso R k M y n).hom = 𝟙 _ := by
  simp [compactSupportCohomologyEuclideanIso]

@[reassoc (attr := simp)]
lemma compactSupportCohomologyEuclideanIso_hom_compactSupportCohomologyι (y : E) (n : ℕ) :
    (compactSupportCohomologyEuclideanIso R k M y n).hom ≫
        compactSupportCohomologyι (X := of E) n ({y} : Compacts E) = 𝟙 _ := by
  simp [compactSupportCohomologyEuclideanIso]

@[simp]
lemma compactSupportCohomologyEuclideanIso_inv (y : E) (n : ℕ) :
    (compactSupportCohomologyEuclideanIso R k M y n).inv =
      compactSupportCohomologyι (X := of E) n ({y} : Compacts E) :=
  (rfl)

/-- Every class with compact support on a real normed space comes from the local cohomology at
any given point. -/
lemma compactSupportCohomologyι_singleton_surjective (y : E) (n : ℕ) :
    Function.Surjective (compactSupportCohomologyι (R := R) (k := k) (M := M)
      (X := of E) n {y}) :=
  (ConcreteCategory.bijective_of_isIso _).2

/-! ### Vanishing and generators -/

section Vanishing

variable {k : Type v} [CommRing k] (R N : ModuleCat.{v} k) [Module.Projective k R]
  {E : Type v} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- **Cohomology with compact supports of a finite-dimensional real normed space vanishes outside
the dimension**: `Hⁿ_c(E; R, N) = 0` for `n ≠ finrank ℝ E`, for projective coefficients `R` and
any coefficient module `N`. -/
theorem isZero_compactSupportCohomology_euclidean {n : ℕ} (h : n ≠ finrank ℝ E) :
    IsZero ((of E).compactSupportCohomology R k N n) :=
  (TauCeti.isZero_singularCohomology_complSingleton_of_ne R N (OpenPartialHomeomorph.refl E)
    (x := 0) (Set.mem_univ _) rfl h).of_iso (compactSupportCohomologyEuclideanIso R k N 0 n)

end Vanishing

end TopCat

namespace Orientation

variable {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] {n : ℕ}

/-- **The integral generator of top cohomology with compact supports.** For a real normed space
`F` of dimension `n + 1` and an orientation `ω` of `F`, the group `Hⁿ⁺¹_c(F; ℤ)` is generated by
the image of the local cohomology generator `ω.localCohomologyClass hF` of
`Hⁿ⁺¹(F, F ∖ {0}; ℤ)`. -/
theorem span_compactSupportCohomologyι_localCohomologyClass (ω : Orientation ℝ F (Fin (n + 1)))
    (hF : finrank ℝ F = n + 1) :
    Submodule.span ℤ {(TopCat.compactSupportCohomologyι (R := ModuleCat.of ℤ (ULift.{0} ℤ))
      (k := ℤ) (M := ModuleCat.of ℤ (ULift.{0} ℤ)) (X := TopCat.of F) (n + 1) {0}
        (ω.localCohomologyClass hF))} = ⊤ := by
  rw [← Set.image_singleton, ← Submodule.map_span, ω.span_localCohomologyClass hF,
    Submodule.map_top, LinearMap.range_eq_top]
  exact TopCat.compactSupportCohomologyι_singleton_surjective _ _ _ _ _

end Orientation
