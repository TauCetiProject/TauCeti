module

public import TauCeti.AlgebraicTopology.Cohomology.CompactSupport.Extension
public import TauCeti.AlgebraicTopology.Cohomology.Local.Orientation
public import TauCeti.Analysis.Convex.Topology

/-!
# Cohomology with compact supports of a real normed space

Let `E` be a real normed space and `y : E`. Every compact subset of `E` lies in a compact set
which contains `y` and is star-convex about `y`, and for such a set `K` the inclusion
`(E, E ∖ K) ⟶ (E, E ∖ {y})` induces isomorphisms on relative singular cohomology
(`TauCeti.isIso_singularCohomologyMap_compl_of_starConvex`). So the groups `Hⁿ(E, E ∖ {y})` are
cofinal, up to isomorphism, in the diagram whose colimit is the cohomology with compact supports,
and the map `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ_c(E)` is an isomorphism. This is the base case of the proof of
Poincaré duality (Hatcher, Theorem 3.35), where the duality map of `ℝᵐ` is compared with the
local homology at a point.

The same holds for a nonempty space `U` with an open embedding `j : U ⟶ E` whose image is
star-convex about `y`: the compact subsets `K` of `U` whose image `j(K)` contains `y` and is
star-convex about it are cofinal among the compact subsets of `U`, and for them
`Hⁿ(U, U ∖ K) ≅ Hⁿ(E, E ∖ j(K)) ≅ Hⁿ_c(E)`, so extension by zero `Hⁿ_c(U) ⟶ Hⁿ_c(E)` is an
isomorphism (`TopCat.isIso_compactSupportCohomologyExtend_of_starConvex`).

Combined with the computation of local cohomology, for `E` of finite dimension `d` the group
`Hⁿ_c(E; R, N)` vanishes for `n ≠ d` when the coefficients `R` are projective, and so does
`Hⁿ_c(U; R, N)` for every space `U` with an open embedding into `E` whose image is star-convex or
convex. Over `ℤ` the group `Hᵈ_c(E; ℤ)` is generated by the image of the local cohomology
generator selected by an orientation of `E`.

## Main definitions and results

* `TopCat.isIso_compactSupportCohomologyι_singleton`: `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ_c(E)` is an
  isomorphism.
* `TopCat.compactSupportCohomologyEuclideanIso`: `Hⁿ_c(E) ≅ Hⁿ(E, E ∖ {y})`.
* `TopCat.isIso_compactSupportCohomologyι_of_starConvex`: `Hⁿ(E, E ∖ K) ⟶ Hⁿ_c(E)` is an
  isomorphism for a compact `K` containing `y` and star-convex about it.
* `TopCat.isIso_compactSupportCohomologyExtend_of_starConvex`: `Hⁿ_c(U) ⟶ Hⁿ_c(E)` is an
  isomorphism for a nonempty space `U` with an open embedding into `E` whose image is star-convex.
* `TopCat.isZero_compactSupportCohomology_euclidean`: `Hⁿ_c(E; R, N) = 0` for
  `n ≠ finrank ℝ E` and projective `R`.
* `TopCat.isZero_compactSupportCohomology_of_starConvex`,
  `TopCat.isZero_compactSupportCohomology_of_convex`: `Hⁿ_c(U; R, N) = 0` for `n ≠ finrank ℝ E`
  and projective `R`, for a space `U` with an open embedding into `E` whose image is star-convex
  or convex.
* `Orientation.span_compactSupportCohomologyι_localCohomologyClass`: `Hᵈ_c(E; ℤ)` is generated by
  the image of `ω.localCohomologyClass` for an orientation `ω` of `E`.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 3.3, the computation `Hⁱ_c(ℝⁿ) ≅ Hⁱ(ℝⁿ, ℝⁿ ∖ {0})`, the case `M = ℝⁿ` of the proof
  of Theorem 3.35, and the convex open sets of the proof of Lemma 3.36.
-/

public section

noncomputable section

open CategoryTheory Limits TopologicalSpace Topology Module

universe v u

namespace TopCat

/-! ### Cohomology with compact supports of a real normed space -/

variable {C : Type u} [Category.{v} C] [HasCoproducts.{v} C] [Abelian C] {R : C}
  {k : Type v} [Ring k] [Linear k C] {M : C}
  {E : Type v} [NormedAddCommGroup E] [NormedSpace ℝ E]

private lemma isIso_singularCohomologyMap_singleton_starHull (y : E)
    (K : Compacts (of E)) (n : ℕ) :
    IsIso (TopPair.singularCohomologyMap (R := R) (k := k) (M := M)
      (TopPair.ofSubsetMap (𝟙 (of E))
        (mapsTo_id_compl_compacts (Compacts.singleton_le_starHull (E := E) ℝ y K))) n) :=
  TauCeti.isIso_singularCohomologyMap_compl_of_starConvex R k M
    (Compacts.starConvex_starHull (E := E) ℝ y K) (Compacts.mem_starHull_self (E := E) ℝ y K)
    (Compacts.starHull (E := E) ℝ y K).isCompact.isBounded n

variable (R k M)

/-- **Cohomology with compact supports of a real normed space is local cohomology at a point.**
For a real normed space `E` and `y : E`, the map `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ_c(E)` is an isomorphism.
-/
instance isIso_compactSupportCohomologyι_singleton (y : E) (n : ℕ) :
    IsIso (compactSupportCohomologyι (R := R) (k := k) (M := M) (X := of E) n {y}) :=
  -- Every compact `K ⊆ E` lies in the compact union of the segments from `y` to the points of
  -- `K`, which is star-convex about `y`, and for such sets the restriction
  -- `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ(E, E ∖ K)` is an isomorphism.
  isIso_compactSupportCohomologyι_of_forall_exists fun L ↦
    ⟨Compacts.starHull ℝ y L, Compacts.singleton_le_starHull ℝ y L, Compacts.le_starHull ℝ y L,
      isIso_singularCohomologyMap_singleton_starHull (R := R) (k := k) (M := M) y L n⟩

/-- **Cohomology with compact supports of a real normed space**: `Hⁿ_c(E) ≅ Hⁿ(E, E ∖ {y})` for
every point `y : E`, the inverse of the isomorphism `compactSupportCohomologyι` from the local
cohomology at `y` (`TopCat.isIso_compactSupportCohomologyι_singleton`). -/
def compactSupportCohomologyEuclideanIso (y : E) (n : ℕ) :
    (of E).compactSupportCohomology R k M n ≅
      (TopPair.ofSubset ({y}ᶜ : Set (of E))).singularCohomology R k M n :=
  (asIso (compactSupportCohomologyι (R := R) (k := k) (M := M) (X := of E) n {y})).symm

@[reassoc (attr := simp)]
lemma compactSupportCohomologyι_compactSupportCohomologyEuclideanIso_hom (y : E) (n : ℕ) :
    compactSupportCohomologyι (X := of E) n ({y} : Compacts E) ≫
        (compactSupportCohomologyEuclideanIso R k M y n).hom = 𝟙 _ := by
  simp [compactSupportCohomologyEuclideanIso]

@[reassoc (attr := simp)]
lemma compactSupportCohomologyEuclideanIso_hom_compactSupportCohomologyι (y : E) (n : ℕ) :
    (compactSupportCohomologyEuclideanIso R k M y n).hom ≫
        compactSupportCohomologyι (X := of E) n ({y} : Compacts E) = 𝟙 _ := by
  simp [compactSupportCohomologyEuclideanIso]

@[simp]
lemma compactSupportCohomologyEuclideanIso_inv (y : E) (n : ℕ) :
    (compactSupportCohomologyEuclideanIso R k M y n).inv =
      compactSupportCohomologyι (X := of E) n ({y} : Compacts E) :=
  (rfl)

/-- Every class with compact support on a real normed space comes from the local cohomology at
any given point. -/
lemma compactSupportCohomologyι_singleton_surjective (y : E) (n : ℕ) :
    Function.Surjective (compactSupportCohomologyι (R := R) (k := k) (M := M)
      (X := of E) n {y}) :=
  (ConcreteCategory.bijective_of_isIso _).2

/-- For a compact subset `K` of a real normed space which contains `y` and is star-convex about
`y`, the map `Hⁿ(E, E ∖ K) ⟶ Hⁿ_c(E)` is an isomorphism. -/
theorem isIso_compactSupportCohomologyι_of_starConvex {K : Compacts (of E)} {y : E}
    (hK : StarConvex ℝ y (K : Set E)) (hy : y ∈ (K : Set E)) (n : ℕ) :
    IsIso (compactSupportCohomologyι (R := R) (k := k) (M := M) n K) := by
  -- `Hⁿ(E, E ∖ {y}) ⟶ Hⁿ_c(E)` factors through `Hⁿ(E, E ∖ K)` by a map which is an isomorphism.
  have hyK : ({y} : Compacts (of E)) ≤ K := Compacts.singleton_le_iff.2 hy
  have := TauCeti.isIso_singularCohomologyMap_compl_of_starConvex R k M hK hy
    K.isCompact.isBounded n
  have : IsIso (TopPair.singularCohomologyMap (TopPair.ofSubsetMap (𝟙 (of E))
      (mapsTo_id_compl_compacts hyK)) n ≫
        compactSupportCohomologyι (R := R) (k := k) (M := M) n K) := by
    rw [singularCohomologyMap_comp_compactSupportCohomologyι n hyK]
    infer_instance
  exact IsIso.of_isIso_comp_left (TopPair.singularCohomologyMap (R := R) (k := k) (M := M)
    (TopPair.ofSubsetMap (𝟙 (of E)) (mapsTo_id_compl_compacts hyK)) n) _

/-! ### Star-convex open subsets -/

/-- **Cohomology with compact supports of a star-convex open subset.** For an open embedding
`j : U ⟶ E` of a nonempty space into a real normed space, with image star-convex about some point,
extension by zero `Hⁿ_c(U) ⟶ Hⁿ_c(E)` is an isomorphism. -/
theorem isIso_compactSupportCohomologyExtend_of_starConvex {U : TopCat.{v}} [Nonempty U]
    {j : U ⟶ of E} (hj : IsOpenEmbedding j) {y : E} (hU : StarConvex ℝ y (Set.range j))
    (n : ℕ) : IsIso (compactSupportCohomologyExtend (R := R) (k := k) (M := M) hj n) := by
  have hy : y ∈ Set.range j := hU.mem (Set.range_nonempty j)
  rw [ConcreteCategory.isIso_iff_bijective]
  refine ⟨(injective_iff_map_eq_zero _).2 fun x hx ↦ ?_, fun w ↦ ?_⟩
  · -- A class supported in `K₀` is supported in a compact `K ⊇ K₀` whose image `j(K)` contains
    -- `y` and is star-convex about it, and `Hⁿ(E, E ∖ j(K)) ⟶ Hⁿ_c(E)` is an isomorphism.
    obtain ⟨K₀, -, z, rfl⟩ := exists_compactSupportCohomologyι_eq x ⊥
    obtain ⟨K, hK₀K, hKy, hyK⟩ := hj.isInducing.exists_compacts_le_starConvex_image hU hy K₀
    rw [← singularCohomologyMap_comp_compactSupportCohomologyι_apply n hK₀K] at hx ⊢
    rw [← ConcreteCategory.comp_apply, compactSupportCohomologyι_comp_extend,
      ConcreteCategory.comp_apply] at hx
    have := isIso_compactSupportCohomologyι_of_starConvex R k M
      (K := K.map j j.hom.continuous) (by rwa [Compacts.coe_map]) (by rwa [Compacts.coe_map]) n
    -- Both `Hⁿ(E, E ∖ j(K)) ⟶ Hⁿ_c(E)` and `Hⁿ(U, U ∖ K) ≅ Hⁿ(E, E ∖ j(K))` are injective.
    replace hx := (injective_iff_map_eq_zero _).1 (ConcreteCategory.bijective_of_isIso _).1 _ hx
    rw [(injective_iff_map_eq_zero _).1 (ConcreteCategory.bijective_of_isIso _).1 _ hx, map_zero]
  · -- Every class of `Hⁿ_c(E)` comes from `Hⁿ(E, E ∖ {y})`, and `y` lies in the image of `j`.
    obtain ⟨a, rfl⟩ := compactSupportCohomologyι_singleton_surjective R k M y n w
    exact exists_compactSupportCohomologyExtend_eq hj
      (by simpa using Set.singleton_subset_iff.2 hy) a

/-! ### Vanishing and generators -/

section Vanishing

variable {k : Type v} [CommRing k] (R N : ModuleCat.{v} k) [Module.Projective k R]
  {E : Type v} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- **Cohomology with compact supports of a finite-dimensional real normed space vanishes outside
the dimension**: `Hⁿ_c(E; R, N) = 0` for `n ≠ finrank ℝ E`, for projective coefficients `R` and
any coefficient module `N`. -/
theorem isZero_compactSupportCohomology_euclidean {n : ℕ} (h : n ≠ finrank ℝ E) :
    IsZero ((of E).compactSupportCohomology R k N n) :=
  (TauCeti.isZero_singularCohomology_complSingleton_of_ne R N (OpenPartialHomeomorph.refl E)
    (x := 0) (Set.mem_univ _) rfl h).of_iso (compactSupportCohomologyEuclideanIso R k N 0 n)

/-- **Cohomology with compact supports of a star-convex open subset vanishes outside the
dimension**: for an open embedding `j : U ⟶ E` into a finite-dimensional real normed space with
star-convex image, `Hⁿ_c(U; R, N) = 0` for `n ≠ finrank ℝ E`, for projective coefficients `R` and
any coefficient module `N`. -/
theorem isZero_compactSupportCohomology_of_starConvex {U : TopCat.{v}} {j : U ⟶ of E}
    (hj : IsOpenEmbedding j) {y : E} (hU : StarConvex ℝ y (Set.range j)) {n : ℕ}
    (h : n ≠ finrank ℝ E) : IsZero (U.compactSupportCohomology R k N n) := by
  rcases isEmpty_or_nonempty U with hU₀ | hU₀
  · exact isZero_compactSupportCohomology_of_isEmpty R k N n
  · have := isIso_compactSupportCohomologyExtend_of_starConvex R k N hj hU n
    exact (isZero_compactSupportCohomology_euclidean R N h).of_iso
      (asIso (compactSupportCohomologyExtend hj n))

/-- **Cohomology with compact supports of a convex open subset vanishes outside the dimension**:
for an open embedding `j : U ⟶ E` into a finite-dimensional real normed space with convex image,
`Hⁿ_c(U; R, N) = 0` for `n ≠ finrank ℝ E`, for projective coefficients `R` and any coefficient
module `N`. -/
theorem isZero_compactSupportCohomology_of_convex {U : TopCat.{v}} {j : U ⟶ of E}
    (hj : IsOpenEmbedding j) (hU : Convex ℝ (Set.range j)) {n : ℕ} (h : n ≠ finrank ℝ E) :
    IsZero (U.compactSupportCohomology R k N n) := by
  rcases (Set.range j).eq_empty_or_nonempty with hU₀ | ⟨y, hy⟩
  · exact isZero_compactSupportCohomology_of_starConvex R N hj (y := 0)
      (hU₀ ▸ starConvex_empty 0) h
  · exact isZero_compactSupportCohomology_of_starConvex R N hj (hU.starConvex hy) h

end Vanishing

end TopCat

namespace Orientation

variable {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] {n : ℕ}

/-- **The integral generator of top cohomology with compact supports.** For a real normed space
`F` of dimension `n + 1` and an orientation `ω` of `F`, the group `Hⁿ⁺¹_c(F; ℤ)` is generated by
the image of the local cohomology generator `ω.localCohomologyClass hF` of
`Hⁿ⁺¹(F, F ∖ {0}; ℤ)`. -/
theorem span_compactSupportCohomologyι_localCohomologyClass (ω : Orientation ℝ F (Fin (n + 1)))
    (hF : finrank ℝ F = n + 1) :
    Submodule.span ℤ {(TopCat.compactSupportCohomologyι (R := ModuleCat.of ℤ (ULift.{0} ℤ))
      (k := ℤ) (M := ModuleCat.of ℤ (ULift.{0} ℤ)) (X := TopCat.of F) (n + 1) {0}
        (ω.localCohomologyClass hF))} = ⊤ := by
  rw [← Set.image_singleton, ← Submodule.map_span, ω.span_localCohomologyClass hF,
    Submodule.map_top, LinearMap.range_eq_top]
  exact TopCat.compactSupportCohomologyι_singleton_surjective _ _ _ _ _

end Orientation
