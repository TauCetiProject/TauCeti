open CategoryTheory Limits MonoidalCategory AlgebraicTopology TauCeti

-- The cohomology of products with spheres is developed over a commutative ring `k`, with the
-- linear structure of `ModuleCat k`; for `k = ℤ`, instance search would otherwise find the
-- `ℤ`-linear structure `Linear.preadditiveIntLinear` of a preadditive category instead.
attribute [local instance 1100] ModuleCat.instLinear

namespace AddCircle

variable (p : ℝ) [Fact (0 < p)]

/-- **The angular class of a circle**: the class `θ_p ∈ H¹(ℝ / pℤ; ℤ)` whose value on a class of
`H₁(ℝ / pℤ; ℤ)` is its winding number (`AddCircle.singularKronecker_angularClass`). It is dual to
the circuit class `AddCircle.fundamentalClass p`, and it is the integral class of the angular form
`dt_p / p`: integrating the time form `dt_p` over a class gives `p` times its pairing with `θ_p`
(`AddCircle.homologyPeriodHom_timeForm_eq_singularKronecker_angularClass_mul`). -/
def angularClass : (TopCat.of (AddCircle p)).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ
    (𝟙_ (ModuleCat.{0} ℤ)) 1 :=
  ((TopCat.of (AddCircle p)).singularKroneckerEquivOne (𝟙_ (ModuleCat.{0} ℤ))).symm
    (ModuleCat.ofHom (firstHomologyAddEquiv p).toIntLinearEquiv.toLinearMap)

/-- The angular class evaluates a class of `H₁(ℝ / pℤ; ℤ)` to its winding number. -/
@[simp]
theorem singularKronecker_angularClass
    (c : ((singularChains ℤ).obj (TopCat.of (AddCircle p))).homology 1) :
    (TopCat.of (AddCircle p)).singularKronecker ℤ 1 (angularClass p) c =
      firstHomologyAddEquiv p c := by
  have h := ((TopCat.of (AddCircle p)).singularKroneckerEquivOne
    (𝟙_ (ModuleCat.{0} ℤ))).apply_symm_apply
    (ModuleCat.ofHom (firstHomologyAddEquiv p).toIntLinearEquiv.toLinearMap)
  rw [TopCat.singularKroneckerEquivOne_apply] at h
  exact congr($h c)

/-- The angular class takes the value `1` on the circuit class. -/
theorem singularKronecker_angularClass_fundamentalClass :
    (TopCat.of (AddCircle p)).singularKronecker ℤ 1 (angularClass p) (fundamentalClass p) =
      (1 : ℤ) := by
  rw [singularKronecker_angularClass, firstHomologyAddEquiv_fundamentalClass]

/-- **The cup square of the angular class vanishes**: `θ_p ⌣ θ_p = 0`, because
`H²(ℝ / pℤ; ℤ) = 0` for the compact one-dimensional manifold `ℝ / pℤ`. -/
@[simp]
theorem singularCup_angularClass_self :
    (TopCat.of (AddCircle p)).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
      (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 1 (1 + 1) rfl (angularClass p) (angularClass p) = 0 :=
  (ModuleCat.subsingleton_of_isZero (TauCeti.isZero_singularCohomology_of_compactSpace
    (M := AddCircle p) (E := ℝ) (𝟙_ (ModuleCat.{0} ℤ)) (𝟙_ (ModuleCat.{0} ℤ))
    (Module.finrank_self ℝ) one_lt_two)).elim _ _

/-- The unit circle `S¹ ⊆ ℝ²` and `ℝ / pℤ` are identified by a homeomorphism carrying the standard
generator of `H₁(S¹; ℤ)` to the circuit class. -/
private theorem exists_iso_sphere :
    ∃ e : TopCat.sphere.{0} 1 ≅ TopCat.of (AddCircle p),
      ((singularHomologyFunctor (ModuleCat.{0} ℤ) 1).obj (𝟙_ (ModuleCat.{0} ℤ))).map e.hom
        (singularHomologyTopCatSphereGenerator ℤ 0) = fundamentalClass p := by
  set H := (singularHomologyFunctor (ModuleCat.{0} ℤ) 1).obj (𝟙_ (ModuleCat.{0} ℤ))
  set γ : H.obj (TopCat.sphere.{0} 1) := singularHomologyTopCatSphereGenerator ℤ 0
  set F : H.obj (TopCat.of (AddCircle p)) := fundamentalClass p
  let u : H.obj (TopCat.of (AddCircle p)) ≃+ ℤ := firstHomologyAddEquiv p
  have hu : u F = 1 := firstHomologyAddEquiv_fundamentalClass p
  let e₀ : TopCat.sphere.{0} 1 ≅ TopCat.of (AddCircle p) :=
    (TopCat.isoOfHomeo (homeomorphSphere (Fact.out : 0 < p).ne')).symm
  -- the winding number `u (e₀ γ)` of the image of the generator divides `1`
  obtain ⟨r, hr⟩ := exists_eq_smul_singularHomologyTopCatSphereGenerator ℤ 0 (H.map e₀.inv F)
  have h1 : r * u (H.map e₀.hom γ) = 1 := by
    have h : H.map e₀.hom (H.map e₀.inv F) = F := by
      rw [← ConcreteCategory.comp_apply, ← H.map_comp, e₀.inv_hom_id, H.map_id,
        ModuleCat.id_apply]
    rw [hr.trans (int_smul_eq_zsmul _ r _), map_zsmul] at h
    rw [← hu, ← h, map_zsmul, smul_eq_mul]
  have hγ : H.map e₀.hom γ = u (H.map e₀.hom γ) • F :=
    eq_firstHomologyAddEquiv_zsmul_fundamentalClass p _
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' h1 with ⟨-, h⟩ | ⟨-, h⟩
  · exact ⟨e₀, by rw [hγ, h, one_smul]⟩
  · -- otherwise compose with the reflection `θ ↦ -θ`, which reverses the circuit class
    refine ⟨e₀ ≪≫ TopCat.isoOfHomeo (Homeomorph.neg (AddCircle p)), ?_⟩
    have hneg :
        H.map (TopCat.isoOfHomeo (Homeomorph.neg (AddCircle p))).hom F = (-1 : ℤ) • F := by
      have h : (TopCat.isoOfHomeo (Homeomorph.neg (AddCircle p))).hom =
          TopCat.ofHom ⟨fun θ : AddCircle p ↦ (-1 : ℤ) • θ, continuous_zsmul (-1)⟩ := by
        ext θ
        exact (neg_one_zsmul θ).symm
      rw [h]
      exact singularHomologyMap_zsmul_fundamentalClass (p := p) (-1)
    rw [Iso.trans_hom, H.map_comp, ConcreteCategory.comp_apply, hγ, h, map_zsmul, hneg,
      smul_smul]
    norm_num

end AddCircle

namespace TopCat

variable {p : ℝ} [Fact (0 < p)] (M : ModuleCat.{0} ℤ) (Y : TopCat.{0})

/-- The slant products of a class of `(ℝ / pℤ) × Y` by the class of a point and by the circuit
class. -/
private def addCircleProdSlant (s₀ : AddCircle p) (n : ℕ) :
    (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1) →+
      Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1) ×
        Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n :=
  (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 0 (n + 1) (n + 1) (zero_add _)
      (TauCeti.singularHomology₀Section (𝟙_ (ModuleCat.{0} ℤ)) s₀ (1 : ℤ))).toAddMonoidHom.prod
    (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 n (n + 1) (add_comm 1 n)
      (AddCircle.fundamentalClass p)).toAddMonoidHom

omit [Fact (0 < p)] in
private theorem addCircleProdSlant_apply (s₀ : AddCircle p) (n : ℕ)
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    addCircleProdSlant M Y s₀ n φ =
      (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 0 (n + 1) (n + 1) (zero_add _)
          (TauCeti.singularHomology₀Section (𝟙_ (ModuleCat.{0} ℤ)) s₀ (1 : ℤ)) φ,
        singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 n (n + 1) (add_comm 1 n)
          (AddCircle.fundamentalClass p) φ) :=
  rfl

private theorem bijective_addCircleProdSlant (s₀ : AddCircle p) (n : ℕ) :
    Function.Bijective (addCircleProdSlant M Y s₀ n) := by
  obtain ⟨e, he⟩ := AddCircle.exists_iso_sphere p
  have h : ⇑(addCircleProdSlant M Y s₀ n) =
      singularCohomologySphereProdSlantEquiv M Y (e.inv s₀) n ∘
        TopCat.singularCohomologyMap (e.hom ⊗ₘ 𝟙 Y) (n + 1) := by
    funext φ
    -- the sphere lemma is stated in degrees `0 + 1` and `n + (0 + 1)`, which are `1` and `n + 1`
    -- by `Nat` literal arithmetic, so after these rewrites both sides agree up to that reduction
    rw [addCircleProdSlant_apply, Function.comp_apply,
      singularCohomologySphereProdSlantEquiv_singularCohomologyMap_tensorHom, he,
      TopCat.singularCohomologyMap_id, ModuleCat.id_apply, Iso.inv_hom_id_apply,
      ← singularSlant_singularHomology₀Section M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom _ s₀ 1
        (fun s ↦ by simp) φ]
  -- pulling back along the homeomorphism `e × 𝟙` is an isomorphism
  have : IsIso (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ) (M := M)
      (e.hom ⊗ₘ 𝟙 Y) (n + 1)) :=
    inferInstanceAs
      (IsIso ((singularCohomologyFunctor (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)).map (e.hom ⊗ₘ 𝟙 Y).op))
  rw [h]
  exact (LinearEquiv.bijective _).comp (ConcreteCategory.bijective_of_isIso _)

/-- **The cohomology of `(ℝ / pℤ) × Y`**: for `s₀ ∈ ℝ / pℤ`, the slant products by the class of
`s₀` and by the circuit class `[ℝ / pℤ]` give an equivalence
`Hⁿ⁺¹((ℝ / pℤ) × Y; M) ≃ Hⁿ⁺¹(Y; M) × Hⁿ(Y; M)` for every abelian group `M`, torsion included.
Its inverse sends `(b, c)` to `pr₂^* b + pr₁^* θ_p ⌣ pr₂^* c`, where `θ_p` is the angular class
(`TopCat.singularCohomologyAddCircleProdSlantEquiv_symm_apply`). -/
def singularCohomologyAddCircleProdSlantEquiv (s₀ : AddCircle p) (n : ℕ) :
    (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1) ≃+
      Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1) ×
        Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n :=
  AddEquiv.ofBijective (addCircleProdSlant M Y s₀ n) (bijective_addCircleProdSlant M Y s₀ n)

/-- The decomposition of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)` records the slant products by the class of `s₀`
and by the circuit class. -/
@[simp]
lemma singularCohomologyAddCircleProdSlantEquiv_apply (s₀ : AddCircle p) (n : ℕ)
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    singularCohomologyAddCircleProdSlantEquiv M Y s₀ n φ =
      (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 0 (n + 1) (n + 1) (zero_add _)
          (TauCeti.singularHomology₀Section (𝟙_ (ModuleCat.{0} ℤ)) s₀ (1 : ℤ)) φ,
        singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 n (n + 1) (add_comm 1 n)
          (AddCircle.fundamentalClass p) φ) :=
  (rfl)

/-- The inverse of the decomposition of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)` sends `(b, c)` to
`pr₂^* b + pr₁^* θ_p ⌣ pr₂^* c`, for the angular class `θ_p`. -/
@[simp]
lemma singularCohomologyAddCircleProdSlantEquiv_symm_apply (s₀ : AddCircle p) (n : ℕ)
    (bc : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1) ×
      Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n) :
    (singularCohomologyAddCircleProdSlantEquiv M Y s₀ n).symm bc =
      TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (n + 1) bc.1 +
        (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ M).hom
          1 n (n + 1) (add_comm 1 n)
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
            (AddCircle.angularClass p))
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) n bc.2) := by
  rw [AddEquiv.symm_apply_eq, singularCohomologyAddCircleProdSlantEquiv_apply]
  refine Prod.ext ?_ ?_
  · exact (singularSlant_singularHomology₀Section_singularCohomologyMap_snd_add_singularCup M
      (TopCat.of (AddCircle p)) Y s₀ (add_comm 1 n) one_ne_zero (AddCircle.angularClass p) bc.1
      bc.2).symm
  · have h := singularSlant_singularCohomologyMap_snd_add_singularCup M (TopCat.of (AddCircle p)) Y
      (add_comm 1 n) one_ne_zero (AddCircle.fundamentalClass p) (AddCircle.angularClass p) bc.1 bc.2
    rw [AddCircle.singularKronecker_angularClass_fundamentalClass, one_smul] at h
    exact h.symm

/-- The decomposition of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)` sends the pullback `pr₂^* b` of a class of `Y` to
`(b, 0)`. -/
theorem singularCohomologyAddCircleProdSlantEquiv_symm_mk_zero (s₀ : AddCircle p) (n : ℕ)
    (b : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    (singularCohomologyAddCircleProdSlantEquiv M Y s₀ n).symm (b, 0) =
      TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (n + 1) b := by
  rw [singularCohomologyAddCircleProdSlantEquiv_symm_apply, map_zero, map_zero, add_zero]

/-- The decomposition of `H¹((ℝ / pℤ) × Y; ℤ)` sends the angular class `pr₁^* θ_p` of the circle
factor to `(0, 1)`, where `1 ∈ H⁰(Y; ℤ)` is the unit class. -/
theorem singularCohomologyAddCircleProdSlantEquiv_symm_zero_singularCohomologyZeroOne
    (s₀ : AddCircle p) :
    (singularCohomologyAddCircleProdSlantEquiv (𝟙_ (ModuleCat.{0} ℤ)) Y s₀ 0).symm
        (0, Y.singularCohomologyZeroOne) =
      TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
        (AddCircle.angularClass p) := by
  rw [singularCohomologyAddCircleProdSlantEquiv_symm_apply, map_zero]
  -- `zero_add` is applied to the classes only: rewriting would also reach the degree `0 + 1`.
  refine (zero_add _).trans ?_
  rw [TauCeti.singularCohomologyMap_singularCohomologyZeroOne]
  exact singularCup_singularCohomologyZeroOne_right _ _ _

section Basis

-- Instance search finds `AddCommGroup.toIntModule` on a product of `ℤ`-modules before
-- `Prod.instModule`, the structure of the product basis `Module.Basis.prod`.
attribute [local instance 1100] Prod.instModule

/-- **A basis of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)`.** For bases `b` of `Hⁿ⁺¹(Y; M)` and `c` of `Hⁿ(Y; M)`,
the pullbacks `pr₂^* (b i)` and the products `pr₁^* θ_p ⌣ pr₂^* (c j)` with the angular class
`θ_p` form a basis of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)`, indexed by `ι ⊕ κ`. It is the basis `(b, c)` of
`Hⁿ⁺¹(Y; M) × Hⁿ(Y; M)` transported along the decomposition
`TopCat.singularCohomologyAddCircleProdSlantEquiv`. -/
def singularCohomologyAddCircleProdBasis (s₀ : AddCircle p) (n : ℕ) {ι κ : Type*}
    (b : Module.Basis ι ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)))
    (c : Module.Basis κ ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n)) :
    Module.Basis (ι ⊕ κ) ℤ
      ((TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :=
  (b.prod c).map (singularCohomologyAddCircleProdSlantEquiv M Y s₀ n).symm.toIntLinearEquiv

/-- The vector of `TopCat.singularCohomologyAddCircleProdBasis` at `Sum.inl i` is the pullback
`pr₂^* (b i)`. -/
@[simp]
lemma singularCohomologyAddCircleProdBasis_inl (s₀ : AddCircle p) (n : ℕ) {ι κ : Type*}
    (b : Module.Basis ι ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)))
    (c : Module.Basis κ ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n)) (i : ι) :
    singularCohomologyAddCircleProdBasis M Y s₀ n b c (Sum.inl i) =
      TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (n + 1) (b i) := by
  simp only [singularCohomologyAddCircleProdBasis, Module.Basis.map_apply,
    Module.Basis.prod_apply, LinearMap.coe_inl, Sum.elim_inl, AddEquiv.coe_toIntLinearEquiv]
  exact singularCohomologyAddCircleProdSlantEquiv_symm_mk_zero M Y s₀ n (b i)

/-- The vector of `TopCat.singularCohomologyAddCircleProdBasis` at `Sum.inr j` is the product
`pr₁^* θ_p ⌣ pr₂^* (c j)`. -/
@[simp]
lemma singularCohomologyAddCircleProdBasis_inr (s₀ : AddCircle p) (n : ℕ) {ι κ : Type*}
    (b : Module.Basis ι ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)))
    (c : Module.Basis κ ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n)) (j : κ) :
    singularCohomologyAddCircleProdBasis M Y s₀ n b c (Sum.inr j) =
      (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ M).hom
        1 n (n + 1) (add_comm 1 n)
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
          (AddCircle.angularClass p))
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) n (c j)) := by
  simp only [singularCohomologyAddCircleProdBasis, Module.Basis.map_apply,
    Module.Basis.prod_apply, LinearMap.coe_inr, Sum.elim_inr, Function.comp_apply,
    AddEquiv.coe_toIntLinearEquiv, singularCohomologyAddCircleProdSlantEquiv_symm_apply, map_zero,
    zero_add]

/-- The coordinate of `φ` at `Sum.inl i` in `TopCat.singularCohomologyAddCircleProdBasis` is the
coordinate at `i`, in the basis `b`, of the slant product `φ / [s₀]` by the class of `s₀`. -/
@[simp]
lemma singularCohomologyAddCircleProdBasis_repr_inl (s₀ : AddCircle p) (n : ℕ) {ι κ : Type*}
    (b : Module.Basis ι ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)))
    (c : Module.Basis κ ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n))
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1))
    (i : ι) :
    (singularCohomologyAddCircleProdBasis M Y s₀ n b c).repr φ (Sum.inl i) =
      b.repr (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 0 (n + 1) (n + 1)
        (zero_add _) (TauCeti.singularHomology₀Section (𝟙_ (ModuleCat.{0} ℤ)) s₀ (1 : ℤ)) φ) i := by
  simp [singularCohomologyAddCircleProdBasis]

/-- The coordinate of `φ` at `Sum.inr j` in `TopCat.singularCohomologyAddCircleProdBasis` is the
coordinate at `j`, in the basis `c`, of the slant product `φ / [ℝ / pℤ]` by the circuit class. -/
@[simp]
lemma singularCohomologyAddCircleProdBasis_repr_inr (s₀ : AddCircle p) (n : ℕ) {ι κ : Type*}
    (b : Module.Basis ι ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)))
    (c : Module.Basis κ ℤ (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n))
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1))
    (j : κ) :
    (singularCohomologyAddCircleProdBasis M Y s₀ n b c).repr φ (Sum.inr j) =
      c.repr (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 n (n + 1) (add_comm 1 n)
        (AddCircle.fundamentalClass p) φ) j := by
  simp [singularCohomologyAddCircleProdBasis]

/-- **A basis of `H¹((ℝ / pℤ) × Y; ℤ)`.** For a path-connected `Y` and a basis `b` of `H¹(Y; ℤ)`,
the pullbacks `pr₂^* (b i)` and the angular class `pr₁^* θ_p` of the circle factor form a basis of
`H¹((ℝ / pℤ) × Y; ℤ)`, indexed by `Option ι`, with `pr₁^* θ_p` at `none`. It is the case `n = 0`
of `TopCat.singularCohomologyAddCircleProdBasis`, for the basis `1` of `H⁰(Y; ℤ) ≅ ℤ`. -/
def singularCohomologyOneAddCircleProdBasis [PathConnectedSpace Y] {ι : Type*}
    (b : Module.Basis ι ℤ
      (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1)) :
    Module.Basis (Option ι) ℤ
      ((TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ
        (𝟙_ (ModuleCat.{0} ℤ)) 1) :=
  (singularCohomologyAddCircleProdBasis _ Y (0 : AddCircle p) 0 b
      ((Module.Basis.singleton Unit ℤ).map
        (singularCohomologyZeroEvalEquiv (Classical.arbitrary Y)).symm)).reindex
    (Equiv.optionEquivSumPUnit.{0} ι).symm

/-- The vector of `TopCat.singularCohomologyOneAddCircleProdBasis` at `none` is the angular class
`pr₁^* θ_p` of the circle factor. -/
@[simp]
lemma singularCohomologyOneAddCircleProdBasis_none [PathConnectedSpace Y] {ι : Type*}
    (b : Module.Basis ι ℤ
      (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1)) :
    singularCohomologyOneAddCircleProdBasis (p := p) Y b none =
      TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
        (AddCircle.angularClass p) := by
  -- The basis vector `1` of `ℤ` is sent to the unit class. (The scalar action in
  -- `singularCohomologyZeroEvalEquiv_symm_apply` is not reducibly the instance `one_smul` finds.)
  have h₁ : (singularCohomologyZeroEvalEquiv (Classical.arbitrary Y)).symm (1 : ℤ) =
      Y.singularCohomologyZeroOne := by
    rw [LinearEquiv.symm_apply_eq, singularCohomologyZeroEvalEquiv_apply,
      singularCohomologyZeroEval_singularCohomologyZeroOne]
  simp only [singularCohomologyOneAddCircleProdBasis, singularCohomologyAddCircleProdBasis,
    Module.Basis.coe_reindex, Equiv.symm_symm, Function.comp_apply,
    Equiv.optionEquivSumPUnit_none, Module.Basis.map_apply, Module.Basis.prod_apply,
    LinearMap.coe_inr, Sum.elim_inr, Module.Basis.singleton_apply, AddEquiv.coe_toIntLinearEquiv,
    h₁]
  exact singularCohomologyAddCircleProdSlantEquiv_symm_zero_singularCohomologyZeroOne Y
    (0 : AddCircle p)

/-- The vector of `TopCat.singularCohomologyOneAddCircleProdBasis` at `some i` is the pullback
`pr₂^* (b i)`. -/
@[simp]
lemma singularCohomologyOneAddCircleProdBasis_some [PathConnectedSpace Y] {ι : Type*}
    (b : Module.Basis ι ℤ
      (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1))
    (i : ι) :
    singularCohomologyOneAddCircleProdBasis (p := p) Y b (some i) =
      TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 1 (b i) := by
  simp [singularCohomologyOneAddCircleProdBasis]

/-- The coordinate of `φ` at `none` in `TopCat.singularCohomologyOneAddCircleProdBasis`, the
coefficient of the angular class `pr₁^* θ_p`, is the value at any point `y` of the slant product
`φ / [ℝ / pℤ] ∈ H⁰(Y; ℤ)` by the circuit class. -/
lemma singularCohomologyOneAddCircleProdBasis_repr_none [PathConnectedSpace Y] {ι : Type*}
    (b : Module.Basis ι ℤ
      (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1))
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ
      (𝟙_ (ModuleCat.{0} ℤ)) 1) (y : Y) :
    (singularCohomologyOneAddCircleProdBasis (p := p) Y b).repr φ none =
      singularCohomologyZeroEval y
        (singularSlant ℤ (𝟙_ (ModuleCat.{0} ℤ)) _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 0 1
          (add_comm 1 0) (AddCircle.fundamentalClass p) φ) := by
  simp [singularCohomologyOneAddCircleProdBasis,
    singularCohomologyZeroEval_eq_of_joined (PathConnectedSpace.joined (Classical.arbitrary Y) y)]

/-- The coordinate of `φ` at `some i` in `TopCat.singularCohomologyOneAddCircleProdBasis` is the
coordinate at `i`, in the basis `b`, of the slant product `φ / [0]` by the class of `0`. -/
@[simp]
lemma singularCohomologyOneAddCircleProdBasis_repr_some [PathConnectedSpace Y] {ι : Type*}
    (b : Module.Basis ι ℤ
      (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1))
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ
      (𝟙_ (ModuleCat.{0} ℤ)) 1) (i : ι) :
    (singularCohomologyOneAddCircleProdBasis (p := p) Y b).repr φ (some i) =
      b.repr (singularSlant ℤ (𝟙_ (ModuleCat.{0} ℤ)) _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 0 1 1
        (zero_add _) (TauCeti.singularHomology₀Section (𝟙_ (ModuleCat.{0} ℤ)) (0 : AddCircle p)
          (1 : ℤ)) φ) i := by
  simp [singularCohomologyOneAddCircleProdBasis]

end Basis

/-- **The decomposition of a class of `(ℝ / pℤ) × Y`**: for `s₀ ∈ ℝ / pℤ`, every
`φ ∈ Hⁿ⁺¹((ℝ / pℤ) × Y; M)` is `pr₂^* (φ / [s₀]) + pr₁^* θ_p ⌣ pr₂^* (φ / [ℝ / pℤ])`, where `θ_p`
is the angular class and `[ℝ / pℤ]` the circuit class. For `n = 1` and `M = ℤ` this splits
`H²((ℝ / pℤ) × Y; ℤ)` as `pr₂^* H²(Y; ℤ) ⊕ θ_p ⌣ pr₂^* H¹(Y; ℤ)`. -/
theorem singularCohomologyMap_snd_add_singularCup_addCircle (s₀ : AddCircle p) {n : ℕ}
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (n + 1)
        (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 0 (n + 1) (n + 1) (zero_add _)
          (TauCeti.singularHomology₀Section (𝟙_ (ModuleCat.{0} ℤ)) s₀ (1 : ℤ)) φ) +
      (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ M).hom
        1 n (n + 1) (add_comm 1 n)
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
          (AddCircle.angularClass p))
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) n
          (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 n (n + 1) (add_comm 1 n)
            (AddCircle.fundamentalClass p) φ)) = φ := by
  have h := (singularCohomologyAddCircleProdSlantEquiv M Y s₀ n).symm_apply_apply φ
  rw [singularCohomologyAddCircleProdSlantEquiv_symm_apply] at h
  exact h

/-- **Classes of `(ℝ / pℤ) × Y` pulled back from `Y`**: a class `φ ∈ Hⁿ⁺¹((ℝ / pℤ) × Y; M)` is
pulled back from `Y` if and only if its slant product `φ / [ℝ / pℤ]` by the circuit class
vanishes. -/
theorem mem_range_singularCohomologyMap_snd_addCircle_iff {n : ℕ}
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    φ ∈ LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M) (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom ↔
      singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 n (n + 1) (add_comm 1 n)
        (AddCircle.fundamentalClass p) φ = 0 := by
  refine ⟨?_, fun hφ ↦ ?_⟩
  · rintro ⟨b, rfl⟩
    exact singularSlant_singularCohomologyMap_snd_eq_zero M _ Y _ 1 n (n + 1) (add_comm 1 n)
      one_ne_zero _ b
  · have h := singularCohomologyMap_snd_add_singularCup_addCircle M Y 0 φ
    rw [hφ, map_zero, map_zero, add_zero] at h
    exact ⟨_, h⟩

/-- **Classes of finite order on `(ℝ / pℤ) × Y`**: for `s₀ ∈ ℝ / pℤ`, a class
`φ ∈ Hⁿ⁺¹((ℝ / pℤ) × Y; M)` has finite order exactly when both of its slant products, `φ / [s₀]`
by the class of the point `s₀` and `φ / [ℝ / pℤ]` by the circuit class, have finite order. -/
theorem isOfFinAddOrder_iff_singularSlant_addCircle (s₀ : AddCircle p) {n : ℕ}
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    IsOfFinAddOrder φ ↔
      IsOfFinAddOrder (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 0 (n + 1) (n + 1)
          (zero_add _) (TauCeti.singularHomology₀Section (𝟙_ (ModuleCat.{0} ℤ)) s₀ (1 : ℤ)) φ) ∧
        IsOfFinAddOrder (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 n (n + 1)
          (add_comm 1 n) (AddCircle.fundamentalClass p) φ) := by
  rw [← Function.Injective.isOfFinAddOrder_iff
      (f := (singularCohomologyAddCircleProdSlantEquiv M Y s₀ n).toAddMonoidHom)
      (singularCohomologyAddCircleProdSlantEquiv M Y s₀ n).injective,
    AddEquiv.coe_toAddMonoidHom, IsOfFinAddOrder.prod_iff,
    singularCohomologyAddCircleProdSlantEquiv_apply]

/-- **Classes of finite order in the decomposition of `(ℝ / pℤ) × Y`**: the class
`pr₂^* b + pr₁^* θ_p ⌣ pr₂^* c` of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)`, for the angular class `θ_p`, has finite
order exactly when both `b ∈ Hⁿ⁺¹(Y; M)` and `c ∈ Hⁿ(Y; M)` have finite order. So the torsion of
`Hⁿ⁺¹((ℝ / pℤ) × Y; M)` is the sum of the torsion of `Hⁿ⁺¹(Y; M)` and of `Hⁿ(Y; M)`, each
placed by the decomposition. -/
theorem isOfFinAddOrder_singularCohomologyMap_snd_add_singularCup_addCircle_iff {n : ℕ}
    (b : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1))
    (c : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n) :
    IsOfFinAddOrder (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (n + 1) b +
        (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ M).hom
          1 n (n + 1) (add_comm 1 n)
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
            (AddCircle.angularClass p))
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) n c)) ↔
      IsOfFinAddOrder b ∧ IsOfFinAddOrder c := by
  rw [← singularCohomologyAddCircleProdSlantEquiv_symm_apply M Y (0 : AddCircle p) n (b, c)]
  exact (Function.Injective.isOfFinAddOrder_iff
    (f := (singularCohomologyAddCircleProdSlantEquiv M Y (0 : AddCircle p) n).symm.toAddMonoidHom)
    (singularCohomologyAddCircleProdSlantEquiv M Y (0 : AddCircle p) n).symm.injective).trans
      IsOfFinAddOrder.prod_iff

/-- **The torsion of `(ℝ / pℤ) × Y` when `Hⁿ(Y; M)` is torsion-free**: if `Hⁿ(Y; M)` has no
nonzero element of finite order, then a class of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)` has finite order exactly
when it is pulled back from a class of finite order of `Hⁿ⁺¹(Y; M)`. -/
theorem isOfFinAddOrder_iff_exists_singularCohomologyMap_snd_addCircle {n : ℕ}
    [IsAddTorsionFree (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n)]
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    IsOfFinAddOrder φ ↔ ∃ b : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1),
      IsOfFinAddOrder b ∧
        TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (n + 1) b = φ := by
  refine ⟨fun hφ ↦ ?_, ?_⟩
  · obtain ⟨hb, hc⟩ := (isOfFinAddOrder_iff_singularSlant_addCircle M Y (0 : AddCircle p) φ).1 hφ
    refine ⟨_, hb, ?_⟩
    have h := singularCohomologyMap_snd_add_singularCup_addCircle M Y (0 : AddCircle p) φ
    rwa [(isOfFinAddOrder_iff_eq_zero _).1 hc, map_zero, map_zero, add_zero] at h
  · rintro ⟨b, hb, rfl⟩
    exact (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ) (M := M)
      (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom.toAddMonoidHom
        |>.isOfFinAddOrder hb

/-- **Generators modulo torsion of `(ℝ / pℤ) × Y`**: if every class of `Hⁿ⁺¹(Y; M)` differs from a
multiple of `v` by an element of finite order, and every class of `Hⁿ(Y; M)` from a multiple of
`a`, then every class of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)` differs from a combination of `pr₂^* v` and
`pr₁^* θ_p ⌣ pr₂^* a` by an element of finite order, for the angular class `θ_p`. -/
theorem exists_isOfFinAddOrder_sub_smul_add_smul_addCircle {n : ℕ}
    {v : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)}
    {a : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n}
    (hv : ∀ b, ∃ m : ℤ, IsOfFinAddOrder (b - m • v))
    (ha : ∀ c, ∃ m : ℤ, IsOfFinAddOrder (c - m • a))
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    ∃ m c : ℤ, IsOfFinAddOrder (φ -
      (m • TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (n + 1) v +
        c • (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
          (λ_ M).hom 1 n (n + 1) (add_comm 1 n)
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
            (AddCircle.angularClass p))
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) n a))) := by
  obtain ⟨m, hm⟩ := hv (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 0 (n + 1) (n + 1)
    (zero_add _) (TauCeti.singularHomology₀Section (𝟙_ (ModuleCat.{0} ℤ)) (0 : AddCircle p) (1 : ℤ))
    φ)
  obtain ⟨c, hc⟩ := ha (singularSlant ℤ M _ Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 n (n + 1)
    (add_comm 1 n) (AddCircle.fundamentalClass p) φ)
  refine ⟨m, c, ?_⟩
  -- The difference is the decomposed class with the two slant products replaced by their
  -- differences with `m • v` and `c • a`.
  have h := (isOfFinAddOrder_singularCohomologyMap_snd_add_singularCup_addCircle_iff (p := p) M Y
    _ _).2 ⟨hm, hc⟩
  rw [← singularCohomologyMap_snd_add_singularCup_addCircle M Y (0 : AddCircle p) φ]
  simpa only [map_sub, map_zsmul, sub_add_sub_comm] using h

/-- **Independence modulo torsion in `(ℝ / pℤ) × Y`**: if no nonzero multiple of `v ∈ Hⁿ⁺¹(Y; M)`
or of `a ∈ Hⁿ(Y; M)` has finite order, then `m • pr₂^* v + c • (pr₁^* θ_p ⌣ pr₂^* a)` has finite
order only for `m = c = 0`. -/
theorem isOfFinAddOrder_smul_add_smul_addCircle_iff {n : ℕ}
    {v : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)}
    {a : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n}
    (hv : ∀ m : ℤ, IsOfFinAddOrder (m • v) → m = 0) (ha : ∀ m : ℤ, IsOfFinAddOrder (m • a) → m = 0)
    (m c : ℤ) :
    IsOfFinAddOrder
      (m • TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (n + 1) v +
        c • (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
          (λ_ M).hom 1 n (n + 1) (add_comm 1 n)
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
            (AddCircle.angularClass p))
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) n a)) ↔
      m = 0 ∧ c = 0 := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · have h' := (isOfFinAddOrder_singularCohomologyMap_snd_add_singularCup_addCircle_iff (p := p) M Y
      (m • v) (c • a)).1 (by simpa only [map_zsmul] using h)
    exact ⟨hv m h'.1, ha c h'.2⟩
  · rintro ⟨rfl, rfl⟩
    simp

variable {M}

/-- **Pulled-back classes of `(ℝ / pℤ) × Y` under a change of coefficients**: let `g : M ⟶ M'`
induce an injective map `Hⁿ(Y; M) → Hⁿ(Y; M')`. If the image of `φ ∈ Hⁿ⁺¹((ℝ / pℤ) × Y; M)` in
`Hⁿ⁺¹((ℝ / pℤ) × Y; M')` is pulled back from `Y`, then so is `φ`. -/
theorem mem_range_singularCohomologyMap_snd_addCircle_of_injective {n : ℕ}
    {M' : ModuleCat.{0} ℤ} (g : M ⟶ M')
    (hg : Function.Injective (HomologicalComplex.homologyMap
      (((toSSet.obj Y).chainComplex (𝟙_ (ModuleCat.{0} ℤ))).linearYonedaObjMap ℤ g) n))
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1))
    (hφ : HomologicalComplex.homologyMap (((toSSet.obj (TopCat.of (AddCircle p) ⊗ Y)).chainComplex
        (𝟙_ (ModuleCat.{0} ℤ))).linearYonedaObjMap ℤ g) (n + 1) φ ∈
      LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M') (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom) :
    φ ∈ LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M) (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom := by
  -- the slant product by the circuit class commutes with the change of coefficients
  have h := (singularSlant_linearYonedaObjMap M (TopCat.of (AddCircle p)) Y
    (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom g 1 n (n + 1) (add_comm 1 n) (AddCircle.fundamentalClass p)
    φ).symm.trans ((mem_range_singularCohomologyMap_snd_addCircle_iff M' Y _).1 hφ)
  exact (mem_range_singularCohomologyMap_snd_addCircle_iff M Y φ).2 (hg (h.trans (map_zero _).symm))

/-- **Pulled-back classes of `(ℝ / pℤ) × Y` under a change of coefficients**: for every
`g : M ⟶ M'`, if `φ ∈ Hⁿ⁺¹((ℝ / pℤ) × Y; M)` is pulled back from `Y`, then so is its image in
`Hⁿ⁺¹((ℝ / pℤ) × Y; M')`. -/
theorem homologyMap_linearYonedaObjMap_mem_range_singularCohomologyMap_snd_addCircle {n : ℕ}
    {M' : ModuleCat.{0} ℤ} (g : M ⟶ M')
    {φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)}
    (hφ : φ ∈ LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M) (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom) :
    HomologicalComplex.homologyMap (((toSSet.obj (TopCat.of (AddCircle p) ⊗ Y)).chainComplex
        (𝟙_ (ModuleCat.{0} ℤ))).linearYonedaObjMap ℤ g) (n + 1) φ ∈
      LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M') (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom := by
  -- the slant product by the circuit class commutes with the change of coefficients
  rw [mem_range_singularCohomologyMap_snd_addCircle_iff] at hφ ⊢
  rw [singularSlant_linearYonedaObjMap M (TopCat.of (AddCircle p)) Y (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom
    g 1 n (n + 1) (add_comm 1 n) (AddCircle.fundamentalClass p), hφ, map_zero]

/-- **Pulled-back classes of `(ℝ / pℤ) × Y` under an injective change of coefficients**: let
`g : M ⟶ M'` induce an injective map `Hⁿ(Y; M) → Hⁿ(Y; M')`. Then `φ ∈ Hⁿ⁺¹((ℝ / pℤ) × Y; M)` is
pulled back from `Y` if and only if its image in `Hⁿ⁺¹((ℝ / pℤ) × Y; M')` is. -/
theorem homologyMap_linearYonedaObjMap_mem_range_singularCohomologyMap_snd_addCircle_iff
    {n : ℕ} {M' : ModuleCat.{0} ℤ} (g : M ⟶ M')
    (hg : Function.Injective (HomologicalComplex.homologyMap
      (((toSSet.obj Y).chainComplex (𝟙_ (ModuleCat.{0} ℤ))).linearYonedaObjMap ℤ g) n))
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    HomologicalComplex.homologyMap (((toSSet.obj (TopCat.of (AddCircle p) ⊗ Y)).chainComplex
        (𝟙_ (ModuleCat.{0} ℤ))).linearYonedaObjMap ℤ g) (n + 1) φ ∈
      LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M') (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom ↔
      φ ∈ LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M) (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom :=
  ⟨mem_range_singularCohomologyMap_snd_addCircle_of_injective Y g hg φ,
    homologyMap_linearYonedaObjMap_mem_range_singularCohomologyMap_snd_addCircle Y g⟩

/-- **Classes of `(ℝ / pℤ) × Y` pulled back after an injective change of coefficients**: if
`g : M ⟶ M'` is injective and the image of `φ ∈ H²((ℝ / pℤ) × Y; M)` in `H²((ℝ / pℤ) × Y; M')` is
pulled back from `Y`, then so is `φ`. For `ℤ → ℝ`: an integral class of `H²((ℝ / ℤ)_s × Y)` whose
real class is pulled back from `Y` is pulled back from `Y` integrally, because the cross quotient
`H¹(Y; ℤ)` is torsion-free. -/
theorem mem_range_singularCohomologyMap_snd_addCircle_one_add_of_injective
    {M' : ModuleCat.{0} ℤ} (g : M ⟶ M') (hg : Function.Injective g)
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (1 + 1))
    (hφ : HomologicalComplex.homologyMap (((toSSet.obj (TopCat.of (AddCircle p) ⊗ Y)).chainComplex
        (𝟙_ (ModuleCat.{0} ℤ))).linearYonedaObjMap ℤ g) (1 + 1) φ ∈
      LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M') (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (1 + 1)).hom) :
    φ ∈ LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M) (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (1 + 1)).hom := by
  exact mem_range_singularCohomologyMap_snd_addCircle_of_injective (n := 1) Y g
    (Y.injective_homologyMap_linearYonedaObjMap_one g hg) φ hφ

variable (M) in
/-- **Classes of `(ℝ / pℤ) × Y` with a pulled-back multiple**: if `Hⁿ(Y; M)` is torsion-free, then
for every integer `k ≠ 0` the class `k • φ` of `Hⁿ⁺¹((ℝ / pℤ) × Y; M)` is pulled back from `Y` if
and only if `φ` is. For `n = 1` and `M = ℤ`, `H¹(Y; ℤ)` is always torsion-free, so a class of
`H²((ℝ / pℤ) × Y; ℤ)` is pulled back from `Y` as soon as one of its nonzero multiples is. -/
theorem zsmul_mem_range_singularCohomologyMap_snd_addCircle_iff {n : ℕ}
    [IsAddTorsionFree (Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M n)] {k : ℤ} (hk : k ≠ 0)
    (φ : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ M (n + 1)) :
    k • φ ∈ LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M) (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom ↔
      φ ∈ LinearMap.range (TopCat.singularCohomologyMap (R := 𝟙_ (ModuleCat.{0} ℤ)) (k := ℤ)
        (M := M) (CartesianMonoidalCategory.snd (TopCat.of (AddCircle p)) Y) (n + 1)).hom := by
  rw [mem_range_singularCohomologyMap_snd_addCircle_iff,
    mem_range_singularCohomologyMap_snd_addCircle_iff, map_zsmul,
    IsAddTorsionFree.zsmul_eq_zero_iff_right hk]


/-! ### Cup products and the intersection form of `(ℝ / pℤ) × Y` -/

section IntersectionForm

/-- **The Kronecker pairing of a cup product on `(ℝ / pℤ) × Y` with `[ℝ / pℤ] × y`**: for
`b ∈ Hᵐ⁺¹(Y; ℤ)`, `c ∈ Hᵐ(Y; ℤ)`, `b' ∈ Hᵐ'⁺¹(Y; ℤ)`, `c' ∈ Hᵐ'(Y; ℤ)` and a homology class
`y ∈ Hₘ₊ₘ'₊₁(Y; ℤ)`,

`⟨(pr₂^* b + θ_p ⌣ pr₂^* c) ⌣ (pr₂^* b' + θ_p ⌣ pr₂^* c'), [ℝ / pℤ] × y⟩`
`  = ⟨c ⌣ b', y⟩ + (-1)^(m + 1) ⟨b ⌣ c', y⟩`,

where `[ℝ / pℤ] × y` is the homology cross product of the circuit class with `y`, read with
coefficients `ℤ` through `ℤ ⊗ ℤ ≅ ℤ`. No hypothesis on `Y` is needed: the summand `pr₂^* (b ⌣ b')`
of the cup product is killed by the slant product by `[ℝ / pℤ]`. -/
theorem singularKronecker_singularCup_addCircle_singularHomologyCross {m m' : ℕ}
    (b : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) (m + 1))
    (c : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) m)
    (b' : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) (m' + 1))
    (c' : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) m')
    (y : ((singularHomologyFunctor (ModuleCat.{0} ℤ) (m + m' + 1)).obj
      (𝟙_ (ModuleCat.{0} ℤ))).obj Y) :
    ((TopCat.of (AddCircle p) ⊗ Y).singularKronecker ℤ (m + m' + 1 + 1)
      ((TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
        (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom (m + 1) (m' + 1) (m + m' + 1 + 1) (by omega)
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (m + 1) b +
          (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
            (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 m (m + 1) (add_comm 1 m)
            (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
              (AddCircle.angularClass p))
            (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) m c))
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) (m' + 1) b' +
          (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
            (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 m' (m' + 1) (add_comm 1 m')
            (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
              (AddCircle.angularClass p))
            (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) m' c')))).hom
      (((singularHomologyFunctor (ModuleCat.{0} ℤ) (m + m' + 1 + 1)).map
          (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom).app (TopCat.of (AddCircle p) ⊗ Y)
        (singularHomologyCross (TopCat.of (AddCircle p)) Y (𝟙_ (ModuleCat.{0} ℤ))
          (𝟙_ (ModuleCat.{0} ℤ)) 1 (m + m' + 1) (m + m' + 1 + 1) (add_comm 1 _)
          (AddCircle.fundamentalClass p ⊗ₜ y))) =
      (Y.singularKronecker ℤ (m + m' + 1)
          (Y.singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom m
            (m' + 1) (m + m' + 1) (by omega) c b')).hom y +
        (-1 : ℤ) ^ (m + 1) * (Y.singularKronecker ℤ (m + m' + 1)
          (Y.singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom
            (m + 1) m' (m + m' + 1) (by omega) b c')).hom y := by
  -- expand the cup product, using `θ_p ⌣ θ_p = 0`
  rw [singularCup_singularCohomologyMap_snd_add_singularCup (add_comm 1 m) (add_comm 1 m')
      (by omega) (add_comm 1 _) _ (AddCircle.singularCup_angularClass_self p)]
  -- evaluating on `[ℝ / pℤ] × y` is evaluating the slant product by `[ℝ / pℤ]` on `y`
  rw [← singularKronecker_singularSlant (𝟙_ (ModuleCat.{0} ℤ)) (TopCat.of (AddCircle p)) Y
    (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 (m + m' + 1) (m + m' + 1 + 1) (add_comm 1 _)
    (AddCircle.fundamentalClass p)]
  have h := singularSlant_singularCohomologyMap_snd_add_singularCup (𝟙_ (ModuleCat.{0} ℤ))
    (TopCat.of (AddCircle p)) Y (add_comm 1 (m + m' + 1)) one_ne_zero
    (AddCircle.fundamentalClass p) (AddCircle.angularClass p)
    (Y.singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom (m + 1)
      (m' + 1) (m + m' + 1 + 1) (by omega) b b')
    (Y.singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom m
        (m' + 1) (m + m' + 1) (by omega) c b' +
      ((-1 : ℤ) ^ (1 * (m + 1))) •
        Y.singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom (m + 1)
          m' (m + m' + 1) (by omega) b c')
  rw [h, AddCircle.singularKronecker_angularClass_fundamentalClass, one_smul, one_mul, map_add,
    map_zsmul]
  simp

variable {Y}

/-- **The cup pairing on `H²((ℝ / pℤ) × Y; ℤ)` against `[ℝ / pℤ] × y`**: for `y ∈ H₃(Y; ℤ)`,
the cup pairing against the homology cross product `[ℝ / pℤ] × y` of the classes
`x = pr₂^* b + θ_p ⌣ pr₂^* c` and `x' = pr₂^* b' + θ_p ⌣ pr₂^* c'` is
`x · x' = ⟨b ⌣ c', y⟩ + ⟨b' ⌣ c, y⟩`. When `y` is the fundamental class of a closed oriented
three-manifold `Y`, this is the intersection form of `(ℝ / pℤ) × Y` in the decomposition
`H²((ℝ / pℤ) × Y; ℤ) = pr₂^* H²(Y; ℤ) ⊕ θ_p ⌣ pr₂^* H¹(Y; ℤ)`: both summands are isotropic, and
they are paired by the cup pairing of `Y`. -/
theorem singularCupPairing_addCircle_singularHomologyCross
    (y : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 3).obj (𝟙_ (ModuleCat.{0} ℤ))).obj Y)
    (b b' : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 2)
    (c c' : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1) :
    (TopCat.of (AddCircle p) ⊗ Y).singularCupPairing ℤ (p := 2) (q := 2) (n := 4) rfl
        (((singularHomologyFunctor (ModuleCat.{0} ℤ) 4).map (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom).app
          (TopCat.of (AddCircle p) ⊗ Y)
          (singularHomologyCross (TopCat.of (AddCircle p)) Y (𝟙_ (ModuleCat.{0} ℤ))
            (𝟙_ (ModuleCat.{0} ℤ)) 1 3 4 rfl (AddCircle.fundamentalClass p ⊗ₜ y)))
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 2 b +
          (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
            (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 1 2 rfl
            (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
              (AddCircle.angularClass p))
            (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 1 c))
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 2 b' +
          (TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
            (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 1 2 rfl
            (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
              (AddCircle.angularClass p))
            (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 1 c')) =
      Y.singularCupPairing ℤ (p := 2) (q := 1) (n := 3) rfl y b c' +
        Y.singularCupPairing ℤ (p := 2) (q := 1) (n := 3) rfl y b' c := by
  rw [singularCupPairing_apply, singularCupPairing_apply, singularCupPairing_apply]
  have h := singularKronecker_singularCup_addCircle_singularHomologyCross (p := p) Y (m := 1)
    (m' := 1) b c b' c' y
  -- `c ⌣ b' = b' ⌣ c`, since the product of the degrees is even
  rw [Y.singularCup_gradedComm_tensorUnit ℤ (μ := (λ_ _).hom) (IsCommMonObj.mul_comm _)
    (p := 1 + 1) (q := 1) (n := 1 + 1 + 1) rfl b' c] at h
  refine h.trans ?_
  norm_num
  abel

/-- **Classes pulled back from `Y` are orthogonal** for the cup pairing on `H²((ℝ / pℤ) × Y; ℤ)`
against `[ℝ / pℤ] × y`: `pr₂^* b · pr₂^* b' = 0`. -/
theorem singularCupPairing_snd_snd_addCircle_singularHomologyCross
    (y : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 3).obj (𝟙_ (ModuleCat.{0} ℤ))).obj Y)
    (b b' : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 2) :
    (TopCat.of (AddCircle p) ⊗ Y).singularCupPairing ℤ (p := 2) (q := 2) (n := 4) rfl
        (((singularHomologyFunctor (ModuleCat.{0} ℤ) 4).map (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom).app
          (TopCat.of (AddCircle p) ⊗ Y)
          (singularHomologyCross (TopCat.of (AddCircle p)) Y (𝟙_ (ModuleCat.{0} ℤ))
            (𝟙_ (ModuleCat.{0} ℤ)) 1 3 4 rfl (AddCircle.fundamentalClass p ⊗ₜ y)))
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 2 b)
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 2 b') = 0 := by
  simpa using singularCupPairing_addCircle_singularHomologyCross y b b' 0 0

/-- **Classes `θ_p ⌣ pr₂^* c` are orthogonal** for the cup pairing on `H²((ℝ / pℤ) × Y; ℤ)`
against `[ℝ / pℤ] × y`: `(θ_p ⌣ pr₂^* c) · (θ_p ⌣ pr₂^* c') = 0`. -/
theorem singularCupPairing_fst_snd_fst_snd_addCircle_singularHomologyCross
    (y : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 3).obj (𝟙_ (ModuleCat.{0} ℤ))).obj Y)
    (c c' : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1) :
    (TopCat.of (AddCircle p) ⊗ Y).singularCupPairing ℤ (p := 2) (q := 2) (n := 4) rfl
        (((singularHomologyFunctor (ModuleCat.{0} ℤ) 4).map (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom).app
          (TopCat.of (AddCircle p) ⊗ Y)
          (singularHomologyCross (TopCat.of (AddCircle p)) Y (𝟙_ (ModuleCat.{0} ℤ))
            (𝟙_ (ModuleCat.{0} ℤ)) 1 3 4 rfl (AddCircle.fundamentalClass p ⊗ₜ y)))
        ((TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
          (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 1 2 rfl
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
            (AddCircle.angularClass p))
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 1 c))
        ((TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
          (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 1 2 rfl
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
            (AddCircle.angularClass p))
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 1 c')) = 0 := by
  simpa using singularCupPairing_addCircle_singularHomologyCross y 0 0 c c'

/-- **The pairing of the two summands** of `H²((ℝ / pℤ) × Y; ℤ)` against `[ℝ / pℤ] × y` is the
cup pairing of `Y`: `pr₂^* b · (θ_p ⌣ pr₂^* c) = ⟨b ⌣ c, y⟩`. -/
theorem singularCupPairing_snd_fst_snd_addCircle_singularHomologyCross
    (y : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 3).obj (𝟙_ (ModuleCat.{0} ℤ))).obj Y)
    (b : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 2)
    (c : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1) :
    (TopCat.of (AddCircle p) ⊗ Y).singularCupPairing ℤ (p := 2) (q := 2) (n := 4) rfl
        (((singularHomologyFunctor (ModuleCat.{0} ℤ) 4).map (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom).app
          (TopCat.of (AddCircle p) ⊗ Y)
          (singularHomologyCross (TopCat.of (AddCircle p)) Y (𝟙_ (ModuleCat.{0} ℤ))
            (𝟙_ (ModuleCat.{0} ℤ)) 1 3 4 rfl (AddCircle.fundamentalClass p ⊗ₜ y)))
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 2 b)
        ((TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
          (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 1 2 rfl
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
            (AddCircle.angularClass p))
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 1 c)) =
      Y.singularCupPairing ℤ (p := 2) (q := 1) (n := 3) rfl y b c := by
  simpa using singularCupPairing_addCircle_singularHomologyCross y b 0 0 c

/-- **The pairing of the two summands in the other order**: against `[ℝ / pℤ] × y`,
`(θ_p ⌣ pr₂^* c) · pr₂^* b = ⟨b ⌣ c, y⟩` as well. -/
theorem singularCupPairing_fst_snd_snd_addCircle_singularHomologyCross
    (y : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 3).obj (𝟙_ (ModuleCat.{0} ℤ))).obj Y)
    (b : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 2)
    (c : Y.singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ (𝟙_ (ModuleCat.{0} ℤ)) 1) :
    (TopCat.of (AddCircle p) ⊗ Y).singularCupPairing ℤ (p := 2) (q := 2) (n := 4) rfl
        (((singularHomologyFunctor (ModuleCat.{0} ℤ) 4).map (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom).app
          (TopCat.of (AddCircle p) ⊗ Y)
          (singularHomologyCross (TopCat.of (AddCircle p)) Y (𝟙_ (ModuleCat.{0} ℤ))
            (𝟙_ (ModuleCat.{0} ℤ)) 1 3 4 rfl (AddCircle.fundamentalClass p ⊗ₜ y)))
        ((TopCat.of (AddCircle p) ⊗ Y).singularCup ℤ (λ_ (𝟙_ (ModuleCat.{0} ℤ))).inv
          (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom 1 1 2 rfl
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.fst _ Y) 1
            (AddCircle.angularClass p))
          (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 1 c))
        (TopCat.singularCohomologyMap (CartesianMonoidalCategory.snd _ Y) 2 b) =
      Y.singularCupPairing ℤ (p := 2) (q := 1) (n := 3) rfl y b c := by
  simpa using singularCupPairing_addCircle_singularHomologyCross y 0 b c 0

/-- **The squares of the cup pairing on `H²((ℝ / pℤ) × Y; ℤ)` against `[ℝ / pℤ] × y`**: for
every class `x` with components `(b, c) = (x / [s₀], x / [ℝ / pℤ])`, `x · x = 2 ⟨b ⌣ c, y⟩`. -/
theorem singularCupPairing_self_addCircle_singularHomologyCross (s₀ : AddCircle p)
    (y : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 3).obj (𝟙_ (ModuleCat.{0} ℤ))).obj Y)
    (x : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ
      (𝟙_ (ModuleCat.{0} ℤ)) 2) :
    (TopCat.of (AddCircle p) ⊗ Y).singularCupPairing ℤ (p := 2) (q := 2) (n := 4) rfl
        (((singularHomologyFunctor (ModuleCat.{0} ℤ) 4).map (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom).app
          (TopCat.of (AddCircle p) ⊗ Y)
          (singularHomologyCross (TopCat.of (AddCircle p)) Y (𝟙_ (ModuleCat.{0} ℤ))
            (𝟙_ (ModuleCat.{0} ℤ)) 1 3 4 rfl (AddCircle.fundamentalClass p ⊗ₜ y))) x x =
      2 * Y.singularCupPairing ℤ (p := 2) (q := 1) (n := 3) rfl y
        (singularCohomologyAddCircleProdSlantEquiv (𝟙_ (ModuleCat.{0} ℤ)) Y s₀ 1 x).1
        (singularCohomologyAddCircleProdSlantEquiv (𝟙_ (ModuleCat.{0} ℤ)) Y s₀ 1 x).2 := by
  obtain ⟨⟨b, c⟩, rfl⟩ :=
    (singularCohomologyAddCircleProdSlantEquiv (𝟙_ (ModuleCat.{0} ℤ)) Y s₀ 1).symm.surjective x
  rw [AddEquiv.apply_symm_apply, singularCohomologyAddCircleProdSlantEquiv_symm_apply]
  exact (singularCupPairing_addCircle_singularHomologyCross y b b c c).trans (two_mul _).symm

/-- **The cup pairing on `H²((ℝ / pℤ) × Y; ℤ)` against `[ℝ / pℤ] × y` is even**, for every space
`Y`. When `y` is the fundamental class of a closed oriented three-manifold `Y`, this says that the
intersection form of `(ℝ / pℤ) × Y` is even, so no class has square `-1`. -/
theorem even_singularCupPairing_self_addCircle_singularHomologyCross
    (y : ((singularHomologyFunctor (ModuleCat.{0} ℤ) 3).obj (𝟙_ (ModuleCat.{0} ℤ))).obj Y)
    (x : (TopCat.of (AddCircle p) ⊗ Y).singularCohomology (𝟙_ (ModuleCat.{0} ℤ)) ℤ
      (𝟙_ (ModuleCat.{0} ℤ)) 2) :
    Even ((TopCat.of (AddCircle p) ⊗ Y).singularCupPairing ℤ (p := 2) (q := 2) (n := 4) rfl
        (((singularHomologyFunctor (ModuleCat.{0} ℤ) 4).map (λ_ (𝟙_ (ModuleCat.{0} ℤ))).hom).app
          (TopCat.of (AddCircle p) ⊗ Y)
          (singularHomologyCross (TopCat.of (AddCircle p)) Y (𝟙_ (ModuleCat.{0} ℤ))
            (𝟙_ (ModuleCat.{0} ℤ)) 1 3 4 rfl (AddCircle.fundamentalClass p ⊗ₜ y))) x x) := by
  rw [singularCupPairing_self_addCircle_singularHomologyCross 0]
  exact even_two_mul _

end IntersectionForm

end TopCat
