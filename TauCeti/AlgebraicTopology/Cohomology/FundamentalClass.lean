module

public import TauCeti.AlgebraicTopology.Cohomology.Kronecker
public import TauCeti.AlgebraicTopology.Singular.LocalHomology.FundamentalClass

/-!
# Evaluating cohomology classes on fundamental classes

Let `N` be a compact topological `n`-manifold without boundary with an orientation `o`
(`TauCeti.HomologicalOrientation N E n`), and let `f : N → X` be a continuous map to a space `X`.
The fundamental class `[N] ∈ Hₙ(N; ℤ)` pushes forward to a class `f_*[N] ∈ Hₙ(X; ℤ)`, and a
cohomology class `c ∈ Hⁿ(X; M)` with coefficients in an abelian group `M` can be evaluated on it
through the Kronecker map, giving `⟨c, f_*[N]⟩ ∈ M`. For `n = 2` and an embedded closed oriented
surface `f : S → X`, this is the evaluation of a degree-two class on the surface, as in the
Euler-class inequalities for foliations of `3`-manifolds, where `c` is the Euler class of the
tangent plane field.

The pairing is natural: evaluating `c` on the image of `[N]` under `f` is evaluating the pull-back
`f^* c` on `[N]` itself, and for a further map `g : X → Y`, evaluating `c` on `(g ∘ f)_*[N]` is
evaluating `g^* c` on `f_*[N]`. The class `f_*[N]`, and so the pairing, depends only on the
homotopy class of `f`, and reversing the orientation of `N` negates both.

The pairing is non-degenerate on the manifold itself. If `N` is moreover connected and `M` is an
injective abelian group, such as `ℚ` or `ℚ / ℤ`, then `c ↦ ⟨c, [N]⟩` is a bijection
`Hⁿ(N; M) → M`: the Kronecker map is an isomorphism `Hⁿ(N; M) ≃ Hom(Hₙ(N; ℤ), M)` for injective
coefficients (`TopCat.singularKroneckerEquiv`), and `Hₙ(N; ℤ)` is freely generated by `[N]`
(`TauCeti.HomologicalOrientation.fundamentalClassEquiv`).

## Main definitions

* `TauCeti.HomologicalOrientation.mapFundamentalClass`: the image `f_*[N] ∈ Hₙ(X; ℤ)` of the
  fundamental class under a continuous map `f : N → X`.
* `TauCeti.HomologicalOrientation.evalFundamentalClass`: the `ℤ`-linear evaluation
  `c ↦ ⟨c, f_*[N]⟩` of `Hⁿ(X; M)` on that class.

## Main results

* `TauCeti.HomologicalOrientation.evalFundamentalClass_id_singularCohomologyMap`:
  `⟨f^* c, [N]⟩ = ⟨c, f_*[N]⟩`.
* `TauCeti.HomologicalOrientation.evalFundamentalClass_comp`: `⟨c, (g ∘ f)_*[N]⟩ = ⟨g^* c, f_*[N]⟩`.
* `TauCeti.HomologicalOrientation.mapFundamentalClass_eq_of_homotopic` and
  `TauCeti.HomologicalOrientation.evalFundamentalClass_eq_of_homotopic`: homotopic maps carry the
  fundamental class to the same class, and so give the same pairing.
* `TauCeti.HomologicalOrientation.evalFundamentalClass_neg`: reversing the orientation negates the
  pairing.
* `TauCeti.HomologicalOrientation.evalFundamentalClass_id_bijective`: for a compact connected
  oriented manifold and injective coefficients, evaluation on the fundamental class is a bijection
  `Hⁿ(N; M) → M`.

## Implementation notes

The manifold `N` and the target space `X` live in `Type`, as for
`TauCeti.HomologicalOrientation.fundamentalClass`, and homology has the integral coefficients
`ModuleCat.of ℤ (ULift ℤ)` used there.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 3.1 (the Kronecker pairing and the universal coefficient theorem) and Section 3.3
  (fundamental classes).
* D. Calegari, *Foliations and the Geometry of 3-Manifolds*, Oxford (2007), Chapter 6 (the Euler
  class of a taut foliation evaluated on surfaces).
-/

public section

noncomputable section

open AlgebraicTopology CategoryTheory Module

namespace TauCeti

namespace HomologicalOrientation

variable {N E : Type} [TopologicalSpace N] [T2Space N]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ChartedSpace E N]
  [CompactSpace N] {n : ℕ} (o : HomologicalOrientation N E n) (hn : finrank ℝ E = n)
  {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y] (M : ModuleCat.{0} ℤ)

/-- The image `f_*[N] ∈ Hₙ(X; ℤ)` of the fundamental class of a compact oriented manifold `N` under
a continuous map `f : N → X`: the homology class carried by the singular manifold `f`. -/
def mapFundamentalClass (f : C(N, X)) :
    ((singularHomologyFunctor (ModuleCat.{0} ℤ) n).obj (ModuleCat.of ℤ (ULift.{0} ℤ))).obj
      (TopCat.of X) :=
  (((singularHomologyFunctor (ModuleCat.{0} ℤ) n).obj (ModuleCat.of ℤ (ULift.{0} ℤ))).map
    (TopCat.ofHom f)).hom (o.fundamentalClass hn)

theorem mapFundamentalClass_def (f : C(N, X)) :
    o.mapFundamentalClass hn f =
      (((singularHomologyFunctor (ModuleCat.{0} ℤ) n).obj (ModuleCat.of ℤ (ULift.{0} ℤ))).map
        (TopCat.ofHom f)).hom (o.fundamentalClass hn) :=
  (rfl)

/-- The image of the fundamental class under the identity is the fundamental class. -/
@[simp]
theorem mapFundamentalClass_id : o.mapFundamentalClass hn (ContinuousMap.id N) =
    o.fundamentalClass hn := by
  rw [mapFundamentalClass_def, TopCat.ofHom_id, CategoryTheory.Functor.map_id]
  -- The identity morphism acts as the identity; its source is read as `SSet.homology`.
  rfl

/-- The image of the fundamental class under a composite `g ∘ f` is the image under `g` of its
image under `f`. -/
theorem mapFundamentalClass_comp (g : C(X, Y)) (f : C(N, X)) :
    o.mapFundamentalClass hn (g.comp f) =
      (((singularHomologyFunctor (ModuleCat.{0} ℤ) n).obj (ModuleCat.of ℤ (ULift.{0} ℤ))).map
        (TopCat.ofHom g)).hom (o.mapFundamentalClass hn f) := by
  rw [mapFundamentalClass_def, mapFundamentalClass_def, TopCat.ofHom_comp,
    CategoryTheory.Functor.map_comp]
  -- The fundamental class lives in `SSet.homology`, which `rw` does not see through.
  rfl

/-- **Homotopy invariance**: homotopic maps carry the fundamental class to the same class. -/
theorem mapFundamentalClass_eq_of_homotopic {f g : C(N, X)} (h : f.Homotopic g) :
    o.mapFundamentalClass hn f = o.mapFundamentalClass hn g := by
  rw [mapFundamentalClass_def, mapFundamentalClass_def]
  congr 2
  exact TopCat.Homotopy.congr_homologyMap_singularChainComplexFunctor (C := ModuleCat.{0} ℤ)
    (f := TopCat.ofHom f) (g := TopCat.ofHom g) h.some _ n

/-- Reversing the orientation negates the image of the fundamental class. -/
@[simp]
theorem mapFundamentalClass_neg (f : C(N, X)) :
    (-o).mapFundamentalClass hn f = -o.mapFundamentalClass hn f := by
  rw [mapFundamentalClass_def, mapFundamentalClass_def, fundamentalClass_neg]
  exact map_neg _ _

/-- **The evaluation of a cohomology class on the image of a fundamental class**: for a compact
oriented `n`-manifold `N` and a continuous map `f : N → X`, the `ℤ`-linear map
`Hⁿ(X; M) → M`, `c ↦ ⟨c, f_*[N]⟩`, the Kronecker pairing of `c` with
`TauCeti.HomologicalOrientation.mapFundamentalClass`. -/
def evalFundamentalClass (f : C(N, X)) :
    (TopCat.of X).singularCohomology (ModuleCat.of ℤ (ULift.{0} ℤ)) ℤ M n →ₗ[ℤ] M :=
  { toFun c := ((TopCat.of X).singularKronecker (R := ModuleCat.of ℤ (ULift.{0} ℤ)) (M := M) ℤ n
        c).hom (o.mapFundamentalClass hn f)
    map_add' c d := by simp
    map_smul' a c := by
      simp only [map_smul, ModuleCat.hom_smul, LinearMap.smul_apply, RingHom.id_apply]
      -- The two sides use `zsmul` and the given `ℤ`-module structure of `M`, respectively.
      exact (int_smul_eq_zsmul _ _ _).symm }

/-- The evaluation on `f_*[N]` is the Kronecker map applied to `f_*[N]`. -/
theorem evalFundamentalClass_apply (f : C(N, X))
    (c : (TopCat.of X).singularCohomology (ModuleCat.of ℤ (ULift.{0} ℤ)) ℤ M n) :
    o.evalFundamentalClass hn M f c =
      ((TopCat.of X).singularKronecker ℤ n c).hom (o.mapFundamentalClass hn f) :=
  (rfl)

/-- **Functoriality of the pairing**, `⟨c, (g ∘ f)_*[N]⟩ = ⟨g^* c, f_*[N]⟩`. -/
theorem evalFundamentalClass_comp (g : C(X, Y)) (f : C(N, X))
    (c : (TopCat.of Y).singularCohomology (ModuleCat.of ℤ (ULift.{0} ℤ)) ℤ M n) :
    o.evalFundamentalClass hn M (g.comp f) c =
      o.evalFundamentalClass hn M f (TopCat.singularCohomologyMap (TopCat.ofHom g) n c) := by
  rw [evalFundamentalClass_apply, evalFundamentalClass_apply, mapFundamentalClass_comp,
    TopCat.singularKronecker_naturality]
  -- Both sides are the Kronecker map of `c` applied to `g_* (f_*[N])`; the composite morphism is
  -- applied as a composite of linear maps.
  rfl

/-- **Naturality of the pairing**, `⟨f^* c, [N]⟩ = ⟨c, f_*[N]⟩`: evaluating the pull-back of a
class on the fundamental class is evaluating the class itself on the image of the fundamental
class. -/
@[simp]
theorem evalFundamentalClass_id_singularCohomologyMap (f : C(N, X))
    (c : (TopCat.of X).singularCohomology (ModuleCat.of ℤ (ULift.{0} ℤ)) ℤ M n) :
    o.evalFundamentalClass hn M (ContinuousMap.id N)
        (TopCat.singularCohomologyMap (TopCat.ofHom f) n c) =
      o.evalFundamentalClass hn M f c := by
  simpa using (o.evalFundamentalClass_comp hn M f (ContinuousMap.id N) c).symm

/-- **Homotopy invariance of the pairing**: homotopic maps give the same evaluation. -/
theorem evalFundamentalClass_eq_of_homotopic {f g : C(N, X)} (h : f.Homotopic g) :
    o.evalFundamentalClass hn M f = o.evalFundamentalClass hn M g := by
  ext c
  rw [evalFundamentalClass_apply, evalFundamentalClass_apply,
    o.mapFundamentalClass_eq_of_homotopic hn h]

/-- Reversing the orientation negates the pairing. -/
@[simp]
theorem evalFundamentalClass_neg (f : C(N, X)) :
    (-o).evalFundamentalClass hn M f = -o.evalFundamentalClass hn M f := by
  ext c
  rw [evalFundamentalClass_apply, LinearMap.neg_apply, evalFundamentalClass_apply,
    mapFundamentalClass_neg, map_neg]

/-- **Evaluation on the fundamental class is an isomorphism for injective coefficients.** For a
compact connected oriented `n`-manifold `N` and an injective abelian group `M`, such as `ℚ`, the
map `Hⁿ(N; M) → M`, `c ↦ ⟨c, [N]⟩`, is bijective. -/
theorem evalFundamentalClass_id_bijective [ConnectedSpace N] [CategoryTheory.Injective M] :
    Function.Bijective (o.evalFundamentalClass hn M (ContinuousMap.id N)) := by
  -- Evaluation at `[N]` is evaluation at `1` after transport along `ℤ ≃ Hₙ(N; ℤ)`, `1 ↦ [N]`.
  -- The ascription reads the target of `fundamentalClassEquiv` as the source of the Kronecker map.
  let e : ℤ ≃ₗ[ℤ]
      ((singularHomologyFunctor (ModuleCat.{0} ℤ) n).obj (ModuleCat.of ℤ (ULift.{0} ℤ))).obj
        (TopCat.of N) :=
    o.fundamentalClassEquiv hn
  have hcomp : Function.Bijective fun ψ :
      ((singularHomologyFunctor (ModuleCat.{0} ℤ) n).obj (ModuleCat.of ℤ (ULift.{0} ℤ))).obj
        (TopCat.of N) →ₗ[ℤ] M ↦ ψ ∘ₗ e.toLinearMap :=
    ⟨fun ψ ψ' h ↦ LinearMap.ext fun x ↦ by
        simpa only [LinearMap.comp_apply, LinearEquiv.coe_coe, e.apply_symm_apply] using
          LinearMap.congr_fun h (e.symm x),
      fun χ ↦ ⟨χ ∘ₗ e.symm.toLinearMap, LinearMap.ext fun x ↦ by
        simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, e.symm_apply_apply]⟩⟩
  have heval : Function.Bijective fun χ : ℤ →ₗ[ℤ] M ↦ χ 1 :=
    ⟨fun _ _ h ↦ LinearMap.ext_ring h,
      fun m ↦ ⟨LinearMap.toSpanSingleton ℤ M m, LinearMap.toSpanSingleton_apply_one ℤ M m⟩⟩
  convert heval.comp (hcomp.comp (ModuleCat.homEquiv.bijective.comp
    ((TopCat.of N).singularKroneckerEquiv ℤ n).bijective)) using 1
  ext c
  have he : e 1 = o.fundamentalClass hn :=
    (o.fundamentalClassEquiv_apply hn 1).trans (one_smul ℤ _)
  simp [evalFundamentalClass_apply, he]
  -- `ModuleCat.homEquiv` is `ModuleCat.Hom.hom`.
  rfl

end HomologicalOrientation

end TauCeti
