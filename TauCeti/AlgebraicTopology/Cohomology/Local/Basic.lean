module

public import TauCeti.AlgebraicTopology.Cohomology.UniversalCoefficient
public import TauCeti.AlgebraicTopology.Singular.LocalHomology.Basic

/-!
# Local cohomology at a point with a Euclidean chart

Let `M` be a `T₁` space and `x : M` a point in the source of an open partial homeomorphism
`φ : M → E` to a finite-dimensional real normed space of dimension `d`, such as a chart of a
topological manifold, or the identity of `E` itself. The **local cohomology** of `M` at `x` is the
relative singular cohomology `Hⁿ(M, M ∖ {x}; R, N)`. This file computes it over a commutative ring
`k`, for a projective coefficient module `R` and any module `N`: it vanishes for `n ≠ d`, and in
degree `d` it is `Hom(R, N)`, so for `R = k` it is one copy of `N`.

The local homology `Hₙ(M, M ∖ {x}; R)` is `R` in degree `d` and zero otherwise
(`TauCeti.singularHomologyComplSingletonFinrankIso` and
`TauCeti.isZero_singularHomology_complSingleton_of_ne`), so it is projective in every degree, and
the relative universal coefficient theorem `TopPair.singularKroneckerEquivOfProjectiveHomology`
identifies local cohomology with the dual of local homology.

For a real vector space `F` of dimension `r` and `x = 0`, the pair `(F, F ∖ {0})` is the fibre pair
of a vector bundle with fibre `F`, so `Hʳ(F, F ∖ {0}; k, k) ≅ k` is the group in which a Thom class
of the bundle restricts to a generator on every fibre.

## Main definitions and results

* `TauCeti.projective_singularHomology_complSingleton`: local homology is projective in every
  degree.
* `TauCeti.singularCohomologyComplSingletonKroneckerEquiv`: the relative Kronecker map
  `Hⁿ(M, M ∖ {x}; R, N) ≃ₗ[k] (Hₙ(M, M ∖ {x}; R) ⟶ N)`.
* `TauCeti.isZero_singularCohomology_complSingleton_of_ne`: `Hⁿ(M, M ∖ {x}; R, N) = 0` for
  `n ≠ d`.
* `TauCeti.singularCohomologyComplSingletonFinrankEquiv`:
  `Hᵈ(M, M ∖ {x}; R, N) ≃ₗ[k] (R ⟶ N)`.
* `TauCeti.singularCohomologyComplSingletonFinrankEquivSelf`:
  `Hᵈ(M, M ∖ {x}; k, N) ≃ₗ[k] N`.
* `TauCeti.exists_span_singularCohomology_complSingleton_eq_top`: `Hᵈ(M, M ∖ {x}; k, k)` is
  generated by a single class.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Section 3.1 (the universal coefficient theorem) and Section 3.3 (local homology and local
  orientations).
-/

public section

noncomputable section

open CategoryTheory Limits Module

universe w

namespace TauCeti

section GeneralCoefficients

variable {k : Type*} [CommRing k] (R N : ModuleCat.{w} k) [Module.Projective k R]
  {M : Type w} [TopologicalSpace M] [T1Space M] {E : Type w} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [FiniteDimensional ℝ E] (φ : OpenPartialHomeomorph M E) {x : M}
  (hx : x ∈ φ.source)

include hx in
/-- **Local homology is projective**: at a point with a chart to a finite-dimensional real normed
space, the local homology `Hₙ(M, M ∖ {x}; R)` with projective coefficients `R` is projective in
every degree, being `R` in the top degree and zero otherwise. -/
theorem projective_singularHomology_complSingleton (n : ℕ) :
    Projective ((TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularHomology R n) := by
  obtain rfl | hn := eq_or_ne n (finrank ℝ E)
  · exact Projective.of_iso (singularHomologyComplSingletonFinrankIso R φ hx).symm inferInstance
  · exact (isZero_singularHomology_complSingleton_of_ne R φ hx rfl hn).projective

/-- **Local cohomology is the dual of local homology**: at a point with a chart to a
finite-dimensional real normed space, the relative Kronecker map is a `k`-linear equivalence
`Hⁿ(M, M ∖ {x}; R, N) ≃ₗ[k] (Hₙ(M, M ∖ {x}; R) ⟶ N)`, for projective coefficients `R`. -/
def singularCohomologyComplSingletonKroneckerEquiv (n : ℕ) :
    (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularCohomology R k N n ≃ₗ[k]
      ((TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularHomology R n ⟶ N) :=
  haveI := projective_singularHomology_complSingleton R φ hx
  TopPair.singularKroneckerEquivOfProjectiveHomology _ R N n

/-- The equivalence `TauCeti.singularCohomologyComplSingletonKroneckerEquiv` is the relative
Kronecker map. -/
@[simp]
lemma singularCohomologyComplSingletonKroneckerEquiv_apply (n : ℕ)
    (α : (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularCohomology R k N n) :
    singularCohomologyComplSingletonKroneckerEquiv R N φ hx n α =
      (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularKronecker k n α :=
  haveI := projective_singularHomology_complSingleton R φ hx
  TopPair.singularKroneckerEquivOfProjectiveHomology_apply _ R N n α

include hx in
/-- **Local cohomology vanishes outside the dimension**: at a point with a chart to a real normed
space of finite dimension `d`, the local cohomology `Hⁿ(M, M ∖ {x}; R, N)` vanishes for `n ≠ d`,
for projective coefficients `R` and any coefficient module `N`. -/
theorem isZero_singularCohomology_complSingleton_of_ne {d n : ℕ} (h : finrank ℝ E = d)
    (hn : n ≠ d) :
    IsZero ((TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularCohomology R k N n) := by
  have hZ := isZero_singularHomology_complSingleton_of_ne R φ hx h hn
  have : Subsingleton
      ((TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularHomology R n ⟶ N) :=
    ⟨fun f g ↦ hZ.eq_of_src f g⟩
  exact ModuleCat.isZero_of_subsingleton _ |>.of_iso
    (singularCohomologyComplSingletonKroneckerEquiv R N φ hx n).toModuleIso

/-- **Local cohomology in the top degree**: at a point with a chart to a real normed space of
dimension `d`, the local cohomology `Hᵈ(M, M ∖ {x}; R, N)` is `Hom(R, N)`, for projective
coefficients `R`. It is the relative Kronecker map followed by precomposition with the inverse of
`TauCeti.singularHomologyComplSingletonFinrankIso`. -/
def singularCohomologyComplSingletonFinrankEquiv :
    (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularCohomology R k N (finrank ℝ E) ≃ₗ[k]
      (R ⟶ N) :=
  singularCohomologyComplSingletonKroneckerEquiv R N φ hx (finrank ℝ E) ≪≫ₗ
    Linear.homCongr k (singularHomologyComplSingletonFinrankIso R φ hx) (Iso.refl N)

/-- `TauCeti.singularCohomologyComplSingletonFinrankEquiv` sends a class to its relative Kronecker
map precomposed with the inverse of the local-homology isomorphism
`TauCeti.singularHomologyComplSingletonFinrankIso`. -/
lemma singularCohomologyComplSingletonFinrankEquiv_apply
    (α : (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularCohomology R k N (finrank ℝ E)) :
    singularCohomologyComplSingletonFinrankEquiv R N φ hx α =
      (singularHomologyComplSingletonFinrankIso R φ hx).inv ≫
        (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularKronecker k (finrank ℝ E) α := by
  rw [singularCohomologyComplSingletonFinrankEquiv, LinearEquiv.trans_apply,
    singularCohomologyComplSingletonKroneckerEquiv_apply, Linear.homCongr_apply]
  simp

end GeneralCoefficients

variable {k : Type w} [CommRing k] (N : ModuleCat.{w} k)
  {M : Type w} [TopologicalSpace M] [T1Space M] {E : Type w} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [FiniteDimensional ℝ E] (φ : OpenPartialHomeomorph M E) {x : M}
  (hx : x ∈ φ.source)

/-- **Local cohomology with coefficients in the ring**: at a point with a chart to a real normed
space of dimension `d`, the local cohomology `Hᵈ(M, M ∖ {x}; k, N)` is one copy of `N`. A class is
sent to its Kronecker pairing with the generator of `H_d(M, M ∖ {x}; k)` given by
`TauCeti.singularHomologyComplSingletonFinrankIso`. -/
def singularCohomologyComplSingletonFinrankEquivSelf :
    (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularCohomology (ModuleCat.of k k) k N
        (finrank ℝ E) ≃ₗ[k] N :=
  singularCohomologyComplSingletonFinrankEquiv (ModuleCat.of k k) N φ hx ≪≫ₗ
    ModuleCat.homLinearEquiv ≪≫ₗ LinearMap.ringLmapEquivSelf k k N

/-- `TauCeti.singularCohomologyComplSingletonFinrankEquivSelf` evaluates the relative Kronecker
map of a class on the generator of `H_d(M, M ∖ {x}; k)`. -/
lemma singularCohomologyComplSingletonFinrankEquivSelf_apply
    (α : (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularCohomology (ModuleCat.of k k) k N
      (finrank ℝ E)) :
    singularCohomologyComplSingletonFinrankEquivSelf N φ hx α =
      ((singularHomologyComplSingletonFinrankIso (ModuleCat.of k k) φ hx).inv ≫
        (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularKronecker k (finrank ℝ E) α).hom
          (1 : k) := by
  rw [singularCohomologyComplSingletonFinrankEquivSelf, LinearEquiv.trans_apply,
    LinearEquiv.trans_apply, singularCohomologyComplSingletonFinrankEquiv_apply,
    ModuleCat.homLinearEquiv_apply, LinearMap.ringLmapEquivSelf_apply]
  -- `ModuleCat.homAddEquiv` is `ModuleCat.Hom.hom` by definition, and has no `apply` lemma.
  rfl

include hx in
/-- **Local cohomology is cyclic**: at a point with a chart to a real normed space of dimension
`d`, the local cohomology `Hᵈ(M, M ∖ {x}; k, k)` is generated by a single class. -/
theorem exists_span_singularCohomology_complSingleton_eq_top :
    ∃ u : (TopPair.ofSubset ({x}ᶜ : Set (TopCat.of M))).singularCohomology (ModuleCat.of k k) k
        (ModuleCat.of k k) (finrank ℝ E), Submodule.span k {u} = ⊤ := by
  let e := singularCohomologyComplSingletonFinrankEquivSelf (ModuleCat.of k k) φ hx
  refine ⟨e.symm 1, Submodule.eq_top_iff'.2 fun v ↦ Submodule.mem_span_singleton.2 ⟨e v, ?_⟩⟩
  rw [← map_smul, smul_eq_mul, mul_one, e.symm_apply_apply]

end TauCeti
