module

public import TauCeti.AlgebraicTopology.Singular.Fibration.FundamentalClass
public import TauCeti.AlgebraicTopology.Sphere.Abundant.Basic
import TauCeti.Topology.MappingSpace.Fibration

/-!
# Abundance with 2-spheres from a fibered family of 2-spheres

Barraud, Damian, Humilière and Oancea call a **fibered family of 2-spheres** in a closed manifold
`Q` (their Definition 6.14) a commutative square

```
Σ ──σ──→ Map(S², Q)
│π           │ev
Q ═════════ Q
```

in which `π` is a fibration of closed oriented manifolds with fibre `Σ_b` over `b`, `ev` is
evaluation at the north pole of `S²`, and the restriction `σ_b : Σ_b → Map_*(S², Q) = Ω²Q` of `σ`
to the fibres sends the fundamental class of `Σ_b` to a nonzero class. Their Proposition 6.15
says that `Q` is then abundant with 2-spheres
(`TauCeti.isAbundantWithTwoSpheres_of_isFundamentalClass`): the witness is `σ_* [Σ]`, which lives
over the fundamental class of `Q` because the shriek map of the inclusion of `b` sends `[Σ]` to
`±[Σ_b]` (`TauCeti.IsFundamentalClass.livesOverFundamentalClass_homologyMap`).

The statement below asks of `Σ` only that it be a manifold, of dimension `d + n` over the
`n`-manifold `Q`, carrying an integral fundamental class, and of `π` that it be a Serre fibration.
Of the fibre `Σ_b` it asks that its homology in degree `d` be infinite cyclic, generated by a class
`ν` with `σ_b* ν ≠ 0`; for a closed connected oriented fibre, `ν` is its fundamental class. No
orientation of `Q` and no compatibility of orientations is needed, since the shriek of `[Σ]` is
a generator, so `±ν`, whatever the orientations. The fibre is required to have positive dimension
`d`, so that the witness has degree above `n`. In degree `n`, Definition 6.11 also asks that the
witness not come from constant spheres, which this statement does not address.

The families of the source's Examples 6.16 and 6.20 are `TauCeti.stiefelSphereFamily` and
`TauCeti.twoFieldSphereFamily`.

## Main results

* `TauCeti.isAbundantWithTwoSpheres_of_isFundamentalClass`: a manifold carrying a fibered family of
  2-spheres with fibres of positive dimension is abundant with 2-spheres.

## References

* J.-F. Barraud, M. Damian, V. Humilière, A. Oancea, *Floer homology with DG coefficients.
  Applications to cotangent bundles*, arXiv:2404.07953, §6.4.2, Definitions 6.11 and 6.14 and
  Proposition 6.15.
-/

public section

noncomputable section

open CategoryTheory Module

namespace TauCeti

variable {V W : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
  [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]
  {Q : Type} [TopologicalSpace Q] [T1Space Q] [ChartedSpace V Q]
  {S : Type} [TopologicalSpace S] [T1Space S] [ChartedSpace W S]

/-- **Abundance from a fibered family of 2-spheres** (Barraud–Damian–Humilière–Oancea,
Proposition 6.15). Let `Q` be an `n`-manifold and `Σ` a `(d + n)`-manifold with an integral
fundamental class `μ`, let `π : Σ → Q` be a Serre fibration, and let `σ : Σ → Map(S², Q)` lie over
`Q` for evaluation at the north pole. Suppose that the homology `H_d(Σ_b; ℤ)` of the fibre over
`b` is infinite cyclic, generated by a class `ν` that the restriction `Σ_b → ev⁻¹(b)` of `σ` does
not kill. If `0 < d`, then `Q` is abundant with 2-spheres at `b`, witnessed by `σ_* μ`. -/
theorem isAbundantWithTwoSpheres_of_isFundamentalClass {π : C(S, Q)}
    {σ : C(S, C(Sphere2, Q))} (hσ : (mappingSpaceEval Sphere2.north).comp σ = π) {b : Q}
    (hπ : TopCat.serreFibrations (TopCat.ofHom π)) {d : ℕ} (hd : 0 < d)
    (hW : finrank ℝ W = d + finrank ℝ V)
    {μ : ((TopCat.toSSet.obj (TopCat.of S)).homology (ModuleCat.of ℤ (ULift.{0} ℤ))
      (d + finrank ℝ V) : ModuleCat.{0} ℤ)} (hμ : IsFundamentalClass μ) {y : S} (hy : π y = b)
    (ψ : (((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} ℤ) d).obj
      (ModuleCat.of ℤ (ULift.{0} ℤ))).obj (TopCat.of (π ⁻¹' {b})) : ModuleCat.{0} ℤ) ≃ₗ[ℤ] ℤ)
    {ν : (((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} ℤ) d).obj
      (ModuleCat.of ℤ (ULift.{0} ℤ))).obj (TopCat.of (π ⁻¹' {b})) : ModuleCat.{0} ℤ)}
    (hν : Submodule.span ℤ {ν} = ⊤)
    (hσν : (((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} ℤ) d).obj
      (ModuleCat.of ℤ (ULift.{0} ℤ))).map (TopCat.ofHom (restrictPreimageMap {b} hσ))).hom ν ≠
        0) :
    IsAbundantWithTwoSpheres Q (finrank ℝ V) b := by
  have hf : TopCat.ofHom σ ≫ TopCat.ofHom (mappingSpaceEval (X := Q) Sphere2.north) =
      TopCat.ofHom π := by
    rw [← TopCat.ofHom_comp, hσ]
  have hev : TopCat.serreFibrations (TopCat.ofHom (mappingSpaceEval (X := Q) Sphere2.north)) :=
    IsHurewiczFibration.mem_serreFibrations
      (isHurewiczFibration_mappingSpaceEval_sphere.{0} 2 Sphere2.north)
  -- On the fibres over `b`, `σ` restricts to `restrictPreimageMap {b} hσ`.
  have hres : (TopCat.ofHom σ).preimageMap hf {b} = TopCat.ofHom (restrictPreimageMap {b} hσ) :=
    TopCat.ext fun x ↦ Subtype.ext (((TopCat.ofHom σ).coe_preimageMap_apply hf {b} x).trans
      (coe_restrictPreimageMap {b} hσ x).symm)
  -- The local homology of `Σ` at `y` is a copy of `ℤ`, `Σ` being a `(d + n)`-manifold.
  let φ := localHomologySingletonLinearEquiv (ModuleCat.of ℤ (ULift.{0} ℤ)) hW
    ULift.moduleEquiv y
  exact isAbundantWithTwoSpheres_of_lt
    (IsFundamentalClass.livesOverFundamentalClass_homologyMap (chartAt V b)
      (mem_chart_source V b) rfl hy hf φ ψ hπ hev hμ hν (by rwa [hres])) (by omega)

end TauCeti
