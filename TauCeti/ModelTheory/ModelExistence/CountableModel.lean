module

public import TauCeti.ModelTheory.ModelExistence.LowenheimSkolem
public import TauCeti.ModelTheory.Infinitary.Satisfiability
public import TauCeti.ModelTheory.Infinitary.Sublanguage

/-!
# Countable models of countable `L_{ω₁ω}` theories

A nonempty model of a countable `L_{ω₁ω}` theory `T`, of any cardinality and in any universe, gives
a countable nonempty model of `T` in every universe. The language may have any number of symbols.
The proof passes to the sublanguage of the function symbols occurring in `T`, of which there are
countably many, takes a countable substructure containing a chosen element that is elementary for
the fragment generated by `T`, moves it into the target universe, and expands it back to `L` on its
nonempty carrier. The chosen element matters: without it the substructure can be empty, for
instance for `T = {⊤}` over a language without constants.

Consequently satisfiability and entailment of countable theories can be tested on countable
models in any one universe. The universe `max u v` fixed in `Theoryω.IsSatisfiable` and
`Theoryω.Entails` is a normalization, not a restriction: a sentence entailed by a countable theory
holds in every nonempty model of the theory, whatever its cardinality and universe. This is what
lets entailment move between languages in different universes. A language map preserves entailment
by countable theories, and an injective one also reflects it.

## Main results

* `FirstOrder.Language.Theoryω.Model.exists_countable_model`: a nonempty model of a countable theory
  gives a countable nonempty model in any universe.
* `FirstOrder.Language.Theoryω.exists_countable_model`: a satisfiable countable theory has a
  countable nonempty model in any universe.
* `FirstOrder.Language.Theoryω.Entails.realize`: a sentence entailed by a countable theory holds in
  every nonempty model of the theory, in any universe.
* `FirstOrder.Language.Theoryω.entails_iff_countable`: a countable theory entails a sentence exactly
  when every countable nonempty model of the theory in a given universe satisfies it.
* `FirstOrder.Language.Sentenceω.Entails.realize` and
  `FirstOrder.Language.Sentenceω.entails_iff_countable`: the same for entailment between sentences.
* `FirstOrder.Language.Theoryω.Entails.onTheoryω` and
  `FirstOrder.Language.Theoryω.entails_onTheoryω_iff`: language maps preserve entailment by
  countable theories, and injective ones reflect it.
* `FirstOrder.Language.Sentenceω.Entails.onBoundedFormulaInf` and
  `FirstOrder.Language.Sentenceω.entails_onBoundedFormulaInf_iff`: the same for entailment between
  sentences.

## References

* D. Marker, *Lectures on Infinitary Model Theory*, Cambridge University Press, 2016, Chapter 1
  (downward Löwenheim–Skolem for countable fragments).
* `cameronfreer/infinitary-logic` at commit `518a366cba97b1ae8c4dc64a297a396939bc3e0b`,
  `InfinitaryLogic/ModelTheory/LowenheimSkolem.lean`, proves a sentence-level downward
  Löwenheim–Skolem theorem for `Language.{0, 0}` and models in `Type` through its consistency
  property. Divergences from that source: here the countable model comes from the
  fragment Löwenheim–Skolem theorem `exists_countable_aElementary_substructure`, the language and
  both model universes are arbitrary, and the universe invariance of entailment and its transfer
  along language maps are new.
* The transfer of entailment along language maps follows Mathlib's first-order
  `Theory.isSatisfiable_of_isSatisfiable_onTheory` and `Theory.isSatisfiable_onTheory_iff`.
-/

public section

universe u v u' v' w w'

namespace FirstOrder

namespace Language

variable {L : Language.{u, v}}

namespace Theoryω

variable {T : L.Theoryω} {φ : L.Sentenceω}

/-- The countable case of `Theoryω.Model.exists_countable_model`: with countably many function
symbols, a countable substructure elementary for the fragment of `T` is already a model. -/
private theorem Model.exists_countable_model_of_countable_functions
    [Countable (Σ n, L.Functions n)] (hT : T.Countable) {M : Type w} [L.Structure M] [Nonempty M]
    (h : T.Model M) :
    ∃ (N : Type w') (_ : L.Structure N), Countable N ∧ Nonempty N ∧ T.Model N := by
  obtain ⟨m⟩ := ‹Nonempty M›
  obtain ⟨N, hmN, hN, _⟩ := exists_countable_aElementary_substructure (Fragment.ofTheory T)
    (Fragment.ofTheory_countable hT) (Set.countable_singleton m)
  -- move the countable substructure into the universe `w'`
  let e : N ≃ Shrink.{w'} N := equivShrink.{w'} N
  let : L.Structure (Shrink.{w'} N) := e.inducedStructure
  refine ⟨Shrink.{w'} N, inferInstance, e.symm.injective.countable, ⟨e ⟨m, hmN rfl⟩⟩, ?_⟩
  rw [← StrongHomClass.theoryω_model_iff e.inducedStructureEquiv,
    ← hN.theoryω_model_iff fun _ => Fragment.mem_ofTheory]
  exact h

/-- **Downward Löwenheim–Skolem for countable theories.** A nonempty model of a countable theory,
of any cardinality and in any universe, gives a countable nonempty model of the theory in every
universe `w'`. The language may have any number of symbols. -/
theorem Model.exists_countable_model (hT : T.Countable) {M : Type w} [L.Structure M] [Nonempty M]
    (h : T.Model M) :
    ∃ (N : Type w') (_ : L.Structure N), Countable N ∧ Nonempty N ∧ T.Model N := by
  classical
  -- `T` is the image of a theory `T₀` of the sublanguage of its function symbols
  let F : Set (Σ n, L.Functions n) := ⋃ φ ∈ T, φ.functionsIn
  let R : Set (Σ n, L.Relations n) := Set.univ
  have hF : ∀ φ ∈ T, φ.functionsIn ⊆ F := fun _ hφ => Set.subset_biUnion_of_mem hφ
  have : Countable F := (hT.biUnion fun φ _ => φ.functionsIn_countable).to_subtype
  have : Countable T := hT.to_subtype
  let ι := symbSublangIncl F R
  let T₀ : (symbSublang F R).Theoryω :=
    Set.range fun φ : T => φ.1.restrictSymbols (hF φ.1 φ.2) (Set.subset_univ _)
  have hT₀ : ι.onTheoryω T₀ = T := by
    ext φ
    simp [T₀, ι, LHom.onTheoryω_def, ← Set.range_comp]
  let : (symbSublang F R).Structure M := ι.reduct M
  obtain ⟨N, _, hNc, hN, hNT₀⟩ := Model.exists_countable_model_of_countable_functions.{u, v, w, w'}
    (Set.countable_range _) ((ι.onTheoryω_model T₀).1 (hT₀ ▸ h))
  -- expand the countable model back to `L`, interpreting the missing symbols arbitrarily
  have : Inhabited N := Classical.inhabited_of_nonempty hN
  let : L.Structure N := ι.defaultExpansion N
  have : ι.IsExpansionOn N := (symbSublangIncl_injective F R).isExpansionOn_default N
  exact ⟨N, inferInstance, hNc, hN, hT₀ ▸ (ι.onTheoryω_model T₀).2 hNT₀⟩

/-- **Countable models of satisfiable countable theories.** A satisfiable countable theory has a
countable nonempty model in every universe `w`. -/
theorem exists_countable_model (hT : T.Countable) (h : T.IsSatisfiable) :
    ∃ (M : Type w) (_ : L.Structure M), Countable M ∧ Nonempty M ∧ T.Model M := by
  obtain ⟨M, _, _, hM⟩ := isSatisfiable_iff.1 h
  exact hM.exists_countable_model hT

/-- **Universe invariance of entailment.** A sentence entailed by a countable theory holds in every
nonempty model of the theory, of any cardinality and in any universe. -/
theorem Entails.realize (hT : T.Countable) (h : T.Entails φ) (M : Type w) [L.Structure M]
    [Nonempty M] (hM : T.Model M) : SentenceInf.Realize φ M := by
  by_contra hφ
  obtain ⟨N, _, _, hN, hNT⟩ := Model.exists_countable_model.{u, v, w, max u v} (hT.insert φ.not)
    (model_insert_iff.2 ⟨SentenceInf.realize_not.2 hφ, hM⟩)
  exact entails_iff_not_isSatisfiable.1 h (isSatisfiable_iff.2 ⟨N, _, hN, hNT⟩)

/-- **Entailment is tested on countable models.** A countable theory entails a sentence exactly
when every countable nonempty model of the theory in the universe `w` satisfies it. -/
theorem entails_iff_countable (hT : T.Countable) :
    T.Entails φ ↔ ∀ (M : Type w) [L.Structure M] [Countable M] [Nonempty M], T.Model M →
      SentenceInf.Realize φ M := by
  refine ⟨fun h M _ _ _ => h.realize hT M, fun h => entails_iff_not_isSatisfiable.2 fun hs => ?_⟩
  obtain ⟨M, _, _, _, hM⟩ := exists_countable_model.{u, v, w} (hT.insert φ.not) hs
  rw [model_insert_iff, SentenceInf.realize_not] at hM
  exact hM.1 (h M hM.2)

/-- **Language maps preserve entailment.** If a countable theory `T` entails `φ`, the image of `T`
under any language map `g` entails the image of `φ`. The two languages may live in different
universes. -/
theorem Entails.onTheoryω {L' : Language.{u', v'}} (hT : T.Countable) (h : T.Entails φ)
    (g : L →ᴸ L') : (g.onTheoryω T).Entails (g.onBoundedFormulaInf φ) := by
  refine entails_iff.2 fun M _ _ hM => ?_
  let : L.Structure M := g.reduct M
  rw [LHom.onTheoryω_model] at hM
  simpa [SentenceInf.realize_def, FormulaInf.realize_def] using h.realize hT M hM

/-- **Injective language maps reflect entailment.** For an injective language map `g`, the image of
a countable theory `T` entails the image of `φ` exactly when `T` entails `φ`. This is the
entailment form of Mathlib's `Theory.isSatisfiable_onTheory_iff`. -/
theorem entails_onTheoryω_iff {L' : Language.{u', v'}} {g : L →ᴸ L'} (hg : g.Injective)
    (hT : T.Countable) : (g.onTheoryω T).Entails (g.onBoundedFormulaInf φ) ↔ T.Entails φ := by
  classical
  refine ⟨fun h => entails_iff.2 fun M _ _ hM => ?_, fun h => h.onTheoryω hT g⟩
  -- expand a model of `T` along `g`, interpreting the symbols outside its range arbitrarily
  have : Inhabited M := Classical.inhabited_of_nonempty ‹_›
  let : L'.Structure M := g.defaultExpansion M
  have : g.IsExpansionOn M := hg.isExpansionOn_default M
  have := h.realize (hT.onTheoryω g) M ((g.onTheoryω_model T).2 hM)
  simpa [SentenceInf.realize_def, FormulaInf.realize_def] using this

end Theoryω

namespace Sentenceω

variable {φ ψ : L.Sentenceω}

/-- **Universe invariance of entailment between sentences.** If `φ` entails `ψ`, then `ψ` holds in
every nonempty model of `φ`, of any cardinality and in any universe. -/
theorem Entails.realize (h : φ.Entails ψ) (M : Type w) [L.Structure M] [Nonempty M]
    (hφ : SentenceInf.Realize φ M) : SentenceInf.Realize ψ M :=
  Theoryω.Entails.realize (Set.countable_singleton φ) (entails_def.1 h) M
    (Theoryω.model_singleton_iff.2 hφ)

/-- **Entailment between sentences is tested on countable models.** A sentence `φ` entails `ψ`
exactly when `ψ` holds in every countable nonempty model of `φ` in the universe `w`. -/
theorem entails_iff_countable :
    φ.Entails ψ ↔ ∀ (M : Type w) [L.Structure M] [Countable M] [Nonempty M],
      SentenceInf.Realize φ M → SentenceInf.Realize ψ M := by
  simp only [entails_def, Theoryω.entails_iff_countable.{u, v, w} (Set.countable_singleton φ),
    Theoryω.model_singleton_iff]

/-- **Language maps preserve entailment between sentences.** If `φ` entails `ψ`, the image of `φ`
under any language map `g` entails the image of `ψ`. -/
theorem Entails.onBoundedFormulaInf {L' : Language.{u', v'}} (h : φ.Entails ψ) (g : L →ᴸ L') :
    Sentenceω.Entails (g.onBoundedFormulaInf φ) (g.onBoundedFormulaInf ψ) := by
  have := (entails_def.1 h).onTheoryω (Set.countable_singleton φ) g
  rwa [LHom.onTheoryω_def, Set.image_singleton, ← entails_def] at this

/-- **Injective language maps reflect entailment between sentences.** For an injective language
map `g`, the image of `φ` entails the image of `ψ` exactly when `φ` entails `ψ`. -/
theorem entails_onBoundedFormulaInf_iff {L' : Language.{u', v'}} {g : L →ᴸ L'}
    (hg : g.Injective) :
    Sentenceω.Entails (g.onBoundedFormulaInf φ) (g.onBoundedFormulaInf ψ) ↔ φ.Entails ψ := by
  rw [entails_def, entails_def, ← Theoryω.entails_onTheoryω_iff hg (Set.countable_singleton φ),
    LHom.onTheoryω_def, Set.image_singleton]

end Sentenceω

end Language

end FirstOrder
