module

public import TauCeti.ModelTheory.ModelExistence.Types
public import TauCeti.ModelTheory.ModelExistence.AElementary

/-!
# A countable fragment of realized-type isolators

If a structure realizes countably many complete infinitary types at each finite arity, choose
one isolating formula for each realized type. These formulas, together with their one-variable
existential closures, generate a countable fragment, even over an uncountable language.

The existential closures ensure that an embedding elementary for this fragment can find, in its
source, extensions of tuples having any prescribed complete type realized over the image tuple.
This is the witness property needed to compare a structure with its elementary substructures
using back-and-forth arguments. No smallness predicate or relational-language assumption is used.

## Main definitions

* `TauCeti.realizedTypeIsolator`: a chosen formula isolating one complete type among those
  realized in the given structure.
* `TauCeti.isolatorSeed`: the isolators and their one-variable existential closures.
* `TauCeti.isolatorFragment`: the fragment generated by this seed.

## References

* D. Marker, *Lectures on Infinitary Model Theory*, Cambridge University Press, 2016, Chapter 1,
  for isolation of realized infinitary types and countable fragments.
-/

public section

universe u v w w'

namespace TauCeti

open FirstOrder FirstOrder.Language

variable {L : Language.{u, v}} {M : Type w} [L.Structure M] {n : ℕ}

/-- A chosen formula isolating `p` among the complete `n`-types realized in `M`. -/
noncomputable def realizedTypeIsolator (h : (realizedTypes (L := L) M n).Countable)
    (p : realizedTypes (L := L) M n) : L.BoundedFormulaω Empty n :=
  (exists_isolatingFormula h (mem_realizedTypes.mp p.property).choose).choose

/-- The chosen isolator holds precisely at the tuples whose complete type is `p`. -/
@[simp]
theorem realize_realizedTypeIsolator (h : (realizedTypes (L := L) M n).Countable)
    (p : realizedTypes (L := L) M n) (a : Fin n → M) :
    (realizedTypeIsolator h p).Realize Empty.elim a ↔ infinitaryType M a = p.1 := by
  rw [realizedTypeIsolator]
  exact ((exists_isolatingFormula h (mem_realizedTypes.mp p.property).choose).choose_spec a).trans
    (by rw [(mem_realizedTypes.mp p.property).choose_spec])

variable (h : ∀ n, (realizedTypes (L := L) M n).Countable)

/-- The realized-type isolators at every arity, together with the existential closure of the
last position of each positive-arity isolator. -/
noncomputable def isolatorSeed : Set (Σ n, L.BoundedFormulaω Empty n) :=
  (⋃ n, Set.range fun p : realizedTypes (L := L) M n =>
    (⟨n, realizedTypeIsolator (h n) p⟩ : Σ n, L.BoundedFormulaω Empty n)) ∪
  ⋃ n, Set.range fun p : realizedTypes (L := L) M (n + 1) =>
    (⟨n, (realizedTypeIsolator (h (n + 1)) p).ex⟩ : Σ n, L.BoundedFormulaω Empty n)

/-- A generator is either an isolator or the one-variable existential closure of an isolator. -/
@[simp]
theorem mem_isolatorSeed {φ : Σ n, L.BoundedFormulaω Empty n} :
    φ ∈ isolatorSeed h ↔
      (∃ n, ∃ p : realizedTypes (L := L) M n,
        (⟨n, realizedTypeIsolator (h n) p⟩ : Σ n, L.BoundedFormulaω Empty n) = φ) ∨
      ∃ n, ∃ p : realizedTypes (L := L) M (n + 1),
        (⟨n, (realizedTypeIsolator (h (n + 1)) p).ex⟩ :
          Σ n, L.BoundedFormulaω Empty n) = φ := by
  simp only [isolatorSeed, Set.mem_union, Set.mem_iUnion, Set.mem_range]

/-- The seed is countable independently of the size of the language or the structure. -/
theorem isolatorSeed_countable : (isolatorSeed h).Countable := by
  let (n : ℕ) : Countable (realizedTypes (L := L) M n) := (h n).to_subtype
  exact (Set.countable_iUnion fun n => Set.countable_range _).union
    (Set.countable_iUnion fun n => Set.countable_range _)

/-- The fragment generated by the realized-type isolators and their one-variable existential
closures. It is component-closed, not asserted to be formation-closed. -/
noncomputable def isolatorFragment : Fragment L :=
  Fragment.generated (isolatorSeed h)

/-- The isolator fragment is countable even if the language and the structure are not. -/
theorem isolatorFragment_countable :
    ((isolatorFragment h : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable :=
  Fragment.generated_countable (isolatorSeed_countable h)

/-- Every chosen isolator belongs to the isolator fragment. -/
@[simp]
theorem realizedTypeIsolator_mem_isolatorFragment (p : realizedTypes (L := L) M n) :
    (⟨n, realizedTypeIsolator (h n) p⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ isolatorFragment h :=
  Fragment.subset_generated _ (mem_isolatorSeed h |>.2 (Or.inl ⟨n, p, rfl⟩))

/-- The one-variable existential closure of every chosen positive-arity isolator belongs to the
isolator fragment. -/
@[simp]
theorem ex_realizedTypeIsolator_mem_isolatorFragment
    (p : realizedTypes (L := L) M (n + 1)) :
    (⟨n, (realizedTypeIsolator (h (n + 1)) p).ex⟩ : Σ n, L.BoundedFormulaω Empty n) ∈
      isolatorFragment h :=
  Fragment.subset_generated _ (mem_isolatorSeed h |>.2 (Or.inr ⟨n, p, rfl⟩))

/-- A fragment contains the isolator fragment exactly when it contains all chosen isolators and
all their one-variable existential closures. -/
theorem isolatorFragment_le_iff {A : Fragment L} : isolatorFragment h ≤ A ↔
    (∀ n, ∀ p : realizedTypes (L := L) M n,
      (⟨n, realizedTypeIsolator (h n) p⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) ∧
    ∀ n, ∀ p : realizedTypes (L := L) M (n + 1),
      (⟨n, (realizedTypeIsolator (h (n + 1)) p).ex⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A := by
  rw [isolatorFragment, Fragment.generated_le_iff]
  constructor
  · intro hA
    exact ⟨fun n p => hA ((mem_isolatorSeed h).2 (Or.inl ⟨n, p, rfl⟩)),
      fun n p => hA ((mem_isolatorSeed h).2 (Or.inr ⟨n, p, rfl⟩))⟩
  · rintro ⟨hi, he⟩ φ hφ
    rcases (mem_isolatorSeed h).1 hφ with ⟨n, p, rfl⟩ | ⟨n, p, rfl⟩
    · exact hi n p
    · exact he n p

end TauCeti

namespace FirstOrder.Language.AElementary

open TauCeti

variable {L : FirstOrder.Language.{u, v}} {M : Type w} {N : Type w'}
  [L.Structure M] [L.Structure N]

/-- An embedding elementary for the isolator fragment can match every one-point extension of an
image tuple by a tuple from its source, with the same complete infinitary type in the target. -/
theorem exists_infinitaryType_snoc_eq
    {h : ∀ n, (realizedTypes (L := L) M n).Countable} {f : N ↪[L] M}
    (hf : AElementary (isolatorFragment h) f) {n : ℕ} (a : Fin n → N) (b : M) :
    ∃ c : N, infinitaryType (L := L) M (Fin.snoc (f ∘ a) (f c)) =
      infinitaryType M (Fin.snoc (f ∘ a) b) := by
  let p : realizedTypes (L := L) M (n + 1) :=
    ⟨_, infinitaryType_mem_realizedTypes (Fin.snoc (f ∘ a) b)⟩
  have hex : (realizedTypeIsolator (h (n + 1)) p).ex.Realize Empty.elim (f ∘ a) := by
    simp only [BoundedFormulaInf.realize_ex, realize_realizedTypeIsolator]
    exact ⟨b, rfl⟩
  obtain ⟨c, hc⟩ := BoundedFormulaInf.realize_ex.1
    ((hf.realize_iff (ex_realizedTypeIsolator_mem_isolatorFragment h p) a).1 hex)
  have hcM := (hf.realize_iff (realizedTypeIsolator_mem_isolatorFragment h p)
    (Fin.snoc a c)).2 hc
  rw [Fin.comp_snoc] at hcM
  exact ⟨c, (realize_realizedTypeIsolator _ p _).1 hcM⟩

end FirstOrder.Language.AElementary
