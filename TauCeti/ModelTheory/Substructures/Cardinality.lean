module

public import Mathlib.ModelTheory.Substructures

/-!
# Cardinality of generated substructures

Mathlib's `FirstOrder.Language.Substructure.lift_card_closure_le` bounds the substructure
generated by a set `s` by `max ℵ₀ (|s| + |Σ n, L.Functions n|)`. This file restates it in the
common universe of the language and the structure, as a bound by any infinite cardinal that bounds
both `s` and the function symbols.

## Main results

* `FirstOrder.Language.Substructure.lift_mk_closure_le`: the substructure generated by at most `κ`
  elements has at most `κ` elements, for an infinite `κ` bounding the function symbols.
-/

public section

open Cardinal

universe u v w

namespace FirstOrder

namespace Language

namespace Substructure

variable {L : Language.{u, v}} {M : Type w} [L.Structure M]

/-- **The closure of at most `κ` elements has at most `κ` elements**, for an infinite cardinal `κ`
in the common universe `max u v w` that bounds the set and the function symbols. -/
theorem lift_mk_closure_le {κ : Cardinal.{max u v w}} (hκ : ℵ₀ ≤ κ)
    (hF : lift.{max v w} #(Σ n, L.Functions n) ≤ κ) {s : Set M} (hs : lift.{max u v} #s ≤ κ) :
    lift.{max u v} #(closure L s) ≤ κ := by
  have h := lift_le.{v}.2 (lift_card_closure_le (L := L) (s := s))
  simp only [lift_lift, lift_max, lift_aleph0, lift_add] at h
  exact h.trans (max_le hκ ((add_le_add hs hF).trans (add_eq_self hκ).le))

end Substructure

end Language

end FirstOrder
