/-!
# The López–Escobar theorem for relational configurations

For a relational language `L` with countably many relation symbols of each arity and a countable
carrier `V`, the model classes `modelsOf θ` of `L_{ω₁ω}` sentences are Borel and isomorphism
invariant. This file proves the converse and its analytic separation form (**López–Escobar's
theorem**): two analytic sets of configurations on `V` whose images in the isomorphism quotient are
disjoint are separated by the model class of a single `L_{ω₁ω}` sentence
(`TauCeti.RelationalConfiguration.exists_sentence_separating`), and consequently every
isomorphism-invariant Borel set of configurations on `V` is the model class of an `L_{ω₁ω}`
sentence (`TauCeti.RelationalConfiguration.exists_modelsOf_eq_of_isomorphismInvariant`).

On a nonempty countable carrier `V`, the separation theorem is proved via projective-class
separation (`FirstOrder.Language.pcSeparation`). Any continuous map
`g : (ℕ → ℕ) → RelationalConfiguration L V` is coded by a single `L_{ω₁ω}` sentence in an
expansion `L.sum (codeLang V)` adjoining nullary predicates for the graph of a Baire point
`x : ℕ → ℕ` and unary predicates for the graph of a bijection `V ≃ M`. Because each atom cylinder
is clopen, its preimage under `g` is a countable union of word cylinders in Baire space, so the
sentence forces `M` to be isomorphic to `(g x).toStructure`. Thus the isomorphism saturation of
every analytic set of configurations on `V` is a `PC_{ω₁ω}` class, and disjointness in the
isomorphism quotient feeds directly into `pcSeparation`. On an empty carrier `V`, the product
σ-algebra is generated by the nullary relation symbols, each already an atomic sentence, so every
measurable set is a model class even without countability of `L`, and Lusin separation yields the
analytic form.

From analytic separation we also derive the **relative López–Escobar theorem**
(`TauCeti.RelationalConfiguration.exists_sentence_preimage_modelsOf_eq`) for Borel maps from a
standard Borel space into configurations, its recovery of isomorphism-invariant Borel maps into
Cantor space (`TauCeti.RelationalConfiguration.exists_sentenceTheory_comp_eq`) and into arbitrary
countably separated measurable spaces
(`TauCeti.RelationalConfiguration.exists_ker_sentenceTheory_comp_eq`), and **Cantor recovery** for
Borel families of pairwise non-isomorphic configurations
(`TauCeti.RelationalConfiguration.exists_sentenceTheory_comp_eq_id`).

## Main results

* `TauCeti.RelationalConfiguration.isomorphismInvariant_modelsOf`: model classes are isomorphism
  invariant.
* `TauCeti.RelationalConfiguration.exists_sentence_separating`: two analytic sets of configurations
  with disjoint images in the isomorphism quotient are separated by a single `L_{ω₁ω}` sentence.
* `TauCeti.RelationalConfiguration.exists_sentence_separating_of_isomorphismInvariant`: analytic
  separation when the second set is isomorphism invariant and disjoint from the first.
* `TauCeti.RelationalConfiguration.exists_modelsOf_eq_of_isomorphismInvariant` and
  `TauCeti.RelationalConfiguration.measurableSet_and_isomorphismInvariant_iff_exists_modelsOf`:
  the López–Escobar theorem characterizing isomorphism-invariant Borel sets of configurations as
  model classes of `L_{ω₁ω}` sentences.
* `TauCeti.RelationalConfiguration.exists_sentence_preimage_modelsOf_eq`: relative López–Escobar
  for Borel sets pulled back from a standard Borel space along a measurable family of
  configurations.
* `TauCeti.RelationalConfiguration.exists_sentenceTheory_comp_eq`,
  `TauCeti.RelationalConfiguration.exists_ker_sentenceTheory_comp_eq`, and
  `TauCeti.RelationalConfiguration.exists_sentenceTheory_comp_eq_id`: recovery of
  isomorphism-invariant Borel observables and Cantor families via truth sequences of countable
  lists of sentences.

## References

* E. G. K. López-Escobar, *An interpolation theorem for denumerably long formulas*, Fundamenta
  Mathematicae **57** (1965), 253–272.
* Alexander S. Kechris, *Classical Descriptive Set Theory*, Graduate Texts in Mathematics 156,
  Springer, 1995, Theorem 16.8.
* Su Gao, *Invariant Descriptive Set Theory*, CRC Press, 2009, Theorem 11.3.6.
* David Marker, *Lectures on Infinitary Model Theory*, Lecture Notes in Logic 46, Cambridge
  University Press, 2016, §4.2 (derivation of the López–Escobar theorem from `PC_{ω₁ω}`
  separation).
-/

public section

universe u v w w' uι

open FirstOrder FirstOrder.Language MeasureTheory Set

namespace TauCeti.RelationalConfiguration

/-! ### Isomorphism invariance and the empty carrier -/

section Basic

variable {L : Language.{u, v}} [L.IsRelational] {V : Type w}

/-- Model classes of infinitary sentences are isomorphism invariant. -/
theorem isomorphismInvariant_modelsOf {ι : Type uι} (φ : L.SentenceInf ι) :
    IsomorphismInvariant (modelsOf (V := V) φ) :=
  isomorphismInvariant_iff.mpr fun _ _ hcd hc =>
    let ⟨e⟩ := isoSetoid_apply.mp hcd
    (e.mem_modelsOf_iff φ).mp hc

/-- On an empty carrier, every measurable set of configurations is the model class of an
`L_{ω₁ω}` sentence, since the product σ-algebra is generated by the nullary relation symbols. -/
private theorem exists_modelsOf_eq_of_isEmpty [IsEmpty V] {A : Set (RelationalConfiguration L V)}
    (hA : MeasurableSet A) : ∃ θ : L.Sentenceω, modelsOf (V := V) θ = A := by
  let m : MeasurableSpace (RelationalConfiguration L V) :=
    { MeasurableSet' S := ∃ θ : L.Sentenceω, modelsOf (V := V) θ = S
      measurableSet_empty := ⟨⊥, modelsOf_bot⟩
      measurableSet_compl S := fun ⟨θ, hθ⟩ => ⟨θ.not, by rw [modelsOf_not, hθ]⟩
      measurableSet_iUnion f hf := by
        choose θ hθ using hf
        exact ⟨.iSup θ, by simp [modelsOf_iSup, hθ]⟩ }
  have hle : @Measurable (RelationalConfiguration L V) (RelationalConfiguration L V)
      m instMeasurableSpace id := by
    refine (@measurable_iff L V (RelationalConfiguration L V) m id).mpr fun a s _ => ?_
    induction a using Atom.induction_atom with
    | @h n R x =>
      cases n with
      | succ n => exact isEmptyElim (x 0)
      | zero =>
        have hx : x = Fin.elim0 := Subsingleton.elim x Fin.elim0
        subst hx
        have hrel : modelsOf (V := V) (BoundedFormulaInf.rel R Fin.elim0 : L.Sentenceω) =
            {c | c.eval (atom R Fin.elim0) = true} := by
          ext c
          simp only [mem_modelsOf, SentenceInf.realize_def, FormulaInf.realize_def,
            BoundedFormulaInf.realize_rel, toStructure_relMap, mem_ofPred_eq]
          exact iff_of_eq (congrArg (fun t => c.eval (atom R t) = true) (Subsingleton.elim _ _))
        by_cases ht : true ∈ s <;> by_cases hf : false ∈ s
        · refine ⟨⊤, ?_⟩
          ext c
          simp only [modelsOf_top, mem_univ, mem_preimage, id_eq, true_iff]
          cases c.eval (atom R Fin.elim0) <;> assumption
        · refine ⟨BoundedFormulaInf.rel R Fin.elim0, ?_⟩
          rw [hrel]
          ext c
          simp only [mem_ofPred_eq, mem_preimage, id_eq]
          cases c.eval (atom R Fin.elim0) <;> simp [ht, hf]
        · refine ⟨(BoundedFormulaInf.rel R Fin.elim0 : L.Sentenceω).not, ?_⟩
          rw [modelsOf_not, hrel]
          ext c
          simp only [mem_compl_iff, mem_ofPred_eq, mem_preimage, id_eq]
          cases c.eval (atom R Fin.elim0) <;> simp [ht, hf]
        · refine ⟨⊥, ?_⟩
          ext c
          simp only [modelsOf_bot, mem_empty_iff_false, mem_preimage, id_eq, false_iff]
          cases c.eval (atom R Fin.elim0) <;> assumption
  exact hle hA

end Basic

/-! ### Coding analytic sets as `PC_{ω₁ω}` classes -/

section Coding

variable {L : Language.{u, v}} {V : Type w}

/-- Auxiliary relational vocabulary adjoining nullary predicates for the graph of a Baire-space
sequence `x : ℕ → ℕ` and unary predicates for the graph of a bijection `V ≃ M`. -/
private def codeLang (V : Type w) : Language.{0, w} where
  Functions _ := PEmpty
  Relations
    | 0 => ULift.{w} (ℕ × ℕ)
    | 1 => V
    | _ + 2 => PEmpty.{w + 1}

private instance : (codeLang V).IsRelational :=
  fun _ => inferInstanceAs (IsEmpty PEmpty)

/-- Nullary relation symbol coding `x k = m` in `L.sum (codeLang V)`. -/
private def codeRelBit (k m : ℕ) : (L.sum (codeLang V)).Relations 0 :=
  LHom.sumInr.onRelation (ULift.up (k, m) : (codeLang V).Relations 0)

/-- Unary relation symbol coding `y = e v` in `L.sum (codeLang V)`. -/
private def codeRelElem (v : V) : (L.sum (codeLang V)).Relations 1 :=
  LHom.sumInr.onRelation (v : (codeLang V).Relations 1)

/-- Nullary atomic formula asserting `x k = m` in the coding vocabulary. -/
private def bitAtom (k m : ℕ) {n : ℕ} : (L.sum (codeLang V)).BoundedFormulaω Empty n :=
  .rel (codeRelBit k m) Fin.elim0

/-- Unary atomic formula asserting that bound variable `i` represents `v : V`. -/
private def elemAtom (v : V) {n : ℕ} (i : Fin n) :
    (L.sum (codeLang V)).BoundedFormulaω Empty n :=
  .rel (codeRelElem v) fun _ => .var (Sum.inr i)

private theorem realize_bitAtom {M : Type w'} [(L.sum (codeLang V)).Structure M]
    (k m : ℕ) {n : ℕ} {xs : Fin n → M} :
    (bitAtom (L := L) (V := V) k m).Realize Empty.elim xs ↔
      Structure.RelMap (L := L.sum (codeLang V)) (M := M) (codeRelBit k m) Fin.elim0 := by
  rw [bitAtom, BoundedFormulaInf.realize_rel]
  exact iff_of_eq (congrArg _ (Subsingleton.elim _ _))

private theorem realize_elemAtom {M : Type w'} [(L.sum (codeLang V)).Structure M]
    (v : V) {n : ℕ} (i : Fin n) {xs : Fin n → M} :
    (elemAtom (L := L) v i).Realize Empty.elim xs ↔
      Structure.RelMap (L := L.sum (codeLang V)) (codeRelElem v) (fun _ => xs i) := by
  simp only [elemAtom, BoundedFormulaInf.realize_rel, Term.realize_var, Sum.elim_inr]

/-- Sentence forcing the unary predicates of `codeLang V` to be the graph of a bijection
`e : V ≃ M`. -/
private noncomputable def bijSentence [Countable V] : (L.sum (codeLang V)).Sentenceω :=
  let cV : IndexCoding V ℕ := IndexCoding.ofEncodableWith (Encodable.ofCountable V)
  let cV2 : IndexCoding (V × V) ℕ := IndexCoding.ofEncodableWith (Encodable.ofCountable (V × V))
  open Classical in
  (.iInfAlong cV fun v => (elemAtom v (0 : Fin 1)).ex) ⊓
  (.iInfAlong cV fun v =>
    (((elemAtom v (0 : Fin 2)) ⊓ (elemAtom v (1 : Fin 2))).imp
      (.equal (.var (Sum.inr 0)) (.var (Sum.inr 1)))).alls) ⊓
  (.iInfAlong cV2 fun p =>
    if p.1 = p.2 then ⊤
    else ((elemAtom p.1 (0 : Fin 1) ⊓ elemAtom p.2 (0 : Fin 1)).not).all) ⊓
  (BoundedFormulaInf.iSupAlong cV fun v => elemAtom v (0 : Fin 1)).all

private theorem realize_bijSentence_iff [Countable V] {M : Type w'}
    [(L.sum (codeLang V)).Structure M] :
    SentenceInf.Realize (bijSentence (L := L) (V := V)) M ↔
      ∃ e : V ≃ M, ∀ v y,
        Structure.RelMap (L := L.sum (codeLang V)) (codeRelElem v) (fun _ => y) ↔ y = e v := by
  classical
  have hsnoc (y : M) :
      Fin.snoc (α := fun _ => M) (default : Fin 0 → M) y (0 : Fin 1) = y := rfl
  simp only [bijSentence, SentenceInf.realize_def, FormulaInf.realize_def,
    BoundedFormulaInf.realize_inf, BoundedFormulaInf.realize_iInfAlong,
    BoundedFormulaInf.realize_ex, BoundedFormulaInf.realize_alls, BoundedFormulaInf.realize_imp,
    BoundedFormulaInf.realize_equal, BoundedFormulaInf.realize_all,
    BoundedFormulaInf.realize_iSupAlong, realize_elemAtom, Term.realize_var, Sum.elim_inr, hsnoc]
  constructor
  · rintro ⟨⟨⟨hex, huniq⟩, hdisj⟩, hsurj⟩
    have huniq' : ∀ v : V, ∀ y₁ y₂ : M,
        Structure.RelMap (L := L.sum (codeLang V)) (codeRelElem v) (fun _ => y₁) →
        Structure.RelMap (L := L.sum (codeLang V)) (codeRelElem v) (fun _ => y₂) →
        y₁ = y₂ := fun v y₁ y₂ h₁ h₂ => huniq v ![y₁, y₂] ⟨h₁, h₂⟩
    have hdisj' : ∀ v₁ v₂ : V, v₁ ≠ v₂ → ∀ y : M,
        ¬ (Structure.RelMap (L := L.sum (codeLang V)) (codeRelElem v₁) (fun _ => y) ∧
           Structure.RelMap (L := L.sum (codeLang V)) (codeRelElem v₂) (fun _ => y)) := by
      intro v₁ v₂ hne y hy
      have h := hdisj (v₁, v₂)
      simp only [hne, ↓reduceIte, BoundedFormulaInf.realize_all, BoundedFormulaInf.realize_not,
        BoundedFormulaInf.realize_inf, realize_elemAtom, hsnoc] at h
      exact h y hy
    choose f hf using hex
    choose g hg using hsurj
    refine ⟨⟨f, g, fun v => by_contra fun hne => hdisj' _ _ hne (f v) ⟨hg (f v), hf v⟩,
      fun y => huniq' (g y) (f (g y)) y (hf (g y)) (hg y)⟩, fun v y =>
        ⟨fun hy => huniq' v y (f v) hy (hf v), fun hy => hy ▸ hf v⟩⟩
  · rintro ⟨e, he⟩
    refine ⟨⟨⟨fun v => ⟨e v, (he v (e v)).2 rfl⟩,
      fun v xs ⟨h₀, h₁⟩ => ((he v (xs 0)).1 h₀).trans ((he v (xs 1)).1 h₁).symm⟩,
      fun p => ?_⟩, fun y => ⟨e.symm y, (he (e.symm y) y).2 (e.apply_symm_apply y).symm⟩⟩
    split_ifs with hp
    · exact BoundedFormulaInf.realize_top.2 trivial
    · simp only [BoundedFormulaInf.realize_all, BoundedFormulaInf.realize_not,
        BoundedFormulaInf.realize_inf, realize_elemAtom, hsnoc]
      rintro y ⟨h₁, h₂⟩
      exact hp (e.injective (((he p.1 y).1 h₁).symm.trans ((he p.2 y).1 h₂)))

/-- Sentence forcing the nullary predicates of `codeLang V` to be the graph of a sequence
`x : ℕ → ℕ`. -/
private def baireSentence : (L.sum (codeLang V)).Sentenceω :=
  (.iInf fun k => .iSup fun m => bitAtom k m) ⊓
  (.iInf fun k => .iInf fun m₁ => .iInf fun m₂ =>
    if m₁ = m₂ then ⊤ else (bitAtom k m₁ ⊓ bitAtom k m₂).not)

private theorem realize_baireSentence_iff {M : Type w'} [(L.sum (codeLang V)).Structure M] :
    SentenceInf.Realize (baireSentence (L := L) (V := V)) M ↔
      ∃ x : ℕ → ℕ, ∀ k m,
        Structure.RelMap (L := L.sum (codeLang V)) (M := M) (codeRelBit k m) Fin.elim0 ↔
          x k = m := by
  simp only [baireSentence, SentenceInf.realize_def, FormulaInf.realize_def,
    BoundedFormulaInf.realize_inf, BoundedFormulaInf.realize_iInf, BoundedFormulaInf.realize_iSup,
    realize_bitAtom]
  constructor
  · rintro ⟨htot, hfun⟩
    choose x hx using htot
    refine ⟨x, fun k m => ⟨fun hkm => by_contra fun hne => ?_, fun h => h ▸ hx k⟩⟩
    have h := hfun k (x k) m
    simp only [hne, ↓reduceIte, BoundedFormulaInf.realize_not, BoundedFormulaInf.realize_inf,
      realize_bitAtom] at h
    exact h ⟨hx k, hkm⟩
  · rintro ⟨x, hx⟩
    refine ⟨fun k => ⟨x k, (hx k (x k)).2 rfl⟩, fun k m₁ m₂ => ?_⟩
    split_ifs with h
    · exact BoundedFormulaInf.realize_top.2 trivial
    · simp only [BoundedFormulaInf.realize_not, BoundedFormulaInf.realize_inf, realize_bitAtom]
      rintro ⟨h₁, h₂⟩
      exact h (((hx k m₁).1 h₁).symm.trans ((hx k m₂).1 h₂))

/-- Sentence asserting that the coded Baire point lies in the word cylinder of `w`. -/
private def wordFormula (w : List ℕ) : (L.sum (codeLang V)).Sentenceω :=
  .iInf fun i => if h : i < w.length then bitAtom i w[i] else ⊤

private theorem realize_wordFormula_iff {M : Type w'} [(L.sum (codeLang V)).Structure M]
    {x : ℕ → ℕ}
    (hx : ∀ k m,
      Structure.RelMap (L := L.sum (codeLang V)) (M := M) (codeRelBit k m) Fin.elim0 ↔ x k = m)
    (w : List ℕ) :
    SentenceInf.Realize (wordFormula (L := L) (V := V) w) M ↔ x ∈ PiNat.wordCylinder w := by
  simp only [wordFormula, SentenceInf.realize_def, FormulaInf.realize_def,
    BoundedFormulaInf.realize_iInf, PiNat.mem_wordCylinder_iff]
  refine forall_congr' fun i => ?_
  by_cases hi : i < w.length
  · simp [hi, realize_bitAtom, hx]
  · simp [hi]

/-- Sentence asserting that the coded Baire point lies in the open cylinder preimage
`{x | (g x).eval a = true}`. -/
private noncomputable def openAtomFormula
    (g : (ℕ → ℕ) → RelationalConfiguration L V) (a : Atom L V) :
    (L.sum (codeLang V)).Sentenceω :=
  open Classical in
  .iSupAlong (IndexCoding.ofEncodable (List ℕ)) fun w =>
    if PiNat.wordCylinder w ⊆ {x | (g x).eval a = true} then wordFormula w else ⊥

private theorem realize_openAtomFormula_iff {M : Type w'} [(L.sum (codeLang V)).Structure M]
    {g : (ℕ → ℕ) → RelationalConfiguration L V} (hg : Continuous g) {x : ℕ → ℕ}
    (hx : ∀ k m,
      Structure.RelMap (L := L.sum (codeLang V)) (M := M) (codeRelBit k m) Fin.elim0 ↔ x k = m)
    (a : Atom L V) :
    SentenceInf.Realize (openAtomFormula g a) M ↔ (g x).eval a = true := by
  classical
  simp only [openAtomFormula, SentenceInf.realize_def, FormulaInf.realize_def,
    BoundedFormulaInf.realize_iSupAlong]
  constructor
  · rintro ⟨w, hw⟩
    split_ifs at hw with hsub
    · exact hsub ((realize_wordFormula_iff hx w).1
        ((SentenceInf.realize_def _ M).2 ((FormulaInf.realize_def _ Empty.elim).2 hw)))
    · exact False.elim (BoundedFormulaInf.realize_bot.1 hw)
  · intro hgx
    have hopen : IsOpen {y : ℕ → ℕ | (g y).eval a = true} :=
      (isClopen_setOf_eval a true).isOpen.preimage hg
    obtain ⟨_, ⟨y, n, rfl⟩, hxcyl, hcylsub⟩ :=
      (PiNat.isTopologicalBasis_cylinders fun _ : ℕ => ℕ).exists_subset_of_mem_open hgx hopen
    rw [← PiNat.wordCylinder_reverse_res y n] at hxcyl hcylsub
    refine ⟨(PiNat.res y n).reverse, ?_⟩
    simp only [hcylsub, ↓reduceIte]
    exact (FormulaInf.realize_def _ Empty.elim).1
      ((SentenceInf.realize_def _ M).1 ((realize_wordFormula_iff hx _).2 hxcyl))

/-- Sentence asserting that the `L`-relation `R` holds at the images of `t : Fin l → V` under the
coded bijection `e : V ≃ M`. -/
private def evalAtomFormula {l : ℕ} (R : L.Relations l) (t : Fin l → V) :
    (L.sum (codeLang V)).Sentenceω :=
  (BoundedFormulaInf.iInf (fun i : ℕ =>
      if h : i < l then elemAtom (t ⟨i, h⟩) ⟨i, h⟩ else ⊤) ⊓
    BoundedFormulaInf.rel (LHom.sumInl.onRelation R) fun j : Fin l => .var (Sum.inr j)).exs

private theorem realize_evalAtomFormula_iff {M : Type w'} [(L.sum (codeLang V)).Structure M]
    {e : V ≃ M}
    (he : ∀ v y,
      Structure.RelMap (L := L.sum (codeLang V)) (codeRelElem v) (fun _ => y) ↔ y = e v)
    {l : ℕ} (R : L.Relations l) (t : Fin l → V) :
    SentenceInf.Realize (evalAtomFormula R t) M ↔
      Structure.RelMap (L := L.sum (codeLang V)) (LHom.sumInl.onRelation R) (e ∘ t) := by
  simp only [evalAtomFormula, SentenceInf.realize_def, FormulaInf.realize_def,
    BoundedFormulaInf.realize_exs, BoundedFormulaInf.realize_inf, BoundedFormulaInf.realize_iInf,
    BoundedFormulaInf.realize_rel]
  constructor
  · rintro ⟨ys, hys, hR⟩
    have hyeq : ys = e ∘ t := funext fun j => by
      have hj := hys j.1
      simp only [j.2, ↓reduceDIte, realize_elemAtom] at hj
      exact (he (t j) (ys j)).1 hj
    simpa [Function.comp_def, hyeq] using hR
  · intro hR
    refine ⟨e ∘ t, fun i => ?_, by simpa [Function.comp_def] using hR⟩
    by_cases hi : i < l
    · simp only [hi, ↓reduceDIte, realize_elemAtom]
      exact (he _ _).2 rfl
    · simp only [hi, ↓reduceDIte, BoundedFormulaInf.realize_top]

/-- Coding sentence for the isomorphism saturation of the range of a continuous map
`g : (ℕ → ℕ) → RelationalConfiguration L V`. -/
private noncomputable def codeSentence [Countable V] [∀ n, Countable (L.Relations n)]
    (g : (ℕ → ℕ) → RelationalConfiguration L V) : (L.sum (codeLang V)).Sentenceω :=
  let cAtom : IndexCoding (Σ l, L.Relations l × (Fin l → V)) ℕ :=
    IndexCoding.ofEncodableWith (Encodable.ofCountable (Σ l, L.Relations l × (Fin l → V)))
  bijSentence ⊓ baireSentence ⊓
    .iInfAlong cAtom fun p =>
      (evalAtomFormula p.2.1 p.2.2).iff (openAtomFormula g (atom p.2.1 p.2.2))

private theorem pcMem_codeSentence_iff [L.IsRelational] [Countable V]
    [∀ n, Countable (L.Relations n)]
    {g : (ℕ → ℕ) → RelationalConfiguration L V} (hg : Continuous g)
    {M : Type w'} [L.Structure M] :
    (LHom.sumInl : L →ᴸ L.sum (codeLang V)).PCMem (codeSentence g) M ↔
      ∃ x : ℕ → ℕ, Nonempty (@Language.Equiv L V M (g x).toStructure _) := by
  rw [LHom.pcMem_iff]
  constructor
  · -- Forward: decode the bijection `e : V ≃ M` and Baire point `x` from the expansion.
    rintro ⟨S, hExp, hReal⟩
    let _ := S
    simp only [codeSentence, SentenceInf.realize_inf, realize_bijSentence_iff,
      realize_baireSentence_iff] at hReal
    obtain ⟨⟨⟨e, he⟩, ⟨x, hx⟩⟩, hAtoms⟩ := hReal
    rw [SentenceInf.realize_def, FormulaInf.realize_def, BoundedFormulaInf.realize_iInfAlong]
      at hAtoms
    refine ⟨x, ⟨@Language.Equiv.mk L V M (g x).toStructure _ e
      (fun {n} f => isEmptyElim f) fun {l} R t => ?_⟩⟩
    have ha := hAtoms ⟨l, R, t⟩
    rw [BoundedFormulaInf.realize_iff] at ha
    simp only [← FormulaInf.realize_def, ← SentenceInf.realize_def] at ha
    rw [realize_evalAtomFormula_iff he R t, realize_openAtomFormula_iff hg hx (atom R t),
      ← toStructure_relMap] at ha
    have hmap : Structure.RelMap (L := L.sum (codeLang V)) (LHom.sumInl.onRelation R) (e ∘ t) ↔
        Structure.RelMap R (e ∘ t) :=
      iff_of_eq (hExp.map_onRelation R (e ∘ t))
    exact hmap.symm.trans ha
  · -- Backward: interpret `codeLang V` on `M` using the graphs of `x` and `e`.
    rintro ⟨x, ⟨e⟩⟩
    let _ := (g x).toStructure
    let S_code : (codeLang V).Structure M :=
      { funMap := fun f => isEmptyElim f
        RelMap := fun {n} R => match n, R with
          | 0, ULift.up (k, m) => fun _ => x k = m
          | 1, v => fun ys => ys 0 = e.toEquiv v
          | _ + 2, r => PEmpty.elim r }
    let _ := sumStructure L (codeLang V) M
    refine ⟨sumStructure L (codeLang V) M, LHom.sumInl_isExpansionOn M, ?_⟩
    have he : ∀ v y,
        Structure.RelMap (L := L.sum (codeLang V)) (codeRelElem v) (fun _ => y) ↔
          y = e.toEquiv v := fun _ _ => Iff.rfl
    have hx : ∀ k m,
        Structure.RelMap (L := L.sum (codeLang V)) (M := M) (codeRelBit k m) Fin.elim0 ↔
          x k = m := fun _ _ => Iff.rfl
    simp only [codeSentence, SentenceInf.realize_inf, realize_bijSentence_iff,
      realize_baireSentence_iff]
    refine ⟨⟨⟨e.toEquiv, he⟩, ⟨x, hx⟩⟩, ?_⟩
    rw [SentenceInf.realize_def, FormulaInf.realize_def, BoundedFormulaInf.realize_iInfAlong]
    rintro ⟨l, R, t⟩
    rw [BoundedFormulaInf.realize_iff]
    simp only [← FormulaInf.realize_def, ← SentenceInf.realize_def]
    rw [realize_evalAtomFormula_iff he R t, realize_openAtomFormula_iff hg hx (atom R t),
      ← toStructure_relMap]
    exact @Language.Equiv.map_rel L V M (g x).toStructure _ e _ R t

/-- Every analytic set of relational configurations on a countable carrier defines a `PC_{ω₁ω}`
class of `L`-structures via `codeLang V`. -/
private theorem exists_pcSentence_of_analyticSet [L.IsRelational] [Countable V]
    [∀ n, Countable (L.Relations n)] {A : Set (RelationalConfiguration L V)}
    (hA : AnalyticSet A) :
    ∃ Θ : (L.sum (codeLang V)).Sentenceω,
      ∀ (M : Type w') [L.Structure M],
        (LHom.sumInl : L →ᴸ L.sum (codeLang V)).PCMem Θ M ↔
          ∃ c ∈ A, Nonempty (@Language.Equiv L V M c.toStructure _) := by
  obtain ⟨γ, _, _, f, hf, rfl⟩ := analyticSet_iff_exists_polishSpace_range.mp hA
  rcases isEmpty_or_nonempty γ with _ | _
  · refine ⟨⊥, fun M _ => ?_⟩
    simp [LHom.pcMem_iff, range_eq_empty f]
  · obtain ⟨p, hp_cont, hp_surj⟩ := PolishSpace.exists_nat_nat_continuous_surjective γ
    refine ⟨codeSentence (f ∘ p), fun M _ => ?_⟩
    rw [pcMem_codeSentence_iff (hf.comp hp_cont), ← hp_surj.range_comp f]
    simp

end Coding

/-! ### López–Escobar separation and the invariant Borel theorem -/

section LopezEscobar

variable {L : Language.{u, v}} [L.IsRelational] {V : Type w}

/-- **López–Escobar separation theorem.** Let `L` be a relational language with countably many
relation symbols of each arity and `V` a countable carrier. If `A` and `B` are analytic sets of
configurations on `V` whose images in the isomorphism quotient are disjoint, then some `L_{ω₁ω}`
sentence `θ` satisfies `A ⊆ modelsOf θ` and `Disjoint B (modelsOf θ)`. -/
theorem exists_sentence_separating [∀ n, Countable (L.Relations n)] [Countable V]
    {A B : Set (RelationalConfiguration L V)} (hA : AnalyticSet A) (hB : AnalyticSet B)
    (hAB : Disjoint (Quotient.mk (isoSetoid L V) '' A) (Quotient.mk (isoSetoid L V) '' B)) :
    ∃ θ : L.Sentenceω, A ⊆ modelsOf θ ∧ Disjoint B (modelsOf θ) := by
  rcases isEmpty_or_nonempty V with hV | hV
  · have hdisj : Disjoint A B :=
      Set.disjoint_left.mpr fun c hcA hcB =>
        Set.disjoint_left.mp hAB ⟨c, hcA, rfl⟩ ⟨c, hcB, rfl⟩
    obtain ⟨C, hAC, hBC, hCm⟩ := hA.measurablySeparable hB hdisj
    obtain ⟨θ, rfl⟩ := exists_modelsOf_eq_of_isEmpty hCm
    exact ⟨θ, hAC, hBC⟩
  · obtain ⟨Θ₁, hΘ₁⟩ := exists_pcSentence_of_analyticSet.{u, v, w, w} hA
    obtain ⟨Θ₂, hΘ₂⟩ := exists_pcSentence_of_analyticSet.{u, v, w, w} hB
    have hdisj : ∀ (M : Type w) [L.Structure M] [Nonempty M] [Countable M],
        LHom.sumInl.PCMem Θ₁ M → ¬ LHom.sumInl.PCMem Θ₂ M := by
      intro M _ _ _ h₁ h₂
      obtain ⟨c, hcA, ⟨e₁⟩⟩ := (hΘ₁ M).mp h₁
      obtain ⟨d, hdB, ⟨e₂⟩⟩ := (hΘ₂ M).mp h₂
      have hcd : isoSetoid L V c d :=
        isoSetoid_apply.mpr ⟨@Language.Equiv.comp L V M c.toStructure _ V d.toStructure
          (@Language.Equiv.symm L V M d.toStructure _ e₂) e₁⟩
      exact Set.disjoint_left.mp hAB ⟨c, hcA, rfl⟩ ⟨d, hdB, (Quotient.sound hcd).symm⟩
    obtain ⟨θ, hθ₁, hθ₂⟩ := pcSeparation.{u, v, 0, w, 0, w, w, w} Θ₁ Θ₂ hdisj
    refine ⟨θ, fun c hcA => ?_, Set.disjoint_left.mpr fun d hdB hdθ => ?_⟩
    · let _ := c.toStructure
      have hcMem := (hΘ₁ V).mpr ⟨c, hcA, ⟨@Language.Equiv.refl L V c.toStructure⟩⟩
      exact mem_modelsOf.mpr (hθ₁ V hcMem)
    · let _ := d.toStructure
      have hdMem := (hΘ₂ V).mpr ⟨d, hdB, ⟨@Language.Equiv.refl L V d.toStructure⟩⟩
      exact hθ₂ V hdMem (mem_modelsOf.mp hdθ)

/-- **López–Escobar separation**, invariance form: if `A` and `B` are disjoint analytic sets of
configurations on a countable carrier and `B` is isomorphism invariant, then some `L_{ω₁ω}`
sentence `θ` satisfies `A ⊆ modelsOf θ` and `Disjoint B (modelsOf θ)`. -/
theorem exists_sentence_separating_of_isomorphismInvariant [∀ n, Countable (L.Relations n)]
    [Countable V] {A B : Set (RelationalConfiguration L V)}
    (hA : AnalyticSet A) (hB : AnalyticSet B) (hinv : IsomorphismInvariant B)
    (hAB : Disjoint A B) :
    ∃ θ : L.Sentenceω, A ⊆ modelsOf θ ∧ Disjoint B (modelsOf θ) := by
  refine exists_sentence_separating hA hB ?_
  rw [Set.disjoint_image_left, isomorphismInvariant_iff_preimage_image_quotientMk.mp hinv]
  exact hAB

/-- **López–Escobar theorem.** On a countable carrier in a relational language with countably many
relation symbols of each arity, every isomorphism-invariant Borel set of configurations is the
model class of a single `L_{ω₁ω}` sentence. -/
theorem exists_modelsOf_eq_of_isomorphismInvariant [∀ n, Countable (L.Relations n)] [Countable V]
    {A : Set (RelationalConfiguration L V)}
    (hA : MeasurableSet A) (hinv : IsomorphismInvariant A) :
    ∃ θ : L.Sentenceω, modelsOf (V := V) θ = A := by
  obtain ⟨θ, hsub, hdisj⟩ := exists_sentence_separating_of_isomorphismInvariant
    hA.analyticSet hA.compl.analyticSet hinv.compl disjoint_compl_right
  exact ⟨θ, Subset.antisymm (disjoint_compl_left_iff_subset.mp hdisj) hsub⟩

/-- **López–Escobar characterization.** On a countable carrier in a relational language with
countably many relation symbols of each arity, a set of configurations is the model class of an
`L_{ω₁ω}` sentence if and only if it is Borel and isomorphism invariant. -/
theorem measurableSet_and_isomorphismInvariant_iff_exists_modelsOf
    [∀ n, Countable (L.Relations n)] [Countable V] {A : Set (RelationalConfiguration L V)} :
    MeasurableSet A ∧ IsomorphismInvariant A ↔ ∃ θ : L.Sentenceω, modelsOf (V := V) θ = A :=
  ⟨fun ⟨hA, hinv⟩ => exists_modelsOf_eq_of_isomorphismInvariant hA hinv,
    fun ⟨θ, hθ⟩ => hθ ▸ ⟨measurableSet_modelsOf θ, isomorphismInvariant_modelsOf θ⟩⟩

/-! ### Relative López–Escobar and Borel observables -/

/-- **Relative López–Escobar theorem.** For a measurable map `f` from a standard Borel space `X`
into relational configurations on a countable carrier `V`, every Borel set `U ⊆ X` saturated under
isomorphism of values of `f` is the preimage under `f` of the model class of an `L_{ω₁ω}`
sentence. -/
theorem exists_sentence_preimage_modelsOf_eq [∀ n, Countable (L.Relations n)] [Countable V]
    {X : Type*} [MeasurableSpace X] [StandardBorelSpace X]
    {f : X → RelationalConfiguration L V} (hf : Measurable f)
    {U : Set X} (hU : MeasurableSet U)
    (hinv : ∀ ⦃x y⦄, isoSetoid L V (f x) (f y) → x ∈ U → y ∈ U) :
    ∃ θ : L.Sentenceω, f ⁻¹' modelsOf θ = U := by
  have hdisj : Disjoint (Quotient.mk (isoSetoid L V) '' (f '' U))
      (Quotient.mk (isoSetoid L V) '' (f '' Uᶜ)) := by
    rw [Set.disjoint_left]
    rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩ ⟨_, ⟨y, hy, rfl⟩, hxy⟩
    exact hy (hinv (Quotient.exact hxy.symm) hx)
  obtain ⟨θ, hsub, hdisjθ⟩ :=
    exists_sentence_separating (hU.analyticSet_image hf) (hU.compl.analyticSet_image hf) hdisj
  refine ⟨θ, Set.ext fun x => ⟨fun hx => by_contra fun hnot =>
    Set.disjoint_left.mp hdisjθ ⟨x, hnot, rfl⟩ hx, fun hx => hsub ⟨x, hx, rfl⟩⟩⟩

/-- **Recovery of isomorphism-invariant Borel maps into Cantor space.** For a measurable map
`f : X → RelationalConfiguration L V` from a standard Borel space `X`, every measurable map
`g : X → ℕ → Bool` constant on isomorphism classes of values of `f` factors as the truth sequence
of a countable list of `L_{ω₁ω}` sentences composed with `f`. -/
theorem exists_sentenceTheory_comp_eq [∀ n, Countable (L.Relations n)] [Countable V]
    {X : Type*} [MeasurableSpace X] [StandardBorelSpace X]
    {f : X → RelationalConfiguration L V} (hf : Measurable f)
    {g : X → ℕ → Bool} (hg : Measurable g)
    (hinv : ∀ ⦃x y⦄, isoSetoid L V (f x) (f y) → g x = g y) :
    ∃ θ : ℕ → L.Sentenceω, sentenceTheory θ ∘ f = g := by
  have hcoord : ∀ n : ℕ, ∃ θ : L.Sentenceω, f ⁻¹' modelsOf θ = {x | g x n = true} := fun n =>
    exists_sentence_preimage_modelsOf_eq hf
      (((measurable_pi_apply n).comp hg) (measurableSet_singleton true))
      fun _ _ hxy hx => by simpa only [mem_ofPred_eq, ← hinv hxy] using hx
  choose θ hθ using hcoord
  refine ⟨θ, funext fun x => funext fun n => ?_⟩
  rw [Function.comp_apply, Bool.eq_iff_iff, sentenceTheory_eq_true_iff]
  simpa only [mem_preimage, mem_ofPred_eq] using Set.ext_iff.mp (hθ n) x

/-- **Recovery of isomorphism-invariant Borel observables into a countably separated space.** For a
measurable map `f : X → RelationalConfiguration L V` from a standard Borel space `X` and a
measurable map `g : X → Y` into a countably separated measurable space constant on isomorphism
classes of values of `f`, some countable list of `L_{ω₁ω}` sentences has the same kernel on `X` as
`g`. -/
theorem exists_ker_sentenceTheory_comp_eq [∀ n, Countable (L.Relations n)] [Countable V]
    {X Y : Type*} [MeasurableSpace X] [StandardBorelSpace X]
    [MeasurableSpace Y] [MeasurableSpace.CountablySeparated Y]
    {f : X → RelationalConfiguration L V} (hf : Measurable f)
    {g : X → Y} (hg : Measurable g)
    (hinv : ∀ ⦃x y⦄, isoSetoid L V (f x) (f y) → g x = g y) :
    ∃ θ : ℕ → L.Sentenceω, Setoid.ker (sentenceTheory θ ∘ f) = Setoid.ker g := by
  obtain ⟨e, he, hinj⟩ := MeasurableSpace.measurable_injection_nat_bool_of_countablySeparated Y
  obtain ⟨θ, hθ⟩ := exists_sentenceTheory_comp_eq hf (he.comp hg) fun _ _ h => congrArg e (hinv h)
  refine ⟨θ, Setoid.ext fun x y => ?_⟩
  have hx : sentenceTheory θ (f x) = e (g x) := congrFun hθ x
  have hy : sentenceTheory θ (f y) = e (g y) := congrFun hθ y
  simp only [Setoid.ker_def, Function.comp_apply, hx, hy, hinj.eq_iff]

/-- **Cantor recovery.** For any measurable family `f : (ℕ → Bool) → RelationalConfiguration L V`
with pairwise non-isomorphic values, some countable list of `L_{ω₁ω}` sentences recovers each
Cantor coordinate as its truth sequence along `f`. -/
theorem exists_sentenceTheory_comp_eq_id [∀ n, Countable (L.Relations n)] [Countable V]
    {f : (ℕ → Bool) → RelationalConfiguration L V} (hf : Measurable f)
    (hnoniso : ∀ ⦃x y⦄, isoSetoid L V (f x) (f y) → x = y) :
    ∃ θ : ℕ → L.Sentenceω, sentenceTheory θ ∘ f = id := by
  have : TopologicalSpace.IsCompletelyMetrizableSpace (ℕ → Bool) :=
    TopologicalSpace.IsCompletelyMetrizableSpace.pi_countable
  exact exists_sentenceTheory_comp_eq hf measurable_id hnoniso

end LopezEscobar

end TauCeti.RelationalConfiguration
