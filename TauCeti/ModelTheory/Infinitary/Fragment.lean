/-!
# Fragments of `L_{ω₁ω}`

A **fragment** is a set of `L_{ω₁ω}` formulas without free variables, each tagged by its number of
bound-variable slots, that is closed under taking constructor components: both sides of an
implication, the body of a universal quantifier, and every member of a countable conjunction or
disjunction. In this syntax, where bound variables are slots, the component relation is the
subformula relation.

A fragment is not required to contain any atomic formula. Consequently the fragment generated by a
countable set of formulas is countable over every language, however many symbols it has: each
member is reached from a generator by a finite path of component steps, each indexed by a natural
number. Closure under the formation of formulas is a separate condition, not imposed here.

## Main definitions

* `FirstOrder.Language.Fragment`: fragments of `L_{ω₁ω}`, with their `SetLike` and complete
  lattice structure, meets being intersections.
* `FirstOrder.Language.Fragment.GeneratedFrom`: reachability from a set of formulas by component
  steps.
* `FirstOrder.Language.Fragment.generated`: the least fragment containing a set of formulas.
* `FirstOrder.Language.Fragment.ofSentence`, `FirstOrder.Language.Fragment.ofTheory`: the
  fragments generated by a sentence and by a set of sentences.

## Main results

* `FirstOrder.Language.Fragment.generated_le_iff` and `FirstOrder.Language.Fragment.gc`: the
  generated fragment is the least fragment containing its generators.
* `FirstOrder.Language.Fragment.generated_countable`: a countable set generates a countable
  fragment, with no hypothesis on the language.

## References

* D. Marker, *Lectures on Infinitary Model Theory*, Cambridge University Press, 2016, Chapter 1.
* Ported from `cameronfreer/infinitary-logic` at commit
  `518a366cba97b1ae8c4dc64a297a396939bc3e0b`, `InfinitaryLogic/Lomega1omega/Fragment.lean`.
* Divergences from that source: fragments form a complete lattice, built from arbitrary
  intersections, rather than carrying only a top element, binary meets and an order; the
  generated fragment is characterized by a Galois connection; the fragments of a sentence and of
  a theory are named `ofSentence` and `ofTheory`.
-/

public section

universe u v

namespace FirstOrder

namespace Language

variable (L : Language.{u, v})

/-- A **fragment** of `L_{ω₁ω}`: a set of formulas without free variables, tagged by their number
of bound-variable slots, closed under taking constructor components. No atomic formula is required
to belong. -/
structure Fragment where
  /-- The formulas of the fragment, tagged by their number of bound-variable slots. -/
  toSet : Set (Σ n, L.BoundedFormulaω Empty n)
  /-- The antecedent of a member implication is a member. -/
  imp_left_mem' {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n} :
    (⟨n, φ.imp ψ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ⟨n, φ⟩ ∈ toSet
  /-- The consequent of a member implication is a member. -/
  imp_right_mem' {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n} :
    (⟨n, φ.imp ψ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ⟨n, ψ⟩ ∈ toSet
  /-- The body of a member universal quantification is a member. -/
  all_mem' {n : ℕ} {φ : L.BoundedFormulaω Empty (n + 1)} :
    (⟨n, φ.all⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ⟨n + 1, φ⟩ ∈ toSet
  /-- Every conjunct of a member countable conjunction is a member. -/
  iInf_mem' {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n} :
    (⟨n, .iInf φs⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ∀ k, ⟨n, φs k⟩ ∈ toSet
  /-- Every disjunct of a member countable disjunction is a member. -/
  iSup_mem' {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n} :
    (⟨n, .iSup φs⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ∀ k, ⟨n, φs k⟩ ∈ toSet

variable {L}

namespace Fragment

instance : SetLike (Fragment L) (Σ n, L.BoundedFormulaω Empty n) where
  coe := toSet
  coe_injective A B h := by
    cases A
    cases B
    congr

/-- The underlying set of a fragment is its coercion. -/
@[simp]
theorem coe_toSet (A : Fragment L) : A.toSet = (A : Set (Σ n, L.BoundedFormulaω Empty n)) :=
  (rfl)

/-- Membership in a fragment is membership in its underlying set. -/
theorem mem_toSet {A : Fragment L} {p : Σ n, L.BoundedFormulaω Empty n} : p ∈ A.toSet ↔ p ∈ A :=
  Iff.rfl

/-- Fragments with the same members are equal. -/
@[ext]
theorem ext {A B : Fragment L} (h : ∀ p, p ∈ A ↔ p ∈ B) : A = B :=
  SetLike.ext h

/-! ### Closure under components -/

/-- The antecedent of a member implication is a member. -/
theorem imp_left_mem (A : Fragment L) {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n}
    (h : (⟨n, φ.imp ψ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) : ⟨n, φ⟩ ∈ A :=
  A.imp_left_mem' h

/-- The consequent of a member implication is a member. -/
theorem imp_right_mem (A : Fragment L) {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n}
    (h : (⟨n, φ.imp ψ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) : ⟨n, ψ⟩ ∈ A :=
  A.imp_right_mem' h

/-- The body of a member universal quantification is a member. -/
theorem all_mem (A : Fragment L) {n : ℕ} {φ : L.BoundedFormulaω Empty (n + 1)}
    (h : (⟨n, φ.all⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) : ⟨n + 1, φ⟩ ∈ A :=
  A.all_mem' h

/-- Every conjunct of a member countable conjunction is a member. -/
theorem iInf_mem (A : Fragment L) {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n}
    (h : (⟨n, .iInf φs⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) (k : ℕ) : ⟨n, φs k⟩ ∈ A :=
  A.iInf_mem' h k

/-- Every disjunct of a member countable disjunction is a member. -/
theorem iSup_mem (A : Fragment L) {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n}
    (h : (⟨n, .iSup φs⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) (k : ℕ) : ⟨n, φs k⟩ ∈ A :=
  A.iSup_mem' h k

/-! ### The complete lattice of fragments -/

/-- Fragments are ordered by inclusion of their underlying sets. -/
instance : PartialOrder (Fragment L) :=
  .ofSetLike (Fragment L)

/-- The intersection of a family of fragments is a fragment. -/
instance : InfSet (Fragment L) where
  sInf 𝒜 :=
    { toSet := ⋂ A ∈ 𝒜, (A : Set (Σ n, L.BoundedFormulaω Empty n))
      imp_left_mem' h := Set.mem_iInter₂.2 fun A hA => A.imp_left_mem' (Set.mem_iInter₂.1 h A hA)
      imp_right_mem' h := Set.mem_iInter₂.2 fun A hA => A.imp_right_mem' (Set.mem_iInter₂.1 h A hA)
      all_mem' h := Set.mem_iInter₂.2 fun A hA => A.all_mem' (Set.mem_iInter₂.1 h A hA)
      iInf_mem' h k := Set.mem_iInter₂.2 fun A hA => A.iInf_mem' (Set.mem_iInter₂.1 h A hA) k
      iSup_mem' h k := Set.mem_iInter₂.2 fun A hA => A.iSup_mem' (Set.mem_iInter₂.1 h A hA) k }

/-- The underlying set of the meet of a family of fragments is the intersection. -/
@[simp, norm_cast]
theorem coe_sInf (𝒜 : Set (Fragment L)) :
    ((sInf 𝒜 : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) =
      ⋂ A ∈ 𝒜, (A : Set (Σ n, L.BoundedFormulaω Empty n)) :=
  (rfl)

/-- A formula belongs to the meet of a family of fragments exactly when it belongs to each. -/
@[simp]
theorem mem_sInf {𝒜 : Set (Fragment L)} {p : Σ n, L.BoundedFormulaω Empty n} :
    p ∈ sInf 𝒜 ↔ ∀ A ∈ 𝒜, p ∈ A :=
  Set.mem_iInter₂

/-- Fragments form a complete lattice, whose meets are intersections. -/
instance : CompleteLattice (Fragment L) :=
  completeLatticeOfInf (Fragment L) fun _ =>
    ⟨fun A hA => IsConcreteLE.le_iff.2 fun _ hp => mem_sInf.1 hp A hA,
      fun _ hB => IsConcreteLE.le_iff.2 fun _ hp =>
        mem_sInf.2 fun _ hA => IsConcreteLE.le_iff.1 (hB hA) hp⟩

/-- Every formula belongs to the top fragment. -/
@[simp]
theorem mem_top (p : Σ n, L.BoundedFormulaω Empty n) : p ∈ (⊤ : Fragment L) :=
  mem_sInf.2 fun _ h => h.elim

/-- The underlying set of the top fragment is the set of all formulas. -/
@[simp, norm_cast]
theorem coe_top : ((⊤ : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) = Set.univ :=
  Set.eq_univ_of_forall mem_top

/-- A formula belongs to the meet of two fragments exactly when it belongs to both. -/
@[simp]
theorem mem_inf {A B : Fragment L} {p : Σ n, L.BoundedFormulaω Empty n} :
    p ∈ A ⊓ B ↔ p ∈ A ∧ p ∈ B := by
  rw [← sInf_pair, mem_sInf]
  simp

/-- The underlying set of the meet of two fragments is the intersection. -/
@[simp, norm_cast]
theorem coe_inf (A B : Fragment L) :
    ((A ⊓ B : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) =
      (A : Set (Σ n, L.BoundedFormulaω Empty n)) ∩ B :=
  Set.ext fun _ => mem_inf

/-! ### Generated fragments -/

/-- Reachability from a set `S` of formulas by finitely many component steps. -/
inductive GeneratedFrom (S : Set (Σ n, L.BoundedFormulaω Empty n)) :
    (Σ n, L.BoundedFormulaω Empty n) → Prop
  /-- Every generator is reachable. -/
  | base {p} (h : p ∈ S) : GeneratedFrom S p
  /-- The antecedent of a reachable implication is reachable. -/
  | imp_left {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n} :
      GeneratedFrom S ⟨n, φ.imp ψ⟩ → GeneratedFrom S ⟨n, φ⟩
  /-- The consequent of a reachable implication is reachable. -/
  | imp_right {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n} :
      GeneratedFrom S ⟨n, φ.imp ψ⟩ → GeneratedFrom S ⟨n, ψ⟩
  /-- The body of a reachable universal quantification is reachable. -/
  | all_body {n : ℕ} {φ : L.BoundedFormulaω Empty (n + 1)} :
      GeneratedFrom S ⟨n, φ.all⟩ → GeneratedFrom S ⟨n + 1, φ⟩
  /-- Every conjunct of a reachable countable conjunction is reachable. -/
  | iInf_comp {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n} (k : ℕ) :
      GeneratedFrom S ⟨n, .iInf φs⟩ → GeneratedFrom S ⟨n, φs k⟩
  /-- Every disjunct of a reachable countable disjunction is reachable. -/
  | iSup_comp {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n} (k : ℕ) :
      GeneratedFrom S ⟨n, .iSup φs⟩ → GeneratedFrom S ⟨n, φs k⟩

/-- The **fragment generated** by a set of formulas: the formulas reachable from it by component
steps. -/
def generated (S : Set (Σ n, L.BoundedFormulaω Empty n)) : Fragment L where
  toSet := {p | GeneratedFrom S p}
  imp_left_mem' h := .imp_left h
  imp_right_mem' h := .imp_right h
  all_mem' h := .all_body h
  iInf_mem' h k := .iInf_comp k h
  iSup_mem' h k := .iSup_comp k h

/-- Membership in the generated fragment is reachability by component steps. -/
@[simp]
theorem mem_generated {S : Set (Σ n, L.BoundedFormulaω Empty n)}
    {p : Σ n, L.BoundedFormulaω Empty n} : p ∈ generated S ↔ GeneratedFrom S p :=
  Iff.rfl

/-- The generators belong to the generated fragment. -/
theorem subset_generated (S : Set (Σ n, L.BoundedFormulaω Empty n)) :
    S ⊆ generated S :=
  fun _ h => .base h

/-- **Leastness.** The fragment generated by `S` lies below a fragment exactly when `S` does. -/
theorem generated_le_iff {S : Set (Σ n, L.BoundedFormulaω Empty n)} {A : Fragment L} :
    generated S ≤ A ↔ S ⊆ A := by
  refine ⟨fun h => (subset_generated S).trans (SetLike.coe_subset_coe.2 h),
    fun h => IsConcreteLE.le_iff.2 fun p hp => ?_⟩
  induction hp with
  | base hp => exact h hp
  | imp_left _ ih => exact A.imp_left_mem ih
  | imp_right _ ih => exact A.imp_right_mem ih
  | all_body _ ih => exact A.all_mem ih
  | iInf_comp k _ ih => exact A.iInf_mem ih k
  | iSup_comp k _ ih => exact A.iSup_mem ih k

/-- Generation and the underlying set form a Galois connection. -/
theorem gc :
    GaloisConnection (generated : Set (Σ n, L.BoundedFormulaω Empty n) → Fragment L) (↑) :=
  fun _ _ => generated_le_iff

/-- The generated fragment is monotone in its generators. -/
theorem generated_mono {S T : Set (Σ n, L.BoundedFormulaω Empty n)} (h : S ⊆ T) :
    generated S ≤ generated T :=
  gc.monotone_l h

/-- A fragment generates itself. -/
@[simp]
theorem generated_coe (A : Fragment L) :
    generated (A : Set (Σ n, L.BoundedFormulaω Empty n)) = A :=
  le_antisymm (generated_le_iff.2 le_rfl) (subset_generated _)

/-! ### Countability -/

/-- One component step, coded by a tag and an index. -/
private def componentStep : (Σ n, L.BoundedFormulaω Empty n) → ℕ × ℕ →
    Option (Σ n, L.BoundedFormulaω Empty n)
  | ⟨n, .imp φ _⟩, (0, _) => some ⟨n, φ⟩
  | ⟨n, .imp _ ψ⟩, (1, _) => some ⟨n, ψ⟩
  | ⟨n, .all φ⟩, (2, _) => some ⟨n + 1, φ⟩
  | ⟨n, .iInf φs⟩, (3, k) => some ⟨n, φs k⟩
  | ⟨n, .iSup φs⟩, (4, k) => some ⟨n, φs k⟩
  | _, _ => none

/-- Component steps iterated along a list of codes. -/
private def componentPath (p : Σ n, L.BoundedFormulaω Empty n) :
    List (ℕ × ℕ) → Option (Σ n, L.BoundedFormulaω Empty n)
  | [] => some p
  | c :: l => (componentStep p c).bind (componentPath · l)

private theorem componentPath_append (p : Σ n, L.BoundedFormulaω Empty n)
    (l₁ l₂ : List (ℕ × ℕ)) :
    componentPath p (l₁ ++ l₂) = (componentPath p l₁).bind (componentPath · l₂) := by
  induction l₁ generalizing p with
  | nil => rfl
  | cons c l ih =>
    simp only [List.cons_append, componentPath]
    cases componentStep p c with
    | none => rfl
    | some q => exact ih q

/-- Every member of the generated fragment is reached from a generator along a finite list of
coded component steps. -/
private theorem exists_componentPath_of_generatedFrom
    {S : Set (Σ n, L.BoundedFormulaω Empty n)} {p : Σ n, L.BoundedFormulaω Empty n}
    (hp : GeneratedFrom S p) : ∃ s ∈ S, ∃ l : List (ℕ × ℕ), componentPath s l = some p := by
  induction hp with
  | base h => exact ⟨_, h, [], rfl⟩
  | imp_left _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(0, 0)], by rw [componentPath_append, hl]; rfl⟩
  | imp_right _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(1, 0)], by rw [componentPath_append, hl]; rfl⟩
  | all_body _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(2, 0)], by rw [componentPath_append, hl]; rfl⟩
  | iInf_comp k _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(3, k)], by rw [componentPath_append, hl]; rfl⟩
  | iSup_comp k _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(4, k)], by rw [componentPath_append, hl]; rfl⟩

/-- **Countability.** A countable set of formulas generates a countable fragment, over any
language: every member is reached from a generator along a finite list of component steps, each
coded by a pair of natural numbers. -/
theorem generated_countable {S : Set (Σ n, L.BoundedFormulaω Empty n)} (hS : S.Countable) :
    ((generated S : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable := by
  have h : ((generated S : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) ⊆
      ⋃ s ∈ S, Option.some ⁻¹' Set.range (componentPath s) := by
    intro p hp
    obtain ⟨s, hs, l, hl⟩ := exists_componentPath_of_generatedFrom hp
    exact Set.mem_biUnion hs ⟨l, hl⟩
  exact (hS.biUnion fun s _ => (Set.countable_range _).preimage (Option.some_injective _)).mono h

/-! ### The fragments of a sentence and of a theory -/

/-- The fragment generated by a sentence. -/
def ofSentence (φ : L.Sentenceω) : Fragment L :=
  generated {⟨0, φ⟩}

/-- The fragment of a sentence is the fragment generated by the sentence. -/
theorem ofSentence_def (φ : L.Sentenceω) : ofSentence φ = generated {⟨0, φ⟩} :=
  (rfl)

/-- The fragment of a sentence lies below a fragment exactly when the sentence belongs to it. -/
theorem ofSentence_le_iff {φ : L.Sentenceω} {A : Fragment L} :
    ofSentence φ ≤ A ↔ (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A := by
  rw [ofSentence_def, generated_le_iff, Set.singleton_subset_iff, SetLike.mem_coe]

/-- A sentence belongs to the fragment it generates. -/
theorem mem_ofSentence (φ : L.Sentenceω) :
    (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ ofSentence φ :=
  ofSentence_le_iff.1 le_rfl

/-- The fragment generated by a sentence is countable, over any language. -/
theorem ofSentence_countable (φ : L.Sentenceω) :
    ((ofSentence φ : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable :=
  generated_countable (Set.countable_singleton _)

/-- The fragment generated by a set of sentences. -/
def ofTheory (T : Set L.Sentenceω) : Fragment L :=
  generated ((fun φ => ⟨0, φ⟩) '' T)

/-- The fragment of a set of sentences is the fragment generated by its sentences. -/
theorem ofTheory_def (T : Set L.Sentenceω) : ofTheory T = generated ((fun φ => ⟨0, φ⟩) '' T) :=
  (rfl)

/-- The fragment of a set of sentences lies below a fragment exactly when each of the sentences
belongs to it. -/
theorem ofTheory_le_iff {T : Set L.Sentenceω} {A : Fragment L} :
    ofTheory T ≤ A ↔ ∀ φ ∈ T, (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A := by
  rw [ofTheory_def, generated_le_iff, Set.image_subset_iff]
  -- membership in a preimage is membership of the image point
  exact Iff.rfl

/-- Every sentence of a set belongs to the fragment it generates. -/
theorem mem_ofTheory {T : Set L.Sentenceω} {φ : L.Sentenceω} (h : φ ∈ T) :
    (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ ofTheory T :=
  ofTheory_le_iff.1 le_rfl φ h

/-- The fragment of a set of sentences is monotone in the set. -/
theorem ofTheory_mono {T T' : Set L.Sentenceω} (h : T ⊆ T') : ofTheory T ≤ ofTheory T' :=
  ofTheory_le_iff.2 fun _ hφ => mem_ofTheory (h hφ)

/-- The fragment of a single sentence, as a set of sentences, is the fragment of the sentence. -/
@[simp]
theorem ofTheory_singleton (φ : L.Sentenceω) : ofTheory {φ} = ofSentence φ := by
  rw [ofTheory_def, ofSentence_def, Set.image_singleton]

/-- A countable set of sentences generates a countable fragment, over any language. -/
theorem ofTheory_countable {T : Set L.Sentenceω} (hT : T.Countable) :
    ((ofTheory T : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable :=
  generated_countable (hT.image _)

end Fragment

end Language

end FirstOrder
