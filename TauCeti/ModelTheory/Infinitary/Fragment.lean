/-!
# Fragments of `L_{ω₁ω}`

A **fragment** is a set of `L_{ω₁ω}` formulas without free variables, each tagged by its number of
bound-variable slots, that is closed under taking constructor components: both sides of an
implication, the body of a universal quantifier, and every member of a countable conjunction or
disjunction. In this syntax, where bound variables are slots, the component relation is the
subformula relation.

A fragment is not required to contain any atomic formula. Consequently the fragment generated by a
countable set of formulas is countable over every language, however many symbols it has: each
member is reached from a generator by a finite path of component steps, each indexed by a natural
number, and mentions only symbols already occurring in the generators. Closure under the formation
of formulas is a separate condition, not imposed here.

Because a language homomorphism preserves every formula constructor, fragments pull back and push
forward along any language homomorphism `g : L →ᴸ L'`, with no injectivity hypothesis: `map g` and
`comap g` form a Galois connection, `map g` commutes with fragment generation, and the image of the
top fragment of `L` is the symbol-bounded fragment of formulas of `L'` whose symbols lie in the
range of `g`. Along a language equivalence `L ≃ᴸ L'` this gives an order isomorphism of fragment
lattices.

## Main definitions

* `FirstOrder.Language.Fragment`: fragments of `L_{ω₁ω}`, with their `SetLike` and complete
  lattice structure, meets being intersections and joins unions.
* `FirstOrder.Language.Fragment.GeneratedFrom`: reachability from a set of formulas by component
  steps.
* `FirstOrder.Language.Fragment.generated`: the least fragment containing a set of formulas.
* `FirstOrder.Language.Fragment.ofSentence`, `FirstOrder.Language.Fragment.ofTheory`: the
  fragments generated by a sentence and by a set of sentences.
* `FirstOrder.Language.Fragment.functionsIn`, `FirstOrder.Language.Fragment.relationsIn` and
  `FirstOrder.Language.Fragment.ofSymbols`: the symbols occurring across a fragment, and the
  fragment of formulas whose occurring symbols lie in prescribed sets.
* `FirstOrder.Language.Fragment.comap`, `FirstOrder.Language.Fragment.map` and
  `FirstOrder.Language.LEquiv.fragmentOrderIso`: pullback and image of fragments along a language
  homomorphism, and the order isomorphism induced by a language equivalence.

## Main results

* `FirstOrder.Language.Fragment.generated_le_iff` and `FirstOrder.Language.Fragment.gc`: the
  generated fragment is the least fragment containing its generators.
* `FirstOrder.Language.Fragment.generated_countable`: a countable set generates a countable
  fragment, with no hypothesis on the language.
* `FirstOrder.Language.Fragment.le_ofSymbols_iff`,
  `FirstOrder.Language.Fragment.functionsIn_generated` and
  `FirstOrder.Language.Fragment.relationsIn_generated`: component generation adds no function or
  relation symbols.
* `FirstOrder.Language.Fragment.gc_map_comap`, `FirstOrder.Language.Fragment.map_generated` and
  `FirstOrder.Language.Fragment.map_top`: `map` and `comap` form a Galois connection, `map`
  commutes with generation, and the image of the top fragment is the fragment bounded by the symbol
  range.

## References

* D. Marker, *Lectures on Infinitary Model Theory*, Cambridge University Press, 2016, Chapter 1.
* Ported from `cameronfreer/infinitary-logic` at commit
  `518a366cba97b1ae8c4dc64a297a396939bc3e0b`, `InfinitaryLogic/Lomega1omega/Fragment.lean`.
* Divergences from that source: fragments form a complete lattice, built from arbitrary
  intersections, rather than carrying only a top element, binary meets and an order; the
  generated fragment is characterized by a Galois connection; the fragments of a sentence and of
  a theory are named `ofSentence` and `ofTheory`; symbol-bounded fragments and functoriality along
  language maps and equivalences are added.
-/

public section

universe u v u' v' u'' v''

namespace FirstOrder

namespace Language

variable (L : Language.{u, v})

/-- A **fragment** of `L_{ω₁ω}`: a set of formulas without free variables, tagged by their number
of bound-variable slots, closed under taking constructor components. No atomic formula is required
to belong. -/
structure Fragment where
  /-- The formulas of the fragment, tagged by their number of bound-variable slots. -/
  toSet : Set (Σ n, L.BoundedFormulaω Empty n)
  /-- The antecedent of a member implication is a member. -/
  imp_left_mem' {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n} :
    (⟨n, φ.imp ψ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ⟨n, φ⟩ ∈ toSet
  /-- The consequent of a member implication is a member. -/
  imp_right_mem' {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n} :
    (⟨n, φ.imp ψ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ⟨n, ψ⟩ ∈ toSet
  /-- The body of a member universal quantification is a member. -/
  all_mem' {n : ℕ} {φ : L.BoundedFormulaω Empty (n + 1)} :
    (⟨n, φ.all⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ⟨n + 1, φ⟩ ∈ toSet
  /-- Every conjunct of a member countable conjunction is a member. -/
  iInf_mem' {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n} :
    (⟨n, .iInf φs⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ∀ k, ⟨n, φs k⟩ ∈ toSet
  /-- Every disjunct of a member countable disjunction is a member. -/
  iSup_mem' {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n} :
    (⟨n, .iSup φs⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ toSet → ∀ k, ⟨n, φs k⟩ ∈ toSet

variable {L}

namespace Fragment

instance : SetLike (Fragment L) (Σ n, L.BoundedFormulaω Empty n) where
  coe := toSet
  coe_injective A B h := by
    cases A
    cases B
    congr

/-- The underlying set of a fragment is its coercion. -/
@[simp]
theorem coe_toSet (A : Fragment L) : A.toSet = (A : Set (Σ n, L.BoundedFormulaω Empty n)) :=
  (rfl)

/-- Membership in a fragment is membership in its underlying set. -/
theorem mem_toSet {A : Fragment L} {p : Σ n, L.BoundedFormulaω Empty n} : p ∈ A.toSet ↔ p ∈ A :=
  Iff.rfl

/-- Fragments with the same members are equal. -/
@[ext]
theorem ext {A B : Fragment L} (h : ∀ p, p ∈ A ↔ p ∈ B) : A = B :=
  SetLike.ext h

/-! ### Closure under components -/

/-- The antecedent of a member implication is a member. -/
theorem imp_left_mem (A : Fragment L) {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n}
    (h : (⟨n, φ.imp ψ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) : ⟨n, φ⟩ ∈ A :=
  A.imp_left_mem' h

/-- The consequent of a member implication is a member. -/
theorem imp_right_mem (A : Fragment L) {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n}
    (h : (⟨n, φ.imp ψ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) : ⟨n, ψ⟩ ∈ A :=
  A.imp_right_mem' h

/-- The body of a member universal quantification is a member. -/
theorem all_mem (A : Fragment L) {n : ℕ} {φ : L.BoundedFormulaω Empty (n + 1)}
    (h : (⟨n, φ.all⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) : ⟨n + 1, φ⟩ ∈ A :=
  A.all_mem' h

/-- Every conjunct of a member countable conjunction is a member. -/
theorem iInf_mem (A : Fragment L) {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n}
    (h : (⟨n, .iInf φs⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) (k : ℕ) : ⟨n, φs k⟩ ∈ A :=
  A.iInf_mem' h k

/-- Every disjunct of a member countable disjunction is a member. -/
theorem iSup_mem (A : Fragment L) {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n}
    (h : (⟨n, .iSup φs⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) (k : ℕ) : ⟨n, φs k⟩ ∈ A :=
  A.iSup_mem' h k

/-! ### The complete lattice of fragments -/

/-- Fragments are ordered by inclusion of their underlying sets. -/
instance : PartialOrder (Fragment L) :=
  .ofSetLike (Fragment L)

/-- The intersection of a family of fragments is a fragment. -/
instance : InfSet (Fragment L) where
  sInf 𝒜 :=
    { toSet := ⋂ A ∈ 𝒜, (A : Set (Σ n, L.BoundedFormulaω Empty n))
      imp_left_mem' h := Set.mem_iInter₂.2 fun A hA => A.imp_left_mem' (Set.mem_iInter₂.1 h A hA)
      imp_right_mem' h := Set.mem_iInter₂.2 fun A hA => A.imp_right_mem' (Set.mem_iInter₂.1 h A hA)
      all_mem' h := Set.mem_iInter₂.2 fun A hA => A.all_mem' (Set.mem_iInter₂.1 h A hA)
      iInf_mem' h k := Set.mem_iInter₂.2 fun A hA => A.iInf_mem' (Set.mem_iInter₂.1 h A hA) k
      iSup_mem' h k := Set.mem_iInter₂.2 fun A hA => A.iSup_mem' (Set.mem_iInter₂.1 h A hA) k }

/-- The underlying set of the meet of a family of fragments is the intersection. -/
@[simp, norm_cast]
theorem coe_sInf (𝒜 : Set (Fragment L)) :
    ((sInf 𝒜 : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) =
      ⋂ A ∈ 𝒜, (A : Set (Σ n, L.BoundedFormulaω Empty n)) :=
  (rfl)

/-- A formula belongs to the meet of a family of fragments exactly when it belongs to each. -/
@[simp]
theorem mem_sInf {𝒜 : Set (Fragment L)} {p : Σ n, L.BoundedFormulaω Empty n} :
    p ∈ sInf 𝒜 ↔ ∀ A ∈ 𝒜, p ∈ A :=
  Set.mem_iInter₂

/-- Fragments form a complete lattice, whose meets are intersections. -/
instance : CompleteLattice (Fragment L) :=
  completeLatticeOfInf (Fragment L) fun _ =>
    ⟨fun A hA => IsConcreteLE.le_iff.2 fun _ hp => mem_sInf.1 hp A hA,
      fun _ hB => IsConcreteLE.le_iff.2 fun _ hp =>
        mem_sInf.2 fun _ hA => IsConcreteLE.le_iff.1 (hB hA) hp⟩

/-- Every formula belongs to the top fragment. -/
@[simp]
theorem mem_top (p : Σ n, L.BoundedFormulaω Empty n) : p ∈ (⊤ : Fragment L) :=
  mem_sInf.2 fun _ h => h.elim

/-- The underlying set of the top fragment is the set of all formulas. -/
@[simp, norm_cast]
theorem coe_top : ((⊤ : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) = Set.univ :=
  Set.eq_univ_of_forall mem_top

/-- A formula belongs to the meet of two fragments exactly when it belongs to both. -/
@[simp]
theorem mem_inf {A B : Fragment L} {p : Σ n, L.BoundedFormulaω Empty n} :
    p ∈ A ⊓ B ↔ p ∈ A ∧ p ∈ B := by
  rw [← sInf_pair, mem_sInf]
  simp

/-- The underlying set of the meet of two fragments is the intersection. -/
@[simp, norm_cast]
theorem coe_inf (A B : Fragment L) :
    ((A ⊓ B : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) =
      (A : Set (Σ n, L.BoundedFormulaω Empty n)) ∩ B :=
  Set.ext fun _ => mem_inf

/-- The underlying set of the join of a family of fragments is the union: a union of
component-closed sets is component-closed. -/
@[simp, norm_cast]
theorem coe_sSup (𝒜 : Set (Fragment L)) :
    ((sSup 𝒜 : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) =
      ⋃ A ∈ 𝒜, (A : Set (Σ n, L.BoundedFormulaω Empty n)) := by
  -- the union, as a fragment
  let U : Fragment L :=
    { toSet := ⋃ A ∈ 𝒜, (A : Set (Σ n, L.BoundedFormulaω Empty n))
      imp_left_mem' h := by
        obtain ⟨A, hA, hp⟩ := Set.mem_iUnion₂.1 h
        exact Set.mem_iUnion₂.2 ⟨A, hA, A.imp_left_mem hp⟩
      imp_right_mem' h := by
        obtain ⟨A, hA, hp⟩ := Set.mem_iUnion₂.1 h
        exact Set.mem_iUnion₂.2 ⟨A, hA, A.imp_right_mem hp⟩
      all_mem' h := by
        obtain ⟨A, hA, hp⟩ := Set.mem_iUnion₂.1 h
        exact Set.mem_iUnion₂.2 ⟨A, hA, A.all_mem hp⟩
      iInf_mem' h k := by
        obtain ⟨A, hA, hp⟩ := Set.mem_iUnion₂.1 h
        exact Set.mem_iUnion₂.2 ⟨A, hA, A.iInf_mem hp k⟩
      iSup_mem' h k := by
        obtain ⟨A, hA, hp⟩ := Set.mem_iUnion₂.1 h
        exact Set.mem_iUnion₂.2 ⟨A, hA, A.iSup_mem hp k⟩ }
  refine Set.Subset.antisymm ?_
    (Set.iUnion₂_subset fun A hA => SetLike.coe_subset_coe.2 (le_sSup hA))
  exact SetLike.coe_subset_coe.2 (sSup_le (s := 𝒜) (a := U) fun A hA =>
    IsConcreteLE.le_iff.2 fun _ hp => Set.mem_iUnion₂.2 ⟨A, hA, hp⟩)

/-- A formula belongs to the join of a family of fragments exactly when it belongs to one of
them. -/
@[simp]
theorem mem_sSup {𝒜 : Set (Fragment L)} {p : Σ n, L.BoundedFormulaω Empty n} :
    p ∈ sSup 𝒜 ↔ ∃ A ∈ 𝒜, p ∈ A := by
  rw [← SetLike.mem_coe, coe_sSup, Set.mem_iUnion₂]
  simp

/-- A formula belongs to the join of two fragments exactly when it belongs to one of them. -/
@[simp]
theorem mem_sup {A B : Fragment L} {p : Σ n, L.BoundedFormulaω Empty n} :
    p ∈ A ⊔ B ↔ p ∈ A ∨ p ∈ B := by
  rw [← sSup_pair, mem_sSup]
  simp

/-- The underlying set of the join of two fragments is the union. -/
@[simp, norm_cast]
theorem coe_sup (A B : Fragment L) :
    ((A ⊔ B : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) =
      (A : Set (Σ n, L.BoundedFormulaω Empty n)) ∪ B :=
  Set.ext fun _ => mem_sup

/-- No formula belongs to the bottom fragment. -/
@[simp]
theorem notMem_bot (p : Σ n, L.BoundedFormulaω Empty n) : p ∉ (⊥ : Fragment L) := by
  rw [← sSup_empty, mem_sSup]
  simp

/-- The underlying set of the bottom fragment is empty. -/
@[simp, norm_cast]
theorem coe_bot : ((⊥ : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) = ∅ :=
  Set.eq_empty_of_forall_notMem notMem_bot

/-! ### Generated fragments -/

/-- Reachability from a set `S` of formulas by finitely many component steps. -/
inductive GeneratedFrom (S : Set (Σ n, L.BoundedFormulaω Empty n)) :
    (Σ n, L.BoundedFormulaω Empty n) → Prop
  /-- Every generator is reachable. -/
  | base {p} (h : p ∈ S) : GeneratedFrom S p
  /-- The antecedent of a reachable implication is reachable. -/
  | imp_left {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n} :
      GeneratedFrom S ⟨n, φ.imp ψ⟩ → GeneratedFrom S ⟨n, φ⟩
  /-- The consequent of a reachable implication is reachable. -/
  | imp_right {n : ℕ} {φ ψ : L.BoundedFormulaω Empty n} :
      GeneratedFrom S ⟨n, φ.imp ψ⟩ → GeneratedFrom S ⟨n, ψ⟩
  /-- The body of a reachable universal quantification is reachable. -/
  | all_body {n : ℕ} {φ : L.BoundedFormulaω Empty (n + 1)} :
      GeneratedFrom S ⟨n, φ.all⟩ → GeneratedFrom S ⟨n + 1, φ⟩
  /-- Every conjunct of a reachable countable conjunction is reachable. -/
  | iInf_comp {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n} (k : ℕ) :
      GeneratedFrom S ⟨n, .iInf φs⟩ → GeneratedFrom S ⟨n, φs k⟩
  /-- Every disjunct of a reachable countable disjunction is reachable. -/
  | iSup_comp {n : ℕ} {φs : ℕ → L.BoundedFormulaω Empty n} (k : ℕ) :
      GeneratedFrom S ⟨n, .iSup φs⟩ → GeneratedFrom S ⟨n, φs k⟩

/-- The **fragment generated** by a set of formulas: the formulas reachable from it by component
steps. -/
def generated (S : Set (Σ n, L.BoundedFormulaω Empty n)) : Fragment L where
  toSet := {p | GeneratedFrom S p}
  imp_left_mem' h := .imp_left h
  imp_right_mem' h := .imp_right h
  all_mem' h := .all_body h
  iInf_mem' h k := .iInf_comp k h
  iSup_mem' h k := .iSup_comp k h

/-- Membership in the generated fragment is reachability by component steps. -/
@[simp]
theorem mem_generated {S : Set (Σ n, L.BoundedFormulaω Empty n)}
    {p : Σ n, L.BoundedFormulaω Empty n} : p ∈ generated S ↔ GeneratedFrom S p :=
  Iff.rfl

/-- The generators belong to the generated fragment. -/
theorem subset_generated (S : Set (Σ n, L.BoundedFormulaω Empty n)) :
    S ⊆ generated S :=
  fun _ h => .base h

/-- **Leastness.** The fragment generated by `S` lies below a fragment exactly when `S` does. -/
theorem generated_le_iff {S : Set (Σ n, L.BoundedFormulaω Empty n)} {A : Fragment L} :
    generated S ≤ A ↔ S ⊆ A := by
  refine ⟨fun h => (subset_generated S).trans (SetLike.coe_subset_coe.2 h),
    fun h => IsConcreteLE.le_iff.2 fun p hp => ?_⟩
  induction hp with
  | base hp => exact h hp
  | imp_left _ ih => exact A.imp_left_mem ih
  | imp_right _ ih => exact A.imp_right_mem ih
  | all_body _ ih => exact A.all_mem ih
  | iInf_comp k _ ih => exact A.iInf_mem ih k
  | iSup_comp k _ ih => exact A.iSup_mem ih k

/-- Generation and the underlying set form a Galois connection. -/
theorem gc :
    GaloisConnection (generated : Set (Σ n, L.BoundedFormulaω Empty n) → Fragment L) (↑) :=
  fun _ _ => generated_le_iff

/-- The generated fragment is monotone in its generators. -/
theorem generated_mono {S T : Set (Σ n, L.BoundedFormulaω Empty n)} (h : S ⊆ T) :
    generated S ≤ generated T :=
  gc.monotone_l h

/-- A fragment generates itself. -/
@[simp]
theorem generated_coe (A : Fragment L) :
    generated (A : Set (Σ n, L.BoundedFormulaω Empty n)) = A :=
  le_antisymm (generated_le_iff.2 le_rfl) (subset_generated _)

/-- Atomic formulas have no components, so a set of atomic formulas generates the fragment
consisting of exactly those formulas. -/
theorem coe_generated_of_forall_isAtomic {S : Set (Σ n, L.BoundedFormulaω Empty n)}
    (hS : ∀ p ∈ S, p.2.IsAtomic) :
    ((generated S : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) = S := by
  refine Set.Subset.antisymm (fun p hp => ?_) (subset_generated _)
  induction hp with
  | base h => exact h
  | imp_left _ ih | imp_right _ ih | all_body _ ih | iInf_comp _ _ ih | iSup_comp _ _ ih =>
    cases hS _ ih

/-! ### Countability -/

/-- One component step, coded by a tag and an index. -/
private def componentStep : (Σ n, L.BoundedFormulaω Empty n) → ℕ × ℕ →
    Option (Σ n, L.BoundedFormulaω Empty n)
  | ⟨n, .imp φ _⟩, (0, _) => some ⟨n, φ⟩
  | ⟨n, .imp _ ψ⟩, (1, _) => some ⟨n, ψ⟩
  | ⟨n, .all φ⟩, (2, _) => some ⟨n + 1, φ⟩
  | ⟨n, .iInf φs⟩, (3, k) => some ⟨n, φs k⟩
  | ⟨n, .iSup φs⟩, (4, k) => some ⟨n, φs k⟩
  | _, _ => none

/-- Every member of the generated fragment is reached from a generator along a finite list of
coded component steps, iterated by `List.foldlM` in the `Option` monad. -/
private theorem exists_componentPath_of_generatedFrom
    {S : Set (Σ n, L.BoundedFormulaω Empty n)} {p : Σ n, L.BoundedFormulaω Empty n}
    (hp : GeneratedFrom S p) : ∃ s ∈ S, ∃ l : List (ℕ × ℕ), l.foldlM componentStep s = some p := by
  induction hp with
  | base h => exact ⟨_, h, [], rfl⟩
  | imp_left _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(0, 0)], by rw [List.foldlM_append, hl]; rfl⟩
  | imp_right _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(1, 0)], by rw [List.foldlM_append, hl]; rfl⟩
  | all_body _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(2, 0)], by rw [List.foldlM_append, hl]; rfl⟩
  | iInf_comp k _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(3, k)], by rw [List.foldlM_append, hl]; rfl⟩
  | iSup_comp k _ ih =>
    obtain ⟨s, hs, l, hl⟩ := ih
    exact ⟨s, hs, l ++ [(4, k)], by rw [List.foldlM_append, hl]; rfl⟩

/-- **Countability.** A countable set of formulas generates a countable fragment, over any
language: every member is reached from a generator along a finite list of component steps, each
coded by a pair of natural numbers. -/
theorem generated_countable {S : Set (Σ n, L.BoundedFormulaω Empty n)} (hS : S.Countable) :
    ((generated S : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable := by
  have h : ((generated S : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)) ⊆
      ⋃ s ∈ S, Option.some ⁻¹' Set.range fun l : List (ℕ × ℕ) => l.foldlM componentStep s := by
    intro p hp
    obtain ⟨s, hs, l, hl⟩ := exists_componentPath_of_generatedFrom hp
    exact Set.mem_biUnion hs ⟨l, hl⟩
  exact (hS.biUnion fun s _ => (Set.countable_range _).preimage (Option.some_injective _)).mono h

/-! ### The fragments of a sentence and of a theory -/

/-- The fragment generated by a sentence. -/
def ofSentence (φ : L.Sentenceω) : Fragment L :=
  generated {⟨0, φ⟩}

/-- The fragment of a sentence is the fragment generated by the sentence. -/
theorem ofSentence_def (φ : L.Sentenceω) : ofSentence φ = generated {⟨0, φ⟩} :=
  (rfl)

/-- The fragment of a sentence lies below a fragment exactly when the sentence belongs to it. -/
theorem ofSentence_le_iff {φ : L.Sentenceω} {A : Fragment L} :
    ofSentence φ ≤ A ↔ (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A := by
  rw [ofSentence_def, generated_le_iff, Set.singleton_subset_iff, SetLike.mem_coe]

/-- A sentence belongs to the fragment it generates. -/
theorem mem_ofSentence (φ : L.Sentenceω) :
    (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ ofSentence φ :=
  ofSentence_le_iff.1 le_rfl

/-- The fragment generated by a sentence is countable, over any language. -/
theorem ofSentence_countable (φ : L.Sentenceω) :
    ((ofSentence φ : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable :=
  generated_countable (Set.countable_singleton _)

/-- The fragment generated by a set of sentences. -/
def ofTheory (T : Set L.Sentenceω) : Fragment L :=
  generated ((fun φ => ⟨0, φ⟩) '' T)

/-- The fragment of a set of sentences is the fragment generated by its sentences. -/
theorem ofTheory_def (T : Set L.Sentenceω) : ofTheory T = generated ((fun φ => ⟨0, φ⟩) '' T) :=
  (rfl)

/-- The fragment of a set of sentences lies below a fragment exactly when each of the sentences
belongs to it. -/
theorem ofTheory_le_iff {T : Set L.Sentenceω} {A : Fragment L} :
    ofTheory T ≤ A ↔ ∀ φ ∈ T, (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A := by
  rw [ofTheory_def, generated_le_iff, Set.image_subset_iff]
  -- membership in a preimage is membership of the image point
  exact Iff.rfl

/-- Every sentence of a set belongs to the fragment it generates. -/
theorem mem_ofTheory {T : Set L.Sentenceω} {φ : L.Sentenceω} (h : φ ∈ T) :
    (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ ofTheory T :=
  ofTheory_le_iff.1 le_rfl φ h

/-- The fragment of a set of sentences is monotone in the set. -/
theorem ofTheory_mono {T T' : Set L.Sentenceω} (h : T ⊆ T') : ofTheory T ≤ ofTheory T' :=
  ofTheory_le_iff.2 fun _ hφ => mem_ofTheory (h hφ)

/-- The fragment of a single sentence, as a set of sentences, is the fragment of the sentence. -/
@[simp]
theorem ofTheory_singleton (φ : L.Sentenceω) : ofTheory {φ} = ofSentence φ := by
  rw [ofTheory_def, ofSentence_def, Set.image_singleton]

/-- A countable set of sentences generates a countable fragment, over any language. -/
theorem ofTheory_countable {T : Set L.Sentenceω} (hT : T.Countable) :
    ((ofTheory T : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable :=
  generated_countable (hT.image _)

/-! ### Arity slices -/

/-- The formulas of `A` with exactly `n` bound-variable slots. -/
def slice (A : Fragment L) (n : ℕ) : Set (L.BoundedFormulaω Empty n) :=
  Sigma.mk n ⁻¹' (A : Set (Σ n, L.BoundedFormulaω Empty n))

/-- Membership in an arity slice is membership of the tagged formula in the fragment. -/
@[simp]
theorem mem_slice {A : Fragment L} {n : ℕ} {φ : L.BoundedFormulaω Empty n} :
    φ ∈ A.slice n ↔ (⟨n, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A :=
  Iff.rfl

/-- Inclusion of fragments induces inclusion of each arity slice. The corresponding map on
slice subtypes is `Set.inclusion (slice_mono hAB n)`. -/
theorem slice_mono {A B : Fragment L} (hAB : A ≤ B) (n : ℕ) : A.slice n ⊆ B.slice n :=
  fun _ hφ => hAB hφ

/-- Every formula with `n` bound-variable slots lies in the arity slice of the top fragment. -/
@[simp]
theorem slice_top (n : ℕ) : (⊤ : Fragment L).slice n = Set.univ :=
  Set.eq_univ_of_forall fun _ => mem_top _

/-- The arity slices of the bottom fragment are empty. -/
@[simp]
theorem slice_bot (n : ℕ) : (⊥ : Fragment L).slice n = ∅ :=
  Set.eq_empty_of_forall_notMem fun _ => notMem_bot _

/-- Every arity slice of a countable fragment is countable. -/
theorem slice_countable {A : Fragment L}
    (hA : (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable) (n : ℕ) :
    (A.slice n).Countable :=
  hA.preimage sigma_mk_injective

/-! ### Occurring symbols and symbol-bounded fragments -/

/-- The function symbols occurring in the members of `A`, tagged by arity. -/
def functionsIn (A : Fragment L) : Set (Σ k, L.Functions k) :=
  ⋃ p ∈ A, p.2.functionsIn

/-- Unfolding lemma for `Fragment.functionsIn`. -/
theorem functionsIn_def (A : Fragment L) : A.functionsIn = ⋃ p ∈ A, p.2.functionsIn :=
  (rfl)

/-- A function symbol occurs in a fragment exactly when it occurs in some member. -/
@[simp]
theorem mem_functionsIn {A : Fragment L} {s : Σ k, L.Functions k} :
    s ∈ A.functionsIn ↔ ∃ p ∈ A, s ∈ p.2.functionsIn := by
  simp [functionsIn_def]

/-- The relation symbols occurring in the members of `A`, tagged by arity. -/
def relationsIn (A : Fragment L) : Set (Σ k, L.Relations k) :=
  ⋃ p ∈ A, p.2.relationsIn

/-- Unfolding lemma for `Fragment.relationsIn`. -/
theorem relationsIn_def (A : Fragment L) : A.relationsIn = ⋃ p ∈ A, p.2.relationsIn :=
  (rfl)

/-- A relation symbol occurs in a fragment exactly when it occurs in some member. -/
@[simp]
theorem mem_relationsIn {A : Fragment L} {s : Σ k, L.Relations k} :
    s ∈ A.relationsIn ↔ ∃ p ∈ A, s ∈ p.2.relationsIn := by
  simp [relationsIn_def]

/-- Every function symbol of a member occurs in the fragment. -/
theorem functionsIn_subset_of_mem {A : Fragment L} {p : Σ n, L.BoundedFormulaω Empty n}
    (hp : p ∈ A) : p.2.functionsIn ⊆ A.functionsIn :=
  fun _ hs => mem_functionsIn.2 ⟨p, hp, hs⟩

/-- Every relation symbol of a member occurs in the fragment. -/
theorem relationsIn_subset_of_mem {A : Fragment L} {p : Σ n, L.BoundedFormulaω Empty n}
    (hp : p ∈ A) : p.2.relationsIn ⊆ A.relationsIn :=
  fun _ hs => mem_relationsIn.2 ⟨p, hp, hs⟩

/-- Inclusion of fragments induces inclusion of occurring function symbols. -/
theorem functionsIn_mono {A B : Fragment L} (h : A ≤ B) : A.functionsIn ⊆ B.functionsIn :=
  Set.biUnion_mono h fun _ _ => subset_rfl

/-- Inclusion of fragments induces inclusion of occurring relation symbols. -/
theorem relationsIn_mono {A B : Fragment L} (h : A ≤ B) : A.relationsIn ⊆ B.relationsIn :=
  Set.biUnion_mono h fun _ _ => subset_rfl

/-- No function symbol occurs in the empty fragment. -/
@[simp]
theorem functionsIn_bot : (⊥ : Fragment L).functionsIn = ∅ := by
  simp [functionsIn_def]

/-- No relation symbol occurs in the empty fragment. -/
@[simp]
theorem relationsIn_bot : (⊥ : Fragment L).relationsIn = ∅ := by
  simp [relationsIn_def]

/-- The function symbols of a binary join are the union of those of the two fragments. -/
theorem functionsIn_sup (A B : Fragment L) :
    (A ⊔ B).functionsIn = A.functionsIn ∪ B.functionsIn := by
  ext s
  simp [or_and_right, exists_or]

/-- The relation symbols of a binary join are the union of those of the two fragments. -/
theorem relationsIn_sup (A B : Fragment L) :
    (A ⊔ B).relationsIn = A.relationsIn ∪ B.relationsIn := by
  ext s
  simp [or_and_right, exists_or]

/-- A countable fragment mentions only countably many function symbols, over any language. -/
theorem functionsIn_countable {A : Fragment L}
    (hA : (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable) :
    A.functionsIn.Countable :=
  hA.biUnion fun p _ => p.2.functionsIn_countable

/-- A countable fragment mentions only countably many relation symbols, over any language. -/
theorem relationsIn_countable {A : Fragment L}
    (hA : (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable) :
    A.relationsIn.Countable :=
  hA.biUnion fun p _ => p.2.relationsIn_countable

/-- The **symbol-bounded fragment** of `L_{ω₁ω}` formulas whose occurring function symbols lie in
`F` and whose occurring relation symbols lie in `R`. -/
def ofSymbols (F : Set (Σ k, L.Functions k)) (R : Set (Σ k, L.Relations k)) : Fragment L where
  toSet := {p | p.2.functionsIn ⊆ F ∧ p.2.relationsIn ⊆ R}
  imp_left_mem' h := by
    simp only [Set.mem_ofPred_eq, BoundedFormulaInf.functionsIn_imp,
      BoundedFormulaInf.relationsIn_imp, Set.union_subset_iff] at h
    exact ⟨h.1.1, h.2.1⟩
  imp_right_mem' h := by
    simp only [Set.mem_ofPred_eq, BoundedFormulaInf.functionsIn_imp,
      BoundedFormulaInf.relationsIn_imp, Set.union_subset_iff] at h
    exact ⟨h.1.2, h.2.2⟩
  all_mem' h := by
    simpa only [Set.mem_ofPred_eq, BoundedFormulaInf.functionsIn_all,
      BoundedFormulaInf.relationsIn_all] using h
  iInf_mem' h i := by
    simp only [Set.mem_ofPred_eq, BoundedFormulaInf.functionsIn_iInf,
      BoundedFormulaInf.relationsIn_iInf, Set.iUnion_subset_iff] at h
    exact ⟨h.1 i, h.2 i⟩
  iSup_mem' h i := by
    simp only [Set.mem_ofPred_eq, BoundedFormulaInf.functionsIn_iSup,
      BoundedFormulaInf.relationsIn_iSup, Set.iUnion_subset_iff] at h
    exact ⟨h.1 i, h.2 i⟩

/-- Membership in `ofSymbols F R` is containment of occurring symbols in `F` and `R`. -/
@[simp]
theorem mem_ofSymbols {F : Set (Σ k, L.Functions k)} {R : Set (Σ k, L.Relations k)}
    {p : Σ n, L.BoundedFormulaω Empty n} :
    p ∈ ofSymbols F R ↔ p.2.functionsIn ⊆ F ∧ p.2.relationsIn ⊆ R :=
  Iff.rfl

/-- **Universal property of `ofSymbols`.** A fragment lies in `ofSymbols F R` exactly when its
occurring function and relation symbols lie in `F` and `R`. -/
theorem le_ofSymbols_iff {A : Fragment L} {F : Set (Σ k, L.Functions k)}
    {R : Set (Σ k, L.Relations k)} :
    A ≤ ofSymbols F R ↔ A.functionsIn ⊆ F ∧ A.relationsIn ⊆ R :=
  ⟨fun h => ⟨Set.iUnion₂_subset fun _ hp => (mem_ofSymbols.1 (h hp)).1,
    Set.iUnion₂_subset fun _ hp => (mem_ofSymbols.1 (h hp)).2⟩,
    fun h _ hp => ⟨(functionsIn_subset_of_mem hp).trans h.1,
      (relationsIn_subset_of_mem hp).trans h.2⟩⟩

/-- `ofSymbols` is monotone in both symbol sets. -/
theorem ofSymbols_mono {F₁ F₂ : Set (Σ k, L.Functions k)} {R₁ R₂ : Set (Σ k, L.Relations k)}
    (hF : F₁ ⊆ F₂) (hR : R₁ ⊆ R₂) : ofSymbols F₁ R₁ ≤ ofSymbols F₂ R₂ :=
  fun _ hp => ⟨hp.1.trans hF, hp.2.trans hR⟩

/-- Allowing all function and relation symbols gives the top fragment. -/
@[simp]
theorem ofSymbols_univ :
    ofSymbols (Set.univ : Set (Σ k, L.Functions k)) Set.univ = ⊤ :=
  ext fun _ => by simp

/-- The meet of two symbol-bounded fragments is bounded by the intersections of the symbol sets. -/
theorem ofSymbols_inf (F₁ F₂ : Set (Σ k, L.Functions k)) (R₁ R₂ : Set (Σ k, L.Relations k)) :
    ofSymbols F₁ R₁ ⊓ ofSymbols F₂ R₂ = ofSymbols (F₁ ∩ F₂) (R₁ ∩ R₂) :=
  ext fun _ => by simp [and_and_and_comm]

/-- Component generation adds no function symbols: the function symbols of `generated S` are
exactly those occurring in `S`. -/
@[simp]
theorem functionsIn_generated (S : Set (Σ n, L.BoundedFormulaω Empty n)) :
    (generated S).functionsIn = ⋃ s ∈ S, s.2.functionsIn := by
  refine Set.Subset.antisymm ?_
    (Set.biUnion_mono (subset_generated S) fun _ _ => subset_rfl)
  exact (le_ofSymbols_iff.1 (generated_le_iff.2 fun s hs => mem_ofSymbols.2
    ⟨fun _ hs' => Set.mem_iUnion₂.2 ⟨s, hs, hs'⟩,
      fun _ hs' => Set.mem_iUnion₂.2 ⟨s, hs, hs'⟩⟩)).1

/-- Component generation adds no relation symbols: the relation symbols of `generated S` are
exactly those occurring in `S`. -/
@[simp]
theorem relationsIn_generated (S : Set (Σ n, L.BoundedFormulaω Empty n)) :
    (generated S).relationsIn = ⋃ s ∈ S, s.2.relationsIn := by
  refine Set.Subset.antisymm ?_
    (Set.biUnion_mono (subset_generated S) fun _ _ => subset_rfl)
  exact (le_ofSymbols_iff.1 (generated_le_iff.2 fun s hs => mem_ofSymbols.2
    ⟨fun _ hs' => Set.mem_iUnion₂.2 ⟨s, hs, hs'⟩,
      fun _ hs' => Set.mem_iUnion₂.2 ⟨s, hs, hs'⟩⟩)).2

/-- The function symbols occurring in the fragment of a sentence are those of the sentence. -/
@[simp]
theorem functionsIn_ofSentence (φ : L.Sentenceω) :
    (ofSentence φ).functionsIn = φ.functionsIn := by
  simp [ofSentence_def]

/-- The relation symbols occurring in the fragment of a sentence are those of the sentence. -/
@[simp]
theorem relationsIn_ofSentence (φ : L.Sentenceω) :
    (ofSentence φ).relationsIn = φ.relationsIn := by
  simp [ofSentence_def]

/-- The function symbols occurring in the fragment of a set of sentences are those of its
sentences. -/
@[simp]
theorem functionsIn_ofTheory (T : Set L.Sentenceω) :
    (ofTheory T).functionsIn = ⋃ φ ∈ T, φ.functionsIn := by
  simp [ofTheory_def]

/-- The relation symbols occurring in the fragment of a set of sentences are those of its
sentences. -/
@[simp]
theorem relationsIn_ofTheory (T : Set L.Sentenceω) :
    (ofTheory T).relationsIn = ⋃ φ ∈ T, φ.relationsIn := by
  simp [ofTheory_def]

/-! ### Transport along language maps -/

section LanguageMap

variable {L' : Language.{u', v'}} {L'' : Language.{u'', v''}}

/-- The **pullback** of a fragment along a language homomorphism `g : L →ᴸ L'`: the formulas of
`L` whose images under `g` belong to `B`. -/
def comap (g : L →ᴸ L') (B : Fragment L') : Fragment L where
  toSet := {p | (⟨p.1, g.onBoundedFormulaInf p.2⟩ : Σ n, L'.BoundedFormulaω Empty n) ∈ B}
  imp_left_mem' h := B.imp_left_mem
    (by simpa only [Set.mem_ofPred_eq, LHom.onBoundedFormulaInf_imp] using h)
  imp_right_mem' h := B.imp_right_mem
    (by simpa only [Set.mem_ofPred_eq, LHom.onBoundedFormulaInf_imp] using h)
  all_mem' h := B.all_mem
    (by simpa only [Set.mem_ofPred_eq, LHom.onBoundedFormulaInf_all] using h)
  iInf_mem' h k := B.iInf_mem
    (by simpa only [Set.mem_ofPred_eq, LHom.onBoundedFormulaInf_iInf] using h) k
  iSup_mem' h k := B.iSup_mem
    (by simpa only [Set.mem_ofPred_eq, LHom.onBoundedFormulaInf_iSup] using h) k

/-- A formula belongs to `B.comap g` exactly when its translation under `g` belongs to `B`. -/
@[simp]
theorem mem_comap {g : L →ᴸ L'} {B : Fragment L'} {p : Σ n, L.BoundedFormulaω Empty n} :
    p ∈ B.comap g ↔ (⟨p.1, g.onBoundedFormulaInf p.2⟩ : Σ n, L'.BoundedFormulaω Empty n) ∈ B :=
  Iff.rfl

/-- Pulling back along the identity language map is the identity. -/
@[simp]
theorem comap_id (A : Fragment L) : A.comap (LHom.id L) = A :=
  ext fun ⟨_, _⟩ => by simp

/-- Pulling back along a composite language map is iterated pullback. -/
theorem comap_comap (B : Fragment L'') (h : L' →ᴸ L'') (g : L →ᴸ L') :
    (B.comap h).comap g = B.comap (h.comp g) :=
  ext fun ⟨_, _⟩ => by simp

/-- Each arity slice of `B.comap g` is the preimage of the corresponding slice of `B`. -/
@[simp]
theorem slice_comap (g : L →ᴸ L') (B : Fragment L') (n : ℕ) :
    (B.comap g).slice n = g.onBoundedFormulaInf ⁻¹' B.slice n :=
  (rfl)

/-- The **image** of a fragment along a language homomorphism `g : L →ᴸ L'`: the translations
under `g` of the members of `A`. No injectivity of `g` is needed, since `g` preserves outer
constructors. -/
def map (g : L →ᴸ L') (A : Fragment L) : Fragment L' where
  toSet := {p | ∃ φ : L.BoundedFormulaω Empty p.1,
    (⟨p.1, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A ∧ g.onBoundedFormulaInf φ = p.2}
  imp_left_mem' := fun ⟨_, hA, h⟩ => by
    obtain ⟨χ₁, _, rfl, h₁, -⟩ := g.exists_of_onBoundedFormulaInf_eq_imp h
    exact ⟨χ₁, A.imp_left_mem hA, h₁⟩
  imp_right_mem' := fun ⟨_, hA, h⟩ => by
    obtain ⟨_, χ₂, rfl, -, h₂⟩ := g.exists_of_onBoundedFormulaInf_eq_imp h
    exact ⟨χ₂, A.imp_right_mem hA, h₂⟩
  all_mem' := fun ⟨_, hA, h⟩ => by
    obtain ⟨χ₁, rfl, h₁⟩ := g.exists_of_onBoundedFormulaInf_eq_all h
    exact ⟨χ₁, A.all_mem hA, h₁⟩
  iInf_mem' := fun ⟨_, hA, h⟩ k => by
    obtain ⟨χs, rfl, hk⟩ := g.exists_of_onBoundedFormulaInf_eq_iInf h
    exact ⟨χs k, A.iInf_mem hA k, hk k⟩
  iSup_mem' := fun ⟨_, hA, h⟩ k => by
    obtain ⟨χs, rfl, hk⟩ := g.exists_of_onBoundedFormulaInf_eq_iSup h
    exact ⟨χs k, A.iSup_mem hA k, hk k⟩

/-- Membership in `A.map g`: being the translation under `g` of a member of `A` of the same
arity. -/
@[simp]
theorem mem_map {g : L →ᴸ L'} {A : Fragment L} {p : Σ n, L'.BoundedFormulaω Empty n} :
    p ∈ A.map g ↔ ∃ φ : L.BoundedFormulaω Empty p.1,
      (⟨p.1, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A ∧ g.onBoundedFormulaInf φ = p.2 :=
  Iff.rfl

/-- The underlying set of `A.map g` is the image of `A` under `g.onBoundedFormulaInf`. -/
theorem coe_map (g : L →ᴸ L') (A : Fragment L) :
    ((A.map g : Fragment L') : Set (Σ n, L'.BoundedFormulaω Empty n)) =
      (fun p : Σ n, L.BoundedFormulaω Empty n =>
        (⟨p.1, g.onBoundedFormulaInf p.2⟩ : Σ n, L'.BoundedFormulaω Empty n)) '' A := by
  ext ⟨n, ψ⟩
  refine ⟨fun ⟨φ, hφ, h⟩ => ⟨⟨n, φ⟩, hφ, congrArg (Sigma.mk n) h⟩, ?_⟩
  rintro ⟨⟨m, φ⟩, hφ, h⟩
  cases h
  exact ⟨φ, hφ, rfl⟩

/-- Each arity slice of `A.map g` is the image of the corresponding slice of `A`. -/
@[simp]
theorem slice_map (g : L →ᴸ L') (A : Fragment L) (n : ℕ) :
    (A.map g).slice n = g.onBoundedFormulaInf '' A.slice n :=
  (rfl)

/-- The translation under `g` of a member of `A` belongs to `A.map g`. -/
theorem onBoundedFormulaInf_mem_map (g : L →ᴸ L') {A : Fragment L} {n : ℕ}
    {φ : L.BoundedFormulaω Empty n} (hφ : (⟨n, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A) :
    (⟨n, g.onBoundedFormulaInf φ⟩ : Σ n, L'.BoundedFormulaω Empty n) ∈ A.map g :=
  ⟨φ, hφ, rfl⟩

/-- Mapping along the identity language map is the identity. -/
@[simp]
theorem map_id (A : Fragment L) : A.map (LHom.id L) = A :=
  ext fun ⟨_, _⟩ => by simp

/-- Mapping along a composite language map is iterated mapping. -/
theorem map_map (A : Fragment L) (h : L' →ᴸ L'') (g : L →ᴸ L') :
    (A.map g).map h = A.map (h.comp g) := by
  ext ⟨n, χ⟩
  simp only [mem_map, LHom.comp_onBoundedFormulaInf]
  exact ⟨fun ⟨_, ⟨φ, hφ, rfl⟩, hχ⟩ => ⟨φ, hφ, hχ⟩, fun ⟨φ, hφ, hχ⟩ => ⟨_, ⟨φ, hφ, rfl⟩, hχ⟩⟩

/-- **Adjointness of `map` and `comap`.** The image of `A` lies in `B` exactly when `A` lies in
the pullback of `B`. -/
theorem map_le_iff_le_comap {g : L →ᴸ L'} {A : Fragment L} {B : Fragment L'} :
    A.map g ≤ B ↔ A ≤ B.comap g := by
  refine ⟨fun h ⟨_, φ⟩ hφ => mem_comap.2 (h (onBoundedFormulaInf_mem_map g hφ)), ?_⟩
  intro h ⟨n, ψ⟩ hψ
  simp only [mem_map] at hψ
  obtain ⟨φ, hφ, rfl⟩ := hψ
  exact mem_comap.1 (h hφ)

/-- `Fragment.map g` and `Fragment.comap g` form a Galois connection. -/
theorem gc_map_comap (g : L →ᴸ L') :
    GaloisConnection (map g : Fragment L → Fragment L') (comap g) :=
  fun _ _ => map_le_iff_le_comap

/-- `Fragment.map g` is monotone. -/
theorem monotone_map (g : L →ᴸ L') : Monotone (map g : Fragment L → Fragment L') :=
  (gc_map_comap g).monotone_l

/-- `Fragment.comap g` is monotone. -/
theorem monotone_comap (g : L →ᴸ L') : Monotone (comap g : Fragment L' → Fragment L) :=
  (gc_map_comap g).monotone_u

/-- Every fragment lies in the pullback of its image. -/
theorem le_comap_map (g : L →ᴸ L') (A : Fragment L) : A ≤ (A.map g).comap g :=
  (gc_map_comap g).le_u_l A

/-- The image of a pullback lies in the original fragment. -/
theorem map_comap_le (g : L →ᴸ L') (B : Fragment L') : (B.comap g).map g ≤ B :=
  (gc_map_comap g).l_u_le B

/-- Mapping preserves the bottom fragment. -/
@[simp]
theorem map_bot (g : L →ᴸ L') : (⊥ : Fragment L).map g = ⊥ :=
  (gc_map_comap g).l_bot

/-- Mapping commutes with binary joins. -/
theorem map_sup (A B : Fragment L) (g : L →ᴸ L') : (A ⊔ B).map g = A.map g ⊔ B.map g :=
  (gc_map_comap g).l_sup

/-- Mapping commutes with arbitrary joins. -/
theorem map_sSup (𝒜 : Set (Fragment L)) (g : L →ᴸ L') :
    (sSup 𝒜).map g = ⨆ A ∈ 𝒜, A.map g :=
  (gc_map_comap g).l_sSup

/-- Pulling back preserves the top fragment. -/
@[simp]
theorem comap_top (g : L →ᴸ L') : (⊤ : Fragment L').comap g = ⊤ :=
  (gc_map_comap g).u_top

/-- Pulling back commutes with binary meets. -/
theorem comap_inf (A B : Fragment L') (g : L →ᴸ L') :
    (A ⊓ B).comap g = A.comap g ⊓ B.comap g :=
  (gc_map_comap g).u_inf

/-- Pulling back commutes with arbitrary meets. -/
theorem comap_sInf (ℬ : Set (Fragment L')) (g : L →ᴸ L') :
    (sInf ℬ).comap g = ⨅ B ∈ ℬ, B.comap g :=
  (gc_map_comap g).u_sInf

/-- **Mapping commutes with fragment generation.** -/
theorem map_generated (g : L →ᴸ L') (S : Set (Σ n, L.BoundedFormulaω Empty n)) :
    (generated S).map g =
      generated ((fun p : Σ n, L.BoundedFormulaω Empty n =>
        (⟨p.1, g.onBoundedFormulaInf p.2⟩ : Σ n, L'.BoundedFormulaω Empty n)) '' S) := by
  refine le_antisymm ?_ (generated_le_iff.2 ?_)
  · rw [map_le_iff_le_comap, generated_le_iff]
    exact fun p hp => mem_comap.2 (subset_generated _ ⟨p, hp, rfl⟩)
  · rintro _ ⟨⟨n, φ⟩, hp, rfl⟩
    exact onBoundedFormulaInf_mem_map g (subset_generated S hp)

/-- Mapping commutes with forming the fragment of a sentence. -/
@[simp]
theorem map_ofSentence (g : L →ᴸ L') (φ : L.Sentenceω) :
    (ofSentence φ).map g = ofSentence (g.onBoundedFormulaInf φ) := by
  rw [ofSentence_def, ofSentence_def, map_generated, Set.image_singleton]

/-- Mapping commutes with forming the fragment of a set of sentences. -/
@[simp]
theorem map_ofTheory (g : L →ᴸ L') (T : Set L.Sentenceω) :
    (ofTheory T).map g = ofTheory (g.onBoundedFormulaInf '' T) := by
  simp only [ofTheory_def, map_generated, Set.image_image]

/-- Language translation takes the occurring function symbols of a fragment to their image. -/
@[simp]
theorem functionsIn_map (g : L →ᴸ L') (A : Fragment L) :
    (A.map g).functionsIn = (fun s => ⟨s.1, g.onFunction s.2⟩) '' A.functionsIn := by
  ext s'
  simp only [mem_functionsIn, Set.mem_image, Sigma.exists, mem_map]
  constructor
  · rintro ⟨n, _, ⟨φ, hφ, rfl⟩, hs⟩
    obtain ⟨s, hsφ, rfl⟩ := (LHom.functionsIn_onBoundedFormulaInf g φ ▸ hs)
    exact ⟨s.1, s.2, ⟨n, φ, hφ, hsφ⟩, rfl⟩
  · rintro ⟨k, f, ⟨n, φ, hφ, hf⟩, rfl⟩
    exact ⟨n, g.onBoundedFormulaInf φ, ⟨φ, hφ, rfl⟩,
      LHom.functionsIn_onBoundedFormulaInf g φ ▸ ⟨⟨k, f⟩, hf, rfl⟩⟩

/-- Language translation takes the occurring relation symbols of a fragment to their image. -/
@[simp]
theorem relationsIn_map (g : L →ᴸ L') (A : Fragment L) :
    (A.map g).relationsIn = (fun s => ⟨s.1, g.onRelation s.2⟩) '' A.relationsIn := by
  ext s'
  simp only [mem_relationsIn, Set.mem_image, Sigma.exists, mem_map]
  constructor
  · rintro ⟨n, _, ⟨φ, hφ, rfl⟩, hs⟩
    obtain ⟨s, hsφ, rfl⟩ := (LHom.relationsIn_onBoundedFormulaInf g φ ▸ hs)
    exact ⟨s.1, s.2, ⟨n, φ, hφ, hsφ⟩, rfl⟩
  · rintro ⟨k, R, ⟨n, φ, hφ, hR⟩, rfl⟩
    exact ⟨n, g.onBoundedFormulaInf φ, ⟨φ, hφ, rfl⟩,
      LHom.relationsIn_onBoundedFormulaInf g φ ▸ ⟨⟨k, R⟩, hR, rfl⟩⟩

/-- Pulling back a symbol-bounded fragment bounds symbols by their preimages under `g`. -/
@[simp]
theorem comap_ofSymbols (g : L →ᴸ L') (F' : Set (Σ k, L'.Functions k))
    (R' : Set (Σ k, L'.Relations k)) :
    (ofSymbols F' R').comap g =
      ofSymbols ((fun s => ⟨s.1, g.onFunction s.2⟩) ⁻¹' F')
        ((fun s => ⟨s.1, g.onRelation s.2⟩) ⁻¹' R') :=
  ext fun ⟨_, φ⟩ => by
    simp [LHom.functionsIn_onBoundedFormulaInf, LHom.relationsIn_onBoundedFormulaInf,
      Set.image_subset_iff]

/-- **Image of the top fragment.** For any language homomorphism `g : L →ᴸ L'`, the image of `⊤`
is the fragment of formulas of `L'` whose occurring symbols lie in the range of `g`. No
injectivity of `g` is needed. -/
theorem map_top (g : L →ᴸ L') :
    (⊤ : Fragment L).map g =
      ofSymbols
        (Set.range fun s : Σ k, L.Functions k => (⟨s.1, g.onFunction s.2⟩ : Σ k, L'.Functions k))
        (Set.range fun s : Σ k, L.Relations k =>
          (⟨s.1, g.onRelation s.2⟩ : Σ k, L'.Relations k)) := by
  ext ⟨n, ψ⟩
  simp only [mem_map, mem_top, true_and, mem_ofSymbols]
  refine ⟨fun ⟨φ, hφ⟩ => ?_,
    fun ⟨hF, hR⟩ => g.exists_eq_onBoundedFormulaInf_of_subset_range ψ hF hR⟩
  rw [← hφ, LHom.functionsIn_onBoundedFormulaInf, LHom.relationsIn_onBoundedFormulaInf]
  exact ⟨Set.image_subset_range _ _, Set.image_subset_range _ _⟩

/-- **Symbol-bounded fragments as images from symbol sublanguages.** The image of all formulas of
`symbSublang F R` along the sublanguage inclusion is `ofSymbols F R`. -/
@[simp]
theorem map_top_symbSublangIncl (F : Set (Σ k, L.Functions k)) (R : Set (Σ k, L.Relations k)) :
    (⊤ : Fragment (symbSublang F R)).map (symbSublangIncl F R) = ofSymbols F R := by
  ext ⟨n, ψ⟩
  simp only [mem_map, mem_top, true_and, mem_ofSymbols]
  refine ⟨fun ⟨φ, hφ⟩ => ?_, fun ⟨hF, hR⟩ =>
    ⟨ψ.restrictSymbols hF hR, BoundedFormulaInf.onBoundedFormulaInf_restrictSymbols ψ hF hR⟩⟩
  rw [← hφ, LHom.functionsIn_onBoundedFormulaInf, LHom.relationsIn_onBoundedFormulaInf]
  exact ⟨by rintro _ ⟨⟨k, f, hf⟩, _, rfl⟩; simpa using hf,
    by rintro _ ⟨⟨k, r, hr⟩, _, rfl⟩; simpa using hr⟩

/-- The image of a countable fragment under any language homomorphism is countable. -/
theorem map_countable (g : L →ᴸ L') {A : Fragment L}
    (hA : (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable) :
    ((A.map g : Fragment L') : Set (Σ n, L'.BoundedFormulaω Empty n)).Countable := by
  rw [coe_map]
  exact hA.image _

/-- Along an injective language map, a translated formula belongs to `A.map g` exactly when the
original formula belongs to `A`. -/
theorem mem_map_onBoundedFormulaInf_iff {g : L →ᴸ L'} (hg : g.Injective) {A : Fragment L} {n : ℕ}
    {φ : L.BoundedFormulaω Empty n} :
    (⟨n, g.onBoundedFormulaInf φ⟩ : Σ n, L'.BoundedFormulaω Empty n) ∈ A.map g ↔
      (⟨n, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A :=
  ⟨fun ⟨_, hψ, h⟩ => hg.onBoundedFormulaInf_injective h ▸ hψ, onBoundedFormulaInf_mem_map g⟩

/-- Pulling back the image along an injective language map recovers the fragment. -/
theorem comap_map_of_injective {g : L →ᴸ L'} (hg : g.Injective) (A : Fragment L) :
    (A.map g).comap g = A :=
  ext fun ⟨_, _⟩ => mem_comap.trans (mem_map_onBoundedFormulaInf_iff hg)

/-- An injective language map induces an injective map on fragments. -/
theorem map_injective {g : L →ᴸ L'} (hg : g.Injective) :
    Function.Injective (map g : Fragment L → Fragment L') :=
  fun A B h => by rw [← comap_map_of_injective hg A, ← comap_map_of_injective hg B, h]

/-- Mapping along an injective language map commutes with binary meets. -/
theorem map_inf_of_injective {g : L →ᴸ L'} (hg : g.Injective) (A B : Fragment L) :
    (A ⊓ B).map g = A.map g ⊓ B.map g := by
  refine le_antisymm (le_inf (monotone_map g inf_le_left) (monotone_map g inf_le_right)) ?_
  intro ⟨n, ψ⟩ hp
  simp only [mem_inf, mem_map] at hp
  obtain ⟨⟨φ, hφA, rfl⟩, hB⟩ := hp
  exact onBoundedFormulaInf_mem_map g (mem_inf.2 ⟨hφA, (mem_map_onBoundedFormulaInf_iff hg).1 hB⟩)

/-- Pulling back a countable fragment along an injective language map gives a countable
fragment. -/
theorem comap_countable_of_injective {g : L →ᴸ L'} (hg : g.Injective) {B : Fragment L'}
    (hB : (B : Set (Σ n, L'.BoundedFormulaω Empty n)).Countable) :
    ((B.comap g : Fragment L) : Set (Σ n, L.BoundedFormulaω Empty n)).Countable := by
  refine (hB.preimage (f := fun p : Σ n, L.BoundedFormulaω Empty n =>
      (⟨p.1, g.onBoundedFormulaInf p.2⟩ : Σ n, L'.BoundedFormulaω Empty n)) ?_)
  rintro ⟨m, φ⟩ ⟨n, ψ⟩ h
  simp only [Sigma.mk.inj_iff] at h
  obtain ⟨rfl, h⟩ := h
  exact Sigma.ext rfl (heq_of_eq (hg.onBoundedFormulaInf_injective (eq_of_heq h)))

end LanguageMap

end Fragment

namespace LEquiv

variable {L : Language.{u, v}} {L' : Language.{u', v'}} {L'' : Language.{u'', v''}}

/-- A language equivalence induces an order isomorphism between the complete lattices of
fragments. -/
def fragmentOrderIso (e : L ≃ᴸ L') : Fragment L ≃o Fragment L' where
  toFun := Fragment.map e.toLHom
  invFun := Fragment.map e.invLHom
  left_inv A := by rw [Fragment.map_map, e.left_inv, Fragment.map_id]
  right_inv B := by rw [Fragment.map_map, e.right_inv, Fragment.map_id]
  map_rel_iff' {A B} := ⟨fun h => by
      have h' := Fragment.monotone_map e.invLHom h
      simpa only [Equiv.coe_fn_mk, Fragment.map_map, e.left_inv, Fragment.map_id] using h',
    fun h => Fragment.monotone_map e.toLHom h⟩

/-- The forward map of `fragmentOrderIso` is `Fragment.map` along `e.toLHom`. -/
@[simp]
theorem fragmentOrderIso_apply (e : L ≃ᴸ L') (A : Fragment L) :
    e.fragmentOrderIso A = A.map e.toLHom :=
  (rfl)

/-- The inverse map of `fragmentOrderIso` is `Fragment.map` along `e.invLHom`. -/
@[simp]
theorem fragmentOrderIso_symm_apply (e : L ≃ᴸ L') (B : Fragment L') :
    e.fragmentOrderIso.symm B = B.map e.invLHom :=
  (rfl)

/-- Symmetry of the language equivalence corresponds to inverting `fragmentOrderIso`. -/
theorem fragmentOrderIso_symm (e : L ≃ᴸ L') :
    e.fragmentOrderIso.symm = e.symm.fragmentOrderIso :=
  (rfl)

/-- The identity language equivalence induces the identity order isomorphism of fragments. -/
@[simp]
theorem fragmentOrderIso_refl :
    (LEquiv.refl L).fragmentOrderIso = OrderIso.refl (Fragment L) := by
  ext A p
  simp [LEquiv.refl]

/-- Composition of language equivalences corresponds to composition of fragment order
isomorphisms. -/
theorem fragmentOrderIso_trans (e : L ≃ᴸ L') (e' : L' ≃ᴸ L'') :
    (e.trans e').fragmentOrderIso = e.fragmentOrderIso.trans e'.fragmentOrderIso := by
  ext A p
  simp [LEquiv.trans, Fragment.map_map]

/-- Along a language equivalence, pulling back along `e.toLHom` agrees with mapping along
`e.invLHom`. -/
theorem comap_toLHom_eq_map_invLHom (e : L ≃ᴸ L') (B : Fragment L') :
    B.comap e.toLHom = B.map e.invLHom := by
  refine le_antisymm ?_ ?_
  · intro ⟨n, φ⟩ hφ
    have h := Fragment.onBoundedFormulaInf_mem_map e.invLHom (Fragment.mem_comap.1 hφ)
    rwa [← LHom.comp_onBoundedFormulaInf, e.left_inv, LHom.id_onBoundedFormulaInf] at h
  · rw [Fragment.map_le_iff_le_comap, Fragment.comap_comap, e.right_inv, Fragment.comap_id]

/-- Along a language equivalence, pulling back along `e.invLHom` agrees with mapping along
`e.toLHom`. -/
theorem comap_invLHom_eq_map_toLHom (e : L ≃ᴸ L') (A : Fragment L) :
    A.comap e.invLHom = A.map e.toLHom :=
  e.symm.comap_toLHom_eq_map_invLHom A

end LEquiv

end Language

end FirstOrder
