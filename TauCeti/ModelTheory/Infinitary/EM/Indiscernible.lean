public import TauCeti.ModelTheory.Infinitary.Equiv
public import TauCeti.ModelTheory.Infinitary.Operations

/-!
# Indiscernible sequences for infinitary formulas

A sequence `a : J → M` indexed by a linear order `J` is *indiscernible* for a set `Δ` of
`L_{ω₁ω}` formulas when each formula of `Δ` takes the same truth value at every increasing tuple of
`a`. Formulas carry their variables in bound positions: a formula with `n` variables is an
`L.BoundedFormulaω Empty n`, a set of such formulas of varying arity is a
`Set (Σ n, L.BoundedFormulaω Empty n)`, and an increasing `n`-tuple of `J` is an order embedding
`Fin n ↪o J`. The definitions only use order embeddings, so they are stated for preorders `J`;
linear orders are the intended case.

Indiscernible sequences are the raw material of the Ehrenfeucht–Mostowski method: the truth values
they give their increasing tuples are recorded as a template, from which models generated by
indiscernibles over arbitrary linear orders are built.

Indiscernibility on `Δ` is preserved by passing to subsequences along order embeddings, by
transport along order isomorphisms and along isomorphisms of the structure, and by enlarging `Δ`
with the Boolean combinations (negation, implication, countable `iSup` and `iInf`) of its members
and with their relabellings along order embeddings `Fin m ↪o Fin n` of the bound positions.
Quantification does not preserve it: in `(ℕ, <)` the identity sequence is indiscernible for
`¬(x₁ < x₀)`, which holds at every increasing pair, but not for `∀ x₁, ¬(x₁ < x₀)`, which holds at
`0` and fails at `1`.

## Main definitions

* `FirstOrder.Language.IsIndiscernibleOn a Δ`: each formula of `Δ` has the same truth value at
  every increasing tuple of `a`.
* `FirstOrder.Language.IsIndiscernible L a`: indiscernibility for every formula of every arity.

## Main results

* `FirstOrder.Language.isIndiscernibleOn_of_forall_fst_eq_zero`: every sequence is indiscernible
  for every set of sentences.
* `FirstOrder.Language.isIndiscernibleOn_equal_var`: an injective sequence is indiscernible for
  every equation between two variables.
* `FirstOrder.Language.IsIndiscernibleOn.comp_orderEmbedding`,
  `FirstOrder.Language.isIndiscernibleOn_comp_orderIso_iff`: restriction along order embeddings
  and transport along order isomorphisms of the index order.
* `FirstOrder.Language.StrongHomClass.isIndiscernibleOn_comp_iff`: invariance under isomorphisms
  of the structure.
* `FirstOrder.Language.IsIndiscernibleOn.insert_not`, `insert_imp`, `insert_iSup`, `insert_iInf`
  and `insert_mapBound`: the Boolean combinations and order-preserving relabellings of members of
  `Δ` may be added to `Δ`.

## References

* D. Marker, *Lectures on Infinitary Model Theory*, Lecture Notes in Logic 46 (2016), §5.1: the
  indiscernibility conditions `Γ` in the proof of Theorem 5.2.
* C. Freer, `cameronfreer/infinitary-logic` (Apache-2.0) at commit
  `518a366cba97b1ae8c4dc64a297a396939bc3e0b`: `InfinitaryLogic/Methods/EM/Indiscernible.lean`
  (`IsLomega1omegaIndiscernible` and its `Γ`-restricted form) and
  `InfinitaryLogic/Methods/TailIndiscernible.lean` (a tail-restricted variant) formalize
  indiscernibility for `L_{ω₁ω}`. Divergences: index types are preorders rather than linear
  orders, increasing tuples are order embeddings `Fin n ↪o J` rather than strictly monotone maps,
  and the restricted form is relative to a set of formulas rather than a sequence of them.
-/

public section

universe u v w w' u₁ u₂

namespace FirstOrder

namespace Language

variable {L : Language.{u, v}} {J : Type u₁} {K : Type u₂} [Preorder J] [Preorder K]
  {M : Type w} [L.Structure M] {a : J → M} {Δ Δ' : Set (Σ n, L.BoundedFormulaω Empty n)}
  {n m : ℕ}

/-- A sequence `a` indexed by an order is *indiscernible* for a set `Δ` of formulas in bound
positions when each formula of `Δ` has the same truth value at every increasing tuple of `a`, that
is, at `a ∘ s` for every order embedding `s : Fin n ↪o J`. -/
def IsIndiscernibleOn (a : J → M) (Δ : Set (Σ n, L.BoundedFormulaω Empty n)) : Prop :=
  ∀ p ∈ Δ, ∀ s t : Fin p.1 ↪o J,
    p.2.Realize (Empty.elim : Empty → M) (a ∘ s) ↔ p.2.Realize (Empty.elim : Empty → M) (a ∘ t)

variable (L) in
/-- A sequence is *indiscernible* when it is indiscernible for every formula of every arity. -/
def IsIndiscernible (a : J → M) : Prop :=
  IsIndiscernibleOn a (Set.univ : Set (Σ n, L.BoundedFormulaω Empty n))

theorem isIndiscernibleOn_def :
    IsIndiscernibleOn a Δ ↔
      ∀ p ∈ Δ, ∀ s t : Fin p.1 ↪o J,
        p.2.Realize (Empty.elim : Empty → M) (a ∘ s) ↔
          p.2.Realize (Empty.elim : Empty → M) (a ∘ t) :=
  Iff.rfl

theorem isIndiscernible_iff :
    L.IsIndiscernible a ↔
      ∀ (n : ℕ) (φ : L.BoundedFormulaω Empty n) (s t : Fin n ↪o J),
        φ.Realize (Empty.elim : Empty → M) (a ∘ s) ↔ φ.Realize (Empty.elim : Empty → M) (a ∘ t) :=
  ⟨fun h n φ ↦ h ⟨n, φ⟩ trivial, fun h p _ ↦ h p.1 p.2⟩

/-- An indiscernible sequence is indiscernible for every set of formulas. -/
theorem IsIndiscernible.isIndiscernibleOn (h : L.IsIndiscernible a)
    (Δ : Set (Σ n, L.BoundedFormulaω Empty n)) : IsIndiscernibleOn a Δ :=
  fun p _ ↦ h p trivial

/-- A formula of `Δ` has the same truth value at any two increasing tuples of a sequence
indiscernible for `Δ`. -/
theorem IsIndiscernibleOn.realize_iff (h : IsIndiscernibleOn a Δ)
    {φ : L.BoundedFormulaω Empty n} (hφ : ⟨n, φ⟩ ∈ Δ) (s t : Fin n ↪o J) :
    φ.Realize (Empty.elim : Empty → M) (a ∘ s) ↔ φ.Realize (Empty.elim : Empty → M) (a ∘ t) :=
  h _ hφ s t

/-- Indiscernibility for one formula: it has the same truth value at any two increasing
tuples. -/
@[simp]
theorem isIndiscernibleOn_singleton {φ : L.BoundedFormulaω Empty n} :
    IsIndiscernibleOn a {⟨n, φ⟩} ↔
      ∀ s t : Fin n ↪o J,
        φ.Realize (Empty.elim : Empty → M) (a ∘ s) ↔ φ.Realize (Empty.elim : Empty → M) (a ∘ t) :=
  ⟨fun h ↦ h.realize_iff rfl, fun h ↦ by rintro _ rfl; exact h⟩

theorem IsIndiscernibleOn.mono (hΔ : Δ' ⊆ Δ) (h : IsIndiscernibleOn a Δ) :
    IsIndiscernibleOn a Δ' :=
  fun p hp ↦ h p (hΔ hp)

@[simp]
theorem isIndiscernibleOn_empty : IsIndiscernibleOn a (∅ : Set (Σ n, L.BoundedFormulaω Empty n)) :=
  fun _ hp ↦ hp.elim

@[simp]
theorem isIndiscernibleOn_union :
    IsIndiscernibleOn a (Δ ∪ Δ') ↔ IsIndiscernibleOn a Δ ∧ IsIndiscernibleOn a Δ' :=
  ⟨fun h ↦ ⟨h.mono Set.subset_union_left, h.mono Set.subset_union_right⟩,
    fun h p hp ↦ hp.elim (h.1 p) (h.2 p)⟩

@[simp]
theorem isIndiscernibleOn_iUnion {ι : Sort*} {Δs : ι → Set (Σ n, L.BoundedFormulaω Empty n)} :
    IsIndiscernibleOn a (⋃ i, Δs i) ↔ ∀ i, IsIndiscernibleOn a (Δs i) :=
  ⟨fun h i ↦ h.mono (Set.subset_iUnion Δs i), fun h p hp ↦ by
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hp
    exact h i p hi⟩

@[simp]
theorem isIndiscernibleOn_insert {p : Σ n, L.BoundedFormulaω Empty n} :
    IsIndiscernibleOn a (insert p Δ) ↔ IsIndiscernibleOn a {p} ∧ IsIndiscernibleOn a Δ := by
  rw [Set.insert_eq, isIndiscernibleOn_union]

/-- **Sentences are indiscernible.** Every sequence is indiscernible for every set of formulas
without variables, since there is exactly one increasing `0`-tuple. -/
theorem isIndiscernibleOn_of_forall_fst_eq_zero (a : J → M) (hΔ : ∀ p ∈ Δ, p.1 = 0) :
    IsIndiscernibleOn a Δ := by
  rintro ⟨n, φ⟩ hp s t
  obtain rfl : n = 0 := hΔ _ hp
  rw [show s = t from RelEmbedding.ext fun k ↦ k.elim0]

/-- An injective sequence is indiscernible for every equation `xᵢ = xⱼ` between two variables: at
every increasing tuple the equation holds exactly when `i = j`. -/
theorem isIndiscernibleOn_equal_var (ha : Function.Injective a) (i j : Fin n) :
    IsIndiscernibleOn a
      {⟨n, BoundedFormulaInf.equal (L := L) (Term.var (Sum.inr i)) (Term.var (Sum.inr j))⟩} := by
  simp [ha.eq_iff]

/-- **Restriction to a subsequence.** If `a` is indiscernible for `Δ`, so is its composite with an
order embedding of index orders. -/
theorem IsIndiscernibleOn.comp_orderEmbedding (h : IsIndiscernibleOn a Δ) (e : K ↪o J) :
    IsIndiscernibleOn (a ∘ e) Δ := fun p hp s t ↦ by
  simpa only [RelEmbedding.coe_trans, Function.comp_assoc] using h p hp (s.trans e) (t.trans e)

/-- **Transport along an order isomorphism** of index orders. -/
theorem isIndiscernibleOn_comp_orderIso_iff (e : K ≃o J) :
    IsIndiscernibleOn (a ∘ e) Δ ↔ IsIndiscernibleOn a Δ := by
  refine ⟨fun h ↦ ?_, fun h ↦ h.comp_orderEmbedding e.toOrderEmbedding⟩
  have ha : (a ∘ e) ∘ e.symm = a := funext fun x ↦ by simp
  simpa only [OrderIso.coe_toOrderEmbedding, ha] using h.comp_orderEmbedding e.symm.toOrderEmbedding

/-- **Negation.** A sequence indiscernible for `Δ` is indiscernible for the negation of a member
of `Δ`. -/
theorem IsIndiscernibleOn.insert_not (h : IsIndiscernibleOn a Δ) {φ : L.BoundedFormulaω Empty n}
    (hφ : ⟨n, φ⟩ ∈ Δ) : IsIndiscernibleOn a (insert ⟨n, φ.not⟩ Δ) :=
  isIndiscernibleOn_insert.2 ⟨isIndiscernibleOn_singleton.2 fun s t ↦ by
    simp only [BoundedFormulaInf.realize_not, h.realize_iff hφ s t], h⟩

/-- **Implication.** A sequence indiscernible for `Δ` is indiscernible for the implication between
two members of `Δ`. -/
theorem IsIndiscernibleOn.insert_imp (h : IsIndiscernibleOn a Δ)
    {φ ψ : L.BoundedFormulaω Empty n} (hφ : ⟨n, φ⟩ ∈ Δ) (hψ : ⟨n, ψ⟩ ∈ Δ) :
    IsIndiscernibleOn a (insert ⟨n, φ.imp ψ⟩ Δ) :=
  isIndiscernibleOn_insert.2 ⟨isIndiscernibleOn_singleton.2 fun s t ↦ by
    simp only [BoundedFormulaInf.realize_imp, h.realize_iff hφ s t, h.realize_iff hψ s t], h⟩

/-- **Countable disjunction.** A sequence indiscernible for `Δ` is indiscernible for the
disjunction of countably many members of `Δ`. -/
theorem IsIndiscernibleOn.insert_iSup (h : IsIndiscernibleOn a Δ)
    {φs : ℕ → L.BoundedFormulaω Empty n} (hφs : ∀ i, ⟨n, φs i⟩ ∈ Δ) :
    IsIndiscernibleOn a (insert ⟨n, .iSup φs⟩ Δ) :=
  isIndiscernibleOn_insert.2 ⟨isIndiscernibleOn_singleton.2 fun s t ↦ by
    simp only [BoundedFormulaInf.realize_iSup, fun i ↦ h.realize_iff (hφs i) s t], h⟩

/-- **Countable conjunction.** A sequence indiscernible for `Δ` is indiscernible for the
conjunction of countably many members of `Δ`. -/
theorem IsIndiscernibleOn.insert_iInf (h : IsIndiscernibleOn a Δ)
    {φs : ℕ → L.BoundedFormulaω Empty n} (hφs : ∀ i, ⟨n, φs i⟩ ∈ Δ) :
    IsIndiscernibleOn a (insert ⟨n, .iInf φs⟩ Δ) :=
  isIndiscernibleOn_insert.2 ⟨isIndiscernibleOn_singleton.2 fun s t ↦ by
    simp only [BoundedFormulaInf.realize_iInf, fun i ↦ h.realize_iff (hφs i) s t], h⟩

/-- **Order-preserving relabelling.** A sequence indiscernible for `Δ` is indiscernible for the
relabelling of a member of `Δ` along an order embedding `Fin m ↪o Fin n` of bound positions: an
increasing `n`-tuple composed with it is an increasing `m`-tuple. -/
theorem IsIndiscernibleOn.insert_mapBound (h : IsIndiscernibleOn a Δ)
    {φ : L.BoundedFormulaω Empty m} (hφ : ⟨m, φ⟩ ∈ Δ) (r : Fin m ↪o Fin n) :
    IsIndiscernibleOn a (insert ⟨n, φ.mapBound r⟩ Δ) :=
  isIndiscernibleOn_insert.2 ⟨isIndiscernibleOn_singleton.2 fun s t ↦ by
    simpa only [BoundedFormulaInf.realize_mapBound, RelEmbedding.coe_trans,
      Function.comp_assoc] using h.realize_iff hφ (r.trans s) (r.trans t), h⟩

end Language

namespace Language.StrongHomClass

variable {L : Language.{u, v}} {J : Type u₁} [Preorder J] {M : Type w} {N : Type w'}
  [L.Structure M] [L.Structure N] {a : J → M} {Δ : Set (Σ n, L.BoundedFormulaω Empty n)}

/-- **Invariance under isomorphisms of the structure.** A sequence is indiscernible for `Δ` exactly
when its image under an isomorphism is. -/
theorem isIndiscernibleOn_comp_iff {F : Type*} [EquivLike F M N] [StrongHomClass L F M N]
    (g : F) : IsIndiscernibleOn (g ∘ a) Δ ↔ IsIndiscernibleOn a Δ := by
  have key {n : ℕ} (φ : L.BoundedFormulaω Empty n) (xs : Fin n → M) :
      φ.Realize (Empty.elim : Empty → N) (g ∘ xs) ↔ φ.Realize (Empty.elim : Empty → M) xs := by
    rw [← realize_boundedFormulaInf g φ (v := Empty.elim),
      Subsingleton.elim (g ∘ (Empty.elim : Empty → M)) Empty.elim]
  refine forall₂_congr fun p _ ↦ forall₂_congr fun s t ↦ ?_
  rw [Function.comp_assoc, Function.comp_assoc, key, key]

end Language.StrongHomClass

end FirstOrder
