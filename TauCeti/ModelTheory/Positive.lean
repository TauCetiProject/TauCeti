public import TauCeti.ModelTheory.Complexity

/-!
# Positive first-order formulas

A first-order formula is *positive* when it is built from atomic formulas using only
conjunction, disjunction and the two quantifiers: no negation and no implication occurs in it.
`FirstOrder.Language.BoundedFormula.IsPositive` is this predicate on Mathlib's bounded formulas.

Mathlib's primitive connectives are `⊥`, implication and `∀`; conjunction, disjunction and `∃`
are abbreviations built from them. The predicate is therefore generated by the derived
connectives `⊓`, `⊔` and `∃` (as `FirstOrder.Language.BoundedFormula.IsPrenex` is for `∃`), and
the inversion lemmas `isPositive_inf_iff`, `isPositive_sup_iff`, `isPositive_all_iff` and
`isPositive_ex_iff` show that a positive formula has exactly one such decomposition. Following
Mathlib's convention for atomic formulas, `⊥` and `⊤` are not positive: positive formulas are
generated by equations and relations alone.

## Main results

* `FirstOrder.Language.BoundedFormula.IsPositive.realize_comp_of_surjective`: positive formulas
  are preserved by surjective homomorphisms.
* `FirstOrder.Language.BoundedFormula.IsPositive.realize_of_subsingleton`: in an algebraic
  language every positive formula holds in a one-element structure.
* `FirstOrder.Language.BoundedFormula.IsPositive.exists_isPrenex_iff`: every positive formula is
  equivalent to a positive formula in prenex form, that is, to a string of quantifiers in front
  of a positive quantifier-free formula.
* `FirstOrder.Language.BoundedFormula.IsPositive.induction_on_isQF` and
  `FirstOrder.Language.BoundedFormula.IsPrenex.induction_on_isPositive`: induction principles
  for positive quantifier-free formulas and for positive prenex formulas.

## References

Positive formulas and their prenex form are used as in Kharlampovich and Myasnikov,
*Implicit function theorem over free groups*, §2.3, §3.3 (Lemma 9) and §4.4. Preservation under
surjective homomorphisms is Lyndon's classical observation; see Hodges, *A shorter model theory*,
Theorem 2.4.3.
-/

public section

namespace FirstOrder.Language

open FirstOrder Fin

variable {L : Language} {α β : Type*} {n : ℕ}

namespace Theory.Iff

variable {T : L.Theory} {φ ψ φ' ψ' : L.BoundedFormula α n}

/-- Conjunctions of equivalent formulas are equivalent. -/
protected theorem inf (h : φ ⇔[T] ψ) (h' : φ' ⇔[T] ψ') : (φ ⊓ φ') ⇔[T] (ψ ⊓ ψ') :=
  fun M v xs => by
    simp [BoundedFormula.realize_iff, h.realize_bd_iff (M := M), h'.realize_bd_iff (M := M)]

/-- Disjunctions of equivalent formulas are equivalent. -/
protected theorem sup (h : φ ⇔[T] ψ) (h' : φ' ⇔[T] ψ') : (φ ⊔ φ') ⇔[T] (ψ ⊔ ψ') :=
  fun M v xs => by
    simp [BoundedFormula.realize_iff, h.realize_bd_iff (M := M), h'.realize_bd_iff (M := M)]

end Theory.Iff

namespace BoundedFormula

section Quantifiers

variable {T : L.Theory}

/-- A universal quantifier in the left conjunct can be moved in front of the conjunction. -/
theorem all_inf_iff (φ : L.BoundedFormula α (n + 1)) (ψ : L.BoundedFormula α n) :
    (φ.all ⊓ ψ) ⇔[T] (φ ⊓ ψ.liftAt 1 n).all :=
  fun M v xs => by simp [forall_and]

/-- An existential quantifier in the left conjunct can be moved in front of the conjunction. -/
theorem ex_inf_iff (φ : L.BoundedFormula α (n + 1)) (ψ : L.BoundedFormula α n) :
    (φ.ex ⊓ ψ) ⇔[T] (φ ⊓ ψ.liftAt 1 n).ex :=
  fun M v xs => by simp

/-- A universal quantifier in the right conjunct can be moved in front of the conjunction. -/
theorem inf_all_iff (φ : L.BoundedFormula α n) (ψ : L.BoundedFormula α (n + 1)) :
    (φ ⊓ ψ.all) ⇔[T] (φ.liftAt 1 n ⊓ ψ).all :=
  fun M v xs => by simp [forall_and]

/-- An existential quantifier in the right conjunct can be moved in front of the conjunction. -/
theorem inf_ex_iff (φ : L.BoundedFormula α n) (ψ : L.BoundedFormula α (n + 1)) :
    (φ ⊓ ψ.ex) ⇔[T] (φ.liftAt 1 n ⊓ ψ).ex :=
  fun M v xs => by simp

/-- A universal quantifier in the left disjunct can be moved in front of the disjunction. -/
theorem all_sup_iff (φ : L.BoundedFormula α (n + 1)) (ψ : L.BoundedFormula α n) :
    (φ.all ⊔ ψ) ⇔[T] (φ ⊔ ψ.liftAt 1 n).all :=
  fun M v xs => by simp [forall_or_right]

/-- An existential quantifier in the left disjunct can be moved in front of the disjunction. -/
theorem ex_sup_iff (φ : L.BoundedFormula α (n + 1)) (ψ : L.BoundedFormula α n) :
    (φ.ex ⊔ ψ) ⇔[T] (φ ⊔ ψ.liftAt 1 n).ex :=
  fun M v xs => by simp [exists_or]

/-- A universal quantifier in the right disjunct can be moved in front of the disjunction. -/
theorem sup_all_iff (φ : L.BoundedFormula α n) (ψ : L.BoundedFormula α (n + 1)) :
    (φ ⊔ ψ.all) ⇔[T] (φ.liftAt 1 n ⊔ ψ).all :=
  fun M v xs => by simp [forall_or_left]

/-- An existential quantifier in the right disjunct can be moved in front of the disjunction. -/
theorem sup_ex_iff (φ : L.BoundedFormula α n) (ψ : L.BoundedFormula α (n + 1)) :
    (φ ⊔ ψ.ex) ⇔[T] (φ.liftAt 1 n ⊔ ψ).ex :=
  fun M v xs => by simp [exists_or]

end Quantifiers

/-- A positive formula is one built from atomic formulas by conjunction, disjunction and
universal and existential quantification. Neither `⊥` nor `⊤` is positive in this convention. -/
inductive IsPositive : ∀ {n}, L.BoundedFormula α n → Prop
  | of_isAtomic {n : ℕ} {φ : L.BoundedFormula α n} (h : φ.IsAtomic) : IsPositive φ
  | inf {n : ℕ} {φ ψ : L.BoundedFormula α n} (hφ : IsPositive φ) (hψ : IsPositive ψ) :
    IsPositive (φ ⊓ ψ)
  | sup {n : ℕ} {φ ψ : L.BoundedFormula α n} (hφ : IsPositive φ) (hψ : IsPositive ψ) :
    IsPositive (φ ⊔ ψ)
  | all {n : ℕ} {φ : L.BoundedFormula α (n + 1)} (h : IsPositive φ) : IsPositive φ.all
  | ex {n : ℕ} {φ : L.BoundedFormula α (n + 1)} (h : IsPositive φ) : IsPositive φ.ex

/-- Atomic formulas are positive. -/
theorem IsAtomic.isPositive {φ : L.BoundedFormula α n} (h : φ.IsAtomic) : φ.IsPositive :=
  IsPositive.of_isAtomic h

/-- The formula `⊥` is not positive. -/
@[simp]
theorem not_isPositive_bot : ¬(⊥ : L.BoundedFormula α n).IsPositive := fun h => by
  cases h with
  | of_isAtomic h => cases h

/-- The formula `⊤` is not positive. -/
@[simp]
theorem not_isPositive_top : ¬(⊤ : L.BoundedFormula α n).IsPositive := fun h => by
  cases h with
  | of_isAtomic h => cases h

/-- The negation of an atomic formula is not positive. -/
theorem IsAtomic.not_isPositive_not {φ : L.BoundedFormula α n} (h : φ.IsAtomic) :
    ¬φ.not.IsPositive := fun h' => by
  cases h' with
  | of_isAtomic h' => cases h'
  | inf => cases h
  | sup _ hψ => exact not_isPositive_bot hψ
  | ex => cases h

/-- A conjunction is positive exactly when both conjuncts are. -/
@[simp]
theorem isPositive_inf_iff {φ ψ : L.BoundedFormula α n} :
    (φ ⊓ ψ).IsPositive ↔ φ.IsPositive ∧ ψ.IsPositive := by
  refine ⟨fun h => ?_, fun h => h.1.inf h.2⟩
  cases h with
  | of_isAtomic h => cases h
  | inf hφ hψ => exact ⟨hφ, hψ⟩

/-- A disjunction is positive exactly when both disjuncts are. -/
@[simp]
theorem isPositive_sup_iff {φ ψ : L.BoundedFormula α n} :
    (φ ⊔ ψ).IsPositive ↔ φ.IsPositive ∧ ψ.IsPositive := by
  refine ⟨fun h => ?_, fun h => h.1.sup h.2⟩
  cases h with
  | of_isAtomic h => cases h
  | sup hφ hψ => exact ⟨hφ, hψ⟩

/-- A universally quantified formula is positive exactly when its body is. -/
@[simp]
theorem isPositive_all_iff {φ : L.BoundedFormula α (n + 1)} :
    φ.all.IsPositive ↔ φ.IsPositive := by
  refine ⟨fun h => ?_, IsPositive.all⟩
  cases h with
  | of_isAtomic h => cases h
  | all h => exact h

/-- An existentially quantified formula is positive exactly when its body is. -/
@[simp]
theorem isPositive_ex_iff {φ : L.BoundedFormula α (n + 1)} :
    φ.ex.IsPositive ↔ φ.IsPositive := by
  refine ⟨fun h => ?_, IsPositive.ex⟩
  cases h with
  | of_isAtomic h => cases h
  | ex h => exact h

namespace IsPositive

variable {φ : L.BoundedFormula α n}

/-- Relabelling the free variables of a positive formula gives a positive formula. -/
protected theorem relabel {m : ℕ} {φ : L.BoundedFormula α m} (h : φ.IsPositive)
    (f : α → β ⊕ (Fin n)) : (φ.relabel f).IsPositive := by
  induction h with
  | of_isAtomic h => exact (h.relabel f).isPositive
  | inf _ _ ih₁ ih₂ => exact ih₁.inf ih₂
  | sup _ _ ih₁ ih₂ => exact ih₁.sup ih₂
  | all _ ih => simpa using ih.all
  | ex _ ih => simpa using ih.ex

/-- Raising the bound on the bound variables of a positive formula gives a positive formula. -/
protected theorem castLE {m : ℕ} (hφ : φ.IsPositive) (h : n ≤ m) : (φ.castLE h).IsPositive := by
  induction hφ generalizing m with
  | of_isAtomic hφ => exact hφ.castLE.isPositive
  | inf _ _ ih₁ ih₂ => exact (ih₁ h).inf (ih₂ h)
  | sup _ _ ih₁ ih₂ => exact (ih₁ h).sup (ih₂ h)
  | all _ ih => exact (ih _).all
  | ex _ ih => exact (ih _).ex

/-- Shifting the bound variables of a positive formula gives a positive formula. -/
protected theorem liftAt {k m : ℕ} (h : φ.IsPositive) : (φ.liftAt k m).IsPositive := by
  induction h with
  | of_isAtomic h => exact h.liftAt.isPositive
  | inf _ _ ih₁ ih₂ => exact ih₁.inf ih₂
  | sup _ _ ih₁ ih₂ => exact ih₁.sup ih₂
  | all _ ih => exact (ih.castLE _).all
  | ex _ ih => exact (ih.castLE _).ex

/-- Induction for positive quantifier-free formulas: they are generated from atomic formulas by
conjunction and disjunction. -/
theorem induction_on_isQF {P : L.BoundedFormula α n → Prop} (hφ : φ.IsPositive)
    (hqf : φ.IsQF) (atomic : ∀ {ψ : L.BoundedFormula α n}, ψ.IsAtomic → P ψ)
    (inf : ∀ {ψ₁ ψ₂ : L.BoundedFormula α n}, P ψ₁ → P ψ₂ → P (ψ₁ ⊓ ψ₂))
    (sup : ∀ {ψ₁ ψ₂ : L.BoundedFormula α n}, P ψ₁ → P ψ₂ → P (ψ₁ ⊔ ψ₂)) : P φ := by
  induction hφ with
  | of_isAtomic h => exact atomic h
  | inf _ _ ih₁ ih₂ =>
    exact inf (ih₁ (isQF_inf_iff.1 hqf).1 atomic inf sup)
      (ih₂ (isQF_inf_iff.1 hqf).2 atomic inf sup)
  | sup _ _ ih₁ ih₂ =>
    exact sup (ih₁ (isQF_sup_iff.1 hqf).1 atomic inf sup)
      (ih₂ (isQF_sup_iff.1 hqf).2 atomic inf sup)
  | all => exact (not_all_isQF _ hqf).elim
  | ex => exact (not_ex_isQF _ hqf).elim

end IsPositive

/-- Induction for positive formulas in prenex form: they are obtained from positive
quantifier-free formulas by universal and existential quantification. -/
theorem IsPrenex.induction_on_isPositive {P : ∀ {m}, L.BoundedFormula α m → Prop}
    {φ : L.BoundedFormula α n} (hp : φ.IsPrenex) (hφ : φ.IsPositive)
    (qf : ∀ {m} {ψ : L.BoundedFormula α m}, ψ.IsQF → ψ.IsPositive → P ψ)
    (all : ∀ {m} {ψ : L.BoundedFormula α (m + 1)}, P ψ → P ψ.all)
    (ex : ∀ {m} {ψ : L.BoundedFormula α (m + 1)}, P ψ → P ψ.ex) : P φ := by
  induction hp with
  | of_isQF h => exact qf h hφ
  | all _ ih => exact all (ih (isPositive_all_iff.1 hφ))
  | ex _ ih => exact ex (ih (isPositive_ex_iff.1 hφ))

section Preservation

variable {M N F : Type*} [L.Structure M] [L.Structure N] [FunLike F M N] [L.HomClass F M N]
  {φ : L.BoundedFormula α n}

/-- Atomic formulas are preserved by homomorphisms. -/
theorem IsAtomic.realize_comp_hom (hφ : φ.IsAtomic) (f : F) {v : α → M} {xs : Fin n → M}
    (h : φ.Realize v xs) : φ.Realize (f ∘ v) (f ∘ xs) := by
  cases hφ with
  | equal t₁ t₂ =>
    simp only [realize_bdEqual, ← Sum.comp_elim, HomClass.realize_term] at h ⊢
    exact congrArg f h
  | rel R ts =>
    simp only [realize_rel, ← Sum.comp_elim, HomClass.realize_term] at h ⊢
    exact HomClass.map_rel f R _ h

/-- Positive formulas are preserved by surjective homomorphisms: if a positive formula holds of
a tuple in `M`, it holds of the image tuple in `N`. -/
theorem IsPositive.realize_comp_of_surjective (hφ : φ.IsPositive) {f : F}
    (hf : Function.Surjective f) {v : α → M} {xs : Fin n → M} (h : φ.Realize v xs) :
    φ.Realize (f ∘ v) (f ∘ xs) := by
  induction hφ with
  | of_isAtomic hφ => exact hφ.realize_comp_hom f h
  | inf _ _ ih₁ ih₂ =>
    rw [realize_inf] at h ⊢
    exact ⟨ih₁ h.1, ih₂ h.2⟩
  | sup _ _ ih₁ ih₂ =>
    rw [realize_sup] at h ⊢
    exact h.imp ih₁ ih₂
  | all _ ih =>
    rw [realize_all] at h ⊢
    intro b
    obtain ⟨a, rfl⟩ := hf b
    rw [← Fin.comp_snoc]
    exact ih (h a)
  | ex _ ih =>
    rw [realize_ex] at h ⊢
    obtain ⟨a, ha⟩ := h
    refine ⟨f a, ?_⟩
    rw [← Fin.comp_snoc]
    exact ih ha

/-- A positive sentence true in a structure is true in each of its homomorphic images. -/
theorem IsPositive.realize_sentence_of_surjective {φ : L.Sentence} (hφ : φ.IsPositive) {f : F}
    (hf : Function.Surjective f) (h : M ⊨ φ) : N ⊨ φ := by
  have h' := hφ.realize_comp_of_surjective hf h
  rwa [Subsingleton.elim (f ∘ default) default, Subsingleton.elim (f ∘ default) default] at h'

/-- In an algebraic language, every positive formula holds in a one-element structure. -/
theorem IsPositive.realize_of_subsingleton [L.IsAlgebraic] [Subsingleton M] [Nonempty M]
    (hφ : φ.IsPositive) (v : α → M) (xs : Fin n → M) : φ.Realize v xs := by
  induction hφ with
  | of_isAtomic hφ => exact realize_of_isAtomic_subsingleton hφ v xs
  | inf _ _ ih₁ ih₂ => exact realize_inf.2 ⟨ih₁ xs, ih₂ xs⟩
  | sup _ _ ih₁ _ => exact realize_sup.2 (.inl (ih₁ xs))
  | all _ ih => exact realize_all.2 fun a => ih _
  | ex _ ih => exact realize_ex.2 ⟨Classical.arbitrary M, ih _⟩

end Preservation

section Prenex

/-- Combining a positive quantifier-free formula with a positive prenex formula by a binary
connective that commutes with quantifiers on the right yields a positive prenex formula. -/
private theorem exists_isPrenex_iff_of_isQF
    {op : ∀ {k}, L.BoundedFormula α k → L.BoundedFormula α k → L.BoundedFormula α k}
    (hqf : ∀ {k} {φ ψ : L.BoundedFormula α k}, φ.IsQF → ψ.IsQF → (op φ ψ).IsQF)
    (hpos : ∀ {k} {φ ψ : L.BoundedFormula α k},
      φ.IsPositive → ψ.IsPositive → (op φ ψ).IsPositive)
    (hall : ∀ {k} (φ : L.BoundedFormula α k) (ψ : L.BoundedFormula α (k + 1)),
      op φ ψ.all ⇔[∅] (op (φ.liftAt 1 k) ψ).all)
    (hex : ∀ {k} (φ : L.BoundedFormula α k) (ψ : L.BoundedFormula α (k + 1)),
      op φ ψ.ex ⇔[∅] (op (φ.liftAt 1 k) ψ).ex)
    {φ ψ : L.BoundedFormula α n} (hφq : φ.IsQF) (hφ : φ.IsPositive) (hψp : ψ.IsPrenex)
    (hψ : ψ.IsPositive) :
    ∃ θ : L.BoundedFormula α n, θ.IsPrenex ∧ θ.IsPositive ∧ (op φ ψ ⇔[∅] θ) := by
  induction hψp with
  | of_isQF h => exact ⟨_, (hqf hφq h).isPrenex, hpos hφ hψ, .refl _⟩
  | all _ ih =>
    obtain ⟨θ, h₁, h₂, h₃⟩ := ih hφq.liftAt hφ.liftAt (isPositive_all_iff.1 hψ)
    exact ⟨θ.all, h₁.all, h₂.all, (hall _ _).trans h₃.all⟩
  | ex _ ih =>
    obtain ⟨θ, h₁, h₂, h₃⟩ := ih hφq.liftAt hφ.liftAt (isPositive_ex_iff.1 hψ)
    exact ⟨θ.ex, h₁.ex, h₂.ex, (hex _ _).trans h₃.ex⟩

/-- Combining two positive prenex formulas by a binary connective that commutes with quantifiers
on either side yields a positive prenex formula. -/
private theorem exists_isPrenex_iff_of_isPrenex
    {op : ∀ {k}, L.BoundedFormula α k → L.BoundedFormula α k → L.BoundedFormula α k}
    (hqf : ∀ {k} {φ ψ : L.BoundedFormula α k}, φ.IsQF → ψ.IsQF → (op φ ψ).IsQF)
    (hpos : ∀ {k} {φ ψ : L.BoundedFormula α k},
      φ.IsPositive → ψ.IsPositive → (op φ ψ).IsPositive)
    (hall : ∀ {k} (φ : L.BoundedFormula α k) (ψ : L.BoundedFormula α (k + 1)),
      op φ ψ.all ⇔[∅] (op (φ.liftAt 1 k) ψ).all)
    (hex : ∀ {k} (φ : L.BoundedFormula α k) (ψ : L.BoundedFormula α (k + 1)),
      op φ ψ.ex ⇔[∅] (op (φ.liftAt 1 k) ψ).ex)
    (hall' : ∀ {k} (φ : L.BoundedFormula α (k + 1)) (ψ : L.BoundedFormula α k),
      op φ.all ψ ⇔[∅] (op φ (ψ.liftAt 1 k)).all)
    (hex' : ∀ {k} (φ : L.BoundedFormula α (k + 1)) (ψ : L.BoundedFormula α k),
      op φ.ex ψ ⇔[∅] (op φ (ψ.liftAt 1 k)).ex)
    {φ ψ : L.BoundedFormula α n} (hφp : φ.IsPrenex) (hφ : φ.IsPositive) (hψp : ψ.IsPrenex)
    (hψ : ψ.IsPositive) :
    ∃ θ : L.BoundedFormula α n, θ.IsPrenex ∧ θ.IsPositive ∧ (op φ ψ ⇔[∅] θ) := by
  induction hφp with
  | of_isQF h => exact exists_isPrenex_iff_of_isQF hqf hpos hall hex h hφ hψp hψ
  | all _ ih =>
    obtain ⟨θ, h₁, h₂, h₃⟩ := ih (isPositive_all_iff.1 hφ) hψp.liftAt hψ.liftAt
    exact ⟨θ.all, h₁.all, h₂.all, (hall' _ _).trans h₃.all⟩
  | ex _ ih =>
    obtain ⟨θ, h₁, h₂, h₃⟩ := ih (isPositive_ex_iff.1 hφ) hψp.liftAt hψ.liftAt
    exact ⟨θ.ex, h₁.ex, h₂.ex, (hex' _ _).trans h₃.ex⟩

/-- Every positive formula is equivalent to a positive formula in prenex form: a string of
quantifiers in front of a positive quantifier-free formula. -/
theorem IsPositive.exists_isPrenex_iff {φ : L.BoundedFormula α n} (hφ : φ.IsPositive) :
    ∃ ψ : L.BoundedFormula α n, ψ.IsPrenex ∧ ψ.IsPositive ∧ (φ ⇔[∅] ψ) := by
  induction hφ with
  | of_isAtomic h => exact ⟨_, h.isPrenex, h.isPositive, .refl _⟩
  | inf _ _ ih₁ ih₂ =>
    obtain ⟨ψ₁, p₁, q₁, e₁⟩ := ih₁
    obtain ⟨ψ₂, p₂, q₂, e₂⟩ := ih₂
    obtain ⟨θ, hp, hq, e⟩ := exists_isPrenex_iff_of_isPrenex (op := (· ⊓ ·)) IsQF.inf
      IsPositive.inf inf_all_iff inf_ex_iff all_inf_iff ex_inf_iff p₁ q₁ p₂ q₂
    exact ⟨θ, hp, hq, (e₁.inf e₂).trans e⟩
  | sup _ _ ih₁ ih₂ =>
    obtain ⟨ψ₁, p₁, q₁, e₁⟩ := ih₁
    obtain ⟨ψ₂, p₂, q₂, e₂⟩ := ih₂
    obtain ⟨θ, hp, hq, e⟩ := exists_isPrenex_iff_of_isPrenex (op := (· ⊔ ·)) IsQF.sup
      IsPositive.sup sup_all_iff sup_ex_iff all_sup_iff ex_sup_iff p₁ q₁ p₂ q₂
    exact ⟨θ, hp, hq, (e₁.sup e₂).trans e⟩
  | all _ ih =>
    obtain ⟨ψ, p, q, e⟩ := ih
    exact ⟨ψ.all, p.all, q.all, e.all⟩
  | ex _ ih =>
    obtain ⟨ψ, p, q, e⟩ := ih
    exact ⟨ψ.ex, p.ex, q.ex, e.ex⟩

end Prenex

end BoundedFormula

end FirstOrder.Language
