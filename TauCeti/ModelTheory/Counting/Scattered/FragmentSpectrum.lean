module

public import TauCeti.ModelTheory.Counting.Scattered.Spectrum
public import TauCeti.ModelTheory.RelationalConfiguration.FragmentSpectrum
import TauCeti.SetTheory.Descriptive.Silver

/-!
# Thinness and fragment type spectra

An `L_{ω₁ω}` sentence `φ` is classically called *scattered* when for every countable
fragment `A` containing `φ` its countable models realize only countably many `A`-types. This module
proves that, on a countable carrier in a countable relational vocabulary, a Borel set `C` of
configurations is thin for isomorphism (carries no perfect set of pairwise non-isomorphic members)
if and only if every countable fragment has a countable type spectrum on `C` at every arity
(`TauCeti.RelationalConfiguration.fragmentSpectrum`). For the models of a sentence on `ℕ` this
identifies thin sentences with Morley's scattered sentences.

In one direction, Silver's dichotomy for the Borel spectrum equivalence on `C`, which isomorphism
refines, gives countably many spectrum classes, each contributing the countably many types realized
in one countable structure. In the other, the arity-`0` spectrum of the fragment generated by a
countable list of sentences determines the truth sequences of the list, and countably many truth
sequences for every list is thinness.

## Main results

* `TauCeti.countable_quotient_fragmentSpectrumSetoid_of_isThinOn`: on a thin Borel set, spectrum
  equivalence relative to a countable fragment has countably many classes.
* `TauCeti.countable_fragmentSpectrum_of_isThinOn`: on a thin Borel set every countable fragment
  has a countable type spectrum at every arity.
* `TauCeti.isThinOn_of_forall_countable_fragmentSpectrum_zero`: countable arity-`0` spectra for all
  countable fragments give thinness, with no measurability or invariance of the set.
* `TauCeti.isThinOn_iff_forall_countable_fragmentSpectrum`: the fragment-spectrum characterization
  of thinness for Borel sets.
* `TauCeti.isThinOnNatModels_iff_forall_countable_fragmentSpectrum` and
  `TauCeti.isThinOnNatModels_iff_forall_mem_countable_fragmentSpectrum`: a sentence is thin on
  `ℕ` exactly when its models on `ℕ` realize countably many types of every countable fragment, or
  of every countable fragment containing it.

## References

* M. Morley, *The number of countable models*, Journal of Symbolic Logic **35** (1970), 14–18.
* J. Baldwin, S. Friedman, M. Koerwien and M. C. Laskowski, *Three red herrings around Vaught's
  conjecture*, Transactions of the American Mathematical Society **368** (2016), 3673–3694,
  Theorem 3.3 and Lemma 3.4.
* D. Marker, *Lectures on Infinitary Model Theory*, Lecture Notes in Logic 46, Cambridge University
  Press, 2016, Chapter 4.
-/

public section

universe u v w uκ

open FirstOrder FirstOrder.Language Set

namespace TauCeti

open RelationalConfiguration

variable {L : Language.{u, v}} [L.IsRelational] [∀ n, Countable (L.Relations n)]
variable {V : Type w} [Countable V] {A : Fragment L}

/-- On a thin Borel set `C` of configurations, spectrum equivalence relative to a countable
fragment has only countably many classes on `C`. -/
theorem countable_quotient_fragmentSpectrumSetoid_of_isThinOn
    {C : Set (RelationalConfiguration L V)} (hC : MeasurableSet C)
    (hthin : (isoSetoid L V).IsThinOn C)
    (hA : (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable) (n : ℕ) :
    Countable (Quotient ((fragmentSpectrumSetoid A n).comap (Subtype.val : C → _))) :=
  (Setoid.countable_or_hasCantorAntichainOn_of_measurableSet hC (isoSetoid L V) _
    (fun _ _ h => isoSetoid_le_fragmentSpectrumSetoid A n h)
    ((measurableSet_setOf_fragmentSpectrumSetoid hA n).preimage
      (measurable_subtype_coe.prodMap measurable_subtype_coe))).resolve_right
    (Setoid.isThinOn_iff_not_hasCantorAntichainOn.1 hthin)

/-- On a thin Borel set `C` of configurations, every countable fragment has a countable type
spectrum at every arity: the members of `C` realize only countably many of its types. -/
theorem countable_fragmentSpectrum_of_isThinOn {C : Set (RelationalConfiguration L V)}
    (hC : MeasurableSet C) (hthin : (isoSetoid L V).IsThinOn C)
    (hA : (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable) (n : ℕ) :
    (fragmentSpectrum A n C).Countable := by
  let F : Setoid C := (fragmentSpectrumSetoid A n).comap Subtype.val
  have := countable_quotient_fragmentSpectrumSetoid_of_isThinOn hC hthin hA n
  -- Every member of `C` realizes the same types as the chosen representative of its class.
  refine (countable_iUnion fun q : Quotient F =>
    @countable_realizedFragmentTypes L V q.out.1.toStructure _ A n).mono ?_
  intro p hp
  obtain ⟨c, hc, a, rfl⟩ := mem_fragmentSpectrum.1 hp
  have hout : F (Quotient.mk F ⟨c, hc⟩).out ⟨c, hc⟩ := Quotient.mk_out (s := F) ⟨c, hc⟩
  refine mem_iUnion.2 ⟨Quotient.mk F ⟨c, hc⟩, ?_⟩
  rw [fragmentSpectrumSetoid_apply.1 hout, ← fragmentSpectrum_singleton]
  exact mem_fragmentSpectrum.2 ⟨c, rfl, a, rfl⟩

/-- If every countable fragment has a countable arity-`0` type spectrum on `C`, then `C` is thin
for isomorphism. No measurability or invariance of `C` is required. -/
theorem isThinOn_of_forall_countable_fragmentSpectrum_zero
    {C : Set (RelationalConfiguration L V)}
    (h : ∀ A : Fragment L, (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable →
      (fragmentSpectrum A 0 C).Countable) :
    (isoSetoid L V).IsThinOn C := by
  refine isThinOn_of_forall_countable_image_sentenceTheory fun θ => ?_
  classical
  -- The arity-`0` type relative to the fragment of `range θ` records the truth of each `θ i`.
  let A := Fragment.ofTheory (range θ)
  let g : Set (L.BoundedFormulaω Empty 0) → ℕ → Bool := fun p i => decide (θ i ∈ p)
  refine ((h A (Fragment.ofTheory_countable (countable_range θ))).image g).mono ?_
  rintro _ ⟨c, hc, rfl⟩
  refine ⟨@fragmentType L A V c.toStructure 0 Fin.elim0, mem_fragmentSpectrum.2
    ⟨c, hc, Fin.elim0, rfl⟩, funext fun i => ?_⟩
  have hiff : θ i ∈ @fragmentType L A V c.toStructure 0 Fin.elim0 ↔ c ∈ modelsOf (θ i) := by
    rw [@mem_fragmentType L V c.toStructure A 0 Fin.elim0 (θ i),
      and_iff_right (Fragment.mem_ofTheory (mem_range_self i)), mem_modelsOf,
      Subsingleton.elim Fin.elim0 default]
    simp only [SentenceInf.realize_def, FormulaInf.realize_def]
  simp only [g, sentenceTheory_apply, hiff]

/-- **Fragment-spectrum characterization of thinness.** On a countable carrier in a countable
relational vocabulary, a Borel set `C` of configurations is thin for isomorphism if and only if
every countable fragment has a countable type spectrum on `C` at every arity. No isomorphism
invariance of `C` is assumed. -/
theorem isThinOn_iff_forall_countable_fragmentSpectrum {C : Set (RelationalConfiguration L V)}
    (hC : MeasurableSet C) :
    (isoSetoid L V).IsThinOn C ↔
      ∀ A : Fragment L, (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable →
        ∀ n, (fragmentSpectrum A n C).Countable :=
  ⟨fun hthin _ hA n => countable_fragmentSpectrum_of_isThinOn hC hthin hA n,
    fun h => isThinOn_of_forall_countable_fragmentSpectrum_zero fun A hA => h A hA 0⟩

/-- **Thin sentences realize countably many fragment types.** An infinitary sentence `φ` with
countable branching is thin on `ℕ` if and only if, for every countable fragment `A` and arity `n`,
its models on `ℕ` realize only countably many `A`-types of arity `n`. -/
theorem isThinOnNatModels_iff_forall_countable_fragmentSpectrum {κ : Type uκ} [Countable κ]
    {φ : L.SentenceInf κ} :
    IsThinOnNatModels φ ↔
      ∀ A : Fragment L, (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable →
        ∀ n, (fragmentSpectrum A n (modelsOf (V := ℕ) φ)).Countable := by
  rw [isThinOnNatModels_iff_isThinOn,
    isThinOn_iff_forall_countable_fragmentSpectrum (measurableSet_modelsOf φ)]

/-- **Thin sentences are the scattered ones.** An `L_{ω₁ω}` sentence `φ` is thin on `ℕ` if and only
if, for every countable fragment `A` containing `φ` and every arity `n`, its models on `ℕ` realize
only countably many `A`-types of arity `n`: Morley's definition of a scattered sentence, for
models on `ℕ`. -/
theorem isThinOnNatModels_iff_forall_mem_countable_fragmentSpectrum {φ : L.Sentenceω} :
    IsThinOnNatModels φ ↔
      ∀ A : Fragment L, (A : Set (Σ n, L.BoundedFormulaω Empty n)).Countable →
        (⟨0, φ⟩ : Σ n, L.BoundedFormulaω Empty n) ∈ A →
          ∀ n, (fragmentSpectrum A n (modelsOf (V := ℕ) φ)).Countable := by
  refine isThinOnNatModels_iff_forall_countable_fragmentSpectrum.trans
    ⟨fun h A hA _ n => h A hA n, fun h A hA n => ?_⟩
  -- Enlarge `A` by the fragment of `φ`; the spectrum of `A` is the restriction of the larger one.
  have hB : ((A ⊔ Fragment.ofSentence φ : Fragment L) :
      Set (Σ n, L.BoundedFormulaω Empty n)).Countable := by
    rw [Fragment.coe_sup]
    exact hA.union (Fragment.ofSentence_countable φ)
  rw [fragmentSpectrum_eq_image_of_le le_sup_left]
  exact (h _ hB (Fragment.mem_sup.2 (.inr (Fragment.mem_ofSentence φ))) n).image _

end TauCeti
