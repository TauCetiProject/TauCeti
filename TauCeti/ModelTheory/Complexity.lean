module

public import Mathlib.ModelTheory.Complexity

/-!
# Complexity and realization of first-order formulas

Mathlib's `FirstOrder.Language.BoundedFormula.iSup` and `FirstOrder.Language.BoundedFormula.iInf`
form the disjunction and conjunction of a finite family of formulas. This file shows that both are
quantifier-free when every member of the family is, as are the disjunction and conjunction of a
list of quantifier-free formulas. Conversely, an implication, a negation, a conjunction, a
disjunction or a biconditional is quantifier-free only when its constituents are.

In an algebraic language, every atomic formula holds in a subsingleton structure: atomic
formulas can only assert equality of terms. Every homomorphism preserves atomic formulas
(`FirstOrder.Language.BoundedFormula.IsAtomic.realize_comp_hom`); Mathlib's
`FirstOrder.Language.BoundedFormula.IsAtomic.realize_comp_of_injective` asks in addition for
injectivity, which only the converse implication needs.

Translating a formula along a language homomorphism (`FirstOrder.Language.LHom.onBoundedFormula`)
keeps it atomic, quantifier-free or universal, and quantifying all bound variables of a universal
formula (`FirstOrder.Language.BoundedFormula.alls`) gives a universal formula. These let universal
sentences of a language be read in an extension by constants. Substituting terms for the free
variables (`FirstOrder.Language.BoundedFormula.subst`) keeps a formula atomic or quantifier-free.

Along an embedding, universal sentences pass from the target to the source and existential
sentences from the source to the target. Universal sentences are moreover local: one holds in a
structure as soon as it holds in the substructure generated by each finite subset, or more
generally in a family of substructures, given by embeddings, that covers every finite subset by
a single member.
-/

public section

namespace FirstOrder.Language.BoundedFormula.IsQF

variable {L : Language} {α β : Type*} {n : ℕ}

/-- The disjunction of a list of quantifier-free formulas is quantifier-free. -/
theorem foldr_sup {l : List (L.BoundedFormula α n)} (hl : ∀ φ ∈ l, φ.IsQF) :
    (l.foldr (· ⊔ ·) ⊥).IsQF := by
  induction l with
  | nil => exact isQF_bot
  | cons φ l ih =>
    rw [List.forall_mem_cons] at hl
    exact hl.1.sup (ih hl.2)

/-- The conjunction of a list of quantifier-free formulas is quantifier-free. -/
theorem foldr_inf {l : List (L.BoundedFormula α n)} (hl : ∀ φ ∈ l, φ.IsQF) :
    (l.foldr (· ⊓ ·) ⊤).IsQF := by
  induction l with
  | nil => exact top
  | cons φ l ih =>
    rw [List.forall_mem_cons] at hl
    exact hl.1.inf (ih hl.2)

/-- A finite disjunction of quantifier-free formulas is quantifier-free. -/
theorem iSup [Finite β] {f : β → L.BoundedFormula α n} (hf : ∀ b, (f b).IsQF) :
    (BoundedFormula.iSup f).IsQF :=
  foldr_sup <| by simp [hf]

/-- A finite conjunction of quantifier-free formulas is quantifier-free. -/
theorem iInf [Finite β] {f : β → L.BoundedFormula α n} (hf : ∀ b, (f b).IsQF) :
    (BoundedFormula.iInf f).IsQF :=
  foldr_inf <| by simp [hf]

end FirstOrder.Language.BoundedFormula.IsQF

namespace FirstOrder.Language.BoundedFormula

variable {L : Language} {α : Type*} {n : ℕ} {φ ψ : L.BoundedFormula α n}

/-- An implication is quantifier-free exactly when its two sides are. -/
@[simp]
theorem isQF_imp_iff : (φ.imp ψ).IsQF ↔ φ.IsQF ∧ ψ.IsQF := by
  refine ⟨fun h => ?_, fun h => h.1.imp h.2⟩
  cases h with
  | of_isAtomic h => cases h
  | imp h₁ h₂ => exact ⟨h₁, h₂⟩

/-- A conjunction is quantifier-free exactly when its two conjuncts are. -/
@[simp]
theorem isQF_inf_iff : (φ ⊓ ψ).IsQF ↔ φ.IsQF ∧ ψ.IsQF :=
  ⟨fun h => by
    obtain ⟨h, -⟩ := isQF_imp_iff.1 h
    obtain ⟨hφ, h⟩ := isQF_imp_iff.1 h
    exact ⟨hφ, (isQF_imp_iff.1 h).1⟩, fun h => h.1.inf h.2⟩

/-- A disjunction is quantifier-free exactly when its two disjuncts are. -/
@[simp]
theorem isQF_sup_iff : (φ ⊔ ψ).IsQF ↔ φ.IsQF ∧ ψ.IsQF :=
  ⟨fun h => by
    obtain ⟨h, hψ⟩ := isQF_imp_iff.1 h
    exact ⟨(isQF_imp_iff.1 h).1, hψ⟩, fun h => h.1.sup h.2⟩

/-- A negation is quantifier-free exactly when the negated formula is. -/
@[simp]
theorem isQF_not_iff : φ.not.IsQF ↔ φ.IsQF :=
  isQF_imp_iff.trans (and_iff_left isQF_bot)

/-- A biconditional is quantifier-free exactly when its two sides are. -/
@[simp]
theorem isQF_iff_iff : (φ.iff ψ).IsQF ↔ φ.IsQF ∧ ψ.IsQF :=
  isQF_inf_iff.trans <| by simp only [isQF_imp_iff, and_comm (a := ψ.IsQF), and_self]

end FirstOrder.Language.BoundedFormula

namespace FirstOrder.Language.BoundedFormula

open FirstOrder

/-- Every atomic formula over an algebraic language holds in a subsingleton structure. -/
theorem realize_of_isAtomic_subsingleton {L : Language} [L.IsAlgebraic]
    {G α : Type*} [Subsingleton G] [L.Structure G]
    {n : ℕ} {φ : L.BoundedFormula α n} (hφ : φ.IsAtomic)
    (v : α → G) (xs : Fin n → G) : φ.Realize v xs := by
  cases hφ with
  | equal _ _ => exact Subsingleton.elim _ _
  | rel r _ => exact isEmptyElim r

/-- Atomic formulas are preserved by homomorphisms. -/
theorem IsAtomic.realize_comp_hom {L : Language} {α M N F : Type*} [L.Structure M]
    [L.Structure N] [FunLike F M N] [L.HomClass F M N] {n : ℕ} {φ : L.BoundedFormula α n}
    (hφ : φ.IsAtomic) (f : F) {v : α → M} {xs : Fin n → M} (h : φ.Realize v xs) :
    φ.Realize (f ∘ v) (f ∘ xs) := by
  cases hφ with
  | equal t₁ t₂ =>
    simp only [realize_bdEqual, ← Sum.comp_elim, HomClass.realize_term] at h ⊢
    exact congrArg f h
  | rel R ts =>
    simp only [realize_rel, ← Sum.comp_elim, HomClass.realize_term] at h ⊢
    exact HomClass.map_rel f R _ h

variable {L L' : Language} {α : Type*} {n : ℕ} {φ : L.BoundedFormula α n}

/-- Translating an atomic formula along a language homomorphism gives an atomic formula. -/
theorem IsAtomic.onBoundedFormula (h : φ.IsAtomic) (ϕ : L →ᴸ L') :
    (ϕ.onBoundedFormula φ).IsAtomic := by
  cases h with
  | equal t₁ t₂ => exact IsAtomic.equal _ _
  | rel R ts => exact IsAtomic.rel _ _

/-- Translating a quantifier-free formula along a language homomorphism gives a quantifier-free
formula. -/
theorem IsQF.onBoundedFormula (h : φ.IsQF) (ϕ : L →ᴸ L') :
    (ϕ.onBoundedFormula φ).IsQF := by
  induction h with
  | falsum => exact IsQF.falsum
  | of_isAtomic h => exact (h.onBoundedFormula ϕ).isQF
  | imp _ _ ih₁ ih₂ => exact ih₁.imp ih₂

/-- Substituting terms for the free variables of an atomic formula gives an atomic formula. -/
theorem IsAtomic.subst {β : Type*} (h : φ.IsAtomic) (tf : α → L.Term β) :
    (φ.subst tf).IsAtomic :=
  IsAtomic.recOn h (fun _ _ => IsAtomic.equal _ _) fun _ _ => IsAtomic.rel _ _

/-- Substituting terms for the free variables of a quantifier-free formula gives a
quantifier-free formula. -/
theorem IsQF.subst {β : Type*} (h : φ.IsQF) (tf : α → L.Term β) : (φ.subst tf).IsQF := by
  induction h with
  | falsum => exact IsQF.falsum
  | of_isAtomic h => exact (h.subst tf).isQF
  | imp _ _ ih₁ ih₂ => exact ih₁.imp ih₂

/-- Translating a universal formula along a language homomorphism gives a universal formula. -/
theorem IsUniversal.onBoundedFormula (h : φ.IsUniversal) (ϕ : L →ᴸ L') :
    (ϕ.onBoundedFormula φ).IsUniversal := by
  induction h with
  | of_isQF h => exact (h.onBoundedFormula ϕ).isUniversal
  | all _ ih => exact ih.all

/-- Universally quantifying all bound variables of a universal formula gives a universal
formula. -/
theorem IsUniversal.alls (h : φ.IsUniversal) : φ.alls.IsUniversal := by
  induction n with
  | zero => exact h
  | succ n ih => exact ih h.all

section Sentence

variable {M N F : Type*} [L.Structure M] [L.Structure N] {σ : L.Sentence}

section Embedding

variable [FunLike F M N] [EmbeddingLike F M N] [L.StrongHomClass F M N]

/-- Universal sentences pass to substructures: a universal sentence that holds in `N` holds in
every structure that embeds into `N`. -/
theorem IsUniversal.realize_sentence_of_embedding (hσ : σ.IsUniversal) (f : F) (h : N ⊨ σ) :
    M ⊨ σ :=
  -- A sentence has no free or bound variables, so every assignment is the default one.
  hσ.realize_embedding f <| by
    rwa [Subsingleton.elim (f ∘ default) default, Subsingleton.elim (f ∘ default) default]

/-- Existential sentences pass to superstructures: an existential sentence that holds in `M`
holds in every structure into which `M` embeds. -/
theorem IsExistential.realize_sentence_of_embedding (hσ : σ.IsExistential) (f : F) (h : M ⊨ σ) :
    N ⊨ σ := by
  have := hσ.realize_embedding f h
  -- A sentence has no free or bound variables, so every assignment is the default one.
  rwa [Subsingleton.elim (f ∘ default) default, Subsingleton.elim (f ∘ default) default] at this

end Embedding

/-- Universal sentences are local: a universal sentence holds in `M` when it holds in each member
of a family of structures embedding into `M` such that every finite subset of `M` lies in the
image of a single member. -/
theorem IsUniversal.realize_sentence_of_forall_embedding {ι : Sort*} {N : ι → Type*}
    [∀ i, L.Structure (N i)] (f : ∀ i, N i ↪[L] M)
    (hf : ∀ s : Finset M, ∃ i, (s : Set M) ⊆ Set.range (f i)) (hσ : σ.IsUniversal)
    (h : ∀ i, N i ⊨ σ) : M ⊨ σ := by
  classical
  -- Induct on the universal formula, quantifying over all values of the bound variables.
  suffices ∀ {n} {φ : L.BoundedFormula Empty n}, φ.IsUniversal →
      (∀ i (ys : Fin n → N i), φ.Realize default ys) → ∀ xs : Fin n → M, φ.Realize default xs from
    this hσ (fun i ys => Subsingleton.elim ys default ▸ h i) default
  intro n φ hφ
  induction hφ with
  | of_isQF hφ =>
    intro hN xs
    obtain ⟨i, hi⟩ := hf (Finset.univ.image xs)
    choose ys hys using fun k => hi (by simp : xs k ∈ _)
    have := (hφ.realize_embedding (f i) (v := default) (xs := ys)).2 (hN i ys)
    rwa [Subsingleton.elim (f i ∘ default) default, show f i ∘ ys = xs from funext hys] at this
  | all _ ih =>
    refine fun hN xs x => ih (fun i zs => ?_) _
    rw [← Fin.snoc_init_self zs]
    exact hN i (Fin.init zs) (zs (Fin.last _))

/-- Universal sentences are local: a universal sentence holds in `M` when it holds in the
substructure generated by each finite subset of `M`. -/
theorem IsUniversal.realize_sentence_of_forall_closure (hσ : σ.IsUniversal)
    (h : ∀ s : Finset M, Substructure.closure L (s : Set M) ⊨ σ) : M ⊨ σ :=
  hσ.realize_sentence_of_forall_embedding
    (fun s : Finset M => (Substructure.closure L (s : Set M)).subtype) (fun s => ⟨s, by simp⟩) h

end Sentence

end FirstOrder.Language.BoundedFormula
