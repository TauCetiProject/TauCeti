/-!
# The quantum coordinate algebra `O_q(SL₂)`

For a complex parameter `q`, this file defines the algebra `OqSL2 q` of polynomial functions on
the quantum group `SL_q(2)`: the complex algebra generated by the four entries `a, b, c, d` of the
matrix `u = [[a, b], [c, d]]`, subject to

* `a b = q b a`, `a c = q c a`, `b d = q d b`, `c d = q d c`,
* `b c = c b`,
* `a d - d a = (q - q⁻¹) b c`, and
* `a d - q b c = 1`, the quantum determinant relation.

At `q = 1` these are the relations of the coordinate ring of `SL₂`. For real nonzero `q`, the
algebra carries the star structure `a* = d`, `c* = -q⁻¹ b` of the compact real form, under which
it is the coefficient algebra of the compact quantum group `SU_q(2)`, generated by `a` and `c`
with fundamental matrix `[[a, -q c*], [c, a*]]`; see `TauCeti.QuantumGroups.OqSL2.Star`.

The quotient construction supplies a universal property for tuples satisfying these relations
(`TauCeti.OqSL2.lift`), an extensionality principle for algebra maps out of `OqSL2 q`
(`TauCeti.OqSL2.hom_ext`) and an induction principle over the generators
(`TauCeti.OqSL2.induction`). The relations are also recorded in the forms used to bring products
of two generators into the order `b a`, `c a`, `d b`, `d c`, `c b`: in particular
`d a = 1 + q⁻¹ b c` and `a d = 1 + q b c`.

## Main definitions

* `TauCeti.OqSL2`: the quotient algebra.
* `TauCeti.OqSL2.GeneratorTuple`: a tuple in a complex algebra satisfying the defining relations.
* `TauCeti.OqSL2.lift`: the algebra map induced by such a tuple.
* `TauCeti.OqSL2.fundamentalMatrix`: the matrix `u = [[a, b], [c, d]]` of generators.

## References

* A. Klimyk and K. Schmüdgen, *Quantum Groups and Their Representations*, Springer, 1997,
  Section 4.1, for this presentation of `O_q(SL(2))`.
* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Chapter IV, for the quantum
  matrix algebra and `SL_q(2)`.
* The quotient and universal-property API follows the construction of `TauCeti.UqSl2`.
-/

public section

namespace TauCeti

namespace OqSL2

/-- The four generators of the presentation of `OqSL2 q`, the entries of the fundamental
matrix. -/
inductive Generator
  | a
  | b
  | c
  | d
  deriving DecidableEq

/-- The defining relations of `O_q(SL₂)`, as a relation on the free complex algebra on the four
matrix entries. -/
inductive Rel (q : ℂ) : FreeAlgebra ℂ Generator → FreeAlgebra ℂ Generator → Prop
  | a_mul_b : Rel q (FreeAlgebra.ι ℂ .a * FreeAlgebra.ι ℂ .b)
      (q • (FreeAlgebra.ι ℂ .b * FreeAlgebra.ι ℂ .a))
  | a_mul_c : Rel q (FreeAlgebra.ι ℂ .a * FreeAlgebra.ι ℂ .c)
      (q • (FreeAlgebra.ι ℂ .c * FreeAlgebra.ι ℂ .a))
  | b_mul_d : Rel q (FreeAlgebra.ι ℂ .b * FreeAlgebra.ι ℂ .d)
      (q • (FreeAlgebra.ι ℂ .d * FreeAlgebra.ι ℂ .b))
  | c_mul_d : Rel q (FreeAlgebra.ι ℂ .c * FreeAlgebra.ι ℂ .d)
      (q • (FreeAlgebra.ι ℂ .d * FreeAlgebra.ι ℂ .c))
  | b_mul_c : Rel q (FreeAlgebra.ι ℂ .b * FreeAlgebra.ι ℂ .c)
      (FreeAlgebra.ι ℂ .c * FreeAlgebra.ι ℂ .b)
  | a_mul_d_sub_d_mul_a : Rel q
      (FreeAlgebra.ι ℂ .a * FreeAlgebra.ι ℂ .d - FreeAlgebra.ι ℂ .d * FreeAlgebra.ι ℂ .a)
      ((q - q⁻¹) • (FreeAlgebra.ι ℂ .b * FreeAlgebra.ι ℂ .c))
  | a_mul_d_sub_b_mul_c : Rel q
      (FreeAlgebra.ι ℂ .a * FreeAlgebra.ι ℂ .d - q • (FreeAlgebra.ι ℂ .b * FreeAlgebra.ι ℂ .c))
      1

end OqSL2

/-- The quantum coordinate algebra `O_q(SL₂)` with parameter `q`, presented by the four entries
`a, b, c, d` of the fundamental matrix and the `q`-commutation and quantum determinant
relations. -/
@[expose]
def OqSL2 (q : ℂ) : Type := RingQuot (OqSL2.Rel q)

instance (q : ℂ) : Ring (OqSL2 q) :=
  inferInstanceAs (Ring (RingQuot (OqSL2.Rel q)))

instance (q : ℂ) : Algebra ℂ (OqSL2 q) :=
  inferInstanceAs (Algebra ℂ (RingQuot (OqSL2.Rel q)))

namespace OqSL2

variable {q : ℂ}

/-- The quotient map from the free algebra to `OqSL2 q`. -/
def mkAlgHom (q : ℂ) : FreeAlgebra ℂ Generator →ₐ[ℂ] OqSL2 q :=
  RingQuot.mkAlgHom ℂ (Rel q)

/-- The image of a free generator in `OqSL2 q`. -/
def generator (q : ℂ) (g : Generator) : OqSL2 q :=
  mkAlgHom q (FreeAlgebra.ι ℂ g)

/-- The quotient map takes a free generator to the corresponding generator of `OqSL2 q`. -/
@[simp]
theorem mkAlgHom_ι (q : ℂ) (g : Generator) :
    mkAlgHom q (FreeAlgebra.ι ℂ g) = generator q g := (rfl)

/-- The upper left entry `a` of the fundamental matrix. -/
abbrev a (q : ℂ) : OqSL2 q := generator q .a

/-- The upper right entry `b` of the fundamental matrix. -/
abbrev b (q : ℂ) : OqSL2 q := generator q .b

/-- The lower left entry `c` of the fundamental matrix. -/
abbrev c (q : ℂ) : OqSL2 q := generator q .c

/-- The lower right entry `d` of the fundamental matrix. -/
abbrev d (q : ℂ) : OqSL2 q := generator q .d

/- Each defining relation below comes from `RingQuot.mkAlgHom_rel`, whose equation is between
values of `RingQuot.mkAlgHom ℂ (Rel q)`. Because `OqSL2 q` and `mkAlgHom q` are definitions,
`simp` does not see through them; each `show` restates that equation, by definitional unfolding,
between values of `mkAlgHom q`, so that `mkAlgHom_ι` can rewrite the free generators. -/

/-- The defining relation `a b = q b a`. -/
theorem a_mul_b : a q * b q = q • (b q * a q) := by
  simpa only [map_mul, map_smul, mkAlgHom_ι] using
    (show mkAlgHom q _ = mkAlgHom q _ from RingQuot.mkAlgHom_rel ℂ (Rel.a_mul_b (q := q)))

/-- The defining relation `a c = q c a`. -/
theorem a_mul_c : a q * c q = q • (c q * a q) := by
  simpa only [map_mul, map_smul, mkAlgHom_ι] using
    (show mkAlgHom q _ = mkAlgHom q _ from RingQuot.mkAlgHom_rel ℂ (Rel.a_mul_c (q := q)))

/-- The defining relation `b d = q d b`. -/
theorem b_mul_d : b q * d q = q • (d q * b q) := by
  simpa only [map_mul, map_smul, mkAlgHom_ι] using
    (show mkAlgHom q _ = mkAlgHom q _ from RingQuot.mkAlgHom_rel ℂ (Rel.b_mul_d (q := q)))

/-- The defining relation `c d = q d c`. -/
theorem c_mul_d : c q * d q = q • (d q * c q) := by
  simpa only [map_mul, map_smul, mkAlgHom_ι] using
    (show mkAlgHom q _ = mkAlgHom q _ from RingQuot.mkAlgHom_rel ℂ (Rel.c_mul_d (q := q)))

/-- The defining relation `b c = c b`. -/
theorem b_mul_c : b q * c q = c q * b q := by
  simpa only [map_mul, mkAlgHom_ι] using
    (show mkAlgHom q _ = mkAlgHom q _ from RingQuot.mkAlgHom_rel ℂ (Rel.b_mul_c (q := q)))

/-- The defining relation `a d - d a = (q - q⁻¹) b c`. -/
theorem a_mul_d_sub_d_mul_a : a q * d q - d q * a q = (q - q⁻¹) • (b q * c q) := by
  simpa only [map_sub, map_mul, map_smul, mkAlgHom_ι] using
    (show mkAlgHom q _ = mkAlgHom q _ from
      RingQuot.mkAlgHom_rel ℂ (Rel.a_mul_d_sub_d_mul_a (q := q)))

/-- The quantum determinant relation `a d - q b c = 1`. -/
theorem a_mul_d_sub_b_mul_c : a q * d q - q • (b q * c q) = 1 := by
  simpa only [map_sub, map_mul, map_smul, map_one, mkAlgHom_ι] using
    (show mkAlgHom q _ = mkAlgHom q _ from
      RingQuot.mkAlgHom_rel ℂ (Rel.a_mul_d_sub_b_mul_c (q := q)))

/-- The quantum determinant in the other order: `d a - q⁻¹ b c = 1`. -/
theorem d_mul_a_sub_b_mul_c : d q * a q - q⁻¹ • (b q * c q) = 1 := by
  rw [← a_mul_d_sub_b_mul_c (q := q), ← sub_eq_zero]
  have h := a_mul_d_sub_d_mul_a (q := q)
  rw [sub_eq_iff_eq_add] at h
  rw [h, sub_smul]
  abel

/-- The quantum determinant relation, solved for `a d`. -/
theorem a_mul_d : a q * d q = 1 + q • (b q * c q) := by
  rw [← a_mul_d_sub_b_mul_c (q := q), sub_add_cancel]

/-- The quantum determinant relation, solved for `d a`. -/
theorem d_mul_a : d q * a q = 1 + q⁻¹ • (b q * c q) := by
  rw [← d_mul_a_sub_b_mul_c (q := q), sub_add_cancel]

/-- The fundamental matrix `u = [[a, b], [c, d]]` of `O_q(SL₂)`, whose entries generate it. -/
def fundamentalMatrix (q : ℂ) : Matrix (Fin 2) (Fin 2) (OqSL2 q) :=
  !![a q, b q; c q, d q]

theorem fundamentalMatrix_def : fundamentalMatrix q = !![a q, b q; c q, d q] := (rfl)

@[simp] theorem fundamentalMatrix_zero_zero : fundamentalMatrix q 0 0 = a q := (rfl)

@[simp] theorem fundamentalMatrix_zero_one : fundamentalMatrix q 0 1 = b q := (rfl)

@[simp] theorem fundamentalMatrix_one_zero : fundamentalMatrix q 1 0 = c q := (rfl)

@[simp] theorem fundamentalMatrix_one_one : fundamentalMatrix q 1 1 = d q := (rfl)

/-- A tuple in a complex algebra satisfying the defining relations of `OqSL2 q`. -/
structure GeneratorTuple (q : ℂ) (A : Type*) [Ring A] [Algebra ℂ A] where
  /-- The proposed image of `a`. -/
  a : A
  /-- The proposed image of `b`. -/
  b : A
  /-- The proposed image of `c`. -/
  c : A
  /-- The proposed image of `d`. -/
  d : A
  /-- The proposed images satisfy `a b = q b a`. -/
  a_mul_b : a * b = q • (b * a)
  /-- The proposed images satisfy `a c = q c a`. -/
  a_mul_c : a * c = q • (c * a)
  /-- The proposed images satisfy `b d = q d b`. -/
  b_mul_d : b * d = q • (d * b)
  /-- The proposed images satisfy `c d = q d c`. -/
  c_mul_d : c * d = q • (d * c)
  /-- The proposed images satisfy `b c = c b`. -/
  b_mul_c : b * c = c * b
  /-- The proposed images satisfy `a d - d a = (q - q⁻¹) b c`. -/
  a_mul_d_sub_d_mul_a : a * d - d * a = (q - q⁻¹) • (b * c)
  /-- The proposed images satisfy the quantum determinant relation `a d - q b c = 1`. -/
  a_mul_d_sub_b_mul_c : a * d - q • (b * c) = 1

namespace GeneratorTuple

variable {A : Type*} [Ring A] [Algebra ℂ A]

/-- The function on generator names underlying a generator tuple. -/
def toFun (x : GeneratorTuple q A) : Generator → A
  | .a => x.a
  | .b => x.b
  | .c => x.c
  | .d => x.d

@[simp] theorem toFun_a (x : GeneratorTuple q A) : x.toFun .a = x.a := (rfl)

@[simp] theorem toFun_b (x : GeneratorTuple q A) : x.toFun .b = x.b := (rfl)

@[simp] theorem toFun_c (x : GeneratorTuple q A) : x.toFun .c = x.c := (rfl)

@[simp] theorem toFun_d (x : GeneratorTuple q A) : x.toFun .d = x.d := (rfl)

end GeneratorTuple

/-- The universal property of the presentation: a tuple satisfying the defining relations extends
to a complex algebra map from `OqSL2 q`. -/
def lift {A : Type*} [Ring A] [Algebra ℂ A] (x : GeneratorTuple q A) : OqSL2 q →ₐ[ℂ] A :=
  RingQuot.liftAlgHom ℂ ⟨FreeAlgebra.lift ℂ x.toFun, by
    rintro _ _ (_ | _ | _ | _ | _ | _ | _) <;>
      simp only [map_mul, map_smul, map_sub, map_one, FreeAlgebra.lift_ι_apply,
        GeneratorTuple.toFun_a, GeneratorTuple.toFun_b, GeneratorTuple.toFun_c,
        GeneratorTuple.toFun_d]
    exacts [x.a_mul_b, x.a_mul_c, x.b_mul_d, x.c_mul_d, x.b_mul_c, x.a_mul_d_sub_d_mul_a,
      x.a_mul_d_sub_b_mul_c]⟩

variable {A : Type*} [Ring A] [Algebra ℂ A]

/-- The map induced by a generator tuple has the prescribed value on every generator. -/
theorem lift_generator (x : GeneratorTuple q A) (g : Generator) :
    lift x (generator q g) = x.toFun g :=
  (RingQuot.liftAlgHom_mkAlgHom_apply ℂ _ _ _).trans (FreeAlgebra.lift_ι_apply _ _)

@[simp] theorem lift_a (x : GeneratorTuple q A) : lift x (a q) = x.a := lift_generator x .a

@[simp] theorem lift_b (x : GeneratorTuple q A) : lift x (b q) = x.b := lift_generator x .b

@[simp] theorem lift_c (x : GeneratorTuple q A) : lift x (c q) = x.c := lift_generator x .c

@[simp] theorem lift_d (x : GeneratorTuple q A) : lift x (d q) = x.d := lift_generator x .d

/-- Two algebra maps from `OqSL2 q` agreeing on the four entries of the fundamental matrix are
equal. -/
@[ext high]
theorem hom_ext {A : Type*} [Semiring A] [Algebra ℂ A] {F G : OqSL2 q →ₐ[ℂ] A}
    (ha : F (a q) = G (a q)) (hb : F (b q) = G (b q)) (hc : F (c q) = G (c q))
    (hd : F (d q) = G (d q)) : F = G := by
  apply RingQuot.ringQuot_ext' ℂ F G
  apply FreeAlgebra.hom_ext
  funext g
  cases g <;> assumption

/-- The four entries of the fundamental matrix generate `OqSL2 q`. -/
theorem adjoin_range_generator (q : ℂ) :
    Algebra.adjoin ℂ (Set.range (generator q)) = ⊤ := by
  rw [Algebra.adjoin_range_eq_range_freeAlgebra_lift]
  have h : FreeAlgebra.lift ℂ (generator q) = mkAlgHom q := by
    apply FreeAlgebra.hom_ext
    funext g
    simp
  rw [h, AlgHom.range_eq_top]
  exact RingQuot.mkAlgHom_surjective ℂ (Rel q)

/-- An induction principle for `OqSL2 q`: a property of its elements that holds for the scalars
and the four generators and is closed under products and sums holds everywhere. -/
@[elab_as_elim]
theorem induction {C : OqSL2 q → Prop} (algebraMap : ∀ r, C (algebraMap ℂ (OqSL2 q) r))
    (generator : ∀ g, C (generator q g)) (mul : ∀ x y, C x → C y → C (x * y))
    (add : ∀ x y, C x → C y → C (x + y)) (x : OqSL2 q) : C x := by
  have hx : x ∈ Algebra.adjoin ℂ (Set.range (OqSL2.generator q)) := by
    rw [adjoin_range_generator]
    exact Algebra.mem_top
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨g, rfl⟩ := hx
    exact generator g
  | algebraMap r => exact algebraMap r
  | add x y _ _ hx hy => exact add x y hx hy
  | mul x y _ _ hx hy => exact mul x y hx hy

end OqSL2

end TauCeti
