/-!
# The quantum Clebsch–Gordan decomposition

At a generic parameter `q`, the tensor product of two signed ladder modules decomposes as

`L_m^ε ⊗ L_n^δ ≃ ⊕_(j = 0)^(min m n) L_(m + n - 2j)^(εδ)`,

where `U_q(sl₂)` acts on the tensor product through the coproduct
`ΔE = E ⊗ 1 + K ⊗ E`, `ΔF = F ⊗ K⁻¹ + 1 ⊗ F`, `ΔK = K ⊗ K`.

The `j`-th summand is generated by the explicit highest vector
`w_j = ∑_(i = 0)^j α_i v_i ⊗ v_(j - i)`, whose coefficients satisfy `α₀ = 1` and
`α_(i+1) = -δ q^(m - 2i) [n - j + i + 1]_q / [m - i]_q α_i`. This recurrence is exactly the
condition `E w_j = 0`. The vector `w_j` has weight `εδ q^(m + n - 2j)`, so the universal property
of the ladder modules (`LadderModule.lift`) turns it into an injective module map
`L_(m + n - 2j)^(εδ) → L_m^ε ⊗ L_n^δ` sending `v_k` to `F^k w_j / ([1]_q ⋯ [k]_q)`. The images
of these maps lie in distinct Casimir blocks, hence are independent, and their dimensions add up
to `(m + 1)(n + 1)`.

## Main definitions

* `TauCeti.UqSl2.clebschGordanCoeff`: the coefficients `α_i`.
* `TauCeti.UqSl2.clebschGordanVector`: the highest vector `w_j` in `L_m^ε ⊗ L_n^δ`.
* `TauCeti.UqSl2.clebschGordanInclusion`: the module map `L_(m + n - 2j)^(εδ) → L_m^ε ⊗ L_n^δ`
  sending `v₀` to `w_j`.
* `TauCeti.UqSl2.clebschGordanEquiv`: the Clebsch–Gordan isomorphism.

## Main results

* `TauCeti.UqSl2.e_smul_clebschGordanVector`: `E w_j = 0`.
* `TauCeti.UqSl2.clebschGordanVector_mem_weightSpace`: `K w_j = εδ q^(m + n - 2j) w_j`.
* `TauCeti.UqSl2.clebschGordanVector_ne_zero`: `w_j ≠ 0` for `j ≤ n`.
* `TauCeti.UqSl2.iSupIndep_range_clebschGordanInclusion`: the summands are independent.
* `TauCeti.UqSl2.clebschGordanEquiv_apply`, `TauCeti.UqSl2.clebschGordanEquiv_single`: the
  isomorphism is the sum of the inclusions.

## References

* A. Virelizier, *Quantum groups*, Section 4.1, for the fusion rule of the finite-dimensional
  type-1 modules.
* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Chapter VII, for the
  Clebsch–Gordan formula for the tensor products of the modules `V_(ε,n)`.
-/

public noncomputable section

namespace TauCeti.UqSl2

open BialgebraModule LadderModule Module

variable {q : ℂ}

variable (q) in
/-- The coefficients `α_i` of the Clebsch–Gordan vector `∑_i α_i v_i ⊗ v_(j - i)` in
`L_m^ε ⊗ L_n^δ`, defined for all `q`, `m`, `n`, `j` and `i` by `α₀ = 1` and
`α_(i+1) = -δ q^(m - 2i) [n - j + i + 1]_q / [m - i]_q α_i` (with Lean's convention `x / 0 = 0`).
They do not depend on `ε`. At a generic parameter and for `j ≤ m`, the denominators `[m - i]_q`
with `i < j` are nonzero and the resulting vector is a highest vector (see
`TauCeti.UqSl2.e_smul_clebschGordanVector`). -/
def clebschGordanCoeff (m n : ℕ) (δ : ℤˣ) (j : ℕ) : ℕ → ℂ
  | 0 => 1
  | i + 1 => -(δ : ℂ) * q ^ ((m : ℤ) - 2 * i) * quantumInteger q ((n : ℤ) - j + i + 1) /
      quantumInteger q ((m : ℤ) - i) * clebschGordanCoeff m n δ j i

/-- The leading Clebsch–Gordan coefficient is normalized to `α₀ = 1`. -/
@[simp]
theorem clebschGordanCoeff_zero (m n : ℕ) (δ : ℤˣ) (j : ℕ) :
    clebschGordanCoeff q m n δ j 0 = 1 := by
  rw [clebschGordanCoeff]

/-- The defining recurrence of the Clebsch–Gordan coefficients. -/
theorem clebschGordanCoeff_succ (m n : ℕ) (δ : ℤˣ) (j i : ℕ) :
    clebschGordanCoeff q m n δ j (i + 1) =
      -(δ : ℂ) * q ^ ((m : ℤ) - 2 * i) * quantumInteger q ((n : ℤ) - j + i + 1) /
        quantumInteger q ((m : ℤ) - i) * clebschGordanCoeff q m n δ j i := by
  rw [clebschGordanCoeff]

/-- At a generic parameter and for `i < m`, the Clebsch–Gordan recurrence with its denominator
cleared: `[m - i]_q α_(i+1) = -δ q^(m - 2i) [n - j + i + 1]_q α_i`. -/
theorem quantumInteger_mul_clebschGordanCoeff_succ (hq : IsGenericQuantumParameter q)
    {m n : ℕ} {δ : ℤˣ} {j i : ℕ} (hi : i < m) :
    quantumInteger q ((m : ℤ) - i) * clebschGordanCoeff q m n δ j (i + 1) =
      -(δ : ℂ) * q ^ ((m : ℤ) - 2 * i) * quantumInteger q ((n : ℤ) - j + i + 1) *
        clebschGordanCoeff q m n δ j i := by
  have := quantumInteger_ne_zero hq (r := (m : ℤ) - i) (by omega)
  rw [clebschGordanCoeff_succ]
  field_simp

variable [Fact (q ≠ 0)]

variable (q) in
/-- The Clebsch–Gordan vector `w_j = ∑_(i = 0)^j α_i v_i ⊗ v_(j - i)` in `L_m^ε ⊗ L_n^δ`, with
the coefficients `α_i = clebschGordanCoeff q m n δ j i`, defined for every `j`. It always has
weight `εδ q^(m + n - 2j)`, and it is nonzero for `j ≤ n`. At a generic parameter and for
`j ≤ m` it is moreover killed by `E`, so for `j ≤ min m n` it is a nonzero highest vector. -/
def clebschGordanVector (m : ℕ) (ε : ℤˣ) (n : ℕ) (δ : ℤˣ) (j : ℕ) :
    Tensor ℂ (UqSl2 q) (LadderModule q m ε) (LadderModule q n δ) :=
  ∑ i ∈ Finset.range (j + 1), clebschGordanCoeff q m n δ j i •
    tmul ℂ (UqSl2 q) (vec q m ε i) (vec q n δ ((j : ℤ) - i))

variable {m n : ℕ} {ε δ : ℤˣ}

/-- The defining formula `w_j = ∑_(i = 0)^j α_i v_i ⊗ v_(j - i)` of the Clebsch–Gordan vector. -/
theorem clebschGordanVector_def (j : ℕ) :
    clebschGordanVector q m ε n δ j = ∑ i ∈ Finset.range (j + 1), clebschGordanCoeff q m n δ j i •
      tmul ℂ (UqSl2 q) (vec q m ε i) (vec q n δ ((j : ℤ) - i)) := by
  rw [clebschGordanVector]

/-- The Clebsch–Gordan vector `w_j` has weight `εδ q^(m + n - 2j)`. -/
theorem clebschGordanVector_mem_weightSpace (j : ℕ) :
    clebschGordanVector q m ε n δ j ∈
      weightSpace q (Tensor ℂ (UqSl2 q) (LadderModule q m ε) (LadderModule q n δ))
        ((ε * δ : ℤˣ) * q ^ ((m : ℤ) + n - 2 * j)) := by
  have hq0 : q ≠ 0 := Fact.out
  rw [clebschGordanVector_def]
  refine Submodule.sum_mem _ fun i _ => Submodule.smul_of_tower_mem _ _ ?_
  rw [mem_weightSpace_iff, k_smul_tmul, k_smul_vec, k_smul_vec, ← smul_tmul', tmul_smul,
    smul_smul]
  congr 1
  rw [mul_mul_mul_comm, ← zpow_add₀ hq0]
  push_cast
  congr 2
  ring

/-- For `j ≤ m`, the Clebsch–Gordan vector `w_j` is a highest-weight vector: `E w_j = 0`. -/
theorem e_smul_clebschGordanVector (hq : IsGenericQuantumParameter q) {j : ℕ} (hj : j ≤ m) :
    e q • clebschGordanVector q m ε n δ j = 0 := by
  -- Write `E (v_i ⊗ v_(j-i))` as a combination of `g (i - 1)` and `g i`, where
  -- `g i = v_i ⊗ v_(j-i-1)`.
  set g : ℤ → Tensor ℂ (UqSl2 q) (LadderModule q m ε) (LadderModule q n δ) :=
    fun i => tmul ℂ (UqSl2 q) (vec q m ε i) (vec q n δ ((j : ℤ) - i - 1)) with hg
  have hterm (i : ℕ) : e q • tmul ℂ (UqSl2 q) (vec q m ε i) (vec q n δ ((j : ℤ) - i)) =
      (ε * quantumInteger q ((m : ℤ) - i + 1)) • g (i - 1) +
        (δ * quantumInteger q ((n : ℤ) - j + i + 1) * (ε * q ^ ((m : ℤ) - 2 * i))) • g i := by
    rw [e_smul_tmul, e_smul_vec, k_smul_vec, e_smul_vec, ← smul_tmul', tmul_smul,
      ← smul_tmul', smul_smul, hg]
    dsimp only
    rw [show (j : ℤ) - (i - 1 : ℤ) - 1 = j - i by ring,
      show (n : ℤ) - (j - i) + 1 = n - j + i + 1 by ring]
  simp only [clebschGordanVector_def, Finset.smul_sum, smul_comm (e q) (_ : ℂ), hterm, smul_add,
    Finset.sum_add_distrib, smul_smul]
  -- The boundary terms `g (-1)` and `g j` vanish; the coefficient of each remaining `g i` is
  -- zero by the recurrence for `α_(i+1)`.
  rw [Finset.sum_range_succ', Finset.sum_range_succ]
  have hg0 : g ((0 : ℕ) - 1) = 0 := by simp [hg]
  have hgj : g j = 0 := by simp [hg]
  rw [hg0, hgj, smul_zero, smul_zero, add_zero, add_zero, ← Finset.sum_add_distrib]
  refine Finset.sum_eq_zero fun i hi => ?_
  rw [Finset.mem_range] at hi
  rw [Nat.cast_succ, add_sub_cancel_right, ← add_smul]
  refine (congrArg (· • g i) ?_).trans (zero_smul ℂ (g i))
  have h := quantumInteger_mul_clebschGordanCoeff_succ hq (n := n) (δ := δ) (j := j)
    (show i < m by omega)
  rw [show (m : ℤ) - (i + 1) + 1 = m - i by ring]
  linear_combination (ε : ℂ) * h

/-- For `j ≤ n`, the Clebsch–Gordan vector `w_j` is nonzero: its coefficient on
`v₀ ⊗ v_j` is `α₀ = 1`. -/
theorem clebschGordanVector_ne_zero {j : ℕ} (hj : j ≤ n) :
    clebschGordanVector q m ε n δ j ≠ 0 := by
  intro h
  have := congrArg (fun x => ((basis q m ε).tensorProduct (basis q n δ)).repr
    (tensorEquiv ℂ (UqSl2 q) _ _ x) (0, ⟨j, by omega⟩)) h
  simp only [clebschGordanVector_def, map_sum, map_smul, tensorEquiv_tmul, Finsupp.finsetSum_apply,
    Finsupp.smul_apply, Basis.tensorProduct_repr_tmul_apply, basis_repr_vec, smul_eq_mul,
    map_zero, Finsupp.coe_zero, Pi.zero_apply] at this
  rw [Finset.sum_eq_single 0 (fun i _ hi => by simp [show (0 : ℤ) ≠ i by omega]) (by simp)]
    at this
  simp at this

private theorem clebschGordanVector_mem_weightSpace_natCast {j : ℕ} (hj : 2 * j ≤ m + n) :
    clebschGordanVector q m ε n δ j ∈
      weightSpace q (Tensor ℂ (UqSl2 q) (LadderModule q m ε) (LadderModule q n δ))
        ((ε * δ : ℤˣ) * q ^ (m + n - 2 * j)) := by
  have h := clebschGordanVector_mem_weightSpace (q := q) (m := m) (ε := ε) (n := n) (δ := δ) j
  rwa [show (m : ℤ) + n - 2 * j = ((m + n - 2 * j : ℕ) : ℤ) by omega, zpow_natCast] at h

/-- For `j ≤ min m n`, the lowering string of `w_j` vanishes after `m + n - 2j + 1` steps. -/
theorem f_pow_smul_clebschGordanVector (hq : IsGenericQuantumParameter q) {j : ℕ} (hjm : j ≤ m)
    (hjn : j ≤ n) : f q ^ (m + n - 2 * j + 1) • clebschGordanVector q m ε n δ j = 0 :=
  f_pow_succ_smul_eq_zero_of_highest_weight_vector hq
    (clebschGordanVector_mem_weightSpace_natCast (by omega)) (e_smul_clebschGordanVector hq hjm)

/-- The summand index `j ≤ min m n` is at most `m`. -/
private theorem val_le_left (j : Fin (min m n + 1)) : (j : ℕ) ≤ m := by
  have := j.isLt
  omega

/-- The summand index `j ≤ min m n` is at most `n`. -/
private theorem val_le_right (j : Fin (min m n + 1)) : (j : ℕ) ≤ n := by
  have := j.isLt
  omega

/-- For `j ≤ min m n`, the Clebsch–Gordan inclusion `L_(m + n - 2j)^(εδ) → L_m^ε ⊗ L_n^δ`: the
module map sending `v₀` to the highest vector `w_j`, and `v_k` to `F^k w_j / ([1]_q ⋯ [k]_q)`. -/
def clebschGordanInclusion (hq : IsGenericQuantumParameter q) (j : Fin (min m n + 1)) :
    LadderModule q (m + n - 2 * j) (ε * δ) →ₗ[UqSl2 q]
      Tensor ℂ (UqSl2 q) (LadderModule q m ε) (LadderModule q n δ) :=
  LadderModule.lift hq (clebschGordanVector_mem_weightSpace_natCast (by omega))
    (e_smul_clebschGordanVector hq (val_le_left j))
    (f_pow_smul_clebschGordanVector hq (val_le_left j) (val_le_right j))

/-- The Clebsch–Gordan inclusion sends `v₀` to the highest vector `w_j`. -/
@[simp]
theorem clebschGordanInclusion_vec_zero (hq : IsGenericQuantumParameter q)
    (j : Fin (min m n + 1)) :
    clebschGordanInclusion (ε := ε) (δ := δ) hq j (vec q _ _ 0) =
      clebschGordanVector q m ε n δ j :=
  lift_vec_zero ..

/-- The Clebsch–Gordan inclusion sends `v_k` to the normalized lowering string
`F^k w_j / ([1]_q ⋯ [k]_q)`. -/
theorem clebschGordanInclusion_vec (hq : IsGenericQuantumParameter q) (j : Fin (min m n + 1))
    (k : ℕ) :
    clebschGordanInclusion (ε := ε) (δ := δ) hq j (vec q _ _ k) =
      (∏ i ∈ Finset.range k, quantumInteger q (i + 1))⁻¹ •
        f q ^ k • clebschGordanVector q m ε n δ j :=
  lift_vec ..

/-- The Clebsch–Gordan inclusions are injective. -/
theorem clebschGordanInclusion_injective (hq : IsGenericQuantumParameter q)
    (j : Fin (min m n + 1)) :
    Function.Injective (clebschGordanInclusion (ε := ε) (δ := δ) hq j) :=
  lift_injective _ _ _ _ (clebschGordanVector_ne_zero (val_le_right j))

/-- The image of the `j`-th Clebsch–Gordan inclusion lies in the Casimir block of its highest
weight `εδ q^(m + n - 2j)`. -/
theorem range_clebschGordanInclusion_le_casimirBlock (hq : IsGenericQuantumParameter q)
    (j : Fin (min m n + 1)) :
    LinearMap.range (clebschGordanInclusion (ε := ε) (δ := δ) hq j) ≤
      casimirBlock q _ (casimirScalar q ((ε * δ : ℤˣ) * q ^ (m + n - 2 * (j : ℕ)))) := by
  -- Every vector of the simple module `L_(m + n - 2j)^(εδ)` is `a v₀`, and the Casimir element
  -- acts on `a w_j` by the scalar of the highest weight.
  rintro _ ⟨x, rfl⟩
  have := isSimpleModule (q := q) (m := m + n - 2 * j) (ε := ε * δ) hq
  obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp
    ((IsSimpleModule.span_singleton_eq_top (UqSl2 q) (m := vec q (m + n - 2 * j) (ε * δ) 0)
      (by simp)).ge (Submodule.mem_top (x := x)))
  rw [map_smul, clebschGordanInclusion_vec_zero, mem_casimirBlock_iff]
  refine ⟨1, ?_⟩
  rw [pow_one, sub_smul, algebraMap_smul, casimir_smul_smul_of_e_smul_eq_zero
    (clebschGordanVector_mem_weightSpace_natCast (by omega))
    (e_smul_clebschGordanVector hq (val_le_left j)), sub_self]

/-- The images of the Clebsch–Gordan inclusions are independent. -/
theorem iSupIndep_range_clebschGordanInclusion (hq : IsGenericQuantumParameter q) :
    iSupIndep fun j : Fin (min m n + 1) =>
      LinearMap.range (clebschGordanInclusion (ε := ε) (δ := δ) hq j) := by
  -- The summands lie in the Casimir blocks of their highest weights, which are distinct.
  have hc : Function.Injective fun j : Fin (min m n + 1) =>
      casimirScalar q ((ε * δ : ℤˣ) * q ^ (m + n - 2 * (j : ℕ))) := fun j k h => by
    obtain ⟨h, -⟩ := (casimirScalar_units_mul_pow_inj hq).mp h
    have := val_le_left j
    have := val_le_left k
    ext
    omega
  exact (iSupIndep_casimirBlock.comp hc).mono fun j =>
    range_clebschGordanInclusion_le_casimirBlock hq j

/-- The sum of the Clebsch–Gordan inclusions, a module map out of the product of the summands. -/
private def clebschGordanSum (hq : IsGenericQuantumParameter q) :
    (Π j : Fin (min m n + 1), LadderModule q (m + n - 2 * j) (ε * δ)) →ₗ[UqSl2 q]
      Tensor ℂ (UqSl2 q) (LadderModule q m ε) (LadderModule q n δ) :=
  LinearMap.lsum (UqSl2 q) _ ℂ fun j => clebschGordanInclusion hq j

private theorem clebschGordanSum_apply (hq : IsGenericQuantumParameter q)
    (x : Π j : Fin (min m n + 1), LadderModule q (m + n - 2 * j) (ε * δ)) :
    clebschGordanSum hq x = ∑ j, clebschGordanInclusion hq j (x j) := by
  simp [clebschGordanSum]

private theorem clebschGordanSum_bijective (hq : IsGenericQuantumParameter q) :
    Function.Bijective (clebschGordanSum (m := m) (ε := ε) (n := n) (δ := δ) hq) := by
  -- Injectivity comes from the independence of the summands; surjectivity then follows by
  -- comparing dimensions.
  have hinj : Function.Injective (clebschGordanSum (m := m) (ε := ε) (n := n) (δ := δ) hq) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [clebschGordanSum_apply] at hx
    have h0 := (iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero _).mp
      (iSupIndep_range_clebschGordanInclusion hq) Finset.univ _
      (fun j _ => LinearMap.mem_range_self _ (x j)) hx
    funext j
    exact clebschGordanInclusion_injective hq j
      ((h0 j (Finset.mem_univ j)).trans (map_zero _).symm)
  refine ⟨hinj, ?_⟩
  have hdim : finrank ℂ (Π j : Fin (min m n + 1), LadderModule q (m + n - 2 * j) (ε * δ)) =
      finrank ℂ (Tensor ℂ (UqSl2 q) (LadderModule q m ε) (LadderModule q n δ)) := by
    rw [Module.finrank_pi_fintype, (tensorEquiv ℂ (UqSl2 q) _ _).finrank_eq,
      Module.finrank_tensorProduct]
    simp only [finrank_eq]
    rw [Fin.sum_univ_eq_sum_range (fun j => m + n - 2 * j + 1),
      Finset.sum_range_min_add_one_sub_two_mul]
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim
    (f := (clebschGordanSum hq).restrictScalars ℂ)).mp hinj

/-- The quantum Clebsch–Gordan decomposition: at a generic parameter,
`L_m^ε ⊗ L_n^δ ≃ ⊕_(j = 0)^(min m n) L_(m + n - 2j)^(εδ)` as `UqSl2 q`-modules, with the `j`-th
summand embedded by `clebschGordanInclusion`. -/
def clebschGordanEquiv (hq : IsGenericQuantumParameter q) :
    (Π j : Fin (min m n + 1), LadderModule q (m + n - 2 * j) (ε * δ)) ≃ₗ[UqSl2 q]
      Tensor ℂ (UqSl2 q) (LadderModule q m ε) (LadderModule q n δ) :=
  LinearEquiv.ofBijective (clebschGordanSum hq) (clebschGordanSum_bijective hq)

/-- The Clebsch–Gordan isomorphism is the sum of the Clebsch–Gordan inclusions. -/
theorem clebschGordanEquiv_apply (hq : IsGenericQuantumParameter q)
    (x : Π j : Fin (min m n + 1), LadderModule q (m + n - 2 * j) (ε * δ)) :
    clebschGordanEquiv hq x = ∑ j, clebschGordanInclusion hq j (x j) :=
  clebschGordanSum_apply hq x

/-- The Clebsch–Gordan isomorphism restricts to the `j`-th inclusion on the `j`-th summand. -/
@[simp]
theorem clebschGordanEquiv_single (hq : IsGenericQuantumParameter q) (j : Fin (min m n + 1))
    (x : LadderModule q (m + n - 2 * j) (ε * δ)) :
    clebschGordanEquiv hq (Pi.single j x) = clebschGordanInclusion hq j x := by
  rw [clebschGordanEquiv, LinearEquiv.ofBijective_apply, clebschGordanSum,
    LinearMap.lsum_piSingle]

end TauCeti.UqSl2
