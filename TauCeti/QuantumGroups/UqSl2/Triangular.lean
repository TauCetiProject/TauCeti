module

public import Mathlib.RingTheory.Algebraic.Defs
public import TauCeti.QuantumGroups.UqSl2.PBW

import Mathlib.Algebra.Polynomial.Basis
import Mathlib.LinearAlgebra.TensorProduct.Basis
import Mathlib.RingTheory.Algebraic.Basic

/-!
# The triangular decomposition of `U_q(sl₂)`

For a nonzero parameter `q`, write `U⁻`, `U⁰` and `U⁺` for the subalgebras of `UqSl2 q`
generated by `F`, by `K` and `K⁻¹`, and by `E`.  This file proves:

* the subalgebra inclusions: evaluation at `F` and at `E` is injective on the polynomial ring
  `ℂ[X]`, so `F` and `E` are transcendental over `ℂ`, and evaluation at the unit `K` is
  injective on the Laurent polynomial ring `ℂ[T, T⁻¹]`;
* the triangular decomposition: multiplication `p ⊗ r ⊗ s ↦ p(F) * r(K) * s(E)` is a linear
  isomorphism `ℂ[X] ⊗ ℂ[T, T⁻¹] ⊗ ℂ[X] ≃ UqSl2 q`, i.e. `U⁻ ⊗ U⁰ ⊗ U⁺ ≃ U_q(sl₂)`.

Both statements are repackagings of the PBW basis `F ^ a * K ^ b * E ^ c`: the tensor product
of the monomial bases of the three factors is sent to it.  The decomposition is the form in
which the PBW theorem enters highest-weight theory: an element is determined by its components
in `U⁻ ⊗ U⁰ ⊗ U⁺`, which is how central elements are reduced to their `U⁰` part.

## Main definitions

* `TauCeti.UqSl2.triangularEquiv`: the multiplication isomorphism
  `ℂ[X] ⊗[ℂ] (ℂ[T;T⁻¹] ⊗[ℂ] ℂ[X]) ≃ₗ[ℂ] UqSl2 q`.

## Main results

* `TauCeti.UqSl2.triangularEquiv_tmul`: its value `p(F) * r(K) * s(E)` on a pure tensor.
* `TauCeti.UqSl2.triangularEquiv_symm_pbwBasis`: its inverse sends the PBW basis vector
  `F ^ a * K ^ b * E ^ c` to the monomial tensor `X ^ a ⊗ T b ⊗ X ^ c`.
* `TauCeti.UqSl2.transcendental_f` and `TauCeti.UqSl2.transcendental_e`: `F` and `E` generate
  polynomial subalgebras.
* `TauCeti.UqSl2.laurentEval_kUnit_injective`: `K` generates a Laurent polynomial subalgebra.

## References

* J. C. Jantzen, *Lectures on Quantum Groups*, Graduate Studies in Mathematics 6, Chapter 1,
  for the rank-one triangular decomposition.
* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Section VI.1, for the PBW
  basis it is derived from.
-/

public noncomputable section

open Polynomial LaurentPolynomial TensorProduct

namespace TauCeti.UqSl2

variable (q : ℂ) [Fact (q ≠ 0)]

/-! ### The subalgebra inclusions -/

/-- A linear map sending a basis to distinct PBW vectors is injective. -/
private theorem injective_of_apply_basis_eq_pbwBasis {M ι : Type*} [AddCommGroup M] [Module ℂ M]
    (b : Module.Basis ι ℂ M) (φ : M →ₗ[ℂ] UqSl2 q) {g : ι → ℕ × ℤ × ℕ}
    (hg : Function.Injective g) (h : ∀ i, φ (b i) = pbwBasis q (g i)) :
    Function.Injective φ := by
  refine LinearMap.injective_of_linearIndependent b.span_eq ?_
  convert (pbwBasis q).linearIndependent.comp g hg using 1
  exact funext h

/-- The lowering generator `F` is transcendental over `ℂ`: evaluation at `F` is injective, so it
identifies `ℂ[X]` with the subalgebra `U⁻` generated by `F`. -/
theorem transcendental_f : Transcendental ℂ (f q) := by
  rw [transcendental_iff_injective]
  exact injective_of_apply_basis_eq_pbwBasis q (basisMonomials ℂ) (aeval (f q)).toLinearMap
    (g := fun a => (a, 0, 0)) (fun a a' h => congrArg Prod.fst h) fun a => by simp

/-- The raising generator `E` is transcendental over `ℂ`: evaluation at `E` is injective, so it
identifies `ℂ[X]` with the subalgebra `U⁺` generated by `E`. -/
theorem transcendental_e : Transcendental ℂ (e q) := by
  rw [transcendental_iff_injective]
  exact injective_of_apply_basis_eq_pbwBasis q (basisMonomials ℂ) (aeval (e q)).toLinearMap
    (g := fun c => (0, 0, c)) (fun c c' h => congrArg (·.2.2) h) fun c => by simp

/-- Evaluation at the unit `K` is injective, so it identifies the Laurent polynomial ring
`ℂ[T, T⁻¹]` with the subalgebra `U⁰` generated by `K` and `K⁻¹`. -/
theorem laurentEval_kUnit_injective : Function.Injective (laurentEval (R := ℂ) (kUnit q)) :=
  injective_of_apply_basis_eq_pbwBasis q (AddMonoidAlgebra.basis ℤ ℂ)
    (laurentEval (R := ℂ) (kUnit q)).toLinearMap (g := fun b => (0, b, 0))
    (fun b b' h => congrArg (·.2.1) h) fun b => by simp [single_eq_C_mul_T]

/-! ### The triangular decomposition -/

/-- The product of the monomial bases of `ℂ[X]`, `ℂ[T, T⁻¹]` and `ℂ[X]`, indexed by the PBW
exponents `(a, b, c)`. -/
private def triangularBasis : Module.Basis (ℕ × ℤ × ℕ) ℂ (ℂ[X] ⊗[ℂ] (ℂ[T;T⁻¹] ⊗[ℂ] ℂ[X])) :=
  (basisMonomials ℂ).tensorProduct ((AddMonoidAlgebra.basis ℤ ℂ).tensorProduct (basisMonomials ℂ))

/-- The multiplication map `p ⊗ r ⊗ s ↦ p(F) * (r(K) * s(E))`. -/
private def triangularMap : ℂ[X] ⊗[ℂ] (ℂ[T;T⁻¹] ⊗[ℂ] ℂ[X]) →ₗ[ℂ] UqSl2 q :=
  LinearMap.mul' ℂ (UqSl2 q) ∘ₗ map (aeval (f q)).toLinearMap
    (LinearMap.mul' ℂ (UqSl2 q) ∘ₗ
      map (laurentEval (R := ℂ) (kUnit q)).toLinearMap (aeval (e q)).toLinearMap)

omit [Fact (q ≠ 0)] in
private theorem triangularMap_tmul (p : ℂ[X]) (r : ℂ[T;T⁻¹]) (s : ℂ[X]) :
    triangularMap q (p ⊗ₜ (r ⊗ₜ s)) =
      aeval (f q) p * laurentEval (kUnit q) r * aeval (e q) s := by
  simp [triangularMap, mul_assoc]

/-- The multiplication map sends the product of monomial bases to the PBW basis. -/
private theorem triangularMap_comp_triangularBasis :
    triangularMap q ∘ triangularBasis = pbwBasis q := by
  funext ⟨a, b, c⟩
  simp [triangularBasis, triangularMap_tmul, single_eq_C_mul_T]

/-- **Triangular decomposition of `U_q(sl₂)`.**  Multiplication
`p ⊗ r ⊗ s ↦ p(F) * r(K) * s(E)` is a linear isomorphism
`ℂ[X] ⊗ ℂ[T, T⁻¹] ⊗ ℂ[X] ≃ UqSl2 q`, that is, `U⁻ ⊗ U⁰ ⊗ U⁺ ≃ U_q(sl₂)`.  It sends the
tensor product of monomial bases to the PBW basis. -/
def triangularEquiv : ℂ[X] ⊗[ℂ] (ℂ[T;T⁻¹] ⊗[ℂ] ℂ[X]) ≃ₗ[ℂ] UqSl2 q :=
  LinearEquiv.ofBijective (triangularMap q) <|
    LinearMap.bijective_of_linearIndependent_of_span_eq_top triangularBasis.span_eq
      (by rw [triangularMap_comp_triangularBasis]; exact (pbwBasis q).linearIndependent)
      (by rw [triangularMap_comp_triangularBasis]; exact (pbwBasis q).span_eq)

/-- The triangular decomposition multiplies the three components in the order `U⁻ U⁰ U⁺`. -/
@[simp]
theorem triangularEquiv_tmul (p : ℂ[X]) (r : ℂ[T;T⁻¹]) (s : ℂ[X]) :
    triangularEquiv q (p ⊗ₜ (r ⊗ₜ s)) =
      aeval (f q) p * laurentEval (kUnit q) r * aeval (e q) s := by
  rw [triangularEquiv, LinearEquiv.ofBijective_apply, triangularMap_tmul]

/-- The inverse of the triangular decomposition sends the PBW basis vector `F ^ a * K ^ b * E ^ c`
to the monomial tensor `X ^ a ⊗ T b ⊗ X ^ c`. -/
theorem triangularEquiv_symm_pbwBasis (a : ℕ) (b : ℤ) (c : ℕ) :
    (triangularEquiv q).symm (pbwBasis q (a, b, c)) = (X ^ a) ⊗ₜ (T b ⊗ₜ (X ^ c)) := by
  rw [LinearEquiv.symm_apply_eq, triangularEquiv_tmul]
  simp

/-- The inverse of the triangular decomposition on an ordered monomial `F ^ a * K ^ b * E ^ c`;
this is `triangularEquiv_symm_pbwBasis` in `simp` normal form. -/
@[simp]
theorem triangularEquiv_symm_f_pow_mul_kUnit_zpow_mul_e_pow (a : ℕ) (b : ℤ) (c : ℕ) :
    (triangularEquiv q).symm (f q ^ a * ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) * e q ^ c) =
      (X ^ a) ⊗ₜ (T b ⊗ₜ (X ^ c)) := by
  rw [← pbwBasis_apply, triangularEquiv_symm_pbwBasis]

end TauCeti.UqSl2
