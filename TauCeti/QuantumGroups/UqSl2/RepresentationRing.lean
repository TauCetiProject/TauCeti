/-!
# The representation ring of `U_q(sl₂)`

The **representation ring** `R(U_q)` of `U_q(sl₂)` is the split Grothendieck ring of the monoidal
category `FiniteHopfModuleCat ℂ (UqSl2 q)` of finite-dimensional modules: the abelian group
generated by the classes `[V]` subject to `[V ⊕ W] = [V] + [W]`, with multiplication
`[V] · [W] = [V ⊗ W]` induced by the tensor product through the coproduct, and unit the class of
the trivial module. It is `TauCeti.SplitK0` of that category, whose ring structure needs no
braiding. At a generic parameter every finite-dimensional module is semisimple, so every short
exact sequence splits and the split relations are all the relations of the abelian category.

The formal character `ch V = ∑_μ dim V_μ · [μ]` is isomorphism invariant, additive and, at a
generic parameter `q` (nonzero and not a root of unity), multiplicative on tensor products, so it
descends to a ring homomorphism `R(U_q) → ℤ[ℂ]` into the integral monoid algebra of the
multiplicative monoid of `ℂ`. Since the character determines a finite-dimensional module up to
isomorphism, this homomorphism is injective. Consequently `R(U_q)` is commutative, although the
category of modules carries no braiding here.

Every finite-dimensional module is a finite direct sum of signed ladder modules `L_m^ε`, and the
multiplicity of `L_m^ε` is read off the character. Hence the classes `[L_m^ε]`, for `m : ℕ` and
`ε = ±1`, form a `ℤ`-basis of `R(U_q)`, and the quantum Clebsch–Gordan decomposition becomes the
multiplication rule

`[L_m^ε] · [L_n^δ] = ∑_(j = 0)^(min m n) [L_(m + n - 2j)^(εδ)]`.

## Main definitions

* `TauCeti.UqSl2.repRing`: the representation ring of `U_q(sl₂)`.
* `TauCeti.UqSl2.repRingCharacter`: at a generic parameter, the character homomorphism
  `R(U_q) →+* ℤ[ℂ]`.
* `TauCeti.UqSl2.repRingBasis`: at a generic parameter, the `ℤ`-basis of classes of the signed
  ladder modules.

## Main results

* `TauCeti.UqSl2.repRingCharacter_of`: the character homomorphism sends the class of a module to
  its formal character.
* `TauCeti.UqSl2.repRingCharacter_of_of`: the same evaluation for the class of an unbundled
  module, in terms of its original instances.
* `TauCeti.UqSl2.repRingCharacter_injective`: the character homomorphism is injective.
* `TauCeti.UqSl2.repRing_mul_comm`: the representation ring is commutative.
* `TauCeti.UqSl2.repRingBasis_apply`: the basis vectors are the classes `[L_m^ε]`, and
  `TauCeti.UqSl2.repRingBasis_repr_of`: the coordinates of the class of a module are the
  multiplicities `dim Hom_U(L_m^ε, M)`.
* `TauCeti.UqSl2.of_ladderModule_mul_of_ladderModule`: the Clebsch–Gordan rule in the
  representation ring.

## References

* J. C. Jantzen, *Lectures on Quantum Groups*, Chapter 2, for the finite-dimensional
  representations of `U_q(sl₂)` and their characters.
* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Chapter VII, for the
  Clebsch–Gordan formula.
-/

public noncomputable section

open CategoryTheory MonoidalCategory

namespace TauCeti.UqSl2

open BialgebraModule

variable (q : ℂ) [Fact (q ≠ 0)]

/-- **The representation ring** of `U_q(sl₂)`: the split Grothendieck ring of the
finite-dimensional `UqSl2 q`-modules, with addition induced by the direct sum and multiplication
by the tensor product through the coproduct.

It is a name for `TauCeti.SplitK0` of `FiniteHopfModuleCat ℂ (UqSl2 q)`, so that
`TauCeti.SplitK0.of` is the class map and `TauCeti.SplitK0.of_mul_of` the rule
`[V] · [W] = [V ⊗ W]`. -/
abbrev repRing : Type := SplitK0.{0} (FiniteHopfModuleCat ℂ (UqSl2 q))

variable {q}

/-! ### The character of a categorical module -/

omit [Fact (q ≠ 0)] in
/-- The character of a categorical module is that of any module isomorphic to it. Unlike
`formalCharacter_congr`, the instances on `M` are those of the category, even when `M` is a
bundled module `FiniteHopfModuleCat.of V` whose carrier also has its original instances. -/
private theorem formalCharacter_of_linearEquiv {M : FiniteHopfModuleCat ℂ (UqSl2 q)} {V : Type}
    [AddCommGroup V] [Module ℂ V] [Module (UqSl2 q) V] [IsScalarTower ℂ (UqSl2 q) V]
    [FiniteDimensional ℂ V] (e : M ≃ₗ[UqSl2 q] V) : formalCharacter q M = formalCharacter q V :=
  formalCharacter_congr e

/-- The character of the trivial module, the tensor unit, is `1 = [1]`. -/
private theorem formalCharacter_tensorUnit :
    formalCharacter q (𝟙_ (FiniteHopfModuleCat ℂ (UqSl2 q))) = 1 := by
  refine (formalCharacter_congr (W := Trivial ℂ (UqSl2 q)) (.refl (UqSl2 q) _)).trans ?_
  -- The trivial module is one-dimensional, and `K` acts on it by `ε(K) = 1`.
  let b := (Module.Basis.singleton (Fin 1) ℂ).map (trivialEquiv ℂ (UqSl2 q)).symm
  rw [b.uqSl2FormalCharacter_eq_sum (fun _ => 1) fun i => mem_weightSpace_iff.mpr
    ((trivialEquiv ℂ (UqSl2 q)).injective (by simp [b, trivialEquiv_smul])),
    Fin.sum_univ_one, MonoidAlgebra.one_def]

/-- At a generic parameter, the character of a tensor product of modules is the product of their
characters. -/
private theorem formalCharacter_tensorObj (hq : IsGenericQuantumParameter q)
    (M N : FiniteHopfModuleCat ℂ (UqSl2 q)) :
    formalCharacter q (M ⊗ N : FiniteHopfModuleCat ℂ (UqSl2 q)) =
      formalCharacter q M * formalCharacter q N :=
  (formalCharacter_congr (W := Tensor ℂ (UqSl2 q) M N) (.refl (UqSl2 q) _)).trans
    (formalCharacter_tensor hq)

omit [Fact (q ≠ 0)] in
/-- The character of a biproduct of modules is the sum of their characters. -/
private theorem formalCharacter_biprod (M N : FiniteHopfModuleCat ℂ (UqSl2 q)) :
    formalCharacter q (M ⊞ N : FiniteHopfModuleCat ℂ (UqSl2 q)) =
      formalCharacter q M + formalCharacter q N :=
  (formalCharacter_congr (FiniteHopfModuleCat.isoToLinearEquiv
    (FiniteHopfModuleCat.biprodIsoProd M N))).trans
      ((formalCharacter_congr (W := M × N) (.refl (UqSl2 q) _)).trans formalCharacter_prod)

/-- The formal character as an invariant of the representation ring. -/
private def characterInvariant :
    SplitK0.AdditiveInvariant (FiniteHopfModuleCat ℂ (UqSl2 q)) (MonoidAlgebra ℤ ℂ) where
  obj M := formalCharacter q M
  map_iso _ _ e := formalCharacter_congr (FiniteHopfModuleCat.isoToLinearEquiv e)
  map_biprod := formalCharacter_biprod

/-! ### The character homomorphism -/

/-- **The character homomorphism of the representation ring**: at a generic parameter, the ring
homomorphism `R(U_q) →+* ℤ[ℂ]` sending the class of a finite-dimensional module to its formal
character. It is a homomorphism of rings because the character is multiplicative on tensor
products and takes the trivial module to `1`. -/
def repRingCharacter (hq : IsGenericQuantumParameter q) : repRing q →+* MonoidAlgebra ℤ ℂ :=
  SplitK0.liftRingHom characterInvariant formalCharacter_tensorUnit (formalCharacter_tensorObj hq)

/-- The character homomorphism sends the class of a module to its formal character. -/
@[simp]
theorem repRingCharacter_of (hq : IsGenericQuantumParameter q)
    (M : FiniteHopfModuleCat ℂ (UqSl2 q)) :
    repRingCharacter hq (SplitK0.of M) = formalCharacter q M :=
  SplitK0.liftRingHom_of _ _ _ M

/-- The character homomorphism sends the class of a finite-dimensional module `V`, bundled as an
object of the category, to the formal character of `V` computed with its original instances.
It has high simp priority so that it fires before `repRingCharacter_of`, which would leave the
character of `V` stated with the instances of the category. -/
@[simp high]
theorem repRingCharacter_of_of (hq : IsGenericQuantumParameter q) (V : Type)
    [AddCommGroup V] [Module ℂ V] [Module (UqSl2 q) V] [IsScalarTower ℂ (UqSl2 q) V]
    [FiniteDimensional ℂ V] :
    repRingCharacter hq (SplitK0.of (.of V)) = formalCharacter q V :=
  (repRingCharacter_of hq _).trans (formalCharacter_of_linearEquiv (.refl (UqSl2 q) V))

/-- **The character homomorphism is injective**: at a generic parameter, an element of the
representation ring is determined by its character. -/
theorem repRingCharacter_injective (hq : IsGenericQuantumParameter q) :
    Function.Injective (repRingCharacter hq) := by
  refine (injective_iff_map_eq_zero _).2 fun x hx => ?_
  obtain ⟨M, N, rfl⟩ := SplitK0.exists_eq_sub x
  rw [map_sub, repRingCharacter_of, repRingCharacter_of, sub_eq_zero,
    ← nonempty_linearEquiv_iff_formalCharacter_eq hq] at hx
  obtain ⟨e⟩ := hx
  rw [SplitK0.of_congr e.toFiniteHopfModuleCatIso, sub_self]

/-- **The representation ring is commutative** at a generic parameter, as it embeds in the
commutative ring `ℤ[ℂ]` by the character homomorphism. -/
theorem repRing_mul_comm (hq : IsGenericQuantumParameter q) (x y : repRing q) :
    x * y = y * x :=
  repRingCharacter_injective hq (by rw [map_mul, map_mul, mul_comm])

/-! ### The basis of signed ladder modules -/

/-- The class of a finite product of signed ladder modules is the sum of their classes. -/
private theorem repRing_of_pi_ladderModule (hq : IsGenericQuantumParameter q) {n : ℕ}
    (m : Fin n → ℕ) (ε : Fin n → ℤˣ) :
    (SplitK0.of (.of (Π i, LadderModule q (m i) (ε i))) : repRing q) =
      ∑ i, SplitK0.of (.of (LadderModule q (m i) (ε i))) :=
  repRingCharacter_injective hq (by
    simp only [map_sum, repRingCharacter_of_of, formalCharacter_pi])

/-- The multiplicity of `L_m^ε`, read off the character: at a generic parameter it takes the
class of `L_n^δ` to `1` if `(n, δ) = (m, ε)` and to `0` otherwise. -/
private def multiplicityHom (hq : IsGenericQuantumParameter q) (m : ℕ) (ε : ℤˣ) :
    repRing q →+ ℤ :=
  ((Finsupp.applyAddHom ((ε : ℂ) * q ^ m) - Finsupp.applyAddHom ((ε : ℂ) * q ^ (m + 2)) :
    (ℂ →₀ ℤ) →+ ℤ).comp MonoidAlgebra.coeffAddEquiv.toAddMonoidHom).comp
      (repRingCharacter hq).toAddMonoidHom

/-- The multiplicity of `L_m^ε` in `L_n^δ` is `1` if `(n, δ) = (m, ε)` and `0` otherwise. -/
private theorem multiplicityHom_of_ladderModule (hq : IsGenericQuantumParameter q) (m n : ℕ)
    (ε δ : ℤˣ) :
    multiplicityHom hq m ε (SplitK0.of (.of (LadderModule q n δ))) =
      if m = n ∧ ε = δ then 1 else 0 := by
  simp only [multiplicityHom, AddMonoidHom.comp_apply, AddMonoidHom.sub_apply,
    Finsupp.applyAddHom_apply, RingHom.toAddMonoidHom_eq_coe, AddMonoidHom.coe_ofClass,
    AddEquiv.toAddMonoidHom_eq_coe, MonoidAlgebra.coeffAddEquiv_apply, repRingCharacter_of_of]
  exact formalCharacter_ladderModule_coeff_sub hq n m δ ε

/-- At a generic parameter, the classes of the signed ladder modules are linearly independent. -/
private theorem linearIndependent_of_ladderModule (hq : IsGenericQuantumParameter q) :
    LinearIndependent ℤ fun p : ℕ × ℤˣ =>
      (SplitK0.of (.of (LadderModule q p.1 p.2)) : repRing q) := by
  refine linearIndependent_iff'.2 fun s g hg p hp => ?_
  -- Apply the multiplicity of `L_p` to the vanishing linear combination.
  have h := congrArg (multiplicityHom hq p.1 p.2) hg
  simp only [map_sum, map_zsmul, multiplicityHom_of_ladderModule, map_zero, smul_eq_mul,
    mul_ite, mul_one, mul_zero, ← Prod.ext_iff, Finset.sum_ite_eq, hp, ↓reduceIte] at h
  exact h

/-- At a generic parameter, the classes of the signed ladder modules span the representation
ring. -/
private theorem span_of_ladderModule (hq : IsGenericQuantumParameter q) :
    ⊤ ≤ Submodule.span ℤ (Set.range fun p : ℕ × ℤˣ =>
      (SplitK0.of (.of (LadderModule q p.1 p.2)) : repRing q)) := by
  rintro x -
  induction x using SplitK0.induction_on with
  | zero => exact zero_mem _
  | of M =>
    -- `M` is a finite product of signed ladder modules.
    obtain ⟨n, m, ε, ⟨e⟩⟩ := exists_linearEquiv_pi_ladderModule hq (V := M)
    have he : (SplitK0.of M : repRing q) = SplitK0.of (.of (Π i, LadderModule q (m i) (ε i))) :=
      SplitK0.of_congr (LinearEquiv.toFiniteHopfModuleCatIso (M := M) (N := .of _) e)
    rw [he, repRing_of_pi_ladderModule hq]
    exact Submodule.sum_mem _ fun i _ => Submodule.subset_span ⟨(m i, ε i), rfl⟩
  | add x y hx hy => exact add_mem hx hy
  | neg x hx => exact neg_mem hx

/-- **The basis of signed ladder modules**: at a generic parameter, the classes `[L_m^ε]` of the
signed ladder modules, for `m : ℕ` and `ε = ±1`, form a `ℤ`-basis of the representation ring. -/
def repRingBasis (hq : IsGenericQuantumParameter q) : Module.Basis (ℕ × ℤˣ) ℤ (repRing q) :=
  .mk (linearIndependent_of_ladderModule hq) (span_of_ladderModule hq)

/-- The basis vector indexed by `(m, ε)` is the class of `L_m^ε`. -/
@[simp]
theorem repRingBasis_apply (hq : IsGenericQuantumParameter q) (p : ℕ × ℤˣ) :
    repRingBasis hq p = SplitK0.of (.of (LadderModule q p.1 p.2)) :=
  Module.Basis.mk_apply _ _ _

/-- **The coordinates in the basis of signed ladder modules are read off the character**: the
coefficient of `[L_m^ε]` in `x` is the difference of the coefficients of the character of `x` at
`ε q^m` and at `ε q^(m+2)`. -/
theorem repRingBasis_repr_apply (hq : IsGenericQuantumParameter q) (x : repRing q) (m : ℕ)
    (ε : ℤˣ) :
    (repRingBasis hq).repr x (m, ε) =
      (repRingCharacter hq x).coeff (ε * q ^ m) -
        (repRingCharacter hq x).coeff (ε * q ^ (m + 2)) := by
  -- Both sides are additive in `x` and agree on the basis vectors.
  have h := (repRingBasis hq).ext
    (f₁ := Finsupp.lapply (m, ε) ∘ₗ (repRingBasis hq).repr.toLinearMap)
    (f₂ := (multiplicityHom hq m ε).toIntLinearMap) fun p => by
      simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
        Module.Basis.repr_self, Finsupp.lapply_apply, AddMonoidHom.coe_toIntLinearMap]
      rw [repRingBasis_apply, multiplicityHom_of_ladderModule, Finsupp.single_apply]
      simp [Prod.ext_iff, eq_comm]
  simpa [multiplicityHom] using LinearMap.congr_fun h x

/-- **The coordinates of a module are its multiplicities**: the coefficient of `[L_m^ε]` in the
class of a finite-dimensional module `M` is the dimension of `Hom_U(L_m^ε, M)`. -/
@[simp]
theorem repRingBasis_repr_of (hq : IsGenericQuantumParameter q)
    (M : FiniteHopfModuleCat ℂ (UqSl2 q)) (m : ℕ) (ε : ℤˣ) :
    (repRingBasis hq).repr (SplitK0.of M) (m, ε) =
      Module.finrank ℂ (LadderModule q m ε →ₗ[UqSl2 q] M) := by
  rw [repRingBasis_repr_apply, repRingCharacter_of,
    finrank_linearMap_ladderModule_eq_formalCharacter_coeff_sub hq]

/-- **The Clebsch–Gordan rule in the representation ring**: at a generic parameter,
`[L_m^ε] · [L_n^δ] = ∑_(j = 0)^(min m n) [L_(m + n - 2j)^(εδ)]`. -/
theorem of_ladderModule_mul_of_ladderModule (hq : IsGenericQuantumParameter q) (m n : ℕ)
    (ε δ : ℤˣ) :
    (SplitK0.of (.of (LadderModule q m ε)) : repRing q) * SplitK0.of (.of (LadderModule q n δ)) =
      ∑ j ∈ Finset.range (min m n + 1),
        SplitK0.of (.of (LadderModule q (m + n - 2 * j) (ε * δ))) := by
  refine repRingCharacter_injective hq ?_
  rw [map_mul, repRingCharacter_of_of, repRingCharacter_of_of,
    ← formalCharacter_tensor hq, ← formalCharacter_congr (clebschGordanEquiv hq),
    formalCharacter_pi, map_sum, ← Fin.sum_univ_eq_sum_range (fun j =>
      repRingCharacter hq (SplitK0.of (.of (LadderModule q (m + n - 2 * j) (ε * δ)))))]
  simp only [repRingCharacter_of_of]

end TauCeti.UqSl2
