module

public import TauCeti.QuantumGroups.UqSl2.Weights

import Mathlib.Tactic

/-!
# The Casimir element of U_q(sl₂)

This file defines the quantum Casimir element
`Ω = F E + (q K + q⁻¹ K⁻¹) / (q - q⁻¹)²` of `UqSl2 q`, proves that it also equals
`E F + (q⁻¹ K + q K⁻¹) / (q - q⁻¹)²`, and proves that it is central. These identities hold
for every complex parameter `q`.

On a vector of weight `μ` killed by `E`, the Casimir element acts by the scalar
`casimirScalar q μ = (q μ + q⁻¹ μ⁻¹) / (q - q⁻¹)²`, and by centrality it acts by the same
scalar on the cyclic submodule generated by such a vector. On a vector of weight `μ` killed by
`F` it acts by `casimirScalar q μ⁻¹`. For the signed highest weights `ε q^m`, with `m : ℕ`
and a sign `ε : ℤˣ`, the scalar is `ε (q^(m+1) + q^(-(m+1))) / (q - q⁻¹)²`, and at a generic
parameter these scalars are pairwise distinct. This is the input for splitting a
finite-dimensional module into generalized eigenspaces of the Casimir element, one for each
signed highest weight.

## Main definitions

* `TauCeti.UqSl2.casimir`: the Casimir element `Ω`.
* `TauCeti.UqSl2.casimirScalar`: the scalar by which `Ω` acts on a highest-weight vector.

## Main results

* `TauCeti.UqSl2.casimir_mem_center`: `Ω` is central.
* `TauCeti.UqSl2.casimir_smul_of_e_smul_eq_zero`: the action of `Ω` on a highest-weight vector.
* `TauCeti.UqSl2.casimirScalar_eq_casimirScalar_iff`: two nonzero weights have the same Casimir
  scalar exactly when they are equal or related by `μ ↦ q⁻² μ⁻¹`.
* `TauCeti.UqSl2.casimirScalar_units_mul_pow_inj`: at a generic parameter, the scalars of the
  signed highest weights `ε q^m` determine `m` and `ε`.

## References

* A. Virelizier, *Quantum groups*, Sections 2.3--2.4.
* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Section VI.4.
-/

public section

namespace TauCeti.UqSl2

variable {q : ℂ}

/-- The quantum Casimir element `Ω = F E + (q K + q⁻¹ K⁻¹) / (q - q⁻¹)²` of `UqSl2 q`. -/
noncomputable def casimir (q : ℂ) : UqSl2 q :=
  f q * e q + ((q - q⁻¹) ^ 2)⁻¹ • (q • k q + q⁻¹ • kInv q)

/-- The defining formula for the Casimir element. -/
theorem casimir_def :
    casimir q = f q * e q + ((q - q⁻¹) ^ 2)⁻¹ • (q • k q + q⁻¹ • kInv q) := by
  rw [casimir]

/-- The Casimir element in the opposite normal order:
`Ω = E F + (q⁻¹ K + q K⁻¹) / (q - q⁻¹)²`. -/
theorem casimir_eq_e_mul_f :
    casimir q = e q * f q + ((q - q⁻¹) ^ 2)⁻¹ • (q⁻¹ • k q + q • kInv q) := by
  rw [casimir_def, eq_add_of_sub_eq' (e_mul_f_sub_f_mul_e (q := q))]
  match_scalars
  · rfl
  all_goals
    rcases eq_or_ne (q - q⁻¹) 0 with hd | hd
    · simp [hd]
    · field_simp
      ring

/-- `K` commutes with the Casimir element. -/
private theorem commute_k_casimir : Commute (k q) (casimir q) := by
  have hfe : Commute (k q) (f q * e q) := by
    rcases eq_or_ne q 0 with rfl | hq
    · -- When `q = 0`, the relation `K E = q² E K` forces `E = 0`.
      have he : e (0 : ℂ) = 0 := by
        rw [← one_mul (e 0), ← kInv_mul_k, mul_assoc, k_mul_e]
        simp
      simp [he]
    · rw [Commute, SemiconjBy, ← mul_assoc]
      simp only [k_mul_f, k_mul_e, smul_mul_assoc, mul_smul_comm, smul_smul, mul_assoc]
      match_scalars
      field_simp
  have hkInv : Commute (k q) (kInv q) := by
    rw [Commute, SemiconjBy, k_mul_kInv, kInv_mul_k]
  rw [casimir_def]
  exact hfe.add_right (((Commute.refl _).smul_right q).add_right
    (hkInv.smul_right q⁻¹) |>.smul_right _)

/-- `E` commutes with the Casimir element. -/
private theorem commute_e_casimir : Commute (e q) (casimir q) := by
  rw [Commute, SemiconjBy, casimir_def, mul_add, add_mul, ← mul_assoc,
    eq_add_of_sub_eq' (e_mul_f_sub_f_mul_e (q := q))]
  simp only [add_mul, sub_mul, smul_mul_assoc, mul_add, mul_smul_comm, mul_assoc, k_mul_e,
    kInv_mul_e]
  match_scalars
  · rfl
  all_goals
    rcases eq_or_ne (q - q⁻¹) 0 with hd | hd
    · simp [hd]
    · have hq := ne_zero_of_sub_inv_ne_zero hd
      field_simp
      ring

/-- `F` commutes with the Casimir element. -/
private theorem commute_f_casimir : Commute (f q) (casimir q) := by
  have hfe : f q * e q = e q * f q - (q - q⁻¹)⁻¹ • (k q - kInv q) := by
    rw [← e_mul_f_sub_f_mul_e]
    abel
  rw [Commute, SemiconjBy, casimir_eq_e_mul_f, mul_add, add_mul, ← mul_assoc, hfe]
  simp only [add_mul, sub_mul, smul_mul_assoc, mul_add, mul_smul_comm, mul_assoc, k_mul_f,
    kInv_mul_f]
  match_scalars
  · rfl
  all_goals
    rcases eq_or_ne (q - q⁻¹) 0 with hd | hd
    · simp [hd]
    · have hq := ne_zero_of_sub_inv_ne_zero hd
      field_simp
      ring

/-- Every element of `UqSl2 q` commutes with the Casimir element. -/
theorem commute_casimir (a : UqSl2 q) : Commute a (casimir q) :=
  commute_of_commute_generators commute_e_casimir commute_f_casimir commute_k_casimir a

/-- The Casimir element is central in `UqSl2 q`. -/
theorem casimir_mem_center : casimir q ∈ Subalgebra.center ℂ (UqSl2 q) :=
  Subalgebra.mem_center_iff.mpr fun a => (commute_casimir a).eq

/-- The scalar `(q μ + q⁻¹ μ⁻¹) / (q - q⁻¹)²` by which the Casimir element acts on a vector of
weight `μ` killed by `E`. -/
noncomputable def casimirScalar (q μ : ℂ) : ℂ :=
  (q * μ + q⁻¹ * μ⁻¹) / (q - q⁻¹) ^ 2

/-- The defining formula for the Casimir scalar. -/
theorem casimirScalar_def (μ : ℂ) :
    casimirScalar q μ = (q * μ + q⁻¹ * μ⁻¹) / (q - q⁻¹) ^ 2 := by
  rw [casimirScalar]

section Module

variable {V : Type*} [AddCommGroup V] [Module ℂ V] [Module (UqSl2 q) V]
  [IsScalarTower ℂ (UqSl2 q) V] {μ : ℂ} {v : V}

/-- The Casimir element acts on a vector of weight `μ` killed by `E` by `casimirScalar q μ`. -/
theorem casimir_smul_of_e_smul_eq_zero (hv : v ∈ weightSpace q V μ) (he : e q • v = 0) :
    casimir q • v = casimirScalar q μ • v := by
  simp only [casimir_def, add_smul, mul_smul, he, smul_zero, zero_add, smul_assoc,
    mem_weightSpace_iff.mp hv, kInv_smul_of_mem_weightSpace hv, casimirScalar_def]
  module

/-- The Casimir element acts on a vector of weight `μ` killed by `F` by
`casimirScalar q μ⁻¹`. -/
theorem casimir_smul_of_f_smul_eq_zero (hv : v ∈ weightSpace q V μ) (hf : f q • v = 0) :
    casimir q • v = casimirScalar q μ⁻¹ • v := by
  simp only [casimir_eq_e_mul_f, add_smul, mul_smul, hf, smul_zero, zero_add, smul_assoc,
    mem_weightSpace_iff.mp hv, kInv_smul_of_mem_weightSpace hv, casimirScalar_def, inv_inv]
  module

/-- The Casimir element acts by `casimirScalar q μ` on the whole cyclic submodule generated by
a vector of weight `μ` killed by `E`. -/
theorem casimir_smul_smul_of_e_smul_eq_zero (hv : v ∈ weightSpace q V μ) (he : e q • v = 0)
    (a : UqSl2 q) : casimir q • a • v = casimirScalar q μ • a • v := by
  rw [← mul_smul, ← (commute_casimir a).eq, mul_smul, casimir_smul_of_e_smul_eq_zero hv he,
    smul_comm]

end Module

/-- The Casimir scalar of the signed highest weight `ε q^m` is
`ε (q^(m+1) + q^(-(m+1))) / (q - q⁻¹)²`. -/
theorem casimirScalar_units_mul_pow (ε : ℤˣ) (m : ℕ) :
    casimirScalar q (ε * q ^ m) = ε * (q ^ (m + 1) + q⁻¹ ^ (m + 1)) / (q - q⁻¹) ^ 2 := by
  have hε : ((ε : ℤ) : ℂ)⁻¹ = ε := by
    rcases Int.units_eq_one_or ε with rfl | rfl <;> norm_num
  rw [casimirScalar_def, mul_inv, hε, inv_pow]
  ring

/-- Two nonzero weights have the same Casimir scalar exactly when they are equal or related by
the reflection `μ ↦ q⁻² μ⁻¹`. -/
theorem casimirScalar_eq_casimirScalar_iff (hq : q - q⁻¹ ≠ 0) {μ ν : ℂ} (hμ : μ ≠ 0)
    (hν : ν ≠ 0) : casimirScalar q μ = casimirScalar q ν ↔ μ = ν ∨ q ^ 2 * μ * ν = 1 := by
  have hq0 := ne_zero_of_sub_inv_ne_zero hq
  rw [casimirScalar_def, casimirScalar_def, div_left_inj' (pow_ne_zero 2 hq)]
  -- Clearing denominators, the difference of the two sides factors as
  -- `(μ - ν) (q² μ ν - 1) / (q μ ν)`.
  have key : (q * μ + q⁻¹ * μ⁻¹) - (q * ν + q⁻¹ * ν⁻¹) =
      (μ - ν) * (q ^ 2 * μ * ν - 1) / (q * μ * ν) := by
    field_simp
    ring
  rw [← sub_eq_zero, key, div_eq_zero_iff, mul_eq_zero, mul_eq_zero, sub_eq_zero, sub_eq_zero]
  simp [hq0, hμ, hν]

/-- At a generic parameter, the Casimir scalars of the signed highest weights `ε q^m` are
pairwise distinct: they determine both `m` and the sign `ε`. -/
theorem casimirScalar_units_mul_pow_inj (hq : IsGenericQuantumParameter q) {m n : ℕ}
    {ε δ : ℤˣ} :
    casimirScalar q (ε * q ^ m) = casimirScalar q (δ * q ^ n) ↔ m = n ∧ ε = δ := by
  refine ⟨fun h => ?_, by rintro ⟨rfl, rfl⟩; rfl⟩
  have hunit (η : ℤˣ) : ((η : ℤ) : ℂ) ^ 2 = 1 := by
    rcases Int.units_eq_one_or η with rfl | rfl <;> norm_num
  have hne (η : ℤˣ) (r : ℕ) : (η : ℂ) * q ^ r ≠ 0 :=
    mul_ne_zero (by rcases Int.units_eq_one_or η with rfl | rfl <;> norm_num)
      (pow_ne_zero _ hq.ne_zero)
  rcases (casimirScalar_eq_casimirScalar_iff hq.sub_inv_ne_zero (hne ε m) (hne δ n)).mp h with
    h | h
  · -- Equal weights have equal squares `q^(2m) = q^(2n)`, so `m = n`, and then `ε = δ`.
    have hmn : m = n := by
      have h2 : q ^ (2 * m) = q ^ (2 * n) := by
        have := congrArg (· ^ 2) h
        simp only [mul_pow, hunit, one_mul, ← pow_mul, mul_comm _ 2] at this
        exact this
      have := hq.pow_injective h2
      omega
    subst hmn
    refine ⟨rfl, ?_⟩
    have hεδ : ((ε : ℤ) : ℂ) = ((δ : ℤ) : ℂ) := mul_right_cancel₀ (pow_ne_zero _ hq.ne_zero) h
    exact Units.val_injective (by exact_mod_cast hεδ)
  · -- Otherwise `q^(2 (m + n + 2)) = (ε δ)² = 1`, which a generic parameter forbids.
    refine (hq.pow_ne_one (n := 2 * (m + n + 2)) (by omega) ?_).elim
    have := congrArg (· ^ 2) h
    simp only [mul_pow, hunit, one_pow, one_mul] at this
    rw [← this]
    ring

end TauCeti.UqSl2
