/-!
# Submodules and simple quotients of the Verma modules of `U_q(sl₂)`

At a generic parameter `q` (nonzero and not a root of unity) and for a nonzero weight `μ`, this
file determines all submodules of the Verma module `M(μ)`.

The vectors `v_j = F^j v₀` form a basis of `M(μ)` on which `K` acts diagonally with the pairwise
distinct weights `q^(-2j) μ`, so a submodule contains every `v_j` occurring in one of its
elements. Since `F v_j = v_(j + 1)`, the indices of the `v_j` lying in a nonzero submodule `N`
form a final segment `{j | n ≤ j}`, and `N` is generated by `v_n`. Since `E v_n` is a multiple of
`v_(n - 1)`, which does not lie in `N`, the vector `v_n` is killed by `E`. Conversely, a vector
`v_n` killed by `E` induces an injective module map `M(q^(-2n) μ) → M(μ)` sending `v₀` to `v_n`,
whose image, the submodule generated by `v_n`, is spanned by the `v_j` with `n ≤ j`.

Combined with the singular-vector criterion `VermaModule.e_smul_vec_succ_eq_zero_iff`, this gives:

* if `μ` is not a signed highest weight `± q^m`, then `M(μ)` is simple;
* if `μ = ε q^m` for a sign `ε`, then the submodules of `M(μ)` are `0`, `M(μ)` and the submodule
  `N` generated by `v_(m + 1)`, which is isomorphic to `M(q^(-2(m + 1)) μ)`. The submodule `N` is
  maximal, and the simple quotient `M(ε q^m) ⧸ N` is isomorphic to the signed ladder module
  `L_m^ε`.

## Main definitions

* `TauCeti.UqSl2.VermaModule.singularMap`: the module map `M(q^(-2n) μ) → M(μ)` sending `v₀` to a
  vector `v_n` killed by `E`.
* `TauCeti.UqSl2.VermaModule.ladderModuleEquivQuotient`: at a generic parameter, the isomorphism
  `L_m^ε ≃ M(ε q^m) ⧸ N` sending `v₀` to the class of `v₀`.

## Main results

* `TauCeti.UqSl2.VermaModule.singularMap_injective`, `range_singularMap`: the map induced by
  `v_n` is injective, with image the submodule generated by `v_n`.
* `TauCeti.UqSl2.VermaModule.vec_mem_of_basis_repr_ne_zero`: at a generic parameter, a submodule
  of `M(μ)` contains every `v_j` occurring in one of its elements.
* `TauCeti.UqSl2.VermaModule.eq_bot_or_exists_eq_span_singleton_vec`: at a generic parameter,
  every nonzero submodule of `M(μ)` is generated by a vector `v_n` killed by `E`.
* `TauCeti.UqSl2.VermaModule.isSimpleModule_iff`: at a generic parameter, `M(μ)` is simple
  exactly when `μ² ≠ q^(2m)` for every `m`.
* `TauCeti.UqSl2.VermaModule.eq_bot_or_eq_span_singleton_vec_succ_or_eq_top` and
  `TauCeti.UqSl2.VermaModule.isCoatom_span_singleton_vec_succ`: the submodules of `M(ε q^m)`, and
  maximality of the one generated by `v_(m + 1)`.

## References

* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Section VI.3, for the Verma
  modules of `U_q(sl₂)`, their simplicity criterion and their finite-dimensional quotients.
* A. Virelizier, *Quantum groups*, Sections 2.3--2.4, for the rank-one convention used here.
-/

public noncomputable section

namespace TauCeti

namespace UqSl2

namespace VermaModule

open Submodule

variable {q μ : ℂ}

/-! ### Maps between Verma modules -/

section SingularMap

variable {n : ℕ} (he : e q • vec q μ n = 0)

/-- For a vector `v_n` of `M(μ)` killed by `E`, the module map `M(q^(-2n) μ) → M(μ)` sending `v₀`
to `v_n`. -/
def singularMap : VermaModule q ((q⁻¹ ^ 2) ^ n * μ) →ₗ[UqSl2 q] VermaModule q μ :=
  lift (vec_mem_weightSpace n) he

/-- The map induced by `v_n` sends `v_i` to `v_(i + n)`. -/
@[simp]
theorem singularMap_vec (i : ℕ) : singularMap he (vec _ _ i) = vec q μ (i + n) := by
  rw [singularMap, lift_vec, f_pow_smul_vec]

/-- The image of the map induced by `v_n` is the submodule generated by `v_n`. -/
theorem range_singularMap : LinearMap.range (singularMap he) = span (UqSl2 q) {vec q μ n} := by
  rw [LinearMap.range_eq_map, ← span_singleton_vec_zero, map_span, Set.image_singleton,
    singularMap_vec, zero_add]

/-- For nonzero `q` and `μ`, the map induced by `v_n` is injective. -/
theorem singularMap_injective (hq : q ≠ 0) (hμ : μ ≠ 0) : Function.Injective (singularMap he) := by
  refine LinearMap.injective_of_linearIndependent (f := (singularMap he).restrictScalars ℂ)
    span_vec_eq_top ?_
  have h : (singularMap he).restrictScalars ℂ ∘ vec q _ = vec q μ ∘ (· + n) :=
    funext (singularMap_vec he)
  rw [h]
  exact (linearIndependent_vec hq hμ).comp _ (add_left_injective n)

include he in
/-- For nonzero `q` and `μ`, the submodule generated by a vector `v_n` killed by `E` contains
exactly the `v_j` with `n ≤ j`. -/
theorem vec_mem_span_singleton_vec_iff (hq : q ≠ 0) (hμ : μ ≠ 0) {j : ℕ} :
    vec q μ j ∈ span (UqSl2 q) {vec q μ n} ↔ n ≤ j := by
  refine ⟨fun hj => ?_, fun hj => ?_⟩
  · -- The image of the map induced by `v_n` is spanned by the `v_i` with `n ≤ i`.
    have hle (x : VermaModule q ((q⁻¹ ^ 2) ^ n * μ)) :
        singularMap he x ∈ Submodule.span ℂ (vec q μ '' Set.Ici n) := by
      have hxs : x ∈ Submodule.span ℂ (Set.range (vec q _)) := span_vec_eq_top ▸ mem_top
      refine ((Submodule.image_span_subset ((singularMap he).restrictScalars ℂ) _ _).mpr ?_)
        ⟨x, hxs, rfl⟩
      rintro _ ⟨i, rfl⟩
      exact subset_span ⟨i + n, by simp, (singularMap_vec he i).symm⟩
    rw [← range_singularMap he] at hj
    obtain ⟨x, hx⟩ := hj
    have hmem := hle x
    rw [hx, ← coe_basis hq hμ, Module.Basis.mem_span_image, Module.Basis.repr_self,
      Finsupp.support_single _ one_ne_zero] at hmem
    simpa using hmem
  · rw [← Nat.sub_add_cancel hj, ← f_pow_smul_vec]
    exact smul_mem _ _ (mem_span_singleton_self _)

end SingularMap

/-! ### The submodules of a Verma module -/

/-- At a generic parameter and for nonzero `μ`, a submodule of `M(μ)` contains every vector `v_j`
occurring with a nonzero coefficient in one of its elements. -/
theorem vec_mem_of_basis_repr_ne_zero (hq : IsGenericQuantumParameter q) (hμ : μ ≠ 0)
    {N : Submodule (UqSl2 q) (VermaModule q μ)} {x : VermaModule q μ} (hx : x ∈ N) {j : ℕ}
    (hj : (basis hq.ne_zero hμ).repr x j ≠ 0) : vec q μ j ∈ N := by
  have h := (basis hq.ne_zero hμ).self_mem_of_repr_ne_zero
    (f := Algebra.lsmul ℂ ℂ (VermaModule q μ) (k q)) (a := fun j => (q⁻¹ ^ 2) ^ j * μ)
    (W := N.restrictScalars ℂ) (fun i => by simp)
    ((hq.inv.pow two_pos).pow_mul_injective hμ)
    (fun v hv => N.smul_mem (k q) hv) hx hj
  simpa using h

/-- A submodule of `M(μ)` containing `v_(j + 1)` contains `v_j`, unless `E` kills `v_(j + 1)`. -/
theorem vec_mem_of_vec_succ_mem {N : Submodule (UqSl2 q) (VermaModule q μ)} {j : ℕ}
    (hN : vec q μ (j + 1) ∈ N) (he : e q • vec q μ (j + 1) ≠ 0) : vec q μ j ∈ N := by
  have hmem := N.smul_mem (e q) hN
  rw [e_smul_vec_succ] at hmem he
  exact ((N.restrictScalars ℂ).smul_mem_iff (left_ne_zero_of_smul he)).mp hmem

/-- **The submodules of a Verma module.** At a generic parameter and for nonzero `μ`, every
nonzero submodule of `M(μ)` is generated by a vector `v_n` killed by `E`. -/
theorem eq_bot_or_exists_eq_span_singleton_vec (hq : IsGenericQuantumParameter q) (hμ : μ ≠ 0)
    (N : Submodule (UqSl2 q) (VermaModule q μ)) :
    N = ⊥ ∨ ∃ n, e q • vec q μ n = 0 ∧ N = span (UqSl2 q) {vec q μ n} := by
  classical
  refine or_iff_not_imp_left.mpr fun hN => ?_
  -- Some `v_j` lies in `N`; let `v_n` be the first one.
  have hex : ∃ n, vec q μ n ∈ N := by
    obtain ⟨x, hx, hx0⟩ := exists_mem_ne_zero_of_ne_bot hN
    obtain ⟨j, hj⟩ := Finsupp.ne_iff.mp ((basis hq.ne_zero hμ).repr.map_ne_zero_iff.mpr hx0)
    exact ⟨j, vec_mem_of_basis_repr_ne_zero hq hμ hx hj⟩
  have hn : vec q μ (Nat.find hex) ∈ N := Nat.find_spec hex
  have hmin (j : ℕ) (hj : vec q μ j ∈ N) : Nat.find hex ≤ j := Nat.find_min' hex hj
  have he : e q • vec q μ (Nat.find hex) = 0 := by
    rcases h : Nat.find hex with _ | j
    · exact e_smul_vec_zero
    · -- Otherwise `v_j` would lie in `N`, contradicting minimality.
      by_contra hne
      rw [h] at hn
      have := hmin j (vec_mem_of_vec_succ_mem hn hne)
      omega
  refine ⟨Nat.find hex, he, le_antisymm (fun x hx => ?_) ((span_singleton_le_iff_mem _ _).mpr hn)⟩
  -- Every `v_j` occurring in `x` lies in `N`, so `Nat.find hex ≤ j`.
  rw [← (basis hq.ne_zero hμ).linearCombination_repr x, Finsupp.linearCombination_apply,
    Finsupp.sum]
  refine sum_mem fun j hj => ?_
  rw [coe_basis]
  exact smul_of_tower_mem _ _ ((vec_mem_span_singleton_vec_iff he hq.ne_zero hμ).mpr
    (hmin j (vec_mem_of_basis_repr_ne_zero hq hμ hx (Finsupp.mem_support_iff.mp hj))))

/-- **Simplicity of Verma modules.** At a generic parameter and for nonzero `μ`, the Verma module
`M(μ)` is simple exactly when `μ² ≠ q^(2m)` for every `m`, that is, when `μ` is not a signed
highest weight `± q^m`. -/
theorem isSimpleModule_iff (hq : IsGenericQuantumParameter q) (hμ : μ ≠ 0) :
    IsSimpleModule (UqSl2 q) (VermaModule q μ) ↔ ∀ m : ℕ, μ ^ 2 ≠ q ^ (2 * m) := by
  refine ⟨fun hs m hm => ?_, fun h => ?_⟩
  · -- The submodule generated by the singular vector `v_(m + 1)` is neither `0` nor `M(μ)`.
    have he := (e_smul_vec_succ_eq_zero_iff hq hμ m).mpr hm
    rcases IsSimpleOrder.eq_bot_or_eq_top (span (UqSl2 q) {vec q μ (m + 1)}) with h0 | h1
    · exact vec_ne_zero hq.ne_zero hμ (m + 1) (span_singleton_eq_bot.mp h0)
    · have := (vec_mem_span_singleton_vec_iff he hq.ne_zero hμ (j := 0)).mp (h1 ▸ mem_top)
      omega
  · have : Nontrivial (VermaModule q μ) := ⟨⟨vec q μ 0, 0, vec_ne_zero hq.ne_zero hμ 0⟩⟩
    refine { eq_bot_or_eq_top := fun N => ?_ }
    obtain hN | ⟨n, he, rfl⟩ := eq_bot_or_exists_eq_span_singleton_vec hq hμ N
    · exact .inl hN
    · rcases n with _ | m
      · exact .inr (span_singleton_vec_zero q μ)
      · exact absurd ((e_smul_vec_succ_eq_zero_iff hq hμ m).mp he) (h m)

/-! ### Verma modules with a signed highest weight -/

section Signed

variable {m : ℕ} {ε : ℤˣ}

/-- The vector `v_(m + 1)` of `M(ε q^m)` is killed by `E`. -/
theorem e_smul_vec_succ_eq_zero : e q • vec q (ε * q ^ m) (m + 1) = 0 := by
  have hε : ((ε : ℤ) : ℂ)⁻¹ = ε := by
    rcases Int.units_eq_one_or ε with rfl | rfl <;> simp
  have h : q⁻¹ ^ m * (ε * q ^ m) - q ^ m * (ε * q ^ m : ℂ)⁻¹ = 0 := by
    rw [mul_inv, hε, inv_pow]
    ring
  rw [e_smul_vec_succ, h, mul_zero, zero_div, zero_smul]

/-- For nonzero `q`, the highest vector `v₀` of `M(ε q^m)` does not lie in the submodule generated
by `v_(m + 1)`. -/
private theorem vec_zero_notMem_span_singleton_vec_succ (hq : q ≠ 0) :
    vec q (ε * q ^ m) 0 ∉ span (UqSl2 q) {vec q (ε * q ^ m) (m + 1)} := by
  rw [vec_mem_span_singleton_vec_iff e_smul_vec_succ_eq_zero hq (by simp [hq])]
  omega

/-- **The submodules of `M(ε q^m)`.** At a generic parameter, the only submodules of `M(ε q^m)` are
`0`, the submodule generated by `v_(m + 1)`, and `M(ε q^m)` itself. -/
theorem eq_bot_or_eq_span_singleton_vec_succ_or_eq_top (hq : IsGenericQuantumParameter q)
    (N : Submodule (UqSl2 q) (VermaModule q (ε * q ^ m))) :
    N = ⊥ ∨ N = span (UqSl2 q) {vec q (ε * q ^ m) (m + 1)} ∨ N = ⊤ := by
  obtain hN | ⟨n, he, rfl⟩ :=
    eq_bot_or_exists_eq_span_singleton_vec hq (by simp [hq.ne_zero]) N
  · exact .inl hN
  · rcases n with _ | j
    · exact .inr (.inr (span_singleton_vec_zero _ _))
    · -- The singular-vector criterion forces `q^(2m) = q^(2j)`, so `j = m`.
      have h := (e_smul_vec_succ_eq_zero_iff hq (by simp [hq.ne_zero]) j).mp he
      rw [mul_pow, Int.cast_units_sq, one_mul, ← pow_mul, mul_comm] at h
      obtain rfl : m = j := by
        have := hq.pow_injective h
        omega
      exact .inr (.inl rfl)

/-- At a generic parameter, the submodule of `M(ε q^m)` generated by `v_(m + 1)` is a maximal
submodule. -/
theorem isCoatom_span_singleton_vec_succ (hq : IsGenericQuantumParameter q) :
    IsCoatom (span (UqSl2 q) {vec q (ε * q ^ m) (m + 1)}) := by
  refine ⟨fun h => vec_zero_notMem_span_singleton_vec_succ hq.ne_zero (h ▸ mem_top),
    fun P hP => ?_⟩
  rcases eq_bot_or_eq_span_singleton_vec_succ_or_eq_top hq P with rfl | rfl | rfl
  · exact absurd hP not_lt_bot
  · exact absurd hP (lt_irrefl _)
  · rfl

/-! ### The simple quotient -/

variable (q m ε) in
/-- The submodule of `M(ε q^m)` generated by `v_(m + 1)`. -/
private abbrev singularSpan : Submodule (UqSl2 q) (VermaModule q (ε * q ^ m)) :=
  span (UqSl2 q) {vec q (ε * q ^ m) (m + 1)}

/-- The class of `v₀` in `M(ε q^m) ⧸ N` has weight `ε q^m`. -/
private theorem mk_vec_zero_mem_weightSpace :
    (Submodule.Quotient.mk (vec q (ε * q ^ m) 0) : _ ⧸ singularSpan q m ε) ∈
      weightSpace q (_ ⧸ singularSpan q m ε) (ε * q ^ m) :=
  mem_weightSpace_iff.mpr <| by
    rw [← Submodule.Quotient.mk_smul, k_smul_vec_zero, Submodule.Quotient.mk_smul]

/-- The class of `v₀` in `M(ε q^m) ⧸ N` is killed by `E`. -/
private theorem e_smul_mk_vec_zero :
    e q • (Submodule.Quotient.mk (vec q (ε * q ^ m) 0) : _ ⧸ singularSpan q m ε) = 0 := by
  rw [← Submodule.Quotient.mk_smul, e_smul_vec_zero, Submodule.Quotient.mk_zero]

/-- The class of `v₀` in `M(ε q^m) ⧸ N` is killed by `F^(m + 1)`. -/
private theorem f_pow_smul_mk_vec_zero :
    f q ^ (m + 1) • (Submodule.Quotient.mk (vec q (ε * q ^ m) 0) : _ ⧸ singularSpan q m ε) =
      0 := by
  rw [← Submodule.Quotient.mk_smul, f_pow_smul_vec, add_zero, Submodule.Quotient.mk_eq_zero]
  exact mem_span_singleton_self _

variable [Fact (q ≠ 0)]

/-- At a generic parameter, the module map `L_m^ε → M(ε q^m) ⧸ N` sending `v₀` to the class of
`v₀` is bijective. -/
private theorem bijective_lift_mk_vec_zero (hq : IsGenericQuantumParameter q) :
    Function.Bijective (LadderModule.lift hq (mk_vec_zero_mem_weightSpace (m := m) (ε := ε))
      e_smul_mk_vec_zero f_pow_smul_mk_vec_zero) := by
  refine ⟨LadderModule.lift_injective hq _ _ _ <| (Submodule.Quotient.mk_eq_zero _).not.mpr <|
    vec_zero_notMem_span_singleton_vec_succ hq.ne_zero, ?_⟩
  -- The quotient is generated by the class of `v₀`, which lies in the image.
  have htop := congrArg (Submodule.map (singularSpan q m ε).mkQ)
    (span_singleton_vec_zero q (ε * q ^ m))
  rw [map_span, Set.image_singleton, Submodule.map_top, range_mkQ, mkQ_apply] at htop
  refine LinearMap.range_eq_top.mp (eq_top_iff.mpr ?_)
  rw [← htop, span_singleton_le_iff_mem]
  exact ⟨LadderModule.vec q m ε 0, LadderModule.lift_vec_zero ..⟩

/-- **The simple quotient of `M(ε q^m)`.** At a generic parameter, the quotient of `M(ε q^m)` by
the submodule generated by `v_(m + 1)` is isomorphic to the signed ladder module `L_m^ε`, by the
module map sending `v₀` to the class of `v₀`. -/
def ladderModuleEquivQuotient (hq : IsGenericQuantumParameter q) :
    LadderModule q m ε ≃ₗ[UqSl2 q]
      VermaModule q (ε * q ^ m) ⧸ span (UqSl2 q) {vec q (ε * q ^ m) (m + 1)} :=
  LinearEquiv.ofBijective _ (bijective_lift_mk_vec_zero hq)

/-- The isomorphism `L_m^ε ≃ M(ε q^m) ⧸ N` sends `v₀` to the class of `v₀`. -/
@[simp]
theorem ladderModuleEquivQuotient_vec_zero (hq : IsGenericQuantumParameter q) :
    ladderModuleEquivQuotient hq (LadderModule.vec q m ε 0) =
      Submodule.Quotient.mk (vec q (ε * q ^ m) 0) :=
  LadderModule.lift_vec_zero ..

/-- The inverse isomorphism `M(ε q^m) ⧸ N ≃ L_m^ε` sends the class of `v₀` to `v₀`. -/
@[simp]
theorem ladderModuleEquivQuotient_symm_mk_vec_zero (hq : IsGenericQuantumParameter q) :
    (ladderModuleEquivQuotient hq).symm (Submodule.Quotient.mk (vec q (ε * q ^ m) 0)) =
      LadderModule.vec q m ε 0 :=
  (LinearEquiv.symm_apply_eq _).mpr (ladderModuleEquivQuotient_vec_zero hq).symm

end Signed

end VermaModule

end UqSl2

