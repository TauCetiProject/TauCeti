/-!
# Verma modules of `U_q(sl₂)`

For complex numbers `q` and `μ`, the Verma module `M(μ)` of `UqSl2 q` is the quotient of
`UqSl2 q` by the left ideal generated by `E` and `K - μ`. The class `v₀` of `1` is a vector of
weight `μ` killed by `E`, and `M(μ)` is the universal module generated by such a vector: for every
vector `v` of weight `μ` killed by `E` in a `UqSl2 q`-module there is a unique module map
`M(μ) → V` sending `v₀` to `v`.

Writing `v_j = F^j v₀`, the action of the generators is

* `F v_j = v_(j + 1)`,
* `K v_j = q^(-2j) μ v_j` and `K⁻¹ v_j = q^(2j) μ⁻¹ v_j`,
* `E v₀ = 0` and `E v_(j + 1) = [j + 1]_q (q^(-j) μ - q^j μ⁻¹) / (q - q⁻¹) v_j`,

where `[r]_q` is the symmetric quantum integer. When `q` and `μ` are nonzero, the vectors `v_j`
form a basis of `M(μ)`.

The coefficient of `E` shows where `M(μ)` acquires singular vectors: at a generic parameter,
`E v_(j + 1) = 0` exactly when `μ² = q^(2j)`, that is, when `μ = ± q^j` is the highest weight of
one of the signed simple modules `L_j^±`. In that case `v_(j + 1)` is a vector of weight
`q^(-2(j + 1)) μ` killed by `E` inside `M(μ)`.

## Main definitions

* `TauCeti.UqSl2.vermaIdeal q μ`: the left ideal generated by `E` and `K - μ`.
* `TauCeti.UqSl2.VermaModule q μ`: the Verma module `M(μ)`.
* `TauCeti.UqSl2.VermaModule.vec q μ j`: the vector `v_j = F^j v₀`.
* `TauCeti.UqSl2.VermaModule.lift`: the module map determined by a vector of weight `μ` killed
  by `E`.
* `TauCeti.UqSl2.VermaModule.basis`: the basis `(v_j)_(j ∈ ℕ)`, for nonzero `q` and `μ`.

## Main results

* `TauCeti.UqSl2.VermaModule.e_smul_vec_succ`, `f_smul_vec`, `k_smul_vec`, `kInv_smul_vec`:
  the action of the generators.
* `TauCeti.UqSl2.VermaModule.lift_vec_zero`, `TauCeti.UqSl2.VermaModule.hom_ext`: the universal
  property.
* `TauCeti.UqSl2.VermaModule.span_singleton_vec_zero`: `M(μ)` is generated by `v₀`.
* `TauCeti.UqSl2.VermaModule.span_vec_eq_top`, `linearIndependent_vec`: the vectors `v_j` span
  `M(μ)`, and are linearly independent for nonzero `q` and `μ`.
* `TauCeti.UqSl2.VermaModule.e_smul_vec_succ_eq_zero_iff`: the singular-vector criterion.

## References

* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Section VI.3, for the Verma
  modules of `U_q(sl₂)` and the action of the generators on the lowering string.
* A. Virelizier, *Quantum groups*, Sections 2.3--2.4, for the rank-one convention used here.
-/

public noncomputable section

namespace TauCeti

namespace UqSl2

variable {q : ℂ}

/-- The left ideal of `UqSl2 q` generated by `E` and `K - μ`. -/
def vermaIdeal (q μ : ℂ) : Submodule (UqSl2 q) (UqSl2 q) :=
  Submodule.span (UqSl2 q) {e q, k q - algebraMap ℂ (UqSl2 q) μ}

/-- The raising generator lies in the Verma ideal. -/
theorem e_mem_vermaIdeal (μ : ℂ) : e q ∈ vermaIdeal q μ :=
  Submodule.subset_span (.inl rfl)

/-- The weight relation `K - μ` lies in the Verma ideal. -/
theorem k_sub_algebraMap_mem_vermaIdeal (μ : ℂ) :
    k q - algebraMap ℂ (UqSl2 q) μ ∈ vermaIdeal q μ :=
  Submodule.subset_span (.inr rfl)

/-- The Verma module `M(μ)` of `UqSl2 q`: the quotient of `UqSl2 q` by the left ideal generated
by `E` and `K - μ`. -/
def VermaModule (q μ : ℂ) : Type :=
  UqSl2 q ⧸ vermaIdeal q μ

namespace VermaModule

instance (q μ : ℂ) : AddCommGroup (VermaModule q μ) :=
  inferInstanceAs (AddCommGroup (UqSl2 q ⧸ vermaIdeal q μ))

instance (q μ : ℂ) : Module (UqSl2 q) (VermaModule q μ) :=
  inferInstanceAs (Module (UqSl2 q) (UqSl2 q ⧸ vermaIdeal q μ))

instance (q μ : ℂ) : Module ℂ (VermaModule q μ) :=
  inferInstanceAs (Module ℂ (UqSl2 q ⧸ vermaIdeal q μ))

instance (q μ : ℂ) : IsScalarTower ℂ (UqSl2 q) (VermaModule q μ) :=
  inferInstanceAs (IsScalarTower ℂ (UqSl2 q) (UqSl2 q ⧸ vermaIdeal q μ))

variable {μ : ℂ}

variable (q μ) in
/-- The quotient map `UqSl2 q → M(μ)`. -/
def mk : UqSl2 q →ₗ[UqSl2 q] VermaModule q μ :=
  (vermaIdeal q μ).mkQ

/-- Every vector of `M(μ)` is the class of an element of `UqSl2 q`. -/
theorem mk_surjective : Function.Surjective (mk q μ) :=
  Submodule.mkQ_surjective _

/-- The class of an element of `UqSl2 q` vanishes exactly when it lies in the Verma ideal. -/
@[simp]
theorem mk_eq_zero_iff {a : UqSl2 q} : mk q μ a = 0 ↔ a ∈ vermaIdeal q μ :=
  Submodule.Quotient.mk_eq_zero _

variable (q μ) in
/-- The vector `v_j = F^j v₀` of `M(μ)`, where `v₀` is the class of `1`. -/
def vec (j : ℕ) : VermaModule q μ :=
  mk q μ (f q ^ j)

/-- The class of `a` is `a v₀`. -/
theorem mk_eq_smul_vec_zero (a : UqSl2 q) : mk q μ a = a • vec q μ 0 := by
  rw [vec, pow_zero, ← map_smul, smul_eq_mul, mul_one]

/-- The vector `v_j` is `F^j v₀`. -/
theorem vec_eq_f_pow_smul (j : ℕ) : vec q μ j = f q ^ j • vec q μ 0 := by
  rw [← mk_eq_smul_vec_zero, vec]

variable (q μ) in
/-- The Verma module `M(μ)` is generated by its highest vector `v₀`. -/
theorem span_singleton_vec_zero : Submodule.span (UqSl2 q) {vec q μ 0} = ⊤ :=
  Submodule.eq_top_iff'.mpr fun x => by
    obtain ⟨a, rfl⟩ := mk_surjective x
    exact Submodule.mem_span_singleton.mpr ⟨a, (mk_eq_smul_vec_zero a).symm⟩

/-- The action of the powers of `F`: `F^n v_j = v_(n + j)`. -/
theorem f_pow_smul_vec (n j : ℕ) : f q ^ n • vec q μ j = vec q μ (n + j) := by
  rw [vec, vec, ← map_smul, smul_eq_mul, pow_add]

/-- The action of `F`: `F v_j = v_(j + 1)`. -/
@[simp]
theorem f_smul_vec (j : ℕ) : f q • vec q μ j = vec q μ (j + 1) := by
  simpa [add_comm] using f_pow_smul_vec (q := q) (μ := μ) 1 j

/-- The highest vector is killed by `E`. -/
@[simp]
theorem e_smul_vec_zero : e q • vec q μ 0 = 0 := by
  rw [← mk_eq_smul_vec_zero, mk_eq_zero_iff]
  exact e_mem_vermaIdeal μ

/-- The highest vector has weight `μ`. -/
theorem k_smul_vec_zero : k q • vec q μ 0 = μ • vec q μ 0 := by
  rw [← sub_eq_zero, ← mk_eq_smul_vec_zero, ← algebraMap_smul (UqSl2 q) μ (vec q μ 0),
    ← mk_eq_smul_vec_zero, ← map_sub, mk_eq_zero_iff]
  exact k_sub_algebraMap_mem_vermaIdeal μ

/-- The action of `K⁻¹` on the highest vector. -/
theorem kInv_smul_vec_zero : kInv q • vec q μ 0 = μ⁻¹ • vec q μ 0 := by
  rcases eq_or_ne μ 0 with rfl | hμ
  · -- For `μ = 0` the highest vector is `K⁻¹ K v₀ = 0`.
    have h : vec q 0 0 = 0 := by
      rw [← one_smul (UqSl2 q) (vec q 0 0), ← kInv_mul_k, mul_smul, k_smul_vec_zero, zero_smul,
        smul_zero]
    rw [h, smul_zero, smul_zero]
  · calc kInv q • vec q μ 0 = μ⁻¹ • kInv q • μ • vec q μ 0 := by
          rw [smul_comm (kInv q) μ, inv_smul_smul₀ hμ]
      _ = μ⁻¹ • vec q μ 0 := by rw [← k_smul_vec_zero, ← mul_smul, kInv_mul_k, one_smul]

/-- The action of `K`: `K v_j = q^(-2j) μ v_j`. -/
@[simp]
theorem k_smul_vec (j : ℕ) : k q • vec q μ j = ((q⁻¹ ^ 2) ^ j * μ) • vec q μ j := by
  rw [vec_eq_f_pow_smul, ← mul_smul, k_mul_f_pow, smul_assoc, mul_smul, k_smul_vec_zero,
    smul_comm (f q ^ j) μ, smul_smul]

/-- The action of `K⁻¹`: `K⁻¹ v_j = q^(2j) μ⁻¹ v_j`. -/
@[simp]
theorem kInv_smul_vec (j : ℕ) : kInv q • vec q μ j = ((q ^ 2) ^ j * μ⁻¹) • vec q μ j := by
  rw [vec_eq_f_pow_smul, ← mul_smul, kInv_mul_f_pow, smul_assoc, mul_smul, kInv_smul_vec_zero,
    smul_comm (f q ^ j) μ⁻¹, smul_smul]

/-- The vector `v_j` has weight `q^(-2j) μ`. -/
theorem vec_mem_weightSpace (j : ℕ) :
    vec q μ j ∈ weightSpace q (VermaModule q μ) ((q⁻¹ ^ 2) ^ j * μ) :=
  mem_weightSpace_iff.mpr (k_smul_vec j)

/-- The action of `E`: `E v_(j + 1) = [j + 1]_q (q^(-j) μ - q^j μ⁻¹) / (q - q⁻¹) v_j`. -/
@[simp]
theorem e_smul_vec_succ (j : ℕ) :
    e q • vec q μ (j + 1) =
      (quantumInteger q (j + 1) * (q⁻¹ ^ j * μ - q ^ j * μ⁻¹) / (q - q⁻¹)) • vec q μ j := by
  rcases eq_or_ne (q - q⁻¹) 0 with hq | hq
  · -- At `q = ±1` the generators `E` and `F` commute, and both sides vanish.
    have hc : Commute (e q) (f q) := by
      have h := e_mul_f_sub_f_mul_e (q := q)
      rwa [hq, inv_zero, zero_smul, sub_eq_zero] at h
    rw [vec_eq_f_pow_smul, ← mul_smul, (hc.pow_right _).eq, mul_smul, e_smul_vec_zero, smul_zero,
      hq, div_zero, zero_smul]
  · have hX : (q⁻¹ ^ j • k q - q ^ j • kInv q) • vec q μ 0 =
        (q⁻¹ ^ j * μ - q ^ j * μ⁻¹) • vec q μ 0 := by
      rw [sub_smul, smul_assoc, smul_assoc, k_smul_vec_zero, kInv_smul_vec_zero, smul_smul,
        smul_smul, sub_smul]
    rw [vec_eq_f_pow_smul, ← mul_smul, e_mul_f_pow hq, add_smul, mul_smul, e_smul_vec_zero,
      smul_zero, zero_add, Nat.add_sub_cancel, smul_assoc, mul_smul (f q ^ j), hX,
      smul_comm (f q ^ j), ← vec_eq_f_pow_smul, smul_smul]
    congr 1
    push_cast
    ring

/-! ### Spanning -/

/-- The vectors `v_j` span `M(μ)`. -/
theorem span_vec_eq_top : Submodule.span ℂ (Set.range (vec q μ)) = ⊤ := by
  set W := Submodule.span ℂ (Set.range (vec q μ))
  have hvec (j : ℕ) : vec q μ j ∈ W := Submodule.subset_span ⟨j, rfl⟩
  -- A generator `g` preserves `W` as soon as it sends each `v_j` into `W`.
  have hgen (g : UqSl2 q) (h : ∀ j, g • vec q μ j ∈ W) (x : VermaModule q μ) (hx : x ∈ W) :
      g • x ∈ W := by
    have hle : W ≤ W.comap (Algebra.lsmul ℂ ℂ (VermaModule q μ) g) :=
      Submodule.span_le.mpr (Set.range_subset_iff.mpr h)
    exact hle hx
  have hW (a : UqSl2 q) : a • vec q μ 0 ∈ W := by
    refine W.smul_mem_of_uqSl2_generators (hgen _ fun j => ?_) (hgen _ fun j => ?_)
      (hgen _ fun j => ?_) (hgen _ fun j => ?_) a (hvec 0)
    · rcases j with _ | j
      · rw [e_smul_vec_zero]
        exact W.zero_mem
      · rw [e_smul_vec_succ]
        exact W.smul_mem _ (hvec j)
    · rw [f_smul_vec]
      exact hvec (j + 1)
    · rw [k_smul_vec]
      exact W.smul_mem _ (hvec j)
    · rw [kInv_smul_vec]
      exact W.smul_mem _ (hvec j)
  refine Submodule.eq_top_iff'.mpr fun x => ?_
  obtain ⟨a, rfl⟩ := mk_surjective x
  rw [mk_eq_smul_vec_zero]
  exact hW a

/-! ### The universal property -/

section Lift

variable {V : Type*} [AddCommGroup V] [Module ℂ V] [Module (UqSl2 q) V]
  [IsScalarTower ℂ (UqSl2 q) V]

/-- The `UqSl2 q`-module map `M(μ) → V` determined by a vector `v` of weight `μ` killed by `E`.
It sends `v₀` to `v`. -/
def lift {v : V} (hv : v ∈ weightSpace q V μ) (he : e q • v = 0) :
    VermaModule q μ →ₗ[UqSl2 q] V :=
  (vermaIdeal q μ).liftQ (LinearMap.toSpanSingleton (UqSl2 q) V v) <| by
    rw [vermaIdeal, Submodule.span_le]
    rintro a (rfl | rfl)
    · exact he
    · simp [sub_smul, mem_weightSpace_iff.mp hv]

variable {v : V} (hv : v ∈ weightSpace q V μ) (he : e q • v = 0)

/-- The map induced by `v` sends the class of `a` to `a v`. -/
@[simp]
theorem lift_mk (a : UqSl2 q) : lift hv he (mk q μ a) = a • v :=
  Submodule.liftQ_apply _ _ _

/-- The map induced by `v` sends `v_j` to `F^j v`. -/
theorem lift_vec (j : ℕ) : lift hv he (vec q μ j) = f q ^ j • v :=
  lift_mk hv he _

/-- The map induced by `v` sends the highest vector `v₀` to `v`. -/
@[simp]
theorem lift_vec_zero : lift hv he (vec q μ 0) = v := by
  rw [lift_vec, pow_zero, one_smul]

omit [Module ℂ V] [IsScalarTower ℂ (UqSl2 q) V] in
/-- A `UqSl2 q`-module map out of `M(μ)` is determined by its value at the highest vector `v₀`. -/
theorem hom_ext {φ ψ : VermaModule q μ →ₗ[UqSl2 q] V}
    (h : φ (vec q μ 0) = ψ (vec q μ 0)) : φ = ψ := by
  refine LinearMap.ext fun x => ?_
  obtain ⟨a, rfl⟩ := mk_surjective x
  rw [mk_eq_smul_vec_zero, map_smul, map_smul, h]

end Lift

/-! ### Linear independence

For nonzero `q` and `μ`, the vectors `v_j` are linearly independent, so together with spanning
they form a basis of `M(μ)`. -/

section Model

-- The action formulas define a `UqSl2 q`-action on `ℕ →₀ ℂ` in which `v_j` corresponds to the
-- standard basis vector `single j 1`; the induced map out of `M(μ)` detects independence.

/-- The coefficient of `E v_(j + 1)` on `v_j`. -/
private def eCoeff (q μ : ℂ) (j : ℕ) : ℂ :=
  quantumInteger q (j + 1) * (q⁻¹ ^ j * μ - q ^ j * μ⁻¹) / (q - q⁻¹)

/-- The coefficient of `E v₁` on `v₀` is `(μ - μ⁻¹) / (q - q⁻¹)`. -/
private theorem eCoeff_zero (q μ : ℂ) : eCoeff q μ 0 = (q - q⁻¹)⁻¹ * (μ - μ⁻¹) := by
  rcases eq_or_ne (q - q⁻¹) 0 with hq | hq
  · simp [eCoeff, hq]
  · simp [eCoeff, quantumInteger_one hq, div_eq_inv_mul]

/-- Consecutive coefficients of `E` differ by the scalar of `(K - K⁻¹) / (q - q⁻¹)`. -/
private theorem eCoeff_succ_sub (q μ : ℂ) (j : ℕ) :
    eCoeff q μ (j + 1) - eCoeff q μ j =
      (q - q⁻¹)⁻¹ * ((q⁻¹ ^ 2) ^ (j + 1) * μ - (q ^ 2) ^ (j + 1) * μ⁻¹) := by
  rcases eq_or_ne (q - q⁻¹) 0 with hq | hq
  · simp [eCoeff, hq]
  have hq0 : q ≠ 0 := by
    rintro rfl
    simp at hq
  have h2 : q ^ 2 - 1 ≠ 0 := by
    intro h
    apply hq
    field_simp
    linear_combination h
  -- Express everything through `x = q ^ j` and `ν = μ⁻¹`, and clear denominators. The two
  -- powers on the right are first rewritten in terms of `q ^ j`, so that `generalize` can
  -- replace every occurrence of `q ^ j`.
  have hinv : (q⁻¹ ^ 2) ^ (j + 1) = q⁻¹ ^ 2 * (q ^ j)⁻¹ ^ 2 := by ring
  have hpow : (q ^ 2) ^ (j + 1) = q ^ 2 * (q ^ j) ^ 2 := by ring
  rw [hinv, hpow]
  simp only [eCoeff, quantumInteger_def, Nat.cast_add, Nat.cast_one, neg_add, zpow_add₀ hq0,
    zpow_neg, zpow_natCast, zpow_one, inv_pow, pow_succ]
  have hx : q ^ j ≠ 0 := pow_ne_zero _ hq0
  generalize q ^ j = x at hx ⊢
  generalize μ⁻¹ = ν
  field_simp
  ring

/-- The standard basis vector `single j 1` of `ℕ →₀ ℂ`. -/
private abbrev unitVec (j : ℕ) : ℕ →₀ ℂ := Finsupp.single j 1

/-- The values of the model operator of `E` on the basis vectors. -/
private def eVec (q μ : ℂ) : ℕ → ℕ →₀ ℂ
  | 0 => 0
  | j + 1 => eCoeff q μ j • unitVec j

/-- The model operator of `E`. -/
private def eOp (q μ : ℂ) : Module.End ℂ (ℕ →₀ ℂ) :=
  Finsupp.linearCombination ℂ (eVec q μ)

/-- The model operator of `F`. -/
private def fOp : Module.End ℂ (ℕ →₀ ℂ) :=
  Finsupp.linearCombination ℂ fun j => unitVec (j + 1)

/-- The model operator of `K`. -/
private def kOp (q μ : ℂ) : Module.End ℂ (ℕ →₀ ℂ) :=
  Finsupp.linearCombination ℂ fun j => ((q⁻¹ ^ 2) ^ j * μ) • unitVec j

/-- The model operator of `K⁻¹`. -/
private def kInvOp (q μ : ℂ) : Module.End ℂ (ℕ →₀ ℂ) :=
  Finsupp.linearCombination ℂ fun j => ((q ^ 2) ^ j * μ⁻¹) • unitVec j

private theorem eOp_zero : eOp q μ (unitVec 0) = 0 := by
  simp [eOp, eVec]

private theorem eOp_succ (j : ℕ) : eOp q μ (unitVec (j + 1)) = eCoeff q μ j • unitVec j := by
  simp [eOp, eVec]

private theorem fOp_unitVec (j : ℕ) : fOp (unitVec j) = unitVec (j + 1) := by
  simp [fOp]

private theorem kOp_unitVec (j : ℕ) :
    kOp q μ (unitVec j) = ((q⁻¹ ^ 2) ^ j * μ) • unitVec j := by
  simp [kOp]

private theorem kInvOp_unitVec (j : ℕ) :
    kInvOp q μ (unitVec j) = ((q ^ 2) ^ j * μ⁻¹) • unitVec j := by
  simp [kInvOp]

/-- Endomorphisms of `ℕ →₀ ℂ` agreeing on the basis vectors are equal. -/
private theorem end_ext {T U : Module.End ℂ (ℕ →₀ ℂ)} (h : ∀ j, T (unitVec j) = U (unitVec j)) :
    T = U :=
  Finsupp.basisSingleOne.ext fun j => by simpa using h j

/-- The model operators satisfy the defining relations of `UqSl2 q`. -/
private def tuple (hq : q ≠ 0) (hμ : μ ≠ 0) : GeneratorTuple q (Module.End ℂ (ℕ →₀ ℂ)) where
  e := eOp q μ
  f := fOp
  k := kOp q μ
  kInv := kInvOp q μ
  k_mul_kInv := end_ext fun j => by
    simp only [Module.End.mul_apply, kOp_unitVec, kInvOp_unitVec, map_smul, smul_smul,
      Module.End.one_apply]
    rw [mul_mul_mul_comm, ← mul_pow, ← mul_pow, mul_inv_cancel₀ hq, one_pow, one_pow, one_mul,
      inv_mul_cancel₀ hμ, one_smul]
  kInv_mul_k := end_ext fun j => by
    simp only [Module.End.mul_apply, kOp_unitVec, kInvOp_unitVec, map_smul, smul_smul,
      Module.End.one_apply]
    rw [mul_mul_mul_comm, ← mul_pow, ← mul_pow, inv_mul_cancel₀ hq, one_pow, one_pow, one_mul,
      mul_inv_cancel₀ hμ, one_smul]
  k_mul_e := end_ext fun j => by
    rcases j with _ | j
    · simp only [Module.End.mul_apply, LinearMap.smul_apply, kOp_unitVec, map_smul, eOp_zero,
        smul_zero, map_zero]
    · simp only [Module.End.mul_apply, LinearMap.smul_apply, eOp_succ, kOp_unitVec, map_smul,
        smul_smul]
      congr 1
      rw [pow_succ (q⁻¹ ^ 2) j]
      field_simp
  k_mul_f := end_ext fun j => by
    simp only [Module.End.mul_apply, LinearMap.smul_apply, fOp_unitVec, kOp_unitVec, map_smul,
      smul_smul]
    congr 1
    ring
  e_mul_f_sub_f_mul_e := end_ext fun j => by
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, Module.End.mul_apply, fOp_unitVec,
      kOp_unitVec, kInvOp_unitVec, ← sub_smul, smul_smul]
    rcases j with _ | j
    · rw [eOp_succ, eOp_zero, map_zero, sub_zero, eCoeff_zero]
      congr 1
      ring
    · rw [eOp_succ, eOp_succ, map_smul, fOp_unitVec, ← sub_smul, eCoeff_succ_sub]

/-- The model action of `UqSl2 q` on `ℕ →₀ ℂ`. -/
private def rep (hq : q ≠ 0) (hμ : μ ≠ 0) : UqSl2 q →ₐ[ℂ] Module.End ℂ (ℕ →₀ ℂ) :=
  UqSl2.lift (tuple hq hμ)

private theorem rep_e (hq : q ≠ 0) (hμ : μ ≠ 0) : rep hq hμ (e q) = eOp q μ :=
  (UqSl2.lift_generator (tuple hq hμ) .e).trans (GeneratorTuple.toFun_e _)

private theorem rep_f (hq : q ≠ 0) (hμ : μ ≠ 0) : rep hq hμ (f q) = fOp :=
  (UqSl2.lift_generator (tuple hq hμ) .f).trans (GeneratorTuple.toFun_f _)

private theorem rep_k (hq : q ≠ 0) (hμ : μ ≠ 0) : rep hq hμ (k q) = kOp q μ :=
  (UqSl2.lift_generator (tuple hq hμ) .k).trans (GeneratorTuple.toFun_k _)

private theorem rep_f_pow (hq : q ≠ 0) (hμ : μ ≠ 0) (j : ℕ) :
    rep hq hμ (f q ^ j) (unitVec 0) = unitVec j := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [pow_succ', map_mul, Module.End.mul_apply, ih, rep_f, fOp_unitVec]

/-- The Verma ideal acts trivially on `single 0 1` in the model. -/
private theorem rep_unitVec_zero_eq_zero (hq : q ≠ 0) (hμ : μ ≠ 0) {a : UqSl2 q}
    (ha : a ∈ vermaIdeal q μ) : rep hq hμ a (unitVec 0) = 0 := by
  induction ha using Submodule.span_induction with
  | mem a ha =>
    rcases ha with rfl | rfl
    · rw [rep_e, eOp_zero]
    · rw [map_sub, LinearMap.sub_apply, rep_k, kOp_unitVec, AlgHom.commutes,
        Module.algebraMap_end_apply, pow_zero, one_mul, sub_self]
  | zero => simp
  | add a c _ _ ha hc => rw [map_add, LinearMap.add_apply, ha, hc, add_zero]
  | smul a c _ hc => rw [smul_eq_mul, map_mul, Module.End.mul_apply, hc, map_zero]

/-- The complex-linear map `M(μ) → ℕ →₀ ℂ` sending the class of `a` to the image of
`single 0 1` under the model action of `a`. -/
private def toModel (hq : q ≠ 0) (hμ : μ ≠ 0) : VermaModule q μ →ₗ[ℂ] ℕ →₀ ℂ :=
  ((vermaIdeal q μ).restrictScalars ℂ).liftQ
      (LinearMap.applyₗ (unitVec 0) ∘ₗ (rep hq hμ).toLinearMap)
      (fun _ ha => rep_unitVec_zero_eq_zero hq hμ ha) ∘ₗ
    (Submodule.Quotient.restrictScalarsEquiv ℂ (vermaIdeal q μ)).symm.toLinearMap

-- Both `restrictScalarsEquiv` and `liftQ` compute on classes by definition.
private theorem toModel_mk (hq : q ≠ 0) (hμ : μ ≠ 0) (a : UqSl2 q) :
    toModel hq hμ (mk q μ a) = rep hq hμ a (unitVec 0) := (rfl)

private theorem toModel_vec (hq : q ≠ 0) (hμ : μ ≠ 0) (j : ℕ) :
    toModel hq hμ (vec q μ j) = unitVec j :=
  (toModel_mk hq hμ _).trans (rep_f_pow hq hμ j)

/-- For nonzero `q` and `μ`, the vectors `v_j` are linearly independent. -/
theorem linearIndependent_vec (hq : q ≠ 0) (hμ : μ ≠ 0) : LinearIndependent ℂ (vec q μ) := by
  refine LinearIndependent.of_comp (toModel hq hμ) ?_
  convert (Finsupp.basisSingleOne : Module.Basis ℕ ℂ (ℕ →₀ ℂ)).linearIndependent
  ext1 j
  simp [toModel_vec]

end Model

/-! ### The basis -/

/-- For nonzero `q` and `μ`, the basis `(v_j)_(j ∈ ℕ)` of `M(μ)`, where `v_j = F^j v₀`. -/
def basis (hq : q ≠ 0) (hμ : μ ≠ 0) : Module.Basis ℕ ℂ (VermaModule q μ) :=
  .mk (linearIndependent_vec hq hμ) span_vec_eq_top.ge

/-- The basis vectors of `M(μ)` are the vectors `v_j`. -/
@[simp]
theorem coe_basis (hq : q ≠ 0) (hμ : μ ≠ 0) : ⇑(basis hq hμ) = vec q μ :=
  Module.Basis.coe_mk _ _

/-- For nonzero `q` and `μ`, every vector `v_j` is nonzero. -/
theorem vec_ne_zero (hq : q ≠ 0) (hμ : μ ≠ 0) (j : ℕ) : vec q μ j ≠ 0 :=
  (linearIndependent_vec hq hμ).ne_zero j

/-! ### Singular vectors -/

/-- The singular-vector criterion: at a generic parameter and for nonzero `μ`, the vector
`v_(j + 1)` is killed by `E` exactly when `μ² = q^(2j)`. -/
theorem e_smul_vec_succ_eq_zero_iff (hq : IsGenericQuantumParameter q) (hμ : μ ≠ 0) (j : ℕ) :
    e q • vec q μ (j + 1) = 0 ↔ μ ^ 2 = q ^ (2 * j) := by
  have hq0 := hq.ne_zero
  rw [e_smul_vec_succ, smul_eq_zero, or_iff_left (vec_ne_zero hq0 hμ j),
    div_eq_zero_iff, or_iff_left hq.sub_inv_ne_zero, mul_eq_zero,
    or_iff_right (quantumInteger_ne_zero hq (by omega)), sub_eq_zero, inv_pow, pow_mul']
  have hx : q ^ j ≠ 0 := pow_ne_zero _ hq0
  generalize q ^ j = x at hx ⊢
  constructor <;> intro h <;> field_simp at h ⊢ <;> linear_combination h

end VermaModule

end UqSl2

end TauCeti
