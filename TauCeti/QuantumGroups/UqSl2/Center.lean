/-!
# The center of `U_q(sl₂)`

At a generic parameter `q` (nonzero and not a root of unity), the center of `UqSl2 q` is the
polynomial algebra `ℂ[Ω]` generated by the Casimir element `Ω`.

The proof is a leading-coefficient reduction in the PBW basis `F ^ a * K ^ b * E ^ c`.

* Conjugation by `K` multiplies `F ^ a * K ^ b * E ^ c` by `q ^ (2 (c - a))`, so an element
  commuting with `K` only involves monomials with `a = c`.
* Commuting `E` past `F ^ a * K ^ b * E ^ c` produces `q ^ (-2 b) F ^ a K ^ b E ^ (c + 1)`
  plus monomials whose `E`-exponent is still `c`. Comparing coefficients of the monomials with
  the largest `E`-exponent `n`, an element commuting with `E` has no monomial
  `F ^ a * K ^ b * E ^ n` with `b ≠ 0`.
* The same computation shows that `Ω ^ n` has `E`-exponents at most `n` and coefficient `1` on
  `F ^ n * E ^ n`. Subtracting a multiple of `Ω ^ n` from a central element lowers its largest
  `E`-exponent, and induction finishes the proof.

The same leading coefficients show that the powers of `Ω` are linearly independent, so `Ω` is
transcendental over `ℂ` for every nonzero `q`.

## Main results

* `TauCeti.UqSl2.pbwBasis_repr_eq_zero_of_commute_k`: at a generic parameter, an element
  commuting with `K` has no PBW monomial `F ^ a * K ^ b * E ^ c` with `a ≠ c`.
* `TauCeti.UqSl2.transcendental_casimir`: the Casimir element is transcendental over `ℂ`.
* `TauCeti.UqSl2.center_eq_adjoin_casimir`: at a generic parameter, the center of `UqSl2 q` is
  the subalgebra generated by the Casimir element.
* `TauCeti.UqSl2.polynomialAlgEquivCenter`: the resulting isomorphism `ℂ[X] ≃ₐ[ℂ] Z(U_q(sl₂))`
  sending `X` to `Ω`.

## References

* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Section VI.4, for the
  description of the center at a generic parameter; Kassel argues through the Harish-Chandra
  homomorphism instead of the leading-coefficient reduction used here.
-/

public noncomputable section

open Polynomial

namespace TauCeti.UqSl2

variable {q : ℂ} [Fact (q ≠ 0)]

/-! ### Commuting with `K` -/

/-- Conjugation by `K` is the rescaling automorphism with parameter `q²`. -/
private theorem toAlgEquiv_conjAct_kUnit :
    MulSemiringAction.toAlgEquiv ℂ (UqSl2 q) (ConjAct.toConjAct (kUnit q)) =
      rescale q (Units.mk0 q Fact.out ^ 2) := by
  apply AlgEquiv.coe_toAlgHom_injective
  apply hom_ext
  · simp [ConjAct.units_smul_def, k_mul_e, mul_assoc, smul_smul, sq]
  · simp [ConjAct.units_smul_def, k_mul_f, mul_assoc, smul_smul, sq]
  · simp [ConjAct.units_smul_def, mul_assoc]
  · simp [ConjAct.units_smul_def]

/-- Conjugation by an integer power of `K` rescales `E`. -/
private theorem kUnit_zpow_mul_e_mul_inv (b : ℤ) :
    ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) * e q * ((kUnit q ^ b)⁻¹ : (UqSl2 q)ˣ) =
      q ^ (2 * b) • e q := by
  have h : MulSemiringAction.toAlgAut (ConjAct (UqSl2 q)ˣ) ℂ (UqSl2 q)
      (ConjAct.toConjAct (kUnit q ^ b)) = rescale q ((Units.mk0 q Fact.out ^ 2) ^ b) := by
    rw [map_zpow, map_zpow, MulSemiringAction.toAlgAut_apply, toAlgEquiv_conjAct_kUnit,
      map_zpow]
  have he := congrArg (fun φ : UqSl2 q ≃ₐ[ℂ] UqSl2 q => φ (e q)) h
  simp only [MulSemiringAction.toAlgAut_apply, MulSemiringAction.toAlgEquiv_apply,
    ConjAct.units_smul_def, ConjAct.ofConjAct_toConjAct, rescale_e] at he
  rw [he, Units.val_zpow_eq_zpow_val, Units.val_pow_eq_pow_val, Units.val_mk0, ← zpow_natCast,
    ← zpow_mul]
  norm_num

/-- Commuting `E` past an integer power of `K` multiplies by `q ^ (-2b)`. -/
private theorem e_mul_kUnit_zpow (b : ℤ) :
    e q * ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) =
      q ^ (-2 * b) • (((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) * e q) := by
  have h := kUnit_zpow_mul_e_mul_inv (q := q) (-b)
  rw [zpow_neg, inv_inv] at h
  have hconj : e q * ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) =
      ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) *
        (((kUnit q ^ b)⁻¹ : (UqSl2 q)ˣ) * e q * ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q)) := by
    rw [mul_assoc, Units.mul_inv_cancel_left]
  rw [hconj, h, mul_smul_comm, mul_neg, neg_mul]

omit [Fact (q ≠ 0)] in
/-- Multiplying an integer power of `K` by `K` on the left raises the exponent by one. -/
private theorem k_mul_kUnit_zpow (b : ℤ) :
    k q * ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) =
      ((kUnit q ^ (b + 1) : (UqSl2 q)ˣ) : UqSl2 q) := by
  rw [← kUnit_val, ← Units.val_mul, add_comm, zpow_one_add]

omit [Fact (q ≠ 0)] in
/-- Multiplying an integer power of `K` by `K⁻¹` on the left lowers the exponent by one. -/
private theorem kInv_mul_kUnit_zpow (b : ℤ) :
    kInv q * ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) =
      ((kUnit q ^ (b - 1) : (UqSl2 q)ˣ) : UqSl2 q) := by
  rw [← kUnit_inv, ← Units.val_mul, ← zpow_neg_one, ← zpow_add, neg_add_eq_sub]

/-- **Weight-zero reduction.** At a generic parameter, an element commuting with `K` has no PBW
monomial `F ^ a * K ^ b * E ^ c` with `a ≠ c`. -/
theorem pbwBasis_repr_eq_zero_of_commute_k (hq : IsGenericQuantumParameter q) {z : UqSl2 q}
    (hz : Commute (k q) z) {a : ℕ} {b : ℤ} {c : ℕ} (hac : a ≠ c) :
    (pbwBasis q).repr z (a, b, c) = 0 := by
  set t : ℂˣ := Units.mk0 q Fact.out ^ 2
  -- `rescale q t` is conjugation by `K`, so it fixes `z`; it multiplies the PBW monomial
  -- `F ^ a * K ^ b * E ^ c` by `t⁻ᵃ tᶜ`.
  have hfix : rescale q t z = z := by
    rw [← toAlgEquiv_conjAct_kUnit, MulSemiringAction.toAlgEquiv_apply,
      ConjAct.units_smul_def, ConjAct.ofConjAct_toConjAct, kUnit_val, hz.eq, mul_assoc,
      kUnit_inv, k_mul_kInv, mul_one]
  have hcoord : ((pbwBasis q).coord (a, b, c)).comp (rescale q t).toLinearMap =
      (((t⁻¹ : ℂˣ) : ℂ) ^ a * (t : ℂ) ^ c) • (pbwBasis q).coord (a, b, c) := by
    refine (pbwBasis q).ext fun ⟨a', b', c'⟩ => ?_
    simp only [LinearMap.comp_apply, AlgEquiv.toLinearMap_apply, pbwBasis_apply,
      rescale_orderedMonomial, LinearMap.smul_apply]
    rw [← pbwBasis_apply, map_smul, Module.Basis.coord_apply, Module.Basis.repr_self]
    by_cases h : (a', b', c') = (a, b, c)
    · simp only [Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      simp
    · simp [h]
  have h := LinearMap.congr_fun hcoord z
  simp only [LinearMap.comp_apply, AlgEquiv.toLinearMap_apply, hfix, LinearMap.smul_apply,
    Module.Basis.coord_apply, smul_eq_mul] at h
  by_contra hne
  have hs := (mul_eq_right₀ hne).mp h.symm
  apply hac
  simp only [t, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val, Units.val_mk0, inv_pow] at hs
  rw [inv_mul_eq_one₀ (pow_ne_zero _ (pow_ne_zero _ Fact.out)), ← pow_mul, ← pow_mul] at hs
  have := hq.pow_injective hs
  omega

/-! ### Raising the `E`-exponent -/

omit [Fact (q ≠ 0)] in
/-- Commuting `E` past a positive power of `F` leaves a correction `F ^ n (α K + β K⁻¹)`. -/
private theorem exists_e_mul_f_pow_succ (n : ℕ) : ∃ α β : ℂ,
    e q * f q ^ (n + 1) = f q ^ (n + 1) * e q + f q ^ n * (α • k q + β • kInv q) := by
  rcases eq_or_ne (q - q⁻¹) 0 with hq | hq
  · -- At `q = ±1` the defining relation makes `E` and `F` commute.
    have hef : Commute (e q) (f q) := by
      have := e_mul_f_sub_f_mul_e (q := q)
      rw [hq, inv_zero, zero_smul, sub_eq_zero] at this
      exact this
    exact ⟨0, 0, by simp [(hef.pow_right (n + 1)).eq]⟩
  · refine ⟨quantumInteger q (n + 1) * (q - q⁻¹)⁻¹ * q⁻¹ ^ n,
      -(quantumInteger q (n + 1) * (q - q⁻¹)⁻¹ * q ^ n), ?_⟩
    rw [e_mul_f_pow hq, Nat.add_sub_cancel]
    simp only [mul_add, mul_sub, mul_smul_comm, smul_sub, smul_smul, neg_smul, mul_neg,
      Nat.cast_add, Nat.cast_one]
    abel

/-- Left multiplication by `E` raises the `E`-exponent of a PBW monomial by one, with leading
coefficient `q ^ (-2b)`, up to monomials with the same `E`-exponent. -/
private theorem e_mul_pbwBasis_sub_mem (a : ℕ) (b : ℤ) (c : ℕ) :
    e q * pbwBasis q (a, b, c) - q ^ (-2 * b) • pbwBasis q (a, b, c + 1) ∈
      Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}) := by
  cases a with
  | zero =>
    convert Submodule.zero_mem _
    rw [sub_eq_zero]
    simp only [pbwBasis_apply, pow_zero, one_mul, ← mul_assoc, e_mul_kUnit_zpow, smul_mul_assoc,
      pow_succ']
  | succ n =>
    obtain ⟨α, β, h⟩ := exists_e_mul_f_pow_succ (q := q) n
    have key : e q * pbwBasis q (n + 1, b, c) = q ^ (-2 * b) • pbwBasis q (n + 1, b, c + 1) +
        (α • pbwBasis q (n, b + 1, c) + β • pbwBasis q (n, b - 1, c)) := by
      simp only [pbwBasis_apply]
      rw [← mul_assoc, ← mul_assoc, h]
      simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, mul_assoc, e_mul_kUnit_zpow,
        k_mul_kUnit_zpow, kInv_mul_kUnit_zpow, pow_succ']
    rw [key, add_sub_cancel_left]
    exact add_mem (Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_image_of_mem _ rfl)))
      (Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_image_of_mem _ rfl)))

/-- Left multiplication by `F` raises the `F`-exponent of a PBW monomial by one. -/
private theorem f_mul_pbwBasis (a : ℕ) (b : ℤ) (c : ℕ) :
    f q * pbwBasis q (a, b, c) = pbwBasis q (a + 1, b, c) := by
  simp only [pbwBasis_apply, pow_succ', mul_assoc]

/-- Left multiplication by the Casimir element raises the `E`-exponent of a PBW monomial by one,
sending `F ^ a * K ^ b * E ^ c` to `q ^ (-2b) F ^ (a + 1) * K ^ b * E ^ (c + 1)` up to
monomials with the same `E`-exponent `c`. -/
private theorem casimir_mul_pbwBasis_sub_mem (a : ℕ) (b : ℤ) (c : ℕ) :
    casimir q * pbwBasis q (a, b, c) - q ^ (-2 * b) • pbwBasis q (a + 1, b, c + 1) ∈
      Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}) := by
  have hmem (i : ℕ × ℤ × ℕ) (hi : i.2.2 = c) :
      pbwBasis q i ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}) :=
    Submodule.subset_span (Set.mem_image_of_mem _ hi)
  have hf {x : UqSl2 q} (hx : x ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c})) :
      f q * x ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}) :=
    (Submodule.span_le (p := (Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c})).comap
      (LinearMap.mulLeft ℂ (f q)))).mpr (by
        rintro _ ⟨⟨a', b', c'⟩, hi, rfl⟩
        rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply, f_mul_pbwBasis]
        exact hmem _ hi) hx
  have hk : k q * pbwBasis q (a, b, c) = (q⁻¹ ^ 2) ^ a • pbwBasis q (a, b + 1, c) := by
    simp only [pbwBasis_apply, ← mul_assoc, k_mul_f_pow, smul_mul_assoc]
    simp only [mul_assoc, k_mul_kUnit_zpow]
  have hkInv : kInv q * pbwBasis q (a, b, c) = (q ^ 2) ^ a • pbwBasis q (a, b - 1, c) := by
    simp only [pbwBasis_apply, ← mul_assoc, kInv_mul_f_pow, smul_mul_assoc]
    simp only [mul_assoc, kInv_mul_kUnit_zpow]
  have key : casimir q * pbwBasis q (a, b, c) - q ^ (-2 * b) • pbwBasis q (a + 1, b, c + 1) =
      f q * (e q * pbwBasis q (a, b, c) - q ^ (-2 * b) • pbwBasis q (a, b, c + 1)) +
        ((q - q⁻¹) ^ 2)⁻¹ • (q • (k q * pbwBasis q (a, b, c)) +
          q⁻¹ • (kInv q * pbwBasis q (a, b, c))) := by
    rw [casimir_def, mul_sub, mul_smul_comm, f_mul_pbwBasis]
    simp only [add_mul, smul_mul_assoc, mul_assoc]
    abel
  rw [key, hk, hkInv]
  exact add_mem (hf (e_mul_pbwBasis_sub_mem a b c)) (Submodule.smul_mem _ _ (add_mem
    (Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (hmem _ rfl)))
    (Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (hmem _ rfl)))))

/-- Let `ψ` be a linear endomorphism sending each PBW monomial `F ^ a * K ^ b * E ^ c` to
`s b • F ^ (a + d) * K ^ b * E ^ (c + 1)` modulo monomials with `E`-exponent `c`. If the
`E`-exponents of `x` are at most `n`, then those of `ψ x` are at most `n + 1`, and the
coordinates of `ψ x` with `E`-exponent `n + 1` are read off from those of `x` with `E`-exponent
`n`. -/
private theorem pbwBasis_repr_of_raise {ψ : UqSl2 q →ₗ[ℂ] UqSl2 q} {d : ℕ} {s : ℤ → ℂ}
    (hψ : ∀ a b c, ψ (pbwBasis q (a, b, c)) - s b • pbwBasis q (a + d, b, c + 1) ∈
      Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}))
    {x : UqSl2 q} {n : ℕ} (hx : ∀ i ∈ ((pbwBasis q).repr x).support, i.2.2 ≤ n) :
    (∀ i ∈ ((pbwBasis q).repr (ψ x)).support, i.2.2 ≤ n + 1) ∧
      ∀ a b, (pbwBasis q).repr (ψ x) (a + d, b, n + 1) = s b * (pbwBasis q).repr x (a, b, n) := by
  have hxs : x ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 ≤ n}) :=
    (pbwBasis q).mem_span_image.mpr fun i hi => hx i hi
  -- Each `ψ (F ^ a * K ^ b * E ^ c)` splits as its leading monomial plus a remainder.
  have hsplit (a : ℕ) (b : ℤ) (c : ℕ) : ∃ y ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}),
      ψ (pbwBasis q (a, b, c)) = s b • pbwBasis q (a + d, b, c + 1) + y :=
    ⟨_, hψ a b c, (add_sub_cancel _ _).symm⟩
  constructor
  · suffices ψ x ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 ≤ n + 1}) from
      fun i hi => (pbwBasis q).mem_span_image.mp this hi
    refine (Submodule.span_le (p := (Submodule.span ℂ (pbwBasis q '' {i | i.2.2 ≤ n + 1})).comap
      ψ)).mpr ?_ hxs
    rintro _ ⟨⟨a, b, c⟩, hc, rfl⟩
    obtain ⟨y, hy, hψy⟩ := hsplit a b c
    rw [SetLike.mem_coe, Submodule.mem_comap, hψy]
    refine add_mem (Submodule.smul_mem _ _ (Submodule.subset_span
      (Set.mem_image_of_mem _ (by simpa using hc)))) ?_
    have hc : c ≤ n := hc
    refine Submodule.span_mono (Set.image_mono ?_) hy
    intro i (hi : i.2.2 = c)
    exact (show i.2.2 ≤ n + 1 by omega)
  · intro a b
    let ℓ : UqSl2 q →ₗ[ℂ] ℂ :=
      ((pbwBasis q).coord (a + d, b, n + 1)).comp ψ - s b • (pbwBasis q).coord (a, b, n)
    suffices ℓ x = 0 by simpa [ℓ, sub_eq_zero] using this
    refine (Submodule.span_le (p := LinearMap.ker ℓ)).mpr ?_ hxs
    rintro _ ⟨⟨a', b', c⟩, hc, rfl⟩
    obtain ⟨y, hy, hψy⟩ := hsplit a' b' c
    have hy0 : (pbwBasis q).repr y (a + d, b, n + 1) = 0 :=
      Finsupp.notMem_support_iff.mp fun h => by
        have h1 : n + 1 = c := (pbwBasis q).mem_span_image.mp hy h
        have h2 : c ≤ n := hc
        omega
    simp only [SetLike.mem_coe, LinearMap.mem_ker, ℓ, LinearMap.sub_apply, LinearMap.comp_apply,
      LinearMap.smul_apply, Module.Basis.coord_apply, hψy, map_add, map_smul,
      Module.Basis.repr_self, hy0, smul_eq_mul, add_zero]
    by_cases h : (a', b', c) = (a, b, n)
    · simp only [Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      simp
    · have h' : (a' + d, b', c + 1) ≠ (a + d, b, n + 1) := by
        simpa [Prod.mk.injEq] using h
      simp [h, h']

/-! ### Commuting with `E` -/

/-- At a generic parameter, an element commuting with `E` whose PBW monomials all have
`E`-exponent at most `n` has no monomial `F ^ a * K ^ b * E ^ n` with `b ≠ 0`. -/
private theorem pbwBasis_repr_eq_zero_of_commute_e (hq : IsGenericQuantumParameter q)
    {z : UqSl2 q} (hz : Commute (e q) z) {n : ℕ}
    (hn : ∀ i ∈ ((pbwBasis q).repr z).support, i.2.2 ≤ n) (a : ℕ) {b : ℤ} (hb : b ≠ 0) :
    (pbwBasis q).repr z (a, b, n) = 0 := by
  have hψ (a : ℕ) (b : ℤ) (c : ℕ) :
      (LinearMap.mulLeft ℂ (e q) - LinearMap.mulRight ℂ (e q)) (pbwBasis q (a, b, c)) -
        (q ^ (-2 * b) - 1) • pbwBasis q (a + 0, b, c + 1) ∈
        Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}) := by
    have hright : pbwBasis q (a, b, c) * e q = pbwBasis q (a, b, c + 1) := by
      simp only [pbwBasis_apply, pow_succ, mul_assoc]
    convert e_mul_pbwBasis_sub_mem a b c using 1
    simp only [LinearMap.sub_apply, LinearMap.mulLeft_apply, LinearMap.mulRight_apply, hright,
      add_zero, sub_smul, one_smul]
    abel
  have h := (pbwBasis_repr_of_raise hψ hn).2 a b
  simp only [LinearMap.sub_apply, LinearMap.mulLeft_apply, LinearMap.mulRight_apply, hz.eq,
    sub_self, map_zero, Finsupp.coe_zero, Pi.zero_apply] at h
  refine (mul_eq_zero.mp h.symm).resolve_left (sub_ne_zero.mpr fun h1 => hb ?_)
  have := hq.zpow_injective (h1.trans (zpow_zero q).symm)
  omega

/-! ### Powers of the Casimir element -/

/-- The PBW monomials of `Ω ^ n` have `E`-exponent at most `n`, and the coefficient of
`F ^ n * E ^ n` is `1`. -/
private theorem pbwBasis_repr_casimir_pow (n : ℕ) :
    (∀ i ∈ ((pbwBasis q).repr (casimir q ^ n)).support, i.2.2 ≤ n) ∧
      (pbwBasis q).repr (casimir q ^ n) (n, 0, n) = 1 := by
  induction n with
  | zero =>
    have h1 : (1 : UqSl2 q) = pbwBasis q (0, 0, 0) := by simp
    rw [pow_zero, h1, Module.Basis.repr_self]
    exact ⟨fun i hi => by simp at hi; simp [hi], by simp⟩
  | succ n ih =>
    have h := pbwBasis_repr_of_raise (ψ := LinearMap.mulLeft ℂ (casimir q)) (d := 1)
      (s := fun b => q ^ (-2 * b)) (fun a b c => casimir_mul_pbwBasis_sub_mem a b c) ih.1
    simp only [LinearMap.mulLeft_apply] at h
    rw [pow_succ']
    exact ⟨h.1, by rw [h.2 n 0, ih.2]; simp⟩

/-- The Casimir element is transcendental over `ℂ`: its powers are linearly independent. -/
theorem transcendental_casimir : Transcendental ℂ (casimir q) := by
  rw [transcendental_iff]
  intro p hp
  by_contra hp0
  -- The coefficient of `F ^ d * E ^ d` in `p(Ω)`, with `d = deg p`, is the leading coefficient.
  have h := congrArg (fun x => (pbwBasis q).repr x (p.natDegree, 0, p.natDegree)) hp
  rw [aeval_eq_sum_range, Finset.sum_range_succ] at h
  simp only [map_add, map_sum, map_smul, Finsupp.coe_add, Pi.add_apply, Finsupp.finsetSum_apply,
    Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul, map_zero, Finsupp.coe_zero, Pi.zero_apply,
    (pbwBasis_repr_casimir_pow _).2, mul_one] at h
  have hlow : ∀ j ∈ Finset.range p.natDegree,
      p.coeff j * (pbwBasis q).repr (casimir q ^ j) (p.natDegree, 0, p.natDegree) = 0 := by
    intro j hj
    rw [Finset.mem_range] at hj
    have hzero : (pbwBasis q).repr (casimir q ^ j) (p.natDegree, 0, p.natDegree) = 0 :=
      Finsupp.notMem_support_iff.mp fun hi => by
        have : p.natDegree ≤ j := (pbwBasis_repr_casimir_pow j).1 _ hi
        omega
    rw [hzero, mul_zero]
  rw [Finset.sum_eq_zero hlow, zero_add] at h
  exact hp0 (leadingCoeff_eq_zero.mp h)

/-! ### The center -/

/-- **The center of `U_q(sl₂)`.** At a generic parameter, the center of `UqSl2 q` is the
subalgebra generated by the Casimir element. -/
theorem center_eq_adjoin_casimir (hq : IsGenericQuantumParameter q) :
    Subalgebra.center ℂ (UqSl2 q) = Algebra.adjoin ℂ {casimir q} := by
  refine le_antisymm (fun z hz => ?_)
    (Algebra.adjoin_le (Set.singleton_subset_iff.mpr casimir_mem_center))
  -- Induction on a strict bound for the `E`-exponents of the PBW monomials of `z`.
  suffices h : ∀ n, ∀ z ∈ Subalgebra.center ℂ (UqSl2 q),
      (∀ i ∈ ((pbwBasis q).repr z).support, i.2.2 < n) → z ∈ Algebra.adjoin ℂ {casimir q} from
    h (((pbwBasis q).repr z).support.sup (·.2.2) + 1) z hz fun i hi =>
      Nat.lt_succ_of_le (Finset.le_sup (f := (·.2.2)) hi)
  intro n
  induction n with
  | zero =>
    intro z _ hz
    have : (pbwBasis q).repr z = 0 := Finsupp.support_eq_empty.mp
      (Finset.eq_empty_of_forall_notMem fun i hi => (Nat.not_lt_zero _ (hz i hi)))
    rw [(pbwBasis q).repr.map_eq_zero_iff.mp this]
    exact zero_mem _
  | succ n ih =>
    intro z hzc hz
    have hcomm (g : UqSl2 q) {x : UqSl2 q} (hx : x ∈ Subalgebra.center ℂ (UqSl2 q)) :
        Commute g x :=
      Subalgebra.mem_center_iff.mp hx g
    set c := (pbwBasis q).repr z (n, 0, n)
    set z' := z - c • casimir q ^ n
    have hz'c : z' ∈ Subalgebra.center ℂ (UqSl2 q) :=
      sub_mem hzc (Subalgebra.smul_mem _ (pow_mem casimir_mem_center n) c)
    have hrepr (i : ℕ × ℤ × ℕ) : (pbwBasis q).repr z' i =
        (pbwBasis q).repr z i - c * (pbwBasis q).repr (casimir q ^ n) i := by
      simp [z']
    -- The `E`-exponents of `z'` are at most `n`.
    have hle : ∀ i ∈ ((pbwBasis q).repr z').support, i.2.2 ≤ n := by
      intro i hi
      rw [Finsupp.mem_support_iff, hrepr] at hi
      by_cases hzi : (pbwBasis q).repr z i = 0
      · rw [hzi, zero_sub, neg_ne_zero] at hi
        exact (pbwBasis_repr_casimir_pow n).1 i
          (Finsupp.mem_support_iff.mpr (right_ne_zero_of_mul hi))
      · exact Nat.lt_succ_iff.mp (hz i (Finsupp.mem_support_iff.mpr hzi))
    -- The monomials `F ^ a * K ^ b * E ^ n` of `z'` vanish, so its `E`-exponents are `< n`.
    have hlt : ∀ i ∈ ((pbwBasis q).repr z').support, i.2.2 < n := by
      rintro ⟨a, b, c'⟩ hi
      refine (hle _ hi).lt_of_ne fun hc' => ?_
      subst hc'
      rw [Finsupp.mem_support_iff] at hi
      by_cases ha : a = c'
      · subst ha
        by_cases hb : b = 0
        · subst hb
          exact hi (by rw [hrepr, (pbwBasis_repr_casimir_pow a).2, mul_one, sub_self])
        · exact hi (pbwBasis_repr_eq_zero_of_commute_e hq (hcomm _ hz'c) hle a hb)
      · exact hi (pbwBasis_repr_eq_zero_of_commute_k hq (hcomm _ hz'c) ha)
    rw [← add_sub_cancel (c • casimir q ^ n) z]
    exact add_mem (Subalgebra.smul_mem _ (pow_mem (Algebra.self_mem_adjoin_singleton ℂ _) n) c)
      (ih z' hz'c hlt)

/-- At a generic parameter, the center of `U_q(sl₂)` is a polynomial algebra in one variable:
evaluation at the Casimir element is an isomorphism `ℂ[X] ≃ₐ[ℂ] Z(U_q(sl₂))`. -/
def polynomialAlgEquivCenter (hq : IsGenericQuantumParameter q) :
    ℂ[X] ≃ₐ[ℂ] Subalgebra.center ℂ (UqSl2 q) :=
  (algEquivOfTranscendental ℂ (casimir q) transcendental_casimir).trans
    (Subalgebra.equivOfEq _ _ (center_eq_adjoin_casimir hq).symm)

/-- The isomorphism `polynomialAlgEquivCenter` is evaluation at the Casimir element. -/
@[simp]
theorem coe_polynomialAlgEquivCenter_apply (hq : IsGenericQuantumParameter q) (p : ℂ[X]) :
    (polynomialAlgEquivCenter hq p : UqSl2 q) = aeval (casimir q) p := by
  simp [polynomialAlgEquivCenter]

end TauCeti.UqSl2
