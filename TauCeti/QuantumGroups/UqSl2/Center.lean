import Mathlib.Tactic
import TauCeti.QuantumGroups.UqSl2.Commutator

/-!
# The center of `U_q(sl₂)`

At a generic parameter `q` (nonzero and not a root of unity), the center of `UqSl2 q` is the
polynomial algebra `ℂ[Ω]` generated by the Casimir element `Ω`.

The proof is a leading-coefficient reduction in the PBW basis `F ^ a * K ^ b * E ^ c`, using the
coordinate reductions from `TauCeti.QuantumGroups.UqSl2.PBW`.

* Conjugation by `K` multiplies `F ^ a * K ^ b * E ^ c` by `q ^ (2 (c - a))`, so an element
  commuting with `K` only involves monomials with `a = c`.
* Commuting `E` past `F ^ a * K ^ b * E ^ c` produces `q ^ (-2 b) F ^ a K ^ b E ^ (c + 1)`
  plus monomials whose `E`-exponent is still `c`. Comparing coefficients of the monomials with
  the largest `E`-exponent `n`, an element commuting with `E` has no monomial
  `F ^ a * K ^ b * E ^ n` with `b ≠ 0`.
* The same computation shows that `Ω ^ n` has `E`-exponents at most `n` and coefficient `1` on
  `F ^ n * E ^ n`. Subtracting a multiple of `Ω ^ n` from a central element lowers its largest
  `E`-exponent, and induction finishes the proof.

The same leading coefficients show that the powers of `Ω` are linearly independent, so `Ω` is
transcendental over `ℂ` for every nonzero `q`.

## Main results

* `TauCeti.UqSl2.transcendental_casimir`: the Casimir element is transcendental over `ℂ`.
* `TauCeti.UqSl2.center_eq_adjoin_casimir`: at a generic parameter, the center of `UqSl2 q` is
  the subalgebra generated by the Casimir element.
* `TauCeti.UqSl2.polynomialAlgEquivCenter`: the resulting isomorphism `ℂ[X] ≃ₐ[ℂ] Z(U_q(sl₂))`
  sending `X` to `Ω`.

## References

* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Section VI.4, for the
  description of the center at a generic parameter; Kassel argues through the Harish-Chandra
  homomorphism instead of the leading-coefficient reduction used here.
-/

public noncomputable section

open Polynomial

namespace TauCeti.UqSl2

variable {q : ℂ} [Fact (q ≠ 0)]

/-! ### The Casimir element on PBW monomials -/

/-- Left multiplication by the Casimir element raises the `E`-exponent of a PBW monomial by one,
sending `F ^ a * K ^ b * E ^ c` to `q ^ (-2b) F ^ (a + 1) * K ^ b * E ^ (c + 1)` up to
monomials with the same `E`-exponent `c`. -/
private theorem casimir_mul_pbwBasis_sub_mem (a : ℕ) (b : ℤ) (c : ℕ) :
    casimir q * pbwBasis q (a, b, c) - q ^ (-2 * b) • pbwBasis q (a + 1, b, c + 1) ∈
      Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}) := by
  have hmem (i : ℕ × ℤ × ℕ) (hi : i.2.2 = c) :
      pbwBasis q i ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}) :=
    Submodule.subset_span (Set.mem_image_of_mem _ hi)
  have hf {x : UqSl2 q} (hx : x ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c})) :
      f q * x ∈ Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c}) :=
    (Submodule.span_le (p := (Submodule.span ℂ (pbwBasis q '' {i | i.2.2 = c})).comap
      (LinearMap.mulLeft ℂ (f q)))).mpr (by
        rintro _ ⟨⟨a', b', c'⟩, hi, rfl⟩
        rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply, f_mul_pbwBasis]
        exact hmem _ hi) hx
  have hk : k q * pbwBasis q (a, b, c) = (q⁻¹ ^ 2) ^ a • pbwBasis q (a, b + 1, c) := by
    simp only [pbwBasis_apply, ← mul_assoc, k_mul_f_pow, smul_mul_assoc]
    simp only [mul_assoc, k_mul_kUnit_zpow]
  have hkInv : kInv q * pbwBasis q (a, b, c) = (q ^ 2) ^ a • pbwBasis q (a, b - 1, c) := by
    simp only [pbwBasis_apply, ← mul_assoc, kInv_mul_f_pow, smul_mul_assoc]
    simp only [mul_assoc, kInv_mul_kUnit_zpow]
  have key : casimir q * pbwBasis q (a, b, c) - q ^ (-2 * b) • pbwBasis q (a + 1, b, c + 1) =
      f q * (e q * pbwBasis q (a, b, c) - q ^ (-2 * b) • pbwBasis q (a, b, c + 1)) +
        ((q - q⁻¹) ^ 2)⁻¹ • (q • (k q * pbwBasis q (a, b, c)) +
          q⁻¹ • (kInv q * pbwBasis q (a, b, c))) := by
    rw [casimir_def, mul_sub, mul_smul_comm, f_mul_pbwBasis]
    simp only [add_mul, smul_mul_assoc, mul_assoc]
    abel
  rw [key, hk, hkInv]
  exact add_mem (hf (e_mul_pbwBasis_sub_mem a b c)) (Submodule.smul_mem _ _ (add_mem
    (Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (hmem _ rfl)))
    (Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (hmem _ rfl)))))

/-! ### Powers of the Casimir element -/

/-- The PBW monomials of `Ω ^ n` have `E`-exponent at most `n`, and the coefficient of
`F ^ n * E ^ n` is `1`. -/
private theorem pbwBasis_repr_casimir_pow (n : ℕ) :
    (∀ i ∈ ((pbwBasis q).repr (casimir q ^ n)).support, i.2.2 ≤ n) ∧
      (pbwBasis q).repr (casimir q ^ n) (n, 0, n) = 1 := by
  induction n with
  | zero =>
    have h1 : (1 : UqSl2 q) = pbwBasis q (0, 0, 0) := by simp
    rw [pow_zero, h1, Module.Basis.repr_self]
    exact ⟨fun i hi => by simp at hi; simp [hi], by simp⟩
  | succ n ih =>
    have h := pbwBasis_repr_of_raise (ψ := LinearMap.mulLeft ℂ (casimir q)) (d := 1)
      (s := fun b => q ^ (-2 * b)) (fun a b c => casimir_mul_pbwBasis_sub_mem a b c) ih.1
    simp only [LinearMap.mulLeft_apply] at h
    rw [pow_succ']
    exact ⟨h.1, by rw [h.2 n 0, ih.2]; simp⟩

/-- The Casimir element is transcendental over `ℂ`: its powers are linearly independent. -/
theorem transcendental_casimir : Transcendental ℂ (casimir q) := by
  rw [transcendental_iff]
  intro p hp
  by_contra hp0
  -- The coefficient of `F ^ d * E ^ d` in `p(Ω)`, with `d = deg p`, is the leading coefficient.
  have h := congrArg (fun x => (pbwBasis q).repr x (p.natDegree, 0, p.natDegree)) hp
  rw [aeval_eq_sum_range, Finset.sum_range_succ] at h
  simp only [map_add, map_sum, map_smul, Finsupp.coe_add, Pi.add_apply, Finsupp.finsetSum_apply,
    Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul, map_zero, Finsupp.coe_zero, Pi.zero_apply,
    (pbwBasis_repr_casimir_pow _).2, mul_one] at h
  have hlow : ∀ j ∈ Finset.range p.natDegree,
      p.coeff j * (pbwBasis q).repr (casimir q ^ j) (p.natDegree, 0, p.natDegree) = 0 := by
    intro j hj
    rw [Finset.mem_range] at hj
    have hzero : (pbwBasis q).repr (casimir q ^ j) (p.natDegree, 0, p.natDegree) = 0 :=
      Finsupp.notMem_support_iff.mp fun hi => by
        have : p.natDegree ≤ j := (pbwBasis_repr_casimir_pow j).1 _ hi
        omega
    rw [hzero, mul_zero]
  rw [Finset.sum_eq_zero hlow, zero_add] at h
  exact hp0 (leadingCoeff_eq_zero.mp h)

/-! ### The center -/

/-- **The center of `U_q(sl₂)`.** At a generic parameter, the center of `UqSl2 q` is the
subalgebra generated by the Casimir element. -/
theorem center_eq_adjoin_casimir (hq : IsGenericQuantumParameter q) :
    Subalgebra.center ℂ (UqSl2 q) = Algebra.adjoin ℂ {casimir q} := by
  refine le_antisymm (fun z hz => ?_)
    (Algebra.adjoin_le (Set.singleton_subset_iff.mpr casimir_mem_center))
  -- Induction on a strict bound for the `E`-exponents of the PBW monomials of `z`.
  suffices h : ∀ n, ∀ z ∈ Subalgebra.center ℂ (UqSl2 q),
      (∀ i ∈ ((pbwBasis q).repr z).support, i.2.2 < n) → z ∈ Algebra.adjoin ℂ {casimir q} from
    h (((pbwBasis q).repr z).support.sup (·.2.2) + 1) z hz fun i hi =>
      Nat.lt_succ_of_le (Finset.le_sup (f := (·.2.2)) hi)
  intro n
  induction n with
  | zero =>
    intro z _ hz
    have : (pbwBasis q).repr z = 0 := Finsupp.support_eq_empty.mp
      (Finset.eq_empty_of_forall_notMem fun i hi => (Nat.not_lt_zero _ (hz i hi)))
    rw [(pbwBasis q).repr.map_eq_zero_iff.mp this]
    exact zero_mem _
  | succ n ih =>
    intro z hzc hz
    have hcomm (g : UqSl2 q) {x : UqSl2 q} (hx : x ∈ Subalgebra.center ℂ (UqSl2 q)) :
        Commute g x :=
      Subalgebra.mem_center_iff.mp hx g
    set c := (pbwBasis q).repr z (n, 0, n)
    set z' := z - c • casimir q ^ n
    have hz'c : z' ∈ Subalgebra.center ℂ (UqSl2 q) :=
      sub_mem hzc (Subalgebra.smul_mem _ (pow_mem casimir_mem_center n) c)
    have hrepr (i : ℕ × ℤ × ℕ) : (pbwBasis q).repr z' i =
        (pbwBasis q).repr z i - c * (pbwBasis q).repr (casimir q ^ n) i := by
      simp [z']
    -- The `E`-exponents of `z'` are at most `n`.
    have hle : ∀ i ∈ ((pbwBasis q).repr z').support, i.2.2 ≤ n := by
      intro i hi
      rw [Finsupp.mem_support_iff, hrepr] at hi
      by_cases hzi : (pbwBasis q).repr z i = 0
      · rw [hzi, zero_sub, neg_ne_zero] at hi
        exact (pbwBasis_repr_casimir_pow n).1 i
          (Finsupp.mem_support_iff.mpr (right_ne_zero_of_mul hi))
      · exact Nat.lt_succ_iff.mp (hz i (Finsupp.mem_support_iff.mpr hzi))
    -- The monomials `F ^ a * K ^ b * E ^ n` of `z'` vanish, so its `E`-exponents are `< n`.
    have hlt : ∀ i ∈ ((pbwBasis q).repr z').support, i.2.2 < n := by
      rintro ⟨a, b, c'⟩ hi
      refine (hle _ hi).lt_of_ne fun hc' => ?_
      subst hc'
      rw [Finsupp.mem_support_iff] at hi
      by_cases ha : a = c'
      · subst ha
        by_cases hb : b = 0
        · subst hb
          exact hi (by rw [hrepr, (pbwBasis_repr_casimir_pow a).2, mul_one, sub_self])
        · exact hi (pbwBasis_repr_eq_zero_of_commute_e hq (hcomm _ hz'c) hle a hb)
      · exact hi (pbwBasis_repr_eq_zero_of_commute_k hq (hcomm _ hz'c) ha)
    rw [← add_sub_cancel (c • casimir q ^ n) z]
    exact add_mem (Subalgebra.smul_mem _ (pow_mem (Algebra.self_mem_adjoin_singleton ℂ _) n) c)
      (ih z' hz'c hlt)

/-- At a generic parameter, the center of `U_q(sl₂)` is a polynomial algebra in one variable:
evaluation at the Casimir element is an isomorphism `ℂ[X] ≃ₐ[ℂ] Z(U_q(sl₂))`. -/
def polynomialAlgEquivCenter (hq : IsGenericQuantumParameter q) :
    ℂ[X] ≃ₐ[ℂ] Subalgebra.center ℂ (UqSl2 q) :=
  (algEquivOfTranscendental ℂ (casimir q) transcendental_casimir).trans
    (Subalgebra.equivOfEq _ _ (center_eq_adjoin_casimir hq).symm)

/-- The isomorphism `polynomialAlgEquivCenter` is evaluation at the Casimir element. -/
@[simp]
theorem coe_polynomialAlgEquivCenter_apply (hq : IsGenericQuantumParameter q) (p : ℂ[X]) :
    (polynomialAlgEquivCenter hq p : UqSl2 q) = aeval (casimir q) p := by
  simp [polynomialAlgEquivCenter]

end TauCeti.UqSl2
