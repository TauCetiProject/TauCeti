/-!
# The center of `U_q(sl₂)`

At a generic parameter `q` (nonzero and not a root of unity), the center of `UqSl2 q` is the
subalgebra generated by the Casimir element `Ω`: every central element is a polynomial in `Ω`.

The proof uses the Harish-Chandra projection and the Verma modules `M(μ)`. Writing an element
`x` in the PBW basis `F^a K^b E^c`, its Harish-Chandra projection is the Laurent polynomial
`Σ_b x_(0,b,0) T^b` collecting the coefficients of the pure powers of `K`. The argument has three
steps.

* A central element `z` acts on every vector of nonzero weight `μ` killed by `E` by the
  scalar obtained by evaluating its Harish-Chandra projection at `μ`. By the universal property
  of `M(μ)` it suffices to check this on the highest vector `v₀` of `M(μ)`, where `z v₀` is
  computed from the PBW expansion and has weight `μ`.
* For every `j : ℕ`, the Verma module `M(q^j)` contains the singular vector `v_(j+1)` of weight
  `q^(-j-2)`. Hence the Harish-Chandra projection of `z` takes the same value at `q^j` and at
  `q^(-j-2)`. These are infinitely many points, so the projection, after the substitution
  `T ↦ q⁻¹ T`, is a Laurent polynomial fixed by `T ↦ T⁻¹`. It is therefore a polynomial in
  `T + T⁻¹`, that is, its value at `μ` is a polynomial in the Casimir scalar
  `(q μ + q⁻¹ μ⁻¹) / (q - q⁻¹)²`.
* The Verma modules `M(μ)`, `μ ≠ 0`, separate the elements of `UqSl2 q`: if `x` kills all of them,
  let `c` be the least exponent of `E` occurring in `x`; then `x v_c` in `M(μ)` exhibits the
  Laurent polynomials of the coefficients of `x` with exponent `c` of `E` as vanishing at
  infinitely many `μ`. Applied to `z - p(Ω)`, which kills every highest vector, this gives
  `z = p(Ω)`.

## Main definitions

* `TauCeti.UqSl2.harishChandra`: the Harish-Chandra projection `UqSl2 q → ℂ[T;T⁻¹]`.

## Main results

* `TauCeti.UqSl2.smul_eq_laurentEval_harishChandra_smul`: a central element acts on a vector of
  nonzero weight `μ` killed by `E` by its Harish-Chandra projection evaluated at `μ`.
* `TauCeti.UqSl2.exists_eval_casimirScalar_eq_laurentEval_harishChandra`: the Harish-Chandra
  projection of a central element, evaluated at `μ`, is a polynomial in `casimirScalar q μ`.
* `TauCeti.UqSl2.eq_zero_of_forall_vermaModule_smul_eq_zero`: the Verma modules separate the
  elements of `UqSl2 q`.
* `TauCeti.UqSl2.center_eq_adjoin_casimir`: the center of `UqSl2 q` is generated by `Ω`.

## References

* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Section VI.4, for the
  center of `U_q(sl₂)` and its Harish-Chandra description.
-/

public noncomputable section

open LaurentPolynomial
open scoped Polynomial

namespace TauCeti.UqSl2

open VermaModule

variable {q : ℂ}

section HarishChandra

variable [Fact (q ≠ 0)]

variable (q) in
/-- For fixed exponents `a` of `F` and `c` of `E`, the Laurent polynomial `Σ_b x_(a,b,c) T^b`
collecting the PBW coefficients of the monomials `F^a K^b E^c`. -/
private def pbwSlice (a c : ℕ) : UqSl2 q →ₗ[ℂ] ℂ[T;T⁻¹] :=
  (pbwBasis q).constr ℂ fun i => if i.1 = a ∧ i.2.2 = c then T i.2.1 else 0

private theorem pbwSlice_pbwBasis (a c a' : ℕ) (b : ℤ) (c' : ℕ) :
    pbwSlice q a c (pbwBasis q (a', b, c')) = if a' = a ∧ c' = c then T b else 0 := by
  rw [pbwSlice, Module.Basis.constr_basis]

private theorem coeff_pbwSlice (a c : ℕ) (x : UqSl2 q) (b : ℤ) :
    (pbwSlice q a c x).coeff b = (pbwBasis q).repr x (a, b, c) := by
  have h : Finsupp.lapply b ∘ₗ (AddMonoidAlgebra.coeffLinearEquiv ℂ).toLinearMap ∘ₗ
      pbwSlice q a c = Finsupp.lapply (a, b, c) ∘ₗ (pbwBasis q).repr.toLinearMap := by
    refine (pbwBasis q).ext fun ⟨a', b', c'⟩ => ?_
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, pbwSlice_pbwBasis,
      Module.Basis.repr_self, Finsupp.lapply_apply, Finsupp.single_apply,
      AddMonoidAlgebra.coeffLinearEquiv_apply]
    split_ifs <;> simp_all
  exact LinearMap.congr_fun h x

variable (q) in
/-- The Harish-Chandra projection of `UqSl2 q`: the Laurent polynomial `Σ_b x_(0,b,0) T^b`
formed by the coefficients of the pure powers `K^b` in the PBW expansion
`x = Σ x_(a,b,c) F^a K^b E^c`. -/
def harishChandra : UqSl2 q →ₗ[ℂ] ℂ[T;T⁻¹] :=
  pbwSlice q 0 0

private theorem harishChandra_eq_pbwSlice : harishChandra q = pbwSlice q 0 0 :=
  rfl

/-- The Harish-Chandra projection of a PBW monomial `F^a K^b E^c` is `T^b` if `a = c = 0`, and
zero otherwise. -/
theorem harishChandra_pbwBasis (a : ℕ) (b : ℤ) (c : ℕ) :
    harishChandra q (pbwBasis q (a, b, c)) = if a = 0 ∧ c = 0 then T b else 0 :=
  pbwSlice_pbwBasis 0 0 a b c

/-- The coefficients of the Harish-Chandra projection are the PBW coefficients of the pure
powers of `K`. -/
@[simp]
theorem coeff_harishChandra (x : UqSl2 q) (b : ℤ) :
    (harishChandra q x).coeff b = (pbwBasis q).repr x (0, b, 0) :=
  coeff_pbwSlice 0 0 x b

end HarishChandra

/-! ### PBW monomials acting on Verma modules -/

section Verma

variable [Fact (q ≠ 0)] {μ : ℂ}

/-- The coefficient of `v₀` in `E^c v_c`. -/
private def eProd (q μ : ℂ) (c : ℕ) : ℂ :=
  ∏ i ∈ Finset.range c, quantumInteger q (i + 1) * (q⁻¹ ^ i * μ - q ^ i * μ⁻¹) / (q - q⁻¹)

omit [Fact (q ≠ 0)] in
private theorem e_pow_smul_vec_self (c : ℕ) :
    e q ^ c • vec q μ c = eProd q μ c • vec q μ 0 := by
  simpa only [eProd, zero_add, Nat.cast_zero] using e_pow_smul_vec_add (q := q) (μ := μ) c 0

omit [Fact (q ≠ 0)] in
/-- At a generic parameter, `E^c v_c` is a nonzero multiple of `v₀` as long as `μ²` is none of
`q^(2i)`, `i < c`. -/
private theorem eProd_ne_zero (hq : IsGenericQuantumParameter q) (hμ : μ ≠ 0) {c : ℕ}
    (h : ∀ i < c, μ ^ 2 ≠ q ^ (2 * i)) : eProd q μ c ≠ 0 := by
  refine Finset.prod_ne_zero_iff.mpr fun i hi hzero => h i (Finset.mem_range.mp hi) ?_
  refine (e_smul_vec_succ_eq_zero_iff hq hμ i).mp ?_
  rw [e_smul_vec_succ, hzero, zero_smul]

/-- The coefficient of `v_a` in `F^a' K^b E^c' v_c`, when `c ≤ c'`. -/
private theorem repr_pbwBasis_smul_vec (hμ : μ ≠ 0) (a' : ℕ) (b : ℤ) {c' c : ℕ} (h : c ≤ c')
    (a : ℕ) :
    (basis (Fact.out : q ≠ 0) hμ).repr (pbwBasis q (a', b, c') • vec q μ c) a =
      if a' = a ∧ c' = c then eProd q μ c * μ ^ b else 0 := by
  rcases h.lt_or_eq with hlt | rfl
  · rw [pbwBasis_apply, mul_smul, mul_smul, e_pow_smul_vec_of_lt hlt, smul_zero, smul_zero,
      map_zero, Finsupp.zero_apply]
    simp [hlt.ne']
  · have hK := kUnit_zpow_smul_of_mem_weightSpace
      (mem_weightSpace_iff.mpr (k_smul_vec_zero (q := q) (μ := μ))) b
    rw [pbwBasis_apply, mul_smul, mul_smul, e_pow_smul_vec_self]
    simp only [smul_algebra_smul_comm (A := UqSl2 q), hK, f_pow_smul_vec, add_zero, map_smul,
      basis_repr_vec]
    by_cases ha : a' = a <;> simp [ha]

/-- If the PBW coefficients of `x` with exponent of `E` below `c` vanish, then the coefficient of
`v_a` in `x v_c` is `eProd q μ c` times the value at `μ` of the Laurent polynomial of the
coefficients of `x` at `F^a K^b E^c`. -/
private theorem repr_smul_vec (hμ : μ ≠ 0) {x : UqSl2 q} {c : ℕ}
    (hx : ∀ a b c', c' < c → (pbwBasis q).repr x (a, b, c') = 0) (a : ℕ) :
    (basis (Fact.out : q ≠ 0) hμ).repr (x • vec q μ c) a =
      eProd q μ c * laurentEval (Units.mk0 μ hμ) (pbwSlice q a c x) := by
  let φ : UqSl2 q →ₗ[ℂ] ℂ := Finsupp.lapply a ∘ₗ (basis (Fact.out : q ≠ 0) hμ).repr.toLinearMap ∘ₗ
    (LinearMap.toSpanSingleton (UqSl2 q) _ (vec q μ c)).restrictScalars ℂ
  let ψ : UqSl2 q →ₗ[ℂ] ℂ :=
    eProd q μ c • ((laurentEval (Units.mk0 μ hμ)).toLinearMap ∘ₗ pbwSlice q a c)
  have hφψ : Set.EqOn φ ψ ((pbwBasis q) '' ((pbwBasis q).repr x).support) := by
    rintro _ ⟨⟨a', b, c'⟩, hi, rfl⟩
    have hc : c ≤ c' := by
      by_contra h
      exact Finsupp.mem_support_iff.mp hi (hx a' b c' (by omega))
    simp only [φ, ψ, LinearMap.comp_apply, LinearMap.restrictScalars_apply,
      LinearMap.toSpanSingleton_apply, LinearEquiv.coe_coe, Finsupp.lapply_apply,
      repr_pbwBasis_smul_vec hμ a' b hc a, LinearMap.smul_apply, AlgHom.toLinearMap_apply,
      pbwSlice_pbwBasis, smul_eq_mul]
    split_ifs <;> simp [Units.val_zpow_eq_zpow_val]
  exact LinearMap.eqOn_span' hφψ ((pbwBasis q).mem_span_repr_support x)

/-- The coefficient of `v_a` in `K y` is `q^(-2a) μ` times that in `y`. -/
private theorem repr_k_smul (hμ : μ ≠ 0) (y : VermaModule q μ) (a : ℕ) :
    (basis (Fact.out : q ≠ 0) hμ).repr (k q • y) a =
      (q⁻¹ ^ 2) ^ a * μ * (basis (Fact.out : q ≠ 0) hμ).repr y a := by
  have h : Finsupp.lapply a ∘ₗ (basis (Fact.out : q ≠ 0) hμ).repr.toLinearMap ∘ₗ
      Algebra.lsmul ℂ ℂ (VermaModule q μ) (k q) =
      ((q⁻¹ ^ 2) ^ a * μ) • (Finsupp.lapply a ∘ₗ
        (basis (Fact.out : q ≠ 0) hμ).repr.toLinearMap) := by
    refine (basis (Fact.out : q ≠ 0) hμ).ext fun j => ?_
    simp only [LinearMap.comp_apply, Algebra.lsmul_coe, coe_basis, k_smul_vec,
      LinearEquiv.coe_coe, map_smul, LinearMap.smul_apply, Finsupp.lapply_apply, smul_eq_mul,
      basis_repr_vec, Finsupp.single_apply]
    split_ifs with hj <;> simp [hj]
  exact LinearMap.congr_fun h y

end Verma

/-! ### Central elements on highest-weight vectors -/

section Central

variable [Fact (q ≠ 0)]

/-- At a generic parameter, a central element `z` acts on the highest vector of `M(μ)` by the value
of its Harish-Chandra projection at `μ`. -/
private theorem smul_vec_zero_eq (hq : IsGenericQuantumParameter q) {z : UqSl2 q}
    (hz : z ∈ Subalgebra.center ℂ (UqSl2 q)) {μ : ℂ} (hμ : μ ≠ 0) :
    z • vec q μ 0 = laurentEval (Units.mk0 μ hμ) (harishChandra q z) • vec q μ 0 := by
  -- `z v₀` has weight `μ`, because `z` commutes with `K`.
  have hK : k q • (z • vec q μ 0) = μ • (z • vec q μ 0) := by
    rw [← mul_smul, Subalgebra.mem_center_iff.mp hz (k q), mul_smul, k_smul_vec_zero, smul_comm]
  refine (basis (Fact.out : q ≠ 0) hμ).ext_elem fun a => ?_
  have hr : (basis (Fact.out : q ≠ 0) hμ).repr
      (laurentEval (Units.mk0 μ hμ) (harishChandra q z) • vec q μ 0) a =
        laurentEval (Units.mk0 μ hμ) (harishChandra q z) * if 0 = a then 1 else 0 := by
    rw [map_smul, Finsupp.smul_apply, basis_repr_vec, Finsupp.single_apply, smul_eq_mul]
  rw [hr]
  rcases eq_or_ne a 0 with rfl | ha
  · rw [repr_smul_vec hμ (fun _ _ _ h => absurd h (Nat.not_lt_zero _)),
      harishChandra_eq_pbwSlice]
    simp [eProd]
  · -- The weight `q^(-2a) μ` of `v_a` differs from `μ`, so `z v₀` has no component on `v_a`.
    have hw : (q⁻¹ ^ 2) ^ a * μ ≠ μ := by
      intro h
      apply hq.pow_ne_one (n := 2 * a) (by omega)
      rw [← inv_inj, inv_one, pow_mul, ← inv_pow, ← inv_pow]
      exact (mul_eq_right₀ hμ).mp h
    have h := repr_k_smul hμ (z • vec q μ 0) a
    rw [hK, LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul] at h
    simp only [Ne.symm ha, ↓reduceIte, mul_zero]
    exact (mul_eq_mul_right_iff.mp h).resolve_left (Ne.symm hw)

/-- At a generic parameter, a central element `z` acts on every vector `v` of nonzero weight `μ`
killed by `E` by the scalar obtained by evaluating the Harish-Chandra projection of `z` at `μ`. -/
theorem smul_eq_laurentEval_harishChandra_smul (hq : IsGenericQuantumParameter q) {z : UqSl2 q}
    (hz : z ∈ Subalgebra.center ℂ (UqSl2 q)) {V : Type*} [AddCommGroup V] [Module ℂ V]
    [Module (UqSl2 q) V] [IsScalarTower ℂ (UqSl2 q) V] {μ : ℂ} (hμ : μ ≠ 0) {v : V}
    (hv : v ∈ weightSpace q V μ) (he : e q • v = 0) :
    z • v = laurentEval (Units.mk0 μ hμ) (harishChandra q z) • v := by
  have h := congrArg (VermaModule.lift hv he) (smul_vec_zero_eq hq hz hμ)
  rwa [map_smul, LinearMap.map_smul_of_tower, lift_vec_zero] at h

/-- The linkage relation: the Harish-Chandra projection of a central element takes the same value
at `q^j` and at `q^(-j-2)`, because `M(q^j)` contains a singular vector of weight `q^(-j-2)`. -/
private theorem laurentEval_harishChandra_linkage (hq : IsGenericQuantumParameter q)
    {z : UqSl2 q} (hz : z ∈ Subalgebra.center ℂ (UqSl2 q)) (j : ℕ) :
    laurentEval (Units.mk0 q hq.ne_zero ^ (j : ℤ)) (harishChandra q z) =
      laurentEval (Units.mk0 q hq.ne_zero ^ (-(j : ℤ) - 2)) (harishChandra q z) := by
  have hq0 := hq.ne_zero
  have hμ : q ^ j ≠ 0 := pow_ne_zero _ hq0
  have hν : (q⁻¹ ^ 2) ^ (j + 1) * q ^ j ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (pow_ne_zero _ (inv_ne_zero hq0))) hμ
  have hQμ : Units.mk0 (q ^ j) hμ = Units.mk0 q hq0 ^ (j : ℤ) := Units.ext (by simp)
  have hQν : Units.mk0 ((q⁻¹ ^ 2) ^ (j + 1) * q ^ j) hν = Units.mk0 q hq0 ^ (-(j : ℤ) - 2) := by
    refine Units.ext ?_
    have hexp : -(j : ℤ) - 2 = -((j + 2 : ℕ) : ℤ) := by push_cast; ring
    rw [Units.val_mk0, Units.val_zpow_eq_zpow_val, Units.val_mk0, hexp, zpow_neg, zpow_natCast]
    simp only [inv_pow]
    field_simp
    ring
  -- The singular vector `v_(j+1)` of `M(q^j)`.
  have hw : vec q (q ^ j) (j + 1) ≠ 0 := vec_ne_zero hq0 hμ _
  have he : e q • vec q (q ^ j) (j + 1) = 0 :=
    (e_smul_vec_succ_eq_zero_iff hq hμ j).mpr (by rw [← pow_mul, mul_comm])
  have hv : vec q (q ^ j) (j + 1) ∈ weightSpace q _ ((q⁻¹ ^ 2) ^ (j + 1) * q ^ j) :=
    mem_weightSpace_iff.mpr (k_smul_vec (j + 1))
  have h₁ := smul_eq_laurentEval_harishChandra_smul hq hz hν hv he
  have h₂ : z • vec q (q ^ j) (j + 1) =
      laurentEval (Units.mk0 (q ^ j) hμ) (harishChandra q z) • vec q (q ^ j) (j + 1) := by
    rw [vec_eq_f_pow_smul, ← mul_smul, ← Subalgebra.mem_center_iff.mp hz, mul_smul,
      smul_vec_zero_eq hq hz hμ, smul_comm]
  rw [← hQμ, ← hQν]
  exact smul_left_injective ℂ hw (h₂.symm.trans h₁)

/-- **The Harish-Chandra theorem for `U_q(sl₂)`.** At a generic parameter, the Harish-Chandra
projection of a central element, evaluated at a nonzero `μ`, is a fixed polynomial in the Casimir
scalar `casimirScalar q μ = (q μ + q⁻¹ μ⁻¹) / (q - q⁻¹)²`. -/
theorem exists_eval_casimirScalar_eq_laurentEval_harishChandra (hq : IsGenericQuantumParameter q)
    {z : UqSl2 q} (hz : z ∈ Subalgebra.center ℂ (UqSl2 q)) :
    ∃ p : ℂ[X], ∀ (μ : ℂ) (hμ : μ ≠ 0),
      p.eval (casimirScalar q μ) = laurentEval (Units.mk0 μ hμ) (harishChandra q z) := by
  have hq0 := hq.ne_zero
  set Q := Units.mk0 q hq0
  -- After the substitution `T ↦ q⁻¹ T`, the projection is fixed by `T ↦ T⁻¹`.
  set R := LaurentPolynomial.rescale ℂ Q⁻¹ (harishChandra q z)
  have hmap (c : ℂˣ) : Units.map (algebraMap ℂ ℂ).toMonoidHom c = c := Units.ext (by simp)
  have hR : invert R = R := by
    refine eq_of_infinite_eval₂_eq _ _ (algebraMap ℂ ℂ) (algebraMap ℂ ℂ).injective ?_
    have hinj : Function.Injective fun j : ℕ => Q ^ ((j : ℤ) + 1) := by
      intro m n hmn
      have h : q ^ (m + 1) = q ^ (n + 1) := by
        have h' := congrArg Units.val hmn
        simp only [Units.val_zpow_eq_zpow_val, Units.val_mk0, Q] at h'
        exact_mod_cast h'
      simpa using hq.pow_injective h
    refine (Set.infinite_range_of_injective hinj).mono ?_
    rintro _ ⟨j, rfl⟩
    simp only [Set.mem_ofPred_eq, ← laurentEval_eq_eval₂, laurentEval_invert, R,
      laurentEval_rescale, hmap]
    have hinv : Q⁻¹ * (Q ^ ((j : ℤ) + 1))⁻¹ = Q ^ (-(j : ℤ) - 2) := by group
    have hself : Q⁻¹ * Q ^ ((j : ℤ) + 1) = Q ^ (j : ℤ) := by group
    rw [hinv, hself]
    exact (laurentEval_harishChandra_linkage hq hz j).symm
  obtain ⟨g, hg⟩ := (invert_eq_self_iff_exists_eval₂ R).mp hR
  refine ⟨g.comp (Polynomial.C ((q - q⁻¹) ^ 2) * Polynomial.X), fun μ hμ => ?_⟩
  have hR' : laurentEval (Q * Units.mk0 μ hμ) R =
      laurentEval (Units.mk0 μ hμ) (harishChandra q z) := by
    rw [laurentEval_rescale, hmap, inv_mul_cancel_left]
  rw [← hR', ← hg, laurentEval_eval₂_T_add_T_neg_one, Polynomial.coe_aeval_eq_eval,
    Polynomial.eval_comp]
  simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X, Units.val_mul,
    Units.val_inv_eq_inv_val, Units.val_mk0, Q, casimirScalar_def]
  congr 1
  rw [mul_div_cancel₀ _ (pow_ne_zero 2 hq.sub_inv_ne_zero), mul_inv]

end Central

/-! ### Faithfulness of the Verma modules -/

/-- At a generic parameter, the Verma modules `M(μ)`, `μ ≠ 0`, separate the elements of
`UqSl2 q`: an element acting by zero on all of them is zero. -/
theorem eq_zero_of_forall_vermaModule_smul_eq_zero (hq : IsGenericQuantumParameter q)
    {x : UqSl2 q} (hx : ∀ μ : ℂ, μ ≠ 0 → ∀ v : VermaModule q μ, x • v = 0) : x = 0 := by
  have hq0 := hq.ne_zero
  have : Fact (q ≠ 0) := ⟨hq0⟩
  set Q := Units.mk0 q⁻¹ (inv_ne_zero hq0)
  -- By strong induction on the exponent `c` of `E`, all PBW coefficients of `x` vanish.
  have key (c : ℕ) : ∀ a b, (pbwBasis q).repr x (a, b, c) = 0 := by
    induction c using Nat.strong_induction_on with
    | _ c ih =>
    intro a b
    rw [← coeff_pbwSlice]
    suffices h : pbwSlice q a c x = 0 by simp [h]
    refine eq_zero_of_infinite_eval₂_eq_zero _ (algebraMap ℂ ℂ) (algebraMap ℂ ℂ).injective ?_
    have hinj : Function.Injective fun n : ℕ => Q ^ (n + 1) := by
      intro m n hmn
      have h := hq.inv.pow_injective (congrArg Units.val hmn)
      simpa using h
    refine (Set.infinite_range_of_injective hinj).mono ?_
    rintro _ ⟨n, rfl⟩
    -- Test `x` on `v_c` in `M(q^(-(n+1)))`, where `E^c v_c` is a nonzero multiple of `v₀`.
    have hμ : q⁻¹ ^ (n + 1) ≠ 0 := pow_ne_zero _ (inv_ne_zero hq0)
    have hγ : eProd q (q⁻¹ ^ (n + 1)) c ≠ 0 := by
      refine eProd_ne_zero hq hμ fun i _ hi => hq.pow_ne_one (n := 2 * i + 2 * (n + 1))
        (by omega) ?_
      rw [pow_add, ← hi, ← pow_mul, mul_comm (n + 1) 2, ← mul_pow, inv_mul_cancel₀ hq0, one_pow]
    have h := repr_smul_vec hμ (fun a' b' c' hc' => ih c' hc' a' b') a
    rw [hx _ hμ, map_zero, Finsupp.zero_apply, eq_comm, mul_eq_zero, or_iff_right hγ] at h
    simp only [Set.mem_ofPred_eq, ← laurentEval_eq_eval₂]
    convert h using 3
    exact Units.ext (by simp [Q])
  exact (pbwBasis q).forall_coord_eq_zero_iff.mp fun ⟨a, b, c⟩ => key c a b

/-! ### The center -/

/-- **The center of `U_q(sl₂)`.** At a generic parameter, the center of `UqSl2 q` is the
subalgebra generated by the Casimir element. -/
theorem center_eq_adjoin_casimir (hq : IsGenericQuantumParameter q) :
    Subalgebra.center ℂ (UqSl2 q) = Algebra.adjoin ℂ {casimir q} := by
  have : Fact (q ≠ 0) := ⟨hq.ne_zero⟩
  have hle : Algebra.adjoin ℂ {casimir q} ≤ Subalgebra.center ℂ (UqSl2 q) :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr casimir_mem_center)
  refine le_antisymm (fun z hz => ?_) hle
  obtain ⟨p, hp⟩ := exists_eval_casimirScalar_eq_laurentEval_harishChandra hq hz
  have hpz : Polynomial.aeval (casimir q) p ∈ Algebra.adjoin ℂ {casimir q} :=
    Polynomial.aeval_mem_adjoin_singleton ℂ _
  -- `z - p(Ω)` is central and kills every highest vector, hence every Verma module.
  have hw : z - Polynomial.aeval (casimir q) p = 0 := by
    refine eq_zero_of_forall_vermaModule_smul_eq_zero hq fun μ hμ v => ?_
    obtain ⟨a, rfl⟩ := mk_surjective v
    have hv : vec q μ 0 ∈ weightSpace q _ μ := mem_weightSpace_iff.mpr k_smul_vec_zero
    have hΩ : (Algebra.lsmul ℂ ℂ (VermaModule q μ) (casimir q)).HasEigenvector
        (casimirScalar q μ) (vec q μ 0) :=
      ⟨Module.End.mem_eigenspace_iff.mpr (casimir_smul_of_e_smul_eq_zero hv e_smul_vec_zero),
        vec_ne_zero hq.ne_zero hμ 0⟩
    have hp' := Module.End.aeval_apply_of_hasEigenvector (p := p) hΩ
    rw [Polynomial.aeval_algHom_apply, Algebra.lsmul_coe] at hp'
    beta_reduce at hp'
    rw [mk_eq_smul_vec_zero, ← mul_smul,
      ← Subalgebra.mem_center_iff.mp (sub_mem hz (hle hpz)) a, mul_smul, sub_smul,
      smul_eq_laurentEval_harishChandra_smul hq hz hμ hv e_smul_vec_zero, hp', hp μ hμ, sub_self,
      smul_zero]
  rw [sub_eq_zero.mp hw]
  exact hpz

end TauCeti.UqSl2
