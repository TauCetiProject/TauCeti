/-!
# The center of `U_q(sl₂)`

At a generic parameter `q` (nonzero and not a root of unity), the center of `UqSl2 q` is the
polynomial algebra `ℂ[Ω]` in the Casimir element `Ω = F E + (q K + q⁻¹ K⁻¹) / (q - q⁻¹)²`: the
Casimir element is transcendental over `ℂ`, and it generates the center as a complex algebra.

The proof reduces leading coefficients in the PBW basis `F ^ a * K ^ b * E ^ c`, filtered by the
exponent `a` of `F`.

* An element commuting with `K` has PBW coordinates only at exponents with `a = c`, since
  conjugation by `K` multiplies `F ^ a * K ^ b * E ^ c` by `q ^ (2 (c - a))`.
* For an element `z` whose PBW coordinates vanish beyond `F`-exponent `n`, the coordinate of `E z`
  at `F ^ n * K ^ b * E ^ (c + 1)` is `q ^ (-2b)` times the coordinate of `z` at
  `F ^ n * K ^ b * E ^ c`, while that of `z E` is the coordinate of `z` itself. If `z` commutes
  with `E`, the top-degree coordinates of `z` are therefore supported at `b = 0`.
* Hence a central element of `F`-degree `n` has top-degree part `λ F ^ n E ^ n`. Since
  `Ω ^ n` has top-degree part `F ^ n E ^ n`, subtracting `λ Ω ^ n` lowers the degree, and
  induction on the degree shows that the central element is a polynomial in `Ω`. The same
  leading term shows that no nonzero polynomial in `Ω` vanishes.

## Main results

* `TauCeti.UqSl2.pbwBasis_repr_eq_zero_of_commute_k`: an element commuting with `K` has no PBW
  coordinate at `F ^ a * K ^ b * E ^ c` with `a ≠ c`.
* `TauCeti.UqSl2.transcendental_casimir`: the Casimir element is transcendental over `ℂ`.
* `TauCeti.UqSl2.center_eq_adjoin_casimir`: at a generic parameter, the center of `UqSl2 q` is
  the subalgebra generated by the Casimir element.

Together, `Polynomial.algEquivOfTranscendental` applied to `transcendental_casimir` and
`center_eq_adjoin_casimir` identify the center with the polynomial ring `ℂ[X]`.

## References

* C. Kassel, *Quantum Groups*, Graduate Texts in Mathematics 155, Section VI.4.
* J. C. Jantzen, *Lectures on Quantum Groups*, Graduate Studies in Mathematics 6, Chapter 2.
-/

public noncomputable section

open Polynomial

namespace TauCeti.UqSl2

variable (q : ℂ) [Fact (q ≠ 0)]

/-! ### The filtration by the exponent of `F` -/

/-- The span of the PBW monomials `F ^ a * K ^ b * E ^ c` with `a < n`. -/
private def fDegLT (n : ℕ) : Submodule ℂ (UqSl2 q) :=
  Submodule.span ℂ (pbwBasis q '' {i | i.1 < n})

private theorem mem_fDegLT {n : ℕ} {x : UqSl2 q} :
    x ∈ fDegLT q n ↔ ∀ i : ℕ × ℤ × ℕ, n ≤ i.1 → (pbwBasis q).repr x i = 0 := by
  rw [fDegLT, Module.Basis.mem_span_image]
  refine ⟨fun h i hi => ?_, fun h i hi => ?_⟩
  · by_contra hne
    exact absurd (h (Finsupp.mem_support_iff.mpr hne)) (by simpa using hi)
  · by_contra hne
    exact Finsupp.mem_support_iff.mp hi (h i (by simpa using hne))

private theorem pbwBasis_mem_fDegLT {n a : ℕ} (b : ℤ) (c : ℕ) (h : a < n) :
    pbwBasis q (a, b, c) ∈ fDegLT q n :=
  Submodule.subset_span ⟨(a, b, c), h, rfl⟩

private theorem fDegLT_mono {m n : ℕ} (h : m ≤ n) : fDegLT q m ≤ fDegLT q n :=
  Submodule.span_mono (Set.image_mono fun i (hi : i.1 < m) => lt_of_lt_of_le hi h)

/-- Every element has bounded `F`-degree. -/
private theorem exists_mem_fDegLT (x : UqSl2 q) : ∃ n, x ∈ fDegLT q n := by
  refine ⟨((pbwBasis q).repr x).support.sup (·.1) + 1, (mem_fDegLT q).mpr fun i hi => ?_⟩
  by_contra hne
  have : i.1 ≤ ((pbwBasis q).repr x).support.sup (·.1) :=
    Finset.le_sup (f := (·.1)) (Finsupp.mem_support_iff.mpr hne)
  omega

/-- Multiplying a PBW monomial by the Casimir element raises its `F`-degree by one, with leading
term `q ^ (-2b) F ^ (a + 1) * K ^ b * E ^ (c + 1)`. -/
private theorem casimir_mul_pbwBasis_sub_mem (a : ℕ) (b : ℤ) (c : ℕ) :
    casimir q * pbwBasis q (a, b, c) - q ^ (-2 * b) • pbwBasis q (a + 1, b, c + 1) ∈
      fDegLT q (a + 1) := by
  rw [casimir_def, add_mul, mul_assoc, e_mul_pbwBasis, smul_mul_assoc, add_mul, smul_mul_assoc,
    smul_mul_assoc, k_mul_pbwBasis, kInv_mul_pbwBasis]
  simp only [mul_add, mul_sub, mul_smul_comm, f_mul_pbwBasis, add_assoc, add_sub_cancel_left]
  -- The two monomials of `F`-exponent `a - 1 + 1` have the coefficient `[a]_q`, zero if `a = 0`.
  obtain rfl | ha := Nat.eq_zero_or_pos a
  · simp only [Nat.cast_zero, quantumInteger_zero, zero_mul, zero_smul, zero_add]
    apply_rules [Submodule.add_mem, Submodule.smul_mem, pbwBasis_mem_fDegLT, Nat.lt_succ_self]
  · have h1 : a - 1 + 1 < a + 1 := by omega
    apply_rules [Submodule.add_mem, Submodule.sub_mem, Submodule.smul_mem, pbwBasis_mem_fDegLT,
      Nat.lt_succ_self]

private theorem casimir_mul_mem_fDegLT {n : ℕ} {x : UqSl2 q} (hx : x ∈ fDegLT q n) :
    casimir q * x ∈ fDegLT q (n + 1) := by
  suffices h : fDegLT q n ≤ (fDegLT q (n + 1)).comap (LinearMap.mulLeft ℂ (casimir q)) from h hx
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨⟨a, b, c⟩, ha : a < n, rfl⟩
  have h := Submodule.add_mem _ (fDegLT_mono q (by omega) (casimir_mul_pbwBasis_sub_mem q a b c))
    (Submodule.smul_mem _ (q ^ (-2 * b)) (pbwBasis_mem_fDegLT q b (c + 1) (Nat.succ_lt_succ ha)))
  rwa [sub_add_cancel] at h

/-- The power `Ω ^ n` agrees with `F ^ n E ^ n` up to terms of `F`-degree less than `n`. -/
private theorem casimir_pow_sub_mem (n : ℕ) :
    casimir q ^ n - pbwBasis q (n, 0, n) ∈ fDegLT q n := by
  induction n with
  | zero => simp
  | succ n ih =>
    have h := Submodule.add_mem _ (casimir_mul_mem_fDegLT q ih)
      (casimir_mul_pbwBasis_sub_mem q n 0 n)
    rwa [mul_sub, sub_add_sub_cancel, ← pow_succ', mul_zero, zpow_zero, one_smul] at h

private theorem casimir_pow_mem_fDegLT (n : ℕ) : casimir q ^ n ∈ fDegLT q (n + 1) := by
  rw [← sub_add_cancel (casimir q ^ n) (pbwBasis q (n, 0, n))]
  exact Submodule.add_mem _ (fDegLT_mono q n.le_succ (casimir_pow_sub_mem q n))
    (pbwBasis_mem_fDegLT q 0 n n.lt_succ_self)

/-- The PBW coordinates of `Ω ^ n` of top `F`-exponent `n` are those of `F ^ n E ^ n`. -/
private theorem pbwBasis_repr_casimir_pow (n : ℕ) (b : ℤ) (c : ℕ) :
    (pbwBasis q).repr (casimir q ^ n) (n, b, c) = if b = 0 ∧ c = n then 1 else 0 := by
  have h := (mem_fDegLT q).mp (casimir_pow_sub_mem q n) (n, b, c) le_rfl
  rw [map_sub, Finsupp.sub_apply, sub_eq_zero, Module.Basis.repr_self] at h
  rw [h, Finsupp.single_apply]
  simp only [Prod.mk.injEq, true_and, eq_comm]

/-- **The Casimir element is transcendental.** Evaluation at `Ω` is injective on `ℂ[X]`, since
`Ω ^ n` has leading PBW term `F ^ n E ^ n`. -/
theorem transcendental_casimir : Transcendental ℂ (casimir q) := by
  rw [transcendental_iff_injective, injective_iff_map_eq_zero]
  intro p hp
  by_contra hne
  -- The coordinate at `F ^ n * E ^ n`, for `n` the degree of `p`, is the leading coefficient.
  have h := congrArg ((pbwBasis q).coord (p.natDegree, 0, p.natDegree)) hp
  simp only [aeval_eq_sum_range, map_sum, map_smul, Module.Basis.coord_apply, smul_eq_mul,
    map_zero] at h
  rw [Finset.sum_range_succ, Finset.sum_eq_zero, zero_add, pbwBasis_repr_casimir_pow] at h
  · exact hne (leadingCoeff_eq_zero.mp (by simpa using h))
  · intro j hj
    rw [(mem_fDegLT q).mp (fDegLT_mono q (Finset.mem_range.mp hj) (casimir_pow_mem_fDegLT q j))
      _ le_rfl, mul_zero]

/-! ### Central elements -/

/-- A linear map sending each PBW vector to a multiple of a PBW vector, along an injective map
of exponents, scales the corresponding coordinates. -/
private theorem pbwBasis_repr_apply_of_map {φ : UqSl2 q →ₗ[ℂ] UqSl2 q}
    {g : ℕ × ℤ × ℕ → ℕ × ℤ × ℕ} (hg : Function.Injective g) (s : ℕ × ℤ × ℕ → ℂ)
    (hφ : ∀ i, φ (pbwBasis q i) = s i • pbwBasis q (g i)) (x : UqSl2 q) (i : ℕ × ℤ × ℕ) :
    (pbwBasis q).repr (φ x) (g i) = s i * (pbwBasis q).repr x i := by
  have h : (pbwBasis q).coord (g i) ∘ₗ φ = s i • (pbwBasis q).coord i :=
    (pbwBasis q).ext fun j => by
      simp only [LinearMap.comp_apply, hφ, map_smul, Module.Basis.coord_apply,
        Module.Basis.repr_self, LinearMap.smul_apply, smul_eq_mul,
        Finsupp.single_apply, hg.eq_iff]
      split_ifs with hji <;> simp [hji]
  simpa using LinearMap.congr_fun h x

/-- Right multiplication by `E` shifts the PBW coordinates in the exponent of `E`. -/
private theorem pbwBasis_repr_mul_e (x : UqSl2 q) (a : ℕ) (b : ℤ) (c : ℕ) :
    (pbwBasis q).repr (x * e q) (a, b, c + 1) = (pbwBasis q).repr x (a, b, c) := by
  have hg : Function.Injective fun i : ℕ × ℤ × ℕ => (i.1, i.2.1, i.2.2 + 1) := by
    rintro ⟨a, b, c⟩ ⟨a', b', c'⟩ h
    simp only [Prod.mk.injEq, add_left_inj] at h
    simp [h]
  simpa using pbwBasis_repr_apply_of_map q (φ := LinearMap.mulRight ℂ (e q)) hg (fun _ => 1)
    (fun ⟨a, b, c⟩ => by rw [LinearMap.mulRight_apply, pbwBasis_mul_e, one_smul]) x (a, b, c)

/-- **Leading coordinates of `E z`.** If the PBW coordinates of `z` vanish beyond `F`-exponent `n`,
then the coordinate of `E z` at `F ^ n * K ^ b * E ^ (c + 1)` is `q ^ (-2b)` times the
coordinate of `z` at `F ^ n * K ^ b * E ^ c`. -/
private theorem pbwBasis_repr_e_mul {n : ℕ} {x : UqSl2 q} (hx : x ∈ fDegLT q (n + 1)) (b : ℤ)
    (c : ℕ) :
    (pbwBasis q).repr (e q * x) (n, b, c + 1) = q ^ (-2 * b) * (pbwBasis q).repr x (n, b, c) := by
  have h : Set.EqOn ⇑((pbwBasis q).coord (n, b, c + 1) ∘ₗ LinearMap.mulLeft ℂ (e q))
      ⇑(q ^ (-2 * b) • (pbwBasis q).coord (n, b, c)) (pbwBasis q '' {i | i.1 < n + 1}) := by
    rintro _ ⟨⟨a, b', c'⟩, ha : a < n + 1, rfl⟩
    have ha' : a - 1 ≠ n ∨ a = 0 := by omega
    simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, e_mul_pbwBasis, map_add, map_smul,
      map_sub, Module.Basis.coord_apply, Module.Basis.repr_self, LinearMap.smul_apply,
      Finsupp.single_apply, Prod.mk.injEq, smul_eq_mul, add_left_inj]
    -- The two monomials of `F`-exponent `a - 1` do not contribute.
    rcases ha' with ha' | rfl
    · simp only [ha', false_and, ↓reduceIte, mul_zero, sub_zero, add_zero]
      split_ifs with h
      · rw [h.2.1]
      · rw [mul_zero, mul_zero]
    · simp only [Nat.cast_zero, quantumInteger_zero, zero_mul, add_zero]
      split_ifs with h
      · rw [h.2.1]
      · rw [mul_zero, mul_zero]
  simpa using LinearMap.eqOn_span' h hx

variable {q}

/-- **Weight-zero coordinates.** At a generic parameter, an element commuting with `K` has no PBW
coordinate at `F ^ a * K ^ b * E ^ c` with `a ≠ c`. -/
theorem pbwBasis_repr_eq_zero_of_commute_k (hq : IsGenericQuantumParameter q) {x : UqSl2 q}
    (hx : Commute (k q) x) {a : ℕ} (b : ℤ) {c : ℕ} (hac : a ≠ c) :
    (pbwBasis q).repr x (a, b, c) = 0 := by
  have hg : Function.Injective fun i : ℕ × ℤ × ℕ => (i.1, i.2.1 + 1, i.2.2) := by
    rintro ⟨a, b, c⟩ ⟨a', b', c'⟩ h
    simp only [Prod.mk.injEq, add_left_inj] at h
    simp [h]
  have hl := pbwBasis_repr_apply_of_map q (φ := LinearMap.mulLeft ℂ (k q)) hg
    (fun i => (q⁻¹ ^ 2) ^ i.1) (fun ⟨a, b, c⟩ => k_mul_pbwBasis q a b c) x (a, b, c)
  have hr := pbwBasis_repr_apply_of_map q (φ := LinearMap.mulRight ℂ (k q)) hg
    (fun i => (q⁻¹ ^ 2) ^ i.2.2) (fun ⟨a, b, c⟩ => pbwBasis_mul_k q a b c) x (a, b, c)
  simp only [LinearMap.mulLeft_apply, LinearMap.mulRight_apply, hx.eq] at hl hr
  rw [hl] at hr
  have hs : (q⁻¹ ^ 2) ^ a ≠ (q⁻¹ ^ 2) ^ c := fun h => hac <| by
    have := hq.inv.pow_injective (by simpa only [← pow_mul] using h)
    omega
  exact (mul_eq_mul_right_iff.mp hr).resolve_left hs

/-- **Reduction step.** At a generic parameter, if a central element `z` has no PBW coordinates
beyond `F`-exponent `n`, then its top-degree part is `λ F ^ n E ^ n`, so subtracting `λ Ω ^ n`
leaves no PBW coordinates beyond `F`-exponent `n - 1`. -/
private theorem sub_smul_casimir_pow_mem_fDegLT (hq : IsGenericQuantumParameter q) {n : ℕ}
    {x : UqSl2 q} (hx : x ∈ Subalgebra.center ℂ (UqSl2 q)) (hn : x ∈ fDegLT q (n + 1)) :
    x - (pbwBasis q).repr x (n, 0, n) • casimir q ^ n ∈ fDegLT q n := by
  have hcomm (y : UqSl2 q) : y * x = x * y := Subalgebra.mem_center_iff.mp hx y
  refine (mem_fDegLT q).mpr fun ⟨a, b, d⟩ ha => ?_
  simp only [map_sub, map_smul, Finsupp.sub_apply, Finsupp.smul_apply, smul_eq_mul]
  obtain rfl | ha' := (show n ≤ a from ha).eq_or_lt
  · rw [pbwBasis_repr_casimir_pow]
    by_cases hd : d = n
    · subst hd
      by_cases hb : b = 0
      · simp [hb]
      simp only [hb, false_and, ↓reduceIte, mul_zero, sub_zero]
      -- The top-degree coordinates of `x` are supported at `b = 0`, as `x` commutes with `E`.
      have h := pbwBasis_repr_e_mul q hn b d
      rw [hcomm, pbwBasis_repr_mul_e] at h
      have hs : q ^ (-2 * b) ≠ 1 := fun h' => hb <| by
        have := hq.zpow_injective (h'.trans (zpow_zero q).symm)
        omega
      by_contra hne
      exact hs ((mul_eq_right₀ hne).mp h.symm)
    · rw [pbwBasis_repr_eq_zero_of_commute_k hq (hcomm (k q)) b (Ne.symm hd)]
      simp only [hd, and_false, ↓reduceIte, mul_zero, sub_zero]
  · rw [(mem_fDegLT q).mp hn (a, b, d) ha',
      (mem_fDegLT q).mp (casimir_pow_mem_fDegLT q n) (a, b, d) ha', mul_zero, sub_zero]

omit [Fact (q ≠ 0)] in
/-- **The center of `U_q(sl₂)`.** At a generic parameter, the center of `UqSl2 q` is the
subalgebra generated by the Casimir element `Ω`. Since `Ω` is transcendental
(`transcendental_casimir`), the center is a polynomial algebra `ℂ[Ω]`. -/
theorem center_eq_adjoin_casimir (hq : IsGenericQuantumParameter q) :
    Subalgebra.center ℂ (UqSl2 q) = Algebra.adjoin ℂ {casimir q} := by
  have : Fact (q ≠ 0) := ⟨hq.ne_zero⟩
  refine le_antisymm (fun x hx => ?_)
    (Algebra.adjoin_le (Set.singleton_subset_iff.mpr casimir_mem_center))
  obtain ⟨n, hn⟩ := exists_mem_fDegLT q x
  -- Induction on the `F`-degree: subtracting a multiple of `Ω ^ n` lowers it.
  induction n generalizing x with
  | zero =>
    have hx0 : x = 0 :=
      (pbwBasis q).ext_elem fun i => by simpa using (mem_fDegLT q).mp hn i (Nat.zero_le _)
    rw [hx0]
    exact zero_mem _
  | succ n ih =>
    set r := (pbwBasis q).repr x (n, 0, n)
    have hmem : r • casimir q ^ n ∈ Subalgebra.center ℂ (UqSl2 q) :=
      Subalgebra.smul_mem _ (Subalgebra.pow_mem _ casimir_mem_center n) r
    have h := Subalgebra.add_mem _
      (ih _ (Subalgebra.sub_mem _ hx hmem) (sub_smul_casimir_pow_mem_fDegLT hq hx hn))
      (Subalgebra.smul_mem _
        (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton (casimir q))) n) r)
    rwa [sub_add_cancel] at h

end TauCeti.UqSl2
