module

public import TauCeti.QuantumGroups.UqSl2.LocallyFinite
public import TauCeti.QuantumGroups.UqSl2.PBW

/-!
# Type-1 `U_q(sl₂)`-modules

A `UqSl2 q`-module is a *weight module with weights in `S`* when `K` acts diagonalizably with
all eigenvalues in `S`, i.e. the module is the sum, hence the algebraic direct sum, of its
weight spaces of weight in `S`. No finiteness of the module is assumed. It is *of type 1* when
the weights are integral powers `q ^ n`, `n : ℤ`, and *of signed type 1* when they are signed
powers `± q ^ n`.

At a generic parameter `q` (nonzero and not a root of unity) the following are equivalent for a
module `V`:

* `V` is of type 1 and `E`, `F` act locally nilpotently;
* `V` is of type 1 and locally finite;
* `V` is a direct sum of positive signed ladder modules `L_m^+`.

Dropping the sign condition, a module is of signed type 1 with `E`, `F` locally nilpotent exactly
when it is locally finite. The one-dimensional module `L_0^-`, on which `K` acts by `-1` and `E`,
`F` act by zero, is locally finite but not of type 1, so the unsigned integral-weight condition is
genuinely stronger than local finiteness.

The implication from local nilpotence to local finiteness holds for any weight module: by the PBW
basis, the cyclic submodule generated by `v` is spanned by the vectors `F^a K^b E^c v`. Only
finitely many `E^c v` are nonzero, only finitely many `F^a E^c v` are nonzero, and the `K`-orbit of
a vector of a weight module spans a finite-dimensional space.

## Main definitions

* `TauCeti.UqSl2.IsWeightModule q V S`: `V` is spanned by its weight spaces of weight in `S`.
* `TauCeti.UqSl2.IsTypeOne q V`: `V` is a weight module with weights `q ^ n`, `n : ℤ`.
* `TauCeti.UqSl2.IsSignedTypeOne q V`: `V` is a weight module with weights `± q ^ n`.

## Main results

* `TauCeti.UqSl2.isWeightModule_iff_isInternal`: a weight module is the internal direct sum of
  its weight spaces.
* `TauCeti.UqSl2.isTypeOne_iff_isInternal`: at a generic parameter, `V` is of type 1 exactly when
  it is the internal direct sum of the weight spaces of weight `q ^ n`, `n : ℤ`.
* `TauCeti.UqSl2.isLocallyFiniteModule_of_isWeightModule`: a weight module on which `E` and `F`
  act locally nilpotently is locally finite.
* `isTypeOne_and_isLocallyFiniteModule_iff_exists_linearEquiv_dfinsupp_ladderModule` and
  `isTypeOne_and_forall_exists_pow_smul_eq_zero_iff_exists_linearEquiv_dfinsupp_ladderModule`
  (in `TauCeti.UqSl2`): the classification of type-1 modules with locally nilpotent `E`, `F` as
  direct sums of `L_m^+`.
* `TauCeti.UqSl2.isSignedTypeOne_and_forall_exists_pow_smul_eq_zero_iff_isLocallyFiniteModule`:
  the signed version characterizes local finiteness.
* `TauCeti.UqSl2.LadderModule.not_isTypeOne`: `L_m^-` is not of type 1.

## References

* A. Virelizier, *Quantum groups*, Sections 2.3--2.4, for type-1 modules and the rank-one
  conventions.
-/

public section

namespace TauCeti.UqSl2

universe u

open Submodule

variable {q : ℂ} {V : Type*} [AddCommGroup V] [Module ℂ V]
  [Module (UqSl2 q) V] [IsScalarTower ℂ (UqSl2 q) V] {S : Set ℂ}

/-! ### Weight modules -/

variable (q V S) in
/-- A `UqSl2 q`-module is a weight module with weights in `S` when it is spanned by its weight
spaces of weight in `S`: `K` acts diagonalizably and all its eigenvalues lie in `S`. -/
def IsWeightModule : Prop :=
  ⨆ μ ∈ S, weightSpace q V μ = ⊤

/-- A module is a weight module with weights in `S` exactly when its weight spaces of weight in
`S` span it. -/
theorem isWeightModule_iff : IsWeightModule q V S ↔ ⨆ μ ∈ S, weightSpace q V μ = ⊤ :=
  Iff.rfl

/-- The weight spaces of weight in `S` of a weight module with weights in `S` span it. -/
theorem IsWeightModule.iSup_eq_top (h : IsWeightModule q V S) :
    ⨆ μ ∈ S, weightSpace q V μ = ⊤ :=
  isWeightModule_iff.mp h

/-- A weight module with weights in `S` has weights in every larger set. -/
theorem IsWeightModule.mono {T : Set ℂ} (h : IsWeightModule q V S) (hST : S ⊆ T) :
    IsWeightModule q V T :=
  isWeightModule_iff.mpr (eq_top_iff.mpr (h.iSup_eq_top.ge.trans (biSup_mono hST)))

/-- Every eigenvalue of `K` on a weight module with weights in `S` lies in `S`. -/
theorem IsWeightModule.mem_of_mem_weightSpace (h : IsWeightModule q V S) {μ : ℂ} {v : V}
    (hv : v ∈ weightSpace q V μ) (hv0 : v ≠ 0) : μ ∈ S := by
  by_contra hμ
  -- The weight spaces of weight in `S` all have weight different from `μ`.
  have hle : ⨆ ν ∈ S, weightSpace q V ν ≤ ⨆ ν ≠ μ, (Algebra.lsmul ℂ ℂ V (k q)).eigenspace ν :=
    iSup₂_le fun ν hν => le_iSup₂_of_le
      (f := fun ν (_ : ν ≠ μ) => (Algebra.lsmul ℂ ℂ V (k q)).eigenspace ν) ν
      (by rintro rfl; exact hμ hν) (weightSpace_def ν).le
  have hdisj := ((Algebra.lsmul ℂ ℂ V (k q)).eigenspaces_iSupIndep μ).mono_right hle
  rw [h.iSup_eq_top, disjoint_top] at hdisj
  exact hv0 (by rwa [weightSpace_def, hdisj, mem_bot] at hv)

/-- A module is a weight module with weights in `S` exactly when it is the internal direct sum of
its weight spaces of weight in `S`. -/
theorem isWeightModule_iff_isInternal :
    IsWeightModule q V S ↔ DirectSum.IsInternal fun μ : S => weightSpace q V μ := by
  rw [DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top, isWeightModule_iff,
    iSup_subtype']
  refine ⟨fun h => ⟨?_, h⟩, And.right⟩
  simp_rw [weightSpace_def]
  exact (Algebra.lsmul ℂ ℂ V (k q)).eigenspaces_iSupIndep.comp Subtype.val_injective

/-- A module is a weight module with weights in `S` when it is spanned by the images of module
maps from weight modules with weights in `S`. -/
theorem IsWeightModule.of_iSup_range_eq_top {ι : Type*} {N : ι → Type*}
    [∀ i, AddCommGroup (N i)] [∀ i, Module ℂ (N i)] [∀ i, Module (UqSl2 q) (N i)]
    [∀ i, IsScalarTower ℂ (UqSl2 q) (N i)] (φ : ∀ i, N i →ₗ[UqSl2 q] V)
    (hφ : ⨆ i, LinearMap.range (φ i) = ⊤) (h : ∀ i, IsWeightModule q (N i) S) :
    IsWeightModule q V S := by
  -- Each `φ i` maps the weight spaces of weight in `S` into those of `V`.
  have key (i : ι) (x : N i) : φ i x ∈ ⨆ μ ∈ S, weightSpace q V μ := by
    have hx : x ∈ ⨆ μ ∈ S, weightSpace q (N i) μ := (h i).iSup_eq_top ▸ mem_top
    refine (iSup₂_le fun μ hμ => ?_ : ⨆ μ ∈ S, weightSpace q (N i) μ ≤
      (⨆ μ ∈ S, weightSpace q V μ).comap ((φ i).restrictScalars ℂ)) hx
    exact map_le_iff_le_comap.mp ((map_weightSpace_le (φ i) μ).trans
      (le_iSup₂ (f := fun μ (_ : μ ∈ S) => weightSpace q V μ) μ hμ))
  refine isWeightModule_iff.mpr (eq_top_iff.mpr ?_)
  rintro v -
  induction (hφ ▸ mem_top : v ∈ ⨆ i, LinearMap.range (φ i)) using iSup_induction' with
  | mem i v hv =>
    obtain ⟨x, rfl⟩ := hv
    exact key i x
  | zero => exact zero_mem _
  | add v w _ _ hv hw => exact add_mem hv hw

/-- The image of a weight module under a surjective module map is a weight module with the same
weights. -/
theorem IsWeightModule.of_surjective {W : Type*} [AddCommGroup W] [Module ℂ W]
    [Module (UqSl2 q) W] [IsScalarTower ℂ (UqSl2 q) W] (h : IsWeightModule q W S)
    (φ : W →ₗ[UqSl2 q] V) (hφ : Function.Surjective φ) : IsWeightModule q V S :=
  of_iSup_range_eq_top (ι := Unit) (fun _ => φ) (by simp [LinearMap.range_eq_top.mpr hφ])
    fun _ => h

/-- A direct sum of weight modules with weights in `S` is a weight module with weights in `S`. -/
theorem IsWeightModule.dfinsupp {ι : Type*} {N : ι → Type*} [∀ i, AddCommGroup (N i)]
    [∀ i, Module ℂ (N i)] [∀ i, Module (UqSl2 q) (N i)] [∀ i, IsScalarTower ℂ (UqSl2 q) (N i)]
    (h : ∀ i, IsWeightModule q (N i) S) : IsWeightModule q (Π₀ i, N i) S := by
  classical
  exact of_iSup_range_eq_top (fun i => DFinsupp.lsingle i) DFinsupp.iSup_range_lsingle h

/-! ### Type-1 and signed type-1 modules -/

variable (q V) in
/-- A `UqSl2 q`-module is of type 1 when `K` acts diagonalizably with all eigenvalues integral
powers `q ^ n` of `q`. -/
abbrev IsTypeOne : Prop :=
  IsWeightModule q V (Set.range fun n : ℤ => q ^ n)

variable (q V) in
/-- A `UqSl2 q`-module is of signed type 1 when `K` acts diagonalizably with all eigenvalues
signed integral powers `± q ^ n` of `q`. -/
abbrev IsSignedTypeOne : Prop :=
  IsWeightModule q V (Set.range fun p : ℤˣ × ℤ => ((p.1 : ℤ) : ℂ) * q ^ p.2)

/-- A module is of type 1 exactly when its weight spaces of weight `q ^ n`, `n : ℤ`, span it. -/
theorem isTypeOne_iff : IsTypeOne q V ↔ ⨆ n : ℤ, weightSpace q V (q ^ n) = ⊤ := by
  rw [IsTypeOne, isWeightModule_iff, iSup_range]

/-- A module is of signed type 1 exactly when its weight spaces of weight `ε q ^ n`, for signs
`ε` and `n : ℤ`, span it. -/
theorem isSignedTypeOne_iff :
    IsSignedTypeOne q V ↔ ⨆ (ε : ℤˣ) (n : ℤ), weightSpace q V (ε * q ^ n) = ⊤ := by
  rw [IsSignedTypeOne, isWeightModule_iff, iSup_range, iSup_prod]

/-- At a generic parameter, a module is of type 1 exactly when it is the internal direct sum of
its weight spaces of weight `q ^ n`, `n : ℤ`. -/
theorem isTypeOne_iff_isInternal (hq : IsGenericQuantumParameter q) :
    IsTypeOne q V ↔ DirectSum.IsInternal fun n : ℤ => weightSpace q V (q ^ n) := by
  rw [isTypeOne_iff, DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top]
  refine ⟨fun h => ⟨?_, h⟩, And.right⟩
  simp_rw [weightSpace_def]
  exact (Algebra.lsmul ℂ ℂ V (k q)).eigenspaces_iSupIndep.comp hq.zpow_injective

/-- A module of type 1 is of signed type 1. -/
theorem IsTypeOne.isSignedTypeOne (h : IsTypeOne q V) : IsSignedTypeOne q V :=
  h.mono <| Set.range_subset_iff.mpr fun n => ⟨(1, n), by simp⟩

/-! ### Signed ladder modules -/

namespace LadderModule

variable [Fact (q ≠ 0)] {m : ℕ} {ε : ℤˣ}

/-- The signed ladder module `L_m^ε` is a weight module with weights in any set containing its
weights `ε q ^ (m - 2j)`, `0 ≤ j ≤ m`. -/
theorem isWeightModule (hS : ∀ j : Fin (m + 1), ((ε : ℤ) : ℂ) * q ^ ((m : ℤ) - 2 * j) ∈ S) :
    IsWeightModule q (LadderModule q m ε) S := by
  rw [isWeightModule_iff, eq_top_iff, ← (basis q m ε).span_eq, span_le]
  rintro _ ⟨j, rfl⟩
  rw [← vec_coe]
  exact mem_iSup_of_mem _ (mem_iSup_of_mem (hS j) (mem_weightSpace_iff.mpr (k_smul_vec _)))

/-- The positive signed ladder module `L_m^+` is of type 1. -/
theorem isTypeOne : IsTypeOne q (LadderModule q m 1) :=
  isWeightModule fun j => ⟨(m : ℤ) - 2 * j, by simp⟩

/-- Every signed ladder module `L_m^ε` is of signed type 1. -/
theorem isSignedTypeOne : IsSignedTypeOne q (LadderModule q m ε) :=
  isWeightModule fun j => ⟨(ε, (m : ℤ) - 2 * j), rfl⟩

end LadderModule

variable [Fact (q ≠ 0)]

/-- At a generic parameter, a signed ladder module `L_m^ε` embeds into a module of type 1 only for
the positive sign `ε = 1`. -/
theorem IsTypeOne.eq_one_of_injective (hq : IsGenericQuantumParameter q) (h : IsTypeOne q V)
    {m : ℕ} {ε : ℤˣ} (φ : LadderModule q m ε →ₗ[UqSl2 q] V) (hφ : Function.Injective φ) :
    ε = 1 := by
  -- The image of the highest vector `v₀` is a nonzero vector of weight `ε q ^ m`.
  have hv : φ (LadderModule.vec q m ε 0) ∈ weightSpace q V (ε * q ^ (m : ℤ)) :=
    map_weightSpace_le φ _ (mem_map_of_mem (mem_weightSpace_iff.mpr (by simp)))
  have hv0 : φ (LadderModule.vec q m ε 0) ≠ 0 :=
    (map_ne_zero_iff φ hφ).mpr (by simp)
  obtain ⟨n, hn⟩ := h.mem_of_mem_weightSpace hv hv0
  exact hq.eq_one_of_units_mul_zpow_eq_zpow hn.symm

/-- At a generic parameter, the negative signed ladder module `L_m^-` is not of type 1. For
`m = 0` this is the one-dimensional module on which `K` acts by `-1` and `E`, `F` act by zero;
being finite-dimensional, it is locally finite. -/
theorem LadderModule.not_isTypeOne (hq : IsGenericQuantumParameter q) {m : ℕ} :
    ¬ IsTypeOne q (LadderModule q m (-1)) := fun h =>
  absurd (h.eq_one_of_injective hq LinearMap.id Function.injective_id) (by decide)

/-! ### Local finiteness of weight modules -/

omit [Fact (q ≠ 0)] in
/-- The `K`-orbit of a vector of a weight module spans a finite-dimensional space. -/
private theorem finiteDimensional_span_range_kUnit_zpow_smul (h : IsWeightModule q V S) (w : V) :
    FiniteDimensional ℂ
      (span ℂ (Set.range fun b : ℤ => ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) • w)) := by
  classical
  have hw : w ∈ ⨆ μ, weightSpace q V μ :=
    (iSup₂_le fun μ _ => le_iSup _ μ : ⨆ μ ∈ S, weightSpace q V μ ≤ ⨆ μ, weightSpace q V μ)
      (h.iSup_eq_top ▸ mem_top)
  obtain ⟨c, hc, rfl⟩ := (mem_iSup_iff_exists_finsupp _ _).mp hw
  -- The orbit lies in the span of the finitely many weight components of `w`.
  refine finiteDimensional_of_le (S₂ := span ℂ ((c.support.image c : Finset V) : Set V))
    (span_le.mpr ?_)
  rintro _ ⟨b, rfl⟩
  simp only [Finsupp.sum, Finset.smul_sum, SetLike.mem_coe]
  refine sum_mem fun μ hμ => ?_
  rw [kUnit_zpow_smul_of_mem_weightSpace (hc μ)]
  exact smul_mem _ _ (subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem c hμ)))

/-- A weight module on which `E` and `F` act locally nilpotently is locally finite. -/
theorem isLocallyFiniteModule_of_isWeightModule (h : IsWeightModule q V S)
    (hE : ∀ v : V, ∃ n : ℕ, e q ^ n • v = 0) (hF : ∀ v : V, ∃ n : ℕ, f q ^ n • v = 0) :
    IsLocallyFiniteModule ℂ (UqSl2 q) V := by
  refine isLocallyFiniteModule_iff.mpr fun v => ?_
  obtain ⟨N, hN⟩ := hE v
  choose nF hnF using hF
  let orbit (w : V) : Submodule ℂ V :=
    span ℂ (Set.range fun b : ℤ => ((kUnit q ^ b : (UqSl2 q)ˣ) : UqSl2 q) • w)
  have : ∀ w, FiniteDimensional ℂ (orbit w) :=
    finiteDimensional_span_range_kUnit_zpow_smul h
  -- The span of the `K`-orbits of the finitely many nonzero vectors `F^a E^c v`.
  let X : Submodule ℂ V :=
    ⨆ (c : Fin N) (a : Fin (nF (e q ^ (c : ℕ) • v))), orbit (f q ^ (a : ℕ) • e q ^ (c : ℕ) • v)
  -- Every PBW monomial `F^a K^b E^c` sends `v` into `X`.
  have hmem (u : UqSl2 q) : u • v ∈ X := by
    induction (pbwBasis q).mem_span u using span_induction with
    | mem x hx =>
      obtain ⟨⟨a, b, c⟩, rfl⟩ := hx
      rw [pbwBasis_apply, mul_smul, f_pow_mul_kUnit_zpow, smul_assoc, mul_smul]
      refine smul_mem _ _ ?_
      by_cases hc : c < N
      · by_cases ha : a < nF (e q ^ c • v)
        · exact mem_iSup_of_mem (⟨c, hc⟩ : Fin N) (mem_iSup_of_mem (⟨a, ha⟩ : Fin _)
            (subset_span ⟨b, rfl⟩))
        · rw [← Nat.sub_add_cancel (not_lt.mp ha), pow_add, mul_smul, hnF, smul_zero, smul_zero]
          exact zero_mem _
      · rw [← Nat.sub_add_cancel (not_lt.mp hc), pow_add, mul_smul, hN, smul_zero, smul_zero,
          smul_zero]
        exact zero_mem _
    | zero => simp
    | add x y _ _ hx hy => simpa [add_smul] using add_mem hx hy
    | smul r x _ hx => simpa [smul_assoc] using smul_mem X r hx
  have hle : (span (UqSl2 q) {v}).restrictScalars ℂ ≤ X := fun w hw => by
    obtain ⟨u, rfl⟩ := mem_span_singleton.mp hw
    exact hmem u
  exact (fg_iff_finiteDimensional _).mpr (finiteDimensional_of_le hle)

/-! ### Classification -/

/-- A direct sum of positive signed ladder modules `L_m^+` is of type 1. -/
theorem isTypeOne_of_linearEquiv_dfinsupp_ladderModule {ι : Type*} {m : ι → ℕ}
    (e : V ≃ₗ[UqSl2 q] Π₀ i, LadderModule q (m i) 1) : IsTypeOne q V :=
  (IsWeightModule.dfinsupp fun _ => LadderModule.isTypeOne).of_surjective e.symm.toLinearMap
    e.symm.surjective

section Classification

variable {V : Type u} [AddCommGroup V] [Module ℂ V] [Module (UqSl2 q) V]
  [IsScalarTower ℂ (UqSl2 q) V]

/-- At a generic parameter, a locally finite module of type 1 is isomorphic to a direct sum of
positive signed ladder modules `L_m^+`. -/
theorem IsTypeOne.exists_linearEquiv_dfinsupp_ladderModule (hq : IsGenericQuantumParameter q)
    (h : IsTypeOne q V) [IsLocallyFiniteModule ℂ (UqSl2 q) V] :
    ∃ (ι : Type u) (m : ι → ℕ), Nonempty (V ≃ₗ[UqSl2 q] Π₀ i, LadderModule q (m i) 1) := by
  classical
  obtain ⟨ι, m, ε, ⟨e⟩⟩ := TauCeti.UqSl2.exists_linearEquiv_dfinsupp_ladderModule hq (V := V)
  -- Each summand embeds into `V`, so its sign is positive.
  have hε (i : ι) : ε i = 1 := by
    refine h.eq_one_of_injective hq (e.symm.toLinearMap ∘ₗ
      DFinsupp.lsingle (R := UqSl2 q) (M := fun i => LadderModule q (m i) (ε i)) i)
      fun x y hxy => ?_
    simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
      DFinsupp.lsingle_apply, EmbeddingLike.apply_eq_iff_eq] at hxy
    exact DFinsupp.single_injective (β := fun i => LadderModule q (m i) (ε i)) hxy
  obtain rfl : ε = fun _ => 1 := funext hε
  exact ⟨ι, m, ⟨e⟩⟩

/-- **Type-1 locally finite modules.** At a generic parameter, a module is of type 1 and locally
finite exactly when it is isomorphic to a direct sum of positive signed ladder modules `L_m^+`. -/
theorem isTypeOne_and_isLocallyFiniteModule_iff_exists_linearEquiv_dfinsupp_ladderModule
    (hq : IsGenericQuantumParameter q) :
    IsTypeOne q V ∧ IsLocallyFiniteModule ℂ (UqSl2 q) V ↔
      ∃ (ι : Type u) (m : ι → ℕ), Nonempty (V ≃ₗ[UqSl2 q] Π₀ i, LadderModule q (m i) 1) :=
  ⟨fun ⟨h, _⟩ => h.exists_linearEquiv_dfinsupp_ladderModule hq,
    fun ⟨_, _, ⟨e⟩⟩ => ⟨isTypeOne_of_linearEquiv_dfinsupp_ladderModule e, .of_linearEquiv e⟩⟩

/-- **Type-1 modules with locally nilpotent `E` and `F`.** At a generic parameter, a module is of
type 1 with `E` and `F` acting locally nilpotently exactly when it is isomorphic to a direct sum of
positive signed ladder modules `L_m^+`. -/
theorem isTypeOne_and_forall_exists_pow_smul_eq_zero_iff_exists_linearEquiv_dfinsupp_ladderModule
    (hq : IsGenericQuantumParameter q) :
    (IsTypeOne q V ∧ (∀ v : V, ∃ n : ℕ, e q ^ n • v = 0) ∧ ∀ v : V, ∃ n : ℕ, f q ^ n • v = 0) ↔
      ∃ (ι : Type u) (m : ι → ℕ), Nonempty (V ≃ₗ[UqSl2 q] Π₀ i, LadderModule q (m i) 1) := by
  rw [← isTypeOne_and_isLocallyFiniteModule_iff_exists_linearEquiv_dfinsupp_ladderModule hq]
  exact ⟨fun ⟨h, hE, hF⟩ => ⟨h, isLocallyFiniteModule_of_isWeightModule h hE hF⟩,
    fun ⟨h, _⟩ => ⟨h, exists_e_pow_smul_eq_zero_of_isLocallyFiniteModule hq,
      exists_f_pow_smul_eq_zero_of_isLocallyFiniteModule hq⟩⟩

/-- **Signed type-1 modules.** At a generic parameter, a module is of signed type 1 with `E` and
`F` acting locally nilpotently exactly when it is locally finite. -/
theorem isSignedTypeOne_and_forall_exists_pow_smul_eq_zero_iff_isLocallyFiniteModule
    (hq : IsGenericQuantumParameter q) :
    (IsSignedTypeOne q V ∧ (∀ v : V, ∃ n : ℕ, e q ^ n • v = 0) ∧
      ∀ v : V, ∃ n : ℕ, f q ^ n • v = 0) ↔ IsLocallyFiniteModule ℂ (UqSl2 q) V := by
  refine ⟨fun ⟨h, hE, hF⟩ => isLocallyFiniteModule_of_isWeightModule h hE hF, fun _ => ?_⟩
  obtain ⟨ι, m, ε, ⟨e⟩⟩ := exists_linearEquiv_dfinsupp_ladderModule hq (V := V)
  exact ⟨(IsWeightModule.dfinsupp fun _ => LadderModule.isSignedTypeOne).of_surjective
    e.symm.toLinearMap e.symm.surjective, exists_e_pow_smul_eq_zero_of_isLocallyFiniteModule hq,
    exists_f_pow_smul_eq_zero_of_isLocallyFiniteModule hq⟩

end Classification

end TauCeti.UqSl2
