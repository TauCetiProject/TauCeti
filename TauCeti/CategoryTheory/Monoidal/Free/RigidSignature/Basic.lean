/-!
# The free rigid monoidal category on a rigid signature

A *rigid signature* consists of a type of generating objects and a type of generating morphisms
(*coupons*), each coupon having a source and a target in `TauCeti.RigidObject`, the syntax of
formal tensor products, units, right duals, and left duals. As for `TauCeti.TensorSignature`,
coupons keep their explicit boundary ports rather than collapsing a composite boundary to a single
atom, empty boundaries are represented by `RigidObject.unit`, and the generating types need not be
finite. Every `TensorSignature` embeds into a `RigidSignature` via
`TensorSignature.toRigidSignature`.

The free rigid monoidal category `RigidSignature.FreeRigid S` on a signature `S` has
`RigidObject S.Obj` as objects. Its morphisms are formal composites, tensor products, and
whiskerings of identities, associators, unitors, right and left coevaluations and evaluations, and
coupons, modulo exactly the axioms of a rigid monoidal category (the monoidal axioms together with
the four zigzag identities). No pivotal identification `X ≅ Xᘁᘁ` and no equation between coupons
is imposed. The construction extends `TauCeti.TensorSignature.FreeMonoidal` (following
`Mathlib/CategoryTheory/Monoidal/Free/Basic.lean`, Markus Himmel) by chosen right and left dual
objects and their exact pairings.

The uniqueness half of the universal property (`FreeRigid.monoidalNatIso` and
`FreeRigid.natTrans_ext`) is established in
`TauCeti.CategoryTheory.Monoidal.Free.RigidSignature.Uniqueness`.

## Main definitions and results

* `TauCeti.RigidSignature` and `TauCeti.TensorSignature.toRigidSignature`: generating objects and
  coupons with formal rigid-object boundaries, together with the inclusion from tensor signatures.
* `TauCeti.RigidSignature.FreeRigid S`: the free rigid monoidal category on `S`, with
  `Category`, `MonoidalCategory`, `RightRigidCategory`, `LeftRigidCategory`, and `RigidCategory`
  instances, and generators `FreeRigid.of` and `FreeRigid.coupon`.
* `FreeRigid.Hom.inductionOn`: morphisms are generated by identities, structural isomorphisms,
  chosen right and left evaluations and coevaluations, and coupons under composition and
  whiskering.
* `FreeRigid.lift fo fc`: the strong monoidal functor into an arbitrary (not necessarily strict)
  rigid monoidal category determined by images `fo` of the generating objects and `fc` of the
  coupons, preserving chosen duals strictly (`FreeRigid.lift_mapRightDualIso` and
  `FreeRigid.lift_mapLeftDualIso`).
* `FreeRigid.couponCount`, `FreeRigid.coupon_ne_id`, and `FreeRigid.coupon_ne_coupon`: coupon
  multiplicity is invariant under the rigid-category axioms, so no coupon collapses to an identity
  and distinct coupons with matching boundaries remain distinct.
* `TauCeti.TensorSignature.ofFreeMonoidal`: the canonical strong monoidal functor from
  `S.FreeMonoidal` into `S.toRigidSignature.FreeRigid`.

## References

* A. Joyal and R. Street, *The geometry of tensor calculus I*, Adv. Math. 88 (1991), §1.
* A. Joyal and R. Street, *Planar diagrams and tensor algebra* (1988), §2.
* P. Selinger, *A survey of graphical languages for monoidal categories*, Lecture Notes in Physics
  813 (2011), §4.1.
-/

public section

universe u v u' v'

open CategoryTheory MonoidalCategory

namespace TauCeti

/-- A rigid signature: a type `Obj` of generating objects and a type `Coupon` of generating
morphisms, each coupon having a source and a target formal rigid object expression in `Obj`.
The empty boundary is `RigidObject.unit`, so coupons may have no inputs or no outputs. -/
structure RigidSignature where
  /-- The generating objects. -/
  Obj : Type u
  /-- The generating morphisms (coupons). -/
  Coupon : Type v
  /-- The source expression of a coupon. -/
  src : Coupon → RigidObject Obj
  /-- The target expression of a coupon. -/
  tgt : Coupon → RigidObject Obj

/-- Include a tensor signature as a rigid signature by embedding its monoidal word boundaries
into `RigidObject`. Exposed so that `S.toRigidSignature.Obj` and `S.toRigidSignature.Coupon` are
definitionally `S.Obj` and `S.Coupon`. -/
@[expose] def TensorSignature.toRigidSignature (S : TensorSignature.{u, v}) :
    RigidSignature.{u, v} where
  Obj := S.Obj
  Coupon := S.Coupon
  src g := (S.src g).toRigidObject
  tgt g := (S.tgt g).toRigidObject

@[simp]
theorem TensorSignature.toRigidSignature_obj (S : TensorSignature.{u, v}) :
    S.toRigidSignature.Obj = S.Obj := by rfl

@[simp]
theorem TensorSignature.toRigidSignature_coupon (S : TensorSignature.{u, v}) :
    S.toRigidSignature.Coupon = S.Coupon := by rfl

@[simp]
theorem TensorSignature.toRigidSignature_src (S : TensorSignature.{u, v}) (g : S.Coupon) :
    S.toRigidSignature.src g = (S.src g).toRigidObject := by rfl

@[simp]
theorem TensorSignature.toRigidSignature_tgt (S : TensorSignature.{u, v}) (g : S.Coupon) :
    S.toRigidSignature.tgt g = (S.tgt g).toRigidObject := by rfl

namespace RigidSignature

variable (S : RigidSignature.{u, v})

/-- Extra morphism generators of `S.FreeRigid`: chosen right and left coevaluations and
evaluations together with a generator for each coupon of `S`. -/
inductive FreeRigidGen (S : RigidSignature.{u, v}) :
    RigidObject S.Obj → RigidObject S.Obj → Type (max u v)
  | η_right (X : RigidObject S.Obj) : FreeRigidGen S .unit (X.tensor X.rightDual)
  | ε_right (X : RigidObject S.Obj) : FreeRigidGen S (X.rightDual.tensor X) .unit
  | η_left (X : RigidObject S.Obj) : FreeRigidGen S .unit (X.leftDual.tensor X)
  | ε_left (X : RigidObject S.Obj) : FreeRigidGen S (X.tensor X.leftDual) .unit
  | coupon (g : S.Coupon) : FreeRigidGen S (S.src g) (S.tgt g)

/-- The extra relations on formal rigid morphisms generated by the four zigzag identities of a
rigid monoidal category. -/
inductive FreeRigidRel (S : RigidSignature.{u, v}) :
    ∀ {X Y : RigidObject S.Obj},
      MonoidalCore.Hom RigidObject.unit RigidObject.tensor (FreeRigidGen S) X Y →
      MonoidalCore.Hom RigidObject.unit RigidObject.tensor (FreeRigidGen S) X Y → Prop
  | coevaluation_evaluation_right {X} :
      FreeRigidRel S
        (((MonoidalCore.Hom.gen (.η_right X)).whiskerLeft X.rightDual).comp
          ((MonoidalCore.Hom.α_inv X.rightDual X X.rightDual).comp
            ((MonoidalCore.Hom.gen (.ε_right X)).whiskerRight X.rightDual)))
        ((MonoidalCore.Hom.ρ_hom X.rightDual).comp (MonoidalCore.Hom.l_inv X.rightDual))
  | evaluation_coevaluation_right {X} :
      FreeRigidRel S
        (((MonoidalCore.Hom.gen (.η_right X)).whiskerRight X).comp
          ((MonoidalCore.Hom.α_hom X X.rightDual X).comp
            ((MonoidalCore.Hom.gen (.ε_right X)).whiskerLeft X)))
        ((MonoidalCore.Hom.l_hom X).comp (MonoidalCore.Hom.ρ_inv X))
  | coevaluation_evaluation_left {X} :
      FreeRigidRel S
        (((MonoidalCore.Hom.gen (.η_left X)).whiskerLeft X).comp
          ((MonoidalCore.Hom.α_inv X X.leftDual X).comp
            ((MonoidalCore.Hom.gen (.ε_left X)).whiskerRight X)))
        ((MonoidalCore.Hom.ρ_hom X).comp (MonoidalCore.Hom.l_inv X))
  | evaluation_coevaluation_left {X} :
      FreeRigidRel S
        (((MonoidalCore.Hom.gen (.η_left X)).whiskerRight X.leftDual).comp
          ((MonoidalCore.Hom.α_hom X.leftDual X X.leftDual).comp
            ((MonoidalCore.Hom.gen (.ε_left X)).whiskerLeft X.leftDual)))
        ((MonoidalCore.Hom.l_hom X.leftDual).comp (MonoidalCore.Hom.ρ_inv X.leftDual))

/-- The monoidal presentation of the free rigid monoidal category on a rigid signature `S`:
formal rigid object expressions `RigidObject S.Obj`, duality and coupon generators
`FreeRigidGen S`, and zigzag relations `FreeRigidRel S`. -/
@[expose] def freeRigidPresentation (S : RigidSignature.{u, v}) :
    MonoidalCore.Presentation.{u, max u v} where
  Obj := RigidObject S.Obj
  unitObj := RigidObject.unit
  tensorObj := RigidObject.tensor
  Gen := FreeRigidGen S
  Rel := FreeRigidRel S

/-- The free rigid monoidal category on a rigid signature `S`. Its objects are formal rigid object
expressions in the generating objects of `S`. -/
abbrev FreeRigid (S : RigidSignature.{u, v}) : Type u :=
  MonoidalCore.Free (freeRigidPresentation S)

namespace FreeRigid

variable {S}

/-- Construct an object of `S.FreeRigid` from a formal rigid object expression. -/
abbrev mk (as : RigidObject S.Obj) : S.FreeRigid := ⟨as⟩

/-- Extract the underlying formal rigid object expression of an object of `S.FreeRigid`. -/
abbrev as (X : S.FreeRigid) : RigidObject S.Obj := MonoidalCore.Free.as X

/-- The object of the free rigid monoidal category given by a single generating object. Exposed so
that object evaluation and substitution simplify definitionally at generators. -/
@[expose] def of (a : S.Obj) : S.FreeRigid := ⟨.of a⟩

/-- Wrapping a generating object expression `RigidObject.of a` gives `of a`. -/
@[simp]
theorem mk_of (a : S.Obj) : (⟨RigidObject.of a⟩ : S.FreeRigid) = of a := rfl

/-- Wrapping the unit expression `RigidObject.unit` gives `𝟙_ S.FreeRigid`. -/
@[simp]
theorem mk_tensorUnit : (⟨RigidObject.unit⟩ : S.FreeRigid) = 𝟙_ S.FreeRigid := rfl

/-- Wrapping a formal tensor expression gives the tensor product in `S.FreeRigid`. -/
@[simp]
theorem mk_tensor (X Y : RigidObject S.Obj) :
    (⟨RigidObject.tensor X Y⟩ : S.FreeRigid) = ⟨X⟩ ⊗ ⟨Y⟩ := rfl

/-- Formal composites, tensor products, and whiskerings of identities, associators, unitors,
right and left coevaluations and evaluations, and coupons. The morphisms of `S.FreeRigid` are a
quotient of these. -/
abbrev Hom (X Y : RigidObject S.Obj) : Type (max u v) :=
  MonoidalCore.Hom RigidObject.unit RigidObject.tensor (FreeRigidGen S) X Y

/-- The formal right coevaluation on a formal rigid object expression. -/
@[match_pattern] abbrev Hom.ηRight (X : RigidObject S.Obj) :
    Hom (S := S) .unit (X.tensor X.rightDual) :=
  MonoidalCore.Hom.gen (.η_right X)

/-- The formal right evaluation on a formal rigid object expression. -/
@[match_pattern] abbrev Hom.εRight (X : RigidObject S.Obj) :
    Hom (S := S) (X.rightDual.tensor X) .unit :=
  MonoidalCore.Hom.gen (.ε_right X)

/-- The formal left coevaluation on a formal rigid object expression. -/
@[match_pattern] abbrev Hom.ηLeft (X : RigidObject S.Obj) :
    Hom (S := S) .unit (X.leftDual.tensor X) :=
  MonoidalCore.Hom.gen (.η_left X)

/-- The formal left evaluation on a formal rigid object expression. -/
@[match_pattern] abbrev Hom.εLeft (X : RigidObject S.Obj) :
    Hom (S := S) (X.tensor X.leftDual) .unit :=
  MonoidalCore.Hom.gen (.ε_left X)

/-- The formal morphism given by a coupon `g` of `S`. -/
@[match_pattern] abbrev Hom.coupon (g : S.Coupon) : Hom (S := S) (S.src g) (S.tgt g) :=
  MonoidalCore.Hom.gen (.coupon g)

/-- The relation on formal morphisms generated by the axioms of a rigid monoidal category
(the monoidal-category axioms together with the four zigzag identities) and closed under
composition, whiskering, and tensor products. It imposes no pivotal identification and no equation
between coupons. -/
abbrev HomEquiv {X Y : RigidObject S.Obj} (f g : Hom (S := S) X Y) : Prop :=
  MonoidalCore.HomEquiv (FreeRigidRel S) f g

/-- Formal morphisms are identified when the axioms of a rigid monoidal category make them
equal. -/
abbrev setoidHom (X Y : RigidObject S.Obj) : Setoid (Hom (S := S) X Y) :=
  MonoidalCore.setoidHom RigidObject.unit RigidObject.tensor (FreeRigidGen S) (FreeRigidRel S) X Y

/-- The morphism of the free rigid monoidal category represented by a formal morphism. -/
abbrev homMk {X Y : S.FreeRigid} (f : Hom (S := S) X.as Y.as) : X ⟶ Y :=
  MonoidalCore.homMk f

/-- Two formal morphisms represent the same morphism of `S.FreeRigid` if and only if they are
related by `HomEquiv`. -/
theorem homMk_eq_iff {X Y : S.FreeRigid} (f g : Hom (S := S) X.as Y.as) :
    homMk f = homMk g ↔ HomEquiv f g :=
  MonoidalCore.homMk_eq_iff (P := freeRigidPresentation S) f g

instance : RightRigidCategory S.FreeRigid where
  rightDual X :=
    { rightDual := ⟨X.as.rightDual⟩
      exact :=
        { coevaluation' := homMk (X := 𝟙_ _) (Y := X ⊗ ⟨X.as.rightDual⟩) (Hom.ηRight X.as)
          evaluation' := homMk (X := ⟨X.as.rightDual⟩ ⊗ X) (Y := 𝟙_ _) (Hom.εRight X.as)
          coevaluation_evaluation' := Quotient.sound (.extra .coevaluation_evaluation_right)
          evaluation_coevaluation' := Quotient.sound (.extra .evaluation_coevaluation_right) } }

instance : LeftRigidCategory S.FreeRigid where
  leftDual X :=
    { leftDual := ⟨X.as.leftDual⟩
      exact :=
        { coevaluation' := homMk (X := 𝟙_ _) (Y := ⟨X.as.leftDual⟩ ⊗ X) (Hom.ηLeft X.as)
          evaluation' := homMk (X := X ⊗ ⟨X.as.leftDual⟩) (Y := 𝟙_ _) (Hom.εLeft X.as)
          coevaluation_evaluation' := Quotient.sound (.extra .coevaluation_evaluation_left)
          evaluation_coevaluation' := Quotient.sound (.extra .evaluation_coevaluation_left) } }

instance : RigidCategory S.FreeRigid where

/-- The generating morphism given by a coupon, from its source expression to its target
expression. -/
@[expose] def coupon (g : S.Coupon) : (⟨S.src g⟩ : S.FreeRigid) ⟶ ⟨S.tgt g⟩ :=
  homMk (Hom.coupon g)

@[simp]
theorem homMk_id (X : S.FreeRigid) : homMk (MonoidalCore.Hom.id X.as) = 𝟙 X := rfl

@[simp]
theorem homMk_comp {X Y Z : S.FreeRigid}
    (f : Hom (S := S) X.as Y.as) (g : Hom (S := S) Y.as Z.as) :
    homMk (Y := Z) (f.comp g) = homMk f ≫ homMk g := rfl

@[simp]
theorem homMk_tensor {X₁ Y₁ X₂ Y₂ : S.FreeRigid}
    (f : Hom (S := S) X₁.as Y₁.as) (g : Hom (S := S) X₂.as Y₂.as) :
    homMk (X := X₁ ⊗ X₂) (Y := Y₁ ⊗ Y₂) (f.tensor g) = homMk f ⊗ₘ homMk g := rfl

@[simp]
theorem homMk_whiskerLeft (X : S.FreeRigid) {Y₁ Y₂ : S.FreeRigid}
    (f : Hom (S := S) Y₁.as Y₂.as) :
    homMk (X := X ⊗ Y₁) (Y := X ⊗ Y₂) (f.whiskerLeft X.as) = X ◁ homMk f := rfl

@[simp]
theorem homMk_whiskerRight {X₁ X₂ : S.FreeRigid}
    (f : Hom (S := S) X₁.as X₂.as) (Y : S.FreeRigid) :
    homMk (X := X₁ ⊗ Y) (Y := X₂ ⊗ Y) (f.whiskerRight Y.as) = homMk f ▷ Y := rfl

@[simp]
theorem homMk_α_hom (X Y Z : S.FreeRigid) :
    homMk (X := (X ⊗ Y) ⊗ Z) (Y := X ⊗ (Y ⊗ Z))
      (MonoidalCore.Hom.α_hom X.as Y.as Z.as) = (α_ X Y Z).hom :=
  rfl

@[simp]
theorem homMk_α_inv (X Y Z : S.FreeRigid) :
    homMk (X := X ⊗ (Y ⊗ Z)) (Y := (X ⊗ Y) ⊗ Z)
      (MonoidalCore.Hom.α_inv X.as Y.as Z.as) = (α_ X Y Z).inv :=
  rfl

@[simp]
theorem homMk_l_hom (X : S.FreeRigid) :
    homMk (X := 𝟙_ _ ⊗ X) (MonoidalCore.Hom.l_hom X.as) = (λ_ X).hom := rfl

@[simp]
theorem homMk_l_inv (X : S.FreeRigid) :
    homMk (Y := 𝟙_ _ ⊗ X) (MonoidalCore.Hom.l_inv X.as) = (λ_ X).inv := rfl

@[simp]
theorem homMk_ρ_hom (X : S.FreeRigid) :
    homMk (X := X ⊗ 𝟙_ _) (MonoidalCore.Hom.ρ_hom X.as) = (ρ_ X).hom := rfl

@[simp]
theorem homMk_ρ_inv (X : S.FreeRigid) :
    homMk (Y := X ⊗ 𝟙_ _) (MonoidalCore.Hom.ρ_inv X.as) = (ρ_ X).inv := rfl

@[simp]
theorem homMk_η_right (X : S.FreeRigid) :
    homMk (X := 𝟙_ _) (Y := X ⊗ (RightRigidCategory.rightDual X).rightDual) (Hom.ηRight X.as) =
      @ExactPairing.coevaluation S.FreeRigid _ _ X _ (RightRigidCategory.rightDual X).exact :=
  rfl

@[simp]
theorem homMk_ε_right (X : S.FreeRigid) :
    homMk (X := (RightRigidCategory.rightDual X).rightDual ⊗ X) (Y := 𝟙_ _) (Hom.εRight X.as) =
      @ExactPairing.evaluation S.FreeRigid _ _ X _ (RightRigidCategory.rightDual X).exact :=
  rfl

@[simp]
theorem homMk_η_left (X : S.FreeRigid) :
    homMk (X := 𝟙_ _) (Y := (LeftRigidCategory.leftDual X).leftDual ⊗ X) (Hom.ηLeft X.as) =
      @ExactPairing.coevaluation S.FreeRigid _ _ _ X (LeftRigidCategory.leftDual X).exact :=
  rfl

@[simp]
theorem homMk_ε_left (X : S.FreeRigid) :
    homMk (X := X ⊗ (LeftRigidCategory.leftDual X).leftDual) (Y := 𝟙_ _) (Hom.εLeft X.as) =
      @ExactPairing.evaluation S.FreeRigid _ _ _ X (LeftRigidCategory.leftDual X).exact :=
  rfl

@[simp]
theorem homMk_coupon (g : S.Coupon) :
    homMk (X := ⟨S.src g⟩) (Y := ⟨S.tgt g⟩) (Hom.coupon g) = coupon g := rfl

/-- The chosen right dual of `X` in `S.FreeRigid` is the formal right dual expression. -/
theorem rightDual_eq (X : S.FreeRigid) :
    (RightRigidCategory.rightDual X).rightDual = ⟨X.as.rightDual⟩ := rfl

/-- The chosen left dual of `X` in `S.FreeRigid` is the formal left dual expression. -/
theorem leftDual_eq (X : S.FreeRigid) :
    (LeftRigidCategory.leftDual X).leftDual = ⟨X.as.leftDual⟩ := rfl

/-- Double right duality does not identify a generating object with itself in `S.FreeRigid`. -/
theorem of_ne_doubleRightDual (a : S.Obj) :
    of a ≠
      (RightRigidCategory.rightDual (RightRigidCategory.rightDual (of a)).rightDual).rightDual := by
  intro h
  exact RigidObject.normalize_rightDual_rightDual_ne a
    (congrArg (RigidObject.normalize ∘ FreeRigid.as) h).symm

/-- Induction principle for morphisms of the free rigid monoidal category: a property of morphisms
holding for identities, associators, unitors, chosen right and left coevaluations and evaluations,
and coupons, and stable under composition and whiskering on either side, holds for every
morphism. -/
theorem Hom.inductionOn {motive : {X Y : S.FreeRigid} → (X ⟶ Y) → Prop} {X Y : S.FreeRigid}
    (t : X ⟶ Y)
    (id : (X : S.FreeRigid) → motive (𝟙 X))
    (α_hom : (X Y Z : S.FreeRigid) → motive (α_ X Y Z).hom)
    (α_inv : (X Y Z : S.FreeRigid) → motive (α_ X Y Z).inv)
    (l_hom : (X : S.FreeRigid) → motive (λ_ X).hom)
    (l_inv : (X : S.FreeRigid) → motive (λ_ X).inv)
    (ρ_hom : (X : S.FreeRigid) → motive (ρ_ X).hom)
    (ρ_inv : (X : S.FreeRigid) → motive (ρ_ X).inv)
    (η_right : (X : S.FreeRigid) →
      motive (@ExactPairing.coevaluation S.FreeRigid _ _ X _
        (RightRigidCategory.rightDual X).exact))
    (ε_right : (X : S.FreeRigid) →
      motive (@ExactPairing.evaluation S.FreeRigid _ _ X _
        (RightRigidCategory.rightDual X).exact))
    (η_left : (X : S.FreeRigid) →
      motive (@ExactPairing.coevaluation S.FreeRigid _ _ _ X
        (LeftRigidCategory.leftDual X).exact))
    (ε_left : (X : S.FreeRigid) →
      motive (@ExactPairing.evaluation S.FreeRigid _ _ _ X
        (LeftRigidCategory.leftDual X).exact))
    (coupon : (g : S.Coupon) → motive (FreeRigid.coupon g))
    (comp : {X Y Z : S.FreeRigid} → (f : X ⟶ Y) → (g : Y ⟶ Z) → motive f → motive g →
      motive (f ≫ g))
    (whiskerLeft : (X : S.FreeRigid) → {Y Z : S.FreeRigid} → (f : Y ⟶ Z) → motive f →
      motive (X ◁ f))
    (whiskerRight : {X Y : S.FreeRigid} → (f : X ⟶ Y) → (Z : S.FreeRigid) → motive f →
      motive (f ▷ Z)) :
    motive t :=
  MonoidalCore.Hom.inductionOn t id α_hom α_inv l_hom l_inv ρ_hom ρ_inv
    (fun
      | .η_right X => η_right ⟨X⟩
      | .ε_right X => ε_right ⟨X⟩
      | .η_left X => η_left ⟨X⟩
      | .ε_left X => ε_left ⟨X⟩
      | .coupon g => coupon g)
    comp whiskerLeft whiskerRight

section Lift

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D] [RigidCategory D] (fo : S.Obj → D)
  (fc : ∀ g : S.Coupon,
    RigidObject.projectObj fo (S.src g) ⟶ RigidObject.projectObj fo (S.tgt g))

/-- The functor out of the free rigid monoidal category on `S` determined by the images `fo` of
the generating objects and `fc` of the coupons. It is strong monoidal, with identity tensorator
and unit comparison, and preserves chosen right and left duals on the nose. Exposed so that its
object action computes definitionally as `RigidObject.projectObj fo`. -/
@[expose] def lift : S.FreeRigid ⥤ D :=
  MonoidalCore.lift
    { obj := fun X ↦ RigidObject.projectObj fo X
      αHom := fun _ _ _ ↦ (α_ _ _ _).hom
      αInv := fun _ _ _ ↦ (α_ _ _ _).inv
      lHom := fun _ ↦ (λ_ _).hom
      lInv := fun _ ↦ (λ_ _).inv
      ρHom := fun _ ↦ (ρ_ _).hom
      ρInv := fun _ ↦ (ρ_ _).inv
      whiskerLeft := fun X {_ _} f ↦ RigidObject.projectObj fo X ◁ f
      whiskerRight := fun {_ _} f X ↦ f ▷ RigidObject.projectObj fo X
      tensorHom := fun {_ _ _ _} f g ↦ f ⊗ₘ g }
    (MonoidalCore.MonoidalEval.Lawful.ofMonoidal _ rfl (fun _ _ ↦ rfl)
      (fun _ _ _ ↦ HEq.rfl) (fun _ _ _ ↦ HEq.rfl) (fun _ ↦ HEq.rfl) (fun _ ↦ HEq.rfl)
      (fun _ ↦ HEq.rfl) (fun _ ↦ HEq.rfl) (fun _ {_ _} _ ↦ HEq.rfl)
      (fun {_ _} _ _ ↦ HEq.rfl) (fun {_ _ _ _} _ _ ↦ HEq.rfl))
    (fun
      | .η_right X =>
        @ExactPairing.coevaluation D _ _ (RigidObject.projectObj fo X) _
          (RightRigidCategory.rightDual (RigidObject.projectObj fo X)).exact
      | .ε_right X =>
        @ExactPairing.evaluation D _ _ (RigidObject.projectObj fo X) _
          (RightRigidCategory.rightDual (RigidObject.projectObj fo X)).exact
      | .η_left X =>
        @ExactPairing.coevaluation D _ _ _ (RigidObject.projectObj fo X)
          (LeftRigidCategory.leftDual (RigidObject.projectObj fo X)).exact
      | .ε_left X =>
        @ExactPairing.evaluation D _ _ _ (RigidObject.projectObj fo X)
          (LeftRigidCategory.leftDual (RigidObject.projectObj fo X)).exact
      | .coupon g => fc g)
    (by
      rintro X Y f g hrel
      cases hrel with
      | @coevaluation_evaluation_right X =>
        exact @ExactPairing.coevaluation_evaluation D _ _ (RigidObject.projectObj fo X) _
          (RightRigidCategory.rightDual (RigidObject.projectObj fo X)).exact
      | @evaluation_coevaluation_right X =>
        exact @ExactPairing.evaluation_coevaluation D _ _ (RigidObject.projectObj fo X) _
          (RightRigidCategory.rightDual (RigidObject.projectObj fo X)).exact
      | @coevaluation_evaluation_left X =>
        exact @ExactPairing.coevaluation_evaluation D _ _ _ (RigidObject.projectObj fo X)
          (LeftRigidCategory.leftDual (RigidObject.projectObj fo X)).exact
      | @evaluation_coevaluation_left X =>
        exact @ExactPairing.evaluation_coevaluation D _ _ _ (RigidObject.projectObj fo X)
          (LeftRigidCategory.leftDual (RigidObject.projectObj fo X)).exact)

@[simp]
theorem lift_obj_of (a : S.Obj) : (lift fo fc).obj (of a) = fo a := rfl

@[simp]
theorem lift_obj_tensor (X Y : S.FreeRigid) :
    (lift fo fc).obj (X ⊗ Y) = (lift fo fc).obj X ⊗ (lift fo fc).obj Y := rfl

@[simp]
theorem lift_obj_tensorUnit : (lift fo fc).obj (𝟙_ S.FreeRigid) = 𝟙_ D := rfl

@[simp]
theorem lift_obj_rightDual (X : S.FreeRigid) :
    (lift fo fc).obj (RightRigidCategory.rightDual X).rightDual =
      (RightRigidCategory.rightDual ((lift fo fc).obj X)).rightDual := rfl

@[simp]
theorem lift_obj_leftDual (X : S.FreeRigid) :
    (lift fo fc).obj (LeftRigidCategory.leftDual X).leftDual =
      (LeftRigidCategory.leftDual ((lift fo fc).obj X)).leftDual := rfl

@[simp]
theorem lift_map_coupon (g : S.Coupon) : (lift fo fc).map (coupon g) = fc g := by
  unfold coupon; rfl

@[simp]
theorem lift_map_whiskerLeft (X : S.FreeRigid) {Y₁ Y₂ : S.FreeRigid} (f : Y₁ ⟶ Y₂) :
    (lift fo fc).map (X ◁ f) = (lift fo fc).obj X ◁ (lift fo fc).map f := by
  induction f using Quotient.inductionOn; rfl

@[simp]
theorem lift_map_whiskerRight {X₁ X₂ : S.FreeRigid} (f : X₁ ⟶ X₂) (Y : S.FreeRigid) :
    (lift fo fc).map (f ▷ Y) = (lift fo fc).map f ▷ (lift fo fc).obj Y := by
  induction f using Quotient.inductionOn; rfl

@[simp]
theorem lift_map_tensorHom {X₁ Y₁ X₂ Y₂ : S.FreeRigid} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂) :
    (lift fo fc).map (f ⊗ₘ g) = (lift fo fc).map f ⊗ₘ (lift fo fc).map g := by
  induction f using Quotient.inductionOn; induction g using Quotient.inductionOn; rfl

@[simp]
theorem lift_map_associator_hom (X Y Z : S.FreeRigid) :
    (lift fo fc).map (α_ X Y Z).hom =
      (α_ ((lift fo fc).obj X) ((lift fo fc).obj Y) ((lift fo fc).obj Z)).hom := by rfl

@[simp]
theorem lift_map_associator_inv (X Y Z : S.FreeRigid) :
    (lift fo fc).map (α_ X Y Z).inv =
      (α_ ((lift fo fc).obj X) ((lift fo fc).obj Y) ((lift fo fc).obj Z)).inv := by rfl

@[simp]
theorem lift_map_coevaluation_right (X : S.FreeRigid) :
    (lift fo fc).map
        (@ExactPairing.coevaluation S.FreeRigid _ _ X _ (RightRigidCategory.rightDual X).exact) =
      @ExactPairing.coevaluation D _ _ ((lift fo fc).obj X) _
        (RightRigidCategory.rightDual ((lift fo fc).obj X)).exact := by rfl

@[simp]
theorem lift_map_evaluation_right (X : S.FreeRigid) :
    (lift fo fc).map
        (@ExactPairing.evaluation S.FreeRigid _ _ X _ (RightRigidCategory.rightDual X).exact) =
      @ExactPairing.evaluation D _ _ ((lift fo fc).obj X) _
        (RightRigidCategory.rightDual ((lift fo fc).obj X)).exact := by rfl

@[simp]
theorem lift_map_coevaluation_left (X : S.FreeRigid) :
    (lift fo fc).map
        (@ExactPairing.coevaluation S.FreeRigid _ _ _ X (LeftRigidCategory.leftDual X).exact) =
      @ExactPairing.coevaluation D _ _ _ ((lift fo fc).obj X)
        (LeftRigidCategory.leftDual ((lift fo fc).obj X)).exact := by rfl

@[simp]
theorem lift_map_evaluation_left (X : S.FreeRigid) :
    (lift fo fc).map
        (@ExactPairing.evaluation S.FreeRigid _ _ _ X (LeftRigidCategory.leftDual X).exact) =
      @ExactPairing.evaluation D _ _ _ ((lift fo fc).obj X)
        (LeftRigidCategory.leftDual ((lift fo fc).obj X)).exact := by rfl

/- The unitor lemmas are not `@[simp]`: the Mathlib simp lemmas
`Functor.LaxMonoidal.left_unitality` and `right_unitality` rewrite their right-hand sides back
into `(lift fo fc).map` of a unitor. -/
theorem lift_map_leftUnitor_hom (X : S.FreeRigid) :
    (lift fo fc).map (λ_ X).hom = (λ_ ((lift fo fc).obj X)).hom := by rfl

theorem lift_map_leftUnitor_inv (X : S.FreeRigid) :
    (lift fo fc).map (λ_ X).inv = (λ_ ((lift fo fc).obj X)).inv := by rfl

theorem lift_map_rightUnitor_hom (X : S.FreeRigid) :
    (lift fo fc).map (ρ_ X).hom = (ρ_ ((lift fo fc).obj X)).hom := by rfl

theorem lift_map_rightUnitor_inv (X : S.FreeRigid) :
    (lift fo fc).map (ρ_ X).inv = (ρ_ ((lift fo fc).obj X)).inv := by rfl

instance : (lift fo fc).Monoidal :=
  Functor.CoreMonoidal.toMonoidal
    { εIso := Iso.refl _
      μIso := fun _ _ ↦ Iso.refl _
      μIso_hom_natural_left := by intros; dsimp only [Iso.refl_hom, lift_obj_tensor]; simp
      μIso_hom_natural_right := by intros; dsimp only [Iso.refl_hom, lift_obj_tensor]; simp
      associativity := by intros; dsimp only [Iso.refl_hom, lift_obj_tensor]; simp
      left_unitality := by
        intros; dsimp only [Iso.refl_hom, lift_obj_tensor, lift_obj_tensorUnit]
        simp [lift_map_leftUnitor_hom]
      right_unitality := by
        intros; dsimp only [Iso.refl_hom, lift_obj_tensor, lift_obj_tensorUnit]
        simp [lift_map_rightUnitor_hom] }

@[simp]
theorem lift_ε : Functor.LaxMonoidal.ε (lift fo fc) = 𝟙 _ := rfl

@[simp]
theorem lift_η : Functor.OplaxMonoidal.η (lift fo fc) = 𝟙 _ := rfl

@[simp]
theorem lift_μ (X Y : S.FreeRigid) : Functor.LaxMonoidal.μ (lift fo fc) X Y = 𝟙 _ := rfl

@[simp]
theorem lift_δ (X Y : S.FreeRigid) : Functor.OplaxMonoidal.δ (lift fo fc) X Y = 𝟙 _ := rfl

/-- The canonical lift preserves chosen right duals strictly: its right-dual comparison
isomorphism at every object `X` is the identity. -/
@[simp]
theorem lift_mapRightDualIso (X : S.FreeRigid) :
    @Functor.mapRightDualIso _ _ _ _ _ _ (lift fo fc) _ X
        (RightRigidCategory.rightDual X)
        (RightRigidCategory.rightDual ((lift fo fc).obj X)) =
      Iso.refl _ := by
  ext
  let : ExactPairing ((lift fo fc).obj X)
      (RightRigidCategory.rightDual ((lift fo fc).obj X)).rightDual :=
    (RightRigidCategory.rightDual ((lift fo fc).obj X)).exact
  refine ExactPairing.rightHom_ext (X := (lift fo fc).obj X) ?_
  have h := @Functor.mapRightDualIso_hom_whiskerRight_evaluation _ _ _ _ _ _ (lift fo fc) _ X
    (RightRigidCategory.rightDual X) (RightRigidCategory.rightDual ((lift fo fc).obj X))
  rw [lift_map_evaluation_right, lift_μ, lift_η] at h
  simpa using h

/-- The canonical lift preserves chosen left duals strictly: its left-dual comparison
isomorphism at every object `X` is the identity. -/
@[simp]
theorem lift_mapLeftDualIso (X : S.FreeRigid) :
    @Functor.mapLeftDualIso _ _ _ _ _ _ (lift fo fc) _ X
        (LeftRigidCategory.leftDual X)
        (LeftRigidCategory.leftDual ((lift fo fc).obj X)) =
      Iso.refl _ := by
  ext
  let : ExactPairing (LeftRigidCategory.leftDual ((lift fo fc).obj X)).leftDual
      ((lift fo fc).obj X) :=
    (LeftRigidCategory.leftDual ((lift fo fc).obj X)).exact
  refine ExactPairing.leftDualHom_ext (Y := (lift fo fc).obj X) ?_
  have h := @Functor.whiskerLeft_mapLeftDualIso_hom_evaluation _ _ _ _ _ _ (lift fo fc) _ X
    (LeftRigidCategory.leftDual X) (LeftRigidCategory.leftDual ((lift fo fc).obj X))
  rw [lift_map_evaluation_left, lift_μ, lift_η] at h
  simpa using h

end Lift

/-- Evaluating a formal rigid object in `S.FreeRigid` at the generating objects recovers the object
itself. -/
@[simp]
theorem projectObj_of (X : RigidObject S.Obj) :
    RigidObject.projectObj (of (S := S)) X = ⟨X⟩ := by
  induction X with
  | of a => rfl
  | unit => rfl
  | tensor X Y ihX ihY => exact congrArg₂ (· ⊗ ·) ihX ihY
  | rightDual X ih =>
    simp only [RigidObject.projectObj_rightDual]
    rw [ih]
    rfl
  | leftDual X ih =>
    simp only [RigidObject.projectObj_leftDual]
    rw [ih]
    rfl

section CouponCount

private local instance : MonoidalCategory (SingleObj (Multiplicative ℕ)) where
  tensorObj _ _ := SingleObj.star _
  whiskerLeft _ _ _ f := f
  whiskerRight f _ := f
  tensorHom f g := @HMul.hMul (Multiplicative ℕ) (Multiplicative ℕ) (Multiplicative ℕ) _ f g
  tensorUnit := SingleObj.star _
  associator _ _ _ := Iso.refl _
  leftUnitor _ := Iso.refl _
  rightUnitor _ := Iso.refl _
  tensorHom_def f g := by
    simp only [SingleObj.comp_as_mul]
    exact @mul_comm (Multiplicative ℕ) _ f g
  id_tensorHom_id _ _ := by
    simp only [SingleObj.id_as_one]
    exact @one_mul (Multiplicative ℕ) _ 1
  tensorHom_comp_tensorHom f₁ f₂ g₁ g₂ := by
    simp only [SingleObj.comp_as_mul]
    exact @mul_mul_mul_comm (Multiplicative ℕ) _ g₁ g₂ f₁ f₂
  associator_naturality f₁ f₂ f₃ := by
    simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    exact @mul_assoc (Multiplicative ℕ) _ f₁ f₂ f₃
  leftUnitor_naturality _ := by
    simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
  rightUnitor_naturality _ := by
    simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
  pentagon _ _ _ _ := rfl
  triangle _ _ := rfl

private local instance : RightRigidCategory (SingleObj (Multiplicative ℕ)) where
  rightDual _ :=
    { rightDual := SingleObj.star _
      exact :=
        { coevaluation' := (1 : Multiplicative ℕ)
          evaluation' := (1 : Multiplicative ℕ)
          coevaluation_evaluation' := by
            simp only [SingleObj.comp_as_mul]
            exact rfl
          evaluation_coevaluation' := by
            simp only [SingleObj.comp_as_mul]
            exact rfl } }

private local instance : LeftRigidCategory (SingleObj (Multiplicative ℕ)) where
  leftDual _ :=
    { leftDual := SingleObj.star _
      exact :=
        { coevaluation' := (1 : Multiplicative ℕ)
          evaluation' := (1 : Multiplicative ℕ)
          coevaluation_evaluation' := by
            simp only [SingleObj.comp_as_mul]
            exact rfl
          evaluation_coevaluation' := by
            simp only [SingleObj.comp_as_mul]
            exact rfl } }

private local instance : RigidCategory (SingleObj (Multiplicative ℕ)) where

private noncomputable def countLift (g₀ : S.Coupon) :
    S.FreeRigid ⥤ SingleObj (Multiplicative ℕ) :=
  lift (fun _ ↦ SingleObj.star _)
    (fun g ↦ @ite _ (g = g₀) (Classical.propDecidable _)
      (Multiplicative.ofAdd 1) (Multiplicative.ofAdd 0))

/-- The number of occurrences of a coupon `g₀` in a morphism of `S.FreeRigid`. This is invariant
under the rigid-category axioms, because every monoidal and zigzag relation is balanced in every
coupon. -/
noncomputable def couponCount (g₀ : S.Coupon) {X Y : S.FreeRigid} (f : X ⟶ Y) : ℕ :=
  Multiplicative.toAdd ((countLift g₀).map f)

@[simp]
theorem couponCount_id (g₀ : S.Coupon) (X : S.FreeRigid) : couponCount g₀ (𝟙 X) = 0 := by
  simp [couponCount, SingleObj.id_as_one]

@[simp]
theorem couponCount_associator_hom (g₀ : S.Coupon) (X Y Z : S.FreeRigid) :
    couponCount g₀ (α_ X Y Z).hom = 0 := by
  rw [couponCount, countLift, lift_map_associator_hom]
  exact toAdd_one

@[simp]
theorem couponCount_associator_inv (g₀ : S.Coupon) (X Y Z : S.FreeRigid) :
    couponCount g₀ (α_ X Y Z).inv = 0 := by
  rw [couponCount, countLift, lift_map_associator_inv]
  exact toAdd_one

@[simp]
theorem couponCount_leftUnitor_hom (g₀ : S.Coupon) (X : S.FreeRigid) :
    couponCount g₀ (λ_ X).hom = 0 := by
  rw [couponCount, countLift, lift_map_leftUnitor_hom]
  exact toAdd_one

@[simp]
theorem couponCount_leftUnitor_inv (g₀ : S.Coupon) (X : S.FreeRigid) :
    couponCount g₀ (λ_ X).inv = 0 := by
  rw [couponCount, countLift, lift_map_leftUnitor_inv]
  exact toAdd_one

@[simp]
theorem couponCount_rightUnitor_hom (g₀ : S.Coupon) (X : S.FreeRigid) :
    couponCount g₀ (ρ_ X).hom = 0 := by
  rw [couponCount, countLift, lift_map_rightUnitor_hom]
  exact toAdd_one

@[simp]
theorem couponCount_rightUnitor_inv (g₀ : S.Coupon) (X : S.FreeRigid) :
    couponCount g₀ (ρ_ X).inv = 0 := by
  rw [couponCount, countLift, lift_map_rightUnitor_inv]
  exact toAdd_one

@[simp]
theorem couponCount_coevaluation_right (g₀ : S.Coupon) (X : S.FreeRigid) :
    couponCount g₀
        (@ExactPairing.coevaluation S.FreeRigid _ _ X _ (RightRigidCategory.rightDual X).exact) =
      0 := by
  rw [couponCount, countLift, lift_map_coevaluation_right]
  exact toAdd_one

@[simp]
theorem couponCount_evaluation_right (g₀ : S.Coupon) (X : S.FreeRigid) :
    couponCount g₀
        (@ExactPairing.evaluation S.FreeRigid _ _ X _ (RightRigidCategory.rightDual X).exact) =
      0 := by
  rw [couponCount, countLift, lift_map_evaluation_right]
  exact toAdd_one

@[simp]
theorem couponCount_coevaluation_left (g₀ : S.Coupon) (X : S.FreeRigid) :
    couponCount g₀
        (@ExactPairing.coevaluation S.FreeRigid _ _ _ X (LeftRigidCategory.leftDual X).exact) =
      0 := by
  rw [couponCount, countLift, lift_map_coevaluation_left]
  exact toAdd_one

@[simp]
theorem couponCount_evaluation_left (g₀ : S.Coupon) (X : S.FreeRigid) :
    couponCount g₀
        (@ExactPairing.evaluation S.FreeRigid _ _ _ X (LeftRigidCategory.leftDual X).exact) =
      0 := by
  rw [couponCount, countLift, lift_map_evaluation_left]
  exact toAdd_one

@[simp]
theorem couponCount_comp (g₀ : S.Coupon) {X Y Z : S.FreeRigid} (f : X ⟶ Y) (g : Y ⟶ Z) :
    couponCount g₀ (f ≫ g) = couponCount g₀ f + couponCount g₀ g := by
  simp only [couponCount, Functor.map_comp, SingleObj.comp_as_mul]
  exact (toAdd_mul _ _).trans (Nat.add_comm _ _)

@[simp]
theorem couponCount_whiskerLeft (g₀ : S.Coupon) (X : S.FreeRigid) {Y₁ Y₂ : S.FreeRigid}
    (f : Y₁ ⟶ Y₂) : couponCount g₀ (X ◁ f) = couponCount g₀ f := by
  rw [couponCount, countLift, lift_map_whiskerLeft]
  rfl

@[simp]
theorem couponCount_whiskerRight (g₀ : S.Coupon) {X₁ X₂ : S.FreeRigid} (f : X₁ ⟶ X₂)
    (Y : S.FreeRigid) : couponCount g₀ (f ▷ Y) = couponCount g₀ f := by
  rw [couponCount, countLift, lift_map_whiskerRight]
  rfl

@[simp]
theorem couponCount_tensorHom (g₀ : S.Coupon) {X₁ Y₁ X₂ Y₂ : S.FreeRigid} (f : X₁ ⟶ Y₁)
    (g : X₂ ⟶ Y₂) : couponCount g₀ (f ⊗ₘ g) = couponCount g₀ f + couponCount g₀ g := by
  rw [couponCount, countLift, lift_map_tensorHom]
  exact toAdd_mul _ _

@[simp]
theorem couponCount_coupon_self (g : S.Coupon) : couponCount g (coupon g) = 1 := by
  simp [couponCount, countLift]

@[simp]
theorem couponCount_coupon_of_ne {g₁ g₂ : S.Coupon} (h : g₂ ≠ g₁) :
    couponCount g₁ (coupon g₂) = 0 := by
  simp [couponCount, countLift, h]

@[simp]
theorem couponCount_eqToHom (g₀ : S.Coupon) {X Y : S.FreeRigid} (h : X = Y) :
    couponCount g₀ (eqToHom h) = 0 := by subst h; exact couponCount_id g₀ X

/-- No coupon is identified with an identity morphism in `S.FreeRigid`. In particular, a nullary
coupon `𝟙_ S.FreeRigid ⟶ 𝟙_ S.FreeRigid` is distinct from `𝟙 (𝟙_ S.FreeRigid)`. -/
theorem coupon_ne_id (g : S.Coupon) (h : S.src g = S.tgt g) :
    coupon g ≠ eqToHom (congrArg FreeRigid.mk h) := by
  intro heq
  have hc := congrArg (couponCount g) heq
  simp at hc

/-- Distinct coupons with matching boundaries remain distinct morphisms in `S.FreeRigid`. -/
theorem coupon_ne_coupon {g₁ g₂ : S.Coupon} (hsrc : S.src g₁ = S.src g₂)
    (htgt : S.tgt g₁ = S.tgt g₂) (hne : g₁ ≠ g₂) :
    coupon g₁ ≠
      eqToHom (congrArg FreeRigid.mk hsrc) ≫ coupon g₂ ≫
        eqToHom (congrArg FreeRigid.mk htgt.symm) := by
  intro heq
  have hc := congrArg (couponCount g₁) heq
  simp [hne.symm] at hc

end CouponCount

end FreeRigid

end RigidSignature

namespace TensorSignature

/-- Evaluating a monoidal word in `S.toRigidSignature.FreeRigid` agrees with embedding the word
into `RigidObject`. -/
@[simp]
theorem projectObj_of_toRigidSignature (S : TensorSignature.{u, v})
    (X : FreeMonoidalCategory S.Obj) :
    FreeMonoidalCategory.projectObj
        (fun a ↦ RigidSignature.FreeRigid.of (S := S.toRigidSignature) a) X =
      ⟨X.toRigidObject⟩ :=
  (RigidObject.projectObj_toRigidObject
      (fun a ↦ RigidSignature.FreeRigid.of (S := S.toRigidSignature) a) X).symm.trans
    (RigidSignature.FreeRigid.projectObj_of (S := S.toRigidSignature) X.toRigidObject)

/-- The canonical strong monoidal functor from the free monoidal category on a tensor signature
`S` into the free rigid monoidal category on `S.toRigidSignature`. -/
@[expose] def ofFreeMonoidal (S : TensorSignature.{u, v}) :
    S.FreeMonoidal ⥤ S.toRigidSignature.FreeRigid :=
  FreeMonoidal.lift (fun a ↦ RigidSignature.FreeRigid.of (S := S.toRigidSignature) a)
    (fun g ↦ eqToHom (projectObj_of_toRigidSignature S (S.src g)) ≫
      RigidSignature.FreeRigid.coupon (S := S.toRigidSignature) g ≫
      eqToHom (projectObj_of_toRigidSignature S (S.tgt g)).symm)

@[simp]
theorem ofFreeMonoidal_obj_of (S : TensorSignature.{u, v}) (a : S.Obj) :
    (ofFreeMonoidal S).obj (FreeMonoidal.of a) =
      RigidSignature.FreeRigid.of (S := S.toRigidSignature) a := by rfl

@[simp]
theorem ofFreeMonoidal_obj_tensorUnit (S : TensorSignature.{u, v}) :
    (ofFreeMonoidal S).obj (𝟙_ S.FreeMonoidal) = 𝟙_ S.toRigidSignature.FreeRigid := by rfl

@[simp]
theorem ofFreeMonoidal_obj_tensor (S : TensorSignature.{u, v}) (X Y : S.FreeMonoidal) :
    (ofFreeMonoidal S).obj (X ⊗ Y) = (ofFreeMonoidal S).obj X ⊗ (ofFreeMonoidal S).obj Y := by rfl

theorem ofFreeMonoidal_obj (S : TensorSignature.{u, v}) (X : S.FreeMonoidal) :
    (ofFreeMonoidal S).obj X = ⟨X.as.toRigidObject⟩ :=
  projectObj_of_toRigidSignature S X.as

instance (S : TensorSignature.{u, v}) : (ofFreeMonoidal S).Monoidal := by
  unfold ofFreeMonoidal; infer_instance

@[simp]
theorem ofFreeMonoidal_map_coupon (S : TensorSignature.{u, v}) (g : S.Coupon) :
    (ofFreeMonoidal S).map (FreeMonoidal.coupon g) =
      eqToHom (ofFreeMonoidal_obj S ⟨S.src g⟩) ≫
        RigidSignature.FreeRigid.coupon (S := S.toRigidSignature) g ≫
        eqToHom (ofFreeMonoidal_obj S ⟨S.tgt g⟩).symm := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_map_coupon _ _ g

@[simp]
theorem ofFreeMonoidal_ε (S : TensorSignature.{u, v}) :
    Functor.LaxMonoidal.ε (ofFreeMonoidal S) = 𝟙 _ := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_ε _ _

@[simp]
theorem ofFreeMonoidal_η (S : TensorSignature.{u, v}) :
    Functor.OplaxMonoidal.η (ofFreeMonoidal S) = 𝟙 _ := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_η _ _

@[simp]
theorem ofFreeMonoidal_μ (S : TensorSignature.{u, v}) (X Y : S.FreeMonoidal) :
    Functor.LaxMonoidal.μ (ofFreeMonoidal S) X Y = 𝟙 _ := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_μ _ _ X Y

@[simp]
theorem ofFreeMonoidal_δ (S : TensorSignature.{u, v}) (X Y : S.FreeMonoidal) :
    Functor.OplaxMonoidal.δ (ofFreeMonoidal S) X Y = 𝟙 _ := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_δ _ _ X Y

end TensorSignature

