module

public import Mathlib.CategoryTheory.Monoidal.Category

/-!
# Shared monoidal presentation core for free monoidal categories

This module factors out the common monoidal syntax (`Hom`), monoidal congruence (`HomEquiv`),
quotient category and monoidal-category instances (`Free`), morphism induction principle
(`Hom.inductionOn`), and monoidal interpretation soundness (`liftMapAux`, `liftMapAux_sound`,
`lift`) shared by free monoidal, free braided monoidal, and free rigid monoidal categories on
signatures.

Parameterizing over the object syntax `Obj` with its unit and tensor operations, indexed extra
generators `Gen`, and extra generating relations `Rel` allows each presentation to keep its own
native object syntax and definitional evaluation equations (such as strict alignment with chosen
duals for `RigidObject`).
-/

public section

universe u v u' v'

open CategoryTheory MonoidalCategory

namespace TauCeti.MonoidalCore

section Syntax

variable {Obj : Type u} (unitObj : Obj) (tensorObj : Obj → Obj → Obj)
  (Gen : Obj → Obj → Type v)

/-- Formal composites, tensor products, and whiskerings of identities, associators, unitors,
and extra generators `Gen`. -/
inductive Hom : Obj → Obj → Type (max u v)
  | id (X : Obj) : Hom X X
  | α_hom (X Y Z : Obj) : Hom (tensorObj (tensorObj X Y) Z) (tensorObj X (tensorObj Y Z))
  | α_inv (X Y Z : Obj) : Hom (tensorObj X (tensorObj Y Z)) (tensorObj (tensorObj X Y) Z)
  | l_hom (X : Obj) : Hom (tensorObj unitObj X) X
  | l_inv (X : Obj) : Hom X (tensorObj unitObj X)
  | ρ_hom (X : Obj) : Hom (tensorObj X unitObj) X
  | ρ_inv (X : Obj) : Hom X (tensorObj X unitObj)
  | gen {X Y : Obj} (g : Gen X Y) : Hom X Y
  | comp {X Y Z : Obj} (f : Hom X Y) (g : Hom Y Z) : Hom X Z
  | whiskerLeft (X : Obj) {Y₁ Y₂ : Obj} (f : Hom Y₁ Y₂) : Hom (tensorObj X Y₁) (tensorObj X Y₂)
  | whiskerRight {X₁ X₂ : Obj} (f : Hom X₁ X₂) (Y : Obj) : Hom (tensorObj X₁ Y) (tensorObj X₂ Y)
  | tensor {W X Y Z : Obj} (f : Hom W Y) (g : Hom X Z) : Hom (tensorObj W X) (tensorObj Y Z)

variable {unitObj tensorObj Gen}

/-- The relation on formal morphisms generated by the axioms of a monoidal category together with
extra relations `Rel`, closed under composition, whiskering, and tensor products. -/
inductive HomEquiv
    (Rel : ∀ {X Y : Obj}, Hom unitObj tensorObj Gen X Y → Hom unitObj tensorObj Gen X Y → Prop) :
    ∀ {X Y : Obj}, Hom unitObj tensorObj Gen X Y → Hom unitObj tensorObj Gen X Y → Prop
  | refl {X Y} (f : Hom unitObj tensorObj Gen X Y) : HomEquiv Rel f f
  | symm {X Y} (f g : Hom unitObj tensorObj Gen X Y) : HomEquiv Rel f g → HomEquiv Rel g f
  | trans {X Y} {f g h : Hom unitObj tensorObj Gen X Y} :
      HomEquiv Rel f g → HomEquiv Rel g h → HomEquiv Rel f h
  | comp {X Y Z} {f f' : Hom unitObj tensorObj Gen X Y}
      {g g' : Hom unitObj tensorObj Gen Y Z} :
      HomEquiv Rel f f' → HomEquiv Rel g g' → HomEquiv Rel (f.comp g) (f'.comp g')
  | whiskerLeft (X) {Y Z} (f f' : Hom unitObj tensorObj Gen Y Z) :
      HomEquiv Rel f f' → HomEquiv Rel (f.whiskerLeft X) (f'.whiskerLeft X)
  | whiskerRight {Y Z} (f f' : Hom unitObj tensorObj Gen Y Z) (X) :
      HomEquiv Rel f f' → HomEquiv Rel (f.whiskerRight X) (f'.whiskerRight X)
  | tensor {W X Y Z} {f f' : Hom unitObj tensorObj Gen W X}
      {g g' : Hom unitObj tensorObj Gen Y Z} :
      HomEquiv Rel f f' → HomEquiv Rel g g' → HomEquiv Rel (f.tensor g) (f'.tensor g')
  | tensorHom_def {X₁ Y₁ X₂ Y₂} (f : Hom unitObj tensorObj Gen X₁ Y₁)
      (g : Hom unitObj tensorObj Gen X₂ Y₂) :
      HomEquiv Rel (f.tensor g) ((f.whiskerRight X₂).comp (g.whiskerLeft Y₁))
  | comp_id {X Y} (f : Hom unitObj tensorObj Gen X Y) : HomEquiv Rel (f.comp (Hom.id _)) f
  | id_comp {X Y} (f : Hom unitObj tensorObj Gen X Y) : HomEquiv Rel ((Hom.id _).comp f) f
  | assoc {X Y U V} (f : Hom unitObj tensorObj Gen X U)
      (g : Hom unitObj tensorObj Gen U V) (h : Hom unitObj tensorObj Gen V Y) :
      HomEquiv Rel ((f.comp g).comp h) (f.comp (g.comp h))
  | id_tensorHom_id {X Y} :
      HomEquiv Rel ((Hom.id X).tensor (Hom.id Y)) (Hom.id (tensorObj X Y))
  | tensorHom_comp_tensorHom {X₁ Y₁ Z₁ X₂ Y₂ Z₂}
      (f₁ : Hom unitObj tensorObj Gen X₁ Y₁) (f₂ : Hom unitObj tensorObj Gen X₂ Y₂)
      (g₁ : Hom unitObj tensorObj Gen Y₁ Z₁) (g₂ : Hom unitObj tensorObj Gen Y₂ Z₂) :
      HomEquiv Rel ((f₁.tensor f₂).comp (g₁.tensor g₂)) ((f₁.comp g₁).tensor (f₂.comp g₂))
  | whiskerLeft_id (X Y) :
      HomEquiv Rel ((Hom.id Y).whiskerLeft X) (Hom.id (tensorObj X Y))
  | id_whiskerRight (X Y) :
      HomEquiv Rel ((Hom.id X).whiskerRight Y) (Hom.id (tensorObj X Y))
  | α_hom_inv {X Y Z} :
      HomEquiv Rel ((Hom.α_hom X Y Z).comp (Hom.α_inv X Y Z)) (Hom.id _)
  | α_inv_hom {X Y Z} :
      HomEquiv Rel ((Hom.α_inv X Y Z).comp (Hom.α_hom X Y Z)) (Hom.id _)
  | associator_naturality {X₁ X₂ X₃ Y₁ Y₂ Y₃}
      (f₁ : Hom unitObj tensorObj Gen X₁ Y₁) (f₂ : Hom unitObj tensorObj Gen X₂ Y₂)
      (f₃ : Hom unitObj tensorObj Gen X₃ Y₃) :
      HomEquiv Rel (((f₁.tensor f₂).tensor f₃).comp (Hom.α_hom Y₁ Y₂ Y₃))
        ((Hom.α_hom X₁ X₂ X₃).comp (f₁.tensor (f₂.tensor f₃)))
  | ρ_hom_inv {X} : HomEquiv Rel ((Hom.ρ_hom X).comp (Hom.ρ_inv X)) (Hom.id _)
  | ρ_inv_hom {X} : HomEquiv Rel ((Hom.ρ_inv X).comp (Hom.ρ_hom X)) (Hom.id _)
  | ρ_naturality {X Y} (f : Hom unitObj tensorObj Gen X Y) :
      HomEquiv Rel ((f.whiskerRight unitObj).comp (Hom.ρ_hom Y)) ((Hom.ρ_hom X).comp f)
  | l_hom_inv {X} : HomEquiv Rel ((Hom.l_hom X).comp (Hom.l_inv X)) (Hom.id _)
  | l_inv_hom {X} : HomEquiv Rel ((Hom.l_inv X).comp (Hom.l_hom X)) (Hom.id _)
  | l_naturality {X Y} (f : Hom unitObj tensorObj Gen X Y) :
      HomEquiv Rel ((f.whiskerLeft unitObj).comp (Hom.l_hom Y)) ((Hom.l_hom X).comp f)
  | pentagon {W X Y Z} :
      HomEquiv Rel
        (((Hom.α_hom W X Y).whiskerRight Z).comp
          ((Hom.α_hom W (tensorObj X Y) Z).comp ((Hom.α_hom X Y Z).whiskerLeft W)))
        ((Hom.α_hom (tensorObj W X) Y Z).comp (Hom.α_hom W X (tensorObj Y Z)))
  | triangle {X Y} :
      HomEquiv Rel ((Hom.α_hom X unitObj Y).comp ((Hom.l_hom Y).whiskerLeft X))
        ((Hom.ρ_hom X).whiskerRight Y)
  | extra {X Y} {f g : Hom unitObj tensorObj Gen X Y} : Rel f g → HomEquiv Rel f g

variable (unitObj tensorObj Gen)

/-- Formal morphisms are identified when the monoidal axioms and `Rel` make them equal. -/
@[expose] def setoidHom
    (Rel : ∀ {X Y : Obj}, Hom unitObj tensorObj Gen X Y → Hom unitObj tensorObj Gen X Y → Prop)
    (X Y : Obj) : Setoid (Hom unitObj tensorObj Gen X Y) :=
  ⟨HomEquiv Rel, ⟨HomEquiv.refl, HomEquiv.symm _ _, HomEquiv.trans⟩⟩

end Syntax

section Quotient

/-- Bundled presentation data for a free monoidal category with object syntax `Obj`, unit and
tensor operations, extra generating morphisms `Gen`, and extra generating relations `Rel`. -/
structure Presentation where
  /-- The syntactic objects. -/
  Obj : Type u
  /-- The syntactic tensor unit. -/
  unitObj : Obj
  /-- The syntactic tensor product. -/
  tensorObj : Obj → Obj → Obj
  /-- The extra generating morphisms. -/
  Gen : Obj → Obj → Type v
  /-- The extra generating relations on formal morphisms. -/
  Rel : ∀ {X Y : Obj}, Hom unitObj tensorObj Gen X Y → Hom unitObj tensorObj Gen X Y → Prop

/-- The free monoidal category on a presentation `P`, formed by wrapping `P.Obj` as objects and
quotienting formal morphisms `Hom P.unitObj P.tensorObj P.Gen` by `HomEquiv P.Rel`. -/
structure Free (P : Presentation.{u, v}) where
  /-- The underlying syntactic object. -/
  as : P.Obj

variable {P : Presentation.{u, v}}

instance : Category.{max u v} (Free P) where
  Hom X Y := Quotient (setoidHom P.unitObj P.tensorObj P.Gen P.Rel X.as Y.as)
  id X := ⟦Hom.id X.as⟧
  comp := Quotient.map₂ Hom.comp (fun _ _ hf _ _ hg ↦ HomEquiv.comp hf hg)
  id_comp := by rintro X Y ⟨f⟩; exact Quotient.sound (HomEquiv.id_comp f)
  comp_id := by rintro X Y ⟨f⟩; exact Quotient.sound (HomEquiv.comp_id f)
  assoc := by rintro W X Y Z ⟨f⟩ ⟨g⟩ ⟨h⟩; exact Quotient.sound (HomEquiv.assoc f g h)

instance : MonoidalCategory (Free P) where
  tensorObj X Y := ⟨P.tensorObj X.as Y.as⟩
  tensorHom := Quotient.map₂ Hom.tensor (fun _ _ hf _ _ hg ↦ HomEquiv.tensor hf hg)
  whiskerLeft X _ _ f :=
    Quot.map (fun f ↦ Hom.whiskerLeft X.as f) (fun f f' ↦ .whiskerLeft _ f f') f
  whiskerRight f Y :=
    Quot.map (fun f ↦ Hom.whiskerRight f Y.as) (fun f f' ↦ .whiskerRight f f' _) f
  tensorHom_def := by rintro _ _ _ _ ⟨f⟩ ⟨g⟩; exact Quotient.sound (HomEquiv.tensorHom_def _ _)
  id_tensorHom_id _ _ := Quot.sound HomEquiv.id_tensorHom_id
  tensorHom_comp_tensorHom := by
    rintro _ _ _ _ _ _ ⟨f₁⟩ ⟨f₂⟩ ⟨g₁⟩ ⟨g₂⟩
    exact Quotient.sound (HomEquiv.tensorHom_comp_tensorHom _ _ _ _)
  whiskerLeft_id X Y := Quot.sound (HomEquiv.whiskerLeft_id X.as Y.as)
  id_whiskerRight X Y := Quot.sound (HomEquiv.id_whiskerRight X.as Y.as)
  tensorUnit := ⟨P.unitObj⟩
  associator X Y Z :=
    ⟨⟦Hom.α_hom X.as Y.as Z.as⟧, ⟦Hom.α_inv X.as Y.as Z.as⟧,
      Quotient.sound HomEquiv.α_hom_inv, Quotient.sound HomEquiv.α_inv_hom⟩
  associator_naturality := by
    rintro _ _ _ _ _ _ ⟨f₁⟩ ⟨f₂⟩ ⟨f₃⟩
    exact Quotient.sound (HomEquiv.associator_naturality _ _ _)
  leftUnitor X :=
    ⟨⟦Hom.l_hom X.as⟧, ⟦Hom.l_inv X.as⟧,
      Quotient.sound HomEquiv.l_hom_inv, Quotient.sound HomEquiv.l_inv_hom⟩
  leftUnitor_naturality := by rintro _ _ ⟨f⟩; exact Quotient.sound (HomEquiv.l_naturality _)
  rightUnitor X :=
    ⟨⟦Hom.ρ_hom X.as⟧, ⟦Hom.ρ_inv X.as⟧,
      Quotient.sound HomEquiv.ρ_hom_inv, Quotient.sound HomEquiv.ρ_inv_hom⟩
  rightUnitor_naturality := by rintro _ _ ⟨f⟩; exact Quotient.sound (HomEquiv.ρ_naturality _)
  pentagon _ _ _ _ := Quotient.sound HomEquiv.pentagon
  triangle _ _ := Quotient.sound HomEquiv.triangle

/-- The morphism in `Free P` represented by a formal morphism. -/
abbrev homMk {X Y : Free P} (f : Hom P.unitObj P.tensorObj P.Gen X.as Y.as) : X ⟶ Y := ⟦f⟧

/-- Two formal morphisms represent the same morphism if and only if they are related by
`HomEquiv P.Rel`. -/
theorem homMk_eq_iff {X Y : Free P}
    (f g : Hom P.unitObj P.tensorObj P.Gen X.as Y.as) :
    homMk f = homMk g ↔ HomEquiv P.Rel f g :=
  Quotient.eq

@[simp]
theorem homMk_id (X : Free P) : homMk (Hom.id X.as) = 𝟙 X := rfl

@[simp]
theorem homMk_comp {X Y Z : Free P}
    (f : Hom P.unitObj P.tensorObj P.Gen X.as Y.as)
    (g : Hom P.unitObj P.tensorObj P.Gen Y.as Z.as) :
    homMk (Y := Z) (f.comp g) = homMk f ≫ homMk g := rfl

@[simp]
theorem homMk_tensor {X₁ Y₁ X₂ Y₂ : Free P}
    (f : Hom P.unitObj P.tensorObj P.Gen X₁.as Y₁.as)
    (g : Hom P.unitObj P.tensorObj P.Gen X₂.as Y₂.as) :
    homMk (X := X₁ ⊗ X₂) (Y := Y₁ ⊗ Y₂) (f.tensor g) = homMk f ⊗ₘ homMk g := rfl

@[simp]
theorem homMk_whiskerLeft (X : Free P)
    {Y₁ Y₂ : Free P} (f : Hom P.unitObj P.tensorObj P.Gen Y₁.as Y₂.as) :
    homMk (X := X ⊗ Y₁) (Y := X ⊗ Y₂) (f.whiskerLeft X.as) = X ◁ homMk f := rfl

@[simp]
theorem homMk_whiskerRight {X₁ X₂ : Free P}
    (f : Hom P.unitObj P.tensorObj P.Gen X₁.as X₂.as) (Y : Free P) :
    homMk (X := X₁ ⊗ Y) (Y := X₂ ⊗ Y) (f.whiskerRight Y.as) = homMk f ▷ Y := rfl

@[simp]
theorem homMk_α_hom (X Y Z : Free P) :
    homMk (X := (X ⊗ Y) ⊗ Z) (Y := X ⊗ (Y ⊗ Z)) (Hom.α_hom X.as Y.as Z.as) =
      (α_ X Y Z).hom := rfl

@[simp]
theorem homMk_α_inv (X Y Z : Free P) :
    homMk (X := X ⊗ (Y ⊗ Z)) (Y := (X ⊗ Y) ⊗ Z) (Hom.α_inv X.as Y.as Z.as) =
      (α_ X Y Z).inv := rfl

@[simp]
theorem homMk_l_hom (X : Free P) :
    homMk (X := 𝟙_ _ ⊗ X) (Hom.l_hom X.as) = (λ_ X).hom := rfl

@[simp]
theorem homMk_l_inv (X : Free P) :
    homMk (Y := 𝟙_ _ ⊗ X) (Hom.l_inv X.as) = (λ_ X).inv := rfl

@[simp]
theorem homMk_ρ_hom (X : Free P) :
    homMk (X := X ⊗ 𝟙_ _) (Hom.ρ_hom X.as) = (ρ_ X).hom := rfl

@[simp]
theorem homMk_ρ_inv (X : Free P) :
    homMk (Y := X ⊗ 𝟙_ _) (Hom.ρ_inv X.as) = (ρ_ X).inv := rfl

/-- Shared induction principle for morphisms of `Free P`: a property holding on identities,
associators, unitors, and extra generators, and stable under composition and whiskering, holds for
every morphism. -/
theorem Hom.inductionOn
    {motive : {X Y : Free P} → (X ⟶ Y) → Prop}
    {X Y : Free P} (t : X ⟶ Y)
    (id : (X : Free P) → motive (𝟙 X))
    (α_hom : (X Y Z : Free P) → motive (α_ X Y Z).hom)
    (α_inv : (X Y Z : Free P) → motive (α_ X Y Z).inv)
    (l_hom : (X : Free P) → motive (λ_ X).hom)
    (l_inv : (X : Free P) → motive (λ_ X).inv)
    (ρ_hom : (X : Free P) → motive (ρ_ X).hom)
    (ρ_inv : (X : Free P) → motive (ρ_ X).inv)
    (gen : {X Y : P.Obj} → (g : P.Gen X Y) →
      motive (homMk (X := ⟨X⟩) (Y := ⟨Y⟩) (Hom.gen g)))
    (comp : {X Y Z : Free P} → (f : X ⟶ Y) → (g : Y ⟶ Z) →
      motive f → motive g → motive (f ≫ g))
    (whiskerLeft : (X : Free P) →
      {Y Z : Free P} → (f : Y ⟶ Z) → motive f → motive (X ◁ f))
    (whiskerRight : {X Y : Free P} → (f : X ⟶ Y) →
      (Z : Free P) → motive f → motive (f ▷ Z)) :
    motive t := by
  suffices H : ∀ {X Y : P.Obj} (f : Hom P.unitObj P.tensorObj P.Gen X Y),
      motive (homMk (X := ⟨X⟩) (Y := ⟨Y⟩) f) by
    induction t using Quotient.inductionOn with | _ f
    exact H f
  intro X Y f
  induction f with
  | id X => exact id ⟨X⟩
  | α_hom X Y Z => exact α_hom ⟨X⟩ ⟨Y⟩ ⟨Z⟩
  | α_inv X Y Z => exact α_inv ⟨X⟩ ⟨Y⟩ ⟨Z⟩
  | l_hom X => exact l_hom ⟨X⟩
  | l_inv X => exact l_inv ⟨X⟩
  | ρ_hom X => exact ρ_hom ⟨X⟩
  | ρ_inv X => exact ρ_inv ⟨X⟩
  | gen g => exact gen g
  | comp f g hf hg => exact comp _ _ hf hg
  | whiskerLeft X f hf => exact whiskerLeft ⟨X⟩ _ hf
  | whiskerRight f X hf => exact whiskerRight _ ⟨X⟩ hf
  | @tensor W X Y Z f g hf hg =>
    have h : (homMk (f.tensor g) :
        (⟨P.tensorObj W X⟩ : Free P) ⟶ ⟨P.tensorObj Y Z⟩) =
        homMk (X := ⟨W⟩) (Y := ⟨Y⟩) f ▷ (⟨X⟩ : Free P) ≫
          (⟨Y⟩ : Free P) ◁ homMk (X := ⟨X⟩) (Y := ⟨Z⟩) g :=
      Quotient.sound (HomEquiv.tensorHom_def f g)
    rw [h]
    exact comp _ _ (whiskerRight _ _ hf) (whiskerLeft _ _ hg)

end Quotient

section Lift

variable {Obj : Type u} (unitObj : Obj) (tensorObj : Obj → Obj → Obj)
  (Gen : Obj → Obj → Type v)
  {D : Type u'} [Category.{v'} D]

/-- Data interpreting object syntax `Obj` and monoidal operations in a target category `D`
without inserting `eqToHom` coercions, preserving definitional endpoint types. -/
structure MonoidalEval (D : Type u') [Category.{v'} D] where
  /-- Interpretation of syntactic objects. -/
  obj : Obj → D
  /-- Interpretation of forward associators. -/
  αHom (X Y Z : Obj) : obj (tensorObj (tensorObj X Y) Z) ⟶ obj (tensorObj X (tensorObj Y Z))
  /-- Interpretation of inverse associators. -/
  αInv (X Y Z : Obj) : obj (tensorObj X (tensorObj Y Z)) ⟶ obj (tensorObj (tensorObj X Y) Z)
  /-- Interpretation of forward left unitors. -/
  lHom (X : Obj) : obj (tensorObj unitObj X) ⟶ obj X
  /-- Interpretation of inverse left unitors. -/
  lInv (X : Obj) : obj X ⟶ obj (tensorObj unitObj X)
  /-- Interpretation of forward right unitors. -/
  ρHom (X : Obj) : obj (tensorObj X unitObj) ⟶ obj X
  /-- Interpretation of inverse right unitors. -/
  ρInv (X : Obj) : obj X ⟶ obj (tensorObj X unitObj)
  /-- Interpretation of left whiskering. -/
  whiskerLeft (X : Obj) {Y₁ Y₂ : Obj} :
    (obj Y₁ ⟶ obj Y₂) → (obj (tensorObj X Y₁) ⟶ obj (tensorObj X Y₂))
  /-- Interpretation of right whiskering. -/
  whiskerRight {X₁ X₂ : Obj} :
    (obj X₁ ⟶ obj X₂) → (Y : Obj) → (obj (tensorObj X₁ Y) ⟶ obj (tensorObj X₂ Y))
  /-- Interpretation of tensor product of morphisms. -/
  tensorHom {W X Y Z : Obj} :
    (obj W ⟶ obj Y) → (obj X ⟶ obj Z) → (obj (tensorObj W X) ⟶ obj (tensorObj Y Z))

namespace MonoidalEval

variable {unitObj tensorObj}

/-- The monoidal-category axioms satisfied by a `MonoidalEval` structure. -/
structure Lawful (E : MonoidalEval unitObj tensorObj D) : Prop where
  /-- Bifunctoriality / interchange with whiskering. -/
  tensorHom_def {X₁ Y₁ X₂ Y₂ : Obj} (f : E.obj X₁ ⟶ E.obj Y₁) (g : E.obj X₂ ⟶ E.obj Y₂) :
    E.tensorHom f g = E.whiskerRight f X₂ ≫ E.whiskerLeft Y₁ g
  /-- Tensor of identities is identity. -/
  id_tensorHom_id (X Y : Obj) : E.tensorHom (𝟙 (E.obj X)) (𝟙 (E.obj Y)) = 𝟙 _
  /-- Interchange law for tensor of composites. -/
  tensorHom_comp_tensorHom {X₁ Y₁ Z₁ X₂ Y₂ Z₂ : Obj}
      (f₁ : E.obj X₁ ⟶ E.obj Y₁) (f₂ : E.obj X₂ ⟶ E.obj Y₂)
      (g₁ : E.obj Y₁ ⟶ E.obj Z₁) (g₂ : E.obj Y₂ ⟶ E.obj Z₂) :
    E.tensorHom f₁ f₂ ≫ E.tensorHom g₁ g₂ = E.tensorHom (f₁ ≫ g₁) (f₂ ≫ g₂)
  /-- Left whiskering of identity is identity. -/
  whiskerLeft_id (X Y : Obj) : E.whiskerLeft X (𝟙 (E.obj Y)) = 𝟙 _
  /-- Right whiskering of identity is identity. -/
  id_whiskerRight (X Y : Obj) : E.whiskerRight (𝟙 (E.obj X)) Y = 𝟙 _
  /-- Right inverse of associator. -/
  α_hom_inv (X Y Z : Obj) : E.αHom X Y Z ≫ E.αInv X Y Z = 𝟙 _
  /-- Left inverse of associator. -/
  α_inv_hom (X Y Z : Obj) : E.αInv X Y Z ≫ E.αHom X Y Z = 𝟙 _
  /-- Naturality of associator. -/
  associator_naturality {X₁ X₂ X₃ Y₁ Y₂ Y₃ : Obj}
      (f₁ : E.obj X₁ ⟶ E.obj Y₁) (f₂ : E.obj X₂ ⟶ E.obj Y₂) (f₃ : E.obj X₃ ⟶ E.obj Y₃) :
    E.tensorHom (E.tensorHom f₁ f₂) f₃ ≫ E.αHom Y₁ Y₂ Y₃ =
      E.αHom X₁ X₂ X₃ ≫ E.tensorHom f₁ (E.tensorHom f₂ f₃)
  /-- Right inverse of right unitor. -/
  ρ_hom_inv (X : Obj) : E.ρHom X ≫ E.ρInv X = 𝟙 _
  /-- Left inverse of right unitor. -/
  ρ_inv_hom (X : Obj) : E.ρInv X ≫ E.ρHom X = 𝟙 _
  /-- Naturality of right unitor. -/
  ρ_naturality {X Y : Obj} (f : E.obj X ⟶ E.obj Y) :
    E.whiskerRight f unitObj ≫ E.ρHom Y = E.ρHom X ≫ f
  /-- Right inverse of left unitor. -/
  l_hom_inv (X : Obj) : E.lHom X ≫ E.lInv X = 𝟙 _
  /-- Left inverse of left unitor. -/
  l_inv_hom (X : Obj) : E.lInv X ≫ E.lHom X = 𝟙 _
  /-- Naturality of left unitor. -/
  l_naturality {X Y : Obj} (f : E.obj X ⟶ E.obj Y) :
    E.whiskerLeft unitObj f ≫ E.lHom Y = E.lHom X ≫ f
  /-- Pentagon identity. -/
  pentagon (W X Y Z : Obj) :
    E.whiskerRight (E.αHom W X Y) Z ≫ E.αHom W (tensorObj X Y) Z ≫
        E.whiskerLeft W (E.αHom X Y Z) =
      E.αHom (tensorObj W X) Y Z ≫ E.αHom W X (tensorObj Y Z)
  /-- Triangle identity. -/
  triangle (X Y : Obj) :
    E.αHom X unitObj Y ≫ E.whiskerLeft X (E.lHom Y) = E.whiskerRight (E.ρHom X) Y

/-- When `E.obj` sends `unitObj` to `𝟙_ D` and `tensorObj` to `⊗` in a monoidal category `D`,
and its operations agree heterogeneously with the monoidal structure of `D`, `E` is lawful. -/
theorem Lawful.ofMonoidal [MonoidalCategory D] (E : MonoidalEval unitObj tensorObj D)
    (hunit : E.obj unitObj = 𝟙_ D)
    (htensor : ∀ X Y, E.obj (tensorObj X Y) = E.obj X ⊗ E.obj Y)
    (hα_hom : ∀ X Y Z, HEq (E.αHom X Y Z) (α_ (E.obj X) (E.obj Y) (E.obj Z)).hom)
    (hα_inv : ∀ X Y Z, HEq (E.αInv X Y Z) (α_ (E.obj X) (E.obj Y) (E.obj Z)).inv)
    (hl_hom : ∀ X, HEq (E.lHom X) (λ_ (E.obj X)).hom)
    (hl_inv : ∀ X, HEq (E.lInv X) (λ_ (E.obj X)).inv)
    (hρ_hom : ∀ X, HEq (E.ρHom X) (ρ_ (E.obj X)).hom)
    (hρ_inv : ∀ X, HEq (E.ρInv X) (ρ_ (E.obj X)).inv)
    (hwL : ∀ X {Y₁ Y₂} (f : E.obj Y₁ ⟶ E.obj Y₂), HEq (E.whiskerLeft X f) (E.obj X ◁ f))
    (hwR : ∀ {X₁ X₂} (f : E.obj X₁ ⟶ E.obj X₂) Y, HEq (E.whiskerRight f Y) (f ▷ E.obj Y))
    (htens : ∀ {W X Y Z} (f : E.obj W ⟶ E.obj Y) (g : E.obj X ⟶ E.obj Z),
      HEq (E.tensorHom f g) (f ⊗ₘ g)) :
    E.Lawful := by
  have heq_eq {A B A' B' : D} {f : A ⟶ B} {g : A' ⟶ B'} (hA : A = A') (hB : B = B')
      (h : HEq f g) : f = eqToHom hA ≫ g ≫ eqToHom hB.symm := by
    subst hA hB; simp [eq_of_heq h]
  have eα_hom (X Y Z) : E.αHom X Y Z =
      eqToHom (by rw [htensor, htensor]) ≫ (α_ (E.obj X) (E.obj Y) (E.obj Z)).hom ≫
        eqToHom (by rw [htensor, htensor]) :=
    heq_eq (by rw [htensor, htensor]) (by rw [htensor, htensor]) (hα_hom X Y Z)
  have eα_inv (X Y Z) : E.αInv X Y Z =
      eqToHom (by rw [htensor, htensor]) ≫ (α_ (E.obj X) (E.obj Y) (E.obj Z)).inv ≫
        eqToHom (by rw [htensor, htensor]) :=
    heq_eq (by rw [htensor, htensor]) (by rw [htensor, htensor]) (hα_inv X Y Z)
  have el_hom (X) : E.lHom X =
      eqToHom (by rw [htensor, hunit]) ≫ (λ_ (E.obj X)).hom := by
    simpa using heq_eq (by rw [htensor, hunit]) rfl (hl_hom X)
  have el_inv (X) : E.lInv X =
      (λ_ (E.obj X)).inv ≫ eqToHom (by rw [htensor, hunit]) := by
    simpa using heq_eq rfl (by rw [htensor, hunit]) (hl_inv X)
  have eρ_hom (X) : E.ρHom X =
      eqToHom (by rw [htensor, hunit]) ≫ (ρ_ (E.obj X)).hom := by
    simpa using heq_eq (by rw [htensor, hunit]) rfl (hρ_hom X)
  have eρ_inv (X) : E.ρInv X =
      (ρ_ (E.obj X)).inv ≫ eqToHom (by rw [htensor, hunit]) := by
    simpa using heq_eq rfl (by rw [htensor, hunit]) (hρ_inv X)
  have ewL (X) {Y₁ Y₂} (f : E.obj Y₁ ⟶ E.obj Y₂) :
      E.whiskerLeft X f = eqToHom (htensor X Y₁) ≫ (E.obj X ◁ f) ≫ eqToHom (htensor X Y₂).symm :=
    heq_eq (htensor X Y₁) (htensor X Y₂) (hwL X f)
  have ewR {X₁ X₂} (f : E.obj X₁ ⟶ E.obj X₂) (Y) :
      E.whiskerRight f Y = eqToHom (htensor X₁ Y) ≫ (f ▷ E.obj Y) ≫ eqToHom (htensor X₂ Y).symm :=
    heq_eq (htensor X₁ Y) (htensor X₂ Y) (hwR f Y)
  have etens {W X Y Z} (f : E.obj W ⟶ E.obj Y) (g : E.obj X ⟶ E.obj Z) :
      E.tensorHom f g = eqToHom (htensor W X) ≫ (f ⊗ₘ g) ≫ eqToHom (htensor Y Z).symm :=
    heq_eq (htensor W X) (htensor Y Z) (htens f g)
  have hα_congr {A B C A' B' C' : D} (hA : A = A') (hB : B = B') (hC : C = C') :
      (α_ A B C).hom = eqToHom (by rw [hA, hB, hC]) ≫ (α_ A' B' C').hom ≫
        eqToHom (by rw [hA, hB, hC]) := by
    subst hA hB hC; simp
  have htensor_l {A B A' B' C D' : D} (hA : A = A') (hB : B' = B)
      (f : A' ⟶ B') (g : C ⟶ D') :
      (eqToHom hA ≫ f ≫ eqToHom hB) ⊗ₘ g =
        eqToHom (by rw [hA]) ≫ (f ⊗ₘ g) ≫ eqToHom (by rw [hB]) := by
    subst hA hB; simp
  have htensor_r {A B C C' D' D'' : D} (hC : C = C') (hD : D' = D'')
      (f : A ⟶ B) (g : C' ⟶ D') :
      f ⊗ₘ (eqToHom hC ≫ g ≫ eqToHom hD) =
        eqToHom (by rw [hC]) ≫ (f ⊗ₘ g) ≫ eqToHom (by rw [hD]) := by
    subst hC hD; simp
  have hwL_congr {A A' B C : D} (hA : A = A') (f : B ⟶ C) :
      A ◁ f = eqToHom (by rw [hA]) ≫ (A' ◁ f) ≫ eqToHom (by rw [hA]) := by
    subst hA; simp
  have hwR_congr {A B C C' : D} (f : A ⟶ B) (hC : C = C') :
      f ▷ C = eqToHom (by rw [hC]) ≫ (f ▷ C') ≫ eqToHom (by rw [hC]) := by
    subst hC; simp
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro X₁ Y₁ X₂ Y₂ f g
    simp [etens, ewR, ewL, MonoidalCategory.tensorHom_def]
  · intro X Y; simp [etens]
  · intro X₁ Y₁ Z₁ X₂ Y₂ Z₂ f₁ f₂ g₁ g₂
    simp [etens]
  · intro X Y; simp [ewL]
  · intro X Y; simp [ewR]
  · intro X Y Z; simp [eα_hom, eα_inv]
  · intro X Y Z; simp [eα_hom, eα_inv]
  · intro X₁ X₂ X₃ Y₁ Y₂ Y₃ f₁ f₂ f₃
    simp only [etens, eα_hom, Category.assoc]
    rw [htensor_l, htensor_r]
    simp
  · intro X; simp [eρ_hom, eρ_inv]
  · intro X; simp [eρ_hom, eρ_inv]
  · intro X Y f
    simp only [ewR, eρ_hom, Category.assoc]
    rw [hwR_congr f hunit]
    simp
  · intro X; simp [el_hom, el_inv]
  · intro X; simp [el_hom, el_inv]
  · intro X Y f
    simp only [ewL, el_hom, Category.assoc]
    rw [hwL_congr hunit f]
    simp
  · intro W X Y Z
    simp only [ewR, ewL, eα_hom, Category.assoc]
    rw [hα_congr rfl (htensor X Y) rfl, hα_congr (htensor W X) rfl rfl,
      hα_congr rfl rfl (htensor Y Z)]
    simp
  · intro X Y
    simp only [ewR, ewL, eα_hom, el_hom, eρ_hom, Category.assoc]
    rw [hα_congr rfl hunit rfl]
    simp

end MonoidalEval

variable {unitObj tensorObj Gen}

/-- Interpret a formal morphism into `D` using a `MonoidalEval` and generator images `fg`. -/
@[expose] def liftMapAux (E : MonoidalEval unitObj tensorObj D)
    (fg : ∀ {X Y : Obj}, Gen X Y → (E.obj X ⟶ E.obj Y)) :
    ∀ {X Y : Obj}, Hom unitObj tensorObj Gen X Y → (E.obj X ⟶ E.obj Y)
  | _, _, Hom.id _ => 𝟙 _
  | _, _, Hom.α_hom X Y Z => E.αHom X Y Z
  | _, _, Hom.α_inv X Y Z => E.αInv X Y Z
  | _, _, Hom.l_hom X => E.lHom X
  | _, _, Hom.l_inv X => E.lInv X
  | _, _, Hom.ρ_hom X => E.ρHom X
  | _, _, Hom.ρ_inv X => E.ρInv X
  | _, _, Hom.gen g => fg g
  | _, _, Hom.comp f g => liftMapAux E fg f ≫ liftMapAux E fg g
  | _, _, Hom.whiskerLeft X p => E.whiskerLeft X (liftMapAux E fg p)
  | _, _, Hom.whiskerRight p X => E.whiskerRight (liftMapAux E fg p) X
  | _, _, Hom.tensor f g => E.tensorHom (liftMapAux E fg f) (liftMapAux E fg g)

/-- Interpretation of formal morphisms respects all monoidal axioms and any extra relations `Rel`
respected by `liftMapAux E fg`. -/
theorem liftMapAux_sound
    (Rel : ∀ {X Y : Obj}, Hom unitObj tensorObj Gen X Y → Hom unitObj tensorObj Gen X Y → Prop)
    (E : MonoidalEval unitObj tensorObj D) (hE : E.Lawful)
    (fg : ∀ {X Y : Obj}, Gen X Y → (E.obj X ⟶ E.obj Y))
    (hrel : ∀ {X Y : Obj} {f g : Hom unitObj tensorObj Gen X Y}, Rel f g →
      liftMapAux E fg f = liftMapAux E fg g)
    {X Y : Obj} {f g : Hom unitObj tensorObj Gen X Y} (h : HomEquiv Rel f g) :
    liftMapAux E fg f = liftMapAux E fg g := by
  induction h with
  | refl => rfl
  | symm _ _ _ hfg => exact hfg.symm
  | trans _ _ hfg hgh => exact hfg.trans hgh
  | comp _ _ hf hg => simp only [liftMapAux, hf, hg]
  | whiskerLeft _ _ _ _ hf => dsimp only [liftMapAux]; rw [hf]
  | whiskerRight _ _ _ _ hf => dsimp only [liftMapAux]; rw [hf]
  | tensor _ _ hf hg => dsimp only [liftMapAux]; rw [hf, hg]
  | tensorHom_def => exact hE.tensorHom_def _ _
  | comp_id => exact Category.comp_id _
  | id_comp => exact Category.id_comp _
  | assoc => exact Category.assoc _ _ _
  | id_tensorHom_id => exact hE.id_tensorHom_id _ _
  | tensorHom_comp_tensorHom => exact hE.tensorHom_comp_tensorHom _ _ _ _
  | whiskerLeft_id => exact hE.whiskerLeft_id _ _
  | id_whiskerRight => exact hE.id_whiskerRight _ _
  | α_hom_inv => exact hE.α_hom_inv _ _ _
  | α_inv_hom => exact hE.α_inv_hom _ _ _
  | associator_naturality => exact hE.associator_naturality _ _ _
  | ρ_hom_inv => exact hE.ρ_hom_inv _
  | ρ_inv_hom => exact hE.ρ_inv_hom _
  | ρ_naturality => exact hE.ρ_naturality _
  | l_hom_inv => exact hE.l_hom_inv _
  | l_inv_hom => exact hE.l_inv_hom _
  | l_naturality => exact hE.l_naturality _
  | pentagon => exact hE.pentagon _ _ _ _
  | triangle => exact hE.triangle _ _
  | extra hr => exact hrel hr

/-- The functor out of `Free P` determined by `E` and `fg`. Exposed so that its object and
morphism actions simplify definitionally. -/
@[expose] def lift {P : Presentation.{u, v}} (E : MonoidalEval P.unitObj P.tensorObj D)
    (hE : E.Lawful)
    (fg : ∀ {X Y : P.Obj}, P.Gen X Y → (E.obj X ⟶ E.obj Y))
    (hrel : ∀ {X Y : P.Obj} {f g : Hom P.unitObj P.tensorObj P.Gen X Y}, P.Rel f g →
      liftMapAux E fg f = liftMapAux E fg g) :
    Free P ⥤ D where
  obj X := E.obj X.as
  map f := Quotient.lift (liftMapAux E fg)
    (fun _ _ h ↦ liftMapAux_sound P.Rel E hE fg hrel h) f
  map_id _ := rfl
  map_comp f g := Quot.inductionOn f fun _ ↦ Quot.inductionOn g fun _ ↦ rfl

end Lift

