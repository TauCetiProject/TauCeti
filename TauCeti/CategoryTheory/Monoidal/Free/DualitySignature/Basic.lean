namespace TensorSignature

/-- Evaluating a monoidal word in `S.toDualitySignature.FreeRigid` agrees with embedding the word
into `RigidObject`. -/
@[simp]
theorem projectObj_of_toDualitySignature (S : TensorSignature.{u, v})
    (X : FreeMonoidalCategory S.Obj) :
    FreeMonoidalCategory.projectObj
        (fun a ↦ DualitySignature.FreeRigid.of (S := S.toDualitySignature) a) X =
      ⟨X.toRigidObject⟩ :=
  (RigidObject.eval_toRigidObject
      (fun a ↦ DualitySignature.FreeRigid.of (S := S.toDualitySignature) a) X).symm.trans
    (DualitySignature.FreeRigid.eval_of (S := S.toDualitySignature) X.toRigidObject)

/-- The canonical strong monoidal functor from the free monoidal category on a tensor signature
`S` into the free rigid monoidal category on `S.toDualitySignature`. -/
@[expose] def ofFreeMonoidal (S : TensorSignature.{u, v}) :
    S.FreeMonoidal ⥤ S.toDualitySignature.FreeRigid :=
  FreeMonoidal.lift (fun a ↦ DualitySignature.FreeRigid.of (S := S.toDualitySignature) a)
    (fun g ↦ eqToHom (projectObj_of_toDualitySignature S (S.src g)) ≫
      DualitySignature.FreeRigid.coupon (S := S.toDualitySignature) g ≫
      eqToHom (projectObj_of_toDualitySignature S (S.tgt g)).symm)

@[simp]
theorem ofFreeMonoidal_obj_of (S : TensorSignature.{u, v}) (a : S.Obj) :
    (ofFreeMonoidal S).obj (FreeMonoidal.of a) =
      DualitySignature.FreeRigid.of (S := S.toDualitySignature) a := by rfl

@[simp]
theorem ofFreeMonoidal_obj_tensorUnit (S : TensorSignature.{u, v}) :
    (ofFreeMonoidal S).obj (𝟙_ S.FreeMonoidal) = 𝟙_ S.toDualitySignature.FreeRigid := by rfl

@[simp]
theorem ofFreeMonoidal_obj_tensor (S : TensorSignature.{u, v}) (X Y : S.FreeMonoidal) :
    (ofFreeMonoidal S).obj (X ⊗ Y) = (ofFreeMonoidal S).obj X ⊗ (ofFreeMonoidal S).obj Y := by rfl

theorem ofFreeMonoidal_obj (S : TensorSignature.{u, v}) (X : S.FreeMonoidal) :
    (ofFreeMonoidal S).obj X = ⟨X.as.toRigidObject⟩ :=
  projectObj_of_toDualitySignature S X.as

instance (S : TensorSignature.{u, v}) : (ofFreeMonoidal S).Monoidal := by
  unfold ofFreeMonoidal; infer_instance

@[simp]
theorem ofFreeMonoidal_map_coupon (S : TensorSignature.{u, v}) (g : S.Coupon) :
    (ofFreeMonoidal S).map (FreeMonoidal.coupon g) =
      eqToHom (ofFreeMonoidal_obj S ⟨S.src g⟩) ≫
        DualitySignature.FreeRigid.coupon (S := S.toDualitySignature) g ≫
        eqToHom (ofFreeMonoidal_obj S ⟨S.tgt g⟩).symm := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_map_coupon _ _ g

@[simp]
theorem ofFreeMonoidal_ε (S : TensorSignature.{u, v}) :
    Functor.LaxMonoidal.ε (ofFreeMonoidal S) = 𝟙 _ := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_ε _ _

@[simp]
theorem ofFreeMonoidal_η (S : TensorSignature.{u, v}) :
    Functor.OplaxMonoidal.η (ofFreeMonoidal S) = 𝟙 _ := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_η _ _

@[simp]
theorem ofFreeMonoidal_μ (S : TensorSignature.{u, v}) (X Y : S.FreeMonoidal) :
    Functor.LaxMonoidal.μ (ofFreeMonoidal S) X Y = 𝟙 _ := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_μ _ _ X Y

@[simp]
theorem ofFreeMonoidal_δ (S : TensorSignature.{u, v}) (X Y : S.FreeMonoidal) :
    Functor.OplaxMonoidal.δ (ofFreeMonoidal S) X Y = 𝟙 _ := by
  unfold ofFreeMonoidal; exact FreeMonoidal.lift_δ _ _ X Y

