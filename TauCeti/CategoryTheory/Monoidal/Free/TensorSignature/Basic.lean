module

public import TauCeti.CategoryTheory.Monoidal.Free.Basic
public import TauCeti.CategoryTheory.Monoidal.Free.MonoidalCore
public import TauCeti.CategoryTheory.Monoidal.Free.ProjectObj
public import TauCeti.CategoryTheory.Monoidal.NaturalTransformation

/-!
# The free monoidal category on a tensor signature

A *tensor signature* consists of a type of generating objects and a type of generating
morphisms (*coupons*), each coupon having a source and a target which are formal tensor words
in the generating objects. Words are Mathlib's `FreeMonoidalCategory` objects, so a coupon
`A ⊗ B ⟶ C` keeps its two input ports rather than becoming a unary generator on a new atom,
a coupon whose source is the empty word `FreeMonoidalCategory.unit` has no inputs, and the
generating types may be arbitrary (not necessarily finite). Joyal and Street call such data a
tensor scheme; there the boundaries are unparenthesized lists.

The free monoidal category `TensorSignature.FreeMonoidal S` on a signature `S` has the words
as objects. Its morphisms are formal composites, tensor products and whiskerings of
identities, associators, unitors and coupons, modulo exactly the axioms of a monoidal category;
no equation between coupons is imposed. This extends Mathlib's object-generated
`FreeMonoidalCategory` by arbitrary-arity morphism generators, via the shared presentation core
`TauCeti.MonoidalCore` (following `Mathlib/CategoryTheory/Monoidal/Free/Basic.lean`, Markus
Himmel).

## Main definitions and results

* `TauCeti.TensorSignature`: generating objects and coupons with tensor-word boundaries.
* `TauCeti.TensorSignature.FreeMonoidal S`: the free monoidal category on `S`, with
  `FreeMonoidal.of` and `FreeMonoidal.coupon` for the generators.
* `FreeMonoidal.Hom.inductionOn`: morphisms are generated by identities, structural
  isomorphisms and coupons under composition and whiskering.
* `FreeMonoidal.lift fo fc`: the strong monoidal functor into an arbitrary (not necessarily
  strict) monoidal category determined by images `fo` of the generating objects and `fc` of the
  coupons, with computation rules `FreeMonoidal.lift_obj_of` and `FreeMonoidal.lift_map_coupon`.
* `FreeMonoidal.monoidalNatIso`: two strong monoidal functors that agree up to isomorphism on
  the generating objects, compatibly with the coupons, are monoidally naturally isomorphic. Taking
  one of them to be `lift fo fc`, this is the uniqueness of the lift.
* `FreeMonoidal.natTrans_ext`: monoidal natural transformations out of the free monoidal
  category are determined by their components at the generating objects.
* `FreeMonoidal.mapWordIso F X`: the comparison between the image of a tensor word under a
  strong monoidal functor `F` and the word interpreted on the images of the generators, built
  from the tensorators and the unit comparison of `F`.
* `FreeMonoidal.wordIso_eq_mapWordIso`: the isomorphisms `FreeMonoidal.wordIso` between two
  strong monoidal functors factor through these comparisons.
* `FreeMonoidal.wordIso_app`: a monoidal natural isomorphism out of the free monoidal category
  is the `wordIso` of its components at the generating objects.

Together these are the universal property of the free monoidal category on a tensor scheme
(Joyal–Street, *The geometry of tensor calculus I*, §1), for strong monoidal functors into
arbitrary monoidal categories.

## References

* A. Joyal and R. Street, *The geometry of tensor calculus I*, Adv. Math. 88 (1991).
-/

public section

universe u v u' v'

open CategoryTheory MonoidalCategory FreeMonoidalCategory

namespace TauCeti

/-- A tensor signature: a type `Obj` of generating objects and a type `Coupon` of generating
morphisms, each coupon having a source and a target formal tensor word in the generating
objects. The words may be the empty word `FreeMonoidalCategory.unit`, so coupons may have no
inputs or no outputs. -/
structure TensorSignature where
  /-- The generating objects. -/
  Obj : Type u
  /-- The generating morphisms (coupons). -/
  Coupon : Type v
  /-- The source word of a coupon. -/
  src : Coupon → FreeMonoidalCategory Obj
  /-- The target word of a coupon. -/
  tgt : Coupon → FreeMonoidalCategory Obj

namespace TensorSignature

/-- Extra morphism generators of `S.FreeMonoidal`: a single generator for each coupon of `S`. -/
inductive FreeMonoidalGen (S : TensorSignature.{u, v}) :
    FreeMonoidalCategory S.Obj → FreeMonoidalCategory S.Obj → Type (max u v)
  | coupon (g : S.Coupon) : FreeMonoidalGen S (S.src g) (S.tgt g)

/-- The monoidal presentation of the free monoidal category on a tensor signature `S`: formal
tensor words in `S.Obj`, coupon generators `FreeMonoidalGen S`, and no extra relations. -/
@[expose] def freeMonoidalPresentation (S : TensorSignature.{u, v}) :
    MonoidalCore.Presentation.{u, max u v} where
  Obj := FreeMonoidalCategory S.Obj
  unitObj := FreeMonoidalCategory.unit
  tensorObj := FreeMonoidalCategory.tensor
  Gen := FreeMonoidalGen S
  Rel _ _ := False

/-- The free monoidal category on a tensor signature `S`. Its objects are the formal tensor
words in the generating objects of `S`. -/
abbrev FreeMonoidal (S : TensorSignature.{u, v}) : Type u :=
  MonoidalCore.Free (freeMonoidalPresentation S)

namespace FreeMonoidal

variable {S : TensorSignature.{u, v}}

/-- Construct an object of `S.FreeMonoidal` from a formal tensor word. -/
abbrev mk (as : FreeMonoidalCategory S.Obj) : S.FreeMonoidal := ⟨as⟩

/-- Extract the underlying formal tensor word of an object of `S.FreeMonoidal`. -/
abbrev as (X : S.FreeMonoidal) : FreeMonoidalCategory S.Obj := MonoidalCore.Free.as X

/-- The object of the free monoidal category given by a single generating object. -/
@[expose] def of (a : S.Obj) : S.FreeMonoidal := ⟨.of a⟩

/-- Formal composites, tensor products and whiskerings of identities, associators, unitors
and coupons. The morphisms of the free monoidal category on `S` are a quotient of these. -/
abbrev Hom (X Y : FreeMonoidalCategory S.Obj) : Type (max u v) :=
  MonoidalCore.Hom FreeMonoidalCategory.unit FreeMonoidalCategory.tensor
    (FreeMonoidalGen S) X Y

/-- The formal morphism given by a coupon `g` of `S`. -/
@[match_pattern] abbrev Hom.coupon (g : S.Coupon) : Hom (S := S) (S.src g) (S.tgt g) :=
  MonoidalCore.Hom.gen (.coupon g)

/-- The relation on formal morphisms generated by the axioms of a monoidal category. It imposes
no equation on coupons. -/
abbrev HomEquiv {X Y : FreeMonoidalCategory S.Obj} (f g : Hom (S := S) X Y) : Prop :=
  MonoidalCore.HomEquiv (fun _ _ ↦ False) f g

/-- Formal morphisms are identified when the axioms of a monoidal category make them equal. -/
abbrev setoidHom (X Y : FreeMonoidalCategory S.Obj) : Setoid (Hom (S := S) X Y) :=
  MonoidalCore.setoidHom FreeMonoidalCategory.unit FreeMonoidalCategory.tensor
    (FreeMonoidalGen S) (fun _ _ ↦ False) X Y

/-- The word underlying the interpretation of a tensor word by objects `h` of the free monoidal
category on a signature is its interpretation by the words underlying those objects. -/
theorem as_projectObj {A : Type*} (h : A → S.FreeMonoidal) (X : FreeMonoidalCategory A) :
    (projectObj h X).as = projectObj (fun a ↦ (h a).as) X := by
  induction X with
  | of a => rfl
  | unit => rfl
  | tensor X Y hX hY => exact congrArg₂ FreeMonoidalCategory.tensor hX hY

/-- Interpreting a tensor word by its own generating objects recovers the word; this is
`FreeMonoidalCategory.projectObj_of` for the free monoidal category on a signature. -/
@[simp]
theorem projectObj_of (X : FreeMonoidalCategory S.Obj) : projectObj (of (S := S)) X = ⟨X⟩ :=
  congrArg FreeMonoidal.mk ((as_projectObj of X).trans (FreeMonoidalCategory.projectObj_of X))

/-- Interpreting a tensor word after replacing its generating objects by tensor words `h` is
interpreting it by the interpretations of those words; this is
`FreeMonoidalCategory.projectObj_projectObj` for the free monoidal category on a signature. -/
theorem projectObj_projectObj {T : TensorSignature.{u', v'}} {D : Type*} [Category D]
    [MonoidalCategory D] (f : T.Obj → D) (h : S.Obj → T.FreeMonoidal)
    (X : FreeMonoidalCategory S.Obj) :
    projectObj f (projectObj h X).as = projectObj (fun a ↦ projectObj f (h a).as) X := by
  rw [as_projectObj, FreeMonoidalCategory.projectObj_projectObj]

/-- The morphism of the free monoidal category represented by a formal morphism. -/
abbrev homMk {X Y : S.FreeMonoidal} (f : Hom (S := S) X.as Y.as) : X ⟶ Y :=
  MonoidalCore.homMk f

/-- Two formal morphisms represent the same morphism if and only if they are related by
`HomEquiv`. -/
theorem homMk_eq_iff {X Y : S.FreeMonoidal} (f g : Hom (S := S) X.as Y.as) :
    homMk f = homMk g ↔ HomEquiv f g :=
  MonoidalCore.homMk_eq_iff (P := freeMonoidalPresentation S) f g

/-- The generating morphism given by a coupon, from its source word to its target word. -/
@[expose] def coupon (g : S.Coupon) : (⟨S.src g⟩ : S.FreeMonoidal) ⟶ ⟨S.tgt g⟩ :=
  homMk (Hom.coupon g)

@[simp]
theorem homMk_id (X : S.FreeMonoidal) : homMk (MonoidalCore.Hom.id X.as) = 𝟙 X := rfl

@[simp]
theorem homMk_comp {X Y Z : S.FreeMonoidal}
    (f : Hom (S := S) X.as Y.as) (g : Hom (S := S) Y.as Z.as) :
    homMk (Y := Z) (f.comp g) = homMk f ≫ homMk g := rfl

@[simp]
theorem homMk_tensor {X₁ Y₁ X₂ Y₂ : S.FreeMonoidal}
    (f : Hom (S := S) X₁.as Y₁.as) (g : Hom (S := S) X₂.as Y₂.as) :
    homMk (X := X₁ ⊗ X₂) (Y := Y₁ ⊗ Y₂) (f.tensor g) = homMk f ⊗ₘ homMk g := rfl

@[simp]
theorem homMk_whiskerLeft (X : S.FreeMonoidal) {Y₁ Y₂ : S.FreeMonoidal}
    (f : Hom (S := S) Y₁.as Y₂.as) :
    homMk (X := X ⊗ Y₁) (Y := X ⊗ Y₂) (f.whiskerLeft X.as) = X ◁ homMk f := rfl

@[simp]
theorem homMk_whiskerRight {X₁ X₂ : S.FreeMonoidal}
    (f : Hom (S := S) X₁.as X₂.as) (Y : S.FreeMonoidal) :
    homMk (X := X₁ ⊗ Y) (Y := X₂ ⊗ Y) (f.whiskerRight Y.as) = homMk f ▷ Y := rfl

@[simp]
theorem homMk_α_hom (X Y Z : S.FreeMonoidal) :
    homMk (X := (X ⊗ Y) ⊗ Z) (Y := X ⊗ (Y ⊗ Z))
      (MonoidalCore.Hom.α_hom X.as Y.as Z.as) = (α_ X Y Z).hom := rfl

@[simp]
theorem homMk_α_inv (X Y Z : S.FreeMonoidal) :
    homMk (X := X ⊗ (Y ⊗ Z)) (Y := (X ⊗ Y) ⊗ Z)
      (MonoidalCore.Hom.α_inv X.as Y.as Z.as) = (α_ X Y Z).inv := rfl

@[simp]
theorem homMk_l_hom (X : S.FreeMonoidal) :
    homMk (X := 𝟙_ _ ⊗ X) (MonoidalCore.Hom.l_hom X.as) = (λ_ X).hom := rfl

@[simp]
theorem homMk_l_inv (X : S.FreeMonoidal) :
    homMk (Y := 𝟙_ _ ⊗ X) (MonoidalCore.Hom.l_inv X.as) = (λ_ X).inv := rfl

@[simp]
theorem homMk_ρ_hom (X : S.FreeMonoidal) :
    homMk (X := X ⊗ 𝟙_ _) (MonoidalCore.Hom.ρ_hom X.as) = (ρ_ X).hom := rfl

@[simp]
theorem homMk_ρ_inv (X : S.FreeMonoidal) :
    homMk (Y := X ⊗ 𝟙_ _) (MonoidalCore.Hom.ρ_inv X.as) = (ρ_ X).inv := rfl

@[simp]
theorem homMk_coupon (g : S.Coupon) :
    homMk (X := ⟨S.src g⟩) (Y := ⟨S.tgt g⟩) (Hom.coupon g) = coupon g := rfl

/-- Induction principle for morphisms of the free monoidal category: a property of morphisms
holding for identities, associators, unitors and coupons, and stable under composition and
whiskering on either side, holds for every morphism. -/
theorem Hom.inductionOn {motive : {X Y : S.FreeMonoidal} → (X ⟶ Y) → Prop} {X Y : S.FreeMonoidal}
    (t : X ⟶ Y)
    (id : (X : S.FreeMonoidal) → motive (𝟙 X))
    (α_hom : (X Y Z : S.FreeMonoidal) → motive (α_ X Y Z).hom)
    (α_inv : (X Y Z : S.FreeMonoidal) → motive (α_ X Y Z).inv)
    (l_hom : (X : S.FreeMonoidal) → motive (λ_ X).hom)
    (l_inv : (X : S.FreeMonoidal) → motive (λ_ X).inv)
    (ρ_hom : (X : S.FreeMonoidal) → motive (ρ_ X).hom)
    (ρ_inv : (X : S.FreeMonoidal) → motive (ρ_ X).inv)
    (coupon : (g : S.Coupon) → motive (FreeMonoidal.coupon g))
    (comp : {X Y Z : S.FreeMonoidal} → (f : X ⟶ Y) → (g : Y ⟶ Z) → motive f → motive g →
      motive (f ≫ g))
    (whiskerLeft : (X : S.FreeMonoidal) → {Y Z : S.FreeMonoidal} → (f : Y ⟶ Z) → motive f →
      motive (X ◁ f))
    (whiskerRight : {X Y : S.FreeMonoidal} → (f : X ⟶ Y) → (Z : S.FreeMonoidal) → motive f →
      motive (f ▷ Z)) :
    motive t :=
  MonoidalCore.Hom.inductionOn t id α_hom α_inv l_hom l_inv ρ_hom ρ_inv
    (fun | .coupon g => coupon g) comp whiskerLeft whiskerRight

section Lift

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D] (fo : S.Obj → D)
  (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g))

/-- The functor out of the free monoidal category on `S` determined by the images `fo` of the
generating objects and `fc` of the coupons. It is strong monoidal, with identity tensorator and
unit comparison. -/
@[expose] def lift : S.FreeMonoidal ⥤ D :=
  MonoidalCore.lift
    { obj := fun X ↦ projectObj fo X
      αHom := fun _ _ _ ↦ (α_ _ _ _).hom
      αInv := fun _ _ _ ↦ (α_ _ _ _).inv
      lHom := fun _ ↦ (λ_ _).hom
      lInv := fun _ ↦ (λ_ _).inv
      ρHom := fun _ ↦ (ρ_ _).hom
      ρInv := fun _ ↦ (ρ_ _).inv
      whiskerLeft := fun X {_ _} f ↦ projectObj fo X ◁ f
      whiskerRight := fun {_ _} f X ↦ f ▷ projectObj fo X
      tensorHom := fun {_ _ _ _} f g ↦ f ⊗ₘ g }
    (MonoidalCore.MonoidalEval.Lawful.ofMonoidal _ rfl (fun _ _ ↦ rfl)
      (fun _ _ _ ↦ HEq.rfl) (fun _ _ _ ↦ HEq.rfl) (fun _ ↦ HEq.rfl) (fun _ ↦ HEq.rfl)
      (fun _ ↦ HEq.rfl) (fun _ ↦ HEq.rfl) (fun _ {_ _} _ ↦ HEq.rfl) (fun {_ _} _ _ ↦ HEq.rfl)
      (fun {_ _ _ _} _ _ ↦ HEq.rfl))
    (fun | .coupon g => fc g) (fun h ↦ False.elim h)

/-- The interpretation of morphisms of the free monoidal category on `S`, given the images `fo`
of the generating objects and `fc` of the coupons. This is the action of `FreeMonoidal.lift` on
morphisms; use the `lift_map_*` lemmas to compute it. -/
def liftMap {X Y : S.FreeMonoidal} (f : X ⟶ Y) : projectObj fo X.as ⟶ projectObj fo Y.as :=
  (lift fo fc).map f

theorem liftMap_id (X : S.FreeMonoidal) : liftMap fo fc (𝟙 X) = 𝟙 _ :=
  (lift fo fc).map_id X

theorem liftMap_comp {X Y Z : S.FreeMonoidal} (f : X ⟶ Y) (g : Y ⟶ Z) :
    liftMap fo fc (f ≫ g) = liftMap fo fc f ≫ liftMap fo fc g :=
  (lift fo fc).map_comp f g

@[simp]
theorem lift_obj_of (a : S.Obj) : (lift fo fc).obj (of a) = fo a := rfl

@[simp]
theorem lift_obj_tensor (X Y : S.FreeMonoidal) :
    (lift fo fc).obj (X ⊗ Y) = (lift fo fc).obj X ⊗ (lift fo fc).obj Y := rfl

@[simp]
theorem lift_obj_tensorUnit : (lift fo fc).obj (𝟙_ S.FreeMonoidal) = 𝟙_ D := rfl

@[simp]
theorem lift_map_coupon (g : S.Coupon) : (lift fo fc).map (coupon g) = fc g := by rfl

@[simp]
theorem lift_map_whiskerLeft (X : S.FreeMonoidal) {Y₁ Y₂ : S.FreeMonoidal} (f : Y₁ ⟶ Y₂) :
    (lift fo fc).map (X ◁ f) = (lift fo fc).obj X ◁ (lift fo fc).map f := by
  induction f using Quotient.inductionOn
  rfl

@[simp]
theorem lift_map_whiskerRight {X₁ X₂ : S.FreeMonoidal} (f : X₁ ⟶ X₂) (Y : S.FreeMonoidal) :
    (lift fo fc).map (f ▷ Y) = (lift fo fc).map f ▷ (lift fo fc).obj Y := by
  induction f using Quotient.inductionOn
  rfl

@[simp]
theorem lift_map_tensorHom {X₁ Y₁ X₂ Y₂ : S.FreeMonoidal} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂) :
    (lift fo fc).map (f ⊗ₘ g) = (lift fo fc).map f ⊗ₘ (lift fo fc).map g := by
  induction f using Quotient.inductionOn
  induction g using Quotient.inductionOn
  rfl

@[simp]
theorem lift_map_associator_hom (X Y Z : S.FreeMonoidal) :
    (lift fo fc).map (α_ X Y Z).hom =
      (α_ ((lift fo fc).obj X) ((lift fo fc).obj Y) ((lift fo fc).obj Z)).hom := by rfl

@[simp]
theorem lift_map_associator_inv (X Y Z : S.FreeMonoidal) :
    (lift fo fc).map (α_ X Y Z).inv =
      (α_ ((lift fo fc).obj X) ((lift fo fc).obj Y) ((lift fo fc).obj Z)).inv := by rfl

/- The unitor lemmas are not `@[simp]`: the Mathlib simp lemmas
`Functor.LaxMonoidal.left_unitality` and `right_unitality` rewrite their right-hand sides back
into `(lift fo fc).map` of a unitor. -/
theorem lift_map_leftUnitor_hom (X : S.FreeMonoidal) :
    (lift fo fc).map (λ_ X).hom = (λ_ ((lift fo fc).obj X)).hom := by rfl

theorem lift_map_leftUnitor_inv (X : S.FreeMonoidal) :
    (lift fo fc).map (λ_ X).inv = (λ_ ((lift fo fc).obj X)).inv := by rfl

theorem lift_map_rightUnitor_hom (X : S.FreeMonoidal) :
    (lift fo fc).map (ρ_ X).hom = (ρ_ ((lift fo fc).obj X)).hom := by rfl

theorem lift_map_rightUnitor_inv (X : S.FreeMonoidal) :
    (lift fo fc).map (ρ_ X).inv = (ρ_ ((lift fo fc).obj X)).inv := by rfl

/- The tensorator and unit comparison of `lift fo fc` are identities. The coherence goals mix
the objects `(lift fo fc).obj (X ⊗ Y)` and `(lift fo fc).obj X ⊗ (lift fo fc).obj Y`, which agree
only after unfolding `lift`, so `dsimp only [lift_obj_tensor, lift_obj_tensorUnit]` first aligns
them syntactically for `simp`. -/
instance : (lift fo fc).Monoidal :=
  Functor.CoreMonoidal.toMonoidal
    { εIso := Iso.refl _
      μIso := fun _ _ ↦ Iso.refl _
      μIso_hom_natural_left := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor]
        simp
      μIso_hom_natural_right := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor]
        simp
      associativity := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor]
        simp
      left_unitality := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor, lift_obj_tensorUnit]
        simp [lift_map_leftUnitor_hom]
      right_unitality := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor, lift_obj_tensorUnit]
        simp [lift_map_rightUnitor_hom] }

@[simp]
theorem lift_ε : Functor.LaxMonoidal.ε (lift fo fc) = 𝟙 _ := rfl

@[simp]
theorem lift_η : Functor.OplaxMonoidal.η (lift fo fc) = 𝟙 _ := rfl

@[simp]
theorem lift_μ (X Y : S.FreeMonoidal) : Functor.LaxMonoidal.μ (lift fo fc) X Y = 𝟙 _ := rfl

@[simp]
theorem lift_δ (X Y : S.FreeMonoidal) : Functor.OplaxMonoidal.δ (lift fo fc) X Y = 𝟙 _ := rfl

end Lift

section MapWordIso

open Functor.LaxMonoidal Functor.OplaxMonoidal

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D]

/-- The comparison between the image of a tensor word under a strong monoidal functor `F` out of
the free monoidal category and the word interpreted on the images of the generating objects,
built from the tensorators and the unit comparison of `F`. -/
def mapWordIso (F : S.FreeMonoidal ⥤ D) [F.Monoidal] :
    ∀ X : FreeMonoidalCategory S.Obj, F.obj ⟨X⟩ ≅ projectObj (fun a ↦ F.obj (of a)) X
  | .of _ => Iso.refl _
  | .unit => (Functor.Monoidal.εIso F).symm
  | .tensor X Y => (Functor.Monoidal.μIso F ⟨X⟩ ⟨Y⟩).symm ≪≫ (mapWordIso F X ⊗ᵢ mapWordIso F Y)

section Computation

variable (F : S.FreeMonoidal ⥤ D) [F.Monoidal]

@[simp]
theorem mapWordIso_of (a : S.Obj) : mapWordIso F (.of a) = Iso.refl (F.obj (of a)) :=
  (rfl)

@[simp]
theorem mapWordIso_tensorUnit_hom :
    (mapWordIso F (𝟙_ (FreeMonoidalCategory S.Obj))).hom = η F :=
  (rfl)

@[simp]
theorem mapWordIso_tensor_hom (X Y : FreeMonoidalCategory S.Obj) :
    (mapWordIso F (X ⊗ Y)).hom =
      δ F ⟨X⟩ ⟨Y⟩ ≫ ((mapWordIso F X).hom ⊗ₘ (mapWordIso F Y).hom) :=
  (rfl)

@[simp]
theorem mapWordIso_tensorUnit_inv :
    (mapWordIso F (𝟙_ (FreeMonoidalCategory S.Obj))).inv = ε F :=
  (rfl)

@[simp]
theorem mapWordIso_tensor_inv (X Y : FreeMonoidalCategory S.Obj) :
    (mapWordIso F (X ⊗ Y)).inv =
      ((mapWordIso F X).inv ⊗ₘ (mapWordIso F Y).inv) ≫ μ F ⟨X⟩ ⟨Y⟩ :=
  (rfl)

end Computation

/-- For the strong monoidal functor `lift fo fc`, whose tensorators and unit comparison are
identities, the comparison `mapWordIso` is the identity. -/
@[simp]
theorem mapWordIso_lift (fo : S.Obj → D)
    (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g))
    (X : FreeMonoidalCategory S.Obj) : mapWordIso (lift fo fc) X = Iso.refl (projectObj fo X) := by
  ext
  induction X with
  | of a => rfl
  | unit => rfl
  | tensor X Y hX hY =>
    refine (mapWordIso_tensor_hom (lift fo fc) X Y).trans ?_
    rw [hX, hY, Iso.refl_hom, Iso.refl_hom]
    -- The tensorator of `lift fo fc` is the identity (`lift_δ`), but its source and target are
    -- only definitionally equal to `projectObj fo X ⊗ projectObj fo Y`, so `rw` cannot use it.
    exact (Category.id_comp _).trans (id_tensorHom_id _ _)

end MapWordIso

section Uniqueness

open Functor.LaxMonoidal Functor.OplaxMonoidal

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D]

/-- A monoidal natural transformation from a strong monoidal functor out of the free monoidal
category on `S` to a lax monoidal one is determined by its components at the generating
objects. -/
theorem natTrans_ext {F G : S.FreeMonoidal ⥤ D} [F.Monoidal] [G.LaxMonoidal] {α β : F ⟶ G}
    [NatTrans.IsMonoidal α] [NatTrans.IsMonoidal β] (h : ∀ a, α.app (of a) = β.app (of a)) :
    α = β := by
  ext ⟨X⟩
  induction X with
  | of a => exact h a
  | unit => exact NatTrans.IsMonoidal.app_tensorUnit_eq
  | tensor X Y hX hY => exact NatTrans.IsMonoidal.app_tensor_eq hX hY

variable (F G : S.FreeMonoidal ⥤ D) [F.Monoidal] [G.Monoidal] (e : ∀ a, F.obj (of a) ≅ G.obj (of a))

/-- The isomorphism between the images of a tensor word under two strong monoidal functors out
of the free monoidal category, induced by isomorphisms `e` at the generating objects together
with the tensorators and unit comparisons of the two functors. -/
def wordIso : ∀ X : FreeMonoidalCategory S.Obj, F.obj ⟨X⟩ ≅ G.obj ⟨X⟩
  | .of a => e a
  | .unit => Functor.Monoidal.unitIso F G
  | .tensor X Y => Functor.Monoidal.tensorIso F G (wordIso X) (wordIso Y)

@[simp]
theorem wordIso_of (a : S.Obj) : wordIso F G e (of a).as = e a := by rfl

@[simp]
theorem wordIso_tensorUnit_hom : (wordIso F G e (𝟙_ S.FreeMonoidal).as).hom = η F ≫ ε G := by rfl

@[simp]
theorem wordIso_tensor_hom (X Y : S.FreeMonoidal) :
    (wordIso F G e (X ⊗ Y).as).hom =
      δ F X Y ≫ ((wordIso F G e X.as).hom ⊗ₘ (wordIso F G e Y.as).hom) ≫ μ G X Y := by rfl

variable {F G e}

/-- The isomorphisms `wordIso F G e` are natural as soon as they are natural with respect to
the coupons. -/
theorem map_comp_wordIso_hom
    (he : ∀ g, F.map (coupon g) ≫ (wordIso F G e (S.tgt g)).hom =
      (wordIso F G e (S.src g)).hom ≫ G.map (coupon g))
    {X Y : S.FreeMonoidal} (f : X ⟶ Y) :
    F.map f ≫ (wordIso F G e Y.as).hom = (wordIso F G e X.as).hom ≫ G.map f := by
  have hunit : (wordIso F G e (𝟙_ S.FreeMonoidal).as).hom = η F ≫ ε G :=
    wordIso_tensorUnit_hom F G e
  have htensor : ∀ A B : S.FreeMonoidal,
      (wordIso F G e (A ⊗ B).as).hom =
        δ F A B ≫ ((wordIso F G e A.as).hom ⊗ₘ (wordIso F G e B.as).hom) ≫ μ G A B :=
    wordIso_tensor_hom F G e
  induction f using Hom.inductionOn with
  | id X => simp
  | α_hom X Y Z =>
    exact Functor.Monoidal.associator_hom_naturality_of_tensor
      (e := fun Z ↦ (wordIso F G e Z.as).hom) htensor X Y Z
  | α_inv X Y Z =>
    exact Functor.Monoidal.map_iso_inv_comp_eq_of_map_iso_hom (α_ X Y Z)
      (Functor.Monoidal.associator_hom_naturality_of_tensor
        (e := fun Z ↦ (wordIso F G e Z.as).hom) htensor X Y Z)
  | l_hom X =>
    exact Functor.Monoidal.leftUnitor_hom_naturality_of_unit_tensor
      (e := fun Z ↦ (wordIso F G e Z.as).hom) hunit htensor X
  | l_inv X =>
    exact Functor.Monoidal.map_iso_inv_comp_eq_of_map_iso_hom (λ_ X)
      (Functor.Monoidal.leftUnitor_hom_naturality_of_unit_tensor
        (e := fun Z ↦ (wordIso F G e Z.as).hom) hunit htensor X)
  | ρ_hom X =>
    exact Functor.Monoidal.rightUnitor_hom_naturality_of_unit_tensor
      (e := fun Z ↦ (wordIso F G e Z.as).hom) hunit htensor X
  | ρ_inv X =>
    exact Functor.Monoidal.map_iso_inv_comp_eq_of_map_iso_hom (ρ_ X)
      (Functor.Monoidal.rightUnitor_hom_naturality_of_unit_tensor
        (e := fun Z ↦ (wordIso F G e Z.as).hom) hunit htensor X)
  | coupon g => exact he g
  | comp f g hf hg =>
    rw [Functor.map_comp, Functor.map_comp, Category.assoc, hg, reassoc_of% hf]
  | whiskerLeft X f hf =>
    exact Functor.Monoidal.whiskerLeft_naturality_of_tensor
      (e := fun Z ↦ (wordIso F G e Z.as).hom) htensor X hf
  | whiskerRight f X hf =>
    exact Functor.Monoidal.whiskerRight_naturality_of_tensor
      (e := fun Z ↦ (wordIso F G e Z.as).hom) htensor X hf

/-- Two strong monoidal functors out of the free monoidal category on `S` that agree up to
isomorphisms `e` on the generating objects, compatibly with every coupon, are isomorphic by a
monoidal natural isomorphism extending `e`. -/
def monoidalNatIso
    (he : ∀ g, F.map (coupon g) ≫ (wordIso F G e (S.tgt g)).hom =
      (wordIso F G e (S.src g)).hom ≫ G.map (coupon g)) :
    F ≅ G :=
  NatIso.ofComponents (fun X ↦ wordIso F G e X.as) fun f ↦ map_comp_wordIso_hom he f

variable (he : ∀ g, F.map (coupon g) ≫ (wordIso F G e (S.tgt g)).hom =
  (wordIso F G e (S.src g)).hom ≫ G.map (coupon g))

@[simp]
theorem monoidalNatIso_hom_app (X : S.FreeMonoidal) :
    (monoidalNatIso he).hom.app X = (wordIso F G e X.as).hom := by rfl

theorem monoidalNatIso_hom_app_of (a : S.Obj) :
    (monoidalNatIso he).hom.app (of a) = (e a).hom := by rfl

instance isMonoidal_monoidalNatIso_hom : NatTrans.IsMonoidal (monoidalNatIso he).hom :=
  NatTrans.IsMonoidal.of_unit_tensor _ (wordIso_tensorUnit_hom F G e) (wordIso_tensor_hom F G e)

end Uniqueness

section WordIso

open Functor.LaxMonoidal Functor.OplaxMonoidal

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D]

/-- The isomorphisms `wordIso F G e` between two strong monoidal functors out of the free monoidal
category are the comparisons `mapWordIso` composed with the extension of `e` to tensor words. -/
theorem wordIso_eq_mapWordIso (F G : S.FreeMonoidal ⥤ D) [F.Monoidal] [G.Monoidal]
    (e : ∀ a, F.obj (of a) ≅ G.obj (of a)) (X : FreeMonoidalCategory S.Obj) :
    wordIso F G e X = mapWordIso F X ≪≫ projectObjIso e X ≪≫ (mapWordIso G X).symm := by
  ext
  rw [Iso.trans_hom, Iso.trans_hom, Iso.symm_hom]
  induction X with
  | of a =>
    refine (congrArg Iso.hom (wordIso_of F G e a)).trans ?_
    rw [mapWordIso_of, mapWordIso_of, projectObjIso_of, Iso.refl_hom, Iso.refl_inv]
    -- The identities are typed at `F.obj ⟨.of a⟩`, which is `F.obj (of a)` only after unfolding
    -- `of`, so `simp` cannot cancel them.
    exact ((Category.id_comp _).trans (Category.comp_id _)).symm
  | unit =>
    rw [unit_eq_unit, mapWordIso_tensorUnit_hom, mapWordIso_tensorUnit_inv,
      projectObjIso_tensorUnit]
    refine (wordIso_tensorUnit_hom F G e).trans ?_
    rw [Iso.refl_hom]
    -- The identity is typed at `projectObj _ (𝟙_ _)`, which is `𝟙_ D` only after unfolding
    -- `projectObj`, so `simp` cannot cancel it.
    exact congrArg (η F ≫ ·) (Category.id_comp _).symm
  | tensor X Y hX hY =>
    rw [tensor_eq_tensor, mapWordIso_tensor_hom, mapWordIso_tensor_inv, projectObjIso_tensor,
      tensorIso_hom]
    refine (wordIso_tensor_hom F G e ⟨X⟩ ⟨Y⟩).trans ?_
    -- On the right the tensor products meet at `projectObj _ (X ⊗ Y)`, which is a tensor product
    -- only after unfolding `projectObj`, so `simp` cannot merge them; the tensors of composites on
    -- the left are split instead.
    rw [hX, hY, ← MonoidalCategory.tensorHom_comp_tensorHom,
      ← MonoidalCategory.tensorHom_comp_tensorHom]
    conv_lhs => simp only [Category.assoc]
    exact (Category.assoc _ _ _).symm

/-- A monoidal natural isomorphism between strong monoidal functors out of the free monoidal
category is the `wordIso` of its components at the generating objects. -/
theorem wordIso_app {F G : S.FreeMonoidal ⥤ D} [F.Monoidal] [G.Monoidal] (α : F ≅ G)
    [NatTrans.IsMonoidal α.hom] (X : FreeMonoidalCategory S.Obj) :
    wordIso F G (fun a ↦ α.app (of a)) X = α.app ⟨X⟩ := by
  ext
  induction X with
  | of a => exact congrArg Iso.hom (wordIso_of F G _ a)
  | unit =>
    exact (wordIso_tensorUnit_hom F G _).trans
      (NatTrans.IsMonoidal.app_tensorUnit_eq_η_comp_ε α.hom).symm
  | tensor X Y hX hY =>
    refine (wordIso_tensor_hom F G _ ⟨X⟩ ⟨Y⟩).trans ?_
    rw [hX, hY, Iso.app_hom, Iso.app_hom]
    exact (NatTrans.IsMonoidal.app_tensor_eq_δ_comp_tensor_comp_μ α.hom ⟨X⟩ ⟨Y⟩).symm

/-- From a lift to a strong monoidal functor `G`, `wordIso` is the extension of the isomorphisms
of generators to tensor words followed by the inverse of the comparison `mapWordIso G`. -/
theorem wordIso_lift_left {fo : S.Obj → D}
    (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g))
    (G : S.FreeMonoidal ⥤ D) [G.Monoidal] (e : ∀ a, fo a ≅ G.obj (of a))
    (X : FreeMonoidalCategory S.Obj) :
    wordIso (lift fo fc) G e X = projectObjIso e X ≪≫ (mapWordIso G X).symm := by
  refine (wordIso_eq_mapWordIso (lift fo fc) G e X).trans ?_
  rw [mapWordIso_lift]
  -- The identity is typed at `projectObj fo X`, which is the source of `projectObjIso e X` only
  -- after unfolding `lift`, so `rw` cannot use `Iso.refl_trans`.
  exact Iso.refl_trans _

/-- Between two lifts, `wordIso` is the extension of the isomorphisms of generators to tensor
words. -/
@[simp]
theorem wordIso_lift_lift {fo fo' : S.Obj → D}
    (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g))
    (fc' : ∀ g : S.Coupon, projectObj fo' (S.src g) ⟶ projectObj fo' (S.tgt g))
    (e : ∀ a, fo a ≅ fo' a) (X : FreeMonoidalCategory S.Obj) :
    wordIso (lift fo fc) (lift fo' fc') e X = projectObjIso e X := by
  refine (wordIso_lift_left fc (lift fo' fc') e X).trans ?_
  rw [mapWordIso_lift]
  -- As in `wordIso_lift_left`, the identity is only definitionally typed at the target of
  -- `projectObjIso e X`.
  exact (congrArg (projectObjIso e X ≪≫ ·) (Iso.refl_symm _)).trans (Iso.trans_refl _)

/-- From the lift of the generator images of `F` to `F`, `wordIso` of the identities is the
inverse of the comparison `mapWordIso F`. -/
theorem wordIso_lift_refl (F : S.FreeMonoidal ⥤ D) [F.Monoidal]
    (fc : ∀ g : S.Coupon, projectObj (fun a ↦ F.obj (of a)) (S.src g) ⟶
      projectObj (fun a ↦ F.obj (of a)) (S.tgt g)) (X : FreeMonoidalCategory S.Obj) :
    wordIso (lift (fun a ↦ F.obj (of a)) fc) F (fun a ↦ Iso.refl (F.obj (of a))) X =
      (mapWordIso F X).symm := by
  refine (wordIso_lift_left fc F _ X).trans ?_
  rw [projectObjIso_refl]
  exact Iso.refl_trans _

/-- The extension to tensor words of the components of a monoidal natural isomorphism at the
generating objects is its component at the word, conjugated by the comparisons `mapWordIso`. -/
theorem projectObjIso_app {F G : S.FreeMonoidal ⥤ D} [F.Monoidal] [G.Monoidal] (α : F ≅ G)
    [NatTrans.IsMonoidal α.hom] (X : FreeMonoidalCategory S.Obj) :
    projectObjIso (fun a ↦ α.app (of a)) X =
      (mapWordIso F X).symm ≪≫ α.app ⟨X⟩ ≪≫ mapWordIso G X := by
  rw [← wordIso_app α X, wordIso_eq_mapWordIso]
  ext
  simp

end WordIso

end FreeMonoidal

