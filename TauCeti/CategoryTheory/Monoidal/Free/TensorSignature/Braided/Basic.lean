/-!
# The free braided monoidal category on a tensor signature

Given a `TauCeti.TensorSignature` `S`, the free braided monoidal category
`TensorSignature.FreeBraided S` has formal tensor words in `S.Obj` as objects and formal
composites, tensor products and whiskerings of identities, associators, unitors, braidings,
inverse braidings and coupons as morphisms, modulo exactly the axioms of a braided monoidal
category. No symmetry axiom and no equation between coupons are imposed. The construction extends
`TauCeti.TensorSignature.FreeMonoidal` (following `Mathlib/CategoryTheory/Monoidal/Free/Basic.lean`,
Markus Himmel) by the braiding generators, inverse laws, naturality squares and hexagon axioms.

## Main definitions and results

* `TauCeti.TensorSignature.FreeBraided S`: the free braided monoidal category on `S`, with
  `FreeBraided.of` and `FreeBraided.coupon` for the generators.
* `FreeBraided.Hom.inductionOn`: morphisms are generated by identities, structural
  isomorphisms (including braidings and their inverses) and coupons under composition and
  whiskering.
* `FreeBraided.lift fo fc`: the strong braided functor into an arbitrary (not necessarily strict)
  braided monoidal category determined by images `fo` of the generating objects and `fc` of the
  coupons, with computation rules `FreeBraided.lift_obj_of` and `FreeBraided.lift_map_coupon`.
* `FreeBraided.ofFreeMonoidal`: the canonical strict monoidal functor from `S.FreeMonoidal` to
  `S.FreeBraided`, satisfying `FreeBraided.ofFreeMonoidal_comp_lift`.
* `FreeBraided.monoidalNatIso`: two strong braided functors out of `S.FreeBraided` that agree up
  to isomorphism on the generating objects, compatibly with the coupons, are monoidally naturally
  isomorphic.
* `FreeBraided.natTrans_ext`: monoidal natural transformations out of `S.FreeBraided` are
  determined by their components at the generating objects.
* `FreeBraided.exponentSum`: the crossing exponent sum invariant on morphisms (returning `some k`
  on coupon-free morphisms and `none` when a coupon occurs), witnessing that the double positive
  braiding has exponent sum `2` and is distinct from the identity whenever both tensor factors have
  nonzero length (`FreeBraided.braiding_comp_braiding_ne_id`).

Together the lift and uniqueness theorems establish the universal property of the free braided
monoidal category on a tensor scheme (Joyal–Street, *The geometry of tensor calculus I*, §3) for
strong braided functors into arbitrary braided monoidal categories.

## References

* A. Joyal and R. Street, *The geometry of tensor calculus I*, Adv. Math. 88 (1991), §3.
-/

public section

universe u v u' v'

open CategoryTheory MonoidalCategory BraidedCategory FreeMonoidalCategory

namespace TauCeti.TensorSignature

variable (S : TensorSignature.{u, v})

/-- The free braided monoidal category on a tensor signature `S`. Its objects are the formal
tensor words in the generating objects of `S`. -/
structure FreeBraided where
  /-- The formal tensor word underlying an object of the free braided monoidal category. -/
  as : FreeMonoidalCategory S.Obj

namespace FreeBraided

variable {S}

/-- The object of the free braided monoidal category given by a single generating object. -/
@[expose] def of (a : S.Obj) : S.FreeBraided := ⟨.of a⟩

/-- Formal composites, tensor products and whiskerings of identities, associators, unitors,
braidings, inverse braidings and coupons. The morphisms of the free braided monoidal category on
`S` are a quotient of these. -/
inductive Hom : FreeMonoidalCategory S.Obj → FreeMonoidalCategory S.Obj → Type (max u v)
  | id (X) : Hom X X
  | α_hom (X Y Z : FreeMonoidalCategory S.Obj) : Hom ((X.tensor Y).tensor Z) (X.tensor (Y.tensor Z))
  | α_inv (X Y Z : FreeMonoidalCategory S.Obj) : Hom (X.tensor (Y.tensor Z)) ((X.tensor Y).tensor Z)
  | l_hom (X) : Hom (unit.tensor X) X
  | l_inv (X) : Hom X (unit.tensor X)
  | ρ_hom (X : FreeMonoidalCategory S.Obj) : Hom (X.tensor unit) X
  | ρ_inv (X : FreeMonoidalCategory S.Obj) : Hom X (X.tensor unit)
  | β_hom (X Y : FreeMonoidalCategory S.Obj) : Hom (X.tensor Y) (Y.tensor X)
  | β_inv (X Y : FreeMonoidalCategory S.Obj) : Hom (Y.tensor X) (X.tensor Y)
  | coupon (g : S.Coupon) : Hom (S.src g) (S.tgt g)
  | comp {X Y Z} (f : Hom X Y) (g : Hom Y Z) : Hom X Z
  | whiskerLeft (X : FreeMonoidalCategory S.Obj) {Y₁ Y₂} (f : Hom Y₁ Y₂) :
      Hom (X.tensor Y₁) (X.tensor Y₂)
  | whiskerRight {X₁ X₂} (f : Hom X₁ X₂) (Y : FreeMonoidalCategory S.Obj) :
      Hom (X₁.tensor Y) (X₂.tensor Y)
  | tensor {W X Y Z} (f : Hom W Y) (g : Hom X Z) : Hom (W.tensor X) (Y.tensor Z)

/-- The relation on formal morphisms generated by the axioms of a braided monoidal category and
closed under composition, whiskering and tensor products. It imposes neither symmetry nor any
equation on coupons. -/
inductive HomEquiv : ∀ {X Y : FreeMonoidalCategory S.Obj}, Hom X Y → Hom X Y → Prop
  | refl {X Y} (f : Hom X Y) : HomEquiv f f
  | symm {X Y} (f g : Hom X Y) : HomEquiv f g → HomEquiv g f
  | trans {X Y} {f g h : Hom X Y} : HomEquiv f g → HomEquiv g h → HomEquiv f h
  | comp {X Y Z} {f f' : Hom X Y} {g g' : Hom Y Z} :
      HomEquiv f f' → HomEquiv g g' → HomEquiv (f.comp g) (f'.comp g')
  | whiskerLeft (X) {Y Z} (f f' : Hom Y Z) :
      HomEquiv f f' → HomEquiv (f.whiskerLeft X) (f'.whiskerLeft X)
  | whiskerRight {Y Z} (f f' : Hom Y Z) (X) :
      HomEquiv f f' → HomEquiv (f.whiskerRight X) (f'.whiskerRight X)
  | tensor {W X Y Z} {f f' : Hom W X} {g g' : Hom Y Z} :
      HomEquiv f f' → HomEquiv g g' → HomEquiv (f.tensor g) (f'.tensor g')
  | tensorHom_def {X₁ Y₁ X₂ Y₂} (f : Hom X₁ Y₁) (g : Hom X₂ Y₂) :
      HomEquiv (f.tensor g) ((f.whiskerRight X₂).comp (g.whiskerLeft Y₁))
  | comp_id {X Y} (f : Hom X Y) : HomEquiv (f.comp (Hom.id _)) f
  | id_comp {X Y} (f : Hom X Y) : HomEquiv ((Hom.id _).comp f) f
  | assoc {X Y U V} (f : Hom X U) (g : Hom U V) (h : Hom V Y) :
      HomEquiv ((f.comp g).comp h) (f.comp (g.comp h))
  | id_tensorHom_id {X Y} : HomEquiv ((Hom.id X).tensor (Hom.id Y)) (Hom.id _)
  | tensorHom_comp_tensorHom {X₁ Y₁ Z₁ X₂ Y₂ Z₂} (f₁ : Hom X₁ Y₁) (f₂ : Hom X₂ Y₂)
      (g₁ : Hom Y₁ Z₁) (g₂ : Hom Y₂ Z₂) :
      HomEquiv ((f₁.tensor f₂).comp (g₁.tensor g₂)) ((f₁.comp g₁).tensor (f₂.comp g₂))
  | whiskerLeft_id (X Y) : HomEquiv ((Hom.id Y).whiskerLeft X) (Hom.id (X.tensor Y))
  | id_whiskerRight (X Y) : HomEquiv ((Hom.id X).whiskerRight Y) (Hom.id (X.tensor Y))
  | α_hom_inv {X Y Z} : HomEquiv ((Hom.α_hom X Y Z).comp (Hom.α_inv X Y Z)) (Hom.id _)
  | α_inv_hom {X Y Z} : HomEquiv ((Hom.α_inv X Y Z).comp (Hom.α_hom X Y Z)) (Hom.id _)
  | associator_naturality {X₁ X₂ X₃ Y₁ Y₂ Y₃} (f₁ : Hom X₁ Y₁) (f₂ : Hom X₂ Y₂)
      (f₃ : Hom X₃ Y₃) :
      HomEquiv (((f₁.tensor f₂).tensor f₃).comp (Hom.α_hom Y₁ Y₂ Y₃))
        ((Hom.α_hom X₁ X₂ X₃).comp (f₁.tensor (f₂.tensor f₃)))
  | ρ_hom_inv {X} : HomEquiv ((Hom.ρ_hom X).comp (Hom.ρ_inv X)) (Hom.id _)
  | ρ_inv_hom {X} : HomEquiv ((Hom.ρ_inv X).comp (Hom.ρ_hom X)) (Hom.id _)
  | ρ_naturality {X Y} (f : Hom X Y) :
      HomEquiv ((f.whiskerRight unit).comp (Hom.ρ_hom Y)) ((Hom.ρ_hom X).comp f)
  | l_hom_inv {X} : HomEquiv ((Hom.l_hom X).comp (Hom.l_inv X)) (Hom.id _)
  | l_inv_hom {X} : HomEquiv ((Hom.l_inv X).comp (Hom.l_hom X)) (Hom.id _)
  | l_naturality {X Y} (f : Hom X Y) :
      HomEquiv ((f.whiskerLeft unit).comp (Hom.l_hom Y)) ((Hom.l_hom X).comp f)
  | pentagon {W X Y Z} :
      HomEquiv
        (((Hom.α_hom W X Y).whiskerRight Z).comp
          ((Hom.α_hom W (X.tensor Y) Z).comp ((Hom.α_hom X Y Z).whiskerLeft W)))
        ((Hom.α_hom (W.tensor X) Y Z).comp (Hom.α_hom W X (Y.tensor Z)))
  | triangle {X Y} :
      HomEquiv ((Hom.α_hom X unit Y).comp ((Hom.l_hom Y).whiskerLeft X))
        ((Hom.ρ_hom X).whiskerRight Y)
  | β_hom_inv {X Y} : HomEquiv ((Hom.β_hom X Y).comp (Hom.β_inv X Y)) (Hom.id _)
  | β_inv_hom {X Y} : HomEquiv ((Hom.β_inv X Y).comp (Hom.β_hom X Y)) (Hom.id _)
  | braiding_naturality_right (X) {Y Z} (f : Hom Y Z) :
      HomEquiv ((f.whiskerLeft X).comp (Hom.β_hom X Z))
        ((Hom.β_hom X Y).comp (f.whiskerRight X))
  | braiding_naturality_left {X Y} (f : Hom X Y) (Z) :
      HomEquiv ((f.whiskerRight Z).comp (Hom.β_hom Y Z))
        ((Hom.β_hom X Z).comp (f.whiskerLeft Z))
  | hexagon_forward {X Y Z} :
      HomEquiv
        ((Hom.α_hom X Y Z).comp ((Hom.β_hom X (Y.tensor Z)).comp (Hom.α_hom Y Z X)))
        (((Hom.β_hom X Y).whiskerRight Z).comp
          ((Hom.α_hom Y X Z).comp ((Hom.β_hom X Z).whiskerLeft Y)))
  | hexagon_reverse {X Y Z} :
      HomEquiv
        ((Hom.α_inv X Y Z).comp ((Hom.β_hom (X.tensor Y) Z).comp (Hom.α_inv Z X Y)))
        (((Hom.β_hom Y Z).whiskerLeft X).comp
          ((Hom.α_inv X Z Y).comp ((Hom.β_hom X Z).whiskerRight Y)))

/-- Formal morphisms are identified when the axioms of a braided monoidal category make them
equal. -/
instance setoidHom (X Y : FreeMonoidalCategory S.Obj) : Setoid (Hom X Y) :=
  ⟨HomEquiv, ⟨HomEquiv.refl, HomEquiv.symm _ _, HomEquiv.trans⟩⟩

open HomEquiv

instance : Category.{max u v} S.FreeBraided where
  Hom X Y := Quotient (setoidHom X.as Y.as)
  id X := ⟦Hom.id X.as⟧
  comp := Quotient.map₂ Hom.comp (fun _ _ hf _ _ hg ↦ HomEquiv.comp hf hg)
  id_comp := by
    rintro X Y ⟨f⟩
    exact Quotient.sound (id_comp f)
  comp_id := by
    rintro X Y ⟨f⟩
    exact Quotient.sound (comp_id f)
  assoc := by
    rintro W X Y Z ⟨f⟩ ⟨g⟩ ⟨h⟩
    exact Quotient.sound (assoc f g h)

instance : MonoidalCategory S.FreeBraided where
  tensorObj X Y := ⟨X.as.tensor Y.as⟩
  tensorHom := Quotient.map₂ Hom.tensor (fun _ _ hf _ _ hg ↦ HomEquiv.tensor hf hg)
  whiskerLeft X _ _ f :=
    Quot.map (fun f ↦ Hom.whiskerLeft X.as f) (fun f f' ↦ .whiskerLeft _ f f') f
  whiskerRight f Y :=
    Quot.map (fun f ↦ Hom.whiskerRight f Y.as) (fun f f' ↦ .whiskerRight f f' _) f
  tensorHom_def := by
    rintro _ _ _ _ ⟨f⟩ ⟨g⟩
    exact Quotient.sound (tensorHom_def _ _)
  id_tensorHom_id _ _ := Quot.sound id_tensorHom_id
  tensorHom_comp_tensorHom := by
    rintro _ _ _ _ _ _ ⟨f₁⟩ ⟨f₂⟩ ⟨g₁⟩ ⟨g₂⟩
    exact Quotient.sound (tensorHom_comp_tensorHom _ _ _ _)
  whiskerLeft_id X Y := Quot.sound (HomEquiv.whiskerLeft_id X.as Y.as)
  id_whiskerRight X Y := Quot.sound (HomEquiv.id_whiskerRight X.as Y.as)
  tensorUnit := ⟨unit⟩
  associator X Y Z :=
    ⟨⟦Hom.α_hom X.as Y.as Z.as⟧, ⟦Hom.α_inv X.as Y.as Z.as⟧, Quotient.sound α_hom_inv,
      Quotient.sound α_inv_hom⟩
  associator_naturality := by
    rintro _ _ _ _ _ _ ⟨f₁⟩ ⟨f₂⟩ ⟨f₃⟩
    exact Quotient.sound (associator_naturality _ _ _)
  leftUnitor X :=
    ⟨⟦Hom.l_hom X.as⟧, ⟦Hom.l_inv X.as⟧, Quotient.sound l_hom_inv, Quotient.sound l_inv_hom⟩
  leftUnitor_naturality := by
    rintro _ _ ⟨f⟩
    exact Quotient.sound (l_naturality _)
  rightUnitor X :=
    ⟨⟦Hom.ρ_hom X.as⟧, ⟦Hom.ρ_inv X.as⟧, Quotient.sound ρ_hom_inv, Quotient.sound ρ_inv_hom⟩
  rightUnitor_naturality := by
    rintro _ _ ⟨f⟩
    exact Quotient.sound (ρ_naturality _)
  pentagon _ _ _ _ := Quotient.sound pentagon
  triangle _ _ := Quotient.sound triangle

instance : BraidedCategory S.FreeBraided where
  braiding X Y :=
    ⟨⟦Hom.β_hom X.as Y.as⟧, ⟦Hom.β_inv X.as Y.as⟧, Quotient.sound β_hom_inv,
      Quotient.sound β_inv_hom⟩
  braiding_naturality_right := by
    rintro X _ _ ⟨f⟩
    exact Quotient.sound (braiding_naturality_right X.as f)
  braiding_naturality_left := by
    rintro _ _ ⟨f⟩ Z
    exact Quotient.sound (braiding_naturality_left f Z.as)
  hexagon_forward _ _ _ := Quotient.sound hexagon_forward
  hexagon_reverse _ _ _ := Quotient.sound hexagon_reverse

/-- The morphism of the free braided monoidal category represented by a formal morphism. -/
abbrev homMk {X Y : S.FreeBraided} (f : Hom X.as Y.as) : X ⟶ Y := ⟦f⟧

/-- The generating morphism given by a coupon, from its source word to its target word. -/
@[expose] def coupon (g : S.Coupon) : (⟨S.src g⟩ : S.FreeBraided) ⟶ ⟨S.tgt g⟩ :=
  homMk (Hom.coupon g)

@[simp]
theorem homMk_id (X : S.FreeBraided) : homMk (Hom.id X.as) = 𝟙 X := rfl

@[simp]
theorem homMk_comp {X Y Z : S.FreeBraided} (f : Hom X.as Y.as) (g : Hom Y.as Z.as) :
    homMk (Y := Z) (f.comp g) = homMk f ≫ homMk g := rfl

@[simp]
theorem homMk_tensor {X₁ Y₁ X₂ Y₂ : S.FreeBraided} (f : Hom X₁.as Y₁.as) (g : Hom X₂.as Y₂.as) :
    homMk (X := X₁ ⊗ X₂) (Y := Y₁ ⊗ Y₂) (f.tensor g) = homMk f ⊗ₘ homMk g := rfl

@[simp]
theorem homMk_whiskerLeft (X : S.FreeBraided) {Y₁ Y₂ : S.FreeBraided} (f : Hom Y₁.as Y₂.as) :
    homMk (X := X ⊗ Y₁) (Y := X ⊗ Y₂) (f.whiskerLeft X.as) = X ◁ homMk f := rfl

@[simp]
theorem homMk_whiskerRight {X₁ X₂ : S.FreeBraided} (f : Hom X₁.as X₂.as) (Y : S.FreeBraided) :
    homMk (X := X₁ ⊗ Y) (Y := X₂ ⊗ Y) (f.whiskerRight Y.as) = homMk f ▷ Y := rfl

@[simp]
theorem homMk_α_hom (X Y Z : S.FreeBraided) :
    homMk (X := (X ⊗ Y) ⊗ Z) (Y := X ⊗ (Y ⊗ Z)) (Hom.α_hom X.as Y.as Z.as) = (α_ X Y Z).hom :=
  rfl

@[simp]
theorem homMk_α_inv (X Y Z : S.FreeBraided) :
    homMk (X := X ⊗ (Y ⊗ Z)) (Y := (X ⊗ Y) ⊗ Z) (Hom.α_inv X.as Y.as Z.as) = (α_ X Y Z).inv :=
  rfl

@[simp]
theorem homMk_l_hom (X : S.FreeBraided) :
    homMk (X := 𝟙_ _ ⊗ X) (Hom.l_hom X.as) = (λ_ X).hom := rfl

@[simp]
theorem homMk_l_inv (X : S.FreeBraided) :
    homMk (Y := 𝟙_ _ ⊗ X) (Hom.l_inv X.as) = (λ_ X).inv := rfl

@[simp]
theorem homMk_ρ_hom (X : S.FreeBraided) :
    homMk (X := X ⊗ 𝟙_ _) (Hom.ρ_hom X.as) = (ρ_ X).hom := rfl

@[simp]
theorem homMk_ρ_inv (X : S.FreeBraided) :
    homMk (Y := X ⊗ 𝟙_ _) (Hom.ρ_inv X.as) = (ρ_ X).inv := rfl

@[simp]
theorem homMk_β_hom (X Y : S.FreeBraided) :
    homMk (X := X ⊗ Y) (Y := Y ⊗ X) (Hom.β_hom X.as Y.as) = (β_ X Y).hom := rfl

@[simp]
theorem homMk_β_inv (X Y : S.FreeBraided) :
    homMk (X := Y ⊗ X) (Y := X ⊗ Y) (Hom.β_inv X.as Y.as) = (β_ X Y).inv := rfl

@[simp]
theorem homMk_coupon (g : S.Coupon) :
    homMk (X := ⟨S.src g⟩) (Y := ⟨S.tgt g⟩) (Hom.coupon g) = coupon g := rfl

/-- Induction principle for morphisms of the free braided monoidal category: a property of
morphisms holding for identities, associators, unitors, braidings, inverse braidings and coupons,
and stable under composition and whiskering on either side, holds for every morphism. -/
theorem Hom.inductionOn {motive : {X Y : S.FreeBraided} → (X ⟶ Y) → Prop} {X Y : S.FreeBraided}
    (t : X ⟶ Y)
    (id : (X : S.FreeBraided) → motive (𝟙 X))
    (α_hom : (X Y Z : S.FreeBraided) → motive (α_ X Y Z).hom)
    (α_inv : (X Y Z : S.FreeBraided) → motive (α_ X Y Z).inv)
    (l_hom : (X : S.FreeBraided) → motive (λ_ X).hom)
    (l_inv : (X : S.FreeBraided) → motive (λ_ X).inv)
    (ρ_hom : (X : S.FreeBraided) → motive (ρ_ X).hom)
    (ρ_inv : (X : S.FreeBraided) → motive (ρ_ X).inv)
    (β_hom : (X Y : S.FreeBraided) → motive (β_ X Y).hom)
    (β_inv : (X Y : S.FreeBraided) → motive (β_ X Y).inv)
    (coupon : (g : S.Coupon) → motive (FreeBraided.coupon g))
    (comp : {X Y Z : S.FreeBraided} → (f : X ⟶ Y) → (g : Y ⟶ Z) → motive f → motive g →
      motive (f ≫ g))
    (whiskerLeft : (X : S.FreeBraided) → {Y Z : S.FreeBraided} → (f : Y ⟶ Z) → motive f →
      motive (X ◁ f))
    (whiskerRight : {X Y : S.FreeBraided} → (f : X ⟶ Y) → (Z : S.FreeBraided) → motive f →
      motive (f ▷ Z)) :
    motive t := by
  suffices H : ∀ {X Y : FreeMonoidalCategory S.Obj} (f : Hom X Y),
      motive (homMk (X := ⟨X⟩) (Y := ⟨Y⟩) f) by
    induction t using Quotient.inductionOn with | _ f
    exact H f
  intro X Y f
  induction f with
  | id X => exact id ⟨X⟩
  | α_hom X Y Z => exact α_hom ⟨X⟩ ⟨Y⟩ ⟨Z⟩
  | α_inv X Y Z => exact α_inv ⟨X⟩ ⟨Y⟩ ⟨Z⟩
  | l_hom X => exact l_hom ⟨X⟩
  | l_inv X => exact l_inv ⟨X⟩
  | ρ_hom X => exact ρ_hom ⟨X⟩
  | ρ_inv X => exact ρ_inv ⟨X⟩
  | β_hom X Y => exact β_hom ⟨X⟩ ⟨Y⟩
  | β_inv X Y => exact β_inv ⟨X⟩ ⟨Y⟩
  | coupon g => exact coupon g
  | comp f g hf hg => exact comp _ _ hf hg
  | whiskerLeft X f hf => exact whiskerLeft ⟨X⟩ _ hf
  | whiskerRight f X hf => exact whiskerRight _ ⟨X⟩ hf
  | @tensor W X Y Z f g hf hg =>
    have h : (homMk (f.tensor g) : (⟨W.tensor X⟩ : S.FreeBraided) ⟶ ⟨Y.tensor Z⟩) =
        homMk (X := ⟨W⟩) (Y := ⟨Y⟩) f ▷ (⟨X⟩ : S.FreeBraided) ≫
          (⟨Y⟩ : S.FreeBraided) ◁ homMk (X := ⟨X⟩) (Y := ⟨Z⟩) g :=
      Quotient.sound (HomEquiv.tensorHom_def f g)
    rw [h]
    exact comp _ _ (whiskerRight _ _ hf) (whiskerLeft _ _ hg)

section Lift

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D] [BraidedCategory D] (fo : S.Obj → D)
  (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g))

/-- The interpretation of a formal morphism, given interpretations of the generating objects
and coupons. Auxiliary definition for `FreeBraided.liftMap`. -/
private def liftMapAux :
    ∀ {X Y : FreeMonoidalCategory S.Obj}, Hom X Y → (projectObj fo X ⟶ projectObj fo Y)
  | _, _, Hom.id _ => 𝟙 _
  | _, _, Hom.α_hom _ _ _ => (α_ _ _ _).hom
  | _, _, Hom.α_inv _ _ _ => (α_ _ _ _).inv
  | _, _, Hom.l_hom _ => (λ_ _).hom
  | _, _, Hom.l_inv _ => (λ_ _).inv
  | _, _, Hom.ρ_hom _ => (ρ_ _).hom
  | _, _, Hom.ρ_inv _ => (ρ_ _).inv
  | _, _, Hom.β_hom _ _ => (β_ _ _).hom
  | _, _, Hom.β_inv _ _ => (β_ _ _).inv
  | _, _, Hom.coupon g => fc g
  | _, _, Hom.comp f g => liftMapAux f ≫ liftMapAux g
  | _, _, Hom.whiskerLeft X p => projectObj fo X ◁ liftMapAux p
  | _, _, Hom.whiskerRight p X => liftMapAux p ▷ projectObj fo X
  | _, _, Hom.tensor f g => liftMapAux f ⊗ₘ liftMapAux g

/-- The interpretation of formal morphisms respects the axioms of a braided monoidal category. -/
private theorem liftMapAux_sound {X Y : FreeMonoidalCategory S.Obj} {f g : Hom X Y}
    (h : HomEquiv f g) :
    liftMapAux fo fc f = liftMapAux fo fc g := by
  induction h with
  | refl => rfl
  | symm _ _ _ hfg => exact hfg.symm
  | trans _ _ hfg hgh => exact hfg.trans hgh
  | comp _ _ hf hg => simp only [liftMapAux, hf, hg]
  | whiskerLeft _ _ _ _ hf => dsimp only [liftMapAux]; rw [hf]
  | whiskerRight _ _ _ _ hf => dsimp only [liftMapAux]; rw [hf]
  | tensor _ _ hf hg => dsimp only [liftMapAux]; rw [hf, hg]
  | tensorHom_def => exact MonoidalCategory.tensorHom_def _ _
  | comp_id => exact Category.comp_id _
  | id_comp => exact Category.id_comp _
  | assoc => exact Category.assoc _ _ _
  | id_tensorHom_id => exact MonoidalCategory.id_tensorHom_id _ _
  | tensorHom_comp_tensorHom => exact MonoidalCategory.tensorHom_comp_tensorHom _ _ _ _
  | whiskerLeft_id => exact MonoidalCategory.whiskerLeft_id _ _
  | id_whiskerRight => exact MonoidalCategory.id_whiskerRight _ _
  | α_hom_inv => exact Iso.hom_inv_id _
  | α_inv_hom => exact Iso.inv_hom_id _
  | associator_naturality => exact MonoidalCategory.associator_naturality _ _ _
  | ρ_hom_inv => exact Iso.hom_inv_id _
  | ρ_inv_hom => exact Iso.inv_hom_id _
  | ρ_naturality => exact MonoidalCategory.rightUnitor_naturality _
  | l_hom_inv => exact Iso.hom_inv_id _
  | l_inv_hom => exact Iso.inv_hom_id _
  | l_naturality => exact MonoidalCategory.leftUnitor_naturality _
  | pentagon => exact MonoidalCategory.pentagon _ _ _ _
  | triangle => exact MonoidalCategory.triangle _ _
  | β_hom_inv => exact Iso.hom_inv_id _
  | β_inv_hom => exact Iso.inv_hom_id _
  | braiding_naturality_right => exact BraidedCategory.braiding_naturality_right _ _
  | braiding_naturality_left => exact BraidedCategory.braiding_naturality_left _ _
  | hexagon_forward => exact BraidedCategory.hexagon_forward _ _ _
  | hexagon_reverse => exact BraidedCategory.hexagon_reverse _ _ _

/-- The interpretation of morphisms of the free braided monoidal category on `S`, given the
images `fo` of the generating objects and `fc` of the coupons. This is the action of
`FreeBraided.lift` on morphisms; use the `lift_map_*` lemmas to compute it. -/
def liftMap {X Y : S.FreeBraided} (f : X ⟶ Y) : projectObj fo X.as ⟶ projectObj fo Y.as :=
  Quotient.lift (liftMapAux fo fc) (fun _ _ h ↦ liftMapAux_sound fo fc h) f

theorem liftMap_id (X : S.FreeBraided) : liftMap fo fc (𝟙 X) = 𝟙 _ := by rfl

theorem liftMap_comp {X Y Z : S.FreeBraided} (f : X ⟶ Y) (g : Y ⟶ Z) :
    liftMap fo fc (f ≫ g) = liftMap fo fc f ≫ liftMap fo fc g := by
  induction f using Quotient.inductionOn
  induction g using Quotient.inductionOn
  rfl

/-- The functor out of the free braided monoidal category on `S` determined by the images `fo` of
the generating objects and `fc` of the coupons. It is strong braided, with identity tensorator and
unit comparison. -/
@[expose] def lift : S.FreeBraided ⥤ D where
  obj X := projectObj fo X.as
  map := liftMap fo fc
  map_id := liftMap_id fo fc
  map_comp := liftMap_comp fo fc

@[simp]
theorem lift_obj_of (a : S.Obj) : (lift fo fc).obj (of a) = fo a := rfl

@[simp]
theorem lift_obj_tensor (X Y : S.FreeBraided) :
    (lift fo fc).obj (X ⊗ Y) = (lift fo fc).obj X ⊗ (lift fo fc).obj Y := rfl

@[simp]
theorem lift_obj_tensorUnit : (lift fo fc).obj (𝟙_ S.FreeBraided) = 𝟙_ D := rfl

@[simp]
theorem lift_map_coupon (g : S.Coupon) : (lift fo fc).map (coupon g) = fc g := by rfl

@[simp]
theorem lift_map_whiskerLeft (X : S.FreeBraided) {Y₁ Y₂ : S.FreeBraided} (f : Y₁ ⟶ Y₂) :
    (lift fo fc).map (X ◁ f) = (lift fo fc).obj X ◁ (lift fo fc).map f := by
  induction f using Quotient.inductionOn
  rfl

@[simp]
theorem lift_map_whiskerRight {X₁ X₂ : S.FreeBraided} (f : X₁ ⟶ X₂) (Y : S.FreeBraided) :
    (lift fo fc).map (f ▷ Y) = (lift fo fc).map f ▷ (lift fo fc).obj Y := by
  induction f using Quotient.inductionOn
  rfl

@[simp]
theorem lift_map_tensorHom {X₁ Y₁ X₂ Y₂ : S.FreeBraided} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂) :
    (lift fo fc).map (f ⊗ₘ g) = (lift fo fc).map f ⊗ₘ (lift fo fc).map g := by
  induction f using Quotient.inductionOn
  induction g using Quotient.inductionOn
  rfl

@[simp]
theorem lift_map_associator_hom (X Y Z : S.FreeBraided) :
    (lift fo fc).map (α_ X Y Z).hom =
      (α_ ((lift fo fc).obj X) ((lift fo fc).obj Y) ((lift fo fc).obj Z)).hom := by rfl

@[simp]
theorem lift_map_associator_inv (X Y Z : S.FreeBraided) :
    (lift fo fc).map (α_ X Y Z).inv =
      (α_ ((lift fo fc).obj X) ((lift fo fc).obj Y) ((lift fo fc).obj Z)).inv := by rfl

/- The unitor and braiding-hom lemmas are not `@[simp]`: Mathlib's `left_unitality`,
`right_unitality` and `Functor.map_braiding` (together with `lift_μ`/`lift_δ`) already rewrite
these expressions. -/
theorem lift_map_leftUnitor_hom (X : S.FreeBraided) :
    (lift fo fc).map (λ_ X).hom = (λ_ ((lift fo fc).obj X)).hom := by rfl

theorem lift_map_leftUnitor_inv (X : S.FreeBraided) :
    (lift fo fc).map (λ_ X).inv = (λ_ ((lift fo fc).obj X)).inv := by rfl

theorem lift_map_rightUnitor_hom (X : S.FreeBraided) :
    (lift fo fc).map (ρ_ X).hom = (ρ_ ((lift fo fc).obj X)).hom := by rfl

theorem lift_map_rightUnitor_inv (X : S.FreeBraided) :
    (lift fo fc).map (ρ_ X).inv = (ρ_ ((lift fo fc).obj X)).inv := by rfl

theorem lift_map_braiding_hom (X Y : S.FreeBraided) :
    (lift fo fc).map (β_ X Y).hom = (β_ ((lift fo fc).obj X) ((lift fo fc).obj Y)).hom := by rfl

@[simp]
theorem lift_map_braiding_inv (X Y : S.FreeBraided) :
    (lift fo fc).map (β_ X Y).inv = (β_ ((lift fo fc).obj X) ((lift fo fc).obj Y)).inv := by rfl

/- The tensorator and unit comparison of `lift fo fc` are identities. The coherence goals mix
the objects `(lift fo fc).obj (X ⊗ Y)` and `(lift fo fc).obj X ⊗ (lift fo fc).obj Y`, which agree
only after unfolding `lift`, so `dsimp only [lift_obj_tensor, lift_obj_tensorUnit]` first aligns
them syntactically for `simp`. -/
instance : (lift fo fc).Monoidal :=
  Functor.CoreMonoidal.toMonoidal
    { εIso := Iso.refl _
      μIso := fun _ _ ↦ Iso.refl _
      μIso_hom_natural_left := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor]
        simp
      μIso_hom_natural_right := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor]
        simp
      associativity := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor]
        simp
      left_unitality := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor, lift_obj_tensorUnit]
        simp [lift_map_leftUnitor_hom]
      right_unitality := by
        intros
        dsimp only [Iso.refl_hom, lift_obj_tensor, lift_obj_tensorUnit]
        simp [lift_map_rightUnitor_hom] }

@[simp]
theorem lift_ε : Functor.LaxMonoidal.ε (lift fo fc) = 𝟙 _ := rfl

@[simp]
theorem lift_η : Functor.OplaxMonoidal.η (lift fo fc) = 𝟙 _ := rfl

@[simp]
theorem lift_μ (X Y : S.FreeBraided) : Functor.LaxMonoidal.μ (lift fo fc) X Y = 𝟙 _ := rfl

@[simp]
theorem lift_δ (X Y : S.FreeBraided) : Functor.OplaxMonoidal.δ (lift fo fc) X Y = 𝟙 _ := rfl

instance : (lift fo fc).Braided where
  braided X Y := by
    dsimp only [lift_obj_tensor]
    simp [lift_map_braiding_hom]

end Lift

section OfFreeMonoidal

/-- Inclusion of raw monoidal morphisms into raw braided morphisms. -/
private def ofMonoidalHom :
    ∀ {X Y : FreeMonoidalCategory S.Obj}, FreeMonoidal.Hom X Y → Hom X Y
  | _, _, .id X => .id X
  | _, _, .α_hom X Y Z => .α_hom X Y Z
  | _, _, .α_inv X Y Z => .α_inv X Y Z
  | _, _, .l_hom X => .l_hom X
  | _, _, .l_inv X => .l_inv X
  | _, _, .ρ_hom X => .ρ_hom X
  | _, _, .ρ_inv X => .ρ_inv X
  | _, _, .coupon g => .coupon g
  | _, _, .comp f g => (ofMonoidalHom f).comp (ofMonoidalHom g)
  | _, _, .whiskerLeft X f => (ofMonoidalHom f).whiskerLeft X
  | _, _, .whiskerRight f X => (ofMonoidalHom f).whiskerRight X
  | _, _, .tensor f g => (ofMonoidalHom f).tensor (ofMonoidalHom g)

private theorem ofMonoidalHom_sound {X Y : FreeMonoidalCategory S.Obj}
    {f g : FreeMonoidal.Hom X Y} (h : FreeMonoidal.HomEquiv f g) :
    HomEquiv (ofMonoidalHom f) (ofMonoidalHom g) := by
  induction h with
  | refl => exact .refl _
  | symm _ _ _ h => exact .symm _ _ h
  | trans _ _ h₁ h₂ => exact .trans h₁ h₂
  | comp _ _ hf hg => exact .comp hf hg
  | whiskerLeft X _ _ _ hf => exact .whiskerLeft X _ _ hf
  | whiskerRight _ _ X _ hf => exact .whiskerRight _ _ X hf
  | tensor _ _ hf hg => exact .tensor hf hg
  | tensorHom_def => exact .tensorHom_def _ _
  | comp_id => exact .comp_id _
  | id_comp => exact .id_comp _
  | assoc => exact .assoc _ _ _
  | id_tensorHom_id => exact .id_tensorHom_id
  | tensorHom_comp_tensorHom => exact .tensorHom_comp_tensorHom _ _ _ _
  | whiskerLeft_id => exact .whiskerLeft_id _ _
  | id_whiskerRight => exact .id_whiskerRight _ _
  | α_hom_inv => exact .α_hom_inv
  | α_inv_hom => exact .α_inv_hom
  | associator_naturality => exact .associator_naturality _ _ _
  | ρ_hom_inv => exact .ρ_hom_inv
  | ρ_inv_hom => exact .ρ_inv_hom
  | ρ_naturality => exact .ρ_naturality _
  | l_hom_inv => exact .l_hom_inv
  | l_inv_hom => exact .l_inv_hom
  | l_naturality => exact .l_naturality _
  | pentagon => exact .pentagon
  | triangle => exact .triangle

/-- The action on morphisms of `ofFreeMonoidal`. -/
def ofFreeMonoidalMap {X Y : S.FreeMonoidal} (f : X ⟶ Y) :
    (⟨X.as⟩ : S.FreeBraided) ⟶ ⟨Y.as⟩ :=
  Quotient.lift (fun p ↦ homMk (ofMonoidalHom p))
    (fun _ _ h ↦ Quotient.sound (ofMonoidalHom_sound h)) f

/-- The canonical strict monoidal functor from the free monoidal category on `S` to the free
braided monoidal category on `S`. Defined directly on `FreeMonoidal.Hom` (rather than via
`FreeMonoidal.lift`) so that its action on objects is strictly `X ↦ ⟨X.as⟩` without `eqToHom`
transports on coupons. -/
@[expose] def ofFreeMonoidal : S.FreeMonoidal ⥤ S.FreeBraided where
  obj X := ⟨X.as⟩
  map := ofFreeMonoidalMap
  map_id _ := by rfl
  map_comp f g := by
    induction f using Quotient.inductionOn
    induction g using Quotient.inductionOn
    rfl

theorem ofFreeMonoidal_obj (X : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).obj X = ⟨X.as⟩ := rfl

@[simp]
theorem ofFreeMonoidal_obj_of (a : S.Obj) :
    (ofFreeMonoidal (S := S)).obj (FreeMonoidal.of a) = of a := rfl

@[simp]
theorem ofFreeMonoidal_obj_tensor (X Y : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).obj (X ⊗ Y) =
      ofFreeMonoidal.obj X ⊗ ofFreeMonoidal.obj Y := rfl

@[simp]
theorem ofFreeMonoidal_obj_tensorUnit :
    (ofFreeMonoidal (S := S)).obj (𝟙_ S.FreeMonoidal) = 𝟙_ S.FreeBraided := rfl

@[simp]
theorem ofFreeMonoidal_map_coupon (g : S.Coupon) :
    (ofFreeMonoidal (S := S)).map (FreeMonoidal.coupon g) = coupon g := by rfl

@[simp]
theorem ofFreeMonoidal_map_whiskerLeft (X : S.FreeMonoidal) {Y₁ Y₂ : S.FreeMonoidal} (f : Y₁ ⟶ Y₂) :
    (ofFreeMonoidal (S := S)).map (X ◁ f) = ofFreeMonoidal.obj X ◁ ofFreeMonoidal.map f := by
  induction f using Quotient.inductionOn
  rfl

@[simp]
theorem ofFreeMonoidal_map_whiskerRight {X₁ X₂ : S.FreeMonoidal} (f : X₁ ⟶ X₂)
    (Y : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).map (f ▷ Y) = ofFreeMonoidal.map f ▷ ofFreeMonoidal.obj Y := by
  induction f using Quotient.inductionOn
  rfl

@[simp]
theorem ofFreeMonoidal_map_tensorHom {X₁ Y₁ X₂ Y₂ : S.FreeMonoidal} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂) :
    (ofFreeMonoidal (S := S)).map (f ⊗ₘ g) = ofFreeMonoidal.map f ⊗ₘ ofFreeMonoidal.map g := by
  induction f using Quotient.inductionOn
  induction g using Quotient.inductionOn
  rfl

@[simp]
theorem ofFreeMonoidal_map_associator_hom (X Y Z : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).map (α_ X Y Z).hom =
      (α_ (ofFreeMonoidal.obj X) (ofFreeMonoidal.obj Y) (ofFreeMonoidal.obj Z)).hom := by rfl

@[simp]
theorem ofFreeMonoidal_map_associator_inv (X Y Z : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).map (α_ X Y Z).inv =
      (α_ (ofFreeMonoidal.obj X) (ofFreeMonoidal.obj Y) (ofFreeMonoidal.obj Z)).inv := by rfl

theorem ofFreeMonoidal_map_leftUnitor_hom (X : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).map (λ_ X).hom = (λ_ (ofFreeMonoidal.obj X)).hom := by rfl

theorem ofFreeMonoidal_map_leftUnitor_inv (X : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).map (λ_ X).inv = (λ_ (ofFreeMonoidal.obj X)).inv := by rfl

theorem ofFreeMonoidal_map_rightUnitor_hom (X : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).map (ρ_ X).hom = (ρ_ (ofFreeMonoidal.obj X)).hom := by rfl

theorem ofFreeMonoidal_map_rightUnitor_inv (X : S.FreeMonoidal) :
    (ofFreeMonoidal (S := S)).map (ρ_ X).inv = (ρ_ (ofFreeMonoidal.obj X)).inv := by rfl

instance : (ofFreeMonoidal (S := S)).Monoidal :=
  Functor.CoreMonoidal.toMonoidal
    { εIso := Iso.refl _
      μIso := fun _ _ ↦ Iso.refl _
      μIso_hom_natural_left := by
        intros
        dsimp only [Iso.refl_hom, ofFreeMonoidal_obj_tensor]
        simp
      μIso_hom_natural_right := by
        intros
        dsimp only [Iso.refl_hom, ofFreeMonoidal_obj_tensor]
        simp
      associativity := by
        intros
        dsimp only [Iso.refl_hom, ofFreeMonoidal_obj_tensor]
        simp
      left_unitality := by
        intros
        dsimp only [Iso.refl_hom, ofFreeMonoidal_obj_tensor, ofFreeMonoidal_obj_tensorUnit]
        simp [ofFreeMonoidal_map_leftUnitor_hom]
      right_unitality := by
        intros
        dsimp only [Iso.refl_hom, ofFreeMonoidal_obj_tensor, ofFreeMonoidal_obj_tensorUnit]
        simp [ofFreeMonoidal_map_rightUnitor_hom] }

@[simp]
theorem ofFreeMonoidal_ε : Functor.LaxMonoidal.ε (ofFreeMonoidal (S := S)) = 𝟙 _ := rfl

@[simp]
theorem ofFreeMonoidal_η : Functor.OplaxMonoidal.η (ofFreeMonoidal (S := S)) = 𝟙 _ := rfl

@[simp]
theorem ofFreeMonoidal_μ (X Y : S.FreeMonoidal) :
    Functor.LaxMonoidal.μ (ofFreeMonoidal (S := S)) X Y = 𝟙 _ := rfl

@[simp]
theorem ofFreeMonoidal_δ (X Y : S.FreeMonoidal) :
    Functor.OplaxMonoidal.δ (ofFreeMonoidal (S := S)) X Y = 𝟙 _ := rfl

@[simp]
theorem lift_map_ofFreeMonoidal {D : Type u'} [Category.{v'} D] [MonoidalCategory D]
    [BraidedCategory D] (fo : S.Obj → D)
    (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g))
    {X Y : S.FreeMonoidal} (f : X ⟶ Y) :
    (lift fo fc).map (ofFreeMonoidal.map f) = (FreeMonoidal.lift fo fc).map f := by
  induction f using FreeMonoidal.Hom.inductionOn with
  | id | α_hom | α_inv | coupon => simp; rfl
  | l_hom =>
    rw [ofFreeMonoidal_map_leftUnitor_hom]
    dsimp only [ofFreeMonoidal_obj_tensor, ofFreeMonoidal_obj_tensorUnit]
    rw [lift_map_leftUnitor_hom, FreeMonoidal.lift_map_leftUnitor_hom]; rfl
  | l_inv =>
    rw [ofFreeMonoidal_map_leftUnitor_inv]
    dsimp only [ofFreeMonoidal_obj_tensor, ofFreeMonoidal_obj_tensorUnit]
    rw [lift_map_leftUnitor_inv, FreeMonoidal.lift_map_leftUnitor_inv]; rfl
  | ρ_hom =>
    rw [ofFreeMonoidal_map_rightUnitor_hom]
    dsimp only [ofFreeMonoidal_obj_tensor, ofFreeMonoidal_obj_tensorUnit]
    rw [lift_map_rightUnitor_hom, FreeMonoidal.lift_map_rightUnitor_hom]; rfl
  | ρ_inv =>
    rw [ofFreeMonoidal_map_rightUnitor_inv]
    dsimp only [ofFreeMonoidal_obj_tensor, ofFreeMonoidal_obj_tensorUnit]
    rw [lift_map_rightUnitor_inv, FreeMonoidal.lift_map_rightUnitor_inv]; rfl
  | comp _ _ hf hg => simp only [Functor.map_comp, hf, hg]; rfl
  | whiskerLeft _ _ hf =>
    rw [ofFreeMonoidal_map_whiskerLeft]
    dsimp only [ofFreeMonoidal_obj_tensor]
    rw [lift_map_whiskerLeft, FreeMonoidal.lift_map_whiskerLeft, hf]; rfl
  | whiskerRight _ _ hf =>
    rw [ofFreeMonoidal_map_whiskerRight]
    dsimp only [ofFreeMonoidal_obj_tensor]
    rw [lift_map_whiskerRight, FreeMonoidal.lift_map_whiskerRight, hf]; rfl

/-- Restricting a braided interpretation along `ofFreeMonoidal` recovers the monoidal
interpretation with the same images of generating objects and coupons. -/
theorem ofFreeMonoidal_comp_lift {D : Type u'} [Category.{v'} D] [MonoidalCategory D]
    [BraidedCategory D] (fo : S.Obj → D)
    (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g)) :
    ofFreeMonoidal ⋙ lift fo fc = FreeMonoidal.lift fo fc :=
  Functor.hext (fun _ ↦ rfl) fun _ _ f ↦ heq_of_eq (lift_map_ofFreeMonoidal fo fc f)

end OfFreeMonoidal

section Uniqueness

open Functor.LaxMonoidal Functor.OplaxMonoidal

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D]

/-- A monoidal natural transformation from a strong monoidal functor out of the free braided
monoidal category on `S` to a lax monoidal one is determined by its components at the generating
objects. -/
theorem natTrans_ext {F G : S.FreeBraided ⥤ D} [F.Monoidal] [G.LaxMonoidal] {α β : F ⟶ G}
    [NatTrans.IsMonoidal α] [NatTrans.IsMonoidal β] (h : ∀ a, α.app (of a) = β.app (of a)) :
    α = β := by
  ext ⟨X⟩
  induction X with
  | of a => exact h a
  | unit =>
    rw [← cancel_epi (ε F)]
    exact (NatTrans.IsMonoidal.unit (τ := α)).trans (NatTrans.IsMonoidal.unit (τ := β)).symm
  | tensor X Y hX hY =>
    rw [← cancel_epi (μ F ⟨X⟩ ⟨Y⟩)]
    refine (NatTrans.IsMonoidal.tensor (τ := α) ⟨X⟩ ⟨Y⟩).trans ?_
    refine Eq.trans ?_ (NatTrans.IsMonoidal.tensor (τ := β) ⟨X⟩ ⟨Y⟩).symm
    rw [hX, hY]

section WordIso

variable (F G : S.FreeBraided ⥤ D) [F.Monoidal] [G.Monoidal] (e : ∀ a, F.obj (of a) ≅ G.obj (of a))

/-- The isomorphism between the images of a tensor word under two strong monoidal functors out
of the free braided monoidal category, induced by isomorphisms `e` at the generating objects
together with the tensorators and unit comparisons of the two functors. -/
def wordIso : ∀ X : FreeMonoidalCategory S.Obj, F.obj ⟨X⟩ ≅ G.obj ⟨X⟩
  | .of a => e a
  | .unit => (Functor.Monoidal.εIso F).symm ≪≫ Functor.Monoidal.εIso G
  | .tensor X Y =>
    (Functor.Monoidal.μIso F ⟨X⟩ ⟨Y⟩).symm ≪≫ (wordIso X ⊗ᵢ wordIso Y) ≪≫
      Functor.Monoidal.μIso G ⟨X⟩ ⟨Y⟩

@[simp]
theorem wordIso_of (a : S.Obj) : wordIso F G e (of a).as = e a := by rfl

@[simp]
theorem wordIso_tensorUnit_hom : (wordIso F G e (𝟙_ S.FreeBraided).as).hom = η F ≫ ε G := by rfl

@[simp]
theorem wordIso_tensor_hom (X Y : S.FreeBraided) :
    (wordIso F G e (X ⊗ Y).as).hom =
      δ F X Y ≫ ((wordIso F G e X.as).hom ⊗ₘ (wordIso F G e Y.as).hom) ≫ μ G X Y := by rfl

end WordIso

section BraidedUniqueness

variable [BraidedCategory D] {F G : S.FreeBraided ⥤ D} [F.Braided] [G.Braided]
  {e : ∀ a, F.obj (of a) ≅ G.obj (of a)}

/- Composites with tensors of morphisms are folded into a single tensor of composites, so that
the tensorators cancel inside each tensor factor. -/
attribute [local simp] whiskerLeft_comp_tensorHom whiskerLeft_comp_tensorHom_assoc
  whiskerRight_comp_tensorHom whiskerRight_comp_tensorHom_assoc tensorHom_comp_whiskerLeft
  tensorHom_comp_whiskerLeft_assoc tensorHom_comp_whiskerRight tensorHom_comp_whiskerRight_assoc

/-- The isomorphisms `wordIso F G e` between two strong braided functors are natural as soon as
they are natural with respect to the coupons. -/
theorem map_comp_wordIso_hom
    (he : ∀ g, F.map (coupon g) ≫ (wordIso F G e (S.tgt g)).hom =
      (wordIso F G e (S.src g)).hom ≫ G.map (coupon g))
    {X Y : S.FreeBraided} (f : X ⟶ Y) :
    F.map f ≫ (wordIso F G e Y.as).hom = (wordIso F G e X.as).hom ≫ G.map f := by
  induction f using Hom.inductionOn with
  | id X => simp
  | α_hom X Y Z =>
    rw [← cancel_epi (μ F X Y ▷ F.obj Z ≫ μ F (X ⊗ Y) Z),
      ← cancel_mono (δ G X (Y ⊗ Z) ≫ G.obj X ◁ δ G Y Z)]
    simp [← Functor.OplaxMonoidal.associativity]
  | α_inv X Y Z =>
    rw [← cancel_epi (F.obj X ◁ μ F Y Z ≫ μ F X (Y ⊗ Z)),
      ← cancel_mono (δ G (X ⊗ Y) Z ≫ δ G X Y ▷ G.obj Z)]
    simp [← Functor.OplaxMonoidal.associativity_inv]
  | l_hom X =>
    rw [← cancel_epi (ε F ▷ F.obj X ≫ μ F (𝟙_ _) X)]
    simp
    simp [tensorHom_def']
  | l_inv X =>
    rw [← cancel_mono (δ G (𝟙_ _) X ≫ η G ▷ G.obj X)]
    simp
    simp [MonoidalCategory.tensorHom_def, ← Functor.OplaxMonoidal.left_unitality]
  | ρ_hom X =>
    rw [← cancel_epi (F.obj X ◁ ε F ≫ μ F X (𝟙_ _))]
    simp
    simp [MonoidalCategory.tensorHom_def]
  | ρ_inv X =>
    rw [← cancel_mono (δ G X (𝟙_ _) ≫ G.obj X ◁ η G)]
    simp
    simp [tensorHom_def', ← Functor.OplaxMonoidal.right_unitality]
  | β_hom X Y =>
    simp [BraidedCategory.braiding_naturality_assoc]
  | β_inv X Y =>
    rw [← cancel_epi (F.map (β_ X Y).hom), ← cancel_mono (G.map (β_ X Y).hom),
      ← Functor.map_comp_assoc, Iso.hom_inv_id, Functor.map_id, Category.id_comp,
      Category.assoc, Category.assoc, ← Functor.map_comp, Iso.inv_hom_id, Functor.map_id,
      Category.comp_id]
    simp [BraidedCategory.braiding_naturality_assoc]
  | coupon g => exact he g
  | comp f g hf hg =>
    rw [Functor.map_comp, Functor.map_comp, Category.assoc, hg, reassoc_of% hf]
  | whiskerLeft X f hf =>
    simp only [wordIso_tensor_hom, Functor.Monoidal.map_whiskerLeft, Category.assoc,
      Functor.Monoidal.μ_δ_assoc, whiskerLeft_comp_tensorHom_assoc,
      tensorHom_comp_whiskerLeft_assoc, hf]
  | whiskerRight f X hf =>
    simp only [wordIso_tensor_hom, Functor.Monoidal.map_whiskerRight, Category.assoc,
      Functor.Monoidal.μ_δ_assoc, whiskerRight_comp_tensorHom_assoc,
      tensorHom_comp_whiskerRight_assoc, hf]

/-- Two strong braided functors out of the free braided monoidal category on `S` that agree up to
isomorphisms `e` on the generating objects, compatibly with every coupon, are isomorphic by a
monoidal natural isomorphism extending `e`. -/
def monoidalNatIso
    (he : ∀ g, F.map (coupon g) ≫ (wordIso F G e (S.tgt g)).hom =
      (wordIso F G e (S.src g)).hom ≫ G.map (coupon g)) :
    F ≅ G :=
  NatIso.ofComponents (fun X ↦ wordIso F G e X.as) fun f ↦ map_comp_wordIso_hom he f

variable (he : ∀ g, F.map (coupon g) ≫ (wordIso F G e (S.tgt g)).hom =
  (wordIso F G e (S.src g)).hom ≫ G.map (coupon g))

@[simp]
theorem monoidalNatIso_hom_app (X : S.FreeBraided) :
    (monoidalNatIso he).hom.app X = (wordIso F G e X.as).hom := by rfl

theorem monoidalNatIso_hom_app_of (a : S.Obj) :
    (monoidalNatIso he).hom.app (of a) = (e a).hom := by rfl

instance : NatTrans.IsMonoidal (monoidalNatIso he).hom where
  unit := by
    rw [monoidalNatIso_hom_app, wordIso_tensorUnit_hom, Functor.Monoidal.ε_η_assoc]
  tensor X Y := by
    rw [monoidalNatIso_hom_app, wordIso_tensor_hom, Functor.Monoidal.μ_δ_assoc,
      monoidalNatIso_hom_app, monoidalNatIso_hom_app]

end BraidedUniqueness

end Uniqueness

section ExponentSum

/-- The number of generating object occurrences (strands) in an object of `S.FreeBraided`. -/
def length (X : S.FreeBraided) : ℕ :=
  go X.as
where
  go : FreeMonoidalCategory S.Obj → ℕ
    | .of _ => 1
    | .unit => 0
    | .tensor A B => go A + go B

@[simp]
theorem length_of (a : S.Obj) : length (of a) = 1 := by rfl

@[simp]
theorem length_tensorUnit : length (𝟙_ S.FreeBraided) = 0 := by rfl

@[simp]
theorem length_tensor (X Y : S.FreeBraided) : length (X ⊗ Y) = length X + length Y := by rfl

/-- Crossing exponent sum on formal morphisms: returns `some k` on coupon-free terms (counting
each positive braiding of words of lengths `m, n` as `m * n` and each inverse braiding as
`-(m * n)`) and `none` whenever a coupon occurs. -/
private def exponentSumAux : ∀ {X Y : FreeMonoidalCategory S.Obj}, Hom X Y → Option ℤ
  | _, _, .id _ => some 0
  | _, _, .α_hom _ _ _ => some 0
  | _, _, .α_inv _ _ _ => some 0
  | _, _, .l_hom _ => some 0
  | _, _, .l_inv _ => some 0
  | _, _, .ρ_hom _ => some 0
  | _, _, .ρ_inv _ => some 0
  | _, _, .β_hom X Y => some ((length (⟨X⟩ : S.FreeBraided) : ℤ) * length (⟨Y⟩ : S.FreeBraided))
  | _, _, .β_inv X Y => some (-((length (⟨X⟩ : S.FreeBraided) : ℤ) * length (⟨Y⟩ : S.FreeBraided)))
  | _, _, .coupon _ => none
  | _, _, .comp f g => Option.map₂ (· + ·) (exponentSumAux f) (exponentSumAux g)
  | _, _, .whiskerLeft _ f => exponentSumAux f
  | _, _, .whiskerRight f _ => exponentSumAux f
  | _, _, .tensor f g => Option.map₂ (· + ·) (exponentSumAux f) (exponentSumAux g)

/-- Every coupon-free formal morphism preserves strand length. -/
private theorem length_eq_of_exponentSumAux_eq_some {X Y : FreeMonoidalCategory S.Obj}
    {f : Hom X Y} {k : ℤ} (h : exponentSumAux f = some k) :
    length (⟨X⟩ : S.FreeBraided) = length (⟨Y⟩ : S.FreeBraided) := by
  induction f generalizing k with
  | id | α_inv | l_inv | ρ_inv | β_hom | β_inv | coupon =>
    simp_all [exponentSumAux, length, length.go, Nat.add_assoc, Nat.add_comm]
  | α_hom => simp [length, length.go, Nat.add_assoc]
  | l_hom | ρ_hom => simp [length, length.go]
  | comp f g hf hg =>
    simp only [exponentSumAux, Option.map₂_eq_some_iff] at h
    rcases h with ⟨a, b, ha, hb, _⟩
    exact (hf ha).trans (hg hb)
  | whiskerLeft X f hf =>
    exact congrArg (length (⟨X⟩ : S.FreeBraided) + ·) (hf h)
  | whiskerRight f X hf =>
    exact congrArg (· + length (⟨X⟩ : S.FreeBraided)) (hf h)
  | tensor f g hf hg =>
    simp only [exponentSumAux, Option.map₂_eq_some_iff] at h
    rcases h with ⟨a, b, ha, hb, _⟩
    exact congrArg₂ (· + ·) (hf ha) (hg hb)

private theorem exponentSumAux_sound {X Y : FreeMonoidalCategory S.Obj} {f g : Hom X Y}
    (h : HomEquiv f g) : exponentSumAux f = exponentSumAux g := by
  induction h with
  | refl => rfl
  | symm _ _ _ h => exact h.symm
  | trans _ _ h₁ h₂ => exact h₁.trans h₂
  | comp _ _ hf hg => simp only [exponentSumAux, hf, hg]
  | whiskerLeft _ _ _ _ hf => exact hf
  | whiskerRight _ _ _ _ hf => exact hf
  | tensor _ _ hf hg => simp only [exponentSumAux, hf, hg]
  | tensorHom_def => rfl
  | comp_id f | id_comp f | ρ_naturality f | l_naturality f =>
    simp only [exponentSumAux]
    cases exponentSumAux f <;> simp
  | assoc f g h =>
    exact Option.map₂_assoc Int.add_assoc
  | id_tensorHom_id | whiskerLeft_id | id_whiskerRight | α_hom_inv | α_inv_hom | ρ_hom_inv
  | ρ_inv_hom | l_hom_inv | l_inv_hom | pentagon | triangle =>
    simp [exponentSumAux]
  | tensorHom_comp_tensorHom f₁ f₂ g₁ g₂ =>
    simp only [exponentSumAux]
    cases exponentSumAux f₁ <;> cases exponentSumAux f₂ <;>
      cases exponentSumAux g₁ <;> cases exponentSumAux g₂ <;>
      simp; omega
  | associator_naturality f₁ f₂ f₃ =>
    simp only [exponentSumAux]
    cases exponentSumAux f₁ <;> cases exponentSumAux f₂ <;> cases exponentSumAux f₃ <;>
      simp [Int.add_assoc]
  | β_hom_inv | β_inv_hom =>
    simp [exponentSumAux]; omega
  | braiding_naturality_right X f =>
    cases h : exponentSumAux f with
    | none => simp [exponentSumAux, h]
    | some k =>
      have hlen := length_eq_of_exponentSumAux_eq_some h
      simp [exponentSumAux, h, hlen, Int.add_comm]
  | braiding_naturality_left f Z =>
    cases h : exponentSumAux f with
    | none => simp [exponentSumAux, h]
    | some k =>
      have hlen := length_eq_of_exponentSumAux_eq_some h
      simp [exponentSumAux, h, hlen, Int.add_comm]
  | hexagon_forward =>
    simp only [exponentSumAux, Option.map₂_some_some, Int.zero_add, Int.add_zero,
      length, length.go, Int.natCast_add, Int.mul_add]
  | hexagon_reverse =>
    simp only [exponentSumAux, Option.map₂_some_some, Int.zero_add,
      length, length.go, Int.natCast_add, Int.add_mul, Int.add_comm]

/-- The crossing exponent sum of a morphism in `S.FreeBraided`. On coupon-free morphisms it
returns `some k`, counting each positive crossing of strands as `+1` and each negative crossing as
`-1`; on morphisms involving a coupon it returns `none`. -/
def exponentSum {X Y : S.FreeBraided} (f : X ⟶ Y) : Option ℤ :=
  Quotient.lift exponentSumAux (fun _ _ h ↦ exponentSumAux_sound h) f

@[simp]
theorem exponentSum_id (X : S.FreeBraided) : exponentSum (𝟙 X) = some 0 := by rfl

@[simp]
theorem exponentSum_comp {X Y Z : S.FreeBraided} (f : X ⟶ Y) (g : Y ⟶ Z) :
    exponentSum (f ≫ g) = Option.map₂ (· + ·) (exponentSum f) (exponentSum g) := by
  induction f using Quotient.inductionOn
  induction g using Quotient.inductionOn
  rfl

@[simp]
theorem exponentSum_tensorHom {X₁ Y₁ X₂ Y₂ : S.FreeBraided} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂) :
    exponentSum (f ⊗ₘ g) = Option.map₂ (· + ·) (exponentSum f) (exponentSum g) := by
  induction f using Quotient.inductionOn
  induction g using Quotient.inductionOn
  rfl

@[simp]
theorem exponentSum_whiskerLeft (X : S.FreeBraided) {Y Z : S.FreeBraided} (f : Y ⟶ Z) :
    exponentSum (X ◁ f) = exponentSum f := by
  induction f using Quotient.inductionOn
  rfl

@[simp]
theorem exponentSum_whiskerRight {X Y : S.FreeBraided} (f : X ⟶ Y) (Z : S.FreeBraided) :
    exponentSum (f ▷ Z) = exponentSum f := by
  induction f using Quotient.inductionOn
  rfl

@[simp]
theorem exponentSum_associator_hom (X Y Z : S.FreeBraided) :
    exponentSum (α_ X Y Z).hom = some 0 := by rfl

@[simp]
theorem exponentSum_associator_inv (X Y Z : S.FreeBraided) :
    exponentSum (α_ X Y Z).inv = some 0 := by rfl

@[simp]
theorem exponentSum_leftUnitor_hom (X : S.FreeBraided) :
    exponentSum (λ_ X).hom = some 0 := by rfl

@[simp]
theorem exponentSum_leftUnitor_inv (X : S.FreeBraided) :
    exponentSum (λ_ X).inv = some 0 := by rfl

@[simp]
theorem exponentSum_rightUnitor_hom (X : S.FreeBraided) :
    exponentSum (ρ_ X).hom = some 0 := by rfl

@[simp]
theorem exponentSum_rightUnitor_inv (X : S.FreeBraided) :
    exponentSum (ρ_ X).inv = some 0 := by rfl

@[simp]
theorem exponentSum_braiding_hom (X Y : S.FreeBraided) :
    exponentSum (β_ X Y).hom = some ((X.length : ℤ) * Y.length) := by rfl

@[simp]
theorem exponentSum_braiding_inv (X Y : S.FreeBraided) :
    exponentSum (β_ X Y).inv = some (-((X.length : ℤ) * Y.length)) := by rfl

@[simp]
theorem exponentSum_coupon (g : S.Coupon) : exponentSum (coupon g) = none := by rfl

/-- Every coupon-free morphism in `S.FreeBraided` preserves strand length. -/
theorem length_eq_of_exponentSum_eq_some {X Y : S.FreeBraided} {f : X ⟶ Y} {k : ℤ}
    (h : exponentSum f = some k) : X.length = Y.length := by
  induction f using Quotient.inductionOn with | _ p
  exact length_eq_of_exponentSumAux_eq_some h

/-- The double positive braiding on two generating objects has crossing exponent sum `2`. -/
theorem exponentSum_braiding_of_comp_braiding_of (a b : S.Obj) :
    exponentSum ((β_ (of a) (of b)).hom ≫ (β_ (of b) (of a)).hom) = some 2 := by
  simp

/-- The free braided monoidal category is not symmetric on any pair of nonempty words: the double
positive braiding is distinct from the identity whenever both factors have nonzero length. -/
theorem braiding_comp_braiding_ne_id {X Y : S.FreeBraided}
    (hX : X.length ≠ 0) (hY : Y.length ≠ 0) :
    (β_ X Y).hom ≫ (β_ Y X).hom ≠ 𝟙 (X ⊗ Y) := by
  intro h
  have hsum := congrArg exponentSum h
  simp only [exponentSum_comp, exponentSum_braiding_hom, exponentSum_id,
    Option.map₂_some_some, Option.some.injEq] at hsum
  have hpos : (0 : ℤ) < (X.length : ℤ) * Y.length :=
    Int.mul_pos (Int.natCast_pos.mpr (Nat.pos_of_ne_zero hX))
      (Int.natCast_pos.mpr (Nat.pos_of_ne_zero hY))
  rw [Int.mul_comm (Y.length : ℤ)] at hsum
  omega

/-- The double positive braiding on any two generating objects is distinct from the identity. -/
theorem braiding_of_comp_braiding_of_ne_id (a b : S.Obj) :
    (β_ (of a) (of b)).hom ≫ (β_ (of b) (of a)).hom ≠ 𝟙 (of a ⊗ of b) :=
  braiding_comp_braiding_ne_id (by simp) (by simp)

end ExponentSum

end FreeBraided

