module

public import TauCeti.CategoryTheory.Monoidal.Presentation
public import Mathlib.CategoryTheory.Monoidal.Braided.Basic

/-!
# The free braided category on a tensor signature

Given a tensor signature `S`, the free braided category `TauCeti.TensorSignature.FreeBraided S`
has the tensor words in the generating objects of `S` as objects. Its morphisms are generated by
the coupons of `S`, the structural isomorphisms of a monoidal category and a crossing
`X ⊗ Y ⟶ Y ⊗ X` for every pair of words, subject to exactly the axioms of a braided monoidal
category: no symmetry is imposed and no equation between coupons.

It is built as a monoidal category presented by generators and relations
(`TauCeti.TensorSignature.Presented`). The signature `S.withCrossings` adjoins to the coupons of
`S` a formal crossing `TensorSignature.crossing X Y` and a formal reverse crossing
`TensorSignature.crossingInv X Y` for all words `X` and `Y`, and `TensorSignature.braidingRel S`
consists of the equations saying that these are inverse to each other, natural in both variables
and subject to the two hexagon identities. The classes of the crossings form a braiding of the
presented category. Further equations are imposed in the same quotient, giving the braided
categories presented by `S` and equations.

## Main definitions and results

* `TauCeti.TensorSignature.withCrossings S` and `TauCeti.TensorSignature.braidingRel S`: the
  presentation of the free braided category.
* `TauCeti.TensorSignature.BraidedPresented S R`: the braided category presented by `S` and
  equations `R` between morphisms of the free monoidal category on `S.withCrossings`, the monoidal
  category presented by `S.withCrossings` and the relations `braidingRel S` together with `R`. It
  has the instance `BraidedCategory`, and `BraidedPresented.of` and `BraidedPresented.coupon` for
  the generators.
* `TauCeti.TensorSignature.FreeBraided S`: the free braided category on `S`, the case where the
  only equations are the braided-category axioms themselves.
* `BraidedPresented.lift fo fc h`: the braided functor into an arbitrary (not necessarily strict)
  braided category determined by images `fo` of the generating objects and `fc` of the coupons
  satisfying the equations `R`, with computation rules `BraidedPresented.lift_obj_of` and
  `BraidedPresented.lift_map_coupon`. For the free braided category it is `FreeBraided.lift fo fc`.
* `BraidedPresented.monoidalNatIso`: two braided functors out of `S.BraidedPresented R` that agree
  up to isomorphism on the generating objects, compatibly with the coupons of `S`, are monoidally
  naturally isomorphic. Compatibility with the crossings is automatic. Taking one of the functors
  to be `lift fo fc h`, this is the uniqueness of the lift.

Monoidal natural transformations out of `S.BraidedPresented R` are determined by their components
at the generating objects by `TauCeti.TensorSignature.Presented.natTrans_ext`, since it is a
presented monoidal category. Together these give the universal property of the free braided
category on a tensor scheme (Joyal–Street, *The geometry of tensor calculus I*), for strong
braided functors into arbitrary braided categories.

## References

* A. Joyal and R. Street, *The geometry of tensor calculus I*, Adv. Math. 88 (1991).
* A. Joyal and R. Street, *Braided tensor categories*, Adv. Math. 102 (1993).
-/

public section

universe u v u' v'

open CategoryTheory MonoidalCategory FreeMonoidalCategory

namespace TauCeti.TensorSignature

variable (S : TensorSignature.{u, v})

/-- The coupons of `S.withCrossings`: the coupons of `S`, a crossing for every ordered pair of
tensor words and a reverse crossing for every ordered pair of tensor words. -/
inductive CrossingCoupon : Type (max u v)
  /-- A coupon of `S`. -/
  | coupon (g : S.Coupon)
  /-- The crossing `X ⊗ Y ⟶ Y ⊗ X`. -/
  | crossing (X Y : FreeMonoidalCategory S.Obj)
  /-- The reverse crossing `Y ⊗ X ⟶ X ⊗ Y`. -/
  | crossingInv (X Y : FreeMonoidalCategory S.Obj)

/-- The tensor signature obtained from `S` by adjoining a crossing `X ⊗ Y ⟶ Y ⊗ X` and a reverse
crossing `Y ⊗ X ⟶ X ⊗ Y` for every pair of tensor words `X` and `Y`. It has the same generating
objects as `S`. -/
-- This is reducible so that the generating objects of `S.withCrossings` are those of `S` up to
-- reducible unfolding, which lets the lemmas about `FreeMonoidal.lift` apply to interpretations
-- `fo : S.Obj → D`, and so that the boundary words of the crossings reduce.
abbrev withCrossings : TensorSignature.{u, max u v} where
  Obj := S.Obj
  Coupon := S.CrossingCoupon
  src
    | .coupon g => S.src g
    | .crossing X Y => X.tensor Y
    | .crossingInv X Y => Y.tensor X
  tgt
    | .coupon g => S.tgt g
    | .crossing X Y => Y.tensor X
    | .crossingInv X Y => X.tensor Y

variable {S}

/-- The formal crossing `X ⊗ Y ⟶ Y ⊗ X` in the free monoidal category on `S.withCrossings`. -/
def crossing (X Y : S.withCrossings.FreeMonoidal) : X ⊗ Y ⟶ Y ⊗ X :=
  FreeMonoidal.coupon (S := S.withCrossings) (CrossingCoupon.crossing X.as Y.as)

/-- The formal reverse crossing `Y ⊗ X ⟶ X ⊗ Y` in the free monoidal category on
`S.withCrossings`. -/
def crossingInv (X Y : S.withCrossings.FreeMonoidal) : Y ⊗ X ⟶ X ⊗ Y :=
  FreeMonoidal.coupon (S := S.withCrossings) (CrossingCoupon.crossingInv X.as Y.as)

/-- The formal crossing is the coupon `CrossingCoupon.crossing` of `S.withCrossings`. -/
theorem crossing_def (X Y : S.withCrossings.FreeMonoidal) :
    crossing X Y = FreeMonoidal.coupon (S := S.withCrossings) (CrossingCoupon.crossing X.as Y.as) :=
  (rfl)

/-- The formal reverse crossing is the coupon `CrossingCoupon.crossingInv` of
`S.withCrossings`. -/
theorem crossingInv_def (X Y : S.withCrossings.FreeMonoidal) :
    crossingInv X Y =
      FreeMonoidal.coupon (S := S.withCrossings) (CrossingCoupon.crossingInv X.as Y.as) :=
  (rfl)

variable (S) in
/-- The axioms of a braided monoidal category for the formal crossings: crossings and reverse
crossings are mutually inverse, crossings are natural in both variables with respect to every
morphism, and they satisfy the two hexagon identities. -/
inductive braidingRel : HomRel S.withCrossings.FreeMonoidal
  | hom_inv_id (X Y : S.withCrossings.FreeMonoidal) :
      braidingRel (crossing X Y ≫ crossingInv X Y) (𝟙 _)
  | inv_hom_id (X Y : S.withCrossings.FreeMonoidal) :
      braidingRel (crossingInv X Y ≫ crossing X Y) (𝟙 _)
  | naturality_right (X : S.withCrossings.FreeMonoidal) {Y Z : S.withCrossings.FreeMonoidal}
      (f : Y ⟶ Z) :
      braidingRel (X ◁ f ≫ crossing X Z) (crossing X Y ≫ f ▷ X)
  | naturality_left {X Y : S.withCrossings.FreeMonoidal} (f : X ⟶ Y)
      (Z : S.withCrossings.FreeMonoidal) :
      braidingRel (f ▷ Z ≫ crossing Y Z) (crossing X Z ≫ Z ◁ f)
  | hexagon_forward (X Y Z : S.withCrossings.FreeMonoidal) :
      braidingRel ((α_ X Y Z).hom ≫ crossing X (Y ⊗ Z) ≫ (α_ Y Z X).hom)
        (crossing X Y ▷ Z ≫ (α_ Y X Z).hom ≫ Y ◁ crossing X Z)
  | hexagon_reverse (X Y Z : S.withCrossings.FreeMonoidal) :
      braidingRel ((α_ X Y Z).inv ≫ crossing (X ⊗ Y) Z ≫ (α_ Z X Y).inv)
        (X ◁ crossing Y Z ≫ (α_ X Z Y).inv ≫ crossing X Z ▷ Y)

variable (S) in
/-- The relations presenting the braided category presented by `S` and the equations `R`: the
braided-category axioms `braidingRel S` of the crossings together with `R`. -/
inductive braidedRel (R : HomRel S.withCrossings.FreeMonoidal) :
    HomRel S.withCrossings.FreeMonoidal
  /-- An axiom of the braiding. -/
  | braiding {X Y : S.withCrossings.FreeMonoidal} {f g : X ⟶ Y} : braidingRel S f g →
      braidedRel R f g
  /-- An equation of `R`. -/
  | of {X Y : S.withCrossings.FreeMonoidal} {f g : X ⟶ Y} : R f g → braidedRel R f g

variable (S) in
/-- The braided category presented by the tensor signature `S` and the equations `R` between
morphisms of the free monoidal category on `S.withCrossings`: the monoidal category presented by
`S.withCrossings` and the braided-category axioms `braidingRel S` of its crossings together with
`R`. Only the equations `R` are imposed beyond the axioms of a braided monoidal category. Its
objects are the tensor words in the generating objects of `S`. -/
abbrev BraidedPresented (R : HomRel S.withCrossings.FreeMonoidal) : Type u :=
  S.withCrossings.Presented (braidedRel S R)

variable (S) in
/-- The free braided category on a tensor signature `S`: the braided category presented by `S`
whose only equations are the braided-category axioms `braidingRel S` themselves, so that nothing
beyond the axioms of a braided monoidal category is imposed. Its objects are the tensor words in
the generating objects of `S`. -/
-- Taking `braidingRel S` as the equations, rather than a lambda for the empty relation, keeps the
-- relation a constant, so that instance search finds the structure of the quotient.
abbrev FreeBraided : Type u :=
  S.BraidedPresented (braidingRel S)

namespace BraidedPresented

variable {R : HomRel S.withCrossings.FreeMonoidal}

/-- The braiding of the presented braided category: the classes of the formal crossing and
reverse crossing. -/
instance : BraidedCategory (S.BraidedPresented R) where
  braiding X Y :=
    { hom := (Presented.quotientFunctor _).map (crossing X.as Y.as)
      inv := (Presented.quotientFunctor _).map (crossingInv X.as Y.as)
      hom_inv_id := Presented.sound (.braiding (.hom_inv_id X.as Y.as))
      inv_hom_id := Presented.sound (.braiding (.inv_hom_id X.as Y.as)) }
  braiding_naturality_right := by
    rintro ⟨X⟩ ⟨Y⟩ ⟨Z⟩ f
    obtain ⟨f, rfl⟩ := (Presented.quotientFunctor _).map_surjective f
    exact Presented.sound (.braiding (.naturality_right X f))
  braiding_naturality_left := by
    rintro ⟨X⟩ ⟨Y⟩ f ⟨Z⟩
    obtain ⟨f, rfl⟩ := (Presented.quotientFunctor _).map_surjective f
    exact Presented.sound (.braiding (.naturality_left f Z))
  hexagon_forward := by
    rintro ⟨X⟩ ⟨Y⟩ ⟨Z⟩
    exact Presented.sound (.braiding (.hexagon_forward X Y Z))
  hexagon_reverse := by
    rintro ⟨X⟩ ⟨Y⟩ ⟨Z⟩
    exact Presented.sound (.braiding (.hexagon_reverse X Y Z))

/-- The braiding of two classes is the class of the formal crossing. -/
theorem braiding_hom_obj (X Y : S.withCrossings.FreeMonoidal) :
    (β_ ((Presented.quotientFunctor _).obj X : S.BraidedPresented R)
      ((Presented.quotientFunctor _).obj Y)).hom =
      (Presented.quotientFunctor _).map (crossing X Y) :=
  (rfl)

/-- The inverse braiding of two classes is the class of the formal reverse crossing. -/
theorem braiding_inv_obj (X Y : S.withCrossings.FreeMonoidal) :
    (β_ ((Presented.quotientFunctor _).obj X : S.BraidedPresented R)
      ((Presented.quotientFunctor _).obj Y)).inv =
      (Presented.quotientFunctor _).map (crossingInv X Y) :=
  (rfl)

/-- The object of the presented braided category given by a single generating object. -/
abbrev of (a : S.Obj) : S.BraidedPresented R :=
  (Presented.quotientFunctor _).obj (FreeMonoidal.of (S := S.withCrossings) a)

/-- The generating morphism of the presented braided category given by a coupon of `S`, from its
source word to its target word. -/
def coupon (g : S.Coupon) : (⟨⟨S.src g⟩⟩ : S.BraidedPresented R) ⟶ ⟨⟨S.tgt g⟩⟩ :=
  (Presented.quotientFunctor _).map (FreeMonoidal.coupon (S := S.withCrossings) (.coupon g))

/-- The generating morphism `coupon g` is the class of the formal coupon `g`. -/
theorem quotientFunctor_map_coupon (g : S.Coupon) :
    (Presented.quotientFunctor _).map (FreeMonoidal.coupon (S := S.withCrossings) (.coupon g)) =
      (coupon g : (⟨⟨S.src g⟩⟩ : S.BraidedPresented R) ⟶ _) :=
  (rfl)

section Lift

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D] [BraidedCategory D]
  (fo : S.Obj → D) (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g))

/-- The interpretation of the coupons of `S.withCrossings` in a braided category `D`: the coupons
of `S` go to their images under `fc`, and the crossing and reverse crossing of two words go to the
braiding of their images and its inverse. -/
def liftCoupon : ∀ g : S.withCrossings.Coupon,
    projectObj fo (S.withCrossings.src g) ⟶ projectObj fo (S.withCrossings.tgt g)
  | .coupon g => fc g
  | .crossing X Y => (β_ (projectObj fo X) (projectObj fo Y)).hom
  | .crossingInv X Y => (β_ (projectObj fo X) (projectObj fo Y)).inv

/-- The interpretation `liftCoupon fo fc` sends a coupon of `S` to its image under `fc`. -/
@[simp]
theorem liftCoupon_coupon (g : S.Coupon) : liftCoupon fo fc (.coupon g) = fc g :=
  (rfl)

/-- The interpretation `liftCoupon fo fc` sends the crossing of two words to the braiding of their
images. -/
@[simp]
theorem liftCoupon_crossing (X Y : FreeMonoidalCategory S.Obj) :
    liftCoupon fo fc (.crossing X Y) = (β_ (projectObj fo X) (projectObj fo Y)).hom :=
  (rfl)

/-- The interpretation `liftCoupon fo fc` sends the reverse crossing of two words to the inverse
braiding of their images. -/
@[simp]
theorem liftCoupon_crossingInv (X Y : FreeMonoidalCategory S.Obj) :
    liftCoupon fo fc (.crossingInv X Y) = (β_ (projectObj fo X) (projectObj fo Y)).inv :=
  (rfl)

/-- The interpretation `liftCoupon fo fc` sends a formal crossing to the braiding. -/
@[simp]
theorem freeMonoidalLift_liftCoupon_map_crossing (X Y : S.withCrossings.FreeMonoidal) :
    (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map (crossing X Y) =
      (β_ (projectObj fo X.as) (projectObj fo Y.as)).hom :=
  FreeMonoidal.lift_map_coupon _ _ _

/-- The interpretation `liftCoupon fo fc` sends a formal reverse crossing to the inverse
braiding. -/
@[simp]
theorem freeMonoidalLift_liftCoupon_map_crossingInv (X Y : S.withCrossings.FreeMonoidal) :
    (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map (crossingInv X Y) =
      (β_ (projectObj fo X.as) (projectObj fo Y.as)).inv :=
  FreeMonoidal.lift_map_coupon _ _ _

/-- The interpretation `liftCoupon fo fc` of the free monoidal category on `S.withCrossings`
satisfies the braided-category axioms of the crossings. -/
theorem map_eq_map_of_braidingRel ⦃X Y : S.withCrossings.FreeMonoidal⦄ ⦃f g : X ⟶ Y⦄
    (h : braidingRel S f g) :
    (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map f =
      (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map g := by
  -- After computing the images of the generators, each case is the corresponding axiom of the
  -- braiding of `D`, applied up to the definitional equality between the objects
  -- `(FreeMonoidal.lift fo _).obj X` and `projectObj fo X.as`.
  induction h with
  | hom_inv_id X Y =>
    rw [Functor.map_comp, freeMonoidalLift_liftCoupon_map_crossing,
      freeMonoidalLift_liftCoupon_map_crossingInv, Functor.map_id]
    exact Iso.hom_inv_id _
  | inv_hom_id X Y =>
    rw [Functor.map_comp, freeMonoidalLift_liftCoupon_map_crossing,
      freeMonoidalLift_liftCoupon_map_crossingInv, Functor.map_id]
    exact Iso.inv_hom_id _
  | naturality_right X f =>
    simp only [Functor.map_comp, FreeMonoidal.lift_map_whiskerLeft,
      FreeMonoidal.lift_map_whiskerRight, freeMonoidalLift_liftCoupon_map_crossing]
    exact BraidedCategory.braiding_naturality_right _ _
  | naturality_left f Z =>
    simp only [Functor.map_comp, FreeMonoidal.lift_map_whiskerLeft,
      FreeMonoidal.lift_map_whiskerRight, freeMonoidalLift_liftCoupon_map_crossing]
    exact BraidedCategory.braiding_naturality_left _ _
  | hexagon_forward X Y Z =>
    simp only [Functor.map_comp, FreeMonoidal.lift_map_whiskerLeft,
      FreeMonoidal.lift_map_whiskerRight, FreeMonoidal.lift_map_associator_hom,
      freeMonoidalLift_liftCoupon_map_crossing]
    exact BraidedCategory.hexagon_forward _ _ _
  | hexagon_reverse X Y Z =>
    simp only [Functor.map_comp, FreeMonoidal.lift_map_whiskerLeft,
      FreeMonoidal.lift_map_whiskerRight, FreeMonoidal.lift_map_associator_inv,
      freeMonoidalLift_liftCoupon_map_crossing]
    exact BraidedCategory.hexagon_reverse _ _ _

variable {fo fc} in
/-- If the interpretation `liftCoupon fo fc` satisfies the equations `R`, then it satisfies all
the relations `braidedRel S R` of the braided presentation. -/
theorem map_eq_map_of_braidedRel
    (h : ∀ ⦃X Y : S.withCrossings.FreeMonoidal⦄ ⦃f g : X ⟶ Y⦄, R f g →
      (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map f =
        (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map g)
    ⦃X Y : S.withCrossings.FreeMonoidal⦄ ⦃f g : X ⟶ Y⦄ (hfg : braidedRel S R f g) :
    (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map f =
      (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map g :=
  match hfg with
  | .braiding hfg => map_eq_map_of_braidingRel fo fc hfg
  | .of hfg => h hfg

variable (h : ∀ ⦃X Y : S.withCrossings.FreeMonoidal⦄ ⦃f g : X ⟶ Y⦄, R f g →
    (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map f =
      (FreeMonoidal.lift (S := S.withCrossings) fo (liftCoupon fo fc)).map g)

/-- The functor out of the braided category presented by `S` and `R` determined by the images
`fo` of the generating objects and `fc` of the coupons in a braided category `D`, provided the
induced interpretation `liftCoupon fo fc` satisfies the equations `R`: the functor
`Presented.lift fo (liftCoupon fo fc)`, whose monoidal structure and computation rules
(`Presented.lift_map`, `Presented.lift_μ` and its companions) apply directly. It is braided, with
identity tensorator and unit comparison, and sends the braiding of two words to the braiding of
their images. -/
abbrev lift : S.BraidedPresented R ⥤ D :=
  Presented.lift (S := S.withCrossings) fo (liftCoupon fo fc) (map_eq_map_of_braidedRel h)

theorem lift_obj (X : S.BraidedPresented R) : (lift fo fc h).obj X = projectObj fo X.as.as :=
  (rfl)

theorem lift_obj_of (a : S.Obj) : (lift fo fc h).obj (of a) = fo a :=
  (rfl)

@[simp]
theorem lift_map_coupon (g : S.Coupon) : (lift fo fc h).map (coupon g) = fc g :=
  (Presented.lift_map _ _ _ _).trans (FreeMonoidal.lift_map_coupon _ _ _)

/-- The braiding of two words goes to the braiding of their images. -/
theorem lift_map_braiding_hom (X Y : S.BraidedPresented R) :
    (lift fo fc h).map (β_ X Y).hom = (β_ ((lift fo fc h).obj X) ((lift fo fc h).obj Y)).hom :=
  -- The chain is stated up to the definitional equality between `(lift fo fc h).obj (X ⊗ Y)` and
  -- `(lift fo fc h).obj X ⊗ (lift fo fc h).obj Y`, which `rw` cannot see through.
  (congrArg (lift fo fc h).map (braiding_hom_obj X.as Y.as)).trans
    ((Presented.lift_map _ _ _ _).trans
      (freeMonoidalLift_liftCoupon_map_crossing fo fc X.as Y.as))

/-- The inverse braiding of two words goes to the inverse braiding of their images. -/
@[simp]
theorem lift_map_braiding_inv (X Y : S.BraidedPresented R) :
    (lift fo fc h).map (β_ X Y).inv = (β_ ((lift fo fc h).obj X) ((lift fo fc h).obj Y)).inv :=
  -- The chain is stated up to the definitional equality between `(lift fo fc h).obj (X ⊗ Y)` and
  -- `(lift fo fc h).obj X ⊗ (lift fo fc h).obj Y`, which `rw` cannot see through.
  (congrArg (lift fo fc h).map (braiding_inv_obj X.as Y.as)).trans
    ((Presented.lift_map _ _ _ _).trans
      (freeMonoidalLift_liftCoupon_map_crossingInv fo fc X.as Y.as))

instance : (lift fo fc h).Braided where
  braided X Y := by
    -- The tensorators are identities; `Category.id_comp` is applied up to the definitional
    -- equality `(lift fo fc h).obj (X ⊗ Y) = (lift fo fc h).obj X ⊗ (lift fo fc h).obj Y`.
    simp only [Presented.lift_μ]
    exact (Category.id_comp _).trans
      ((lift_map_braiding_hom fo fc h X Y).trans (Category.comp_id _).symm)

end Lift

section Uniqueness

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D] [BraidedCategory D]

variable {F G : S.BraidedPresented R ⥤ D} [F.Braided] [G.Braided]
  {e : ∀ a, F.obj (of a) ≅ G.obj (of a)}

/-- The isomorphisms which isomorphisms `e` at the generating objects induce on all tensor words
are natural with respect to the braiding, for any two braided functors. -/
theorem map_braiding_hom_comp_wordIso_hom (X Y : S.withCrossings.FreeMonoidal) :
    F.map (β_ ((Presented.quotientFunctor _).obj X) ((Presented.quotientFunctor _).obj Y)).hom ≫
        (FreeMonoidal.wordIso (Presented.quotientFunctor _ ⋙ F) (Presented.quotientFunctor _ ⋙ G)
          e (Y ⊗ X).as).hom =
      (FreeMonoidal.wordIso (Presented.quotientFunctor _ ⋙ F) (Presented.quotientFunctor _ ⋙ G)
          e (X ⊗ Y).as).hom ≫
        G.map (β_ ((Presented.quotientFunctor _).obj X)
          ((Presented.quotientFunctor _).obj Y)).hom := by
  simp

/-- The isomorphisms which isomorphisms `e` at the generating objects induce on all tensor words
are natural with respect to the inverse braiding, for any two braided functors. -/
theorem map_braiding_inv_comp_wordIso_hom (X Y : S.withCrossings.FreeMonoidal) :
    F.map (β_ ((Presented.quotientFunctor _).obj X) ((Presented.quotientFunctor _).obj Y)).inv ≫
        (FreeMonoidal.wordIso (Presented.quotientFunctor _ ⋙ F) (Presented.quotientFunctor _ ⋙ G)
          e (X ⊗ Y).as).hom =
      (FreeMonoidal.wordIso (Presented.quotientFunctor _ ⋙ F) (Presented.quotientFunctor _ ⋙ G)
          e (Y ⊗ X).as).hom ≫
        G.map (β_ ((Presented.quotientFunctor _).obj X)
          ((Presented.quotientFunctor _).obj Y)).inv :=
  (CommSq.horiz_inv (f := F.mapIso (β_ _ _)) (i := G.mapIso (β_ _ _))
    ⟨map_braiding_hom_comp_wordIso_hom X Y⟩).w

variable (he : ∀ g, F.map (coupon g) ≫
      (FreeMonoidal.wordIso (Presented.quotientFunctor _ ⋙ F) (Presented.quotientFunctor _ ⋙ G)
        e (S.tgt g)).hom =
    (FreeMonoidal.wordIso (Presented.quotientFunctor _ ⋙ F) (Presented.quotientFunctor _ ⋙ G)
        e (S.src g)).hom ≫
      G.map (coupon g))

include he in
/-- If the isomorphisms which isomorphisms `e` at the generating objects induce on all tensor
words are compatible with every coupon of `S`, then they are compatible with every coupon of
`S.withCrossings`, crossings included. -/
theorem map_withCrossingsCoupon_comp_wordIso_hom (g : S.withCrossings.Coupon) :
    F.map ((Presented.quotientFunctor _).map (FreeMonoidal.coupon g)) ≫
        (FreeMonoidal.wordIso (Presented.quotientFunctor _ ⋙ F) (Presented.quotientFunctor _ ⋙ G)
          e (S.withCrossings.tgt g)).hom =
      (FreeMonoidal.wordIso (Presented.quotientFunctor _ ⋙ F) (Presented.quotientFunctor _ ⋙ G)
          e (S.withCrossings.src g)).hom ≫
        G.map ((Presented.quotientFunctor _).map (FreeMonoidal.coupon g)) :=
  match g with
  | .coupon g => he g
  | .crossing X Y => map_braiding_hom_comp_wordIso_hom ⟨X⟩ ⟨Y⟩
  | .crossingInv X Y => map_braiding_inv_comp_wordIso_hom ⟨X⟩ ⟨Y⟩

variable (F G e)

/-- Two braided functors out of the braided category presented by `S` and `R` that agree up to
isomorphisms `e` on the generating objects, compatibly with every coupon of `S`, are isomorphic by
a monoidal natural isomorphism extending `e`: the isomorphism `Presented.monoidalNatIso`, whose
components (`Presented.monoidalNatIso_hom_app`, `Presented.monoidalNatIso_hom_app_of`) and
monoidality apply directly. The compatibility is stated with the isomorphisms
`FreeMonoidal.wordIso` which `e` induces on all tensor words; compatibility with the crossings
holds automatically (`map_withCrossingsCoupon_comp_wordIso_hom`). Taking one of the functors to
be `lift fo fc h`, this is the uniqueness of the lift. -/
abbrev monoidalNatIso : F ≅ G :=
  Presented.monoidalNatIso F G e (map_withCrossingsCoupon_comp_wordIso_hom he)

end Uniqueness

end BraidedPresented

namespace FreeBraided

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D] [BraidedCategory D]

/-- The braided functor out of the free braided category on `S` determined by the images `fo` of
the generating objects and `fc` of the coupons in a braided category `D`: the functor
`BraidedPresented.lift`, whose hypothesis holds by `BraidedPresented.map_eq_map_of_braidingRel`. -/
abbrev lift (fo : S.Obj → D)
    (fc : ∀ g : S.Coupon, projectObj fo (S.src g) ⟶ projectObj fo (S.tgt g)) :
    S.FreeBraided ⥤ D :=
  BraidedPresented.lift fo fc (BraidedPresented.map_eq_map_of_braidingRel fo fc)

end FreeBraided

end TauCeti.TensorSignature
