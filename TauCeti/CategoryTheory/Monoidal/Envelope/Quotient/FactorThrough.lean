module

public import TauCeti.CategoryTheory.Monoidal.Envelope.Quotient.Basic
public import TauCeti.CategoryTheory.Preadditive.MorphismIdeal.FactorThrough

/-!
# Tensor ideals of maps factoring through a class of objects

Let `P` be an object property of a monoidal preadditive category that is closed under tensoring
with arbitrary objects on either side. Then the morphism ideal `P.factorIdeal`, generated by the
maps factoring through a `P`-object, is a tensor ideal: whiskering a composite `X ⟶ Z ⟶ Y` with
`W` gives a composite through `W ⊗ Z` or `Z ⊗ W`, and whiskering is additive.

The main example is the class of projective modules over a Hopf algebra, whose tensor ideal
yields the stable module category with its tensor product.

## Main definitions

* `CategoryTheory.ObjectProperty.factorMonoidalIdeal`: the tensor ideal generated by the maps
  factoring through a `P`-object, for `P` closed under tensoring on both sides.
-/

public section

universe v u

open CategoryTheory MonoidalCategory

namespace CategoryTheory.ObjectProperty

variable {C : Type u} [Category.{v} C] [Preadditive C] [MonoidalCategory C]
  [MonoidalPreadditive C]

/-- For an object property `P` closed under tensoring with arbitrary objects on both sides, the
maps factoring through a `P`-object generate a tensor ideal. -/
def factorMonoidalIdeal (P : ObjectProperty C) (hl : ∀ (W : C) {Z : C}, P Z → P (W ⊗ Z))
    (hr : ∀ (W : C) {Z : C}, P Z → P (Z ⊗ W)) : TauCeti.MonoidalIdeal C where
  toMorphismIdeal := P.factorIdeal
  whiskerLeft_mem W {_ _} f hf :=
    (TauCeti.MorphismIdeal.mem_comap_hom _ _).1 <|
      TauCeti.MorphismIdeal.le_def.1 (factorIdeal_le_comap (tensorLeft W) fun _ ↦ hl W) f hf
  whiskerRight_mem {_ _} f W hf :=
    (TauCeti.MorphismIdeal.mem_comap_hom _ _).1 <|
      TauCeti.MorphismIdeal.le_def.1 (factorIdeal_le_comap (tensorRight W) fun _ ↦ hr W) f hf

/-- The underlying morphism ideal of `factorMonoidalIdeal` is `factorIdeal`. -/
@[simp]
theorem factorMonoidalIdeal_toMorphismIdeal (P : ObjectProperty C)
    (hl : ∀ (W : C) {Z : C}, P Z → P (W ⊗ Z)) (hr : ∀ (W : C) {Z : C}, P Z → P (Z ⊗ W)) :
    (P.factorMonoidalIdeal hl hr).toMorphismIdeal = P.factorIdeal :=
  (rfl)

end CategoryTheory.ObjectProperty
