module

public import TauCeti.CategoryTheory.Monoidal.Free.TensorSignature.Braided.Substitution
public import TauCeti.CategoryTheory.Quotient.Braided

/-!
# Braided monoidal categories presented by generators and relations

A *braided presentation* consists of a tensor signature `S` together with a family
`R : HomRel S.FreeBraided` of typed equations between morphisms of the free braided monoidal
category on `S`. The braided monoidal category `S.PresentedBraided R` it presents is the quotient
of `TauCeti.TensorSignature.FreeBraided S` by the least monoidal congruence
`HomRel.MonoidalClosure R` containing `R`, with the monoidal and braided structures descended along
the quotient functor. Only the equations in `R` are imposed beyond the axioms of a braided monoidal
category.

Its universal property is that of `S.FreeBraided` restricted to interpretations satisfying `R`:
an assignment of images of the generating objects and coupons in an arbitrary (not necessarily
strict) braided monoidal category `D` whose induced strong braided functor
`TauCeti.TensorSignature.FreeBraided.lift` identifies the two sides of every equation in `R`
factors through a strong braided functor `S.PresentedBraided R ⥤ D`, unique up to a unique
monoidal natural isomorphism extending given isomorphisms on the generating objects.

Braided substitutions between signatures (`TauCeti.TensorSignature.FreeBraided.Substitution`)
descend to strong braided functors `S.PresentedBraided R₁ ⥤ T.PresentedBraided R₂` whenever they
map `R₁` into the monoidal congruence generated by `R₂`
(`TauCeti.TensorSignature.PresentedBraided.mapSubstitution`), functorially with respect to
identity and composition of substitutions. Iterated quotienting of `S.PresentedBraided R₁` by a
second family `R₂` is monoidally and braidedly equivalent to `S.PresentedBraided (R₁.sup R₂)` via
`CategoryTheory.Quotient.iteratedMonoidalEquiv`.

## Main definitions and results

* `TauCeti.TensorSignature.PresentedBraided S R`: the braided monoidal category presented by `S`
  and `R`, with the strict braided quotient functor
  `TauCeti.TensorSignature.PresentedBraided.quotientFunctor R` and soundness
  `TauCeti.TensorSignature.PresentedBraided.sound`.
* `TauCeti.TensorSignature.PresentedBraided.lift fo fc h`: the strong braided functor determined by
  the images `fo` of the generating objects and `fc` of the coupons satisfying `R`, with
  `quotientFunctor_comp_lift`, `lift_obj`, `lift_map`, `lift_ε`, `lift_η`, `lift_μ`, `lift_δ`.
* `TauCeti.TensorSignature.PresentedBraided.monoidalNatIso` and `natTrans_ext`: uniqueness of
  strong braided functors out of `S.PresentedBraided R` up to unique monoidal natural isomorphism.
* `TauCeti.TensorSignature.PresentedBraided.mapSubstitution`: descent of braided substitutions to
  presented braided monoidal categories, with `mapSubstitution_id` and `mapSubstitution_comp`.

## References

* A. Joyal and R. Street, *Braided tensor categories*, Adv. Math. 102 (1993), 20–78.
* P. Selinger, *A survey of graphical languages for monoidal categories*, Lecture Notes in Physics
  813 (2011), §3.3.
-/

public section

universe u v u' v' u'' v''

open CategoryTheory MonoidalCategory BraidedCategory

namespace TauCeti.TensorSignature

variable (S : TensorSignature.{u, v}) (R : HomRel S.FreeBraided)

/-- The braided monoidal category presented by the tensor signature `S` and the equations `R`
between morphisms of the free braided monoidal category on `S`: the quotient of `S.FreeBraided` by
the least monoidal congruence containing `R`. Its objects are the formal tensor words in `S.Obj`. -/
abbrev PresentedBraided : Type u :=
  CategoryTheory.Quotient (HomRel.MonoidalClosure R)

namespace PresentedBraided

variable {S}

/-- The quotient functor from the free braided monoidal category on `S` onto the braided monoidal
category presented by `S` and `R`. It is strict monoidal and braided for the descended
structure. -/
abbrev quotientFunctor : S.FreeBraided ⥤ S.PresentedBraided R :=
  CategoryTheory.Quotient.functor _

variable {R}

/-- The equations `R` hold in the presented braided monoidal category. -/
theorem sound {X Y : S.FreeBraided} {f g : X ⟶ Y} (h : R f g) :
    (quotientFunctor R).map f = (quotientFunctor R).map g :=
  CategoryTheory.Quotient.sound _ (.of h)

section Lift

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D] [BraidedCategory D]
  (fo : S.Obj → D)
  (fc : ∀ g : S.Coupon,
    FreeMonoidalCategory.projectObj fo (S.src g) ⟶ FreeMonoidalCategory.projectObj fo (S.tgt g))
  (h : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R f g →
    (FreeBraided.lift fo fc).map f = (FreeBraided.lift fo fc).map g)

/-- The strong braided functor out of the braided monoidal category presented by `S` and `R`
determined by the images `fo` of the generating objects and `fc` of the coupons, provided the
induced interpretation of `S.FreeBraided` satisfies `R`. Its tensorator and unit comparison are
identities. -/
-- Exposed so that object expressions `(lift fo fc h).obj X` reduce to tensor products in `D`,
-- matching `FreeBraided.lift` and `Presented.lift`.
@[expose] def lift : S.PresentedBraided R ⥤ D :=
  CategoryTheory.Quotient.lift _ (FreeBraided.lift fo fc) fun _ _ _ _ hfg ↦
    HomRel.MonoidalClosure.map_eq h hfg

instance : (lift fo fc h).Monoidal :=
  CategoryTheory.Quotient.liftMonoidal _ _

noncomputable instance : (lift fo fc h).Braided :=
  CategoryTheory.Quotient.liftBraided _ _ _

/-- The functor `lift fo fc h` restricts along the quotient functor to `FreeBraided.lift fo fc`. -/
theorem quotientFunctor_comp_lift :
    quotientFunctor R ⋙ lift fo fc h = FreeBraided.lift fo fc :=
  CategoryTheory.Quotient.lift_spec _ _ _

@[simp]
theorem lift_obj (X : S.FreeBraided) :
    (lift fo fc h).obj ((quotientFunctor R).obj X) = (FreeBraided.lift fo fc).obj X :=
  rfl

@[simp]
theorem lift_map {X Y : S.FreeBraided} (f : X ⟶ Y) :
    (lift fo fc h).map ((quotientFunctor R).map f) = (FreeBraided.lift fo fc).map f :=
  rfl

@[simp]
theorem lift_ε : Functor.LaxMonoidal.ε (lift fo fc h) = 𝟙 _ :=
  (CategoryTheory.Quotient.lift_ε _ _).trans (FreeBraided.lift_ε fo fc)

@[simp]
theorem lift_η : Functor.OplaxMonoidal.η (lift fo fc h) = 𝟙 _ :=
  (CategoryTheory.Quotient.lift_η _ _).trans (FreeBraided.lift_η fo fc)

@[simp]
theorem lift_μ (X Y : S.PresentedBraided R) :
    Functor.LaxMonoidal.μ (lift fo fc h) X Y = 𝟙 _ :=
  (CategoryTheory.Quotient.lift_μ _ _ X.as Y.as).trans (FreeBraided.lift_μ fo fc X.as Y.as)

@[simp]
theorem lift_δ (X Y : S.PresentedBraided R) :
    Functor.OplaxMonoidal.δ (lift fo fc h) X Y = 𝟙 _ :=
  (CategoryTheory.Quotient.lift_δ _ _ X.as Y.as).trans (FreeBraided.lift_δ fo fc X.as Y.as)

end Lift

section Uniqueness

variable {D : Type u'} [Category.{v'} D] [MonoidalCategory D]

/-- A monoidal natural transformation from a strong monoidal functor out of a presented braided
monoidal category to a lax monoidal functor is determined by its components at the generating
objects. -/
theorem natTrans_ext {F G : S.PresentedBraided R ⥤ D} [F.Monoidal] [G.LaxMonoidal] {α β : F ⟶ G}
    [NatTrans.IsMonoidal α] [NatTrans.IsMonoidal β]
    (h : ∀ a, α.app ((quotientFunctor R).obj (.of a)) = β.app ((quotientFunctor R).obj (.of a))) :
    α = β :=
  CategoryTheory.Quotient.natTrans_ext _ _ (FreeBraided.natTrans_ext h)

variable [BraidedCategory D] (F G : S.PresentedBraided R ⥤ D) [F.Braided] [G.Braided]
  (e : ∀ a, F.obj ((quotientFunctor R).obj (.of a)) ≅ G.obj ((quotientFunctor R).obj (.of a)))

/-- Two strong braided functors out of the braided monoidal category presented by `S` and `R` that
agree up to isomorphisms `e` on the generating objects, compatibly with every coupon, are
isomorphic by a monoidal natural isomorphism extending `e`. -/
noncomputable def monoidalNatIso
    (he : ∀ g, F.map ((quotientFunctor R).map (FreeBraided.coupon g)) ≫
        (FreeBraided.wordIso (quotientFunctor R ⋙ F) (quotientFunctor R ⋙ G) e (S.tgt g)).hom =
      (FreeBraided.wordIso (quotientFunctor R ⋙ F) (quotientFunctor R ⋙ G) e (S.src g)).hom ≫
        G.map ((quotientFunctor R).map (FreeBraided.coupon g))) :
    F ≅ G :=
  CategoryTheory.Quotient.natIsoLift _
    (FreeBraided.monoidalNatIso (quotientFunctor R ⋙ F) (quotientFunctor R ⋙ G) e he)

variable {F G e}
  (he : ∀ g, F.map ((quotientFunctor R).map (FreeBraided.coupon g)) ≫
      (FreeBraided.wordIso (quotientFunctor R ⋙ F) (quotientFunctor R ⋙ G) e (S.tgt g)).hom =
    (FreeBraided.wordIso (quotientFunctor R ⋙ F) (quotientFunctor R ⋙ G) e (S.src g)).hom ≫
      G.map ((quotientFunctor R).map (FreeBraided.coupon g)))

@[simp]
theorem monoidalNatIso_hom_app (X : S.FreeBraided) :
    (monoidalNatIso F G e he).hom.app ((quotientFunctor R).obj X) =
      (FreeBraided.wordIso (quotientFunctor R ⋙ F) (quotientFunctor R ⋙ G) e X.word).hom :=
  FreeBraided.monoidalNatIso_hom_app he X

theorem monoidalNatIso_hom_app_of (a : S.Obj) :
    (monoidalNatIso F G e he).hom.app ((quotientFunctor R).obj (.of a)) = (e a).hom :=
  FreeBraided.monoidalNatIso_hom_app_of he a

instance : NatTrans.IsMonoidal (monoidalNatIso F G e he).hom :=
  inferInstanceAs (NatTrans.IsMonoidal
    (CategoryTheory.Quotient.natTransLift _
      (FreeBraided.monoidalNatIso (quotientFunctor R ⋙ F) (quotientFunctor R ⋙ G) e he).hom))

end Uniqueness

section Substitution

variable {T : TensorSignature.{u', v'}} {U : TensorSignature.{u'', v''}}

/-- A braided substitution between tensor signatures descends to a strong braided functor between
presented braided monoidal categories whenever it identifies all equations of `R₁` in the target
presentation `T.PresentedBraided R₂`. -/
@[expose] def mapSubstitution (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g)) :
    S.PresentedBraided R₁ ⥤ T.PresentedBraided R₂ :=
  CategoryTheory.Quotient.lift _ (σ.toFunctor ⋙ quotientFunctor R₂) fun _ _ _ _ hfg ↦
    HomRel.MonoidalClosure.map_eq (F := σ.toFunctor ⋙ quotientFunctor R₂) hσ hfg

instance (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g)) :
    (mapSubstitution σ hσ).Monoidal :=
  CategoryTheory.Quotient.liftMonoidal _ _

noncomputable instance (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g)) :
    (mapSubstitution σ hσ).Braided :=
  CategoryTheory.Quotient.liftBraided _ _ _

/-- The descended substitution functor commutes with the quotient functors on the nose. -/
theorem quotientFunctor_comp_mapSubstitution (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g)) :
    quotientFunctor R₁ ⋙ mapSubstitution σ hσ = σ.toFunctor ⋙ quotientFunctor R₂ :=
  CategoryTheory.Quotient.lift_spec _ _ _

@[simp]
theorem mapSubstitution_obj (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g))
    (X : S.FreeBraided) :
    (mapSubstitution σ hσ).obj ((quotientFunctor R₁).obj X) =
      (quotientFunctor R₂).obj (σ.toFunctor.obj X) :=
  rfl

@[simp]
theorem mapSubstitution_map (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g))
    {X Y : S.FreeBraided} (f : X ⟶ Y) :
    (mapSubstitution σ hσ).map ((quotientFunctor R₁).map f) =
      (quotientFunctor R₂).map (σ.toFunctor.map f) :=
  rfl

@[simp]
theorem mapSubstitution_ε (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g)) :
    Functor.LaxMonoidal.ε (mapSubstitution σ hσ) = 𝟙 _ := by
  refine (CategoryTheory.Quotient.lift_ε _ _).trans ?_
  simp only [Functor.LaxMonoidal.comp_ε, CategoryTheory.Quotient.functor_ε,
    FreeBraided.Substitution.toFunctor_ε, Category.id_comp]
  exact (quotientFunctor R₂).map_id _

@[simp]
theorem mapSubstitution_η (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g)) :
    Functor.OplaxMonoidal.η (mapSubstitution σ hσ) = 𝟙 _ := by
  refine (CategoryTheory.Quotient.lift_η _ _).trans ?_
  simp only [Functor.OplaxMonoidal.comp_η, CategoryTheory.Quotient.functor_η,
    FreeBraided.Substitution.toFunctor_η, Category.comp_id]
  exact (quotientFunctor R₂).map_id _

@[simp]
theorem mapSubstitution_μ (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g))
    (X Y : S.PresentedBraided R₁) :
    Functor.LaxMonoidal.μ (mapSubstitution σ hσ) X Y = 𝟙 _ := by
  refine (CategoryTheory.Quotient.lift_μ _ _ X.as Y.as).trans ?_
  simp only [Functor.LaxMonoidal.comp_μ, CategoryTheory.Quotient.functor_μ,
    FreeBraided.Substitution.toFunctor_μ]
  exact (Category.id_comp _).trans ((quotientFunctor R₂).map_id _)

@[simp]
theorem mapSubstitution_δ (σ : FreeBraided.Substitution S T)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g))
    (X Y : S.PresentedBraided R₁) :
    Functor.OplaxMonoidal.δ (mapSubstitution σ hσ) X Y = 𝟙 _ := by
  refine (CategoryTheory.Quotient.lift_δ _ _ X.as Y.as).trans ?_
  simp only [Functor.OplaxMonoidal.comp_δ, CategoryTheory.Quotient.functor_δ,
    FreeBraided.Substitution.toFunctor_δ, Category.comp_id]
  exact (quotientFunctor R₂).map_id _

/-- Descending the identity braided substitution yields the identity functor on a presented braided
monoidal category. -/
@[simp]
theorem mapSubstitution_id {R : HomRel S.FreeBraided}
    (h : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R f g →
      (quotientFunctor R).map ((FreeBraided.Substitution.id S).toFunctor.map f) =
        (quotientFunctor R).map ((FreeBraided.Substitution.id S).toFunctor.map g)) :
    mapSubstitution (FreeBraided.Substitution.id S) h = 𝟭 (S.PresentedBraided R) := by
  refine CategoryTheory.Quotient.lift_unique' _ _ _ ?_
  rw [quotientFunctor_comp_mapSubstitution, FreeBraided.Substitution.toFunctor_id,
    Functor.id_comp, Functor.comp_id]

/-- Descending a composite braided substitution agrees with composing the descended functors. -/
theorem mapSubstitution_comp (σ : FreeBraided.Substitution S T) (τ : FreeBraided.Substitution T U)
    {R₁ : HomRel S.FreeBraided} {R₂ : HomRel T.FreeBraided} {R₃ : HomRel U.FreeBraided}
    (hσ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₂).map (σ.toFunctor.map f) =
        (quotientFunctor R₂).map (σ.toFunctor.map g))
    (hτ : ∀ ⦃X Y : T.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₂ f g →
      (quotientFunctor R₃).map (τ.toFunctor.map f) =
        (quotientFunctor R₃).map (τ.toFunctor.map g))
    (hστ : ∀ ⦃X Y : S.FreeBraided⦄ ⦃f g : X ⟶ Y⦄, R₁ f g →
      (quotientFunctor R₃).map ((σ.comp τ).toFunctor.map f) =
        (quotientFunctor R₃).map ((σ.comp τ).toFunctor.map g)) :
    mapSubstitution (σ.comp τ) hστ = mapSubstitution σ hσ ⋙ mapSubstitution τ hτ := by
  refine CategoryTheory.Quotient.lift_unique' _ _ _ ?_
  rw [quotientFunctor_comp_mapSubstitution, FreeBraided.Substitution.toFunctor_comp,
    Functor.assoc, ← Functor.assoc (F := quotientFunctor R₁),
    quotientFunctor_comp_mapSubstitution, Functor.assoc, quotientFunctor_comp_mapSubstitution]

end Substitution

end PresentedBraided

end TauCeti.TensorSignature
