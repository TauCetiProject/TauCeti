module

public import Mathlib.GroupTheory.PresentedGroup
public import TauCeti.CategoryTheory.Semisimple.Basic
public import TauCeti.CategoryTheory.Simple.Rigid

/-!
# The universal group of the fusion rules

The universal grading group is generated by the isomorphism classes of simple objects, with
`[S] * [T] = [U]` whenever there is a nonzero morphism `U ⟶ S ⊗ T`. In a semisimple category
these are precisely the simple constituents of the tensor product. This description uses
neither a coefficient field nor a splitness assumption on the endomorphisms of simple objects.

`TauCeti.universalGradingGroup.liftEquiv` expresses the universal property: homomorphisms from
the group to `G` are exactly the assignments of degrees to simple objects compatible with
these tensor constituents. If the category is rigid and finite semisimple with simple unit,
every group element is the degree of a simple object. In particular the group is finite if
there are only finitely many simple classes.

This file constructs the group and its universal degree assignment. It does not identify
the objects of neutral degree with the adjoint subcategory.

## References

* V. Drinfeld, S. Gelaki, D. Nikshych, V. Ostrik, *On braided fusion categories I*,
  Selecta Math. **16** (2010), §2.3
* [P. Etingof, S. Gelaki, D. Nikshych, V. Ostrik, *Tensor categories*][egno15], §4.14
-/

public section

noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory

universe v u w

namespace TauCeti

section Presentation

variable (C : Type u) [Category.{v} C] [HasZeroMorphisms C] [MonoidalCategory C]

/-- The group generated by simple classes, subject to the tensor-constituent relations
`[S] * [T] = [U]` for every nonzero morphism `U.repr ⟶ S.repr ⊗ T.repr`. -/
abbrev universalGradingGroup :=
  PresentedGroup {r : FreeGroup (SimpleClasses C) |
    ∃ (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr),
      f ≠ 0 ∧ r = FreeGroup.of S * FreeGroup.of T * (FreeGroup.of U)⁻¹}


namespace universalGradingGroup

variable {C}

/-- The universal degree of a simple isomorphism class. -/
def degree (S : SimpleClasses C) : universalGradingGroup C := PresentedGroup.of S

/-- Every simple constituent of a tensor product has the product of the degrees. -/
theorem degree_mul (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr) (hf : f ≠ 0) :
    degree U = degree S * degree T := by
  apply Eq.symm
  apply eq_of_mul_inv_eq_one
  have h : PresentedGroup.mk _
      (FreeGroup.of S * FreeGroup.of T * (FreeGroup.of U)⁻¹) =
        (1 : universalGradingGroup C) :=
    PresentedGroup.one_of_mem ⟨S, T, U, f, hf, rfl⟩
  simpa only [degree, PresentedGroup.of, map_mul, map_inv] using h

variable {G : Type w} [Group G]

/-- Extend an assignment of degrees satisfying the tensor-constituent relations to a group
homomorphism from the universal grading group. -/
def lift (d : SimpleClasses C → G)
    (hd : ∀ (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr),
      f ≠ 0 → d U = d S * d T) : universalGradingGroup C →* G :=
  PresentedGroup.toGroup (f := d) <| by
    rintro r ⟨S, T, U, f, hf, rfl⟩
    simp [hd S T U f hf]

/-- The extension recovers the prescribed degrees. -/
@[simp]
theorem lift_degree (d : SimpleClasses C → G) (hd) (S : SimpleClasses C) :
    lift d hd (degree S) = d S := PresentedGroup.toGroup.of _

/-- Homomorphisms out of the universal grading group are determined by simple degrees. -/
@[ext]
theorem hom_ext {f g : universalGradingGroup C →* G}
    (h : ∀ S, f (degree S) = g (degree S)) : f = g := PresentedGroup.ext h

/-- The universal property of the grading group: maps from it correspond to assignments of
degrees to simple objects respecting every tensor constituent. -/
def liftEquiv :
    {d : SimpleClasses C → G //
      ∀ (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr),
        f ≠ 0 → d U = d S * d T} ≃ (universalGradingGroup C →* G) where
  toFun d := lift d.1 d.2
  invFun f := ⟨fun S ↦ f (degree S), fun S T U g hg ↦ by
    dsimp only
    rw [degree_mul S T U g hg, map_mul]⟩
  left_inv d := by ext S; simp
  right_inv f := hom_ext fun S ↦ by simp

/-- The universal-property equivalence sends a degree assignment to its extension. -/
@[simp]
theorem liftEquiv_apply (d) : (liftEquiv (C := C) (G := G)) d = lift d.1 d.2 := (rfl)

/-- The inverse universal-property equivalence restricts a homomorphism to simple degrees. -/
@[simp]
theorem liftEquiv_symm_apply (f : universalGradingGroup C →* G) (S : SimpleClasses C) :
    ((liftEquiv (C := C) (G := G)).symm f).1 S = f (degree S) := (rfl)

end universalGradingGroup

end Presentation

namespace universalGradingGroup

section Unit

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [MonoidalCategory C]
  [Simple (𝟙_ C)]

/-- The tensor unit has neutral universal degree. -/
@[simp]
theorem degree_unit : degree (SimpleClasses.classOf (𝟙_ C)) = 1 := by
  let I := SimpleClasses.classOf (𝟙_ C)
  let e := SimpleClasses.classOfReprIso (𝟙_ C)
  let a : I.repr ≅ I.repr ⊗ I.repr := e ≪≫ (λ_ (𝟙_ C)).symm ≪≫ (e.symm ⊗ᵢ e.symm)
  have ha : a.hom ≠ 0 := by
    intro h
    exact id_nonzero I.repr (by rw [← a.hom_inv_id, h, zero_comp])
  have h := degree_mul I I I a.hom ha
  exact (mul_eq_left.mp h.symm)

end Unit

section Rigid

variable {C : Type u} [Category.{v} C] [Abelian C] [MonoidalCategory C]
  [MonoidalPreadditive C] [RigidCategory C] [Simple (𝟙_ C)]

/-- Dual simple objects have inverse universal degrees. -/
@[simp]
theorem degree_dual (S : SimpleClasses C) : degree S.dual = (degree S)⁻¹ := by
  let e := SimpleClasses.classOfReprIso (𝟙_ C)
  let t := whiskerLeftIso S.repr (SimpleClasses.dualReprIso S).symm
  have hf : e.hom ≫ η_ S.repr S.reprᘁ ≫ t.hom ≠ 0 := by
    intro hf
    apply coevaluation_ne_zero (Y := S.reprᘁ) (Simple.not_isZero S.repr)
    apply (cancel_epi e.hom).mp
    apply (cancel_mono t.hom).mp
    simpa only [Category.assoc, comp_zero, zero_comp] using hf
  have h := degree_mul S S.dual (SimpleClasses.classOf (𝟙_ C)) _ hf
  rw [degree_unit] at h
  exact eq_inv_of_mul_eq_one_right h.symm

variable [IsFiniteSemisimpleCategory C]

/-- Every element of the universal grading group is the degree of a simple object. Thus the
universal assignment is faithful, rather than merely generating its target group. -/
theorem degree_surjective :
    Function.Surjective (degree : SimpleClasses C → universalGradingGroup C) := by
  -- The degrees contain the identity, are closed under inverses by duality, and are closed
  -- under multiplication because a tensor product of nonzero objects is nonzero.
  let H : Subgroup (universalGradingGroup C) :=
    { carrier := Set.range degree
      one_mem' := ⟨SimpleClasses.classOf (𝟙_ C), degree_unit⟩
      inv_mem' := by
        rintro _ ⟨S, rfl⟩
        exact ⟨S.dual, degree_dual S⟩
      mul_mem' := by
        rintro _ _ ⟨S, rfl⟩ ⟨T, rfl⟩
        obtain ⟨ι, hι, a, ha, hba, ⟨e⟩⟩ :=
          IsFiniteSemisimpleCategory.exists_biproduct_simples (S.repr ⊗ T.repr)
        let := hι
        let := ha
        let := hba
        have hi : Nonempty ι := by
          by_contra h
          have : IsEmpty ι := not_nonempty_iff.mp h
          have hz : IsZero (⨁ a) := (IsZero.iff_id_eq_zero _).2 (by ext i; exact isEmptyElim i)
          exact not_isZero_tensorObj (Simple.not_isZero S.repr) (Simple.not_isZero T.repr)
            (hz.of_iso e)
        obtain ⟨i⟩ := hi
        let b := SimpleClasses.classOfReprIso (a i)
        have hf : b.hom ≫ biproduct.ι a i ≫ e.inv ≠ 0 := by
          intro h
          have h' := b.inv ≫= h =≫ (e.hom ≫ biproduct.π a i)
          exact id_nonzero (a i) (by simpa using h')
        exact ⟨SimpleClasses.classOf (a i), degree_mul S T _ _ hf⟩ }
  intro x
  exact PresentedGroup.generated_by _ H (fun S ↦ ⟨S, rfl⟩) x

/-- Finitely many simple classes give a finite universal grading group. -/
instance [Finite (SimpleClasses C)] : Finite (universalGradingGroup C) :=
  Finite.of_surjective degree degree_surjective

end Rigid

end universalGradingGroup

end TauCeti
