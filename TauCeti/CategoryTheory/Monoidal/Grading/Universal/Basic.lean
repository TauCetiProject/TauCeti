module

public import Mathlib.CategoryTheory.Monoidal.Category
public import Mathlib.GroupTheory.PresentedGroup
public import TauCeti.CategoryTheory.Simple.Classes

/-!
# The universal group of the fusion rules

The universal grading group is generated by the isomorphism classes of simple objects, with
`[S] * [T] = [U]` whenever there is a nonzero morphism `U ⟶ S ⊗ T`. In a semisimple category
these are precisely the simple constituents of the tensor product. This description uses
neither a coefficient field nor a splitness assumption on the endomorphisms of simple objects.

`TauCeti.universalGradingGroup.liftEquiv` (and `liftEquivOfIsUnit` for arbitrary monoid targets)
expresses the universal property: homomorphisms from the group to `G` are exactly the assignments
of degrees to simple objects compatible with these tensor constituents. Duality and rigidity
results (`degree_classOf_of_exactPairing`, `degree_dual`, `degree_surjective`) live in
`TauCeti/CategoryTheory/Monoidal/Grading/Universal/Rigid.lean`.

## References

* V. Drinfeld, S. Gelaki, D. Nikshych, V. Ostrik, *On braided fusion categories I*,
  Selecta Math. **16** (2010), §2.3
* [P. Etingof, S. Gelaki, D. Nikshych, V. Ostrik, *Tensor categories*][egno15], §4.14
-/

public section

noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory

universe v u w

namespace TauCeti

section Presentation

variable (C : Type u) [Category.{v} C] [HasZeroMorphisms C] [MonoidalCategory C]

/-- The group generated by simple classes, subject to the tensor-constituent relations
`[S] * [T] = [U]` for every nonzero morphism `U.repr ⟶ S.repr ⊗ T.repr`. -/
abbrev universalGradingGroup :=
  PresentedGroup {r : FreeGroup (SimpleClasses C) |
    ∃ (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr),
      f ≠ 0 ∧ r = FreeGroup.of S * FreeGroup.of T * (FreeGroup.of U)⁻¹}

namespace universalGradingGroup

variable {C}

/-- The universal degree of a simple isomorphism class. -/
def degree (S : SimpleClasses C) : universalGradingGroup C := PresentedGroup.of S

/-- Every simple constituent of a tensor product has the product of the degrees. -/
theorem degree_mul (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr) (hf : f ≠ 0) :
    degree U = degree S * degree T := by
  symm; simp only [degree, PresentedGroup.of, ← map_mul]
  exact PresentedGroup.mk_eq_mk_of_mul_inv_mem ⟨S, T, U, f, hf, rfl⟩

/-- A simple constituent of a tensor product of simple objects has the product of their degrees.
This is `degree_mul` for arbitrary simple objects rather than chosen representatives. -/
theorem degree_classOf_eq_mul {X Y U : C} [Simple X] [Simple Y] [Simple U] (f : U ⟶ X ⊗ Y)
    (hf : f ≠ 0) : degree (SimpleClasses.classOf U) =
      degree (SimpleClasses.classOf X) * degree (SimpleClasses.classOf Y) := by
  let e := SimpleClasses.classOfReprIso U
  let t := SimpleClasses.classOfReprIso X ⊗ᵢ SimpleClasses.classOfReprIso Y
  refine degree_mul _ _ _ (e.hom ≫ f ≫ t.inv) fun h ↦ hf ?_; simpa using e.inv ≫= h =≫ t.hom

/-- A simple object admitting a nonzero morphism into its tensor square has neutral universal
degree. -/
theorem degree_classOf_eq_one_of_hom_tensor_self_ne_zero {X : C} [Simple X] {f : X ⟶ X ⊗ X}
    (hf : f ≠ 0) : degree (SimpleClasses.classOf X) = 1 :=
  mul_eq_left.mp (degree_classOf_eq_mul f hf).symm

/-- If `U`, `X`, and `Y` are simple objects with a nonzero morphism `U ⟶ X ⊗ Y` and `U` has
neutral universal degree, then the degree of `Y` is the inverse of the degree of `X`. -/
theorem degree_classOf_eq_inv_of_hom_ne_zero {X Y U : C} [Simple X] [Simple Y] [Simple U]
    (hU : degree (SimpleClasses.classOf U) = 1) {f : U ⟶ X ⊗ Y} (hf : f ≠ 0) :
    degree (SimpleClasses.classOf Y) = (degree (SimpleClasses.classOf X))⁻¹ := by
  have h := degree_classOf_eq_mul f hf
  rw [hU] at h
  exact eq_inv_of_mul_eq_one_right h.symm

/-- Homomorphisms out of the universal grading group into any monoid are determined by simple
degrees. -/
@[ext] theorem hom_ext {G : Type w} [Monoid G] {f g : universalGradingGroup C →* G}
    (h : ∀ S, f (degree S) = g (degree S)) : f = g := by
  have h' : f.toHomUnits = g.toHomUnits := PresentedGroup.ext fun S ↦ Units.ext (h S)
  ext x; exact congrArg Units.val (DFunLike.congr_fun h' x)

section Monoid

variable {M : Type w} [Monoid M]

/-- Extend an assignment of invertible degrees in a monoid `M` satisfying the tensor-constituent
relations to a monoid homomorphism from the universal grading group. -/
def liftOfIsUnit (d : SimpleClasses C → M) (hu : ∀ S, IsUnit (d S))
    (hd : ∀ (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr),
      f ≠ 0 → d U = d S * d T) : universalGradingGroup C →* M :=
  (Units.coeHom M).comp <| PresentedGroup.toGroup (f := fun S ↦ (hu S).unit) <| by
    rintro r ⟨S, T, U, f, hf, rfl⟩; apply Units.ext; simp [hd S T U f hf]

/-- The monoid extension recovers the prescribed degrees. -/
@[simp] theorem liftOfIsUnit_degree (d : SimpleClasses C → M) (hu) (hd) (S : SimpleClasses C) :
    liftOfIsUnit d hu hd (degree S) = d S := by simp [liftOfIsUnit, degree]

/-- The universal property of the grading group for monoid targets: homomorphisms into `M`
correspond to assignments of invertible degrees to simple objects respecting every tensor
constituent. -/
def liftEquivOfIsUnit : {d : SimpleClasses C → M // (∀ S, IsUnit (d S)) ∧
    ∀ (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr), f ≠ 0 → d U = d S * d T} ≃
      (universalGradingGroup C →* M) where
  toFun d := liftOfIsUnit d.val d.property.1 d.property.2
  invFun f := ⟨fun S ↦ f (degree S), fun S ↦ (Group.isUnit (degree S)).map f,
    fun S T U g hg ↦ by dsimp only; rw [degree_mul S T U g hg, map_mul]⟩
  left_inv d := by ext S; simp
  right_inv f := hom_ext fun S ↦ by simp

/-- The monoid universal-property equivalence sends a degree assignment to its extension. -/
@[simp] theorem liftEquivOfIsUnit_apply (d) :
    (liftEquivOfIsUnit (C := C) (M := M)) d = liftOfIsUnit d.val d.property.1 d.property.2 := (rfl)
/-- The inverse monoid universal-property equivalence restricts a homomorphism to simple degrees. -/
@[simp] theorem liftEquivOfIsUnit_symm_apply (f : universalGradingGroup C →* M)
    (S : SimpleClasses C) : ((liftEquivOfIsUnit (C := C) (M := M)).symm f).val S = f (degree S) :=
  (rfl)

end Monoid

section Group

variable {G : Type w} [Group G]

/-- Extend an assignment of degrees satisfying the tensor-constituent relations to a group
homomorphism from the universal grading group. -/
def lift (d : SimpleClasses C → G) (hd : ∀ (S T U : SimpleClasses C)
    (f : U.repr ⟶ S.repr ⊗ T.repr), f ≠ 0 → d U = d S * d T) : universalGradingGroup C →* G :=
  liftOfIsUnit d (fun S ↦ Group.isUnit (d S)) hd
/-- The extension recovers the prescribed degrees. -/
@[simp] theorem lift_degree (d : SimpleClasses C → G) (hd) (S : SimpleClasses C) :
    lift d hd (degree S) = d S := liftOfIsUnit_degree d _ hd S

/-- The universal property of the grading group: maps from it correspond to assignments of
degrees to simple objects respecting every tensor constituent. -/
def liftEquiv : {d : SimpleClasses C → G //
    ∀ (S T U : SimpleClasses C) (f : U.repr ⟶ S.repr ⊗ T.repr), f ≠ 0 → d U = d S * d T} ≃
      (universalGradingGroup C →* G) :=
  (Equiv.subtypeEquivRight fun d ↦
    ⟨fun h ↦ ⟨fun S ↦ Group.isUnit (d S), h⟩, fun h ↦ h.2⟩).trans liftEquivOfIsUnit
/-- The universal-property equivalence sends a degree assignment to its extension. -/
@[simp] theorem liftEquiv_apply (d) :
    (liftEquiv (C := C) (G := G)) d = lift d.val d.property := (rfl)
/-- The inverse universal-property equivalence restricts a homomorphism to simple degrees. -/
@[simp] theorem liftEquiv_symm_apply (f : universalGradingGroup C →* G) (S : SimpleClasses C) :
    ((liftEquiv (C := C) (G := G)).symm f).val S = f (degree S) := (rfl)

end Group

end universalGradingGroup

end Presentation

namespace universalGradingGroup

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [MonoidalCategory C] [Simple (𝟙_ C)]

/-- The tensor unit has neutral universal degree. -/
@[simp] theorem degree_unit : degree (SimpleClasses.classOf (𝟙_ C)) = 1 :=
  degree_classOf_eq_one_of_hom_tensor_self_ne_zero (f := (λ_ (𝟙_ C)).inv) fun h ↦
    CategoryTheory.id_ne_zero (𝟙_ C) (by rw [← (λ_ (𝟙_ C)).inv_hom_id, h, zero_comp])

end universalGradingGroup

end TauCeti
