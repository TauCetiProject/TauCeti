/-!
# The adjoint subcategory is the neutral component of the universal grading

The **adjoint subcategory** `C_ad` of a rigid monoidal category is generated by the objects
`X ⊗ Xᘁ` for *simple* `X`. On simple isomorphism classes it is described by
`TauCeti.SimpleClasses.IsAdjoint`: the smallest set of simple classes containing every simple
constituent of `X ⊗ Xᘁ` for a simple `X`, and every simple constituent of `A ⊗ B` for adjoint
`A` and `B`. Here, as in the presentation of `TauCeti.universalGradingGroup`, a simple constituent
of an object `Y` is a simple object with a nonzero morphism to `Y`.

In a finite semisimple rigid category with simple tensor unit, the adjoint classes are exactly
the simple classes of neutral universal degree (`TauCeti.universalGradingGroup.degree_eq_one_iff`).
More precisely, two simple objects `S` and `T` have the same universal degree exactly when `S` is
a constituent of `T ⊗ A` for some adjoint simple `A`
(`TauCeti.universalGradingGroup.degree_eq_degree_iff`): the homogeneous components of the
universal grading are the right cosets of the adjoint subcategory.

## Main declarations

* `TauCeti.SimpleClasses.IsAdjoint`: the simple classes of the adjoint subcategory;
* `TauCeti.SimpleClasses.IsAdjoint.dual`: the adjoint classes are closed under duality;
* `TauCeti.SimpleClasses.isAdjoint_dual_iff`: a simple class is adjoint exactly when its dual is;
* `TauCeti.universalGradingGroup.degree_eq_degree_iff`: two simple classes have the same
  universal degree exactly when they lie in the same right coset of the adjoint subcategory;
* `TauCeti.universalGradingGroup.degree_eq_one_iff`: the simple classes of neutral universal
  degree are exactly the adjoint ones.

## Implementation notes

Adjoint classes have neutral degree since `X ⊗ Xᘁ` has degree `deg X * (deg X)⁻¹ = 1`. For the
converse, a simple `S` permutes the right cosets of the adjoint subcategory by sending the coset of
`T` to the coset of any simple constituent of `S ⊗ T`. This is well defined because `Tᘁ ⊗ T`, like
`T ⊗ Tᘁ`, has only adjoint constituents. These permutations satisfy the defining relations of the
universal grading group, so a simple of neutral degree fixes the coset of the unit, which places
it in the adjoint subcategory. The argument does not use that the adjoint subcategory is stable
under conjugation `A ↦ X ⊗ A ⊗ Xᘁ`.

## References

* S. Gelaki, D. Nikshych, *Nilpotent fusion categories*, Adv. Math. **217** (2008), §3
* V. Drinfeld, S. Gelaki, D. Nikshych, V. Ostrik, *On braided fusion categories I*,
  Selecta Math. **16** (2010), §2.3
* [P. Etingof, S. Gelaki, D. Nikshych, V. Ostrik, *Tensor categories*][egno15], §4.14
-/

public section

noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory

universe v u

namespace TauCeti

namespace SimpleClasses

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [MonoidalCategory C]
  [RightRigidCategory C]

/-- The simple classes of the **adjoint subcategory**: the smallest set of simple classes
containing every simple constituent of `X ⊗ Xᘁ` for a simple `X`, and every simple constituent of
a tensor product of two adjoint classes. A simple constituent `U` of `Y` is witnessed by a nonzero
morphism `U.repr ⟶ Y`. -/
inductive IsAdjoint : SimpleClasses C → Prop
  /-- Every simple constituent of `X ⊗ Xᘁ`, for `X` simple, is adjoint. -/
  | of_tensor_rightDual (X U : SimpleClasses C) (f : U.repr ⟶ X.repr ⊗ X.reprᘁ) :
      f ≠ 0 → IsAdjoint U
  /-- Every simple constituent of a tensor product of adjoint classes is adjoint. -/
  | of_tensor (A B U : SimpleClasses C) (f : U.repr ⟶ A.repr ⊗ B.repr) :
      IsAdjoint A → IsAdjoint B → f ≠ 0 → IsAdjoint U

end SimpleClasses

namespace AdjointGrading

/-! ### Simple constituents in a finite semisimple category

The lemmas below restate the general facts of `TauCeti/CategoryTheory/Semisimple/Monoidal.lean`
and `TauCeti/CategoryTheory/Semisimple/Rigid.lean` for the predicate `Occurs` and for simple
classes. -/

section Semisimple

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- `U` is a constituent of `Y`: there is a nonzero morphism `U ⟶ Y`. -/
private def Occurs (U Y : C) : Prop := ∃ f : U ⟶ Y, f ≠ 0

private theorem Occurs.of_iso_left {U U' Y : C} (e : U ≅ U') (h : Occurs U' Y) : Occurs U Y := by
  obtain ⟨f, hf⟩ := h
  exact ⟨e.hom ≫ f, fun h ↦ hf (by simpa using e.inv ≫= h)⟩

private theorem Occurs.of_iso_right {U Y Y' : C} (e : Y ≅ Y') (h : Occurs U Y) : Occurs U Y' := by
  obtain ⟨f, hf⟩ := h
  exact ⟨f ≫ e.hom, fun h ↦ hf (by simpa using h =≫ e.inv)⟩

/-- A simple object is a constituent of itself. -/
private theorem occurs_self (U : C) [Simple U] : Occurs U U := ⟨𝟙 U, id_ne_zero U⟩

variable [IsFiniteSemisimpleCategory C]

/-- A nonzero object has a simple constituent. -/
private theorem exists_occurs {Y : C} (hY : ¬IsZero Y) :
    ∃ W : SimpleClasses C, Occurs W.repr Y := by
  obtain ⟨S, _, f, hf⟩ := exists_simple_hom_ne_zero hY
  exact ⟨SimpleClasses.classOf S, Occurs.of_iso_left (SimpleClasses.classOfReprIso S) ⟨f, hf⟩⟩

variable [MonoidalCategory C]

/-- Replacing a simple factor of a tensor product by an object containing it. -/
private theorem Occurs.whiskerRight {U X X' : C} [Simple X] {Y : C} (h : Occurs U (X ⊗ Y))
    (h' : Occurs X X') : Occurs U (X' ⊗ Y) := by
  obtain ⟨f, hf⟩ := h
  obtain ⟨g, hg⟩ := h'
  exact ⟨_, comp_whiskerRight_ne_zero hf hg⟩

/-- Replacing a simple factor of a tensor product by an object containing it. -/
private theorem Occurs.whiskerLeft {U X : C} {Y Y' : C} [Simple Y] (h : Occurs U (X ⊗ Y))
    (h' : Occurs Y Y') : Occurs U (X ⊗ Y') := by
  obtain ⟨f, hf⟩ := h
  obtain ⟨g, hg⟩ := h'
  exact ⟨_, comp_whiskerLeft_ne_zero hf hg⟩

variable [MonoidalPreadditive C]

/-- A simple constituent of `X ⊗ Y` is a constituent of `W ⊗ Y` for some simple constituent `W`
of `X`. -/
private theorem Occurs.exists_left {U X Y : C} (h : Occurs U (X ⊗ Y)) :
    ∃ W : SimpleClasses C, Occurs U (W.repr ⊗ Y) ∧ Occurs W.repr X := by
  obtain ⟨f, hf⟩ := h
  obtain ⟨W, _, g, j, hg, hj⟩ := exists_simple_of_nonzero_to_tensor_left hf
  exact ⟨SimpleClasses.classOf W,
    Occurs.of_iso_right (whiskerRightIso (SimpleClasses.classOfReprIso W).symm Y) ⟨g, hg⟩,
    Occurs.of_iso_left (SimpleClasses.classOfReprIso W) ⟨j, hj⟩⟩

/-- A simple constituent of `X ⊗ Y` is a constituent of `X ⊗ W` for some simple constituent `W`
of `Y`. -/
private theorem Occurs.exists_right {U X Y : C} (h : Occurs U (X ⊗ Y)) :
    ∃ W : SimpleClasses C, Occurs U (X ⊗ W.repr) ∧ Occurs W.repr Y := by
  obtain ⟨f, hf⟩ := h
  obtain ⟨W, _, g, j, hg, hj⟩ := exists_simple_of_nonzero_to_tensor_right hf
  exact ⟨SimpleClasses.classOf W,
    Occurs.of_iso_right (whiskerLeftIso X (SimpleClasses.classOfReprIso W).symm) ⟨g, hg⟩,
    Occurs.of_iso_left (SimpleClasses.classOfReprIso W) ⟨j, hj⟩⟩

variable [RigidCategory C]

/-- Frobenius reciprocity for constituents: if `U` is a constituent of `X ⊗ Y` with `U` simple,
then `X` maps nontrivially to `U ⊗ Yᘁ`. -/
private theorem Occurs.tensorRightHom {U X Y : C} [Simple U] (h : Occurs U (X ⊗ Y)) :
    Occurs X (U ⊗ Yᘁ) := by
  obtain ⟨f, hf⟩ := h
  exact exists_nonzero_to_tensor_rightDual_of_nonzero_from_simple hf

/-- Right duality preserves constituents. -/
private theorem Occurs.rightDual {U Y : C} [Simple U] (h : Occurs U Y) : Occurs Uᘁ Yᘁ := by
  obtain ⟨f, hf⟩ := h
  exact exists_nonzero_rightDual_of_nonzero_from_simple hf

end Semisimple

end AdjointGrading

open AdjointGrading

variable {C : Type u} [Category.{v} C] [Abelian C] [MonoidalCategory C] [MonoidalPreadditive C]
  [RigidCategory C] [IsFiniteSemisimpleCategory C] [Simple (𝟙_ C)]

namespace AdjointGrading

omit [MonoidalPreadditive C] [RigidCategory C] [IsFiniteSemisimpleCategory C] in
/-- A simple class is a constituent of its tensor product with the unit class on the right. -/
private theorem occurs_tensor_classOf_unit (U : SimpleClasses C) :
    Occurs U.repr (U.repr ⊗ (SimpleClasses.classOf (𝟙_ C)).repr) :=
  (occurs_self _).of_iso_right
    ((ρ_ _).symm ≪≫ whiskerLeftIso _ (SimpleClasses.classOfReprIso _).symm)

omit [MonoidalPreadditive C] [RigidCategory C] [IsFiniteSemisimpleCategory C] in
/-- A simple class is a constituent of its tensor product with the unit class on the left. -/
private theorem occurs_classOf_unit_tensor (U : SimpleClasses C) :
    Occurs U.repr ((SimpleClasses.classOf (𝟙_ C)).repr ⊗ U.repr) :=
  (occurs_self _).of_iso_right
    ((λ_ _).symm ≪≫ whiskerRightIso (SimpleClasses.classOfReprIso _).symm _)

omit [IsFiniteSemisimpleCategory C] in
/-- The unit class is a constituent of `X ⊗ Xᘁ` for a nonzero `X`, through the coevaluation. -/
private theorem occurs_classOf_unit_tensor_rightDual {X : C} (hX : ¬IsZero X) :
    Occurs (SimpleClasses.classOf (𝟙_ C)).repr (X ⊗ Xᘁ) :=
  Occurs.of_iso_left (SimpleClasses.classOfReprIso _) ⟨_, coevaluation_ne_zero (Y := Xᘁ) hX⟩

end AdjointGrading

namespace SimpleClasses

omit [IsFiniteSemisimpleCategory C] in
/-- The tensor unit is adjoint, as a constituent of `X ⊗ Xᘁ` for `X = 𝟙_ C`. -/
@[simp]
theorem isAdjoint_classOf_unit : (classOf (𝟙_ C)).IsAdjoint := by
  obtain ⟨f, hf⟩ := occurs_classOf_unit_tensor_rightDual (Simple.not_isZero (classOf (𝟙_ C)).repr)
  exact .of_tensor_rightDual _ _ f hf

/-- Every simple constituent of `Xᘁ ⊗ X`, for `X` simple, is adjoint. Indeed `X ≅ Xᘁᘁ`, so
`Xᘁ ⊗ X` is `Xᘁ ⊗ Xᘁᘁ`, one of the generators. -/
theorem IsAdjoint.of_rightDual_tensor (X U : SimpleClasses C) (f : U.repr ⟶ X.reprᘁ ⊗ X.repr)
    (hf : f ≠ 0) : U.IsAdjoint := by
  obtain ⟨e⟩ := nonempty_iso_rightDual_rightDual X.repr
  obtain ⟨g, hg⟩ : Occurs U.repr (X.dual.repr ⊗ X.dual.reprᘁ) :=
    Occurs.of_iso_right (tensorIso (dualReprIso X).symm
      (e ≪≫ (dualReprIso X).rightAdjointMate)) ⟨f, hf⟩
  exact .of_tensor_rightDual _ _ g hg

/-- The adjoint classes are closed under duality. -/
theorem IsAdjoint.dual {U : SimpleClasses C} (hU : U.IsAdjoint) : U.dual.IsAdjoint := by
  induction hU with
  | of_tensor_rightDual X U f hf =>
    obtain ⟨e⟩ := nonempty_iso_rightDual_rightDual X.repr
    have h : Occurs U.repr (X.repr ⊗ X.reprᘁ) := ⟨f, hf⟩
    obtain ⟨g, hg⟩ : Occurs U.dual.repr (X.repr ⊗ X.reprᘁ) :=
      h.rightDual.of_iso_left (dualReprIso U) |>.of_iso_right
        (rightDualTensorIso _ _ ≪≫ whiskerRightIso e.symm _)
    exact .of_tensor_rightDual _ _ g hg
  | of_tensor A B U f _ _ hf hA hB =>
    have h : Occurs U.repr (A.repr ⊗ B.repr) := ⟨f, hf⟩
    obtain ⟨g, hg⟩ : Occurs U.dual.repr (B.dual.repr ⊗ A.dual.repr) :=
      h.rightDual.of_iso_left (dualReprIso U) |>.of_iso_right
        (rightDualTensorIso _ _ ≪≫ tensorIso (dualReprIso B).symm (dualReprIso A).symm)
    exact .of_tensor _ _ _ g hB hA hg

/-- A simple class is adjoint exactly when its dual is. -/
@[simp]
theorem isAdjoint_dual_iff {U : SimpleClasses C} : U.dual.IsAdjoint ↔ U.IsAdjoint :=
  ⟨fun h ↦ by simpa only [dual_dual] using h.dual, IsAdjoint.dual⟩

end SimpleClasses

open SimpleClasses

namespace AdjointGrading

/-! ### Right cosets of the adjoint subcategory -/

/-- `S` lies in the right coset of `T`: it is a constituent of `T ⊗ A` for an adjoint `A`. -/
private def CosetRel (S T : SimpleClasses C) : Prop :=
  ∃ A : SimpleClasses C, A.IsAdjoint ∧ Occurs S.repr (T.repr ⊗ A.repr)

omit [IsFiniteSemisimpleCategory C] in
private theorem cosetRel_refl (S : SimpleClasses C) : CosetRel S S :=
  ⟨_, isAdjoint_classOf_unit, occurs_tensor_classOf_unit S⟩

private theorem CosetRel.symm {S T : SimpleClasses C} (h : CosetRel S T) : CosetRel T S := by
  obtain ⟨A, hA, h⟩ := h
  exact ⟨A.dual, hA.dual, h.tensorRightHom.of_iso_right (whiskerLeftIso _ (dualReprIso A).symm)⟩

omit [Simple (𝟙_ C)] in
private theorem CosetRel.trans {S T V : SimpleClasses C} (h : CosetRel S T) (h' : CosetRel T V) :
    CosetRel S V := by
  obtain ⟨A, hA, h⟩ := h
  obtain ⟨B, hB, h'⟩ := h'
  obtain ⟨W, hW, hWBA⟩ := (h.whiskerRight h').of_iso_right (α_ _ _ _) |>.exists_right
  obtain ⟨f, hf⟩ := hWBA
  exact ⟨W, .of_tensor _ _ _ f hB hA hf, hW⟩

private def cosetSetoid : Setoid (SimpleClasses C) where
  r := CosetRel
  iseqv := ⟨cosetRel_refl, CosetRel.symm, CosetRel.trans⟩

/-- The right cosets of the adjoint subcategory. -/
private abbrev Coset (C : Type u) [Category.{v} C] [Abelian C] [MonoidalCategory C]
    [MonoidalPreadditive C] [RigidCategory C] [IsFiniteSemisimpleCategory C] [Simple (𝟙_ C)] :=
  Quotient (cosetSetoid (C := C))

/-- Any two simple constituents of `S ⊗ T`, for `S` and `T` simple, lie in the same coset:
`Tᘁ ⊗ T` has adjoint constituents. -/
private theorem cosetRel_of_occurs {S T Z Z' : SimpleClasses C}
    (h : Occurs Z.repr (S.repr ⊗ T.repr)) (h' : Occurs Z'.repr (S.repr ⊗ T.repr)) :
    CosetRel Z' Z := by
  have := (h'.whiskerRight h.tensorRightHom).of_iso_right (α_ _ _ _)
  obtain ⟨W, hW, f, hf⟩ := this.exists_right
  exact ⟨W, .of_rightDual_tensor T W f hf, hW⟩

/-- Left multiplication by a simple object respects cosets. -/
private theorem cosetRel_of_occurs_of_cosetRel {S T T' Z Z' : SimpleClasses C}
    (hT : CosetRel T T') (h : Occurs Z.repr (S.repr ⊗ T.repr))
    (h' : Occurs Z'.repr (S.repr ⊗ T'.repr)) : CosetRel Z Z' := by
  obtain ⟨A, hA, hTA⟩ := hT
  have := (h.whiskerLeft hTA).of_iso_right (α_ _ _ _).symm
  obtain ⟨W, hZW, hW⟩ := this.exists_left
  exact (show CosetRel Z W from ⟨A, hA, hZW⟩).trans (cosetRel_of_occurs h' hW)

/-- Some simple constituent of `S ⊗ T`. -/
private def constituent (S T : SimpleClasses C) : SimpleClasses C :=
  (exists_occurs (not_isZero_tensorObj (Simple.not_isZero S.repr)
    (Simple.not_isZero T.repr))).choose

private theorem occurs_constituent (S T : SimpleClasses C) :
    Occurs (constituent S T).repr (S.repr ⊗ T.repr) :=
  (exists_occurs (not_isZero_tensorObj (Simple.not_isZero S.repr)
    (Simple.not_isZero T.repr))).choose_spec

/-- A simple class acts on the cosets by sending the coset of `T` to the coset of a simple
constituent of `S ⊗ T`. -/
private def act (S : SimpleClasses C) : Coset C → Coset C :=
  Quotient.lift (fun T ↦ (⟦constituent S T⟧ : Coset C)) fun _ _ h ↦
    Quotient.sound (cosetRel_of_occurs_of_cosetRel h (occurs_constituent _ _)
      (occurs_constituent _ _))

private theorem act_mk {S T Z : SimpleClasses C} (h : Occurs Z.repr (S.repr ⊗ T.repr)) :
    act S ⟦T⟧ = ⟦Z⟧ :=
  Quotient.sound (cosetRel_of_occurs h (occurs_constituent S T))

/-- Acting by `T` and then by `S` is acting by any simple constituent of `S ⊗ T`. -/
private theorem act_act {S T U : SimpleClasses C} (h : Occurs U.repr (S.repr ⊗ T.repr))
    (x : Coset C) : act S (act T x) = act U x := by
  induction x using Quotient.inductionOn with | h V =>
  -- A constituent of `U ⊗ V` is one of `S ⊗ Y` for a constituent `Y` of `T ⊗ V`.
  obtain ⟨Y, hY, hYTV⟩ :=
    ((occurs_constituent U V).whiskerRight h).of_iso_right (α_ _ _ _) |>.exists_right
  rw [act_mk (occurs_constituent T V), act_mk (occurs_constituent U V),
    act_mk (occurs_constituent S _)]
  exact Quotient.sound (cosetRel_of_occurs_of_cosetRel
    (cosetRel_of_occurs hYTV (occurs_constituent T V)) (occurs_constituent _ _) hY)

private theorem act_classOf_unit (x : Coset C) : act (classOf (𝟙_ C)) x = x := by
  induction x using Quotient.inductionOn with | h T =>
  exact act_mk (occurs_classOf_unit_tensor T)

/-- The action of a simple class on the cosets is invertible, with inverse the action of the
dual class. -/
private def actPerm (S : SimpleClasses C) : Equiv.Perm (Coset C) where
  toFun := act S
  invFun := act S.dual
  left_inv x := by
    obtain ⟨e⟩ := nonempty_iso_rightDual_rightDual S.repr
    rw [act_act (U := classOf (𝟙_ C)), act_classOf_unit]
    exact (occurs_classOf_unit_tensor_rightDual (Simple.not_isZero S.reprᘁ)).of_iso_right
      (tensorIso (dualReprIso S).symm e.symm)
  right_inv x := by
    rw [act_act (U := classOf (𝟙_ C)), act_classOf_unit]
    exact (occurs_classOf_unit_tensor_rightDual (Simple.not_isZero S.repr)).of_iso_right
      (whiskerLeftIso _ (dualReprIso S).symm)

/-- The action of the universal grading group on the right cosets of the adjoint subcategory. -/
private def actHom : universalGradingGroup C →* Equiv.Perm (Coset C) :=
  universalGradingGroup.lift actPerm fun _ _ _ f hf ↦
    Equiv.ext fun x ↦ (act_act ⟨f, hf⟩ x).symm

private theorem actHom_degree_mk_unit (S : SimpleClasses C) :
    actHom (universalGradingGroup.degree S) ⟦classOf (𝟙_ C)⟧ = ⟦S⟧ := by
  rw [actHom, universalGradingGroup.lift_degree]
  exact act_mk (occurs_tensor_classOf_unit S)

end AdjointGrading

namespace universalGradingGroup

omit [IsFiniteSemisimpleCategory C] in
/-- Adjoint simple classes have neutral universal degree. -/
theorem _root_.TauCeti.SimpleClasses.IsAdjoint.degree_eq_one {U : SimpleClasses C}
    (hU : U.IsAdjoint) : degree U = 1 := by
  induction hU with
  | of_tensor_rightDual X U f hf =>
    obtain ⟨g, hg⟩ : Occurs U.repr (X.repr ⊗ X.dual.repr) :=
      Occurs.of_iso_right (whiskerLeftIso _ (dualReprIso X).symm) ⟨f, hf⟩
    rw [degree_mul _ _ _ g hg, degree_dual, mul_inv_cancel]
  | of_tensor A B U f _ _ hf hA hB => rw [degree_mul _ _ _ f hf, hA, hB, mul_one]

/-- Two simple classes have the same universal degree exactly when they lie in the same right
coset of the adjoint subcategory: `S` is a constituent of `T ⊗ A` for an adjoint simple `A`. -/
theorem degree_eq_degree_iff (S T : SimpleClasses C) :
    degree S = degree T ↔
      ∃ A : SimpleClasses C, A.IsAdjoint ∧ ∃ f : S.repr ⟶ T.repr ⊗ A.repr, f ≠ 0 := by
  constructor
  · intro h
    have := congrArg (fun g ↦ actHom g ⟦classOf (𝟙_ C)⟧) h
    simp only [actHom_degree_mk_unit] at this
    exact Quotient.exact this
  · rintro ⟨A, hA, f, hf⟩
    rw [degree_mul _ _ _ f hf, hA.degree_eq_one, mul_one]

/-- The simple classes of neutral universal degree are exactly the adjoint ones: the neutral
component of the universal grading is the adjoint subcategory. -/
theorem degree_eq_one_iff (S : SimpleClasses C) : degree S = 1 ↔ S.IsAdjoint := by
  refine ⟨fun h ↦ ?_, IsAdjoint.degree_eq_one⟩
  rw [← degree_unit, degree_eq_degree_iff] at h
  obtain ⟨A, hA, f, hf⟩ := h
  -- `S` is a constituent of `𝟙 ⊗ A ≅ A`, so it is isomorphic to the simple object `A`.
  let g := f ≫ ((classOfReprIso _).hom ▷ _) ≫ (λ_ _).hom
  have hg : g ≠ 0 := fun h ↦ hf (by simpa [g] using h =≫ ((λ_ _).inv ≫ (classOfReprIso _).inv ▷ _))
  have := isIso_of_hom_simple hg
  rwa [(eq_iff_nonempty_iso S A).2 ⟨asIso g⟩]

end universalGradingGroup

end TauCeti
