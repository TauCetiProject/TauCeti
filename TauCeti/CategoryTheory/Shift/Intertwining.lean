module

public import Mathlib.CategoryTheory.Shift.CommShift
public import TauCeti.CategoryTheory.Shift.Autoequivalence

/-!
# Functors commuting with integral shifts

Let `C` and `D` carry shifts by `ℤ`. A shift by `ℤ` is determined by its shift by one, and so is
the compatibility of a functor with it: an isomorphism `shiftFunctor C 1 ⋙ F ≅ F ⋙ shiftFunctor D 1`
extends coherently to every integral shift. This file constructs the resulting
`Functor.CommShift ℤ` structure, whose degree-one isomorphism is the given one. In particular, a
functor intertwining two autoequivalences commutes with the integral shifts they generate.

The construction uses the strict models of integral shifts from
`CategoryTheory.Equivalence.IntSequence`. The sequence of shifts `n ↦ X⟦n⟧` of an object is a
fully faithful functor to sequences for the shift by one, and it commutes coherently with the
shifts. Applying `F` degreewise to sequences commutes strictly with reindexing. The compatibility
of `F` is obtained by comparing the two routes to sequences. The identities between the
additivity isomorphisms `shiftFunctorAdd'` that this comparison needs are recorded in the
`TauCeti` namespace.

## Main definitions

* `CategoryTheory.Equivalence.IntSequence.mapFunctor`: apply an intertwining functor degreewise
  to an integer sequence.
* `CategoryTheory.Equivalence.IntSequence.shiftSequence`: the sequence of shifts `n ↦ X⟦n⟧` of an
  object, as a functor commuting with the shifts.
* `CategoryTheory.Functor.commShiftOfShiftOneIso`: the coherent compatibility with the integral
  shifts of a functor commuting with the shifts by one.
* `CategoryTheory.Functor.commShiftOfIntertwining`: the compatibility with the integral shifts
  generated by two intertwined autoequivalences.
-/

public section

universe v₁ v₂ u₁ u₂

namespace CategoryTheory.Equivalence.IntSequence

open CategoryTheory

variable {C : Type u₁} {D : Type u₂} [Category.{v₁} C] [Category.{v₂} D]
  {e : C ≌ C} {e' : D ≌ D} {F : C ⥤ D}

/-- Applying a functor degreewise to integer sequences, using an isomorphism saying that the
functor intertwines the generating autoequivalences. -/
@[expose, simps!]
def mapFunctor (α : e.functor ⋙ F ≅ F ⋙ e'.functor) : IntSequence e ⥤ IntSequence e' where
  obj X :=
    { X := fun n ↦ F.obj (X.X n)
      iso := fun n m h ↦ (α.app (X.X n)).symm ≪≫ F.mapIso (X.iso n m h) }
  map := fun {X Y} φ ↦
    { f := fun n ↦ F.map (φ.f n)
      comm := fun n m h ↦ by
        simp only [Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom, Category.assoc]
        have hα : e'.functor.map (F.map (φ.f n)) ≫ (α.app (Y.X n)).inv =
            (α.app (X.X n)).inv ≫ F.map (e.functor.map (φ.f n)) := by
          simpa only [Functor.comp_map, Iso.app_inv] using α.inv.naturality (φ.f n)
        rw [← Category.assoc, hα]
        simp only [Category.assoc, ← F.map_comp, φ.comm]
      }
  map_id X := by apply hom_ext; intro n; exact F.map_id _
  map_comp φ ψ := by apply hom_ext; intro n; exact F.map_comp _ _

/-- Evaluation in degree zero after applying `mapFunctor` is applying the original functor after
evaluation. -/
def mapFunctorCompEvalIso (α : e.functor ⋙ F ≅ F ⋙ e'.functor) :
    mapFunctor α ⋙ eval (e := e') ≅ eval (e := e) ⋙ F :=
  NatIso.ofComponents (fun _ ↦ Iso.refl _) (fun _ ↦ by simp [mapFunctor, eval])

@[simp]
theorem mapFunctorCompEvalIso_hom_app (α : e.functor ⋙ F ≅ F ⋙ e'.functor)
    (X : IntSequence e) : (mapFunctorCompEvalIso α).hom.app X = 𝟙 _ :=
  by
    -- Unfold locally to establish the component API while keeping the construction opaque.
    change (Iso.refl _).hom = _
    simp

@[simp]
theorem mapFunctorCompEvalIso_inv_app (α : e.functor ⋙ F ≅ F ⋙ e'.functor)
    (X : IntSequence e) : (mapFunctorCompEvalIso α).inv.app X = 𝟙 _ :=
  by
    -- This is the inverse component of the same locally unfolded identity isomorphism.
    change (Iso.refl _).inv = _
    change 𝟙 (F.obj (X.X 0)) = _
    change 𝟙 (F.obj (X.X 0)) = 𝟙 (F.obj (X.X 0))
    exact (Category.comp_id _).symm.trans (Category.id_comp _)

/-- Applying an intertwining functor degreewise commutes with the reindexing shift. -/
def mapFunctorShiftIso (α : e.functor ⋙ F ≅ F ⋙ e'.functor) (k : ℤ) :
    shiftFunctor (IntSequence e) k ⋙ mapFunctor α ≅
      mapFunctor α ⋙ shiftFunctor (IntSequence e') k :=
  NatIso.ofComponents (fun _ ↦ Iso.refl _) (fun f ↦ by
    ext n
    -- The generated component lemmas for the two composite functors do not rewrite beneath
    -- `IntSequence.Hom.f`; reduction exposes those components, after which the goal is categorical.
    change F.map (f.f (n + k)) ≫ 𝟙 _ = 𝟙 _ ≫ F.map (f.f (n + k))
    simp)

@[simp]
theorem mapFunctorShiftIso_hom_app_f (α : e.functor ⋙ F ≅ F ⋙ e'.functor) (k : ℤ)
    (X : IntSequence e) (n : ℤ) :
    ((mapFunctorShiftIso α k).hom.app X).f n = 𝟙 (F.obj (X.X (n + k))) :=
  by
    -- Unfold locally to establish the component API while keeping the construction opaque.
    change ((𝟙 ((shiftFunctor (IntSequence e) k ⋙ mapFunctor α).obj X) :
      ((shiftFunctor (IntSequence e) k ⋙ mapFunctor α).obj X) ⟶
        ((shiftFunctor (IntSequence e) k ⋙ mapFunctor α).obj X)).f n) = _
    rw [id_f]
    change 𝟙 (F.obj (((reindex k).obj X).X n)) = _
    change 𝟙 (F.obj (X.X (n + k))) = 𝟙 (F.obj (X.X (n + k)))
    exact (Category.comp_id _).symm.trans (Category.id_comp _)

@[simp]
theorem mapFunctorShiftIso_inv_app_f (α : e.functor ⋙ F ≅ F ⋙ e'.functor) (k : ℤ)
    (X : IntSequence e) (n : ℤ) :
    ((mapFunctorShiftIso α k).inv.app X).f n = 𝟙 (F.obj (X.X (n + k))) :=
  by
    -- This is the inverse component of the same locally unfolded identity isomorphism.
    change ((𝟙 ((shiftFunctor (IntSequence e) k ⋙ mapFunctor α).obj X) :
      ((shiftFunctor (IntSequence e) k ⋙ mapFunctor α).obj X) ⟶
        ((shiftFunctor (IntSequence e) k ⋙ mapFunctor α).obj X)).f n) = _
    rw [id_f]
    change 𝟙 (F.obj (((reindex k).obj X).X n)) = _
    change 𝟙 (F.obj (X.X (n + k))) = 𝟙 (F.obj (X.X (n + k)))
    exact (Category.comp_id _).symm.trans (Category.id_comp _)

private lemma shiftFunctorZero_inv_app_mapFunctor_f
    (α : e.functor ⋙ F ≅ F ⋙ e'.functor) (X : IntSequence e) (n : ℤ) :
    ((shiftFunctorZero (IntSequence e') ℤ).inv.app ((mapFunctor α).obj X)).f n =
      F.map (eqToHom (congrArg X.X (show n = n + 0 by omega))) := by
  simp only [shiftFunctorZero_inv_app_f]
  exact (eqToHom_map F (congrArg X.X (show n = n + 0 by omega))).symm

private lemma shiftFunctorAdd_inv_app_mapFunctor_f
    (α : e.functor ⋙ F ≅ F ⋙ e'.functor) (a b : ℤ) (X : IntSequence e) (n : ℤ) :
    ((shiftFunctorAdd (IntSequence e') a b).inv.app ((mapFunctor α).obj X)).f n =
      F.map (eqToHom (congrArg X.X (show n + b + a = n + (a + b) by omega))) := by
  simp only [shiftFunctorAdd_inv_app_f]
  exact (eqToHom_map F
    (congrArg X.X (show n + b + a = n + (a + b) by omega))).symm

private lemma mapFunctor_map_shiftFunctorZero_hom_app_f
    (α : e.functor ⋙ F ≅ F ⋙ e'.functor) (X : IntSequence e) (n : ℤ) :
    ((mapFunctor α).map ((shiftFunctorZero (IntSequence e) ℤ).hom.app X)).f n =
      F.map (eqToHom (congrArg X.X (show n + 0 = n by omega))) := by
  rw [mapFunctor_map_f, shiftFunctorZero_hom_app_f]
  congr 1

private lemma mapFunctor_map_shiftFunctorAdd_hom_app_f
    (α : e.functor ⋙ F ≅ F ⋙ e'.functor) (a b : ℤ) (X : IntSequence e)
    (n : ℤ) :
    ((mapFunctor α).map ((shiftFunctorAdd (IntSequence e) a b).hom.app X)).f n =
      F.map (eqToHom (congrArg X.X (show n + (a + b) = n + b + a by omega))) := by
  rw [mapFunctor_map_f, shiftFunctorAdd_hom_app_f]
  congr 1

/-- The degreewise functor associated to an intertwining functor commutes coherently with
reindexing. -/
noncomputable instance mapFunctorCommShift
    (α : e.functor ⋙ F ≅ F ⋙ e'.functor) : (mapFunctor α).CommShift ℤ where
  commShiftIso := mapFunctorShiftIso α
  commShiftIso_zero := by
    apply Iso.ext
    apply NatTrans.ext
    funext X
    rw [Functor.CommShift.isoZero_hom_app]
    apply hom_ext
    intro n
    simp only [mapFunctorShiftIso_hom_app_f, comp_f,
      mapFunctor_map_shiftFunctorZero_hom_app_f, shiftFunctorZero_inv_app_mapFunctor_f]
    -- The component lemmas above expose every structural map. Only the source of the identity
    -- remains displayed with two propositionally equal integer expressions, so no rewrite lemma
    -- can state the required typed identity without making the same arithmetic transport explicit.
    change 𝟙 (F.obj (X.X (n + 0))) = _
    erw [← F.map_comp, ← F.map_id]
    congr 1
    rw [eqToHom_trans]
    simp
  commShiftIso_add a b := by
    apply Iso.ext
    apply NatTrans.ext
    funext X
    rw [Functor.CommShift.isoAdd_hom_app]
    apply hom_ext
    intro n
    simp only [comp_f]
    simp only [mapFunctorShiftIso_hom_app_f, mapFunctor_map_shiftFunctorAdd_hom_app_f,
      shiftFunctorAdd_inv_app_mapFunctor_f]
    -- As in the zero case, this `change` only aligns the dependent type of the identity after all
    -- shift structure has been rewritten by the component API above.
    change 𝟙 (F.obj (X.X (n + (a + b)))) = _
    erw [Category.id_comp, Category.id_comp]
    erw [← F.map_comp, ← F.map_id]
    congr 1
    rw [eqToHom_trans]
    simp

end CategoryTheory.Equivalence.IntSequence

/-! ### Identities between the additivity isomorphisms of a shift -/

namespace TauCeti

open CategoryTheory

variable {C : Type u₁} [Category.{v₁} C]

/-- Transporting the identification `X⟦a⟧⟦b⟧ ≅ X⟦c⟧` along an equality `c = c'` gives the
identification `X⟦a⟧⟦b⟧ ≅ X⟦c'⟧`. -/
theorem shiftFunctorAdd'_inv_app_comp_eqToHom {A : Type*} [AddMonoid A] [HasShift C A]
    {a b c c' : A} (h : a + b = c) (h' : a + b = c') (X : C) :
    (shiftFunctorAdd' C a b c h).inv.app X ≫ eqToHom (by rw [← h, h']) =
      (shiftFunctorAdd' C a b c' h').inv.app X := by
  subst h h'
  simp

variable [HasShift C ℤ]

/-- The identifications `X⟦n + k⟧ ≅ X⟦k⟧⟦n⟧`, for `n` and `m = n + 1`, are compatible with the
identifications `Y⟦n⟧⟦1⟧ ≅ Y⟦m⟧`. -/
theorem shiftFunctorAdd'_hom_app_shift_comp {k n m : ℤ} (h : n + 1 = m) (X : C) :
    ((shiftFunctorAdd' C k n (n + k) (add_comm k n)).hom.app X)⟦(1 : ℤ)⟧' ≫
        (shiftFunctorAdd' C n 1 m h).inv.app (X⟦k⟧) =
      (shiftFunctorAdd' C (n + k) 1 (m + k) (by omega)).inv.app X ≫
        (shiftFunctorAdd' C k m (m + k) (add_comm k m)).hom.app X := by
  rw [← cancel_epi ((shiftFunctorAdd' C (n + k) 1 (m + k) (by omega)).hom.app X),
    reassoc_of% (shiftFunctorAdd'_assoc_hom_app k n 1 (n + k) m (m + k) (add_comm k n) h
      (by omega) X)]
  simp

/-- The identification `X⟦k⟧⟦n⟧ ≅ X⟦n + k⟧` at `k = 0`. -/
theorem shiftFunctorAdd'_zero_inv_app (n : ℤ) (X : C) :
    (shiftFunctorAdd' C 0 n (n + 0) (add_comm 0 n)).inv.app X =
      ((shiftFunctorZero C ℤ).hom.app X)⟦n⟧' ≫ eqToHom (by simp) := by
  rw [← shiftFunctorAdd'_zero_add_inv_app, shiftFunctorAdd'_inv_app_comp_eqToHom]

/-- The identification `X⟦k⟧⟦n⟧ ≅ X⟦n + k⟧` at `k = a + b`, through the shifts by `a` and `b`. -/
theorem shiftFunctorAdd'_add_inv_app (a b n : ℤ) (X : C) :
    (shiftFunctorAdd' C (a + b) n (n + (a + b)) (add_comm (a + b) n)).inv.app X =
      ((shiftFunctorAdd C a b).hom.app X)⟦n⟧' ≫
        (shiftFunctorAdd' C b n (n + b) (add_comm b n)).inv.app (X⟦a⟧) ≫
          (shiftFunctorAdd' C a (n + b) (n + b + a) (add_comm a (n + b))).inv.app X ≫
            eqToHom (by rw [show n + b + a = n + (a + b) by omega]) := by
  rw [← shiftFunctorAdd'_assoc_inv_app_assoc a b n (a + b) (n + b) (n + b + a) rfl
    (add_comm b n) (by omega), shiftFunctorAdd'_eq_shiftFunctorAdd, ← Functor.map_comp_assoc,
    Iso.hom_inv_id_app, CategoryTheory.Functor.map_id, Category.id_comp,
    shiftFunctorAdd'_inv_app_comp_eqToHom]

end TauCeti

/-! ### The sequence of shifts of an object -/

namespace CategoryTheory.Equivalence.IntSequence

open CategoryTheory TauCeti

variable (D : Type u₂) [Category.{v₂} D] [HasShift D ℤ]

/-- The sequence of shifts `n ↦ X⟦n⟧` of an object, as an integer sequence for the shift by one,
linked by the identifications `X⟦n⟧⟦1⟧ ≅ X⟦n + 1⟧`. -/
@[expose, simps]
def ofShift (X : D) : IntSequence (shiftEquiv D (1 : ℤ)) where
  X n := X⟦n⟧
  iso n m h := ((shiftFunctorAdd' D n 1 m h).app X).symm

/-- The functor sending an object to its sequence of shifts. Together with evaluation in degree
zero it identifies `D` with the integer sequences for its shift by one. -/
@[expose, simps]
def shiftSequence : D ⥤ IntSequence (shiftEquiv D (1 : ℤ)) where
  obj := ofShift D
  map f :=
    { f n := f⟦n⟧'
      comm n m h := (shiftFunctorAdd' D n 1 m h).inv.naturality f }

/-- Evaluating the sequence of shifts in degree zero recovers the object. -/
noncomputable def shiftSequenceCompEvalIso : shiftSequence D ⋙ eval ≅ 𝟭 D :=
  NatIso.ofComponents (fun X ↦ (shiftFunctorZero D ℤ).app X)
    (fun f ↦ (shiftFunctorZero D ℤ).hom.naturality f)

@[simp]
theorem shiftSequenceCompEvalIso_hom_app (X : D) :
    (shiftSequenceCompEvalIso D).hom.app X = (shiftFunctorZero D ℤ).hom.app X :=
  (rfl)

@[simp]
theorem shiftSequenceCompEvalIso_inv_app (X : D) :
    (shiftSequenceCompEvalIso D).inv.app X = (shiftFunctorZero D ℤ).inv.app X :=
  (rfl)

instance : (shiftSequence D).Faithful :=
  Functor.Faithful.of_comp_iso (shiftSequenceCompEvalIso D)

instance : (shiftSequence D).Full :=
  Functor.Full.of_comp_faithful_iso (shiftSequenceCompEvalIso D)

variable {D}

/-- Shifting an object by `k` and forming its sequence of shifts is reindexing its sequence of
shifts by `k`, through the identifications `X⟦k⟧⟦n⟧ ≅ X⟦n + k⟧`. -/
noncomputable def shiftSequenceShiftIso (k : ℤ) :
    shiftFunctor D k ⋙ shiftSequence D ≅ shiftSequence D ⋙ shiftFunctor _ k :=
  NatIso.ofComponents (fun X ↦
    { hom :=
        { f n := (shiftFunctorAdd' D k n (n + k) (add_comm k n)).inv.app X
          comm n m h := shiftFunctorAdd'_assoc_inv_app k n 1 (n + k) m (m + k) _ h
            (by omega) X }
      inv :=
        { f n := (shiftFunctorAdd' D k n (n + k) (add_comm k n)).hom.app X
          comm n m h := shiftFunctorAdd'_hom_app_shift_comp h X }
      hom_inv_id := by
        ext n
        exact (shiftFunctorAdd' D k n (n + k) (add_comm k n)).inv_hom_id_app X
      inv_hom_id := by
        ext n
        exact (shiftFunctorAdd' D k n (n + k) (add_comm k n)).hom_inv_id_app X }) (fun f ↦ by
    ext n
    exact (shiftFunctorAdd' D k n (n + k) (add_comm k n)).inv.naturality f)

@[simp]
theorem shiftSequenceShiftIso_hom_app_f (k : ℤ) (X : D) (n : ℤ) :
    ((shiftSequenceShiftIso k).hom.app X).f n =
      (shiftFunctorAdd' D k n (n + k) (add_comm k n)).inv.app X :=
  (rfl)

@[simp]
theorem shiftSequenceShiftIso_inv_app_f (k : ℤ) (X : D) (n : ℤ) :
    ((shiftSequenceShiftIso k).inv.app X).f n =
      (shiftFunctorAdd' D k n (n + k) (add_comm k n)).hom.app X :=
  (rfl)

/-- Forming the sequence of shifts commutes coherently with the shift of `D` and the reindexing
shift of integer sequences. -/
noncomputable instance shiftSequenceCommShift : (shiftSequence D).CommShift ℤ where
  commShiftIso := shiftSequenceShiftIso
  commShiftIso_zero := by
    ext X n
    rw [Functor.CommShift.isoZero_hom_app]
    simp only [shiftSequenceShiftIso_hom_app_f, comp_f, shiftSequence_map_f,
      shiftFunctorZero_inv_app_f]
    exact shiftFunctorAdd'_zero_inv_app n X
  commShiftIso_add a b := by
    ext X n
    rw [Functor.CommShift.isoAdd_hom_app]
    simp only [shiftSequenceShiftIso_hom_app_f, comp_f, shiftSequence_map_f,
      shiftFunctor_eq_reindex, reindex_map_f, shiftFunctorAdd_inv_app_f]
    exact shiftFunctorAdd'_add_inv_app a b n X

end CategoryTheory.Equivalence.IntSequence

namespace CategoryTheory.Functor

open CategoryTheory.Equivalence Equivalence.IntSequence

variable {C : Type u₁} {D : Type u₂} [Category.{v₁} C] [Category.{v₂} D]

section

variable [HasShift C ℤ] [HasShift D ℤ]

namespace CommShiftOfShiftOneIso

-- The isomorphism is typed with the functors of `shiftEquiv C 1` and `shiftEquiv D 1`, which are
-- the shifts by one only after unfolding `shiftEquiv'`; instance search for `mapFunctor` needs
-- this form.
variable (F : C ⥤ D)
  (α : (shiftEquiv C (1 : ℤ)).functor ⋙ F ≅ F ⋙ (shiftEquiv D (1 : ℤ)).functor)

/-- After postcomposition with evaluation, the comparison used to transport the shift
compatibility is the evident comparison through the identifications `X⟦0⟧ ≅ X`. -/
private noncomputable def comparisonAfterEval :
    (F ⋙ shiftSequence D) ⋙ eval ≅ (shiftSequence C ⋙ mapFunctor α) ⋙ eval :=
  NatIso.ofComponents
    (fun X ↦
      { hom := (shiftFunctorZero D ℤ).hom.app (F.obj X) ≫ F.map ((shiftFunctorZero C ℤ).inv.app X)
        inv := F.map ((shiftFunctorZero C ℤ).hom.app X) ≫ (shiftFunctorZero D ℤ).inv.app (F.obj X)
        -- The identities are typed at evaluations of sequences; state them at the displayed
        -- objects.
        hom_inv_id := by
          have h : ((shiftFunctorZero D ℤ).hom.app (F.obj X) ≫
              F.map ((shiftFunctorZero C ℤ).inv.app X)) ≫
                F.map ((shiftFunctorZero C ℤ).hom.app X) ≫
                  (shiftFunctorZero D ℤ).inv.app (F.obj X) = 𝟙 ((F.obj X)⟦(0 : ℤ)⟧) := by
            simp
          exact h
        inv_hom_id := by
          have h : (F.map ((shiftFunctorZero C ℤ).hom.app X) ≫
              (shiftFunctorZero D ℤ).inv.app (F.obj X)) ≫
                (shiftFunctorZero D ℤ).hom.app (F.obj X) ≫
                  F.map ((shiftFunctorZero C ℤ).inv.app X) = 𝟙 (F.obj (X⟦(0 : ℤ)⟧)) := by
            simp
          exact h })
    (fun {X Y} f ↦ by
      -- As above, the naturality square is the following equation between the displayed
      -- objects.
      have h : (F.map f)⟦(0 : ℤ)⟧' ≫ (shiftFunctorZero D ℤ).hom.app (F.obj Y) ≫
          F.map ((shiftFunctorZero C ℤ).inv.app Y) =
            ((shiftFunctorZero D ℤ).hom.app (F.obj X) ≫
              F.map ((shiftFunctorZero C ℤ).inv.app X)) ≫ F.map (f⟦(0 : ℤ)⟧') := by
        have h₁ := (shiftFunctorZero C ℤ).inv.naturality f
        rw [Functor.id_map] at h₁
        rw [Category.assoc, ← F.map_comp, ← h₁, F.map_comp]
        exact (shiftFunctorZero D ℤ).hom.naturality_assoc (F.map f) _
      exact h)

/-- The comparison between the sequence of shifts of the image of an object and the image of its
sequence of shifts. -/
private noncomputable def comparison :
    F ⋙ shiftSequence D ≅ shiftSequence C ⋙ mapFunctor α :=
  ((whiskeringRight C (IntSequence (shiftEquiv D (1 : ℤ))) D).obj eval).preimageIso
    (comparisonAfterEval F α)

private lemma comparison_hom_app_f_zero (X : C) :
    ((comparison F α).hom.app X).f 0 =
      (shiftFunctorZero D ℤ).hom.app (F.obj X) ≫ F.map ((shiftFunctorZero C ℤ).inv.app X) := by
  -- Postcomposition by evaluation is definitionally the degree-zero component. This exposes the
  -- `map_preimage` equation without unfolding the chosen preimage itself.
  change (((whiskeringRight C (IntSequence (shiftEquiv D (1 : ℤ))) D).obj eval).map
    (comparison F α).hom).app X = _
  unfold comparison
  rw [Functor.preimageIso_hom, Functor.map_preimage]
  rfl

private lemma comparison_inv_app_f_zero (X : C) :
    ((comparison F α).inv.app X).f 0 =
      F.map ((shiftFunctorZero C ℤ).hom.app X) ≫ (shiftFunctorZero D ℤ).inv.app (F.obj X) := by
  -- As above, normalize only the evaluation component in order to use `map_preimage`.
  change (((whiskeringRight C (IntSequence (shiftEquiv D (1 : ℤ))) D).obj eval).map
    (comparison F α).inv).app X = _
  unfold comparison
  rw [Functor.preimageIso_inv, Functor.map_preimage]
  rfl

private lemma comparison_inv_app_f_one (X : C) :
    ((comparison F α).inv.app X).f 1 =
      (((mapFunctor α).obj ((shiftSequence C).obj X)).iso 0 1 rfl).inv ≫
        (shiftFunctor D (1 : ℤ)).map (((comparison F α).inv.app X).f 0) ≫
          (((shiftSequence D).obj (F.obj X)).iso 0 1 rfl).hom := by
  rw [← cancel_epi (((mapFunctor α).obj ((shiftSequence C).obj X)).iso 0 1 rfl).hom]
  simp only [Iso.hom_inv_id_assoc]
  exact (((comparison F α).inv.app X).comm 0 1 rfl).symm

end CommShiftOfShiftOneIso

/-- A functor commuting with the shifts by one of two shifts by `ℤ` commutes coherently with all
the shifts, with the given isomorphism in degree one. -/
@[instance_reducible]
noncomputable def commShiftOfShiftOneIso (F : C ⥤ D)
    (α : shiftFunctor C (1 : ℤ) ⋙ F ≅ F ⋙ shiftFunctor D (1 : ℤ)) : F.CommShift ℤ :=
  -- Retype `α` so that the shifts by one are displayed as the functors of `shiftEquiv`.
  let α' : (shiftEquiv C (1 : ℤ)).functor ⋙ F ≅ F ⋙ (shiftEquiv D (1 : ℤ)).functor := α
  letI : (mapFunctor α').CommShift ℤ := mapFunctorCommShift α'
  Functor.CommShift.ofComp (CommShiftOfShiftOneIso.comparison F α') ℤ

/-- In degree one, the shift compatibility constructed from an isomorphism `α` is `α`. -/
theorem commShiftOfShiftOneIso_iso_one (F : C ⥤ D)
    (α : shiftFunctor C (1 : ℤ) ⋙ F ≅ F ⋙ shiftFunctor D (1 : ℤ)) :
    letI := commShiftOfShiftOneIso F α
    F.commShiftIso (1 : ℤ) = α := by
  let α' : (shiftEquiv C (1 : ℤ)).functor ⋙ F ≅ F ⋙ (shiftEquiv D (1 : ℤ)).functor := α
  let _ : (mapFunctor α').CommShift ℤ := mapFunctorCommShift α'
  let _ : F.CommShift ℤ := commShiftOfShiftOneIso F α
  apply Iso.ext
  apply NatTrans.ext
  funext X
  apply (shiftSequence D).map_injective
  apply hom_ext_of_f_zero
  -- `OfComp.iso` is the public comparison underlying the installed `CommShift` structure.
  change ((shiftSequence D).map
    ((Functor.CommShift.OfComp.iso (CommShiftOfShiftOneIso.comparison F α')
      (1 : ℤ)).hom.app X)).f 0 = _
  rw [Functor.CommShift.OfComp.map_iso_hom_app]
  simp only [comp_f, CommShiftOfShiftOneIso.comparison_hom_app_f_zero,
    Functor.commShiftIso_comp_hom_app, shiftFunctor_eq_reindex, reindex_map_f,
    shiftSequence_map_f]
  rw [show (mapFunctor α').commShiftIso (1 : ℤ) = mapFunctorShiftIso α' 1 from rfl,
    show (shiftSequence C).commShiftIso (1 : ℤ) = shiftSequenceShiftIso 1 from rfl,
    show (shiftSequence D).commShiftIso (1 : ℤ) = shiftSequenceShiftIso 1 from rfl]
  simp only [mapFunctorShiftIso_hom_app_f, mapFunctor_map_f, shiftSequenceShiftIso_hom_app_f,
    shiftSequenceShiftIso_inv_app_f, Int.reduceAdd,
    CommShiftOfShiftOneIso.comparison_inv_app_f_one,
    CommShiftOfShiftOneIso.comparison_inv_app_f_zero]
  -- The components above are typed at terms of integer sequences, so the composites carry
  -- sequence terms as implicit objects and do not rewrite. State the same equation with the
  -- displayed objects of `C` and `D`, where the cancellations are ordinary rewrites.
  have key : ((shiftFunctorZero D ℤ).hom.app (F.obj (X⟦(1 : ℤ)⟧)) ≫
        F.map ((shiftFunctorZero C ℤ).inv.app (X⟦(1 : ℤ)⟧))) ≫
      (F.map ((shiftFunctorAdd' C 1 0 1 (add_zero 1)).inv.app X) ≫ 𝟙 (F.obj (X⟦(1 : ℤ)⟧))) ≫
        ((F.map ((shiftFunctorAdd' C 0 1 1 (zero_add 1)).hom.app X) ≫
            α.hom.app (X⟦(0 : ℤ)⟧)) ≫
          (F.map ((shiftFunctorZero C ℤ).hom.app X) ≫
              (shiftFunctorZero D ℤ).inv.app (F.obj X))⟦(1 : ℤ)⟧' ≫
            (shiftFunctorAdd' D 0 1 1 (zero_add 1)).inv.app (F.obj X)) ≫
          (shiftFunctorAdd' D 1 0 1 (add_zero 1)).hom.app (F.obj X) =
      (α.hom.app X)⟦(0 : ℤ)⟧' := by
    have hα := α.hom.naturality ((shiftFunctorZero C ℤ).inv.app X)
    rw [Functor.comp_map, Functor.comp_map] at hα
    rw [shiftFunctorAdd'_add_zero_inv_app, shiftFunctorAdd'_zero_add_hom_app,
      shiftFunctorAdd'_zero_add_inv_app, shiftFunctorAdd'_add_zero_hom_app]
    simp only [Category.assoc, Category.comp_id]
    rw [← F.map_comp_assoc ((shiftFunctorZero C ℤ).inv.app _), Iso.inv_hom_id_app, F.map_id,
      Category.id_comp, reassoc_of% hα]
    simp only [← Functor.map_comp_assoc, Category.assoc, Functor.id_obj, Iso.inv_hom_id_app,
      Functor.map_id, Category.id_comp]
    exact NatIso.naturality_2 (shiftFunctorZero D ℤ) _
  exact key

end

/-- A functor intertwining two autoequivalences commutes coherently with the integral shifts
generated by those autoequivalences. -/
@[instance_reducible]
noncomputable def commShiftOfIntertwining (F : C ⥤ D) (e : C ≌ C) (e' : D ≌ D)
    (α : e.functor ⋙ F ≅ F ⋙ e'.functor) :
    letI := e.hasShift
    letI := e'.hasShift
    F.CommShift ℤ :=
  letI := e.hasShift
  letI := e'.hasShift
  commShiftOfShiftOneIso F (isoWhiskerRight e.shiftFunctorOneIso F ≪≫ α ≪≫
    isoWhiskerLeft F e'.shiftFunctorOneIso.symm)

/-- At degree one, the coherent shift comparison recovers the supplied intertwining
isomorphism. -/
theorem commShiftOfIntertwining_iso_one (F : C ⥤ D) (e : C ≌ C) (e' : D ≌ D)
    (α : e.functor ⋙ F ≅ F ⋙ e'.functor) :
    letI := e.hasShift
    letI := e'.hasShift
    letI := commShiftOfIntertwining F e e' α
    F.commShiftIso (1 : ℤ) =
      isoWhiskerRight e.shiftFunctorOneIso F ≪≫ α ≪≫
        isoWhiskerLeft F e'.shiftFunctorOneIso.symm :=
  letI := e.hasShift
  letI := e'.hasShift
  commShiftOfShiftOneIso_iso_one F _

end CategoryTheory.Functor
