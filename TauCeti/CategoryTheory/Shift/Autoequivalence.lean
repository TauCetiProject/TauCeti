/-!
# The shift by `ℤ` generated by an autoequivalence

An autoequivalence `e : C ≌ C` determines a shift of `C` by `ℤ` whose shift by `1` is
`e.functor` and whose shift by `-1` is a quasi-inverse of `e.functor`. The shift functors are, up
to isomorphism, the powers of `e`; the content of the construction is the coherence of the
isomorphisms `X⟦a + b⟧ ≅ X⟦a⟧⟦b⟧`, which is not automatic when the powers of `e` are formed by
iterated composition.

We obtain the coherence by strictification. An `e.IntSequence` is a family of objects `X n`,
`n : ℤ`, together with isomorphisms `e (X n) ≅ X (n + 1)`. On these sequences reindexing
`X ↦ (n ↦ X (n + k))` is a shift by `ℤ` whose coherence isomorphisms are identities up to
`eqToHom`, so the axioms hold componentwise. Evaluation in degree zero is an equivalence from
sequences to `C`: every object of `C` occurs as a degree-zero term, and a specified degree-zero
morphism extends uniquely to a morphism of sequences. The reindexing shift is transported along
this equivalence with Mathlib's `HasShift.induced`.
Reindexing by one corresponds to `e.functor` under evaluation, which identifies the shift by one.

The sequence and functor definitions are exposed so their generated component lemmas and
dependent functor fields can reduce in Lean's module system.

This is how the suspension autoequivalence of the stable category of a Frobenius exact category
becomes the shift of that category.

## Main definitions

* `CategoryTheory.Equivalence.IntSequence`: `ℤ`-indexed sequences of objects linked by `e`.
* `CategoryTheory.Equivalence.IntSequence.eval`: evaluation of a sequence in degree zero, an
  equivalence of categories.
* `CategoryTheory.Equivalence.hasShift`: the shift of `C` by `ℤ` generated by `e`.
* `CategoryTheory.Equivalence.shiftFunctorOneIso`: its shift by `1` is `e.functor`.
* `CategoryTheory.Equivalence.shiftFunctorNegOneIso`: its shift by `-1` is any quasi-inverse of
  `e.functor`.

## Main results

* `CategoryTheory.Equivalence.shiftFunctor_additive`: when `C` is preadditive and `e.functor` is
  additive, every shift functor is additive.

## References

* Dieter Happel, *Triangulated Categories in the Representation Theory of Finite Dimensional
  Algebras*, Chapter I, Section 2, where the suspension of a Frobenius stable category is the
  translation functor.
-/

universe v u

public section

namespace CategoryTheory.Equivalence

open CategoryTheory.Functor

variable {C : Type u} [Category.{v} C] (e : C ≌ C)

/-- A `ℤ`-indexed sequence of objects of `C` in which each term is identified with the image under
`e` of the previous one. The identifications are indexed by pairs `n`, `m` with `n + 1 = m`, so
that reindexing a sequence needs no transport along equalities of indices. -/
structure IntSequence where
  /-- The term in degree `n`. -/
  X : ℤ → C
  /-- The identification of `e (X n)` with the next term `X m`, where `n + 1 = m`. -/
  iso (n m : ℤ) (h : n + 1 = m) : e.functor.obj (X n) ≅ X m

namespace IntSequence

variable {e}

/-- A morphism of `e`-sequences: a family of morphisms of the terms commuting with the
identifications `e (X n) ≅ X (n + 1)`. -/
@[ext]
structure Hom (X Y : IntSequence e) where
  /-- The component in degree `n`. -/
  f (n : ℤ) : X.X n ⟶ Y.X n
  comm (n m : ℤ) (h : n + 1 = m) :
    e.functor.map (f n) ≫ (Y.iso n m h).hom = (X.iso n m h).hom ≫ f m

attribute [reassoc] Hom.comm

instance : Category (IntSequence e) where
  Hom := Hom
  id X := { f _ := 𝟙 _, comm _ _ _ := by simp }
  comp φ ψ := { f n := φ.f n ≫ ψ.f n, comm _ _ _ := by simp [ψ.comm, φ.comm_assoc] }

@[ext]
lemma hom_ext {X Y : IntSequence e} {φ ψ : X ⟶ Y} (h : ∀ n, φ.f n = ψ.f n) : φ = ψ :=
  Hom.ext (funext h)

@[simp]
lemma id_f (X : IntSequence e) (n : ℤ) : Hom.f (𝟙 X) n = 𝟙 _ :=
  rfl

@[simp, reassoc]
lemma comp_f {X Y Z : IntSequence e} (φ : X ⟶ Y) (ψ : Y ⟶ Z) (n : ℤ) :
    (φ ≫ ψ).f n = φ.f n ≫ ψ.f n :=
  rfl

@[simp]
lemma eqToHom_f {X Y : IntSequence e} (h : X = Y) (n : ℤ) :
    Hom.f (eqToHom h) n = eqToHom (by rw [h]) := by
  subst h
  simp

/-- The compatibility of a morphism of sequences with the inverse identifications. -/
@[reassoc]
lemma Hom.f_comp_iso_inv {X Y : IntSequence e} (φ : X ⟶ Y) (n m : ℤ) (h : n + 1 = m) :
    φ.f m ≫ (Y.iso n m h).inv = (X.iso n m h).inv ≫ e.functor.map (φ.f n) := by
  rw [Iso.comp_inv_eq, Category.assoc, φ.comm, Iso.inv_hom_id_assoc]

/-- A morphism of sequences, transported along an equality of indices. -/
lemma Hom.f_eq {X Y : IntSequence e} (φ : X ⟶ Y) {n n' : ℤ} (h : n = n') :
    φ.f n = eqToHom (congrArg X.X h) ≫ φ.f n' ≫ eqToHom (congrArg Y.X h.symm) := by
  subst h
  simp

/-! ### Reindexing -/

/-- The sequence `n ↦ X (g n)`, for an index map `g` compatible with successors. -/
@[expose, simps]
def comap (X : IntSequence e) (g : ℤ → ℤ) (hg : ∀ n m, n + 1 = m → g n + 1 = g m) :
    IntSequence e where
  X n := X.X (g n)
  iso n m h := X.iso (g n) (g m) (hg n m h)

/-- Pulling back along equal index maps gives equal sequences. -/
lemma comap_congr (X : IntSequence e) {g g' : ℤ → ℤ} (h : g = g')
    (hg : ∀ n m, n + 1 = m → g n + 1 = g m) (hg' : ∀ n m, n + 1 = m → g' n + 1 = g' m) :
    X.comap g hg = X.comap g' hg' := by
  subst h
  rfl

/-- Reindexing sequences by `k`: the term in degree `n` of the reindexed sequence is the term in
degree `n + k`. This is the shift by `k` of `IntSequence e`. -/
@[expose, simps]
def reindex (k : ℤ) : IntSequence e ⥤ IntSequence e where
  obj X := X.comap (· + k) (fun _ _ _ ↦ by omega)
  map φ := { f n := φ.f (n + k), comm _ _ _ := φ.comm _ _ _ }

lemma reindex_obj_zero (X : IntSequence e) : (reindex 0).obj X = X :=
  X.comap_congr (g' := id) (funext add_zero) _ (fun _ _ h ↦ h)

lemma reindex_obj_add (a b : ℤ) (X : IntSequence e) :
    (reindex (a + b)).obj X = (reindex b).obj ((reindex a).obj X) :=
  X.comap_congr (funext fun n ↦ by dsimp only; omega) _ (fun _ _ _ ↦ by dsimp only; omega)

/-- Reindexing by zero is the identity functor. -/
lemma reindex_zero : reindex (e := e) 0 = 𝟭 _ :=
  Functor.ext reindex_obj_zero (fun _ _ φ ↦ by
    ext n
    rw [comp_f, comp_f, eqToHom_f, eqToHom_f]
    exact φ.f_eq (add_zero n))

/-- Reindexing by `a + b` is reindexing by `a` followed by reindexing by `b`. -/
lemma reindex_add (a b : ℤ) : reindex (e := e) (a + b) = reindex a ⋙ reindex b :=
  Functor.ext (reindex_obj_add a b) (fun _ _ φ ↦ by
    ext n
    rw [comp_f, comp_f, eqToHom_f, eqToHom_f]
    exact φ.f_eq (show n + (a + b) = n + b + a by omega))

/-- The shift of `e`-sequences by `ℤ`, given by reindexing. It is strict: its structure
isomorphisms are identities up to `eqToHom`. -/
instance : HasShift (IntSequence e) ℤ :=
  hasShiftMk _ _
    { F := reindex
      zero := eqToIso reindex_zero
      add a b := eqToIso (reindex_add a b)
      assoc_hom_app _ _ _ _ := by simp [eqToHom_map]
      zero_add_hom_app _ _ := by simp [eqToHom_map]
      add_zero_hom_app _ _ := by simp }

/-! ### Evaluation in degree zero -/

/-- Evaluation of a sequence in degree zero. It is an equivalence of categories: every object of
`C` occurs as a degree-zero term, and each degree-zero morphism extends uniquely to a morphism
of sequences. -/
@[expose, simps]
def eval : IntSequence e ⥤ C where
  obj X := X.X 0
  map φ := φ.f 0

/-- A morphism of sequences is determined by its component in degree zero. -/
lemma hom_ext_of_f_zero {X Y : IntSequence e} {φ ψ : X ⟶ Y} (h : φ.f 0 = ψ.f 0) : φ = ψ := by
  ext n
  induction n using Int.induction_on with
  | zero => exact h
  | succ k ih => rw [← cancel_epi (X.iso k (k + 1) rfl).hom, ← φ.comm, ← ψ.comm, ih]
  | pred k ih =>
    apply e.functor.map_injective
    rw [← cancel_mono (Y.iso (-k - 1) (-k) (by omega)).hom, φ.comm, ψ.comm, ih]

/-- The extension of a morphism in degree zero to all degrees, by transport along the
identifications: upwards through `e.functor`, downwards through its preimages. -/
private noncomputable def extendHom {X Y : IntSequence e} (g : X.X 0 ⟶ Y.X 0) (n : ℤ) :
    X.X n ⟶ Y.X n :=
  Int.inductionOn' (motive := fun n ↦ X.X n ⟶ Y.X n) n 0 g
    (fun k _ φ ↦ (X.iso k (k + 1) rfl).inv ≫ e.functor.map φ ≫ (Y.iso k (k + 1) rfl).hom)
    (fun k _ φ ↦ e.functor.preimage
      ((X.iso (k - 1) k (by omega)).hom ≫ φ ≫ (Y.iso (k - 1) k (by omega)).inv))

private lemma extendHom_zero {X Y : IntSequence e} (g : X.X 0 ⟶ Y.X 0) : extendHom g 0 = g :=
  Int.inductionOn'_self

private lemma extendHom_add_one {X Y : IntSequence e} (g : X.X 0 ⟶ Y.X 0) {n : ℤ} (hn : 0 ≤ n) :
    extendHom g (n + 1) =
      (X.iso n (n + 1) rfl).inv ≫ e.functor.map (extendHom g n) ≫ (Y.iso n (n + 1) rfl).hom := by
  unfold extendHom
  exact Int.inductionOn'_add_one hn

private lemma extendHom_sub_one {X Y : IntSequence e} (g : X.X 0 ⟶ Y.X 0) {n : ℤ} (hn : n ≤ 0) :
    extendHom g (n - 1) = e.functor.preimage
      ((X.iso (n - 1) n (by omega)).hom ≫ extendHom g n ≫ (Y.iso (n - 1) n (by omega)).inv) := by
  unfold extendHom
  exact Int.inductionOn'_sub_one hn

private lemma extendHom_comm {X Y : IntSequence e} (g : X.X 0 ⟶ Y.X 0) (n m : ℤ)
    (h : n + 1 = m) :
    e.functor.map (extendHom g n) ≫ (Y.iso n m h).hom = (X.iso n m h).hom ≫ extendHom g m := by
  rcases le_or_gt 0 n with hn | hn
  · subst h
    simp [extendHom_add_one g hn]
  · obtain rfl : n = m - 1 := by omega
    simp [extendHom_sub_one g (show m ≤ 0 by omega)]

instance : (eval (e := e)).Faithful where
  map_injective h := hom_ext_of_f_zero h

instance : (eval (e := e)).Full where
  map_surjective g := ⟨{ f := extendHom g, comm := extendHom_comm g }, extendHom_zero g⟩

/-- The terms of a sequence with a prescribed term `A` in degree zero: `e` applied `n` times to
`A` in positive degrees, and `e.inverse` applied `-n` times in negative degrees. -/
private noncomputable def ofObjX (e : C ≌ C) (A : C) (n : ℤ) : C :=
  Int.inductionOn' (motive := fun _ ↦ C) n 0 A (fun _ _ B ↦ e.functor.obj B)
    (fun _ _ B ↦ e.inverse.obj B)

private lemma ofObjX_zero (e : C ≌ C) (A : C) : ofObjX e A 0 = A := by
  unfold ofObjX
  exact Int.inductionOn'_self

/-- A sequence with a prescribed term in degree zero. -/
private noncomputable def ofObj (A : C) : IntSequence e where
  X := ofObjX e A
  iso n m h :=
    if hn : 0 ≤ n then
      eqToIso (by subst h; exact (Int.inductionOn'_add_one hn).symm)
    else
      eqToIso (by
        obtain rfl : n = m - 1 := by omega
        rw [ofObjX, Int.inductionOn'_sub_one (by omega)]
        rfl) ≪≫ e.counitIso.app (ofObjX e A m)

instance : (eval (e := e)).EssSurj where
  mem_essImage A := ⟨ofObj A, ⟨eqToIso (ofObjX_zero e A)⟩⟩

instance : (eval (e := e)).IsEquivalence where

/-- Reindexing by one corresponds to `e.functor` under evaluation in degree zero. -/
def reindexOneCompEvalIso : reindex (e := e) 1 ⋙ eval ≅ eval ⋙ e.functor :=
  NatIso.ofComponents (fun X ↦ (X.iso 0 (0 + 1) rfl).symm) (fun φ ↦ φ.f_comp_iso_inv 0 _ rfl)

end IntSequence

end CategoryTheory.Equivalence

end

public section

namespace CategoryTheory.Equivalence

open CategoryTheory.Functor IntSequence

variable {C : Type u} [Category.{v} C] (e : C ≌ C)

/-- The shift of `C` by `ℤ` generated by the autoequivalence `e`: the reindexing shift of
`e`-sequences, transported along evaluation in degree zero. Up to isomorphism, the shift by `1`
is `e.functor` (`Equivalence.shiftFunctorOneIso`) and the shift by `-1` is a quasi-inverse of
`e.functor` (`Equivalence.shiftFunctorNegOneIso`). -/
@[instance_reducible]
noncomputable def hasShift : HasShift C ℤ :=
  HasShift.induced (eval (e := e)) ℤ (fun k ↦ eval.inv ⋙ reindex k ⋙ eval)
    (fun _ ↦ (Functor.associator _ _ _).symm ≪≫
      isoWhiskerRight (eval (e := e)).asEquivalence.unitIso.symm _ ≪≫ Functor.leftUnitor _)

/-- The shift by `1` generated by `e` is `e.functor`. -/
noncomputable def shiftFunctorOneIso :
    letI := e.hasShift
    shiftFunctor C (1 : ℤ) ≅ e.functor :=
  -- By `HasShift.shiftFunctor_of_induced`, the shift by one is `eval.inv ⋙ reindex 1 ⋙ eval`.
  isoWhiskerLeft eval.inv reindexOneCompEvalIso ≪≫ (Functor.associator _ _ _).symm ≪≫
    isoWhiskerRight (eval (e := e)).asEquivalence.counitIso _ ≪≫ Functor.leftUnitor _

/-- The shift by `-1` generated by `e` is any functor `G` with `G ⋙ e.functor ≅ 𝟭 C`, for
instance `e.inverse` through the counit of `e`. -/
noncomputable def shiftFunctorNegOneIso {G : C ⥤ C} (ε : G ⋙ e.functor ≅ 𝟭 C) :
    letI := e.hasShift
    shiftFunctor C (-1 : ℤ) ≅ G :=
  letI := e.hasShift
  (Functor.leftUnitor _).symm ≪≫ isoWhiskerRight ε.symm _ ≪≫ Functor.associator _ _ _ ≪≫
    isoWhiskerLeft G (isoWhiskerRight e.shiftFunctorOneIso.symm _ ≪≫
      shiftFunctorCompIsoId C (1 : ℤ) (-1) (by omega)) ≪≫ Functor.rightUnitor _

/-- When `C` is preadditive and `e.functor` is additive, every shift functor generated by `e` is
additive. -/
lemma shiftFunctor_additive [Preadditive C] [e.functor.Additive] (n : ℤ) :
    letI := e.hasShift
    (shiftFunctor C n).Additive := by
  let := e.hasShift
  induction n using Int.induction_on with
  | zero => exact Functor.additive_of_iso (shiftFunctorZero C ℤ).symm
  | succ k ih =>
    exact Functor.additive_of_iso
      (isoWhiskerLeft _ e.shiftFunctorOneIso.symm ≪≫ (shiftFunctorAdd C (k : ℤ) 1).symm)
  | pred k ih =>
    exact Functor.additive_of_iso (isoWhiskerLeft _ (e.shiftFunctorNegOneIso e.counitIso).symm ≪≫
      (shiftFunctorAdd' C (-k : ℤ) (-1) (-k - 1) (by omega)).symm)

end CategoryTheory.Equivalence
