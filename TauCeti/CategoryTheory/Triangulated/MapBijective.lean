module

public import Mathlib.Algebra.FiveLemma
public import Mathlib.CategoryTheory.Triangulated.Functor
public import Mathlib.CategoryTheory.Triangulated.Generators
public import TauCeti.CategoryTheory.Functor.MapBijective

/-!
# Triangulated functors which are fully faithful on generators

Let `G : C ⥤ D` be a triangulated functor between pretriangulated categories and let `P` be a
class of objects of `C`.  If `G` is bijective on morphisms `X ⟶ Y⟦n⟧` for all objects `X` and `Y`
of `P` and every integer `n`, then `G` is bijective on morphisms between any two objects of the
thick closure `P.triangEnvelope`, and more generally between objects lying in every triangulated
subcategory containing `P` which is closed under isomorphisms and retracts
(`CategoryTheory.Functor.map_bijective_of_forall_le`).  This is the dévissage argument by which
a functor is shown to be fully faithful on the triangulated subcategory generated by some objects,
for instance to compare pretriangulated envelopes along a quasi-equivalence of DG categories.

The argument goes through two classes of objects attached to a class `Q`:

* `G.leftMapBijective Q`, the objects `X` such that `G` is bijective on `X ⟶ Y` for every `Y` in
  `Q`;
* `G.rightMapBijective Q`, the objects `Y` such that `G` is bijective on `X ⟶ Y` for every `X`
  in `Q`.

When `Q` is stable under shifts, both are triangulated subcategories closed under isomorphisms and
retracts.  Shifts are handled by the compatibility of `G` with the shift functors
(`CategoryTheory.Functor.map_bijective_shift_iff`), and extensions
by the five lemma (`AddMonoidHom.bijective_of_surjective_of_bijective_of_bijective_of_injective`)
applied to the long exact sequences of `Hom(-, Y)` and of `Hom(X, -)` along a distinguished
triangle and its image under `G`.  The theorem then follows in two steps: the objects of the
generated subcategory lie in `G.leftMapBijective (P.shiftClosure ℤ)`, and then in
`G.rightMapBijective` of that class.

## Main definitions

* `CategoryTheory.Functor.leftMapBijective`: the objects from which `G` is bijective on
  morphisms to a given class.
* `CategoryTheory.Functor.rightMapBijective`: the objects to which `G` is bijective on morphisms
  from a given class.

## Main results

* `CategoryTheory.Pretriangulated.Triangle.exact_leftComp` and
  `CategoryTheory.Pretriangulated.Triangle.exact_rightComp`: the long exact sequences of `Hom(-, Y)`
  and of `Hom(X, -)` at the middle vertex of a distinguished triangle.
* The instances `ObjectProperty.IsTriangulated` for `G.leftMapBijective Q` and
  `G.rightMapBijective Q` when `Q` is stable under shifts.
* `CategoryTheory.Functor.map_bijective_of_forall_le` and
  `CategoryTheory.Functor.map_bijective_of_triangEnvelope`: the dévissage theorem.
-/

public section

namespace CategoryTheory.Pretriangulated

open Limits Preadditive

variable {C : Type*} [Category* C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (CategoryTheory.shiftFunctor C n).Additive] [Pretriangulated C]

/-- **The long exact sequence of `Hom(-, Y)`** at the middle vertex of a distinguished triangle
`T`: precomposition with `T.mor₂` and then with `T.mor₁` is exact. -/
theorem Triangle.exact_leftComp {T : Triangle C} (hT : T ∈ distTriang C) (Y : C) :
    Function.Exact (leftComp Y T.mor₂) (leftComp Y T.mor₁) := by
  intro g
  refine ⟨fun h ↦ ?_, ?_⟩
  · obtain ⟨f, hf⟩ := Triangle.yoneda_exact₂ T hT g h
    exact ⟨f, hf.symm⟩
  · rintro ⟨f, rfl⟩
    exact (comp_distTriang_mor_zero₁₂_assoc T hT f).trans zero_comp

/-- **The long exact sequence of `Hom(X, -)`** at the middle vertex of a distinguished triangle
`T`: postcomposition with `T.mor₁` and then with `T.mor₂` is exact. -/
theorem Triangle.exact_rightComp {T : Triangle C} (hT : T ∈ distTriang C) (X : C) :
    Function.Exact (rightComp X T.mor₁) (rightComp X T.mor₂) := by
  intro g
  refine ⟨fun h ↦ ?_, ?_⟩
  · obtain ⟨f, hf⟩ := Triangle.coyoneda_exact₂ T hT g h
    exact ⟨f, hf.symm⟩
  · rintro ⟨f, rfl⟩
    exact (Category.assoc _ _ _).trans (by rw [comp_distTriang_mor_zero₁₂ T hT, comp_zero])

end CategoryTheory.Pretriangulated

namespace CategoryTheory.Functor

open Category Limits Pretriangulated Preadditive ZeroObject

variable {C D : Type*} [Category* C] [Category* D] (G : C ⥤ D)

/-! ### The classes of objects on which a functor is bijective -/

/-- The objects `X` such that `G` is bijective on morphisms from `X` to every object of `Q`. -/
def leftMapBijective (Q : ObjectProperty C) : ObjectProperty C :=
  fun X ↦ ∀ Y, Q Y → Function.Bijective (G.map : (X ⟶ Y) → (G.obj X ⟶ G.obj Y))

/-- The objects `Y` such that `G` is bijective on morphisms from every object of `Q` to `Y`. -/
def rightMapBijective (Q : ObjectProperty C) : ObjectProperty C :=
  fun Y ↦ ∀ X, Q X → Function.Bijective (G.map : (X ⟶ Y) → (G.obj X ⟶ G.obj Y))

variable {G} in
/-- An object lies in `G.leftMapBijective Q` when `G` is bijective on morphisms from it to every
object of `Q`. -/
theorem leftMapBijective_iff {Q : ObjectProperty C} {X : C} :
    G.leftMapBijective Q X ↔
      ∀ Y, Q Y → Function.Bijective (G.map : (X ⟶ Y) → (G.obj X ⟶ G.obj Y)) :=
  Iff.rfl

variable {G} in
/-- An object lies in `G.rightMapBijective Q` when `G` is bijective on morphisms from every object
of `Q` to it. -/
theorem rightMapBijective_iff {Q : ObjectProperty C} {Y : C} :
    G.rightMapBijective Q Y ↔
      ∀ X, Q X → Function.Bijective (G.map : (X ⟶ Y) → (G.obj X ⟶ G.obj Y)) :=
  Iff.rfl

variable (Q : ObjectProperty C)

instance : (G.leftMapBijective Q).IsClosedUnderIsomorphisms where
  of_iso e hX Y hY := (G.map_bijective_iff_of_iso e (Iso.refl Y)).2 (hX Y hY)

instance : (G.rightMapBijective Q).IsClosedUnderIsomorphisms where
  of_iso e hY X hX := (G.map_bijective_iff_of_iso (Iso.refl X) e).2 (hY X hX)

instance : (G.leftMapBijective Q).IsStableUnderRetracts where
  of_retract r hX' Y hY := G.map_bijective_of_retract r (hX' Y hY)

instance : (G.rightMapBijective Q).IsStableUnderRetracts where
  of_retract r hY' X hX := G.map_bijective_of_retract_target r (hY' X hX)

section shift

variable [HasShift C ℤ] [HasShift D ℤ] [G.CommShift ℤ] [Q.IsStableUnderShift ℤ]

instance : (G.leftMapBijective Q).IsStableUnderShift ℤ where
  isStableUnderShiftBy a := ⟨fun X hX Y hY ↦ by
    have hY' : Q (Y⟦-a⟧) := (Q.prop_shift_iff _ _).1 (Q.le_shift (-a) Y hY)
    exact (G.map_bijective_iff_of_iso (Iso.refl _)
      ((shiftFunctorCompIsoId C (-a) a (neg_add_cancel a)).app Y)).2
        ((G.map_bijective_shift_iff X _ a).2 (hX _ hY'))⟩

instance : (G.rightMapBijective Q).IsStableUnderShift ℤ where
  isStableUnderShiftBy a := ⟨fun Y hY X hX ↦ by
    have hX' : Q (X⟦-a⟧) := (Q.prop_shift_iff _ _).1 (Q.le_shift (-a) X hX)
    exact (G.map_bijective_iff_of_iso
      ((shiftFunctorCompIsoId C (-a) a (neg_add_cancel a)).app X) (Iso.refl _)).2
        ((G.map_bijective_shift_iff _ Y a).2 (hY _ hX'))⟩

end shift

/-! ### Extensions -/

section triangulated

variable [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]

variable [G.CommShift ℤ] [G.IsTriangulated] [Q.IsStableUnderShift ℤ]

instance : (G.leftMapBijective Q).ContainsZero where
  exists_zero := ⟨0, isZero_zero C, fun _ _ ↦
    ⟨fun _ _ _ ↦ (isZero_zero C).eq_of_src _ _,
      fun _ ↦ ⟨0, (G.map_isZero (isZero_zero C)).eq_of_src _ _⟩⟩⟩

instance : (G.rightMapBijective Q).ContainsZero where
  exists_zero := ⟨0, isZero_zero C, fun _ _ ↦
    ⟨fun _ _ _ ↦ (isZero_zero C).eq_of_tgt _ _,
      fun _ ↦ ⟨0, (G.map_isZero (isZero_zero C)).eq_of_tgt _ _⟩⟩⟩

/-- **Extensions of objects of `G.leftMapBijective Q` stay in it**: by the five lemma applied to
the long exact sequences of `Hom(-, Y)` along a distinguished triangle and its image under `G`. -/
instance : (G.leftMapBijective Q).IsTriangulatedClosed₂ :=
  .mk' fun T hT h₁ h₃ Y hY ↦ by
    have h₁' := ((G.leftMapBijective Q).prop_shift_iff _ _).1
      ((G.leftMapBijective Q).le_shift (1 : ℤ) _ h₁)
    have h₃' := ((G.leftMapBijective Q).prop_shift_iff _ _).1
      ((G.leftMapBijective Q).le_shift (-1 : ℤ) _ h₃)
    have hG (T' : Triangle C) (hT' : T' ∈ distTriang C) :=
      Triangle.exact_leftComp (G.map_distinguished T' hT') (G.obj Y)
    simp only [leftMapBijective_iff, ← coe_mapAddHom] at h₁ h₃ h₁' h₃' ⊢
    exact AddMonoidHom.bijective_of_surjective_of_bijective_of_bijective_of_injective
      (leftComp Y T.mor₃) (leftComp Y T.mor₂) (leftComp Y T.mor₁) (leftComp Y T.invRotate.mor₁)
      (leftComp (G.obj Y) (G.map T.mor₃)) (leftComp (G.obj Y) (G.map T.mor₂))
      (leftComp (G.obj Y) (G.map T.mor₁)) (leftComp (G.obj Y) (G.map T.invRotate.mor₁))
      G.mapAddHom G.mapAddHom G.mapAddHom G.mapAddHom G.mapAddHom
      (by ext; exact (G.map_comp _ _).symm) (by ext; exact (G.map_comp _ _).symm)
      (by ext; exact (G.map_comp _ _).symm) (by ext; exact (G.map_comp _ _).symm)
      (Triangle.exact_leftComp (rot_of_distTriang T hT) Y) (Triangle.exact_leftComp hT Y)
      (Triangle.exact_leftComp (inv_rot_of_distTriang T hT) Y)
      (hG _ (rot_of_distTriang T hT)) (hG T hT) (hG _ (inv_rot_of_distTriang T hT))
      (h₁' Y hY).2 (h₃ Y hY) (h₁ Y hY) (h₃' Y hY).1

/-- **Extensions of objects of `G.rightMapBijective Q` stay in it**: by the five lemma applied to
the long exact sequences of `Hom(X, -)` along a distinguished triangle and its image under `G`. -/
instance : (G.rightMapBijective Q).IsTriangulatedClosed₂ :=
  .mk' fun T hT h₁ h₃ X hX ↦ by
    have h₁' := ((G.rightMapBijective Q).prop_shift_iff _ _).1
      ((G.rightMapBijective Q).le_shift (1 : ℤ) _ h₁)
    have h₃' := ((G.rightMapBijective Q).prop_shift_iff _ _).1
      ((G.rightMapBijective Q).le_shift (-1 : ℤ) _ h₃)
    have hG (T' : Triangle C) (hT' : T' ∈ distTriang C) :=
      Triangle.exact_rightComp (G.map_distinguished T' hT') (G.obj X)
    simp only [rightMapBijective_iff, ← coe_mapAddHom] at h₁ h₃ h₁' h₃' ⊢
    exact AddMonoidHom.bijective_of_surjective_of_bijective_of_bijective_of_injective
      (rightComp X T.invRotate.mor₁) (rightComp X T.mor₁) (rightComp X T.mor₂)
      (rightComp X T.mor₃)
      (rightComp (G.obj X) (G.map T.invRotate.mor₁)) (rightComp (G.obj X) (G.map T.mor₁))
      (rightComp (G.obj X) (G.map T.mor₂)) (rightComp (G.obj X) (G.map T.mor₃))
      G.mapAddHom G.mapAddHom G.mapAddHom G.mapAddHom G.mapAddHom
      (by ext; exact (G.map_comp _ _).symm) (by ext; exact (G.map_comp _ _).symm)
      (by ext; exact (G.map_comp _ _).symm) (by ext; exact (G.map_comp _ _).symm)
      (Triangle.exact_rightComp (inv_rot_of_distTriang T hT) X) (Triangle.exact_rightComp hT X)
      (Triangle.exact_rightComp (rot_of_distTriang T hT) X)
      (hG _ (inv_rot_of_distTriang T hT)) (hG T hT) (hG _ (rot_of_distTriang T hT))
      (h₃' X hX).2 (h₁ X hX) (h₃ X hX) (h₁' X hX).1

instance : (G.leftMapBijective Q).IsTriangulated where

instance : (G.rightMapBijective Q).IsTriangulated where

/-! ### Dévissage -/

variable {Q}

/-- **Dévissage of fully faithfulness.**  Let `G` be a triangulated functor which is bijective on
morphisms `X ⟶ Y⟦n⟧` for all objects `X` and `Y` of `P` and every integer `n`.  Then `G` is
bijective on morphisms between objects of `S`, whenever `S` lies in every triangulated
subcategory containing `P` which is closed under isomorphisms and retracts. -/
theorem map_bijective_of_forall_le {P S : ObjectProperty C}
    (hS : ∀ (Q : ObjectProperty C) [Q.IsTriangulated] [Q.IsClosedUnderIsomorphisms]
      [Q.IsStableUnderRetracts], P ≤ Q → S ≤ Q)
    (h : ∀ X Y, P X → P Y → ∀ n : ℤ,
      Function.Bijective (G.map : (X ⟶ Y⟦n⟧) → (G.obj X ⟶ G.obj (Y⟦n⟧))))
    {X Y : C} (hX : S X) (hY : S Y) :
    Function.Bijective (G.map : (X ⟶ Y) → (G.obj X ⟶ G.obj Y)) := by
  -- First, `G` is bijective on morphisms from objects of `S` to shifts of objects of `P`.
  have h₁ : S ≤ G.leftMapBijective (P.shiftClosure ℤ) :=
    hS _ fun X hX Y' ⟨Y, n, e, hY⟩ ↦
      (G.map_bijective_iff_of_iso (Iso.refl X) e.symm).2 (h X Y hX hY n)
  -- Then, `G` is bijective on morphisms from all those objects to objects of `S`.
  have h₂ : S ≤ G.rightMapBijective (G.leftMapBijective (P.shiftClosure ℤ)) :=
    hS _ fun Y hY X hX ↦ hX Y (P.le_shiftClosure Y hY)
  exact h₂ Y hY X (h₁ X hX)

/-- **Dévissage of fully faithfulness over the thick closure.**  A triangulated functor which is
bijective on morphisms `X ⟶ Y⟦n⟧` for all objects `X` and `Y` of `P` and every integer `n` is
bijective on morphisms between objects of the thick closure `P.triangEnvelope`. -/
theorem map_bijective_of_triangEnvelope {P : ObjectProperty C}
    (h : ∀ X Y, P X → P Y → ∀ n : ℤ,
      Function.Bijective (G.map : (X ⟶ Y⟦n⟧) → (G.obj X ⟶ G.obj (Y⟦n⟧))))
    {X Y : C} (hX : P.triangEnvelope X) (hY : P.triangEnvelope Y) :
    Function.Bijective (G.map : (X ⟶ Y) → (G.obj X ⟶ G.obj Y)) :=
  G.map_bijective_of_forall_le (fun _ _ _ _ hPQ ↦ P.triangEnvelope_le_iff.2 hPQ) h hX hY

end triangulated

end CategoryTheory.Functor
