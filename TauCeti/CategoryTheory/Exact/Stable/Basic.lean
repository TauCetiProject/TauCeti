module

public import TauCeti.CategoryTheory.Exact.Frobenius
public import TauCeti.CategoryTheory.Preadditive.MorphismIdeal.Additive
public import TauCeti.CategoryTheory.Preadditive.MorphismIdeal.FactorThrough

/-!
# Stable quotients of exact categories

For an exact structure `E`, this file packages the objects that are both relatively projective
and relatively injective. It also defines `E.StableCategory`, the additive quotient by morphisms
factoring through relative projectives. When `E` is Frobenius, the projectives are exactly the
injectives, so this is the stable category obtained by killing the projective-injective objects.

The quotient is formed with the general morphism-ideal API. In particular, it has the same
objects as the original category, while a morphism becomes zero precisely when it factors
through a relative projective. An object becomes zero precisely when it is relatively
projective; under the Frobenius hypothesis this is equivalently relative injectivity or membership
in the projective-injective class.

This additive category is the input to Happel's construction of the suspension and distinguished
triangles. No triangulated structure is asserted here: that construction requires the full
Frobenius hypothesis and choices of projective-injective conflations.

## Main definitions

* `TauCeti.ExactStructure.projectiveInjective`: the objects that are both projective and
  injective relative to an exact structure.
* `TauCeti.ExactStructure.ProjectiveInjective`: their full subcategory.
* `TauCeti.ExactStructure.stableIdeal`: the ideal of maps generated by factorizations through
  relative projectives.
* `TauCeti.ExactStructure.StableCategory`: the quotient by `stableIdeal`.
* `TauCeti.ExactStructure.stableFunctor`: the quotient functor to the stable category.

## References

* Dieter Happel, *Triangulated Categories in the Representation Theory of Finite Dimensional
  Algebras*, Chapter I, Section 2.
* Theo Bühler, *Exact Categories*, Expositiones Mathematicae **28** (2010), 1–69,
  <https://arxiv.org/abs/0811.1480>, Sections 11–13.
-/

public section

namespace TauCeti

open CategoryTheory CategoryTheory.Limits ZeroObject

universe v u

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasZeroObject C]
  [HasBinaryBiproducts C]

namespace ExactStructure

variable (E : ExactStructure C)

/-- The objects that are both projective and injective relative to `E`. For a Frobenius exact
structure this agrees with either one of those two object properties. -/
def projectiveInjective : ObjectProperty C :=
  E.isProjective ⊓ E.isInjective

/-- Membership in the projective-injective class means simultaneous relative projectivity and
relative injectivity. -/
@[simp]
theorem projectiveInjective_iff (X : C) :
    E.projectiveInjective X ↔ E.isProjective X ∧ E.isInjective X :=
  Iff.rfl

/-- The projective-injective objects form a replete class stable under retracts. -/
instance : E.projectiveInjective.IsStableUnderRetracts where
  of_retract r h :=
    ⟨E.isProjective.prop_of_retract r h.1, E.isInjective.prop_of_retract r h.2⟩

/-- The projective-injective class contains a zero object. -/
instance : E.projectiveInjective.ContainsZero where
  exists_zero := ⟨0, isZero_zero C,
    ⟨E.isProjective.prop_of_isZero (isZero_zero C),
      E.isInjective.prop_of_isZero (isZero_zero C)⟩⟩

/-- Binary biproducts of projective-injective objects are projective-injective. -/
instance : E.projectiveInjective.IsClosedUnderBinaryProducts :=
  ObjectProperty.isClosedUnderBinaryProducts_of_prop_biprod E.projectiveInjective
    fun _ _ h₁ h₂ ↦ ⟨E.isProjective_biprod h₁.1 h₂.1,
      E.isInjective_biprod h₁.2 h₂.2⟩

/-- The projective-injective class is closed under all finite products, hence under finite
biproducts in the ambient preadditive category. -/
noncomputable instance : E.projectiveInjective.IsClosedUnderFiniteProducts := by
  let _ : HasFiniteProducts C := hasFiniteProducts_of_has_binary_and_terminal
  exact ObjectProperty.IsClosedUnderFiniteProducts.mk'

/-- In a Frobenius exact structure, the projective-injective class is the class of relative
projectives. -/
theorem IsFrobenius.projectiveInjective_eq_isProjective {E : ExactStructure C}
    (hE : E.IsFrobenius) : E.projectiveInjective = E.isProjective := by
  apply le_antisymm inf_le_left
  intro X hX
  exact ⟨hX, (hE.projective_iff_injective X).mp hX⟩

/-- In a Frobenius exact structure, the projective-injective class is the class of relative
injectives. -/
theorem IsFrobenius.projectiveInjective_eq_isInjective {E : ExactStructure C}
    (hE : E.IsFrobenius) : E.projectiveInjective = E.isInjective := by
  apply le_antisymm inf_le_right
  intro X hX
  exact ⟨(hE.projective_iff_injective X).mpr hX, hX⟩

/-- The full subcategory of objects that are both projective and injective relative to `E`. -/
abbrev ProjectiveInjective := E.projectiveInjective.FullSubcategory

/-- The ideal generated by morphisms factoring through relative projective objects. For a
Frobenius exact structure these are exactly the projective-injective objects. -/
def stableIdeal : MorphismIdeal C :=
  E.isProjective.factorIdeal

/-- The stable category of `E`, formed by quotienting morphisms by those factoring through
relative projectives. This is the projective-injective stable category when `E` is Frobenius. -/
abbrev StableCategory := E.stableIdeal.Quotient

/-- The quotient functor from an exact category to its stable category. -/
abbrev stableFunctor : CategoryTheory.Functor C E.StableCategory :=
  E.stableIdeal.quotientFunctor

/-- Membership in the stable ideal is equivalent to factoring through a relative projective. -/
@[simp]
theorem mem_stableIdeal_iff {X Y : C} {f : X ⟶ Y} :
    f ∈ E.stableIdeal.hom X Y ↔ E.isProjective.FactorsThrough f := by
  rw [stableIdeal, ObjectProperty.mem_factorIdeal_iff]

/-- In a Frobenius exact structure, the stable ideal is generated by factorizations through the
projective-injective objects. -/
theorem IsFrobenius.stableIdeal_eq_factorIdeal {E : ExactStructure C} (hE : E.IsFrobenius) :
    E.stableIdeal = E.projectiveInjective.factorIdeal := by
  rw [stableIdeal, hE.projectiveInjective_eq_isProjective]

/-- A morphism becomes zero in the stable category exactly when it factors through a relative
projective. -/
@[simp]
theorem stableFunctor_map_eq_zero_iff {X Y : C} {f : X ⟶ Y} :
    E.stableFunctor.map f = 0 ↔ E.isProjective.FactorsThrough f := by
  rw [MorphismIdeal.quotientFunctor_map_eq_zero_iff, mem_stableIdeal_iff]

/-- For a Frobenius exact structure, a morphism becomes zero in the stable category exactly when
it factors through a projective-injective object. -/
theorem IsFrobenius.stableFunctor_map_eq_zero_iff {E : ExactStructure C}
    (hE : E.IsFrobenius) {X Y : C} {f : X ⟶ Y} :
    E.stableFunctor.map f = 0 ↔ E.projectiveInjective.FactorsThrough f := by
  rw [ExactStructure.stableFunctor_map_eq_zero_iff E,
    hE.projectiveInjective_eq_isProjective]

/-- An object becomes zero in the stable category exactly when it is relatively projective. -/
@[simp]
theorem isZero_stableFunctor_obj_iff (X : C) :
    IsZero (E.stableFunctor.obj X) ↔ E.isProjective X := by
  rw [MorphismIdeal.isZero_quotientFunctor_obj_iff, mem_stableIdeal_iff,
    ObjectProperty.factorsThrough_id_iff]

/-- For a Frobenius exact structure, an object becomes zero in the stable category exactly when
it is projective-injective. -/
theorem IsFrobenius.isZero_stableFunctor_obj_iff {E : ExactStructure C}
    (hE : E.IsFrobenius) (X : C) :
    IsZero (E.stableFunctor.obj X) ↔ E.projectiveInjective X :=
  (ExactStructure.isZero_stableFunctor_obj_iff E X).trans (by
    rw [hE.projectiveInjective_eq_isProjective])

/-- For a Frobenius exact structure, an object becomes zero in the stable category exactly when
it is relatively injective. -/
theorem IsFrobenius.isZero_stableFunctor_obj_iff_isInjective {E : ExactStructure C}
    (hE : E.IsFrobenius) (X : C) :
    IsZero (E.stableFunctor.obj X) ↔ E.isInjective X :=
  (ExactStructure.isZero_stableFunctor_obj_iff E X).trans
    (hE.projective_iff_injective X)

end ExactStructure

end TauCeti
