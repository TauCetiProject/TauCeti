/-!
# Functoriality of additive-ideal quotients

If an additive functor sends one morphism ideal into another, it descends to a functor between the
two quotient categories. This file supplies the functorial part of the generic ideal quotient; the
ideal itself need not be generated by projectives or by any other class of objects.

The descended functor is characterized by its strict composite with the quotient functor. Natural
transformations descend as well. When the original functor is full and essentially surjective, the
descended functor has the same properties. Faithfulness additionally requires the exact reflection
condition on ideal membership: an equivalence of the original categories need not induce an
equivalence of quotients unless it transports the ideals in both directions.

This is the functorial quotient construction used later for stable categories. It uses Mathlib's
quotient universal property and does not introduce a second quotient category implementation.

## References

* M. Auslander, I. Reiten, A. Smalø, *Representation Theory of Artin Algebras*, Chapter IV §1.
* D. Happel, *Triangulated Categories in the Representation Theory of Finite Dimensional Algebras*,
  Chapter I §2.
-/

public section

universe v u v' u'

namespace TauCeti

open CategoryTheory

namespace MorphismIdeal

variable {C : Type u} [Category.{v} C] [Preadditive C]
  {D : Type u'} [Category.{v'} D] [Preadditive D]

section Map

variable (I : MorphismIdeal C) (J : MorphismIdeal D)
  (F : C ⥤ D) [F.Additive]

/-- A functor that maps an ideal into a target ideal maps each ideal member into the target ideal.
-/
theorem map_mem (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    {X Y : C} {f : X ⟶ Y} (hf : f ∈ I.hom X Y) :
    F.map f ∈ J.hom (F.obj X) (F.obj Y) := by
  apply J.quotientFunctor_map_eq_zero_iff.1
  simpa only [Functor.comp_map] using
    (Functor.mem_kerIdeal_hom (F ⋙ J.quotientFunctor)).1 (le_def.1 hF _ hf)

/-- The functor induced by an additive functor which maps `I` into `J`. -/
@[expose] noncomputable def map (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal) :
    I.Quotient ⥤ J.Quotient :=
  I.lift (F ⋙ J.quotientFunctor) hF

/-- The functor induced on quotients by an additive functor is additive. -/
instance map_additive (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal) :
    (I.map J F hF).Additive := by
  -- Exposing the quotient lift here lets the inherited additive instance match `map`.
  change (I.lift (F ⋙ J.quotientFunctor) hF).Additive
  infer_instance

/-- The defining equation for the functor induced on quotients. -/
@[simp]
theorem quotientFunctor_comp_map (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal) :
    I.quotientFunctor ⋙ I.map J F hF = F ⋙ J.quotientFunctor :=
  CategoryTheory.Quotient.lift_spec I.rel (F ⋙ J.quotientFunctor)
    (fun _ _ _ _ h ↦ I.map_eq_of_rel (F ⋙ J.quotientFunctor) hF h)

/-- The induced functor maps a quotient representative to the corresponding representative. -/
@[simp]
theorem map_quotientFunctor_map (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    {X Y : C} (f : X ⟶ Y) :
    (I.map J F hF).map (I.quotientFunctor.map f) = J.quotientFunctor.map (F.map f) := by
  rfl

end Map

section Opposite

variable (I : MorphismIdeal C)

/-- The opposite ideal: a morphism belongs to `I.op` exactly when its unopposite belongs to `I`.

The reversal of composition in the opposite category exchanges the two ideal laws, so no
commutativity or closure assumption on `I` is needed. -/
def op : MorphismIdeal Cᵒᵖ where
  hom X Y := (I.hom Y.unop X.unop).comap (unopHom X Y)
  comp_mem_left := by
    intro X Y Z f g hg
    -- The opposite-category composite is the original composite in reverse order.
    change (f ≫ g).unop ∈ I.hom Z.unop X.unop
    rw [unop_comp]
    exact I.comp_mem_right f.unop hg
  comp_mem_right := by
    intro X Y Z f g hf
    -- The opposite-category composite is the original composite in reverse order.
    change (f ≫ g).unop ∈ I.hom Z.unop X.unop
    rw [unop_comp]
    exact I.comp_mem_left g.unop hf

@[simp]
theorem mem_op_hom {X Y : Cᵒᵖ} {f : X ⟶ Y} :
    f ∈ I.op.hom X Y ↔ f.unop ∈ I.hom Y.unop X.unop := by
  rfl

/-- Inclusion of ideals is preserved by taking opposites. -/
theorem op_mono {I J : MorphismIdeal C} (h : I ≤ J) : I.op ≤ J.op := by
  intro X Y f hf
  exact le_def.1 h f.unop (I.mem_op_hom.1 hf)

end Opposite

section Identity

variable (I : MorphismIdeal C)

/-- The identity functor induces the identity functor on an ideal quotient. -/
theorem map_id (hI : I ≤ ((𝟭 C) ⋙ I.quotientFunctor).kerIdeal) :
    I.map I (𝟭 C) hI = 𝟭 I.Quotient := by
  apply CategoryTheory.Quotient.lift_unique'
  rw [I.quotientFunctor_comp_map]
  rfl

end Identity

section Composition

variable (I : MorphismIdeal C) (J : MorphismIdeal D)
  {E : Type*} [Category* E] [Preadditive E]
  (K : MorphismIdeal E) (F : C ⥤ D) (G : D ⥤ E) [F.Additive] [G.Additive]

/-- The composite of two ideal-preserving functors preserves the source ideal. -/
theorem map_comp_mem (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    (hG : J ≤ (G ⋙ K.quotientFunctor).kerIdeal) :
    I ≤ ((F ⋙ G) ⋙ K.quotientFunctor).kerIdeal := by
  intro X Y f hf
  rw [Functor.mem_kerIdeal_hom, Functor.comp_map, Functor.comp_map]
  exact (Functor.mem_kerIdeal_hom (G ⋙ K.quotientFunctor)).1
    (le_def.1 hG _ (I.map_mem J F hF hf))

/-- Inducing a functor commutes with composition. -/
theorem map_comp (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    (hG : J ≤ (G ⋙ K.quotientFunctor).kerIdeal) :
    I.map K (F ⋙ G) (I.map_comp_mem J K F G hF hG) =
      I.map J F hF ⋙ J.map K G hG := by
  apply CategoryTheory.Quotient.lift_unique'
  -- Both sides are quotient lifts of the same composite functor.
  rfl

end Composition

section NaturalTransformation

variable (I : MorphismIdeal C) (J : MorphismIdeal D)
  {F G : C ⥤ D} [F.Additive] [G.Additive]

/-- The natural transformation induced on quotients by a natural transformation upstairs.

Its component at the quotient object represented by `X` is the target quotient of the original
component at `X`. -/
noncomputable def mapNatTrans (τ : F ⟶ G)
    (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    (hG : I ≤ (G ⋙ J.quotientFunctor).kerIdeal) :
    I.map J F hF ⟶ I.map J G hG := by
  apply CategoryTheory.Quotient.natTransLift I.rel
  refine { app := fun X => J.quotientFunctor.map (τ.app X), naturality := ?_ }
  intro X Y f
  -- The quotient-lift maps on a representative are the target quotient of its image.
  change J.quotientFunctor.map (F.map f) ≫ J.quotientFunctor.map (τ.app Y) =
    J.quotientFunctor.map (τ.app X) ≫ J.quotientFunctor.map (G.map f)
  simpa only [Functor.comp_map, ← J.quotientFunctor.map_comp] using
    congrArg J.quotientFunctor.map (τ.naturality f)

/-- The components of an induced transformation on represented quotient objects. -/
@[simp]
theorem mapNatTrans_app (τ : F ⟶ G)
    (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    (hG : I ≤ (G ⋙ J.quotientFunctor).kerIdeal) (X : C) :
    (I.mapNatTrans J τ hF hG).app (I.quotientFunctor.obj X) =
      J.quotientFunctor.map (τ.app X) := by
  rfl

/-- The induced transformation of an identity transformation is the identity. -/
theorem mapNatTrans_id (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal) :
    I.mapNatTrans J (𝟙 F) hF hF = 𝟙 (I.map J F hF) := by
  apply CategoryTheory.Quotient.natTrans_ext
  apply NatTrans.ext
  funext X
  -- Unfolding the lifted component reduces the claim to preservation of identities.
  change J.quotientFunctor.map (𝟙 (F.obj X)) =
    𝟙 (J.quotientFunctor.obj (F.obj X))
  simp

/-- Induced natural transformations preserve vertical composition. -/
theorem mapNatTrans_comp {H : C ⥤ D} [H.Additive] (τ : F ⟶ G) (σ : G ⟶ H)
    (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    (hG : I ≤ (G ⋙ J.quotientFunctor).kerIdeal)
    (hH : I ≤ (H ⋙ J.quotientFunctor).kerIdeal) :
    I.mapNatTrans J (τ ≫ σ) hF hH =
      I.mapNatTrans J τ hF hG ≫ I.mapNatTrans J σ hG hH := by
  apply CategoryTheory.Quotient.natTrans_ext
  apply NatTrans.ext
  funext X
  -- The components are the target quotient of the composite components upstairs.
  rfl

end NaturalTransformation

section Equivalence

variable (I : MorphismIdeal C) (J : MorphismIdeal D) (F : C ⥤ D) [F.Additive]

/-- The exact reflection condition needed for the induced quotient functor to be faithful. -/
def Reflects : Prop :=
  ∀ ⦃X Y : C⦄ (f : X ⟶ Y), F.map f ∈ J.hom (F.obj X) (F.obj Y) → f ∈ I.hom X Y

/-- Fullness descends through an ideal quotient. -/
instance map_full (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal) [F.Full] :
    (I.map J F hF).Full where
  map_surjective := by
    rintro ⟨X⟩ ⟨Y⟩ f
    obtain ⟨f, rfl⟩ := J.quotientFunctor.map_surjective f
    obtain ⟨f, rfl⟩ := F.map_surjective f
    exact ⟨I.quotientFunctor.map f, rfl⟩

/-- Faithfulness of the induced functor from reflection of the ideal. -/
theorem faithful_map (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    (hR : I.Reflects J F) :
    (I.map J F hF).Faithful where
  map_injective := by
    rintro ⟨X⟩ ⟨Y⟩ f g h
    obtain ⟨f, rfl⟩ := I.quotientFunctor.map_surjective f
    obtain ⟨g, rfl⟩ := I.quotientFunctor.map_surjective g
    apply I.quotientFunctor_map_eq_iff.2
    apply hR (f - g)
    have hmem : F.map f - F.map g ∈ J.hom (F.obj X) (F.obj Y) := by
      apply J.quotientFunctor_map_eq_iff.1
      -- Replace quotient-lift maps by their representative formula.
      change J.quotientFunctor.map (F.map f) = J.quotientFunctor.map (F.map g) at h
      exact h
    rw [← F.map_sub] at hmem
    exact hmem

/-- Essential surjectivity descends to quotient functors. -/
instance map_essSurj (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal) [F.EssSurj] :
    (I.map J F hF).EssSurj where
  mem_essImage X :=
    ⟨I.quotientFunctor.obj (F.objPreimage X.as), by
      -- The quotient functor carries the chosen essential-image isomorphism.
      change Nonempty
        (J.quotientFunctor.obj (F.obj (F.objPreimage X.as)) ≅
          J.quotientFunctor.obj X.as)
      exact ⟨J.quotientFunctor.mapIso (F.objObjPreimageIso X.as)⟩⟩

/-- An equivalence transporting the ideal in both directions induces an equivalence of quotients. -/
theorem isEquivalence_map (hF : I ≤ (F ⋙ J.quotientFunctor).kerIdeal)
    (hR : I.Reflects J F) [F.IsEquivalence] :
    (I.map J F hF).IsEquivalence := by
  exact ⟨I.faithful_map J F hF hR, inferInstance, inferInstance⟩

end Equivalence

end MorphismIdeal

