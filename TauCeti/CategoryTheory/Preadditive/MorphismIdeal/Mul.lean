/-!
# Products and powers of ideals of a preadditive category

The **product** `I * J` of two two-sided ideals of a preadditive category is the ideal additively
generated by the composites `g ≫ f` with `g` in `J` and `f` in `I`. The order matches the
multiplication of `CategoryTheory.End`, where `f * g = g ≫ f`: for endomorphisms `f` in `I` and
`g` in `J` of one object, `f * g` lies in `I * J`. The product at a single object may be larger than
the product of the two ideals of its endomorphism ring, since it also contains composites through
other objects. The ideal `⊤` of all morphisms is a
unit, so ideals form a monoid. The powers `I ^ n` are the monoid powers, with `I ^ 0 = ⊤`; the
powers of the radical of a category are the motivating example.

Every composite of a morphism in `J` followed by one in `I` lies in both ideals, so `I * J ≤ I`
and `I * J ≤ J`, and the powers of an ideal decrease. In a category with binary biproducts the
generating composites are closed under addition: a sum of two composites is one composite
through a biproduct. So every morphism of `I * J` is itself a single composite
(`TauCeti.MorphismIdeal.mem_mul_iff_exists_comp`).

## Main definitions

* `I * J`: the product of two ideals.
* `TauCeti.MorphismIdeal.instMonoid`: ideals form a monoid with unit `⊤`, which gives the powers
  `I ^ n`.

## Main results

* `TauCeti.MorphismIdeal.mul_le_iff` and `TauCeti.MorphismIdeal.mul_hom_le_iff`: the product is
  the smallest ideal, and each `(I * J)(X, Y)` the smallest subgroup, containing the composites.
* `TauCeti.MorphismIdeal.mul_le_left`, `TauCeti.MorphismIdeal.mul_le_right`: `I * J ≤ I` and
  `I * J ≤ J`.
* `TauCeti.MorphismIdeal.instMulLeftMono`, `TauCeti.MorphismIdeal.instMulRightMono`: the product
  is monotone, so Mathlib's ordered-monoid lemmas apply; in particular the powers of an ideal
  decrease.
* `TauCeti.MorphismIdeal.mem_mul_iff_exists_comp`: with binary biproducts, the members of
  `I * J` are exactly the composites.
-/

public section

namespace TauCeti.MorphismIdeal

open CategoryTheory

universe v u

variable {C : Type u} [Category.{v} C] [Preadditive C]

/-! ### Products -/

/-- The composites `g ≫ f` with `g` in `J` and `f` in `I`, as a set of morphisms `X ⟶ Y`. -/
def compSet (I J : MorphismIdeal C) (X Y : C) : Set (X ⟶ Y) :=
  {h | ∃ (Z : C) (g : X ⟶ Z) (f : Z ⟶ Y), g ∈ J.hom X Z ∧ f ∈ I.hom Z Y ∧ g ≫ f = h}

/-- The **product** `I * J` of two ideals: the ideal additively generated by the composites
`g ≫ f` with `g` in `J` and `f` in `I`. -/
instance : Mul (MorphismIdeal C) where
  mul I J :=
    { hom X Y := AddSubgroup.closure (compSet I J X Y)
      comp_mem_left {X Y Z} e {h} hh := by
        induction hh using AddSubgroup.closure_induction with
        | mem h hh =>
          obtain ⟨W, g, f, hg, hf, rfl⟩ := hh
          exact AddSubgroup.subset_closure ⟨W, e ≫ g, f, J.comp_mem_left e hg, hf, by simp⟩
        | zero => simp
        | add a b _ _ ha hb => simpa using add_mem ha hb
        | neg a _ ha => simpa using neg_mem ha
      comp_mem_right {X Y Z} {h} e hh := by
        induction hh using AddSubgroup.closure_induction with
        | mem h hh =>
          obtain ⟨W, g, f, hg, hf, rfl⟩ := hh
          exact AddSubgroup.subset_closure ⟨W, g, f ≫ e, hg, I.comp_mem_right e hf, by simp⟩
        | zero => simp
        | add a b _ _ ha hb => simpa using add_mem ha hb
        | neg a _ ha => simpa using neg_mem ha }

theorem mul_hom (I J : MorphismIdeal C) (X Y : C) :
    (I * J).hom X Y = AddSubgroup.closure (compSet I J X Y) :=
  rfl

/-- A composite of a member of `J` followed by a member of `I` lies in `I * J`. -/
theorem comp_mem_mul {I J : MorphismIdeal C} {X Z Y : C} {g : X ⟶ Z} {f : Z ⟶ Y}
    (hg : g ∈ J.hom X Z) (hf : f ∈ I.hom Z Y) : g ≫ f ∈ (I * J).hom X Y :=
  AddSubgroup.subset_closure ⟨Z, g, f, hg, hf, rfl⟩

/-- The universal property of `(I * J)(X, Y)`: an additive subgroup of `X ⟶ Y` contains it
exactly when it contains every composite of a member of `J` followed by a member of `I`. -/
@[simp]
theorem mul_hom_le_iff {I J : MorphismIdeal C} {X Y : C} {K : AddSubgroup (X ⟶ Y)} :
    (I * J).hom X Y ≤ K ↔ ∀ (Z : C) (g : X ⟶ Z) (f : Z ⟶ Y),
      g ∈ J.hom X Z → f ∈ I.hom Z Y → g ≫ f ∈ K := by
  refine ⟨fun h Z g f hg hf ↦ h (comp_mem_mul hg hf), fun h ↦ ?_⟩
  refine (AddSubgroup.closure_le K).mpr ?_
  rintro _ ⟨Z, g, f, hg, hf, rfl⟩
  exact h Z g f hg hf

/-- The product is the smallest ideal containing the composites of a member of `J` followed by a
member of `I`. -/
@[simp]
theorem mul_le_iff {I J K : MorphismIdeal C} :
    I * J ≤ K ↔ ∀ ⦃X Z Y : C⦄ (g : X ⟶ Z) (f : Z ⟶ Y),
      g ∈ J.hom X Z → f ∈ I.hom Z Y → g ≫ f ∈ K.hom X Y := by
  refine ⟨fun h X Z Y g f hg hf ↦ le_def.mp h _ (comp_mem_mul hg hf), fun h ↦ ?_⟩
  exact le_def.mpr fun X Y e he ↦ mul_hom_le_iff.mpr (fun Z g f hg hf ↦ h g f hg hf) he

/-- The product is contained in its left factor: a composite `g ≫ f` with `f` in `I` lies in `I`,
since `I` is closed under precomposition. In particular every positive power of an ideal lies in
it. -/
theorem mul_le_left (I J : MorphismIdeal C) : I * J ≤ I :=
  mul_le_iff.mpr fun _ _ _ g _ _ hf ↦ I.comp_mem_left g hf

/-- The product is contained in its right factor: a composite `g ≫ f` with `g` in `J` lies in
`J`, since `J` is closed under postcomposition. -/
theorem mul_le_right (I J : MorphismIdeal C) : I * J ≤ J :=
  mul_le_iff.mpr fun _ _ _ _ f hg _ ↦ J.comp_mem_right f hg

/-- The product is monotone in both factors. -/
theorem mul_le_mul {I I' J J' : MorphismIdeal C} (hI : I ≤ I') (hJ : J ≤ J') :
    I * J ≤ I' * J' :=
  mul_le_iff.mpr fun _ _ _ _ _ hg hf ↦ comp_mem_mul (le_def.mp hJ _ hg) (le_def.mp hI _ hf)

/-- The zero ideal is absorbing on the left. -/
@[simp]
theorem bot_mul (I : MorphismIdeal C) : ⊥ * I = ⊥ :=
  le_antisymm (mul_le_left _ _) bot_le

/-- The zero ideal is absorbing on the right. -/
@[simp]
theorem mul_bot (I : MorphismIdeal C) : I * ⊥ = ⊥ :=
  le_antisymm (mul_le_right _ _) bot_le

/-- The ideal of all morphisms is a left unit for the product. -/
@[simp]
theorem top_mul (I : MorphismIdeal C) : ⊤ * I = I :=
  le_antisymm (mul_le_right _ _) <| le_def.mpr fun X Y f hf ↦ by
    simpa using comp_mem_mul (I := ⊤) hf (mem_top (𝟙 Y))

/-- The ideal of all morphisms is a right unit for the product. -/
@[simp]
theorem mul_top (I : MorphismIdeal C) : I * ⊤ = I :=
  le_antisymm (mul_le_left _ _) <| le_def.mpr fun X Y f hf ↦ by
    simpa using comp_mem_mul (J := ⊤) (mem_top (𝟙 X)) hf

/-- Ideals form a monoid under the product, with unit the ideal of all morphisms. -/
instance instMonoid : Monoid (MorphismIdeal C) where
  mul_assoc I J K := by
    refine le_antisymm (mul_le_iff.mpr fun X Z Y g f hg hf ↦ ?_)
      (mul_le_iff.mpr fun X Z Y g f hg hf ↦ ?_)
    · rw [mul_hom] at hf
      induction hf using AddSubgroup.closure_induction with
      | mem x hx =>
        obtain ⟨W, a, b, ha, hb, rfl⟩ := hx
        rw [← Category.assoc]
        exact comp_mem_mul (comp_mem_mul hg ha) hb
      | zero => simp
      | add x y _ _ hx hy => simpa using add_mem hx hy
      | neg x _ hx => simpa using neg_mem hx
    · rw [mul_hom] at hg
      induction hg using AddSubgroup.closure_induction with
      | mem x hx =>
        obtain ⟨W, a, b, ha, hb, rfl⟩ := hx
        rw [Category.assoc]
        exact comp_mem_mul ha (comp_mem_mul hb hf)
      | zero => simp
      | add x y _ _ hx hy => simpa using add_mem hx hy
      | neg x _ hx => simpa using neg_mem hx
  one := ⊤
  one_mul := top_mul
  mul_one := mul_top

@[simp]
theorem one_eq_top : (1 : MorphismIdeal C) = ⊤ :=
  rfl

/-- The product is monotone in its right factor. With `MorphismIdeal.instMulRightMono`, this gives
Mathlib's ordered-monoid API: for instance the powers of an ideal decrease, by
`pow_le_pow_right_of_le_one'` applied to `le_top`. -/
instance instMulLeftMono : MulLeftMono (MorphismIdeal C) :=
  ⟨fun _ _ _ h ↦ mul_le_mul le_rfl h⟩

/-- The product is monotone in its left factor. -/
instance instMulRightMono : MulRightMono (MorphismIdeal C) :=
  ⟨fun _ _ _ h ↦ mul_le_mul h le_rfl⟩

/-! ### Products in a category with binary biproducts -/

section Biproducts

variable [Limits.HasBinaryBiproducts C]

/-- In a category with binary biproducts, the members of the product `I * J` are exactly the
composites of a member of `J` followed by a member of `I`: a sum of two such composites factors
through the biproduct of their middle objects. -/
theorem mem_mul_iff_exists_comp {I J : MorphismIdeal C} {X Y : C} {h : X ⟶ Y} :
    h ∈ (I * J).hom X Y ↔ ∃ (Z : C) (g : X ⟶ Z) (f : Z ⟶ Y),
      g ∈ J.hom X Z ∧ f ∈ I.hom Z Y ∧ g ≫ f = h := by
  refine ⟨fun hh ↦ ?_, fun ⟨Z, g, f, hg, hf, e⟩ ↦ e ▸ comp_mem_mul hg hf⟩
  rw [mul_hom] at hh
  induction hh using AddSubgroup.closure_induction with
  | mem h hh => exact hh
  | zero => exact ⟨X, 0, 0, zero_mem _, zero_mem _, by simp⟩
  | add a b _ _ ha hb =>
    obtain ⟨Z₁, g₁, f₁, hg₁, hf₁, rfl⟩ := ha
    obtain ⟨Z₂, g₂, f₂, hg₂, hf₂, rfl⟩ := hb
    refine ⟨Z₁ ⊞ Z₂, Limits.biprod.lift g₁ g₂, Limits.biprod.desc f₁ f₂, ?_, ?_, by simp⟩
    · rw [Limits.biprod.lift_eq]
      exact add_mem (J.comp_mem_right Limits.biprod.inl hg₁)
        (J.comp_mem_right Limits.biprod.inr hg₂)
    · rw [Limits.biprod.desc_eq]
      exact add_mem (I.comp_mem_left Limits.biprod.fst hf₁)
        (I.comp_mem_left Limits.biprod.snd hf₂)
  | neg a _ ha =>
    obtain ⟨Z, g, f, hg, hf, rfl⟩ := ha
    exact ⟨Z, -g, f, neg_mem hg, hf, by simp⟩

end Biproducts

end TauCeti.MorphismIdeal
