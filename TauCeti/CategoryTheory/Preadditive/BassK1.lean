/-!
# The automorphism presentation of `K₁` of an additive category

For a category `C` with zero morphisms and binary biproducts -- an additive category, in the
intended application -- `TauCeti.BassK1 C` is Bass's `K₁` of `C`: the abelian group generated by
the automorphisms `α : Aut X` of objects of `C`, written `[X, α]`, subject to

* conjugation invariance: `[Y, f α f⁻¹] = [X, α]` for every isomorphism `f : X ≅ Y`;
* composition: `[X, α β] = [X, α] + [X, β]`;
* direct sums: `[X ⊞ Y, α ⊞ β] = [X, α] + [Y, β]`.

For the category of finitely generated projective modules over a ring `R`, Bass's comparison
theorem identifies this group with the matrix `K₁(R)`, the abelianization of the stable general
linear group (Weibel, Chapter III, Corollary 1.6.3); the comparison is not proved in this file.
The presentation by automorphisms of objects, rather than by matrices, is what the boundary map of
relative `K`-theory is defined on, which is why it is phrased for an arbitrary category with
biproducts.

In a preadditive category the presentation already satisfies the split-exact relation
(`TauCeti.BassK1.of_eq_add_of_inl_comp_eq` and `TauCeti.BassK1.of_eq_add_of_inr_comp_eq`): an
automorphism `φ` of `X ⊞ Y` preserving the summand `X`, acting on it by `α` and inducing `β` on
the quotient `Y`, has class `[X, α] + [Y, β]`, whatever its off-diagonal block. The key step is
that the unipotent automorphisms `Biprod.unipotentUpper` and `Biprod.unipotentLower` have trivial
class (`TauCeti.BassK1.of_unipotentUpper`, `TauCeti.BassK1.of_unipotentLower`): after adding a
second copy of the target summand, a unipotent automorphism becomes a commutator of two
unipotent automorphisms of the three-fold biproduct, and the class of a commutator vanishes
because the class map is a homomorphism to an abelian group.

The group is functorial in functors preserving zero morphisms and binary biproducts, in
particular in additive functors between preadditive categories (`TauCeti.BassK1.map`), and
naturally isomorphic functors induce the same map, so that `BassK1` is invariant under
equivalences of categories (`TauCeti.BassK1.mapEquiv`).

No smallness is assumed: `BassK1 C` lives in the universe of the objects and morphisms of `C`.
Every element of `BassK1 C` is the class of a single automorphism (`TauCeti.BassK1.exists_eq_of`).

## Main definitions

* `TauCeti.BassK1 C`: Bass's `K₁` of `C`, with class map `TauCeti.BassK1.of`.
* `TauCeti.BassK1.Invariant C G`: a family of functions on the automorphism groups of the objects
  of `C`, satisfying the three defining relations, and `TauCeti.BassK1.lift` the homomorphism it
  induces.
* `TauCeti.BassK1.map` and `TauCeti.BassK1.mapEquiv`: functoriality and invariance under
  equivalences of categories.

## Main results

* `TauCeti.BassK1.of_mul`, `TauCeti.BassK1.of_one`, `TauCeti.BassK1.of_inv`,
  `TauCeti.BassK1.of_conj`, `TauCeti.BassK1.of_congr`, `TauCeti.BassK1.of_biprod`: the defining
  relations and their first consequences.
* `TauCeti.BassK1.of_commutatorElement`: commutators of automorphisms have trivial class.
* `TauCeti.BassK1.of_eq_add_of_inl_comp_eq`, `TauCeti.BassK1.of_eq_add_of_inr_comp_eq`: the
  triangular relation.
* `TauCeti.BassK1.exists_eq_of`: every element is the class of one automorphism.

## References

* Hyman Bass, *Algebraic K-theory*, W. A. Benjamin, 1968, Chapter VII, Section 1, where `K₁` of a
  category with a product is defined by this presentation.
* Charles A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, Chapter III, Section 1,
  Lemma 1.6 and Corollary 1.6.3, for the automorphism presentation of `K₁` of a ring, and Chapter
  III, Section 1.3 (Whitehead's lemma) for the commutator trick behind the triangular relation.
-/

public section

namespace TauCeti

open CategoryTheory CategoryTheory.Limits
open scoped commutatorElement

universe v v' v'' u u' u''

section Relations

variable (C : Type u) [Category.{v} C] [HasZeroMorphisms C] [HasBinaryBiproducts C]

/-- The defining relations of Bass's `K₁`: conjugation invariance, additivity under composition
and additivity under binary biproducts, as elements of the free abelian group on all
automorphisms of objects of `C`. -/
def bassRelations : Set (FreeAddCommGroup (Σ X : C, Aut X)) :=
  {r | (∃ (X Y : C) (e : X ≅ Y) (α : Aut X),
        r = FreeAddCommGroup.of ⟨Y, Aut.autMulEquivOfIso e α⟩ - FreeAddCommGroup.of ⟨X, α⟩) ∨
      (∃ (X : C) (α β : Aut X), r = FreeAddCommGroup.of ⟨X, α * β⟩ -
        FreeAddCommGroup.of ⟨X, α⟩ - FreeAddCommGroup.of ⟨X, β⟩) ∨
      (∃ (X Y : C) (α : Aut X) (β : Aut Y),
        r = FreeAddCommGroup.of ⟨X ⊞ Y, Aut.of (biprod.mapIso α.asIso β.asIso)⟩ -
          FreeAddCommGroup.of ⟨X, α⟩ - FreeAddCommGroup.of ⟨Y, β⟩)}

variable {C} in
/-- Membership in the defining relations of Bass's `K₁`. -/
theorem mem_bassRelations_iff {r : FreeAddCommGroup (Σ X : C, Aut X)} :
    r ∈ bassRelations C ↔
      (∃ (X Y : C) (e : X ≅ Y) (α : Aut X),
        r = FreeAddCommGroup.of ⟨Y, Aut.autMulEquivOfIso e α⟩ - FreeAddCommGroup.of ⟨X, α⟩) ∨
      (∃ (X : C) (α β : Aut X), r = FreeAddCommGroup.of ⟨X, α * β⟩ -
        FreeAddCommGroup.of ⟨X, α⟩ - FreeAddCommGroup.of ⟨X, β⟩) ∨
      (∃ (X Y : C) (α : Aut X) (β : Aut Y),
        r = FreeAddCommGroup.of ⟨X ⊞ Y, Aut.of (biprod.mapIso α.asIso β.asIso)⟩ -
          FreeAddCommGroup.of ⟨X, α⟩ - FreeAddCommGroup.of ⟨Y, β⟩) :=
  Iff.rfl

/-- Bass's `K₁` of a category with zero morphisms and binary biproducts: the abelian group
generated by the classes `[X, α]` of automorphisms `α : Aut X`, subject to
`[Y, f α f⁻¹] = [X, α]` for isomorphisms `f : X ≅ Y`, `[X, α β] = [X, α] + [X, β]` and
`[X ⊞ Y, α ⊞ β] = [X, α] + [Y, β]`. -/
def BassK1 : Type (max u v) :=
  FreeAddCommGroup (Σ X : C, Aut X) ⧸ AddSubgroup.closure (bassRelations C)

instance : AddCommGroup (BassK1 C) :=
  inferInstanceAs
    (AddCommGroup (FreeAddCommGroup (Σ X : C, Aut X) ⧸ AddSubgroup.closure (bassRelations C)))

end Relations

namespace BassK1

section Basic

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [HasBinaryBiproducts C]

/-- The quotient map from the free abelian group on all automorphisms onto Bass's `K₁`. -/
private noncomputable def mk : FreeAddCommGroup (Σ X : C, Aut X) →+ BassK1 C :=
  QuotientAddGroup.mk' _

private lemma mk_surjective : Function.Surjective (mk : _ → BassK1 C) :=
  QuotientAddGroup.mk'_surjective _

private lemma mk_eq_zero_of_mem {r : FreeAddCommGroup (Σ X : C, Aut X)}
    (hr : r ∈ bassRelations C) : (mk r : BassK1 C) = 0 :=
  (QuotientAddGroup.eq_zero_iff r).2 (AddSubgroup.subset_closure hr)

/-- The class `[X, α]` in Bass's `K₁` of an automorphism `α` of an object `X`. -/
noncomputable def of {X : C} (α : Aut X) : BassK1 C :=
  mk (FreeAddCommGroup.of ⟨X, α⟩)

private lemma mk_of {X : C} (α : Aut X) : mk (FreeAddCommGroup.of ⟨X, α⟩) = of α := (rfl)

private lemma mk_apply (r : FreeAddCommGroup (Σ X : C, Aut X)) :
    mk r = (QuotientAddGroup.mk r : BassK1 C) := (rfl)

/-- Conjugation invariance: conjugating an automorphism by an isomorphism does not change its
class. -/
@[simp]
theorem of_conj {X Y : C} (e : X ≅ Y) (α : Aut X) :
    of (Aut.autMulEquivOfIso e α) = of α := by
  have h := mk_eq_zero_of_mem (C := C) (Or.inl ⟨X, Y, e, α, rfl⟩)
  rwa [map_sub, mk_of, mk_of, sub_eq_zero] at h

/-- The class of a composite of automorphisms is the sum of their classes. -/
@[simp]
theorem of_mul {X : C} (α β : Aut X) : of (α * β) = of α + of β := by
  have h := mk_eq_zero_of_mem (C := C) (Or.inr (Or.inl ⟨X, α, β, rfl⟩))
  rwa [map_sub, map_sub, mk_of, mk_of, mk_of, sub_sub, sub_eq_zero] at h

/-- The class of the biproduct of two automorphisms is the sum of their classes. -/
@[simp]
theorem of_biprod {X Y : C} (α : Aut X) (β : Aut Y) :
    of (Aut.of (biprod.mapIso α.asIso β.asIso)) = of α + of β := by
  have h := mk_eq_zero_of_mem (C := C) (Or.inr (Or.inr ⟨X, Y, α, β, rfl⟩))
  rwa [map_sub, map_sub, mk_of, mk_of, mk_of, sub_sub, sub_eq_zero] at h

/-- The class of the identity automorphism vanishes. -/
@[simp]
theorem of_one (X : C) : of (1 : Aut X) = 0 := by
  have h := of_mul (1 : Aut X) 1
  rwa [mul_one, left_eq_add] at h

/-- The class of the inverse of an automorphism is the negative of its class. -/
@[simp]
theorem of_inv {X : C} (α : Aut X) : of α⁻¹ = -of α := by
  rw [eq_neg_iff_add_eq_zero, ← of_mul, inv_mul_cancel, of_one]

/-- The class of a quotient of automorphisms is the difference of their classes. -/
@[simp]
theorem of_div {X : C} (α β : Aut X) : of (α / β) = of α - of β := by
  rw [div_eq_mul_inv, of_mul, of_inv, sub_eq_add_neg]

/-- The class of a commutator of automorphisms vanishes. -/
@[simp]
theorem of_commutatorElement {X : C} (α β : Aut X) : of ⁅α, β⁆ = 0 := by
  rw [commutatorElement_def, of_mul, of_mul, of_mul, of_inv, of_inv]
  abel

/-- Automorphisms intertwined by an isomorphism have the same class. -/
theorem of_congr {X Y : C} (e : X ≅ Y) {α : Aut X} {β : Aut Y}
    (h : α.asIso.hom ≫ e.hom = e.hom ≫ β.asIso.hom) : of α = of β := by
  rw [← of_conj e α]
  congr 1
  ext
  simp only [Aut.autMulEquivOfIso_apply_asIso, Iso.trans_hom, Iso.symm_hom, h,
    Iso.inv_hom_id_assoc]

/-- Every automorphism of a zero object has trivial class. -/
theorem of_eq_zero_of_isZero {X : C} (hX : IsZero X) (α : Aut X) : of α = 0 := by
  obtain rfl : α = 1 := Aut.ext (Iso.ext (hX.eq_of_src _ _))
  exact of_one X

/-- Every element of Bass's `K₁` of a nonempty category is the class of a single automorphism:
sums are realized by biproducts and negatives by inverses. -/
theorem exists_eq_of [Nonempty C] (x : BassK1 C) : ∃ (X : C) (α : Aut X), of α = x := by
  obtain ⟨y, rfl⟩ := mk_surjective x
  induction y using FreeAddCommGroup.induction_on with
  | zero => exact ⟨Classical.arbitrary C, 1, by rw [of_one, map_zero]⟩
  | of p => exact ⟨p.1, p.2, rfl⟩
  | neg p hp =>
      obtain ⟨X, α, h⟩ := hp
      exact ⟨X, α⁻¹, by rw [of_inv, h, map_neg]⟩
  | add a b ha hb =>
      obtain ⟨X, α, hα⟩ := ha
      obtain ⟨Y, β, hβ⟩ := hb
      exact ⟨X ⊞ Y, Aut.of (biprod.mapIso α.asIso β.asIso), by rw [of_biprod, hα, hβ, map_add]⟩

/-- Two homomorphisms out of Bass's `K₁` that agree on the classes of all automorphisms are
equal. -/
@[ext]
theorem hom_ext {G : Type*} [AddMonoid G] {f g : BassK1 C →+ G}
    (h : ∀ (X : C) (α : Aut X), f (of α) = g (of α)) : f = g := by
  refine AddMonoidHom.ext fun x => ?_
  obtain ⟨y, rfl⟩ := mk_surjective x
  induction y using FreeAddCommGroup.induction_on with
  | zero => rw [map_zero, map_zero, map_zero]
  | of p => exact h p.1 p.2
  | neg p hp =>
      -- In a monoid, `f (-a)` and `g (-a)` are both inverses of `f a = g a`.
      refine left_neg_eq_right_neg (a := f (mk (FreeAddCommGroup.of p))) ?_ ?_
      · rw [← map_add, ← map_add, neg_add_cancel, map_zero, map_zero]
      · rw [hp, ← map_add, ← map_add, add_neg_cancel, map_zero, map_zero]
  | add a b ha hb => simp only [map_add, ha, hb]

end Basic

section Lift

variable (C : Type u) [Category.{v} C] [HasZeroMorphisms C] [HasBinaryBiproducts C]

/-- An invariant for Bass's `K₁` with values in an abelian group `G`: a function on the
automorphisms of each object of `C`, invariant under conjugation by isomorphisms, additive under
composition and additive under binary biproducts. These are the data that factor through
`TauCeti.BassK1 C`; see `TauCeti.BassK1.lift`. -/
@[ext]
structure Invariant (G : Type*) [AddCommGroup G] where
  /-- The value of the invariant on an automorphism. -/
  toFun : ∀ ⦃X : C⦄, Aut X → G
  /-- Conjugate automorphisms receive equal values. -/
  map_conj : ∀ ⦃X Y : C⦄ (e : X ≅ Y) (α : Aut X), toFun (Aut.autMulEquivOfIso e α) = toFun α
  /-- The value on a composite is the sum of the values. -/
  map_mul : ∀ ⦃X : C⦄ (α β : Aut X), toFun (α * β) = toFun α + toFun β
  /-- The value on a biproduct of automorphisms is the sum of the values. -/
  map_biprod : ∀ ⦃X Y : C⦄ (α : Aut X) (β : Aut Y),
    toFun (Aut.of (biprod.mapIso α.asIso β.asIso)) = toFun α + toFun β

variable {C} {G : Type*} [AddCommGroup G]

private lemma Invariant.lift_rel (a : Invariant C G) :
    ∀ r ∈ bassRelations C, FreeAddCommGroup.lift (fun p : Σ X : C, Aut X => a.toFun p.2) r = 0 := by
  rintro _ (⟨X, Y, e, α, rfl⟩ | ⟨X, α, β, rfl⟩ | ⟨X, Y, α, β, rfl⟩)
  · simp [a.map_conj]
  · simp [a.map_mul]
  · simp [a.map_biprod]

/-- The homomorphism out of Bass's `K₁` induced by an invariant. -/
noncomputable def lift (a : Invariant C G) : BassK1 C →+ G :=
  QuotientAddGroup.lift _ (FreeAddCommGroup.lift fun p : Σ X : C, Aut X => a.toFun p.2) <|
    (AddSubgroup.closure_le _).2 fun r hr => a.lift_rel r hr

/-- The induced homomorphism sends the class of an automorphism to the value of the invariant. -/
@[simp]
theorem lift_of (a : Invariant C G) {X : C} (α : Aut X) : lift a (of α) = a.toFun α :=
  (QuotientAddGroup.lift_mk _ _ _).trans (FreeAddCommGroup.lift_apply_of _ _)

/-- The values of a homomorphism out of Bass's `K₁` on the classes of automorphisms form an
invariant. -/
noncomputable def Invariant.ofHom (f : BassK1 C →+ G) : Invariant C G where
  toFun _ α := f (of α)
  map_conj _ _ e α := by rw [of_conj]
  map_mul _ α β := by rw [of_mul, map_add]
  map_biprod _ _ α β := by rw [of_biprod, map_add]

/-- The invariant attached to a homomorphism evaluates it on classes of automorphisms. -/
@[simp]
theorem Invariant.ofHom_toFun (f : BassK1 C →+ G) {X : C} (α : Aut X) :
    (Invariant.ofHom f).toFun α = f (of α) := (rfl)

/-- The universal property of Bass's `K₁`: invariants with values in `G` correspond bijectively to
homomorphisms `BassK1 C →+ G`. -/
noncomputable def liftEquiv : Invariant C G ≃ (BassK1 C →+ G) where
  toFun := lift
  invFun := Invariant.ofHom
  left_inv a := by
    ext X α
    simp
  right_inv f := by
    ext X α
    simp

/-- The universal bijection sends an invariant to the homomorphism it induces. -/
@[simp]
theorem liftEquiv_apply (a : Invariant C G) : liftEquiv a = lift a := (rfl)

/-- The inverse of the universal bijection restricts a homomorphism to classes of automorphisms. -/
@[simp]
theorem liftEquiv_symm_apply (f : BassK1 C →+ G) : liftEquiv.symm f = Invariant.ofHom f := (rfl)

end Lift

section Triangular

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasBinaryBiproducts C]

/-- After adding a second copy of `X₂`, the unipotent automorphism `(x₁, x₂) ↦ (x₁, x₂ + r x₁)` of
`X₁ ⊞ X₂` becomes the commutator of the automorphisms `(w, x₃) ↦ (w, x₃ + r (fst w))` and
`(w, x₃) ↦ (w + inr x₃, x₃)` of `(X₁ ⊞ X₂) ⊞ X₂`. -/
private lemma biprod_unipotentUpper_eq {X₁ X₂ : C} (r : X₁ ⟶ X₂) :
    Aut.of (biprod.mapIso (Biprod.unipotentUpper r) (Iso.refl X₂)) =
      (Aut.of (Biprod.unipotentLower (biprod.inr : X₂ ⟶ X₁ ⊞ X₂)))⁻¹ *
        (Aut.of (Biprod.unipotentUpper (biprod.fst ≫ r : X₁ ⊞ X₂ ⟶ X₂)))⁻¹ *
        Aut.of (Biprod.unipotentLower (biprod.inr : X₂ ⟶ X₁ ⊞ X₂)) *
        Aut.of (Biprod.unipotentUpper (biprod.fst ≫ r : X₁ ⊞ X₂ ⟶ X₂)) := by
  ext : 2
  simp only [Aut.mul_asIso, Aut.inv_asIso, Iso.trans_hom, Iso.symm_hom, biprod.mapIso_hom,
    Iso.refl_hom, Biprod.unipotentUpper_hom, Biprod.unipotentUpper_inv,
    Biprod.unipotentLower_hom, Biprod.unipotentLower_inv]
  ext <;> simp [Biprod.ofComponents]

/-- The unipotent automorphism `(x₁, x₂) ↦ (x₁, x₂ + r x₁)` of `X₁ ⊞ X₂` has trivial class. -/
@[simp]
theorem of_unipotentUpper {X₁ X₂ : C} (r : X₁ ⟶ X₂) :
    of (Aut.of (Biprod.unipotentUpper r)) = 0 := by
  have h := of_biprod (Aut.of (Biprod.unipotentUpper r)) (1 : Aut X₂)
  rw [of_one, add_zero] at h
  rw [← h]
  simp only [Aut.one_asIso]
  rw [biprod_unipotentUpper_eq, of_mul, of_mul, of_mul, of_inv, of_inv]
  abel

/-- The unipotent automorphism `(x₁, x₂) ↦ (x₁ + r x₂, x₂)` of `X₁ ⊞ X₂` has trivial class. -/
@[simp]
theorem of_unipotentLower {X₁ X₂ : C} (r : X₂ ⟶ X₁) :
    of (Aut.of (Biprod.unipotentLower r)) = 0 := by
  rw [of_congr (biprod.braiding X₁ X₂) (β := Aut.of (Biprod.unipotentUpper r)),
    of_unipotentUpper]
  ext <;> simp [Biprod.ofComponents]

/-- The triangular relation: an automorphism `φ` of `X ⊞ Y` which restricts to the automorphism
`α` on the summand `X` and induces the automorphism `β` on the quotient `Y` has class
`[X, α] + [Y, β]`, whatever its off-diagonal block `Y ⟶ X`. -/
theorem of_eq_add_of_inl_comp_eq {X Y : C} {φ : Aut (X ⊞ Y)} {α : Aut X} {β : Aut Y}
    (h₁ : biprod.inl ≫ φ.asIso.hom = α.asIso.hom ≫ biprod.inl)
    (h₂ : φ.asIso.hom ≫ biprod.snd = biprod.snd ≫ β.asIso.hom) :
    of φ = of α + of β := by
  have h : φ = Aut.of (biprod.mapIso α.asIso β.asIso) *
      Aut.of (Biprod.unipotentLower (biprod.inr ≫ φ.asIso.hom ≫ biprod.fst ≫ α.asIso.inv)) := by
    ext : 2
    simp only [Aut.mul_asIso, Iso.trans_hom, biprod.mapIso_hom, Biprod.unipotentLower_hom]
    ext
    · simp [Biprod.ofComponents, reassoc_of% h₁]
    · simp [Biprod.ofComponents, reassoc_of% h₁]
    · simp [Biprod.ofComponents]
    · simp [Biprod.ofComponents, h₂]
  rw [h, of_mul, of_biprod, of_unipotentLower, add_zero]

/-- The triangular relation for the other summand: an automorphism `φ` of `X ⊞ Y` which restricts
to the automorphism `β` on the summand `Y` and induces the automorphism `α` on the quotient `X`
has class `[X, α] + [Y, β]`, whatever its off-diagonal block `X ⟶ Y`. -/
theorem of_eq_add_of_inr_comp_eq {X Y : C} {φ : Aut (X ⊞ Y)} {α : Aut X} {β : Aut Y}
    (h₁ : biprod.inr ≫ φ.asIso.hom = β.asIso.hom ≫ biprod.inr)
    (h₂ : φ.asIso.hom ≫ biprod.fst = biprod.fst ≫ α.asIso.hom) :
    of φ = of α + of β := by
  have h : φ = Aut.of (biprod.mapIso α.asIso β.asIso) *
      Aut.of (Biprod.unipotentUpper (biprod.inl ≫ φ.asIso.hom ≫ biprod.snd ≫ β.asIso.inv)) := by
    ext : 2
    simp only [Aut.mul_asIso, Iso.trans_hom, biprod.mapIso_hom, Biprod.unipotentUpper_hom]
    ext
    · simp [Biprod.ofComponents, h₂]
    · simp [Biprod.ofComponents]
    · simp [Biprod.ofComponents, reassoc_of% h₁]
    · simp [Biprod.ofComponents, reassoc_of% h₁]
  rw [h, of_mul, of_biprod, of_unipotentUpper, add_zero]

end Triangular

section Functoriality

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [HasBinaryBiproducts C]
  {D : Type u'} [Category.{v'} D] [HasZeroMorphisms D] [HasBinaryBiproducts D]
  {E : Type u''} [Category.{v''} E] [HasZeroMorphisms E] [HasBinaryBiproducts E]

/-- The invariant `[X, α] ↦ [F X, F α]` attached to a functor preserving binary biproducts. -/
private noncomputable def mapInvariant (F : C ⥤ D) [F.PreservesZeroMorphisms]
    [PreservesBiproductsOfShape WalkingPair F] : Invariant C (BassK1 D) where
  toFun X α := of (F.mapAut X α)
  map_conj X Y e α := by
    rw [← of_conj (F.mapIso e) (F.mapAut X α)]
    congr 1
    ext
    simp
  map_mul X α β := by rw [map_mul, of_mul]
  map_biprod X Y α β := by
    have := preservesBinaryBiproducts_of_preservesBiproducts F
    have h : (F.mapBiprod X Y).hom = F.biprodComparison X Y := by ext <;> simp
    rw [← of_biprod]
    refine of_congr (F.mapBiprod X Y) ?_
    simpa only [h, Functor.mapAut_apply_asIso, Functor.mapIso_hom, biprod.mapIso_hom] using
      F.biprodComparison_natural α.asIso.hom β.asIso.hom

/-- The homomorphism of Bass's `K₁` induced by a functor preserving zero morphisms and binary
biproducts, for instance an additive functor between preadditive categories:
`[X, α] ↦ [F X, F α]`. -/
noncomputable def map (F : C ⥤ D) [F.PreservesZeroMorphisms]
    [PreservesBiproductsOfShape WalkingPair F] : BassK1 C →+ BassK1 D :=
  lift (mapInvariant F)

/-- The induced homomorphism sends the class of `α` to the class of its image `F α`. -/
@[simp]
theorem map_of (F : C ⥤ D) [F.PreservesZeroMorphisms] [PreservesBiproductsOfShape WalkingPair F]
    {X : C} (α : Aut X) : map F (of α) = of (F.mapAut X α) :=
  lift_of _ α

/-- The identity functor induces the identity of Bass's `K₁`. -/
@[simp]
theorem map_id : map (𝟭 C) = AddMonoidHom.id (BassK1 C) := by
  ext X α
  rw [map_of, AddMonoidHom.id_apply]
  exact congrArg of (Aut.ext (Iso.ext (Functor.id_map _)))

/-- A composite of functors induces the composite of the induced homomorphisms. -/
@[simp]
theorem map_comp (F : C ⥤ D) (G : D ⥤ E) [F.PreservesZeroMorphisms]
    [PreservesBiproductsOfShape WalkingPair F] [G.PreservesZeroMorphisms]
    [PreservesBiproductsOfShape WalkingPair G] :
    map (F ⋙ G) = (map G).comp (map F) := by
  ext X α
  rw [map_of, AddMonoidHom.comp_apply, map_of, map_of]
  exact congrArg of (Aut.ext (Iso.ext (Functor.comp_map _ _ _)))

/-- Naturally isomorphic functors induce the same homomorphism of Bass's `K₁`. -/
theorem map_congr {F G : C ⥤ D} [F.PreservesZeroMorphisms]
    [PreservesBiproductsOfShape WalkingPair F] [G.PreservesZeroMorphisms]
    [PreservesBiproductsOfShape WalkingPair G] (e : F ≅ G) : map F = map G := by
  ext X α
  rw [map_of, map_of]
  exact of_congr (e.app X) (by simp)

/-- Bass's `K₁` is invariant under equivalences of categories. -/
noncomputable def mapEquiv (e : C ≌ D) : BassK1 C ≃+ BassK1 D :=
  AddMonoidHom.toAddEquiv (map e.functor) (map e.inverse)
    (by rw [← map_comp, map_congr e.unitIso.symm, map_id])
    (by rw [← map_comp, map_congr e.counitIso, map_id])

/-- The equivalence of Bass's `K₁` sends the class of `α` to the class of its image under the
functor of the equivalence. -/
@[simp]
theorem mapEquiv_of (e : C ≌ D) {X : C} (α : Aut X) :
    mapEquiv e (of α) = of (e.functor.mapAut X α) :=
  map_of _ α

/-- The inverse equivalence of Bass's `K₁` sends the class of `α` to the class of its image under
the inverse functor of the equivalence. -/
@[simp]
theorem mapEquiv_symm_of (e : C ≌ D) {Y : D} (α : Aut Y) :
    (mapEquiv e).symm (of α) = of (e.inverse.mapAut Y α) :=
  map_of _ α

end Functoriality

end BassK1

end TauCeti
