/-!
# Submodules of a module over a preadditive category

Let `C` be a preadditive category and `F : ModCat C` a `C`-module, an additive functor
`Cᵒᵖ ⥤ AddCommGrpCat`. A *submodule* `S : ModCat.Submodule F` is a family of subgroups
`S(X) ≤ F(X)`, one for each object `X`, closed under the maps `F(f)`. This is the concrete
counterpart of a subobject of `F`, suited to elementwise arguments.

The submodules of `F` form a complete lattice in which infima and suprema are computed
pointwise: the pointwise supremum of a family of submodules is again closed under each `F(f)`,
since `F(f)` is additive. As the subgroup lattice of an abelian group is modular, so is the
lattice of submodules. A submodule `S` is itself a `C`-module `S.toModCat`, with a monomorphism
`S.ι : S.toModCat ⟶ F`, and every monomorphism `φ : A ⟶ F` is isomorphic over `F` to the
inclusion of its pointwise image `range φ`. This gives an order isomorphism between the
submodules and the subobjects of `F`, with no change of universe, so `Subobject F` is a modular
lattice too.

A finitely generated module `M : ModCat.{v} C`, a quotient `p` of a finite sum
`(-, Y₁) ⊕ ⋯ ⊕ (-, Yₙ)` of representable functors, is generated by the images `mᵢ ∈ M(Yᵢ)` of the
identities `𝟙 Yᵢ` under `p`: by the Yoneda lemma, a submodule containing every `mᵢ` contains the
image of `p`, so it is all of `M`. If the union of a directed set of submodules contains the
finitely many `mᵢ`, then one member already contains them all, so `⊤` is a compact element of
the submodule lattice. By Zorn's lemma, in the form of `CompleteLattice.coatomic_of_top_compact`,
every proper submodule of `M` lies in a maximal one; in particular a nonzero finitely generated
module has a maximal proper subobject.

## Main definitions

* `TauCeti.ModCat.Submodule F`: the submodules of `F : ModCat C`, with their complete lattice.
* `TauCeti.ModCat.Submodule.toModCat`, `TauCeti.ModCat.Submodule.ι`: a submodule as a module,
  and its inclusion into `F`.
* `TauCeti.ModCat.Submodule.range φ`: the pointwise image of a morphism `φ : A ⟶ F`.
* `TauCeti.ModCat.Submodule.orderIsoSubobject F : ModCat.Submodule F ≃o Subobject F`.

## Main results

* `TauCeti.ModCat.Submodule.nonempty_orderIsoSubobject`: the submodules and the subobjects of
  `F` form isomorphic orders.
* `IsModularLattice (ModCat.Submodule F)`; `IsModularLattice (Subobject F)` comes from the instance
  for abelian categories (`CategoryTheory.Subobject.isModularLattice`).
* `TauCeti.ModCat.Submodule.isCompactElement_top`: if `M` is a quotient of a finite sum of
  representable functors, then `⊤` is compact in the submodule lattice of `M`.
* `TauCeti.ModCat.exists_isCoatom_of_isFinitelyGeneratedFunctor`: a nonzero finitely generated
  module has a maximal proper subobject.

## References

* B. Mitchell, *Rings with several objects*, Adv. Math. 8 (1972), 1–161, §3.
-/

public section

universe w v u

open CategoryTheory Limits Opposite

namespace TauCeti

variable {C : Type u} [Category.{v} C] [Preadditive C]

namespace ModCat

/-- A *submodule* of a `C`-module `F`: a subgroup `S(X)` of `F(X)` for each object `X`, closed
under the maps `F(f)`. These are the additive subfunctors of `F`. -/
structure Submodule (F : ModCat.{w} C) where
  /-- The subgroup `S(X)` of `F(X)`. -/
  carrier (X : Cᵒᵖ) : AddSubgroup (F.obj.obj X)
  /-- The map `F(f) : F(X) ⟶ F(Y)` sends `S(X)` into `S(Y)`. -/
  map_mem {X Y : Cᵒᵖ} (f : X ⟶ Y) {x : F.obj.obj X} :
    x ∈ carrier X → (F.obj.map f).hom x ∈ carrier Y

namespace Submodule

variable {F : ModCat.{w} C}

/-- A submodule is determined by its subgroups. -/
theorem carrier_injective : Function.Injective (carrier : Submodule F → _) := by
  rintro ⟨_, _⟩ ⟨_, _⟩ rfl
  rfl

/-- Two submodules are equal when they have the same elements at every object. -/
@[ext]
theorem ext {S T : Submodule F}
    (h : ∀ ⦃X : Cᵒᵖ⦄ (x : F.obj.obj X), x ∈ S.carrier X ↔ x ∈ T.carrier X) : S = T :=
  carrier_injective (funext fun X ↦ AddSubgroup.ext (h (X := X)))

/-! ### The complete lattice of submodules -/

/-- Submodules are ordered by pointwise inclusion. -/
instance : PartialOrder (Submodule F) := PartialOrder.lift carrier carrier_injective

theorem le_def {S T : Submodule F} : S ≤ T ↔ ∀ X, S.carrier X ≤ T.carrier X :=
  Iff.rfl

/-- The pointwise supremum of two submodules. -/
instance : Max (Submodule F) where
  max S T :=
    { carrier X := S.carrier X ⊔ T.carrier X
      map_mem f _ hx := by
        obtain ⟨y, hy, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 hx
        rw [map_add]
        exact AddSubgroup.add_mem_sup (S.map_mem f hy) (T.map_mem f hz) }

/-- The pointwise infimum of two submodules. -/
instance : Min (Submodule F) where
  min S T :=
    { carrier X := S.carrier X ⊓ T.carrier X
      map_mem f _ hx := ⟨S.map_mem f hx.1, T.map_mem f hx.2⟩ }

/-- The pointwise supremum of a set of submodules. It is closed under each `F(f)` because
`F(f)` is additive. -/
instance : SupSet (Submodule F) where
  sSup s :=
    { carrier X := ⨆ S ∈ s, S.carrier X
      map_mem {X Y} f _ hx := by
        have : ⨆ S ∈ s, S.carrier X ≤ (⨆ S ∈ s, S.carrier Y).comap (F.obj.map f).hom :=
          iSup₂_le fun S hS _ h ↦ le_iSup₂ (f := fun S (_ : S ∈ s) ↦ S.carrier Y) S hS
            (S.map_mem f h)
        exact this hx }

/-- The pointwise infimum of a set of submodules. -/
instance : InfSet (Submodule F) where
  sInf s :=
    { carrier X := ⨅ S ∈ s, S.carrier X
      map_mem f _ hx := by
        simp only [AddSubgroup.mem_iInf] at hx ⊢
        exact fun S hS ↦ S.map_mem f (hx S hS) }

/-- The largest submodule, `F` itself. -/
instance : Top (Submodule F) := ⟨{ carrier _ := ⊤, map_mem _ _ _ := AddSubgroup.mem_top _ }⟩

/-- The zero submodule. -/
instance : Bot (Submodule F) where
  bot :=
    { carrier _ := ⊥
      map_mem f _ hx := by
        rw [AddSubgroup.mem_bot] at hx ⊢
        simp [hx] }

@[simp]
theorem carrier_sup (S T : Submodule F) (X : Cᵒᵖ) :
    (S ⊔ T).carrier X = S.carrier X ⊔ T.carrier X :=
  rfl

@[simp]
theorem carrier_inf (S T : Submodule F) (X : Cᵒᵖ) :
    (S ⊓ T).carrier X = S.carrier X ⊓ T.carrier X :=
  rfl

@[simp]
theorem carrier_sSup (s : Set (Submodule F)) (X : Cᵒᵖ) :
    (sSup s).carrier X = ⨆ S ∈ s, S.carrier X :=
  rfl

@[simp]
theorem carrier_sInf (s : Set (Submodule F)) (X : Cᵒᵖ) :
    (sInf s).carrier X = ⨅ S ∈ s, S.carrier X :=
  rfl

@[simp]
theorem carrier_top (X : Cᵒᵖ) : (⊤ : Submodule F).carrier X = ⊤ :=
  rfl

@[simp]
theorem carrier_bot (X : Cᵒᵖ) : (⊥ : Submodule F).carrier X = ⊥ :=
  rfl

/-- The submodules of `F` form a complete lattice, with infima and suprema computed pointwise. -/
instance : CompleteLattice (Submodule F) :=
  carrier_injective.completeLattice _ .rfl .rfl (fun _ _ ↦ rfl) (fun _ _ ↦ rfl)
    (fun s ↦ funext fun X ↦ by simp [iSup_apply]) (fun s ↦ funext fun X ↦ by simp [iInf_apply])
    rfl rfl

/-- The submodules of `F` form a modular lattice, since the subgroups of each `F(X)` do. -/
instance : IsModularLattice (Submodule F) :=
  ⟨fun {_} _ _ h ↦ le_def.2 fun X ↦ IsModularLattice.sup_inf_le_assoc_of_le _ (le_def.1 h X)⟩

/-- An element of the supremum of a nonempty directed set of submodules lies in one of them. -/
theorem mem_sSup_of_directedOn {s : Set (Submodule F)} (hne : s.Nonempty)
    (hs : DirectedOn (· ≤ ·) s) {X : Cᵒᵖ} {x : F.obj.obj X} :
    x ∈ (sSup s).carrier X ↔ ∃ S ∈ s, x ∈ S.carrier X := by
  have : Nonempty s := hne.to_subtype
  rw [carrier_sSup, iSup_subtype', AddSubgroup.mem_iSup_of_directed
    (K := fun S : s ↦ S.val.carrier X) (hs.directed_val.mono_comp _ fun _ _ h ↦ le_def.1 h X)]
  simp

/-- The zero submodule is everything exactly when the module is zero. -/
theorem bot_eq_top_iff : (⊥ : Submodule F) = ⊤ ↔ IsZero F := by
  constructor
  · intro h
    refine IsZero.of_full_of_faithful_of_isZero (additiveFunctor Cᵒᵖ AddCommGrpCat.{w}).ι F
      (Functor.isZero _ fun X ↦ AddCommGrpCat.isZero_iff_subsingleton.2 ⟨fun a b ↦ ?_⟩)
    have h0 (c : F.obj.obj X) : c = 0 := AddSubgroup.mem_bot.1 <| by
      rw [← carrier_bot, h]
      exact AddSubgroup.mem_top c
    rw [h0 a, h0 b]
  · intro h
    ext X x
    have : Subsingleton (F.obj.obj X) := AddCommGrpCat.isZero_iff_subsingleton.1
      (((additiveFunctor Cᵒᵖ AddCommGrpCat.{w}).ι.map_isZero h).obj X)
    exact iff_of_true (by rw [Subsingleton.elim x 0]; exact zero_mem _) (AddSubgroup.mem_top x)

/-! ### Submodules as subobjects -/

variable (S : Submodule F)

/-- A submodule `S` of `F` as a functor `Cᵒᵖ ⥤ AddCommGrpCat`, with `X ↦ S(X)`. -/
@[expose] def toFunctor : Cᵒᵖ ⥤ AddCommGrpCat.{w} where
  obj X := AddCommGrpCat.of (S.carrier X)
  map {X Y} f := AddCommGrpCat.ofHom <|
    ((F.obj.map f).hom.comp (S.carrier X).subtype).codRestrict _ fun x ↦ S.map_mem f x.property
  map_id X := by
    refine AddCommGrpCat.ext fun x ↦ Subtype.ext ?_
    exact ConcreteCategory.congr_hom (F.obj.map_id X) x.val
  map_comp f g := by
    refine AddCommGrpCat.ext fun x ↦ Subtype.ext ?_
    exact ConcreteCategory.congr_hom (F.obj.map_comp f g) x.val

instance : S.toFunctor.Additive where
  map_add {X Y f g} := by
    refine AddCommGrpCat.ext fun x ↦ Subtype.ext ?_
    exact ConcreteCategory.congr_hom (F.obj.map_add (f := f) (g := g)) x.val

/-- A submodule `S` of `F` as a `C`-module. -/
abbrev toModCat : ModCat.{w} C := ⟨S.toFunctor, (additiveFunctor_iff _).2 inferInstance⟩

/-- The inclusion of a submodule `S` into `F`. -/
def ι : S.toModCat ⟶ F :=
  ObjectProperty.homMk { app X := AddCommGrpCat.ofHom (S.carrier X).subtype }

@[simp]
theorem ι_hom_app_apply (X : Cᵒᵖ) (x : S.carrier X) : S.ι.hom.app X x = x :=
  (rfl)

instance : Mono S.ι := by
  have (X : Cᵒᵖ) : Mono (S.ι.hom.app X) :=
    ConcreteCategory.mono_of_injective _ fun _ _ h ↦ Subtype.ext h
  have : Mono S.ι.hom := NatTrans.mono_of_mono_app _
  exact (additiveFunctor Cᵒᵖ AddCommGrpCat.{w}).ι.mono_of_mono_map this

/-- A morphism of functors into `F` whose values lie in `S` factors through `S`. -/
def liftHom {G : Cᵒᵖ ⥤ AddCommGrpCat.{w}} (φ : G ⟶ F.obj)
    (h : ∀ X (x : G.obj X), φ.app X x ∈ S.carrier X) : G ⟶ S.toFunctor where
  app X := AddCommGrpCat.ofHom ((φ.app X).hom.codRestrict _ (h X))
  naturality X Y f := by
    refine AddCommGrpCat.ext fun x ↦ Subtype.ext ?_
    exact NatTrans.naturality_apply φ f x

@[reassoc (attr := simp)]
theorem liftHom_ι {G : Cᵒᵖ ⥤ AddCommGrpCat.{w}} (φ : G ⟶ F.obj)
    (h : ∀ X (x : G.obj X), φ.app X x ∈ S.carrier X) : S.liftHom φ h ≫ S.ι.hom = φ :=
  (rfl)

/-- The pointwise image of a morphism `φ : A ⟶ F` of `C`-modules, a submodule of `F`. -/
def range {A : ModCat.{w} C} (φ : A ⟶ F) : Submodule F where
  carrier X := (φ.hom.app X).hom.range
  map_mem f := by
    rintro _ ⟨a, rfl⟩
    exact ⟨A.obj.map f a, NatTrans.naturality_apply φ.hom f a⟩

@[simp]
theorem mem_range {A : ModCat.{w} C} (φ : A ⟶ F) {X : Cᵒᵖ} {x : F.obj.obj X} :
    x ∈ (range φ).carrier X ↔ ∃ a, φ.hom.app X a = x :=
  Iff.rfl

/-- A morphism of `C`-modules into `F` whose image lies in `S` factors through `S`. -/
def lift {A : ModCat.{w} C} (φ : A ⟶ F) (h : range φ ≤ S) : A ⟶ S.toModCat :=
  ObjectProperty.homMk (S.liftHom φ.hom fun X _ ↦ h X ((mem_range φ).2 ⟨_, rfl⟩))

@[reassoc (attr := simp)]
theorem lift_ι {A : ModCat.{w} C} (φ : A ⟶ F) (h : range φ ≤ S) : S.lift φ h ≫ S.ι = φ :=
  (rfl)

@[simp]
theorem range_ι : range S.ι = S := by
  ext X x
  exact ⟨by rintro ⟨a, rfl⟩; exact a.property, fun hx ↦ ⟨⟨x, hx⟩, rfl⟩⟩

theorem range_comp_le {A B : ModCat.{w} C} (g : A ⟶ B) (φ : B ⟶ F) :
    range (g ≫ φ) ≤ range φ := by
  rintro X _ ⟨a, rfl⟩
  exact ⟨g.hom.app X a, rfl⟩

/-- A subobject `P` of `F` lies below the subobject of a submodule `S` exactly when the image of
`P` lies in `S`. -/
theorem le_mk_ι_iff (P : Subobject F) : P ≤ Subobject.mk S.ι ↔ range P.arrow ≤ S := by
  refine ⟨fun h X ↦ ?_, fun h ↦ Subobject.le_mk_of_comm (S.lift P.arrow h) (S.lift_ι _ _)⟩
  rintro _ ⟨a, rfl⟩
  rw [← Subobject.ofLEMk_comp h]
  exact ((Subobject.ofLEMk P S.ι h).hom.app X a).property

/-- The submodule of the subobject of `S` is `S`. -/
@[simp]
theorem range_mk_ι_arrow : range (Subobject.mk S.ι).arrow = S := by
  refine le_antisymm ((S.le_mk_ι_iff _).1 le_rfl) ?_
  conv_lhs => rw [← S.range_ι, ← Subobject.underlyingIso_arrow S.ι]
  exact range_comp_le _ _

/-- A monomorphism `φ` into `F` and the inclusion of its image are the same subobject of `F`:
`φ` corestricts to a pointwise bijection onto its image, an isomorphism since `ModCat C` is
abelian. -/
theorem mk_range_ι {A : ModCat.{w} C} (φ : A ⟶ F) [Mono φ] :
    Subobject.mk (range φ).ι = Subobject.mk φ := by
  let g := (range φ).lift φ le_rfl
  have : Mono g := mono_of_mono_fac ((range φ).lift_ι φ le_rfl)
  have (X : Cᵒᵖ) : Epi (g.hom.app X) := (AddCommGrpCat.epi_iff_surjective _).2 <| by
    rintro ⟨_, a, rfl⟩
    exact ⟨a, rfl⟩
  have : Epi g.hom := NatTrans.epi_of_epi_app _
  have : Epi g := (additiveFunctor Cᵒᵖ AddCommGrpCat.{w}).ι.epi_of_epi_map this
  have : IsIso g := isIso_of_mono_of_epi g
  exact (Subobject.mk_eq_mk_of_comm _ _ (asIso g) ((range φ).lift_ι φ le_rfl)).symm

variable (F) in
/-- The submodules of `F` correspond to the subobjects of `F`: a submodule `S` gives the
subobject `S.ι`, and a subobject gives the pointwise image of its arrow. -/
noncomputable def orderIsoSubobject : Submodule F ≃o Subobject F where
  toFun S := Subobject.mk S.ι
  invFun P := range P.arrow
  left_inv := range_mk_ι_arrow
  right_inv P := (mk_range_ι P.arrow).trans (Subobject.mk_arrow P)
  map_rel_iff' {S T} := by rw [Equiv.coe_fn_mk, le_mk_ι_iff, range_mk_ι_arrow]

@[simp]
theorem orderIsoSubobject_apply : orderIsoSubobject F S = Subobject.mk S.ι :=
  (rfl)

@[simp]
theorem orderIsoSubobject_symm_apply (P : Subobject F) :
    (orderIsoSubobject F).symm P = range P.arrow :=
  (rfl)

variable (F) in
/-- **The submodules of `F` and the subobjects of `F` form isomorphic orders**, with no change of
universe. -/
theorem nonempty_orderIsoSubobject : Nonempty (Submodule F ≃o Subobject F) :=
  ⟨orderIsoSubobject F⟩

end Submodule

/-- The subobjects of a `C`-module form a modular lattice, by the instance for any abelian
category (`CategoryTheory.Subobject.isModularLattice`). -/
example (M : ModCat.{w} C) : IsModularLattice (Subobject M) := inferInstance

/-! ### Maximal subobjects of finitely generated modules -/

namespace Submodule

variable {M : ModCat.{v} C} {J : Type*} {Y : J → C}
  [HasCoproduct fun j ↦ preadditiveYoneda.obj (Y j)]

/-- Let `p : ∐ (-, Yⱼ) ⟶ M` be an epimorphism. A submodule of `M` containing the images under `p`
of the identities `𝟙 Yⱼ` is all of `M`. -/
theorem eq_top_of_forall_mem (p : (∐ fun j ↦ preadditiveYoneda.obj (Y j)) ⟶ M.obj) [Epi p]
    (S : Submodule M)
    (hS : ∀ j, (Sigma.ι _ j ≫ p).app (op (Y j)) (𝟙 (Y j)) ∈ S.carrier (op (Y j))) : S = ⊤ := by
  let q j := S.liftHom (Sigma.ι _ j ≫ p) fun X g ↦ by
    rw [preadditiveYoneda_obj_hom_app_apply _ (X := X.unop) g]
    exact S.map_mem g.op (hS j)
  have hp : p = Sigma.desc q ≫ S.ι.hom := Sigma.hom_ext _ _ fun j ↦ by simp [q]
  have : Epi (Sigma.desc q ≫ S.ι.hom) := hp ▸ inferInstance
  have : Epi S.ι.hom := epi_of_epi (Sigma.desc q) _
  refine eq_top_iff.2 <| le_def.2 fun X x _ ↦ ?_
  obtain ⟨y, rfl⟩ := (AddCommGrpCat.epi_iff_surjective (S.ι.hom.app X)).1 inferInstance x
  exact y.property

/-- **The whole module is compact** in the submodule lattice of a finitely generated module:
if `M` is a quotient of a finite sum `∐ (-, Yⱼ)` and `⊤` is the supremum of a directed set of
submodules, one of them contains the finitely many generators, hence is `⊤`. -/
theorem isCompactElement_top [Finite J] (p : (∐ fun j ↦ preadditiveYoneda.obj (Y j)) ⟶ M.obj)
    [Epi p] : IsCompactElement (⊤ : Submodule M) := by
  rw [isCompactElement_iff_le_of_directed_sSup_le]
  intro s hne hs htop
  have : Nonempty s := hne.to_subtype
  have hmem j : ∃ S : s, (Sigma.ι _ j ≫ p).app (op (Y j)) (𝟙 (Y j)) ∈ S.val.carrier (op (Y j)) := by
    obtain ⟨S, hS, h⟩ := (mem_sSup_of_directedOn hne hs).1 (le_def.1 htop _ (AddSubgroup.mem_top _))
    exact ⟨⟨S, hS⟩, h⟩
  choose S hS using hmem
  obtain ⟨T, hT⟩ := Directed.finite_le hs.directed_val S
  exact ⟨T, T.property, (eq_top_of_forall_mem p T.val fun j ↦ le_def.1 (hT j) _ (hS j)).ge⟩

end Submodule

/-- **A nonzero finitely generated module has a maximal proper subobject.** Its submodule lattice
is coatomic since `⊤` is compact (`Submodule.isCompactElement_top`, then Zorn's lemma through
`CompleteLattice.coatomic_of_top_compact`), and `⊥ ≠ ⊤` as the module is nonzero. -/
theorem exists_isCoatom_of_isFinitelyGeneratedFunctor (M : ModCat.{v} C)
    (hM : IsFinitelyGeneratedFunctor M.obj) (h0 : ¬ IsZero M) :
    ∃ N : Subobject M, IsCoatom N := by
  obtain ⟨n, Y, p, hp⟩ := isFinitelyGeneratedFunctor_def.1 hM
  have := CompleteLattice.coatomic_of_top_compact (Submodule.isCompactElement_top p)
  obtain h | ⟨N, hN, -⟩ := eq_top_or_exists_le_coatom (⊥ : Submodule M)
  · exact absurd (Submodule.bot_eq_top_iff.1 h) h0
  · exact ⟨Submodule.orderIsoSubobject M N, (OrderIso.isCoatom_iff _ _).2 hN⟩

end ModCat

end TauCeti
