/-!
# Tensor products with quotient representables

For a submodule `S` of the right representable `Hom(X, -)`, tensoring its quotient with a left
module `F` gives `F(X)` modulo the subgroup generated by the images of `F(f)` for `f ∈ S(Y)`.
The isomorphism sends the tensor of the class of `f` and `y` to the class of `F(f)(y)`.
This is the opposite-category form of [Oberst and Röhrl, *Flat and coherent functors*,
Lemma 1.2, p. 94](https://doi.org/10.1016/0021-8693(70)90136-5), specialized to abelian groups.
For a two-sided ideal the right module can also be taken directly from the quotient category.
-/

public section

universe w v u

open CategoryTheory CategoryTheory.Limits Opposite

namespace TauCeti

variable {C : Type u} [Category.{v} C] [Preadditive C]

namespace ModCat

variable {X : C} (S : Submodule ((yoneda Cᵒᵖ).obj (op X)))

/-- The subgroup of `F(X)` generated by the actions of the arrows in a submodule of
the right representable on `X`. -/
def yonedaTensorSubgroup (F : ModCat.{w} C) : AddSubgroup (F.obj.obj (op X)) :=
  AddSubgroup.closure
    {z | ∃ (Y : C) (f : op Y ⟶ op X), f ∈ S.carrier (op (op Y)) ∧
      ∃ y : F.obj.obj (op Y), F.obj.map f y = z}

/-- The subgroup of actions is contained in a subgroup exactly when all its generators are. -/
theorem yonedaTensorSubgroup_le_iff (F : ModCat.{w} C) {T : AddSubgroup (F.obj.obj (op X))} :
    yonedaTensorSubgroup S F ≤ T ↔
      ∀ (Y : C) (f : op Y ⟶ op X), f ∈ S.carrier (op (op Y)) →
        ∀ y : F.obj.obj (op Y), F.obj.map f y ∈ T := by
  rw [yonedaTensorSubgroup, AddSubgroup.closure_le]
  refine ⟨fun h Y f hf y ↦ h ⟨Y, f, hf, y, rfl⟩, ?_⟩
  rintro h _ ⟨Y, f, hf, y, rfl⟩
  exact h Y f hf y

/-- Each action by an arrow in the submodule belongs to the generated subgroup. -/
theorem map_mem_yonedaTensorSubgroup (F : ModCat.{w} C) {Y : C} {f : op Y ⟶ op X}
    (hf : f ∈ S.carrier (op (op Y))) (y : F.obj.obj (op Y)) :
    F.obj.map f y ∈ yonedaTensorSubgroup S F :=
  (yonedaTensorSubgroup_le_iff S F).mp le_rfl Y f hf y

/-- A module map carries the subgroup of actions into the corresponding subgroup in its target. -/
theorem yonedaTensorSubgroup_le_comap {F F' : ModCat.{w} C} (α : F ⟶ F') :
    yonedaTensorSubgroup S F ≤ (yonedaTensorSubgroup S F').comap (α.hom.app (op X)).hom := by
  refine (yonedaTensorSubgroup_le_iff S F).2 fun Y f hf y ↦ ?_
  rw [AddSubgroup.mem_comap]
  exact (ConcreteCategory.congr_hom (α.hom.naturality f) y) ▸
    map_mem_yonedaTensorSubgroup S F' hf (α.hom.app (op Y) y)

/-- Evaluation at `X` followed by quotienting by the action of `S`. Its values are the
concrete quotient groups, so their elements can be constructed with `QuotientAddGroup.mk'`. -/
abbrev yonedaTensorQuotient : ModCat.{w} C ⥤ AddCommGrpCat.{w} where
  obj F := AddCommGrpCat.of (F.obj.obj (op X) ⧸ yonedaTensorSubgroup S F)
  map α := AddCommGrpCat.ofHom <|
    QuotientAddGroup.map _ _ (α.hom.app (op X)).hom (yonedaTensorSubgroup_le_comap S α)
  map_id F := by
    apply AddCommGrpCat.ext
    intro z
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective (yonedaTensorSubgroup S F) z
    rfl
  map_comp {F _ _} α β := by
    apply AddCommGrpCat.ext
    intro z
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective (yonedaTensorSubgroup S F) z
    rfl

section Comparison

variable [EssentiallySmall.{v} C]
variable {G : ModCat.{v} Cᵒᵖ} (π : (yoneda Cᵒᵖ).obj (op X) ⟶ G)
variable (hπ : ∀ Y : C, Function.Surjective (π.hom.app (op (op Y))))
variable (hker : ∀ (Y : C) (f : op Y ⟶ op X),
  π.hom.app (op (op Y)) f = 0 ↔ f ∈ S.carrier (op (op Y)))
variable (F : ModCat.{v} C)

private noncomputable def quotientPairing (Y : C) :
    G.obj.obj (op (op Y)) →ₗ[ℤ] F.obj.obj (op Y) →ₗ[ℤ]
      (yonedaTensorQuotient S).obj F :=
  let q : F.obj.obj (op X) ⟶ (yonedaTensorQuotient S).obj F :=
    AddCommGrpCat.ofHom (QuotientAddGroup.mk' (yonedaTensorSubgroup S F))
  ((π.hom.app (op (op Y))).hom.toIntLinearMap.liftOfSurjective (hπ Y))
    ⟨(tmulLinear (G := (yoneda Cᵒᵖ).obj (op X)) (F := F) Y).compr₂ₛₗ
        (((yonedaTensorObjIso X F).hom ≫ q).hom.toIntLinearMap),
      fun f hf ↦ by
        apply LinearMap.mem_ker.mpr
        ext y
        -- View the pairing as a composite of a pure tensor, evaluation, and the quotient map.
        change QuotientAddGroup.mk' _ ((yonedaTensorObjIso X F).hom (tmul Y f y)) = 0
        exact (congrArg (QuotientAddGroup.mk' _) (yonedaTensorObjIso_hom_tmul F f y)).trans
          ((QuotientAddGroup.eq_zero_iff _).2
            (map_mem_yonedaTensorSubgroup S F ((hker Y f).mp (LinearMap.mem_ker.mp hf)) y))⟩

private theorem quotientPairing_apply (Y : C) (f : op Y ⟶ op X) (y : F.obj.obj (op Y)) :
    quotientPairing S π hπ hker F Y (π.hom.app (op (op Y)) f) y =
      QuotientAddGroup.mk' (yonedaTensorSubgroup S F) (F.obj.map f y) := by
  unfold quotientPairing
  -- The input to the descended pairing is the image under the integer-linear component.
  erw [LinearMap.equivOfSurjective_apply]
  exact congrArg (QuotientAddGroup.mk' _) (yonedaTensorObjIso_hom_tmul F f y)

private theorem quotientPairing_balance {Y Z : C} (f : Y ⟶ Z)
    (x : G.obj.obj (op (op Y))) (y : F.obj.obj (op Z)) :
    quotientPairing S π hπ hker F Z (G.obj.map f.op.op x) y =
      quotientPairing S π hπ hker F Y x (F.obj.map f.op y) := by
  obtain ⟨g, rfl⟩ := hπ Y x
  -- A preimage in the representable is an arrow, which is the input to the pairing formula.
  change op Y ⟶ op X at g
  have h : π.hom.app (op (op Z)) (f.op ≫ g) =
      G.obj.map f.op.op (π.hom.app (op (op Y)) g) :=
    (congrArg (π.hom.app (op (op Z))) (preadditiveYoneda_obj_map_apply f.op.op g).symm).trans
      (ConcreteCategory.congr_hom (π.hom.naturality f.op.op) g)
  calc
    _ = quotientPairing S π hπ hker F Z (π.hom.app (op (op Z)) (f.op ≫ g)) y :=
      congrArg (fun z ↦ quotientPairing S π hπ hker F Z z y) h.symm
    _ = _ := (quotientPairing_apply S π hπ hker F Z (f.op ≫ g) y).trans
      ((congrArg (QuotientAddGroup.mk' (yonedaTensorSubgroup S F))
        (ConcreteCategory.congr_hom (F.obj.map_comp f.op g) y)).trans
        (quotientPairing_apply S π hπ hker F Y g (F.obj.map f.op y)).symm)

private noncomputable def quotientTensorHom :
    tensorObj G F ⟶ (yonedaTensorQuotient S).obj F :=
  tensorDesc (quotientPairing S π hπ hker F) (fun _ _ ↦ quotientPairing_balance S π hπ hker F)

private theorem quotientTensorHom_tmul (Y : C) (f : op Y ⟶ op X) (y : F.obj.obj (op Y)) :
    quotientTensorHom S π hπ hker F (tmul Y (π.hom.app (op (op Y)) f) y) =
      QuotientAddGroup.mk' (yonedaTensorSubgroup S F) (F.obj.map f y) := by
  exact (tensorDesc_tmul _ _ Y _ y).trans (quotientPairing_apply S π hπ hker F Y f y)

private theorem tmul_quotient_id (Y : C) (f : op Y ⟶ op X) (y : F.obj.obj (op Y)) :
    tmul X (π.hom.app (op (op X)) (𝟙 (op X))) (F.obj.map f y) =
      tmul Y (π.hom.app (op (op Y)) f) y := by
  have h := preadditiveYoneda_obj_hom_app_apply π.hom f
  exact (tmul_balance (G := G) f.unop _ y).symm.trans (congrArg (fun g ↦ tmul Y g y) h.symm)

private noncomputable def quotientTensorInv : (yonedaTensorQuotient S).obj F ⟶ tensorObj G F :=
  AddCommGrpCat.ofHom <|
    QuotientAddGroup.lift (yonedaTensorSubgroup S F)
      ((tmulLinear X (π.hom.app (op (op X)) (𝟙 (op X)))) :
        F.obj.obj (op X) →ₗ[ℤ] tensorObj G F).toAddMonoidHom <| by
        refine (yonedaTensorSubgroup_le_iff S F).2 fun Y f hf y ↦ ?_
        apply AddMonoidHom.mem_ker.mpr
        exact (tmul_quotient_id (F := F) π Y f y).trans
          ((congrArg (fun g ↦ tmul Y g y) ((hker Y f).mpr hf)).trans (zero_tmul Y y))

private theorem quotientTensorInv_mk (y : F.obj.obj (op X)) :
    quotientTensorInv S π hker F (QuotientAddGroup.mk' (yonedaTensorSubgroup S F) y) =
      tmul X (π.hom.app (op (op X)) (𝟙 (op X))) y := by
  rfl

private noncomputable def quotientTensorIso :
    tensorObj G F ≅ (yonedaTensorQuotient S).obj F where
  hom := quotientTensorHom S π hπ hker F
  inv := quotientTensorInv S π hker F
  hom_inv_id := by
    apply tensorObj_hom_ext
    intro Y x y
    obtain ⟨f, rfl⟩ := hπ Y x
    calc
      _ = quotientTensorInv S π hker F
          (QuotientAddGroup.mk' (yonedaTensorSubgroup S F) (F.obj.map f y)) :=
        congrArg (quotientTensorInv S π hker F) (quotientTensorHom_tmul S π hπ hker F Y f y)
      _ = _ := (quotientTensorInv_mk S π hker F _).trans (tmul_quotient_id π F Y f y)
  inv_hom_id := by
    apply AddCommGrpCat.ext
    intro z
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective (yonedaTensorSubgroup S F) z
    have h := congrArg (quotientTensorHom S π hπ hker F) (quotientTensorInv_mk S π hker F y)
    exact h.trans ((quotientTensorHom_tmul S π hπ hker F X (𝟙 (op X)) y).trans
      (congrArg (QuotientAddGroup.mk' _) (ConcreteCategory.congr_hom (F.obj.map_id (op X)) y)))

private noncomputable def quotientTensorNatIso :
    tensor.obj G ≅ yonedaTensorQuotient S :=
  NatIso.ofComponents (quotientTensorIso S π hπ hker) (by
    intro F F' α
    apply tensorObj_hom_ext
    intro Y x y
    obtain ⟨f, rfl⟩ := hπ Y x
    have hmap := tensor_obj_map_tmul G α Y (π.hom.app (op (op Y)) f) y
    have hnaturality := congrArg (QuotientAddGroup.mk' (yonedaTensorSubgroup S F'))
      (ConcreteCategory.congr_hom (α.hom.naturality f) y).symm
    have hquotient := congrArg ((yonedaTensorQuotient S).map α)
      (quotientTensorHom_tmul S π hπ hker F Y f y).symm
    have hclass := QuotientAddGroup.map_mk' _ _ (α.hom.app (op X)).hom
      (yonedaTensorSubgroup_le_comap S α) (F.obj.map f y)
    exact (congrArg (quotientTensorHom S π hπ hker F') hmap).trans <|
      (quotientTensorHom_tmul S π hπ hker F' Y f _).trans <|
        hnaturality.trans (hclass.symm.trans hquotient))

end Comparison

section Cokernel

private theorem surjective_cokernel_π_app (Y : C) :
    Function.Surjective ((cokernel.π S.ι).hom.app (op (op Y))) := by
  have := (additiveFunctor Cᵒᵖᵒᵖ AddCommGrpCat.{v}).preservesEpimorphisms_ι_of_isNormalMonoCategory
  have : Epi (cokernel.π S.ι).hom :=
    (additiveFunctor Cᵒᵖᵒᵖ AddCommGrpCat.{v}).ι.map_epi (cokernel.π S.ι)
  exact (AddCommGrpCat.epi_iff_surjective _).mp
    ((NatTrans.epi_iff_epi_app _).mp ‹Epi (cokernel.π S.ι).hom› _)

private theorem cokernel_π_app_eq_zero_iff (Y : C) (f : op Y ⟶ op X) :
    (cokernel.π S.ι).hom.app (op (op Y)) f = 0 ↔ f ∈ S.carrier (op (op Y)) := by
  let P := additiveFunctor Cᵒᵖᵒᵖ AddCommGrpCat.{v}
  let E := P.ι ⋙ (evaluation _ _).obj (op (op Y))
  have := P.preservesCokernels_ι S.ι
  have hc := isColimitCoforkMapOfIsColimit' E (cokernel.condition S.ι) (cokernelIsCokernel S.ι)
  let T := ShortComplex.mk (E.map S.ι) (E.map (cokernel.π S.ι))
    (by rw [← E.map_comp, cokernel.condition, E.map_zero])
  have he := ShortComplex.exact_of_g_is_cokernel T hc
  have hx := (ShortComplex.ab_exact_iff_function_exact T).mp he f
  refine hx.trans ⟨?_, fun hf ↦ ⟨⟨f, hf⟩, S.ι_hom_app_apply _ _⟩⟩
  rintro ⟨z, hz⟩
  exact ((S.ι_hom_app_apply _ z).symm.trans hz) ▸ z.property

variable [EssentiallySmall.{v} C]

/-- Tensoring the quotient of a right representable by `S` computes evaluation modulo the
actions of arrows in `S`, naturally in the left module. -/
noncomputable def cokernelYonedaTensorIso :
    tensor.obj (cokernel S.ι) ≅ yonedaTensorQuotient S :=
  quotientTensorNatIso S (cokernel.π S.ι) (surjective_cokernel_π_app S)
    (cokernel_π_app_eq_zero_iff S)

/-- The comparison sends the tensor of a quotient class and an element to the class of the
action of the representative arrow. -/
@[simp↓]
theorem cokernelYonedaTensorIso_hom_app_tmul (F : ModCat.{v} C) (Y : C) (f : op Y ⟶ op X)
    (y : F.obj.obj (op Y)) :
    (cokernelYonedaTensorIso S).hom.app F (tmul Y ((cokernel.π S.ι).hom.app (op (op Y)) f) y) =
      QuotientAddGroup.mk' (yonedaTensorSubgroup S F) (F.obj.map f y) :=
  quotientTensorHom_tmul S (cokernel.π S.ι) (surjective_cokernel_π_app S)
    (cokernel_π_app_eq_zero_iff S) F Y f y

/-- The inverse comparison tensors with the class of the representing identity. -/
@[simp↓]
theorem cokernelYonedaTensorIso_inv_app_mk (F : ModCat.{v} C) (y : F.obj.obj (op X)) :
    (cokernelYonedaTensorIso S).inv.app F (QuotientAddGroup.mk' (yonedaTensorSubgroup S F) y) =
      tmul X ((cokernel.π S.ι).hom.app (op (op X)) (𝟙 (op X))) y :=
  quotientTensorInv_mk S (cokernel.π S.ι) (cokernel_π_app_eq_zero_iff S) F y

end Cokernel

end ModCat

namespace MorphismIdeal

variable (I : MorphismIdeal C) (X : C)

/-- The submodule of a representable consisting of arrows in the two-sided ideal. -/
def yonedaSubmodule : ModCat.Submodule ((ModCat.yoneda C).obj X) where
  carrier Y := I.hom Y.unop X
  map_mem f g hg := (preadditiveYoneda_obj_map_apply f g).symm ▸ I.comp_mem_left f.unop hg

/-- Membership in the representable submodule is membership in the hom ideal. -/
@[simp]
theorem mem_yonedaSubmodule {Y : Cᵒᵖ} (f : Y.unop ⟶ X) :
    f ∈ (I.yonedaSubmodule X).carrier Y ↔ f ∈ I.hom Y.unop X :=
  (Iff.rfl)

/-- The representable at `X` in the quotient category, restricted to a module on `C`. -/
@[expose] noncomputable def quotientYoneda : ModCat.{v} C :=
  ⟨I.quotientFunctor.op ⋙ preadditiveYoneda.obj (I.quotientFunctor.obj X),
    (additiveFunctor_iff _).2 inferInstance⟩

/-- The restricted representable acts by precomposition with the class of an arrow. -/
@[simp]
theorem quotientYoneda_obj_map_apply {Y Z : Cᵒᵖ} (f : Y ⟶ Z)
    (g : I.quotientFunctor.obj Y.unop ⟶ I.quotientFunctor.obj X) :
    (I.quotientYoneda X).obj.map f g = I.quotientFunctor.map f.unop ≫ g :=
  preadditiveYoneda_obj_map_apply (I.quotientFunctor.op.map f) g

/-- The map from the representable on `X` to the restricted quotient representable. -/
noncomputable def yonedaToQuotientYoneda : (ModCat.yoneda C).obj X ⟶ I.quotientYoneda X :=
  ObjectProperty.homMk (preadditiveYonedaMap I.quotientFunctor X)

/-- The quotient representable map takes an arrow to its class modulo the ideal. -/
@[simp↓]
theorem yonedaToQuotientYoneda_hom_app_apply (Y : Cᵒᵖ) (f : Y.unop ⟶ X) :
    (I.yonedaToQuotientYoneda X).hom.app Y f = I.quotientFunctor.map f :=
  preadditiveYonedaMap_app_apply I.quotientFunctor X Y f

/-- The projection to the quotient representable is surjective at each object. -/
theorem yonedaToQuotientYoneda_hom_app_surjective (Y : Cᵒᵖ) :
    Function.Surjective ((I.yonedaToQuotientYoneda X).hom.app Y) := by
  intro g
  obtain ⟨f, hf⟩ := I.quotientFunctor.map_surjective g
  exact ⟨f, (I.yonedaToQuotientYoneda_hom_app_apply X Y f).trans hf⟩

/-- The pointwise kernel of the projection is the submodule of ideal arrows. -/
@[simp↓]
theorem yonedaToQuotientYoneda_hom_app_eq_zero_iff {Y : Cᵒᵖ} (f : Y.unop ⟶ X) :
    (I.yonedaToQuotientYoneda X).hom.app Y f = 0 ↔ f ∈ (I.yonedaSubmodule X).carrier Y :=
  (congrArg (· = 0) (I.yonedaToQuotientYoneda_hom_app_apply X Y f)).to_iff.trans
    (I.quotientFunctor_map_eq_zero_iff.trans (I.mem_yonedaSubmodule X f).symm)

variable [EssentiallySmall.{v} C]

/-- Tensoring the restricted right representable from the quotient category computes
evaluation modulo the action of the ideal, naturally in the left module. -/
noncomputable def quotientYonedaTensorIso :
    ModCat.tensor.obj (I.op.quotientYoneda (Opposite.op X)) ≅
      ModCat.yonedaTensorQuotient (I.op.yonedaSubmodule (Opposite.op X)) :=
  ModCat.quotientTensorNatIso _ (I.op.yonedaToQuotientYoneda (Opposite.op X))
    (fun Y ↦
      I.op.yonedaToQuotientYoneda_hom_app_surjective (Opposite.op X) (Opposite.op (Opposite.op Y)))
    (fun _ f ↦ I.op.yonedaToQuotientYoneda_hom_app_eq_zero_iff (Opposite.op X) f)

/-- The quotient-category comparison evaluates a pure tensor at a representative arrow. -/
@[simp↓]
theorem quotientYonedaTensorIso_hom_app_tmul (F : ModCat.{v} C) (Y : C)
    (f : Opposite.op Y ⟶ Opposite.op X) (y : F.obj.obj (Opposite.op Y)) :
    (I.quotientYonedaTensorIso X).hom.app F (ModCat.tmul Y (I.op.quotientFunctor.map f) y) =
      QuotientAddGroup.mk' (ModCat.yonedaTensorSubgroup (I.op.yonedaSubmodule (Opposite.op X)) F)
        (F.obj.map f y) :=
  ModCat.quotientTensorHom_tmul _ (I.op.yonedaToQuotientYoneda (Opposite.op X)) _ _ F Y f y

/-- The inverse quotient-category comparison tensors with the class of the identity at `X`. -/
@[simp↓]
theorem quotientYonedaTensorIso_inv_app_mk (F : ModCat.{v} C) (y : F.obj.obj (Opposite.op X)) :
    (I.quotientYonedaTensorIso X).inv.app F
        (QuotientAddGroup.mk'
          (ModCat.yonedaTensorSubgroup (I.op.yonedaSubmodule (Opposite.op X)) F) y) =
      ModCat.tmul X (𝟙 (I.op.quotientFunctor.obj (Opposite.op X))) y := by
  have h := ModCat.quotientTensorInv_mk _ (I.op.yonedaToQuotientYoneda (Opposite.op X))
    (fun _ f ↦ I.op.yonedaToQuotientYoneda_hom_app_eq_zero_iff (Opposite.op X) f) F y
  exact h.trans (congrArg (fun a ↦ ModCat.tmul X a y) (I.op.quotientFunctor.map_id (Opposite.op X)))

end MorphismIdeal

end TauCeti
