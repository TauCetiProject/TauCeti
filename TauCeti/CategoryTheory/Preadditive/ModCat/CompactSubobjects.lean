module

public import TauCeti.CategoryTheory.Preadditive.ModCat.Submodule
import Mathlib.Order.Bounds.OrderIso
import TauCeti.Order.CompactlyGenerated

/-!
# Compact subobjects of modules over preadditive categories

The submodule generated by a point is compact because membership of that point in a directed
union is witnessed in one member. Every submodule is the supremum of the cyclic submodules
generated by its points. The order isomorphism with concrete submodules gives compact generation
of the subobject lattice, a hypothesis used to decompose semisimple modules into coproducts of
simple subobjects.

In the source category's morphism universe, a subobject is compact exactly when its underlying
functor is a quotient of a finite sum of representables.

For the elementwise and representable descriptions of generators, see B. Mitchell,
*Rings with several objects*, Adv. Math. 8 (1972), pp. 17–18, §3, applied to the opposite category.
-/

public section

universe w v u

open CategoryTheory Limits Opposite

namespace TauCeti.ModCat

variable {C : Type u} [Category.{v} C] [Preadditive C]

namespace Submodule

variable {F : ModCat.{w} C}

private def pointMap {X Y : Cᵒᵖ} (x : F.obj.obj X) : (X ⟶ Y) →+ F.obj.obj Y :=
  (AddMonoidHom.eval x).comp (AddCommGrpCat.homAddEquiv.toAddMonoidHom.comp F.obj.mapAddHom)

private theorem pointMap_apply {X Y : Cᵒᵖ} (x : F.obj.obj X) (f : X ⟶ Y) :
    pointMap x f = F.obj.map f x :=
  rfl

/-- The submodule generated by a point `x ∈ F(X)` consists at `Y` of the images of `x` under
the arrows `X ⟶ Y` in the opposite category. -/
def spanSingleton {X : Cᵒᵖ} (x : F.obj.obj X) : Submodule F where
  carrier _ := (pointMap x).range
  map_mem f := by
    rintro _ ⟨g, rfl⟩
    exact ⟨g ≫ f, ConcreteCategory.congr_hom (F.obj.map_comp g f) x⟩

/-- Membership in a cyclic submodule is witnessed by a single arrow. -/
@[simp]
theorem mem_spanSingleton {X Y : Cᵒᵖ} {x : F.obj.obj X} {y : F.obj.obj Y} :
    y ∈ (spanSingleton x).carrier Y ↔ ∃ f : X ⟶ Y, F.obj.map f x = y :=
  (Iff.rfl)

/-- The generating point belongs to its span. -/
theorem mem_spanSingleton_self {X : Cᵒᵖ} (x : F.obj.obj X) :
    x ∈ (spanSingleton x).carrier X :=
  mem_spanSingleton.2 ⟨𝟙 X, by simp⟩

/-- A submodule contains a point's span exactly when it contains the point. -/
@[simp]
theorem spanSingleton_le_iff {S : Submodule F} {X : Cᵒᵖ} {x : F.obj.obj X} :
    spanSingleton x ≤ S ↔ x ∈ S.carrier X := by
  refine ⟨fun h ↦ le_def.1 h X (mem_spanSingleton_self x), fun h ↦ le_def.2 fun Y y hy ↦ ?_⟩
  obtain ⟨f, rfl⟩ := mem_spanSingleton.1 hy
  exact S.map_mem f h

/-- The cyclic submodule generated by a point is a compact element of the submodule lattice. -/
theorem isCompactElement_spanSingleton {X : Cᵒᵖ} (x : F.obj.obj X) :
    IsCompactElement (spanSingleton x) := by
  rw [isCompactElement_iff_le_of_directed_sSup_le]
  intro s hne hs hx
  obtain ⟨S, hS, hxS⟩ := (mem_sSup_of_directedOn hne hs).1 (spanSingleton_le_iff.1 hx)
  exact ⟨S, hS, spanSingleton_le_iff.2 hxS⟩

/-- A submodule is the supremum of the cyclic submodules generated by its points. -/
theorem iSup_spanSingleton (S : Submodule F) :
    (⨆ p : Σ X, S.carrier X, spanSingleton (p.2 : F.obj.obj p.1)) = S := by
  refine le_antisymm (iSup_le fun p ↦ spanSingleton_le_iff.2 p.2.property) (le_def.2 ?_)
  intro X x hx
  exact le_def.1 (le_iSup (fun p : Σ X, S.carrier X ↦ spanSingleton p.2.val) ⟨X, x, hx⟩) X
    (mem_spanSingleton_self x)

/-- The concrete submodule lattice is compactly generated in every value universe. -/
instance : IsCompactlyGenerated (Submodule F) where
  exists_isLUB S := by
    let cyclic (p : Σ X, S.carrier X) := spanSingleton p.2.val
    refine ⟨Set.range cyclic, ?_, ?_⟩
    · rintro _ ⟨p, rfl⟩
      exact isCompactElement_spanSingleton p.2.val
    · exact isLUB_iff_sSup_eq.2 (sSup_range.trans S.iSup_spanSingleton)

/-- A submodule is compact exactly when it is generated by finitely many points. The points
may lie at different objects. -/
theorem isCompactElement_iff_exists_fin_iSup_eq (S : Submodule F) :
    IsCompactElement S ↔
      ∃ (n : ℕ) (Y : Fin n → Cᵒᵖ) (x : ∀ i, S.carrier (Y i)),
        (⨆ i, spanSingleton (x i : F.obj.obj (Y i))) = S := by
  constructor
  · intro hS
    let cyclic (p : Σ X, S.carrier X) := spanSingleton p.2.val
    obtain ⟨s, hs⟩ := hS.exists_finset_of_le_iSup cyclic S.iSup_spanSingleton.ge
    let e := s.equivFin.symm
    refine ⟨s.card, fun i ↦ (e i).val.1, fun i ↦ (e i).val.2, ?_⟩
    refine le_antisymm (iSup_le fun i ↦ spanSingleton_le_iff.2 (e i).val.2.property)
      (hs.trans (iSup₂_le fun p hp ↦ ?_))
    have he : (e (e.symm ⟨p, hp⟩)).val = p := congrArg Subtype.val (e.apply_symm_apply ⟨p, hp⟩)
    exact le_iSup_of_le (e.symm ⟨p, hp⟩) (congrArg cyclic he.symm).le
  · rintro ⟨n, Y, x, hx⟩
    rw [← hx]
    exact IsCompactElement.iSup fun i ↦ isCompactElement_spanSingleton (x i).val

private theorem range_comp_ι_eq_iff (S : Submodule F) {A : ModCat.{w} C}
    (p : A.obj ⟶ S.toModCat.obj) :
    range (ObjectProperty.homMk (p ≫ S.ι.hom) : A ⟶ F) = S ↔ Epi p := by
  let f : A ⟶ F := ObjectProperty.homMk (p ≫ S.ι.hom)
  have hf (Z : Cᵒᵖ) (a : A.obj.obj Z) : f.hom.app Z a = (p.app Z a).val :=
    S.ι_hom_app_apply Z (p.app Z a)
  rw [NatTrans.epi_iff_epi_app]
  constructor
  · intro h Z
    refine (AddCommGrpCat.epi_iff_surjective _).2 fun y ↦ ?_
    have hy : y.val ∈ (range f).carrier Z := by rw [h]; exact y.property
    obtain ⟨a, ha⟩ := (mem_range f).1 hy
    exact ⟨a, Subtype.ext ((hf Z a).symm.trans ha)⟩
  · intro h
    refine le_antisymm (le_def.2 fun Z y hy ↦ ?_) (le_def.2 fun Z y hy ↦ ?_)
    · obtain ⟨a, rfl⟩ := (mem_range f).1 hy
      rw [hf]
      exact (p.app Z a).property
    · obtain ⟨a, ha⟩ := (AddCommGrpCat.epi_iff_surjective (p.app Z)).1 (h Z) ⟨y, hy⟩
      exact (mem_range f).2 ⟨a, (hf Z a).trans (congrArg Subtype.val ha)⟩

section

variable {M : ModCat.{v} C}

private theorem range_sigma_preadditiveYoneda {J : Type} [Finite J] (Y : J → C)
    (p : (∐ fun i ↦ preadditiveYoneda.obj (Y i)) ⟶ M.obj) :
    let A : ModCat.{v} C := ⟨_, (additiveFunctor_iff _).2
      (inferInstance : (∐ fun i ↦ preadditiveYoneda.obj (Y i)).Additive)⟩
    range (ObjectProperty.homMk p : A ⟶ M) =
      ⨆ i, spanSingleton ((Sigma.ι _ i ≫ p).app (op (Y i)) (𝟙 (Y i))) := by
  intro A
  let T : Submodule M := ⨆ i, spanSingleton ((Sigma.ι _ i ≫ p).app (op (Y i)) (𝟙 (Y i)))
  refine le_antisymm (le_def.2 ?_) (iSup_le fun i ↦ spanSingleton_le_iff.2 ?_)
  · let q := Sigma.desc fun i ↦ T.liftHom (Sigma.ι _ i ≫ p) fun X g ↦ by
      rw [preadditiveYoneda_obj_hom_app_apply _ (X := X.unop) g]
      exact le_def.1 (le_iSup (fun j ↦ spanSingleton
        ((Sigma.ι _ j ≫ p).app (op (Y j)) (𝟙 (Y j)))) i) X (mem_spanSingleton.2 ⟨g.op, rfl⟩)
    have hq : q ≫ T.ι.hom = p := Sigma.hom_ext _ _ fun i ↦ by simp [q]
    intro X y hy
    obtain ⟨a, rfl⟩ := (mem_range _).1 hy
    have h : (q.app X a).val = p.app X a :=
      (T.ι_hom_app_apply X (q.app X a)).symm.trans
        (ConcreteCategory.congr_hom (NatTrans.congr_app hq X) a)
    exact h ▸ (q.app X a).property
  · exact (mem_range _).2 ⟨(Sigma.ι (fun j ↦ preadditiveYoneda.obj (Y j)) i).app _ (𝟙 _), rfl⟩

/-- A compact concrete submodule is exactly a finitely generated additive functor when its
value universe is the morphism universe of the source category. -/
theorem isCompactElement_iff_isFinitelyGeneratedFunctor (S : Submodule M) :
    IsCompactElement S ↔ IsFinitelyGeneratedFunctor S.toModCat.obj := by
  constructor
  · intro hS
    obtain ⟨n, Y, x, hx⟩ := S.isCompactElement_iff_exists_fin_iSup_eq.1 hS
    let y (i : Fin n) : S.toModCat.obj.obj (Y i) := x i
    let α (i : Fin n) : preadditiveYoneda.obj (Y i).unop ⟶ S.toModCat.obj :=
      { app Z := AddCommGrpCat.ofHom ((pointMap (y i)).comp (opHom _ _))
        naturality Z W f := AddCommGrpCat.ext fun (g : Z.unop ⟶ (Y i).unop) ↦
          ConcreteCategory.congr_hom (S.toModCat.obj.map_comp g.op f) (y i) }
    have hα (i : Fin n) : (α i).app (Y i) (𝟙 (Y i).unop) = y i := by
      calc
        _ = pointMap (y i) ((𝟙 (Y i).unop).op) := rfl
        _ = S.toModCat.obj.map (𝟙 (Y i)) (y i) := pointMap_apply (y i) (𝟙 (Y i))
        _ = y i := by simp
    let p := Sigma.desc α
    let A : ModCat.{v} C := ⟨_, (additiveFunctor_iff _).2
      (inferInstance : (∐ fun i ↦ preadditiveYoneda.obj (Y i).unop).Additive)⟩
    have hgen (i : Fin n) : (Sigma.ι (fun j ↦ preadditiveYoneda.obj (Y j).unop) i ≫
        p ≫ S.ι.hom).app (op (Y i).unop) (𝟙 (Y i).unop) = (x i).val := by
      have he : Sigma.ι (fun j ↦ preadditiveYoneda.obj (Y j).unop) i ≫ p ≫ S.ι.hom =
          α i ≫ S.ι.hom := Sigma.ι_comp_desc_assoc α i _
      calc
        _ = (α i ≫ S.ι.hom).app (Y i) (𝟙 (Y i).unop) :=
          ConcreteCategory.congr_hom (NatTrans.congr_app he (Y i)) _
        _ = ((α i).app (Y i) (𝟙 (Y i).unop)).val := S.ι_hom_app_apply _ _
        _ = (x i).val := congrArg Subtype.val (hα i)
    have h : range (ObjectProperty.homMk (p ≫ S.ι.hom) : A ⟶ M) = S := by
      rw [range_sigma_preadditiveYoneda]
      simpa only [hgen] using hx
    exact isFinitelyGeneratedFunctor_def.2
      ⟨n, fun i ↦ (Y i).unop, p, (range_comp_ι_eq_iff S (A := A) p).1 h⟩
  · intro hS
    obtain ⟨n, Y, p, hp⟩ := isFinitelyGeneratedFunctor_def.1 hS
    let A : ModCat.{v} C := ⟨_, (additiveFunctor_iff _).2
      (inferInstance : (∐ fun i ↦ preadditiveYoneda.obj (Y i)).Additive)⟩
    have h : range (ObjectProperty.homMk (p ≫ S.ι.hom) : A ⟶ M) = S :=
      (range_comp_ι_eq_iff S (A := A) p).2 hp
    rw [← h, range_sigma_preadditiveYoneda]
    exact IsCompactElement.iSup fun _ ↦ isCompactElement_spanSingleton _

end

end Submodule

/-- Subobjects of a module over a preadditive category form a compactly generated lattice. -/
instance instIsCompactlyGeneratedSubobject (F : ModCat.{w} C) :
    IsCompactlyGenerated (Subobject F) where
  exists_isLUB P := by
    let e := Submodule.orderIsoSubobject F
    obtain ⟨s, hs, hLUB⟩ := IsCompactlyGenerated.exists_isLUB (e.symm P)
    refine ⟨e '' s, ?_, ?_⟩
    · rintro _ ⟨S, hS, rfl⟩
      exact e.isCompactElement (hs S hS)
    · simpa only [e.apply_symm_apply] using e.isLUB_image'.2 hLUB

/-- A subobject of a module in the source category's morphism universe is compact exactly
when its underlying functor is finitely generated. -/
theorem _root_.CategoryTheory.Subobject.isCompactElement_iff_isFinitelyGeneratedFunctor
    {M : ModCat.{v} C} (P : Subobject M) :
    IsCompactElement P ↔ IsFinitelyGeneratedFunctor (P : ModCat.{v} C).obj := by
  let S := Submodule.range P.arrow
  have hS : Subobject.mk S.ι = P := (Submodule.mk_range_ι P.arrow).trans P.mk_arrow
  have hc := (Submodule.orderIsoSubobject M).isCompactElement_iff (a := S)
  rw [Submodule.orderIsoSubobject_apply, hS] at hc
  let e := Subobject.isoOfEqMk P S.ι hS.symm
  exact hc.trans (S.isCompactElement_iff_isFinitelyGeneratedFunctor.trans
    ⟨fun h ↦ h.of_epi e.inv.hom, fun h ↦ h.of_epi e.hom.hom⟩)

end TauCeti.ModCat
