module

public import TauCeti.CategoryTheory.Preadditive.ModCat.Flat.Factorization
public import TauCeti.CategoryTheory.Preadditive.VonNeumannRegular

import Mathlib.CategoryTheory.Abelian.Exact
import TauCeti.CategoryTheory.Projective.Images

/-!
# Modules over von Neumann regular categories

Regularity of a preadditive category is equivalent to equational flatness
of every module, projectivity of every finitely presented module, and splitting
of principal submodules of representables. Over a regular category even the
submodule generated by any finite family of arrows into a representable splits.

See D. Simson, *On pure global dimension of locally finitely presented
Grothendieck categories*, Theorem 1.4, and B. Stenström, *Purity in functor
categories*, §5, Theorem 4. The equational proof allows preadditive sources
without size or biproduct assumptions.
-/

public section

open CategoryTheory Limits Opposite

universe w v u

namespace TauCeti.ModCat

variable {C : Type u} [Category.{v} C] [Preadditive C]

/-- Every module over a von Neumann regular preadditive category is flat, in any value universe. -/
theorem flat_of_isVonNeumannRegularCategory [IsVonNeumannRegularCategory C] (F : ModCat.{w} C) :
    F.Flat where
  isTrivialRelation {X n Y} β y h := by
    have := (additiveFunctor_iff F.obj).1 F.property
    obtain ⟨γ, hγ⟩ := IsVonNeumannRegularCategory.exists_sum_comp_comp_eq_self β
    let δ (i j : Fin n) : Y j ⟶ Y i := if hij : j = i then eqToHom (congrArg Y hij) else 0
    refine isTrivialRelation_def.mpr ⟨n, Y, y, fun i j ↦ δ i j - γ j ≫ β i, ?_, ?_⟩
    · intro j
      have hδ : ∑ i, F.obj.map (δ i j).op (y i) = y j := by
        rw [Finset.sum_eq_single j]
        · simp [δ]
        · intro i _ hi
          simp [δ, hi.symm]
        · simp
      simp only [op_sub, Functor.map_sub, AddCommGrpCat.hom_sub, AddMonoidHom.sub_apply,
        Finset.sum_sub_distrib,
        hδ, op_comp, Functor.map_comp, CategoryTheory.comp_apply, ← map_sum, h, map_zero, sub_zero]
    · intro i
      have hδ : ∑ j, β j ≫ δ i j = β i := by
        rw [Finset.sum_eq_single i]
        · simp [δ]
        · intro j _ hj
          simp [δ, hj]
        · simp
      simp only [Preadditive.comp_sub, Finset.sum_sub_distrib, hδ, ← Category.assoc _ (γ _) _,
        ← Preadditive.sum_comp, hγ, sub_self]

/-- Von Neumann regularity is equivalent to splitting all principal submodules of representables. -/
theorem isVonNeumannRegularCategory_iff_isSplitMono_image_ι_yoneda_map :
    IsVonNeumannRegularCategory C ↔
      ∀ ⦃X Y : C⦄ (f : X ⟶ Y), IsSplitMono (image.ι ((yoneda C).map f)) := by
  refine ⟨fun h _ _ f ↦ ?_, fun h ↦ ⟨fun {_ _} f ↦ ?_⟩⟩
  · obtain ⟨g, hg⟩ := h.exists_comp_comp_eq_self f
    exact ((yoneda C).map f).isSplitMono_image_ι_iff_exists_comp_comp_eq_self.mpr
      ⟨(yoneda C).map g, by simpa only [Functor.map_comp] using congrArg (yoneda C).map hg⟩
  · obtain ⟨g, hg⟩ := ((yoneda C).map f).isSplitMono_image_ι_iff_exists_comp_comp_eq_self.mp (h f)
    exact ⟨(yoneda C).preimage g, (yoneda C).map_injective (by
      simpa only [Functor.map_comp, Functor.map_preimage] using hg)⟩

/-- In a regular category the submodule generated by a finite family of arrows into a
representable is a direct summand. -/
theorem isSplitMono_image_ι_desc_yoneda_map [IsVonNeumannRegularCategory C]
    {Y : C} {n : ℕ} {X : Fin n → C} (β : ∀ j, X j ⟶ Y) :
    IsSplitMono (image.ι (Sigma.desc fun j ↦ (yoneda C).map (β j))) := by
  obtain ⟨γ, hγ⟩ :=
    IsVonNeumannRegularCategory.exists_sum_comp_comp_eq_self (C := Cᵒᵖ) (fun j ↦ (β j).op)
  let d := Sigma.desc fun j ↦ (yoneda C).map (β j)
  let g := ∑ j, (yoneda C).map (γ j).unop ≫ Sigma.ι ((yoneda C).obj ∘ X) j
  have hg : g ≫ d = (yoneda C).map (∑ j, (γ j).unop ≫ β j) := by
    simp only [g, d, Preadditive.sum_comp, Category.assoc, Sigma.ι_comp_desc, Functor.map_sum,
      Functor.map_comp]
  refine d.isSplitMono_image_ι_iff_exists_comp_comp_eq_self.mpr ⟨g, ?_⟩
  apply Sigma.hom_ext
  intro k
  have hk : β k ≫ (∑ j, (γ j).unop ≫ β j) = β k := by
    simpa only [unop_comp, unop_sum, Quiver.Hom.unop_op] using
      congrArg Quiver.Hom.unop (hγ k)
  simp only [hg, d, Sigma.ι_comp_desc_assoc, Sigma.ι_comp_desc, ← Functor.map_comp, hk]

/-- A preadditive category is von Neumann regular if and only if every finitely presented
module is projective. -/
theorem isVonNeumannRegularCategory_iff_finitelyPresented_projective :
    IsVonNeumannRegularCategory C ↔
      ∀ F : ModCat.{v} C, IsFinitelyPresentedFunctor F.obj → Projective F := by
  refine ⟨fun h F hF ↦ ?_, fun h ↦ ?_⟩
  · let := flat_of_isVonNeumannRegularCategory F
    exact Flat.projective_of_isFinitelyPresentedFunctor hF
  · apply isVonNeumannRegularCategory_iff_isSplitMono_image_ι_yoneda_map.mpr
    intro X Y f
    let d := (yoneda C).map f
    have hp : Projective (cokernel d) := h _ <|
      isFinitelyPresentedFunctor_iff_exists_finiteFree_presentation.mpr
        ⟨_, _, isFiniteFree_yoneda_obj X, isFiniteFree_yoneda_obj Y, d,
          cokernel.π d, cokernel.condition d, ⟨cokernelIsCokernel d⟩⟩
    let S := ShortComplex.mk (image.ι d) (cokernel.π d)
      (image_ι_comp_eq_zero (cokernel.condition d))
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_f_is_kernel S (ShortComplex.exact_cokernel d).isLimitImage')
        (by dsimp [S]; infer_instance) (by dsimp [S]; infer_instance)
    exact hS.splittingOfProjective.isSplitMono_f

/-- A preadditive category is von Neumann regular if and only if every module in its
morphism universe is flat. Regularity then gives flatness in every value universe. -/
theorem isVonNeumannRegularCategory_iff_forall_flat :
    IsVonNeumannRegularCategory C ↔ ∀ F : ModCat.{v} C, F.Flat := by
  refine ⟨fun h F ↦ flat_of_isVonNeumannRegularCategory F, fun h ↦
    isVonNeumannRegularCategory_iff_finitelyPresented_projective.mpr fun F hF ↦ ?_⟩
  let := h F
  exact Flat.projective_of_isFinitelyPresentedFunctor hF

end TauCeti.ModCat
