module

public import TauCeti.CategoryTheory.DG.AdditiveClosure.QuasiEquivalence
public import TauCeti.CategoryTheory.DG.ShiftClosure.QuasiEquivalence
public import TauCeti.CategoryTheory.DG.Twisted.Functor
public import TauCeti.CategoryTheory.Triangulated.MapBijective

/-!
# Quasi-equivalences and pretriangulated envelopes

Let `F : C ⥤ D` be a DG functor.  It induces a triangulated functor `H⁰(F)` between the homotopy
categories of twisted complexes, which sends one-sided twisted complexes to one-sided twisted
complexes (`TauCeti/CategoryTheory/DG/Twisted/Functor.lean`).  This file shows:

* if `F` is quasi-fully faithful, then `H⁰(F)` is fully faithful on one-sided twisted complexes
  (`EnrichedFunctor.IsQuasiFullyFaithful.mapDGTwistedComplex_mapDGHomotopyCategory_map_bijective`);
* if `F` is a quasi-equivalence, then `H⁰(F)` restricts to an **equivalence between the homotopy
  categories `H⁰(pretr C) ≌ H⁰(pretr D)` of the pretriangulated envelopes**, the full
  subcategories of one-sided twisted complexes
  (`CategoryTheory.EnrichedFunctor.IsQuasiEquivalence.isEquivalence_mapOneSided`).

The restriction `CategoryTheory.EnrichedFunctor.mapOneSided` is triangulated, by Mathlib's
instances for functors lifted to triangulated subcategories.

The proof is a dévissage.  The pretriangulated envelope of `C` is the triangulated subcategory
generated by the objects `X[0]` of `C` (`TauCeti.DGTwistedObject.oneSided_le`), so by
`CategoryTheory.Functor.map_bijective_of_forall_le` it suffices that `H⁰(F)` is bijective on
morphisms `X[0] ⟶ Y[0]⟦n⟧ = Y[n]`.  These morphisms are the degree-zero cohomology of the Hom
complex `Hom(X[0], Y[n])` of twisted objects with zero twist, which is the shifted Hom complex
`Hom(X, Y)[n]` of `C`.  The Hom complexes of the shift closure are shifts of those of `C`, so a
quasi-fully faithful `F` stays quasi-fully faithful on the shift closure
(`CategoryTheory.EnrichedFunctor.IsQuasiFullyFaithful.mapDGShiftClosure`); one-term sums of the
additive closure (`CategoryTheory.EnrichedFunctor.quasiIso_mapDGAdditiveClosure_map_iff`) and
twisted objects with zero twist do not change Hom complexes.

For essential surjectivity, the essential image of the restriction of `H⁰(F)` to `H⁰(pretr C)`
is a triangulated subcategory, since this restriction is full and triangulated.  For a
quasi-equivalence it contains every object `Y[0]` of `D` up to isomorphism, since `Y` is
isomorphic in `H⁰(D)` to some `F X`.  So it contains the triangulated subcategory generated by
`D`, which is `H⁰(pretr D)`.

## Main definitions

* `CategoryTheory.EnrichedFunctor.mapOneSided`: the functor `H⁰(pretr C) ⥤ H⁰(pretr D)` induced
  by a DG functor.

## Main results

* `CategoryTheory.EnrichedFunctor.quasiIso_mapDGTwistedObject_map_iff_of_twist_eq_zero`: on
  twisted objects with zero twist, the induced DG functor is a quasi-isomorphism on Hom complexes
  exactly when the original one is.
* `EnrichedFunctor.IsQuasiFullyFaithful.mapDGTwistedComplex_mapDGHomotopyCategory_map_bijective`:
  a quasi-fully faithful DG functor induces a fully faithful functor on one-sided twisted
  complexes.
* `CategoryTheory.EnrichedFunctor.IsQuasiEquivalence.isEquivalence_mapOneSided`: a
  quasi-equivalence induces an equivalence of the homotopy categories of the pretriangulated
  envelopes.

## References

* A. I. Bondal and M. M. Kapranov, *Enhanced triangulated categories*, Mathematics of the
  USSR-Sbornik 70 (1991), 93--107.
* V. Drinfeld, *DG quotients of DG categories*, Section 2.4.
-/

public section

open CategoryTheory Pretriangulated

namespace CategoryTheory.EnrichedFunctor

open TauCeti DGTwistedObject DGHomotopyCategory

universe v u u₂

variable {R : Type v} [CommRing R] {C : Type u} {D : Type u₂} [DGCategory R C] [DGCategory R D]

/-! ### Twisted objects with zero twist -/

section twisted

variable {E E' : Type*} [DGCategory R E] [DGCategory R E']

/-- **On twisted objects with zero twist, the DG functor induced on twisted objects is a
quasi-isomorphism on Hom complexes exactly when the original one is**: these Hom complexes are
those of the underlying objects. -/
theorem quasiIso_mapDGTwistedObject_map_iff_of_twist_eq_zero
    (F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) E E')
    {X Y : DGTwistedObject R E} (hX : X.twist = 0) (hY : Y.twist = 0) :
    QuasiIso (F.mapDGTwistedObject.map X Y) ↔ QuasiIso (F.map X.obj Y.obj) := by
  have hFX : (F.mapDGTwistedObject.obj X).twist = 0 :=
    (congrArg (F.dgMap 1) hX).trans (map_zero _)
  have hFY : (F.mapDGTwistedObject.obj Y).twist = 0 :=
    (congrArg (F.dgMap 1) hY).trans (map_zero _)
  refine quasiIso_iff_of_arrow_mk_iso _ _ (Arrow.isoMk' _ _ (dgHomComplexIsoOfTwistEqZero R hX hY)
    (dgHomComplexIsoOfTwistEqZero R hFX hFY) ?_)
  ext n f
  -- `simp only` cannot replace this chain: the objects of the right-hand composite are
  -- `F.mapDGTwistedObject.obj X`, which reducible unification does not identify with the objects
  -- in `dgHomComplexIsoOfTwistEqZero_hom_f_apply` and `dgMap_apply`.
  rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, ModuleCat.hom_comp, ModuleCat.hom_comp,
    LinearMap.comp_apply, LinearMap.comp_apply, ← dgMap_apply, ← dgMap_apply,
    dgHomComplexIsoOfTwistEqZero_hom_f_apply, dgHomComplexIsoOfTwistEqZero_hom_f_apply]
  exact (F.dgHomEquiv_dgMap_mapDGTwistedObject f).symm

end twisted

/-! ### Full faithfulness on one-sided twisted complexes -/

/-- On twisted complexes `A` and `B` with one summand and zero twist, `H⁰(F)` is bijective on
morphisms when `F` is quasi-fully faithful. -/
private theorem IsQuasiFullyFaithful.mapDGTwistedComplex_mapDGHomotopyCategory_map_bijective_ofObj
    {F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) C D} (hF : F.IsQuasiFullyFaithful)
    (A B : DGShiftClosure C) :
    Function.Bijective (F.mapDGTwistedComplex.mapDGHomotopyCategory.map :
      (of R (ofObj R ((DGAdditiveClosure.embedding R).obj A)) ⟶
        of R (ofObj R ((DGAdditiveClosure.embedding R).obj B))) → _) :=
  F.mapDGTwistedComplex.mapDGHomotopyCategory_map_bijective_of_quasiIsoAt _ _
    (((quasiIso_mapDGTwistedObject_map_iff_of_twist_eq_zero _ rfl rfl).2
      ((quasiIso_mapDGAdditiveClosure_map_iff _ A B).2
        (hF.mapDGShiftClosure.quasiIso A B))).quasiIsoAt 0)

/-- **A quasi-fully faithful DG functor is fully faithful on pretriangulated envelopes**: `H⁰(F)`
is bijective on morphisms between one-sided twisted complexes. -/
theorem IsQuasiFullyFaithful.mapDGTwistedComplex_mapDGHomotopyCategory_map_bijective
    {F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) C D} (hF : F.IsQuasiFullyFaithful)
    {X Y : DGHomotopyCategory R (DGTwistedObject R (DGAdditiveClosure (DGShiftClosure C)))}
    (hX : oneSided R C X) (hY : oneSided R C Y) :
    Function.Bijective (F.mapDGTwistedComplex.mapDGHomotopyCategory.map : (X ⟶ Y) → _) := by
  refine F.mapDGTwistedComplex.mapDGHomotopyCategory.map_bijective_of_forall_le
    (P := ObjectProperty.ofObj fun X : C ↦ of R ((DGTwistedObject.embedding R).obj
      ((DGAdditiveClosure.embedding R).obj ((DGShiftClosure.ι R).obj X))))
    (fun _ _ _ _ hPQ ↦ oneSided_le fun X ↦ hPQ _ (ObjectProperty.ofObj_apply _ X)) ?_ hX hY
  rintro _ _ ⟨X⟩ ⟨Y⟩ n
  -- The shift of `Y[0]` by `n` is the twisted complex `Y[0 + n]` with one summand.
  have e : (of R ((DGTwistedObject.embedding R).obj ((DGAdditiveClosure.embedding R).obj
      ((DGShiftClosure.ι R).obj Y))))⟦n⟧ =
        of R (ofObj R ((DGAdditiveClosure.embedding R).obj ⟨Y, 0 + n⟩)) := by
    rw [DGTwistedObject.embedding_obj, shiftFunctor_obj_of, shiftFunctor_obj_ofObj,
      DGAdditiveClosure.embedding_obj, DGAdditiveClosure.embedding_obj, DGShiftClosure.ι_obj]
  exact (Functor.map_bijective_iff_of_iso _ (Iso.refl _) (eqToIso e.symm)).2
    (hF.mapDGTwistedComplex_mapDGHomotopyCategory_map_bijective_ofObj _ _)

/-! ### The functor on pretriangulated envelopes -/

/-- The functor `H⁰(pretr C) ⥤ H⁰(pretr D)` induced by a DG functor `F` between the homotopy
categories of the pretriangulated envelopes: the restriction of `H⁰(F)` to one-sided twisted
complexes. -/
-- This is reducible so that Mathlib's instances for functors lifted to a full subcategory, such as
-- the shift compatibility and triangulatedness, apply to it.
noncomputable abbrev mapOneSided (F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) C D) :
    (oneSided R C).FullSubcategory ⥤ (oneSided R D).FullSubcategory :=
  (oneSided R D).lift ((oneSided R C).ι ⋙ F.mapDGTwistedComplex.mapDGHomotopyCategory)
    fun X ↦ F.oneSided_mapDGHomotopyCategory_obj X.property

/-- The restriction of `H⁰(F)` to one-sided twisted complexes, with values in all twisted
complexes, is bijective on morphisms when `F` is quasi-fully faithful. -/
private theorem IsQuasiFullyFaithful.ι_comp_map_bijective
    {F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) C D} (hF : F.IsQuasiFullyFaithful)
    (X Y : (oneSided R C).FullSubcategory) :
    Function.Bijective
      (((oneSided R C).ι ⋙ F.mapDGTwistedComplex.mapDGHomotopyCategory).map : (X ⟶ Y) → _) :=
  (hF.mapDGTwistedComplex_mapDGHomotopyCategory_map_bijective X.property Y.property).comp
    ((oneSided R C).fullyFaithfulι.map_bijective X Y)

/-- A quasi-fully faithful DG functor induces a full functor between the homotopy categories of
the pretriangulated envelopes. -/
theorem IsQuasiFullyFaithful.full_mapOneSided
    {F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) C D} (hF : F.IsQuasiFullyFaithful) :
    F.mapOneSided.Full :=
  have : ((oneSided R C).ι ⋙ F.mapDGTwistedComplex.mapDGHomotopyCategory).Full :=
    ⟨fun {X Y} ↦ (hF.ι_comp_map_bijective X Y).2⟩
  inferInstance

/-- A quasi-fully faithful DG functor induces a faithful functor between the homotopy categories
of the pretriangulated envelopes. -/
theorem IsQuasiFullyFaithful.faithful_mapOneSided
    {F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) C D} (hF : F.IsQuasiFullyFaithful) :
    F.mapOneSided.Faithful :=
  have : ((oneSided R C).ι ⋙ F.mapDGTwistedComplex.mapDGHomotopyCategory).Faithful :=
    ⟨fun {X Y} ↦ (hF.ι_comp_map_bijective X Y).1⟩
  inferInstance

/-- **A quasi-equivalence induces an essentially surjective functor between the homotopy
categories of the pretriangulated envelopes.**  The essential image of the restriction of `H⁰(F)`
to one-sided twisted complexes is a triangulated subcategory containing every object of `D`, hence
every one-sided twisted complex over `D`. -/
theorem IsQuasiEquivalence.essSurj_mapOneSided
    {F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) C D} (hF : F.IsQuasiEquivalence) :
    F.mapOneSided.EssSurj := by
  let G := (oneSided R C).ι ⋙ F.mapDGTwistedComplex.mapDGHomotopyCategory
  have : G.Full := ⟨fun {X Y} ↦ (hF.isQuasiFullyFaithful.ι_comp_map_bijective X Y).2⟩
  have hle : oneSided R D ≤ G.essImage := oneSided_le fun Y ↦ by
    obtain ⟨X, ⟨e⟩⟩ := hF.essentiallySurjective Y
    -- The image of `X[0]` is `(F X)[0]`, up to the vanishing of the image of the zero twist.
    have h : F.mapDGTwistedComplex.obj ((DGTwistedObject.embedding R).obj
        ((DGAdditiveClosure.embedding R).obj ((DGShiftClosure.ι R).obj X))) =
          (DGTwistedObject.embedding R).obj ((DGAdditiveClosure.embedding R).obj
            ((DGShiftClosure.ι R).obj (F.obj X))) :=
      eq_ofObj_of_twist_eq_zero R (map_zero _)
    exact ⟨⟨_, (oneSided_of_iff _).2 (isOneSided_ofObj _)⟩, ⟨eqToIso (congrArg (of R) h) ≪≫
      (DGTwistedObject.embedding R).mapDGHomotopyCategory.mapIso
        ((DGAdditiveClosure.embedding R).mapDGHomotopyCategory.mapIso
          ((DGShiftClosure.ι R).mapDGHomotopyCategory.mapIso e))⟩⟩
  refine ⟨fun Y ↦ ?_⟩
  obtain ⟨X, ⟨e⟩⟩ := hle _ Y.property
  exact ⟨X, ⟨(oneSided R D).fullyFaithfulι.preimageIso e⟩⟩

/-- **A quasi-equivalence of DG categories induces an equivalence `H⁰(pretr C) ≌ H⁰(pretr D)`
between the homotopy categories of the pretriangulated envelopes.** -/
theorem IsQuasiEquivalence.isEquivalence_mapOneSided
    {F : EnrichedFunctor (CochainComplex (ModuleCat.{v} R) ℤ) C D} (hF : F.IsQuasiEquivalence) :
    F.mapOneSided.IsEquivalence where
  faithful := hF.isQuasiFullyFaithful.faithful_mapOneSided
  full := hF.isQuasiFullyFaithful.full_mapOneSided
  essSurj := hF.essSurj_mapOneSided

end CategoryTheory.EnrichedFunctor
