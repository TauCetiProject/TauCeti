module

public import Mathlib.Algebra.Exact.Basic
public import TauCeti.CategoryTheory.GrothendieckGroup.Relative
public import TauCeti.CategoryTheory.GrothendieckGroup.Split.SummandDense

/-!
# Exactness of `K₀(T) → K₀(C) → K₀(D)` for a summand-dense functor

Let `T : C ⥤ D` be a functor preserving zero morphisms and binary biproducts, such as an additive
functor between additive categories. Its relative Grothendieck group `K₀(T)`
(`TauCeti.RelativeK0 T`) is generated by triples `(P, α, Q)` with `α : T P ≅ T Q`, and the
difference map sends such a triple to `[P] - [Q]` in the split Grothendieck group of `C`. The
composite with the map `K₀(C) → K₀(D)` induced by `T` vanishes, because `T P ≅ T Q`.

If `T` is summand-dense, every object of `D` being a direct summand of some `T P`, the sequence

```text
K₀(T) ──[P, α, Q] ↦ [P] - [Q]──▶ K₀(C) ──[P] ↦ [T P]──▶ K₀(D)
```

is exact at `K₀(C)`. Indeed, an element of `K₀(C)` is a difference `[P] - [Q]`; if its image
vanishes then `[T P] = [T Q]`, so `T P ⊞ T S ≅ T Q ⊞ T S` for some `S` by summand-density
(`TauCeti.SplitK0.of_eq_of_iff_of_isSummandDense`). Since `T` preserves biproducts this is an
isomorphism `α : T (P ⊞ S) ≅ T (Q ⊞ S)`, and the triple `(P ⊞ S, α, Q ⊞ S)` has difference
`[P] - [Q]`.

Neither fullness of `T` nor any automorphism group is used. Applied to extension of scalars along
a ring homomorphism `R → S` on finitely generated projective modules, this is the exactness of
`K₀(R → S) → K₀(R) → K₀(S)` at `K₀(R)`, and for the quotient by a two-sided ideal `I` it is the
`K₀(R)` term of the sequence `K₁(R) → K₁(R/I) → K₀(R, I) → K₀(R) → K₀(R/I)`.

## Main results

* `TauCeti.RelativeK0.exact_toSplitK0_splitK0Map`: for summand-dense `T` and `C` with a zero
  object, the sequence `K₀(T) → K₀(C) → K₀(D)` is exact at `K₀(C)`.

## References

* Charles A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, Chapter II,
  Definition 2.10, (2.10.2) and Exercise 2.17 (the relative group `K₀(T)` of a cofinal functor
  and its exact sequence).
-/

public section

namespace TauCeti

open CategoryTheory CategoryTheory.Limits

universe w w' v v' u u'

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [HasZeroObject C]
  [HasBinaryBiproducts C] [EssentiallySmall.{w} C]
  {D : Type u'} [Category.{v'} D] [HasZeroMorphisms D] [HasBinaryBiproducts D]
  [LocallySmall.{w} D] [EssentiallySmall.{w'} D]
  (T : C ⥤ D) [T.PreservesZeroMorphisms] [PreservesBiproductsOfShape WalkingPair T]

namespace RelativeK0

/-- **Exactness of `K₀(T) → K₀(C) → K₀(D)` at `K₀(C)`** for a summand-dense functor `T`: an
element of `K₀(C)` maps to zero in `K₀(D)` exactly when it is the difference `[P] - [Q]` of the
two ends of a triple `(P, α, Q)` with `α : T P ≅ T Q`. -/
theorem exact_toSplitK0_splitK0Map [T.IsSummandDense] :
    Function.Exact (toSplitK0 T) (SplitK0.map.{w, w'} T) := by
  have : PreservesBinaryBiproducts T := preservesBinaryBiproducts_of_preservesBiproducts T
  -- `T` sends a zero object of `C` to a zero object of `D`.
  have : HasZeroObject D := (T.map_isZero (isZero_zero C)).hasZeroObject
  intro z
  refine ⟨fun hz => ?_, fun ⟨y, hy⟩ => hy ▸ splitK0Map_toSplitK0_eq_zero y⟩
  obtain ⟨P, Q, rfl⟩ := SplitK0.exists_eq_sub z
  rw [map_sub, SplitK0.map_of, SplitK0.map_of, sub_eq_zero,
    SplitK0.of_eq_of_iff_of_isSummandDense T] at hz
  obtain ⟨S, ⟨e⟩⟩ := hz
  refine ⟨of ⟨P ⊞ S, Q ⊞ S, T.mapBiprod P S ≪≫ e ≪≫ (T.mapBiprod Q S).symm⟩, ?_⟩
  rw [toSplitK0_of, SplitK0.of_biprod, SplitK0.of_biprod]
  abel

end RelativeK0

end TauCeti
