section TransIso

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasBinaryBiproducts C]
  {D : Type u'} [Category.{v'} D] [Preadditive D] {T : C ⥤ D} [T.Additive]

/-- **The composition isomorphism of triples.** For a full additive functor `T` and isomorphisms
`α : T P ≅ T Q`, `β : T Q ≅ T S`, the triples `(P, α, Q) ⊞ (Q, β, S)` and
`(P, β ∘ α, S) ⊞ (Q, id, Q)` are isomorphic. The component on `P ⊞ Q` is the identity, and the
component `Q ⊞ S ≅ S ⊞ Q` is Whitehead's isomorphism of preimages of `β` and `β⁻¹` under `T`,
whose image under `T` is the diagonal sum of `β` and `β⁻¹`. -/
noncomputable def tripleBiprodTransIso [T.Full] {P Q S : C} (α : T.obj P ≅ T.obj Q)
    (β : T.obj Q ≅ T.obj S) :
    tripleBiprod T ⟨P, Q, α⟩ ⟨Q, S, β⟩ ≅ tripleBiprod T ⟨P, S, α ≪≫ β⟩ ⟨Q, Q, Iso.refl _⟩ :=
  mkIso (Iso.refl _) (Biprod.whiteheadIso (T.preimage β.hom) (T.preimage β.inv)) (by
    have := preservesBinaryBiproducts_of_preservesBiproducts T
    dsimp only [tripleBiprod]
    refine Functor.map_biprod_hom_ext ?_ ?_ <;>
      simp only [Category.assoc, Iso.trans_hom, Iso.symm_hom, biprod.mapIso_hom, Iso.refl_hom,
        T.map_id, Category.id_comp, Functor.mapBiprod_hom, Functor.mapBiprod_inv_map_fst,
        Functor.mapBiprod_inv_map_snd, biprod.map_fst, biprod.map_snd, biprod.lift_fst_assoc,
        biprod.lift_snd_assoc, ← T.map_comp, Biprod.whiteheadIso_hom_fst,
        Biprod.whiteheadIso_hom_snd] <;>
      simp only [T.map_add, T.map_sub, T.map_comp, Functor.map_preimage, Iso.inv_hom_id,
        Iso.hom_inv_id, Category.comp_id, sub_self, Preadditive.comp_add, Preadditive.comp_sub,
        add_zero, zero_add, Functor.mapBiprod_inv_map_fst_assoc,
        Functor.mapBiprod_inv_map_snd_assoc, biprod.map_fst_assoc, biprod.map_snd_assoc,
        biprod.lift_fst_assoc, biprod.lift_snd])

@[simp]
lemma tripleBiprodTransIso_hom_fst [T.Full] {P Q S : C} (α : T.obj P ≅ T.obj Q)
    (β : T.obj Q ≅ T.obj S) : (tripleBiprodTransIso α β).hom.fst = 𝟙 (P ⊞ Q) := (rfl)

@[simp]
lemma tripleBiprodTransIso_hom_snd [T.Full] {P Q S : C} (α : T.obj P ≅ T.obj Q)
    (β : T.obj Q ≅ T.obj S) :
    (tripleBiprodTransIso α β).hom.snd =
      (Biprod.whiteheadIso (T.preimage β.hom) (T.preimage β.inv)).hom := (rfl)

@[simp]
lemma tripleBiprodTransIso_inv_fst [T.Full] {P Q S : C} (α : T.obj P ≅ T.obj Q)
    (β : T.obj Q ≅ T.obj S) : (tripleBiprodTransIso α β).inv.fst = 𝟙 (P ⊞ Q) := (rfl)

@[simp]
lemma tripleBiprodTransIso_inv_snd [T.Full] {P Q S : C} (α : T.obj P ≅ T.obj Q)
    (β : T.obj Q ≅ T.obj S) :
    (tripleBiprodTransIso α β).inv.snd =
      (Biprod.whiteheadIso (T.preimage β.hom) (T.preimage β.inv)).inv := (rfl)

end TransIso

section StablyIso

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [HasBinaryBiproducts C]
  {D : Type u'} [Category.{v'} D] [HasZeroMorphisms D]
  {T : C ⥤ D} [T.PreservesZeroMorphisms] [PreservesBiproductsOfShape WalkingPair T]

/-- Stable isomorphism of triples: `x ⊞ (S, id, S) ≅ y ⊞ (S', id, S')` for some `S` and `S'`. -/
private def StablyIso (x y : T ⊡ T) : Prop :=
  ∃ S S' : C,
    Nonempty (tripleBiprod T x ⟨S, S, Iso.refl _⟩ ≅ tripleBiprod T y ⟨S', S', Iso.refl _⟩)

/-- Adding `(S, id, S)` and then `(S', id, S')` is adding `(S ⊞ S', id, S ⊞ S')`. -/
private noncomputable def tripleBiprodReflAssoc (x : T ⊡ T) (S S' : C) :
    tripleBiprod T (tripleBiprod T x ⟨S, S, Iso.refl _⟩) ⟨S', S', Iso.refl _⟩ ≅
      tripleBiprod T x ⟨S ⊞ S', S ⊞ S', Iso.refl _⟩ :=
  tripleBiprodAssoc _ _ _ ≪≫ tripleBiprodMapIso (Iso.refl x) (tripleBiprodReflIso S S')

/-- Identity triples can be added in either order. -/
private noncomputable def tripleBiprodReflSwap (x : T ⊡ T) (S S' : C) :
    tripleBiprod T (tripleBiprod T x ⟨S, S, Iso.refl _⟩) ⟨S', S', Iso.refl _⟩ ≅
      tripleBiprod T (tripleBiprod T x ⟨S', S', Iso.refl _⟩) ⟨S, S, Iso.refl _⟩ :=
  tripleBiprodAssoc _ _ _ ≪≫ tripleBiprodMapIso (Iso.refl x) (tripleBiprodComm _ _) ≪≫
    (tripleBiprodAssoc _ _ _).symm

/-- The middle-four interchange `(a ⊞ b) ⊞ (c ⊞ d) ≅ (a ⊞ c) ⊞ (b ⊞ d)` of triples. -/
private noncomputable def tripleBiprodMiddleFour (a b c d : T ⊡ T) :
    tripleBiprod T (tripleBiprod T a b) (tripleBiprod T c d) ≅
      tripleBiprod T (tripleBiprod T a c) (tripleBiprod T b d) :=
  tripleBiprodAssoc _ _ _ ≪≫
    tripleBiprodMapIso (Iso.refl a) ((tripleBiprodAssoc _ _ _).symm ≪≫
      tripleBiprodMapIso (tripleBiprodComm b c) (Iso.refl d) ≪≫ tripleBiprodAssoc _ _ _) ≪≫
    (tripleBiprodAssoc _ _ _).symm

private lemma stablyIso_of_iso {x y : T ⊡ T} (e : x ≅ y) : StablyIso x y :=
  ⟨x.fst, x.fst, ⟨tripleBiprodMapIso e (Iso.refl _)⟩⟩

private lemma StablyIso.symm {x y : T ⊡ T} : StablyIso x y → StablyIso y x
  | ⟨S, S', ⟨e⟩⟩ => ⟨S', S, ⟨e.symm⟩⟩

private lemma StablyIso.trans {x y z : T ⊡ T} : StablyIso x y → StablyIso y z → StablyIso x z
  | ⟨S₁, S₁', ⟨e₁⟩⟩, ⟨S₂, S₂', ⟨e₂⟩⟩ =>
    ⟨S₁ ⊞ S₂, S₂' ⊞ S₁', ⟨(tripleBiprodReflAssoc x S₁ S₂).symm ≪≫
      tripleBiprodMapIso e₁ (Iso.refl _) ≪≫ tripleBiprodReflSwap y S₁' S₂ ≪≫
      tripleBiprodMapIso e₂ (Iso.refl _) ≪≫ tripleBiprodReflAssoc z S₂' S₁'⟩⟩

/-- Stable isomorphism is compatible with direct sums. -/
private lemma StablyIso.tripleBiprod {x x' y y' : T ⊡ T} :
    StablyIso x x' → StablyIso y y' → StablyIso (tripleBiprod T x y) (tripleBiprod T x' y')
  | ⟨S₁, S₁', ⟨e₁⟩⟩, ⟨S₂, S₂', ⟨e₂⟩⟩ =>
    ⟨S₁ ⊞ S₂, S₁' ⊞ S₂', ⟨tripleBiprodMapIso (Iso.refl _) (tripleBiprodReflIso S₁ S₂).symm ≪≫
      tripleBiprodMiddleFour _ _ _ _ ≪≫ tripleBiprodMapIso e₁ e₂ ≪≫
      tripleBiprodMiddleFour _ _ _ _ ≪≫
      tripleBiprodMapIso (Iso.refl _) (tripleBiprodReflIso S₁' S₂')⟩⟩

/-- Adding an identity triple does not change the stable isomorphism class. -/
private lemma stablyIso_tripleBiprod_refl (x : T ⊡ T) (S : C) :
    StablyIso (tripleBiprod T x ⟨S, S, Iso.refl _⟩) x :=
  ⟨S, S ⊞ S, ⟨tripleBiprodReflAssoc x S S⟩⟩

/-- Any two identity triples are stably isomorphic. -/
private lemma stablyIso_refl (S S' : C) :
    StablyIso (T := T) ⟨S, S, Iso.refl _⟩ ⟨S', S', Iso.refl _⟩ :=
  ⟨S', S, ⟨tripleBiprodComm _ _⟩⟩

variable (T) in
/-- Stable isomorphism as a setoid on triples. -/
private def stableSetoid : Setoid (T ⊡ T) where
  r := StablyIso
  iseqv := ⟨fun x ↦ stablyIso_of_iso (Iso.refl x), StablyIso.symm, StablyIso.trans⟩

variable (T) in
/-- The stable isomorphism classes of triples. -/
private def StableClass : Type _ := Quotient (stableSetoid T)

/-- The stable class of a triple. -/
private def StableClass.mk (x : T ⊡ T) : StableClass T := Quotient.mk (stableSetoid T) x

@[elab_as_elim]
private lemma StableClass.induction_on {motive : StableClass T → Prop} (a : StableClass T)
    (mk : ∀ x, motive (StableClass.mk x)) : motive a :=
  Quotient.inductionOn a mk

private lemma StableClass.mk_eq_mk_iff {x y : T ⊡ T} :
    StableClass.mk x = StableClass.mk y ↔ StablyIso x y :=
  Quotient.eq (r := stableSetoid T)

private lemma StableClass.mk_eq_mk_of_iso {x y : T ⊡ T} (e : x ≅ y) :
    StableClass.mk x = StableClass.mk y :=
  StableClass.mk_eq_mk_iff.2 (stablyIso_of_iso e)

private noncomputable instance : Add (StableClass T) :=
  ⟨Quotient.map₂ (tripleBiprod T) fun _ _ h₁ _ _ h₂ ↦ StablyIso.tripleBiprod h₁ h₂⟩

private lemma StableClass.mk_add_mk (x y : T ⊡ T) :
    StableClass.mk x + StableClass.mk y = StableClass.mk (tripleBiprod T x y) := rfl

private lemma StableClass.mk_tripleBiprod_refl (x : T ⊡ T) (S : C) :
    StableClass.mk (tripleBiprod T x ⟨S, S, Iso.refl _⟩) = StableClass.mk x :=
  StableClass.mk_eq_mk_iff.2 (stablyIso_tripleBiprod_refl x S)

private noncomputable instance [Nonempty C] : Zero (StableClass T) :=
  ⟨StableClass.mk ⟨Classical.arbitrary C, _, Iso.refl _⟩⟩

private lemma StableClass.mk_refl [Nonempty C] (S : C) :
    StableClass.mk (T := T) ⟨S, S, Iso.refl _⟩ = 0 :=
  StableClass.mk_eq_mk_iff.2 (stablyIso_refl _ _)

end StablyIso

section Criterion

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasBinaryBiproducts C]
  {D : Type u'} [Category.{v'} D] [Preadditive D] {T : C ⥤ D} [T.Additive] [T.Full]

/-- The composition relation holds for stable classes. -/
private lemma StableClass.mk_trans {P Q S : C} (α : T.obj P ≅ T.obj Q) (β : T.obj Q ≅ T.obj S) :
    StableClass.mk (T := T) ⟨P, S, α ≪≫ β⟩ =
      StableClass.mk ⟨P, Q, α⟩ + StableClass.mk ⟨Q, S, β⟩ := by
  rw [StableClass.mk_add_mk, StableClass.mk_eq_mk_of_iso (tripleBiprodTransIso α β),
    StableClass.mk_tripleBiprod_refl]

private lemma StableClass.exists_add_eq_zero [Nonempty C] (a : StableClass T) :
    ∃ b, b + a = 0 := by
  induction a using StableClass.induction_on with
  | mk x =>
    refine ⟨StableClass.mk ⟨x.snd, x.fst, x.iso.symm⟩, ?_⟩
    rw [← StableClass.mk_trans (T := T) (P := x.snd) (Q := x.fst) (S := x.snd), Iso.symm_self_id,
      StableClass.mk_refl]

private noncomputable instance [Nonempty C] : Neg (StableClass T) :=
  ⟨fun a ↦ (StableClass.exists_add_eq_zero a).choose⟩

private noncomputable instance [Nonempty C] : AddCommGroup (StableClass T) :=
  { AddGroup.ofLeftAxioms
      (fun a b c ↦ by
        induction a using StableClass.induction_on
        induction b using StableClass.induction_on
        induction c using StableClass.induction_on
        exact StableClass.mk_eq_mk_of_iso (tripleBiprodAssoc _ _ _))
      (fun a ↦ by
        induction a using StableClass.induction_on with
        | mk x =>
          exact (StableClass.mk_eq_mk_of_iso (tripleBiprodComm _ _)).trans
            (StableClass.mk_tripleBiprod_refl x _))
      (fun a ↦ (StableClass.exists_add_eq_zero a).choose_spec) with
    add_comm := fun a b ↦ by
      induction a using StableClass.induction_on
      induction b using StableClass.induction_on
      exact StableClass.mk_eq_mk_of_iso (tripleBiprodComm _ _) }

variable (T) in
/-- The stable class of a triple, as an additive invariant. -/
private noncomputable def stableClassInvariant [Nonempty C] :
    AdditiveInvariant T (StableClass T) where
  obj := StableClass.mk
  map_iso _ _ e := StableClass.mk_eq_mk_of_iso e
  map_tripleBiprod x y := (StableClass.mk_add_mk x y).symm
  map_trans α β := StableClass.mk_trans α β

variable [EssentiallySmall.{w} C] [LocallySmall.{w} D]

/-- **The equality criterion for the relative group of a full functor.** For a full additive
functor `T`, two triples `x` and `y` have the same class in `K₀(T)` iff they are stably
isomorphic: `x ⊞ (S, id, S) ≅ y ⊞ (S', id, S')` for some objects `S` and `S'` of `C`. -/
theorem of_eq_of_iff {x y : T ⊡ T} :
    (of x : RelativeK0.{w} T) = of y ↔ ∃ S S' : C,
      Nonempty (tripleBiprod T x ⟨S, S, Iso.refl _⟩ ≅ tripleBiprod T y ⟨S', S', Iso.refl _⟩) := by
  refine ⟨fun h ↦ ?_, fun ⟨S, S', ⟨e⟩⟩ ↦ ?_⟩
  · have : Nonempty C := ⟨x.fst⟩
    have h' := congrArg (lift (stableClassInvariant T)) h
    rw [lift_of, lift_of] at h'
    exact StableClass.mk_eq_mk_iff.1 h'
  · simpa using of_congr (T := T) e

/-- For a full additive functor `T`, a triple `x` has class zero in `K₀(T)` iff it is stably
isomorphic to an identity triple: `x ⊞ (S, id, S) ≅ (S', id, S')` for some objects `S` and `S'`
of `C`. -/
theorem of_eq_zero_iff {x : T ⊡ T} :
    (of x : RelativeK0.{w} T) = 0 ↔ ∃ S S' : C,
      Nonempty (tripleBiprod T x ⟨S, S, Iso.refl _⟩ ≅ ⟨S', S', Iso.refl _⟩) := by
  refine ⟨fun h ↦ ?_, fun ⟨S, S', ⟨e⟩⟩ ↦ by simpa using of_congr (T := T) e⟩
  rw [← of_refl (T := T) x.fst, of_eq_of_iff] at h
  obtain ⟨S, S', ⟨e⟩⟩ := h
  exact ⟨S, x.fst ⊞ S', ⟨e ≪≫ tripleBiprodReflIso _ _⟩⟩

end Criterion

end RelativeK0

end TauCeti
