module

public import TauCeti.Algebra.Homology.HomotopyCategory.Bounded.Functor
public import TauCeti.CategoryTheory.GrothendieckGroup.BoundedHomotopy.Basic
public import TauCeti.CategoryTheory.GrothendieckGroup.Graded

/-!
# The graded bounded-homotopy comparison

The comparison between split `K₀` of an additive category and triangulated `K₀` of its bounded
homotopy category is natural for additive functors. Consequently, an internal grading shift,
acting termwise on complexes, commutes with that comparison. Both the comparison and its inverse
intertwine the full integer action generated by the internal shift.

This internal shift is distinct from cohomological suspension: it applies the chosen
additive autoequivalence to each term without changing its cohomological degree.

## References

* Charles A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, Chapter II,
  Exercise 9.15, for the bounded-homotopy comparison.
-/

public section

namespace TauCeti.SplitK0

open CategoryTheory CategoryTheory.Limits

universe w w' v v' u u'

variable {C : Type u} {D : Type u'} [Category.{v} C] [Category.{v'} D]
  [Preadditive C] [Preadditive D] [HasBinaryBiproducts C] [HasBinaryBiproducts D]
  [HasZeroObject C] [HasZeroObject D] [EssentiallySmall.{w} C] [EssentiallySmall.{w'} D]

/-- The bounded-homotopy comparison is natural for every additive functor. -/
theorem boundedHomotopyEquiv_map (F : C ⥤ D) [F.Additive] (x : SplitK0 C) :
    boundedHomotopyEquiv D (map F x) =
      TriangulatedK0.map F.mapHomotopyCategoryBounded (boundedHomotopyEquiv C x) := by
  have h : (boundedHomotopyEquiv D).toAddMonoidHom.comp (map F) =
      (TriangulatedK0.map F.mapHomotopyCategoryBounded).comp
        (boundedHomotopyEquiv C).toAddMonoidHom := by
    apply hom_ext
    intro X
    simpa using (TriangulatedK0.of_congr
      ((F.mapHomotopyCategoryBoundedSingleFunctorIso 0).app X)).symm
  exact DFunLike.congr_fun h x

/-- Naturality also holds for the inverse comparison, which computes the alternating term class. -/
theorem boundedHomotopyEquiv_symm_map (F : C ⥤ D) [F.Additive]
    (x : TriangulatedK0 (HomotopyCategory.Bounded C)) :
    (boundedHomotopyEquiv D).symm (TriangulatedK0.map F.mapHomotopyCategoryBounded x) =
      map F ((boundedHomotopyEquiv C).symm x) := by
  apply (boundedHomotopyEquiv D).injective
  simp only [AddEquiv.apply_symm_apply, boundedHomotopyEquiv_map]

variable (e : C ≌ C) [e.functor.Additive]

/-- The bounded-homotopy comparison intertwines the generator of the internal grading action. -/
theorem boundedHomotopyEquiv_mapEquiv (x : SplitK0 C) :
    boundedHomotopyEquiv C (mapEquiv e x) =
      TriangulatedK0.mapEquiv e.mapHomotopyCategoryBounded (boundedHomotopyEquiv C x) := by
  have hs : (mapEquiv e).toAddMonoidHom = map e.functor :=
    (AddEquiv.toAddMonoidHom_eq_coe _).trans (mapEquiv_toAddMonoidHom e)
  have ht : (TriangulatedK0.mapEquiv e.mapHomotopyCategoryBounded).toAddMonoidHom =
      TriangulatedK0.map e.functor.mapHomotopyCategoryBounded := by
    rw [AddEquiv.toAddMonoidHom_eq_coe, TriangulatedK0.mapEquiv_toAddMonoidHom]
    -- Compare object classes to avoid transporting the data-valued `CommShift` instance.
    exact TriangulatedK0.map_congr e.mapHomotopyCategoryBounded.functor fun K ↦ ⟨eqToIso
      (congrArg (fun F ↦ F.obj K) (Equivalence.mapHomotopyCategoryBounded_functor e))⟩
  have h : (boundedHomotopyEquiv C).toAddMonoidHom.comp (mapEquiv e).toAddMonoidHom =
      (TriangulatedK0.mapEquiv e.mapHomotopyCategoryBounded).toAddMonoidHom.comp
        (boundedHomotopyEquiv C).toAddMonoidHom := by
    rw [hs, ht]
    apply AddMonoidHom.ext
    intro x
    exact boundedHomotopyEquiv_map e.functor x
  exact DFunLike.congr_fun h x

/-- The inverse grading shift also commutes with the bounded-homotopy comparison. -/
theorem boundedHomotopyEquiv_mapEquiv_symm (x : SplitK0 C) :
    boundedHomotopyEquiv C ((mapEquiv e).symm x) =
      (TriangulatedK0.mapEquiv e.mapHomotopyCategoryBounded).symm
        (boundedHomotopyEquiv C x) := by
  apply (TriangulatedK0.mapEquiv e.mapHomotopyCategoryBounded).injective
  rw [AddEquiv.apply_symm_apply, ← boundedHomotopyEquiv_mapEquiv,
    AddEquiv.apply_symm_apply]

/-- **The graded bounded-homotopy comparison:** the two `K₀` groups are isomorphic with their
entire integer actions of the internal grading shift. -/
theorem boundedHomotopyEquiv_shiftZPow (n : ℤ) (x : SplitK0 C) :
    boundedHomotopyEquiv C (shiftZPow e n x) =
      TriangulatedK0.shiftZPow e.mapHomotopyCategoryBounded n (boundedHomotopyEquiv C x) := by
  induction n using Int.induction_on with
  | zero => simp
  | succ n ih =>
    rw [shiftZPow_add_one_apply, boundedHomotopyEquiv_mapEquiv, ih,
      TriangulatedK0.shiftZPow_add_one_apply]
  | pred n ih =>
    rw [shiftZPow_sub_one_apply, boundedHomotopyEquiv_mapEquiv_symm, ih,
      TriangulatedK0.shiftZPow_sub_one_apply]

/-- The alternating-term-class inverse of the bounded-homotopy comparison intertwines every
integer internal shift. -/
theorem boundedHomotopyEquiv_symm_shiftZPow (n : ℤ)
    (x : TriangulatedK0 (HomotopyCategory.Bounded C)) :
    (boundedHomotopyEquiv C).symm (TriangulatedK0.shiftZPow e.mapHomotopyCategoryBounded n x) =
      shiftZPow e n ((boundedHomotopyEquiv C).symm x) := by
  apply (boundedHomotopyEquiv C).injective
  rw [AddEquiv.apply_symm_apply, boundedHomotopyEquiv_shiftZPow, AddEquiv.apply_symm_apply]

end TauCeti.SplitK0
