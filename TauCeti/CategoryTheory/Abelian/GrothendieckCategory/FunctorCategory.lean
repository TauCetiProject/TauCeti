module

public import Mathlib.CategoryTheory.Abelian.FunctorCategory
public import Mathlib.CategoryTheory.Abelian.GrothendieckAxioms.FunctorCategory
public import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.Basic
public import Mathlib.CategoryTheory.EssentiallySmall
public import Mathlib.CategoryTheory.Generator.Presheaf

/-!
# Functor categories into a Grothendieck abelian category

Let `A` be a Grothendieck abelian category relative to a universe `w`, and let `C` be a
`w`-essentially small category. Then the category of functors `C ⥤ A` is again a Grothendieck
abelian category relative to `w`. Colimits are computed objectwise, so filtered colimits are exact
because they are in `A`; and a separator is the coproduct, over the objects `c` of `C`, of the
functors `Hom(c, -) ⊗ G` freely generated by a separator `G` of `A`, which Mathlib provides for
presheaf categories (`CategoryTheory.Presheaf.hasSeparator`) and which transfers to covariant
functors through `Cᵒᵖᵒᵖ ≌ C`. For an essentially small `C` the statement is transported from a
small model of `C`.

In particular `HasExt.{w} (C ⥤ AddCommGrpCat.{w})` holds by
`CategoryTheory.IsGrothendieckAbelian.hasExt`, so Ext groups of functors from `C` to abelian
groups are `w`-small. For instance, if `C : Type 1` has `Category.{0} C`, as for a full subcategory
of `CommRingCat.{0}`, then Ext groups in `C ⥤ AddCommGrpCat.{1}` lie in `Type 1`.

## Main declarations

* `CategoryTheory.Functor.isGrothendieckAbelian`: the instance
  `IsGrothendieckAbelian.{w} (C ⥤ A)` for `EssentiallySmall.{w} C`.

## References

* A. Grothendieck, *Sur quelques points d'algèbre homologique*, Tôhoku Math. J. (2) 9 (1957),
  119–221, for Grothendieck abelian categories.
* [ShortProof]: `grh-lean`, https://github.com/lsernau/grh-lean, file
  `src/Lib/Cohomology/Etale/Basic.lean` (the anonymous instance
  `IsGrothendieckAbelian.{1} (AbFunctor C)` in section `Functoriality`, for functors from a small
  category to abelian groups); Apache 2.0, Copyright 2026 Anthropic, PBC. The instance here is
  adapted from it, for an arbitrary Grothendieck abelian target and an essentially small source.
-/

public section

universe w v' u' v u

namespace CategoryTheory.Functor

variable {A : Type u'} [Category.{v'} A] [Abelian A] [IsGrothendieckAbelian.{w} A]

/-- Functors from a small category into a Grothendieck abelian category form a Grothendieck
abelian category. -/
private lemma isGrothendieckAbelian_of_small (C : Type w) [SmallCategory C] :
    IsGrothendieckAbelian.{w} (C ⥤ A) :=
  { ab5OfSize := { ofShape := fun _ ↦ inferInstance }
    hasSeparator := .of_equivalence (opOpEquivalence C).congrLeft }

/-- Functors from a `w`-essentially small category into a Grothendieck abelian category, relative
to the universe `w`, form a Grothendieck abelian category relative to `w`. -/
instance isGrothendieckAbelian {C : Type u} [Category.{v} C] [EssentiallySmall.{w} C] :
    IsGrothendieckAbelian.{w} (C ⥤ A) :=
  have := isGrothendieckAbelian_of_small (SmallModel.{w} C) (A := A)
  IsGrothendieckAbelian.of_equivalence ((equivSmallModel.{w} C).congrLeft (E := A)).symm

end CategoryTheory.Functor
