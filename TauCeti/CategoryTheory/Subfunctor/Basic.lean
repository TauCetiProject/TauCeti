module

public import Mathlib.CategoryTheory.Subfunctor.Image
public import Mathlib.CategoryTheory.Yoneda

/-!
# The distributive lattice of subfunctors, restriction, and subfunctors generated by elements

The subfunctors of a functor `F : C ⥤ Type w` form a distributive lattice, since their suprema
and infima are computed objectwise as unions and intersections of sets.

A subfunctor `U` of `F` restricts along a functor `φ : C' ⥤ C` to the subfunctor
`CategoryTheory.Subfunctor.whiskerLeft φ U` of `φ ⋙ F`, with values `U(φ c')`.

A subfunctor `W` of a subfunctor `V` of `F` is a subfunctor `W.image V.ι` of `F`, whose elements
are those of `V` that lie in `W` (`CategoryTheory.Subfunctor.mem_image_ι_obj_iff`).

An element `x ∈ F(X)` generates the subfunctor `CategoryTheory.Subfunctor.ofElement x` of its
images `F(f)(x)`, the smallest subfunctor containing `x`. The universal element of a
corepresentable functor generates the whole functor
(`CategoryTheory.Subfunctor.ofElement_homEquiv_id`).

## References

* [ShortProof]: `grh-lean`, https://github.com/lsernau/grh-lean, file
  `src/Lib/Cohomology/Etale/Basic.lean` (declaration `CategoryTheory.Subfunctor.whisker`); Apache
  2.0, Copyright 2026 Anthropic, PBC. `CategoryTheory.Subfunctor.whiskerLeft` is adapted from it.
-/

public section

namespace CategoryTheory.Subfunctor

variable {C : Type*} [Category* C] {F : C ⥤ Type*}

/-- The subfunctors of a functor form a distributive lattice: suprema and infima are computed
objectwise as unions and intersections. -/
instance instDistribLattice : DistribLattice (Subfunctor F) :=
  DistribLattice.ofInfSupLe fun _ _ _ _ ↦ (inf_sup_left (α := Set _) _ _ _).le

/-- The restriction of a subfunctor `U` of `F` along `φ : C' ⥤ C`, as a subfunctor of `φ ⋙ F`. -/
def whiskerLeft {C' : Type*} [Category* C'] (φ : C' ⥤ C) (U : Subfunctor F) :
    Subfunctor (φ ⋙ F) where
  obj A := U.obj (φ.obj A)
  map f := U.map (φ.map f)

/-- The values of a restricted subfunctor are those of the original one. -/
@[simp]
lemma whiskerLeft_obj {C' : Type*} [Category* C'] (φ : C' ⥤ C) (U : Subfunctor F) (A : C') :
    (U.whiskerLeft φ).obj A = U.obj (φ.obj A) :=
  (rfl)

/-- An element lies in the restricted subfunctor exactly when it lies in the original one. -/
lemma mem_whiskerLeft_obj_iff {C' : Type*} [Category* C'] (φ : C' ⥤ C) (U : Subfunctor F)
    {A : C'} (x : F.obj (φ.obj A)) : x ∈ (U.whiskerLeft φ).obj A ↔ x ∈ U.obj (φ.obj A) :=
  Iff.rfl

/-- An element of `F` lies in the image of a subfunctor `W` of a subfunctor `V` exactly when it
lies in `V` and, as an element of `V`, in `W`. -/
lemma mem_image_ι_obj_iff {V : Subfunctor F} {W : Subfunctor V.toFunctor} {U : C} {y : F.obj U} :
    y ∈ (W.image V.ι).obj U ↔ ∃ h : y ∈ V.obj U, ⟨y, h⟩ ∈ W.obj U := by
  simp only [image_obj, Set.mem_image]
  exact ⟨by rintro ⟨w, hw, rfl⟩; exact ⟨w.property, hw⟩, fun ⟨h, hw⟩ ↦ ⟨_, hw, rfl⟩⟩

section ofElement

variable {X : C} (x : F.obj X)

/-- The subfunctor of `F : C ⥤ Type*` *generated by an element* `x ∈ F(X)`: its elements over `U`
are the images `F(f)(x)` of `x` along the morphisms `f : X ⟶ U`. For a presheaf, that is a functor
on an opposite category, this is Mathlib's `CategoryTheory.Subfunctor.ofSection`. -/
def ofElement : Subfunctor F where
  obj U := Set.range fun f : X ⟶ U ↦ F.map f x
  map g := by
    rintro _ ⟨f, rfl⟩
    exact ⟨f ≫ g, by simp⟩

/-- An element lies in the subfunctor generated by `x` exactly when it is an image of `x`. -/
@[simp]
lemma mem_ofElement_obj_iff {U : C} {y : F.obj U} :
    y ∈ (ofElement x).obj U ↔ ∃ f : X ⟶ U, F.map f x = y :=
  Iff.rfl

/-- The subfunctor generated by `x` contains `x`. -/
lemma mem_ofElement_obj : x ∈ (ofElement x).obj X :=
  ⟨𝟙 X, by simp⟩

/-- The subfunctor generated by `x` is the smallest subfunctor containing `x`. -/
@[simp]
lemma ofElement_le_iff (G : Subfunctor F) : ofElement x ≤ G ↔ x ∈ G.obj X :=
  ⟨fun h ↦ h X (mem_ofElement_obj x), by rintro hx U _ ⟨f, rfl⟩; exact G.map f hx⟩

/-- The universal element of a functor corepresented by `X` generates the whole functor. -/
@[simp]
lemma ofElement_homEquiv_id (e : F.CorepresentableBy X) : ofElement (e.homEquiv (𝟙 X)) = ⊤ :=
  top_le_iff.1 fun U y _ ↦ ⟨e.homEquiv.symm y, by
    simp only [← e.homEquiv_comp, Category.id_comp, Equiv.apply_symm_apply]⟩

end ofElement

end CategoryTheory.Subfunctor
