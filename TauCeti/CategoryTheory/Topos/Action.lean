module

public import Mathlib.CategoryTheory.Action.Limits
public import Mathlib.CategoryTheory.Limits.Types.Pullbacks
public import TauCeti.CategoryTheory.Action.Projective
public import TauCeti.CategoryTheory.EffectiveEpi.Action
public import TauCeti.CategoryTheory.Topos.LocallyWeaklyContractible

/-!
# The topos of `G`-sets is locally weakly contractible

For a group `G`, the category `Action (Type u) G` of `G`-sets is a topos in which covers are
jointly surjective families (`Action.effectiveEpiFamily_iff`). This file computes its finiteness
conditions and weakly contractible objects far enough to show that it is locally weakly
contractible.

Over any monoid `G`, a `G`-set is quasicompact exactly when it is generated by finitely many points
(`Action.isQuasicompact_iff`); for a group these are the `G`-sets with finitely many orbits. The
left regular `G`-set `G` is projective (`TauCeti.projective_leftRegular`), and for a group it is
also quasiseparated: `G` acts freely on itself, so a fibre product over it of `G`-sets with finitely
many orbits again has finitely many orbits, one for each pair of orbits of the factors. Every
`G`-set is covered by the orbit maps out of `G`, so `G`-sets form a locally weakly contractible
topos (`TauCeti.Topos.isLocallyWeaklyContractible_action`).

## References

* B. Bhatt and P. Scholze, *The pro-étale topology for schemes*, Example 3.2.2.
-/

public section

open CategoryTheory Limits

universe u

namespace TauCeti.Topos

section Monoid

variable {G : Type u} [Monoid G]

/-- A `G`-set is quasicompact if and only if it is finitely generated: there is a finite set of
points whose orbits cover it. For a group `G`, this says that it has finitely many orbits. -/
theorem _root_.Action.isQuasicompact_iff (A : Action (Type u) G) :
    IsQuasicompact A ↔ ∃ s : Finset (ToType A), ∀ x : ToType A, ∃ y ∈ s, ∃ g : G, g • y = x := by
  constructor
  · intro hA
    -- Cover `A` by the orbit maps of all of its points and extract a finite subcover.
    obtain ⟨s, hs⟩ := (TauCeti.Topos.isQuasicompact_iff A).1 hA
      (fun _ : ToType A ↦ Action.leftRegular G) Action.leftRegularHom
      ((Action.effectiveEpiFamily_iff _ _).2 fun x ↦ ⟨x, (1 : G), by simp⟩)
    refine ⟨s, fun x ↦ ?_⟩
    obtain ⟨⟨y, hy⟩, g, hg⟩ := (Action.effectiveEpiFamily_iff _ _).1 hs x
    exact ⟨y, hy, g, (Action.leftRegularHom_hom_apply y g).symm.trans hg⟩
  · rintro ⟨s, hs⟩
    rw [TauCeti.Topos.isQuasicompact_iff]
    intro ι Y π hπ
    -- Each point of `s` is hit by some member of the family; these finitely many members
    -- already cover `A`, since the image of a map of `G`-sets is `G`-stable.
    have hπ' := (Action.effectiveEpiFamily_iff Y π).1 hπ
    choose i z hz using hπ'
    classical
    refine ⟨s.image i, (Action.effectiveEpiFamily_iff _ _).2 fun x ↦ ?_⟩
    obtain ⟨y, hy, g, rfl⟩ := hs x
    refine ⟨⟨i y, Finset.mem_image_of_mem i hy⟩, (Y (i y)).ρ g (z y), ?_⟩
    rw [Action.hom_comm_apply, hz]
    rfl

/-- The left regular `G`-set is quasicompact, since it is generated by the single point `1`. -/
theorem isQuasicompact_leftRegular : IsQuasicompact (Action.leftRegular G) :=
  (Action.isQuasicompact_iff _).2
    ⟨({1} : Finset G), fun x ↦ ⟨(1 : G), Finset.mem_singleton_self _, x, mul_one (M := G) x⟩⟩

end Monoid

variable {G : Type u} [Group G]

/-- The left regular `G`-set is quasiseparated. A fibre product `W` of `Y` and `Z` over `G` has
an orbit for each pair of orbits of `Y` and `Z`: given orbit representatives `y₀` and `z₀`, the
point of `W` over `y₀` and `(f y₀ * (g z₀)⁻¹) • z₀` represents every point of `W` over the
orbits of `y₀` and `z₀`, because `G` acts freely on itself. -/
theorem isQuasiseparated_leftRegular : IsQuasiseparated (Action.leftRegular G) := by
  rw [isQuasiseparated_iff]
  intro Y Z W f g fst snd h hY hZ
  rw [Action.isQuasicompact_iff] at hY hZ ⊢
  obtain ⟨sY, hsY⟩ := hY
  obtain ⟨sZ, hsZ⟩ := hZ
  -- Read the values of `f` and `g` as elements of the group `G`.
  obtain ⟨u, hu⟩ : ∃ u : ToType Y → G, ∀ y, f.hom y = u y := ⟨fun y ↦ f.hom y, fun _ ↦ rfl⟩
  obtain ⟨v, hv⟩ : ∃ v : ToType Z → G, ∀ z, g.hom z = v z := ⟨fun z ↦ g.hom z, fun _ ↦ rfl⟩
  have hu' (c : G) (y : ToType Y) : u (c • y) = c * u y := by
    rw [← hu, ← hu]
    exact Action.hom_comm_apply f c y
  have hv' (c : G) (z : ToType Z) : v (c • z) = c * v z := by
    rw [← hv, ← hv]
    exact Action.hom_comm_apply g c z
  have hfg (x : ToType W) : u (fst.hom x) = v (snd.hom x) := by
    rw [← hu, ← hv]
    exact ConcreteCategory.congr_hom (congrArg Action.Hom.hom h.w) x
  have h' := h.map (Action.forget (Type u) G)
  -- The point of `W` over a pair of orbit representatives.
  have hw (y₀ : ToType Y) (z₀ : ToType Z) : ∃ w : ToType W, fst.hom w = y₀ ∧
      snd.hom w = Z.ρ (u y₀ * (v z₀)⁻¹) z₀ := by
    refine Types.exists_of_isPullback h' _ _ ?_
    -- The forgetful functor sends a map of `G`-sets to its underlying function.
    change f.hom y₀ = g.hom (Z.ρ (u y₀ * (v z₀)⁻¹) z₀)
    rw [Action.hom_comm_apply, hu, hv, Action.ofMulAction_apply, smul_eq_mul,
      inv_mul_cancel_right]
  choose w hw₁ hw₂ using hw
  classical
  refine ⟨(sY ×ˢ sZ).image fun p ↦ w p.1 p.2, fun x ↦ ?_⟩
  obtain ⟨y₀, hy₀, a, hy⟩ := hsY (fst.hom x)
  obtain ⟨z₀, hz₀, b, hz⟩ := hsZ (snd.hom x)
  refine ⟨w y₀ z₀, Finset.mem_image_of_mem _ (Finset.mk_mem_product hy₀ hz₀), a, ?_⟩
  -- Since `G` acts freely on itself, `b = a * u y₀ * (v z₀)⁻¹`, so the two points of `W` have the
  -- same projections.
  have hb : b = a * u y₀ * (v z₀)⁻¹ := by
    have := hfg x
    rw [← hy, ← hz, hu', hv'] at this
    rw [this, mul_inv_cancel_right]
  -- The forgetful functor sends a map of `G`-sets to its underlying function, and `a • x` is
  -- `W.ρ a x`.
  refine Types.ext_of_isPullback h' ?_ ?_
  · change fst.hom (W.ρ a (w y₀ z₀)) = fst.hom x
    rw [Action.hom_comm_apply, hw₁]
    exact hy
  · change snd.hom (W.ρ a (w y₀ z₀)) = snd.hom x
    rw [Action.hom_comm_apply, hw₂, ← hz, hb, mul_assoc]
    exact (mul_smul a _ z₀).symm

/-- The topos of `G`-sets is locally weakly contractible: every `G`-set is covered by the orbit
maps of its points, out of the left regular `G`-set, which is quasicompact, quasiseparated and
projective. -/
instance isLocallyWeaklyContractible_action :
    IsLocallyWeaklyContractible (Action (Type u) G) where
  exists_effectiveEpiFamily A :=
    ⟨ToType A, fun _ ↦ Action.leftRegular G, Action.leftRegularHom,
      (Action.effectiveEpiFamily_iff _ _).2 fun x ↦ ⟨x, (1 : G), by simp⟩,
      fun _ ↦ ⟨isQuasicompact_leftRegular, isQuasiseparated_leftRegular, inferInstance⟩⟩

end TauCeti.Topos
