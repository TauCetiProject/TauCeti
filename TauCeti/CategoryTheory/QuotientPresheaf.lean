module

public import Mathlib.CategoryTheory.Limits.FunctorCategory.Basic
public import Mathlib.CategoryTheory.Limits.Types.Pullbacks
public import Mathlib.Logic.Function.Coequalizer
public import TauCeti.CategoryTheory.EquivalenceRelation

/-!
# The presheaf quotient of a pre-relation

Let `s t : R ⟶ U` be a pair of morphisms in a category `C`, a *pre-relation* on `U`: a `T`-point
`r` of `R` relates `t r` to `s r`. The *presheaf quotient* is the presheaf `T ↦ U(T)/R(T)`, the
quotient of `U(T)` by the equivalence relation generated by the image of `R(T)`, that is, the
coequaliser of `h_R ⇉ h_U` in presheaves of types (Stacks, Definition 39.20.1 (02VG), before
sheafification). This file constructs it with its projection `π : h_U ⟶ U/R`, the factorisation
of `R`-invariant maps out of the universe-lifted `h_U`, and shows that `R` is the kernel pair of
`π` when `(t, s)` is an equivalence relation.

## Main definitions

* `TauCeti.CategoryTheory.quotientPresheaf s t`: the presheaf `T ↦ U(T)/R(T)`.
* `TauCeti.CategoryTheory.quotientPresheaf.π s t`: the projection `h_U ⟶ U/R`.
* `TauCeti.CategoryTheory.quotientPresheaf.uliftπ s t`: the projection from the universe-lifted
  `h_U` onto the universe-lifted presheaf quotient.
* `TauCeti.CategoryTheory.quotientPresheaf.uliftDesc`: the factorisation of an `R`-invariant map
  out of the universe-lifted `h_U` through the universe-lifted presheaf quotient.

## Main results

* `TauCeti.CategoryTheory.quotientPresheaf.π_app_eq_iff`: for an equivalence relation, two
  `T`-points of `U` have the same class exactly when they are related by a `T`-point of `R`.
* `TauCeti.CategoryTheory.quotientPresheaf.isKernelPair_uliftπ`: for an equivalence relation
  `(t, s)`, the universe-lifted `h_R ⇉ h_U` is the kernel pair of `uliftπ`.

## References

* [Stacks Project, Definition 39.20.1](https://stacks.math.columbia.edu/tag/02VG)
-/

public section

open CategoryTheory Limits Opposite

namespace TauCeti.CategoryTheory

universe w v u

variable {C : Type u} [Category.{v} C] {R U : C} (s t : R ⟶ U)

/-- The presheaf quotient `T ↦ U(T)/R(T)` of a pre-relation `s t : R ⟶ U`: the quotient of the
`T`-points of `U` by the equivalence relation generated by `t r ~ s r` for `T`-points `r` of `R`
(Stacks, Definition 39.20.1 (02VG), before sheafification). -/
@[expose] noncomputable def quotientPresheaf : Cᵒᵖ ⥤ Type v where
  obj T := Function.Coequalizer (fun r : unop T ⟶ R ↦ r ≫ t) (fun r ↦ r ≫ s)
  map f := TypeCat.ofHom <| Quot.map (fun a ↦ f.unop ≫ a) <| by
    rintro _ _ ⟨r⟩
    rw [← Category.assoc, ← Category.assoc]
    exact .intro _
  map_id _ := by
    ext x
    induction x using Quot.ind
    exact congrArg (Quot.mk _) (Category.id_comp _)
  map_comp _ _ := by
    ext x
    induction x using Quot.ind
    exact congrArg (Quot.mk _) (Category.assoc _ _ _)

/-- The projection `h_U ⟶ U/R` of presheaves, sending a `T`-point of `U` to its class. -/
noncomputable def quotientPresheaf.π : yoneda.obj U ⟶ quotientPresheaf s t where
  app _ := TypeCat.ofHom (Function.Coequalizer.mk _ _)
  naturality _ _ _ := rfl

/-- The projection onto the presheaf quotient sends a `T`-point of `U` to its class. -/
@[simp]
theorem quotientPresheaf.π_app (T : Cᵒᵖ) (a : unop T ⟶ U) :
    (quotientPresheaf.π s t).app T a =
      Function.Coequalizer.mk (fun r : unop T ⟶ R ↦ r ≫ t) (fun r ↦ r ≫ s) a :=
  (rfl)

variable {s t}

/-- When the relation `t r ~ s r` on `T`-points of `U` is an equivalence relation (for instance
when `(t, s)` is an equivalence relation, by `EquivalenceRelation.equivalence_ofPairHom`), two
`T`-points of `U` have the same class in the presheaf quotient exactly when they are `t r` and
`s r` for a `T`-point `r` of `R`. -/
theorem quotientPresheaf.π_app_eq_iff {T : Cᵒᵖ}
    (h : _root_.Equivalence (Rel.ofPairHom t s (unop T))) (a b : unop T ⟶ U) :
    (quotientPresheaf.π s t).app T a = (quotientPresheaf.π s t).app T b ↔
      ∃ r : unop T ⟶ R, r ≫ t = a ∧ r ≫ s = b := by
  have e : Function.Coequalizer.Rel (fun r : unop T ⟶ R ↦ r ≫ t) (fun r ↦ r ≫ s) =
      Rel.ofPairHom t s (unop T) := by
    ext a b
    rw [Rel.ofPairHom_iff]
    exact ⟨fun ⟨r⟩ ↦ ⟨r, rfl, rfl⟩, fun ⟨r, ha, hb⟩ ↦ ha ▸ hb ▸ .intro r⟩
  refine Quot.eq.trans ?_
  rw [e, h.eqvGen_iff, Rel.ofPairHom_iff]

variable (s t)

/-- The projection from the universe-lifted `h_U` onto the universe-lifted presheaf quotient. -/
noncomputable def quotientPresheaf.uliftπ :
    uliftYoneda.{w}.obj U ⟶ quotientPresheaf s t ⋙ uliftFunctor.{w} where
  app T := TypeCat.ofHom fun a ↦ ULift.up ((quotientPresheaf.π s t).app T a.down)
  naturality _ _ _ := rfl

/-- The projection onto the universe-lifted presheaf quotient sends a lifted `T`-point of `U` to
its lifted class. -/
@[simp]
theorem quotientPresheaf.uliftπ_app (T : Cᵒᵖ) (a : ULift.{w} (unop T ⟶ U)) :
    ConcreteCategory.hom (X := ULift.{w} (unop T ⟶ U))
      (Y := ULift.{w} ((quotientPresheaf s t).obj T)) ((quotientPresheaf.uliftπ.{w} s t).app T) a =
      ULift.up ((quotientPresheaf.π s t).app T a.down) :=
  (rfl)

/-- The projection onto the universe-lifted presheaf quotient coequalises `h_R ⇉ h_U`. -/
theorem quotientPresheaf.uliftπ_condition :
    uliftYoneda.{w}.map t ≫ quotientPresheaf.uliftπ s t =
      uliftYoneda.{w}.map s ≫ quotientPresheaf.uliftπ s t := by
  ext T ⟨r⟩
  exact congrArg ULift.up (Function.Coequalizer.condition _ _ r)

variable {s t}

/-- The factorisation through the universe-lifted presheaf quotient of a natural transformation
out of the universe-lifted `h_U` which agrees on `t r` and `s r` for every point `r` of `R`. -/
noncomputable def quotientPresheaf.uliftDesc {P : Cᵒᵖ ⥤ Type (max v w)}
    (φ : uliftYoneda.{w}.obj U ⟶ P)
    (hφ : uliftYoneda.{w}.map t ≫ φ = uliftYoneda.{w}.map s ≫ φ) :
    quotientPresheaf s t ⋙ uliftFunctor.{w} ⟶ P where
  app T := TypeCat.ofHom fun x ↦
    Function.Coequalizer.desc (fun r : unop T ⟶ R ↦ r ≫ t) (fun r ↦ r ≫ s)
    (fun a ↦ φ.app T (ULift.up a))
    (funext fun r ↦ ConcreteCategory.congr_hom (NatTrans.congr_app hφ T)
      (ULift.up r : ULift.{w} (unop T ⟶ R))) x.down
  naturality T T' f := by
    ext ⟨x⟩
    induction x using Quot.ind
    exact ConcreteCategory.congr_hom (φ.naturality f) _

/-- The component of `quotientPresheaf.uliftDesc φ hφ` at `T` descends `φ.app T` along the
pointwise coequaliser. -/
@[simp]
theorem quotientPresheaf.uliftDesc_app_apply {P : Cᵒᵖ ⥤ Type (max v w)}
    (φ : uliftYoneda.{w}.obj U ⟶ P)
    (hφ : uliftYoneda.{w}.map t ≫ φ = uliftYoneda.{w}.map s ≫ φ) (T : Cᵒᵖ)
    (a : unop T ⟶ U) :
    ConcreteCategory.hom (X := ULift.{w} ((quotientPresheaf s t).obj T)) (Y := P.obj T)
      ((quotientPresheaf.uliftDesc φ hφ).app T) (ULift.up ((quotientPresheaf.π s t).app T a)) =
      φ.app T (ULift.up a) :=
  (rfl)

/-- The factorisation through the universe-lifted presheaf quotient, composed with the
projection, is the original natural transformation. -/
@[reassoc (attr := simp)]
theorem quotientPresheaf.uliftπ_uliftDesc {P : Cᵒᵖ ⥤ Type (max v w)}
    (φ : uliftYoneda.{w}.obj U ⟶ P)
    (hφ : uliftYoneda.{w}.map t ≫ φ = uliftYoneda.{w}.map s ≫ φ) :
    quotientPresheaf.uliftπ s t ≫ quotientPresheaf.uliftDesc φ hφ = φ :=
  (rfl)

variable (s t) in
/-- Morphisms out of the universe-lifted presheaf quotient agree when they agree after the
projection. -/
theorem quotientPresheaf.uliftπ_hom_ext {P : Cᵒᵖ ⥤ Type (max v w)}
    {f g : quotientPresheaf s t ⋙ uliftFunctor.{w} ⟶ P}
    (hfg : quotientPresheaf.uliftπ s t ≫ f = quotientPresheaf.uliftπ s t ≫ g) : f = g := by
  ext T ⟨x⟩
  induction x using Quot.ind
  exact ConcreteCategory.congr_hom (NatTrans.congr_app hfg T) _

/-- For an equivalence relation `(t, s)`, the universe-lifted `h_R ⇉ h_U` is the kernel pair of
the projection onto the universe-lifted presheaf quotient. -/
theorem quotientPresheaf.isKernelPair_uliftπ (h : IsEquivalenceRelation t s) :
    IsKernelPair (quotientPresheaf.uliftπ.{w} s t) (uliftYoneda.{w}.map t)
      (uliftYoneda.{w}.map s) := by
  have w := quotientPresheaf.uliftπ_condition.{w} s t
  refine ⟨⟨w⟩, ⟨evaluationJointlyReflectsLimits _ fun T ↦
    (isLimitMapConePullbackConeEquiv _ w).symm ?_⟩⟩
  refine IsPullback.isLimit ((Types.isPullback_iff _ _ _ _).2 ⟨?_, ?_, ?_⟩)
  · exact NatTrans.congr_app w T
  · rintro ⟨r⟩ ⟨r'⟩ ⟨ht, hs⟩
    exact congrArg ULift.up (h.hom_ext (congrArg ULift.down ht) (congrArg ULift.down hs))
  · rintro ⟨a⟩ ⟨b⟩ hab
    obtain ⟨r, ht, hs⟩ := (quotientPresheaf.π_app_eq_iff (h.equivalence_ofPairHom _) a b).1
      (congrArg ULift.down hab)
    exact ⟨ULift.up r, congrArg ULift.up ht, congrArg ULift.up hs⟩

end TauCeti.CategoryTheory
