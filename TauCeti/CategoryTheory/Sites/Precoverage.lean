module

public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic
public import Mathlib.CategoryTheory.Sites.Hypercover.Zero
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck

/-!
# Precoverages

* The join of two precoverages stable under base change is stable under base change.
* `CategoryTheory.Precoverage.exists_ofArrows_le_of_mem_toGrothendieck`: if `K` is a `w`-small
  precoverage (Mathlib's `Precoverage.Small`) on a category with pullbacks, every covering sieve of
  the Grothendieck topology generated by `K` contains a covering sieve generated by a family
  indexed by a type in `Type w`.
-/

public section

universe w

namespace CategoryTheory.Precoverage

variable {C : Type*} [Category* C]

instance (J K : Precoverage C) [J.IsStableUnderBaseChange] [K.IsStableUnderBaseChange] :
    (J ⊔ K).IsStableUnderBaseChange where
  mem_coverings_of_isPullback {ι} S X f hf Y g P p₁ p₂ h := by
    rcases hf with hf | hf
    · exact Or.inl (mem_coverings_of_isPullback f hf g p₁ p₂ h)
    · exact Or.inr (mem_coverings_of_isPullback f hf g p₁ p₂ h)

/-- If `K` is a `w`-small precoverage on a category with pullbacks, every covering sieve of the
Grothendieck topology generated by `K` contains a covering sieve generated by a family indexed by a
type in `Type w`. -/
theorem exists_ofArrows_le_of_mem_toGrothendieck [Limits.HasPullbacks C] (K : Precoverage C)
    [Small.{w} K] {X : C} {R : Sieve X} (hR : R ∈ K.toGrothendieck X) :
    ∃ (ι : Type w) (Y : ι → C) (f : ∀ i, Y i ⟶ X),
      Sieve.ofArrows Y f ∈ K.toGrothendieck X ∧ Sieve.ofArrows Y f ≤ R := by
  rw [mem_toGrothendieck_iff] at hR
  induction hR with
  | of X R hR =>
    obtain ⟨E, rfl⟩ := mem_iff_exists_zeroHypercover.1 hR
    obtain ⟨ι, g, hg⟩ : ∃ (ι : Type w) (g : ι → E.I₀), (E.restrictIndex g).presieve₀ ∈ K X :=
      ZeroHypercover.Small.exists_restrictIndex_mem E
    exact ⟨ι, fun i ↦ E.X (g i), fun i ↦ E.f (g i), generate_mem_toGrothendieck hg,
      Sieve.generate_mono (PreZeroHypercover.presieve₀_restrictIndex_le _ g)⟩
  | top X =>
    refine ⟨PUnit, fun _ ↦ X, fun _ ↦ 𝟙 X, ?_, le_top⟩
    simpa only [Sieve.ofArrows, Presieve.ofArrows_pUnit,
      Sieve.generate_of_singleton_isSplitEpi] using K.toGrothendieck.top_mem X
  | pullback X R _ Y g ih =>
    obtain ⟨ι, Z, f, hf, hle⟩ := ih
    refine ⟨ι, fun i ↦ Limits.pullback (f i) g, fun i ↦ Limits.pullback.snd _ _, ?_,
      ?_⟩
    · rw [Sieve.ofArrows_eq_pullback_of_isPullback f
        (fun i ↦ (IsPullback.of_hasPullback (f i) g).flip)]
      exact K.toGrothendieck.pullback_stable g hf
    · rw [Sieve.ofArrows_eq_pullback_of_isPullback f
        (fun i ↦ (IsPullback.of_hasPullback (f i) g).flip)]
      exact Sieve.pullback_monotone g hle
  | transitive X R S _ _ ihR ihS =>
    obtain ⟨ι, Y, f, hf, hle⟩ := ihR
    choose σ Z g hg hle' using fun i ↦ ihS (hle _ (Sieve.ofArrows_mk _ _ i))
    refine ⟨Σ i, σ i, fun p ↦ Z p.1 p.2, fun p ↦ g p.1 p.2 ≫ f p.1, ?_, ?_⟩
    · rw [Sieve.ofArrows, ← Presieve.bindOfArrows_ofArrows]
      exact K.toGrothendieck.bindOfArrows hf hg
    · rintro W _ ⟨T, a, _, ⟨p⟩, rfl⟩
      exact S.downward_closed (hle' p.1 _ (Sieve.ofArrows_mk _ _ p.2)) a

end CategoryTheory.Precoverage
