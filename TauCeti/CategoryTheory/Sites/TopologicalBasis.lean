/-!
# The coverage a topological basis induces on `Opens X`

A basis `B` of open sets induces a coverage on `Opens X`: a presieve covers `U` when all of its
members lie in `B` and they cover `U` pointwise. `basisCoverage_toGrothendieck` identifies the
Grothendieck topology it generates as `Opens.grothendieckTopology X`, the one the topology of `X`
already defines, and `isSheaf_iff_isSheafFor_basisCoverage` reads off the consequence: a presheaf
is a sheaf exactly when it satisfies the sheaf condition for covers by basis elements alone.

Mathlib names this construction as an open project in the module docstring of
`Mathlib/CategoryTheory/Sites/Coverage.lean`:

> A more concrete example: If `ℬ` is a basis for a topology on a type `X` (in the sense of
> `TopologicalSpace.IsTopologicalBasis`) then it naturally induces a coverage on `Opens X` whose
> associated Grothendieck topology is the one induced by the topology on `X` generated by `ℬ`.
> (Project: Formalize this!)

## Main definitions

* `TauCeti.TopologicalSpace.Opens.basisCoverage` : the coverage on `Opens X` attached to a basis.

## Main results

* `TauCeti.TopologicalSpace.Opens.isBasisCover_iff`, with `IsBasisCover.mem_basis` and
  `IsBasisCover.exists_mem` : the two clauses of a basis cover, for consumers that cannot
  unfold the definition.
* `TauCeti.TopologicalSpace.Opens.basisCoverage_toGrothendieck` : it generates
  `Opens.grothendieckTopology X`.
* `TauCeti.TopologicalSpace.Opens.isSheaf_iff_isSheafFor_basisCoverage` : a `Type`-valued
  presheaf is a sheaf for the space exactly when it is a sheaf for every basis cover.
* `TauCeti.TopologicalSpace.Opens.isSheaf_iff_isSheafFor_basisCoverage_comp` : the same
  criterion for a presheaf valued in an arbitrary category, which is the form
  `TopCat.Presheaf.IsSheaf` is stated in.
* `TauCeti.TopologicalSpace.Opens.coverDense_inducedFunctor_subtypeVal` : the inclusion of a
  basis into `Opens X` is cover-dense, Mathlib's `TopCat.Opens.coverDense_inducedFunctor` for a
  basis given as a set of opens.
* `TauCeti.TopologicalSpace.Opens.sieve_ofArrows_mem_grothendieckTopology` : the sieve generated
  by an open cover `U i ≤ W` with `W ≤ ⨆ i, U i` belongs to `Opens.grothendieckTopology X W`.
* `TauCeti.TopologicalSpace.Opens.isSheafFor_ofArrows_of_finite` : for a meet-closed family of
  compact opens, finite covers decide the sheaf condition for arbitrary covers.
* `TauCeti.TopologicalSpace.Opens.isSheaf_restrictedTopology_of_isSheafFor_ofArrows` : for a
  meet-closed family of opens, gluing along covers within the family gives the sheaf condition for
  the restricted topology.

## Why a coverage and not a pretopology

A pretopology asks its covering families to be stable under pullback on the nose, and basis covers
are not: intersecting two basis elements need not give a basis element. A coverage asks only that
some covering family of the smaller object *factors through* the given one, which a basis supplies
by shrinking each intersection to a basis neighbourhood of each of its points. That is exactly the
weakening `CategoryTheory.Coverage` exists for.
-/

namespace TauCeti

open CategoryTheory _root_.TopologicalSpace

public section

universe u w u₁ u₂

namespace TopologicalSpace.Opens

variable {X : Type u} [TopologicalSpace X] {B : Set (Opens X)}

/-- The presieves of a basis cover: every member lies in `B`, and together they cover `U`
pointwise. -/
def IsBasisCover (B : Set (Opens X)) {U : Opens X} (R : Presieve U) : Prop :=
  (∀ ⦃V : Opens X⦄ ⦃f : V ⟶ U⦄, R f → V ∈ B) ∧
    ∀ x ∈ U, ∃ (V : Opens X) (f : V ⟶ U), R f ∧ x ∈ V

/-- **The two clauses of a basis cover.** `IsBasisCover` is a definition and its body is not
exposed, so this is how a consumer outside this module builds one or takes it apart. -/
theorem isBasisCover_iff {U : Opens X} {R : Presieve U} :
    IsBasisCover B R ↔
      (∀ ⦃V : Opens X⦄ ⦃f : V ⟶ U⦄, R f → V ∈ B) ∧
        ∀ x ∈ U, ∃ (V : Opens X) (f : V ⟶ U), R f ∧ x ∈ V := Iff.rfl

/-- Every member of a basis cover lies in the basis. -/
theorem IsBasisCover.mem_basis {U : Opens X} {R : Presieve U} (hR : IsBasisCover B R)
    ⦃V : Opens X⦄ ⦃f : V ⟶ U⦄ (hf : R f) : V ∈ B := hR.1 hf

/-- A basis cover covers its object pointwise. -/
theorem IsBasisCover.exists_mem {U : Opens X} {R : Presieve U} (hR : IsBasisCover B R) {x : X}
    (hx : x ∈ U) : ∃ (V : Opens X) (f : V ⟶ U), R f ∧ x ∈ V := hR.2 x hx

/-- **The coverage a basis induces on `Opens X`.** Its covering presieves are the basis covers.

The pullback condition is where the basis property is used: the intersection of a basis element
with a smaller open need not be a basis element, so the covering family of the smaller open is
obtained by shrinking to a basis neighbourhood inside each intersection. -/
def basisCoverage (hB : Opens.IsBasis B) : Coverage (Opens X) where
  coverings U := {R | IsBasisCover B R}
  pullback := by
    rintro U V f R ⟨_, hcov⟩
    refine ⟨fun W _ ↦ W ∈ B ∧ ∃ (W' : Opens X) (e : W' ⟶ U), R e ∧ W ≤ W',
      ⟨fun _ _ h ↦ h.1, fun x hx ↦ ?_⟩, ?_⟩
    · obtain ⟨W', e, he, hxW'⟩ := hcov x (f.le hx)
      obtain ⟨W, hWB, hxW, hWle⟩ := Opens.isBasis_iff_nbhd.mp hB (U := W' ⊓ V) ⟨hxW', hx⟩
      exact ⟨W, homOfLE (hWle.trans inf_le_right), ⟨hWB, W', e, he, hWle.trans inf_le_left⟩, hxW⟩
    · rintro W g ⟨-, W', e, he, hWle⟩
      exact ⟨W', homOfLE hWle, e, he, Subsingleton.elim _ _⟩

/-- Membership in the basis coverage is being a basis cover; this is the normal form. -/
@[simp]
theorem mem_basisCoverage (hB : Opens.IsBasis B) {U : Opens X} {R : Presieve U} :
    R ∈ basisCoverage hB U ↔ IsBasisCover B R := Iff.rfl

/-- **The basis coverage generates the topology of the space.** Every basis cover is a cover in
`Opens.grothendieckTopology X`, and conversely every covering sieve contains the basis cover made
of the basis elements it already contains. -/
theorem basisCoverage_toGrothendieck (hB : Opens.IsBasis B) :
    (basisCoverage hB).toGrothendieck = Opens.grothendieckTopology X := by
  refine le_antisymm ?_ fun U S hS ↦ ?_
  · -- the generated topology is the smallest one containing the basis covers
    rw [(Coverage.gi (Opens X)).gc]
    rintro U R ⟨_, hcov⟩ x hx
    obtain ⟨V, f, hf, hxV⟩ := hcov x hx
    exact ⟨V, f, ⟨V, 𝟙 V, f, hf, Category.id_comp f⟩, hxV⟩
  · -- conversely, shrink each member of a covering sieve to basis elements
    refine Coverage.mem_toGrothendieck_sieves_of_superset _ (R := fun V _ ↦ V ∈ B ∧ S _)
      (fun _ _ h ↦ h.2) ⟨fun _ _ h ↦ h.1, fun x hx ↦ ?_⟩
    obtain ⟨W, e, he, hxW⟩ := hS x hx
    obtain ⟨V, hVB, hxV, hVle⟩ := Opens.isBasis_iff_nbhd.mp hB (U := W) hxW
    exact ⟨V, homOfLE (hVle.trans e.le), ⟨hVB, S.downward_closed he (homOfLE hVle)⟩, hxV⟩

/-- **The basis sheaf criterion.** A presheaf on `X` is a sheaf exactly when it satisfies the sheaf
condition for covers by basis elements. This is the criterion the structure presheaf of an adic
space is checked against, where the basis is the rational subsets. -/
theorem isSheaf_iff_isSheafFor_basisCoverage (hB : Opens.IsBasis B)
    (P : (Opens X)ᵒᵖ ⥤ Type*) :
    Presieve.IsSheaf (Opens.grothendieckTopology X) P ↔
      ∀ ⦃U : Opens X⦄ (R : Presieve U), IsBasisCover B R → Presieve.IsSheafFor P R := by
  rw [← basisCoverage_toGrothendieck hB, Presieve.isSheaf_coverage]
  simp only [mem_basisCoverage]

/-- **The basis sheaf criterion in an arbitrary target category.** `Presheaf.IsSheaf` is by
definition the `Type`-valued condition on `P ⋙ coyoneda.obj (op E)` for every object `E`, so the
criterion transfers objectwise.

This is the form the structure presheaf of an adic space is checked in: `TopCat.Presheaf.IsSheaf F`
unfolds to `Presheaf.IsSheaf (Opens.grothendieckTopology X) F`, and its target category is
`CompleteSeparatedTopCommRingCat`. -/
theorem isSheaf_iff_isSheafFor_basisCoverage_comp (hB : Opens.IsBasis B) {C : Type*} [Category C]
    (P : (Opens X)ᵒᵖ ⥤ C) :
    Presheaf.IsSheaf (Opens.grothendieckTopology X) P ↔
      ∀ (E : C) ⦃U : Opens X⦄ (R : Presieve U), IsBasisCover B R →
        Presieve.IsSheafFor (P ⋙ coyoneda.obj (Opposite.op E)) R :=
  forall_congr' fun _ ↦ isSheaf_iff_isSheafFor_basisCoverage hB _

/-- The inclusion of a basis `B`, given as a set of opens, into `Opens X` is cover-dense for the
Grothendieck topology of `X`: every open is covered by the members of `B` it contains. This is
Mathlib's `TopCat.Opens.coverDense_inducedFunctor` for a `Set`-indexed basis. -/
theorem coverDense_inducedFunctor_subtypeVal (hB : Opens.IsBasis B) :
    (inducedFunctor (Subtype.val : B → Opens X)).IsCoverDense (Opens.grothendieckTopology X) :=
  TopCat.Opens.coverDense_inducedFunctor (X := TopCat.of X) (Subtype.range_val ▸ hB)

/-- The sieve generated by a family of opens `U i ≤ W` covering `W` belongs to the Grothendieck
topology on `Opens X`. -/
theorem sieve_ofArrows_mem_grothendieckTopology {W : Opens X} {ι : Type*} {U : ι → Opens X}
    (hUW : ∀ i, U i ≤ W) (hcov : W ≤ ⨆ i, U i) :
    Sieve.ofArrows U (fun i ↦ homOfLE (hUW i)) ∈ Opens.grothendieckTopology X W := by
  rw [_root_.Opens.mem_grothendieckTopology]
  intro x hx
  obtain ⟨i, hxi⟩ := Opens.mem_iSup.mp (hcov hx)
  exact ⟨U i, homOfLE (hUW i), Sieve.ofArrows_mk _ _ i, hxi⟩

/-- For a meet-closed family of compact opens `B : Set (Opens X)`, set-level gluing for finite
covers within `B` upgrades to arbitrary covers within `B`. -/
theorem isSheafFor_ofArrows_of_finite (hBinf : ∀ ⦃U V : Opens X⦄, U ∈ B → V ∈ B → U ⊓ V ∈ B)
    (hcomp : ∀ ⦃W : Opens X⦄, W ∈ B → IsCompact (W : Set X))
    {F : (Opens X)ᵒᵖ ⥤ Type w}
    (hfin : ∀ {W : Opens X} {κ : Type u₁} [Finite κ] {V : κ → Opens X},
      W ∈ B → (∀ k, V k ∈ B) → ∀ hcov : ⨆ k, V k = W,
      (Presieve.ofArrows V fun k ↦ homOfLE ((le_iSup V k).trans_eq hcov)).IsSheafFor F)
    {W : Opens X} (hW : W ∈ B) {ι : Type u₂} {U : ι → Opens X} (hU : ∀ i, U i ∈ B)
    (hcov : ⨆ i, U i = W) :
    (Presieve.ofArrows U fun i ↦ homOfLE ((le_iSup U i).trans_eq hcov)).IsSheafFor F := by
  classical
  obtain ⟨I, hcovI⟩ := _root_.TopologicalSpace.Opens.exists_finite_subcover_of_isCompact
    (hcomp hW) hcov
  let e : ULift.{u₁} (Fin (Nat.card ↥I)) ≃ ↥I :=
    Equiv.ulift.{u₁}.trans (Finite.equivFin ↥I).symm
  let κ' := ULift.{u₁} (Fin (Nat.card ↥I))
  let U' : κ' → Opens X := fun k ↦ U (e k).val
  have hcovI' : (⨆ k : κ', U' k) = W :=
    (e.iSup_comp (g := fun k : ↥I ↦ U k.val)).trans hcovI
  have hcovUi (i : ι) : (⨆ k : κ', U i ⊓ U' k) = U i := by
    rw [← inf_iSup_eq, hcovI', inf_eq_left.mpr ((le_iSup U i).trans_eq hcov)]
  refine Presieve.isSheafFor_ofArrows_of_factorsThru _
    (fun i ↦ Presieve.ofArrows (fun k : κ' ↦ U i ⊓ U' k)
      fun k ↦ homOfLE ((le_iSup (fun k : κ' ↦ U i ⊓ U' k) k).trans_eq (hcovUi i)))
    (fun i ↦ (hfin (V := fun k : κ' ↦ U i ⊓ U' k) (hU i)
      (fun k ↦ hBinf (hU i) (hU (e k).val)) (hcovUi i)).isSeparatedFor)
    (S := Presieve.ofArrows U' fun k ↦ homOfLE ((le_iSup U' k).trans_eq hcovI'))
    (hfin (V := U') hW (fun k ↦ hU (e k).val) hcovI')
    (fun V g ⟨k⟩ ↦ ⟨U (e k).val, 𝟙 _, homOfLE ((le_iSup U (e k).val).trans_eq hcov),
      Presieve.ofArrows.mk (e k).val, Category.id_comp _⟩)
    (fun i Z g ⟨k⟩ ↦ ⟨U' k, homOfLE inf_le_right,
      homOfLE ((le_iSup U' k).trans_eq hcovI'), Presieve.ofArrows.mk k,
      Subsingleton.elim _ _⟩)

/-- **The sheaf condition on a meet-closed family of opens.** For a family `B : Set (Opens X)`
closed under binary meets and any presheaf of types `F` on `X`, if `F` satisfies the sheaf
condition for every cover of a member of `B` by members of `B`, then the restriction of `F` to `B`
is a sheaf for the topology restricted from `X`. -/
theorem isSheaf_restrictedTopology_of_isSheafFor_ofArrows
    (hBinf : ∀ ⦃U V : Opens X⦄, U ∈ B → V ∈ B → U ⊓ V ∈ B)
    (F : (Opens X)ᵒᵖ ⥤ Type w)
    (hcover : ∀ {W : Opens X} {ι : Type u} {U : ι → Opens X},
      W ∈ B → (∀ i, U i ∈ B) → ∀ hcov : ⨆ i, U i = W,
      (Presieve.ofArrows U fun i ↦ homOfLE ((le_iSup U i).trans_eq hcov)).IsSheafFor F) :
    Presieve.IsSheaf
      ((inducedFunctor (Subtype.val : B → Opens X)).restrictedTopology
        (Opens.grothendieckTopology X))
      ((inducedFunctor (Subtype.val : B → Opens X)).op ⋙ F) := by
  let ι := inducedFunctor (Subtype.val : B → Opens X)
  let isPullback_inf {Z A C : InducedCategory (Opens X) (Subtype.val : B → Opens X)}
      (f : A ⟶ Z) (g : C ⟶ Z) :
      @IsPullback (InducedCategory (Opens X) (Subtype.val : B → Opens X)) _
        ⟨A.val ⊓ C.val, hBinf A.property C.property⟩ A C Z
        (InducedCategory.homMk (homOfLE inf_le_left))
        (InducedCategory.homMk (homOfLE inf_le_right))
        f g := by
    refine IsPullback.mk' (InducedCategory.hom_ext (Subsingleton.elim _ _))
      (fun _ _ _ _ _ ↦ InducedCategory.hom_ext (Subsingleton.elim _ _))
      fun T a b _ ↦ ⟨InducedCategory.homMk (homOfLE (le_inf a.hom.le b.hom.le)),
        InducedCategory.hom_ext (Subsingleton.elim _ _),
        InducedCategory.hom_ext (Subsingleton.elim _ _)⟩
  rw [Functor.restrictedTopology, Precoverage.isSheaf_toGrothendieck_iff]
  intro W Y f R hR
  obtain ⟨κ, U, π, rfl⟩ := R.exists_eq_ofArrows
  rw [Precoverage.mem_comap_iff, GrothendieckTopology.mem_toPrecoverage_iff,
    Presieve.map_ofArrows, _root_.Opens.mem_grothendieckTopology] at hR
  let V : κ → InducedCategory (Opens X) (Subtype.val : B → Opens X) :=
    fun i ↦ ⟨Y.val ⊓ (U i).val, hBinf Y.property (U i).property⟩
  let hVle (i : κ) : V i ⟶ Y := InducedCategory.homMk (homOfLE inf_le_left)
  have hcovV : ⨆ i, (V i).val = Y.val := by
    refine le_antisymm (iSup_le fun _ ↦ inf_le_left) fun x hx ↦ ?_
    obtain ⟨W', g, ⟨_, a, _, ⟨i⟩, -⟩, hxW'⟩ := hR x (f.hom.le hx)
    exact Opens.mem_iSup.mpr ⟨i, hx, a.le hxW'⟩
  have hgen : (Sieve.generate (Presieve.ofArrows U π)).pullback f =
      Sieve.generate (Presieve.ofArrows V hVle) :=
    (Sieve.ofArrows_eq_pullback_of_isPullback π fun i ↦ isPullback_inf f (π i)).symm
  have : (Presieve.ofArrows V hVle).HasPairwisePullbacks :=
    ⟨by rintro _ _ _ ⟨i⟩ _ ⟨j⟩; exact (isPullback_inf (hVle i) (hVle j)).hasPullback⟩
  have : ι.PreservesPairwisePullbacks (Presieve.ofArrows V hVle) :=
    ⟨fun {Y₁ Y₂} {f g} hf hg ↦ by
      cases hf with | mk i =>
      cases hg with | mk j =>
      exact ⟨fun {c} hc ↦
        ⟨{ lift := fun s ↦ homOfLE ((le_inf (s.π.app .left).le (s.π.app .right).le).trans
             ((isPullback_inf (hVle i) (hVle j)).isLimit.conePointUniqueUpToIso hc).hom.hom.le)
           fac := fun _ _ ↦ Subsingleton.elim _ _
           uniq := fun _ _ _ ↦ Subsingleton.elim _ _ }⟩⟩⟩
  rw [hgen, ← Presieve.isSheafFor_iff_generate,
    Presieve.IsSheafFor.comp_iff_of_preservesPairwisePullbacks ι F (Presieve.ofArrows V hVle),
    Presieve.map_ofArrows]
  have hpi : (fun i ↦ ι.map (hVle i)) =
      fun i ↦ homOfLE ((le_iSup (fun i ↦ (V i).val) i).trans_eq hcovV) :=
    funext fun i ↦ Subsingleton.elim _ _
  rw [hpi]
  exact hcover Y.property (fun i ↦ (V i).property) hcovV

end TopologicalSpace.Opens

