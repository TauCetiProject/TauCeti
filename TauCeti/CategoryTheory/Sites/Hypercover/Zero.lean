module

public import Mathlib.CategoryTheory.Sites.Hypercover.Zero

import Mathlib.CategoryTheory.Sites.Sieves.Basic
import Mathlib.CategoryTheory.Sites.Sieves.Presieve

/-!
# Pullbacks of `0`-hypercovers

This file complements `Mathlib.CategoryTheory.Sites.Hypercover.Zero` by recording the presieve and
sieve identities for `Precoverage.ZeroHypercover.pullback₂`.

## Main results

* `CategoryTheory.Precoverage.ZeroHypercover.presieve₀_pullback₂`: the presieve of
  `E.pullback₂ h` is `E.presieve₀.pullbackArrows h`.
* `CategoryTheory.Precoverage.ZeroHypercover.presieve₀_pullback₂_eq_ofArrows`: the presieve of
  `E.pullback₂ h` is `Presieve.ofArrows (fun i ↦ pullback (E.f i) h) (fun i ↦ pullback.snd _ _)`.
* `CategoryTheory.Precoverage.ZeroHypercover.sieve_generate_pullback₂`: pulling back the sieve
  generated by `E.presieve₀` along `h` yields the sieve generated by `(E.pullback₂ h).presieve₀`.
-/

public section

universe w

open CategoryTheory Limits

namespace CategoryTheory.Precoverage.ZeroHypercover

variable {C : Type*} [Category* C]

/-- The presieve of `E.pullback₂ h` is the pullback presieve `E.presieve₀.pullbackArrows h`. -/
lemma presieve₀_pullback₂ {J : Precoverage C} [J.IsStableUnderBaseChange]
    {S T : C} (E : J.ZeroHypercover.{w} T) (h : S ⟶ T) [∀ i, HasPullback (E.f i) h] :
    (E.pullback₂ h).presieve₀ = E.presieve₀.pullbackArrows h := by
  rw [pullback₂_toPreZeroHypercover, PreZeroHypercover.presieve₀_pullback₁]

/-- The presieve of `E.pullback₂ h` is generated by the family of pullback projections
`pullback.snd (E.f i) h`. -/
lemma presieve₀_pullback₂_eq_ofArrows {J : Precoverage C} [J.IsStableUnderBaseChange]
    {S T : C} (E : J.ZeroHypercover.{w} T) (h : S ⟶ T) [∀ i, HasPullback (E.f i) h] :
    (E.pullback₂ h).presieve₀ =
      Presieve.ofArrows (fun i ↦ pullback (E.f i) h) (fun i ↦ pullback.snd (E.f i) h) := by
  rw [presieve₀_pullback₂]
  dsimp only [PreZeroHypercover.presieve₀]
  rw [Presieve.ofArrows_pullback]

/-- Pulling back the sieve generated by `E.presieve₀` along `h` gives the sieve generated by
`(E.pullback₂ h).presieve₀`. -/
lemma sieve_generate_pullback₂ {J : Precoverage C} [J.IsStableUnderBaseChange]
    {S T : C} (E : J.ZeroHypercover.{w} T) (h : S ⟶ T) [∀ i, HasPullback (E.f i) h] :
    (Sieve.generate E.presieve₀).pullback h = Sieve.generate (E.pullback₂ h).presieve₀ := by
  rw [presieve₀_pullback₂, Sieve.pullbackArrows_comm]

end CategoryTheory.Precoverage.ZeroHypercover
