module

public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.CoverPreserving

/-!
# Preserving covers of a coverage-generated topology

A functor preserves the topology generated by a coverage if it sends each generating
presieve to a family generating a cover. The transitivity step uses a general criterion
for the pushforward of a sieve to cover.
-/

public section

namespace CategoryTheory

variable {C D : Type*} [Category* C] [Category* D]

/-- A sieve has covering pushforward if a sieve with covering pushforward locally pulls
it back to sieves with covering pushforward. -/
theorem GrothendieckTopology.functorPushforward_transitive (J : GrothendieckTopology D)
    (F : C ⥤ D) {X : C} {R S : Sieve X}
    (hR : R.functorPushforward F ∈ J (F.obj X))
    (hS : ∀ ⦃Y : C⦄ ⦃f : Y ⟶ X⦄, R f →
      (S.pullback f).functorPushforward F ∈ J (F.obj Y)) :
    S.functorPushforward F ∈ J (F.obj X) := by
  apply J.transitive hR
  rintro W _ ⟨Y, f, g, hf, rfl⟩
  rw [Sieve.pullback_comp]
  apply J.pullback_stable
  exact J.superset_covering (Sieve.functorPushforward_pullback_le F f S) (hS hf)

/-- Sending the generating presieves of a coverage to families generating covers suffices
to preserve all covering sieves of the generated topology. -/
theorem Coverage.coverPreserving_of_generators (K : Coverage C) (J : GrothendieckTopology D)
    (F : C ⥤ D)
    (hF : ∀ {X : C} {R : Presieve X}, R ∈ K X →
      Sieve.generate (R.map F) ∈ J (F.obj X)) :
    CoverPreserving K.toGrothendieck J F where
  cover_preserve hR := by
    rw [Coverage.mem_toGrothendieck] at hR
    induction hR with
    | of X R hR => simpa [Sieve.generate_map_eq_functorPushforward] using hF hR
    | top X => simp
    | transitive X R S _ _ ihR ihS =>
      exact J.functorPushforward_transitive F ihR ihS

end CategoryTheory
