module

public import Mathlib.CategoryTheory.Sites.Over
public import TauCeti.CategoryTheory.MorphismProperty.Over

/-!
# Families in restricted over categories

Forgetting a family in a restricted over category and applying the slice sieve equivalence
gives the sieve generated by its underlying arrows.
-/

public section

namespace CategoryTheory.MorphismProperty.Over

/-- The sieve associated to a family in a restricted over category is generated by the
underlying arrows after forgetting the structure morphisms. -/
lemma overEquiv_ofArrows_forget {C : Type*} [Category* C] (P Q : MorphismProperty C)
    [Q.IsMultiplicative] (S : C) {X : P.Over Q S} {ι : Type*} (Y : ι → P.Over Q S)
    (f : ∀ i, Y i ⟶ X) :
    Sieve.overEquiv ((Over.forget P Q S).obj X)
      (Sieve.ofArrows (fun i ↦ (Over.forget P Q S).obj (Y i))
        (fun i ↦ (Over.forget P Q S).map (f i))) =
      Sieve.ofArrows (fun i ↦ (Y i).left) (fun i ↦ (f i).left) := by
  rw [Sieve.overEquiv_ofArrows]
  change Sieve.ofArrows (fun i ↦ (Over.forget P Q S ⋙ CategoryTheory.Over.forget S).obj (Y i))
    (fun i ↦ (Over.forget P Q S ⋙ CategoryTheory.Over.forget S).map (f i)) = _
  simp only [Functor.comp_obj, CategoryTheory.Over.forget_obj, forget_obj_left,
    forget_comp_forget_map]

end CategoryTheory.MorphismProperty.Over
