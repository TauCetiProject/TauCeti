module

public import Mathlib.CategoryTheory.Limits.Shapes.Products
public import Mathlib.CategoryTheory.Sites.Sieves.Basic

/-!
# Basic properties of sieves

This file records supplementary basic lemmas about sieves and presieves complementing
`Mathlib.CategoryTheory.Sites.Sieves.Basic`.

## Main results

* `CategoryTheory.Sieve.generate_singleton_comp_of_isIso`: precomposing the generator of a
  principal sieve with an isomorphism does not change the generated sieve.
* `CategoryTheory.Sieve.generate_ofArrows_pUnit_comp_of_isIso`: `PUnit`-indexed form of
  `generate_singleton_comp_of_isIso`.
* `CategoryTheory.Presieve.ofArrows_sigma_ι_comp_desc`: reindexing the composite coproduct
  inclusions `Sigma.ι X j ≫ Sigma.desc f` along `Σ _ : κ, ι` for nonempty `κ` gives
  `Presieve.ofArrows X f`.
-/

public section

namespace CategoryTheory.Sieve

/-- Precomposing a morphism `f` with an isomorphism `i` does not change the sieve generated by
`Presieve.singleton f`. -/
@[simp]
lemma generate_singleton_comp_of_isIso {C : Type*} [Category* C] {X Y Z : C}
    (i : X ⟶ Y) (f : Y ⟶ Z) [IsIso i] :
    Sieve.generate (.singleton (i ≫ f)) = Sieve.generate (.singleton f) := by
  refine le_antisymm ?_ ?_ <;> rw [Sieve.generate_le_iff, Presieve.singleton_le_iff]
  · exact (Sieve.comp_mem_iff i f _).mpr (Sieve.le_generate _ _ _ .mk)
  · exact (Sieve.comp_mem_iff i f _).mp (Sieve.le_generate _ _ _ .mk)

/-- Precomposing the morphism of a `PUnit`-indexed presieve with an isomorphism `i` does not change
the generated sieve. -/
lemma generate_ofArrows_pUnit_comp_of_isIso {C : Type*} [Category* C] {X Y Z : C}
    (i : X ⟶ Y) (f : Y ⟶ Z) [IsIso i] :
    Sieve.generate (Presieve.ofArrows (fun _ : PUnit ↦ Y) (fun _ ↦ f)) =
      Sieve.generate (.singleton (i ≫ f)) := by
  rw [Presieve.ofArrows_pUnit, generate_singleton_comp_of_isIso]

end CategoryTheory.Sieve

namespace CategoryTheory.Presieve

open Limits

/-- Reindexing the composite coproduct inclusions `Sigma.ι X jk.2 ≫ Sigma.desc f` along
`Σ _ : κ, ι` for nonempty `κ` gives `Presieve.ofArrows X f`. -/
lemma ofArrows_sigma_ι_comp_desc {C : Type*} [Category* C] {κ ι : Type*} [Nonempty κ]
    {X : ι → C} [HasCoproduct X] {S : C} (f : ∀ i, X i ⟶ S) :
    Presieve.ofArrows (fun jk : Σ _ : κ, ι ↦ X jk.2)
        (fun jk ↦ Sigma.ι X jk.2 ≫ Sigma.desc f) =
      Presieve.ofArrows X f := by
  simp only [Sigma.ι_comp_desc]
  obtain ⟨k₀⟩ := ‹Nonempty κ›
  exact Presieve.ofArrows_comp_eq_of_surjective (a := @Sigma.snd κ fun _ ↦ ι) f
    fun i ↦ ⟨⟨k₀, i⟩, rfl⟩

end CategoryTheory.Presieve
