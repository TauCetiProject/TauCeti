module

public import Mathlib.CategoryTheory.Sites.Sieves.Basic

/-!
# Basic properties of sieves

This file records supplementary basic lemmas about sieves complementing
`Mathlib.CategoryTheory.Sites.Sieves.Basic`.

## Main results

* `CategoryTheory.Sieve.generate_singleton_comp_of_isIso`: precomposing the generator of a
  principal sieve with an isomorphism does not change the generated sieve.
-/

public section

namespace CategoryTheory.Sieve

/-- Precomposing a morphism `f` with an isomorphism `i` does not change the sieve generated by
`Presieve.singleton f`. -/
@[simp]
lemma generate_singleton_comp_of_isIso {C : Type*} [Category* C] {X Y Z : C}
    (i : X ⟶ Y) (f : Y ⟶ Z) [IsIso i] :
    Sieve.generate (.singleton (i ≫ f)) = Sieve.generate (.singleton f) := by
  refine le_antisymm ?_ ?_ <;> rw [Sieve.generate_le_iff, Presieve.singleton_le_iff]
  · exact (Sieve.comp_mem_iff i f _).mpr (Sieve.le_generate _ _ _ .mk)
  · exact (Sieve.comp_mem_iff i f _).mp (Sieve.le_generate _ _ _ .mk)

end CategoryTheory.Sieve
