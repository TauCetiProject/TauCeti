module

public import Mathlib.CategoryTheory.Sites.Descent.Precoverage
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.Pseudofunctor

/-!
# The stackification of a prestack is a stack

Let `F` be a prestack for a Grothendieck topology `J` on a category `C` with pullbacks, and let
`stackification J F` be the pseudofunctor of descent data for `F` along `w`-small covering families
(`TauCeti.CategoryTheory.Sites.Descent.Stackification.Pseudofunctor`). This file proves that
`stackification J F` is a prestack for `J` (`TauCeti.Stack.isPrestack_stackification`), and that it
is a stack for `J` when every covering sieve of `J` contains a covering sieve generated by a family
indexed by a type in `Type w` (`TauCeti.Stack.isStack_stackification`; Stacks, Lemma 02ZN).

Morphisms between pulled back descent data `t^* A ⟶ s^* B` over `T` are handled through their
local evaluations `Obj.pullApp ψ a b h` at local sections `a` of `A` and `b` of `B` over a common
`h : T' ⟶ T`, which avoid the iterated fibre products of the pulled back covering families. They
determine `ψ` (`Obj.pullApp_ext`), every compatible family of local morphisms is the family of
local evaluations of a morphism (`Obj.ofPullApp`), and they are compatible with pullback,
composition, identities, pullback functors and the comparison isomorphisms of the
stackification (`Obj.pullHom_pullApp`, `Obj.pullApp_comp`, `Obj.pullApp_id`, `Obj.pullApp_map`,
`Obj.pullApp_pullHom`).

The prestack property is the gluing of morphisms (`Obj.glue`): a family of morphisms
`φ g : g^* A ⟶ g^* B` over the members of a covering sieve which is compatible with pullback
(`Obj.IsCompatibleFamily`) is the family of pullbacks of a unique morphism `A ⟶ B`. Its local
evaluations are glued from those of the family, using that `F` is a prestack; no assumption on
the topology is needed.

For effective descent, a descent datum `E` for `stackification J F` along a `w`-small covering
family `(f k : V k ⟶ S)` is glued to a single descent datum for `F`: its covering family consists
of the composites of the covering families of the objects `E.obj k` with the `f k`, indexed by a
type in `Type w`, and its descent isomorphisms are the local evaluations of the descent morphisms
of `E`. Its pullback to `V k` is isomorphic to `E.obj k`, compatibly with the descent morphisms.
Descent along an arbitrary covering sieve then follows from descent along a `w`-small covering
family it contains, by Mathlib's `Pseudofunctor.IsStackFor.of_le`.

## Main declarations

* `TauCeti.Stack.Stackification.Obj.pullApp`: local evaluations of morphisms of pulled back
  descent data, with the constructor `Obj.ofPullApp`.
* `TauCeti.Stack.Stackification.Obj.glue`: gluing morphisms of descent data along a covering sieve.
* `TauCeti.Stack.isPrestack_stackification`: the stackification of a prestack is a prestack.
* `TauCeti.Stack.isStack_stackification`: the stackification of a prestack is a stack when every
  covering sieve contains a covering sieve generated by a `w`-small family.

## References

* [Stacks Project, Section 02ZM](https://stacks.math.columbia.edu/tag/02ZM)
* [Stacks Project, Lemma 02ZN](https://stacks.math.columbia.edu/tag/02ZN)
-/

public section

noncomputable section

universe w v' u' v u

open CategoryTheory Limits Opposite Bicategory Pseudofunctor LocallyDiscreteOpToCat

namespace TauCeti.Stack.Stackification.Obj

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}} [HasPullbacks C] [F.IsPrestack J]

section pullApp

variable {U U' T V : C} {t : T ⟶ U} {s : T ⟶ U'} {A : Obj.{w} J F U} {B : Obj.{w} J F U'}

/-- The local evaluation of a morphism `ψ : t^* A ⟶ s^* B` of pulled back descent data at local
sections `a` of `A` and `b` of `B` over the same `h : T' ⟶ T`: the local evaluation of `ψ` at the
local sections of `t^* A` and `s^* B` defined by `a` and `b`, composed with the isomorphisms
`pullObjIso`. -/
def pullApp (ψ : pullObj t A ⟶ pullObj s B) ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T' ⟶ A.X i)
    (b : T' ⟶ B.X j) (h : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t) (hb : b ≫ B.f j = h ≫ s) :
    (F.map a.op.toLoc).toFunctor.obj (A.D.obj i) ⟶ (F.map b.op.toLoc).toFunctor.obj (B.D.obj j) :=
  (pullObjIso t A (pullback.lift a h ha) a (pullback.lift_fst a h ha)).inv ≫
    Hom.app ψ (pullback.lift a h ha) (pullback.lift b h hb) (by simp) ≫
    (pullObjIso s B (pullback.lift b h hb) b (pullback.lift_fst b h hb)).hom

/-- `pullApp` may be computed through any local sections of `t^* A` and `s^* B` lying over the
given local sections of `A` and `B`. -/
lemma pullApp_eq (ψ : pullObj t A ⟶ pullObj s B) ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄
    (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (h : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t)
    (hb : b ≫ B.f j = h ≫ s) (x : T' ⟶ pullback (A.f i) t) (y : T' ⟶ pullback (B.f j) s)
    (hxa : x ≫ pullback.fst _ _ = a) (hxh : x ≫ pullback.snd _ _ = h)
    (hyb : y ≫ pullback.fst _ _ = b) (hyh : y ≫ pullback.snd _ _ = h) :
    pullApp ψ a b h ha hb = (pullObjIso t A x a hxa).inv ≫
      Hom.app ψ x y (hxh.trans hyh.symm) ≫ (pullObjIso s B y b hyb).hom := by
  obtain rfl : pullback.lift a h ha = x := pullback.hom_ext (by simp [hxa]) (by simp [hxh])
  obtain rfl : pullback.lift b h hb = y := pullback.hom_ext (by simp [hyb]) (by simp [hyh])
  rfl

/-- The local evaluations of `ψ : t^* A ⟶ s^* B` are, up to the isomorphisms `pullObjIso`, its
local evaluations `pullApp` at local sections of `A` and `B`. -/
lemma app_eq_pullApp (ψ : pullObj t A ⟶ pullObj s B) ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄
    (x : T' ⟶ pullback (A.f i) t) (y : T' ⟶ pullback (B.f j) s)
    (w : x ≫ pullback.snd _ _ = y ≫ pullback.snd _ _) (a : T' ⟶ A.X i) (b : T' ⟶ B.X j)
    (hxa : x ≫ pullback.fst _ _ = a) (hyb : y ≫ pullback.fst _ _ = b) :
    Hom.app ψ x y w = (pullObjIso t A x a hxa).hom ≫
      pullApp ψ a b (x ≫ pullback.snd _ _)
        (by rw [← hxa, Category.assoc, Category.assoc, pullback.condition])
        (by rw [← hyb, w, Category.assoc, Category.assoc, pullback.condition]) ≫
      (pullObjIso s B y b hyb).inv := by
  rw [pullApp_eq ψ a b _ _ _ x y hxa rfl hyb w.symm]
  simp

/-- `pullApp` is compatible with pullback. -/
lemma pullHom_pullApp (ψ : pullObj t A ⟶ pullObj s B) ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄
    (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (h : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t)
    (hb : b ≫ B.f j = h ≫ s) ⦃T'' : C⦄ (g : T'' ⟶ T') (ga : T'' ⟶ A.X i) (gb : T'' ⟶ B.X j)
    (gh : T'' ⟶ T) (hga : g ≫ a = ga) (hgb : g ≫ b = gb) (hgh : g ≫ h = gh) :
    pullHom (pullApp ψ a b h ha hb) g ga gb hga hgb =
      pullApp ψ ga gb gh (by rw [← hga, ← hgh, Category.assoc, ha, Category.assoc])
        (by rw [← hgb, ← hgh, Category.assoc, hb, Category.assoc]) := by
  rw [pullApp_eq ψ ga gb gh _ _ (g ≫ pullback.lift a h ha) (g ≫ pullback.lift b h hb)
    (by simp [hga]) (by simp [hgh]) (by simp [hgb]) (by simp [hgh]), pullApp,
    pullHom_comp _ _ g ga (g ≫ pullback.lift a h ha) gb hga rfl hgb,
    pullHom_comp _ _ g (g ≫ pullback.lift a h ha) (g ≫ pullback.lift b h hb) gb rfl rfl hgb,
    pullHom_pullObjIso_hom, pullHom_pullObjIso_inv]
  exact congrArg (_ ≫ ·) (congrArg (· ≫ _) (Hom.pullHom_app ψ _ _ _ g _ _ rfl rfl))

/-- `pullApp` is compatible with composition. -/
lemma pullApp_comp {U'' : C} {r : T ⟶ U''} {E : Obj.{w} J F U''} (ψ : pullObj t A ⟶ pullObj s B)
    (χ : pullObj s B ⟶ pullObj r E) ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ ⦃k : E.ι⦄ (a : T' ⟶ A.X i)
    (b : T' ⟶ B.X j) (c : T' ⟶ E.X k) (h : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t)
    (hb : b ≫ B.f j = h ≫ s) (hc : c ≫ E.f k = h ≫ r) :
    pullApp (ψ ≫ χ) a c h ha hc = pullApp ψ a b h ha hb ≫ pullApp χ b c h hb hc := by
  rw [pullApp, pullApp, pullApp, comp_app _ _ _ (pullback.lift b h hb) _ _ (by simp) (by simp)]
  simp

/-- The local evaluations `pullApp` of an identity are the descent isomorphisms. -/
@[simp]
lemma pullApp_id ⦃T' : C⦄ ⦃i i' : A.ι⦄ (a : T' ⟶ A.X i) (a' : T' ⟶ A.X i') (h : T' ⟶ T)
    (ha : a ≫ A.f i = h ≫ t) (ha' : a' ≫ A.f i' = h ≫ t) :
    pullApp (𝟙 (pullObj t A)) a a' h ha ha' = A.D.hom (h ≫ t) a a' ha ha' := by
  rw [pullApp, id_app, pullObj_D_hom t A _ _ _ (by simp) (by simp) a a' (by simp) (by simp)]
  simpa using A.D.hom_congr _ _ a a' rfl (ha'.trans ha.symm) ha

/-- The local evaluations `pullApp` of the pullback of a morphism `φ` are local evaluations of
`φ`. -/
@[simp]
lemma pullApp_map {V : C} {P Q : Obj.{w} J F V} (g : T ⟶ V) (φ : P ⟶ Q) ⦃T' : C⦄ ⦃i : P.ι⦄
    ⦃j : Q.ι⦄ (a : T' ⟶ P.X i) (b : T' ⟶ Q.X j) (h : T' ⟶ T) (ha : a ≫ P.f i = h ≫ g)
    (hb : b ≫ Q.f j = h ≫ g) :
    pullApp ((pullFunctor J F g).map φ) a b h ha hb = Hom.app φ a b (ha.trans hb.symm) := by
  rw [pullApp, app_pullFunctor_map g φ _ _ (by simp) a b (by simp) (by simp)]
  simp

/-- The local evaluations `pullApp` of the pullback of a morphism `ψ : t^* A ⟶ s^* B` along `g`,
composed with the composition isomorphisms, are local evaluations `pullApp` of `ψ`. By
`stackification_pullHom`, this computes the pullbacks `pullHom` of `ψ` in the stackification. -/
lemma pullApp_pullHom {V : C} (g : V ⟶ T) (gt : V ⟶ U) (gs : V ⟶ U') (hgt : g ≫ t = gt)
    (hgs : g ≫ s = gs) (ψ : pullObj t A ⟶ pullObj s B) ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄
    (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (h : T' ⟶ V) (ha : a ≫ A.f i = h ≫ gt)
    (hb : b ≫ B.f j = h ≫ gs) :
    pullApp ((pullFunctorComp J F t g gt hgt).hom.app A ≫ (pullFunctor J F g).map ψ ≫
      (pullFunctorComp J F s g gs hgs).inv.app B) a b h ha hb =
      pullApp ψ a b (h ≫ g) (by rw [ha, ← hgt, Category.assoc])
        (by rw [hb, ← hgs, Category.assoc]) := by
  have ha' : a ≫ A.f i = (h ≫ g) ≫ t := by rw [ha, ← hgt, Category.assoc]
  have hb' : b ≫ B.f j = (h ≫ g) ≫ s := by rw [hb, ← hgs, Category.assoc]
  rw [pullApp_eq _ a b h ha hb (pullback.lift a h ha) (pullback.lift b h hb) (by simp) (by simp)
    (by simp) (by simp), pullApp_eq ψ a b (h ≫ g) _ _ (pullback.lift a (h ≫ g) ha')
    (pullback.lift b (h ≫ g) hb') (by simp) (by simp) (by simp) (by simp)]
  rw [comp_app _ _ _ (pullback.lift (pullback.lift a (h ≫ g) ha') h (by simp)) _ _ (by simp)
      (by simp),
    comp_app _ _ _ (pullback.lift (pullback.lift b (h ≫ g) hb') h (by simp)) _ _ (by simp)
      (by simp),
    app_pullFunctorComp_hom_app t g gt hgt A _ _ _ a (pullback.lift a (h ≫ g) ha') a (by simp)
      (by simp) (by simp),
    app_pullFunctor_map g ψ _ _ _ (pullback.lift a (h ≫ g) ha') (pullback.lift b (h ≫ g) hb')
      (by simp) (by simp),
    app_pullFunctorComp_inv_app s g gs hgs B _ _ _ (pullback.lift b (h ≫ g) hb') b b (by simp)
      (by simp) (by simp)]
  simp [DescentData.hom_self]

/-- Precomposing a local evaluation `pullApp` with a descent isomorphism of the source changes the
local section of the source. -/
@[reassoc]
lemma descentData_hom_comp_pullApp (ψ : pullObj t A ⟶ pullObj s B) ⦃T' : C⦄ ⦃i i' : A.ι⦄
    ⦃j : B.ι⦄ (q : T' ⟶ U) (a : T' ⟶ A.X i) (a' : T' ⟶ A.X i') (b : T' ⟶ B.X j) (h : T' ⟶ T)
    (hq : a ≫ A.f i = q) (hq' : a' ≫ A.f i' = q) (ha' : a' ≫ A.f i' = h ≫ t)
    (hb : b ≫ B.f j = h ≫ s) :
    A.D.hom q a a' hq hq' ≫ pullApp ψ a' b h ha' hb =
      pullApp ψ a b h (hq.trans (hq'.symm.trans ha')) hb := by
  rw [A.D.hom_congr q (h ≫ t) a a' hq hq' (hq'.symm.trans ha'), ← pullApp_id, ← pullApp_comp,
    Category.id_comp]

/-- Postcomposing a local evaluation `pullApp` with a descent isomorphism of the target changes
the local section of the target. -/
@[reassoc]
lemma pullApp_comp_descentData_hom (ψ : pullObj t A ⟶ pullObj s B) ⦃T' : C⦄ ⦃i : A.ι⦄
    ⦃j j' : B.ι⦄ (q : T' ⟶ U') (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (b' : T' ⟶ B.X j')
    (h : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t) (hq : b ≫ B.f j = q) (hq' : b' ≫ B.f j' = q)
    (hb : b ≫ B.f j = h ≫ s) :
    pullApp ψ a b h ha hb ≫ B.D.hom q b b' hq hq' =
      pullApp ψ a b' h ha (hq'.trans (hq.symm.trans hb)) := by
  rw [B.D.hom_congr q (h ≫ s) b b' hq hq' (hq.symm.trans hb), ← pullApp_id, ← pullApp_comp,
    Category.comp_id]

/-- Rewriting the base `h` of a local evaluation `pullApp ψ a b h`, transporting the proofs. -/
lemma pullApp_congr (ψ : pullObj t A ⟶ pullObj s B) ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄
    (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (h h' : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t)
    (hb : b ≫ B.f j = h ≫ s) (e : h = h') :
    pullApp ψ a b h ha hb = pullApp ψ a b h' (by rw [ha, e]) (by rw [hb, e]) := by
  subst e
  rfl

omit [F.IsPrestack J] in
/-- Morphisms `t^* A ⟶ s^* B` are determined by their local evaluations `pullApp` over the members
of a covering sieve of `T`. -/
lemma pullApp_ext [F.IsPrestack J] {ψ ψ' : pullObj t A ⟶ pullObj s B} (R : Sieve T)
    (hR : R ∈ J T)
    (H : ∀ ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (h : T' ⟶ T)
      (ha : a ≫ A.f i = h ≫ t) (hb : b ≫ B.f j = h ≫ s), R h →
        pullApp ψ a b h ha hb = pullApp ψ' a b h ha hb) :
    ψ = ψ' :=
  Hom.ext_of_sieve R hR fun T' i j x y w hx ↦ by
    rw [app_eq_pullApp ψ x y w _ _ rfl rfl, app_eq_pullApp ψ' x y w _ _ rfl rfl, H _ _ _ _ _ hx]

section ofPullApp

variable (G : ∀ ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (h : T' ⟶ T),
    a ≫ A.f i = h ≫ t → b ≫ B.f j = h ≫ s →
      ((F.map a.op.toLoc).toFunctor.obj (A.D.obj i) ⟶ (F.map b.op.toLoc).toFunctor.obj (B.D.obj j)))

omit [HasPullbacks C] [F.IsPrestack J] in
private lemma G_congr ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T' ⟶ A.X i) (b : T' ⟶ B.X j)
    (h h' : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t) (hb : b ≫ B.f j = h ≫ s) (e : h = h') :
    G a b h ha hb = G a b h' (by rw [ha, e]) (by rw [hb, e]) := by
  subst e
  rfl

/-- The local evaluation of `ofPullApp G` at local sections `x` of `t^* A` and `y` of `s^* B`,
through local sections `a` of `A` and `b` of `B` below them. -/
private def ofPullAppApp ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (x : T' ⟶ pullback (A.f i) t)
    (y : T' ⟶ pullback (B.f j) s) (w : x ≫ pullback.snd _ _ = y ≫ pullback.snd _ _)
    (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (ha : x ≫ pullback.fst _ _ = a)
    (hb : y ≫ pullback.fst _ _ = b) :
    (F.map x.op.toLoc).toFunctor.obj ((pullObj t A).D.obj i) ⟶
      (F.map y.op.toLoc).toFunctor.obj ((pullObj s B).D.obj j) :=
  (pullObjIso t A x a ha).hom ≫
    G a b (x ≫ pullback.snd _ _) (by simp [← ha, pullback.condition])
      (by simp [← hb, w, pullback.condition]) ≫ (pullObjIso s B y b hb).inv

omit [F.IsPrestack J] in
private lemma ofPullAppApp_congr ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (x : T' ⟶ pullback (A.f i) t)
    (y : T' ⟶ pullback (B.f j) s) (w : x ≫ pullback.snd _ _ = y ≫ pullback.snd _ _)
    (a a' : T' ⟶ A.X i) (b b' : T' ⟶ B.X j) (ha : x ≫ pullback.fst _ _ = a)
    (hb : y ≫ pullback.fst _ _ = b) (ha' : x ≫ pullback.fst _ _ = a')
    (hb' : y ≫ pullback.fst _ _ = b') :
    ofPullAppApp G x y w a b ha hb = ofPullAppApp G x y w a' b' ha' hb' := by
  subst ha ha' hb hb'
  rfl

variable
  (pull : ∀ ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (h : T' ⟶ T)
    (ha : a ≫ A.f i = h ≫ t) (hb : b ≫ B.f j = h ≫ s) ⦃T'' : C⦄ (g : T'' ⟶ T'),
    pullHom (G a b h ha hb) g (g ≫ a) (g ≫ b) rfl rfl =
      G (g ≫ a) (g ≫ b) (g ≫ h) (by rw [Category.assoc, ha, Category.assoc])
        (by rw [Category.assoc, hb, Category.assoc]))
  (comm : ∀ ⦃T' : C⦄ ⦃i i' : A.ι⦄ ⦃j j' : B.ι⦄ (a : T' ⟶ A.X i) (a' : T' ⟶ A.X i')
    (b : T' ⟶ B.X j) (b' : T' ⟶ B.X j') (h : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t)
    (ha' : a' ≫ A.f i' = h ≫ t) (hb : b ≫ B.f j = h ≫ s) (hb' : b' ≫ B.f j' = h ≫ s),
    A.D.hom (h ≫ t) a a' ha ha' ≫ G a' b' h ha' hb' = G a b h ha hb ≫ B.D.hom (h ≫ s) b b' hb hb')

/-- The morphism `t^* A ⟶ s^* B` whose local evaluations `pullApp` are given by a family `G` of
local morphisms compatible with pullback and with the descent data (`pullApp_ofPullApp`). -/
def ofPullApp : pullObj t A ⟶ pullObj s B :=
  Hom.ofApp (fun _ _ _ x y w ↦ ofPullAppApp G x y w _ _ rfl rfl)
    (fun T' i j x y w T'' g gx gy hgx hgy ↦ by
      subst hgx hgy
      rw [ofPullAppApp, pullHom_comp _ _ g _ (g ≫ x ≫ pullback.fst _ _) _ rfl (by simp) rfl,
        pullHom_comp _ _ g _ (g ≫ y ≫ pullback.fst _ _) _ (by simp) rfl rfl,
        pullHom_pullObjIso_hom, pullHom_pullObjIso_inv, pull,
        ofPullAppApp_congr G _ _ _ _ (g ≫ x ≫ pullback.fst _ _) _ (g ≫ y ≫ pullback.fst _ _)
          rfl rfl (by simp) (by simp), ofPullAppApp]
      rw [G_congr G _ _ _ ((g ≫ x) ≫ pullback.snd _ _) _ _ (by simp)])
    (fun T' i i' j j' x x' y y' w w' hx ↦ by
      rw [ofPullAppApp, ofPullAppApp, pullObj_D_hom t A _ _ _ rfl hx.symm _ _ rfl rfl,
        pullObj_D_hom s B _ _ _ w.symm (w'.symm.trans hx.symm) _ _ rfl rfl]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
      rw [G_congr G _ _ _ (x ≫ pullback.snd _ _) _ _ hx.symm]
      have := comm (x ≫ pullback.fst _ _) (x' ≫ pullback.fst _ _) (y ≫ pullback.fst _ _)
        (y' ≫ pullback.fst _ _) (x ≫ pullback.snd _ _) (by simp [pullback.condition])
        (by simp [pullback.condition, hx]) (by simp [pullback.condition, w])
        (by simp [pullback.condition, w', hx])
      rw [A.D.hom_congr _ ((x ≫ pullback.snd _ _) ≫ t) _ _ _ _ (by simp [pullback.condition])]
      refine congrArg (_ ≫ ·) ?_
      rw [← Category.assoc, this, Category.assoc, B.D.hom_congr (y ≫ pullback.fst _ _ ≫ B.f j)
        ((x ≫ pullback.snd _ _) ≫ s) _ _ _ _ (by simp [pullback.condition, w])])

/-- The local evaluations `pullApp` of `ofPullApp G` are given by `G`. -/
@[simp]
lemma pullApp_ofPullApp ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T' ⟶ A.X i) (b : T' ⟶ B.X j)
    (h : T' ⟶ T) (ha : a ≫ A.f i = h ≫ t) (hb : b ≫ B.f j = h ≫ s) :
    pullApp (ofPullApp G pull comm) a b h ha hb = G a b h ha hb := by
  rw [pullApp, ofPullApp, Hom.app_ofApp,
    ofPullAppApp_congr G _ _ _ _ a _ b rfl rfl (by simp) (by simp), ofPullAppApp,
    G_congr G _ _ _ h _ _ (by simp)]
  simp

end ofPullApp

/-- The local evaluations `pullApp` of the composition isomorphism `pullFunctorComp` are descent
isomorphisms, up to the isomorphisms `pullObjIso`. -/
lemma pullApp_pullFunctorComp_hom_app {W : C} (q : V ⟶ U) (r : W ⟶ V) (rq : W ⟶ U)
    (hrq : r ≫ q = rq) (A : Obj.{w} J F U) ⦃T' : C⦄ ⦃i j : A.ι⦄ (a : T' ⟶ A.X i)
    (y : T' ⟶ pullback (A.f j) q) (h : T' ⟶ W) (ha : a ≫ A.f i = h ≫ rq)
    (hy : y ≫ pullback.snd _ _ = h ≫ r) :
    pullApp (t := rq) (s := r) (B := pullObj q A) ((pullFunctorComp J F q r rq hrq).hom.app A) a y
      h ha hy =
      A.D.hom (a ≫ A.f i) a (y ≫ pullback.fst _ _) rfl
        (by rw [Category.assoc, pullback.condition, reassoc_of% hy, hrq, ha]) ≫
      (pullObjIso q A y _ rfl).inv := by
  rw [pullApp, app_pullFunctorComp_hom_app q r rq hrq A _ _ _ a y (y ≫ pullback.fst _ _)
    (by simp) (by simp) rfl]
  simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id]
  -- The identity is that of an object of `pullObj q A`, only definitionally that of the goal.
  exact congrArg (_ ≫ ·) (Category.comp_id _)

/-- The local evaluations `pullApp` of the inverse of the composition isomorphism
`pullFunctorComp` are descent isomorphisms, up to the isomorphisms `pullObjIso`. -/
lemma pullApp_pullFunctorComp_inv_app {W : C} (q : V ⟶ U) (r : W ⟶ V) (rq : W ⟶ U)
    (hrq : r ≫ q = rq) (A : Obj.{w} J F U) ⦃T' : C⦄ ⦃i j : A.ι⦄
    (x : T' ⟶ pullback (A.f i) q) (a : T' ⟶ A.X j) (h : T' ⟶ W)
    (hx : x ≫ pullback.snd _ _ = h ≫ r) (ha : a ≫ A.f j = h ≫ rq) :
    pullApp (t := r) (A := pullObj q A) (s := rq) ((pullFunctorComp J F q r rq hrq).inv.app A) x a
      h hx ha =
      (pullObjIso q A x _ rfl).hom ≫ A.D.hom ((x ≫ pullback.fst _ _) ≫ A.f i)
        (x ≫ pullback.fst _ _) a rfl
        (by rw [Category.assoc, pullback.condition, reassoc_of% hx, hrq, ha]) := by
  rw [pullApp, app_pullFunctorComp_inv_app q r rq hrq A _ _ _ x (x ≫ pullback.fst _ _) a
    (by simp) rfl (by simp)]
  simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id]
  -- The identity is that of an object of `pullObj q A`, only definitionally that of the goal.
  exact congrArg (_ ≫ ·) (Category.comp_id _)

end pullApp

section glue

/-! ### Gluing morphisms of descent data -/

variable {U : C} {A B : Obj.{w} J F U} {R : Sieve U}
  (φ : ∀ ⦃T : C⦄ (g : T ⟶ U), R g → (pullObj g A ⟶ pullObj g B))

/-- The compatibility of a family of morphisms `φ g : g^* A ⟶ g^* B` indexed by the members of a
sieve: the pullback of `φ g` along `r` is `φ (r ≫ g)`, through the composition isomorphisms. -/
def IsCompatibleFamily : Prop :=
  ∀ ⦃T : C⦄ (g : T ⟶ U) (hg : R g) ⦃T' : C⦄ (r : T' ⟶ T),
    φ (r ≫ g) (R.downward_closed hg r) = (pullFunctorComp J F g r (r ≫ g) rfl).hom.app A ≫
      (pullFunctor J F r).map (φ g hg) ≫ (pullFunctorComp J F g r (r ≫ g) rfl).inv.app B

variable {φ}

private lemma pullApp_congr_family {T : C} {g g' : T ⟶ U} (hg : R g) (hg' : R g') (e : g = g')
    ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T' ⟶ A.X i) (b : T' ⟶ B.X j) (h : T' ⟶ T)
    (ha : a ≫ A.f i = h ≫ g) (hb : b ≫ B.f j = h ≫ g) :
    pullApp (φ g hg) a b h ha hb = pullApp (φ g' hg') a b h (by rw [ha, e]) (by rw [hb, e]) := by
  subst e
  rfl

/-- For a compatible family, the local evaluations `pullApp (φ g) a b h` only depend on the
composite `h ≫ g`. -/
lemma IsCompatibleFamily.pullApp_eq (hφ : IsCompatibleFamily φ) {T₁ T₂ : C} (g₁ : T₁ ⟶ U)
    (hg₁ : R g₁) (g₂ : T₂ ⟶ U) (hg₂ : R g₂) ⦃T' : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T' ⟶ A.X i)
    (b : T' ⟶ B.X j) (h₁ : T' ⟶ T₁) (h₂ : T' ⟶ T₂) (e : h₁ ≫ g₁ = h₂ ≫ g₂)
    (ha : a ≫ A.f i = h₁ ≫ g₁) (hb : b ≫ B.f j = h₁ ≫ g₁) :
    pullApp (φ g₁ hg₁) a b h₁ ha hb =
      pullApp (φ g₂ hg₂) a b h₂ (ha.trans e) (hb.trans e) := by
  have key {T₀ : C} (g : T₀ ⟶ U) (hg : R g) (h : T' ⟶ T₀) (ha : a ≫ A.f i = h ≫ g)
      (hb : b ≫ B.f j = h ≫ g) :
      pullApp (φ g hg) a b h ha hb = pullApp (φ (h ≫ g) (R.downward_closed hg h)) a b (𝟙 _)
        (by rw [ha, Category.id_comp]) (by rw [hb, Category.id_comp]) := by
    rw [hφ g hg h, pullApp_pullHom]
    exact pullApp_congr _ _ _ _ _ _ _ (Category.id_comp h).symm
  rw [key g₁ hg₁ h₁ ha hb, key g₂ hg₂ h₂ (ha.trans e) (hb.trans e)]
  exact pullApp_congr_family _ _ e _ _ _ _ _

variable (hR : R ∈ J U) (hφ : IsCompatibleFamily φ)

/-- The local morphism `a^* (A.D.obj i) ⟶ b^* (B.D.obj j)` glued from the local evaluations of a
compatible family `φ` over a covering sieve. -/
private def glueApp ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
    (w : a ≫ A.f i = b ≫ B.f j) :
    (F.map a.op.toLoc).toFunctor.obj (A.D.obj i) ⟶ (F.map b.op.toLoc).toFunctor.obj (B.D.obj j) :=
  IsPrestack.glue (J := J) (J.pullback_stable (a ≫ A.f i) hR)
    (fun T' g ga gb hga hgb hg ↦ pullApp (φ (g ≫ a ≫ A.f i) hg) ga gb (𝟙 _)
      (by rw [← hga, Category.id_comp, Category.assoc])
      (by rw [← hgb, Category.id_comp, Category.assoc, w]))
    (fun T' g ga gb hga hgb hg T'' k g' g'a g'b hg'a hg'b hg' e ↦ by
      subst e
      refine (pullHom_pullApp _ _ _ _ _ _ k _ _ k _ _ (Category.comp_id k)).trans
        (hφ.pullApp_eq _ _ _ _ _ _ _ _ ?_ _ _)
      simp)

include hφ in
/-- The pullbacks of `glueApp` to the members of the sieve are the local evaluations of the
family. -/
private lemma pullHom_glueApp ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
    (w : a ≫ A.f i = b ≫ B.f j) ⦃T' : C⦄ (k : T' ⟶ T) (ka : T' ⟶ A.X i) (kb : T' ⟶ B.X j)
    (hka : k ≫ a = ka) (hkb : k ≫ b = kb) {T₀ : C} (g : T₀ ⟶ U) (hg : R g) (h : T' ⟶ T₀)
    (e : ka ≫ A.f i = h ≫ g) :
    pullHom (glueApp hR hφ a b w) k ka kb hka hkb = pullApp (φ g hg) ka kb h e
      (by rw [← hkb, Category.assoc, ← w, ← Category.assoc, hka, e]) := by
  have hk : R (k ≫ a ≫ A.f i) := by
    rw [← Category.assoc, hka, e]
    exact R.downward_closed hg h
  rw [glueApp, IsPrestack.pullHom_glue (J := J) _ _ _ k ka kb hka hkb hk]
  refine hφ.pullApp_eq _ _ _ _ _ _ _ _ ?_ _ _
  rw [Category.id_comp, ← Category.assoc, hka, e]

include hφ in
/-- `glueApp` is the local evaluation of the family wherever the base lies in the sieve. -/
private lemma glueApp_eq ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
    (w : a ≫ A.f i = b ≫ B.f j) {T₀ : C} (g : T₀ ⟶ U) (hg : R g) (h : T ⟶ T₀)
    (e : a ≫ A.f i = h ≫ g) :
    glueApp hR hφ a b w = pullApp (φ g hg) a b h e (by rw [← w, e]) := by
  rw [← pullHom_id (glueApp hR hφ a b w)]
  exact pullHom_glueApp hR hφ a b w (𝟙 _) a b (Category.id_comp a) (Category.id_comp b) g hg h e

include hφ in
private lemma pullHom_glueApp_eq_pullHom ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i)
    (b : T ⟶ B.X j) (w : a ≫ A.f i = b ≫ B.f j) ⦃T' : C⦄ (g : T' ⟶ T) (ga : T' ⟶ A.X i)
    (gb : T' ⟶ B.X j) (hga : g ≫ a = ga) (hgb : g ≫ b = gb) :
    pullHom (glueApp hR hφ a b w) g ga gb hga hgb =
      glueApp hR hφ ga gb (by rw [← hga, ← hgb, Category.assoc, Category.assoc, w]) := by
  refine IsPrestack.pullHom_ext (J := J) (J.pullback_stable (ga ≫ A.f i) hR) fun T'' k hk ↦ ?_
  rw [pullHom_pullHom, pullHom_glueApp hR hφ a b w (k ≫ g) (k ≫ ga) (k ≫ gb)
      (by rw [Category.assoc, hga]) (by rw [Category.assoc, hgb]) (k ≫ ga ≫ A.f i) hk (𝟙 _)
      (by rw [Category.id_comp, Category.assoc]),
    pullHom_glueApp hR hφ ga gb _ k (k ≫ ga) (k ≫ gb) rfl rfl (k ≫ ga ≫ A.f i) hk (𝟙 _)
      (by rw [Category.id_comp, Category.assoc])]

include hφ in
private lemma glueApp_comm ⦃T : C⦄ ⦃i i' : A.ι⦄ ⦃j j' : B.ι⦄ (a : T ⟶ A.X i)
    (a' : T ⟶ A.X i') (b : T ⟶ B.X j) (b' : T ⟶ B.X j') (w : a ≫ A.f i = b ≫ B.f j)
    (w' : a' ≫ A.f i' = b' ≫ B.f j') (ha : a ≫ A.f i = a' ≫ A.f i') :
    A.D.hom (a ≫ A.f i) a a' rfl ha.symm ≫ glueApp hR hφ a' b' w' =
      glueApp hR hφ a b w ≫ B.D.hom (a ≫ A.f i) b b' w.symm (w'.symm.trans ha.symm) := by
  refine IsPrestack.pullHom_ext (J := J) (J.pullback_stable (a ≫ A.f i) hR) fun T' k hk ↦ ?_
  rw [pullHom_comp _ _ k _ (k ≫ a') _ rfl rfl rfl, pullHom_comp _ _ k _ (k ≫ b) _ rfl rfl rfl,
    A.D.pullHom_hom _ _ _ rfl _ _ rfl ha.symm _ _ rfl rfl,
    B.D.pullHom_hom _ _ _ rfl _ _ w.symm (w'.symm.trans ha.symm) _ _ rfl rfl,
    pullHom_glueApp hR hφ a' b' w' k (k ≫ a') (k ≫ b') rfl rfl (k ≫ a ≫ A.f i) hk (𝟙 _)
      (by rw [Category.id_comp, Category.assoc, ha]),
    pullHom_glueApp hR hφ a b w k (k ≫ a) (k ≫ b) rfl rfl (k ≫ a ≫ A.f i) hk (𝟙 _)
      (by rw [Category.id_comp, Category.assoc]),
    descentData_hom_comp_pullApp, pullApp_comp_descentData_hom]

/-- The morphism of descent data glued from a compatible family of morphisms `φ g : g^* A ⟶ g^* B`
over a covering sieve. Its pullbacks are the members of the family (`pullFunctor_map_glue`). -/
def glue : A ⟶ B :=
  Hom.ofApp (glueApp hR hφ) (fun _ _ _ a b w _ g _ _ hga hgb ↦
      pullHom_glueApp_eq_pullHom hR hφ a b w g _ _ hga hgb)
    (fun _ _ _ _ _ a a' b b' w w' ha ↦ glueApp_comm hR hφ a a' b b' w w' ha)

/-- The local evaluations of `glue` are the morphisms `glueApp`. -/
private lemma app_glue ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
    (w : a ≫ A.f i = b ≫ B.f j) :
    Hom.app (glue hR hφ) a b w = glueApp hR hφ a b w :=
  Hom.app_ofApp _ _ _ _ _ _

/-- The pullbacks of the glued morphism are the members of the family. -/
@[simp]
lemma pullFunctor_map_glue {T : C} (g : T ⟶ U) (hg : R g) :
    (pullFunctor J F g).map (glue hR hφ) = φ g hg :=
  hom_ext fun T' i j x y w ↦ by
    rw [app_pullFunctor_map g _ x y w _ _ rfl rfl, app_glue,
      glueApp_eq hR hφ _ _ _ g hg (x ≫ pullback.snd _ _)
        (by rw [Category.assoc, pullback.condition, Category.assoc]),
      app_eq_pullApp _ x y w _ _ rfl rfl]

end glue

/-- Morphisms of descent data whose pullbacks to the members of a covering sieve agree are
equal. -/
lemma hom_ext_of_pullFunctor_map {U : C} {A B : Obj.{w} J F U} {R : Sieve U} (hR : R ∈ J U)
    {ψ ψ' : A ⟶ B}
    (h : ∀ ⦃T : C⦄ (g : T ⟶ U), R g → (pullFunctor J F g).map ψ = (pullFunctor J F g).map ψ') :
    ψ = ψ' :=
  Hom.ext_of_sieve R hR fun T i j a b w ha ↦ by
    rw [← pullApp_map _ ψ a b (𝟙 _) (Category.id_comp _).symm
        (w.symm.trans (Category.id_comp _).symm),
      ← pullApp_map _ ψ' a b (𝟙 _) (Category.id_comp _).symm
        (w.symm.trans (Category.id_comp _).symm), h _ ha]

section descent

/-! ### Effective descent along `w`-small covering families -/

variable {S : C} {κ : Type w} {V : κ → C} {f : ∀ k, V k ⟶ S}
  (E : (stackification.{w} J F).DescentData f)

/-- The objects of a descent datum for the stackification, as descent data for `F`. -/
private abbrev dObj (k : κ) : Obj.{w} J F (V k) := E.obj k

/-- The descent morphisms of a descent datum for the stackification, as morphisms of descent
data for `F`. -/
private abbrev dHom ⦃Y : C⦄ (q : Y ⟶ S) ⦃k₁ k₂ : κ⦄ (f₁ : Y ⟶ V k₁) (f₂ : Y ⟶ V k₂)
    (hf₁ : f₁ ≫ f k₁ = q) (hf₂ : f₂ ≫ f k₂ = q) :
    pullObj f₁ (dObj E k₁) ⟶ pullObj f₂ (dObj E k₂) :=
  E.hom q f₁ f₂ hf₁ hf₂

private lemma dHom_self ⦃Y : C⦄ (q : Y ⟶ S) ⦃k : κ⦄ (g : Y ⟶ V k) (hg : g ≫ f k = q) :
    dHom E q g g hg hg = 𝟙 _ :=
  E.hom_self q g hg

private lemma dHom_comp ⦃Y : C⦄ (q : Y ⟶ S) ⦃k₁ k₂ k₃ : κ⦄ (f₁ : Y ⟶ V k₁) (f₂ : Y ⟶ V k₂)
    (f₃ : Y ⟶ V k₃) (hf₁ : f₁ ≫ f k₁ = q) (hf₂ : f₂ ≫ f k₂ = q) (hf₃ : f₃ ≫ f k₃ = q) :
    dHom E q f₁ f₂ hf₁ hf₂ ≫ dHom E q f₂ f₃ hf₂ hf₃ = dHom E q f₁ f₃ hf₁ hf₃ :=
  E.hom_comp q f₁ f₂ f₃ hf₁ hf₂ hf₃

private lemma dHom_congr ⦃Y : C⦄ (q q' : Y ⟶ S) ⦃k₁ k₂ : κ⦄ (f₁ f₁' : Y ⟶ V k₁)
    (f₂ f₂' : Y ⟶ V k₂) (hf₁ : f₁ ≫ f k₁ = q) (hf₂ : f₂ ≫ f k₂ = q) (e : q = q')
    (e₁ : f₁ = f₁') (e₂ : f₂ = f₂') ⦃T : C⦄ ⦃i₁ : (dObj E k₁).ι⦄ ⦃i₂ : (dObj E k₂).ι⦄
    (a₁ : T ⟶ (dObj E k₁).X i₁) (a₂ : T ⟶ (dObj E k₂).X i₂) (h : T ⟶ Y)
    (ha₁ : a₁ ≫ (dObj E k₁).f i₁ = h ≫ f₁) (ha₂ : a₂ ≫ (dObj E k₂).f i₂ = h ≫ f₂) :
    pullApp (dHom E q f₁ f₂ hf₁ hf₂) a₁ a₂ h ha₁ ha₂ =
      pullApp (dHom E q' f₁' f₂' (by rw [← e, ← e₁, hf₁]) (by rw [← e, ← e₂, hf₂])) a₁ a₂ h
        (by rw [ha₁, e₁]) (by rw [ha₂, e₂]) := by
  subst e e₁ e₂
  rfl

/-- The local morphisms of the descent datum glued from `E`: for local sections `a₁` of `E.obj k₁`
and `a₂` of `E.obj k₂` with the same composite to `S`, the local evaluation of the descent
morphism of `E` at `a₁` and `a₂`. -/
private def dApp ⦃T : C⦄ ⦃k₁ k₂ : κ⦄ ⦃i₁ : (dObj E k₁).ι⦄ ⦃i₂ : (dObj E k₂).ι⦄
    (a₁ : T ⟶ (dObj E k₁).X i₁) (a₂ : T ⟶ (dObj E k₂).X i₂)
    (h : a₁ ≫ (dObj E k₁).f i₁ ≫ f k₁ = a₂ ≫ (dObj E k₂).f i₂ ≫ f k₂) :
    (F.map a₁.op.toLoc).toFunctor.obj ((dObj E k₁).D.obj i₁) ⟶
      (F.map a₂.op.toLoc).toFunctor.obj ((dObj E k₂).D.obj i₂) :=
  pullApp (dHom E (a₁ ≫ (dObj E k₁).f i₁ ≫ f k₁) (a₁ ≫ (dObj E k₁).f i₁)
      (a₂ ≫ (dObj E k₂).f i₂) (Category.assoc _ _ _) (by rw [Category.assoc, h]))
    a₁ a₂ (𝟙 T) (Category.id_comp _).symm (Category.id_comp _).symm

/-- The local evaluations of the descent morphisms of `E` are the morphisms `dApp`. -/
private lemma pullApp_dHom ⦃Y : C⦄ (q : Y ⟶ S) ⦃k₁ k₂ : κ⦄ (f₁ : Y ⟶ V k₁) (f₂ : Y ⟶ V k₂)
    (hf₁ : f₁ ≫ f k₁ = q) (hf₂ : f₂ ≫ f k₂ = q) ⦃T : C⦄ ⦃i₁ : (dObj E k₁).ι⦄
    ⦃i₂ : (dObj E k₂).ι⦄ (a₁ : T ⟶ (dObj E k₁).X i₁) (a₂ : T ⟶ (dObj E k₂).X i₂) (h : T ⟶ Y)
    (ha₁ : a₁ ≫ (dObj E k₁).f i₁ = h ≫ f₁) (ha₂ : a₂ ≫ (dObj E k₂).f i₂ = h ≫ f₂) :
    pullApp (dHom E q f₁ f₂ hf₁ hf₂) a₁ a₂ h ha₁ ha₂ =
      dApp E a₁ a₂ (by rw [reassoc_of% ha₁, reassoc_of% ha₂, hf₁, hf₂]) := by
  have key : dHom E (h ≫ q) (h ≫ f₁) (h ≫ f₂) (by rw [Category.assoc, hf₁])
      (by rw [Category.assoc, hf₂]) = (pullFunctorComp J F f₁ h (h ≫ f₁) rfl).hom.app _ ≫
        (pullFunctor J F h).map (dHom E q f₁ f₂ hf₁ hf₂) ≫
          (pullFunctorComp J F f₂ h (h ≫ f₂) rfl).inv.app _ :=
    (E.pullHom_hom h q (h ≫ q) rfl f₁ f₂ hf₁ hf₂ (h ≫ f₁) (h ≫ f₂) rfl rfl).symm.trans
      (stackification_pullHom J F _ _ _ _ rfl rfl)
  rw [pullApp_congr _ _ _ h (𝟙 _ ≫ h) _ _ (Category.id_comp h).symm,
    ← pullApp_pullHom h (h ≫ f₁) (h ≫ f₂) rfl rfl (dHom E q f₁ f₂ hf₁ hf₂) a₁ a₂ (𝟙 _)
      (by rw [ha₁, Category.id_comp]) (by rw [ha₂, Category.id_comp]), ← key, dApp]
  exact dHom_congr E _ _ _ _ _ _ _ _ (by rw [reassoc_of% ha₁, hf₁]) ha₁.symm ha₂.symm _ _ _ _ _

private lemma pullHom_dApp ⦃T : C⦄ ⦃k₁ k₂ : κ⦄ ⦃i₁ : (dObj E k₁).ι⦄ ⦃i₂ : (dObj E k₂).ι⦄
    (a₁ : T ⟶ (dObj E k₁).X i₁) (a₂ : T ⟶ (dObj E k₂).X i₂)
    (h : a₁ ≫ (dObj E k₁).f i₁ ≫ f k₁ = a₂ ≫ (dObj E k₂).f i₂ ≫ f k₂) ⦃T' : C⦄ (g : T' ⟶ T)
    (ga₁ : T' ⟶ (dObj E k₁).X i₁) (ga₂ : T' ⟶ (dObj E k₂).X i₂) (hga₁ : g ≫ a₁ = ga₁)
    (hga₂ : g ≫ a₂ = ga₂) :
    pullHom (dApp E a₁ a₂ h) g ga₁ ga₂ hga₁ hga₂ =
      dApp E ga₁ ga₂ (by rw [← hga₁, ← hga₂, Category.assoc, h, Category.assoc]) := by
  rw [dApp, pullHom_pullApp _ _ _ _ _ _ g ga₁ ga₂ g hga₁ hga₂ (Category.comp_id g), pullApp_dHom]

@[reassoc]
private lemma dApp_comp ⦃T : C⦄ ⦃k₁ k₂ k₃ : κ⦄ ⦃i₁ : (dObj E k₁).ι⦄ ⦃i₂ : (dObj E k₂).ι⦄
    ⦃i₃ : (dObj E k₃).ι⦄ (a₁ : T ⟶ (dObj E k₁).X i₁) (a₂ : T ⟶ (dObj E k₂).X i₂)
    (a₃ : T ⟶ (dObj E k₃).X i₃) (h₁₂ : a₁ ≫ (dObj E k₁).f i₁ ≫ f k₁ = a₂ ≫ (dObj E k₂).f i₂ ≫ f k₂)
    (h₂₃ : a₂ ≫ (dObj E k₂).f i₂ ≫ f k₂ = a₃ ≫ (dObj E k₃).f i₃ ≫ f k₃) :
    dApp E a₁ a₂ h₁₂ ≫ dApp E a₂ a₃ h₂₃ = dApp E a₁ a₃ (h₁₂.trans h₂₃) := by
  rw [dApp, dApp, dApp, dHom_congr E (a₂ ≫ (dObj E k₂).f i₂ ≫ f k₂) (a₁ ≫ (dObj E k₁).f i₁ ≫ f k₁)
    _ _ _ _ _ _ h₁₂.symm rfl rfl, ← pullApp_comp]
  rw [dHom_comp]

private lemma dApp_self ⦃T : C⦄ ⦃k : κ⦄ ⦃i i' : (dObj E k).ι⦄ (a : T ⟶ (dObj E k).X i)
    (a' : T ⟶ (dObj E k).X i') (h : a ≫ (dObj E k).f i = a' ≫ (dObj E k).f i') :
    dApp E a a' (by rw [reassoc_of% h]) =
      (dObj E k).D.hom (a ≫ (dObj E k).f i) a a' rfl h.symm := by
  rw [dApp, dHom_congr E _ _ _ _ _ (a ≫ (dObj E k).f i) _ _ rfl rfl h.symm, dHom_self,
    pullApp_id]
  exact (dObj E k).D.hom_congr _ _ _ _ _ _ (Category.id_comp _)

variable (hf : Sieve.ofArrows V f ∈ J S)

/-- The descent datum for `F` along `w`-small covering families of `S` glued from a descent datum
`E` for the stackification along a `w`-small covering family: its covering family is formed by the
composites of the covering families of the objects of `E` with the family `f`. -/
private abbrev glued : Obj.{w} J F S where
  ι := Σ k, (dObj E k).ι
  X p := (dObj E p.1).X p.2
  f p := (dObj E p.1).f p.2 ≫ f p.1
  mem := by
    rw [Sieve.ofArrows, ← Presieve.bindOfArrows_ofArrows f fun k i ↦ (dObj E k).f i]
    exact J.bindOfArrows hf fun k ↦ (dObj E k).mem
  D :=
    { obj p := (dObj E p.1).D.obj p.2
      hom _ _ _ _ a₁ a₂ h₁ h₂ := dApp E a₁ a₂ (h₁.trans h₂.symm)
      pullHom_hom _ _ g _ _ _ _ _ a₁ a₂ _ _ ga₁ ga₂ hga₁ hga₂ :=
        pullHom_dApp E _ _ _ g _ _ hga₁ hga₂
      hom_self _ _ _ a _ := by
        rw [dApp_self E a a rfl, DescentData.hom_self _ _ _ rfl]
      hom_comp _ _ _ _ _ a₁ a₂ a₃ _ _ _ := dApp_comp E _ _ _ _ _ }

private lemma glued_D_hom ⦃T : C⦄ (q : T ⟶ S) ⦃p₁ p₂ : (glued E hf).ι⦄ (a₁ : T ⟶ (glued E hf).X p₁)
    (a₂ : T ⟶ (glued E hf).X p₂) (h₁ : a₁ ≫ (glued E hf).f p₁ = q)
    (h₂ : a₂ ≫ (glued E hf).f p₂ = q) :
    (glued E hf).D.hom q a₁ a₂ h₁ h₂ = dApp E a₁ a₂ (h₁.trans h₂.symm) :=
  rfl

/-- The comparison morphism `(f k)^* (glued E) ⟶ 𝟙^* (E.obj k)`. -/
private def toDObj (k : κ) : pullObj (f k) (glued E hf) ⟶ pullObj (𝟙 (V k)) (dObj E k) :=
  ofPullApp (fun _ _ j a b h ha hb ↦ dApp E a b (ha.trans
      (show h ≫ f k = b ≫ (dObj E k).f j ≫ f k by rw [reassoc_of% hb])))
    (fun _ _ _ a b _ _ _ _ g ↦ pullHom_dApp E a b _ g _ _ rfl rfl)
    (fun _ _ _ _ _ a a' b b' h ha ha' hb hb' ↦ by
      rw [glued_D_hom, dApp_comp, (dObj E k).D.hom_congr _ (b ≫ (dObj E k).f _) _ _ _ _ hb.symm,
        ← dApp_self E b b' (hb.trans hb'.symm), dApp_comp])

/-- The comparison morphism `𝟙^* (E.obj k) ⟶ (f k)^* (glued E)`. -/
private def ofDObj (k : κ) : pullObj (𝟙 (V k)) (dObj E k) ⟶ pullObj (f k) (glued E hf) :=
  ofPullApp (fun _ j _ b a h hb ha ↦ dApp E b a
      ((show b ≫ (dObj E k).f j ≫ f k = h ≫ f k by rw [reassoc_of% hb]).trans ha.symm))
    (fun _ _ _ b a _ _ _ _ g ↦ pullHom_dApp E b a _ g _ _ rfl rfl)
    (fun _ _ _ _ _ b b' a a' h hb hb' ha ha' ↦ by
      rw [(dObj E k).D.hom_congr _ (b ≫ (dObj E k).f _) _ _ _ _ hb.symm,
        ← dApp_self E b b' (hb.trans hb'.symm), dApp_comp, glued_D_hom, dApp_comp])

private lemma toDObj_comp_ofDObj (k : κ) : toDObj E hf k ≫ ofDObj E hf k = 𝟙 _ :=
  pullApp_ext _ (dObj E k).mem fun T p p' a a' h ha ha' hh ↦ by
    obtain ⟨j, b, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hh
    rw [pullApp_comp _ _ a b a' _ ha (Category.comp_id _).symm ha', toDObj, ofDObj,
      pullApp_ofPullApp, pullApp_ofPullApp, dApp_comp, pullApp_id, glued_D_hom]

private lemma ofDObj_comp_toDObj (k : κ) : ofDObj E hf k ≫ toDObj E hf k = 𝟙 _ :=
  pullApp_ext _ (J.pullback_stable (f k) (glued E hf).mem) fun T j j' b b' h hb hb' hh ↦ by
    obtain ⟨p, a, ha⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hh
    rw [pullApp_comp _ _ b a b' _ hb ha.symm hb', toDObj, ofDObj, pullApp_ofPullApp,
      pullApp_ofPullApp, dApp_comp, pullApp_id,
      (dObj E k).D.hom_congr _ (b ≫ (dObj E k).f _) _ _ _ _ hb.symm,
      ← dApp_self E b b' (hb.trans hb'.symm)]

/-- The comparison isomorphism between the pullback of the glued descent datum to `V k` and the
object `E.obj k` of the descent datum. -/
private def gluedIso (k : κ) : pullObj (f k) (glued E hf) ≅ dObj E k where
  hom := toDObj E hf k ≫ (pullFunctorId J F (V k)).hom.app (dObj E k)
  inv := (pullFunctorId J F (V k)).inv.app (dObj E k) ≫ ofDObj E hf k
  hom_inv_id := by rw [Category.assoc, Iso.hom_inv_id_app_assoc, toDObj_comp_ofDObj]
  inv_hom_id := by
    rw [Category.assoc, reassoc_of% (ofDObj_comp_toDObj E hf k), Iso.inv_hom_id_app]
    rfl

private lemma app_gluedIso_hom (k : κ) ⦃T : C⦄ ⦃p : (glued E hf).ι⦄ ⦃j : (dObj E k).ι⦄
    (x : T ⟶ pullback ((glued E hf).f p) (f k)) (b : T ⟶ (dObj E k).X j)
    (w : x ≫ pullback.snd _ _ = b ≫ (dObj E k).f j) :
    Hom.app (gluedIso E hf k).hom x b w = (pullObjIso (f k) (glued E hf) x _ rfl).hom ≫
      dApp E (x ≫ pullback.fst _ _) b (by
        rw [Category.assoc, ← reassoc_of% w]
        exact x ≫= pullback.condition) := by
  -- `gluedIso` is unfolded to its composite, with the middle object written as `pullObj`.
  change Hom.app (A := pullObj (f k) (glued E hf)) (B := dObj E k)
    (CategoryStruct.comp (Y := pullObj (𝟙 (V k)) (dObj E k)) (toDObj E hf k)
      ((pullFunctorId J F (V k)).hom.app (dObj E k))) x b w = _
  rw [comp_app (A := pullObj (f k) (glued E hf)) (B := pullObj (𝟙 (V k)) (dObj E k))
      (E := dObj E k) (toDObj E hf k) ((pullFunctorId J F (V k)).hom.app (dObj E k)) x
      (pullback.lift b (b ≫ (dObj E k).f j) (by simp)) b w (by simp [w]) (by simp),
    app_eq_pullApp _ x _ (by simp [w]) (x ≫ pullback.fst _ _) b rfl (by simp), toDObj,
    pullApp_ofPullApp, app_pullFunctorId_hom_app (V k) (dObj E k) _ b (by simp) b (by simp),
    DescentData.hom_self _ _ _ rfl]
  simp only [Category.comp_id, Category.assoc, Iso.inv_hom_id]

private lemma gluedIso_comm ⦃Y : C⦄ (q : Y ⟶ S) ⦃k₁ k₂ : κ⦄ (f₁ : Y ⟶ V k₁) (f₂ : Y ⟶ V k₂)
    (hf₁ : f₁ ≫ f k₁ = q) (hf₂ : f₂ ≫ f k₂ = q) :
    (pullFunctor J F f₁).map (gluedIso E hf k₁).hom ≫ dHom E q f₁ f₂ hf₁ hf₂ =
      ((pullFunctorComp J F (f k₁) f₁ q hf₁).inv.app (glued E hf) ≫
        (pullFunctorComp J F (f k₂) f₂ q hf₂).hom.app (glued E hf)) ≫
        (pullFunctor J F f₂).map (gluedIso E hf k₂).hom := by
  refine pullApp_ext (t := f₁) (A := pullObj (f k₁) (glued E hf)) (s := f₂) (B := dObj E k₂) _
    (J.pullback_stable f₁ (dObj E k₁).mem) fun T p j₂ x b₂ h hx hb₂ hh ↦ ?_
  obtain ⟨j₁, b₁, hb₁⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hh
  have hc : (x ≫ pullback.fst _ _) ≫ (glued E hf).f p = h ≫ q := by
    rw [Category.assoc, pullback.condition, reassoc_of% hx, hf₁]
  have hy : (x ≫ pullback.fst _ _) ≫ (glued E hf).f p = (h ≫ f₂) ≫ f k₂ := by
    rw [hc, Category.assoc, hf₂]
  rw [pullApp_comp _ _ x b₁ b₂ h hx hb₁.symm hb₂, pullApp_map, app_gluedIso_hom, pullApp_dHom,
    Category.assoc (pullObjIso (f k₁) (glued E hf) x _ rfl).hom, dApp_comp,
    Category.assoc ((pullFunctorComp J F (f k₁) f₁ q hf₁).inv.app (glued E hf)),
    pullApp_comp _ _ x (x ≫ pullback.fst _ _) b₂ h hx hc hb₂,
    pullApp_comp _ _ (x ≫ pullback.fst _ _) (pullback.lift _ _ hy) b₂ h hc (by simp) hb₂,
    pullApp_pullFunctorComp_inv_app, pullApp_pullFunctorComp_hom_app, pullApp_map,
    app_gluedIso_hom]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  rw [dApp_comp_assoc, dApp_comp]

variable (f) in
include hf in
/-- Descent data for the stackification along a `w`-small covering family are effective. -/
private lemma essSurj_toDescentData : ((stackification.{w} J F).toDescentData f).EssSurj where
  mem_essImage E := ⟨glued E hf, ⟨DescentData.isoMk (fun k ↦ gluedIso E hf k)
    fun Y q k₁ k₂ f₁ f₂ hf₁ hf₂ ↦ by
      refine (gluedIso_comm E hf q f₁ f₂ hf₁ hf₂).trans (congrArg (· ≫ _) ?_)
      exact congrArg₂ (· ≫ ·)
        (stackification_mapComp'_inv_toNatTrans_app J F (f k₁).op.toLoc f₁.op.toLoc q.op.toLoc
          (by rw [← hf₁]; rfl) (glued E hf)).symm
        (stackification_mapComp'_hom_toNatTrans_app J F (f k₂).op.toLoc f₂.op.toLoc q.op.toLoc
          (by rw [← hf₂]; rfl) (glued E hf)).symm⟩⟩

end descent

end TauCeti.Stack.Stackification.Obj

namespace TauCeti.Stack

open Stackification Obj

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}) [HasPullbacks C] [F.IsPrestack J]

/-- The stackification of a prestack is a prestack: morphisms of descent data along `w`-small
covering families glue along covering sieves. This needs no assumption on the topology. -/
instance isPrestack_stackification : (stackification.{w} J F).IsPrestack J :=
  IsPrestack.of_isPrestackFor fun U R hR ↦ by
    rw [isPrestackFor_iff_isSheafFor]
    intro A B x hx
    have mem {T : C} (g : T ⟶ U) (hg : R g) :
        ((Sieve.overEquiv (Over.mk (𝟙 U))).symm R).arrows
          (Over.homMk g : Over.mk g ⟶ Over.mk (𝟙 U)) := by
      rw [Sieve.overEquiv_symm_iff]
      exact hg
    let φ : ∀ ⦃T : C⦄ (g : T ⟶ U), R g → (pullObj g A ⟶ pullObj g B) :=
      fun T g hg ↦ x _ (mem g hg)
    have hφ : IsCompatibleFamily φ := fun T g hg T' r ↦
      (hx.to_sieveCompatible (Over.homMk g : Over.mk g ⟶ Over.mk (𝟙 U))
        (Over.homMk r : Over.mk (r ≫ g) ⟶ Over.mk g) (mem g hg)).trans
        (stackification_pullHom J F _ r _ _ rfl rfl)
    refine ⟨(stackification J F).presheafHomObjHomEquiv (glue hR hφ), fun Y f hf ↦ ?_,
      fun y hy ↦ ?_⟩
    · refine (presheafHom_map_presheafHomObjHomEquiv _ _ f).trans ?_
      obtain ⟨Y, g, rfl⟩ := Over.mk_surjective Y
      obtain rfl : f = Over.homMk g := by ext; simpa using Over.w f
      exact pullFunctor_map_glue hR hφ g hf
    · obtain ⟨ψ, rfl⟩ := (stackification J F).presheafHomObjHomEquiv.surjective y
      congr 1
      refine hom_ext_of_pullFunctor_map hR fun T g hg ↦ ?_
      rw [pullFunctor_map_glue hR hφ g hg]
      exact (presheafHom_map_presheafHomObjHomEquiv _ _ _).symm.trans (hy _ (mem g hg))

/-- **The stackification of a prestack is a stack** (Stacks, Lemma 02ZN): if every covering sieve
of `J` contains a covering sieve generated by a family indexed by a type in `Type w`, then the
pseudofunctor `stackification J F` obtained by adjoining descent data along `w`-small covering
families is a stack for `J`. -/
theorem isStack_stackification
    (hJ : ∀ ⦃U : C⦄, ∀ R ∈ J U, ∃ (ι : Type w) (X : ι → C) (f : ∀ i, X i ⟶ U),
      Sieve.ofArrows X f ∈ J U ∧ Sieve.ofArrows X f ≤ R) :
    (stackification.{w} J F).IsStack J where
  toIsPrestack := inferInstance
  essSurj_of_sieve {U} R hR := by
    obtain ⟨ι, X, f, hf, hle⟩ := hJ R hR
    have hF : (stackification.{w} J F).IsStackFor (Presieve.ofArrows X f) := by
      rw [isStackFor_ofArrows_iff]
      have := essSurj_toDescentData (J := J) (F := F) f hf
      have := ((stackification.{w} J F).fullyFaithfulToDescentData f hf).full
      have := ((stackification.{w} J F).fullyFaithfulToDescentData f hf).faithful
      exact { }
    exact (hF.of_le _ hf fun Y g hg ↦ hle _ ⟨_, 𝟙 _, g, hg, Category.id_comp _⟩).essSurj

end TauCeti.Stack

