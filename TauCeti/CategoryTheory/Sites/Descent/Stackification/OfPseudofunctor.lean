module

public import TauCeti.CategoryTheory.Sites.Descent.Stackification.Prestackification
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.IsStack
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.StrongTrans
public import TauCeti.CategoryTheory.Sites.Descent.LocallyEssSurj

/-!
# Stackification of an arbitrary pseudofunctor

The associated stack of a category-valued pseudofunctor is obtained in two steps: sheafify its
presheaves of morphisms, then adjoin descent objects. The first step is
`Prestackification.prestackification`; the second is the prestack construction
`TauCeti.Stack.stackification`. Their composite is `stackificationOfPseudofunctor`, with unit
`toStackificationOfPseudofunctor`. No prestack or groupoid hypothesis is imposed on the source.

When every covering sieve contains a covering sieve generated by a `w`-small family, the result
is a stack. Every object is locally isomorphic to an image of the unit, and the Hom presheaf
between two images is the sheafification of the original Hom presheaf. These properties also
hold without the small-cover hypothesis, except for the stack property itself.

The unit and the Hom comparison are stated with the same universe bounds as
`TauCeti.Stack.toStackification`. In particular, they apply to a site with objects in
`Type (u + 1)`, arrows in `Type u`, and fibres in `Cat.{u, u + 1}`, by taking `w = u`.
Sheafification and its local-bijection characterization are assumed on the slice sites in the
universe of the fibre morphisms.

## References

* [Stacks Project, Section 8.8](https://stacks.math.columbia.edu/tag/02ZM)
* [Stacks Project, Lemma 8.8.1](https://stacks.math.columbia.edu/tag/02ZN)
-/

public section

noncomputable section

universe w v' u' v u

open CategoryTheory Limits Opposite Bicategory Pseudofunctor LocallyDiscreteOpToCat
open scoped Pseudofunctor.StrongTrans

namespace TauCeti.Stack

open Prestackification Stackification.Obj

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) [HasPullbacks C]

/-- The associated stack construction for an arbitrary pseudofunctor: Hom-sheafification
followed by adjoining descent objects along `w`-small covering families. The result is a stack
when these families generate the topology (`isStack_stackificationOfPseudofunctor`). -/
abbrev stackificationOfPseudofunctor (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'})
    [∀ U : C, HasSheafify (J.over U) (Type v')]
    [∀ U : C, (J.over U).WEqualsLocallyBijective (Type v')] :
    LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{max w v', max (w + 1) u v v' u'} :=
  stackification.{w} J (prestackification J F)

/-- The associated stack construction is a stack if covering sieves admit refinements by
`w`-small covering families. -/
theorem isStack_stackificationOfPseudofunctor (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'})
    [∀ U : C, HasSheafify (J.over U) (Type v')]
    [∀ U : C, (J.over U).WEqualsLocallyBijective (Type v')]
    (hJ : ∀ ⦃U : C⦄, ∀ R ∈ J U, ∃ (ι : Type w) (X : ι → C) (f : ∀ i, X i ⟶ U),
      Sieve.ofArrows X f ∈ J U ∧ Sieve.ofArrows X f ≤ R) :
    (stackificationOfPseudofunctor.{w} J F).IsStack J :=
  isStack_stackification J (prestackification J F) hJ

variable (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{max w v', max (w + 1) u v v' u'})
  [∀ U : C, HasSheafify (J.over U) (Type (max w v'))]
  [∀ U : C, (J.over U).WEqualsLocallyBijective (Type (max w v'))]

/-- The unit of the associated stack construction, obtained by composing the units of
Hom-sheafification and of the prestack stackification. -/
-- Expose the composite so the dependent Hom comparison can use the fibrewise objects
-- of the two units. Computation rules for these components are given below.
@[expose] def toStackificationOfPseudofunctor : F ⟶ stackificationOfPseudofunctor.{w} J F :=
  toPrestackification J F ≫ toStackification.{w, v', u'} J (prestackification J F)

/-- On each fibre, the unit first sheafifies morphisms and then embeds objects as descent data
along the identity cover. -/
@[simp]
lemma toStackificationOfPseudofunctor_app_toFunctor (a : LocallyDiscrete Cᵒᵖ) :
    ((toStackificationOfPseudofunctor.{w, v', u'} J F).app a).toFunctor =
      toFiber J F a.as.unop ⋙ toObjFunctor.{w} J (prestackification J F) a.as.unop := (rfl)

/-- Every object of the associated stack is locally isomorphic to the image of an object of
the original pseudofunctor. No small-cover hypothesis is needed for this assertion. -/
instance isLocallyEssSurj_toStackificationOfPseudofunctor :
    (toStackificationOfPseudofunctor.{w, v', u'} J F).IsLocallyEssSurj J where
  exists_covering_lift A := by
    obtain ⟨R, hR, h⟩ := stackification_locally_essSurj.{w} J (prestackification J F) A
    refine ⟨R, hR, fun V g hg ↦ ?_⟩
    obtain ⟨M, ⟨e⟩⟩ := h g hg
    -- Hom-sheafification keeps the objects: only its morphisms have changed.
    exact ⟨Fiber.obj (J := J) (F := F) M, ⟨e.symm⟩⟩

/-- The Hom presheaf between the images of two objects in the associated stack is the
sheafification, on the slice site, of their original Hom presheaf. -/
def stackificationOfPseudofunctorPresheafHomIso {U : C} (M N : F.obj (.mk (op U))) :
    sheafify (J.over U) (F.presheafHom M N) ≅
      (stackificationOfPseudofunctor.{w} J F).presheafHom
        (((toStackificationOfPseudofunctor.{w, v', u'} J F).app (.mk (op U))).toFunctor.obj M)
        (((toStackificationOfPseudofunctor.{w, v', u'} J F).app (.mk (op U))).toFunctor.obj N) :=
  prestackificationPresheafHomIso J F M N ≪≫
    (toStackification.{w, v', u'} J (prestackification J F)).presheafHomIsoOfFullyFaithful
      (fun V ↦ fullyFaithfulToObjFunctor.{w} J (prestackification J F) V)
      (Fiber.mk (J := J) (F := F) M) (Fiber.mk (J := J) (F := F) N)

/-- On any sheafified section, the Hom comparison applies the fully faithful embedding of
the Hom-sheafification, conjugated by its pullback comparisons. -/
@[simp]
lemma stackificationOfPseudofunctorPresheafHomIso_hom_app_apply {U : C}
    (M N : F.obj (.mk (op U))) (T : (Over U)ᵒᵖ)
    (s : (sheafify (J.over U) (F.presheafHom M N)).obj T) :
    dsimp% (stackificationOfPseudofunctorPresheafHomIso.{w, v', u'} J F M N).hom.app T s =
      (toStackification.{w, v', u'} J (prestackification J F)).mapPullHom
        (sheafifyPresheafHomEquiv J M N T.unop s) := by
  -- The composite unit and the composite isomorphism have the same intermediate objects by
  -- definition; making the intermediate section explicit lets the component lemmas apply.
  calc
    _ = ((toStackification.{w, v', u'} J (prestackification J F)).presheafHomIsoOfFullyFaithful
        (fun V ↦ fullyFaithfulToObjFunctor.{w} J (prestackification J F) V)
        (Fiber.mk (J := J) (F := F) M) (Fiber.mk (J := J) (F := F) N)).hom.app T
          ((prestackificationPresheafHomIso J F M N).hom.app T s) := (rfl)
    _ = _ :=
      (StrongTrans.presheafHomIsoOfFullyFaithful_hom_app_apply
          (toStackification.{w, v', u'} J (prestackification J F))
          (fun V ↦ fullyFaithfulToObjFunctor.{w} J (prestackification J F) V)
          (Fiber.mk (J := J) (F := F) M) (Fiber.mk (J := J) (F := F) N) T _).trans
        (congrArg (fun φ ↦ (toStackification.{w, v', u'} J (prestackification J F)).mapPullHom φ)
          (prestackificationPresheafHomIso_hom_app_apply J F M N T s))

/-- The Hom comparison sends the sheafification of an original local morphism to its image
under the composite unit. -/
lemma stackificationOfPseudofunctorPresheafHomIso_toSheafify {U : C}
    (M N : F.obj (.mk (op U))) (T : (Over U)ᵒᵖ) (φ : (F.presheafHom M N).obj T) :
    (stackificationOfPseudofunctorPresheafHomIso.{w, v', u'} J F M N).hom.app T
        ((toSheafify (J.over U) (F.presheafHom M N)).app T φ) =
      (toStackificationOfPseudofunctor.{w, v', u'} J F).mapPullHom φ := by
  rw [stackificationOfPseudofunctorPresheafHomIso_hom_app_apply,
    sheafifyPresheafHomEquiv_toSheafify]
  simp only [toStackificationOfPseudofunctor, StrongTrans.comp_mapPullHom]
  congr 1
  -- The naturality isomorphisms of `toPrestackification` are identities, and its component is
  -- `toFiber`. The objects wrapped by these identities agree only definitionally.
  simp only [StrongTrans.mapPullHom_def,
    toPrestackification_naturality_inv_toNatTrans_app,
    toPrestackification_naturality_hom_toNatTrans_app]
  exact ((Category.id_comp ((toFiber J F T.unop.left).map φ ≫ 𝟙 _)).trans
    (Category.comp_id ((toFiber J F T.unop.left).map φ))).symm

end TauCeti.Stack
