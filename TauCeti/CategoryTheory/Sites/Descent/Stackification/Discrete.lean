module

public import Mathlib.CategoryTheory.IsomorphismClasses
public import Mathlib.CategoryTheory.Sites.ConcreteSheafification
public import TauCeti.CategoryTheory.Sites.Descent.Discrete
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.Unit

/-!
# Descent data for the discrete pseudofunctor of a presheaf

Let `P` be a presheaf of types on a category `C` with pullbacks and a Grothendieck topology `J`.
The fibres `Obj J (ofPresheaf P) U` of the stackification construction, applied to the discrete
pseudofunctor of `P`, consist of descent data along `w`-small covering families of `U`. Such a
descent datum `A` is a family of elements `A.elem i` of `P` over the members of the covering
family which agree on overlaps (`Obj.map_elem_eq`); these are read off with
`Pseudofunctor.ofPresheaf.descentDataEquiv`, and conversely such a family defines a descent datum
through `Obj.ofDescentData` and the inverse of that equivalence (`Obj.elem_ofDescentData`). A
morphism `A ⟶ B` exists exactly when the elements of `A` and of `B` agree on overlaps
(`Obj.nonempty_hom_iff`); there is at most one (`Obj.instSubsingletonHom`).

A descent datum defines a matching family of `P` on the covering sieve generated by its
covering family, hence an element `Obj.toPlusObj A` of Mathlib's plus construction
`(J.plusObj P).obj (op U)`. When `P` is separated, that is, when the discrete pseudofunctor is a
prestack (`Pseudofunctor.isPrestack_ofPresheaf_iff`), the fibre `Obj J (ofPresheaf P) U` is a
thin category, and `Obj.toPlusObj` identifies its isomorphism classes with
`(J.plusObj P).obj (op U)` provided every covering sieve of `J` contains a covering sieve
generated by a `w`-small family (`Obj.isoClassesEquivPlusObj`); this holds for `w = max u v`
(Mathlib's `Sieve.exists_eq_ofArrows`). For separated `P`, the plus construction `J.plusObj P` is
already a sheaf (Mathlib's `GrothendieckTopology.Plus.isSheaf_of_sep`), so the fibres are, up to
isomorphism, the sections of the sheafification of `P`. This is the fibrewise part of the
comparison of the stackification of `ofPresheaf P` with Mathlib's `presheafToSheaf` (Stacks,
Section 02ZM).

## Main declarations

* `TauCeti.Stack.Stackification.Obj.elem`: the elements of `P` underlying a descent datum.
* `TauCeti.Stack.Stackification.Obj.toPlusObj`: the element of the plus construction given by a
  descent datum.
* `TauCeti.Stack.Stackification.Obj.isoClassesEquivPlusObj`: for separated `P`, isomorphism
  classes of descent data are elements of the plus construction.

## References

* [Stacks Project, Section 02ZM](https://stacks.math.columbia.edu/tag/02ZM)
-/

public section

noncomputable section

universe w w' w'' v u

open CategoryTheory Limits Opposite Bicategory Pseudofunctor Pseudofunctor.ofPresheaf
  GrothendieckTopology

namespace TauCeti.Stack.Stackification.Obj

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {U : C}

section

variable {P : Cᵒᵖ ⥤ Type w''}

/-- The element of `P` over the `i`-th member of the covering family of a descent datum for the
discrete pseudofunctor of `P`. -/
def elem (A : Obj.{w} J (ofPresheaf.{w'} P) U) (i : A.ι) : P.obj (op (A.X i)) :=
  (descentDataEquiv A.f A.D).val i

/-- The elements underlying a descent datum for the discrete pseudofunctor agree on overlaps. -/
lemma map_elem_eq (A : Obj.{w} J (ofPresheaf.{w'} P) U) ⦃T : C⦄ ⦃i i' : A.ι⦄ (a : T ⟶ A.X i)
    (a' : T ⟶ A.X i') (h : a ≫ A.f i = a' ≫ A.f i') :
    P.map a.op (A.elem i) = P.map a'.op (A.elem i') :=
  (descentDataEquiv A.f A.D).property _ _ _ a a' h

/-- The element of `P` underlying a descent datum over the `i`-th member of its covering family is
the element given by its `i`-th object. -/
lemma elem_def (A : Obj.{w} J (ofPresheaf.{w'} P) U) (i : A.ι) :
    A.elem i = objEquiv _ (A.D.obj i) :=
  (rfl)

/-- The elements underlying a descent datum along a fixed covering family are given by its
objects. -/
@[simp]
lemma elem_ofDescentData {ι : Type w} {X : ι → C} (f : ∀ i, X i ⟶ U)
    (hf : Sieve.ofArrows X f ∈ J U) (D : (ofPresheaf.{w'} P).DescentData f) (i : ι) :
    (ofDescentData f hf D).elem i = objEquiv _ (D.obj i) :=
  (rfl)

/-- The matching family of `P` on the cover generated by the covering family of a descent datum
for the discrete pseudofunctor, given by its underlying elements. -/
def meq (A : Obj.{w} J (ofPresheaf.{w'} P) U) : Meq P A.cover :=
  ⟨fun I ↦
    have hI : Sieve.ofArrows A.X A.f I.f := A.coe_cover ▸ I.hf
    P.map (Sieve.ofArrows.h hI).op (A.elem (Sieve.ofArrows.i hI)),
    fun I ↦ by
      simp only [← Functor.map_comp_apply, ← op_comp]
      exact A.map_elem_eq _ _ (by simpa only [Category.assoc, Sieve.ofArrows.fac] using I.r.w)⟩

/-- The matching family of a descent datum is computed by any factorization through its covering
family. -/
lemma meq_apply (A : Obj.{w} J (ofPresheaf.{w'} P) U) (I : A.cover.Arrow) {i : A.ι}
    (a : I.Y ⟶ A.X i) (h : a ≫ A.f i = I.f) : A.meq I = P.map a.op (A.elem i) :=
  A.map_elem_eq _ _ (by rw [Sieve.ofArrows.fac, h])

variable [HasPullbacks C]

/-- There is at most one morphism between descent data for the discrete pseudofunctor. -/
instance instSubsingletonHom (A B : Obj.{w} J (ofPresheaf.{w'} P) U) : Subsingleton (Hom A B) :=
  ⟨fun _ _ ↦ Hom.ext (funext fun _ ↦ funext fun _ ↦ Subsingleton.elim _ _)⟩

/-- A morphism between descent data for the discrete pseudofunctor exists exactly when their
underlying elements agree on overlaps. -/
lemma nonempty_hom_iff (A B : Obj.{w} J (ofPresheaf.{w'} P) U) :
    Nonempty (Hom A B) ↔ ∀ ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j),
      a ≫ A.f i = b ≫ B.f j → P.map a.op (A.elem i) = P.map b.op (B.elem j) := by
  refine ⟨fun ⟨φ⟩ T i j a b w ↦ eq_of_hom (X := op T) (φ.app a b w), fun h ↦ ⟨?_⟩⟩
  exact Hom.ofApp (fun T i j a b w ↦ homMk (X := op T) (h a b w))
    (fun _ _ _ _ _ _ _ _ _ _ _ _ ↦ Subsingleton.elim _ _)
    (fun _ _ _ _ _ _ _ _ _ _ _ _ ↦ Subsingleton.elim _ _)

end

variable {P : Cᵒᵖ ⥤ Type (max u v)}

/-- The element of the plus construction `(J.plusObj P).obj (op U)` given by a descent datum for
the discrete pseudofunctor of `P`: the class of its matching family. -/
def toPlusObj (A : Obj.{w} J (ofPresheaf.{w'} P) U) : (J.plusObj P).obj (op U) :=
  Plus.mk A.meq

/-- `toPlusObj A` is the class of the matching family of `A` in the plus construction. -/
lemma toPlusObj_def (A : Obj.{w} J (ofPresheaf.{w'} P) U) : A.toPlusObj = Plus.mk A.meq :=
  (rfl)

/-- Every element of the plus construction is given by a descent datum along a `w`-small covering
family, provided every covering sieve contains a covering sieve generated by a `w`-small
family. -/
theorem toPlusObj_surjective
    (hJ : ∀ S ∈ J U, ∃ (ι : Type w) (X : ι → C) (f : ∀ i, X i ⟶ U),
      Sieve.ofArrows X f ∈ J U ∧ Sieve.ofArrows X f ≤ S) :
    Function.Surjective fun A : Obj.{w} J (ofPresheaf.{w'} P) U ↦ A.toPlusObj := by
  intro x
  obtain ⟨S, y, rfl⟩ := Plus.exists_rep (J := J) (P := P) (X := U) x
  obtain ⟨ι, X, f, hf, hle⟩ := hJ S S.property
  have hy (i : ι) : S (f i) := hle _ (Sieve.ofArrows_mk _ _ i)
  -- `y` restricts along `a : T ⟶ X i` to its value at `a ≫ f i`.
  have key ⦃T : C⦄ (i : ι) (a : T ⟶ X i) :
      P.map a.op (y ⟨X i, f i, hy i⟩) = y ⟨T, a ≫ f i, S.val.downward_closed (hy i) a⟩ := by
    have h : P.map (𝟙 T).op (y ⟨T, a ≫ f i, S.val.downward_closed (hy i) a⟩) =
        P.map a.op (y ⟨X i, f i, hy i⟩) :=
      y.property (.mk' (Cover.Arrow.precompRelation ⟨X i, f i, hy i⟩ a))
    simpa using h.symm
  let A := ofDescentData.{w} (J := J) (F := ofPresheaf.{w'} P) f hf
    ((descentDataEquiv f).symm ⟨fun i ↦ y ⟨X i, f i, hy i⟩, fun i i' T a a' h ↦ by
      rw [key, key]
      exact Meq.congr_apply y h _⟩)
  refine ⟨A, (Plus.eq_mk_iff_exists _ _).2 ⟨A.cover, 𝟙 _,
    homOfLE (Subtype.coe_le_coe.1 (by rw [coe_cover]; exact hle)), Meq.ext _ _ fun I ↦ ?_⟩⟩
  obtain ⟨i, a, ha⟩ := Sieve.ofArrows.exists (A.coe_cover ▸ I.hf)
  simp only [Meq.refine_apply]
  rw [meq_apply A I a ha.symm]
  exact (key i a).trans (Meq.congr_apply y ha.symm _)

variable [HasPullbacks C]

/-- Two descent data for the discrete pseudofunctor of a separated presheaf define the same
element of the plus construction exactly when there is a morphism between them. -/
theorem toPlusObj_eq_toPlusObj_iff (hP : Presieve.IsSeparated J P)
    (A B : Obj.{w} J (ofPresheaf.{w'} P) U) :
    A.toPlusObj = B.toPlusObj ↔ Nonempty (Hom A B) := by
  rw [toPlusObj, toPlusObj, Plus.eq_mk_iff_exists, nonempty_hom_iff]
  constructor
  · rintro ⟨W, h₁, h₂, e⟩ T i j a b w
    refine (hP _ (J.pullback_stable (a ≫ A.f i) W.property)).ext fun T' g hg ↦ ?_
    have := congr_arg (fun x : Meq P W ↦ x ⟨T', g ≫ a ≫ A.f i, hg⟩) e
    simp only [Meq.refine_apply] at this
    rw [meq_apply A _ (g ≫ a) (Category.assoc _ _ _),
      meq_apply B _ (g ≫ b) (by simp [w])] at this
    simpa only [op_comp, Functor.map_comp_apply] using this
  · intro h
    refine ⟨A.cover ⊓ B.cover, homOfLE inf_le_left, homOfLE inf_le_right,
      Meq.ext _ _ fun I ↦ ?_⟩
    obtain ⟨i, a, ha⟩ := Sieve.ofArrows.exists (A.coe_cover ▸ inf_le_left (b := B.cover) _ I.hf)
    obtain ⟨j, b, hb⟩ := Sieve.ofArrows.exists (B.coe_cover ▸ inf_le_right (a := A.cover) _ I.hf)
    rw [Meq.refine_apply, Meq.refine_apply, meq_apply A _ a ha.symm, meq_apply B _ b hb.symm]
    exact h a b (ha.symm.trans hb)

variable [(ofPresheaf.{w'} P).IsPrestack J]

/-- For a separated presheaf `P`, there is at most one morphism between two descent data for the
discrete pseudofunctor of `P`. -/
instance instIsThin : Quiver.IsThin (Obj.{w} J (ofPresheaf.{w'} P) U) :=
  fun A B ↦ inferInstanceAs (Subsingleton (Hom A B))

/-- For a separated presheaf `P`, two descent data for the discrete pseudofunctor of `P` are
isomorphic exactly when they define the same element of the plus construction. -/
theorem toPlusObj_eq_toPlusObj_iff_isIsomorphic (A B : Obj.{w} J (ofPresheaf.{w'} P) U) :
    A.toPlusObj = B.toPlusObj ↔ IsIsomorphic A B := by
  have hP := (isPrestack_ofPresheaf_iff P J).1 inferInstance
  refine ⟨fun h ↦ ?_, fun ⟨e⟩ ↦ (toPlusObj_eq_toPlusObj_iff hP A B).2 ⟨e.hom⟩⟩
  obtain ⟨φ⟩ := (toPlusObj_eq_toPlusObj_iff hP A B).1 h
  obtain ⟨ψ⟩ := (toPlusObj_eq_toPlusObj_iff hP B A).1 h.symm
  exact ⟨⟨φ, ψ, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩

/-- For a separated presheaf `P`, isomorphism classes of descent data along `w`-small covering
families for the discrete pseudofunctor of `P` are the elements of the plus construction
`(J.plusObj P).obj (op U)`, provided every covering sieve contains a covering sieve generated by a
`w`-small family. -/
def isoClassesEquivPlusObj
    (hJ : ∀ S ∈ J U, ∃ (ι : Type w) (X : ι → C) (f : ∀ i, X i ⟶ U),
      Sieve.ofArrows X f ∈ J U ∧ Sieve.ofArrows X f ≤ S) :
    Quotient (isIsomorphicSetoid (Obj.{w} J (ofPresheaf.{w'} P) U)) ≃
      (J.plusObj P).obj (op U) :=
  Equiv.ofBijective
    (Quotient.lift toPlusObj fun A B h ↦ (toPlusObj_eq_toPlusObj_iff_isIsomorphic A B).2 h)
    ⟨fun a b ↦ Quotient.inductionOn₂ a b fun A B h ↦
        Quotient.sound ((toPlusObj_eq_toPlusObj_iff_isIsomorphic A B).1 h),
      fun x ↦ (toPlusObj_surjective hJ x).elim fun A h ↦ ⟨⟦A⟧, h⟩⟩

/-- `isoClassesEquivPlusObj` sends the class of a descent datum to its element of the plus
construction. -/
@[simp]
lemma isoClassesEquivPlusObj_mk
    (hJ : ∀ S ∈ J U, ∃ (ι : Type w) (X : ι → C) (f : ∀ i, X i ⟶ U),
      Sieve.ofArrows X f ∈ J U ∧ Sieve.ofArrows X f ≤ S)
    (A : Obj.{w} J (ofPresheaf.{w'} P) U) :
    isoClassesEquivPlusObj hJ ⟦A⟧ = A.toPlusObj :=
  (rfl)

end TauCeti.Stack.Stackification.Obj

end
