module

public import TauCeti.CategoryTheory.Bicategory.NaturalTransformation.Pseudo
public import TauCeti.CategoryTheory.Category.Cat
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.Unit

/-!
# The unit of the stackification as a strong transformation

For a prestack `F` for a Grothendieck topology `J` on a category with pullbacks, the functors
`Obj.toObjFunctor J F U : F.obj U ⥤ Obj J F U`, which send `M` to the descent datum along the
identity of `U` given by `M`, are pseudonatural in `U`: they form a strong transformation
`TauCeti.Stack.toStackification : F ⟶ stackification J F` into the pseudofunctor of descent data
along `w`-small covering families. When every covering sieve of `J` contains a covering sieve
generated by a `w`-small family, `stackification J F` is the stackification of `F` and this is
its unit (Stacks, Lemma 02ZN); without this hypothesis the target need not be a stack.

Mathlib's `StrongTrans` needs source and target in the same bicategory, so `toStackification` is
stated for `F` valued in the universes of `stackification J F`. This covers the big site of
schemes `Scheme.{u}` with `w = u` and `F` valued in `Cat.{u, u + 1}`. For other universes, such as
`F` valued in `Cat.{u, u}` on a small site with `w = u`, the fibres of `stackification J F` lie in
a larger universe, and packaging the unit needs a universe lift of `F`, which is not done here.
The components, the naturality isomorphisms and their unit and composition conditions are proved
here for arbitrary universes.

The naturality isomorphism at `q : V ⟶ U` identifies the embedding of `q^* M` with the pullback
along `q` of the embedding of `M` (`TauCeti.Stack.toStackificationNatIso`). It is the isomorphism
`Obj.PullbackData.isoOfData` between two identifications of descent data over `V` with pullbacks
along `q`, the canonical one `Obj.pullbackData` and `Obj.toObjPullbackData q M`, whose
identifications are composites of the comparison isomorphisms `F.mapComp'`. The unit and
composition conditions (`TauCeti.Stack.toStackificationNatIso_hom_app_comp_pullFunctorId_hom_app`,
`TauCeti.Stack.toStackificationNatIso_hom_app_comp_pullFunctorComp_hom_app`) reduce, through the
transport rules of `TauCeti.CategoryTheory.Sites.Descent.Stackification.Pseudofunctor`, to the
facts that embedding the unit and composition isomorphisms of `F` transports identities
(`Obj.transport_toObjPullbackData_refl`, `Obj.transport_toObjPullbackData_trans`).

Every descent datum is locally in the image of `toObjFunctor`: the pullback of a descent datum `A`
along a member `A.f i` of its covering family is the embedding of `A.D.obj i`
(`Obj.toObjIsoPullObj`), so there is a covering sieve along every member of which the pullback of
`A` is in the essential image of `toObjFunctor` (`TauCeti.Stack.stackification_locally_essSurj`).
Together with the full faithfulness of `toObjFunctor` (`Obj.fullyFaithfulToObjFunctor`), this is
the part of Stacks, Lemma 02ZN describing the unit. The universal property of the unit with respect
to stacks and the stack property of `stackification J F` are not proved here.

## Main declarations

* `TauCeti.Stack.toStackification`: the strong transformation `F ⟶ stackification J F`, for `F`
  valued in the universes of `stackification J F`.
* `TauCeti.Stack.toStackificationNatIso`: its naturality isomorphisms, for arbitrary universes.
* `TauCeti.Stack.stackification_locally_essSurj`: every descent datum is locally in the image of
  `toObjFunctor`, for arbitrary universes.

## References

* [Stacks Project, Lemma 02ZN](https://stacks.math.columbia.edu/tag/02ZN)
-/

public section

noncomputable section

universe w v' u' v u

open CategoryTheory Limits Opposite Bicategory Pseudofunctor LocallyDiscreteOpToCat

namespace TauCeti.Stack.Stackification.Obj

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}}

/-- The identification of `b^* ((𝟙 V)^* (q^* M))` with `c^* ((𝟙 U)^* M)` for `b ≫ q = c`. -/
def toObjPullbackIso {U V : C} (q : V ⟶ U) (M : F.obj (.mk (op U))) ⦃T : C⦄ (b : T ⟶ V)
    (c : T ⟶ U) (h : b ≫ q = c) :
    (F.map b.op.toLoc).toFunctor.obj
        ((F.map (𝟙 V).op.toLoc).toFunctor.obj ((F.map q.op.toLoc).toFunctor.obj M)) ≅
      (F.map c.op.toLoc).toFunctor.obj ((F.map (𝟙 U).op.toLoc).toFunctor.obj M) :=
  (Cat.Hom.toNatIso (F.mapComp' (𝟙 V).op.toLoc b.op.toLoc b.op.toLoc (by simp))).symm.app _ ≪≫
    (Cat.Hom.toNatIso (F.mapComp' q.op.toLoc b.op.toLoc c.op.toLoc
      (by rw [← h]; rfl))).symm.app M ≪≫
    (Cat.Hom.toNatIso (F.mapComp' (𝟙 U).op.toLoc c.op.toLoc c.op.toLoc (by simp))).app M

lemma toObjPullbackIso_hom {U V : C} (q : V ⟶ U) (M : F.obj (.mk (op U))) ⦃T : C⦄ (b : T ⟶ V)
    (c : T ⟶ U) (h : b ≫ q = c) :
    (toObjPullbackIso q M b c h).hom =
      (F.mapComp' (𝟙 V).op.toLoc b.op.toLoc b.op.toLoc (by simp)).inv.toNatTrans.app _ ≫
      (F.mapComp' q.op.toLoc b.op.toLoc c.op.toLoc (by rw [← h]; rfl)).inv.toNatTrans.app M ≫
      (F.mapComp' (𝟙 U).op.toLoc c.op.toLoc c.op.toLoc (by simp)).hom.toNatTrans.app M :=
  (rfl)

lemma toObjPullbackIso_inv {U V : C} (q : V ⟶ U) (M : F.obj (.mk (op U))) ⦃T : C⦄ (b : T ⟶ V)
    (c : T ⟶ U) (h : b ≫ q = c) :
    (toObjPullbackIso q M b c h).inv =
      (F.mapComp' (𝟙 U).op.toLoc c.op.toLoc c.op.toLoc (by simp)).inv.toNatTrans.app M ≫
      (F.mapComp' q.op.toLoc b.op.toLoc c.op.toLoc (by rw [← h]; rfl)).hom.toNatTrans.app M ≫
      (F.mapComp' (𝟙 V).op.toLoc b.op.toLoc b.op.toLoc (by simp)).hom.toNatTrans.app _ :=
  Category.assoc _ _ _

/-- The identifications `toObjPullbackIso` are natural in `M`. -/
@[reassoc]
lemma toObjPullbackIso_hom_naturality {U V : C} (q : V ⟶ U) {M M' : F.obj (.mk (op U))}
    (φ : M ⟶ M') ⦃T : C⦄ (b : T ⟶ V) (c : T ⟶ U) (h : b ≫ q = c) :
    (F.map b.op.toLoc).toFunctor.map
        ((F.map (𝟙 V).op.toLoc).toFunctor.map ((F.map q.op.toLoc).toFunctor.map φ)) ≫
      (toObjPullbackIso q M' b c h).hom =
    (toObjPullbackIso q M b c h).hom ≫
      (F.map c.op.toLoc).toFunctor.map ((F.map (𝟙 U).op.toLoc).toFunctor.map φ) := by
  rw [toObjPullbackIso_hom, toObjPullbackIso_hom]
  simp only [Category.assoc, mapComp'_inv_naturality_assoc, mapComp'_hom_naturality]

/-- Along the identity, `toObjPullbackIso` is the pullback of the unit isomorphism of `F`. -/
lemma toObjPullbackIso_id_hom {U : C} (M : F.obj (.mk (op U))) ⦃T : C⦄ (b : T ⟶ U) :
    (toObjPullbackIso (𝟙 U) M b b (Category.comp_id b)).hom =
      (F.map b.op.toLoc).toFunctor.map ((F.map (𝟙 U).op.toLoc).toFunctor.map
        ((F.mapId' (𝟙 U).op.toLoc (by simp)).hom.toNatTrans.app M)) := by
  rw [toObjPullbackIso_hom, Cat.Hom.inv_hom_id_toNatTrans_app]
  -- The identity is on `(F.map (𝟙 U ≫ b)).obj M` while the composite ends at
  -- `(F.map (𝟙 U) ≫ F.map b).obj M`; these agree only after unfolding `Cat.Hom.comp`, and `rw`
  -- cannot abstract the dependent motive.
  erw [Category.comp_id]
  have h₁ := F.mapComp'_id_comp_inv_app (b₀ := .mk (op U)) b.op.toLoc
    ((F.map (𝟙 U).op.toLoc).toFunctor.obj M)
  rw [← mapId'_eq_mapId] at h₁
  have h₂ : (F.mapId' (𝟙 U).op.toLoc (by simp)).hom.toNatTrans.app
      ((F.map (𝟙 U).op.toLoc).toFunctor.obj M) = (F.map (𝟙 U).op.toLoc).toFunctor.map
        ((F.mapId' (𝟙 U).op.toLoc (by simp)).hom.toNatTrans.app M) := by
    rw [← cancel_mono ((F.mapId' (𝟙 U).op.toLoc (by simp)).hom.toNatTrans.app M)]
    exact (F.mapId'_hom_naturality _ _ _).symm
  exact h₁.trans ((F.map b.op.toLoc).toFunctor.congr_map h₂)

/-- The identifications `toObjPullbackIso` are compatible with the composition isomorphisms
of `F`. -/
lemma toObjPullbackIso_comp_hom {U V W : C} (q : V ⟶ U) (r : W ⟶ V) (M : F.obj (.mk (op U)))
    ⦃T : C⦄ (b : T ⟶ W) (c : T ⟶ U) (h : b ≫ r ≫ q = c) :
    (F.map b.op.toLoc).toFunctor.map ((F.map (𝟙 W).op.toLoc).toFunctor.map
        ((F.mapComp' q.op.toLoc r.op.toLoc (r ≫ q).op.toLoc rfl).hom.toNatTrans.app M)) ≫
      (toObjPullbackIso r ((F.map q.op.toLoc).toFunctor.obj M) b (b ≫ r) rfl).hom ≫
      (toObjPullbackIso q M (b ≫ r) c (by rw [← h, Category.assoc])).hom =
    (toObjPullbackIso (r ≫ q) M b c h).hom := by
  simp only [toObjPullbackIso_hom, Category.assoc, Cat.Hom.hom_inv_id_toNatTrans_app_assoc]
  -- The naturality square of `mapComp'` is stated for `(F.map _ ≫ F.map _).toFunctor.map`, which
  -- is `Functor.map` of a composite only after unfolding `Cat.Hom.comp`.
  erw [mapComp'_inv_naturality_assoc]
  rw [← F.mapComp'_inv_whiskerRight_mapComp'₀₂₃_inv_app_assoc q.op.toLoc r.op.toLoc b.op.toLoc
    (r ≫ q).op.toLoc (b ≫ r).op.toLoc c.op.toLoc rfl rfl (by rw [← h]; rfl)]
  rw [← Functor.map_comp_assoc, Cat.Hom.hom_inv_id_toNatTrans_app,
    CategoryTheory.Functor.map_id, Category.id_comp]

variable [HasPullbacks C] [F.IsPrestack J]

/-- The descent datum given by `q^* M` over `V` is identified with the pullback along `q` of the
descent datum given by `M` over `U`. -/
def toObjPullbackData {U V : C} (q : V ⟶ U) (M : F.obj (.mk (op U))) :
    PullbackData q ((toObjFunctor.{w} J F U).obj M)
      ((toObjFunctor.{w} J F V).obj ((F.map q.op.toLoc).toFunctor.obj M)) where
  α j := j
  β _ := q
  w _ := by simp
  iso T _ b c h := toObjPullbackIso q M b c h
  pullHom_iso T _ b c h T' g gb gc hgb hgc := by
    rw [toObjPullbackIso_hom, toObjPullbackIso_hom]
    -- `pullHom_comp` and `pullHom_mapComp'_*` are stated for the objects `M₂` and pullback maps of
    -- the descent data, which are `(F.map q).obj M`, `M` and `𝟙` only after unfolding
    -- `toObjFunctor`.
    erw [pullHom_comp (f₂ := b) (M₂ := (F.map q.op.toLoc).toFunctor.obj M) _ _ g gb gb gc hgb
      hgb hgc, pullHom_comp (f₂ := c) (M₂ := M) _ _ g gb gc gc hgb hgc hgc]
    erw [pullHom_mapComp'_inv _ _ _ _ (Category.comp_id b), pullHom_mapComp'_inv _ _ _ _ h,
      pullHom_mapComp'_hom _ _ _ _ (Category.comp_id c)]
    -- The two sides differ only in the proofs of the factorizations.
    rfl
  hom_eq T j j' q' b b' hb hb' c c' h h' := by
    cases j; cases j'
    obtain rfl : b = q' := by simpa using hb
    obtain rfl : b' = b := by simpa using hb'
    obtain rfl : c' = c := h'.symm.trans h
    rw [toObjFunctor_obj_hom_self, toObjFunctor_obj_hom_self, Category.id_comp]
    exact (toObjPullbackIso q M b' c' h).hom_inv_id.symm

open PullbackData

/-- The morphisms `β` of `toObjPullbackData q M` are `q`. -/
@[simp]
lemma toObjPullbackData_β {U V : C} (q : V ⟶ U) (M : F.obj (.mk (op U))) (j) :
    (toObjPullbackData.{w} (J := J) q M).β j = q :=
  (rfl)

/-- The identifications of `toObjPullbackData` are the isomorphisms `toObjPullbackIso`. -/
@[simp]
lemma toObjPullbackData_iso {U V : C} (q : V ⟶ U) (M : F.obj (.mk (op U))) ⦃T : C⦄ ⦃j⦄
    (b : T ⟶ V) (c : T ⟶ U) (h : b ≫ (toObjPullbackData.{w} (J := J) q M).β j = c) :
    (toObjPullbackData.{w} (J := J) q M).iso b c h =
      toObjPullbackIso q M b c (by rwa [toObjPullbackData_β] at h) :=
  (rfl)

/-- Pulling back a morphism along `q` and embedding it is transporting its embedding along
`toObjPullbackData`. -/
lemma toObjFunctor_map_map {U V : C} (q : V ⟶ U) {M M' : F.obj (.mk (op U))} (φ : M ⟶ M') :
    (toObjFunctor.{w} J F V).map ((F.map q.op.toLoc).toFunctor.map φ) =
      transport (toObjPullbackData q M) (toObjPullbackData q M')
        ((toObjFunctor.{w} J F U).map φ) :=
  toObjFunctor_hom_ext fun T b w ↦ by
    rw [app_transport _ _ _ _ _ _ (b ≫ q) (b ≫ q) (by rw [toObjPullbackData_β])
      (by rw [toObjPullbackData_β]), transportApp_def, toObjPullbackData_iso,
      toObjPullbackData_iso, app_toObjFunctor_map_self, app_toObjFunctor_map_self]
    -- The objects of `toObjFunctor` are `(F.map (𝟙 _)).obj _` only up to unfolding, so the
    -- naturality square is applied by unification rather than by rewriting.
    exact ((Iso.eq_comp_inv _).2 (toObjPullbackIso_hom_naturality q φ b (b ≫ q) rfl)).trans
      (Category.assoc _ _ _)

/-- Embedding the unit isomorphism `(𝟙 U)^* M ⟶ M` of `F` is transporting the identity along
`toObjPullbackData (𝟙 U) M` and `PullbackData.refl`. -/
lemma transport_toObjPullbackData_refl {U : C} (M : F.obj (.mk (op U))) :
    transport (toObjPullbackData (𝟙 U) M) (refl _) (𝟙 _) =
      (toObjFunctor.{w} J F U).map ((F.mapId' (𝟙 U).op.toLoc (by simp)).hom.toNatTrans.app M) :=
  toObjFunctor_hom_ext fun T b w ↦ by
    rw [app_transport_refl (toObjPullbackData (𝟙 U) M) (𝟙 _) b b w b
        (by rw [toObjPullbackData_β]; exact Category.comp_id b),
      toObjPullbackData_iso, app_toObjFunctor_map_self, ← toObjPullbackIso_id_hom, id_app,
      toObjFunctor_obj_hom_self]
    -- As in `toObjFunctor_map_map`, the identity is on an object of `toObjFunctor`.
    exact Category.comp_id _

/-- Embedding the composition isomorphism `(r ≫ q)^* M ⟶ r^* (q^* M)` of `F` is transporting the
identity along `toObjPullbackData (r ≫ q) M` and the composite of `toObjPullbackData r (q^* M)` and
`toObjPullbackData q M`. -/
lemma transport_toObjPullbackData_trans {U V W : C} (q : V ⟶ U) (r : W ⟶ V)
    (M : F.obj (.mk (op U))) :
    transport (toObjPullbackData (r ≫ q) M)
        ((toObjPullbackData r ((F.map q.op.toLoc).toFunctor.obj M)).trans
          (toObjPullbackData q M) (r ≫ q) rfl) (𝟙 _) =
      (toObjFunctor.{w} J F W).map
        ((F.mapComp' q.op.toLoc r.op.toLoc (r ≫ q).op.toLoc rfl).hom.toNatTrans.app M) :=
  toObjFunctor_hom_ext fun T b w ↦ by
    rw [app_transport_trans (r ≫ q) rfl (toObjPullbackData (r ≫ q) M)
        (toObjPullbackData r ((F.map q.op.toLoc).toFunctor.obj M)) (toObjPullbackData q M) (𝟙 _)
        b b w (b ≫ r ≫ q) (by simp) (b ≫ r) (by simp) (b ≫ r ≫ q) (by simp),
      toObjPullbackData_iso, toObjPullbackData_iso, toObjPullbackData_iso,
      app_toObjFunctor_map_self, ← toObjPullbackIso_comp_hom q r M b _ rfl, id_app,
      toObjFunctor_obj_hom_self]
    -- The identity is on an object of `toObjFunctor`, which is `(F.map (𝟙 _)).obj _` only up to
    -- unfolding, so the cancellation is applied by unification rather than by `simp`.
    have cancel {D : Type _} [Category D] {X Y Z Z' : D} (x : X ⟶ Y) (a : Y ≅ Z) (b : Z ≅ Z') :
        (x ≫ a.hom ≫ b.hom) ≫ 𝟙 Z' ≫ b.inv ≫ a.inv = x := by
      simp
    exact cancel _ _ _

/-- The pullback of a descent datum `A` along a member `A.f i` of its covering family is
identified with the descent datum along the identity given by `A.D.obj i`. -/
def selfPullbackData {U : C} (A : Obj.{w} J F U) (i : A.ι) :
    PullbackData (A.f i) A ((toObjFunctor.{w} J F (A.X i)).obj (A.D.obj i)) where
  α _ := i
  β _ := 𝟙 _
  w _ := rfl
  iso T _ b c h :=
    (Cat.Hom.toNatIso (F.mapComp' (𝟙 (A.X i)).op.toLoc b.op.toLoc c.op.toLoc
      (by rw [← h]; rfl))).symm.app (A.D.obj i)
  pullHom_iso T _ b c h T' g gb gc hgb hgc := pullHom_mapComp'_inv _ _ _ _ h _ _ _ hgb hgc
  hom_eq T j j' q' b b' hb hb' c c' h h' := by
    cases j; cases j'
    have e₁ : b = q' := by simpa using hb
    have e₂ : b' = q' := by simpa using hb'
    have e₃ : b = c := by simpa using h
    have e₄ : b' = c' := by simpa using h'
    subst e₁ e₃ e₄ e₂
    rw [toObjFunctor_obj_hom_self, DescentData.hom_self _ _ _ rfl, Category.id_comp]
    exact (Iso.hom_inv_id _).symm

/-- The member of the covering family of `A` below the identity of `A.X i` in
`selfPullbackData A i` is `i`. -/
@[simp]
lemma selfPullbackData_α {U : C} (A : Obj.{w} J F U) (i : A.ι) (j) :
    (selfPullbackData A i).α j = i :=
  (rfl)

/-- The local evaluations of a transport from `selfPullbackData A i`: the inverse composition
isomorphism of `F` followed by the local evaluation of `φ` and the inverse identification of
`P'`. -/
lemma app_transport_selfPullbackData_left {U : C} (A : Obj.{w} J F U) (i : A.ι)
    {A' : Obj.{w} J F U} {B' : Obj.{w} J F (A.X i)} (P' : PullbackData (A.f i) A' B')
    (φ : A ⟶ A') ⦃T : C⦄ ⦃j' : B'.ι⦄ (b : T ⟶ A.X i) (b' : T ⟶ B'.X j')
    (w : b ≫ 𝟙 (A.X i) = b' ≫ B'.f j') (c' : T ⟶ A'.X (P'.α j')) (h' : b' ≫ P'.β j' = c') :
    Hom.app (transport (selfPullbackData A i) P' φ) (i := PUnit.unit) b b' w =
      (F.mapComp' (𝟙 (A.X i)).op.toLoc b.op.toLoc b.op.toLoc (by simp)).inv.toNatTrans.app
          (A.D.obj i) ≫
        Hom.app φ b c' (by rw [P'.comp_f_eq h', ← w, Category.comp_id]) ≫
        (P'.iso b' c' h').inv :=
  -- The identifications of `selfPullbackData A i` are inverses of `F.mapComp'` by definition.
  (app_transport (selfPullbackData A i) P' φ b b' w b c' (Category.comp_id b) h').trans
    ((transportApp_def _ _ _ _ _ _ _ _ _ _).trans (rfl))

/-- The local evaluations of a transport onto `selfPullbackData A i`: the identification of `P`
followed by the local evaluation of `φ` and the composition isomorphism of `F`. -/
lemma app_transport_selfPullbackData_right {U : C} (A : Obj.{w} J F U) (i : A.ι)
    {A' : Obj.{w} J F U} {B' : Obj.{w} J F (A.X i)} (P : PullbackData (A.f i) A' B')
    (φ : A' ⟶ A) ⦃T : C⦄ ⦃j : B'.ι⦄ (b' : T ⟶ B'.X j) (b : T ⟶ A.X i)
    (w : b' ≫ B'.f j = b ≫ 𝟙 (A.X i)) (c' : T ⟶ A'.X (P.α j)) (h' : b' ≫ P.β j = c') :
    Hom.app (transport P (selfPullbackData A i) φ) (j := PUnit.unit) b' b w =
      (P.iso b' c' h').hom ≫
        Hom.app φ c' b (by rw [P.comp_f_eq h', w, Category.comp_id]) ≫
        (F.mapComp' (𝟙 (A.X i)).op.toLoc b.op.toLoc b.op.toLoc (by simp)).hom.toNatTrans.app
          (A.D.obj i) :=
  -- As in `app_transport_selfPullbackData_left`, by the definition of `selfPullbackData A i`.
  (app_transport P (selfPullbackData A i) φ b' b w c' b h' (Category.comp_id b)).trans
    ((transportApp_def _ _ _ _ _ _ _ _ _ _).trans (rfl))

/-- The pullback of a descent datum `A` along a member `A.f i` of its covering family is
isomorphic to the image of `A.D.obj i` under `toObjFunctor`. -/
def toObjIsoPullObj {U : C} (A : Obj.{w} J F U) (i : A.ι) :
    (toObjFunctor.{w} J F (A.X i)).obj (A.D.obj i) ≅ pullObj (A.f i) A :=
  isoOfData (selfPullbackData A i) (pullbackData (A.f i) A)

/-- The isomorphism `toObjIsoPullObj A i` is a transport of the identity. -/
lemma toObjIsoPullObj_hom {U : C} (A : Obj.{w} J F U) (i : A.ι) :
    (toObjIsoPullObj A i).hom =
      transport (selfPullbackData A i) (pullbackData (A.f i) A) (𝟙 A) := by
  rw [toObjIsoPullObj, isoOfData_hom]

/-- The inverse of `toObjIsoPullObj A i` is a transport of the identity. -/
lemma toObjIsoPullObj_inv {U : C} (A : Obj.{w} J F U) (i : A.ι) :
    (toObjIsoPullObj A i).inv =
      transport (pullbackData (A.f i) A) (selfPullbackData A i) (𝟙 A) := by
  rw [toObjIsoPullObj, isoOfData_inv]

end TauCeti.Stack.Stackification.Obj

namespace TauCeti.Stack

open Stackification Obj PullbackData

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) [HasPullbacks C]

section

variable (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}) [F.IsPrestack J]

/-- The naturality isomorphisms of the embeddings `toObjFunctor` into descent data along `w`-small
covering families: for `q : V ⟶ U`, embedding `q^* M` is isomorphic to pulling back the embedding
of `M` along `q`. For `F` valued in the universes of `stackification J F`, they are the naturality
isomorphisms of `toStackification`, which is the unit of the stackification of `F` when every
covering sieve of `J` contains a covering sieve generated by a `w`-small family. -/
def toStackificationNatIso {U V : C} (q : V ⟶ U) :
    (F.map q.op.toLoc).toFunctor ⋙ toObjFunctor.{w} J F V ≅
      toObjFunctor.{w} J F U ⋙ pullFunctor J F q :=
  NatIso.ofComponents (fun M ↦ isoOfData (toObjPullbackData q M) (pullbackData q _))
    fun {M M'} φ ↦ by
      rw [isoOfData_hom, isoOfData_hom]
      -- The maps of the composites `_ ⋙ _` are those of `toObjFunctor` and `pullFunctor` only
      -- after unfolding, and rewriting with `Functor.comp_map` first unfolds the abbreviation
      -- `toObjFunctor`, so `toObjFunctor_map_map` is matched by `erw`.
      erw [toObjFunctor_map_map, pullFunctor_map]
      simp only [transport_comp, Category.comp_id, Category.id_comp]

/-- The components of `toStackificationNatIso` are transports of identities. -/
lemma toStackificationNatIso_hom_app {U V : C} (q : V ⟶ U) (M : F.obj (.mk (op U))) :
    (toStackificationNatIso.{w} J F q).hom.app M =
      transport (toObjPullbackData q M) (pullbackData q _) (𝟙 _) := by
  simp only [toStackificationNatIso, NatIso.ofComponents_hom_app, isoOfData_hom]

/-- The inverse components of `toStackificationNatIso` are transports of identities. -/
lemma toStackificationNatIso_inv_app {U V : C} (q : V ⟶ U) (M : F.obj (.mk (op U))) :
    (toStackificationNatIso.{w} J F q).inv.app M =
      transport (pullbackData q _) (toObjPullbackData q M) (𝟙 _) := by
  simp only [toStackificationNatIso, NatIso.ofComponents_inv_app, isoOfData_inv]

/-- The unit condition for the naturality isomorphisms `toStackificationNatIso`. -/
lemma toStackificationNatIso_hom_app_comp_pullFunctorId_hom_app {U : C}
    (M : F.obj (.mk (op U))) :
    (toStackificationNatIso.{w} J F (𝟙 U)).hom.app M ≫
        (pullFunctorId J F U).hom.app ((toObjFunctor.{w} J F U).obj M) =
      (toObjFunctor.{w} J F U).map ((F.mapId' (𝟙 U).op.toLoc (by simp)).hom.toNatTrans.app M) := by
  rw [← transport_toObjPullbackData_refl, toStackificationNatIso_hom_app, pullFunctorId_hom_app]
  simp only [transport_comp, Category.comp_id]

/-- The composition condition for the naturality isomorphisms `toStackificationNatIso`. -/
lemma toStackificationNatIso_hom_app_comp_pullFunctorComp_hom_app {U V W : C} (q : V ⟶ U)
    (r : W ⟶ V) (M : F.obj (.mk (op U))) :
    (toStackificationNatIso.{w} J F (r ≫ q)).hom.app M ≫
        (pullFunctorComp J F q r (r ≫ q) rfl).hom.app ((toObjFunctor.{w} J F U).obj M) =
      (toObjFunctor.{w} J F W).map
          ((F.mapComp' q.op.toLoc r.op.toLoc (r ≫ q).op.toLoc rfl).hom.toNatTrans.app M) ≫
        (toStackificationNatIso.{w} J F r).hom.app ((F.map q.op.toLoc).toFunctor.obj M) ≫
          (pullFunctor J F r).map ((toStackificationNatIso.{w} J F q).hom.app M) := by
  -- Write every morphism as a transport: the embedded composition isomorphism of `F` by
  -- `transport_toObjPullbackData_trans`, and the identity before the pullback of the naturality
  -- isomorphism along `r` as the transport of the identity along `toObjPullbackData q M`.
  rw [← transport_toObjPullbackData_trans, toStackificationNatIso_hom_app,
    toStackificationNatIso_hom_app, toStackificationNatIso_hom_app, pullFunctorComp_hom_app,
    pullFunctor_map, ← transport_id (toObjPullbackData q M),
    transport_transport _ _ _ _ _ (r ≫ q) rfl, transport_transport _ _ _ _ _ (r ≫ q) rfl]
  -- Compose the transports.
  simp only [transport_comp, Category.comp_id]
  -- The two sides differ only in writing `pullObj q ((toObjFunctor J F U).obj M)` as
  -- `(toObjFunctor J F U ⋙ pullFunctor J F q).obj M`, equal by `Functor.comp_obj` and the
  -- definition of the abbreviation `pullFunctor`. Rewriting with `Functor.comp_obj` fails (the
  -- motive is not type correct, as the object appears in the type of a `PullbackData`), so the
  -- step is closed by `rfl`.
  rfl

/-- Every descent datum `A` over `U` is locally in the image of `toObjFunctor`: there is a
covering sieve of `U` along every member of which the pullback of `A` is isomorphic to the
descent datum given by an object of `F` (part of Stacks, Lemma 02ZN). -/
theorem stackification_locally_essSurj {U : C} (A : Obj.{w} J F U) :
    ∃ R ∈ J U, ∀ ⦃V : C⦄ (g : V ⟶ U), R g →
      ∃ M : F.obj (.mk (op V)), Nonempty ((pullFunctor J F g).obj A ≅
        (toObjFunctor.{w} J F V).obj M) := by
  refine ⟨_, A.mem, fun V g hg ↦ ?_⟩
  obtain ⟨i, h, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hg
  exact ⟨(F.map h.op.toLoc).toFunctor.obj (A.D.obj i),
    ⟨(pullFunctorComp J F (A.f i) h _ rfl).app A ≪≫
      (pullFunctor J F h).mapIso (toObjIsoPullObj A i).symm ≪≫
      (toStackificationNatIso.{w} J F h).symm.app (A.D.obj i)⟩⟩

end

section

variable (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{max w v', max (w + 1) u v v' u'}) [F.IsPrestack J]

/-- The canonical strong transformation `F ⟶ stackification J F` for a prestack `F` whose
universes are those of `stackification J F`: its component at `U` embeds the fibre of `F` over
`U` as the descent data along the identity of `U` (`Stackification.Obj.toObjFunctor`). It is the
unit of the stackification of `F` when every covering sieve of `J` contains a covering sieve
generated by a `w`-small family (see `stackification`). -/
-- The body is exposed so that the components and naturality isomorphisms are definitionally
-- `toObjFunctor` and `toStackificationNatIso`: the statements of the component formulas below
-- do not typecheck otherwise.
@[expose] def toStackification :
    StrongTrans F (stackification.{w, max w v', max (w + 1) u v v' u', v, u} J F) where
  app a := (toObjFunctor.{w} J F a.as.unop).toCatHom
  naturality f := Cat.Hom.isoMk (toStackificationNatIso.{w} J F f.as.unop)
  naturality_naturality η :=
    Pseudofunctor.naturality_naturality_of_locallyDiscrete F
      (stackification.{w, max w v', max (w + 1) u v v' u', v, u} J F)
      (fun a ↦ (toObjFunctor.{w} J F a.as.unop).toCatHom)
      (fun f ↦ Cat.Hom.isoMk (toStackificationNatIso.{w} J F f.as.unop)) η
  naturality_id a :=
    Cat.comp_whiskerLeft_eq_whiskerRight_comp_leftUnitor_hom_comp_rightUnitor_inv _ _ _
      fun M ↦ by
        have h := toStackificationNatIso_hom_app_comp_pullFunctorId_hom_app.{w} (J := J) (F := F)
          (U := a.as.unop) M
        -- `F.mapId'_eq_mapId` is stated for `F.mapId' (𝟙 a)`, while `h` has
        -- `(𝟙 a.as.unop).op.toLoc`, so `rw` needs the instance spelled out.
        rw [show F.mapId' (𝟙 a.as.unop).op.toLoc (by simp) = F.mapId a from
          F.mapId'_eq_mapId a] at h
        -- `h` is the goal up to definitional unfolding: `(Cat.Hom.isoMk e).hom.toNatTrans` is
        -- `e.hom`, `(toCatHom G).toFunctor` is `G`, and `(stackification J F).mapId a` has the
        -- components `pullFunctorId J F a.as.unop` (`stackification_mapId_hom_toNatTrans_app`).
        -- The goal is not type correct at implicit transparency, as its 1-morphisms are composites
        -- in `Cat` rather than `Functor.toCatHom _`, so these lemmas cannot be applied by `rw` or
        -- `simp`, and the identification is left to `exact`.
        exact h
  naturality_comp f g :=
    Cat.comp_whiskerLeft_eq_whiskerRight_comp_associators _ _ _ _ _ fun M ↦ by
      have h := toStackificationNatIso_hom_app_comp_pullFunctorComp_hom_app.{w} (J := J) (F := F)
        f.as.unop g.as.unop M
      -- `F.mapComp'_eq_mapComp` is stated for `F.mapComp' f g (f ≫ g)`, while `h` has
      -- `(g.as.unop ≫ f.as.unop).op.toLoc`, so `rw` needs the instance spelled out.
      rw [show F.mapComp' f.as.unop.op.toLoc g.as.unop.op.toLoc (g.as.unop ≫ f.as.unop).op.toLoc
        rfl = F.mapComp f g from F.mapComp'_eq_mapComp f g] at h
      -- As in `naturality_id`, `h` is the goal up to unfolding `Cat.Hom.isoMk`, `toCatHom` and
      -- the components `pullFunctorComp` of `(stackification J F).mapComp f g`
      -- (`stackification_mapComp_hom_toNatTrans_app`), which `rw` and `simp` cannot apply here.
      exact h

/-- The component of the unit at `U` is the embedding `toObjFunctor`. -/
@[simp]
lemma toStackification_app_toFunctor (a : LocallyDiscrete Cᵒᵖ) :
    ((toStackification.{w, v', u'} J F).app a).toFunctor = toObjFunctor.{w} J F a.as.unop :=
  (rfl)

/-- The naturality isomorphisms of the unit are the isomorphisms `toStackificationNatIso`. -/
@[simp]
lemma toStackification_naturality_hom_toNatTrans_app {a b : LocallyDiscrete Cᵒᵖ} (f : a ⟶ b)
    (M : F.obj a) :
    ((toStackification.{w, v', u'} J F).naturality f).hom.toNatTrans.app M =
      (toStackificationNatIso.{w} J F f.as.unop).hom.app M :=
  (rfl)

/-- The inverse naturality isomorphisms of the unit are those of `toStackificationNatIso`. -/
@[simp]
lemma toStackification_naturality_inv_toNatTrans_app {a b : LocallyDiscrete Cᵒᵖ} (f : a ⟶ b)
    (M : F.obj a) :
    ((toStackification.{w, v', u'} J F).naturality f).inv.toNatTrans.app M =
      (toStackificationNatIso.{w} J F f.as.unop).inv.app M :=
  (rfl)

end

