module

public import TauCeti.CategoryTheory.Sites.Descent.Stackification.Pseudofunctor

/-!
# Descent data along a fixed family in the stackification

A descent datum for `F` along a fixed `w`-small covering family `f` of `U` is an object of the
fibre `Obj J F U` of descent data along `w`-small covering families (`Obj.ofDescentData`), and
morphisms of descent data along `f` are exactly the morphisms between such objects: the functor
`Obj.ofDescentDataFunctor f hf : F.DescentData f ⥤ Obj J F U` is fully faithful
(`Obj.fullyFaithfulOfDescentDataFunctor`). Applied to the family consisting of the identity of
`U`, this embeds the fibre `F.obj U` into `Obj J F U` (`Obj.toObjFunctor`); for a prestack `F`
this embedding is fully faithful (`Obj.fullyFaithfulToObjFunctor`, part of Stacks, Lemma 02ZN).

The fibres `Obj J F U` are those of the stackification of `F` under the hypothesis that every
covering sieve of `J` contains a covering sieve generated by a family indexed by a type in
`Type w`; that identification is not proved here.

## References

* [Stacks Project, Lemma 02ZN](https://stacks.math.columbia.edu/tag/02ZN)
-/

public section

noncomputable section

universe w v' u' v u

open CategoryTheory Limits Opposite Bicategory Pseudofunctor LocallyDiscreteOpToCat

namespace TauCeti.Stack.Stackification.Obj

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}} [HasPullbacks C] [F.IsPrestack J] {U : C}
  {ι : Type w} {X : ι → C} (f : ∀ i, X i ⟶ U) (hf : Sieve.ofArrows X f ∈ J U)

omit [HasPullbacks C] [F.IsPrestack J] in
/-- A descent datum along a fixed `w`-small covering family, as an object of `Obj J F U`. -/
abbrev ofDescentData (D : F.DescentData f) : Obj.{w} J F U := ⟨ι, X, f, hf, D⟩

variable {f hf}

/-- The morphism between descent data along the same covering family given by a morphism of
descent data. -/
def ofDescentDataMap {D D' : F.DescentData f} (φ : D ⟶ D') :
    ofDescentData f hf D ⟶ ofDescentData f hf D' :=
  Hom.ofApp (fun T i j a b w ↦ (F.map a.op.toLoc).toFunctor.map (φ.hom i) ≫
      D'.hom (a ≫ f i) a b rfl w.symm)
    (fun T i j a b w T' g ga gb hga hgb ↦ by
      rw [pullHom_comp _ _ g ga ga gb hga hga hgb, pullHom_map,
        D'.pullHom_hom g (a ≫ f i) (ga ≫ f i) (by rw [← hga, Category.assoc]) a b rfl w.symm
          ga gb hga hgb])
    (fun T i i' j j' a a' b b' w w' ha ↦ by
      rw [← Category.assoc, ← φ.comm (a ≫ f i) a a' rfl ha.symm, Category.assoc,
        D'.hom_comp_hom, Category.assoc, D'.hom_comp_hom])

/-- The local evaluations of `ofDescentDataMap φ`. -/
lemma app_ofDescentDataMap {D D' : F.DescentData f} (φ : D ⟶ D') ⦃T : C⦄ ⦃i j : ι⦄
    (a : T ⟶ X i) (b : T ⟶ X j) (w : a ≫ f i = b ≫ f j) :
    Hom.app (ofDescentDataMap (hf := hf) φ) a b w =
      (F.map a.op.toLoc).toFunctor.map (φ.hom i) ≫ D'.hom (a ≫ f i) a b rfl w.symm :=
  Hom.app_ofApp _ _ _ _ _ _

variable (f hf) in
/-- Descent data along a fixed covering family embed into `Obj J F U`. -/
abbrev ofDescentDataFunctor : F.DescentData f ⥤ Obj.{w} J F U where
  obj := ofDescentData f hf
  map := ofDescentDataMap
  map_id D := hom_ext fun T i j a b w ↦ by
    simp [app_ofDescentDataMap]
  map_comp {_ D' _} φ ψ := hom_ext fun T i j a b w ↦ by
    rw [comp_app (ofDescentDataMap φ) (ofDescentDataMap ψ) a a b w rfl w, app_ofDescentDataMap,
      app_ofDescentDataMap, app_ofDescentDataMap, D'.hom_self _ _ rfl]
    simp

/-- A morphism between descent data along the same covering family, as a morphism of descent
data: its component at `i` corresponds to the local evaluation at the identity of `X i`. -/
def toDescentDataHom {D D' : F.DescentData f}
    (ψ : ofDescentData f hf D ⟶ ofDescentData f hf D') : D ⟶ D' where
  hom i := F.presheafHomObjHomEquiv.symm (Hom.app ψ (𝟙 (X i)) (𝟙 (X i)) rfl)
  comm T q i₁ i₂ f₁ f₂ hf₁ hf₂ := by
    rw [map_presheafHomObjHomEquiv_symm, map_presheafHomObjHomEquiv_symm, Hom.pullHom_app ψ,
      Hom.pullHom_app ψ, Hom.app_comp_descentData_hom ψ, Hom.descentData_hom_comp_app ψ]

/-- The pullbacks of the components of `toDescentDataHom ψ` are local evaluations of `ψ`. -/
lemma map_toDescentDataHom_hom {D D' : F.DescentData f}
    (ψ : ofDescentData f hf D ⟶ ofDescentData f hf D') ⦃T : C⦄ ⦃i : ι⦄ (a : T ⟶ X i) :
    (F.map a.op.toLoc).toFunctor.map ((toDescentDataHom ψ).hom i) = Hom.app ψ a a rfl := by
  rw [toDescentDataHom, map_presheafHomObjHomEquiv_symm, Hom.pullHom_app ψ]

/-- Descent data along a fixed covering family form a full subcategory of `Obj J F U`. -/
def fullyFaithfulOfDescentDataFunctor :
    (ofDescentDataFunctor (J := J) (F := F) f hf).FullyFaithful where
  preimage ψ := toDescentDataHom ψ
  map_preimage ψ := hom_ext fun T i j a b w ↦
    (app_ofDescentDataMap (toDescentDataHom ψ) a b w).trans (by
      rw [map_toDescentDataHom_hom, Hom.app_comp_descentData_hom ψ])
  preimage_map φ := by
    ext i
    apply F.presheafHomObjHomEquiv.injective
    rw [toDescentDataHom, Equiv.apply_symm_apply]
    refine (app_ofDescentDataMap φ _ _ rfl).trans ?_
    rw [presheafHomObjHomEquiv_eq_map, DescentData.hom_self _ _ _ rfl, Category.comp_id]

omit [HasPullbacks C] [F.IsPrestack J] in
/-- The family consisting of the identity of `U` is a covering family. -/
lemma ofArrows_id_mem (U : C) :
    Sieve.ofArrows (fun _ : PUnit.{w + 1} ↦ U) (fun _ ↦ 𝟙 U) ∈ J U :=
  J.superset_covering (fun _ g _ ↦ (Sieve.mem_ofArrows_iff _ _ _).2 ⟨⟨⟩, g, by simp⟩)
    (J.top_mem U)

variable (J F) in
/-- An object `M` of `F` over `U` as an object of `Obj J F U`: the descent datum along the
identity of `U` given by `M`. -/
abbrev toObjFunctor (U : C) : F.obj (.mk (op U)) ⥤ Obj.{w} J F U :=
  F.toDescentData (fun _ : PUnit.{w + 1} ↦ 𝟙 U) ⋙ ofDescentDataFunctor _ (ofArrows_id_mem U)

variable (J F) in
/-- The functor `toObjFunctor` is fully faithful. -/
def fullyFaithfulToObjFunctor (U : C) : (toObjFunctor.{w} J F U).FullyFaithful :=
  (F.fullyFaithfulToDescentData (J := J) _ (ofArrows_id_mem U)).comp
    (fullyFaithfulOfDescentDataFunctor (J := J))

end TauCeti.Stack.Stackification.Obj

end
