module

public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.HasPullback
public import TauCeti.CategoryTheory.Sites.Descent.DescentData
public import TauCeti.CategoryTheory.Sites.Descent.IsPrestack

/-!
# The fibres of the stackification of a prestack

Let `F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat` be a prestack for a Grothendieck topology `J` on a category
`C` with pullbacks. Its stackification is obtained by adjoining descent data (Stacks,
Section 02ZM, Lemma 02ZN). Here descent data are adjoined only along `w`-small covering families:
over `U : C`, an object is a descent datum for `F` along a covering family `(X i ⟶ U)_{i : ι}`
with `ι : Type w`, and a morphism between descent data along the families `(X i ⟶ U)` and
`(Y j ⟶ U)` is a compatible family of morphisms over the fibre products `X i ×_U Y j`. This file
defines these categories.

Restricting to `w`-small families, the construction is identified with the stackification only
under the hypothesis that every covering sieve of `J` contains a covering sieve generated by a
family indexed by a type in `Type w`; without it the result need not be a stack. Neither the
identification nor the stack property is proved here.

Morphisms are best handled through their *local evaluations* (`Obj.Hom.app`): for `a : T ⟶ X i`
and `b : T ⟶ Y j` with the same composite to `U`, a morphism `φ` gives `φ.app a b w :
a^* (D i) ⟶ b^* (E j)`. These are compatible with pullback (`Obj.Hom.pullHom_app`) and with
the descent data (`Obj.Hom.comm_app`), they determine `φ` (`Obj.hom_ext`, and
`Obj.Hom.ext_of_sieve`, where it is enough to evaluate on a covering sieve), and composition and
identities are computed by `Obj.comp_app` and `Obj.id_app`. The composite of two morphisms is
glued from local data, which is where the prestack condition is used.

The index universe `w` is a parameter: for the big site of schemes over a scheme `S : Scheme.{u}`
one takes `w = u`, so that morphisms lie in `Type u` although the site has objects in
`Type (u + 1)`.

## Main declarations

* `TauCeti.Stack.Stackification.Obj`: descent data along a `w`-small covering family.
* `TauCeti.Stack.Stackification.Obj.Hom`: morphisms of such descent data.
* `TauCeti.Stack.Stackification.Obj.instCategory`: the category they form.

## References

* [Stacks Project, Section 02ZM](https://stacks.math.columbia.edu/tag/02ZM)
* [Stacks Project, Lemma 02ZN](https://stacks.math.columbia.edu/tag/02ZN)
-/

public section

noncomputable section

universe w v' u' v u

open CategoryTheory Limits Opposite Bicategory Pseudofunctor LocallyDiscreteOpToCat

namespace TauCeti.Stack.Stackification

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'})

/-- A descent datum for `F` along a covering family `(X i ⟶ U)_{i : ι}` of `U` indexed by a type
`ι : Type w`. These form the fibre over `U` of the construction obtained by adjoining descent data
along `w`-small covering families, which is the stackification of `F` when every covering sieve of
`J` contains a covering sieve generated by a `w`-small family. -/
structure Obj (U : C) where
  /-- The index type of the covering family. -/
  ι : Type w
  /-- The sources of the covering family. -/
  X : ι → C
  /-- The morphisms of the covering family. -/
  f (i : ι) : X i ⟶ U
  /-- The family is a covering family for `J`. -/
  mem : Sieve.ofArrows X f ∈ J U
  /-- The descent datum along the family. -/
  D : F.DescentData f

namespace Obj

variable {J F} [HasPullbacks C] {U : C}

/-- A morphism from the descent datum `A` to the descent datum `B` over `U`: a family of morphisms
between the pullbacks of the objects of `A` and `B` to the fibre products `A.X i ×_U B.X j`, which
is compatible with the descent data. It is determined by its local evaluations `Hom.app`. -/
@[ext]
structure Hom (A B : Obj.{w} J F U) where
  /-- The morphism over the fibre product `A.X i ×_U B.X j`. -/
  hom (i : A.ι) (j : B.ι) :
    (F.map (pullback.fst (A.f i) (B.f j)).op.toLoc).toFunctor.obj (A.D.obj i) ⟶
      (F.map (pullback.snd (A.f i) (B.f j)).op.toLoc).toFunctor.obj (B.D.obj j)
  /-- Compatibility with the descent data of `A` and `B`. -/
  comm ⦃T : C⦄ ⦃i i' : A.ι⦄ ⦃j j' : B.ι⦄ (a : T ⟶ A.X i) (a' : T ⟶ A.X i') (b : T ⟶ B.X j)
    (b' : T ⟶ B.X j') (w : a ≫ A.f i = b ≫ B.f j) (w' : a' ≫ A.f i' = b' ≫ B.f j')
    (ha : a ≫ A.f i = a' ≫ A.f i') :
    A.D.hom (a ≫ A.f i) a a' rfl ha.symm ≫ pullHom (hom i' j') (pullback.lift a' b' w') a' b' =
      pullHom (hom i j) (pullback.lift a b w) a b ≫
        B.D.hom (a ≫ A.f i) b b' w.symm (w'.symm.trans ha.symm)

namespace Hom

variable {A B : Obj.{w} J F U} (φ : Hom A B)

/-- The local evaluation of a morphism of descent data: for `a : T ⟶ A.X i` and `b : T ⟶ B.X j`
with the same composite to `U`, the morphism `a^* (A.D.obj i) ⟶ b^* (B.D.obj j)` obtained by
pulling back `φ.hom i j` along `T ⟶ A.X i ×_U B.X j`. -/
def app ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
    (w : a ≫ A.f i = b ≫ B.f j) :
    (F.map a.op.toLoc).toFunctor.obj (A.D.obj i) ⟶ (F.map b.op.toLoc).toFunctor.obj (B.D.obj j) :=
  pullHom (φ.hom i j) (pullback.lift a b w) a b

/-- The pullback of `φ.hom i j` along any morphism to `A.X i ×_U B.X j` is a local evaluation
of `φ`. -/
lemma pullHom_hom ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (g : T ⟶ pullback (A.f i) (B.f j))
    (a : T ⟶ A.X i) (b : T ⟶ B.X j) (ha : g ≫ pullback.fst _ _ = a)
    (hb : g ≫ pullback.snd _ _ = b) :
    pullHom (φ.hom i j) g a b ha hb =
      φ.app a b (by rw [← ha, ← hb, Category.assoc, Category.assoc, pullback.condition]) := by
  rw [app]
  congr 1
  ext <;> simp [ha, hb]

/-- The local evaluation of `φ` at the two projections of `A.X i ×_U B.X j` is `φ.hom i j`. -/
lemma app_fst_snd (i : A.ι) (j : B.ι) :
    φ.app (pullback.fst (A.f i) (B.f j)) (pullback.snd _ _) pullback.condition = φ.hom i j := by
  rw [← pullHom_hom φ (𝟙 _) _ _ (Category.id_comp _) (Category.id_comp _), pullHom_id]

/-- Local evaluations are compatible with pullback. -/
@[simp]
lemma pullHom_app ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
    (w : a ≫ A.f i = b ≫ B.f j) ⦃T' : C⦄ (g : T' ⟶ T) (ga : T' ⟶ A.X i) (gb : T' ⟶ B.X j)
    (hga : g ≫ a = ga) (hgb : g ≫ b = gb) :
    pullHom (φ.app a b w) g ga gb hga hgb =
      φ.app ga gb (by rw [← hga, ← hgb, Category.assoc, Category.assoc, w]) := by
  rw [app, pullHom_pullHom]
  exact φ.pullHom_hom _ _ _ (by simp [hga]) (by simp [hgb])

/-- Local evaluations are compatible with the descent data. -/
@[reassoc]
lemma comm_app ⦃T : C⦄ ⦃i i' : A.ι⦄ ⦃j j' : B.ι⦄ (a : T ⟶ A.X i) (a' : T ⟶ A.X i')
    (b : T ⟶ B.X j) (b' : T ⟶ B.X j') (w : a ≫ A.f i = b ≫ B.f j)
    (w' : a' ≫ A.f i' = b' ≫ B.f j') (ha : a ≫ A.f i = a' ≫ A.f i') :
    A.D.hom (a ≫ A.f i) a a' rfl ha.symm ≫ φ.app a' b' w' =
      φ.app a b w ≫ B.D.hom (a ≫ A.f i) b b' w.symm (w'.symm.trans ha.symm) :=
  φ.comm a a' b b' w w' ha

/-- Precomposing a local evaluation with a descent isomorphism of the source changes the local
section of the source. -/
@[reassoc (attr := simp)]
lemma descentData_hom_comp_app ⦃T : C⦄ ⦃i i' : A.ι⦄ ⦃j : B.ι⦄ (q : T ⟶ U) (a : T ⟶ A.X i)
    (a' : T ⟶ A.X i') (b : T ⟶ B.X j) (ha : a ≫ A.f i = q) (ha' : a' ≫ A.f i' = q)
    (w' : a' ≫ A.f i' = b ≫ B.f j) :
    A.D.hom q a a' ha ha' ≫ φ.app a' b w' = φ.app a b (ha.trans (ha'.symm.trans w')) := by
  have := φ.comm_app a a' b b (ha.trans (ha'.symm.trans w')) w' (ha.trans ha'.symm)
  rw [B.D.hom_self (a ≫ A.f i) b (w'.symm.trans (ha'.trans ha.symm)), Category.comp_id] at this
  rw [A.D.hom_congr q (a ≫ A.f i) a a' ha ha' ha.symm, this]

/-- Postcomposing a local evaluation with a descent isomorphism of the target changes the local
section of the target. -/
@[reassoc (attr := simp)]
lemma app_comp_descentData_hom ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j j' : B.ι⦄ (q : T ⟶ U) (a : T ⟶ A.X i)
    (b : T ⟶ B.X j) (b' : T ⟶ B.X j') (w : a ≫ A.f i = b ≫ B.f j) (hb : b ≫ B.f j = q)
    (hb' : b' ≫ B.f j' = q) :
    φ.app a b w ≫ B.D.hom q b b' hb hb' = φ.app a b' (w.trans (hb.trans hb'.symm)) := by
  have := φ.comm_app a a b b' w (w.trans (hb.trans hb'.symm)) rfl
  rw [A.D.hom_self _ _ rfl, Category.id_comp] at this
  rw [B.D.hom_congr q (a ≫ A.f i) b b' hb hb' (hb.symm.trans w.symm), this]

/-- Morphisms of descent data are determined by their local evaluations. -/
lemma ext_app {φ ψ : Hom A B}
    (h : ∀ ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
      (w : a ≫ A.f i = b ≫ B.f j), φ.app a b w = ψ.app a b w) : φ = ψ := by
  ext i j
  rw [← φ.app_fst_snd, ← ψ.app_fst_snd, h]

/-- The morphism of descent data given by a family of local morphisms
`a^* (A.D.obj i) ⟶ b^* (B.D.obj j)`, which is compatible with pullback and with the descent
data. Its local evaluations are the given local morphisms (`Hom.app_ofApp`). -/
def ofApp
    (s : ∀ ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j),
      a ≫ A.f i = b ≫ B.f j →
        ((F.map a.op.toLoc).toFunctor.obj (A.D.obj i) ⟶
          (F.map b.op.toLoc).toFunctor.obj (B.D.obj j)))
    (pull : ∀ ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
      (w : a ≫ A.f i = b ≫ B.f j) ⦃T' : C⦄ (g : T' ⟶ T) (ga : T' ⟶ A.X i) (gb : T' ⟶ B.X j)
      (hga : g ≫ a = ga) (hgb : g ≫ b = gb),
      pullHom (s a b w) g ga gb hga hgb =
        s ga gb (by rw [← hga, ← hgb, Category.assoc, Category.assoc, w]))
    (comm : ∀ ⦃T : C⦄ ⦃i i' : A.ι⦄ ⦃j j' : B.ι⦄ (a : T ⟶ A.X i) (a' : T ⟶ A.X i')
      (b : T ⟶ B.X j) (b' : T ⟶ B.X j') (w : a ≫ A.f i = b ≫ B.f j)
      (w' : a' ≫ A.f i' = b' ≫ B.f j') (ha : a ≫ A.f i = a' ≫ A.f i'),
      A.D.hom (a ≫ A.f i) a a' rfl ha.symm ≫ s a' b' w' =
        s a b w ≫ B.D.hom (a ≫ A.f i) b b' w.symm (w'.symm.trans ha.symm)) :
    Hom A B where
  hom i j := s (pullback.fst _ _) (pullback.snd _ _) pullback.condition
  comm T i i' j j' a a' b b' w w' ha := by
    rw [pull, pull]
    exact comm a a' b b' w w' ha

/-- The local evaluations of `Hom.ofApp s pull comm` are given by `s`. -/
@[simp]
lemma app_ofApp
    (s : ∀ ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j),
      a ≫ A.f i = b ≫ B.f j →
        ((F.map a.op.toLoc).toFunctor.obj (A.D.obj i) ⟶
          (F.map b.op.toLoc).toFunctor.obj (B.D.obj j)))
    (pull : ∀ ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
      (w : a ≫ A.f i = b ≫ B.f j) ⦃T' : C⦄ (g : T' ⟶ T) (ga : T' ⟶ A.X i) (gb : T' ⟶ B.X j)
      (hga : g ≫ a = ga) (hgb : g ≫ b = gb),
      pullHom (s a b w) g ga gb hga hgb =
        s ga gb (by rw [← hga, ← hgb, Category.assoc, Category.assoc, w]))
    (comm : ∀ ⦃T : C⦄ ⦃i i' : A.ι⦄ ⦃j j' : B.ι⦄ (a : T ⟶ A.X i) (a' : T ⟶ A.X i')
      (b : T ⟶ B.X j) (b' : T ⟶ B.X j') (w : a ≫ A.f i = b ≫ B.f j)
      (w' : a' ≫ A.f i' = b' ≫ B.f j') (ha : a ≫ A.f i = a' ≫ A.f i'),
      A.D.hom (a ≫ A.f i) a a' rfl ha.symm ≫ s a' b' w' =
        s a b w ≫ B.D.hom (a ≫ A.f i) b b' w.symm (w'.symm.trans ha.symm))
    ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j) (w : a ≫ A.f i = b ≫ B.f j) :
    (ofApp s pull comm).app a b w = s a b w :=
  pull _ _ _ _ _ _ _ _

end Hom

section comp

variable {A B E : Obj.{w} J F U} (φ : Hom A B) (ψ : Hom B E)

/-- A composite of local evaluations of `φ` and `ψ` does not depend on the intermediate local
section of `B`. -/
lemma app_comp_app_eq ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j j' : B.ι⦄ ⦃k : E.ι⦄ (a : T ⟶ A.X i)
    (b : T ⟶ B.X j) (b' : T ⟶ B.X j') (c : T ⟶ E.X k) (w₁ : a ≫ A.f i = b ≫ B.f j)
    (w₂ : b ≫ B.f j = c ≫ E.f k) (w₁' : a ≫ A.f i = b' ≫ B.f j')
    (w₂' : b' ≫ B.f j' = c ≫ E.f k) :
    φ.app a b w₁ ≫ ψ.app b c w₂ = φ.app a b' w₁' ≫ ψ.app b' c w₂' := by
  rw [← φ.app_comp_descentData_hom (b ≫ B.f j) a b b' w₁ rfl (w₁'.symm.trans w₁),
    Category.assoc, ψ.descentData_hom_comp_app]

/-- The covering sieve of `A.X i ×_U E.X k` on which the composite of `φ` and `ψ` is computed: the
morphisms whose composite to `U` factors through the covering family of `B`. -/
abbrev compSieve (A B E : Obj.{w} J F U) (i : A.ι) (k : E.ι) :
    Sieve (pullback (A.f i) (E.f k)) :=
  Sieve.pullback (pullback.fst (A.f i) (E.f k) ≫ A.f i) (Sieve.ofArrows B.X B.f)

/-- The sieve `compSieve` is a covering sieve. -/
lemma compSieve_mem (A B E : Obj.{w} J F U) (i : A.ι) (k : E.ι) :
    compSieve A B E i k ∈ J _ :=
  J.pullback_stable _ B.mem

/-- A morphism lies in `compSieve` when its composite to `U` factors through the covering
family of `B`. -/
lemma mem_compSieve_iff {A B E : Obj.{w} J F U} {i : A.ι} {k : E.ι} ⦃T : C⦄
    (g : T ⟶ pullback (A.f i) (E.f k)) :
    compSieve A B E i k g ↔ Sieve.ofArrows B.X B.f (g ≫ pullback.fst _ _ ≫ A.f i) :=
  Iff.rfl

end comp

/-- The identity morphism of a descent datum: its local evaluations are the descent
isomorphisms. -/
def Hom.id (A : Obj.{w} J F U) : Hom A A :=
  Hom.ofApp (fun T i j a a' w ↦ A.D.hom (a ≫ A.f i) a a' rfl w.symm)
    (fun T i j a a' w T' g ga ga' hga hga' ↦
      A.D.pullHom_hom _ _ _ (by rw [← hga, Category.assoc]) _ _ rfl w.symm _ _ hga hga')
    (fun T i i' j j' a a' b b' w w' ha ↦ by
      rw [A.D.hom_comp, A.D.hom_congr (a' ≫ A.f i') (a ≫ A.f i) a' b' rfl w'.symm
        ha.symm, A.D.hom_comp])

/-- The local evaluations of `Hom.id` are the descent isomorphisms. -/
lemma Hom.app_id (A : Obj.{w} J F U) ⦃T : C⦄ ⦃i i' : A.ι⦄ (a : T ⟶ A.X i) (a' : T ⟶ A.X i')
    (w : a ≫ A.f i = a' ≫ A.f i') :
    (Hom.id A).app a a' w = A.D.hom (a ≫ A.f i) a a' rfl w.symm :=
  Hom.app_ofApp _ _ _ _ _ _

variable [F.IsPrestack J]

namespace Hom

variable {A B : Obj.{w} J F U}

/-- Morphisms of descent data are determined by their local evaluations at the `a : T ⟶ A.X i`
whose composite to `U` lies in a given covering sieve of `U`. -/
lemma ext_of_sieve {φ ψ : Hom A B} (R : Sieve U) (hR : R ∈ J U)
    (h : ∀ ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
      (w : a ≫ A.f i = b ≫ B.f j), R (a ≫ A.f i) → φ.app a b w = ψ.app a b w) : φ = ψ := by
  ext i j
  refine IsPrestack.pullHom_ext (J := J) (J.pullback_stable (pullback.fst _ _ ≫ A.f i) hR)
    fun T g hg ↦ ?_
  rw [pullHom_hom, pullHom_hom]
  exact h _ _ _ (by simpa using hg)

end Hom

section comp

variable {A B E : Obj.{w} J F U} (φ : Hom A B) (ψ : Hom B E)

/-- The morphism over `A.X i ×_U E.X k` of the composite of `φ` and `ψ`, glued from the
composites of local evaluations over the members of `compSieve`. -/
def compHom (φ : Hom A B) (ψ : Hom B E) (i : A.ι) (k : E.ι) :
    (F.map (pullback.fst (A.f i) (E.f k)).op.toLoc).toFunctor.obj (A.D.obj i) ⟶
      (F.map (pullback.snd (A.f i) (E.f k)).op.toLoc).toFunctor.obj (E.D.obj k) :=
  IsPrestack.glue (J := J) (compSieve_mem A B E i k)
    (fun T g ga gc hga hgc hg ↦
      φ.app ga (Sieve.ofArrows.h ((mem_compSieve_iff g).1 hg))
        (by rw [Sieve.ofArrows.fac, ← hga, Category.assoc]) ≫
      ψ.app (Sieve.ofArrows.h ((mem_compSieve_iff g).1 hg)) gc
        (by rw [Sieve.ofArrows.fac, ← hgc, Category.assoc, pullback.condition]))
    (fun T g ga gc hga hgc hg T' h g' ga' gc' hga' hgc' hg' e ↦ by
      rw [pullHom_comp _ _ _ _ (h ≫ Sieve.ofArrows.h ((mem_compSieve_iff g).1 hg)) _ _ rfl _,
        Hom.pullHom_app, Hom.pullHom_app]
      apply app_comp_app_eq)

private lemma pullHom_compHom ⦃i : A.ι⦄ ⦃k : E.ι⦄ ⦃T : C⦄ (g : T ⟶ pullback (A.f i) (E.f k))
    (a : T ⟶ A.X i) (c : T ⟶ E.X k) (ha : g ≫ pullback.fst _ _ = a)
    (hc : g ≫ pullback.snd _ _ = c) ⦃j : B.ι⦄ (b : T ⟶ B.X j) (w₁ : a ≫ A.f i = b ≫ B.f j)
    (w₂ : b ≫ B.f j = c ≫ E.f k) :
    pullHom (compHom φ ψ i k) g a c ha hc = φ.app a b w₁ ≫ ψ.app b c w₂ := by
  rw [compHom, IsPrestack.pullHom_glue]
  · apply app_comp_app_eq
  · exact (Sieve.mem_ofArrows_iff _ _ _).2 ⟨j, b, by rw [← w₁, ← ha, Category.assoc]⟩

/-- The composite of two morphisms of descent data. -/
def Hom.comp : Hom A E where
  hom := compHom φ ψ
  comm T i i' k k' a a' c c' w w' ha := by
    refine IsPrestack.pullHom_ext (J := J) (J.pullback_stable (a ≫ A.f i) B.mem)
      fun T' g hg ↦ ?_
    obtain ⟨j, b, hb⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hg
    rw [pullHom_comp _ _ g _ (g ≫ a') _ rfl rfl rfl, pullHom_comp _ _ g _ (g ≫ c) _ rfl rfl rfl,
      pullHom_pullHom, pullHom_pullHom, A.D.pullHom_hom _ _ _ rfl _ _ rfl ha.symm _ _ rfl rfl,
      E.D.pullHom_hom _ _ _ rfl _ _ w.symm (w'.symm.trans ha.symm) _ _ rfl rfl,
      pullHom_compHom φ ψ _ _ _ (by simp) (by simp) b (by rw [Category.assoc, ← ha, hb])
        (by rw [← hb, Category.assoc, ha, w']),
      pullHom_compHom φ ψ _ _ _ (by simp) (by simp) b (by rw [Category.assoc, hb])
        (by rw [← hb, Category.assoc, w]),
      φ.descentData_hom_comp_app_assoc]
    simp only [Category.assoc, Hom.app_comp_descentData_hom]

/-- The local evaluations of a composite are the composites of local evaluations, through any
intermediate local section. -/
lemma Hom.app_comp ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ ⦃k : E.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
    (c : T ⟶ E.X k) (w : a ≫ A.f i = c ≫ E.f k) (w₁ : a ≫ A.f i = b ≫ B.f j)
    (w₂ : b ≫ B.f j = c ≫ E.f k) :
    (φ.comp ψ).app a c w = φ.app a b w₁ ≫ ψ.app b c w₂ :=
  pullHom_compHom φ ψ _ _ _ (by simp) (by simp) b w₁ w₂

end comp

/-- Identities and composition of morphisms of descent data along covering families. -/
instance instCategoryStruct : CategoryStruct (Obj.{w} J F U) where
  Hom := Hom
  id := Hom.id
  comp := Hom.comp

/-- The local evaluations of a composite are the composites of local evaluations, through any
intermediate local section. -/
lemma comp_app {A B E : Obj.{w} J F U} (φ : A ⟶ B) (ψ : B ⟶ E) ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄
    ⦃k : E.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j) (c : T ⟶ E.X k) (w : a ≫ A.f i = c ≫ E.f k)
    (w₁ : a ≫ A.f i = b ≫ B.f j) (w₂ : b ≫ B.f j = c ≫ E.f k) :
    Hom.app (φ ≫ ψ) a c w = Hom.app φ a b w₁ ≫ Hom.app ψ b c w₂ :=
  Hom.app_comp φ ψ a b c w w₁ w₂

/-- The local evaluations of the identity are the descent isomorphisms. -/
@[simp]
lemma id_app (A : Obj.{w} J F U) ⦃T : C⦄ ⦃i i' : A.ι⦄ (a : T ⟶ A.X i) (a' : T ⟶ A.X i')
    (w : a ≫ A.f i = a' ≫ A.f i') :
    Hom.app (𝟙 A) a a' w = A.D.hom (a ≫ A.f i) a a' rfl w.symm :=
  Hom.app_id A a a' w

/-- Morphisms of descent data are determined by their local evaluations. -/
lemma hom_ext {A B : Obj.{w} J F U} {φ ψ : A ⟶ B}
    (h : ∀ ⦃T : C⦄ ⦃i : A.ι⦄ ⦃j : B.ι⦄ (a : T ⟶ A.X i) (b : T ⟶ B.X j)
      (w : a ≫ A.f i = b ≫ B.f j), Hom.app φ a b w = Hom.app ψ a b w) : φ = ψ :=
  Hom.ext_app h

/-- Descent data along `w`-small covering families of `U` form a category. -/
instance instCategory : Category (Obj.{w} J F U) where
  id_comp φ := hom_ext fun T i j a b w ↦ by
    rw [comp_app _ _ a _ _ w rfl w, id_app, Hom.descentData_hom_comp_app]
  comp_id φ := hom_ext fun T i j a b w ↦ by
    rw [comp_app _ _ _ b _ w w rfl, id_app, Hom.app_comp_descentData_hom]
  assoc {A B E G} φ ψ χ := by
    refine Hom.ext_of_sieve _ (J.intersection_covering B.mem E.mem) fun T i l a d w h ↦ ?_
    obtain ⟨j, b, hb⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 h.1
    obtain ⟨k, c, hc⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 h.2
    rw [comp_app _ _ a c d w hc (hc.symm.trans w), comp_app _ _ a b c hc hb (hb.symm.trans hc),
      comp_app _ _ a b d w hb (hb.symm.trans w),
      comp_app _ _ b c d (hb.symm.trans w) (hb.symm.trans hc) (hc.symm.trans w), Category.assoc]

end Obj

end TauCeti.Stack.Stackification

