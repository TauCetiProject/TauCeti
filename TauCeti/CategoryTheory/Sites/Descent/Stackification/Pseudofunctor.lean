module

public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic
public import TauCeti.CategoryTheory.Bicategory.Functor.LocallyDiscrete
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.Basic

/-!
# The stackification of a prestack as a pseudofunctor

The fibres `Obj J F U` of descent data along `w`-small covering families for a prestack `F` (see
`TauCeti.CategoryTheory.Sites.Descent.Stackification.Basic`) form a pseudofunctor on
`LocallyDiscrete Cᵒᵖ`: a descent datum along `(X i ⟶ U)` pulls back along `q : V ⟶ U` to the
descent datum along `(X i ×_U V ⟶ V)` given by Mathlib's `DescentData.pullFunctor`.

The comparison isomorphisms of this pseudofunctor relate different presentations of pullbacks of
the same descent datum. They are handled uniformly through *pullback data*
(`Obj.PullbackData q A B`): an identification, at the level of local sections, of the descent
datum `B` over `V` with the pullback of `A` along `q`. A morphism `φ : A ⟶ A'` is transported
along pullback data to a morphism `B ⟶ B'` (`Obj.PullbackData.transport`); transport is
functorial (`transport_comp`, `transport_id`), compatible with composing pullback data
(`transport_transport`) and insensitive to identity and reassociated compositions of pullback
data (`transport_refl_trans`, `transport_trans_refl`, `transport_trans_trans`). The local
evaluations of transports onto `refl` and onto composites of pullback data are computed in terms
of the identifications of the pullback data involved (`app_transport_refl`,
`app_transport_trans`). The pullback functors are transports, and the unit and composition
isomorphisms are transports of identities, so the coherence conditions of the pseudofunctor reduce
to these rules.

This pseudofunctor is the stackification of `F` (Stacks, Lemma 02ZN) under the hypothesis that
every covering sieve of `J` contains a covering sieve generated by a family indexed by a type in
`Type w`; without it the result need not be a stack. Neither the identification nor the stack
property is proved here.

## Main declarations

* `TauCeti.Stack.Stackification.Obj.PullbackData`: pullback data, and `transport` along it.
* `TauCeti.Stack.Stackification.Obj.pullFunctor`: pulling back descent data along `q : V ⟶ U`.
* `TauCeti.Stack.stackification`: the pseudofunctor `LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat` obtained from a
  prestack by adjoining descent data along `w`-small covering families.

## References

* [Stacks Project, Lemma 02ZN](https://stacks.math.columbia.edu/tag/02ZN)
-/

public section

noncomputable section

universe w v' u' v u

open CategoryTheory Limits Opposite Bicategory Pseudofunctor LocallyDiscreteOpToCat

namespace TauCeti.Stack.Stackification.Obj

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}} [HasPullbacks C]

/-- An identification of the descent datum `B` over `V` with the pullback of the descent datum `A`
over `U` along `q : V ⟶ U`, at the level of local sections: every member of the covering family of
`B` maps to a member of the covering family of `A` over `q`, and the objects of `B` are identified
with the pullbacks of the corresponding objects of `A`, compatibly with pullback and with the
descent data. -/
structure PullbackData {U V : C} (q : V ⟶ U) (A : Obj.{w} J F U) (B : Obj.{w} J F V) where
  /-- The member of the covering family of `A` below a member of that of `B`. -/
  α : B.ι → A.ι
  /-- The morphism from a member of the covering family of `B` to the corresponding member of
  that of `A`. -/
  β (j : B.ι) : B.X j ⟶ A.X (α j)
  /-- The morphisms `β j` lie over `q`. -/
  w (j : B.ι) : β j ≫ A.f (α j) = B.f j ≫ q
  /-- The identification of the pullbacks of the objects of `B` with pullbacks of the objects
  of `A`. -/
  iso ⦃T : C⦄ ⦃j : B.ι⦄ (b : T ⟶ B.X j) (c : T ⟶ A.X (α j)) (h : b ≫ β j = c) :
    (F.map b.op.toLoc).toFunctor.obj (B.D.obj j) ≅
      (F.map c.op.toLoc).toFunctor.obj (A.D.obj (α j))
  /-- The identifications are compatible with pullback. -/
  pullHom_iso ⦃T : C⦄ ⦃j : B.ι⦄ (b : T ⟶ B.X j) (c : T ⟶ A.X (α j)) (h : b ≫ β j = c) ⦃T' : C⦄
    (g : T' ⟶ T) (gb : T' ⟶ B.X j) (gc : T' ⟶ A.X (α j)) (hgb : g ≫ b = gb) (hgc : g ≫ c = gc) :
    pullHom (iso b c h).hom g gb gc hgb hgc =
      (iso gb gc (by rw [← hgb, ← hgc, ← h, Category.assoc])).hom
  /-- The identifications carry the descent data of `B` to those of `A`. -/
  hom_eq ⦃T : C⦄ ⦃j j' : B.ι⦄ (q' : T ⟶ V) (b : T ⟶ B.X j) (b' : T ⟶ B.X j')
    (hb : b ≫ B.f j = q') (hb' : b' ≫ B.f j' = q') (c : T ⟶ A.X (α j)) (c' : T ⟶ A.X (α j'))
    (h : b ≫ β j = c) (h' : b' ≫ β j' = c') :
    B.D.hom q' b b' hb hb' = (iso b c h).hom ≫
      A.D.hom (c ≫ A.f (α j)) c c' rfl (by
        rw [← h, ← h', Category.assoc, Category.assoc, w, w, reassoc_of% hb, reassoc_of% hb']) ≫
      (iso b' c' h').inv

namespace PullbackData

variable {U V : C} {q : V ⟶ U} {A A' : Obj.{w} J F U} {B B' : Obj.{w} J F V}

omit [HasPullbacks C] in
/-- A local section `c = b ≫ P.β j` of `A` lies over the image under `q` of the morphism
`b ≫ B.f j` below `b`. -/
lemma comp_f_eq (P : PullbackData q A B) ⦃T : C⦄ ⦃j : B.ι⦄ {b : T ⟶ B.X j}
    {c : T ⟶ A.X (P.α j)} (h : b ≫ P.β j = c) :
    c ≫ A.f (P.α j) = (b ≫ B.f j) ≫ q := by
  rw [← h, Category.assoc, P.w, Category.assoc]

omit [HasPullbacks C] in
/-- The inverse identifications of pullback data are compatible with pullback. -/
@[simp]
lemma pullHom_iso_inv (P : PullbackData q A B) ⦃T : C⦄ ⦃j : B.ι⦄ (b : T ⟶ B.X j)
    (c : T ⟶ A.X (P.α j)) (h : b ≫ P.β j = c) ⦃T' : C⦄ (g : T' ⟶ T) (gb : T' ⟶ B.X j)
    (gc : T' ⟶ A.X (P.α j)) (hgb : g ≫ b = gb) (hgc : g ≫ c = gc) :
    pullHom (P.iso b c h).inv g gc gb hgc hgb =
      (P.iso gb gc (by rw [← hgb, ← hgc, ← h, Category.assoc])).inv := by
  rw [← cancel_mono (P.iso gb gc (by rw [← hgb, ← hgc, ← h, Category.assoc])).hom,
    Iso.inv_hom_id, ← P.pullHom_iso b c h g gb gc hgb hgc,
    ← pullHom_comp, Iso.inv_hom_id, pullHom_id_self]

variable [F.IsPrestack J]

/-- The local morphism `b^* (B.D.obj j) ⟶ b'^* (B'.D.obj j')` given by a morphism `φ : A ⟶ A'`
through pullback data of `B` over `A` and of `B'` over `A'`. -/
def transportApp (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A') ⦃T : C⦄
    ⦃j : B.ι⦄ ⦃j' : B'.ι⦄ (b : T ⟶ B.X j) (b' : T ⟶ B'.X j') (c : T ⟶ A.X (P.α j))
    (c' : T ⟶ A'.X (P'.α j')) (h : b ≫ P.β j = c) (h' : b' ≫ P'.β j' = c')
    (w : b ≫ B.f j = b' ≫ B'.f j') :
    (F.map b.op.toLoc).toFunctor.obj (B.D.obj j) ⟶
      (F.map b'.op.toLoc).toFunctor.obj (B'.D.obj j') :=
  (P.iso b c h).hom ≫
    Hom.app φ c c' (by rw [← h, ← h', Category.assoc, Category.assoc, P.w, P'.w, reassoc_of% w]) ≫
    (P'.iso b' c' h').inv

/-- `transportApp` conjugates the local evaluation `Hom.app φ c c' _` of `φ` by the identifications
of `P` and `P'`. -/
lemma transportApp_def (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A')
    ⦃T : C⦄ ⦃j : B.ι⦄ ⦃j' : B'.ι⦄ (b : T ⟶ B.X j) (b' : T ⟶ B'.X j') (c : T ⟶ A.X (P.α j))
    (c' : T ⟶ A'.X (P'.α j')) (h : b ≫ P.β j = c) (h' : b' ≫ P'.β j' = c')
    (w : b ≫ B.f j = b' ≫ B'.f j') :
    transportApp P P' φ b b' c c' h h' w = (P.iso b c h).hom ≫
      Hom.app φ c c' (by rw [← h, ← h', Category.assoc, Category.assoc, P.w, P'.w,
        reassoc_of% w]) ≫ (P'.iso b' c' h').inv :=
  (rfl)

/-- `transportApp` does not depend on the chosen local sections of `A` and `A'`. -/
lemma transportApp_congr (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A')
    ⦃T : C⦄ ⦃j : B.ι⦄ ⦃j' : B'.ι⦄ (b : T ⟶ B.X j) (b' : T ⟶ B'.X j') (c₁ c₂ : T ⟶ A.X (P.α j))
    (c₁' c₂' : T ⟶ A'.X (P'.α j')) (h₁ : b ≫ P.β j = c₁) (h₁' : b' ≫ P'.β j' = c₁')
    (h₂ : b ≫ P.β j = c₂) (h₂' : b' ≫ P'.β j' = c₂') (w : b ≫ B.f j = b' ≫ B'.f j') :
    transportApp P P' φ b b' c₁ c₁' h₁ h₁' w = transportApp P P' φ b b' c₂ c₂' h₂ h₂' w := by
  subst h₁ h₁' h₂ h₂'
  rfl

/-- `transportApp` is compatible with pullback. -/
lemma pullHom_transportApp (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A')
    ⦃T : C⦄ ⦃j : B.ι⦄ ⦃j' : B'.ι⦄ (b : T ⟶ B.X j) (b' : T ⟶ B'.X j') (c : T ⟶ A.X (P.α j))
    (c' : T ⟶ A'.X (P'.α j')) (h : b ≫ P.β j = c) (h' : b' ≫ P'.β j' = c')
    (w : b ≫ B.f j = b' ≫ B'.f j') ⦃T' : C⦄ (g : T' ⟶ T) (gb : T' ⟶ B.X j)
    (gb' : T' ⟶ B'.X j') (hgb : g ≫ b = gb) (hgb' : g ≫ b' = gb') :
    pullHom (transportApp P P' φ b b' c c' h h' w) g gb gb' hgb hgb' =
      transportApp P P' φ gb gb' (g ≫ c) (g ≫ c') (by rw [← hgb, ← h, Category.assoc])
        (by rw [← hgb', ← h', Category.assoc])
        (by rw [← hgb, ← hgb', Category.assoc, Category.assoc, w]) := by
  rw [transportApp, pullHom_comp _ _ g gb (g ≫ c) gb' hgb rfl hgb',
    pullHom_comp _ _ g (g ≫ c) (g ≫ c') gb' rfl rfl hgb', P.pullHom_iso, Hom.pullHom_app]
  rw [pullHom_iso_inv, transportApp]

/-- `transportApp` is compatible with the descent data of the source. -/
@[reassoc]
lemma descentData_hom_comp_transportApp (P : PullbackData q A B) (P' : PullbackData q A' B')
    (φ : A ⟶ A') ⦃T : C⦄ ⦃j₁ j₂ : B.ι⦄ ⦃j' : B'.ι⦄ (q' : T ⟶ V) (b₁ : T ⟶ B.X j₁)
    (b₂ : T ⟶ B.X j₂) (b' : T ⟶ B'.X j') (hb₁ : b₁ ≫ B.f j₁ = q') (hb₂ : b₂ ≫ B.f j₂ = q')
    (c₁ : T ⟶ A.X (P.α j₁)) (c₂ : T ⟶ A.X (P.α j₂)) (c' : T ⟶ A'.X (P'.α j'))
    (h₁ : b₁ ≫ P.β j₁ = c₁) (h₂ : b₂ ≫ P.β j₂ = c₂) (h' : b' ≫ P'.β j' = c')
    (w : b₂ ≫ B.f j₂ = b' ≫ B'.f j') :
    B.D.hom q' b₁ b₂ hb₁ hb₂ ≫ transportApp P P' φ b₂ b' c₂ c' h₂ h' w =
      transportApp P P' φ b₁ b' c₁ c' h₁ h' (hb₁.trans (hb₂.symm.trans w)) := by
  rw [P.hom_eq q' b₁ b₂ hb₁ hb₂ c₁ c₂ h₁ h₂, transportApp, transportApp]
  simp

/-- `transportApp` is compatible with the descent data of the target. -/
@[reassoc]
lemma transportApp_comp_descentData_hom (P : PullbackData q A B) (P' : PullbackData q A' B')
    (φ : A ⟶ A') ⦃T : C⦄ ⦃j : B.ι⦄ ⦃j₁' j₂' : B'.ι⦄ (q' : T ⟶ V) (b : T ⟶ B.X j)
    (b₁' : T ⟶ B'.X j₁') (b₂' : T ⟶ B'.X j₂') (hb₁ : b₁' ≫ B'.f j₁' = q')
    (hb₂ : b₂' ≫ B'.f j₂' = q') (c : T ⟶ A.X (P.α j)) (c₁' : T ⟶ A'.X (P'.α j₁'))
    (c₂' : T ⟶ A'.X (P'.α j₂')) (h : b ≫ P.β j = c) (h₁ : b₁' ≫ P'.β j₁' = c₁')
    (h₂ : b₂' ≫ P'.β j₂' = c₂') (w : b ≫ B.f j = b₁' ≫ B'.f j₁') :
    transportApp P P' φ b b₁' c c₁' h h₁ w ≫ B'.D.hom q' b₁' b₂' hb₁ hb₂ =
      transportApp P P' φ b b₂' c c₂' h h₂ (w.trans (hb₁.trans hb₂.symm)) := by
  rw [P'.hom_eq q' b₁' b₂' hb₁ hb₂ c₁' c₂' h₁ h₂, transportApp, transportApp]
  simp

/-- The morphism `B ⟶ B'` induced by a morphism `φ : A ⟶ A'` through pullback data of `B` over
`A` and of `B'` over `A'` along the same morphism. -/
def transport (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A') : B ⟶ B' :=
  Hom.ofApp (fun T j j' b b' w ↦ transportApp P P' φ b b' _ _ rfl rfl w)
    (fun T j j' b b' w T' g gb gb' hgb hgb' ↦ by
      rw [pullHom_transportApp]
      apply transportApp_congr)
    (fun T j₁ j₂ j₁' j₂' b₁ b₂ b₁' b₂' w w' hb ↦ by
      rw [descentData_hom_comp_transportApp, transportApp_comp_descentData_hom])

/-- The local evaluations of a transported morphism. -/
lemma app_transport (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A') ⦃T : C⦄
    ⦃j : B.ι⦄ ⦃j' : B'.ι⦄ (b : T ⟶ B.X j) (b' : T ⟶ B'.X j') (w : b ≫ B.f j = b' ≫ B'.f j')
    (c : T ⟶ A.X (P.α j)) (c' : T ⟶ A'.X (P'.α j')) (h : b ≫ P.β j = c)
    (h' : b' ≫ P'.β j' = c') :
    Hom.app (transport P P' φ) b b' w = transportApp P P' φ b b' c c' h h' w := by
  rw [transport, Hom.app_ofApp]
  apply transportApp_congr

/-- Transport is compatible with composition. -/
lemma transport_comp {A'' : Obj.{w} J F U} {B'' : Obj.{w} J F V} (P : PullbackData q A B)
    (P' : PullbackData q A' B') (P'' : PullbackData q A'' B'') (φ : A ⟶ A') (ψ : A' ⟶ A'') :
    transport P P' φ ≫ transport P' P'' ψ = transport P P'' (φ ≫ ψ) := by
  refine Hom.ext_of_sieve _ B'.mem fun T j j'' b b'' w hb ↦ ?_
  obtain ⟨j', b', hb'⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hb
  rw [comp_app _ _ b b' b'' w hb' (hb'.symm.trans w), app_transport _ _ _ _ _ _ _ _ rfl rfl,
    app_transport _ _ _ _ _ _ _ _ rfl rfl, app_transport _ _ _ _ _ _ _ _ rfl rfl, transportApp,
    transportApp, transportApp, comp_app _ _ _ (b' ≫ P'.β j') _ _ (by
      rw [Category.assoc, Category.assoc, P.w, P'.w, reassoc_of% hb']) (by
      rw [Category.assoc, Category.assoc, P'.w, P''.w, reassoc_of% (hb'.symm.trans w)])]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]

/-- Transporting an identity along the same pullback data gives an identity. -/
lemma transport_id (P : PullbackData q A B) : transport P P (𝟙 A) = 𝟙 B :=
  hom_ext fun T j j' b b' w ↦ by
    rw [app_transport _ _ _ _ _ _ _ _ rfl rfl, transportApp, id_app, id_app,
      P.hom_eq (b ≫ B.f j) b b' rfl w.symm _ _ rfl rfl]

/-- The isomorphism `B ≅ B'` between two descent data identified with pullbacks of the same descent
datum along the same morphism. -/
def isoOfData {B' : Obj.{w} J F V} (P : PullbackData q A B) (P' : PullbackData q A B') :
    B ≅ B' where
  hom := transport P P' (𝟙 A)
  inv := transport P' P (𝟙 A)
  hom_inv_id := by rw [transport_comp, Category.comp_id, transport_id]
  inv_hom_id := by rw [transport_comp, Category.comp_id, transport_id]

/-- The morphism of `isoOfData P P'` is the transport of the identity. -/
@[simp]
lemma isoOfData_hom {B' : Obj.{w} J F V} (P : PullbackData q A B) (P' : PullbackData q A B') :
    (isoOfData P P').hom = transport P P' (𝟙 A) :=
  (rfl)

/-- The inverse of `isoOfData P P'` is the transport of the identity. -/
@[simp]
lemma isoOfData_inv {B' : Obj.{w} J F V} (P : PullbackData q A B) (P' : PullbackData q A B') :
    (isoOfData P P').inv = transport P' P (𝟙 A) :=
  (rfl)

end PullbackData

omit [HasPullbacks C] in
/-- The descent datum `A` is the pullback of itself along the identity. -/
-- The body is exposed, as is that of `PullbackData.trans`, so that the index maps and morphisms of
-- identity and composite pullback data are definitionally those of their constituents, as needed
-- to state and compute transports onto pullback data mapped along a strong transformation.
@[expose] def PullbackData.refl {U : C} (A : Obj.{w} J F U) : PullbackData (𝟙 U) A A where
  α j := j
  β j := 𝟙 _
  w j := by simp
  iso T j b c h := A.D.iso (b ≫ A.f j) b c rfl (by rw [← h, Category.comp_id])
  pullHom_iso T j b c h T' g gb gc hgb hgc :=
    A.D.pullHom_hom _ _ _ (by rw [← hgb, Category.assoc]) _ _ rfl
      (by rw [← h, Category.comp_id]) _ _ hgb hgc
  hom_eq T j j' q' b b' hb hb' c c' h h' := by
    simp only [Category.comp_id] at h h'
    subst h h'
    simp only [DescentData.iso_hom, DescentData.iso_inv, DescentData.hom_self,
      Category.id_comp, Category.comp_id]
    exact A.D.hom_congr q' _ b b' hb hb' hb.symm

omit [HasPullbacks C] in
private lemma iso_hom_comp_iso_hom_congr {U V W : C} {q : V ⟶ U} {r : W ⟶ V}
    {A : Obj.{w} J F U} {B : Obj.{w} J F V} {E : Obj.{w} J F W} (P : PullbackData r B E)
    (Q : PullbackData q A B) ⦃T : C⦄ ⦃j : E.ι⦄ (b : T ⟶ E.X j) (m m' : T ⟶ B.X (P.α j))
    (c : T ⟶ A.X (Q.α (P.α j))) (h : b ≫ P.β j = m) (h' : b ≫ P.β j = m')
    (k : m ≫ Q.β (P.α j) = c) (k' : m' ≫ Q.β (P.α j) = c) :
    (P.iso b m h).hom ≫ (Q.iso m c k).hom = (P.iso b m' h').hom ≫ (Q.iso m' c k').hom := by
  subst h h'
  rfl

/-- The composite of an identification of `E` with the pullback of `B` along `r` and of `B` with
the pullback of `A` along `q`: an identification of `E` with the pullback of `A` along
`r ≫ q`. -/
@[expose] def PullbackData.trans {U V W : C} {q : V ⟶ U} {r : W ⟶ V} {A : Obj.{w} J F U}
    {B : Obj.{w} J F V} {E : Obj.{w} J F W} (P : PullbackData r B E) (Q : PullbackData q A B)
    (rq : W ⟶ U) (hrq : r ≫ q = rq) : PullbackData rq A E where
  α j := Q.α (P.α j)
  β j := P.β j ≫ Q.β (P.α j)
  w j := by rw [Category.assoc, Q.w, ← Category.assoc, P.w, Category.assoc, hrq]
  iso T j b c h := P.iso b (b ≫ P.β j) rfl ≪≫ Q.iso (b ≫ P.β j) c (by rw [← h, Category.assoc])
  pullHom_iso T j b c h T' g gb gc hgb hgc := by
    rw [Iso.trans_hom, pullHom_comp _ _ g gb (g ≫ b ≫ P.β j) gc hgb rfl hgc, P.pullHom_iso,
      Q.pullHom_iso, Iso.trans_hom]
    exact iso_hom_comp_iso_hom_congr _ _ _ _ _ _ _ _ _ _
  hom_eq T j j' q' b b' hb hb' c c' h h' := by
    rw [P.hom_eq q' b b' hb hb' _ _ rfl rfl, Q.hom_eq _ _ _ rfl _ c c'
      (by rw [← h, Category.assoc]) (by rw [← h', Category.assoc])]
    simp only [Iso.trans_hom, Iso.trans_inv, Category.assoc]

namespace PullbackData

variable [F.IsPrestack J] {U V W : C} {q : V ⟶ U} {r : W ⟶ V} {A A' : Obj.{w} J F U}
  {B B' : Obj.{w} J F V} {E E' : Obj.{w} J F W}

/-- Transporting along pullback data is compatible with composing pullback data. -/
lemma transport_transport (R : PullbackData r B E) (R' : PullbackData r B' E')
    (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A') (rq : W ⟶ U)
    (hrq : r ≫ q = rq) :
    transport R R' (transport P P' φ) = transport (R.trans P rq hrq) (R'.trans P' rq hrq) φ :=
  hom_ext fun T k k' e e' w ↦ by
    rw [app_transport _ _ _ _ _ _ _ _ rfl rfl, app_transport _ _ _ _ _ _ _ _ rfl rfl,
      transportApp, transportApp, app_transport _ _ _ _ _ _ (e ≫ R.β k ≫ P.β (R.α k))
        (e' ≫ R'.β k' ≫ P'.β (R'.α k')) (Category.assoc _ _ _) (Category.assoc _ _ _),
      transportApp]
    simp only [trans, Iso.trans_hom, Iso.trans_inv, Category.assoc]

/-- Transporting along the pullback data `refl` does not change a morphism. -/
lemma transport_refl (φ : A ⟶ A') : transport (refl A) (refl A') φ = φ :=
  hom_ext fun T i i' a a' w ↦ by
    rw [app_transport _ _ _ _ _ _ a a' (Category.comp_id _) (Category.comp_id _)]
    simp only [transportApp, refl, DescentData.iso_hom, DescentData.iso_inv]
    rw [A.D.hom_self _ _ rfl, A'.D.hom_self _ _ rfl, Category.id_comp, Category.comp_id]

/-- The local evaluations of a transport onto `refl A'`: the identification of `P` followed by the
local evaluation of `φ`. -/
lemma app_transport_refl {B : Obj.{w} J F U} (P : PullbackData (𝟙 U) A B) (φ : A ⟶ A') ⦃T : C⦄
    ⦃j : B.ι⦄ ⦃j' : A'.ι⦄ (b : T ⟶ B.X j) (b' : T ⟶ A'.X j') (w : b ≫ B.f j = b' ≫ A'.f j')
    (c : T ⟶ A.X (P.α j)) (h : b ≫ P.β j = c) :
    Hom.app (transport P (refl A') φ) b b' w = (P.iso b c h).hom ≫
      Hom.app φ c b' (by rw [P.comp_f_eq h, w, Category.comp_id]) := by
  rw [app_transport P (refl A') φ b b' w c b' h (Category.comp_id b')]
  simp only [transportApp, refl, DescentData.iso_inv]
  rw [A'.D.hom_self _ _ rfl, Category.comp_id]

/-- The local evaluations of a transport onto a composite `R'.trans P'` of pullback data: the
identification of `P`, the local evaluation of `φ`, and the inverse identifications of `P'` and
`R'`. -/
lemma app_transport_trans {E : Obj.{w} J F W} (rq : W ⟶ U) (hrq : r ≫ q = rq)
    (P : PullbackData rq A E) (R' : PullbackData r B' E') (P' : PullbackData q A' B') (φ : A ⟶ A')
    ⦃T : C⦄ ⦃k : E.ι⦄ ⦃k' : E'.ι⦄ (e : T ⟶ E.X k) (e' : T ⟶ E'.X k')
    (w : e ≫ E.f k = e' ≫ E'.f k') (c : T ⟶ A.X (P.α k)) (h : e ≫ P.β k = c)
    (m' : T ⟶ B'.X (R'.α k')) (hm' : e' ≫ R'.β k' = m') (c' : T ⟶ A'.X (P'.α (R'.α k')))
    (hc' : m' ≫ P'.β (R'.α k') = c') :
    Hom.app (transport P (R'.trans P' rq hrq) φ) e e' w = (P.iso e c h).hom ≫
      Hom.app φ c c' (by
        rw [P.comp_f_eq h, P'.comp_f_eq hc', R'.comp_f_eq hm', w, ← hrq]
        simp only [Category.assoc]) ≫
      (P'.iso m' c' hc').inv ≫ (R'.iso e' m' hm').inv := by
  subst h hm' hc'
  rw [app_transport P (R'.trans P' rq hrq) φ e e' w _ _ rfl (Category.assoc _ _ _).symm]
  simp only [transportApp, trans, Iso.trans_inv]

omit [HasPullbacks C] [F.IsPrestack J] in
private lemma refl_iso_trans_iso (P : PullbackData q A B) ⦃T : C⦄ ⦃j : B.ι⦄
    (b m : T ⟶ B.X j) (c : T ⟶ A.X (P.α j)) (hm : b ≫ 𝟙 _ = m) (h : m ≫ P.β j = c)
    (h' : b ≫ P.β j = c) :
    (refl B).iso b m hm ≪≫ P.iso m c h = P.iso b c h' := by
  rw [Category.comp_id] at hm
  subst hm
  ext
  simp only [refl, Iso.trans_hom, DescentData.iso_hom]
  rw [B.D.hom_self _ _ rfl, Category.id_comp]

omit [HasPullbacks C] [F.IsPrestack J] in
private lemma iso_trans_refl_iso (P : PullbackData q A B) ⦃T : C⦄ ⦃j : B.ι⦄
    (b : T ⟶ B.X j) (m c : T ⟶ A.X (P.α j)) (hm : b ≫ P.β j = m) (h : m ≫ 𝟙 _ = c)
    (h' : b ≫ P.β j = c) :
    P.iso b m hm ≪≫ (refl A).iso m c h = P.iso b c h' := by
  rw [Category.comp_id] at h
  subst h
  ext
  simp only [refl, Iso.trans_hom, DescentData.iso_hom]
  rw [A.D.hom_self _ _ rfl, Category.comp_id]

/-- Composing pullback data with `refl` of the base does not change transport. -/
lemma transport_trans_refl (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A')
    (hq : q ≫ 𝟙 U = q) :
    transport P (P'.trans (refl A') q hq) φ = transport P P' φ :=
  hom_ext fun T j j' b b' w ↦ by
    rw [app_transport (P' := P'.trans (refl A') q hq) (c := b ≫ P.β j) (c' := b' ≫ P'.β j')
        (h := rfl) (h' := by simp [trans, refl]),
      app_transport (P' := P') (c := b ≫ P.β j) (c' := b' ≫ P'.β j') (h := rfl) (h' := rfl)]
    simp only [transportApp, trans]
    -- The index map of `refl A'` is the identity only after unfolding `refl`, so the composite
    -- isomorphism is rewritten up to definitional unfolding.
    erw [iso_trans_refl_iso (h' := rfl)]
    rfl

/-- Composing pullback data with `refl` of the source does not change transport. -/
lemma transport_refl_trans (P : PullbackData q A B) (P' : PullbackData q A' B') (φ : A ⟶ A')
    (hq : 𝟙 V ≫ q = q) :
    transport P ((refl B').trans P' q hq) φ = transport P P' φ :=
  hom_ext fun T j j' b b' w ↦ by
    rw [app_transport (P' := (refl B').trans P' q hq) (c := b ≫ P.β j) (c' := b' ≫ P'.β j')
        (h := rfl) (h' := by simp [trans, refl]),
      app_transport (P' := P') (c := b ≫ P.β j) (c' := b' ≫ P'.β j') (h := rfl) (h' := rfl)]
    simp only [transportApp, trans]
    -- As in `transport_trans_refl`, the index map of `refl B'` is the identity only after
    -- unfolding `refl`.
    erw [refl_iso_trans_iso (h' := rfl)]
    rfl

omit [HasPullbacks C] [F.IsPrestack J] in
private lemma trans_trans_iso {U₀ U₁ U₂ U₃ : C} {r₁ : U₁ ⟶ U₀} {r₂ : U₂ ⟶ U₁} {r₃ : U₃ ⟶ U₂}
    {B₀ : Obj.{w} J F U₀} {B₁ : Obj.{w} J F U₁} {B₂ : Obj.{w} J F U₂} {B₃ : Obj.{w} J F U₃}
    (R : PullbackData r₃ B₂ B₃) (S : PullbackData r₂ B₁ B₂) (T' : PullbackData r₁ B₀ B₁)
    (r₂₃ : U₃ ⟶ U₁) (h₂₃ : r₃ ≫ r₂ = r₂₃) (r₁₂ : U₂ ⟶ U₀) (h₁₂ : r₂ ≫ r₁ = r₁₂)
    (r : U₃ ⟶ U₀) (h : r₂₃ ≫ r₁ = r) (h' : r₃ ≫ r₁₂ = r) ⦃T : C⦄ ⦃j : B₃.ι⦄ (b : T ⟶ B₃.X j)
    (c : T ⟶ B₀.X (T'.α (S.α (R.α j)))) (hc : b ≫ (R.β j ≫ S.β (R.α j)) ≫ T'.β _ = c)
    (hc' : b ≫ R.β j ≫ S.β (R.α j) ≫ T'.β _ = c) :
    ((R.trans S r₂₃ h₂₃).trans T' r h).iso b c hc =
      (R.trans (S.trans T' r₁₂ h₁₂) r h').iso b c hc' := by
  ext
  simp only [trans, Iso.trans_hom, Category.assoc]
  congr 1
  exact iso_hom_comp_iso_hom_congr S T' _ _ _ _ _ _ _ _

/-- Transport does not depend on how a triple composite of pullback data is associated. -/
lemma transport_trans_trans {U₁ U₂ : C} {r₁ : U₁ ⟶ U} {r₂ : U₂ ⟶ U₁} {r₃ : V ⟶ U₂}
    {B₁ : Obj.{w} J F U₁} {B₂ : Obj.{w} J F U₂}
    (P : PullbackData q A B) (R : PullbackData r₃ B₂ B') (S : PullbackData r₂ B₁ B₂)
    (T' : PullbackData r₁ A' B₁) (φ : A ⟶ A') (r₂₃ : V ⟶ U₁) (h₂₃ : r₃ ≫ r₂ = r₂₃)
    (r₁₂ : U₂ ⟶ U) (h₁₂ : r₂ ≫ r₁ = r₁₂) (h : r₂₃ ≫ r₁ = q) (h' : r₃ ≫ r₁₂ = q) :
    transport P ((R.trans S r₂₃ h₂₃).trans T' q h) φ =
      transport P (R.trans (S.trans T' r₁₂ h₁₂) q h') φ :=
  hom_ext fun T j j' b b' w ↦ by
    rw [app_transport (c := b ≫ P.β j) (c' := b' ≫ R.β j' ≫ S.β _ ≫ T'.β _) (h := rfl)
        (h' := by simp [trans]),
      app_transport (c := b ≫ P.β j) (c' := b' ≫ R.β j' ≫ S.β _ ≫ T'.β _) (h := rfl)
        (h' := rfl)]
    simp only [transportApp]
    -- The two composites of pullback data have the same index map only after unfolding `trans`.
    erw [trans_trans_iso (hc' := rfl)]
    rfl

end PullbackData

variable {U V : C}

/-- The pullback of a descent datum `A` over `U` along `q : V ⟶ U`: the descent datum along the
pulled back covering family `(A.X i ×_U V ⟶ V)`, given by Mathlib's
`Pseudofunctor.DescentData.pullFunctor`. -/
abbrev pullObj (q : V ⟶ U) (A : Obj.{w} J F U) : Obj.{w} J F V where
  ι := A.ι
  X i := pullback (A.f i) q
  f i := pullback.snd (A.f i) q
  mem := by
    rw [Sieve.ofArrows_eq_pullback_of_isPullback A.f
      (fun i ↦ (IsPullback.of_hasPullback (A.f i) q).flip)]
    exact J.pullback_stable q A.mem
  D := (DescentData.pullFunctor F (α := fun i ↦ i) (p' := fun i ↦ pullback.fst (A.f i) q)
    (fun i ↦ pullback.condition)).obj A.D

/-- The pullback `pullObj q A` is identified with the pullback of `A` along `q`. -/
def pullbackData (q : V ⟶ U) (A : Obj.{w} J F U) : PullbackData q A (pullObj q A) where
  α i := i
  β i := pullback.fst (A.f i) q
  w i := pullback.condition
  iso T i b c h :=
    { hom := (F.mapComp' (pullback.fst (A.f i) q).op.toLoc b.op.toLoc c.op.toLoc
        (by rw [← h]; rfl)).inv.toNatTrans.app (A.D.obj i)
      inv := (F.mapComp' (pullback.fst (A.f i) q).op.toLoc b.op.toLoc c.op.toLoc
        (by rw [← h]; rfl)).hom.toNatTrans.app (A.D.obj i)
      hom_inv_id := Cat.Hom.inv_hom_id_toNatTrans_app _ _
      inv_hom_id := Cat.Hom.hom_inv_id_toNatTrans_app _ _ }
  pullHom_iso T i b c h T' g gb gc hgb hgc := pullHom_mapComp'_inv _ _ _ _ h _ _ _ hgb hgc
  hom_eq T i i' q' b b' hb hb' c c' h h' := by
    subst hb
    -- `(pullObj q A).D` is `(DescentData.pullFunctor F _).obj A.D` only after unfolding.
    erw [DescentData.pullFunctorObj_hom]
    exact DescentData.pullFunctorObjHom_eq (F := F) (α := fun i ↦ i)
      (p' := fun i ↦ pullback.fst (A.f i) q) (fun i ↦ pullback.condition) A.D _ b b'
      (c ≫ A.f i) c c' rfl hb' (by
      rw [← h, Category.assoc, Category.assoc, pullback.condition]) h h'

variable (J F) in
/-- The pullback functor between the categories of descent data along `q : V ⟶ U`. -/
abbrev pullFunctor [F.IsPrestack J] (q : V ⟶ U) : Obj.{w} J F U ⥤ Obj.{w} J F V where
  obj := pullObj q
  map {A A'} φ := PullbackData.transport (pullbackData q A) (pullbackData q A') φ
  map_id _ := PullbackData.transport_id _
  map_comp _ _ := (PullbackData.transport_comp _ _ _ _ _).symm

variable [F.IsPrestack J]

/-- The pullback functor acts on morphisms by transport along `pullbackData`. -/
lemma pullFunctor_map (q : V ⟶ U) {A A' : Obj.{w} J F U} (φ : A ⟶ A') :
    (pullFunctor J F q).map φ =
      PullbackData.transport (pullbackData q A) (pullbackData q A') φ :=
  rfl

open PullbackData

variable (J F) in
/-- The pullback functor along an identity is isomorphic to the identity functor. -/
def pullFunctorId (U : C) : pullFunctor.{w} J F (𝟙 U) ≅ 𝟭 (Obj.{w} J F U) :=
  NatIso.ofComponents (fun A ↦ isoOfData (pullbackData (𝟙 U) A) (refl A)) fun {A A'} φ ↦ by
    simp only [isoOfData_hom, Functor.id_map]
    rw [transport_comp, Category.comp_id]
    conv_rhs => rw [← transport_refl φ]
    rw [transport_comp, Category.id_comp]

variable (J F) in
/-- The pullback functor along a composite is isomorphic to the composite of the pullback
functors. -/
def pullFunctorComp {W : C} (q : V ⟶ U) (r : W ⟶ V) (rq : W ⟶ U) (h : r ≫ q = rq) :
    pullFunctor.{w} J F rq ≅ pullFunctor J F q ⋙ pullFunctor J F r :=
  NatIso.ofComponents
    (fun A ↦ isoOfData (pullbackData rq A) ((pullbackData r (pullObj q A)).trans
      (pullbackData q A) rq h)) fun {A A'} φ ↦ by
    simp only [isoOfData_hom, Functor.comp_map]
    rw [transport_comp, Category.comp_id, transport_transport _ _ _ _ _ rq h, transport_comp,
      Category.id_comp]

/-- The unit isomorphism is a transport of the identity. -/
lemma pullFunctorId_hom_app (U : C) (A : Obj.{w} J F U) :
    (pullFunctorId J F U).hom.app A = transport (pullbackData (𝟙 U) A) (refl A) (𝟙 A) :=
  (rfl)

/-- The inverse of the unit isomorphism is a transport of the identity. -/
lemma pullFunctorId_inv_app (U : C) (A : Obj.{w} J F U) :
    (pullFunctorId J F U).inv.app A = transport (refl A) (pullbackData (𝟙 U) A) (𝟙 A) :=
  (rfl)

/-- The composition isomorphism is a transport of the identity. -/
lemma pullFunctorComp_hom_app {W : C} (q : V ⟶ U) (r : W ⟶ V) (rq : W ⟶ U) (h : r ≫ q = rq)
    (A : Obj.{w} J F U) :
    (pullFunctorComp J F q r rq h).hom.app A = transport (pullbackData rq A)
      ((pullbackData r (pullObj q A)).trans (pullbackData q A) rq h) (𝟙 A) :=
  (rfl)

/-- The inverse of the composition isomorphism is a transport of the identity. -/
lemma pullFunctorComp_inv_app {W : C} (q : V ⟶ U) (r : W ⟶ V) (rq : W ⟶ U) (h : r ≫ q = rq)
    (A : Obj.{w} J F U) :
    (pullFunctorComp J F q r rq h).inv.app A = transport
      ((pullbackData r (pullObj q A)).trans (pullbackData q A) rq h) (pullbackData rq A) (𝟙 A) :=
  (rfl)

end TauCeti.Stack.Stackification.Obj

namespace TauCeti.Stack

open Stackification Obj PullbackData

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}) [HasPullbacks C] [F.IsPrestack J]

/-- The pseudofunctor obtained from a prestack `F` for a Grothendieck topology `J` on a category
with pullbacks by adjoining descent data along `w`-small covering families: its fibre over `U` is
the category of descent data for `F` along `w`-small covering families of `U`, and pullback along
`q : V ⟶ U` pulls back the covering families and the descent data. It is the stackification of
`F` (Stacks, Lemma 02ZN) when every covering sieve of `J` contains a covering sieve generated by a
`w`-small family; without this hypothesis it need not be a stack. -/
-- The body is exposed so that the fibre `(stackification J F).obj U` is definitionally
-- `Obj J F U.as.unop`, as needed to state the component formulas below in terms of its objects.
@[expose] def stackification : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{max w v', max (w + 1) u v u' v'} :=
  LocallyDiscrete.mkCatPseudofunctor (obj := fun U ↦ Cat.of (Obj.{w} J F U.unop))
    (fun f ↦ pullFunctor J F f.unop) (fun U ↦ pullFunctorId J F U.unop)
    (fun f g fg h ↦ pullFunctorComp J F f.unop g.unop fg.unop (by rw [← h]; rfl))
    (fun f g h fg gh fgh hfg hgh hfgh hfgh' x ↦ by
      simp only [pullFunctorComp_hom_app]
      rw [transport_transport _ _ _ _ _ fgh.unop (by rw [← hfgh, ← hfg]; rfl), transport_comp,
        Category.comp_id (𝟙 x), ← transport_id (pullbackData f.unop x),
        transport_transport _ _ _ _ _ fgh.unop (by rw [← hfgh', ← hgh]; rfl), transport_comp,
        Category.comp_id (𝟙 x)]
      exact (transport_trans_trans _ _ _ _ _ _ _ _ _ _ _).symm)
    (fun f hf x ↦ by
      simp only [pullFunctorComp_hom_app, pullFunctorId_hom_app, unop_id, Functor.id_obj]
      rw [transport_transport _ _ _ _ _ f.unop (by simp), transport_comp, Category.comp_id (𝟙 x),
        transport_trans_refl, transport_id])
    (fun f hf x ↦ by
      simp only [pullFunctorComp_hom_app, pullFunctorId_hom_app, unop_id, Functor.id_obj]
      rw [← transport_id (pullbackData f.unop x), transport_transport _ _ _ _ _ f.unop (by simp),
        transport_comp, Category.comp_id (𝟙 x), transport_refl_trans, transport_id])

/-- The fibre of the stackification over `U` is the category of descent data over `U.as.unop`. -/
@[simp]
lemma stackification_obj (U : LocallyDiscrete Cᵒᵖ) :
    (stackification.{w} J F).obj U = Cat.of (Obj.{w} J F U.as.unop) :=
  (rfl)

/-- The pullback functors of the stackification are the functors `Obj.pullFunctor`. -/
@[simp]
lemma stackification_map_toFunctor {U V : LocallyDiscrete Cᵒᵖ} (f : U ⟶ V) :
    ((stackification.{w} J F).map f).toFunctor = pullFunctor J F f.as.unop :=
  (rfl)

/-- The unit isomorphisms of the stackification are the isomorphisms `Obj.pullFunctorId`. -/
@[simp]
lemma stackification_mapId_hom_toNatTrans_app (U : LocallyDiscrete Cᵒᵖ)
    (A : Obj.{w} J F U.as.unop) :
    ((stackification.{w} J F).mapId U).hom.toNatTrans.app A =
      (pullFunctorId J F U.as.unop).hom.app A :=
  (rfl)

/-- The inverse unit isomorphisms of the stackification are those of `Obj.pullFunctorId`. -/
@[simp]
lemma stackification_mapId_inv_toNatTrans_app (U : LocallyDiscrete Cᵒᵖ)
    (A : Obj.{w} J F U.as.unop) :
    ((stackification.{w} J F).mapId U).inv.toNatTrans.app A =
      (pullFunctorId J F U.as.unop).inv.app A :=
  (rfl)

/-- The composition isomorphisms of the stackification are the isomorphisms
`Obj.pullFunctorComp`. -/
@[simp]
lemma stackification_mapComp_hom_toNatTrans_app {U V W : LocallyDiscrete Cᵒᵖ} (f : U ⟶ V)
    (g : V ⟶ W) (A : Obj.{w} J F U.as.unop) :
    ((stackification.{w} J F).mapComp f g).hom.toNatTrans.app A =
      (pullFunctorComp J F f.as.unop g.as.unop (f.as ≫ g.as).unop rfl).hom.app A :=
  (rfl)

/-- The inverse composition isomorphisms of the stackification are those of
`Obj.pullFunctorComp`. -/
@[simp]
lemma stackification_mapComp_inv_toNatTrans_app {U V W : LocallyDiscrete Cᵒᵖ} (f : U ⟶ V)
    (g : V ⟶ W) (A : Obj.{w} J F U.as.unop) :
    ((stackification.{w} J F).mapComp f g).inv.toNatTrans.app A =
      (pullFunctorComp J F f.as.unop g.as.unop (f.as ≫ g.as).unop rfl).inv.app A :=
  (rfl)

end TauCeti.Stack

end
