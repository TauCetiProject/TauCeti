module

public import TauCeti.CategoryTheory.Sites.Descent.LocallyEssSurj
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.Map
public import TauCeti.CategoryTheory.Sites.Descent.Stackification.OfIsStack

/-!
# The universal property of the stackification

Let `F` be a prestack for a Grothendieck topology `J` on a category with pullbacks, and
`TauCeti.Stack.toStackification J F : F ⟶ stackification J F` the unit of its stackification by
descent data along `w`-small covering families. For every stack `G` for `J`, precomposition with
the unit is an equivalence from the category of strong transformations
`stackification J F ⟶ G` and their modifications to the category of strong transformations
`F ⟶ G` and their modifications (`TauCeti.Stack.stackificationUniversal`, Stacks, Lemmas 02ZN and
0435): every strong transformation from `F` to a stack extends along the unit; the extension
is unique up to the invertible modification compatible with its specified restriction.

* *Full faithfulness*, for every prestack `G`: the components of the unit are fully faithful
  (`Stackification.Obj.fullyFaithfulToObjFunctor`) and the unit is locally essentially surjective
  (`TauCeti.Stack.stackification_locally_essSurj`), so this is
  `Pseudofunctor.StrongTrans.faithful_precomp` and `Pseudofunctor.StrongTrans.full_precomp`.
* *Essential surjectivity*, for a stack `G`: for a stack the unit is an equivalence of
  pseudofunctors (`TauCeti.Stack.stackificationOfIsStack`, in
  `Stackification/OfIsStack.lean`), and `ψ : F ⟶ G` extends to
  `TauCeti.Stack.stackificationLift ψ`, the stackification `stackificationMap ψ` of `ψ` followed by
  the inverse of the unit of `G`. Its restriction along the unit is isomorphic to `ψ` by the
  naturality of the unit (`TauCeti.Stack.toStackificationCompStackificationMapIso`).

As for `toStackification`, the statements are for `F` and `G` valued in the universes of
`stackification J F`; this covers the big sites `Over S` of a scheme `S : Scheme.{u}`, with `w = u`
and values in `Cat.{u, u + 1}`. The stack property of `stackification J F`, which needs every
covering sieve to contain one generated by a `w`-small family, is not used.

## Main declarations

* `TauCeti.Stack.stackificationLift`, `TauCeti.Stack.toStackificationCompStackificationLiftIso`:
  the extension of a strong transformation into a stack along the unit.
* `TauCeti.Stack.stackificationUniversal`: the universal property of the stackification, whose
  inverse is `stackificationLift` up to isomorphism
  (`TauCeti.Stack.stackificationUniversalInverseObjIso`).

## References

* [Stacks Project, Lemma 02ZN](https://stacks.math.columbia.edu/tag/02ZN)
* [Stacks Project, Lemma 0435](https://stacks.math.columbia.edu/tag/0435)
-/

public section

noncomputable section

universe w v' u' v u

open CategoryTheory Limits Opposite Bicategory Pseudofunctor Pseudofunctor.StrongTrans

namespace TauCeti.Stack

open Stackification Obj

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) [HasPullbacks C]

section

variable (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{max w v', max (w + 1) u v v' u'}) [F.IsPrestack J]

/-- The components of the unit of the stackification are full. -/
instance full_toStackification_app (a : LocallyDiscrete Cᵒᵖ) :
    ((toStackification.{w, v', u'} J F).app a).toFunctor.Full :=
  (fullyFaithfulToObjFunctor.{w} J F a.as.unop).full

/-- The unit of the stackification is locally essentially surjective. -/
instance isLocallyEssSurj_toStackification :
    (toStackification.{w, v', u'} J F).IsLocallyEssSurj J where
  exists_covering_lift A := by
    obtain ⟨R, hR, h⟩ := stackification_locally_essSurj.{w} J F A
    exact ⟨R, hR, fun V g hg ↦
      let ⟨M, ⟨e⟩⟩ := h g hg
      ⟨M, ⟨e.symm⟩⟩⟩

end

section Universal

variable {F G : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{max w v', max (w + 1) u v v' u'}} [F.IsPrestack J]

variable (G) in
/-- Precomposition with the unit of the stackification is faithful on strong transformations into
a prestack. -/
instance faithful_precomp_toStackification [G.IsPrestack J] :
    (precomp G (toStackification.{w, v', u'} J F)).Faithful :=
  faithful_precomp G _ J

variable (G) in
/-- Precomposition with the unit of the stackification is full on strong transformations into a
prestack. -/
instance full_precomp_toStackification [G.IsPrestack J] :
    (precomp G (toStackification.{w, v', u'} J F)).Full :=
  full_precomp G _ J

variable [G.IsStack J]

/-- The extension along the unit of the stackification of a strong transformation `ψ : F ⟶ G`
into a stack: the stackification of `ψ`, followed by the inverse of the unit of the stack `G`. -/
-- Expose the composite to state the dependent component formula for its restriction isomorphism.
@[expose]
def stackificationLift (ψ : F ⟶ G) : stackification.{w} J F ⟶ G :=
  stackificationMap.{w} J ψ ≫
    (stackificationOfIsStack.{w, v', u'} J G).inv

/-- The components of `stackificationLift ψ` map descent data along `ψ` and then back to `G`
through the inverse of the equivalence `Stackification.Obj.toObjFunctor`. -/
@[simp]
lemma stackificationLift_app_toFunctor (ψ : F ⟶ G) (a : LocallyDiscrete Cᵒᵖ) :
    ((stackificationLift.{w, v', u'} J ψ).app a).toFunctor =
      mapFunctor.{w} J ψ a.as.unop ⋙ (toObjFunctor.{w} J G a.as.unop).inv := by
  simp only [stackificationLift, stackificationOfIsStack, StrongTrans.comp_app,
    Cat.Hom.comp_toFunctor, equivalenceOfIsEquivalence_inv_app,
    stackificationMap_app_toFunctor, Functor.toCatHom_toFunctor, toStackification_app_toFunctor]
  -- The inverse functors agree definitionally after identifying the unit components.
  rfl

/-- The extension `stackificationLift ψ` restricts to `ψ` along the unit of the stackification,
up to an invertible modification. -/
def toStackificationCompStackificationLiftIso (ψ : F ⟶ G) :
    toStackification.{w, v', u'} J F ≫ stackificationLift.{w, v', u'} J ψ ≅ ψ :=
  (α_ _ _ _).symm ≪≫
    whiskerRightIso (toStackificationCompStackificationMapIso.{w, v', u'} J ψ) _ ≪≫
    α_ _ _ _ ≪≫
    whiskerLeftIso ψ (stackificationOfIsStack.{w, v', u'} J G).unit.symm ≪≫ ρ_ ψ

/-- On objects, the restriction isomorphism maps the naturality isomorphism of the unit
through the inverse equivalence, then applies the inverse component unit. -/
@[simp]
lemma toStackificationCompStackificationLiftIso_hom_as_app_toNatTrans_app (ψ : F ⟶ G)
    (a : LocallyDiscrete Cᵒᵖ) (M : F.obj a) :
    ((toStackificationCompStackificationLiftIso.{w, v', u'} J ψ).hom.as.app a).toNatTrans.app M =
      ((stackificationOfIsStack.{w, v', u'} J G).inv.app a).toFunctor.map
          (((toStackificationCompStackificationMapIso.{w, v', u'} J ψ).hom.as.app a).toNatTrans.app
            M) ≫
        ((stackificationOfIsStack.{w, v', u'} J G).unit.inv.as.app
          a).toNatTrans.app ((ψ.app a).toFunctor.obj M) := by
  -- The unit's source uses `equivalenceOfIsEquivalence.hom`, which agrees with
  -- `toStackification` only definitionally. This prevents `simp` from descending through
  -- the composite modification. State its components explicitly, keeping the Cat
  -- associators and right unitor visible so their named component lemmas apply.
  let e := stackificationOfIsStack.{w, v', u'} J G
  change (α_ ((toStackification.{w, v', u'} J F).app a) ((stackificationMap.{w} J ψ).app a)
        (e.inv.app a)).inv.toNatTrans.app M ≫
      (e.inv.app a).toFunctor.map
        (((toStackificationCompStackificationMapIso.{w, v', u'} J ψ).hom.as.app a).toNatTrans.app
          M) ≫
      (α_ (ψ.app a) ((toStackification.{w, v', u'} J G).app a)
        (e.inv.app a)).hom.toNatTrans.app M ≫
      (e.unit.inv.as.app a).toNatTrans.app ((ψ.app a).toFunctor.obj M) ≫
      (ρ_ (ψ.app a)).hom.toNatTrans.app M = _
  simp only [Cat.associator_inv_app, Cat.associator_hom_app, Cat.rightUnitor_hom_app,
    eqToHom_refl, Category.id_comp]
  -- The remaining identities have definitionally equal composite-functor object types.
  erw [Category.id_comp, Category.comp_id]
  rfl

variable (G) in
/-- Precomposition with the unit of the stackification is essentially surjective on strong
transformations into a stack. -/
instance essSurj_precomp_toStackification :
    (precomp G (toStackification.{w, v', u'} J F)).EssSurj where
  mem_essImage ψ := ⟨stackificationLift.{w, v', u'} J ψ,
    ⟨toStackificationCompStackificationLiftIso.{w, v', u'} J ψ⟩⟩

variable (G) in
/-- Precomposition with the unit of the stackification is an equivalence on strong
transformations into a stack. -/
instance isEquivalence_precomp_toStackification :
    (precomp G (toStackification.{w, v', u'} J F)).IsEquivalence where

variable (F G) in
/-- **The universal property of the stackification** (Stacks, Lemmas 02ZN and 0435): for a
prestack `F` and a stack `G`, precomposition with the unit `toStackification J F` is an
equivalence from the category of strong transformations `stackification J F ⟶ G` and their
modifications to the category of strong transformations `F ⟶ G` and their modifications. -/
def stackificationUniversal : (stackification.{w} J F ⟶ G) ≌ (F ⟶ G) :=
  (precomp G (toStackification.{w, v', u'} J F)).asEquivalence

/-- The functor of `stackificationUniversal` is precomposition with the unit. -/
@[simp]
lemma stackificationUniversal_functor :
    (stackificationUniversal.{w, v', u'} J F G).functor =
      precomp G (toStackification.{w, v', u'} J F) :=
  (rfl)

/-- The inverse of `stackificationUniversal` sends a strong transformation `ψ : F ⟶ G` to its
extension `stackificationLift ψ`, up to an invertible modification. -/
def stackificationUniversalInverseObjIso (ψ : F ⟶ G) :
    (stackificationUniversal.{w, v', u'} J F G).inverse.obj ψ ≅
      stackificationLift.{w, v', u'} J ψ :=
  (stackificationUniversal.{w, v', u'} J F G).fullyFaithfulFunctor.preimageIso
    ((stackificationUniversal.{w, v', u'} J F G).counitIso.app ψ ≪≫
      (toStackificationCompStackificationLiftIso.{w, v', u'} J ψ).symm)

end Universal

end TauCeti.Stack
