/-!
# The quotient of an internal action on a site

`ModObj.actionQuotient` applies `TauCeti.Stack.stackification` to `ModObj.actionCategory`.
The projection `ModObj.actionQuotient.π` is locally essentially surjective, and
`ModObj.actionQuotient.homEquiv` identifies arrows between embedded points with action labels.

## References

* [Stacks Project, Definition 78.20.1 (044Q)](https://stacks.math.columbia.edu/tag/044Q)
* [Stacks Project, Lemma 78.20.2 (044R)](https://stacks.math.columbia.edu/tag/044R)
* [Stacks Project, Lemma 78.20.3 (044S)](https://stacks.math.columbia.edu/tag/044S)
-/

public noncomputable section

open CategoryTheory Limits Opposite Bicategory Pseudofunctor.StrongTrans
open scoped MonObj

namespace CategoryTheory.ModObj

universe v u

open TauCeti.Stack TauCeti.Stack.Stackification

variable {C : Type u} [Category.{v} C] [CartesianMonoidalCategory C] [HasPullbacks C]
  (G X : C) [MonObj G] [ModObj G X] (J : GrothendieckTopology C) [(actionCategory G X).IsPrestack J]

/-- The quotient of the action of `G` on `X`, adjoining `v`-small covering descent data
to the action prestack (Stacks, Definition 78.20.1 (044Q) for group actions).
It is a stack when every covering sieve contains one generated by a `v`-small family. -/
abbrev actionQuotient := stackification.{v} J (actionCategory G X)

namespace actionQuotient

variable {G X} {T V : C}

local notation "pt" => ActionCategory.objEquiv (_ ⟶ G) (_ ⟶ X)

/-- A map to `X` gives an object of `[X/G]` over its domain. -/
abbrev point (x : T ⟶ X) : (actionQuotient G X J).obj (.mk (op T)) :=
  (Obj.toObjFunctor.{v} J (actionCategory G X) T).obj (pt x)

/-- The arrows between the images of two maps to `X` in `[X/G]` are the sections of `G`
taking the source map to the target map. -/
def homEquiv (x y : T ⟶ X) : (point J (G := G) x ⟶ point J (G := G) y) ≃ {g : T ⟶ G // g • x = y} :=
  (Obj.fullyFaithfulToObjFunctor.{v} J (actionCategory G X) T).homEquiv.symm.trans
    { toFun := fun a ↦ ⟨a.hom, a.map_val⟩
      invFun := fun g ↦ Functor.Elements.homMk g.val g.property
      left_inv := fun _ ↦ Functor.Elements.hom_ext rfl
      right_inv := fun _ ↦ Subtype.ext rfl }

/-- The arrow with label `g` is the image of the corresponding action arrow. -/
theorem homEquiv_symm_apply (x y : T ⟶ X) (g : {g : T ⟶ G // g • x = y}) :
    (homEquiv J x y).symm g =
      (Obj.toObjFunctor.{v} J (actionCategory G X) T).map
        (Functor.Elements.homMk (x := pt x) (y := pt y) g.val g.property) :=
  (rfl)

/-- The label of an embedded action arrow is its original section of `G`. -/
@[simp]
theorem homEquiv_apply_map (x y : T ⟶ X) (a : pt x ⟶ pt y) :
    (homEquiv J x y ((Obj.toObjFunctor.{v} J (actionCategory G X) T).map a)).val = a.hom :=
  congrArg Subtype.val ((homEquiv J x y).eq_symm_apply.mp (homEquiv_symm_apply J
    x y ⟨a.hom, a.map_val⟩).symm)

/-- The identity of an embedded point has label `1`. -/
@[simp]
theorem homEquiv_id (x : T ⟶ X) : (homEquiv J (G := G) x x (𝟙 (point J x))).val = 1 := by
  let E := Obj.toObjFunctor.{v} J (actionCategory G X) T
  exact (congrArg (fun a ↦ (homEquiv J x x a).val) (E.map_id (pt x)).symm).trans
    ((homEquiv_apply_map J x x (𝟙 (pt x))).trans (ActionCategory.id_hom _))

/-- Composition of arrows between embedded points multiplies their labels in reverse order. -/
theorem homEquiv_comp (x y z : T ⟶ X) (a : point J (G := G) x ⟶ point J y)
    (b : point J (G := G) y ⟶ point J z) :
    (homEquiv J x z (a ≫ b)).val = (homEquiv J y z b).val * (homEquiv J x y a).val := by
  let ff := Obj.fullyFaithfulToObjFunctor.{v} J (actionCategory G X) T
  obtain ⟨a, rfl⟩ := ff.map_surjective a
  obtain ⟨b, rfl⟩ := ff.map_surjective b
  let E := Obj.toObjFunctor.{v} J (actionCategory G X) T
  exact (congrArg (fun c ↦ (homEquiv J x z c).val) (E.map_comp a b).symm).trans
    ((homEquiv_apply_map J x z (a ≫ b)).trans
      ((ActionCategory.comp_hom a b).trans
        (congrArg₂ (fun (g h : T ⟶ G) ↦ g * h)
          (homEquiv_apply_map J y z b).symm (homEquiv_apply_map J x y a).symm)))

/-- Restricting an embedded point is isomorphic to the embedded point of the restricted map. -/
def pointPullbackIso (x : T ⟶ X) (f : V ⟶ T) :
    ((actionQuotient G X J).map f.op.toLoc).toFunctor.obj (point J (G := G) x) ≅
      point J (G := G) (f ≫ x) :=
  (toStackificationNatIso.{v} J (actionCategory G X) f).symm.app (pt x) ≪≫
    (Obj.toObjFunctor.{v} J (actionCategory G X) V).mapIso
      (eqToIso (actionCategory_map_obj_objEquiv G x f))

/-- The restriction comparison is the inverse naturality map of the stackification embedding,
followed by the identification of the restricted point. -/
@[simp]
theorem pointPullbackIso_hom (x : T ⟶ X) (f : V ⟶ T) :
    (pointPullbackIso J (G := G) x f).hom =
      (toStackificationNatIso.{v} J (actionCategory G X) f).inv.app (pt x) ≫
        (Obj.toObjFunctor.{v} J (actionCategory G X) V).map
          (eqToHom (actionCategory_map_obj_objEquiv G x f)) :=
  (rfl)

/-- The inverse restriction comparison identifies the restricted point before applying
the naturality map of the stackification embedding. -/
@[simp]
theorem pointPullbackIso_inv (x : T ⟶ X) (f : V ⟶ T) :
    (pointPullbackIso J (G := G) x f).inv =
      (Obj.toObjFunctor.{v} J (actionCategory G X) V).map
          (eqToHom (actionCategory_map_obj_objEquiv G x f).symm) ≫
        (toStackificationNatIso.{v} J (actionCategory G X) f).hom.app (pt x) :=
  (rfl)

/-- Restriction along `f` precomposes the label of an arrow between embedded points. -/
theorem homEquiv_pullback (x y : T ⟶ X) (f : V ⟶ T)
    (a : point J (G := G) x ⟶ point J y) :
    (homEquiv J (f ≫ x) (f ≫ y) ((pointPullbackIso J x f).inv ≫
      ((actionQuotient G X J).map f.op.toLoc).toFunctor.map a ≫
        (pointPullbackIso J y f).hom)).val = f ≫ (homEquiv J x y a).val := by
  obtain ⟨a, rfl⟩ := (Obj.fullyFaithfulToObjFunctor.{v} J (actionCategory G X) T).map_surjective a
  let E := Obj.toObjFunctor.{v} J (actionCategory G X) V
  let N := toStackificationNatIso.{v} J (actionCategory G X) f
  have hx := actionCategory_map_obj_objEquiv G x f
  have hy := actionCategory_map_obj_objEquiv G y f
  let K := ((actionCategory G X).map f.op.toLoc).toFunctor
  let l : pt (f ≫ x) ⟶ K.obj (pt x) := eqToHom hx.symm
  let r : K.obj (pt y) ⟶ pt (f ≫ y) := eqToHom hy
  let b := l ≫ K.map a ≫ r
  have h : (pointPullbackIso J x f).inv ≫
      ((actionQuotient G X J).map f.op.toLoc).toFunctor.map
        ((Obj.toObjFunctor.{v} J (actionCategory G X) T).map a) ≫
        (pointPullbackIso J y f).hom = E.map b := by
    rw [pointPullbackIso_inv, pointPullbackIso_hom]
    exact (Category.assoc _ _ _).trans <|
      (congrArg (E.map l ≫ ·) (NatIso.naturality_2_assoc N a (E.map r))).trans <|
        (congrArg (E.map l ≫ ·) (E.map_comp (K.map a) r).symm).trans (E.map_comp _ _).symm
  have hl : l.hom = (1 : V ⟶ G) := ActionCategory.eqToHom_hom hx.symm
  have hr : r.hom = (1 : V ⟶ G) := ActionCategory.eqToHom_hom hy
  have hb : b.hom = f ≫ a.hom := by
    have h₁ := ActionCategory.comp_hom (M := V ⟶ G) l (K.map a ≫ r)
    have h₂ := ActionCategory.comp_hom (M := V ⟶ G) (K.map a) r
    refine h₁.trans ?_
    rw [h₂, hl, hr, one_mul (M := V ⟶ G), mul_one (M := V ⟶ G)]
    exact ActionCategory.map_map_hom _ _ a
  exact (congrArg (fun c ↦ (homEquiv J (f ≫ x) (f ≫ y) c).val) h).trans <|
    (homEquiv_apply_map J _ _ b).trans <|
      hb.trans (congrArg (f ≫ ·) (homEquiv_apply_map J x y a).symm)

/-- The canonical projection `X → [X/G]`, obtained by applying 2-Yoneda to the point
of `𝟙 X` (Stacks, Lemmas 044R and 044S). -/
def π : Pseudofunctor.ofPresheaf.{max (v + 1) u} (yoneda.obj X) ⟶ actionQuotient G X J :=
  Pseudofunctor.yonedaPullbackObj (actionQuotient G X J) X (point J (G := G) (𝟙 X))

/-- At `x : T ⟶ X`, the projection pulls back the point of `𝟙 X` along `x`. -/
@[simp]
theorem π_app_obj (x : T ⟶ X) :
    ((π J (G := G)).app (.mk (op T))).toFunctor.obj
        ((Pseudofunctor.ofPresheaf.objEquiv.{max (v + 1) u} (P := yoneda.obj X) (op T)).symm x) =
      ((actionQuotient G X J).map x.op.toLoc).toFunctor.obj (point J (G := G) (𝟙 X)) := by
  rw [π.eq_def, Pseudofunctor.yonedaPullbackObj_app,
    Pseudofunctor.yonedaPullbackApp_toFunctor_obj, Equiv.apply_symm_apply]

/-- The projection evaluated at `x` gives the embedded point of `x`, up to isomorphism. -/
def πAppIso (x : T ⟶ X) :
    ((π J (G := G)).app (.mk (op T))).toFunctor.obj
        ((Pseudofunctor.ofPresheaf.objEquiv.{max (v + 1) u} (P := yoneda.obj X) (op T)).symm x) ≅
      point J (G := G) x :=
  eqToIso (π_app_obj J x) ≪≫ pointPullbackIso J (𝟙 X) x ≪≫
    eqToIso (congrArg (point J (G := G)) (Category.comp_id x))

/-- The comparison at `x` restricts the identity point and uses `x ≫ 𝟙 X = x`. -/
@[simp]
theorem πAppIso_hom (x : T ⟶ X) :
    (πAppIso J (G := G) x).hom = eqToHom (π_app_obj J x) ≫
      (pointPullbackIso J (𝟙 X) x).hom ≫
        eqToHom (congrArg (point J (G := G)) (Category.comp_id x)) :=
  (rfl)

/-- Every quotient object is locally in the essential image of the projection
(cf. the construction in Stacks, Lemmas 044R and 044S). -/
instance isLocallyEssSurj_π : IsLocallyEssSurj (π J (G := G) (X := X)) J where
  exists_covering_lift {U} A := by
    obtain ⟨R, hR, h⟩ := stackification_locally_essSurj _ _ A
    refine ⟨R, hR, fun V f hf ↦ ?_⟩
    obtain ⟨M, ⟨e⟩⟩ := h f hf
    let x := (pt).symm M
    have hx : point J (G := G) x = (Obj.toObjFunctor.{v} J (actionCategory G X) V).obj M :=
      congrArg (Obj.toObjFunctor.{v} J (actionCategory G X) V).obj ((pt).apply_symm_apply M)
    exact ⟨(Pseudofunctor.ofPresheaf.objEquiv.{max (v + 1) u} (P := yoneda.obj X) (op V)).symm x,
      ⟨πAppIso J x ≪≫ eqToIso hx ≪≫ e.symm⟩⟩

end actionQuotient

end CategoryTheory.ModObj
