module

public import Mathlib.CategoryTheory.Sites.Coverage

import Mathlib.CategoryTheory.Sites.DenseSubsite.InducedTopology

/-!
# Restricting a generated Grothendieck topology

A fully faithful functor can detect covering sieves for the topology generated by pulled-back
presieves if each generator admits a refinement by a generator from its image. This extends
Mathlib's `Precoverage.toGrothendieck_comap_eq_restrictedTopology` to refinements of generators
and precoverages that require saturation under composition.
-/

public section

namespace CategoryTheory.Coverage

variable {C D : Type*} [Category* C] [Category* D] (K : Coverage D) (F : C ⥤ D)

private theorem pullback_cover_and_pushforward_cover
    (refineGen : ∀ {X : C} {R : Presieve (F.obj X)}, R ∈ K (F.obj X) →
      ∃ Q : Presieve X, Q.map F ∈ K (F.obj X) ∧ Q.map F ≤ (Sieve.generate R).arrows)
    {Y : D} {T : Sieve Y} (hT : T ∈ K.toGrothendieck Y) (X : C) (f : F.obj X ⟶ Y) :
    let U := (T.pullback f).functorPullback F
    U ∈ (K.toPrecoverage.comap F).toGrothendieck X ∧
      U.functorPushforward F ∈ K.toGrothendieck (F.obj X) := by
  rw [Coverage.mem_toGrothendieck] at hT
  -- Keep both covering properties for every test arrow from the image of the functor.
  induction hT generalizing X with
  | of Y R hR =>
    obtain ⟨P, hP, hf⟩ := K.pullback f R hR
    obtain ⟨Q, hQ, hle⟩ := refineGen hP
    have hP' : Sieve.generate P ≤ (Sieve.generate R).pullback f := by
      rw [Sieve.generate_le_iff]
      intro Z g hg
      obtain ⟨W, i, e, he, heq⟩ := hf hg
      exact ⟨W, i, e, he, heq⟩
    have hQ' : Q ∈ K.comap F X := hQ
    have hQU : Sieve.generate Q ≤ ((Sieve.generate R).pullback f).functorPullback F := by
      rw [Sieve.generate_le_iff]
      exact fun W g hg ↦ hP' (F.map g) (hle _ _ ⟨hg⟩)
    refine ⟨GrothendieckTopology.superset_covering _ hQU
      (Precoverage.generate_mem_toGrothendieck hQ'),
      GrothendieckTopology.superset_covering _ ?_ (Coverage.Saturate.of _ _ hQ)⟩
    rw [Sieve.generate_map_eq_functorPushforward]
    exact Sieve.functorPushforward_monotone F X hQU
  | top Y => simp
  | transitive Y R T _ _ ihR ihT =>
    obtain ⟨h₁, h₂⟩ := ihR X f
    constructor
    · apply GrothendieckTopology.transitive _ h₁
      intro W g hg
      rw [← Sieve.functorPullback_pullback, ← Sieve.pullback_comp]
      simpa using (ihT (by simpa [Sieve.pullback_apply] using hg) W (𝟙 _)).1
    · apply GrothendieckTopology.transitive _ h₂
      rintro W _ ⟨Z, g, i, hg, rfl⟩
      rw [Sieve.pullback_comp]
      apply GrothendieckTopology.pullback_stable
      have hlocal : ((T.pullback (F.map g ≫ f)).functorPullback F).functorPushforward F ∈
          K.toGrothendieck (F.obj Z) := by
        simpa using (ihT (by simpa [Sieve.pullback_apply] using hg) Z (𝟙 _)).2
      rw [Sieve.pullback_comp, Sieve.functorPullback_pullback] at hlocal
      exact K.toGrothendieck.superset_covering (Sieve.functorPushforward_pullback_le F g _) hlocal

/-- Covers for the pullback precoverage along a fully faithful functor are detected by
pushing forward sieves, provided each generator at an image object has a refinement by a
generator in the image of the functor. The ambient coverage may require saturation under
composition. -/
theorem mem_toGrothendieck_comap_iff_of_refine_generators [F.Full] [F.Faithful]
    (refineGen : ∀ {X : C} {R : Presieve (F.obj X)}, R ∈ K (F.obj X) →
      ∃ Q : Presieve X, Q.map F ∈ K (F.obj X) ∧ Q.map F ≤ (Sieve.generate R).arrows)
    {X : C} {S : Sieve X} :
    S ∈ (K.toPrecoverage.comap F).toGrothendieck X ↔
      S.functorPushforward F ∈ K.toGrothendieck (F.obj X) := by
  have : F.LocallyCoverDense K.toGrothendieck :=
    ⟨fun X ⟨_, hT⟩ ↦ by
      simpa using (K.pullback_cover_and_pushforward_cover F refineGen hT X (𝟙 _)).2⟩
  constructor
  · intro hS
    apply (Functor.mem_restrictedTopology_iff (G := F)).1
    rw [← Coverage.toGrothendieck_toPrecoverage]
    exact Precoverage.toGrothendieck_comap_le_restrictedTopology K.toPrecoverage _ hS
  · intro hS
    simpa [Sieve.functorPullback_functorPushforward_eq] using
      (K.pullback_cover_and_pushforward_cover F refineGen hS X (𝟙 _)).1

end CategoryTheory.Coverage
